[{"id":"semetey-1-2013:p0888:b003:l021","ordinal":144897,"en":"They had gathered an army without cause."},{"id":"semetey-1-2013:p0888:b003:l022","ordinal":144898,"en":"Have you seen the fools?"},{"id":"semetey-1-2013:p0888:b003:l023","ordinal":144899,"en":"They plunged unsparingly into battle."},{"id":"semetey-1-2013:p0888:b003:l024","ordinal":144900,"en":"Mounted khans died;"},{"id":"semetey-1-2013:p0888:b003:l025","ordinal":144901,"en":"Amid the shouting strife and great disorder,"},{"id":"semetey-1-2013:p0888:b003:l026","ordinal":144902,"en":"Those whose appointed time had come died."},{"id":"semetey-1-2013:p0888:b003:l027","ordinal":144903,"en":"Where their spears could reach,"},{"id":"semetey-1-2013:p0888:b003:l028","ordinal":144904,"en":"They overturned men with their spears;"},{"id":"semetey-1-2013:p0888:b003:l029","ordinal":144905,"en":"Where their swords could reach,"},{"id":"semetey-1-2013:p0888:b003:l030","ordinal":144906,"en":"They overturned men with their swords."},{"id":"semetey-1-2013:p0888:b003:l031","ordinal":144907,"en":"A star was eclipsed in the sky."},{"id":"semetey-1-2013:p0888:b003:l032","ordinal":144908,"en":"Kokcho's son Umotoy"},{"id":"semetey-1-2013:p0888:b003:l033","ordinal":144909,"en":"Fled openly and escaped."},{"id":"semetey-1-2013:p0888:b003:l034","ordinal":144910,"en":"Their teeth jutting out,"},{"id":"semetey-1-2013:p0888:b003:l035","ordinal":144911,"en":"Dead horses lay in mountains."},{"id":"semetey-1-2013:p0888:b003:l036","ordinal":144912,"en":"Many a swift horse's"},{"id":"semetey-1-2013:p0888:b003:l037","ordinal":144913,"en":"Saddle had slipped beneath its belly."},{"id":"semetey-1-2013:p0888:b003:l038","ordinal":144914,"en":"Kicking at its empty saddle,"},{"id":"semetey-1-2013:p0888:b003:l039","ordinal":144915,"en":"Many a horse went bucking about."},{"id":"semetey-1-2013:p0888:b004:l001","ordinal":144916,"en":"Leading fine swift horses"},{"id":"semetey-1-2013:p0888:b004:l002","ordinal":144917,"en":"Whose owners were gone,"},{"id":"semetey-1-2013:p0888:b004:l003","ordinal":144918,"en":"Many went taking them along."},{"id":"semetey-1-2013:p0888:b004:l004","ordinal":144919,"en":"“My dear, precious kinsman"},{"id":"semetey-1-2013:p0888:b004:l005","ordinal":144920,"en":"Died in such-and-such a place,”"},{"id":"semetey-1-2013:p0888:b004:l006","ordinal":144921,"en":"Many went wailing."},{"id":"semetey-1-2013:p0888:b004:l007","ordinal":144922,"en":"“My dear, precious kinsman,"},{"id":"semetey-1-2013:p0888:b004:l008","ordinal":144923,"en":"Where can I see him now?”"},{"id":"semetey-1-2013:p0888:b004:l009","ordinal":144924,"en":"Many went wailing."},{"id":"semetey-1-2013:p0888:b004:l010","ordinal":144925,"en":"Taking many a swift horse,"},{"id":"semetey-1-2013:p0888:b004:l011","ordinal":144926,"en":"Many rushed about in excitement."},{"id":"semetey-1-2013:p0888:b004:l012","ordinal":144927,"en":"“Curses, alas, my kinsman"},{"id":"semetey-1-2013:p0888:b004:l013","ordinal":144928,"en":"Has died,” they said,"},{"id":"semetey-1-2013:p0888:b004:l014","ordinal":144929,"en":"And many went weeping."},{"id":"semetey-1-2013:p0888:b004:l015","ordinal":144930,"en":"Their cruppers broken,"},{"id":"semetey-1-2013:p0888:b004:l016","ordinal":144931,"en":"Their saddles slipped beneath the belly,"},{"id":"semetey-1-2013:p0888:b004:l017","ordinal":144932,"en":"Many were stopping along the way."},{"id":"semetey-1-2013:p0888:b004:l018","ordinal":144933,"en":"Their saddle girths broken,"},{"id":"semetey-1-2013:p0888:b004:l019","ordinal":144934,"en":"Many were in a panic."},{"id":"semetey-1-2013:p0888:b004:l020","ordinal":144935,"en":"Dropping their spears,"},{"id":"semetey-1-2013:p0888:b004:l021","ordinal":144936,"en":"Utterly losing their composure,"},{"id":"semetey-1-2013:p0888:b004:l022","ordinal":144937,"en":"Many were fleeing."},{"id":"semetey-1-2013:p0888:b004:l023","ordinal":144938,"en":"Startled and scattered over the steppe,"},{"id":"semetey-1-2013:p0888:b004:l024","ordinal":144939,"en":"Still more were stopping along the way."},{"id":"semetey-1-2013:p0888:b004:l025","ordinal":144940,"en":"“You fled for nothing,” they said,"},{"id":"semetey-1-2013:p0888:b004:l026","ordinal":144941,"en":"Reproaching one another harshly,"},{"id":"semetey-1-2013:p0888:b004:l027","ordinal":144942,"en":"And many went cursing."},{"id":"semetey-1-2013:p0888:b004:l028","ordinal":144943,"en":"Shattered and scattered in fragments,"},{"id":"semetey-1-2013:p0888:b004:l029","ordinal":144944,"en":"Many were fleeing."},{"id":"semetey-1-2013:p0888:b004:l030","ordinal":144945,"en":"Unable to find a way,"},{"id":"semetey-1-2013:p0888:b004:l031","ordinal":144946,"en":"Many were in a panic."},{"id":"semetey-1-2013:p0888:b004:l032","ordinal":144947,"en":"Each sought a means of his own;"},{"id":"semetey-1-2013:p0888:b004:l033","ordinal":144948,"en":"Many were hiding."},{"id":"semetey-1-2013:p0888:b004:l034","ordinal":144949,"en":"In groups of six or seven, on the slopes,"},{"id":"semetey-1-2013:p0888:b004:l035","ordinal":144950,"en":"Many were hiding."},{"id":"semetey-1-2013:p0888:b004:l036","ordinal":144951,"en":"Their belongings over the steppe"},{"id":"semetey-1-2013:p0888:b004:l037","ordinal":144952,"en":"Many were scattering."},{"id":"semetey-1-2013:p0888:b004:l038","ordinal":144953,"en":"Their hearts thudding in their chests,"},{"id":"semetey-1-2013:p0888:b004:l039","ordinal":144954,"en":"Their shit-filled bowels quivering,"},{"id":"semetey-1-2013:p0889:b003:l001","ordinal":144955,"en":"Unable to recover their composure,"},{"id":"semetey-1-2013:p0889:b003:l002","ordinal":144956,"en":"Each taking a different ravine,"},{"id":"semetey-1-2013:p0889:b003:l003","ordinal":144957,"en":"Many were fleeing."},{"id":"semetey-1-2013:p0889:b003:l004","ordinal":144958,"en":"Among the fleeing troops,"},{"id":"semetey-1-2013:p0889:b003:l005","ordinal":144959,"en":"Driving the fugitives back again,"},{"id":"semetey-1-2013:p0889:b003:l006","ordinal":144960,"en":"Abyke, Kobosh—the six villains—"},{"id":"semetey-1-2013:p0889:b003:l007","ordinal":144961,"en":"Raised the battle cry of “Kobosh!”"},{"id":"semetey-1-2013:p0889:b003:l008","ordinal":144962,"en":"From ridge after ridge the forty companions,"},{"id":"semetey-1-2013:p0889:b003:l009","ordinal":144963,"en":"Roaring and summoning their courage,"},{"id":"semetey-1-2013:p0889:b003:l010","ordinal":144964,"en":"Now launched another attack,"},{"id":"semetey-1-2013:p0889:b003:l011","ordinal":144965,"en":"Raising the battle cry of “Kobosh!”"},{"id":"semetey-1-2013:p0889:b003:l012","ordinal":144966,"en":"When the forty companions attacked,"},{"id":"semetey-1-2013:p0889:b003:l013","ordinal":144967,"en":"The skilled Sary Khan"},{"id":"semetey-1-2013:p0889:b003:l014","ordinal":144968,"en":"Stood without drawing back,"},{"id":"semetey-1-2013:p0889:b003:l015","ordinal":144969,"en":"And fought the forty companions."},{"id":"semetey-1-2013:p0889:b003:l016","ordinal":144970,"en":"Not forty companions, but forty baldheads—"},{"id":"semetey-1-2013:p0889:b003:l017","ordinal":144971,"en":"Fools with crooked minds,"},{"id":"semetey-1-2013:p0889:b003:l018","ordinal":144972,"en":"Forty outstanding men come from forty places."},{"id":"semetey-1-2013:p0889:b003:l020","ordinal":144973,"en":"All were heroes skilled among spearmen,"},{"id":"semetey-1-2013:p0889:b003:l021","ordinal":144974,"en":"All were mighty heroes who knew the arts of jousting."},{"id":"semetey-1-2013:p0889:b003:l023","ordinal":144975,"en":"They all leveled their spears,"},{"id":"semetey-1-2013:p0889:b003:l024","ordinal":144976,"en":"Spurred their horses and fought."},{"id":"semetey-1-2013:p0889:b003:l025","ordinal":144977,"en":"The forty fierce warriors surrounded him"},{"id":"semetey-1-2013:p0889:b003:l026","ordinal":144978,"en":"And now reached Sary Khan;"},{"id":"semetey-1-2013:p0889:b003:l027","ordinal":144979,"en":"All forty struck him, one and all."},{"id":"semetey-1-2013:p0889:b003:l028","ordinal":144980,"en":"As though Judgment Day had come,"},{"id":"semetey-1-2013:p0889:b003:l029","ordinal":144981,"en":"His entire body"},{"id":"semetey-1-2013:p0889:b003:l030","ordinal":144982,"en":"Grew numb, unable to stir."},{"id":"semetey-1-2013:p0889:b003:l031","ordinal":144983,"en":"His two hands that gave him strength"},{"id":"semetey-1-2013:p0889:b003:l032","ordinal":144984,"en":"Hung paralyzed, unable to rise."},{"id":"semetey-1-2013:p0889:b003:l033","ordinal":144985,"en":"His poor head, like a great cauldron,"},{"id":"semetey-1-2013:p0889:b003:l034","ordinal":144986,"en":"Became khan of the lands all around."},{"id":"semetey-1-2013:p0889:b003:l035","ordinal":144987,"en":"Sary Khan was in dire distress."},{"id":"semetey-1-2013:p0889:b003:l036","ordinal":144988,"en":"Since Sary Khan had come into being,"},{"id":"semetey-1-2013:p0889:b003:l037","ordinal":144989,"en":"Since he had won the name Sary Khan,"},{"id":"semetey-1-2013:p0889:b003:l038","ordinal":144990,"en":"Since he had first sat astride a horse,"},{"id":"semetey-1-2013:p0889:b003:l039","ordinal":144991,"en":"His appointed death had not yet come;"},{"id":"semetey-1-2013:p0889:b005:l001","ordinal":144992,"en":"Fierce warriors like the forty companions"},{"id":"semetey-1-2013:p0889:b005:l002","ordinal":144993,"en":"He had never seen upon the earth."},{"id":"semetey-1-2013:p0889:b005:l003","ordinal":144994,"en":"At Ken-Kol there is the Ak-Chiy plain."},{"id":"semetey-1-2013:p0889:b005:l004","ordinal":144995,"en":"Fighting upon that plain,"},{"id":"semetey-1-2013:p0889:b005:l005","ordinal":144996,"en":"In Sary Khan's flesh"},{"id":"semetey-1-2013:p0889:b005:l006","ordinal":144997,"en":"Were wounds in sixty places."},{"id":"semetey-1-2013:p0889:b005:l007","ordinal":144998,"en":"Upon Sary Khan's head"},{"id":"semetey-1-2013:p0889:b005:l008","ordinal":144999,"en":"They were heaping torment."},{"id":"semetey-1-2013:p0889:b005:l009","ordinal":145000,"en":"The reason they tormented him so—"},{"id":"semetey-1-2013:p0889:b005:l010","ordinal":145001,"en":"While Lion Manas was alive,"},{"id":"semetey-1-2013:p0889:b005:l011","ordinal":145002,"en":"There was no hero they had not faced,"},{"id":"semetey-1-2013:p0889:b005:l012","ordinal":145003,"en":"No place they had not challenged."},{"id":"semetey-1-2013:p0889:b005:l013","ordinal":145004,"en":"Clashing with the unbelievers,"},{"id":"semetey-1-2013:p0889:b005:l014","ordinal":145005,"en":"With the teeming Manchu multitude,"},{"id":"semetey-1-2013:p0889:b005:l015","ordinal":145006,"en":"Fighting with the Chinese,"},{"id":"semetey-1-2013:p0889:b005:l016","ordinal":145007,"en":"The forty companions had grown seasoned."},{"id":"semetey-1-2013:p0889:b005:l017","ordinal":145008,"en":"They now surrounded him,"},{"id":"semetey-1-2013:p0889:b005:l018","ordinal":145009,"en":"And upon your uncle Sary Khan"},{"id":"semetey-1-2013:p0889:b005:l019","ordinal":145010,"en":"Laid terrible hardship."},{"id":"semetey-1-2013:p0889:b005:l020","ordinal":145011,"en":"As they were about to seize Khan Sary"},{"id":"semetey-1-2013:p0889:b005:l021","ordinal":145012,"en":"And offer him as a sacrifice,"},{"id":"semetey-1-2013:p0889:b005:l022","ordinal":145013,"en":"Your valiant sister-in-law Kanykei"},{"id":"semetey-1-2013:p0889:b005:l023","ordinal":145014,"en":"Came out to face them and attacked."},{"id":"semetey-1-2013:p0889:b005:l024","ordinal":145015,"en":"Leaning down, she speared the warriors."},{"id":"semetey-1-2013:p0889:b005:l025","ordinal":145016,"en":"With every thrust Kanykei"},{"id":"semetey-1-2013:p0889:b005:l026","ordinal":145017,"en":"Speared four or five at once."},{"id":"semetey-1-2013:p0889:b005:l027","ordinal":145018,"en":"Can a woman be like this?"},{"id":"semetey-1-2013:p0889:b005:l028","ordinal":145019,"en":"Can one rightly call her merely a woman?"},{"id":"semetey-1-2013:p0889:b005:l029","ordinal":145020,"en":"For all the forty companions"},{"id":"semetey-1-2013:p0889:b005:l030","ordinal":145021,"en":"Your sister-in-law found the remedy."},{"id":"semetey-1-2013:p0889:b005:l031","ordinal":145022,"en":"Shattering them to powder,"},{"id":"semetey-1-2013:p0889:b005:l032","ordinal":145023,"en":"She speared them all, every one."},{"id":"semetey-1-2013:p0889:b005:l033","ordinal":145024,"en":"The forty companions who had shown such courage,"},{"id":"semetey-1-2013:p0889:b005:l034","ordinal":145025,"en":"Their wings broken,"},{"id":"semetey-1-2013:p0889:b005:l035","ordinal":145026,"en":"Deprived of their horses,"},{"id":"semetey-1-2013:p0889:b005:l036","ordinal":145027,"en":"Sat down in a miserable huddle."},{"id":"semetey-1-2013:p0889:b005:l037","ordinal":145028,"en":"“O sister-in-law, we submit!” they cried,"},{"id":"semetey-1-2013:p0889:b005:l038","ordinal":145029,"en":"Crouching like howling dogs."},{"id":"semetey-1-2013:p0889:b005:l039","ordinal":145030,"en":"Your lionlike mother Kanykei"},{"id":"semetey-1-2013:p0890:b003:l001","ordinal":145031,"en":"She and Sary Khan joined together,"},{"id":"semetey-1-2013:p0890:b003:l002","ordinal":145032,"en":"Drove off their horses,"},{"id":"semetey-1-2013:p0890:b003:l003","ordinal":145033,"en":"And brought them toward the hills."},{"id":"semetey-1-2013:p0890:b003:l004","ordinal":145034,"en":"The forty swift horses of the forty companions"},{"id":"semetey-1-2013:p0890:b003:l005","ordinal":145035,"en":"They took as spoils."},{"id":"semetey-1-2013:p0890:b003:l006","ordinal":145036,"en":"Abyke and Kobosh, all six—"},{"id":"semetey-1-2013:p0890:b003:l007","ordinal":145037,"en":"The great army surging forward,"},{"id":"semetey-1-2013:p0890:b003:l008","ordinal":145038,"en":"Taking swords and springing to attack,"},{"id":"semetey-1-2013:p0890:b003:l009","ordinal":145039,"en":"Fell upon Semetey."},{"id":"semetey-1-2013:p0890:b003:l010","ordinal":145040,"en":"When they were about to seize him,"},{"id":"semetey-1-2013:p0890:b003:l011","ordinal":145041,"en":"About to slaughter him as a sacrifice,"},{"id":"semetey-1-2013:p0890:b003:l012","ordinal":145042,"en":"Manas’s son, that warrior—"},{"id":"semetey-1-2013:p0890:b003:l013","ordinal":145043,"en":"His twelve bodily parts made perfect,"},{"id":"semetey-1-2013:p0890:b003:l014","ordinal":145044,"en":"The orphan son of Manas,"},{"id":"semetey-1-2013:p0890:b003:l015","ordinal":145045,"en":"Almighty Allah"},{"id":"semetey-1-2013:p0890:b003:l016","ordinal":145046,"en":"Had made a lion among humankind."},{"id":"semetey-1-2013:p0890:b003:l017","ordinal":145047,"en":"“Abyke and Kobosh—"},{"id":"semetey-1-2013:p0890:b003:l018","ordinal":145048,"en":"Let me seize them alive,"},{"id":"semetey-1-2013:p0890:b003:l019","ordinal":145049,"en":"Settle them in broad Talas,"},{"id":"semetey-1-2013:p0890:b003:l020","ordinal":145050,"en":"And establish a town."},{"id":"semetey-1-2013:p0890:b003:l021","ordinal":145051,"en":"Twice, morning and evening,"},{"id":"semetey-1-2013:p0890:b003:l022","ordinal":145052,"en":"Let me take them as my support."},{"id":"semetey-1-2013:p0890:b003:l023","ordinal":145053,"en":"Let me agree to what they say."},{"id":"semetey-1-2013:p0890:b003:l024","ordinal":145054,"en":"To my elder Abyke"},{"id":"semetey-1-2013:p0890:b003:l025","ordinal":145055,"en":"Let me give my mother Kanykei in marriage."},{"id":"semetey-1-2013:p0890:b003:l026","ordinal":145056,"en":"My elder Kobosh—"},{"id":"semetey-1-2013:p0890:b003:l027","ordinal":145057,"en":"Let me place a golden crown upon him,"},{"id":"semetey-1-2013:p0890:b003:l028","ordinal":145058,"en":"Seat him on a golden throne,"},{"id":"semetey-1-2013:p0890:b003:l029","ordinal":145059,"en":"Over Argyn and Kyrgyz"},{"id":"semetey-1-2013:p0890:b003:l030","ordinal":145060,"en":"Let me raise him as khan."},{"id":"semetey-1-2013:p0890:b003:l031","ordinal":145061,"en":"Let me frighten them a little, make a spectacle;"},{"id":"semetey-1-2013:p0890:b003:l032","ordinal":145062,"en":"By force, my uncle"},{"id":"semetey-1-2013:p0890:b003:l033","ordinal":145063,"en":"Let me somehow seize.”"},{"id":"semetey-1-2013:p0890:b003:l034","ordinal":145064,"en":"Akkelte, left by his father Manas,"},{"id":"semetey-1-2013:p0890:b003:l035","ordinal":145065,"en":"When fired in play, an ochogor gun,"},{"id":"semetey-1-2013:p0890:b003:l036","ordinal":145066,"en":"When fired in earnest, Koichagyr,"},{"id":"semetey-1-2013:p0890:b003:l037","ordinal":145067,"en":"Almabash of surpassingly sharp steel,"},{"id":"semetey-1-2013:p0890:b003:l038","ordinal":145068,"en":"Making no distinction between far and near,"},{"id":"semetey-1-2013:p0890:b003:l039","ordinal":145069,"en":"Not failing for sixty days."},{"id":"semetey-1-2013:p0890:b004:l001","ordinal":145070,"en":"Loaded upon Arbuurul,"},{"id":"semetey-1-2013:p0890:b004:l002","ordinal":145071,"en":"Inside the white saddlebags,"},{"id":"semetey-1-2013:p0890:b004:l003","ordinal":145072,"en":"Were six cheyrek of ammunition."},{"id":"semetey-1-2013:p0890:b004:l004","ordinal":145073,"en":"He had wrought great havoc;"},{"id":"semetey-1-2013:p0890:b004:l005","ordinal":145074,"en":"Those saddlebags’"},{"id":"semetey-1-2013:p0890:b004:l006","ordinal":145075,"en":"Mouth he opened."},{"id":"semetey-1-2013:p0890:b004:l007","ordinal":145076,"en":"Taking Akkelte in hand,"},{"id":"semetey-1-2013:p0890:b004:l008","ordinal":145077,"en":"Leaning right, he fired once;"},{"id":"semetey-1-2013:p0890:b004:l009","ordinal":145078,"en":"Leaning left, he fired once,"},{"id":"semetey-1-2013:p0890:b004:l010","ordinal":145079,"en":"Sending dust swirling on the left."},{"id":"semetey-1-2013:p0890:b004:l011","ordinal":145080,"en":"Whenever Akkelte struck,"},{"id":"semetey-1-2013:p0890:b004:l012","ordinal":145081,"en":"It shattered the crest of the steep bank."},{"id":"semetey-1-2013:p0890:b004:l013","ordinal":145082,"en":"When Akkelte cracked,"},{"id":"semetey-1-2013:p0890:b004:l014","ordinal":145083,"en":"Its thunder deafened the ears;"},{"id":"semetey-1-2013:p0890:b004:l015","ordinal":145084,"en":"Its shot whistled with a ringing cry."},{"id":"semetey-1-2013:p0890:b004:l016","ordinal":145085,"en":"When it drew near the enemy,"},{"id":"semetey-1-2013:p0890:b004:l017","ordinal":145086,"en":"It bellowed like a camel with her calf."},{"id":"semetey-1-2013:p0890:b004:l018","ordinal":145087,"en":"When it came still nearer,"},{"id":"semetey-1-2013:p0890:b004:l019","ordinal":145088,"en":"It trailed like a star;"},{"id":"semetey-1-2013:p0890:b004:l020","ordinal":145089,"en":"Its scattered shot screamed."},{"id":"semetey-1-2013:p0890:b004:l021","ordinal":145090,"en":"When they saw the commotion of the shots,"},{"id":"semetey-1-2013:p0890:b004:l022","ordinal":145091,"en":"Abyke and Kobosh, those six scoundrels,"},{"id":"semetey-1-2013:p0890:b004:l023","ordinal":145092,"en":"Split apart and fled in haste."},{"id":"semetey-1-2013:p0890:b004:l024","ordinal":145093,"en":"He fired not once, but a thousand times;"},{"id":"semetey-1-2013:p0890:b004:l025","ordinal":145094,"en":"A thousand times his shots reached them."},{"id":"semetey-1-2013:p0890:b004:l026","ordinal":145095,"en":"“I shall frighten them,” he thought;"},{"id":"semetey-1-2013:p0890:b004:l027","ordinal":145096,"en":"The young sultan, that warrior,"},{"id":"semetey-1-2013:p0890:b004:l028","ordinal":145097,"en":"Was shooting far away."},{"id":"semetey-1-2013:p0890:b004:l029","ordinal":145098,"en":"And every word he spoke was a fired bullet."},{"id":"semetey-1-2013:p0890:b004:l030","ordinal":145099,"en":"It tore off Kobosh’s head."},{"id":"semetey-1-2013:p0890:b004:l031","ordinal":145100,"en":"From Köktelki’s back,"},{"id":"semetey-1-2013:p0890:b004:l032","ordinal":145101,"en":"Your uncle Kobosh fell."},{"id":"semetey-1-2013:p0890:b004:l033","ordinal":145102,"en":"He sent Kobosh to the grave;"},{"id":"semetey-1-2013:p0890:b004:l034","ordinal":145103,"en":"He showed his fierce nature."},{"id":"semetey-1-2013:p0890:b004:l035","ordinal":145104,"en":"He killed his own elder kinsman;"},{"id":"semetey-1-2013:p0890:b004:l036","ordinal":145105,"en":"He poured blood into the dark water."},{"id":"semetey-1-2013:p0890:b004:l037","ordinal":145106,"en":"He set the grassy land ablaze;"},{"id":"semetey-1-2013:p0890:b004:l038","ordinal":145107,"en":"He drank blood and grew hardened,"},{"id":"semetey-1-2013:p0890:b004:l039","ordinal":145108,"en":"Drinking Kobosh’s blood,"},{"id":"semetey-1-2013:p0891:b003:l001","ordinal":145109,"en":"He gained the name of blood-drinking slayer."},{"id":"semetey-1-2013:p0891:b003:l002","ordinal":145110,"en":"He soaked the broad valley in fat;"},{"id":"semetey-1-2013:p0891:b003:l003","ordinal":145111,"en":"As soon as this slayer arrived,"},{"id":"semetey-1-2013:p0891:b003:l004","ordinal":145112,"en":"He killed Khan Kobosh."},{"id":"semetey-1-2013:p0891:b003:l005","ordinal":145113,"en":"When his uncle Kobosh died,"},{"id":"semetey-1-2013:p0891:b003:l006","ordinal":145114,"en":"His heart was troubled."},{"id":"semetey-1-2013:p0891:b003:l007","ordinal":145115,"en":"Among those left alive,"},{"id":"semetey-1-2013:p0891:b003:l008","ordinal":145116,"en":"Abyke came into view."},{"id":"semetey-1-2013:p0891:b003:l009","ordinal":145117,"en":"Then Semetey,"},{"id":"semetey-1-2013:p0891:b003:l010","ordinal":145118,"en":"Taking his painted spear in hand,"},{"id":"semetey-1-2013:p0891:b003:l011","ordinal":145119,"en":"Made Buurul plunge and strain,"},{"id":"semetey-1-2013:p0891:b003:l012","ordinal":145120,"en":"Made him lunge like a widow in grief."},{"id":"semetey-1-2013:p0891:b003:l013","ordinal":145121,"en":"The sight troubled the heart;"},{"id":"semetey-1-2013:p0891:b003:l014","ordinal":145122,"en":"He appeared like Mount Opol."},{"id":"semetey-1-2013:p0891:b003:l015","ordinal":145123,"en":"Girded with a golden belt,"},{"id":"semetey-1-2013:p0891:b003:l016","ordinal":145124,"en":"His moon-like face shone with light;"},{"id":"semetey-1-2013:p0891:b003:l017","ordinal":145125,"en":"His fearful majesty loomed grimly."},{"id":"semetey-1-2013:p0891:b003:l018","ordinal":145126,"en":"That fierce hero of surpassing fortune—"},{"id":"semetey-1-2013:p0891:b003:l019","ordinal":145127,"en":"Which of his deeds shall we tell?"},{"id":"semetey-1-2013:p0891:b003:l020","ordinal":145128,"en":"Girded with a silver belt,"},{"id":"semetey-1-2013:p0891:b003:l021","ordinal":145129,"en":"His sun-like face shone with light;"},{"id":"semetey-1-2013:p0891:b003:l022","ordinal":145130,"en":"Muttering, looming grimly,"},{"id":"semetey-1-2013:p0891:b003:l023","ordinal":145131,"en":"Your sultan of surpassing fortune"},{"id":"semetey-1-2013:p0891:b003:l024","ordinal":145132,"en":"Had many troubles fall upon his head."},{"id":"semetey-1-2013:p0891:b003:l025","ordinal":145133,"en":"His heart was troubled;"},{"id":"semetey-1-2013:p0891:b003:l026","ordinal":145134,"en":"His elders, Abyke and Kobosh—"},{"id":"semetey-1-2013:p0891:b003:l027","ordinal":145135,"en":"Their treachery came before his eyes."},{"id":"semetey-1-2013:p0891:b003:l028","ordinal":145136,"en":"Bracing and readying himself,"},{"id":"semetey-1-2013:p0891:b003:l029","ordinal":145137,"en":"Great grief fell upon him."},{"id":"semetey-1-2013:p0891:b003:l030","ordinal":145138,"en":"Your hero, your lord, then"},{"id":"semetey-1-2013:p0891:b003:l031","ordinal":145139,"en":"Swayed as though struck by a peri."},{"id":"semetey-1-2013:p0891:b003:l032","ordinal":145140,"en":"His ribs seemed to come apart;"},{"id":"semetey-1-2013:p0891:b003:l033","ordinal":145141,"en":"Semetey grieved,"},{"id":"semetey-1-2013:p0891:b003:l034","ordinal":145142,"en":"His heart troubled,"},{"id":"semetey-1-2013:p0891:b003:l035","ordinal":145143,"en":"A great burden falling upon his head."},{"id":"semetey-1-2013:p0891:b003:l036","ordinal":145144,"en":"“My own kinsmen fire upon me;"},{"id":"semetey-1-2013:p0891:b003:l037","ordinal":145145,"en":"Such is this grievous trouble!"},{"id":"semetey-1-2013:p0891:b003:l038","ordinal":145146,"en":"I mounted Buurul, calling him my swift steed;"},{"id":"semetey-1-2013:p0891:b003:l039","ordinal":145147,"en":"I returned, wretched soul that I am,"},{"id":"semetey-1-2013:p0891:b005:l001","ordinal":145148,"en":"Calling Abyke and Kobosh my kin."},{"id":"semetey-1-2013:p0891:b005:l002","ordinal":145149,"en":"My kinsmen became my enemies;"},{"id":"semetey-1-2013:p0891:b005:l003","ordinal":145150,"en":"My foe arose from within my own."},{"id":"semetey-1-2013:p0891:b005:l004","ordinal":145151,"en":"Raise a young camel, and it becomes a camel."},{"id":"semetey-1-2013:p0891:b005:l005","ordinal":145152,"en":"Almighty Allah,"}]
