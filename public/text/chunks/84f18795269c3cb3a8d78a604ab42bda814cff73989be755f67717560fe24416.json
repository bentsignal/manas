[{"id":"manas-2010:p1434:b001:l009","ordinal":61953,"en":"His shout like the call to prayer,"},{"id":"manas-2010:p1434:b001:l010","ordinal":61954,"en":"Is your mullah safe and well?"},{"id":"manas-2010:p1434:b001:l011","ordinal":61955,"en":"With heavy braid-ornaments and broad hips,"},{"id":"manas-2010:p1434:b001:l012","ordinal":61956,"en":"Is your craftswoman safe and well?"},{"id":"manas-2010:p1434:b001:l013","ordinal":61957,"en":"With rooster-like neck and flowing hair,"},{"id":"manas-2010:p1434:b001:l014","ordinal":61958,"en":"Is your maiden safe and well?"},{"id":"manas-2010:p1434:b001:l015","ordinal":61959,"en":"Spread broadly like a river,"},{"id":"manas-2010:p1434:b001:l016","ordinal":61960,"en":"Is your village safe and well?"},{"id":"manas-2010:p1434:b001:l017","ordinal":61961,"en":"I have no male heir behind me:"},{"id":"manas-2010:p1434:b001:l018","ordinal":61962,"en":"Agynay's daughter Aruuke,"},{"id":"manas-2010:p1434:b001:l019","ordinal":61963,"en":"Is my wife safe and well?"},{"id":"manas-2010:p1434:b001:l020","ordinal":61964,"en":"Kanykey, mother of the people,"},{"id":"manas-2010:p1434:b001:l021","ordinal":61965,"en":"Bearing her people's sorrows,"},{"id":"manas-2010:p1434:b001:l022","ordinal":61966,"en":"Is our sister-in-law safe and well?"},{"id":"manas-2010:p1434:b001:l023","ordinal":61967,"en":"The spring flowing from his river,"},{"id":"manas-2010:p1434:b001:l024","ordinal":61968,"en":"The little son Manas gained so painfully,"},{"id":"manas-2010:p1434:b001:l025","ordinal":61969,"en":"For whose feast ninety beasts were slain,"},{"id":"manas-2010:p1434:b001:l026","ordinal":61970,"en":"Who was named brave Semetey,"},{"id":"manas-2010:p1434:b001:l027","ordinal":61971,"en":"When we set out on our journey,"},{"id":"manas-2010:p1434:b001:l028","ordinal":61972,"en":"The Russians ate his feast and left,"},{"id":"manas-2010:p1434:b001:l029","ordinal":61973,"en":"Saying, ‘If Semetey lives,"},{"id":"manas-2010:p1434:b001:l030","ordinal":61974,"en":"He will overthrow the Oirat,’ as they left."},{"id":"manas-2010:p1434:b001:l031","ordinal":61975,"en":"Many peoples ate his feast and left,"},{"id":"manas-2010:p1434:b001:l032","ordinal":61976,"en":"Saying, ‘If Semetey lives,"},{"id":"manas-2010:p1434:b001:l033","ordinal":61977,"en":"He will overthrow many,’ as they left."},{"id":"manas-2010:p1434:b001:l034","ordinal":61978,"en":"The banner fastened to his spear,"},{"id":"manas-2010:p1434:b001:l035","ordinal":61979,"en":"Is Semetey alive and well, my Shuutu?"},{"id":"manas-2010:p1434:b001:l036","ordinal":61980,"en":"Scheming treachery,"},{"id":"manas-2010:p1434:b001:l037","ordinal":61981,"en":"Never abandoning wicked thoughts,"},{"id":"manas-2010:p1434:b001:l038","ordinal":61982,"en":"Khan Manas's father,"},{"id":"manas-2010:p1434:b001:l039","ordinal":61983,"en":"Is old Jakyp well?”"},{"id":"manas-2010:p1434:b001:l040","ordinal":61984,"en":"Giving greeting, drooping low,"},{"id":"manas-2010:p1434:b001:l041","ordinal":61985,"en":"He turned Taibuurul's mouth,"},{"id":"manas-2010:p1434:b001:l042","ordinal":61986,"en":"And told him how the people fared,"},{"id":"manas-2010:p1435:b001:l001","ordinal":61987,"en":"Before Almambet"},{"id":"manas-2010:p1435:b001:l002","ordinal":61988,"en":"He rode up and stood."},{"id":"manas-2010:p1435:b001:l003","ordinal":61989,"en":"“The dear child is safe, the people safe,"},{"id":"manas-2010:p1435:b001:l004","ordinal":61990,"en":"All the people you remember are safe."},{"id":"manas-2010:p1435:b001:l005","ordinal":61991,"en":"With Kanykei at their head, the people are safe."},{"id":"manas-2010:p1435:b001:l006","ordinal":61992,"en":"When I went to Talas with news,"},{"id":"manas-2010:p1435:b001:l007","ordinal":61993,"en":"All the people you know were safe."},{"id":"manas-2010:p1435:b001:l008","ordinal":61994,"en":"Your many people, taking thought,"},{"id":"manas-2010:p1435:b001:l009","ordinal":61995,"en":"Were prospering there."},{"id":"manas-2010:p1435:b001:l010","ordinal":61996,"en":"Kumys by day, girls by night—"},{"id":"manas-2010:p1435:b001:l011","ordinal":61997,"en":"That was how things were."},{"id":"manas-2010:p1435:b001:l012","ordinal":61998,"en":"Caps faced with marten fur"},{"id":"manas-2010:p1435:b001:l013","ordinal":61999,"en":"Were swaying to and fro."},{"id":"manas-2010:p1435:b001:l014","ordinal":62000,"en":"When bored, they shot roe deer;"},{"id":"manas-2010:p1435:b001:l015","ordinal":62001,"en":"When not bored, they lay at ease."},{"id":"manas-2010:p1435:b001:l016","ordinal":62002,"en":"They were enjoying life."},{"id":"manas-2010:p1435:b001:l017","ordinal":62003,"en":"Why should I tell of all the rest?"},{"id":"manas-2010:p1435:b001:l018","ordinal":62004,"en":"Keng-Kol, Talas, the plains are safe."},{"id":"manas-2010:p1435:b001:l019","ordinal":62005,"en":"When we set out this way,"},{"id":"manas-2010:p1435:b001:l020","ordinal":62006,"en":"The newly born child was safe."},{"id":"manas-2010:p1435:b001:l021","ordinal":62007,"en":"Aruuke, the wife you married,"},{"id":"manas-2010:p1435:b001:l022","ordinal":62008,"en":"She too is safe at this time"},{"id":"manas-2010:p1435:b001:l023","ordinal":62009,"en":"And sends you many special greetings!"},{"id":"manas-2010:p1435:b001:l024","ordinal":62010,"en":"The bridle you kept for your horse—"},{"id":"manas-2010:p1435:b001:l025","ordinal":62011,"en":"Inside Aruuke,"},{"id":"manas-2010:p1435:b001:l026","ordinal":62012,"en":"It is about to be born,"},{"id":"manas-2010:p1435:b001:l027","ordinal":62013,"en":"Your unborn child left in her womb!"},{"id":"manas-2010:p1435:b001:l028","ordinal":62014,"en":"‘Let him come to Beijing without delay,’ they say,"},{"id":"manas-2010:p1435:b001:l029","ordinal":62015,"en":"‘Let him see this sorrowing soul,’ they say.”"},{"id":"manas-2010:p1435:b001:l030","ordinal":62016,"en":"When he heard such words,"},{"id":"manas-2010:p1435:b001:l031","ordinal":62017,"en":"With golden forelock and tasselled belt,"},{"id":"manas-2010:p1435:b001:l032","ordinal":62018,"en":"The only son of Azizkhan"},{"id":"manas-2010:p1435:b001:l033","ordinal":62019,"en":"Had his heart pulled many ways."},{"id":"manas-2010:p1435:b001:l034","ordinal":62020,"en":"Rejoicing beyond measure,"},{"id":"manas-2010:p1435:b001:l035","ordinal":62021,"en":"Stretching himself like a lion,"},{"id":"manas-2010:p1435:b001:l036","ordinal":62022,"en":"Restless in his sorrow,"},{"id":"manas-2010:p1435:b001:l037","ordinal":62023,"en":"The precious warrior stood looking on."},{"id":"manas-2010:p1435:b001:l038","ordinal":62024,"en":"“That precious bird, the wild duck,"},{"id":"manas-2010:p1435:b001:l039","ordinal":62025,"en":"Flies over the plain without returning,” they say."},{"id":"manas-2010:p1435:b001:l040","ordinal":62026,"en":"Your precious Almam rejoices"},{"id":"manas-2010:p1435:b001:l041","ordinal":62027,"en":"For the child left in the womb."},{"id":"manas-2010:p1435:b001:l042","ordinal":62028,"en":"“That wretched bird, the kite,"},{"id":"manas-2010:p1436:b001:l001","ordinal":62029,"en":"Swoops over the plain,” they say."},{"id":"manas-2010:p1436:b001:l002","ordinal":62030,"en":"Your Almam rejoices in delight"},{"id":"manas-2010:p1436:b001:l003","ordinal":62031,"en":"For the child within the womb!"},{"id":"manas-2010:p1436:b001:l004","ordinal":62032,"en":"Sarala beneath him,"},{"id":"manas-2010:p1436:b001:l005","ordinal":62033,"en":"Ceaselessly turning sideways,"},{"id":"manas-2010:p1436:b001:l006","ordinal":62034,"en":"Came bounding forth."},{"id":"manas-2010:p1436:b001:l007","ordinal":62035,"en":"Joy entered his heart;"},{"id":"manas-2010:p1436:b001:l008","ordinal":62036,"en":"In the wake of joy,"},{"id":"manas-2010:p1436:b001:l009","ordinal":62037,"en":"Your Alake, for the sake of one child,"},{"id":"manas-2010:p1436:b001:l010","ordinal":62038,"en":"That exceptional wolf-man lion,"},{"id":"manas-2010:p1436:b001:l011","ordinal":62039,"en":"Came forth weeping!"},{"id":"manas-2010:p1436:b001:l012","ordinal":62040,"en":"The reason for his tears was this:"},{"id":"manas-2010:p1436:b001:l013","ordinal":62041,"en":"Nine thousand horses in the mountains,"},{"id":"manas-2010:p1436:b001:l014","ordinal":62042,"en":"Among them warhorses and noble steeds."},{"id":"manas-2010:p1436:b001:l015","ordinal":62043,"en":"A herd of swift horses, with no minds;"},{"id":"manas-2010:p1436:b001:l016","ordinal":62044,"en":"Almambet could not contain himself:"},{"id":"manas-2010:p1436:b001:l017","ordinal":62045,"en":"To tend and take them over,"},{"id":"manas-2010:p1436:b001:l018","ordinal":62046,"en":"He had no male child behind him."},{"id":"manas-2010:p1436:b001:l019","ordinal":62047,"en":"His noble steed, a blaze-faced charger—"},{"id":"manas-2010:p1436:b001:l020","ordinal":62048,"en":"When death comes and his days end,"},{"id":"manas-2010:p1436:b001:l021","ordinal":62049,"en":"Where might this wretched head not lie?"},{"id":"manas-2010:p1436:b001:l022","ordinal":62050,"en":"The chargers he rode were all well fed;"},{"id":"manas-2010:p1436:b001:l023","ordinal":62051,"en":"What made your Alake grieve"},{"id":"manas-2010:p1436:b001:l024","ordinal":62052,"en":"Was having no male child behind him."},{"id":"manas-2010:p1436:b001:l025","ordinal":62053,"en":"His wife, Aruuke, Agynai’s daughter,"},{"id":"manas-2010:p1436:b001:l026","ordinal":62054,"en":"Since she had sent a certain gift,"},{"id":"manas-2010:p1436:b001:l027","ordinal":62055,"en":"Since he had received and seen her gift,"},{"id":"manas-2010:p1436:b001:l028","ordinal":62056,"en":"Sparing not his troubled life,"},{"id":"manas-2010:p1436:b001:l029","ordinal":62057,"en":"He vowed sheep to Khoroson,"},{"id":"manas-2010:p1436:b001:l030","ordinal":62058,"en":"He vowed a horse to Babedin:"},{"id":"manas-2010:p1436:b001:l031","ordinal":62059,"en":"“Even if I die, I have no regret;"},{"id":"manas-2010:p1436:b001:l032","ordinal":62060,"en":"Not a speck of regret remains in me!"},{"id":"manas-2010:p1436:b001:l033","ordinal":62061,"en":"I may give myself to Heaven."},{"id":"manas-2010:p1436:b001:l034","ordinal":62062,"en":"Now that such news has reached me,"},{"id":"manas-2010:p1436:b001:l035","ordinal":62063,"en":"How could I remain downcast?"},{"id":"manas-2010:p1436:b001:l036","ordinal":62064,"en":"Sarala, the charger among horses,"},{"id":"manas-2010:p1436:b001:l037","ordinal":62065,"en":"I shall slaughter as a sacrifice."},{"id":"manas-2010:p1436:b001:l038","ordinal":62066,"en":"The sorrow within my heart—"},{"id":"manas-2010:p1436:b001:l039","ordinal":62067,"en":"Thus shall I clear it away!”"},{"id":"manas-2010:p1436:b001:l040","ordinal":62068,"en":"Almambet came rejoicing,"},{"id":"manas-2010:p1436:b001:l041","ordinal":62069,"en":"That outstanding charger Sarala"},{"id":"manas-2010:p1436:b001:l042","ordinal":62070,"en":"To slaughter as a sacrifice."},{"id":"manas-2010:p1437:b001:l001","ordinal":62071,"en":"Then Khan Manas"},{"id":"manas-2010:p1437:b001:l002","ordinal":62072,"en":"Among many different thoughts"},{"id":"manas-2010:p1437:b001:l003","ordinal":62073,"en":"Was dividing his attention."},{"id":"manas-2010:p1437:b001:l004","ordinal":62074,"en":"From atop his golden throne,"},{"id":"manas-2010:p1437:b001:l005","ordinal":62075,"en":"He took up his spyglass,"},{"id":"manas-2010:p1437:b001:l006","ordinal":62076,"en":"Turned its ring,"},{"id":"manas-2010:p1437:b001:l007","ordinal":62077,"en":"Set it firmly to his eye,"},{"id":"manas-2010:p1437:b001:l008","ordinal":62078,"en":"And Almambet approaching"},{"id":"manas-2010:p1437:b001:l009","ordinal":62079,"en":"He saw there before him!"},{"id":"manas-2010:p1437:b001:l010","ordinal":62080,"en":"When he saw Almambet,"},{"id":"manas-2010:p1437:b001:l011","ordinal":62081,"en":"The precious lion who had sat unmoving,"},{"id":"manas-2010:p1437:b001:l012","ordinal":62082,"en":"Lest he suddenly slaughter Sarala,"},{"id":"manas-2010:p1437:b001:l013","ordinal":62083,"en":"That lion warrior took fright."},{"id":"manas-2010:p1437:b001:l014","ordinal":62084,"en":"Lest Almambet in his joy"},{"id":"manas-2010:p1437:b001:l015","ordinal":62085,"en":"Truly bring disaster upon them,"},{"id":"manas-2010:p1437:b001:l016","ordinal":62086,"en":"Lest that noble steed Sarala,"},{"id":"manas-2010:p1437:b001:l017","ordinal":62087,"en":"In his joy, Almambet"},{"id":"manas-2010:p1437:b001:l018","ordinal":62088,"en":"Slaughter as a sacrifice,"},{"id":"manas-2010:p1437:b001:l019","ordinal":62089,"en":"He thought and found a plan."},{"id":"manas-2010:p1437:b001:l020","ordinal":62090,"en":"Argynkhan’s Ajybai,"},{"id":"manas-2010:p1437:b001:l021","ordinal":62091,"en":"With Kalkaman’s Black Horse alongside,"},{"id":"manas-2010:p1437:b001:l022","ordinal":62092,"en":"He sent galloping to meet him."},{"id":"manas-2010:p1437:b001:l023","ordinal":62093,"en":"Kalkaman’s Black Horse—"},{"id":"manas-2010:p1437:b001:l024","ordinal":62094,"en":"Whenever a companion took offense,"},{"id":"manas-2010:p1437:b001:l025","ordinal":62095,"en":"It was the custom to offer him that horse."},{"id":"manas-2010:p1437:b001:l026","ordinal":62096,"en":"As Sarala was about to be slaughtered,"},{"id":"manas-2010:p1437:b001:l027","ordinal":62097,"en":"It went as a gift, did you see,"},{"id":"manas-2010:p1437:b001:l028","ordinal":62098,"en":"That Black Horse I spoke of."},{"id":"manas-2010:p1437:b001:l029","ordinal":62099,"en":"A gleaming scimitar in his right hand,"},{"id":"manas-2010:p1437:b001:l030","ordinal":62100,"en":"Preventing Sarala’s slaughter,"},{"id":"manas-2010:p1437:b001:l031","ordinal":62101,"en":"Ajybai stood holding him back."},{"id":"manas-2010:p1437:b001:l032","ordinal":62102,"en":"“Do not slaughter Sarala!”"},{"id":"manas-2010:p1437:b001:l033","ordinal":62103,"en":"Ajybai kept imploring:"},{"id":"manas-2010:p1437:b001:l034","ordinal":62104,"en":"“Warrior Almam, heed my words."},{"id":"manas-2010:p1437:b001:l035","ordinal":62105,"en":"The days that God has brought upon us"},{"id":"manas-2010:p1437:b001:l036","ordinal":62106,"en":"We have no choice but to endure."},{"id":"manas-2010:p1437:b001:l037","ordinal":62107,"en":"Consider it, Almambet:"},{"id":"manas-2010:p1437:b001:l038","ordinal":62108,"en":"You lived childless for many years."},{"id":"manas-2010:p1437:b001:l039","ordinal":62109,"en":"If you slaughter Sarala,"},{"id":"manas-2010:p1437:b001:l040","ordinal":62110,"en":"We shall camp along the river;"},{"id":"manas-2010:p1437:b001:l041","ordinal":62111,"en":"Amid an enemy blazing like fire,"},{"id":"manas-2010:p1437:b001:l042","ordinal":62112,"en":"We shall be like a fire put out!"},{"id":"manas-2010:p1438:b001:l001","ordinal":62113,"en":"“If you sacrifice Sarala,"},{"id":"manas-2010:p1438:b001:l002","ordinal":62114,"en":"Will the Chinese not dance and laugh?"},{"id":"manas-2010:p1438:b001:l003","ordinal":62115,"en":"‘The rash fugitive’s"},{"id":"manas-2010:p1438:b001:l004","ordinal":62116,"en":"Back is broken!’ will they not say?"},{"id":"manas-2010:p1438:b001:l005","ordinal":62117,"en":"Heed my words, Almambet:"},{"id":"manas-2010:p1438:b001:l006","ordinal":62118,"en":"For a child still in the womb,"},{"id":"manas-2010:p1438:b001:l007","ordinal":62119,"en":"By sacrificing Sarala,"},{"id":"manas-2010:p1438:b001:l008","ordinal":62120,"en":"Do not break my back."},{"id":"manas-2010:p1438:b001:l009","ordinal":62121,"en":"Where a horse could be sacrificed without shame,"},{"id":"manas-2010:p1438:b001:l010","ordinal":62122,"en":"Here are no tamarisk-grown plains of Keng-Kol;"},{"id":"manas-2010:p1438:b001:l011","ordinal":62123,"en":"Do not sacrifice Sarala;"},{"id":"manas-2010:p1438:b001:l012","ordinal":62124,"en":"Where Sarala could be sacrificed,"},{"id":"manas-2010:p1438:b001:l013","ordinal":62125,"en":"Here are no banks of great Talas!"},{"id":"manas-2010:p1438:b001:l014","ordinal":62126,"en":"Now, by unbelievers of another faith,"},{"id":"manas-2010:p1438:b001:l015","ordinal":62127,"en":"We are held surrounded;"},{"id":"manas-2010:p1438:b001:l016","ordinal":62128,"en":"By the red-tasselled Chinese,"},{"id":"manas-2010:p1438:b001:l017","ordinal":62129,"en":"We are held under pressure."},{"id":"manas-2010:p1438:b001:l018","ordinal":62130,"en":"Of the red sword of steel,"},{"id":"manas-2010:p1438:b001:l019","ordinal":62131,"en":"We stand at the collar of its hilt;"},{"id":"manas-2010:p1438:b001:l020","ordinal":62132,"en":"Among the Chinese whom no torrent reaches,"},{"id":"manas-2010:p1438:b001:l021","ordinal":62133,"en":"We stand in their midst!"},{"id":"manas-2010:p1438:b001:l022","ordinal":62134,"en":"If they draw their bows like falling rain,"},{"id":"manas-2010:p1438:b001:l023","ordinal":62135,"en":"If the Chinese mass and overwhelm us,"},{"id":"manas-2010:p1438:b001:l024","ordinal":62136,"en":"With no courser to ride on reconnaissance,"},{"id":"manas-2010:p1438:b001:l025","ordinal":62137,"en":"Will our strength not leave us?"},{"id":"manas-2010:p1438:b001:l026","ordinal":62138,"en":"If we part with Sarala,"},{"id":"manas-2010:p1438:b001:l027","ordinal":62139,"en":"This Beijing that Chalyar never reached,"},{"id":"manas-2010:p1438:b001:l028","ordinal":62140,"en":"Will it not mass and overwhelm us?"},{"id":"manas-2010:p1438:b001:l029","ordinal":62141,"en":"Think a little, Almambet:"},{"id":"manas-2010:p1438:b001:l030","ordinal":62142,"en":"Will our means not fail us then?"},{"id":"manas-2010:p1438:b001:l031","ordinal":62143,"en":"Sarala beneath you"},{"id":"manas-2010:p1438:b001:l032","ordinal":62144,"en":"Was your wing: do not fold it!"},{"id":"manas-2010:p1438:b001:l033","ordinal":62145,"en":"Black night will fall upon your head."},{"id":"manas-2010:p1438:b001:l034","ordinal":62146,"en":"If you heed me, Almambet,"},{"id":"manas-2010:p1438:b001:l035","ordinal":62147,"en":"Do not part with Sarala!"},{"id":"manas-2010:p1438:b001:l036","ordinal":62148,"en":"If you part with Sarala,"},{"id":"manas-2010:p1438:b001:l037","ordinal":62149,"en":"Will those Chinese, crying out,"},{"id":"manas-2010:p1438:b001:l038","ordinal":62150,"en":"Not surround you,"},{"id":"manas-2010:p1438:b001:l039","ordinal":62151,"en":"Will they not bring hell upon your head?"},{"id":"manas-2010:p1438:b001:l040","ordinal":62152,"en":"If you part with Sarala,"},{"id":"manas-2010:p1438:b001:l041","ordinal":62153,"en":"Will they not surround you?"},{"id":"manas-2010:p1438:b001:l042","ordinal":62154,"en":"The fierce enemy all around you,"},{"id":"manas-2010:p1439:b001:l001","ordinal":62155,"en":"Will they not throw you in a deep pit?"},{"id":"manas-2010:p1439:b001:l002","ordinal":62156,"en":"My ocean, Almambet, heed my words:"},{"id":"manas-2010:p1439:b001:l003","ordinal":62157,"en":"Sacrifice this one, not Sarala!”"},{"id":"manas-2010:p1439:b001:l004","ordinal":62158,"en":"Broad jaw, broad tongue,"},{"id":"manas-2010:p1439:b001:l005","ordinal":62159,"en":"Azhybay, peerless in speech,"},{"id":"manas-2010:p1439:b001:l006","ordinal":62160,"en":"Stood holding the black horse."},{"id":"manas-2010:p1439:b001:l007","ordinal":62161,"en":"To your unshaken Almambet,"},{"id":"manas-2010:p1439:b001:l008","ordinal":62162,"en":"Kalkaman’s black horse,"},{"id":"manas-2010:p1439:b001:l009","ordinal":62163,"en":"Before your noble hawk,"},{"id":"manas-2010:p1439:b001:l010","ordinal":62164,"en":"He presented it crosswise."},{"id":"manas-2010:p1439:b001:l011","ordinal":62165,"en":"Unable to stand still, Almambet,"},{"id":"manas-2010:p1439:b001:l012","ordinal":62166,"en":"The sabre with a mottled neck,"},{"id":"manas-2010:p1439:b001:l013","ordinal":62167,"en":"Almambet took it up."},{"id":"manas-2010:p1439:b001:l014","ordinal":62168,"en":"The forelock and the ears"},{"id":"manas-2010:p1439:b001:l015","ordinal":62169,"en":"Of Kalkaman’s black horse"},{"id":"manas-2010:p1439:b001:l016","ordinal":62170,"en":"He seized together."},{"id":"manas-2010:p1439:b001:l017","ordinal":62171,"en":"Your unshaken lion,"},{"id":"manas-2010:p1439:b001:l018","ordinal":62172,"en":"After standing a while, the black horse"},{"id":"manas-2010:p1439:b001:l019","ordinal":62173,"en":"He slaughtered as a horse sacrifice."},{"id":"manas-2010:p1439:b001:l020","ordinal":62174,"en":"His heart not bursting from joy,"},{"id":"manas-2010:p1439:b001:l021","ordinal":62175,"en":"With warrior Shuutu following him,"},{"id":"manas-2010:p1439:b001:l022","ordinal":62176,"en":"To Manas on the golden throne,"},{"id":"manas-2010:p1439:b001:l023","ordinal":62177,"en":"He brought him there."},{"id":"manas-2010:p1439:b001:l024","ordinal":62178,"en":"Shuutu stood before Manas"},{"id":"manas-2010:p1439:b001:l025","ordinal":62179,"en":"And told the news from Talas:"},{"id":"manas-2010:p1439:b001:l026","ordinal":62180,"en":"“Along river-filled Talas,"},{"id":"manas-2010:p1439:b001:l027","ordinal":62181,"en":"Your people have filled the pastures."},{"id":"manas-2010:p1439:b001:l028","ordinal":62182,"en":"The child born, Semetey,"},{"id":"manas-2010:p1439:b001:l029","ordinal":62183,"en":"Has grown into a cradle infant."},{"id":"manas-2010:p1439:b001:l030","ordinal":62184,"en":"To the Argyn and Ogoy people,"},{"id":"manas-2010:p1439:b001:l031","ordinal":62185,"en":"The steed standing saddled,"},{"id":"manas-2010:p1439:b001:l032","ordinal":62186,"en":"Without letting its fullness show,"},{"id":"manas-2010:p1439:b001:l033","ordinal":62187,"en":"You yourself, leopard Manas,"},{"id":"manas-2010:p1439:b001:l034","ordinal":62188,"en":"That you yourself were absent,"},{"id":"manas-2010:p1439:b001:l035","ordinal":62189,"en":"She raised her own head as a banner,"},{"id":"manas-2010:p1439:b001:l036","ordinal":62190,"en":"Made her woman’s self a warrior,"},{"id":"manas-2010:p1439:b001:l037","ordinal":62191,"en":"Joined what was broken,"},{"id":"manas-2010:p1439:b001:l038","ordinal":62192,"en":"Gathered what was scattered."},{"id":"manas-2010:p1439:b001:l039","ordinal":62193,"en":"Weeping, Kanykey"},{"id":"manas-2010:p1439:b001:l040","ordinal":62194,"en":"Gave six swift horses."},{"id":"manas-2010:p1439:b001:l041","ordinal":62195,"en":"‘From Beijing that Chalyar never touched,"},{"id":"manas-2010:p1439:b001:l042","ordinal":62196,"en":"Let him return without lingering,’ she said."},{"id":"manas-2010:p1440:b001:l001","ordinal":62197,"en":"‘In Beijing that the Flood never touched,"},{"id":"manas-2010:p1440:b001:l002","ordinal":62198,"en":"Let my mighty lord not linger;"},{"id":"manas-2010:p1440:b001:l003","ordinal":62199,"en":"Let him return to Talas quickly."},{"id":"manas-2010:p1440:b001:l004","ordinal":62200,"en":"In strong-backed Beijing,"},{"id":"manas-2010:p1440:b001:l005","ordinal":62201,"en":"If he lies heedless, he will die."},{"id":"manas-2010:p1440:b001:l006","ordinal":62202,"en":"Let my king take heed:"},{"id":"manas-2010:p1440:b001:l007","ordinal":62203,"en":"This champion Semetey,"},{"id":"manas-2010:p1440:b001:l008","ordinal":62204,"en":"When will he see his only son?"},{"id":"manas-2010:p1440:b001:l009","ordinal":62205,"en":"In Beijing whose ridges are costly,"},{"id":"manas-2010:p1440:b001:l010","ordinal":62206,"en":"If he lies without looking back, he will die."},{"id":"manas-2010:p1440:b001:l011","ordinal":62207,"en":"Even if he does not die, my king"},{"id":"manas-2010:p1440:b001:l012","ordinal":62208,"en":"Will suffer grievous torment."}]
