[{"id":"semetey-1-2013:p0442:b004:l031","ordinal":110593,"en":"Your blood-shedding father, the sultan,"},{"id":"semetey-1-2013:p0442:b004:l032","ordinal":110594,"en":"No one dared approach."},{"id":"semetey-1-2013:p0442:b004:l033","ordinal":110595,"en":"He drove white deer and made them cattle;"},{"id":"semetey-1-2013:p0442:b004:l034","ordinal":110596,"en":"Your lion father, the leopard,"},{"id":"semetey-1-2013:p0442:b004:l035","ordinal":110597,"en":"Threw the lands he fought into confusion."},{"id":"semetey-1-2013:p0442:b004:l036","ordinal":110598,"en":"He drove blue-gray deer and made them cattle;"},{"id":"semetey-1-2013:p0442:b004:l037","ordinal":110599,"en":"Your father threw his chosen lands into confusion."},{"id":"semetey-1-2013:p0442:b004:l038","ordinal":110600,"en":"He summered in great Keng-Kol."},{"id":"semetey-1-2013:p0442:b004:l039","ordinal":110601,"en":"If an enemy came forth to fight,"},{"id":"semetey-1-2013:p0443:b003:l001","ordinal":110602,"en":"He drove them before him."},{"id":"semetey-1-2013:p0443:b003:l002","ordinal":110603,"en":"Whoever provoked his anger,"},{"id":"semetey-1-2013:p0443:b003:l003","ordinal":110604,"en":"He chewed without putting them to his molars."},{"id":"semetey-1-2013:p0443:b003:l004","ordinal":110605,"en":"He drained the ammunition-pouch of its shot;"},{"id":"semetey-1-2013:p0443:b003:l005","ordinal":110606,"en":"Your saintly father, that dear lion,"},{"id":"semetey-1-2013:p0443:b003:l006","ordinal":110607,"en":"Terrified those who faced him."},{"id":"semetey-1-2013:p0443:b003:l007","ordinal":110608,"en":"He moved like a lion."},{"id":"semetey-1-2013:p0443:b003:l008","ordinal":110609,"en":"Unable to withstand your father's wrath,"},{"id":"semetey-1-2013:p0443:b003:l009","ordinal":110610,"en":"The khan of the khakan's realm awoke."},{"id":"semetey-1-2013:p0443:b003:l010","ordinal":110611,"en":"His lion-like courage was known to the people."},{"id":"semetey-1-2013:p0443:b003:l011","ordinal":110612,"en":"'Manas will destroy Beijing,' they said."},{"id":"semetey-1-2013:p0443:b003:l012","ordinal":110613,"en":"Your father's nobility,"},{"id":"semetey-1-2013:p0443:b003:l013","ordinal":110614,"en":"His surpassing courage,"},{"id":"semetey-1-2013:p0443:b003:l014","ordinal":110615,"en":"In Beijing's Chyngchuu Khan's"},{"id":"semetey-1-2013:p0443:b003:l015","ordinal":110616,"en":"Register they were inscribed."},{"id":"semetey-1-2013:p0443:b003:l016","ordinal":110617,"en":"When they heard that news,"},{"id":"semetey-1-2013:p0443:b003:l017","ordinal":110618,"en":"Great Beijing fell into turmoil;"},{"id":"semetey-1-2013:p0443:b003:l018","ordinal":110619,"en":"The khan of the khakan's realm grieved."},{"id":"semetey-1-2013:p0443:b003:l019","ordinal":110620,"en":"Your fortunate father rose as khan."},{"id":"semetey-1-2013:p0443:b003:l020","ordinal":110621,"en":"From your departed father's"},{"id":"semetey-1-2013:p0443:b003:l021","ordinal":110622,"en":"Very voice, souls fled their bodies."},{"id":"semetey-1-2013:p0443:b003:l022","ordinal":110623,"en":"Your father Manas, the lion,"},{"id":"semetey-1-2013:p0443:b003:l023","ordinal":110624,"en":"Conquered many, many peoples,"},{"id":"semetey-1-2013:p0443:b003:l024","ordinal":110625,"en":"Conquered many, many lands."},{"id":"semetey-1-2013:p0443:b003:l026","ordinal":110626,"en":"He raised strife in many lands.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0443:b003:l027","ordinal":110627,"en":"Fierce and hardened in wrath,"},{"id":"semetey-1-2013:p0443:b003:l028","ordinal":110628,"en":"Among the Chinese in the khakan's realm"},{"id":"semetey-1-2013:p0443:b003:l029","ordinal":110629,"en":"He was named Manas the Blood-Drinker."},{"id":"semetey-1-2013:p0443:b003:l030","ordinal":110630,"en":"He was a lion of surpassing fortune."},{"id":"semetey-1-2013:p0443:b003:l031","ordinal":110631,"en":"Upon the face of the earth, your father"},{"id":"semetey-1-2013:p0443:b003:l032","ordinal":110632,"en":"Was a hero who came and went but once."},{"id":"semetey-1-2013:p0443:b003:l033","ordinal":110633,"en":"A mortal like your father,"},{"id":"semetey-1-2013:p0443:b003:l034","ordinal":110634,"en":"Allah Most High, the one God,"},{"id":"semetey-1-2013:p0443:b003:l035","ordinal":110635,"en":"Will never create again."},{"id":"semetey-1-2013:p0443:b003:l036","ordinal":110636,"en":"I began telling a tale;"},{"id":"semetey-1-2013:p0443:b003:l037","ordinal":110637,"en":"Of your father's deeds"},{"id":"semetey-1-2013:p0443:b003:l038","ordinal":110638,"en":"I have told a little."},{"id":"semetey-1-2013:p0443:b003:l039","ordinal":110639,"en":"My lament is a white palace;"},{"id":"semetey-1-2013:p0443:b005:l001","ordinal":110640,"en":"If I told my sorrow, it would be long."},{"id":"semetey-1-2013:p0443:b005:l002","ordinal":110641,"en":"As I sit and tell at length,"},{"id":"semetey-1-2013:p0443:b005:l004","ordinal":110642,"en":"Ponder and listen, orphan,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0443:b005:l005","ordinal":110643,"en":"To the tale of me, your luckless mother!"},{"id":"semetey-1-2013:p0443:b005:l006","ordinal":110644,"en":"Allah Most High, the Almighty,"},{"id":"semetey-1-2013:p0443:b005:l007","ordinal":110645,"en":"Will He leave His mortal creatures untaken?"},{"id":"semetey-1-2013:p0443:b005:l008","ordinal":110646,"en":"What I keep asking of God"},{"id":"semetey-1-2013:p0443:b005:l009","ordinal":110647,"en":"Is my one child Semetey."},{"id":"semetey-1-2013:p0443:b005:l010","ordinal":110648,"en":"My plump, gray-speckled white hawk,"},{"id":"semetey-1-2013:p0443:b005:l011","ordinal":110649,"en":"God, let us see him without his growing pale,"},{"id":"semetey-1-2013:p0443:b005:l012","ordinal":110650,"en":"That one morning star, Semetey."},{"id":"semetey-1-2013:p0443:b005:l013","ordinal":110651,"en":"My spring, my river in its valley,"},{"id":"semetey-1-2013:p0443:b005:l014","ordinal":110652,"en":"My little orphan, gained after such hardship,"},{"id":"semetey-1-2013:p0443:b005:l015","ordinal":110653,"en":"My banner fastened to a spear,"},{"id":"semetey-1-2013:p0443:b005:l016","ordinal":110654,"en":"My gift left by the Magnanimous One,"},{"id":"semetey-1-2013:p0443:b005:l017","ordinal":110655,"en":"For whom I rose and braided my hair,"},{"id":"semetey-1-2013:p0443:b005:l018","ordinal":110656,"en":"My child gained when I was near death."},{"id":"semetey-1-2013:p0443:b005:l019","ordinal":110657,"en":"My lament is a white palace;"},{"id":"semetey-1-2013:p0443:b005:l020","ordinal":110658,"en":"Turn, orphan, and listen!"},{"id":"semetey-1-2013:p0443:b005:l021","ordinal":110659,"en":"I shall tell much of my sorrow."},{"id":"semetey-1-2013:p0443:b005:l022","ordinal":110660,"en":"There are further words I have to tell;"},{"id":"semetey-1-2013:p0443:b005:l023","ordinal":110661,"en":"Again, orphan, listen!"},{"id":"semetey-1-2013:p0443:b005:l024","ordinal":110662,"en":"Let me leave this here"},{"id":"semetey-1-2013:p0443:b005:l025","ordinal":110663,"en":"And begin with what lies nearer:"},{"id":"semetey-1-2013:p0443:b005:l026","ordinal":110664,"en":"Those left after the deaths"},{"id":"semetey-1-2013:p0443:b005:l027","ordinal":110665,"en":"Fled to Beijing."},{"id":"semetey-1-2013:p0443:b005:l028","ordinal":110666,"en":"Their leopard hero Kongurbai"},{"id":"semetey-1-2013:p0443:b005:l029","ordinal":110667,"en":"To Karykan of Beijing"},{"id":"semetey-1-2013:p0443:b005:l030","ordinal":110668,"en":"Went and brought the news."},{"id":"semetey-1-2013:p0443:b005:l031","ordinal":110669,"en":"Hearing its import, Karykan"},{"id":"semetey-1-2013:p0443:b005:l032","ordinal":110670,"en":"Raised a great uproar."},{"id":"semetey-1-2013:p0443:b005:l033","ordinal":110671,"en":"The great people of True Beijing,"},{"id":"semetey-1-2013:p0443:b005:l034","ordinal":110672,"en":"Unable to withstand his terrible wrath,"},{"id":"semetey-1-2013:p0443:b005:l035","ordinal":110673,"en":"Were nearly wiped out."},{"id":"semetey-1-2013:p0443:b005:l036","ordinal":110674,"en":"Surrounded by a grove of plane trees,"},{"id":"semetey-1-2013:p0443:b005:l037","ordinal":110675,"en":"The golden throne in Beijing."},{"id":"semetey-1-2013:p0443:b005:l038","ordinal":110676,"en":"The tower the khan ascended,"},{"id":"semetey-1-2013:p0443:b005:l039","ordinal":110677,"en":"To the top of that tower,"},{"id":"semetey-1-2013:p0444:b003:l001","ordinal":110678,"en":"He beat his drum."},{"id":"semetey-1-2013:p0444:b003:l002","ordinal":110679,"en":"Striking the booming drum,"},{"id":"semetey-1-2013:p0444:b003:l003","ordinal":110680,"en":"He gathered his people."},{"id":"semetey-1-2013:p0444:b003:l004","ordinal":110681,"en":"Their khan raised an uproar."},{"id":"semetey-1-2013:p0444:b003:l005","ordinal":110682,"en":"The great people of Khakanchyn,"},{"id":"semetey-1-2013:p0444:b003:l006","ordinal":110683,"en":"Unable to withstand his wrath,"},{"id":"semetey-1-2013:p0444:b003:l007","ordinal":110684,"en":"Nearly fell into disorder."},{"id":"semetey-1-2013:p0444:b003:l008","ordinal":110685,"en":"There were champions, there were elders;"},{"id":"semetey-1-2013:p0444:b003:l009","ordinal":110686,"en":"Of Beijing's forty Chinese tribes,"},{"id":"semetey-1-2013:p0444:b003:l010","ordinal":110687,"en":"All were present then."},{"id":"semetey-1-2013:p0444:b003:l011","ordinal":110688,"en":"'I have faced a terrible ordeal;"},{"id":"semetey-1-2013:p0444:b003:l012","ordinal":110689,"en":"My people, listen!"},{"id":"semetey-1-2013:p0444:b003:l013","ordinal":110690,"en":"I am the renowned Karykan;"},{"id":"semetey-1-2013:p0444:b003:l014","ordinal":110691,"en":"Now, my people, heed me!"},{"id":"semetey-1-2013:p0444:b003:l015","ordinal":110692,"en":"Let your ablest spear-bearers come;"},{"id":"semetey-1-2013:p0444:b003:l016","ordinal":110693,"en":"Now to my side"},{"id":"semetey-1-2013:p0444:b003:l017","ordinal":110694,"en":"Let your finest, wisest speakers come."},{"id":"semetey-1-2013:p0444:b003:l018","ordinal":110695,"en":"Let your champion lions come."},{"id":"semetey-1-2013:p0444:b003:l019","ordinal":110696,"en":"Karykan has a word to say;"},{"id":"semetey-1-2013:p0444:b003:l020","ordinal":110697,"en":"Consider it carefully!"},{"id":"semetey-1-2013:p0444:b003:l021","ordinal":110698,"en":"Kongurbai, son of Alööke,"},{"id":"semetey-1-2013:p0444:b003:l022","ordinal":110699,"en":"Had the Talas country scouted."},{"id":"semetey-1-2013:p0444:b003:l023","ordinal":110700,"en":"When Chubak sent a deceitful letter,"},{"id":"semetey-1-2013:p0444:b003:l024","ordinal":110701,"en":"He drove my people there"},{"id":"semetey-1-2013:p0444:b003:l025","ordinal":110702,"en":"And had them slaughtered by the Kyrgyz."},{"id":"semetey-1-2013:p0444:b003:l026","ordinal":110703,"en":"Manas is no easy khan to face,"},{"id":"semetey-1-2013:p0444:b003:l027","ordinal":110704,"en":"No man to approach without thought."},{"id":"semetey-1-2013:p0444:b003:l028","ordinal":110705,"en":"He is the support they rely upon,"},{"id":"semetey-1-2013:p0444:b003:l029","ordinal":110706,"en":"The hero who came from Mecca."},{"id":"semetey-1-2013:p0444:b003:l030","ordinal":110707,"en":"Unless we trick and slaughter Manas,"},{"id":"semetey-1-2013:p0444:b003:l031","ordinal":110708,"en":"Unless we put him to death,"},{"id":"semetey-1-2013:p0444:b003:l032","ordinal":110709,"en":"He will not let us turn our plows."},{"id":"semetey-1-2013:p0444:b003:l033","ordinal":110710,"en":"He is a giant sprung from the Muslims;"},{"id":"semetey-1-2013:p0444:b003:l034","ordinal":110711,"en":"He will not let us remain in Beijing."},{"id":"semetey-1-2013:p0444:b003:l035","ordinal":110712,"en":"He will teach you a bitter lesson, wretches."},{"id":"semetey-1-2013:p0444:b003:l036","ordinal":110713,"en":"Doing many things, that Manas"},{"id":"semetey-1-2013:p0444:b003:l037","ordinal":110714,"en":"Will have your beautiful daughters carried off."},{"id":"semetey-1-2013:p0444:b003:l038","ordinal":110715,"en":"Raiding and driving off your horses,"},{"id":"semetey-1-2013:p0444:b003:l039","ordinal":110716,"en":"If that Manas remains alive,"},{"id":"semetey-1-2013:p0444:b004:l001","ordinal":110717,"en":"He will rouse you wide awake."},{"id":"semetey-1-2013:p0444:b004:l002","ordinal":110718,"en":"He will bring suffering upon Beijing,"},{"id":"semetey-1-2013:p0444:b004:l003","ordinal":110719,"en":"Break many of your backs,"},{"id":"semetey-1-2013:p0444:b004:l004","ordinal":110720,"en":"Kill many of your heroes."},{"id":"semetey-1-2013:p0444:b004:l005","ordinal":110721,"en":"Braid your coursers' manes;"},{"id":"semetey-1-2013:p0444:b004:l006","ordinal":110722,"en":"Within five or six years,"},{"id":"semetey-1-2013:p0444:b004:l007","ordinal":110723,"en":"If you live, my people, Manas"},{"id":"semetey-1-2013:p0444:b004:l008","ordinal":110724,"en":"You will see here in Beijing!"},{"id":"semetey-1-2013:p0444:b004:l009","ordinal":110725,"en":"I became khan of Beijing."},{"id":"semetey-1-2013:p0444:b004:l010","ordinal":110726,"en":"Gold and precious stones"},{"id":"semetey-1-2013:p0444:b004:l011","ordinal":110727,"en":"I have mines to dig together;"},{"id":"semetey-1-2013:p0444:b004:l012","ordinal":110728,"en":"I have forty Chinese tribes."},{"id":"semetey-1-2013:p0444:b004:l013","ordinal":110729,"en":"Jakyp's only son Manas,"},{"id":"semetey-1-2013:p0444:b004:l014","ordinal":110730,"en":"I fear he will destroy Beijing."},{"id":"semetey-1-2013:p0444:b004:l015","ordinal":110731,"en":"My back has bent like cotton;"},{"id":"semetey-1-2013:p0444:b004:l016","ordinal":110732,"en":"The wondrous seer grieved."},{"id":"semetey-1-2013:p0444:b004:l017","ordinal":110733,"en":"“Manas will take Beijing,”"},{"id":"semetey-1-2013:p0444:b004:l018","ordinal":110734,"en":"It was inscribed in my book."},{"id":"semetey-1-2013:p0444:b004:l019","ordinal":110735,"en":"An earthquake shook Beijing."},{"id":"semetey-1-2013:p0444:b004:l020","ordinal":110736,"en":"Unless we somehow slaughter Manas,"},{"id":"semetey-1-2013:p0444:b004:l021","ordinal":110737,"en":"Unless we put him to death,"},{"id":"semetey-1-2013:p0444:b004:l022","ordinal":110738,"en":"Stony hail will rain upon my land."},{"id":"semetey-1-2013:p0444:b004:l023","ordinal":110739,"en":"Fighting six months without tiring,"},{"id":"semetey-1-2013:p0444:b004:l024","ordinal":110740,"en":"He will wreak havoc upon my people."},{"id":"semetey-1-2013:p0444:b004:l025","ordinal":110741,"en":"The great champion Orokkyr has died;"},{"id":"semetey-1-2013:p0444:b004:l026","ordinal":110742,"en":"Khan Makil, the lookout, has died."},{"id":"semetey-1-2013:p0444:b004:l027","ordinal":110743,"en":"All the Chinese who met Manas have died."},{"id":"semetey-1-2013:p0444:b004:l029","ordinal":110744,"en":"I make a firm promise;"},{"id":"semetey-1-2013:p0444:b004:l030","ordinal":110745,"en":"Hear this, people:"},{"id":"semetey-1-2013:p0444:b004:l031","ordinal":110746,"en":"I swear an oath on pain of death."},{"id":"semetey-1-2013:p0444:b004:l032","ordinal":110747,"en":"Whoever seizes ill-omened Manas"},{"id":"semetey-1-2013:p0444:b004:l033","ordinal":110748,"en":"And slaughters him and returns,"},{"id":"semetey-1-2013:p0444:b004:l034","ordinal":110749,"en":"I will crown with my golden crown,"},{"id":"semetey-1-2013:p0444:b004:l035","ordinal":110750,"en":"I will seat upon my golden throne."},{"id":"semetey-1-2013:p0444:b004:l036","ordinal":110751,"en":"Over this Great Beijing before us,"},{"id":"semetey-1-2013:p0444:b004:l037","ordinal":110752,"en":"I will give him supreme khanly rule!'"},{"id":"semetey-1-2013:p0444:b004:l038","ordinal":110753,"en":"Karykan proclaimed aloud;"},{"id":"semetey-1-2013:p0444:b004:l039","ordinal":110754,"en":"The unbeliever's heart had narrowed."},{"id":"semetey-1-2013:p0445:b003:l001","ordinal":110755,"en":"The Manchu and Chinese champions"},{"id":"semetey-1-2013:p0445:b003:l002","ordinal":110756,"en":"He had gathered in full."},{"id":"semetey-1-2013:p0445:b003:l003","ordinal":110757,"en":"While he stood just so,"},{"id":"semetey-1-2013:p0445:b003:l004","ordinal":110758,"en":"While he put forward this plan,"},{"id":"semetey-1-2013:p0445:b003:l005","ordinal":110759,"en":"Among the coat-wearing Chinese,"},{"id":"semetey-1-2013:p0445:b003:l006","ordinal":110760,"en":"The strongest fled and would not approach."},{"id":"semetey-1-2013:p0445:b003:l007","ordinal":110761,"en":"Among the jewel-wearing Manchus,"},{"id":"semetey-1-2013:p0445:b003:l008","ordinal":110762,"en":"The finest fled and would not approach."},{"id":"semetey-1-2013:p0445:b003:l009","ordinal":110763,"en":"Their champions scattered one by one."},{"id":"semetey-1-2013:p0445:b003:l010","ordinal":110764,"en":"When their great khan spoke thus,"},{"id":"semetey-1-2013:p0445:b003:l011","ordinal":110765,"en":"Kongurbai, son of Alööke,"},{"id":"semetey-1-2013:p0445:b003:l012","ordinal":110766,"en":"Trembled, unable to find a way."},{"id":"semetey-1-2013:p0445:b003:l013","ordinal":110767,"en":"When the khan gave his command,"},{"id":"semetey-1-2013:p0445:b003:l014","ordinal":110768,"en":"His Kalmyk Great Lama,"},{"id":"semetey-1-2013:p0445:b003:l015","ordinal":110769,"en":"His champions such as Khan Joloi,"},{"id":"semetey-1-2013:p0445:b003:l016","ordinal":110770,"en":"Ezkara, khan of the Manchus—"},{"id":"semetey-1-2013:p0445:b003:l017","ordinal":110771,"en":"Unable to withstand his wrath,"},{"id":"semetey-1-2013:p0445:b003:l018","ordinal":110772,"en":"When the khan stood thus,"},{"id":"semetey-1-2013:p0445:b003:l019","ordinal":110773,"en":"The great people were filled with fear."},{"id":"semetey-1-2013:p0445:b003:l020","ordinal":110774,"en":"Their heroes trembled;"},{"id":"semetey-1-2013:p0445:b003:l021","ordinal":110775,"en":"All the foolish ones"},{"id":"semetey-1-2013:p0445:b003:l022","ordinal":110776,"en":"Lost their wits one by one."},{"id":"semetey-1-2013:p0445:b003:l023","ordinal":110777,"en":"Raising a fearful uproar,"},{"id":"semetey-1-2013:p0445:b003:l024","ordinal":110778,"en":"Karykan stood roaring."},{"id":"semetey-1-2013:p0445:b003:l025","ordinal":110779,"en":"In Beijing with its forty gates,"},{"id":"semetey-1-2013:p0445:b003:l026","ordinal":110780,"en":"At forty gates stood forty judges of prowess."},{"id":"semetey-1-2013:p0445:b003:l027","ordinal":110781,"en":"Rousing the peoples of forty khans,"},{"id":"semetey-1-2013:p0445:b003:l028","ordinal":110782,"en":"'Manas, khan of the Kyrgyz—"},{"id":"semetey-1-2013:p0445:b003:l029","ordinal":110783,"en":"Is there a hero who can spear him?' he asked."},{"id":"semetey-1-2013:p0445:b003:l030","ordinal":110784,"en":"The champions of Beijing"},{"id":"semetey-1-2013:p0445:b003:l031","ordinal":110785,"en":"He sent streaming through the forty gates."},{"id":"semetey-1-2013:p0445:b003:l032","ordinal":110786,"en":"All the people,"},{"id":"semetey-1-2013:p0445:b003:l033","ordinal":110787,"en":"Karykan in his wrath"},{"id":"semetey-1-2013:p0445:b003:l034","ordinal":110788,"en":"Tormented, raising a clamor."},{"id":"semetey-1-2013:p0445:b003:l035","ordinal":110789,"en":"His great people said this:"},{"id":"semetey-1-2013:p0445:b003:l036","ordinal":110790,"en":"'Whoever encounters leopard-like Manas"},{"id":"semetey-1-2013:p0445:b003:l037","ordinal":110791,"en":"Will not remain alive."},{"id":"semetey-1-2013:p0445:b003:l038","ordinal":110792,"en":"That blood-drinking, dauntless hero,"},{"id":"semetey-1-2013:p0445:b003:l039","ordinal":110793,"en":"Whoever meets him will not return."},{"id":"semetey-1-2013:p0445:b004:l001","ordinal":110794,"en":"No soul who goes will turn back;"},{"id":"semetey-1-2013:p0445:b004:l002","ordinal":110795,"en":"Whoever attacks Manas will not return!'"},{"id":"semetey-1-2013:p0445:b004:l004","ordinal":110796,"en":"The khakan's people said this"},{"id":"semetey-1-2013:p0445:b004:l005","ordinal":110797,"en":"And stood in sorrow now."},{"id":"semetey-1-2013:p0445:b004:l006","ordinal":110798,"en":"He was the son of a Muslim;"},{"id":"semetey-1-2013:p0445:b004:l007","ordinal":110799,"en":"To the Black Kalmyk khakan,"},{"id":"semetey-1-2013:p0445:b004:l008","ordinal":110800,"en":"When the Manchus slaughtered the Kyrgyz,"},{"id":"semetey-1-2013:p0445:b004:l009","ordinal":110801,"en":"He had once been taken captive as a slave."},{"id":"semetey-1-2013:p0445:b004:l010","ordinal":110802,"en":"Kökchököz and Közkaman,"},{"id":"semetey-1-2013:p0445:b004:l011","ordinal":110803,"en":"Zheltiibes and Changdyayak,"},{"id":"semetey-1-2013:p0445:b004:l012","ordinal":110804,"en":"With Orozon at their head, these five"},{"id":"semetey-1-2013:p0445:b004:l013","ordinal":110805,"en":"Were originally sons of Muslims,"},{"id":"semetey-1-2013:p0445:b004:l014","ordinal":110806,"en":"Slaves of the Black Chinese."},{"id":"semetey-1-2013:p0445:b004:l015","ordinal":110807,"en":"Közkaman's Kongkulboz"},{"id":"semetey-1-2013:p0445:b004:l016","ordinal":110808,"en":"Was a horse resembling a tulpar."},{"id":"semetey-1-2013:p0445:b004:l017","ordinal":110809,"en":"Recorded in the register,"},{"id":"semetey-1-2013:p0445:b004:l018","ordinal":110810,"en":"These five were named"},{"id":"semetey-1-2013:p0445:b004:l019","ordinal":110811,"en":"To go against blessed, dauntless Manas,"},{"id":"semetey-1-2013:p0445:b004:l020","ordinal":110812,"en":"To go to Manas and slaughter him,"},{"id":"semetey-1-2013:p0445:b004:l021","ordinal":110813,"en":"To sate themselves thoroughly with his blood,"},{"id":"semetey-1-2013:p0445:b004:l022","ordinal":110814,"en":"To cut off his head and bring it"},{"id":"semetey-1-2013:p0445:b004:l023","ordinal":110815,"en":"To Karykan's golden throne,"},{"id":"semetey-1-2013:p0445:b004:l024","ordinal":110816,"en":"To lay it there as a gift."},{"id":"semetey-1-2013:p0445:b004:l025","ordinal":110817,"en":"Before the Lama,"},{"id":"semetey-1-2013:p0445:b004:l026","ordinal":110818,"en":"At the foot of the great idol,"},{"id":"semetey-1-2013:p0445:b004:l027","ordinal":110819,"en":"They swore an oath on pain of death,"},{"id":"semetey-1-2013:p0445:b004:l028","ordinal":110820,"en":"Licked deadly poison,"},{"id":"semetey-1-2013:p0445:b004:l029","ordinal":110821,"en":"Slaughtered four pigs apiece,"},{"id":"semetey-1-2013:p0445:b004:l030","ordinal":110822,"en":"And laid the book against their breasts."},{"id":"semetey-1-2013:p0445:b004:l031","ordinal":110823,"en":"Their henchmen were fully assembled."},{"id":"semetey-1-2013:p0445:b004:l032","ordinal":110824,"en":"From before Karykan"},{"id":"semetey-1-2013:p0445:b004:l033","ordinal":110825,"en":"They received poison deadly at a touch."},{"id":"semetey-1-2013:p0445:b004:l034","ordinal":110826,"en":"Speaking without wavering,"},{"id":"semetey-1-2013:p0445:b004:l035","ordinal":110827,"en":"Promising to slaughter courser-like Manas,"},{"id":"semetey-1-2013:p0445:b004:l036","ordinal":110828,"en":"The idol made of bronze"},{"id":"semetey-1-2013:p0445:b004:l037","ordinal":110829,"en":"They clasped again and again."},{"id":"semetey-1-2013:p0445:b004:l038","ordinal":110830,"en":"Közkaman and Kökchököz,"},{"id":"semetey-1-2013:p0445:b004:l039","ordinal":110831,"en":"Speaking in the Kalmyk tongue,"},{"id":"semetey-1-2013:p0446:b003:l001","ordinal":110832,"en":"They swore a pledge on pain of death,"},{"id":"semetey-1-2013:p0446:b003:l002","ordinal":110833,"en":"Made their promise firm,"},{"id":"semetey-1-2013:p0446:b003:l003","ordinal":110834,"en":"Set down the month in writing,"},{"id":"semetey-1-2013:p0446:b003:l004","ordinal":110835,"en":"And tied the days in knots."},{"id":"semetey-1-2013:p0446:b003:l005","ordinal":110836,"en":"To the Chinese sacred well in the khakan's realm"},{"id":"semetey-1-2013:p0446:b003:l006","ordinal":110837,"en":"They went to worship."},{"id":"semetey-1-2013:p0446:b003:l007","ordinal":110838,"en":"The Black Kalmyks and Manchus"},{"id":"semetey-1-2013:p0446:b003:l008","ordinal":110839,"en":"Put their hands and feet into the water."},{"id":"semetey-1-2013:p0446:b003:l009","ordinal":110840,"en":"They had their equipment prepared;"},{"id":"semetey-1-2013:p0446:b003:l010","ordinal":110841,"en":"Of mules for crossing the desert,"},{"id":"semetey-1-2013:p0446:b003:l011","ordinal":110842,"en":"Some forty were assigned for transport."},{"id":"semetey-1-2013:p0446:b003:l012","ordinal":110843,"en":"The great gold-edged book,"},{"id":"semetey-1-2013:p0446:b003:l013","ordinal":110844,"en":"Its law they read over and over."},{"id":"semetey-1-2013:p0446:b003:l014","ordinal":110845,"en":"To cut off Manas's head,"},{"id":"semetey-1-2013:p0446:b003:l015","ordinal":110846,"en":"Közkaman and Kökchököz,"},{"id":"semetey-1-2013:p0446:b003:l016","ordinal":110847,"en":"All five were sent together."},{"id":"semetey-1-2013:p0446:b003:l017","ordinal":110848,"en":"Leaving Beijing, they traveled,"}]
