[{"id":"semetey-1-2013:p0459:b005:l024","ordinal":112129,"en":"My sultan openly despaired of life."},{"id":"semetey-1-2013:p0459:b005:l025","ordinal":112130,"en":"Unable to rise, doubled over,"},{"id":"semetey-1-2013:p0459:b005:l026","ordinal":112131,"en":"After drinking the accursed poison,"},{"id":"semetey-1-2013:p0459:b005:l027","ordinal":112132,"en":"My sultan fell straight onto his head."},{"id":"semetey-1-2013:p0459:b005:l028","ordinal":112133,"en":"“For not heeding Kanykei's words,"},{"id":"semetey-1-2013:p0459:b005:l029","ordinal":112134,"en":"Let this poor head suffer on,” he said."},{"id":"semetey-1-2013:p0459:b005:l030","ordinal":112135,"en":"My dear lord grieved."},{"id":"semetey-1-2013:p0459:b005:l031","ordinal":112136,"en":"Kökchököz's nine sons,"},{"id":"semetey-1-2013:p0459:b005:l032","ordinal":112137,"en":"Közkaman's nine sons—"},{"id":"semetey-1-2013:p0459:b005:l033","ordinal":112138,"en":"All were masters of the spear,"},{"id":"semetey-1-2013:p0459:b005:l034","ordinal":112139,"en":"Skilled men who knew the enemy's tactics,"},{"id":"semetey-1-2013:p0459:b005:l035","ordinal":112140,"en":"Marksmen whose shots did not miss,"},{"id":"semetey-1-2013:p0459:b005:l036","ordinal":112141,"en":"All warriors hostile to your father."},{"id":"semetey-1-2013:p0459:b005:l037","ordinal":112142,"en":"From the khan of the khagan's people"},{"id":"semetey-1-2013:p0459:b005:l038","ordinal":112143,"en":"Those bold men had willingly come,"},{"id":"semetey-1-2013:p0459:b005:l039","ordinal":112144,"en":"Warriors with cast-iron heads,"},{"id":"semetey-1-2013:p0460:b003:l001","ordinal":112145,"en":"Clad in mail of iron cords,"},{"id":"semetey-1-2013:p0460:b003:l002","ordinal":112146,"en":"Those Kozkaman had brought"},{"id":"semetey-1-2013:p0460:b003:l003","ordinal":112147,"en":"Were all dagger-handed warriors."},{"id":"semetey-1-2013:p0460:b003:l004","ordinal":112148,"en":"“You experts who strike with iron maces,"},{"id":"semetey-1-2013:p0460:b003:l005","ordinal":112149,"en":"You skilled wielders of swords,"},{"id":"semetey-1-2013:p0460:b003:l006","ordinal":112150,"en":"You fine drawers of bows,"},{"id":"semetey-1-2013:p0460:b003:l007","ordinal":112151,"en":"Champions come from Beezhin,"},{"id":"semetey-1-2013:p0460:b003:l008","ordinal":112152,"en":"Now that God has delivered this fool,"},{"id":"semetey-1-2013:p0460:b003:l009","ordinal":112153,"en":"Spare him nothing, mighty heroes!”"},{"id":"semetey-1-2013:p0460:b003:l010","ordinal":112154,"en":"His bold men took their swords."},{"id":"semetey-1-2013:p0460:b003:l011","ordinal":112155,"en":"Once formidable Kozkaman had spoken,"},{"id":"semetey-1-2013:p0460:b003:l012","ordinal":112156,"en":"Were they fools to hesitate?"},{"id":"semetey-1-2013:p0460:b003:l013","ordinal":112157,"en":"Chattering away in Kalmyk,"},{"id":"semetey-1-2013:p0460:b003:l014","ordinal":112158,"en":"Praying to their idol,"},{"id":"semetey-1-2013:p0460:b003:l015","ordinal":112159,"en":"Kozkaman and Kokchokoz—"},{"id":"semetey-1-2013:p0460:b003:l016","ordinal":112160,"en":"The six hundred they had brought—"},{"id":"semetey-1-2013:p0460:b003:l017","ordinal":112161,"en":"Were all outstanding champions."},{"id":"semetey-1-2013:p0460:b003:l018","ordinal":112162,"en":"Against drunken, wolf-like Manas,"},{"id":"semetey-1-2013:p0460:b003:l019","ordinal":112163,"en":"They readied their swords."},{"id":"semetey-1-2013:p0460:b003:l020","ordinal":112164,"en":"“The opportunity has come twice!” they said,"},{"id":"semetey-1-2013:p0460:b003:l021","ordinal":112165,"en":"And upon your father, now gone to Judgment,"},{"id":"semetey-1-2013:p0460:b003:l022","ordinal":112166,"en":"They all fell together."},{"id":"semetey-1-2013:p0460:b003:l023","ordinal":112167,"en":"Kokchokoz and Kozkaman"},{"id":"semetey-1-2013:p0460:b003:l024","ordinal":112168,"en":"Took their swords in hand,"},{"id":"semetey-1-2013:p0460:b003:l025","ordinal":112169,"en":"And all the champions"},{"id":"semetey-1-2013:p0460:b003:l026","ordinal":112170,"en":"They openly urged onward:"},{"id":"semetey-1-2013:p0460:b003:l027","ordinal":112171,"en":"“You skilled spearmen,"},{"id":"semetey-1-2013:p0460:b003:l028","ordinal":112172,"en":"You mighty sword-strikers,"},{"id":"semetey-1-2013:p0460:b003:l029","ordinal":112173,"en":"This fool Manas, this slave,"},{"id":"semetey-1-2013:p0460:b003:l030","ordinal":112174,"en":"We have plainly set his misery boiling."},{"id":"semetey-1-2013:p0460:b003:l031","ordinal":112175,"en":"Acting with cunning,"},{"id":"semetey-1-2013:p0460:b003:l032","ordinal":112176,"en":"Pouring spirits and giving poison,"},{"id":"semetey-1-2013:p0460:b003:l033","ordinal":112177,"en":"We have had both his hands bound."},{"id":"semetey-1-2013:p0460:b003:l034","ordinal":112178,"en":"Champions come from Beezhin,"},{"id":"semetey-1-2013:p0460:b003:l035","ordinal":112179,"en":"Renowned, wolf-like Manas—"},{"id":"semetey-1-2013:p0460:b003:l036","ordinal":112180,"en":"The time has come to take him."},{"id":"semetey-1-2013:p0460:b003:l037","ordinal":112181,"en":"Surround him and seize him,"},{"id":"semetey-1-2013:p0460:b003:l038","ordinal":112182,"en":"Slaughter him as a sacrifice,"},{"id":"semetey-1-2013:p0460:b003:l039","ordinal":112183,"en":"Drag his body along,"},{"id":"semetey-1-2013:p0460:b004:l001","ordinal":112184,"en":"Have the great hounds tear him apart!"},{"id":"semetey-1-2013:p0460:b004:l002","ordinal":112185,"en":"Cut off his head and fasten it to you,"},{"id":"semetey-1-2013:p0460:b004:l003","ordinal":112186,"en":"To Karykan of Kakan,"},{"id":"semetey-1-2013:p0460:b004:l004","ordinal":112187,"en":"Go bearing the glad tidings."},{"id":"semetey-1-2013:p0460:b004:l005","ordinal":112188,"en":"The golden throne of Chyn-Beezhin"},{"id":"semetey-1-2013:p0460:b004:l006","ordinal":112189,"en":"Take as your reward for the news!"},{"id":"semetey-1-2013:p0460:b004:l007","ordinal":112190,"en":"If you go with his severed head,"},{"id":"semetey-1-2013:p0460:b004:l008","ordinal":112191,"en":"Karykan, khan of Beezhin,"},{"id":"semetey-1-2013:p0460:b004:l009","ordinal":112192,"en":"Will spare nothing he possesses."},{"id":"semetey-1-2013:p0460:b004:l010","ordinal":112193,"en":"Of the yellow willows he had planted,"},{"id":"semetey-1-2013:p0460:b004:l011","ordinal":112194,"en":"Karykan will give you his grove."},{"id":"semetey-1-2013:p0460:b004:l012","ordinal":112195,"en":"Made of pure gold,"},{"id":"semetey-1-2013:p0460:b004:l013","ordinal":112196,"en":"Karykan will give you his throne."},{"id":"semetey-1-2013:p0460:b004:l014","ordinal":112197,"en":"The center of forty tribes,"},{"id":"semetey-1-2013:p0460:b004:l015","ordinal":112198,"en":"Karykan will give you his city."},{"id":"semetey-1-2013:p0460:b004:l016","ordinal":112199,"en":"He will have his golden crown put on you,"},{"id":"semetey-1-2013:p0460:b004:l017","ordinal":112200,"en":"Seat you on the golden throne."},{"id":"semetey-1-2013:p0460:b004:l018","ordinal":112201,"en":"Those were the words Karykan sent:"},{"id":"semetey-1-2013:p0460:b004:l019","ordinal":112202,"en":"‘Manas in Talas,"},{"id":"semetey-1-2013:p0460:b004:l020","ordinal":112203,"en":"Kill him by whatever means,’ he said."},{"id":"semetey-1-2013:p0460:b004:l021","ordinal":112204,"en":"He reckoned the days,"},{"id":"semetey-1-2013:p0460:b004:l022","ordinal":112205,"en":"Set the days down in writing,"},{"id":"semetey-1-2013:p0460:b004:l023","ordinal":112206,"en":"He reckoned the months,"},{"id":"semetey-1-2013:p0460:b004:l024","ordinal":112207,"en":"Set the months down in writing."},{"id":"semetey-1-2013:p0460:b004:l025","ordinal":112208,"en":"With Karykan, khan of Beezhin,"},{"id":"semetey-1-2013:p0460:b004:l026","ordinal":112209,"en":"We had an agreement."},{"id":"semetey-1-2013:p0460:b004:l027","ordinal":112210,"en":"This fool as huge as Opol-Too,"},{"id":"semetey-1-2013:p0460:b004:l028","ordinal":112211,"en":"The devil has driven him here."},{"id":"semetey-1-2013:p0460:b004:l029","ordinal":112212,"en":"Take heed, champions:"},{"id":"semetey-1-2013:p0460:b004:l030","ordinal":112213,"en":"The deity has granted him to us."},{"id":"semetey-1-2013:p0460:b004:l031","ordinal":112214,"en":"If we take the Buruts' Manas,"},{"id":"semetey-1-2013:p0460:b004:l032","ordinal":112215,"en":"We shall crush them from above,"},{"id":"semetey-1-2013:p0460:b004:l033","ordinal":112216,"en":"Scatter their four kinds of livestock."},{"id":"semetey-1-2013:p0460:b004:l034","ordinal":112217,"en":"These people who have struck at your heads,"},{"id":"semetey-1-2013:p0460:b004:l035","ordinal":112218,"en":"We shall open their eyes wide!"},{"id":"semetey-1-2013:p0460:b004:l036","ordinal":112219,"en":"Raiding and driving off their mares,"},{"id":"semetey-1-2013:p0460:b004:l037","ordinal":112220,"en":"Killing their giant Manas,"},{"id":"semetey-1-2013:p0460:b004:l038","ordinal":112221,"en":"If the Kyrgyz come near,"},{"id":"semetey-1-2013:p0460:b004:l039","ordinal":112222,"en":"Smashing their brains and scattering them,"},{"id":"semetey-1-2013:p0461:b003:l001","ordinal":112223,"en":"Let us bring upon this people"},{"id":"semetey-1-2013:p0461:b003:l002","ordinal":112224,"en":"Retribution for long ago."},{"id":"semetey-1-2013:p0461:b003:l003","ordinal":112225,"en":"Let us seize their Manas and crush him,"},{"id":"semetey-1-2013:p0461:b003:l004","ordinal":112226,"en":"Of these Kyrgyz here,"},{"id":"semetey-1-2013:p0461:b003:l005","ordinal":112227,"en":"Let us scatter the treasure."},{"id":"semetey-1-2013:p0461:b003:l006","ordinal":112228,"en":"Like one oppressed by an evil spirit,"},{"id":"semetey-1-2013:p0461:b003:l007","ordinal":112229,"en":"Let us open their eyes wide."},{"id":"semetey-1-2013:p0461:b003:l008","ordinal":112230,"en":"Let us plunder their valuables,"},{"id":"semetey-1-2013:p0461:b003:l009","ordinal":112231,"en":"Among these Kyrgyz"},{"id":"semetey-1-2013:p0461:b003:l010","ordinal":112232,"en":"Let us bring such ruin."},{"id":"semetey-1-2013:p0461:b003:l011","ordinal":112233,"en":"Lord Manas, their peerless steed—"},{"id":"semetey-1-2013:p0461:b003:l012","ordinal":112234,"en":"The chance has come: let us cleave him."},{"id":"semetey-1-2013:p0461:b003:l013","ordinal":112235,"en":"That dusky beauty,"},{"id":"semetey-1-2013:p0461:b003:l014","ordinal":112236,"en":"The radiant one among Muslims,"},{"id":"semetey-1-2013:p0461:b003:l015","ordinal":112237,"en":"That woman Kanykei,"},{"id":"semetey-1-2013:p0461:b003:l016","ordinal":112238,"en":"Let us seize her as booty."},{"id":"semetey-1-2013:p0461:b003:l017","ordinal":112239,"en":"Their Almambet and Chubak,"},{"id":"semetey-1-2013:p0461:b003:l018","ordinal":112240,"en":"Let us slaughter them as sacrifices."},{"id":"semetey-1-2013:p0461:b003:l019","ordinal":112241,"en":"The two khans, Azhybai and Bakai,"},{"id":"semetey-1-2013:p0461:b003:l020","ordinal":112242,"en":"Let us bind them alive and take them to Kakan"},{"id":"semetey-1-2013:p0461:b003:l021","ordinal":112243,"en":"As our captives."},{"id":"semetey-1-2013:p0461:b003:l022","ordinal":112244,"en":"Make them herd Kakan's cattle;"},{"id":"semetey-1-2013:p0461:b003:l023","ordinal":112245,"en":"Let us avenge our ancient grudge."},{"id":"semetey-1-2013:p0461:b003:l024","ordinal":112246,"en":"Let us slaughter their forty choros,"},{"id":"semetey-1-2013:p0461:b003:l025","ordinal":112247,"en":"Those damned Buruts'"},{"id":"semetey-1-2013:p0461:b003:l026","ordinal":112248,"en":"Daughters let us seize as booty."},{"id":"semetey-1-2013:p0461:b003:l027","ordinal":112249,"en":"Let us kill their lions,"},{"id":"semetey-1-2013:p0461:b003:l028","ordinal":112250,"en":"Let us break these Kyrgyz people's backs."},{"id":"semetey-1-2013:p0461:b003:l030","ordinal":112251,"en":"Let us uproot their royal encampments."},{"id":"semetey-1-2013:p0461:b003:l031","ordinal":112252,"en":"Twelve tumens, countless beasts,"},{"id":"semetey-1-2013:p0461:b003:l032","ordinal":112253,"en":"Let us drive them all to Beezhin,"},{"id":"semetey-1-2013:p0461:b003:l033","ordinal":112254,"en":"And glut ourselves on plunder."},{"id":"semetey-1-2013:p0461:b003:l034","ordinal":112255,"en":"Upon this people, these Kyrgyz,"},{"id":"semetey-1-2013:p0461:b003:l035","ordinal":112256,"en":"Let us unleash a tumult,"},{"id":"semetey-1-2013:p0461:b003:l036","ordinal":112257,"en":"Their women in white headscarves"},{"id":"semetey-1-2013:p0461:b003:l037","ordinal":112258,"en":"Let us leave in mourning."},{"id":"semetey-1-2013:p0461:b003:l038","ordinal":112259,"en":"Let us do as we please;"},{"id":"semetey-1-2013:p0461:b003:l039","ordinal":112260,"en":"Anyone who might rise above us,"},{"id":"semetey-1-2013:p0461:b004:l001","ordinal":112261,"en":"Let us slaughter without leaving one."},{"id":"semetey-1-2013:p0461:b004:l002","ordinal":112262,"en":"When Manas goes, their backbone goes;"},{"id":"semetey-1-2013:p0461:b004:l003","ordinal":112263,"en":"From among these Kyrgyz,"},{"id":"semetey-1-2013:p0461:b004:l004","ordinal":112264,"en":"Their dark, wolf-like lion goes."},{"id":"semetey-1-2013:p0461:b004:l005","ordinal":112265,"en":"Into the barrel holding spirits,"},{"id":"semetey-1-2013:p0461:b004:l006","ordinal":112266,"en":"Let us bring this Manas to his end."},{"id":"semetey-1-2013:p0461:b004:l007","ordinal":112267,"en":"Make herdsmen masters of it:"},{"id":"semetey-1-2013:p0461:b004:l008","ordinal":112268,"en":"This Talas here—"},{"id":"semetey-1-2013:p0461:b004:l009","ordinal":112269,"en":"The time has come to slaughter it."},{"id":"semetey-1-2013:p0461:b004:l010","ordinal":112270,"en":"Champions come from Beezhin,"},{"id":"semetey-1-2013:p0461:b004:l011","ordinal":112271,"en":"Unless you are truly curs,"},{"id":"semetey-1-2013:p0461:b004:l012","ordinal":112272,"en":"Zhakyp's only son Manas—"},{"id":"semetey-1-2013:p0461:b004:l013","ordinal":112273,"en":"Your aching grievance has been relieved."},{"id":"semetey-1-2013:p0461:b004:l014","ordinal":112274,"en":"Since your deity has granted your wish,"},{"id":"semetey-1-2013:p0461:b004:l015","ordinal":112275,"en":"Your eyes have opened wide."},{"id":"semetey-1-2013:p0461:b004:l016","ordinal":112276,"en":"Your furrowed brows have smoothed."},{"id":"semetey-1-2013:p0461:b004:l017","ordinal":112277,"en":"Charge in earnest, champions!"},{"id":"semetey-1-2013:p0461:b004:l018","ordinal":112278,"en":"Now the Kyrgyz have lost their khan."},{"id":"semetey-1-2013:p0461:b004:l019","ordinal":112279,"en":"Pull out their supporting pillar;"},{"id":"semetey-1-2013:p0461:b004:l020","ordinal":112280,"en":"Now bring them to their end."},{"id":"semetey-1-2013:p0461:b004:l021","ordinal":112281,"en":"Your honor has thus been restored,"},{"id":"semetey-1-2013:p0461:b004:l022","ordinal":112282,"en":"Champions come from afar."},{"id":"semetey-1-2013:p0461:b004:l023","ordinal":112283,"en":"Foolish Manas is drunk:"},{"id":"semetey-1-2013:p0461:b004:l024","ordinal":112284,"en":"You have found plenty to amuse yourselves with!”"},{"id":"semetey-1-2013:p0461:b004:l025","ordinal":112285,"en":"Kozkaman and Kokchokoz"},{"id":"semetey-1-2013:p0461:b004:l026","ordinal":112286,"en":"Went on saying much more."},{"id":"semetey-1-2013:p0461:b004:l027","ordinal":112287,"en":"When they heard these words,"},{"id":"semetey-1-2013:p0461:b004:l028","ordinal":112288,"en":"All swarmed forward to attack,"},{"id":"semetey-1-2013:p0461:b004:l029","ordinal":112289,"en":"Falling upon Manas."},{"id":"semetey-1-2013:p0461:b004:l030","ordinal":112290,"en":"God had struck the champion."},{"id":"semetey-1-2013:p0461:b004:l031","ordinal":112291,"en":"Once their khan had given the order,"},{"id":"semetey-1-2013:p0461:b004:l032","ordinal":112292,"en":"Would the mass of champions stand still?"},{"id":"semetey-1-2013:p0461:b004:l033","ordinal":112293,"en":"Not one showed Manas any regard."},{"id":"semetey-1-2013:p0461:b004:l034","ordinal":112294,"en":"Could God strike a man down like this?"},{"id":"semetey-1-2013:p0461:b004:l035","ordinal":112295,"en":"Kokchokoz's nine sons"},{"id":"semetey-1-2013:p0461:b004:l036","ordinal":112296,"en":"Now openly took their swords."},{"id":"semetey-1-2013:p0461:b004:l037","ordinal":112297,"en":"Kozkaman's nine sons,"},{"id":"semetey-1-2013:p0461:b004:l038","ordinal":112298,"en":"Great champions who struck with iron maces,"},{"id":"semetey-1-2013:p0461:b004:l039","ordinal":112299,"en":"Now all swarmed forward together."},{"id":"semetey-1-2013:p0462:b003:l001","ordinal":112300,"en":"Zheltiybes's nine sons,"},{"id":"semetey-1-2013:p0462:b003:l002","ordinal":112301,"en":"Hearing Zhetigin's words,"},{"id":"semetey-1-2013:p0462:b003:l003","ordinal":112302,"en":"Now rushed forward and swarmed over him."},{"id":"semetey-1-2013:p0462:b003:l004","ordinal":112303,"en":"Zheldeiboz's nine sons,"},{"id":"semetey-1-2013:p0462:b003:l005","ordinal":112304,"en":"Skilled strikers with swords,"},{"id":"semetey-1-2013:p0462:b003:l006","ordinal":112305,"en":"Your formidable, wolf-like father—"},{"id":"semetey-1-2013:p0462:b003:l007","ordinal":112306,"en":"As though to cut off his head at once,"},{"id":"semetey-1-2013:p0462:b003:l008","ordinal":112307,"en":"And now came swarming near."},{"id":"semetey-1-2013:p0462:b003:l009","ordinal":112308,"en":"The skilled spearmen"},{"id":"semetey-1-2013:p0462:b003:l010","ordinal":112309,"en":"Took spears and made ready."},{"id":"semetey-1-2013:p0462:b003:l011","ordinal":112310,"en":"Over your lion father,"},{"id":"semetey-1-2013:p0462:b003:l012","ordinal":112311,"en":"The swordsmen swarmed,"},{"id":"semetey-1-2013:p0462:b003:l013","ordinal":112312,"en":"To seize your father,"},{"id":"semetey-1-2013:p0462:b003:l014","ordinal":112313,"en":"To slaughter him as a sacrifice."},{"id":"semetey-1-2013:p0462:b003:l015","ordinal":112314,"en":"Of the Kalmyks clad in armor,"},{"id":"semetey-1-2013:p0462:b003:l016","ordinal":112315,"en":"Many of them swarmed upon him."},{"id":"semetey-1-2013:p0462:b003:l017","ordinal":112316,"en":"Kozkaman shouted,"},{"id":"semetey-1-2013:p0462:b003:l018","ordinal":112317,"en":"Raising his battle cry in Kalmyk."},{"id":"semetey-1-2013:p0462:b003:l019","ordinal":112318,"en":"His mace-bearing champions"},{"id":"semetey-1-2013:p0462:b003:l020","ordinal":112319,"en":"All swarmed upon your father together."},{"id":"semetey-1-2013:p0462:b003:l021","ordinal":112320,"en":"When the Chinese rushed upon him,"},{"id":"semetey-1-2013:p0462:b003:l022","ordinal":112321,"en":"When swords were about to reach his head,"},{"id":"semetey-1-2013:p0462:b003:l023","ordinal":112322,"en":"Your father Manas was a lion."},{"id":"semetey-1-2013:p0462:b003:l024","ordinal":112323,"en":"A soul like your father"},{"id":"semetey-1-2013:p0462:b003:l025","ordinal":112324,"en":"The one God would never create again."},{"id":"semetey-1-2013:p0462:b003:l026","ordinal":112325,"en":"A dark-spotted leopard"},{"id":"semetey-1-2013:p0462:b003:l027","ordinal":112326,"en":"Raged at your father's flank;"},{"id":"semetey-1-2013:p0462:b003:l028","ordinal":112327,"en":"A short-tailed, fierce lion"},{"id":"semetey-1-2013:p0462:b003:l029","ordinal":112328,"en":"Stood ready before your father."},{"id":"semetey-1-2013:p0462:b003:l030","ordinal":112329,"en":"When it took its place before him,"},{"id":"semetey-1-2013:p0462:b003:l031","ordinal":112330,"en":"He assumed the aspect of a white tiger."},{"id":"semetey-1-2013:p0462:b003:l032","ordinal":112331,"en":"Your father's looming figure"},{"id":"semetey-1-2013:p0462:b003:l033","ordinal":112332,"en":"Was fearsome as a thousand men."},{"id":"semetey-1-2013:p0462:b003:l034","ordinal":112333,"en":"The Chinese champions who saw him"},{"id":"semetey-1-2013:p0462:b003:l035","ordinal":112334,"en":"Were sorely shaken."},{"id":"semetey-1-2013:p0462:b003:l036","ordinal":112335,"en":"In the champions' eyes,"},{"id":"semetey-1-2013:p0462:b003:l037","ordinal":112336,"en":"Your father appeared a lion."},{"id":"semetey-1-2013:p0462:b003:l038","ordinal":112337,"en":"His face shone like oiled wheat;"},{"id":"semetey-1-2013:p0462:b003:l039","ordinal":112338,"en":"He loomed like dusky mist."},{"id":"semetey-1-2013:p0462:b004:l001","ordinal":112339,"en":"Both a hero and a lion,"},{"id":"semetey-1-2013:p0462:b004:l002","ordinal":112340,"en":"Your father they could not bear to approach;"},{"id":"semetey-1-2013:p0462:b004:l003","ordinal":112341,"en":"There they were thrown into confusion."},{"id":"semetey-1-2013:p0462:b004:l004","ordinal":112342,"en":"When your father closed his eyes,"},{"id":"semetey-1-2013:p0462:b004:l005","ordinal":112343,"en":"The Chinese surrounded and beset him,"},{"id":"semetey-1-2013:p0462:b004:l006","ordinal":112344,"en":"Skillful horsemen, swift runners on foot,"},{"id":"semetey-1-2013:p0462:b004:l007","ordinal":112345,"en":"All the champions,"},{"id":"semetey-1-2013:p0462:b004:l008","ordinal":112346,"en":"Kokchokoz and Kozkaman,"},{"id":"semetey-1-2013:p0462:b004:l009","ordinal":112347,"en":"Of the unbelievers come from Beezhin,"},{"id":"semetey-1-2013:p0462:b004:l010","ordinal":112348,"en":"The crafty elders—"},{"id":"semetey-1-2013:p0462:b004:l011","ordinal":112349,"en":"Upon your father"},{"id":"semetey-1-2013:p0462:b004:l012","ordinal":112350,"en":"All these men swarmed."},{"id":"semetey-1-2013:p0462:b004:l013","ordinal":112351,"en":"When the Chinese rushed upon him,"},{"id":"semetey-1-2013:p0462:b004:l014","ordinal":112352,"en":"His wits failed, his strength ebbed."},{"id":"semetey-1-2013:p0462:b004:l015","ordinal":112353,"en":"When the Chinese came near to strike,"},{"id":"semetey-1-2013:p0462:b004:l016","ordinal":112354,"en":"When they truly found their chance,"},{"id":"semetey-1-2013:p0462:b004:l017","ordinal":112355,"en":"Begging the Chinese for mercy,"},{"id":"semetey-1-2013:p0462:b004:l018","ordinal":112356,"en":"Your father, truly a sultan,"},{"id":"semetey-1-2013:p0462:b004:l019","ordinal":112357,"en":"Took the sacred gray belt with its pouches"},{"id":"semetey-1-2013:p0462:b004:l020","ordinal":112358,"en":"And fitted it about his neck."},{"id":"semetey-1-2013:p0462:b004:l021","ordinal":112359,"en":"“Creator, grant me faith!” he cried,"},{"id":"semetey-1-2013:p0462:b004:l022","ordinal":112360,"en":"And prayed to the one God."},{"id":"semetey-1-2013:p0462:b004:l023","ordinal":112361,"en":"When your father opened his eyes,"},{"id":"semetey-1-2013:p0462:b004:l024","ordinal":112362,"en":"The champions who had gone to strike"},{"id":"semetey-1-2013:p0462:b004:l025","ordinal":112363,"en":"All fled together."},{"id":"semetey-1-2013:p0462:b004:l026","ordinal":112364,"en":"When your father's eyes closed,"},{"id":"semetey-1-2013:p0462:b004:l027","ordinal":112365,"en":"With beaded hat-finials and coral stones,"},{"id":"semetey-1-2013:p0462:b004:l028","ordinal":112366,"en":"With that swine Kozkaman among them,"},{"id":"semetey-1-2013:p0462:b004:l029","ordinal":112367,"en":"They brandished their broad axes,"},{"id":"semetey-1-2013:p0462:b004:l030","ordinal":112368,"en":"Held out their swords,"},{"id":"semetey-1-2013:p0462:b004:l031","ordinal":112369,"en":"Raised their clubs,"},{"id":"semetey-1-2013:p0462:b004:l032","ordinal":112370,"en":"Thrust their spears aloft."},{"id":"semetey-1-2013:p0462:b004:l033","ordinal":112371,"en":"When your father's eyes closed,"},{"id":"semetey-1-2013:p0462:b004:l034","ordinal":112372,"en":"They advanced, making ready."},{"id":"semetey-1-2013:p0462:b004:l035","ordinal":112373,"en":"When your father's eyes opened,"},{"id":"semetey-1-2013:p0462:b004:l036","ordinal":112374,"en":"Unable to endure his heat,"},{"id":"semetey-1-2013:p0462:b004:l037","ordinal":112375,"en":"Unable to abide his cold,"},{"id":"semetey-1-2013:p0462:b004:l038","ordinal":112376,"en":"They all fled together."},{"id":"semetey-1-2013:p0462:b004:l039","ordinal":112377,"en":"Tirelessly they kept him surrounded,"},{"id":"semetey-1-2013:p0463:b003:l001","ordinal":112378,"en":"Unable to slaughter him as a sacrifice,"},{"id":"semetey-1-2013:p0463:b003:l002","ordinal":112379,"en":"Your father, now gone to Judgment,"},{"id":"semetey-1-2013:p0463:b003:l003","ordinal":112380,"en":"They could not dare attack."},{"id":"semetey-1-2013:p0463:b003:l004","ordinal":112381,"en":"Unable to attain their aim,"},{"id":"semetey-1-2013:p0463:b003:l005","ordinal":112382,"en":"Unable to cut off his head and leave,"},{"id":"semetey-1-2013:p0463:b003:l006","ordinal":112383,"en":"The swordsmen could not approach."},{"id":"semetey-1-2013:p0463:b003:l007","ordinal":112384,"en":"Your father was an awe-inspiring, peerless lion;"}]
