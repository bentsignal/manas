[{"id":"semetey-1-2013:p0724:b004:l005","ordinal":131841,"en":"Not yielding to the Chinese,"},{"id":"semetey-1-2013:p0724:b004:l006","ordinal":131842,"en":"Such were the deeds we wrought."},{"id":"semetey-1-2013:p0724:b004:l007","ordinal":131843,"en":"When we came and settled in Talas,"},{"id":"semetey-1-2013:p0724:b004:l008","ordinal":131844,"en":"Precious child Kardygach"},{"id":"semetey-1-2013:p0724:b004:l009","ordinal":131845,"en":"Became the object of slander."},{"id":"semetey-1-2013:p0724:b004:l010","ordinal":131846,"en":"Warrior Manas stood and said:"},{"id":"semetey-1-2013:p0724:b004:l011","ordinal":131847,"en":"‘The people's mouths have no sieve."},{"id":"semetey-1-2013:p0724:b004:l012","ordinal":131848,"en":"She will hear it from thoughtless people,"},{"id":"semetey-1-2013:p0724:b004:l013","ordinal":131849,"en":"And that day her soul will depart."},{"id":"semetey-1-2013:p0724:b004:l014","ordinal":131850,"en":"If she hears the people's gossip,"},{"id":"semetey-1-2013:p0724:b004:l015","ordinal":131851,"en":"That very day she will die."},{"id":"semetey-1-2013:p0724:b004:l016","ordinal":131852,"en":"My younger sister, still young,"},{"id":"semetey-1-2013:p0724:b004:l017","ordinal":131853,"en":"Will see the face of the next world.’"},{"id":"semetey-1-2013:p0724:b004:l018","ordinal":131854,"en":"That she would be slandered,"},{"id":"semetey-1-2013:p0724:b004:l019","ordinal":131855,"en":"Blessed Manas foresaw."},{"id":"semetey-1-2013:p0724:b004:l020","ordinal":131856,"en":"Jelpinish at the ends of the earth,"},{"id":"semetey-1-2013:p0724:b004:l021","ordinal":131857,"en":"To the one who dwelt in Jelpinish,"},{"id":"semetey-1-2013:p0724:b004:l022","ordinal":131858,"en":"The ruler of that wicked people,"},{"id":"semetey-1-2013:p0724:b004:l023","ordinal":131859,"en":"Their giant called Jarmanas,"},{"id":"semetey-1-2013:p0724:b004:l024","ordinal":131860,"en":"We gave her to Jarmanas."},{"id":"semetey-1-2013:p0724:b004:l025","ordinal":131861,"en":"Since we gave her to Jarmanas,"},{"id":"semetey-1-2013:p0724:b004:l026","ordinal":131862,"en":"No one had traveled there;"},{"id":"semetey-1-2013:p0724:b004:l027","ordinal":131863,"en":"No one had received news of her."},{"id":"semetey-1-2013:p0724:b004:l028","ordinal":131864,"en":"If we piece the tradition together,"},{"id":"semetey-1-2013:p0724:b004:l029","ordinal":131865,"en":"There is no one who knows."},{"id":"semetey-1-2013:p0724:b004:l030","ordinal":131866,"en":"That rider on the dark-brown horse"},{"id":"semetey-1-2013:p0724:b004:l031","ordinal":131867,"en":"Is Kardygach herself."},{"id":"semetey-1-2013:p0724:b004:l032","ordinal":131868,"en":"Her elder brother, Khan Manas,"},{"id":"semetey-1-2013:p0724:b004:l033","ordinal":131869,"en":"She has come to see.’"},{"id":"semetey-1-2013:p0724:b004:l034","ordinal":131870,"en":"So spoke Khan Bakai."},{"id":"semetey-1-2013:p0724:b004:l035","ordinal":131871,"en":"Before he could close his mouth,"},{"id":"semetey-1-2013:p0724:b004:l036","ordinal":131872,"en":"The younger sister Kardygach,"},{"id":"semetey-1-2013:p0724:b004:l037","ordinal":131873,"en":"Her heart sorely troubled,"},{"id":"semetey-1-2013:p0724:b004:l038","ordinal":131874,"en":"Tears streaming from her eyes,"},{"id":"semetey-1-2013:p0724:b004:l039","ordinal":131875,"en":"Her thoughts torn by anguish,"},{"id":"semetey-1-2013:p0725:b003:l001","ordinal":131876,"en":"Tears in stream upon stream"},{"id":"semetey-1-2013:p0725:b003:l002","ordinal":131877,"en":"Poured down her precious face."},{"id":"semetey-1-2013:p0725:b003:l003","ordinal":131878,"en":"What could unfortunate Kardygach do?"},{"id":"semetey-1-2013:p0725:b003:l004","ordinal":131879,"en":"When she looked upon Bakai's face,"},{"id":"semetey-1-2013:p0725:b003:l005","ordinal":131880,"en":"A goatskin coat was on his body,"},{"id":"semetey-1-2013:p0725:b003:l006","ordinal":131881,"en":"Hide trousers upon his rear."},{"id":"semetey-1-2013:p0725:b003:l007","ordinal":131882,"en":"His beard had whitened;"},{"id":"semetey-1-2013:p0725:b003:l008","ordinal":131883,"en":"His journey was drawing near."},{"id":"semetey-1-2013:p0725:b003:l009","ordinal":131884,"en":"The flower that bloomed above his head"},{"id":"semetey-1-2013:p0725:b003:l010","ordinal":131885,"en":"Had long since faded away."},{"id":"semetey-1-2013:p0725:b003:l011","ordinal":131886,"en":"Upon Khan Bakai's head"},{"id":"semetey-1-2013:p0725:b003:l012","ordinal":131887,"en":"The semblance of death had come."},{"id":"semetey-1-2013:p0725:b003:l013","ordinal":131888,"en":"Fierce old Bakai—"},{"id":"semetey-1-2013:p0725:b003:l014","ordinal":131889,"en":"His eyes were filled with pus,"},{"id":"semetey-1-2013:p0725:b003:l015","ordinal":131890,"en":"His chest had begun to rattle,"},{"id":"semetey-1-2013:p0725:b003:l016","ordinal":131891,"en":"His joints had grown loose,"},{"id":"semetey-1-2013:p0725:b003:l017","ordinal":131892,"en":"His eyes gleamed from deep within,"},{"id":"semetey-1-2013:p0725:b003:l018","ordinal":131893,"en":"His beard was white as a swan."},{"id":"semetey-1-2013:p0725:b003:l019","ordinal":131894,"en":"His time to perish had come—"},{"id":"semetey-1-2013:p0725:b003:l020","ordinal":131895,"en":"Such had Khan Bakai become."},{"id":"semetey-1-2013:p0725:b003:l021","ordinal":131896,"en":"As Kardygach gazed,"},{"id":"semetey-1-2013:p0725:b003:l022","ordinal":131897,"en":"Upon warrior Bakai's head"},{"id":"semetey-1-2013:p0725:b003:l023","ordinal":131898,"en":"Death's wrath had descended."},{"id":"semetey-1-2013:p0725:b003:l024","ordinal":131899,"en":"The signs of life"},{"id":"semetey-1-2013:p0725:b003:l025","ordinal":131900,"en":"Had long since passed away."},{"id":"semetey-1-2013:p0725:b003:l026","ordinal":131901,"en":"Seeing Bakai, she wept bitterly,"},{"id":"semetey-1-2013:p0725:b003:l027","ordinal":131902,"en":"Screaming in anguish:"},{"id":"semetey-1-2013:p0725:b003:l028","ordinal":131903,"en":"‘Ah, leopard Bakai, my khan elder!"},{"id":"semetey-1-2013:p0725:b003:l029","ordinal":131904,"en":"The marten cap upon his head—"},{"id":"semetey-1-2013:p0725:b003:l030","ordinal":131905,"en":"Who has not worn it, tossing his head?"},{"id":"semetey-1-2013:p0725:b003:l031","ordinal":131906,"en":"While fortune rested upon him,"},{"id":"semetey-1-2013:p0725:b003:l032","ordinal":131907,"en":"Who has not stridden about roaring?"},{"id":"semetey-1-2013:p0725:b003:l033","ordinal":131908,"en":"When men saw Khan Bakai,"},{"id":"semetey-1-2013:p0725:b003:l034","ordinal":131909,"en":"They trembled, unable to face him."},{"id":"semetey-1-2013:p0725:b003:l035","ordinal":131910,"en":"Valiant Khan Bakai, my elder,"},{"id":"semetey-1-2013:p0725:b003:l036","ordinal":131911,"en":"Have you come to this?!"},{"id":"semetey-1-2013:p0725:b003:l037","ordinal":131912,"en":"Wandering far away,"},{"id":"semetey-1-2013:p0725:b003:l038","ordinal":131913,"en":"Have I come to this?!"},{"id":"semetey-1-2013:p0725:b003:l039","ordinal":131914,"en":"Elder Bakai, the leopard,"},{"id":"semetey-1-2013:p0725:b004:l001","ordinal":131915,"en":"My beloved saint,"},{"id":"semetey-1-2013:p0725:b004:l002","ordinal":131916,"en":"Known to all the people,"},{"id":"semetey-1-2013:p0725:b004:l003","ordinal":131917,"en":"The just judge of this world,"},{"id":"semetey-1-2013:p0725:b004:l004","ordinal":131918,"en":"Whom mountain floods could not wear away,"},{"id":"semetey-1-2013:p0725:b004:l005","ordinal":131919,"en":"Of my mountain-like elder brother Manas,"},{"id":"semetey-1-2013:p0725:b004:l006","ordinal":131920,"en":"The mountain-like golden pillar!"},{"id":"semetey-1-2013:p0725:b004:l007","ordinal":131921,"en":"Helplessly driven to wander,"},{"id":"semetey-1-2013:p0725:b004:l008","ordinal":131922,"en":"I was the one who went far away."},{"id":"semetey-1-2013:p0725:b004:l009","ordinal":131923,"en":"When a storm came, no wind could reach through—"},{"id":"semetey-1-2013:p0725:b004:l010","ordinal":131924,"en":"You were a dense forest thicket."},{"id":"semetey-1-2013:p0725:b004:l011","ordinal":131925,"en":"Bewildered, hearing no news,"},{"id":"semetey-1-2013:p0725:b004:l012","ordinal":131926,"en":"I was the wretch bowed with grief."},{"id":"semetey-1-2013:p0725:b004:l013","ordinal":131927,"en":"I have returned to Talas."},{"id":"semetey-1-2013:p0725:b004:l014","ordinal":131928,"en":"Are your Kyrgyz people well?"},{"id":"semetey-1-2013:p0725:b004:l015","ordinal":131929,"en":"Tell me the news, elder."},{"id":"semetey-1-2013:p0725:b004:l016","ordinal":131930,"en":"Is your lion Manas safe?"},{"id":"semetey-1-2013:p0725:b004:l017","ordinal":131931,"en":"When the eyes behold, the belly seethes."},{"id":"semetey-1-2013:p0725:b004:l018","ordinal":131932,"en":"Your lands, Keng-Özön and Keng-Kol—"},{"id":"semetey-1-2013:p0725:b004:l019","ordinal":131933,"en":"I ask, are they safe and well,"},{"id":"semetey-1-2013:p0725:b004:l020","ordinal":131934,"en":"Your widespread Argin people?"},{"id":"semetey-1-2013:p0725:b004:l021","ordinal":131935,"en":"Do not distress me, elder; tell me quickly."},{"id":"semetey-1-2013:p0725:b004:l022","ordinal":131936,"en":"Is he safe and well,"},{"id":"semetey-1-2013:p0725:b004:l023","ordinal":131937,"en":"Your lion Manas of old?"},{"id":"semetey-1-2013:p0725:b004:l024","ordinal":131938,"en":"Our tethering line stretched in Keng-Kol—"},{"id":"semetey-1-2013:p0725:b004:l025","ordinal":131939,"en":"Is she alive, not gone to the next world,"},{"id":"semetey-1-2013:p0725:b004:l026","ordinal":131940,"en":"Our aged mother Chiyyrdy?"},{"id":"semetey-1-2013:p0725:b004:l027","ordinal":131941,"en":"She was the skilled one among women,"},{"id":"semetey-1-2013:p0725:b004:l028","ordinal":131942,"en":"The daughter of Temir Khan."},{"id":"semetey-1-2013:p0725:b004:l029","ordinal":131943,"en":"Joined together when thumb-sized,"},{"id":"semetey-1-2013:p0725:b004:l030","ordinal":131944,"en":"United when tiny as lice."},{"id":"semetey-1-2013:p0725:b004:l031","ordinal":131945,"en":"My sister-in-law Kanykei, who knew my secrets—"},{"id":"semetey-1-2013:p0725:b004:l032","ordinal":131946,"en":"Is my mighty one safe and well?’"},{"id":"semetey-1-2013:p0725:b004:l033","ordinal":131947,"en":"So Kardygach spoke,"},{"id":"semetey-1-2013:p0725:b004:l034","ordinal":131948,"en":"Asking after the people."},{"id":"semetey-1-2013:p0725:b004:l035","ordinal":131949,"en":"Honored Manas, the bloodthirsty lion,"},{"id":"semetey-1-2013:p0725:b004:l036","ordinal":131950,"en":"And all forty companions,"},{"id":"semetey-1-2013:p0725:b004:l037","ordinal":131951,"en":"She asked about them equally."},{"id":"semetey-1-2013:p0725:b004:l038","ordinal":131952,"en":"‘Elder Bakai, hear my words!"},{"id":"semetey-1-2013:p0725:b004:l039","ordinal":131953,"en":"The mighty one among the forty companions,"},{"id":"semetey-1-2013:p0726:b003:l001","ordinal":131954,"en":"The foremost among sixty,"},{"id":"semetey-1-2013:p0726:b003:l002","ordinal":131955,"en":"He stained his golden throne,"},{"id":"semetey-1-2013:p0726:b003:l003","ordinal":131956,"en":"Saying, “I have become a true Muslim,”"},{"id":"semetey-1-2013:p0726:b003:l004","ordinal":131957,"en":"He killed his father, Khan Azoozil."},{"id":"semetey-1-2013:p0726:b003:l005","ordinal":131958,"en":"He stained his silver throne,"},{"id":"semetey-1-2013:p0726:b003:l006","ordinal":131959,"en":"He slew his father, the haughty khan."},{"id":"semetey-1-2013:p0726:b003:l007","ordinal":131960,"en":"His gathered wealth fit in his palm;"},{"id":"semetey-1-2013:p0726:b003:l008","ordinal":131961,"en":"Faith alone was what he desired."},{"id":"semetey-1-2013:p0726:b003:l009","ordinal":131962,"en":"Yellow willows he had planted—"},{"id":"semetey-1-2013:p0726:b003:l010","ordinal":131963,"en":"His willows remained in Beijing."},{"id":"semetey-1-2013:p0726:b003:l011","ordinal":131964,"en":"Made of pure gold,"},{"id":"semetey-1-2013:p0726:b003:l012","ordinal":131965,"en":"His throne remained in Beijing."},{"id":"semetey-1-2013:p0726:b003:l013","ordinal":131966,"en":"“Among the infidels of another faith,"},{"id":"semetey-1-2013:p0726:b003:l014","ordinal":131967,"en":"How can I remain?” he said."},{"id":"semetey-1-2013:p0726:b003:l015","ordinal":131968,"en":"“From those terrible afflictions,"},{"id":"semetey-1-2013:p0726:b003:l016","ordinal":131969,"en":"I shall set my soul free.”"},{"id":"semetey-1-2013:p0726:b003:l017","ordinal":131970,"en":"In those days he fled his village and wandered."},{"id":"semetey-1-2013:p0726:b003:l018","ordinal":131971,"en":"Against the seething infidels,"},{"id":"semetey-1-2013:p0726:b003:l019","ordinal":131972,"en":"For six years he contested the khanship."},{"id":"semetey-1-2013:p0726:b003:l020","ordinal":131973,"en":"Your champion fled the Chinese,"},{"id":"semetey-1-2013:p0726:b003:l021","ordinal":131974,"en":"Came and settled in Talas,"},{"id":"semetey-1-2013:p0726:b003:l022","ordinal":131975,"en":"Became Manas's companion."},{"id":"semetey-1-2013:p0726:b003:l023","ordinal":131976,"en":"With golden forelock and tasseled sash,"},{"id":"semetey-1-2013:p0726:b003:l024","ordinal":131977,"en":"The only son of Beijing's Khan Azoozil,"},{"id":"semetey-1-2013:p0726:b003:l026","ordinal":131978,"en":"Is fierce Almambet safe?"},{"id":"semetey-1-2013:p0726:b003:l027","ordinal":131979,"en":"Light on a horse, suited to a yearling,"},{"id":"semetey-1-2013:p0726:b003:l028","ordinal":131980,"en":"Sleepless, watchful on the road,"},{"id":"semetey-1-2013:p0726:b003:l029","ordinal":131981,"en":"Never resting upon his elbows,"},{"id":"semetey-1-2013:p0726:b003:l030","ordinal":131982,"en":"Never sleeping a wink,"},{"id":"semetey-1-2013:p0726:b003:l031","ordinal":131983,"en":"Never drawing back what he extended,"},{"id":"semetey-1-2013:p0726:b003:l032","ordinal":131984,"en":"Never returning downcast from the foe,"},{"id":"semetey-1-2013:p0726:b003:l033","ordinal":131985,"en":"The edge of black steel,"},{"id":"semetey-1-2013:p0726:b003:l034","ordinal":131986,"en":"Khan Manas's Syrgak—"},{"id":"semetey-1-2013:p0726:b003:l035","ordinal":131987,"en":"Is my precious younger brother safe?"},{"id":"semetey-1-2013:p0726:b003:l036","ordinal":131988,"en":"Khan elder Bakai, tell me the truth!"},{"id":"semetey-1-2013:p0726:b003:l037","ordinal":131989,"en":"Dwelling in broad Alai,"},{"id":"semetey-1-2013:p0726:b003:l038","ordinal":131990,"en":"Akbaltai, khan of the Noigut,"},{"id":"semetey-1-2013:p0726:b003:l039","ordinal":131991,"en":"Was called a warrior like a saint."},{"id":"semetey-1-2013:p0726:b004:l001","ordinal":131992,"en":"He gathered and kept all four kinds of livestock."},{"id":"semetey-1-2013:p0726:b004:l002","ordinal":131993,"en":"That Baltai was called rich;"},{"id":"semetey-1-2013:p0726:b004:l003","ordinal":131994,"en":"His wisdom was spread among the people."},{"id":"semetey-1-2013:p0726:b004:l004","ordinal":131995,"en":"In Akbaltai's household,"},{"id":"semetey-1-2013:p0726:b004:l005","ordinal":131996,"en":"They said there were sixty wives."},{"id":"semetey-1-2013:p0726:b004:l006","ordinal":131997,"en":"What could Baltai do in old age?"},{"id":"semetey-1-2013:p0726:b004:l007","ordinal":131998,"en":"He had taken sixty wives."},{"id":"semetey-1-2013:p0726:b004:l008","ordinal":131999,"en":"None of the sixty bore a child;"},{"id":"semetey-1-2013:p0726:b004:l009","ordinal":132000,"en":"He had not seen a single child."},{"id":"semetey-1-2013:p0726:b004:l010","ordinal":132001,"en":"Were sixty wives a delight?"},{"id":"semetey-1-2013:p0726:b004:l011","ordinal":132002,"en":"He had taken wives for a child."},{"id":"semetey-1-2013:p0726:b004:l012","ordinal":132003,"en":"Until he reached eighty,"},{"id":"semetey-1-2013:p0726:b004:l013","ordinal":132004,"en":"He had not seen a child."},{"id":"semetey-1-2013:p0726:b004:l014","ordinal":132005,"en":"He spent nights in summer pastures."},{"id":"semetey-1-2013:p0726:b004:l015","ordinal":132006,"en":"What could precious Baltai do?"},{"id":"semetey-1-2013:p0726:b004:l016","ordinal":132007,"en":"All his four kinds of livestock,"},{"id":"semetey-1-2013:p0726:b004:l017","ordinal":132008,"en":"He spent and gave away."},{"id":"semetey-1-2013:p0726:b004:l018","ordinal":132009,"en":"Setting no store by his livestock,"},{"id":"semetey-1-2013:p0726:b004:l019","ordinal":132010,"en":"He begged God for a child."},{"id":"semetey-1-2013:p0726:b004:l020","ordinal":132011,"en":"The troubles of this world"},{"id":"semetey-1-2013:p0726:b004:l021","ordinal":132012,"en":"He was destined to see."},{"id":"semetey-1-2013:p0726:b004:l022","ordinal":132013,"en":"Khan Baltai was bowed with grief;"},{"id":"semetey-1-2013:p0726:b004:l024","ordinal":132014,"en":"Amazed at this treacherous world,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0726:b004:l025","ordinal":132015,"en":"Lamenting, “I have no child,”"},{"id":"semetey-1-2013:p0726:b004:l026","ordinal":132016,"en":"In those days, when the people moved uphill,"},{"id":"semetey-1-2013:p0726:b004:l027","ordinal":132017,"en":"When summer came and horses’ tongues darkened,"},{"id":"semetey-1-2013:p0726:b004:l028","ordinal":132018,"en":"Then Akbaltai"},{"id":"semetey-1-2013:p0726:b004:l029","ordinal":132019,"en":"Gathered sixty marksmen."},{"id":"semetey-1-2013:p0726:b004:l030","ordinal":132020,"en":"He scouted far along the road."},{"id":"semetey-1-2013:p0726:b004:l031","ordinal":132021,"en":"To a ridge like a saddle's back,"},{"id":"semetey-1-2013:p0726:b004:l032","ordinal":132022,"en":"When he descended,"},{"id":"semetey-1-2013:p0726:b004:l033","ordinal":132023,"en":"Of the wilderness of Mediyan,"},{"id":"semetey-1-2013:p0726:b004:l034","ordinal":132024,"en":"When he came down upon its expanse,"},{"id":"semetey-1-2013:p0726:b004:l035","ordinal":132025,"en":"Placed in white saddlebags,"},{"id":"semetey-1-2013:p0726:b004:l036","ordinal":132026,"en":"Upon Akbaltai's gray she-camel,"},{"id":"semetey-1-2013:p0726:b004:l037","ordinal":132027,"en":"Tied to her hump—"},{"id":"semetey-1-2013:p0726:b004:l038","ordinal":132028,"en":"What could precious Baltai do?"},{"id":"semetey-1-2013:p0726:b004:l039","ordinal":132029,"en":"He turned his horse's head,"},{"id":"semetey-1-2013:p0727:b003:l001","ordinal":132030,"en":"The child tied to the hump"},{"id":"semetey-1-2013:p0727:b003:l002","ordinal":132031,"en":"Was crying aloud."},{"id":"semetey-1-2013:p0727:b003:l003","ordinal":132032,"en":"Finding him, Akbaltai"},{"id":"semetey-1-2013:p0727:b003:l004","ordinal":132033,"en":"Rejoiced beyond all the world,"},{"id":"semetey-1-2013:p0727:b003:l005","ordinal":132034,"en":"Against his bare white breast"},{"id":"semetey-1-2013:p0727:b003:l006","ordinal":132035,"en":"He placed the fair child."},{"id":"semetey-1-2013:p0727:b003:l007","ordinal":132036,"en":"He pledged a sheep to Koroson,"},{"id":"semetey-1-2013:p0727:b003:l008","ordinal":132037,"en":"Quickly invoked Baabedin."},{"id":"semetey-1-2013:p0727:b003:l009","ordinal":132038,"en":"To God Almighty Allah,"},{"id":"semetey-1-2013:p0727:b003:l010","ordinal":132039,"en":"He recited his pledge of a moon-hoofed beast."},{"id":"semetey-1-2013:p0727:b003:l011","ordinal":132040,"en":"The troubles and grief within his heart,"},{"id":"semetey-1-2013:p0727:b003:l012","ordinal":132041,"en":"He scattered them all, leaving none."},{"id":"semetey-1-2013:p0727:b003:l013","ordinal":132042,"en":"Hurrying, Akbaltai"},{"id":"semetey-1-2013:p0727:b003:l014","ordinal":132043,"en":"Returned toward his home."},{"id":"semetey-1-2013:p0727:b003:l015","ordinal":132044,"en":"The eldest of sixty wives,"},{"id":"semetey-1-2013:p0727:b003:l016","ordinal":132045,"en":"The most radiant of them all,"},{"id":"semetey-1-2013:p0727:b003:l017","ordinal":132046,"en":"Was a skilled woman,"},{"id":"semetey-1-2013:p0727:b003:l018","ordinal":132047,"en":"The daughter of Aigan Khan,"},{"id":"semetey-1-2013:p0727:b003:l019","ordinal":132048,"en":"Of good repute, Kanyshai."},{"id":"semetey-1-2013:p0727:b003:l020","ordinal":132049,"en":"“My senior wife has borne a son!”"},{"id":"semetey-1-2013:p0727:b003:l021","ordinal":132050,"en":"He had it proclaimed to the people."},{"id":"semetey-1-2013:p0727:b003:l022","ordinal":132051,"en":"When Akbaltai gave the feast,"},{"id":"semetey-1-2013:p0727:b003:l023","ordinal":132052,"en":"He slaughtered ninety barren mares."},{"id":"semetey-1-2013:p0727:b003:l024","ordinal":132053,"en":"He gathered the learned men,"},{"id":"semetey-1-2013:p0727:b003:l025","ordinal":132054,"en":"And named the child Chubak."},{"id":"semetey-1-2013:p0727:b003:l026","ordinal":132055,"en":"Thus Khan Chubak,"},{"id":"semetey-1-2013:p0727:b003:l027","ordinal":132056,"en":"Until he reached six years,"},{"id":"semetey-1-2013:p0727:b003:l028","ordinal":132057,"en":"Wore an amulet about his neck."},{"id":"semetey-1-2013:p0727:b003:l029","ordinal":132058,"en":"Sixty wives cradled him"},{"id":"semetey-1-2013:p0727:b003:l030","ordinal":132059,"en":"And reared that Chubak."},{"id":"semetey-1-2013:p0727:b003:l031","ordinal":132060,"en":"That Chubak grew unruly."},{"id":"semetey-1-2013:p0727:b003:l032","ordinal":132061,"en":"If he pushed the children,"},{"id":"semetey-1-2013:p0727:b003:l033","ordinal":132062,"en":"He caused their deaths."},{"id":"semetey-1-2013:p0727:b003:l034","ordinal":132063,"en":"“This pale one is unruly!”"},{"id":"semetey-1-2013:p0727:b003:l035","ordinal":132064,"en":"All the other people"},{"id":"semetey-1-2013:p0727:b003:l036","ordinal":132065,"en":"Gave him the name Bolot."},{"id":"semetey-1-2013:p0727:b003:l037","ordinal":132066,"en":"“Someone's evil eye will strike him;"},{"id":"semetey-1-2013:p0727:b003:l038","ordinal":132067,"en":"He will meet with harm,” they said."},{"id":"semetey-1-2013:p0727:b003:l039","ordinal":132068,"en":"Gold by the pood, red goldwork,"},{"id":"semetey-1-2013:p0727:b004:l001","ordinal":132069,"en":"They loaded upon pack animals."},{"id":"semetey-1-2013:p0727:b004:l002","ordinal":132070,"en":"To Mecca, where the scholars dwelt,"},{"id":"semetey-1-2013:p0727:b004:l003","ordinal":132071,"en":"They prepared and gave him ample provisions,"},{"id":"semetey-1-2013:p0727:b004:l004","ordinal":132072,"en":"Entrusted him to a mullah."},{"id":"semetey-1-2013:p0727:b004:l005","ordinal":132073,"en":"To the renowned city of Mecca,"},{"id":"semetey-1-2013:p0727:b004:l006","ordinal":132074,"en":"Leopard Chubak departed."},{"id":"semetey-1-2013:p0727:b004:l007","ordinal":132075,"en":"Valiant Chubak, your fierce one,"},{"id":"semetey-1-2013:p0727:b004:l008","ordinal":132076,"en":"Those who saw his bearing were afraid."},{"id":"semetey-1-2013:p0727:b004:l009","ordinal":132077,"en":"Five times in the city of Mecca,"},{"id":"semetey-1-2013:p0727:b004:l010","ordinal":132078,"en":"Valiant Chubak studied."},{"id":"semetey-1-2013:p0727:b004:l011","ordinal":132079,"en":"When he finished his studies,"},{"id":"semetey-1-2013:p0727:b004:l012","ordinal":132080,"en":"When Chubak reached twelve,"},{"id":"semetey-1-2013:p0727:b004:l013","ordinal":132081,"en":"He entered the caliph's presence and received a document,"},{"id":"semetey-1-2013:p0727:b004:l014","ordinal":132082,"en":"Received a blessing from the prince,"},{"id":"semetey-1-2013:p0727:b004:l015","ordinal":132083,"en":"Pledged himself to twelve spiritual guides,"},{"id":"semetey-1-2013:p0727:b004:l016","ordinal":132084,"en":"Was called a conquering lord."},{"id":"semetey-1-2013:p0727:b004:l017","ordinal":132085,"en":"When he finished his studies,"},{"id":"semetey-1-2013:p0727:b004:l018","ordinal":132086,"en":"When he reached twelve,"},{"id":"semetey-1-2013:p0727:b004:l019","ordinal":132087,"en":"To his father's home,"},{"id":"semetey-1-2013:p0727:b004:l020","ordinal":132088,"en":"Chubak returned."},{"id":"semetey-1-2013:p0727:b004:l021","ordinal":132089,"en":"Akbalta's countless horses—"},{"id":"semetey-1-2013:p0727:b004:l022","ordinal":132090,"en":"What could precious Chubak do?"},{"id":"semetey-1-2013:p0727:b004:l023","ordinal":132091,"en":"He gathered them from the hills."},{"id":"semetey-1-2013:p0727:b004:l024","ordinal":132092,"en":"“Father, among your horses,"},{"id":"semetey-1-2013:p0727:b004:l025","ordinal":132093,"en":"Is there a mount to ride in battle?"},{"id":"semetey-1-2013:p0727:b004:l026","ordinal":132094,"en":"Is there anyone who will not fight?"},{"id":"semetey-1-2013:p0727:b004:l027","ordinal":132095,"en":"Is there a mount to ride on a raid?"},{"id":"semetey-1-2013:p0727:b004:l028","ordinal":132096,"en":"Is there anyone who will not clash with us?"}]
