[{"id":"seytek-2012:p0925:b002:l005","ordinal":365569,"en":"For the warrior Seytek,"},{"id":"seytek-2012:p0925:b002:l006","ordinal":365570,"en":"All the vast Kyrgyz host,"},{"id":"seytek-2012:p0925:b002:l007","ordinal":365571,"en":"Stand as my support."},{"id":"seytek-2012:p0925:b002:l008","ordinal":365572,"en":"Fight with ringing battle cries;"},{"id":"seytek-2012:p0925:b002:l009","ordinal":365573,"en":"Plunge into the tumult,"},{"id":"seytek-2012:p0925:b002:l010","ordinal":365574,"en":"Thrusting and dueling with spears."},{"id":"seytek-2012:p0925:b002:l011","ordinal":365575,"en":"When the uproar begins,"},{"id":"seytek-2012:p0925:b002:l012","ordinal":365576,"en":"Sarybai will ride out in single combat,"},{"id":"seytek-2012:p0925:b002:l013","ordinal":365577,"en":"Upon his frenzied racing camel."},{"id":"seytek-2012:p0925:b002:l014","ordinal":365578,"en":"His valor is extraordinary,"},{"id":"seytek-2012:p0925:b002:l015","ordinal":365579,"en":"His worth and venom immense."},{"id":"seytek-2012:p0925:b002:l016","ordinal":365580,"en":"That towering swine—"},{"id":"seytek-2012:p0925:b002:l017","ordinal":365581,"en":"The accursed man's spears"},{"id":"seytek-2012:p0925:b002:l018","ordinal":365582,"en":"Are wielded with skill."},{"id":"seytek-2012:p0925:b002:l019","ordinal":365583,"en":"Though Sarybai's devices are exhausted,"},{"id":"seytek-2012:p0925:b002:l020","ordinal":365584,"en":"He still has strength."},{"id":"seytek-2012:p0925:b002:l021","ordinal":365585,"en":"He found no mountain to strike,"},{"id":"seytek-2012:p0925:b002:l022","ordinal":365586,"en":"No enemy with whom to fight."},{"id":"seytek-2012:p0925:b002:l023","ordinal":365587,"en":"The power that enters great conflict,"},{"id":"seytek-2012:p0925:b002:l024","ordinal":365588,"en":"The power that unleashes great turmoil—"},{"id":"seytek-2012:p0925:b002:l025","ordinal":365589,"en":"When you go to face him"},{"id":"seytek-2012:p0925:b002:l026","ordinal":365590,"en":"And confront him,"},{"id":"seytek-2012:p0925:b002:l027","ordinal":365591,"en":"From the Kutbe side,"},{"id":"seytek-2012:p0925:b002:l028","ordinal":365592,"en":"Surge forward on the gray horse;"},{"id":"seytek-2012:p0925:b002:l029","ordinal":365593,"en":"Let the warriors enter from the flank."},{"id":"seytek-2012:p0925:b002:l030","ordinal":365594,"en":"Drive the young steeds through,"},{"id":"seytek-2012:p0925:b002:l031","ordinal":365595,"en":"And pursue as far as you reach."},{"id":"seytek-2012:p0925:b002:l032","ordinal":365596,"en":"From Alakem's lower side,"},{"id":"seytek-2012:p0925:b002:l033","ordinal":365597,"en":"Pour forth heavy fire."},{"id":"seytek-2012:p0925:b002:l034","ordinal":365598,"en":"Leave Sarybai's myriad host"},{"id":"seytek-2012:p0925:b002:l035","ordinal":365599,"en":"Unable to bind our hands."},{"id":"seytek-2012:p0925:b002:l036","ordinal":365600,"en":"Raise the battle cry and reach them;"},{"id":"seytek-2012:p0925:b002:l037","ordinal":365601,"en":"Charge all together,"},{"id":"seytek-2012:p0925:b002:l038","ordinal":365602,"en":"And wage war as one."},{"id":"seytek-2012:p0925:b002:l039","ordinal":365603,"en":"Such is the way of battle.”"},{"id":"seytek-2012:p0925:b002:l040","ordinal":365604,"en":"So spoke the champion maiden:"},{"id":"seytek-2012:p0925:b003:l001","ordinal":365605,"en":"“Sarybai, who has ridden out alone—"},{"id":"seytek-2012:p0925:b003:l002","ordinal":365606,"en":"I shall see how he rages,"},{"id":"seytek-2012:p0925:b003:l003","ordinal":365607,"en":"Put an end to his panting,"},{"id":"seytek-2012:p0925:b003:l004","ordinal":365608,"en":"Tear his eyes wide open,"},{"id":"seytek-2012:p0925:b003:l005","ordinal":365609,"en":"Crush him if he falls into my hands,"},{"id":"seytek-2012:p0925:b003:l006","ordinal":365610,"en":"Break his ribs,"},{"id":"seytek-2012:p0925:b003:l007","ordinal":365611,"en":"Seize him and spill his blood."},{"id":"seytek-2012:p0925:b003:l008","ordinal":365612,"en":"That marksman who calls himself a champion,"},{"id":"seytek-2012:p0925:b003:l009","ordinal":365613,"en":"Who made the whole world submit—"},{"id":"seytek-2012:p0925:b003:l010","ordinal":365614,"en":"Your lone-ranging warrior—"},{"id":"seytek-2012:p0925:b003:l011","ordinal":365615,"en":"I shall inflict great misery upon him"},{"id":"seytek-2012:p0925:b003:l012","ordinal":365616,"en":"And avenge the ancient grudge.”"},{"id":"seytek-2012:p0925:b003:l013","ordinal":365617,"en":"So saying, Kuyaly"},{"id":"seytek-2012:p0925:b003:l014","ordinal":365618,"en":"Gripped her weapon fiercely;"},{"id":"seytek-2012:p0925:b003:l015","ordinal":365619,"en":"Her bare white teeth"},{"id":"seytek-2012:p0925:b003:l016","ordinal":365620,"en":"Gnashed again and again,"},{"id":"seytek-2012:p0925:b003:l017","ordinal":365621,"en":"And her lion eyes blazed."},{"id":"seytek-2012:p0925:b003:l018","ordinal":365622,"en":"She slung the Adi-makpys bag"},{"id":"seytek-2012:p0925:b003:l019","ordinal":365623,"en":"Across herself and sprang forth."},{"id":"seytek-2012:p0925:b003:l020","ordinal":365624,"en":"Zhelzhetpes beneath her"},{"id":"seytek-2012:p0925:b003:l021","ordinal":365625,"en":"Was covered with a caparison;"},{"id":"seytek-2012:p0925:b003:l022","ordinal":365626,"en":"She tightened the flank girth firmly"},{"id":"seytek-2012:p0925:b003:l023","ordinal":365627,"en":"And drew the crupper tight."},{"id":"seytek-2012:p0925:b003:l024","ordinal":365628,"en":"Her eyes reddened like a wild ram's;"},{"id":"seytek-2012:p0925:b003:l025","ordinal":365629,"en":"The beautiful Kuyaly"},{"id":"seytek-2012:p0925:b003:l026","ordinal":365630,"en":"Shone like the rising moon."},{"id":"seytek-2012:p0925:b003:l027","ordinal":365631,"en":"Her human qualities were unmatched,"},{"id":"seytek-2012:p0925:b003:l028","ordinal":365632,"en":"A peerless wonder surpassing the world."},{"id":"seytek-2012:p0925:b003:l029","ordinal":365633,"en":"Sarybai was the one she would face;"},{"id":"seytek-2012:p0925:b003:l030","ordinal":365634,"en":"Such was her valor."},{"id":"seytek-2012:p0925:b003:l031","ordinal":365635,"en":"Time and time again,"},{"id":"seytek-2012:p0925:b003:l032","ordinal":365636,"en":"They had shattered lances in combat,"},{"id":"seytek-2012:p0925:b003:l033","ordinal":365637,"en":"Torn at each other many times,"},{"id":"seytek-2012:p0925:b003:l034","ordinal":365638,"en":"Until strength left their apple-round heads"},{"id":"seytek-2012:p0925:b003:l035","ordinal":365639,"en":"And blood drained from their fair bodies;"},{"id":"seytek-2012:p0925:b003:l036","ordinal":365640,"en":"Thus had they fought each other."},{"id":"seytek-2012:p0925:b003:l037","ordinal":365641,"en":"They climbed the ridge and faced one another,"},{"id":"seytek-2012:p0925:b003:l038","ordinal":365642,"en":"Calling and dividing their forces."},{"id":"seytek-2012:p0925:b003:l039","ordinal":365643,"en":"Time and time again,"},{"id":"seytek-2012:p0925:b003:l040","ordinal":365644,"en":"They had battled to the death,"},{"id":"seytek-2012:p0926:b002:l001","ordinal":365645,"en":"Against enemies they encountered,"},{"id":"seytek-2012:p0926:b002:l002","ordinal":365646,"en":"Against exceedingly wrathful warriors,"},{"id":"seytek-2012:p0926:b002:l003","ordinal":365647,"en":"Against overbearing champions."},{"id":"seytek-2012:p0926:b002:l004","ordinal":365648,"en":"Into the monster's black eyes,"},{"id":"seytek-2012:p0926:b002:l005","ordinal":365649,"en":"Ready to die if death arrived,"},{"id":"seytek-2012:p0926:b002:l006","ordinal":365650,"en":"If the Almighty desired her life,"},{"id":"seytek-2012:p0926:b002:l007","ordinal":365651,"en":"Ready to surrender her entrusted soul,"},{"id":"seytek-2012:p0926:b002:l008","ordinal":365652,"en":"Ready to unleash a mighty battle—"},{"id":"seytek-2012:p0926:b002:l009","ordinal":365653,"en":"She, offspring of lionhearted heroes,"},{"id":"seytek-2012:p0926:b002:l010","ordinal":365654,"en":"Sought from the fierce one's hands,"},{"id":"seytek-2012:p0926:b002:l011","ordinal":365655,"en":"From death's opposing snare,"},{"id":"seytek-2012:p0926:b002:l012","ordinal":365656,"en":"From that great menace and mighty venom,"},{"id":"seytek-2012:p0926:b002:l013","ordinal":365657,"en":"From Sarybai's hands,"},{"id":"seytek-2012:p0926:b002:l014","ordinal":365658,"en":"To wrest her people free."},{"id":"seytek-2012:p0926:b002:l015","ordinal":365659,"en":"This was the mighty tumult,"},{"id":"seytek-2012:p0926:b002:l016","ordinal":365660,"en":"To be unleashed upon Sarybai:"},{"id":"seytek-2012:p0926:b002:l017","ordinal":365661,"en":"To meet him face-to-face,"},{"id":"seytek-2012:p0926:b002:l018","ordinal":365662,"en":"And clash in crushing combat."},{"id":"seytek-2012:p0926:b002:l019","ordinal":365663,"en":"Her eager eyes burned fiercely;"},{"id":"seytek-2012:p0926:b002:l020","ordinal":365664,"en":"Alas, the champion Kuyaly"},{"id":"seytek-2012:p0926:b002:l021","ordinal":365665,"en":"Watched with both eyes doubled,"},{"id":"seytek-2012:p0926:b002:l022","ordinal":365666,"en":"And wrathfully made ready."},{"id":"seytek-2012:p0926:b002:l023","ordinal":365667,"en":"She put on all her battle gear,"},{"id":"seytek-2012:p0926:b002:l024","ordinal":365668,"en":"Strapped on her naked sword,"},{"id":"seytek-2012:p0926:b002:l025","ordinal":365669,"en":"And leveled a gleaming spear,"},{"id":"seytek-2012:p0926:b002:l026","ordinal":365670,"en":"Ready once more."},{"id":"seytek-2012:p0926:b002:l027","ordinal":365671,"en":"She seized the black-shafted weighted whip"},{"id":"seytek-2012:p0926:b002:l028","ordinal":365672,"en":"And swung it around;"},{"id":"seytek-2012:p0926:b002:l029","ordinal":365673,"en":"Zhelzhetpes, swift as a boat,"},{"id":"seytek-2012:p0926:b002:l030","ordinal":365674,"en":"She gripped tightly with her knees."},{"id":"seytek-2012:p0926:b002:l031","ordinal":365675,"en":"Crying “Allah!” she raised her spear"},{"id":"seytek-2012:p0926:b002:l032","ordinal":365676,"en":"And charged straight at Sarybai;"},{"id":"seytek-2012:p0926:b002:l033","ordinal":365677,"en":"Now she made the struggle fierce."},{"id":"seytek-2012:p0926:b002:l034","ordinal":365678,"en":"The war drum was the signal of battle;"},{"id":"seytek-2012:p0926:b002:l035","ordinal":365679,"en":"Such was that war drum:"},{"id":"seytek-2012:p0926:b002:l036","ordinal":365680,"en":"It was made of elephant hide,"},{"id":"seytek-2012:p0926:b002:l037","ordinal":365681,"en":"And when struck once with a battle-axe,"},{"id":"seytek-2012:p0926:b002:l038","ordinal":365682,"en":"The very heavens seemed to shift,"},{"id":"seytek-2012:p0926:b002:l039","ordinal":365683,"en":"And the breadth of the earth resounded."},{"id":"seytek-2012:p0926:b002:l040","ordinal":365684,"en":"In battle, champions fled before it;"},{"id":"seytek-2012:p0926:b003:l001","ordinal":365685,"en":"It was the army's foremost shield,"},{"id":"seytek-2012:p0926:b003:l002","ordinal":365686,"en":"The herald of Kuyaly's battle."},{"id":"seytek-2012:p0926:b003:l003","ordinal":365687,"en":"When she struck the war drum,"},{"id":"seytek-2012:p0926:b003:l004","ordinal":365688,"en":"Her stalwart champions followed behind."},{"id":"seytek-2012:p0926:b003:l005","ordinal":365689,"en":"After giving this signal,"},{"id":"seytek-2012:p0926:b003:l006","ordinal":365690,"en":"She drove her deep-throated, secret spear"},{"id":"seytek-2012:p0926:b003:l007","ordinal":365691,"en":"Forward with a thunderous blow;"},{"id":"seytek-2012:p0926:b003:l008","ordinal":365692,"en":"Even that failed to bring him down,"},{"id":"seytek-2012:p0926:b003:l009","ordinal":365693,"en":"So she struck again with a roar."},{"id":"seytek-2012:p0926:b003:l010","ordinal":365694,"en":"The earth broke into clouds of dust,"},{"id":"seytek-2012:p0926:b003:l011","ordinal":365695,"en":"And all who saw it were bewildered."},{"id":"seytek-2012:p0926:b003:l012","ordinal":365696,"en":"Every warrior grew excited,"},{"id":"seytek-2012:p0926:b003:l013","ordinal":365697,"en":"Every hero was stirred;"},{"id":"seytek-2012:p0926:b003:l014","ordinal":365698,"en":"The courageous and lionhearted"},{"id":"seytek-2012:p0926:b003:l015","ordinal":365699,"en":"Showed the valor with which they entered holy war."},{"id":"seytek-2012:p0926:b003:l016","ordinal":365700,"en":"It became known to all the people,"},{"id":"seytek-2012:p0926:b003:l017","ordinal":365701,"en":"And the people despaired of life"},{"id":"seytek-2012:p0926:b003:l018","ordinal":365702,"en":"As they crowded around to watch."},{"id":"seytek-2012:p0926:b003:l019","ordinal":365703,"en":"Then Kuyaly"},{"id":"seytek-2012:p0926:b003:l020","ordinal":365704,"en":"Buttoned her armor over her whole body"},{"id":"seytek-2012:p0926:b003:l021","ordinal":365705,"en":"And covered her full face."},{"id":"seytek-2012:p0926:b003:l022","ordinal":365706,"en":"Her lionhearted nature became clear;"},{"id":"seytek-2012:p0926:b003:l023","ordinal":365707,"en":"She donned arrow-proof steel."},{"id":"seytek-2012:p0926:b003:l024","ordinal":365708,"en":"She rejoiced at the word “enemy”;"},{"id":"seytek-2012:p0926:b003:l025","ordinal":365709,"en":"The warrior maiden by name"},{"id":"seytek-2012:p0926:b003:l026","ordinal":365710,"en":"Unleashed a great battle."},{"id":"seytek-2012:p0926:b003:l027","ordinal":365711,"en":"What regret could such a noble soul have?"},{"id":"seytek-2012:p0926:b003:l028","ordinal":365712,"en":"Her valor was renowned,"},{"id":"seytek-2012:p0926:b003:l029","ordinal":365713,"en":"Her wolf-like courage plain to see."},{"id":"seytek-2012:p0926:b003:l030","ordinal":365714,"en":"At the sight of the foe, her eyes blazed;"},{"id":"seytek-2012:p0926:b003:l031","ordinal":365715,"en":"Bloodlust gripped her firmly,"},{"id":"seytek-2012:p0926:b003:l032","ordinal":365716,"en":"And she ground her teeth with a crack."},{"id":"seytek-2012:p0926:b003:l033","ordinal":365717,"en":"Her apple-round neck stretched,"},{"id":"seytek-2012:p0926:b003:l034","ordinal":365718,"en":"Her eyes reddened like a lion's;"},{"id":"seytek-2012:p0926:b003:l035","ordinal":365719,"en":"She girded her slender waist,"},{"id":"seytek-2012:p0926:b003:l036","ordinal":365720,"en":"Cantered forth and left the army."},{"id":"seytek-2012:p0926:b003:l037","ordinal":365721,"en":"Her bearing and majesty,"},{"id":"seytek-2012:p0926:b003:l038","ordinal":365722,"en":"Her proud and fearsome countenance,"},{"id":"seytek-2012:p0926:b003:l039","ordinal":365723,"en":"Made her seem like a ravening beast."},{"id":"seytek-2012:p0926:b003:l040","ordinal":365724,"en":"She took up her weapons, eager for battle."},{"id":"seytek-2012:p0927:b002:l001","ordinal":365725,"en":"Glancing to either side,"},{"id":"seytek-2012:p0927:b002:l002","ordinal":365726,"en":"The fierce warrior of old"},{"id":"seytek-2012:p0927:b002:l003","ordinal":365727,"en":"Licked her lips,"},{"id":"seytek-2012:p0927:b002:l004","ordinal":365728,"en":"Writhing like a dragon,"},{"id":"seytek-2012:p0927:b002:l005","ordinal":365729,"en":"Crouching like a lion,"},{"id":"seytek-2012:p0927:b002:l006","ordinal":365730,"en":"Gathering her wrath and making ready,"},{"id":"seytek-2012:p0927:b002:l007","ordinal":365731,"en":"She prayed to the Creator:"},{"id":"seytek-2012:p0927:b002:l008","ordinal":365732,"en":"“Let me spill the madman’s blood;"},{"id":"seytek-2012:p0927:b002:l009","ordinal":365733,"en":"Do not let me be utterly disgraced,"},{"id":"seytek-2012:p0927:b002:l010","ordinal":365734,"en":"God, grant me honor."},{"id":"seytek-2012:p0927:b002:l011","ordinal":365735,"en":"If at the madman’s hands"},{"id":"seytek-2012:p0927:b002:l012","ordinal":365736,"en":"I fall, I shall die without renown;"},{"id":"seytek-2012:p0927:b002:l013","ordinal":365737,"en":"‘The wretched champion died,’ they will say,"},{"id":"seytek-2012:p0927:b002:l014","ordinal":365738,"en":"And I have no people to bury me with honor."},{"id":"seytek-2012:p0927:b002:l015","ordinal":365739,"en":"My heart is heavy, my breast aflame;"},{"id":"seytek-2012:p0927:b002:l016","ordinal":365740,"en":"No grief is worse than sorrow."},{"id":"seytek-2012:p0927:b002:l017","ordinal":365741,"en":"Almighty God, Creator,"},{"id":"seytek-2012:p0927:b002:l018","ordinal":365742,"en":"There is no recourse but You."},{"id":"seytek-2012:p0927:b002:l019","ordinal":365743,"en":"Sarybay is the one I shall confront;"},{"id":"seytek-2012:p0927:b002:l020","ordinal":365744,"en":"I have begun a savage fight."},{"id":"seytek-2012:p0927:b002:l021","ordinal":365745,"en":"I have no kin to gird my waist,"},{"id":"seytek-2012:p0927:b002:l022","ordinal":365746,"en":"No trusted comrades at my side,"},{"id":"seytek-2012:p0927:b002:l023","ordinal":365747,"en":"No people in whom to place my hope."},{"id":"seytek-2012:p0927:b002:l024","ordinal":365748,"en":"Against this infidel in his full strength"},{"id":"seytek-2012:p0927:b002:l025","ordinal":365749,"en":"I have entered combat—God, aid me!"},{"id":"seytek-2012:p0927:b002:l026","ordinal":365750,"en":"We are but women by name;"},{"id":"seytek-2012:p0927:b002:l027","ordinal":365751,"en":"God, aid this sorrowing one!”"},{"id":"seytek-2012:p0927:b002:l028","ordinal":365752,"en":"So saying, Kuyaly"},{"id":"seytek-2012:p0927:b002:l029","ordinal":365753,"en":"Did not glance around,"},{"id":"seytek-2012:p0927:b002:l030","ordinal":365754,"en":"Never thinking she might die,"},{"id":"seytek-2012:p0927:b002:l031","ordinal":365755,"en":"Did not look from side to side,"},{"id":"seytek-2012:p0927:b002:l032","ordinal":365756,"en":"And spared not her thread-thin life."},{"id":"seytek-2012:p0927:b002:l033","ordinal":365757,"en":"Beneath her was Zhelzhetpes;"},{"id":"seytek-2012:p0927:b002:l034","ordinal":365758,"en":"She drove him right and left,"},{"id":"seytek-2012:p0927:b002:l035","ordinal":365759,"en":"Lashing him on either flank."},{"id":"seytek-2012:p0927:b002:l036","ordinal":365760,"en":"At her cry the charger thundered,"},{"id":"seytek-2012:p0927:b002:l037","ordinal":365761,"en":"And wherever his body struck,"},{"id":"seytek-2012:p0927:b002:l038","ordinal":365762,"en":"The earth burst into ridges."},{"id":"seytek-2012:p0927:b002:l039","ordinal":365763,"en":"The warrior maiden upon him,"},{"id":"seytek-2012:p0927:b002:l040","ordinal":365764,"en":"Whose opponent was Sarybay,"},{"id":"seytek-2012:p0927:b003:l001","ordinal":365765,"en":"Faced a notorious foe such as this."},{"id":"seytek-2012:p0927:b003:l002","ordinal":365766,"en":"Her charger gathered beneath her,"},{"id":"seytek-2012:p0927:b003:l003","ordinal":365767,"en":"While the warrior maiden above"},{"id":"seytek-2012:p0927:b003:l004","ordinal":365768,"en":"Frowned without blinking,"},{"id":"seytek-2012:p0927:b003:l005","ordinal":365769,"en":"Laughed aloud in delight,"},{"id":"seytek-2012:p0927:b003:l006","ordinal":365770,"en":"And rode on blithely, ringing like steel."},{"id":"seytek-2012:p0927:b003:l007","ordinal":365771,"en":"Though they called Sarybay a champion,"},{"id":"seytek-2012:p0927:b003:l008","ordinal":365772,"en":"She did not count him worth her boot-tip."},{"id":"seytek-2012:p0927:b003:l009","ordinal":365773,"en":"Courage and lionheartedness,"},{"id":"seytek-2012:p0927:b003:l010","ordinal":365774,"en":"Cunning and dexterity,"},{"id":"seytek-2012:p0927:b003:l011","ordinal":365775,"en":"A mind well cultivated and eyes keen,"},{"id":"seytek-2012:p0927:b003:l012","ordinal":365776,"en":"And unstinting inspiration—"},{"id":"seytek-2012:p0927:b003:l013","ordinal":365777,"en":"All these the Almighty"},{"id":"seytek-2012:p0927:b003:l014","ordinal":365778,"en":"Had bestowed upon this girl beyond measure."},{"id":"seytek-2012:p0927:b003:l015","ordinal":365779,"en":"She looked neither up nor down,"},{"id":"seytek-2012:p0927:b003:l016","ordinal":365780,"en":"Never thinking she might die."},{"id":"seytek-2012:p0927:b003:l017","ordinal":365781,"en":"The peerless warrior maiden"},{"id":"seytek-2012:p0927:b003:l018","ordinal":365782,"en":"Rejoiced at the thought of death,"},{"id":"seytek-2012:p0927:b003:l019","ordinal":365783,"en":"Showing herself a true hero."},{"id":"seytek-2012:p0927:b003:l020","ordinal":365784,"en":"When she turned her charger’s head,"},{"id":"seytek-2012:p0927:b003:l021","ordinal":365785,"en":"Her well-shafted spear was steel;"},{"id":"seytek-2012:p0927:b003:l022","ordinal":365786,"en":"When she leveled it with a thunderous roar,"},{"id":"seytek-2012:p0927:b003:l023","ordinal":365787,"en":"The one she would fight was Sarybay,"},{"id":"seytek-2012:p0927:b003:l024","ordinal":365788,"en":"The one she would confront was such a foe."},{"id":"seytek-2012:p0927:b003:l025","ordinal":365789,"en":"A fierce one with stony courage,"},{"id":"seytek-2012:p0927:b003:l026","ordinal":365790,"en":"A hero at heart with a warrior’s arm,"},{"id":"seytek-2012:p0927:b003:l027","ordinal":365791,"en":"To that infidel Sarybay"},{"id":"seytek-2012:p0927:b003:l028","ordinal":365792,"en":"She became a crushing menace."},{"id":"seytek-2012:p0927:b003:l029","ordinal":365793,"en":"With no regret even in death,"},{"id":"seytek-2012:p0927:b003:l030","ordinal":365794,"en":"Kuyaly unleashed a mighty battle."},{"id":"seytek-2012:p0927:b003:l031","ordinal":365795,"en":"The renowned warrior maiden,"},{"id":"seytek-2012:p0927:b003:l032","ordinal":365796,"en":"Through countless contests and countless feuds,"},{"id":"seytek-2012:p0927:b003:l033","ordinal":365797,"en":"Had met foes and spread havoc."},{"id":"seytek-2012:p0927:b003:l034","ordinal":365798,"en":"She had won acclaim in many lands"},{"id":"seytek-2012:p0927:b003:l035","ordinal":365799,"en":"And was called the lioness."},{"id":"seytek-2012:p0927:b003:l036","ordinal":365800,"en":"God made straight her path;"},{"id":"seytek-2012:p0927:b003:l037","ordinal":365801,"en":"The spirit of the road and Shayaba"},{"id":"seytek-2012:p0927:b003:l038","ordinal":365802,"en":"Both upheld her together,"},{"id":"seytek-2012:p0927:b003:l039","ordinal":365803,"en":"Guiding her wherever she advanced,"},{"id":"seytek-2012:p0927:b003:l040","ordinal":365804,"en":"And strengthening her whenever foes confronted her."},{"id":"seytek-2012:p0928:b002:l001","ordinal":365805,"en":"Her name was heard throughout the world;"},{"id":"seytek-2012:p0928:b002:l002","ordinal":365806,"en":"Many who had heard with their ears and seen with their eyes"},{"id":"seytek-2012:p0928:b002:l003","ordinal":365807,"en":"Knew well"},{"id":"seytek-2012:p0928:b002:l004","ordinal":365808,"en":"That none like her had ever been."},{"id":"seytek-2012:p0928:b002:l005","ordinal":365809,"en":"She charged straight at Sarybay,"},{"id":"seytek-2012:p0928:b002:l006","ordinal":365810,"en":"Raising her weapon like Zulfiqar,"},{"id":"seytek-2012:p0928:b002:l007","ordinal":365811,"en":"Her spear made ready,"},{"id":"seytek-2012:p0928:b002:l008","ordinal":365812,"en":"Straining and crouching for the charge."},{"id":"seytek-2012:p0928:b002:l009","ordinal":365813,"en":"“I shall reach him before an arrow,” she thought,"},{"id":"seytek-2012:p0928:b002:l010","ordinal":365814,"en":"And rushed forward with leveled spear;"},{"id":"seytek-2012:p0928:b002:l011","ordinal":365815,"en":"“I shall smash him utterly.”"},{"id":"seytek-2012:p0928:b002:l012","ordinal":365816,"en":"No sooner conceived than done:"},{"id":"seytek-2012:p0928:b002:l013","ordinal":365817,"en":"Power boiled and strength swelled,"},{"id":"seytek-2012:p0928:b002:l014","ordinal":365818,"en":"And the formidable champion transformed,"},{"id":"seytek-2012:p0928:b002:l015","ordinal":365819,"en":"Shouting at the madman"},{"id":"seytek-2012:p0928:b002:l016","ordinal":365820,"en":"As she unleashed her terrible wrath."},{"id":"seytek-2012:p0928:b002:l017","ordinal":365821,"en":"The life given by Almighty God"},{"id":"seytek-2012:p0928:b002:l018","ordinal":365822,"en":"She valued not even as a hair, the wretched girl,"},{"id":"seytek-2012:p0928:b002:l019","ordinal":365823,"en":"But cast it away as though tied to a thread."},{"id":"seytek-2012:p0928:b002:l020","ordinal":365824,"en":"When she turned her charger’s head"}]
