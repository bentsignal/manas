{"id": "sayakbay-ms-current146:pdf201:l025", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 201, "folio": 584, "line_in_page": 25, "raw": "Өткөнүң өлө чын деп,", "text": "Өткөнүң өлө чын деп,", "en": "Saying your passing was truly death,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
