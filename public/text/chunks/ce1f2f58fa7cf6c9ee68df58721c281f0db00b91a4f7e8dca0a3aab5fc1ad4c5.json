[{"id":"semetey-2-2013:p0032:b005:l027","ordinal":187649,"en":"Spurring him on both flanks."},{"id":"semetey-2-2013:p0032:b005:l028","ordinal":187650,"en":"“What has happened to this dog?” he thought;"},{"id":"semetey-2-2013:p0032:b005:l029","ordinal":187651,"en":"Afraid for his life and frantic,"},{"id":"semetey-2-2013:p0032:b005:l030","ordinal":187652,"en":"Karagul hurried desperately"},{"id":"semetey-2-2013:p0032:b005:l031","ordinal":187653,"en":"And spoke to Algara:"},{"id":"semetey-2-2013:p0032:b005:l032","ordinal":187654,"en":"“Algara of the accursed khan,"},{"id":"semetey-2-2013:p0032:b005:l033","ordinal":187655,"en":"You were the khan’s own horse."},{"id":"semetey-2-2013:p0032:b005:l034","ordinal":187656,"en":"Your condition is not that of a worn-out old beast;"},{"id":"semetey-2-2013:p0032:b005:l035","ordinal":187657,"en":"My fly-sized life is under strain,"},{"id":"semetey-2-2013:p0032:b005:l036","ordinal":187658,"en":"And this is no time for you to cease running."},{"id":"semetey-2-2013:p0032:b005:l037","ordinal":187659,"en":"Algara, whom I mounted in trust,"},{"id":"semetey-2-2013:p0032:b005:l038","ordinal":187660,"en":"You have brought moonless night"},{"id":"semetey-2-2013:p0032:b005:l039","ordinal":187661,"en":"Down upon Karagul’s head—"},{"id":"semetey-2-2013:p0033:b003:l001","ordinal":187662,"en":"You have brought the day of death upon me."},{"id":"semetey-2-2013:p0033:b003:l002","ordinal":187663,"en":"At the champion son of the Bloodthirsty One,"},{"id":"semetey-2-2013:p0033:b003:l003","ordinal":187664,"en":"At the misbegotten foe who fixed his malice on me,"},{"id":"semetey-2-2013:p0033:b003:l004","ordinal":187665,"en":"It seems I will suffer humiliation while alive."},{"id":"semetey-2-2013:p0033:b003:l005","ordinal":187666,"en":"If by chance I fall into his hands,"},{"id":"semetey-2-2013:p0033:b003:l006","ordinal":187667,"en":"Before my allotted day has ended,"},{"id":"semetey-2-2013:p0033:b003:l007","ordinal":187668,"en":"It seems I will die upon the open plain."},{"id":"semetey-2-2013:p0033:b003:l008","ordinal":187669,"en":"Could such misery, such a ruinous affair—"},{"id":"semetey-2-2013:p0033:b003:l009","ordinal":187670,"en":"Algara running like a wild beast—"},{"id":"semetey-2-2013:p0033:b003:l010","ordinal":187671,"en":"Ever have existed even in a dream?"},{"id":"semetey-2-2013:p0033:b003:l011","ordinal":187672,"en":"I wear a bright red and green coat;"},{"id":"semetey-2-2013:p0033:b003:l012","ordinal":187673,"en":"Its trim will not tear when I pull it."},{"id":"semetey-2-2013:p0033:b003:l013","ordinal":187674,"en":"I was deceived by a strange road;"},{"id":"semetey-2-2013:p0033:b003:l014","ordinal":187675,"en":"If I fall into his hands, that Burut"},{"id":"semetey-2-2013:p0033:b003:l015","ordinal":187676,"en":"Does not look like one who will turn aside."},{"id":"semetey-2-2013:p0033:b003:l016","ordinal":187677,"en":"It seems he may catch me;"},{"id":"semetey-2-2013:p0033:b003:l017","ordinal":187678,"en":"That calamity-bringing Burut"},{"id":"semetey-2-2013:p0033:b003:l018","ordinal":187679,"en":"Will drag me along the road"},{"id":"semetey-2-2013:p0033:b003:l019","ordinal":187680,"en":"And make me fit for the Danggits, it seems.”"},{"id":"semetey-2-2013:p0033:b003:l020","ordinal":187681,"en":"Thus Karagul"},{"id":"semetey-2-2013:p0033:b003:l021","ordinal":187682,"en":"Grieved in this way."},{"id":"semetey-2-2013:p0033:b003:l022","ordinal":187683,"en":"How could Semetey hold back?"},{"id":"semetey-2-2013:p0033:b003:l023","ordinal":187684,"en":"He pursued Karagul bare-backed."},{"id":"semetey-2-2013:p0033:b003:l024","ordinal":187685,"en":"A hero born surpassing"},{"id":"semetey-2-2013:p0033:b003:l025","ordinal":187686,"en":"His father Manas, the gray wolf,"},{"id":"semetey-2-2013:p0033:b003:l026","ordinal":187687,"en":"He bore down upon"},{"id":"semetey-2-2013:p0033:b003:l027","ordinal":187688,"en":"The great plain, broad as the moon."},{"id":"semetey-2-2013:p0033:b003:l028","ordinal":187689,"en":"If you ask of that plain,"},{"id":"semetey-2-2013:p0033:b003:l029","ordinal":187690,"en":"Haze descends and makes corners upon it,"},{"id":"semetey-2-2013:p0033:b003:l030","ordinal":187691,"en":"And it ends in a dim and shadowed point."},{"id":"semetey-2-2013:p0033:b003:l031","ordinal":187692,"en":"When one looks, nothing catches the eye;"},{"id":"semetey-2-2013:p0033:b003:l032","ordinal":187693,"en":"In this accursed world,"},{"id":"semetey-2-2013:p0033:b003:l033","ordinal":187694,"en":"One cannot tell where anything lies."},{"id":"semetey-2-2013:p0033:b003:l034","ordinal":187695,"en":"The sight arrests the heart;"},{"id":"semetey-2-2013:p0033:b003:l035","ordinal":187696,"en":"Jutting up in stark ridges,"},{"id":"semetey-2-2013:p0033:b003:l036","ordinal":187697,"en":"The mountain’s summit cannot be seen."},{"id":"semetey-2-2013:p0033:b003:l037","ordinal":187698,"en":"Semetey, who had been deceived,"},{"id":"semetey-2-2013:p0033:b003:l038","ordinal":187699,"en":"Pursued the infidel son of Katal"},{"id":"semetey-2-2013:p0033:b003:l039","ordinal":187700,"en":"Bare-backed and without tiring."},{"id":"semetey-2-2013:p0033:b005:l001","ordinal":187701,"en":"A mighty plain beyond the reach of sight,"},{"id":"semetey-2-2013:p0033:b005:l002","ordinal":187702,"en":"No small plain, but a vast one."},{"id":"semetey-2-2013:p0033:b005:l003","ordinal":187703,"en":"Across the face of that plain"},{"id":"semetey-2-2013:p0033:b005:l004","ordinal":187704,"en":"There was no hillock as large as an ankle-bone,"},{"id":"semetey-2-2013:p0033:b005:l005","ordinal":187705,"en":"No sunken hollow or ravine."},{"id":"semetey-2-2013:p0033:b005:l006","ordinal":187706,"en":"No ordinary creature could endure it;"},{"id":"semetey-2-2013:p0033:b005:l007","ordinal":187707,"en":"Unless it were a swift courser"},{"id":"semetey-2-2013:p0033:b005:l008","ordinal":187708,"en":"That would not tire when ridden for six months,"},{"id":"semetey-2-2013:p0033:b005:l009","ordinal":187709,"en":"No other creature"},{"id":"semetey-2-2013:p0033:b005:l010","ordinal":187710,"en":"Could withstand the journey."},{"id":"semetey-2-2013:p0033:b005:l011","ordinal":187711,"en":"None who encountered it remained alive—"},{"id":"semetey-2-2013:p0033:b005:l012","ordinal":187712,"en":"Kyzyl-Kum, beyond the reach of sight."},{"id":"semetey-2-2013:p0033:b005:l013","ordinal":187713,"en":"This is the burning plain:"},{"id":"semetey-2-2013:p0033:b005:l014","ordinal":187714,"en":"If a creature traveled there, its ears burned;"},{"id":"semetey-2-2013:p0033:b005:l015","ordinal":187715,"en":"If a wild ass stepped there, its hooves burned."},{"id":"semetey-2-2013:p0033:b005:l016","ordinal":187716,"en":"It was a scorched desert,"},{"id":"semetey-2-2013:p0033:b005:l017","ordinal":187717,"en":"With no grass to pinch off and eat,"},{"id":"semetey-2-2013:p0033:b005:l018","ordinal":187718,"en":"No water to sip even a drop."},{"id":"semetey-2-2013:p0033:b005:l019","ordinal":187719,"en":"A goose in flight grew exhausted;"},{"id":"semetey-2-2013:p0033:b005:l020","ordinal":187720,"en":"When a black vulture flew,"},{"id":"semetey-2-2013:p0033:b005:l021","ordinal":187721,"en":"Its wings drooped"},{"id":"semetey-2-2013:p0033:b005:l022","ordinal":187722,"en":"And it tired midway across."},{"id":"semetey-2-2013:p0033:b005:l023","ordinal":187723,"en":"It was an exceedingly harsh desert;"},{"id":"semetey-2-2013:p0033:b005:l024","ordinal":187724,"en":"The many Chinese in Beijing,"},{"id":"semetey-2-2013:p0033:b005:l025","ordinal":187725,"en":"From that day to this,"},{"id":"semetey-2-2013:p0033:b005:l026","ordinal":187726,"en":"Called it Dyngsha-Talaa."},{"id":"semetey-2-2013:p0033:b005:l027","ordinal":187727,"en":"When they reached that desert,"},{"id":"semetey-2-2013:p0033:b005:l028","ordinal":187728,"en":"Karagul, son of Katal,"},{"id":"semetey-2-2013:p0033:b005:l029","ordinal":187729,"en":"Whipped Algara"},{"id":"semetey-2-2013:p0033:b005:l030","ordinal":187730,"en":"And fled onward in haste."},{"id":"semetey-2-2013:p0033:b005:l031","ordinal":187731,"en":"Semetey’s horse Buurul"},{"id":"semetey-2-2013:p0033:b005:l032","ordinal":187732,"en":"Redoubled his surging stride"},{"id":"semetey-2-2013:p0033:b005:l033","ordinal":187733,"en":"And swept onward."},{"id":"semetey-2-2013:p0033:b005:l034","ordinal":187734,"en":"When Kongurbai’s Algara"},{"id":"semetey-2-2013:p0033:b005:l035","ordinal":187735,"en":"Reached descending ground,"},{"id":"semetey-2-2013:p0033:b005:l036","ordinal":187736,"en":"He ran far ahead, shimmering like a mirage;"},{"id":"semetey-2-2013:p0033:b005:l037","ordinal":187737,"en":"When Semetey’s horse Buurul"},{"id":"semetey-2-2013:p0033:b005:l038","ordinal":187738,"en":"Started up the slope,"},{"id":"semetey-2-2013:p0033:b005:l039","ordinal":187739,"en":"He was about to reach his heels."},{"id":"semetey-2-2013:p0034:b003:l001","ordinal":187740,"en":"After they had crossed that plain,"},{"id":"semetey-2-2013:p0034:b003:l002","ordinal":187741,"en":"The tale and tumult grew wondrous."},{"id":"semetey-2-2013:p0034:b003:l003","ordinal":187742,"en":"When they journeyed farther,"},{"id":"semetey-2-2013:p0034:b003:l004","ordinal":187743,"en":"They neared the host lying at Dyngsha"},{"id":"semetey-2-2013:p0034:b003:l005","ordinal":187744,"en":"Of Kichi-Beijing, in the place"},{"id":"semetey-2-2013:p0034:b003:l006","ordinal":187745,"en":"Called Chok-Tabylgy—"},{"id":"semetey-2-2013:p0034:b003:l007","ordinal":187746,"en":"The force belonging to the infidel son of Kaldai,"},{"id":"semetey-2-2013:p0034:b003:l008","ordinal":187747,"en":"To hero Khan Kongurbai."},{"id":"semetey-2-2013:p0034:b003:l009","ordinal":187748,"en":"They had drawn close to it."},{"id":"semetey-2-2013:p0034:b003:l010","ordinal":187749,"en":"It was a tower built for keeping watch;"},{"id":"semetey-2-2013:p0034:b003:l011","ordinal":187750,"en":"He was the mighty khan of the Kechil."},{"id":"semetey-2-2013:p0034:b003:l012","ordinal":187751,"en":"If a man died and left his ox behind,"},{"id":"semetey-2-2013:p0034:b003:l013","ordinal":187752,"en":"Kongurbai divided"},{"id":"semetey-2-2013:p0034:b003:l014","ordinal":187753,"en":"The dead man’s property equally."},{"id":"semetey-2-2013:p0034:b003:l015","ordinal":187754,"en":"They raised their seter goat,"},{"id":"semetey-2-2013:p0034:b003:l016","ordinal":187755,"en":"And the mount they rode was a sacred horse;"},{"id":"semetey-2-2013:p0034:b003:l017","ordinal":187756,"en":"Such was the rite of the Kechil:"},{"id":"semetey-2-2013:p0034:b003:l018","ordinal":187757,"en":"All of them went without trousers"},{"id":"semetey-2-2013:p0034:b003:l019","ordinal":187758,"en":"And slept with women."},{"id":"semetey-2-2013:p0034:b003:l020","ordinal":187759,"en":"Upon the hazy ridge of Bozorgo—"},{"id":"semetey-2-2013:p0034:b003:l021","ordinal":187760,"en":"Have you heard?—"},{"id":"semetey-2-2013:p0034:b003:l022","ordinal":187761,"en":"Khan Kongurbai was in the fortress."},{"id":"semetey-2-2013:p0034:b003:l023","ordinal":187762,"en":"Such was the nature of Kongurbai:"},{"id":"semetey-2-2013:p0034:b003:l024","ordinal":187763,"en":"He had eighty-four armored men,"},{"id":"semetey-2-2013:p0034:b003:l025","ordinal":187764,"en":"And whatever side they struck became red fire."},{"id":"semetey-2-2013:p0034:b003:l026","ordinal":187765,"en":"There was a gate with doors of steel;"},{"id":"semetey-2-2013:p0034:b003:l027","ordinal":187766,"en":"On this side of the gate"},{"id":"semetey-2-2013:p0034:b003:l028","ordinal":187767,"en":"Were wonders beyond measure:"},{"id":"semetey-2-2013:p0034:b003:l029","ordinal":187768,"en":"A tigress had borne fifteen cubs,"},{"id":"semetey-2-2013:p0034:b003:l030","ordinal":187769,"en":"And no person approached"},{"id":"semetey-2-2013:p0034:b003:l031","ordinal":187770,"en":"The fearsome Kalcha."},{"id":"semetey-2-2013:p0034:b003:l032","ordinal":187771,"en":"There were sixty dragons;"},{"id":"semetey-2-2013:p0034:b003:l033","ordinal":187772,"en":"And on the farther side of them"},{"id":"semetey-2-2013:p0034:b003:l034","ordinal":187773,"en":"Was a sword-snouted bili."},{"id":"semetey-2-2013:p0034:b003:l035","ordinal":187774,"en":"Three taibaz had been raised there;"},{"id":"semetey-2-2013:p0034:b003:l036","ordinal":187775,"en":"Within a single taibaz"},{"id":"semetey-2-2013:p0034:b003:l037","ordinal":187776,"en":"Was the strength of ninety tigers."},{"id":"semetey-2-2013:p0034:b003:l038","ordinal":187777,"en":"Such was the renown"},{"id":"semetey-2-2013:p0034:b003:l039","ordinal":187778,"en":"Of valiant Khan Kongurbai."},{"id":"semetey-2-2013:p0034:b004:l001","ordinal":187779,"en":"Yesterday, when Manas took Beijing,"},{"id":"semetey-2-2013:p0034:b004:l002","ordinal":187780,"en":"When the warriors threw themselves into the fight"},{"id":"semetey-2-2013:p0034:b004:l003","ordinal":187781,"en":"And wreaked terrible slaughter,"},{"id":"semetey-2-2013:p0034:b004:l004","ordinal":187782,"en":"Kongurbai saw the worth"},{"id":"semetey-2-2013:p0034:b004:l005","ordinal":187783,"en":"Of beasts of prey as sentries"},{"id":"semetey-2-2013:p0034:b004:l006","ordinal":187784,"en":"And had prepared them, that mighty man."},{"id":"semetey-2-2013:p0034:b004:l007","ordinal":187785,"en":"Drawing near to the gate,"},{"id":"semetey-2-2013:p0034:b004:l008","ordinal":187786,"en":"When they came within one arrow-shot,"},{"id":"semetey-2-2013:p0034:b004:l009","ordinal":187787,"en":"They looked upon the gate:"},{"id":"semetey-2-2013:p0034:b004:l010","ordinal":187788,"en":"No person could approach it;"},{"id":"semetey-2-2013:p0034:b004:l011","ordinal":187789,"en":"Whoever approached that fearsome Kalcha"},{"id":"semetey-2-2013:p0034:b004:l012","ordinal":187790,"en":"Would not remain alive."},{"id":"semetey-2-2013:p0034:b004:l013","ordinal":187791,"en":"No person could come near;"},{"id":"semetey-2-2013:p0034:b004:l014","ordinal":187792,"en":"Whoever encountered it would not remain alive."},{"id":"semetey-2-2013:p0034:b004:l015","ordinal":187793,"en":"Looking below it,"},{"id":"semetey-2-2013:p0034:b004:l016","ordinal":187794,"en":"There was a pit dug"},{"id":"semetey-2-2013:p0034:b004:l017","ordinal":187795,"en":"So that a person falling in would die."},{"id":"semetey-2-2013:p0034:b004:l018","ordinal":187796,"en":"Going farther on,"},{"id":"semetey-2-2013:p0034:b004:l019","ordinal":187797,"en":"There was a prepared snare"},{"id":"semetey-2-2013:p0034:b004:l020","ordinal":187798,"en":"That would seize a man."},{"id":"semetey-2-2013:p0034:b004:l021","ordinal":187799,"en":"Passing beyond that,"},{"id":"semetey-2-2013:p0034:b004:l022","ordinal":187800,"en":"There was misery set boiling for him."},{"id":"semetey-2-2013:p0034:b004:l023","ordinal":187801,"en":"Beijing is no easy land;"},{"id":"semetey-2-2013:p0034:b004:l024","ordinal":187802,"en":"Kongurbai is no easy hero."},{"id":"semetey-2-2013:p0034:b004:l025","ordinal":187803,"en":"When Kongurbai received warning,"},{"id":"semetey-2-2013:p0034:b004:l026","ordinal":187804,"en":"He quelled a chaotic assault"},{"id":"semetey-2-2013:p0034:b004:l027","ordinal":187805,"en":"Before anyone could even order, “Strike!”"},{"id":"semetey-2-2013:p0034:b004:l028","ordinal":187806,"en":"At the mouth of that gate,"},{"id":"semetey-2-2013:p0034:b004:l029","ordinal":187807,"en":"A club as large as a house was mounted."},{"id":"semetey-2-2013:p0034:b004:l030","ordinal":187808,"en":"If truth be told, we cannot know the dawn;"},{"id":"semetey-2-2013:p0034:b004:l031","ordinal":187809,"en":"His champions of many kinds"},{"id":"semetey-2-2013:p0034:b004:l032","ordinal":187810,"en":"Stood ready"},{"id":"semetey-2-2013:p0034:b004:l033","ordinal":187811,"en":"At the mouth of that gate."},{"id":"semetey-2-2013:p0034:b004:l034","ordinal":187812,"en":"As they were about to cross the threshold,"},{"id":"semetey-2-2013:p0034:b004:l035","ordinal":187813,"en":"Your champion, son of the gray wolf,"},{"id":"semetey-2-2013:p0034:b004:l036","ordinal":187814,"en":"Seized Kongurbai’s Algara"},{"id":"semetey-2-2013:p0034:b004:l037","ordinal":187815,"en":"By his slender tail."},{"id":"semetey-2-2013:p0034:b004:l038","ordinal":187816,"en":"Praying, “May God deliver the slave,”"},{"id":"semetey-2-2013:p0034:b004:l039","ordinal":187817,"en":"He gripped the tail roughly,"},{"id":"semetey-2-2013:p0035:b003:l001","ordinal":187818,"en":"He nailed it to the throne."},{"id":"semetey-2-2013:p0035:b003:l002","ordinal":187819,"en":"Screaming angrily"},{"id":"semetey-2-2013:p0035:b003:l003","ordinal":187820,"en":"The killer Manastap chanted slogans"},{"id":"semetey-2-2013:p0035:b003:l004","ordinal":187821,"en":"And the bloodthirsty Semetey,"},{"id":"semetey-2-2013:p0035:b003:l005","ordinal":187822,"en":"He began to rage fiercely,"},{"id":"semetey-2-2013:p0035:b003:l006","ordinal":187823,"en":"Algara and that slave,"},{"id":"semetey-2-2013:p0035:b003:l007","ordinal":187824,"en":"At first, just"},{"id":"semetey-2-2013:p0035:b003:l008","ordinal":187825,"en":"He stopped dragging."},{"id":"semetey-2-2013:p0035:b003:l009","ordinal":187826,"en":"On the plain he shot,"},{"id":"semetey-2-2013:p0035:b003:l010","ordinal":187827,"en":"Teach all four"},{"id":"semetey-2-2013:p0035:b003:l011","ordinal":187828,"en":"Sometimes just"},{"id":"semetey-2-2013:p0035:b003:l012","ordinal":187829,"en":"Blueberry* drag."},{"id":"semetey-2-2013:p0035:b003:l013","ordinal":187830,"en":"Karagul comes shouting,"},{"id":"semetey-2-2013:p0035:b003:l014","ordinal":187831,"en":"The necklace is made of coral* stone"},{"id":"semetey-2-2013:p0035:b003:l015","ordinal":187832,"en":"Summoning Khan Lung-tung*,"},{"id":"semetey-2-2013:p0035:b003:l016","ordinal":187833,"en":"Screaming that I'm dead"},{"id":"semetey-2-2013:p0035:b003:l017","ordinal":187834,"en":"If I want to kill a slave,"},{"id":"semetey-2-2013:p0035:b003:l018","ordinal":187835,"en":"Semetei wants to take care."},{"id":"semetey-2-2013:p0035:b003:l019","ordinal":187836,"en":"Underneath the wheat"},{"id":"semetey-2-2013:p0035:b003:l020","ordinal":187837,"en":"Buurul begged the horse:"},{"id":"semetey-2-2013:p0035:b003:l021","ordinal":187838,"en":"\"Now let's turn around, my brother"},{"id":"semetey-2-2013:p0035:b003:l022","ordinal":187839,"en":"Buurul is an animal, too"},{"id":"semetey-2-2013:p0035:b003:l023","ordinal":187840,"en":"Black cousin!"},{"id":"semetey-2-2013:p0035:b003:l024","ordinal":187841,"en":"Rabies touched my hand,"},{"id":"semetey-2-2013:p0035:b003:l025","ordinal":187842,"en":"Put your head down"},{"id":"semetey-2-2013:p0035:b003:l026","ordinal":187843,"en":"Come on, my brother,"},{"id":"semetey-2-2013:p0035:b003:l027","ordinal":187844,"en":"Try to get your strength in a different way!"},{"id":"semetey-2-2013:p0035:b003:l028","ordinal":187845,"en":"The abuse of this dog,"},{"id":"semetey-2-2013:p0035:b003:l029","ordinal":187846,"en":"Is it from my bones?"},{"id":"semetey-2-2013:p0035:b003:l030","ordinal":187847,"en":"The force of the water."},{"id":"semetey-2-2013:p0035:b003:l031","ordinal":187848,"en":"Go around and ride,"},{"id":"semetey-2-2013:p0035:b003:l032","ordinal":187849,"en":"I begged you to be an animal"},{"id":"semetey-2-2013:p0035:b003:l033","ordinal":187850,"en":"Karagul touched my hand,"},{"id":"semetey-2-2013:p0035:b003:l034","ordinal":187851,"en":"Without anyone knowing,"},{"id":"semetey-2-2013:p0035:b003:l035","ordinal":187852,"en":"Do not touch one person,"},{"id":"semetey-2-2013:p0035:b003:l036","ordinal":187853,"en":"I'll take you to the desert"},{"id":"semetey-2-2013:p0035:b003:l037","ordinal":187854,"en":"The man was blindly insulted"},{"id":"semetey-2-2013:p0035:b003:l038","ordinal":187855,"en":"Let me enslave you,"},{"id":"semetey-2-2013:p0035:b003:l039","ordinal":187856,"en":"My revenge in the hood"},{"id":"semetey-2-2013:p0035:b005:l001","ordinal":187857,"en":"I will take it from Karagul"},{"id":"semetey-2-2013:p0035:b005:l002","ordinal":187858,"en":"I'll do it in a private place"},{"id":"semetey-2-2013:p0035:b005:l003","ordinal":187859,"en":"Black blood inside"},{"id":"semetey-2-2013:p0035:b005:l004","ordinal":187860,"en":"Let me swa