[{"id":"semetey-1-2013:p0925:b004:l026","ordinal":147713,"en":"Was said to be a stately hero."},{"id":"semetey-1-2013:p0925:b004:l027","ordinal":147714,"en":"When Chynkozho grew wrathful,"},{"id":"semetey-1-2013:p0925:b004:l028","ordinal":147715,"en":"Wings sprang out beneath him."},{"id":"semetey-1-2013:p0925:b004:l029","ordinal":147716,"en":"Not China alone, but the whole world"},{"id":"semetey-1-2013:p0925:b004:l030","ordinal":147717,"en":"He was wont to shatter to powder."},{"id":"semetey-1-2013:p0925:b004:l031","ordinal":147718,"en":"Chynkozho crackled"},{"id":"semetey-1-2013:p0925:b004:l032","ordinal":147719,"en":"Like red-hot, tempered iron."},{"id":"semetey-1-2013:p0925:b004:l033","ordinal":147720,"en":"He was no enemy to grapple with lightly,"},{"id":"semetey-1-2013:p0925:b004:l034","ordinal":147721,"en":"His bulk half a mountain."},{"id":"semetey-1-2013:p0925:b004:l035","ordinal":147722,"en":"His eyes were like the beds of lakes."},{"id":"semetey-1-2013:p0925:b004:l036","ordinal":147723,"en":"A mountain as black as coal -"},{"id":"semetey-1-2013:p0925:b004:l037","ordinal":147724,"en":"As though he would suck the life from anyone he saw."},{"id":"semetey-1-2013:p0925:b004:l038","ordinal":147725,"en":"The strongman he had set on watch"},{"id":"semetey-1-2013:p0925:b004:l039","ordinal":147726,"en":"Ran to take their horses,"},{"id":"semetey-1-2013:p0926:b003:l001","ordinal":147727,"en":"One man flew like an arrow"},{"id":"semetey-1-2013:p0926:b003:l002","ordinal":147728,"en":"And pulled the door open."},{"id":"semetey-1-2013:p0926:b003:l003","ordinal":147729,"en":"Aged Lord Bakai,"},{"id":"semetey-1-2013:p0926:b003:l004","ordinal":147730,"en":"The saint who had seen so much,"},{"id":"semetey-1-2013:p0926:b003:l005","ordinal":147731,"en":"Led the way inside,"},{"id":"semetey-1-2013:p0926:b003:l006","ordinal":147732,"en":"And to tigerlike Kozho"},{"id":"semetey-1-2013:p0926:b003:l007","ordinal":147733,"en":"Offered his greeting."},{"id":"semetey-1-2013:p0926:b003:l008","ordinal":147734,"en":"Your uncle Bakai, bringer of good fortune,"},{"id":"semetey-1-2013:p0926:b003:l009","ordinal":147735,"en":"Spoke these words:"},{"id":"semetey-1-2013:p0926:b003:l010","ordinal":147736,"en":"“We were neighboring hills upon one slope."},{"id":"semetey-1-2013:p0926:b003:l011","ordinal":147737,"en":"Are you well, Kozho, my foal,"},{"id":"semetey-1-2013:p0926:b003:l012","ordinal":147738,"en":"Of one woven thread, of one nest with me?"},{"id":"semetey-1-2013:p0926:b003:l013","ordinal":147739,"en":"Offering six swift horses,"},{"id":"semetey-1-2013:p0926:b003:l014","ordinal":147740,"en":"Offering a letter the size of a palm,"},{"id":"semetey-1-2013:p0926:b003:l015","ordinal":147741,"en":"Offering my applelike golden head before you,"},{"id":"semetey-1-2013:p0926:b003:l016","ordinal":147742,"en":"Traveling without sparing the horses,"},{"id":"semetey-1-2013:p0926:b003:l017","ordinal":147743,"en":"Traveling far without stopping on the way,"},{"id":"semetey-1-2013:p0926:b003:l018","ordinal":147744,"en":"I have come before you, as you see."},{"id":"semetey-1-2013:p0926:b003:l019","ordinal":147745,"en":"‘This is my khan-uncle Bakai,’ say,"},{"id":"semetey-1-2013:p0926:b003:l020","ordinal":147746,"en":"And take heed of me, Bakai!"},{"id":"semetey-1-2013:p0926:b003:l021","ordinal":147747,"en":"My sorrow has long been swelling:"},{"id":"semetey-1-2013:p0926:b003:l022","ordinal":147748,"en":"You moved to Kebez-Too, to the Oigut,"},{"id":"semetey-1-2013:p0926:b003:l023","ordinal":147749,"en":"And went away as a hostage."},{"id":"semetey-1-2013:p0926:b003:l024","ordinal":147750,"en":"When Lord Sultan Manas,"},{"id":"semetey-1-2013:p0926:b003:l025","ordinal":147751,"en":"His thin mustache smoothed,"},{"id":"semetey-1-2013:p0926:b003:l026","ordinal":147752,"en":"Departed toward Judgment Day,"},{"id":"semetey-1-2013:p0926:b003:l027","ordinal":147753,"en":"You did not cast a handful of earth."},{"id":"semetey-1-2013:p0926:b003:l028","ordinal":147754,"en":"You were kin to us at your roots,"},{"id":"semetey-1-2013:p0926:b003:l029","ordinal":147755,"en":"Yet you rendered no true service."},{"id":"semetey-1-2013:p0926:b003:l030","ordinal":147756,"en":"When your leopard died,"},{"id":"semetey-1-2013:p0926:b003:l031","ordinal":147757,"en":"When the people gathered and buried him,"},{"id":"semetey-1-2013:p0926:b003:l032","ordinal":147758,"en":"You did not stand crying, ‘My uncle!’"},{"id":"semetey-1-2013:p0926:b003:l033","ordinal":147759,"en":"My champion Kozho, hear my words."},{"id":"semetey-1-2013:p0926:b003:l034","ordinal":147760,"en":"Our path was touched by Khizr;"},{"id":"semetey-1-2013:p0926:b003:l035","ordinal":147761,"en":"Our army numbered forty-two myriads,"},{"id":"semetey-1-2013:p0926:b003:l036","ordinal":147762,"en":"With twelve pairs of khans."},{"id":"semetey-1-2013:p0926:b003:l037","ordinal":147763,"en":"The guide to that great army"},{"id":"semetey-1-2013:p0926:b003:l038","ordinal":147764,"en":"Was the leopard Almam."},{"id":"semetey-1-2013:p0926:b003:l039","ordinal":147765,"en":"When we scattered the unbelievers' livestock,"},{"id":"semetey-1-2013:p0926:b004:l001","ordinal":147766,"en":"When he opened the way of Islam,"},{"id":"semetey-1-2013:p0926:b004:l002","ordinal":147767,"en":"Into dark and brooding Great Beijing,"},{"id":"semetey-1-2013:p0926:b004:l003","ordinal":147768,"en":"When we went straight in with level spears,"},{"id":"semetey-1-2013:p0926:b004:l004","ordinal":147769,"en":"Against the grim-looking dark Chinese"},{"id":"semetey-1-2013:p0926:b004:l005","ordinal":147770,"en":"When we firmly waged a holy war,"},{"id":"semetey-1-2013:p0926:b004:l006","ordinal":147771,"en":"Against the unbelievers of the dark faith,"},{"id":"semetey-1-2013:p0926:b004:l007","ordinal":147772,"en":"When the hero Khan Kongurbai's"},{"id":"semetey-1-2013:p0926:b004:l008","ordinal":147773,"en":"Khanate we wrested away,"},{"id":"semetey-1-2013:p0926:b004:l009","ordinal":147774,"en":"Noble brides and beautiful girls"},{"id":"semetey-1-2013:p0926:b004:l010","ordinal":147775,"en":"We left unable to gather all as spoils;"},{"id":"semetey-1-2013:p0926:b004:l011","ordinal":147776,"en":"Gold and silver"},{"id":"semetey-1-2013:p0926:b004:l012","ordinal":147777,"en":"We left unable to load it all."},{"id":"semetey-1-2013:p0926:b004:l013","ordinal":147778,"en":"Against the teeming Chinese,"},{"id":"semetey-1-2013:p0926:b004:l014","ordinal":147779,"en":"When we charged and brought slaughter,"},{"id":"semetey-1-2013:p0926:b004:l015","ordinal":147780,"en":"You vanished without showing your face!"},{"id":"semetey-1-2013:p0926:b004:l016","ordinal":147781,"en":"On the journey back,"},{"id":"semetey-1-2013:p0926:b004:l017","ordinal":147782,"en":"The khans Muzburchak and Kokcho died;"},{"id":"semetey-1-2013:p0926:b004:l018","ordinal":147783,"en":"All whom we encountered died."},{"id":"semetey-1-2013:p0926:b004:l019","ordinal":147784,"en":"We lost Almambet,"},{"id":"semetey-1-2013:p0926:b004:l020","ordinal":147785,"en":"And had Chubak offered as a gift."},{"id":"semetey-1-2013:p0926:b004:l021","ordinal":147786,"en":"All our honored lions"},{"id":"semetey-1-2013:p0926:b004:l022","ordinal":147787,"en":"We lost to the khagan's realm."},{"id":"semetey-1-2013:p0926:b004:l023","ordinal":147788,"en":"When we returned,"},{"id":"semetey-1-2013:p0926:b004:l024","ordinal":147789,"en":"Between his back and neck,"},{"id":"semetey-1-2013:p0926:b004:l025","ordinal":147790,"en":"A grievous sickness came upon him;"},{"id":"semetey-1-2013:p0926:b004:l026","ordinal":147791,"en":"The wound of your Magnanimous One—"},{"id":"semetey-1-2013:p0926:b004:l027","ordinal":147792,"en":"When Manas passed from the world,"},{"id":"semetey-1-2013:p0926:b004:l028","ordinal":147793,"en":"Kanykei was left in mourning,"},{"id":"semetey-1-2013:p0926:b004:l029","ordinal":147794,"en":"And Semetey fled away."},{"id":"semetey-1-2013:p0926:b004:l030","ordinal":147795,"en":"His later affairs turned out well;"},{"id":"semetey-1-2013:p0926:b004:l031","ordinal":147796,"en":"He went to Bukhara and grew up."},{"id":"semetey-1-2013:p0926:b004:l032","ordinal":147797,"en":"A lion favored by an unseen protector arose,"},{"id":"semetey-1-2013:p0926:b004:l033","ordinal":147798,"en":"He came and settled in Talas."},{"id":"semetey-1-2013:p0926:b004:l034","ordinal":147799,"en":"The orphan grew to maturity,"},{"id":"semetey-1-2013:p0926:b004:l035","ordinal":147800,"en":"And joined the ranks himself."},{"id":"semetey-1-2013:p0926:b004:l036","ordinal":147801,"en":"When he came and settled in Talas,"},{"id":"semetey-1-2013:p0926:b004:l037","ordinal":147802,"en":"Longing greatly for you,"},{"id":"semetey-1-2013:p0926:b004:l038","ordinal":147803,"en":"That orphan son of Manas"},{"id":"semetey-1-2013:p0926:b004:l039","ordinal":147804,"en":"Said, ‘I would see your face.’"},{"id":"semetey-1-2013:p0927:b003:l001","ordinal":147805,"en":"Look, Chynkozho,"},{"id":"semetey-1-2013:p0927:b003:l002","ordinal":147806,"en":"He is the very image of a prince."},{"id":"semetey-1-2013:p0927:b003:l003","ordinal":147807,"en":"Dear Kozho, heed my words."},{"id":"semetey-1-2013:p0927:b003:l004","ordinal":147808,"en":"Move back to Talas;"},{"id":"semetey-1-2013:p0927:b003:l005","ordinal":147809,"en":"Go and mourn for Manas."},{"id":"semetey-1-2013:p0927:b003:l006","ordinal":147810,"en":"Pasture your livestock upon the steppe."},{"id":"semetey-1-2013:p0927:b003:l007","ordinal":147811,"en":"Go and give support"},{"id":"semetey-1-2013:p0927:b003:l008","ordinal":147812,"en":"To the boy Semetey."},{"id":"semetey-1-2013:p0927:b003:l009","ordinal":147813,"en":"There is the place where you will find prosperity."},{"id":"semetey-1-2013:p0927:b003:l010","ordinal":147814,"en":"Go and settle in Talas."},{"id":"semetey-1-2013:p0927:b003:l011","ordinal":147815,"en":"He is the hero who will welcome you,"},{"id":"semetey-1-2013:p0927:b003:l012","ordinal":147816,"en":"The lion who will ease your anxiety."},{"id":"semetey-1-2013:p0927:b003:l013","ordinal":147817,"en":"He greased his blue steel."},{"id":"semetey-1-2013:p0927:b003:l014","ordinal":147818,"en":"The one who sorely provoked him—"},{"id":"semetey-1-2013:p0927:b003:l015","ordinal":147819,"en":"Khan Kobosh—he slew."},{"id":"semetey-1-2013:p0927:b003:l016","ordinal":147820,"en":"When they stirred his stubborn anger,"},{"id":"semetey-1-2013:p0927:b003:l017","ordinal":147821,"en":"He destroyed his own father."},{"id":"semetey-1-2013:p0927:b003:l018","ordinal":147822,"en":"When they provoked his wrath,"},{"id":"semetey-1-2013:p0927:b003:l019","ordinal":147823,"en":"He destroyed the forty companions."},{"id":"semetey-1-2013:p0927:b003:l020","ordinal":147824,"en":"He devoured Khan Zhakyp."},{"id":"semetey-1-2013:p0927:b003:l021","ordinal":147825,"en":"No mortal remained"},{"id":"semetey-1-2013:p0927:b003:l022","ordinal":147826,"en":"Who could withstand the boy."},{"id":"semetey-1-2013:p0927:b003:l023","ordinal":147827,"en":"The reason for our coming to you—"},{"id":"semetey-1-2013:p0927:b003:l024","ordinal":147828,"en":"Against the unbeliever like a venomous spider,"},{"id":"semetey-1-2013:p0927:b003:l025","ordinal":147829,"en":"The hero Khan Kongurbai,"},{"id":"semetey-1-2013:p0927:b003:l026","ordinal":147830,"en":"To wage a holy war in earnest,"},{"id":"semetey-1-2013:p0927:b003:l027","ordinal":147831,"en":"Placing the standard in your hands,"},{"id":"semetey-1-2013:p0927:b003:l028","ordinal":147832,"en":"The countless Muslim troops"},{"id":"semetey-1-2013:p0927:b003:l029","ordinal":147833,"en":"To have you alone lead,"},{"id":"semetey-1-2013:p0927:b003:l030","ordinal":147834,"en":"To gird our waists firmly,"},{"id":"semetey-1-2013:p0927:b003:l031","ordinal":147835,"en":"To take you as our aid,"},{"id":"semetey-1-2013:p0927:b003:l032","ordinal":147836,"en":"To face Kongurbai in Beijing"},{"id":"semetey-1-2013:p0927:b003:l033","ordinal":147837,"en":"And pursue the blood-price,"},{"id":"semetey-1-2013:p0927:b003:l034","ordinal":147838,"en":"To inflict grievous torment,"},{"id":"semetey-1-2013:p0927:b003:l035","ordinal":147839,"en":"My champion has sent us to you,"},{"id":"semetey-1-2013:p0927:b003:l036","ordinal":147840,"en":"Over the Argyn and Kyrgyz"},{"id":"semetey-1-2013:p0927:b003:l037","ordinal":147841,"en":"To raise you as their lord."},{"id":"semetey-1-2013:p0927:b003:l038","ordinal":147842,"en":"With a rosy countenance, a radiant face,"},{"id":"semetey-1-2013:p0927:b003:l039","ordinal":147843,"en":"A glowing red ember was he."},{"id":"semetey-1-2013:p0927:b004:l001","ordinal":147844,"en":"In this fleeting world"},{"id":"semetey-1-2013:p0927:b004:l002","ordinal":147845,"en":"There was none like Kulchoro."},{"id":"semetey-1-2013:p0927:b004:l003","ordinal":147846,"en":"The fulfillment of Semetey's wish,"},{"id":"semetey-1-2013:p0927:b004:l004","ordinal":147847,"en":"Girded with a silver belt,"},{"id":"semetey-1-2013:p0927:b004:l005","ordinal":147848,"en":"His sunlike face shining with light,"},{"id":"semetey-1-2013:p0927:b004:l006","ordinal":147849,"en":"This smiling boy"},{"id":"semetey-1-2013:p0927:b004:l007","ordinal":147850,"en":"Was Almambet's son."},{"id":"semetey-1-2013:p0927:b004:l008","ordinal":147851,"en":"Of middling height, broad-shouldered,"},{"id":"semetey-1-2013:p0927:b004:l009","ordinal":147852,"en":"At their feast ninety beasts had been slaughtered;"},{"id":"semetey-1-2013:p0927:b004:l010","ordinal":147853,"en":"He had been named Kanchoro."},{"id":"semetey-1-2013:p0927:b004:l011","ordinal":147854,"en":"He was dear Chubak's son."},{"id":"semetey-1-2013:p0927:b004:l012","ordinal":147855,"en":"You were their honored kinsman;"},{"id":"semetey-1-2013:p0927:b004:l013","ordinal":147856,"en":"My Kozho, know their worth."},{"id":"semetey-1-2013:p0927:b004:l014","ordinal":147857,"en":"We raised peerless steeds, calling them noble horses;"},{"id":"semetey-1-2013:p0927:b004:l015","ordinal":147858,"en":"Unable to stay away, we came, calling you kin."},{"id":"semetey-1-2013:p0927:b004:l016","ordinal":147859,"en":"I have spoken at length—heed my words."},{"id":"semetey-1-2013:p0927:b004:l017","ordinal":147860,"en":"My gray-maned Kozho, understand."},{"id":"semetey-1-2013:p0927:b004:l018","ordinal":147861,"en":"You were my exceptional Kozho;"},{"id":"semetey-1-2013:p0927:b004:l019","ordinal":147862,"en":"I was Bakai, bringer of good fortune.”"},{"id":"semetey-1-2013:p0927:b004:l020","ordinal":147863,"en":"When he spoke in this way,"},{"id":"semetey-1-2013:p0927:b004:l021","ordinal":147864,"en":"Kozho began to rage:"},{"id":"semetey-1-2013:p0927:b004:l022","ordinal":147865,"en":"“Valiant uncle Bakai!"},{"id":"semetey-1-2013:p0927:b004:l023","ordinal":147866,"en":"I will not accept these words of yours;"},{"id":"semetey-1-2013:p0927:b004:l024","ordinal":147867,"en":"I will not go to Talas."},{"id":"semetey-1-2013:p0927:b004:l025","ordinal":147868,"en":"His bloodthirsty father Manas—"},{"id":"semetey-1-2013:p0927:b004:l026","ordinal":147869,"en":"This hand deceived him six times."},{"id":"semetey-1-2013:p0927:b004:l027","ordinal":147870,"en":"Talas amid the mountains—"},{"id":"semetey-1-2013:p0927:b004:l028","ordinal":147871,"en":"How could I go and make it my homeland?"},{"id":"semetey-1-2013:p0927:b004:l029","ordinal":147872,"en":"To Temir Khan's city"},{"id":"semetey-1-2013:p0927:b004:l030","ordinal":147873,"en":"He wandered and grew up,"},{"id":"semetey-1-2013:p0927:b004:l031","ordinal":147874,"en":"That orphan rotten at the root—"},{"id":"semetey-1-2013:p0927:b004:l032","ordinal":147875,"en":"How could I go and make him a hero!"},{"id":"semetey-1-2013:p0927:b004:l033","ordinal":147876,"en":"Do not grieve, Bakai; hear my words."},{"id":"semetey-1-2013:p0927:b004:l034","ordinal":147877,"en":"In hilly Ken-Kol,"},{"id":"semetey-1-2013:p0927:b004:l035","ordinal":147878,"en":"How could I pitch my village?"},{"id":"semetey-1-2013:p0927:b004:l036","ordinal":147879,"en":"Manas's foolish son Semetey—"},{"id":"semetey-1-2013:p0927:b004:l037","ordinal":147880,"en":"Taking that one as my support,"},{"id":"semetey-1-2013:p0927:b004:l038","ordinal":147881,"en":"How could I go there and prosper?"},{"id":"semetey-1-2013:p0927:b004:l039","ordinal":147882,"en":"Set your words right."},{"id":"semetey-1-2013:p0928:b003:l001","ordinal":147883,"en":"Uncle Bakai, before I topple you yourself!"},{"id":"semetey-1-2013:p0928:b003:l002","ordinal":147884,"en":"Do not turn your eyes askance;"},{"id":"semetey-1-2013:p0928:b003:l003","ordinal":147885,"en":"Do not twist your words!"},{"id":"semetey-1-2013:p0928:b003:l004","ordinal":147886,"en":"Is your Talas such a superior land?"},{"id":"semetey-1-2013:p0928:b003:l005","ordinal":147887,"en":"Is Semetey a greater hero than I?"},{"id":"semetey-1-2013:p0928:b003:l006","ordinal":147888,"en":"Feeling sleepy"},{"id":"semetey-1-2013:p0928:b003:l007","ordinal":147889,"en":"The road you have traveled halfway."},{"id":"semetey-1-2013:p0928:b003:l008","ordinal":147890,"en":"You have courage, braggart—"},{"id":"semetey-1-2013:p0928:b003:l009","ordinal":147891,"en":"To Manas's foolish orphan son"},{"id":"semetey-1-2013:p0928:b003:l010","ordinal":147892,"en":"I will not pitch my village as a subject!”"},{"id":"semetey-1-2013:p0928:b003:l011","ordinal":147893,"en":"While Kozho was raging,"},{"id":"semetey-1-2013:p0928:b003:l012","ordinal":147894,"en":"Almambet's Kulchoro,"},{"id":"semetey-1-2013:p0928:b003:l013","ordinal":147895,"en":"Who had not yet charged shouting into battle,"},{"id":"semetey-1-2013:p0928:b003:l014","ordinal":147896,"en":"Between the enemy and the people"},{"id":"semetey-1-2013:p0928:b003:l015","ordinal":147897,"en":"Had not yet learned to distinguish."},{"id":"semetey-1-2013:p0928:b003:l016","ordinal":147898,"en":"Kulchoro slipped away,"},{"id":"semetey-1-2013:p0928:b003:l017","ordinal":147899,"en":"And caused mischief there."},{"id":"semetey-1-2013:p0928:b003:l018","ordinal":147900,"en":"Chynkozho's Black Horse—"},{"id":"semetey-1-2013:p0928:b003:l019","ordinal":147901,"en":"He cut a notch then,"},{"id":"semetey-1-2013:p0928:b003:l020","ordinal":147902,"en":"And put Ogoy's earmark upon it."},{"id":"semetey-1-2013:p0928:b003:l021","ordinal":147903,"en":"Pulling free of its tether,"},{"id":"semetey-1-2013:p0928:b003:l022","ordinal":147904,"en":"The sly one's Black Horse"},{"id":"semetey-1-2013:p0928:b003:l023","ordinal":147905,"en":"Hurried away with nimble steps."},{"id":"semetey-1-2013:p0928:b003:l024","ordinal":147906,"en":"That accursed one's Black Horse"},{"id":"semetey-1-2013:p0928:b003:l025","ordinal":147907,"en":"Fled toward Kebez-Too."},{"id":"semetey-1-2013:p0928:b003:l026","ordinal":147908,"en":"The mount beneath him"},{"id":"semetey-1-2013:p0928:b003:l027","ordinal":147909,"en":"Was Abyke's Aktelki."},{"id":"semetey-1-2013:p0928:b003:l028","ordinal":147910,"en":"The mighty orphan Kulchoro,"},{"id":"semetey-1-2013:p0928:b003:l029","ordinal":147911,"en":"Lashing his whip to right and left,"},{"id":"semetey-1-2013:p0928:b003:l030","ordinal":147912,"en":"Spurring this way and that,"},{"id":"semetey-1-2013:p0928:b003:l031","ordinal":147913,"en":"Pursued the Black Horse."},{"id":"semetey-1-2013:p0928:b003:l032","ordinal":147914,"en":"Chasing and chasing, unable to catch it,"},{"id":"semetey-1-2013:p0928:b003:l033","ordinal":147915,"en":"The companion came onto the main road."},{"id":"semetey-1-2013:p0928:b003:l034","ordinal":147916,"en":"Keeping beyond his reach as he pursued,"},{"id":"semetey-1-2013:p0928:b003:l035","ordinal":147917,"en":"The Black Horse gained a ridge."},{"id":"semetey-1-2013:p0928:b003:l036","ordinal":147918,"en":"He let the Black Horse escape."},{"id":"semetey-1-2013:p0928:b003:l037","ordinal":147919,"en":"Cutting its ear, Kulchoro"},{"id":"semetey-1-2013:p0928:b003:l038","ordinal":147920,"en":"Had left his mark upon the Black Horse."},{"id":"semetey-1-2013:p0928:b003:l039","ordinal":147921,"en":"While they were raging,"},{"id":"semetey-1-2013:p0928:b004:l001","ordinal":147922,"en":"Kulchoro came back."},{"id":"semetey-1-2013:p0928:b004:l002","ordinal":147923,"en":"Arguing and pressing his case,"},{"id":"semetey-1-2013:p0928:b004:l003","ordinal":147924,"en":"Chynkozho was carrying on."},{"id":"semetey-1-2013:p0928:b004:l004","ordinal":147925,"en":"Roaring like a raging stream,"},{"id":"semetey-1-2013:p0928:b004:l005","ordinal":147926,"en":"Raging like a hungry camel bull,"},{"id":"semetey-1-2013:p0928:b004:l006","ordinal":147927,"en":"Bellowing like a bull,"},{"id":"semetey-1-2013:p0928:b004:l007","ordinal":147928,"en":"Summoning his old fury,"},{"id":"semetey-1-2013:p0928:b004:l008","ordinal":147929,"en":"He rumbled and stormed,"},{"id":"semetey-1-2013:p0928:b004:l009","ordinal":147930,"en":"Speaking against Khan Bakai."},{"id":"semetey-1-2013:p0928:b004:l010","ordinal":147931,"en":"He had all things in abundance;"},{"id":"semetey-1-2013:p0928:b004:l011","ordinal":147932,"en":"His right shoulder was broad."},{"id":"semetey-1-2013:p0928:b004:l012","ordinal":147933,"en":"Were it not for his raging madness,"},{"id":"semetey-1-2013:p0928:b004:l013","ordinal":147934,"en":"He was a hero who could shatter the Oirat."},{"id":"semetey-1-2013:p0928:b004:l014","ordinal":147935,"en":"He was a surging lion."},{"id":"semetey-1-2013:p0928:b004:l015","ordinal":147936,"en":"However mountainlike he was,"},{"id":"semetey-1-2013:p0928:b004:l016","ordinal":147937,"en":"In wisdom he was lacking."},{"id":"semetey-1-2013:p0928:b004:l017","ordinal":147938,"en":"If that Kozho had been resourceful,"},{"id":"semetey-1-2013:p0928:b004:l018","ordinal":147939,"en":"All the world"},{"id":"semetey-1-2013:p0928:b004:l019","ordinal":147940,"en":"He could have made submit."},{"id":"semetey-1-2013:p0928:b004:l020","ordinal":147941,"en":"Your dear uncle Kozho,"},{"id":"semetey-1-2013:p0928:b004:l021","ordinal":147942,"en":"When he raged like a lion,"},{"id":"semetey-1-2013:p0928:b004:l022","ordinal":147943,"en":"Had a black fur cap like a cauldron."},{"id":"semetey-1-2013:p0928:b004:l023","ordinal":147944,"en":"If Chynkozho were wise"},{"id":"semetey-1-2013:p0928:b004:l024","ordinal":147945,"en":"And joined with Semetey,"},{"id":"semetey-1-2013:p0928:b004:l025","ordinal":147946,"en":"All the Chinese and their khagan"},{"id":"semetey-1-2013:p0928:b004:l026","ordinal":147947,"en":"He had the power to put to trial."},{"id":"semetey-1-2013:p0928:b004:l027","ordinal":147948,"en":"All his twelve bodily members were complete;"},{"id":"semetey-1-2013:p0928:b004:l028","ordinal":147949,"en":"He was born an imposing hero."},{"id":"semetey-1-2013:p0928:b004:l029","ordinal":147950,"en":"If you looked upon Chynkozho,"},{"id":"semetey-1-2013:p0928:b004:l030","ordinal":147951,"en":"Kozho was capable in all he did."},{"id":"semetey-1-2013:p0928:b004:l031","ordinal":147952,"en":"Tall and broad-shouldered,"},{"id":"semetey-1-2013:p0928:b004:l032","ordinal":147953,"en":"More imposing than other men, Kozho—"},{"id":"semetey-1-2013:p0928:b004:l033","ordinal":147954,"en":"Which of his qualities shall we tell?"},{"id":"semetey-1-2013:p0928:b004:l034","ordinal":147955,"en":"Both a hero and a lion,"},{"id":"semetey-1-2013:p0928:b004:l035","ordinal":147956,"en":"If you looked upon Chynkozho,"},{"id":"semetey-1-2013:p0928:b004:l036","ordinal":147957,"en":"He was an exceptional man of distinctive splendor."},{"id":"semetey-1-2013:p0928:b004:l037","ordinal":147958,"en":"Clad in a blue flower-patterned coat,"},{"id":"semetey-1-2013:p0928:b004:l038","ordinal":147959,"en":"If you looked upon Chynkozho,"},{"id":"semetey-1-2013:p0928:b004:l039","ordinal":147960,"en":"He raged like a gray tiger,"},{"id":"semetey-1-2013:p0929:b003:l001","ordinal":147961,"en":"All his anger rose,"},{"id":"semetey-1-2013:p0929:b003:l002","ordinal":147962,"en":"His scalp drew tight by a span,"},{"id":"semetey-1-2013:p0929:b003:l003","ordinal":147963,"en":"And he quarreled with Bakai."},{"id":"semetey-1-2013:p0929:b003:l004","ordinal":147964,"en":"Your uncle Bakai, an exceptional lion,"},{"id":"semetey-1-2013:p0929:b003:l005","ordinal":147965,"en":"The dear hero could not gather himself."},{"id":"semetey-1-2013:p0929:b003:l006","ordinal":147966,"en":"With his beard grown white,"},{"id":"semetey-1-2013:p0929:b003:l007","ordinal":147967,"en":"While away upon his journey,"},{"id":"semetey-1-2013:p0929:b003:l008","ordinal":147968,"en":"He had no means to contend"}]
