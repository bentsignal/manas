[{"id":"seytek-2012:p0695:b002:l011","ordinal":348161,"en":"Why did You make us so deficient?"},{"id":"seytek-2012:p0695:b002:l012","ordinal":348162,"en":"All my forefathers"},{"id":"seytek-2012:p0695:b002:l013","ordinal":348163,"en":"You made lions, one God."},{"id":"seytek-2012:p0695:b002:l014","ordinal":348164,"en":"Yet unable to overcome this perishing dog,"},{"id":"seytek-2012:p0695:b002:l015","ordinal":348165,"en":"Why did You make their descendants"},{"id":"seytek-2012:p0695:b002:l016","ordinal":348166,"en":"So deficient, one God?"},{"id":"seytek-2012:p0695:b002:l017","ordinal":348167,"en":"What inheritance can we attain"},{"id":"seytek-2012:p0695:b002:l018","ordinal":348168,"en":"If we remain alive without dying?"},{"id":"seytek-2012:p0695:b002:l019","ordinal":348169,"en":"Let not one of us remain;"},{"id":"seytek-2012:p0695:b002:l020","ordinal":348170,"en":"Let us all perish in massacre."},{"id":"seytek-2012:p0695:b002:l021","ordinal":348171,"en":"Külchoro standing over there"},{"id":"seytek-2012:p0695:b002:l022","ordinal":348172,"en":"Was a lion inscribed upon our destiny,"},{"id":"seytek-2012:p0695:b002:l023","ordinal":348173,"en":"Favored by perfect fortune."},{"id":"seytek-2012:p0695:b002:l024","ordinal":348174,"en":"He was a soul of terrible majesty;"},{"id":"seytek-2012:p0695:b002:l025","ordinal":348175,"en":"Not merely Sarybai, but the whole world,"},{"id":"seytek-2012:p0695:b002:l026","ordinal":348176,"en":"If anger chanced to seize him,"},{"id":"seytek-2012:p0695:b002:l027","ordinal":348177,"en":"He was one who could destroy it."},{"id":"seytek-2012:p0695:b002:l028","ordinal":348178,"en":"If I am parted from my uncle,"},{"id":"seytek-2012:p0695:b002:l029","ordinal":348179,"en":"What inheritance could I attain?"},{"id":"seytek-2012:p0695:b002:l030","ordinal":348180,"en":"Let not one lone soul remain;"},{"id":"seytek-2012:p0695:b002:l031","ordinal":348181,"en":"Let me perish in the massacre."},{"id":"seytek-2012:p0695:b002:l032","ordinal":348182,"en"