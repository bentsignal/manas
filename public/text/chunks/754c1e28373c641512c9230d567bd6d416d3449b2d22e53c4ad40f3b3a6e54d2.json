[{"id":"seytek-2012:p0681:b003:l017","ordinal":346113,"en":"While Sarybai stood speaking thus,"},{"id":"seytek-2012:p0681:b003:l018","ordinal":346114,"en":"The man adept and masterful with the spear,"},{"id":"seytek-2012:p0681:b003:l019","ordinal":346115,"en":"Full of cunning and fierce in wrath,"},{"id":"seytek-2012:p0681:b003:l020","ordinal":346116,"en":"The mighty man who spared no one,"},{"id":"seytek-2012:p0681:b003:l021","ordinal":346117,"en":"Who never drew back from his youth,"},{"id":"seytek-2012:p0681:b003:l022","ordinal":346118,"en":"And from hardship, conflict, and suffering"},{"id":"seytek-2012:p0681:b003:l023","ordinal":346119,"en":"Had never once retreated—"},{"id":"seytek-2012:p0681:b003:l024","ordinal":346120,"en":"He was that dark-gray-maned lion,"},{"id":"seytek-2012:p0681:b003:l025","ordinal":346121,"en":"Among all souls ever born,"},{"id":"seytek-2012:p0681:b003:l026","ordinal":346122,"en":"He was that vigilant hero."},{"id":"seytek-2012:p0681:b003:l027","ordinal":346123,"en":"Your noble uncle Külchoro,"},{"id":"seytek-2012:p0681:b003:l028","ordinal":346124,"en":"When the warrior was distressed,"},{"id":"seytek-2012:p0681:b003:l029","ordinal":346125,"en":"The black-maned leopard,"},{"id":"seytek-2012:p0681:b003:l030","ordinal":346126,"en":"The spirit of Manas himself,"},{"id":"seytek-2012:p0681:b003:l031","ordinal":346127,"en":"Made ready before him in truth;"},{"id":"seytek-2012:p0681:b003:l032","ordinal":346128,"en":"The short-maned gray lion"},{"id":"seytek-2012:p0681:b003:l033","ordinal":346129,"en":"Seemed poised to tear him open,"},{"id":"seytek-2012:p0681:b003:l034","ordinal":346130,"en":"Preparing himself face-to-face."},{"id":"seytek-2012:p0681:b003:l035","ordinal":346131,"en":"His lashes burned like embers;"},{"id":"seytek-2012:p0681:b003:l036","ordinal":346132,"en":"His adversary Sarybai"},{"id":"seytek-2012:p0681:b003:l037","ordinal":346133,"en":"Coiled to strike like a dragon."},{"id":"seytek-2012:p0681:b003:l038","ordinal":346134,"en":"His broad front teeth, large as a gate,"},{"id":"seytek-2012:p0681:b003:l039","ordinal":346135,"en":"Were shattered and scattered like flour;"},{"id":"seytek-2012:p0681:b003:l040","ordinal":346136,"en":"At the sight, the heart was troubled,"},{"id":"seytek-2012:p0682:b002:l001","ordinal":346137,"en":"And his numbers greatly diminished."},{"id":"seytek-2012:p0682:b002:l002","ordinal":346138,"en":"Almambet’s sword Joikuma—"},{"id":"seytek-2012:p0682:b002:l003","ordinal":346139,"en":"Encountered by divine chance,"},{"id":"seytek-2012:p0682:b002:l004","ordinal":346140,"en":"Found upon the open steppe."},{"id":"seytek-2012:p0682:b002:l005","ordinal":346141,"en":"Laid upon grass, it set it ablaze;"},{"id":"seytek-2012:p0682:b002:l006","ordinal":346142,"en":"Whatever it struck was swiftly destroyed."},{"id":"seytek-2012:p0682:b002:l007","ordinal":346143,"en":"When brandished with a cry against the foe,"},{"id":"seytek-2012:p0682:b002:l008","ordinal":346144,"en":"Its edge glowed red with fire;"},{"id":"seytek-2012:p0682:b002:l009","ordinal":346145,"en":"When swung against a formidable enemy,"},{"id":"seytek-2012:p0682:b002:l010","ordinal":346146,"en":"It lengthened to forty fathoms."},{"id":"seytek-2012:p0682:b002:l011","ordinal":346147,"en":"Whenever it was drawn forth in valor,"},{"id":"seytek-2012:p0682:b002:l012","ordinal":346148,"en":"It never returned without shedding blood;"},{"id":"seytek-2012:p0682:b002:l013","ordinal":346149,"en":"Until it had drunk its fill of blood,"},{"id":"seytek-2012:p0682:b002:l014","ordinal":346150,"en":"It would not go back into its sheath,"},{"id":"seytek-2012:p0682:b002:l015","ordinal":346151,"en":"Its green-hued edge gleaming."},{"id":"seytek-2012:p0682:b002:l016","ordinal":346152,"en":"No enemy who faced it"},{"id":"seytek-2012:p0682:b002:l017","ordinal":346153,"en":"Ever remained alive."},{"id":"seytek-2012:p0682:b002:l018","ordinal":346154,"en":"Such was the nature of the sword."},{"id":"seytek-2012:p0682:b002:l019","ordinal":346155,"en":"When swung against a formidable foe,"},{"id":"seytek-2012:p0682:b002:l020","ordinal":346156,"en":"It satisfied the surging hunger for battle;"},{"id":"seytek-2012:p0682:b002:l021","ordinal":346157,"en":"The enemy who faced it"},{"id":"seytek-2012:p0682:b002:l022","ordinal":346158,"en":"Was subdued in spirit."},{"id":"seytek-2012:p0682:b002:l023","ordinal":346159,"en":"Behold the sword Joikuma,"},{"id":"seytek-2012:p0682:b002:l024","ordinal":346160,"en":"Joikuma drawn naked from its sheath;"},{"id":"seytek-2012:p0682:b002:l025","ordinal":346161,"en":"He appealed to the spirits"},{"id":"seytek-2012:p0682:b002:l026","ordinal":346162,"en":"Of the heroes who had vanished,"},{"id":"seytek-2012:p0682:b002:l027","ordinal":346163,"en":"Your warrior Külchoro."},{"id":"seytek-2012:p0682:b002:l028","ordinal":346164,"en":"To bring Sarybai down,"},{"id":"seytek-2012:p0682:b002:l029","ordinal":346165,"en":"He recalled what such an enemy was."},{"id":"seytek-2012:p0682:b002:l030","ordinal":346166,"en":"From Almambet, who passed away long ago,"},{"id":"seytek-2012:p0682:b002:l031","ordinal":346167,"en":"Syrbarang remained as a bequest;"},{"id":"seytek-2012:p0682:b002:l032","ordinal":346168,"en":"Almambet of former days"},{"id":"seytek-2012:p0682:b002:l033","ordinal":346169,"en":"Had received Syrbarang as a sacred prize."},{"id":"seytek-2012:p0682:b002:l034","ordinal":346170,"en":"Its might was heavenly steel,"},{"id":"seytek-2012:p0682:b002:l035","ordinal":346171,"en":"A possession of Chylaba,"},{"id":"seytek-2012:p0682:b002:l036","ordinal":346172,"en":"The khan of Beijing."},{"id":"seytek-2012:p0682:b002:l037","ordinal":346173,"en":"In a garden planted in rows,"},{"id":"seytek-2012:p0682:b002:l038","ordinal":346174,"en":"Beside the Khakhan’s palace,"},{"id":"seytek-2012:p0682:b002:l039","ordinal":346175,"en":"He had turned from the black faith to the white,"},{"id":"seytek-2012:p0682:b002:l040","ordinal":346176,"en":"Fleeing the infidels and becoming an exile."},{"id":"seytek-2012:p0682:b003:l001","ordinal":346177,"en":"He had it fitted with a black-hair cord,"},{"id":"seytek-2012:p0682:b003:l002","ordinal":346178,"en":"And approved it for leveling at the foe."},{"id":"seytek-2012:p0682:b003:l003","ordinal":346179,"en":"He had it plated in armor,"},{"id":"seytek-2012:p0682:b003:l004","ordinal":346180,"en":"And, lest it warp or soften,"},{"id":"seytek-2012:p0682:b003:l005","ordinal":346181,"en":"Had it wrapped in leather."},{"id":"seytek-2012:p0682:b003:l006","ordinal":346182,"en":"To strike the enemy without breaking,"},{"id":"seytek-2012:p0682:b003:l007","ordinal":346183,"en":"Great David himself had tested it."},{"id":"seytek-2012:p0682:b003:l008","ordinal":346184,"en":"When he clenched and struck with it,"},{"id":"seytek-2012:p0682:b003:l009","ordinal":346185,"en":"No opposing enemy remained standing."},{"id":"seytek-2012:p0682:b003:l010","ordinal":346186,"en":"When he cried out and thrust the spear,"},{"id":"seytek-2012:p0682:b003:l011","ordinal":346187,"en":"It split whatever place it pierced."},{"id":"seytek-2012:p0682:b003:l012","ordinal":346188,"en":"The foe who timidly received it,"},{"id":"seytek-2012:p0682:b003:l013","ordinal":346189,"en":"Though clad in armor, died."},{"id":"seytek-2012:p0682:b003:l014","ordinal":346190,"en":"Külchoro’s ornate spear"},{"id":"seytek-2012:p0682:b003:l015","ordinal":346191,"en":"Had singular torment and mighty venom;"},{"id":"seytek-2012:p0682:b003:l016","ordinal":346192,"en":"It bore the vapor of diamonds and rubies."},{"id":"seytek-2012:p0682:b003:l017","ordinal":346193,"en":"Wherever it struck, the wound was no light matter;"},{"id":"seytek-2012:p0682:b003:l018","ordinal":346194,"en":"It held a dragon’s poison—"},{"id":"seytek-2012:p0682:b003:l019","ordinal":346195,"en":"Such was the nature of the spear."},{"id":"seytek-2012:p0682:b003:l020","ordinal":346196,"en":"Külchoro’s battle-axe—"},{"id":"seytek-2012:p0682:b003:l021","ordinal":346197,"en":"Its socket was steel and its edge was sharp,"},{"id":"seytek-2012:p0682:b003:l022","ordinal":346198,"en":"Its haft was overlaid with gold,"},{"id":"seytek-2012:p0682:b003:l023","ordinal":346199,"en":"And poison was spread upon its blade."},{"id":"seytek-2012:p0682:b003:l024","ordinal":346200,"en":"Its edge was joined with steel;"},{"id":"seytek-2012:p0682:b003:l025","ordinal":346201,"en":"Any enemy it struck directly"},{"id":"seytek-2012:p0682:b003:l026","ordinal":346202,"en":"Collapsed like a mountain."},{"id":"seytek-2012:p0682:b003:l027","ordinal":346203,"en":"When he brought it down with full force,"},{"id":"seytek-2012:p0682:b003:l028","ordinal":346204,"en":"Not only men, wretches—"},{"id":"seytek-2012:p0682:b003:l029","ordinal":346205,"en":"Cliffs, mountains, and rocks came crashing down."},{"id":"seytek-2012:p0682:b003:l030","ordinal":346206,"en":"The youngest of sixty nobles,"},{"id":"seytek-2012:p0682:b003:l031","ordinal":346207,"en":"The favorite of Alooke—"},{"id":"seytek-2012:p0682:b003:l032","ordinal":346208,"en":"The infidel son of Kaldai,"},{"id":"seytek-2012:p0682:b003:l033","ordinal":346209,"en":"Your warrior Khan Kongurbai,"},{"id":"seytek-2012:p0682:b003:l034","ordinal":346210,"en":"Had fallen beneath this axe."},{"id":"seytek-2012:p0682:b003:l035","ordinal":346211,"en":"Eskara, khan of the Manchus,"},{"id":"seytek-2012:p0682:b003:l036","ordinal":346212,"en":"Had fallen beneath this axe."},{"id":"seytek-2012:p0682:b003:l037","ordinal":346213,"en":"It had dyed its socket in blood,"},{"id":"seytek-2012:p0682:b003:l038","ordinal":346214,"en":"And was truly suited for war."},{"id":"seytek-2012:p0682:b003:l039","ordinal":346215,"en":"When the axe was being forged,"},{"id":"seytek-2012:p0682:b003:l040","ordinal":346216,"en":"From Khan Manas’s treasury,"},{"id":"seytek-2012:p0683:b002:l001","ordinal":346217,"en":"When the lamented man saw it,"},{"id":"seytek-2012:p0683:b002:l002","ordinal":346218,"en":"Did he not unleash unsparing hardship"},{"id":"seytek-2012:p0683:b002:l003","ordinal":346219,"en":"Upon the enemy?"},{"id":"seytek-2012:p0683:b002:l004","ordinal":346220,"en":"Not revealing that its master was dead,"},{"id":"seytek-2012:p0683:b002:l005","ordinal":346221,"en":"Allowing no alien hand to touch it,"},{"id":"seytek-2012:p0683:b002:l006","ordinal":346222,"en":"Never yielding to a tyrant,"},{"id":"seytek-2012:p0683:b002:l007","ordinal":346223,"en":"Never giving an inch to the foe,"},{"id":"seytek-2012:p0683:b002:l008","ordinal":346224,"en":"Did he not unleash"},{"id":"seytek-2012:p0683:b002:l009","ordinal":346225,"en":"An unsparing tumult?"},{"id":"seytek-2012:p0683:b002:l010","ordinal":346226,"en":"When the realm was scattered,"},{"id":"seytek-2012:p0683:b002:l011","ordinal":346227,"en":"When dogs overran the royal camp,"},{"id":"seytek-2012:p0683:b002:l012","ordinal":346228,"en":"Did it not strike down"},{"id":"seytek-2012:p0683:b002:l013","ordinal":346229,"en":"Both Ajybai and Kölbai?"},{"id":"seytek-2012:p0683:b002:l014","ordinal":346230,"en":"Weeping bitterly to the one God,"},{"id":"seytek-2012:p0683:b002:l015","ordinal":346231,"en":"And setting it aside for Külchoro,"},{"id":"seytek-2012:p0683:b002:l016","ordinal":346232,"en":"Did not the venerable lady Kanykei,"},{"id":"seytek-2012:p0683:b002:l017","ordinal":346233,"en":"Grieving and weeping, take it"},{"id":"seytek-2012:p0683:b002:l018","ordinal":346234,"en":"Away from Talas?"},{"id":"seytek-2012:p0683:b002:l019","ordinal":346235,"en":"From noble gray-maned Almambet,"},{"id":"seytek-2012:p0683:b002:l020","ordinal":346236,"en":"Syrbarang remained as a gift."},{"id":"seytek-2012:p0683:b002:l021","ordinal":346237,"en":"“It is the inheritance left by my father;"},{"id":"seytek-2012:p0683:b002:l022","ordinal":346238,"en":"How can I refrain from shooting"},{"id":"seytek-2012:p0683:b002:l023","ordinal":346239,"en":"At the infidel son of a monster?”"},{"id":"seytek-2012:p0683:b002:l024","ordinal":346240,"en":"The enraged choro"},{"id":"seytek-2012:p0683:b002:l025","ordinal":346241,"en":"Was seized by his thirst for blood."},{"id":"seytek-2012:p0683:b002:l026","ordinal":346242,"en":"His opponent was Sarybai;"},{"id":"seytek-2012:p0683:b002:l027","ordinal":346243,"en":"Not a spoonful of blood would remain."},{"id":"seytek-2012:p0683:b002:l028","ordinal":346244,"en":"From the noble-born choro’s"},{"id":"seytek-2012:p0683:b002:l029","ordinal":346245,"en":"Majesty surged strength."},{"id":"seytek-2012:p0683:b002:l030","ordinal":346246,"en":"When you looked upon his fearsome face,"},{"id":"seytek-2012:p0683:b002:l031","ordinal":346247,"en":"His hair stood five felt-boots high."},{"id":"seytek-2012:p0683:b002:l032","ordinal":346248,"en":"The noble, peerless choro"},{"id":"seytek-2012:p0683:b002:l033","ordinal":346249,"en":"Made ready like a hawk;"},{"id":"seytek-2012:p0683:b002:l034","ordinal":346250,"en":"To the enraged choro,"},{"id":"seytek-2012:p0683:b002:l035","ordinal":346251,"en":"Wisdom came from the unseen."},{"id":"seytek-2012:p0683:b002:l036","ordinal":346252,"en":"Strength surged from his majesty,"},{"id":"seytek-2012:p0683:b002:l037","ordinal":346253,"en":"And Sarybai, whom he confronted,"},{"id":"seytek-2012:p0683:b002:l038","ordinal":346254,"en":"Came straight out to meet him."},{"id":"seytek-2012:p0683:b002:l039","ordinal":346255,"en":"When you looked upon the choro’s form,"},{"id":"seytek-2012:p0683:b002:l040","ordinal":346256,"en":"His mustache swept upward."},{"id":"seytek-2012:p0683:b003:l001","ordinal":346257,"en":"When the fickle world was scattered,"},{"id":"seytek-2012:p0683:b003:l002","ordinal":346258,"en":"He renounced his wife,"},{"id":"seytek-2012:p0683:b003:l003","ordinal":346259,"en":"Abandoned his people and homeland,"},{"id":"seytek-2012:p0683:b003:l004","ordinal":346260,"en":"And set out toward the Muslims;"},{"id":"seytek-2012:p0683:b003:l005","ordinal":346261,"en":"Did he not bring"},{"id":"seytek-2012:p0683:b003:l006","ordinal":346262,"en":"A great turmoil and calamity?"},{"id":"seytek-2012:p0683:b003:l007","ordinal":346263,"en":"For the souls left behind,"},{"id":"seytek-2012:p0683:b003:l008","ordinal":346264,"en":"For the children who would become descendants,"},{"id":"seytek-2012:p0683:b003:l009","ordinal":346265,"en":"For those apart from his restless soul,"},{"id":"seytek-2012:p0683:b003:l010","ordinal":346266,"en":"For those destined to remain,"},{"id":"seytek-2012:p0683:b003:l011","ordinal":346267,"en":"A firm support for troubled souls,"},{"id":"seytek-2012:p0683:b003:l012","ordinal":346268,"en":"For the children who would remain behind,"},{"id":"seytek-2012:p0683:b003:l013","ordinal":346269,"en":"Thinking it might one day serve them,"},{"id":"seytek-2012:p0683:b003:l014","ordinal":346270,"en":"Did not noble, peerless Almambet"},{"id":"seytek-2012:p0683:b003:l015","ordinal":346271,"en":"Bring grievous hardship"},{"id":"seytek-2012:p0683:b003:l016","ordinal":346272,"en":"Upon Beijing?"},{"id":"seytek-2012:p0683:b003:l017","ordinal":346273,"en":"Thinking those here would need it,"},{"id":"seytek-2012:p0683:b003:l018","ordinal":346274,"en":"Did not noble, peerless Almambet"},{"id":"seytek-2012:p0683:b003:l019","ordinal":346275,"en":"Bring the blood-avenging Syrbarang"},{"id":"seytek-2012:p0683:b003:l020","ordinal":346276,"en":"As he went forth lamenting,"},{"id":"seytek-2012:p0683:b003:l021","ordinal":346277,"en":"And carry it here?"},{"id":"seytek-2012:p0683:b003:l022","ordinal":346278,"en":"In sport it was Ochogor,"},{"id":"seytek-2012:p0683:b003:l023","ordinal":346279,"en":"In earnest, a ravenous beast;"},{"id":"seytek-2012:p0683:b003:l024","ordinal":346280,"en":"When fired with care, it shattered armies,"},{"id":"seytek-2012:p0683:b003:l025","ordinal":346281,"en":"An attacking foe fell to its bullet,"},{"id":"seytek-2012:p0683:b003:l026","ordinal":346282,"en":"And in fury it broke whole ranks."},{"id":"seytek-2012:p0683:b003:l027","ordinal":346283,"en":"When its report rang out in battle,"},{"id":"seytek-2012:p0683:b003:l028","ordinal":346284,"en":"In the hour granted by God,"},{"id":"seytek-2012:p0683:b003:l029","ordinal":346285,"en":"While ill-fated Almambet lived,"},{"id":"seytek-2012:p0683:b003:l030","ordinal":346286,"en":"It thundered when fired at the foe."},{"id":"seytek-2012:p0683:b003:l031","ordinal":346287,"en":"The whole body of mortal man"},{"id":"seytek-2012:p0683:b003:l032","ordinal":346288,"en":"Shuddered from head to toe."},{"id":"seytek-2012:p0683:b003:l033","ordinal":346289,"en":"Where its screaming bullet struck,"},{"id":"seytek-2012:p0683:b003:l034","ordinal":346290,"en":"The enemy scattered in panic."},{"id":"seytek-2012:p0683:b003:l035","ordinal":346291,"en":"When the blessed man bore it,"},{"id":"seytek-2012:p0683:b003:l036","ordinal":346292,"en":"It was the mirror upon his shoulder;"},{"id":"seytek-2012:p0683:b003:l037","ordinal":346293,"en":"When it struck a bitterly contending foe,"},{"id":"seytek-2012:p0683:b003:l038","ordinal":346294,"en":"It was the solace of his entrusted soul."},{"id":"seytek-2012:p0683:b003:l039","ordinal":346295,"en":"When noble Almambet died,"},{"id":"seytek-2012:p0683:b003:l040","ordinal":346296,"en":"Its true place of no return,"},{"id":"seytek-2012:p0684:b002:l001","ordinal":346297,"en":"To rein in and turn its muzzle,"},{"id":"seytek-2012:p0684:b002:l002","ordinal":346298,"en":"Against the infidel full of strength,"},{"id":"seytek-2012:p0684:b002:l003","ordinal":346299,"en":"To charge and level the spear,"},{"id":"seytek-2012:p0684:b002:l004","ordinal":346300,"en":"He armed himself with all his weapons,"},{"id":"seytek-2012:p0684:b002:l005","ordinal":346301,"en":"And prepared to meet"},{"id":"seytek-2012:p0684:b002:l006","ordinal":346302,"en":"His adversary Sarybai."},{"id":"seytek-2012:p0684:b002:l007","ordinal":346303,"en":"He appealed to the spirits of Manas, gone to the other world,"},{"id":"seytek-2012:p0684:b002:l008","ordinal":346304,"en":"Of Almambet and Chubak,"},{"id":"seytek-2012:p0684:b002:l009","ordinal":346305,"en":"Of Ajybai and Syrgak."},{"id":"seytek-2012:p0684:b002:l010","ordinal":346306,"en":"To their spirits he prayed."},{"id":"seytek-2012:p0684:b002:l011","ordinal":346307,"en":"“You who pledged yourselves to the twelve holy patrons,"},{"id":"seytek-2012:p0684:b002:l012","ordinal":346308,"en":"Support me, my mighty fathers!"},{"id":"seytek-2012:p0684:b002:l013","ordinal":346309,"en":"You who turned from the black faith to the white,"},{"id":"seytek-2012:p0684:b002:l014","ordinal":346310,"en":"Who fled the infidels and became an exile,"},{"id":"seytek-2012:p0684:b002:l015","ordinal":346311,"en":"My leopard father Almambet,"},{"id":"seytek-2012:p0684:b002:l016","ordinal":346312,"en":"Set my undertaking right yourself!"},{"id":"seytek-2012:p0684:b002:l017","ordinal":346313,"en":"Champion of the Kyrgyz,"},{"id":"seytek-2012:p0684:b002:l018","ordinal":346314,"en":"He too was one of the precious few;"},{"id":"seytek-2012:p0684:b002:l019","ordinal":346315,"en":"Foremost among the majestic,"},{"id":"seytek-2012:p0684:b002:l020","ordinal":346316,"en":"The deftest of swordsmen,"},{"id":"seytek-2012:p0684:b002:l021","ordinal":346317,"en":"The mightiest of the forty choros,"},{"id":"seytek-2012:p0684:b002:l022","ordinal":346318,"en":"The leader of them all,"},{"id":"seytek-2012:p0684:b002:l023","ordinal":346319,"en":"The finest of the forty choros,"},{"id":"seytek-2012:p0684:b002:l024","ordinal":346320,"en":"Baktagül’s morning star,"},{"id":"seytek-2012:p0684:b002:l025","ordinal":346321,"en":"The golden canopy of the Kyrgyz,"},{"id":"seytek-2012:p0684:b002:l026","ordinal":346322,"en":"The warrior of the forty nobles."},{"id":"seytek-2012:p0684:b002:l027","ordinal":346323,"en":"Mighty Chubak, gray-maned hero,"},{"id":"seytek-2012:p0684:b002:l028","ordinal":346324,"en":"We are hard-pressed—support us!”"},{"id":"seytek-2012:p0684:b002:l029","ordinal":346325,"en":"So saying, Külchoro"},{"id":"seytek-2012:p0684:b002:l030","ordinal":346326,"en":"Drew his Jazayil and rushed about,"},{"id":"seytek-2012:p0684:b002:l031","ordinal":346327,"en":"Appealing to the spirits"},{"id":"seytek-2012:p0684:b002:l032","ordinal":346328,"en":"Of the heroes and ill-fated lions"},{"id":"seytek-2012:p0684:b002:l033","ordinal":346329,"en":"Who had passed away:"},{"id":"seytek-2012:p0684:b002:l034","ordinal":346330,"en":"“O sovereign God, I am alone;"},{"id":"seytek-2012:p0684:b002:l035","ordinal":346331,"en":"Do not let the infidel son of a monster"},{"id":"seytek-2012:p0684:b002:l036","ordinal":346332,"en":"Bind and overpower my fortune,"},{"id":"seytek-2012:p0684:b002:l037","ordinal":346333,"en":"Do not, O God, break my spirit."},{"id":"seytek-2012:p0684:b002:l038","ordinal":346334,"en":"Do not dig my grave deep,"},{"id":"seytek-2012:p0684:b002:l039","ordinal":346335,"en":"Do not bend my back,"},{"id":"seytek-2012:p0684:b002:l040","ordinal":346336,"en":"Do not disgrace me and make me groan."},{"id":"seytek-2012:p0684:b003:l001","ordinal":346337,"en":"He is like a saber from Bukhara."},{"id":"seytek-2012:p0684:b003:l002","ordinal":346338,"en":"Look at the front of his saddle,"},{"id":"seytek-2012:p0684:b003:l003","ordinal":346339,"en":"Thick as the Kaldai people."},{"id":"seytek-2012:p0684:b003:l004","ordinal":346340,"en":"His beard is like a quiver-case,"},{"id":"seytek-2012:p0684:b003:l005","ordinal":346341,"en":"And the breath issuing from his mouth"},{"id":"seytek-2012:p0684:b003:l006","ordinal":346342,"en":"Is like flame from a forge—"},{"id":"seytek-2012:p0684:b003:l007","ordinal":346343,"en":"Such is his appearance when you behold him."},{"id":"seytek-2012:p0684:b003:l008","ordinal":346344,"en":"The hero choro supported by the spirits,"},{"id":"seytek-2012:p0684:b003:l009","ordinal":346345,"en":"Who rejoiced at the word “battle,”"},{"id":"seytek-2012:p0684:b003:l010","ordinal":346346,"en":"Whose valor was known among the people,"},{"id":"seytek-2012:p0684:b003:l011","ordinal":346347,"en":"Whose courage was extraordinary,"},{"id":"seytek-2012:p0684:b003:l012","ordinal":346348,"en":"Whose strength was manifold,"},{"id":"seytek-2012:p0684:b003:l013","ordinal":346349,"en":"Whose leonine nature was plain,"},{"id":"seytek-2012:p0684:b003:l014","ordinal":346350,"en":"Whose nobility was renowned,"},{"id":"seytek-2012:p0684:b003:l015","ordinal":346351,"en":"Whom no mortal dared confront,"},{"id":"seytek-2012:p0684:b003:l016","ordinal":346352,"en":"Whom even the surging Flood could not strike—"},{"id":"seytek-2012:p0684:b003:l017","ordinal":346353,"en":"He had a people numerous as black beetles."},{"id":"seytek-2012:p0684:b003:l018","ordinal":346354,"en":"It was his custom to spill the blood"},{"id":"seytek-2012:p0684:b003:l019","ordinal":346355,"en":"Of all who assailed him."},{"id":"seytek-2012:p0684:b003:l020","ordinal":346356,"en":"Though the Chinese swarmed and attacked,"},{"id":"seytek-2012:p0684:b003:l021","ordinal":346357,"en":"They could not bend and overcome him."},{"id":"seytek-2012:p0684:b003:l022","ordinal":346358,"en":"However many mighty giants thronged him,"},{"id":"seytek-2012:p0684:b003:l023","ordinal":346359,"en":"Not one survived"},{"id":"seytek-2012:p0684:b003:l024","ordinal":346360,"en":"The noble hero Külchoro."},{"id":"seytek-2012:p0684:b003:l025","ordinal":346361,"en":"His nobility became known,"},{"id":"seytek-2012:p0684:b003:l026","ordinal":346362,"en":"And, saying, “He is famously mighty,”"},{"id":"seytek-2012:p0684:b003:l027","ordinal":346363,"en":"They inscribed it in the annals"},{"id":"seytek-2012:p0684:b003:l028","ordinal":346364,"en":"Of seething Khakhan."},{"id":"seytek-2012:p0684:b003:l029","ordinal":346365,"en":"His leonine nature revealed,"},{"id":"seytek-2012:p0684:b003:l030","ordinal":346366,"en":"The gray-maned strongman Külchoro"},{"id":"seytek-2012:p0684:b003:l031","ordinal":346367,"en":"Donned armor of blue steel,"},{"id":"seytek-2012:p0684:b003:l032","ordinal":346368,"en":"Slung on his Jazayil,"}]
