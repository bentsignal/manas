[{"id":"semetey-1-2013:p0436:b004:l002","ordinal":110337,"en":"Khan Manas's Syrgak,"},{"id":"semetey-1-2013:p0436:b004:l003","ordinal":110338,"en":"The finest of sixty,"},{"id":"semetey-1-2013:p0436:b004:l004","ordinal":110339,"en":"The strongest of forty companions,"},{"id":"semetey-1-2013:p0436:b004:l005","ordinal":110340,"en":"Riding an excellent thoroughbred,"},{"id":"semetey-1-2013:p0436:b004:l006","ordinal":110341,"en":"Wearing a coat of blue iron,"},{"id":"semetey-1-2013:p0436:b004:l007","ordinal":110342,"en":"Resting his sword in its sheath,"},{"id":"semetey-1-2013:p0436:b004:l008","ordinal":110343,"en":"When he attacked a shouting foe,"},{"id":"semetey-1-2013:p0436:b004:l009","ordinal":110344,"en":"He drenched him in bright-red blood."},{"id":"semetey-1-2013:p0436:b004:l010","ordinal":110345,"en":"Never shrinking from death,"},{"id":"semetey-1-2013:p0436:b004:l011","ordinal":110346,"en":"Never retreating from a shooting enemy,"},{"id":"semetey-1-2013:p0436:b004:l012","ordinal":110347,"en":"Never relaxing his stern expression,"},{"id":"semetey-1-2013:p0436:b004:l013","ordinal":110348,"en":"Never withdrawing once he thrust,"},{"id":"semetey-1-2013:p0436:b004:l014","ordinal":110349,"en":"His strength could reach the whole world."},{"id":"semetey-1-2013:p0436:b004:l015","ordinal":110350,"en":"Manas and that Syrgak"},{"id":"semetey-1-2013:p0436:b004:l016","ordinal":110351,"en":"Were the sons of brothers."},{"id":"semetey-1-2013:p0436:b004:l017","ordinal":110352,"en":"He too came roaring from the hills,"},{"id":"semetey-1-2013:p0436:b004:l018","ordinal":110353,"en":"When he heard Chubak's voice,"},{"id":"semetey-1-2013:p0436:b004:l019","ordinal":110354,"en":"Shouting 'Manas!' as his battle cry."},{"id":"semetey-1-2013:p0436:b004:l020","ordinal":110355,"en":"Ajybay, son of Argyn Khan,"},{"id":"semetey-1-2013:p0436:b004:l021","ordinal":110356,"en":"Who knew seventy different languages,"},{"id":"semetey-1-2013:p0436:b004:l022","ordinal":110357,"en":"Never retreating from one he reached,"},{"id":"semetey-1-2013:p0436:b004:l023","ordinal":110358,"en":"Never turning from one he met,"},{"id":"semetey-1-2013:p0436:b004:l024","ordinal":110359,"en":"Riding a horse such as Kartkuron,"},{"id":"semetey-1-2013:p0436:b004:l025","ordinal":110360,"en":"Wearing a black bulletproof coat,"},{"id":"semetey-1-2013:p0436:b004:l026","ordinal":110361,"en":"Roared in fury."},{"id":"semetey-1-2013:p0436:b004:l027","ordinal":110362,"en":"When he heard Chubak's voice,"},{"id":"semetey-1-2013:p0436:b004:l028","ordinal":110363,"en":"He too entered—did you see?—"},{"id":"semetey-1-2013:p0436:b004:l029","ordinal":110364,"en":"Shouting 'Manas!' as his battle cry."},{"id":"semetey-1-2013:p0436:b004:l030","ordinal":110365,"en":"Khan Manas's forty companions,"},{"id":"semetey-1-2013:p0436:b004:l031","ordinal":110366,"en":"All of them roaring,"},{"id":"semetey-1-2013:p0436:b004:l032","ordinal":110367,"en":"Entered the battle together,"},{"id":"semetey-1-2013:p0436:b004:l033","ordinal":110368,"en":"All shouting 'Manas!' as their battle cry."},{"id":"semetey-1-2013:p0436:b004:l034","ordinal":110369,"en":"Earth flew in streaming clouds."},{"id":"semetey-1-2013:p0436:b004:l035","ordinal":110370,"en":"Never shrinking from death,"},{"id":"semetey-1-2013:p0436:b004:l036","ordinal":110371,"en":"Manas and the forty companions"},{"id":"semetey-1-2013:p0436:b004:l037","ordinal":110372,"en":"Joined together at that very moment."},{"id":"semetey-1-2013:p0436:b004:l038","ordinal":110373,"en":"Drenched in dark blood,"},{"id":"semetey-1-2013:p0436:b004:l039","ordinal":110374,"en":"Those leopard-born warriors"},{"id":"semetey-1-2013:p0437:b003:l001","ordinal":110375,"en":"Fought without retreating."},{"id":"semetey-1-2013:p0437:b003:l002","ordinal":110376,"en":"Grasping spears, breaking ranks,"},{"id":"semetey-1-2013:p0437:b003:l003","ordinal":110377,"en":"Mortals whose hour had come fell to bullets."},{"id":"semetey-1-2013:p0437:b003:l004","ordinal":110378,"en":"They saw the great dug trench,"},{"id":"semetey-1-2013:p0437:b003:l005","ordinal":110379,"en":"Facing the misery already boiled,"},{"id":"semetey-1-2013:p0437:b003:l006","ordinal":110380,"en":"Your Kyrgyz and Argyn in Talas"},{"id":"semetey-1-2013:p0437:b003:l007","ordinal":110381,"en":"Were terribly hard pressed."},{"id":"semetey-1-2013:p0437:b003:l008","ordinal":110382,"en":"Your fortunate father was a lion."},{"id":"semetey-1-2013:p0437:b003:l009","ordinal":110383,"en":"Your father, across many lands,"},{"id":"semetey-1-2013:p0437:b003:l010","ordinal":110384,"en":"Was a hero who laid them waste."},{"id":"semetey-1-2013:p0437:b003:l011","ordinal":110385,"en":"When the mighty men came to hand,"},{"id":"semetey-1-2013:p0437:b003:l012","ordinal":110386,"en":"When his precious Chubak the lion"},{"id":"semetey-1-2013:p0437:b003:l013","ordinal":110387,"en":"Was known to have arrived,"},{"id":"semetey-1-2013:p0437:b003:l014","ordinal":110388,"en":"The gray cartridge belt fallen from heaven"},{"id":"semetey-1-2013:p0437:b003:l015","ordinal":110389,"en":"He fitted closely round his neck,"},{"id":"semetey-1-2013:p0437:b003:l016","ordinal":110390,"en":"And to the sole Creator, Jabbar,"},{"id":"semetey-1-2013:p0437:b003:l017","ordinal":110391,"en":"Your father then prayed."},{"id":"semetey-1-2013:p0437:b003:l018","ordinal":110392,"en":"Upon your khan father,"},{"id":"semetey-1-2013:p0437:b003:l019","ordinal":110393,"en":"Kongurbay, son of Alooke,"},{"id":"semetey-1-2013:p0437:b003:l020","ordinal":110394,"en":"With countless hosts upon hosts,"},{"id":"semetey-1-2013:p0437:b003:l021","ordinal":110395,"en":"Rushed in once again."},{"id":"semetey-1-2013:p0437:b003:l022","ordinal":110396,"en":"Brandishing his little axe,"},{"id":"semetey-1-2013:p0437:b003:l023","ordinal":110397,"en":"That splendid Kalcha"},{"id":"semetey-1-2013:p0437:b003:l024","ordinal":110398,"en":"Lumbered forward in fury,"},{"id":"semetey-1-2013:p0437:b003:l025","ordinal":110399,"en":"As though his runaway were escaping nearby,"},{"id":"semetey-1-2013:p0437:b003:l026","ordinal":110400,"en":"He was in a frantic flurry,"},{"id":"semetey-1-2013:p0437:b003:l027","ordinal":110401,"en":"As though an evil spirit had seized his wife,"},{"id":"semetey-1-2013:p0437:b003:l028","ordinal":110402,"en":"As though his pursuers were close behind,"},{"id":"semetey-1-2013:p0437:b003:l029","ordinal":110403,"en":"He was all in confusion,"},{"id":"semetey-1-2013:p0437:b003:l030","ordinal":110404,"en":"As though his wife had borne a son."},{"id":"semetey-1-2013:p0437:b003:l031","ordinal":110405,"en":"He lunged forward on Algara,"},{"id":"semetey-1-2013:p0437:b003:l032","ordinal":110406,"en":"Heaving as though her husband had died."},{"id":"semetey-1-2013:p0437:b003:l033","ordinal":110407,"en":"His spectacles gleamed,"},{"id":"semetey-1-2013:p0437:b003:l034","ordinal":110408,"en":"And a coral stone as large as a flask"},{"id":"semetey-1-2013:p0437:b003:l035","ordinal":110409,"en":"Glittered upon his crown."},{"id":"semetey-1-2013:p0437:b003:l036","ordinal":110410,"en":"His stirrup leathers flapped,"},{"id":"semetey-1-2013:p0437:b003:l037","ordinal":110411,"en":"His black hair braided like a mallet,"},{"id":"semetey-1-2013:p0437:b003:l038","ordinal":110412,"en":"His forelock hanging behind"},{"id":"semetey-1-2013:p0437:b003:l039","ordinal":110413,"en":"Swung upon his nape."},{"id":"semetey-1-2013:p0437:b004:l001","ordinal":110414,"en":"When his anger truly rose,"},{"id":"semetey-1-2013:p0437:b004:l002","ordinal":110415,"en":"His bristling mustache"},{"id":"semetey-1-2013:p0437:b004:l003","ordinal":110416,"en":"Looked like a battle-axe handle."},{"id":"semetey-1-2013:p0437:b004:l004","ordinal":110417,"en":"His ridged nose, remarkable in itself,"},{"id":"semetey-1-2013:p0437:b004:l005","ordinal":110418,"en":"Looked like a sword's sheath."},{"id":"semetey-1-2013:p0437:b004:l006","ordinal":110419,"en":"The space between his brows"},{"id":"semetey-1-2013:p0437:b004:l007","ordinal":110420,"en":"Resembled an open grave."},{"id":"semetey-1-2013:p0437:b004:l008","ordinal":110421,"en":"If you looked at his broad forehead,"},{"id":"semetey-1-2013:p0437:b004:l009","ordinal":110422,"en":"It resembled a rich man's high pasture."},{"id":"semetey-1-2013:p0437:b004:l010","ordinal":110423,"en":"Shouting with forty lords,"},{"id":"semetey-1-2013:p0437:b004:l011","ordinal":110424,"en":"He too cried 'Mondu!' as his battle cry."},{"id":"semetey-1-2013:p0437:b004:l012","ordinal":110425,"en":"Striking Algara upon the thigh,"},{"id":"semetey-1-2013:p0437:b004:l013","ordinal":110426,"en":"At your fierce father Manas"},{"id":"semetey-1-2013:p0437:b004:l014","ordinal":110427,"en":"He too charged without flinching."},{"id":"semetey-1-2013:p0437:b004:l015","ordinal":110428,"en":"The wrestlers of forty Chinese tribes"},{"id":"semetey-1-2013:p0437:b004:l016","ordinal":110429,"en":"Your father, now gone to Judgment,"},{"id":"semetey-1-2013:p0437:b004:l017","ordinal":110430,"en":"Took into their midst."},{"id":"semetey-1-2013:p0437:b004:l018","ordinal":110431,"en":"Your father stood majestic, unconcerned."},{"id":"semetey-1-2013:p0437:b004:l019","ordinal":110432,"en":"Though eighty spears struck at once,"},{"id":"semetey-1-2013:p0437:b004:l020","ordinal":110433,"en":"Your father, the renowned one,"},{"id":"semetey-1-2013:p0437:b004:l021","ordinal":110434,"en":"He deemed it worth less than his trouser hem."},{"id":"semetey-1-2013:p0437:b004:l022","ordinal":110435,"en":"Kongurbay, son of Alooke,"},{"id":"semetey-1-2013:p0437:b004:l023","ordinal":110436,"en":"Against your fierce father Manas"},{"id":"semetey-1-2013:p0437:b004:l024","ordinal":110437,"en":"Displayed immeasurable courage."},{"id":"semetey-1-2013:p0437:b004:l025","ordinal":110438,"en":"That Chinese man from Beijing—"},{"id":"semetey-1-2013:p0437:b004:l026","ordinal":110439,"en":"Did you see what a hero he was?"},{"id":"semetey-1-2013:p0437:b004:l027","ordinal":110440,"en":"From emperor-ruled Beijing,"},{"id":"semetey-1-2013:p0437:b004:l028","ordinal":110441,"en":"Kongurbay, son of Alooke—"},{"id":"semetey-1-2013:p0437:b004:l029","ordinal":110442,"en":"Ah, his voice could frighten souls away."},{"id":"semetey-1-2013:p0437:b004:l030","ordinal":110443,"en":"A glowing ember born from the hearth,"},{"id":"semetey-1-2013:p0437:b004:l031","ordinal":110444,"en":"In the renowned city of Beijing"},{"id":"semetey-1-2013:p0437:b004:l032","ordinal":110445,"en":"A mighty one named Kongurbay was born."},{"id":"semetey-1-2013:p0437:b004:l033","ordinal":110446,"en":"When he reached six years of age,"},{"id":"semetey-1-2013:p0437:b004:l034","ordinal":110447,"en":"He stirred up trouble for the emperor."},{"id":"semetey-1-2013:p0437:b004:l035","ordinal":110448,"en":"Unable to bear his wrath,"},{"id":"semetey-1-2013:p0437:b004:l036","ordinal":110449,"en":"Great Beijing, where the unbelievers dwelt,"},{"id":"semetey-1-2013:p0437:b004:l037","ordinal":110450,"en":"Nearly fell into ruin."},{"id":"semetey-1-2013:p0437:b004:l038","ordinal":110451,"en":"When he reached eight years of age,"},{"id":"semetey-1-2013:p0437:b004:l039","ordinal":110452,"en":"He besieged the people of Beijing,"},{"id":"semetey-1-2013:p0438:b003:l001","ordinal":110453,"en":"When he reached nine,"},{"id":"semetey-1-2013:p0438:b003:l002","ordinal":110454,"en":"Among the stone-adorned Chinese"},{"id":"semetey-1-2013:p0438:b003:l003","ordinal":110455,"en":"He beat their bald-headed men."},{"id":"semetey-1-2013:p0438:b003:l004","ordinal":110456,"en":"Unable to bear his wrath,"},{"id":"semetey-1-2013:p0438:b003:l005","ordinal":110457,"en":"The city of Beijing grew weary."},{"id":"semetey-1-2013:p0438:b003:l006","ordinal":110458,"en":"When he reached twelve,"},{"id":"semetey-1-2013:p0438:b003:l007","ordinal":110459,"en":"Wearing a golden crown*"},{"id":"semetey-1-2013:p0438:b003:l008","ordinal":110460,"en":"They seated him on a golden throne."},{"id":"semetey-1-2013:p0438:b003:l009","ordinal":110461,"en":"Of that great Beijing,"},{"id":"semetey-1-2013:p0438:b003:l010","ordinal":110462,"en":"They proclaimed him the great khan,"},{"id":"semetey-1-2013:p0438:b003:l011","ordinal":110463,"en":"And made him a wall built on a mountain slope."},{"id":"semetey-1-2013:p0438:b003:l012","ordinal":110464,"en":"To bar your generous father's way,"},{"id":"semetey-1-2013:p0438:b003:l013","ordinal":110465,"en":"They made him a mighty khan of the monks."},{"id":"semetey-1-2013:p0438:b003:l014","ordinal":110466,"en":"If you ask about Kongurbay,"},{"id":"semetey-1-2013:p0438:b003:l015","ordinal":110467,"en":"His ox grew old and he himself died;"},{"id":"semetey-1-2013:p0438:b003:l016","ordinal":110468,"en":"His custom when someone died"},{"id":"semetey-1-2013:p0438:b003:l017","ordinal":110469,"en":"Was to divide the dead man's livestock equally."},{"id":"semetey-1-2013:p0438:b003:l018","ordinal":110470,"en":"He consecrated his castrated goat,"},{"id":"semetey-1-2013:p0438:b003:l019","ordinal":110471,"en":"And the horse he rode was sacred."},{"id":"semetey-1-2013:p0438:b003:l020","ordinal":110472,"en":"The custom he practiced"},{"id":"semetey-1-2013:p0438:b003:l021","ordinal":110473,"en":"Was to keep apart from women."},{"id":"semetey-1-2013:p0438:b003:l022","ordinal":110474,"en":"He wore mottled red;"},{"id":"semetey-1-2013:p0438:b003:l023","ordinal":110475,"en":"That unbeliever's practice"},{"id":"semetey-1-2013:p0438:b003:l024","ordinal":110476,"en":"Was to rejoice if one became a lama."},{"id":"semetey-1-2013:p0438:b003:l025","ordinal":110477,"en":"He did not squat to urinate;"},{"id":"semetey-1-2013:p0438:b003:l026","ordinal":110478,"en":"His robe's hem did not touch the ground."},{"id":"semetey-1-2013:p0438:b003:l027","ordinal":110479,"en":"Of Allah Most High, the One,"},{"id":"semetey-1-2013:p0438:b003:l028","ordinal":110480,"en":"He did not know the true oneness."},{"id":"semetey-1-2013:p0438:b003:l029","ordinal":110481,"en":"He saddled his unbroken horse,"},{"id":"semetey-1-2013:p0438:b003:l030","ordinal":110482,"en":"And a great bronze idol"},{"id":"semetey-1-2013:p0438:b003:l031","ordinal":110483,"en":"He hung and tied up, calling it God,"},{"id":"semetey-1-2013:p0438:b003:l032","ordinal":110484,"en":"And bowed in worship before it."},{"id":"semetey-1-2013:p0438:b003:l033","ordinal":110485,"en":"Kongurbay, khan of the monks,"},{"id":"semetey-1-2013:p0438:b003:l034","ordinal":110486,"en":"That massive boar—"},{"id":"semetey-1-2013:p0438:b003:l035","ordinal":110487,"en":"When Chinese as numerous as the earth"},{"id":"semetey-1-2013:p0438:b003:l036","ordinal":110488,"en":"Came swarming in,"},{"id":"semetey-1-2013:p0438:b003:l037","ordinal":110489,"en":"Hiding the ground, around your father"},{"id":"semetey-1-2013:p0438:b003:l038","ordinal":110490,"en":"They formed a ring."},{"id":"semetey-1-2013:p0438:b003:l039","ordinal":110491,"en":"Chubak, son of Akbaltay,"},{"id":"semetey-1-2013:p0438:b004:l001","ordinal":110492,"en":"Said, 'If suffering comes, I shall bear it;"},{"id":"semetey-1-2013:p0438:b004:l002","ordinal":110493,"en":"If my death comes, I shall die."},{"id":"semetey-1-2013:p0438:b004:l003","ordinal":110494,"en":"My sole friend to the next world,"},{"id":"semetey-1-2013:p0438:b004:l004","ordinal":110495,"en":"This Manas before me,"},{"id":"semetey-1-2013:p0438:b004:l005","ordinal":110496,"en":"I shall stand at his side.'"},{"id":"semetey-1-2013:p0438:b004:l006","ordinal":110497,"en":"Chubak, son of Akbaltay,"},{"id":"semetey-1-2013:p0438:b004:l007","ordinal":110498,"en":"That unruly scourge of the world,"},{"id":"semetey-1-2013:p0438:b004:l008","ordinal":110499,"en":"Entered the battle openly."},{"id":"semetey-1-2013:p0438:b004:l009","ordinal":110500,"en":"No sooner had that happened,"},{"id":"semetey-1-2013:p0438:b004:l010","ordinal":110501,"en":"Before an eye could open and close,"},{"id":"semetey-1-2013:p0438:b004:l011","ordinal":110502,"en":"Before one could say this or that,"},{"id":"semetey-1-2013:p0438:b004:l012","ordinal":110503,"en":"With golden forelock and tasselled sash,"},{"id":"semetey-1-2013:p0438:b004:l013","ordinal":110504,"en":"Khan Azyz's only son,"},{"id":"semetey-1-2013:p0438:b004:l014","ordinal":110505,"en":"Our Alake entered the battle."},{"id":"semetey-1-2013:p0438:b004:l015","ordinal":110506,"en":"The excellent hero Bakay,"},{"id":"semetey-1-2013:p0438:b004:l016","ordinal":110507,"en":"Wearing a blue-lynx fur cap,"},{"id":"semetey-1-2013:p0438:b004:l017","ordinal":110508,"en":"Flourishing a blue-mottled shield,"},{"id":"semetey-1-2013:p0438:b004:l018","ordinal":110509,"en":"Entered the battle again."},{"id":"semetey-1-2013:p0438:b004:l019","ordinal":110510,"en":"His black-capped support,"},{"id":"semetey-1-2013:p0438:b004:l020","ordinal":110511,"en":"Khan Manas's Syrgak,"},{"id":"semetey-1-2013:p0438:b004:l021","ordinal":110512,"en":"Entered the battle with them."},{"id":"semetey-1-2013:p0438:b004:l022","ordinal":110513,"en":"Argyn Khan's Ajybay"},{"id":"semetey-1-2013:p0438:b004:l023","ordinal":110514,"en":"Entered the battle too."},{"id":"semetey-1-2013:p0438:b004:l024","ordinal":110515,"en":"Yraman's son, the Singer,"},{"id":"semetey-1-2013:p0438:b004:l025","ordinal":110516,"en":"Hero Shuutu, with a cap like a yurt's roof felt,"},{"id":"semetey-1-2013:p0438:b004:l026","ordinal":110517,"en":"Khan Tomon's diviner,"},{"id":"semetey-1-2013:p0438:b004:l027","ordinal":110518,"en":"Manas's darling called Baychoro,"},{"id":"semetey-1-2013:p0438:b004:l028","ordinal":110519,"en":"Seregi, who sprang into action,"},{"id":"semetey-1-2013:p0438:b004:l029","ordinal":110520,"en":"Needed by Manas's fleeting life,"},{"id":"semetey-1-2013:p0438:b004:l030","ordinal":110521,"en":"His capable companion Bozuul,"},{"id":"semetey-1-2013:p0438:b004:l031","ordinal":110522,"en":"Aykojo in a mottled robe—"},{"id":"semetey-1-2013:p0438:b004:l032","ordinal":110523,"en":"The mullah whom Manas took along,"},{"id":"semetey-1-2013:p0438:b004:l034","ordinal":110524,"en":"Adysh with his forked beard—"},{"id":"semetey-1-2013:p0438:b004:l035","ordinal":110525,"en":"Forty spears extended from forty sides,"},{"id":"semetey-1-2013:p0438:b004:l036","ordinal":110526,"en":"All of them toward Manas."},{"id":"semetey-1-2013:p0438:b004:l037","ordinal":110527,"en":"Looking, one could not catch sight of them."},{"id":"semetey-1-2013:p0438:b004:l038","ordinal":110528,"en":"God, do not let us see such a sight!"},{"id":"semetey-1-2013:p0438:b004:l039","ordinal":110529,"en":"One could not tell who was who!"},{"id":"semetey-1-2013:p0439:b003:l001","ordinal":110530,"en":"The sky was clear, the earth obscured;"},{"id":"semetey-1-2013:p0439:b003:l002","ordinal":110531,"en":"The great battle brought slaughter."},{"id":"semetey-1-2013:p0439:b003:l003","ordinal":110532,"en":"Those whose appointed death came"},{"id":"semetey-1-2013:p0439:b003:l004","ordinal":110533,"en":"Were struck in the brow by battle-axes."},{"id":"semetey-1-2013:p0439:b003:l005","ordinal":110534,"en":"The weak, powerless, without courage"},{"id":"semetey-1-2013:p0439:b003:l006","ordinal":110535,"en":"Were setting out for Mecca."},{"id":"semetey-1-2013:p0439:b003:l007","ordinal":110536,"en":"Once the battle became a melee,"},{"id":"semetey-1-2013:p0439:b003:l008","ordinal":110537,"en":"The heroes separated into their own group,"},{"id":"semetey-1-2013:p0439:b003:l009","ordinal":110538,"en":"Their blood shed in suffering,"},{"id":"semetey-1-2013:p0439:b003:l010","ordinal":110539,"en":"The lions separated into their own group,"},{"id":"semetey-1-2013:p0439:b003:l011","ordinal":110540,"en":"The weak saw death before them,"},{"id":"semetey-1-2013:p0439:b003:l012","ordinal":110541,"en":"The skillful spearmen died,"},{"id":"semetey-1-2013:p0439:b003:l013","ordinal":110542,"en":"Many fine warriors died in the clash."},{"id":"semetey-1-2013:p0439:b003:l014","ordinal":110543,"en":"Kongurbay's black horse—"},{"id":"semetey-1-2013:p0439:b003:l015","ordinal":110544,"en":"I wonder, did that black horse have"},{"id":"semetey-1-2013:p0439:b003:l016","ordinal":110545,"en":"Wings upon its flanks?"},{"id":"semetey-1-2013:p0439:b003:l017","ordinal":110546,"en":"That slave, skilled among spearmen,"},{"id":"semetey-1-2013:p0439:b003:l018","ordinal":110547,"en":"Would always make the whole world"},{"id":"semetey-1-2013:p0439:b003:l019","ordinal":110548,"en":"Like a stirred mash of roasted flour."},{"id":"semetey-1-2013:p0439:b003:l020","ordinal":110549,"en":"As though mixing roasted flour,"},{"id":"semetey-1-2013:p0439:b003:l021","ordinal":110550,"en":"Without distinction between Muslim and unbeliever,"},{"id":"semetey-1-2013:p0439:b003:l022","ordinal":110551,"en":"Earth swarmed and dust flew,"},{"id":"semetey-1-2013:p0439:b003:l023","ordinal":110552,"en":"Not one blade was visible on the ground."},{"id":"semetey-1-2013:p0439:b003:l024","ordinal":110553,"en":"With their waists firmly girded,"},{"id":"semetey-1-2013:p0439:b003:l025","ordinal":110554,"en":"Your leopard father and hero Chubak,"},{"id":"semetey-1-2013:p0439:b003:l026","ordinal":110555,"en":"With elder Bakay among them,"},{"id":"semetey-1-2013:p0439:b003:l027","ordinal":110556,"en":"Attacked, plunging in alone."},{"id":"semetey-1-2013:p0439:b003:l028","ordinal":110557,"en":"As they wheeled and wheeled about,"},{"id":"semetey-1-2013:p0439:b003:l029","ordinal":110558,"en":"Twelve Manchus died at once."},{"id":"semetey-1-2013:p0439:b003:l030","ordinal":110559,"en":"Does not a mortal whose time has come die?"},{"id":"semetey-1-2013:p0439:b003:l031","ordinal":110560,"en":"Who has seen such a marvel?"},{"id":"semetey-1-2013:p0439:b003:l032","ordinal":110561,"en":"Seven banners and a red standard,"},{"id":"semetey-1-2013:p0439:b003:l033","ordinal":110562,"en":"Amid the great slaughter,"},{"id":"semetey-1-2013:p0439:b003:l034","ordinal":110563,"en":"Wild shouts and uproar,"},{"id":"semetey-1-2013:p0439:b003:l035","ordinal":110564,"en":"The thunder of the drum—"},{"id":"semetey-1-2013:p0439:b003:l036","ordinal":110565,"en":"It became a battle like no other."},{"id":"semetey-1-2013:p0439:b003:l037","ordinal":110566,"en":"Guns cracked loudly."},{"id":"semetey-1-2013:p0439:b003:l038","ordinal":110567,"en":"When heroes faced one another with spears,"},{"id":"semetey-1-2013:p0439:b003:l039","ordinal":110568,"en":"Their spears snapped with a crash,"},{"id":"semetey-1-2013:p0439:b004:l001","ordinal":110569,"en":"Swords shattered, clanging,"},{"id":"semetey-1-2013:p0439:b004:l002","ordinal":110570,"en":"And the heads of the battle-axes"},{"id":"semetey-1-2013:p0439:b004:l003","ordinal":110571,"en":"Flew screaming from their shafts."},{"id":"semetey-1-2013:p0439:b004:l004","ordinal":110572,"en":"Besieging Talas, stirring strife,"},{"id":"semetey-1-2013:p0439:b004:l005","ordinal":110573,"en":"Because of Khan Chubak's letter,"},{"id":"semetey-1-2013:p0439:b004:l006","ordinal":110574,"en":"Because of Kyrgylchal's obstruction,"},{"id":"semetey-1-2013:p0439:b004:l007","ordinal":110575,"en":"Many horses among the beasts died,"},{"id":"semetey-1-2013:p0439:b004:l008","ordinal":110576,"en":"Many humans died swiftly."},{"id":"semetey-1-2013:p0439:b004:l009","ordinal":110577,"en":"They stood through days and nights,"},{"id":"semetey-1-2013:p0439:b004:l010","ordinal":110578,"en":"Fighting seven days without pause."},{"id":"semetey-1-2013:p0439:b004:l011","ordinal":110579,"en":"Ill-natured Kongurbay—"},{"id":"semetey-1-2013:p0439:b004:l012","ordinal":110580,"en":"The cruelty he had inflicted on Talas,"},{"id":"semetey-1-2013:p0439:b004:l013","ordinal":110581,"en":"Saying, 'I shall raid and seize the Kyrgyz,'"},{"id":"semetey-1-2013:p0439:b004:l014","ordinal":110582,"en":"The violence he had inflicted on many."},{"id":"semetey-1-2013:p0439:b004:l015","ordinal":110583,"en":"Eighty thousand warriors, countless officers,"},{"id":"semetey-1-2013:p0439:b004:l016","ordinal":110584,"en":"Kongurbay, the enemy's foremost hero—"},{"id":"semetey-1-2013:p0439:b004:l017","ordinal":110585,"en":"They turned their rhinoceroses' heads,"},{"id":"semetey-1-2013:p0439:b004:l018","ordinal":110586,"en":"And fought, aiming at one another."},{"id":"semetey-1-2013:p0439:b004:l019","ordinal":110587,"en":"Within that battle,"},{"id":"semetey-1-2013:p0439:b004:l020","ordinal":110588,"en":"He who had fled the dark and become estranged,"},{"id":"semetey-1-2013:p0439:b004:l021","ordinal":110589,"en":"Who had become pure from the dark faith,"},{"id":"semetey-1-2013:p0439:b004:l022","ordinal":110590,"en":"Whose amassed wealth remained in Beijing,"},{"id":"semetey-1-2013:p0439:b004:l023","ordinal":110591,"en":"His faith and belief that held sway,"},{"id":"semetey-1-2013:p0439:b004:l024","ordinal":110592,"en":"Whose amassed wealth remained with the emperor,"}]
