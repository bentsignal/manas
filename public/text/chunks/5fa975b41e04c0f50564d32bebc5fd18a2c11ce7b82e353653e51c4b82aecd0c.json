[{"id":"manas-2010:p1630:b001:l022","ordinal":70145,"en":"The best at wielding swords"},{"id":"manas-2010:p1630:b001:l023","ordinal":70146,"en":"He separated into a band."},{"id":"manas-2010:p1630:b001:l024","ordinal":70147,"en":"The most skilled among the lancers"},{"id":"manas-2010:p1630:b001:l025","ordinal":70148,"en":"He drove to the front."},{"id":"manas-2010:p1630:b001:l026","ordinal":70149,"en":"Skilled horsemen and swift foot-runners,"},{"id":"manas-2010:p1630:b001:l027","ordinal":70150,"en":"Not sparing their lives at all,"},{"id":"manas-2010:p1630:b001:l028","ordinal":70151,"en":"They too swept forward."},{"id":"manas-2010:p1630:b001:l029","ordinal":70152,"en":"The earth turned and shook."},{"id":"manas-2010:p1630:b001:l030","ordinal":70153,"en":"At that moment Kongurbay"},{"id":"manas-2010:p1630:b001:l031","ordinal":70154,"en":"Had many ilek of troops."},{"id":"manas-2010:p1630:b001:l032","ordinal":70155,"en":"Clan after clan of people had come."},{"id":"manas-2010:p1630:b001:l033","ordinal":70156,"en":"As though Kalcha were not enough,"},{"id":"manas-2010:p1630:b001:l034","ordinal":70157,"en":"A man named Kanzharkol had come."},{"id":"manas-2010:p1630:b001:l035","ordinal":70158,"en":"His tread raised dust;"},{"id":"manas-2010:p1630:b001:l036","ordinal":70159,"en":"His voice drove out men’s souls."},{"id":"manas-2010:p1630:b001:l037","ordinal":70160,"en":"The dear Chinese people of forty tribes—"},{"id":"manas-2010:p1630:b001:l038","ordinal":70161,"en":"A mighty champion had risen among them."},{"id":"manas-2010:p1630:b001:l039","ordinal":70162,"en":"The sky was clear, the earth overcast;"},{"id":"manas-2010:p1630:b001:l040","ordinal":70163,"en":"Not a speck of ground could be seen."},{"id":"manas-2010:p1630:b001:l041","ordinal":70164,"en":"When the Chinese surged in disorder,"},{"id":"manas-2010:p1630:b001:l042","ordinal":70165,"en":"They loomed in hazy angles,"},{"id":"manas-2010:p1631:b001:l001","ordinal":70166,"en":"Rose in murky points."},{"id":"manas-2010:p1631:b001:l002","ordinal":70167,"en":"Beijing was a land beyond measure;"},{"id":"manas-2010:p1631:b001:l003","ordinal":70168,"en":"The Chinese were a people with armies."},{"id":"manas-2010:p1631:b001:l004","ordinal":70169,"en":"When their fury rose,"},{"id":"manas-2010:p1631:b001:l005","ordinal":70170,"en":"They were a flood that would engulf all."},{"id":"manas-2010:p1631:b001:l006","ordinal":70171,"en":"The Flood had never rushed into it;"},{"id":"manas-2010:p1631:b001:l007","ordinal":70172,"en":"They were the surging Chinese people."},{"id":"manas-2010:p1631:b001:l008","ordinal":70173,"en":"Alöökö’s Kongurbay"},{"id":"manas-2010:p1631:b001:l009","ordinal":70174,"en":"Chubak above all"},{"id":"manas-2010:p1631:b001:l010","ordinal":70175,"en":"Was watching at that time."},{"id":"manas-2010:p1631:b001:l011","ordinal":70176,"en":"At that moment, that man—"},{"id":"manas-2010:p1631:b001:l012","ordinal":70177,"en":"Khan Baltay’s Chubak,"},{"id":"manas-2010:p1631:b001:l013","ordinal":70178,"en":"Whipping Kögala,"},{"id":"manas-2010:p1631:b001:l014","ordinal":70179,"en":"Girding his waist securely,"},{"id":"manas-2010:p1631:b001:l015","ordinal":70180,"en":"Grim with rage,"},{"id":"manas-2010:p1631:b001:l016","ordinal":70181,"en":"Without sparing his dear life,"},{"id":"manas-2010:p1631:b001:l017","ordinal":70182,"en":"Reached Khan Kanzharkol."},{"id":"manas-2010:p1631:b001:l018","ordinal":70183,"en":"Their champion Kanzharkol,"},{"id":"manas-2010:p1631:b001:l019","ordinal":70184,"en":"Your Chubak, as soon as he reached him,"},{"id":"manas-2010:p1631:b001:l020","ordinal":70185,"en":"Knocked flat and swept past."},{"id":"manas-2010:p1631:b001:l021","ordinal":70186,"en":"Before a champion named Ayba"},{"id":"manas-2010:p1631:b001:l022","ordinal":70187,"en":"Could lift him onto his horse,"},{"id":"manas-2010:p1631:b001:l023","ordinal":70188,"en":"Argynkan’s Azhybay"},{"id":"manas-2010:p1631:b001:l024","ordinal":70189,"en":"Cut off his head and went on."},{"id":"manas-2010:p1631:b001:l025","ordinal":70190,"en":"When Kanzharkol died,"},{"id":"manas-2010:p1631:b001:l026","ordinal":70191,"en":"The commanders of ten bobbed along,"},{"id":"manas-2010:p1631:b001:l027","ordinal":70192,"en":"The commanders of fifty stood out tall,"},{"id":"manas-2010:p1631:b001:l028","ordinal":70193,"en":"Their warriors thronged,"},{"id":"manas-2010:p1631:b001:l029","ordinal":70194,"en":"Their lances swayed."},{"id":"manas-2010:p1631:b001:l030","ordinal":70195,"en":"Fire flashed from his eyes;"},{"id":"manas-2010:p1631:b001:l031","ordinal":70196,"en":"Wind came from his mouth;"},{"id":"manas-2010:p1631:b001:l032","ordinal":70197,"en":"His sword rang in its sheath;"},{"id":"manas-2010:p1631:b001:l033","ordinal":70198,"en":"His battle-axe jingled in his hand."},{"id":"manas-2010:p1631:b001:l034","ordinal":70199,"en":"With cotton sash and broad boots,"},{"id":"manas-2010:p1631:b001:l035","ordinal":70200,"en":"Kongurbay, khan of the shaven ones,"},{"id":"manas-2010:p1631:b001:l036","ordinal":70201,"en":"His roar splitting stone,"},{"id":"manas-2010:p1631:b001:l037","ordinal":70202,"en":"His shout splitting heads,"},{"id":"manas-2010:p1631:b001:l038","ordinal":70203,"en":"As though a demon had seized his wife,"},{"id":"manas-2010:p1631:b001:l039","ordinal":70204,"en":"As though his quarry had just escaped,"},{"id":"manas-2010:p1631:b001:l040","ordinal":70205,"en":"His eyes blazing wide,"},{"id":"manas-2010:p1631:b001:l041","ordinal":70206,"en":"Venom pouring from his mouth,"},{"id":"manas-2010:p1631:b001:l042","ordinal":70207,"en":"At Chubak, who had lanced Kanzhar,"},{"id":"manas-2010:p1632:b001:l001","ordinal":70208,"en":"Kongurbay charged."},{"id":"manas-2010:p1632:b001:l002","ordinal":70209,"en":"Looming like a dragon,"},{"id":"manas-2010:p1632:b001:l003","ordinal":70210,"en":"Making the earth split and rumble,"},{"id":"manas-2010:p1632:b001:l004","ordinal":70211,"en":"He took his pointed lance in hand,"},{"id":"manas-2010:p1632:b001:l005","ordinal":70212,"en":"Whipped Algara,"},{"id":"manas-2010:p1632:b001:l006","ordinal":70213,"en":"And that dog came right up thundering."},{"id":"manas-2010:p1632:b001:l007","ordinal":70214,"en":"He arrived ahead of an arrow;"},{"id":"manas-2010:p1632:b001:l008","ordinal":70215,"en":"From atop Kögala,"},{"id":"manas-2010:p1632:b001:l009","ordinal":70216,"en":"Chubak, as soon as he reached him,"},{"id":"manas-2010:p1632:b001:l010","ordinal":70217,"en":"He knocked flat and swept past."},{"id":"manas-2010:p1632:b001:l011","ordinal":70218,"en":"He did that terrible thing;"},{"id":"manas-2010:p1632:b001:l012","ordinal":70219,"en":"“Bind him alive!”"},{"id":"manas-2010:p1632:b001:l013","ordinal":70220,"en":"He commanded his people."},{"id":"manas-2010:p1632:b001:l014","ordinal":70221,"en":"When Chubak fell from his horse,"},{"id":"manas-2010:p1632:b001:l015","ordinal":70222,"en":"Six thousand governors, a san of champions,"},{"id":"manas-2010:p1632:b001:l016","ordinal":70223,"en":"Skilled against every foe—"},{"id":"manas-2010:p1632:b001:l017","ordinal":70224,"en":"Kongurbay, elder of the enemy,"},{"id":"manas-2010:p1632:b001:l018","ordinal":70225,"en":"Raised his voice in a shout."},{"id":"manas-2010:p1632:b001:l019","ordinal":70226,"en":"The massed Chinese, the many Manchus,"},{"id":"manas-2010:p1632:b001:l020","ordinal":70227,"en":"All came swarming over Chubak!"},{"id":"manas-2010:p1632:b001:l021","ordinal":70228,"en":"The Chinese ran in throngs."},{"id":"manas-2010:p1632:b001:l022","ordinal":70229,"en":"When the Chinese pressed him,"},{"id":"manas-2010:p1632:b001:l023","ordinal":70230,"en":"The poor bastard despaired of life."},{"id":"manas-2010:p1632:b001:l024","ordinal":70231,"en":"“When the moon is dark,"},{"id":"manas-2010:p1632:b001:l025","ordinal":70232,"en":"Such is the night,” he said."},{"id":"manas-2010:p1632:b001:l026","ordinal":70233,"en":"“When death is laid upon one’s head,"},{"id":"manas-2010:p1632:b001:l027","ordinal":70234,"en":"God, such is the day!” he said."},{"id":"manas-2010:p1632:b001:l028","ordinal":70235,"en":"The grudge from striking the governor swelled;"},{"id":"manas-2010:p1632:b001:l029","ordinal":70236,"en":"Your Chubak stood looking,"},{"id":"manas-2010:p1632:b001:l030","ordinal":70237,"en":"His heart burning bitterly:"},{"id":"manas-2010:p1632:b001:l031","ordinal":70238,"en":"“Will the massed Chinese and many Manchus"},{"id":"manas-2010:p1632:b001:l032","ordinal":70239,"en":"Capture me alive?"},{"id":"manas-2010:p1632:b001:l033","ordinal":70240,"en":"Khan Baltay’s Chubak—"},{"id":"manas-2010:p1632:b001:l034","ordinal":70241,"en":"Just because the Chinese wish it,"},{"id":"manas-2010:p1632:b001:l035","ordinal":70242,"en":"Will he fall into their hands?!”"},{"id":"manas-2010:p1632:b001:l036","ordinal":70243,"en":"His knees bent to the earth;"},{"id":"manas-2010:p1632:b001:l037","ordinal":70244,"en":"As your Chubak stared, he despaired of life."},{"id":"manas-2010:p1632:b001:l038","ordinal":70245,"en":"The earth turned to dust;"},{"id":"manas-2010:p1632:b001:l039","ordinal":70246,"en":"Seventy Beijings rose in motion."},{"id":"manas-2010:p1632:b001:l040","ordinal":70247,"en":"Their champions made ready"},{"id":"manas-2010:p1632:b001:l041","ordinal":70248,"en":"And ran with clubs in hand."},{"id":"manas-2010:p1632:b001:l042","ordinal":70249,"en":"Then your fierce Chubak"},{"id":"manas-2010:p1633:b001:l001","ordinal":70250,"en":"Despaired utterly of life."},{"id":"manas-2010:p1633:b001:l002","ordinal":70251,"en":"Swarming with lassos,"},{"id":"manas-2010:p1633:b001:l003","ordinal":70252,"en":"All the swift foot-runners"},{"id":"manas-2010:p1633:b001:l004","ordinal":70253,"en":"Made ready, saying, “I shall bind him!”"},{"id":"manas-2010:p1633:b001:l005","ordinal":70254,"en":"Their champions thronged"},{"id":"manas-2010:p1633:b001:l006","ordinal":70255,"en":"And now came right up."},{"id":"manas-2010:p1633:b001:l007","ordinal":70256,"en":"Your Chubak, forty-two khans"},{"id":"manas-2010:p1633:b001:l008","ordinal":70257,"en":"Again surrounded!"},{"id":"manas-2010:p1633:b001:l009","ordinal":70258,"en":"A merciless assault"},{"id":"manas-2010:p1633:b001:l010","ordinal":70259,"en":"He unleashed, did you see?"},{"id":"manas-2010:p1633:b001:l011","ordinal":70260,"en":"When the short gun cracked,"},{"id":"manas-2010:p1633:b001:l012","ordinal":70261,"en":"Without flinching, their heads one by one"},{"id":"manas-2010:p1633:b001:l013","ordinal":70262,"en":"He took, did you see?"},{"id":"manas-2010:p1633:b001:l014","ordinal":70263,"en":"Poor Chubak, outstanding one—"},{"id":"manas-2010:p1633:b001:l015","ordinal":70264,"en":"Whose prowess was beyond measure,"},{"id":"manas-2010:p1633:b001:l016","ordinal":70265,"en":"Who would face the enemy and fight,"},{"id":"manas-2010:p1633:b001:l017","ordinal":70266,"en":"Who would rescue him,"},{"id":"manas-2010:p1633:b001:l018","ordinal":70267,"en":"Your champion Almambet was not here!"},{"id":"manas-2010:p1633:b001:l019","ordinal":70268,"en":"Whose greatness was beyond measure,"},{"id":"manas-2010:p1633:b001:l020","ordinal":70269,"en":"Within this slaughter,"},{"id":"manas-2010:p1633:b001:l021","ordinal":70270,"en":"His nest-brother Manas was not here!"},{"id":"manas-2010:p1633:b001:l022","ordinal":70271,"en":"There was no support to rely on;"},{"id":"manas-2010:p1633:b001:l023","ordinal":70272,"en":"As the mighty slaughter raged,"},{"id":"manas-2010:p1633:b001:l024","ordinal":70273,"en":"Those Muslim people were not here!"},{"id":"manas-2010:p1633:b001:l025","ordinal":70274,"en":"Without looking up or down,"},{"id":"manas-2010:p1633:b001:l026","ordinal":70275,"en":"Your Chubak did not think, “I shall die.”"},{"id":"manas-2010:p1633:b001:l027","ordinal":70276,"en":"The six sharp blades descended from heaven,"},{"id":"manas-2010:p1633:b001:l028","ordinal":70277,"en":"The very finest among swords—"},{"id":"manas-2010:p1633:b001:l029","ordinal":70278,"en":"Zulpukor, which Manas took,"},{"id":"manas-2010:p1633:b001:l030","ordinal":70279,"en":"Achalbars of Azhybay,"},{"id":"manas-2010:p1633:b001:l031","ordinal":70280,"en":"Achbolot, which Bakay took,"},{"id":"manas-2010:p1633:b001:l032","ordinal":70281,"en":"Zhoykuma, which Chubak took,"},{"id":"manas-2010:p1633:b001:l033","ordinal":70282,"en":"Akalbars, which Almambet took,"},{"id":"manas-2010:p1633:b001:l034","ordinal":70283,"en":"Arkesken, which Syrgak took—"},{"id":"manas-2010:p1633:b001:l035","ordinal":70284,"en":"Those were the six sharp steels;"},{"id":"manas-2010:p1633:b001:l036","ordinal":70285,"en":"The Black Chinese before them,"},{"id":"manas-2010:p1633:b001:l037","ordinal":70286,"en":"Those were the treasures that made them scream."},{"id":"manas-2010:p1633:b001:l038","ordinal":70287,"en":"Never drawing back from iron,"},{"id":"manas-2010:p1633:b001:l039","ordinal":70288,"en":"Never returning without taking a head,"},{"id":"manas-2010:p1633:b001:l040","ordinal":70289,"en":"Never entering the sheath without drinking blood,"},{"id":"manas-2010:p1633:b001:l041","ordinal":70290,"en":"When drawn from its sheath,"},{"id":"manas-2010:p1633:b001:l042","ordinal":70291,"en":"Never going idle without drinking blood."},{"id":"manas-2010:p1634:b001:l001","ordinal":70292,"en":"Then outstanding Chubak"},{"id":"manas-2010:p1634:b001:l002","ordinal":70293,"en":"Grasped it by the hilt,"},{"id":"manas-2010:p1634:b001:l003","ordinal":70294,"en":"Drew it from its sheath then,"},{"id":"manas-2010:p1634:b001:l004","ordinal":70295,"en":"Without looking around him,"},{"id":"manas-2010:p1634:b001:l005","ordinal":70296,"en":"Without sparing his life at all."},{"id":"manas-2010:p1634:b001:l006","ordinal":70297,"en":"The Chinese who entered with lances"},{"id":"manas-2010:p1634:b001:l007","ordinal":70298,"en":"He knocked from their horses;"},{"id":"manas-2010:p1634:b001:l008","ordinal":70299,"en":"Whoever came before him,"},{"id":"manas-2010:p1634:b001:l009","ordinal":70300,"en":"Chubak toppled and laid flat."},{"id":"manas-2010:p1634:b001:l010","ordinal":70301,"en":"Not letting a lasso fall over his head,"},{"id":"manas-2010:p1634:b001:l011","ordinal":70302,"en":"Against the surging Chinese,"},{"id":"manas-2010:p1634:b001:l012","ordinal":70303,"en":"Your Chubak stood his ground,"},{"id":"manas-2010:p1634:b001:l013","ordinal":70304,"en":"Not yielding for nine days."},{"id":"manas-2010:p1634:b001:l014","ordinal":70305,"en":"When slung over him, that wondrous thing—"},{"id":"manas-2010:p1634:b001:l015","ordinal":70306,"en":"The mirror of his shoulder-blade;"},{"id":"manas-2010:p1634:b001:l016","ordinal":70307,"en":"When turned upon the grappling enemy,"},{"id":"manas-2010:p1634:b001:l017","ordinal":70308,"en":"The solace of his entrusted life;"},{"id":"manas-2010:p1634:b001:l018","ordinal":70309,"en":"A matchlock when firing at play,"},{"id":"manas-2010:p1634:b001:l019","ordinal":70310,"en":"A rank-breaker when enraged—"},{"id":"manas-2010:p1634:b001:l020","ordinal":70311,"en":"The short gray gun in his hand,"},{"id":"manas-2010:p1634:b001:l021","ordinal":70312,"en":"He leaned right and fired once,"},{"id":"manas-2010:p1634:b001:l022","ordinal":70313,"en":"Then laid their mighty warriors low."},{"id":"manas-2010:p1634:b001:l023","ordinal":70314,"en":"Not letting a lasso catch his head,"},{"id":"manas-2010:p1634:b001:l024","ordinal":70315,"en":"Akbaltay’s Chubak,"},{"id":"manas-2010:p1634:b001:l025","ordinal":70316,"en":"Not letting a net fall on his body,"},{"id":"manas-2010:p1634:b001:l026","ordinal":70317,"en":"Your Chubak, now on foot,"},{"id":"manas-2010:p1634:b001:l027","ordinal":70318,"en":"Ran up and down."},{"id":"manas-2010:p1634:b001:l028","ordinal":70319,"en":"Burning world, may you come to no good!"},{"id":"manas-2010:p1634:b001:l029","ordinal":70320,"en":"When the Chinese came crawling close,"},{"id":"manas-2010:p1634:b001:l030","ordinal":70321,"en":"He despaired of life, thinking, “I shall die.”"},{"id":"manas-2010:p1634:b001:l031","ordinal":70322,"en":"“The Chinese and Kongurbay have gathered;"},{"id":"manas-2010:p1634:b001:l032","ordinal":70323,"en":"Will they bind me alive?"},{"id":"manas-2010:p1634:b001:l033","ordinal":70324,"en":"Making this lone man shriek,"},{"id":"manas-2010:p1634:b001:l034","ordinal":70325,"en":"Will they slaughter me as a sacrifice?"},{"id":"manas-2010:p1634:b001:l035","ordinal":70326,"en":"Amid this slaughter,"},{"id":"manas-2010:p1634:b001:l036","ordinal":70327,"en":"Will my bones remain unburied?"},{"id":"manas-2010:p1634:b001:l037","ordinal":70328,"en":"My tender flesh, pure and fair,"},{"id":"manas-2010:p1634:b001:l038","ordinal":70329,"en":"Will white vultures tear and feast on it?"},{"id":"manas-2010:p1634:b001:l039","ordinal":70330,"en":"My dear head that shook the world,"},{"id":"manas-2010:p1634:b001:l040","ordinal":70331,"en":"Will the Chinese kick it about?"},{"id":"manas-2010:p1634:b001:l041","ordinal":70332,"en":"Upon my crane-like neck,"},{"id":"manas-2010:p1634:b001:l042","ordinal":70333,"en":"Will the Chinese set a pot-stand?"},{"id":"manas-2010:p1635:b001:l001","ordinal":70334,"en":"My dear head that would not submit,"},{"id":"manas-2010:p1635:b001:l002","ordinal":70335,"en":"To the Chinese with their kakan,"},{"id":"manas-2010:p1635:b001:l003","ordinal":70336,"en":"Will it go under guard to God?"},{"id":"manas-2010:p1635:b001:l004","ordinal":70337,"en":"Forty cubits high, so very deep,"},{"id":"manas-2010:p1635:b001:l005","ordinal":70338,"en":"Will they put me in a dug pit?!"},{"id":"manas-2010:p1635:b001:l006","ordinal":70339,"en":"That dog of an alien faith, that faithless dog,"},{"id":"manas-2010:p1635:b001:l007","ordinal":70340,"en":"Will he take his revenge far away?!"},{"id":"manas-2010:p1635:b001:l008","ordinal":70341,"en":"If he grows angry, Chubak,"},{"id":"manas-2010:p1635:b001:l009","ordinal":70342,"en":"Will he slaughter him midway on the road?”"},{"id":"manas-2010:p1635:b001:l010","ordinal":70343,"en":"Earth flew up and dust billowed."},{"id":"manas-2010:p1635:b001:l011","ordinal":70344,"en":"After fighting for nine days,"},{"id":"manas-2010:p1635:b001:l012","ordinal":70345,"en":"Your Chubak’s strength was gone."},{"id":"manas-2010:p1635:b001:l013","ordinal":70346,"en":"When he knew his strength was gone,"},{"id":"manas-2010:p1635:b001:l014","ordinal":70347,"en":"Alöökö’s Kongurbay"},{"id":"manas-2010:p1635:b001:l015","ordinal":70348,"en":"Shouted and thrust his lance."},{"id":"manas-2010:p1635:b001:l016","ordinal":70349,"en":"Your eagle born a lion,"},{"id":"manas-2010:p1635:b001:l017","ordinal":70350,"en":"With his coat-skirt the lance,"},{"id":"manas-2010:p1635:b001:l018","ordinal":70351,"en":"Your Chubak swept aside."},{"id":"manas-2010:p1635:b001:l019","ordinal":70352,"en":"Without looking around him,"},{"id":"manas-2010:p1635:b001:l020","ordinal":70353,"en":"Chubak did not spare his life at all."},{"id":"manas-2010:p1635:b001:l021","ordinal":70354,"en":"With his wings broken,"},{"id":"manas-2010:p1635:b001:l022","ordinal":70355,"en":"At that moment your Chubak"},{"id":"manas-2010:p1635:b001:l023","ordinal":70356,"en":"Was parted from Kögala."},{"id":"manas-2010:p1635:b001:l024","ordinal":70357,"en":"An iron net encircled him;"},{"id":"manas-2010:p1635:b001:l025","ordinal":70358,"en":"Calling the war cry, “Möndü!”"},{"id":"manas-2010:p1635:b001:l026","ordinal":70359,"en":"The mighty host swept over him."},{"id":"manas-2010:p1635:b001:l027","ordinal":70360,"en":"It became seething misfortune;"},{"id":"manas-2010:p1635:b001:l028","ordinal":70361,"en":"All around him was a bellowing army."},{"id":"manas-2010:p1635:b001:l029","ordinal":70362,"en":"The Chinese had come in throngs."},{"id":"manas-2010:p1635:b001:l030","ordinal":70363,"en":"Sarala with the cow-like tail-root—"},{"id":"manas-2010:p1635:b001:l031","ordinal":70364,"en":"Herding and smashing them,"},{"id":"manas-2010:p1635:b001:l032","ordinal":70365,"en":"Your Almambet kept driving them together."},{"id":"manas-2010:p1635:b001:l033","ordinal":70366,"en":"“Where is my twin Chubak?” he said."},{"id":"manas-2010:p1635:b001:l034","ordinal":70367,"en":"Leaning down and fighting,"},{"id":"manas-2010:p1635:b001:l035","ordinal":70368,"en":"Your Almambet kept seeking him!"},{"id":"manas-2010:p1635:b001:l036","ordinal":70369,"en":"Smashing their center,"},{"id":"manas-2010:p1635:b001:l037","ordinal":70370,"en":"Your Almambet kept battering them."},{"id":"manas-2010:p1635:b001:l038","ordinal":70371,"en":"“Where is my mighty Chubak?” he said."},{"id":"manas-2010:p1635:b001:l039","ordinal":70372,"en":"Your Almambet kept looking then."},{"id":"manas-2010:p1635:b001:l040","ordinal":70373,"en":"Within the bloody slaughter,"},{"id":"manas-2010:p1635:b001:l041","ordinal":70374,"en":"Your Almambet kept stopping."},{"id":"manas-2010:p1635:b001:l042","ordinal":70375,"en":"“Where has my twin gone?” he said."},{"id":"manas-2010:p1636:b001:l001","ordinal":70376,"en":"Your Almambet kept seeking him!"},{"id":"manas-2010:p1636:b001:l002","ordinal":70377,"en":"From the hollow curved like a saddle-pass,"},{"id":"manas-2010:p1636:b001:l003","ordinal":70378,"en":"Your dear Almambet, outstanding one,"},{"id":"manas-2010:p1636:b001:l004","ordinal":70379,"en":"Came out and looked."},{"id":"manas-2010:p1636:b001:l005","ordinal":70380,"en":"The many shapes spread before him—"},{"id":"manas-2010:p1636:b001:l006","ordinal":70381,"en":"What he took for a forest was people."},{"id":"manas-2010:p1636:b001:l007","ordinal":70382,"en":"What gleamed there, dimly burning—"},{"id":"manas-2010:p1636:b001:l008","ordinal":70383,"en":"What he took for stars was embers."},{"id":"manas-2010:p1636:b001:l009","ordinal":70384,"en":"The many darkly burning flashes—"},{"id":"manas-2010:p1636:b001:l010","ordinal":70385,"en":"What he took for tumbleweed was bullets."},{"id":"manas-2010:p1636:b001:l011","ordinal":70386,"en":"What appeared dark and looming"},{"id":"manas-2010:p1636:b001:l012","ordinal":70387,"en":"Was a swelling black army."},{"id":"manas-2010:p1636:b001:l013","ordinal":70388,"en":"Chubak could not be seen then;"},{"id":"manas-2010:p1636:b001:l014","ordinal":70389,"en":"That was Almambet’s misfortune."},{"id":"manas-2010:p1636:b001:l015","ordinal":70390,"en":"What stood up tall before him—"},{"id":"manas-2010:p1636:b001:l016","ordinal":70391,"en":"What he took for reeds was people."},{"id":"manas-2010:p1636:b001:l017","ordinal":70392,"en":"Khan Baltay’s Chubak"},{"id":"manas-2010:p1636:b001:l018","ordinal":70393,"en":"They had surrounded then!"},{"id":"manas-2010:p1636:b001:l019","ordinal":70394,"en":"The Chinese of forty tribes, that dear people,"},{"id":"manas-2010:p1636:b001:l020","ordinal":70395,"en":"Raised their voices in shouts."},{"id":"manas-2010:p1636:b001:l021","ordinal":70396,"en":"Their mighty Mangküsh and Kongurbay"},{"id":"manas-2010:p1636:b001:l022","ordinal":70397,"en":"Had encircled him."},{"id":"manas-2010:p1636:b001:l023","ordinal":70398,"en":"Parted from Kögala,"},{"id":"manas-2010:p1636:b001:l024","ordinal":70399,"en":"Your fierce Chubak, the leopard,"},{"id":"manas-2010:p1636:b001:l025","ordinal":70400,"en":"Into the hands of the swarming Chinese"}]
