{"id": "sayakbay-ms-current146:pdf068:l031", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 68, "folio": 451, "line_in_page": 31, "raw": "Сыртың кара душманың,", "text": "Сыртың кара душманың,", "en": "Outwardly, your enemy is black,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Cursive reading, word division, or idiomatic interpretation is provisional.", "bbox": null}
