[{"id":"semetey-1-2013:p0094:b004:l008","ordinal":83969,"en":"He despaired of Talas's six villains."},{"id":"semetey-1-2013:p0094:b004:l009","ordinal":83970,"en":"The poor man, lost in many thoughts,"},{"id":"semetey-1-2013:p0094:b004:l010","ordinal":83971,"en":"Pressed to his breast and embraced"},{"id":"semetey-1-2013:p0094:b004:l011","ordinal":83972,"en":"Semetey, whom Manas left behind."},{"id":"semetey-1-2013:p0094:b004:l012","ordinal":83973,"en":"That child, solid as a tombstone,"},{"id":"semetey-1-2013:p0094:b004:l013","ordinal":83974,"en":"He spread across his palms."},{"id":"semetey-1-2013:p0094:b004:l014","ordinal":83975,"en":"Saying, ‘The orphan the Magnanimous left,’"},{"id":"semetey-1-2013:p0094:b004:l015","ordinal":83976,"en":"As though Khan Bakai were dividing an inheritance,"},{"id":"semetey-1-2013:p0094:b004:l016","ordinal":83977,"en":"He weighed him in his hands,"},{"id":"semetey-1-2013:p0094:b004:l017","ordinal":83978,"en":"Holding him up, big and broad:"},{"id":"semetey-1-2013:p0094:b004:l018","ordinal":83979,"en":"“You are not yet six months old."},{"id":"semetey-1-2013:p0094:b004:l019","ordinal":83980,"en":"My orphan, are you the one to flee to Bukhara?"},{"id":"semetey-1-2013:p0094:b004:l020","ordinal":83981,"en":"Parted from his support,"},{"id":"semetey-1-2013:p0094:b004:l021","ordinal":83982,"en":"Am I the Bakai who must wail?"},{"id":"semetey-1-2013:p0094:b004:l022","ordinal":83983,"en":"If it appeared by unseen favor,"},{"id":"semetey-1-2013:p0094:b004:l023","ordinal":83984,"en":"Did you find a brown wether and eat?"},{"id":"semetey-1-2013:p0094:b004:l024","ordinal":83985,"en":"Bakai, who has grown old—"},{"id":"semetey-1-2013:p0094:b004:l025","ordinal":83986,"en":"My orphan, let me be your sacrifice—"},{"id":"semetey-1-2013:p0094:b004:l026","ordinal":83987,"en":"Did you mean him to suffer your hell?"},{"id":"semetey-1-2013:p0094:b004:l027","ordinal":83988,"en":"When I turn to look behind,"},{"id":"semetey-1-2013:p0094:b004:l028","ordinal":83989,"en":"Was it a night when Khizyr did not walk?"},{"id":"semetey-1-2013:p0094:b004:l029","ordinal":83990,"en":"Parted from you, my orphan,"},{"id":"semetey-1-2013:p0094:b004:l030","ordinal":83991,"en":"Was this a day to die in such distress?"},{"id":"semetey-1-2013:p0094:b004:l031","ordinal":83992,"en":"My orphan, you have fled away to Bukhara."},{"id":"semetey-1-2013:p0094:b004:l032","ordinal":83993,"en":"Growing to maturity, becoming a man,"},{"id":"semetey-1-2013:p0094:b004:l033","ordinal":83994,"en":"Equal to the sons of heroes,"},{"id":"semetey-1-2013:p0094:b004:l034","ordinal":83995,"en":"When will you come to Talas?"},{"id":"semetey-1-2013:p0094:b004:l035","ordinal":83996,"en":"Before your grieving uncle Bakai's"},{"id":"semetey-1-2013:p0094:b004:l036","ordinal":83997,"en":"Eyes, appearing safe and sound,"},{"id":"semetey-1-2013:p0094:b004:l037","ordinal":83998,"en":"My soft little mottled-gray falcon,"},{"id":"semetey-1-2013:p0094:b004:l038","ordinal":83999,"en":"Semetey, mottled-gray falcon, my morning star,"},{"id":"semetey-1-2013:p0094:b004:l039","ordinal":84000,"en":"My spring that flows from the river valley,"},{"id":"semetey-1-2013:p0095:b003:l001","ordinal":84001,"en":"Semetey, whom my friend left behind,"},{"id":"semetey-1-2013:p0095:b003:l002","ordinal":84002,"en":"My lamp, found at the brink of death!"},{"id":"semetey-1-2013:p0095:b003:l003","ordinal":84003,"en":"In the valley of broad Talas"},{"id":"semetey-1-2013:p0095:b003:l004","ordinal":84004,"en":"I shall turn my steed's head."},{"id":"semetey-1-2013:p0095:b003:l005","ordinal":84005,"en":"For the offspring the falcon left,"},{"id":"semetey-1-2013:p0095:b003:l006","ordinal":84006,"en":"Until twelve years have passed,"},{"id":"semetey-1-2013:p0095:b003:l007","ordinal":84007,"en":"I shall keep watch over the camels."},{"id":"semetey-1-2013:p0095:b003:l008","ordinal":84008,"en":"Broad Talas shall be no home for me;"},{"id":"semetey-1-2013:p0095:b003:l009","ordinal":84009,"en":"I shall have no peace with the six villains."},{"id":"semetey-1-2013:p0095:b003:l010","ordinal":84010,"en":"If I can, from those six villains,"},{"id":"semetey-1-2013:p0095:b003:l011","ordinal":84011,"en":"For your sake, my orphan,"},{"id":"semetey-1-2013:p0095:b003:l012","ordinal":84012,"en":"I shall plunder their possessions;"},{"id":"semetey-1-2013:p0095:b003:l013","ordinal":84013,"en":"I shall wreak thorough havoc."},{"id":"semetey-1-2013:p0095:b003:l014","ordinal":84014,"en":"Slaying men and cutting off heads,"},{"id":"semetey-1-2013:p0095:b003:l015","ordinal":84015,"en":"Clashing many spears,"},{"id":"semetey-1-2013:p0095:b003:l016","ordinal":84016,"en":"For your sake, my mother,"},{"id":"semetey-1-2013:p0095:b003:l017","ordinal":84017,"en":"On your account, Kanykei,"},{"id":"semetey-1-2013:p0095:b003:l018","ordinal":84018,"en":"I myself against the six villains"},{"id":"semetey-1-2013:p0095:b003:l019","ordinal":84019,"en":"Shall wage war for twelve years!"},{"id":"semetey-1-2013:p0095:b003:l020","ordinal":84020,"en":"Slaying men and cutting off heads,"},{"id":"semetey-1-2013:p0095:b003:l021","ordinal":84021,"en":"I shall raise many a tumult."},{"id":"semetey-1-2013:p0095:b003:l022","ordinal":84022,"en":"Taking no rest by day,"},{"id":"semetey-1-2013:p0095:b003:l023","ordinal":84023,"en":"Taking no sleep at night,"},{"id":"semetey-1-2013:p0095:b003:l024","ordinal":84024,"en":"That is how I shall fight."},{"id":"semetey-1-2013:p0095:b003:l025","ordinal":84025,"en":"Raiding horses, slitting mares,"},{"id":"semetey-1-2013:p0095:b003:l026","ordinal":84026,"en":"That is how I shall bring destruction."},{"id":"semetey-1-2013:p0095:b003:l027","ordinal":84027,"en":"Until twelve years have passed,"},{"id":"semetey-1-2013:p0095:b003:l028","ordinal":84028,"en":"Keeping them from this Talas,"},{"id":"semetey-1-2013:p0095:b003:l029","ordinal":84029,"en":"That is how I shall torment them."},{"id":"semetey-1-2013:p0095:b003:l030","ordinal":84030,"en":"If my means suffice, the villains"},{"id":"semetey-1-2013:p0095:b003:l031","ordinal":84031,"en":"I shall isolate and destroy."},{"id":"semetey-1-2013:p0095:b003:l032","ordinal":84032,"en":"Whenever I meet them, every one"},{"id":"semetey-1-2013:p0095:b003:l033","ordinal":84033,"en":"I shall offer in sacrifice."},{"id":"semetey-1-2013:p0095:b003:l034","ordinal":84034,"en":"Somehow, against those villains,"},{"id":"semetey-1-2013:p0095:b003:l035","ordinal":84035,"en":"I shall avenge my unforgotten grievance!”"},{"id":"semetey-1-2013:p0095:b003:l036","ordinal":84036,"en":"Then old Bakai,"},{"id":"semetey-1-2013:p0095:b003:l037","ordinal":84037,"en":"Coughing with deep, repeated thuds,"},{"id":"semetey-1-2013:p0095:b003:l038","ordinal":84038,"en":"Held Semetey, whose cradle was a leg,"},{"id":"semetey-1-2013:p0095:b003:l039","ordinal":84039,"en":"Pressed against his breast."},{"id":"semetey-1-2013:p0095:b004:l001","ordinal":84040,"en":"The wide world grew narrow."},{"id":"semetey-1-2013:p0095:b004:l002","ordinal":84041,"en":"His unfortunate daughter-in-law Kanykei"},{"id":"semetey-1-2013:p0095:b004:l003","ordinal":84042,"en":"He now longed to see."},{"id":"semetey-1-2013:p0095:b004:l004","ordinal":84043,"en":"Holding Semetey, distraught,"},{"id":"semetey-1-2013:p0095:b004:l005","ordinal":84044,"en":"Pleading with Kanykei,"},{"id":"semetey-1-2013:p0095:b004:l006","ordinal":84045,"en":"Mighty Bakai approached."},{"id":"semetey-1-2013:p0095:b004:l007","ordinal":84046,"en":"Though Khan Bakai stood pleading,"},{"id":"semetey-1-2013:p0095:b004:l008","ordinal":84047,"en":"Kanykei would not look."},{"id":"semetey-1-2013:p0095:b004:l009","ordinal":84048,"en":"The reason she would not look—"},{"id":"semetey-1-2013:p0095:b004:l010","ordinal":84049,"en":"About her great dark head,"},{"id":"semetey-1-2013:p0095:b004:l011","ordinal":84050,"en":"Her bloody face was torn."},{"id":"semetey-1-2013:p0095:b004:l012","ordinal":84051,"en":"Her precious hair, like meadow grass,"},{"id":"semetey-1-2013:p0095:b004:l013","ordinal":84052,"en":"Lay neatly spread before her."},{"id":"semetey-1-2013:p0095:b004:l014","ordinal":84053,"en":"With her dark head bowed,"},{"id":"semetey-1-2013:p0095:b004:l015","ordinal":84054,"en":"She had lost her beloved"},{"id":"semetey-1-2013:p0095:b004:l016","ordinal":84055,"en":"At thirty-two years of age."},{"id":"semetey-1-2013:p0095:b004:l017","ordinal":84056,"en":"Without looking upon Bakai's face,"},{"id":"semetey-1-2013:p0095:b004:l018","ordinal":84057,"en":"She turned away and screamed,"},{"id":"semetey-1-2013:p0095:b004:l019","ordinal":84058,"en":"Falling face down,"},{"id":"semetey-1-2013:p0095:b004:l020","ordinal":84059,"en":"Her voice reaching God."},{"id":"semetey-1-2013:p0095:b004:l021","ordinal":84060,"en":"At the sight of Kanykei,"},{"id":"semetey-1-2013:p0095:b004:l022","ordinal":84061,"en":"Dignified Khan Bakai wept;"},{"id":"semetey-1-2013:p0095:b004:l023","ordinal":84062,"en":"He could not rally himself and watch."},{"id":"semetey-1-2013:p0095:b004:l024","ordinal":84063,"en":"And that gracious old lady Chyiyrdy,"},{"id":"semetey-1-2013:p0095:b004:l025","ordinal":84064,"en":"Your mother, wept again."},{"id":"semetey-1-2013:p0095:b004:l026","ordinal":84065,"en":"Then Bakai's voice rang out;"},{"id":"semetey-1-2013:p0095:b004:l027","ordinal":84066,"en":"In a deep voice he spoke encouragement:"},{"id":"semetey-1-2013:p0095:b004:l028","ordinal":84067,"en":"“Oh, Kanykei, my foal,"},{"id":"semetey-1-2013:p0095:b004:l029","ordinal":84068,"en":"Do not be ashamed, my incomparable child."},{"id":"semetey-1-2013:p0095:b004:l030","ordinal":84069,"en":"He who gave his hand to twelve saints,"},{"id":"semetey-1-2013:p0095:b004:l031","ordinal":84070,"en":"Saintly Manas, is not here."},{"id":"semetey-1-2013:p0095:b004:l032","ordinal":84071,"en":"You have no support to rely upon."},{"id":"semetey-1-2013:p0095:b004:l033","ordinal":84072,"en":"Do not keep grieving so, Kanykei."},{"id":"semetey-1-2013:p0095:b004:l034","ordinal":84073,"en":"Never giving up their greed,"},{"id":"semetey-1-2013:p0095:b004:l035","ordinal":84074,"en":"Never sated by what they beg to eat,"},{"id":"semetey-1-2013:p0095:b004:l036","ordinal":84075,"en":"Your sovereign Kyrgyz people are not here."},{"id":"semetey-1-2013:p0095:b004:l037","ordinal":84076,"en":"Wandering the wilderness and wailing,"},{"id":"semetey-1-2013:p0095:b004:l038","ordinal":84077,"en":"My child Kanykei, there is no use in endless tears."},{"id":"semetey-1-2013:p0096:b003:l001","ordinal":84078,"en":"May those six restless villains"},{"id":"semetey-1-2013:p0096:b003:l002","ordinal":84079,"en":"Not pick up your trail"},{"id":"semetey-1-2013:p0096:b003:l003","ordinal":84080,"en":"And chase you to exhaustion."},{"id":"semetey-1-2013:p0096:b003:l004","ordinal":84081,"en":"May the forty companions Manas left"},{"id":"semetey-1-2013:p0096:b003:l005","ordinal":84082,"en":"Not pick up your wretched trail"},{"id":"semetey-1-2013:p0096:b003:l006","ordinal":84083,"en":"And hunt you until you pale."},{"id":"semetey-1-2013:p0096:b003:l007","ordinal":84084,"en":"May they not trample us down,"},{"id":"semetey-1-2013:p0096:b003:l008","ordinal":84085,"en":"Oh, Kanykei, my foal,"},{"id":"semetey-1-2013:p0096:b003:l009","ordinal":84086,"en":"Nor scatter blood across the wilderness."},{"id":"semetey-1-2013:p0096:b003:l010","ordinal":84087,"en":"May they not ignore your pleading,"},{"id":"semetey-1-2013:p0096:b003:l011","ordinal":84088,"en":"Gouge out your eyes while you live, my child,"},{"id":"semetey-1-2013:p0096:b003:l012","ordinal":84089,"en":"And inflict such torment."},{"id":"semetey-1-2013:p0096:b003:l013","ordinal":84090,"en":"May they not snatch the orphan"},{"id":"semetey-1-2013:p0096:b003:l014","ordinal":84091,"en":"The Magnanimous left from your hands,"},{"id":"semetey-1-2013:p0096:b003:l015","ordinal":84092,"en":"Making a spectacle upon the road,"},{"id":"semetey-1-2013:p0096:b003:l016","ordinal":84093,"en":"My child Kanykei, nor tear him open for the vultures!”"},{"id":"semetey-1-2013:p0096:b003:l018","ordinal":84094,"en":"Having said these words,"},{"id":"semetey-1-2013:p0096:b003:l019","ordinal":84095,"en":"“Oh, Kanykei, my foal,"},{"id":"semetey-1-2013:p0096:b003:l020","ordinal":84096,"en":"If you mean to flee, move;"},{"id":"semetey-1-2013:p0096:b003:l021","ordinal":84097,"en":"If you mean to leave, fly!"},{"id":"semetey-1-2013:p0096:b003:l022","ordinal":84098,"en":"This wilderness is no place for us;"},{"id":"semetey-1-2013:p0096:b003:l023","ordinal":84099,"en":"It is not right for us to stay here."},{"id":"semetey-1-2013:p0096:b003:l024","ordinal":84100,"en":"Let us go up into the hills;"},{"id":"semetey-1-2013:p0096:b003:l025","ordinal":84101,"en":"If death comes, let us die."},{"id":"semetey-1-2013:p0096:b003:l026","ordinal":84102,"en":"If the six villains inflict humiliation,"},{"id":"semetey-1-2013:p0096:b003:l027","ordinal":84103,"en":"We shall face that afterward.”"},{"id":"semetey-1-2013:p0096:b003:l028","ordinal":84104,"en":"The saint, a wolf against the enemy,"},{"id":"semetey-1-2013:p0096:b003:l029","ordinal":84105,"en":"Your tiger, old Bakai,"},{"id":"semetey-1-2013:p0096:b003:l030","ordinal":84106,"en":"Knew this very moment"},{"id":"semetey-1-2013:p0096:b003:l031","ordinal":84107,"en":"The torment of six months ahead."},{"id":"semetey-1-2013:p0096:b003:l032","ordinal":84108,"en":"He was a man of sacred power,"},{"id":"semetey-1-2013:p0096:b003:l033","ordinal":84109,"en":"A khan over many lands,"},{"id":"semetey-1-2013:p0096:b003:l034","ordinal":84110,"en":"Finding words in sudden crisis,"},{"id":"semetey-1-2013:p0096:b003:l035","ordinal":84111,"en":"Finding sight in the dark."},{"id":"semetey-1-2013:p0096:b003:l036","ordinal":84112,"en":"His eyes glittered like a lion's."},{"id":"semetey-1-2013:p0096:b003:l037","ordinal":84113,"en":"When he fought his way to Beijing,"},{"id":"semetey-1-2013:p0096:b003:l038","ordinal":84114,"en":"He bore the banner of Islam."},{"id":"semetey-1-2013:p0096:b003:l039","ordinal":84115,"en":"His wrath took lives;"},{"id":"semetey-1-2013:p0096:b004:l001","ordinal":84116,"en":"His grip drew blood."},{"id":"semetey-1-2013:p0096:b004:l002","ordinal":84117,"en":"Where he went, lives were lost."},{"id":"semetey-1-2013:p0096:b004:l003","ordinal":84118,"en":"Wearing a gray lynx-fur cap,"},{"id":"semetey-1-2013:p0096:b004:l004","ordinal":84119,"en":"While his fierce wolf lived,"},{"id":"semetey-1-2013:p0096:b004:l005","ordinal":84120,"en":"He wielded a mottled-blue shield."},{"id":"semetey-1-2013:p0096:b004:l006","ordinal":84121,"en":"When he travelled in the dark,"},{"id":"semetey-1-2013:p0096:b004:l007","ordinal":84122,"en":"He prowled like a leopard."},{"id":"semetey-1-2013:p0096:b004:l008","ordinal":84123,"en":"Ninety-five counsels, a thousand prayers—"},{"id":"semetey-1-2013:p0096:b004:l009","ordinal":84124,"en":"He pondered every one."},{"id":"semetey-1-2013:p0096:b004:l010","ordinal":84125,"en":"Of thoughts in his clear mind,"},{"id":"semetey-1-2013:p0096:b004:l011","ordinal":84126,"en":"He left not one untouched."},{"id":"semetey-1-2013:p0096:b004:l012","ordinal":84127,"en":"Hardened by drinking blood,"},{"id":"semetey-1-2013:p0096:b004:l013","ordinal":84128,"en":"He was called Leopard Bakai."},{"id":"semetey-1-2013:p0096:b004:l014","ordinal":84129,"en":"Girding his waist securely,"},{"id":"semetey-1-2013:p0096:b004:l015","ordinal":84130,"en":"If seventy thousand troops came,"},{"id":"semetey-1-2013:p0096:b004:l016","ordinal":84131,"en":"He plunged in lightly clad and attacked."},{"id":"semetey-1-2013:p0096:b004:l017","ordinal":84132,"en":"Your forefather, like a prophet,"},{"id":"semetey-1-2013:p0096:b004:l018","ordinal":84133,"en":"Was that same uncle Bakai."},{"id":"semetey-1-2013:p0096:b004:l019","ordinal":84134,"en":"Who defeated enemies in many lands?"},{"id":"semetey-1-2013:p0096:b004:l020","ordinal":84135,"en":"Was it not renowned Bakai?"},{"id":"semetey-1-2013:p0096:b004:l021","ordinal":84136,"en":"When dark days brought trouble,"},{"id":"semetey-1-2013:p0096:b004:l022","ordinal":84137,"en":"While Khan Manas lived,"},{"id":"semetey-1-2013:p0096:b004:l023","ordinal":84138,"en":"Who found so many counsels for him?"},{"id":"semetey-1-2013:p0096:b004:l024","ordinal":84139,"en":"Was it not resourceful Bakai?"},{"id":"semetey-1-2013:p0096:b004:l025","ordinal":84140,"en":"The gray steed beneath him—"},{"id":"semetey-1-2013:p0096:b004:l026","ordinal":84141,"en":"He hurried to saddle the charger."},{"id":"semetey-1-2013:p0096:b004:l027","ordinal":84142,"en":"Thinking, ‘This precious soul needs it,’"},{"id":"semetey-1-2013:p0096:b004:l028","ordinal":84143,"en":"Khan Bakai held"},{"id":"semetey-1-2013:p0096:b004:l029","ordinal":84144,"en":"Semetey, though still a child,"},{"id":"semetey-1-2013:p0096:b004:l030","ordinal":84145,"en":"His kinsman whose cradle was a leg."},{"id":"semetey-1-2013:p0096:b004:l031","ordinal":84146,"en":"Hurrying and bustling, hero Bakai,"},{"id":"semetey-1-2013:p0096:b004:l032","ordinal":84147,"en":"On the gray steed beneath him,"},{"id":"semetey-1-2013:p0096:b004:l033","ordinal":84148,"en":"Pulled the rear girth tight"},{"id":"semetey-1-2013:p0096:b004:l034","ordinal":84149,"en":"And shortened the crupper."},{"id":"semetey-1-2013:p0096:b004:l035","ordinal":84150,"en":"The gray coat that no bullet pierced,"},{"id":"semetey-1-2013:p0096:b004:l036","ordinal":84151,"en":"Your hero Bakai the leopard"},{"id":"semetey-1-2013:p0096:b004:l037","ordinal":84152,"en":"Took again and folded together."},{"id":"semetey-1-2013:p0096:b004:l038","ordinal":84153,"en":"The leather trousers and large boots"},{"id":"semetey-1-2013:p0096:b004:l039","ordinal":84154,"en":"He folded inside and entrusted,"},{"id":"semetey-1-2013:p0097:b003:l001","ordinal":84155,"en":"Gripping and fastening them firmly,"},{"id":"semetey-1-2013:p0097:b003:l002","ordinal":84156,"en":"Your khan Bakai the leopard"},{"id":"semetey-1-2013:p0097:b003:l003","ordinal":84157,"en":"Secured them to the saddle straps"},{"id":"semetey-1-2013:p0097:b003:l004","ordinal":84158,"en":"And bound the bundle tight behind."},{"id":"semetey-1-2013:p0097:b003:l005","ordinal":84159,"en":"Showing his valor,"},{"id":"semetey-1-2013:p0097:b003:l006","ordinal":84160,"en":"Upon the broad-pommeled saddle"},{"id":"semetey-1-2013:p0097:b003:l007","ordinal":84161,"en":"He seated Chyiyrdy."},{"id":"semetey-1-2013:p0097:b003:l008","ordinal":84162,"en":"Then binding and fastening again,"},{"id":"semetey-1-2013:p0097:b003:l009","ordinal":84163,"en":"The orphan of ill fortune,"},{"id":"semetey-1-2013:p0097:b003:l010","ordinal":84164,"en":"With a striped woolen sash,"},{"id":"semetey-1-2013:p0097:b003:l011","ordinal":84165,"en":"He secured as a precious trust."},{"id":"semetey-1-2013:p0097:b003:l012","ordinal":84166,"en":"Showing himself a hero,"},{"id":"semetey-1-2013:p0097:b003:l013","ordinal":84167,"en":"He seated him upon his neck"},{"id":"semetey-1-2013:p0097:b003:l014","ordinal":84168,"en":"And bound him firmly there."},{"id":"semetey-1-2013:p0097:b003:l015","ordinal":84169,"en":"The thick-weft striped cloth of Andijan,"},{"id":"semetey-1-2013:p0097:b003:l016","ordinal":84170,"en":"The broad trousers upon his legs—"},{"id":"semetey-1-2013:p0097:b003:l017","ordinal":84171,"en":"He gathered their cuffs together"},{"id":"semetey-1-2013:p0097:b003:l018","ordinal":84172,"en":"And tucked them into his waistband."},{"id":"semetey-1-2013:p0097:b003:l019","ordinal":84173,"en":"Moving with fierce resolve,"},{"id":"semetey-1-2013:p0097:b003:l020","ordinal":84174,"en":"He rolled his trousers upward."},{"id":"semetey-1-2013:p0097:b003:l021","ordinal":84175,"en":"Showing his heroism,"},{"id":"semetey-1-2013:p0097:b003:l022","ordinal":84176,"en":"Bakai, himself a skilled swimmer,"},{"id":"semetey-1-2013:p0097:b003:l023","ordinal":84177,"en":"That orphan child"},{"id":"semetey-1-2013:p0097:b003:l024","ordinal":84178,"en":"Seated upon his neck."},{"id":"semetey-1-2013:p0097:b003:l025","ordinal":84179,"en":"Thinking, ‘If I give him to the women,"},{"id":"semetey-1-2013:p0097:b003:l026","ordinal":84180,"en":"In their distraction they may throw him into the water;"},{"id":"semetey-1-2013:p0097:b003:l027","ordinal":84181,"en":"The hero's death will come with theirs,"},{"id":"semetey-1-2013:p0097:b003:l028","ordinal":84182,"en":"He will die for nothing’—"},{"id":"semetey-1-2013:p0097:b003:l029","ordinal":84183,"en":"Showing his valor,"},{"id":"semetey-1-2013:p0097:b003:l030","ordinal":84184,"en":"The heroic child Semetey"},{"id":"semetey-1-2013:p0097:b003:l031","ordinal":84185,"en":"Upon the muscles of his neck"},{"id":"semetey-1-2013:p0097:b003:l032","ordinal":84186,"en":"Bakai carefully seated."},{"id":"semetey-1-2013:p0097:b003:l033","ordinal":84187,"en":"Bareheaded, he strode along,"},{"id":"semetey-1-2013:p0097:b003:l034","ordinal":84188,"en":"Barefoot, he stepped lightly."},{"id":"semetey-1-2013:p0097:b003:l035","ordinal":84189,"en":"Pleading with the one God,"},{"id":"semetey-1-2013:p0097:b003:l036","ordinal":84190,"en":"To ford the Syr Darya"},{"id":"semetey-1-2013:p0097:b003:l037","ordinal":84191,"en":"Great Bakai prepared himself,"},{"id":"semetey-1-2013:p0097:b003:l038","ordinal":84192,"en":"Invoking the spirit of Manas"},{"id":"semetey-1-2013:p0097:b003:l039","ordinal":84193,"en":"Who had gone to the other world:"},{"id":"semetey-1-2013:p0097:b005:l001","ordinal":84194,"en":"“My protector Kojosan,"},{"id":"semetey-1-2013:p0097:b005:l002","ordinal":84195,"en":"Support me beneath my arms!"},{"id":"semetey-1-2013:p0097:b005:l003","ordinal":84196,"en":"Ak Eshen, to whom I gave my hand,"},{"id":"semetey-1-2013:p0097:b005:l004","ordinal":84197,"en":"Come before me!"},{"id":"semetey-1-2013:p0097:b005:l005","ordinal":84198,"en":"Black-spotted leopard,"},{"id":"semetey-1-2013:p0097:b005:l006","ordinal":84199,"en":"Spring to my side!"},{"id":"semetey-1-2013:p0097:b005:l007","ordinal":84200,"en":"Short-tailed, dark-maned lion,"},{"id":"semetey-1-2013:p0097:b005:l008","ordinal":84201,"en":"Stand ready at my flank!"},{"id":"semetey-1-2013:p0097:b005:l009","ordinal":84202,"en":"Father of water, Buurakan,"},{"id":"semetey-1-2013:p0097:b005:l010","ordinal":84203,"en":"Let your riverbed emerge and give me passage!"},{"id":"semetey-1-2013:p0097:b005:l011","ordinal":84204,"en":"Almambet and Chubak, whose names chime,"},{"id":"semetey-1-2013:p0097:b005:l012","ordinal":84205,"en":"Give your orphan aid!"},{"id":"semetey-1-2013:p0097:b005:l013","ordinal":84206,"en":"Forty chiltens, Khizyr and Ilyas,"},{"id":"semetey-1-2013:p0097:b005:l014","ordinal":84207,"en":"I am in distress—give me passage!”"},{"id":"semetey-1-2013:p0097:b005:l015","ordinal":84208,"en":"Saying this, mighty Bakai"},{"id":"semetey-1-2013:p0097:b005:l016","ordinal":84209,"en":"Put his sash around his neck."},{"id":"semetey-1-2013:p0097:b005:l017","ordinal":84210,"en":"To the Jabbar saints who protected him"},{"id":"semetey-1-2013:p0097:b005:l018","ordinal":84211,"en":"He prayed, leaving none out."},{"id":"semetey-1-2013:p0097:b005:l019","ordinal":84212,"en":"Dipping his feet in the water,"},{"id":"semetey-1-2013:p0097:b005:l020","ordinal":84213,"en":"He performed their ritual washing."},{"id":"semetey-1-2013:p0097:b005:l021","ordinal":84214,"en":"Dipping his hands in the water,"},{"id":"semetey-1-2013:p0097:b005:l022","ordinal":84215,"en":"He performed their ritual washing."},{"id":"semetey-1-2013:p0097:b005:l023","ordinal":84216,"en":"His body ritually clean,"},{"id":"semetey-1-2013:p0097:b005:l024","ordinal":84217,"en":"Faith upon his face,"},{"id":"semetey-1-2013:p0097:b005:l025","ordinal":84218,"en":"The orphan and the widow"},{"id":"semetey-1-2013:p0097:b005:l026","ordinal":84219,"en":"He meant to save."},{"id":"semetey-1-2013:p0097:b005:l027","ordinal":84220,"en":"Was it not Bakai who had seen"},{"id":"semetey-1-2013:p0097:b005:l028","ordinal":84221,"en":"Great, arduous, costly undertakings?"},{"id":"semetey-1-2013:p0097:b005:l029","ordinal":84222,"en":"Was it not Bakai, accustomed"},{"id":"semetey-1-2013:p0097:b005:l030","ordinal":84223,"en":"To marching at the head of countless troops?"},{"id":"semetey-1-2013:p0097:b005:l031","ordinal":84224,"en":"Your falcon, saintly Bakai,"}]
