[{"id":"semetey-1-2013:p0553:b005:l035","ordinal":119041,"en":"My uncle Bakai, a surpassing lion,"},{"id":"semetey-1-2013:p0553:b005:l036","ordinal":119042,"en":"Driving off the outlying Chinese troops,"},{"id":"semetey-1-2013:p0553:b005:l037","ordinal":119043,"en":"My father's red banner with its golden crescent"},{"id":"semetey-1-2013:p0553:b005:l039","ordinal":119044,"en":"Placed in Khan Bakai's grasp,"},{"id":"semetey-1-2013:p0554:b003:l001","ordinal":119045,"en":"Driving the Chinese people before him,"},{"id":"semetey-1-2013:p0554:b003:l002","ordinal":119046,"en":"She painted Bakai in the picture."},{"id":"semetey-1-2013:p0554:b003:l003","ordinal":119047,"en":"When he looked this way,"},{"id":"semetey-1-2013:p0554:b003:l004","ordinal":119048,"en":"Golden forelock and tasseled sash,"},{"id":"semetey-1-2013:p0554:b003:l005","ordinal":119049,"en":"Aziz Khan's only son,"},{"id":"semetey-1-2013:p0554:b003:l006","ordinal":119050,"en":"A bringer of good fortune when sent ahead,"},{"id":"semetey-1-2013:p0554:b003:l007","ordinal":119051,"en":"Like countless troops when leading the way,"},{"id":"semetey-1-2013:p0554:b003:l008","ordinal":119052,"en":"A bringer of good fortune when giving shelter,"},{"id":"semetey-1-2013:p0554:b003:l009","ordinal":119053,"en":"The handsome sultan, like countless troops."},{"id":"semetey-1-2013:p0554:b003:l011","ordinal":119054,"en":"Upon Kakancha's golden throne,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0554:b003:l012","ordinal":119055,"en":"At the time he sat enthroned,"},{"id":"semetey-1-2013:p0554:b003:l013","ordinal":119056,"en":"The forty tribes of China, the countless people,"},{"id":"semetey-1-2013:p0554:b003:l014","ordinal":119057,"en":"Alake kept from wavering,"},{"id":"semetey-1-2013:p0554:b003:l015","ordinal":119058,"en":"At the time he ruled them."},{"id":"semetey-1-2013:p0554:b003:l016","ordinal":119059,"en":"On Friday's sacred night,"},{"id":"semetey-1-2013:p0554:b003:l017","ordinal":119060,"en":"At the time he slept,"},{"id":"semetey-1-2013:p0554:b003:l018","ordinal":119061,"en":"Bringing news to his side,"},{"id":"semetey-1-2013:p0554:b003:l019","ordinal":119062,"en":"A saint had come."},{"id":"semetey-1-2013:p0554:b003:l020","ordinal":119063,"en":"Through that being's intervention,"},{"id":"semetey-1-2013:p0554:b003:l021","ordinal":119064,"en":"He saw the workings of heaven and hell."},{"id":"semetey-1-2013:p0554:b003:l022","ordinal":119065,"en":"The saint Alman, the precious lion,"},{"id":"semetey-1-2013:p0554:b003:l024","ordinal":119066,"en":"A true saint, that unfortunate hero,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0554:b003:l025","ordinal":119067,"en":"The cow-tailed Sarala"},{"id":"semetey-1-2013:p0554:b003:l026","ordinal":119068,"en":"He did not saddle as the Manchus did;"},{"id":"semetey-1-2013:p0554:b003:l027","ordinal":119069,"en":"His idol as large as a house"},{"id":"semetey-1-2013:p0554:b003:l028","ordinal":119070,"en":"He did not worship and bow before."},{"id":"semetey-1-2013:p0554:b003:l029","ordinal":119071,"en":"Renouncing his idols,"},{"id":"semetey-1-2013:p0554:b003:l030","ordinal":119072,"en":"Leaving his Chinese people,"},{"id":"semetey-1-2013:p0554:b003:l031","ordinal":119073,"en":"Scattering what he had amassed,"},{"id":"semetey-1-2013:p0554:b003:l032","ordinal":119074,"en":"Seeking only his faith,"},{"id":"semetey-1-2013:p0554:b003:l033","ordinal":119075,"en":"He smeared his golden throne with grease;"},{"id":"semetey-1-2013:p0554:b003:l034","ordinal":119076,"en":"Because he would not enter the Muslim faith,"},{"id":"semetey-1-2013:p0554:b003:l035","ordinal":119077,"en":"He killed his own father,"},{"id":"semetey-1-2013:p0554:b003:l036","ordinal":119078,"en":"Bloodied his silver throne,"},{"id":"semetey-1-2013:p0554:b003:l037","ordinal":119079,"en":"Killed his father Kün Jangjung."},{"id":"semetey-1-2013:p0554:b003:l038","ordinal":119080,"en":"Having yellow willows planted,"},{"id":"semetey-1-2013:p0554:b003:l039","ordinal":119081,"en":"He abandoned his willows utterly;"},{"id":"semetey-1-2013:p0554:b004:l001","ordinal":119082,"en":"Made of pure gold,"},{"id":"semetey-1-2013:p0554:b004:l002","ordinal":119083,"en":"He abandoned his throne utterly."},{"id":"semetey-1-2013:p0554:b004:l003","ordinal":119084,"en":"When God created Almam,"},{"id":"semetey-1-2013:p0554:b004:l004","ordinal":119085,"en":"Alas, when his wretched mother gave birth,"},{"id":"semetey-1-2013:p0554:b004:l005","ordinal":119086,"en":"The tips of his ears were pierced,"},{"id":"semetey-1-2013:p0554:b004:l006","ordinal":119087,"en":"His foreskin already circumcised,"},{"id":"semetey-1-2013:p0554:b004:l007","ordinal":119088,"en":"His twelve bodily members troubled,"},{"id":"semetey-1-2013:p0554:b004:l008","ordinal":119089,"en":"With a sign like a prophet's,"},{"id":"semetey-1-2013:p0554:b004:l009","ordinal":119090,"en":"His forehead reached the ground."},{"id":"semetey-1-2013:p0554:b004:l010","ordinal":119091,"en":"When Alake was being born,"},{"id":"semetey-1-2013:p0554:b004:l011","ordinal":119092,"en":"The weather broke, rain fell,"},{"id":"semetey-1-2013:p0554:b004:l012","ordinal":119093,"en":"Through Kakancha's Beijing"},{"id":"semetey-1-2013:p0554:b004:l013","ordinal":119094,"en":"Water flowed for eighty days,"},{"id":"semetey-1-2013:p0554:b004:l014","ordinal":119095,"en":"And earthquakes came."},{"id":"semetey-1-2013:p0554:b004:l015","ordinal":119096,"en":"Reading in their laws,"},{"id":"semetey-1-2013:p0554:b004:l016","ordinal":119097,"en":"The Chinese diviners said,"},{"id":"semetey-1-2013:p0554:b004:l017","ordinal":119098,"en":"“Which is the child Almam?"},{"id":"semetey-1-2013:p0554:b004:l018","ordinal":119099,"en":"Upon the whole wide world"},{"id":"semetey-1-2013:p0554:b004:l019","ordinal":119100,"en":"Which child has brought turmoil?"},{"id":"semetey-1-2013:p0554:b004:l020","ordinal":119101,"en":"With pierced ears from his mother"},{"id":"semetey-1-2013:p0554:b004:l021","ordinal":119102,"en":"Which child was born?"},{"id":"semetey-1-2013:p0554:b004:l022","ordinal":119103,"en":"Who will draw tight a double girth,"},{"id":"semetey-1-2013:p0554:b004:l023","ordinal":119104,"en":"Which is the child with girth-straps?"},{"id":"semetey-1-2013:p0554:b004:l024","ordinal":119105,"en":"Who will raise rebellion in Beijing,"},{"id":"semetey-1-2013:p0554:b004:l025","ordinal":119106,"en":"Which is the child of omens?"},{"id":"semetey-1-2013:p0554:b004:l026","ordinal":119107,"en":"Precious eyes like blackcurrants—"},{"id":"semetey-1-2013:p0554:b004:l027","ordinal":119108,"en":"Which child will gouge them out?"},{"id":"semetey-1-2013:p0554:b004:l028","ordinal":119109,"en":"Crushing Kakan's people,"},{"id":"semetey-1-2013:p0554:b004:l029","ordinal":119110,"en":"Which child will slaughter them?"},{"id":"semetey-1-2013:p0554:b004:l030","ordinal":119111,"en":"Named at his birth,"},{"id":"semetey-1-2013:p0554:b004:l031","ordinal":119112,"en":"Which is the child Almam?"},{"id":"semetey-1-2013:p0554:b004:l032","ordinal":119113,"en":"Upon the whole wide world"},{"id":"semetey-1-2013:p0554:b004:l033","ordinal":119114,"en":"Which child has brought turmoil?”"},{"id":"semetey-1-2013:p0554:b004:l034","ordinal":119115,"en":"The Chinese began to search;"},{"id":"semetey-1-2013:p0554:b004:l035","ordinal":119116,"en":"God had struck them down."},{"id":"semetey-1-2013:p0554:b004:l036","ordinal":119117,"en":"His mother, the wise Altynai,"},{"id":"semetey-1-2013:p0554:b004:l037","ordinal":119118,"en":"“They will tear him from my hands,"},{"id":"semetey-1-2013:p0554:b004:l038","ordinal":119119,"en":"He will go before their diviner,"},{"id":"semetey-1-2013:p0554:b004:l039","ordinal":119120,"en":"My little one, whom I gained through mortal hardship,"},{"id":"semetey-1-2013:p0555:b003:l001","ordinal":119121,"en":"The unbelievers will seize him"},{"id":"semetey-1-2013:p0555:b003:l002","ordinal":119122,"en":"And put him to death,” she said."},{"id":"semetey-1-2013:p0555:b003:l003","ordinal":119123,"en":"Hanging an amulet about his neck,"},{"id":"semetey-1-2013:p0555:b003:l004","ordinal":119124,"en":"The wise woman Altynai"},{"id":"semetey-1-2013:p0555:b003:l005","ordinal":119125,"en":"Had her father Sooronduk rear him."},{"id":"semetey-1-2013:p0555:b003:l006","ordinal":119126,"en":"When the amulet was hung about his neck,"},{"id":"semetey-1-2013:p0555:b003:l007","ordinal":119127,"en":"From his grandfather Sooronduk's hands,"},{"id":"semetey-1-2013:p0555:b003:l008","ordinal":119128,"en":"Giving gold and precious metal by the pood,"},{"id":"semetey-1-2013:p0555:b003:l009","ordinal":119129,"en":"She took him back with desperate difficulty."},{"id":"semetey-1-2013:p0555:b003:l010","ordinal":119130,"en":"Before his father Aziz Khan,"},{"id":"semetey-1-2013:p0555:b003:l011","ordinal":119131,"en":"“I have borne a son!” she said,"},{"id":"semetey-1-2013:p0555:b003:l012","ordinal":119132,"en":"And went to bring the joyful news."},{"id":"semetey-1-2013:p0555:b003:l013","ordinal":119133,"en":"Aziz Khan in Beijing"},{"id":"semetey-1-2013:p0555:b003:l014","ordinal":119134,"en":"In his unfortunate mother"},{"id":"semetey-1-2013:p0555:b003:l015","ordinal":119135,"en":"Put little trust."},{"id":"semetey-1-2013:p0555:b003:l016","ordinal":119136,"en":"“She is the most beautiful of women,"},{"id":"semetey-1-2013:p0555:b003:l017","ordinal":119137,"en":"A girl who turned seventeen this year;"},{"id":"semetey-1-2013:p0555:b003:l018","ordinal":119138,"en":"It is not a year since I took her,"},{"id":"semetey-1-2013:p0555:b003:l019","ordinal":119139,"en":"It is not a month since I saw her;"},{"id":"semetey-1-2013:p0555:b003:l020","ordinal":119140,"en":"Her time to give birth has not come,"},{"id":"semetey-1-2013:p0555:b003:l021","ordinal":119141,"en":"The moment to bear her child has not come.”"},{"id":"semetey-1-2013:p0555:b003:l022","ordinal":119142,"en":"Nursing dark suspicion, Aziz Khan thought:"},{"id":"semetey-1-2013:p0555:b003:l023","ordinal":119143,"en":"“One who never wore drawers,"},{"id":"semetey-1-2013:p0555:b003:l024","ordinal":119144,"en":"Never sat down to urinate,"},{"id":"semetey-1-2013:p0555:b003:l025","ordinal":119145,"en":"Whose ox grew old and died by itself,"},{"id":"semetey-1-2013:p0555:b003:l026","ordinal":119146,"en":"Who divided the dead man's livestock equally,"},{"id":"semetey-1-2013:p0555:b003:l027","ordinal":119147,"en":"Who consecrated his goat,"},{"id":"semetey-1-2013:p0555:b003:l028","ordinal":119148,"en":"Who rode an unbroken horse,"},{"id":"semetey-1-2013:p0555:b003:l029","ordinal":119149,"en":"Who was a stranger to women—"},{"id":"semetey-1-2013:p0555:b003:l030","ordinal":119150,"en":"Could she have borne him by a monk?"},{"id":"semetey-1-2013:p0555:b003:l031","ordinal":119151,"en":"Or by one who often roamed at night,"},{"id":"semetey-1-2013:p0555:b003:l032","ordinal":119152,"en":"Could she have borne him by a wrestler?"},{"id":"semetey-1-2013:p0555:b003:l033","ordinal":119153,"en":"If he is another man's son,"},{"id":"semetey-1-2013:p0555:b003:l034","ordinal":119154,"en":"Let me cut off his head at once;"},{"id":"semetey-1-2013:p0555:b003:l035","ordinal":119155,"en":"If he is my own son,"},{"id":"semetey-1-2013:p0555:b003:l036","ordinal":119156,"en":"Let me rear him very well.”"},{"id":"semetey-1-2013:p0555:b003:l037","ordinal":119157,"en":"Saying this, Aziz Khan"},{"id":"semetey-1-2013:p0555:b003:l038","ordinal":119158,"en":"Summoned his calculator,"},{"id":"semetey-1-2013:p0555:b003:l039","ordinal":119159,"en":"Who reckoned the days,"},{"id":"semetey-1-2013:p0555:b005:l001","ordinal":119160,"en":"Dividing the reckoning of years a thousandfold,"},{"id":"semetey-1-2013:p0555:b005:l002","ordinal":119161,"en":"Comparing year with year,"},{"id":"semetey-1-2013:p0555:b005:l003","ordinal":119162,"en":"Dividing the reckoning of months a thousandfold,"},{"id":"semetey-1-2013:p0555:b005:l004","ordinal":119163,"en":"Comparing month with month."},{"id":"semetey-1-2013:p0555:b005:l005","ordinal":119164,"en":"“Since I took this wife,"},{"id":"semetey-1-2013:p0555:b005:l006","ordinal":119165,"en":"Nine months are complete,” he said."},{"id":"semetey-1-2013:p0555:b005:l007","ordinal":119166,"en":"“This child she has borne"},{"id":"semetey-1-2013:p0555:b005:l008","ordinal":119167,"en":"Has proved to be my own son.”"},{"id":"semetey-1-2013:p0555:b005:l009","ordinal":119168,"en":"Beating drums, holding a feast,"},{"id":"semetey-1-2013:p0555:b005:l010","ordinal":119169,"en":"The people of the world gathered,"},{"id":"semetey-1-2013:p0555:b005:l011","ordinal":119170,"en":"The Chinese people held a feast."},{"id":"semetey-1-2013:p0555:b005:l012","ordinal":119171,"en":"Rain scattered from the heavens,"},{"id":"semetey-1-2013:p0555:b005:l013","ordinal":119172,"en":"God's radiance opened upon the earth,"},{"id":"semetey-1-2013:p0555:b005:l014","ordinal":119173,"en":"Blessings poured forth in abundance,"},{"id":"semetey-1-2013:p0555:b005:l015","ordinal":119174,"en":"Receiving food sufficient for forty years,"},{"id":"semetey-1-2013:p0555:b005:l016","ordinal":119175,"en":"The people of Beijing ate their fill."},{"id":"semetey-1-2013:p0555:b005:l017","ordinal":119176,"en":"He was given the name Almambet."},{"id":"semetey-1-2013:p0555:b005:l018","ordinal":119177,"en":"Sarala, the horse beneath him,"},{"id":"semetey-1-2013:p0555:b005:l019","ordinal":119178,"en":"Joined him when he was as small as a thumb,"},{"id":"semetey-1-2013:p0555:b005:l020","ordinal":119179,"en":"United with him when he was tiny as a louse,"},{"id":"semetey-1-2013:p0555:b005:l021","ordinal":119180,"en":"Girding his waist firmly,"},{"id":"semetey-1-2013:p0555:b005:l022","ordinal":119181,"en":"The two were born upon one day."},{"id":"semetey-1-2013:p0555:b005:l023","ordinal":119182,"en":"Aziz Khan in Beijing said:"},{"id":"semetey-1-2013:p0555:b005:l024","ordinal":119183,"en":"“Before this I took sixty wives,"},{"id":"semetey-1-2013:p0555:b005:l026","ordinal":119184,"en":"But never saw an offspring."},{"id":"semetey-1-2013:p0555:b005:l027","ordinal":119185,"en":"In my eighty-ninth year"},{"id":"semetey-1-2013:p0555:b005:l028","ordinal":119186,"en":"I have gained this Almambet.”"},{"id":"semetey-1-2013:p0555:b005:l029","ordinal":119187,"en":"Hanging an amulet about his neck,"},{"id":"semetey-1-2013:p0555:b005:l030","ordinal":119188,"en":"He had the sixty poor wives"},{"id":"semetey-1-2013:p0555:b005:l031","ordinal":119189,"en":"Rear him as their child."},{"id":"semetey-1-2013:p0555:b005:l032","ordinal":119190,"en":"While he lived with Aziz Khan,"},{"id":"semetey-1-2013:p0555:b005:l033","ordinal":119191,"en":"He had not yet entered the faith;"},{"id":"semetey-1-2013:p0555:b005:l034","ordinal":119192,"en":"Alake had not yet learned what was true."},{"id":"semetey-1-2013:p0555:b005:l035","ordinal":119193,"en":"Naked, without a shirt,"},{"id":"semetey-1-2013:p0555:b005:l036","ordinal":119194,"en":"His precious hair as black as coal,"},{"id":"semetey-1-2013:p0555:b005:l037","ordinal":119195,"en":"He had reached the age of six."},{"id":"semetey-1-2013:p0555:b005:l038","ordinal":119196,"en":"When his age reached six,"},{"id":"semetey-1-2013:p0555:b005:l039","ordinal":119197,"en":"Sarala had grown into a mature horse,"},{"id":"semetey-1-2013:p0556:b003:l001","ordinal":119198,"en":"He saddled Sarala."},{"id":"semetey-1-2013:p0556:b003:l002","ordinal":119199,"en":"“This is our God,” he said,"},{"id":"semetey-1-2013:p0556:b003:l003","ordinal":119200,"en":"And read Chinese writings."},{"id":"semetey-1-2013:p0556:b003:l004","ordinal":119201,"en":"In the fortress of Beijing,"},{"id":"semetey-1-2013:p0556:b003:l005","ordinal":119202,"en":"When his age reached six,"},{"id":"semetey-1-2013:p0556:b003:l006","ordinal":119203,"en":"Aziz Khan in Beijing"},{"id":"semetey-1-2013:p0556:b003:l007","ordinal":119204,"en":"Had drawn the line,"},{"id":"semetey-1-2013:p0556:b003:l008","ordinal":119205,"en":"Upon Alake Khan's head"},{"id":"semetey-1-2013:p0556:b003:l009","ordinal":119206,"en":"Had begun to bring turmoil."},{"id":"semetey-1-2013:p0556:b003:l010","ordinal":119207,"en":"Roaring in anger,"},{"id":"semetey-1-2013:p0556:b003:l011","ordinal":119208,"en":"“My foal, come here!” he said,"},{"id":"semetey-1-2013:p0556:b003:l012","ordinal":119209,"en":"Calling my precious Alake."},{"id":"semetey-1-2013:p0556:b003:l013","ordinal":119210,"en":"“Almambet, my spring that feeds a flowing river,"},{"id":"semetey-1-2013:p0556:b003:l014","ordinal":119211,"en":"My little one, whom I gained through mortal hardship!"},{"id":"semetey-1-2013:p0556:b003:l015","ordinal":119212,"en":"Alööke Khan, Aziz Khan,"},{"id":"semetey-1-2013:p0556:b003:l016","ordinal":119213,"en":"Karykan, khan of Beijing,"},{"id":"semetey-1-2013:p0556:b003:l017","ordinal":119214,"en":"And Esen—the four are brothers."},{"id":"semetey-1-2013:p0556:b003:l018","ordinal":119215,"en":"From the hearth came an ember;"},{"id":"semetey-1-2013:p0556:b003:l019","ordinal":119216,"en":"From Alööke, Konurbai"},{"id":"semetey-1-2013:p0556:b003:l020","ordinal":119217,"en":"Emerged a merciless tyrant."},{"id":"semetey-1-2013:p0556:b003:l021","ordinal":119218,"en":"My source of tea,"},{"id":"semetey-1-2013:p0556:b003:l022","ordinal":119219,"en":"My land he seized,"},{"id":"semetey-1-2013:p0556:b003:l023","ordinal":119220,"en":"And I suffered humiliation from him!"},{"id":"semetey-1-2013:p0556:b003:l024","ordinal":119221,"en":"Börüköz, Esen Khan's son,"},{"id":"semetey-1-2013:p0556:b003:l025","ordinal":119222,"en":"My mine where gold was dug,"},{"id":"semetey-1-2013:p0556:b003:l026","ordinal":119223,"en":"That swine seized it."},{"id":"semetey-1-2013:p0556:b003:l028","ordinal":119224,"en":"He too took away my people,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0556:b003:l029","ordinal":119225,"en":"And I suffered humiliation from him!"},{"id":"semetey-1-2013:p0556:b003:l030","ordinal":119226,"en":"Grow to maturity, become a hero,"},{"id":"semetey-1-2013:p0556:b003:l031","ordinal":119227,"en":"Alake, become the equal of a hero's son."},{"id":"semetey-1-2013:p0556:b003:l032","ordinal":119228,"en":"Alööke's Konurbai—"},{"id":"semetey-1-2013:p0556:b003:l033","ordinal":119229,"en":"Make him call you Aziz Khan's son;"},{"id":"semetey-1-2013:p0556:b003:l034","ordinal":119230,"en":"Bring great havoc upon him,"},{"id":"semetey-1-2013:p0556:b003:l035","ordinal":119231,"en":"The tea-producing land he seized,"},{"id":"semetey-1-2013:p0556:b003:l036","ordinal":119232,"en":"Wrest it back from the scoundrel for me."},{"id":"semetey-1-2013:p0556:b003:l037","ordinal":119233,"en":"If Kalcha falls into your hands,"},{"id":"semetey-1-2013:p0556:b003:l038","ordinal":119234,"en":"Bring great havoc upon him."},{"id":"semetey-1-2013:p0556:b003:l039","ordinal":119235,"en":"If you truly are my son,"},{"id":"semetey-1-2013:p0556:b004:l001","ordinal":119236,"en":"My child, avenge me far and wide!"},{"id":"semetey-1-2013:p0556:b004:l002","ordinal":119237,"en":"At that lake called Abergen,"},{"id":"semetey-1-2013:p0556:b004:l003","ordinal":119238,"en":"In the uplands of Suuk-Tör,"},{"id":"semetey-1-2013:p0556:b004:l004","ordinal":119239,"en":"In the land of the One-Eyed,"},{"id":"semetey-1-2013:p0556:b004:l005","ordinal":119240,"en":"There is a sixty-headed dragon,"},{"id":"semetey-1-2013:p0556:b004:l006","ordinal":119241,"en":"An exceedingly mighty sorcerer."},{"id":"semetey-1-2013:p0556:b004:l007","ordinal":119242,"en":"Saddle Sarala and set out;"},{"id":"semetey-1-2013:p0556:b004:l008","ordinal":119243,"en":"Go learn spells in his presence."},{"id":"semetey-1-2013:p0556:b004:l009","ordinal":119244,"en":"If you fight in darkness,"},{"id":"semetey-1-2013:p0556:b004:l010","ordinal":119245,"en":"He will teach the ways of night."},{"id":"semetey-1-2013:p0556:b004:l011","ordinal":119246,"en":"You need not fear entering a firefight;"},{"id":"semetey-1-2013:p0556:b004:l012","ordinal":119247,"en":"He will teach the ways of embers."},{"id":"semetey-1-2013:p0556:b004:l013","ordinal":119248,"en":"So you cannot be overcome in shooting,"},{"id":"semetey-1-2013:p0556:b004:l014","ordinal":119249,"en":"He will teach the ways of bullets."},{"id":"semetey-1-2013:p0556:b004:l015","ordinal":119250,"en":"By casting spells upon a summer day,"},{"id":"semetey-1-2013:p0556:b004:l016","ordinal":119251,"en":"He will teach how to make it winter."},{"id":"semetey-1-2013:p0556:b004:l017","ordinal":119252,"en":"The thinly clad Chinese,"},{"id":"semetey-1-2013:p0556:b004:l018","ordinal":119253,"en":"Making them shiver, my foal,"},{"id":"semetey-1-2013:p0556:b004:l019","ordinal":119254,"en":"He will teach a spell to turn into girls."},{"id":"semetey-1-2013:p0556:b004:l020","ordinal":119255,"en":"Many people have gone to that place;"},{"id":"semetey-1-2013:p0556:b004:l021","ordinal":119256,"en":"No one has returned.”"},{"id":"semetey-1-2013:p0556:b004:l022","ordinal":119257,"en":"Mounting him on Sarala,"},{"id":"semetey-1-2013:p0556:b004:l023","ordinal":119258,"en":"Clothing him in a bulletproof coat,"},{"id":"semetey-1-2013:p0556:b004:l024","ordinal":119259,"en":"Aziz Khan spoke:"},{"id":"semetey-1-2013:p0556:b004:l025","ordinal":119260,"en":"“Go master the spells and return;"},{"id":"semetey-1-2013:p0556:b004:l026","ordinal":119261,"en":"Go see many wonders and return."},{"id":"semetey-1-2013:p0556:b004:l027","ordinal":119262,"en":"If you are worthy, my Alake,"},{"id":"semetey-1-2013:p0556:b004:l028","ordinal":119263,"en":"Bring havoc upon them;"},{"id":"semetey-1-2013:p0556:b004:l029","ordinal":119264,"en":"Konurbai and Börüköz,"},{"id":"semetey-1-2013:p0556:b004:l030","ordinal":119265,"en":"Split them open upon the road;"},{"id":"semetey-1-2013:p0556:b004:l031","ordinal":119266,"en":"Take my vengeance far and wide upon the scoundrels!"},{"id":"semetey-1-2013:p0556:b004:l033","ordinal":119267,"en":"If you are worthless, my foal,"},{"id":"semetey-1-2013:p0556:b004:l034","ordinal":119268,"en":"It is better that I have no child."},{"id":"semetey-1-2013:p0556:b004:l035","ordinal":119269,"en":"An early childless, bereft soul—"},{"id":"semetey-1-2013:p0556:b004:l036","ordinal":119270,"en":"O child, go on from there and die."},{"id":"semetey-1-2013:p0556:b004:l037","ordinal":119271,"en":"The dragon's mighty teaching,"},{"id":"semetey-1-2013:p0556:b004:l038","ordinal":119272,"en":"My child Alake, go and see!”"},{"id":"semetey-1-2013:p0556:b004:l039","ordinal":119273,"en":"In the first year of study,"},{"id":"semetey-1-2013:p0557:b003:l001","ordinal":119274,"en":"He sent six thousand children."},{"id":"semetey-1-2013:p0557:b003:l002","ordinal":119275,"en":"When he first set off to study,"},{"id":"semetey-1-2013:p0557:b003:l003","ordinal":119276,"en":"His sixty stepmothers"},{"id":"semetey-1-2013:p0557:b003:l004","ordinal":119277,"en":"All wept and sobbed,"},{"id":"semetey-1-2013:p0557:b003:l005","ordinal":119278,"en":"Every one of them urinating blood,"},{"id":"semetey-1-2013:p0557:b003:l006","ordinal":119279,"en":"“Go into the earth with your child!”"},{"id":"semetey-1-2013:p0557:b003:l007","ordinal":119280,"en":"They cried out, “Alake!”"},{"id":"semetey-1-2013:p0557:b003:l008","ordinal":119281,"en":"From the tribute-paying Chinese,"},{"id":"semetey-1-2013:p0557:b003:l009","ordinal":119282,"en":"In the first year of study,"},{"id":"semetey-1-2013:p0557:b003:l010","ordinal":119283,"en":"Six thousand children went,"},{"id":"semetey-1-2013:p0557:b003:l011","ordinal":119284,"en":"Six thousand were slaughtered,"},{"id":"semetey-1-2013:p0557:b003:l012","ordinal":119285,"en":"Six children remained."},{"id":"semetey-1-2013:p0557:b003:l013","ordinal":119286,"en":"Seven thousand children went,"},{"id":"semetey-1-2013:p0557:b003:l014","ordinal":119287,"en":"Seven thousand were slaughtered,"},{"id":"semetey-1-2013:p0557:b003:l015","ordinal":119288,"en":"Seven children remained."},{"id":"semetey-1-2013:p0557:b003:l016","ordinal":119289,"en":"Nine thousand children went,"},{"id":"semetey-1-2013:p0557:b003:l017","ordinal":119290,"en":"Nine thousand were slaughtered,"},{"id":"semetey-1-2013:p0557:b003:l018","ordinal":119291,"en":"Nine children remained."},{"id":"semetey-1-2013:p0557:b003:l019","ordinal":119292,"en":"Ten thousand children went,"},{"id":"semetey-1-2013:p0557:b003:l020","ordinal":119293,"en":"Ten thousand children were slaughtered,"},{"id":"semetey-1-2013:p0557:b003:l021","ordinal":119294,"en":"Only ten children remained,"},{"id":"semetey-1-2013:p0557:b003:l022","ordinal":119295,"en":"Among them a lion like my Alake."},{"id":"semetey-1-2013:p0557:b003:l023","ordinal":119296,"en":"When he had finished his learning,"}]
