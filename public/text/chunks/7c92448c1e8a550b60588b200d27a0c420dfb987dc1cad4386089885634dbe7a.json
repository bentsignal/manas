[{"id":"semetey-1-2013:p1312:b004:l039","ordinal":177409,"en":"And rummage through one of your bags."},{"id":"semetey-1-2013:p1312:b004:l040","ordinal":177410,"en":"I will strike your caravan from Keng-Kol,"},{"id":"semetey-1-2013:p1313:b003:l001","ordinal":177411,"en":"From the swaggering villain,"},{"id":"semetey-1-2013:p1313:b003:l002","ordinal":177412,"en":"I will take my revenge!”"},{"id":"semetey-1-2013:p1313:b003:l003","ordinal":177413,"en":"His mind turned elsewhere,"},{"id":"semetey-1-2013:p1313:b003:l004","ordinal":177414,"en":"And the treachery of the swaggering butcher"},{"id":"semetey-1-2013:p1313:b003:l005","ordinal":177415,"en":"Became apparent."},{"id":"semetey-1-2013:p1313:b003:l006","ordinal":177416,"en":"Their quarrel was over a horse,"},{"id":"semetey-1-2013:p1313:b003:l007","ordinal":177417,"en":"And Kanchoro became estranged."},{"id":"semetey-1-2013:p1313:b003:l008","ordinal":177418,"en":"With his eyes clouded,"},{"id":"semetey-1-2013:p1313:b003:l009","ordinal":177419,"en":"Kanchoro came to seek a fight."},{"id":"semetey-1-2013:p1313:b003:l010","ordinal":177420,"en":"He grieved over Surkoyon,"},{"id":"semetey-1-2013:p1313:b003:l011","ordinal":177421,"en":"And in the end became an enemy."},{"id":"semetey-1-2013:p1313:b003:l012","ordinal":177422,"en":"All the Jediger"},{"id":"semetey-1-2013:p1313:b003:l013","ordinal":177423,"en":"Were slaughtered by the blue-maned wolf,"},{"id":"semetey-1-2013:p1313:b003:l014","ordinal":177424,"en":"Both Chynkojo and old Toltoy."},{"id":"semetey-1-2013:p1313:b003:l015","ordinal":177425,"en":"They had quarreled precisely"},{"id":"semetey-1-2013:p1313:b003:l016","ordinal":177426,"en":"Over Akun's daughter Ayçürök,"},{"id":"semetey-1-2013:p1313:b003:l017","ordinal":177427,"en":"And all were slaughtered."},{"id":"semetey-1-2013:p1313:b003:l018","ordinal":177428,"en":"Among the great Afghan people,"},{"id":"semetey-1-2013:p1313:b003:l019","ordinal":177429,"en":"The best at taking spoil"},{"id":"semetey-1-2013:p1313:b003:l020","ordinal":177430,"en":"Took six hundred horses each;"},{"id":"semetey-1-2013:p1313:b003:l021","ordinal":177431,"en":"The lesser men who could not seize as much"},{"id":"semetey-1-2013:p1313:b003:l022","ordinal":177432,"en":"Took sixty horses each."},{"id":"semetey-1-2013:p1313:b003:l023","ordinal":177433,"en":"The accomplished blue-maned wolves"},{"id":"semetey-1-2013:p1313:b004:l001","ordinal":177434,"en":"Took seven hundred spoils each."},{"id":"semetey-1-2013:p1313:b004:l002","ordinal":177435,"en":"The lesser men who could not reach them"},{"id":"semetey-1-2013:p1313:b004:l003","ordinal":177436,"en":"Took seventy spoils each."},{"id":"semetey-1-2013:p1313:b004:l004","ordinal":177437,"en":"They struck the Jediger and took cloth,"},{"id":"semetey-1-2013:p1313:b004:l005","ordinal":177438,"en":"Loaded cloth and took gold coins."},{"id":"semetey-1-2013:p1313:b004:l006","ordinal":177439,"en":"As spoil from that people,"},{"id":"semetey-1-2013:p1313:b004:l007","ordinal":177440,"en":"They took five girls with braided forelocks."},{"id":"semetey-1-2013:p1313:b004:l008","ordinal":177441,"en":"There was honor among all who knew;"},{"id":"semetey-1-2013:p1313:b004:l009","ordinal":177442,"en":"Khan Akun's Afghanistan,"},{"id":"semetey-1-2013:p1313:b004:l010","ordinal":177443,"en":"Saying, “Our hostile enemy is dead,”"},{"id":"semetey-1-2013:p1313:b004:l011","ordinal":177444,"en":"Set its heart at ease and was fulfilled."},{"id":"semetey-1-2013:p1313:b004:l012","ordinal":177445,"en":"They slaughtered a mare for Babadin,"},{"id":"semetey-1-2013:p1313:b004:l013","ordinal":177446,"en":"And in their joy scattered"},{"id":"semetey-1-2013:p1313:b004:l014","ordinal":177447,"en":"Yellow gold from the treasury."},{"id":"semetey-1-2013:p1313:b004:l015","ordinal":177448,"en":"Old Akun of Afghanistan"},{"id":"semetey-1-2013:p1313:b004:l016","ordinal":177449,"en":"Climbed atop the tower"},{"id":"semetey-1-2013:p1313:b004:l017","ordinal":177450,"en":"And made a proclamation."},{"id":"semetey-1-2013:p1313:b004:l018","ordinal":177451,"en":"After God had truly bestowed his favor,"},{"id":"semetey-1-2013:p1313:b004:l019","ordinal":177452,"en":"After he had seen Semetey,"},{"id":"semetey-1-2013:p1313:b004:l020","ordinal":177453,"en":"“My dear, great people,"},{"id":"semetey-1-2013:p1313:b004:l021","ordinal":177454,"en":"Now that my extinguished fire has kindled,"},{"id":"semetey-1-2013:p1313:b004:l022","ordinal":177455,"en":"I have resolved in joy:"},{"id":"semetey-1-2013:p1313:b004:l023","ordinal":177456,"en":"I will hold Chürök's wedding feast."},{"id":"semetey-1-2013:p1313:b006:l001","ordinal":177457,"en":"“I will slaughter ninety sheep for the feast,"},{"id":"semetey-1-2013:p1313:b006:l002","ordinal":177458,"en":"And slaughter all fitting animals as offerings."},{"id":"semetey-1-2013:p1313:b006:l003","ordinal":177459,"en":"I will gather the multitude,"},{"id":"semetey-1-2013:p1313:b006:l004","ordinal":177460,"en":"And make merry to gladden the people;"},{"id":"semetey-1-2013:p1313:b006:l005","ordinal":177461,"en":"For Ayçürök and Semetey,"},{"id":"semetey-1-2013:p1313:b006:l006","ordinal":177462,"en":"For these two I will hold a wedding feast."},{"id":"semetey-1-2013:p1313:b006:l007","ordinal":177463,"en":"My child Ayçürök,"},{"id":"semetey-1-2013:p1313:b006:l008","ordinal":177464,"en":"Yesterday, when my beard was already white,"},{"id":"semetey-1-2013:p1313:b006:l009","ordinal":177465,"en":"While I was on a journey,"},{"id":"semetey-1-2013:p1313:b006:l010","ordinal":177466,"en":"In the desert of Mediyan,"},{"id":"semetey-1-2013:p1313:b006:l011","ordinal":177467,"en":"At the shrine of Babadin,"},{"id":"semetey-1-2013:p1313:b006:l012","ordinal":177468,"en":"On the pass of the direct road,"},{"id":"semetey-1-2013:p1313:b008:l001","ordinal":177469,"en":"I found my Chürök."},{"id":"semetey-1-2013:p1313:b008:l002","ordinal":177470,"en":"There are two fateful sayings;"},{"id":"semetey-1-2013:p1313:b008:l003","ordinal":177471,"en":"Some people say"},{"id":"semetey-1-2013:p1313:b008:l004","ordinal":177472,"en":"Chürök is a peri's daughter."},{"id":"semetey-1-2013:p1313:b008:l005","ordinal":177473,"en":"Could I fail to give my noble child"},{"id":"semetey-1-2013:p1313:b008:l006","ordinal":177474,"en":"To her rightful master?”"},{"id":"semetey-1-2013:p1313:b008:l007","ordinal":177475,"en":"Driving seventy red camels,"},{"id":"semetey-1-2013:p1313:b008:l008","ordinal":177476,"en":"To bear loads when they migrated,"},{"id":"semetey-1-2013:p1313:b008:l009","ordinal":177477,"en":"He fully prepared the pack animals;"},{"id":"semetey-1-2013:p1313:b008:l010","ordinal":177478,"en":"Khan Akun made his testament."},{"id":"semetey-1-2013:p1313:b008:l011","ordinal":177479,"en":"Having overcome the great enemy,"},{"id":"semetey-1-2013:p1313:b008:l012","ordinal":177480,"en":"Semetey received great honor."},{"id":"semetey-1-2013:p1314:b003:l001","ordinal":177481,"en":"He gave Ayçürök,"},{"id":"semetey-1-2013:p1314:b003:l002","ordinal":177482,"en":"And his people witnessed the giving."},{"id":"semetey-1-2013:p1314:b003:l003","ordinal":177483,"en":"He gathered exactly ninety"},{"id":"semetey-1-2013:p1314:b003:l004","ordinal":177484,"en":"Khojas and mullahs."},{"id":"semetey-1-2013:p1314:b003:l005","ordinal":177485,"en":"They held the feast for twelve days,"},{"id":"semetey-1-2013:p1314:b003:l006","ordinal":177486,"en":"The peoples gathering at the celebration,"},{"id":"semetey-1-2013:p1314:b003:l007","ordinal":177487,"en":"And had the marriage contract solemnized as proof."},{"id":"semetey-1-2013:p1314:b003:l008","ordinal":177488,"en":"He gathered in the treasury"},{"id":"semetey-1-2013:p1314:b003:l009","ordinal":177489,"en":"The many goods to be given to Chürök."},{"id":"semetey-1-2013:p1314:b003:l010","ordinal":177490,"en":"Driving sixty red pack-camels,"},{"id":"semetey-1-2013:p1314:b003:l011","ordinal":177491,"en":"“Let my child Chürök live on these"},{"id":"semetey-1-2013:p1314:b003:l012","ordinal":177492,"en":"Until Judgment Day,” he said."},{"id":"semetey-1-2013:p1314:b003:l013","ordinal":177493,"en":"Loading ornaments of red gold,"},{"id":"semetey-1-2013:p1314:b003:l014","ordinal":177494,"en":"Driving seventy red camels,"},{"id":"semetey-1-2013:p1314:b003:l015","ordinal":177495,"en":"Loading seven bales of cloth,"},{"id":"semetey-1-2013:p1314:b003:l016","ordinal":177496,"en":"And in Ajybay's charge,"},{"id":"semetey-1-2013:p1314:b003:l017","ordinal":177497,"en":"Exactly twenty-one red camels"},{"id":"semetey-1-2013:p1314:b003:l018","ordinal":177498,"en":"He had kneel by the treasury."},{"id":"semetey-1-2013:p1314:b003:l019","ordinal":177499,"en":"For pitching at encampments,"},{"id":"semetey-1-2013:p1314:b003:l020","ordinal":177500,"en":"He loaded a Kyrgyz felt yurt."},{"id":"semetey-1-2013:p1314:b003:l021","ordinal":177501,"en":"The wonder of that dwelling was this:"},{"id":"semetey-1-2013:p1314:b003:l022","ordinal":177502,"en":"Its crown was gold, its ropes were copper;"},{"id":"semetey-1-2013:p1314:b003:l023","ordinal":177503,"en":"The roof-cover of that dwelling"},{"id":"semetey-1-2013:p1314:b003:l024","ordinal":177504,"en":"Was silk satin outside."},{"id":"semetey-1-2013:p1314:b003:l025","ordinal":177505,"en":"He let Chürök, Akun's daughter,"},{"id":"semetey-1-2013:p1314:b003:l026","ordinal":177506,"en":"Make merry for thirty days,"},{"id":"semetey-1-2013:p1314:b003:l027","ordinal":177507,"en":"And sing plaintively for forty-one days."},{"id":"semetey-1-2013:p1314:b003:l028","ordinal":177508,"en":"For Akun's daughter, his only girl,"},{"id":"semetey-1-2013:p1314:b003:l029","ordinal":177509,"en":"With a waist like the moon in a red dress,"},{"id":"semetey-1-2013:p1314:b003:l030","ordinal":177510,"en":"From among the dazzling beauties"},{"id":"semetey-1-2013:p1314:b003:l031","ordinal":177511,"en":"He gave maiden attendants."},{"id":"semetey-1-2013:p1314:b003:l032","ordinal":177512,"en":"With broad rumps and wide hair ornaments,"},{"id":"semetey-1-2013:p1314:b003:l033","ordinal":177513,"en":"Graceful and camel-eyed,"},{"id":"semetey-1-2013:p1314:b003:l034","ordinal":177514,"en":"He gave married-woman attendants."},{"id":"semetey-1-2013:p1314:b003:l035","ordinal":177515,"en":"Extinguishing the fire she had kindled,"},{"id":"semetey-1-2013:p1314:b003:l036","ordinal":177516,"en":"They moved fortunate Chürök"},{"id":"semetey-1-2013:p1314:b003:l037","ordinal":177517,"en":"Toward Talas."},{"id":"semetey-1-2013:p1314:b003:l038","ordinal":177518,"en":"Upon Chürök, like the full moon,"},{"id":"semetey-1-2013:p1314:b004:l001","ordinal":177519,"en":"They put garments flowered with silk,"},{"id":"semetey-1-2013:p1314:b004:l002","ordinal":177520,"en":"And mounted her on a bay piebald pacer."},{"id":"semetey-1-2013:p1314:b004:l003","ordinal":177521,"en":"Mounted on a pale bay pacer, swaying,"},{"id":"semetey-1-2013:p1314:b004:l004","ordinal":177522,"en":"She migrated out of Afghanistan,"},{"id":"semetey-1-2013:p1314:b004:l005","ordinal":177523,"en":"Shining in a long robe."},{"id":"semetey-1-2013:p1314:b004:l006","ordinal":177524,"en":"Mounted on a gray pacer, swaying,"},{"id":"semetey-1-2013:p1314:b004:l007","ordinal":177525,"en":"She migrated out of Afghanistan,"},{"id":"semetey-1-2013:p1314:b004:l008","ordinal":177526,"en":"Shining in a sumptuous robe."},{"id":"semetey-1-2013:p1314:b004:l009","ordinal":177527,"en":"Like flowers growing in a mirror,"},{"id":"semetey-1-2013:p1314:b004:l010","ordinal":177528,"en":"She migrated out of Afghanistan,"},{"id":"semetey-1-2013:p1314:b004:l011","ordinal":177529,"en":"Like demons departing at dusk."},{"id":"semetey-1-2013:p1314:b004:l012","ordinal":177530,"en":"Arrayed like a noblewoman,"},{"id":"semetey-1-2013:p1314:b004:l013","ordinal":177531,"en":"Swaying as though struck by a peri,"},{"id":"semetey-1-2013:p1314:b004:l014","ordinal":177532,"en":"She left Afghanistan and traveled on."},{"id":"semetey-1-2013:p1314:b004:l015","ordinal":177533,"en":"They rode far without sparing the horses;"},{"id":"semetey-1-2013:p1314:b004:l016","ordinal":177534,"en":"Whenever she looked to the joyful side,"},{"id":"semetey-1-2013:p1314:b004:l017","ordinal":177535,"en":"There was entertainment all along the road."},{"id":"semetey-1-2013:p1314:b004:l018","ordinal":177536,"en":"“It is the land left by my father,” she said,"},{"id":"semetey-1-2013:p1314:b004:l019","ordinal":177537,"en":"And came to settle in Talas,"},{"id":"semetey-1-2013:p1314:b004:l020","ordinal":177538,"en":"In the land won by her father,"},{"id":"semetey-1-2013:p1314:b004:l021","ordinal":177539,"en":"Among the people left by her father."},{"id":"semetey-1-2013:p1314:b004:l022","ordinal":177540,"en":"Ayçürök, daughter of Akun,"},{"id":"semetey-1-2013:p1314:b004:l023","ordinal":177541,"en":"Whom their fathers had betrothed,"},{"id":"semetey-1-2013:p1314:b004:l024","ordinal":177542,"en":"Found a homeland like broad Talas"},{"id":"semetey-1-2013:p1314:b004:l025","ordinal":177543,"en":"And found a husband like Semetey."},{"id":"semetey-1-2013:p1314:b004:l026","ordinal":177544,"en":"After blood-red slaughter and empty clamor,"},{"id":"semetey-1-2013:p1314:b004:l027","ordinal":177545,"en":"The time came when Semetey"},{"id":"semetey-1-2013:p1314:b004:l028","ordinal":177546,"en":"Took Ayçürök,"},{"id":"semetey-1-2013:p1314:b004:l029","ordinal":177547,"en":"And his soul found peace."},{"id":"semetey-1-2013:p1314:b004:l030","ordinal":177548,"en":"Semetey, son of Manas,"},{"id":"semetey-1-2013:p1314:b004:l031","ordinal":177549,"en":"Could die without regret."},{"id":"semetey-1-2013:p1314:b004:l032","ordinal":177550,"en":"Like a dark, rugged mountain,"},{"id":"semetey-1-2013:p1314:b004:l033","ordinal":177551,"en":"On that day no one remained"},{"id":"semetey-1-2013:p1314:b004:l034","ordinal":177552,"en":"Who could cast a lasso upon the prince."},{"id":"semetey-1-2013:p1314:b004:l035","ordinal":177553,"en":"His fortune came fully into balance,"},{"id":"semetey-1-2013:p1314:b004:l036","ordinal":177554,"en":"A lion supported by the spirit emerged,"},{"id":"semetey-1-2013:p1314:b004:l037","ordinal":177555,"en":"And from his father, blue-maned Manas,"},{"id":"semetey-1-2013:p1314:b004:l038","ordinal":177556,"en":"An even greater hero emerged."},{"id":"semetey-1-2013:p1315:b004:l001","ordinal":177557,"en":"At Kara-Buura and Chatkal,"},{"id":"semetey-1-2013:p1315:b004:l002","ordinal":177558,"en":"While the Argyn ranged over the highlands,"},{"id":"semetey-1-2013:p1315:b004:l003","ordinal":177559,"en":"In the delightful plain of Keng-Kol,"},{"id":"semetey-1-2013:p1315:b004:l004","ordinal":177560,"en":"Along broad Talas,"},{"id":"semetey-1-2013:p1315:b004:l005","ordinal":177561,"en":"When the Argyn and Kyrgyz chose the valley"},{"id":"semetey-1-2013:p1315:b004:l006","ordinal":177562,"en":"And were encamped there,"},{"id":"semetey-1-2013:p1315:b004:l007","ordinal":177563,"en":"With kumis by day and girls by night,"},{"id":"semetey-1-2013:p1315:b004:l008","ordinal":177564,"en":"Such was their life."},{"id":"semetey-1-2013:p1315:b004:l009","ordinal":177565,"en":"When paired alaba coats* and sable caps"},{"id":"semetey-1-2013:p1315:b004:l010","ordinal":177566,"en":"Were worn with swagger,"},{"id":"semetey-1-2013:p1315:b004:l011","ordinal":177567,"en":"When the Kyrgyz had gathered under one leader"},{"id":"semetey-1-2013:p1315:b004:l012","ordinal":177568,"en":"And lived in delight,"},{"id":"semetey-1-2013:p1315:b004:l013","ordinal":177569,"en":"Shooting roe deer when they grew bored,"},{"id":"semetey-1-2013:p1315:b004:l014","ordinal":177570,"en":"And when not bored, freely"},{"id":"semetey-1-2013:p1315:b004:l015","ordinal":177571,"en":"Holding games in Talas."},{"id":"semetey-1-2013:p1315:b004:l016","ordinal":177572,"en":"The khan's game was of another order,"},{"id":"semetey-1-2013:p1315:b004:l017","ordinal":177573,"en":"The dear sultan, splendid hero;"},{"id":"semetey-1-2013:p1315:b004:l018","ordinal":177574,"en":"Among the yellow settlements of broad Talas"},{"id":"semetey-1-2013:p1315:b004:l019","ordinal":177575,"en":"They laid out an ordo forty paces wide,"},{"id":"semetey-1-2013:p1315:b004:l020","ordinal":177576,"en":"Played until their desire for victory was sated,"},{"id":"semetey-1-2013:p1315:b004:l021","ordinal":177577,"en":"And held splendid games."},{"id":"semetey-1-2013:p1315:b004:l022","ordinal":177578,"en":"The winners slaughtered and took"},{"id":"semetey-1-2013:p1315:b004:l023","ordinal":177579,"en":"Forty barren mares at a time."},{"id":"semetey-1-2013:p1315:b004:l024","ordinal":177580,"en":"In the garden planted at Talas,"},{"id":"semetey-1-2013:p1315:b004:l025","ordinal":177581,"en":"They sprawled at ease;"},{"id":"semetey-1-2013:p1315:b004:l026","ordinal":177582,"en":"In the garden planted at Keng-Kol,"},{"id":"semetey-1-2013:p1315:b004:l027","ordinal":177583,"en":"They stretched themselves out."},{"id":"semetey-1-2013:p1315:b004:l028","ordinal":177584,"en":"They divided a whole beaver pelt"},{"id":"semetey-1-2013:p1315:b004:l029","ordinal":177585,"en":"Into halves,"},{"id":"semetey-1-2013:p1315:b004:l030","ordinal":177586,"en":"Fastened them to their leggings,"},{"id":"semetey-1-2013:p1315:b004:l031","ordinal":177587,"en":"Mounted three-year-olds and flew birds,"},{"id":"semetey-1-2013:p1315:b004:l032","ordinal":177588,"en":"And grew wild with delight."},{"id":"semetey-1-2013:p1315:b004:l033","ordinal":177589,"en":"They brought no trouble upon the age;"},{"id":"semetey-1-2013:p1315:b004:l034","ordinal":177590,"en":"At that time no one remained"},{"id":"semetey-1-2013:p1315:b004:l035","ordinal":177591,"en":"Who could gainsay the gray wolf."},{"id":"semetey-1-2013:p1315:b004:l036","ordinal":177592,"en":"The horses had grown fat and restless,"},{"id":"semetey-1-2013:p1315:b004:l037","ordinal":177593,"en":"The heroes fat and pent-up;"},{"id":"semetey-1-2013:p1315:b006:l001","ordinal":177594,"en":"For vigorous youths and swift horses,"},{"id":"semetey-1-2013:p1315:b006:l002","ordinal":177595,"en":"The time had come to prove their worth."},{"id":"semetey-1-2013:p1315:b006:l003","ordinal":177596,"en":"At that time Semetey,"},{"id":"semetey-1-2013:p1315:b006:l004","ordinal":177597,"en":"Finding no mountain to strike,"},{"id":"semetey-1-2013:p1315:b006:l005","ordinal":177598,"en":"No enemy to fight,"},{"id":"semetey-1-2013:p1315:b006:l006","ordinal":177599,"en":"No land to burn,"},{"id":"semetey-1-2013:p1315:b006:l007","ordinal":177600,"en":"No hero with whom to die,"},{"id":"semetey-1-2013:p1315:b006:l008","ordinal":177601,"en":"Was overcome by different thoughts;"},{"id":"semetey-1-2013:p1315:b006:l009","ordinal":177602,"en":"In that poor lion-born hero,"},{"id":"semetey-1-2013:p1315:b006:l010","ordinal":177603,"en":"His bloodthirsty nature showed."},{"id":"semetey-1-2013:p1315:b006:l011","ordinal":177604,"en":"Finding no ranks to break,"},{"id":"semetey-1-2013:p1315:b006:l012","ordinal":177605,"en":"No unbroken rocky rampart,"},{"id":"semetey-1-2013:p1315:b006:l013","ordinal":177606,"en":"The noble lion, clear in wisdom,"},{"id":"semetey-1-2013:p1315:b006:l014","ordinal":177607,"en":"That dear hero like a lion,"},{"id":"semetey-1-2013:p1315:b006:l015","ordinal":177608,"en":"At the coming of true dawn,"},{"id":"semetey-1-2013:p1315:b006:l016","ordinal":177609,"en":"Started awake from sleep"},{"id":"semetey-1-2013:p1315:b006:l017","ordinal":177610,"en":"In Aichürök's embrace."},{"id":"semetey-1-2013:p1315:b006:l018","ordinal":177611,"en":"He turned in anger,"},{"id":"semetey-1-2013:p1315:b006:l019","ordinal":177612,"en":"Gathered himself like a lion;"},{"id":"semetey-1-2013:p1315:b006:l020","ordinal":177613,"en":"That champion, almost a saint,"},{"id":"semetey-1-2013:p1315:b006:l021","ordinal":177614,"en":"Had his former fury stirred."},{"id":"semetey-1-2013:p1315:b006:l022","ordinal":177615,"en":"When he sighed,"},{"id":"semetey-1-2013:p1315:b006:l023","ordinal":177616,"en":"Blue flame burst above his head;"},{"id":"semetey-1-2013:p1315:b006:l024","ordinal":177617,"en":"When wrath seized him,"},{"id":"semetey-1-2013:p1315:b006:l025","ordinal":177618,"en":"His true strength split stone."},{"id":"semetey-1-2013:p1315:b006:l026","ordinal":177619,"en":"He halted in anger,"},{"id":"semetey-1-2013:p1315:b006:l027","ordinal":177620,"en":"Appearing as a lion-prince,"},{"id":"semetey-1-2013:p1315:b006:l028","ordinal":177621,"en":"And lamented his bloodthirsty father."},{"id":"semetey-1-2013:p1315:b006:l029","ordinal":177622,"en":"His gray-wolf ritual father,"},{"id":"semetey-1-2013:p1315:b006:l030","ordinal":177623,"en":"Almambet, came to mind;"},{"id":"semetey-1-2013:p1315:b006:l031","ordinal":177624,"en":"Your hero rolled over,"},{"id":"semetey-1-2013:p1315:b006:l032","ordinal":177625,"en":"Coiling like a black snake."},{"id":"semetey-1-2013:p1315:b006:l033","ordinal":177626,"en":"Unable to endure his thoughts,"},{"id":"semetey-1-2013:p1315:b006:l034","ordinal":177627,"en":"His old wound was stirred;"},{"id":"semetey-1-2013:p1315:b006:l035","ordinal":177628,"en":"No mortal came within a handspan of him."},{"id":"semetey-1-2013:p1315:b006:l036","ordinal":177629,"en":"It was the time when he looked back"},{"id":"semetey-1-2013:p1315:b006:l037","ordinal":177630,"en":"And counted his falcon uncle Syrgak."},{"id":"semetey-1-2013:p1316:b003:l001","ordinal":177631,"en":"It was the time when he counted him."},{"id":"semetey-1-2013:p1316:b003:l002","ordinal":177632,"en":"Straight ahead stood the house at Keng-Kol;"},{"id":"semetey-1-2013:p1316:b003:l003","ordinal":177633,"en":"Do not ask the falcon's condition—"},{"id":"semetey-1-2013:p1316:b003:l004","ordinal":177634,"en":"No wretched mortal came within a handspan."},{"id":"semetey-1-2013:p1316:b003:l005","ordinal":177635,"en":"At the treasury gate"},{"id":"semetey-1-2013:p1316:b003:l006","ordinal":177636,"en":"He had the doolbas beaten;"},{"id":"semetey-1-2013:p1316:b003:l007","ordinal":177637,"en":"When the doolbas was struck,"},{"id":"semetey-1-2013:p1316:b003:l008","ordinal":177638,"en":"Its sound deafened the ears."},{"id":"semetey-1-2013:p1316:b003:l009","ordinal":177639,"en":"From the fortress with gates,"},{"id":"semetey-1-2013:p1316:b003:l010","ordinal":177640,"en":"From Chachykei's palace,"},{"id":"semetey-1-2013:p1316:b003:l011","ordinal":177641,"en":"From below Tört-Kül,"},{"id":"semetey-1-2013:p1316:b003:l012","ordinal":177642,"en":"From the garden planted by his princely father Manas,"},{"id":"semetey-1-2013:p1316:b003:l013","ordinal":177643,"en":"From opposite Bar-Köl,"},{"id":"semetey-1-2013:p1316:b003:l014","ordinal":177644,"en":"From the garden planted by hero Manas,"},{"id":"semetey-1-2013:p1316:b003:l015","ordinal":177645,"en":"Kanchoro and Külchoro—"},{"id":"semetey-1-2013:p1316:b003:l016","ordinal":177646,"en":"For the two out among the horses,"},{"id":"semetey-1-2013:p1316:b003:l017","ordinal":177647,"en":"The doolbas was beaten hard,"},{"id":"semetey-1-2013:p1316:b003:l018","ordinal":177648,"en":"And the horses stampeded together."},{"id":"semetey-1-2013:p1316:b003:l019","ordinal":177649,"en":"Bounding and bunching like roe deer,"},{"id":"semetey-1-2013:p1316:b003:l020","ordinal":177650,"en":"Külchoro and Kanchoro,"},{"id":"semetey-1-2013:p1316:b003:l021","ordinal":177651,"en":"The two of them in great haste,"},{"id":"semetey-1-2013:p1316:b003:l022","ordinal":177652,"en":"Readied and saddled their coursers,"},{"id":"semetey-1-2013:p1316:b003:l023","ordinal":177653,"en":"Alarmed by Semetey:"},{"id":"semetey-1-2013:p1316:b003:l024","ordinal":177654,"en":"\"The doolbas has been beaten hard;"},{"id":"semetey-1-2013:p1316:b003:l025","ordinal":177655,"en":"Its sound makes the ears ring."},{"id":"semetey-1-2013:p1316:b003:l026","ordinal":177656,"en":"Is there a trench already dug?!"},{"id":"semetey-1-2013:p1316:b003:l027","ordinal":177657,"en":"Has an army engulfed us"},{"id":"semetey-1-2013:p1316:b003:l028","ordinal":177658,"en":"From forty Kalmak tribes?!\""},{"id":"semetey-1-2013:p1316:b003:l029","ordinal":177659,"en":"Unable to stand in their alarm,"},{"id":"semetey-1-2013:p1316:b003:l030","ordinal":177660,"en":"The two companions raced,"},{"id":"semetey-1-2013:p1316:b003:l031","ordinal":177661,"en":"Their stirrups striking together,"},{"id":"semetey-1-2013:p1316:b003:l032","ordinal":177662,"en":"And rode into the palace."},{"id":"semetey-1-2013:p1316:b003:l033","ordinal":177663,"en":"There, wearing a blue lynx-fur cap"},{"id":"semetey-1-2013:p1316:b003:l034","ordinal":177664,"en":"And wielding a blue-mottled shield,"}]
