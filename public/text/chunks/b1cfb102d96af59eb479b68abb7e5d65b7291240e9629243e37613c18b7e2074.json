[{"id":"manas-2010:p1019:b001:l005","ordinal":44545,"en":"“A crooked one born to an unmarried girl,” they say."},{"id":"manas-2010:p1019:b001:l006","ordinal":44546,"en":"“Your Chubak always"},{"id":"manas-2010:p1019:b001:l007","ordinal":44547,"en":"Argues for crooked deeds,"},{"id":"manas-2010:p1019:b001:l008","ordinal":44548,"en":"One of those damned fellows,” they say."},{"id":"manas-2010:p1019:b001:l009","ordinal":44549,"en":"We shall press on and scout the road,"},{"id":"manas-2010:p1019:b001:l010","ordinal":44550,"en":"We shall journey to Beijing."},{"id":"manas-2010:p1019:b001:l011","ordinal":44551,"en":"When we journey to Beijing,"},{"id":"manas-2010:p1019:b001:l012","ordinal":44552,"en":"Giving no help at all,"},{"id":"manas-2010:p1019:b001:l013","ordinal":44553,"en":"Showing no companionship,"},{"id":"manas-2010:p1019:b001:l014","ordinal":44554,"en":"Joining the magnanimous one,"},{"id":"manas-2010:p1019:b001:l015","ordinal":44555,"en":"He will stay with the baggage train."},{"id":"manas-2010:p1019:b001:l016","ordinal":44556,"en":"Do not hurt yourself over Chubak,"},{"id":"manas-2010:p1019:b001:l017","ordinal":44557,"en":"Do not take offense over the reckless fellow.’"},{"id":"manas-2010:p1019:b001:l018","ordinal":44558,"en":"Before even that much time had passed,"},{"id":"manas-2010:p1019:b001:l019","ordinal":44559,"en":"Before warrior Syrgak had closed his mouth,"},{"id":"manas-2010:p1019:b001:l020","ordinal":44560,"en":"Wearing a coat fit for battle,"},{"id":"manas-2010:p1019:b001:l021","ordinal":44561,"en":"Riding at an amble,"},{"id":"manas-2010:p1019:b001:l022","ordinal":44562,"en":"Mounted on a horse like Kögala,"},{"id":"manas-2010:p1019:b001:l023","ordinal":44563,"en":"His hem and sleeves spread out,"},{"id":"manas-2010:p1019:b001:l024","ordinal":44564,"en":"When he came to the downward slope,"},{"id":"manas-2010:p1019:b001:l025","ordinal":44565,"en":"He stepped in excitement, in excitement."},{"id":"manas-2010:p1019:b001:l026","ordinal":44566,"en":"His hooves sank in the sand."},{"id":"manas-2010:p1019:b001:l027","ordinal":44567,"en":"When he began climbing up,"},{"id":"manas-2010:p1019:b001:l028","ordinal":44568,"en":"The imperious courser Kögala,"},{"id":"manas-2010:p1019:b001:l029","ordinal":44569,"en":"His mane and tail spread out,"},{"id":"manas-2010:p1019:b001:l030","ordinal":44570,"en":"Kögala, who had galloped from afar,"},{"id":"manas-2010:p1019:b001:l031","ordinal":44571,"en":"Leaned upon his bear-like chest."},{"id":"manas-2010:p1019:b001:l032","ordinal":44572,"en":"His apple-shaped round head,"},{"id":"manas-2010:p1019:b001:l033","ordinal":44573,"en":"Weaving, wrapped in dust,"},{"id":"manas-2010:p1019:b001:l034","ordinal":44574,"en":"His neck curved like tongs,"},{"id":"manas-2010:p1019:b001:l035","ordinal":44575,"en":"Knowing neither uphill nor downhill,"},{"id":"manas-2010:p1019:b001:l036","ordinal":44576,"en":"He ran like a flying bird."},{"id":"manas-2010:p1019:b001:l037","ordinal":44577,"en":"Stones beneath his tread crumbled."},{"id":"manas-2010:p1019:b001:l038","ordinal":44578,"en":"Clods big as cauldrons"},{"id":"manas-2010:p1019:b001:l039","ordinal":44579,"en":"Whistled above his head."},{"id":"manas-2010:p1019:b001:l040","ordinal":44580,"en":"His ravenous mouth gaped open."},{"id":"manas-2010:p1019:b001:l041","ordinal":44581,"en":"White foam mixed with blood"},{"id":"manas-2010:p1019:b001:l042","ordinal":44582,"en":"Scattered over his chest."},{"id":"manas-2010:p1020:b001:l001","ordinal":44583,"en":"The swift steed Kögala,"},{"id":"manas-2010:p1020:b001:l002","ordinal":44584,"en":"Sending his forelock flying skyward,"},{"id":"manas-2010:p1020:b001:l003","ordinal":44585,"en":"Thrusting and plunging his hooves,"},{"id":"manas-2010:p1020:b001:l004","ordinal":44586,"en":"The stones flung from his hooves"},{"id":"manas-2010:p1020:b001:l005","ordinal":44587,"en":"He hurled sky-high."},{"id":"manas-2010:p1020:b001:l006","ordinal":44588,"en":"He lowered his head to the earth."},{"id":"manas-2010:p1020:b001:l007","ordinal":44589,"en":"“My destination is Beijing,”"},{"id":"manas-2010:p1020:b001:l008","ordinal":44590,"en":"Though a beast, he knew."},{"id":"manas-2010:p1020:b001:l009","ordinal":44591,"en":"Speeding like a fired shot,"},{"id":"manas-2010:p1020:b001:l010","ordinal":44592,"en":"His body had grown hot."},{"id":"manas-2010:p1020:b001:l011","ordinal":44593,"en":"No soul could withstand his wrath,"},{"id":"manas-2010:p1020:b001:l012","ordinal":44594,"en":"The wrath of mighty Chubak."},{"id":"manas-2010:p1020:b001:l013","ordinal":44595,"en":"The earth split with a roar,"},{"id":"manas-2010:p1020:b001:l014","ordinal":44596,"en":"He shouted like a lion,"},{"id":"manas-2010:p1020:b001:l015","ordinal":44597,"en":"Thundered like the sky."},{"id":"manas-2010:p1020:b001:l016","ordinal":44598,"en":"Golden forelock, tasseled sash,"},{"id":"manas-2010:p1020:b001:l017","ordinal":44599,"en":"Azizkan's blue-maned one,"},{"id":"manas-2010:p1020:b001:l018","ordinal":44600,"en":"At the sight of warrior Chubak,"},{"id":"manas-2010:p1020:b001:l019","ordinal":44601,"en":"Now turned his mount."},{"id":"manas-2010:p1020:b001:l020","ordinal":44602,"en":"When Chubak came in fury,"},{"id":"manas-2010:p1020:b001:l021","ordinal":44603,"en":"Blue-maned lion Almambet"},{"id":"manas-2010:p1020:b001:l022","ordinal":44604,"en":"Gave him an open greeting."},{"id":"manas-2010:p1020:b001:l023","ordinal":44605,"en":"Chubak did not return the greeting."},{"id":"manas-2010:p1020:b001:l024","ordinal":44606,"en":"Then the blue-maned one spoke:"},{"id":"manas-2010:p1020:b001:l025","ordinal":44607,"en":"‘Hero Chubak, my champion,"},{"id":"manas-2010:p1020:b001:l026","ordinal":44608,"en":"So many sins,"},{"id":"manas-2010:p1020:b001:l027","ordinal":44609,"en":"Who is your lion to shoulder and bear them?"},{"id":"manas-2010:p1020:b001:l028","ordinal":44610,"en":"You have become enraged,"},{"id":"manas-2010:p1020:b001:l029","ordinal":44611,"en":"You have drawn your sword."},{"id":"manas-2010:p1020:b001:l030","ordinal":44612,"en":"Is there an iron net spread out?"},{"id":"manas-2010:p1020:b001:l031","ordinal":44613,"en":"Is there a road running alongside?"},{"id":"manas-2010:p1020:b001:l032","ordinal":44614,"en":"Is there a road blocked off?"},{"id":"manas-2010:p1020:b001:l033","ordinal":44615,"en":"You have become terribly hurried."},{"id":"manas-2010:p1020:b001:l034","ordinal":44616,"en":"Is there an army come from Mecca?"},{"id":"manas-2010:p1020:b001:l035","ordinal":44617,"en":"Girding their waists tightly,"},{"id":"manas-2010:p1020:b001:l036","ordinal":44618,"en":"Many Chinese emerging from the flank,"},{"id":"manas-2010:p1020:b001:l037","ordinal":44619,"en":"Bringing an army without sparing any,"},{"id":"manas-2010:p1020:b001:l038","ordinal":44620,"en":"Have they arrived unexpectedly?"},{"id":"manas-2010:p1020:b001:l039","ordinal":44621,"en":"Upon the vast army lying without a watch,"},{"id":"manas-2010:p1020:b001:l040","ordinal":44622,"en":"Have they stirred up battle?"},{"id":"manas-2010:p1020:b001:l041","ordinal":44623,"en":"You have come straight toward me."},{"id":"manas-2010:p1020:b001:l042","ordinal":44624,"en":"Is there an army come from Beijing?"},{"id":"manas-2010:p1021:b001:l001","ordinal":44625,"en":"If an army has come from Beijing,"},{"id":"manas-2010:p1021:b001:l002","ordinal":44626,"en":"Let me mount Sarala."},{"id":"manas-2010:p1021:b001:l003","ordinal":44627,"en":"The Chinese come in multitudes,"},{"id":"manas-2010:p1021:b001:l004","ordinal":44628,"en":"Let me attack them alone."},{"id":"manas-2010:p1021:b001:l005","ordinal":44629,"en":"Upon Beijing where the Prophet would not go,"},{"id":"manas-2010:p1021:b001:l006","ordinal":44630,"en":"Let me bring calamity."},{"id":"manas-2010:p1021:b001:l007","ordinal":44631,"en":"Over the teeming Black Chinese,"},{"id":"manas-2010:p1021:b001:l008","ordinal":44632,"en":"My blue-maned leopard Chubak,"},{"id":"manas-2010:p1021:b001:l009","ordinal":44633,"en":"Let me raise you as khan."},{"id":"manas-2010:p1021:b001:l010","ordinal":44634,"en":"If foes have come from Mecca,"},{"id":"manas-2010:p1021:b001:l011","ordinal":44635,"en":"Give me Kögala to ride."},{"id":"manas-2010:p1021:b001:l012","ordinal":44636,"en":"Let them be a vast host, not merely many."},{"id":"manas-2010:p1021:b001:l013","ordinal":44637,"en":"Like a falcon striking jackdaws,"},{"id":"manas-2010:p1021:b001:l014","ordinal":44638,"en":"Let me attack alone and scatter them."},{"id":"manas-2010:p1021:b001:l015","ordinal":44639,"en":"Like a hobby striking jackdaws,"},{"id":"manas-2010:p1021:b001:l016","ordinal":44640,"en":"Let me slaughter them, sparing no life."},{"id":"manas-2010:p1021:b001:l017","ordinal":44641,"en":"Even if it is the world's army,"},{"id":"manas-2010:p1021:b001:l018","ordinal":44642,"en":"Making red blood flow,"},{"id":"manas-2010:p1021:b001:l019","ordinal":44643,"en":"Over the enemy that boasts of strength,"},{"id":"manas-2010:p1021:b001:l020","ordinal":44644,"en":"My mighty blue-maned Chubak,"},{"id":"manas-2010:p1021:b001:l021","ordinal":44645,"en":"Let me raise you as khan!’"},{"id":"manas-2010:p1021:b001:l022","ordinal":44646,"en":"Saying this, Almambet,"},{"id":"manas-2010:p1021:b001:l023","ordinal":44647,"en":"As though smiling beneath his mustache,"},{"id":"manas-2010:p1021:b001:l024","ordinal":44648,"en":"Stood looking sidelong."},{"id":"manas-2010:p1021:b001:l025","ordinal":44649,"en":"Your Chubak, who came wound tight,"},{"id":"manas-2010:p1021:b001:l026","ordinal":44650,"en":"Became truly angry."},{"id":"manas-2010:p1021:b001:l027","ordinal":44651,"en":"Riding Kögala, roaring,"},{"id":"manas-2010:p1021:b001:l028","ordinal":44652,"en":"Without hearing what was said,"},{"id":"manas-2010:p1021:b001:l029","ordinal":44653,"en":"Excited as though struck by wind,"},{"id":"manas-2010:p1021:b001:l030","ordinal":44654,"en":"Like a seven-headed creature:"},{"id":"manas-2010:p1021:b001:l031","ordinal":44655,"en":"‘Earlier, in broad Talas's hollow,"},{"id":"manas-2010:p1021:b001:l032","ordinal":44656,"en":"Along the tamarisk valley,"},{"id":"manas-2010:p1021:b001:l033","ordinal":44657,"en":"The teeming Argyn and many Nogoy,"},{"id":"manas-2010:p1021:b001:l034","ordinal":44658,"en":"When they were camped there,"},{"id":"manas-2010:p1021:b001:l035","ordinal":44659,"en":"Kumiss by day, girls by night,"},{"id":"manas-2010:p1021:b001:l036","ordinal":44660,"en":"When that was how things were,"},{"id":"manas-2010:p1021:b001:l037","ordinal":44661,"en":"Wearing marten-fur caps in pairs,"},{"id":"manas-2010:p1021:b001:l038","ordinal":44662,"en":"When they were swaying,"},{"id":"manas-2010:p1021:b001:l039","ordinal":44663,"en":"Together knowing the Kyrgyz,"},{"id":"manas-2010:p1021:b001:l040","ordinal":44664,"en":"When they were enjoying themselves,"},{"id":"manas-2010:p1021:b001:l041","ordinal":44665,"en":"Where is the letter written then?"},{"id":"manas-2010:p1021:b001:l042","ordinal":44666,"en":"Where is the oath sworn before God?"},{"id":"manas-2010:p1022:b001:l001","ordinal":44667,"en":"I wore myself out asking you,"},{"id":"manas-2010:p1022:b001:l002","ordinal":44668,"en":"“Take me along to Beijing,”"},{"id":"manas-2010:p1022:b001:l003","ordinal":44669,"en":"I begged so many times."},{"id":"manas-2010:p1022:b001:l004","ordinal":44670,"en":"When we humbled Kokand,"},{"id":"manas-2010:p1022:b001:l005","ordinal":44671,"en":"When Margilan and Bukhara"},{"id":"manas-2010:p1022:b001:l006","ordinal":44672,"en":"We raided together,"},{"id":"manas-2010:p1022:b001:l007","ordinal":44673,"en":"We went and took Afghanistan;"},{"id":"manas-2010:p1022:b001:l008","ordinal":44674,"en":"What other land escaped unhurt?"},{"id":"manas-2010:p1022:b001:l009","ordinal":44675,"en":"We broke through rock and made a road,"},{"id":"manas-2010:p1022:b001:l010","ordinal":44676,"en":"We launched an army into India."},{"id":"manas-2010:p1022:b001:l011","ordinal":44677,"en":"We took one head of livestock as plunder,"},{"id":"manas-2010:p1022:b001:l012","ordinal":44678,"en":"We took gold coins in elephant-loads."},{"id":"manas-2010:p1022:b001:l013","ordinal":44679,"en":"Great beauties with dark eyes,"},{"id":"manas-2010:p1022:b001:l014","ordinal":44680,"en":"With flowing, abundant hair—"},{"id":"manas-2010:p1022:b001:l015","ordinal":44681,"en":"We chose a thousand of them."},{"id":"manas-2010:p1022:b001:l016","ordinal":44682,"en":"When we raided the Qizilbash,"},{"id":"manas-2010:p1022:b001:l017","ordinal":44683,"en":"For Crimea and Urum"},{"id":"manas-2010:p1022:b001:l018","ordinal":44684,"en":"The forty companions set out."},{"id":"manas-2010:p1022:b001:l019","ordinal":44685,"en":"As their spoils, the champions"},{"id":"manas-2010:p1022:b001:l020","ordinal":44686,"en":"Took countless splendid steeds."},{"id":"manas-2010:p1022:b001:l021","ordinal":44687,"en":"When the entrenched enemy's"},{"id":"manas-2010:p1022:b001:l022","ordinal":44688,"en":"Strength we were breaking,"},{"id":"manas-2010:p1022:b001:l023","ordinal":44689,"en":"When its strongly fortified towns"},{"id":"manas-2010:p1022:b001:l024","ordinal":44690,"en":"And defenses we brought down,"},{"id":"manas-2010:p1022:b001:l025","ordinal":44691,"en":"Beyond the reach of any counting,"},{"id":"manas-2010:p1022:b001:l026","ordinal":44692,"en":"When we shattered their people,"},{"id":"manas-2010:p1022:b001:l027","ordinal":44693,"en":"With my belt about my neck,"},{"id":"manas-2010:p1022:b001:l028","ordinal":44694,"en":"“When you set out for Beijing,"},{"id":"manas-2010:p1022:b001:l029","ordinal":44695,"en":"Take me as your companion,” I said,"},{"id":"manas-2010:p1022:b001:l030","ordinal":44696,"en":"You black-hearted Chinese slave,"},{"id":"manas-2010:p1022:b001:l031","ordinal":44697,"en":"And pleaded with you earnestly."},{"id":"manas-2010:p1022:b001:l032","ordinal":44698,"en":"Toward cruel-hearted Beijing"},{"id":"manas-2010:p1022:b001:l033","ordinal":44699,"en":"You have taken the lead;"},{"id":"manas-2010:p1022:b001:l034","ordinal":44700,"en":"Without a thought for me,"},{"id":"manas-2010:p1022:b001:l035","ordinal":44701,"en":"Why did you leave me with the baggage train?"},{"id":"manas-2010:p1022:b001:l036","ordinal":44702,"en":"Turn your horse's head awhile,"},{"id":"manas-2010:p1022:b001:l037","ordinal":44703,"en":"You reckless Chinese slave,"},{"id":"manas-2010:p1022:b001:l038","ordinal":44704,"en":"Stand here before me awhile!"},{"id":"manas-2010:p1022:b001:l039","ordinal":44705,"en":"Leading an army of twelve peoples,"},{"id":"manas-2010:p1022:b001:l040","ordinal":44706,"en":"Are you the one to scout ahead?!"},{"id":"manas-2010:p1022:b001:l041","ordinal":44707,"en":"Left out of council, left out of discussion,"},{"id":"manas-2010:p1022:b001:l042","ordinal":44708,"en":"Without scouting Beijing,"},{"id":"manas-2010:p1023:b001:l001","ordinal":44709,"en":"Am I to stay with the baggage train!?"},{"id":"manas-2010:p1023:b001:l002","ordinal":44710,"en":"To Beijing, where Solomon would not go,"},{"id":"manas-2010:p1023:b001:l003","ordinal":44711,"en":"Are you to ride alone and sullen?!"},{"id":"manas-2010:p1023:b001:l004","ordinal":44712,"en":"Without going scouting, with the baggage train"},{"id":"manas-2010:p1023:b001:l005","ordinal":44713,"en":"Am I to lie behind?!"},{"id":"manas-2010:p1023:b001:l006","ordinal":44714,"en":"Sarala is swifter than countless horses, dog!"},{"id":"manas-2010:p1023:b001:l007","ordinal":44715,"en":"You never settle to the ground,"},{"id":"manas-2010:p1023:b001:l008","ordinal":44716,"en":"Your robe's hem never touches it,"},{"id":"manas-2010:p1023:b001:l009","ordinal":44717,"en":"Damn your father's grave, uncircumcised dog!"},{"id":"manas-2010:p1023:b001:l010","ordinal":44718,"en":"From Beijing's countless Chinese"},{"id":"manas-2010:p1023:b001:l011","ordinal":44719,"en":"You trotted here on Sarala, dog!"},{"id":"manas-2010:p1023:b001:l012","ordinal":44720,"en":"From that numberless people,"},{"id":"manas-2010:p1023:b001:l013","ordinal":44721,"en":"Your mischief brought you here, dog!"},{"id":"manas-2010:p1023:b001:l014","ordinal":44722,"en":"Three hearthstones, a blue hearth,"},{"id":"manas-2010:p1023:b001:l015","ordinal":44723,"en":"Your sleeves never touch the ground;"},{"id":"manas-2010:p1023:b001:l016","ordinal":44724,"en":"For seven generations the Chinese"},{"id":"manas-2010:p1023:b001:l017","ordinal":44725,"en":"Have not known “In God's name.”"},{"id":"manas-2010:p1023:b001:l018","ordinal":44726,"en":"The words I say—"},{"id":"manas-2010:p1023:b001:l019","ordinal":44727,"en":"Will you heed them, Chinese slave!"},{"id":"manas-2010:p1023:b001:l020","ordinal":44728,"en":"The road to Beijing divides five ways;"},{"id":"manas-2010:p1023:b001:l021","ordinal":44729,"en":"Let me come along as well."},{"id":"manas-2010:p1023:b001:l022","ordinal":44730,"en":"Will you agree, Chinese slave?!"},{"id":"manas-2010:p1023:b001:l023","ordinal":44731,"en":"If you will not heed my words,"},{"id":"manas-2010:p1023:b001:l024","ordinal":44732,"en":"Here and now at my hand"},{"id":"manas-2010:p1023:b001:l025","ordinal":44733,"en":"Will you die, Chinese slave?!”"},{"id":"manas-2010:p1023:b001:l026","ordinal":44734,"en":"Then Almambet said this:"},{"id":"manas-2010:p1023:b001:l027","ordinal":44735,"en":"“The Chinese, forty clans, a vast people—"},{"id":"manas-2010:p1023:b001:l028","ordinal":44736,"en":"May I be an infidel if I go there!"},{"id":"manas-2010:p1023:b001:l029","ordinal":44737,"en":"Beijing's road divides five ways;"},{"id":"manas-2010:p1023:b001:l030","ordinal":44738,"en":"May I be an infidel if I scout it!"},{"id":"manas-2010:p1023:b001:l031","ordinal":44739,"en":"Beijing's road branches five ways;"},{"id":"manas-2010:p1023:b001:l032","ordinal":44740,"en":"I give it to you, Chubak, take it!"},{"id":"manas-2010:p1023:b001:l033","ordinal":44741,"en":"Stop shrilling ‘Chinese’ at me;"},{"id":"manas-2010:p1023:b001:l034","ordinal":44742,"en":"I yield, my dear, take it!"},{"id":"manas-2010:p1023:b001:l035","ordinal":44743,"en":"Hero Chubak, go yourself!"},{"id":"manas-2010:p1023:b001:l036","ordinal":44744,"en":"Scout the road to Beijing and return;"},{"id":"manas-2010:p1023:b001:l037","ordinal":44745,"en":"Esenkan's daughter Burulcha,"},{"id":"manas-2010:p1023:b001:l038","ordinal":44746,"en":"The general's daughter Aymyskal—"},{"id":"manas-2010:p1023:b001:l039","ordinal":44747,"en":"Bring them as gifts from Beijing!"},{"id":"manas-2010:p1023:b001:l040","ordinal":44748,"en":"Do not exhaust your strength;"},{"id":"manas-2010:p1023:b001:l041","ordinal":44749,"en":"Repeating ‘Chinese’ out of spite,"},{"id":"manas-2010:p1023:b001:l042","ordinal":44750,"en":"Do not torment my soul,"},{"id":"manas-2010:p1024:b001:l001","ordinal":44751,"en":"Do not set my blood boiling!"},{"id":"manas-2010:p1024:b001:l002","ordinal":44752,"en":"Of the Chinese, the people of forty khans,"},{"id":"manas-2010:p1024:b001:l003","ordinal":44753,"en":"I am not the one who has gathered news,"},{"id":"manas-2010:p1024:b001:l004","ordinal":44754,"en":"Nor are you the one who has seen them."},{"id":"manas-2010:p1024:b001:l005","ordinal":44755,"en":"Vast, sprawling Beijing"},{"id":"manas-2010:p1024:b001:l006","ordinal":44756,"en":"Has pits already dug,"},{"id":"manas-2010:p1024:b001:l007","ordinal":44757,"en":"Has brine set boiling,"},{"id":"manas-2010:p1024:b001:l008","ordinal":44758,"en":"Has fortified mountain passes,"},{"id":"manas-2010:p1024:b001:l009","ordinal":44759,"en":"Has firmly guarded borders,"},{"id":"manas-2010:p1024:b001:l010","ordinal":44760,"en":"Where not a pinch of grass grows,"},{"id":"manas-2010:p1024:b001:l011","ordinal":44761,"en":"Where no water could furnish a drop,"},{"id":"manas-2010:p1024:b001:l012","ordinal":44762,"en":"There is a forty-day desert."},{"id":"manas-2010:p1024:b001:l013","ordinal":44763,"en":"Who knows how far around it goes,"},{"id":"manas-2010:p1024:b001:l014","ordinal":44764,"en":"Its shining, boundless lake?"},{"id":"manas-2010:p1024:b001:l015","ordinal":44765,"en":"Where no person can pass,"},{"id":"manas-2010:p1024:b001:l016","ordinal":44766,"en":"Where a mouse's nose cannot get through,"},{"id":"manas-2010:p1024:b001:l017","ordinal":44767,"en":"There are dense woods and thickets."},{"id":"manas-2010:p1024:b001:l018","ordinal":44768,"en":"Guarding the way through the forest,"},{"id":"manas-2010:p1024:b001:l019","ordinal":44769,"en":"In a cotton sash and broad boots,"},{"id":"manas-2010:p1024:b001:l020","ordinal":44770,"en":"Is Kongurbay, khan of the monks."},{"id":"manas-2010:p1024:b001:l021","ordinal":44771,"en":"That swine knows the enemy's tricks,"},{"id":"manas-2010:p1024:b001:l022","ordinal":44772,"en":"A fellow skilled beyond other spearmen;"},{"id":"manas-2010:p1024:b001:l023","ordinal":44773,"en":"Were he not Chinese,"},{"id":"manas-2010:p1024:b001:l024","ordinal":44774,"en":"He would be among mankind's finest."},{"id":"manas-2010:p1024:b001:l025","ordinal":44775,"en":"There is a champion posted at the pass,"},{"id":"manas-2010:p1024:b001:l026","ordinal":44776,"en":"There is the renowned warrior Kalcha."},{"id":"manas-2010:p1024:b001:l027","ordinal":44777,"en":"I yield, Chubak, go and scout!"},{"id":"manas-2010:p1024:b001:l028","ordinal":44778,"en":"I stay here; go yourself."},{"id":"manas-2010:p1024:b001:l029","ordinal":44779,"en":"Where the spreading mist parts,"},{"id":"manas-2010:p1024:b001:l030","ordinal":44780,"en":"Where that bulk looms over there,"},{"id":"manas-2010:p1024:b001:l031","ordinal":44781,"en":"There is the one-eyed people's land."},{"id":"manas-2010:p1024:b001:l032","ordinal":44782,"en":"When their fury rises,"},{"id":"manas-2010:p1024:b001:l033","ordinal":44783,"en":"They have a fortress to resist you."},{"id":"manas-2010:p1024:b001:l034","ordinal":44784,"en":"Within that fortress,"},{"id":"manas-2010:p1024:b001:l035","ordinal":44785,"en":"Beyond any man's strength to overcome,"},{"id":"manas-2010:p1024:b001:l036","ordinal":44786,"en":"Is their lion, one-eyed Malgun."},{"id":"manas-2010:p1024:b001:l037","ordinal":44787,"en":"He is that established city's footsoldier;"},{"id":"manas-2010:p1024:b001:l038","ordinal":44788,"en":"Think, Chubak, my warrior!"},{"id":"manas-2010:p1024:b001:l039","ordinal":44789,"en":"The one lying there to bar the road"},{"id":"manas-2010:p1024:b001:l040","ordinal":44790,"en":"Is that one-eyed giant."},{"id":"manas-2010:p1024:b001:l041","ordinal":44791,"en":"Now I stay, Chubak; you go."},{"id":"manas-2010:p1024:b001:l042","ordinal":44792,"en":"I give you the road; take it!”"},{"id":"manas-2010:p1025:b001:l001","ordinal":44793,"en":"When he stood speaking thus,"},{"id":"manas-2010:p1025:b001:l002","ordinal":44794,"en":"Once again hero Chubak"},{"id":"manas-2010:p1025:b001:l003","ordinal":44795,"en":"Grew bold and worked himself up:"},{"id":"manas-2010:p1025:b001:l004","ordinal":44796,"en":"“Is Beijing your own stronghold?"},{"id":"manas-2010:p1025:b001:l005","ordinal":44797,"en":"The one you praise so highly—"},{"id":"manas-2010:p1025:b001:l006","ordinal":44798,"en":"Is Kalcha your own lion?"},{"id":"manas-2010:p1025:b001:l007","ordinal":44799,"en":"You bastard, Chinese slave,"},{"id":"manas-2010:p1025:b001:l008","ordinal":44800,"en":"Shall I smash your fortress?"}]
