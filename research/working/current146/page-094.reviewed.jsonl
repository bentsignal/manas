{"id": "sayakbay-ms-current146:pdf094:l025", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 94, "folio": 477, "line_in_page": 25, "raw": "Бек өлүм болот өзүнө,", "text": "Бек өлүм болот өзүнө,", "en": "Certain death will come upon him,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
