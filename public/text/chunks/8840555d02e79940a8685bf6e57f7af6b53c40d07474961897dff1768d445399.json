[{"id":"manas-2010:p0756:b001:l020","ordinal":33537,"en":"At the gated fortress,"},{"id":"manas-2010:p0756:b001:l021","ordinal":33538,"en":"At Khan Koshoi's court,"},{"id":"manas-2010:p0756:b001:l022","ordinal":33539,"en":"Springing and curling like a roe deer,"},{"id":"manas-2010:p0756:b001:l023","ordinal":33540,"en":"He dismounted from Kartküröng."},{"id":"manas-2010:p0756:b001:l024","ordinal":33541,"en":"A brass post with a golden band,"},{"id":"manas-2010:p0756:b001:l025","ordinal":33542,"en":"He tied his horse swiftly, swish and swish,"},{"id":"manas-2010:p0756:b001:l026","ordinal":33543,"en":"His quickness beyond measure,"},{"id":"manas-2010:p0756:b001:l027","ordinal":33544,"en":"He tied it fast with a bustle."},{"id":"manas-2010:p0756:b001:l028","ordinal":33545,"en":"A black-steel battle-axe"},{"id":"manas-2010:p0756:b001:l029","ordinal":33546,"en":"Hung looped from his wrist."},{"id":"manas-2010:p0756:b001:l030","ordinal":33547,"en":"Praying to his Allah,"},{"id":"manas-2010:p0756:b001:l031","ordinal":33548,"en":"Girded with a sharp steel sword,"},{"id":"manas-2010:p0756:b001:l032","ordinal":33549,"en":"Smiling and standing boldly,"},{"id":"manas-2010:p0756:b001:l033","ordinal":33550,"en":"Laughing, speaking, showing himself openly,"},{"id":"manas-2010:p0756:b001:l034","ordinal":33551,"en":"The sword clinked at his waist."},{"id":"manas-2010:p0756:b001:l035","ordinal":33552,"en":"Azhybay, whose spirit was different,"},{"id":"manas-2010:p0756:b001:l036","ordinal":33553,"en":"To Koshoi, visited by Kydyr,"},{"id":"manas-2010:p0756:b001:l037","ordinal":33554,"en":"Gave a ringing greeting."},{"id":"manas-2010:p0756:b001:l038","ordinal":33555,"en":"In Azhy's right hand,"},{"id":"manas-2010:p0756:b001:l039","ordinal":33556,"en":"A golden-cheeked battle-axe;"},{"id":"manas-2010:p0756:b001:l040","ordinal":33557,"en":"At Azhy's left side,"},{"id":"manas-2010:p0756:b001:l041","ordinal":33558,"en":"A side pouch covered in gold."},{"id":"manas-2010:p0756:b001:l042","ordinal":33559,"en":"From inside the side pouch"},{"id":"manas-2010:p0757:b001:l001","ordinal":33560,"en":"He took out an object."},{"id":"manas-2010:p0757:b001:l002","ordinal":33561,"en":"A letter written on white parchment,"},{"id":"manas-2010:p0757:b001:l003","ordinal":33562,"en":"He handed it to Koshoi."},{"id":"manas-2010:p0757:b001:l004","ordinal":33563,"en":"It was a letter written in Arabic."},{"id":"manas-2010:p0757:b001:l005","ordinal":33564,"en":"When he read and looked at the letter,"},{"id":"manas-2010:p0757:b001:l006","ordinal":33565,"en":"It bore leopard Manas's name."},{"id":"manas-2010:p0757:b001:l007","ordinal":33566,"en":"Azhybay, Bakay and hero Manas,"},{"id":"manas-2010:p0757:b001:l008","ordinal":33567,"en":"The three together had written the letter."},{"id":"manas-2010:p0757:b001:l009","ordinal":33568,"en":"'Khan Alöökö of the white dwelling,"},{"id":"manas-2010:p0757:b001:l010","ordinal":33569,"en":"We have taken him,' they wrote."},{"id":"manas-2010:p0757:b001:l011","ordinal":33570,"en":"'Leveling his chief fortress,"},{"id":"manas-2010:p0757:b001:l012","ordinal":33571,"en":"The Chinese of extraordinary trouble,"},{"id":"manas-2010:p0757:b001:l013","ordinal":33572,"en":"We have struck them down,' they wrote."},{"id":"manas-2010:p0757:b001:l014","ordinal":33573,"en":"'The strife and great contention we knew,"},{"id":"manas-2010:p0757:b001:l015","ordinal":33574,"en":"We have brought it about,' they wrote."},{"id":"manas-2010:p0757:b001:l016","ordinal":33575,"en":"'Leaving not so much as a hair,"},{"id":"manas-2010:p0757:b001:l017","ordinal":33576,"en":"We have slaughtered them,' they wrote."},{"id":"manas-2010:p0757:b001:l018","ordinal":33577,"en":"'Unsparing turmoil,"},{"id":"manas-2010:p0757:b001:l019","ordinal":33578,"en":"We have inflicted it,' they wrote."},{"id":"manas-2010:p0757:b001:l020","ordinal":33579,"en":"'The wealth they loaded and fled with,"},{"id":"manas-2010:p0757:b001:l021","ordinal":33580,"en":"All of it, leaving none,"},{"id":"manas-2010:p0757:b001:l022","ordinal":33581,"en":"We have seized it,' they wrote."},{"id":"manas-2010:p0757:b001:l023","ordinal":33582,"en":"'The wealth of the Muslims,"},{"id":"manas-2010:p0757:b001:l024","ordinal":33583,"en":"Letting not a hair go to the Chinese,"},{"id":"manas-2010:p0757:b001:l025","ordinal":33584,"en":"Plundering it all back,"},{"id":"manas-2010:p0757:b001:l026","ordinal":33585,"en":"With unsparing booty"},{"id":"manas-2010:p0757:b001:l027","ordinal":33586,"en":"We have had our fill,' they wrote."},{"id":"manas-2010:p0757:b001:l028","ordinal":33587,"en":"'The allotted time is this much;"},{"id":"manas-2010:p0757:b001:l029","ordinal":33588,"en":"Without passing that time,"},{"id":"manas-2010:p0757:b001:l030","ordinal":33589,"en":"Let my uncle Koshoi come."},{"id":"manas-2010:p0757:b001:l031","ordinal":33590,"en":"The countless wealth taken from the Chinese,"},{"id":"manas-2010:p0757:b001:l032","ordinal":33591,"en":"Among the Muslim people,"},{"id":"manas-2010:p0757:b001:l033","ordinal":33592,"en":"With his own hands, my uncle,"},{"id":"manas-2010:p0757:b001:l034","ordinal":33593,"en":"Let him divide it impartially.'"},{"id":"manas-2010:p0757:b001:l035","ordinal":33594,"en":"How mighty Manas was,"},{"id":"manas-2010:p0757:b001:l036","ordinal":33595,"en":"He now perceived, he now knew."},{"id":"manas-2010:p0757:b001:l037","ordinal":33596,"en":"Without saying a word, your uncle"},{"id":"manas-2010:p0757:b001:l038","ordinal":33597,"en":"Now smiled beneath his mustache:"},{"id":"manas-2010:p0757:b001:l039","ordinal":33598,"en":"'While the slaughterer lives,"},{"id":"manas-2010:p0757:b001:l040","ordinal":33599,"en":"Let him enlarge Keng-Kol and Talas."},{"id":"manas-2010:p0757:b001:l041","ordinal":33600,"en":"For the son of the Muslims,"},{"id":"manas-2010:p0757:b001:l042","ordinal":33601,"en":"God, make his bonds firm,"},{"id":"manas-2010:p0758:b001:l001","ordinal":33602,"en":"Dark, blue-maned Manas!"},{"id":"manas-2010:p0758:b001:l002","ordinal":33603,"en":"Leopard, blue-maned, blood-drinking lion,"},{"id":"manas-2010:p0758:b001:l003","ordinal":33604,"en":"Among the sons of the Muslims,"},{"id":"manas-2010:p0758:b001:l004","ordinal":33605,"en":"Surely no such hero is born."},{"id":"manas-2010:p0758:b001:l005","ordinal":33606,"en":"If you created him as a living soul, God,"},{"id":"manas-2010:p0758:b001:l006","ordinal":33607,"en":"God, keep Manas safe!"},{"id":"manas-2010:p0758:b001:l007","ordinal":33608,"en":"Upon the warrior hero Alöökö,"},{"id":"manas-2010:p0758:b001:l008","ordinal":33609,"en":"The infidel of fierce wrath,"},{"id":"manas-2010:p0758:b001:l009","ordinal":33610,"en":"He has brought havoc."},{"id":"manas-2010:p0758:b001:l010","ordinal":33611,"en":"The black-hearted infidel,"},{"id":"manas-2010:p0758:b001:l011","ordinal":33612,"en":"Having ruined him at one stroke,"},{"id":"manas-2010:p0758:b001:l012","ordinal":33613,"en":"He has slaughtered him as a sacrifice."},{"id":"manas-2010:p0758:b001:l013","ordinal":33614,"en":"Dragging him onto the road,"},{"id":"manas-2010:p0758:b001:l014","ordinal":33615,"en":"He has cut him open for the great dogs."},{"id":"manas-2010:p0758:b001:l015","ordinal":33616,"en":"With the seething Chinese,"},{"id":"manas-2010:p0758:b001:l016","ordinal":33617,"en":"While the slaughterer lives,"},{"id":"manas-2010:p0758:b001:l017","ordinal":33618,"en":"He has entered into strife."},{"id":"manas-2010:p0758:b001:l018","ordinal":33619,"en":"Seated at the edge of the realm,"},{"id":"manas-2010:p0758:b001:l019","ordinal":33620,"en":"He was a khan named Alöökö."},{"id":"manas-2010:p0758:b001:l020","ordinal":33621,"en":"Born of Alöökö,"},{"id":"manas-2010:p0758:b001:l021","ordinal":33622,"en":"There were sixty sons."},{"id":"manas-2010:p0758:b001:l022","ordinal":33623,"en":"His fame was as Alöökö,"},{"id":"manas-2010:p0758:b001:l023","ordinal":33624,"en":"It was extraordinarily great,"},{"id":"manas-2010:p0758:b001:l024","ordinal":33625,"en":"His trouble for the Muslims."},{"id":"manas-2010:p0758:b001:l025","ordinal":33626,"en":"\"He has taken Alöökö,\""},{"id":"manas-2010:p0758:b001:l026","ordinal":33627,"en":"That saying has remained, it seems."},{"id":"manas-2010:p0758:b001:l027","ordinal":33628,"en":"Alöökö, lion Manas"},{"id":"manas-2010:p0758:b001:l028","ordinal":33629,"en":"Has defeated him, it seems."},{"id":"manas-2010:p0758:b001:l029","ordinal":33630,"en":"Against Khan Manas, unending,"},{"id":"manas-2010:p0758:b001:l030","ordinal":33631,"en":"The black-hearted Chinese,"},{"id":"manas-2010:p0758:b001:l031","ordinal":33632,"en":"Until the end of the world,"},{"id":"manas-2010:p0758:b001:l032","ordinal":33633,"en":"Have a vengeance left, it seems."},{"id":"manas-2010:p0758:b001:l033","ordinal":33634,"en":"If slaughterer Manas wishes,"},{"id":"manas-2010:p0758:b001:l034","ordinal":33635,"en":"Let me see his great feast."},{"id":"manas-2010:p0758:b001:l035","ordinal":33636,"en":"The first booty beneath his claws,"},{"id":"manas-2010:p0758:b001:l036","ordinal":33637,"en":"To the Muslim people,"},{"id":"manas-2010:p0758:b001:l037","ordinal":33638,"en":"Let me distribute it.'"},{"id":"manas-2010:p0758:b001:l038","ordinal":33639,"en":"Having eighty camels strung together,"},{"id":"manas-2010:p0758:b001:l039","ordinal":33640,"en":"To load up the gold,"},{"id":"manas-2010:p0758:b001:l040","ordinal":33641,"en":"Your uncle, leopard Koshoi,"},{"id":"manas-2010:p0758:b001:l041","ordinal":33642,"en":"Sent his servants."},{"id":"manas-2010:p0758:b001:l042","ordinal":33643,"en":"Khan Koshoi of the Katagan,"},{"id":"manas-2010:p0759:b001:l001","ordinal":33644,"en":"Reciting an additional prayer,"},{"id":"manas-2010:p0759:b001:l002","ordinal":33645,"en":"The bay leopard-like winged steed,"},{"id":"manas-2010:p0759:b001:l003","ordinal":33646,"en":"He saddled it carefully at ease."},{"id":"manas-2010:p0759:b001:l004","ordinal":33647,"en":"Readying his weapons and equipment,"},{"id":"manas-2010:p0759:b001:l005","ordinal":33648,"en":"Your uncle Koshoi prepared,"},{"id":"manas-2010:p0759:b001:l006","ordinal":33649,"en":"Calling like a young goose,"},{"id":"manas-2010:p0759:b001:l007","ordinal":33650,"en":"His white beard gleaming,"},{"id":"manas-2010:p0759:b001:l008","ordinal":33651,"en":"His majesty surpassing other men's."},{"id":"manas-2010:p0759:b001:l009","ordinal":33652,"en":"He had some sixty wrestlers"},{"id":"manas-2010:p0759:b001:l010","ordinal":33653,"en":"Blow trumpets and shawms."},{"id":"manas-2010:p0759:b001:l011","ordinal":33654,"en":"Hurrying and bustling on the road,"},{"id":"manas-2010:p0759:b001:l012","ordinal":33655,"en":"Sparing no horses, traveling far,"},{"id":"manas-2010:p0759:b001:l013","ordinal":33656,"en":"Where slaughter upon Alöökö"},{"id":"manas-2010:p0759:b001:l014","ordinal":33657,"en":"Had been wrought, he now arrived."},{"id":"manas-2010:p0759:b001:l015","ordinal":33658,"en":"Where the end of the world and Judgment"},{"id":"manas-2010:p0759:b001:l016","ordinal":33659,"en":"Had been brought, he now arrived."},{"id":"manas-2010:p0759:b001:l017","ordinal":33660,"en":"Where wealth as booty"},{"id":"manas-2010:p0759:b001:l018","ordinal":33661,"en":"Had been seized, he now arrived."},{"id":"manas-2010:p0759:b001:l019","ordinal":33662,"en":"The elder, father of the people,"},{"id":"manas-2010:p0759:b001:l020","ordinal":33663,"en":"Dear saint Koshoi."},{"id":"manas-2010:p0759:b001:l021","ordinal":33664,"en":"They pitched a tent for Koshoi."},{"id":"manas-2010:p0759:b001:l022","ordinal":33665,"en":"The breadth of that tent—"},{"id":"manas-2010:p0759:b001:l023","ordinal":33666,"en":"There were giants Bakay and Koshoi;"},{"id":"manas-2010:p0759:b001:l024","ordinal":33667,"en":"Of giants like these,"},{"id":"manas-2010:p0759:b001:l025","ordinal":33668,"en":"A multitude could lie inside."},{"id":"manas-2010:p0759:b001:l026","ordinal":33669,"en":"In one corner, forty companions"},{"id":"manas-2010:p0759:b001:l027","ordinal":33670,"en":"Could freely play the knucklebone game."},{"id":"manas-2010:p0759:b001:l028","ordinal":33671,"en":"From the infidel full of wrath,"},{"id":"manas-2010:p0759:b001:l029","ordinal":33672,"en":"A great tent taken as booty,"},{"id":"manas-2010:p0759:b001:l030","ordinal":33673,"en":"From the warrior Khan Alöökö."},{"id":"manas-2010:p0759:b001:l031","ordinal":33674,"en":"The place where they had fought,"},{"id":"manas-2010:p0759:b001:l032","ordinal":33675,"en":"Along Kum-Aryk,"},{"id":"manas-2010:p0759:b001:l033","ordinal":33676,"en":"He divided booty among the people"},{"id":"manas-2010:p0759:b001:l034","ordinal":33677,"en":"At Khan Manas's feast."},{"id":"manas-2010:p0759:b001:l035","ordinal":33678,"en":"Lion Manas, the precious hero,"},{"id":"manas-2010:p0759:b001:l036","ordinal":33679,"en":"Showing his lionhood,"},{"id":"manas-2010:p0759:b001:l037","ordinal":33680,"en":"A hundred men from each lineage,"},{"id":"manas-2010:p0759:b001:l038","ordinal":33681,"en":"He brought them into that tent."},{"id":"manas-2010:p0759:b001:l039","ordinal":33682,"en":"For all who had come,"},{"id":"manas-2010:p0759:b001:l040","ordinal":33683,"en":"For white-bearded elder Koshoi,"},{"id":"manas-2010:p0759:b001:l041","ordinal":33684,"en":"Breaking off heaps of yellow butter,"},{"id":"manas-2010:p0759:b001:l042","ordinal":33685,"en":"Pouring sugar like snow,"},{"id":"manas-2010:p0760:b001:l001","ordinal":33686,"en":"Filling the place with wealth,"},{"id":"manas-2010:p0760:b001:l002","ordinal":33687,"en":"He began a splendid celebration."},{"id":"manas-2010:p0760:b001:l003","ordinal":33688,"en":"Well-fed lambs, sweet heads,"},{"id":"manas-2010:p0760:b001:l004","ordinal":33689,"en":"He set them boiling vigorously."},{"id":"manas-2010:p0760:b001:l005","ordinal":33690,"en":"The khans he had summoned"},{"id":"manas-2010:p0760:b001:l006","ordinal":33691,"en":"Had come without fail, it seems,"},{"id":"manas-2010:p0760:b001:l007","ordinal":33692,"en":"The Muslim souls."},{"id":"manas-2010:p0760:b001:l008","ordinal":33693,"en":"Their khan, old Koshoi, was there;"},{"id":"manas-2010:p0760:b001:l009","ordinal":33694,"en":"All the Muslims were there."},{"id":"manas-2010:p0760:b001:l010","ordinal":33695,"en":"Let us tell the number of khans:"},{"id":"manas-2010:p0760:b001:l011","ordinal":33696,"en":"Kozubek of the khan of Kokon,"},{"id":"manas-2010:p0760:b001:l012","ordinal":33697,"en":"Fork-bearded Synchybek of Anzhyian,"},{"id":"manas-2010:p0760:b001:l013","ordinal":33698,"en":"Malabek in Margalang,"},{"id":"manas-2010:p0760:b001:l014","ordinal":33699,"en":"Alabek of Alty-Shaar,"},{"id":"manas-2010:p0760:b001:l015","ordinal":33700,"en":"All those who came were there;"},{"id":"manas-2010:p0760:b001:l016","ordinal":33701,"en":"Khan Buudayyk was there too."},{"id":"manas-2010:p0760:b001:l017","ordinal":33702,"en":"Among those who had come,"},{"id":"manas-2010:p0760:b001:l018","ordinal":33703,"en":"Khan Tekechi, Khan Shygay,"},{"id":"manas-2010:p0760:b001:l019","ordinal":33704,"en":"Zhamgyrchy of the Eshtek,"},{"id":"manas-2010:p0760:b001:l020","ordinal":33705,"en":"All who possessed understanding were there."},{"id":"manas-2010:p0760:b001:l021","ordinal":33706,"en":"They gave the word to elder Koshoi."},{"id":"manas-2010:p0760:b001:l022","ordinal":33707,"en":"Great Koshoi stood speaking"},{"id":"manas-2010:p0760:b001:l023","ordinal":33708,"en":"To all who had come:"},{"id":"manas-2010:p0760:b001:l024","ordinal":33709,"en":"'Born to stand against the enemy,"},{"id":"manas-2010:p0760:b001:l025","ordinal":33710,"en":"He has come rightly—do you see?"},{"id":"manas-2010:p0760:b001:l026","ordinal":33711,"en":"Muslims, through your good fortune,"},{"id":"manas-2010:p0760:b001:l027","ordinal":33712,"en":"Blessing has come—do you see?!"},{"id":"manas-2010:p0760:b001:l028","ordinal":33713,"en":"Raise up your lion Manas."},{"id":"manas-2010:p0760:b001:l029","ordinal":33714,"en":"Cast aside, Muslims,"},{"id":"manas-2010:p0760:b001:l030","ordinal":33715,"en":"Your muttering and bickering."},{"id":"manas-2010:p0760:b001:l031","ordinal":33716,"en":"Let us divide his booty;"},{"id":"manas-2010:p0760:b001:l032","ordinal":33717,"en":"On the open steppe, Manas,"},{"id":"manas-2010:p0760:b001:l033","ordinal":33718,"en":"Praying to the holy Most High,"},{"id":"manas-2010:p0760:b001:l034","ordinal":33719,"en":"Let us raise him as khan."},{"id":"manas-2010:p0760:b001:l035","ordinal":33720,"en":"My reason for raising him as khan—"},{"id":"manas-2010:p0760:b001:l036","ordinal":33721,"en":"There is much hostility among you."},{"id":"manas-2010:p0760:b001:l037","ordinal":33722,"en":"Think, you wretched people,"},{"id":"manas-2010:p0760:b001:l038","ordinal":33723,"en":"There are many enemies to trample you."},{"id":"manas-2010:p0760:b001:l039","ordinal":33724,"en":"On your upland side are the Chinese,"},{"id":"manas-2010:p0760:b001:l040","ordinal":33725,"en":"Many enemies to fight to destruction."},{"id":"manas-2010:p0760:b001:l041","ordinal":33726,"en":"There are homelands they would seize and ravage."},{"id":"manas-2010:p0760:b001:l042","ordinal":33727,"en":"Before you are the Franks;"},{"id":"manas-2010:p0761:b001:l001","ordinal":33728,"en":"There are many foes to contend with."},{"id":"manas-2010:p0761:b001:l002","ordinal":33729,"en":"Let us obey his words."},{"id":"manas-2010:p0761:b001:l003","ordinal":33730,"en":"Two reins and one lead-rope,"},{"id":"manas-2010:p0761:b001:l004","ordinal":33731,"en":"Into the blood-drinking lion's hands,"},{"id":"manas-2010:p0761:b001:l005","ordinal":33732,"en":"Let us give them this very day."},{"id":"manas-2010:p0761:b001:l006","ordinal":33733,"en":"To obey his words,"},{"id":"manas-2010:p0761:b001:l007","ordinal":33734,"en":"Two reins and one lead-rope,"},{"id":"manas-2010:p0761:b001:l008","ordinal":33735,"en":"To give into his hands without hesitation,"},{"id":"manas-2010:p0761:b001:l009","ordinal":33736,"en":"Chew white-wheat flour and give your pledge,"},{"id":"manas-2010:p0761:b001:l010","ordinal":33737,"en":"Hold the holy Quran and give your pledge!"},{"id":"manas-2010:p0761:b001:l011","ordinal":33738,"en":"If you make Manas your leader,"},{"id":"manas-2010:p0761:b001:l012","ordinal":33739,"en":"If you bring unity into one place,"},{"id":"manas-2010:p0761:b001:l013","ordinal":33740,"en":"Will an enemy come to challenge you?"},{"id":"manas-2010:p0761:b001:l014","ordinal":33741,"en":"Will any man defeat you in combat?"},{"id":"manas-2010:p0761:b001:l015","ordinal":33742,"en":"Will any thumbed human dare approach?"},{"id":"manas-2010:p0761:b001:l016","ordinal":33743,"en":"Will any clawed creature touch you?"},{"id":"manas-2010:p0761:b001:l017","ordinal":33744,"en":"If you make Manas your leader,"},{"id":"manas-2010:p0761:b001:l018","ordinal":33745,"en":"He is the towering ridge touched by the sun."},{"id":"manas-2010:p0761:b001:l019","ordinal":33746,"en":"Look, people,"},{"id":"manas-2010:p0761:b001:l020","ordinal":33747,"en":"This is the hero who will find your prosperity,"},{"id":"manas-2010:p0761:b001:l021","ordinal":33748,"en":"This is the lion who will care for you."},{"id":"manas-2010:p0761:b001:l022","ordinal":33749,"en":"He will make your felt walls rich with fat."},{"id":"manas-2010:p0761:b001:l023","ordinal":33750,"en":"Understand rightly, people,"},{"id":"manas-2010:p0761:b001:l024","ordinal":33751,"en":"He will make you khans in every land,"},{"id":"manas-2010:p0761:b001:l025","ordinal":33752,"en":"He will make your lattice walls rich with fat,"},{"id":"manas-2010:p0761:b001:l026","ordinal":33753,"en":"He will make you stately khans."},{"id":"manas-2010:p0761:b001:l027","ordinal":33754,"en":"If the slaughterer turns his front,"},{"id":"manas-2010:p0761:b001:l028","ordinal":33755,"en":"He has a dragon's form."},{"id":"manas-2010:p0761:b001:l029","ordinal":33756,"en":"If the slaughterer turns his back,"},{"id":"manas-2010:p0761:b001:l030","ordinal":33757,"en":"He has a white tiger's terror."},{"id":"manas-2010:p0761:b001:l031","ordinal":33758,"en":"Look, people,"},{"id":"manas-2010:p0761:b001:l032","ordinal":33759,"en":"Among the Muslim people,"},{"id":"manas-2010:p0761:b001:l033","ordinal":33760,"en":"Which of you is greater than Manas?"},{"id":"manas-2010:p0761:b001:l034","ordinal":33761,"en":"Great Manas standing here,"},{"id":"manas-2010:p0761:b001:l035","ordinal":33762,"en":"A lion born of Chyyyrdy,"},{"id":"manas-2010:p0761:b001:l036","ordinal":33763,"en":"From black-hearted Jakyp,"},{"id":"manas-2010:p0761:b001:l037","ordinal":33764,"en":"A dark, blue-maned hero was born."},{"id":"manas-2010:p0761:b001:l038","ordinal":33765,"en":"If the Chinese eagerly attack,"},{"id":"manas-2010:p0761:b001:l039","ordinal":33766,"en":"He is the slave who will destroy them for you."},{"id":"manas-2010:p0761:b001:l040","ordinal":33767,"en":"If the Franks contend and attack,"},{"id":"manas-2010:p0761:b001:l041","ordinal":33768,"en":"He is the son who will crush them for you."},{"id":"manas-2010:p0761:b001:l042","ordinal":33769,"en":"Think, multitude of people,"},{"id":"manas-2010:p0762:b001:l001","ordinal":33770,"en":"Blue-maned Manas, the leopard,"},{"id":"manas-2010:p0762:b001:l002","ordinal":33771,"en":"Was born for your good fortune."},{"id":"manas-2010:p0762:b001:l003","ordinal":33772,"en":"When he reached twelve years of age,"},{"id":"manas-2010:p0762:b001:l004","ordinal":33773,"en":"He raised an uproar in Altay."},{"id":"manas-2010:p0762:b001:l005","ordinal":33774,"en":"Do you call this his strife?"},{"id":"manas-2010:p0762:b001:l006","ordinal":33775,"en":"He began a wondrous strife."},{"id":"manas-2010:p0762:b001:l007","ordinal":33776,"en":"When he migrated here from Altay,"},{"id":"manas-2010:p0762:b001:l008","ordinal":33777,"en":"Of the black Chinese and Manchu,"},{"id":"manas-2010:p0762:b001:l009","ordinal":33778,"en":"Their great officials with rank buttons on their caps,"},{"id":"manas-2010:p0762:b001:l010","ordinal":33779,"en":"He slaughtered many of them."},{"id":"manas-2010:p0762:b001:l011","ordinal":33780,"en":"He found broad Talas and made it a homeland."},{"id":"manas-2010:p0762:b001:l012","ordinal":33781,"en":"The Argyn and the Kyrgyz,"},{"id":"manas-2010:p0762:b001:l013","ordinal":33782,"en":"He joined their heads and made a people."},{"id":"manas-2010:p0762:b001:l014","ordinal":33783,"en":"If I tell you his circumstances,"},{"id":"manas-2010:p0762:b001:l015","ordinal":33784,"en":"Such is the nature of Manas."},{"id":"manas-2010:p0762:b001:l016","ordinal":33785,"en":"Think, people,"},{"id":"manas-2010:p0762:b001:l017","ordinal":33786,"en":"The gold you take as booty,"},{"id":"manas-2010:p0762:b001:l018","ordinal":33787,"en":"You who have not taken will take,"},{"id":"manas-2010:p0762:b001:l019","ordinal":33788,"en":"At least a piece the size of a fist.'"},{"id":"manas-2010:p0762:b001:l020","ordinal":33789,"en":"When Koshoi said this,"},{"id":"manas-2010:p0762:b001:l021","ordinal":33790,"en":"All the khans burst forth,"},{"id":"manas-2010:p0762:b001:l022","ordinal":33791,"en":"A thousand spoke with one mouth,"},{"id":"manas-2010:p0762:b001:l023","ordinal":33792,"en":"The multitude stood clamoring."}]
