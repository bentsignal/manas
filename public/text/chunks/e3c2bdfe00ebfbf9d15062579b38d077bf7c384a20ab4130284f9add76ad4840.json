[{"id":"manas-2010:p1672:b001:l003","ordinal":71937,"en":"Oh dog, when they reached the descent,"},{"id":"manas-2010:p1672:b001:l004","ordinal":71938,"en":"The grim-faced hero's Algara"},{"id":"manas-2010:p1672:b001:l005","ordinal":71939,"en":"Planted his forelegs like a roe deer."},{"id":"manas-2010:p1672:b001:l006","ordinal":71940,"en":"When they started climbing,"},{"id":"manas-2010:p1672:b001:l007","ordinal":71941,"en":"Your Alake's Sarala"},{"id":"manas-2010:p1672:b001:l008","ordinal":71942,"en":"Had mane and tail streaming."},{"id":"manas-2010:p1672:b001:l009","ordinal":71943,"en":"When they entered a steep descent,"},{"id":"manas-2010:p1672:b001:l010","ordinal":71944,"en":"Kongurbay's Algara"},{"id":"manas-2010:p1672:b001:l011","ordinal":71945,"en":"Had his bull-like neck bulging;"},{"id":"manas-2010:p1672:b001:l012","ordinal":71946,"en":"When they started climbing,"},{"id":"manas-2010:p1672:b001:l013","ordinal":71947,"en":"Your Alake's Sarala"},{"id":"manas-2010:p1672:b001:l014","ordinal":71948,"en":"Had eyes flashing like flint."},{"id":"manas-2010:p1672:b001:l015","ordinal":71949,"en":"Your infidel's Algara,"},{"id":"manas-2010:p1672:b001:l016","ordinal":71950,"en":"When he entered a descent,"},{"id":"manas-2010:p1672:b001:l017","ordinal":71951,"en":"Sped away into the distance;"},{"id":"manas-2010:p1672:b001:l018","ordinal":71952,"en":"When they started climbing,"},{"id":"manas-2010:p1672:b001:l019","ordinal":71953,"en":"Your Alake's Sarala"},{"id":"manas-2010:p1672:b001:l020","ordinal":71954,"en":"Drew close upon his heels."},{"id":"manas-2010:p1672:b001:l021","ordinal":71955,"en":"Oh hero, down Kürpüldök's curved ridge,"},{"id":"manas-2010:p1672:b001:l022","ordinal":71956,"en":"He drove him downhill in pursuit."},{"id":"manas-2010:p1672:b001:l023","ordinal":71957,"en":"The barren plain where they pursued each other,"},{"id":"manas-2010:p1672:b001:l024","ordinal":71958,"en":"Upon that barren plain,"},{"id":"manas-2010:p1672:b001:l025","ordinal":71959,"en":"There was no burrow dug by a marmot,"},{"id":"manas-2010:p1672:b001:l026","ordinal":71960,"en":"No furrow cut by a wooden plow,"},{"id":"manas-2010:p1672:b001:l027","ordinal":71961,"en":"No stone to crack a marrowbone,"},{"id":"manas-2010:p1672:b001:l028","ordinal":71962,"en":"No pit, hollow or ditch."},{"id":"manas-2010:p1672:b001:l029","ordinal":71963,"en":"When they reached the level plain,"},{"id":"manas-2010:p1672:b001:l030","ordinal":71964,"en":"Unable to gather his wits,"},{"id":"manas-2010:p1672:b001:l031","ordinal":71965,"en":"Your noble grim-faced warrior—"},{"id":"manas-2010:p1672:b001:l032","ordinal":71966,"en":"He drew near, about to reach him."},{"id":"manas-2010:p1672:b001:l033","ordinal":71967,"en":"Urging Sarala on with a shout,"},{"id":"manas-2010:p1672:b001:l034","ordinal":71968,"en":"Your noble lion reached him."},{"id":"manas-2010:p1672:b001:l035","ordinal":71969,"en":"Reaching the grim-faced one,"},{"id":"manas-2010:p1672:b001:l036","ordinal":71970,"en":"At the thin part of his right shoulder blade,"},{"id":"manas-2010:p1672:b001:l037","ordinal":71971,"en":"Your Alake aimed and struck as he passed."},{"id":"manas-2010:p1672:b001:l038","ordinal":71972,"en":"Then Sarala beneath him,"},{"id":"manas-2010:p1672:b001:l039","ordinal":71973,"en":"As he struck the grim-faced one,"},{"id":"manas-2010:p1672:b001:l040","ordinal":71974,"en":"Leaped and leaped, gathering himself."},{"id":"manas-2010:p1672:b001:l041","ordinal":71975,"en":"Then the painted spear did not break;"},{"id":"manas-2010:p1672:b001:l042","ordinal":71976,"en":"It bent like a round pot-stand."},{"id":"manas-2010:p1673:b001:l001","ordinal":71977,"en":"The grim-faced one lost consciousness;"},{"id":"manas-2010:p1673:b001:l002","ordinal":71978,"en":"The warrior left his saddle,"},{"id":"manas-2010:p1673:b001:l003","ordinal":71979,"en":"His feet left the stirrups,"},{"id":"manas-2010:p1673:b001:l004","ordinal":71980,"en":"His eyes darted wildly,"},{"id":"manas-2010:p1673:b001:l005","ordinal":71981,"en":"His feet dangled."},{"id":"manas-2010:p1673:b001:l006","ordinal":71982,"en":"“Where are the Manchu hosts, the troops?” he cried."},{"id":"manas-2010:p1673:b001:l007","ordinal":71983,"en":"Kongurbay ran out of recourse;"},{"id":"manas-2010:p1673:b001:l008","ordinal":71984,"en":"He groped for the crupper,"},{"id":"manas-2010:p1673:b001:l009","ordinal":71985,"en":"Crying out in ever greater distress,"},{"id":"manas-2010:p1673:b001:l010","ordinal":71986,"en":"Calling the battle cry, “Come on!”"},{"id":"manas-2010:p1673:b001:l011","ordinal":71987,"en":"When he thought of words, they came too late."},{"id":"manas-2010:p1673:b001:l012","ordinal":71988,"en":"Your Alake, born fortunate:"},{"id":"manas-2010:p1673:b001:l013","ordinal":71989,"en":"“Let me seize him by the hem,” he said,"},{"id":"manas-2010:p1673:b001:l014","ordinal":71990,"en":"His two eyes became four with eagerness."},{"id":"manas-2010:p1673:b001:l015","ordinal":71991,"en":"“If the infidel falls into my hands,"},{"id":"manas-2010:p1673:b001:l016","ordinal":71992,"en":"Let me slaughter him as a sacrifice;"},{"id":"manas-2010:p1673:b001:l017","ordinal":71993,"en":"The black blood within him,"},{"id":"manas-2010:p1673:b001:l018","ordinal":71994,"en":"Let me swallow it by handfuls,” he said."},{"id":"manas-2010:p1673:b001:l019","ordinal":71995,"en":"With cotton belt and broad boots,"},{"id":"manas-2010:p1673:b001:l020","ordinal":71996,"en":"Kongurbay, khan of the monks—"},{"id":"manas-2010:p1673:b001:l021","ordinal":71997,"en":"As he was about to seize him by the hem,"},{"id":"manas-2010:p1673:b001:l022","ordinal":71998,"en":"About to lay him out lengthwise,"},{"id":"manas-2010:p1673:b001:l023","ordinal":71999,"en":"About to cut off his head like a sheep's,"},{"id":"manas-2010:p1673:b001:l024","ordinal":72000,"en":"About to split his belly like a melon,"},{"id":"manas-2010:p1673:b001:l025","ordinal":72001,"en":"Then Ajybay, Argynkan's son,"},{"id":"manas-2010:p1673:b001:l026","ordinal":72002,"en":"Shouted in his excitement,"},{"id":"manas-2010:p1673:b001:l027","ordinal":72003,"en":"Called out, “Alake!”"},{"id":"manas-2010:p1673:b001:l028","ordinal":72004,"en":"Rousing him, making him jerk,"},{"id":"manas-2010:p1673:b001:l029","ordinal":72005,"en":"Aziz Khan's champion,"},{"id":"manas-2010:p1673:b001:l030","ordinal":72006,"en":"Making him writhe like a bereaved wife,"},{"id":"manas-2010:p1673:b001:l031","ordinal":72007,"en":"He drew back and led away,"},{"id":"manas-2010:p1673:b001:l032","ordinal":72008,"en":"Kindling his extinguished fire,"},{"id":"manas-2010:p1673:b001:l033","ordinal":72009,"en":"Reviving his deadened life."},{"id":"manas-2010:p1673:b001:l034","ordinal":72010,"en":"The reason he did so:"},{"id":"manas-2010:p1673:b001:l035","ordinal":72011,"en":"Absorbed in chasing the grim-faced one,"},{"id":"manas-2010:p1673:b001:l036","ordinal":72012,"en":"Your dear lion Alma, blessed by Kydyr,"},{"id":"manas-2010:p1673:b001:l037","ordinal":72013,"en":"Had pursued him fiercely."},{"id":"manas-2010:p1673:b001:l038","ordinal":72014,"en":"To Beijing's deadly gate,"},{"id":"manas-2010:p1673:b001:l039","ordinal":72015,"en":"Your Alake had half a bowshot left;"},{"id":"manas-2010:p1673:b001:l040","ordinal":72016,"en":"To being seized and slaughtered by the Chinese,"},{"id":"manas-2010:p1673:b001:l041","ordinal":72017,"en":"Your Alake had drawn near."},{"id":"manas-2010:p1673:b001:l042","ordinal":72018,"en":"When he saw this peril,"},{"id":"manas-2010:p1674:b001:l001","ordinal":72019,"en":"Ajybay, Argynkan's son,"},{"id":"manas-2010:p1674:b001:l002","ordinal":72020,"en":"Made your Alake cry out and took him alongside."},{"id":"manas-2010:p1674:b001:l003","ordinal":72021,"en":"“Alake, they have a pit dug ready;"},{"id":"manas-2010:p1674:b001:l004","ordinal":72022,"en":"Pretending to flee, Kongurbay"},{"id":"manas-2010:p1674:b001:l005","ordinal":72023,"en":"Has misery waiting to boil for you."},{"id":"manas-2010:p1674:b001:l006","ordinal":72024,"en":"To strike with axes,"},{"id":"manas-2010:p1674:b001:l007","ordinal":72025,"en":"Look, he has many mighty men."},{"id":"manas-2010:p1674:b001:l008","ordinal":72026,"en":"Kongurbay's black horse,"},{"id":"manas-2010:p1674:b001:l009","ordinal":72027,"en":"His black horse did have"},{"id":"manas-2010:p1674:b001:l010","ordinal":72028,"en":"Wings upon its flanks."},{"id":"manas-2010:p1674:b001:l011","ordinal":72029,"en":"The eye cannot follow its movement;"},{"id":"manas-2010:p1674:b001:l012","ordinal":72030,"en":"Except a flying crow,"},{"id":"manas-2010:p1674:b001:l013","ordinal":72031,"en":"No other living thing can match it."},{"id":"manas-2010:p1674:b001:l014","ordinal":72032,"en":"Kongurbay, khan of the monks,"},{"id":"manas-2010:p1674:b001:l015","ordinal":72033,"en":"You cannot overpower him even grappling close."},{"id":"manas-2010:p1674:b001:l016","ordinal":72034,"en":"If you keep pursuing, striving to match him,"},{"id":"manas-2010:p1674:b001:l017","ordinal":72035,"en":"Anger is a devil, wisdom a friend;"},{"id":"manas-2010:p1674:b001:l018","ordinal":72036,"en":"Alöökö's Kongurbay,"},{"id":"manas-2010:p1674:b001:l019","ordinal":72037,"en":"Will he not capture you alive?"},{"id":"manas-2010:p1674:b001:l020","ordinal":72038,"en":"Gouging out both your eyes,"},{"id":"manas-2010:p1674:b001:l021","ordinal":72039,"en":"Will he not inflict this torment,"},{"id":"manas-2010:p1674:b001:l022","ordinal":72040,"en":"Take his boundless vengeance,"},{"id":"manas-2010:p1674:b001:l023","ordinal":72041,"en":"Bring such calamity upon you?"},{"id":"manas-2010:p1674:b001:l024","ordinal":72042,"en":"Your heroes Syrgak and Chubak are absent."},{"id":"manas-2010:p1674:b001:l025","ordinal":72043,"en":"Alake, with the deeply rooted infidels,"},{"id":"manas-2010:p1674:b001:l026","ordinal":72044,"en":"Do not vie without good cause."},{"id":"manas-2010:p1674:b001:l027","ordinal":72045,"en":"You have no support to rely on;"},{"id":"manas-2010:p1674:b001:l028","ordinal":72046,"en":"To bind your wounded waist,"},{"id":"manas-2010:p1674:b001:l029","ordinal":72047,"en":"Your champion, your lion Syrgak is absent."},{"id":"manas-2010:p1674:b001:l030","ordinal":72048,"en":"Of all you look to, you stand utterly alone;"},{"id":"manas-2010:p1674:b001:l031","ordinal":72049,"en":"There is no one else for you to turn to."},{"id":"manas-2010:p1674:b001:l032","ordinal":72050,"en":"Do not plunge in without good cause!”"},{"id":"manas-2010:p1674:b001:l033","ordinal":72051,"en":"Giving much courageous counsel,"},{"id":"manas-2010:p1674:b001:l034","ordinal":72052,"en":"Calling him “My leopard Almam,”"},{"id":"manas-2010:p1674:b001:l035","ordinal":72053,"en":"Your Alma, like Kambar,"},{"id":"manas-2010:p1674:b001:l036","ordinal":72054,"en":"He turned and led away."},{"id":"manas-2010:p1674:b001:l037","ordinal":72055,"en":"The seething, mighty host,"},{"id":"manas-2010:p1674:b001:l038","ordinal":72056,"en":"The costly road lay dug out;"},{"id":"manas-2010:p1674:b001:l039","ordinal":72057,"en":"With Khan Kojozhash at their head,"},{"id":"manas-2010:p1674:b001:l040","ordinal":72058,"en":"Almambet and my Ajy,"},{"id":"manas-2010:p1674:b001:l041","ordinal":72059,"en":"They swarmed upon them on that road!"},{"id":"manas-2010:p1674:b001:l042","ordinal":72060,"en":"The countless Chinese, Kojozhash,"},{"id":"manas-2010:p1675:b001:l001","ordinal":72061,"en":"Brought calamity upon their heads."},{"id":"manas-2010:p1675:b001:l002","ordinal":72062,"en":"In the desert of It-Ölbös,"},{"id":"manas-2010:p1675:b001:l003","ordinal":72063,"en":"Azizkan's only son,"},{"id":"manas-2010:p1675:b001:l004","ordinal":72064,"en":"Good heavens, they surrounded him."},{"id":"manas-2010:p1675:b001:l005","ordinal":72065,"en":"There was no crag a goose could not circle;"},{"id":"manas-2010:p1675:b001:l006","ordinal":72066,"en":"To stand beside him as support,"},{"id":"manas-2010:p1675:b001:l007","ordinal":72067,"en":"There was no mountain, the leopard Manas."},{"id":"manas-2010:p1675:b001:l008","ordinal":72068,"en":"He had no support to rely on;"},{"id":"manas-2010:p1675:b001:l009","ordinal":72069,"en":"In the slaughter he faced,"},{"id":"manas-2010:p1675:b001:l010","ordinal":72070,"en":"Not one of his champions was there."},{"id":"manas-2010:p1675:b001:l011","ordinal":72071,"en":"Do not ask about the great campaign;"},{"id":"manas-2010:p1675:b001:l012","ordinal":72072,"en":"The slaughtered people were beyond counting."},{"id":"manas-2010:p1675:b001:l013","ordinal":72073,"en":"To shout and stand by him,"},{"id":"manas-2010:p1675:b001:l014","ordinal":72074,"en":"His precious Syrgak was not here."},{"id":"manas-2010:p1675:b001:l015","ordinal":72075,"en":"Who had stirred the stars in the sky,"},{"id":"manas-2010:p1675:b001:l016","ordinal":72076,"en":"Who had sworn friendship into the next world,"},{"id":"manas-2010:p1675:b001:l017","ordinal":72077,"en":"His devastating hero Chubak was absent;"},{"id":"manas-2010:p1675:b001:l018","ordinal":72078,"en":"To rise towering and fire,"},{"id":"manas-2010:p1675:b001:l019","ordinal":72079,"en":"His devastating lion Manas was absent!"},{"id":"manas-2010:p1675:b001:l020","ordinal":72080,"en":"Finding no mountain for a crow to circle,"},{"id":"manas-2010:p1675:b001:l021","ordinal":72081,"en":"To stand by him as support,"},{"id":"manas-2010:p1675:b001:l022","ordinal":72082,"en":"Finding no honored sultan, no hero,"},{"id":"manas-2010:p1675:b001:l023","ordinal":72083,"en":"Without counting the hours of the day,"},{"id":"manas-2010:p1675:b001:l024","ordinal":72084,"en":"Without taking rest by day,"},{"id":"manas-2010:p1675:b001:l025","ordinal":72085,"en":"Fighting day and night,"},{"id":"manas-2010:p1675:b001:l026","ordinal":72086,"en":"He could find no peace for his life."},{"id":"manas-2010:p1675:b001:l027","ordinal":72087,"en":"After seven days of fighting through,"},{"id":"manas-2010:p1675:b001:l028","ordinal":72088,"en":"Wounded in seventy places,"},{"id":"manas-2010:p1675:b001:l029","ordinal":72089,"en":"He had fled away."},{"id":"manas-2010:p1675:b001:l030","ordinal":72090,"en":"Argynkan's unfortunate son,"},{"id":"manas-2010:p1675:b001:l031","ordinal":72091,"en":"Fought on alone;"},{"id":"manas-2010:p1675:b001:l032","ordinal":72092,"en":"Azizkan's young hawk,"},{"id":"manas-2010:p1675:b001:l033","ordinal":72093,"en":"Fortunate when he entered a firefight,"},{"id":"manas-2010:p1675:b001:l034","ordinal":72094,"en":"The noble one's desire was not sated."},{"id":"manas-2010:p1675:b001:l035","ordinal":72095,"en":"Making Sarala prance,"},{"id":"manas-2010:p1675:b001:l036","ordinal":72096,"en":"Making whoever he met crawl,"},{"id":"manas-2010:p1675:b001:l037","ordinal":72097,"en":"Smashing seven thousand of them,"},{"id":"manas-2010:p1675:b001:l038","ordinal":72098,"en":"Thrusting his spear wherever he reached,"},{"id":"manas-2010:p1675:b001:l039","ordinal":72099,"en":"“That consummate Kojozhash,"},{"id":"manas-2010:p1675:b001:l040","ordinal":72100,"en":"Where is that swine?” he cried."},{"id":"manas-2010:p1675:b001:l041","ordinal":72101,"en":"Bloody battle, a great field of war—"},{"id":"manas-2010:p1675:b001:l042","ordinal":72102,"en":"Blood flowed through the broad ravine!"},{"id":"manas-2010:p1676:b001:l001","ordinal":72103,"en":"Running on, leaning without rest,"},{"id":"manas-2010:p1676:b001:l002","ordinal":72104,"en":"His flesh had grown heated;"},{"id":"manas-2010:p1676:b001:l003","ordinal":72105,"en":"His dear head, like a feedbag,"},{"id":"manas-2010:p1676:b001:l004","ordinal":72106,"en":"Was drenched in pitch-dark blood."},{"id":"manas-2010:p1676:b001:l005","ordinal":72107,"en":"Looking neither up nor down,"},{"id":"manas-2010:p1676:b001:l006","ordinal":72108,"en":"Khan Aziz's only son"},{"id":"manas-2010:p1676:b001:l007","ordinal":72109,"en":"Never thought, “I shall die.”"},{"id":"manas-2010:p1676:b001:l008","ordinal":72110,"en":"Without looking around,"},{"id":"manas-2010:p1676:b001:l009","ordinal":72111,"en":"“A bullet may strike me,"},{"id":"manas-2010:p1676:b001:l010","ordinal":72112,"en":"My appointed death may come like this”—"},{"id":"manas-2010:p1676:b001:l011","ordinal":72113,"en":"He felt no such fear of the Chinese."},{"id":"manas-2010:p1676:b001:l012","ordinal":72114,"en":"Kongurbay pressed fiercely in,"},{"id":"manas-2010:p1676:b001:l013","ordinal":72115,"en":"With Ay Zhang-Zhung leading the elders."},{"id":"manas-2010:p1676:b001:l014","ordinal":72116,"en":"Tormenting and smashing"},{"id":"manas-2010:p1676:b001:l015","ordinal":72117,"en":"All those who came,"},{"id":"manas-2010:p1676:b001:l016","ordinal":72118,"en":"Draining the Chinese of strength,"},{"id":"manas-2010:p1676:b001:l017","ordinal":72119,"en":"The reason he kept fighting:"},{"id":"manas-2010:p1676:b001:l018","ordinal":72120,"en":"Dear Alma, the heroes' support,"},{"id":"manas-2010:p1676:b001:l019","ordinal":72121,"en":"Would not count them worth his boot-leg,"},{"id":"manas-2010:p1676:b001:l020","ordinal":72122,"en":"Except Kojozhash alone."},{"id":"manas-2010:p1676:b001:l021","ordinal":72123,"en":"The reason he held them so low:"},{"id":"manas-2010:p1676:b001:l022","ordinal":72124,"en":"Sarala with cowlike lean haunches,"},{"id":"manas-2010:p1676:b001:l023","ordinal":72125,"en":"Had he not saddled him and gone?"},{"id":"manas-2010:p1676:b001:l024","ordinal":72126,"en":"Before the dragon,"},{"id":"manas-2010:p1676:b001:l025","ordinal":72127,"en":"The secret lore of shooting,"},{"id":"manas-2010:p1676:b001:l026","ordinal":72128,"en":"Had dear Alma not studied it?"},{"id":"manas-2010:p1676:b001:l027","ordinal":72129,"en":"Against his skin, a fine white shirt,"},{"id":"manas-2010:p1676:b001:l028","ordinal":72130,"en":"Had dear Alma not put it on?"},{"id":"manas-2010:p1676:b001:l029","ordinal":72131,"en":"The stratagems of battle,"},{"id":"manas-2010:p1676:b001:l030","ordinal":72132,"en":"Had he not learned them from the Chinese?"},{"id":"manas-2010:p1676:b001:l031","ordinal":72133,"en":"The forked ridge and mountain pass,"},{"id":"manas-2010:p1676:b001:l032","ordinal":72134,"en":"Your Alma never feared to cross;"},{"id":"manas-2010:p1676:b001:l033","ordinal":72135,"en":"His gold and golden coins,"},{"id":"manas-2010:p1676:b001:l034","ordinal":72136,"en":"Your Alma never feared to scatter."},{"id":"manas-2010:p1676:b001:l035","ordinal":72137,"en":"The Kara-Kytay and Manzhuu,"},{"id":"manas-2010:p1676:b001:l036","ordinal":72138,"en":"Would your Alma fear to drive them?"},{"id":"manas-2010:p1676:b001:l037","ordinal":72139,"en":"If Kongurbay fell into his hands,"},{"id":"manas-2010:p1676:b001:l038","ordinal":72140,"en":"Would your Alma fear to slay him?"},{"id":"manas-2010:p1676:b001:l039","ordinal":72141,"en":"The Chinese multitude was beyond counting;"},{"id":"manas-2010:p1676:b001:l040","ordinal":72142,"en":"They had gone without looking back,"},{"id":"manas-2010:p1676:b001:l041","ordinal":72143,"en":"The forty valiant companions were not here!"},{"id":"manas-2010:p1676:b001:l042","ordinal":72144,"en":"The red lance and Zulpuqor"},{"id":"manas-2010:p1677:b001:l001","ordinal":72145,"en":"Your lion Alma wielded with precision."},{"id":"manas-2010:p1677:b001:l002","ordinal":72146,"en":"In that crushing, slaughterous campaign,"},{"id":"manas-2010:p1677:b001:l003","ordinal":72147,"en":"Your lion Alma endured."},{"id":"manas-2010:p1677:b001:l004","ordinal":72148,"en":"In the unbelievers' iron-stretched"},{"id":"manas-2010:p1677:b001:l005","ordinal":72149,"en":"Net your lion Alma remained;"},{"id":"manas-2010:p1677:b001:l006","ordinal":72150,"en":"In the black Kalmyk and Shibee"},{"id":"manas-2010:p1677:b001:l007","ordinal":72151,"en":"Army your lion Alma remained."},{"id":"manas-2010:p1677:b001:l008","ordinal":72152,"en":"There was no day and no night for him,"},{"id":"manas-2010:p1677:b001:l009","ordinal":72153,"en":"He took no time to rest."},{"id":"manas-2010:p1677:b001:l010","ordinal":72154,"en":"Azizkhan's morning star,"},{"id":"manas-2010:p1677:b001:l011","ordinal":72155,"en":"Alas, even in death there was no regret."},{"id":"manas-2010:p1677:b001:l012","ordinal":72156,"en":"In the desert of It-Ölbös,"},{"id":"manas-2010:p1677:b001:l013","ordinal":72157,"en":"Thundering Kün Zhang-Zhung,"},{"id":"manas-2010:p1677:b001:l014","ordinal":72158,"en":"As he pressed to raise a slaughter,"},{"id":"manas-2010:p1677:b001:l015","ordinal":72159,"en":"Azizkhan's Almambet,"},{"id":"manas-2010:p1677:b001:l016","ordinal":72160,"en":"Your resourceful hero, arrived."},{"id":"manas-2010:p1677:b001:l017","ordinal":72161,"en":"Zhang-Zhung, huge as a barrel,"},{"id":"manas-2010:p1677:b001:l018","ordinal":72162,"en":"From his gray rhinoceros,"},{"id":"manas-2010:p1677:b001:l019","ordinal":72163,"en":"The immeasurable dear lion"},{"id":"manas-2010:p1677:b001:l020","ordinal":72164,"en":"Thrust down as he passed."},{"id":"manas-2010:p1677:b001:l021","ordinal":72165,"en":"Dear Alma's hungry steel blade,"},{"id":"manas-2010:p1677:b001:l022","ordinal":72166,"en":"When eagerly drawn from its sheath,"},{"id":"manas-2010:p1677:b001:l023","ordinal":72167,"en":"Would not return without drinking blood,"},{"id":"manas-2010:p1677:b001:l024","ordinal":72168,"en":"Never swung and came back empty,"},{"id":"manas-2010:p1677:b001:l025","ordinal":72169,"en":"Never struck stone without splitting it."},{"id":"manas-2010:p1677:b001:l026","ordinal":72170,"en":"Taking Oykuma in his hand,"},{"id":"manas-2010:p1677:b001:l027","ordinal":72171,"en":"At that moment, to the Manzhuu,"},{"id":"manas-2010:p1677:b001:l028","ordinal":72172,"en":"Your devastating Alma arrived."},{"id":"manas-2010:p1677:b001:l029","ordinal":72173,"en":"As soon as he reached Zhang-Zhung,"},{"id":"manas-2010:p1677:b001:l030","ordinal":72174,"en":"He cut him into twelve pieces."},{"id":"manas-2010:p1677:b001:l031","ordinal":72175,"en":"When Kün Zhang-Zhung had died,"},{"id":"manas-2010:p1677:b001:l032","ordinal":72176,"en":"Alöökö's Kongurbay,"},{"id":"manas-2010:p1677:b001:l033","ordinal":72177,"en":"Finding himself alone,"},{"id":"manas-2010:p1677:b001:l034","ordinal":72178,"en":"Shouted in fury"},{"id":"manas-2010:p1677:b001:l035","ordinal":72179,"en":"And called Kojozhash."},{"id":"manas-2010:p1677:b001:l036","ordinal":72180,"en":"“My support that I relied upon—"},{"id":"manas-2010:p1677:b001:l037","ordinal":72181,"en":"Look well, Kojozhash!"},{"id":"manas-2010:p1677:b001:l038","ordinal":72182,"en":"This fugitive has slaughtered"},{"id":"manas-2010:p1677:b001:l039","ordinal":72183,"en":"My stately lion."},{"id":"manas-2010:p1677:b001:l040","ordinal":72184,"en":"He has dug me a deep trench,"},{"id":"manas-2010:p1677:b001:l041","ordinal":72185,"en":"He has boiled up so much misery for me;"},{"id":"manas-2010:p1677:b001:l042","ordinal":72186,"en":"He has slaughtered, do you see,"},{"id":"manas-2010:p1678:b001:l001","ordinal":72187,"en":"So many of my mighty Chinese."},{"id":"manas-2010:p1678:b001:l002","ordinal":72188,"en":"Dust rose wherever he moved,"},{"id":"manas-2010:p1678:b001:l003","ordinal":72189,"en":"His voice drove life from men;"},{"id":"manas-2010:p1678:b001:l004","ordinal":72190,"en":"He woke me wide awake,"},{"id":"manas-2010:p1678:b001:l005","ordinal":72191,"en":"He has reduced my people to rags!"},{"id":"manas-2010:p1678:b001:l006","ordinal":72192,"en":"Unless you take aim at Almambet,"}]
