[{"id":"semetey-1-2013:p0640:b004:l020","ordinal":125953,"en":"Taking the orphan for his hope,"},{"id":"semetey-1-2013:p0640:b004:l021","ordinal":125954,"en":"Pleaded with God alone,"},{"id":"semetey-1-2013:p0640:b004:l022","ordinal":125955,"en":"And went to the meat he had put in."},{"id":"semetey-1-2013:p0640:b004:l023","ordinal":125956,"en":"The cauldron remained; the meat was gone."},{"id":"semetey-1-2013:p0640:b004:l024","ordinal":125957,"en":"“He has eaten the meat of a whole camel,"},{"id":"semetey-1-2013:p0640:b004:l025","ordinal":125958,"en":"This shameless orphan!"},{"id":"semetey-1-2013:p0640:b004:l026","ordinal":125959,"en":"When leopard Manas lived,"},{"id":"semetey-1-2013:p0640:b004:l027","ordinal":125960,"en":"He, too, would eat a camel,"},{"id":"semetey-1-2013:p0640:b004:l028","ordinal":125961,"en":"But choice meat from each joint—"},{"id":"semetey-1-2013:p0640:b004:l029","ordinal":125962,"en":"‘Let elder Bakai eat,’ he would say,"},{"id":"semetey-1-2013:p0640:b004:l030","ordinal":125963,"en":"And leave it for wretched me."},{"id":"semetey-1-2013:p0640:b004:l031","ordinal":125964,"en":"My soul's companion, Manas, do not die!"},{"id":"semetey-1-2013:p0640:b004:l032","ordinal":125965,"en":"Parted from my Manas,"},{"id":"semetey-1-2013:p0640:b004:l033","ordinal":125966,"en":"Bakai, do not remain behind wailing!"},{"id":"semetey-1-2013:p0640:b004:l034","ordinal":125967,"en":"Brooding in my heart,"},{"id":"semetey-1-2013:p0640:b004:l035","ordinal":125968,"en":"Manas, take me with you, spare me humiliation"},{"id":"semetey-1-2013:p0640:b004:l036","ordinal":125969,"en":"Before the child left behind!"},{"id":"semetey-1-2013:p0640:b004:l037","ordinal":125970,"en":"When leopard Manas lived,"},{"id":"semetey-1-2013:p0640:b004:l038","ordinal":125971,"en":"Not only camel meat—"},{"id":"semetey-1-2013:p0640:b004:l039","ordinal":125972,"en":"I would slice and eat horse-belly fat,"},{"id":"semetey-1-2013:p0641:b003:l001","ordinal":125973,"en":"I would say, ‘Where is calamity?’"},{"id":"semetey-1-2013:p0641:b003:l002","ordinal":125974,"en":"The gray bull camel was a fine beast;"},{"id":"semetey-1-2013:p0641:b003:l003","ordinal":125975,"en":"It had been kept for mourning."},{"id":"semetey-1-2013:p0641:b003:l004","ordinal":125976,"en":"I was the one who tended it."},{"id":"semetey-1-2013:p0641:b003:l005","ordinal":125977,"en":"‘When my boy comes from there,"},{"id":"semetey-1-2013:p0641:b003:l006","ordinal":125978,"en":"Let me slaughter it in Manas's name,’"},{"id":"semetey-1-2013:p0641:b003:l007","ordinal":125979,"en":"That was the wish I cherished."},{"id":"semetey-1-2013:p0641:b003:l008","ordinal":125980,"en":"‘With the gray bull camel's meat,"},{"id":"semetey-1-2013:p0641:b003:l009","ordinal":125981,"en":"Let me openly eat my fill,’ I thought."},{"id":"semetey-1-2013:p0641:b003:l010","ordinal":125982,"en":"Without letting this wish come true,"},{"id":"semetey-1-2013:p0641:b003:l011","ordinal":125983,"en":"You have eaten the camel entirely!"},{"id":"semetey-1-2013:p0641:b003:l012","ordinal":125984,"en":"If you are not full, eat me;"},{"id":"semetey-1-2013:p0641:b003:l013","ordinal":125985,"en":"Eat the warriors Abyke and Köbösh."},{"id":"semetey-1-2013:p0641:b003:l014","ordinal":125986,"en":"If that proves too little,"},{"id":"semetey-1-2013:p0641:b003:l015","ordinal":125987,"en":"Eat your father's forty companions too!”"},{"id":"semetey-1-2013:p0641:b003:l016","ordinal":125988,"en":"Thus Bakai cursed him now."},{"id":"semetey-1-2013:p0641:b003:l017","ordinal":125989,"en":"Your orphan, the son of Manas,"},{"id":"semetey-1-2013:p0641:b003:l018","ordinal":125990,"en":"Had eaten his fill of camel."},{"id":"semetey-1-2013:p0641:b003:l019","ordinal":125991,"en":"Khan Bakai's heart grew warm:"},{"id":"semetey-1-2013:p0641:b003:l020","ordinal":125992,"en":"“My dear orphan"},{"id":"semetey-1-2013:p0641:b003:l021","ordinal":125993,"en":"Has fortune complete on every side."},{"id":"semetey-1-2013:p0641:b003:l022","ordinal":125994,"en":"He is a warrior who takes after his father;"},{"id":"semetey-1-2013:p0641:b003:l023","ordinal":125995,"en":"Every limb is broad."},{"id":"semetey-1-2013:p0641:b003:l024","ordinal":125996,"en":"My spring flowing down from the ridge,"},{"id":"semetey-1-2013:p0641:b003:l025","ordinal":125997,"en":"From my renowned lord Manas,"},{"id":"semetey-1-2013:p0641:b003:l026","ordinal":125998,"en":"My dear one left as a gift."},{"id":"semetey-1-2013:p0641:b003:l027","ordinal":125999,"en":"May he stay safe and well!"},{"id":"semetey-1-2013:p0641:b003:l028","ordinal":126000,"en":"Even if he eats six camels' meat,"},{"id":"semetey-1-2013:p0641:b003:l029","ordinal":126001,"en":"I shall ask God for it."},{"id":"semetey-1-2013:p0641:b003:l030","ordinal":126002,"en":"I have but one sun to look upon;"},{"id":"semetey-1-2013:p0641:b003:l031","ordinal":126003,"en":"Whom have I besides this one?"},{"id":"semetey-1-2013:p0641:b003:l032","ordinal":126004,"en":"‘Keep him safe,’ I said,"},{"id":"semetey-1-2013:p0641:b003:l033","ordinal":126005,"en":"And cried out to God alone."},{"id":"semetey-1-2013:p0641:b003:l034","ordinal":126006,"en":"The figure before my eyes,"},{"id":"semetey-1-2013:p0641:b003:l035","ordinal":126007,"en":"The presence before my brow,"},{"id":"semetey-1-2013:p0641:b003:l036","ordinal":126008,"en":"My heart is flame, my breast is embers."},{"id":"semetey-1-2013:p0641:b003:l037","ordinal":126009,"en":"My orphan left by Manas—"},{"id":"semetey-1-2013:p0641:b003:l038","ordinal":126010,"en":"I have no one else but him.”"},{"id":"semetey-1-2013:p0641:b003:l039","ordinal":126011,"en":"As Bakai sang,"},{"id":"semetey-1-2013:p0641:b005:l001","ordinal":126012,"en":"Bölökbai led the forty guards;"},{"id":"semetey-1-2013:p0641:b005:l002","ordinal":126013,"en":"They made ready by the cauldron,"},{"id":"semetey-1-2013:p0641:b005:l003","ordinal":126014,"en":"All together cooking meat."},{"id":"semetey-1-2013:p0641:b005:l004","ordinal":126015,"en":"When the meat was cooked,"},{"id":"semetey-1-2013:p0641:b005:l005","ordinal":126016,"en":"They spoke a blessing to Baabedin,"},{"id":"semetey-1-2013:p0641:b005:l006","ordinal":126017,"en":"Vowed a sheep to Khoroshon,"},{"id":"semetey-1-2013:p0641:b005:l007","ordinal":126018,"en":"And made ready for the cooked meat."},{"id":"semetey-1-2013:p0641:b005:l008","ordinal":126019,"en":"Bölökbai at their head, Khan Bakai,"},{"id":"semetey-1-2013:p0641:b005:l009","ordinal":126020,"en":"And the forty guards with them,"},{"id":"semetey-1-2013:p0641:b005:l010","ordinal":126021,"en":"The sorrow in their hearts—"},{"id":"semetey-1-2013:p0641:b005:l011","ordinal":126022,"en":"They dispelled every last part of it."},{"id":"semetey-1-2013:p0641:b005:l012","ordinal":126023,"en":"On the gray wether's meat,"},{"id":"semetey-1-2013:p0641:b005:l013","ordinal":126024,"en":"As though bloodthirsty leopard Manas"},{"id":"semetey-1-2013:p0641:b005:l014","ordinal":126025,"en":"Were still there, they bustled joyfully;"},{"id":"semetey-1-2013:p0641:b005:l015","ordinal":126026,"en":"Every one of them ate their fill."},{"id":"semetey-1-2013:p0641:b005:l016","ordinal":126027,"en":"Such was that meat's abundance:"},{"id":"semetey-1-2013:p0641:b005:l017","ordinal":126028,"en":"When warrior Manas lived,"},{"id":"semetey-1-2013:p0641:b005:l018","ordinal":126029,"en":"From within that cauldron,"},{"id":"semetey-1-2013:p0641:b005:l019","ordinal":126030,"en":"Five hundred people would eat their fill."},{"id":"semetey-1-2013:p0641:b005:l020","ordinal":126031,"en":"That cauldron filled to overflowing;"},{"id":"semetey-1-2013:p0641:b005:l021","ordinal":126032,"en":"More food remained boiling in it."},{"id":"semetey-1-2013:p0641:b005:l022","ordinal":126033,"en":"Who knows? We do not know, if it is true,"},{"id":"semetey-1-2013:p0641:b005:l023","ordinal":126034,"en":"Food had come from the unseen,"},{"id":"semetey-1-2013:p0641:b005:l024","ordinal":126035,"en":"And filled it up again."},{"id":"semetey-1-2013:p0641:b005:l025","ordinal":126036,"en":"The forty guards and Bölökbai,"},{"id":"semetey-1-2013:p0641:b005:l026","ordinal":126037,"en":"With leopard Bakai at their head,"},{"id":"semetey-1-2013:p0641:b005:l027","ordinal":126038,"en":"Had eaten a hearty fill."},{"id":"semetey-1-2013:p0641:b005:l028","ordinal":126039,"en":"Enough meat for another meal"},{"id":"semetey-1-2013:p0641:b005:l029","ordinal":126040,"en":"Was still left over."},{"id":"semetey-1-2013:p0641:b005:l030","ordinal":126041,"en":"The reason it was left over—"},{"id":"semetey-1-2013:p0641:b005:l031","ordinal":126042,"en":"When leopard Manas, bloodthirsty lion,"},{"id":"semetey-1-2013:p0641:b005:l032","ordinal":126043,"en":"Journeyed to Mecca,"},{"id":"semetey-1-2013:p0641:b005:l033","ordinal":126044,"en":"And visited Medina,"},{"id":"semetey-1-2013:p0641:b005:l034","ordinal":126045,"en":"Received a letter from the caliph,"},{"id":"semetey-1-2013:p0641:b005:l035","ordinal":126046,"en":"Received a blessing from the prince,"},{"id":"semetey-1-2013:p0641:b005:l036","ordinal":126047,"en":"And was named the conquering lord,"},{"id":"semetey-1-2013:p0641:b005:l037","ordinal":126048,"en":"When dear Manas set forth,"},{"id":"semetey-1-2013:p0641:b005:l038","ordinal":126049,"en":"When leopard Manas was alive,"},{"id":"semetey-1-2013:p0641:b005:l039","ordinal":126050,"en":"Exchanging shots for seven days without pause,"},{"id":"semetey-1-2013:p0642:b003:l001","ordinal":126051,"en":"When he brought down the Kaldai's banner,"},{"id":"semetey-1-2013:p0642:b003:l002","ordinal":126052,"en":"Upon the Kalmyks who came out on guard,"},{"id":"semetey-1-2013:p0642:b003:l003","ordinal":126053,"en":"He brought turmoil."},{"id":"semetey-1-2013:p0642:b003:l004","ordinal":126054,"en":"In those days, the Muslims of the world,"},{"id":"semetey-1-2013:p0642:b003:l005","ordinal":126055,"en":"From the infidels who held them besieged,"},{"id":"semetey-1-2013:p0642:b003:l006","ordinal":126056,"en":"He set them free."},{"id":"semetey-1-2013:p0642:b003:l007","ordinal":126057,"en":"When turmoil upon the face of the earth"},{"id":"semetey-1-2013:p0642:b003:l008","ordinal":126058,"en":"Was brought by Manas alone,"},{"id":"semetey-1-2013:p0642:b003:l009","ordinal":126059,"en":"On the ridge of Kum-Bulak,"},{"id":"semetey-1-2013:p0642:b003:l010","ordinal":126060,"en":"Where he performed his ablutions,"},{"id":"semetey-1-2013:p0642:b003:l011","ordinal":126061,"en":"In the desert of Mediyan,"},{"id":"semetey-1-2013:p0642:b003:l012","ordinal":126062,"en":"It was found through the unseen,"},{"id":"semetey-1-2013:p0642:b003:l013","ordinal":126063,"en":"Hanging in the open plain."},{"id":"semetey-1-2013:p0642:b003:l014","ordinal":126064,"en":"For Manas, visited by Khizir,"},{"id":"semetey-1-2013:p0642:b003:l015","ordinal":126065,"en":"That cauldron was found."},{"id":"semetey-1-2013:p0642:b003:l016","ordinal":126066,"en":"When the cauldron came to Manas,"},{"id":"semetey-1-2013:p0642:b003:l017","ordinal":126067,"en":"Sacred power came with it."},{"id":"semetey-1-2013:p0642:b003:l018","ordinal":126068,"en":"Bakai of Oluyat,"},{"id":"semetey-1-2013:p0642:b003:l019","ordinal":126069,"en":"Ajibai of Khan Argin,"},{"id":"semetey-1-2013:p0642:b003:l020","ordinal":126070,"en":"Chubak of Akbaltai,"},{"id":"semetey-1-2013:p0642:b003:l021","ordinal":126071,"en":"Almambet of Khan Aziz—"},{"id":"semetey-1-2013:p0642:b003:l022","ordinal":126072,"en":"Enough, all the mighty warriors were found."},{"id":"semetey-1-2013:p0642:b003:l023","ordinal":126073,"en":"For Manas, visited by Khizir,"},{"id":"semetey-1-2013:p0642:b003:l024","ordinal":126074,"en":"Many things were found."},{"id":"semetey-1-2013:p0642:b003:l025","ordinal":126075,"en":"Manas, visited by Baabedin,"},{"id":"semetey-1-2013:p0642:b003:l026","ordinal":126076,"en":"Encountered all the warriors."},{"id":"semetey-1-2013:p0642:b003:l027","ordinal":126077,"en":"The finest of cauldrons, the brass cauldron,"},{"id":"semetey-1-2013:p0642:b003:l028","ordinal":126078,"en":"The finest of wives, Kanykei—"},{"id":"semetey-1-2013:p0642:b003:l029","ordinal":126079,"en":"God alone brought them all;"},{"id":"semetey-1-2013:p0642:b003:l030","ordinal":126080,"en":"These were found for the sovereign."},{"id":"semetey-1-2013:p0642:b003:l031","ordinal":126081,"en":"Manas's supernatural cauldron,"},{"id":"semetey-1-2013:p0642:b003:l032","ordinal":126082,"en":"Its handles were folded fourfold."},{"id":"semetey-1-2013:p0642:b003:l033","ordinal":126083,"en":"Whenever he went on a holy campaign, he never left it,"},{"id":"semetey-1-2013:p0642:b003:l034","ordinal":126084,"en":"To give food to the army,"},{"id":"semetey-1-2013:p0642:b003:l035","ordinal":126085,"en":"He loaded that cauldron along."},{"id":"semetey-1-2013:p0642:b003:l036","ordinal":126086,"en":"The cauldron boiled, then quieted;"},{"id":"semetey-1-2013:p0642:b003:l037","ordinal":126087,"en":"All the guards ate their fill."},{"id":"semetey-1-2013:p0642:b003:l038","ordinal":126088,"en":"God's light shone upon the cauldron;"},{"id":"semetey-1-2013:p0642:b003:l039","ordinal":126089,"en":"Every belly was filled,"},{"id":"semetey-1-2013:p0642:b004:l001","ordinal":126090,"en":"Every sorrow was dispelled."},{"id":"semetey-1-2013:p0642:b004:l002","ordinal":126091,"en":"Entering Keng-Kol, finding the land,"},{"id":"semetey-1-2013:p0642:b004:l003","ordinal":126092,"en":"Finding Khan Manas's only son,"},{"id":"semetey-1-2013:p0642:b004:l004","ordinal":126093,"en":"A warrior like Semetey—"},{"id":"semetey-1-2013:p0642:b004:l005","ordinal":126094,"en":"The forty guards left naked,"},{"id":"semetey-1-2013:p0642:b004:l006","ordinal":126095,"en":"And Bölökbai, now smiling,"},{"id":"semetey-1-2013:p0642:b004:l007","ordinal":126096,"en":"Took the short path inward."},{"id":"semetey-1-2013:p0642:b004:l008","ordinal":126097,"en":"All the guards,"},{"id":"semetey-1-2013:p0642:b004:l009","ordinal":126098,"en":"With Khan Bakai at their head,"},{"id":"semetey-1-2013:p0642:b004:l010","ordinal":126099,"en":"He led toward the treasury."},{"id":"semetey-1-2013:p0642:b004:l011","ordinal":126100,"en":"Your poor one left by Manas,"},{"id":"semetey-1-2013:p0642:b004:l012","ordinal":126101,"en":"Your falcon left by the sovereign—"},{"id":"semetey-1-2013:p0642:b004:l013","ordinal":126102,"en":"The treasury his mother Kanykei had hidden,"},{"id":"semetey-1-2013:p0642:b004:l014","ordinal":126103,"en":"He opened its entrance now."},{"id":"semetey-1-2013:p0642:b004:l015","ordinal":126104,"en":"To all forty guards,"},{"id":"semetey-1-2013:p0642:b004:l016","ordinal":126105,"en":"Red gold and precious stones"},{"id":"semetey-1-2013:p0642:b004:l017","ordinal":126106,"en":"He scattered freely now."},{"id":"semetey-1-2013:p0642:b004:l018","ordinal":126107,"en":"Then he went farther in;"},{"id":"semetey-1-2013:p0642:b004:l019","ordinal":126108,"en":"Many wonders, many objects"},{"id":"semetey-1-2013:p0642:b004:l020","ordinal":126109,"en":"Were standing farther inside."},{"id":"semetey-1-2013:p0642:b004:l021","ordinal":126110,"en":"She had had them placed without measure,"},{"id":"semetey-1-2013:p0642:b004:l022","ordinal":126111,"en":"Twelve, like reclining camels,"},{"id":"semetey-1-2013:p0642:b004:l023","ordinal":126112,"en":"Bound in a row."},{"id":"semetey-1-2013:p0642:b004:l024","ordinal":126113,"en":"When those bundles were untied,"},{"id":"semetey-1-2013:p0642:b004:l025","ordinal":126114,"en":"It was a wondrous sight to see:"},{"id":"semetey-1-2013:p0642:b004:l026","ordinal":126115,"en":"My mother had left"},{"id":"semetey-1-2013:p0642:b004:l027","ordinal":126116,"en":"Many fitting things."},{"id":"semetey-1-2013:p0642:b004:l028","ordinal":126117,"en":"My poor mother Kanykei,"},{"id":"semetey-1-2013:p0642:b004:l029","ordinal":126118,"en":"‘If my orphan stays well,"},{"id":"semetey-1-2013:p0642:b004:l030","ordinal":126119,"en":"If my dear one does not die,"},{"id":"semetey-1-2013:p0642:b004:l031","ordinal":126120,"en":"He will return to Talas,’ she thought."},{"id":"semetey-1-2013:p0642:b004:l032","ordinal":126121,"en":"‘His mother's worth,"},{"id":"semetey-1-2013:p0642:b004:l033","ordinal":126122,"en":"If he becomes a man, he will know."},{"id":"semetey-1-2013:p0642:b004:l034","ordinal":126123,"en":"The wretched orphan left by the generous one,"},{"id":"semetey-1-2013:p0642:b004:l035","ordinal":126124,"en":"When he enters battle, he will wear these.’"},{"id":"semetey-1-2013:p0642:b004:l036","ordinal":126125,"en":"She had hidden coats of every kind."},{"id":"semetey-1-2013:p0642:b004:l037","ordinal":126126,"en":"Oh, my afflicted, unfortunate mother,"},{"id":"semetey-1-2013:p0642:b004:l038","ordinal":126127,"en":"She had hidden abundant wealth."},{"id":"semetey-1-2013:p0642:b004:l039","ordinal":126128,"en":"My dear mother Kanykei"},{"id":"semetey-1-2013:p0643:b003:l001","ordinal":126129,"en":"Clothes for war were set apart,"},{"id":"semetey-1-2013:p0643:b003:l002","ordinal":126130,"en":"Clothes for disputes were set apart,"},{"id":"semetey-1-2013:p0643:b003:l003","ordinal":126131,"en":"And a khan's clothes were set apart."},{"id":"semetey-1-2013:p0643:b003:l004","ordinal":126132,"en":"Lest lice infest them,"},{"id":"semetey-1-2013:p0643:b003:l005","ordinal":126133,"en":"A thousand separate changes against lice;"},{"id":"semetey-1-2013:p0643:b003:l006","ordinal":126134,"en":"Lest dirt soil them,"},{"id":"semetey-1-2013:p0643:b003:l007","ordinal":126135,"en":"A thousand separate changes against dirt."},{"id":"semetey-1-2013:p0643:b003:l008","ordinal":126136,"en":"Summer clothes were set apart,"},{"id":"semetey-1-2013:p0643:b003:l009","ordinal":126137,"en":"And winter clothes were set apart."},{"id":"semetey-1-2013:p0643:b003:l010","ordinal":126138,"en":"Binding and folding them again,"},{"id":"semetey-1-2013:p0643:b003:l011","ordinal":126139,"en":"Inside the treasury,"},{"id":"semetey-1-2013:p0643:b003:l012","ordinal":126140,"en":"My mother had left them,"},{"id":"semetey-1-2013:p0643:b003:l013","ordinal":126141,"en":"Entrusting them to her dear Semetey."},{"id":"semetey-1-2013:p0643:b003:l014","ordinal":126142,"en":"‘If God alone grants him life,"},{"id":"semetey-1-2013:p0643:b003:l015","ordinal":126143,"en":"If the orphan grows up without dying,"},{"id":"semetey-1-2013:p0643:b003:l016","ordinal":126144,"en":"He will enter the treasury."},{"id":"semetey-1-2013:p0643:b003:l017","ordinal":126145,"en":"If my orphan has understanding,"},{"id":"semetey-1-2013:p0643:b003:l018","ordinal":126146,"en":"He will know my worth."},{"id":"semetey-1-2013:p0643:b003:l019","ordinal":126147,"en":"Then this son of mine"},{"id":"semetey-1-2013:p0643:b003:l020","ordinal":126148,"en":"Will heed what I say."},{"id":"semetey-1-2013:p0643:b003:l021","ordinal":126149,"en":"To the poor ones left by Manas,"},{"id":"semetey-1-2013:p0643:b003:l022","ordinal":126150,"en":"He will give these as gifts.’"},{"id":"semetey-1-2013:p0643:b003:l023","ordinal":126151,"en":"Your warrior mother Kanykei"},{"id":"semetey-1-2013:p0643:b003:l024","ordinal":126152,"en":"Had undertaken all this toil."},{"id":"semetey-1-2013:p0643:b003:l025","ordinal":126153,"en":"‘My orphan will need them,’ she said."},{"id":"semetey-1-2013:p0643:b003:l026","ordinal":126154,"en":"That accomplished, bold woman"},{"id":"semetey-1-2013:p0643:b003:l027","ordinal":126155,"en":"Who boasted of his valor."},{"id":"semetey-1-2013:p0643:b003:l028","ordinal":126156,"en":"Toward the mouth of that cave,"},{"id":"semetey-1-2013:p0643:b003:l029","ordinal":126157,"en":"Warrior Bakai, Bölökbai,"},{"id":"semetey-1-2013:p0643:b003:l030","ordinal":126158,"en":"And the forty guards who had wept so hard,"},{"id":"semetey-1-2013:p0643:b003:l031","ordinal":126159,"en":"All turned and stood now."},{"id":"semetey-1-2013:p0643:b003:l032","ordinal":126160,"en":"The renowned orphan Semetey"},{"id":"semetey-1-2013:p0643:b003:l033","ordinal":126161,"en":"Displayed his warrior generosity now."},{"id":"semetey-1-2013:p0643:b003:l034","ordinal":126162,"en":"His forefathers were all khans,"},{"id":"semetey-1-2013:p0643:b003:l035","ordinal":126163,"en":"Blessed by Khizir from the root,"},{"id":"semetey-1-2013:p0643:b003:l036","ordinal":126164,"en":"Descendant of a firmly rooted land,"},{"id":"semetey-1-2013:p0643:b003:l037","ordinal":126165,"en":"His first ancestors were all khans,"},{"id":"semetey-1-2013:p0643:b003:l038","ordinal":126166,"en":"Blessed by Khizir from the beginning—"},{"id":"semetey-1-2013:p0643:b003:l039","ordinal":126167,"en":"Such was your warrior himself."},{"id":"semetey-1-2013:p0643:b005:l001","ordinal":126168,"en":"He opened the treasury's entrance now."},{"id":"semetey-1-2013:p0643:b005:l002","ordinal":126169,"en":"Andijan's thick-weft yellow-mottled cloth,"},{"id":"semetey-1-2013:p0643:b005:l003","ordinal":126170,"en":"Bukhara's precious black-mottled cloth—"},{"id":"semetey-1-2013:p0643:b005:l004","ordinal":126171,"en":"All this wealth"},{"id":"semetey-1-2013:p0643:b005:l005","ordinal":126172,"en":"He distributed freely now."},{"id":"semetey-1-2013:p0643:b005:l006","ordinal":126173,"en":"With neither excess nor shortfall,"},{"id":"semetey-1-2013:p0643:b005:l007","ordinal":126174,"en":"The orphan slave, born just,"},{"id":"semetey-1-2013:p0643:b005:l008","ordinal":126175,"en":"Gave it to the guards."},{"id":"semetey-1-2013:p0643:b005:l009","ordinal":126176,"en":"Truly created by God—"},{"id":"semetey-1-2013:p0643:b005:l010","ordinal":126177,"en":"Have you seen that he is His servant?"},{"id":"semetey-1-2013:p0643:b005:l011","ordinal":126178,"en":"Of poor Lord Manas,"},{"id":"semetey-1-2013:p0643:b005:l012","ordinal":126179,"en":"Have you seen that he is the son?"},{"id":"semetey-1-2013:p0643:b005:l013","ordinal":126180,"en":"For twelve years crying out,"},{"id":"semetey-1-2013:p0643:b005:l014","ordinal":126181,"en":"All those poor men—"},{"id":"semetey-1-2013:p0643:b005:l015","ordinal":126182,"en":"Have you seen their longing?"},{"id":"semetey-1-2013:p0643:b005:l016","ordinal":126183,"en":"Coming here to Talas,"},{"id":"semetey-1-2013:p0643:b005:l017","ordinal":126184,"en":"The orphan born fortunate—"},{"id":"semetey-1-2013:p0643:b005:l018","ordinal":126185,"en":"Have you seen him found?"},{"id":"semetey-1-2013:p0643:b005:l019","ordinal":126186,"en":"Battle clothing was set apart."},{"id":"semetey-1-2013:p0643:b005:l020","ordinal":126187,"en":"Here he saw their nakedness;"},{"id":"semetey-1-2013:p0643:b005:l021","ordinal":126188,"en":"Here he gave them battle clothing."},{"id":"semetey-1-2013:p0643:b005:l022","ordinal":126189,"en":"The reason he gave them clothes—"},{"id":"semetey-1-2013:p0643:b005:l023","ordinal":126190,"en":"Their coats were torn to shreds."},{"id":"semetey-1-2013:p0643:b005:l024","ordinal":126191,"en":"When the forty guards stood in a row,"},{"id":"semetey-1-2013:p0643:b005:l025","ordinal":126192,"en":"It looked similar"},{"id":"semetey-1-2013:p0643:b005:l026","ordinal":126193,"en":"They had no means to cover them;"},{"id":"semetey-1-2013:p0643:b005:l027","ordinal":126194,"en":"What else could the forty guards do?"},{"id":"semetey-1-2013:p0643:b005:l028","ordinal":126195,"en":"They had no strength to conceal them."},{"id":"semetey-1-2013:p0643:b005:l029","ordinal":126196,"en":"The honorable orphan was found,"},{"id":"semetey-1-2013:p0643:b005:l030","ordinal":126197,"en":"A gift from God."},{"id":"semetey-1-2013:p0643:b005:l031","ordinal":126198,"en":"Their shameful parts were covered;"},{"id":"semetey-1-2013:p0643:b005:l032","ordinal":126199,"en":"Their lion orphan had come."},{"id":"semetey-1-2013:p0643:b005:l033","ordinal":126200,"en":"The forty guards stood in a row."},{"id":"semetey-1-2013:p0643:b005:l034","ordinal":126201,"en":"Saying, ‘In God's name!’ to Bakai,"},{"id":"semetey-1-2013:p0643:b005:l035","ordinal":126202,"en":"A golden collar, copper sleeves,"},{"id":"semetey-1-2013:p0643:b005:l036","ordinal":126203,"en":"Double mail, with rings like larks' eyes,"},{"id":"semetey-1-2013:p0643:b005:l037","ordinal":126204,"en":"A braid-trimmed vest, a broad neckband,"},{"id":"semetey-1-2013:p0643:b005:l038","ordinal":126205,"en":"Mail to wear in battle,"},{"id":"semetey-1-2013:p0643:b005:l039","ordinal":126206,"en":"Lined inside with silk,"},{"id":"semetey-1-2013:p0644:b003:l001","ordinal":126207,"en":"Dear lady Kanykei,"},{"id":"semetey-1-2013:p0644:b003:l002","ordinal":126208,"en":"For many days and nights,"}]
