{"id": "sayakbay-ms-current146:pdf152:l001", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 152, "folio": 535, "line_in_page": 1, "raw": "Кыйын кыргыз кайран журт,", "text": "Кыйын кыргыз кайран журт,", "en": "The suffering Kyrgyz, the poor people,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: this cursive row is an addition or variant without a secure exact printed counterpart.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf152:l002", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 152, "folio": 535, "line_in_page": 2, "raw": "Күйүп кандай болду деп,", "text": "Күйүп кандай болду деп,", "en": "Burned with grief, asking what had happened,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: this cursive row is an addition or variant without a secure exact printed counterpart.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf152:l003", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 152, "folio": 535, "line_in_page": 3, "raw": "Адам курман болду кыргыз,", "text": "Адам курман болду кыргыз,", "en": "A Kyrgyz man had fallen as a sacrifice,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: this cursive row is an addition or variant without a secure exact printed counterpart.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf152:l004", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 152, "folio": 535, "line_in_page": 4, "raw": "Кара мордой мол төрөтүн,", "text": "Кара мордой мол төрөтүн,", "en": "The dark-faced multitude had bred in abundance,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: this cursive row is an addition or variant without a secure exact printed counterpart.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf152:l005", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 152, "folio": 535, "line_in_page": 5, "raw": "Калыңдан баарын сорду деп,", "text": "Калыңдан баарын сорду деп,", "en": "They said it had drained everything from the multitude,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: this cursive row is an addition or variant without a secure exact printed counterpart.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf152:l006", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 152, "folio": 535, "line_in_page": 6, "raw": "Кандай шумдук болду деп,", "text": "Кандай шумдук болду деп,", "en": "“What calamity has happened?” they asked,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf152:l007", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 152, "folio": 535, "line_in_page": 7, "raw": "Каардан көрүп кыйкырып,", "text": "Каардан көрүп кыйкырып,", "en": "Seeing the fury, they cried aloud,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: this cursive row is an addition or variant without a secure exact printed counterpart.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf152:l008", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 152, "folio": 535, "line_in_page": 8, "raw": "Калк эндиреп турду эле.", "text": "Калк эндиреп турду эле.", "en": "The people stood there groaning.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf152:l009", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 152, "folio": 535, "line_in_page": 9, "raw": "Калкы минтип турганда,", "text": "Калкы минтип турганда,", "en": "While the people stood in this state,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf152:l010", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 152, "folio": 535, "line_in_page": 10, "raw": "Калк атасы эр Көгөй,", "text": "Калк атасы эр Көгөй,", "en": "The people’s father, the warrior Kögöy,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf152:l011", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 152, "folio": 535, "line_in_page": 11, "raw": "Минген аты Тобурчак,", "text": "Минген аты Тобурчак,", "en": "Whose mount was Toburchak,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf152:l012", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 152, "folio": 535, "line_in_page": 12, "raw": "Ыргып түшүп тулпардан,", "text": "Ыргып түшүп тулпардан,", "en": "Leaped down from the swift horse,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf152:l013", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 152, "folio": 535, "line_in_page": 13, "raw": "Кутпага мойнун бурду эми,", "text": "Кутпага мойнун бурду эми,", "en": "And now turned his face toward the qibla,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf152:l014", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 152, "folio": 535, "line_in_page": 14, "raw": "Журт туткасы Кененден,", "text": "Журт туткасы Кененден,", "en": "From Kenen, pillar of the people,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf152:l015", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 152, "folio": 535, "line_in_page": 15, "raw": "Бата сурап турду эми:", "text": "Бата сурап турду эми:", "en": "He now stood asking for a blessing:", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf152:l016", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 152, "folio": 535, "line_in_page": 16, "raw": "Кара көкжал кабылан,", "text": "Кара көкжал кабылан,", "en": "Black-maned wolf and leopard,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf152:l017", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 152, "folio": 535, "line_in_page": 17, "raw": "Арстан эрдин тукуму.", "text": "Арстан эрдин тукуму.", "en": "Descendant of a lion-hearted hero.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf152:l018", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 152, "folio": 535, "line_in_page": 18, "raw": "Түп атаңыз Түгөлкан,", "text": "Түп атаңыз Түгөлкан,", "en": "Your founding ancestor was Tügöl Khan,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf152:l019", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 152, "folio": 535, "line_in_page": 19, "raw": "Түбүнөн кыдыр даарыган,", "text": "Түбүнөн кыдыр даарыган,", "en": "Blessed by fortune from his very roots,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf152:l020", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 152, "folio": 535, "line_in_page": 20, "raw": "Башкы атаңдын баары кан,", "text": "Башкы атаңдын баары кан,", "en": "All your foremost ancestors were khans,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf152:l021", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 152, "folio": 535, "line_in_page": 21, "raw": "Байыртан чилтен жар болгон,", "text": "Байыртан чилтен жар болгон,", "en": "From ancient times the forty saints were their allies,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf152:l022", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 152, "folio": 535, "line_in_page": 22, "raw": "Өлгөн сайын өөрчүгөн,", "text": "Өлгөн сайын өөрчүгөн,", "en": "Each time one died, the line grew stronger,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf152:l023", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 152, "folio": 535, "line_in_page": 23, "raw": "Өзүн кыдыр ээрчиген,", "text": "Өзүн кыдыр ээрчиген,", "en": "Fortune itself followed him,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf152:l024", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 152, "folio": 535, "line_in_page": 24, "raw": "Тулаңдуу жерге туу сайган,", "text": "Тулаңдуу жерге туу сайган,", "en": "He planted his banner on grassy lands,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf152:l025", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 152, "folio": 535, "line_in_page": 25, "raw": "Өкүмсүнүп келгенге,", "text": "Өкүмсүнүп келгенге,", "en": "Against any who came arrogantly,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf152:l026", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 152, "folio": 535, "line_in_page": 26, "raw": "Ата бабаң өрт салган!", "text": "Ата бабаң өрт салган!", "en": "Your forefathers unleashed fire!", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf152:l027", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 152, "folio": 535, "line_in_page": 27, "raw": "Абаңыз Көгөй баатырдын,", "text": "Абаңыз Көгөй баатырдын,", "en": "Of your elder, the warrior Kögöy,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf152:l028", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 152, "folio": 535, "line_in_page": 28, "raw": "Айтканына көнүңүз,", "text": "Айтканына көнүңүз,", "en": "Consent to what he says,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf152:l029", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 152, "folio": 535, "line_in_page": 29, "raw": "Артык бата бериңиз!", "text": "Артык бата бериңиз!", "en": "And grant your finest blessing!", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf152:l030", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 152, "folio": 535, "line_in_page": 30, "raw": "Алакан жайып ала деп,", "text": "Алакан жайып ала деп,", "en": "“Let us receive it with palms outstretched,”", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: this cursive row is an addition or variant without a secure exact printed counterpart.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf152:l031", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 152, "folio": 535, "line_in_page": 31, "raw": "Жараткандан келели,", "text": "Жараткандан келели,", "en": "Let us seek it from the Creator,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: this cursive row is an addition or variant without a secure exact printed counterpart.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf152:l032", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 152, "folio": 535, "line_in_page": 32, "raw": "Тагдыр канча көрүңүз,", "text": "Тагдыр канча көрүңүз,", "en": "Whatever fate may bring, behold it,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: this cursive row is an addition or variant without a secure exact printed counterpart.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf152:l033", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 152, "folio": 535, "line_in_page": 33, "raw": "Ажал жетип күн бүтсө,", "text": "Ажал жетип күн бүтсө,", "en": "If death arrives and one’s days are done,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf152:l034", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 152, "folio": 535, "line_in_page": 34, "raw": "Опат болуп окуздан,", "text": "Опат болуп окуздан,", "en": "If we perish through insolence,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf152:l035", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 152, "folio": 535, "line_in_page": 35, "raw": "Ойрон болсок кокуздан.", "text": "Ойрон болсок кокуздан.", "en": "If we are destroyed through arrogance.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
