[{"id":"manas-2010:p1623:b001:l013","ordinal":69889,"en":"Making him leap and bound,"},{"id":"manas-2010:p1623:b001:l014","ordinal":69890,"en":"Sending the steed Algara surging,"},{"id":"manas-2010:p1623:b001:l015","ordinal":69891,"en":"Jerking the golden lead-rein,"},{"id":"manas-2010:p1623:b001:l016","ordinal":69892,"en":"The warriors' black horse,"},{"id":"manas-2010:p1623:b001:l017","ordinal":69893,"en":"That black horse indeed had"},{"id":"manas-2010:p1623:b001:l018","ordinal":69894,"en":"Wings upon his flanks."},{"id":"manas-2010:p1623:b001:l019","ordinal":69895,"en":"He threw the whole world into turmoil;"},{"id":"manas-2010:p1623:b001:l020","ordinal":69896,"en":"His ways were rich in resourcefulness."},{"id":"manas-2010:p1623:b001:l021","ordinal":69897,"en":"Cotton sash and wide boots,"},{"id":"manas-2010:p1623:b001:l022","ordinal":69898,"en":"Kongurbay, khan of the monks,"},{"id":"manas-2010:p1623:b001:l023","ordinal":69899,"en":"Was a champion who knew the enemy's tricks,"},{"id":"manas-2010:p1623:b001:l024","ordinal":69900,"en":"A fellow skilled among spearmen,"},{"id":"manas-2010:p1623:b001:l025","ordinal":69901,"en":"A mighty fellow who knew the enemy's tricks."},{"id":"manas-2010:p1623:b001:l026","ordinal":69902,"en":"He was the support they relied upon,"},{"id":"manas-2010:p1623:b001:l027","ordinal":69903,"en":"He was their fortified refuge."},{"id":"manas-2010:p1623:b001:l028","ordinal":69904,"en":"Of the forty khans under the emperor,"},{"id":"manas-2010:p1623:b001:l029","ordinal":69905,"en":"He was the hero who guarded them."},{"id":"manas-2010:p1623:b001:l030","ordinal":69906,"en":"His spectacles gleamed;"},{"id":"manas-2010:p1623:b001:l031","ordinal":69907,"en":"A bead-stone large as a flask"},{"id":"manas-2010:p1623:b001:l032","ordinal":69908,"en":"Flashed upon his head."},{"id":"manas-2010:p1623:b001:l033","ordinal":69909,"en":"A lacquered pipe with a golden stem,"},{"id":"manas-2010:p1623:b001:l034","ordinal":69910,"en":"A champion beyond other men,"},{"id":"manas-2010:p1623:b001:l035","ordinal":69911,"en":"The Fierce One, huge as a hut,"},{"id":"manas-2010:p1623:b001:l036","ordinal":69912,"en":"His stern face transformed,"},{"id":"manas-2010:p1623:b001:l037","ordinal":69913,"en":"His eyes blazed like fire."},{"id":"manas-2010:p1623:b001:l038","ordinal":69914,"en":"Six thousand Chinese and countless governors"},{"id":"manas-2010:p1623:b001:l039","ordinal":69915,"en":"He drove before him."},{"id":"manas-2010:p1623:b001:l040","ordinal":69916,"en":"That speechless, tumultuous fellow's"},{"id":"manas-2010:p1623:b001:l041","ordinal":69917,"en":"Two eyes blazed."},{"id":"manas-2010:p1623:b001:l042","ordinal":69918,"en":"Those mounted on dapple-roan horses,"},{"id":"manas-2010:p1624:b001:l001","ordinal":69919,"en":"The spearmen, he separated out;"},{"id":"manas-2010:p1624:b001:l002","ordinal":69920,"en":"The marksmen who never missed"},{"id":"manas-2010:p1624:b001:l003","ordinal":69921,"en":"He drove toward the suffering."},{"id":"manas-2010:p1624:b001:l004","ordinal":69922,"en":"The Muslims who watched,"},{"id":"manas-2010:p1624:b001:l005","ordinal":69923,"en":"When they saw the enemy's array,"},{"id":"manas-2010:p1624:b001:l006","ordinal":69924,"en":"Their misery boiled up like this."},{"id":"manas-2010:p1624:b001:l007","ordinal":69925,"en":"The reason it boiled up:"},{"id":"manas-2010:p1624:b001:l008","ordinal":69926,"en":"Hallowed Ali, the lion,"},{"id":"manas-2010:p1624:b001:l009","ordinal":69927,"en":"Had come through this place."},{"id":"manas-2010:p1624:b001:l010","ordinal":69928,"en":"The Flood had never swept in there,"},{"id":"manas-2010:p1624:b001:l011","ordinal":69929,"en":"Alexander had never touched them;"},{"id":"manas-2010:p1624:b001:l012","ordinal":69930,"en":"The Chinese people were intact."},{"id":"manas-2010:p1624:b001:l013","ordinal":69931,"en":"“So many of my giants have died!”"},{"id":"manas-2010:p1624:b001:l014","ordinal":69932,"en":"Alöökö's Kongurbay"},{"id":"manas-2010:p1624:b001:l015","ordinal":69933,"en":"To the emperor's Beijing"},{"id":"manas-2010:p1624:b001:l016","ordinal":69934,"en":"Had sent word."},{"id":"manas-2010:p1624:b001:l017","ordinal":69935,"en":"Along with that news,"},{"id":"manas-2010:p1624:b001:l018","ordinal":69936,"en":"For the Chinese to rejoice,"},{"id":"manas-2010:p1624:b001:l019","ordinal":69937,"en":"Their day had dawned."},{"id":"manas-2010:p1624:b001:l020","ordinal":69938,"en":"A master horseman, fleet on foot,"},{"id":"manas-2010:p1624:b001:l021","ordinal":69939,"en":"Emerging when ruin threatened the Chinese,"},{"id":"manas-2010:p1624:b001:l022","ordinal":69940,"en":"Kojozhash, son of Karazhoy—"},{"id":"manas-2010:p1624:b001:l023","ordinal":69941,"en":"When that marksman arrived,"},{"id":"manas-2010:p1624:b001:l024","ordinal":69942,"en":"Muzburchak and Khan Kökchö died."},{"id":"manas-2010:p1624:b001:l025","ordinal":69943,"en":"The brim of the black felt hat,"},{"id":"manas-2010:p1624:b001:l026","ordinal":69944,"en":"Khan Manas's Syrgak,"},{"id":"manas-2010:p1624:b001:l027","ordinal":69945,"en":"Who never withdrew what he thrust forth,"},{"id":"manas-2010:p1624:b001:l028","ordinal":69946,"en":"Who never lost his stern bearing,"},{"id":"manas-2010:p1624:b001:l029","ordinal":69947,"en":"Young Syrgak died then."},{"id":"manas-2010:p1624:b001:l030","ordinal":69948,"en":"Kökötöy's Bokmurun"},{"id":"manas-2010:p1624:b001:l031","ordinal":69949,"en":"Was struck by a bullet and died;"},{"id":"manas-2010:p1624:b001:l032","ordinal":69950,"en":"Kerimsel died, lives were lost."},{"id":"manas-2010:p1624:b001:l033","ordinal":69951,"en":"At the emperor's Beijing,"},{"id":"manas-2010:p1624:b001:l034","ordinal":69952,"en":"Everyone who met it died."},{"id":"manas-2010:p1624:b001:l035","ordinal":69953,"en":"Lance-heads struck together,"},{"id":"manas-2010:p1624:b001:l036","ordinal":69954,"en":"Men's heads knocked together,"},{"id":"manas-2010:p1624:b001:l037","ordinal":69955,"en":"All the plain turned to dust,"},{"id":"manas-2010:p1624:b001:l038","ordinal":69956,"en":"The whole multitude turned to blood."},{"id":"manas-2010:p1624:b001:l039","ordinal":69957,"en":"Kojozhash raged:"},{"id":"manas-2010:p1624:b001:l040","ordinal":69958,"en":"“I shall raise a great tumult;"},{"id":"manas-2010:p1624:b001:l041","ordinal":69959,"en":"Their khan, Sultan Manas,"},{"id":"manas-2010:p1624:b001:l042","ordinal":69960,"en":"I shall seize this moment."},{"id":"manas-2010:p1625:b001:l001","ordinal":69961,"en":"To the forty wanton women in Beijing,"},{"id":"manas-2010:p1625:b001:l002","ordinal":69962,"en":"I shall take him and keep him as a stud."},{"id":"manas-2010:p1625:b001:l003","ordinal":69963,"en":"If a son is born of Manas,"},{"id":"manas-2010:p1625:b001:l004","ordinal":69964,"en":"Without shame, in Beijing,"},{"id":"manas-2010:p1625:b001:l005","ordinal":69965,"en":"I shall raise him as khan."},{"id":"manas-2010:p1625:b001:l006","ordinal":69966,"en":"The Burut who came on campaign,"},{"id":"manas-2010:p1625:b001:l007","ordinal":69967,"en":"I shall crush beneath me;"},{"id":"manas-2010:p1625:b001:l008","ordinal":69968,"en":"I shall scatter all four kinds of their livestock."},{"id":"manas-2010:p1625:b001:l009","ordinal":69969,"en":"Seizing their mares,"},{"id":"manas-2010:p1625:b001:l010","ordinal":69970,"en":"If they come near, I shall smash their brains."},{"id":"manas-2010:p1625:b001:l011","ordinal":69971,"en":"I come to exact repayment"},{"id":"manas-2010:p1625:b001:l012","ordinal":69972,"en":"For all the Burut's old offenses!”"},{"id":"manas-2010:p1625:b001:l013","ordinal":69973,"en":"The broad trench lay dug;"},{"id":"manas-2010:p1625:b001:l014","ordinal":69974,"en":"Bellowing their battle cry,"},{"id":"manas-2010:p1625:b001:l015","ordinal":69975,"en":"That Chinese army swept upon them."},{"id":"manas-2010:p1625:b001:l016","ordinal":69976,"en":"Among horses, the white-headed steed;"},{"id":"manas-2010:p1625:b001:l017","ordinal":69977,"en":"When the Chinese raised tumult,"},{"id":"manas-2010:p1625:b001:l018","ordinal":69978,"en":"With Almambet and Chubak among them,"},{"id":"manas-2010:p1625:b001:l019","ordinal":69979,"en":"Golden forelock and tasseled belt,"},{"id":"manas-2010:p1625:b001:l020","ordinal":69980,"en":"Azizkhan's Almambet,"},{"id":"manas-2010:p1625:b001:l021","ordinal":69981,"en":"Without looking around,"},{"id":"manas-2010:p1625:b001:l022","ordinal":69982,"en":"Your champion, destined to die,"},{"id":"manas-2010:p1625:b001:l023","ordinal":69983,"en":"Sparing his life not at all,"},{"id":"manas-2010:p1625:b001:l024","ordinal":69984,"en":"Shouted out, “Islam!”"},{"id":"manas-2010:p1625:b001:l025","ordinal":69985,"en":"The ninety great hosts of Kara-Kytay"},{"id":"manas-2010:p1625:b001:l026","ordinal":69986,"en":"He scattered, breaking their ranks."},{"id":"manas-2010:p1625:b001:l027","ordinal":69987,"en":"Making them reel, the dear lion,"},{"id":"manas-2010:p1625:b001:l028","ordinal":69988,"en":"Against the vast mass of unbelievers,"},{"id":"manas-2010:p1625:b001:l029","ordinal":69989,"en":"The dear hero attacked alone."},{"id":"manas-2010:p1625:b001:l030","ordinal":69990,"en":"Forty tribes of Chinese thundered,"},{"id":"manas-2010:p1625:b001:l031","ordinal":69991,"en":"With their mighty hero, the Fierce One;"},{"id":"manas-2010:p1625:b001:l032","ordinal":69992,"en":"As they were about to reach dear Alma,"},{"id":"manas-2010:p1625:b001:l033","ordinal":69993,"en":"“If my appointed death comes, I shall die;"},{"id":"manas-2010:p1625:b001:l034","ordinal":69994,"en":"To my surpassing friend Alma,"},{"id":"manas-2010:p1625:b001:l035","ordinal":69995,"en":"I shall be a support!”"},{"id":"manas-2010:p1625:b001:l036","ordinal":69996,"en":"Tall and broad-shouldered,"},{"id":"manas-2010:p1625:b001:l037","ordinal":69997,"en":"He too was black steel,"},{"id":"manas-2010:p1625:b001:l038","ordinal":69998,"en":"Khan Baltay's Chubak,"},{"id":"manas-2010:p1625:b001:l039","ordinal":69999,"en":"The champion of the Oygut,"},{"id":"manas-2010:p1625:b001:l040","ordinal":70000,"en":"Whom no man had strength to overcome in combat,"},{"id":"manas-2010:p1625:b001:l041","ordinal":70001,"en":"Whom a lion's teeth could not pierce,"},{"id":"manas-2010:p1625:b001:l042","ordinal":70002,"en":"Girding his waist for single combat,"},{"id":"manas-2010:p1626:b001:l001","ordinal":70003,"en":"If seven great hosts came,"},{"id":"manas-2010:p1626:b001:l002","ordinal":70004,"en":"He attacked with his sleeves flung free."},{"id":"manas-2010:p1626:b001:l003","ordinal":70005,"en":"“Against the grim-faced Chinese,"},{"id":"manas-2010:p1626:b001:l004","ordinal":70006,"en":"I shall go straight in and thrust my lance."},{"id":"manas-2010:p1626:b001:l005","ordinal":70007,"en":"From this hell of grievous toil,"},{"id":"manas-2010:p1626:b001:l006","ordinal":70008,"en":"I shall free my life."},{"id":"manas-2010:p1626:b001:l007","ordinal":70009,"en":"My valiant goshawk Alma—"},{"id":"manas-2010:p1626:b001:l008","ordinal":70010,"en":"Against the shouting Chinese,"},{"id":"manas-2010:p1626:b001:l009","ordinal":70011,"en":"I shall fight and bring slaughter."},{"id":"manas-2010:p1626:b001:l010","ordinal":70012,"en":"My noble fierce-maned Alma,"},{"id":"manas-2010:p1626:b001:l011","ordinal":70013,"en":"I shall rescue him!”"},{"id":"manas-2010:p1626:b001:l012","ordinal":70014,"en":"Shouting in fury,"},{"id":"manas-2010:p1626:b001:l013","ordinal":70015,"en":"Khan Baltay's Chubak"},{"id":"manas-2010:p1626:b001:l014","ordinal":70016,"en":"Raised the battle cry, “Manas!”"},{"id":"manas-2010:p1626:b001:l015","ordinal":70017,"en":"Kögala beneath him"},{"id":"manas-2010:p1626:b001:l016","ordinal":70018,"en":"He whipped on either side,"},{"id":"manas-2010:p1626:b001:l017","ordinal":70019,"en":"Spurred right and left,"},{"id":"manas-2010:p1626:b001:l018","ordinal":70020,"en":"Looked neither up nor down,"},{"id":"manas-2010:p1626:b001:l019","ordinal":70021,"en":"Never thinking, “I shall die.”"},{"id":"manas-2010:p1626:b001:l020","ordinal":70022,"en":"Shouting in fury,"},{"id":"manas-2010:p1626:b001:l021","ordinal":70023,"en":"The black Kalmyks and Manzhuu"},{"id":"manas-2010:p1626:b001:l022","ordinal":70024,"en":"He scattered wherever he entered."},{"id":"manas-2010:p1626:b001:l023","ordinal":70025,"en":"Those his lance could reach"},{"id":"manas-2010:p1626:b001:l024","ordinal":70026,"en":"He overturned with his lance;"},{"id":"manas-2010:p1626:b001:l025","ordinal":70027,"en":"Those his sword could reach"},{"id":"manas-2010:p1626:b001:l026","ordinal":70028,"en":"He hacked apart with his sword."},{"id":"manas-2010:p1626:b001:l027","ordinal":70029,"en":"When your mighty Chubak entered,"},{"id":"manas-2010:p1626:b001:l028","ordinal":70030,"en":"All the Manzhuu and the Fierce One"},{"id":"manas-2010:p1626:b001:l029","ordinal":70031,"en":"Drew bows and rained arrows,"},{"id":"manas-2010:p1626:b001:l030","ordinal":70032,"en":"Fired shots like hail."},{"id":"manas-2010:p1626:b001:l031","ordinal":70033,"en":"See the rain, see the embers,"},{"id":"manas-2010:p1626:b001:l032","ordinal":70034,"en":"See the shots striking together,"},{"id":"manas-2010:p1626:b001:l033","ordinal":70035,"en":"See the trench they have dug,"},{"id":"manas-2010:p1626:b001:l034","ordinal":70036,"en":"See the misery stirred up,"},{"id":"manas-2010:p1626:b001:l035","ordinal":70037,"en":"With their mighty Fierce One leading,"},{"id":"manas-2010:p1626:b001:l036","ordinal":70038,"en":"See the Chinese army sweeping in!"},{"id":"manas-2010:p1626:b001:l037","ordinal":70039,"en":"From this side of it,"},{"id":"manas-2010:p1626:b001:l038","ordinal":70040,"en":"The one who never ceased grappling,"},{"id":"manas-2010:p1626:b001:l039","ordinal":70041,"en":"On the meat of a whole pig"},{"id":"manas-2010:p1626:b001:l040","ordinal":70042,"en":"Who could not sate himself at one meal,"},{"id":"manas-2010:p1626:b001:l041","ordinal":70043,"en":"Kambyl the giant of the black host,"},{"id":"manas-2010:p1626:b001:l042","ordinal":70044,"en":"Came charging up."},{"id":"manas-2010:p1627:b001:l001","ordinal":70045,"en":"Sparing not their own lives,"},{"id":"manas-2010:p1627:b001:l002","ordinal":70046,"en":"The Chinese swarmed and fought."},{"id":"manas-2010:p1627:b001:l003","ordinal":70047,"en":"The untroubled heroes"},{"id":"manas-2010:p1627:b001:l004","ordinal":70048,"en":"Faced them without fleeing,"},{"id":"manas-2010:p1627:b001:l005","ordinal":70049,"en":"Never slept upon their elbows,"},{"id":"manas-2010:p1627:b001:l006","ordinal":70050,"en":"Never took a moment's rest,"},{"id":"manas-2010:p1627:b001:l007","ordinal":70051,"en":"Never rested through the day."},{"id":"manas-2010:p1627:b001:l008","ordinal":70052,"en":"In a slaughter such as this,"},{"id":"manas-2010:p1627:b001:l009","ordinal":70053,"en":"Even in death there was no regret."},{"id":"manas-2010:p1627:b001:l010","ordinal":70054,"en":"The place they fought was It-Ölbös,"},{"id":"manas-2010:p1627:b001:l011","ordinal":70055,"en":"A desert forty days across,"},{"id":"manas-2010:p1627:b001:l012","ordinal":70056,"en":"A desert where a flying swan's"},{"id":"manas-2010:p1627:b001:l013","ordinal":70057,"en":"Wings would burn away."},{"id":"manas-2010:p1627:b001:l014","ordinal":70058,"en":"Not a mountain the size of a knucklebone,"},{"id":"manas-2010:p1627:b001:l015","ordinal":70059,"en":"Not a hollow the size of a saddlecloth,"},{"id":"manas-2010:p1627:b001:l016","ordinal":70060,"en":"Not a furrow touched by a plow,"},{"id":"manas-2010:p1627:b001:l017","ordinal":70061,"en":"Not a burrow dug by a marmot,"},{"id":"manas-2010:p1627:b001:l018","ordinal":70062,"en":"Not a drop of water anywhere,"},{"id":"manas-2010:p1627:b001:l019","ordinal":70063,"en":"Not a pinch of grass to eat;"},{"id":"manas-2010:p1627:b001:l020","ordinal":70064,"en":"It was a forty-day road."},{"id":"manas-2010:p1627:b001:l021","ordinal":70065,"en":"With the forty tribes of Chinese,"},{"id":"manas-2010:p1627:b001:l022","ordinal":70066,"en":"All the valiant heroes"},{"id":"manas-2010:p1627:b001:l023","ordinal":70067,"en":"Were fated to meet."},{"id":"manas-2010:p1627:b001:l024","ordinal":70068,"en":"In the middle of that desert,"},{"id":"manas-2010:p1627:b001:l025","ordinal":70069,"en":"Leaning upon the dun-bay horse,"},{"id":"manas-2010:p1627:b001:l026","ordinal":70070,"en":"The lions suffered hardship,"},{"id":"manas-2010:p1627:b001:l027","ordinal":70071,"en":"Drenched in pitch-dark blood."},{"id":"manas-2010:p1627:b001:l028","ordinal":70072,"en":"Their heads were buckets of blood,"},{"id":"manas-2010:p1627:b001:l029","ordinal":70073,"en":"Their two arms paralyzed,"},{"id":"manas-2010:p1627:b001:l030","ordinal":70074,"en":"They grappled and slaughtered one another."},{"id":"manas-2010:p1627:b001:l031","ordinal":70075,"en":"See the spectacle of the world:"},{"id":"manas-2010:p1627:b001:l032","ordinal":70076,"en":"They grappled and slaughtered one another."},{"id":"manas-2010:p1627:b001:l033","ordinal":70077,"en":"Auspicious when sent ahead,"},{"id":"manas-2010:p1627:b001:l034","ordinal":70078,"en":"Almambet and Chubak,"},{"id":"manas-2010:p1627:b001:l035","ordinal":70079,"en":"Like vast armies as they drove the foe,"},{"id":"manas-2010:p1627:b001:l036","ordinal":70080,"en":"When these men were seen,"},{"id":"manas-2010:p1627:b001:l037","ordinal":70081,"en":"With Khan Kongurbay at their head,"},{"id":"manas-2010:p1627:b001:l038","ordinal":70082,"en":"A countless multitude of Dagger-Hands,"},{"id":"manas-2010:p1627:b001:l039","ordinal":70083,"en":"The Chinese swept upon them."},{"id":"manas-2010:p1627:b001:l040","ordinal":70084,"en":"All forty tribes,"},{"id":"manas-2010:p1627:b001:l041","ordinal":70085,"en":"Making a spectacle of the champion,"},{"id":"manas-2010:p1627:b001:l042","ordinal":70086,"en":"Enclosed him in their midst."},{"id":"manas-2010:p1628:b001:l001","ordinal":70087,"en":"Of the jacket-wearing Chinese,"},{"id":"manas-2010:p1628:b001:l002","ordinal":70088,"en":"The strongest took countless lances,"},{"id":"manas-2010:p1628:b001:l003","ordinal":70089,"en":"And swept upon them in force;"},{"id":"manas-2010:p1628:b001:l004","ordinal":70090,"en":"The sun was hidden."},{"id":"manas-2010:p1628:b001:l005","ordinal":70091,"en":"Of the Chinese with rank-buttons,"},{"id":"manas-2010:p1628:b001:l006","ordinal":70092,"en":"The finest separated out."},{"id":"manas-2010:p1628:b001:l007","ordinal":70093,"en":"To the watching Muslims,"},{"id":"manas-2010:p1628:b001:l008","ordinal":70094,"en":"These Chinese seemed about to leave"},{"id":"manas-2010:p1628:b001:l009","ordinal":70095,"en":"Not one alive."},{"id":"manas-2010:p1628:b001:l010","ordinal":70096,"en":"As the people grew exhausted,"},{"id":"manas-2010:p1628:b001:l011","ordinal":70097,"en":"Your marvelous lion Alma,"},{"id":"manas-2010:p1628:b001:l012","ordinal":70098,"en":"Sarala with cowlike lean haunches,"},{"id":"manas-2010:p1628:b001:l013","ordinal":70099,"en":"The dear lion held in check."},{"id":"manas-2010:p1628:b001:l014","ordinal":70100,"en":"Cloudy by day, clear at night,"},{"id":"manas-2010:p1628:b001:l015","ordinal":70101,"en":"The dear hero worked weather spells."},{"id":"manas-2010:p1628:b001:l016","ordinal":70102,"en":"Hail fell over all the foothills,"},{"id":"manas-2010:p1628:b001:l017","ordinal":70103,"en":"Rain fell over all the lowlands,"},{"id":"manas-2010:p1628:b001:l018","ordinal":70104,"en":"Clouds were driven from the sky,"},{"id":"manas-2010:p1628:b001:l019","ordinal":70105,"en":"Clouds spread over the earth."},{"id":"manas-2010:p1628:b001:l020","ordinal":70106,"en":"Turning summer's day to winter,"},{"id":"manas-2010:p1628:b001:l021","ordinal":70107,"en":"The thinly clad Chinese"},{"id":"manas-2010:p1628:b001:l022","ordinal":70108,"en":"He made whimper like girls."},{"id":"manas-2010:p1628:b001:l023","ordinal":70109,"en":"Was Sarala not a noble steed?"},{"id":"manas-2010:p1628:b001:l024","ordinal":70110,"en":"Gripping the reins in his fists,"},{"id":"manas-2010:p1628:b001:l025","ordinal":70111,"en":"Almambet kept drawing them in."},{"id":"manas-2010:p1628:b001:l026","ordinal":70112,"en":"That great multitude of Kalmyks,"},{"id":"manas-2010:p1628:b001:l027","ordinal":70113,"en":"Throwing them right and left,"},{"id":"manas-2010:p1628:b001:l028","ordinal":70114,"en":"Almambet slew."},{"id":"manas-2010:p1628:b001:l029","ordinal":70115,"en":"His comrade Chubak at his side,"},{"id":"manas-2010:p1628:b001:l030","ordinal":70116,"en":"Argynkhan's Azhybay,"},{"id":"manas-2010:p1628:b001:l031","ordinal":70117,"en":"A companion close to his very soul,"},{"id":"manas-2010:p1628:b001:l032","ordinal":70118,"en":"Had joined with him,"},{"id":"manas-2010:p1628:b001:l033","ordinal":70119,"en":"And Khan Manas's heroes called the forty companions."},{"id":"manas-2010:p1628:b001:l034","ordinal":70120,"en":"Through their center, Almambet"},{"id":"manas-2010:p1628:b001:l035","ordinal":70121,"en":"Came gouging a path."},{"id":"manas-2010:p1628:b001:l036","ordinal":70122,"en":"Around their edges, the forty wolves"},{"id":"manas-2010:p1628:b001:l037","ordinal":70123,"en":"Came slaughtering."},{"id":"manas-2010:p1628:b001:l038","ordinal":70124,"en":"Their broad flank, Khan Chubak"},{"id":"manas-2010:p1628:b001:l039","ordinal":70125,"en":"Came hemming in."},{"id":"manas-2010:p1628:b001:l040","ordinal":70126,"en":"Their very center, the Muslims"},{"id":"manas-2010:p1628:b001:l041","ordinal":70127,"en":"Came tearing apart."},{"id":"manas-2010:p1628:b001:l042","ordinal":70128,"en":"In that ravaging battle,"},{"id":"manas-2010:p1629:b001:l001","ordinal":70129,"en":"His staring eyes like the morning star,"},{"id":"manas-2010:p1629:b001:l002","ordinal":70130,"en":"His great ears like shields,"},{"id":"manas-2010:p1629:b001:l003","ordinal":70131,"en":"Whose blessing enriched the people,"},{"id":"manas-2010:p1629:b001:l004","ordinal":70132,"en":"There was old King Koshoy;"},{"id":"manas-2010:p1629:b001:l005","ordinal":70133,"en":"Zhamgyrchy of the Eshtek,"},{"id":"manas-2010:p1629:b001:l006","ordinal":70134,"en":"Eleman's brave Töshtük—"},{"id":"manas-2010:p1629:b001:l007","ordinal":70135,"en":"Indeed, all the Muslims were there."},{"id":"manas-2010:p1629:b001:l008","ordinal":70136,"en":"In the battle they had charged into,"},{"id":"manas-2010:p1629:b001:l009","ordinal":70137,"en":"Their tusks jutting,"},{"id":"manas-2010:p1629:b001:l010","ordinal":70138,"en":"There were many dead horses;"},{"id":"manas-2010:p1629:b001:l011","ordinal":70139,"en":"Their moustaches sticking out,"},{"id":"manas-2010:p1629:b001:l012","ordinal":70140,"en":"There were many dead heroes."},{"id":"manas-2010:p1629:b001:l013","ordinal":70141,"en":"Their lances broken at the middle,"},{"id":"manas-2010:p1629:b001:l014","ordinal":70142,"en":"Utterly at their wits' end,"},{"id":"manas-2010:p1629:b001:l015","ordinal":70143,"en":"Many more hurried about."},{"id":"manas-2010:p1629:b001:l016","ordinal":70144,"en":"Their cruppers broken,"}]
