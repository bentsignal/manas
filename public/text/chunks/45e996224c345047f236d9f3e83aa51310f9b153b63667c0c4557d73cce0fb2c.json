[{"id":"semetey-1-2013:p1210:b003:l016","ordinal":168449,"en":"Your padishah's Akkula"},{"id":"semetey-1-2013:p1210:b003:l017","ordinal":168450,"en":"Ran with an impossible stride."},{"id":"semetey-1-2013:p1210:b003:l018","ordinal":168451,"en":"When he came to a descent,"},{"id":"semetey-1-2013:p1210:b003:l019","ordinal":168452,"en":"His forelegs thrust like a roe deer's;"},{"id":"semetey-1-2013:p1210:b003:l020","ordinal":168453,"en":"When he leaned into an ascent,"},{"id":"semetey-1-2013:p1210:b003:l021","ordinal":168454,"en":"Mighty racehorse Akkula's"},{"id":"semetey-1-2013:p1210:b003:l022","ordinal":168455,"en":"Mane and tail streamed out."},{"id":"semetey-1-2013:p1210:b003:l023","ordinal":168456,"en":"When he reached open steppe,"},{"id":"semetey-1-2013:p1210:b003:l024","ordinal":168457,"en":"His hooves thundered on the ground."},{"id":"semetey-1-2013:p1210:b003:l025","ordinal":168458,"en":"When he champed"},{"id":"semetey-1-2013:p1210:b003:l026","ordinal":168459,"en":"The black-steel bit,"},{"id":"semetey-1-2013:p1210:b003:l027","ordinal":168460,"en":"It clattered in his throat."},{"id":"semetey-1-2013:p1210:b003:l028","ordinal":168461,"en":"His forelock parted toward the sky,"},{"id":"semetey-1-2013:p1210:b003:l029","ordinal":168462,"en":"And his tulpar form appeared."},{"id":"semetey-1-2013:p1210:b003:l030","ordinal":168463,"en":"He flattened his ears like a kulan"},{"id":"semetey-1-2013:p1210:b003:l031","ordinal":168464,"en":"And swept the earth like a whirlwind."},{"id":"semetey-1-2013:p1210:b003:l032","ordinal":168465,"en":"When he came into view,"},{"id":"semetey-1-2013:p1210:b003:l033","ordinal":168466,"en":"Valiant noble Almam"},{"id":"semetey-1-2013:p1210:b003:l034","ordinal":168467,"en":"Watched and marked him carefully."},{"id":"semetey-1-2013:p1210:b003:l035","ordinal":168468,"en":"Stones burst beneath his tread;"},{"id":"semetey-1-2013:p1210:b003:l036","ordinal":168469,"en":"Hero Joloy's Achbuudan"},{"id":"semetey-1-2013:p1210:b003:l037","ordinal":168470,"en":"Came flying with a roar."},{"id":"semetey-1-2013:p1210:b003:l038","ordinal":168471,"en":"He was behind Akkula."},{"id":"semetey-1-2013:p1210:b003:l039","ordinal":168472,"en":"When young Aydar of the flowing forelock"},{"id":"semetey-1-2013:p1210:b004:l001","ordinal":168473,"en":"Drove away the horses,"},{"id":"semetey-1-2013:p1210:b004:l002","ordinal":168474,"en":"Kokotoy's Bokmurun"},{"id":"semetey-1-2013:p1210:b004:l003","ordinal":168475,"en":"Had used much cunning."},{"id":"semetey-1-2013:p1210:b004:l004","ordinal":168476,"en":"Heeding his words, young Aydar"},{"id":"semetey-1-2013:p1210:b004:l005","ordinal":168477,"en":"Tied Maaniker firmly"},{"id":"semetey-1-2013:p1210:b004:l006","ordinal":168478,"en":"And slept for three days."},{"id":"semetey-1-2013:p1210:b004:l007","ordinal":168479,"en":"After three days, young Aydar"},{"id":"semetey-1-2013:p1210:b004:l008","ordinal":168480,"en":"Woke in alarm from sleep,"},{"id":"semetey-1-2013:p1210:b004:l009","ordinal":168481,"en":"Turned onto his right side,"},{"id":"semetey-1-2013:p1210:b004:l010","ordinal":168482,"en":"Dipped his hands in water"},{"id":"semetey-1-2013:p1210:b004:l011","ordinal":168483,"en":"And performed ablution for his hands;"},{"id":"semetey-1-2013:p1210:b004:l012","ordinal":168484,"en":"He dipped his feet in water"},{"id":"semetey-1-2013:p1210:b004:l013","ordinal":168485,"en":"And performed ablution for his feet."},{"id":"semetey-1-2013:p1210:b004:l014","ordinal":168486,"en":"He hurriedly recited namaz,"},{"id":"semetey-1-2013:p1210:b004:l015","ordinal":168487,"en":"Saddled Maaniker,"},{"id":"semetey-1-2013:p1210:b004:l016","ordinal":168488,"en":"Opened his eyes wide as grain mash,"},{"id":"semetey-1-2013:p1210:b004:l017","ordinal":168489,"en":"And all sleep scattered away."},{"id":"semetey-1-2013:p1210:b004:l018","ordinal":168490,"en":"When he stood high and looked,"},{"id":"semetey-1-2013:p1210:b004:l019","ordinal":168491,"en":"There was no raven croaking,"},{"id":"semetey-1-2013:p1210:b004:l020","ordinal":168492,"en":"No crow cawing."},{"id":"semetey-1-2013:p1210:b004:l021","ordinal":168493,"en":"Nothing caught his eye;"},{"id":"semetey-1-2013:p1210:b004:l022","ordinal":168494,"en":"He could not tell where"},{"id":"semetey-1-2013:p1210:b004:l023","ordinal":168495,"en":"The people beside him had gone."},{"id":"semetey-1-2013:p1210:b004:l024","ordinal":168496,"en":"Then young Aydar"},{"id":"semetey-1-2013:p1210:b004:l025","ordinal":168497,"en":"Struck the whip hard"},{"id":"semetey-1-2013:p1210:b004:l026","ordinal":168498,"en":"Against a tulpar like Maaniker,"},{"id":"semetey-1-2013:p1210:b004:l027","ordinal":168499,"en":"Upon the black thigh never struck by a whip."},{"id":"semetey-1-2013:p1210:b004:l028","ordinal":168500,"en":"Its sheep-like flesh divided,"},{"id":"semetey-1-2013:p1210:b004:l029","ordinal":168501,"en":"And its back straightened like a hare's;"},{"id":"semetey-1-2013:p1210:b004:l030","ordinal":168502,"en":"Its foal-like flesh stood out,"},{"id":"semetey-1-2013:p1210:b004:l031","ordinal":168503,"en":"And its coat smoothed like a sighthound's."},{"id":"semetey-1-2013:p1210:b004:l032","ordinal":168504,"en":"Its cavernous mouth opened;"},{"id":"semetey-1-2013:p1210:b004:l033","ordinal":168505,"en":"Its contracted hooves"},{"id":"semetey-1-2013:p1210:b004:l034","ordinal":168506,"en":"Spread as broad as great platters."},{"id":"semetey-1-2013:p1210:b004:l035","ordinal":168507,"en":"White foam mixed with blood"},{"id":"semetey-1-2013:p1210:b004:l036","ordinal":168508,"en":"Splashed upon its chest."},{"id":"semetey-1-2013:p1210:b004:l037","ordinal":168509,"en":"Beneath the clouded sky,"},{"id":"semetey-1-2013:p1210:b004:l038","ordinal":168510,"en":"Over the rippling grass,"},{"id":"semetey-1-2013:p1210:b004:l039","ordinal":168511,"en":"It now flew away with a roar."},{"id":"semetey-1-2013:p1211:b003:l001","ordinal":168512,"en":"The earth split in shimmering waves;"},{"id":"semetey-1-2013:p1211:b003:l002","ordinal":168513,"en":"Khan Joloy's Achbuudan"},{"id":"semetey-1-2013:p1211:b003:l003","ordinal":168514,"en":"Came in hard at Akkula's heels."},{"id":"semetey-1-2013:p1211:b003:l004","ordinal":168515,"en":"The forelock of Maaniker—"},{"id":"semetey-1-2013:p1211:b003:l005","ordinal":168516,"en":"It was steeped in ill fortune;"},{"id":"semetey-1-2013:p1211:b003:l006","ordinal":168517,"en":"For the tulpar driven in a race,"},{"id":"semetey-1-2013:p1211:b003:l007","ordinal":168518,"en":"There was no prize ahead."},{"id":"semetey-1-2013:p1211:b003:l008","ordinal":168519,"en":"For not racing Maaniker,"},{"id":"semetey-1-2013:p1211:b003:l009","ordinal":168520,"en":"Bokmurun of Kökötöy"},{"id":"semetey-1-2013:p1211:b003:l010","ordinal":168521,"en":"Had no sense at all."},{"id":"semetey-1-2013:p1211:b003:l011","ordinal":168522,"en":"See the ants, see the worms;"},{"id":"semetey-1-2013:p1211:b003:l012","ordinal":168523,"en":"The people like swarming Chinese worms"},{"id":"semetey-1-2013:p1211:b003:l013","ordinal":168524,"en":"Had gone to urge on the horses."},{"id":"semetey-1-2013:p1211:b003:l014","ordinal":168525,"en":"When one looked, nothing met the eye;"},{"id":"semetey-1-2013:p1211:b003:l015","ordinal":168526,"en":"Soil flew and dust burned,"},{"id":"semetey-1-2013:p1211:b003:l016","ordinal":168527,"en":"The sky clear but the earth overcast,"},{"id":"semetey-1-2013:p1211:b003:l017","ordinal":168528,"en":"And no one could tell which was which."},{"id":"semetey-1-2013:p1211:b003:l018","ordinal":168529,"en":"They were exceptional chargers—"},{"id":"semetey-1-2013:p1211:b003:l019","ordinal":168530,"en":"Akkula and Achbuudan,"},{"id":"semetey-1-2013:p1211:b003:l020","ordinal":168531,"en":"As alike as rabbits."},{"id":"semetey-1-2013:p1211:b003:l021","ordinal":168532,"en":"Among the Black Chinese and Manchus,"},{"id":"semetey-1-2013:p1211:b003:l022","ordinal":168533,"en":"Just as Akkula was about to be caught,"},{"id":"semetey-1-2013:p1211:b003:l023","ordinal":168534,"en":"When Khan Kongurbai was coming,"},{"id":"semetey-1-2013:p1211:b003:l024","ordinal":168535,"en":"When he was about to see Akkula,"},{"id":"semetey-1-2013:p1211:b003:l025","ordinal":168536,"en":"When turmoil was about to break,"},{"id":"semetey-1-2013:p1211:b003:l026","ordinal":168537,"en":"When Achbuudan was about to kick and fling him,"},{"id":"semetey-1-2013:p1211:b003:l027","ordinal":168538,"en":"Dear lion Almam, the falcon,"},{"id":"semetey-1-2013:p1211:b003:l028","ordinal":168539,"en":"With pearl otogot and coral stones"},{"id":"semetey-1-2013:p1211:b003:l029","ordinal":168540,"en":"Glittering on his head,"},{"id":"semetey-1-2013:p1211:b003:l030","ordinal":168541,"en":"Gathering himself like a blue tiger,"},{"id":"semetey-1-2013:p1211:b003:l031","ordinal":168542,"en":"Donned Chinese clothing."},{"id":"semetey-1-2013:p1211:b003:l032","ordinal":168543,"en":"Elder Ala turned toward the people;"},{"id":"semetey-1-2013:p1211:b003:l033","ordinal":168544,"en":"His ancestor Chylaba"},{"id":"semetey-1-2013:p1211:b003:l034","ordinal":168545,"en":"Had left a great emblem there:"},{"id":"semetey-1-2013:p1211:b003:l035","ordinal":168546,"en":"The tail of a parrot,"},{"id":"semetey-1-2013:p1211:b003:l036","ordinal":168547,"en":"Worked in nine colors."},{"id":"semetey-1-2013:p1211:b003:l037","ordinal":168548,"en":"Seething like the Chinese,"},{"id":"semetey-1-2013:p1211:b003:l038","ordinal":168549,"en":"Roaring in wrath,"},{"id":"semetey-1-2013:p1211:b003:l039","ordinal":168550,"en":"He raised the khagan's battle cry."},{"id":"semetey-1-2013:p1211:b005:l001","ordinal":168551,"en":"Khan Manas's Akkula—"},{"id":"semetey-1-2013:p1211:b005:l002","ordinal":168552,"en":"He urged it on with the khagan's cry."},{"id":"semetey-1-2013:p1211:b005:l003","ordinal":168553,"en":"Pearl otogot and coral stones,"},{"id":"semetey-1-2013:p1211:b005:l004","ordinal":168554,"en":"Together with the khan of the Zungars,"},{"id":"semetey-1-2013:p1211:b005:l005","ordinal":168555,"en":"All the great Chinese host,"},{"id":"semetey-1-2013:p1211:b005:l006","ordinal":168556,"en":"When they saw elder Ala,"},{"id":"semetey-1-2013:p1211:b005:l007","ordinal":168557,"en":"Thinking him one of their famous khans,"},{"id":"semetey-1-2013:p1211:b005:l008","ordinal":168558,"en":"Urged without restraint."},{"id":"semetey-1-2013:p1211:b005:l009","ordinal":168559,"en":"They raised a great shout."},{"id":"semetey-1-2013:p1211:b005:l010","ordinal":168560,"en":"The Chinese people shouted together"},{"id":"semetey-1-2013:p1211:b005:l011","ordinal":168561,"en":"And entered the tumult."},{"id":"semetey-1-2013:p1211:b005:l012","ordinal":168562,"en":"Fiercely urging the kula horse,"},{"id":"semetey-1-2013:p1211:b005:l013","ordinal":168563,"en":"They entered the clamor."},{"id":"semetey-1-2013:p1211:b005:l014","ordinal":168564,"en":"Deceived by Almambet,"},{"id":"semetey-1-2013:p1211:b005:l015","ordinal":168565,"en":"They entered the uproar."},{"id":"semetey-1-2013:p1211:b005:l016","ordinal":168566,"en":"Into a haze no man could see through,"},{"id":"semetey-1-2013:p1211:b005:l017","ordinal":168567,"en":"They plunged amid the dust."},{"id":"semetey-1-2013:p1211:b005:l018","ordinal":168568,"en":"Alman broke away from the Chinese"},{"id":"semetey-1-2013:p1211:b005:l019","ordinal":168569,"en":"And appeared among the Kalmaks."},{"id":"semetey-1-2013:p1211:b005:l020","ordinal":168570,"en":"When he reached the Kalmaks,"},{"id":"semetey-1-2013:p1211:b005:l021","ordinal":168571,"en":"He raised the Kalmak urging cry."},{"id":"semetey-1-2013:p1211:b005:l022","ordinal":168572,"en":"Champion lion Almam"},{"id":"semetey-1-2013:p1211:b005:l023","ordinal":168573,"en":"Sent his horse down the slope"},{"id":"semetey-1-2013:p1211:b005:l024","ordinal":168574,"en":"And took up the cry of “Möndü!”"},{"id":"semetey-1-2013:p1211:b005:l025","ordinal":168575,"en":"The Sarala beneath him—"},{"id":"semetey-1-2013:p1211:b005:l026","ordinal":168576,"en":"He whipped it right and left,"},{"id":"semetey-1-2013:p1211:b005:l027","ordinal":168577,"en":"And spurred from both sides."},{"id":"semetey-1-2013:p1211:b005:l028","ordinal":168578,"en":"He was a khan of the Black Kalmaks,"},{"id":"semetey-1-2013:p1211:b005:l029","ordinal":168579,"en":"One who donned the khan's attire;"},{"id":"semetey-1-2013:p1211:b005:l030","ordinal":168580,"en":"Wearing a Kaldai coat,"},{"id":"semetey-1-2013:p1211:b005:l031","ordinal":168581,"en":"“Möndü, möndü, möndü!” he cried,"},{"id":"semetey-1-2013:p1211:b005:l032","ordinal":168582,"en":"Urging them with the Möndü cry."},{"id":"semetey-1-2013:p1211:b005:l033","ordinal":168583,"en":"“Jaghy, jaghy, jaghy!” he cried,"},{"id":"semetey-1-2013:p1211:b005:l034","ordinal":168584,"en":"Urging them with the Jaghy cry."},{"id":"semetey-1-2013:p1211:b005:l035","ordinal":168585,"en":"The many glittering Kalmaks"},{"id":"semetey-1-2013:p1211:b005:l036","ordinal":168586,"en":"Now urged on together."},{"id":"semetey-1-2013:p1211:b005:l037","ordinal":168587,"en":"The Kalmaks came thundering,"},{"id":"semetey-1-2013:p1211:b005:l038","ordinal":168588,"en":"Their hair streaming behind them."},{"id":"semetey-1-2013:p1211:b005:l039","ordinal":168589,"en":"While lion Almam lived,"},{"id":"semetey-1-2013:p1212:b003:l001","ordinal":168590,"en":"He deceived the Kalmaks while urging the horse."},{"id":"semetey-1-2013:p1212:b003:l002","ordinal":168591,"en":"While champion Almam lived,"},{"id":"semetey-1-2013:p1212:b003:l003","ordinal":168592,"en":"He deceived the Chinese while urging the horse."},{"id":"semetey-1-2013:p1212:b003:l004","ordinal":168593,"en":"The seething multitude"},{"id":"semetey-1-2013:p1212:b003:l005","ordinal":168594,"en":"Entered among the Solon."},{"id":"semetey-1-2013:p1212:b003:l006","ordinal":168595,"en":"He raised the Solon battle cry"},{"id":"semetey-1-2013:p1212:b003:l007","ordinal":168596,"en":"And urged past the Solon;"},{"id":"semetey-1-2013:p1212:b003:l008","ordinal":168597,"en":"He raised the Shivei battle cry"},{"id":"semetey-1-2013:p1212:b003:l009","ordinal":168598,"en":"And now urged past the Shivei."},{"id":"semetey-1-2013:p1212:b003:l010","ordinal":168599,"en":"While champion Almam lived,"},{"id":"semetey-1-2013:p1212:b003:l011","ordinal":168600,"en":"He truly carried out a difficult stratagem."},{"id":"semetey-1-2013:p1212:b003:l012","ordinal":168601,"en":"Failing to recognize Akkula,"},{"id":"semetey-1-2013:p1212:b003:l013","ordinal":168602,"en":"He threw the Chinese into confusion."},{"id":"semetey-1-2013:p1212:b003:l014","ordinal":168603,"en":"The heroism"},{"id":"semetey-1-2013:p1212:b003:l015","ordinal":168604,"en":"Of valiant gray wolf Almam became known."},{"id":"semetey-1-2013:p1212:b003:l016","ordinal":168605,"en":"As he went farther on,"},{"id":"semetey-1-2013:p1212:b003:l017","ordinal":168606,"en":"He reached the people of Islam."},{"id":"semetey-1-2013:p1212:b003:l018","ordinal":168607,"en":"Khan Manas's forty companions"},{"id":"semetey-1-2013:p1212:b003:l019","ordinal":168608,"en":"Now remained shouting encouragement in ruin."},{"id":"semetey-1-2013:p1212:b003:l020","ordinal":168609,"en":"This creature Akkula"},{"id":"semetey-1-2013:p1212:b003:l021","ordinal":168610,"en":"Had lowered his head to the ground."},{"id":"semetey-1-2013:p1212:b003:l022","ordinal":168611,"en":"The forty companions who urged him on"},{"id":"semetey-1-2013:p1212:b003:l023","ordinal":168612,"en":"Failed to see"},{"id":"semetey-1-2013:p1212:b003:l024","ordinal":168613,"en":"That Akkula had broken away."},{"id":"semetey-1-2013:p1212:b003:l025","ordinal":168614,"en":"They did not notice Akkula leaving."},{"id":"semetey-1-2013:p1212:b003:l026","ordinal":168615,"en":"Let us leave that there"},{"id":"semetey-1-2013:p1212:b003:l027","ordinal":168616,"en":"And begin the tale"},{"id":"semetey-1-2013:p1212:b003:l028","ordinal":168617,"en":"Of the open-hearted noble lion."},{"id":"semetey-1-2013:p1212:b003:l029","ordinal":168618,"en":"Upon Aybanboz, streaming along,"},{"id":"semetey-1-2013:p1212:b003:l030","ordinal":168619,"en":"Noble lion Manas"},{"id":"semetey-1-2013:p1212:b003:l031","ordinal":168620,"en":"Had entered the clamor."},{"id":"semetey-1-2013:p1212:b003:l032","ordinal":168621,"en":"Making his gray horse leap,"},{"id":"semetey-1-2013:p1212:b003:l033","ordinal":168622,"en":"Hero lion Manas,"},{"id":"semetey-1-2013:p1212:b003:l034","ordinal":168623,"en":"Within that tumult,"},{"id":"semetey-1-2013:p1212:b003:l035","ordinal":168624,"en":"Caught sight of Achbuudan."},{"id":"semetey-1-2013:p1212:b003:l036","ordinal":168625,"en":"The lion raged;"},{"id":"semetey-1-2013:p1212:b003:l037","ordinal":168626,"en":"His eyes blazed like fire,"},{"id":"semetey-1-2013:p1212:b003:l038","ordinal":168627,"en":"His anguish smoked fiercely,"},{"id":"semetey-1-2013:p1212:b003:l039","ordinal":168628,"en":"And bloodlust seized him."},{"id":"semetey-1-2013:p1212:b004:l001","ordinal":168629,"en":"Hero Joloy's Achbuudan"},{"id":"semetey-1-2013:p1212:b004:l002","ordinal":168630,"en":"Ran out in front;"},{"id":"semetey-1-2013:p1212:b004:l003","ordinal":168631,"en":"How could it be left behind?"},{"id":"semetey-1-2013:p1212:b004:l004","ordinal":168632,"en":"Kökötöy's countless prizes—"},{"id":"semetey-1-2013:p1212:b004:l005","ordinal":168633,"en":"How could the Black Kalmaks and Manchus"},{"id":"semetey-1-2013:p1212:b004:l006","ordinal":168634,"en":"Be allowed to take them?"},{"id":"semetey-1-2013:p1212:b004:l007","ordinal":168635,"en":"Rather than give the prize to China,"},{"id":"semetey-1-2013:p1212:b004:l008","ordinal":168636,"en":"Let us die and cease living;"},{"id":"semetey-1-2013:p1212:b004:l009","ordinal":168637,"en":"Let us sink away as though unborn."},{"id":"semetey-1-2013:p1212:b004:l010","ordinal":168638,"en":"Akkula, raced with honor,"},{"id":"semetey-1-2013:p1212:b004:l011","ordinal":168639,"en":"That gliding creature fit for slaughter,"},{"id":"semetey-1-2013:p1212:b004:l012","ordinal":168640,"en":"Was a beast unlike other horses;"},{"id":"semetey-1-2013:p1212:b004:l013","ordinal":168641,"en":"Kökötöy's red banner—"},{"id":"semetey-1-2013:p1212:b004:l014","ordinal":168642,"en":"This year was the time for him to win it."},{"id":"semetey-1-2013:p1212:b004:l015","ordinal":168643,"en":"Were his fetlocks only a handspan,"},{"id":"semetey-1-2013:p1212:b004:l016","ordinal":168644,"en":"Had he become a frog?"},{"id":"semetey-1-2013:p1212:b004:l017","ordinal":168645,"en":"Were his heels only a handspan,"},{"id":"semetey-1-2013:p1212:b004:l018","ordinal":168646,"en":"Had he become a pig?"},{"id":"semetey-1-2013:p1212:b004:l019","ordinal":168647,"en":"Yesterday, when we fled from Altai,"},{"id":"semetey-1-2013:p1212:b004:l020","ordinal":168648,"en":"When I scattered my countless wealth,"},{"id":"semetey-1-2013:p1212:b004:l021","ordinal":168649,"en":"Against the Black Kalmak people,"},{"id":"semetey-1-2013:p1212:b004:l022","ordinal":168650,"en":"Lying on opposite banks,"},{"id":"semetey-1-2013:p1212:b004:l023","ordinal":168651,"en":"Exchanging musket fire,"},{"id":"semetey-1-2013:p1212:b004:l024","ordinal":168652,"en":"Waging fierce battle,"},{"id":"semetey-1-2013:p1212:b004:l025","ordinal":168653,"en":"When Toruchaar fell to a bullet,"},{"id":"semetey-1-2013:p1212:b004:l026","ordinal":168654,"en":"When the great Chinese and Manchu host"},{"id":"semetey-1-2013:p1212:b004:l027","ordinal":168655,"en":"Surged upon us and brought turmoil,"},{"id":"semetey-1-2013:p1212:b004:l028","ordinal":168656,"en":"When Toruchaar was shot down"},{"id":"semetey-1-2013:p1212:b004:l029","ordinal":168657,"en":"And I was left looming on foot,"},{"id":"semetey-1-2013:p1212:b004:l030","ordinal":168658,"en":"Khan Koshoy of Katagan"},{"id":"semetey-1-2013:p1212:b004:l031","ordinal":168659,"en":"Gave Telkyzyl as a gift."},{"id":"semetey-1-2013:p1212:b004:l032","ordinal":168660,"en":"When I mounted Telkyzyl,"},{"id":"semetey-1-2013:p1212:b004:l033","ordinal":168661,"en":"No tulpar could match him;"},{"id":"semetey-1-2013:p1212:b004:l034","ordinal":168662,"en":"To preserve my life,"},{"id":"semetey-1-2013:p1212:b004:l035","ordinal":168663,"en":"Stars were eclipsed in the sky,"},{"id":"semetey-1-2013:p1212:b004:l036","ordinal":168664,"en":"The saintly spirits supported me,"},{"id":"semetey-1-2013:p1212:b004:l037","ordinal":168665,"en":"And from the Black Chinese and Manchus"},{"id":"semetey-1-2013:p1212:b004:l038","ordinal":168666,"en":"I barely escaped alive,"},{"id":"semetey-1-2013:p1212:b004:l039","ordinal":168667,"en":"To raid the Kyzylbash,"},{"id":"semetey-1-2013:p1213:b003:l001","ordinal":168668,"en":"When they set out on campaign,"},{"id":"semetey-1-2013:p1213:b003:l002","ordinal":168669,"en":"In the desert of Mediyan,"},{"id":"semetey-1-2013:p1213:b003:l003","ordinal":168670,"en":"It appeared from the unseen,"},{"id":"semetey-1-2013:p1213:b003:l004","ordinal":168671,"en":"Found upon the open steppe."},{"id":"semetey-1-2013:p1213:b003:l005","ordinal":168672,"en":"When Akkula was honored with a feast,"},{"id":"semetey-1-2013:p1213:b003:l006","ordinal":168673,"en":"Ninety mares were slaughtered;"},{"id":"semetey-1-2013:p1213:b003:l007","ordinal":168674,"en":"The name Akkula was given him."},{"id":"semetey-1-2013:p1213:b003:l008","ordinal":168675,"en":"This year was the time"},{"id":"semetey-1-2013:p1213:b003:l009","ordinal":168676,"en":"For him to lower his head and run,"},{"id":"semetey-1-2013:p1213:b003:l010","ordinal":168677,"en":"The time to win"},{"id":"semetey-1-2013:p1213:b003:l011","ordinal":168678,"en":"Kökötöi’s grand prize."},{"id":"semetey-1-2013:p1213:b003:l012","ordinal":168679,"en":"After Akkula fell behind,"},{"id":"semetey-1-2013:p1213:b003:l013","ordinal":168680,"en":"What was I to do when this infidel’s Achbuudan"},{"id":"semetey-1-2013:p1213:b003:l014","ordinal":168681,"en":"Surged to the front?"},{"id":"semetey-1-2013:p1213:b003:l015","ordinal":168682,"en":"Before he could get away,"},{"id":"semetey-1-2013:p1213:b003:l016","ordinal":168683,"en":"If strength allowed, I would reach his end."},{"id":"semetey-1-2013:p1213:b003:l017","ordinal":168684,"en":"Lion Manas flared up,"},{"id":"semetey-1-2013:p1213:b003:l018","ordinal":168685,"en":"Raging in fury,"},{"id":"semetey-1-2013:p1213:b003:l019","ordinal":168686,"en":"Buckled on the gray kise,"},{"id":"semetey-1-2013:p1213:b003:l020","ordinal":168687,"en":"And struck Aibanboz once."},{"id":"semetey-1-2013:p1213:b003:l021","ordinal":168688,"en":"When Khan Manas came from below,"},{"id":"semetey-1-2013:p1213:b003:l022","ordinal":168689,"en":"He charged from the flank,"},{"id":"semetey-1-2013:p1213:b003:l023","ordinal":168690,"en":"Aiming below the ribs,"},{"id":"semetey-1-2013:p1213:b003:l024","ordinal":168691,"en":"At the edge of the kidney."},{"id":"semetey-1-2013:p1213:b003:l025","ordinal":168692,"en":"Charging in fury,"},{"id":"semetey-1-2013:p1213:b003:l026","ordinal":168693,"en":"Khan Manas kicked Achbuudan"},{"id":"semetey-1-2013:p1213:b003:l027","ordinal":168694,"en":"Across the flank."},{"id":"semetey-1-2013:p1213:b003:l028","ordinal":168695,"en":"The creature that came surging,"},{"id":"semetey-1-2013:p1213:b003:l029","ordinal":168696,"en":"When Manas struck in force,"},{"id":"semetey-1-2013:p1213:b003:l030","ordinal":168697,"en":"Stumbled away."},{"id":"semetey-1-2013:p1213:b003:l031","ordinal":168698,"en":"Three rows in succession"},{"id":"semetey-1-2013:p1213:b003:l032","ordinal":168699,"en":"He knocked aside as he fell."},{"id":"semetey-1-2013:p1213:b003:l033","ordinal":168700,"en":"Manas strained in fury;"},{"id":"semetey-1-2013:p1213:b003:l034","ordinal":168701,"en":"The place where Achbuudan fell"},{"id":"semetey-1-2013:p1213:b003:l035","ordinal":168702,"en":"From that day to this"},{"id":"semetey-1-2013:p1213:b003:l036","ordinal":168703,"en":"Became known as Ak-Zhar."},{"id":"semetey-1-2013:p1213:b003:l037","ordinal":168704,"en":"As Achbuudan lay fallen,"}]
