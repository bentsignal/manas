[{"id":"seytek-2012:p0035:b002:l030","ordinal":295681,"en":"Uttering monstrous words like ogres,"},{"id":"seytek-2012:p0035:b002:l031","ordinal":295682,"en":"Proposing their scheme to brave Kyyaz"},{"id":"seytek-2012:p0035:b002:l032","ordinal":295683,"en":"And speaking of terrible trouble"},{"id":"seytek-2012:p0035:b002:l033","ordinal":295684,"en":"For Aichürök."},{"id":"seytek-2012:p0035:b002:l034","ordinal":295685,"en":"Saying, “So it shall be,”"},{"id":"seytek-2012:p0035:b002:l035","ordinal":295686,"en":"And that everything was settled,"},{"id":"seytek-2012:p0035:b002:l036","ordinal":295687,"en":"They made their pledge."},{"id":"seytek-2012:p0035:b002:l037","ordinal":295688,"en":"Before the seven fiends went"},{"id":"seytek-2012:p0035:b002:l038","ordinal":295689,"en":"To Chürök in her labor,"},{"id":"seytek-2012:p0035:b002:l039","ordinal":295690,"en":"Kyyaz said, “In Khan Kyyaz’s house"},{"id":"seytek-2012:p0035:b002:l040","ordinal":295691,"en":"You shall carry firewood and pour water,"},{"id":"seytek-2012:p0035:b003:l001","ordinal":295692,"en":"Water your horses tirelessly,"},{"id":"seytek-2012:p0035:b003:l002","ordinal":295693,"en":"And make your names renowned among the people."},{"id":"seytek-2012:p0035:b003:l003","ordinal":295694,"en":"I shall set your hearts at ease among the nation"},{"id":"seytek-2012:p0035:b003:l004","ordinal":295695,"en":"And make you queens, rulers among women."},{"id":"seytek-2012:p0035:b003:l005","ordinal":295696,"en":"My dear seven mothers,"},{"id":"seytek-2012:p0035:b003:l006","ordinal":295697,"en":"Consent to what I have said"},{"id":"seytek-2012:p0035:b003:l007","ordinal":295698,"en":"And grant what I desire.”"},{"id":"seytek-2012:p0035:b003:l008","ordinal":295699,"en":"Thus brave Kyyaz"},{"id":"seytek-2012:p0035:b003:l009","ordinal":295700,"en":"Spared none of his wealth."},{"id":"seytek-2012:p0035:b003:l010","ordinal":295701,"en":"To slaughter the child"},{"id":"seytek-2012:p0035:b003:l011","ordinal":295702,"en":"Of the woman Aichürök,"},{"id":"seytek-2012:p0035:b003:l012","ordinal":295703,"en":"He appointed the seven old women."},{"id":"seytek-2012:p0035:b003:l013","ordinal":295704,"en":"The seven corrupting crones"},{"id":"seytek-2012:p0035:b003:l014","ordinal":295705,"en":"Agreed to his demand:"},{"id":"seytek-2012:p0035:b003:l015","ordinal":295706,"en":"To remove the young child"},{"id":"seytek-2012:p0035:b003:l016","ordinal":295707,"en":"From this world,"},{"id":"seytek-2012:p0035:b003:l017","ordinal":295708,"en":"To fill his body with poison,"},{"id":"seytek-2012:p0035:b003:l018","ordinal":295709,"en":"And receive gold from Kyyaz."},{"id":"seytek-2012:p0035:b003:l019","ordinal":295710,"en":"“My dear Kyyaz, we agree;"},{"id":"seytek-2012:p0035:b003:l020","ordinal":295711,"en":"According to the meaning of your dream,"},{"id":"seytek-2012:p0035:b003:l021","ordinal":295712,"en":"We shall undertake this deed."},{"id":"seytek-2012:p0035:b003:l022","ordinal":295713,"en":"We will serve"},{"id":"seytek-2012:p0035:b003:l023","ordinal":295714,"en":"A precious man like you, my son."},{"id":"seytek-2012:p0035:b003:l024","ordinal":295715,"en":"We shall obey your words,"},{"id":"seytek-2012:p0035:b003:l025","ordinal":295716,"en":"My son, and grant your wish."},{"id":"seytek-2012:p0035:b003:l026","ordinal":295717,"en":"We shall ease the pain that ails you"},{"id":"seytek-2012:p0035:b003:l027","ordinal":295718,"en":"And open wide your dimmed eyes."},{"id":"seytek-2012:p0035:b003:l028","ordinal":295719,"en":"We shall bring back what you have lost"},{"id":"seytek-2012:p0035:b003:l029","ordinal":295720,"en":"And banish your grief."},{"id":"seytek-2012:p0035:b003:l030","ordinal":295721,"en":"If we fail to do your bidding,"},{"id":"seytek-2012:p0035:b003:l031","ordinal":295722,"en":"Cut off our heads with a sword;"},{"id":"seytek-2012:p0035:b003:l032","ordinal":295723,"en":"Spare not the least breath of life,"},{"id":"seytek-2012:p0035:b003:l033","ordinal":295724,"en":"But slaughter us all."},{"id":"seytek-2012:p0035:b003:l034","ordinal":295725,"en":"If we make that child disappear"},{"id":"seytek-2012:p0035:b003:l035","ordinal":295726,"en":"And set Kyyaz’s affairs right,"},{"id":"seytek-2012:p0035:b003:l036","ordinal":295727,"en":"Consent to whatever"},{"id":"seytek-2012:p0035:b003:l037","ordinal":295728,"en":"Your seven aged mothers ask,"},{"id":"seytek-2012:p0035:b003:l038","ordinal":295729,"en":"And grant us our desire."},{"id":"seytek-2012:p0035:b003:l039","ordinal":295730,"en":"This is our wish, Khan Kyyaz;"},{"id":"seytek-2012:p0035:b003:l040","ordinal":295731,"en":"Look kindly upon it and approve."},{"id":"seytek-2012:p0036:b002:l001","ordinal":295732,"en":"So they plunge into intrigue."},{"id":"seytek-2012:p0036:b002:l002","ordinal":295733,"en":"If you ask what our people are like:"},{"id":"seytek-2012:p0036:b002:l003","ordinal":295734,"en":"They share one heart with warriors,"},{"id":"seytek-2012:p0036:b002:l004","ordinal":295735,"en":"Match strength with wrestlers,"},{"id":"seytek-2012:p0036:b002:l005","ordinal":295736,"en":"Stand face-to-face with champions,"},{"id":"seytek-2012:p0036:b002:l006","ordinal":295737,"en":"And rival orators in eloquence!"},{"id":"seytek-2012:p0036:b002:l007","ordinal":295738,"en":"Leopards favored by the wolf’s fortune,"},{"id":"seytek-2012:p0036:b002:l008","ordinal":295739,"en":"A singular and blessed nation,"},{"id":"seytek-2012:p0036:b002:l009","ordinal":295740,"en":"Whom no man dares confront"},{"id":"seytek-2012:p0036:b002:l010","ordinal":295741,"en":"And no enemy has defeated."},{"id":"seytek-2012:p0036:b002:l011","ordinal":295742,"en":"The bravest of heroes dwell among us—"},{"id":"seytek-2012:p0036:b002:l012","ordinal":295743,"en":"What a splendid people are ours!"},{"id":"seytek-2012:p0036:b002:l013","ordinal":295744,"en":"Our dark fields abound in rice;"},{"id":"seytek-2012:p0036:b002:l014","ordinal":295745,"en":"Such is the richness of our land."},{"id":"seytek-2012:p0036:b002:l015","ordinal":295746,"en":"We have more silver than tin,"},{"id":"seytek-2012:p0036:b002:l016","ordinal":295747,"en":"More camels than other livestock,"},{"id":"seytek-2012:p0036:b002:l017","ordinal":295748,"en":"And more giants than weaklings—"},{"id":"seytek-2012:p0036:b002:l018","ordinal":295749,"en":"What a splendid people are ours!"},{"id":"seytek-2012:p0036:b002:l019","ordinal":295750,"en":"Herds of wild asses gather on the plains,"},{"id":"seytek-2012:p0036:b002:l020","ordinal":295751,"en":"Argali graze upon the hills,"},{"id":"seytek-2012:p0036:b002:l021","ordinal":295752,"en":"Ibex roam the crags,"},{"id":"seytek-2012:p0036:b002:l022","ordinal":295753,"en":"Wolves prowl the lower slopes,"},{"id":"seytek-2012:p0036:b002:l023","ordinal":295754,"en":"And foxes frolic on the rolling steppe."},{"id":"seytek-2012:p0036:b002:l024","ordinal":295755,"en":"Nightingales sing in the willows."},{"id":"seytek-2012:p0036:b002:l025","ordinal":295756,"en":"In our broad Talas valley,"},{"id":"seytek-2012:p0036:b002:l026","ordinal":295757,"en":"Not a single tree lacks delight."},{"id":"seytek-2012:p0036:b002:l027","ordinal":295758,"en":"Red deer bellow in the thickets,"},{"id":"seytek-2012:p0036:b002:l028","ordinal":295759,"en":"Cuckoos call from the plane trees,"},{"id":"seytek-2012:p0036:b002:l029","ordinal":295760,"en":"Eagles beat their wings on the rocks,"},{"id":"seytek-2012:p0036:b002:l030","ordinal":295761,"en":"And falcons strain upon their perches."},{"id":"seytek-2012:p0036:b002:l031","ordinal":295762,"en":"Every creature that possesses life"},{"id":"seytek-2012:p0036:b002:l032","ordinal":295763,"en":"Lives in Talas, our land—"},{"id":"seytek-2012:p0036:b002:l033","ordinal":295764,"en":"All living things are there."},{"id":"seytek-2012:p0036:b002:l034","ordinal":295765,"en":"When will we reach that broad green-mottled valley?"},{"id":"seytek-2012:p0036:b002:l035","ordinal":295766,"en":"When will that day come?"},{"id":"seytek-2012:p0036:b002:l036","ordinal":295767,"en":"Dearly remembered Karachach,"},{"id":"seytek-2012:p0036:b002:l037","ordinal":295768,"en":"When will we reach our people?”"},{"id":"seytek-2012:p0036:b002:l038","ordinal":295769,"en":"To share one inheritance,"},{"id":"seytek-2012:p0036:b002:l039","ordinal":295770,"en":"And, if happy days returned,"},{"id":"seytek-2012:p0036:b002:l040","ordinal":295771,"en":"To go back to Talas,"},{"id":"seytek-2012:p0036:b003:l001","ordinal":295772,"en":"There was a woman named Karachach."},{"id":"seytek-2012:p0036:b003:l002","ordinal":295773,"en":"She lived as a lowly serving woman,"},{"id":"seytek-2012:p0036:b003:l003","ordinal":295774,"en":"A soul enduring humiliation."},{"id":"seytek-2012:p0036:b003:l004","ordinal":295775,"en":"After Aichürök arrived,"},{"id":"seytek-2012:p0036:b003:l005","ordinal":295776,"en":"Her weary spirit revived,"},{"id":"seytek-2012:p0036:b003:l006","ordinal":295777,"en":"All her sorrows vanished,"},{"id":"seytek-2012:p0036:b003:l007","ordinal":295778,"en":"Her hollow parts filled with milk,"},{"id":"seytek-2012:p0036:b003:l008","ordinal":295779,"en":"Her gaunt limbs filled with flesh,"},{"id":"seytek-2012:p0036:b003:l009","ordinal":295780,"en":"What had been broken was restored,"},{"id":"seytek-2012:p0036:b003:l010","ordinal":295781,"en":"What had been scattered was gathered,"},{"id":"seytek-2012:p0036:b003:l011","ordinal":295782,"en":"And her misery and anguish disappeared."},{"id":"seytek-2012:p0036:b003:l012","ordinal":295783,"en":"The wretched woman and Aichürök"},{"id":"seytek-2012:p0036:b003:l013","ordinal":295784,"en":"Spoke of God together,"},{"id":"seytek-2012:p0036:b003:l014","ordinal":295785,"en":"And swore an oath unto death."},{"id":"seytek-2012:p0036:b003:l015","ordinal":295786,"en":"When they sat, they sat side by side;"},{"id":"seytek-2012:p0036:b003:l016","ordinal":295787,"en":"When they prepared food, they did so together."},{"id":"seytek-2012:p0036:b003:l017","ordinal":295788,"en":"Whenever they sat or rose, they spoke"},{"id":"seytek-2012:p0036:b003:l018","ordinal":295789,"en":"Of returning to broad Talas"},{"id":"seytek-2012:p0036:b003:l019","ordinal":295790,"en":"And coming into a shared inheritance."},{"id":"seytek-2012:p0036:b003:l020","ordinal":295791,"en":"They sealed their pledge,"},{"id":"seytek-2012:p0036:b003:l021","ordinal":295792,"en":"And among the women and children of the house"},{"id":"seytek-2012:p0036:b003:l022","ordinal":295793,"en":"Swore an oath binding unto death."},{"id":"seytek-2012:p0036:b003:l023","ordinal":295794,"en":"Aichürök would continually"},{"id":"seytek-2012:p0036:b003:l024","ordinal":295795,"en":"Tell Karachach about her people"},{"id":"seytek-2012:p0036:b003:l025","ordinal":295796,"en":"And praise them to her;"},{"id":"seytek-2012:p0036:b003:l026","ordinal":295797,"en":"She praised Jylgyndy, Keng-Kol, and broad Talas,"},{"id":"seytek-2012:p0036:b003:l027","ordinal":295798,"en":"And ever extolled her homeland."},{"id":"seytek-2012:p0036:b003:l028","ordinal":295799,"en":"“Our Talas is like this,” she said."},{"id":"seytek-2012:p0036:b003:l029","ordinal":295800,"en":"“Our Kyrgyz are a splendid people:"},{"id":"seytek-2012:p0036:b003:l030","ordinal":295801,"en":"With jingling hair ornaments and generous hips,"},{"id":"seytek-2012:p0036:b003:l031","ordinal":295802,"en":"Beautiful are the young wives of our land."},{"id":"seytek-2012:p0036:b003:l032","ordinal":295803,"en":"In red dresses, with waists curved like the moon,"},{"id":"seytek-2012:p0036:b003:l033","ordinal":295804,"en":"Beautiful are the maidens of our people."},{"id":"seytek-2012:p0036:b003:l034","ordinal":295805,"en":"In black coats and white kalpaks,"},{"id":"seytek-2012:p0036:b003:l035","ordinal":295806,"en":"Handsome are the young men of our land."},{"id":"seytek-2012:p0036:b003:l036","ordinal":295807,"en":"If you ask what our people are like,"},{"id":"seytek-2012:p0036:b003:l037","ordinal":295808,"en":"When bored, they hunt roe deer;"},{"id":"seytek-2012:p0036:b003:l038","ordinal":295809,"en":"When not bored, there in Talas"},{"id":"seytek-2012:p0036:b003:l039","ordinal":295810,"en":"They play at leisure."},{"id":"seytek-2012:p0036:b003:l040","ordinal":295811,"en":"They drink kumis and court the girls,"},{"id":"seytek-2012:p0037:b002:l001","ordinal":295812,"en":"To Aichürök’s side"},{"id":"seytek-2012:p0037:b002:l002","ordinal":295813,"en":"To bewitch her and take her child,"},{"id":"seytek-2012:p0037:b002:l003","ordinal":295814,"en":"They had gone in,"},{"id":"seytek-2012:p0037:b002:l004","ordinal":295815,"en":"Intent on bringing Chürök"},{"id":"seytek-2012:p0037:b002:l005","ordinal":295816,"en":"To some dreadful harm."},{"id":"seytek-2012:p0037:b002:l006","ordinal":295817,"en":"Once she knew their enmity,"},{"id":"seytek-2012:p0037:b002:l007","ordinal":295818,"en":"Moonlike Aichürök—"},{"id":"seytek-2012:p0037:b002:l008","ordinal":295819,"en":"Who could skim above a horse’s mane,"},{"id":"seytek-2012:p0037:b002:l009","ordinal":295820,"en":"Who could fly through the air,"},{"id":"seytek-2012:p0037:b002:l010","ordinal":295821,"en":"Who knew well how to fly—"},{"id":"seytek-2012:p0037:b002:l011","ordinal":295822,"en":"Would she fail to know an enemy?"},{"id":"seytek-2012:p0037:b002:l012","ordinal":295823,"en":"If she did, could she be Chürök!"},{"id":"seytek-2012:p0037:b002:l013","ordinal":295824,"en":"The keen-witted maid Karachach,"},{"id":"seytek-2012:p0037:b002:l014","ordinal":295825,"en":"The noble-born maid,"},{"id":"seytek-2012:p0037:b002:l015","ordinal":295826,"en":"When the wicked old women entered,"},{"id":"seytek-2012:p0037:b002:l016","ordinal":295827,"en":"Cast a chilling spell,"},{"id":"seytek-2012:p0037:b002:l017","ordinal":295828,"en":"And with boundless sorcery"},{"id":"seytek-2012:p0037:b002:l018","ordinal":295829,"en":"Blinded the eyes"},{"id":"seytek-2012:p0037:b002:l019","ordinal":295830,"en":"Of all seven old women."},{"id":"seytek-2012:p0037:b002:l020","ordinal":295831,"en":"The seven razors they had prepared"},{"id":"seytek-2012:p0037:b002:l021","ordinal":295832,"en":"Karachach secretly stole,"},{"id":"seytek-2012:p0037:b002:l022","ordinal":295833,"en":"And into a bottomless black well"},{"id":"seytek-2012:p0037:b002:l023","ordinal":295834,"en":"She carried and cast them:"},{"id":"seytek-2012:p0037:b002:l024","ordinal":295835,"en":"The instant the razors"},{"id":"seytek-2012:p0037:b002:l025","ordinal":295836,"en":"Struck the well,"},{"id":"seytek-2012:p0037:b002:l026","ordinal":295837,"en":"Unable to withstand their poison,"},{"id":"seytek-2012:p0037:b002:l027","ordinal":295838,"en":"The black stone beneath the water"},{"id":"seytek-2012:p0037:b002:l028","ordinal":295839,"en":"Split clean in two."},{"id":"seytek-2012:p0037:b002:l029","ordinal":295840,"en":"The old women wandered in a daze,"},{"id":"seytek-2012:p0037:b002:l030","ordinal":295841,"en":"Neither mad nor sane,"},{"id":"seytek-2012:p0037:b002:l031","ordinal":295842,"en":"And lost the razors"},{"id":"seytek-2012:p0037:b002:l032","ordinal":295843,"en":"The warrior had given them."},{"id":"seytek-2012:p0037:b002:l033","ordinal":295844,"en":"Yesterday, when they heaped humiliation upon us like sheep,"},{"id":"seytek-2012:p0037:b002:l034","ordinal":295845,"en":"When they plundered our royal camp,"},{"id":"seytek-2012:p0037:b002:l035","ordinal":295846,"en":"My valiant mother Kanykey"},{"id":"seytek-2012:p0037:b002:l036","ordinal":295847,"en":"Left this solemn charge: “Should you fail to guard him,"},{"id":"seytek-2012:p0037:b002:l037","ordinal":295848,"en":"Then to the enemy who counts us foes,"},{"id":"seytek-2012:p0037:b002:l038","ordinal":295849,"en":"When my foal is in desperate straits,"},{"id":"seytek-2012:p0037:b002:l039","ordinal":295850,"en":"Hand him over.”"},{"id":"seytek-2012:p0037:b002:l040","ordinal":295851,"en":"Yesterday, when havoc was wrought in Künjüt,"},{"id":"seytek-2012:p0037:b003:l001","ordinal":295852,"en":"Chürök proved a wise soul;"},{"id":"seytek-2012:p0037:b003:l002","ordinal":295853,"en":"She and Karachach"},{"id":"seytek-2012:p0037:b003:l003","ordinal":295854,"en":"Had made a pact."},{"id":"seytek-2012:p0037:b003:l004","ordinal":295855,"en":"How Kyyaz meant to bring disaster,"},{"id":"seytek-2012:p0037:b003:l005","ordinal":295856,"en":"And what the seven old women"},{"id":"seytek-2012:p0037:b003:l006","ordinal":295857,"en":"Had promised Kyyaz,"},{"id":"seytek-2012:p0037:b003:l007","ordinal":295858,"en":"Karachach had overheard."},{"id":"seytek-2012:p0037:b003:l008","ordinal":295859,"en":"Her knees buckling to the ground,"},{"id":"seytek-2012:p0037:b003:l009","ordinal":295860,"en":"She ran and reached Chürök,"},{"id":"seytek-2012:p0037:b003:l010","ordinal":295861,"en":"Who labored in birth,"},{"id":"seytek-2012:p0037:b003:l011","ordinal":295862,"en":"Her heart torn apart,"},{"id":"seytek-2012:p0037:b003:l012","ordinal":295863,"en":"Tears streaming from her eyes."},{"id":"seytek-2012:p0037:b003:l013","ordinal":295864,"en":"Before another word could be said,"},{"id":"seytek-2012:p0037:b003:l014","ordinal":295865,"en":"Karachach, flustered and frantic,"},{"id":"seytek-2012:p0037:b003:l015","ordinal":295866,"en":"Came to Aichürök:"},{"id":"seytek-2012:p0037:b003:l016","ordinal":295867,"en":"“My dearest elder sister,"},{"id":"seytek-2012:p0037:b003:l017","ordinal":295868,"en":"If only I see you safe, my heart will rest;"},{"id":"seytek-2012:p0037:b003:l018","ordinal":295869,"en":"I have no refuge but you."},{"id":"seytek-2012:p0037:b003:l019","ordinal":295870,"en":"Have you seen what I have seen?"},{"id":"seytek-2012:p0037:b003:l020","ordinal":295871,"en":"Do you know what I know?"},{"id":"seytek-2012:p0037:b003:l021","ordinal":295872,"en":"If you do not know what I know:"},{"id":"seytek-2012:p0037:b003:l022","ordinal":295873,"en":"Kyyaz, son of Bagysh—"},{"id":"seytek-2012:p0037:b003:l023","ordinal":295874,"en":"The Seven Valleys are no land for you,"},{"id":"seytek-2012:p0037:b003:l024","ordinal":295875,"en":"The Jediger are no people for you,"},{"id":"seytek-2012:p0037:b003:l025","ordinal":295876,"en":"And brave Kyyaz is no husband for you."},{"id":"seytek-2012:p0037:b003:l026","ordinal":295877,"en":"If you bear a son,"},{"id":"seytek-2012:p0037:b003:l027","ordinal":295878,"en":"All the old women have plotted"},{"id":"seytek-2012:p0037:b003:l028","ordinal":295879,"en":"To bewitch you, gouge out your eyes,"},{"id":"seytek-2012:p0037:b003:l029","ordinal":295880,"en":"Seize your child and slaughter him;"},{"id":"seytek-2012:p0037:b003:l030","ordinal":295881,"en":"They have sealed their pledge."},{"id":"seytek-2012:p0037:b003:l031","ordinal":295882,"en":"You were a lioness among women."},{"id":"seytek-2012:p0037:b003:l032","ordinal":295883,"en":"From wandering Almighty God,"},{"id":"seytek-2012:p0037:b003:l033","ordinal":295884,"en":"You were the one I prayed for."},{"id":"seytek-2012:p0037:b003:l034","ordinal":295885,"en":"Find a way to outwit"},{"id":"seytek-2012:p0037:b003:l035","ordinal":295886,"en":"The seven wicked old women, sister;"},{"id":"seytek-2012:p0037:b003:l036","ordinal":295887,"en":"Find the right words to answer"},{"id":"seytek-2012:p0037:b003:l037","ordinal":295888,"en":"The fierce infidel Kyyaz, sister!”"},{"id":"seytek-2012:p0037:b003:l038","ordinal":295889,"en":"Thus Karachach spoke,"},{"id":"seytek-2012:p0037:b003:l039","ordinal":295890,"en":"And before she had closed her mouth,"},{"id":"seytek-2012:p0037:b003:l040","ordinal":295891,"en":"The seven spell-casting old women—"},{"id":"seytek-2012:p0038:b002:l001","ordinal":295892,"en":"“All my flesh and bones"},{"id":"seytek-2012:p0038:b002:l002","ordinal":295893,"en":"Are about to burst apart."},{"id":"seytek-2012:p0038:b002:l003","ordinal":295894,"en":"Your hands bring healing to all they touch;"},{"id":"seytek-2012:p0038:b002:l004","ordinal":295895,"en":"You seven have come as holy women."},{"id":"seytek-2012:p0038:b002:l005","ordinal":295896,"en":"Lay hands upon the place that hurts,"},{"id":"seytek-2012:p0038:b002:l006","ordinal":295897,"en":"Mothers who master every remedy,"},{"id":"seytek-2012:p0038:b002:l007","ordinal":295898,"en":"Open my eyes, swollen like lumps of dough!”"},{"id":"seytek-2012:p0038:b002:l008","ordinal":295899,"en":"Thus Aichürök spoke"},{"id":"seytek-2012:p0038:b002:l009","ordinal":295900,"en":"And closed her mouth."},{"id":"seytek-2012:p0038:b002:l010","ordinal":295901,"en":"From the kumis mixed with poison,"},{"id":"seytek-2012:p0038:b002:l011","ordinal":295902,"en":"Seven bowls of kumis"},{"id":"seytek-2012:p0038:b002:l012","ordinal":295903,"en":"The deft and capable Karachach"},{"id":"seytek-2012:p0038:b002:l013","ordinal":295904,"en":"Poured for the old women."},{"id":"seytek-2012:p0038:b002:l014","ordinal":295905,"en":"Immeasurably nimble,"},{"id":"seytek-2012:p0038:b002:l015","ordinal":295906,"en":"The quick-moving poor girl"},{"id":"seytek-2012:p0038:b002:l016","ordinal":295907,"en":"Steeled herself like a hawk,"},{"id":"seytek-2012:p0038:b002:l017","ordinal":295908,"en":"Fawned upon the false old women,"},{"id":"seytek-2012:p0038:b002:l018","ordinal":295909,"en":"Measured poison by the ladle,"},{"id":"seytek-2012:p0038:b002:l019","ordinal":295910,"en":"And gave them water by the spoon."},{"id":"seytek-2012:p0038:b002:l020","ordinal":295911,"en":"She served all seven alike,"},{"id":"seytek-2012:p0038:b002:l021","ordinal":295912,"en":"Quickly, betraying no suspicion."},{"id":"seytek-2012:p0038:b002:l022","ordinal":295913,"en":"At dusk, as the sun went down"},{"id":"seytek-2012:p0038:b002:l023","ordinal":295914,"en":"And all the people lay sound asleep,"},{"id":"seytek-2012:p0038:b002:l024","ordinal":295915,"en":"She made every arrow ready in the quiver"},{"id":"seytek-2012:p0038:b002:l025","ordinal":295916,"en":"And sent the seven ill-fated old women"},{"id":"seytek-2012:p0038:b002:l026","ordinal":295917,"en":"Out of this world."},{"id":"seytek-2012:p0038:b002:l027","ordinal":295918,"en":"Beside the hearth"},{"id":"seytek-2012:p0038:b002:l028","ordinal":295919,"en":"She dug a pit,"},{"id":"seytek-2012:p0038:b002:l029","ordinal":295920,"en":"And the accomplished Aichürök"},{"id":"seytek-2012:p0038:b002:l030","ordinal":295921,"en":"Managed to slaughter all seven."},{"id":"seytek-2012:p0038:b002:l031","ordinal":295922,"en":"Folding them double at the waist,"},{"id":"seytek-2012:p0038:b002:l032","ordinal":295923,"en":"At the edge of the hearth"},{"id":"seytek-2012:p0038:b002:l033","ordinal":295924,"en":"She laid them in a hidden grave."},{"id":"seytek-2012:p0038:b002:l034","ordinal":295925,"en":"Without a single person knowing,"},{"id":"seytek-2012:p0038:b002:l035","ordinal":295926,"en":"Without anyone seeing,"},{"id":"seytek-2012:p0038:b002:l036","ordinal":295927,"en":"The seven witches died;"},{"id":"seytek-2012:p0038:b002:l037","ordinal":295928,"en":"The seven troublemakers went"},{"id":"seytek-2012:p0038:b002:l038","ordinal":295929,"en":"To the true abode from which none return."},{"id":"seytek-2012:p0038:b002:l039","ordinal":295930,"en":"Their seven lives were stilled,"},{"id":"seytek-2012:p0038:b002:l040","ordinal":295931,"en":"And the world was rid of all seven together."},{"id":"seytek-2012:p0038:b003:l001","ordinal":295932,"en":"When roaring leopard Manas"},{"id":"seytek-2012:p0038:b003:l002","ordinal":295933,"en":"Raided Künjüt long ago,"},{"id":"seytek-2012:p0038:b003:l003","ordinal":295934,"en":"This poison had brought merciless devastation;"},{"id":"seytek-2012:p0038:b003:l004","ordinal":295935,"en":"It was an evil that slaughtered men,"},{"id":"seytek-2012:p0038:b003:l005","ordinal":295936,"en":"A poison called “Soundless Death.”"}]
