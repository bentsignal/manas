[{"id":"semetey-2-2013:p1352:b004:l022","ordinal":289793,"en":"So Kanykei spoke,"},{"id":"semetey-2-2013:p1352:b004:l023","ordinal":289794,"en":"Your dear, unfortunate mother,"},{"id":"semetey-2-2013:p1352:b004:l024","ordinal":289795,"en":"At times grieving, at times weeping,"},{"id":"semetey-2-2013:p1352:b004:l025","ordinal":289796,"en":"Urging her toward lionhearted courage."},{"id":"semetey-2-2013:p1352:b004:l026","ordinal":289797,"en":"At times lamenting, at times weeping,"},{"id":"semetey-2-2013:p1352:b004:l027","ordinal":289798,"en":"She urged her toward heroic resolve."},{"id":"semetey-2-2013:p1352:b004:l028","ordinal":289799,"en":"Before she had closed her mouth,"},{"id":"semetey-2-2013:p1352:b004:l029","ordinal":289800,"en":"Before she could finish every word,"},{"id":"semetey-2-2013:p1352:b004:l030","ordinal":289801,"en":"May God never show such a sight!"},{"id":"semetey-2-2013:p1352:b004:l031","ordinal":289802,"en":"The battle standard surged like a flag;"},{"id":"semetey-2-2013:p1352:b004:l032","ordinal":289803,"en":"A din arose that split the sky."},{"id":"semetey-2-2013:p1352:b004:l033","ordinal":289804,"en":"A vast army flooded forth,"},{"id":"semetey-2-2013:p1352:b004:l034","ordinal":289805,"en":"Firing cannon and drawing bows,"},{"id":"semetey-2-2013:p1352:b004:l035","ordinal":289806,"en":"And covered the road."},{"id":"semetey-2-2013:p1352:b004:l036","ordinal":289807,"en":"They encircled the palace amid uproar;"},{"id":"semetey-2-2013:p1352:b004:l037","ordinal":289808,"en":"A din arose that split the sky."},{"id":"semetey-2-2013:p1352:b004:l038","ordinal":289809,"en":"Spearheads clashed,"},{"id":"semetey-2-2013:p1352:b004:l039","ordinal":289810,"en":"And all the champions raced forward."},{"id":"semetey-2-2013:p1353:b003:l001","ordinal":289811,"en":"Dust flew into the sky;"},{"id":"semetey-2-2013:p1353:b003:l002","ordinal":289812,"en":"The army spread in a dusty glitter."},{"id":"semetey-2-2013:p1353:b003:l003","ordinal":289813,"en":"They advanced with battle-axes in hand,"},{"id":"semetey-2-2013:p1353:b003:l004","ordinal":289814,"en":"Swords striking from their sheaths."},{"id":"semetey-2-2013:p1353:b003:l005","ordinal":289815,"en":"Their divisions split and opened,"},{"id":"semetey-2-2013:p1353:b003:l006","ordinal":289816,"en":"Their multitude plain to the people."},{"id":"semetey-2-2013:p1353:b003:l007","ordinal":289817,"en":"They were many tens of thousands,"},{"id":"semetey-2-2013:p1353:b003:l008","ordinal":289818,"en":"An army by no means small."},{"id":"semetey-2-2013:p1353:b003:l009","ordinal":289819,"en":"The people bustled and dust swirled;"},{"id":"semetey-2-2013:p1353:b003:l010","ordinal":289820,"en":"They seemed to fill the face of the world."},{"id":"semetey-2-2013:p1353:b003:l011","ordinal":289821,"en":"The layered black earth below"},{"id":"semetey-2-2013:p1353:b003:l012","ordinal":289822,"en":"Smoked thickly"},{"id":"semetey-2-2013:p1353:b003:l013","ordinal":289823,"en":"Beneath Kanchoro's wrath."},{"id":"semetey-2-2013:p1353:b003:l014","ordinal":289824,"en":"The earth turned gray amid clamor;"},{"id":"semetey-2-2013:p1353:b003:l015","ordinal":289825,"en":"A din arose that split the sky."},{"id":"semetey-2-2013:p1353:b003:l016","ordinal":289826,"en":"Haze spread and darkened it."},{"id":"semetey-2-2013:p1353:b003:l017","ordinal":289827,"en":"The multitude of Zhediger"},{"id":"semetey-2-2013:p1353:b003:l018","ordinal":289828,"en":"Flooded over the land"},{"id":"semetey-2-2013:p1353:b003:l019","ordinal":289829,"en":"Until they seemed one with the earth."},{"id":"semetey-2-2013:p1353:b003:l020","ordinal":289830,"en":"The cunning and the mighty,"},{"id":"semetey-2-2013:p1353:b003:l021","ordinal":289831,"en":"Those who broke ranks with spears,"},{"id":"semetey-2-2013:p1353:b003:l022","ordinal":289832,"en":"Met the men of the gate;"},{"id":"semetey-2-2013:p1353:b003:l023","ordinal":289833,"en":"Those whose death had come fell to bullets."},{"id":"semetey-2-2013:p1353:b003:l024","ordinal":289834,"en":"Shouting the cry, \"Kanchoro Khan!\""},{"id":"semetey-2-2013:p1353:b003:l025","ordinal":289835,"en":"The furious myriad army"},{"id":"semetey-2-2013:p1353:b003:l026","ordinal":289836,"en":"Raised the battle cry, \"Kiyaz!\""},{"id":"semetey-2-2013:p1353:b003:l027","ordinal":289837,"en":"They flew in like flies,"},{"id":"semetey-2-2013:p1353:b003:l028","ordinal":289838,"en":"Surrounded them, writhing like worms,"},{"id":"semetey-2-2013:p1353:b003:l029","ordinal":289839,"en":"And streamed like ants."},{"id":"semetey-2-2013:p1353:b003:l030","ordinal":289840,"en":"The gatekeepers and Zhediger"},{"id":"semetey-2-2013:p1353:b003:l031","ordinal":289841,"en":"Stood facing one another,"},{"id":"semetey-2-2013:p1353:b003:l032","ordinal":289842,"en":"Firing cannon and bows,"},{"id":"semetey-2-2013:p1353:b003:l033","ordinal":289843,"en":"Quarreling and fighting."},{"id":"semetey-2-2013:p1353:b003:l034","ordinal":289844,"en":"Kanchoro had taken a wife"},{"id":"semetey-2-2013:p1353:b003:l035","ordinal":289845,"en":"From among all the Zhediger,"},{"id":"semetey-2-2013:p1353:b003:l036","ordinal":289846,"en":"From their accomplished Khan Kiyaz,"},{"id":"semetey-2-2013:p1353:b003:l037","ordinal":289847,"en":"Their lion of noble custom,"},{"id":"semetey-2-2013:p1353:b003:l038","ordinal":289848,"en":"Their truly courageous hero."},{"id":"semetey-2-2013:p1353:b003:l039","ordinal":289849,"en":"Gathering the Zhediger,"},{"id":"semetey-2-2013:p1353:b005:l001","ordinal":289850,"en":"Kanchoro gave counsel"},{"id":"semetey-2-2013:p1353:b005:l002","ordinal":289851,"en":"And roused them to fury."},{"id":"semetey-2-2013:p1353:b005:l003","ordinal":289852,"en":"He had sharpened his sword keenly;"},{"id":"semetey-2-2013:p1353:b005:l004","ordinal":289853,"en":"Trampling some men,"},{"id":"semetey-2-2013:p1353:b005:l005","ordinal":289854,"en":"Gnawing, cutting, and berating others,"},{"id":"semetey-2-2013:p1353:b005:l006","ordinal":289855,"en":"Kanchoro drove them onward."},{"id":"semetey-2-2013:p1353:b005:l007","ordinal":289856,"en":"He surrounded the gate in an uproar,"},{"id":"semetey-2-2013:p1353:b005:l008","ordinal":289857,"en":"To reach and plunder"},{"id":"semetey-2-2013:p1353:b005:l009","ordinal":289858,"en":"The widowed, orphaned woman,"},{"id":"semetey-2-2013:p1353:b005:l010","ordinal":289859,"en":"And bring calamity upon her."},{"id":"semetey-2-2013:p1353:b005:l011","ordinal":289860,"en":"With his cruel design, Kanchoro"},{"id":"semetey-2-2013:p1353:b005:l012","ordinal":289861,"en":"Drove the countless troops without respite"},{"id":"semetey-2-2013:p1353:b005:l013","ordinal":289862,"en":"And gathered them together."},{"id":"semetey-2-2013:p1353:b005:l014","ordinal":289863,"en":"He beat down many without pause"},{"id":"semetey-2-2013:p1353:b005:l015","ordinal":289864,"en":"And slaughtered them."},{"id":"semetey-2-2013:p1353:b005:l016","ordinal":289865,"en":"Kanchoro's intention"},{"id":"semetey-2-2013:p1353:b005:l017","ordinal":289866,"en":"Was to plunder the palace."},{"id":"semetey-2-2013:p1353:b005:l018","ordinal":289867,"en":"Displaying all his cunning—"},{"id":"semetey-2-2013:p1353:b005:l019","ordinal":289868,"en":"Such was the dog-taken villain,"},{"id":"semetey-2-2013:p1353:b005:l020","ordinal":289869,"en":"Hiding his claws like a snow leopard,"},{"id":"semetey-2-2013:p1353:b005:l021","ordinal":289870,"en":"Displaying his valor against the foe."},{"id":"semetey-2-2013:p1353:b005:l022","ordinal":289871,"en":"Ah, accursed one whose road will fail,"},{"id":"semetey-2-2013:p1353:b005:l023","ordinal":289872,"en":"Hiding his claws like a tiger!"},{"id":"semetey-2-2013:p1353:b005:l024","ordinal":289873,"en":"Long ago, when the leopard entered battle"},{"id":"semetey-2-2013:p1353:b005:l025","ordinal":289874,"en":"And charged straight at the enemy,"},{"id":"semetey-2-2013:p1353:b005:l026","ordinal":289875,"en":"While the valiant gray wolf still lived,"},{"id":"semetey-2-2013:p1353:b005:l027","ordinal":289876,"en":"There was the famous great war drum."},{"id":"semetey-2-2013:p1353:b005:l028","ordinal":289877,"en":"Its hide was from a wild bull;"},{"id":"semetey-2-2013:p1353:b005:l029","ordinal":289878,"en":"Such was the drum's design."},{"id":"semetey-2-2013:p1353:b005:l030","ordinal":289879,"en":"When you hear its voice, flee far away."},{"id":"semetey-2-2013:p1353:b005:l031","ordinal":289880,"en":"Facing toward the enemy,"},{"id":"semetey-2-2013:p1353:b005:l032","ordinal":289881,"en":"Raising the fortunate spear,"},{"id":"semetey-2-2013:p1353:b005:l033","ordinal":289882,"en":"The hero beat it as he entered."},{"id":"semetey-2-2013:p1353:b005:l034","ordinal":289883,"en":"Ordinary foes"},{"id":"semetey-2-2013:p1353:b005:l035","ordinal":289884,"en":"Simply lost their courage."},{"id":"semetey-2-2013:p1353:b005:l036","ordinal":289885,"en":"That drum left by the hero"},{"id":"semetey-2-2013:p1353:b005:l037","ordinal":289886,"en":"Thundered again and again,"},{"id":"semetey-2-2013:p1353:b005:l038","ordinal":289887,"en":"And the army lost its wits."},{"id":"semetey-2-2013:p1353:b005:l039","ordinal":289888,"en":"The army lost all sense."},{"id":"semetey-2-2013:p1354:b003:l001","ordinal":289889,"en":"Kanchoro drove them on without respite."},{"id":"semetey-2-2013:p1354:b003:l002","ordinal":289890,"en":"At the gate with its steel posts,"},{"id":"semetey-2-2013:p1354:b003:l003","ordinal":289891,"en":"The keeper of the gate"},{"id":"semetey-2-2013:p1354:b003:l004","ordinal":289892,"en":"Met the flood and joined battle."},{"id":"semetey-2-2013:p1354:b003:l005","ordinal":289893,"en":"The khans who guarded the gate,"},{"id":"semetey-2-2013:p1354:b003:l006","ordinal":289894,"en":"The champions expressly placed"},{"id":"semetey-2-2013:p1354:b003:l007","ordinal":289895,"en":"By the bloodthirsty hero as sentries,"},{"id":"semetey-2-2013:p1354:b003:l008","ordinal":289896,"en":"The ablest of the guards,"},{"id":"semetey-2-2013:p1354:b003:l009","ordinal":289897,"en":"The strongest of the gatekeepers—"},{"id":"semetey-2-2013:p1354:b003:l010","ordinal":289898,"en":"Have you heard of them?"},{"id":"semetey-2-2013:p1354:b003:l011","ordinal":289899,"en":"With the lion Manas the leopard,"},{"id":"semetey-2-2013:p1354:b003:l012","ordinal":289900,"en":"That hero long since departed,"},{"id":"semetey-2-2013:p1354:b003:l013","ordinal":289901,"en":"With the gray-maned accomplished lion"},{"id":"semetey-2-2013:p1354:b003:l014","ordinal":289902,"en":"Who once shook the earth with myriad troops,"},{"id":"semetey-2-2013:p1354:b003:l015","ordinal":289903,"en":"He had been a friend unto the other world."},{"id":"semetey-2-2013:p1354:b003:l016","ordinal":289904,"en":"When he ate, he chewed iron;"},{"id":"semetey-2-2013:p1354:b003:l017","ordinal":289905,"en":"He spoke with the prophet David"},{"id":"semetey-2-2013:p1354:b003:l018","ordinal":289906,"en":"And forged from precious steel."},{"id":"semetey-2-2013:p1354:b003:l019","ordinal":289907,"en":"With hero Manas the lion,"},{"id":"semetey-2-2013:p1354:b003:l020","ordinal":289908,"en":"Their sheep shared one pen,"},{"id":"semetey-2-2013:p1354:b003:l021","ordinal":289909,"en":"Their meals one fellowship."},{"id":"semetey-2-2013:p1354:b003:l022","ordinal":289910,"en":"When his craftsmanship was heard of,"},{"id":"semetey-2-2013:p1354:b003:l023","ordinal":289911,"en":"Whatever Arkesken struck fitted true."},{"id":"semetey-2-2013:p1354:b003:l024","ordinal":289912,"en":"The people of Bakburchun"},{"id":"semetey-2-2013:p1354:b003:l025","ordinal":289913,"en":"Rejoiced in Bolokbai."},{"id":"semetey-2-2013:p1354:b003:l026","ordinal":289914,"en":"Bolokbai forged steel,"},{"id":"semetey-2-2013:p1354:b003:l027","ordinal":289915,"en":"And armed your great Khan Manas."},{"id":"semetey-2-2013:p1354:b003:l028","ordinal":289916,"en":"Hearing he was a champion smith,"},{"id":"semetey-2-2013:p1354:b003:l029","ordinal":289917,"en":"The people of Beijing were"},{"id":"semetey-2-2013:p1354:b003:l030","ordinal":289918,"en":"Left astonished."},{"id":"semetey-2-2013:p1354:b003:l031","ordinal":289919,"en":"When valiant Bolokbai died,"},{"id":"semetey-2-2013:p1354:b003:l032","ordinal":289920,"en":"The steadfast, true-tempered hero"},{"id":"semetey-2-2013:p1354:b003:l033","ordinal":289921,"en":"Received as a gift was Akzholtoi."},{"id":"semetey-2-2013:p1354:b003:l034","ordinal":289922,"en":"His courage was worth countless troops."},{"id":"semetey-2-2013:p1354:b003:l035","ordinal":289923,"en":"Agile on horseback and swift on foot,"},{"id":"semetey-2-2013:p1354:b003:l036","ordinal":289924,"en":"When he fought he wrought great havoc."},{"id":"semetey-2-2013:p1354:b003:l037","ordinal":289925,"en":"His valor was extraordinary,"},{"id":"semetey-2-2013:p1354:b003:l038","ordinal":289926,"en":"His wrestling strength immense."},{"id":"semetey-2-2013:p1354:b003:l039","ordinal":289927,"en":"When he thrust with a spear,"},{"id":"semetey-2-2013:p1354:b004:l001","ordinal":289928,"en":"He was surpassingly deft and tested."},{"id":"semetey-2-2013:p1354:b004:l002","ordinal":289929,"en":"For hero Semetey,"},{"id":"semetey-2-2013:p1354:b004:l003","ordinal":289930,"en":"He was the inheritance guarding the gate—"},{"id":"semetey-2-2013:p1354:b004:l004","ordinal":289931,"en":"Both wrestler and lion."},{"id":"semetey-2-2013:p1354:b004:l005","ordinal":289932,"en":"His marksmanship was also true;"},{"id":"semetey-2-2013:p1354:b004:l006","ordinal":289933,"en":"He knew Zhydymak and wielded a practiced blade."},{"id":"semetey-2-2013:p1354:b004:l007","ordinal":289934,"en":"That he had come was also true."},{"id":"semetey-2-2013:p1354:b004:l008","ordinal":289935,"en":"He was a prime example of a capable hero,"},{"id":"semetey-2-2013:p1354:b004:l009","ordinal":289936,"en":"The son of the smith Bolokbai."},{"id":"semetey-2-2013:p1354:b004:l010","ordinal":289937,"en":"At the gate stood Akzholtoi,"},{"id":"semetey-2-2013:p1354:b004:l011","ordinal":289938,"en":"When enraged, worth countless troops."},{"id":"semetey-2-2013:p1354:b004:l012","ordinal":289939,"en":"Kanchoro and Kiyaz's vast army"},{"id":"semetey-2-2013:p1354:b004:l013","ordinal":289940,"en":"Could not make him submit."},{"id":"semetey-2-2013:p1354:b004:l014","ordinal":289941,"en":"He would not cut down and surrender"},{"id":"semetey-2-2013:p1354:b004:l015","ordinal":289942,"en":"Widows, orphans, and old women to the foe."},{"id":"semetey-2-2013:p1354:b004:l016","ordinal":289943,"en":"They stood facing one another,"},{"id":"semetey-2-2013:p1354:b004:l017","ordinal":289944,"en":"Firing guns and drawing bows,"},{"id":"semetey-2-2013:p1354:b004:l018","ordinal":289945,"en":"Fighting with a crash."},{"id":"semetey-2-2013:p1354:b004:l019","ordinal":289946,"en":"Smoke trailed into the sky;"},{"id":"semetey-2-2013:p1354:b004:l020","ordinal":289947,"en":"They stood face to face."},{"id":"semetey-2-2013:p1354:b004:l021","ordinal":289948,"en":"Akzholtoi alone against that host"},{"id":"semetey-2-2013:p1354:b004:l022","ordinal":289949,"en":"Fought them with a crash."},{"id":"semetey-2-2013:p1354:b004:l023","ordinal":289950,"en":"The Zhediger flooded in and attacked,"},{"id":"semetey-2-2013:p1354:b004:l024","ordinal":289951,"en":"Striking without sparing life."},{"id":"semetey-2-2013:p1354:b004:l025","ordinal":289952,"en":"Those who met each other laid one another low;"},{"id":"semetey-2-2013:p1354:b004:l026","ordinal":289953,"en":"The wretched souls who entered battle"},{"id":"semetey-2-2013:p1354:b004:l027","ordinal":289954,"en":"Hung by half a hair."},{"id":"semetey-2-2013:p1354:b004:l028","ordinal":289955,"en":"Those whose death had come died,"},{"id":"semetey-2-2013:p1354:b004:l029","ordinal":289956,"en":"Meeting calamity and hardship,"},{"id":"semetey-2-2013:p1354:b004:l030","ordinal":289957,"en":"Ripping lungs and taking gallbladders,"},{"id":"semetey-2-2013:p1354:b004:l031","ordinal":289958,"en":"Shedding extraordinary blood."},{"id":"semetey-2-2013:p1354:b004:l032","ordinal":289959,"en":"Bolokbai's Akzholtoi,"},{"id":"semetey-2-2013:p1354:b004:l033","ordinal":289960,"en":"Whose renown was worth mighty hosts,"},{"id":"semetey-2-2013:p1354:b004:l034","ordinal":289961,"en":"The wisest master of counsel—"},{"id":"semetey-2-2013:p1354:b004:l035","ordinal":289962,"en":"Such was his excellence."},{"id":"semetey-2-2013:p1354:b004:l036","ordinal":289963,"en":"Long ago, his father, the smith Bolokbai,"},{"id":"semetey-2-2013:p1354:b004:l037","ordinal":289964,"en":"When Akzholtoi was a playful child,"},{"id":"semetey-2-2013:p1354:b004:l038","ordinal":289965,"en":"When he was a playful child,"},{"id":"semetey-2-2013:p1354:b004:l039","ordinal":289966,"en":"While his father was still alive,"},{"id":"semetey-2-2013:p1355:b003:l001","ordinal":289967,"en":"Had cherished him as a future son."},{"id":"semetey-2-2013:p1355:b003:l002","ordinal":289968,"en":"He taught him to recognize the Zhydymak watch,"},{"id":"semetey-2-2013:p1355:b003:l003","ordinal":289969,"en":"Trained him to shoot at targets."},{"id":"semetey-2-2013:p1355:b003:l004","ordinal":289970,"en":"Long ago, mighty gray-maned Semetey"},{"id":"semetey-2-2013:p1355:b003:l005","ordinal":289971,"en":"Equipped him with every weapon"},{"id":"semetey-2-2013:p1355:b003:l006","ordinal":289972,"en":"And made him khan of the gatekeepers."},{"id":"semetey-2-2013:p1355:b003:l007","ordinal":289973,"en":"A master marksman in battle,"},{"id":"semetey-2-2013:p1355:b003:l008","ordinal":289974,"en":"A surpassingly skillful servant,"},{"id":"semetey-2-2013:p1355:b003:l009","ordinal":289975,"en":"He stood facing"},{"id":"semetey-2-2013:p1355:b003:l010","ordinal":289976,"en":"Kanchoro and Khan Kiyaz,"},{"id":"semetey-2-2013:p1355:b003:l011","ordinal":289977,"en":"Firing guns and drawing bows,"},{"id":"semetey-2-2013:p1355:b003:l012","ordinal":289978,"en":"Fighting in bloody clashes."},{"id":"semetey-2-2013:p1355:b003:l013","ordinal":289979,"en":"Akzholtoi charged in and broke their ranks."},{"id":"semetey-2-2013:p1355:b003:l014","ordinal":289980,"en":"The nobles guarding the gate,"},{"id":"semetey-2-2013:p1355:b003:l015","ordinal":289981,"en":"The sentries standing watch,"},{"id":"semetey-2-2013:p1355:b003:l016","ordinal":289982,"en":"The keepers at the gateway—"},{"id":"semetey-2-2013:p1355:b003:l017","ordinal":289983,"en":"Many champions fell to bullets;"},{"id":"semetey-2-2013:p1355:b003:l018","ordinal":289984,"en":"Hardship and uproar arose."},{"id":"semetey-2-2013:p1355:b003:l019","ordinal":289985,"en":"Akzholtoi would not consent"},{"id":"semetey-2-2013:p1355:b003:l020","ordinal":289986,"en":"To the ruin of the people and sack of the palace,"},{"id":"semetey-2-2013:p1355:b003:l021","ordinal":289987,"en":"To leaving the nation open to plunder."},{"id":"semetey-2-2013:p1355:b003:l022","ordinal":289988,"en":"He would not surrender"},{"id":"semetey-2-2013:p1355:b003:l023","ordinal":289989,"en":"The widowed sister-in-law, the mourning woman,"},{"id":"semetey-2-2013:p1355:b003:l024","ordinal":289990,"en":"As spoil to the Zhediger."},{"id":"semetey-2-2013:p1355:b003:l025","ordinal":289991,"en":"Trusting in God, they stood,"},{"id":"semetey-2-2013:p1355:b003:l026","ordinal":289992,"en":"Split the ranks in two and fought."},{"id":"semetey-2-2013:p1355:b003:l027","ordinal":289993,"en":"Akzholtoi alone against that host"},{"id":"semetey-2-2013:p1355:b003:l028","ordinal":289994,"en":"Gave battle."},{"id":"semetey-2-2013:p1355:b003:l029","ordinal":289995,"en":"At Akzholtoi's side,"},{"id":"semetey-2-2013:p1355:b003:l030","ordinal":289996,"en":"Emil Chochmor the hero died;"},{"id":"semetey-2-2013:p1355:b003:l031","ordinal":289997,"en":"Egizey and Kocher died together;"},{"id":"semetey-2-2013:p1355:b003:l032","ordinal":289998,"en":"Akbalban, who swept the gate clean,"},{"id":"semetey-2-2013:p1355:b003:l033","ordinal":289999,"en":"Died, leaving no support."},{"id":"semetey-2-2013:p1355:b003:l034","ordinal":290000,"en":"Akzholtoi remained alone."},{"id":"semetey-2-2013:p1355:b003:l035","ordinal":290001,"en":"Kanchoro with his vast army"},{"id":"semetey-2-2013:p1355:b003:l036","ordinal":290002,"en":"Had begun his sweeping attack;"},{"id":"semetey-2-2013:p1355:b003:l037","ordinal":290003,"en":"Every one of the gatekeepers,"},{"id":"semetey-2-2013:p1355:b003:l038","ordinal":290004,"en":"The accursed traitor slaughtered."},{"id":"semetey-2-2013:p1355:b003:l039","ordinal":290005,"en":"Defending the gate,"},{"id":"semetey-2-2013:p1355:b005:l001","ordinal":290006,"en":"For seven days and nights,"},{"id":"semetey-2-2013:p1355:b005:l002","ordinal":290007,"en":"Akzholtoi refused to yield it"},{"id":"semetey-2-2013:p1355:b005:l003","ordinal":290008,"en":"And fought without rest for seven days."},{"id":"semetey-2-2013:p1355:b005:l004","ordinal":290009,"en":"When seven days were complete,"},{"id":"semetey-2-2013:p1355:b005:l005","ordinal":290010,"en":"Akzholtoi's means were exhausted."},{"id":"semetey-2-2013:p1355:b005:l006","ordinal":290011,"en":"He had no strength left to fight;"},{"id":"semetey-2-2013:p1355:b005:l007","ordinal":290012,"en":"Bullets filled the space around him."},{"id":"semetey-2-2013:p1355:b005:l008","ordinal":290013,"en":"He had no strong back to rely on,"},{"id":"semetey-2-2013:p1355:b005:l009","ordinal":290014,"en":"No hero in whom to place hope."},{"id":"semetey-2-2013:p1355:b005:l010","ordinal":290015,"en":"The beloved Kulchoro,"},{"id":"semetey-2-2013:p1355:b005:l011","ordinal":290016,"en":"His liver an ember, his dearest support,"},{"id":"semetey-2-2013:p1355:b005:l012","ordinal":290017,"en":"He had no supporting friend;"},{"id":"semetey-2-2013:p1355:b005:l013","ordinal":290018,"en":"Even if Akzholtoi died now,"},{"id":"semetey-2-2013:p1355:b005:l014","ordinal":290019,"en":"His elder Khan Bakai was absent."},{"id":"semetey-2-2013:p1355:b005:l015","ordinal":290020,"en":"Gray-maned Semetey, who had protected him,"},{"id":"semetey-2-2013:p1355:b005:l016","ordinal":290021,"en":"Was absent too."},{"id":"semetey-2-2013:p1355:b005:l017","ordinal":290022,"en":"Valiant marksman Akzholtoi"},{"id":"semetey-2-2013:p1355:b005:l018","ordinal":290023,"en":"Had no charger to catch and mount,"},{"id":"semetey-2-2013:p1355:b005:l019","ordinal":290024,"en":"No bloodthirsty khan to protect him."},{"id":"semetey-2-2013:p1355:b005:l020","ordinal":290025,"en":"Mane and tail were wholly gone."},{"id":"semetey-2-2013:p1355:b005:l021","ordinal":290026,"en":"His heart burned, his liver was ember;"},{"id":"semetey-2-2013:p1355:b005:l022","ordinal":290027,"en":"His hands boiled with fury,"},{"id":"semetey-2-2013:p1355:b005:l023","ordinal":290028,"en":"Strength came to his flylike soul."},{"id":"semetey-2-2013:p1355:b005:l024","ordinal":290029,"en":"Unable to endure it, Akzholtoi"},{"id":"semetey-2-2013:p1355:b005:l025","ordinal":290030,"en":"Fought without rest for seven days,"},{"id":"semetey-2-2013:p1355:b005:l026","ordinal":290031,"en":"Receiving wounds in seven places."},{"id":"semetey-2-2013:p1355:b005:l027","ordinal":290032,"en":"His whole body was torn;"},{"id":"semetey-2-2013:p1355:b005:l028","ordinal":290033,"en":"Every bone ached and throbbed."},{"id":"semetey-2-2013:p1355:b005:l029","ordinal":290034,"en":"The two bloodthirsty khans, Kiyaz and Kanchoro,"},{"id":"semetey-2-2013:p1355:b005:l030","ordinal":290035,"en":"Flooded in with a roar."},{"id":"semetey-2-2013:p1355:b005:l031","ordinal":290036,"en":"The world narrowed in his anguish;"},{"id":"semetey-2-2013:p1355:b005:l032","ordinal":290037,"en":"Akzholtoi stood humiliated."},{"id":"semetey-2-2013:p1355:b005:l033","ordinal":290038,"en":"He longed for a single swallow"},{"id":"semetey-2-2013:p1355:b005:l034","ordinal":290039,"en":"Of saliva sweet as sugar;"},{"id":"semetey-2-2013:p1355:b005:l035","ordinal":290040,"en":"His palate dried and hardened,"},{"id":"semetey-2-2013:p1355:b005:l036","ordinal":290041,"en":"His eyes stared wide."},{"id":"semetey-2-2013:p1355:b005:l037","ordinal":290042,"en":"All the bones of his body"},{"id":"semetey-2-2013:p1355:b005:l038","ordinal":290043,"en":"Sagged as though he were dying;"},{"id":"semetey-2-2013:p1355:b005:l039","ordinal":290044,"en":"His body was crushed and bloody."},{"id":"semetey-2-2013:p1356:b003:l001","ordinal":290045,"en":"His two hands, once his greatest servants,"},{"id":"semetey-2-2013:p1356:b003:l002","ordinal":290046,"en":"Hung paralyzed and would not rise."},{"id":"semetey-2-2013:p1356:b003:l003","ordinal":290047,"en":"The Zhediger fought and quarreled,"},{"id":"semetey-2-2013:p1356:b003:l004","ordinal":290048,"en":"Inflicting humiliation,"}]
