[{"id":"semetey-1-2013:p0891:b005:l006","ordinal":145153,"en":"A person all alone—"},{"id":"semetey-1-2013:p0891:b005:l007","ordinal":145154,"en":"Why not refrain from creating one?"},{"id":"semetey-1-2013:p0891:b005:l008","ordinal":145155,"en":"I have no mane or tail at all;"},{"id":"semetey-1-2013:p0891:b005:l009","ordinal":145156,"en":"I am like a wild ass."},{"id":"semetey-1-2013:p0891:b005:l010","ordinal":145157,"en":"I have no foot to swing forward;"},{"id":"semetey-1-2013:p0891:b005:l011","ordinal":145158,"en":"I am like a snake!"},{"id":"semetey-1-2013:p0891:b005:l012","ordinal":145159,"en":"I have no swift steed but Buurul."},{"id":"semetey-1-2013:p0891:b005:l013","ordinal":145160,"en":"World that makes me grieve, may you never prosper!"},{"id":"semetey-1-2013:p0891:b005:l014","ordinal":145161,"en":"Nor have I a kinsman to resolve my grief."},{"id":"semetey-1-2013:p0891:b005:l016","ordinal":145162,"en":"When I go to the front, there is no supporting figure;"},{"id":"semetey-1-2013:p0891:b005:l017","ordinal":145163,"en":"If I lead against the Kara-Khitai,"},{"id":"semetey-1-2013:p0891:b005:l018","ordinal":145164,"en":"To follow like a shadow,"},{"id":"semetey-1-2013:p0891:b005:l019","ordinal":145165,"en":"There is no supporting figure behind me."},{"id":"semetey-1-2013:p0891:b005:l020","ordinal":145166,"en":"The pine is alone; I am alone."},{"id":"semetey-1-2013:p0891:b005:l021","ordinal":145167,"en":"My khan father Manas, do not die!"},{"id":"semetey-1-2013:p0891:b005:l022","ordinal":145168,"en":"Black night falls upon my head;"},{"id":"semetey-1-2013:p0891:b005:l023","ordinal":145169,"en":"Wretched soul, may you never know grief!"},{"id":"semetey-1-2013:p0891:b005:l024","ordinal":145170,"en":"May the good of this world never die;"},{"id":"semetey-1-2013:p0891:b005:l025","ordinal":145171,"en":"May the bad not remain behind!"},{"id":"semetey-1-2013:p0891:b005:l026","ordinal":145172,"en":"Whose every step becomes a deep hollow—"},{"id":"semetey-1-2013:p0891:b005:l027","ordinal":145173,"en":"Is there anyone as sorrowful as I?"},{"id":"semetey-1-2013:p0891:b005:l028","ordinal":145174,"en":"Whose own kinsmen become enemies—"},{"id":"semetey-1-2013:p0891:b005:l029","ordinal":145175,"en":"Is there anyone as ill-fated as I?"},{"id":"semetey-1-2013:p0891:b005:l030","ordinal":145176,"en":"Ordinary iron will not become steel,"},{"id":"semetey-1-2013:p0891:b005:l031","ordinal":145177,"en":"Wretched world, what can I do?"},{"id":"semetey-1-2013:p0891:b005:l032","ordinal":145178,"en":"Dogs raised apart will not become my people!"},{"id":"semetey-1-2013:p0891:b005:l033","ordinal":145179,"en":"Pieced-together iron does not become steel;"},{"id":"semetey-1-2013:p0891:b005:l034","ordinal":145180,"en":"Ruined world, what can I do?"},{"id":"semetey-1-2013:p0891:b005:l035","ordinal":145181,"en":"Mad dogs will not become my people!"},{"id":"semetey-1-2013:p0891:b005:l036","ordinal":145182,"en":"From the ledge upon the cliffside,"},{"id":"semetey-1-2013:p0891:b005:l037","ordinal":145183,"en":"My Creator and Lord, what can I do?"},{"id":"semetey-1-2013:p0891:b005:l038","ordinal":145184,"en":"You made me the only one in the nest!”"},{"id":"semetey-1-2013:p0891:b005:l039","ordinal":145185,"en":"He gathered his wits and grew calm."},{"id":"semetey-1-2013:p0892:b003:l001","ordinal":145186,"en":"His heart boiled into embers."},{"id":"semetey-1-2013:p0892:b003:l002","ordinal":145187,"en":"Helpless, that orphan"},{"id":"semetey-1-2013:p0892:b003:l003","ordinal":145188,"en":"Lamented his elder kinsmen."},{"id":"semetey-1-2013:p0892:b003:l004","ordinal":145189,"en":"“I have no supporting figure, no sign;"},{"id":"semetey-1-2013:p0892:b003:l005","ordinal":145190,"en":"I am like a bare hill."},{"id":"semetey-1-2013:p0892:b003:l006","ordinal":145191,"en":"In my playful childhood,"},{"id":"semetey-1-2013:p0892:b003:l007","ordinal":145192,"en":"Have I shot and eaten a wild duck?"},{"id":"semetey-1-2013:p0892:b003:l008","ordinal":145193,"en":"With my own kinsmen turned against me,"},{"id":"semetey-1-2013:p0892:b003:l009","ordinal":145194,"en":"Almighty Allah, Creator,"},{"id":"semetey-1-2013:p0892:b003:l010","ordinal":145195,"en":"Did you decree that I should suffer torment?”"},{"id":"semetey-1-2013:p0892:b003:l011","ordinal":145196,"en":"Manas’s only son—"},{"id":"semetey-1-2013:p0892:b003:l012","ordinal":145197,"en":"His heart was deeply troubled;"},{"id":"semetey-1-2013:p0892:b003:l013","ordinal":145198,"en":"Many worries fell upon his head,"},{"id":"semetey-1-2013:p0892:b003:l014","ordinal":145199,"en":"Tears poured from his eyes."},{"id":"semetey-1-2013:p0892:b003:l015","ordinal":145200,"en":"Bounding on Aktelki,"},{"id":"semetey-1-2013:p0892:b003:l016","ordinal":145201,"en":"With sixty marksmen beside him,"},{"id":"semetey-1-2013:p0892:b003:l017","ordinal":145202,"en":"Abyke came into view."},{"id":"semetey-1-2013:p0892:b003:l018","ordinal":145203,"en":"When he saw Abyke,"},{"id":"semetey-1-2013:p0892:b003:l019","ordinal":145204,"en":"The gray belt left by Manas"},{"id":"semetey-1-2013:p0892:b003:l020","ordinal":145205,"en":"He unfastened and hung about his neck."},{"id":"semetey-1-2013:p0892:b003:l021","ordinal":145206,"en":"Leading the horse Buurul,"},{"id":"semetey-1-2013:p0892:b003:l022","ordinal":145207,"en":"Bowing his head, Semetey"},{"id":"semetey-1-2013:p0892:b003:l023","ordinal":145208,"en":"Pleaded with Abyke:"},{"id":"semetey-1-2013:p0892:b003:l024","ordinal":145209,"en":"“Buurul is yours to buy; I am your gift."},{"id":"semetey-1-2013:p0892:b003:l025","ordinal":145210,"en":"Do not make me grieve, uncle; heed my words!"},{"id":"semetey-1-2013:p0892:b003:l026","ordinal":145211,"en":"Let me turn my neck toward truth;"},{"id":"semetey-1-2013:p0892:b003:l027","ordinal":145212,"en":"Let me offer my mother Kanykei to you!"},{"id":"semetey-1-2013:p0892:b003:l028","ordinal":145213,"en":"I shall give you your choice of horses:"},{"id":"semetey-1-2013:p0892:b003:l029","ordinal":145214,"en":"Take my beast, such as Arbuudan."},{"id":"semetey-1-2013:p0892:b003:l030","ordinal":145215,"en":"If you need it, uncle,"},{"id":"semetey-1-2013:p0892:b003:l031","ordinal":145216,"en":"Pour my blood into a flask and take it!"},{"id":"semetey-1-2013:p0892:b003:l032","ordinal":145217,"en":"Be my support when I climb upward;"},{"id":"semetey-1-2013:p0892:b003:l033","ordinal":145218,"en":"Be my prop when I descend!"},{"id":"semetey-1-2013:p0892:b003:l034","ordinal":145219,"en":"Uncle, do not send your army against me;"},{"id":"semetey-1-2013:p0892:b003:l035","ordinal":145220,"en":"Do not bring misery upon me!"},{"id":"semetey-1-2013:p0892:b003:l036","ordinal":145221,"en":"The orphan who has come fleeing—"},{"id":"semetey-1-2013:p0892:b003:l037","ordinal":145222,"en":"Abyke, do not make me perform a spectacle!"},{"id":"semetey-1-2013:p0892:b003:l038","ordinal":145223,"en":"I moved from Bukhara, seeking a supporting figure;"},{"id":"semetey-1-2013:p0892:b003:l039","ordinal":145224,"en":"I returned to this place,"},{"id":"semetey-1-2013:p0892:b004:l001","ordinal":145225,"en":"Calling Abyke and Kobosh my shelter."},{"id":"semetey-1-2013:p0892:b004:l002","ordinal":145226,"en":"Turn back, uncle, and be my kin;"},{"id":"semetey-1-2013:p0892:b004:l003","ordinal":145227,"en":"Do not corrupt my blood,"},{"id":"semetey-1-2013:p0892:b004:l004","ordinal":145228,"en":"Do not set my soul afire!”"},{"id":"semetey-1-2013:p0892:b004:l005","ordinal":145229,"en":"As the orphan stood with head bowed,"},{"id":"semetey-1-2013:p0892:b004:l006","ordinal":145230,"en":"That scoundrel Abyke"},{"id":"semetey-1-2013:p0892:b004:l007","ordinal":145231,"en":"God struck down still further."},{"id":"semetey-1-2013:p0892:b004:l008","ordinal":145232,"en":"Look at the haze, look at the embers!"},{"id":"semetey-1-2013:p0892:b004:l009","ordinal":145233,"en":"Sixty champions and Abyke"},{"id":"semetey-1-2013:p0892:b004:l010","ordinal":145234,"en":"Fired their shots like hail;"},{"id":"semetey-1-2013:p0892:b004:l011","ordinal":145235,"en":"Look at the bright red bullets!"},{"id":"semetey-1-2013:p0892:b004:l012","ordinal":145236,"en":"With every shot, Semetey"},{"id":"semetey-1-2013:p0892:b004:l013","ordinal":145237,"en":"Did not move, did not stir;"},{"id":"semetey-1-2013:p0892:b004:l014","ordinal":145238,"en":"The blessed orphan did not budge."},{"id":"semetey-1-2013:p0892:b004:l015","ordinal":145239,"en":"Not merely Abyke—against the boy,"},{"id":"semetey-1-2013:p0892:b004:l016","ordinal":145240,"en":"Even a flood could not prevail."},{"id":"semetey-1-2013:p0892:b004:l017","ordinal":145241,"en":"His fortune was complete."},{"id":"semetey-1-2013:p0892:b004:l018","ordinal":145242,"en":"If you looked into his heart,"},{"id":"semetey-1-2013:p0892:b004:l019","ordinal":145243,"en":"It was wider than the whole world."},{"id":"semetey-1-2013:p0892:b004:l020","ordinal":145244,"en":"If you looked at him,"},{"id":"semetey-1-2013:p0892:b004:l021","ordinal":145245,"en":"He was a lion protected by Shai,"},{"id":"semetey-1-2013:p0892:b004:l022","ordinal":145246,"en":"His fortune was complete."},{"id":"semetey-1-2013:p0892:b004:l023","ordinal":145247,"en":"No mortal could face him,"},{"id":"semetey-1-2013:p0892:b004:l024","ordinal":145248,"en":"He spared no foe who grappled with him;"},{"id":"semetey-1-2013:p0892:b004:l025","ordinal":145249,"en":"In all eighteen thousand worlds,"},{"id":"semetey-1-2013:p0892:b004:l026","ordinal":145250,"en":"No one remained to turn back his lasso."},{"id":"semetey-1-2013:p0892:b004:l027","ordinal":145251,"en":"When the marksmen fired together,"},{"id":"semetey-1-2013:p0892:b004:l028","ordinal":145252,"en":"When they brought him torment,"},{"id":"semetey-1-2013:p0892:b004:l029","ordinal":145253,"en":"Without looking up or down,"},{"id":"semetey-1-2013:p0892:b004:l030","ordinal":145254,"en":"Without thinking he might die,"},{"id":"semetey-1-2013:p0892:b004:l031","ordinal":145255,"en":"Without looking around,"},{"id":"semetey-1-2013:p0892:b004:l032","ordinal":145256,"en":"Without sparing his life,"},{"id":"semetey-1-2013:p0892:b004:l033","ordinal":145257,"en":"From tireless Buurul"},{"id":"semetey-1-2013:p0892:b004:l034","ordinal":145258,"en":"When the orphan mounted and rode forth,"},{"id":"semetey-1-2013:p0892:b004:l035","ordinal":145259,"en":"The sixty champions, one by one,"},{"id":"semetey-1-2013:p0892:b004:l036","ordinal":145260,"en":"Trembled, finding no way out;"},{"id":"semetey-1-2013:p0892:b004:l037","ordinal":145261,"en":"Their world shriveled away."},{"id":"semetey-1-2013:p0892:b004:l038","ordinal":145262,"en":"When they saw the boy’s wrath,"},{"id":"semetey-1-2013:p0892:b004:l039","ordinal":145263,"en":"“We have died before our appointed death,” they said,"},{"id":"semetey-1-2013:p0893:b003:l001","ordinal":145264,"en":"“We have seen the other world,” they cried;"},{"id":"semetey-1-2013:p0893:b003:l002","ordinal":145265,"en":"The sixty champions, one by one,"},{"id":"semetey-1-2013:p0893:b003:l003","ordinal":145266,"en":"Fled trembling in every direction."},{"id":"semetey-1-2013:p0893:b003:l004","ordinal":145267,"en":"Abyke upon Aktelki,"},{"id":"semetey-1-2013:p0893:b003:l005","ordinal":145268,"en":"When he saw the boy’s appearance,"},{"id":"semetey-1-2013:p0893:b003:l006","ordinal":145269,"en":"Could not regain his composure:"},{"id":"semetey-1-2013:p0893:b003:l007","ordinal":145270,"en":"“Thick-armed, stone-hearted,"},{"id":"semetey-1-2013:p0893:b003:l008","ordinal":145271,"en":"That elephant-built brute,"},{"id":"semetey-1-2013:p0893:b003:l009","ordinal":145272,"en":"He is a hero who knows no fear."},{"id":"semetey-1-2013:p0893:b003:l010","ordinal":145273,"en":"His Holiness Aaly the Lion—"},{"id":"semetey-1-2013:p0893:b003:l011","ordinal":145274,"en":"His strength equals his!"},{"id":"semetey-1-2013:p0893:b003:l012","ordinal":145275,"en":"If I contend with this orphan,"},{"id":"semetey-1-2013:p0893:b003:l013","ordinal":145276,"en":"He will flatten me to the earth like a hare."},{"id":"semetey-1-2013:p0893:b003:l014","ordinal":145277,"en":"With his fearsome painted spear,"},{"id":"semetey-1-2013:p0893:b003:l015","ordinal":145278,"en":"Suddenly striking and overturning me,"},{"id":"semetey-1-2013:p0893:b003:l016","ordinal":145279,"en":"Will he not soak its tassel in blood?"},{"id":"semetey-1-2013:p0893:b003:l017","ordinal":145280,"en":"The sight troubles the heart;"},{"id":"semetey-1-2013:p0893:b003:l018","ordinal":145281,"en":"Fierce, leopard Manas—"},{"id":"semetey-1-2013:p0893:b003:l019","ordinal":145282,"en":"He looks exactly like him."},{"id":"semetey-1-2013:p0893:b003:l020","ordinal":145283,"en":"From every ridge, the forty chiltens"},{"id":"semetey-1-2013:p0893:b003:l021","ordinal":145284,"en":"Come together to support him."},{"id":"semetey-1-2013:p0893:b003:l022","ordinal":145285,"en":"A black-spotted leopard"},{"id":"semetey-1-2013:p0893:b003:l023","ordinal":145286,"en":"Pounces beside him."},{"id":"semetey-1-2013:p0893:b003:l024","ordinal":145287,"en":"Was wisdom itself."},{"id":"semetey-1-2013:p0893:b003:l025","ordinal":145288,"en":"Kydyr Iliyas, that blessed being,"},{"id":"semetey-1-2013:p0893:b003:l026","ordinal":145289,"en":"Has taken him under mighty protection."},{"id":"semetey-1-2013:p0893:b003:l027","ordinal":145290,"en":"His forty lion champions"},{"id":"semetey-1-2013:p0893:b003:l028","ordinal":145291,"en":"Have surrounded him."},{"id":"semetey-1-2013:p0893:b003:l029","ordinal":145292,"en":"A boy of this kind—"},{"id":"semetey-1-2013:p0893:b003:l030","ordinal":145293,"en":"No one can do him harm."},{"id":"semetey-1-2013:p0893:b003:l031","ordinal":145294,"en":"Not merely a mortal, good heavens—"},{"id":"semetey-1-2013:p0893:b003:l032","ordinal":145295,"en":"Even a flood could not overwhelm him."},{"id":"semetey-1-2013:p0893:b003:l033","ordinal":145296,"en":"The wrathful orphan’s"},{"id":"semetey-1-2013:p0893:b003:l034","ordinal":145297,"en":"Words I did not heed."},{"id":"semetey-1-2013:p0893:b003:l035","ordinal":145298,"en":"I have been a fool,"},{"id":"semetey-1-2013:p0893:b003:l036","ordinal":145299,"en":"Not knowing I would die.”"},{"id":"semetey-1-2013:p0893:b003:l037","ordinal":145300,"en":"Thinking this, Abyke—"},{"id":"semetey-1-2013:p0893:b003:l038","ordinal":145301,"en":"His rib bones trembled;"},{"id":"semetey-1-2013:p0893:b003:l039","ordinal":145302,"en":"His shit-filled bowels quaked."},{"id":"semetey-1-2013:p0893:b004:l001","ordinal":145303,"en":"Your elder Abyke’s"},{"id":"semetey-1-2013:p0893:b004:l002","ordinal":145304,"en":"The weapon slipped from his hand,"},{"id":"semetey-1-2013:p0893:b004:l003","ordinal":145305,"en":"His heart lurched with fear:"},{"id":"semetey-1-2013:p0893:b004:l004","ordinal":145306,"en":"“The orphan son of the ocean—"},{"id":"semetey-1-2013:p0893:b004:l005","ordinal":145307,"en":"Why should I contend with him?"},{"id":"semetey-1-2013:p0893:b004:l006","ordinal":145308,"en":"Without enduring this any longer,"},{"id":"semetey-1-2013:p0893:b004:l007","ordinal":145309,"en":"Let me enter Andijan.”"},{"id":"semetey-1-2013:p0893:b004:l008","ordinal":145310,"en":"He gave the drum a stroke;"},{"id":"semetey-1-2013:p0893:b004:l009","ordinal":145311,"en":"Your brave uncle Abyke"},{"id":"semetey-1-2013:p0893:b004:l010","ordinal":145312,"en":"Struck Aktelki once."},{"id":"semetey-1-2013:p0893:b004:l011","ordinal":145313,"en":"Turning aside, your uncle"},{"id":"semetey-1-2013:p0893:b004:l012","ordinal":145314,"en":"Fled in haste, urging his horse."},{"id":"semetey-1-2013:p0893:b004:l013","ordinal":145315,"en":"Abyke fled in panic;"},{"id":"semetey-1-2013:p0893:b004:l014","ordinal":145316,"en":"Would the steed Arbuudan let him go?"},{"id":"semetey-1-2013:p0893:b004:l015","ordinal":145317,"en":"Semetey pursued, leaning back."},{"id":"semetey-1-2013:p0893:b004:l016","ordinal":145318,"en":"“You have slaughtered Kobosh!”"},{"id":"semetey-1-2013:p0893:b004:l017","ordinal":145319,"en":"Abyke fled away resentfully."},{"id":"semetey-1-2013:p0893:b004:l018","ordinal":145320,"en":"Semetey came behind,"},{"id":"semetey-1-2013:p0893:b004:l019","ordinal":145321,"en":"Pleading, “Uncle!”"},{"id":"semetey-1-2013:p0893:b004:l020","ordinal":145322,"en":"Baby, put down two of me, take one of me,"},{"id":"semetey-1-2013:p0893:b004:l021","ordinal":145323,"en":"Leave my file, take my whetstone."},{"id":"semetey-1-2013:p0893:b004:l022","ordinal":145324,"en":"Do not cast black night upon my head;"},{"id":"semetey-1-2013:p0893:b004:l023","ordinal":145325,"en":"Alas, uncle, heed my words!"},{"id":"semetey-1-2013:p0893:b004:l024","ordinal":145326,"en":"Do not be foolish; stop a while."},{"id":"semetey-1-2013:p0893:b004:l025","ordinal":145327,"en":"Alas, my uncle, take my mother!"},{"id":"semetey-1-2013:p0893:b004:l026","ordinal":145328,"en":"Do not blacken my face."},{"id":"semetey-1-2013:p0893:b004:l027","ordinal":145329,"en":"‘He could not honor his elder;"},{"id":"semetey-1-2013:p0893:b004:l028","ordinal":145330,"en":"The orphan is uncouth,’ they will say."},{"id":"semetey-1-2013:p0893:b004:l029","ordinal":145331,"en":"Do not expose my face to the enemy!”"},{"id":"semetey-1-2013:p0893:b004:l030","ordinal":145332,"en":"He did not heed the words."},{"id":"semetey-1-2013:p0893:b004:l031","ordinal":145333,"en":"Semetey went on pleading;"},{"id":"semetey-1-2013:p0893:b004:l032","ordinal":145334,"en":"Abyke did not listen."},{"id":"semetey-1-2013:p0893:b004:l033","ordinal":145335,"en":"Over ridge after rugged ridge"},{"id":"semetey-1-2013:p0893:b004:l034","ordinal":145336,"en":"He crossed and went on."},{"id":"semetey-1-2013:p0893:b004:l035","ordinal":145337,"en":"Aktelki was a swift steed;"},{"id":"semetey-1-2013:p0893:b004:l036","ordinal":145338,"en":"Abyke, raising clouds of dust,"},{"id":"semetey-1-2013:p0893:b004:l037","ordinal":145339,"en":"Kept fleeing away."},{"id":"semetey-1-2013:p0893:b004:l038","ordinal":145340,"en":"Beneath him was Arbuurul,"},{"id":"semetey-1-2013:p0893:b004:l039","ordinal":145341,"en":"The offspring of Jelkaiyp,"},{"id":"semetey-1-2013:p0894:b003:l001","ordinal":145342,"en":"The wind could not catch his trotting pace;"},{"id":"semetey-1-2013:p0894:b003:l002","ordinal":145343,"en":"He was a fully perfected noble steed."},{"id":"semetey-1-2013:p0894:b003:l003","ordinal":145344,"en":"Arbu from Arbu"},{"id":"semetey-1-2013:p0894:b003:l004","ordinal":145345,"en":"Maiden Saikal’s Alkara—"},{"id":"semetey-1-2013:p0894:b003:l005","ordinal":145346,"en":"He was its own sibling."},{"id":"semetey-1-2013:p0894:b003:l006","ordinal":145347,"en":"My learning, my book of lessons,"},{"id":"semetey-1-2013:p0894:b003:l007","ordinal":145348,"en":"Do not ask of Buurul’s qualities;"},{"id":"semetey-1-2013:p0894:b003:l008","ordinal":145349,"en":"He was this lord’s wings."},{"id":"semetey-1-2013:p0894:b003:l009","ordinal":145350,"en":"If a wild creature with legs ran,"},{"id":"semetey-1-2013:p0894:b003:l010","ordinal":145351,"en":"He would trample past it."},{"id":"semetey-1-2013:p0894:b003:l011","ordinal":145352,"en":"When he headed downward,"},{"id":"semetey-1-2013:p0894:b003:l012","ordinal":145353,"en":"He lengthened his stride like a wild sheep."},{"id":"semetey-1-2013:p0894:b003:l013","ordinal":145354,"en":"When the hero leaned upon him,"},{"id":"semetey-1-2013:p0894:b003:l014","ordinal":145355,"en":"He reddened his eyes like a wild ram."},{"id":"semetey-1-2013:p0894:b003:l015","ordinal":145356,"en":"He had wings upon his flanks;"},{"id":"semetey-1-2013:p0894:b003:l016","ordinal":145357,"en":"Whenever he was freely given his head,"},{"id":"semetey-1-2013:p0894:b003:l017","ordinal":145358,"en":"He was accustomed to fly."},{"id":"semetey-1-2013:p0894:b003:l018","ordinal":145359,"en":"His basic form was this:"},{"id":"semetey-1-2013:p0894:b003:l019","ordinal":145360,"en":"A sparse tail and little mane,"},{"id":"semetey-1-2013:p0894:b003:l020","ordinal":145361,"en":"A high back and low stature."},{"id":"semetey-1-2013:p0894:b003:l021","ordinal":145362,"en":"If you asked of his broad rump,"},{"id":"semetey-1-2013:p0894:b003:l022","ordinal":145363,"en":"It was like an overturned cauldron."},{"id":"semetey-1-2013:p0894:b003:l023","ordinal":145364,"en":"His muscles were like a child."},{"id":"semetey-1-2013:p0894:b003:l024","ordinal":145365,"en":"Of this precious beast Buurul,"},{"id":"semetey-1-2013:p0894:b003:l025","ordinal":145366,"en":"The space between his hind thighs was like a ravine."},{"id":"semetey-1-2013:p0894:b003:l026","ordinal":145367,"en":"If you looked at his white teeth,"},{"id":"semetey-1-2013:p0894:b003:l027","ordinal":145368,"en":"They were like tempered steel."},{"id":"semetey-1-2013:p0894:b003:l028","ordinal":145369,"en":"As the horse Buurul went on,"},{"id":"semetey-1-2013:p0894:b003:l029","ordinal":145370,"en":"The black steel bit"},{"id":"semetey-1-2013:p0894:b003:l030","ordinal":145371,"en":"Clattered deep in his mouth."},{"id":"semetey-1-2013:p0894:b003:l031","ordinal":145372,"en":"His great hooves, like bowls,"},{"id":"semetey-1-2013:p0894:b003:l032","ordinal":145373,"en":"Cracked upon the earth when he pawed."},{"id":"semetey-1-2013:p0894:b003:l033","ordinal":145374,"en":"Tossing his forelock to the sky,"},{"id":"semetey-1-2013:p0894:b003:l034","ordinal":145375,"en":"His tail, like strands of silk,"},{"id":"semetey-1-2013:p0894:b003:l035","ordinal":145376,"en":"He slapped against his thighs."},{"id":"semetey-1-2013:p0894:b003:l036","ordinal":145377,"en":"The horse Buurul went on."},{"id":"semetey-1-2013:p0894:b003:l037","ordinal":145378,"en":"Whenever the creature ran,"},{"id":"semetey-1-2013:p0894:b003:l038","ordinal":145379,"en":"The face of the world trembled;"},{"id":"semetey-1-2013:p0894:b003:l039","ordinal":145380,"en":"His mane and his tail"},{"id":"semetey-1-2013:p0894:b004:l001","ordinal":145381,"en":"Streamed separately, strand by strand."},{"id":"semetey-1-2013:p0894:b004:l002","ordinal":145382,"en":"Dust billowed at his feet."},{"id":"semetey-1-2013:p0894:b004:l003","ordinal":145383,"en":"When he trod upon black stone,"},{"id":"semetey-1-2013:p0894:b004:l004","ordinal":145384,"en":"It crumbled to meal."},{"id":"semetey-1-2013:p0894:b004:l005","ordinal":145385,"en":"Iron-hoofed, copper-legged,"},{"id":"semetey-1-2013:p0894:b004:l006","ordinal":145386,"en":"The horse Buurul, never sweating,"},{"id":"semetey-1-2013:p0894:b004:l007","ordinal":145387,"en":"Reached Abyke's Telki"},{"id":"semetey-1-2013:p0894:b004:l008","ordinal":145388,"en":"Before an arrow could."},{"id":"semetey-1-2013:p0894:b004:l009","ordinal":145389,"en":"As he reached him and drew alongside,"},{"id":"semetey-1-2013:p0894:b004:l010","ordinal":145390,"en":"Khan Manas’s only son,"},{"id":"semetey-1-2013:p0894:b004:l011","ordinal":145391,"en":"Semetey, raised his spear:"},{"id":"semetey-1-2013:p0894:b004:l012","ordinal":145392,"en":"“My uncle Abyke—"},{"id":"semetey-1-2013:p0894:b004:l013","ordinal":145393,"en":"Let me frighten him,"},{"id":"semetey-1-2013:p0894:b004:l014","ordinal":145394,"en":"Let me somehow seize him."},{"id":"semetey-1-2013:p0894:b004:l015","ordinal":145395,"en":"To make him a shelter for my head,"},{"id":"semetey-1-2013:p0894:b004:l016","ordinal":145396,"en":"Let me cherish him."},{"id":"semetey-1-2013:p0894:b004:l017","ordinal":145397,"en":"Taking him to Talas,"},{"id":"semetey-1-2013:p0894:b004:l018","ordinal":145398,"en":"Over Argyn and Kyrgyz,"},{"id":"semetey-1-2013:p0894:b004:l019","ordinal":145399,"en":"My elder Abyke"},{"id":"semetey-1-2013:p0894:b004:l020","ordinal":145400,"en":"Let me raise as khan."},{"id":"semetey-1-2013:p0894:b004:l021","ordinal":145401,"en":"Let me level my spear to frighten him;"},{"id":"semetey-1-2013:p0894:b004:l022","ordinal":145402,"en":"Let me try this stratagem.”"},{"id":"semetey-1-2013:p0894:b004:l023","ordinal":145403,"en":"Toward the edge of his coat’s front,"},{"id":"semetey-1-2013:p0894:b004:l024","ordinal":145404,"en":"Toward the face of its skirt,"},{"id":"semetey-1-2013:p0894:b004:l025","ordinal":145405,"en":"Lord Semetey then"},{"id":"semetey-1-2013:p0894:b004:l026","ordinal":145406,"en":"Thrust aside as he passed."},{"id":"semetey-1-2013:p0894:b004:l027","ordinal":145407,"en":"The oath struck the oath-accursed man;"},{"id":"semetey-1-2013:p0894:b004:l028","ordinal":145408,"en":"Striking higher, the painted spear"}]
