[{"id":"sayakbay-ms-current144:pdf031:l023","ordinal":389889,"en":"They raised an unheard-of clamor,"},{"id":"sayakbay-ms-current144:pdf031:l024","ordinal":389890,"en":"Not one but thousands spoke,"},{"id":"sayakbay-ms-current144:pdf031:l025","ordinal":389891,"en":"Bringing slander and strife upon me,"},{"id":"sayakbay-ms-current144:pdf031:l026","ordinal":389892,"en":"He was great among the Chinese,"},{"id":"sayakbay-ms-current144:pdf031:l027","ordinal":389893,"en":"My grandfather Kalcha, the lionlike hero,"},{"id":"sayakbay-ms-current144:pdf031:l028","ordinal":389894,"en":"Among the Chinese in ceremonial robes,"},{"id":"sayakbay-ms-current144:pdf031:l029","ordinal":389895,"en":"They had never seen such a warrior born,"},{"id":"sayakbay-ms-current144:pdf031:l030","ordinal":389896,"en":"[The troublesome Kyrgyz saw him?],"},{"id":"sayakbay-ms-current144:pdf031:l031","ordinal":389897,"en":"Killing him like a dog,"},{"id":"sayakbay-ms-current144:pdf031:l032","ordinal":389898,"en":"The Kyrgyz brought about his end."},{"id":"sayakbay-ms-current144:pdf032:l001","ordinal":389899,"en":"[Ankam?] died after my grandfather,"},{"id":"sayakbay-ms-current144:pdf032:l002","ordinal":389900,"en":"His son was Semetey,"},{"id":"sayakbay-ms-current144:pdf032:l003","ordinal":389901,"en":"Making Ala-Too his homeland,"},{"id":"sayakbay-ms-current144:pdf032:l004","ordinal":389902,"en":"Semetey, beyond his father,"},{"id":"sayakbay-ms-current144:pdf032:l005","ordinal":389903,"en":"Was born a greater warrior,"},{"id":"sayakbay-ms-current144:pdf032:l006","ordinal":389904,"en":"The Burut fought among themselves,"},{"id":"sayakbay-ms-current144:pdf032:l007","ordinal":389905,"en":"Claiming what did not exist,"},{"id":"sayakbay-ms-current144:pdf032:l009","ordinal":389906,"en":"Taking [clods?] from the ground,"},{"id":"sayakbay-ms-current144:pdf032:l010","ordinal":389907,"en":"No enemy had come to besiege them,"},{"id":"sayakbay-ms-current144:pdf032:l011","ordinal":389908,"en":"They battled among themselves,"},{"id":"sayakbay-ms-current144:pdf032:l012","ordinal":389909,"en":"From caravan traders I heard,"},{"id":"sayakbay-ms-current144:pdf032:l013","ordinal":389910,"en":"That Semetey had died,"},{"id":"sayakbay-ms-current144:pdf032:l015","ordinal":389911,"en":"They saw brave Seytek,"},{"id":"sayakbay-ms-current144:pdf032:l016","ordinal":389912,"en":"Becoming equal to the whole world,"},{"id":"sayakbay-ms-current144:pdf032:l017","ordinal":389913,"en":"Seytek emerged a warrior,"},{"id":"sayakbay-ms-current144:pdf032:l018","ordinal":389914,"en":"That bride, a fairy woman,"},{"id":"sayakbay-ms-current144:pdf032:l019","ordinal":389915,"en":"Keeping a court and becoming khan,"},{"id":"sayakbay-ms-current144:pdf032:l020","ordinal":389916,"en":"Sarybai came against him,"},{"id":"sayakbay-ms-current144:pdf032:l021","ordinal":389917,"en":"The furious one was laid low,"},{"id":"sayakbay-ms-current144:pdf032:l022","ordinal":389918,"en":"They say he became a great champion,"},{"id":"sayakbay-ms-current144:pdf032:l023","ordinal":389919,"en":"Settled in his homeland, they say,"},{"id":"sayakbay-ms-current144:pdf032:l024","ordinal":389920,"en":"[His babbling words split heads?],"},{"id":"sayakbay-ms-current144:pdf032:l025","ordinal":389921,"en":"The accursed one's descendant,"},{"id":"sayakbay-ms-current144:pdf032:l026","ordinal":389922,"en":"Multiplied like grass in spring,"},{"id":"sayakbay-ms-current144:pdf032:l027","ordinal":389923,"en":"[Women, men, males and dogs?],"},{"id":"sayakbay-ms-current144:pdf032:l028","ordinal":389924,"en":"He slew the people of Itaaly,"},{"id":"sayakbay-ms-current144:pdf032:l029","ordinal":389925,"en":"[They were enemies who turned against him?],"},{"id":"sayakbay-ms-current144:pdf032:l030","ordinal":389926,"en":"When he advanced, causing slaughter,"},{"id":"sayakbay-ms-current144:pdf032:l031","ordinal":389927,"en":"To the sons of mortals on earth,"},{"id":"sayakbay-ms-current144:pdf032:l032","ordinal":389928,"en":"Are the Kyrgyz favored by God?"},{"id":"sayakbay-ms-current144:pdf033:l001","ordinal":389929,"en":"They say he caused complete turmoil,"},{"id":"sayakbay-ms-current144:pdf033:l002","ordinal":389930,"en":"From his might, blood flowed,"},{"id":"sayakbay-ms-current144:pdf033:l004","ordinal":389931,"en":"He turns level ground into ridges,"},{"id":"sayakbay-ms-current144:pdf033:l006","ordinal":389932,"en":"Will bring trouble to Beijing,"},{"id":"sayakbay-ms-current144:pdf033:l007","ordinal":389933,"en":"Let us build an enclosure,"},{"id":"sayakbay-ms-current144:pdf033:l008","ordinal":389934,"en":"Let us strengthen [its hollows?],"},{"id":"sayakbay-ms-current144:pdf033:l009","ordinal":389935,"en":"Whoever opposes this,"},{"id":"sayakbay-ms-current144:pdf033:l010","ordinal":389936,"en":"Let us slay them all, sparing none,"},{"id":"sayakbay-ms-current144:pdf033:l011","ordinal":389937,"en":"Scorning all his guards,"},{"id":"sayakbay-ms-current144:pdf033:l012","ordinal":389938,"en":"Blocking his approach,"},{"id":"sayakbay-ms-current144:pdf033:l013","ordinal":389939,"en":"Let us kill those we meet,"},{"id":"sayakbay-ms-current144:pdf033:l014","ordinal":389940,"en":"Let us make his road of stone,"},{"id":"sayakbay-ms-current144:pdf033:l015","ordinal":389941,"en":"Let us [impose a duty upon Beijing?],"},{"id":"sayakbay-ms-current144:pdf033:l016","ordinal":389942,"en":"Against fiery, swift Seytek,"},{"id":"sayakbay-ms-current144:pdf033:l017","ordinal":389943,"en":"My people, let us protect our lives thus,"},{"id":"sayakbay-ms-current144:pdf033:l018","ordinal":389944,"en":"When marching against a nation,"},{"id":"sayakbay-ms-current144:pdf033:l019","ordinal":389945,"en":"At the [black-tongued season of horses?],"},{"id":"sayakbay-ms-current144:pdf033:l020","ordinal":389946,"en":"When the people camp in the foothills,"},{"id":"sayakbay-ms-current144:pdf033:l021","ordinal":389947,"en":"The horses stirring in a clamor,"},{"id":"sayakbay-ms-current144:pdf033:l022","ordinal":389948,"en":"When the khan is at summer pasture,"},{"id":"sayakbay-ms-current144:pdf033:l023","ordinal":389949,"en":"Unflinching when struck by a sword,"},{"id":"sayakbay-ms-current144:pdf033:l024","ordinal":389950,"en":"Unmoving when struck by a spear,"},{"id":"sayakbay-ms-current144:pdf033:l025","ordinal":389951,"en":"Never panicking at sight of enemies,"},{"id":"sayakbay-ms-current144:pdf033:l026","ordinal":389952,"en":"Never fleeing an encounter,"},{"id":"sayakbay-ms-current144:pdf033:l027","ordinal":389953,"en":"From the shadows in darkness,"},{"id":"sayakbay-ms-current144:pdf033:l028","ordinal":389954,"en":"Never straying from the trail,"},{"id":"sayakbay-ms-current144:pdf033:l029","ordinal":389955,"en":"Among skilled pathfinders,"},{"id":"sayakbay-ms-current144:pdf033:l030","ordinal":389956,"en":"Among the wisest and finest,"},{"id":"sayakbay-ms-current144:pdf033:l031","ordinal":389957,"en":"[Who does not evade approaching death?],"},{"id":"sayakbay-ms-current144:pdf033:l032","ordinal":389958,"en":"If ninety hardships come at once,"},{"id":"sayakbay-ms-current144:pdf034:l001","ordinal":389959,"en":"Who does not scatter and flee,"},{"id":"sayakbay-ms-current144:pdf034:l002","ordinal":389960,"en":"Among the keen and knowledgeable,"},{"id":"sayakbay-ms-current144:pdf034:l003","ordinal":389961,"en":"[Who survives in the thicket?],"},{"id":"sayakbay-ms-current144:pdf034:l004","ordinal":389962,"en":"From the tower with a bell,"},{"id":"sayakbay-ms-current144:pdf034:l005","ordinal":389963,"en":"From Beijing full of warriors,"},{"id":"sayakbay-ms-current144:pdf034:l006","ordinal":389964,"en":"What guards shall we post?"},{"id":"sayakbay-ms-current144:pdf034:l007","ordinal":389965,"en":"Having sorcerers test them,"},{"id":"sayakbay-ms-current144:pdf034:l008","ordinal":389966,"en":"[Having the unheeding examined?],"},{"id":"sayakbay-ms-current144:pdf034:l009","ordinal":389967,"en":"Having heroes observe them,"},{"id":"sayakbay-ms-current144:pdf034:l010","ordinal":389968,"en":"Having champions shake them,"},{"id":"sayakbay-ms-current144:pdf034:l011","ordinal":389969,"en":"Having the agile seize them,"},{"id":"sayakbay-ms-current144:pdf034:l012","ordinal":389970,"en":"Whether they are heroes or lions,"},{"id":"sayakbay-ms-current144:pdf034:l013","ordinal":389971,"en":"Having the sages determine it."},{"id":"sayakbay-ms-current144:pdf034:l014","ordinal":389972,"en":"If they are heroes and lions,"},{"id":"sayakbay-ms-current144:pdf034:l015","ordinal":389973,"en":"Our people, forty Chinese tribes,"},{"id":"sayakbay-ms-current144:pdf034:l016","ordinal":389974,"en":"Even after forty years of slaughter,"},{"id":"sayakbay-ms-current144:pdf034:l017","ordinal":389975,"en":"The Chinese people do not falter,"},{"id":"sayakbay-ms-current144:pdf034:l018","ordinal":389976,"en":"The great people of [different bearing?],"},{"id":"sayakbay-ms-current144:pdf034:l019","ordinal":389977,"en":"Numerous as countless black insects,"},{"id":"sayakbay-ms-current144:pdf034:l020","ordinal":389978,"en":"Without troubling the people again,"},{"id":"sayakbay-ms-current144:pdf034:l021","ordinal":389979,"en":"Let us appoint them as champions,"},{"id":"sayakbay-ms-current144:pdf034:l022","ordinal":389980,"en":"Guarding the multitude,"},{"id":"sayakbay-ms-current144:pdf034:l023","ordinal":389981,"en":"Let us post many guards,"},{"id":"sayakbay-ms-current144:pdf034:l024","ordinal":389982,"en":"Let us slay those who fight,"},{"id":"sayakbay-ms-current144:pdf034:l025","ordinal":389983,"en":"Gnawing those encountered,"},{"id":"sayakbay-ms-current144:pdf034:l026","ordinal":389984,"en":"Let us cut down those we meet,"},{"id":"sayakbay-ms-current144:pdf034:l027","ordinal":389985,"en":"Let us give the strong talismans,"},{"id":"sayakbay-ms-current144:pdf034:l028","ordinal":389986,"en":"The champions and lionlike men,"},{"id":"sayakbay-ms-current144:pdf034:l029","ordinal":389987,"en":"From great Beijing's treasury,"},{"id":"sayakbay-ms-current144:pdf034:l030","ordinal":389988,"en":"Let us maintain them by tribute,"},{"id":"sayakbay-ms-current144:pdf034:l031","ordinal":389989,"en":"If the Kyrgyz are weak,"},{"id":"sayakbay-ms-current144:pdf034:l032","ordinal":389990,"en":"Hearing word from messengers,"},{"id":"sayakbay-ms-current144:pdf035:l008","ordinal":389991,"en":"Taking from [the fortified place?],"},{"id":"sayakbay-ms-current144:pdf035:l009","ordinal":389992,"en":"From here, the Chinese against the Kyrgyz,"},{"id":"sayakbay-ms-current144:pdf035:l010","ordinal":389993,"en":"Let us anger them [without showing ourselves?],"},{"id":"sayakbay-ms-current144:pdf035:l011","ordinal":389994,"en":"If we meet, let us start a fight,"},{"id":"sayakbay-ms-current144:pdf035:l012","ordinal":389995,"en":"[So they are utterly cut down?],"},{"id":"sayakbay-ms-current144:pdf035:l013","ordinal":389996,"en":"Let us kill and take revenge,"},{"id":"sayakbay-ms-current144:pdf035:l014","ordinal":389997,"en":"Are my words sound, he asked,"},{"id":"sayakbay-ms-current144:pdf035:l019","ordinal":389998,"en":"Venom issued from his mouth,"},{"id":"sayakbay-ms-current144:pdf036:l008","ordinal":389999,"en":"Of imposing, valiant Kite,"},{"id":"sayakbay-ms-current144:pdf037:l029","ordinal":390000,"en":"We stand ready for your command,"},{"id":"sayakbay-ms-current144:pdf038:l004","ordinal":390001,"en":"Yielding his strength to no one,"},{"id":"sayakbay-ms-current144:pdf038:l007","ordinal":390002,"en":"Black-bellied and blue-backed,"},{"id":"sayakbay-ms-current144:pdf038:l009","ordinal":390003,"en":"They say the most resolute of mortals,"},{"id":"sayakbay-ms-current144:pdf038:l010","ordinal":390004,"en":"His prowess and lionlike valor,"},{"id":"sayakbay-ms-current144:pdf038:l015","ordinal":390005,"en":"They say he is a consummate warrior,"},{"id":"sayakbay-ms-current144:pdf038:l018","ordinal":390006,"en":"If he is a hero and a lion,"},{"id":"sayakbay-ms-current144:pdf038:l019","ordinal":390007,"en":"Let us observe his true worth,"},{"id":"sayakbay-ms-current144:pdf038:l020","ordinal":390008,"en":"Without quarreling or causing strife,"},{"id":"sayakbay-ms-current144:pdf038:l021","ordinal":390009,"en":"Let us ride safely along the road,"},{"id":"sayakbay-ms-current144:pdf038:l022","ordinal":390010,"en":"Dear Kite, we shall say,"},{"id":"sayakbay-ms-current144:pdf038:l023","ordinal":390011,"en":"Of those accursed Burut,"},{"id":"sayakbay-ms-current144:pdf038:l024","ordinal":390012,"en":"Let us return and tell the news,"},{"id":"sayakbay-ms-current144:pdf039:l003","ordinal":390013,"en":"We shall learn from messengers,"},{"id":"sayakbay-ms-current144:pdf039:l004","ordinal":390014,"en":"If he is boastful and deficient,"},{"id":"sayakbay-ms-current144:pdf039:l005","ordinal":390015,"en":"[We shall slit his blue bull?],"},{"id":"sayakbay-ms-current144:pdf039:l006","ordinal":390016,"en":"Destroying the giant Seytek,"},{"id":"sayakbay-ms-current144:pdf039:l007","ordinal":390017,"en":"[Breaking through alone, Beijing …],"},{"id":"sayakbay-ms-current144:pdf039:l008","ordinal":390018,"en":"[We shall bring some of them out?],"},{"id":"sayakbay-ms-current144:pdf039:l009","ordinal":390019,"en":"Leaving his lineage bereft,"},{"id":"sayakbay-ms-current144:pdf039:l010","ordinal":390020,"en":"His fine, swaying young lords,"},{"id":"sayakbay-ms-current144:pdf039:l011","ordinal":390021,"en":"Driving them all away as slaves,"},{"id":"sayakbay-ms-current144:pdf039:l012","ordinal":390022,"en":"[We shall strike his leadership?],"},{"id":"sayakbay-ms-current144:pdf039:l013","ordinal":390023,"en":"Allowing no whispered news to escape,"},{"id":"sayakbay-ms-current144:pdf039:l014","ordinal":390024,"en":"If he is a lion like his father,"},{"id":"sayakbay-ms-current144:pdf039:l015","ordinal":390025,"en":"If he grapples and fights,"},{"id":"sayakbay-ms-current144:pdf039:l016","ordinal":390026,"en":"Beyond human strength to overcome,"},{"id":"sayakbay-ms-current144:pdf039:l017","ordinal":390027,"en":"[If shooting leaves us empty-handed?],"},{"id":"sayakbay-ms-current144:pdf039:l019","ordinal":390028,"en":"Mighty in menace, potent in venom,"},{"id":"sayakbay-ms-current144:pdf039:l020","ordinal":390029,"en":"If he is a cunning lion,"},{"id":"sayakbay-ms-current144:pdf039:l021","ordinal":390030,"en":"We shall travel the lower slopes,"},{"id":"sayakbay-ms-current144:pdf039:l022","ordinal":390031,"en":"We shall separate and turn back,"},{"id":"sayakbay-ms-current144:pdf039:l023","ordinal":390032,"en":"Crossing [moonlit heights?] and stony ground,"},{"id":"sayakbay-ms-current144:pdf039:l024","ordinal":390033,"en":"We shall ride a safe road,"},{"id":"sayakbay-ms-current144:pdf039:l025","ordinal":390034,"en":"Telling how great his menace is,"},{"id":"sayakbay-ms-current144:pdf039:l026","ordinal":390035,"en":"We shall return to describe his deeds,"},{"id":"sayakbay-ms-current144:pdf039:l028","ordinal":390036,"en":"You are sovereign, Kite; heed my words,"},{"id":"sayakbay-ms-current144:pdf039:l029","ordinal":390037,"en":"The enemy you would fight is formidable,"},{"id":"sayakbay-ms-current144:pdf040:l005","ordinal":390038,"en":"Those who fought them never returned,"},{"id":"sayakbay-ms-current144:pdf040:l026","ordinal":390039,"en":"Speaking quietly but firmly,"},{"id":"sayakbay-ms-current144:pdf040:l028","ordinal":390040,"en":"Chongbilgich began his speech,"},{"id":"sayakbay-ms-current144:pdf040:l030","ordinal":390041,"en":"He was a champion and a lion."},{"id":"sayakbay-ms-current144:pdf041:l019","ordinal":390042,"en":"Brave Seytek, born of a hero,"},{"id":"sayakbay-ms-current144:pdf041:l025","ordinal":390043,"en":"[Never satisfied with seeking deeds?],"},{"id":"sayakbay-ms-current144:pdf041:l026","ordinal":390044,"en":"Never abandoning their eagerness,"},{"id":"sayakbay-ms-current144:pdf041:l027","ordinal":390045,"en":"At talk of battle and enemies,"},{"id":"sayakbay-ms-current144:pdf042:l004","ordinal":390046,"en":"Roe deer cry among the rocks,"},{"id":"sayakbay-ms-current144:pdf042:l012","ordinal":390047,"en":"Grazing over nine hills,"},{"id":"sayakbay-ms-current144:pdf042:l028","ordinal":390048,"en":"When caught in his wrath,"},{"id":"sayakbay-ms-current144:pdf043:l011","ordinal":390049,"en":"Was an exceedingly difficult undertaking,"},{"id":"sayakbay-ms-current144:pdf043:l013","ordinal":390050,"en":"That faithless world,"},{"id":"sayakbay-ms-current144:pdf043:l016","ordinal":390051,"en":"Many people went about grieving,"},{"id":"sayakbay-ms-current144:pdf043:l023","ordinal":390052,"en":"He tested [those fit for the journey?],"},{"id":"sayakbay-ms-current144:pdf043:l027","ordinal":390053,"en":"Saying, this one will do,"},{"id":"sayakbay-ms-current144:pdf044:l011","ordinal":390054,"en":"Making a clamor no mortal would forget,"},{"id":"sayakbay-ms-current144:pdf044:l015","ordinal":390055,"en":"The reins and bridle,"},{"id":"sayakbay-ms-current144:pdf044:l018","ordinal":390056,"en":"He became sovereign,"},{"id":"sayakbay-ms-current144:pdf045:l002","ordinal":390057,"en":"Rounding Kaspan's dark mountain,"},{"id":"sayakbay-ms-current144:pdf045:l006","ordinal":390058,"en":"Fog billowed apart,"},{"id":"sayakbay-ms-current144:pdf045:l008","ordinal":390059,"en":"Lest people discover them,"},{"id":"sayakbay-ms-current144:pdf045:l025","ordinal":390060,"en":"Animals and living creatures,"},{"id":"sayakbay-ms-current144:pdf046:l008","ordinal":390061,"en":"There were scouts among them too,"},{"id":"sayakbay-ms-current144:pdf046:l026","ordinal":390062,"en":"The trouser legs stood out distinctly,"},{"id":"sayakbay-ms-current144:pdf046:l027","ordinal":390063,"en":"Chasing wild asses, shooting mountain goats,"},{"id":"sayakbay-ms-current144:pdf047:l005","ordinal":390064,"en":"Between thirty and forty-eight,"},{"id":"sayakbay-ms-current144:pdf047:l006","ordinal":390065,"en":"His age lay between them,"},{"id":"sayakbay-ms-current144:pdf047:l007","ordinal":390066,"en":"[That hollowed, raging brute?],"},{"id":"sayakbay-ms-current144:pdf047:l008","ordinal":390067,"en":"His head was like a cooking cauldron,"},{"id":"sayakbay-ms-current144:pdf047:l009","ordinal":390068,"en":"His eyebrows like a reclining dog,"},{"id":"sayakbay-ms-current144:pdf047:l011","ordinal":390069,"en":"[Like a fist of the craggy mountain?],"},{"id":"sayakbay-ms-current144:pdf047:l012","ordinal":390070,"en":"[Unresolved description of the warrior's bearing.],"},{"id":"sayakbay-ms-current144:pdf047:l014","ordinal":390071,"en":"The infidel's pipe was unusual,"},{"id":"sayakbay-ms-current144:pdf047:l015","ordinal":390072,"en":"[Such was this knowledgeable champion?],"},{"id":"sayakbay-ms-current144:pdf047:l016","ordinal":390073,"en":"Those setting out to scout,"},{"id":"sayakbay-ms-current144:pdf047:l017","ordinal":390074,"en":"Their strength and lionlike valor,"},{"id":"sayakbay-ms-current144:pdf047:l018","ordinal":390075,"en":"Prepared in Kakanchy,"},{"id":"sayakbay-ms-current144:pdf047:l023","ordinal":390076,"en":"Rejoicing at the mention of death,"},{"id":"sayakbay-ms-current144:pdf047:l026","ordinal":390077,"en":"Dark junipers along Kaspan,"},{"id":"sayakbay-ms-current144:pdf048:l001","ordinal":390078,"en":"Following along Karshan,"},{"id":"sayakbay-ms-current144:pdf048:l004","ordinal":390079,"en":"Tiring their horses and scouting the land,"},{"id":"sayakbay-ms-current144:pdf048:l006","ordinal":390080,"en":"Chasing wild asses, shooting mountain goats,"},{"id":"sayakbay-ms-current144:pdf048:l021","ordinal":390081,"en":"Taking no day's respite,"},{"id":"sayakbay-ms-current144:pdf049:l002","ordinal":390082,"en":"The affair became terribly difficult,"},{"id":"sayakbay-ms-current144:pdf049:l017","ordinal":390083,"en":"Every animal and living creature,"},{"id":"sayakbay-ms-current144:pdf049:l023","ordinal":390084,"en":"Among all created mortal beings,"},{"id":"sayakbay-ms-current144:pdf049:l024","ordinal":390085,"en":"There had been no hardship like it,"},{"id":"sayakbay-ms-current144:pdf049:l026","ordinal":390086,"en":"People traveling at night,"},{"id":"sayakbay-ms-current144:pdf050:l013","ordinal":390087,"en":"Facing a terribly difficult road,"},{"id":"sayakbay-ms-current144:pdf050:l014","ordinal":390088,"en":"[Its crossings tormented them?],"},{"id":"sayakbay-ms-current144:pdf050:l020","ordinal":390089,"en":"The wide world became narrow,"},{"id":"sayakbay-ms-current144:pdf050:l021","ordinal":390090,"en":"All the level ground,"},{"id":"sayakbay-ms-current144:pdf050:l025","ordinal":390091,"en":"Escaping the perilous road,"},{"id":"sayakbay-ms-current144:pdf051:l003","ordinal":390092,"en":"Scouting the slopes and choosing mountains,"},{"id":"sayakbay-ms-current144:pdf051:l018","ordinal":390093,"en":"Those he fixed upon were laid low,"},{"id":"sayakbay-ms-current144:pdf051:l019","ordinal":390094,"en":"Ten generations of forefathers were khans,"},{"id":"sayakbay-ms-current144:pdf051:l020","ordinal":390095,"en":"God made his endeavors prosper,"},{"id":"sayakbay-ms-current144:pdf051:l021","ordinal":390096,"en":"[The way's saint, the elder master,]"},{"id":"sayakbay-ms-current144:pdf051:l022","ordinal":390097,"en":"Kydyr and Ilyas opened his fortune,"},{"id":"sayakbay-ms-current144:pdf051:l023","ordinal":390098,"en":"[His head was formed of silver,]"},{"id":"sayakbay-ms-current144:pdf051:l024","ordinal":390099,"en":"Fashioned out of marvels,"},{"id":"sayakbay-ms-current144:pdf051:l025","ordinal":390100,"en":"[His battle cry won over peoples,]"},{"id":"sayakbay-ms-current144:pdf051:l026","ordinal":390101,"en":"Kydyr never ceased to bless him."},{"id":"sayakbay-ms-current144:pdf052:l004","ordinal":390102,"en":"A remnant of pure steel,"},{"id":"sayakbay-ms-current144:pdf052:l014","ordinal":390103,"en":"When they incurred his wrath,"},{"id":"sayakbay-ms-current144:pdf052:l016","ordinal":390104,"en":"Many enemies directed their malice at him;"},{"id":"sayakbay-ms-current144:pdf052:l024","ordinal":390105,"en":"Kunansur, who came from the fairies,"},{"id":"sayakbay-ms-current144:pdf053:l009","ordinal":390106,"en":"[A joining of three joined parts,]"},{"id":"sayakbay-ms-current144:pdf053:l015","ordinal":390107,"en":"Its walk like a wolf's trot."},{"id":"sayakbay-ms-current144:pdf053:l019","ordinal":390108,"en":"Unless some dark misfortune befell,"},{"id":"sayakbay-ms-current144:pdf053:l021","ordinal":390109,"en":"Kunansur, the swift noble warhorse,"},{"id":"sayakbay-ms-current144:pdf053:l026","ordinal":390110,"en":"Kunansur, beautifully formed,"},{"id":"sayakbay-ms-current144:pdf054:l009","ordinal":390111,"en":"For ten days Seytek made no move,"},{"id":"sayakbay-ms-current144:pdf054:l013","ordinal":390112,"en":"[Having come endowed with wonders,]"},{"id":"sayakbay-ms-current144:pdf054:l014","ordinal":390113,"en":"Had become queen of the fairy folk."},{"id":"sayakbay-ms-current144:pdf054:l015","ordinal":390114,"en":"A maiden sovereign, a valiant girl,"},{"id":"sayakbay-ms-current144:pdf054:l016","ordinal":390115,"en":"One whose desires God granted,"},{"id":"sayakbay-ms-current144:pdf054:l017","ordinal":390116,"en":"One who attained what she sought,"},{"id":"sayakbay-ms-current144:pdf054:l018","ordinal":390117,"en":"[Her honor surpassed the purest,]"},{"id":"sayakbay-ms-current144:pdf054:l019","ordinal":390118,"en":"[Foremost among women,]"},{"id":"sayakbay-ms-current144:pdf054:l020","ordinal":390119,"en":"[She discerned with wondrous wisdom,]"},{"id":"sayakbay-ms-current144:pdf054:l021","ordinal":390120,"en":"She rinsed her mouth with butter,"},{"id":"sayakbay-ms-current144:pdf054:l022","ordinal":390121,"en":"Most wise and discerning,"},{"id":"sayakbay-ms-current144:pdf054:l024","ordinal":390122,"en":"Troubles six months distant,"},{"id":"sayakbay-ms-current144:pdf054:l025","ordinal":390123,"en":"She perceived in thought from afar."},{"id":"sayakbay-ms-current144:pdf054:l027","ordinal":390124,"en":"The cold wind of whitening dawn,"},{"id":"sayakbay-ms-current144:pdf054:l028","ordinal":390125,"en":"[When it struck with a chill,]"},{"id":"sayakbay-ms-current144:pdf054:l029","ordinal":390126,"en":"[At the twig's tip, chirping,]"},{"id":"sayakbay-ms-current144:pdf054:l030","ordinal":390127,"en":"The reeds sang and quivered."},{"id":"sayakbay-ms-current144:pdf055:l001","ordinal":390128,"en":"When dawn began to break,"},{"id":"sayakbay-ms-current144:pdf055:l002","ordinal":390129,"en":"Waking with a start from sleep,"},{"id":"sayakbay-ms-current144:pdf055:l003","ordinal":390130,"en":"She hurried in a fierce mood,"},{"id":"sayakbay-ms-current144:pdf055:l004","ordinal":390131,"en":"Put on her clothes and straightened them,"},{"id":"sayakbay-ms-current144:pdf055:l005","ordinal":390132,"en":"Dipped her hands into water,"},{"id":"sayakbay-ms-current144:pdf055:l007","ordinal":390133,"en":"She appealed to his ancestral spirit:"},{"id":"sayakbay-ms-current144:pdf055:l008","ordinal":390134,"en":"The only child left by the hero—"},{"id":"sayakbay-ms-current144:pdf055:l009","ordinal":390135,"en":"What would become of him?"},{"id":"sayakbay-ms-current144:pdf055:l010","ordinal":390136,"en":"Through wondrous power she knew,"},{"id":"sayakbay-ms-current144:pdf055:l011","ordinal":390137,"en":"The unfortunate, imperfect mortal."},{"id":"sayakbay-ms-current144:pdf055:l012","ordinal":390138,"en":"Its back was gold, its sleeves brass,"},{"id":"sayakbay-ms-current144:pdf055:l013","ordinal":390139,"en":"Half a cubit in thickness,"},{"id":"sayakbay-ms-current144:pdf055:l015","ordinal":390140,"en":"For facing the enemy alone,"},{"id":"sayakbay-ms-current144:pdf055:l016","ordinal":390141,"en":"[For the wretched sufferer, the holy night,]"},{"id":"sayakbay-ms-current144:pdf055:l017","ordinal":390142,"en":"[Such a day is never created,]"},{"id":"sayakbay-ms-current144:pdf055:l018","ordinal":390143,"en":"For the leopard-like hero Seytek,"},{"id":"sayakbay-ms-current144:pdf055:l019","ordinal":390144,"en":"So an enemy encountering him might see,"}]
