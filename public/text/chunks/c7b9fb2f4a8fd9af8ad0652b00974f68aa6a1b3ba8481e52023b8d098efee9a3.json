[{"id":"semetey-1-2013:p0622:b003:l032","ordinal":124161,"en":"Was a foal from there too."},{"id":"semetey-1-2013:p0622:b003:l033","ordinal":124162,"en":"Warrior Koshoi's Kuu Kazyk"},{"id":"semetey-1-2013:p0622:b003:l034","ordinal":124163,"en":"Was a foal from there too."},{"id":"semetey-1-2013:p0622:b003:l035","ordinal":124164,"en":"Warrior Syrgak's Kokchebich"},{"id":"semetey-1-2013:p0622:b003:l036","ordinal":124165,"en":"Was a foal from there too."},{"id":"semetey-1-2013:p0622:b003:l037","ordinal":124166,"en":"Kokotoy's Maaniker"},{"id":"semetey-1-2013:p0622:b003:l038","ordinal":124167,"en":"Was a foal from there too."},{"id":"semetey-1-2013:p0622:b003:l039","ordinal":124168,"en":"Azhibai's Kartkurong"},{"id":"semetey-1-2013:p0622:b004:l001","ordinal":124169,"en":"Was a foal from there as well."},{"id":"semetey-1-2013:p0622:b004:l002","ordinal":124170,"en":"The two girls rode him and fell to bullets—"},{"id":"semetey-1-2013:p0622:b004:l003","ordinal":124171,"en":"Telkyzyl, ridden on scouting missions,"},{"id":"semetey-1-2013:p0622:b004:l004","ordinal":124172,"en":"Was a foal from there as well."},{"id":"semetey-1-2013:p0622:b004:l005","ordinal":124173,"en":"Long ago, turning his neck like a stag,"},{"id":"semetey-1-2013:p0622:b004:l006","ordinal":124174,"en":"If a ditch a bowshot wide appeared,"},{"id":"semetey-1-2013:p0622:b004:l007","ordinal":124175,"en":"He raced on without hesitation."},{"id":"semetey-1-2013:p0622:b004:l008","ordinal":124176,"en":"Knowing him to be a splendid steed,"},{"id":"semetey-1-2013:p0622:b004:l009","ordinal":124177,"en":"Offering poods of gold and jewels,"},{"id":"semetey-1-2013:p0622:b004:l010","ordinal":124178,"en":"Whoever came asked for him."},{"id":"semetey-1-2013:p0622:b004:l011","ordinal":124179,"en":"He was not given to those who asked."},{"id":"semetey-1-2013:p0622:b004:l012","ordinal":124180,"en":"Far from giving him to them,"},{"id":"semetey-1-2013:p0622:b004:l013","ordinal":124181,"en":"No one without ritual ablution rode him."},{"id":"semetey-1-2013:p0622:b004:l014","ordinal":124182,"en":"A karabair, a noble steed,"},{"id":"semetey-1-2013:p0622:b004:l015","ordinal":124183,"en":"With sieve-like lungs and bronze forelegs,"},{"id":"semetey-1-2013:p0622:b004:l016","ordinal":124184,"en":"Chosen and set apart for you,"},{"id":"semetey-1-2013:p0622:b004:l017","ordinal":124185,"en":"Your very own Taibuurul"},{"id":"semetey-1-2013:p0622:b004:l018","ordinal":124186,"en":"Was a foal from there too."},{"id":"semetey-1-2013:p0622:b004:l019","ordinal":124187,"en":"Long ago, your father Khan Manas,"},{"id":"semetey-1-2013:p0622:b004:l020","ordinal":124188,"en":"Wearing out horses and scouting the land,"},{"id":"semetey-1-2013:p0622:b004:l021","ordinal":124189,"en":"Loosing hounds and flying hawks,"},{"id":"semetey-1-2013:p0622:b004:l022","ordinal":124190,"en":"Finding no mountain to collide with,"},{"id":"semetey-1-2013:p0622:b004:l023","ordinal":124191,"en":"No enemy to fight,"},{"id":"semetey-1-2013:p0622:b004:l024","ordinal":124192,"en":"With Almambet and Syrgak both there,"},{"id":"semetey-1-2013:p0622:b004:l025","ordinal":124193,"en":"With Azhibai and Bakai there too—"},{"id":"semetey-1-2013:p0622:b004:l026","ordinal":124194,"en":"Let me tell you, my child,"},{"id":"semetey-1-2013:p0622:b004:l027","ordinal":124195,"en":"All the champions were there."},{"id":"semetey-1-2013:p0622:b004:l028","ordinal":124196,"en":"To scout the Oigut people,"},{"id":"semetey-1-2013:p0622:b004:l029","ordinal":124197,"en":"To take Karacha's Saikal"},{"id":"semetey-1-2013:p0622:b004:l030","ordinal":124198,"en":"As his bride,"},{"id":"semetey-1-2013:p0622:b004:l031","ordinal":124199,"en":"Manas persistently led them under guard,"},{"id":"semetey-1-2013:p0622:b004:l032","ordinal":124200,"en":"When he caused great distress,"},{"id":"semetey-1-2013:p0622:b004:l033","ordinal":124201,"en":"To Karacha's Saikal,"},{"id":"semetey-1-2013:p0622:b004:l034","ordinal":124202,"en":"With sixty strongmen, warrior Manas"},{"id":"semetey-1-2013:p0622:b004:l035","ordinal":124203,"en":"Went, saying, ‘I shall take her.’"},{"id":"semetey-1-2013:p0622:b004:l036","ordinal":124204,"en":"At Yrgaity Pass,"},{"id":"semetey-1-2013:p0622:b004:l037","ordinal":124205,"en":"In the It-Zhurbos desert,"},{"id":"semetey-1-2013:p0622:b004:l038","ordinal":124206,"en":"On this side of the Lop River's forest,"},{"id":"semetey-1-2013:p0622:b004:l039","ordinal":124207,"en":"Along its ridge edge,"},{"id":"semetey-1-2013:p0623:b003:l001","ordinal":124208,"en":"On the spur of the towering mountain,"},{"id":"semetey-1-2013:p0623:b003:l002","ordinal":124209,"en":"Then I saw Maiden Saikal."},{"id":"semetey-1-2013:p0623:b003:l003","ordinal":124210,"en":"Her precious long, thick hair"},{"id":"semetey-1-2013:p0623:b003:l004","ordinal":124211,"en":"She had bound tightly atop her head."},{"id":"semetey-1-2013:p0623:b003:l005","ordinal":124212,"en":"She wore a giant warrior's clothing."},{"id":"semetey-1-2013:p0623:b003:l006","ordinal":124213,"en":"She too had ridden out on patrol."},{"id":"semetey-1-2013:p0623:b003:l007","ordinal":124214,"en":"I, Bakai, was the one who saw her."},{"id":"semetey-1-2013:p0623:b003:l008","ordinal":124215,"en":"Then Saikal said:"},{"id":"semetey-1-2013:p0623:b003:l009","ordinal":124216,"en":"‘Elders, where have you come from,"},{"id":"semetey-1-2013:p0623:b003:l010","ordinal":124217,"en":"Wearing out horses, scouting the land,"},{"id":"semetey-1-2013:p0623:b003:l011","ordinal":124218,"en":"All of you looking grim,"},{"id":"semetey-1-2013:p0623:b003:l012","ordinal":124219,"en":"Mounted on well-trained steeds,"},{"id":"semetey-1-2013:p0623:b003:l013","ordinal":124220,"en":"Tiring your horses, riding hard,"},{"id":"semetey-1-2013:p0623:b003:l014","ordinal":124221,"en":"With your hearts turned to some other purpose,"},{"id":"semetey-1-2013:p0623:b003:l015","ordinal":124222,"en":"Your conduct seeming hostile?"},{"id":"semetey-1-2013:p0623:b003:l016","ordinal":124223,"en":"You have entered my land,"},{"id":"semetey-1-2013:p0623:b003:l017","ordinal":124224,"en":"Come to take the measure of my people."},{"id":"semetey-1-2013:p0623:b003:l018","ordinal":124225,"en":"You dwell in Talas."},{"id":"semetey-1-2013:p0623:b003:l019","ordinal":124226,"en":"You have urged him on and brought him,"},{"id":"semetey-1-2013:p0623:b003:l020","ordinal":124227,"en":"Zhakyp's only son, Manas."},{"id":"semetey-1-2013:p0623:b003:l021","ordinal":124228,"en":"You are Kyrgyz, and I am Kyrgyz."},{"id":"semetey-1-2013:p0623:b003:l022","ordinal":124229,"en":"Your fine coats no bullet can pierce,"},{"id":"semetey-1-2013:p0623:b003:l023","ordinal":124230,"en":"You have come out wearing them."},{"id":"semetey-1-2013:p0623:b003:l024","ordinal":124231,"en":"There are no Chinese here on the right."},{"id":"semetey-1-2013:p0623:b003:l025","ordinal":124232,"en":"You have come out to pick a quarrel."},{"id":"semetey-1-2013:p0623:b003:l026","ordinal":124233,"en":"Is there a grievance troubling you?"},{"id":"semetey-1-2013:p0623:b003:l027","ordinal":124234,"en":"Bakai, blessed by Kydyr, tell the truth."},{"id":"semetey-1-2013:p0623:b003:l028","ordinal":124235,"en":"Has an enemy come from the Chinese?’"},{"id":"semetey-1-2013:p0623:b003:l029","ordinal":124236,"en":"So said Maiden Saikal,"},{"id":"semetey-1-2013:p0623:b003:l030","ordinal":124237,"en":"As she stood gathering her strength."},{"id":"semetey-1-2013:p0623:b003:l031","ordinal":124238,"en":"Khan Manas's forty companions,"},{"id":"semetey-1-2013:p0623:b003:l032","ordinal":124239,"en":"Told to drink water, drank poison;"},{"id":"semetey-1-2013:p0623:b003:l033","ordinal":124240,"en":"Told to spill blood, spilled entrails;"},{"id":"semetey-1-2013:p0623:b003:l034","ordinal":124241,"en":"Told to take a cap, cut off a head."},{"id":"semetey-1-2013:p0623:b003:l035","ordinal":124242,"en":"All those reckless warriors"},{"id":"semetey-1-2013:p0623:b003:l036","ordinal":124243,"en":"Struck their steeds once,"},{"id":"semetey-1-2013:p0623:b003:l037","ordinal":124244,"en":"Raised Manas as their battle cry,"},{"id":"semetey-1-2013:p0623:b003:l038","ordinal":124245,"en":"And attacked Maiden Saikal."},{"id":"semetey-1-2013:p0623:b003:l039","ordinal":124246,"en":"When all forty charged up,"},{"id":"semetey-1-2013:p0623:b004:l001","ordinal":124247,"en":"When each of the forty thrust his spear,"},{"id":"semetey-1-2013:p0623:b004:l002","ordinal":124248,"en":"Maiden Saikal did not turn her head,"},{"id":"semetey-1-2013:p0623:b004:l003","ordinal":124249,"en":"Did not stir, paying them no heed."},{"id":"semetey-1-2013:p0623:b004:l004","ordinal":124250,"en":"Though she bore the flaw of being female,"},{"id":"semetey-1-2013:p0623:b004:l005","ordinal":124251,"en":"The forty companions' spears"},{"id":"semetey-1-2013:p0623:b004:l006","ordinal":124252,"en":"She held worth no more than a scrap of hide."},{"id":"semetey-1-2013:p0623:b004:l007","ordinal":124253,"en":"My Lord, the Almighty,"},{"id":"semetey-1-2013:p0623:b004:l008","ordinal":124254,"en":"To Karacha's Saikal"},{"id":"semetey-1-2013:p0623:b004:l009","ordinal":124255,"en":"Had given courage without measure."},{"id":"semetey-1-2013:p0623:b004:l010","ordinal":124256,"en":"Then Saikal said:"},{"id":"semetey-1-2013:p0623:b004:l011","ordinal":124257,"en":"‘Khan Manas's forty madmen!"},{"id":"semetey-1-2013:p0623:b004:l012","ordinal":124258,"en":"You have freely crossed the land and made your way."},{"id":"semetey-1-2013:p0623:b004:l013","ordinal":124259,"en":"I am not your enemy to torment."},{"id":"semetey-1-2013:p0623:b004:l014","ordinal":124260,"en":"All forty of you attacked at once."},{"id":"semetey-1-2013:p0623:b004:l015","ordinal":124261,"en":"Is it amusement you seek,"},{"id":"semetey-1-2013:p0623:b004:l016","ordinal":124262,"en":"Or mischief you are looking for?’"},{"id":"semetey-1-2013:p0623:b004:l017","ordinal":124263,"en":"So saying, Maiden Saikal"},{"id":"semetey-1-2013:p0623:b004:l018","ordinal":124264,"en":"Charged and attacked us."},{"id":"semetey-1-2013:p0623:b004:l019","ordinal":124265,"en":"We barely escaped death."},{"id":"semetey-1-2013:p0623:b004:l020","ordinal":124266,"en":"In the It-Baspas desert,"},{"id":"semetey-1-2013:p0623:b004:l021","ordinal":124267,"en":"We were sixty, she alone."},{"id":"semetey-1-2013:p0623:b004:l022","ordinal":124268,"en":"Each of us was worth a thousand troops,"},{"id":"semetey-1-2013:p0623:b004:l023","ordinal":124269,"en":"Yet we fought Maiden Saikal with spears."},{"id":"semetey-1-2013:p0623:b004:l024","ordinal":124270,"en":"Let me tell the rest."},{"id":"semetey-1-2013:p0623:b004:l026","ordinal":124271,"en":"The forty companions who boasted of their might","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0623:b004:l027","ordinal":124272,"en":"Were overcome by Maiden Saikal."},{"id":"semetey-1-2013:p0623:b004:l028","ordinal":124273,"en":"Karacha's Saikal"},{"id":"semetey-1-2013:p0623:b004:l029","ordinal":124274,"en":"Wrought great turmoil."},{"id":"semetey-1-2013:p0623:b004:l030","ordinal":124275,"en":"I, your uncle, bloodthirsty Bakai,"},{"id":"semetey-1-2013:p0623:b004:l031","ordinal":124276,"en":"Survived by cunning,"},{"id":"semetey-1-2013:p0623:b004:l032","ordinal":124277,"en":"And barely preserved my life."},{"id":"semetey-1-2013:p0623:b004:l033","ordinal":124278,"en":"When Khan Manas's forty companions"},{"id":"semetey-1-2013:p0623:b004:l034","ordinal":124279,"en":"Fought with spears on the open plain,"},{"id":"semetey-1-2013:p0623:b004:l035","ordinal":124280,"en":"Each was left without a horse,"},{"id":"semetey-1-2013:p0623:b004:l036","ordinal":124281,"en":"Stranded on foot and helpless."},{"id":"semetey-1-2013:p0623:b004:l037","ordinal":124282,"en":"With your magnanimous lion father"},{"id":"semetey-1-2013:p0623:b004:l038","ordinal":124283,"en":"Saikal fought alone with spears."},{"id":"semetey-1-2013:p0623:b004:l039","ordinal":124284,"en":"The points of seven spears bent,"},{"id":"semetey-1-2013:p0624:b003:l001","ordinal":124285,"en":"Unable to overcome one another,"},{"id":"semetey-1-2013:p0624:b003:l002","ordinal":124286,"en":"They fought six days without pause,"},{"id":"semetey-1-2013:p0624:b003:l003","ordinal":124287,"en":"Remaining upright, never dismounting."},{"id":"semetey-1-2013:p0624:b003:l004","ordinal":124288,"en":"Only a giant like Almambet remained."},{"id":"semetey-1-2013:p0624:b003:l005","ordinal":124289,"en":"Khan Manas's forty champions"},{"id":"semetey-1-2013:p0624:b003:l006","ordinal":124290,"en":"Were all left on foot in the sand,"},{"id":"semetey-1-2013:p0624:b003:l007","ordinal":124291,"en":"Barely escaping death."},{"id":"semetey-1-2013:p0624:b003:l008","ordinal":124292,"en":"With golden forelock and tasselled sash,"},{"id":"semetey-1-2013:p0624:b003:l009","ordinal":124293,"en":"Khan Azyz's Almambet"},{"id":"semetey-1-2013:p0624:b003:l010","ordinal":124294,"en":"Fought alone without pause."},{"id":"semetey-1-2013:p0624:b003:l011","ordinal":124295,"en":"Maiden Saikal's wrath"},{"id":"semetey-1-2013:p0624:b003:l012","ordinal":124296,"en":"No one could endure."},{"id":"semetey-1-2013:p0624:b003:l013","ordinal":124297,"en":"They fought with spears for sixty days."},{"id":"semetey-1-2013:p0624:b003:l014","ordinal":124298,"en":"When the sixty-first day came,"},{"id":"semetey-1-2013:p0624:b003:l015","ordinal":124299,"en":"Manas the bloodthirsty one, alone—"},{"id":"semetey-1-2013:p0624:b003:l016","ordinal":124300,"en":"Karacha's Khan Saikal"},{"id":"semetey-1-2013:p0624:b003:l017","ordinal":124301,"en":"Thrust at him in her wrath."},{"id":"semetey-1-2013:p0624:b003:l018","ordinal":124302,"en":"She bent your khan father down."},{"id":"semetey-1-2013:p0624:b003:l019","ordinal":124303,"en":"When some terrible thing to Manas"},{"id":"semetey-1-2013:p0624:b003:l020","ordinal":124304,"en":"She was about to do,"},{"id":"semetey-1-2013:p0624:b003:l021","ordinal":124305,"en":"Bending the precious one from his horse,"},{"id":"semetey-1-2013:p0624:b003:l022","ordinal":124306,"en":"When she was about to seize him,"},{"id":"semetey-1-2013:p0624:b003:l023","ordinal":124307,"en":"Khan Azyz's Almambet,"},{"id":"semetey-1-2013:p0624:b003:l024","ordinal":124308,"en":"Barely surviving,"},{"id":"semetey-1-2013:p0624:b003:l025","ordinal":124309,"en":"Came to Khan Manas's aid."},{"id":"semetey-1-2013:p0624:b003:l026","ordinal":124310,"en":"Almam the Leopard fought with spears,"},{"id":"semetey-1-2013:p0624:b003:l027","ordinal":124311,"en":"And waged a fierce battle."},{"id":"semetey-1-2013:p0624:b003:l028","ordinal":124312,"en":"Your bloodthirsty father Manas"},{"id":"semetey-1-2013:p0624:b003:l029","ordinal":124313,"en":"From Khan Saikal's hands"},{"id":"semetey-1-2013:p0624:b003:l030","ordinal":124314,"en":"He rescued."},{"id":"semetey-1-2013:p0624:b003:l031","ordinal":124315,"en":"Akkula had grown fat."},{"id":"semetey-1-2013:p0624:b003:l032","ordinal":124316,"en":"Your heedless father"},{"id":"semetey-1-2013:p0624:b003:l033","ordinal":124317,"en":"That year had grown bulky,"},{"id":"semetey-1-2013:p0624:b003:l034","ordinal":124318,"en":"And become very stout."},{"id":"semetey-1-2013:p0624:b003:l035","ordinal":124319,"en":"When your father could not bend,"},{"id":"semetey-1-2013:p0624:b003:l036","ordinal":124320,"en":"Maiden Saikal found her chance,"},{"id":"semetey-1-2013:p0624:b003:l037","ordinal":124321,"en":"And thrust at him, jolting him back like this."},{"id":"semetey-1-2013:p0624:b003:l039","ordinal":124322,"en":"The valiant woman Kanykei"},{"id":"semetey-1-2013:p0624:b004:l001","ordinal":124323,"en":"Summered at Taragai."},{"id":"semetey-1-2013:p0624:b004:l002","ordinal":124324,"en":"Akkula and Manas,"},{"id":"semetey-1-2013:p0624:b004:l003","ordinal":124325,"en":"She bound the two side by side."},{"id":"semetey-1-2013:p0624:b004:l004","ordinal":124326,"en":"Bringing him to proper fighting condition,"},{"id":"semetey-1-2013:p0624:b004:l005","ordinal":124327,"en":"She released Manas."},{"id":"semetey-1-2013:p0624:b004:l006","ordinal":124328,"en":"They went down toward Saparbai,"},{"id":"semetey-1-2013:p0624:b004:l007","ordinal":124329,"en":"Along Zhaman-Suu,"},{"id":"semetey-1-2013:p0624:b004:l008","ordinal":124330,"en":"Fought in Great Turpan."},{"id":"semetey-1-2013:p0624:b004:l009","ordinal":124331,"en":"When they reached broad Ak-Suu,"},{"id":"semetey-1-2013:p0624:b004:l010","ordinal":124332,"en":"Pursuing Maiden Saikal,"},{"id":"semetey-1-2013:p0624:b004:l011","ordinal":124333,"en":"At Kum-Aryk's Kum-Darya,"},{"id":"semetey-1-2013:p0624:b004:l012","ordinal":124334,"en":"He defeated her at Kum-Darya."},{"id":"semetey-1-2013:p0624:b004:l013","ordinal":124335,"en":"Khan Manas, God's lion,"},{"id":"semetey-1-2013:p0624:b004:l014","ordinal":124336,"en":"Made the poor girl whimper,"},{"id":"semetey-1-2013:p0624:b004:l015","ordinal":124337,"en":"And swept her up as his captive."},{"id":"semetey-1-2013:p0624:b004:l016","ordinal":124338,"en":"Khwajas and mullahs were gathered."},{"id":"semetey-1-2013:p0624:b004:l017","ordinal":124339,"en":"A marriage for the next world"},{"id":"semetey-1-2013:p0624:b004:l018","ordinal":124340,"en":"Was solemnized with Khan Manas."},{"id":"semetey-1-2013:p0624:b004:l019","ordinal":124341,"en":"They made a pledged oath,"},{"id":"semetey-1-2013:p0624:b004:l020","ordinal":124342,"en":"Chewing white wheat flour,"},{"id":"semetey-1-2013:p0624:b004:l021","ordinal":124343,"en":"Clasping the holy Word,"},{"id":"semetey-1-2013:p0624:b004:l022","ordinal":124344,"en":"They stood by their promise."},{"id":"semetey-1-2013:p0624:b004:l023","ordinal":124345,"en":"A marriage for the next world"},{"id":"semetey-1-2013:p0624:b004:l024","ordinal":124346,"en":"Those men blessed by Kydyr solemnized."},{"id":"semetey-1-2013:p0624:b004:l025","ordinal":124347,"en":"The forty companions in iron armor"},{"id":"semetey-1-2013:p0624:b004:l026","ordinal":124348,"en":"She clothed in her joy."},{"id":"semetey-1-2013:p0624:b004:l027","ordinal":124349,"en":"‘Give it to your only son,’ she said."},{"id":"semetey-1-2013:p0624:b004:l028","ordinal":124350,"en":"The roan while still a colt"},{"id":"semetey-1-2013:p0624:b004:l029","ordinal":124351,"en":"She gave Khan Manas to ride,"},{"id":"semetey-1-2013:p0624:b004:l030","ordinal":124352,"en":"And stood by her promise."},{"id":"semetey-1-2013:p0624:b004:l031","ordinal":124353,"en":"‘For forty days when you are dying,"},{"id":"semetey-1-2013:p0624:b004:l032","ordinal":124354,"en":"I shall care for you myself,’ she said,"},{"id":"semetey-1-2013:p0624:b004:l033","ordinal":124355,"en":"And made that promise."},{"id":"semetey-1-2013:p0624:b004:l034","ordinal":124356,"en":"When your leopard father Manas"},{"id":"semetey-1-2013:p0624:b004:l035","ordinal":124357,"en":"Lay sick upon his pillow,"},{"id":"semetey-1-2013:p0624:b004:l036","ordinal":124358,"en":"Forty days before he died,"},{"id":"semetey-1-2013:p0624:b004:l037","ordinal":124359,"en":"Saikal came."},{"id":"semetey-1-2013:p0624:b004:l038","ordinal":124360,"en":"‘A companion for the next world,"},{"id":"semetey-1-2013:p0624:b004:l039","ordinal":124361,"en":"I shall lie in his embrace,’ she said,"},{"id":"semetey-1-2013:p0625:b003:l001","ordinal":124362,"en":"And made that promise."},{"id":"semetey-1-2013:p0625:b003:l002","ordinal":124363,"en":"When your leopard father died,"},{"id":"semetey-1-2013:p0625:b003:l003","ordinal":124364,"en":"Karacha's Saikal"},{"id":"semetey-1-2013:p0625:b003:l004","ordinal":124365,"en":"Clawed her face until it bled,"},{"id":"semetey-1-2013:p0625:b003:l005","ordinal":124366,"en":"Tore out her black hair,"},{"id":"semetey-1-2013:p0625:b003:l006","ordinal":124367,"en":"And put on loose black mourning clothes."},{"id":"semetey-1-2013:p0625:b003:l007","ordinal":124368,"en":"For Manas, the lion warrior,"},{"id":"semetey-1-2013:p0625:b003:l008","ordinal":124369,"en":"She grieved for seven days."},{"id":"semetey-1-2013:p0625:b003:l009","ordinal":124370,"en":"When the full seven days had passed,"},{"id":"semetey-1-2013:p0625:b003:l010","ordinal":124371,"en":"When the seventh-day memorial feast was given,"},{"id":"semetey-1-2013:p0625:b003:l011","ordinal":124372,"en":"Karacha's Saikal"},{"id":"semetey-1-2013:p0625:b003:l012","ordinal":124373,"en":"Departed toward her people."},{"id":"semetey-1-2013:p0625:b003:l013","ordinal":124374,"en":"Karacha's daughter Saikal,"},{"id":"semetey-1-2013:p0625:b003:l014","ordinal":124375,"en":"Ravaging both her cheeks,"},{"id":"semetey-1-2013:p0625:b003:l015","ordinal":124376,"en":"Went on clawing them, I heard."},{"id":"semetey-1-2013:p0625:b003:l016","ordinal":124377,"en":"Beyond all measure, for Manas,"},{"id":"semetey-1-2013:p0625:b003:l017","ordinal":124378,"en":"She went on grieving, I heard."},{"id":"semetey-1-2013:p0625:b003:l018","ordinal":124379,"en":"When Maiden Saikal arrived in sorrow,"},{"id":"semetey-1-2013:p0625:b003:l019","ordinal":124380,"en":"Wailing, ‘My leopard!’"},{"id":"semetey-1-2013:p0625:b003:l020","ordinal":124381,"en":"The many Oigut and Karacha"},{"id":"semetey-1-2013:p0625:b003:l021","ordinal":124382,"en":"Served her with great care,"},{"id":"semetey-1-2013:p0625:b003:l022","ordinal":124383,"en":"And showed her reverence."},{"id":"semetey-1-2013:p0625:b003:l023","ordinal":124384,"en":"On reaching home, Maiden Saikal"},{"id":"semetey-1-2013:p0625:b003:l024","ordinal":124385,"en":"Departed this world and died, they say."},{"id":"semetey-1-2013:p0625:b003:l025","ordinal":124386,"en":"At dawn her body was gone."},{"id":"semetey-1-2013:p0625:b003:l026","ordinal":124387,"en":"Her people cried out in grief;"},{"id":"semetey-1-2013:p0625:b003:l027","ordinal":124388,"en":"Her father wept and sobbed."},{"id":"semetey-1-2013:p0625:b003:l028","ordinal":124389,"en":"Throughout the face of the earth"},{"id":"semetey-1-2013:p0625:b003:l029","ordinal":124390,"en":"They spread the news fully."},{"id":"semetey-1-2013:p0625:b003:l030","ordinal":124391,"en":"Maiden Saikal's body was gone;"},{"id":"semetey-1-2013:p0625:b003:l031","ordinal":124392,"en":"She had vanished into the unseen."},{"id":"semetey-1-2013:p0625:b003:l032","ordinal":124393,"en":"God must have granted her wish."},{"id":"semetey-1-2013:p0625:b003:l033","ordinal":124394,"en":"A lawful spouse for the next world,"},{"id":"semetey-1-2013:p0625:b003:l034","ordinal":124395,"en":"Renowned Saikal must have come."},{"id":"semetey-1-2013:p0625:b003:l035","ordinal":124396,"en":"Your father was the son of a houri,"},{"id":"semetey-1-2013:p0625:b003:l036","ordinal":124397,"en":"And she a houri's daughter."},{"id":"semetey-1-2013:p0625:b003:l037","ordinal":124398,"en":"They must have entered into joy."},{"id":"semetey-1-2013:p0625:b003:l038","ordinal":124399,"en":"The two lovers joined together,"},{"id":"semetey-1-2013:p0625:b003:l039","ordinal":124400,"en":"And must be lying in one bed."},{"id":"semetey-1-2013:p0625:b005:l001","ordinal":124401,"en":"Their wish must have been granted."},{"id":"semetey-1-2013:p0625:b005:l002","ordinal":124402,"en":"Into your khan father's embrace,"},{"id":"semetey-1-2013:p0625:b005:l003","ordinal":124403,"en":"Saikal must have come from the unseen."},{"id":"semetey-1-2013:p0625:b005:l004","ordinal":124404,"en":"The one tucked close at his head—"},{"id":"semetey-1-2013:p0625:b005:l005","ordinal":124405,"en":"That dear child, twelve years old,"},{"id":"semetey-1-2013:p0625:b005:l006","ordinal":124406,"en":"Was Koenaly,"},{"id":"semetey-1-2013:p0625:b005:l007","ordinal":124407,"en":"The true son of Kokboru,"},{"id":"semetey-1-2013:p0625:b005:l008","ordinal":124408,"en":"Kokboru, son of Urumkan."},{"id":"semetey-1-2013:p0625:b005:l009","ordinal":124409,"en":"They had stirred the stars in the heavens."},{"id":"semetey-1-2013:p0625:b005:l010","ordinal":124410,"en":"Your father and Kokboru"},{"id":"semetey-1-2013:p0625:b005:l011","ordinal":124411,"en":"Swore friendship three times in one day."},{"id":"semetey-1-2013:p0625:b005:l012","ordinal":124412,"en":"When your father lay ill,"},{"id":"semetey-1-2013:p0625:b005:l013","ordinal":124413,"en":"His friend Boru came."},{"id":"semetey-1-2013:p0625:b005:l014","ordinal":124414,"en":"His dear Koenaly, aged twelve,"},{"id":"semetey-1-2013:p0625:b005:l016","ordinal":124415,"en":"Kokboru's only child, born late in his life,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0625:b005:l018","ordinal":124416,"en":"At the age of twelve,"}]
