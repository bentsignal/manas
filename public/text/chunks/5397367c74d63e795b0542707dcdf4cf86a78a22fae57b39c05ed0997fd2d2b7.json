[{"id":"semetey-1-2013:p1359:b004:l020","ordinal":180993,"en":"I surpassed myself in the making."},{"id":"semetey-1-2013:p1359:b004:l021","ordinal":180994,"en":"To wear into battle,"},{"id":"semetey-1-2013:p1359:b004:l022","ordinal":180995,"en":"For you four I made four coats of armor,"},{"id":"semetey-1-2013:p1359:b004:l023","ordinal":180996,"en":"Prince, uncle Bakai,"},{"id":"semetey-1-2013:p1359:b004:l024","ordinal":180997,"en":"Fitted to each of you!"},{"id":"semetey-1-2013:p1359:b004:l025","ordinal":180998,"en":"So the heroes might wear these,"},{"id":"semetey-1-2013:p1359:b004:l026","ordinal":180999,"en":"And face and strike the enemy."},{"id":"semetey-1-2013:p1359:b004:l027","ordinal":181000,"en":"I have coats I made with care;"},{"id":"semetey-1-2013:p1359:b004:l028","ordinal":181001,"en":"I give them as gifts—put them on,"},{"id":"semetey-1-2013:p1359:b004:l029","ordinal":181002,"en":"And face and strike the enemy!"},{"id":"semetey-1-2013:p1359:b004:l030","ordinal":181003,"en":"Make war upon Beijing;"},{"id":"semetey-1-2013:p1359:b004:l031","ordinal":181004,"en":"Recall the works"},{"id":"semetey-1-2013:p1359:b004:l032","ordinal":181005,"en":"Your unfortunate valiant woman"},{"id":"semetey-1-2013:p1359:b004:l033","ordinal":181006,"en":"Prepared for you!"},{"id":"semetey-1-2013:p1359:b004:l034","ordinal":181007,"en":"And now, my son, listen well!"},{"id":"semetey-1-2013:p1359:b004:l035","ordinal":181008,"en":"Again I pondered, for the task was hard;"},{"id":"semetey-1-2013:p1359:b004:l036","ordinal":181009,"en":"Again, by my will, I made"},{"id":"semetey-1-2013:p1359:b004:l037","ordinal":181010,"en":"Four articles for you four!"},{"id":"semetey-1-2013:p1359:b004:l038","ordinal":181011,"en":"To obtain sharp iron,"},{"id":"semetey-1-2013:p1359:b004:l039","ordinal":181012,"en":"I opened all my livestock stores,"},{"id":"semetey-1-2013:p1360:b003:l001","ordinal":181013,"en":"I, your mother Kanykei,"},{"id":"semetey-1-2013:p1360:b003:l002","ordinal":181014,"en":"Sent men through many cities."},{"id":"semetey-1-2013:p1360:b003:l003","ordinal":181015,"en":"Bölökbai’s forty Kalchas"},{"id":"semetey-1-2013:p1360:b003:l004","ordinal":181016,"en":"I sent roaming over many lands;"},{"id":"semetey-1-2013:p1360:b003:l005","ordinal":181017,"en":"I had every place searched."},{"id":"semetey-1-2013:p1360:b003:l006","ordinal":181018,"en":"I, ill-fated and disgraced,"},{"id":"semetey-1-2013:p1360:b003:l007","ordinal":181019,"en":"Had them bring the keenest iron."},{"id":"semetey-1-2013:p1360:b003:l008","ordinal":181020,"en":"When it came to making charcoal,"},{"id":"semetey-1-2013:p1360:b003:l009","ordinal":181021,"en":"A whole bay of green forest was cleared;"},{"id":"semetey-1-2013:p1360:b003:l010","ordinal":181022,"en":"At the forge no living soul could endure."},{"id":"semetey-1-2013:p1360:b003:l011","ordinal":181023,"en":"Alman dismounted from the argymak,"},{"id":"semetey-1-2013:p1360:b003:l012","ordinal":181024,"en":"And a blue bullock was slaughtered;"},{"id":"semetey-1-2013:p1360:b003:l013","ordinal":181025,"en":"Hammering with sledge and mallet,"},{"id":"semetey-1-2013:p1360:b003:l014","ordinal":181026,"en":"The forty Kalchas wore hollows in their hands."},{"id":"semetey-1-2013:p1360:b003:l015","ordinal":181027,"en":"The master smith Bölökbai,"},{"id":"semetey-1-2013:p1360:b003:l016","ordinal":181028,"en":"After eating, set to work;"},{"id":"semetey-1-2013:p1360:b003:l017","ordinal":181029,"en":"He was a friend of the prophet David—"},{"id":"semetey-1-2013:p1360:b003:l018","ordinal":181030,"en":"That poor man fashioned it."},{"id":"semetey-1-2013:p1360:b003:l019","ordinal":181031,"en":"He stretched gold along its hilt,"},{"id":"semetey-1-2013:p1360:b003:l020","ordinal":181032,"en":"And filled its edge with sharpness;"},{"id":"semetey-1-2013:p1360:b003:l021","ordinal":181033,"en":"Bölökbai, the accomplished smith,"},{"id":"semetey-1-2013:p1360:b003:l022","ordinal":181034,"en":"Barely finished it in seven years."},{"id":"semetey-1-2013:p1360:b003:l023","ordinal":181035,"en":"This wondrous treasure of mine—"},{"id":"semetey-1-2013:p1360:b003:l024","ordinal":181036,"en":"That single dagger"},{"id":"semetey-1-2013:p1360:b003:l025","ordinal":181037,"en":"Is worth forty-five camels."},{"id":"semetey-1-2013:p1360:b003:l026","ordinal":181038,"en":"When you wreak slaughter among the Chinese,"},{"id":"semetey-1-2013:p1360:b003:l027","ordinal":181039,"en":"When you confront the giants"},{"id":"semetey-1-2013:p1360:b003:l028","ordinal":181040,"en":"And close with them rein to rein,"},{"id":"semetey-1-2013:p1360:b003:l029","ordinal":181041,"en":"Draw it from its sheath,"},{"id":"semetey-1-2013:p1360:b003:l030","ordinal":181042,"en":"And plunge it between their ribs."},{"id":"semetey-1-2013:p1360:b003:l031","ordinal":181043,"en":"Its hilt fits within the fist,"},{"id":"semetey-1-2013:p1360:b003:l032","ordinal":181044,"en":"And to carry it against the body"},{"id":"semetey-1-2013:p1360:b003:l033","ordinal":181045,"en":"It has a special case."},{"id":"semetey-1-2013:p1360:b003:l034","ordinal":181046,"en":"I give four treasures to you four;"},{"id":"semetey-1-2013:p1360:b003:l035","ordinal":181047,"en":"Fasten them at your waists."},{"id":"semetey-1-2013:p1360:b003:l036","ordinal":181048,"en":"Accept them as gifts, saying,"},{"id":"semetey-1-2013:p1360:b003:l037","ordinal":181049,"en":"“Our valiant mother gave them.”"},{"id":"semetey-1-2013:p1360:b003:l038","ordinal":181050,"en":"Your destination is the Kakanchin;"},{"id":"semetey-1-2013:p1360:b003:l039","ordinal":181051,"en":"Face them and wreak slaughter!"},{"id":"semetey-1-2013:p1360:b004:l001","ordinal":181052,"en":"I learned this from the transmitters,"},{"id":"semetey-1-2013:p1360:b004:l002","ordinal":181053,"en":"And asked those who knew."},{"id":"semetey-1-2013:p1360:b004:l003","ordinal":181054,"en":"They say Beijing is a hot land,"},{"id":"semetey-1-2013:p1360:b004:l004","ordinal":181055,"en":"Whose heat gives no respite,"},{"id":"semetey-1-2013:p1360:b004:l005","ordinal":181056,"en":"Whose heat boils like fire;"},{"id":"semetey-1-2013:p1360:b004:l006","ordinal":181057,"en":"Whoever meets that heat"},{"id":"semetey-1-2013:p1360:b004:l007","ordinal":181058,"en":"Is left without strength or power."},{"id":"semetey-1-2013:p1360:b004:l008","ordinal":181059,"en":"They say its desert is forty days across,"},{"id":"semetey-1-2013:p1360:b004:l009","ordinal":181060,"en":"A land of surpassing severity."},{"id":"semetey-1-2013:p1360:b004:l010","ordinal":181061,"en":"None has brought it under my sway;"},{"id":"semetey-1-2013:p1360:b004:l011","ordinal":181062,"en":"No one has endured the journey there."},{"id":"semetey-1-2013:p1360:b004:l012","ordinal":181063,"en":"Its land is distant and its people many;"},{"id":"semetey-1-2013:p1360:b004:l013","ordinal":181064,"en":"If my champions set out upon the road,"},{"id":"semetey-1-2013:p1360:b004:l014","ordinal":181065,"en":"Shame on me if I did not foresee"},{"id":"semetey-1-2013:p1360:b004:l015","ordinal":181066,"en":"That their strength would fail."},{"id":"semetey-1-2013:p1360:b004:l016","ordinal":181067,"en":"Far Egypt and broad Jerusalem—"},{"id":"semetey-1-2013:p1360:b004:l017","ordinal":181068,"en":"I had those cities searched,"},{"id":"semetey-1-2013:p1360:b004:l018","ordinal":181069,"en":"And the travel rations found there"},{"id":"semetey-1-2013:p1360:b004:l019","ordinal":181070,"en":"I bought for their weight in worked gold,"},{"id":"semetey-1-2013:p1360:b004:l020","ordinal":181071,"en":"Barely obtaining them at death’s door."},{"id":"semetey-1-2013:p1360:b004:l021","ordinal":181072,"en":"I wrapped the outside in rawhide,"},{"id":"semetey-1-2013:p1360:b004:l022","ordinal":181073,"en":"And destined them for the clash"},{"id":"semetey-1-2013:p1360:b004:l023","ordinal":181074,"en":"With Kakanchin’s Beijing."},{"id":"semetey-1-2013:p1360:b004:l024","ordinal":181075,"en":"How much this poor head has learned!"},{"id":"semetey-1-2013:p1360:b004:l025","ordinal":181076,"en":"Food for the tulpar and food for the hero,"},{"id":"semetey-1-2013:p1360:b004:l026","ordinal":181077,"en":"With nourishing herbs all mixed within."},{"id":"semetey-1-2013:p1360:b004:l027","ordinal":181078,"en":"For each of you four, a separate portion—"},{"id":"semetey-1-2013:p1360:b004:l028","ordinal":181079,"en":"I prepared them long ago."},{"id":"semetey-1-2013:p1360:b004:l029","ordinal":181080,"en":"As the prince’s faithful wife,"},{"id":"semetey-1-2013:p1360:b004:l030","ordinal":181081,"en":"I entrust this treasure to you."},{"id":"semetey-1-2013:p1360:b004:l031","ordinal":181082,"en":"Fasten it behind your saddle,"},{"id":"semetey-1-2013:p1360:b004:l032","ordinal":181083,"en":"And in that forty-day desert"},{"id":"semetey-1-2013:p1360:b004:l033","ordinal":181084,"en":"Pour it straight upon your palate!"},{"id":"semetey-1-2013:p1360:b004:l034","ordinal":181085,"en":"So that in crushing battle with the Chinese"},{"id":"semetey-1-2013:p1360:b004:l035","ordinal":181086,"en":"You may unleash havoc,"},{"id":"semetey-1-2013:p1360:b004:l036","ordinal":181087,"en":"Fight six months without tiring,"},{"id":"semetey-1-2013:p1360:b004:l037","ordinal":181088,"en":"And avenge the noble hero,"},{"id":"semetey-1-2013:p1360:b004:l038","ordinal":181089,"en":"I prepared these travel rations,"},{"id":"semetey-1-2013:p1360:b004:l039","ordinal":181090,"en":"For the valiant heroes themselves"},{"id":"semetey-1-2013:p1361:b003:l001","ordinal":181091,"en":"I prepared and entrusted them;"},{"id":"semetey-1-2013:p1361:b003:l002","ordinal":181092,"en":"Take them gladly as a gift!”"},{"id":"semetey-1-2013:p1361:b003:l003","ordinal":181093,"en":"Your valiant mother Kanykei"},{"id":"semetey-1-2013:p1361:b003:l004","ordinal":181094,"en":"Gave travel rations to all four."},{"id":"semetey-1-2013:p1361:b003:l005","ordinal":181095,"en":"Great Beijing was six months away;"},{"id":"semetey-1-2013:p1361:b003:l006","ordinal":181096,"en":"Those who went to Beijing died—"},{"id":"semetey-1-2013:p1361:b003:l007","ordinal":181097,"en":"Unless mighty Allah watched over them,"},{"id":"semetey-1-2013:p1361:b003:l008","ordinal":181098,"en":"What living soul could return alive?!"},{"id":"semetey-1-2013:p1361:b003:l009","ordinal":181099,"en":"Lest their clothes become infested with lice,"},{"id":"semetey-1-2013:p1361:b003:l010","ordinal":181100,"en":"There was a separate change of clothing for lice;"},{"id":"semetey-1-2013:p1361:b003:l011","ordinal":181101,"en":"Lest their clothes become filthy,"},{"id":"semetey-1-2013:p1361:b003:l012","ordinal":181102,"en":"There was a separate change for dirt."},{"id":"semetey-1-2013:p1361:b003:l013","ordinal":181103,"en":"My heart burns, my liver is embers;"},{"id":"semetey-1-2013:p1361:b003:l014","ordinal":181104,"en":"In this mother’s hands,"},{"id":"semetey-1-2013:p1361:b003:l015","ordinal":181105,"en":"What was there, and what was not!"},{"id":"semetey-1-2013:p1361:b003:l016","ordinal":181106,"en":"Your opponent is the Kakanchin;"},{"id":"semetey-1-2013:p1361:b003:l017","ordinal":181107,"en":"Should you clash in a great conflict,"},{"id":"semetey-1-2013:p1361:b003:l018","ordinal":181108,"en":"For every hero I prepared"},{"id":"semetey-1-2013:p1361:b003:l019","ordinal":181109,"en":"Twelve shirts and ten pairs of trousers,"},{"id":"semetey-1-2013:p1361:b003:l020","ordinal":181110,"en":"Satin, silk, and fine-cloth shirts—"},{"id":"semetey-1-2013:p1361:b003:l021","ordinal":181111,"en":"So that you could pursue the blood-price,"},{"id":"semetey-1-2013:p1361:b003:l022","ordinal":181112,"en":"I foresaw it long ago,"},{"id":"semetey-1-2013:p1361:b003:l023","ordinal":181113,"en":"Gathered and obtained them all,"},{"id":"semetey-1-2013:p1361:b004:l001","ordinal":181114,"en":"And into the bottom of a great saddlebag"},{"id":"semetey-1-2013:p1361:b004:l002","ordinal":181115,"en":"Placed them together."},{"id":"semetey-1-2013:p1361:b004:l003","ordinal":181116,"en":"For you four I made four saddlebags,"},{"id":"semetey-1-2013:p1361:b004:l004","ordinal":181117,"en":"Green and blue in color,"},{"id":"semetey-1-2013:p1361:b004:l005","ordinal":181118,"en":"Of exceedingly great value,"},{"id":"semetey-1-2013:p1361:b004:l006","ordinal":181119,"en":"Saddlebags holding abundant goods."},{"id":"semetey-1-2013:p1361:b004:l007","ordinal":181120,"en":"I reinforced their mouths with steel,"},{"id":"semetey-1-2013:p1361:b004:l008","ordinal":181121,"en":"Stitched them with hidden seams,"},{"id":"semetey-1-2013:p1361:b004:l009","ordinal":181122,"en":"And made those saddlebags ready."},{"id":"semetey-1-2013:p1361:b004:l010","ordinal":181123,"en":"They contain powder and shot,"},{"id":"semetey-1-2013:p1361:b004:l011","ordinal":181124,"en":"Enough to last twelve months,"},{"id":"semetey-1-2013:p1361:b004:l012","ordinal":181125,"en":"So that they would not run out;"},{"id":"semetey-1-2013:p1361:b004:l013","ordinal":181126,"en":"I, disgraced Kanykei,"},{"id":"semetey-1-2013:p1361:b004:l014","ordinal":181127,"en":"Measured it truly for that need!"},{"id":"semetey-1-2013:p1361:b004:l015","ordinal":181128,"en":"So you can stand on opposite banks,"},{"id":"semetey-1-2013:p1361:b004:l016","ordinal":181129,"en":"And when the spear cannot reach,"},{"id":"semetey-1-2013:p1361:b004:l017","ordinal":181130,"en":"Strike with the gun,"},{"id":"semetey-1-2013:p1361:b004:l018","ordinal":181131,"en":"I strengthened their mouths firmly!"},{"id":"semetey-1-2013:p1361:b004:l019","ordinal":181132,"en":"I prepared them for the holy campaign!"},{"id":"semetey-1-2013:p1361:b004:l020","ordinal":181133,"en":"Accept them as gifts, saying,"},{"id":"semetey-1-2013:p1361:b004:l021","ordinal":181134,"en":"“The fierce valiant lady gave them!”"},{"id":"semetey-1-2013:p1361:b004:l022","ordinal":181135,"en":"Set them upon your saddle cushion,"},{"id":"semetey-1-2013:p1361:b004:l023","ordinal":181136,"en":"Close beside your own body!"},{"id":"semetey-1-2013:p1361:b006:l001","ordinal":181137,"en":"From the iron-gated fortress"},{"id":"semetey-1-2013:p1361:b006:l002","ordinal":181138,"en":"Semetey could no longer be restrained."},{"id":"semetey-1-2013:p1361:b006:l003","ordinal":181139,"en":"Loading bullets upon the elephant,"},{"id":"semetey-1-2013:p1361:b006:l004","ordinal":181140,"en":"Taking fourteen horses together,"},{"id":"semetey-1-2013:p1361:b006:l005","ordinal":181141,"en":"Saying, “I shall gird my waist firmly;"},{"id":"semetey-1-2013:p1361:b006:l006","ordinal":181142,"en":"Kongurbai there in Beijing—"},{"id":"semetey-1-2013:p1361:b006:l007","ordinal":181143,"en":"I shall pursue my father’s blood-price,”"},{"id":"semetey-1-2013:p1361:b006:l008","ordinal":181144,"en":"He made his arms and armor ready."},{"id":"semetey-1-2013:p1361:b006:l009","ordinal":181145,"en":"Zulpukor, left by Manas,"},{"id":"semetey-1-2013:p1361:b006:l010","ordinal":181146,"en":"He fastened close against his body;"},{"id":"semetey-1-2013:p1361:b006:l011","ordinal":181147,"en":"Akkelte, entrusted to him"},{"id":"semetey-1-2013:p1361:b006:l012","ordinal":181148,"en":"By his father, gray-wolf Manas,"},{"id":"semetey-1-2013:p1361:b008:l001","ordinal":181149,"en":"Was visible upon his shoulder."},{"id":"semetey-1-2013:p1361:b008:l002","ordinal":181150,"en":"When he entered a shooting battle,"},{"id":"semetey-1-2013:p1361:b008:l003","ordinal":181151,"en":"It was the treasure left as a gift"},{"id":"semetey-1-2013:p1361:b008:l004","ordinal":181152,"en":"By valiant Lord Manas."},{"id":"semetey-1-2013:p1361:b008:l005","ordinal":181153,"en":"Semetey, son of Manas,"},{"id":"semetey-1-2013:p1361:b008:l006","ordinal":181154,"en":"Put on Akolpok"},{"id":"semetey-1-2013:p1361:b008:l007","ordinal":181155,"en":"And now buckled the gray kise at his waist;"},{"id":"semetey-1-2013:p1361:b008:l008","ordinal":181156,"en":"The Forty Saints now supported"},{"id":"semetey-1-2013:p1361:b008:l009","ordinal":181157,"en":"The fortunate, heaven-born prince."},{"id":"semetey-1-2013:p1361:b008:l010","ordinal":181158,"en":"The many treasures Kanykei had given"},{"id":"semetey-1-2013:p1361:b008:l011","ordinal":181159,"en":"Were folded separately,"},{"id":"semetey-1-2013:p1361:b008:l012","ordinal":181160,"en":"And among the fourteen horses"},{"id":"semetey-1-2013:p1362:b003:l001","ordinal":181161,"en":"Loaded upon each bay horse."},{"id":"semetey-1-2013:p1362:b003:l002","ordinal":181162,"en":"When all was ready,"},{"id":"semetey-1-2013:p1362:b003:l003","ordinal":181163,"en":"The dear hero stood tall;"},{"id":"semetey-1-2013:p1362:b003:l004","ordinal":181164,"en":"The steadfast, beloved warrior"},{"id":"semetey-1-2013:p1362:b003:l005","ordinal":181165,"en":"Made his weapons ready,"},{"id":"semetey-1-2013:p1362:b003:l006","ordinal":181166,"en":"Prepared to confront the Kakanchin,"},{"id":"semetey-1-2013:p1362:b003:l007","ordinal":181167,"en":"And remained ready to depart."},{"id":"semetey-1-2013:p1362:b003:l008","ordinal":181168,"en":"The inheritance left by his father—"},{"id":"semetey-1-2013:p1362:b003:l009","ordinal":181169,"en":"Lion Bakai, the keen warrior."},{"id":"semetey-1-2013:p1362:b003:l010","ordinal":181170,"en":"He put on a blue lynx-fur cap"},{"id":"semetey-1-2013:p1362:b003:l011","ordinal":181171,"en":"And flourished his blue-gray shield."},{"id":"semetey-1-2013:p1362:b003:l012","ordinal":181172,"en":"Its crown was a life-protecting coat of mail,"},{"id":"semetey-1-2013:p1362:b003:l013","ordinal":181173,"en":"Its foot was shod with a thousand pieces of gold."},{"id":"semetey-1-2013:p1362:b003:l014","ordinal":181174,"en":"He who flourished the blue-gray shield"},{"id":"semetey-1-2013:p1362:b003:l015","ordinal":181175,"en":"Never tired of the foe he faced."},{"id":"semetey-1-2013:p1362:b003:l016","ordinal":181176,"en":"Bakai Khan, the rich man’s son,"},{"id":"semetey-1-2013:p1362:b003:l017","ordinal":181177,"en":"Had rinsed his mouth with honey;"},{"id":"semetey-1-2013:p1362:b003:l018","ordinal":181178,"en":"He found sight in darkness"},{"id":"semetey-1-2013:p1362:b003:l019","ordinal":181179,"en":"And found words in sudden peril,"},{"id":"semetey-1-2013:p1362:b003:l020","ordinal":181180,"en":"A confidant when taking the road,"},{"id":"semetey-1-2013:p1362:b003:l021","ordinal":181181,"en":"A comrade of tiger Manas."},{"id":"semetey-1-2013:p1362:b003:l022","ordinal":181182,"en":"Bracing himself like a leopard,"},{"id":"semetey-1-2013:p1362:b003:l023","ordinal":181183,"en":"Your dear uncle Bakai"},{"id":"semetey-1-2013:p1362:b003:l024","ordinal":181184,"en":"Received wisdom from the unseen."},{"id":"semetey-1-2013:p1362:b003:l025","ordinal":181185,"en":"His coat of ring mail gleamed;"},{"id":"semetey-1-2013:p1362:b003:l026","ordinal":181186,"en":"Your uncle, lion Bakai,"},{"id":"semetey-1-2013:p1362:b003:l027","ordinal":181187,"en":"Had a white beard that shone,"},{"id":"semetey-1-2013:p1362:b003:l028","ordinal":181188,"en":"And cried like a visiting goose;"},{"id":"semetey-1-2013:p1362:b003:l029","ordinal":181189,"en":"Your heroic uncle Bakai"},{"id":"semetey-1-2013:p1362:b003:l030","ordinal":181190,"en":"Thundered like a prophet."},{"id":"semetey-1-2013:p1362:b003:l031","ordinal":181191,"en":"He raised the gold-crescent banner;"},{"id":"semetey-1-2013:p1362:b003:l032","ordinal":181192,"en":"Your uncle Bakai made ready,"},{"id":"semetey-1-2013:p1362:b003:l033","ordinal":181193,"en":"Raising the cry, “Aziret!”"},{"id":"semetey-1-2013:p1362:b003:l034","ordinal":181194,"en":"A safeguard for his entrusted life,"},{"id":"semetey-1-2013:p1362:b003:l035","ordinal":181195,"en":"A gift from my sworn father Almambet—"},{"id":"semetey-1-2013:p1362:b003:l036","ordinal":181196,"en":"Tall and broad-shouldered,"},{"id":"semetey-1-2013:p1362:b003:l037","ordinal":181197,"en":"Both wrestler and warrior,"},{"id":"semetey-1-2013:p1362:b003:l038","ordinal":181198,"en":"Külchoro, son of Almambet,"},{"id":"semetey-1-2013:p1362:b003:l039","ordinal":181199,"en":"The keen hero who could shake the world."},{"id":"semetey-1-2013:p1362:b004:l001","ordinal":181200,"en":"His form, his noble bearing,"},{"id":"semetey-1-2013:p1362:b004:l002","ordinal":181201,"en":"His appearance upon a horse"},{"id":"semetey-1-2013:p1362:b004:l003","ordinal":181202,"en":"Stirred the heart of whoever saw him;"},{"id":"semetey-1-2013:p1362:b004:l004","ordinal":181203,"en":"To your uncle’s eyes"},{"id":"semetey-1-2013:p1362:b004:l005","ordinal":181204,"en":"He looked like Almambet."},{"id":"semetey-1-2013:p1362:b004:l006","ordinal":181205,"en":"When Bakai turned and looked,"},{"id":"semetey-1-2013:p1362:b004:l007","ordinal":181206,"en":"With broad mouth and cliff-like brows,"},{"id":"semetey-1-2013:p1362:b004:l008","ordinal":181207,"en":"He spoke like that gray wolf."},{"id":"semetey-1-2013:p1362:b004:l009","ordinal":181208,"en":"Lion-born Külchoro"},{"id":"semetey-1-2013:p1362:b004:l010","ordinal":181209,"en":"Had Almambet’s very eyes."},{"id":"semetey-1-2013:p1362:b004:l011","ordinal":181210,"en":"It was as though, on man and head alike,"},{"id":"semetey-1-2013:p1362:b004:l012","ordinal":181211,"en":"The skin of gray-wolf hero Alman"},{"id":"semetey-1-2013:p1362:b004:l013","ordinal":181212,"en":"Had been laid over him;"},{"id":"semetey-1-2013:p1362:b004:l014","ordinal":181213,"en":"It was as though the Almighty"},{"id":"semetey-1-2013:p1362:b004:l015","ordinal":181214,"en":"Had matched nose to nose"},{"id":"semetey-1-2013:p1362:b004:l016","ordinal":181215,"en":"And turned them from the same mold."},{"id":"semetey-1-2013:p1362:b004:l017","ordinal":181216,"en":"Tall and broad-shouldered,"},{"id":"semetey-1-2013:p1362:b004:l018","ordinal":181217,"en":"He was a blazing red ember;"},{"id":"semetey-1-2013:p1362:b004:l019","ordinal":181218,"en":"Though Japar the Creator"},{"id":"semetey-1-2013:p1362:b004:l020","ordinal":181219,"en":"Continued creating souls,"},{"id":"semetey-1-2013:p1362:b004:l021","ordinal":181220,"en":"There was none like Külchoro."},{"id":"semetey-1-2013:p1362:b004:l022","ordinal":181221,"en":"Full-limbed and imposing,"},{"id":"semetey-1-2013:p1362:b004:l023","ordinal":181222,"en":"The sight of him stirred the heart;"},{"id":"semetey-1-2013:p1362:b004:l024","ordinal":181223,"en":"To bloodthirsty Bakai the falcon,"},{"id":"semetey-1-2013:p1362:b004:l025","ordinal":181224,"en":"To the poor man sunk in sorrow,"},{"id":"semetey-1-2013:p1362:b004:l026","ordinal":181225,"en":"As he watched Külchoro,"},{"id":"semetey-1-2013:p1362:b004:l027","ordinal":181226,"en":"How much he resembled your uncle Ala!"},{"id":"semetey-1-2013:p1362:b004:l028","ordinal":181227,"en":"Beneath him was Surkoën,"},{"id":"semetey-1-2013:p1362:b004:l029","ordinal":181228,"en":"With solid hooves broad as bowls;"},{"id":"semetey-1-2013:p1362:b004:l030","ordinal":181229,"en":"For the campaign against Kakan,"},{"id":"semetey-1-2013:p1362:b004:l031","ordinal":181230,"en":"That spirited champion Külchoro rode him!"},{"id":"semetey-1-2013:p1362:b004:l032","ordinal":181231,"en":"Do not ask how Surkoën was:"},{"id":"semetey-1-2013:p1362:b004:l033","ordinal":181232,"en":"Short in the forelegs, long in the hind,"},{"id":"semetey-1-2013:p1362:b004:l034","ordinal":181233,"en":"High-backed and broad in the chest,"},{"id":"semetey-1-2013:p1362:b004:l035","ordinal":181234,"en":"His pace like the wind of the open steppe,"},{"id":"semetey-1-2013:p1362:b004:l036","ordinal":181235,"en":"His muscles like the back of a bull,"},{"id":"semetey-1-2013:p1362:b004:l037","ordinal":181236,"en":"His tail sparse and his mane scant;"},{"id":"semetey-1-2013:p1362:b004:l038","ordinal":181237,"en":"If he chased a kulan, it could not escape."},{"id":"semetey-1-2013:p1362:b004:l039","ordinal":181238,"en":"Mounted with perfect grace,"},{"id":"semetey-1-2013:p1363:b003:l001","ordinal":181239,"en":"Wearing armor no bullet pierced,"},{"id":"semetey-1-2013:p1363:b003:l002","ordinal":181240,"en":"Clad in deep-blue iron,"},{"id":"semetey-1-2013:p1363:b003:l003","ordinal":181241,"en":"When told he was going to Beijing,"},{"id":"semetey-1-2013:p1363:b003:l004","ordinal":181242,"en":"As though going to his in-laws,"},{"id":"semetey-1-2013:p1363:b003:l005","ordinal":181243,"en":"Ill-fated Külchoro"},{"id":"semetey-1-2013:p1363:b003:l006","ordinal":181244,"en":"Laughed openly in joy."},{"id":"semetey-1-2013:p1363:b003:l007","ordinal":181245,"en":"The sight stirred the heart;"},{"id":"semetey-1-2013:p1363:b003:l008","ordinal":181246,"en":"In the companion going to Beijing"},{"id":"semetey-1-2013:p1363:b003:l009","ordinal":181247,"en":"The aspect of a gray wolf appeared."},{"id":"semetey-1-2013:p1363:b003:l010","ordinal":181248,"en":"A gold-cheeked battle-axe"}]
