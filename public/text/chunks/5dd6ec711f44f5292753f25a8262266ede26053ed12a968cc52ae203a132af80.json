[{"id":"manas-2010:p0321:b001:l003","ordinal":14593,"en":"Not scatter their four kinds of livestock!"},{"id":"manas-2010:p0321:b001:l004","ordinal":14594,"en":"Let them not seize what is above,"},{"id":"manas-2010:p0321:b001:l005","ordinal":14595,"en":"Not burn and slaughter them!"},{"id":"manas-2010:p0321:b001:l006","ordinal":14596,"en":"With you yourself, the wolf-maned leopard, absent,"},{"id":"manas-2010:p0321:b001:l007","ordinal":14597,"en":"Let the courageous not die."},{"id":"manas-2010:p0321:b001:l008","ordinal":14598,"en":"All those who remain,"},{"id":"manas-2010:p0321:b001:l009","ordinal":14599,"en":"Let the Black Chinese and Manchus"},{"id":"manas-2010:p0321:b001:l010","ordinal":14600,"en":"Not divide them, measuring with a whip!"},{"id":"manas-2010:p0321:b001:l011","ordinal":14601,"en":"Let them not use their greater numbers."},{"id":"manas-2010:p0321:b001:l012","ordinal":14602,"en":"Before you reach your people,"},{"id":"manas-2010:p0321:b001:l013","ordinal":14603,"en":"Let them not seize their mounts!"},{"id":"manas-2010:p0321:b001:l014","ordinal":14604,"en":"Let them not bring all to ruin."},{"id":"manas-2010:p0321:b001:l015","ordinal":14605,"en":"Let the Black Kalmyks and Manchus"},{"id":"manas-2010:p0321:b001:l016","ordinal":14606,"en":"All the women and girls"},{"id":"manas-2010:p0321:b001:l017","ordinal":14607,"en":"Not carry off as booty!"},{"id":"manas-2010:p0321:b001:l018","ordinal":14608,"en":"Who will bring blessing to you,"},{"id":"manas-2010:p0321:b001:l019","ordinal":14609,"en":"Let them not slaughter Kutubiy."},{"id":"manas-2010:p0321:b001:l020","ordinal":14610,"en":"Who knows God's name by heart,"},{"id":"manas-2010:p0321:b001:l021","ordinal":14611,"en":"Who knows letters from studying the Quran,"},{"id":"manas-2010:p0321:b001:l022","ordinal":14612,"en":"Who has words finer than other mortals,"},{"id":"manas-2010:p0321:b001:l023","ordinal":14613,"en":"Kutubiy, Oshpur's son,"},{"id":"manas-2010:p0321:b001:l024","ordinal":14614,"en":"Your cherished companion, Manas,"},{"id":"manas-2010:p0321:b001:l025","ordinal":14615,"en":"He has the strength to become your shade!”"},{"id":"manas-2010:p0321:b001:l026","ordinal":14616,"en":"So Khan Koshoy said,"},{"id":"manas-2010:p0321:b001:l027","ordinal":14617,"en":"Teaching what was not known,"},{"id":"manas-2010:p0321:b001:l028","ordinal":14618,"en":"Setting Manas on his road."},{"id":"manas-2010:p0321:b001:l029","ordinal":14619,"en":"Saying “Amen!” and spreading his palms,"},{"id":"manas-2010:p0321:b001:l030","ordinal":14620,"en":"He gave many favorable blessings."},{"id":"manas-2010:p0321:b001:l031","ordinal":14621,"en":"Clasping his hand firmly,"},{"id":"manas-2010:p0321:b001:l032","ordinal":14622,"en":"Akbaltay and rich Jakyp,"},{"id":"manas-2010:p0321:b001:l033","ordinal":14623,"en":"A group headed by Kutubiy,"},{"id":"manas-2010:p0321:b001:l034","ordinal":14624,"en":"He entrusted to Khan Manas."},{"id":"manas-2010:p0321:b001:l035","ordinal":14625,"en":"“Against the Chinese like ants,"},{"id":"manas-2010:p0321:b001:l036","ordinal":14626,"en":"If you brawl rashly, it brings a bad name."},{"id":"manas-2010:p0321:b001:l037","ordinal":14627,"en":"The forty households driven into exile,"},{"id":"manas-2010:p0321:b001:l038","ordinal":14628,"en":"My lion, they are entrusted to you!"},{"id":"manas-2010:p0321:b001:l039","ordinal":14629,"en":"If death arrives and my days end,"},{"id":"manas-2010:p0321:b001:l040","ordinal":14630,"en":"Lion Manas, my wolf-maned one,"},{"id":"manas-2010:p0321:b001:l041","ordinal":14631,"en":"The lion Koshoy must die."},{"id":"manas-2010:p0321:b001:l042","ordinal":14632,"en":"If your elder Koshoy does not die,"},{"id":"manas-2010:p0321:b001:l043","ordinal":14633,"en":"If he does not see the hereafter,"},{"id":"manas-2010:p0321:b001:l044","ordinal":14634,"en":"When horses' tongues darken with grass,"},{"id":"manas-2010:p0321:b001:l045","ordinal":14635,"en":"Look for me in broad Altay!"},{"id":"manas-2010:p0321:b001:l046","ordinal":14636,"en":"The Kyrgyz are no idle people;"},{"id":"manas-2010:p0321:b001:l047","ordinal":14637,"en":"Without bringing a mighty slaughter,"},{"id":"manas-2010:p0321:b001:l048","ordinal":14638,"en":"I am not a Koshoy who will lie still!"},{"id":"manas-2010:p0322:b001:l001","ordinal":14639,"en":"If my death arrives, I will die."},{"id":"manas-2010:p0322:b001:l002","ordinal":14640,"en":"When the time comes and my days end,"},{"id":"manas-2010:p0322:b001:l003","ordinal":14641,"en":"I will see the face of the Last Judgment."},{"id":"manas-2010:p0322:b001:l004","ordinal":14642,"en":"Your elder Koshoy, blessed by Kydyr,"},{"id":"manas-2010:p0322:b001:l005","ordinal":14643,"en":"I will become your companion."},{"id":"manas-2010:p0322:b001:l006","ordinal":14644,"en":"Against the shouting Chinese"},{"id":"manas-2010:p0322:b001:l007","ordinal":14645,"en":"I will bring much gunfire."},{"id":"manas-2010:p0322:b001:l008","ordinal":14646,"en":"From the unbelievers like black spiders,"},{"id":"manas-2010:p0322:b001:l009","ordinal":14647,"en":"Bloodthirsty Manas, my foal,"},{"id":"manas-2010:p0322:b001:l010","ordinal":14648,"en":"I will set you free."},{"id":"manas-2010:p0322:b001:l011","ordinal":14649,"en":"I will see you where you are hard pressed;"},{"id":"manas-2010:p0322:b001:l012","ordinal":14650,"en":"Where you are battling fiercely,"},{"id":"manas-2010:p0322:b001:l013","ordinal":14651,"en":"Champion Manas, my foal,"},{"id":"manas-2010:p0322:b001:l014","ordinal":14652,"en":"I will become your protector.”"},{"id":"manas-2010:p0322:b001:l015","ordinal":14653,"en":"Saying “Amen!” and spreading his palms,"},{"id":"manas-2010:p0322:b001:l016","ordinal":14654,"en":"Your saintly elder Koshoy,"},{"id":"manas-2010:p0322:b001:l017","ordinal":14655,"en":"For a child like Khan Manas,"},{"id":"manas-2010:p0322:b001:l018","ordinal":14656,"en":"Ninety black bulls"},{"id":"manas-2010:p0322:b001:l019","ordinal":14657,"en":"He had slaughtered and cut up,"},{"id":"manas-2010:p0322:b001:l020","ordinal":14658,"en":"And gave them as an offering."},{"id":"manas-2010:p0322:b001:l021","ordinal":14659,"en":"A great gilded belt with pouches"},{"id":"manas-2010:p0322:b001:l022","ordinal":14660,"en":"They placed about the neck."},{"id":"manas-2010:p0322:b001:l023","ordinal":14661,"en":"Brave Koshoy, great as a mountain,"},{"id":"manas-2010:p0322:b001:l024","ordinal":14662,"en":"Prayed to the Creator."},{"id":"manas-2010:p0322:b001:l025","ordinal":14663,"en":"Striding straight ahead with a broad gait,"},{"id":"manas-2010:p0322:b001:l026","ordinal":14664,"en":"A spotless, pure white-gray mare"},{"id":"manas-2010:p0322:b001:l027","ordinal":14665,"en":"Your valiant Koshoy led:"},{"id":"manas-2010:p0322:b001:l028","ordinal":14666,"en":"“God, place the blood-spiller above,"},{"id":"manas-2010:p0322:b001:l029","ordinal":14667,"en":"God, place the Chinese beneath!"},{"id":"manas-2010:p0322:b001:l030","ordinal":14668,"en":"Creator, please grant your aid,"},{"id":"manas-2010:p0322:b001:l031","ordinal":14669,"en":"You made him a lion born a leopard,"},{"id":"manas-2010:p0322:b001:l032","ordinal":14670,"en":"Please give Manas your support!"},{"id":"manas-2010:p0322:b001:l033","ordinal":14671,"en":"You made him a support to bind about the waist,"},{"id":"manas-2010:p0322:b001:l034","ordinal":14672,"en":"The youngest of six lions,"},{"id":"manas-2010:p0322:b001:l035","ordinal":14673,"en":"God, support the lion!"},{"id":"manas-2010:p0322:b001:l036","ordinal":14674,"en":"The protector before us,"},{"id":"manas-2010:p0322:b001:l037","ordinal":14675,"en":"Sovereign God, giver of means,"},{"id":"manas-2010:p0322:b001:l038","ordinal":14676,"en":"You have given us as shelter"},{"id":"manas-2010:p0322:b001:l039","ordinal":14677,"en":"Such a protector as Manas!”"},{"id":"manas-2010:p0322:b001:l040","ordinal":14678,"en":"So your elder said,"},{"id":"manas-2010:p0322:b001:l041","ordinal":14679,"en":"And gave his blessing now."},{"id":"manas-2010:p0322:b001:l042","ordinal":14680,"en":"The white mare as big as a hut,"},{"id":"manas-2010:p0322:b001:l043","ordinal":14681,"en":"Your elder, the lion Koshoy,"},{"id":"manas-2010:p0322:b001:l044","ordinal":14682,"en":"He slaughtered as a sacrifice now."},{"id":"manas-2010:p0322:b001:l045","ordinal":14683,"en":"The wolf-maned champion Manas"},{"id":"manas-2010:p0322:b001:l046","ordinal":14684,"en":"He sent upon a pressing journey now."},{"id":"manas-2010:p0322:b001:l047","ordinal":14685,"en":"Mounting in wrath,"},{"id":"manas-2010:p0322:b001:l048","ordinal":14686,"en":"Bloodthirsty Manas then,"},{"id":"manas-2010:p0323:b001:l001","ordinal":14687,"en":"Received Khan Koshoy's blessing."},{"id":"manas-2010:p0323:b001:l002","ordinal":14688,"en":"The hearts of those who saw him were shaken,"},{"id":"manas-2010:p0323:b001:l003","ordinal":14689,"en":"His wolf-maned nature showed."},{"id":"manas-2010:p0323:b001:l004","ordinal":14690,"en":"Having heard the saintly man's words,"},{"id":"manas-2010:p0323:b001:l005","ordinal":14691,"en":"Your youngest uncle, Ulak Khan,"},{"id":"manas-2010:p0323:b001:l006","ordinal":14692,"en":"He heard was alive and well."},{"id":"manas-2010:p0323:b001:l007","ordinal":14693,"en":"Having found his greatly treasured land,"},{"id":"manas-2010:p0323:b001:l008","ordinal":14694,"en":"Having found his hero Koshoy, blessed by Kydyr,"},{"id":"manas-2010:p0323:b001:l009","ordinal":14695,"en":"Having heard Koshoy's words thoroughly,"},{"id":"manas-2010:p0323:b001:l010","ordinal":14696,"en":"That the dear Kyrgyz, from mountain to mountain,"},{"id":"manas-2010:p0323:b001:l011","ordinal":14697,"en":"Had vanished, he heard."},{"id":"manas-2010:p0323:b001:l012","ordinal":14698,"en":"“All the Kyrgyz, the forty households,"},{"id":"manas-2010:p0323:b001:l013","ordinal":14699,"en":"With my father Jakyp at their head,"},{"id":"manas-2010:p0323:b001:l014","ordinal":14700,"en":"Let me move them away."},{"id":"manas-2010:p0323:b001:l015","ordinal":14701,"en":"Of the cunning enemies I encounter,"},{"id":"manas-2010:p0323:b001:l016","ordinal":14702,"en":"Let me slaughter every one."},{"id":"manas-2010:p0323:b001:l017","ordinal":14703,"en":"The dear people who have vanished,"},{"id":"manas-2010:p0323:b001:l018","ordinal":14704,"en":"After I move back here,"},{"id":"manas-2010:p0323:b001:l019","ordinal":14705,"en":"Then let me gather them!”"},{"id":"manas-2010:p0323:b001:l020","ordinal":14706,"en":"So Khan Manas said,"},{"id":"manas-2010:p0323:b001:l021","ordinal":14707,"en":"Rumbling deeply as he gathered force,"},{"id":"manas-2010:p0323:b001:l022","ordinal":14708,"en":"The wolf-maned one spoke in a growl,"},{"id":"manas-2010:p0323:b001:l023","ordinal":14709,"en":"Looking to either side."},{"id":"manas-2010:p0323:b001:l024","ordinal":14710,"en":"A wolf-maned lion from the beginning,"},{"id":"manas-2010:p0323:b001:l025","ordinal":14711,"en":"Licking his lips and nose,"},{"id":"manas-2010:p0323:b001:l026","ordinal":14712,"en":"Seized by wrath,"},{"id":"manas-2010:p0323:b001:l027","ordinal":14713,"en":"Your champion born a blood-spiller"},{"id":"manas-2010:p0323:b001:l028","ordinal":14714,"en":"Lunged like a hungry lion."},{"id":"manas-2010:p0323:b001:l029","ordinal":14715,"en":"His bright teeth like gates,"},{"id":"manas-2010:p0323:b001:l030","ordinal":14716,"en":"Teeth unlike other people's,"},{"id":"manas-2010:p0323:b001:l031","ordinal":14717,"en":"Showed white and stood apart."},{"id":"manas-2010:p0323:b001:l032","ordinal":14718,"en":"The champion visited by Kydyr,"},{"id":"manas-2010:p0323:b001:l033","ordinal":14719,"en":"His wolf-maned nature showed."},{"id":"manas-2010:p0323:b001:l034","ordinal":14720,"en":"Toruchaar beneath him,"},{"id":"manas-2010:p0323:b001:l035","ordinal":14721,"en":"Laid back his ears like a wild ass,"},{"id":"manas-2010:p0323:b001:l036","ordinal":14722,"en":"Whirled up the earth like a whirlwind."},{"id":"manas-2010:p0323:b001:l037","ordinal":14723,"en":"The wind could not catch his trot;"},{"id":"manas-2010:p0323:b001:l038","ordinal":14724,"en":"He traveled alone to Altay."},{"id":"manas-2010:p0323:b001:l039","ordinal":14725,"en":"No beast could match his pace;"},{"id":"manas-2010:p0323:b001:l040","ordinal":14726,"en":"He traveled swiftly to Altay."},{"id":"manas-2010:p0323:b001:l041","ordinal":14727,"en":"Along the road he himself had seen,"},{"id":"manas-2010:p0323:b001:l042","ordinal":14728,"en":"Along streams and spring waters,"},{"id":"manas-2010:p0323:b001:l043","ordinal":14729,"en":"How could your hero spare himself?"},{"id":"manas-2010:p0323:b001:l044","ordinal":14730,"en":"The dark ridge, Tal-Mazar,"},{"id":"manas-2010:p0323:b001:l045","ordinal":14731,"en":"He drew near Tal-Mazar."},{"id":"manas-2010:p0323:b001:l046","ordinal":14732,"en":"He reached Tal-Mazar and camped."},{"id":"manas-2010:p0323:b001:l047","ordinal":14733,"en":"That day your lion elder"},{"id":"manas-2010:p0323:b001:l048","ordinal":14734,"en":"Was a guest at the shrine."},{"id":"manas-2010:p0324:b001:l001","ordinal":14735,"en":"Let us leave this here,"},{"id":"manas-2010:p0324:b001:l002","ordinal":14736,"en":"Let us begin news from the other side."},{"id":"manas-2010:p0324:b001:l003","ordinal":14737,"en":"To the royal throne"},{"id":"manas-2010:p0324:b001:l004","ordinal":14738,"en":"The giant Döödür had gone,"},{"id":"manas-2010:p0324:b001:l005","ordinal":14739,"en":"Before Esenkan."},{"id":"manas-2010:p0324:b001:l006","ordinal":14740,"en":"He bore the name of a wrathful khan."},{"id":"manas-2010:p0324:b001:l007","ordinal":14741,"en":"Before their great ones,"},{"id":"manas-2010:p0324:b001:l008","ordinal":14742,"en":"To bow like women,"},{"id":"manas-2010:p0324:b001:l009","ordinal":14743,"en":"Such is the custom of the Chinese."},{"id":"manas-2010:p0324:b001:l010","ordinal":14744,"en":"Döödür came panting,"},{"id":"manas-2010:p0324:b001:l011","ordinal":14745,"en":"Having taken a beating from brave Manas,"},{"id":"manas-2010:p0324:b001:l012","ordinal":14746,"en":"Shouting as he bellowed,"},{"id":"manas-2010:p0324:b001:l013","ordinal":14747,"en":"Bending down the tops of apricot trees."},{"id":"manas-2010:p0324:b001:l014","ordinal":14748,"en":"His shout split heads,"},{"id":"manas-2010:p0324:b001:l015","ordinal":14749,"en":"His bellow split stones."},{"id":"manas-2010:p0324:b001:l016","ordinal":14750,"en":"In utter confusion and dust,"},{"id":"manas-2010:p0324:b001:l017","ordinal":14751,"en":"His whole head and eyes"},{"id":"manas-2010:p0324:b001:l018","ordinal":14752,"en":"Were a red bucketful of blood."},{"id":"manas-2010:p0324:b001:l019","ordinal":14753,"en":"All around were plane-tree gardens,"},{"id":"manas-2010:p0324:b001:l020","ordinal":14754,"en":"In their midst a golden throne."},{"id":"manas-2010:p0324:b001:l021","ordinal":14755,"en":"Before that throne,"},{"id":"manas-2010:p0324:b001:l022","ordinal":14756,"en":"A great carpet laid for leisure,"},{"id":"manas-2010:p0324:b001:l023","ordinal":14757,"en":"Woven entirely of silk,"},{"id":"manas-2010:p0324:b001:l024","ordinal":14758,"en":"A mortal feared to tread upon it."},{"id":"manas-2010:p0324:b001:l025","ordinal":14759,"en":"A great carpet of golden hue,"},{"id":"manas-2010:p0324:b001:l026","ordinal":14760,"en":"If soaked in water forty years,"},{"id":"manas-2010:p0324:b001:l027","ordinal":14761,"en":"Its surface would not discolor or fade."},{"id":"manas-2010:p0324:b001:l028","ordinal":14762,"en":"If left in floods eighty years,"},{"id":"manas-2010:p0324:b001:l029","ordinal":14763,"en":"It would not fray, rot, or fade."},{"id":"manas-2010:p0324:b001:l030","ordinal":14764,"en":"On his carpet-laid throne,"},{"id":"manas-2010:p0324:b001:l031","ordinal":14765,"en":"Esenkan sat,"},{"id":"manas-2010:p0324:b001:l032","ordinal":14766,"en":"On his royal throne."},{"id":"manas-2010:p0324:b001:l033","ordinal":14767,"en":"Before Esenkan,"},{"id":"manas-2010:p0324:b001:l034","ordinal":14768,"en":"Beaded cap-knobs and coral stones,"},{"id":"manas-2010:p0324:b001:l035","ordinal":14769,"en":"Such were the raging Chinese,"},{"id":"manas-2010:p0324:b001:l036","ordinal":14770,"en":"The khan of Zungtung among them."},{"id":"manas-2010:p0324:b001:l037","ordinal":14771,"en":"There were khans wearing armor,"},{"id":"manas-2010:p0324:b001:l038","ordinal":14772,"en":"With their arm guards spread wide,"},{"id":"manas-2010:p0324:b001:l039","ordinal":14773,"en":"All his governors were there."},{"id":"manas-2010:p0324:b001:l040","ordinal":14774,"en":"Running before the khan,"},{"id":"manas-2010:p0324:b001:l041","ordinal":14775,"en":"The giant Döödür arrived."},{"id":"manas-2010:p0324:b001:l042","ordinal":14776,"en":"As soon as he arrived, that Döödür"},{"id":"manas-2010:p0324:b001:l043","ordinal":14777,"en":"Brought news to his khan:"},{"id":"manas-2010:p0324:b001:l044","ordinal":14778,"en":"“This is what happened, listen."},{"id":"manas-2010:p0324:b001:l045","ordinal":14779,"en":"We suffered slaughter by the blood-spiller;"},{"id":"manas-2010:p0324:b001:l046","ordinal":14780,"en":"My precious one, my khan, listen!"},{"id":"manas-2010:p0324:b001:l047","ordinal":14781,"en":"His bulk is equal to a mountain."},{"id":"manas-2010:p0324:b001:l048","ordinal":14782,"en":"Against that bastard blood-spiller,"},{"id":"manas-2010:p0325:b001:l001","ordinal":14783,"en":"Whoever fought him seemed bound to die."},{"id":"manas-2010:p0325:b001:l002","ordinal":14784,"en":"He swept away all the giants,"},{"id":"manas-2010:p0325:b001:l003","ordinal":14785,"en":"He laid low all the heroes."},{"id":"manas-2010:p0325:b001:l004","ordinal":14786,"en":"None who grappled with him survived."},{"id":"manas-2010:p0325:b001:l005","ordinal":14787,"en":"Of those who went to provoke him,"},{"id":"manas-2010:p0325:b001:l006","ordinal":14788,"en":"He left not one, he laid them low."},{"id":"manas-2010:p0325:b001:l007","ordinal":14789,"en":"Döngö and the giant Kaman,"},{"id":"manas-2010:p0325:b001:l008","ordinal":14790,"en":"Scissor-Ears was there as well,"},{"id":"manas-2010:p0325:b001:l009","ordinal":14791,"en":"He seized a good many."},{"id":"manas-2010:p0325:b001:l010","ordinal":14792,"en":"That ill-omened blood-spiller,"},{"id":"manas-2010:p0325:b001:l011","ordinal":14793,"en":"None who met him survived."},{"id":"manas-2010:p0325:b001:l012","ordinal":14794,"en":"Your trusted giant Döngö,"},{"id":"manas-2010:p0325:b001:l013","ordinal":14795,"en":"That Burut slaughtered him,"},{"id":"manas-2010:p0325:b001:l014","ordinal":14796,"en":"And your people without leaving one."},{"id":"manas-2010:p0325:b001:l015","ordinal":14797,"en":"He killed many of your men."},{"id":"manas-2010:p0325:b001:l016","ordinal":14798,"en":"The wretch took as booty"},{"id":"manas-2010:p0325:b001:l017","ordinal":14799,"en":"Forty camels' loads of gold, your livestock."},{"id":"manas-2010:p0325:b001:l018","ordinal":14800,"en":"He diminished the headmen."},{"id":"manas-2010:p0325:b001:l019","ordinal":14801,"en":"All those who provoked him,"},{"id":"manas-2010:p0325:b001:l020","ordinal":14802,"en":"He struck them to the ground and left them stretched out."},{"id":"manas-2010:p0325:b001:l021","ordinal":14803,"en":"He brought turmoil upon the wrestlers."},{"id":"manas-2010:p0325:b001:l022","ordinal":14804,"en":"That bastard blood-spiller,"},{"id":"manas-2010:p0325:b001:l023","ordinal":14805,"en":"Until we reach the Last Judgment,"},{"id":"manas-2010:p0325:b001:l024","ordinal":14806,"en":"He made a tale we shall not forget."},{"id":"manas-2010:p0325:b001:l025","ordinal":14807,"en":"Your many wrestlers as big as houses,"},{"id":"manas-2010:p0325:b001:l026","ordinal":14808,"en":"Those of you who went against him,"},{"id":"manas-2010:p0325:b001:l027","ordinal":14809,"en":"Fell tumbling from their horses."},{"id":"manas-2010:p0325:b001:l028","ordinal":14810,"en":"That bastard Burut,"},{"id":"manas-2010:p0325:b001:l029","ordinal":14811,"en":"When Baltay struck in wrath,"},{"id":"manas-2010:p0325:b001:l030","ordinal":14812,"en":"Fur hats flew rattling."},{"id":"manas-2010:p0325:b001:l031","ordinal":14813,"en":"The heads of those who came,"},{"id":"manas-2010:p0325:b001:l032","ordinal":14814,"en":"The axe struck, scattering them."},{"id":"manas-2010:p0325:b001:l033","ordinal":14815,"en":"All those who went,"},{"id":"manas-2010:p0325:b001:l034","ordinal":14816,"en":"Their souls left them with a shriek!"},{"id":"manas-2010:p0325:b001:l035","ordinal":14817,"en":"Does it rest from man to man?"},{"id":"manas-2010:p0325:b001:l036","ordinal":14818,"en":"That bastard Burut's"},{"id":"manas-2010:p0325:b001:l037","ordinal":14819,"en":"Trouble reached Beijing."},{"id":"manas-2010:p0325:b001:l038","ordinal":14820,"en":"That Burut, may he burn,"},{"id":"manas-2010:p0325:b001:l039","ordinal":14821,"en":"‘My child's name is Madman,’ they said."},{"id":"manas-2010:p0325:b001:l040","ordinal":14822,"en":"The name given was Great Madman;"},{"id":"manas-2010:p0325:b001:l041","ordinal":14823,"en":"Who knew he was Manas?"},{"id":"manas-2010:p0325:b001:l042","ordinal":14824,"en":"He began a fierce onslaught,"},{"id":"manas-2010:p0325:b001:l043","ordinal":14825,"en":"Left those who came sprawled out,"},{"id":"manas-2010:p0325:b001:l044","ordinal":14826,"en":"And slaughtered them all."},{"id":"manas-2010:p0325:b001:l045","ordinal":14827,"en":"Smashing the stone-badged men,"},{"id":"manas-2010:p0325:b001:l046","ordinal":14828,"en":"He raised a thorough uproar."},{"id":"manas-2010:p0325:b001:l047","ordinal":14829,"en":"Attacking those who wore jackets,"},{"id":"manas-2010:p0325:b001:l048","ordinal":14830,"en":"The blood-spiller brought grief,"},{"id":"manas-2010:p0326:b001:l001","ordinal":14831,"en":"Making them all crumple,"},{"id":"manas-2010:p0326:b001:l002","ordinal":14832,"en":"He slaughtered them on the open steppe."},{"id":"manas-2010:p0326:b001:l003","ordinal":14833,"en":"He swallowed the renowned,"},{"id":"manas-2010:p0326:b001:l004","ordinal":14834,"en":"None who faced him survived."},{"id":"manas-2010:p0326:b001:l005","ordinal":14835,"en":"He bent the valiant men double."},{"id":"manas-2010:p0326:b001:l006","ordinal":14836,"en":"Those who went to face him,"},{"id":"manas-2010:p0326:b001:l007","ordinal":14837,"en":"He slaughtered all and left them staring."},{"id":"manas-2010:p0326:b001:l008","ordinal":14838,"en":"He began a fierce onslaught."},{"id":"manas-2010:p0326:b001:l009","ordinal":14839,"en":"Khan Esenkan, this is my appeal to you—"},{"id":"manas-2010:p0326:b001:l010","ordinal":14840,"en":"He slaughtered your people!"},{"id":"manas-2010:p0326:b001:l011","ordinal":14841,"en":"He seized your governor."},{"id":"manas-2010:p0326:b001:l012","ordinal":14842,"en":"Of the Chinese with rank buttons on their caps,"},{"id":"manas-2010:p0326:b001:l013","ordinal":14843,"en":"Not one remained at all."},{"id":"manas-2010:p0326:b001:l014","ordinal":14844,"en":"There was no one who could withstand him."},{"id":"manas-2010:p0326:b001:l015","ordinal":14845,"en":"The wrestlers who went were distraught;"},{"id":"manas-2010:p0326:b001:l016","ordinal":14846,"en":"He began a terrible calamity."},{"id":"manas-2010:p0326:b001:l017","ordinal":14847,"en":"All those who went,"},{"id":"manas-2010:p0326:b001:l018","ordinal":14848,"en":"He slaughtered utterly!"}]
