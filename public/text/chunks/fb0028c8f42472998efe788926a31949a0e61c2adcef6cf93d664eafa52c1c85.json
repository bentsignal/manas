[{"id":"semetey-1-2013:p1122:b003:l006","ordinal":161793,"en":"And seize and restrain Manas,"},{"id":"semetey-1-2013:p1122:b003:l007","ordinal":161794,"en":"He has unleashed havoc"},{"id":"semetey-1-2013:p1122:b003:l008","ordinal":161795,"en":"And taken plunder worth my thousand camels!"},{"id":"semetey-1-2013:p1122:b003:l009","ordinal":161796,"en":"If you do not finish Manas,"},{"id":"semetey-1-2013:p1122:b003:l010","ordinal":161797,"en":"He has inflicted harsh suffering,\" he said."},{"id":"semetey-1-2013:p1122:b003:l011","ordinal":161798,"en":"Before Esenkan,"},{"id":"semetey-1-2013:p1122:b003:l012","ordinal":161799,"en":"He went straight in and spoke these words."},{"id":"semetey-1-2013:p1122:b003:l013","ordinal":161800,"en":"Esenkan grew angry:"},{"id":"semetey-1-2013:p1122:b003:l014","ordinal":161801,"en":"\"If you cannot overcome Manas,"},{"id":"semetey-1-2013:p1122:b003:l015","ordinal":161802,"en":"All of you perish together!\" he said."},{"id":"semetey-1-2013:p1122:b003:l016","ordinal":161803,"en":"In wrath, Esenkan"},{"id":"semetey-1-2013:p1122:b003:l017","ordinal":161804,"en":"Drove him away."},{"id":"semetey-1-2013:p1122:b004:l001","ordinal":161805,"en":"Shamed, Ezkara"},{"id":"semetey-1-2013:p1122:b004:l002","ordinal":161806,"en":"Said, \"Damn you, Burut,\""},{"id":"semetey-1-2013:p1122:b004:l003","ordinal":161807,"en":"And the ill-starred wretch held a grudge"},{"id":"semetey-1-2013:p1122:b004:l004","ordinal":161808,"en":"Against hero Manas."},{"id":"semetey-1-2013:p1122:b004:l005","ordinal":161809,"en":"He came to Kökötöy's feast"},{"id":"semetey-1-2013:p1122:b004:l006","ordinal":161810,"en":"To stir up conflict,"},{"id":"semetey-1-2013:p1122:b004:l007","ordinal":161811,"en":"Hoping to utterly strike down"},{"id":"semetey-1-2013:p1122:b004:l008","ordinal":161812,"en":"The handful of Kyrgyz;"},{"id":"semetey-1-2013:p1122:b004:l009","ordinal":161813,"en":"Thus Ezkara came speaking,"},{"id":"semetey-1-2013:p1122:b004:l010","ordinal":161814,"en":"For the Chinese bore a grudge."},{"id":"semetey-1-2013:p1122:b004:l011","ordinal":161815,"en":"With Khan Kongurbay at their head,"},{"id":"semetey-1-2013:p1122:b004:l012","ordinal":161816,"en":"They were poised to swarm upon"},{"id":"semetey-1-2013:p1122:b004:l013","ordinal":161817,"en":"The handful of Muslims."},{"id":"semetey-1-2013:p1122:b004:l014","ordinal":161818,"en":"Kökötöy's many wethers"},{"id":"semetey-1-2013:p1122:b004:l015","ordinal":161819,"en":"And countless horses spread like a lake—"},{"id":"semetey-1-2013:p1122:b004:l016","ordinal":161820,"en":"Bokmurun drove them all together"},{"id":"semetey-1-2013:p1122:b004:l017","ordinal":161821,"en":"And gave them for slaughter."},{"id":"semetey-1-2013:p1122:b006:l001","ordinal":161822,"en":"Shouting angrily,"},{"id":"semetey-1-2013:p1122:b006:l002","ordinal":161823,"en":"He summoned Bokmurun;"},{"id":"semetey-1-2013:p1122:b006:l003","ordinal":161824,"en":"These were Ezkara's words."},{"id":"semetey-1-2013:p1122:b006:l004","ordinal":161825,"en":"When Bokmurun came and bowed,"},{"id":"semetey-1-2013:p1122:b006:l005","ordinal":161826,"en":"He spoke as follows:"},{"id":"semetey-1-2013:p1122:b006:l006","ordinal":161827,"en":"\"I shall eat my fill at your feast, Burut;"},{"id":"semetey-1-2013:p1122:b006:l007","ordinal":161828,"en":"Bringing torment upon your feast,"},{"id":"semetey-1-2013:p1122:b006:l008","ordinal":161829,"en":"I shall raid your village, Burut!"},{"id":"semetey-1-2013:p1122:b006:l009","ordinal":161830,"en":"I shall bring hell upon your feast, Burut;"},{"id":"semetey-1-2013:p1122:b006:l010","ordinal":161831,"en":"I shall strike down your company, Burut!"},{"id":"semetey-1-2013:p1122:b006:l011","ordinal":161832,"en":"You have migrated from broad Tashken, Burut;"},{"id":"semetey-1-2013:p1122:b006:l012","ordinal":161833,"en":"Your braid woven in six strands, Burut—"},{"id":"semetey-1-2013:p1122:b006:l013","ordinal":161834,"en":"Saying, 'Whoever would not come to the feast,"},{"id":"semetey-1-2013:p1122:b006:l014","ordinal":161835,"en":"I shall go and strike him down,'"},{"id":"semetey-1-2013:p1122:b006:l015","ordinal":161836,"en":"You brandished your strength, Burut."},{"id":"semetey-1-2013:p1122:b006:l016","ordinal":161837,"en":"When I surge, I shall crush your strength, Burut;"},{"id":"semetey-1-2013:p1122:b006:l017","ordinal":161838,"en":"I shall darken your very roots, Burut."},{"id":"semetey-1-2013:p1122:b007:l001","ordinal":161839,"en":"I have come with a vast army to strike"},{"id":"semetey-1-2013:p1122:b007:l002","ordinal":161840,"en":"Your far-flung fury, Burut."},{"id":"semetey-1-2013:p1122:b007:l003","ordinal":161841,"en":"I shall rain upon your head"},{"id":"semetey-1-2013:p1122:b007:l004","ordinal":161842,"en":"My winter in the summertime, Burut."},{"id":"semetey-1-2013:p1122:b007:l005","ordinal":161843,"en":"I shall raid and seize your feast,"},{"id":"semetey-1-2013:p1122:b007:l006","ordinal":161844,"en":"And crush all your far-flung deeds,"},{"id":"semetey-1-2013:p1122:b007:l007","ordinal":161845,"en":"Burut!"},{"id":"semetey-1-2013:p1122:b007:l008","ordinal":161846,"en":"At the feast I shall dig"},{"id":"semetey-1-2013:p1122:b007:l009","ordinal":161847,"en":"The pit into which you will fall, Burut."},{"id":"semetey-1-2013:p1122:b007:l010","ordinal":161848,"en":"If I grow angry now,"},{"id":"semetey-1-2013:p1122:b007:l011","ordinal":161849,"en":"I shall send my army swarming, Burut,"},{"id":"semetey-1-2013:p1122:b007:l012","ordinal":161850,"en":"Upon this very place where you hold the feast!"},{"id":"semetey-1-2013:p1122:b007:l013","ordinal":161851,"en":"Is the one in whom you place such trust"},{"id":"semetey-1-2013:p1122:b007:l014","ordinal":161852,"en":"Your bloodthirsty hero Manas?"},{"id":"semetey-1-2013:p1122:b007:l015","ordinal":161853,"en":"I shall plunge my hand into the cauldron, Burut,"},{"id":"semetey-1-2013:p1122:b007:l016","ordinal":161854,"en":"And plunder your meat, Burut!"},{"id":"semetey-1-2013:p1122:b007:l017","ordinal":161855,"en":"I shall lay hands upon your leader, Burut,"},{"id":"semetey-1-2013:p1123:b003:l001","ordinal":161856,"en":"I shall plunder your fatty meat, Burut!"},{"id":"semetey-1-2013:p1123:b003:l002","ordinal":161857,"en":"I shall stride far—make room, Burut;"},{"id":"semetey-1-2013:p1123:b003:l003","ordinal":161858,"en":"Prepare now what I have demanded, Burut!"},{"id":"semetey-1-2013:p1123:b003:l004","ordinal":161859,"en":"If you will not prepare it, speak your words, Burut;"},{"id":"semetey-1-2013:p1123:b003:l005","ordinal":161860,"en":"Name the place where you will fight, Burut!\""},{"id":"semetey-1-2013:p1123:b003:l006","ordinal":161861,"en":"Speaking wrathful words, Ezkara"},{"id":"semetey-1-2013:p1123:b003:l007","ordinal":161862,"en":"Turned aside and raised a cloud of pale dust;"},{"id":"semetey-1-2013:p1123:b003:l008","ordinal":161863,"en":"Playing a pipe made of pale brass,"},{"id":"semetey-1-2013:p1123:b003:l009","ordinal":161864,"en":"He galloped away on Chongküröng."},{"id":"semetey-1-2013:p1123:b003:l010","ordinal":161865,"en":"To Kongurbay and Zholoy,"},{"id":"semetey-1-2013:p1123:b003:l011","ordinal":161866,"en":"He came for counsel."},{"id":"semetey-1-2013:p1123:b003:l012","ordinal":161867,"en":"\"Hey, Kongurbay, great Zholoy,"},{"id":"semetey-1-2013:p1123:b003:l013","ordinal":161868,"en":"I shall settle accounts"},{"id":"semetey-1-2013:p1123:b003:l014","ordinal":161869,"en":"With these foolish Kyrgyz Burut."},{"id":"semetey-1-2013:p1123:b003:l015","ordinal":161870,"en":"Let us not stand watching their feast;"},{"id":"semetey-1-2013:p1123:b003:l016","ordinal":161871,"en":"Let us test how many giants they have."},{"id":"semetey-1-2013:p1123:b003:l017","ordinal":161872,"en":"If their giants have no strength,"},{"id":"semetey-1-2013:p1123:b003:l018","ordinal":161873,"en":"Let us thrust spears into their feast"},{"id":"semetey-1-2013:p1123:b003:l019","ordinal":161874,"en":"And slaughter every one without remainder."},{"id":"semetey-1-2013:p1123:b003:l020","ordinal":161875,"en":"Let us seize their racehorses;"},{"id":"semetey-1-2013:p1123:b003:l021","ordinal":161876,"en":"Here in the midst of this feast,"},{"id":"semetey-1-2013:p1123:b003:l022","ordinal":161877,"en":"Let us firmly unleash disorder."},{"id":"semetey-1-2013:p1123:b003:l023","ordinal":161878,"en":"Let us plunder their cooking hearths"},{"id":"semetey-1-2013:p1123:b003:l024","ordinal":161879,"en":"And beat those who have come."},{"id":"semetey-1-2013:p1123:b003:l025","ordinal":161880,"en":"Let us trample the place of the feast"},{"id":"semetey-1-2013:p1123:b003:l026","ordinal":161881,"en":"And swarm upon the servants"},{"id":"semetey-1-2013:p1123:b003:l027","ordinal":161882,"en":"Who sit cooking the meat."},{"id":"semetey-1-2013:p1123:b003:l028","ordinal":161883,"en":"Speaking taunting, chilling words,"},{"id":"semetey-1-2013:p1123:b003:l029","ordinal":161884,"en":"Calling them bastard Burut,"},{"id":"semetey-1-2013:p1123:b003:l030","ordinal":161885,"en":"Wearing shameless coats,"},{"id":"semetey-1-2013:p1123:b003:l031","ordinal":161886,"en":"Let us jostle and attack them."},{"id":"semetey-1-2013:p1123:b003:l032","ordinal":161887,"en":"Let us utterly plunder"},{"id":"semetey-1-2013:p1123:b003:l033","ordinal":161888,"en":"The spectacle-loving Burut."},{"id":"semetey-1-2013:p1123:b003:l034","ordinal":161889,"en":"Let us stop the feast they have given,"},{"id":"semetey-1-2013:p1123:b003:l035","ordinal":161890,"en":"Push aside their leaders,"},{"id":"semetey-1-2013:p1123:b003:l036","ordinal":161891,"en":"And take possession of all their livestock."},{"id":"semetey-1-2013:p1123:b003:l037","ordinal":161892,"en":"Whoever resists,"},{"id":"semetey-1-2013:p1123:b003:l038","ordinal":161893,"en":"Let us slaughter utterly, leaving none;"},{"id":"semetey-1-2013:p1123:b003:l039","ordinal":161894,"en":"The meek who know no words,"},{"id":"semetey-1-2013:p1123:b005:l001","ordinal":161895,"en":"Let us bind them alive"},{"id":"semetey-1-2013:p1123:b005:l002","ordinal":161896,"en":"And make them denekul"},{"id":"semetey-1-2013:p1123:b005:l003","ordinal":161897,"en":"In the land of Kakan-Chyn.\""},{"id":"semetey-1-2013:p1123:b005:l004","ordinal":161898,"en":"When their khan spoke thus,"},{"id":"semetey-1-2013:p1123:b005:l005","ordinal":161899,"en":"Would the mass of black commoners"},{"id":"semetey-1-2013:p1123:b005:l006","ordinal":161900,"en":"Merely stand and watch?"},{"id":"semetey-1-2013:p1123:b005:l007","ordinal":161901,"en":"Would God strike the people"},{"id":"semetey-1-2013:p1123:b005:l008","ordinal":161902,"en":"For standing still and watching?"},{"id":"semetey-1-2013:p1123:b005:l009","ordinal":161903,"en":"The Chinese and Kalmyk champions"},{"id":"semetey-1-2013:p1123:b005:l010","ordinal":161904,"en":"Fell upon Kökötöy's meat-cooking hearth"},{"id":"semetey-1-2013:p1123:b005:l011","ordinal":161905,"en":"And began plundering it."},{"id":"semetey-1-2013:p1123:b005:l012","ordinal":161906,"en":"Not allowing the plunder to pass,"},{"id":"semetey-1-2013:p1123:b005:l013","ordinal":161907,"en":"They beat the servants."},{"id":"semetey-1-2013:p1123:b005:l014","ordinal":161908,"en":"The black Kalmyks and Manchu people—"},{"id":"semetey-1-2013:p1123:b005:l015","ordinal":161909,"en":"Their multitude was ten thousand black worms."},{"id":"semetey-1-2013:p1123:b005:l016","ordinal":161910,"en":"They gathered together,"},{"id":"semetey-1-2013:p1123:b005:l017","ordinal":161911,"en":"Fighting over uncooked meat."},{"id":"semetey-1-2013:p1123:b005:l018","ordinal":161912,"en":"The stronger among them"},{"id":"semetey-1-2013:p1123:b005:l019","ordinal":161913,"en":"Snatched it thundering from the weak;"},{"id":"semetey-1-2013:p1123:b005:l020","ordinal":161914,"en":"Unable to understand one another's speech,"},{"id":"semetey-1-2013:p1123:b005:l021","ordinal":161915,"en":"They stuffed it into sacks."},{"id":"semetey-1-2013:p1123:b005:l022","ordinal":161916,"en":"Those teeming Chinese had grown up indoors,"},{"id":"semetey-1-2013:p1123:b005:l023","ordinal":161917,"en":"A people who had never seen the outside."},{"id":"semetey-1-2013:p1123:b005:l024","ordinal":161918,"en":"The snarling infidels"},{"id":"semetey-1-2013:p1123:b005:l025","ordinal":161919,"en":"Never before, at any time,"},{"id":"semetey-1-2013:p1123:b005:l026","ordinal":161920,"en":"Had been a people who saw meat."},{"id":"semetey-1-2013:p1123:b005:l027","ordinal":161921,"en":"From the middle of some meat,"},{"id":"semetey-1-2013:p1123:b005:l028","ordinal":161922,"en":"Dark blood glistened;"},{"id":"semetey-1-2013:p1123:b005:l029","ordinal":161923,"en":"At the edge of some meat,"},{"id":"semetey-1-2013:p1123:b005:l030","ordinal":161924,"en":"Bloody foam seethed."},{"id":"semetey-1-2013:p1123:b005:l031","ordinal":161925,"en":"The black Kalmyks snarled,"},{"id":"semetey-1-2013:p1123:b005:l032","ordinal":161926,"en":"Not knowing it was blood."},{"id":"semetey-1-2013:p1123:b005:l033","ordinal":161927,"en":"The foolish Chinese fumed,"},{"id":"semetey-1-2013:p1123:b005:l034","ordinal":161928,"en":"Not knowing it was blood;"},{"id":"semetey-1-2013:p1123:b005:l035","ordinal":161929,"en":"They did not know it was raw."},{"id":"semetey-1-2013:p1123:b005:l036","ordinal":161930,"en":"Fighting over bloody meat,"},{"id":"semetey-1-2013:p1123:b005:l037","ordinal":161931,"en":"The smiling wretches"},{"id":"semetey-1-2013:p1123:b005:l038","ordinal":161932,"en":"Beat one another with bones."},{"id":"semetey-1-2013:p1123:b005:l039","ordinal":161933,"en":"Kökötöy's servants,"},{"id":"semetey-1-2013:p1124:b003:l001","ordinal":161934,"en":"Losing their wits,"},{"id":"semetey-1-2013:p1124:b003:l002","ordinal":161935,"en":"Abandoned the cauldrons"},{"id":"semetey-1-2013:p1124:b003:l003","ordinal":161936,"en":"And fled toward the mountains."},{"id":"semetey-1-2013:p1124:b003:l004","ordinal":161937,"en":"The pale-mottled red banners—"},{"id":"semetey-1-2013:p1124:b003:l005","ordinal":161938,"en":"The wailing Chinese"},{"id":"semetey-1-2013:p1124:b003:l006","ordinal":161939,"en":"Raised unceasing tumult."},{"id":"semetey-1-2013:p1124:b003:l007","ordinal":161940,"en":"They fell upon the meat,"},{"id":"semetey-1-2013:p1124:b003:l008","ordinal":161941,"en":"And all was confusion."},{"id":"semetey-1-2013:p1124:b003:l009","ordinal":161942,"en":"The Muslims who saw this"},{"id":"semetey-1-2013:p1124:b003:l010","ordinal":161943,"en":"Lost their wits,"},{"id":"semetey-1-2013:p1124:b003:l011","ordinal":161944,"en":"And fled to ask aid"},{"id":"semetey-1-2013:p1124:b003:l012","ordinal":161945,"en":"From Koshoy and Töshtük."},{"id":"semetey-1-2013:p1124:b003:l013","ordinal":161946,"en":"They rushed about in panic,"},{"id":"semetey-1-2013:p1124:b003:l014","ordinal":161947,"en":"Unable to find their bearings."},{"id":"semetey-1-2013:p1124:b003:l015","ordinal":161948,"en":"The Muslims lost their senses;"},{"id":"semetey-1-2013:p1124:b003:l016","ordinal":161949,"en":"Kökötöy's Bokmurun—"},{"id":"semetey-1-2013:p1124:b003:l017","ordinal":161950,"en":"They cursed his mother and father."},{"id":"semetey-1-2013:p1124:b003:l018","ordinal":161951,"en":"Fleeing, bolting, and running,"},{"id":"semetey-1-2013:p1124:b003:l019","ordinal":161952,"en":"The Muslims reeled in panic,"},{"id":"semetey-1-2013:p1124:b003:l020","ordinal":161953,"en":"Despairing of their dear lives."},{"id":"semetey-1-2013:p1124:b003:l021","ordinal":161954,"en":"Ezkara, khan of the Manchus,"},{"id":"semetey-1-2013:p1124:b003:l022","ordinal":161955,"en":"Raged on Chongküröng;"},{"id":"semetey-1-2013:p1124:b003:l023","ordinal":161956,"en":"The peerless, cunning diviner"},{"id":"semetey-1-2013:p1124:b003:l024","ordinal":161957,"en":"Prepared to test the heroes."},{"id":"semetey-1-2013:p1124:b003:l025","ordinal":161958,"en":"He wrapped himself in his armored coat"},{"id":"semetey-1-2013:p1124:b003:l026","ordinal":161959,"en":"And girded his unsheathed sword."},{"id":"semetey-1-2013:p1124:b003:l027","ordinal":161960,"en":"If you had seen Ezkara,"},{"id":"semetey-1-2013:p1124:b003:l028","ordinal":161961,"en":"He raged like a blue boar."},{"id":"semetey-1-2013:p1124:b003:l029","ordinal":161962,"en":"The hero Manas was not there;"},{"id":"semetey-1-2013:p1124:b003:l030","ordinal":161963,"en":"If the chance arose, Ezkara"},{"id":"semetey-1-2013:p1124:b003:l031","ordinal":161964,"en":"Prepared to slaughter"},{"id":"semetey-1-2013:p1124:b003:l032","ordinal":161965,"en":"All the Muslims."},{"id":"semetey-1-2013:p1124:b003:l033","ordinal":161966,"en":"Ezkara, khan of the infidels,"},{"id":"semetey-1-2013:p1124:b003:l034","ordinal":161967,"en":"Had a form as great as half a mountain;"},{"id":"semetey-1-2013:p1124:b003:l035","ordinal":161968,"en":"Were there no means from Khan Manas,"},{"id":"semetey-1-2013:p1124:b003:l036","ordinal":161969,"en":"He looked able to devour"},{"id":"semetey-1-2013:p1124:b003:l037","ordinal":161970,"en":"All the Muslims without remainder."},{"id":"semetey-1-2013:p1124:b003:l038","ordinal":161971,"en":"His fangs protruding,"},{"id":"semetey-1-2013:p1124:b003:l039","ordinal":161972,"en":"He slowly gathered"},{"id":"semetey-1-2013:p1124:b004:l001","ordinal":161973,"en":"Every swift horse"},{"id":"semetey-1-2013:p1124:b004:l002","ordinal":161974,"en":"And placed them in procession."},{"id":"semetey-1-2013:p1124:b004:l003","ordinal":161975,"en":"Leaving no Muslim aside,"},{"id":"semetey-1-2013:p1124:b004:l004","ordinal":161976,"en":"Did you see him gather their heroes?"},{"id":"semetey-1-2013:p1124:b004:l005","ordinal":161977,"en":"He gathered their heroes,"},{"id":"semetey-1-2013:p1124:b004:l006","ordinal":161978,"en":"Placed great Koshoy at their head,"},{"id":"semetey-1-2013:p1124:b004:l007","ordinal":161979,"en":"And arranged them in procession."},{"id":"semetey-1-2013:p1124:b004:l008","ordinal":161980,"en":"Khan Koshoy of the Katagan—"},{"id":"semetey-1-2013:p1124:b004:l009","ordinal":161981,"en":"He looked upon and assessed him:"},{"id":"semetey-1-2013:p1124:b004:l010","ordinal":161982,"en":"\"He made Chech-Döbö at At-Bashy"},{"id":"semetey-1-2013:p1124:b004:l011","ordinal":161983,"en":"Into a proper homeland,"},{"id":"semetey-1-2013:p1124:b004:l012","ordinal":161984,"en":"And made the scattered Kyrgyz"},{"id":"semetey-1-2013:p1124:b004:l013","ordinal":161985,"en":"Into a proper people."},{"id":"semetey-1-2013:p1124:b004:l014","ordinal":161986,"en":"Khan Koshoy of the Katagan"},{"id":"semetey-1-2013:p1124:b004:l015","ordinal":161987,"en":"Has reached eighty-five;"},{"id":"semetey-1-2013:p1124:b004:l016","ordinal":161988,"en":"All his courage"},{"id":"semetey-1-2013:p1124:b004:l017","ordinal":161989,"en":"Has fled his body."},{"id":"semetey-1-2013:p1124:b004:l018","ordinal":161990,"en":"His neck has grown long,"},{"id":"semetey-1-2013:p1124:b004:l019","ordinal":161991,"en":"His sunken eyes have reddened,"},{"id":"semetey-1-2013:p1124:b004:l020","ordinal":161992,"en":"His joints have grown loose,"},{"id":"semetey-1-2013:p1124:b004:l021","ordinal":161993,"en":"And his eyes glint off to the side."},{"id":"semetey-1-2013:p1124:b004:l022","ordinal":161994,"en":"Both corners of his eyes fester;"},{"id":"semetey-1-2013:p1124:b004:l023","ordinal":161995,"en":"His whole body trembles."},{"id":"semetey-1-2013:p1124:b004:l024","ordinal":161996,"en":"He is a man grown old—"},{"id":"semetey-1-2013:p1124:b004:l025","ordinal":161997,"en":"How many stratagems"},{"id":"semetey-1-2013:p1124:b004:l026","ordinal":161998,"en":"Can Koshoy of the Burut possess?"},{"id":"semetey-1-2013:p1124:b004:l027","ordinal":161999,"en":"If I become angry, I shall not relent;"},{"id":"semetey-1-2013:p1124:b004:l028","ordinal":162000,"en":"I would not be satisfied"},{"id":"semetey-1-2013:p1124:b004:l029","ordinal":162001,"en":"With eighty old men like this.\""},{"id":"semetey-1-2013:p1124:b004:l030","ordinal":162002,"en":"Then he saw"},{"id":"semetey-1-2013:p1124:b004:l031","ordinal":162003,"en":"Er Töshtük, son of Eleman,"},{"id":"semetey-1-2013:p1124:b004:l032","ordinal":162004,"en":"Cast his exceptional gaze upon him,"},{"id":"semetey-1-2013:p1124:b004:l033","ordinal":162005,"en":"And began to assess him."},{"id":"semetey-1-2013:p1124:b004:l034","ordinal":162006,"en":"What could dear Töshtük do?"},{"id":"semetey-1-2013:p1124:b004:l035","ordinal":162007,"en":"His right shoulder was broad;"},{"id":"semetey-1-2013:p1124:b004:l036","ordinal":162008,"en":"He was a hero who could shatter the Oirat."},{"id":"semetey-1-2013:p1124:b004:l037","ordinal":162009,"en":"Thick-wristed and stone-hearted,"},{"id":"semetey-1-2013:p1124:b004:l038","ordinal":162010,"en":"His prowess was of another kind."},{"id":"semetey-1-2013:p1124:b004:l039","ordinal":162011,"en":"The lion among born heroes,"},{"id":"semetey-1-2013:p1125:b003:l001","ordinal":162012,"en":"He himself was the people's blessed elder."},{"id":"semetey-1-2013:p1125:b003:l002","ordinal":162013,"en":"He was an exceptional hero."},{"id":"semetey-1-2013:p1125:b003:l003","ordinal":162014,"en":"He had stubborn joints"},{"id":"semetey-1-2013:p1125:b003:l004","ordinal":162015,"en":"That would not heal in six years."},{"id":"semetey-1-2013:p1125:b003:l005","ordinal":162016,"en":"His flesh was raw and bruised,"},{"id":"semetey-1-2013:p1125:b003:l006","ordinal":162017,"en":"His blood remained but one spoonful."},{"id":"semetey-1-2013:p1125:b003:l007","ordinal":162018,"en":"Until his rib bones filled out,"},{"id":"semetey-1-2013:p1125:b003:l008","ordinal":162019,"en":"Until seven years had passed,"},{"id":"semetey-1-2013:p1125:b003:l009","ordinal":162020,"en":"If we fought, I would not be sated with blood;"},{"id":"semetey-1-2013:p1125:b003:l010","ordinal":162021,"en":"I would not spare this Töshtük."},{"id":"semetey-1-2013:p1125:b003:l011","ordinal":162022,"en":"With weapons filling an armful,"},{"id":"semetey-1-2013:p1125:b003:l012","ordinal":162023,"en":"There was Muzburchak of Khan Buudayyk,"},{"id":"semetey-1-2013:p1125:b003:l013","ordinal":162024,"en":"Watching the uproar;"},{"id":"semetey-1-2013:p1125:b003:l014","ordinal":162025,"en":"He tested him as well."},{"id":"semetey-1-2013:p1125:b003:l015","ordinal":162026,"en":"What could dear Burchak do?"},{"id":"semetey-1-2013:p1125:b003:l016","ordinal":162027,"en":"His fierce eyes were like Venus,"},{"id":"semetey-1-2013:p1125:b003:l017","ordinal":162028,"en":"His moonlike ears were shields,"},{"id":"semetey-1-2013:p1125:b003:l018","ordinal":162029,"en":"And his neck was wholly thick."},{"id":"semetey-1-2013:p1125:b003:l019","ordinal":162030,"en":"Looking over his whole body,"},{"id":"semetey-1-2013:p1125:b003:l020","ordinal":162031,"en":"He had the strength of ninety men."},{"id":"semetey-1-2013:p1125:b003:l021","ordinal":162032,"en":"An exceptional man had been born;"},{"id":"semetey-1-2013:p1125:b003:l022","ordinal":162033,"en":"In figure, dignity,"},{"id":"semetey-1-2013:p1125:b003:l023","ordinal":162034,"en":"And appearance on horseback,"},{"id":"semetey-1-2013:p1125:b003:l024","ordinal":162035,"en":"He matched Orokkyr,"},{"id":"semetey-1-2013:p1125:b003:l025","ordinal":162036,"en":"Khan of the Shibee."},{"id":"semetey-1-2013:p1125:b003:l026","ordinal":162037,"en":"His axe was unusually grim;"},{"id":"semetey-1-2013:p1125:b003:l027","ordinal":162038,"en":"Considering his substance,"},{"id":"semetey-1-2013:p1125:b003:l028","ordinal":162039,"en":"He was one of the heroes."},{"id":"semetey-1-2013:p1125:b003:l029","ordinal":162040,"en":"Then hero Kökchö, son of Aydarkan,"},{"id":"semetey-1-2013:p1125:b003:l030","ordinal":162041,"en":"Came before him,"},{"id":"semetey-1-2013:p1125:b003:l031","ordinal":162042,"en":"And he assessed him:"},{"id":"semetey-1-2013:p1125:b003:l032","ordinal":162043,"en":"\"His blue-mottled horse stamps noisily;"},{"id":"semetey-1-2013:p1125:b003:l033","ordinal":162044,"en":"His great lungs wheeze."},{"id":"semetey-1-2013:p1125:b003:l034","ordinal":162045,"en":"Thin, clattering ayran, a narrow sieve—"},{"id":"semetey-1-2013:p1125:b003:l035","ordinal":162046,"en":"The shrill-voiced hero Kökchö"},{"id":"semetey-1-2013:p1125:b003:l036","ordinal":162047,"en":"Is a chatterer with a maiden's courage."},{"id":"semetey-1-2013:p1125:b003:l037","ordinal":162048,"en":"One who tucks letters in his hem—"}]
