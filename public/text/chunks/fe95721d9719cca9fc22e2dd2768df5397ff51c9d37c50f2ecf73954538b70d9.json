[{"id":"semetey-1-2013:p0952:b004:l019","ordinal":149761,"en":"As long as he lived, his speech was plain;"},{"id":"semetey-1-2013:p0952:b004:l020","ordinal":149762,"en":"A surpassing judge and a warrior,"},{"id":"semetey-1-2013:p0952:b004:l021","ordinal":149763,"en":"Kongurbai was among the cunning."},{"id":"semetey-1-2013:p0952:b004:l022","ordinal":149764,"en":"Looking and staring, Kongurbai"},{"id":"semetey-1-2013:p0952:b004:l023","ordinal":149765,"en":"Recognized her supernatural nature."},{"id":"semetey-1-2013:p0952:b004:l024","ordinal":149766,"en":"She was a female human being;"},{"id":"semetey-1-2013:p0952:b004:l025","ordinal":149767,"en":"He recognized that she was a woman."},{"id":"semetey-1-2013:p0952:b004:l026","ordinal":149768,"en":"That magically skilled, dear Churok,"},{"id":"semetey-1-2013:p0952:b004:l027","ordinal":149769,"en":"Roaming the world in a long search,"},{"id":"semetey-1-2013:p0952:b004:l028","ordinal":149770,"en":"He knew she had traversed it."},{"id":"semetey-1-2013:p0952:b004:l029","ordinal":149771,"en":"A powerful sorceress, a crafty one,"},{"id":"semetey-1-2013:p0952:b004:l030","ordinal":149772,"en":"He knew she was a skilled woman."},{"id":"semetey-1-2013:p0952:b004:l031","ordinal":149773,"en":"Seeking a husband, stirred with longing,"},{"id":"semetey-1-2013:p0952:b004:l032","ordinal":149774,"en":"He knew she was a maiden."},{"id":"semetey-1-2013:p0952:b004:l033","ordinal":149775,"en":"'That one up in the sky,"},{"id":"semetey-1-2013:p0952:b004:l034","ordinal":149776,"en":"Let me bring great torment upon her,"},{"id":"semetey-1-2013:p0952:b004:l035","ordinal":149777,"en":"Shoot and take her captive,"},{"id":"semetey-1-2013:p0952:b004:l036","ordinal":149778,"en":"And make her my bride.'"},{"id":"semetey-1-2013:p0952:b004:l037","ordinal":149779,"en":"A skilled, knowledgeable fellow,"},{"id":"semetey-1-2013:p0952:b004:l038","ordinal":149780,"en":"An experienced fellow who knew the enemy's stratagems,"},{"id":"semetey-1-2013:p0953:b003:l001","ordinal":149781,"en":"Kongurbai, the cunning one,"},{"id":"semetey-1-2013:p0953:b003:l002","ordinal":149782,"en":"Churok flying above,"},{"id":"semetey-1-2013:p0953:b003:l003","ordinal":149783,"en":"Upon Churok herself,"},{"id":"semetey-1-2013:p0953:b003:l004","ordinal":149784,"en":"Kongurbai, son of Alooko,"},{"id":"semetey-1-2013:p0953:b003:l005","ordinal":149785,"en":"Now brought an onslaught."},{"id":"semetey-1-2013:p0953:b003:l006","ordinal":149786,"en":"The ochogor gun in his hand,"},{"id":"semetey-1-2013:p0953:b003:l007","ordinal":149787,"en":"Do not ask about its nature,"},{"id":"semetey-1-2013:p0953:b003:l008","ordinal":149788,"en":"His hammer gun fired swiftly,"},{"id":"semetey-1-2013:p0953:b003:l009","ordinal":149789,"en":"He now took to firing thunderously."},{"id":"semetey-1-2013:p0953:b003:l010","ordinal":149790,"en":"When she saw this ferocity,"},{"id":"semetey-1-2013:p0953:b003:l011","ordinal":149791,"en":"Her fly-like soul cried out,"},{"id":"semetey-1-2013:p0953:b003:l012","ordinal":149792,"en":"Her every bone seemed to shatter."},{"id":"semetey-1-2013:p0953:b003:l013","ordinal":149793,"en":"Khan Akun's Aichurok"},{"id":"semetey-1-2013:p0953:b003:l014","ordinal":149794,"en":"Turned back at once."},{"id":"semetey-1-2013:p0953:b003:l015","ordinal":149795,"en":"Fleeing for her life, Aichurok"},{"id":"semetey-1-2013:p0953:b003:l016","ordinal":149796,"en":"Flew away at speed."},{"id":"semetey-1-2013:p0953:b003:l017","ordinal":149797,"en":"The shot issuing from the ochogor"},{"id":"semetey-1-2013:p0953:b003:l018","ordinal":149798,"en":"Whistled, cutting at her wings."},{"id":"semetey-1-2013:p0953:b003:l019","ordinal":149799,"en":"With no thought but God,"},{"id":"semetey-1-2013:p0953:b003:l020","ordinal":149800,"en":"What could dear Churok do?"},{"id":"semetey-1-2013:p0953:b003:l021","ordinal":149801,"en":"She fled in haste."},{"id":"semetey-1-2013:p0953:b003:l022","ordinal":149802,"en":"Kongurbai, son of Alooko,"},{"id":"semetey-1-2013:p0953:b003:l023","ordinal":149803,"en":"Roused tremendous vigor."},{"id":"semetey-1-2013:p0953:b003:l024","ordinal":149804,"en":"When he saw Aichurok,"},{"id":"semetey-1-2013:p0953:b003:l025","ordinal":149805,"en":"What did dear Kalcha do?"},{"id":"semetey-1-2013:p0953:b003:l026","ordinal":149806,"en":"He became fifteen once again."},{"id":"semetey-1-2013:p0953:b003:l027","ordinal":149807,"en":"'Burku, burku, burku!'"},{"id":"semetey-1-2013:p0953:b003:l028","ordinal":149808,"en":"Kongurbai cried, 'Burku!'"},{"id":"semetey-1-2013:p0953:b003:l029","ordinal":149809,"en":"'Burku' was the name of his god."},{"id":"semetey-1-2013:p0953:b003:l030","ordinal":149810,"en":"'Mondu, mondu, mondu!'"},{"id":"semetey-1-2013:p0953:b003:l031","ordinal":149811,"en":"Kongurbai cried, 'Mondu!'"},{"id":"semetey-1-2013:p0953:b003:l032","ordinal":149812,"en":"'Mondu' was his battle cry."},{"id":"semetey-1-2013:p0953:b003:l033","ordinal":149813,"en":"How could Kalcha fail to rouse himself?"},{"id":"semetey-1-2013:p0953:b003:l034","ordinal":149814,"en":"That infidel's Algara,"},{"id":"semetey-1-2013:p0953:b003:l035","ordinal":149815,"en":"No living soul could match its blink;"},{"id":"semetey-1-2013:p0953:b003:l036","ordinal":149816,"en":"Unless it were a flying bird,"},{"id":"semetey-1-2013:p0953:b003:l037","ordinal":149817,"en":"No four-footed beast could catch him."},{"id":"semetey-1-2013:p0953:b003:l038","ordinal":149818,"en":"That madman's Algara,"},{"id":"semetey-1-2013:p0953:b003:l039","ordinal":149819,"en":"If he pursued a wild ass, would not let it escape."},{"id":"semetey-1-2013:p0953:b005:l001","ordinal":149820,"en":"Crossing a forty-day desert,"},{"id":"semetey-1-2013:p0953:b005:l002","ordinal":149821,"en":"He was practiced in running."},{"id":"semetey-1-2013:p0953:b005:l003","ordinal":149822,"en":"That madman's Algara,"},{"id":"semetey-1-2013:p0953:b005:l004","ordinal":149823,"en":"And when he opened his mouth, he snorted;"},{"id":"semetey-1-2013:p0953:b005:l005","ordinal":149824,"en":"Drew near to winged creatures."},{"id":"semetey-1-2013:p0953:b005:l006","ordinal":149825,"en":"Kongurbai's black horse,"},{"id":"semetey-1-2013:p0953:b005:l007","ordinal":149826,"en":"His black horse had"},{"id":"semetey-1-2013:p0953:b005:l008","ordinal":149827,"en":"Wings upon his flanks."},{"id":"semetey-1-2013:p0953:b005:l009","ordinal":149828,"en":"Even over a forty-day desert,"},{"id":"semetey-1-2013:p0953:b005:l010","ordinal":149829,"en":"Where living creatures panted,"},{"id":"semetey-1-2013:p0953:b005:l011","ordinal":149830,"en":"A desert where they died of thirst,"},{"id":"semetey-1-2013:p0953:b005:l012","ordinal":149831,"en":"He was accustomed to run and endure."},{"id":"semetey-1-2013:p0953:b005:l013","ordinal":149832,"en":"He never misplaced a single step."},{"id":"semetey-1-2013:p0953:b005:l014","ordinal":149833,"en":"No wild sheep could escape before him"},{"id":"semetey-1-2013:p0953:b005:l015","ordinal":149834,"en":"And flee up into the hills."},{"id":"semetey-1-2013:p0953:b005:l016","ordinal":149835,"en":"Such was his sure-footedness,"},{"id":"semetey-1-2013:p0953:b005:l017","ordinal":149836,"en":"He never slipped from a height."},{"id":"semetey-1-2013:p0953:b005:l018","ordinal":149837,"en":"If he traveled in darkness,"},{"id":"semetey-1-2013:p0953:b005:l019","ordinal":149838,"en":"The creature's skill"},{"id":"semetey-1-2013:p0953:b005:l020","ordinal":149839,"en":"Was so much greater"},{"id":"semetey-1-2013:p0953:b005:l021","ordinal":149840,"en":"Than a wild goat's upon the cliffs."},{"id":"semetey-1-2013:p0953:b005:l022","ordinal":149841,"en":"When he saw Aichurok,"},{"id":"semetey-1-2013:p0953:b005:l023","ordinal":149842,"en":"That maddened Chinese, Kongurbai,"},{"id":"semetey-1-2013:p0953:b005:l024","ordinal":149843,"en":"Slung on his jazaiyl gun,"},{"id":"semetey-1-2013:p0953:b005:l025","ordinal":149844,"en":"Struck Algara once upon the thigh,"},{"id":"semetey-1-2013:p0953:b005:l026","ordinal":149845,"en":"Your khan charged forward,"},{"id":"semetey-1-2013:p0953:b005:l027","ordinal":149846,"en":"Attacking Aichurok,"},{"id":"semetey-1-2013:p0953:b005:l028","ordinal":149847,"en":"To seize her somehow."},{"id":"semetey-1-2013:p0953:b005:l029","ordinal":149848,"en":"If Aichurok fell into his hands,"},{"id":"semetey-1-2013:p0953:b005:l030","ordinal":149849,"en":"He would make her his bride."},{"id":"semetey-1-2013:p0953:b005:l031","ordinal":149850,"en":"'Oh, mighty Tungsha and Bakburchun,"},{"id":"semetey-1-2013:p0953:b005:l032","ordinal":149851,"en":"The great city of Kakan-Chyn,"},{"id":"semetey-1-2013:p0953:b005:l033","ordinal":149852,"en":"I have traveled among these peoples."},{"id":"semetey-1-2013:p0953:b005:l034","ordinal":149853,"en":"Having visited them all,"},{"id":"semetey-1-2013:p0953:b005:l035","ordinal":149854,"en":"I have never seen such a female,"},{"id":"semetey-1-2013:p0953:b005:l036","ordinal":149855,"en":"If I do not die young,"},{"id":"semetey-1-2013:p0953:b005:l037","ordinal":149856,"en":"You were a noble steed, Algara;"},{"id":"semetey-1-2013:p0953:b005:l038","ordinal":149857,"en":"Lower your head to the ground,"},{"id":"semetey-1-2013:p0953:b005:l039","ordinal":149858,"en":"Truly lengthen your stride."},{"id":"semetey-1-2013:p0954:b003:l001","ordinal":149859,"en":"Chasing her four times around the world,"},{"id":"semetey-1-2013:p0954:b003:l002","ordinal":149860,"en":"The five corners of Medina,"},{"id":"semetey-1-2013:p0954:b003:l003","ordinal":149861,"en":"Chasing her five times around them,"},{"id":"semetey-1-2013:p0954:b003:l004","ordinal":149862,"en":"Let me capture the sorceress."},{"id":"semetey-1-2013:p0954:b003:l005","ordinal":149863,"en":"To the kakan khan of Beijing,"},{"id":"semetey-1-2013:p0954:b003:l006","ordinal":149864,"en":"'I have captured a supernatural maiden,'"},{"id":"semetey-1-2013:p0954:b003:l007","ordinal":149865,"en":"Let me go announcing the glad news.'"},{"id":"semetey-1-2013:p0954:b003:l008","ordinal":149866,"en":"Rousing his strength and whipping his horse,"},{"id":"semetey-1-2013:p0954:b003:l009","ordinal":149867,"en":"He went pursuing Churok."},{"id":"semetey-1-2013:p0954:b003:l010","ordinal":149868,"en":"Gliding above him,"},{"id":"semetey-1-2013:p0954:b003:l011","ordinal":149869,"en":"What could dear Churok do?"},{"id":"semetey-1-2013:p0954:b003:l012","ordinal":149870,"en":"She kept flying away."},{"id":"semetey-1-2013:p0954:b003:l013","ordinal":149871,"en":"Behind her came Kongurbai,"},{"id":"semetey-1-2013:p0954:b003:l014","ordinal":149872,"en":"Practiced in every kind of deed,"},{"id":"semetey-1-2013:p0954:b003:l015","ordinal":149873,"en":"Oh, that skilled swine!"},{"id":"semetey-1-2013:p0954:b003:l016","ordinal":149874,"en":"Churok soared, swift as a mirage,"},{"id":"semetey-1-2013:p0954:b003:l017","ordinal":149875,"en":"Kongurbai, whose horse was swift,"},{"id":"semetey-1-2013:p0954:b003:l018","ordinal":149876,"en":"Drew level with her."},{"id":"semetey-1-2013:p0954:b003:l019","ordinal":149877,"en":"Kongurbai's black horse,"},{"id":"semetey-1-2013:p0954:b003:l020","ordinal":149878,"en":"His black horse's wings—"},{"id":"semetey-1-2013:p0954:b003:l021","ordinal":149879,"en":"When he pursued, he let nothing escape;"},{"id":"semetey-1-2013:p0954:b003:l022","ordinal":149880,"en":"That was Algara's habit."},{"id":"semetey-1-2013:p0954:b003:l023","ordinal":149881,"en":"When he came to a descent,"},{"id":"semetey-1-2013:p0954:b003:l024","ordinal":149882,"en":"His forelegs reached out like a roe deer's."},{"id":"semetey-1-2013:p0954:b003:l025","ordinal":149883,"en":"When he began to climb,"},{"id":"semetey-1-2013:p0954:b003:l026","ordinal":149884,"en":"His mane and tail spread out."},{"id":"semetey-1-2013:p0954:b003:l027","ordinal":149885,"en":"When he came to rugged ground,"},{"id":"semetey-1-2013:p0954:b003:l028","ordinal":149886,"en":"His stride lengthened like a stag's."},{"id":"semetey-1-2013:p0954:b003:l029","ordinal":149887,"en":"When he came to a sudden turn,"},{"id":"semetey-1-2013:p0954:b003:l030","ordinal":149888,"en":"His eyes reddened like a wild ram's."},{"id":"semetey-1-2013:p0954:b003:l031","ordinal":149889,"en":"She glided, flying high in the sky;"},{"id":"semetey-1-2013:p0954:b003:l032","ordinal":149890,"en":"Kongurbai drew near upon the earth."},{"id":"semetey-1-2013:p0954:b003:l033","ordinal":149891,"en":"The skillful Kongurbai,"},{"id":"semetey-1-2013:p0954:b003:l034","ordinal":149892,"en":"When he came abreast of her,"},{"id":"semetey-1-2013:p0954:b003:l035","ordinal":149893,"en":"Seemed about to shoot and capture her."},{"id":"semetey-1-2013:p0954:b003:l036","ordinal":149894,"en":"Seeing Churok's outline,"},{"id":"semetey-1-2013:p0954:b003:l037","ordinal":149895,"en":"That troublesome creature gliding in flight,"},{"id":"semetey-1-2013:p0954:b003:l038","ordinal":149896,"en":"His cavern-mouthed ochogor"},{"id":"semetey-1-2013:p0954:b003:l039","ordinal":149897,"en":"He took up and fired three times,"},{"id":"semetey-1-2013:p0954:b004:l001","ordinal":149898,"en":"Fired six or seven more with force."},{"id":"semetey-1-2013:p0954:b004:l002","ordinal":149899,"en":"Beside that Kalcha fellow"},{"id":"semetey-1-2013:p0954:b004:l003","ordinal":149900,"en":"Were painted arrows with golden sockets."},{"id":"semetey-1-2013:p0954:b004:l004","ordinal":149901,"en":"Such was your elder's way:"},{"id":"semetey-1-2013:p0954:b004:l005","ordinal":149902,"en":"Upon Churok in the sky,"},{"id":"semetey-1-2013:p0954:b004:l006","ordinal":149903,"en":"He now brought an onslaught."},{"id":"semetey-1-2013:p0954:b004:l007","ordinal":149904,"en":"He used still greater cunning;"},{"id":"semetey-1-2013:p0954:b004:l008","ordinal":149905,"en":"Riding beneath her, Kongurbai"},{"id":"semetey-1-2013:p0954:b004:l009","ordinal":149906,"en":"Now shot with his bow."},{"id":"semetey-1-2013:p0954:b004:l010","ordinal":149907,"en":"Pressing the attack with his bow,"},{"id":"semetey-1-2013:p0954:b004:l011","ordinal":149908,"en":"His shafts flew rattling toward her."},{"id":"semetey-1-2013:p0954:b004:l012","ordinal":149909,"en":"'The Chinese will not let me escape!'"},{"id":"semetey-1-2013:p0954:b004:l013","ordinal":149910,"en":"Wretched Churok"},{"id":"semetey-1-2013:p0954:b004:l014","ordinal":149911,"en":"Was utterly at a loss."},{"id":"semetey-1-2013:p0954:b004:l015","ordinal":149912,"en":"Changing the weather by weather-magic,"},{"id":"semetey-1-2013:p0954:b004:l016","ordinal":149913,"en":"She now used sorcery."},{"id":"semetey-1-2013:p0954:b004:l017","ordinal":149914,"en":"A great weather-magician, full of cunning,"},{"id":"semetey-1-2013:p0954:b004:l018","ordinal":149915,"en":"Aichurok, one of the noble ones,"},{"id":"semetey-1-2013:p0954:b004:l019","ordinal":149916,"en":"When Kalcha was about to capture her,"},{"id":"semetey-1-2013:p0954:b004:l020","ordinal":149917,"en":"About to cast black night upon her,"},{"id":"semetey-1-2013:p0954:b004:l021","ordinal":149918,"en":"Farting with a crack and shitting with a sputter,"},{"id":"semetey-1-2013:p0954:b004:l022","ordinal":149919,"en":"She changed the weather by magic."},{"id":"semetey-1-2013:p0954:b004:l023","ordinal":149920,"en":"Raging and shouting,"},{"id":"semetey-1-2013:p0954:b004:l024","ordinal":149921,"en":"In the hot forty days of summer,"},{"id":"semetey-1-2013:p0954:b004:l025","ordinal":149922,"en":"She summoned a pair of clouds."},{"id":"semetey-1-2013:p0954:b004:l026","ordinal":149923,"en":"Clouds swept down from the sky,"},{"id":"semetey-1-2013:p0954:b004:l027","ordinal":149924,"en":"Low fog descended and enclosed the earth,"},{"id":"semetey-1-2013:p0954:b004:l029","ordinal":149925,"en":"Clouds broke apart in the sky,"},{"id":"semetey-1-2013:p0954:b004:l030","ordinal":149926,"en":"One saw hail pour down in six streams."},{"id":"semetey-1-2013:p0954:b004:l031","ordinal":149927,"en":"Rain fell across all the lowlands,"},{"id":"semetey-1-2013:p0954:b004:l032","ordinal":149928,"en":"A dark downpour poured down."},{"id":"semetey-1-2013:p0954:b004:l033","ordinal":149929,"en":"Hiding the surface of the earth,"},{"id":"semetey-1-2013:p0954:b004:l034","ordinal":149930,"en":"Low fog descended and swirled."},{"id":"semetey-1-2013:p0954:b004:l035","ordinal":149931,"en":"Sleet and hail rattled,"},{"id":"semetey-1-2013:p0954:b004:l036","ordinal":149932,"en":"No one could tell which way was which."},{"id":"semetey-1-2013:p0954:b004:l037","ordinal":149933,"en":"Ridge-nosed Kongurbai"},{"id":"semetey-1-2013:p0954:b004:l038","ordinal":149934,"en":"Lost his way, babbling."},{"id":"semetey-1-2013:p0954:b004:l039","ordinal":149935,"en":"The earth turned blue-gray, fog enclosed it,"},{"id":"semetey-1-2013:p0955:b003:l001","ordinal":149936,"en":"Aichurok, who judged heroes,"},{"id":"semetey-1-2013:p0955:b003:l002","ordinal":149937,"en":"From the hands of mighty Kalcha"},{"id":"semetey-1-2013:p0955:b003:l003","ordinal":149938,"en":"Escaped only with the greatest difficulty."},{"id":"semetey-1-2013:p0955:b003:l004","ordinal":149939,"en":"Finding no support in a renowned place,"},{"id":"semetey-1-2013:p0955:b003:l005","ordinal":149940,"en":"Finding no hero to cherish as husband,"},{"id":"semetey-1-2013:p0955:b003:l006","ordinal":149941,"en":"She crossed Kyzyl-Kyya."},{"id":"semetey-1-2013:p0955:b003:l007","ordinal":149942,"en":"In great haste, Aichurok"},{"id":"semetey-1-2013:p0955:b003:l008","ordinal":149943,"en":"Passed over Ala-Kol."},{"id":"semetey-1-2013:p0955:b003:l009","ordinal":149944,"en":"Unable to collect her wits, Aichurok"},{"id":"semetey-1-2013:p0955:b003:l010","ordinal":149945,"en":"Climbed Elkin-Too and lay down."},{"id":"semetey-1-2013:p0955:b003:l011","ordinal":149946,"en":"Gathering herself, she smoothed her hair,"},{"id":"semetey-1-2013:p0955:b003:l012","ordinal":149947,"en":"As though Kongurbai might catch up,"},{"id":"semetey-1-2013:p0955:b003:l013","ordinal":149948,"en":"She looked to either side."},{"id":"semetey-1-2013:p0955:b003:l014","ordinal":149949,"en":"Elkin-Too was a deserted place."},{"id":"semetey-1-2013:p0955:b003:l015","ordinal":149950,"en":"There was no crow to caw,"},{"id":"semetey-1-2013:p0955:b003:l016","ordinal":149951,"en":"No raven croaking in flight,"},{"id":"semetey-1-2013:p0955:b003:l017","ordinal":149952,"en":"No furrow cut by a plow,"},{"id":"semetey-1-2013:p0955:b003:l018","ordinal":149953,"en":"No burrow dug by a marmot."},{"id":"semetey-1-2013:p0955:b003:l019","ordinal":149954,"en":"It was a place of winding hollows,"},{"id":"semetey-1-2013:p0955:b003:l020","ordinal":149955,"en":"Called Elkin-Too Ata."},{"id":"semetey-1-2013:p0955:b003:l021","ordinal":149956,"en":"Its spring flowed, overflowing,"},{"id":"semetey-1-2013:p0955:b003:l022","ordinal":149957,"en":"A sorrowful mortal would weep there,"},{"id":"semetey-1-2013:p0955:b003:l023","ordinal":149958,"en":"Its nightingales sang and trilled."},{"id":"semetey-1-2013:p0955:b003:l024","ordinal":149959,"en":"Having seen many fine lands,"},{"id":"semetey-1-2013:p0955:b003:l025","ordinal":149960,"en":"Her heart filled with sorrow,"},{"id":"semetey-1-2013:p0955:b003:l026","ordinal":149961,"en":"With no living soul to listen,"},{"id":"semetey-1-2013:p0955:b003:l027","ordinal":149962,"en":"She told her grief to God:"},{"id":"semetey-1-2013:p0955:b003:l028","ordinal":149963,"en":"'Great Beijing, that distant city,"},{"id":"semetey-1-2013:p0955:b003:l029","ordinal":149964,"en":"I have wandered to its farthest end."},{"id":"semetey-1-2013:p0955:b003:l030","ordinal":149965,"en":"The infidels and Muslims,"},{"id":"semetey-1-2013:p0955:b003:l031","ordinal":149966,"en":"I have visited all their peoples,"},{"id":"semetey-1-2013:p0955:b003:l032","ordinal":149967,"en":"Finding no support in a renowned place."},{"id":"semetey-1-2013:p0955:b003:l033","ordinal":149968,"en":"Could anyone be as unfortunate as I,"},{"id":"semetey-1-2013:p0955:b003:l034","ordinal":149969,"en":"Finding no hero equal to herself?"},{"id":"semetey-1-2013:p0955:b003:l035","ordinal":149970,"en":"A white dress with a broad skirt,"},{"id":"semetey-1-2013:p0955:b003:l036","ordinal":149971,"en":"With what face could I wear it?"},{"id":"semetey-1-2013:p0955:b003:l037","ordinal":149972,"en":"To Toltoi of the Jediger,"},{"id":"semetey-1-2013:p0955:b003:l038","ordinal":149973,"en":"Calling him my true husband,"},{"id":"semetey-1-2013:p0955:b003:l039","ordinal":149974,"en":"With what face could I marry?"},{"id":"semetey-1-2013:p0955:b005:l001","ordinal":149975,"en":"Could anyone be as disgraced as I?"},{"id":"semetey-1-2013:p0955:b005:l002","ordinal":149976,"en":"Can a grieving person prosper?"},{"id":"semetey-1-2013:p0955:b005:l003","ordinal":149977,"en":"Finding no place to settle,"},{"id":"semetey-1-2013:p0955:b005:l004","ordinal":149978,"en":"Finding no hero to marry,"},{"id":"semetey-1-2013:p0955:b005:l005","ordinal":149979,"en":"Could anyone be as disgraced as I?"},{"id":"semetey-1-2013:p0955:b005:l006","ordinal":149980,"en":"My father, Khan Akun's"},{"id":"semetey-1-2013:p0955:b005:l007","ordinal":149981,"en":"Determined enemy Chynkojo,"},{"id":"semetey-1-2013:p0955:b005:l008","ordinal":149982,"en":"Is like tempered red iron."},{"id":"semetey-1-2013:p0955:b005:l009","ordinal":149983,"en":"Aichurok, daughter of Akun,"},{"id":"semetey-1-2013:p0955:b005:l010","ordinal":149984,"en":"Truly flew in search of a hero—"},{"id":"semetey-1-2013:p0955:b005:l011","ordinal":149985,"en":"Let them not say she returned empty-handed."},{"id":"semetey-1-2013:p0955:b005:l012","ordinal":149986,"en":"How can my poor soul die?"},{"id":"semetey-1-2013:p0955:b005:l013","ordinal":149987,"en":"Where shall I find my equal?'"},{"id":"semetey-1-2013:p0955:b005:l014","ordinal":149988,"en":"Finding no husband among the giants,"},{"id":"semetey-1-2013:p0955:b005:l015","ordinal":149989,"en":"Her mind deeply troubled,"},{"id":"semetey-1-2013:p0955:b005:l016","ordinal":149990,"en":"Aichurok grieved greatly,"},{"id":"semetey-1-2013:p0955:b005:l017","ordinal":149991,"en":"Tears pouring from her eyes."},{"id":"semetey-1-2013:p0955:b005:l018","ordinal":149992,"en":"Sparing herself no effort, she traveled,"},{"id":"semetey-1-2013:p0955:b005:l019","ordinal":149993,"en":"Wandering the land again,"},{"id":"semetey-1-2013:p0955:b005:l020","ordinal":149994,"en":"Aichurok flew onward."},{"id":"semetey-1-2013:p0955:b005:l021","ordinal":149995,"en":"She crossed the ridge of Boot,"},{"id":"semetey-1-2013:p0955:b005:l022","ordinal":149996,"en":"Passed through Suusamyr."},{"id":"semetey-1-2013:p0955:b005:l023","ordinal":149997,"en":"Kanykey in Bukhara"},{"id":"semetey-1-2013:p0955:b005:l024","ordinal":149998,"en":"Kanikey's Uprising,"},{"id":"semetey-1-2013:p0955:b005:l025","ordinal":149999,"en":"'Let me cross Kotormo,"},{"id":"semetey-1-2013:p0955:b005:l026","ordinal":150000,"en":"Let me pass through broad Talas."},{"id":"semetey-1-2013:p0955:b005:l027","ordinal":150001,"en":"Let me enter that noble land."},{"id":"semetey-1-2013:p0955:b005:l028","ordinal":150002,"en":"My father-in-law, gone to the other world—"},{"id":"semetey-1-2013:p0955:b005:l029","ordinal":150003,"en":"Let me honor his ancestral spirit."},{"id":"semetey-1-2013:p0955:b005:l030","ordinal":150004,"en":"Let me enter that noble land."},{"id":"semetey-1-2013:p0955:b005:l031","ordinal":150005,"en":"My father-in-law, gone to the other world—"},{"id":"semetey-1-2013:p0955:b005:l032","ordinal":150006,"en":"Let me go honoring his spirit."},{"id":"semetey-1-2013:p0955:b005:l033","ordinal":150007,"en":"The Argyn and Kyrgyz,"},{"id":"semetey-1-2013:p0955:b005:l034","ordinal":150008,"en":"Let me learn what they are like."},{"id":"semetey-1-2013:p0955:b005:l035","ordinal":150009,"en":"If I draw upon tradition,"},{"id":"semetey-1-2013:p0955:b005:l036","ordinal":150010,"en":"If I ask the knowledgeable,"},{"id":"semetey-1-2013:p0955:b005:l037","ordinal":150011,"en":"When my sultan father-in-law died,"},{"id":"semetey-1-2013:p0955:b005:l038","ordinal":150012,"en":"When the people gathered and buried him,"},{"id":"semetey-1-2013:p0956:b003:l001","ordinal":150013,"en":"My mother-in-law departed in mourning,"},{"id":"semetey-1-2013:p0956:b003:l002","ordinal":150014,"en":"My own husband fled away."},{"id":"semetey-1-2013:p0956:b003:l003","ordinal":150015,"en":"Argyn and Kyrgyz, dear people—"},{"id":"semetey-1-2013:p0956:b003:l004","ordinal":150016,"en":"Let me see the people left without a master."}]
