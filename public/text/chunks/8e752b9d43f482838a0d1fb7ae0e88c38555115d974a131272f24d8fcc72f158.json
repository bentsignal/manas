[{"id":"manas-2010:p1611:b001:l005","ordinal":69377,"en":"Were it not for this fugitive,"},{"id":"manas-2010:p1611:b001:l006","ordinal":69378,"en":"I would raid and plunder his Talas,"},{"id":"manas-2010:p1611:b001:l007","ordinal":69379,"en":"And ruin his Manas!”"},{"id":"manas-2010:p1611:b001:l008","ordinal":69380,"en":"Thus spoke Kongurbay"},{"id":"manas-2010:p1611:b001:l009","ordinal":69381,"en":"And turned Algara's head."},{"id":"manas-2010:p1611:b001:l010","ordinal":69382,"en":"Buudayyk Khan's Muzburchak,"},{"id":"manas-2010:p1611:b001:l011","ordinal":69383,"en":"Fired with Telkyzyl beneath him,"},{"id":"manas-2010:p1611:b001:l012","ordinal":69384,"en":"A gray leather belt around his waist,"},{"id":"manas-2010:p1611:b001:l013","ordinal":69385,"en":"Crying out, “Manas! Manas!”"},{"id":"manas-2010:p1611:b001:l014","ordinal":69386,"en":"Muzburchak, born complete,"},{"id":"manas-2010:p1611:b001:l015","ordinal":69387,"en":"Arrived faster than an arrow."},{"id":"manas-2010:p1611:b001:l016","ordinal":69388,"en":"Through seven great hosts of Chinese and Manzhuu"},{"id":"manas-2010:p1611:b001:l017","ordinal":69389,"en":"He plunged alone,"},{"id":"manas-2010:p1611:b001:l018","ordinal":69390,"en":"Splitting their very center,"},{"id":"manas-2010:p1611:b001:l019","ordinal":69391,"en":"And reached Kongurbay."},{"id":"manas-2010:p1611:b001:l020","ordinal":69392,"en":"As he was about to seize his hem,"},{"id":"manas-2010:p1611:b001:l021","ordinal":69393,"en":"About to finish him off,"},{"id":"manas-2010:p1611:b001:l022","ordinal":69394,"en":"At the banner's foot, Kojozhash"},{"id":"manas-2010:p1611:b001:l023","ordinal":69395,"en":"Saw the red-clad, charging"},{"id":"manas-2010:p1611:b001:l024","ordinal":69396,"en":"Muzburchak who entered shouting:"},{"id":"manas-2010:p1611:b001:l025","ordinal":69397,"en":"“The right temple itself,” he thought,"},{"id":"manas-2010:p1611:b001:l026","ordinal":69398,"en":"“Or, if it falls short, the eye.”"},{"id":"manas-2010:p1611:b001:l027","ordinal":69399,"en":"The finest of marksmen,"},{"id":"manas-2010:p1611:b001:l028","ordinal":69400,"en":"His trigger ready,"},{"id":"manas-2010:p1611:b001:l029","ordinal":69401,"en":"Kojozhash gave it a pull."},{"id":"manas-2010:p1611:b001:l030","ordinal":69402,"en":"The hapless head split clean apart."},{"id":"manas-2010:p1611:b001:l031","ordinal":69403,"en":"Buudayyk Khan's Muzburchak,"},{"id":"manas-2010:p1611:b001:l032","ordinal":69404,"en":"When he fell shot without turning,"},{"id":"manas-2010:p1611:b001:l033","ordinal":69405,"en":"With more sorrow than the heart could hold,"},{"id":"manas-2010:p1611:b001:l034","ordinal":69406,"en":"Tears streaming ten ways,"},{"id":"manas-2010:p1611:b001:l035","ordinal":69407,"en":"“If Muzburchak and Khan Kökchö die,"},{"id":"manas-2010:p1611:b001:l036","ordinal":69408,"en":"If everyone we meet dies,"},{"id":"manas-2010:p1611:b001:l037","ordinal":69409,"en":"How shall we reach our inheritance?"},{"id":"manas-2010:p1611:b001:l038","ordinal":69410,"en":"Bereft of our valiant men,"},{"id":"manas-2010:p1611:b001:l039","ordinal":69411,"en":"Without fighting to the death in Beijing,"},{"id":"manas-2010:p1611:b001:l040","ordinal":69412,"en":"How can we return to our people?”"},{"id":"manas-2010:p1611:b001:l041","ordinal":69413,"en":"Thus spoke dear Syrgak."},{"id":"manas-2010:p1611:b001:l042","ordinal":69414,"en":"Kökchebich beneath him"},{"id":"manas-2010:p1612:b001:l001","ordinal":69415,"en":"He sent racing at the cry, “Go!”"},{"id":"manas-2010:p1612:b001:l002","ordinal":69416,"en":"Raising tumult among the Chinese,"},{"id":"manas-2010:p1612:b001:l003","ordinal":69417,"en":"Felling all he encountered,"},{"id":"manas-2010:p1612:b001:l004","ordinal":69418,"en":"Of the Kalmyks who opposed him,"},{"id":"manas-2010:p1612:b001:l005","ordinal":69419,"en":"Laying so many low."},{"id":"manas-2010:p1612:b001:l006","ordinal":69420,"en":"Without looking all around,"},{"id":"manas-2010:p1612:b001:l007","ordinal":69421,"en":"Azizkhan's Almambet"},{"id":"manas-2010:p1612:b001:l008","ordinal":69422,"en":"Entered battle with a shout."},{"id":"manas-2010:p1612:b001:l009","ordinal":69423,"en":"Khan Baltay's Chubak,"},{"id":"manas-2010:p1612:b001:l010","ordinal":69424,"en":"An immense army when enraged,"},{"id":"manas-2010:p1612:b001:l011","ordinal":69425,"en":"The champion of the Oygut,"},{"id":"manas-2010:p1612:b001:l012","ordinal":69426,"en":"Among the Chinese, people of forty khans,"},{"id":"manas-2010:p1612:b001:l013","ordinal":69427,"en":"Plunged without hesitation."},{"id":"manas-2010:p1612:b001:l014","ordinal":69428,"en":"When he entered shouting,"},{"id":"manas-2010:p1612:b001:l015","ordinal":69429,"en":"Despairing of his dear life,"},{"id":"manas-2010:p1612:b001:l016","ordinal":69430,"en":"Alöökö's Kongurbay"},{"id":"manas-2010:p1612:b001:l017","ordinal":69431,"en":"Stood staring in amazement."},{"id":"manas-2010:p1612:b001:l018","ordinal":69432,"en":"Khan Manas's forty companions"},{"id":"manas-2010:p1612:b001:l019","ordinal":69433,"en":"Attacked from forty sides;"},{"id":"manas-2010:p1612:b001:l020","ordinal":69434,"en":"Wherever they attacked, screams rose."},{"id":"manas-2010:p1612:b001:l021","ordinal":69435,"en":"The Chinese and the many Manzhuu"},{"id":"manas-2010:p1612:b001:l022","ordinal":69436,"en":"All fled in confusion."},{"id":"manas-2010:p1612:b001:l023","ordinal":69437,"en":"“They will spare no life!” he said,"},{"id":"manas-2010:p1612:b001:l024","ordinal":69438,"en":"And pleaded with Kojozhash:"},{"id":"manas-2010:p1612:b001:l025","ordinal":69439,"en":"“Since I became Kongurbay,"},{"id":"manas-2010:p1612:b001:l026","ordinal":69440,"en":"Slaughterer of the whole wide world,"},{"id":"manas-2010:p1612:b001:l027","ordinal":69441,"en":"Becoming a hero at twelve,"},{"id":"manas-2010:p1612:b001:l028","ordinal":69442,"en":"I have been Beijing's bulwark."},{"id":"manas-2010:p1612:b001:l029","ordinal":69443,"en":"I was a wall built upon the height,"},{"id":"manas-2010:p1612:b001:l030","ordinal":69444,"en":"The monks' mountain-like khan."},{"id":"manas-2010:p1612:b001:l031","ordinal":69445,"en":"Because of this young Syrgak,"},{"id":"manas-2010:p1612:b001:l032","ordinal":69446,"en":"My seat slipped from my saddle,"},{"id":"manas-2010:p1612:b001:l033","ordinal":69447,"en":"Sickness entered my heart,"},{"id":"manas-2010:p1612:b001:l034","ordinal":69448,"en":"My breastbone shook."},{"id":"manas-2010:p1612:b001:l035","ordinal":69449,"en":"Of the Chinese with rank-buttons,"},{"id":"manas-2010:p1612:b001:l036","ordinal":69450,"en":"The finest wept and shook."},{"id":"manas-2010:p1612:b001:l037","ordinal":69451,"en":"My support that I relied upon,"},{"id":"manas-2010:p1612:b001:l038","ordinal":69452,"en":"So often he shattered my defenses;"},{"id":"manas-2010:p1612:b001:l039","ordinal":69453,"en":"So many times brave Syrgak slaughtered"},{"id":"manas-2010:p1612:b001:l040","ordinal":69454,"en":"My many valiant warriors."},{"id":"manas-2010:p1612:b001:l041","ordinal":69455,"en":"So often he broke my backbone,"},{"id":"manas-2010:p1612:b001:l042","ordinal":69456,"en":"So often he disheartened me!"},{"id":"manas-2010:p1613:b001:l001","ordinal":69457,"en":"When he encounters them, that wretch Syrgak"},{"id":"manas-2010:p1613:b001:l002","ordinal":69458,"en":"Spears heroes on the slope."},{"id":"manas-2010:p1613:b001:l003","ordinal":69459,"en":"The iron-eared giant Kutan—"},{"id":"manas-2010:p1613:b001:l004","ordinal":69460,"en":"He spears seven in a row at once."},{"id":"manas-2010:p1613:b001:l005","ordinal":69461,"en":"If brave Syrgak has his way,"},{"id":"manas-2010:p1613:b001:l006","ordinal":69462,"en":"Let him not bring about my end;"},{"id":"manas-2010:p1613:b001:l007","ordinal":69463,"en":"These Chinese standing here,"},{"id":"manas-2010:p1613:b001:l008","ordinal":69464,"en":"Let him not slaughter them all!"},{"id":"manas-2010:p1613:b001:l009","ordinal":69465,"en":"My dear Kojozhash,"},{"id":"manas-2010:p1613:b001:l010","ordinal":69466,"en":"Treat my words as words to heed."},{"id":"manas-2010:p1613:b001:l011","ordinal":69467,"en":"Why should I speak of anything else?"},{"id":"manas-2010:p1613:b001:l012","ordinal":69468,"en":"Take aim at that wretch Syrgak!"},{"id":"manas-2010:p1613:b001:l013","ordinal":69469,"en":"This Great Beijing standing here"},{"id":"manas-2010:p1613:b001:l014","ordinal":69470,"en":"Is ground no man could tread."},{"id":"manas-2010:p1613:b001:l015","ordinal":69471,"en":"Except that Manas is renowned,"},{"id":"manas-2010:p1613:b001:l016","ordinal":69472,"en":"His Syrgak surpasses Manas"},{"id":"manas-2010:p1613:b001:l017","ordinal":69473,"en":"By a lance-thrust in valor."},{"id":"manas-2010:p1613:b001:l018","ordinal":69474,"en":"His skill is something else;"},{"id":"manas-2010:p1613:b001:l019","ordinal":69475,"en":"It has not left my very bones,"},{"id":"manas-2010:p1613:b001:l020","ordinal":69476,"en":"The thrust of Syrgak's lance."},{"id":"manas-2010:p1613:b001:l021","ordinal":69477,"en":"Yesterday, Almambet and Syrgak leading,"},{"id":"manas-2010:p1613:b001:l022","ordinal":69478,"en":"When together they brought destruction,"},{"id":"manas-2010:p1613:b001:l023","ordinal":69479,"en":"Along Kyr-Kayyn,"},{"id":"manas-2010:p1613:b001:l024","ordinal":69480,"en":"When they raided my horses,"},{"id":"manas-2010:p1613:b001:l025","ordinal":69481,"en":"I, the fearless hero,"},{"id":"manas-2010:p1613:b001:l026","ordinal":69482,"en":"When I pursued them,"},{"id":"manas-2010:p1613:b001:l027","ordinal":69483,"en":"When I attacked without restraint,"},{"id":"manas-2010:p1613:b001:l028","ordinal":69484,"en":"Turning across and fighting,"},{"id":"manas-2010:p1613:b001:l029","ordinal":69485,"en":"Not sparing my own life,"},{"id":"manas-2010:p1613:b001:l030","ordinal":69486,"en":"Then I saw Syrgak,"},{"id":"manas-2010:p1613:b001:l031","ordinal":69487,"en":"The rogue who would wreck the world."},{"id":"manas-2010:p1613:b001:l032","ordinal":69488,"en":"When Algara beneath me"},{"id":"manas-2010:p1613:b001:l033","ordinal":69489,"en":"Bounded away,"},{"id":"manas-2010:p1613:b001:l034","ordinal":69490,"en":"Two of my ribs,"},{"id":"manas-2010:p1613:b001:l035","ordinal":69491,"en":"Struck then by the lance,"},{"id":"manas-2010:p1613:b001:l036","ordinal":69492,"en":"Were shattered clean through."},{"id":"manas-2010:p1613:b001:l037","ordinal":69493,"en":"I took in his bearing,"},{"id":"manas-2010:p1613:b001:l038","ordinal":69494,"en":"I recognized his greatness."},{"id":"manas-2010:p1613:b001:l039","ordinal":69495,"en":"“I will capture him alive,” I thought;"},{"id":"manas-2010:p1613:b001:l040","ordinal":69496,"en":"All of my champions"},{"id":"manas-2010:p1613:b001:l041","ordinal":69497,"en":"I sent swarming into battle."},{"id":"manas-2010:p1613:b001:l042","ordinal":69498,"en":"Of so many champions,"},{"id":"manas-2010:p1614:b001:l001","ordinal":69499,"en":"He drove all sleep away,"},{"id":"manas-2010:p1614:b001:l002","ordinal":69500,"en":"And laid so many of my lands waste."},{"id":"manas-2010:p1614:b001:l003","ordinal":69501,"en":"If you finish Syrgak off,"},{"id":"manas-2010:p1614:b001:l004","ordinal":69502,"en":"The Burut will lose their support."},{"id":"manas-2010:p1614:b001:l005","ordinal":69503,"en":"After that, against the Burut,"},{"id":"manas-2010:p1614:b001:l006","ordinal":69504,"en":"When we charge, no blood will sate us."},{"id":"manas-2010:p1614:b001:l007","ordinal":69505,"en":"We shall give them no time to blink."},{"id":"manas-2010:p1614:b001:l008","ordinal":69506,"en":"If you shoot Syrgak dead,"},{"id":"manas-2010:p1614:b001:l009","ordinal":69507,"en":"We shall plunder their valuables,"},{"id":"manas-2010:p1614:b001:l010","ordinal":69508,"en":"And bring destruction in earnest."},{"id":"manas-2010:p1614:b001:l011","ordinal":69509,"en":"The Chinese, people of forty khans,"},{"id":"manas-2010:p1614:b001:l012","ordinal":69510,"en":"We shall gather in celebration."},{"id":"manas-2010:p1614:b001:l013","ordinal":69511,"en":"Smashing and slaughtering the Burut,"},{"id":"manas-2010:p1614:b001:l014","ordinal":69512,"en":"We shall kill them all the way to Mecca."},{"id":"manas-2010:p1614:b001:l015","ordinal":69513,"en":"If the Burut flee,"},{"id":"manas-2010:p1614:b001:l016","ordinal":69514,"en":"Without turning back we shall thrust our lances."},{"id":"manas-2010:p1614:b001:l017","ordinal":69515,"en":"Their valiant Manas is wounded;"},{"id":"manas-2010:p1614:b001:l018","ordinal":69516,"en":"Smashing, spearing and crushing him,"},{"id":"manas-2010:p1614:b001:l019","ordinal":69517,"en":"We shall heap torments upon him."},{"id":"manas-2010:p1614:b001:l020","ordinal":69518,"en":"The girls they carried off,"},{"id":"manas-2010:p1614:b001:l021","ordinal":69519,"en":"We shall take back."},{"id":"manas-2010:p1614:b001:l022","ordinal":69520,"en":"We shall spear those who resist;"},{"id":"manas-2010:p1614:b001:l023","ordinal":69521,"en":"Of the Burut lying there,"},{"id":"manas-2010:p1614:b001:l024","ordinal":69522,"en":"We shall plunder the gold as well."},{"id":"manas-2010:p1614:b001:l025","ordinal":69523,"en":"We shall open their treasury,"},{"id":"manas-2010:p1614:b001:l026","ordinal":69524,"en":"And scatter their blood like water!"},{"id":"manas-2010:p1614:b001:l027","ordinal":69525,"en":"You were the surpassing champion,"},{"id":"manas-2010:p1614:b001:l028","ordinal":69526,"en":"The one who emerged when ruin threatened;"},{"id":"manas-2010:p1614:b001:l029","ordinal":69527,"en":"When entering battle with the enemy,"},{"id":"manas-2010:p1614:b001:l030","ordinal":69528,"en":"I was the one who found a way!”"},{"id":"manas-2010:p1614:b001:l031","ordinal":69529,"en":"Kojozhash, son of Karazhoy,"},{"id":"manas-2010:p1614:b001:l032","ordinal":69530,"en":"After hearing the Fierce One's words,"},{"id":"manas-2010:p1614:b001:l033","ordinal":69531,"en":"Spared not his own life,"},{"id":"manas-2010:p1614:b001:l034","ordinal":69532,"en":"Nor stood still in distress."},{"id":"manas-2010:p1614:b001:l035","ordinal":69533,"en":"The reason he did not stand still:"},{"id":"manas-2010:p1614:b001:l036","ordinal":69534,"en":"He was the Chinese people's support and stay,"},{"id":"manas-2010:p1614:b001:l037","ordinal":69535,"en":"A son of Karazhoy,"},{"id":"manas-2010:p1614:b001:l038","ordinal":69536,"en":"Who had studied alongside Almambet,"},{"id":"manas-2010:p1614:b001:l039","ordinal":69537,"en":"And become a skilled fellow."},{"id":"manas-2010:p1614:b001:l040","ordinal":69538,"en":"A master horseman, fleet on foot,"},{"id":"manas-2010:p1614:b001:l041","ordinal":69539,"en":"The treasury's great marksman."},{"id":"manas-2010:p1614:b001:l042","ordinal":69540,"en":"Earlier, when Manas took Beijing,"},{"id":"manas-2010:p1615:b001:l001","ordinal":69541,"en":"When he wrought utter ruin,"},{"id":"manas-2010:p1615:b001:l002","ordinal":69542,"en":"When the Burut had their fill of booty,"},{"id":"manas-2010:p1615:b001:l003","ordinal":69543,"en":"For eight years Kojozhash"},{"id":"manas-2010:p1615:b001:l004","ordinal":69544,"en":"Had lain ill with fever."},{"id":"manas-2010:p1615:b001:l005","ordinal":69545,"en":"This year Kojozhash"},{"id":"manas-2010:p1615:b001:l006","ordinal":69546,"en":"Had recovered from the fever."},{"id":"manas-2010:p1615:b001:l007","ordinal":69547,"en":"His mind was deeply troubled,"},{"id":"manas-2010:p1615:b001:l008","ordinal":69548,"en":"Fire poured from his eyes."},{"id":"manas-2010:p1615:b001:l009","ordinal":69549,"en":"“Upon the fugitive Almambet"},{"id":"manas-2010:p1615:b001:l010","ordinal":69550,"en":"And the Burut fighting here,"},{"id":"manas-2010:p1615:b001:l011","ordinal":69551,"en":"I shall bring a day of ruin."},{"id":"manas-2010:p1615:b001:l012","ordinal":69552,"en":"Other Chinese, do not trouble yourselves;"},{"id":"manas-2010:p1615:b001:l013","ordinal":69553,"en":"I shall take them alone."},{"id":"manas-2010:p1615:b001:l014","ordinal":69554,"en":"Of the Burut who raise their cries,"},{"id":"manas-2010:p1615:b001:l015","ordinal":69555,"en":"If I bring down the strongest,"},{"id":"manas-2010:p1615:b001:l016","ordinal":69556,"en":"This is the spectacle we shall make:"},{"id":"manas-2010:p1615:b001:l017","ordinal":69557,"en":"Their wounded Manas"},{"id":"manas-2010:p1615:b001:l018","ordinal":69558,"en":"We shall capture alive."},{"id":"manas-2010:p1615:b001:l019","ordinal":69559,"en":"Do not despair, Kongurbay!"},{"id":"manas-2010:p1615:b001:l020","ordinal":69560,"en":"There is no ship upon the dark water."},{"id":"manas-2010:p1615:b001:l021","ordinal":69561,"en":"For so many years I lay ill;"},{"id":"manas-2010:p1615:b001:l022","ordinal":69562,"en":"Otherwise, none could stand against me!”"},{"id":"manas-2010:p1615:b001:l023","ordinal":69563,"en":"Thus spoke Kojozhash."},{"id":"manas-2010:p1615:b001:l024","ordinal":69564,"en":"Making ready, bracing himself,"},{"id":"manas-2010:p1615:b001:l025","ordinal":69565,"en":"Thundering upon his gray mare,"},{"id":"manas-2010:p1615:b001:l026","ordinal":69566,"en":"Swaying as though struck by a spirit,"},{"id":"manas-2010:p1615:b001:l027","ordinal":69567,"en":"His eyes like hollows of a lake,"},{"id":"manas-2010:p1615:b001:l028","ordinal":69568,"en":"He was a man of splendid bearing,"},{"id":"manas-2010:p1615:b001:l029","ordinal":69569,"en":"As though to swallow all he saw."},{"id":"manas-2010:p1615:b001:l030","ordinal":69570,"en":"His eyes were glowing red coals;"},{"id":"manas-2010:p1615:b001:l031","ordinal":69571,"en":"He was a fierce fellow sprung from Beijing."},{"id":"manas-2010:p1615:b001:l032","ordinal":69572,"en":"Loaded upon six elephants"},{"id":"manas-2010:p1615:b001:l033","ordinal":69573,"en":"Were his ready steel bullets."},{"id":"manas-2010:p1615:b001:l034","ordinal":69574,"en":"Hearing this, Kongurbay,"},{"id":"manas-2010:p1615:b001:l035","ordinal":69575,"en":"And the people of forty khans rejoiced;"},{"id":"manas-2010:p1615:b001:l036","ordinal":69576,"en":"They beat their battle-drums,"},{"id":"manas-2010:p1615:b001:l037","ordinal":69577,"en":"They sounded their horns."},{"id":"manas-2010:p1615:b001:l038","ordinal":69578,"en":"Their day of rejoicing dawned."},{"id":"manas-2010:p1615:b001:l039","ordinal":69579,"en":"With the hero, the Fierce One, at their head,"},{"id":"manas-2010:p1615:b001:l040","ordinal":69580,"en":"They advanced and overwhelmed them,"},{"id":"manas-2010:p1615:b001:l041","ordinal":69581,"en":"They brought calamity."},{"id":"manas-2010:p1615:b001:l042","ordinal":69582,"en":"Not a living steed left behind,"},{"id":"manas-2010:p1616:b001:l001","ordinal":69583,"en":"Not a moving soul left behind,"},{"id":"manas-2010:p1616:b001:l002","ordinal":69584,"en":"In multitudes of every kind,"},{"id":"manas-2010:p1616:b001:l003","ordinal":69585,"en":"They surged and swarmed,"},{"id":"manas-2010:p1616:b001:l004","ordinal":69586,"en":"Like grass growing from the earth."},{"id":"manas-2010:p1616:b001:l005","ordinal":69587,"en":"The Chinese surged without stopping,"},{"id":"manas-2010:p1616:b001:l006","ordinal":69588,"en":"With the mountain-like Fierce One as khan,"},{"id":"manas-2010:p1616:b001:l007","ordinal":69589,"en":"And at the banner's foot, the great marksman,"},{"id":"manas-2010:p1616:b001:l008","ordinal":69590,"en":"Their Kojozhash was there."},{"id":"manas-2010:p1616:b001:l009","ordinal":69591,"en":"The Chinese people of forty khans"},{"id":"manas-2010:p1616:b001:l010","ordinal":69592,"en":"Brought a day of terrible distress."},{"id":"manas-2010:p1616:b001:l011","ordinal":69593,"en":"When the Chinese swept upon them,"},{"id":"manas-2010:p1616:b001:l012","ordinal":69594,"en":"The witless grieved;"},{"id":"manas-2010:p1616:b001:l013","ordinal":69595,"en":"The champions with courage said,"},{"id":"manas-2010:p1616:b001:l014","ordinal":69596,"en":"“So be it, we shall die as martyrs!”"},{"id":"manas-2010:p1616:b001:l015","ordinal":69597,"en":"They took heart and rejoiced."},{"id":"manas-2010:p1616:b001:l016","ordinal":69598,"en":"(Seen today, gone tomorrow—"},{"id":"manas-2010:p1616:b001:l017","ordinal":69599,"en":"Your father's grave! This wicked world!)"},{"id":"manas-2010:p1616:b001:l018","ordinal":69600,"en":"“Such is this faithless world;"},{"id":"manas-2010:p1616:b001:l019","ordinal":69601,"en":"Our dear land where we were born and raised,"},{"id":"manas-2010:p1616:b001:l020","ordinal":69602,"en":"We shall die without seeing it.”"},{"id":"manas-2010:p1616:b001:l021","ordinal":69603,"en":"“To Beijing that no saint could touch,"},{"id":"manas-2010:p1616:b001:l022","ordinal":69604,"en":"We came, saying we would fight,"},{"id":"manas-2010:p1616:b001:l023","ordinal":69605,"en":"And now we are trapped in torment,”"},{"id":"manas-2010:p1616:b001:l024","ordinal":69606,"en":"The half-witted simpletons"},{"id":"manas-2010:p1616:b001:l025","ordinal":69607,"en":"Thought, whimpering thus."},{"id":"manas-2010:p1616:b001:l026","ordinal":69608,"en":"Clear sky, darkened earth,"},{"id":"manas-2010:p1616:b001:l027","ordinal":69609,"en":"Not a blade could be seen upon the ground."},{"id":"manas-2010:p1616:b001:l028","ordinal":69610,"en":"The Chinese swept in, surging;"},{"id":"manas-2010:p1616:b001:l029","ordinal":69611,"en":"Lance-tips clashed,"},{"id":"manas-2010:p1616:b001:l030","ordinal":69612,"en":"Pitch-black night descended,"},{"id":"manas-2010:p1616:b001:l031","ordinal":69613,"en":"Men struck heads from bodies."},{"id":"manas-2010:p1616:b001:l032","ordinal":69614,"en":"Turning back without restraint,"},{"id":"manas-2010:p1616:b001:l033","ordinal":69615,"en":"The few Kyrgyz,"},{"id":"manas-2010:p1616:b001:l034","ordinal":69616,"en":"Sparing not their dear lives,"},{"id":"manas-2010:p1616:b001:l035","ordinal":69617,"en":"Then golden forelock and tasseled belt,"},{"id":"manas-2010:p1616:b001:l036","ordinal":69618,"en":"Azizkhan's only son,"},{"id":"manas-2010:p1616:b001:l037","ordinal":69619,"en":"Girded in perfected iron,"},{"id":"manas-2010:p1616:b001:l038","ordinal":69620,"en":"Against the Chinese teeming over the earth,"},{"id":"manas-2010:p1616:b001:l039","ordinal":69621,"en":"Attacked alone."},{"id":"manas-2010:p1616:b001:l040","ordinal":69622,"en":"At the sight of such an enemy,"},{"id":"manas-2010:p1616:b001:l041","ordinal":69623,"en":"The reckless one who spared nothing,"},{"id":"manas-2010:p1616:b001:l042","ordinal":69624,"en":"Who never withdrew what he thrust forth,"},{"id":"manas-2010:p1617:b001:l001","ordinal":69625,"en":"Who never lost his stern bearing,"},{"id":"manas-2010:p1617:b001:l002","ordinal":69626,"en":"Who rested his sword against its sheath,"},{"id":"manas-2010:p1617:b001:l003","ordinal":69627,"en":"When such a mighty enemy came,"},{"id":"manas-2010:p1617:b001:l004","ordinal":69628,"en":"He entered and attacked without hesitation,"},{"id":"manas-2010:p1617:b001:l005","ordinal":69629,"en":"Enveloping them in scarlet blood."},{"id":"manas-2010:p1617:b001:l006","ordinal":69630,"en":"The brim of the black felt hat,"},{"id":"manas-2010:p1617:b001:l007","ordinal":69631,"en":"Khan Manas's Syrgak,"},{"id":"manas-2010:p1617:b001:l008","ordinal":69632,"en":"Bringing good fortune when he led,"}]
