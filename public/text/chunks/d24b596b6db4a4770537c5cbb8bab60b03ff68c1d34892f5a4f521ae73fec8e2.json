[{"id":"manas-2010:p1116:b001:l031","ordinal":48641,"en":"When the Chinese pressed in,"},{"id":"manas-2010:p1116:b001:l032","ordinal":48642,"en":"My eyes blazing like a lion's,"},{"id":"manas-2010:p1116:b001:l033","ordinal":48643,"en":"As I was fighting,"},{"id":"manas-2010:p1116:b001:l034","ordinal":48644,"en":"Six hundred spears struck at once."},{"id":"manas-2010:p1116:b001:l035","ordinal":48645,"en":"My body was numb with wounds."},{"id":"manas-2010:p1116:b001:l036","ordinal":48646,"en":"Many battle-axes and spears struck me;"},{"id":"manas-2010:p1116:b001:l037","ordinal":48647,"en":"My head became a red bucket of blood."},{"id":"manas-2010:p1116:b001:l038","ordinal":48648,"en":"The only one who turned to help me"},{"id":"manas-2010:p1116:b001:l039","ordinal":48649,"en":"On that day of battle—"},{"id":"manas-2010:p1116:b001:l040","ordinal":48650,"en":"Sarala alone was a beast who became my kin."},{"id":"manas-2010:p1116:b001:l041","ordinal":48651,"en":"I could give myself for Sarala!"},{"id":"manas-2010:p1116:b001:l042","ordinal":48652,"en":"He set off on the dun-bay horse,"},{"id":"manas-2010:p1117:b001:l001","ordinal":48653,"en":"His dear head, small as a goat's,"},{"id":"manas-2010:p1117:b001:l002","ordinal":48654,"en":"Was bathed in scarlet blood."},{"id":"manas-2010:p1117:b001:l003","ordinal":48655,"en":"The steed Sarala beneath me"},{"id":"manas-2010:p1117:b001:l004","ordinal":48656,"en":"Lowered his head to the ground."},{"id":"manas-2010:p1117:b001:l005","ordinal":48657,"en":"Bearing me flying, roaring,"},{"id":"manas-2010:p1117:b001:l006","ordinal":48658,"en":"Stones flew from his four feet,"},{"id":"manas-2010:p1117:b001:l007","ordinal":48659,"en":"Whizzing directly over my head."},{"id":"manas-2010:p1117:b001:l008","ordinal":48660,"en":"His body had grown hot;"},{"id":"manas-2010:p1117:b001:l009","ordinal":48661,"en":"He took strides like a mountain sheep."},{"id":"manas-2010:p1117:b001:l010","ordinal":48662,"en":"The Chinese khan Ezkara,"},{"id":"manas-2010:p1117:b001:l011","ordinal":48663,"en":"The Kalmyk khan, hero Zholoy—"},{"id":"manas-2010:p1117:b001:l012","ordinal":48664,"en":"Seven mighty fighters joined together"},{"id":"manas-2010:p1117:b001:l013","ordinal":48665,"en":"And appeared before me."},{"id":"manas-2010:p1117:b001:l014","ordinal":48666,"en":"Against them, I, a wretched soul,"},{"id":"manas-2010:p1117:b001:l015","ordinal":48667,"en":"Fought all alone."},{"id":"manas-2010:p1117:b001:l016","ordinal":48668,"en":"When they began to turn back,"},{"id":"manas-2010:p1117:b001:l017","ordinal":48669,"en":"I caught them before they went far."},{"id":"manas-2010:p1117:b001:l018","ordinal":48670,"en":"The seven in seven places,"},{"id":"manas-2010:p1117:b001:l019","ordinal":48671,"en":"Sprawling them from their horses,"},{"id":"manas-2010:p1117:b001:l020","ordinal":48672,"en":"I struck them down as I passed."},{"id":"manas-2010:p1117:b001:l021","ordinal":48673,"en":"When I speared all seven together,"},{"id":"manas-2010:p1117:b001:l022","ordinal":48674,"en":"When they were parted from their horses,"},{"id":"manas-2010:p1117:b001:l023","ordinal":48675,"en":"My spear bent in the middle."},{"id":"manas-2010:p1117:b001:l024","ordinal":48676,"en":"My mortal soul was put under strain."},{"id":"manas-2010:p1117:b001:l025","ordinal":48677,"en":"Those seven enormous fighters,"},{"id":"manas-2010:p1117:b001:l026","ordinal":48678,"en":"When I speared them all alone,"},{"id":"manas-2010:p1117:b001:l027","ordinal":48679,"en":"My backside left the saddle,"},{"id":"manas-2010:p1117:b001:l028","ordinal":48680,"en":"My foot left the stirrup."},{"id":"manas-2010:p1117:b001:l029","ordinal":48681,"en":"Unable to take my battle-axe,"},{"id":"manas-2010:p1117:b001:l030","ordinal":48682,"en":"Into the gold-tread stirrup,"},{"id":"manas-2010:p1117:b001:l031","ordinal":48683,"en":"Unable to put my foot again,"},{"id":"manas-2010:p1117:b001:l032","ordinal":48684,"en":"When I was helpless,"},{"id":"manas-2010:p1117:b001:l033","ordinal":48685,"en":"The earth split with a thunderous roar."},{"id":"manas-2010:p1117:b001:l034","ordinal":48686,"en":"Alöökö's Kongurbay,"},{"id":"manas-2010:p1117:b001:l035","ordinal":48687,"en":"Speeding toward me,"},{"id":"manas-2010:p1117:b001:l036","ordinal":48688,"en":"Appearing like a flying bird,"},{"id":"manas-2010:p1117:b001:l037","ordinal":48689,"en":"Came on with a roar."},{"id":"manas-2010:p1117:b001:l038","ordinal":48690,"en":"Algara beneath him"},{"id":"manas-2010:p1117:b001:l039","ordinal":48691,"en":"Bounded like a mountain sheep."},{"id":"manas-2010:p1117:b001:l040","ordinal":48692,"en":"Countless Chinese, and I alone,"},{"id":"manas-2010:p1117:b001:l041","ordinal":48693,"en":"No person to give me support:"},{"id":"manas-2010:p1117:b001:l042","ordinal":48694,"en":"'The Chinese will slaughter me,' I thought."},{"id":"manas-2010:p1118:b001:l001","ordinal":48695,"en":"I gave up hope of life."},{"id":"manas-2010:p1118:b001:l002","ordinal":48696,"en":"Then my revered, pure mother"},{"id":"manas-2010:p1118:b001:l003","ordinal":48697,"en":"Mounted a bay mare."},{"id":"manas-2010:p1118:b001:l004","ordinal":48698,"en":"Her bundled black hair"},{"id":"manas-2010:p1118:b001:l005","ordinal":48699,"en":"She tied atop her head."},{"id":"manas-2010:p1118:b001:l006","ordinal":48700,"en":"'If death comes, I shall die,' she said."},{"id":"manas-2010:p1118:b001:l007","ordinal":48701,"en":"'For my precious, only Alma,"},{"id":"manas-2010:p1118:b001:l008","ordinal":48702,"en":"I shall be a protection."},{"id":"manas-2010:p1118:b001:l009","ordinal":48703,"en":"Remaining alive, without dying,"},{"id":"manas-2010:p1118:b001:l010","ordinal":48704,"en":"What purpose would I achieve?"},{"id":"manas-2010:p1118:b001:l011","ordinal":48705,"en":"For my precious champion, my only one,"},{"id":"manas-2010:p1118:b001:l012","ordinal":48706,"en":"I shall be a support,' she said,"},{"id":"manas-2010:p1118:b001:l013","ordinal":48707,"en":"And resolutely entered the enemy ranks."},{"id":"manas-2010:p1118:b001:l014","ordinal":48708,"en":"Skillfully forged of keen steel,"},{"id":"manas-2010:p1118:b001:l015","ordinal":48709,"en":"The polished spear with a red tuft,"},{"id":"manas-2010:p1118:b001:l016","ordinal":48710,"en":"My mother took in hand."},{"id":"manas-2010:p1118:b001:l017","ordinal":48711,"en":"Not letting him reach poor me,"},{"id":"manas-2010:p1118:b001:l018","ordinal":48712,"en":"Alöökö's Kalcha"},{"id":"manas-2010:p1118:b001:l019","ordinal":48713,"en":"She intercepted from the side."},{"id":"manas-2010:p1118:b001:l020","ordinal":48714,"en":"Amid the dust, my mother,"},{"id":"manas-2010:p1118:b001:l021","ordinal":48715,"en":"At Kongurbay's black horse,"},{"id":"manas-2010:p1118:b001:l022","ordinal":48716,"en":"His wings when he rode to war—"},{"id":"manas-2010:p1118:b001:l023","ordinal":48717,"en":"'By the lung and liver,' she thought,"},{"id":"manas-2010:p1118:b001:l024","ordinal":48718,"en":"'At the lower edge of the heart."},{"id":"manas-2010:p1118:b001:l025","ordinal":48719,"en":"If I spear his horse, I have won;"},{"id":"manas-2010:p1118:b001:l026","ordinal":48720,"en":"Then I do not mind if I die.'"},{"id":"manas-2010:p1118:b001:l027","ordinal":48721,"en":"Holding her spear short,"},{"id":"manas-2010:p1118:b001:l028","ordinal":48722,"en":"My mother took aim."},{"id":"manas-2010:p1118:b001:l029","ordinal":48723,"en":"Into the black horse, with a thud,"},{"id":"manas-2010:p1118:b001:l030","ordinal":48724,"en":"She drove a blow."},{"id":"manas-2010:p1118:b001:l031","ordinal":48725,"en":"My mother's courage—"},{"id":"manas-2010:p1118:b001:l032","ordinal":48726,"en":"However much courage she showed,"},{"id":"manas-2010:p1118:b001:l033","ordinal":48727,"en":"Her physical strength fell short."},{"id":"manas-2010:p1118:b001:l034","ordinal":48728,"en":"When she was to spear Algara,"},{"id":"manas-2010:p1118:b001:l035","ordinal":48729,"en":"She closed her eyes."},{"id":"manas-2010:p1118:b001:l036","ordinal":48730,"en":"The broad-handspan polished spear"},{"id":"manas-2010:p1118:b001:l037","ordinal":48731,"en":"Struck too low."},{"id":"manas-2010:p1118:b001:l038","ordinal":48732,"en":"The muscle of the upper foreleg,"},{"id":"manas-2010:p1118:b001:l039","ordinal":48733,"en":"She pierced and tore."},{"id":"manas-2010:p1118:b001:l040","ordinal":48734,"en":"A bowl-sized piece of muscle"},{"id":"manas-2010:p1118:b001:l041","ordinal":48735,"en":"She tore away with her spear."},{"id":"manas-2010:p1118:b001:l042","ordinal":48736,"en":"When he looked at his horse's condition,"},{"id":"manas-2010:p1119:b001:l001","ordinal":48737,"en":"It was running on three legs."},{"id":"manas-2010:p1119:b001:l002","ordinal":48738,"en":"'My precious life is lost!' he cried."},{"id":"manas-2010:p1119:b001:l003","ordinal":48739,"en":"The great Kalcha, out of his senses,"},{"id":"manas-2010:p1119:b001:l004","ordinal":48740,"en":"Despairing of his dear life,"},{"id":"manas-2010:p1119:b001:l005","ordinal":48741,"en":"Over saddle-shaped passes and ridges,"},{"id":"manas-2010:p1119:b001:l006","ordinal":48742,"en":"Was crossing away."},{"id":"manas-2010:p1119:b001:l007","ordinal":48743,"en":"Deprived of his wits,"},{"id":"manas-2010:p1119:b001:l008","ordinal":48744,"en":"He was in a panic."},{"id":"manas-2010:p1119:b001:l009","ordinal":48745,"en":"Turning back in confusion,"},{"id":"manas-2010:p1119:b001:l010","ordinal":48746,"en":"Heading toward Beijing,"},{"id":"manas-2010:p1119:b001:l011","ordinal":48747,"en":"He was fleeing."},{"id":"manas-2010:p1119:b001:l012","ordinal":48748,"en":"My insides burned and became fire."},{"id":"manas-2010:p1119:b001:l013","ordinal":48749,"en":"'If only I could catch Kongurbay!'"},{"id":"manas-2010:p1119:b001:l014","ordinal":48750,"en":"My two eyes became four with longing."},{"id":"manas-2010:p1119:b001:l015","ordinal":48751,"en":"'If only I could catch this dog,"},{"id":"manas-2010:p1119:b001:l016","ordinal":48752,"en":"Catch him and cut off his head,"},{"id":"manas-2010:p1119:b001:l017","ordinal":48753,"en":"With it tied to my saddle straps,"},{"id":"manas-2010:p1119:b001:l018","ordinal":48754,"en":"To the khan of the west"},{"id":"manas-2010:p1119:b001:l019","ordinal":48755,"en":"Take it as a gift!'"},{"id":"manas-2010:p1119:b001:l020","ordinal":48756,"en":"Whirling up the red sand,"},{"id":"manas-2010:p1119:b001:l021","ordinal":48757,"en":"Not glancing at anything else,"},{"id":"manas-2010:p1119:b001:l022","ordinal":48758,"en":"Upon the pure, swift Sarala,"},{"id":"manas-2010:p1119:b001:l023","ordinal":48759,"en":"I laid one lash on his flank."},{"id":"manas-2010:p1119:b001:l024","ordinal":48760,"en":"After Kongurbay,"},{"id":"manas-2010:p1119:b001:l025","ordinal":48761,"en":"Then I sped at a run."},{"id":"manas-2010:p1119:b001:l026","ordinal":48762,"en":"At the nearer edge of Beijing,"},{"id":"manas-2010:p1119:b001:l027","ordinal":48763,"en":"I reached him in fierce pursuit."},{"id":"manas-2010:p1119:b001:l028","ordinal":48764,"en":"His plate armor forged of gold—"},{"id":"manas-2010:p1119:b001:l029","ordinal":48765,"en":"'Here is its very edge,' I thought."},{"id":"manas-2010:p1119:b001:l030","ordinal":48766,"en":"'At the shoulder blade,"},{"id":"manas-2010:p1119:b001:l031","ordinal":48767,"en":"Opposite lung and liver,"},{"id":"manas-2010:p1119:b001:l032","ordinal":48768,"en":"Right at the point of the heart.'"},{"id":"manas-2010:p1119:b001:l033","ordinal":48769,"en":"With the polished spear's steel point,"},{"id":"manas-2010:p1119:b001:l034","ordinal":48770,"en":"I drove a mighty blow as I passed."},{"id":"manas-2010:p1119:b001:l035","ordinal":48771,"en":"When I struck the Kalcha,"},{"id":"manas-2010:p1119:b001:l036","ordinal":48772,"en":"I made him know my valor."},{"id":"manas-2010:p1119:b001:l037","ordinal":48773,"en":"That mountain-sized pig,"},{"id":"manas-2010:p1119:b001:l038","ordinal":48774,"en":"I drove onto his horse's withers."},{"id":"manas-2010:p1119:b001:l039","ordinal":48775,"en":"With anguish in my heart,"},{"id":"manas-2010:p1119:b001:l040","ordinal":48776,"en":"My two eyes blazing,"},{"id":"manas-2010:p1119:b001:l041","ordinal":48777,"en":"'Let me seize his lower hem,' I thought,"},{"id":"manas-2010:p1119:b001:l042","ordinal":48778,"en":"Thrusting at the Kalcha."},{"id":"manas-2010:p1120:b001:l001","ordinal":48779,"en":"From atop Algara,"},{"id":"manas-2010:p1120:b001:l002","ordinal":48780,"en":"'Let me scoop him off and throw him down!'"},{"id":"manas-2010:p1120:b001:l003","ordinal":48781,"en":"That was my whole desire then."},{"id":"manas-2010:p1120:b001:l004","ordinal":48782,"en":"Unable to see me, worrying greatly,"},{"id":"manas-2010:p1120:b001:l005","ordinal":48783,"en":"Riding on Kögala,"},{"id":"manas-2010:p1120:b001:l006","ordinal":48784,"en":"His tears streaming in ten directions,"},{"id":"manas-2010:p1120:b001:l007","ordinal":48785,"en":"Dear Mazhik, my noble falcon,"},{"id":"manas-2010:p1120:b001:l008","ordinal":48786,"en":"Looking out directly ahead of me,"},{"id":"manas-2010:p1120:b001:l009","ordinal":48787,"en":"Was trying to intercept me."},{"id":"manas-2010:p1120:b001:l010","ordinal":48788,"en":"At that time my Mazhik"},{"id":"manas-2010:p1120:b001:l011","ordinal":48789,"en":"Reached me and seized me."},{"id":"manas-2010:p1120:b001:l012","ordinal":48790,"en":"Agitating me and making me struggle,"},{"id":"manas-2010:p1120:b001:l013","ordinal":48791,"en":"He escorted me away, refusing to release me,"},{"id":"manas-2010:p1120:b001:l014","ordinal":48792,"en":"Making poor me wrench against him."},{"id":"manas-2010:p1120:b001:l015","ordinal":48793,"en":"Then Mazhik spoke words;"},{"id":"manas-2010:p1120:b001:l016","ordinal":48794,"en":"When he spoke, he said:"},{"id":"manas-2010:p1120:b001:l017","ordinal":48795,"en":"'Kongurbay's black horse—"},{"id":"manas-2010:p1120:b001:l018","ordinal":48796,"en":"His black horse has"},{"id":"manas-2010:p1120:b001:l019","ordinal":48797,"en":"Wings upon its flanks."},{"id":"manas-2010:p1120:b001:l020","ordinal":48798,"en":"Whenever it is pursued,"},{"id":"manas-2010:p1120:b001:l021","ordinal":48799,"en":"It never lets the pursuer catch it."},{"id":"manas-2010:p1120:b001:l022","ordinal":48800,"en":"A true wondrous steed among beasts—"},{"id":"manas-2010:p1120:b001:l023","ordinal":48801,"en":"Were I to tell, its virtues are many."},{"id":"manas-2010:p1120:b001:l024","ordinal":48802,"en":"When Algara truly runs,"},{"id":"manas-2010:p1120:b001:l025","ordinal":48803,"en":"Dust cannot catch it, let alone a breeze."},{"id":"manas-2010:p1120:b001:l026","ordinal":48804,"en":"This infidel's horse,"},{"id":"manas-2010:p1120:b001:l027","ordinal":48805,"en":"No four-legged beast can catch."},{"id":"manas-2010:p1120:b001:l028","ordinal":48806,"en":"Unless it is a winged bird,"},{"id":"manas-2010:p1120:b001:l029","ordinal":48807,"en":"No other creature can catch it."},{"id":"manas-2010:p1120:b001:l030","ordinal":48808,"en":"The Kalcha riding on its back,"},{"id":"manas-2010:p1120:b001:l031","ordinal":48809,"en":"I will not belittle as an enemy."},{"id":"manas-2010:p1120:b001:l032","ordinal":48810,"en":"Even in a fight, strength will not suffice."},{"id":"manas-2010:p1120:b001:l033","ordinal":48811,"en":"Alöökö's Kalcha"},{"id":"manas-2010:p1120:b001:l034","ordinal":48812,"en":"Has plainly deceived you."},{"id":"manas-2010:p1120:b001:l035","ordinal":48813,"en":"To enter through the gate,"},{"id":"manas-2010:p1120:b001:l036","ordinal":48814,"en":"He has devised his scheme."},{"id":"manas-2010:p1120:b001:l037","ordinal":48815,"en":"Fleeing into Beijing,"},{"id":"manas-2010:p1120:b001:l038","ordinal":48816,"en":"Will he not close the gate's mouth?"},{"id":"manas-2010:p1120:b001:l039","ordinal":48817,"en":"Will his mighty fighters not crowd around"},{"id":"manas-2010:p1120:b001:l040","ordinal":48818,"en":"And split your head with blows?'"},{"id":"manas-2010:p1120:b001:l041","ordinal":48819,"en":"Saying this, my Mazhik"},{"id":"manas-2010:p1120:b001:l042","ordinal":48820,"en":"Kindled my extinguished fire,"},{"id":"manas-2010:p1121:b001:l001","ordinal":48821,"en":"Revived my dead soul,"},{"id":"manas-2010:p1121:b001:l002","ordinal":48822,"en":"And Kongurbay's stratagem"},{"id":"manas-2010:p1121:b001:l003","ordinal":48823,"en":"He explained and made known to me."},{"id":"manas-2010:p1121:b001:l004","ordinal":48824,"en":"In my eagerness, the Kalcha"},{"id":"manas-2010:p1121:b001:l005","ordinal":48825,"en":"I had pursued hard."},{"id":"manas-2010:p1121:b001:l006","ordinal":48826,"en":"From entering through the gate,"},{"id":"manas-2010:p1121:b001:l007","ordinal":48827,"en":"I was one calling-distance away."},{"id":"manas-2010:p1121:b001:l008","ordinal":48828,"en":"Turning aside in a rush,"},{"id":"manas-2010:p1121:b001:l009","ordinal":48829,"en":"I went back into the battle."},{"id":"manas-2010:p1121:b001:l010","ordinal":48830,"en":"When I entered the battlefield,"},{"id":"manas-2010:p1121:b001:l011","ordinal":48831,"en":"The slaughtered Chinese lay like grass."},{"id":"manas-2010:p1121:b001:l012","ordinal":48832,"en":"Those my mother had slaughtered"},{"id":"manas-2010:p1121:b001:l013","ordinal":48833,"en":"Were far more numerous."},{"id":"manas-2010:p1121:b001:l014","ordinal":48834,"en":"Looking down, its head lowered,"},{"id":"manas-2010:p1121:b001:l015","ordinal":48835,"en":"My mother no longer upon it,"},{"id":"manas-2010:p1121:b001:l016","ordinal":48836,"en":"Standing alone in one place,"},{"id":"manas-2010:p1121:b001:l017","ordinal":48837,"en":"Her bay mare was left riderless."},{"id":"manas-2010:p1121:b001:l018","ordinal":48838,"en":"Taking her mare along,"},{"id":"manas-2010:p1121:b001:l019","ordinal":48839,"en":"I cried out until my strength was gone."},{"id":"manas-2010:p1121:b001:l020","ordinal":48840,"en":"'Altynay, my precious mother!'"},{"id":"manas-2010:p1121:b001:l021","ordinal":48841,"en":"I called over and over."},{"id":"manas-2010:p1121:b001:l022","ordinal":48842,"en":"When I looked, she was not in sight."},{"id":"manas-2010:p1121:b001:l023","ordinal":48843,"en":"My dearest mother,"},{"id":"manas-2010:p1121:b001:l024","ordinal":48844,"en":"Among the countless Chinese,"},{"id":"manas-2010:p1121:b001:l025","ordinal":48845,"en":"Where she was could not be known."},{"id":"manas-2010:p1121:b001:l026","ordinal":48846,"en":"After a while, when I looked carefully,"},{"id":"manas-2010:p1121:b001:l027","ordinal":48847,"en":"The countless Chinese had gathered"},{"id":"manas-2010:p1121:b001:l028","ordinal":48848,"en":"And were beating their drum."},{"id":"manas-2010:p1121:b001:l029","ordinal":48849,"en":"Not one Chinese failed to rejoice."},{"id":"manas-2010:p1121:b001:l030","ordinal":48850,"en":"My mother's body,"},{"id":"manas-2010:p1121:b001:l031","ordinal":48851,"en":"They had mounted upon a mule"},{"id":"manas-2010:p1121:b001:l032","ordinal":48852,"en":"And sent it toward Beijing."},{"id":"manas-2010:p1121:b001:l033","ordinal":48853,"en":"Reaching the countless Chinese,"},{"id":"manas-2010:p1121:b001:l034","ordinal":48854,"en":"I scattered their tumult to dust."},{"id":"manas-2010:p1121:b001:l035","ordinal":48855,"en":"I became ice within their hearts."},{"id":"manas-2010:p1121:b001:l036","ordinal":48856,"en":"Slaughtering the Chinese completely,"},{"id":"manas-2010:p1121:b001:l037","ordinal":48857,"en":"I brought them to Judgment Day."},{"id":"manas-2010:p1121:b001:l038","ordinal":48858,"en":"Slaughtering and shattering them all,"},{"id":"manas-2010:p1121:b001:l039","ordinal":48859,"en":"I wrested my mother back."},{"id":"manas-2010:p1121:b001:l040","ordinal":48860,"en":"Her breast was filled with blood."},{"id":"manas-2010:p1121:b001:l041","ordinal":48861,"en":"Meeting one she should never have met,"},{"id":"manas-2010:p1121:b001:l042","ordinal":48862,"en":"Encountering Karazhoy,"},{"id":"manas-2010:p1122:b001:l001","ordinal":48863,"en":"Pierced by a musket ball,"},{"id":"manas-2010:p1122:b001:l002","ordinal":48864,"en":"My mother had become a martyr."},{"id":"manas-2010:p1122:b001:l003","ordinal":48865,"en":"After my mother died,"},{"id":"manas-2010:p1122:b001:l004","ordinal":48866,"en":"Unable to find any course,"},{"id":"manas-2010:p1122:b001:l005","ordinal":48867,"en":"Faint and bewildered,"},{"id":"manas-2010:p1122:b001:l006","ordinal":48868,"en":"I cried out, 'Mother!'"},{"id":"manas-2010:p1122:b001:l007","ordinal":48869,"en":"After my mother had died,"},{"id":"manas-2010:p1122:b001:l008","ordinal":48870,"en":"Unable to find a way,"},{"id":"manas-2010:p1122:b001:l009","ordinal":48871,"en":"I struck the polished spear into the earth."},{"id":"manas-2010:p1122:b001:l010","ordinal":48872,"en":"Tears poured from my eyes;"},{"id":"manas-2010:p1122:b001:l011","ordinal":48873,"en":"My forty ribs came apart."},{"id":"manas-2010:p1122:b001:l012","ordinal":48874,"en":"'Leave my mother; take me!' I cried,"},{"id":"manas-2010:p1122:b001:l013","ordinal":48875,"en":"Lying bent over, howling."},{"id":"manas-2010:p1122:b001:l014","ordinal":48876,"en":"There is no remedy for death."},{"id":"manas-2010:p1122:b001:l015","ordinal":48877,"en":"To bring the dead back to life,"},{"id":"manas-2010:p1122:b001:l016","ordinal":48878,"en":"Humankind has no power."},{"id":"manas-2010:p1122:b001:l017","ordinal":48879,"en":"If my mother could come here,"},{"id":"manas-2010:p1122:b001:l018","ordinal":48880,"en":"I would have no regret at all."},{"id":"manas-2010:p1122:b001:l019","ordinal":48881,"en":"From Beijing with its forty gates,"},{"id":"manas-2010:p1122:b001:l020","ordinal":48882,"en":"I turned back while fighting."},{"id":"manas-2010:p1122:b001:l021","ordinal":48883,"en":"Without sufficient strength, in battle,"},{"id":"manas-2010:p1122:b001:l022","ordinal":48884,"en":"At the place where my mother died,"},{"id":"manas-2010:p1122:b001:l023","ordinal":48885,"en":"Not even remaining there myself,"},{"id":"manas-2010:p1122:b001:l024","ordinal":48886,"en":"Not clashing to destruction with the Chinese,"},{"id":"manas-2010:p1122:b001:l025","ordinal":48887,"en":"Spattered with red blood,"},{"id":"manas-2010:p1122:b001:l026","ordinal":48888,"en":"Not turning aside to fight,"},{"id":"manas-2010:p1122:b001:l027","ordinal":48889,"en":"I parted from her in regret."},{"id":"manas-2010:p1122:b001:l028","ordinal":48890,"en":"As I stood thus,"},{"id":"manas-2010:p1122:b001:l029","ordinal":48891,"en":"Look at the mist, look at the flood!"},{"id":"manas-2010:p1122:b001:l030","ordinal":48892,"en":"Sweeping upon me from every side,"},{"id":"manas-2010:p1122:b001:l031","ordinal":48893,"en":"Look at the countless Chinese people!"},{"id":"manas-2010:p1122:b001:l032","ordinal":48894,"en":"If I happened to turn back"},{"id":"manas-2010:p1122:b001:l033","ordinal":48895,"en":"And fight the Chinese,"},{"id":"manas-2010:p1122:b001:l034","ordinal":48896,"en":"My dear, precious mother's"}]
