[{"id":"manas-2010:p1464:b001:l029","ordinal":63233,"en":"Leaning on his spear,"},{"id":"manas-2010:p1464:b001:l030","ordinal":63234,"en":"Upon Kartküröng,"},{"id":"manas-2010:p1464:b001:l031","ordinal":63235,"en":"He had fallen deeply asleep."},{"id":"manas-2010:p1464:b001:l032","ordinal":63236,"en":"As though lying in Talas,"},{"id":"manas-2010:p1464:b001:l033","ordinal":63237,"en":"He was snoring."},{"id":"manas-2010:p1464:b001:l034","ordinal":63238,"en":"As dawn was about to break brightly,"},{"id":"manas-2010:p1464:b001:l035","ordinal":63239,"en":"As the morning star was about to rise,"},{"id":"manas-2010:p1464:b001:l036","ordinal":63240,"en":"The stars in the sky, one by one,"},{"id":"manas-2010:p1464:b001:l037","ordinal":63241,"en":"Losing their light and growing dim,"},{"id":"manas-2010:p1464:b001:l038","ordinal":63242,"en":"Your blue-maned hero Manas"},{"id":"manas-2010:p1464:b001:l039","ordinal":63243,"en":"Put his hands into the water;"},{"id":"manas-2010:p1464:b001:l040","ordinal":63244,"en":"He performed the washing of his hands."},{"id":"manas-2010:p1464:b001:l041","ordinal":63245,"en":"He put his feet into the water;"},{"id":"manas-2010:p1464:b001:l042","ordinal":63246,"en":"He performed the washing of his feet."},{"id":"manas-2010:p1465:b001:l001","ordinal":63247,"en":"Pleading with his Lord,"},{"id":"manas-2010:p1465:b001:l002","ordinal":63248,"en":"Two customary and two obligatory,"},{"id":"manas-2010:p1465:b001:l003","ordinal":63249,"en":"Four cycles of the dawn"},{"id":"manas-2010:p1465:b001:l004","ordinal":63250,"en":"Prayer he prepared to perform:"},{"id":"manas-2010:p1465:b001:l005","ordinal":63251,"en":"“Prophet, my true faith,” he said,"},{"id":"manas-2010:p1465:b001:l006","ordinal":63252,"en":"“Support me, my one holy patron!” he said."},{"id":"manas-2010:p1465:b001:l007","ordinal":63253,"en":"Striding at an angle, swaying majestically,"},{"id":"manas-2010:p1465:b001:l008","ordinal":63254,"en":"Heading toward the tower,"},{"id":"manas-2010:p1465:b001:l009","ordinal":63255,"en":"Hero Manas, like Mount Opol,"},{"id":"manas-2010:p1465:b001:l010","ordinal":63256,"en":"Walked forth, towering high."},{"id":"manas-2010:p1465:b001:l011","ordinal":63257,"en":"Without boots, barefoot,"},{"id":"manas-2010:p1465:b001:l012","ordinal":63258,"en":"Without a helmet, in a skullcap,"},{"id":"manas-2010:p1465:b001:l013","ordinal":63259,"en":"Bending his knees to the ground,"},{"id":"manas-2010:p1465:b001:l014","ordinal":63260,"en":"To the top of the tower"},{"id":"manas-2010:p1465:b001:l015","ordinal":63261,"en":"He walked up, stretching tall."},{"id":"manas-2010:p1465:b001:l016","ordinal":63262,"en":"Coughing softly,"},{"id":"manas-2010:p1465:b001:l017","ordinal":63263,"en":"Facing the direction of Mecca,"},{"id":"manas-2010:p1465:b001:l018","ordinal":63264,"en":"Hero Manas gave the call to prayer,"},{"id":"manas-2010:p1465:b001:l019","ordinal":63265,"en":"Raising both hands."},{"id":"manas-2010:p1465:b001:l020","ordinal":63266,"en":"When he stood properly for the sermon,"},{"id":"manas-2010:p1465:b001:l021","ordinal":63267,"en":"Cotton-sashed, broad-booted,"},{"id":"manas-2010:p1465:b001:l022","ordinal":63268,"en":"Kongurbay, khan of the monks,"},{"id":"manas-2010:p1465:b001:l023","ordinal":63269,"en":"That majestic wretch,"},{"id":"manas-2010:p1465:b001:l024","ordinal":63270,"en":"The battle-axe with its golden band,"},{"id":"manas-2010:p1465:b001:l025","ordinal":63271,"en":"Took and swung."},{"id":"manas-2010:p1465:b001:l026","ordinal":63272,"en":"Manas, giving the call to prayer,"},{"id":"manas-2010:p1465:b001:l027","ordinal":63273,"en":"With both hands then,"},{"id":"manas-2010:p1465:b001:l028","ordinal":63274,"en":"He struck upon the nape."},{"id":"manas-2010:p1465:b001:l029","ordinal":63275,"en":"“Ah!” cried Manas, falling doubled over;"},{"id":"manas-2010:p1465:b001:l030","ordinal":63276,"en":"After the battle-axe struck,"},{"id":"manas-2010:p1465:b001:l031","ordinal":63277,"en":"He fell straight upon his head."},{"id":"manas-2010:p1465:b001:l032","ordinal":63278,"en":"The call to prayer fell silent;"},{"id":"manas-2010:p1465:b001:l033","ordinal":63279,"en":"Ajybay, who had fallen asleep,"},{"id":"manas-2010:p1465:b001:l034","ordinal":63280,"en":"Opened his eyes fully awake."},{"id":"manas-2010:p1465:b001:l035","ordinal":63281,"en":"Startled, Ajybay"},{"id":"manas-2010:p1465:b001:l036","ordinal":63282,"en":"Came dashing up."},{"id":"manas-2010:p1465:b001:l037","ordinal":63283,"en":"As the grim-faced one fled,"},{"id":"manas-2010:p1465:b001:l038","ordinal":63284,"en":"Ajybay, born resourceful,"},{"id":"manas-2010:p1465:b001:l039","ordinal":63285,"en":"Struck once with his spear."},{"id":"manas-2010:p1465:b001:l040","ordinal":63286,"en":"The grim-faced one fled swiftly;"},{"id":"manas-2010:p1465:b001:l041","ordinal":63287,"en":"After the spear struck squarely,"},{"id":"manas-2010:p1465:b001:l042","ordinal":63288,"en":"Shattering in many places,"},{"id":"manas-2010:p1466:b001:l001","ordinal":63289,"en":"When Ajybay thrust his spear,"},{"id":"manas-2010:p1466:b001:l002","ordinal":63290,"en":"Two rib bones,"},{"id":"manas-2010:p1466:b001:l003","ordinal":63291,"en":"Both crushed together,"},{"id":"manas-2010:p1466:b001:l004","ordinal":63292,"en":"Were shattered together."},{"id":"manas-2010:p1466:b001:l005","ordinal":63293,"en":"Kongurbay was wounded;"},{"id":"manas-2010:p1466:b001:l006","ordinal":63294,"en":"Algara beneath him"},{"id":"manas-2010:p1466:b001:l007","ordinal":63295,"en":"Moved forward at an amble."},{"id":"manas-2010:p1466:b001:l008","ordinal":63296,"en":"Black blood flowing from his flank"},{"id":"manas-2010:p1466:b001:l009","ordinal":63297,"en":"Streamed onto the dark earth."},{"id":"manas-2010:p1466:b001:l010","ordinal":63298,"en":"With people who knew nothing,"},{"id":"manas-2010:p1466:b001:l011","ordinal":63299,"en":"With his senses gone,"},{"id":"manas-2010:p1466:b001:l012","ordinal":63300,"en":"Losing strength and growing weak,"},{"id":"manas-2010:p1466:b001:l013","ordinal":63301,"en":"Losing his wits and staring dazed,"},{"id":"manas-2010:p1466:b001:l014","ordinal":63302,"en":"He barely made his way,"},{"id":"manas-2010:p1466:b001:l015","ordinal":63303,"en":"Bleeding without the blood stopping."},{"id":"manas-2010:p1466:b001:l016","ordinal":63304,"en":"Seeing the grim-faced one in this state,"},{"id":"manas-2010:p1466:b001:l017","ordinal":63305,"en":"When your grieving Ajy saw him,"},{"id":"manas-2010:p1466:b001:l018","ordinal":63306,"en":"“Manas has been wounded,”"},{"id":"manas-2010:p1466:b001:l019","ordinal":63307,"en":"Word spread among the multitude."},{"id":"manas-2010:p1466:b001:l020","ordinal":63308,"en":"The gates and doors were closed;"},{"id":"manas-2010:p1466:b001:l021","ordinal":63309,"en":"No winged bird could pass,"},{"id":"manas-2010:p1466:b001:l022","ordinal":63310,"en":"Beijing remained sealed tight,"},{"id":"manas-2010:p1466:b001:l023","ordinal":63311,"en":"No person could enter or leave,"},{"id":"manas-2010:p1466:b001:l024","ordinal":63312,"en":"A fortress standing all around."},{"id":"manas-2010:p1466:b001:l025","ordinal":63313,"en":"Kongurbay’s black horse,"},{"id":"manas-2010:p1466:b001:l026","ordinal":63314,"en":"His black horse had,"},{"id":"manas-2010:p1466:b001:l027","ordinal":63315,"en":"Upon its flanks, wings."},{"id":"manas-2010:p1466:b001:l028","ordinal":63316,"en":"Whenever there was a wall,"},{"id":"manas-2010:p1466:b001:l029","ordinal":63317,"en":"Curling like a cat,"},{"id":"manas-2010:p1466:b001:l030","ordinal":63318,"en":"It was his habit to leap across."},{"id":"manas-2010:p1466:b001:l031","ordinal":63319,"en":"The grim-faced one did not stand still;"},{"id":"manas-2010:p1466:b001:l032","ordinal":63320,"en":"When he struck the thigh with his whip,"},{"id":"manas-2010:p1466:b001:l033","ordinal":63321,"en":"Algara beneath him,"},{"id":"manas-2010:p1466:b001:l034","ordinal":63322,"en":"Over the high-built wall,"},{"id":"manas-2010:p1466:b001:l035","ordinal":63323,"en":"Leaped a whip’s length above it."},{"id":"manas-2010:p1466:b001:l036","ordinal":63324,"en":"How many hands"},{"id":"manas-2010:p1466:b001:l037","ordinal":63325,"en":"All snapped and cracked apart."},{"id":"manas-2010:p1466:b001:l038","ordinal":63326,"en":"The grim-faced one fell from atop him,"},{"id":"manas-2010:p1466:b001:l039","ordinal":63327,"en":"Tumbled from Algara,"},{"id":"manas-2010:p1466:b001:l040","ordinal":63328,"en":"Into a dug-out pit,"},{"id":"manas-2010:p1466:b001:l041","ordinal":63329,"en":"Fell inside and lay sprawled,"},{"id":"manas-2010:p1466:b001:l042","ordinal":63330,"en":"Fainting from loss of blood."},{"id":"manas-2010:p1467:b001:l001","ordinal":63331,"en":"Not one companion saw him."},{"id":"manas-2010:p1467:b001:l002","ordinal":63332,"en":"Alöökö’s son Kongurbay,"},{"id":"manas-2010:p1467:b001:l003","ordinal":63333,"en":"His death had not come; he did not die."},{"id":"manas-2010:p1467:b001:l004","ordinal":63334,"en":"From afar he had noticed:"},{"id":"manas-2010:p1467:b001:l005","ordinal":63335,"en":"Alöökö’s son Kongurbay"},{"id":"manas-2010:p1467:b001:l006","ordinal":63336,"en":"Had fallen into the pit;"},{"id":"manas-2010:p1467:b001:l007","ordinal":63337,"en":"Shuykuchu had seen it."},{"id":"manas-2010:p1467:b001:l008","ordinal":63338,"en":"Seeing it, Shuykuchu"},{"id":"manas-2010:p1467:b001:l009","ordinal":63339,"en":"Now walked toward him."},{"id":"manas-2010:p1467:b001:l010","ordinal":63340,"en":"Over Kongurbay,"},{"id":"manas-2010:p1467:b001:l011","ordinal":63341,"en":"He spread a covering."},{"id":"manas-2010:p1467:b001:l012","ordinal":63342,"en":"For forty days the grim-faced one lay weak,"},{"id":"manas-2010:p1467:b001:l013","ordinal":63343,"en":"Remaining in the pit."},{"id":"manas-2010:p1467:b001:l014","ordinal":63344,"en":"Slipping unseen and running,"},{"id":"manas-2010:p1467:b001:l015","ordinal":63345,"en":"Shuykuchu kept coming."},{"id":"manas-2010:p1467:b001:l016","ordinal":63346,"en":"To the grim-faced one lying stretched out,"},{"id":"manas-2010:p1467:b001:l017","ordinal":63347,"en":"In plenty, three times a day,"},{"id":"manas-2010:p1467:b001:l018","ordinal":63348,"en":"His food and drink"},{"id":"manas-2010:p1467:b001:l019","ordinal":63349,"en":"Shuykuchu kept giving."},{"id":"manas-2010:p1467:b001:l020","ordinal":63350,"en":"He kept treating him as well,"},{"id":"manas-2010:p1467:b001:l021","ordinal":63351,"en":"Coming each day to tend him."},{"id":"manas-2010:p1467:b001:l022","ordinal":63352,"en":"Of Shuykuchu, not a single person"},{"id":"manas-2010:p1467:b001:l023","ordinal":63353,"en":"Knew what he was doing."},{"id":"manas-2010:p1467:b001:l024","ordinal":63354,"en":"Treating the grim-faced one,"},{"id":"manas-2010:p1467:b001:l025","ordinal":63355,"en":"He rekindled his extinguished fire,"},{"id":"manas-2010:p1467:b001:l026","ordinal":63356,"en":"Revived his dead soul."},{"id":"manas-2010:p1467:b001:l027","ordinal":63357,"en":"Quieting his pain,"},{"id":"manas-2010:p1467:b001:l028","ordinal":63358,"en":"Opening his eyes fully awake,"},{"id":"manas-2010:p1467:b001:l029","ordinal":63359,"en":"He showed his sorcery."},{"id":"manas-2010:p1467:b001:l030","ordinal":63360,"en":"The grim-faced one of the Chinese"},{"id":"manas-2010:p1467:b001:l031","ordinal":63361,"en":"He dressed in a wandering mendicant’s guise."},{"id":"manas-2010:p1467:b001:l032","ordinal":63362,"en":"Giving a white staff into his hand,"},{"id":"manas-2010:p1467:b001:l033","ordinal":63363,"en":"Having him ask the people for alms,"},{"id":"manas-2010:p1467:b001:l034","ordinal":63364,"en":"He sent the grim-faced one on his way."},{"id":"manas-2010:p1467:b001:l035","ordinal":63365,"en":"Kongurbay’s forty lords,"},{"id":"manas-2010:p1467:b001:l036","ordinal":63366,"en":"Twisting their black hair like a girth,"},{"id":"manas-2010:p1467:b001:l037","ordinal":63367,"en":"Gathering it atop their heads,"},{"id":"manas-2010:p1467:b001:l038","ordinal":63368,"en":"Were wearing it rolled up then."},{"id":"manas-2010:p1467:b001:l039","ordinal":63369,"en":"“When will our khan come?” they said,"},{"id":"manas-2010:p1467:b001:l040","ordinal":63370,"en":"Leading Algara,"},{"id":"manas-2010:p1467:b001:l041","ordinal":63371,"en":"All waiting to meet him,"},{"id":"manas-2010:p1467:b001:l042","ordinal":63372,"en":"They were in anguish then."},{"id":"manas-2010:p1468:b001:l001","ordinal":63373,"en":"Counting the days that passed,"},{"id":"manas-2010:p1468:b001:l002","ordinal":63374,"en":"It was the time they had reckoned;"},{"id":"manas-2010:p1468:b001:l003","ordinal":63375,"en":"If he did not come that day,"},{"id":"manas-2010:p1468:b001:l004","ordinal":63376,"en":"It was time for them to leave."},{"id":"manas-2010:p1468:b001:l005","ordinal":63377,"en":"Bringing Algara across,"},{"id":"manas-2010:p1468:b001:l006","ordinal":63378,"en":"The forty lords came bowing,"},{"id":"manas-2010:p1468:b001:l007","ordinal":63379,"en":"Showing reverence to their khan."},{"id":"manas-2010:p1468:b001:l008","ordinal":63380,"en":"Dismounting, all of them"},{"id":"manas-2010:p1468:b001:l009","ordinal":63381,"en":"Bowed respectfully."},{"id":"manas-2010:p1468:b001:l010","ordinal":63382,"en":"Thus the lords arrived;"},{"id":"manas-2010:p1468:b001:l011","ordinal":63383,"en":"Where they reached the grim-faced one,"},{"id":"manas-2010:p1468:b001:l012","ordinal":63384,"en":"They mounted him upon Algara,"},{"id":"manas-2010:p1468:b001:l013","ordinal":63385,"en":"And took him away."},{"id":"manas-2010:p1468:b001:l014","ordinal":63386,"en":"With the forty lords at their head,"},{"id":"manas-2010:p1468:b001:l015","ordinal":63387,"en":"Taking a long, difficult road,"},{"id":"manas-2010:p1468:b001:l016","ordinal":63388,"en":"Angled in the haze,"},{"id":"manas-2010:p1468:b001:l017","ordinal":63389,"en":"Pointed in the gloom,"},{"id":"manas-2010:p1468:b001:l018","ordinal":63390,"en":"The spur at the mountain’s end,"},{"id":"manas-2010:p1468:b001:l019","ordinal":63391,"en":"The junction of ninety roads,"},{"id":"manas-2010:p1468:b001:l020","ordinal":63392,"en":"The meeting of nine rivers,"},{"id":"manas-2010:p1468:b001:l021","ordinal":63393,"en":"Echoing Zhar-Kyya,"},{"id":"manas-2010:p1468:b001:l022","ordinal":63394,"en":"Before it a dense forest,"},{"id":"manas-2010:p1468:b001:l023","ordinal":63395,"en":"A single-horse track,"},{"id":"manas-2010:p1468:b001:l024","ordinal":63396,"en":"Along the only road,"},{"id":"manas-2010:p1468:b001:l025","ordinal":63397,"en":"Finding no mountain to assail,"},{"id":"manas-2010:p1468:b001:l026","ordinal":63398,"en":"Finding no enemy to fight,"},{"id":"manas-2010:p1468:b001:l027","ordinal":63399,"en":"Not resting to sleep their fill,"},{"id":"manas-2010:p1468:b001:l028","ordinal":63400,"en":"Not letting their steeds graze,"},{"id":"manas-2010:p1468:b001:l029","ordinal":63401,"en":"Unable to lie upon an elbow,"},{"id":"manas-2010:p1468:b001:l030","ordinal":63402,"en":"Taking not even a moment’s sleep,"},{"id":"manas-2010:p1468:b001:l031","ordinal":63403,"en":"From a broad ravine where no small bird flew,"},{"id":"manas-2010:p1468:b001:l032","ordinal":63404,"en":"From a plain where signal horns sounded,"},{"id":"manas-2010:p1468:b001:l033","ordinal":63405,"en":"Bracing themselves and barring the road,"},{"id":"manas-2010:p1468:b001:l034","ordinal":63406,"en":"The moon dark, the night overcast,"},{"id":"manas-2010:p1468:b001:l035","ordinal":63407,"en":"Three champions emerged from the hills—"},{"id":"manas-2010:p1468:b001:l036","ordinal":63408,"en":"Almambet, Chubak and hero Syrgak."},{"id":"manas-2010:p1468:b001:l037","ordinal":63409,"en":"Through suspicious places, the roads"},{"id":"manas-2010:p1468:b001:l038","ordinal":63410,"en":"They were ranging then."},{"id":"manas-2010:p1468:b001:l039","ordinal":63411,"en":"Suspecting the grim-faced one,"},{"id":"manas-2010:p1468:b001:l040","ordinal":63412,"en":"They were lying in wait for him."},{"id":"manas-2010:p1468:b001:l041","ordinal":63413,"en":"Almambet came out shouting,"},{"id":"manas-2010:p1468:b001:l042","ordinal":63414,"en":"Calling, “Islam!”"},{"id":"manas-2010:p1469:b001:l001","ordinal":63415,"en":"Tall of body, broad of shoulder,"},{"id":"manas-2010:p1469:b001:l002","ordinal":63416,"en":"Who never drew back from a charge,"},{"id":"manas-2010:p1469:b001:l003","ordinal":63417,"en":"Who never fled again from the enemy,"},{"id":"manas-2010:p1469:b001:l004","ordinal":63418,"en":"Came charging behind him,"},{"id":"manas-2010:p1469:b001:l005","ordinal":63419,"en":"Chubak, Khan Baltay’s son."},{"id":"manas-2010:p1469:b001:l006","ordinal":63420,"en":"Flames poured from his eyes;"},{"id":"manas-2010:p1469:b001:l007","ordinal":63421,"en":"Ahead of them all,"},{"id":"manas-2010:p1469:b001:l008","ordinal":63422,"en":"A bowshot apart,"},{"id":"manas-2010:p1469:b001:l009","ordinal":63423,"en":"Not looking all around,"},{"id":"manas-2010:p1469:b001:l010","ordinal":63424,"en":"Not sparing his life at all,"},{"id":"manas-2010:p1469:b001:l011","ordinal":63425,"en":"Syrgak, Ulak Khan’s son,"},{"id":"manas-2010:p1469:b001:l012","ordinal":63426,"en":"Came like an arrow."},{"id":"manas-2010:p1469:b001:l013","ordinal":63427,"en":"At the terror of the three champions,"},{"id":"manas-2010:p1469:b001:l014","ordinal":63428,"en":"The earth split and rumbled."},{"id":"manas-2010:p1469:b001:l015","ordinal":63429,"en":"Like tethered lions,"},{"id":"manas-2010:p1469:b001:l016","ordinal":63430,"en":"Thundering like a storm,"},{"id":"manas-2010:p1469:b001:l017","ordinal":63431,"en":"The forty lords and Kongurbay,"},{"id":"manas-2010:p1469:b001:l018","ordinal":63432,"en":"Unable to bear their heat,"},{"id":"manas-2010:p1469:b001:l019","ordinal":63433,"en":"Fled one by one."},{"id":"manas-2010:p1469:b001:l020","ordinal":63434,"en":"Alöökö’s son Kongurbay"},{"id":"manas-2010:p1469:b001:l021","ordinal":63435,"en":"Truly fled, trembling."},{"id":"manas-2010:p1469:b001:l022","ordinal":63436,"en":"The earth split, dust rose;"},{"id":"manas-2010:p1469:b001:l023","ordinal":63437,"en":"At Almambet, Chubak and Syrgak’s"},{"id":"manas-2010:p1469:b001:l024","ordinal":63438,"en":"Voices, souls fled their bodies."},{"id":"manas-2010:p1469:b001:l025","ordinal":63439,"en":"Splitting into separate groups,"},{"id":"manas-2010:p1469:b001:l026","ordinal":63440,"en":"The forty lords took flight."},{"id":"manas-2010:p1469:b001:l027","ordinal":63441,"en":"From behind them, hero Syrgak"},{"id":"manas-2010:p1469:b001:l028","ordinal":63442,"en":"Separated twenty,"},{"id":"manas-2010:p1469:b001:l029","ordinal":63443,"en":"And drove them before him."},{"id":"manas-2010:p1469:b001:l030","ordinal":63444,"en":"Chubak, Akbaltay’s son,"},{"id":"manas-2010:p1469:b001:l031","ordinal":63445,"en":"Separated ten."},{"id":"manas-2010:p1469:b001:l032","ordinal":63446,"en":"Driving eleven before him,"},{"id":"manas-2010:p1469:b001:l033","ordinal":63447,"en":"With Kongurbay at their head,"},{"id":"manas-2010:p1469:b001:l034","ordinal":63448,"en":"Almambet now pursued them."},{"id":"manas-2010:p1469:b001:l035","ordinal":63449,"en":"Upon the grim-faced wretch, calamity"},{"id":"manas-2010:p1469:b001:l036","ordinal":63450,"en":"Almambet brought as he went,"},{"id":"manas-2010:p1469:b001:l037","ordinal":63451,"en":"Making them crawl wherever he reached,"},{"id":"manas-2010:p1469:b001:l038","ordinal":63452,"en":"Destroying whoever he met,"},{"id":"manas-2010:p1469:b001:l039","ordinal":63453,"en":"Gouging his way onward."},{"id":"manas-2010:p1469:b001:l040","ordinal":63454,"en":"Your Alma had made battle;"},{"id":"manas-2010:p1469:b001:l041","ordinal":63455,"en":"The grim-faced one’s ten lords"},{"id":"manas-2010:p1469:b001:l042","ordinal":63456,"en":"He had slaughtered utterly."},{"id":"manas-2010:p1470:b001:l001","ordinal":63457,"en":"Alöökö’s son Kongurbay,"},{"id":"manas-2010:p1470:b001:l002","ordinal":63458,"en":"Fighting a dog’s fight,"},{"id":"manas-2010:p1470:b001:l003","ordinal":63459,"en":"Turning back again and again,"},{"id":"manas-2010:p1470:b001:l004","ordinal":63460,"en":"Grappled with Almambet."},{"id":"manas-2010:p1470:b001:l005","ordinal":63461,"en":"Syrgak, Ulak Khan’s son,"},{"id":"manas-2010:p1470:b001:l006","ordinal":63462,"en":"Making his spearpoint bloody,"},{"id":"manas-2010:p1470:b001:l007","ordinal":63463,"en":"Making grain of those he met,"},{"id":"manas-2010:p1470:b001:l008","ordinal":63464,"en":"Laying them low, sparing none,"},{"id":"manas-2010:p1470:b001:l009","ordinal":63465,"en":"Shouting, “Alake!”"},{"id":"manas-2010:p1470:b001:l010","ordinal":63466,"en":"Syrgak came pleading."},{"id":"manas-2010:p1470:b001:l011","ordinal":63467,"en":"The fleeing grim-faced one,"},{"id":"manas-2010:p1470:b001:l012","ordinal":63468,"en":"“Stop him!” he shouted."},{"id":"manas-2010:p1470:b001:l013","ordinal":63469,"en":"Bellowing, “Almambet!”"},{"id":"manas-2010:p1470:b001:l014","ordinal":63470,"en":"Having destroyed his ten lords,"},{"id":"manas-2010:p1470:b001:l015","ordinal":63471,"en":"Slaughtered them all, sparing none,"},{"id":"manas-2010:p1470:b001:l016","ordinal":63472,"en":"Hero Chubak came on."},{"id":"manas-2010:p1470:b001:l017","ordinal":63473,"en":"Behind Almambet,"},{"id":"manas-2010:p1470:b001:l018","ordinal":63474,"en":"Shouting with all his life,"},{"id":"manas-2010:p1470:b001:l019","ordinal":63475,"en":"So many curved ridges"},{"id":"manas-2010:p1470:b001:l020","ordinal":63476,"en":"Kongurbay crossed."},{"id":"manas-2010:p1470:b001:l021","ordinal":63477,"en":"Without the strength to grapple,"},{"id":"manas-2010:p1470:b001:l022","ordinal":63478,"en":"Looking neither ahead nor behind,"},{"id":"manas-2010:p1470:b001:l023","ordinal":63479,"en":"Not considering matters of honor,"},{"id":"manas-2010:p1470:b001:l024","ordinal":63480,"en":"Kongurbay took flight."},{"id":"manas-2010:p1470:b001:l025","ordinal":63481,"en":"Pursuing and pursuing, unable to catch him,"},{"id":"manas-2010:p1470:b001:l026","ordinal":63482,"en":"The three champions halted together."},{"id":"manas-2010:p1470:b001:l027","ordinal":63483,"en":"Not letting any of the three catch him,"},{"id":"manas-2010:p1470:b001:l028","ordinal":63484,"en":"Kongurbay went on his way."},{"id":"manas-2010:p1470:b001:l029","ordinal":63485,"en":"Alöökö’s son Kongurbay"},{"id":"manas-2010:p1470:b001:l030","ordinal":63486,"en":"Now sent urgent word."},{"id":"manas-2010:p1470:b001:l031","ordinal":63487,"en":"“I have slain Manas,”"},{"id":"manas-2010:p1470:b001:l032","ordinal":63488,"en":"He sent word to everyone."}]
