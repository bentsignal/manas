[{"id":"manas-2010:p0374:b001:l027","ordinal":17153,"en":"We suffered oppression long ago."},{"id":"manas-2010:p0374:b001:l028","ordinal":17154,"en":"Driven away as a spectacle,"},{"id":"manas-2010:p0374:b001:l029","ordinal":17155,"en":"We came to Altai long ago."},{"id":"manas-2010:p0374:b001:l030","ordinal":17156,"en":"At that time, we forty households"},{"id":"manas-2010:p0374:b001:l031","ordinal":17157,"en":"Were slaughtered and died!"},{"id":"manas-2010:p0374:b001:l032","ordinal":17158,"en":"Against the looming Kalmyks,"},{"id":"manas-2010:p0374:b001:l033","ordinal":17159,"en":"Let me stand and fight."},{"id":"manas-2010:p0374:b001:l034","ordinal":17160,"en":"My support, wolf-man Manas,"},{"id":"manas-2010:p0374:b001:l035","ordinal":17161,"en":"How can I give him to the Kalmyks!"},{"id":"manas-2010:p0374:b001:l036","ordinal":17162,"en":"Dear Baltay, wealthy Jakyp—"},{"id":"manas-2010:p0374:b001:l037","ordinal":17163,"en":"Spending all my countless cattle,"},{"id":"manas-2010:p0374:b001:l038","ordinal":17164,"en":"With Black Chinese and Manchus"},{"id":"manas-2010:p0374:b001:l039","ordinal":17165,"en":"Let me measure my strength!"},{"id":"manas-2010:p0374:b001:l040","ordinal":17166,"en":"They have their lord Esenkan,"},{"id":"manas-2010:p0374:b001:l041","ordinal":17167,"en":"Who has sent so vast a host."},{"id":"manas-2010:p0374:b001:l042","ordinal":17168,"en":"If we look from end to end,"},{"id":"manas-2010:p0374:b001:l043","ordinal":17169,"en":"He means to crush us utterly."},{"id":"manas-2010:p0374:b001:l044","ordinal":17170,"en":"He means to block my road;"},{"id":"manas-2010:p0374:b001:l045","ordinal":17171,"en":"If I fall into his net, this unbeliever"},{"id":"manas-2010:p0374:b001:l046","ordinal":17172,"en":"Means to bind my hands,"},{"id":"manas-2010:p0374:b001:l047","ordinal":17173,"en":"Means to show my eyes"},{"id":"manas-2010:p0374:b001:l048","ordinal":17174,"en":"Wonders no man can bear to see,"},{"id":"manas-2010:p0375:b001:l001","ordinal":17175,"en":"He has meant to dig my pit,"},{"id":"manas-2010:p0375:b001:l002","ordinal":17176,"en":"He has meant to brew my misery;"},{"id":"manas-2010:p0375:b001:l003","ordinal":17177,"en":"He has meant to bind, indeed,"},{"id":"manas-2010:p0375:b001:l004","ordinal":17178,"en":"The cherished jewel upon my brow,"},{"id":"manas-2010:p0375:b001:l005","ordinal":17179,"en":"That wondrous boy Manas."},{"id":"manas-2010:p0375:b001:l006","ordinal":17180,"en":"While Akbaltay still lives,"},{"id":"manas-2010:p0375:b001:l007","ordinal":17181,"en":"How can I give up my Manas?"},{"id":"manas-2010:p0375:b001:l008","ordinal":17182,"en":"This boar has grown mighty—"},{"id":"manas-2010:p0375:b001:l009","ordinal":17183,"en":"Let me clash with him!”"},{"id":"manas-2010:p0375:b001:l010","ordinal":17184,"en":"Saying this, Baltay could not stay still:"},{"id":"manas-2010:p0375:b001:l011","ordinal":17185,"en":"“If I die, there will be great regret;"},{"id":"manas-2010:p0375:b001:l012","ordinal":17186,"en":"Ripping lungs and cutting heads,"},{"id":"manas-2010:p0375:b001:l013","ordinal":17187,"en":"Let me wage a mighty battle!"},{"id":"manas-2010:p0375:b001:l014","ordinal":17188,"en":"My lion Manas, blessed by Kydyr,"},{"id":"manas-2010:p0375:b001:l015","ordinal":17189,"en":"Having seized and given him to the Chinese,"},{"id":"manas-2010:p0375:b001:l016","ordinal":17190,"en":"How could I face the Kyrgyz?"},{"id":"manas-2010:p0375:b001:l017","ordinal":17191,"en":"These Kalmyks are eager for it;"},{"id":"manas-2010:p0375:b001:l018","ordinal":17192,"en":"Let me fight them to the death!"},{"id":"manas-2010:p0375:b001:l019","ordinal":17193,"en":"While my beard is white as a swan,"},{"id":"manas-2010:p0375:b001:l020","ordinal":17194,"en":"While my departure is near,"},{"id":"manas-2010:p0375:b001:l021","ordinal":17195,"en":"With the countless Kalmyk people"},{"id":"manas-2010:p0375:b001:l022","ordinal":17196,"en":"Let me measure my strength!"},{"id":"manas-2010:p0375:b001:l023","ordinal":17197,"en":"For fortunate son Manas,"},{"id":"manas-2010:p0375:b001:l024","ordinal":17198,"en":"Until we are utterly slaughtered,"},{"id":"manas-2010:p0375:b001:l025","ordinal":17199,"en":"Let me keep on smashing them!"},{"id":"manas-2010:p0375:b001:l026","ordinal":17200,"en":"Manas is no ordinary son,"},{"id":"manas-2010:p0375:b001:l027","ordinal":17201,"en":"Putting us out of his mind,"},{"id":"manas-2010:p0375:b001:l028","ordinal":17202,"en":"He is no slave to wander at play!"},{"id":"manas-2010:p0375:b001:l029","ordinal":17203,"en":"Manas is no worthless son,"},{"id":"manas-2010:p0375:b001:l030","ordinal":17204,"en":"Putting us out of his heart,"},{"id":"manas-2010:p0375:b001:l031","ordinal":17205,"en":"He is no slave to wander without care!"},{"id":"manas-2010:p0375:b001:l032","ordinal":17206,"en":"Born greater than other mortals,"},{"id":"manas-2010:p0375:b001:l033","ordinal":17207,"en":"This Manas is no worthless one!"},{"id":"manas-2010:p0375:b001:l034","ordinal":17208,"en":"While that destroyer lives,"},{"id":"manas-2010:p0375:b001:l035","ordinal":17209,"en":"He is no son to forget us!"},{"id":"manas-2010:p0375:b001:l036","ordinal":17210,"en":"If mighty Manas lives,"},{"id":"manas-2010:p0375:b001:l037","ordinal":17211,"en":"He will make my noble head a khan's;"},{"id":"manas-2010:p0375:b001:l038","ordinal":17212,"en":"Of those roaring Kalmyks,"},{"id":"manas-2010:p0375:b001:l039","ordinal":17213,"en":"He will lay twelve thousand low!"},{"id":"manas-2010:p0375:b001:l040","ordinal":17214,"en":"Those haughty Chinese and Manchus,"},{"id":"manas-2010:p0375:b001:l041","ordinal":17215,"en":"How can I submit to their words?"},{"id":"manas-2010:p0375:b001:l042","ordinal":17216,"en":"To those swaggering Chinese and Manchus,"},{"id":"manas-2010:p0375:b001:l043","ordinal":17217,"en":"Without fighting them myself,"},{"id":"manas-2010:p0375:b001:l044","ordinal":17218,"en":"How can I stand and yield?"},{"id":"manas-2010:p0375:b001:l045","ordinal":17219,"en":"While I have strength and power,"},{"id":"manas-2010:p0375:b001:l046","ordinal":17220,"en":"Let me die fighting them!"},{"id":"manas-2010:p0375:b001:l047","ordinal":17221,"en":"Grasping a spear, I shall break the ranks;"},{"id":"manas-2010:p0375:b001:l048","ordinal":17222,"en":"If death comes, I shall fall to a shot!"},{"id":"manas-2010:p0376:b001:l001","ordinal":17223,"en":"What the Maker has written,"},{"id":"manas-2010:p0376:b001:l002","ordinal":17224,"en":"How can I leave without seeing it?"},{"id":"manas-2010:p0376:b001:l003","ordinal":17225,"en":"Against the swarming Black Kalmyks,"},{"id":"manas-2010:p0376:b001:l004","ordinal":17226,"en":"How can I leave without dying!”"},{"id":"manas-2010:p0376:b001:l005","ordinal":17227,"en":"Saying this, Akbaltay,"},{"id":"manas-2010:p0376:b001:l006","ordinal":17228,"en":"Having heard Kutubiy's words,"},{"id":"manas-2010:p0376:b001:l007","ordinal":17229,"en":"The Black Chinese and Manchus—"},{"id":"manas-2010:p0376:b001:l008","ordinal":17230,"en":"Having heard they would surround them,"},{"id":"manas-2010:p0376:b001:l009","ordinal":17231,"en":"Readied spear and sword,"},{"id":"manas-2010:p0376:b001:l010","ordinal":17232,"en":"Fastened his club crosswise,"},{"id":"manas-2010:p0376:b001:l011","ordinal":17233,"en":"Alarmed by the many Chinese,"},{"id":"manas-2010:p0376:b001:l012","ordinal":17234,"en":"He saddled Kulager:"},{"id":"manas-2010:p0376:b001:l013","ordinal":17235,"en":"“His father Jakyp is senseless,"},{"id":"manas-2010:p0376:b001:l014","ordinal":17236,"en":"An ill-intentioned soul,"},{"id":"manas-2010:p0376:b001:l015","ordinal":17237,"en":"A creature the One has made!"},{"id":"manas-2010:p0376:b001:l016","ordinal":17238,"en":"Much livestock, but no sense!"},{"id":"manas-2010:p0376:b001:l017","ordinal":17239,"en":"Your countless cattle that you number—"},{"id":"manas-2010:p0376:b001:l018","ordinal":17240,"en":"Let them be sacrificed for Manas alone!”"},{"id":"manas-2010:p0376:b001:l019","ordinal":17241,"en":"Thus Akbaltay spoke,"},{"id":"manas-2010:p0376:b001:l020","ordinal":17242,"en":"Raging and gathering his force,"},{"id":"manas-2010:p0376:b001:l021","ordinal":17243,"en":"Addressing Khan Jakyp:"},{"id":"manas-2010:p0376:b001:l022","ordinal":17244,"en":"“When your father Karakan died,"},{"id":"manas-2010:p0376:b001:l023","ordinal":17245,"en":"You came an exile to Altai."},{"id":"manas-2010:p0376:b001:l024","ordinal":17246,"en":"Can countless cattle become your child?"},{"id":"manas-2010:p0376:b001:l025","ordinal":17247,"en":"All forty households that move and breathe,"},{"id":"manas-2010:p0376:b001:l026","ordinal":17248,"en":"Let them be sacrificed for Manas alone!"},{"id":"manas-2010:p0376:b001:l027","ordinal":17249,"en":"If you fear the Black Kalmyks,"},{"id":"manas-2010:p0376:b001:l028","ordinal":17250,"en":"Go before them and offer your livestock."},{"id":"manas-2010:p0376:b001:l029","ordinal":17251,"en":"If pleading makes them spare your life,"},{"id":"manas-2010:p0376:b001:l030","ordinal":17252,"en":"Bind your head and offer your blood!"},{"id":"manas-2010:p0376:b001:l031","ordinal":17253,"en":"I shall die rather than remain alive;"},{"id":"manas-2010:p0376:b001:l032","ordinal":17254,"en":"While this dear head is mine,"},{"id":"manas-2010:p0376:b001:l033","ordinal":17255,"en":"I will not give up Khan Manas!”"},{"id":"manas-2010:p0376:b001:l034","ordinal":17256,"en":"Wrathful and making ready,"},{"id":"manas-2010:p0376:b001:l035","ordinal":17257,"en":"Fastening on his weapons,"},{"id":"manas-2010:p0376:b001:l036","ordinal":17258,"en":"Akbaltay sprang forth in fury,"},{"id":"manas-2010:p0376:b001:l037","ordinal":17259,"en":"Against the Black Kalmyks and Manchus"},{"id":"manas-2010:p0376:b001:l038","ordinal":17260,"en":"Preparing to grapple."},{"id":"manas-2010:p0376:b001:l039","ordinal":17261,"en":"“Living on without dying,"},{"id":"manas-2010:p0376:b001:l040","ordinal":17262,"en":"What legacy shall I attain?"},{"id":"manas-2010:p0376:b001:l041","ordinal":17263,"en":"For this boy Manas,"},{"id":"manas-2010:p0376:b001:l042","ordinal":17264,"en":"I shall give myself in sacrifice!”"},{"id":"manas-2010:p0376:b001:l043","ordinal":17265,"en":"Akbaltay said these words:"},{"id":"manas-2010:p0376:b001:l044","ordinal":17266,"en":"“Among the seething Black Kalmyks,"},{"id":"manas-2010:p0376:b001:l045","ordinal":17267,"en":"May I die raising havoc!”"},{"id":"manas-2010:p0376:b001:l046","ordinal":17268,"en":"Thus Akbaltay,"},{"id":"manas-2010:p0376:b001:l047","ordinal":17269,"en":"Without looking around him,"},{"id":"manas-2010:p0376:b001:l048","ordinal":17270,"en":"Without sparing his life at all,"}]
