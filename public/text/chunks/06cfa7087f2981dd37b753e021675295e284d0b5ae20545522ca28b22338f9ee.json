[{"id":"semetey-1-2013:p0583:b003:l031","ordinal":121601,"en":"Abyke, Kobosh—the six villains,"},{"id":"semetey-1-2013:p0583:b003:l032","ordinal":121602,"en":"Those helpless dogs became enemies."},{"id":"semetey-1-2013:p0583:b003:l033","ordinal":121603,"en":"When they ravaged the possessions,"},{"id":"semetey-1-2013:p0583:b003:l034","ordinal":121604,"en":"When they wrought great havoc,"},{"id":"semetey-1-2013:p0583:b003:l035","ordinal":121605,"en":"Burning and smashing the palace,"},{"id":"semetey-1-2013:p0583:b003:l036","ordinal":121606,"en":"Taking the gold and swaggering,"},{"id":"semetey-1-2013:p0583:b003:l037","ordinal":121607,"en":"Abyke, Kobosh—the six villains,"},{"id":"semetey-1-2013:p0583:b003:l038","ordinal":121608,"en":"When they inflicted excessive humiliation,"},{"id":"semetey-1-2013:p0583:b003:l039","ordinal":121609,"en":"Brave Manas's forty nobles,"},{"id":"semetey-1-2013:p0583:b004:l001","ordinal":121610,"en":"When they destroyed the palace,"},{"id":"semetey-1-2013:p0583:b004:l002","ordinal":121611,"en":"Drawing bows to make a rain,"},{"id":"semetey-1-2013:p0583:b004:l003","ordinal":121612,"en":"Shooting missiles worse than hail,"},{"id":"semetey-1-2013:p0583:b004:l004","ordinal":121613,"en":"Disregarding the ancestral spirit,"},{"id":"semetey-1-2013:p0583:b004:l005","ordinal":121614,"en":"Khan Manas's forty nobles"},{"id":"semetey-1-2013:p0583:b004:l006","ordinal":121615,"en":"Moved from Talas amid strife,"},{"id":"semetey-1-2013:p0583:b004:l007","ordinal":121616,"en":"Went and settled in Urbus."},{"id":"semetey-1-2013:p0583:b004:l008","ordinal":121617,"en":"The forty swine made it their support."},{"id":"semetey-1-2013:p0583:b004:l009","ordinal":121618,"en":"After my noble Manas passed away,"},{"id":"semetey-1-2013:p0583:b004:l010","ordinal":121619,"en":"They sided with Abyke,"},{"id":"semetey-1-2013:p0583:b004:l011","ordinal":121620,"en":"Held up Kobosh as their banner."},{"id":"semetey-1-2013:p0583:b004:l012","ordinal":121621,"en":"The forty companions, against Kanykey,"},{"id":"semetey-1-2013:p0583:b004:l013","ordinal":121622,"en":"Raised an uproar no person had seen."},{"id":"semetey-1-2013:p0583:b004:l014","ordinal":121623,"en":"When they devised their wicked scheme,"},{"id":"semetey-1-2013:p0583:b004:l015","ordinal":121624,"en":"My child Kanykey's,"},{"id":"semetey-1-2013:p0583:b004:l016","ordinal":121625,"en":"That woman's, still in mourning,"},{"id":"semetey-1-2013:p0583:b004:l017","ordinal":121626,"en":"Breast they slashed open."},{"id":"semetey-1-2013:p0583:b004:l018","ordinal":121627,"en":"When my heroic lord died,"},{"id":"semetey-1-2013:p0583:b004:l019","ordinal":121628,"en":"When my lady suffered humiliation,"},{"id":"semetey-1-2013:p0583:b004:l020","ordinal":121629,"en":"When they scattered her countless gold,"},{"id":"semetey-1-2013:p0583:b004:l021","ordinal":121630,"en":"‘When a woman's husband dies,"},{"id":"semetey-1-2013:p0583:b004:l022","ordinal":121631,"en":"Her birth family is close,’ she said,"},{"id":"semetey-1-2013:p0583:b004:l023","ordinal":121632,"en":"And fled toward her father, Khan Temir."},{"id":"semetey-1-2013:p0583:b004:l024","ordinal":121633,"en":"Unable to cross Kuyuk Pass,"},{"id":"semetey-1-2013:p0583:b004:l025","ordinal":121634,"en":"Grieving and weeping, unable to walk,"},{"id":"semetey-1-2013:p0583:b004:l026","ordinal":121635,"en":"Unable to cross Jorgo Pass,"},{"id":"semetey-1-2013:p0583:b004:l027","ordinal":121636,"en":"Lamenting and weeping, unable to walk,"},{"id":"semetey-1-2013:p0583:b004:l028","ordinal":121637,"en":"Unable to reach the appointed place,"},{"id":"semetey-1-2013:p0583:b004:l029","ordinal":121638,"en":"Unable to go toward Bukhara,"},{"id":"semetey-1-2013:p0583:b004:l030","ordinal":121639,"en":"Wailing, weeping, crying aloud,"},{"id":"semetey-1-2013:p0583:b004:l031","ordinal":121640,"en":"Unable to cross Chakmak Pass,"},{"id":"semetey-1-2013:p0583:b004:l032","ordinal":121641,"en":"Unable to walk from exhaustion,"},{"id":"semetey-1-2013:p0583:b004:l033","ordinal":121642,"en":"With every step, her strength and vigor gone,"},{"id":"semetey-1-2013:p0583:b004:l034","ordinal":121643,"en":"Blood ran a saddle-strap's length from her calves."},{"id":"semetey-1-2013:p0583:b004:l035","ordinal":121644,"en":"Her soles were all gouged open;"},{"id":"semetey-1-2013:p0583:b004:l036","ordinal":121645,"en":"The flesh of her heels was flayed;"},{"id":"semetey-1-2013:p0583:b004:l037","ordinal":121646,"en":"Her soft soles were torn to pieces;"},{"id":"semetey-1-2013:p0583:b004:l038","ordinal":121647,"en":"Every bone in her body ached."},{"id":"semetey-1-2013:p0583:b004:l039","ordinal":121648,"en":"Upon her was her long-awaited Semetey,"},{"id":"semetey-1-2013:p0584:b003:l001","ordinal":121649,"en":"Crying aloud with hunger,"},{"id":"semetey-1-2013:p0584:b003:l002","ordinal":121650,"en":"I, Bakay, caught up with them,"},{"id":"semetey-1-2013:p0584:b003:l003","ordinal":121651,"en":"Gave two swift horses,"},{"id":"semetey-1-2013:p0584:b003:l004","ordinal":121652,"en":"Gave two skins of milk."},{"id":"semetey-1-2013:p0584:b003:l005","ordinal":121653,"en":"My two-year-old wether, slaughtered for provisions then—"},{"id":"semetey-1-2013:p0584:b003:l006","ordinal":121654,"en":"I keep thinking he will not forget"},{"id":"semetey-1-2013:p0584:b003:l007","ordinal":121655,"en":"What I did at that time."},{"id":"semetey-1-2013:p0584:b003:l008","ordinal":121656,"en":"Hiding myself in Keng-Kol,"},{"id":"semetey-1-2013:p0584:b003:l009","ordinal":121657,"en":"The imposing, dear soul,"},{"id":"semetey-1-2013:p0584:b003:l010","ordinal":121658,"en":"The orphan left by Manas,"},{"id":"semetey-1-2013:p0584:b003:l011","ordinal":121659,"en":"Thus I sent him fleeing,"},{"id":"semetey-1-2013:p0584:b003:l012","ordinal":121660,"en":"Helped them cross Jorgo Pass,"},{"id":"semetey-1-2013:p0584:b003:l013","ordinal":121661,"en":"Sorrow-stricken Kanykey,"},{"id":"semetey-1-2013:p0584:b003:l014","ordinal":121662,"en":"Sent her fleeing from this Talas."},{"id":"semetey-1-2013:p0584:b003:l015","ordinal":121663,"en":"Helped her cross Kuyuk Pass,"},{"id":"semetey-1-2013:p0584:b003:l016","ordinal":121664,"en":"That fierce Kanykey,"},{"id":"semetey-1-2013:p0584:b003:l017","ordinal":121665,"en":"Sent her fleeing from this Talas."},{"id":"semetey-1-2013:p0584:b003:l018","ordinal":121666,"en":"Kanykey departed in mourning;"},{"id":"semetey-1-2013:p0584:b003:l019","ordinal":121667,"en":"When he was a nursing infant,"},{"id":"semetey-1-2013:p0584:b003:l020","ordinal":121668,"en":"Semetey fled to Bukhara."},{"id":"semetey-1-2013:p0584:b003:l021","ordinal":121669,"en":"He prospered by plundering his valuables."},{"id":"semetey-1-2013:p0584:b003:l022","ordinal":121670,"en":"This year, the courser's son Semetey"},{"id":"semetey-1-2013:p0584:b003:l023","ordinal":121671,"en":"Is twelve; he has grown up."},{"id":"semetey-1-2013:p0584:b003:l024","ordinal":121672,"en":"Have you come from the direction of Bukhara?"},{"id":"semetey-1-2013:p0584:b003:l025","ordinal":121673,"en":"Ah, my child, have you heard news from Bukhara?"},{"id":"semetey-1-2013:p0584:b003:l027","ordinal":121674,"en":"I grieve, thinking of Manas."},{"id":"semetey-1-2013:p0584:b003:l028","ordinal":121675,"en":"The long-awaited Semetey,"},{"id":"semetey-1-2013:p0584:b003:l029","ordinal":121676,"en":"‘Will he turn out like him?’ I wonder,"},{"id":"semetey-1-2013:p0584:b003:l030","ordinal":121677,"en":"And I grieve for the boy."},{"id":"semetey-1-2013:p0584:b003:l031","ordinal":121678,"en":"The stars in heaven were dim,"},{"id":"semetey-1-2013:p0584:b003:l032","ordinal":121679,"en":"With Manas, I, a sorrowful soul,"},{"id":"semetey-1-2013:p0584:b003:l033","ordinal":121680,"en":"Was a friend unto Judgment."},{"id":"semetey-1-2013:p0584:b003:l034","ordinal":121681,"en":"I grieve, thinking of Manas."},{"id":"semetey-1-2013:p0584:b003:l035","ordinal":121682,"en":"Manas, gone to the other world,"},{"id":"semetey-1-2013:p0584:b003:l036","ordinal":121683,"en":"Honoring his spirit, a poor soul,"},{"id":"semetey-1-2013:p0584:b003:l037","ordinal":121684,"en":"I go on herding camels."},{"id":"semetey-1-2013:p0584:b003:l038","ordinal":121685,"en":"Shall I die herding camels?"},{"id":"semetey-1-2013:p0584:b003:l039","ordinal":121686,"en":"Shall I see the face of Judgment?"},{"id":"semetey-1-2013:p0584:b004:l001","ordinal":121687,"en":"My sorrow within scattered,"},{"id":"semetey-1-2013:p0584:b004:l002","ordinal":121688,"en":"My brow opening brightly,"},{"id":"semetey-1-2013:p0584:b004:l003","ordinal":121689,"en":"Shall I see Semetey's face?"},{"id":"semetey-1-2013:p0584:b004:l004","ordinal":121690,"en":"Wait a moment, my foal."},{"id":"semetey-1-2013:p0584:b004:l005","ordinal":121691,"en":"Now let me count the days,"},{"id":"semetey-1-2013:p0584:b004:l006","ordinal":121692,"en":"Let me put the days in writing."},{"id":"semetey-1-2013:p0584:b004:l007","ordinal":121693,"en":"Let me count the years,"},{"id":"semetey-1-2013:p0584:b004:l008","ordinal":121694,"en":"Now let me put the years in writing:"},{"id":"semetey-1-2013:p0584:b004:l009","ordinal":121695,"en":"There was the Mouse, there was the Cow,"},{"id":"semetey-1-2013:p0584:b004:l010","ordinal":121696,"en":"There was the Horse, and the Tiger,"},{"id":"semetey-1-2013:p0584:b004:l011","ordinal":121697,"en":"There was the Hare, the Snake,"},{"id":"semetey-1-2013:p0584:b004:l012","ordinal":121698,"en":"There was the Hen, the Dragon,"},{"id":"semetey-1-2013:p0584:b004:l013","ordinal":121699,"en":"There was the Monkey, and the Sheep,"},{"id":"semetey-1-2013:p0584:b004:l014","ordinal":121700,"en":"There was the Pig, there was the Dog."},{"id":"semetey-1-2013:p0584:b004:l015","ordinal":121701,"en":"This year is the time he turns twelve."},{"id":"semetey-1-2013:p0584:b004:l016","ordinal":121702,"en":"My foal left by the Magnanimous,"},{"id":"semetey-1-2013:p0584:b004:l017","ordinal":121703,"en":"If Semetey is still alive,"},{"id":"semetey-1-2013:p0584:b004:l018","ordinal":121704,"en":"This year is the time he turns twelve."},{"id":"semetey-1-2013:p0584:b004:l019","ordinal":121705,"en":"Bereaved Kanykey said:"},{"id":"semetey-1-2013:p0584:b004:l020","ordinal":121706,"en":"‘Put aside your sorrow and tend your camels,"},{"id":"semetey-1-2013:p0584:b004:l021","ordinal":121707,"en":"Leopard elder, Khan Bakay."},{"id":"semetey-1-2013:p0584:b004:l022","ordinal":121708,"en":"The orphan left by the hero,"},{"id":"semetey-1-2013:p0584:b004:l023","ordinal":121709,"en":"When he reaches twelve years of age,"},{"id":"semetey-1-2013:p0584:b004:l024","ordinal":121710,"en":"To this very Talas"},{"id":"semetey-1-2013:p0584:b004:l025","ordinal":121711,"en":"I will bring him,’ she said."},{"id":"semetey-1-2013:p0584:b004:l026","ordinal":121712,"en":"When fortune turns again for this head of mine,"},{"id":"semetey-1-2013:p0584:b004:l027","ordinal":121713,"en":"Is there a night like the Night of Power?"},{"id":"semetey-1-2013:p0584:b004:l028","ordinal":121714,"en":"For this head of mine in old age,"},{"id":"semetey-1-2013:p0584:b004:l029","ordinal":121715,"en":"Is there a day when Semetey will come?"},{"id":"semetey-1-2013:p0584:b004:l030","ordinal":121716,"en":"My honor recovered this year,"},{"id":"semetey-1-2013:p0584:b004:l031","ordinal":121717,"en":"My exposed places covered,"},{"id":"semetey-1-2013:p0584:b004:l032","ordinal":121718,"en":"All my grief scattered,"},{"id":"semetey-1-2013:p0584:b004:l033","ordinal":121719,"en":"My brow opening like the dawn,"},{"id":"semetey-1-2013:p0584:b004:l034","ordinal":121720,"en":"Is there a day when Semetey will come?"},{"id":"semetey-1-2013:p0584:b004:l035","ordinal":121721,"en":"My child, have you come from the direction of Bukhara?"},{"id":"semetey-1-2013:p0584:b004:l037","ordinal":121722,"en":"My child, have you heard news from Bukhara?"},{"id":"semetey-1-2013:p0584:b004:l039","ordinal":121723,"en":"If you tell me good news,"},{"id":"semetey-1-2013:p0585:b003:l001","ordinal":121724,"en":"I shall agree to what you say."},{"id":"semetey-1-2013:p0585:b003:l002","ordinal":121725,"en":"The orphan has seven hundred camels;"},{"id":"semetey-1-2013:p0585:b003:l003","ordinal":121726,"en":"I shall give them as a reward for news of my boy.”"},{"id":"semetey-1-2013:p0585:b003:l004","ordinal":121727,"en":"Thus spoke Bakay Khan,"},{"id":"semetey-1-2013:p0585:b003:l005","ordinal":121728,"en":"As he asked about Semetey."},{"id":"semetey-1-2013:p0585:b003:l006","ordinal":121729,"en":"Then the boy thought:"},{"id":"semetey-1-2013:p0585:b003:l007","ordinal":121730,"en":"“Let me test what Bakay has in mind;"},{"id":"semetey-1-2013:p0585:b003:l008","ordinal":121731,"en":"Let me tell him of his boy Semetey.”"},{"id":"semetey-1-2013:p0585:b003:l009","ordinal":121732,"en":"Thinking this, Semetey said:"},{"id":"semetey-1-2013:p0585:b003:l010","ordinal":121733,"en":"“Brother-in-law, I came from Bukhara."},{"id":"semetey-1-2013:p0585:b003:l012","ordinal":121734,"en":"More than merely coming from there,"},{"id":"semetey-1-2013:p0585:b003:l013","ordinal":121735,"en":"I heard the news seething within it."},{"id":"semetey-1-2013:p0585:b003:l014","ordinal":121736,"en":"Manas's son Semetey—"},{"id":"semetey-1-2013:p0585:b003:l015","ordinal":121737,"en":"When Kanykey fled there before,"},{"id":"semetey-1-2013:p0585:b003:l016","ordinal":121738,"en":"The orphan, Manas's son,"},{"id":"semetey-1-2013:p0585:b003:l017","ordinal":121739,"en":"Had an amulet hung about his neck."},{"id":"semetey-1-2013:p0585:b003:l018","ordinal":121740,"en":"He was called Ysmayyl's son"},{"id":"semetey-1-2013:p0585:b003:l019","ordinal":121741,"en":"And brought up by his maternal uncle."},{"id":"semetey-1-2013:p0585:b003:l020","ordinal":121742,"en":"His twig was cut,"},{"id":"semetey-1-2013:p0585:b003:l021","ordinal":121743,"en":"His rites were performed."},{"id":"semetey-1-2013:p0585:b003:l022","ordinal":121744,"en":"He was made to step over a dog's bowl"},{"id":"semetey-1-2013:p0585:b003:l023","ordinal":121745,"en":"And across the edge of a sword."},{"id":"semetey-1-2013:p0585:b003:l024","ordinal":121746,"en":"Kanykey entered Bukhara"},{"id":"semetey-1-2013:p0585:b003:l025","ordinal":121747,"en":"And, together with herself, gave her child"},{"id":"semetey-1-2013:p0585:b003:l026","ordinal":121748,"en":"To Ysmayyl."},{"id":"semetey-1-2013:p0585:b003:l027","ordinal":121749,"en":"This year your boy Semetey"},{"id":"semetey-1-2013:p0585:b003:l028","ordinal":121750,"en":"Proved a glowing ember."},{"id":"semetey-1-2013:p0585:b003:l029","ordinal":121751,"en":"In the mighty city of Bukhara"},{"id":"semetey-1-2013:p0585:b003:l030","ordinal":121752,"en":"There was no other such troublemaker."},{"id":"semetey-1-2013:p0585:b003:l031","ordinal":121753,"en":"He imprisoned the wandering dervishes"},{"id":"semetey-1-2013:p0585:b003:l032","ordinal":121754,"en":"And beat the mendicants."},{"id":"semetey-1-2013:p0585:b003:l033","ordinal":121755,"en":"The white-turbaned religious masters"},{"id":"semetey-1-2013:p0585:b003:l034","ordinal":121756,"en":"And the mullahs studying their lessons—"},{"id":"semetey-1-2013:p0585:b003:l035","ordinal":121757,"en":"He thrashed them all"},{"id":"semetey-1-2013:p0585:b003:l036","ordinal":121758,"en":"And locked them in their mosque."},{"id":"semetey-1-2013:p0585:b003:l037","ordinal":121759,"en":"When they saw all his mischief,"},{"id":"semetey-1-2013:p0585:b003:l038","ordinal":121760,"en":"All the people of Bukhara grew weary."},{"id":"semetey-1-2013:p0585:b003:l039","ordinal":121761,"en":"He proved a glowing ember."},{"id":"semetey-1-2013:p0585:b005:l001","ordinal":121762,"en":"In the mighty city of Bukhara"},{"id":"semetey-1-2013:p0585:b005:l002","ordinal":121763,"en":"There was no other such troublemaker."},{"id":"semetey-1-2013:p0585:b005:l003","ordinal":121764,"en":"His religious masters were beaten;"},{"id":"semetey-1-2013:p0585:b005:l004","ordinal":121765,"en":"They stabbed the footprints he left"},{"id":"semetey-1-2013:p0585:b005:l005","ordinal":121766,"en":"And slandered your only son Semetey."},{"id":"semetey-1-2013:p0585:b005:l006","ordinal":121767,"en":"Temir Khan, the khan of Bukhara,"},{"id":"semetey-1-2013:p0585:b005:l007","ordinal":121768,"en":"Was deeply troubled"},{"id":"semetey-1-2013:p0585:b005:l008","ordinal":121769,"en":"And shed tears."},{"id":"semetey-1-2013:p0585:b005:l009","ordinal":121770,"en":"‘If this boy hears who his father was,"},{"id":"semetey-1-2013:p0585:b005:l010","ordinal":121771,"en":"Will he slaughter my village?"},{"id":"semetey-1-2013:p0585:b005:l011","ordinal":121772,"en":"There is no sieve over the people's mouths;"},{"id":"semetey-1-2013:p0585:b005:l012","ordinal":121773,"en":"Some witless dog"},{"id":"semetey-1-2013:p0585:b005:l013","ordinal":121774,"en":"May tell him."},{"id":"semetey-1-2013:p0585:b005:l014","ordinal":121775,"en":"When my orphan grows angry,"},{"id":"semetey-1-2013:p0585:b005:l015","ordinal":121776,"en":"Saying, “You knew I had wandered away;"},{"id":"semetey-1-2013:p0585:b005:l016","ordinal":121777,"en":"You kept my lineage hidden,”"},{"id":"semetey-1-2013:p0585:b005:l017","ordinal":121778,"en":"He will plunder my valuables"},{"id":"semetey-1-2013:p0585:b005:l018","ordinal":121779,"en":"And unleash destruction everywhere."},{"id":"semetey-1-2013:p0585:b005:l019","ordinal":121780,"en":"He will smash my stone-built bazaar,"},{"id":"semetey-1-2013:p0585:b005:l020","ordinal":121781,"en":"Slaughter everyone, and take my people"},{"id":"semetey-1-2013:p0585:b005:l021","ordinal":121782,"en":"Driving them away to Talas."},{"id":"semetey-1-2013:p0585:b005:l022","ordinal":121783,"en":"He will destroy my possessions"},{"id":"semetey-1-2013:p0585:b005:l023","ordinal":121784,"en":"And finish me off completely.’"},{"id":"semetey-1-2013:p0585:b005:l024","ordinal":121785,"en":"Fearing the outcome, Temir Khan"},{"id":"semetey-1-2013:p0585:b005:l025","ordinal":121786,"en":"Opened the treasury."},{"id":"semetey-1-2013:p0585:b005:l026","ordinal":121787,"en":"Countless treasures and much gold"},{"id":"semetey-1-2013:p0585:b005:l027","ordinal":121788,"en":"He scattered, spending them on the people."},{"id":"semetey-1-2013:p0585:b005:l028","ordinal":121789,"en":"He did not simply stand and watch."},{"id":"semetey-1-2013:p0585:b005:l029","ordinal":121790,"en":"When he saw the boy's wrath,"},{"id":"semetey-1-2013:p0585:b005:l030","ordinal":121791,"en":"He gathered the peoples of eight khans."},{"id":"semetey-1-2013:p0585:b005:l031","ordinal":121792,"en":"Holding horse races and a feast,"},{"id":"semetey-1-2013:p0585:b005:l032","ordinal":121793,"en":"He assembled the people of the world."},{"id":"semetey-1-2013:p0585:b005:l033","ordinal":121794,"en":"When the peoples of eight khans had come,"},{"id":"semetey-1-2013:p0585:b005:l034","ordinal":121795,"en":"To those who knew his origins,"},{"id":"semetey-1-2013:p0585:b005:l035","ordinal":121796,"en":"He said, ‘Khan Manas's memorial feast’;"},{"id":"semetey-1-2013:p0585:b005:l036","ordinal":121797,"en":"To those who knew nothing,"},{"id":"semetey-1-2013:p0585:b005:l037","ordinal":121798,"en":"He said, ‘Semetey's celebration.’"},{"id":"semetey-1-2013:p0585:b005:l038","ordinal":121799,"en":"Dust rose amid the turmoil;"},{"id":"semetey-1-2013:p0585:b005:l039","ordinal":121800,"en":"The ground was filled with teeming people."},{"id":"semetey-1-2013:p0586:b003:l001","ordinal":121801,"en":"Many a mighty warrior came;"},{"id":"semetey-1-2013:p0586:b003:l002","ordinal":121802,"en":"Many a mighty lion came."},{"id":"semetey-1-2013:p0586:b003:l003","ordinal":121803,"en":"The horse trainers grew excited."},{"id":"semetey-1-2013:p0586:b003:l004","ordinal":121804,"en":"The mourning woman Kanykey,"},{"id":"semetey-1-2013:p0586:b003:l005","ordinal":121805,"en":"Poor soul, took it as an omen:"},{"id":"semetey-1-2013:p0586:b003:l006","ordinal":121806,"en":"‘If Taytoru comes in first,"},{"id":"semetey-1-2013:p0586:b003:l007","ordinal":121807,"en":"I shall return and see the Kyrgyz;"},{"id":"semetey-1-2013:p0586:b003:l008","ordinal":121808,"en":"If Taytoru does not win,"},{"id":"semetey-1-2013:p0586:b003:l009","ordinal":121809,"en":"Today I shall die before my appointed time.’"},{"id":"semetey-1-2013:p0586:b003:l010","ordinal":121810,"en":"Kanykey, built like a warrior,"},{"id":"semetey-1-2013:p0586:b003:l011","ordinal":121811,"en":"Took her lovely, long, thick braid"},{"id":"semetey-1-2013:p0586:b003:l012","ordinal":121812,"en":"And bound it tightly atop her head."},{"id":"semetey-1-2013:p0586:b003:l013","ordinal":121813,"en":"The poor soul, fierce and passionate,"},{"id":"semetey-1-2013:p0586:b003:l014","ordinal":121814,"en":"Put on a man's clothes."},{"id":"semetey-1-2013:p0586:b003:l015","ordinal":121815,"en":"Concealing that she was a woman,"},{"id":"semetey-1-2013:p0586:b003:l016","ordinal":121816,"en":"Taking a shortcut by Ichke-Zhol,"},{"id":"semetey-1-2013:p0586:b003:l017","ordinal":121817,"en":"Leading Taytoru,"},{"id":"semetey-1-2013:p0586:b003:l018","ordinal":121818,"en":"She brought him into Bukhara."},{"id":"semetey-1-2013:p0586:b003:l019","ordinal":121819,"en":"When she entered Bukhara"},{"id":"semetey-1-2013:p0586:b003:l020","ordinal":121820,"en":"With sixty-year-old Taytoru,"},{"id":"semetey-1-2013:p0586:b003:l021","ordinal":121821,"en":"The people of Bukhara crowded around."},{"id":"semetey-1-2013:p0586:b003:l022","ordinal":121822,"en":"All the peoples of eight khans"},{"id":"semetey-1-2013:p0586:b003:l023","ordinal":121823,"en":"Marvelled at bereaved Kanykey."},{"id":"semetey-1-2013:p0586:b003:l024","ordinal":121824,"en":"They clamoured their greetings,"},{"id":"semetey-1-2013:p0586:b003:l025","ordinal":121825,"en":"Parting sharply into two throngs."},{"id":"semetey-1-2013:p0586:b003:l026","ordinal":121826,"en":"Thus she gained honour."},{"id":"semetey-1-2013:p0586:b003:l027","ordinal":121827,"en":"Kanykey, seeking an omen,"},{"id":"semetey-1-2013:p0586:b003:l028","ordinal":121828,"en":"Entered Taytoru in the race."},{"id":"semetey-1-2013:p0586:b003:l029","ordinal":121829,"en":"There were six hundred and forty-three horses"},{"id":"semetey-1-2013:p0586:b003:l030","ordinal":121830,"en":"From the peoples of eight khans."},{"id":"semetey-1-2013:p0586:b003:l031","ordinal":121831,"en":"God granted her wish:"},{"id":"semetey-1-2013:p0586:b003:l032","ordinal":121832,"en":"Outstripping all six hundred,"},{"id":"semetey-1-2013:p0586:b003:l033","ordinal":121833,"en":"Taytoru came galloping in."},{"id":"semetey-1-2013:p0586:b003:l034","ordinal":121834,"en":"Manas's son Semetey,"},{"id":"semetey-1-2013:p0586:b003:l035","ordinal":121835,"en":"Not yet knowing about his father,"},{"id":"semetey-1-2013:p0586:b003:l036","ordinal":121836,"en":"Raised the battle cry, ‘Manas!’"},{"id":"semetey-1-2013:p0586:b003:l037","ordinal":121837,"en":"A courser such as Taytoru"},{"id":"semetey-1-2013:p0586:b003:l038","ordinal":121838,"en":"He spurred on with cries of ‘Manas!’"},{"id":"semetey-1-2013:p0586:b003:l039","ordinal":121839,"en":"When the boy called out, ‘Manas!’"},{"id":"semetey-1-2013:p0586:b004:l001","ordinal":121840,"en":"Manas, whose spirit is sacred—"},{"id":"semetey-1-2013:p0586:b004:l002","ordinal":121841,"en":"‘This boy was born greater,’ they said."},{"id":"semetey-1-2013:p0586:b004:l003","ordinal":121842,"en":"The birches wept; the willows wept."},{"id":"semetey-1-2013:p0586:b004:l004","ordinal":121843,"en":"Everyone who looked at the boy wept."},{"id":"semetey-1-2013:p0586:b004:l006","ordinal":121844,"en":"The champion blessed with victory wept."},{"id":"semetey-1-2013:p0586:b004:l007","ordinal":121845,"en":"When the boy called out, ‘Manas!’"},{"id":"semetey-1-2013:p0586:b004:l008","ordinal":121846,"en":"The peoples of eight khans all wept."},{"id":"semetey-1-2013:p0586:b004:l009","ordinal":121847,"en":"Even the hard-hearted warrior wept."},{"id":"semetey-1-2013:p0586:b004:l010","ordinal":121848,"en":"All those who wept"},{"id":"semetey-1-2013:p0586:b004:l011","ordinal":121849,"en":"Wept, consumed by their own grief."},{"id":"semetey-1-2013:p0586:b004:l012","ordinal":121850,"en":"‘A male child, poor orphan—"},{"id":"semetey-1-2013:p0586:b004:l013","ordinal":121851,"en":"If a man leaves one descendant behind,"},{"id":"semetey-1-2013:p0586:b004:l014","ordinal":121852,"en":"The decree God has laid down,"},{"id":"semetey-1-2013:p0586:b004:l015","ordinal":121853,"en":"The dear soul need never experience."},{"id":"semetey-1-2013:p0586:b004:l017","ordinal":121854,"en":"If a valiant young man"},{"id":"semetey-1-2013:p0586:b004:l018","ordinal":121855,"en":"Leaves one descendant behind,"},{"id":"semetey-1-2013:p0586:b004:l019","ordinal":121856,"en":"With people saying, “That man's son,”"}]
