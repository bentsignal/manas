[{"id":"semetey-1-2013:p1249:b008:l029","ordinal":171521,"en":"“Our venture rests with Almighty God.”"},{"id":"semetey-1-2013:p1250:b003:l001","ordinal":171522,"en":"Their marksmen were at the front;"},{"id":"semetey-1-2013:p1250:b003:l002","ordinal":171523,"en":"Their heroes were at the flanks."},{"id":"semetey-1-2013:p1250:b003:l003","ordinal":171524,"en":"Their hardy men were at the front;"},{"id":"semetey-1-2013:p1250:b003:l004","ordinal":171525,"en":"Their tigers were at the flanks."},{"id":"semetey-1-2013:p1250:b003:l005","ordinal":171526,"en":"Their spearmen were at the front;"},{"id":"semetey-1-2013:p1250:b003:l006","ordinal":171527,"en":"Their lions were at the flanks."},{"id":"semetey-1-2013:p1250:b003:l007","ordinal":171528,"en":"Without twitching the horses' mouths,"},{"id":"semetey-1-2013:p1250:b003:l008","ordinal":171529,"en":"Many here wheeled their mounts."},{"id":"semetey-1-2013:p1250:b003:l009","ordinal":171530,"en":"Holding spears and fitting banner tips,"},{"id":"semetey-1-2013:p1250:b003:l010","ordinal":171531,"en":"Many here stood ready."},{"id":"semetey-1-2013:p1250:b003:l011","ordinal":171532,"en":"Steeping themselves in bloody blood,"},{"id":"semetey-1-2013:p1250:b003:l012","ordinal":171533,"en":"Fighting without fleeing,"},{"id":"semetey-1-2013:p1250:b003:l013","ordinal":171534,"en":"Many here were warriors."},{"id":"semetey-1-2013:p1250:b003:l014","ordinal":171535,"en":"Streaming along the riverbank,"},{"id":"semetey-1-2013:p1250:b003:l015","ordinal":171536,"en":"Surging across the ground,"},{"id":"semetey-1-2013:p1250:b003:l016","ordinal":171537,"en":"They were told, “All advance abreast;"},{"id":"semetey-1-2013:p1250:b003:l017","ordinal":171538,"en":"Ride with room and do not collide.”"},{"id":"semetey-1-2013:p1250:b003:l018","ordinal":171539,"en":"Spearheads clashed;"},{"id":"semetey-1-2013:p1250:b003:l019","ordinal":171540,"en":"Men's heads knocked together."},{"id":"semetey-1-2013:p1250:b003:l020","ordinal":171541,"en":"Commanders of ten swept forward;"},{"id":"semetey-1-2013:p1250:b003:l021","ordinal":171542,"en":"Commanders of a hundred towered."},{"id":"semetey-1-2013:p1250:b003:l022","ordinal":171543,"en":"Their ancient fury stirred;"},{"id":"semetey-1-2013:p1250:b003:l023","ordinal":171544,"en":"They became an army of many thousands."},{"id":"semetey-1-2013:p1250:b003:l024","ordinal":171545,"en":"They had horns and trumpets sounded,"},{"id":"semetey-1-2013:p1250:b003:l025","ordinal":171546,"en":"Loaded troops upon rhinoceroses,"},{"id":"semetey-1-2013:p1250:b003:l026","ordinal":171547,"en":"Loaded ammunition on elephants,"},{"id":"semetey-1-2013:p1250:b003:l027","ordinal":171548,"en":"And gathered all the Jediger people"},{"id":"semetey-1-2013:p1250:b003:l028","ordinal":171549,"en":"To carry out merciless slaughter"},{"id":"semetey-1-2013:p1250:b003:l029","ordinal":171550,"en":"And seize Aychürök."},{"id":"semetey-1-2013:p1250:b003:l030","ordinal":171551,"en":"They went to exact, bit by bit,"},{"id":"semetey-1-2013:p1250:b003:l031","ordinal":171552,"en":"The vengeance of wounded Toltoy."},{"id":"semetey-1-2013:p1250:b003:l032","ordinal":171553,"en":"The drum's voice thundered;"},{"id":"semetey-1-2013:p1250:b003:l033","ordinal":171554,"en":"The brass horn's voice rang."},{"id":"semetey-1-2013:p1250:b003:l034","ordinal":171555,"en":"The gray-mottled pennant became their banner;"},{"id":"semetey-1-2013:p1250:b003:l035","ordinal":171556,"en":"A wailing clamor arose."},{"id":"semetey-1-2013:p1250:b003:l036","ordinal":171557,"en":"The white-mottled pennant became their banner;"},{"id":"semetey-1-2013:p1250:b003:l037","ordinal":171558,"en":"The air filled with battle cries and clamor."},{"id":"semetey-1-2013:p1250:b003:l038","ordinal":171559,"en":"Toltoy of the Jediger,"},{"id":"semetey-1-2013:p1250:b003:l039","ordinal":171560,"en":"His countless army bending the earth—"},{"id":"semetey-1-2013:p1250:b004:l001","ordinal":171561,"en":"His spearmen were at the front;"},{"id":"semetey-1-2013:p1250:b004:l002","ordinal":171562,"en":"The lion Toltoy was at the flank."},{"id":"semetey-1-2013:p1250:b004:l003","ordinal":171563,"en":"He was driving them forth;"},{"id":"semetey-1-2013:p1250:b004:l004","ordinal":171564,"en":"Swarming like ants,"},{"id":"semetey-1-2013:p1250:b004:l005","ordinal":171565,"en":"They came seething out."},{"id":"semetey-1-2013:p1250:b004:l006","ordinal":171566,"en":"It was impossible to tell if they were worms,"},{"id":"semetey-1-2013:p1250:b004:l007","ordinal":171567,"en":"Impossible to tell if they were people;"},{"id":"semetey-1-2013:p1250:b004:l008","ordinal":171568,"en":"They came seething out."},{"id":"semetey-1-2013:p1250:b004:l009","ordinal":171569,"en":"Their heroes were at the front;"},{"id":"semetey-1-2013:p1250:b004:l010","ordinal":171570,"en":"Renowned Kozho was at the flank."},{"id":"semetey-1-2013:p1250:b004:l011","ordinal":171571,"en":"Tölök and Tölöbay"},{"id":"semetey-1-2013:p1250:b004:l012","ordinal":171572,"en":"Were behind the lower army."},{"id":"semetey-1-2013:p1250:b004:l013","ordinal":171573,"en":"Kalcha and Kadyrbay"},{"id":"semetey-1-2013:p1250:b004:l014","ordinal":171574,"en":"Were at the army's qibla-side flank."},{"id":"semetey-1-2013:p1250:b004:l015","ordinal":171575,"en":"Wearing a black supa coat,"},{"id":"semetey-1-2013:p1250:b004:l016","ordinal":171576,"en":"Riding a black noble horse,"},{"id":"semetey-1-2013:p1250:b004:l017","ordinal":171577,"en":"Dear Kozho was at the flank."},{"id":"semetey-1-2013:p1250:b004:l018","ordinal":171578,"en":"Along the bank road of Kum-Kyya,"},{"id":"semetey-1-2013:p1250:b004:l019","ordinal":171579,"en":"They came forth in splendor;"},{"id":"semetey-1-2013:p1250:b004:l020","ordinal":171580,"en":"Behind raging Kozho,"},{"id":"semetey-1-2013:p1250:b004:l021","ordinal":171581,"en":"He drove them onward."},{"id":"semetey-1-2013:p1250:b004:l022","ordinal":171582,"en":"From beside Tash-Kyya,"},{"id":"semetey-1-2013:p1250:b004:l023","ordinal":171583,"en":"Most of them came forth;"},{"id":"semetey-1-2013:p1250:b004:l024","ordinal":171584,"en":"Along the bank road of Kum-Kyya,"},{"id":"semetey-1-2013:p1250:b004:l025","ordinal":171585,"en":"Half of them came forth."},{"id":"semetey-1-2013:p1250:b004:l026","ordinal":171586,"en":"Their great banner floated;"},{"id":"semetey-1-2013:p1250:b004:l027","ordinal":171587,"en":"The brass horn's voice clattered."},{"id":"semetey-1-2013:p1250:b004:l028","ordinal":171588,"en":"Sword points swayed;"},{"id":"semetey-1-2013:p1250:b004:l029","ordinal":171589,"en":"Spear tips flashed."},{"id":"semetey-1-2013:p1250:b004:l030","ordinal":171590,"en":"Their drums boomed."},{"id":"semetey-1-2013:p1250:b004:l031","ordinal":171591,"en":"Shouting to the great host, “Advance!”"},{"id":"semetey-1-2013:p1250:b004:l032","ordinal":171592,"en":"Hero Toltoy thundered."},{"id":"semetey-1-2013:p1250:b004:l033","ordinal":171593,"en":"Gun barrels appeared,"},{"id":"semetey-1-2013:p1250:b004:l034","ordinal":171594,"en":"Men's minds were shaken;"},{"id":"semetey-1-2013:p1250:b004:l035","ordinal":171595,"en":"As though gone mad, the Jediger"},{"id":"semetey-1-2013:p1250:b004:l036","ordinal":171596,"en":"Came forth clamoring."},{"id":"semetey-1-2013:p1250:b004:l037","ordinal":171597,"en":"Their surging people roared,"},{"id":"semetey-1-2013:p1250:b004:l038","ordinal":171598,"en":"Crying Toltoy's battle cry."},{"id":"semetey-1-2013:p1250:b004:l039","ordinal":171599,"en":"The people stirred and shouted,"}]
