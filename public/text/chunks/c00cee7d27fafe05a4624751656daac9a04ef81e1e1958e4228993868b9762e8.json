[{"id":"semetey-1-2013:p1169:b005:l017","ordinal":166401,"en":"This accursed Burut"},{"id":"semetey-1-2013:p1169:b005:l018","ordinal":166402,"en":"Has apparently been left to attack us."},{"id":"semetey-1-2013:p1169:b005:l019","ordinal":166403,"en":"There is pressing down, they say,"},{"id":"semetey-1-2013:p1169:b005:l020","ordinal":166404,"en":"But no stepping over the head."},{"id":"semetey-1-2013:p1169:b005:l021","ordinal":166405,"en":"There is lifting and throwing, they say,"},{"id":"semetey-1-2013:p1169:b005:l022","ordinal":166406,"en":"But no kicking in the chest."},{"id":"semetey-1-2013:p1169:b005:l023","ordinal":166407,"en":"There was permission to throw a man,"},{"id":"semetey-1-2013:p1169:b005:l024","ordinal":166408,"en":"But none to kick him in the groin."},{"id":"semetey-1-2013:p1169:b005:l025","ordinal":166409,"en":"At the place where belts are girded,"},{"id":"semetey-1-2013:p1169:b005:l026","ordinal":166410,"en":"At the place where contests are held,"},{"id":"semetey-1-2013:p1169:b005:l027","ordinal":166411,"en":"This accursed Burut—"},{"id":"semetey-1-2013:p1169:b005:l028","ordinal":166412,"en":"What has he done?\""},{"id":"semetey-1-2013:p1169:b005:l029","ordinal":166413,"en":"Bridling as though to attack,"},{"id":"semetey-1-2013:p1169:b005:l030","ordinal":166414,"en":"The Black Chinese and Manchu host"},{"id":"semetey-1-2013:p1169:b005:l031","ordinal":166415,"en":"All surged forward together;"},{"id":"semetey-1-2013:p1169:b005:l032","ordinal":166416,"en":"The finest stone-bedecked Chinese"},{"id":"semetey-1-2013:p1169:b005:l033","ordinal":166417,"en":"Were carried away with rage."},{"id":"semetey-1-2013:p1169:b005:l034","ordinal":166418,"en":"Those deftest with spears,"},{"id":"semetey-1-2013:p1169:b005:l035","ordinal":166419,"en":"Those strongest with battle-axes,"},{"id":"semetey-1-2013:p1169:b005:l036","ordinal":166420,"en":"Advanced with a rumble,"},{"id":"semetey-1-2013:p1169:b005:l037","ordinal":166421,"en":"As though to engulf the Kyrgyz"},{"id":"semetey-1-2013:p1169:b005:l038","ordinal":166422,"en":"And leave slaughter behind."},{"id":"semetey-1-2013:p1170:b003:l001","ordinal":166423,"en":"Now God struck the Chinese;"},{"id":"semetey-1-2013:p1170:b003:l002","ordinal":166424,"en":"The Manchus, rumbling,"},{"id":"semetey-1-2013:p1170:b003:l003","ordinal":166425,"en":"Spoke harsh words."},{"id":"semetey-1-2013:p1170:b003:l004","ordinal":166426,"en":"The war drum that summons men to battle—"},{"id":"semetey-1-2013:p1170:b003:l005","ordinal":166427,"en":"They beat that drum hard."},{"id":"semetey-1-2013:p1170:b003:l006","ordinal":166428,"en":"The war drum sounded loudly;"},{"id":"semetey-1-2013:p1170:b003:l007","ordinal":166429,"en":"Black Kalmyks, many Manchus,"},{"id":"semetey-1-2013:p1170:b003:l008","ordinal":166430,"en":"And the seething multitude of lords"},{"id":"semetey-1-2013:p1170:b003:l009","ordinal":166431,"en":"Closed ranks as if to engulf them."},{"id":"semetey-1-2013:p1170:b003:l010","ordinal":166432,"en":"They armed themselves in confusion,"},{"id":"semetey-1-2013:p1170:b003:l011","ordinal":166433,"en":"Strapping on battle-axes, armor, and swords"},{"id":"semetey-1-2013:p1170:b003:l012","ordinal":166434,"en":"Every which way."},{"id":"semetey-1-2013:p1170:b003:l013","ordinal":166435,"en":"The Manchu people roared;"},{"id":"semetey-1-2013:p1170:b003:l014","ordinal":166436,"en":"Squad leaders strutted,"},{"id":"semetey-1-2013:p1170:b003:l015","ordinal":166437,"en":"Leaders of fifty sprang about,"},{"id":"semetey-1-2013:p1170:b003:l016","ordinal":166438,"en":"Leaders of hundreds ran,"},{"id":"semetey-1-2013:p1170:b003:l017","ordinal":166439,"en":"And commanders of thousands despaired of life."},{"id":"semetey-1-2013:p1170:b003:l018","ordinal":166440,"en":"When the Chinese showed their fury,"},{"id":"semetey-1-2013:p1170:b003:l019","ordinal":166441,"en":"Saying, \"He steps over the khan's head,\""},{"id":"semetey-1-2013:p1170:b003:l020","ordinal":166442,"en":"They took it as an insult."},{"id":"semetey-1-2013:p1170:b003:l021","ordinal":166443,"en":"The Muslims who came to the feast"},{"id":"semetey-1-2013:p1170:b003:l022","ordinal":166444,"en":"Were pressed into dreadful straits."},{"id":"semetey-1-2013:p1170:b003:l023","ordinal":166445,"en":"Their khojas in white turbans,"},{"id":"semetey-1-2013:p1170:b003:l024","ordinal":166446,"en":"Their mullahs who recited lessons,"},{"id":"semetey-1-2013:p1170:b003:l025","ordinal":166447,"en":"Wrapped their belts as turbans,"},{"id":"semetey-1-2013:p1170:b003:l026","ordinal":166448,"en":"Implored the Almighty,"},{"id":"semetey-1-2013:p1170:b003:l027","ordinal":166449,"en":"Lost their wits,"},{"id":"semetey-1-2013:p1170:b003:l028","ordinal":166450,"en":"And fled then,"},{"id":"semetey-1-2013:p1170:b003:l029","ordinal":166451,"en":"Crowding toward Manas."},{"id":"semetey-1-2013:p1170:b003:l030","ordinal":166452,"en":"Then leopard Manas"},{"id":"semetey-1-2013:p1170:b003:l031","ordinal":166453,"en":"Stepped apart with courage,"},{"id":"semetey-1-2013:p1170:b003:l032","ordinal":166454,"en":"Showing the form of a lion."},{"id":"semetey-1-2013:p1170:b003:l033","ordinal":166455,"en":"Almambet and Chubak together"},{"id":"semetey-1-2013:p1170:b003:l034","ordinal":166456,"en":"Led his prancing Kula horse,"},{"id":"semetey-1-2013:p1170:b003:l035","ordinal":166457,"en":"While twelve companions held the reins."},{"id":"semetey-1-2013:p1170:b003:l036","ordinal":166458,"en":"Manas stepped away from the companions,"},{"id":"semetey-1-2013:p1170:b003:l037","ordinal":166459,"en":"Showing the form of a dragon,"},{"id":"semetey-1-2013:p1170:b003:l038","ordinal":166460,"en":"Straining and heaving in fury."},{"id":"semetey-1-2013:p1170:b004:l001","ordinal":166461,"en":"Your uncle, leopard Bakay,"},{"id":"semetey-1-2013:p1170:b004:l002","ordinal":166462,"en":"Seized Manas as he struggled:"},{"id":"semetey-1-2013:p1170:b004:l003","ordinal":166463,"en":"\"We invited you to the feast as people,"},{"id":"semetey-1-2013:p1170:b004:l004","ordinal":166464,"en":"But you Black Kalmyks and Chinese"},{"id":"semetey-1-2013:p1170:b004:l005","ordinal":166465,"en":"Have become depraved;"},{"id":"semetey-1-2013:p1170:b004:l006","ordinal":166466,"en":"My roaring Chinese,"},{"id":"semetey-1-2013:p1170:b004:l007","ordinal":166467,"en":"You have become impossible."},{"id":"semetey-1-2013:p1170:b004:l008","ordinal":166468,"en":"If you mean to fight to the death, say so plainly."},{"id":"semetey-1-2013:p1170:b004:l009","ordinal":166469,"en":"If I do not mount Akkula"},{"id":"semetey-1-2013:p1170:b004:l010","ordinal":166470,"en":"And drive your lord shouting"},{"id":"semetey-1-2013:p1170:b004:l011","ordinal":166471,"en":"Toward Beijing—"},{"id":"semetey-1-2013:p1170:b004:l012","ordinal":166472,"en":"If you are guests, state your purpose;"},{"id":"semetey-1-2013:p1170:b004:l013","ordinal":166473,"en":"If you would domineer, say so plainly."},{"id":"semetey-1-2013:p1170:b004:l014","ordinal":166474,"en":"I invited you as people to the feast;"},{"id":"semetey-1-2013:p1170:b004:l015","ordinal":166475,"en":"Put aside your pride and eat your meat."},{"id":"semetey-1-2013:p1170:b004:l016","ordinal":166476,"en":"If you want slaughter, give your answer;"},{"id":"semetey-1-2013:p1170:b004:l017","ordinal":166477,"en":"Let us make the carnage a spectacle."},{"id":"semetey-1-2013:p1170:b004:l018","ordinal":166478,"en":"Accursed Chinese, give your answer!"},{"id":"semetey-1-2013:p1170:b004:l019","ordinal":166479,"en":"I am not Manas who will bow,"},{"id":"semetey-1-2013:p1170:b004:l020","ordinal":166480,"en":"And you are not Chinese who can overpower me.\""},{"id":"semetey-1-2013:p1170:b004:l021","ordinal":166481,"en":"Glaring fiercely,"},{"id":"semetey-1-2013:p1170:b004:l022","ordinal":166482,"en":"Venom spilling from his mouth,"},{"id":"semetey-1-2013:p1170:b004:l023","ordinal":166483,"en":"Looming like Ala-Too,"},{"id":"semetey-1-2013:p1170:b004:l024","ordinal":166484,"en":"He strained in fury."},{"id":"semetey-1-2013:p1170:b004:l025","ordinal":166485,"en":"\"Let me go!\" he cried to Bakay,"},{"id":"semetey-1-2013:p1170:b004:l026","ordinal":166486,"en":"And Manas struggled with a deep roar."},{"id":"semetey-1-2013:p1170:b004:l027","ordinal":166487,"en":"The forty companions split in two,"},{"id":"semetey-1-2013:p1170:b004:l028","ordinal":166488,"en":"As though about to begin slaughter,"},{"id":"semetey-1-2013:p1170:b004:l029","ordinal":166489,"en":"Looming like Ala-Too."},{"id":"semetey-1-2013:p1170:b004:l030","ordinal":166490,"en":"Wearing a coat of yellow gold,"},{"id":"semetey-1-2013:p1170:b004:l031","ordinal":166491,"en":"Mounted on a piebald horse,"},{"id":"semetey-1-2013:p1170:b004:l032","ordinal":166492,"en":"Wrath showing on his face,"},{"id":"semetey-1-2013:p1170:b004:l033","ordinal":166493,"en":"A sheathless sword at his side,"},{"id":"semetey-1-2013:p1170:b004:l034","ordinal":166494,"en":"He looked ready to slaughter them."},{"id":"semetey-1-2013:p1170:b004:l035","ordinal":166495,"en":"Wearing a blue rapys coat,"},{"id":"semetey-1-2013:p1170:b004:l036","ordinal":166496,"en":"Mounted on a mottled blue horse—"},{"id":"semetey-1-2013:p1170:b004:l037","ordinal":166497,"en":"Such was Chubak's way."},{"id":"semetey-1-2013:p1170:b004:l038","ordinal":166498,"en":"The lion born to Akbaltay,"},{"id":"semetey-1-2013:p1171:b003:l001","ordinal":166499,"en":"The deftest spearman,"},{"id":"semetey-1-2013:p1171:b003:l002","ordinal":166500,"en":"Akbaltay's Chubak,"},{"id":"semetey-1-2013:p1171:b003:l003","ordinal":166501,"en":"Finest of the pale-yellow warriors."},{"id":"semetey-1-2013:p1171:b003:l004","ordinal":166502,"en":"The Chinese lost heart;"},{"id":"semetey-1-2013:p1171:b003:l005","ordinal":166503,"en":"Your precious Chubak appeared,"},{"id":"semetey-1-2013:p1171:b003:l006","ordinal":166504,"en":"And with a hungry shout and fierce battle cry,"},{"id":"semetey-1-2013:p1171:b004:l001","ordinal":166505,"en":"He charged in shouting."},{"id":"semetey-1-2013:p1171:b004:l002","ordinal":166506,"en":"\"We were guests, hero,\" they said."},{"id":"semetey-1-2013:p1171:b004:l003","ordinal":166507,"en":"The finest stone-bedecked Chinese"},{"id":"semetey-1-2013:p1171:b004:l004","ordinal":166508,"en":"Gathered together,"},{"id":"semetey-1-2013:p1171:b004:l005","ordinal":166509,"en":"And the Black Kalmyks and Manchus"},{"id":"semetey-1-2013:p1171:b004:l006","ordinal":166510,"en":"Subsided and sat down heavily."},{"id":"semetey-1-2013:p1171:b006:l001","ordinal":166511,"en":"Along the Uch-Karkyra"},{"id":"semetey-1-2013:p1171:b006:l002","ordinal":166512,"en":"A gathering now formed in a ring."},{"id":"semetey-1-2013:p1171:b006:l003","ordinal":166513,"en":"From the city of Kakanchyn,"},{"id":"semetey-1-2013:p1171:b006:l004","ordinal":166514,"en":"Thinking, \"If there is conflict with the Buruts,"},{"id":"semetey-1-2013:p1171:b006:l005","ordinal":166515,"en":"He may prove useful,\""},{"id":"semetey-1-2013:p1171:b006:l006","ordinal":166516,"en":"They had brought a champion"},{"id":"semetey-1-2013:p1171:b006:l007","ordinal":166517,"en":"With strength unknown to man."},{"id":"semetey-1-2013:p1171:b006:l008","ordinal":166518,"en":"The champion of the infidels"},{"id":"semetey-1-2013:p1171:b006:l009","ordinal":166519,"en":"Was hairy-soled Tukubay;"},{"id":"semetey-1-2013:p1171:b006:l010","ordinal":166520,"en":"That indeed was his name."},{"id":"semetey-1-2013:p1171:b006:l011","ordinal":166521,"en":"For slaughter in particular,"},{"id":"semetey-1-2013:p1171:b006:l012","ordinal":166522,"en":"They had prepared this formidable man."},{"id":"semetey-1-2013:p1171:b006:l013","ordinal":166523,"en":"He never spared one who grappled with him,"},{"id":"semetey-1-2013:p1171:b006:l014","ordinal":166524,"en":"And a whole pig's meat"},{"id":"semetey-1-2013:p1171:b006:l015","ordinal":166525,"en":"Did not fill him at one sitting."},{"id":"semetey-1-2013:p1171:b006:l016","ordinal":166526,"en":"When he charged in fury,"},{"id":"semetey-1-2013:p1171:b006:l017","ordinal":166527,"en":"It was the end of days for a man;"},{"id":"semetey-1-2013:p1171:b006:l018","ordinal":166528,"en":"He was a merciless champion."},{"id":"semetey-1-2013:p1171:b006:l019","ordinal":166529,"en":"The breadth of his nape"},{"id":"semetey-1-2013:p1171:b006:l020","ordinal":166530,"en":"Was twelve spans."},{"id":"semetey-1-2013:p1171:b006:l021","ordinal":166531,"en":"Tukubay entered the wrestling ground"},{"id":"semetey-1-2013:p1171:b006:l022","ordinal":166532,"en":"And stood staring with a grunt."},{"id":"semetey-1-2013:p1171:b006:l023","ordinal":166533,"en":"Kokotoy's Bokmurun"},{"id":"semetey-1-2013:p1171:b006:l024","ordinal":166534,"en":"Issued another proclamation:"},{"id":"semetey-1-2013:p1171:b006:l025","ordinal":166535,"en":"\"My father Kokotoy has not died;"},{"id":"semetey-1-2013:p1171:b006:l026","ordinal":166536,"en":"Kokotoy's wealth"},{"id":"semetey-1-2013:p1171:b006:l027","ordinal":166537,"en":"Has grown like spring grass."},{"id":"semetey-1-2013:p1171:b006:l028","ordinal":166538,"en":"Today I open the treasury"},{"id":"semetey-1-2013:p1171:b006:l029","ordinal":166539,"en":"That fills forty rooms."},{"id":"semetey-1-2013:p1171:b009:l001","ordinal":166540,"en":"For infidel and Muslim,"},{"id":"semetey-1-2013:p1171:b009:l002","ordinal":166541,"en":"I will scatter it lavishly."},{"id":"semetey-1-2013:p1171:b009:l003","ordinal":166542,"en":"With lower lips drooping,"},{"id":"semetey-1-2013:p1171:b009:l004","ordinal":166543,"en":"With tusks jutting,"},{"id":"semetey-1-2013:p1171:b009:l005","ordinal":166544,"en":"Necks raised like ducks,"},{"id":"semetey-1-2013:p1171:b009:l006","ordinal":166545,"en":"Their two humps towering,"},{"id":"semetey-1-2013:p1171:b009:l007","ordinal":166546,"en":"I will slaughter one thousand camels."},{"id":"semetey-1-2013:p1171:b009:l008","ordinal":166547,"en":"With branching horns jutting,"},{"id":"semetey-1-2013:p1171:b009:l009","ordinal":166548,"en":"I will slaughter one thousand cattle."},{"id":"semetey-1-2013:p1171:b009:l010","ordinal":166549,"en":"Making their foals cry out,"},{"id":"semetey-1-2013:p1171:b009:l011","ordinal":166550,"en":"To begin this spectacle,"},{"id":"semetey-1-2013:p1171:b009:l012","ordinal":166551,"en":"I will slaughter one thousand mares."},{"id":"semetey-1-2013:p1171:b009:l013","ordinal":166552,"en":"Making their lambs bleat,"},{"id":"semetey-1-2013:p1171:b009:l014","ordinal":166553,"en":"Lining up their mothers,"},{"id":"semetey-1-2013:p1171:b009:l015","ordinal":166554,"en":"Delighting those who slaughter them,"},{"id":"semetey-1-2013:p1171:b009:l016","ordinal":166555,"en":"I will kill one thousand sheep."},{"id":"semetey-1-2013:p1171:b009:l017","ordinal":166556,"en":"Dividing gold like stones,"},{"id":"semetey-1-2013:p1171:b009:l018","ordinal":166557,"en":"Showing my wealth to the people,"},{"id":"semetey-1-2013:p1171:b009:l019","ordinal":166558,"en":"I will stake this much gold."},{"id":"semetey-1-2013:p1171:b009:l020","ordinal":166559,"en":"Infidel and Muslim,"},{"id":"semetey-1-2013:p1171:b009:l021","ordinal":166560,"en":"Let the people assemble;"},{"id":"semetey-1-2013:p1171:b009:l022","ordinal":166561,"en":"Hold another wrestling match."},{"id":"semetey-1-2013:p1171:b009:l023","ordinal":166562,"en":"Strive without regret,"},{"id":"semetey-1-2013:p1171:b009:l024","ordinal":166563,"en":"Grip firmly and grapple,"},{"id":"semetey-1-2013:p1171:b009:l025","ordinal":166564,"en":"And win your prize outright."},{"id":"semetey-1-2013:p1171:b009:l026","ordinal":166565,"en":"My wealth is inexhaustible;"},{"id":"semetey-1-2013:p1171:b009:l027","ordinal":166566,"en":"Make a proper spectacle,"},{"id":"semetey-1-2013:p1171:b009:l028","ordinal":166567,"en":"And divide Kokotoy's abundant riches"},{"id":"semetey-1-2013:p1171:b009:l029","ordinal":166568,"en":"Without quarreling.\""},{"id":"semetey-1-2013:p1172:b003:l001","ordinal":166569,"en":"Kokotoy's Bokmurun"},{"id":"semetey-1-2013:p1172:b003:l002","ordinal":166570,"en":"Issued another proclamation."},{"id":"semetey-1-2013:p1172:b003:l003","ordinal":166571,"en":"The Chinese Tukubay,"},{"id":"semetey-1-2013:p1172:b003:l004","ordinal":166572,"en":"The hairy-soled champion,"},{"id":"semetey-1-2013:p1172:b003:l005","ordinal":166573,"en":"Stepped out to wrestle."},{"id":"semetey-1-2013:p1172:b003:l006","ordinal":166574,"en":"\"No one who grapples"},{"id":"semetey-1-2013:p1172:b003:l007","ordinal":166575,"en":"With a wrathful infidel prospers;"},{"id":"semetey-1-2013:p1172:b003:l008","ordinal":166576,"en":"No one who challenges him survives,\" they said."},{"id":"semetey-1-2013:p1172:b003:l009","ordinal":166577,"en":"Holy Khan Manas"},{"id":"semetey-1-2013:p1172:b003:l010","ordinal":166578,"en":"Was troubled."},{"id":"semetey-1-2013:p1172:b003:l011","ordinal":166579,"en":"Before much time had passed—"},{"id":"semetey-1-2013:p1172:b003:l012","ordinal":166580,"en":"God spare us such a sight—"},{"id":"semetey-1-2013:p1172:b003:l013","ordinal":166581,"en":"The saintly Khan Bakay,"},{"id":"semetey-1-2013:p1172:b003:l014","ordinal":166582,"en":"Agybay of Argyn Khan,"},{"id":"semetey-1-2013:p1172:b003:l015","ordinal":166583,"en":"Chubak of Akbaltay,"},{"id":"semetey-1-2013:p1172:b003:l016","ordinal":166584,"en":"Almambet of Azoozil,"},{"id":"semetey-1-2013:p1172:b003:l017","ordinal":166585,"en":"Jamgyrchy of the Esheks,"},{"id":"semetey-1-2013:p1172:b003:l018","ordinal":166586,"en":"Hero Toshtuk, son of Eleman,"},{"id":"semetey-1-2013:p1172:b003:l019","ordinal":166587,"en":"Urbush of the Kipchaks,"},{"id":"semetey-1-2013:p1172:b003:l020","ordinal":166588,"en":"With an armful of weapons at his belt,"},{"id":"semetey-1-2013:p1172:b003:l021","ordinal":166589,"en":"Muzburchak, son of Buudayyk,"},{"id":"semetey-1-2013:p1172:b003:l022","ordinal":166590,"en":"Kokcho of the Kazakhs,"},{"id":"semetey-1-2013:p1172:b003:l023","ordinal":166591,"en":"Synjybek of Andijan,"},{"id":"semetey-1-2013:p1172:b003:l024","ordinal":166592,"en":"Akun Khan from Afghanistan,"},{"id":"semetey-1-2013:p1172:b003:l025","ordinal":166593,"en":"Who dwelt in Chambyl-Bel,"},{"id":"semetey-1-2013:p1172:b003:l026","ordinal":166594,"en":"The two giants Janaaly and Karach,"},{"id":"semetey-1-2013:p1172:b003:l027","ordinal":166595,"en":"And were called peerlessly mighty heroes—"},{"id":"semetey-1-2013:p1172:b003:l028","ordinal":166596,"en":"The Muslim people were there,"},{"id":"semetey-1-2013:p1172:b003:l029","ordinal":166597,"en":"And heroes who boasted of courage"},{"id":"semetey-1-2013:p1172:b003:l030","ordinal":166598,"en":"Had all arrived together."},{"id":"semetey-1-2013:p1172:b003:l031","ordinal":166599,"en":"All the khans assembled;"},{"id":"semetey-1-2013:p1172:b003:l032","ordinal":166600,"en":"Destroyer Khan Manas was there,"},{"id":"semetey-1-2013:p1172:b003:l033","ordinal":166601,"en":"And all the saints were there."},{"id":"semetey-1-2013:p1172:b003:l034","ordinal":166602,"en":"The infidel champion who came out"},{"id":"semetey-1-2013:p1172:b003:l035","ordinal":166603,"en":"Could seemingly tear apart"},{"id":"semetey-1-2013:p1172:b003:l036","ordinal":166604,"en":"Any man he grappled with."},{"id":"semetey-1-2013:p1172:b003:l037","ordinal":166605,"en":"His bulk was half a mountain;"},{"id":"semetey-1-2013:p1172:b003:l038","ordinal":166606,"en":"He looked able to devour his opponent."},{"id":"semetey-1-2013:p1172:b003:l039","ordinal":166607,"en":"\"What can be done?\" they asked,"},{"id":"semetey-1-2013:p1172:b004:l001","ordinal":166608,"en":"And the Muslims were distressed."},{"id":"semetey-1-2013:p1172:b004:l002","ordinal":166609,"en":"They gathered together"},{"id":"semetey-1-2013:p1172:b004:l003","ordinal":166610,"en":"And could find no solution."},{"id":"semetey-1-2013:p1172:b004:l004","ordinal":166611,"en":"Poor prophetic Kanykey"},{"id":"semetey-1-2013:p1172:b004:l005","ordinal":166612,"en":"Walked with measured steps"},{"id":"semetey-1-2013:p1172:b004:l006","ordinal":166613,"en":"Into the midst of all those people."},{"id":"semetey-1-2013:p1172:b004:l007","ordinal":166614,"en":"Your poor prophetic kinswoman"},{"id":"semetey-1-2013:p1172:b004:l008","ordinal":166615,"en":"Sat down then"},{"id":"semetey-1-2013:p1172:b004:l009","ordinal":166616,"en":"And began an ominous speech:"},{"id":"semetey-1-2013:p1172:b004:l010","ordinal":166617,"en":"\"A person has many turns of fortune."},{"id":"semetey-1-2013:p1172:b004:l011","ordinal":166618,"en":"When I was fourteen, still a girl,"},{"id":"semetey-1-2013:p1172:b004:l012","ordinal":166619,"en":"Destroyer Bakay was there too;"},{"id":"semetey-1-2013:p1172:b004:l013","ordinal":166620,"en":"My gray-maned lord went to Bukhara"},{"id":"semetey-1-2013:p1172:b004:l014","ordinal":166621,"en":"And left a scar upon my breast."},{"id":"semetey-1-2013:p1172:b004:l015","ordinal":166622,"en":"Gray-maned heroes, you stand here;"},{"id":"semetey-1-2013:p1172:b004:l016","ordinal":166623,"en":"I still have much to tell."},{"id":"semetey-1-2013:p1172:b004:l017","ordinal":166624,"en":"Yesterday, to the city of my father Temir Khan,"},{"id":"semetey-1-2013:p1172:b004:l018","ordinal":166625,"en":"Loading gold coins on eighty camels,"},{"id":"semetey-1-2013:p1172:b004:l019","ordinal":166626,"en":"Saying, 'I will bind her head in marriage,'"},{"id":"semetey-1-2013:p1172:b004:l020","ordinal":166627,"en":"My padishah lord went."},{"id":"semetey-1-2013:p1172:b004:l021","ordinal":166628,"en":"When he became an in-law, slaughtered livestock,"},{"id":"semetey-1-2013:p1172:b004:l022","ordinal":166629,"en":"And made his obeisance,"},{"id":"semetey-1-2013:p1172:b004:l023","ordinal":166630,"en":"My father Temir Khan"},{"id":"semetey-1-2013:p1172:b004:l024","ordinal":166631,"en":"Had the gold poured out"},{"id":"semetey-1-2013:p1172:b004:l025","ordinal":166632,"en":"And stored in the treasury."},{"id":"semetey-1-2013:p1172:b004:l026","ordinal":166633,"en":"When he gathered khojas and mullahs,"},{"id":"semetey-1-2013:p1172:b004:l027","ordinal":166634,"en":"Made the marriage rite at high noon,"},{"id":"semetey-1-2013:p1172:b004:l028","ordinal":166635,"en":"And eighty brides and eighty girls"},{"id":"semetey-1-2013:p1172:b004:l029","ordinal":166636,"en":"Piled the bedding waist-high,"},{"id":"semetey-1-2013:p1172:b004:l030","ordinal":166637,"en":"They brought me there with ceremony,"},{"id":"semetey-1-2013:p1172:b004:l031","ordinal":166638,"en":"Intending to lay me down."},{"id":"semetey-1-2013:p1172:b004:l032","ordinal":166639,"en":"When I reached the drawn curtain"},{"id":"semetey-1-2013:p1172:b004:l033","ordinal":166640,"en":"And was about to lie down,"},{"id":"semetey-1-2013:p1172:b004:l034","ordinal":166641,"en":"The white tinte bought"},{"id":"semetey-1-2013:p1172:b004:l035","ordinal":166642,"en":"For sixty foals and forty sheep"},{"id":"semetey-1-2013:p1172:b004:l036","ordinal":166643,"en":"Leapt from its sheath,"},{"id":"semetey-1-2013:p1172:b004:l037","ordinal":166644,"en":"And grazed your wrist:"},{"id":"semetey-1-2013:p1172:b004:l038","ordinal":166645,"en":"\"Before I have even taken this shrew,"},{"id":"semetey-1-2013:p1172:b004:l039","ordinal":166646,"en":"She has wounded my wrist,\" you said."},{"id":"semetey-1-2013:p1173:b003:l001","ordinal":166647,"en":"The people gathered,"},{"id":"semetey-1-2013:p1173:b003:l002","ordinal":166648,"en":"Made a claim against my poor head,"},{"id":"semetey-1-2013:p1173:b003:l003","ordinal":166649,"en":"And laid the penalty upon my neck,"},{"id":"semetey-1-2013:p1173:b003:l004","ordinal":166650,"en":"O gray-maned leopard lord."},{"id":"semetey-1-2013:p1173:b003:l005","ordinal":166651,"en":"You left without lying in my embrace;"},{"id":"semetey-1-2013:p1173:b003:l006","ordinal":166652,"en":"In the fortress at Bukhara,"},{"id":"semetey-1-2013:p1173:b003:l007","ordinal":166653,"en":"Because of this hero,"},{"id":"semetey-1-2013:p1173:b003:l008","ordinal":166654,"en":"I was left an unmarried woman in Altai."},{"id":"semetey-1-2013:p1173:b003:l009","ordinal":166655,"en":"\"Rather than be left unmarried as a maiden,"},{"id":"semetey-1-2013:p1173:b003:l010","ordinal":166656,"en":"I will die from this sight;"}]
