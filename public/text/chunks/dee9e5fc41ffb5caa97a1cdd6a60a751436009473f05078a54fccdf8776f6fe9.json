[{"id":"semetey-1-2013:p1099:b005:l006","ordinal":161025,"en":"When Kökötöy's son Bokmurun"},{"id":"semetey-1-2013:p1099:b005:l007","ordinal":161026,"en":"Moved out from Tashkent,"},{"id":"semetey-1-2013:p1099:b005:l008","ordinal":161027,"en":"He had me mounted on a dappled bay pacer,"},{"id":"semetey-1-2013:p1099:b005:l009","ordinal":161028,"en":"Dressed me in a robe of silk,"},{"id":"semetey-1-2013:p1099:b005:l010","ordinal":161029,"en":"And led me along to the feast."},{"id":"semetey-1-2013:p1099:b005:l011","ordinal":161030,"en":"He had me mounted on a yellow-dappled pacer,"},{"id":"semetey-1-2013:p1099:b005:l012","ordinal":161031,"en":"Dressed me in a robe of honor,"},{"id":"semetey-1-2013:p1099:b005:l013","ordinal":161032,"en":"And led me among the multitude."},{"id":"semetey-1-2013:p1099:b005:l014","ordinal":161033,"en":"At that time my head"},{"id":"semetey-1-2013:p1099:b005:l015","ordinal":161034,"en":"Barely rose above the saddle basket;"},{"id":"semetey-1-2013:p1099:b005:l016","ordinal":161035,"en":"At that time my age"},{"id":"semetey-1-2013:p1099:b005:l017","ordinal":161036,"en":"Had barely reached six years."},{"id":"semetey-1-2013:p1099:b005:l018","ordinal":161037,"en":"At Kökötöy's memorial feast,"},{"id":"semetey-1-2013:p1099:b005:l019","ordinal":161038,"en":"Koshoy went and I went;"},{"id":"semetey-1-2013:p1099:b005:l020","ordinal":161039,"en":"Alas, you are Kozho—"},{"id":"semetey-1-2013:p1099:b005:l021","ordinal":161040,"en":"When did you ever go with us?"},{"id":"semetey-1-2013:p1099:b005:l022","ordinal":161041,"en":"These are the words I have spoken,"},{"id":"semetey-1-2013:p1099:b005:l023","ordinal":161042,"en":"Saying you are an extraordinary Kozho."},{"id":"semetey-1-2013:p1099:b005:l024","ordinal":161043,"en":"That was the time I went and saw"},{"id":"semetey-1-2013:p1099:b005:l025","ordinal":161044,"en":"Kökötöy's great multitude."},{"id":"semetey-1-2013:p1099:b005:l026","ordinal":161045,"en":"Tens of thousands of massed camels,"},{"id":"semetey-1-2013:p1099:b005:l027","ordinal":161046,"en":"And joining those camels,"},{"id":"semetey-1-2013:p1099:b005:l028","ordinal":161047,"en":"Many more camels in abundance."},{"id":"semetey-1-2013:p1099:b005:l029","ordinal":161048,"en":"Everyone who saw"},{"id":"semetey-1-2013:p1099:b005:l030","ordinal":161049,"en":"Kökötöy's caravan was amazed,"},{"id":"semetey-1-2013:p1099:b005:l031","ordinal":161050,"en":"And many people asked one another:"},{"id":"semetey-1-2013:p1099:b005:l032","ordinal":161051,"en":"“Good people, whose are these countless camels?"},{"id":"semetey-1-2013:p1099:b005:l033","ordinal":161052,"en":"They are the camels of heroic Khan Kökötöy,"},{"id":"semetey-1-2013:p1099:b005:l034","ordinal":161053,"en":"The camels that carry rice."},{"id":"semetey-1-2013:p1099:b005:l035","ordinal":161054,"en":"Whose are these countless men on foot?"},{"id":"semetey-1-2013:p1099:b005:l036","ordinal":161055,"en":"They are Kökötöy's footmen,"},{"id":"semetey-1-2013:p1099:b005:l037","ordinal":161056,"en":"Who render service.”"},{"id":"semetey-1-2013:p1099:b005:l038","ordinal":161057,"en":"His wife Külayym—"},{"id":"semetey-1-2013:p1099:b005:l039","ordinal":161058,"en":"He dressed her in sweeping black,"},{"id":"semetey-1-2013:p1100:b003:l001","ordinal":161059,"en":"Making Khan Kökötöy's funeral honors"},{"id":"semetey-1-2013:p1100:b003:l002","ordinal":161060,"en":"Known to the people,"},{"id":"semetey-1-2013:p1100:b003:l003","ordinal":161061,"en":"He had baggage loaded on gelded camels"},{"id":"semetey-1-2013:p1100:b003:l004","ordinal":161062,"en":"And had some sixty women"},{"id":"semetey-1-2013:p1100:b003:l005","ordinal":161063,"en":"All sing the lament."},{"id":"semetey-1-2013:p1100:b003:l006","ordinal":161064,"en":"Boys and old men drove the livestock,"},{"id":"semetey-1-2013:p1100:b003:l007","ordinal":161065,"en":"Rushing in from every side."},{"id":"semetey-1-2013:p1100:b003:l008","ordinal":161066,"en":"At the head of the caravan was Külayym;"},{"id":"semetey-1-2013:p1100:b003:l009","ordinal":161067,"en":"Sixty women lamenters"},{"id":"semetey-1-2013:p1100:b003:l010","ordinal":161068,"en":"All wailed and wept."},{"id":"semetey-1-2013:p1100:b003:l011","ordinal":161069,"en":"Her trailing hem swept the ground,"},{"id":"semetey-1-2013:p1100:b003:l012","ordinal":161070,"en":"And her solitary lament split heads."},{"id":"semetey-1-2013:p1100:b003:l013","ordinal":161071,"en":"They migrated, covering the land,"},{"id":"semetey-1-2013:p1100:b003:l014","ordinal":161072,"en":"Tethering foals and yearlings together,"},{"id":"semetey-1-2013:p1100:b003:l015","ordinal":161073,"en":"And tying mares as they moved."},{"id":"semetey-1-2013:p1100:b003:l016","ordinal":161074,"en":"All the camel calves roared;"},{"id":"semetey-1-2013:p1100:b003:l017","ordinal":161075,"en":"All the foals whinnied."},{"id":"semetey-1-2013:p1100:b003:l018","ordinal":161076,"en":"When one looked at the festive caravan,"},{"id":"semetey-1-2013:p1100:b003:l019","ordinal":161077,"en":"Kökötöy's migration"},{"id":"semetey-1-2013:p1100:b003:l020","ordinal":161078,"en":"Was a spectacle to all who saw it."},{"id":"semetey-1-2013:p1100:b003:l021","ordinal":161079,"en":"Kökötöy's son Bokmurun"},{"id":"semetey-1-2013:p1100:b003:l022","ordinal":161080,"en":"Departed without seeking counsel"},{"id":"semetey-1-2013:p1100:b003:l023","ordinal":161081,"en":"From imposing Manas."},{"id":"semetey-1-2013:p1100:b003:l024","ordinal":161082,"en":"He passed Aulie-Ata and Talas"},{"id":"semetey-1-2013:p1100:b003:l025","ordinal":161083,"en":"One after the other."},{"id":"semetey-1-2013:p1100:b003:l026","ordinal":161084,"en":"There was no mountain as small as an ankle bone,"},{"id":"semetey-1-2013:p1100:b003:l027","ordinal":161085,"en":"No hollow where a saddle blanket could sink;"},{"id":"semetey-1-2013:p1100:b003:l028","ordinal":161086,"en":"The whole caravan spread across the land"},{"id":"semetey-1-2013:p1100:b003:l029","ordinal":161087,"en":"And entered the broad valley."},{"id":"semetey-1-2013:p1100:b003:l030","ordinal":161088,"en":"The earth grew dim and clouded;"},{"id":"semetey-1-2013:p1100:b003:l031","ordinal":161089,"en":"Kökötöy's countless livestock"},{"id":"semetey-1-2013:p1100:b003:l032","ordinal":161090,"en":"Became one with the face of the earth."},{"id":"semetey-1-2013:p1100:b003:l033","ordinal":161091,"en":"The grass growing upon the ground"},{"id":"semetey-1-2013:p1100:b003:l034","ordinal":161092,"en":"Was erased beneath their hooves;"},{"id":"semetey-1-2013:p1100:b003:l035","ordinal":161093,"en":"His wealth surpassed all men's,"},{"id":"semetey-1-2013:p1100:b003:l036","ordinal":161094,"en":"And his tusked beasts fed their fill."},{"id":"semetey-1-2013:p1100:b003:l037","ordinal":161095,"en":"Livestock of every kind streamed along;"},{"id":"semetey-1-2013:p1100:b003:l038","ordinal":161096,"en":"People of every kind streamed along."},{"id":"semetey-1-2013:p1100:b003:l039","ordinal":161097,"en":"At the head of the caravan, red camels,"},{"id":"semetey-1-2013:p1100:b004:l001","ordinal":161098,"en":"Their throats like leather buckets,"},{"id":"semetey-1-2013:p1100:b004:l002","ordinal":161099,"en":"Their tusks thrust outward,"},{"id":"semetey-1-2013:p1100:b004:l003","ordinal":161100,"en":"Their lower lips drooping,"},{"id":"semetey-1-2013:p1100:b004:l004","ordinal":161101,"en":"Striding ponderously,"},{"id":"semetey-1-2013:p1100:b004:l005","ordinal":161102,"en":"Their manes covered in dust—"},{"id":"semetey-1-2013:p1100:b004:l006","ordinal":161103,"en":"Many camels streamed along."},{"id":"semetey-1-2013:p1100:b004:l007","ordinal":161104,"en":"Their foals whinnying,"},{"id":"semetey-1-2013:p1100:b004:l008","ordinal":161105,"en":"Their bellies sweeping the ground,"},{"id":"semetey-1-2013:p1100:b004:l009","ordinal":161106,"en":"Many mares streamed along."},{"id":"semetey-1-2013:p1100:b004:l010","ordinal":161107,"en":"Skimming over the earth,"},{"id":"semetey-1-2013:p1100:b004:l011","ordinal":161108,"en":"Roaming along the cool valley,"},{"id":"semetey-1-2013:p1100:b004:l012","ordinal":161109,"en":"Their mighty horns thrust outward,"},{"id":"semetey-1-2013:p1100:b004:l013","ordinal":161110,"en":"Many cattle streamed along."},{"id":"semetey-1-2013:p1100:b004:l014","ordinal":161111,"en":"At Kozu-Bashy and Kopo,"},{"id":"semetey-1-2013:p1100:b004:l015","ordinal":161112,"en":"They fattened sheep there;"},{"id":"semetey-1-2013:p1100:b004:l016","ordinal":161113,"en":"They crossed every lovely place"},{"id":"semetey-1-2013:p1100:b004:l017","ordinal":161114,"en":"And passed along the mountain passes."},{"id":"semetey-1-2013:p1100:b004:l018","ordinal":161115,"en":"The caravan's qibla side"},{"id":"semetey-1-2013:p1100:b004:l019","ordinal":161116,"en":"Went along Kegen,"},{"id":"semetey-1-2013:p1100:b004:l020","ordinal":161117,"en":"And Bokmurun reached"},{"id":"semetey-1-2013:p1100:b004:l021","ordinal":161118,"en":"The broad plain of Karkyra."},{"id":"semetey-1-2013:p1100:b004:l022","ordinal":161119,"en":"He enclosed it from end to end,"},{"id":"semetey-1-2013:p1100:b004:l023","ordinal":161120,"en":"And Kökötöy's great royal pavilion"},{"id":"semetey-1-2013:p1100:b004:l024","ordinal":161121,"en":"He brought to the plain of Karkyra,"},{"id":"semetey-1-2013:p1100:b004:l025","ordinal":161122,"en":"Raised it, and set it in place."},{"id":"semetey-1-2013:p1100:b004:l026","ordinal":161123,"en":"Calling it Khan Kökötöy's feast,"},{"id":"semetey-1-2013:p1100:b004:l027","ordinal":161124,"en":"Calling it the banks of Karkyra,"},{"id":"semetey-1-2013:p1100:b004:l028","ordinal":161125,"en":"He covered the earth in dust"},{"id":"semetey-1-2013:p1100:b004:l029","ordinal":161126,"en":"And made it renowned among the people."},{"id":"semetey-1-2013:p1100:b004:l030","ordinal":161127,"en":"He had all his wealth made ready;"},{"id":"semetey-1-2013:p1100:b004:l031","ordinal":161128,"en":"Kökötöy's many young men"},{"id":"semetey-1-2013:p1100:b004:l032","ordinal":161129,"en":"Prepared firewood without pause."},{"id":"semetey-1-2013:p1100:b004:l033","ordinal":161130,"en":"At Kara-Saz in Karkyra,"},{"id":"semetey-1-2013:p1100:b004:l034","ordinal":161131,"en":"Becoming friends with Kalday,"},{"id":"semetey-1-2013:p1100:b004:l035","ordinal":161132,"en":"He boiled salt and obtained it."},{"id":"semetey-1-2013:p1100:b004:l036","ordinal":161133,"en":"Along Great Karkyra,"},{"id":"semetey-1-2013:p1100:b004:l037","ordinal":161134,"en":"His surging people now made camp."},{"id":"semetey-1-2013:p1100:b004:l038","ordinal":161135,"en":"For Khan Kökötöy's memorial feast,"},{"id":"semetey-1-2013:p1100:b004:l039","ordinal":161136,"en":"Infidels and Muslims alike—"},{"id":"semetey-1-2013:p1101:b003:l001","ordinal":161137,"en":"Their time to come had now arrived."},{"id":"semetey-1-2013:p1101:b003:l002","ordinal":161138,"en":"At Küdür in Ükürchü,"},{"id":"semetey-1-2013:p1101:b003:l003","ordinal":161139,"en":"He had the cattle driven out to graze."},{"id":"semetey-1-2013:p1101:b003:l004","ordinal":161140,"en":"Below Aygyr-Zhal,"},{"id":"semetey-1-2013:p1101:b003:l005","ordinal":161141,"en":"He had a great tethering line stretched."},{"id":"semetey-1-2013:p1101:b003:l006","ordinal":161142,"en":"Along Üch-Kapkak,"},{"id":"semetey-1-2013:p1101:b003:l007","ordinal":161143,"en":"For Kökötöy's cooking pits,"},{"id":"semetey-1-2013:p1101:b003:l008","ordinal":161144,"en":"He had the hearth pits dug."},{"id":"semetey-1-2013:p1101:b003:l009","ordinal":161145,"en":"To spacious Küdür,"},{"id":"semetey-1-2013:p1101:b003:l010","ordinal":161146,"en":"He had horses brought in."},{"id":"semetey-1-2013:p1101:b003:l011","ordinal":161147,"en":"On the far side of those horses,"},{"id":"semetey-1-2013:p1101:b003:l012","ordinal":161148,"en":"He had the heroes slaughter them."},{"id":"semetey-1-2013:p1101:b003:l013","ordinal":161149,"en":"For Kökötöy's feast,"},{"id":"semetey-1-2013:p1101:b003:l014","ordinal":161150,"en":"This was suitable food."},{"id":"semetey-1-2013:p1101:b003:l015","ordinal":161151,"en":"For the Shibee and the Kalmyks,"},{"id":"semetey-1-2013:p1101:b003:l016","ordinal":161152,"en":"So they might eat it when they came,"},{"id":"semetey-1-2013:p1101:b003:l017","ordinal":161153,"en":"He slaughtered mighty-horned oxen and cows."},{"id":"semetey-1-2013:p1101:b003:l018","ordinal":161154,"en":"For the Manchus and Black Chinese,"},{"id":"semetey-1-2013:p1101:b003:l019","ordinal":161155,"en":"So they might eat these when they came,"},{"id":"semetey-1-2013:p1101:b003:l020","ordinal":161156,"en":"He slaughtered camels suited to them."},{"id":"semetey-1-2013:p1101:b003:l021","ordinal":161157,"en":"For the Kyrgyz and Oyguts,"},{"id":"semetey-1-2013:p1101:b003:l022","ordinal":161158,"en":"He made merry and slaughtered mares."},{"id":"semetey-1-2013:p1101:b003:l023","ordinal":161159,"en":"Kökötöy's son Bokmurun"},{"id":"semetey-1-2013:p1101:b003:l024","ordinal":161160,"en":"Made it splendid and spacious,"},{"id":"semetey-1-2013:p1101:b003:l025","ordinal":161161,"en":"Devoting all his wealth equally."},{"id":"semetey-1-2013:p1101:b003:l026","ordinal":161162,"en":"He marked the midpoint"},{"id":"semetey-1-2013:p1101:b003:l027","ordinal":161163,"en":"Between the Black Kalmyks and Kyrgyz,"},{"id":"semetey-1-2013:p1101:b003:l028","ordinal":161164,"en":"And made this feast of Kökötöy"},{"id":"semetey-1-2013:p1101:b003:l029","ordinal":161165,"en":"Unforgettable to the people"},{"id":"semetey-1-2013:p1101:b003:l030","ordinal":161166,"en":"Until the end of time,"},{"id":"semetey-1-2013:p1101:b003:l031","ordinal":161167,"en":"Making meat as high as Ala-Too."},{"id":"semetey-1-2013:p1101:b003:l032","ordinal":161168,"en":"Leading the people,"},{"id":"semetey-1-2013:p1101:b003:l033","ordinal":161169,"en":"Your elder uncle Koshoy"},{"id":"semetey-1-2013:p1101:b003:l034","ordinal":161170,"en":"Raised the standard with its golden finial"},{"id":"semetey-1-2013:p1101:b003:l035","ordinal":161171,"en":"And sent it soaring into the sky."},{"id":"semetey-1-2013:p1101:b003:l036","ordinal":161172,"en":"The turmoil Bokmurun"},{"id":"semetey-1-2013:p1101:b003:l037","ordinal":161173,"en":"Brought upon the people!"},{"id":"semetey-1-2013:p1101:b003:l038","ordinal":161174,"en":"Your uncle came riding"},{"id":"semetey-1-2013:p1101:b003:l039","ordinal":161175,"en":"His swift Kerkabylan."},{"id":"semetey-1-2013:p1101:b004:l001","ordinal":161176,"en":"All his weapons made ready,"},{"id":"semetey-1-2013:p1101:b004:l002","ordinal":161177,"en":"He fitted the golden-cheeked battle-ax"},{"id":"semetey-1-2013:p1101:b004:l003","ordinal":161178,"en":"To his wrist."},{"id":"semetey-1-2013:p1101:b004:l004","ordinal":161179,"en":"His brow was high and his face imposing;"},{"id":"semetey-1-2013:p1101:b004:l005","ordinal":161180,"en":"Those who looked at him marveled."},{"id":"semetey-1-2013:p1101:b004:l006","ordinal":161181,"en":"Tall and broad-shouldered,"},{"id":"semetey-1-2013:p1101:b004:l007","ordinal":161182,"en":"Kökbörü, son of Urumkhan,"},{"id":"semetey-1-2013:p1101:b004:l008","ordinal":161183,"en":"Came from among those I had seen."},{"id":"semetey-1-2013:p1101:b004:l009","ordinal":161184,"en":"If you ask who came after him,"},{"id":"semetey-1-2013:p1101:b004:l010","ordinal":161185,"en":"Wearing a coat called chayingi,"},{"id":"semetey-1-2013:p1101:b004:l011","ordinal":161186,"en":"Riding a horse like Chalkuyruk,"},{"id":"semetey-1-2013:p1101:b004:l012","ordinal":161187,"en":"Carrying a spear without a tassel,"},{"id":"semetey-1-2013:p1101:b004:l013","ordinal":161188,"en":"With only a sword at his side,"},{"id":"semetey-1-2013:p1101:b004:l014","ordinal":161189,"en":"The youngest of nine sons,"},{"id":"semetey-1-2013:p1101:b004:l015","ordinal":161190,"en":"Eleman's cherished son,"},{"id":"semetey-1-2013:p1101:b004:l016","ordinal":161191,"en":"A servant of the one God."},{"id":"semetey-1-2013:p1101:b004:l017","ordinal":161192,"en":"It had been seven years"},{"id":"semetey-1-2013:p1101:b004:l018","ordinal":161193,"en":"Since he descended beneath the earth;"},{"id":"semetey-1-2013:p1101:b004:l019","ordinal":161194,"en":"It had been only seven days"},{"id":"semetey-1-2013:p1101:b004:l020","ordinal":161195,"en":"Since he emerged upon the earth."},{"id":"semetey-1-2013:p1101:b004:l021","ordinal":161196,"en":"When the seven-headed witch"},{"id":"semetey-1-2013:p1101:b004:l022","ordinal":161197,"en":"Worked her perfect spell,"},{"id":"semetey-1-2013:p1101:b004:l023","ordinal":161198,"en":"She frightened his father Eleman."},{"id":"semetey-1-2013:p1101:b004:l024","ordinal":161199,"en":"That old woman imprisoned Eleman"},{"id":"semetey-1-2013:p1101:b004:l025","ordinal":161200,"en":"For seven days,"},{"id":"semetey-1-2013:p1101:b004:l026","ordinal":161201,"en":"Tore out and flung away his beard,"},{"id":"semetey-1-2013:p1101:b004:l027","ordinal":161202,"en":"Yanked out and flung away his mustache,"},{"id":"semetey-1-2013:p1101:b004:l028","ordinal":161203,"en":"And beat him for seven days."},{"id":"semetey-1-2013:p1101:b004:l029","ordinal":161204,"en":"Softened like a worked hide,"},{"id":"semetey-1-2013:p1101:b004:l030","ordinal":161205,"en":"The wretched old man was exhausted."},{"id":"semetey-1-2013:p1101:b004:l031","ordinal":161206,"en":"She took brave Töshtük's knucklebone"},{"id":"semetey-1-2013:p1101:b004:l032","ordinal":161207,"en":"From his daughter-in-law."},{"id":"semetey-1-2013:p1101:b004:l033","ordinal":161208,"en":"Begging for his life, Eleman"},{"id":"semetey-1-2013:p1101:b004:l034","ordinal":161209,"en":"Went before the old woman."},{"id":"semetey-1-2013:p1101:b004:l035","ordinal":161210,"en":"Because his knucklebone had been left behind,"},{"id":"semetey-1-2013:p1101:b004:l036","ordinal":161211,"en":"Eleman's brave Töshtük"},{"id":"semetey-1-2013:p1101:b004:l037","ordinal":161212,"en":"Came the following day."},{"id":"semetey-1-2013:p1101:b004:l038","ordinal":161213,"en":"Beside that knucklebone,"},{"id":"semetey-1-2013:p1101:b004:l039","ordinal":161214,"en":"The seven-headed old woman saw him."},{"id":"semetey-1-2013:p1102:b003:l001","ordinal":161215,"en":"When she saw brave Töshtük,"},{"id":"semetey-1-2013:p1102:b003:l002","ordinal":161216,"en":"The old woman neighed,"},{"id":"semetey-1-2013:p1102:b003:l003","ordinal":161217,"en":"“Reap, my reaper, reap!”"},{"id":"semetey-1-2013:p1102:b003:l004","ordinal":161218,"en":"And made ready to reap him down."},{"id":"semetey-1-2013:p1102:b003:l005","ordinal":161219,"en":"Giving him no choice,"},{"id":"semetey-1-2013:p1102:b003:l006","ordinal":161220,"en":"The Töshtük who had come—"},{"id":"semetey-1-2013:p1102:b003:l007","ordinal":161221,"en":"She made ready to suck him dry."},{"id":"semetey-1-2013:p1102:b003:l008","ordinal":161222,"en":"The old woman grew wrathful"},{"id":"semetey-1-2013:p1102:b003:l009","ordinal":161223,"en":"And made ready to imprison him."},{"id":"semetey-1-2013:p1102:b003:l010","ordinal":161224,"en":"She made ready to beat Töshtük"},{"id":"semetey-1-2013:p1102:b003:l011","ordinal":161225,"en":"With resounding blows."},{"id":"semetey-1-2013:p1102:b003:l012","ordinal":161226,"en":"Unable to withstand her strength,"},{"id":"semetey-1-2013:p1102:b003:l013","ordinal":161227,"en":"Dear Töshtük grew alarmed."},{"id":"semetey-1-2013:p1102:b003:l014","ordinal":161228,"en":"He whipped Chalkuyruk beneath him"},{"id":"semetey-1-2013:p1102:b003:l015","ordinal":161229,"en":"This way and that,"},{"id":"semetey-1-2013:p1102:b003:l016","ordinal":161230,"en":"Spurring him on both sides."},{"id":"semetey-1-2013:p1102:b003:l017","ordinal":161231,"en":"Brave Töshtük fled at a gallop"},{"id":"semetey-1-2013:p1102:b003:l018","ordinal":161232,"en":"And reached Zhelpinish."},{"id":"semetey-1-2013:p1102:b003:l019","ordinal":161233,"en":"In fear, he fled down"},{"id":"semetey-1-2013:p1102:b003:l020","ordinal":161234,"en":"Beneath the earth."},{"id":"semetey-1-2013:p1102:b003:l021","ordinal":161235,"en":"Among the people beneath the earth,"},{"id":"semetey-1-2013:p1102:b003:l022","ordinal":161236,"en":"He came to know many."},{"id":"semetey-1-2013:p1102:b003:l023","ordinal":161237,"en":"Brave Töshtük suffered torment"},{"id":"semetey-1-2013:p1102:b003:l024","ordinal":161238,"en":"And spent seven years there."},{"id":"semetey-1-2013:p1102:b003:l025","ordinal":161239,"en":"It had been about seven days"},{"id":"semetey-1-2013:p1102:b003:l026","ordinal":161240,"en":"Since that Töshtük came"},{"id":"semetey-1-2013:p1102:b003:l027","ordinal":161241,"en":"To Kökötöy's memorial feast."},{"id":"semetey-1-2013:p1102:b003:l028","ordinal":161242,"en":"Since he emerged from beneath the earth,"},{"id":"semetey-1-2013:p1102:b003:l029","ordinal":161243,"en":"Seven days had now passed."},{"id":"semetey-1-2013:p1102:b003:l030","ordinal":161244,"en":"The giants Koshoy and Töshtük were there;"},{"id":"semetey-1-2013:p1102:b003:l031","ordinal":161245,"en":"Brave Koshoy, a master of wisdom,"},{"id":"semetey-1-2013:p1102:b003:l032","ordinal":161246,"en":"Had then come to Karkyra."},{"id":"semetey-1-2013:p1102:b003:l033","ordinal":161247,"en":"Kökötöy's son Bokmurun"},{"id":"semetey-1-2013:p1102:b003:l034","ordinal":161248,"en":"Had tethered the horses in the Sart manner."},{"id":"semetey-1-2013:p1102:b003:l035","ordinal":161249,"en":"For honored guests such as these,"},{"id":"semetey-1-2013:p1102:b003:l036","ordinal":161250,"en":"He boiled the meat of barren yearlings"},{"id":"semetey-1-2013:p1102:b003:l037","ordinal":161251,"en":"In the cooking pits."},{"id":"semetey-1-2013:p1102:b003:l038","ordinal":161252,"en":"He spread out in full"},{"id":"semetey-1-2013:p1102:b003:l039","ordinal":161253,"en":"Every delight of the broad world."},{"id":"semetey-1-2013:p1102:b004:l001","ordinal":161254,"en":"These were Bokmurun's words:"},{"id":"semetey-1-2013:p1102:b004:l002","ordinal":161255,"en":"“From all the mighty giants"},{"id":"semetey-1-2013:p1102:b004:l003","ordinal":161256,"en":"This is the place where I seek counsel."},{"id":"semetey-1-2013:p1102:b004:l004","ordinal":161257,"en":"The giants Koshoy and Töshtük are here;"},{"id":"semetey-1-2013:p1102:b004:l005","ordinal":161258,"en":"I have no grievance against God,"},{"id":"semetey-1-2013:p1102:b004:l006","ordinal":161259,"en":"For at my dear father's feast"},{"id":"semetey-1-2013:p1102:b004:l007","ordinal":161260,"en":"There are men enough to oversee it."},{"id":"semetey-1-2013:p1102:b004:l008","ordinal":161261,"en":"Bokmurun has the might"},{"id":"semetey-1-2013:p1102:b004:l009","ordinal":161262,"en":"To surround the four corners"},{"id":"semetey-1-2013:p1102:b004:l010","ordinal":161263,"en":"Of the whole world four times."},{"id":"semetey-1-2013:p1102:b004:l011","ordinal":161264,"en":"My father has four kinds of livestock,"},{"id":"semetey-1-2013:p1102:b004:l012","ordinal":161265,"en":"Spreading like ants,"},{"id":"semetey-1-2013:p1102:b004:l013","ordinal":161266,"en":"For us to slaughter."},{"id":"semetey-1-2013:p1102:b004:l014","ordinal":161267,"en":"I seek the counsel of your people,"},{"id":"semetey-1-2013:p1102:b004:l015","ordinal":161268,"en":"Uncle Koshoy, Baymyrza,"},{"id":"semetey-1-2013:p1102:b004:l016","ordinal":161269,"en":"And all of you gathered here."},{"id":"semetey-1-2013:p1102:b004:l017","ordinal":161270,"en":"These are the words of counsel I give:"},{"id":"semetey-1-2013:p1102:b004:l018","ordinal":161271,"en":"I will strike the Koroson fire-steel;"},{"id":"semetey-1-2013:p1102:b004:l019","ordinal":161272,"en":"I will invite every one,"},{"id":"semetey-1-2013:p1102:b004:l020","ordinal":161273,"en":"Infidel and Muslim alike."},{"id":"semetey-1-2013:p1102:b004:l021","ordinal":161274,"en":"Of the red-collared Chinese,"},{"id":"semetey-1-2013:p1102:b004:l022","ordinal":161275,"en":"Let not even the least remain;"},{"id":"semetey-1-2013:p1102:b004:l023","ordinal":161276,"en":"Of the black-collared Kalmyks,"},{"id":"semetey-1-2013:p1102:b004:l024","ordinal":161277,"en":"Let not one among their people remain."},{"id":"semetey-1-2013:p1102:b004:l025","ordinal":161278,"en":"From the Shibee and Soloon,"},{"id":"semetey-1-2013:p1102:b004:l026","ordinal":161279,"en":"From the Tyrgoot and Manchu,"},{"id":"semetey-1-2013:p1102:b004:l027","ordinal":161280,"en":"Let not a single one remain behind."}]
