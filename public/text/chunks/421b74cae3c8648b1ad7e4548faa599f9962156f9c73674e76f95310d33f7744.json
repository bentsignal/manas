[{"id":"semetey-1-2013:p0265:b003:l015","ordinal":97025,"en":"A lion taking after his father.”"},{"id":"semetey-1-2013:p0265:b003:l016","ordinal":97026,"en":"Pleased, saying this,"},{"id":"semetey-1-2013:p0265:b003:l017","ordinal":97027,"en":"The wrestlers praised him."},{"id":"semetey-1-2013:p0265:b003:l018","ordinal":97028,"en":"Taytoru's many prizes,"},{"id":"semetey-1-2013:p0265:b003:l019","ordinal":97029,"en":"The wrestlers shared them out."},{"id":"semetey-1-2013:p0265:b003:l020","ordinal":97030,"en":"All the wrestlers,"},{"id":"semetey-1-2013:p0265:b003:l021","ordinal":97031,"en":"Their hearts lay calm as ashes."},{"id":"semetey-1-2013:p0265:b003:l022","ordinal":97032,"en":"In the city of Bukhara,"},{"id":"semetey-1-2013:p0265:b003:l023","ordinal":97033,"en":"All the wrestlers"},{"id":"semetey-1-2013:p0265:b003:l024","ordinal":97034,"en":"Were wealthy among the whole people."},{"id":"semetey-1-2013:p0265:b003:l025","ordinal":97035,"en":"Growing up as an orphan,"},{"id":"semetey-1-2013:p0265:b003:l026","ordinal":97036,"en":"Thus joining the ranks,"},{"id":"semetey-1-2013:p0265:b003:l027","ordinal":97037,"en":"All misfortunes scattered away,"},{"id":"semetey-1-2013:p0265:b003:l029","ordinal":97038,"en":"Temir Khan in Bukhara","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0265:b003:l030","ordinal":97039,"en":"Gave a stern command."},{"id":"semetey-1-2013:p0265:b003:l031","ordinal":97040,"en":"His father's sovereignty,"},{"id":"semetey-1-2013:p0265:b003:l032","ordinal":97041,"en":"At twelve, Semetey"},{"id":"semetey-1-2013:p0265:b003:l033","ordinal":97042,"en":"Took wholly into his hands."},{"id":"semetey-1-2013:p0265:b003:l034","ordinal":97043,"en":"When his son mounted the throne,"},{"id":"semetey-1-2013:p0265:b003:l035","ordinal":97044,"en":"Sparing nothing he possessed,"},{"id":"semetey-1-2013:p0265:b003:l036","ordinal":97045,"en":"He gave a stern command."},{"id":"semetey-1-2013:p0265:b003:l037","ordinal":97046,"en":"The eight khans who came to Bukhara,"},{"id":"semetey-1-2013:p0265:b003:l038","ordinal":97047,"en":"He gathered every one, leaving none out."},{"id":"semetey-1-2013:p0265:b003:l039","ordinal":97048,"en":"“Baabedin!” he shouted."},{"id":"semetey-1-2013:p0265:b005:l001","ordinal":97049,"en":"Unable to contain his joy, the poor fellow"},{"id":"semetey-1-2013:p0265:b005:l002","ordinal":97050,"en":"Called all his people."},{"id":"semetey-1-2013:p0265:b005:l003","ordinal":97051,"en":"His many thoughts would not fit in his breast."},{"id":"semetey-1-2013:p0265:b005:l004","ordinal":97052,"en":"When many people came together,"},{"id":"semetey-1-2013:p0265:b005:l005","ordinal":97053,"en":"His grandfather Temir Khan,"},{"id":"semetey-1-2013:p0265:b005:l006","ordinal":97054,"en":"His tears streamed in ten directions."},{"id":"semetey-1-2013:p0265:b005:l007","ordinal":97055,"en":"To the four corners of the world,"},{"id":"semetey-1-2013:p0265:b005:l008","ordinal":97056,"en":"His wealth gave him the means."},{"id":"semetey-1-2013:p0265:b005:l009","ordinal":97057,"en":"To Temir Khan's city,"},{"id":"semetey-1-2013:p0265:b005:l010","ordinal":97058,"en":"When his daughter came wandering,"},{"id":"semetey-1-2013:p0265:b005:l011","ordinal":97059,"en":"This was the child he had raised."},{"id":"semetey-1-2013:p0265:b005:l012","ordinal":97060,"en":"If he did not see him for three days,"},{"id":"semetey-1-2013:p0265:b005:l013","ordinal":97061,"en":"He languished with longing, pleading,"},{"id":"semetey-1-2013:p0265:b005:l014","ordinal":97062,"en":"Devoting all his attention to him."},{"id":"semetey-1-2013:p0265:b005:l015","ordinal":97063,"en":"Semetey at twelve,"},{"id":"semetey-1-2013:p0265:b005:l016","ordinal":97064,"en":"Moreover, Temir Khan"},{"id":"semetey-1-2013:p0265:b005:l017","ordinal":97065,"en":"Held as dear as his faith."},{"id":"semetey-1-2013:p0265:b005:l018","ordinal":97066,"en":"When his son mounted the throne,"},{"id":"semetey-1-2013:p0265:b005:l019","ordinal":97067,"en":"Unable to contain his joy, Temir Khan"},{"id":"semetey-1-2013:p0265:b005:l020","ordinal":97068,"en":"Shouted fiercely."},{"id":"semetey-1-2013:p0265:b005:l021","ordinal":97069,"en":"The eight khans who came to Bukhara,"},{"id":"semetey-1-2013:p0265:b005:l022","ordinal":97070,"en":"Gathering them all then,"},{"id":"semetey-1-2013:p0265:b005:l023","ordinal":97071,"en":"He proclaimed to his people:"},{"id":"semetey-1-2013:p0265:b005:l024","ordinal":97072,"en":"“My dear eight khans,"},{"id":"semetey-1-2013:p0265:b005:l025","ordinal":97073,"en":"Now God has granted my wish."},{"id":"semetey-1-2013:p0265:b005:l026","ordinal":97074,"en":"This Semetey here"},{"id":"semetey-1-2013:p0265:b005:l027","ordinal":97075,"en":"Has turned twelve this year!"},{"id":"semetey-1-2013:p0265:b005:l028","ordinal":97076,"en":"When my son mounts the throne,"},{"id":"semetey-1-2013:p0265:b005:l029","ordinal":97077,"en":"How could I begrudge my livestock?"},{"id":"semetey-1-2013:p0265:b005:l030","ordinal":97078,"en":"Not merely my livestock—for my son,"},{"id":"semetey-1-2013:p0265:b005:l031","ordinal":97079,"en":"How could I begrudge my life?"},{"id":"semetey-1-2013:p0265:b005:l032","ordinal":97080,"en":"The golden throne beneath me,"},{"id":"semetey-1-2013:p0265:b005:l033","ordinal":97081,"en":"How could I begrudge my seat?"},{"id":"semetey-1-2013:p0265:b005:l034","ordinal":97082,"en":"This Semetey here—"},{"id":"semetey-1-2013:p0265:b005:l035","ordinal":97083,"en":"Now God has granted my wish."},{"id":"semetey-1-2013:p0265:b005:l036","ordinal":97084,"en":"He has reached twelve years of age!"},{"id":"semetey-1-2013:p0265:b005:l037","ordinal":97085,"en":"Let your white-bearded elders come."},{"id":"semetey-1-2013:p0265:b005:l038","ordinal":97086,"en":"By your father's grave, eight khans,"},{"id":"semetey-1-2013:p0265:b005:l039","ordinal":97087,"en":"Every one of you come, leaving none behind!"},{"id":"semetey-1-2013:p0266:b003:l001","ordinal":97088,"en":"Let your skilled spearmen come,"},{"id":"semetey-1-2013:p0266:b003:l002","ordinal":97089,"en":"Let your merciless champions come,"},{"id":"semetey-1-2013:p0266:b003:l003","ordinal":97090,"en":"Let your swift runners and heroes come,"},{"id":"semetey-1-2013:p0266:b003:l004","ordinal":97091,"en":"Let your beks who find sound reasons come."},{"id":"semetey-1-2013:p0266:b003:l005","ordinal":97092,"en":"Let me tell my sorrow!"},{"id":"semetey-1-2013:p0266:b003:l006","ordinal":97093,"en":"My father was a khan before me."},{"id":"semetey-1-2013:p0266:b003:l007","ordinal":97094,"en":"I became khan of Bukhara"},{"id":"semetey-1-2013:p0266:b003:l008","ordinal":97095,"en":"At precisely sixteen years of age."},{"id":"semetey-1-2013:p0266:b003:l009","ordinal":97096,"en":"Taking a wife and keeping a household,"},{"id":"semetey-1-2013:p0266:b003:l010","ordinal":97097,"en":"Hanging steel at the side of my home,"},{"id":"semetey-1-2013:p0266:b003:l011","ordinal":97098,"en":"Governing the people,"},{"id":"semetey-1-2013:p0266:b003:l012","ordinal":97099,"en":"I had twelve daughters in succession,"},{"id":"semetey-1-2013:p0266:b003:l013","ordinal":97100,"en":"The thirteenth was Kanykey."},{"id":"semetey-1-2013:p0266:b003:l014","ordinal":97101,"en":"For many years I was khan;"},{"id":"semetey-1-2013:p0266:b003:l015","ordinal":97102,"en":"For a son to savor life with,"},{"id":"semetey-1-2013:p0266:b003:l016","ordinal":97103,"en":"My poor head longed."},{"id":"semetey-1-2013:p0266:b003:l017","ordinal":97104,"en":"Setting out from Bukhara,"},{"id":"semetey-1-2013:p0266:b003:l018","ordinal":97105,"en":"I received a letter from the caliph."},{"id":"semetey-1-2013:p0266:b003:l019","ordinal":97106,"en":"In the desert of Mediyan,"},{"id":"semetey-1-2013:p0266:b003:l021","ordinal":97107,"en":"Coming to Bukhara and praying,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0266:b003:l022","ordinal":97108,"en":"I devoted my thoughts to this."},{"id":"semetey-1-2013:p0266:b003:l023","ordinal":97109,"en":"After thirteen daughters,"},{"id":"semetey-1-2013:p0266:b003:l024","ordinal":97110,"en":"I had my son Ismayyl."},{"id":"semetey-1-2013:p0266:b003:l025","ordinal":97111,"en":"People, rejoice at my words!"},{"id":"semetey-1-2013:p0266:b003:l026","ordinal":97112,"en":"This Semetey here,"},{"id":"semetey-1-2013:p0266:b003:l027","ordinal":97113,"en":"Born of Ismayyl,"},{"id":"semetey-1-2013:p0266:b003:l028","ordinal":97114,"en":"Is my very own grandson."},{"id":"semetey-1-2013:p0266:b003:l029","ordinal":97115,"en":"When my only one mounts the throne,"},{"id":"semetey-1-2013:p0266:b003:l030","ordinal":97116,"en":"I shall not spare my life a hair's breadth."},{"id":"semetey-1-2013:p0266:b003:l031","ordinal":97117,"en":"My treasury of four kinds of livestock,"},{"id":"semetey-1-2013:p0266:b003:l032","ordinal":97118,"en":"I shall not spare my beasts a hair's breadth."},{"id":"semetey-1-2013:p0266:b003:l033","ordinal":97119,"en":"I offer my golden throne as a prize."},{"id":"semetey-1-2013:p0266:b003:l034","ordinal":97120,"en":"I offer together with it"},{"id":"semetey-1-2013:p0266:b003:l035","ordinal":97121,"en":"This city of mine, gated Bukhara."},{"id":"semetey-1-2013:p0266:b003:l036","ordinal":97122,"en":"Eight houses filled with treasure,"},{"id":"semetey-1-2013:p0266:b003:l037","ordinal":97123,"en":"Let me hack their entrances open."},{"id":"semetey-1-2013:p0266:b003:l038","ordinal":97124,"en":"All the wealth I have stored,"},{"id":"semetey-1-2013:p0266:b003:l039","ordinal":97125,"en":"Let me spend and scatter it."},{"id":"semetey-1-2013:p0266:b004:l001","ordinal":97126,"en":"If these prizes prove too little,"},{"id":"semetey-1-2013:p0266:b004:l002","ordinal":97127,"en":"Offer the hoe-working Tajik people."},{"id":"semetey-1-2013:p0266:b004:l004","ordinal":97128,"en":"Cut my beard and offer me.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0266:b004:l005","ordinal":97129,"en":"At this son's feast,"},{"id":"semetey-1-2013:p0266:b004:l006","ordinal":97130,"en":"May I come to no good if I so much as grumble!"},{"id":"semetey-1-2013:p0266:b004:l007","ordinal":97131,"en":"If I say this or that,"},{"id":"semetey-1-2013:p0266:b004:l008","ordinal":97132,"en":"May I no longer be a Muslim!"},{"id":"semetey-1-2013:p0266:b004:l009","ordinal":97133,"en":"Without a post to tie a horse,"},{"id":"semetey-1-2013:p0266:b004:l010","ordinal":97134,"en":"May I pass away utterly bare."},{"id":"semetey-1-2013:p0266:b004:l011","ordinal":97135,"en":"If I make my command into two,"},{"id":"semetey-1-2013:p0266:b004:l012","ordinal":97136,"en":"If I wriggle out and cause a quarrel,"},{"id":"semetey-1-2013:p0266:b004:l013","ordinal":97137,"en":"May I never come to any good!"},{"id":"semetey-1-2013:p0266:b004:l014","ordinal":97138,"en":"For the people, laughter and diversion,"},{"id":"semetey-1-2013:p0266:b004:l015","ordinal":97139,"en":"Put on merry games."},{"id":"semetey-1-2013:p0266:b004:l016","ordinal":97140,"en":"“At Semetey's feast,"},{"id":"semetey-1-2013:p0266:b004:l017","ordinal":97141,"en":"There was so much wonder,”"},{"id":"semetey-1-2013:p0266:b004:l018","ordinal":97142,"en":"To the old men by the fire,"},{"id":"semetey-1-2013:p0266:b004:l019","ordinal":97143,"en":"To the children at play,"},{"id":"semetey-1-2013:p0266:b004:l020","ordinal":97144,"en":"To the learned khans,"},{"id":"semetey-1-2013:p0266:b004:l021","ordinal":97145,"en":"To those who act the great lord,"},{"id":"semetey-1-2013:p0266:b004:l022","ordinal":97146,"en":"Go tell it without shame."},{"id":"semetey-1-2013:p0266:b004:l023","ordinal":97147,"en":"Let these games be an example."},{"id":"semetey-1-2013:p0266:b004:l024","ordinal":97148,"en":"Put on a true spectacle."},{"id":"semetey-1-2013:p0266:b004:l025","ordinal":97149,"en":"Let one wrestler step out there,"},{"id":"semetey-1-2013:p0266:b004:l026","ordinal":97150,"en":"And one wrestler step out here."},{"id":"semetey-1-2013:p0266:b004:l027","ordinal":97151,"en":"Wrestle fairly,"},{"id":"semetey-1-2013:p0266:b004:l028","ordinal":97152,"en":"Put on a mighty spectacle."},{"id":"semetey-1-2013:p0266:b004:l029","ordinal":97153,"en":"I offer a thousand dark camels,"},{"id":"semetey-1-2013:p0266:b004:l030","ordinal":97154,"en":"A thousand black mares with white blazes."},{"id":"semetey-1-2013:p0266:b004:l031","ordinal":97155,"en":"You who fall, go empty-handed;"},{"id":"semetey-1-2013:p0266:b004:l032","ordinal":97156,"en":"You who throw them, take the prize!”"},{"id":"semetey-1-2013:p0266:b004:l033","ordinal":97157,"en":"On the plain this side of Bukhara,"},{"id":"semetey-1-2013:p0266:b004:l034","ordinal":97158,"en":"The people spoke,"},{"id":"semetey-1-2013:p0266:b004:l035","ordinal":97159,"en":"Putting their words before the gathering,"},{"id":"semetey-1-2013:p0266:b004:l036","ordinal":97160,"en":"Competing in finding answers."},{"id":"semetey-1-2013:p0266:b004:l037","ordinal":97161,"en":"In bustling Bukhara,"},{"id":"semetey-1-2013:p0266:b004:l038","ordinal":97162,"en":"They held an assembly for three days."},{"id":"semetey-1-2013:p0266:b004:l039","ordinal":97163,"en":"Some wrangled and quarreled,"},{"id":"semetey-1-2013:p0267:b003:l001","ordinal":97164,"en":"Standing in council,"},{"id":"semetey-1-2013:p0267:b003:l002","ordinal":97165,"en":"On that plain of broad Bukhara,"},{"id":"semetey-1-2013:p0267:b003:l003","ordinal":97166,"en":"Without a furrow touched by a plow,"},{"id":"semetey-1-2013:p0267:b003:l004","ordinal":97167,"en":"Without a burrow dug by a marmot,"},{"id":"semetey-1-2013:p0267:b003:l005","ordinal":97168,"en":"They prepared a suitable spot."},{"id":"semetey-1-2013:p0267:b003:l006","ordinal":97169,"en":"The wrestlers grappled without holding back."},{"id":"semetey-1-2013:p0267:b003:l007","ordinal":97170,"en":"They went to the wrestling ground."},{"id":"semetey-1-2013:p0267:b003:l008","ordinal":97171,"en":"The Six Cities, the khan of Kokand,"},{"id":"semetey-1-2013:p0267:b003:l009","ordinal":97172,"en":"Andijan above, Margalang,"},{"id":"semetey-1-2013:p0267:b003:l010","ordinal":97173,"en":"Samarkand where stakes were set,"},{"id":"semetey-1-2013:p0267:b003:l011","ordinal":97174,"en":"All the Sarts gathered."},{"id":"semetey-1-2013:p0267:b003:l012","ordinal":97175,"en":"Toobalban came out from Kokand,"},{"id":"semetey-1-2013:p0267:b003:l013","ordinal":97176,"en":"Akbalban came out from Bukhara."},{"id":"semetey-1-2013:p0267:b003:l014","ordinal":97177,"en":"The two wrestlers grappled,"},{"id":"semetey-1-2013:p0267:b003:l015","ordinal":97178,"en":"Standing braced against each other."},{"id":"semetey-1-2013:p0267:b003:l016","ordinal":97179,"en":"The eight khans who came to Bukhara"},{"id":"semetey-1-2013:p0267:b003:l017","ordinal":97180,"en":"Were immersed in the spectacle."},{"id":"semetey-1-2013:p0267:b003:l018","ordinal":97181,"en":"Akbalban and Toobalban"},{"id":"semetey-1-2013:p0267:b003:l019","ordinal":97182,"en":"Knew each other,"},{"id":"semetey-1-2013:p0267:b003:l020","ordinal":97183,"en":"But without a feast on a grand scale,"},{"id":"semetey-1-2013:p0267:b003:l021","ordinal":97184,"en":"They had not managed to meet."},{"id":"semetey-1-2013:p0267:b003:l022","ordinal":97185,"en":"Gnashing like hungry bull camels,"},{"id":"semetey-1-2013:p0267:b003:l023","ordinal":97186,"en":"Grappling without rest for six days,"},{"id":"semetey-1-2013:p0267:b003:l024","ordinal":97187,"en":"Gripping each other's trouser legs,"},{"id":"semetey-1-2013:p0267:b003:l025","ordinal":97188,"en":"Attempting trips here and there,"},{"id":"semetey-1-2013:p0267:b003:l026","ordinal":97189,"en":"Butting like gray bulls,"},{"id":"semetey-1-2013:p0267:b003:l027","ordinal":97190,"en":"Tearing at whatever they could reach,"},{"id":"semetey-1-2013:p0267:b003:l028","ordinal":97191,"en":"When the wrestlers' struggle"},{"id":"semetey-1-2013:p0267:b003:l029","ordinal":97192,"en":"Had lasted six days,"},{"id":"semetey-1-2013:p0267:b003:l030","ordinal":97193,"en":"Bukhara's Akbalban"},{"id":"semetey-1-2013:p0267:b003:l031","ordinal":97194,"en":"Was left without strength."},{"id":"semetey-1-2013:p0267:b003:l032","ordinal":97195,"en":"Kokand's Toobalban"},{"id":"semetey-1-2013:p0267:b003:l033","ordinal":97196,"en":"Lifted and hurled him down."},{"id":"semetey-1-2013:p0267:b003:l034","ordinal":97197,"en":"All the many prizes,"},{"id":"semetey-1-2013:p0267:b003:l035","ordinal":97198,"en":"The Six Cities and the khan of Kokand"},{"id":"semetey-1-2013:p0267:b003:l036","ordinal":97199,"en":"Began scrambling to seize."},{"id":"semetey-1-2013:p0267:b003:l037","ordinal":97200,"en":"Seeing this, Semetey"},{"id":"semetey-1-2013:p0267:b003:l038","ordinal":97201,"en":"Burned inside."},{"id":"semetey-1-2013:p0267:b003:l039","ordinal":97202,"en":"Beyond his gray-maned father Manas,"},{"id":"semetey-1-2013:p0267:b005:l001","ordinal":97203,"en":"He was a hero born to surpass him,"},{"id":"semetey-1-2013:p0267:b005:l002","ordinal":97204,"en":"A lion born a panther,"},{"id":"semetey-1-2013:p0267:b005:l003","ordinal":97205,"en":"Who poured blood into clear water,"},{"id":"semetey-1-2013:p0267:b005:l004","ordinal":97206,"en":"Offspring of the heedless one,"},{"id":"semetey-1-2013:p0267:b005:l005","ordinal":97207,"en":"Who set the grassy earth smoking,"},{"id":"semetey-1-2013:p0267:b005:l007","ordinal":97208,"en":"Driving and chasing white deer,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0267:b005:l008","ordinal":97209,"en":"Offspring of one who turned them into cattle,"},{"id":"semetey-1-2013:p0267:b005:l009","ordinal":97210,"en":"All the whole world,"},{"id":"semetey-1-2013:p0267:b005:l010","ordinal":97211,"en":"Offspring of one who threw it into turmoil,"},{"id":"semetey-1-2013:p0267:b005:l011","ordinal":97212,"en":"Driving gray deer and making them cattle,"},{"id":"semetey-1-2013:p0267:b005:l012","ordinal":97213,"en":"Throwing every place he saw into turmoil,"},{"id":"semetey-1-2013:p0267:b005:l013","ordinal":97214,"en":"Taking it as a matter of honor, eyes blazing,"},{"id":"semetey-1-2013:p0267:b005:l014","ordinal":97215,"en":"His dear teeth broad as gates,"},{"id":"semetey-1-2013:p0267:b005:l015","ordinal":97216,"en":"Clenching them hard till they cracked,"},{"id":"semetey-1-2013:p0267:b005:l016","ordinal":97217,"en":"His eyes blazing like a lion's,"},{"id":"semetey-1-2013:p0267:b005:l017","ordinal":97218,"en":"Flame hissing from his mouth,"},{"id":"semetey-1-2013:p0267:b005:l018","ordinal":97219,"en":"His teeth cracking when he clenched them,"},{"id":"semetey-1-2013:p0267:b005:l019","ordinal":97220,"en":"Semetey felt deeply ashamed,"},{"id":"semetey-1-2013:p0267:b005:l020","ordinal":97221,"en":"As though his honor had been lost:"},{"id":"semetey-1-2013:p0267:b005:l021","ordinal":97222,"en":"“Bukhara's wrestler,"},{"id":"semetey-1-2013:p0267:b005:l022","ordinal":97223,"en":"Kokand's Toobalban—"},{"id":"semetey-1-2013:p0267:b005:l023","ordinal":97224,"en":"What is this, that he should throw him?"},{"id":"semetey-1-2013:p0267:b005:l024","ordinal":97225,"en":"Bukhara's burning tree,"},{"id":"semetey-1-2013:p0267:b005:l025","ordinal":97226,"en":"What is this, that it should break?"},{"id":"semetey-1-2013:p0267:b005:l026","ordinal":97227,"en":"All the many prizes—the Six Cities,"},{"id":"semetey-1-2013:p0267:b005:l027","ordinal":97228,"en":"What is this, that they should take them?"},{"id":"semetey-1-2013:p0267:b005:l028","ordinal":97229,"en":"Their spirit broken, distraught,"},{"id":"semetey-1-2013:p0267:b005:l029","ordinal":97230,"en":"All the people of Bukhara,"},{"id":"semetey-1-2013:p0267:b005:l030","ordinal":97231,"en":"What is this, that they should be left so?"},{"id":"semetey-1-2013:p0267:b005:l031","ordinal":97232,"en":"Good heavens, how could I make Toobalban a giant,"},{"id":"semetey-1-2013:p0267:b005:l033","ordinal":97233,"en":"When my father has grown old,"},{"id":"semetey-1-2013:p0267:b005:l034","ordinal":97234,"en":"Letting his golden throne be taken,"},{"id":"semetey-1-2013:p0267:b005:l035","ordinal":97235,"en":"How could I make him master of Bukhara?"},{"id":"semetey-1-2013:p0267:b005:l036","ordinal":97236,"en":"Like Temir, the khan I rely upon,"},{"id":"semetey-1-2013:p0267:b005:l037","ordinal":97237,"en":"Bukhara's golden throne,"},{"id":"semetey-1-2013:p0267:b005:l038","ordinal":97238,"en":"Having thrown its wrestler,"},{"id":"semetey-1-2013:p0267:b005:l039","ordinal":97239,"en":"Without letting him say, ‘I seized it,’—"},{"id":"semetey-1-2013:p0268:b003:l001","ordinal":97240,"en":"Whose honor has been broken?"},{"id":"semetey-1-2013:p0268:b003:l002","ordinal":97241,"en":"Whose bones are aching?"},{"id":"semetey-1-2013:p0268:b003:l003","ordinal":97242,"en":"Let me die before I see this!"},{"id":"semetey-1-2013:p0268:b003:l004","ordinal":97243,"en":"Rather than live like this,"},{"id":"semetey-1-2013:p0268:b003:l005","ordinal":97244,"en":"Let me sink away as though never born!"},{"id":"semetey-1-2013:p0268:b003:l006","ordinal":97245,"en":"What has been written on my forehead,"},{"id":"semetey-1-2013:p0268:b003:l007","ordinal":97246,"en":"Let me bear it upon my neck."},{"id":"semetey-1-2013:p0268:b003:l008","ordinal":97247,"en":"Seven houses filled with much gold,"},{"id":"semetey-1-2013:p0268:b003:l009","ordinal":97248,"en":"To those there in Margalang,"},{"id":"semetey-1-2013:p0268:b003:l010","ordinal":97249,"en":"How could I give it to the Sarts?"},{"id":"semetey-1-2013:p0268:b003:l011","ordinal":97250,"en":"The wealth I hold,"},{"id":"semetey-1-2013:p0268:b003:l012","ordinal":97251,"en":"Offering it all as a stake,"},{"id":"semetey-1-2013:p0268:b003:l013","ordinal":97252,"en":"With this Toobalban here,"},{"id":"semetey-1-2013:p0268:b003:l014","ordinal":97253,"en":"Let me try wrestling once."},{"id":"semetey-1-2013:p0268:b003:l015","ordinal":97254,"en":"If the Almighty has written my death,"},{"id":"semetey-1-2013:p0268:b003:l016","ordinal":97255,"en":"Let me die at Toobalban's hands."},{"id":"semetey-1-2013:p0268:b003:l017","ordinal":97256,"en":"Otherwise, with this Toobalban here,"},{"id":"semetey-1-2013:p0268:b003:l018","ordinal":97257,"en":"Let me have a wrestling bout."},{"id":"semetey-1-2013:p0268:b003:l019","ordinal":97258,"en":"If I throw Toobalban,"},{"id":"semetey-1-2013:p0268:b003:l020","ordinal":97259,"en":"Let me tear out his arm!”"},{"id":"semetey-1-2013:p0268:b003:l021","ordinal":97260,"en":"So saying then,"},{"id":"semetey-1-2013:p0268:b003:l022","ordinal":97261,"en":"Semetey came down shouting,"},{"id":"semetey-1-2013:p0268:b003:l023","ordinal":97262,"en":"Calling, “Toobalban!”"},{"id":"semetey-1-2013:p0268:b003:l024","ordinal":97263,"en":"“By your father's grave, Toobalban,"},{"id":"semetey-1-2013:p0268:b003:l025","ordinal":97264,"en":"Turn your neck this way a moment."},{"id":"semetey-1-2013:p0268:b003:l026","ordinal":97265,"en":"I shall wrestle; wait a moment!"},{"id":"semetey-1-2013:p0268:b003:l027","ordinal":97266,"en":"Throw me too before you leave,"},{"id":"semetey-1-2013:p0268:b003:l028","ordinal":97267,"en":"Sate yourself with abundant booty!”"},{"id":"semetey-1-2013:p0268:b003:l029","ordinal":97268,"en":"Saying this in anger,"},{"id":"semetey-1-2013:p0268:b003:l030","ordinal":97269,"en":"His knees bending as he stepped,"},{"id":"semetey-1-2013:p0268:b003:l031","ordinal":97270,"en":"He ran toward Toobalban."},{"id":"semetey-1-2013:p0268:b003:l032","ordinal":97271,"en":"He meant to draw the line."},{"id":"semetey-1-2013:p0268:b003:l033","ordinal":97272,"en":"He meant to start a disturbance."},{"id":"semetey-1-2013:p0268:b003:l034","ordinal":97273,"en":"The brave orphan left by Manas"},{"id":"semetey-1-2013:p0268:b003:l035","ordinal":97274,"en":"Meant to make a spectacle."},{"id":"semetey-1-2013:p0268:b003:l036","ordinal":97275,"en":"Seeing the boy,"},{"id":"semetey-1-2013:p0268:b003:l037","ordinal":97276,"en":"Ismayyl, whom he called father,"},{"id":"semetey-1-2013:p0268:b003:l038","ordinal":97277,"en":"Was troubled in his thoughts too."},{"id":"semetey-1-2013:p0268:b003:l039","ordinal":97278,"en":"He ran up and seized"},{"id":"semetey-1-2013:p0268:b004:l001","ordinal":97279,"en":"The boy, brave Semetey."},{"id":"semetey-1-2013:p0268:b004:l002","ordinal":97280,"en":"Startled, he spoke:"}]
