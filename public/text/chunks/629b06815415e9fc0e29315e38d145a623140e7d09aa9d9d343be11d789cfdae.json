[{"id":"manas-2010:p0326:b001:l019","ordinal":14849,"en":"Your bastard Burut"},{"id":"manas-2010:p0326:b001:l020","ordinal":14850,"en":"Made blood run like water."},{"id":"manas-2010:p0326:b001:l021","ordinal":14851,"en":"For the people of Kakan-Chin"},{"id":"manas-2010:p0326:b001:l022","ordinal":14852,"en":"He raised a great, costly uproar."},{"id":"manas-2010:p0326:b001:l023","ordinal":14853,"en":"He checked the wrestlers."},{"id":"manas-2010:p0326:b001:l024","ordinal":14854,"en":"Not leaving those who provoked him alone,"},{"id":"manas-2010:p0326:b001:l025","ordinal":14855,"en":"He burned them all alike."},{"id":"manas-2010:p0326:b001:l026","ordinal":14856,"en":"Your Torgut were swept away entirely."},{"id":"manas-2010:p0326:b001:l027","ordinal":14857,"en":"By that bastard Burut,"},{"id":"manas-2010:p0326:b001:l028","ordinal":14858,"en":"The men who went were slaughtered."},{"id":"manas-2010:p0326:b001:l029","ordinal":14859,"en":"Those with forelocks provoked him;"},{"id":"manas-2010:p0326:b001:l030","ordinal":14860,"en":"He began exceeding torment."},{"id":"manas-2010:p0326:b001:l031","ordinal":14861,"en":"The champions with red tassels,"},{"id":"manas-2010:p0326:b001:l032","ordinal":14862,"en":"He slaughtered them!"},{"id":"manas-2010:p0326:b001:l033","ordinal":14863,"en":"Wrestler Döngö died too."},{"id":"manas-2010:p0326:b001:l034","ordinal":14864,"en":"By that bastard Burut,"},{"id":"manas-2010:p0326:b001:l035","ordinal":14865,"en":"All the souls who went died."},{"id":"manas-2010:p0326:b001:l036","ordinal":14866,"en":"Vulture-tailed giant Zhoon,"},{"id":"manas-2010:p0326:b001:l037","ordinal":14867,"en":"Scissor-eared giant Kaman,"},{"id":"manas-2010:p0326:b001:l038","ordinal":14868,"en":"Kochku provoked him and died too."},{"id":"manas-2010:p0326:b001:l039","ordinal":14869,"en":"You are a great ruler, Esenkan;"},{"id":"manas-2010:p0326:b001:l040","ordinal":14870,"en":"I stand ashamed,"},{"id":"manas-2010:p0326:b001:l041","ordinal":14871,"en":"All of these died."},{"id":"manas-2010:p0326:b001:l042","ordinal":14872,"en":"Entering alone to attack,"},{"id":"manas-2010:p0326:b001:l043","ordinal":14873,"en":"He began terrible suffering."},{"id":"manas-2010:p0326:b001:l044","ordinal":14874,"en":"Wrestlers like cliffs and camels,"},{"id":"manas-2010:p0326:b001:l045","ordinal":14875,"en":"That Burut, may his soul depart,"},{"id":"manas-2010:p0326:b001:l046","ordinal":14876,"en":"He slaughtered them all."},{"id":"manas-2010:p0326:b001:l047","ordinal":14877,"en":"The wrestler khan who came died;"},{"id":"manas-2010:p0326:b001:l048","ordinal":14878,"en":"By that bloodthirsty Burut,"},{"id":"manas-2010:p0327:b001:l001","ordinal":14879,"en":"All who encountered him died!"},{"id":"manas-2010:p0327:b001:l002","ordinal":14880,"en":"He seized those who provoked him."},{"id":"manas-2010:p0327:b001:l003","ordinal":14881,"en":"By that Burut of hardened fortune,"},{"id":"manas-2010:p0327:b001:l004","ordinal":14882,"en":"None who fought him survived."},{"id":"manas-2010:p0327:b001:l005","ordinal":14883,"en":"All those he met,"},{"id":"manas-2010:p0327:b001:l006","ordinal":14884,"en":"He drove away destitute!"},{"id":"manas-2010:p0327:b001:l007","ordinal":14885,"en":"He left your forelocked men bereft."},{"id":"manas-2010:p0327:b001:l008","ordinal":14886,"en":"The wrestler in whom you trusted,"},{"id":"manas-2010:p0327:b001:l009","ordinal":14887,"en":"With one blow he made ashes!"},{"id":"manas-2010:p0327:b001:l010","ordinal":14888,"en":"Passing through seven days without respite,"},{"id":"manas-2010:p0327:b001:l011","ordinal":14889,"en":"Wounded in seventy places,"},{"id":"manas-2010:p0327:b001:l012","ordinal":14890,"en":"With his whole head split open,"},{"id":"manas-2010:p0327:b001:l013","ordinal":14891,"en":"Having lost all his wrestlers,"},{"id":"manas-2010:p0327:b001:l014","ordinal":14892,"en":"He lost his wits,"},{"id":"manas-2010:p0327:b001:l015","ordinal":14893,"en":"Your trusted wrestler Zholoy."},{"id":"manas-2010:p0327:b001:l016","ordinal":14894,"en":"Groaning and leaning for support,"},{"id":"manas-2010:p0327:b001:l017","ordinal":14895,"en":"Wrapped in nothing but blood,"},{"id":"manas-2010:p0327:b001:l018","ordinal":14896,"en":"Hurrying and stumbling in panic,"},{"id":"manas-2010:p0327:b001:l019","ordinal":14897,"en":"He was about to be overcome."},{"id":"manas-2010:p0327:b001:l020","ordinal":14898,"en":"He went away wounded,"},{"id":"manas-2010:p0327:b001:l021","ordinal":14899,"en":"With no strength even to stir,"},{"id":"manas-2010:p0327:b001:l022","ordinal":14900,"en":"Black blood draining from his body."},{"id":"manas-2010:p0327:b001:l023","ordinal":14901,"en":"Having his many young men slaughtered,"},{"id":"manas-2010:p0327:b001:l024","ordinal":14902,"en":"His own possessions, brave Zholoy"},{"id":"manas-2010:p0327:b001:l025","ordinal":14903,"en":"Scattered and came back, I heard."},{"id":"manas-2010:p0327:b001:l026","ordinal":14904,"en":"When he was about to die,"},{"id":"manas-2010:p0327:b001:l027","ordinal":14905,"en":"He conjured foul weather,"},{"id":"manas-2010:p0327:b001:l028","ordinal":14906,"en":"And fled back, I heard!"},{"id":"manas-2010:p0327:b001:l029","ordinal":14907,"en":"Having his heroes slaughtered,"},{"id":"manas-2010:p0327:b001:l030","ordinal":14908,"en":"He came back in a wretched state, I heard!"},{"id":"manas-2010:p0327:b001:l031","ordinal":14909,"en":"Having his wrestlers slaughtered,"},{"id":"manas-2010:p0327:b001:l032","ordinal":14910,"en":"He barely came back, I heard!"},{"id":"manas-2010:p0327:b001:l033","ordinal":14911,"en":"I saw the Burut myself."},{"id":"manas-2010:p0327:b001:l034","ordinal":14912,"en":"There is no strength to clash with him,"},{"id":"manas-2010:p0327:b001:l035","ordinal":14913,"en":"No means to grapple with him!"},{"id":"manas-2010:p0327:b001:l036","ordinal":14914,"en":"Can a mortal go and face him?"},{"id":"manas-2010:p0327:b001:l037","ordinal":14915,"en":"Against that bastard Burut,"},{"id":"manas-2010:p0327:b001:l038","ordinal":14916,"en":"Can anyone who faces him stay alive?!"},{"id":"manas-2010:p0327:b001:l039","ordinal":14917,"en":"An exceptional wrestler, an exceptional lion,"},{"id":"manas-2010:p0327:b001:l040","ordinal":14918,"en":"That wretched Burut, may his house burn,"},{"id":"manas-2010:p0327:b001:l041","ordinal":14919,"en":"Such a hero is not born among men!"},{"id":"manas-2010:p0327:b001:l042","ordinal":14920,"en":"Of medium height and broad shoulders,"},{"id":"manas-2010:p0327:b001:l043","ordinal":14921,"en":"No mortal can come to face him."},{"id":"manas-2010:p0327:b001:l044","ordinal":14922,"en":"That bastard Burut,"},{"id":"manas-2010:p0327:b001:l045","ordinal":14923,"en":"No mortal can face and defeat him!"},{"id":"manas-2010:p0327:b001:l046","ordinal":14924,"en":"If he merely grows angry,"},{"id":"manas-2010:p0327:b001:l047","ordinal":14925,"en":"He could bring upheaval to Kakan."},{"id":"manas-2010:p0327:b001:l048","ordinal":14926,"en":"All who grapple with him,"},{"id":"manas-2010:p0328:b001:l001","ordinal":14927,"en":"He could slaughter them entirely!"},{"id":"manas-2010:p0328:b001:l002","ordinal":14928,"en":"He wears a coat no bullet pierces,"},{"id":"manas-2010:p0328:b001:l003","ordinal":14929,"en":"He has a horse no bullet catches."},{"id":"manas-2010:p0328:b001:l004","ordinal":14930,"en":"From the Burut, no ordinary people,"},{"id":"manas-2010:p0328:b001:l005","ordinal":14931,"en":"A valiant one has been born!"},{"id":"manas-2010:p0328:b001:l006","ordinal":14932,"en":"His appearance is different, his venom strong."},{"id":"manas-2010:p0328:b001:l007","ordinal":14933,"en":"If you provoke him, you will die;"},{"id":"manas-2010:p0328:b001:l008","ordinal":14934,"en":"Abandon hope of your dear life!"},{"id":"manas-2010:p0328:b001:l009","ordinal":14935,"en":"His menace is mighty, an exceptional hero."},{"id":"manas-2010:p0328:b001:l010","ordinal":14936,"en":"If we grapple with him, he makes us black earth!"},{"id":"manas-2010:p0328:b001:l011","ordinal":14937,"en":"He began humiliating us like sheep."},{"id":"manas-2010:p0328:b001:l012","ordinal":14938,"en":"Whoever traded blows with him,"},{"id":"manas-2010:p0328:b001:l013","ordinal":14939,"en":"He tore out their throats!"},{"id":"manas-2010:p0328:b001:l014","ordinal":14940,"en":"Unable to face him and fight,"},{"id":"manas-2010:p0328:b001:l015","ordinal":14941,"en":"The wrestler fled with cropped ears."},{"id":"manas-2010:p0328:b001:l016","ordinal":14942,"en":"Your men with iron-rope nets,"},{"id":"manas-2010:p0328:b001:l017","ordinal":14943,"en":"Your men all armed with daggers,"},{"id":"manas-2010:p0328:b001:l018","ordinal":14944,"en":"Died lying sprawled."},{"id":"manas-2010:p0328:b001:l019","ordinal":14945,"en":"The heads of those who grappled were torn off,"},{"id":"manas-2010:p0328:b001:l020","ordinal":14946,"en":"They died stretched out."},{"id":"manas-2010:p0328:b001:l021","ordinal":14947,"en":"That bastard Burut,"},{"id":"manas-2010:p0328:b001:l022","ordinal":14948,"en":"No mortal can make him bend,"},{"id":"manas-2010:p0328:b001:l023","ordinal":14949,"en":"No mortal can defeat him!"},{"id":"manas-2010:p0328:b001:l024","ordinal":14950,"en":"He is a great ruler, he is a khan."},{"id":"manas-2010:p0328:b001:l025","ordinal":14951,"en":"This disheveled Burut"},{"id":"manas-2010:p0328:b001:l026","ordinal":14952,"en":"Is such a tormenting soul!"},{"id":"manas-2010:p0328:b001:l027","ordinal":14953,"en":"His brow is high, his venom strong."},{"id":"manas-2010:p0328:b001:l028","ordinal":14954,"en":"If you have provoked the Burut,"},{"id":"manas-2010:p0328:b001:l029","ordinal":14955,"en":"Abandon hope of your bare life!"},{"id":"manas-2010:p0328:b001:l030","ordinal":14956,"en":"When I looked at his lashes and brows,"},{"id":"manas-2010:p0328:b001:l031","ordinal":14957,"en":"They were a load no camel could bear."},{"id":"manas-2010:p0328:b001:l032","ordinal":14958,"en":"The venom issuing from both cheeks"},{"id":"manas-2010:p0328:b001:l033","ordinal":14959,"en":"Was hair enough for five felt stockings!"},{"id":"manas-2010:p0328:b001:l034","ordinal":14960,"en":"This bastard Burut"},{"id":"manas-2010:p0328:b001:l035","ordinal":14961,"en":"Was born here in Altay."},{"id":"manas-2010:p0328:b001:l036","ordinal":14962,"en":"We had failed to take notice."},{"id":"manas-2010:p0328:b001:l037","ordinal":14963,"en":"Your Burut, that son of a divorced mother,"},{"id":"manas-2010:p0328:b001:l038","ordinal":14964,"en":"Has now raised an uproar."},{"id":"manas-2010:p0328:b001:l039","ordinal":14965,"en":"No mortal can defeat him,"},{"id":"manas-2010:p0328:b001:l040","ordinal":14966,"en":"No mortal can go and face him."},{"id":"manas-2010:p0328:b001:l041","ordinal":14967,"en":"No mortal can grapple and take him,"},{"id":"manas-2010:p0328:b001:l042","ordinal":14968,"en":"Kakan cannot defeat him."},{"id":"manas-2010:p0328:b001:l043","ordinal":14969,"en":"Your Burut, may Heaven strike him,"},{"id":"manas-2010:p0328:b001:l044","ordinal":14970,"en":"Has all his fortunes complete."},{"id":"manas-2010:p0328:b001:l045","ordinal":14971,"en":"If we look within him,"},{"id":"manas-2010:p0328:b001:l046","ordinal":14972,"en":"He is wider than the face of the earth."},{"id":"manas-2010:p0328:b001:l047","ordinal":14973,"en":"For that bastard Burut,"},{"id":"manas-2010:p0328:b001:l048","ordinal":14974,"en":"An iron fortress has been established."},{"id":"manas-2010:p0329:b001:l001","ordinal":14975,"en":"Whoever grapples cannot defeat him."},{"id":"manas-2010:p0329:b001:l002","ordinal":14976,"en":"Ah, ah, the Burut is a hero!"},{"id":"manas-2010:p0329:b001:l003","ordinal":14977,"en":"No mortal can go against him,"},{"id":"manas-2010:p0329:b001:l004","ordinal":14978,"en":"None who provoke him remain alive."},{"id":"manas-2010:p0329:b001:l005","ordinal":14979,"en":"His appearance differs from mortals,"},{"id":"manas-2010:p0329:b001:l006","ordinal":14980,"en":"That foremost warrior will destroy Beijing!”"},{"id":"manas-2010:p0329:b001:l007","ordinal":14981,"en":"When Esenkan heard this,"},{"id":"manas-2010:p0329:b001:l008","ordinal":14982,"en":"He could not stand still for rage,"},{"id":"manas-2010:p0329:b001:l009","ordinal":14983,"en":"He began a fierce onslaught."},{"id":"manas-2010:p0329:b001:l010","ordinal":14984,"en":"His anger coming hard,"},{"id":"manas-2010:p0329:b001:l011","ordinal":14985,"en":"His governors, Sibe, and Torgut,"},{"id":"manas-2010:p0329:b001:l012","ordinal":14986,"en":"He slaughtered them."},{"id":"manas-2010:p0329:b001:l013","ordinal":14987,"en":"Hearing words from his governor,"},{"id":"manas-2010:p0329:b001:l014","ordinal":14988,"en":"That Khan Jakyp's Manas"},{"id":"manas-2010:p0329:b001:l015","ordinal":14989,"en":"Had emerged strong, he heard."},{"id":"manas-2010:p0329:b001:l016","ordinal":14990,"en":"Hearing words from his Manchus,"},{"id":"manas-2010:p0329:b001:l017","ordinal":14991,"en":"That a calamity had arisen, he heard."},{"id":"manas-2010:p0329:b001:l018","ordinal":14992,"en":"He began a fierce onslaught."},{"id":"manas-2010:p0329:b001:l019","ordinal":14993,"en":"From the golden throne he occupied,"},{"id":"manas-2010:p0329:b001:l020","ordinal":14994,"en":"Esenkan, the great ruler,"},{"id":"manas-2010:p0329:b001:l021","ordinal":14995,"en":"Leaped away."},{"id":"manas-2010:p0329:b001:l022","ordinal":14996,"en":"He shouted with all his might,"},{"id":"manas-2010:p0329:b001:l023","ordinal":14997,"en":"Called his governors-general,"},{"id":"manas-2010:p0329:b001:l024","ordinal":14998,"en":"Shouted out of his senses."},{"id":"manas-2010:p0329:b001:l025","ordinal":14999,"en":"Brave Esenkan then"},{"id":"manas-2010:p0329:b001:l026","ordinal":15000,"en":"Called his companions."},{"id":"manas-2010:p0329:b001:l027","ordinal":15001,"en":"A light was lit on the tower,"},{"id":"manas-2010:p0329:b001:l028","ordinal":15002,"en":"The war drum was beaten hard."},{"id":"manas-2010:p0329:b001:l029","ordinal":15003,"en":"When they heard the war drum's voice,"},{"id":"manas-2010:p0329:b001:l030","ordinal":15004,"en":"Many great ones came swarming!"},{"id":"manas-2010:p0329:b001:l031","ordinal":15005,"en":"Upon Esen's throne,"},{"id":"manas-2010:p0329:b001:l032","ordinal":15006,"en":"‘What has happened again?’ they asked."},{"id":"manas-2010:p0329:b001:l033","ordinal":15007,"en":"Ay Jangjung and Kün Jangjung,"},{"id":"manas-2010:p0329:b001:l034","ordinal":15008,"en":"Esenkan's confidants."},{"id":"manas-2010:p0329:b001:l035","ordinal":15009,"en":"Luypu and Shuypu, the two magicians,"},{"id":"manas-2010:p0329:b001:l036","ordinal":15010,"en":"Esenkan's peers."},{"id":"manas-2010:p0329:b001:l037","ordinal":15011,"en":"Shouting for his wrestlers,"},{"id":"manas-2010:p0329:b001:l038","ordinal":15012,"en":"His magicians, confidants, and peers,"},{"id":"manas-2010:p0329:b001:l039","ordinal":15013,"en":"He called, ‘Come quickly!’"},{"id":"manas-2010:p0329:b001:l040","ordinal":15014,"en":"He began a fierce onslaught."},{"id":"manas-2010:p0329:b001:l041","ordinal":15015,"en":"To the learned governor-magician,"},{"id":"manas-2010:p0329:b001:l042","ordinal":15016,"en":"He issued his command."},{"id":"manas-2010:p0329:b001:l043","ordinal":15017,"en":"Hurrying, shouting ‘Go!’"},{"id":"manas-2010:p0329:b001:l044","ordinal":15018,"en":"When they heard Esenkan's voice,"},{"id":"manas-2010:p0329:b001:l045","ordinal":15019,"en":"All the Manchus rushed forward."},{"id":"manas-2010:p0329:b001:l046","ordinal":15020,"en":"The war drum's voice resounded,"},{"id":"manas-2010:p0329:b001:l047","ordinal":15021,"en":"The brass pipe's voice clattered."},{"id":"manas-2010:p0329:b001:l048","ordinal":15022,"en":"Raised before the throne,"},{"id":"manas-2010:p0330:b001:l001","ordinal":15023,"en":"A mottled bay flag became the standard."},{"id":"manas-2010:p0330:b001:l002","ordinal":15024,"en":"There was a swelling uproar."},{"id":"manas-2010:p0330:b001:l003","ordinal":15025,"en":"His Torgut gathered to the last man."},{"id":"manas-2010:p0330:b001:l004","ordinal":15026,"en":"Esen did not stop shouting."},{"id":"manas-2010:p0330:b001:l005","ordinal":15027,"en":"Beside Esenkan"},{"id":"manas-2010:p0330:b001:l006","ordinal":15028,"en":"His wrestler stood fretting."},{"id":"manas-2010:p0330:b001:l007","ordinal":15029,"en":"The axe haft bent,"},{"id":"manas-2010:p0330:b001:l008","ordinal":15030,"en":"All the wrestlers ran,"},{"id":"manas-2010:p0330:b001:l009","ordinal":15031,"en":"Dust flew into the sky."},{"id":"manas-2010:p0330:b001:l010","ordinal":15032,"en":"When the khan gave his signal,"},{"id":"manas-2010:p0330:b001:l011","ordinal":15033,"en":"When they struck the war drum,"},{"id":"manas-2010:p0330:b001:l012","ordinal":15034,"en":"The army seethed and swarmed."},{"id":"manas-2010:p0330:b001:l013","ordinal":15035,"en":"His wrestlers of many kinds,"},{"id":"manas-2010:p0330:b001:l014","ordinal":15036,"en":"Once their khan had given orders,"},{"id":"manas-2010:p0330:b001:l015","ordinal":15037,"en":"Teemed like ants,"},{"id":"manas-2010:p0330:b001:l016","ordinal":15038,"en":"And came crowding around him."},{"id":"manas-2010:p0330:b001:l017","ordinal":15039,"en":"His wrestlers were extraordinary,"},{"id":"manas-2010:p0330:b001:l018","ordinal":15040,"en":"Their shouting split stones."},{"id":"manas-2010:p0330:b001:l019","ordinal":15041,"en":"That foremost warrior Esen,"},{"id":"manas-2010:p0330:b001:l020","ordinal":15042,"en":"The judges who had gone for news,"},{"id":"manas-2010:p0330:b001:l021","ordinal":15043,"en":"He gathered every one."},{"id":"manas-2010:p0330:b001:l022","ordinal":15044,"en":"‘They do not find Manas and return,’ he said."},{"id":"manas-2010:p0330:b001:l023","ordinal":15045,"en":"Khan Esenkan then"},{"id":"manas-2010:p0330:b001:l024","ordinal":15046,"en":"Raised this quarrel:"},{"id":"manas-2010:p0330:b001:l025","ordinal":15047,"en":"“I knew he would arise,"},{"id":"manas-2010:p0330:b001:l026","ordinal":15048,"en":"From the bastard Burut,"},{"id":"manas-2010:p0330:b001:l027","ordinal":15049,"en":"From the people called Burut."},{"id":"manas-2010:p0330:b001:l028","ordinal":15050,"en":"Six years before he was born,"},{"id":"manas-2010:p0330:b001:l029","ordinal":15051,"en":"It was known to me long ago."},{"id":"manas-2010:p0330:b001:l030","ordinal":15052,"en":"‘From the bastard Burut,"},{"id":"manas-2010:p0330:b001:l031","ordinal":15053,"en":"One named Manas will arise,"},{"id":"manas-2010:p0330:b001:l032","ordinal":15054,"en":"He will bring upheaval,"},{"id":"manas-2010:p0330:b001:l033","ordinal":15055,"en":"Of this Beijing standing here,"},{"id":"manas-2010:p0330:b001:l034","ordinal":15056,"en":"He will seize its khanate,’"},{"id":"manas-2010:p0330:b001:l035","ordinal":15057,"en":"It was drawn in my book."},{"id":"manas-2010:p0330:b001:l036","ordinal":15058,"en":"His looks and his features,"},{"id":"manas-2010:p0330:b001:l037","ordinal":15059,"en":"I told you without delay, magicians."},{"id":"manas-2010:p0330:b001:l038","ordinal":15060,"en":"His figure and his form,"},{"id":"manas-2010:p0330:b001:l039","ordinal":15061,"en":"His appearance as born and grown,"},{"id":"manas-2010:p0330:b001:l040","ordinal":15062,"en":"I knew and told you, magicians!"},{"id":"manas-2010:p0330:b001:l041","ordinal":15063,"en":"‘This one's name is Manas,’ you said,"},{"id":"manas-2010:p0330:b001:l042","ordinal":15064,"en":"And brought a boy bound."},{"id":"manas-2010:p0330:b001:l043","ordinal":15065,"en":"Unfit for any proper task,"},{"id":"manas-2010:p0330:b001:l044","ordinal":15066,"en":"You brought a slave bound!"},{"id":"manas-2010:p0330:b001:l045","ordinal":15067,"en":"I told you before,"},{"id":"manas-2010:p0330:b001:l046","ordinal":15068,"en":"You heard it before!"},{"id":"manas-2010:p0330:b001:l047","ordinal":15069,"en":"The signs at his birth,"},{"id":"manas-2010:p0330:b001:l048","ordinal":15070,"en":"I told you exactly!"},{"id":"manas-2010:p0331:b001:l001","ordinal":15071,"en":"Though I equipped and sent you properly,"},{"id":"manas-2010:p0331:b001:l002","ordinal":15072,"en":"Snoutless magician, you did not know!"},{"id":"manas-2010:p0331:b001:l003","ordinal":15073,"en":"When that Manas was born,"},{"id":"manas-2010:p0331:b001:l004","ordinal":15074,"en":"The tips of his ears were pierced,"},{"id":"manas-2010:p0331:b001:l005","ordinal":15075,"en":"His foreskin was cut,"},{"id":"manas-2010:p0331:b001:l006","ordinal":15076,"en":"His forehead reached the earth."},{"id":"manas-2010:p0331:b001:l007","ordinal":15077,"en":"Rain fell for eighty days,"},{"id":"manas-2010:p0331:b001:l008","ordinal":15078,"en":"An earthquake came."},{"id":"manas-2010:p0331:b001:l009","ordinal":15079,"en":"It turns out to be Manas himself."},{"id":"manas-2010:p0331:b001:l010","ordinal":15080,"en":"Your fathers' graves, magicians!"},{"id":"manas-2010:p0331:b001:l011","ordinal":15081,"en":"His time of surpassing others has come."},{"id":"manas-2010:p0331:b001:l012","ordinal":15082,"en":"The people's judge, Chong Ayar,"},{"id":"manas-2010:p0331:b001:l013","ordinal":15083,"en":"When we raided the Burut then,"},{"id":"manas-2010:p0331:b001:l014","ordinal":15084,"en":"Plundered the poor man's possessions,"},{"id":"manas-2010:p0331:b001:l015","ordinal":15085,"en":"And took them as booty,"},{"id":"manas-2010:p0331:b001:l016","ordinal":15086,"en":"That magician said:"},{"id":"manas-2010:p0331:b001:l017","ordinal":15087,"en":"‘An astonishing son will be born among the Burut,"},{"id":"manas-2010:p0331:b001:l018","ordinal":15088,"en":"A poison surpassing men will be born,"},{"id":"manas-2010:p0331:b001:l019","ordinal":15089,"en":"For Kakan-Chin's Beijing,"},{"id":"manas-2010:p0331:b001:l020","ordinal":15090,"en":"An uproar bringing upheaval will be born!"},{"id":"manas-2010:p0331:b001:l021","ordinal":15091,"en":"This Beijing standing here,"},{"id":"manas-2010:p0331:b001:l022","ordinal":15092,"en":"A son will be born who will burn it!’"},{"id":"manas-2010:p0331:b001:l023","ordinal":15093,"en":"A sheath without a crookedness,"},{"id":"manas-2010:p0331:b001:l024","ordinal":15094,"en":"What Chong Ayar said"},{"id":"manas-2010:p0331:b001:l025","ordinal":15095,"en":"Was true, not a lie."},{"id":"manas-2010:p0331:b001:l026","ordinal":15096,"en":"That Burut, may he burn,"},{"id":"manas-2010:p0331:b001:l027","ordinal":15097,"en":"Our eyes blinded, failing to see,"},{"id":"manas-2010:p0331:b001:l028","ordinal":15098,"en":"He had been born in Altay!"},{"id":"manas-2010:p0331:b001:l029","ordinal":15099,"en":"Your father's grave, wretched Burut!"},{"id":"manas-2010:p0331:b001:l030","ordinal":15100,"en":"If you live, you will see:"},{"id":"manas-2010:p0331:b001:l031","ordinal":15101,"en":"The Burut will raise an uproar in Beijing!"},{"id":"manas-2010:p0331:b001:l032","ordinal":15102,"en":"Braid your thoroughbred's mane,"},{"id":"manas-2010:p0331:b001:l033","ordinal":15103,"en":"The valiant blood-spiller Manas,"},{"id":"manas-2010:p0331:b001:l034","ordinal":15104,"en":"Within five or six years,"}]
