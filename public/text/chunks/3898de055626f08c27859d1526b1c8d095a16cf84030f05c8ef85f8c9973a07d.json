[{"id":"manas-2010:p1110:b001:l027","ordinal":48385,"en":"Give him rule, allowing none to stir;"},{"id":"manas-2010:p1110:b001:l028","ordinal":48386,"en":"I shall make him khan of Kakanchyn!’"},{"id":"manas-2010:p1110:b001:l029","ordinal":48387,"en":"Saying this, he readied the fierce warrior,"},{"id":"manas-2010:p1110:b001:l030","ordinal":48388,"en":"Prepared his arms and equipment."},{"id":"manas-2010:p1110:b001:l031","ordinal":48389,"en":"The Chinese multitudes gathered together;"},{"id":"manas-2010:p1110:b001:l032","ordinal":48390,"en":"They mounted him on Algara"},{"id":"manas-2010:p1110:b001:l033","ordinal":48391,"en":"And sent Kongurbay forth."},{"id":"manas-2010:p1110:b001:l034","ordinal":48392,"en":"After him, Karykan,"},{"id":"manas-2010:p1110:b001:l035","ordinal":48393,"en":"Saying, ‘Fight without tiring,’"},{"id":"manas-2010:p1110:b001:l036","ordinal":48394,"en":"Sent Ezkara."},{"id":"manas-2010:p1110:b001:l037","ordinal":48395,"en":"Then, equipping him in turn,"},{"id":"manas-2010:p1110:b001:l038","ordinal":48396,"en":"Karykan sent"},{"id":"manas-2010:p1110:b001:l039","ordinal":48397,"en":"His Kalmyk, like a lama,"},{"id":"manas-2010:p1110:b001:l040","ordinal":48398,"en":"His champion called Great Joloy."},{"id":"manas-2010:p1110:b001:l041","ordinal":48399,"en":"From the flank, Borukoz"},{"id":"manas-2010:p1110:b001:l042","ordinal":48400,"en":"Also came up,"},{"id":"manas-2010:p1111:b001:l001","ordinal":48401,"en":"From the flank, Kanzharkol"},{"id":"manas-2010:p1111:b001:l002","ordinal":48402,"en":"Shouted and raised the battle cry."},{"id":"manas-2010:p1111:b001:l003","ordinal":48403,"en":"When I was about to flee this way,"},{"id":"manas-2010:p1111:b001:l004","ordinal":48404,"en":"The countless Chinese spread out there,"},{"id":"manas-2010:p1111:b001:l005","ordinal":48405,"en":"Their twelve khans stirring,"},{"id":"manas-2010:p1111:b001:l006","ordinal":48406,"en":"With hero Kongurbay at their head,"},{"id":"manas-2010:p1111:b001:l007","ordinal":48407,"en":"Caught me unaware, giving no time to prepare,"},{"id":"manas-2010:p1111:b001:l008","ordinal":48408,"en":"And surrounded me."},{"id":"manas-2010:p1111:b001:l009","ordinal":48409,"en":"If by chance I fell into their hands,"},{"id":"manas-2010:p1111:b001:l010","ordinal":48410,"en":"They stood ready to dig my pit,"},{"id":"manas-2010:p1111:b001:l011","ordinal":48411,"en":"They stood ready to eat my liver,"},{"id":"manas-2010:p1111:b001:l012","ordinal":48412,"en":"They intended to bind my hands."},{"id":"manas-2010:p1111:b001:l013","ordinal":48413,"en":"'An order has come from the sovereign,' they said,"},{"id":"manas-2010:p1111:b001:l014","ordinal":48414,"en":"Ready to make a spectacle of me."},{"id":"manas-2010:p1111:b001:l015","ordinal":48415,"en":"They meant to shed my blood,"},{"id":"manas-2010:p1111:b001:l016","ordinal":48416,"en":"They intended to take my life,"},{"id":"manas-2010:p1111:b001:l017","ordinal":48417,"en":"They meant to gouge out my eyes."},{"id":"manas-2010:p1111:b001:l018","ordinal":48418,"en":"All the Chinese of forty khans,"},{"id":"manas-2010:p1111:b001:l019","ordinal":48419,"en":"Seizing me then,"},{"id":"manas-2010:p1111:b001:l020","ordinal":48420,"en":"Intended to kill me."},{"id":"manas-2010:p1111:b001:l021","ordinal":48421,"en":"Those bastards would not listen"},{"id":"manas-2010:p1111:b001:l022","ordinal":48422,"en":"To my words, even if I begged."},{"id":"manas-2010:p1111:b001:l023","ordinal":48423,"en":"Of the countless Chinese people,"},{"id":"manas-2010:p1111:b001:l024","ordinal":48424,"en":"When I saw their hostility:"},{"id":"manas-2010:p1111:b001:l025","ordinal":48425,"en":"'Rather than endure their torment,"},{"id":"manas-2010:p1111:b001:l026","ordinal":48426,"en":"Rather than, among the evil-minded Chinese,"},{"id":"manas-2010:p1111:b001:l027","ordinal":48427,"en":"Remain imprisoned,"},{"id":"manas-2010:p1111:b001:l028","ordinal":48428,"en":"Rather than be Beijing's spoil,"},{"id":"manas-2010:p1111:b001:l029","ordinal":48429,"en":"Remaining prey to their plunder...'"},{"id":"manas-2010:p1111:b001:l030","ordinal":48430,"en":"This is what we thought then."},{"id":"manas-2010:p1111:b001:l031","ordinal":48431,"en":"Whatever fate may come before me,"},{"id":"manas-2010:p1111:b001:l032","ordinal":48432,"en":"If it falls upon my head, let me face it."},{"id":"manas-2010:p1111:b001:l033","ordinal":48433,"en":"Rather than be captured alive,"},{"id":"manas-2010:p1111:b001:l034","ordinal":48434,"en":"Let me die fighting!"},{"id":"manas-2010:p1111:b001:l035","ordinal":48435,"en":"Forty warriors followed me;"},{"id":"manas-2010:p1111:b001:l036","ordinal":48436,"en":"My mother was with me then."},{"id":"manas-2010:p1111:b001:l037","ordinal":48437,"en":"Turning aside toward a spring,"},{"id":"manas-2010:p1111:b001:l038","ordinal":48438,"en":"I put my feet into the water,"},{"id":"manas-2010:p1111:b001:l039","ordinal":48439,"en":"I performed the washing of my feet."},{"id":"manas-2010:p1111:b001:l040","ordinal":48440,"en":"I put my hands into the water,"},{"id":"manas-2010:p1111:b001:l041","ordinal":48441,"en":"I performed the washing of my hands."},{"id":"manas-2010:p1111:b001:l042","ordinal":48442,"en":"We properly saddled our steeds."},{"id":"manas-2010:p1112:b001:l001","ordinal":48443,"en":"'May faith be granted to the dead,' we said,"},{"id":"manas-2010:p1112:b001:l002","ordinal":48444,"en":"And recited the Quran while still alive."},{"id":"manas-2010:p1112:b001:l003","ordinal":48445,"en":"Gathering courage, unable to wait,"},{"id":"manas-2010:p1112:b001:l004","ordinal":48446,"en":"I took the telescope from my person."},{"id":"manas-2010:p1112:b001:l005","ordinal":48447,"en":"The Chinese, like ants,"},{"id":"manas-2010:p1112:b001:l006","ordinal":48448,"en":"I stood surveying carefully."},{"id":"manas-2010:p1112:b001:l007","ordinal":48449,"en":"As I gazed at the Chinese—"},{"id":"manas-2010:p1112:b001:l008","ordinal":48450,"en":"Look at the reeds, look at the flood!"},{"id":"manas-2010:p1112:b001:l009","ordinal":48451,"en":"The countless Chinese stirred—"},{"id":"manas-2010:p1112:b001:l010","ordinal":48452,"en":"Look at the people sweeping forward!"},{"id":"manas-2010:p1112:b001:l011","ordinal":48453,"en":"Their waves brought mountains down:"},{"id":"manas-2010:p1112:b001:l012","ordinal":48454,"en":"Surging waves of mounts."},{"id":"manas-2010:p1112:b001:l013","ordinal":48455,"en":"Look at the grass upon the earth,"},{"id":"manas-2010:p1112:b001:l014","ordinal":48456,"en":"Look at the Chinese, as many as grass!"},{"id":"manas-2010:p1112:b001:l015","ordinal":48457,"en":"Look at the ants, look at the insects,"},{"id":"manas-2010:p1112:b001:l016","ordinal":48458,"en":"Seething like ants—"},{"id":"manas-2010:p1112:b001:l017","ordinal":48459,"en":"Look at the Chinese people, as many as sand!"},{"id":"manas-2010:p1112:b001:l018","ordinal":48460,"en":"As I gazed at the Chinese,"},{"id":"manas-2010:p1112:b001:l019","ordinal":48461,"en":"The spearheads clashed,"},{"id":"manas-2010:p1112:b001:l020","ordinal":48462,"en":"Human heads bobbed densely,"},{"id":"manas-2010:p1112:b001:l021","ordinal":48463,"en":"Their battle-axes struck together,"},{"id":"manas-2010:p1112:b001:l022","ordinal":48464,"en":"The sword points swayed."},{"id":"manas-2010:p1112:b001:l023","ordinal":48465,"en":"As I gazed, Khan Manas,"},{"id":"manas-2010:p1112:b001:l024","ordinal":48466,"en":"The sky was clear, the earth overcast."},{"id":"manas-2010:p1112:b001:l025","ordinal":48467,"en":"Dust covered the face of the earth;"},{"id":"manas-2010:p1112:b001:l026","ordinal":48468,"en":"Not a fingerbreadth of ground was visible."},{"id":"manas-2010:p1112:b001:l027","ordinal":48469,"en":"Khan Manas, do you mean those giants?"},{"id":"manas-2010:p1112:b001:l028","ordinal":48470,"en":"Bozkertik, riding a mule,"},{"id":"manas-2010:p1112:b001:l029","ordinal":48471,"en":"Their khan, had arrived."},{"id":"manas-2010:p1112:b001:l030","ordinal":48472,"en":"The trick riders and swift runners"},{"id":"manas-2010:p1112:b001:l031","ordinal":48473,"en":"Had arrived as well."},{"id":"manas-2010:p1112:b001:l032","ordinal":48474,"en":"Twelve khans and countless Chinese,"},{"id":"manas-2010:p1112:b001:l033","ordinal":48475,"en":"Divided into troop upon troop,"},{"id":"manas-2010:p1112:b001:l034","ordinal":48476,"en":"Took their ordered positions around me."},{"id":"manas-2010:p1112:b001:l035","ordinal":48477,"en":"The ring around me was firm,"},{"id":"manas-2010:p1112:b001:l036","ordinal":48478,"en":"Harder even than iron."},{"id":"manas-2010:p1112:b001:l037","ordinal":48479,"en":"So numerous were the Chinese,"},{"id":"manas-2010:p1112:b001:l038","ordinal":48480,"en":"No bird could fly beyond their edge."},{"id":"manas-2010:p1112:b001:l039","ordinal":48481,"en":"When the Chinese stood surrounding me,"},{"id":"manas-2010:p1112:b001:l040","ordinal":48482,"en":"I had no support upon which to rely."},{"id":"manas-2010:p1112:b001:l041","ordinal":48483,"en":"A curse upon being alone!"},{"id":"manas-2010:p1112:b001:l042","ordinal":48484,"en":"To make the Chinese shed blood,"},{"id":"manas-2010:p1113:b001:l001","ordinal":48485,"en":"I had no lion like you, my champion."},{"id":"manas-2010:p1113:b001:l002","ordinal":48486,"en":"When the Chinese charged,"},{"id":"manas-2010:p1113:b001:l003","ordinal":48487,"en":"I had no cliff that geese could not circle."},{"id":"manas-2010:p1113:b001:l004","ordinal":48488,"en":"To give me courage,"},{"id":"manas-2010:p1113:b001:l005","ordinal":48489,"en":"Khan Manas, I had no mountain like you."},{"id":"manas-2010:p1113:b001:l006","ordinal":48490,"en":"Why should I speak of the others?"},{"id":"manas-2010:p1113:b001:l007","ordinal":48491,"en":"What purpose would I achieve?"},{"id":"manas-2010:p1113:b001:l008","ordinal":48492,"en":"Among those Chinese,"},{"id":"manas-2010:p1113:b001:l009","ordinal":48493,"en":"With cotton belt and broad boots,"},{"id":"manas-2010:p1113:b001:l010","ordinal":48494,"en":"Majestic Kongurbay—"},{"id":"manas-2010:p1113:b001:l011","ordinal":48495,"en":"Let me describe his appearance."},{"id":"manas-2010:p1113:b001:l012","ordinal":48496,"en":"Dust rose from his advance,"},{"id":"manas-2010:p1113:b001:l013","ordinal":48497,"en":"His voice made souls depart."},{"id":"manas-2010:p1113:b001:l014","ordinal":48498,"en":"Tugging at the golden reins,"},{"id":"manas-2010:p1113:b001:l015","ordinal":48499,"en":"Making Algara lunge,"},{"id":"manas-2010:p1113:b001:l016","ordinal":48500,"en":"Kongurbay rode in front."},{"id":"manas-2010:p1113:b001:l017","ordinal":48501,"en":"Of those countless Chinese,"},{"id":"manas-2010:p1113:b001:l018","ordinal":48502,"en":"He separated the mule riders into one group;"},{"id":"manas-2010:p1113:b001:l019","ordinal":48503,"en":"Those who thrust spears without fleeing,"},{"id":"manas-2010:p1113:b001:l020","ordinal":48504,"en":"He separated the mighty fighters into one group."},{"id":"manas-2010:p1113:b001:l021","ordinal":48505,"en":"Kongurbay led them onward."},{"id":"manas-2010:p1113:b001:l022","ordinal":48506,"en":"Those who thrust without missing,"},{"id":"manas-2010:p1113:b001:l023","ordinal":48507,"en":"He separated the heroes into one group;"},{"id":"manas-2010:p1113:b001:l024","ordinal":48508,"en":"Those who shot straight through the pupil,"},{"id":"manas-2010:p1113:b001:l025","ordinal":48509,"en":"He separated the marksmen into one group."},{"id":"manas-2010:p1113:b001:l026","ordinal":48510,"en":"With Kongurbay at their head,"},{"id":"manas-2010:p1113:b001:l027","ordinal":48511,"en":"The teeming, mighty Chinese host"},{"id":"manas-2010:p1113:b001:l028","ordinal":48512,"en":"Was an iron net encircling me."},{"id":"manas-2010:p1113:b001:l029","ordinal":48513,"en":"From death and suffering,"},{"id":"manas-2010:p1113:b001:l030","ordinal":48514,"en":"Great courage would save me."},{"id":"manas-2010:p1113:b001:l031","ordinal":48515,"en":"When the Chinese came sweeping forward,"},{"id":"manas-2010:p1113:b001:l032","ordinal":48516,"en":"Saying, 'I have forty men; we are few,'"},{"id":"manas-2010:p1113:b001:l033","ordinal":48517,"en":"When Sarala was beneath me,"},{"id":"manas-2010:p1113:b001:l034","ordinal":48518,"en":"Without charging to strike the Chinese,"},{"id":"manas-2010:p1113:b001:l035","ordinal":48519,"en":"How could I stand and watch?"},{"id":"manas-2010:p1113:b001:l036","ordinal":48520,"en":"I girded the leather war belt at my waist."},{"id":"manas-2010:p1113:b001:l037","ordinal":48521,"en":"Against seven vast Chinese hosts,"},{"id":"manas-2010:p1113:b001:l038","ordinal":48522,"en":"I went in alone and attacked."},{"id":"manas-2010:p1113:b001:l039","ordinal":48523,"en":"Making Sarala lunge,"},{"id":"manas-2010:p1113:b001:l040","ordinal":48524,"en":"No other word coming to my mouth,"},{"id":"manas-2010:p1113:b001:l041","ordinal":48525,"en":"I shouted the battle cry, 'Almambet!'"},{"id":"manas-2010:p1113:b001:l042","ordinal":48526,"en":"I charged into the enemy."},{"id":"manas-2010:p1114:b001:l001","ordinal":48527,"en":"With his cotton belt and broad boots,"},{"id":"manas-2010:p1114:b001:l002","ordinal":48528,"en":"I struck Kongurbay."},{"id":"manas-2010:p1114:b001:l003","ordinal":48529,"en":"I reached him faster than an arrow."},{"id":"manas-2010:p1114:b001:l004","ordinal":48530,"en":"On reaching him, I swung once."},{"id":"manas-2010:p1114:b001:l005","ordinal":48531,"en":"The Kalcha Kongurbay,"},{"id":"manas-2010:p1114:b001:l006","ordinal":48532,"en":"At the mouth of the gate,"},{"id":"manas-2010:p1114:b001:l007","ordinal":48533,"en":"I struck in the kidney as I passed."},{"id":"manas-2010:p1114:b001:l008","ordinal":48534,"en":"When he was about to fly from his horse,"},{"id":"manas-2010:p1114:b001:l009","ordinal":48535,"en":"When his death was about to come from me,"},{"id":"manas-2010:p1114:b001:l010","ordinal":48536,"en":"The Chinese sorcerer named Külük"},{"id":"manas-2010:p1114:b001:l011","ordinal":48537,"en":"Came rushing desperately."},{"id":"manas-2010:p1114:b001:l012","ordinal":48538,"en":"Reaching him, he put him on his horse."},{"id":"manas-2010:p1114:b001:l013","ordinal":48539,"en":"The Kalcha Kongurbay,"},{"id":"manas-2010:p1114:b001:l014","ordinal":48540,"en":"He put back on his horse,"},{"id":"manas-2010:p1114:b001:l015","ordinal":48541,"en":"Supporting him and bearing him away."},{"id":"manas-2010:p1114:b001:l016","ordinal":48542,"en":"When Kongurbay escaped unharmed,"},{"id":"manas-2010:p1114:b001:l017","ordinal":48543,"en":"The countless Chinese swept forward."},{"id":"manas-2010:p1114:b001:l018","ordinal":48544,"en":"They drew their bows like rain,"},{"id":"manas-2010:p1114:b001:l019","ordinal":48545,"en":"They fired their shots like hail."},{"id":"manas-2010:p1114:b001:l020","ordinal":48546,"en":"The Chinese crowded in, swarming."},{"id":"manas-2010:p1114:b001:l021","ordinal":48547,"en":"In their minds, the countless Chinese"},{"id":"manas-2010:p1114:b001:l022","ordinal":48548,"en":"Prepared, saying, 'I shall capture him.'"},{"id":"manas-2010:p1114:b001:l023","ordinal":48549,"en":"When the countless Chinese crowded in,"},{"id":"manas-2010:p1114:b001:l024","ordinal":48550,"en":"I did not spare my life."},{"id":"manas-2010:p1114:b001:l025","ordinal":48551,"en":"When I cried, 'Go!' Sarala"},{"id":"manas-2010:p1114:b001:l026","ordinal":48552,"en":"Set off trailing a cloud of dust."},{"id":"manas-2010:p1114:b001:l027","ordinal":48553,"en":"Karykan's steel blade,"},{"id":"manas-2010:p1114:b001:l028","ordinal":48554,"en":"When I charged and took it in hand,"},{"id":"manas-2010:p1114:b001:l029","ordinal":48555,"en":"The countless Manchus and Chinese"},{"id":"manas-2010:p1114:b001:l030","ordinal":48556,"en":"I bathed in red blood."},{"id":"manas-2010:p1114:b001:l031","ordinal":48557,"en":"Unable to withstand my valor,"},{"id":"manas-2010:p1114:b001:l032","ordinal":48558,"en":"The Chinese began to flee."},{"id":"manas-2010:p1114:b001:l033","ordinal":48559,"en":"The Chinese my sword could reach,"},{"id":"manas-2010:p1114:b001:l034","ordinal":48560,"en":"I slashed sideways and made crawl."},{"id":"manas-2010:p1114:b001:l035","ordinal":48561,"en":"Wherever my spear could reach,"},{"id":"manas-2010:p1114:b001:l036","ordinal":48562,"en":"I destroyed them with my spear."},{"id":"manas-2010:p1114:b001:l037","ordinal":48563,"en":"I remained where I had not died."},{"id":"manas-2010:p1114:b001:l038","ordinal":48564,"en":"'Rather than live in Beijing,"},{"id":"manas-2010:p1114:b001:l039","ordinal":48565,"en":"Let me die, Manas,' I fought, thinking."},{"id":"manas-2010:p1114:b001:l040","ordinal":48566,"en":"Without glancing back,"},{"id":"manas-2010:p1114:b001:l041","ordinal":48567,"en":"I waged a tremendous battle,"},{"id":"manas-2010:p1114:b001:l042","ordinal":48568,"en":"Not sparing my fly-like soul,"},{"id":"manas-2010:p1115:b001:l001","ordinal":48569,"en":"Without looking all around,"},{"id":"manas-2010:p1115:b001:l002","ordinal":48570,"en":"I drove the Chinese out,"},{"id":"manas-2010:p1115:b001:l003","ordinal":48571,"en":"Not sparing my precious soul."},{"id":"manas-2010:p1115:b001:l004","ordinal":48572,"en":"In Kakan-Chin's Beijing,"},{"id":"manas-2010:p1115:b001:l005","ordinal":48573,"en":"Making the Chinese cower,"},{"id":"manas-2010:p1115:b001:l006","ordinal":48574,"en":"I hemmed them in and drove them, Khan Manas."},{"id":"manas-2010:p1115:b001:l007","ordinal":48575,"en":"Scattering them across the plain,"},{"id":"manas-2010:p1115:b001:l008","ordinal":48576,"en":"Shouting, 'Almambet!'"},{"id":"manas-2010:p1115:b001:l009","ordinal":48577,"en":"The Chinese, like ants,"},{"id":"manas-2010:p1115:b001:l010","ordinal":48578,"en":"I sent surging ahead of me,"},{"id":"manas-2010:p1115:b001:l011","ordinal":48579,"en":"And drove them onward, Khan Manas."},{"id":"manas-2010:p1115:b001:l012","ordinal":48580,"en":"Through the middle of the Chinese,"},{"id":"manas-2010:p1115:b001:l013","ordinal":48581,"en":"When I cut and slaughtered my way,"},{"id":"manas-2010:p1115:b001:l014","ordinal":48582,"en":"Scattering those around them,"},{"id":"manas-2010:p1115:b001:l015","ordinal":48583,"en":"My dear, generous mother"},{"id":"manas-2010:p1115:b001:l016","ordinal":48584,"en":"Slaughtered and drove them for me."},{"id":"manas-2010:p1115:b001:l017","ordinal":48585,"en":"Around their flanks, the forty warriors"},{"id":"manas-2010:p1115:b001:l018","ordinal":48586,"en":"Drove them onward and slaughtered them."},{"id":"manas-2010:p1115:b001:l019","ordinal":48587,"en":"Over Zhapalak Ridge,"},{"id":"manas-2010:p1115:b001:l020","ordinal":48588,"en":"Across the desert of It-Ölbös,"},{"id":"manas-2010:p1115:b001:l021","ordinal":48589,"en":"We pursued the Chinese."},{"id":"manas-2010:p1115:b001:l022","ordinal":48590,"en":"When we reached It-Ölbös,"},{"id":"manas-2010:p1115:b001:l023","ordinal":48591,"en":"When we fought in earnest,"},{"id":"manas-2010:p1115:b001:l024","ordinal":48592,"en":"The points of our weapons clashing,"},{"id":"manas-2010:p1115:b001:l025","ordinal":48593,"en":"All the Chinese against us alone,"},{"id":"manas-2010:p1115:b001:l026","ordinal":48594,"en":"Fighting without sparing our lives,"},{"id":"manas-2010:p1115:b001:l027","ordinal":48595,"en":"Taking no time of day for rest,"},{"id":"manas-2010:p1115:b001:l028","ordinal":48596,"en":"Not pausing in the daytime,"},{"id":"manas-2010:p1115:b001:l029","ordinal":48597,"en":"We fought by day and night."},{"id":"manas-2010:p1115:b001:l030","ordinal":48598,"en":"Upon that battlefield,"},{"id":"manas-2010:p1115:b001:l031","ordinal":48599,"en":"Look at the plain, look at the dust!"},{"id":"manas-2010:p1115:b001:l032","ordinal":48600,"en":"Mingling with the dust like a river,"},{"id":"manas-2010:p1115:b001:l033","ordinal":48601,"en":"Look at the blood that flowed!"},{"id":"manas-2010:p1115:b001:l034","ordinal":48602,"en":"Their fangs jutting out,"},{"id":"manas-2010:p1115:b001:l035","ordinal":48603,"en":"Horse corpses lay in heaps;"},{"id":"manas-2010:p1115:b001:l036","ordinal":48604,"en":"Their mustaches sticking up,"},{"id":"manas-2010:p1115:b001:l037","ordinal":48605,"en":"Warriors' corpses made a mountain."},{"id":"manas-2010:p1115:b001:l038","ordinal":48606,"en":"To the Chinese in Inner Beijing,"},{"id":"manas-2010:p1115:b001:l039","ordinal":48607,"en":"From then onward I became an enemy."},{"id":"manas-2010:p1115:b001:l040","ordinal":48608,"en":"After the Chinese had been slaughtered,"},{"id":"manas-2010:p1115:b001:l041","ordinal":48609,"en":"After the mighty Kalcha saw it,"},{"id":"manas-2010:p1115:b001:l042","ordinal":48610,"en":"Making Algara pant,"},{"id":"manas-2010:p1116:b001:l001","ordinal":48611,"en":"Kongurbay went on stubbornly:"},{"id":"manas-2010:p1116:b001:l002","ordinal":48612,"en":"'Go into the earth, unworthy to be Chinese!"},{"id":"manas-2010:p1116:b001:l003","ordinal":48613,"en":"They flee from a single man!' he cried,"},{"id":"manas-2010:p1116:b001:l004","ordinal":48614,"en":"Stopping the front of the people."},{"id":"manas-2010:p1116:b001:l005","ordinal":48615,"en":"Unable to stop them, howling,"},{"id":"manas-2010:p1116:b001:l006","ordinal":48616,"en":"Kongurbay went about in tears."},{"id":"manas-2010:p1116:b001:l007","ordinal":48617,"en":"Gathering those around him,"},{"id":"manas-2010:p1116:b001:l008","ordinal":48618,"en":"Kongurbay thrust them forward."},{"id":"manas-2010:p1116:b001:l009","ordinal":48619,"en":"Six vast hosts of Black Chinese,"},{"id":"manas-2010:p1116:b001:l010","ordinal":48620,"en":"Scattering them toward us,"},{"id":"manas-2010:p1116:b001:l011","ordinal":48621,"en":"Kongurbay drove them in."},{"id":"manas-2010:p1116:b001:l012","ordinal":48622,"en":"The Chinese fired from every side."},{"id":"manas-2010:p1116:b001:l013","ordinal":48623,"en":"All their mighty fighters,"},{"id":"manas-2010:p1116:b001:l014","ordinal":48624,"en":"Kongurbay separated out"},{"id":"manas-2010:p1116:b001:l015","ordinal":48625,"en":"And sent sweeping toward me."},{"id":"manas-2010:p1116:b001:l016","ordinal":48626,"en":"Their governor riding a mule"},{"id":"manas-2010:p1116:b001:l017","ordinal":48627,"en":"Advanced from the flank, prepared."},{"id":"manas-2010:p1116:b001:l018","ordinal":48628,"en":"Börüköz and Kanzharkol"},{"id":"manas-2010:p1116:b001:l019","ordinal":48629,"en":"Crowded in against my front."},{"id":"manas-2010:p1116:b001:l020","ordinal":48630,"en":"Ezkara and Kutan the giant,"},{"id":"manas-2010:p1116:b001:l021","ordinal":48631,"en":"Making the countless Chinese surge like a lake,"},{"id":"manas-2010:p1116:b001:l022","ordinal":48632,"en":"Came in from behind together."},{"id":"manas-2010:p1116:b001:l023","ordinal":48633,"en":"From heaven, almighty God"},{"id":"manas-2010:p1116:b001:l024","ordinal":48634,"en":"Must have shed his true light."},{"id":"manas-2010:p1116:b001:l025","ordinal":48635,"en":"The angel Gabriel,"},{"id":"manas-2010:p1116:b001:l026","ordinal":48636,"en":"While I was upon Sarala—"},{"id":"manas-2010:p1116:b001:l027","ordinal":48637,"en":"I think now—"},{"id":"manas-2010:p1116:b001:l028","ordinal":48638,"en":"Held down the hem of my robe."},{"id":"manas-2010:p1116:b001:l029","ordinal":48639,"en":"That was why Almambet"},{"id":"manas-2010:p1116:b001:l030","ordinal":48640,"en":"Survived death, I think."}]
