[{"id":"manas-2010:p0683:b001:l013","ordinal":30465,"en":"Made his mighty self a lion."},{"id":"manas-2010:p0683:b001:l014","ordinal":30466,"en":"No enemy came to face him."},{"id":"manas-2010:p0683:b001:l015","ordinal":30467,"en":"In those days, against the champion,"},{"id":"manas-2010:p0683:b001:l016","ordinal":30468,"en":"None remained who could turn a herding pole."},{"id":"manas-2010:p0683:b001:l017","ordinal":30469,"en":"His story became a much-told tale."},{"id":"manas-2010:p0683:b001:l018","ordinal":30470,"en":"Gathering his people in humiliation,"},{"id":"manas-2010:p0683:b001:l019","ordinal":30471,"en":"For the Argyn and the Kyrgyz"},{"id":"manas-2010:p0683:b001:l020","ordinal":30472,"en":"He became a fortress set in place."},{"id":"manas-2010:p0683:b001:l021","ordinal":30473,"en":"Those who understood his words,"},{"id":"manas-2010:p0683:b001:l022","ordinal":30474,"en":"He subdued through speech."},{"id":"manas-2010:p0683:b001:l023","ordinal":30475,"en":"The enemy who came glaring,"},{"id":"manas-2010:p0683:b001:l024","ordinal":30476,"en":"He knocked aside merely by walking."},{"id":"manas-2010:p0683:b001:l025","ordinal":30477,"en":"Where ears had heard and eyes had seen,"},{"id":"manas-2010:p0683:b001:l026","ordinal":30478,"en":"Manas took the land."},{"id":"manas-2010:p0683:b001:l027","ordinal":30479,"en":"Dwelling in Sary-Arka,"},{"id":"manas-2010:p0683:b001:l028","ordinal":30480,"en":"Called a weighty, formidable hero,"},{"id":"manas-2010:p0683:b001:l029","ordinal":30481,"en":"His lattice walls and roof poles of wood,"},{"id":"manas-2010:p0683:b001:l030","ordinal":30482,"en":"His earliest forefather Alach,"},{"id":"manas-2010:p0683:b001:l031","ordinal":30483,"en":"Hero Kökchö, Aydarkan's son—"},{"id":"manas-2010:p0683:b001:l032","ordinal":30484,"en":"What mortal could approach him!"},{"id":"manas-2010:p0683:b001:l033","ordinal":30485,"en":"Preparing his millet hard as stone,"},{"id":"manas-2010:p0683:b001:l034","ordinal":30486,"en":"Praising his wife as though a maiden,"},{"id":"manas-2010:p0683:b001:l035","ordinal":30487,"en":"Dust twisting from the river valley,"},{"id":"manas-2010:p0683:b001:l036","ordinal":30488,"en":"Shouting out his songs."},{"id":"manas-2010:p0683:b001:l037","ordinal":30489,"en":"Rich, foamy broth and fatty meat,"},{"id":"manas-2010:p0683:b001:l038","ordinal":30490,"en":"A piercing cry, a bare spear—"},{"id":"manas-2010:p0683:b001:l039","ordinal":30491,"en":"While blood-drinking Manas was there,"},{"id":"manas-2010:p0683:b001:l040","ordinal":30492,"en":"He enclosed the Kazakhs and struck once,"},{"id":"manas-2010:p0683:b001:l041","ordinal":30493,"en":"Made them face him, and returned."},{"id":"manas-2010:p0683:b001:l042","ordinal":30494,"en":"From Alty-Shaar and the Lob River,"},{"id":"manas-2010:p0684:b001:l001","ordinal":30495,"en":"He was taking tribute."},{"id":"manas-2010:p0684:b001:l002","ordinal":30496,"en":"Akkula was his swift winged steed."},{"id":"manas-2010:p0684:b001:l003","ordinal":30497,"en":"His extinguished fire was kindled;"},{"id":"manas-2010:p0684:b001:l004","ordinal":30498,"en":"His dead life came alive."},{"id":"manas-2010:p0684:b001:l005","ordinal":30499,"en":"He moved here—did you see?—"},{"id":"manas-2010:p0684:b001:l006","ordinal":30500,"en":"His kinsman named Khan Ulak."},{"id":"manas-2010:p0684:b001:l007","ordinal":30501,"en":"His wings had grown a span;"},{"id":"manas-2010:p0684:b001:l008","ordinal":30502,"en":"Your dear elder Bakay,"},{"id":"manas-2010:p0684:b001:l009","ordinal":30503,"en":"Readying himself like a goshawk,"},{"id":"manas-2010:p0684:b001:l010","ordinal":30504,"en":"To Khan Bakay himself"},{"id":"manas-2010:p0684:b001:l011","ordinal":30505,"en":"Wisdom came from the unseen."},{"id":"manas-2010:p0684:b001:l012","ordinal":30506,"en":"Making the unknown known,"},{"id":"manas-2010:p0684:b001:l013","ordinal":30507,"en":"Learned elder Bakay,"},{"id":"manas-2010:p0684:b001:l014","ordinal":30508,"en":"Making the unperceived perceived,"},{"id":"manas-2010:p0684:b001:l015","ordinal":30509,"en":"Noble falcon Bakay, the saint."},{"id":"manas-2010:p0684:b001:l016","ordinal":30510,"en":"With open brow, meeting face to face,"},{"id":"manas-2010:p0684:b001:l017","ordinal":30511,"en":"Encountered by chance,"},{"id":"manas-2010:p0684:b001:l018","ordinal":30512,"en":"First meeting the blue-maned one,"},{"id":"manas-2010:p0684:b001:l019","ordinal":30513,"en":"Your blue-maned elder Bakay"},{"id":"manas-2010:p0684:b001:l020","ordinal":30514,"en":"Was found as an inheritance."},{"id":"manas-2010:p0684:b001:l021","ordinal":30515,"en":"A need of his precious life,"},{"id":"manas-2010:p0684:b001:l022","ordinal":30516,"en":"A gift to his solitary life."},{"id":"manas-2010:p0684:b001:l023","ordinal":30517,"en":"His guiding star in the sky,"},{"id":"manas-2010:p0684:b001:l024","ordinal":30518,"en":"Exceptional Bakay, the noble hero,"},{"id":"manas-2010:p0684:b001:l025","ordinal":30519,"en":"Was the lion hero's companion."},{"id":"manas-2010:p0684:b001:l026","ordinal":30520,"en":"Azhybay and Bakay, the twin khans,"},{"id":"manas-2010:p0684:b001:l027","ordinal":30521,"en":"Were your blood-drinker's retainers."},{"id":"manas-2010:p0684:b001:l028","ordinal":30522,"en":"The companions who came in a pair,"},{"id":"manas-2010:p0684:b001:l029","ordinal":30523,"en":"Shuutu and his Singer,"},{"id":"manas-2010:p0684:b001:l030","ordinal":30524,"en":"If an enemy came to face them,"},{"id":"manas-2010:p0684:b001:l031","ordinal":30525,"en":"Would stand beneath the banner."},{"id":"manas-2010:p0684:b001:l032","ordinal":30526,"en":"Küldür, Kambar, Chalybay—"},{"id":"manas-2010:p0684:b001:l033","ordinal":30527,"en":"They too came to Talas,"},{"id":"manas-2010:p0684:b001:l034","ordinal":30528,"en":"Became companions of Manas."},{"id":"manas-2010:p0684:b001:l035","ordinal":30529,"en":"Head of the forty, old Kyrgyl,"},{"id":"manas-2010:p0684:b001:l036","ordinal":30530,"en":"The mad old man who grew arrogant at forty,"},{"id":"manas-2010:p0684:b001:l037","ordinal":30531,"en":"Eldest of the companions who came,"},{"id":"manas-2010:p0684:b001:l038","ordinal":30532,"en":"Reckless in speech, abrupt in temper,"},{"id":"manas-2010:p0684:b001:l039","ordinal":30533,"en":"The troublemaker of the forty companions."},{"id":"manas-2010:p0684:b001:l040","ordinal":30534,"en":"Thinking mischief,"},{"id":"manas-2010:p0684:b001:l041","ordinal":30535,"en":"Even if he ruined everything,"},{"id":"manas-2010:p0684:b001:l042","ordinal":30536,"en":"Swift Manas, the leopard,"},{"id":"manas-2010:p0685:b001:l001","ordinal":30537,"en":"Never said, ‘He has ruined it.’"},{"id":"manas-2010:p0685:b001:l002","ordinal":30538,"en":"Serek, who entered clashing battle,"},{"id":"manas-2010:p0685:b001:l003","ordinal":30539,"en":"He too was a khan's son."},{"id":"manas-2010:p0685:b001:l004","ordinal":30540,"en":"Needed by Khan Manas,"},{"id":"manas-2010:p0685:b001:l005","ordinal":30541,"en":"He came and settled in Talas,"},{"id":"manas-2010:p0685:b001:l006","ordinal":30542,"en":"Became a companion of Manas."},{"id":"manas-2010:p0685:b001:l007","ordinal":30543,"en":"The diviner, Kara Tölök,"},{"id":"manas-2010:p0685:b001:l008","ordinal":30544,"en":"When waging war on all four sides,"},{"id":"manas-2010:p0685:b001:l009","ordinal":30545,"en":"For the warrior Lord Manas"},{"id":"manas-2010:p0685:b001:l010","ordinal":30546,"en":"Would cast divinations."},{"id":"manas-2010:p0685:b001:l011","ordinal":30547,"en":"Akzholtoy, Adyk Khan's son,"},{"id":"manas-2010:p0685:b001:l012","ordinal":30548,"en":"Like a countless army against foes exchanging shots,"},{"id":"manas-2010:p0685:b001:l013","ordinal":30549,"en":"Came and settled in Talas,"},{"id":"manas-2010:p0685:b001:l014","ordinal":30550,"en":"Became a companion of Manas."},{"id":"manas-2010:p0685:b001:l015","ordinal":30551,"en":"Never retreating from grappling enemies,"},{"id":"manas-2010:p0685:b001:l016","ordinal":30552,"en":"Never shrinking back from death,"},{"id":"manas-2010:p0685:b001:l017","ordinal":30553,"en":"Baychoro of Baabedin,"},{"id":"manas-2010:p0685:b001:l018","ordinal":30554,"en":"Clothed in deep-blue iron,"},{"id":"manas-2010:p0685:b001:l019","ordinal":30555,"en":"Grieving at the word of peace,"},{"id":"manas-2010:p0685:b001:l020","ordinal":30556,"en":"Rejoicing at the word of strife,"},{"id":"manas-2010:p0685:b001:l021","ordinal":30557,"en":"He too came to Talas,"},{"id":"manas-2010:p0685:b001:l022","ordinal":30558,"en":"Became a companion of Manas."},{"id":"manas-2010:p0685:b001:l023","ordinal":30559,"en":"Akzhaynak, Artyk Khan's son,"},{"id":"manas-2010:p0685:b001:l024","ordinal":30560,"en":"The skillful one among heroes,"},{"id":"manas-2010:p0685:b001:l025","ordinal":30561,"en":"Suddenly beginning to speak,"},{"id":"manas-2010:p0685:b001:l026","ordinal":30562,"en":"The mighty one who brightened brows,"},{"id":"manas-2010:p0685:b001:l027","ordinal":30563,"en":"The nightingale of the wise,"},{"id":"manas-2010:p0685:b001:l028","ordinal":30564,"en":"The noble falcon of young men,"},{"id":"manas-2010:p0685:b001:l029","ordinal":30565,"en":"He too came to Talas,"},{"id":"manas-2010:p0685:b001:l030","ordinal":30566,"en":"Became a companion of Manas."},{"id":"manas-2010:p0685:b001:l031","ordinal":30567,"en":"Sheep are treasure, bearing lambs;"},{"id":"manas-2010:p0685:b001:l032","ordinal":30568,"en":"He too became a companion now,"},{"id":"manas-2010:p0685:b001:l033","ordinal":30569,"en":"Boz Uul of Khan Manas."},{"id":"manas-2010:p0685:b001:l034","ordinal":30570,"en":"He too came to Talas,"},{"id":"manas-2010:p0685:b001:l035","ordinal":30571,"en":"Became a companion of Manas."},{"id":"manas-2010:p0685:b001:l036","ordinal":30572,"en":"Hearing news of the khan,"},{"id":"manas-2010:p0685:b001:l037","ordinal":30573,"en":"Hearing, ‘Leopard Manas has come,’"},{"id":"manas-2010:p0685:b001:l038","ordinal":30574,"en":"Beyond Bukhara the Noble,"},{"id":"manas-2010:p0685:b001:l039","ordinal":30575,"en":"On this side of ruined Chambyl,"},{"id":"manas-2010:p0685:b001:l040","ordinal":30576,"en":"Dwelling in that Chambyl,"},{"id":"manas-2010:p0685:b001:l041","ordinal":30577,"en":"Whom no man could defeat in wrestling,"},{"id":"manas-2010:p0685:b001:l042","ordinal":30578,"en":"His white beard an armful,"},{"id":"manas-2010:p0686:b001:l001","ordinal":30579,"en":"Muzburchak of Khan Buudayyk"},{"id":"manas-2010:p0686:b001:l002","ordinal":30580,"en":"Also came to Talas,"},{"id":"manas-2010:p0686:b001:l003","ordinal":30581,"en":"Became a companion to Manas."},{"id":"manas-2010:p0686:b001:l004","ordinal":30582,"en":"When Khan Ulak moved there,"},{"id":"manas-2010:p0686:b001:l005","ordinal":30583,"en":"All his affairs went well,"},{"id":"manas-2010:p0686:b001:l006","ordinal":30584,"en":"His wife bore a boy."},{"id":"manas-2010:p0686:b001:l007","ordinal":30585,"en":"Ninety beasts were killed for the feast,"},{"id":"manas-2010:p0686:b001:l008","ordinal":30586,"en":"He had him named Syrgak."},{"id":"manas-2010:p0686:b001:l009","ordinal":30587,"en":"Then it was that Khan Ulak"},{"id":"manas-2010:p0686:b001:l010","ordinal":30588,"en":"Laid him in his lap,"},{"id":"manas-2010:p0686:b001:l011","ordinal":30589,"en":"While he was still an infant,"},{"id":"manas-2010:p0686:b001:l012","ordinal":30590,"en":"And before your slaughterer"},{"id":"manas-2010:p0686:b001:l013","ordinal":30591,"en":"Brought him as an offering."},{"id":"manas-2010:p0686:b001:l014","ordinal":30592,"en":"Raise him, keep him living, do not let him die;"},{"id":"manas-2010:p0686:b001:l015","ordinal":30593,"en":"If he grows up safe and sound,"},{"id":"manas-2010:p0686:b001:l016","ordinal":30594,"en":"Make him one of the forty companions."},{"id":"manas-2010:p0686:b001:l017","ordinal":30595,"en":"Raised by you, he will be your support,"},{"id":"manas-2010:p0686:b001:l018","ordinal":30596,"en":"Your keenest of them all,"},{"id":"manas-2010:p0686:b001:l019","ordinal":30597,"en":"Light for a horse, fit for a yearling,"},{"id":"manas-2010:p0686:b001:l020","ordinal":30598,"en":"Sleepless, watchful on the road,"},{"id":"manas-2010:p0686:b001:l021","ordinal":30599,"en":"Never resting on his elbow,"},{"id":"manas-2010:p0686:b001:l022","ordinal":30600,"en":"Never taking even a brief nap,"},{"id":"manas-2010:p0686:b001:l023","ordinal":30601,"en":"Your sharp blade's edge of steel."},{"id":"manas-2010:p0686:b001:l024","ordinal":30602,"en":"If you raise him well,"},{"id":"manas-2010:p0686:b001:l025","ordinal":30603,"en":"Your Syrgak will overturn the world—"},{"id":"manas-2010:p0686:b001:l026","ordinal":30604,"en":"One of the wondrous tales."},{"id":"manas-2010:p0686:b001:l027","ordinal":30605,"en":"If you raise him for yourself,"},{"id":"manas-2010:p0686:b001:l028","ordinal":30606,"en":"One of the forty companions."},{"id":"manas-2010:p0686:b001:l029","ordinal":30607,"en":"(They hung an amulet around his neck,"},{"id":"manas-2010:p0686:b001:l030","ordinal":30608,"en":"Chewed horse-belly fat and fed him grease,"},{"id":"manas-2010:p0686:b001:l031","ordinal":30609,"en":"Had Chyyyrdy raise him;"},{"id":"manas-2010:p0686:b001:l032","ordinal":30610,"en":"All the forty companions,"},{"id":"manas-2010:p0686:b001:l033","ordinal":30611,"en":"Their elders Kyrgyl and Bakay,"},{"id":"manas-2010:p0686:b001:l034","ordinal":30612,"en":"Took him in their hands to weigh him,"},{"id":"manas-2010:p0686:b001:l035","ordinal":30613,"en":"The boy who was an infant,"},{"id":"manas-2010:p0686:b001:l036","ordinal":30614,"en":"As though trying to stand him up,"},{"id":"manas-2010:p0686:b001:l037","ordinal":30615,"en":"As though dividing out his inheritance.)"},{"id":"manas-2010:p0686:b001:l038","ordinal":30616,"en":"And besides him—"},{"id":"manas-2010:p0686:b001:l039","ordinal":30617,"en":"Akayar, who lifted camels."},{"id":"manas-2010:p0686:b001:l040","ordinal":30618,"en":"When he grew truly angry,"},{"id":"manas-2010:p0686:b001:l041","ordinal":30619,"en":"He started an uproar,"},{"id":"manas-2010:p0686:b001:l042","ordinal":30620,"en":"Aimed his fist at a camel and missed,"},{"id":"manas-2010:p0687:b001:l001","ordinal":30621,"en":"He arrived in Talas,"},{"id":"manas-2010:p0687:b001:l002","ordinal":30622,"en":"Became a companion to Manas."},{"id":"manas-2010:p0687:b001:l003","ordinal":30623,"en":"The horses grew fat and fit,"},{"id":"manas-2010:p0687:b001:l004","ordinal":30624,"en":"The marked heroes who shook the world"},{"id":"manas-2010:p0687:b001:l005","ordinal":30625,"en":"Gathered and numbered forty."},{"id":"manas-2010:p0687:b001:l006","ordinal":30626,"en":"One companion came without a coat;"},{"id":"manas-2010:p0687:b001:l007","ordinal":30627,"en":"For the companion without a coat,"},{"id":"manas-2010:p0687:b001:l008","ordinal":30628,"en":"With collar of gold and sleeves of brass,"},{"id":"manas-2010:p0687:b001:l009","ordinal":30629,"en":"Double mail with lark-eye links,"},{"id":"manas-2010:p0687:b001:l010","ordinal":30630,"en":"Mesh-woven armor, broad collar,"},{"id":"manas-2010:p0687:b001:l011","ordinal":30631,"en":"Which no bullet pierced when worn in battle—"},{"id":"manas-2010:p0687:b001:l012","ordinal":30632,"en":"Great Manas put a coat on him."},{"id":"manas-2010:p0687:b001:l013","ordinal":30633,"en":"One companion came without a horse;"},{"id":"manas-2010:p0687:b001:l014","ordinal":30634,"en":"For the companion without a horse,"},{"id":"manas-2010:p0687:b001:l015","ordinal":30635,"en":"Mountain-sheep feet and brass forelegs—"},{"id":"manas-2010:p0687:b001:l016","ordinal":30636,"en":"Great Manas gave him a horse to ride."},{"id":"manas-2010:p0687:b001:l017","ordinal":30637,"en":"For the companion without livestock,"},{"id":"manas-2010:p0687:b001:l018","ordinal":30638,"en":"Piebald-headed horses on the hills,"},{"id":"manas-2010:p0687:b001:l019","ordinal":30639,"en":"Thoroughbreds and fleet steeds mingled,"},{"id":"manas-2010:p0687:b001:l020","ordinal":30640,"en":"Great Manas allotted them."},{"id":"manas-2010:p0687:b001:l021","ordinal":30641,"en":"For the companion without a people,"},{"id":"manas-2010:p0687:b001:l022","ordinal":30642,"en":"The Argyn and the Kyrgyz"},{"id":"manas-2010:p0687:b001:l023","ordinal":30643,"en":"Great Manas allotted them."},{"id":"manas-2010:p0687:b001:l024","ordinal":30644,"en":"One companion came without a wife;"},{"id":"manas-2010:p0687:b001:l025","ordinal":30645,"en":"For the companion without a wife,"},{"id":"manas-2010:p0687:b001:l026","ordinal":30646,"en":"Thimble-mouthed, camel-calf-eyed,"},{"id":"manas-2010:p0687:b001:l027","ordinal":30647,"en":"Among the swaying beauties,"},{"id":"manas-2010:p0687:b001:l028","ordinal":30648,"en":"Crimson-dressed and moon-waisted,"},{"id":"manas-2010:p0687:b001:l029","ordinal":30649,"en":"Among the graceful beauties,"},{"id":"manas-2010:p0687:b001:l030","ordinal":30650,"en":"Great Manas procured a wife."},{"id":"manas-2010:p0687:b001:l031","ordinal":30651,"en":"Hopping on one foot, shooting knucklebones,"},{"id":"manas-2010:p0687:b001:l032","ordinal":30652,"en":"Playing chess and making a din,"},{"id":"manas-2010:p0687:b001:l033","ordinal":30653,"en":"Their blue lynx-fur hats"},{"id":"manas-2010:p0687:b001:l034","ordinal":30654,"en":"They kept swaying about;"},{"id":"manas-2010:p0687:b001:l035","ordinal":30655,"en":"Their spirits rose greatly,"},{"id":"manas-2010:p0687:b001:l036","ordinal":30656,"en":"They lived in delight."},{"id":"manas-2010:p0688:b001:l001","ordinal":30657,"en":"The leopard Manas became khan,"},{"id":"manas-2010:p0688:b001:l002","ordinal":30658,"en":"His wrath drove out men's souls."},{"id":"manas-2010:p0688:b001:l003","ordinal":30659,"en":"While he held dominion,"},{"id":"manas-2010:p0688:b001:l004","ordinal":30660,"en":"From the famed sacred capital of sheikhs,"},{"id":"manas-2010:p0688:b001:l005","ordinal":30661,"en":"From great Kokon and Margalang,"},{"id":"manas-2010:p0688:b001:l006","ordinal":30662,"en":"The lord of the white dwelling came:"},{"id":"manas-2010:p0688:b001:l007","ordinal":30663,"en":"Souls cannot bear his torment,"},{"id":"manas-2010:p0688:b001:l008","ordinal":30664,"en":"The black earth sways along with him,"},{"id":"manas-2010:p0688:b001:l009","ordinal":30665,"en":"His voice drives out souls,"},{"id":"manas-2010:p0688:b001:l010","ordinal":30666,"en":"His march raises dust,"},{"id":"manas-2010:p0688:b001:l011","ordinal":30667,"en":"His menace fierce, his venom strong,"},{"id":"manas-2010:p0688:b001:l012","ordinal":30668,"en":"That formidable khan Alöökö"},{"id":"manas-2010:p0688:b001:l013","ordinal":30669,"en":"Lays low those who oppose him."},{"id":"manas-2010:p0688:b001:l014","ordinal":30670,"en":"Wage abundant gunfire;"},{"id":"manas-2010:p0688:b001:l015","ordinal":30671,"en":"Alöökö's menace is unlike any other."},{"id":"manas-2010:p0688:b001:l016","ordinal":30672,"en":"The palm-sized handful of Muslims,"},{"id":"manas-2010:p0688:b001:l017","ordinal":30673,"en":"If your lionhood is true,"},{"id":"manas-2010:p0688:b001:l018","ordinal":30674,"en":"Set them free."},{"id":"manas-2010:p0688:b001:l019","ordinal":30675,"en":"Seated on the throne in Margalang,"},{"id":"manas-2010:p0688:b001:l020","ordinal":30676,"en":"He is at the height of his power;"},{"id":"manas-2010:p0688:b001:l021","ordinal":30677,"en":"Those who talk back,"},{"id":"manas-2010:p0688:b001:l022","ordinal":30678,"en":"Alöökö slaughters like sheep,"},{"id":"manas-2010:p0688:b001:l023","ordinal":30679,"en":"He is slaughtering them now."},{"id":"manas-2010:p0688:b001:l024","ordinal":30680,"en":"Whatever Alöökö himself pleases,"},{"id":"manas-2010:p0688:b001:l025","ordinal":30681,"en":"He is doing it now."},{"id":"manas-2010:p0688:b001:l026","ordinal":30682,"en":"Those who talk back,"},{"id":"manas-2010:p0688:b001:l027","ordinal":30683,"en":"He crushes their stones to powder,"},{"id":"manas-2010:p0688:b001:l028","ordinal":30684,"en":"He is slaughtering them now."},{"id":"manas-2010:p0688:b001:l029","ordinal":30685,"en":"Alty-Shaar and Margalang,"},{"id":"manas-2010:p0688:b001:l030","ordinal":30686,"en":"In his net of iron ropes,"},{"id":"manas-2010:p0688:b001:l031","ordinal":30687,"en":"We cannot get free"},{"id":"manas-2010:p0688:b001:l032","ordinal":30688,"en":"From Alöökö's hands."},{"id":"manas-2010:p0688:b001:l033","ordinal":30689,"en":"Alöökö's tribute—"},{"id":"manas-2010:p0688:b001:l034","ordinal":30690,"en":"If you do not free us,"},{"id":"manas-2010:p0688:b001:l035","ordinal":30691,"en":"His tyranny grows worse."},{"id":"manas-2010:p0688:b001:l036","ordinal":30692,"en":"He has inflicted humiliation on Kokon,"},{"id":"manas-2010:p0688:b001:l037","ordinal":30693,"en":"Six thousand silver ingots, a thousand otter pelts,"},{"id":"manas-2010:p0688:b001:l038","ordinal":30694,"en":"He has taken in tribute every month."},{"id":"manas-2010:p0688:b001:l039","ordinal":30695,"en":"Unable to bear his tribute,"},{"id":"manas-2010:p0688:b001:l040","ordinal":30696,"en":"The poor people cry out."},{"id":"manas-2010:p0688:b001:l041","ordinal":30697,"en":"He took the skilled women,"},{"id":"manas-2010:p0688:b001:l042","ordinal":30698,"en":"Using force and breaking them,"},{"id":"manas-2010:p0689:b001:l001","ordinal":30699,"en":"Thimble-mouthed, camel-calf-eyed,"},{"id":"manas-2010:p0689:b001:l002","ordinal":30700,"en":"He took the swaying girls."},{"id":"manas-2010:p0689:b001:l003","ordinal":30701,"en":"He took livestock as a levy;"},{"id":"manas-2010:p0689:b001:l004","ordinal":30702,"en":"From Alöökö's wrath"},{"id":"manas-2010:p0689:b001:l005","ordinal":30703,"en":"The whole people fled and wandered."},{"id":"manas-2010:p0689:b001:l006","ordinal":30704,"en":"He diminished the holy lords,"},{"id":"manas-2010:p0689:b001:l007","ordinal":30705,"en":"The men who headed every village,"},{"id":"manas-2010:p0689:b001:l008","ordinal":30706,"en":"He left them all bereft alike."},{"id":"manas-2010:p0689:b001:l009","ordinal":30707,"en":"He seized their oxen and took their stock."},{"id":"manas-2010:p0689:b001:l010","ordinal":30708,"en":"If you yourself do not help,"},{"id":"manas-2010:p0689:b001:l011","ordinal":30709,"en":"Your people are dying and scattered."},{"id":"manas-2010:p0689:b001:l012","ordinal":30710,"en":"Alöökö has become a mighty khan,"},{"id":"manas-2010:p0689:b001:l013","ordinal":30711,"en":"His menace drives out souls."},{"id":"manas-2010:p0689:b001:l014","ordinal":30712,"en":"'He will reach our very roots,' we say,"},{"id":"manas-2010:p0689:b001:l015","ordinal":30713,"en":"And despair of our lives."},{"id":"manas-2010:p0689:b001:l016","ordinal":30714,"en":"'He will slaughter us all,' we say."},{"id":"manas-2010:p0689:b001:l017","ordinal":30715,"en":"Alöökö who came to the white dwelling—"},{"id":"manas-2010:p0689:b001:l018","ordinal":30716,"en":"This is his tale."},{"id":"manas-2010:p0689:b001:l019","ordinal":30717,"en":"To Alöökö's presence"},{"id":"manas-2010:p0689:b001:l020","ordinal":30718,"en":"No man went back and forth."},{"id":"manas-2010:p0689:b001:l021","ordinal":30719,"en":"That pig was stubborn;"},{"id":"manas-2010:p0689:b001:l022","ordinal":30720,"en":"None who met him escaped death."}]
