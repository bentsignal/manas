{"id": "sayakbay-ms-current146:pdf185:l009", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 185, "folio": 568, "line_in_page": 9, "raw": "Жок бийликке чийилген,", "text": "Жок бийликке чийилген,", "en": "It was inscribed under a vanished rule.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, proper name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf185:l010", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 185, "folio": 568, "line_in_page": 10, "raw": "Бурутту ала коём деп,", "text": "Бурутту ала коём деп,", "en": "Saying, “I shall take the Burut,”", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf185:l011", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 185, "folio": 568, "line_in_page": 11, "raw": "Бу кабарды укканда,", "text": "Бу кабарды укканда,", "en": "When they heard this news,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf185:l012", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 185, "folio": 568, "line_in_page": 12, "raw": "Какендан хандар аттанган,", "text": "Какендан хандар аттанган,", "en": "The khans rode out from Kaken.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, proper name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf185:l013", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 185, "folio": 568, "line_in_page": 13, "raw": "Кабылан кайра тартпаган,", "text": "Кабылан кайра тартпаган,", "en": "The lion never turned back.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
