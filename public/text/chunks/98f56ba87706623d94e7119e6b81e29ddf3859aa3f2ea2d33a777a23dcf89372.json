[{"id":"semetey-1-2013:p1079:b003:l033","ordinal":159489,"en":"If he suddenly arrives,"},{"id":"semetey-1-2013:p1079:b003:l034","ordinal":159490,"en":"If Toltoy unexpectedly appears,"},{"id":"semetey-1-2013:p1079:b003:l035","ordinal":159491,"en":"Let us level our spears straight"},{"id":"semetey-1-2013:p1079:b003:l036","ordinal":159492,"en":"And fight without drawing back."},{"id":"semetey-1-2013:p1079:b003:l037","ordinal":159493,"en":"Let us be drenched in bloody blood,"},{"id":"semetey-1-2013:p1079:b003:l038","ordinal":159494,"en":"And stand fighting without fleeing."},{"id":"semetey-1-2013:p1079:b003:l039","ordinal":159495,"en":"If brave Toltoy suddenly turns and runs,"},{"id":"semetey-1-2013:p1079:b004:l001","ordinal":159496,"en":"Buurul will drive him onto the plain;"},{"id":"semetey-1-2013:p1079:b004:l002","ordinal":159497,"en":"From the feather-grass-covered rise,"},{"id":"semetey-1-2013:p1079:b004:l003","ordinal":159498,"en":"From the broad-backed high pass,"},{"id":"semetey-1-2013:p1079:b004:l004","ordinal":159499,"en":"Unless he dies, Buurul will catch him."},{"id":"semetey-1-2013:p1079:b004:l005","ordinal":159500,"en":"God, guide the path"},{"id":"semetey-1-2013:p1079:b004:l006","ordinal":159501,"en":"Of the lions gone before;"},{"id":"semetey-1-2013:p1079:b004:l007","ordinal":159502,"en":"Lion Manas, with whom twelve joined hands,"},{"id":"semetey-1-2013:p1079:b004:l008","ordinal":159503,"en":"Stand as my protector.\""},{"id":"semetey-1-2013:p1079:b004:l009","ordinal":159504,"en":"Growing bold and bracing himself,"},{"id":"semetey-1-2013:p1079:b004:l010","ordinal":159505,"en":"The renowned leopard kinsman"},{"id":"semetey-1-2013:p1079:b004:l011","ordinal":159506,"en":"Swayed as though struck from this side."},{"id":"semetey-1-2013:p1079:b004:l012","ordinal":159507,"en":"Humming, without a care:"},{"id":"semetey-1-2013:p1079:b004:l013","ordinal":159508,"en":"\"Toltoy of the Zhediger"},{"id":"semetey-1-2013:p1079:b004:l014","ordinal":159509,"en":"Is said to be approaching.\""},{"id":"semetey-1-2013:p1079:b004:l015","ordinal":159510,"en":"He did not value him at his trouser cuff."},{"id":"semetey-1-2013:p1079:b004:l016","ordinal":159511,"en":"God Almighty, the Omnipotent,"},{"id":"semetey-1-2013:p1079:b004:l017","ordinal":159512,"en":"Had given courage and proud daring"},{"id":"semetey-1-2013:p1079:b004:l018","ordinal":159513,"en":"Without measure."},{"id":"semetey-1-2013:p1079:b004:l019","ordinal":159514,"en":"The leopard's Syrnayza—"},{"id":"semetey-1-2013:p1079:b004:l020","ordinal":159515,"en":"Ill-fated Külchoro"},{"id":"semetey-1-2013:p1079:b004:l021","ordinal":159516,"en":"Now took it firmly in his hand."},{"id":"semetey-1-2013:p1079:b004:l022","ordinal":159517,"en":"The white reins steeped in dye"},{"id":"semetey-1-2013:p1079:b004:l023","ordinal":159518,"en":"He wound twice around"},{"id":"semetey-1-2013:p1079:b004:l024","ordinal":159519,"en":"The pommel of Akkangky."},{"id":"semetey-1-2013:p1079:b004:l025","ordinal":159520,"en":"Saying, \"I take the risk—Allah, support me,\""},{"id":"semetey-1-2013:p1079:b004:l026","ordinal":159521,"en":"He now planted Semetey's Syrnayza"},{"id":"semetey-1-2013:p1079:b004:l027","ordinal":159522,"en":"Firmly into the earth."},{"id":"semetey-1-2013:p1079:b004:l028","ordinal":159523,"en":"He now set up a stone support."},{"id":"semetey-1-2013:p1079:b004:l029","ordinal":159524,"en":"Without saying Toltoy was coming,"},{"id":"semetey-1-2013:p1079:b004:l030","ordinal":159525,"en":"Lion-born Külchoro"},{"id":"semetey-1-2013:p1079:b004:l031","ordinal":159526,"en":"Grew weary and fell asleep."},{"id":"semetey-1-2013:p1079:b004:l032","ordinal":159527,"en":"He now began to snore;"},{"id":"semetey-1-2013:p1079:b004:l033","ordinal":159528,"en":"Fearless Külchoro"},{"id":"semetey-1-2013:p1079:b004:l034","ordinal":159529,"en":"Slept on without stirring."},{"id":"semetey-1-2013:p1079:b004:l035","ordinal":159530,"en":"He lay there propped up,"},{"id":"semetey-1-2013:p1079:b004:l036","ordinal":159531,"en":"Sleeping in the saddle."},{"id":"semetey-1-2013:p1079:b004:l037","ordinal":159532,"en":"As for Külchoro's guest,"},{"id":"semetey-1-2013:p1079:b004:l038","ordinal":159533,"en":"Now let me tell"},{"id":"semetey-1-2013:p1079:b004:l039","ordinal":159534,"en":"The tale of brave Toltoy."},{"id":"semetey-1-2013:p1080:b004:l001","ordinal":159535,"en":"Chynkozho, son of Shygay,"},{"id":"semetey-1-2013:p1080:b004:l002","ordinal":159536,"en":"Kozho, costly and forceful in his deeds,"},{"id":"semetey-1-2013:p1080:b004:l003","ordinal":159537,"en":"Of Argyn-Kyrgyz stock,"},{"id":"semetey-1-2013:p1080:b004:l004","ordinal":159538,"en":"Kozho whose fortune was complete,"},{"id":"semetey-1-2013:p1080:b004:l005","ordinal":159539,"en":"A renowned hero among"},{"id":"semetey-1-2013:p1080:b004:l006","ordinal":159540,"en":"Round-headed mortals."},{"id":"semetey-1-2013:p1080:b004:l007","ordinal":159541,"en":"Taking instruction from Manas,"},{"id":"semetey-1-2013:p1080:b004:l008","ordinal":159542,"en":"Lion Kozho had seen many things."},{"id":"semetey-1-2013:p1080:b004:l009","ordinal":159543,"en":"Dear Kozho, the brave servant,"},{"id":"semetey-1-2013:p1080:b004:l010","ordinal":159544,"en":"Had a black hat large as a cauldron;"},{"id":"semetey-1-2013:p1080:b004:l011","ordinal":159545,"en":"The brave-born Karkybar"},{"id":"semetey-1-2013:p1080:b004:l012","ordinal":159546,"en":"Had stature worth an army."},{"id":"semetey-1-2013:p1080:b004:l013","ordinal":159547,"en":"His appearance was more fearsome than a man's;"},{"id":"semetey-1-2013:p1080:b004:l014","ordinal":159548,"en":"He had the will to rule"},{"id":"semetey-1-2013:p1080:b004:l015","ordinal":159549,"en":"The eighteen thousand worlds."},{"id":"semetey-1-2013:p1080:b004:l016","ordinal":159550,"en":"There was authority upon his brow;"},{"id":"semetey-1-2013:p1080:b004:l017","ordinal":159551,"en":"He had the power to shout commands"},{"id":"semetey-1-2013:p1080:b004:l018","ordinal":159552,"en":"To all the Zhediger."},{"id":"semetey-1-2013:p1080:b004:l019","ordinal":159553,"en":"For fear of Chynkozho's wrath,"},{"id":"semetey-1-2013:p1080:b004:l020","ordinal":159554,"en":"No person came repeatedly before him."},{"id":"semetey-1-2013:p1080:b004:l021","ordinal":159555,"en":"The vast black Zhediger,"},{"id":"semetey-1-2013:p1080:b004:l022","ordinal":159556,"en":"Led by Khan Toltoy,"},{"id":"semetey-1-2013:p1080:b004:l023","ordinal":159557,"en":"Gave him no answer back."},{"id":"semetey-1-2013:p1080:b004:l024","ordinal":159558,"en":"At that time no one"},{"id":"semetey-1-2013:p1080:b004:l025","ordinal":159559,"en":"Paid Kozho any heed;"},{"id":"semetey-1-2013:p1080:b004:l026","ordinal":159560,"en":"When Kozho grew impetuous,"},{"id":"semetey-1-2013:p1080:b004:l027","ordinal":159561,"en":"No one remained to turn back his lasso."},{"id":"semetey-1-2013:p1080:b004:l028","ordinal":159562,"en":"His menace was fierce, his venom strong;"},{"id":"semetey-1-2013:p1080:b004:l029","ordinal":159563,"en":"When Chynkozho grew angry,"},{"id":"semetey-1-2013:p1080:b004:l030","ordinal":159564,"en":"He flattened the Zhediger."},{"id":"semetey-1-2013:p1080:b004:l031","ordinal":159565,"en":"When true frenzy seized him,"},{"id":"semetey-1-2013:p1080:b004:l032","ordinal":159566,"en":"Chynkozho's Black Horse"},{"id":"semetey-1-2013:p1080:b004:l033","ordinal":159567,"en":"Had wings"},{"id":"semetey-1-2013:p1080:b004:l034","ordinal":159568,"en":"Along its flanks."},{"id":"semetey-1-2013:p1080:b004:l035","ordinal":159569,"en":"When Chynkozho grew angry,"},{"id":"semetey-1-2013:p1080:b004:l036","ordinal":159570,"en":"He habitually struck all the Zhediger"},{"id":"semetey-1-2013:p1080:b004:l037","ordinal":159571,"en":"And crushed them like grain."},{"id":"semetey-1-2013:p1080:b005:l001","ordinal":159572,"en":"He had a people who raged;"},{"id":"semetey-1-2013:p1080:b005:l002","ordinal":159573,"en":"Have you heard the news?"},{"id":"semetey-1-2013:p1080:b005:l003","ordinal":159574,"en":"When his courage flared,"},{"id":"semetey-1-2013:p1080:b005:l004","ordinal":159575,"en":"He customarily drank the blood"},{"id":"semetey-1-2013:p1080:b005:l005","ordinal":159576,"en":"Of all the Zhediger."},{"id":"semetey-1-2013:p1080:b005:l006","ordinal":159577,"en":"Brave Kozho, son of Shygay,"},{"id":"semetey-1-2013:p1080:b005:l007","ordinal":159578,"en":"Had he not brought upon them"},{"id":"semetey-1-2013:p1080:b005:l008","ordinal":159579,"en":"Turmoil no person had seen?"},{"id":"semetey-1-2013:p1080:b005:l009","ordinal":159580,"en":"Promising to obtain Aychürök,"},{"id":"semetey-1-2013:p1080:b005:l010","ordinal":159581,"en":"Had he not driven and brought"},{"id":"semetey-1-2013:p1080:b005:l011","ordinal":159582,"en":"The vast black Zhediger,"},{"id":"semetey-1-2013:p1080:b005:l012","ordinal":159583,"en":"All of them rank by rank?"},{"id":"semetey-1-2013:p1080:b005:l013","ordinal":159584,"en":"To bring disorder upon Afghanistan,"},{"id":"semetey-1-2013:p1080:b005:l014","ordinal":159585,"en":"To seize Aychürök,"},{"id":"semetey-1-2013:p1080:b005:l015","ordinal":159586,"en":"Had he not led here"},{"id":"semetey-1-2013:p1080:b005:l016","ordinal":159587,"en":"All the Zhediger?"},{"id":"semetey-1-2013:p1080:b005:l017","ordinal":159588,"en":"Had the Zhediger not helplessly left"},{"id":"semetey-1-2013:p1080:b005:l018","ordinal":159589,"en":"Their own wealth behind"},{"id":"semetey-1-2013:p1080:b005:l019","ordinal":159590,"en":"In Zheti-Özön?"},{"id":"semetey-1-2013:p1080:b005:l020","ordinal":159591,"en":"When the sun sank shimmering,"},{"id":"semetey-1-2013:p1080:b005:l021","ordinal":159592,"en":"Chynkozho, son of Shygay,"},{"id":"semetey-1-2013:p1080:b005:l022","ordinal":159593,"en":"Wrapped himself in his mottled blue coat."},{"id":"semetey-1-2013:p1080:b005:l023","ordinal":159594,"en":"If you had seen Chynkozho,"},{"id":"semetey-1-2013:p1080:b005:l024","ordinal":159595,"en":"He strained like a blue bear;"},{"id":"semetey-1-2013:p1080:b005:l025","ordinal":159596,"en":"In anger he began"},{"id":"semetey-1-2013:p1080:b005:l026","ordinal":159597,"en":"To speak harsh words to Toltoy."},{"id":"semetey-1-2013:p1080:b005:l027","ordinal":159598,"en":"Chynkozho overwhelmed"},{"id":"semetey-1-2013:p1080:b005:l028","ordinal":159599,"en":"And all but devoured"},{"id":"semetey-1-2013:p1080:b005:l029","ordinal":159600,"en":"Every one of the Zhediger."},{"id":"semetey-1-2013:p1080:b005:l030","ordinal":159601,"en":"All the Zhediger,"},{"id":"semetey-1-2013:p1080:b005:l031","ordinal":159602,"en":"Including Tölöbay and old Kalcha, said:"},{"id":"semetey-1-2013:p1080:b005:l032","ordinal":159603,"en":"\"When we said Kozho had come,"},{"id":"semetey-1-2013:p1080:b005:l033","ordinal":159604,"en":"It was disaster that had come!"},{"id":"semetey-1-2013:p1080:b005:l034","ordinal":159605,"en":"When we thought a hero had come,"},{"id":"semetey-1-2013:p1080:b005:l035","ordinal":159606,"en":"It was calamity that had come!"},{"id":"semetey-1-2013:p1080:b005:l036","ordinal":159607,"en":"We were a people living at ease;"},{"id":"semetey-1-2013:p1080:b005:l037","ordinal":159608,"en":"Will God strike us for his frenzy?\""},{"id":"semetey-1-2013:p1081:b003:l001","ordinal":159609,"en":"\"By contriving his way along, this Kozho"},{"id":"semetey-1-2013:p1081:b003:l002","ordinal":159610,"en":"Will slaughter all the people!\""},{"id":"semetey-1-2013:p1081:b003:l003","ordinal":159611,"en":"They split apart,"},{"id":"semetey-1-2013:p1081:b003:l004","ordinal":159612,"en":"And whispered among themselves."},{"id":"semetey-1-2013:p1081:b003:l005","ordinal":159613,"en":"Was this the edge of the Zhediger,"},{"id":"semetey-1-2013:p1081:b003:l006","ordinal":159614,"en":"Or the shameless face of those people"},{"id":"semetey-1-2013:p1081:b003:l007","ordinal":159615,"en":"Who spoke their words openly?"},{"id":"semetey-1-2013:p1081:b003:l008","ordinal":159616,"en":"If you take heed, Chynkozho"},{"id":"semetey-1-2013:p1081:b003:l009","ordinal":159617,"en":"Had heard the edge"},{"id":"semetey-1-2013:p1081:b003:l010","ordinal":159618,"en":"Of those sly words just spoken,"},{"id":"semetey-1-2013:p1081:b003:l011","ordinal":159619,"en":"And had heard the end"},{"id":"semetey-1-2013:p1081:b003:l012","ordinal":159620,"en":"Of the ominous words now uttered."},{"id":"semetey-1-2013:p1081:b003:l013","ordinal":159621,"en":"Having heard them, Chynkozho"},{"id":"semetey-1-2013:p1081:b003:l014","ordinal":159622,"en":"Grew angry;"},{"id":"semetey-1-2013:p1081:b003:l015","ordinal":159623,"en":"Chynkozho pounded the earth."},{"id":"semetey-1-2013:p1081:b003:l016","ordinal":159624,"en":"Surrendering wholly to his courage,"},{"id":"semetey-1-2013:p1081:b003:l017","ordinal":159625,"en":"He shouted out his words:"},{"id":"semetey-1-2013:p1081:b003:l018","ordinal":159626,"en":"\"Vast black Zhediger,"},{"id":"semetey-1-2013:p1081:b003:l019","ordinal":159627,"en":"You have seen my courage;"},{"id":"semetey-1-2013:p1081:b003:l020","ordinal":159628,"en":"All of you came here"},{"id":"semetey-1-2013:p1081:b003:l021","ordinal":159629,"en":"Asking me to obtain a wife for you."},{"id":"semetey-1-2013:p1081:b003:l022","ordinal":159630,"en":"Speaking two by two,"},{"id":"semetey-1-2013:p1081:b003:l023","ordinal":159631,"en":"What did you just say?"},{"id":"semetey-1-2013:p1081:b003:l024","ordinal":159632,"en":"Sons of bitches, Zhediger—"},{"id":"semetey-1-2013:p1081:b003:l025","ordinal":159633,"en":"If you flee, you will eat shit!"},{"id":"semetey-1-2013:p1081:b003:l026","ordinal":159634,"en":"Vast black Zhediger,"},{"id":"semetey-1-2013:p1081:b003:l027","ordinal":159635,"en":"Let your bearded elders come;"},{"id":"semetey-1-2013:p1081:b003:l028","ordinal":159636,"en":"Come, all you Zhediger!"},{"id":"semetey-1-2013:p1081:b003:l029","ordinal":159637,"en":"Let your finest spearman come,"},{"id":"semetey-1-2013:p1081:b003:l030","ordinal":159638,"en":"Your strongest battle-axe wielder come,"},{"id":"semetey-1-2013:p1081:b003:l031","ordinal":159639,"en":"Your ablest deviser of means come."},{"id":"semetey-1-2013:p1081:b003:l032","ordinal":159640,"en":"Let your elder who has seen much come;"},{"id":"semetey-1-2013:p1081:b003:l033","ordinal":159641,"en":"Come, every one of you with sense."},{"id":"semetey-1-2013:p1081:b003:l034","ordinal":159642,"en":"I shall place the matter before you"},{"id":"semetey-1-2013:p1081:b003:l035","ordinal":159643,"en":"And find the means to settle it."},{"id":"semetey-1-2013:p1081:b003:l036","ordinal":159644,"en":"If the old man will not give his daughter,"},{"id":"semetey-1-2013:p1081:b003:l037","ordinal":159645,"en":"I shall ride headlong against"},{"id":"semetey-1-2013:p1081:b003:l038","ordinal":159646,"en":"Those sons of bitches, the Afghans,"},{"id":"semetey-1-2013:p1081:b003:l039","ordinal":159647,"en":"And find the full means to settle it."},{"id":"semetey-1-2013:p1081:b005:l001","ordinal":159648,"en":"Yesterday Tümönbay, son of Tülkü,"},{"id":"semetey-1-2013:p1081:b005:l002","ordinal":159649,"en":"And Azhybay, son of Azhy,"},{"id":"semetey-1-2013:p1081:b005:l003","ordinal":159650,"en":"Carried wondrous words between us:"},{"id":"semetey-1-2013:p1081:b005:l004","ordinal":159651,"en":"Before six days had passed,"},{"id":"semetey-1-2013:p1081:b005:l005","ordinal":159652,"en":"They left promising to give Aychürök."},{"id":"semetey-1-2013:p1081:b005:l006","ordinal":159653,"en":"Vast black Zhediger!"},{"id":"semetey-1-2013:p1081:b005:l007","ordinal":159654,"en":"What do you say to Toltoy going"},{"id":"semetey-1-2013:p1081:b005:l008","ordinal":159655,"en":"As bridegroom to Akun?"},{"id":"semetey-1-2013:p1081:b005:l009","ordinal":159656,"en":"What do you say to Toltoy staying,"},{"id":"semetey-1-2013:p1081:b005:l010","ordinal":159657,"en":"Immersed in a wondrous pleasure,"},{"id":"semetey-1-2013:p1081:b005:l011","ordinal":159658,"en":"Lying in one bed,"},{"id":"semetey-1-2013:p1081:b005:l012","ordinal":159659,"en":"Eating meat from one dish,"},{"id":"semetey-1-2013:p1081:b005:l013","ordinal":159660,"en":"Facing each other over one dish?"},{"id":"semetey-1-2013:p1081:b005:l014","ordinal":159661,"en":"What do you say to Toltoy coming?"},{"id":"semetey-1-2013:p1081:b005:l015","ordinal":159662,"en":"O Zhediger, vast multitude!"},{"id":"semetey-1-2013:p1081:b005:l016","ordinal":159663,"en":"Rise and speak plainly;"},{"id":"semetey-1-2013:p1081:b005:l017","ordinal":159664,"en":"Without groaning as though struck ten times,"},{"id":"semetey-1-2013:p1081:b005:l018","ordinal":159665,"en":"Speak quickly."},{"id":"semetey-1-2013:p1081:b005:l019","ordinal":159666,"en":"Think of what comes after and speak;"},{"id":"semetey-1-2013:p1081:b005:l020","ordinal":159667,"en":"Let the matter remain clear."},{"id":"semetey-1-2013:p1081:b005:l021","ordinal":159668,"en":"Hold back no evident secret—speak.\""},{"id":"semetey-1-2013:p1081:b005:l022","ordinal":159669,"en":"Chynkozho, son of Shygay,"},{"id":"semetey-1-2013:p1081:b005:l023","ordinal":159670,"en":"Growled and surged;"},{"id":"semetey-1-2013:p1081:b005:l024","ordinal":159671,"en":"He spoke to the vast black Zhediger,"},{"id":"semetey-1-2013:p1081:b005:l025","ordinal":159672,"en":"Demanding that they answer."},{"id":"semetey-1-2013:p1081:b005:l026","ordinal":159673,"en":"Kozho stood roaring."},{"id":"semetey-1-2013:p1081:b005:l027","ordinal":159674,"en":"Among the vast black Zhediger,"},{"id":"semetey-1-2013:p1081:b005:l028","ordinal":159675,"en":"There was no one to speak."},{"id":"semetey-1-2013:p1081:b005:l029","ordinal":159676,"en":"Chynkozho's shout"},{"id":"semetey-1-2013:p1081:b005:l030","ordinal":159677,"en":"Sounded like lightning;"},{"id":"semetey-1-2013:p1081:b005:l031","ordinal":159678,"en":"Of all the Zhediger,"},{"id":"semetey-1-2013:p1081:b005:l032","ordinal":159679,"en":"Not one soul raised himself."},{"id":"semetey-1-2013:p1081:b005:l033","ordinal":159680,"en":"Their heads sank into the ground;"},{"id":"semetey-1-2013:p1081:b005:l034","ordinal":159681,"en":"They looked down and whimpered,"},{"id":"semetey-1-2013:p1081:b005:l035","ordinal":159682,"en":"Scratching the earth and groaning."},{"id":"semetey-1-2013:p1081:b005:l036","ordinal":159683,"en":"Even their strongest, old Tölök,"},{"id":"semetey-1-2013:p1081:b005:l037","ordinal":159684,"en":"As though slaughter had struck,"},{"id":"semetey-1-2013:p1081:b005:l038","ordinal":159685,"en":"Collapsed into whimpering;"},{"id":"semetey-1-2013:p1081:b005:l039","ordinal":159686,"en":"All the Zhediger did the same."},{"id":"semetey-1-2013:p1082:b003:l001","ordinal":159687,"en":"For as long as meat took to cook,"},{"id":"semetey-1-2013:p1082:b003:l002","ordinal":159688,"en":"All the Zhediger"},{"id":"semetey-1-2013:p1082:b003:l003","ordinal":159689,"en":"Remained without moving."},{"id":"semetey-1-2013:p1082:b003:l004","ordinal":159690,"en":"Brave Toltoy, son of Bagysh,"},{"id":"semetey-1-2013:p1082:b003:l005","ordinal":159691,"en":"Jerked his head up from the ground."},{"id":"semetey-1-2013:p1082:b003:l006","ordinal":159692,"en":"Honking like a young goose,"},{"id":"semetey-1-2013:p1082:b003:l007","ordinal":159693,"en":"He spoke words of substance;"},{"id":"semetey-1-2013:p1082:b003:l008","ordinal":159694,"en":"Brave Toltoy voiced"},{"id":"semetey-1-2013:p1082:b003:l009","ordinal":159695,"en":"His lament to Kozho:"},{"id":"semetey-1-2013:p1082:b003:l010","ordinal":159696,"en":"\"Stop, Kozho, my dear friend;"},{"id":"semetey-1-2013:p1082:b003:l011","ordinal":159697,"en":"Let us not take Chürök,"},{"id":"semetey-1-2013:p1082:b003:l012","ordinal":159698,"en":"And let us not incur her calamity."},{"id":"semetey-1-2013:p1082:b003:l013","ordinal":159699,"en":"Let us not be entangled together in torment,"},{"id":"semetey-1-2013:p1082:b003:l014","ordinal":159700,"en":"Go and join ourselves to death,"},{"id":"semetey-1-2013:p1082:b003:l015","ordinal":159701,"en":"Or meet humiliation like sheep."},{"id":"semetey-1-2013:p1082:b003:l016","ordinal":159702,"en":"Standing there with proud posturing,"},{"id":"semetey-1-2013:p1082:b003:l017","ordinal":159703,"en":"Let us not unexpectedly become a slaughter."},{"id":"semetey-1-2013:p1082:b003:l018","ordinal":159704,"en":"Let us not turn back from death in vain;"},{"id":"semetey-1-2013:p1082:b003:l019","ordinal":159705,"en":"Let us not be defeated and retreat."},{"id":"semetey-1-2013:p1082:b003:l020","ordinal":159706,"en":"If we are unexpectedly defeated,"},{"id":"semetey-1-2013:p1082:b003:l021","ordinal":159707,"en":"If we are suddenly pierced through,"},{"id":"semetey-1-2013:p1082:b003:l022","ordinal":159708,"en":"And made into a great spectacle,"},{"id":"semetey-1-2013:p1082:b003:l023","ordinal":159709,"en":"Let us not have the vast black Zhediger"},{"id":"semetey-1-2013:p1082:b003:l024","ordinal":159710,"en":"Slaughtered for Aychürök"},{"id":"semetey-1-2013:p1082:b003:l025","ordinal":159711,"en":"And bear the guilt for them."},{"id":"semetey-1-2013:p1082:b003:l026","ordinal":159712,"en":"Let us scatter our ashen provisions"},{"id":"semetey-1-2013:p1082:b003:l027","ordinal":159713,"en":"And flee from this Opol."},{"id":"semetey-1-2013:p1082:b003:l028","ordinal":159714,"en":"What shall we do with Aychürök?"},{"id":"semetey-1-2013:p1082:b003:l029","ordinal":159715,"en":"Come, my friend, let us leave."},{"id":"semetey-1-2013:p1082:b003:l030","ordinal":159716,"en":"Let us turn back and remain alive;"},{"id":"semetey-1-2013:p1082:b003:l031","ordinal":159717,"en":"Let us go to that darkened mountain."},{"id":"semetey-1-2013:p1082:b003:l032","ordinal":159718,"en":"Let us study its pass and cross;"},{"id":"semetey-1-2013:p1082:b003:l033","ordinal":159719,"en":"On the far side, let us overrun the Karabash people."},{"id":"semetey-1-2013:p1082:b003:l034","ordinal":159720,"en":"Let us train Zulpukor"},{"id":"semetey-1-2013:p1082:b003:l035","ordinal":159721,"en":"And overrun the Karabash land."},{"id":"semetey-1-2013:p1082:b003:l036","ordinal":159722,"en":"Let us take a dark bay maiden,"},{"id":"semetey-1-2013:p1082:b003:l037","ordinal":159723,"en":"Name her Aychürök, and praise her."},{"id":"semetey-1-2013:p1082:b003:l038","ordinal":159724,"en":"Having seized her as plunder,"},{"id":"semetey-1-2013:p1082:b003:l039","ordinal":159725,"en":"Let us slaughter ninety beasts for her feast"},{"id":"semetey-1-2013:p1082:b004:l001","ordinal":159726,"en":"And abandon this conflict."},{"id":"semetey-1-2013:p1082:b004:l002","ordinal":159727,"en":"Let us travel along the mountain ridges"},{"id":"semetey-1-2013:p1082:b004:l003","ordinal":159728,"en":"And choose a sloping way across."},{"id":"semetey-1-2013:p1082:b004:l004","ordinal":159729,"en":"On the far side, let us overrun"},{"id":"semetey-1-2013:p1082:b004:l005","ordinal":159730,"en":"The seething Kyzylbash people."},{"id":"semetey-1-2013:p1082:b004:l006","ordinal":159731,"en":"Let us take a reddish-bay maiden,"},{"id":"semetey-1-2013:p1082:b004:l007","ordinal":159732,"en":"Name her Kyzchürök, and praise her."},{"id":"semetey-1-2013:p1082:b004:l008","ordinal":159733,"en":"Let us not take Aychürök"},{"id":"semetey-1-2013:p1082:b004:l009","ordinal":159734,"en":"And remain needlessly in torment."},{"id":"semetey-1-2013:p1082:b004:l010","ordinal":159735,"en":"We will not prosper by taking Aychürök;"},{"id":"semetey-1-2013:p1082:b004:l011","ordinal":159736,"en":"Let us not become the black donkey"},{"id":"semetey-1-2013:p1082:b004:l012","ordinal":159737,"en":"Of these peaceful people"},{"id":"semetey-1-2013:p1082:b004:l013","ordinal":159738,"en":"At dawn on the day of Mahshar."},{"id":"semetey-1-2013:p1082:b004:l014","ordinal":159739,"en":"My friend, my Kozho, hear my words!"},{"id":"semetey-1-2013:p1082:b004:l015","ordinal":159740,"en":"Akun's daughter Chürök,"},{"id":"semetey-1-2013:p1082:b004:l016","ordinal":159741,"en":"That accursed source of turmoil,"},{"id":"semetey-1-2013:p1082:b004:l017","ordinal":159742,"en":"Has a waist already girded,"},{"id":"semetey-1-2013:p1082:b004:l018","ordinal":159743,"en":"And a lion lying hidden."},{"id":"semetey-1-2013:p1082:b004:l019","ordinal":159744,"en":"She has a hellish tale of hardship"}]
