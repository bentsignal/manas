[{"id":"semetey-1-2013:p0607:b004:l004","ordinal":123393,"en":"It bore Kanykei's name."},{"id":"semetey-1-2013:p0607:b004:l005","ordinal":123394,"en":"Kanykei wrote the letter weeping;"},{"id":"semetey-1-2013:p0607:b004:l006","ordinal":123395,"en":"‘Khan uncle Bakai,’ she wrote."},{"id":"semetey-1-2013:p0607:b004:l007","ordinal":123396,"en":"She told me she had dug a grave,"},{"id":"semetey-1-2013:p0607:b004:l008","ordinal":123397,"en":"And thus burned my soul."},{"id":"semetey-1-2013:p0607:b004:l009","ordinal":123398,"en":"‘Uncle Bakai, generous lion,"},{"id":"semetey-1-2013:p0607:b004:l010","ordinal":123399,"en":"Here is where one suffers torment."},{"id":"semetey-1-2013:p0607:b004:l011","ordinal":123400,"en":"Your friend Manas has departed."},{"id":"semetey-1-2013:p0607:b004:l012","ordinal":123401,"en":"Keng-Kol is no land for us,"},{"id":"semetey-1-2013:p0607:b004:l013","ordinal":123402,"en":"These Kyrgyz are no people for us,"},{"id":"semetey-1-2013:p0607:b004:l014","ordinal":123403,"en":"This Talas is no land for us,"},{"id":"semetey-1-2013:p0607:b004:l015","ordinal":123404,"en":"These Argyn are no people for us."},{"id":"semetey-1-2013:p0607:b004:l016","ordinal":123405,"en":"There is deceit in what they say."},{"id":"semetey-1-2013:p0607:b004:l017","ordinal":123406,"en":"The courser's eyes have gone;"},{"id":"semetey-1-2013:p0607:b004:l018","ordinal":123407,"en":"They are poised to bring us harm."},{"id":"semetey-1-2013:p0607:b004:l019","ordinal":123408,"en":"As dusk falls and the sun sets,"},{"id":"semetey-1-2013:p0607:b004:l020","ordinal":123409,"en":"When the first of the people lie quietly down,"},{"id":"semetey-1-2013:p0607:b004:l021","ordinal":123410,"en":"Come and see a wonder of mine."},{"id":"semetey-1-2013:p0607:b004:l022","ordinal":123411,"en":"My uncle Bakai, heed my words."},{"id":"semetey-1-2013:p0607:b004:l023","ordinal":123412,"en":"I will show my valor,"},{"id":"semetey-1-2013:p0607:b004:l024","ordinal":123413,"en":"And without letting anyone know,"},{"id":"semetey-1-2013:p0607:b004:l025","ordinal":123414,"en":"I will hide your hero."},{"id":"semetey-1-2013:p0607:b004:l026","ordinal":123415,"en":"Words spoken indirectly—"},{"id":"semetey-1-2013:p0607:b004:l027","ordinal":123416,"en":"I have found the veiled words."},{"id":"semetey-1-2013:p0607:b004:l028","ordinal":123417,"en":"I toppled a poplar,"},{"id":"semetey-1-2013:p0607:b004:l029","ordinal":123418,"en":"Made its arms resemble his arms,"},{"id":"semetey-1-2013:p0607:b004:l030","ordinal":123419,"en":"Made its feet resemble his feet,"},{"id":"semetey-1-2013:p0607:b004:l031","ordinal":123420,"en":"Made its head resemble his head."},{"id":"semetey-1-2013:p0607:b004:l032","ordinal":123421,"en":"With great care, poor me,"},{"id":"semetey-1-2013:p0607:b004:l033","ordinal":123422,"en":"I laid it out as Manas,"},{"id":"semetey-1-2013:p0607:b004:l034","ordinal":123423,"en":"Carving a single poplar."},{"id":"semetey-1-2013:p0607:b004:l035","ordinal":123424,"en":"To make it soft to the touch,"},{"id":"semetey-1-2013:p0607:b004:l036","ordinal":123425,"en":"I wrapped it in fiber."},{"id":"semetey-1-2013:p0607:b004:l037","ordinal":123426,"en":"I guarded it more than Manas,"},{"id":"semetey-1-2013:p0607:b004:l038","ordinal":123427,"en":"To make them call it the leopard's body,"},{"id":"semetey-1-2013:p0607:b004:l039","ordinal":123428,"en":"And covered it with leather."},{"id":"semetey-1-2013:p0608:b003:l001","ordinal":123429,"en":"‘Let everyone who can come,’ I said,"},{"id":"semetey-1-2013:p0608:b003:l002","ordinal":123430,"en":"And sent word to the people."},{"id":"semetey-1-2013:p0608:b003:l003","ordinal":123431,"en":"For my bloodthirsty one's sake,"},{"id":"semetey-1-2013:p0608:b003:l004","ordinal":123432,"en":"Thus I found this stratagem.’"},{"id":"semetey-1-2013:p0608:b003:l005","ordinal":123433,"en":"When the dawn broke bright,"},{"id":"semetey-1-2013:p0608:b003:l006","ordinal":123434,"en":"When light touched the earth,"},{"id":"semetey-1-2013:p0608:b003:l007","ordinal":123435,"en":"Ak Eshen of Andijan,"},{"id":"semetey-1-2013:p0608:b003:l008","ordinal":123436,"en":"Aikojo in his mottled robe,"},{"id":"semetey-1-2013:p0608:b003:l009","ordinal":123437,"en":"Khan Koshoi of the Katagan,"},{"id":"semetey-1-2013:p0608:b003:l010","ordinal":123438,"en":"Hero Töshtük, Eleman's son,"},{"id":"semetey-1-2013:p0608:b003:l011","ordinal":123439,"en":"Kökbörü of Urumkan,"},{"id":"semetey-1-2013:p0608:b003:l012","ordinal":123440,"en":"Khan Saikal, Karacha's child,"},{"id":"semetey-1-2013:p0608:b003:l013","ordinal":123441,"en":"Koenaly and Jashaidar—"},{"id":"semetey-1-2013:p0608:b003:l014","ordinal":123442,"en":"All the fierce heroes were there,"},{"id":"semetey-1-2013:p0608:b003:l015","ordinal":123443,"en":"Those closest to him."},{"id":"semetey-1-2013:p0608:b003:l016","ordinal":123444,"en":"To hide him in this way,"},{"id":"semetey-1-2013:p0608:b003:l017","ordinal":123445,"en":"The fierce one's mind was resolved."},{"id":"semetey-1-2013:p0608:b003:l018","ordinal":123446,"en":"My leopard child Kanykei"},{"id":"semetey-1-2013:p0608:b003:l019","ordinal":123447,"en":"Spread out her possessions."},{"id":"semetey-1-2013:p0608:b003:l020","ordinal":123448,"en":"Without letting a single person know,"},{"id":"semetey-1-2013:p0608:b003:l021","ordinal":123449,"en":"She had her sovereign Manas"},{"id":"semetey-1-2013:p0608:b003:l022","ordinal":123450,"en":"Held by eighteen mighty men."},{"id":"semetey-1-2013:p0608:b003:l023","ordinal":123451,"en":"From sixty thousand horses on the hills,"},{"id":"semetey-1-2013:p0608:b003:l024","ordinal":123452,"en":"Thoroughbreds and fleet coursers,"},{"id":"semetey-1-2013:p0608:b003:l025","ordinal":123453,"en":"She had nine thousand driven in,"},{"id":"semetey-1-2013:p0608:b003:l026","ordinal":123454,"en":"And saddled for his rite of absolution."},{"id":"semetey-1-2013:p0608:b003:l027","ordinal":123455,"en":"Khan Koshoi of the Katagan,"},{"id":"semetey-1-2013:p0608:b003:l028","ordinal":123456,"en":"With khojas, eshens, and Sufis,"},{"id":"semetey-1-2013:p0608:b003:l029","ordinal":123457,"en":"Had his funeral prayer recited."},{"id":"semetey-1-2013:p0608:b003:l030","ordinal":123458,"en":"They placed him on the bier and washed him,"},{"id":"semetey-1-2013:p0608:b003:l031","ordinal":123459,"en":"Wrapped him in white cloth,"},{"id":"semetey-1-2013:p0608:b003:l032","ordinal":123460,"en":"And bound his head and feet."},{"id":"semetey-1-2013:p0608:b003:l033","ordinal":123461,"en":"The forty eshens of Andijan—"},{"id":"semetey-1-2013:p0608:b003:l034","ordinal":123462,"en":"When they brought him to the cave,"},{"id":"semetey-1-2013:p0608:b003:l035","ordinal":123463,"en":"‘Let this be your payment,’ she said,"},{"id":"semetey-1-2013:p0608:b003:l036","ordinal":123464,"en":"And had the treasury opened."},{"id":"semetey-1-2013:p0608:b003:l037","ordinal":123465,"en":"‘Take as much as you will,’ she said,"},{"id":"semetey-1-2013:p0608:b003:l038","ordinal":123466,"en":"And had gifts scattered in charity."},{"id":"semetey-1-2013:p0608:b003:l039","ordinal":123467,"en":"The people took Khan Manas,"},{"id":"semetey-1-2013:p0608:b004:l001","ordinal":123468,"en":"Placed him on the bier and set off."},{"id":"semetey-1-2013:p0608:b004:l002","ordinal":123469,"en":"Before even a moment had passed,"},{"id":"semetey-1-2013:p0608:b004:l003","ordinal":123470,"en":"Kanykei led the way."},{"id":"semetey-1-2013:p0608:b004:l004","ordinal":123471,"en":"All the people"},{"id":"semetey-1-2013:p0608:b004:l005","ordinal":123472,"en":"Carried Khan Manas"},{"id":"semetey-1-2013:p0608:b004:l006","ordinal":123473,"en":"And walked toward the cave."},{"id":"semetey-1-2013:p0608:b004:l007","ordinal":123474,"en":"All the way to his cave,"},{"id":"semetey-1-2013:p0608:b004:l008","ordinal":123475,"en":"Young red willow shoots sprang up."},{"id":"semetey-1-2013:p0608:b004:l009","ordinal":123476,"en":"Your khan father, gone to Judgment,"},{"id":"semetey-1-2013:p0608:b004:l010","ordinal":123477,"en":"Had been khan over many lands."},{"id":"semetey-1-2013:p0608:b004:l011","ordinal":123478,"en":"Forty khojas recited the creed,"},{"id":"semetey-1-2013:p0608:b004:l012","ordinal":123479,"en":"And bore him as they walked on foot."},{"id":"semetey-1-2013:p0608:b004:l013","ordinal":123480,"en":"Between Keng-Shor and the great cave,"},{"id":"semetey-1-2013:p0608:b004:l014","ordinal":123481,"en":"In the land between those two,"},{"id":"semetey-1-2013:p0608:b004:l015","ordinal":123482,"en":"A row of poplars took root."},{"id":"semetey-1-2013:p0608:b004:l016","ordinal":123483,"en":"Your father, gone to Judgment,"},{"id":"semetey-1-2013:p0608:b004:l017","ordinal":123484,"en":"Was thus supported by Khizr."},{"id":"semetey-1-2013:p0608:b004:l018","ordinal":123485,"en":"Your renowned father was a lion,"},{"id":"semetey-1-2013:p0608:b004:l019","ordinal":123486,"en":"A hero whose guardian spirit lived."},{"id":"semetey-1-2013:p0608:b004:l020","ordinal":123487,"en":"The one God will not soon"},{"id":"semetey-1-2013:p0608:b004:l021","ordinal":123488,"en":"Create a living servant"},{"id":"semetey-1-2013:p0608:b004:l022","ordinal":123489,"en":"Like your father and grant him again."},{"id":"semetey-1-2013:p0608:b004:l023","ordinal":123490,"en":"The noble hero came and went,"},{"id":"semetey-1-2013:p0608:b004:l024","ordinal":123491,"en":"Leaving his Bakai on the plain."},{"id":"semetey-1-2013:p0608:b004:l025","ordinal":123492,"en":"Sovereign Manas, the dear departed—"},{"id":"semetey-1-2013:p0608:b004:l026","ordinal":123493,"en":"That is the place where he perished."},{"id":"semetey-1-2013:p0608:b004:l027","ordinal":123494,"en":"My foal, my child Semetey,"},{"id":"semetey-1-2013:p0608:b004:l028","ordinal":123495,"en":"Let us go to that place."},{"id":"semetey-1-2013:p0608:b004:l029","ordinal":123496,"en":"To the mighty conquering sultan,"},{"id":"semetey-1-2013:p0608:b004:l030","ordinal":123497,"en":"Let us pay our homage."},{"id":"semetey-1-2013:p0608:b004:l031","ordinal":123498,"en":"Bozbuura, sire of camels,"},{"id":"semetey-1-2013:p0608:b004:l032","ordinal":123499,"en":"Let us sacrifice to the generous one.”"},{"id":"semetey-1-2013:p0608:b004:l033","ordinal":123500,"en":"Sovereign Bakai, the leopard,"},{"id":"semetey-1-2013:p0608:b004:l034","ordinal":123501,"en":"Your saint protected by Shai—"},{"id":"semetey-1-2013:p0608:b004:l035","ordinal":123502,"en":"If he dies, his words remain clear;"},{"id":"semetey-1-2013:p0608:b004:l036","ordinal":123503,"en":"Until he dies, his eyes see clear."},{"id":"semetey-1-2013:p0608:b004:l037","ordinal":123504,"en":"Next to his skin, a white-cloth shirt"},{"id":"semetey-1-2013:p0608:b004:l038","ordinal":123505,"en":"The elder wore."},{"id":"semetey-1-2013:p0608:b004:l039","ordinal":123506,"en":"Death and torment—"},{"id":"semetey-1-2013:p0609:b003:l001","ordinal":123507,"en":"Six months in advance,"},{"id":"semetey-1-2013:p0609:b003:l002","ordinal":123508,"en":"The saint knew them clearly."},{"id":"semetey-1-2013:p0609:b003:l003","ordinal":123509,"en":"The falcon among mankind,"},{"id":"semetey-1-2013:p0609:b003:l004","ordinal":123510,"en":"The very son of saintly wisdom,"},{"id":"semetey-1-2013:p0609:b003:l005","ordinal":123511,"en":"My tireless black steed with the white blaze,"},{"id":"semetey-1-2013:p0609:b003:l006","ordinal":123512,"en":"Dear Bakai the Leopard,"},{"id":"semetey-1-2013:p0609:b003:l007","ordinal":123513,"en":"Speaking many, many words,"},{"id":"semetey-1-2013:p0609:b003:l008","ordinal":123514,"en":"Led Semetey with him"},{"id":"semetey-1-2013:p0609:b003:l009","ordinal":123515,"en":"To his companion, fierce-maned Manas."},{"id":"semetey-1-2013:p0609:b003:l010","ordinal":123516,"en":"Explaining when to recite the Qur'an,"},{"id":"semetey-1-2013:p0609:b003:l011","ordinal":123517,"en":"Teaching him what he did not know,"},{"id":"semetey-1-2013:p0609:b003:l012","ordinal":123518,"en":"Leading along the road his mother had walked,"},{"id":"semetey-1-2013:p0609:b003:l013","ordinal":123519,"en":"Guiding him in her footsteps,"},{"id":"semetey-1-2013:p0609:b003:l014","ordinal":123520,"en":"To Echkiliktin's dark cliff,"},{"id":"semetey-1-2013:p0609:b003:l015","ordinal":123521,"en":"The great mountain standing still—"},{"id":"semetey-1-2013:p0609:b003:l016","ordinal":123522,"en":"When they drew near the grave,"},{"id":"semetey-1-2013:p0609:b003:l017","ordinal":123523,"en":"Magnanimous Bakai wailed."},{"id":"semetey-1-2013:p0609:b003:l018","ordinal":123524,"en":"“Khan Manas!” he cried aloud."},{"id":"semetey-1-2013:p0609:b003:l019","ordinal":123525,"en":"Sobbing, Bakai, the warrior sultan,"},{"id":"semetey-1-2013:p0609:b003:l020","ordinal":123526,"en":"Raised his voice in lamentation."},{"id":"semetey-1-2013:p0609:b003:l021","ordinal":123527,"en":"His white beard thinning,"},{"id":"semetey-1-2013:p0609:b003:l022","ordinal":123528,"en":"The bloody tears from his eyes"},{"id":"semetey-1-2013:p0609:b003:l023","ordinal":123529,"en":"Poured down over his collarbone."},{"id":"semetey-1-2013:p0609:b003:l024","ordinal":123530,"en":"When his fatherly Bakai did this,"},{"id":"semetey-1-2013:p0609:b003:l025","ordinal":123531,"en":"May I be sacrificed to God!"},{"id":"semetey-1-2013:p0609:b003:l026","ordinal":123532,"en":"Could the grieving boy remain still?"},{"id":"semetey-1-2013:p0609:b003:l027","ordinal":123533,"en":"He cried aloud, “Father!”"},{"id":"semetey-1-2013:p0609:b003:l028","ordinal":123534,"en":"Did you see his childishness?"},{"id":"semetey-1-2013:p0609:b003:l029","ordinal":123535,"en":"To his kingly father Manas"},{"id":"semetey-1-2013:p0609:b003:l030","ordinal":123536,"en":"He called, “Rise up!”"},{"id":"semetey-1-2013:p0609:b003:l031","ordinal":123537,"en":"Semetey acted like a child,"},{"id":"semetey-1-2013:p0609:b003:l032","ordinal":123538,"en":"Crying aloud, “Father!”"},{"id":"semetey-1-2013:p0609:b003:l033","ordinal":123539,"en":"The golden-bladed battle-ax"},{"id":"semetey-1-2013:p0609:b003:l034","ordinal":123540,"en":"He braced against his right side."},{"id":"semetey-1-2013:p0609:b003:l035","ordinal":123541,"en":"“My formidable father!” he wept."},{"id":"semetey-1-2013:p0609:b003:l036","ordinal":123542,"en":"The white whip with black cheeks"},{"id":"semetey-1-2013:p0609:b003:l037","ordinal":123543,"en":"He braced against his left side."},{"id":"semetey-1-2013:p0609:b003:l038","ordinal":123544,"en":"“My protector, my father!” he wept."},{"id":"semetey-1-2013:p0609:b003:l039","ordinal":123545,"en":"Old Bakai the Leopard,"},{"id":"semetey-1-2013:p0609:b005:l001","ordinal":123546,"en":"When he checked his grief,"},{"id":"semetey-1-2013:p0609:b005:l002","ordinal":123547,"en":"When he dried his tears—"},{"id":"semetey-1-2013:p0609:b005:l003","ordinal":123548,"en":"That grave of Manas"},{"id":"semetey-1-2013:p0609:b005:l004","ordinal":123549,"en":"No soul but Bakai knew."},{"id":"semetey-1-2013:p0609:b005:l005","ordinal":123550,"en":"They stood weeping at the grave,"},{"id":"semetey-1-2013:p0609:b005:l006","ordinal":123551,"en":"Then took courage again."},{"id":"semetey-1-2013:p0609:b005:l007","ordinal":123552,"en":"They rested and gathered their wits,"},{"id":"semetey-1-2013:p0609:b005:l008","ordinal":123553,"en":"Toward Manas, gone to Judgment Day,"},{"id":"semetey-1-2013:p0609:b005:l009","ordinal":123554,"en":"And the wife who had buried him through hardship,"},{"id":"semetey-1-2013:p0609:b005:l010","ordinal":123555,"en":"Standing filled with gratitude."},{"id":"semetey-1-2013:p0609:b005:l011","ordinal":123556,"en":"When they looked to the north,"},{"id":"semetey-1-2013:p0609:b005:l012","ordinal":123557,"en":"Over a saddle-shaped pass"},{"id":"semetey-1-2013:p0609:b005:l013","ordinal":123558,"en":"Something was coming into view:"},{"id":"semetey-1-2013:p0609:b005:l014","ordinal":123559,"en":"Bozbuura, the ancestor of camels,"},{"id":"semetey-1-2013:p0609:b005:l015","ordinal":123560,"en":"Toward that grave"},{"id":"semetey-1-2013:p0609:b005:l016","ordinal":123561,"en":"Came running forth."},{"id":"semetey-1-2013:p0609:b005:l017","ordinal":123562,"en":"When he came near the grave,"},{"id":"semetey-1-2013:p0609:b005:l018","ordinal":123563,"en":"With sharp steel for my pillow,"},{"id":"semetey-1-2013:p0609:b005:l019","ordinal":123564,"en":"With his head toward the north,"},{"id":"semetey-1-2013:p0609:b005:l020","ordinal":123565,"en":"His long wool parting,"},{"id":"semetey-1-2013:p0609:b005:l021","ordinal":123566,"en":"Seeing the orphan Semetey,"},{"id":"semetey-1-2013:p0609:b005:l022","ordinal":123567,"en":"Bozbuura knelt down."},{"id":"semetey-1-2013:p0609:b005:l023","ordinal":123568,"en":"His voice differed from other beasts'."},{"id":"semetey-1-2013:p0609:b005:l024","ordinal":123569,"en":"Its young to Manas"},{"id":"semetey-1-2013:p0609:b005:l025","ordinal":123570,"en":"He seemed to wish to be sacrificed."},{"id":"semetey-1-2013:p0609:b005:l026","ordinal":123571,"en":"At “Kneel, kneel!” he knelt,"},{"id":"semetey-1-2013:p0609:b005:l027","ordinal":123572,"en":"And Bozbuura would not rise."},{"id":"semetey-1-2013:p0609:b005:l028","ordinal":123573,"en":"Lowering his chin to the ground,"},{"id":"semetey-1-2013:p0609:b005:l029","ordinal":123574,"en":"Bozbuura held himself still."},{"id":"semetey-1-2013:p0609:b005:l030","ordinal":123575,"en":"Without stirring from his place,"},{"id":"semetey-1-2013:p0609:b005:l031","ordinal":123576,"en":"Bozbuura lay down."},{"id":"semetey-1-2013:p0609:b005:l032","ordinal":123577,"en":"Bakai the Leopard and Semetey"},{"id":"semetey-1-2013:p0609:b005:l033","ordinal":123578,"en":"Dipped their hands into the water,"},{"id":"semetey-1-2013:p0609:b005:l034","ordinal":123579,"en":"Performed the ablution of their hands,"},{"id":"semetey-1-2013:p0609:b005:l035","ordinal":123580,"en":"Dipped their feet into the water,"},{"id":"semetey-1-2013:p0609:b005:l036","ordinal":123581,"en":"Performed the ablution of their feet."},{"id":"semetey-1-2013:p0609:b005:l037","ordinal":123582,"en":"Dear Bakai the Leopard"},{"id":"semetey-1-2013:p0609:b005:l038","ordinal":123583,"en":"For his companion, Lord Manas,"},{"id":"semetey-1-2013:p0609:b005:l039","ordinal":123584,"en":"Began to recite the Qur'an."},{"id":"semetey-1-2013:p0610:b003:l001","ordinal":123585,"en":"“Amen!” he said, spreading his hands."},{"id":"semetey-1-2013:p0610:b003:l002","ordinal":123586,"en":"The extraordinary boy Semetey"},{"id":"semetey-1-2013:p0610:b003:l003","ordinal":123587,"en":"Drew his bright, short-necked scimitar"},{"id":"semetey-1-2013:p0610:b003:l004","ordinal":123588,"en":"From its sheath and took it in his hand."},{"id":"semetey-1-2013:p0610:b003:l005","ordinal":123589,"en":"“Bozbuura, ancestor of camels,"},{"id":"semetey-1-2013:p0610:b003:l006","ordinal":123590,"en":"If you wish to journey, there is Mecca."},{"id":"semetey-1-2013:p0610:b003:l007","ordinal":123591,"en":"You have made ready and knelt down."},{"id":"semetey-1-2013:p0610:b003:l008","ordinal":123592,"en":"Dear creature, go and reach my khan father."},{"id":"semetey-1-2013:p0610:b003:l009","ordinal":123593,"en":"May I be sacrificed to You, O God!"},{"id":"semetey-1-2013:p0610:b003:l010","ordinal":123594,"en":"May hellfire stay far away."},{"id":"semetey-1-2013:p0610:b003:l011","ordinal":123595,"en":"Be a Buraq for my leopard khan father!"},{"id":"semetey-1-2013:p0610:b003:l012","ordinal":123596,"en":"Your soul to Almighty Allah,"},{"id":"semetey-1-2013:p0610:b003:l013","ordinal":123597,"en":"The merit to my father Manas.”"},{"id":"semetey-1-2013:p0610:b003:l014","ordinal":123598,"en":"So saying, Semetey"},{"id":"semetey-1-2013:p0610:b003:l015","ordinal":123599,"en":"Sacrificed Bozbuura."},{"id":"semetey-1-2013:p0610:b003:l016","ordinal":123600,"en":"Without waiting to be told, “Strike!”"},{"id":"semetey-1-2013:p0610:b003:l017","ordinal":123601,"en":"He cut off the camel's head."},{"id":"semetey-1-2013:p0610:b003:l018","ordinal":123602,"en":"Bakai began speaking again,"},{"id":"semetey-1-2013:p0610:b003:l019","ordinal":123603,"en":"Speaking softly, laying his words down firmly."},{"id":"semetey-1-2013:p0610:b003:l020","ordinal":123604,"en":"Every word was like gold;"},{"id":"semetey-1-2013:p0610:b003:l021","ordinal":123605,"en":"His wisdom pierced the soul."},{"id":"semetey-1-2013:p0610:b003:l022","ordinal":123606,"en":"Stars had streamed from the heavens"},{"id":"semetey-1-2013:p0610:b003:l023","ordinal":123607,"en":"When the Magnanimous One came from Altai."},{"id":"semetey-1-2013:p0610:b003:l024","ordinal":123608,"en":"They became friends for the next world."},{"id":"semetey-1-2013:p0610:b003:l025","ordinal":123609,"en":"When he reached twelve years of age,"},{"id":"semetey-1-2013:p0610:b003:l026","ordinal":123610,"en":"When Bakai first saw him,"},{"id":"semetey-1-2013:p0610:b003:l027","ordinal":123611,"en":"Stars stirred in the heavens."},{"id":"semetey-1-2013:p0610:b003:l028","ordinal":123612,"en":"Twelve times they had become friends."},{"id":"semetey-1-2013:p0610:b003:l029","ordinal":123613,"en":"My child Kanykei began the turmoil,"},{"id":"semetey-1-2013:p0610:b003:l030","ordinal":123614,"en":"When he reached twelve years of age,"},{"id":"semetey-1-2013:p0610:b003:l031","ordinal":123615,"en":"If Semetey came to his father"},{"id":"semetey-1-2013:p0610:b003:l032","ordinal":123616,"en":"To recite the Qur'an,"},{"id":"semetey-1-2013:p0610:b003:l033","ordinal":123617,"en":"For his son to enter once,"},{"id":"semetey-1-2013:p0610:b003:l034","ordinal":123618,"en":"She had left it as a trust."},{"id":"semetey-1-2013:p0610:b003:l035","ordinal":123619,"en":"Then Bakai said:"},{"id":"semetey-1-2013:p0610:b003:l036","ordinal":123620,"en":"“Now, orphan, listen."},{"id":"semetey-1-2013:p0610:b003:l037","ordinal":123621,"en":"Bakai has words to tell you."},{"id":"semetey-1-2013:p0610:b003:l038","ordinal":123622,"en":"‘Let the son see his father,’ she said."},{"id":"semetey-1-2013:p0610:b003:l039","ordinal":123623,"en":"She left that charge in trust."},{"id":"semetey-1-2013:p0610:b004:l001","ordinal":123624,"en":"Enter this cave, my child."},{"id":"semetey-1-2013:p0610:b004:l002","ordinal":123625,"en":"Your leopard father, your lion—"},{"id":"semetey-1-2013:p0610:b004:l003","ordinal":123626,"en":"See every limb of him, my child."},{"id":"semetey-1-2013:p0610:b004:l004","ordinal":123627,"en":"The sorrows in your heart,"},{"id":"semetey-1-2013:p0610:b004:l005","ordinal":123628,"en":"Scatter every one of them, my child."},{"id":"semetey-1-2013:p0610:b004:l006","ordinal":123629,"en":"It is the trust your mother left."},{"id":"semetey-1-2013:p0610:b004:l007","ordinal":123630,"en":"Open this cave, my child."},{"id":"semetey-1-2013:p0610:b004:l008","ordinal":123631,"en":"The entrance opened in the cave"},{"id":"semetey-1-2013:p0610:b004:l009","ordinal":123632,"en":"She had fitted carefully together,"},{"id":"semetey-1-2013:p0610:b004:l010","ordinal":123633,"en":"And left it as a trust."},{"id":"semetey-1-2013:p0610:b004:l011","ordinal":123634,"en":"Overturn the stone at its mouth;"},{"id":"semetey-1-2013:p0610:b004:l012","ordinal":123635,"en":"Tip it back this way.”"},{"id":"semetey-1-2013:p0610:b004:l013","ordinal":123636,"en":"When Bakai said this,"},{"id":"semetey-1-2013:p0610:b004:l014","ordinal":123637,"en":"The boy could not pull it; he struggled."},{"id":"semetey-1-2013:p0610:b004:l015","ordinal":123638,"en":"His strength failed; he swayed."},{"id":"semetey-1-2013:p0610:b004:l016","ordinal":123639,"en":"When the boy was doing this,"},{"id":"semetey-1-2013:p0610:b004:l017","ordinal":123640,"en":"Khan Bakai grew angry."},{"id":"semetey-1-2013:p0610:b004:l018","ordinal":123641,"en":"“When we were drunk on play like you,"},{"id":"semetey-1-2013:p0610:b004:l019","ordinal":123642,"en":"When we were young and played,"},{"id":"semetey-1-2013:p0610:b004:l020","ordinal":123643,"en":"Barefoot and bareheaded,"},{"id":"semetey-1-2013:p0610:b004:l021","ordinal":123644,"en":"The earth would tremble in those days."},{"id":"semetey-1-2013:p0610:b004:l022","ordinal":123645,"en":"That precious time has passed."},{"id":"semetey-1-2013:p0610:b004:l023","ordinal":123646,"en":"Children nowadays—"},{"id":"semetey-1-2013:p0610:b004:l024","ordinal":123647,"en":"Drink butter dregs and shit grass."},{"id":"semetey-1-2013:p0610:b004:l025","ordinal":123648,"en":"In the old days, in my childhood,"}]
