{"id": "sayakbay-ms-current146:pdf029:l034", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 29, "folio": 412, "line_in_page": 34, "raw": "Кароолчулар бактысы бар,", "text": "Кароолчулар бактысы бар,", "en": "His guards had their appointed fortune,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The noun phrase after Кароолчулар is difficult and this translation is provisional.", "bbox": null}
