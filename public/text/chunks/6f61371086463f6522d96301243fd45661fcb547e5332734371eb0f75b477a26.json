[{"id":"semetey-1-2013:p1142:b003:l007","ordinal":163329,"en":"Yesterday, tiger Manas"},{"id":"semetey-1-2013:p1142:b003:l008","ordinal":163330,"en":"Destroyed the Kyzylbash people;"},{"id":"semetey-1-2013:p1142:b003:l009","ordinal":163331,"en":"Falcon Manas, the tiger,"},{"id":"semetey-1-2013:p1142:b003:l010","ordinal":163332,"en":"Made every place he glanced toward weep."},{"id":"semetey-1-2013:p1142:b003:l011","ordinal":163333,"en":"No person dared look"},{"id":"semetey-1-2013:p1142:b003:l012","ordinal":163334,"en":"And advance against Manas."},{"id":"semetey-1-2013:p1142:b003:l013","ordinal":163335,"en":"His fortune was complete;"},{"id":"semetey-1-2013:p1142:b003:l014","ordinal":163336,"en":"Looking into his heart,"},{"id":"semetey-1-2013:p1142:b003:l015","ordinal":163337,"en":"It was broader than the face of the earth."},{"id":"semetey-1-2013:p1142:b003:l016","ordinal":163338,"en":"Your magnanimous lion-like lord,"},{"id":"semetey-1-2013:p1142:b003:l017","ordinal":163339,"en":"The youngest of six lions,"},{"id":"semetey-1-2013:p1142:b003:l018","ordinal":163340,"en":"Your gray wolf, the mortal loved by God,"},{"id":"semetey-1-2013:p1142:b003:l019","ordinal":163341,"en":"Was the hero Zayypburush;"},{"id":"semetey-1-2013:p1142:b003:l020","ordinal":163342,"en":"His breadth was a boundless lake."},{"id":"semetey-1-2013:p1142:b003:l021","ordinal":163343,"en":"At that time Manas"},{"id":"semetey-1-2013:p1142:b003:l022","ordinal":163344,"en":"Had a hat large as a cauldron;"},{"id":"semetey-1-2013:p1142:b003:l023","ordinal":163345,"en":"Over infidel and Muslim alike,"},{"id":"semetey-1-2013:p1142:b003:l024","ordinal":163346,"en":"He had freedom to do as he wished."},{"id":"semetey-1-2013:p1142:b003:l025","ordinal":163347,"en":"Combing his black mustache,"},{"id":"semetey-1-2013:p1142:b003:l026","ordinal":163348,"en":"Looking to both sides,"},{"id":"semetey-1-2013:p1142:b003:l027","ordinal":163349,"en":"The war banner floated in his hand,"},{"id":"semetey-1-2013:p1142:b003:l028","ordinal":163350,"en":"And Akkelte flashed on his back."},{"id":"semetey-1-2013:p1142:b003:l029","ordinal":163351,"en":"A gray cartridge belt large as a foot-sack"},{"id":"semetey-1-2013:p1142:b003:l030","ordinal":163352,"en":"Rang against his right hip;"},{"id":"semetey-1-2013:p1142:b003:l031","ordinal":163353,"en":"Zulpukor too appeared,"},{"id":"semetey-1-2013:p1142:b003:l032","ordinal":163354,"en":"And the enemy's spirit failed."},{"id":"semetey-1-2013:p1142:b003:l033","ordinal":163355,"en":"At the hero's right side,"},{"id":"semetey-1-2013:p1142:b003:l034","ordinal":163356,"en":"With mighty Bakay at their head,"},{"id":"semetey-1-2013:p1142:b003:l035","ordinal":163357,"en":"Ready to swarm upon the enemy,"},{"id":"semetey-1-2013:p1142:b003:l036","ordinal":163358,"en":"They appeared without flinching,"},{"id":"semetey-1-2013:p1142:b003:l037","ordinal":163359,"en":"Ready to arrive before an arrow—"},{"id":"semetey-1-2013:p1142:b003:l038","ordinal":163360,"en":"Twenty fierce close companions."},{"id":"semetey-1-2013:p1142:b003:l039","ordinal":163361,"en":"Looking to his left,"},{"id":"semetey-1-2013:p1142:b004:l001","ordinal":163362,"en":"Wearing a robe of yellow gold,"},{"id":"semetey-1-2013:p1142:b004:l002","ordinal":163363,"en":"Mounted on the racehorse Sarala,"},{"id":"semetey-1-2013:p1142:b004:l003","ordinal":163364,"en":"With tiger Almang at their head,"},{"id":"semetey-1-2013:p1142:b004:l004","ordinal":163365,"en":"Were the twenty on his left."},{"id":"semetey-1-2013:p1142:b004:l005","ordinal":163366,"en":"Mounted on blue-mottled horses,"},{"id":"semetey-1-2013:p1142:b004:l006","ordinal":163367,"en":"Wearing blue rapis coats—"},{"id":"semetey-1-2013:p1142:b004:l007","ordinal":163368,"en":"Chubak, son of Akbaltay;"},{"id":"semetey-1-2013:p1142:b004:l008","ordinal":163369,"en":"Syrgak, son of Ulakkan,"},{"id":"semetey-1-2013:p1142:b004:l009","ordinal":163370,"en":"Who subdued the moon and world;"},{"id":"semetey-1-2013:p1142:b004:l010","ordinal":163371,"en":"Yrchyuul, son of Yraman;"},{"id":"semetey-1-2013:p1142:b004:l011","ordinal":163372,"en":"Hero Shuutu, whose cap was broad as a felt panel;"},{"id":"semetey-1-2013:p1142:b004:l012","ordinal":163373,"en":"Kyrgylchal, head of the forty;"},{"id":"semetey-1-2013:p1142:b004:l013","ordinal":163374,"en":"The formidable hero Tazbaymat;"},{"id":"semetey-1-2013:p1142:b004:l014","ordinal":163375,"en":"Men more skillful than intriguers,"},{"id":"semetey-1-2013:p1142:b004:l015","ordinal":163376,"en":"Mighty men who could shatter the world."},{"id":"semetey-1-2013:p1142:b004:l016","ordinal":163377,"en":"Holding a banner with a golden finial,"},{"id":"semetey-1-2013:p1142:b004:l017","ordinal":163378,"en":"Your uncle Bakay rode in front,"},{"id":"semetey-1-2013:p1142:b004:l018","ordinal":163379,"en":"Making Kartküröng prance;"},{"id":"semetey-1-2013:p1142:b004:l019","ordinal":163380,"en":"Khan Azhybay rode in front"},{"id":"semetey-1-2013:p1142:b004:l020","ordinal":163381,"en":"Of the tiger, gray-wolf lord."},{"id":"semetey-1-2013:p1142:b004:l021","ordinal":163382,"en":"Nine supported him;"},{"id":"semetey-1-2013:p1142:b004:l022","ordinal":163383,"en":"His supporters appeared."},{"id":"semetey-1-2013:p1142:b004:l023","ordinal":163384,"en":"The dark-piebald tiger"},{"id":"semetey-1-2013:p1142:b004:l024","ordinal":163385,"en":"Raged at his flank."},{"id":"semetey-1-2013:p1142:b004:l025","ordinal":163386,"en":"Zulpukor fastened at his waist,"},{"id":"semetey-1-2013:p1142:b004:l026","ordinal":163387,"en":"His wrath spread across his face;"},{"id":"semetey-1-2013:p1142:b004:l027","ordinal":163388,"en":"Those who saw him despaired,"},{"id":"semetey-1-2013:p1142:b004:l028","ordinal":163389,"en":"And his thirst for blood showed."},{"id":"semetey-1-2013:p1142:b004:l029","ordinal":163390,"en":"The horns boomed,"},{"id":"semetey-1-2013:p1142:b004:l030","ordinal":163391,"en":"The trumpets shrilled;"},{"id":"semetey-1-2013:p1142:b004:l031","ordinal":163392,"en":"All the forty companions,"},{"id":"semetey-1-2013:p1142:b004:l032","ordinal":163393,"en":"Their elder Kyrgyl at their head,"},{"id":"semetey-1-2013:p1142:b004:l033","ordinal":163394,"en":"Had a majestic bearing,"},{"id":"semetey-1-2013:p1142:b004:l034","ordinal":163395,"en":"Each a companion worth a countless army."},{"id":"semetey-1-2013:p1142:b004:l035","ordinal":163396,"en":"The horses were firmly tethered,"},{"id":"semetey-1-2013:p1142:b004:l036","ordinal":163397,"en":"And all the gray wolves filled the place."},{"id":"semetey-1-2013:p1142:b004:l037","ordinal":163398,"en":"Finding no enemy to meet in battle,"},{"id":"semetey-1-2013:p1142:b004:l038","ordinal":163399,"en":"All forty companions grew pent-up,"},{"id":"semetey-1-2013:p1142:b004:l039","ordinal":163400,"en":"Finding no ridge upon which to clash,"},{"id":"semetey-1-2013:p1142:b004:l040","ordinal":163401,"en":"Finding no born hero with whom to contend,"},{"id":"semetey-1-2013:p1143:b003:l001","ordinal":163402,"en":"Finding no place to cast their weight,"},{"id":"semetey-1-2013:p1143:b003:l002","ordinal":163403,"en":"Finding no hero to fight,"},{"id":"semetey-1-2013:p1143:b003:l003","ordinal":163404,"en":"They rode about churning with impatience."},{"id":"semetey-1-2013:p1143:b003:l004","ordinal":163405,"en":"Like lions, gray wolves, and tigers,"},{"id":"semetey-1-2013:p1143:b003:l005","ordinal":163406,"en":"They turned toward the multitude."},{"id":"semetey-1-2013:p1143:b003:l006","ordinal":163407,"en":"Hoping to reach the place of the feast,"},{"id":"semetey-1-2013:p1143:b003:l007","ordinal":163408,"en":"All forty companions"},{"id":"semetey-1-2013:p1143:b003:l008","ordinal":163409,"en":"Entered the tumult."},{"id":"semetey-1-2013:p1143:b003:l009","ordinal":163410,"en":"Like an unconquered mountain,"},{"id":"semetey-1-2013:p1143:b003:l010","ordinal":163411,"en":"They entered the contest."},{"id":"semetey-1-2013:p1143:b003:l011","ordinal":163412,"en":"If the magnanimous one gave the order,"},{"id":"semetey-1-2013:p1143:b003:l012","ordinal":163413,"en":"They would show the seething Chinese"},{"id":"semetey-1-2013:p1143:b003:l013","ordinal":163414,"en":"An astonishing sight."},{"id":"semetey-1-2013:p1143:b003:l014","ordinal":163415,"en":"They had courage."},{"id":"semetey-1-2013:p1143:b003:l015","ordinal":163416,"en":"There were companions who drew courage"},{"id":"semetey-1-2013:p1143:b003:l016","ordinal":163417,"en":"From calm words of substance."},{"id":"semetey-1-2013:p1143:b003:l017","ordinal":163418,"en":"There were companions who made ready"},{"id":"semetey-1-2013:p1143:b003:l018","ordinal":163419,"en":"Their guns and swords in hand,"},{"id":"semetey-1-2013:p1143:b003:l019","ordinal":163420,"en":"As though about to strike the enemy now."},{"id":"semetey-1-2013:p1143:b003:l020","ordinal":163421,"en":"There were companions who trampled trackless ground"},{"id":"semetey-1-2013:p1143:b003:l021","ordinal":163422,"en":"And made a road."},{"id":"semetey-1-2013:p1143:b003:l022","ordinal":163423,"en":"There were companions who attacked,"},{"id":"semetey-1-2013:p1143:b004:l001","ordinal":163424,"en":"Regarding death as less than a hair."},{"id":"semetey-1-2013:p1143:b004:l002","ordinal":163425,"en":"There were companions who, striking countless armies,"},{"id":"semetey-1-2013:p1143:b004:l003","ordinal":163426,"en":"Scattered and split them."},{"id":"semetey-1-2013:p1143:b004:l004","ordinal":163427,"en":"There were companions who spilled"},{"id":"semetey-1-2013:p1143:b004:l005","ordinal":163428,"en":"The infidels' blood bright red."},{"id":"semetey-1-2013:p1143:b004:l006","ordinal":163429,"en":"There were companions who entered battle unawares"},{"id":"semetey-1-2013:p1143:b004:l007","ordinal":163430,"en":"And died."},{"id":"semetey-1-2013:p1143:b004:l008","ordinal":163431,"en":"There were companions called spearmen,"},{"id":"semetey-1-2013:p1143:b004:l009","ordinal":163432,"en":"Skilled and cunning."},{"id":"semetey-1-2013:p1143:b004:l010","ordinal":163433,"en":"There were strong companions"},{"id":"semetey-1-2013:p1143:b004:l011","ordinal":163434,"en":"Who knew the enemy's stratagems well."},{"id":"semetey-1-2013:p1143:b004:l012","ordinal":163435,"en":"When they became mixed together,"},{"id":"semetey-1-2013:p1143:b004:l013","ordinal":163436,"en":"There were clumsy companions"},{"id":"semetey-1-2013:p1143:b004:l014","ordinal":163437,"en":"Who struck men wide of the mark."},{"id":"semetey-1-2013:p1143:b004:l015","ordinal":163438,"en":"There were cowardly companions"},{"id":"semetey-1-2013:p1143:b004:l016","ordinal":163439,"en":"Who would not part from their loaded baggage."},{"id":"semetey-1-2013:p1143:b004:l017","ordinal":163440,"en":"Who could match the man who speared heroes?"},{"id":"semetey-1-2013:p1143:b004:l018","ordinal":163441,"en":"His fame remained with Manas."},{"id":"semetey-1-2013:p1143:b004:l019","ordinal":163442,"en":"Khan Manas's forty companions—"},{"id":"semetey-1-2013:p1143:b004:l020","ordinal":163443,"en":"Forty lions who came from forty places,"},{"id":"semetey-1-2013:p1143:b004:l021","ordinal":163444,"en":"Each was a lion,"},{"id":"semetey-1-2013:p1143:b004:l022","ordinal":163445,"en":"Heroes born for slaughter."},{"id":"semetey-1-2013:p1143:b006:l001","ordinal":163446,"en":"From the Kyzyl-Kyya pass,"},{"id":"semetey-1-2013:p1143:b006:l002","ordinal":163447,"en":"Dear Manas appeared in his grandeur;"},{"id":"semetey-1-2013:p1143:b006:l003","ordinal":163448,"en":"That was when he came into view."},{"id":"semetey-1-2013:p1143:b006:l004","ordinal":163449,"en":"The Muslims, witnessing the spectacle,"},{"id":"semetey-1-2013:p1143:b006:l005","ordinal":163450,"en":"Were under great pressure"},{"id":"semetey-1-2013:p1143:b006:l006","ordinal":163451,"en":"And had split apart."},{"id":"semetey-1-2013:p1143:b006:l007","ordinal":163452,"en":"The tyranny of Kakanchyn"},{"id":"semetey-1-2013:p1143:b006:l008","ordinal":163453,"en":"Had become plain;"},{"id":"semetey-1-2013:p1143:b006:l009","ordinal":163454,"en":"It had trapped and besieged"},{"id":"semetey-1-2013:p1143:b006:l010","ordinal":163455,"en":"The mere handful of Muslims."},{"id":"semetey-1-2013:p1143:b006:l011","ordinal":163456,"en":"With Khan Koshoy at their head,"},{"id":"semetey-1-2013:p1143:b006:l012","ordinal":163457,"en":"The valiant men could not take command;"},{"id":"semetey-1-2013:p1143:b007:l001","ordinal":163458,"en":"They had allowed Kökötöy's cooking pits"},{"id":"semetey-1-2013:p1143:b007:l002","ordinal":163459,"en":"To be plundered"},{"id":"semetey-1-2013:p1143:b007:l003","ordinal":163460,"en":"By the Black Chinese and Manchus."},{"id":"semetey-1-2013:p1143:b007:l004","ordinal":163461,"en":"They hastened toward their horses"},{"id":"semetey-1-2013:p1143:b007:l005","ordinal":163462,"en":"And broke into a run."},{"id":"semetey-1-2013:p1143:b007:l006","ordinal":163463,"en":"The mere handful of Muslims"},{"id":"semetey-1-2013:p1143:b007:l007","ordinal":163464,"en":"Had then despaired"},{"id":"semetey-1-2013:p1143:b007:l008","ordinal":163465,"en":"Of their mortal lives."},{"id":"semetey-1-2013:p1143:b007:l009","ordinal":163466,"en":"Shouting, “Khan Manas!”"},{"id":"semetey-1-2013:p1143:b007:l010","ordinal":163467,"en":"When the forty companions entered,"},{"id":"semetey-1-2013:p1143:b007:l011","ordinal":163468,"en":"I saw your uncle Koshoy"},{"id":"semetey-1-2013:p1143:b007:l012","ordinal":163469,"en":"Fail to rise from his place."},{"id":"semetey-1-2013:p1144:b003:l001","ordinal":163470,"en":"The giants of the Muslims"},{"id":"semetey-1-2013:p1144:b003:l002","ordinal":163471,"en":"Could find no composure;"},{"id":"semetey-1-2013:p1144:b003:l003","ordinal":163472,"en":"When they saw Khan Manas,"},{"id":"semetey-1-2013:p1144:b003:l004","ordinal":163473,"en":"As though they had seen their father,"},{"id":"semetey-1-2013:p1144:b003:l005","ordinal":163474,"en":"I saw them weep."},{"id":"semetey-1-2013:p1144:b003:l006","ordinal":163475,"en":"“Where is Manas, where?” they cried;"},{"id":"semetey-1-2013:p1144:b003:l007","ordinal":163476,"en":"I saw them panic."},{"id":"semetey-1-2013:p1144:b003:l008","ordinal":163477,"en":"The Black Kalmyks and Manchus,"},{"id":"semetey-1-2013:p1144:b003:l009","ordinal":163478,"en":"Saying, “The bloodthirsty Burut has come,”"},{"id":"semetey-1-2013:p1144:b003:l010","ordinal":163479,"en":"Abandoned their violence;"},{"id":"semetey-1-2013:p1144:b003:l011","ordinal":163480,"en":"With Ezkara and Zholoy at their head,"},{"id":"semetey-1-2013:p1144:b003:l012","ordinal":163481,"en":"I saw where they fled."},{"id":"semetey-1-2013:p1144:b003:l013","ordinal":163482,"en":"I saw the stone-carrying Chinese"},{"id":"semetey-1-2013:p1144:b003:l014","ordinal":163483,"en":"Bow like brides"},{"id":"semetey-1-2013:p1144:b003:l015","ordinal":163484,"en":"And fall into turmoil."},{"id":"semetey-1-2013:p1144:b003:l016","ordinal":163485,"en":"Ezkara, khan of the Manchus,"},{"id":"semetey-1-2013:p1144:b003:l017","ordinal":163486,"en":"Boasted among the people;"},{"id":"semetey-1-2013:p1144:b003:l018","ordinal":163487,"en":"I saw him assess Manas:"},{"id":"semetey-1-2013:p1144:b003:l019","ordinal":163488,"en":"“He has a black hat as big as a cauldron."},{"id":"semetey-1-2013:p1144:b003:l020","ordinal":163489,"en":"If infidel and Muslim alike"},{"id":"semetey-1-2013:p1144:b003:l021","ordinal":163490,"en":"Attacked him together,"},{"id":"semetey-1-2013:p1144:b003:l022","ordinal":163491,"en":"He has the power to swallow them all,"},{"id":"semetey-1-2013:p1144:b003:l023","ordinal":163492,"en":"Counting them less than a hair."},{"id":"semetey-1-2013:p1144:b003:l024","ordinal":163493,"en":"If we show hostility to Manas,"},{"id":"semetey-1-2013:p1144:b003:l025","ordinal":163494,"en":"We will all meet our end together."},{"id":"semetey-1-2013:p1144:b003:l026","ordinal":163495,"en":"Even if all Beijing came as one,"},{"id":"semetey-1-2013:p1144:b003:l027","ordinal":163496,"en":"He would slaughter every one."},{"id":"semetey-1-2013:p1144:b003:l028","ordinal":163497,"en":"The massed Chinese gossip"},{"id":"semetey-1-2013:p1144:b003:l029","ordinal":163498,"en":"And call him ‘the bloodthirsty Burut’;"},{"id":"semetey-1-2013:p1144:b003:l030","ordinal":163499,"en":"The havoc he brought upon Altai"},{"id":"semetey-1-2013:p1144:b003:l031","ordinal":163500,"en":"Was fitting for a gray wolf."},{"id":"semetey-1-2013:p1144:b003:l032","ordinal":163501,"en":"For the Burut who dwell in mountains,"},{"id":"semetey-1-2013:p1144:b003:l033","ordinal":163502,"en":"Mountain-like Manas is a fortress."},{"id":"semetey-1-2013:p1144:b003:l034","ordinal":163503,"en":"He himself follows the faith of Islam;"},{"id":"semetey-1-2013:p1144:b003:l035","ordinal":163504,"en":"In his heart he means to bring hell"},{"id":"semetey-1-2013:p1144:b003:l036","ordinal":163505,"en":"Upon Beijing, where no flood can pass."},{"id":"semetey-1-2013:p1144:b003:l037","ordinal":163506,"en":"He is an imposing lion,"},{"id":"semetey-1-2013:p1144:b003:l038","ordinal":163507,"en":"The one lion born"},{"id":"semetey-1-2013:p1144:b003:l039","ordinal":163508,"en":"For these Burut."},{"id":"semetey-1-2013:p1144:b004:l001","ordinal":163509,"en":"His wrestling strength is of another order,"},{"id":"semetey-1-2013:p1144:b004:l002","ordinal":163510,"en":"A peerless champion born among the Burut."},{"id":"semetey-1-2013:p1144:b004:l003","ordinal":163511,"en":"His battle cry is ‘Burut!’"},{"id":"semetey-1-2013:p1144:b004:l004","ordinal":163512,"en":"You are a hero, brave Manas;"},{"id":"semetey-1-2013:p1144:b004:l005","ordinal":163513,"en":"Let the Burut destroy these people,” he said."},{"id":"semetey-1-2013:p1144:b004:l006","ordinal":163514,"en":"Speaking many words in grief,"},{"id":"semetey-1-2013:p1144:b004:l007","ordinal":163515,"en":"Ezkara drew back."},{"id":"semetey-1-2013:p1144:b004:l008","ordinal":163516,"en":"“Beyond these people lies the Kakan land;"},{"id":"semetey-1-2013:p1144:b004:l009","ordinal":163517,"en":"Opposite them lies Bakburchun."},{"id":"semetey-1-2013:p1144:b004:l010","ordinal":163518,"en":"I have seen all of these people."},{"id":"semetey-1-2013:p1144:b004:l011","ordinal":163519,"en":"Even one whom the Chinese call a hero"},{"id":"semetey-1-2013:p1144:b004:l012","ordinal":163520,"en":"Is the work of God."},{"id":"semetey-1-2013:p1144:b004:l013","ordinal":163521,"en":"If all Beijing gathered,"},{"id":"semetey-1-2013:p1144:b004:l014","ordinal":163522,"en":"He is a man who could slaughter it in one day;"},{"id":"semetey-1-2013:p1144:b004:l015","ordinal":163523,"en":"We came as guests and plundered meat—"},{"id":"semetey-1-2013:p1144:b004:l016","ordinal":163524,"en":"This too was the work of God."},{"id":"semetey-1-2013:p1144:b004:l017","ordinal":163525,"en":"If resentment enters his heart,"},{"id":"semetey-1-2013:p1144:b004:l018","ordinal":163526,"en":"He is a man who could slaughter us all"},{"id":"semetey-1-2013:p1144:b004:l019","ordinal":163527,"en":"Here at this very feast."},{"id":"semetey-1-2013:p1144:b004:l020","ordinal":163528,"en":"If Manas roars and gathers strength,"},{"id":"semetey-1-2013:p1144:b004:l021","ordinal":163529,"en":"What can we say we have done?"},{"id":"semetey-1-2013:p1144:b004:l022","ordinal":163530,"en":"We began the lawlessness"},{"id":"semetey-1-2013:p1144:b004:l023","ordinal":163531,"en":"And ate all the meat."},{"id":"semetey-1-2013:p1144:b004:l024","ordinal":163532,"en":"Does he perhaps know"},{"id":"semetey-1-2013:p1144:b004:l025","ordinal":163533,"en":"The cowardice of the seething Manchus?"},{"id":"semetey-1-2013:p1144:b004:l026","ordinal":163534,"en":"If Khan Manas grows wrathful,"},{"id":"semetey-1-2013:p1144:b004:l027","ordinal":163535,"en":"Perhaps he will drive us as far as Kakan."},{"id":"semetey-1-2013:p1144:b004:l028","ordinal":163536,"en":"Beneath him is the dun horse;"},{"id":"semetey-1-2013:p1144:b004:l029","ordinal":163537,"en":"Bloodthirsty Manas the lion"},{"id":"semetey-1-2013:p1144:b004:l030","ordinal":163538,"en":"Has strength that reaches across the world."},{"id":"semetey-1-2013:p1144:b004:l031","ordinal":163539,"en":"He has armor no bullet pierces;"},{"id":"semetey-1-2013:p1144:b004:l032","ordinal":163540,"en":"Mighty Manas has great power."},{"id":"semetey-1-2013:p1144:b004:l033","ordinal":163541,"en":"Seeing his young horse, we attacked;"},{"id":"semetey-1-2013:p1144:b004:l034","ordinal":163542,"en":"We erred in demanding Maaniker,"},{"id":"semetey-1-2013:p1144:b004:l035","ordinal":163543,"en":"And made ready to seize it."},{"id":"semetey-1-2013:p1144:b004:l036","ordinal":163544,"en":"Beside him is Almambet,"},{"id":"semetey-1-2013:p1144:b004:l037","ordinal":163545,"en":"Who made his golden throne into grease"},{"id":"semetey-1-2013:p1144:b004:l038","ordinal":163546,"en":"And laid low his father, Khan Azazil."},{"id":"semetey-1-2013:p1144:b004:l039","ordinal":163547,"en":"He follows the faith of Islam,"},{"id":"semetey-1-2013:p1145:b003:l001","ordinal":163548,"en":"In the land of our enemy."},{"id":"semetey-1-2013:p1145:b003:l002","ordinal":163549,"en":"Had you not heard?"},{"id":"semetey-1-2013:p1145:b003:l003","ordinal":163550,"en":"What he gathered remains in Kakan;"},{"id":"semetey-1-2013:p1145:b003:l004","ordinal":163551,"en":"What he desires is the faith."},{"id":"semetey-1-2013:p1145:b003:l005","ordinal":163552,"en":"What he gathered remains in Beijing;"},{"id":"semetey-1-2013:p1145:b003:l006","ordinal":163553,"en":"What he watches is the faith."},{"id":"semetey-1-2013:p1145:b003:l007","ordinal":163554,"en":"He has words of resentment;"},{"id":"semetey-1-2013:p1145:b003:l008","ordinal":163555,"en":"Have you heard"},{"id":"semetey-1-2013:p1145:b003:l009","ordinal":163556,"en":"Of his revenge for his mother's death?"},{"id":"semetey-1-2013:p1145:b003:l010","ordinal":163557,"en":"If Manas is driven into a rage,"},{"id":"semetey-1-2013:p1145:b003:l011","ordinal":163558,"en":"He has reason to clash with us."},{"id":"semetey-1-2013:p1145:b003:l012","ordinal":163559,"en":"Khan Zholoy of the Kalmyks"},{"id":"semetey-1-2013:p1145:b003:l013","ordinal":163560,"en":"And Kongurbai, khan of the monks,"},{"id":"semetey-1-2013:p1145:b003:l014","ordinal":163561,"en":"Grew wrathful and excited,"},{"id":"semetey-1-2013:p1145:b003:l015","ordinal":163562,"en":"And spoke to Ezkara:"},{"id":"semetey-1-2013:p1145:b003:l016","ordinal":163563,"en":"“If he does not agree to my demand,"},{"id":"semetey-1-2013:p1145:b003:l017","ordinal":163564,"en":"If he does not give Maaniker,"},{"id":"semetey-1-2013:p1145:b003:l018","ordinal":163565,"en":"I will gather an army from Beijing."},{"id":"semetey-1-2013:p1145:b003:l019","ordinal":163566,"en":"While my valiant soul lives,"},{"id":"semetey-1-2013:p1145:b003:l020","ordinal":163567,"en":"I will not stand idly by.”"},{"id":"semetey-1-2013:p1145:b003:l021","ordinal":163568,"en":"Brave Kongurbai said this,"},{"id":"semetey-1-2013:p1145:b003:l022","ordinal":163569,"en":"Thudding in anger."},{"id":"semetey-1-2013:p1145:b003:l023","ordinal":163570,"en":"Dear Zholoy blustered,"},{"id":"semetey-1-2013:p1145:b003:l024","ordinal":163571,"en":"Saying, “I will bring disaster upon his feast.”"},{"id":"semetey-1-2013:p1145:b003:l025","ordinal":163572,"en":"Saying Manas the leopard had come,"},{"id":"semetey-1-2013:p1145:b003:l026","ordinal":163573,"en":"The Muslim people rejoiced."},{"id":"semetey-1-2013:p1145:b003:l027","ordinal":163574,"en":"Had this Manas not come,"},{"id":"semetey-1-2013:p1145:b003:l028","ordinal":163575,"en":"They were going to intensify the wounds,"},{"id":"semetey-1-2013:p1145:b003:l029","ordinal":163576,"en":"Bring calamity upon"},{"id":"semetey-1-2013:p1145:b003:l030","ordinal":163577,"en":"The Muslim people,"},{"id":"semetey-1-2013:p1145:b003:l031","ordinal":163578,"en":"Begin their devastation,"},{"id":"semetey-1-2013:p1145:b003:l032","ordinal":163579,"en":"And make a spectacle no man should see."},{"id":"semetey-1-2013:p1145:b003:l033","ordinal":163580,"en":"A spectacle of horror."},{"id":"semetey-1-2013:p1145:b003:l034","ordinal":163581,"en":"A saint supported by the spirits,"},{"id":"semetey-1-2013:p1145:b003:l035","ordinal":163582,"en":"Your elder uncle Koshoy,"},{"id":"semetey-1-2013:p1145:b003:l036","ordinal":163583,"en":"Turned to the matter"},{"id":"semetey-1-2013:p1145:b003:l037","ordinal":163584,"en":"And spoke these words without cease:"}]
