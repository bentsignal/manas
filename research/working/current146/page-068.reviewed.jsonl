{"id": "sayakbay-ms-current146:pdf068:l006", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 68, "folio": 451, "line_in_page": 6, "raw": "Бу кыргыз үчүн Кытай турмак,", "text": "Бу кыргыз үчүн Кытай турмак,", "en": "For these Kyrgyz—not merely China—", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Cursive reading, word division, or idiomatic interpretation is provisional.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf068:l007", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 68, "folio": 451, "line_in_page": 7, "raw": "Жеринин деген экенсиң.", "text": "Жеринин деген экенсиң.", "en": "It seems you called it their land.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Cursive reading, word division, or idiomatic interpretation is provisional.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf068:l008", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 68, "folio": 451, "line_in_page": 8, "raw": "Халк бүлдүрүп жүрдүң,", "text": "Халк бүлдүрүп жүрдүң,", "en": "You went about ruining the people,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf068:l009", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 68, "folio": 451, "line_in_page": 9, "raw": "Бу Каканчынын элчиси,", "text": "Бу Каканчынын элчиси,", "en": "This envoy of the Kakanchi,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Cursive reading, word division, or idiomatic interpretation is provisional.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf068:l010", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 68, "folio": 451, "line_in_page": 10, "raw": "Кетейин деген экенсиң.", "text": "Кетейин деген экенсиң.", "en": "It seems you intended to leave.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf068:l011", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 68, "folio": 451, "line_in_page": 11, "raw": "Элчи эмессиң, жерчисиң,", "text": "Элчи эмессиң, жерчисиң,", "en": "You are no envoy; you are a land surveyor,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf068:l012", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 68, "folio": 451, "line_in_page": 12, "raw": "Бул эл алдаган зерчисиң!", "text": "Бул эл алдаган зерчисиң!", "en": "You are the cunning deceiver of these people!", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf068:l013", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 68, "folio": 451, "line_in_page": 13, "raw": "Журт бүлдүргөн түрүң,", "text": "Журт бүлдүргөн түрүң,", "en": "Your manner is that of one who ruins a people,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Cursive reading, word division, or idiomatic interpretation is provisional.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf068:l014", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 68, "folio": 451, "line_in_page": 14, "raw": "Кара тажаал түрүң,", "text": "Кара тажаал түрүң,", "en": "Your form is that of a black scourge,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf068:l015", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 68, "folio": 451, "line_in_page": 15, "raw": "Миң сандаган миңдүүсүң,", "text": "Миң сандаган миңдүүсүң,", "en": "You are one of the thousands beyond counting,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Cursive reading, word division, or idiomatic interpretation is provisional.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf068:l016", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 68, "folio": 451, "line_in_page": 16, "raw": "Журт бүлдүрчү өзүсүң,", "text": "Журт бүлдүрчү өзүсүң,", "en": "You yourself are the destroyer of the people,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf068:l017", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 68, "folio": 451, "line_in_page": 17, "raw": "Чын бузуктун көзүсүң.", "text": "Чын бузуктун көзүсүң.", "en": "You are the very eye of corruption.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf068:l018", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 68, "folio": 451, "line_in_page": 18, "raw": "Айткан кебиң сан бөлөк,", "text": "Айткан кебиң сан бөлөк,", "en": "The words you speak are endlessly different,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf068:l019", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 68, "folio": 451, "line_in_page": 19, "raw": "Тирүү койсом өзүңдү", "text": "Тирүү койсом өзүңдү", "en": "If I leave you alive,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf068:l020", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 68, "folio": 451, "line_in_page": 20, "raw": "Быттай ишти бузасың.", "text": "Быттай ишти бузасың.", "en": "You will ruin a louse-sized matter.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf068:l021", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 68, "folio": 451, "line_in_page": 21, "raw": "Кылчайбастан кытайга", "text": "Кылчайбастан кытайга", "en": "Without looking back toward China,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf068:l022", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 68, "folio": 451, "line_in_page": 22, "raw": "Кыргызды көздөй сызасың!", "text": "Кыргызды көздөй сызасың!", "en": "You will race straight toward the Kyrgyz!", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf068:l023", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 68, "folio": 451, "line_in_page": 23, "raw": "Калдайып таштап турсаң,", "text": "Калдайып таштап турсаң,", "en": "If you stand there sprawling and abandon it,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Cursive reading, word division, or idiomatic interpretation is provisional.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf068:l024", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 68, "folio": 451, "line_in_page": 24, "raw": "Кыргызга айың коносуң.", "text": "Кыргызга айың коносуң.", "en": "Your blame will settle upon the Kyrgyz.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Cursive reading, word division, or idiomatic interpretation is provisional.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf068:l025", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 68, "folio": 451, "line_in_page": 25, "raw": "Чыңгырасаң Бээжинди,", "text": "Чыңгырасаң Бээжинди,", "en": "If you make Beijing ring out,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Cursive reading, word division, or idiomatic interpretation is provisional.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf068:l026", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 68, "folio": 451, "line_in_page": 26, "raw": "Түксүз айтып чыныңды,", "text": "Түксүз айтып чыныңды,", "en": "Speaking your truth without reserve,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Cursive reading, word division, or idiomatic interpretation is provisional.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf068:l027", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 68, "folio": 451, "line_in_page": 27, "raw": "Ичин таап колуңду,", "text": "Ичин таап колуңду,", "en": "Finding its inside with your hand,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Cursive reading, word division, or idiomatic interpretation is provisional.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf068:l028", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 68, "folio": 451, "line_in_page": 28, "raw": "Эз кылсаң колуңду.", "text": "Эз кылсаң колуңду.", "en": "If you make your hand a servant,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Cursive reading, word division, or idiomatic interpretation is provisional.", "bbox": null}
