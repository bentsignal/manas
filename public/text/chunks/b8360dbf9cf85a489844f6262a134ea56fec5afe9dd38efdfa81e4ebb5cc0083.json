[{"id":"semetey-1-2013:p1319:b004:l011","ordinal":177921,"en":"And your blood has not reached full strength!"},{"id":"semetey-1-2013:p1319:b004:l012","ordinal":177922,"en":"Without grieving your uncle Bakai,"},{"id":"semetey-1-2013:p1319:b004:l013","ordinal":177923,"en":"Heed him this year."},{"id":"semetey-1-2013:p1319:b004:l014","ordinal":177924,"en":"Without grieving your uncle Bakai,"},{"id":"semetey-1-2013:p1319:b004:l015","ordinal":177925,"en":"Go in the coming year!"},{"id":"semetey-1-2013:p1319:b004:l016","ordinal":177926,"en":"Carefully scout the road"},{"id":"semetey-1-2013:p1319:b004:l017","ordinal":177927,"en":"To Beijing beyond a saint's reach."},{"id":"semetey-1-2013:p1319:b004:l018","ordinal":177928,"en":"If you wage holy war against Kakan-Chyn,"},{"id":"semetey-1-2013:p1319:b004:l019","ordinal":177929,"en":"The Chinese are numerous as black worms."},{"id":"semetey-1-2013:p1319:b004:l020","ordinal":177930,"en":"Against infidels like black worms,"},{"id":"semetey-1-2013:p1319:b004:l021","ordinal":177931,"en":"You have chosen to grapple;"},{"id":"semetey-1-2013:p1319:b004:l022","ordinal":177932,"en":"Against hero Khan Kongurbai,"},{"id":"semetey-1-2013:p1319:b004:l023","ordinal":177933,"en":"He is no foe to rush upon thoughtlessly."},{"id":"semetey-1-2013:p1319:b004:l024","ordinal":177934,"en":"Sacred Great Beijing—"},{"id":"semetey-1-2013:p1319:b004:l025","ordinal":177935,"en":"None who grapple it returns unharmed."},{"id":"semetey-1-2013:p1319:b004:l026","ordinal":177936,"en":"From radiance-pouring Beijing,"},{"id":"semetey-1-2013:p1319:b004:l027","ordinal":177937,"en":"Of Beijing's forty gates,"},{"id":"semetey-1-2013:p1319:b004:l028","ordinal":177938,"en":"I have seen one gate."},{"id":"semetey-1-2013:p1319:b004:l029","ordinal":177939,"en":"Closed by day, by day it stood open;"},{"id":"semetey-1-2013:p1319:b004:l030","ordinal":177940,"en":"Its mouth opened toward the qibla."},{"id":"semetey-1-2013:p1319:b004:l031","ordinal":177941,"en":"At the mouth of that gate,"},{"id":"semetey-1-2013:p1319:b004:l032","ordinal":177942,"en":"The Bismillah verse was written."},{"id":"semetey-1-2013:p1319:b004:l033","ordinal":177943,"en":"The followers of Muhammad—"},{"id":"semetey-1-2013:p1319:b004:l034","ordinal":177944,"en":"When they came into Muslim hands,"},{"id":"semetey-1-2013:p1319:b004:l035","ordinal":177945,"en":"Lest a devil strike them,"},{"id":"semetey-1-2013:p1319:b004:l036","ordinal":177946,"en":"God's light was scattered there."},{"id":"semetey-1-2013:p1319:b004:l037","ordinal":177947,"en":"They have pride, but no faith;"},{"id":"semetey-1-2013:p1319:b004:l038","ordinal":177948,"en":"That is the land pouring forth radiance."},{"id":"semetey-1-2013:p1319:b004:l039","ordinal":177949,"en":"I am that battered Bakai"},{"id":"semetey-1-2013:p1319:b004:l040","ordinal":177950,"en":"Who devoured its great lords!"},{"id":"semetey-1-2013:p1320:b003:l001","ordinal":177951,"en":"Let us reckon the years,"},{"id":"semetey-1-2013:p1320:b003:l002","ordinal":177952,"en":"And choose an auspicious year"},{"id":"semetey-1-2013:p1320:b003:l003","ordinal":177953,"en":"To go to mourning Beijing!"},{"id":"semetey-1-2013:p1320:b003:l004","ordinal":177954,"en":"Let us reckon the days,"},{"id":"semetey-1-2013:p1320:b003:l005","ordinal":177955,"en":"Set the day down in writing,"},{"id":"semetey-1-2013:p1320:b003:l006","ordinal":177956,"en":"And choose an auspicious day"},{"id":"semetey-1-2013:p1320:b003:l007","ordinal":177957,"en":"To go to lowering Beijing!"},{"id":"semetey-1-2013:p1320:b003:l008","ordinal":177958,"en":"The Kakanchin have their people"},{"id":"semetey-1-2013:p1320:b003:l009","ordinal":177959,"en":"And giants of many kinds;"},{"id":"semetey-1-2013:p1320:b003:l010","ordinal":177960,"en":"By custom they drink the blood"},{"id":"semetey-1-2013:p1320:b003:l011","ordinal":177961,"en":"Of the mortal who challenges them."},{"id":"semetey-1-2013:p1320:b003:l012","ordinal":177962,"en":"Chin-Machin has its people,"},{"id":"semetey-1-2013:p1320:b003:l013","ordinal":177963,"en":"And the true Kalcha has eyes;"},{"id":"semetey-1-2013:p1320:b003:l014","ordinal":177964,"en":"Its people swarm in multitudes,"},{"id":"semetey-1-2013:p1320:b003:l015","ordinal":177965,"en":"And by custom drink the blood"},{"id":"semetey-1-2013:p1320:b003:l016","ordinal":177966,"en":"Of those who go against them."},{"id":"semetey-1-2013:p1320:b003:l017","ordinal":177967,"en":"Yesterday, when Saint Ali the lion"},{"id":"semetey-1-2013:p1320:b003:l018","ordinal":177968,"en":"Went there intending to fight,"},{"id":"semetey-1-2013:p1320:b003:l019","ordinal":177969,"en":"When he brought splendid slaughter,"},{"id":"semetey-1-2013:p1320:b003:l020","ordinal":177970,"en":"When he went intending to destroy them"},{"id":"semetey-1-2013:p1320:b003:l021","ordinal":177971,"en":"And unleashed great turmoil,"},{"id":"semetey-1-2013:p1320:b003:l022","ordinal":177972,"en":"When he was about to convert"},{"id":"semetey-1-2013:p1320:b003:l023","ordinal":177973,"en":"The defeated Chinese to Islam,"},{"id":"semetey-1-2013:p1320:b003:l024","ordinal":177974,"en":"A voice sounded from heaven"},{"id":"semetey-1-2013:p1320:b003:l025","ordinal":177975,"en":"And appeared to Ali the lion:"},{"id":"semetey-1-2013:p1320:b003:l026","ordinal":177976,"en":"\"There is abundance and no hunger;"},{"id":"semetey-1-2013:p1320:b003:l027","ordinal":177977,"en":"This Beijing surges with people."},{"id":"semetey-1-2013:p1320:b003:l028","ordinal":177978,"en":"In heaven Chalyiar's voice rang out;"},{"id":"semetey-1-2013:p1320:b003:l029","ordinal":177979,"en":"It has no faith, but it has number."},{"id":"semetey-1-2013:p1320:b003:l030","ordinal":177980,"en":"Carpets lie spread across the land;"},{"id":"semetey-1-2013:p1320:b003:l031","ordinal":177981,"en":"Great Beijing is bathed in radiance."},{"id":"semetey-1-2013:p1320:b003:l032","ordinal":177982,"en":"Turn back without troubling yourself.\""},{"id":"semetey-1-2013:p1320:b003:l033","ordinal":177983,"en":"When he heard this voice,"},{"id":"semetey-1-2013:p1320:b003:l034","ordinal":177984,"en":"Saint Ali turned away;"},{"id":"semetey-1-2013:p1320:b003:l035","ordinal":177985,"en":"Without fighting Beijing,"},{"id":"semetey-1-2013:p1320:b003:l036","ordinal":177986,"en":"He turned back midway."},{"id":"semetey-1-2013:p1320:b003:l037","ordinal":177987,"en":"That is a land from which none return;"},{"id":"semetey-1-2013:p1320:b003:l038","ordinal":177988,"en":"Those Chinese are a prolific people,"},{"id":"semetey-1-2013:p1320:b003:l039","ordinal":177989,"en":"Smoldering anew whenever they are depleted,"},{"id":"semetey-1-2013:p1320:b003:l040","ordinal":177990,"en":"Rooting themselves and growing ever stronger—"},{"id":"semetey-1-2013:p1320:b004:l001","ordinal":177991,"en":"A people upon whom a prayer remains!"},{"id":"semetey-1-2013:p1320:b004:l002","ordinal":177992,"en":"They multiply whenever they die;"},{"id":"semetey-1-2013:p1320:b004:l003","ordinal":177993,"en":"Those are the ruling Chinese people."},{"id":"semetey-1-2013:p1320:b004:l004","ordinal":177994,"en":"The Almighty himself chose it;"},{"id":"semetey-1-2013:p1320:b004:l005","ordinal":177995,"en":"That is a land blessed with abundance!"},{"id":"semetey-1-2013:p1320:b004:l006","ordinal":177996,"en":"Do not behave recklessly,"},{"id":"semetey-1-2013:p1320:b004:l007","ordinal":177997,"en":"Saying you will set your face"},{"id":"semetey-1-2013:p1320:b004:l008","ordinal":177998,"en":"Toward fortified Beijing!"},{"id":"semetey-1-2013:p1320:b004:l009","ordinal":177999,"en":"Yesterday, in Kakanchin's Beijing,"},{"id":"semetey-1-2013:p1320:b004:l010","ordinal":178000,"en":"Its Kalmaks swarmed;"},{"id":"semetey-1-2013:p1320:b004:l011","ordinal":178001,"en":"When God scattered their seed,"},{"id":"semetey-1-2013:p1320:b004:l012","ordinal":178002,"en":"They covered the face of the earth."},{"id":"semetey-1-2013:p1320:b004:l013","ordinal":178003,"en":"From sunrise to sunset,"},{"id":"semetey-1-2013:p1320:b004:l014","ordinal":178004,"en":"They are a multitude made of men,"},{"id":"semetey-1-2013:p1320:b004:l015","ordinal":178005,"en":"A teeming Chinese people."},{"id":"semetey-1-2013:p1320:b004:l016","ordinal":178006,"en":"Kara Khan, father of the people,"},{"id":"semetey-1-2013:p1320:b004:l017","ordinal":178007,"en":"Was of Kyrgyz stock."},{"id":"semetey-1-2013:p1320:b004:l018","ordinal":178008,"en":"He met his death and died;"},{"id":"semetey-1-2013:p1320:b004:l019","ordinal":178009,"en":"When Kara Khan's eight sons"},{"id":"semetey-1-2013:p1320:b004:l020","ordinal":178010,"en":"Were left young and crawling,"},{"id":"semetey-1-2013:p1320:b004:l021","ordinal":178011,"en":"The Chinese seized them"},{"id":"semetey-1-2013:p1320:b004:l022","ordinal":178012,"en":"And divided them by the lash;"},{"id":"semetey-1-2013:p1320:b004:l023","ordinal":178013,"en":"Those fated to die perished."},{"id":"semetey-1-2013:p1320:b004:l024","ordinal":178014,"en":"They drove one away to Eren"},{"id":"semetey-1-2013:p1320:b004:l025","ordinal":178015,"en":"And cast him into the deep."},{"id":"semetey-1-2013:p1320:b004:l026","ordinal":178016,"en":"They drove one to Altai,"},{"id":"semetey-1-2013:p1320:b004:l027","ordinal":178017,"en":"And another to Kangai."},{"id":"semetey-1-2013:p1320:b004:l028","ordinal":178018,"en":"The eight were scattered,"},{"id":"semetey-1-2013:p1320:b004:l029","ordinal":178019,"en":"Some of them twins born of one mother;"},{"id":"semetey-1-2013:p1320:b004:l030","ordinal":178020,"en":"Unable to find them by asking everywhere,"},{"id":"semetey-1-2013:p1320:b004:l031","ordinal":178021,"en":"How many souls withered away."},{"id":"semetey-1-2013:p1320:b004:l032","ordinal":178022,"en":"That Yakyp was driven away,"},{"id":"semetey-1-2013:p1320:b004:l033","ordinal":178023,"en":"And Manas was born in Altai."},{"id":"semetey-1-2013:p1320:b004:l034","ordinal":178024,"en":"When he heard of his kinsmen's fate,"},{"id":"semetey-1-2013:p1320:b004:l035","ordinal":178025,"en":"Your falcon father, the leopard,"},{"id":"semetey-1-2013:p1320:b004:l036","ordinal":178026,"en":"Born there in Altai,"},{"id":"semetey-1-2013:p1320:b004:l037","ordinal":178027,"en":"Threw China into turmoil."},{"id":"semetey-1-2013:p1320:b004:l038","ordinal":178028,"en":"Your bloodthirsty father, the leopard,"},{"id":"semetey-1-2013:p1320:b004:l039","ordinal":178029,"en":"Unleashed the upheaval;"},{"id":"semetey-1-2013:p1320:b004:l040","ordinal":178030,"en":"Esen Khan was a great lord,"},{"id":"semetey-1-2013:p1321:b003:l001","ordinal":178031,"en":"But your father brought him hardship then"},{"id":"semetey-1-2013:p1321:b003:l002","ordinal":178032,"en":"And slaughtered him utterly."},{"id":"semetey-1-2013:p1321:b003:l003","ordinal":178033,"en":"People fell into ruin on hearing his name;"},{"id":"semetey-1-2013:p1321:b003:l004","ordinal":178034,"en":"The calamities your father wrought"},{"id":"semetey-1-2013:p1321:b003:l005","ordinal":178035,"en":"Were inscribed in the register"},{"id":"semetey-1-2013:p1321:b003:l006","ordinal":178036,"en":"Of the khan of Kakanchin."},{"id":"semetey-1-2013:p1321:b003:l007","ordinal":178037,"en":"Yesterday, at Kökötöi's feast,"},{"id":"semetey-1-2013:p1321:b003:l008","ordinal":178038,"en":"An evil quarrel arose from the Chinese,"},{"id":"semetey-1-2013:p1321:b003:l009","ordinal":178039,"en":"And many disputes arose from the Kyrgyz."},{"id":"semetey-1-2013:p1321:b003:l010","ordinal":178040,"en":"The twelve Muslim khans,"},{"id":"semetey-1-2013:p1321:b003:l011","ordinal":178041,"en":"Along the broad Alai,"},{"id":"semetey-1-2013:p1321:b003:l012","ordinal":178042,"en":"At hero Töshtük's feast,"},{"id":"semetey-1-2013:p1321:b003:l013","ordinal":178043,"en":"Said, \"We shall plunder the Bloodthirsty One"},{"id":"semetey-1-2013:p1321:b003:l014","ordinal":178044,"en":"And bring an upheaval!\""},{"id":"semetey-1-2013:p1321:b003:l015","ordinal":178045,"en":"They sent envoys,"},{"id":"semetey-1-2013:p1321:b003:l016","ordinal":178046,"en":"Stirring up the ancient madness;"},{"id":"semetey-1-2013:p1321:b003:l017","ordinal":178047,"en":"After rousing the Muslims"},{"id":"semetey-1-2013:p1321:b003:l018","ordinal":178048,"en":"To charge and make war"},{"id":"semetey-1-2013:p1321:b003:l019","ordinal":178049,"en":"Against Kakanchin's Beijing,"},{"id":"semetey-1-2013:p1321:b003:l020","ordinal":178050,"en":"They said they would enter directly"},{"id":"semetey-1-2013:p1321:b003:l021","ordinal":178051,"en":"Into lowering great Beijing and level their spears."},{"id":"semetey-1-2013:p1321:b003:l022","ordinal":178052,"en":"The road was blessed by Khizr,"},{"id":"semetey-1-2013:p1321:b003:l023","ordinal":178053,"en":"And the army numbered forty-two tumens."},{"id":"semetey-1-2013:p1321:b003:l024","ordinal":178054,"en":"All the saints were there,"},{"id":"semetey-1-2013:p1321:b003:l025","ordinal":178055,"en":"And all twelve Muslim khans"},{"id":"semetey-1-2013:p1321:b003:l026","ordinal":178056,"en":"Were among them."},{"id":"semetey-1-2013:p1321:b003:l027","ordinal":178057,"en":"They had wrestlers and a great people;"},{"id":"semetey-1-2013:p1321:b003:l028","ordinal":178058,"en":"All their heroes were there."},{"id":"semetey-1-2013:p1321:b003:l029","ordinal":178059,"en":"They had skillful spearmen,"},{"id":"semetey-1-2013:p1321:b003:l030","ordinal":178060,"en":"And champions who knew the enemy's stratagems."},{"id":"semetey-1-2013:p1321:b003:l031","ordinal":178061,"en":"There were lions Almambet and Chubak,"},{"id":"semetey-1-2013:p1321:b003:l032","ordinal":178062,"en":"And leopards Serek and Syrgak,"},{"id":"semetey-1-2013:p1321:b003:l033","ordinal":178063,"en":"Heroes who had traversed the world."},{"id":"semetey-1-2013:p1321:b003:l034","ordinal":178064,"en":"They stood against the enemy"},{"id":"semetey-1-2013:p1321:b003:l035","ordinal":178065,"en":"And fought without pause for six months,"},{"id":"semetey-1-2013:p1321:b003:l036","ordinal":178066,"en":"Remaining there without pause for six months."},{"id":"semetey-1-2013:p1321:b003:l037","ordinal":178067,"en":"When they were exacting judgment"},{"id":"semetey-1-2013:p1321:b003:l038","ordinal":178068,"en":"From Beijing, where even Solomon had not gone,"},{"id":"semetey-1-2013:p1321:b003:l039","ordinal":178069,"en":"Swaggering heroes died,"},{"id":"semetey-1-2013:p1321:b003:l040","ordinal":178070,"en":"Many generous souls died,"},{"id":"semetey-1-2013:p1321:b005:l001","ordinal":178071,"en":"And everyone who met the foe died."},{"id":"semetey-1-2013:p1321:b005:l002","ordinal":178072,"en":"When they turned back this way,"},{"id":"semetey-1-2013:p1321:b005:l003","ordinal":178073,"en":"Beijing's affairs recovered,"},{"id":"semetey-1-2013:p1321:b005:l004","ordinal":178074,"en":"And all the valiant men were lost."},{"id":"semetey-1-2013:p1321:b005:l005","ordinal":178075,"en":"Great Beijing is a place from which none return;"},{"id":"semetey-1-2013:p1321:b005:l006","ordinal":178076,"en":"It shears down everyone from the head."},{"id":"semetey-1-2013:p1321:b005:l007","ordinal":178077,"en":"Every living soul who went there died;"},{"id":"semetey-1-2013:p1321:b005:l008","ordinal":178078,"en":"Many khans died."},{"id":"semetey-1-2013:p1321:b005:l009","ordinal":178079,"en":"Do not ask what Beijing is like:"},{"id":"semetey-1-2013:p1321:b005:l010","ordinal":178080,"en":"Its passes are said to be dug trenches,"},{"id":"semetey-1-2013:p1321:b005:l011","ordinal":178081,"en":"And its road one from which none return."},{"id":"semetey-1-2013:p1321:b005:l012","ordinal":178082,"en":"Whoever sets his face toward it is killed;"},{"id":"semetey-1-2013:p1321:b005:l013","ordinal":178083,"en":"Great Beijing's danger is fierce."},{"id":"semetey-1-2013:p1321:b005:l014","ordinal":178084,"en":"Whoever goes there does not turn back;"},{"id":"semetey-1-2013:p1321:b005:l015","ordinal":178085,"en":"Whoever meets it does not return alive."},{"id":"semetey-1-2013:p1321:b005:l016","ordinal":178086,"en":"Many people have gone"},{"id":"semetey-1-2013:p1321:b005:l017","ordinal":178087,"en":"To Kakanchin's Beijing,"},{"id":"semetey-1-2013:p1321:b005:l018","ordinal":178088,"en":"But none have come back."},{"id":"semetey-1-2013:p1321:b005:l019","ordinal":178089,"en":"It yielded no judgment to Suuk Kol,"},{"id":"semetey-1-2013:p1321:b005:l020","ordinal":178090,"en":"And even Zulqarnain did not go there."},{"id":"semetey-1-2013:p1321:b005:l021","ordinal":178091,"en":"The road to Beijing has five branches,"},{"id":"semetey-1-2013:p1321:b005:l022","ordinal":178092,"en":"Bringing peril upon the wretched head."},{"id":"semetey-1-2013:p1321:b005:l023","ordinal":178093,"en":"Beijing is no empty land,"},{"id":"semetey-1-2013:p1321:b005:l024","ordinal":178094,"en":"Nor are its people to be approached lightly."},{"id":"semetey-1-2013:p1321:b005:l025","ordinal":178095,"en":"One road to Beijing"},{"id":"semetey-1-2013:p1321:b005:l026","ordinal":178096,"en":"Is a road from which none return;"},{"id":"semetey-1-2013:p1321:b005:l027","ordinal":178097,"en":"One road to Beijing"},{"id":"semetey-1-2013:p1321:b005:l028","ordinal":178098,"en":"Has a deep-dug trench;"},{"id":"semetey-1-2013:p1321:b005:l029","ordinal":178099,"en":"One road to Beijing"},{"id":"semetey-1-2013:p1321:b005:l030","ordinal":178100,"en":"Has suffering set boiling;"},{"id":"semetey-1-2013:p1321:b005:l031","ordinal":178101,"en":"On one road to Beijing,"},{"id":"semetey-1-2013:p1321:b005:l032","ordinal":178102,"en":"Whoever meets it does not escape alive;"},{"id":"semetey-1-2013:p1321:b005:l033","ordinal":178103,"en":"On one road to Beijing,"},{"id":"semetey-1-2013:p1321:b005:l034","ordinal":178104,"en":"Whoever meets it does not return alive."},{"id":"semetey-1-2013:p1321:b005:l035","ordinal":178105,"en":"Beijing is that prolific land,"},{"id":"semetey-1-2013:p1321:b005:l036","ordinal":178106,"en":"And the Chinese that mighty people."},{"id":"semetey-1-2013:p1321:b005:l037","ordinal":178107,"en":"My worthy one, I am Bakai,"},{"id":"semetey-1-2013:p1321:b005:l038","ordinal":178108,"en":"Who knows all that can be known.\""},{"id":"semetey-1-2013:p1321:b005:l039","ordinal":178109,"en":"When Bakai finished speaking,"},{"id":"semetey-1-2013:p1321:b005:l040","ordinal":178110,"en":"Your dear mother Kanykei—"},{"id":"semetey-1-2013:p1322:b003:l001","ordinal":178111,"en":"From her dear quail-like eyes,"},{"id":"semetey-1-2013:p1322:b003:l002","ordinal":178112,"en":"Tears fell one after another;"},{"id":"semetey-1-2013:p1322:b003:l003","ordinal":178113,"en":"From her dear currant-black eyes,"},{"id":"semetey-1-2013:p1322:b003:l004","ordinal":178114,"en":"Tears streamed a whip's length."},{"id":"semetey-1-2013:p1322:b003:l005","ordinal":178115,"en":"Her heart was torn apart,"},{"id":"semetey-1-2013:p1322:b003:l006","ordinal":178116,"en":"And tears poured from her eyes;"},{"id":"semetey-1-2013:p1322:b003:l007","ordinal":178117,"en":"Allah's sun in the sky grew overcast,"},{"id":"semetey-1-2013:p1322:b003:l008","ordinal":178118,"en":"And sixty cares came upon her head:"},{"id":"semetey-1-2013:p1322:b003:l009","ordinal":178119,"en":"The dear bird called the kazgaldak"},{"id":"semetey-1-2013:p1322:b003:l010","ordinal":178120,"en":"Flies without turning back in search of food;"},{"id":"semetey-1-2013:p1322:b003:l011","ordinal":178121,"en":"How much this wretched head has endured"},{"id":"semetey-1-2013:p1322:b003:l012","ordinal":178122,"en":"For you who came from my womb."},{"id":"semetey-1-2013:p1322:b003:l013","ordinal":178123,"en":"The dear bird called the bezbeldek"},{"id":"semetey-1-2013:p1322:b003:l014","ordinal":178124,"en":"Flies crying shrilly in search of food;"},{"id":"semetey-1-2013:p1322:b003:l015","ordinal":178125,"en":"How much toil I, poor woman, have borne"},{"id":"semetey-1-2013:p1322:b003:l016","ordinal":178126,"en":"For you who came from my body."},{"id":"semetey-1-2013:p1322:b003:l017","ordinal":178127,"en":"You will set your hopes upon Kakan,"},{"id":"semetey-1-2013:p1322:b003:l018","ordinal":178128,"en":"And abandon desolate your homeland"},{"id":"semetey-1-2013:p1322:b003:l019","ordinal":178129,"en":"Of an orphaned son and widowed woman."},{"id":"semetey-1-2013:p1322:b003:l020","ordinal":178130,"en":"It is no enemy one can grapple with,"},{"id":"semetey-1-2013:p1322:b003:l021","ordinal":178131,"en":"Yet you will begin a campaign against Beijing."},{"id":"semetey-1-2013:p1322:b003:l022","ordinal":178132,"en":"You will abandon desolate your village"},{"id":"semetey-1-2013:p1322:b003:l023","ordinal":178133,"en":"Of sixty sons and a widowed woman."},{"id":"semetey-1-2013:p1322:b003:l024","ordinal":178134,"en":"Beijing is no easy land;"},{"id":"semetey-1-2013:p1322:b003:l025","ordinal":178135,"en":"Rather than say, 'I have attacked Beijing,'"},{"id":"semetey-1-2013:p1322:b003:l026","ordinal":178136,"en":"My valiant son, hear my words,"},{"id":"semetey-1-2013:p1322:b003:l027","ordinal":178137,"en":"Say, 'I have entered into danger!'"},{"id":"semetey-1-2013:p1322:b003:l028","ordinal":178138,"en":"Rather than say, 'I struck Kakan,'"},{"id":"semetey-1-2013:p1322:b003:l029","ordinal":178139,"en":"Say, 'I have entered the dark night!'"},{"id":"semetey-1-2013:p1322:b003:l030","ordinal":178140,"en":"Is great Beijing, left to mighty heroes,"},{"id":"semetey-1-2013:p1322:b003:l031","ordinal":178141,"en":"A people lying unaware,"},{"id":"semetey-1-2013:p1322:b003:l032","ordinal":178142,"en":"To be faced and easily conquered?"},{"id":"semetey-1-2013:p1322:b003:l033","ordinal":178143,"en":"Is Kakanchin an easy land,"},{"id":"semetey-1-2013:p1322:b003:l034","ordinal":178144,"en":"To be charged and raided?"},{"id":"semetey-1-2013:p1322:b003:l035","ordinal":178145,"en":"The sovereign Chinese are renowned;"},{"id":"semetey-1-2013:p1322:b003:l036","ordinal":178146,"en":"They have a custom of taking the heads"},{"id":"semetey-1-2013:p1322:b003:l037","ordinal":178147,"en":"Of all who confront them."},{"id":"semetey-1-2013:p1322:b003:l038","ordinal":178148,"en":"My foal, my only one, heed my words:"},{"id":"semetey-1-2013:p1322:b003:l039","ordinal":178149,"en":"No mortal has set his face"},{"id":"semetey-1-2013:p1322:b003:l040","ordinal":178150,"en":"Toward Chin-Machin's Beijing,"},{"id":"semetey-1-2013:p1322:b004:l001","ordinal":178151,"en":"And none who faced it remained alive."},{"id":"semetey-1-2013:p1322:b004:l002","ordinal":178152,"en":"Until the end of time,"},{"id":"semetey-1-2013:p1322:b004:l003","ordinal":178153,"en":"Its daily affairs have prospered;"},{"id":"semetey-1-2013:p1322:b004:l004","ordinal":178154,"en":"Those who traveled saying,"},{"id":"semetey-1-2013:p1322:b004:l005","ordinal":178155,"en":"'I shall make holy war upon Kakan,' vanished."},{"id":"semetey-1-2013:p1322:b004:l006","ordinal":178156,"en":"You have remained to fight"},{"id":"semetey-1-2013:p1322:b004:l007","ordinal":178157,"en":"The Beijing where your father went,"},{"id":"semetey-1-2013:p1322:b004:l008","ordinal":178158,"en":"And have brought surpassing suffering"},{"id":"semetey-1-2013:p1322:b004:l009","ordinal":178159,"en":"Upon me, your impetuous mother."},{"id":"semetey-1-2013:p1322:b004:l010","ordinal":178160,"en":"Beijing is five months away;"},{"id":"semetey-1-2013:p1322:b004:l011","ordinal":178161,"en":"Do not call its passes an easy road."},{"id":"semetey-1-2013:p1322:b004:l012","ordinal":178162,"en":"Do not regard the unruly Black Chinese"},{"id":"semetey-1-2013:p1322:b004:l013","ordinal":178163,"en":"As worthier than mortals."},{"id":"semetey-1-2013:p1322:b004:l014","ordinal":178164,"en":"It is a perilous road with forty gates;"},{"id":"semetey-1-2013:p1322:b004:l015","ordinal":178165,"en":"Do not bring deep sorrow upon your mother,"},{"id":"semetey-1-2013:p1322:b004:l016","ordinal":178166,"en":"Crying that you will pursue"},{"id":"semetey-1-2013:p1322:b004:l017","ordinal":178167,"en":"The blood-price of your warrior father Manas!"},{"id":"semetey-1-2013:p1322:b004:l018","ordinal":178168,"en":"Great Beijing is six months away;"},{"id":"semetey-1-2013:p1322:b004:l019","ordinal":178169,"en":"Do not call its cliffs an easy road."},{"id":"semetey-1-2013:p1322:b004:l020","ordinal":178170,"en":"Do not call Beijing, land of forty Chinese tribes,"},{"id":"semetey-1-2013:p1322:b004:l021","ordinal":178171,"en":"An easy people upon whom to bring strife."},{"id":"semetey-1-2013:p1322:b004:l022","ordinal":178172,"en":"When I lament, I have many words;"},{"id":"semetey-1-2013:p1322:b004:l023","ordinal":178173,"en":"There is a teeming Chinese people."},{"id":"semetey-1-2013:p1322:b004:l024","ordinal":178174,"en":"Having been utterly parted from the khans,"},{"id":"semetey-1-2013:p1322:b004:l025","ordinal":178175,"en":"I, your ill-fated mother,"},{"id":"semetey-1-2013:p1322:b004:l026","ordinal":178176,"en":"Have cause to remain lamenting."}]
