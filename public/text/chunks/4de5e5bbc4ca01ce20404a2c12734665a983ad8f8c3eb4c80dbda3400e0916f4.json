[{"id":"seytek-2012:p0519:b003:l006","ordinal":334337,"en":"This alone was my desire."},{"id":"seytek-2012:p0519:b003:l007","ordinal":334338,"en":"My prowess is unlike any other,"},{"id":"seytek-2012:p0519:b003:l008","ordinal":334339,"en":"My valor is beyond measure."},{"id":"seytek-2012:p0519:b003:l009","ordinal":334340,"en":"I shall make good the words I spoke;"},{"id":"seytek-2012:p0519:b003:l010","ordinal":334341,"en":"How could I fail to avenge"},{"id":"seytek-2012:p0519:b003:l011","ordinal":334342,"en":"The grievance famed among the people!"},{"id":"seytek-2012:p0519:b003:l012","ordinal":334343,"en":"Ever since I became Sarybai,"},{"id":"seytek-2012:p0519:b003:l013","ordinal":334344,"en":"I have defeated all who confronted me,"},{"id":"seytek-2012:p0519:b003:l014","ordinal":334345,"en":"And swallowed all who charged me."},{"id":"seytek-2012:p0519:b003:l015","ordinal":334346,"en":"I have hewn down everyone I met,"},{"id":"seytek-2012:p0519:b003:l016","ordinal":334347,"en":"And massacred and despoiled"},{"id":"seytek-2012:p0519:b003:l017","ordinal":334348,"en":"Many champions and mighty giants who opposed me!"},{"id":"seytek-2012:p0519:b003:l018","ordinal":334349,"en":"I speak to shatter your courage;"},{"id":"seytek-2012:p0519:b003:l019","ordinal":334350,"en":"I shall slaughter many of you and take revenge!"},{"id":"seytek-2012:p0519:b003:l020","ordinal":334351,"en":"I am the black eye of disaster,"},{"id":"seytek-2012:p0519:b003:l021","ordinal":334352,"en":"Calamity itself."},{"id":"seytek-2012:p0519:b003:l022","ordinal":334353,"en":"No winged creature can escape me;"},{"id":"seytek-2012:p0519:b003:l023","ordinal":334354,"en":"I am an impassable black precipice."},{"id":"seytek-2012:p0519:b003:l024","ordinal":334355,"en":"I am a dense forest of snares,"},{"id":"seytek-2012:p0519:b003:l025","ordinal":334356,"en":"I swallow all who grapple with me."},{"id":"seytek-2012:p0519:b003:l026","ordinal":334357,"en":"I shall strike terror like a dragon,"},{"id":"seytek-2012:p0519:b003:l027","ordinal":334358,"en":"And take my vengeance everywhere!"},{"id":"seytek-2012:p0519:b003:l028","ordinal":334359,"en":"I am the very eye of calamity,"},{"id":"seytek-2012:p0519:b003:l029","ordinal":334360,"en":"The black scourge itself."},{"id":"seytek-2012:p0519:b003:l030","ordinal":334361,"en":"I am a vast black valley"},{"id":"seytek-2012:p0519:b003:l031","ordinal":334362,"en":"That cannot be exhausted even when shoveled away.”"},{"id":"seytek-2012:p0519:b003:l032","ordinal":334363,"en":"So saying, Sarybai,"},{"id":"seytek-2012:p0519:b003:l033","ordinal":334364,"en":"With fiery flame burning from his mouth,"},{"id":"seytek-2012:p0519:b003:l034","ordinal":334365,"en":"Took a mountain-like mace in hand,"},{"id":"seytek-2012:p0519:b003:l035","ordinal":334366,"en":"Struck Zhelmaian on the flank,"},{"id":"seytek-2012:p0519:b003:l036","ordinal":334367,"en":"Broke through the narrows and opened a path,"},{"id":"seytek-2012:p0519:b003:l037","ordinal":334368,"en":"And attacked Külchoro,"},{"id":"seytek-2012:p0519:b003:l038","ordinal":334369,"en":"Standing there in wrath."},{"id":"seytek-2012:p0519:b003:l039","ordinal":334370,"en":"With his battle-ax he struck"},{"id":"seytek-2012:p0519:b003:l040","ordinal":334371,"en":"The shrill-voiced brass spear."},{"id":"seytek-2012:p0520:b002:l001","ordinal":334372,"en":"Marking out the place of death,"},{"id":"seytek-2012:p0520:b002:l002","ordinal":334373,"en":"The wonderfully vigilant hero"},{"id":"seytek-2012:p0520:b002:l003","ordinal":334374,"en":"Külchoro stood waiting,"},{"id":"seytek-2012:p0520:b002:l004","ordinal":334375,"en":"And against the infidel Ogre’s son"},{"id":"seytek-2012:p0520:b002:l005","ordinal":334376,"en":"Thrust his spear upon reaching him."},{"id":"seytek-2012:p0520:b002:l006","ordinal":334377,"en":"As though he had punched a stone,"},{"id":"seytek-2012:p0520:b002:l007","ordinal":334378,"en":"The noble man brought all his strength;"},{"id":"seytek-2012:p0520:b002:l008","ordinal":334379,"en":"Its steel nature became evident:"},{"id":"seytek-2012:p0520:b002:l009","ordinal":334380,"en":"The ornamented spear did not break,"},{"id":"seytek-2012:p0520:b002:l010","ordinal":334381,"en":"But bent like a tent prop."},{"id":"seytek-2012:p0520:b002:l011","ordinal":334382,"en":"The wretched son of Almambet"},{"id":"seytek-2012:p0520:b002:l012","ordinal":334383,"en":"Revealed himself a true hero,"},{"id":"seytek-2012:p0520:b002:l013","ordinal":334384,"en":"Supremely vigilant and blessed with fortune,"},{"id":"seytek-2012:p0520:b002:l014","ordinal":334385,"en":"His courage like a fortress of steel;"},{"id":"seytek-2012:p0520:b002:l015","ordinal":334386,"en":"None who clashed with him could survive."},{"id":"seytek-2012:p0520:b002:l016","ordinal":334387,"en":"The ornamented spear had a steel core;"},{"id":"seytek-2012:p0520:b002:l017","ordinal":334388,"en":"Thus he kept thrusting it."},{"id":"seytek-2012:p0520:b002:l018","ordinal":334389,"en":"If you ask about that ornamented spear,"},{"id":"seytek-2012:p0520:b002:l019","ordinal":334390,"en":"It was designed and tempered for war."},{"id":"seytek-2012:p0520:b002:l020","ordinal":334391,"en":"Bölökbai, planning for battle,"},{"id":"seytek-2012:p0520:b002:l021","ordinal":334392,"en":"Had fashioned it, poor man."},{"id":"seytek-2012:p0520:b002:l022","ordinal":334393,"en":"He hardened and twisted its shaft;"},{"id":"seytek-2012:p0520:b002:l023","ordinal":334394,"en":"The master craftsman Bölökbai"},{"id":"seytek-2012:p0520:b002:l024","ordinal":334395,"en":"Fitted and finished it beautifully."},{"id":"seytek-2012:p0520:b002:l025","ordinal":334396,"en":"He had iron drawn through its core,"},{"id":"seytek-2012:p0520:b002:l026","ordinal":334397,"en":"And firmly increased its measure."},{"id":"seytek-2012:p0520:b002:l027","ordinal":334398,"en":"He edged it like a wolf’s tongue,"},{"id":"seytek-2012:p0520:b002:l028","ordinal":334399,"en":"Lest by some chance in close combat"},{"id":"seytek-2012:p0520:b002:l029","ordinal":334400,"en":"It slip from the hand,"},{"id":"seytek-2012:p0520:b002:l030","ordinal":334401,"en":"And adorned it with lacquer."},{"id":"seytek-2012:p0520:b002:l031","ordinal":334402,"en":"Every bard sang of it,"},{"id":"seytek-2012:p0520:b002:l032","ordinal":334403,"en":"And every discerning man listened."},{"id":"seytek-2012:p0520:b002:l033","ordinal":334404,"en":"If you ask about that ornamented spear,"},{"id":"seytek-2012:p0520:b002:l034","ordinal":334405,"en":"When its charcoal was prepared,"},{"id":"seytek-2012:p0520:b002:l035","ordinal":334406,"en":"A whole forest on the green plain was felled."},{"id":"seytek-2012:p0520:b002:l036","ordinal":334407,"en":"When its forge was fired,"},{"id":"seytek-2012:p0520:b002:l037","ordinal":334408,"en":"A tribute bull of the Kyrgyz,"},{"id":"seytek-2012:p0520:b002:l038","ordinal":334409,"en":"A blue young bull, was slaughtered."},{"id":"seytek-2012:p0520:b002:l039","ordinal":334410,"en":"He tempered its steel core,"},{"id":"seytek-2012:p0520:b002:l040","ordinal":334411,"en":"Fashioning it expressly for battle,"},{"id":"seytek-2012:p0520:b003:l001","ordinal":334412,"en":"And Külchoro drove it with tremendous force."},{"id":"seytek-2012:p0520:b003:l002","ordinal":334413,"en":"Raging and straining,"},{"id":"seytek-2012:p0520:b003:l003","ordinal":334414,"en":"He again took in hand"},{"id":"seytek-2012:p0520:b003:l004","ordinal":334415,"en":"The cast-iron head as large as a house,"},{"id":"seytek-2012:p0520:b003:l005","ordinal":334416,"en":"And struck with that iron head."},{"id":"seytek-2012:p0520:b003:l006","ordinal":334417,"en":"Seizing the ornamented broad-mouthed arrow,"},{"id":"seytek-2012:p0520:b003:l007","ordinal":334418,"en":"Sarybai shot a hundred shafts,"},{"id":"seytek-2012:p0520:b003:l008","ordinal":334419,"en":"Summoning all his courage."},{"id":"seytek-2012:p0520:b003:l009","ordinal":334420,"en":"He made the age itself constrict,"},{"id":"seytek-2012:p0520:b003:l010","ordinal":334421,"en":"As the madman stood thus."},{"id":"seytek-2012:p0520:b003:l011","ordinal":334422,"en":"Whipping the dun kulan-horse,"},{"id":"seytek-2012:p0520:b003:l012","ordinal":334423,"en":"That capable servant, fitted for war,"},{"id":"seytek-2012:p0520:b003:l013","ordinal":334424,"en":"That powerful servant who knew"},{"id":"seytek-2012:p0520:b003:l014","ordinal":334425,"en":"All the stratagems of the foe,"},{"id":"seytek-2012:p0520:b003:l015","ordinal":334426,"en":"Fortunate Külchoro—"},{"id":"seytek-2012:p0520:b003:l016","ordinal":334427,"en":"Was he not the warrior who had struck down"},{"id":"seytek-2012:p0520:b003:l017","ordinal":334428,"en":"Not only Sarybai, but the world?"},{"id":"seytek-2012:p0520:b003:l018","ordinal":334429,"en":"Had he not subdued"},{"id":"seytek-2012:p0520:b003:l019","ordinal":334430,"en":"And conquered the whole world!"},{"id":"seytek-2012:p0520:b003:l020","ordinal":334431,"en":"His eyes saw from afar;"},{"id":"seytek-2012:p0520:b003:l021","ordinal":334432,"en":"He was wiser than multitudes,"},{"id":"seytek-2012:p0520:b003:l022","ordinal":334433,"en":"And stood unmatched in a solitary race."},{"id":"seytek-2012:p0520:b003:l023","ordinal":334434,"en":"A supreme hero, master of the spear,"},{"id":"seytek-2012:p0520:b003:l024","ordinal":334435,"en":"The tiger-warrior and sage"},{"id":"seytek-2012:p0520:b003:l025","ordinal":334436,"en":"Who truly knew the enemy’s stratagems."},{"id":"seytek-2012:p0520:b003:l026","ordinal":334437,"en":"He was a champion apart;"},{"id":"seytek-2012:p0520:b003:l027","ordinal":334438,"en":"Behold, the gray wolf Choro bore"},{"id":"seytek-2012:p0520:b003:l028","ordinal":334439,"en":"The weight of Mount Kap."},{"id":"seytek-2012:p0520:b003:l029","ordinal":334440,"en":"Sarybai faced him"},{"id":"seytek-2012:p0520:b003:l030","ordinal":334441,"en":"And struck with wild abandon."},{"id":"seytek-2012:p0520:b003:l031","ordinal":334442,"en":"When Zhelmaian’s head was turned,"},{"id":"seytek-2012:p0520:b003:l032","ordinal":334443,"en":"And Sarybai swung his mace,"},{"id":"seytek-2012:p0520:b003:l033","ordinal":334444,"en":"Külüstön, upheld by the ancestral spirits,"},{"id":"seytek-2012:p0520:b003:l034","ordinal":334445,"en":"Did not flinch at its ringing blows;"},{"id":"seytek-2012:p0520:b003:l035","ordinal":334446,"en":"He valued Sarybai’s attack"},{"id":"seytek-2012:p0520:b003:l036","ordinal":334447,"en":"No more than the hem of his robe."},{"id":"seytek-2012:p0520:b003:l037","ordinal":334448,"en":"He neither swayed nor stirred;"},{"id":"seytek-2012:p0520:b003:l038","ordinal":334449,"en":"The poor hero upheld by the ancestral spirits"},{"id":"seytek-2012:p0520:b003:l039","ordinal":334450,"en":"Did not move even when his gear was spent."},{"id":"seytek-2012:p0520:b003:l040","ordinal":334451,"en":"He turned his courser’s head,"},{"id":"seytek-2012:p0521:b002:l001","ordinal":334452,"en":"He was a lone-born wolf indeed."},{"id":"seytek-2012:p0521:b002:l002","ordinal":334453,"en":"He was an ocean, a worthy equal,"},{"id":"seytek-2012:p0521:b002:l003","ordinal":334454,"en":"A true gray-wolf hero."},{"id":"seytek-2012:p0521:b002:l004","ordinal":334455,"en":"“Ever since I became Sarybai,"},{"id":"seytek-2012:p0521:b002:l005","ordinal":334456,"en":"Ever since Sarybai mounted a horse,"},{"id":"seytek-2012:p0521:b002:l006","ordinal":334457,"en":"No desert has remained untrodden by me,"},{"id":"seytek-2012:p0521:b002:l007","ordinal":334458,"en":"No people unseen by me."},{"id":"seytek-2012:p0521:b002:l008","ordinal":334459,"en":"I wandered through many lands,"},{"id":"seytek-2012:p0521:b002:l009","ordinal":334460,"en":"Conquering this multitude,"},{"id":"seytek-2012:p0521:b002:l010","ordinal":334461,"en":"Making people scream."},{"id":"seytek-2012:p0521:b002:l011","ordinal":334462,"en":"Those who claimed to be warriors and giants,"},{"id":"seytek-2012:p0521:b002:l012","ordinal":334463,"en":"Who called themselves masters of the earth—"},{"id":"seytek-2012:p0521:b002:l013","ordinal":334464,"en":"I slaughtered many such champions."},{"id":"seytek-2012:p0521:b002:l014","ordinal":334465,"en":"Never among all those have I seen his like;"},{"id":"seytek-2012:p0521:b002:l015","ordinal":334466,"en":"He is truly mighty, truly a hero!”"},{"id":"seytek-2012:p0521:b002:l016","ordinal":334467,"en":"So saying, Sarybai"},{"id":"seytek-2012:p0521:b002:l017","ordinal":334468,"en":"Tested his valor"},{"id":"seytek-2012:p0521:b002:l018","ordinal":334469,"en":"And brought down a mountain’s weight."},{"id":"seytek-2012:p0521:b002:l019","ordinal":334470,"en":"The spear blazed and became an ember;"},{"id":"seytek-2012:p0521:b002:l020","ordinal":334471,"en":"When Külchoro thrust his spear,"},{"id":"seytek-2012:p0521:b002:l021","ordinal":334472,"en":"Sarybai stood fast and endured it."},{"id":"seytek-2012:p0521:b002:l022","ordinal":334473,"en":"Then Külchoro said:"},{"id":"seytek-2012:p0521:b002:l023","ordinal":334474,"en":"“If God delivers the slave to me,”"},{"id":"seytek-2012:p0521:b002:l024","ordinal":334475,"en":"And, holding this thought,"},{"id":"seytek-2012:p0521:b002:l025","ordinal":334476,"en":"Külchoro aimed without withdrawing his spear,"},{"id":"seytek-2012:p0521:b002:l026","ordinal":334477,"en":"And at that infidel Sarybai"},{"id":"seytek-2012:p0521:b002:l027","ordinal":334478,"en":"He thrust sixty times."},{"id":"seytek-2012:p0521:b002:l028","ordinal":334479,"en":"Sarybai rang but paid no heed,"},{"id":"seytek-2012:p0521:b002:l029","ordinal":334480,"en":"Valuing sixty spear thrusts"},{"id":"seytek-2012:p0521:b002:l030","ordinal":334481,"en":"No more than the hem of his robe,"},{"id":"seytek-2012:p0521:b002:l031","ordinal":334482,"en":"Then found a desperate stratagem."},{"id":"seytek-2012:p0521:b002:l032","ordinal":334483,"en":"He struck Külchoro’s spear"},{"id":"seytek-2012:p0521:b002:l033","ordinal":334484,"en":"Across the middle of its shaft."},{"id":"seytek-2012:p0521:b002:l034","ordinal":334485,"en":"The spear broke and was rendered useless;"},{"id":"seytek-2012:p0521:b002:l035","ordinal":334486,"en":"Splintering across the middle,"},{"id":"seytek-2012:p0521:b002:l036","ordinal":334487,"en":"Külchoro’s ornamented spear"},{"id":"seytek-2012:p0521:b002:l037","ordinal":334488,"en":"Whirled shrieking into the sky."},{"id":"seytek-2012:p0521:b002:l038","ordinal":334489,"en":"That gray wolf Külchoro"},{"id":"seytek-2012:p0521:b002:l039","ordinal":334490,"en":"Had his weapon and his beloved;"},{"id":"seytek-2012:p0521:b002:l040","ordinal":334491,"en":"Such strength did the gray wolf possess."},{"id":"seytek-2012:p0521:b003:l001","ordinal":334492,"en":"Its point had been forged in steel"},{"id":"seytek-2012:p0521:b003:l002","ordinal":334493,"en":"That it might pierce wherever it struck,"},{"id":"seytek-2012:p0521:b003:l003","ordinal":334494,"en":"And rip apart wherever it was thrust;"},{"id":"seytek-2012:p0521:b003:l004","ordinal":334495,"en":"Should it chance to hit its mark,"},{"id":"seytek-2012:p0521:b003:l005","ordinal":334496,"en":"It would cut through to the far side."},{"id":"seytek-2012:p0521:b003:l006","ordinal":334497,"en":"Thus had it been fashioned."},{"id":"seytek-2012:p0521:b003:l007","ordinal":334498,"en":"Its point had been forged in steel,"},{"id":"seytek-2012:p0521:b003:l008","ordinal":334499,"en":"And tempered sixty times"},{"id":"seytek-2012:p0521:b003:l009","ordinal":334500,"en":"In a dragon’s venom."},{"id":"seytek-2012:p0521:b003:l010","ordinal":334501,"en":"Death is common to all—this was its fire;"},{"id":"seytek-2012:p0521:b003:l011","ordinal":334502,"en":"Such was the nature of the spear."},{"id":"seytek-2012:p0521:b003:l012","ordinal":334503,"en":"He aimed at the measured spot,"},{"id":"seytek-2012:p0521:b003:l013","ordinal":334504,"en":"And valiant hero Külchoro"},{"id":"seytek-2012:p0521:b003:l014","ordinal":334505,"en":"Thrust and stabbed Sarybai."},{"id":"seytek-2012:p0521:b003:l015","ordinal":334506,"en":"Choro began his furious assault;"},{"id":"seytek-2012:p0521:b003:l016","ordinal":334507,"en":"With both coat fronts flapping,"},{"id":"seytek-2012:p0521:b003:l017","ordinal":334508,"en":"Sarybai nearly tumbled"},{"id":"seytek-2012:p0521:b003:l018","ordinal":334509,"en":"From Zhelmaian."},{"id":"seytek-2012:p0521:b003:l019","ordinal":334510,"en":"Zhelmaian staggered,"},{"id":"seytek-2012:p0521:b003:l020","ordinal":334511,"en":"And Sarybai stood pale,"},{"id":"seytek-2012:p0521:b003:l021","ordinal":334512,"en":"Marvelling at Külchoro:"},{"id":"seytek-2012:p0521:b003:l022","ordinal":334513,"en":"“He is renowned, a mountain indeed,"},{"id":"seytek-2012:p0521:b003:l023","ordinal":334514,"en":"A renowned gray-wolf hero."},{"id":"seytek-2012:p0521:b003:l024","ordinal":334515,"en":"Thick-armed and stone-hearted,"},{"id":"seytek-2012:p0521:b003:l025","ordinal":334516,"en":"A broad fellow with an elephant’s frame."},{"id":"seytek-2012:p0521:b003:l026","ordinal":334517,"en":"Against any rival or enemy"},{"id":"seytek-2012:p0521:b003:l027","ordinal":334518,"en":"He can unleash great havoc."},{"id":"seytek-2012:p0521:b003:l028","ordinal":334519,"en":"He is a warrior and a hero,"},{"id":"seytek-2012:p0521:b003:l029","ordinal":334520,"en":"A singularly born champion."},{"id":"seytek-2012:p0521:b003:l030","ordinal":334521,"en":"His weight is heavy and his venom strong;"},{"id":"seytek-2012:p0521:b003:l031","ordinal":334522,"en":"He surpasses the whole world.”"},{"id":"seytek-2012:p0521:b003:l032","ordinal":334523,"en":"He began a fierce assault,"},{"id":"seytek-2012:p0521:b003:l033","ordinal":334524,"en":"But when Sarybai struck mightily,"},{"id":"seytek-2012:p0521:b003:l034","ordinal":334525,"en":"He nearly fell away."},{"id":"seytek-2012:p0521:b003:l035","ordinal":334526,"en":"“What thick-muscled creature is this?"},{"id":"seytek-2012:p0521:b003:l036","ordinal":334527,"en":"No such man appears in an age."},{"id":"seytek-2012:p0521:b003:l037","ordinal":334528,"en":"I barely stopped myself with a cry;"},{"id":"seytek-2012:p0521:b003:l038","ordinal":334529,"en":"My soul nearly leapt from my breast."},{"id":"seytek-2012:p0521:b003:l039","ordinal":334530,"en":"He is hard as blue iron,"},{"id":"seytek-2012:p0521:b003:l040","ordinal":334531,"en":"One who has destroyed many men,"},{"id":"seytek-2012:p0522:b002:l001","ordinal":334532,"en":"Yet he had no thought of dying."},{"id":"seytek-2012:p0522:b002:l002","ordinal":334533,"en":"The steel shield upon his head"},{"id":"seytek-2012:p0522:b002:l003","ordinal":334534,"en":"Shattered and burst into sparks."},{"id":"seytek-2012:p0522:b002:l004","ordinal":334535,"en":"That infidel son of the Ogre"},{"id":"seytek-2012:p0522:b002:l005","ordinal":334536,"en":"Survived even this and stood fast."},{"id":"seytek-2012:p0522:b002:l006","ordinal":334537,"en":"Sarybai grew fearsome"},{"id":"seytek-2012:p0522:b002:l007","ordinal":334538,"en":"And began his true scourging."},{"id":"seytek-2012:p0522:b002:l008","ordinal":334539,"en":"Overturning mountains and draining lakes,"},{"id":"seytek-2012:p0522:b002:l009","ordinal":334540,"en":"He wrought fierce deeds without pause."},{"id":"seytek-2012:p0522:b002:l010","ordinal":334541,"en":"He consumed all who crossed him;"},{"id":"seytek-2012:p0522:b002:l011","ordinal":334542,"en":"Only the unbroken black earth"},{"id":"seytek-2012:p0522:b002:l012","ordinal":334543,"en":"Halted the mass of his force."},{"id":"seytek-2012:p0522:b002:l013","ordinal":334544,"en":"He leveled every hill,"},{"id":"seytek-2012:p0522:b002:l014","ordinal":334545,"en":"And tore up forests in his might."},{"id":"seytek-2012:p0522:b002:l015","ordinal":334546,"en":"He reduced to dust the very seed"},{"id":"seytek-2012:p0522:b002:l016","ordinal":334547,"en":"Of both the living and the lifeless."},{"id":"seytek-2012:p0522:b002:l017","ordinal":334548,"en":"Furiously making ready,"},{"id":"seytek-2012:p0522:b002:l018","ordinal":334549,"en":"The infidel Sarybai"},{"id":"seytek-2012:p0522:b002:l019","ordinal":334550,"en":"Came charging straight ahead."},{"id":"seytek-2012:p0522:b002:l020","ordinal":334551,"en":"He roared in wrath,"},{"id":"seytek-2012:p0522:b002:l021","ordinal":334552,"en":"Making the whole body"},{"id":"seytek-2012:p0522:b002:l022","ordinal":334553,"en":"Of every onlooker tremble."},{"id":"seytek-2012:p0522:b002:l023","ordinal":334554,"en":"Blazing outright and stirring strife,"},{"id":"seytek-2012:p0522:b002:l024","ordinal":334555,"en":"He bristled in fury"},{"id":"seytek-2012:p0522:b002:l025","ordinal":334556,"en":"And began a savage assault."},{"id":"seytek-2012:p0522:b002:l026","ordinal":334557,"en":"The solid black earth beneath him,"},{"id":"seytek-2012:p0522:b002:l027","ordinal":334558,"en":"Before the scourge of Sarybai’s rage,"},{"id":"seytek-2012:p0522:b002:l028","ordinal":334559,"en":"The infidel’s bitter venom,"},{"id":"seytek-2012:p0522:b002:l029","ordinal":334560,"en":"His crashing fury,"},{"id":"seytek-2012:p0522:b002:l030","ordinal":334561,"en":"And his utterly dreadful aspect,"},{"id":"seytek-2012:p0522:b002:l031","ordinal":334562,"en":"Seemed about to break apart."},{"id":"seytek-2012:p0522:b002:l032","ordinal":334563,"en":"Raging and running mad,"},{"id":"seytek-2012:p0522:b002:l033","ordinal":334564,"en":"He began a savage assault."},{"id":"seytek-2012:p0522:b002:l034","ordinal":334565,"en":"He overturned earth and sky,"},{"id":"seytek-2012:p0522:b002:l035","ordinal":334566,"en":"And swept them away."},{"id":"seytek-2012:p0522:b002:l036","ordinal":334567,"en":"He cursed the beast beneath him;"},{"id":"seytek-2012:p0522:b002:l037","ordinal":334568,"en":"The teeming army on campaign"},{"id":"seytek-2012:p0522:b002:l038","ordinal":334569,"en":"Surged away in panic and stopped,"},{"id":"seytek-2012:p0522:b002:l039","ordinal":334570,"en":"As though ready to flee before him."},{"id":"seytek-2012:p0522:b002:l040","ordinal":334571,"en":"Yet Choro was a champion and a hero,"},{"id":"seytek-2012:p0522:b003:l001","ordinal":334572,"en":"And possessed every weapon."},{"id":"seytek-2012:p0522:b003:l002","ordinal":334573,"en":"The vigilant, noble hero Choro"},{"id":"seytek-2012:p0522:b003:l003","ordinal":334574,"en":"Let the golden-cheeked battle-ax"},{"id":"seytek-2012:p0522:b003:l004","ordinal":334575,"en":"Swing from his wrist,"},{"id":"seytek-2012:p0522:b003:l005","ordinal":334576,"en":"Then gripped it firmly."},{"id":"seytek-2012:p0522:b003:l006","ordinal":334577,"en":"If you ask about the battle-ax,"},{"id":"seytek-2012:p0522:b003:l007","ordinal":334578,"en":"Its broad edge was a handspan wide;"},{"id":"seytek-2012:p0522:b003:l008","ordinal":334579,"en":"Wherever it swung, blood spread."},{"id":"seytek-2012:p0522:b003:l009","ordinal":334580,"en":"Its steel socket was as thick as a fist;"},{"id":"seytek-2012:p0522:b003:l010","ordinal":334581,"en":"Such was the battle-ax."},{"id":"seytek-2012:p0522:b003:l011","ordinal":334582,"en":"Placed upon grass, it set it ablaze;"},{"id":"seytek-2012:p0522:b003:l012","ordinal":334583,"en":"Whatever it struck died at once."},{"id":"seytek-2012:p0522:b003:l013","ordinal":334584,"en":"When swung in battle lust,"},{"id":"seytek-2012:p0522:b003:l014","ordinal":334585,"en":"A head flew broadly away,"},{"id":"seytek-2012:p0522:b003:l015","ordinal":334586,"en":"And blood followed after it."},{"id":"seytek-2012:p0522:b003:l016","ordinal":334587,"en":"When the blood flowed, strength departed,"},{"id":"seytek-2012:p0522:b003:l017","ordinal":334588,"en":"And after the blood, life departed."},{"id":"seytek-2012:p0522:b003:l018","ordinal":334589,"en":"The champion who wielded it rejoiced;"},{"id":"seytek-2012:p0522:b003:l019","ordinal":334590,"en":"It was honed to cleave stone when swung"},{"id":"seytek-2012:p0522:b003:l020","ordinal":334591,"en":"And pass through without glancing aside,"},{"id":"seytek-2012:p0522:b003:l021","ordinal":334592,"en":"So that when brought against an opponent,"}]
