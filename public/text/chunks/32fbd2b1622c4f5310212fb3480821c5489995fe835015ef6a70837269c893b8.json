[{"id":"sayakbay-ms-current144:pdf098:l005","ordinal":393473,"en":"[Raging against the whole world,]"},{"id":"sayakbay-ms-current144:pdf098:l006","ordinal":393474,"en":"[Right there where the waters met,]"},{"id":"sayakbay-ms-current144:pdf098:l007","ordinal":393475,"en":"[Directing the enemy straight upward,]"},{"id":"sayakbay-ms-current144:pdf098:l008","ordinal":393476,"en":"Driving them back and forth,"},{"id":"sayakbay-ms-current144:pdf098:l009","ordinal":393477,"en":"[Making the blood he trampled a grievance,]"},{"id":"sayakbay-ms-current144:pdf098:l010","ordinal":393478,"en":"Sending his champions around,"},{"id":"sayakbay-ms-current144:pdf098:l011","ordinal":393479,"en":"Taking the entire horse herd,"},{"id":"sayakbay-ms-current144:pdf098:l013","ordinal":393480,"en":"He roamed with a rumbling din,"},{"id":"sayakbay-ms-current144:pdf098:l015","ordinal":393481,"en":"Let us leave this here,"},{"id":"sayakbay-ms-current144:pdf098:l017","ordinal":393482,"en":"The equally bold warrior Seytek,"},{"id":"sayakbay-ms-current144:pdf098:l019","ordinal":393483,"en":"[Those who remained pondering,]"},{"id":"sayakbay-ms-current144:pdf098:l020","ordinal":393484,"en":"Hearing news from the herdsman,"},{"id":"sayakbay-ms-current144:pdf098:l021","ordinal":393485,"en":"The meaning of the herdsman's words,"},{"id":"sayakbay-ms-current144:pdf098:l022","ordinal":393486,"en":"[Much weighed upon their thoughts,]"},{"id":"sayakbay-ms-current144:pdf098:l023","ordinal":393487,"en":"Erbay, son of Eshidin,"},{"id":"sayakbay-ms-current144:pdf098:l024","ordinal":393488,"en":"[Escaped when that one died.]"},{"id":"sayakbay-ms-current144:pdf098:l025","ordinal":393489,"en":"Making the seven crossroads resound,"},{"id":"sayakbay-ms-current144:pdf098:l027","ordinal":393490,"en":"Finding a plan, he departed,"},{"id":"sayakbay-ms-current144:pdf098:l028","ordinal":393491,"en":"[Escaping when that one died,]"},{"id":"sayakbay-ms-current144:pdf098:l029","ordinal":393492,"en":"Crying out for Talas,"},{"id":"sayakbay-ms-current144:pdf099:l001","ordinal":393493,"en":"[Saying they had reached the very roots together,]"},{"id":"sayakbay-ms-current144:pdf099:l002","ordinal":393494,"en":"Your entire horse herd,"},{"id":"sayakbay-ms-current144:pdf099:l003","ordinal":393495,"en":"Utterly disturbing your sleep,"},{"id":"sayakbay-ms-current144:pdf099:l006","ordinal":393496,"en":"[The swine driving off your horses,]"},{"id":"sayakbay-ms-current144:pdf099:l007","ordinal":393497,"en":"Destroying your property behind you,"},{"id":"sayakbay-ms-current144:pdf099:l008","ordinal":393498,"en":"[Bringing ruin upon your nephew,]"},{"id":"sayakbay-ms-current144:pdf099:l010","ordinal":393499,"en":"[It was the moment of the raid,]"},{"id":"sayakbay-ms-current144:pdf099:l013","ordinal":393500,"en":"Of the Black Chinese and Manchu,"},{"id":"sayakbay-ms-current144:pdf099:l014","ordinal":393501,"en":"[The devastating might of that infidel,]"},{"id":"sayakbay-ms-current144:pdf099:l016","ordinal":393502,"en":"[His dark watching eyes,]"},{"id":"sayakbay-ms-current144:pdf099:l018","ordinal":393503,"en":"Coming and going, scouting the land,"},{"id":"sayakbay-ms-current144:pdf099:l019","ordinal":393504,"en":"He had now arrived,"},{"id":"sayakbay-ms-current144:pdf099:l020","ordinal":393505,"en":"He had a magnificent steed,"},{"id":"sayakbay-ms-current144:pdf099:l022","ordinal":393506,"en":"He alone had the strength of a thousand."},{"id":"sayakbay-ms-current144:pdf099:l024","ordinal":393507,"en":"[That restless infidel's,]"},{"id":"sayakbay-ms-current144:pdf099:l026","ordinal":393508,"en":"Would the enemy refrain from advancing?"},{"id":"sayakbay-ms-current144:pdf099:l029","ordinal":393509,"en":"[He had a hulking, reckless appearance,]"},{"id":"sayakbay-ms-current144:pdf100:l001","ordinal":393510,"en":"[I could not discern his true nature,]"},{"id":"sayakbay-ms-current144:pdf100:l028","ordinal":393511,"en":"Tying its flowing tail tightly,"},{"id":"sayakbay-ms-current144:pdf100:l029","ordinal":393512,"en":"His valor plain to see,"},{"id":"sayakbay-ms-current144:pdf101:l002","ordinal":393513,"en":"[He rejoiced intensely,]"},{"id":"sayakbay-ms-current144:pdf101:l003","ordinal":393514,"en":"Putting on his battle dress,"},{"id":"sayakbay-ms-current144:pdf101:l004","ordinal":393515,"en":"[The noble warrior who faced the foe,]"},{"id":"sayakbay-ms-current144:pdf101:l005","ordinal":393516,"en":"Rejoicing at the mention of death,"},{"id":"sayakbay-ms-current144:pdf101:l006","ordinal":393517,"en":"[From the broad plain where no loud sound reached,]"},{"id":"sayakbay-ms-current144:pdf101:l007","ordinal":393518,"en":"From the wide ravine where no bird flew,"},{"id":"sayakbay-ms-current144:pdf101:l008","ordinal":393519,"en":"[The hero, drawing the brass shaft from the ridge,]"},{"id":"sayakbay-ms-current144:pdf101:l011","ordinal":393520,"en":"Our elder set out on the road,"},{"id":"sayakbay-ms-current144:pdf101:l012","ordinal":393521,"en":"Choking with wrath,"},{"id":"sayakbay-ms-current144:pdf101:l013","ordinal":393522,"en":"Fashioned from blue iron,"},{"id":"sayakbay-ms-current144:pdf101:l014","ordinal":393523,"en":"[With its firmly secured crest,]"},{"id":"sayakbay-ms-current144:pdf101:l015","ordinal":393524,"en":"[Its cheekpiece fitted and ready,]"},{"id":"sayakbay-ms-current144:pdf101:l017","ordinal":393525,"en":"Everything fitted and tied,"},{"id":"sayakbay-ms-current144:pdf101:l018","ordinal":393526,"en":"[Securing its corners tightly,]"},{"id":"sayakbay-ms-current144:pdf101:l019","ordinal":393527,"en":"[Tucked beneath his throat.]"},{"id":"sayakbay-ms-current144:pdf101:l020","ordinal":393528,"en":"Your elder Joltoy, stirred to fury,"},{"id":"sayakbay-ms-current144:pdf101:l021","ordinal":393529,"en":"Dressed in arrow-proof armor,"},{"id":"sayakbay-ms-current144:pdf101:l022","ordinal":393530,"en":"Making Kulansur prance,"},{"id":"sayakbay-ms-current144:pdf101:l024","ordinal":393531,"en":"[Thundering without looking aside,]"},{"id":"sayakbay-ms-current144:pdf101:l026","ordinal":393532,"en":"Rumbled without pause,"},{"id":"sayakbay-ms-current144:pdf101:l027","ordinal":393533,"en":"Like the rush of a surging river,"},{"id":"sayakbay-ms-current144:pdf101:l028","ordinal":393534,"en":"[Such was his strength,]"},{"id":"sayakbay-ms-current144:pdf102:l001","ordinal":393535,"en":"Akjoltoy, son of Kutubiy,"},{"id":"sayakbay-ms-current144:pdf102:l002","ordinal":393536,"en":"[He was Seytek's inheritance,]"},{"id":"sayakbay-ms-current144:pdf102:l003","ordinal":393537,"en":"[The falcon he himself roused,]"},{"id":"sayakbay-ms-current144:pdf102:l004","ordinal":393538,"en":"If hardship befell their dear heads,"},{"id":"sayakbay-ms-current144:pdf102:l006","ordinal":393539,"en":"[He would stand beneath their banner.]"},{"id":"sayakbay-ms-current144:pdf102:l007","ordinal":393540,"en":"Akjoltoy raised his battle cry,"},{"id":"sayakbay-ms-current144:pdf102:l008","ordinal":393541,"en":"Appearing in wondrous forms,"},{"id":"sayakbay-ms-current144:pdf102:l009","ordinal":393542,"en":"He alone was worth countless troops,"},{"id":"sayakbay-ms-current144:pdf102:l011","ordinal":393543,"en":"[His bearing majestic and weighty,]"},{"id":"sayakbay-ms-current144:pdf102:l013","ordinal":393544,"en":"Tall as a tower,"},{"id":"sayakbay-ms-current144:pdf102:l016","ordinal":393545,"en":"No enemy had broken his wrath,"},{"id":"sayakbay-ms-current144:pdf102:l017","ordinal":393546,"en":"[Talas, held among his people,]"},{"id":"sayakbay-ms-current144:pdf102:l018","ordinal":393547,"en":"No one had overrun it,"},{"id":"sayakbay-ms-current144:pdf102:l019","ordinal":393548,"en":"No one had seized and ruled it,"},{"id":"sayakbay-ms-current144:pdf102:l020","ordinal":393549,"en":"No mortal had called it a calamity,"},{"id":"sayakbay-ms-current144:pdf102:l021","ordinal":393550,"en":"Since he began ruling Talas,"},{"id":"sayakbay-ms-current144:pdf102:l022","ordinal":393551,"en":"[No grievous enemy, piercing like water,]"},{"id":"sayakbay-ms-current144:pdf102:l027","ordinal":393552,"en":"To break and cut through his assault,"},{"id":"sayakbay-ms-current144:pdf102:l029","ordinal":393553,"en":"Traveling by night rather than day,"},{"id":"sayakbay-ms-current144:pdf102:l031","ordinal":393554,"en":"His prowess and bravery,"},{"id":"sayakbay-ms-current144:pdf103:l003","ordinal":393555,"en":"[Crying his battle cry like a mighty one,]"},{"id":"sayakbay-ms-current144:pdf103:l004","ordinal":393556,"en":"Gathering force in fury,"},{"id":"sayakbay-ms-current144:pdf103:l005","ordinal":393557,"en":"The horse flew like a whirlwind,"},{"id":"sayakbay-ms-current144:pdf103:l007","ordinal":393558,"en":"Ever since I became Akjoltoy,"},{"id":"sayakbay-ms-current144:pdf103:l008","ordinal":393559,"en":"Ever since I bore the name Akjoltoy,"},{"id":"sayakbay-ms-current144:pdf103:l011","ordinal":393560,"en":"I left you idle and fed you grain,"},{"id":"sayakbay-ms-current144:pdf103:l012","ordinal":393561,"en":"So I might ride you on campaign,"},{"id":"sayakbay-ms-current144:pdf103:l013","ordinal":393562,"en":"You came to me from the unseen realm,"},{"id":"sayakbay-ms-current144:pdf103:l015","ordinal":393563,"en":"Traveling hard upon the road,"},{"id":"sayakbay-ms-current144:pdf103:l016","ordinal":393564,"en":"[You had not known sweat-soaked saddle straps,]"},{"id":"sayakbay-ms-current144:pdf103:l017","ordinal":393565,"en":"O dear creature, Kulansur,"},{"id":"sayakbay-ms-current144:pdf103:l018","ordinal":393566,"en":"Your companion who shares your mortal fate,"},{"id":"sayakbay-ms-current144:pdf103:l019","ordinal":393567,"en":"You lower your head to the earth,"},{"id":"sayakbay-ms-current144:pdf103:l020","ordinal":393568,"en":"[You lengthen your stride to your strength,]"},{"id":"sayakbay-ms-current144:pdf103:l021","ordinal":393569,"en":"The people behind us are our support,"},{"id":"sayakbay-ms-current144:pdf103:l023","ordinal":393570,"en":"[A warrior's nature is different,]"},{"id":"sayakbay-ms-current144:pdf103:l024","ordinal":393571,"en":"Now let us descend onto the plain,"},{"id":"sayakbay-ms-current144:pdf103:l026","ordinal":393572,"en":"Raising dust along the people's frontier,"},{"id":"sayakbay-ms-current144:pdf103:l027","ordinal":393573,"en":"Come forth for my people, Kulansur,"},{"id":"sayakbay-ms-current144:pdf103:l028","ordinal":393574,"en":"[As a true animal companion,]"},{"id":"sayakbay-ms-current144:pdf103:l029","ordinal":393575,"en":"[Come forth to your reward, Kulansur.]"},{"id":"sayakbay-ms-current144:pdf103:l030","ordinal":393576,"en":"So saying, Akjoltoy,"},{"id":"sayakbay-ms-current144:pdf104:l001","ordinal":393577,"en":"[Eagerly holding his mortal life,]"},{"id":"sayakbay-ms-current144:pdf104:l002","ordinal":393578,"en":"For honor, for dignity,"},{"id":"sayakbay-ms-current144:pdf104:l003","ordinal":393579,"en":"[He bound it to his resolve.]"},{"id":"sayakbay-ms-current144:pdf104:l008","ordinal":393580,"en":"To stand exchanging blows,"},{"id":"sayakbay-ms-current144:pdf104:l009","ordinal":393581,"en":"[His resolve became steely,]"},{"id":"sayakbay-ms-current144:pdf104:l010","ordinal":393582,"en":"[Against the fully mighty infidel,]"},{"id":"sayakbay-ms-current144:pdf104:l013","ordinal":393583,"en":"To unleash his fierce wrath,"},{"id":"sayakbay-ms-current144:pdf104:l015","ordinal":393584,"en":"To wrest them back,"},{"id":"sayakbay-ms-current144:pdf104:l016","ordinal":393585,"en":"If Akjoltoy could not take them,"},{"id":"sayakbay-ms-current144:pdf104:l017","ordinal":393586,"en":"[He saw a path from which he would not return.]"},{"id":"sayakbay-ms-current144:pdf104:l019","ordinal":393587,"en":"He was ready to give his life."},{"id":"sayakbay-ms-current144:pdf104:l020","ordinal":393588,"en":"[Attacking without counting the odds,]"},{"id":"sayakbay-ms-current144:pdf104:l021","ordinal":393589,"en":"Testing their strength against each other."},{"id":"sayakbay-ms-current144:pdf104:l025","ordinal":393590,"en":"Straining without pause,"},{"id":"sayakbay-ms-current144:pdf104:l027","ordinal":393591,"en":"Urging Kulansur with angry words,"},{"id":"sayakbay-ms-current144:pdf104:l028","ordinal":393592,"en":"[The dark-lashed, loop-handled whip,]"},{"id":"sayakbay-ms-current144:pdf104:l029","ordinal":393593,"en":"[Setting that whip to work,]"},{"id":"sayakbay-ms-current144:pdf104:l030","ordinal":393594,"en":"[His palm … turning,]"},{"id":"sayakbay-ms-current144:pdf105:l001","ordinal":393595,"en":"[Its wrist loop a single sleeve,]"},{"id":"sayakbay-ms-current144:pdf105:l002","ordinal":393596,"en":"[The hide that could turn a head aside,]"},{"id":"sayakbay-ms-current144:pdf105:l003","ordinal":393597,"en":"[Threaded through its core,]"},{"id":"sayakbay-ms-current144:pdf105:l004","ordinal":393598,"en":"The skin of a yellow-spotted wether goat,"},{"id":"sayakbay-ms-current144:pdf105:l005","ordinal":393599,"en":"Packed tightly and braided."},{"id":"sayakbay-ms-current144:pdf105:l007","ordinal":393600,"en":"Its braiding packed and fashioned,"},{"id":"sayakbay-ms-current144:pdf105:l009","ordinal":393601,"en":"The dark-lashed, loop-handled whip,"},{"id":"sayakbay-ms-current144:pdf105:l010","ordinal":393602,"en":"When it struck, ears were deafened,"},{"id":"sayakbay-ms-current144:pdf105:l011","ordinal":393603,"en":"Gripping it firmly, bracing himself,"},{"id":"sayakbay-ms-current144:pdf105:l012","ordinal":393604,"en":"The whip struck Kulansur,"},{"id":"sayakbay-ms-current144:pdf105:l013","ordinal":393605,"en":"He drew his knees tight against it."},{"id":"sayakbay-ms-current144:pdf105:l015","ordinal":393606,"en":"After the sharp whip struck,"},{"id":"sayakbay-ms-current144:pdf105:l016","ordinal":393607,"en":"[Its flesh parting like mutton,]"},{"id":"sayakbay-ms-current144:pdf105:l017","ordinal":393608,"en":"[Its spirit and back straightening,]"},{"id":"sayakbay-ms-current144:pdf105:l018","ordinal":393609,"en":"Its mouth opened with a roar,"},{"id":"sayakbay-ms-current144:pdf105:l020","ordinal":393610,"en":"[Scattering like mountain-sized houses.]"},{"id":"sayakbay-ms-current144:pdf105:l023","ordinal":393611,"en":"Rattling behind it,"},{"id":"sayakbay-ms-current144:pdf105:l025","ordinal":393612,"en":"[It drew near to hem him in.]"},{"id":"sayakbay-ms-current144:pdf105:l026","ordinal":393613,"en":"Why would Ichig hold back?"},{"id":"sayakbay-ms-current144:pdf105:l027","ordinal":393614,"en":"Towering Ala-Too,"},{"id":"sayakbay-ms-current144:pdf105:l028","ordinal":393615,"en":"[Leaning against its foothills,]"},{"id":"sayakbay-ms-current144:pdf105:l029","ordinal":393616,"en":"He was about to reach Ichig,"},{"id":"sayakbay-ms-current144:pdf105:l030","ordinal":393617,"en":"Before the blood-drinker's eyes,"},{"id":"sayakbay-ms-current144:pdf106:l001","ordinal":393618,"en":"Before the raider himself,"},{"id":"sayakbay-ms-current144:pdf106:l002","ordinal":393619,"en":"Before the scorpion who ravaged the people,"},{"id":"sayakbay-ms-current144:pdf106:l003","ordinal":393620,"en":"Traveling all the way from Beijing,"},{"id":"sayakbay-ms-current144:pdf106:l004","ordinal":393621,"en":"Before the scorpion who raided horses,"},{"id":"sayakbay-ms-current144:pdf106:l005","ordinal":393622,"en":"Before that fire-cursed wretch himself,"},{"id":"sayakbay-ms-current144:pdf106:l006","ordinal":393623,"en":"Before the raging one's eyes,"},{"id":"sayakbay-ms-current144:pdf106:l007","ordinal":393624,"en":"Dust rose above their heads,"},{"id":"sayakbay-ms-current144:pdf106:l008","ordinal":393625,"en":"The horses appeared dimly through it,"},{"id":"sayakbay-ms-current144:pdf106:l009","ordinal":393626,"en":"That sage was a mighty warrior,"},{"id":"sayakbay-ms-current144:pdf106:l010","ordinal":393627,"en":"Of the horses raided from strangers,"},{"id":"sayakbay-ms-current144:pdf106:l011","ordinal":393628,"en":"He had disturbed their sleep,"},{"id":"sayakbay-ms-current144:pdf106:l012","ordinal":393629,"en":"[The creatures reared by others,]"},{"id":"sayakbay-ms-current144:pdf106:l013","ordinal":393630,"en":"[They were now the Beijing man's livestock,]"},{"id":"sayakbay-ms-current144:pdf106:l014","ordinal":393631,"en":"The black mare leading the herd,"},{"id":"sayakbay-ms-current144:pdf106:l015","ordinal":393632,"en":"Leaving none of the scrawny ones,"},{"id":"sayakbay-ms-current144:pdf106:l016","ordinal":393633,"en":"He had slaughtered them all."},{"id":"sayakbay-ms-current144:pdf106:l017","ordinal":393634,"en":"He let out a loud battle cry,"},{"id":"sayakbay-ms-current144:pdf106:l018","ordinal":393635,"en":"[Like a strip upon a tethering frame,]"},{"id":"sayakbay-ms-current144:pdf106:l019","ordinal":393636,"en":"He swept through and slaughtered them,"},{"id":"sayakbay-ms-current144:pdf106:l020","ordinal":393637,"en":"Making the mares whinny,"},{"id":"sayakbay-ms-current144:pdf106:l021","ordinal":393638,"en":"The gap-toothed one drove them away."},{"id":"sayakbay-ms-current144:pdf106:l022","ordinal":393639,"en":"[The wretched herd had not rested,]"},{"id":"sayakbay-ms-current144:pdf106:l024","ordinal":393640,"en":"All the fat ones, rich with flesh,"},{"id":"sayakbay-ms-current144:pdf106:l025","ordinal":393641,"en":"He drove away without exception."},{"id":"sayakbay-ms-current144:pdf106:l026","ordinal":393642,"en":"He killed the herdsman,"},{"id":"sayakbay-ms-current144:pdf106:l027","ordinal":393643,"en":"Leaving not a trace of that herd,"},{"id":"sayakbay-ms-current144:pdf106:l028","ordinal":393644,"en":"He drove it away in its entirety."},{"id":"sayakbay-ms-current144:pdf106:l029","ordinal":393645,"en":"The day was clear, the night overcast,"},{"id":"sayakbay-ms-current144:pdf106:l030","ordinal":393646,"en":"That dog-sick madman,"},{"id":"sayakbay-ms-current144:pdf107:l001","ordinal":393647,"en":"He had plunged them into hardship,"},{"id":"sayakbay-ms-current144:pdf107:l002","ordinal":393648,"en":"Suddenly fog closed in,"},{"id":"sayakbay-ms-current144:pdf107:l003","ordinal":393649,"en":"The lofty peaks of Ala-Too,"},{"id":"sayakbay-ms-current144:pdf107:l004","ordinal":393650,"en":"[Four layers covered the foothills,]"},{"id":"sayakbay-ms-current144:pdf107:l005","ordinal":393651,"en":"Clouds divided along the ravines,"},{"id":"sayakbay-ms-current144:pdf107:l006","ordinal":393652,"en":"Blue-white hail poured from the sky,"},{"id":"sayakbay-ms-current144:pdf107:l007","ordinal":393653,"en":"The ravine's icy wind,"},{"id":"sayakbay-ms-current144:pdf107:l008","ordinal":393654,"en":"Rose from its very depths,"},{"id":"sayakbay-ms-current144:pdf107:l009","ordinal":393655,"en":"That devastating Kalmyk swine,"},{"id":"sayakbay-ms-current144:pdf107:l010","ordinal":393656,"en":"Showed his weather-working powers."},{"id":"sayakbay-ms-current144:pdf107:l011","ordinal":393657,"en":"Black stones, sheep-sized and house-sized,"},{"id":"sayakbay-ms-current144:pdf107:l012","ordinal":393658,"en":"He sent crashing like a flood,"},{"id":"sayakbay-ms-current144:pdf107:l013","ordinal":393659,"en":"He had blocked the road."},{"id":"sayakbay-ms-current144:pdf107:l014","ordinal":393660,"en":"The day clouded over, obscured,"},{"id":"sayakbay-ms-current144:pdf107:l015","ordinal":393661,"en":"[Ravines and pits split open,]"},{"id":"sayakbay-ms-current144:pdf107:l016","ordinal":393662,"en":"Breaking apart, allowing no passage,"},{"id":"sayakbay-ms-current144:pdf107:l017","ordinal":393663,"en":"Sleet lashed against the face,"},{"id":"sayakbay-ms-current144:pdf107:l018","ordinal":393664,"en":"If you looked at the foothills,"},{"id":"sayakbay-ms-current144:pdf107:l019","ordinal":393665,"en":"Ground fog crept along,"},{"id":"sayakbay-ms-current144:pdf107:l020","ordinal":393666,"en":"He drove horses through clear ground ahead,"},{"id":"sayakbay-ms-current144:pdf107:l021","ordinal":393667,"en":"While night fell behind him,"},{"id":"sayakbay-ms-current144:pdf107:l022","ordinal":393668,"en":"Working wondrous illusions,"},{"id":"sayakbay-ms-current144:pdf107:l023","ordinal":393669,"en":"He was an extraordinary weather sorcerer,"},{"id":"sayakbay-ms-current144:pdf107:l024","ordinal":393670,"en":"[Mounted or afoot, Küchük …,]"},{"id":"sayakbay-ms-current144:pdf107:l025","ordinal":393671,"en":"He was a son born a marksman."},{"id":"sayakbay-ms-current144:pdf107:l026","ordinal":393672,"en":"He was Kakan's fortress,"},{"id":"sayakbay-ms-current144:pdf107:l027","ordinal":393673,"en":"His warrior father was Kojojash,"},{"id":"sayakbay-ms-current144:pdf107:l028","ordinal":393674,"en":"[A life sprung from his ribs,]"},{"id":"sayakbay-ms-current144:pdf107:l029","ordinal":393675,"en":"He was a warrior descended from Kojojash."},{"id":"sayakbay-ms-current144:pdf107:l030","ordinal":393676,"en":"Bracing and straining himself,"},{"id":"sayakbay-ms-current144:pdf107:l031","ordinal":393677,"en":"Of that ill-fated infidel,"},{"id":"sayakbay-ms-current144:pdf108:l001","ordinal":393678,"en":"The time had come to shed blood."},{"id":"sayakbay-ms-current144:pdf108:l003","ordinal":393679,"en":"Kulansur beneath him,"},{"id":"sayakbay-ms-current144:pdf108:l005","ordinal":393680,"en":"Spurring right and left,"},{"id":"sayakbay-ms-current144:pdf108:l006","ordinal":393681,"en":"Akjoltoy was no ordinary warrior."},{"id":"sayakbay-ms-current144:pdf108:l007","ordinal":393682,"en":"The spells Akjoltoy recited,"},{"id":"sayakbay-ms-current144:pdf108:l008","ordinal":393683,"en":"Were no less than the great sage's."},{"id":"sayakbay-ms-current144:pdf108:l009","ordinal":393684,"en":"Rich in wisdom, clear in memory,"},{"id":"sayakbay-ms-current144:pdf108:l010","ordinal":393685,"en":"A champion and a mighty hero,"},{"id":"sayakbay-ms-current144:pdf108:l011","ordinal":393686,"en":"His cunning surpassed the other's,"},{"id":"sayakbay-ms-current144:pdf108:l012","ordinal":393687,"en":"His spear was like a pine tree,"},{"id":"sayakbay-ms-current144:pdf108:l013","ordinal":393688,"en":"When he roamed the world,"},{"id":"sayakbay-ms-current144:pdf108:l014","ordinal":393689,"en":"When bringing justice to his people,"},{"id":"sayakbay-ms-current144:pdf108:l015","ordinal":393690,"en":"He had faced armies in many lands,"},{"id":"sayakbay-ms-current144:pdf108:l016","ordinal":393691,"en":"He had seen many champions and peoples,"},{"id":"sayakbay-ms-current144:pdf108:l017","ordinal":393692,"en":"[Traveling among peoples, pressing them hard,]"},{"id":"sayakbay-ms-current144:pdf108:l018","ordinal":393693,"en":"[Ranging across the lands and peoples.]"},{"id":"sayakbay-ms-current144:pdf108:l019","ordinal":393694,"en":"Swooping like a hawk,"},{"id":"sayakbay-ms-current144:pdf108:l020","ordinal":393695,"en":"[Reared to match many thousands,]"},{"id":"sayakbay-ms-current144:pdf108:l021","ordinal":393696,"en":"Charging against many armies,"},{"id":"sayakbay-ms-current144:pdf108:l022","ordinal":393697,"en":"[Sweeping across the ground he trod,]"},{"id":"sayakbay-ms-current144:pdf108:l023","ordinal":393698,"en":"[Champning his bronze bit,]"},{"id":"sayakbay-ms-current144:pdf108:l024","ordinal":393699,"en":"See the mighty steed, behold it,"},{"id":"sayakbay-ms-current144:pdf108:l025","ordinal":393700,"en":"See the warrior, behold the lion,"},{"id":"sayakbay-ms-current144:pdf108:l026","ordinal":393701,"en":"Catching up with the raider,"},{"id":"sayakbay-ms-current144:pdf108:l027","ordinal":393702,"en":"See the warrior ready to taunt him."},{"id":"sayakbay-ms-current144:pdf108:l028","ordinal":393703,"en":"God forbid you face him,"},{"id":"sayakbay-ms-current144:pdf108:l029","ordinal":393704,"en":"[Ninety sages against this one man,]"},{"id":"sayakbay-ms-current144:pdf108:l030","ordinal":393705,"en":"[He had strength nearly matching a thousand.]"},{"id":"sayakbay-ms-current144:pdf109:l001","ordinal":393706,"en":"Supporting him from many sides,"},{"id":"sayakbay-ms-current144:pdf109:l002","ordinal":393707,"en":"He also had the forty chiltens."},{"id":"sayakbay-ms-current144:pdf109:l003","ordinal":393708,"en":"A fierce battle cry, a mighty shout,"},{"id":"sayakbay-ms-current144:pdf109:l004","ordinal":393709,"en":"[Akjoltoy roared, his blood surging.]"},{"id":"sayakbay-ms-current144:pdf109:l005","ordinal":393710,"en":"A warrior flourishing since childhood,"},{"id":"sayakbay-ms-current144:pdf109:l006","ordinal":393711,"en":"Through shooting, fighting, and spear combat,"},{"id":"sayakbay-ms-current144:pdf109:l007","ordinal":393712,"en":"Dangers of many kinds,"},{"id":"sayakbay-ms-current144:pdf109:l008","ordinal":393713,"en":"He had known since his youth,"},{"id":"sayakbay-ms-current144:pdf109:l009","ordinal":393714,"en":"The elder among brave men,"},{"id":"sayakbay-ms-current144:pdf109:l010","ordinal":393715,"en":"The forefather of young warriors,"},{"id":"sayakbay-ms-current144:pdf109:l011","ordinal":393716,"en":"Of Joltoy beyond measure,"},{"id":"sayakbay-ms-current144:pdf109:l012","ordinal":393717,"en":"His stature like a plane tree,"},{"id":"sayakbay-ms-current144:pdf109:l013","ordinal":393718,"en":"[His prowess like a falcon's,]"},{"id":"sayakbay-ms-current144:pdf109:l014","ordinal":393719,"en":"[His inner spirit like a lion,]"},{"id":"sayakbay-ms-current144:pdf109:l015","ordinal":393720,"en":"[Not merely the great sage, Kök-Kashka,]"},{"id":"sayakbay-ms-current144:pdf109:l016","ordinal":393721,"en":"When he attacked the people of Beijing,"},{"id":"sayakbay-ms-current144:pdf109:l017","ordinal":393722,"en":"Bull-necked, camel-thighed,"},{"id":"sayakbay-ms-current144:pdf109:l018","ordinal":393723,"en":"Crushing whoever grappled with him,"},{"id":"sayakbay-ms-current144:pdf109:l019","ordinal":393724,"en":"Broad-legged, wide-chested,"},{"id":"sayakbay-ms-current144:pdf109:l020","ordinal":393725,"en":"Taking aim, biting his lip,"},{"id":"sayakbay-ms-current144:pdf109:l021","ordinal":393726,"en":"His two eyes red as embers,"},{"id":"sayakbay-ms-current144:pdf109:l022","ordinal":393727,"en":"Fire burning in the darkness,"},{"id":"sayakbay-ms-current144:pdf109:l023","ordinal":393728,"en":"The warrior's brow shone,"}]
