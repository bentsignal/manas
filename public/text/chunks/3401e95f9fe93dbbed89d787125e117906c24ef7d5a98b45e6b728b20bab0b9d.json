[{"id":"manas-2010:p0331:b001:l036","ordinal":15105,"en":"He will not let the plow turn."},{"id":"manas-2010:p0331:b001:l037","ordinal":15106,"en":"If that Burut makes trouble,"},{"id":"manas-2010:p0331:b001:l038","ordinal":15107,"en":"He will not let us remain in this Beijing."},{"id":"manas-2010:p0331:b001:l039","ordinal":15108,"en":"That bastard blood-spiller,"},{"id":"manas-2010:p0331:b001:l040","ordinal":15109,"en":"That deceitful one who ruins the world,"},{"id":"manas-2010:p0331:b001:l041","ordinal":15110,"en":"This Beijing the four companions never trod,"},{"id":"manas-2010:p0331:b001:l042","ordinal":15111,"en":"He is the soul who will enter proudly."},{"id":"manas-2010:p0331:b001:l043","ordinal":15112,"en":"This Beijing Sulayman never touched,"},{"id":"manas-2010:p0331:b001:l044","ordinal":15113,"en":"He is the slave who will call it to account."},{"id":"manas-2010:p0331:b001:l045","ordinal":15114,"en":"Manas is no ordinary son."},{"id":"manas-2010:p0331:b001:l046","ordinal":15115,"en":"If he clashes with Kakan,"},{"id":"manas-2010:p0331:b001:l047","ordinal":15116,"en":"He is not one who will fail to crush it!"},{"id":"manas-2010:p0331:b001:l048","ordinal":15117,"en":"Magicians, when I sent you,"},{"id":"manas-2010:p0332:b001:l001","ordinal":15118,"en":"You proved a wretched lot!"},{"id":"manas-2010:p0332:b001:l002","ordinal":15119,"en":"Your eyes blinded, failing to see,"},{"id":"manas-2010:p0332:b001:l003","ordinal":15120,"en":"Your fathers' graves, Manchus,"},{"id":"manas-2010:p0332:b001:l004","ordinal":15121,"en":"You had become blind!"},{"id":"manas-2010:p0332:b001:l005","ordinal":15122,"en":"Across Altay, Manchus,"},{"id":"manas-2010:p0332:b001:l006","ordinal":15123,"en":"You had failed to travel."},{"id":"manas-2010:p0332:b001:l007","ordinal":15124,"en":"The child in your hands,"},{"id":"manas-2010:p0332:b001:l008","ordinal":15125,"en":"You had failed to recognize him!”"},{"id":"manas-2010:p0332:b001:l009","ordinal":15126,"en":"Thundering in wrath,"},{"id":"manas-2010:p0332:b001:l010","ordinal":15127,"en":"He began a fierce onslaught."},{"id":"manas-2010:p0332:b001:l011","ordinal":15128,"en":"The sixty or so magicians who went to judge,"},{"id":"manas-2010:p0332:b001:l012","ordinal":15129,"en":"Without leaving one alive,"},{"id":"manas-2010:p0332:b001:l013","ordinal":15130,"en":"He slaughtered them all."},{"id":"manas-2010:p0332:b001:l014","ordinal":15131,"en":"Hearing news from his governor,"},{"id":"manas-2010:p0332:b001:l015","ordinal":15132,"en":"Hearing, “Khan Manas has arisen,”"},{"id":"manas-2010:p0332:b001:l016","ordinal":15133,"en":"He began issuing stern commands."},{"id":"manas-2010:p0332:b001:l017","ordinal":15134,"en":"He threw on blue armor."},{"id":"manas-2010:p0332:b001:l018","ordinal":15135,"en":"If you saw Esenkan,"},{"id":"manas-2010:p0332:b001:l019","ordinal":15136,"en":"He raged like a blue tiger."},{"id":"manas-2010:p0332:b001:l020","ordinal":15137,"en":"He began a fierce onslaught."},{"id":"manas-2010:p0332:b001:l021","ordinal":15138,"en":"The many Torgut and Manchus,"},{"id":"manas-2010:p0332:b001:l022","ordinal":15139,"en":"He slaughtered them."},{"id":"manas-2010:p0332:b001:l023","ordinal":15140,"en":"The signal bell was rung,"},{"id":"manas-2010:p0332:b001:l024","ordinal":15141,"en":"The army lost its senses."},{"id":"manas-2010:p0332:b001:l025","ordinal":15142,"en":"When their khan gave his decree,"},{"id":"manas-2010:p0332:b001:l026","ordinal":15143,"en":"Could the people fail to assemble?"},{"id":"manas-2010:p0332:b001:l027","ordinal":15144,"en":"When Esenkan poured out his wrath,"},{"id":"manas-2010:p0332:b001:l028","ordinal":15145,"en":"The Chinese as numerous as ants,"},{"id":"manas-2010:p0332:b001:l029","ordinal":15146,"en":"Could they stand watching without assembling?"},{"id":"manas-2010:p0332:b001:l030","ordinal":15147,"en":"Esenkan on his golden throne"},{"id":"manas-2010:p0332:b001:l031","ordinal":15148,"en":"Began a terrible torment."},{"id":"manas-2010:p0332:b001:l032","ordinal":15149,"en":"When they saw Esenkan's wrath,"},{"id":"manas-2010:p0332:b001:l033","ordinal":15150,"en":"The mighty men who wore jackets"},{"id":"manas-2010:p0332:b001:l034","ordinal":15151,"en":"Gave up hope of life!"},{"id":"manas-2010:p0332:b001:l035","ordinal":15152,"en":"The stone-badged men ran."},{"id":"manas-2010:p0332:b001:l036","ordinal":15153,"en":"The wrestlers in bonds"},{"id":"manas-2010:p0332:b001:l037","ordinal":15154,"en":"Said, “We are dead,” and despaired of life."},{"id":"manas-2010:p0332:b001:l038","ordinal":15155,"en":"Khan Esenkan shouted,"},{"id":"manas-2010:p0332:b001:l039","ordinal":15156,"en":"Calling his many soldiers:"},{"id":"manas-2010:p0332:b001:l040","ordinal":15157,"en":"“Come, your mighty men who wear jackets,"},{"id":"manas-2010:p0332:b001:l041","ordinal":15158,"en":"Come, your finest officials with rank buttons on their caps,"},{"id":"manas-2010:p0332:b001:l042","ordinal":15159,"en":"Come, your deft and skillful spearmen,"},{"id":"manas-2010:p0332:b001:l043","ordinal":15160,"en":"Come, your mighty men who spare none!"},{"id":"manas-2010:p0332:b001:l044","ordinal":15161,"en":"Come, your heroes, wolves of war,"},{"id":"manas-2010:p0332:b001:l045","ordinal":15162,"en":"Who strike the enemy without drawing near,"},{"id":"manas-2010:p0332:b001:l046","ordinal":15163,"en":"Come, your broad-chested wolves!"},{"id":"manas-2010:p0332:b001:l047","ordinal":15164,"en":"Leave your cowards, let your heroes come,"},{"id":"manas-2010:p0332:b001:l048","ordinal":15165,"en":"Who do not flinch when a spear strikes,"},{"id":"manas-2010:p0333:b001:l001","ordinal":15166,"en":"Come, you who will go as heroes!"},{"id":"manas-2010:p0333:b001:l002","ordinal":15167,"en":"When you go to face the enemy,"},{"id":"manas-2010:p0333:b001:l003","ordinal":15168,"en":"Facing them and thrusting spears,"},{"id":"manas-2010:p0333:b001:l004","ordinal":15169,"en":"Come, you who will bring great suffering!"},{"id":"manas-2010:p0333:b001:l005","ordinal":15170,"en":"When a black gun crashes,"},{"id":"manas-2010:p0333:b001:l006","ordinal":15171,"en":"Who enter without drawing back,"},{"id":"manas-2010:p0333:b001:l007","ordinal":15172,"en":"Who strike the enemy without tiring,"},{"id":"manas-2010:p0333:b001:l008","ordinal":15173,"en":"Come, you who claim to be great,"},{"id":"manas-2010:p0333:b001:l009","ordinal":15174,"en":"All of you like this, come!"},{"id":"manas-2010:p0333:b001:l010","ordinal":15175,"en":"Come, your heroes of surpassing courage,"},{"id":"manas-2010:p0333:b001:l011","ordinal":15176,"en":"Shouting at that blood-spiller,"},{"id":"manas-2010:p0333:b001:l012","ordinal":15177,"en":"Come, you who will thrust spears without holding back!"},{"id":"manas-2010:p0333:b001:l013","ordinal":15178,"en":"If the people are slaughtered amid shouting,"},{"id":"manas-2010:p0333:b001:l014","ordinal":15179,"en":"Without hurrying into panic,"},{"id":"manas-2010:p0333:b001:l015","ordinal":15180,"en":"Come, you who will stand beneath the standard!"},{"id":"manas-2010:p0333:b001:l016","ordinal":15181,"en":"All truly courageous men, come,"},{"id":"manas-2010:p0333:b001:l017","ordinal":15182,"en":"Trick riders, swift runners on foot,"},{"id":"manas-2010:p0333:b001:l018","ordinal":15183,"en":"Great marksmen in the treasury's service,"},{"id":"manas-2010:p0333:b001:l019","ordinal":15184,"en":"All your skillful men, come!”"},{"id":"manas-2010:p0333:b001:l020","ordinal":15185,"en":"When Esenkan unleashed his wrath,"},{"id":"manas-2010:p0333:b001:l021","ordinal":15186,"en":"There were white banners and standards,"},{"id":"manas-2010:p0333:b001:l022","ordinal":15187,"en":"There was shouting and uproar,"},{"id":"manas-2010:p0333:b001:l023","ordinal":15188,"en":"There were blue banners and standards,"},{"id":"manas-2010:p0333:b001:l024","ordinal":15189,"en":"There was uproar echoing in the sky."},{"id":"manas-2010:p0333:b001:l025","ordinal":15190,"en":"Leaders of ten wheeled about,"},{"id":"manas-2010:p0333:b001:l026","ordinal":15191,"en":"Spearheads jutted upward,"},{"id":"manas-2010:p0333:b001:l027","ordinal":15192,"en":"The brass pipe's voice shrilled."},{"id":"manas-2010:p0333:b001:l028","ordinal":15193,"en":"Mottled blue flags appeared,"},{"id":"manas-2010:p0333:b001:l029","ordinal":15194,"en":"All who saw them divided,"},{"id":"manas-2010:p0333:b001:l030","ordinal":15195,"en":"Broke into groups of many kinds."},{"id":"manas-2010:p0333:b001:l031","ordinal":15196,"en":"When their khan gave orders,"},{"id":"manas-2010:p0333:b001:l032","ordinal":15197,"en":"His soldiers separated into divisions."},{"id":"manas-2010:p0333:b001:l033","ordinal":15198,"en":"Those who would not heed were slaughtered."},{"id":"manas-2010:p0333:b001:l034","ordinal":15199,"en":"His Torgut gathered to the last man."},{"id":"manas-2010:p0333:b001:l035","ordinal":15200,"en":"There were Manchu and Chinese people;"},{"id":"manas-2010:p0333:b001:l036","ordinal":15201,"en":"He gathered all he had."},{"id":"manas-2010:p0333:b001:l037","ordinal":15202,"en":"When their khan gave orders,"},{"id":"manas-2010:p0333:b001:l038","ordinal":15203,"en":"No one remained unassembled."},{"id":"manas-2010:p0333:b001:l039","ordinal":15204,"en":"“Ezkara, khan of the Manchus,"},{"id":"manas-2010:p0333:b001:l040","ordinal":15205,"en":"Khan Zholoy, khan of the Kalmyks,"},{"id":"manas-2010:p0333:b001:l041","ordinal":15206,"en":"All of you go, none stay behind,” he said."},{"id":"manas-2010:p0333:b001:l042","ordinal":15207,"en":"“My great magician Karazhoy,"},{"id":"manas-2010:p0333:b001:l043","ordinal":15208,"en":"Against the bloodthirsty Burut brat,"},{"id":"manas-2010:p0333:b001:l044","ordinal":15209,"en":"Please bring upheaval,"},{"id":"manas-2010:p0333:b001:l045","ordinal":15210,"en":"You too must go, do not stay behind!"},{"id":"manas-2010:p0333:b001:l046","ordinal":15211,"en":"Your marksmanship was unsurpassed,"},{"id":"manas-2010:p0333:b001:l047","ordinal":15212,"en":"You had valor,"},{"id":"manas-2010:p0333:b001:l048","ordinal":15213,"en":"Hiding when you saw a dry stalk."},{"id":"manas-2010:p0334:b001:l001","ordinal":15214,"en":"You possessed a warrior's courage;"},{"id":"manas-2010:p0334:b001:l002","ordinal":15215,"en":"Killing whoever faced you,"},{"id":"manas-2010:p0334:b001:l003","ordinal":15216,"en":"You possessed fearsome prowess."},{"id":"manas-2010:p0334:b001:l004","ordinal":15217,"en":"Your father's grave, Karazhoy!"},{"id":"manas-2010:p0334:b001:l005","ordinal":15218,"en":"If he attacks within the army,"},{"id":"manas-2010:p0334:b001:l006","ordinal":15219,"en":"Shoot his racer and bring it down."},{"id":"manas-2010:p0334:b001:l007","ordinal":15220,"en":"That bloodstained one—may he burn!—"},{"id":"manas-2010:p0334:b001:l008","ordinal":15221,"en":"That damned deceiver,"},{"id":"manas-2010:p0334:b001:l009","ordinal":15222,"en":"Without killing or destroying him,"},{"id":"manas-2010:p0334:b001:l010","ordinal":15223,"en":"Bind him and bring him alive!"},{"id":"manas-2010:p0334:b001:l011","ordinal":15224,"en":"Saying, 'My khan, a gift for you,'"},{"id":"manas-2010:p0334:b001:l012","ordinal":15225,"en":"Deliver him to me in person!"},{"id":"manas-2010:p0334:b001:l013","ordinal":15226,"en":"If you bring Manas bound,"},{"id":"manas-2010:p0334:b001:l014","ordinal":15227,"en":"I will agree to your demands."},{"id":"manas-2010:p0334:b001:l015","ordinal":15228,"en":"Oh, Karazhoy, listen:"},{"id":"manas-2010:p0334:b001:l016","ordinal":15229,"en":"I, Esen, true to my boast,"},{"id":"manas-2010:p0334:b001:l017","ordinal":15230,"en":"Will give you Bakburchun's throne!”"},{"id":"manas-2010:p0334:b001:l018","ordinal":15231,"en":"“Khan Zholoy of the Kalmyks,"},{"id":"manas-2010:p0334:b001:l019","ordinal":15232,"en":"Where are you?” he called."},{"id":"manas-2010:p0334:b001:l020","ordinal":15233,"en":"Since the khan was summoning him,"},{"id":"manas-2010:p0334:b001:l021","ordinal":15234,"en":"Zholoy came looming up,"},{"id":"manas-2010:p0334:b001:l022","ordinal":15235,"en":"Swelling like a travel tent."},{"id":"manas-2010:p0334:b001:l023","ordinal":15236,"en":"When Zholoy came beside him,"},{"id":"manas-2010:p0334:b001:l024","ordinal":15237,"en":"When Esen saw Zholoy,"},{"id":"manas-2010:p0334:b001:l025","ordinal":15238,"en":"Stamping on the ground beneath him,"},{"id":"manas-2010:p0334:b001:l026","ordinal":15239,"en":"Esenkan let loose,"},{"id":"manas-2010:p0334:b001:l027","ordinal":15240,"en":"Reproaching the hero Zholoy:"},{"id":"manas-2010:p0334:b001:l028","ordinal":15241,"en":"“Your father's grave, hero Zholoy!"},{"id":"manas-2010:p0334:b001:l029","ordinal":15242,"en":"You who threw the world into turmoil,"},{"id":"manas-2010:p0334:b001:l030","ordinal":15243,"en":"You were exceptional, Zholoy."},{"id":"manas-2010:p0334:b001:l031","ordinal":15244,"en":"You have let yourself be beaten;"},{"id":"manas-2010:p0334:b001:l032","ordinal":15245,"en":"By the throat, by a lion,"},{"id":"manas-2010:p0334:b001:l033","ordinal":15246,"en":"You have let yourself be caught!"},{"id":"manas-2010:p0334:b001:l034","ordinal":15247,"en":"Where are the champions, where the heroes?"},{"id":"manas-2010:p0334:b001:l035","ordinal":15248,"en":"Brave Döngö, the giant Kaman—"},{"id":"manas-2010:p0334:b001:l036","ordinal":15249,"en":"Where are warriors such as they?"},{"id":"manas-2010:p0334:b001:l037","ordinal":15250,"en":"You let yourself be struck from the flank,"},{"id":"manas-2010:p0334:b001:l038","ordinal":15251,"en":"And all your valiant men"},{"id":"manas-2010:p0334:b001:l039","ordinal":15252,"en":"You let the Burut take as gifts."},{"id":"manas-2010:p0334:b001:l040","ordinal":15253,"en":"What have you done?!"},{"id":"manas-2010:p0334:b001:l041","ordinal":15254,"en":"Why are you standing here alive?!"},{"id":"manas-2010:p0334:b001:l042","ordinal":15255,"en":"Eating seven batmans of wheat,"},{"id":"manas-2010:p0334:b001:l043","ordinal":15256,"en":"You were a slave smelling of grain;"},{"id":"manas-2010:p0334:b001:l044","ordinal":15257,"en":"Killing seventy giants,"},{"id":"manas-2010:p0334:b001:l045","ordinal":15258,"en":"You were a slave smelling of blood!"},{"id":"manas-2010:p0334:b001:l046","ordinal":15259,"en":"Eating six batmans of wheat,"},{"id":"manas-2010:p0334:b001:l047","ordinal":15260,"en":"You were a slave smelling of grain!"},{"id":"manas-2010:p0334:b001:l048","ordinal":15261,"en":"Killing sixty giants,"},{"id":"manas-2010:p0335:b001:l001","ordinal":15262,"en":"You were a slave smelling of blood!"},{"id":"manas-2010:p0335:b001:l002","ordinal":15263,"en":"Where are the champions, where the giants?"},{"id":"manas-2010:p0335:b001:l003","ordinal":15264,"en":"Great glutton who boasts of valor,"},{"id":"manas-2010:p0335:b001:l004","ordinal":15265,"en":"Where are the people you led?"},{"id":"manas-2010:p0335:b001:l005","ordinal":15266,"en":"Against that bloodstained Burut,"},{"id":"manas-2010:p0335:b001:l006","ordinal":15267,"en":"Engage in a mighty fight;"},{"id":"manas-2010:p0335:b001:l007","ordinal":15268,"en":"If death has come, go and die!"},{"id":"manas-2010:p0335:b001:l008","ordinal":15269,"en":"Grapple with that Burut,"},{"id":"manas-2010:p0335:b001:l009","ordinal":15270,"en":"That damned bloodstained one,"},{"id":"manas-2010:p0335:b001:l010","ordinal":15271,"en":"That deceiver who has done so much harm;"},{"id":"manas-2010:p0335:b001:l011","ordinal":15272,"en":"Gouge out his eyes in torment!"},{"id":"manas-2010:p0335:b001:l012","ordinal":15273,"en":"Seize him and slaughter him!"},{"id":"manas-2010:p0335:b001:l013","ordinal":15274,"en":"Without leaving the Burut alive,"},{"id":"manas-2010:p0335:b001:l014","ordinal":15275,"en":"Go test his valor!"},{"id":"manas-2010:p0335:b001:l015","ordinal":15276,"en":"If your strength begins to fail,"},{"id":"manas-2010:p0335:b001:l016","ordinal":15277,"en":"Do not survive—go and die!"},{"id":"manas-2010:p0335:b001:l017","ordinal":15278,"en":"Until the soft stalks ripen,"},{"id":"manas-2010:p0335:b001:l018","ordinal":15279,"en":"Until autumn's gossamer flies,"},{"id":"manas-2010:p0335:b001:l019","ordinal":15280,"en":"Fight hard for six months;"},{"id":"manas-2010:p0335:b001:l020","ordinal":15281,"en":"Grapple and spill his blood!"},{"id":"manas-2010:p0335:b001:l021","ordinal":15282,"en":"The Burut's ribs,"},{"id":"manas-2010:p0335:b001:l022","ordinal":15283,"en":"Tear them apart with a crack!"},{"id":"manas-2010:p0335:b001:l023","ordinal":15284,"en":"If the Burut is formidable,"},{"id":"manas-2010:p0335:b001:l024","ordinal":15285,"en":"Go test his heroic mettle!"},{"id":"manas-2010:p0335:b001:l025","ordinal":15286,"en":"Instead of scurrying about,"},{"id":"manas-2010:p0335:b001:l026","ordinal":15287,"en":"Rather than surviving the Burut,"},{"id":"manas-2010:p0335:b001:l027","ordinal":15288,"en":"Die without turning back!"},{"id":"manas-2010:p0335:b001:l028","ordinal":15289,"en":"If you have the strength, fight;"},{"id":"manas-2010:p0335:b001:l029","ordinal":15290,"en":"If your wrath rises, grapple!"},{"id":"manas-2010:p0335:b001:l030","ordinal":15291,"en":"Against that damned bloodstained one,"},{"id":"manas-2010:p0335:b001:l031","ordinal":15292,"en":"If you cannot match him in battle"},{"id":"manas-2010:p0335:b001:l032","ordinal":15293,"en":"And he migrates to his homeland,"},{"id":"manas-2010:p0335:b001:l033","ordinal":15294,"en":"If the mad wretch reaches safely"},{"id":"manas-2010:p0335:b001:l034","ordinal":15295,"en":"His own Burut people,"},{"id":"manas-2010:p0335:b001:l035","ordinal":15296,"en":"Our strength will not suffice in combat."},{"id":"manas-2010:p0335:b001:l036","ordinal":15297,"en":"However we struggle, our strength"},{"id":"manas-2010:p0335:b001:l037","ordinal":15298,"en":"Will not match this Burut!"},{"id":"manas-2010:p0335:b001:l038","ordinal":15299,"en":"He is the bloodstained Burut himself;"},{"id":"manas-2010:p0335:b001:l039","ordinal":15300,"en":"His are the eyes of one accursed to burn!"},{"id":"manas-2010:p0335:b001:l040","ordinal":15301,"en":"If danger comes to your life,"},{"id":"manas-2010:p0335:b001:l041","ordinal":15302,"en":"Fight and kill him!"},{"id":"manas-2010:p0335:b001:l042","ordinal":15303,"en":"If you have the strength and power,"},{"id":"manas-2010:p0335:b001:l043","ordinal":15304,"en":"Bind him and bring him here alive!"},{"id":"manas-2010:p0335:b001:l044","ordinal":15305,"en":"Let us hold him fast."},{"id":"manas-2010:p0335:b001:l045","ordinal":15306,"en":"For those kept in the royal establishment,"},{"id":"manas-2010:p0335:b001:l046","ordinal":15307,"en":"The girls, let us use him as a stallion!"},{"id":"manas-2010:p0335:b001:l047","ordinal":15308,"en":"Once he has fathered offspring,"},{"id":"manas-2010:p0335:b001:l048","ordinal":15309,"en":"Then let us take his head!"},{"id":"manas-2010:p0336:b001:l001","ordinal":15310,"en":"Let us kill and utterly destroy him,"},{"id":"manas-2010:p0336:b001:l002","ordinal":15311,"en":"And slaughter him as a sacrifice!"},{"id":"manas-2010:p0336:b001:l003","ordinal":15312,"en":"Upon that mad wretch himself,"},{"id":"manas-2010:p0336:b001:l004","ordinal":15313,"en":"Let us take revenge in this way!"},{"id":"manas-2010:p0336:b001:l005","ordinal":15314,"en":"If your strength cannot match Manas,"},{"id":"manas-2010:p0336:b001:l006","ordinal":15315,"en":"To the Kyrgyz Burut of forty households,"},{"id":"manas-2010:p0336:b001:l007","ordinal":15316,"en":"Do not chance to surrender"},{"id":"manas-2010:p0336:b001:l008","ordinal":15317,"en":"The people under your command!"},{"id":"manas-2010:p0336:b001:l009","ordinal":15318,"en":"If you return bent and broken,"},{"id":"manas-2010:p0336:b001:l010","ordinal":15319,"en":"Drooping after being struck down,"},{"id":"manas-2010:p0336:b001:l011","ordinal":15320,"en":"You will see wrath from me;"},{"id":"manas-2010:p0336:b001:l012","ordinal":15321,"en":"You will all die without exception!"},{"id":"manas-2010:p0336:b001:l013","ordinal":15322,"en":"If you let Manas get away unharmed,"},{"id":"manas-2010:p0336:b001:l014","ordinal":15323,"en":"I will wreak all the havoc I know."},{"id":"manas-2010:p0336:b001:l015","ordinal":15324,"en":"Karazhoy, Zholoy, my champions,"},{"id":"manas-2010:p0336:b001:l016","ordinal":15325,"en":"I will slaughter every one of you!"},{"id":"manas-2010:p0336:b001:l017","ordinal":15326,"en":"Having you dragged onto the road,"},{"id":"manas-2010:p0336:b001:l018","ordinal":15327,"en":"If the bloodstained one escapes alive,"},{"id":"manas-2010:p0336:b001:l019","ordinal":15328,"en":"I will tear you open for the great dogs!"},{"id":"manas-2010:p0336:b001:l020","ordinal":15329,"en":"The forty households driven here,"},{"id":"manas-2010:p0336:b001:l021","ordinal":15330,"en":"Whose language is the Burut tongue,"},{"id":"manas-2010:p0336:b001:l022","ordinal":15331,"en":"That people—may they burn!—"},{"id":"manas-2010:p0336:b001:l023","ordinal":15332,"en":"Are our enemies at heart!"},{"id":"manas-2010:p0336:b001:l024","ordinal":15333,"en":"I told the sorcerers to go;"},{"id":"manas-2010:p0336:b001:l025","ordinal":15334,"en":"When I sent them and they went,"},{"id":"manas-2010:p0336:b001:l026","ordinal":15335,"en":"Did they not bring disaster?"},{"id":"manas-2010:p0336:b001:l027","ordinal":15336,"en":"Their dark eyes blinded,"},{"id":"manas-2010:p0336:b001:l028","ordinal":15337,"en":"Did they not bring disaster?"},{"id":"manas-2010:p0336:b001:l029","ordinal":15338,"en":"Unable to judge his true nature,"},{"id":"manas-2010:p0336:b001:l030","ordinal":15339,"en":"Did they not bring disaster?!"},{"id":"manas-2010:p0336:b001:l031","ordinal":15340,"en":"Unable to judge him properly,"},{"id":"manas-2010:p0336:b001:l032","ordinal":15341,"en":"They set the turmoil in motion."},{"id":"manas-2010:p0336:b001:l033","ordinal":15342,"en":"Sated with Jakyp's fat,"},{"id":"manas-2010:p0336:b001:l034","ordinal":15343,"en":"Those damned sorcerers"},{"id":"manas-2010:p0336:b001:l035","ordinal":15344,"en":"Left without seeing his son!"},{"id":"manas-2010:p0336:b001:l036","ordinal":15345,"en":"Those damned sorcerers'"},{"id":"manas-2010:p0336:b001:l037","ordinal":15346,"en":"Deeds brought great trouble."},{"id":"manas-2010:p0336:b001:l038","ordinal":15347,"en":"They left him alive—what a sorrow!"},{"id":"manas-2010:p0336:b001:l039","ordinal":15348,"en":"The Burut was born and grew up;"},{"id":"manas-2010:p0336:b001:l040","ordinal":15349,"en":"He will plunge the world into great conflict!"},{"id":"manas-2010:p0336:b001:l041","ordinal":15350,"en":"'Manas will arise among the Burut,' I said;"},{"id":"manas-2010:p0336:b001:l042","ordinal":15351,"en":"I knew of the calamity."},{"id":"manas-2010:p0336:b001:l043","ordinal":15352,"en":"Older than six months,"},{"id":"manas-2010:p0336:b001:l044","ordinal":15353,"en":"Younger than sixteen,"},{"id":"manas-2010:p0336:b001:l045","ordinal":15354,"en":"If he was named Manas,"},{"id":"manas-2010:p0336:b001:l046","ordinal":15355,"en":"'Bring him in,' I told you all;"},{"id":"manas-2010:p0336:b001:l047","ordinal":15356,"en":"That was the order I gave!"},{"id":"manas-2010:p0336:b001:l048","ordinal":15357,"en":"They pretended not to see and brought ruin;"},{"id":"manas-2010:p0337:b001:l001","ordinal":15358,"en":"The sorcerers committed that outrage!"},{"id":"manas-2010:p0337:b001:l002","ordinal":15359,"en":"'As far as Mecca and great Baghdad,"},{"id":"manas-2010:p0337:b001:l003","ordinal":15360,"en":"I searched to their farthest depths,' they said."}]
