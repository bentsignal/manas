[{"id":"sayakbay-ms-current145:pdf087:l027","ordinal":395009,"en":"He said, speak precisely and stand firm"},{"id":"sayakbay-ms-current145:pdf087:l028","ordinal":395010,"en":"Traveling on without tiring"},{"id":"sayakbay-ms-current145:pdf087:l029","ordinal":395011,"en":"A host of many kinds advanced"},{"id":"sayakbay-ms-current145:pdf087:l030","ordinal":395012,"en":"Bertik traveled surely and firmly"},{"id":"sayakbay-ms-current145:pdf088:l001","ordinal":395013,"en":"From outside, leading the horse"},{"id":"sayakbay-ms-current145:pdf088:l003","ordinal":395014,"en":"He took it by its muzzle"},{"id":"sayakbay-ms-current145:pdf088:l004","ordinal":395015,"en":"Taking the forked ridge of the mountain"},{"id":"sayakbay-ms-current145:pdf088:l006","ordinal":395016,"en":"The mighty champion whom Kozom foretold"},{"id":"sayakbay-ms-current145:pdf088:l007","ordinal":395017,"en":"When he asked the people for the rope"},{"id":"sayakbay-ms-current145:pdf088:l008","ordinal":395018,"en":"Looking upon the former misery"},{"id":"sayakbay-ms-current145:pdf088:l009","ordinal":395019,"en":"This was what they had lacked"},{"id":"sayakbay-ms-current145:pdf088:l010","ordinal":395020,"en":"Telling what his eyes had seen"},{"id":"sayakbay-ms-current145:pdf088:l011","ordinal":395021,"en":"The red-eyed one who came to that"},{"id":"sayakbay-ms-current145:pdf088:l012","ordinal":395022,"en":"Taking burden-bearers by the thousand"},{"id":"sayakbay-ms-current145:pdf088:l015","ordinal":395023,"en":"Joy filled him like milk"},{"id":"sayakbay-ms-current145:pdf088:l016","ordinal":395024,"en":"He became a hero to those who came"},{"id":"sayakbay-ms-current145:pdf088:l017","ordinal":395025,"en":"My sacred eyes found peace"},{"id":"sayakbay-ms-current145:pdf088:l021","ordinal":395026,"en":"To the peri-born Beybak"},{"id":"sayakbay-ms-current145:pdf088:l028","ordinal":395027,"en":"Her mouth opened in anguish"},{"id":"sayakbay-ms-current145:pdf088:l029","ordinal":395028,"en":"When the pain came, the earth groaned"},{"id":"sayakbay-ms-current145:pdf088:l030","ordinal":395029,"en":"Tears filled both eyes"},{"id":"sayakbay-ms-current145:pdf088:l031","ordinal":395030,"en":"Uzunkan fell into sorrow"},{"id":"sayakbay-ms-current145:pdf089:l002","ordinal":395031,"en":"Truly sobbing upon the ground"},{"id":"sayakbay-ms-current145:pdf089:l003","ordinal":395032,"en":"The messenger ran swiftly"},{"id":"sayakbay-ms-current145:pdf089:l006","ordinal":395033,"en":"Her cries carried toward Talas"},{"id":"sayakbay-ms-current145:pdf089:l008","ordinal":395034,"en":"Her dear soul was shaken"},{"id":"sayakbay-ms-current145:pdf089:l011","ordinal":395035,"en":"Her labor tightened"},{"id":"sayakbay-ms-current145:pdf089:l012","ordinal":395036,"en":"It bewildered her mind"},{"id":"sayakbay-ms-current145:pdf089:l013","ordinal":395037,"en":"Her elder’s throat went dry"},{"id":"sayakbay-ms-current145:pdf089:l015","ordinal":395038,"en":"From the agony and chill"},{"id":"sayakbay-ms-current145:pdf089:l016","ordinal":395039,"en":"The attendants seized her in distress"},{"id":"sayakbay-ms-current145:pdf089:l017","ordinal":395040,"en":"Weeping, they begged for help"},{"id":"sayakbay-ms-current145:pdf089:l018","ordinal":395041,"en":"Pleading to the Creator"},{"id":"sayakbay-ms-current145:pdf089:l019","ordinal":395042,"en":"Clinging to her tiny life"},{"id":"sayakbay-ms-current145:pdf089:l020","ordinal":395043,"en":"O Creator, one God"},{"id":"sayakbay-ms-current145:pdf089:l021","ordinal":395044,"en":"Grant aid to one lying in grievous sorrow"},{"id":"sayakbay-ms-current145:pdf089:l022","ordinal":395045,"en":"If her life ends, grant her faith"},{"id":"sayakbay-ms-current145:pdf089:l023","ordinal":395046,"en":"Coming and appearing before their eyes"},{"id":"sayakbay-ms-current145:pdf089:l024","ordinal":395047,"en":"Without stopping the blue roan"},{"id":"sayakbay-ms-current145:pdf089:l025","ordinal":395048,"en":"Do not torment her unto death"},{"id":"sayakbay-ms-current145:pdf089:l026","ordinal":395049,"en":"You brought this upon her in youth"},{"id":"sayakbay-ms-current145:pdf089:l027","ordinal":395050,"en":"She fell into fierce pain"},{"id":"sayakbay-ms-current145:pdf089:l028","ordinal":395051,"en":"O Creator of black and dappled things"},{"id":"sayakbay-ms-current145:pdf089:l029","ordinal":395052,"en":"Pleading to you alone"},{"id":"sayakbay-ms-current145:pdf089:l030","ordinal":395053,"en":"May there be light beyond her life"},{"id":"sayakbay-ms-current145:pdf089:l031","ordinal":395054,"en":"Her bones ache and sorrow grows"},{"id":"sayakbay-ms-current145:pdf089:l032","ordinal":395055,"en":"Her palate dried and her strength departed"},{"id":"sayakbay-ms-current145:pdf090:l001","ordinal":395056,"en":"Her whole flesh softened"},{"id":"sayakbay-ms-current145:pdf090:l002","ordinal":395057,"en":"Casting her into care and sorrow"},{"id":"sayakbay-ms-current145:pdf090:l003","ordinal":395058,"en":"The travail became plain to see"},{"id":"sayakbay-ms-current145:pdf090:l004","ordinal":395059,"en":"Could they cease making prayers"},{"id":"sayakbay-ms-current145:pdf090:l005","ordinal":395060,"en":"Her tongue formed its words"},{"id":"sayakbay-ms-current145:pdf090:l006","ordinal":395061,"en":"Care upon care divided her thoughts"},{"id":"sayakbay-ms-current145:pdf090:l007","ordinal":395062,"en":"The Uyghur gathered and took the standard"},{"id":"sayakbay-ms-current145:pdf090:l008","ordinal":395063,"en":"Her soul appeared to flutter"},{"id":"sayakbay-ms-current145:pdf090:l009","ordinal":395064,"en":"Her watching eyes filled with tears"},{"id":"sayakbay-ms-current145:pdf090:l010","ordinal":395065,"en":"Sickness gripped all who remained"},{"id":"sayakbay-ms-current145:pdf090:l011","ordinal":395066,"en":"Saying the living still have strength"},{"id":"sayakbay-ms-current145:pdf090:l012","ordinal":395067,"en":"What the Creator placed upon her"},{"id":"sayakbay-ms-current145:pdf090:l013","ordinal":395068,"en":"Let the people hear and know"},{"id":"sayakbay-ms-current145:pdf090:l014","ordinal":395069,"en":"So the other one spoke"},{"id":"sayakbay-ms-current145:pdf090:l015","ordinal":395070,"en":"The peri-born Beybak"},{"id":"sayakbay-ms-current145:pdf090:l016","ordinal":395071,"en":"All the people waited"},{"id":"sayakbay-ms-current145:pdf090:l017","ordinal":395072,"en":"In the narrowness of her pain"},{"id":"sayakbay-ms-current145:pdf090:l018","ordinal":395073,"en":"Appearing hateful to the eye"},{"id":"sayakbay-ms-current145:pdf090:l019","ordinal":395074,"en":"Tears flowed from dear eyes"},{"id":"sayakbay-ms-current145:pdf090:l020","ordinal":395075,"en":"Bloody, washing her collar"},{"id":"sayakbay-ms-current145:pdf090:l021","ordinal":395076,"en":"Crying fiercely, gripping her waist"},{"id":"sayakbay-ms-current145:pdf090:l022","ordinal":395077,"en":"Smoke curled from her mouth"},{"id":"sayakbay-ms-current145:pdf090:l023","ordinal":395078,"en":"From this fatherless world"},{"id":"sayakbay-ms-current145:pdf090:l024","ordinal":395079,"en":"She neared the point of not remaining"},{"id":"sayakbay-ms-current145:pdf090:l025","ordinal":395080,"en":"Those watching gathered around"},{"id":"sayakbay-ms-current145:pdf090:l026","ordinal":395081,"en":"Standing there without cease"},{"id":"sayakbay-ms-current145:pdf090:l027","ordinal":395082,"en":"Clinging to poles in anguish"},{"id":"sayakbay-ms-current145:pdf090:l028","ordinal":395083,"en":"This plea went to God"},{"id":"sayakbay-ms-current145:pdf090:l029","ordinal":395084,"en":"Pleading to him alone"},{"id":"sayakbay-ms-current145:pdf090:l030","ordinal":395085,"en":"Her prayer was her only remedy"},{"id":"sayakbay-ms-current145:pdf090:l031","ordinal":395086,"en":"The dear soul they had found"},{"id":"sayakbay-ms-current145:pdf090:l032","ordinal":395087,"en":"Truly lay there in travail"},{"id":"sayakbay-ms-current145:pdf090:l033","ordinal":395088,"en":"Giving strength to her tiny life"},{"id":"sayakbay-ms-current145:pdf091:l001","ordinal":395089,"en":"The poor soul was filled with worry,"},{"id":"sayakbay-ms-current145:pdf091:l002","ordinal":395090,"en":"The seventy-year-old dervish Kydyr,"},{"id":"sayakbay-ms-current145:pdf091:l003","ordinal":395091,"en":"Whose turban was as large as a cauldron,"},{"id":"sayakbay-ms-current145:pdf091:l004","ordinal":395092,"en":"Whose shout sounded like the call to prayer,"},{"id":"sayakbay-ms-current145:pdf091:l005","ordinal":395093,"en":"Taking charge of the matter,"},{"id":"sayakbay-ms-current145:pdf091:l006","ordinal":395094,"en":"He spoke, saying, “Do not grieve,”"},{"id":"sayakbay-ms-current145:pdf091:l007","ordinal":395095,"en":"Speaking of what he perceived in the child,"},{"id":"sayakbay-ms-current145:pdf091:l008","ordinal":395096,"en":"The dervish of ninety tribes,"},{"id":"sayakbay-ms-current145:pdf091:l009","ordinal":395097,"en":"Reciting sacred words four at a time,"},{"id":"sayakbay-ms-current145:pdf091:l010","ordinal":395098,"en":"When they looked, it was Kydyr himself,"},{"id":"sayakbay-ms-current145:pdf091:l011","ordinal":395099,"en":"For the unfortunate Perizaada,"},{"id":"sayakbay-ms-current145:pdf091:l012","ordinal":395100,"en":"The time had come for him to be a firm companion,"},{"id":"sayakbay-ms-current145:pdf091:l013","ordinal":395101,"en":"Her supporter was Kydyr himself,"},{"id":"sayakbay-ms-current145:pdf091:l014","ordinal":395102,"en":"A fortunate means and occasion,"},{"id":"sayakbay-ms-current145:pdf091:l015","ordinal":395103,"en":"The time had come to leave what was bestowed,"},{"id":"sayakbay-ms-current145:pdf091:l016","ordinal":395104,"en":"The unfortunate Perizaada,"},{"id":"sayakbay-ms-current145:pdf091:l017","ordinal":395105,"en":"If she did not stray from the path,"},{"id":"sayakbay-ms-current145:pdf091:l018","ordinal":395106,"en":"The time had come for her protector to depart,"},{"id":"sayakbay-ms-current145:pdf091:l019","ordinal":395107,"en":"Straining himself over the child,"},{"id":"sayakbay-ms-current145:pdf091:l020","ordinal":395108,"en":"The time had come to give his blessing;"},{"id":"sayakbay-ms-current145:pdf091:l021","ordinal":395109,"en":"Saying, “Repent, Bermet, repent,”"},{"id":"sayakbay-ms-current145:pdf091:l022","ordinal":395110,"en":"Entrusting himself to Providence,"},{"id":"sayakbay-ms-current145:pdf091:l023","ordinal":395111,"en":"For the unfortunate Kydyr, [?],"},{"id":"sayakbay-ms-current145:pdf091:l024","ordinal":395112,"en":"He named him [?],"},{"id":"sayakbay-ms-current145:pdf091:l025","ordinal":395113,"en":"His whole body tingling upward,"},{"id":"sayakbay-ms-current145:pdf091:l026","ordinal":395114,"en":"Hearing the suddenly uttered command,"},{"id":"sayakbay-ms-current145:pdf091:l027","ordinal":395115,"en":"A person without an elder brother—oh, elder sister,"},{"id":"sayakbay-ms-current145:pdf091:l028","ordinal":395116,"en":"This is the deed that remained from then."},{"id":"sayakbay-ms-current145:pdf091:l029","ordinal":395117,"en":"The transience of the world,"},{"id":"sayakbay-ms-current145:pdf091:l030","ordinal":395118,"en":"May he become a shield for the people,"},{"id":"sayakbay-ms-current145:pdf091:l031","ordinal":395119,"en":"You are the lamb of the Undying One,"},{"id":"sayakbay-ms-current145:pdf091:l032","ordinal":395120,"en":"Protecting the people when the multitude is thrown into turmoil,"},{"id":"sayakbay-ms-current145:pdf092:l001","ordinal":395121,"en":"A resounding voice came from the hero,"},{"id":"sayakbay-ms-current145:pdf092:l002","ordinal":395122,"en":"A sacred voice rang out,"},{"id":"sayakbay-ms-current145:pdf092:l003","ordinal":395123,"en":"Thus he spoke words about the child,"},{"id":"sayakbay-ms-current145:pdf092:l004","ordinal":395124,"en":"When they looked, he could not be seen,"},{"id":"sayakbay-ms-current145:pdf092:l005","ordinal":395125,"en":"No one knew where he was,"},{"id":"sayakbay-ms-current145:pdf092:l006","ordinal":395126,"en":"Kydyr had bestowed the name,"},{"id":"sayakbay-ms-current145:pdf092:l007","ordinal":395127,"en":"Their hearts ached, but he was gone,"},{"id":"sayakbay-ms-current145:pdf092:l008","ordinal":395128,"en":"The man who had spoken these words,"},{"id":"sayakbay-ms-current145:pdf092:l009","ordinal":395129,"en":"Had vanished from sight."},{"id":"sayakbay-ms-current145:pdf092:l010","ordinal":395130,"en":"Kydyr [?],"},{"id":"sayakbay-ms-current145:pdf092:l011","ordinal":395131,"en":"On the stirring Nights of Power,"},{"id":"sayakbay-ms-current145:pdf092:l012","ordinal":395132,"en":"The unfortunate Perizaada,"},{"id":"sayakbay-ms-current145:pdf092:l013","ordinal":395133,"en":"Rose suddenly to her feet,"},{"id":"sayakbay-ms-current145:pdf092:l014","ordinal":395134,"en":"Before one could say a word,"},{"id":"sayakbay-ms-current145:pdf092:l015","ordinal":395135,"en":"In the blink of an eye,"},{"id":"sayakbay-ms-current145:pdf092:l016","ordinal":395136,"en":"While she stood looking at her child,"},{"id":"sayakbay-ms-current145:pdf092:l017","ordinal":395137,"en":"He vanished from sight,"},{"id":"sayakbay-ms-current145:pdf092:l018","ordinal":395138,"en":"“As I see it, that is how it was.”"},{"id":"sayakbay-ms-current145:pdf092:l019","ordinal":395139,"en":"Giving Bermet a blessing,"},{"id":"sayakbay-ms-current145:pdf092:l020","ordinal":395140,"en":"The time had come for it to settle upon her;"},{"id":"sayakbay-ms-current145:pdf092:l021","ordinal":395141,"en":"Taking the radiant child,"},{"id":"sayakbay-ms-current145:pdf092:l025","ordinal":395142,"en":"At the very midpoint [?],"},{"id":"sayakbay-ms-current145:pdf092:l028","ordinal":395143,"en":"Kydyr parted from them for paradise,"},{"id":"sayakbay-ms-current145:pdf092:l029","ordinal":395144,"en":"Like dung [?],"},{"id":"sayakbay-ms-current145:pdf092:l030","ordinal":395145,"en":"Wondrous was the deed wrought by Kydyr,"},{"id":"sayakbay-ms-current145:pdf093:l001","ordinal":395146,"en":"Dismounting at Makooluk,"},{"id":"sayakbay-ms-current145:pdf093:l002","ordinal":395147,"en":"The sun shone overhead,"},{"id":"sayakbay-ms-current145:pdf093:l003","ordinal":395148,"en":"Day and night appeared bright,"},{"id":"sayakbay-ms-current145:pdf093:l004","ordinal":395149,"en":"The clouding of the sun vanished,"},{"id":"sayakbay-ms-current145:pdf093:l005","ordinal":395150,"en":"Then Zholtoi quickly saw,"},{"id":"sayakbay-ms-current145:pdf093:l008","ordinal":395151,"en":"The child descended, beaming,"},{"id":"sayakbay-ms-current145:pdf093:l009","ordinal":395152,"en":"Thundering as though struck with force,"},{"id":"sayakbay-ms-current145:pdf093:l012","ordinal":395153,"en":"The unmoving host of enemies,"},{"id":"sayakbay-ms-current145:pdf093:l022","ordinal":395154,"en":"“Distinct from all the others,”"},{"id":"sayakbay-ms-current145:pdf093:l023","ordinal":395155,"en":"“There is a fully formed son,”"},{"id":"sayakbay-ms-current145:pdf093:l032","ordinal":395156,"en":"Settle among the people made pale,"},{"id":"sayakbay-ms-current145:pdf093:l033","ordinal":395157,"en":"Settle among the clamoring people too,"},{"id":"sayakbay-ms-current145:pdf094:l001","ordinal":395158,"en":"While the child stood crying loudly,"},{"id":"sayakbay-ms-current145:pdf094:l002","ordinal":395159,"en":"The people entering the house saw him,"},{"id":"sayakbay-ms-current145:pdf094:l003","ordinal":395160,"en":"Twelve old women, because of the child,"},{"id":"sayakbay-ms-current145:pdf094:l004","ordinal":395161,"en":"Sat with their hearts overcome,"},{"id":"sayakbay-ms-current145:pdf094:l005","ordinal":395162,"en":"His young companions hurried,"},{"id":"sayakbay-ms-current145:pdf094:l006","ordinal":395163,"en":"The children gathered to play,"},{"id":"sayakbay-ms-current145:pdf094:l007","ordinal":395164,"en":"Many young women reached out their hands,"},{"id":"sayakbay-ms-current145:pdf094:l008","ordinal":395165,"en":"They fluttered about radiantly."},{"id":"sayakbay-ms-current145:pdf094:l011","ordinal":395166,"en":"Each cried out and spoke distinctly,"},{"id":"sayakbay-ms-current145:pdf094:l012","ordinal":395167,"en":"A song for springtime play,"},{"id":"sayakbay-ms-current145:pdf094:l013","ordinal":395168,"en":"The sovereign of campaigns and war,"},{"id":"sayakbay-ms-current145:pdf094:l016","ordinal":395169,"en":"Black waters came from many sides,"},{"id":"sayakbay-ms-current145:pdf094:l017","ordinal":395170,"en":"Dust rose as a lamb-flock moved,"},{"id":"sayakbay-ms-current145:pdf094:l019","ordinal":395171,"en":"For the rite of noble Alake,"},{"id":"sayakbay-ms-current145:pdf094:l021","ordinal":395172,"en":"And to the one upon that plain,"},{"id":"sayakbay-ms-current145:pdf094:l026","ordinal":395173,"en":"And went to the people of Kemin."},{"id":"sayakbay-ms-current145:pdf095:l001","ordinal":395174,"en":"Fashioned at the center of the earth"},{"id":"sayakbay-ms-current145:pdf095:l002","ordinal":395175,"en":"Today the appointed time had come"},{"id":"sayakbay-ms-current145:pdf095:l004","ordinal":395176,"en":"He was a warrior who roamed in struggle"},{"id":"sayakbay-ms-current145:pdf095:l005","ordinal":395177,"en":"His companion would be at his side"},{"id":"sayakbay-ms-current145:pdf095:l006","ordinal":395178,"en":"Now was the moment of sudden clangor"},{"id":"sayakbay-ms-current145:pdf095:l007","ordinal":395179,"en":"Saying, look beneath the earth"},{"id":"sayakbay-ms-current145:pdf095:l012","ordinal":395180,"en":"Hero Kenen stood gripping it"},{"id":"sayakbay-ms-current145:pdf095:l013","ordinal":395181,"en":"Ancient and true faith"},{"id":"sayakbay-ms-current145:pdf095:l017","ordinal":395182,"en":"This cry rang out"},{"id":"sayakbay-ms-current145:pdf095:l018","ordinal":395183,"en":"Black blood in his right hand"},{"id":"sayakbay-ms-current145:pdf095:l019","ordinal":395184,"en":"Shouting, he called upon the faith"},{"id":"sayakbay-ms-current145:pdf095:l020","ordinal":395185,"en":"His voice was heard by God"},{"id":"sayakbay-ms-current145:pdf095:l021","ordinal":395186,"en":"A soul who made wealth of the cauldron"},{"id":"sayakbay-ms-current145:pdf095:l022","ordinal":395187,"en":"Falling upon his breast"},{"id":"sayakbay-ms-current145:pdf095:l023","ordinal":395188,"en":"No bridle was placed upon another"},{"id":"sayakbay-ms-current145:pdf095:l024","ordinal":395189,"en":"Drive on, that child"},{"id":"sayakbay-ms-current145:pdf095:l025","ordinal":395190,"en":"As though to seize his face"},{"id":"sayakbay-ms-current145:pdf095:l026","ordinal":395191,"en":"The people screamed and the land stirred"},{"id":"sayakbay-ms-current145:pdf096:l008","ordinal":395192,"en":"His fortune rose from the young peak"},{"id":"sayakbay-ms-current145:pdf096:l011","ordinal":395193,"en":"What he said of the remaining time"},{"id":"sayakbay-ms-current145:pdf096:l014","ordinal":395194,"en":"Kenen’s majesty before the blue-clad people"},{"id":"sayakbay-ms-current145:pdf096:l018","ordinal":395195,"en":"When he spoke openly and fully"},{"id":"sayakbay-ms-current145:pdf096:l023","ordinal":395196,"en":"The valley’s moment had arrived"},{"id":"sayakbay-ms-current145:pdf096:l027","ordinal":395197,"en":"What he said of keeping his own secret"},{"id":"sayakbay-ms-current145:pdf096:l028","ordinal":395198,"en":"If it struck the evident stranger"},{"id":"sayakbay-ms-current145:pdf097:l002","ordinal":395199,"en":"Divine strength came to the banner"},{"id":"sayakbay-ms-current145:pdf097:l005","ordinal":395200,"en":"Making his birth a blessed seat of honor"},{"id":"sayakbay-ms-current145:pdf097:l006","ordinal":395201,"en":"Taking command of the people’s host"},{"id":"sayakbay-ms-current145:pdf097:l008","ordinal":395202,"en":"Kenen’s age would span much of the world"},{"id":"sayakbay-ms-current145:pdf097:l009","ordinal":395203,"en":"Saying God had given him to us"},{"id":"sayakbay-ms-current145:pdf097:l010","ordinal":395204,"en":"The people around the Amu"},{"id":"sayakbay-ms-current145:pdf097:l014","ordinal":395205,"en":"Smiling toward Perizada"},{"id":"sayakbay-ms-current145:pdf097:l016","ordinal":395206,"en":"When this companion of yours knew"},{"id":"sayakbay-ms-current145:pdf097:l017","ordinal":395207,"en":"The people’s questioning ended"},{"id":"sayakbay-ms-current145:pdf097:l018","ordinal":395208,"en":"A pouch was hung around his neck"},{"id":"sayakbay-ms-current145:pdf097:l019","ordinal":395209,"en":"So saying, they opened their hands in prayer"},{"id":"sayakbay-ms-current145:pdf097:l020","ordinal":395210,"en":"Pleading to the Creator"},{"id":"sayakbay-ms-current145:pdf097:l021","ordinal":395211,"en":"They held the feast under his rule"},{"id":"sayakbay-ms-current145:pdf097:l023","ordinal":395212,"en":"The people cried out and gathered"},{"id":"sayakbay-ms-current145:pdf097:l026","ordinal":395213,"en":"The people gathered around him"},{"id":"sayakbay-ms-current145:pdf097:l027","ordinal":395214,"en":"Shouting with a mighty roar"},{"id":"sayakbay-ms-current145:pdf097:l028","ordinal":395215,"en":"The people raised an immeasurable tumult"},{"id":"sayakbay-ms-current145:pdf097:l029","ordinal":395216,"en":"Paying no heed to their livestock"},{"id":"sayakbay-ms-current145:pdf097:l030","ordinal":395217,"en":"Slaughtering animals and piling meat"},{"id":"sayakbay-ms-current145:pdf097:l031","ordinal":395218,"en":"At the people’s center slaughtering gray stock"},{"id":"sayakbay-ms-current145:pdf098:l001","ordinal":395219,"en":"Heroes beyond counting"},{"id":"sayakbay-ms-current145:pdf098:l002","ordinal":395220,"en":"Two households moving as one"},{"id":"sayakbay-ms-current145:pdf098:l003","ordinal":395221,"en":"Slaughtering sheep for the contenders"},{"id":"sayakbay-ms-current145:pdf098:l004","ordinal":395222,"en":"Setting the people in order and holding a feast"},{"id":"sayakbay-ms-current145:pdf098:l005","ordinal":395223,"en":"The celebration grew vast"},{"id":"sayakbay-ms-current145:pdf098:l006","ordinal":395224,"en":"Kenen surged toward Kene"},{"id":"sayakbay-ms-current145:pdf098:l007","ordinal":395225,"en":"The arriving people gathered"},{"id":"sayakbay-ms-current145:pdf098:l008","ordinal":395226,"en":"Saying, may his son be a hero"},{"id":"sayakbay-ms-current145:pdf098:l009","ordinal":395227,"en":"They stood with hands raised"},{"id":"sayakbay-ms-current145:pdf098:l010","ordinal":395228,"en":"Cups upon cups of liquor"},{"id":"sayakbay-ms-current145:pdf098:l011","ordinal":395229,"en":"Saying, I am a warrior like you"},{"id":"sayakbay-ms-current145:pdf098:l012","ordinal":395230,"en":"They went about in celebration"},{"id":"sayakbay-ms-current145:pdf098:l013","ordinal":395231,"en":"The feast animals were slaughtered"},{"id":"sayakbay-ms-current145:pdf098:l014","ordinal":395232,"en":"The spoken consent was heard"},{"id":"sayakbay-ms-current145:pdf098:l015","ordinal":395233,"en":"Their old grudges were forgotten"},{"id":"sayakbay-ms-current145:pdf098:l016","ordinal":395234,"en":"Let no price be set above yours"},{"id":"sayakbay-ms-current145:pdf098:l017","ordinal":395235,"en":"Saying, go a little ahead"},{"id":"sayakbay-ms-current145:pdf098:l018","ordinal":395236,"en":"The sword shifted on his shoulder"},{"id":"sayakbay-ms-current145:pdf098:l019","ordinal":395237,"en":"Words flowed from the ground"},{"id":"sayakbay-ms-current145:pdf098:l020","ordinal":395238,"en":"Entering the tumult, they wrestled"},{"id":"sayakbay-ms-current145:pdf098:l021","ordinal":395239,"en":"A spectacle among the beasts"},{"id":"sayakbay-ms-current145:pdf098:l022","ordinal":395240,"en":"They plunged into the commotion"},{"id":"sayakbay-ms-current145:pdf098:l023","ordinal":395241,"en":"They joined in this talk"},{"id":"sayakbay-ms-current145:pdf098:l024","ordinal":395242,"en":"Knowing much without knowing all"},{"id":"sayakbay-ms-current145:pdf098:l025","ordinal":395243,"en":"They kept the words going"},{"id":"sayakbay-ms-current145:pdf098:l026","ordinal":395244,"en":"Companion Joltoy spoke"},{"id":"sayakbay-ms-current145:pdf098:l027","ordinal":395245,"en":"His two wishes were keen"},{"id":"sayakbay-ms-current145:pdf098:l028","ordinal":395246,"en":"They played the kok-boru game"},{"id":"sayakbay-ms-current145:pdf098:l029","ordinal":395247,"en":"Without lagging behind the colts"},{"id":"sayakbay-ms-current145:pdf098:l030","ordinal":395248,"en":"Testing themselves before the onlookers"},{"id":"sayakbay-ms-current145:pdf098:l031","ordinal":395249,"en":"Leading their swift hounds"},{"id":"sayakbay-ms-current145:pdf098:l032","ordinal":395250,"en":"The gray wolf spoke to the people"},{"id":"sayakbay-ms-current145:pdf099:l001","ordinal":395251,"en":"Driving back the raging ones"},{"id":"sayakbay-ms-current145:pdf099:l002","ordinal":395252,"en":"A thousand horses that had not gone out"},{"id":"sayakbay-ms-current145:pdf099:l003","ordinal":395253,"en":"Ninety red racers and camels"},{"id":"sayakbay-ms-current145:pdf099:l004","ordinal":395254,"en":"Loading them upon ninety camels"},{"id":"sayakbay-ms-current145:pdf099:l005","ordinal":395255,"en":"There was precious gold and ornament"},{"id":"sayakbay-ms-current145:pdf099:l006","ordinal":395256,"en":"There were amulets and clamor among the sheep"},{"id":"sayakbay-ms-current145:pdf099:l007","ordinal":395257,"en":"Take the world upon your fingertip"},{"id":"sayakbay-ms-current145:pdf099:l008","ordinal":395258,"en":"Fine posts for tethering horses"},{"id":"sayakbay-ms-current145:pdf099:l009","ordinal":395259,"en":"Fields for racing horses"},{"id":"sayakbay-ms-current145:pdf099:l010","ordinal":395260,"en":"Entrust livestock to livestock"},{"id":"sayakbay-ms-current145:pdf099:l011","ordinal":395261,"en":"Ride together and take my bird"},{"id":"sayakbay-ms-current145:pdf099:l012","ordinal":395262,"en":"Ask from land to land"},{"id":"sayakbay-ms-current145:pdf099:l013","ordinal":395263,"en":"As a father, raise the battle cry"},{"id":"sayakbay-ms-current145:pdf099:l014","ordinal":395264,"en":"Let your voice ring to the sky"}]
