[{"id":"semetey-1-2013:p0871:b005:l015","ordinal":142849,"en":"My cherished lamp—"},{"id":"semetey-1-2013:p0871:b005:l016","ordinal":142850,"en":"Will God strike him down like this?’"},{"id":"semetey-1-2013:p0871:b005:l017","ordinal":142851,"en":"However much Kanykei spoke,"},{"id":"semetey-1-2013:p0871:b005:l018","ordinal":142852,"en":"The offspring of the disobedient one,"},{"id":"semetey-1-2013:p0871:b005:l019","ordinal":142853,"en":"Semetey would not listen."},{"id":"semetey-1-2013:p0871:b005:l020","ordinal":142854,"en":"He remained utterly unconcerned."},{"id":"semetey-1-2013:p0871:b005:l021","ordinal":142855,"en":"Abyke and Kobosh's"},{"id":"semetey-1-2013:p0871:b005:l022","ordinal":142856,"en":"However innumerable their armies,"},{"id":"semetey-1-2013:p0871:b005:l023","ordinal":142857,"en":"He did not consider them worth a thing."},{"id":"semetey-1-2013:p0871:b005:l024","ordinal":142858,"en":"The young lord, the leopard,"},{"id":"semetey-1-2013:p0871:b005:l025","ordinal":142859,"en":"Lay down without a care."},{"id":"semetey-1-2013:p0871:b005:l026","ordinal":142860,"en":"In the gated royal court,"},{"id":"semetey-1-2013:p0871:b005:l027","ordinal":142861,"en":"In the fortress with iron doors,"},{"id":"semetey-1-2013:p0871:b005:l028","ordinal":142862,"en":"Amid the games of girls and brides,"},{"id":"semetey-1-2013:p0871:b005:l029","ordinal":142863,"en":"He lay down there,"},{"id":"semetey-1-2013:p0871:b005:l030","ordinal":142864,"en":"In Chachykei's embrace."},{"id":"semetey-1-2013:p0871:b005:l031","ordinal":142865,"en":"Both his mothers wept,"},{"id":"semetey-1-2013:p0871:b005:l032","ordinal":142866,"en":"Unable to say, ‘Get up, child,’"},{"id":"semetey-1-2013:p0871:b005:l033","ordinal":142867,"en":"The poor child born a goshawk,"},{"id":"semetey-1-2013:p0871:b005:l034","ordinal":142868,"en":"They would not disappoint him."},{"id":"semetey-1-2013:p0871:b005:l035","ordinal":142869,"en":"Unable to say, ‘Oh, child,’"},{"id":"semetey-1-2013:p0871:b005:l036","ordinal":142870,"en":"To the orphan born a lion,"},{"id":"semetey-1-2013:p0872:b003:l001","ordinal":142871,"en":"They would not disappoint him at all."},{"id":"semetey-1-2013:p0872:b003:l002","ordinal":142872,"en":"Both his mothers wept,"},{"id":"semetey-1-2013:p0872:b003:l003","ordinal":142873,"en":"For the support left by Manas,"},{"id":"semetey-1-2013:p0872:b003:l004","ordinal":142874,"en":"Weeping in anxious care."},{"id":"semetey-1-2013:p0872:b003:l005","ordinal":142875,"en":"Your dear mother Kanykei said,"},{"id":"semetey-1-2013:p0872:b003:l006","ordinal":142876,"en":"‘If the villains come and fight,"},{"id":"semetey-1-2013:p0872:b003:l007","ordinal":142877,"en":"What will become of us?"},{"id":"semetey-1-2013:p0872:b003:l008","ordinal":142878,"en":"What will happen to my child gained through mortal suffering?’"},{"id":"semetey-1-2013:p0872:b003:l010","ordinal":142879,"en":"Her hair down her back, divided into ten,"},{"id":"semetey-1-2013:p0872:b003:l011","ordinal":142880,"en":"Was it not your sister-in-law who braided it?"},{"id":"semetey-1-2013:p0872:b003:l012","ordinal":142881,"en":"While magnanimous Manas lived,"},{"id":"semetey-1-2013:p0872:b003:l013","ordinal":142882,"en":"She grappled with all sorts of foes."},{"id":"semetey-1-2013:p0872:b003:l014","ordinal":142883,"en":"To the ways of war, more firmly,"},{"id":"semetey-1-2013:p0872:b003:l015","ordinal":142884,"en":"Was it not your sister-in-law who grew accustomed?"},{"id":"semetey-1-2013:p0872:b003:l016","ordinal":142885,"en":"Fighting against so many lions,"},{"id":"semetey-1-2013:p0872:b003:l017","ordinal":142886,"en":"While Khan Manas lived,"},{"id":"semetey-1-2013:p0872:b003:l018","ordinal":142887,"en":"Was it not your sister-in-law who saw it all?"},{"id":"semetey-1-2013:p0872:b003:l019","ordinal":142888,"en":"Before their army swept upon them,"},{"id":"semetey-1-2013:p0872:b003:l020","ordinal":142889,"en":"Before Abyke, Kobosh and the six villains"},{"id":"semetey-1-2013:p0872:b003:l021","ordinal":142890,"en":"Swept upon them together,"},{"id":"semetey-1-2013:p0872:b003:l022","ordinal":142891,"en":"For Buurul, as great as a camel,"},{"id":"semetey-1-2013:p0872:b003:l023","ordinal":142892,"en":"She had a bridle brought and fastened on."},{"id":"semetey-1-2013:p0872:b003:l024","ordinal":142893,"en":"Its inside worked in silk,"},{"id":"semetey-1-2013:p0872:b003:l025","ordinal":142894,"en":"For seven years she had bitten patterns without pause."},{"id":"semetey-1-2013:p0872:b003:l027","ordinal":142895,"en":"Upon Buurul, as great as a camel,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0872:b003:l028","ordinal":142896,"en":"So that no bullet would strike him,"},{"id":"semetey-1-2013:p0872:b003:l029","ordinal":142897,"en":"She had the protective covering laid."},{"id":"semetey-1-2013:p0872:b003:l030","ordinal":142898,"en":"Above that covering,"},{"id":"semetey-1-2013:p0872:b003:l031","ordinal":142899,"en":"A leather sweatcloth and blue saddle pad"},{"id":"semetey-1-2013:p0872:b003:l032","ordinal":142900,"en":"She laid, crying aloud."},{"id":"semetey-1-2013:p0872:b003:l033","ordinal":142901,"en":"Your dear mother Kanykei"},{"id":"semetey-1-2013:p0872:b003:l034","ordinal":142902,"en":"Sobbed to the one God."},{"id":"semetey-1-2013:p0872:b003:l035","ordinal":142903,"en":"She made ready the equipment,"},{"id":"semetey-1-2013:p0872:b003:l036","ordinal":142904,"en":"‘God, protect my only son!’ she said,"},{"id":"semetey-1-2013:p0872:b003:l037","ordinal":142905,"en":"Pleading with the Creator."},{"id":"semetey-1-2013:p0872:b003:l038","ordinal":142906,"en":"For Buurul, as great as a camel,"},{"id":"semetey-1-2013:p0872:b004:l001","ordinal":142907,"en":"Covered with elephant hide,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0872:b004:l002","ordinal":142908,"en":"For fifteen years in this fashion,"},{"id":"semetey-1-2013:p0872:b004:l003","ordinal":142909,"en":"Mighty Bakai had kept it safe."},{"id":"semetey-1-2013:p0872:b004:l004","ordinal":142910,"en":"Its pommel had never touched the ground;"},{"id":"semetey-1-2013:p0872:b004:l005","ordinal":142911,"en":"No one without ritual ablution had ridden it;"},{"id":"semetey-1-2013:p0872:b004:l006","ordinal":142912,"en":"No stranger knew its worth."},{"id":"semetey-1-2013:p0872:b004:l007","ordinal":142913,"en":"Akkanqy, made by Almambet,"},{"id":"semetey-1-2013:p0872:b004:l008","ordinal":142914,"en":"A saddle fit for the noble steed,"},{"id":"semetey-1-2013:p0872:b004:l009","ordinal":142915,"en":"Its front pommel pure gold,"},{"id":"semetey-1-2013:p0872:b004:l010","ordinal":142916,"en":"Its rear pommel solid silver,"},{"id":"semetey-1-2013:p0872:b004:l011","ordinal":142917,"en":"Its two sides broad iron—"},{"id":"semetey-1-2013:p0872:b004:l012","ordinal":142918,"en":"From the valiant Sultan Alma,"},{"id":"semetey-1-2013:p0872:b004:l013","ordinal":142919,"en":"Akkanqy had remained as a gift."},{"id":"semetey-1-2013:p0872:b004:l014","ordinal":142920,"en":"Fearing the villains,"},{"id":"semetey-1-2013:p0872:b004:l015","ordinal":142921,"en":"Your lion-mother Kanykei"},{"id":"semetey-1-2013:p0872:b004:l016","ordinal":142922,"en":"Saddled the noble steed."},{"id":"semetey-1-2013:p0872:b004:l017","ordinal":142923,"en":"She had it fastened with adornments."},{"id":"semetey-1-2013:p0872:b004:l019","ordinal":142924,"en":"Upon Akkanqy,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0872:b004:l020","ordinal":142925,"en":"She had it fitted and secured."},{"id":"semetey-1-2013:p0872:b004:l021","ordinal":142926,"en":"Its girth was set with jeweled ornaments;"},{"id":"semetey-1-2013:p0872:b004:l022","ordinal":142927,"en":"The broad piece of its crupper"},{"id":"semetey-1-2013:p0872:b004:l023","ordinal":142928,"en":"Bore precious stones and mirrors."},{"id":"semetey-1-2013:p0872:b004:l024","ordinal":142929,"en":"Your dear, unfortunate mother's"},{"id":"semetey-1-2013:p0872:b004:l025","ordinal":142930,"en":"Heart was greatly troubled."},{"id":"semetey-1-2013:p0872:b004:l026","ordinal":142931,"en":"‘My child lying unaware—"},{"id":"semetey-1-2013:p0872:b004:l027","ordinal":142932,"en":"The villains may overwhelm him,"},{"id":"semetey-1-2013:p0872:b004:l028","ordinal":142933,"en":"And his death may come needlessly,’ she thought."},{"id":"semetey-1-2013:p0872:b004:l029","ordinal":142934,"en":"Your dear, fierce mother"},{"id":"semetey-1-2013:p0872:b004:l030","ordinal":142935,"en":"Had not the slightest strength remaining."},{"id":"semetey-1-2013:p0872:b004:l031","ordinal":142936,"en":"‘My precious orphan will ride him,’ she said,"},{"id":"semetey-1-2013:p0872:b004:l032","ordinal":142937,"en":"And prepared the noble steed."},{"id":"semetey-1-2013:p0872:b004:l033","ordinal":142938,"en":"Its collar gold, its sleeves copper,"},{"id":"semetey-1-2013:p0872:b004:l034","ordinal":142939,"en":"Double mail, with dung-pellet-sized rings,"},{"id":"semetey-1-2013:p0872:b004:l035","ordinal":142940,"en":"No spear could pierce it in a lance fight."},{"id":"semetey-1-2013:p0872:b004:l036","ordinal":142941,"en":"‘Let the orphan wear this,’ she said,"},{"id":"semetey-1-2013:p0872:b004:l037","ordinal":142942,"en":"And prepared Akolpok."},{"id":"semetey-1-2013:p0872:b004:l038","ordinal":142943,"en":"Your dear mother Kanykei"},{"id":"semetey-1-2013:p0872:b004:l039","ordinal":142944,"en":"Took Khan Manas's Akkelte—"},{"id":"semetey-1-2013:p0873:b003:l001","ordinal":142945,"en":"That wondrous creature, when slung upon him,"},{"id":"semetey-1-2013:p0873:b003:l002","ordinal":142946,"en":"Was the mirror of his shoulder blade."},{"id":"semetey-1-2013:p0873:b003:l003","ordinal":142947,"en":"When fired at a fighting foe,"},{"id":"semetey-1-2013:p0873:b003:l004","ordinal":142948,"en":"It comforted the life entrusted to him."},{"id":"semetey-1-2013:p0873:b003:l005","ordinal":142949,"en":"The living gun Akkelte—"},{"id":"semetey-1-2013:p0873:b003:l006","ordinal":142950,"en":"Your dear mother Kanykei"},{"id":"semetey-1-2013:p0873:b003:l007","ordinal":142951,"en":"Scraped it with its cleaning tool,"},{"id":"semetey-1-2013:p0873:b003:l008","ordinal":142952,"en":"And rubbed it with red sand."},{"id":"semetey-1-2013:p0873:b003:l009","ordinal":142953,"en":"She worked it with the ramrod,"},{"id":"semetey-1-2013:p0873:b003:l010","ordinal":142954,"en":"Wiping its inside clean."},{"id":"semetey-1-2013:p0873:b003:l011","ordinal":142955,"en":"Your wretched, unfortunate mother"},{"id":"semetey-1-2013:p0873:b003:l012","ordinal":142956,"en":"Took the powder from its box,"},{"id":"semetey-1-2013:p0873:b003:l013","ordinal":142957,"en":"And poured it down with a rumble."},{"id":"semetey-1-2013:p0873:b003:l014","ordinal":142958,"en":"Taking a bullet from the pouch,"},{"id":"semetey-1-2013:p0873:b003:l015","ordinal":142959,"en":"Into Akkelte's mouth"},{"id":"semetey-1-2013:p0873:b003:l016","ordinal":142960,"en":"She drove it with a clatter."},{"id":"semetey-1-2013:p0873:b003:l017","ordinal":142961,"en":"Making the weapons ready,"},{"id":"semetey-1-2013:p0873:b003:l018","ordinal":142962,"en":"Chiyyrdy now held them."},{"id":"semetey-1-2013:p0873:b003:l019","ordinal":142963,"en":"Her black hair, thick as a girth,"},{"id":"semetey-1-2013:p0873:b003:l020","ordinal":142964,"en":"She bound tightly atop her head."},{"id":"semetey-1-2013:p0873:b003:l021","ordinal":142965,"en":"She put on men's clothing,"},{"id":"semetey-1-2013:p0873:b003:l022","ordinal":142966,"en":"And, fearful, recited her prayer."},{"id":"semetey-1-2013:p0873:b003:l023","ordinal":142967,"en":"The Karakashka thoroughbred"},{"id":"semetey-1-2013:p0873:b003:l024","ordinal":142968,"en":"She saddled within the court."},{"id":"semetey-1-2013:p0873:b003:l025","ordinal":142969,"en":"As though about to enter battle,"},{"id":"semetey-1-2013:p0873:b003:l026","ordinal":142970,"en":"Your tiger-mother made ready."},{"id":"semetey-1-2013:p0873:b003:l027","ordinal":142971,"en":"‘Let the quarrel begin with them,’ she said,"},{"id":"semetey-1-2013:p0873:b003:l028","ordinal":142972,"en":"Pleading with the Creator."},{"id":"semetey-1-2013:p0873:b003:l029","ordinal":142973,"en":"Semetey lay sleeping,"},{"id":"semetey-1-2013:p0873:b003:l030","ordinal":142974,"en":"And Kanykei was making ready."},{"id":"semetey-1-2013:p0873:b003:l031","ordinal":142975,"en":"Let us leave them thus,"},{"id":"semetey-1-2013:p0873:b003:l032","ordinal":142976,"en":"And take up the other side."},{"id":"semetey-1-2013:p0873:b003:l033","ordinal":142977,"en":"The red banner with pale markings"},{"id":"semetey-1-2013:p0873:b003:l034","ordinal":142978,"en":"They had the hero Kochkor carry."},{"id":"semetey-1-2013:p0873:b003:l035","ordinal":142979,"en":"Slashing at the rear of the army,"},{"id":"semetey-1-2013:p0873:b003:l036","ordinal":142980,"en":"They had Khan Kobosh drive it onward."},{"id":"semetey-1-2013:p0873:b003:l037","ordinal":142981,"en":"The axemen were on the flank,"},{"id":"semetey-1-2013:p0873:b003:l038","ordinal":142982,"en":"Lion Kobosh at the front,"},{"id":"semetey-1-2013:p0873:b003:l039","ordinal":142983,"en":"White standards and red banners,"},{"id":"semetey-1-2013:p0873:b005:l001","ordinal":142984,"en":"Shouting and roaring tumult."},{"id":"semetey-1-2013:p0873:b005:l002","ordinal":142985,"en":"The marksmen who fired guns"},{"id":"semetey-1-2013:p0873:b005:l003","ordinal":142986,"en":"They separated onto the flank."},{"id":"semetey-1-2013:p0873:b005:l004","ordinal":142987,"en":"With an army of some six thousand,"},{"id":"semetey-1-2013:p0873:b005:l005","ordinal":142988,"en":"Abyke rode along."},{"id":"semetey-1-2013:p0873:b005:l006","ordinal":142989,"en":"His six thousand marksmen"},{"id":"semetey-1-2013:p0873:b005:l007","ordinal":142990,"en":"He set apart upon the hills."},{"id":"semetey-1-2013:p0873:b005:l008","ordinal":142991,"en":"The leader of those marksmen"},{"id":"semetey-1-2013:p0873:b005:l009","ordinal":142992,"en":"Was Abyke."},{"id":"semetey-1-2013:p0873:b005:l010","ordinal":142993,"en":"On the nearer side of them,"},{"id":"semetey-1-2013:p0873:b005:l011","ordinal":142994,"en":"Their horses, every one,"},{"id":"semetey-1-2013:p0873:b005:l012","ordinal":142995,"en":"Were all alike, dun-colored,"},{"id":"semetey-1-2013:p0873:b005:l013","ordinal":142996,"en":"With amulet-shaped marks upon their brows,"},{"id":"semetey-1-2013:p0873:b005:l014","ordinal":142997,"en":"All outstanding, peerless steeds."},{"id":"semetey-1-2013:p0873:b005:l015","ordinal":142998,"en":"Roaring as they sang their olen,"},{"id":"semetey-1-2013:p0873:b005:l016","ordinal":142999,"en":"The Kazakh army formed a separate body."},{"id":"semetey-1-2013:p0873:b005:l017","ordinal":143000,"en":"Having lost their Urbu,"},{"id":"semetey-1-2013:p0873:b005:l018","ordinal":143001,"en":"Sighing and grieving,"},{"id":"semetey-1-2013:p0873:b005:l019","ordinal":143002,"en":"Like clouds about to rain again,"},{"id":"semetey-1-2013:p0873:b005:l020","ordinal":143003,"en":"They wheeled this way and that."},{"id":"semetey-1-2013:p0873:b005:l021","ordinal":143004,"en":"Dark battle-axes and Zulfiqar swords"},{"id":"semetey-1-2013:p0873:b005:l022","ordinal":143005,"en":"They fastened at their sides."},{"id":"semetey-1-2013:p0873:b005:l023","ordinal":143006,"en":"The earth grew misty with their pounding;"},{"id":"semetey-1-2013:p0873:b005:l024","ordinal":143007,"en":"Their cries split stones,"},{"id":"semetey-1-2013:p0873:b005:l025","ordinal":143008,"en":"Their clamorous uproar split heads."},{"id":"semetey-1-2013:p0873:b005:l026","ordinal":143009,"en":"The Kipchak army was a separate body."},{"id":"semetey-1-2013:p0873:b005:l027","ordinal":143010,"en":"Riding Karabair horses,"},{"id":"semetey-1-2013:p0873:b005:l028","ordinal":143011,"en":"Wearing dark coats no bullet could pierce,"},{"id":"semetey-1-2013:p0873:b005:l029","ordinal":143012,"en":"Full of courage, fierce in wrath,"},{"id":"semetey-1-2013:p0873:b005:l030","ordinal":143013,"en":"Leveling all whom they encountered,"},{"id":"semetey-1-2013:p0873:b005:l031","ordinal":143014,"en":"Muzburchak's Buyanbek"},{"id":"semetey-1-2013:p0873:b005:l032","ordinal":143015,"en":"Came straight on with his army,"},{"id":"semetey-1-2013:p0873:b005:l033","ordinal":143016,"en":"He too with four thousand troops."},{"id":"semetey-1-2013:p0873:b005:l034","ordinal":143017,"en":"Alabek of the Six Cities,"},{"id":"semetey-1-2013:p0873:b005:l035","ordinal":143018,"en":"Riding stallions, mules and horses,"},{"id":"semetey-1-2013:p0873:b005:l036","ordinal":143019,"en":"Their beards jutting out,"},{"id":"semetey-1-2013:p0873:b005:l037","ordinal":143020,"en":"They spoke to one another,"},{"id":"semetey-1-2013:p0873:b005:l038","ordinal":143021,"en":"Calling ‘elder brother,’ gathering fervor,"},{"id":"semetey-1-2013:p0873:b005:l039","ordinal":143022,"en":"Making ready, thinking themselves adept,"},{"id":"semetey-1-2013:p0874:b003:l001","ordinal":143023,"en":"Dark maces and battle-axes"},{"id":"semetey-1-2013:p0874:b003:l002","ordinal":143024,"en":"They fastened at their sides."},{"id":"semetey-1-2013:p0874:b003:l003","ordinal":143025,"en":"Their beards spread out,"},{"id":"semetey-1-2013:p0874:b003:l004","ordinal":143026,"en":"Their bare chests showed plainly."},{"id":"semetey-1-2013:p0874:b003:l005","ordinal":143027,"en":"They had their flutes played,"},{"id":"semetey-1-2013:p0874:b003:l006","ordinal":143028,"en":"And the strongmen riding camel saddles"},{"id":"semetey-1-2013:p0874:b003:l007","ordinal":143029,"en":"They all had sing songs."},{"id":"semetey-1-2013:p0874:b003:l008","ordinal":143030,"en":"Alabek swept forward."},{"id":"semetey-1-2013:p0874:b003:l009","ordinal":143031,"en":"Heeding Abyke and Kobosh's"},{"id":"semetey-1-2013:p0874:b003:l010","ordinal":143032,"en":"Words, these men"},{"id":"semetey-1-2013:p0874:b003:l011","ordinal":143033,"en":"Had been struck by Heaven."},{"id":"semetey-1-2013:p0874:b003:l012","ordinal":143034,"en":"Skirting Kum-Kyya,"},{"id":"semetey-1-2013:p0874:b003:l013","ordinal":143035,"en":"They came spreading out."},{"id":"semetey-1-2013:p0874:b003:l014","ordinal":143036,"en":"Swarming like ants,"},{"id":"semetey-1-2013:p0874:b003:l015","ordinal":143037,"en":"They came boiling forth."},{"id":"semetey-1-2013:p0874:b003:l016","ordinal":143038,"en":"All the army, the forty warriors,"},{"id":"semetey-1-2013:p0874:b003:l017","ordinal":143039,"en":"Those dear, seasoned men,"},{"id":"semetey-1-2013:p0874:b003:l018","ordinal":143040,"en":"Were driving forward."},{"id":"semetey-1-2013:p0874:b003:l019","ordinal":143041,"en":"Over the lower slopes of Tash-Moinok,"},{"id":"semetey-1-2013:p0874:b003:l020","ordinal":143042,"en":"They came striding across."},{"id":"semetey-1-2013:p0874:b003:l021","ordinal":143043,"en":"Across the lower slopes of great Talas,"},{"id":"semetey-1-2013:p0874:b003:l022","ordinal":143044,"en":"The vast army swarmed,"},{"id":"semetey-1-2013:p0874:b003:l023","ordinal":143045,"en":"And came sweeping onward."},{"id":"semetey-1-2013:p0874:b003:l024","ordinal":143046,"en":"Spear points bobbed,"},{"id":"semetey-1-2013:p0874:b003:l025","ordinal":143047,"en":"Men's heads jutted up."},{"id":"semetey-1-2013:p0874:b003:l026","ordinal":143048,"en":"The worthless were within,"},{"id":"semetey-1-2013:p0874:b003:l027","ordinal":143049,"en":"The capable upon the flanks."},{"id":"semetey-1-2013:p0874:b003:l028","ordinal":143050,"en":"The would-be fugitives were within,"},{"id":"semetey-1-2013:p0874:b003:l029","ordinal":143051,"en":"The worthy upon the flanks."},{"id":"semetey-1-2013:p0874:b003:l030","ordinal":143052,"en":"The eye could not take them all in—"},{"id":"semetey-1-2013:p0874:b003:l031","ordinal":143053,"en":"God, do not let us see their faces!"},{"id":"semetey-1-2013:p0874:b003:l032","ordinal":143054,"en":"One could not tell who was who."},{"id":"semetey-1-2013:p0874:b003:l034","ordinal":143055,"en":"Look at the teeming multitude!","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0874:b003:l035","ordinal":143056,"en":"Those who marched with flags"},{"id":"semetey-1-2013:p0874:b003:l036","ordinal":143057,"en":"Trampled and churned the earth,"},{"id":"semetey-1-2013:p0874:b003:l037","ordinal":143058,"en":"Upon Manas's only orphan,"},{"id":"semetey-1-2013:p0874:b003:l038","ordinal":143059,"en":"Sweeping as though to devour him."},{"id":"semetey-1-2013:p0874:b003:l039","ordinal":143060,"en":"Striking the war drums with a crash,"},{"id":"semetey-1-2013:p0874:b004:l001","ordinal":143061,"en":"All were struck together by their broken oath."},{"id":"semetey-1-2013:p0874:b004:l002","ordinal":143062,"en":"Abyke and Kobosh drove the army;"},{"id":"semetey-1-2013:p0874:b004:l003","ordinal":143063,"en":"All six villains"},{"id":"semetey-1-2013:p0874:b004:l004","ordinal":143064,"en":"Drove the arriving troops together."},{"id":"semetey-1-2013:p0874:b004:l005","ordinal":143065,"en":"Against Manas's only orphan,"},{"id":"semetey-1-2013:p0874:b004:l006","ordinal":143066,"en":"They meant to rise, bringing misery upon themselves."},{"id":"semetey-1-2013:p0874:b004:l008","ordinal":143067,"en":"God now struck the fools,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0874:b004:l009","ordinal":143068,"en":"As though their bright treasury had been scattered."},{"id":"semetey-1-2013:p0874:b004:l010","ordinal":143069,"en":"The earth grew misty and shimmering."},{"id":"semetey-1-2013:p0874:b004:l011","ordinal":143070,"en":"Toward Semetey's court,"},{"id":"semetey-1-2013:p0874:b004:l012","ordinal":143071,"en":"The army drew near to enter."},{"id":"semetey-1-2013:p0874:b004:l013","ordinal":143072,"en":"Khan Manas's forty warriors"},{"id":"semetey-1-2013:p0874:b004:l014","ordinal":143073,"en":"Were truly struck by God."},{"id":"semetey-1-2013:p0874:b004:l015","ordinal":143074,"en":"They began to waver,"},{"id":"semetey-1-2013:p0874:b004:l016","ordinal":143075,"en":"And fell into dispute."},{"id":"semetey-1-2013:p0874:b004:l017","ordinal":143076,"en":"Divided, they spread about,"},{"id":"semetey-1-2013:p0874:b004:l018","ordinal":143077,"en":"Grasping one another,"},{"id":"semetey-1-2013:p0874:b004:l019","ordinal":143078,"en":"Laying their words before the gathering,"},{"id":"semetey-1-2013:p0874:b004:l020","ordinal":143079,"en":"And raising an uproar."},{"id":"semetey-1-2013:p0874:b004:l021","ordinal":143080,"en":"They divided by their fathers' lines."},{"id":"semetey-1-2013:p0874:b004:l022","ordinal":143081,"en":"Among those warriors who had come,"},{"id":"semetey-1-2013:p0874:b004:l023","ordinal":143082,"en":"The good and honest-hearted"},{"id":"semetey-1-2013:p0874:b004:l024","ordinal":143083,"en":"Shed tears from their eyes."},{"id":"semetey-1-2013:p0874:b004:l025","ordinal":143084,"en":"Gathering by their fathers' lines,"},{"id":"semetey-1-2013:p0874:b004:l026","ordinal":143085,"en":"They began to talk."},{"id":"semetey-1-2013:p0874:b004:l027","ordinal":143086,"en":"Reining in beside one another, they halted,"},{"id":"semetey-1-2013:p0874:b004:l028","ordinal":143087,"en":"And mourned the old days."},{"id":"semetey-1-2013:p0874:b004:l029","ordinal":143088,"en":"They reasoned with each other,"},{"id":"semetey-1-2013:p0874:b004:l031","ordinal":143089,"en":"And stopped midway.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0874:b004:l032","ordinal":143090,"en":"Quite a few of the warriors"},{"id":"semetey-1-2013:p0874:b004:l033","ordinal":143091,"en":"At Abyke and Kobosh"},{"id":"semetey-1-2013:p0874:b004:l034","ordinal":143092,"en":"Hurled the foulest abuse."},{"id":"semetey-1-2013:p0874:b004:l035","ordinal":143093,"en":"Falling into dispute,"},{"id":"semetey-1-2013:p0874:b004:l036","ordinal":143094,"en":"Growing red in the face,"},{"id":"semetey-1-2013:p0874:b004:l037","ordinal":143095,"en":"The forty warriors, in separate groups,"},{"id":"semetey-1-2013:p0874:b004:l038","ordinal":143096,"en":"Stood divided."},{"id":"semetey-1-2013:p0874:b004:l039","ordinal":143097,"en":"The treachery of the villains—"},{"id":"semetey-1-2013:p0875:b003:l001","ordinal":143098,"en":"When it stood revealed,"},{"id":"semetey-1-2013:p0875:b003:l002","ordinal":143099,"en":"Their hearts were greatly troubled,"},{"id":"semetey-1-2013:p0875:b003:l003","ordinal":143100,"en":"And tears flowed from their eyes."},{"id":"semetey-1-2013:p0875:b003:l004","ordinal":143101,"en":"One was Shuutu, with a felt-roof-sized cap,"},{"id":"semetey-1-2013:p0875:b003:l005","ordinal":143102,"en":"One was Yraman's son Yrchy Uul—"},{"id":"semetey-1-2013:p0875:b003:l007","ordinal":143103,"en":"What could that Yrchy Uul do?","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0875:b003:l008","ordinal":143104,"en":"He spoke of the hero Manas, favored by Khizr,"}]
