[{"id":"semetey-1-2013:p0549:b004:l032","ordinal":119041,"en":"She had it sprinkled into those vats."},{"id":"semetey-1-2013:p0549:b004:l033","ordinal":119042,"en":"Aksakalbai's son,"},{"id":"semetey-1-2013:p0549:b004:l034","ordinal":119043,"en":"The strong Sart Aralbai,"},{"id":"semetey-1-2013:p0549:b004:l035","ordinal":119044,"en":"And sixty men with hoes,"},{"id":"semetey-1-2013:p0549:b004:l036","ordinal":119045,"en":"She had them tread the mud."},{"id":"semetey-1-2013:p0549:b004:l037","ordinal":119046,"en":"Levying a tribute upon the Kyrgyz,"},{"id":"semetey-1-2013:p0549:b004:l038","ordinal":119047,"en":"She gathered six thousand gelded goats,"},{"id":"semetey-1-2013:p0549:b004:l039","ordinal":119048,"en":"Slaughtered all six thousand,"},{"id":"semetey-1-2013:p0550:b003:l001","ordinal":119049,"en":"Firing bricks, she built it firmly."},{"id":"semetey-1-2013:p0550:b003:l002","ordinal":119050,"en":"Until six centuries had passed,"},{"id":"semetey-1-2013:p0550:b003:l003","ordinal":119051,"en":"My khan-father's mausoleum"},{"id":"semetey-1-2013:p0550:b003:l004","ordinal":119052,"en":"Was built not to crumble, hey."},{"id":"semetey-1-2013:p0550:b003:l005","ordinal":119053,"en":"Slaughtering seven thousand gelded goats, hey,"},{"id":"semetey-1-2013:p0550:b003:l006","ordinal":119054,"en":"Making a model for the face of the earth,"},{"id":"semetey-1-2013:p0550:b003:l007","ordinal":119055,"en":"She baked bricks and built it strong, hey."},{"id":"semetey-1-2013:p0550:b003:l008","ordinal":119056,"en":"Until seven centuries had passed,"},{"id":"semetey-1-2013:p0550:b003:l009","ordinal":119057,"en":"She built it to stand unbroken, hey."},{"id":"semetey-1-2013:p0550:b003:l010","ordinal":119058,"en":"My valiant mother Kanykei"},{"id":"semetey-1-2013:p0550:b003:l011","ordinal":119059,"en":"Set designs in every place."},{"id":"semetey-1-2013:p0550:b003:l012","ordinal":119060,"en":"My poor, luckless mother"},{"id":"semetey-1-2013:p0550:b003:l013","ordinal":119061,"en":"Made wonders of every kind."},{"id":"semetey-1-2013:p0550:b003:l014","ordinal":119062,"en":"“When the orphan comes tomorrow,"},{"id":"semetey-1-2013:p0550:b003:l015","ordinal":119063,"en":"Let him enter this mausoleum,” she thought."},{"id":"semetey-1-2013:p0550:b003:l016","ordinal":119064,"en":"“Of me, his unfortunate mother,"},{"id":"semetey-1-2013:p0550:b003:l017","ordinal":119065,"en":"Let him know this devotion, hey,” she thought."},{"id":"semetey-1-2013:p0550:b003:l018","ordinal":119066,"en":"“His father's deeds,"},{"id":"semetey-1-2013:p0550:b003:l019","ordinal":119067,"en":"The havoc he wrought in Beijing,"},{"id":"semetey-1-2013:p0550:b003:l020","ordinal":119068,"en":"Let my poor son see them,” she thought."},{"id":"semetey-1-2013:p0550:b003:l021","ordinal":119069,"en":"When my bloodthirsty father died,"},{"id":"semetey-1-2013:p0550:b003:l022","ordinal":119070,"en":"When the people buried my father,"},{"id":"semetey-1-2013:p0550:b003:l023","ordinal":119071,"en":"Sparing none of her wealth,"},{"id":"semetey-1-2013:p0550:b003:l024","ordinal":119072,"en":"My noble, luckless mother"},{"id":"semetey-1-2013:p0550:b003:l025","ordinal":119073,"en":"To Egypt and Baghdad"},{"id":"semetey-1-2013:p0550:b003:l026","ordinal":119074,"en":"To her khoja, my wretched mother,"},{"id":"semetey-1-2013:p0550:b003:l027","ordinal":119075,"en":"Giving him six swift horses,"},{"id":"semetey-1-2013:p0550:b003:l028","ordinal":119076,"en":"Giving him a palm-sized letter,"},{"id":"semetey-1-2013:p0550:b003:l029","ordinal":119077,"en":"And summoned ninety mullahs."},{"id":"semetey-1-2013:p0550:b003:l030","ordinal":119078,"en":"Of the ninety, ten died on the road;"},{"id":"semetey-1-2013:p0550:b003:l031","ordinal":119079,"en":"When eighty arrived safely,"},{"id":"semetey-1-2013:p0550:b003:l032","ordinal":119080,"en":"To my khan-father's treasury,"},{"id":"semetey-1-2013:p0550:b003:l033","ordinal":119081,"en":"When they came to the warriors,"},{"id":"semetey-1-2013:p0550:b003:l034","ordinal":119082,"en":"She had memorial scenes made within."},{"id":"semetey-1-2013:p0550:b003:l035","ordinal":119083,"en":"My father's deeds,"},{"id":"semetey-1-2013:p0550:b003:l036","ordinal":119084,"en":"Leaving not a hair's breadth out,"},{"id":"semetey-1-2013:p0550:b003:l037","ordinal":119085,"en":"She had them all depicted."},{"id":"semetey-1-2013:p0550:b003:l038","ordinal":119086,"en":"At the foot of the threshold,"},{"id":"semetey-1-2013:p0550:b003:l039","ordinal":119087,"en":"By the outer doorway,"},{"id":"semetey-1-2013:p0550:b004:l001","ordinal":119088,"en":"Her mount was Arbuurul;"},{"id":"semetey-1-2013:p0550:b004:l002","ordinal":119089,"en":"My mother's bloody face,"},{"id":"semetey-1-2013:p0550:b004:l003","ordinal":119090,"en":"Her bloodied face torn,"},{"id":"semetey-1-2013:p0550:b004:l004","ordinal":119091,"en":"Her black hair loose"},{"id":"semetey-1-2013:p0550:b004:l005","ordinal":119092,"en":"Upon her drooping dark head—"},{"id":"semetey-1-2013:p0550:b004:l006","ordinal":119093,"en":"Bereft of her bloodthirsty husband,"},{"id":"semetey-1-2013:p0550:b004:l007","ordinal":119094,"en":"My mother at thirty-two,"},{"id":"semetey-1-2013:p0550:b004:l008","ordinal":119095,"en":"Her horse moving at an amble,"},{"id":"semetey-1-2013:p0550:b004:l009","ordinal":119096,"en":"Blood streaming from both cheeks,"},{"id":"semetey-1-2013:p0550:b004:l010","ordinal":119097,"en":"Trickling down below Buurul's knees,"},{"id":"semetey-1-2013:p0550:b004:l011","ordinal":119098,"en":"My poor, impassioned mother's"},{"id":"semetey-1-2013:p0550:b004:l012","ordinal":119099,"en":"Black hair thinning,"},{"id":"semetey-1-2013:p0550:b004:l013","ordinal":119100,"en":"The blood from both my mother's cheeks,"},{"id":"semetey-1-2013:p0550:b004:l014","ordinal":119101,"en":"Upon me, wretched infant in the cradle,"},{"id":"semetey-1-2013:p0550:b004:l015","ordinal":119102,"en":"Poured down along my temples."},{"id":"semetey-1-2013:p0550:b004:l016","ordinal":119103,"en":"Clothed in black, towering there,"},{"id":"semetey-1-2013:p0550:b004:l017","ordinal":119104,"en":"She had herself depicted."},{"id":"semetey-1-2013:p0550:b004:l018","ordinal":119105,"en":"Me reaching for my mother's breast,"},{"id":"semetey-1-2013:p0550:b004:l019","ordinal":119106,"en":"She had me depicted."},{"id":"semetey-1-2013:p0550:b004:l020","ordinal":119107,"en":"Beyond that,"},{"id":"semetey-1-2013:p0550:b004:l021","ordinal":119108,"en":"The two khans, Bakybai and Duulat,"},{"id":"semetey-1-2013:p0550:b004:l022","ordinal":119109,"en":"She had depicted side by side."},{"id":"semetey-1-2013:p0550:b004:l023","ordinal":119110,"en":"Khan Alöökö and Khan Azyz,"},{"id":"semetey-1-2013:p0550:b004:l024","ordinal":119111,"en":"She had them depicted."},{"id":"semetey-1-2013:p0550:b004:l025","ordinal":119112,"en":"The events in Beijing,"},{"id":"semetey-1-2013:p0550:b004:l026","ordinal":119113,"en":"She had them depicted."},{"id":"semetey-1-2013:p0550:b004:l027","ordinal":119114,"en":"The pitch-black flowing"},{"id":"semetey-1-2013:p0550:b004:l028","ordinal":119115,"en":"Blood she had depicted."},{"id":"semetey-1-2013:p0550:b004:l029","ordinal":119116,"en":"The dead lying pale,"},{"id":"semetey-1-2013:p0550:b004:l030","ordinal":119117,"en":"Those souls she had depicted."},{"id":"semetey-1-2013:p0550:b004:l031","ordinal":119118,"en":"Utter slaughter, great devastation,"},{"id":"semetey-1-2013:p0550:b004:l032","ordinal":119119,"en":"The blood she had depicted."},{"id":"semetey-1-2013:p0550:b004:l033","ordinal":119120,"en":"Earth flying, dust burning,"},{"id":"semetey-1-2013:p0550:b004:l034","ordinal":119121,"en":"The dust she had depicted."},{"id":"semetey-1-2013:p0550:b004:l035","ordinal":119122,"en":"Unbelievers and Muslims,"},{"id":"semetey-1-2013:p0550:b004:l036","ordinal":119123,"en":"Standing firm, fighting with spears,"},{"id":"semetey-1-2013:p0550:b004:l037","ordinal":119124,"en":"Those souls she had depicted."},{"id":"semetey-1-2013:p0550:b004:l038","ordinal":119125,"en":"The pictures within the mausoleum"},{"id":"semetey-1-2013:p0550:b004:l039","ordinal":119126,"en":"Semetey stood and saw."},{"id":"semetey-1-2013:p0551:b003:l001","ordinal":119127,"en":"His wretched heart"},{"id":"semetey-1-2013:p0551:b003:l002","ordinal":119128,"en":"Semetey divided among countless thoughts."},{"id":"semetey-1-2013:p0551:b003:l003","ordinal":119129,"en":"When he looked to his left,"},{"id":"semetey-1-2013:p0551:b003:l004","ordinal":119130,"en":"His collarbone throbbed,"},{"id":"semetey-1-2013:p0551:b003:l005","ordinal":119131,"en":"His fleshly heart trembled."},{"id":"semetey-1-2013:p0551:b003:l006","ordinal":119132,"en":"Making Algara rear beneath him,"},{"id":"semetey-1-2013:p0551:b003:l007","ordinal":119133,"en":"Jerking his golden leading rein,"},{"id":"semetey-1-2013:p0551:b003:l008","ordinal":119134,"en":"Sticking out his great boots,"},{"id":"semetey-1-2013:p0551:b003:l009","ordinal":119135,"en":"Holding his neck erect like a cock,"},{"id":"semetey-1-2013:p0551:b003:l010","ordinal":119136,"en":"His spectacles gleaming,"},{"id":"semetey-1-2013:p0551:b003:l011","ordinal":119137,"en":"A coral stone as big as a leather flask"},{"id":"semetey-1-2013:p0551:b003:l012","ordinal":119138,"en":"Glittering upon his head,"},{"id":"semetey-1-2013:p0551:b003:l013","ordinal":119139,"en":"A lacquered pipe with a golden crescent,"},{"id":"semetey-1-2013:p0551:b003:l014","ordinal":119140,"en":"The great Kalcha, big as a hut—"},{"id":"semetey-1-2013:p0551:b003:l015","ordinal":119141,"en":"His eyes were like the beds of lakes,"},{"id":"semetey-1-2013:p0551:b003:l016","ordinal":119142,"en":"His appearance could drain one's life,"},{"id":"semetey-1-2013:p0551:b003:l017","ordinal":119143,"en":"His brow like a hollow holding a lake,"},{"id":"semetey-1-2013:p0551:b003:l018","ordinal":119144,"en":"As though he would swallow anyone who challenged him."},{"id":"semetey-1-2013:p0551:b003:l019","ordinal":119145,"en":"The space between his brows"},{"id":"semetey-1-2013:p0551:b003:l020","ordinal":119146,"en":"Was like an upland pasture where a rich man camped;"},{"id":"semetey-1-2013:p0551:b003:l021","ordinal":119147,"en":"The corners of his two eyes"},{"id":"semetey-1-2013:p0551:b003:l022","ordinal":119148,"en":"Were like graves opened wide."},{"id":"semetey-1-2013:p0551:b003:l023","ordinal":119149,"en":"His mustache standing straight up"},{"id":"semetey-1-2013:p0551:b003:l024","ordinal":119150,"en":"Was like a greased axe handle;"},{"id":"semetey-1-2013:p0551:b003:l025","ordinal":119151,"en":"His dangling nose"},{"id":"semetey-1-2013:p0551:b003:l026","ordinal":119152,"en":"Was like the sheath of a cutlass."},{"id":"semetey-1-2013:p0551:b003:l027","ordinal":119153,"en":"Cotton sash and broad boots,"},{"id":"semetey-1-2013:p0551:b003:l028","ordinal":119154,"en":"Konurbai, khan of the monks,"},{"id":"semetey-1-2013:p0551:b003:l029","ordinal":119155,"en":"That majestic swine himself,"},{"id":"semetey-1-2013:p0551:b003:l030","ordinal":119156,"en":"A fellow skilled among spearmen,"},{"id":"semetey-1-2013:p0551:b003:l031","ordinal":119157,"en":"A mighty fellow who knew the enemy's tricks!"},{"id":"semetey-1-2013:p0551:b003:l033","ordinal":119158,"en":"The wretch's black horse—"},{"id":"semetey-1-2013:p0551:b003:l034","ordinal":119159,"en":"That black horse had"},{"id":"semetey-1-2013:p0551:b003:l035","ordinal":119160,"en":"Wings upon its flanks."},{"id":"semetey-1-2013:p0551:b003:l036","ordinal":119161,"en":"When his wrath was roused,"},{"id":"semetey-1-2013:p0551:b003:l037","ordinal":119162,"en":"All the lands, however many,"},{"id":"semetey-1-2013:p0551:b003:l038","ordinal":119163,"en":"He habitually ground like roasted grain."},{"id":"semetey-1-2013:p0551:b003:l039","ordinal":119164,"en":"His fortunes were complete;"},{"id":"semetey-1-2013:p0551:b004:l001","ordinal":119165,"en":"He was a hero born among the Chinese."},{"id":"semetey-1-2013:p0551:b004:l002","ordinal":119166,"en":"My father who departed for eternity—"},{"id":"semetey-1-2013:p0551:b004:l003","ordinal":119167,"en":"This Kalcha, deceiving him,"},{"id":"semetey-1-2013:p0551:b004:l004","ordinal":119168,"en":"Had indeed the means to bring his death."},{"id":"semetey-1-2013:p0551:b004:l005","ordinal":119169,"en":"That Kalcha, surpassing other men,"},{"id":"semetey-1-2013:p0551:b004:l006","ordinal":119170,"en":"Among round-headed mortals"},{"id":"semetey-1-2013:p0551:b004:l007","ordinal":119171,"en":"Was a being created."},{"id":"semetey-1-2013:p0551:b004:l008","ordinal":119172,"en":"He was a red-walled fortress for China."},{"id":"semetey-1-2013:p0551:b004:l009","ordinal":119173,"en":"Kalcha himself was huge of stature,"},{"id":"semetey-1-2013:p0551:b004:l010","ordinal":119174,"en":"A massive warrior—"},{"id":"semetey-1-2013:p0551:b004:l011","ordinal":119175,"en":"Konurbai, son of Alööke;"},{"id":"semetey-1-2013:p0551:b004:l012","ordinal":119176,"en":"My wretched mother painted him in the picture."},{"id":"semetey-1-2013:p0551:b004:l013","ordinal":119177,"en":"Beyond him,"},{"id":"semetey-1-2013:p0551:b004:l014","ordinal":119178,"en":"Coral plumes and precious coral stones,"},{"id":"semetey-1-2013:p0551:b004:l015","ordinal":119179,"en":"A thousand khans of the lungtung rank"},{"id":"semetey-1-2013:p0551:b004:l016","ordinal":119180,"en":"Among Konurbai's company."},{"id":"semetey-1-2013:p0551:b004:l017","ordinal":119181,"en":"Of the Chinese in sleeveless coats,"},{"id":"semetey-1-2013:p0551:b004:l018","ordinal":119182,"en":"Setting their mighty men apart,"},{"id":"semetey-1-2013:p0551:b004:l019","ordinal":119183,"en":"She painted them in the picture."},{"id":"semetey-1-2013:p0551:b004:l020","ordinal":119184,"en":"Of the Chinese adorned with stones,"},{"id":"semetey-1-2013:p0551:b004:l021","ordinal":119185,"en":"Setting their chosen ones apart,"},{"id":"semetey-1-2013:p0551:b004:l022","ordinal":119186,"en":"She painted them too."},{"id":"semetey-1-2013:p0551:b004:l023","ordinal":119187,"en":"Making the spearmen strain forward,"},{"id":"semetey-1-2013:p0551:b004:l024","ordinal":119188,"en":"Making the swift Chinese foot-runners surge,"},{"id":"semetey-1-2013:p0551:b004:l025","ordinal":119189,"en":"Making the khan of the dog-eaters charge across,"},{"id":"semetey-1-2013:p0551:b004:l027","ordinal":119190,"en":"My mother painted them all."},{"id":"semetey-1-2013:p0551:b004:l028","ordinal":119191,"en":"Those in mail of iron cords,"},{"id":"semetey-1-2013:p0551:b004:l029","ordinal":119192,"en":"All the dagger-handed men,"},{"id":"semetey-1-2013:p0551:b004:l030","ordinal":119193,"en":"Their fleet and skillful horsemen,"},{"id":"semetey-1-2013:p0551:b004:l031","ordinal":119194,"en":"The host of countless Chinese,"},{"id":"semetey-1-2013:p0551:b004:l032","ordinal":119195,"en":"She painted their joining battle."},{"id":"semetey-1-2013:p0551:b004:l033","ordinal":119196,"en":"The great havoc and turmoil,"},{"id":"semetey-1-2013:p0551:b004:l034","ordinal":119197,"en":"She painted their fighting."},{"id":"semetey-1-2013:p0551:b004:l035","ordinal":119198,"en":"The unbelievers were exceedingly many,"},{"id":"semetey-1-2013:p0551:b004:l036","ordinal":119199,"en":"Swarming like ants,"},{"id":"semetey-1-2013:p0551:b004:l037","ordinal":119200,"en":"Seething more thickly than gnats."},{"id":"semetey-1-2013:p0551:b004:l038","ordinal":119201,"en":"Ezkara, khan of the Manchus,"},{"id":"semetey-1-2013:p0551:b004:l039","ordinal":119202,"en":"Wearing a great black coat,"},{"id":"semetey-1-2013:p0552:b003:l001","ordinal":119203,"en":"Riding the great brown horse,"},{"id":"semetey-1-2013:p0552:b003:l002","ordinal":119204,"en":"In the tumultuous fighting"},{"id":"semetey-1-2013:p0552:b003:l003","ordinal":119205,"en":"Carrying the banner."},{"id":"semetey-1-2013:p0552:b003:l004","ordinal":119206,"en":"Behind that army,"},{"id":"semetey-1-2013:p0552:b003:l005","ordinal":119207,"en":"Never ceasing to grapple,"},{"id":"semetey-1-2013:p0552:b003:l006","ordinal":119208,"en":"On the flesh of a whole pig"},{"id":"semetey-1-2013:p0552:b003:l007","ordinal":119209,"en":"Unable to sate himself at a sitting,"},{"id":"semetey-1-2013:p0552:b003:l008","ordinal":119210,"en":"A skillful horseman and swift foot-runner,"},{"id":"semetey-1-2013:p0552:b003:l009","ordinal":119211,"en":"Who emerged when China faced ruin,"},{"id":"semetey-1-2013:p0552:b003:l010","ordinal":119212,"en":"The great wrestler in treasury service,"},{"id":"semetey-1-2013:p0552:b003:l011","ordinal":119213,"en":"Iron-eared Kutan the giant,"},{"id":"semetey-1-2013:p0552:b003:l012","ordinal":119214,"en":"Iron-naveled Kiten the giant,"},{"id":"semetey-1-2013:p0552:b003:l013","ordinal":119215,"en":"Mankush the giant with the remarkable brow,"},{"id":"semetey-1-2013:p0552:b003:l014","ordinal":119216,"en":"Kazan the giant riding Karager,"},{"id":"semetey-1-2013:p0552:b003:l015","ordinal":119217,"en":"And Sazan the giant, skilled in jousting,"},{"id":"semetey-1-2013:p0552:b003:l016","ordinal":119218,"en":"The great Kalmyk Ylama,"},{"id":"semetey-1-2013:p0552:b003:l017","ordinal":119219,"en":"A wrestler like mighty Joloi,"},{"id":"semetey-1-2013:p0552:b003:l018","ordinal":119220,"en":"Shypshaidar, cruel with the whip,"},{"id":"semetey-1-2013:p0552:b003:l019","ordinal":119221,"en":"Börüköz, khan of the Shibe,"},{"id":"semetey-1-2013:p0552:b003:l020","ordinal":119222,"en":"Kanyshai, khan of the Torgut,"},{"id":"semetey-1-2013:p0552:b003:l021","ordinal":119223,"en":"Muzkindik, khan of the Solon,"},{"id":"semetey-1-2013:p0552:b003:l022","ordinal":119224,"en":"Orokkyr, khan of the dog-eaters,"},{"id":"semetey-1-2013:p0552:b003:l023","ordinal":119225,"en":"Tiken the giant, Orokkyr's son,"},{"id":"semetey-1-2013:p0552:b003:l024","ordinal":119226,"en":"Kojojash, Karajoi's son,"},{"id":"semetey-1-2013:p0552:b003:l025","ordinal":119227,"en":"The fighting with these men,"},{"id":"semetey-1-2013:p0552:b003:l026","ordinal":119228,"en":"The crowded battlefield, the great campaign,"},{"id":"semetey-1-2013:p0552:b003:l027","ordinal":119229,"en":"Plunging them in dark blood,"},{"id":"semetey-1-2013:p0552:b003:l028","ordinal":119230,"en":"She painted the blood in the picture."},{"id":"semetey-1-2013:p0552:b003:l029","ordinal":119231,"en":"The great campaign, the many slaughters,"},{"id":"semetey-1-2013:p0552:b003:l030","ordinal":119232,"en":"She painted these too."},{"id":"semetey-1-2013:p0552:b003:l031","ordinal":119233,"en":"Unbelievers and Muslims—"},{"id":"semetey-1-2013:p0552:b003:l032","ordinal":119234,"en":"She painted their clash,"},{"id":"semetey-1-2013:p0552:b003:l033","ordinal":119235,"en":"Drenched in thick blood,"},{"id":"semetey-1-2013:p0552:b003:l034","ordinal":119236,"en":"She painted their fighting."},{"id":"semetey-1-2013:p0552:b003:l035","ordinal":119237,"en":"Spear points clashing,"},{"id":"semetey-1-2013:p0552:b003:l036","ordinal":119238,"en":"Men's heads striking together,"},{"id":"semetey-1-2013:p0552:b003:l037","ordinal":119239,"en":"Their fangs jutting out,"},{"id":"semetey-1-2013:p0552:b003:l038","ordinal":119240,"en":"Horse carcasses falling in mountains,"},{"id":"semetey-1-2013:p0552:b003:l039","ordinal":119241,"en":"Their mustaches bristling,"},{"id":"semetey-1-2013:p0552:b004:l001","ordinal":119242,"en":"Warriors' corpses falling in heaps,"},{"id":"semetey-1-2013:p0552:b004:l002","ordinal":119243,"en":"Earth flying, dust burning,"},{"id":"semetey-1-2013:p0552:b004:l003","ordinal":119244,"en":"She painted the dust in the picture."},{"id":"semetey-1-2013:p0552:b004:l004","ordinal":119245,"en":"Lying dead and twisted,"},{"id":"semetey-1-2013:p0552:b004:l005","ordinal":119246,"en":"She painted the people in the picture."},{"id":"semetey-1-2013:p0552:b004:l006","ordinal":119247,"en":"Hacking with battle-axes,"},{"id":"semetey-1-2013:p0552:b004:l007","ordinal":119248,"en":"Clashing with spears,"},{"id":"semetey-1-2013:p0552:b004:l008","ordinal":119249,"en":"Turning their coursers' heads,"},{"id":"semetey-1-2013:p0552:b004:l009","ordinal":119250,"en":"When the chance came,"},{"id":"semetey-1-2013:p0552:b004:l010","ordinal":119251,"en":"Fighting with swords,"},{"id":"semetey-1-2013:p0552:b004:l011","ordinal":119252,"en":"Seizing collars and pulling,"},{"id":"semetey-1-2013:p0552:b004:l012","ordinal":119253,"en":"At a distance, at one another"},{"id":"semetey-1-2013:p0552:b004:l013","ordinal":119254,"en":"Firing their guns,"},{"id":"semetey-1-2013:p0552:b004:l014","ordinal":119255,"en":"Staring without turning away,"},{"id":"semetey-1-2013:p0552:b004:l015","ordinal":119256,"en":"When they met one another,"},{"id":"semetey-1-2013:p0552:b004:l016","ordinal":119257,"en":"Thrusting home their spears,"},{"id":"semetey-1-2013:p0552:b004:l017","ordinal":119258,"en":"Riding out to joust in single combat,"},{"id":"semetey-1-2013:p0552:b004:l018","ordinal":119259,"en":"Their steel points bending,"},{"id":"semetey-1-2013:p0552:b004:l019","ordinal":119260,"en":"Bloodied and steeped in blood,"},{"id":"semetey-1-2013:p0552:b004:l020","ordinal":119261,"en":"Unbelievers and Muslims,"},{"id":"semetey-1-2013:p0552:b004:l021","ordinal":119262,"en":"Standing their ground and fighting,"},{"id":"semetey-1-2013:p0552:b004:l022","ordinal":119263,"en":"The pitch-black flowing"},{"id":"semetey-1-2013:p0552:b004:l023","ordinal":119264,"en":"She painted the people in the picture."},{"id":"semetey-1-2013:p0552:b004:l024","ordinal":119265,"en":"Fleeing in a fluster,"},{"id":"semetey-1-2013:p0552:b004:l025","ordinal":119266,"en":"She painted the people in the picture."},{"id":"semetey-1-2013:p0552:b004:l026","ordinal":119267,"en":"Many a swift courser's"},{"id":"semetey-1-2013:p0552:b004:l027","ordinal":119268,"en":"Saddle had slipped beneath its belly;"},{"id":"semetey-1-2013:p0552:b004:l028","ordinal":119269,"en":"There were many of these running loose."},{"id":"semetey-1-2013:p0552:b004:l029","ordinal":119270,"en":"“My dear, precious kinsman"},{"id":"semetey-1-2013:p0552:b004:l030","ordinal":119271,"en":"Died in this campaign!” they said;"},{"id":"semetey-1-2013:p0552:b004:l031","ordinal":119272,"en":"There were many of these wailing."},{"id":"semetey-1-2013:p0552:b004:l032","ordinal":119273,"en":"Their cruppers broken,"},{"id":"semetey-1-2013:p0552:b004:l033","ordinal":119274,"en":"Their saddles slipped onto their horses' necks,"},{"id":"semetey-1-2013:p0552:b004:l034","ordinal":119275,"en":"There were many of these in a panic."},{"id":"semetey-1-2013:p0552:b004:l035","ordinal":119276,"en":"Having dropped their spears,"},{"id":"semetey-1-2013:p0552:b004:l036","ordinal":119277,"en":"“Now, if a spearman comes, he will beat us!” they said;"},{"id":"semetey-1-2013:p0552:b004:l037","ordinal":119278,"en":"There were many of these fleeing."},{"id":"semetey-1-2013:p0552:b004:l038","ordinal":119279,"en":"Their saddle girths broken,"},{"id":"semetey-1-2013:p0552:b004:l039","ordinal":119280,"en":"There were many of these in a panic."},{"id":"semetey-1-2013:p0553:b003:l001","ordinal":119281,"en":"Wounded by spear thrusts,"},{"id":"semetey-1-2013:p0553:b003:l002","ordinal":119282,"en":"There were many of these in misery."},{"id":"semetey-1-2013:p0553:b003:l003","ordinal":119283,"en":"Unable to understand the course of the gunfire,"},{"id":"semetey-1-2013:p0553:b003:l004","ordinal":119284,"en":"There were many people blinded."},{"id":"semetey-1-2013:p0553:b003:l005","ordinal":119285,"en":"“This battle will bring slaughter!” they said;"},{"id":"semetey-1-2013:p0553:b003:l006","ordinal":119286,"en":"There were many of these grieving."},{"id":"semetey-1-2013:p0553:b003:l007","ordinal":119287,"en":"Of their arms and legs entirely"},{"id":"semetey-1-2013:p0553:b003:l008","ordinal":119288,"en":"There were many bereft."},{"id":"semetey-1-2013:p0553:b003:l009","ordinal":119289,"en":"The commander of ten bobbing along,"},{"id":"semetey-1-2013:p0553:b003:l010","ordinal":119290,"en":"The commander of fifty standing out,"},{"id":"semetey-1-2013:p0553:b003:l011","ordinal":119291,"en":"The commander of a hundred pounding,"},{"id":"semetey-1-2013:p0553:b003:l012","ordinal":119292,"en":"The commander of a thousand booming."},{"id":"semetey-1-2013:p0553:b003:l013","ordinal":119293,"en":"The sky was clear, the earth overcast;"},{"id":"semetey-1-2013:p0553:b003:l014","ordinal":119294,"en":"Not one blade could be seen upon the ground."},{"id":"semetey-1-2013:p0553:b003:l015","ordinal":119295,"en":"The face of the sun becoming one,"},{"id":"semetey-1-2013:p0553:b003:l016","ordinal":119296,"en":"This battle of Beijing"}]
