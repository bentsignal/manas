[{"id":"manas-2010:p0294:b001:l019","ordinal":13313,"en":"Ezkara on the great brown horse"},{"id":"manas-2010:p0294:b001:l020","ordinal":13314,"en":"Slaughtered them outright."},{"id":"manas-2010:p0294:b001:l021","ordinal":13315,"en":"Scattering the dust of the earth,"},{"id":"manas-2010:p0294:b001:l022","ordinal":13316,"en":"When Ezkara showed his might,"},{"id":"manas-2010:p0294:b001:l023","ordinal":13317,"en":"His roar split the ground,"},{"id":"manas-2010:p0294:b001:l024","ordinal":13318,"en":"His shout deafened ears."},{"id":"manas-2010:p0294:b001:l025","ordinal":13319,"en":"The champions of the Kalmyks,"},{"id":"manas-2010:p0294:b001:l026","ordinal":13320,"en":"Taking clubs as big as houses,"},{"id":"manas-2010:p0294:b001:l027","ordinal":13321,"en":"Rumbled forth from one side."},{"id":"manas-2010:p0294:b001:l028","ordinal":13322,"en":"Dust flew into the sky,"},{"id":"manas-2010:p0294:b001:l029","ordinal":13323,"en":"The troops seethed in a throng,"},{"id":"manas-2010:p0294:b001:l030","ordinal":13324,"en":"The spearheads knocked together."},{"id":"manas-2010:p0294:b001:l031","ordinal":13325,"en":"Swift runners who had never seen a horse,"},{"id":"manas-2010:p0294:b001:l032","ordinal":13326,"en":"Their foot soldiers raced like horses."},{"id":"manas-2010:p0294:b001:l033","ordinal":13327,"en":"Once their khan had unleashed his wrath,"},{"id":"manas-2010:p0294:b001:l034","ordinal":13328,"en":"Could the Chinese fail to surge forth?"},{"id":"manas-2010:p0294:b001:l035","ordinal":13329,"en":"Once their mighty one had given orders,"},{"id":"manas-2010:p0294:b001:l036","ordinal":13330,"en":"Those unbelievers would slaughter—"},{"id":"manas-2010:p0294:b001:l037","ordinal":13331,"en":"Would the God-cursed wretches spare themselves?"},{"id":"manas-2010:p0294:b001:l038","ordinal":13332,"en":"Heads wrapped in black kerchiefs,"},{"id":"manas-2010:p0294:b001:l039","ordinal":13333,"en":"Bobbing upon their backs,"},{"id":"manas-2010:p0294:b001:l040","ordinal":13334,"en":"Hair braided like hand clubs,"},{"id":"manas-2010:p0294:b001:l041","ordinal":13335,"en":"When they surged upon Bilerik,"},{"id":"manas-2010:p0294:b001:l042","ordinal":13336,"en":"The Kalmyk people mingled in."},{"id":"manas-2010:p0294:b001:l043","ordinal":13337,"en":"Ahead of him was roaring;"},{"id":"manas-2010:p0294:b001:l044","ordinal":13338,"en":"The champions of forty Chinese tribes"},{"id":"manas-2010:p0294:b001:l045","ordinal":13339,"en":"Cried their war cries from all sides."},{"id":"manas-2010:p0294:b001:l046","ordinal":13340,"en":"When he had no means left,"},{"id":"manas-2010:p0294:b001:l047","ordinal":13341,"en":"Döödür the archer arrived."},{"id":"manas-2010:p0294:b001:l048","ordinal":13342,"en":"Unable to seize Bilerik,"},{"id":"manas-2010:p0295:b001:l001","ordinal":13343,"en":"Kylzheerde beneath him,"},{"id":"manas-2010:p0295:b001:l002","ordinal":13344,"en":"On one side of its flank,"},{"id":"manas-2010:p0295:b001:l003","ordinal":13345,"en":"Right by the edge of its spleen—"},{"id":"manas-2010:p0295:b001:l004","ordinal":13346,"en":"Fat came from his thumb;"},{"id":"manas-2010:p0295:b001:l005","ordinal":13347,"en":"That swine who drew with all his strength,"},{"id":"manas-2010:p0295:b001:l006","ordinal":13348,"en":"Blood came from his nails."},{"id":"manas-2010:p0295:b001:l007","ordinal":13349,"en":"If you looked at the bow he drew,"},{"id":"manas-2010:p0295:b001:l008","ordinal":13350,"en":"Its string stretched thin as a hair."},{"id":"manas-2010:p0295:b001:l009","ordinal":13351,"en":"There he stood enraged,"},{"id":"manas-2010:p0295:b001:l010","ordinal":13352,"en":"And Kylzheerde, the mighty tulpar,"},{"id":"manas-2010:p0295:b001:l011","ordinal":13353,"en":"He struck with his bow."},{"id":"manas-2010:p0295:b001:l012","ordinal":13354,"en":"The arrow whirred;"},{"id":"manas-2010:p0295:b001:l013","ordinal":13355,"en":"Kylzheerde's side,"},{"id":"manas-2010:p0295:b001:l014","ordinal":13356,"en":"Where it struck, burst apart."},{"id":"manas-2010:p0295:b001:l015","ordinal":13357,"en":"Blood poured out in throbbing streams,"},{"id":"manas-2010:p0295:b001:l016","ordinal":13358,"en":"Mixed with blood and stomach contents;"},{"id":"manas-2010:p0295:b001:l017","ordinal":13359,"en":"From the swine's side"},{"id":"manas-2010:p0295:b001:l018","ordinal":13360,"en":"Dark blood streamed and spurted."},{"id":"manas-2010:p0295:b001:l019","ordinal":13361,"en":"The chestnut stumbled and fell."},{"id":"manas-2010:p0295:b001:l020","ordinal":13362,"en":"Alas, Kylzheerde, taken by the Chinese,"},{"id":"manas-2010:p0295:b001:l021","ordinal":13363,"en":"Its head was thrust into a ditch."},{"id":"manas-2010:p0295:b001:l022","ordinal":13364,"en":"Seen today, gone tomorrow;"},{"id":"manas-2010:p0295:b001:l023","ordinal":13365,"en":"When its claim comes due,"},{"id":"manas-2010:p0295:b001:l024","ordinal":13366,"en":"Such is this unruly world!"},{"id":"manas-2010:p0295:b001:l025","ordinal":13367,"en":"Bilerik spoke these words:"},{"id":"manas-2010:p0295:b001:l026","ordinal":13368,"en":"“My khojas have dwindled;"},{"id":"manas-2010:p0295:b001:l027","ordinal":13369,"en":"Before, I was a great hero."},{"id":"manas-2010:p0295:b001:l028","ordinal":13370,"en":"Parted from the mighty ones,"},{"id":"manas-2010:p0295:b001:l029","ordinal":13371,"en":"I alone am left, forlorn!"},{"id":"manas-2010:p0295:b001:l030","ordinal":13372,"en":"Going hawking and hunting game,"},{"id":"manas-2010:p0295:b001:l031","ordinal":13373,"en":"I had entered a hunt;"},{"id":"manas-2010:p0295:b001:l032","ordinal":13374,"en":"An unhealing torment—"},{"id":"manas-2010:p0295:b001:l033","ordinal":13375,"en":"I had entered a turmoil!"},{"id":"manas-2010:p0295:b001:l034","ordinal":13376,"en":"From which none who come return,"},{"id":"manas-2010:p0295:b001:l035","ordinal":13377,"en":"I had entered such a road;"},{"id":"manas-2010:p0295:b001:l036","ordinal":13378,"en":"Which no man can cross through,"},{"id":"manas-2010:p0295:b001:l037","ordinal":13379,"en":"I had entered such misery!"},{"id":"manas-2010:p0295:b001:l038","ordinal":13380,"en":"Suffering, hardship and disaster,"},{"id":"manas-2010:p0295:b001:l039","ordinal":13381,"en":"I had come to see them."},{"id":"manas-2010:p0295:b001:l040","ordinal":13382,"en":"Those who do not sit to piss,"},{"id":"manas-2010:p0295:b001:l041","ordinal":13383,"en":"Whose sleeves do not touch the ground,"},{"id":"manas-2010:p0295:b001:l042","ordinal":13384,"en":"The unbelievers of a dark religion—"},{"id":"manas-2010:p0295:b001:l043","ordinal":13385,"en":"I had come to die at their hands!"},{"id":"manas-2010:p0295:b001:l044","ordinal":13386,"en":"Of the seething unbelievers,"},{"id":"manas-2010:p0295:b001:l045","ordinal":13387,"en":"Of the enraged heroes,"},{"id":"manas-2010:p0295:b001:l046","ordinal":13388,"en":"I had fallen into their hands!"},{"id":"manas-2010:p0295:b001:l047","ordinal":13389,"en":"However I buck, I cannot escape—"},{"id":"manas-2010:p0295:b001:l048","ordinal":13390,"en":"I had fallen into the unbelievers' net!”"},{"id":"manas-2010:p0296:b001:l001","ordinal":13391,"en":"Saying this, Bilerik,"},{"id":"manas-2010:p0296:b001:l002","ordinal":13392,"en":"His feet slipped from the stirrups,"},{"id":"manas-2010:p0296:b001:l003","ordinal":13393,"en":"His buttocks thrust out from the saddle,"},{"id":"manas-2010:p0296:b001:l004","ordinal":13394,"en":"His two legs dangling,"},{"id":"manas-2010:p0296:b001:l005","ordinal":13395,"en":"His face turned pale and drained."},{"id":"manas-2010:p0296:b001:l006","ordinal":13396,"en":"The tears flowing down both cheeks"},{"id":"manas-2010:p0296:b001:l007","ordinal":13397,"en":"Poured below his collarbones."},{"id":"manas-2010:p0296:b001:l008","ordinal":13398,"en":"Bilerik remained like this;"},{"id":"manas-2010:p0296:b001:l009","ordinal":13399,"en":"Zholoy subjected him to humiliation."},{"id":"manas-2010:p0296:b001:l010","ordinal":13400,"en":"With nets of iron rope,"},{"id":"manas-2010:p0296:b001:l011","ordinal":13401,"en":"Circling, they cast their nets;"},{"id":"manas-2010:p0296:b001:l012","ordinal":13402,"en":"With hands all armed with daggers,"},{"id":"manas-2010:p0296:b001:l013","ordinal":13403,"en":"They attacked with piercing roars."},{"id":"manas-2010:p0296:b001:l014","ordinal":13404,"en":"Ezkara gave his orders,"},{"id":"manas-2010:p0296:b001:l015","ordinal":13405,"en":"Bellowing and shouting,"},{"id":"manas-2010:p0296:b001:l016","ordinal":13406,"en":"“Do not kill him by accident!”"},{"id":"manas-2010:p0296:b001:l017","ordinal":13407,"en":"Calling his champions,"},{"id":"manas-2010:p0296:b001:l018","ordinal":13408,"en":"“Surround him,” he said,"},{"id":"manas-2010:p0296:b001:l019","ordinal":13409,"en":"Put a rawhide head-cap upon his head!"},{"id":"manas-2010:p0296:b001:l020","ordinal":13410,"en":"He has no strength to struggle;"},{"id":"manas-2010:p0296:b001:l021","ordinal":13411,"en":"Bind his hands and feet!"},{"id":"manas-2010:p0296:b001:l022","ordinal":13412,"en":"Tie him onto a mule,"},{"id":"manas-2010:p0296:b001:l023","ordinal":13413,"en":"Drive him toward the kakan!"},{"id":"manas-2010:p0296:b001:l024","ordinal":13414,"en":"The games of wondrous entertainment—"},{"id":"manas-2010:p0296:b001:l025","ordinal":13415,"en":"We have defeated the foe; begin them!"},{"id":"manas-2010:p0296:b001:l026","ordinal":13416,"en":"Ay Jangjung Khan and Kün Jangjung,"},{"id":"manas-2010:p0296:b001:l027","ordinal":13417,"en":"Esenkan in Outer Beijing,"},{"id":"manas-2010:p0296:b001:l028","ordinal":13418,"en":"In the city of Tash-Köpürö,"},{"id":"manas-2010:p0296:b001:l029","ordinal":13419,"en":"My deputy khan Azezil,"},{"id":"manas-2010:p0296:b001:l030","ordinal":13420,"en":"Karykan, the khan of Beijing—"},{"id":"manas-2010:p0296:b001:l031","ordinal":13421,"en":"Drive him and take him to them!"},{"id":"manas-2010:p0296:b001:l032","ordinal":13422,"en":"If you are not dogs, champions,"},{"id":"manas-2010:p0296:b001:l033","ordinal":13423,"en":"Of Beijing's forty Chinese tribes"},{"id":"manas-2010:p0296:b001:l034","ordinal":13424,"en":"Ask for the khanate as your reward!"},{"id":"manas-2010:p0296:b001:l035","ordinal":13425,"en":"Such a man is not encountered,"},{"id":"manas-2010:p0296:b001:l036","ordinal":13426,"en":"A man of this kind is not found."},{"id":"manas-2010:p0296:b001:l037","ordinal":13427,"en":"His strength as a champion is unlike others',"},{"id":"manas-2010:p0296:b001:l038","ordinal":13428,"en":"His bravery is great indeed."},{"id":"manas-2010:p0296:b001:l039","ordinal":13429,"en":"He is a man who has fallen into our hands,"},{"id":"manas-2010:p0296:b001:l040","ordinal":13430,"en":"For the good fortune of Kakanchyn's Beijing"},{"id":"manas-2010:p0296:b001:l041","ordinal":13431,"en":"He has been found,"},{"id":"manas-2010:p0296:b001:l042","ordinal":13432,"en":"A truly outstanding man."},{"id":"manas-2010:p0296:b001:l043","ordinal":13433,"en":"The hare that falls into one's hands—"},{"id":"manas-2010:p0296:b001:l044","ordinal":13434,"en":"Will one prosper who lets it go?"},{"id":"manas-2010:p0296:b001:l045","ordinal":13435,"en":"Of the Buruts who oppose us,"},{"id":"manas-2010:p0296:b001:l046","ordinal":13436,"en":"Of the people called Burut,"},{"id":"manas-2010:p0296:b001:l047","ordinal":13437,"en":"Never sated with begging and drinking,"},{"id":"manas-2010:p0296:b001:l048","ordinal":13438,"en":"Never giving up their greed,"},{"id":"manas-2010:p0297:b001:l001","ordinal":13439,"en":"When driven out in darkness,"},{"id":"manas-2010:p0297:b001:l002","ordinal":13440,"en":"Prowling like wolves,"},{"id":"manas-2010:p0297:b001:l003","ordinal":13441,"en":"Stirring strife and raiding livestock,"},{"id":"manas-2010:p0297:b001:l004","ordinal":13442,"en":"Breaking rules and slaughtering people,"},{"id":"manas-2010:p0297:b001:l005","ordinal":13443,"en":"Setting fire to valley lands,"},{"id":"manas-2010:p0297:b001:l006","ordinal":13444,"en":"Pouring blood into clear water,"},{"id":"manas-2010:p0297:b001:l007","ordinal":13445,"en":"Told to drink water, drinking poison,"},{"id":"manas-2010:p0297:b001:l008","ordinal":13446,"en":"Told to spill blood, spilling stomach contents,"},{"id":"manas-2010:p0297:b001:l009","ordinal":13447,"en":"Unmatched by those who wrestled them from horseback,"},{"id":"manas-2010:p0297:b001:l010","ordinal":13448,"en":"No mortal making them bow in defeat,"},{"id":"manas-2010:p0297:b001:l011","ordinal":13449,"en":"Seeking raids and breaking nations—"},{"id":"manas-2010:p0297:b001:l012","ordinal":13450,"en":"The stock of the battered Kyrgyz,"},{"id":"manas-2010:p0297:b001:l013","ordinal":13451,"en":"Of that downtrodden Kyrgyz people,"},{"id":"manas-2010:p0297:b001:l014","ordinal":13452,"en":"He is their very chief."},{"id":"manas-2010:p0297:b001:l015","ordinal":13453,"en":"He is their dark, seeing eye."},{"id":"manas-2010:p0297:b001:l016","ordinal":13454,"en":"Let us take him and cast him into a pit;"},{"id":"manas-2010:p0297:b001:l017","ordinal":13455,"en":"Of the Kyrgyz who perish in flames,"},{"id":"manas-2010:p0297:b001:l018","ordinal":13456,"en":"Let us seize their daughters!"},{"id":"manas-2010:p0297:b001:l019","ordinal":13457,"en":"The great dungeon forty rope-lengths deep,"},{"id":"manas-2010:p0297:b001:l020","ordinal":13458,"en":"Let us go and throw him into it!"},{"id":"manas-2010:p0297:b001:l021","ordinal":13459,"en":"Of the daughter-damned Buruts,"},{"id":"manas-2010:p0297:b001:l022","ordinal":13460,"en":"Let us take many as tribute!"},{"id":"manas-2010:p0297:b001:l023","ordinal":13461,"en":"If they do not heed your words,"},{"id":"manas-2010:p0297:b001:l024","ordinal":13462,"en":"If they do not give what is demanded,"},{"id":"manas-2010:p0297:b001:l025","ordinal":13463,"en":"Bilerik, who has fallen into our hands,"},{"id":"manas-2010:p0297:b001:l026","ordinal":13464,"en":"Let us cut off his head with a sword,"},{"id":"manas-2010:p0297:b001:l027","ordinal":13465,"en":"Let us smash and split his head!"},{"id":"manas-2010:p0297:b001:l028","ordinal":13466,"en":"Two mighty champions together,"},{"id":"manas-2010:p0297:b001:l029","ordinal":13467,"en":"Knotting a bond about his neck,"},{"id":"manas-2010:p0297:b001:l030","ordinal":13468,"en":"Leading him up and down,"},{"id":"manas-2010:p0297:b001:l031","ordinal":13469,"en":"Let us crush him and take his head!”"},{"id":"manas-2010:p0297:b001:l032","ordinal":13470,"en":"Ezkara spoke these words,"},{"id":"manas-2010:p0297:b001:l033","ordinal":13471,"en":"“This must indeed be done,” he said."},{"id":"manas-2010:p0297:b001:l034","ordinal":13472,"en":"They tied him onto a mule now."},{"id":"manas-2010:p0297:b001:l035","ordinal":13473,"en":"Beads, jeweled hat knobs, coral stones,"},{"id":"manas-2010:p0297:b001:l036","ordinal":13474,"en":"The khan of Zungtung among them,"},{"id":"manas-2010:p0297:b001:l037","ordinal":13475,"en":"There were lords and there were khans,"},{"id":"manas-2010:p0297:b001:l038","ordinal":13476,"en":"There were their mighty men, all of them,"},{"id":"manas-2010:p0297:b001:l039","ordinal":13477,"en":"Ezkara, the khan of the Manchus,"},{"id":"manas-2010:p0297:b001:l040","ordinal":13478,"en":"Ylama from the Sibe,"},{"id":"manas-2010:p0297:b001:l041","ordinal":13479,"en":"Zholoy of the Kalmyks,"},{"id":"manas-2010:p0297:b001:l042","ordinal":13480,"en":"Truly a heroic creature."},{"id":"manas-2010:p0297:b001:l043","ordinal":13481,"en":"When they bound Bilerik,"},{"id":"manas-2010:p0297:b001:l044","ordinal":13482,"en":"Of the Chinese with rank buttons on their caps,"},{"id":"manas-2010:p0297:b001:l045","ordinal":13483,"en":"All their finest men were there."},{"id":"manas-2010:p0297:b001:l046","ordinal":13484,"en":"They had seized the youth,"},{"id":"manas-2010:p0297:b001:l047","ordinal":13485,"en":"They had put him in an iron net,"},{"id":"manas-2010:p0297:b001:l048","ordinal":13486,"en":"They seized him at the waist and folded him,"},{"id":"manas-2010:p0298:b001:l001","ordinal":13487,"en":"They loaded him up toward Beijing."},{"id":"manas-2010:p0298:b001:l002","ordinal":13488,"en":"Roaring with their wrath full,"},{"id":"manas-2010:p0298:b001:l003","ordinal":13489,"en":"All of them, rejoicing,"},{"id":"manas-2010:p0298:b001:l004","ordinal":13490,"en":"Cried their war cry, “Kakay!”"},{"id":"manas-2010:p0298:b001:l005","ordinal":13491,"en":"The surnays blared,"},{"id":"manas-2010:p0298:b001:l006","ordinal":13492,"en":"The brass horns rattled,"},{"id":"manas-2010:p0298:b001:l007","ordinal":13493,"en":"They beat drums and held a feast."},{"id":"manas-2010:p0298:b001:l008","ordinal":13494,"en":"Ezkara was a warrior;"},{"id":"manas-2010:p0298:b001:l009","ordinal":13495,"en":"His Torguts gathered to the last."},{"id":"manas-2010:p0298:b001:l010","ordinal":13496,"en":"The warrior they had bound,"},{"id":"manas-2010:p0298:b001:l011","ordinal":13497,"en":"They put before them and drove him on."},{"id":"manas-2010:p0298:b001:l012","ordinal":13498,"en":"Your resourceful unbeliever Zholoy,"},{"id":"manas-2010:p0298:b001:l013","ordinal":13499,"en":"His dust billowed through the valley."},{"id":"manas-2010:p0298:b001:l014","ordinal":13500,"en":"The many Manchus you have seen"},{"id":"manas-2010:p0298:b001:l015","ordinal":13501,"en":"Shouted as they sang their songs."},{"id":"manas-2010:p0298:b001:l016","ordinal":13502,"en":"Their champions formed a separate band;"},{"id":"manas-2010:p0298:b001:l017","ordinal":13503,"en":"The look of those champions"},{"id":"manas-2010:p0298:b001:l018","ordinal":13504,"en":"Showed their warrior nature."},{"id":"manas-2010:p0298:b001:l019","ordinal":13505,"en":"The champions' appearance was exceptional;"},{"id":"manas-2010:p0298:b001:l020","ordinal":13506,"en":"Gathering his warriors,"},{"id":"manas-2010:p0298:b001:l021","ordinal":13507,"en":"Esenkan had assembled them,"},{"id":"manas-2010:p0298:b001:l022","ordinal":13508,"en":"The renowned one who broke the world."},{"id":"manas-2010:p0298:b001:l023","ordinal":13509,"en":"There were lords and there were khans;"},{"id":"manas-2010:p0298:b001:l024","ordinal":13510,"en":"The one who gathered so many"},{"id":"manas-2010:p0298:b001:l025","ordinal":13511,"en":"Was a knowing, valiant man."},{"id":"manas-2010:p0298:b001:l026","ordinal":13512,"en":"“We have come with Bilerik bound,” they said,"},{"id":"manas-2010:p0298:b001:l027","ordinal":13513,"en":"Sending word ahead of them."},{"id":"manas-2010:p0298:b001:l028","ordinal":13514,"en":"Sixty noblewomen and forty Manchus"},{"id":"manas-2010:p0298:b001:l029","ordinal":13515,"en":"Went to receive the reward for good news."},{"id":"manas-2010:p0298:b001:l030","ordinal":13516,"en":"Outside Esenkan's door,"},{"id":"manas-2010:p0298:b001:l031","ordinal":13517,"en":"He had clean sand spread."},{"id":"manas-2010:p0298:b001:l032","ordinal":13518,"en":"A place to go out for pleasure,"},{"id":"manas-2010:p0298:b001:l033","ordinal":13519,"en":"An immeasurably high tower—"},{"id":"manas-2010:p0298:b001:l034","ordinal":13520,"en":"His kingship was unlike others';"},{"id":"manas-2010:p0298:b001:l035","ordinal":13521,"en":"The daughter-damned one's dominion—"},{"id":"manas-2010:p0298:b001:l036","ordinal":13522,"en":"Esenkan heard the news."},{"id":"manas-2010:p0298:b001:l037","ordinal":13523,"en":"Running to the tower,"},{"id":"manas-2010:p0298:b001:l038","ordinal":13524,"en":"The teeming multitude of troops,"},{"id":"manas-2010:p0298:b001:l039","ordinal":13525,"en":"Before Khan Esenkan,"},{"id":"manas-2010:p0298:b001:l040","ordinal":13526,"en":"Bobbing like young brides,"},{"id":"manas-2010:p0298:b001:l041","ordinal":13527,"en":"Bowed down in obeisance."},{"id":"manas-2010:p0298:b001:l042","ordinal":13528,"en":"Esenkan grew enraged;"},{"id":"manas-2010:p0298:b001:l043","ordinal":13529,"en":"He stood there roaring,"},{"id":"manas-2010:p0298:b001:l044","ordinal":13530,"en":"The many soldiers, countless Torguts,"},{"id":"manas-2010:p0298:b001:l045","ordinal":13531,"en":"Calling them all, leaving none:"},{"id":"manas-2010:p0298:b001:l046","ordinal":13532,"en":"“You marched your army upon a royal court;"},{"id":"manas-2010:p0298:b001:l047","ordinal":13533,"en":"You traveled far, not merely a little!"},{"id":"manas-2010:p0298:b001:l048","ordinal":13534,"en":"Your lords, your chief khans, come,"},{"id":"manas-2010:p0299:b001:l001","ordinal":13535,"en":"My people, so many of you, all come!"},{"id":"manas-2010:p0299:b001:l002","ordinal":13536,"en":"Come, your finest officials with rank buttons on their caps!"},{"id":"manas-2010:p0299:b001:l003","ordinal":13537,"en":"Your mighty men in jackets, come!"},{"id":"manas-2010:p0299:b001:l004","ordinal":13538,"en":"Your men skilled with battle-axes, come!"},{"id":"manas-2010:p0299:b001:l005","ordinal":13539,"en":"Your finest, expert with spears, come!"},{"id":"manas-2010:p0299:b001:l006","ordinal":13540,"en":"You with especially pointed spears, come!"},{"id":"manas-2010:p0299:b001:l007","ordinal":13541,"en":"You with terribly sharp swords, come!"},{"id":"manas-2010:p0299:b001:l008","ordinal":13542,"en":"If seven tümen enemies arrive,"},{"id":"manas-2010:p0299:b001:l009","ordinal":13543,"en":"You who alone thrust a spear, come!"},{"id":"manas-2010:p0299:b001:l010","ordinal":13544,"en":"Leave none behind, all come!"},{"id":"manas-2010:p0299:b001:l011","ordinal":13545,"en":"Your half-Mongol khan, come!"},{"id":"manas-2010:p0299:b001:l012","ordinal":13546,"en":"Your one in a thousand, come!"},{"id":"manas-2010:p0299:b001:l013","ordinal":13547,"en":"Your able cultivators of wisdom, come!"},{"id":"manas-2010:p0299:b001:l014","ordinal":13548,"en":"Your finest who spare no one, come!"},{"id":"manas-2010:p0299:b001:l015","ordinal":13549,"en":"Your precious ones and your elders,"},{"id":"manas-2010:p0299:b001:l016","ordinal":13550,"en":"As though struck by a plague,"},{"id":"manas-2010:p0299:b001:l017","ordinal":13551,"en":"You have surged here without stopping."},{"id":"manas-2010:p0299:b001:l018","ordinal":13552,"en":"All of you posted at the barriers!"},{"id":"manas-2010:p0299:b001:l019","ordinal":13553,"en":"Your able men posted as lookouts,"},{"id":"manas-2010:p0299:b001:l020","ordinal":13554,"en":"Hurrying and flurrying, stumbling in haste,"},{"id":"manas-2010:p0299:b001:l021","ordinal":13555,"en":"You have all come, leaving none behind,"},{"id":"manas-2010:p0299:b001:l022","ordinal":13556,"en":"The finest of your great army."},{"id":"manas-2010:p0299:b001:l023","ordinal":13557,"en":"I go on considering and pondering:"},{"id":"manas-2010:p0299:b001:l024","ordinal":13558,"en":"If we should clash by chance,"},{"id":"manas-2010:p0299:b001:l025","ordinal":13559,"en":"The eighteen thousand worlds,"},{"id":"manas-2010:p0299:b001:l026","ordinal":13560,"en":"The people born upon the earth,"},{"id":"manas-2010:p0299:b001:l027","ordinal":13561,"en":"Sending my executioners to shatter them,"},{"id":"manas-2010:p0299:b001:l028","ordinal":13562,"en":"I intend to rule them alone."},{"id":"manas-2010:p0299:b001:l029","ordinal":13563,"en":"You have come hurrying and flurrying,"},{"id":"manas-2010:p0299:b001:l030","ordinal":13564,"en":"Many champions stumbling in haste,"},{"id":"manas-2010:p0299:b001:l031","ordinal":13565,"en":"You have come trampling my throne,"},{"id":"manas-2010:p0299:b001:l032","ordinal":13566,"en":"Foolish troops, panting—"},{"id":"manas-2010:p0299:b001:l033","ordinal":13567,"en":"What have you seen?”"},{"id":"manas-2010:p0299:b001:l034","ordinal":13568,"en":"Esenkan grew angry,"}]
