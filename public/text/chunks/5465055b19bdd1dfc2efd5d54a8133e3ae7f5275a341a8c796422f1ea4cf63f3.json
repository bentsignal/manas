[{"id":"semetey-1-2013:p0958:b004:l026","ordinal":149249,"en":"Wondrously beautiful, with narrow eyes,"},{"id":"semetey-1-2013:p0958:b004:l028","ordinal":149250,"en":"Someone accompanied him.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0958:b004:l029","ordinal":149251,"en":"Seen from the front,"},{"id":"semetey-1-2013:p0958:b004:l030","ordinal":149252,"en":"He had the awe of six thousand warriors;"},{"id":"semetey-1-2013:p0958:b004:l031","ordinal":149253,"en":"Seen from behind,"},{"id":"semetey-1-2013:p0958:b004:l032","ordinal":149254,"en":"He had the appearance of a dragon."},{"id":"semetey-1-2013:p0958:b004:l033","ordinal":149255,"en":"His face was like oiled wheat,"},{"id":"semetey-1-2013:p0958:b004:l034","ordinal":149256,"en":"His eyes like mist at dusk;"},{"id":"semetey-1-2013:p0958:b004:l035","ordinal":149257,"en":"His right shoulder was broad."},{"id":"semetey-1-2013:p0958:b004:l036","ordinal":149258,"en":"Whenever his fury seized him,"},{"id":"semetey-1-2013:p0958:b004:l037","ordinal":149259,"en":"The eighteen thousand worlds"},{"id":"semetey-1-2013:p0958:b004:l038","ordinal":149260,"en":"He was a warrior who could lay waste."},{"id":"semetey-1-2013:p0958:b004:l039","ordinal":149261,"en":"His brow was high, his wrath was fierce,"}]
