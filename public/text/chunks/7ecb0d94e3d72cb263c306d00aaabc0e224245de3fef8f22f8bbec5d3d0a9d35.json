[{"id":"semetey-1-2013:p0744:b003:l022","ordinal":133889,"en":"We broke through its center and made a road."},{"id":"semetey-1-2013:p0744:b003:l023","ordinal":133890,"en":"We took abundant plunder there."},{"id":"semetey-1-2013:p0744:b003:l024","ordinal":133891,"en":"In those days we made Kakan's people weep."},{"id":"semetey-1-2013:p0744:b003:l025","ordinal":133892,"en":"The Black Chinese and the Manchu—"},{"id":"semetey-1-2013:p0744:b003:l026","ordinal":133893,"en":"We slaughtered and destroyed them all."},{"id":"semetey-1-2013:p0744:b003:l027","ordinal":133894,"en":"We made Kakan's people lament."},{"id":"semetey-1-2013:p0744:b003:l028","ordinal":133895,"en":"Khan Kongurbai and Karykan—"},{"id":"semetey-1-2013:p0744:b003:l029","ordinal":133896,"en":"We openly crippled them thus."},{"id":"semetey-1-2013:p0744:b003:l030","ordinal":133897,"en":"When magnanimous Manas lived,"},{"id":"semetey-1-2013:p0744:b003:l031","ordinal":133898,"en":"From the Six Cities and Kokand"},{"id":"semetey-1-2013:p0744:b003:l032","ordinal":133899,"en":"We took tribute."},{"id":"semetey-1-2013:p0744:b003:l033","ordinal":133900,"en":"When noble Manas lived,"},{"id":"semetey-1-2013:p0744:b003:l034","ordinal":133901,"en":"We used to humble Kokand."},{"id":"semetey-1-2013:p0744:b003:l035","ordinal":133902,"en":"Six thousand ingots and a thousand otter pelts"},{"id":"semetey-1-2013:p0744:b003:l036","ordinal":133903,"en":"We used to take as tribute."},{"id":"semetey-1-2013:p0744:b003:l037","ordinal":133904,"en":"Such were the pleasures we enjoyed;"},{"id":"semetey-1-2013:p0744:b003:l038","ordinal":133905,"en":"Such was the wealth we amassed."},{"id":"semetey-1-2013:p0744:b003:l039","ordinal":133906,"en":"Now, Kobosh, in your time,"},{"id":"semetey-1-2013:p0744:b004:l001","ordinal":133907,"en":"We have become great fools."},{"id":"semetey-1-2013:p0744:b004:l002","ordinal":133908,"en":"Giving us no shit, let alone tribute,"},{"id":"semetey-1-2013:p0744:b004:l003","ordinal":133909,"en":"The Six Cities have gone their own way."},{"id":"semetey-1-2013:p0744:b004:l004","ordinal":133910,"en":"Alas, when Manas lived,"},{"id":"semetey-1-2013:p0744:b004:l005","ordinal":133911,"en":"We raided everywhere and took skilled craftswomen."},{"id":"semetey-1-2013:p0744:b004:l006","ordinal":133912,"en":"We raided the Afghans and took elephants."},{"id":"semetey-1-2013:p0744:b004:l007","ordinal":133913,"en":"We took gold coins loaded on elephants."},{"id":"semetey-1-2013:p0744:b004:l008","ordinal":133914,"en":"We took a thousand dark-eyed women."},{"id":"semetey-1-2013:p0744:b004:l009","ordinal":133915,"en":"When devastating Manas lived,"},{"id":"semetey-1-2013:p0744:b004:l010","ordinal":133916,"en":"When the forty warriors were mighty,"},{"id":"semetey-1-2013:p0744:b004:l011","ordinal":133917,"en":"Why did I not die then?\""},{"id":"semetey-1-2013:p0744:b004:l012","ordinal":133918,"en":"So spoke the hero Shuutu,"},{"id":"semetey-1-2013:p0744:b004:l013","ordinal":133919,"en":"Remembering Khan Manas often,"},{"id":"semetey-1-2013:p0744:b004:l014","ordinal":133920,"en":"Recalling him: \"Do not die, Manas!\""},{"id":"semetey-1-2013:p0744:b004:l015","ordinal":133921,"en":"Voicing his grievance to God,"},{"id":"semetey-1-2013:p0744:b004:l016","ordinal":133922,"en":"He was sobbing bitterly."},{"id":"semetey-1-2013:p0744:b004:l017","ordinal":133923,"en":"That day the forty warriors"},{"id":"semetey-1-2013:p0744:b004:l018","ordinal":133924,"en":"Had drunk liquor and run wild,"},{"id":"semetey-1-2013:p0744:b004:l019","ordinal":133925,"en":"With little thought in their heads,"},{"id":"semetey-1-2013:p0744:b004:l020","ordinal":133926,"en":"Blind drunk,"},{"id":"semetey-1-2013:p0744:b004:l021","ordinal":133927,"en":"The forty warriors lay there."},{"id":"semetey-1-2013:p0744:b004:l022","ordinal":133928,"en":"What could dear Shuutu do?"},{"id":"semetey-1-2013:p0744:b004:l023","ordinal":133929,"en":"Leaving the forty warriors,"},{"id":"semetey-1-2013:p0744:b004:l024","ordinal":133930,"en":"Toward Bakai, visited by Khizr,"},{"id":"semetey-1-2013:p0744:b004:l025","ordinal":133931,"en":"He could be seen coming."},{"id":"semetey-1-2013:p0744:b004:l026","ordinal":133932,"en":"What could poor Shuutu do?"},{"id":"semetey-1-2013:p0744:b004:l027","ordinal":133933,"en":"A man as large as a camel stood on the hill,"},{"id":"semetey-1-2013:p0744:b004:l028","ordinal":133934,"en":"His white beard like fine cambric,"},{"id":"semetey-1-2013:p0744:b004:l029","ordinal":133935,"en":"His white teeth like pistachios,"},{"id":"semetey-1-2013:p0744:b004:l030","ordinal":133936,"en":"His broad ears like shields,"},{"id":"semetey-1-2013:p0744:b004:l031","ordinal":133937,"en":"His wide eyes like the morning star."},{"id":"semetey-1-2013:p0744:b004:l032","ordinal":133938,"en":"His limbs and bones—"},{"id":"semetey-1-2013:p0744:b004:l033","ordinal":133939,"en":"When one looked closely—"},{"id":"semetey-1-2013:p0744:b004:l034","ordinal":133940,"en":"Were unlike those of people today."},{"id":"semetey-1-2013:p0744:b004:l035","ordinal":133941,"en":"Whatever deed one considered,"},{"id":"semetey-1-2013:p0744:b004:l036","ordinal":133942,"en":"Your elder Bakai was outstanding."},{"id":"semetey-1-2013:p0744:b004:l037","ordinal":133943,"en":"Wondering, \"Is that Bakai?\""},{"id":"semetey-1-2013:p0744:b004:l038","ordinal":133944,"en":"Poor Shuutu stood amazed."},{"id":"semetey-1-2013:p0744:b004:l039","ordinal":133945,"en":"When he surveyed his whole appearance,"},{"id":"semetey-1-2013:p0745:b003:l001","ordinal":133946,"en":"His look was unlike Bakai's."},{"id":"semetey-1-2013:p0745:b003:l002","ordinal":133947,"en":"When he gazed and gazed closely,"},{"id":"semetey-1-2013:p0745:b003:l003","ordinal":133948,"en":"His blood had drained; only bones remained."},{"id":"semetey-1-2013:p0745:b003:l004","ordinal":133949,"en":"He seemed to have grown destitute."},{"id":"semetey-1-2013:p0745:b003:l005","ordinal":133950,"en":"The old man Bakai, worn out,"},{"id":"semetey-1-2013:p0745:b003:l006","ordinal":133951,"en":"Seemed to have grown thin."},{"id":"semetey-1-2013:p0745:b003:l007","ordinal":133952,"en":"When leopard Manas had died,"},{"id":"semetey-1-2013:p0745:b003:l008","ordinal":133953,"en":"Bakai had suffered humiliation."},{"id":"semetey-1-2013:p0745:b003:l009","ordinal":133954,"en":"When lord Manas died,"},{"id":"semetey-1-2013:p0745:b003:l010","ordinal":133955,"en":"Great Bakai suffered humiliation."},{"id":"semetey-1-2013:p0745:b003:l011","ordinal":133956,"en":"For twelve years he tended camels;"},{"id":"semetey-1-2013:p0745:b003:l012","ordinal":133957,"en":"Great Bakai suffered oppression."},{"id":"semetey-1-2013:p0745:b003:l013","ordinal":133958,"en":"When Shuutu used to see him,"},{"id":"semetey-1-2013:p0745:b003:l014","ordinal":133959,"en":"The blue-gray winged steed beneath him"},{"id":"semetey-1-2013:p0745:b003:l015","ordinal":133960,"en":"The spotted red and the blue with a mane;"},{"id":"semetey-1-2013:p0745:b003:l016","ordinal":133961,"en":"My noble blue-gray winged steed"},{"id":"semetey-1-2013:p0745:b003:l017","ordinal":133962,"en":"Had not yet been named the short-tailed gray,"},{"id":"semetey-1-2013:p0745:b003:l018","ordinal":133963,"en":"Had not yet acquired that bad name."},{"id":"semetey-1-2013:p0745:b003:l019","ordinal":133964,"en":"Great Bakai upon him"},{"id":"semetey-1-2013:p0745:b003:l020","ordinal":133965,"en":"Grieved as he tended camels."},{"id":"semetey-1-2013:p0745:b003:l021","ordinal":133966,"en":"The blue-gray winged steed beneath him"},{"id":"semetey-1-2013:p0745:b003:l022","ordinal":133967,"en":"Had lost its mane and tail."},{"id":"semetey-1-2013:p0745:b003:l023","ordinal":133968,"en":"It had been named the short-tailed gray;"},{"id":"semetey-1-2013:p0745:b003:l024","ordinal":133969,"en":"It had acquired that bad name."},{"id":"semetey-1-2013:p0745:b003:l025","ordinal":133970,"en":"Bakai, riding upon him,"},{"id":"semetey-1-2013:p0745:b003:l026","ordinal":133971,"en":"Wore a goatskin coat on his body,"},{"id":"semetey-1-2013:p0745:b003:l027","ordinal":133972,"en":"And leather trousers on his backside."},{"id":"semetey-1-2013:p0745:b003:l028","ordinal":133973,"en":"To Bakai, grown destitute,"},{"id":"semetey-1-2013:p0745:b003:l029","ordinal":133974,"en":"Like stars in the sky,"},{"id":"semetey-1-2013:p0745:b003:l030","ordinal":133975,"en":"Shuutu the servant drew close."},{"id":"semetey-1-2013:p0745:b003:l031","ordinal":133976,"en":"To tell him of his sorrows,"},{"id":"semetey-1-2013:p0745:b003:l032","ordinal":133977,"en":"Shuutu the servant greeted him warmly."},{"id":"semetey-1-2013:p0745:b003:l033","ordinal":133978,"en":"When Shuutu saw Bakai,"},{"id":"semetey-1-2013:p0745:b003:l034","ordinal":133979,"en":"His heart was deeply troubled."},{"id":"semetey-1-2013:p0745:b003:l035","ordinal":133980,"en":"What could dear Shuutu do?"},{"id":"semetey-1-2013:p0745:b003:l036","ordinal":133981,"en":"When he saw Khan Bakai,"},{"id":"semetey-1-2013:p0745:b003:l037","ordinal":133982,"en":"Tears poured from his eyes."},{"id":"semetey-1-2013:p0745:b003:l038","ordinal":133983,"en":"His valiant elder Bakai"},{"id":"semetey-1-2013:p0745:b003:l039","ordinal":133984,"en":"Seemed the equal of Mecca."},{"id":"semetey-1-2013:p0745:b005:l001","ordinal":133985,"en":"When he saw Khan Bakai,"},{"id":"semetey-1-2013:p0745:b005:l002","ordinal":133986,"en":"His eyes darted in distress,"},{"id":"semetey-1-2013:p0745:b005:l003","ordinal":133987,"en":"His joints lost all their strength."},{"id":"semetey-1-2013:p0745:b005:l004","ordinal":133988,"en":"He wept bitterly and ached."},{"id":"semetey-1-2013:p0745:b005:l005","ordinal":133989,"en":"These were the words Shuutu spoke:"},{"id":"semetey-1-2013:p0745:b005:l006","ordinal":133990,"en":"\"Peace, peace be upon you, elder!\""},{"id":"semetey-1-2013:p0745:b005:l007","ordinal":133991,"en":"Then Bakai said:"},{"id":"semetey-1-2013:p0745:b005:l008","ordinal":133992,"en":"\"And peace upon you, my son!"},{"id":"semetey-1-2013:p0745:b005:l009","ordinal":133993,"en":"Shall I say I have grown destitute, my son?"},{"id":"semetey-1-2013:p0745:b005:l010","ordinal":133994,"en":"Are your six khan-lords well, my son?"},{"id":"semetey-1-2013:p0745:b005:l012","ordinal":133995,"en":"Here is your destitute Bakai."},{"id":"semetey-1-2013:p0745:b005:l013","ordinal":133996,"en":"Shall I say I wander grieving?"},{"id":"semetey-1-2013:p0745:b005:l014","ordinal":133997,"en":"My grief has vanished from within."},{"id":"semetey-1-2013:p0745:b005:l015","ordinal":133998,"en":"Is that aged Kyrgyl well?"},{"id":"semetey-1-2013:p0745:b005:l016","ordinal":133999,"en":"That aged Kyrgyl will not disappear."},{"id":"semetey-1-2013:p0745:b005:l017","ordinal":134000,"en":"While Tazbaimat remains alive,"},{"id":"semetey-1-2013:p0745:b005:l018","ordinal":134001,"en":"Your affairs, forty warriors, will not improve."},{"id":"semetey-1-2013:p0745:b005:l019","ordinal":134002,"en":"My darling Shuutu, servant,"},{"id":"semetey-1-2013:p0745:b005:l020","ordinal":134003,"en":"I was lord Bakai,"},{"id":"semetey-1-2013:p0745:b005:l021","ordinal":134004,"en":"And you were lord Shuutu."},{"id":"semetey-1-2013:p0745:b005:l022","ordinal":134005,"en":"When lord Manas lived,"},{"id":"semetey-1-2013:p0745:b005:l023","ordinal":134006,"en":"Lordship reached you all."},{"id":"semetey-1-2013:p0745:b005:l024","ordinal":134007,"en":"Humbled by tending camels,"},{"id":"semetey-1-2013:p0745:b005:l025","ordinal":134008,"en":"Tell your old Bakai the truth."},{"id":"semetey-1-2013:p0745:b005:l026","ordinal":134009,"en":"My darling hero Shuutu,"},{"id":"semetey-1-2013:p0745:b005:l027","ordinal":134010,"en":"Is there ill intent in your eyes?"},{"id":"semetey-1-2013:p0745:b005:l028","ordinal":134011,"en":"Is there evasiveness within you?"},{"id":"semetey-1-2013:p0745:b005:l029","ordinal":134012,"en":"Is there deceit in your eyes?"},{"id":"semetey-1-2013:p0745:b005:l030","ordinal":134013,"en":"Is there treachery within you?\""},{"id":"semetey-1-2013:p0745:b005:l031","ordinal":134014,"en":"When Bakai spoke thus,"},{"id":"semetey-1-2013:p0745:b005:l032","ordinal":134015,"en":"Too many cares filled his breast;"},{"id":"semetey-1-2013:p0745:b005:l033","ordinal":134016,"en":"His tears streamed in all directions."},{"id":"semetey-1-2013:p0745:b005:l034","ordinal":134017,"en":"\"My dear khan and elder,"},{"id":"semetey-1-2013:p0745:b005:l035","ordinal":134018,"en":"Listen to my words."},{"id":"semetey-1-2013:p0745:b005:l036","ordinal":134019,"en":"Do not make me weep."},{"id":"semetey-1-2013:p0745:b005:l037","ordinal":134020,"en":"The fetter put on both my hands—"},{"id":"semetey-1-2013:p0745:b005:l038","ordinal":134021,"en":"Do you think it became a hobble?"},{"id":"semetey-1-2013:p0745:b005:l039","ordinal":134022,"en":"Those dogs like ravens,"},{"id":"semetey-1-2013:p0746:b003:l001","ordinal":134023,"en":"Do you think they made me a lord?"},{"id":"semetey-1-2013:p0746:b003:l002","ordinal":134024,"en":"Since my lord Manas passed away,"},{"id":"semetey-1-2013:p0746:b003:l003","ordinal":134025,"en":"May I never prosper if I love a lord!"},{"id":"semetey-1-2013:p0746:b003:l004","ordinal":134026,"en":"Those six God-stricken dogs—"},{"id":"semetey-1-2013:p0746:b003:l005","ordinal":134027,"en":"If I call them lords,"},{"id":"semetey-1-2013:p0746:b003:l006","ordinal":134028,"en":"May I not be a Muslim!"},{"id":"semetey-1-2013:p0746:b003:l007","ordinal":134029,"en":"Is there news, is there word?"},{"id":"semetey-1-2013:p0746:b003:l008","ordinal":134030,"en":"My dear, beloved elder,"},{"id":"semetey-1-2013:p0746:b003:l009","ordinal":134031,"en":"Is there a night like the Night of Power?"},{"id":"semetey-1-2013:p0746:b003:l010","ordinal":134032,"en":"Khan Manas's only son—"},{"id":"semetey-1-2013:p0746:b003:l011","ordinal":134033,"en":"Will the day come when Semetey arrives?"},{"id":"semetey-1-2013:p0746:b003:l012","ordinal":134034,"en":"Elder, have you searched through Bukhara?"},{"id":"semetey-1-2013:p0746:b003:l013","ordinal":134035,"en":"Have you heard news of the orphan?"},{"id":"semetey-1-2013:p0746:b003:l014","ordinal":134036,"en":"Fortunate elder Bakai,"},{"id":"semetey-1-2013:p0746:b003:l015","ordinal":134037,"en":"Like a mighty army when set in front,"},{"id":"semetey-1-2013:p0746:b003:l016","ordinal":134038,"en":"Is there news, is there a night,"},{"id":"semetey-1-2013:p0746:b003:l017","ordinal":134039,"en":"Is there a day when my orphan will come?"},{"id":"semetey-1-2013:p0746:b003:l018","ordinal":134040,"en":"My grieving heart and swollen breast—"},{"id":"semetey-1-2013:p0746:b003:l019","ordinal":134041,"en":"Khan and elder, when will they be soothed?"},{"id":"semetey-1-2013:p0746:b003:l020","ordinal":134042,"en":"When my orphan comes here,"},{"id":"semetey-1-2013:p0746:b003:l021","ordinal":134043,"en":"When will my bleak brow brighten?"},{"id":"semetey-1-2013:p0746:b003:l022","ordinal":134044,"en":"Elder Bakai, my good fortune,"},{"id":"semetey-1-2013:p0746:b003:l023","ordinal":134045,"en":"My darling, my mighty army!"},{"id":"semetey-1-2013:p0746:b003:l024","ordinal":134046,"en":"You are truly Bakai,"},{"id":"semetey-1-2013:p0746:b003:l025","ordinal":134047,"en":"And I am grieving Shuutu."},{"id":"semetey-1-2013:p0746:b003:l026","ordinal":134048,"en":"Humbled by tending camels,"},{"id":"semetey-1-2013:p0746:b003:l027","ordinal":134049,"en":"You were lord Bakai."},{"id":"semetey-1-2013:p0746:b003:l028","ordinal":134050,"en":"With ears that heard far and eyes that saw,"},{"id":"semetey-1-2013:p0746:b003:l029","ordinal":134051,"en":"You were a hero like a saint."},{"id":"semetey-1-2013:p0746:b003:l030","ordinal":134052,"en":"Did you turn toward Bukhara?"},{"id":"semetey-1-2013:p0746:b003:l031","ordinal":134053,"en":"Did you get news of the orphan?"},{"id":"semetey-1-2013:p0746:b003:l032","ordinal":134054,"en":"I burn with sorrow, thinking of sister-in-law Kanykei."},{"id":"semetey-1-2013:p0746:b003:l033","ordinal":134055,"en":"I keep pondering the orphan."},{"id":"semetey-1-2013:p0746:b003:l034","ordinal":134056,"en":"If my orphan lives in safety,"},{"id":"semetey-1-2013:p0746:b003:l035","ordinal":134057,"en":"Twelve years must have passed;"},{"id":"semetey-1-2013:p0746:b003:l036","ordinal":134058,"en":"This year he must be twelve years old."},{"id":"semetey-1-2013:p0746:b003:l037","ordinal":134059,"en":"My khan and elder Bakai, listen:"},{"id":"semetey-1-2013:p0746:b003:l038","ordinal":134060,"en":"Let me count the years;"},{"id":"semetey-1-2013:p0746:b003:l039","ordinal":134061,"en":"Let me count them out for you."},{"id":"semetey-1-2013:p0746:b004:l001","ordinal":134062,"en":"There was Mouse, there was Ox,"},{"id":"semetey-1-2013:p0746:b004:l002","ordinal":134063,"en":"Then Tiger, then Hare,"},{"id":"semetey-1-2013:p0746:b004:l003","ordinal":134064,"en":"There was Fish, there was Snake,"},{"id":"semetey-1-2013:p0746:b004:l004","ordinal":134065,"en":"Then Horse, then Sheep,"},{"id":"semetey-1-2013:p0746:b004:l005","ordinal":134066,"en":"Then Monkey, then Hen,"},{"id":"semetey-1-2013:p0746:b004:l006","ordinal":134067,"en":"Then Dog, then Pig."},{"id":"semetey-1-2013:p0746:b004:l007","ordinal":134068,"en":"My orphan left by Manas"},{"id":"semetey-1-2013:p0746:b004:l008","ordinal":134069,"en":"Must have turned twelve."},{"id":"semetey-1-2013:p0746:b004:l009","ordinal":134070,"en":"This very year, my orphan"},{"id":"semetey-1-2013:p0746:b004:l010","ordinal":134071,"en":"Has grown mature, become a man,"},{"id":"semetey-1-2013:p0746:b004:l011","ordinal":134072,"en":"Become the equal of a hero's son.\""},{"id":"semetey-1-2013:p0746:b004:l012","ordinal":134073,"en":"When hero Shuutu asked about the orphan,"},{"id":"semetey-1-2013:p0746:b004:l013","ordinal":134074,"en":"Then Bakai said:"},{"id":"semetey-1-2013:p0746:b004:l014","ordinal":134075,"en":"\"Ah, my darling Shuutu, servant,"},{"id":"semetey-1-2013:p0746:b004:l015","ordinal":134076,"en":"Today our honor has been restored."},{"id":"semetey-1-2013:p0746:b004:l016","ordinal":134077,"en":"Our exposed flesh has been covered."},{"id":"semetey-1-2013:p0746:b004:l017","ordinal":134078,"en":"When leopard Manas died,"},{"id":"semetey-1-2013:p0746:b004:l018","ordinal":134079,"en":"The steel I held was chipped."},{"id":"semetey-1-2013:p0746:b004:l019","ordinal":134080,"en":"Today I stand here,"},{"id":"semetey-1-2013:p0746:b004:l020","ordinal":134081,"en":"My darling Shuutu, servant,"},{"id":"semetey-1-2013:p0746:b004:l021","ordinal":134082,"en":"My orphan has arrived, grown to maturity."},{"id":"semetey-1-2013:p0746:b004:l022","ordinal":134083,"en":"Before twelve years had passed,"},{"id":"semetey-1-2013:p0746:b004:l023","ordinal":134084,"en":"My darling Shuutu, servant,"},{"id":"semetey-1-2013:p0746:b004:l024","ordinal":134085,"en":"The orphan left by Manas,"},{"id":"semetey-1-2013:p0746:b004:l025","ordinal":134086,"en":"Saying, 'I shall lose my strength,'"},{"id":"semetey-1-2013:p0746:b004:l026","ordinal":134087,"en":"I sent fleeing from Talas on foot."},{"id":"semetey-1-2013:p0746:b004:l027","ordinal":134088,"en":"Saying, 'Those dogs will not let him prosper,'"},{"id":"semetey-1-2013:p0746:b004:l028","ordinal":134089,"en":"I sent him wandering toward Temir."},{"id":"semetey-1-2013:p0746:b004:l029","ordinal":134090,"en":"Old Bakai gazed forlornly."},{"id":"semetey-1-2013:p0746:b004:l030","ordinal":134091,"en":"For twelve years,"},{"id":"semetey-1-2013:p0746:b004:l031","ordinal":134092,"en":"I languished, tending camels."},{"id":"semetey-1-2013:p0746:b004:l032","ordinal":134093,"en":"This very day, Shuutu, servant,"},{"id":"semetey-1-2013:p0746:b004:l033","ordinal":134094,"en":"My orphan came and I recovered."},{"id":"semetey-1-2013:p0746:b004:l034","ordinal":134095,"en":"Good news, Shuutu, good news!"},{"id":"semetey-1-2013:p0746:b004:l035","ordinal":134096,"en":"Led by the six scoundrels, the forty warriors"},{"id":"semetey-1-2013:p0746:b004:l036","ordinal":134097,"en":"Raided my migrating camp at Keng-Kol."},{"id":"semetey-1-2013:p0746:b004:l037","ordinal":134098,"en":"Today, from those swaggering dogs,"},{"id":"semetey-1-2013:p0746:b004:l038","ordinal":134099,"en":"I, Bakai, can gain full satisfaction"},{"id":"semetey-1-2013:p0746:b004:l039","ordinal":134100,"en":"And take my revenge."},{"id":"semetey-1-2013:p0747:b003:l001","ordinal":134101,"en":"All the fools joined together"},{"id":"semetey-1-2013:p0747:b003:l002","ordinal":134102,"en":"They scattered my people from Talas;"},{"id":"semetey-1-2013:p0747:b003:l003","ordinal":134103,"en":"Having no mountain to lean upon,"},{"id":"semetey-1-2013:p0747:b003:l004","ordinal":134104,"en":"I could not settle my grievance with those dogs."},{"id":"semetey-1-2013:p0747:b003:l005","ordinal":134105,"en":"My orphan came, and I was restored."},{"id":"semetey-1-2013:p0747:b003:l006","ordinal":134106,"en":"I joined the ranks again."},{"id":"semetey-1-2013:p0747:b003:l007","ordinal":134107,"en":"The wealth they would not give when asked—"},{"id":"semetey-1-2013:p0747:b003:l008","ordinal":134108,"en":"I shall seize it by force,"},{"id":"semetey-1-2013:p0747:b003:l009","ordinal":134109,"en":"From those sprawled-out dogs"},{"id":"semetey-1-2013:p0747:b003:l010","ordinal":134110,"en":"I'll take a nap in the hood,"},{"id":"semetey-1-2013:p0747:b003:l011","ordinal":134111,"en":"When Bakai spoke thus,"},{"id":"semetey-1-2013:p0747:b003:l012","ordinal":134112,"en":"The hero Shuutu said:"},{"id":"semetey-1-2013:p0747:b003:l013","ordinal":134113,"en":"\"If there is a day that brings us honor,"},{"id":"semetey-1-2013:p0747:b003:l014","ordinal":134114,"en":"If there is such a renowned night,"},{"id":"semetey-1-2013:p0747:b003:l015","ordinal":134115,"en":"Elder Bakai, hear my words!"},{"id":"semetey-1-2013:p0747:b003:l016","ordinal":134116,"en":"This very day hero Kobosh,"},{"id":"semetey-1-2013:p0747:b003:l017","ordinal":134117,"en":"Coughing in great bursts,"},{"id":"semetey-1-2013:p0747:b003:l018","ordinal":134118,"en":"Lifting his head from his bed,"},{"id":"semetey-1-2013:p0747:b003:l019","ordinal":134119,"en":"Like one stricken by God,"},{"id":"semetey-1-2013:p0747:b003:l020","ordinal":134120,"en":"Has lain there, refusing to rise."},{"id":"semetey-1-2013:p0747:b003:l021","ordinal":134121,"en":"Know his lordship by this:"},{"id":"semetey-1-2013:p0747:b003:l022","ordinal":134122,"en":"All the forty warriors,"},{"id":"semetey-1-2013:p0747:b003:l023","ordinal":134123,"en":"The elders with Kyrgyl at their head,"},{"id":"semetey-1-2013:p0747:b003:l024","ordinal":134124,"en":"Those God-stricken dogs"},{"id":"semetey-1-2013:p0747:b003:l025","ordinal":134125,"en":"Have made their lords."},{"id":"semetey-1-2013:p0747:b003:l026","ordinal":134126,"en":"Upon all the forty warriors"},{"id":"semetey-1-2013:p0747:b003:l027","ordinal":134127,"en":"They have brought cruel upheaval."},{"id":"semetey-1-2013:p0747:b003:l028","ordinal":134128,"en":"All the forty warriors"},{"id":"semetey-1-2013:p0747:b003:l029","ordinal":134129,"en":"Can no longer utter a peep."},{"id":"semetey-1-2013:p0747:b003:l030","ordinal":134130,"en":"The damned forty warriors"},{"id":"semetey-1-2013:p0747:b003:l031","ordinal":134131,"en":"Have surrendered their unity."},{"id":"semetey-1-2013:p0747:b003:l032","ordinal":134132,"en":"In the late morning,"},{"id":"semetey-1-2013:p0747:b003:l033","ordinal":134133,"en":"Such are Kobosh's deeds,"},{"id":"semetey-1-2013:p0747:b003:l034","ordinal":134134,"en":"Such is his wicked disposition:"},{"id":"semetey-1-2013:p0747:b003:l035","ordinal":134135,"en":"Barefoot and bareheaded,"},{"id":"semetey-1-2013:p0747:b003:l036","ordinal":134136,"en":"Dear Khan Kobosh comes out."},{"id":"semetey-1-2013:p0747:b003:l037","ordinal":134137,"en":"If he lets out one shout,"},{"id":"semetey-1-2013:p0747:b003:l038","ordinal":134138,"en":"The forty warriors are scared to death."},{"id":"semetey-1-2013:p0747:b003:l039","ordinal":134139,"en":"If you want a spectacle, look here:"},{"id":"semetey-1-2013:p0747:b005:l001","ordinal":134140,"en":"The elders with Kyrgyl at their head"},{"id":"semetey-1-2013:p0747:b005:l002","ordinal":134141,"en":"Run as though they were dying."},{"id":"semetey-1-2013:p0747:b005:l003","ordinal":134142,"en":"When they come close before him,"},{"id":"semetey-1-2013:p0747:b005:l004","ordinal":134143,"en":"Their knees bend to the ground."},{"id":"semetey-1-2013:p0747:b005:l005","ordinal":134144,"en":"Before that fool,"}]
