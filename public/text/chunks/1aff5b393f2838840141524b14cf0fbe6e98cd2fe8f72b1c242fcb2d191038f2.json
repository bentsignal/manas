[{"id":"manas-2010:p0450:b001:l030","ordinal":20737,"en":"For Jakyp's son Manas,"},{"id":"manas-2010:p0450:b001:l031","ordinal":20738,"en":"Blessed Koshoy called out."},{"id":"manas-2010:p0450:b001:l032","ordinal":20739,"en":"When he dreamed that evening,"},{"id":"manas-2010:p0450:b001:l033","ordinal":20740,"en":"Aykhozho's only son,"},{"id":"manas-2010:p0450:b001:l034","ordinal":20741,"en":"Bilerik, came into his thoughts."},{"id":"manas-2010:p0450:b001:l035","ordinal":20742,"en":"“Utter doomsday"},{"id":"manas-2010:p0450:b001:l036","ordinal":20743,"en":"The Chinese brought upon the knowing one."},{"id":"manas-2010:p0450:b001:l037","ordinal":20744,"en":"From the city of Samarkand,"},{"id":"manas-2010:p0450:b001:l038","ordinal":20745,"en":"Jar Manas, Karadöng's son,"},{"id":"manas-2010:p0450:b001:l039","ordinal":20746,"en":"‘This is the true Manas,’ they said,"},{"id":"manas-2010:p0450:b001:l040","ordinal":20747,"en":"And bound him captive."},{"id":"manas-2010:p0450:b001:l041","ordinal":20748,"en":"Against sixty-gated Beijing,"},{"id":"manas-2010:p0450:b001:l042","ordinal":20749,"en":"Unless I turn and wage war,"},{"id":"manas-2010:p0451:b001:l001","ordinal":20750,"en":"The warriors lying bound,"},{"id":"manas-2010:p0451:b001:l002","ordinal":20751,"en":"Unless I untie their hands,"},{"id":"manas-2010:p0451:b001:l003","ordinal":20752,"en":"Shall I die unworthy of Koshoy's name?"},{"id":"manas-2010:p0451:b001:l004","ordinal":20753,"en":"Rather than remain alive,"},{"id":"manas-2010:p0451:b001:l005","ordinal":20754,"en":"Shall I behold Judgment Day!"},{"id":"manas-2010:p0451:b001:l006","ordinal":20755,"en":"Its teapots gold, its tea cheap,"},{"id":"manas-2010:p0451:b001:l007","ordinal":20756,"en":"Filling the belly when one is exhausted,"},{"id":"manas-2010:p0451:b001:l008","ordinal":20757,"en":"Among the Muslim cities"},{"id":"manas-2010:p0451:b001:l009","ordinal":20758,"en":"There is no city like Samarkand."},{"id":"manas-2010:p0451:b001:l010","ordinal":20759,"en":"A blessing bestowed upon the brow,"},{"id":"manas-2010:p0451:b001:l011","ordinal":20760,"en":"Among the Muslim peoples"},{"id":"manas-2010:p0451:b001:l012","ordinal":20761,"en":"There is no boy like its Manas!"},{"id":"manas-2010:p0451:b001:l013","ordinal":20762,"en":"To seventy-doored Beijing,"},{"id":"manas-2010:p0451:b001:l014","ordinal":20763,"en":"Unless I go seven times around,"},{"id":"manas-2010:p0451:b001:l015","ordinal":20764,"en":"Against Chinese like the earth's grass,"},{"id":"manas-2010:p0451:b001:l016","ordinal":20765,"en":"Fighting for seven years,"},{"id":"manas-2010:p0451:b001:l017","ordinal":20766,"en":"The boys in captivity,"},{"id":"manas-2010:p0451:b001:l018","ordinal":20767,"en":"Unless I free and rescue them,"},{"id":"manas-2010:p0451:b001:l019","ordinal":20768,"en":"Let me die unworthy of Koshoy's name!"},{"id":"manas-2010:p0451:b001:l020","ordinal":20769,"en":"Rather than live in humiliation,"},{"id":"manas-2010:p0451:b001:l021","ordinal":20770,"en":"Let me sink away unborn!"},{"id":"manas-2010:p0451:b001:l022","ordinal":20771,"en":"While my beard is white,"},{"id":"manas-2010:p0451:b001:l023","ordinal":20772,"en":"While my last journey is near,"},{"id":"manas-2010:p0451:b001:l024","ordinal":20773,"en":"The Chinese who lie in countless numbers,"},{"id":"manas-2010:p0451:b001:l025","ordinal":20774,"en":"Let me try scattering them!"},{"id":"manas-2010:p0451:b001:l026","ordinal":20775,"en":"Take heed, my people."},{"id":"manas-2010:p0451:b001:l027","ordinal":20776,"en":"Zheti-Özön was our land."},{"id":"manas-2010:p0451:b001:l028","ordinal":20777,"en":"Jakyp's son, young Manas,"},{"id":"manas-2010:p0451:b001:l029","ordinal":20778,"en":"Was a lion born a leopard."},{"id":"manas-2010:p0451:b001:l030","ordinal":20779,"en":"Without tormenting a flourishing people,"},{"id":"manas-2010:p0451:b001:l031","ordinal":20780,"en":"He was a hero who would care for them."},{"id":"manas-2010:p0451:b001:l032","ordinal":20781,"en":"His fortune was complete;"},{"id":"manas-2010:p0451:b001:l033","ordinal":20782,"en":"He was a lion favored by holy protection!"},{"id":"manas-2010:p0451:b001:l034","ordinal":20783,"en":"Grant a time when we may see him."},{"id":"manas-2010:p0451:b001:l035","ordinal":20784,"en":"God, if you created him as a living soul,"},{"id":"manas-2010:p0451:b001:l036","ordinal":20785,"en":"God, keep Manas safe!"},{"id":"manas-2010:p0451:b001:l037","ordinal":20786,"en":"When I, Koshoy, weigh it up,"},{"id":"manas-2010:p0451:b001:l038","ordinal":20787,"en":"Living on without dying,"},{"id":"manas-2010:p0451:b001:l039","ordinal":20788,"en":"What inheritance will I attain?"},{"id":"manas-2010:p0451:b001:l040","ordinal":20789,"en":"Against sixty-gated Beijing,"},{"id":"manas-2010:p0451:b001:l041","ordinal":20790,"en":"I will fire and wage war!"},{"id":"manas-2010:p0451:b001:l042","ordinal":20791,"en":"Born and grown in Altay,"},{"id":"manas-2010:p0452:b001:l001","ordinal":20792,"en":"His fame different, his greatness immense,"},{"id":"manas-2010:p0452:b001:l002","ordinal":20793,"en":"The lion champion Manas,"},{"id":"manas-2010:p0452:b001:l003","ordinal":20794,"en":"Taking him before me,"},{"id":"manas-2010:p0452:b001:l004","ordinal":20795,"en":"From the seething Chinese,"},{"id":"manas-2010:p0452:b001:l005","ordinal":20796,"en":"The boys lying imprisoned"},{"id":"manas-2010:p0452:b001:l006","ordinal":20797,"en":"I will free and rescue."},{"id":"manas-2010:p0452:b001:l007","ordinal":20798,"en":"My adversary is Kakan-Chin,"},{"id":"manas-2010:p0452:b001:l008","ordinal":20799,"en":"My enemy is Bakburchun."},{"id":"manas-2010:p0452:b001:l009","ordinal":20800,"en":"Against the darkly looming Chinese,"},{"id":"manas-2010:p0452:b001:l010","ordinal":20801,"en":"Go straight and level your spears."},{"id":"manas-2010:p0452:b001:l011","ordinal":20802,"en":"For the people who have suffered hardship,"},{"id":"manas-2010:p0452:b001:l012","ordinal":20803,"en":"Sacrifice your lives!"},{"id":"manas-2010:p0452:b001:l013","ordinal":20804,"en":"Against the Black Chinese and Manchus,"},{"id":"manas-2010:p0452:b001:l014","ordinal":20805,"en":"Charge and level your spears."},{"id":"manas-2010:p0452:b001:l015","ordinal":20806,"en":"For the hero lying imprisoned,"},{"id":"manas-2010:p0452:b001:l016","ordinal":20807,"en":"Sacrifice your lives;"},{"id":"manas-2010:p0452:b001:l017","ordinal":20808,"en":"Fire many volleys!"},{"id":"manas-2010:p0452:b001:l018","ordinal":20809,"en":"Jakyp and Akbaltay, driven away,"},{"id":"manas-2010:p0452:b001:l019","ordinal":20810,"en":"Are in Altay, I hear."},{"id":"manas-2010:p0452:b001:l020","ordinal":20811,"en":"Free and rescue them!"},{"id":"manas-2010:p0452:b001:l021","ordinal":20812,"en":"Those kinsmen, unable to find a way,"},{"id":"manas-2010:p0452:b001:l022","ordinal":20813,"en":"Go about lamenting, I hear."},{"id":"manas-2010:p0452:b001:l023","ordinal":20814,"en":"Yesterday, when Manas came,"},{"id":"manas-2010:p0452:b001:l024","ordinal":20815,"en":"The blue-maned one visited by Kydyr,"},{"id":"manas-2010:p0452:b001:l025","ordinal":20816,"en":"To go out and receive him,"},{"id":"manas-2010:p0452:b001:l026","ordinal":20817,"en":"To bring slaughter on the Chinese,"},{"id":"manas-2010:p0452:b001:l027","ordinal":20818,"en":"We chewed white wheat flour,"},{"id":"manas-2010:p0452:b001:l028","ordinal":20819,"en":"We held the holy Quran."},{"id":"manas-2010:p0452:b001:l029","ordinal":20820,"en":"There is sugar tied in a belt."},{"id":"manas-2010:p0452:b001:l030","ordinal":20821,"en":"With Manas the lion, favored by Kydyr,"},{"id":"manas-2010:p0452:b001:l031","ordinal":20822,"en":"I have an oath sworn before God."},{"id":"manas-2010:p0452:b001:l032","ordinal":20823,"en":"We put the day in writing,"},{"id":"manas-2010:p0452:b001:l033","ordinal":20824,"en":"We reckoned the days."},{"id":"manas-2010:p0452:b001:l034","ordinal":20825,"en":"This year I, your uncle Koshoy,"},{"id":"manas-2010:p0452:b001:l035","ordinal":20826,"en":"Will lead a force and gather an army;"},{"id":"manas-2010:p0452:b001:l036","ordinal":20827,"en":"When I gather an army, I will gather plenty.”"},{"id":"manas-2010:p0452:b001:l037","ordinal":20828,"en":"So saying then, your uncle,"},{"id":"manas-2010:p0452:b001:l038","ordinal":20829,"en":"Unable to hold still, prepared,"},{"id":"manas-2010:p0452:b001:l039","ordinal":20830,"en":"Rousing himself like a lion."},{"id":"manas-2010:p0452:b001:l040","ordinal":20831,"en":"Against Beijing of great renown,"},{"id":"manas-2010:p0452:b001:l041","ordinal":20832,"en":"Preparing to lead an army,"},{"id":"manas-2010:p0452:b001:l042","ordinal":20833,"en":"All within his reach who obeyed,"},{"id":"manas-2010:p0453:b001:l001","ordinal":20834,"en":"Who truly recognized him as Koshoy,"},{"id":"manas-2010:p0453:b001:l002","ordinal":20835,"en":"Without stirring up rebellion,"},{"id":"manas-2010:p0453:b001:l003","ordinal":20836,"en":"He gathered without leaving one, they say."},{"id":"manas-2010:p0453:b001:l004","ordinal":20837,"en":"Among the assembled people"},{"id":"manas-2010:p0453:b001:l005","ordinal":20838,"en":"Were heroes, were skillful men,"},{"id":"manas-2010:p0453:b001:l006","ordinal":20839,"en":"Were mighty leaders of the people,"},{"id":"manas-2010:p0453:b001:l007","ordinal":20840,"en":"Were wise men, were elders,"},{"id":"manas-2010:p0453:b001:l008","ordinal":20841,"en":"To campaign against Kakan,"},{"id":"manas-2010:p0453:b001:l009","ordinal":20842,"en":"All the courageous were there."},{"id":"manas-2010:p0453:b001:l010","ordinal":20843,"en":"Dwelling in Eski-Chambyl,"},{"id":"manas-2010:p0453:b001:l011","ordinal":20844,"en":"Long called a mighty hero,"},{"id":"manas-2010:p0453:b001:l012","ordinal":20845,"en":"Whom no man had bent down and defeated,"},{"id":"manas-2010:p0453:b001:l013","ordinal":20846,"en":"The hero Buudayyk was there."},{"id":"manas-2010:p0453:b001:l014","ordinal":20847,"en":"Dwelling in Sary-Arka,"},{"id":"manas-2010:p0453:b001:l015","ordinal":20848,"en":"Called a weighty, formidable hero,"},{"id":"manas-2010:p0453:b001:l016","ordinal":20849,"en":"Aydarkan of the Kazakhs,"},{"id":"manas-2010:p0453:b001:l017","ordinal":20850,"en":"His dust billowing from the valley,"},{"id":"manas-2010:p0453:b001:l018","ordinal":20851,"en":"Shouting out his songs,"},{"id":"manas-2010:p0453:b001:l019","ordinal":20852,"en":"The hero Aydarkan was there too."},{"id":"manas-2010:p0453:b001:l020","ordinal":20853,"en":"The giants of Zheti-Özön,"},{"id":"manas-2010:p0453:b001:l021","ordinal":20854,"en":"Your accomplished uncle Koshoy"},{"id":"manas-2010:p0453:b001:l022","ordinal":20855,"en":"Had gathered them completely."},{"id":"manas-2010:p0453:b001:l023","ordinal":20856,"en":"Making Chech-Töbö his camping ground,"},{"id":"manas-2010:p0453:b001:l024","ordinal":20857,"en":"All the mighty giants,"},{"id":"manas-2010:p0453:b001:l025","ordinal":20858,"en":"Your uncle Koshoy then"},{"id":"manas-2010:p0453:b001:l026","ordinal":20859,"en":"Had led onward in a guarded column."},{"id":"manas-2010:p0453:b001:l027","ordinal":20860,"en":"The earth stirred, the army filled the land."},{"id":"manas-2010:p0453:b001:l028","ordinal":20861,"en":"When they counted the people,"},{"id":"manas-2010:p0453:b001:l029","ordinal":20862,"en":"When they entered the people in writing,"},{"id":"manas-2010:p0453:b001:l030","ordinal":20863,"en":"The army numbered twelve thousand."},{"id":"manas-2010:p0453:b001:l031","ordinal":20864,"en":"A great mullah from Bukhara,"},{"id":"manas-2010:p0453:b001:l032","ordinal":20865,"en":"Aykhozho from Andijan,"},{"id":"manas-2010:p0453:b001:l033","ordinal":20866,"en":"Winding his sash as a turban,"},{"id":"manas-2010:p0453:b001:l034","ordinal":20867,"en":"Praying to the Almighty,"},{"id":"manas-2010:p0453:b001:l035","ordinal":20868,"en":"“If my death has come, I will die."},{"id":"manas-2010:p0453:b001:l036","ordinal":20869,"en":"If death has not yet come,"},{"id":"manas-2010:p0453:b001:l037","ordinal":20870,"en":"For this army of Koshoy"},{"id":"manas-2010:p0453:b001:l038","ordinal":20871,"en":"I will serve as imam,” he said."},{"id":"manas-2010:p0453:b001:l039","ordinal":20872,"en":"His name was Aykhozho."},{"id":"manas-2010:p0453:b001:l040","ordinal":20873,"en":"Taking a tulpar from the swift horses,"},{"id":"manas-2010:p0453:b001:l041","ordinal":20874,"en":"Your uncle Koshoy then"},{"id":"manas-2010:p0453:b001:l042","ordinal":20875,"en":"Received the holy elder's blessing."},{"id":"manas-2010:p0454:b001:l001","ordinal":20876,"en":"The earth split, the army filled the land."},{"id":"manas-2010:p0454:b001:l002","ordinal":20877,"en":"Taking abundant travel provisions,"},{"id":"manas-2010:p0454:b001:l003","ordinal":20878,"en":"From the river valley then,"},{"id":"manas-2010:p0454:b001:l004","ordinal":20879,"en":"Taking an army that bent the earth,"},{"id":"manas-2010:p0454:b001:l005","ordinal":20880,"en":"Taking camels loaded with provisions,"},{"id":"manas-2010:p0454:b001:l006","ordinal":20881,"en":"Your uncle Koshoy then,"},{"id":"manas-2010:p0454:b001:l007","ordinal":20882,"en":"Taking giants ready to grapple,"},{"id":"manas-2010:p0454:b001:l008","ordinal":20883,"en":"Taking tulpars from the swift horses,"},{"id":"manas-2010:p0454:b001:l009","ordinal":20884,"en":"Receiving a blessing from the caliph,"},{"id":"manas-2010:p0454:b001:l010","ordinal":20885,"en":"His tasselled standard fluttering,"},{"id":"manas-2010:p0454:b001:l011","ordinal":20886,"en":"Your leopard uncle Koshoy"},{"id":"manas-2010:p0454:b001:l012","ordinal":20887,"en":"Had prepared and ridden forth."},{"id":"manas-2010:p0454:b001:l013","ordinal":20888,"en":"He did not spend a day's time idly,"},{"id":"manas-2010:p0454:b001:l014","ordinal":20889,"en":"He did not rest by day."},{"id":"manas-2010:p0454:b001:l015","ordinal":20890,"en":"In the marshes of Central Beijing,"},{"id":"manas-2010:p0454:b001:l016","ordinal":20891,"en":"Esenkan's great army"},{"id":"manas-2010:p0454:b001:l017","ordinal":20892,"en":"With Manas then"},{"id":"manas-2010:p0454:b001:l018","ordinal":20893,"en":"Was battling to destruction."},{"id":"manas-2010:p0454:b001:l019","ordinal":20894,"en":"Esenkan's envoys,"},{"id":"manas-2010:p0454:b001:l020","ordinal":20895,"en":"His guards who watched the gates,"},{"id":"manas-2010:p0454:b001:l021","ordinal":20896,"en":"The steel-doored gateways'"},{"id":"manas-2010:p0454:b001:l022","ordinal":20897,"en":"Openers, pullers, and closers—"},{"id":"manas-2010:p0454:b001:l023","ordinal":20898,"en":"Not one of them remained."},{"id":"manas-2010:p0454:b001:l024","ordinal":20899,"en":"Jar Manas and Bilerik,"},{"id":"manas-2010:p0454:b001:l025","ordinal":20900,"en":"At the place where they lay in the pit,"},{"id":"manas-2010:p0454:b001:l026","ordinal":20901,"en":"Your champion uncle, hero Koshoy,"},{"id":"manas-2010:p0454:b001:l027","ordinal":20902,"en":"Watching patrols and scouting the land,"},{"id":"manas-2010:p0454:b001:l028","ordinal":20903,"en":"Resourceful Koshoy had arrived."},{"id":"manas-2010:p0454:b001:l029","ordinal":20904,"en":"Twelve sentries, forty guards,"},{"id":"manas-2010:p0454:b001:l030","ordinal":20905,"en":"Your uncle Koshoy, favored by Kydyr,"},{"id":"manas-2010:p0454:b001:l031","ordinal":20906,"en":"Had destroyed and slaughtered them."},{"id":"manas-2010:p0454:b001:l032","ordinal":20907,"en":"The two in the dungeon,"},{"id":"manas-2010:p0454:b001:l033","ordinal":20908,"en":"Your resourceful uncle Koshoy"},{"id":"manas-2010:p0454:b001:l034","ordinal":20909,"en":"Had pulled out of the pit."},{"id":"manas-2010:p0454:b001:l035","ordinal":20910,"en":"Twelve white cloths, four shrouds—"},{"id":"manas-2010:p0454:b001:l036","ordinal":20911,"en":"Koshoy had no fear of wearing them."},{"id":"manas-2010:p0454:b001:l037","ordinal":20912,"en":"A ridge like a saddle's rise,"},{"id":"manas-2010:p0454:b001:l038","ordinal":20913,"en":"Koshoy had no fear of crossing it."},{"id":"manas-2010:p0454:b001:l039","ordinal":20914,"en":"From the iron-rope net,"},{"id":"manas-2010:p0454:b001:l040","ordinal":20915,"en":"Jar Manas and Bilerik"},{"id":"manas-2010:p0454:b001:l041","ordinal":20916,"en":"He had freed and rescued."},{"id":"manas-2010:p0454:b001:l042","ordinal":20917,"en":"From Esenkan's hands,"},{"id":"manas-2010:p0455:b001:l001","ordinal":20918,"en":"“To ride in my splendor,"},{"id":"manas-2010:p0455:b001:l002","ordinal":20919,"en":"This will be my pacer,” he said."},{"id":"manas-2010:p0455:b001:l003","ordinal":20920,"en":"“I have freed the boys;"},{"id":"manas-2010:p0455:b001:l004","ordinal":20921,"en":"This will be my booty,” he said."},{"id":"manas-2010:p0455:b001:l005","ordinal":20922,"en":"Of the bazaar that lay bound,"},{"id":"manas-2010:p0455:b001:l006","ordinal":20923,"en":"Hero Koshoy opened its fortune."},{"id":"manas-2010:p0455:b001:l007","ordinal":20924,"en":"Of the boys who had been bound,"},{"id":"manas-2010:p0455:b001:l008","ordinal":20925,"en":"Hero Koshoy untied their hands."},{"id":"manas-2010:p0455:b001:l009","ordinal":20926,"en":"Of paradise untrodden by people,"},{"id":"manas-2010:p0455:b001:l010","ordinal":20927,"en":"Hero Koshoy opened the door."},{"id":"manas-2010:p0455:b001:l011","ordinal":20928,"en":"Of paradise no one could see,"},{"id":"manas-2010:p0455:b001:l012","ordinal":20929,"en":"Hero Koshoy beheld the place of honor."},{"id":"manas-2010:p0455:b001:l013","ordinal":20930,"en":"A great sign for those who heard,"},{"id":"manas-2010:p0455:b001:l014","ordinal":20931,"en":"Hero Koshoy left it behind."},{"id":"manas-2010:p0455:b001:l015","ordinal":20932,"en":"Dividing its gold as booty,"},{"id":"manas-2010:p0455:b001:l016","ordinal":20933,"en":"Hero Koshoy loaded it and came out."},{"id":"manas-2010:p0455:b001:l017","ordinal":20934,"en":"A merciless onslaught,"},{"id":"manas-2010:p0455:b001:l018","ordinal":20935,"en":"Hero Koshoy unleashed and came out."},{"id":"manas-2010:p0455:b001:l019","ordinal":20936,"en":"The boys lying in the pit,"},{"id":"manas-2010:p0455:b001:l020","ordinal":20937,"en":"Freed into the world,"},{"id":"manas-2010:p0455:b001:l021","ordinal":20938,"en":"Hero Koshoy brought them out."},{"id":"manas-2010:p0455:b001:l022","ordinal":20939,"en":"Soldiers gathered, the army moved."},{"id":"manas-2010:p0455:b001:l023","ordinal":20940,"en":"Your uncle Koshoy then,"},{"id":"manas-2010:p0455:b001:l024","ordinal":20941,"en":"Kerkabylan and Taytoru,"},{"id":"manas-2010:p0455:b001:l025","ordinal":20942,"en":"Riding the two horses in turn,"},{"id":"manas-2010:p0455:b001:l026","ordinal":20943,"en":"An elder of prophetic bearing,"},{"id":"manas-2010:p0455:b001:l027","ordinal":20944,"en":"Your forefather, saintly Koshoy,"},{"id":"manas-2010:p0455:b001:l028","ordinal":20945,"en":"Showed that he was a champion."},{"id":"manas-2010:p0455:b001:l029","ordinal":20946,"en":"Beneath Bilerik,"},{"id":"manas-2010:p0455:b001:l030","ordinal":20947,"en":"Taken from the Chinese,"},{"id":"manas-2010:p0455:b001:l031","ordinal":20948,"en":"He placed Koyonboz as a mount."},{"id":"manas-2010:p0455:b001:l032","ordinal":20949,"en":"Spurring onward, he had waged battle."},{"id":"manas-2010:p0455:b001:l033","ordinal":20950,"en":"Esenkan's Telzheerde,"},{"id":"manas-2010:p0455:b001:l034","ordinal":20951,"en":"When he slaughtered the guards,"},{"id":"manas-2010:p0455:b001:l035","ordinal":20952,"en":"Your formidable uncle Koshoy"},{"id":"manas-2010:p0455:b001:l036","ordinal":20953,"en":"Had taken as booty."},{"id":"manas-2010:p0455:b001:l037","ordinal":20954,"en":"Showing himself a lion,"},{"id":"manas-2010:p0455:b001:l038","ordinal":20955,"en":"To Karadöng's Jar Manas"},{"id":"manas-2010:p0455:b001:l039","ordinal":20956,"en":"He gave that horse to ride."},{"id":"manas-2010:p0455:b001:l040","ordinal":20957,"en":"When the two souls came into his hands,"},{"id":"manas-2010:p0455:b001:l041","ordinal":20958,"en":"He cleared every frown,"},{"id":"manas-2010:p0455:b001:l042","ordinal":20959,"en":"He scattered every sorrow."},{"id":"manas-2010:p0456:b001:l001","ordinal":20960,"en":"The hungry bellies were filled."},{"id":"manas-2010:p0456:b001:l002","ordinal":20961,"en":"Your uncle Koshoy then"},{"id":"manas-2010:p0456:b001:l003","ordinal":20962,"en":"Banished every sorrow."},{"id":"manas-2010:p0456:b001:l004","ordinal":20963,"en":"To the near side of Beijing"},{"id":"manas-2010:p0456:b001:l005","ordinal":20964,"en":"Hero Koshoy had come out,"},{"id":"manas-2010:p0456:b001:l006","ordinal":20965,"en":"To the edge of the mountain where tea was gathered."},{"id":"manas-2010:p0456:b001:l007","ordinal":20966,"en":"When he reached the open plain,"},{"id":"manas-2010:p0456:b001:l008","ordinal":20967,"en":"Your uncle Koshoy was a hero."},{"id":"manas-2010:p0456:b001:l009","ordinal":20968,"en":"Measuring it to fit the camp cauldron,"},{"id":"manas-2010:p0456:b001:l010","ordinal":20969,"en":"He had a hearth-pit dug."},{"id":"manas-2010:p0456:b001:l011","ordinal":20970,"en":"As moon-hoofed offerings then,"},{"id":"manas-2010:p0456:b001:l012","ordinal":20971,"en":"He had two hundred mares slaughtered."},{"id":"manas-2010:p0456:b001:l013","ordinal":20972,"en":"Swiftly invoking Baabedin,"},{"id":"manas-2010:p0456:b001:l014","ordinal":20973,"en":"Devising thoughts no man could find,"},{"id":"manas-2010:p0456:b001:l015","ordinal":20974,"en":"Your uncle on the open plain"},{"id":"manas-2010:p0456:b001:l016","ordinal":20975,"en":"Held an exceedingly great feast."},{"id":"manas-2010:p0456:b001:l017","ordinal":20976,"en":"When bright dawn advanced,"},{"id":"manas-2010:p0456:b001:l018","ordinal":20977,"en":"When light touched the earth,"},{"id":"manas-2010:p0456:b001:l019","ordinal":20978,"en":"Roaring in fury,"},{"id":"manas-2010:p0456:b001:l020","ordinal":20979,"en":"Calling the champions,"},{"id":"manas-2010:p0456:b001:l021","ordinal":20980,"en":"Making known what was unknown,"},{"id":"manas-2010:p0456:b001:l022","ordinal":20981,"en":"The learned elder Koshoy,"},{"id":"manas-2010:p0456:b001:l023","ordinal":20982,"en":"Making perceived what was unperceived,"},{"id":"manas-2010:p0456:b001:l024","ordinal":20983,"en":"The falcon, saintly Koshoy:"},{"id":"manas-2010:p0456:b001:l025","ordinal":20984,"en":"“Aykhozho in a motley robe,"},{"id":"manas-2010:p0456:b001:l026","ordinal":20985,"en":"Great mullah of Bukhara,"},{"id":"manas-2010:p0456:b001:l027","ordinal":20986,"en":"You too stand here."},{"id":"manas-2010:p0456:b001:l028","ordinal":20987,"en":"Gathering soldiers, assembling an army,"},{"id":"manas-2010:p0456:b001:l029","ordinal":20988,"en":"You heroes also stand here."},{"id":"manas-2010:p0456:b001:l030","ordinal":20989,"en":"Leopards among spearmen,"},{"id":"manas-2010:p0456:b001:l031","ordinal":20990,"en":"You skillful men stand here."},{"id":"manas-2010:p0456:b001:l032","ordinal":20991,"en":"Knowing well the enemy's stratagems,"},{"id":"manas-2010:p0456:b001:l033","ordinal":20992,"en":"You mighty men stand here!"}]
