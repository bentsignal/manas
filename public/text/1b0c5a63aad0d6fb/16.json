[{"id":"manas-2010:p0101:b002:l032","ordinal":4097,"en":"He is the boy who will free their hands."},{"id":"manas-2010:p0101:b002:l033","ordinal":4098,"en":"For people living in sorrow,"},{"id":"manas-2010:p0101:b002:l034","ordinal":4099,"en":"He is the boy who will find their grief."},{"id":"manas-2010:p0101:b002:l035","ordinal":4100,"en":"Against the swarming unbelievers,"},{"id":"manas-2010:p0101:b002:l036","ordinal":4101,"en":"He is the lion who will wage holy war."},{"id":"manas-2010:p0101:b002:l037","ordinal":4102,"en":"The poor people in Altai,"},{"id":"manas-2010:p0101:b002:l038","ordinal":4103,"en":"If Manas lives and grows,"},{"id":"manas-2010:p0101:b002:l039","ordinal":4104,"en":"He is the lion who will free them."},{"id":"manas-2010:p0101:b002:l040","ordinal":4105,"en":"You saw it before, Jakyp;"},{"id":"manas-2010:p0101:b002:l041","ordinal":4106,"en":"Do you remember?"},{"id":"manas-2010:p0101:b002:l042","ordinal":4107,"en":"Khan Tekeche, Khan Shygay,"},{"id":"manas-2010:p0101:b002:l043","ordinal":4108,"en":"Without lending us their presence,"},{"id":"manas-2010:p0101:b002:l044","ordinal":4109,"en":"Without showing themselves brave,"},{"id":"manas-2010:p0101:b002:l045","ordinal":4110,"en":"Occupied with saving their lives,"},{"id":"manas-2010:p0101:b002:l046","ordinal":4111,"en":"When they lost their wits,"},{"id":"manas-2010:p0101:b002:l047","ordinal":4112,"en":"When these two fled into the mountains,"},{"id":"manas-2010:p0101:b002:l048","ordinal":4113,"en":"They grasped at survival."},{"id":"manas-2010:p0102:b002:l001","ordinal":4114,"en":"Without lending us their presence,"},{"id":"manas-2010:p0102:b002:l002","ordinal":4115,"en":"Without showing they were kin,"},{"id":"manas-2010:p0102:b002:l003","ordinal":4116,"en":"They fled and saved themselves."},{"id":"manas-2010:p0102:b002:l004","ordinal":4117,"en":"We had no strength to clash,"},{"id":"manas-2010:p0102:b002:l005","ordinal":4118,"en":"No means to grapple."},{"id":"manas-2010:p0102:b002:l006","ordinal":4119,"en":"The Black Kalmyks and the many Manchus,"},{"id":"manas-2010:p0102:b002:l007","ordinal":4120,"en":"When they descended upon our heads,"},{"id":"manas-2010:p0102:b002:l008","ordinal":4121,"en":"When they broke us to pieces"},{"id":"manas-2010:p0102:b002:l009","ordinal":4122,"en":"And scattered us all,"},{"id":"manas-2010:p0102:b002:l010","ordinal":4123,"en":"When they heaped humiliation on us like sheep,"},{"id":"manas-2010:p0102:b002:l011","ordinal":4124,"en":"Leaving us masters of neither stock nor lives,"},{"id":"manas-2010:p0102:b002:l012","ordinal":4125,"en":"When your Chinese plundered everything,"},{"id":"manas-2010:p0102:b002:l013","ordinal":4126,"en":"Our hands and feet bound,"},{"id":"manas-2010:p0102:b002:l014","ordinal":4127,"en":"Driven off in humiliation,"},{"id":"manas-2010:p0102:b002:l015","ordinal":4128,"en":"Grieving and sorrowing,"},{"id":"manas-2010:p0102:b002:l016","ordinal":4129,"en":"Separated from our own kin—"},{"id":"manas-2010:p0102:b002:l017","ordinal":4130,"en":"If we describe it, black night!"},{"id":"manas-2010:p0102:b002:l018","ordinal":4131,"en":"Has any mortal known such days?"},{"id":"manas-2010:p0102:b002:l019","ordinal":4132,"en":"Hands and feet were bound together;"},{"id":"manas-2010:p0102:b002:l020","ordinal":4133,"en":"We were driven off in humiliation."},{"id":"manas-2010:p0102:b002:l021","ordinal":4134,"en":"One of us went to Eyren,"},{"id":"manas-2010:p0102:b002:l022","ordinal":4135,"en":"One of us fell where there was no way out,"},{"id":"manas-2010:p0102:b002:l023","ordinal":4136,"en":"Into the depths."},{"id":"manas-2010:p0102:b002:l024","ordinal":4137,"en":"Many of us fell into humiliation,"},{"id":"manas-2010:p0102:b002:l025","ordinal":4138,"en":"We met one wielding a great club,"},{"id":"manas-2010:p0102:b002:l026","ordinal":4139,"en":"Violence itself."},{"id":"manas-2010:p0102:b002:l027","ordinal":4140,"en":"When turmoil was laid upon our heads,"},{"id":"manas-2010:p0102:b002:l028","ordinal":4141,"en":"When these unbelievers drove us off,"},{"id":"manas-2010:p0102:b002:l029","ordinal":4142,"en":"Finding no sheep to slaughter and eat,"},{"id":"manas-2010:p0102:b002:l030","ordinal":4143,"en":"Finding no place to rest,"},{"id":"manas-2010:p0102:b002:l031","ordinal":4144,"en":"Finding no lone maned yearling,"},{"id":"manas-2010:p0102:b002:l032","ordinal":4145,"en":"Nor any place to ease our souls,"},{"id":"manas-2010:p0102:b002:l033","ordinal":4146,"en":"When we came wandering in distress,"},{"id":"manas-2010:p0102:b002:l034","ordinal":4147,"en":"We reached Altai and found strength, Jakyp;"},{"id":"manas-2010:p0102:b002:l035","ordinal":4148,"en":"Digging the gold mine,"},{"id":"manas-2010:p0102:b002:l036","ordinal":4149,"en":"We gained livestock, Jakyp!"},{"id":"manas-2010:p0102:b002:l037","ordinal":4150,"en":"Is such a dream known in tradition?"},{"id":"manas-2010:p0102:b002:l038","ordinal":4151,"en":"That Allah the Creator"},{"id":"manas-2010:p0102:b002:l039","ordinal":4152,"en":"Should give a child like Manas—"},{"id":"manas-2010:p0102:b002:l040","ordinal":4153,"en":"Is such a thing known in tradition at all!"},{"id":"manas-2010:p0102:b002:l041","ordinal":4154,"en":"If this one child grows,"},{"id":"manas-2010:p0102:b002:l042","ordinal":4155,"en":"He is the treasure who will avenge you;"},{"id":"manas-2010:p0102:b002:l043","ordinal":4156,"en":"He is the hero who will ease your sorrow."},{"id":"manas-2010:p0102:b002:l044","ordinal":4157,"en":"We were driven away in every direction;"},{"id":"manas-2010:p0102:b002:l045","ordinal":4158,"en":"If we live, he is the hero who will find our kin."},{"id":"manas-2010:p0102:b002:l046","ordinal":4159,"en":"See, these are good days we have seen;"},{"id":"manas-2010:p0102:b002:l047","ordinal":4160,"en":"To one who knows, Manas is the Night of Power."},{"id":"manas-2010:p0102:b002:l048","ordinal":4161,"en":"Your lean horse has grown fat, hero;"},{"id":"manas-2010:p0103:b002:l001","ordinal":4162,"en":"Our hungry belly has been filled."},{"id":"manas-2010:p0103:b002:l002","ordinal":4163,"en":"What was severed from you will be joined;"},{"id":"manas-2010:p0103:b002:l003","ordinal":4164,"en":"If your child lives and grows,"},{"id":"manas-2010:p0103:b002:l004","ordinal":4165,"en":"Grief will scatter from your breast,"},{"id":"manas-2010:p0103:b002:l005","ordinal":4166,"en":"Your burning heart will be soothed."},{"id":"manas-2010:p0103:b002:l006","ordinal":4167,"en":"If he lives and grows,"},{"id":"manas-2010:p0103:b002:l007","ordinal":4168,"en":"Your eyes will open wide!"},{"id":"manas-2010:p0103:b002:l008","ordinal":4169,"en":"What was severed will be joined,"},{"id":"manas-2010:p0103:b002:l009","ordinal":4170,"en":"What was scattered will be gathered.”"},{"id":"manas-2010:p0103:b002:l010","ordinal":4171,"en":"These were Akbaltay's words."},{"id":"manas-2010:p0103:b002:l011","ordinal":4172,"en":"“You have a child now, Jakyp!"},{"id":"manas-2010:p0103:b002:l012","ordinal":4173,"en":"Has your white dawn risen?"},{"id":"manas-2010:p0103:b002:l013","ordinal":4174,"en":"Has your red day come?"},{"id":"manas-2010:p0103:b002:l014","ordinal":4175,"en":"The leopard named Manas,"},{"id":"manas-2010:p0103:b002:l015","ordinal":4176,"en":"Has God granted that generous soul?!"},{"id":"manas-2010:p0103:b002:l016","ordinal":4177,"en":"Yet see, there is distress within me."},{"id":"manas-2010:p0103:b002:l017","ordinal":4178,"en":"Beijing, the great city like paradise—"},{"id":"manas-2010:p0103:b002:l018","ordinal":4179,"en":"Its ruler is mighty Esenkan."},{"id":"manas-2010:p0103:b002:l019","ordinal":4180,"en":"I heard the tale handed down:"},{"id":"manas-2010:p0103:b002:l020","ordinal":4181,"en":"‘A hero named Manas will arise"},{"id":"manas-2010:p0103:b002:l021","ordinal":4182,"en":"And bring turmoil to Beijing.’"},{"id":"manas-2010:p0103:b002:l022","ordinal":4183,"en":"Esenkan, the khan of Beijing,"},{"id":"manas-2010:p0103:b002:l023","ordinal":4184,"en":"Among these Kyrgyz people"},{"id":"manas-2010:p0103:b002:l024","ordinal":4185,"en":"Sought a child, I heard."},{"id":"manas-2010:p0103:b002:l025","ordinal":4186,"en":"‘The child is named Manas,’"},{"id":"manas-2010:p0103:b002:l026","ordinal":4187,"en":"His diviner knew and said."},{"id":"manas-2010:p0103:b002:l027","ordinal":4188,"en":"His tongue is the Kyrgyz tongue,"},{"id":"manas-2010:p0103:b002:l028","ordinal":4189,"en":"He is Beijing's enemy by nature."},{"id":"manas-2010:p0103:b002:l029","ordinal":4190,"en":"His diviner thought and knew;"},{"id":"manas-2010:p0103:b002:l030","ordinal":4191,"en":"That unbeliever Esenkan's"},{"id":"manas-2010:p0103:b002:l031","ordinal":4192,"en":"Herald told him,"},{"id":"manas-2010:p0103:b002:l032","ordinal":4193,"en":"Many spoke before his eyes."},{"id":"manas-2010:p0103:b002:l033","ordinal":4194,"en":"They had known of Manas,"},{"id":"manas-2010:p0103:b002:l034","ordinal":4195,"en":"His magicians in royal service."},{"id":"manas-2010:p0103:b002:l035","ordinal":4196,"en":"Hearing certain news from the magician,"},{"id":"manas-2010:p0103:b002:l036","ordinal":4197,"en":"Hearing, ‘Manas is an enemy,’"},{"id":"manas-2010:p0103:b002:l037","ordinal":4198,"en":"They brought all kinds of troops."},{"id":"manas-2010:p0103:b002:l038","ordinal":4199,"en":"We were these forty Kyrgyz households;"},{"id":"manas-2010:p0103:b002:l039","ordinal":4200,"en":"When they gathered us all,"},{"id":"manas-2010:p0103:b002:l040","ordinal":4201,"en":"Do you remember?"},{"id":"manas-2010:p0103:b002:l041","ordinal":4202,"en":"Making all the children cry,"},{"id":"manas-2010:p0103:b002:l042","ordinal":4203,"en":"They made them file past."},{"id":"manas-2010:p0103:b002:l043","ordinal":4204,"en":"Esenkan sought Manas;"},{"id":"manas-2010:p0103:b002:l044","ordinal":4205,"en":"When I follow the handed-down tale,"},{"id":"manas-2010:p0103:b002:l045","ordinal":4206,"en":"When I ask those who know,"},{"id":"manas-2010:p0103:b002:l046","ordinal":4207,"en":"They say he caused an uproar."},{"id":"manas-2010:p0103:b002:l047","ordinal":4208,"en":"That bastard, may he burn to death,"},{"id":"manas-2010:p0103:b002:l048","ordinal":4209,"en":"Sent word in every direction, they say."},{"id":"manas-2010:p0104:b002:l001","ordinal":4210,"en":"Those who answered back,"},{"id":"manas-2010:p0104:b002:l002","ordinal":4211,"en":"He seized and slaughtered, they say."},{"id":"manas-2010:p0104:b002:l003","ordinal":4212,"en":"Showing his greatness,"},{"id":"manas-2010:p0104:b002:l004","ordinal":4213,"en":"All the assembled people"},{"id":"manas-2010:p0104:b002:l005","ordinal":4214,"en":"He tormented, beat, and burned."},{"id":"manas-2010:p0104:b002:l006","ordinal":4215,"en":"He sought a child, I heard;"},{"id":"manas-2010:p0104:b002:l007","ordinal":4216,"en":"One named Manas, with a mane,"},{"id":"manas-2010:p0104:b002:l008","ordinal":4217,"en":"He sought such a being, I heard."},{"id":"manas-2010:p0104:b002:l009","ordinal":4218,"en":"Whatever he pleased upon the world,"},{"id":"manas-2010:p0104:b002:l010","ordinal":4219,"en":"He did, I heard."},{"id":"manas-2010:p0104:b002:l011","ordinal":4220,"en":"Those who roused his stubborn wrath,"},{"id":"manas-2010:p0104:b002:l012","ordinal":4221,"en":"Their napes thrust stiffly back,"},{"id":"manas-2010:p0104:b002:l013","ordinal":4222,"en":"He slaughtered, I heard."},{"id":"manas-2010:p0104:b002:l014","ordinal":4223,"en":"Merciless turmoil,"},{"id":"manas-2010:p0104:b002:l015","ordinal":4224,"en":"He unleashed it, I heard."},{"id":"manas-2010:p0104:b002:l016","ordinal":4225,"en":"In the city of Samarkan,"},{"id":"manas-2010:p0104:b002:l017","ordinal":4226,"en":"The poor boy who had been born,"},{"id":"manas-2010:p0104:b002:l018","ordinal":4227,"en":"Chong Eshen's Jar Manas,"},{"id":"manas-2010:p0104:b002:l019","ordinal":4228,"en":"The Chinese by force"},{"id":"manas-2010:p0104:b002:l020","ordinal":4229,"en":"Took him away, I heard."},{"id":"manas-2010:p0104:b002:l021","ordinal":4230,"en":"There is the kakan's people;"},{"id":"manas-2010:p0104:b002:l022","ordinal":4231,"en":"Among the swarming Chinese,"},{"id":"manas-2010:p0104:b002:l023","ordinal":4232,"en":"There are giants of many kinds."},{"id":"manas-2010:p0104:b002:l024","ordinal":4233,"en":"When their khan commands,"},{"id":"manas-2010:p0104:b002:l025","ordinal":4234,"en":"It is their custom to inflict such violence."},{"id":"manas-2010:p0104:b002:l026","ordinal":4235,"en":"The sheikhs with their courts, the mighty retainers,"},{"id":"manas-2010:p0104:b002:l027","ordinal":4236,"en":"The great peoples of Kokon and Margalang,"},{"id":"manas-2010:p0104:b002:l028","ordinal":4237,"en":"They made a spectacle of them, I heard."},{"id":"manas-2010:p0104:b002:l029","ordinal":4238,"en":"Dwelling in Anjyiyan,"},{"id":"manas-2010:p0104:b002:l030","ordinal":4239,"en":"Whom no enemy had subdued,"},{"id":"manas-2010:p0104:b002:l031","ordinal":4240,"en":"Was my Aykhoja in Anjyiyan;"},{"id":"manas-2010:p0104:b002:l032","ordinal":4241,"en":"Aykhoja's son was Bilerik."},{"id":"manas-2010:p0104:b002:l033","ordinal":4242,"en":"Do not ask about Aykhoja—"},{"id":"manas-2010:p0104:b002:l034","ordinal":4243,"en":"He was a saintly man."},{"id":"manas-2010:p0104:b002:l035","ordinal":4244,"en":"Aykhoja's Bilerik"},{"id":"manas-2010:p0104:b002:l036","ordinal":4245,"en":"Was the child he had in his dying days."},{"id":"manas-2010:p0104:b002:l037","ordinal":4246,"en":"The talmyz of the waters of Jeti-Özön,"},{"id":"manas-2010:p0104:b002:l038","ordinal":4247,"en":"Bilerik, whom Aykhoja had in his dying days,"},{"id":"manas-2010:p0104:b002:l039","ordinal":4248,"en":"Was his father's only son."},{"id":"manas-2010:p0104:b002:l040","ordinal":4249,"en":"Loading up the gold,"},{"id":"manas-2010:p0104:b002:l041","ordinal":4250,"en":"He had it packed, I heard."},{"id":"manas-2010:p0104:b002:l042","ordinal":4251,"en":"Winding his belt as a turban,"},{"id":"manas-2010:p0104:b002:l043","ordinal":4252,"en":"Pleading with the Almighty,"},{"id":"manas-2010:p0104:b002:l044","ordinal":4253,"en":"They arranged their goods on camels,"},{"id":"manas-2010:p0104:b002:l045","ordinal":4254,"en":"Drove them toward the Chinese."},{"id":"manas-2010:p0104:b002:l046","ordinal":4255,"en":"Great Döngö, coming from the Chinese,"},{"id":"manas-2010:p0104:b002:l047","ordinal":4256,"en":"Whatever he pleased to them,"},{"id":"manas-2010:p0104:b002:l048","ordinal":4257,"en":"He did, I heard."},{"id":"manas-2010:p0105:b002:l001","ordinal":4258,"en":"In the waterless desert of Mediyan,"},{"id":"manas-2010:p0105:b002:l002","ordinal":4259,"en":"The khojas who had gone to trade,"},{"id":"manas-2010:p0105:b002:l003","ordinal":4260,"en":"He slaughtered, I heard."},{"id":"manas-2010:p0105:b002:l004","ordinal":4261,"en":"Then the khojas were slaughtered,"},{"id":"manas-2010:p0105:b002:l005","ordinal":4262,"en":"All trade was stopped."},{"id":"manas-2010:p0105:b002:l006","ordinal":4263,"en":"Taking the spoils, great Döngö"},{"id":"manas-2010:p0105:b002:l007","ordinal":4264,"en":"Set out on the road, I heard."},{"id":"manas-2010:p0105:b002:l008","ordinal":4265,"en":"Aykhoja's son Bilerik"},{"id":"manas-2010:p0105:b002:l009","ordinal":4266,"en":"Was captured, I heard."},{"id":"manas-2010:p0105:b002:l010","ordinal":4267,"en":"From iron ropes there was no escape;"},{"id":"manas-2010:p0105:b002:l011","ordinal":4268,"en":"He fell into the net, I heard."},{"id":"manas-2010:p0105:b002:l012","ordinal":4269,"en":"For the Chinese to make sport,"},{"id":"manas-2010:p0105:b002:l013","ordinal":4270,"en":"He fell into their uproar, I heard."},{"id":"manas-2010:p0105:b002:l014","ordinal":4271,"en":"An immense, unending"},{"id":"manas-2010:p0105:b002:l015","ordinal":4272,"en":"Turmoil engulfed him, I heard."},{"id":"manas-2010:p0105:b002:l016","ordinal":4273,"en":"Making the khojas cringe,"},{"id":"manas-2010:p0105:b002:l017","ordinal":4274,"en":"He killed them off, I heard."},{"id":"manas-2010:p0105:b002:l018","ordinal":4275,"en":"‘These too are Muslim people,’ he said."},{"id":"manas-2010:p0105:b002:l019","ordinal":4276,"en":"Bilerik, in this fashion,"},{"id":"manas-2010:p0105:b002:l020","ordinal":4277,"en":"He bound and took away, I heard."},{"id":"manas-2010:p0105:b002:l021","ordinal":4278,"en":"Jar Manas and Bilerik,"},{"id":"manas-2010:p0105:b002:l022","ordinal":4279,"en":"He took the two together, they say."},{"id":"manas-2010:p0105:b002:l023","ordinal":4280,"en":"A great dungeon beneath the khan's throne,"},{"id":"manas-2010:p0105:b002:l024","ordinal":4281,"en":"Forty rope-lengths in height—"},{"id":"manas-2010:p0105:b002:l025","ordinal":4282,"en":"He put them in that dungeon, they say."},{"id":"manas-2010:p0105:b002:l026","ordinal":4283,"en":"Without killing or making them disappear,"},{"id":"manas-2010:p0105:b002:l027","ordinal":4284,"en":"They became poor wretches, they say."},{"id":"manas-2010:p0105:b002:l028","ordinal":4285,"en":"The Chinese fell into turmoil,"},{"id":"manas-2010:p0105:b002:l029","ordinal":4286,"en":"Hearing the name Manas."},{"id":"manas-2010:p0105:b002:l030","ordinal":4287,"en":"Take care, rich Jakyp!"},{"id":"manas-2010:p0105:b002:l031","ordinal":4288,"en":"Is there such a tale in the world?"},{"id":"manas-2010:p0105:b002:l032","ordinal":4289,"en":"‘Manas's tribe is Kyrgyz,’ they said,"},{"id":"manas-2010:p0105:b002:l033","ordinal":4290,"en":"‘Manas will destroy our nest,’ they said,"},{"id":"manas-2010:p0105:b002:l034","ordinal":4291,"en":"And built a mighty fortress in Beijing."},{"id":"manas-2010:p0105:b002:l035","ordinal":4292,"en":"Attend, Jakyp, hear my words."},{"id":"manas-2010:p0105:b002:l036","ordinal":4293,"en":"Is there such a tale among mortals?"},{"id":"manas-2010:p0105:b002:l037","ordinal":4294,"en":"When the forty Kyrgyz households gather,"},{"id":"manas-2010:p0105:b002:l038","ordinal":4295,"en":"Do not speak the name Manas."},{"id":"manas-2010:p0105:b002:l039","ordinal":4296,"en":"Let the forty Kyrgyz households gather,"},{"id":"manas-2010:p0105:b002:l040","ordinal":4297,"en":"Let us cast off all sorrow."},{"id":"manas-2010:p0105:b002:l041","ordinal":4298,"en":"Let all the Kyrgyz gather;"},{"id":"manas-2010:p0105:b002:l042","ordinal":4299,"en":"The fierce one visited by Kydyr,"},{"id":"manas-2010:p0105:b002:l043","ordinal":4300,"en":"For now let us name him Chong Jindi."},{"id":"manas-2010:p0105:b002:l044","ordinal":4301,"en":"When he reaches twelve years,"},{"id":"manas-2010:p0105:b002:l045","ordinal":4302,"en":"Teaching him what he does not know,"},{"id":"manas-2010:p0105:b002:l046","ordinal":4303,"en":"Let us set him on his way."},{"id":"manas-2010:p0105:b002:l047","ordinal":4304,"en":"From the swarming unbelievers,"},{"id":"manas-2010:p0105:b002:l048","ordinal":4305,"en":"Let us take vengeance for those distant wrongs."},{"id":"manas-2010:p0106:b002:l001","ordinal":4306,"en":"When he reaches fourteen years,"},{"id":"manas-2010:p0106:b002:l002","ordinal":4307,"en":"He will harden, sated with blood."},{"id":"manas-2010:p0106:b002:l003","ordinal":4308,"en":"Watch Manas:"},{"id":"manas-2010:p0106:b002:l004","ordinal":4309,"en":"In the kakan's Beijing"},{"id":"manas-2010:p0106:b002:l005","ordinal":4310,"en":"He will be called Bloodthirsty Manas."},{"id":"manas-2010:p0106:b002:l006","ordinal":4311,"en":"He is the marked one, he is our support;"},{"id":"manas-2010:p0106:b002:l007","ordinal":4312,"en":"To Beijing with its kakan,"},{"id":"manas-2010:p0106:b002:l008","ordinal":4313,"en":"He is the hero who will bring uproar."},{"id":"manas-2010:p0106:b002:l009","ordinal":4314,"en":"Rich Jakyp, my child, hear my words:"},{"id":"manas-2010:p0106:b002:l010","ordinal":4315,"en":"A child has come, a lion has come;"},{"id":"manas-2010:p0106:b002:l011","ordinal":4316,"en":"Your herds and your household are now in balance."},{"id":"manas-2010:p0106:b002:l012","ordinal":4317,"en":"Your fortune is great, leopard;"},{"id":"manas-2010:p0106:b002:l013","ordinal":4318,"en":"The hero Manas has come to your home!"},{"id":"manas-2010:p0106:b002:l014","ordinal":4319,"en":"If this son of yours survives,"},{"id":"manas-2010:p0106:b002:l015","ordinal":4320,"en":"He will hew a road across the precipice."},{"id":"manas-2010:p0106:b002:l016","ordinal":4321,"en":"Unless my words prove false,"},{"id":"manas-2010:p0106:b002:l017","ordinal":4322,"en":"Unless God Himself knows otherwise,"},{"id":"manas-2010:p0106:b002:l018","ordinal":4323,"en":"This son will raid the Chinese and take spoils."},{"id":"manas-2010:p0106:b002:l019","ordinal":4324,"en":"O Jakyp, keeper of countless livestock,"},{"id":"manas-2010:p0106:b002:l020","ordinal":4325,"en":"You were a man close-fisted with his herds;"},{"id":"manas-2010:p0106:b002:l021","ordinal":4326,"en":"Give up your stinginess, Jakyp!"},{"id":"manas-2010:p0106:b002:l022","ordinal":4327,"en":"Your horses on the hills number six san;"},{"id":"manas-2010:p0106:b002:l023","ordinal":4328,"en":"Many are fine, with piebald heads,"},{"id":"manas-2010:p0106:b002:l024","ordinal":4329,"en":"Argymaks and swift steeds among them."},{"id":"manas-2010:p0106:b002:l025","ordinal":4330,"en":"Cast off all sorrow, Jakyp!"},{"id":"manas-2010:p0106:b002:l026","ordinal":4331,"en":"Your son Manas has arrived;"},{"id":"manas-2010:p0106:b002:l027","ordinal":4332,"en":"Slaughter many for the feast, Jakyp!"},{"id":"manas-2010:p0106:b002:l028","ordinal":4333,"en":"Many horses, many sheep,"},{"id":"manas-2010:p0106:b002:l029","ordinal":4334,"en":"Slaughter a good many, Jakyp!"},{"id":"manas-2010:p0106:b002:l030","ordinal":4335,"en":"‘The child's name is Manas’—"},{"id":"manas-2010:p0106:b002:l031","ordinal":4336,"en":"Without letting any person know,"},{"id":"manas-2010:p0106:b002:l032","ordinal":4337,"en":"Without"},{"id":"manas-2010:p0106:b002:l033","ordinal":4338,"en":"Letting any person hear,"},{"id":"manas-2010:p0106:b002:l034","ordinal":4339,"en":"Within yourself, saying ‘Manas,’"},{"id":"manas-2010:p0106:b002:l035","ordinal":4340,"en":"Give the child his name, Jakyp!"},{"id":"manas-2010:p0106:b002:l036","ordinal":4341,"en":"Scatter your countless livestock, Jakyp!"},{"id":"manas-2010:p0106:b002:l037","ordinal":4342,"en":"Silence the people's mouths, Jakyp!"},{"id":"manas-2010:p0106:b002:l038","ordinal":4343,"en":"Let your cattle and camels be slaughtered;"},{"id":"manas-2010:p0106:b002:l039","ordinal":4344,"en":"On this plain of Altai,"},{"id":"manas-2010:p0106:b002:l040","ordinal":4345,"en":"Let a great cooking pit be dug."},{"id":"manas-2010:p0106:b002:l041","ordinal":4346,"en":"At this feast for Manas,"},{"id":"manas-2010:p0106:b002:l042","ordinal":4347,"en":"Dervishes, poor folk, the destitute,"},{"id":"manas-2010:p0106:b002:l043","ordinal":4348,"en":"Let all eat their fill, not one left out!”"},{"id":"manas-2010:p0106:b002:l044","ordinal":4349,"en":"Akbaltay spoke these words,"},{"id":"manas-2010:p0106:b002:l045","ordinal":4350,"en":"Announcing the good tidings."},{"id":"manas-2010:p0106:b002:l046","ordinal":4351,"en":"Rich Jakyp, who had had no child,"},{"id":"manas-2010:p0106:b002:l047","ordinal":4352,"en":"Now agreed to what he said."}]
