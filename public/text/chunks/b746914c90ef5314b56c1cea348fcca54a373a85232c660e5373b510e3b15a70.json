[{"id":"semetey-1-2013:p0948:b003:l030","ordinal":148481,"en":"Receiving a blessing from a prince,"},{"id":"semetey-1-2013:p0948:b003:l031","ordinal":148482,"en":"Pledging allegiance to twelve spiritual guides,"},{"id":"semetey-1-2013:p0948:b003:l033","ordinal":148483,"en":"Whose blessing enriched the people,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0948:b003:l034","ordinal":148484,"en":"Who brought prosperity to anyone he regarded,"},{"id":"semetey-1-2013:p0948:b003:l035","ordinal":148485,"en":"His white beard flowing,"},{"id":"semetey-1-2013:p0948:b003:l036","ordinal":148486,"en":"Who understood the words of the Haftiyak."},{"id":"semetey-1-2013:p0948:b003:l037","ordinal":148487,"en":"A sultan blessed by Kydyr, a precious hero—"},{"id":"semetey-1-2013:p0948:b003:l038","ordinal":148488,"en":"Aichurok, a formidable judge,"},{"id":"semetey-1-2013:p0948:b003:l039","ordinal":148489,"en":"Was there appraising him."},{"id":"semetey-1-2013:p0948:b004:l001","ordinal":148490,"en":"Do not ask about your elder:"},{"id":"semetey-1-2013:p0948:b004:l002","ordinal":148491,"en":"God had given him long life,"},{"id":"semetey-1-2013:p0948:b004:l003","ordinal":148492,"en":"His age approached a hundred."},{"id":"semetey-1-2013:p0948:b004:l004","ordinal":148493,"en":"In his youth, this elder of mine,"},{"id":"semetey-1-2013:p0948:b004:l005","ordinal":148494,"en":"The dear land of Jeti-Suu,"},{"id":"semetey-1-2013:p0948:b004:l006","ordinal":148495,"en":"Through skill had made it a homeland."},{"id":"semetey-1-2013:p0948:b004:l007","ordinal":148496,"en":"The Kyrgyz of Jeti-Suu,"},{"id":"semetey-1-2013:p0948:b004:l008","ordinal":148497,"en":"Through his efforts had made them a people."},{"id":"semetey-1-2013:p0948:b004:l009","ordinal":148498,"en":"When she examined your elder,"},{"id":"semetey-1-2013:p0948:b004:l010","ordinal":148499,"en":"He crouched beside the fire."},{"id":"semetey-1-2013:p0948:b004:l011","ordinal":148500,"en":"What could your dear elder do?"},{"id":"semetey-1-2013:p0948:b004:l012","ordinal":148501,"en":"He had sunk down and could not rise."},{"id":"semetey-1-2013:p0948:b004:l013","ordinal":148502,"en":"To call him alive, he did not count;"},{"id":"semetey-1-2013:p0948:b004:l014","ordinal":148503,"en":"To call him dead, he was not in the grave."},{"id":"semetey-1-2013:p0948:b004:l016","ordinal":148504,"en":"Chattering like magpies and jackdaws,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0948:b004:l018","ordinal":148505,"en":"The Kyrgyz of Jeti-Suu—","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0948:b004:l020","ordinal":148506,"en":"Koshoi's strength had gone.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0948:b004:l021","ordinal":148507,"en":"Not heeding one another's words,"},{"id":"semetey-1-2013:p0948:b004:l022","ordinal":148508,"en":"Unable to bear one another,"},{"id":"semetey-1-2013:p0948:b004:l023","ordinal":148509,"en":"All the Kyrgyz"},{"id":"semetey-1-2013:p0948:b004:l024","ordinal":148510,"en":"Were no people to welcome her."},{"id":"semetey-1-2013:p0948:b004:l026","ordinal":148511,"en":"'My aged elder, Khan Koshoi,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0948:b004:l027","ordinal":148512,"en":"Is the equal of my grandfather."},{"id":"semetey-1-2013:p0948:b004:l028","ordinal":148513,"en":"To this weary giant Koshoi,"},{"id":"semetey-1-2013:p0948:b004:l029","ordinal":148514,"en":"Why should I be bound?"},{"id":"semetey-1-2013:p0948:b004:l030","ordinal":148515,"en":"The giants upon the face of the earth,"},{"id":"semetey-1-2013:p0948:b004:l031","ordinal":148516,"en":"Let me go and see them all.'"},{"id":"semetey-1-2013:p0948:b004:l032","ordinal":148517,"en":"Wintering by broad Issyk-Kol,"},{"id":"semetey-1-2013:p0948:b004:l033","ordinal":148518,"en":"Summering in the two Kemins,"},{"id":"semetey-1-2013:p0948:b004:l034","ordinal":148519,"en":"Tethering a pair of black horses,"},{"id":"semetey-1-2013:p0948:b004:l035","ordinal":148520,"en":"Making a dark cave his home,"},{"id":"semetey-1-2013:p0948:b004:l036","ordinal":148521,"en":"To put Urbu to the test,"},{"id":"semetey-1-2013:p0948:b004:l037","ordinal":148522,"en":"When Aichurok came in,"},{"id":"semetey-1-2013:p0948:b004:l038","ordinal":148523,"en":"His people remained, but he was gone."},{"id":"semetey-1-2013:p0948:b004:l039","ordinal":148524,"en":"The hero Urbu was no longer living,"},{"id":"semetey-1-2013:p0949:b003:l001","ordinal":148525,"en":"What is seen today is gone tomorrow;"},{"id":"semetey-1-2013:p0949:b003:l002","ordinal":148526,"en":"Such is this shitty world."},{"id":"semetey-1-2013:p0949:b003:l003","ordinal":148527,"en":"Their leader Urbu had died."},{"id":"semetey-1-2013:p0949:b003:l004","ordinal":148528,"en":"Scattered by attacks,"},{"id":"semetey-1-2013:p0949:b003:l005","ordinal":148529,"en":"The wretched people struggled on."},{"id":"semetey-1-2013:p0949:b003:l006","ordinal":148530,"en":"His people had settled in the valley."},{"id":"semetey-1-2013:p0949:b003:l007","ordinal":148531,"en":"With the hero Urbu himself dead,"},{"id":"semetey-1-2013:p0949:b003:l008","ordinal":148532,"en":"It was as though a fire had gone out."},{"id":"semetey-1-2013:p0949:b003:l009","ordinal":148533,"en":"Despairing of Urbu, Churok"},{"id":"semetey-1-2013:p0949:b003:l010","ordinal":148534,"en":"Crossed Chong-Kashtek,"},{"id":"semetey-1-2013:p0949:b003:l011","ordinal":148535,"en":"Wandered through desert lands,"},{"id":"semetey-1-2013:p0949:b003:l012","ordinal":148536,"en":"Passed over the broad Ili."},{"id":"semetey-1-2013:p0949:b003:l013","ordinal":148537,"en":"Crossing ridge after ridge,"},{"id":"semetey-1-2013:p0949:b003:l014","ordinal":148538,"en":"Crossing rugged mountain passes,"},{"id":"semetey-1-2013:p0949:b003:l015","ordinal":148539,"en":"Traversing countless lands,"},{"id":"semetey-1-2013:p0949:b003:l016","ordinal":148540,"en":"Wandering through Sary-Arka,"},{"id":"semetey-1-2013:p0949:b003:l017","ordinal":148541,"en":"When she came to Sary-Arka,"},{"id":"semetey-1-2013:p0949:b003:l018","ordinal":148542,"en":"She saw an unusual people there:"},{"id":"semetey-1-2013:p0949:b003:l019","ordinal":148543,"en":"Who prepared their millet hard as stone,"},{"id":"semetey-1-2013:p0949:b003:l020","ordinal":148544,"en":"Praised their wives as though they were maidens,"},{"id":"semetey-1-2013:p0949:b003:l021","ordinal":148545,"en":"With watery ayran and blue-gray dried curds."},{"id":"semetey-1-2013:p0949:b003:l022","ordinal":148546,"en":"The Kazakhs' Khan Kokcho,"},{"id":"semetey-1-2013:p0949:b003:l023","ordinal":148547,"en":"And Kokcho's son Umotoi—"},{"id":"semetey-1-2013:p0949:b003:l024","ordinal":148548,"en":"She came to put Umotoi to the test."},{"id":"semetey-1-2013:p0949:b003:l025","ordinal":148549,"en":"From the grassy heights of Sary-Arka,"},{"id":"semetey-1-2013:p0949:b003:l026","ordinal":148550,"en":"With sixty champions beside him,"},{"id":"semetey-1-2013:p0949:b003:l027","ordinal":148551,"en":"He had returned from a hunting expedition;"},{"id":"semetey-1-2013:p0949:b003:l028","ordinal":148552,"en":"She stood appraising Umotoi."},{"id":"semetey-1-2013:p0949:b003:l029","ordinal":148553,"en":"Dull-minded, without spirit,"},{"id":"semetey-1-2013:p0949:b003:l030","ordinal":148554,"en":"Calf-like Umotoi;"},{"id":"semetey-1-2013:p0949:b003:l031","ordinal":148555,"en":"When he advanced against a foe,"},{"id":"semetey-1-2013:p0949:b003:l032","ordinal":148556,"en":"Cowardly Umotoi."},{"id":"semetey-1-2013:p0949:b003:l033","ordinal":148557,"en":"He was no support to bind about one's waist,"},{"id":"semetey-1-2013:p0949:b003:l034","ordinal":148558,"en":"No hero to rely upon firmly."},{"id":"semetey-1-2013:p0949:b003:l035","ordinal":148559,"en":"Once he fled, he would never stop;"},{"id":"semetey-1-2013:p0949:b003:l036","ordinal":148560,"en":"His cowardice showed."},{"id":"semetey-1-2013:p0949:b003:l037","ordinal":148561,"en":"An oaf who understood no reason,"},{"id":"semetey-1-2013:p0949:b003:l038","ordinal":148562,"en":"His ineptness showed."},{"id":"semetey-1-2013:p0949:b003:l039","ordinal":148563,"en":"They were no people simply to trust,"},{"id":"semetey-1-2013:p0949:b004:l001","ordinal":148564,"en":"He was no hero to marry."},{"id":"semetey-1-2013:p0949:b004:l002","ordinal":148565,"en":"Toltoi of the Jediger"},{"id":"semetey-1-2013:p0949:b004:l003","ordinal":148566,"en":"Was no less brave than this one."},{"id":"semetey-1-2013:p0949:b004:l004","ordinal":148567,"en":"Kokcho's son Umotoi"},{"id":"semetey-1-2013:p0949:b004:l005","ordinal":148568,"en":"Was no hero a mortal could trust."},{"id":"semetey-1-2013:p0949:b004:l006","ordinal":148569,"en":"Aichurok flew across,"},{"id":"semetey-1-2013:p0949:b004:l007","ordinal":148570,"en":"Seeking a hero without stopping or resting,"},{"id":"semetey-1-2013:p0949:b004:l008","ordinal":148571,"en":"Passed through Talaa-Chelek,"},{"id":"semetey-1-2013:p0949:b004:l009","ordinal":148572,"en":"Crossed Too-Chelek,"},{"id":"semetey-1-2013:p0949:b004:l010","ordinal":148573,"en":"Wandered about Issyk-Kol,"},{"id":"semetey-1-2013:p0949:b004:l011","ordinal":148574,"en":"Went to Kyzyl-Kyya."},{"id":"semetey-1-2013:p0949:b004:l012","ordinal":148575,"en":"Dwelling in Kyzyl-Kyya,"},{"id":"semetey-1-2013:p0949:b004:l013","ordinal":148576,"en":"Myradyl, son of Kyrym,"},{"id":"semetey-1-2013:p0949:b004:l014","ordinal":148577,"en":"Said to be a strong-backed hero—"},{"id":"semetey-1-2013:p0949:b004:l015","ordinal":148578,"en":"She saw Myradyl."},{"id":"semetey-1-2013:p0949:b004:l016","ordinal":148579,"en":"He himself was a weather-magician,"},{"id":"semetey-1-2013:p0949:b004:l017","ordinal":148580,"en":"Who did not squat to urinate,"},{"id":"semetey-1-2013:p0949:b004:l018","ordinal":148581,"en":"Whose garment's hem did not touch the ground,"},{"id":"semetey-1-2013:p0949:b004:l019","ordinal":148582,"en":"Who did not know the sole Creator"},{"id":"semetey-1-2013:p0949:b004:l020","ordinal":148583,"en":"To be the One."},{"id":"semetey-1-2013:p0949:b004:l021","ordinal":148584,"en":"As a guard upon the people's frontier,"},{"id":"semetey-1-2013:p0949:b004:l022","ordinal":148585,"en":"He had bravery."},{"id":"semetey-1-2013:p0949:b004:l023","ordinal":148586,"en":"His garment's hem did not touch the ground,"},{"id":"semetey-1-2013:p0949:b004:l025","ordinal":148587,"en":"He had his unbelief.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0949:b004:l026","ordinal":148588,"en":"Six Soloons and four Manchus"},{"id":"semetey-1-2013:p0949:b004:l027","ordinal":148589,"en":"Had taken him as their companion."},{"id":"semetey-1-2013:p0949:b004:l028","ordinal":148590,"en":"At the familiar Sandal-Bulak,"},{"id":"semetey-1-2013:p0949:b004:l030","ordinal":148591,"en":"He had gone out hunting.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0949:b004:l031","ordinal":148592,"en":"Six swine and four boars,"},{"id":"semetey-1-2013:p0949:b004:l032","ordinal":148593,"en":"Myradyl had shot,"},{"id":"semetey-1-2013:p0949:b004:l033","ordinal":148594,"en":"And was strutting about."},{"id":"semetey-1-2013:p0949:b004:l035","ordinal":148595,"en":"With what face could I wear it?","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0949:b004:l036","ordinal":148596,"en":"To a red-naveled Chinese,"},{"id":"semetey-1-2013:p0949:b004:l037","ordinal":148597,"en":"A faithless, utterly faithless man,"},{"id":"semetey-1-2013:p0949:b004:l039","ordinal":148598,"en":"With what face could I marry?","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0950:b003:l001","ordinal":148599,"en":"Passing farther onward,"},{"id":"semetey-1-2013:p0950:b003:l002","ordinal":148600,"en":"To Beijing of Kakan-Chyn,"},{"id":"semetey-1-2013:p0950:b003:l003","ordinal":148601,"en":"To the infidels swarming like black spiders,"},{"id":"semetey-1-2013:p0950:b003:l004","ordinal":148602,"en":"To the warrior Khan Kongurbai,"},{"id":"semetey-1-2013:p0950:b003:l005","ordinal":148603,"en":"Whose name was heard throughout the world—"},{"id":"semetey-1-2013:p0950:b003:l006","ordinal":148604,"en":"Going there to wage a campaign,"},{"id":"semetey-1-2013:p0950:b003:l007","ordinal":148605,"en":"Many giants of the Muslims had perished."},{"id":"semetey-1-2013:p0950:b003:l008","ordinal":148606,"en":"Dust issued from his heart,"},{"id":"semetey-1-2013:p0950:b003:l009","ordinal":148607,"en":"The news of him drove out souls."},{"id":"semetey-1-2013:p0950:b003:l010","ordinal":148608,"en":"A mighty khan had arisen in Beijing."},{"id":"semetey-1-2013:p0950:b003:l011","ordinal":148609,"en":"With a cotton sash and broad boots,"},{"id":"semetey-1-2013:p0950:b003:l012","ordinal":148610,"en":"Kongurbai, khan of the monks,"},{"id":"semetey-1-2013:p0950:b003:l013","ordinal":148611,"en":"That stately swine—"},{"id":"semetey-1-2013:p0950:b003:l014","ordinal":148612,"en":"From white-bearded elders"},{"id":"semetey-1-2013:p0950:b003:l015","ordinal":148613,"en":"She was asking about him then."},{"id":"semetey-1-2013:p0950:b003:l016","ordinal":148614,"en":"From all the people,"},{"id":"semetey-1-2013:p0950:b003:l017","ordinal":148615,"en":"'Let me put Kongurbai to the test,"},{"id":"semetey-1-2013:p0950:b003:l018","ordinal":148616,"en":"That swine, khan of the monks,"},{"id":"semetey-1-2013:p0950:b003:l019","ordinal":148617,"en":"Let me see his appearance.'"},{"id":"semetey-1-2013:p0950:b003:l020","ordinal":148618,"en":"Saying this, Aichurok"},{"id":"semetey-1-2013:p0950:b003:l021","ordinal":148619,"en":"To the marsh of Kurpuldok"},{"id":"semetey-1-2013:p0950:b003:l022","ordinal":148620,"en":"Drew near and entered."},{"id":"semetey-1-2013:p0950:b003:l023","ordinal":148621,"en":"If you would see Kongurbai, see him now!"},{"id":"semetey-1-2013:p0950:b003:l024","ordinal":148622,"en":"Countless great livestock gathered as tribute,"},{"id":"semetey-1-2013:p0950:b003:l025","ordinal":148623,"en":"The myriad animals of Beijing,"},{"id":"semetey-1-2013:p0950:b003:l026","ordinal":148624,"en":"Kongurbai's countless horses"},{"id":"semetey-1-2013:p0950:b003:l027","ordinal":148625,"en":"Were there in teeming herds,"},{"id":"semetey-1-2013:p0950:b003:l028","ordinal":148626,"en":"Swarming like ants."},{"id":"semetey-1-2013:p0950:b003:l029","ordinal":148627,"en":"The eye could not encompass them."},{"id":"semetey-1-2013:p0950:b003:l030","ordinal":148628,"en":"That infidel's horses,"},{"id":"semetey-1-2013:p0950:b003:l032","ordinal":148629,"en":"Kongurbai's countless horses","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0950:b003:l033","ordinal":148630,"en":"Were animals of many kinds,"},{"id":"semetey-1-2013:p0950:b003:l034","ordinal":148631,"en":"Animals gathered in great masses."},{"id":"semetey-1-2013:p0950:b003:l035","ordinal":148632,"en":"Yellow-mottled like starlings,"},{"id":"semetey-1-2013:p0950:b003:l036","ordinal":148633,"en":"One variety of the horses;"},{"id":"semetey-1-2013:p0950:b003:l037","ordinal":148634,"en":"Among the horses with matted tails,"},{"id":"semetey-1-2013:p0950:b003:l038","ordinal":148635,"en":"Gray horses with bracelet markings,"},{"id":"semetey-1-2013:p0950:b003:l039","ordinal":148636,"en":"Strong, unridden horses."},{"id":"semetey-1-2013:p0950:b004:l001","ordinal":148637,"en":"His black-maned dun horses—"},{"id":"semetey-1-2013:p0950:b004:l002","ordinal":148638,"en":"That blustering Kalcha,"},{"id":"semetey-1-2013:p0950:b004:l003","ordinal":148639,"en":"Which of his deeds shall we tell?"},{"id":"semetey-1-2013:p0950:b004:l005","ordinal":148640,"en":"His hood-marked bays,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0950:b004:l006","ordinal":148641,"en":"His chestnuts like ezhigei curds,"},{"id":"semetey-1-2013:p0950:b004:l007","ordinal":148642,"en":"His blacks without a speck of white."},{"id":"semetey-1-2013:p0950:b004:l008","ordinal":148643,"en":"Known across the face of the earth"},{"id":"semetey-1-2013:p0950:b004:l009","ordinal":148644,"en":"Was Kongurbai's renown."},{"id":"semetey-1-2013:p0950:b004:l010","ordinal":148645,"en":"Delighted at the sight of his horses,"},{"id":"semetey-1-2013:p0950:b004:l011","ordinal":148646,"en":"Aichurok stood rejoicing."},{"id":"semetey-1-2013:p0950:b004:l012","ordinal":148647,"en":"His foals and yearlings broke away,"},{"id":"semetey-1-2013:p0950:b004:l013","ordinal":148648,"en":"Neighing across the flat ground,"},{"id":"semetey-1-2013:p0950:b004:l014","ordinal":148649,"en":"Racing like wild asses."},{"id":"semetey-1-2013:p0950:b004:l015","ordinal":148650,"en":"The northern side of the horse herd"},{"id":"semetey-1-2013:p0950:b004:l016","ordinal":148651,"en":"Was on the slopes of Kyr-Kaiyng;"},{"id":"semetey-1-2013:p0950:b004:l017","ordinal":148652,"en":"The lower side of the horse herd"},{"id":"semetey-1-2013:p0950:b004:l018","ordinal":148653,"en":"Was at the edge of Kurpuldok."},{"id":"semetey-1-2013:p0950:b004:l019","ordinal":148654,"en":"Those wretched Chinese,"},{"id":"semetey-1-2013:p0950:b004:l020","ordinal":148655,"en":"Their horses had become countless;"},{"id":"semetey-1-2013:p0950:b004:l021","ordinal":148656,"en":"They had grown immensely rich."},{"id":"semetey-1-2013:p0950:b004:l022","ordinal":148657,"en":"The reason he had grown rich:"},{"id":"semetey-1-2013:p0950:b004:l023","ordinal":148658,"en":"He was the powerful khan of the monks."},{"id":"semetey-1-2013:p0950:b004:l024","ordinal":148659,"en":"His monks had different customs;"},{"id":"semetey-1-2013:p0950:b004:l026","ordinal":148660,"en":"When someone died, their custom","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0950:b004:l027","ordinal":148661,"en":"Was to divide the dead man's livestock equally."},{"id":"semetey-1-2013:p0950:b004:l028","ordinal":148662,"en":"He set his he-goat apart as sacred,"},{"id":"semetey-1-2013:p0950:b004:l029","ordinal":148663,"en":"The horse he rode was sacred,"},{"id":"semetey-1-2013:p0950:b004:l030","ordinal":148664,"en":"And he kept apart from women."},{"id":"semetey-1-2013:p0950:b004:l031","ordinal":148665,"en":"He saddled his unbroken horse."},{"id":"semetey-1-2013:p0950:b004:l032","ordinal":148666,"en":"A great idol the size of a house,"},{"id":"semetey-1-2013:p0950:b004:l033","ordinal":148667,"en":"Calling it 'God,'"},{"id":"semetey-1-2013:p0950:b004:l034","ordinal":148668,"en":"He bowed and worshiped."},{"id":"semetey-1-2013:p0950:b004:l035","ordinal":148669,"en":"With a cotton sash and broad boots,"},{"id":"semetey-1-2013:p0950:b004:l036","ordinal":148670,"en":"Kongurbai, khan of the monks,"},{"id":"semetey-1-2013:p0950:b004:l037","ordinal":148671,"en":"Emerged from the ford, massive,"},{"id":"semetey-1-2013:p0950:b004:l038","ordinal":148672,"en":"Making the swift Algara lunge,"},{"id":"semetey-1-2013:p0950:b004:l039","ordinal":148673,"en":"Tugging at his golden lead rope,"},{"id":"semetey-1-2013:p0951:b003:l001","ordinal":148674,"en":"He was a handsome man,"},{"id":"semetey-1-2013:p0951:b003:l002","ordinal":148675,"en":"A powerful khan of the monks."},{"id":"semetey-1-2013:p0951:b003:l003","ordinal":148676,"en":"Great boots stood proudly on his feet,"},{"id":"semetey-1-2013:p0951:b003:l004","ordinal":148677,"en":"His neck held high like a rooster's,"},{"id":"semetey-1-2013:p0951:b003:l005","ordinal":148678,"en":"His spectacles gleamed."},{"id":"semetey-1-2013:p0951:b003:l006","ordinal":148679,"en":"A coral stone as large as a flask"},{"id":"semetey-1-2013:p0951:b003:l007","ordinal":148680,"en":"Shone upon his head."},{"id":"semetey-1-2013:p0951:b003:l008","ordinal":148681,"en":"The sight troubled the heart."},{"id":"semetey-1-2013:p0951:b003:l009","ordinal":148682,"en":"Gray-mottled of beard, the huge Manchu"},{"id":"semetey-1-2013:p0951:b003:l010","ordinal":148683,"en":"Appeared like Opol-Too."},{"id":"semetey-1-2013:p0951:b003:l011","ordinal":148684,"en":"His graying mustache"},{"id":"semetey-1-2013:p0951:b003:l012","ordinal":148685,"en":"Was like a greasy axe handle;"},{"id":"semetey-1-2013:p0951:b003:l013","ordinal":148686,"en":"The size of his nose"},{"id":"semetey-1-2013:p0951:b003:l014","ordinal":148687,"en":"Was like a saber sheath."},{"id":"semetey-1-2013:p0951:b003:l015","ordinal":148688,"en":"The corners of his two eyes"},{"id":"semetey-1-2013:p0951:b003:l016","ordinal":148689,"en":"Were like open graves."},{"id":"semetey-1-2013:p0951:b003:l017","ordinal":148690,"en":"If one looked at his moon-like brow,"},{"id":"semetey-1-2013:p0951:b003:l018","ordinal":148691,"en":"It was like an upland where a rich man summered."},{"id":"semetey-1-2013:p0951:b003:l019","ordinal":148692,"en":"His bravery was extraordinary,"},{"id":"semetey-1-2013:p0951:b003:l020","ordinal":148693,"en":"His strength was immense."},{"id":"semetey-1-2013:p0951:b003:l021","ordinal":148694,"en":"A painted pipe with a golden stem,"},{"id":"semetey-1-2013:p0951:b003:l022","ordinal":148695,"en":"The great Kalcha as big as a hut,"},{"id":"semetey-1-2013:p0951:b003:l023","ordinal":148696,"en":"Sixty Chinese and forty kaldais—"},{"id":"semetey-1-2013:p0951:b003:l024","ordinal":148697,"en":"To inspect those horses,"},{"id":"semetey-1-2013:p0951:b003:l025","ordinal":148698,"en":"The exceedingly mighty Kongurbai,"},{"id":"semetey-1-2013:p0951:b003:l026","ordinal":148699,"en":"His pipe with its golden stem"},{"id":"semetey-1-2013:p0951:b003:l027","ordinal":148700,"en":"He displayed with ceremony."},{"id":"semetey-1-2013:p0951:b003:l028","ordinal":148701,"en":"Tobacco from a dungurchok box,"},{"id":"semetey-1-2013:p0951:b003:l029","ordinal":148702,"en":"Taking it in handfuls, Kongurbai"},{"id":"semetey-1-2013:p0951:b003:l030","ordinal":148703,"en":"Put it in four times."},{"id":"semetey-1-2013:p0951:b003:l031","ordinal":148704,"en":"Know from this that he was a giant."},{"id":"semetey-1-2013:p0951:b003:l032","ordinal":148705,"en":"That painted pipe—"},{"id":"semetey-1-2013:p0951:b003:l033","ordinal":148706,"en":"With Chinese flint and firesteel,"},{"id":"semetey-1-2013:p0951:b003:l034","ordinal":148707,"en":"Kongurbai struck sparks."},{"id":"semetey-1-2013:p0951:b003:l036","ordinal":148708,"en":"Putting fire in his pipe,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0951:b003:l037","ordinal":148709,"en":"Your wretch, his craving roused,"},{"id":"semetey-1-2013:p0951:b003:l038","ordinal":148710,"en":"Drew upon it with a gurgling sound."},{"id":"semetey-1-2013:p0951:b003:l039","ordinal":148711,"en":"When he opened his cavernous mouth,"},{"id":"semetey-1-2013:p0951:b004:l001","ordinal":148712,"en":"The smoke in his cheeks,"},{"id":"semetey-1-2013:p0951:b004:l002","ordinal":148713,"en":"When he expelled every bit of it,"},{"id":"semetey-1-2013:p0951:b004:l003","ordinal":148714,"en":"Letting it out with a rumble,"},{"id":"semetey-1-2013:p0951:b004:l004","ordinal":148715,"en":"Billowing like smoke from an earth-pit smokehouse,"},{"id":"semetey-1-2013:p0951:b004:l005","ordinal":148716,"en":"A low fog descended, rolling."},{"id":"semetey-1-2013:p0951:b004:l006","ordinal":148717,"en":"Sixty Chinese and forty kaldais"},{"id":"semetey-1-2013:p0951:b004:l007","ordinal":148718,"en":"Lost their way, crying out,"},{"id":"semetey-1-2013:p0951:b004:l008","ordinal":148719,"en":"Unable to find one another."},{"id":"semetey-1-2013:p0951:b004:l009","ordinal":148720,"en":"Confused and lost,"},{"id":"semetey-1-2013:p0951:b004:l010","ordinal":148721,"en":"While the kaldais stood thus,"},{"id":"semetey-1-2013:p0951:b004:l011","ordinal":148722,"en":"Bending his knees toward the ground,"},{"id":"semetey-1-2013:p0951:b004:l012","ordinal":148723,"en":"That one whose wish should never be granted,"},{"id":"semetey-1-2013:p0951:b004:l013","ordinal":148724,"en":"From Algara's back"},{"id":"semetey-1-2013:p0951:b004:l014","ordinal":148725,"en":"Sprang down in haste."},{"id":"semetey-1-2013:p0951:b004:l015","ordinal":148726,"en":"His life had reached"},{"id":"semetey-1-2013:p0951:b004:l016","ordinal":148727,"en":"A full ninety-five years."},{"id":"semetey-1-2013:p0951:b004:l018","ordinal":148728,"en":"That was the state he had reached.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0951:b004:l019","ordinal":148729,"en":"Facing west,"},{"id":"semetey-1-2013:p0951:b004:l021","ordinal":148730,"en":"He did not squat upon the ground to urinate,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0951:b004:l022","ordinal":148731,"en":"His garment's hem did not touch the earth."},{"id":"semetey-1-2013:p0951:b004:l023","ordinal":148732,"en":"When he had finished urinating,"},{"id":"semetey-1-2013:p0951:b004:l024","ordinal":148733,"en":"He turned and mounted again,"},{"id":"semetey-1-2013:p0951:b004:l025","ordinal":148734,"en":"Hastily mounted at once,"},{"id":"semetey-1-2013:p0951:b004:l026","ordinal":148735,"en":"Headed toward the horses,"},{"id":"semetey-1-2013:p0951:b004:l027","ordinal":148736,"en":"And that wretch rode away."}]
