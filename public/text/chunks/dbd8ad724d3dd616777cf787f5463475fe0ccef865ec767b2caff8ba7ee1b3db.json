[{"id":"semetey-2-2013:p1038:b003:l028","ordinal":266497,"en":"Felling them with my whip,"},{"id":"semetey-2-2013:p1038:b003:l029","ordinal":266498,"en":"And drive the wailing Kazakhs"},{"id":"semetey-2-2013:p1038:b003:l030","ordinal":266499,"en":"Toward Sary-Arka."},{"id":"semetey-2-2013:p1038:b003:l031","ordinal":266500,"en":"I shall drive the sprawling swine"},{"id":"semetey-2-2013:p1038:b003:l032","ordinal":266501,"en":"Into Sary-Arka."},{"id":"semetey-2-2013:p1038:b003:l033","ordinal":266502,"en":"I shall pen them among the reeds,"},{"id":"semetey-2-2013:p1038:b003:l034","ordinal":266503,"en":"And gallop straight at"},{"id":"semetey-2-2013:p1038:b003:l035","ordinal":266504,"en":"The raving Ümötöy himself."},{"id":"semetey-2-2013:p1038:b003:l036","ordinal":266505,"en":"Whether I should attack or not,"},{"id":"semetey-2-2013:p1038:b003:l037","ordinal":266506,"en":"I shall seek my bloodthirsty elder’s answer."},{"id":"semetey-2-2013:p1038:b003:l038","ordinal":266507,"en":"Then I shall wreak devastation"},{"id":"semetey-2-2013:p1038:b003:l039","ordinal":266508,"en":"And turmoil among the Kazakhs."},{"id":"semetey-2-2013:p1038:b004:l001","ordinal":266509,"en":"Ümötöy of Khan Köksö,"},{"id":"semetey-2-2013:p1038:b004:l002","ordinal":266510,"en":"It is true that you are a grim warrior;"},{"id":"semetey-2-2013:p1038:b004:l003","ordinal":266511,"en":"Like thoroughly tempered iron,"},{"id":"semetey-2-2013:p1038:b004:l004","ordinal":266512,"en":"It is true that you are strong."},{"id":"semetey-2-2013:p1038:b004:l005","ordinal":266513,"en":"Known among the people,"},{"id":"semetey-2-2013:p1038:b004:l006","ordinal":266514,"en":"It is true that you are a lion;"},{"id":"semetey-2-2013:p1038:b004:l007","ordinal":266515,"en":"It is true that you can"},{"id":"semetey-2-2013:p1038:b004:l008","ordinal":266516,"en":"Deal with multitudes."},{"id":"semetey-2-2013:p1038:b004:l009","ordinal":266517,"en":"Warrior, it is true that you can"},{"id":"semetey-2-2013:p1038:b004:l010","ordinal":266518,"en":"Ride against the Kyrgyz and wreak slaughter."},{"id":"semetey-2-2013:p1038:b004:l011","ordinal":266519,"en":"Black-maned leopard,"},{"id":"semetey-2-2013:p1038:b004:l012","ordinal":266520,"en":"I shall go to my khan and elder,"},{"id":"semetey-2-2013:p1038:b004:l013","ordinal":266521,"en":"My noble elder Semetey,"},{"id":"semetey-2-2013:p1038:b004:l014","ordinal":266522,"en":"And firmly seek his counsel."},{"id":"semetey-2-2013:p1038:b004:l015","ordinal":266523,"en":"If my elder speaks"},{"id":"semetey-2-2013:p1038:b004:l016","ordinal":266524,"en":"And says, ‘I will pay the blood-price"},{"id":"semetey-2-2013:p1038:b004:l017","ordinal":266525,"en":"For your father, gray-maned Köksö,’"},{"id":"semetey-2-2013:p1038:b004:l018","ordinal":266526,"en":"We shall accept his word."},{"id":"semetey-2-2013:p1038:b004:l019","ordinal":266527,"en":"With gold by the foot and precious ornaments,"},{"id":"semetey-2-2013:p1038:b004:l020","ordinal":266528,"en":"We shall pay your father’s blood-price."},{"id":"semetey-2-2013:p1038:b004:l021","ordinal":266529,"en":"I have many full-grown beasts,"},{"id":"semetey-2-2013:p1038:b004:l022","ordinal":266530,"en":"Their fore-saddles sagging,"},{"id":"semetey-2-2013:p1038:b004:l023","ordinal":266531,"en":"Their twin humps bulging;"},{"id":"semetey-2-2013:p1038:b004:l024","ordinal":266532,"en":"I have many fine animals of great worth."},{"id":"semetey-2-2013:p1038:b004:l025","ordinal":266533,"en":"To those who understand, this is my honor:"},{"id":"semetey-2-2013:p1038:b004:l026","ordinal":266534,"en":"Let us be friends and not revile each other!”"},{"id":"semetey-2-2013:p1038:b004:l027","ordinal":266535,"en":"After pondering in this way,"},{"id":"semetey-2-2013:p1038:b004:l028","ordinal":266536,"en":"He said to Ümötöy:"},{"id":"semetey-2-2013:p1038:b004:l029","ordinal":266537,"en":"“I have means to pay the blood-price."},{"id":"semetey-2-2013:p1038:b004:l030","ordinal":266538,"en":"I will not strike you on this little ridge;"},{"id":"semetey-2-2013:p1038:b004:l031","ordinal":266539,"en":"Wait here, valiant gray-maned warrior."},{"id":"semetey-2-2013:p1038:b004:l032","ordinal":266540,"en":"The man I must face is Semetey;"},{"id":"semetey-2-2013:p1038:b004:l033","ordinal":266541,"en":"I shall not be gone longer than a mare’s milking."},{"id":"semetey-2-2013:p1038:b004:l034","ordinal":266542,"en":"My gray-maned elder Semetey—"},{"id":"semetey-2-2013:p1038:b004:l035","ordinal":266543,"en":"I shall go to Semetey."},{"id":"semetey-2-2013:p1038:b004:l036","ordinal":266544,"en":"I have my lord Bakay,"},{"id":"semetey-2-2013:p1038:b004:l037","ordinal":266545,"en":"Blessed by every saint,"},{"id":"semetey-2-2013:p1038:b004:l038","ordinal":266546,"en":"Father of this multitude of people."},{"id":"semetey-2-2013:p1038:b004:l039","ordinal":266547,"en":"I have my mother Kanykey,"},{"id":"semetey-2-2013:p1039:b003:l001","ordinal":266548,"en":"Who bore a lion for all the world."},{"id":"semetey-2-2013:p1039:b003:l002","ordinal":266549,"en":"I shall seek their counsel."},{"id":"semetey-2-2013:p1039:b003:l003","ordinal":266550,"en":"If your claim proves just,"},{"id":"semetey-2-2013:p1039:b003:l004","ordinal":266551,"en":"If my mother deems it fitting,"},{"id":"semetey-2-2013:p1039:b003:l005","ordinal":266552,"en":"We shall agree to what you have said."},{"id":"semetey-2-2013:p1039:b003:l006","ordinal":266553,"en":"What deeds did"},{"id":"semetey-2-2013:p1039:b003:l007","ordinal":266554,"en":"The bloodthirsty leopard Manas commit?"},{"id":"semetey-2-2013:p1039:b003:l008","ordinal":266555,"en":"And what kind of man was this Köksö,"},{"id":"semetey-2-2013:p1039:b003:l009","ordinal":266556,"en":"Who went to Beijing and fell to a bullet?"},{"id":"semetey-2-2013:p1039:b003:l010","ordinal":266557,"en":"If you will not heed my words,"},{"id":"semetey-2-2013:p1039:b003:l011","ordinal":266558,"en":"I shall return afterward.”"},{"id":"semetey-2-2013:p1039:b003:l012","ordinal":266559,"en":"Thus spoke Külchoro:"},{"id":"semetey-2-2013:p1039:b003:l013","ordinal":266560,"en":"“We ourselves are maternal cousins;"},{"id":"semetey-2-2013:p1039:b003:l014","ordinal":266561,"en":"This conduct of yours will bring shame."},{"id":"semetey-2-2013:p1039:b003:l015","ordinal":266562,"en":"You are our maternal cousin."},{"id":"semetey-2-2013:p1039:b003:l016","ordinal":266563,"en":"Until I return, do not stir;"},{"id":"semetey-2-2013:p1039:b003:l017","ordinal":266564,"en":"Remain right here."},{"id":"semetey-2-2013:p1039:b003:l018","ordinal":266565,"en":"Once I have received an answer,"},{"id":"semetey-2-2013:p1039:b003:l019","ordinal":266566,"en":"You may then raise your great quarrel."},{"id":"semetey-2-2013:p1039:b003:l020","ordinal":266567,"en":"Until I gain the hero’s reply"},{"id":"semetey-2-2013:p1039:b003:l021","ordinal":266568,"en":"And send you word,"},{"id":"semetey-2-2013:p1039:b003:l022","ordinal":266569,"en":"If you are strong, if you are a lion,"},{"id":"semetey-2-2013:p1039:b003:l023","ordinal":266570,"en":"If you are truly your father’s son,"},{"id":"semetey-2-2013:p1039:b003:l024","ordinal":266571,"en":"Remain where you stand!”"},{"id":"semetey-2-2013:p1039:b003:l025","ordinal":266572,"en":"So Külchoro"},{"id":"semetey-2-2013:p1039:b003:l026","ordinal":266573,"en":"Entered Aichürök’s palace,"},{"id":"semetey-2-2013:p1039:b003:l027","ordinal":266574,"en":"As evening was falling,"},{"id":"semetey-2-2013:p1039:b003:l028","ordinal":266575,"en":"In the cool late afternoon,"},{"id":"semetey-2-2013:p1039:b003:l029","ordinal":266576,"en":"And came riding in at a trot."},{"id":"semetey-2-2013:p1039:b003:l030","ordinal":266577,"en":"When the people’s games had ended"},{"id":"semetey-2-2013:p1039:b003:l031","ordinal":266578,"en":"And the mares were being released,"},{"id":"semetey-2-2013:p1039:b003:l032","ordinal":266579,"en":"Fiery warrior Külchoro"},{"id":"semetey-2-2013:p1039:b003:l033","ordinal":266580,"en":"Gathered warrior Bakay and Semetey,"},{"id":"semetey-2-2013:p1039:b003:l034","ordinal":266581,"en":"The two of them, together."},{"id":"semetey-2-2013:p1039:b003:l035","ordinal":266582,"en":"In the marshes of Choguldur,"},{"id":"semetey-2-2013:p1039:b003:l036","ordinal":266583,"en":"All the great lords"},{"id":"semetey-2-2013:p1039:b003:l037","ordinal":266584,"en":"Had assembled;"},{"id":"semetey-2-2013:p1039:b003:l038","ordinal":266585,"en":"In the marshes of Üyrülmö"},{"id":"semetey-2-2013:p1039:b003:l039","ordinal":266586,"en":"They had gathered together."},{"id":"semetey-2-2013:p1039:b004:l001","ordinal":266587,"en":"Then Külchoro—"},{"id":"semetey-2-2013:p1039:b004:l002","ordinal":266588,"en":"The lion Choro aided by the sacred patron,"},{"id":"semetey-2-2013:p1039:b004:l003","ordinal":266589,"en":"Immeasurably swift,"},{"id":"semetey-2-2013:p1039:b004:l004","ordinal":266590,"en":"The resounding warrior Choro—"},{"id":"semetey-2-2013:p1039:b004:l005","ordinal":266591,"en":"Spoke quietly but with grave weight,"},{"id":"semetey-2-2013:p1039:b004:l006","ordinal":266592,"en":"And began his words"},{"id":"semetey-2-2013:p1039:b004:l007","ordinal":266593,"en":"To lion Bakay and Semetey:"},{"id":"semetey-2-2013:p1039:b004:l008","ordinal":266594,"en":"“White-bearded elder Bakay, my motherly guardian,"},{"id":"semetey-2-2013:p1039:b004:l009","ordinal":266595,"en":"You, the elder, are here."},{"id":"semetey-2-2013:p1039:b004:l010","ordinal":266596,"en":"Semetey, my protector,"},{"id":"semetey-2-2013:p1039:b004:l011","ordinal":266597,"en":"You, my elder, are here."},{"id":"semetey-2-2013:p1039:b004:l012","ordinal":266598,"en":"Have you seen what I have seen?"},{"id":"semetey-2-2013:p1039:b004:l013","ordinal":266599,"en":"Do you know what I have learned?"},{"id":"semetey-2-2013:p1039:b004:l014","ordinal":266600,"en":"If you have not seen what I have seen,"},{"id":"semetey-2-2013:p1039:b004:l015","ordinal":266601,"en":"Man, if you do not know what I know,"},{"id":"semetey-2-2013:p1039:b004:l016","ordinal":266602,"en":"Have you heard the news"},{"id":"semetey-2-2013:p1039:b004:l017","ordinal":266603,"en":"Of the one who dwells in Sary-Arka,"},{"id":"semetey-2-2013:p1039:b004:l018","ordinal":266604,"en":"Whom no enemy has defeated in battle,"},{"id":"semetey-2-2013:p1039:b004:l019","ordinal":266605,"en":"Who yields his share to no man,"},{"id":"semetey-2-2013:p1039:b004:l020","ordinal":266606,"en":"The fountainhead of the blue river,"},{"id":"semetey-2-2013:p1039:b004:l021","ordinal":266607,"en":"The young champion of Khan Köksö?"},{"id":"semetey-2-2013:p1039:b004:l022","ordinal":266608,"en":"He had ninety beasts slaughtered for his feast,"},{"id":"semetey-2-2013:p1039:b004:l023","ordinal":266609,"en":"And amid the people’s uproar and the nation’s stir,"},{"id":"semetey-2-2013:p1039:b004:l024","ordinal":266610,"en":"Was given the name Warrior Ümötöy."},{"id":"semetey-2-2013:p1039:b004:l025","ordinal":266611,"en":"Warrior Ümötöy has come."},{"id":"semetey-2-2013:p1039:b004:l026","ordinal":266612,"en":"Saying, ‘Pay my father’s blood-price,’"},{"id":"semetey-2-2013:p1039:b004:l027","ordinal":266613,"en":"He has come to besiege the people."},{"id":"semetey-2-2013:p1039:b004:l028","ordinal":266614,"en":"He says he will massacre"},{"id":"semetey-2-2013:p1039:b004:l029","ordinal":266615,"en":"Even the many venerable elders,"},{"id":"semetey-2-2013:p1039:b004:l030","ordinal":266616,"en":"And everyone he sees."},{"id":"semetey-2-2013:p1039:b004:l031","ordinal":266617,"en":"He says he will plunder their goods,"},{"id":"semetey-2-2013:p1039:b004:l032","ordinal":266618,"en":"He says he will sow utter ruin,"},{"id":"semetey-2-2013:p1039:b004:l033","ordinal":266619,"en":"He says he will settle the score in full."},{"id":"semetey-2-2013:p1039:b004:l034","ordinal":266620,"en":"If his father’s blood-price is not paid,"},{"id":"semetey-2-2013:p1039:b004:l035","ordinal":266621,"en":"He says he will raid and desolate the people."},{"id":"semetey-2-2013:p1039:b004:l036","ordinal":266622,"en":"Ümötöy of Khan Köksö—"},{"id":"semetey-2-2013:p1039:b004:l037","ordinal":266623,"en":"If we quarrel and clash with him,"},{"id":"semetey-2-2013:p1039:b004:l038","ordinal":266624,"en":"How can we ever come to terms?"},{"id":"semetey-2-2013:p1039:b004:l039","ordinal":266625,"en":"If we fight in bitter strife,"},{"id":"semetey-2-2013:p1040:b003:l001","ordinal":266626,"en":"Warrior, what will become of us in the end?"},{"id":"semetey-2-2013:p1040:b003:l002","ordinal":266627,"en":"If we choose and mount swift horses,"},{"id":"semetey-2-2013:p1040:b003:l003","ordinal":266628,"en":"Fire guns and draw bows,"},{"id":"semetey-2-2013:p1040:b003:l004","ordinal":266629,"en":"And thunder forward in pursuit,"},{"id":"semetey-2-2013:p1040:b003:l005","ordinal":266630,"en":"What will become of our blood?”"},{"id":"semetey-2-2013:p1040:b003:l006","ordinal":266631,"en":"So Külchoro"},{"id":"semetey-2-2013:p1040:b003:l007","ordinal":266632,"en":"Recounted the lay of the warrior,"},{"id":"semetey-2-2013:p1040:b003:l008","ordinal":266633,"en":"The mighty infidel, Köksö’s son."},{"id":"semetey-2-2013:p1040:b003:l009","ordinal":266634,"en":"There he stood and sang it."},{"id":"semetey-2-2013:p1040:b003:l010","ordinal":266635,"en":"He truthfully told"},{"id":"semetey-2-2013:p1040:b003:l011","ordinal":266636,"en":"What he had seen and learned."},{"id":"semetey-2-2013:p1040:b003:l012","ordinal":266637,"en":"He revealed the intentions"},{"id":"semetey-2-2013:p1040:b003:l013","ordinal":266638,"en":"Of the Kazakh who had come to meet them."},{"id":"semetey-2-2013:p1040:b003:l014","ordinal":266639,"en":"When Külchoro had spoken thus,"},{"id":"semetey-2-2013:p1040:b003:l015","ordinal":266640,"en":"His elder, lion Bakay—"},{"id":"semetey-2-2013:p1040:b003:l016","ordinal":266641,"en":"Behold his surpassing wisdom—"},{"id":"semetey-2-2013:p1040:b003:l017","ordinal":266642,"en":"Said, “That hero Ümötöy,"},{"id":"semetey-2-2013:p1040:b003:l018","ordinal":266643,"en":"Born to Khan Köksö,"},{"id":"semetey-2-2013:p1040:b003:l019","ordinal":266644,"en":"Has stirred turmoil across many lands."},{"id":"semetey-2-2013:p1040:b003:l020","ordinal":266645,"en":"You see what sort of man he is:"},{"id":"semetey-2-2013:p1040:b003:l021","ordinal":266646,"en":"His banner is motley, his spear brass,"},{"id":"semetey-2-2013:p1040:b003:l022","ordinal":266647,"en":"His horse swift and thunderous,"},{"id":"semetey-2-2013:p1040:b003:l023","ordinal":266648,"en":"His great lungs pounding,"},{"id":"semetey-2-2013:p1040:b003:l024","ordinal":266649,"en":"A sour-buttermilk, woolen-kurut,"},{"id":"semetey-2-2013:p1040:b003:l025","ordinal":266650,"en":"Empty-chested braggart."},{"id":"semetey-2-2013:p1040:b003:l026","ordinal":266651,"en":"To that broad-chested Kazakh,"},{"id":"semetey-2-2013:p1040:b003:l027","ordinal":266652,"en":"That swaggering scourge,"},{"id":"semetey-2-2013:p1040:b003:l028","ordinal":266653,"en":"Make a gift of sixty horses,"},{"id":"semetey-2-2013:p1040:b003:l029","ordinal":266654,"en":"With a stallion at their head."},{"id":"semetey-2-2013:p1040:b003:l030","ordinal":266655,"en":"Without dispute or quarrel,"},{"id":"semetey-2-2013:p1040:b003:l031","ordinal":266656,"en":"Make true peace with him!"},{"id":"semetey-2-2013:p1040:b003:l032","ordinal":266657,"en":"His father Köksö was a hero;"},{"id":"semetey-2-2013:p1040:b003:l033","ordinal":266658,"en":"He had long been"},{"id":"semetey-2-2013:p1040:b003:l034","ordinal":266659,"en":"A sworn comrade to Manas."},{"id":"semetey-2-2013:p1040:b003:l035","ordinal":266660,"en":"Every intention of his was pure;"},{"id":"semetey-2-2013:p1040:b003:l036","ordinal":266661,"en":"The magnanimous Manas and warrior Köksö"},{"id":"semetey-2-2013:p1040:b003:l037","ordinal":266662,"en":"Were true brothers and husbands of sisters."},{"id":"semetey-2-2013:p1040:b003:l038","ordinal":266663,"en":"When they rode to besiege the khan,"},{"id":"semetey-2-2013:p1040:b003:l039","ordinal":266664,"en":"When they brought slaughter upon the Chinese,"},{"id":"semetey-2-2013:p1040:b004:l001","ordinal":266665,"en":"It was Khan Köksö"},{"id":"semetey-2-2013:p1040:b004:l002","ordinal":266666,"en":"Who turned his blue-dappled charger’s head."},{"id":"semetey-2-2013:p1040:b004:l003","ordinal":266667,"en":"Unflinching beneath the banner,"},{"id":"semetey-2-2013:p1040:b004:l004","ordinal":266668,"en":"He stood firm as a fortress."},{"id":"semetey-2-2013:p1040:b004:l005","ordinal":266669,"en":"Strong in majesty and fierce in wrath,"},{"id":"semetey-2-2013:p1040:b004:l006","ordinal":266670,"en":"Köksö, son of Aydarkan,"},{"id":"semetey-2-2013:p1040:b004:l007","ordinal":266671,"en":"Was the mainstay of countless souls."},{"id":"semetey-2-2013:p1040:b004:l008","ordinal":266672,"en":"He was a khan who subdued"},{"id":"semetey-2-2013:p1040:b004:l009","ordinal":266673,"en":"Chynmachyn and the Khagan’s realm."},{"id":"semetey-2-2013:p1040:b004:l010","ordinal":266674,"en":"When they entered Beijing, their wives were kin;"},{"id":"semetey-2-2013:p1040:b004:l011","ordinal":266675,"en":"Köksö and Manas had matching names,"},{"id":"semetey-2-2013:p1040:b004:l012","ordinal":266676,"en":"And such was his valor."},{"id":"semetey-2-2013:p1040:b004:l013","ordinal":266677,"en":"Five sets of nine mares,"},{"id":"semetey-2-2013:p1040:b004:l014","ordinal":266678,"en":"For God’s sake, for my sake,"},{"id":"semetey-2-2013:p1040:b004:l015","ordinal":266679,"en":"And for the sake of the lions Köksö and Manas—"},{"id":"semetey-2-2013:p1040:b004:l016","ordinal":266680,"en":"Go and present them as a gift."},{"id":"semetey-2-2013:p1040:b004:l017","ordinal":266681,"en":"Heed the words I have spoken;"},{"id":"semetey-2-2013:p1040:b004:l018","ordinal":266682,"en":"Give grim-hearted Ümötöy"},{"id":"semetey-2-2013:p1040:b004:l019","ordinal":266683,"en":"Whatever he desires."},{"id":"semetey-2-2013:p1040:b004:l020","ordinal":266684,"en":"Go before him without hostility,"},{"id":"semetey-2-2013:p1040:b004:l021","ordinal":266685,"en":"Saying, ‘Come and go freely among us."},{"id":"semetey-2-2013:p1040:b004:l022","ordinal":266686,"en":"True gray-maned warrior,"},{"id":"semetey-2-2013:p1040:b004:l023","ordinal":266687,"en":"Recognize our kinship,’"},{"id":"semetey-2-2013:p1040:b004:l024","ordinal":266688,"en":"And make him your kinsman.”"},{"id":"semetey-2-2013:p1040:b004:l025","ordinal":266689,"en":"After Bakay had spoken these words,"},{"id":"semetey-2-2013:p1040:b004:l026","ordinal":266690,"en":"Straining to have her say,"},{"id":"semetey-2-2013:p1040:b004:l027","ordinal":266691,"en":"With wisdom inspired from the unseen,"},{"id":"semetey-2-2013:p1040:b004:l028","ordinal":266692,"en":"Kanykey’s turn came."},{"id":"semetey-2-2013:p1040:b004:l029","ordinal":266693,"en":"Then Kanykey said:"},{"id":"semetey-2-2013:p1040:b004:l030","ordinal":266694,"en":"“My princely sons, listen;"},{"id":"semetey-2-2013:p1040:b004:l031","ordinal":266695,"en":"I have a remarkable tale to tell."},{"id":"semetey-2-2013:p1040:b004:l032","ordinal":266696,"en":"If I speak and lament at length,"},{"id":"semetey-2-2013:p1040:b004:l033","ordinal":266697,"en":"The words themselves are precious before God."},{"id":"semetey-2-2013:p1040:b004:l034","ordinal":266698,"en":"In Karakhan’s household"},{"id":"semetey-2-2013:p1040:b004:l035","ordinal":266699,"en":"There were exactly twelve of us girls."},{"id":"semetey-2-2013:p1040:b004:l036","ordinal":266700,"en":"The eldest of the twelve"},{"id":"semetey-2-2013:p1040:b004:l037","ordinal":266701,"en":"Was Akerkech, whom Köksö married;"},{"id":"semetey-2-2013:p1040:b004:l038","ordinal":266702,"en":"Burulkan, whom Buudaykan married;"},{"id":"semetey-2-2013:p1040:b004:l039","ordinal":266703,"en":"Jaynake, whom Jamgyrchy married;"},{"id":"semetey-2-2013:p1041:b003:l001","ordinal":266704,"en":"Ayneke, whom Teke married;"},{"id":"semetey-2-2013:p1041:b003:l002","ordinal":266705,"en":"Oyumkan, whom Ormonbek married;"},{"id":"semetey-2-2013:p1041:b003:l003","ordinal":266706,"en":"And Kanykey, whom Manas married—"},{"id":"semetey-2-2013:p1041:b003:l004","ordinal":266707,"en":"There were twelve of us girls."},{"id":"semetey-2-2013:p1041:b003:l005","ordinal":266708,"en":"We were foals of one stallion,"},{"id":"semetey-2-2013:p1041:b003:l006","ordinal":266709,"en":"Children of one father."},{"id":"semetey-2-2013:p1041:b003:l007","ordinal":266710,"en":"We were gentle souls."},{"id":"semetey-2-2013:p1041:b003:l008","ordinal":266711,"en":"The power to discern from afar"},{"id":"semetey-2-2013:p1041:b003:l009","ordinal":266712,"en":"Was Akerkech’s gift."},{"id":"semetey-2-2013:p1041:b003:l010","ordinal":266713,"en":"While his father Köksö lived,"},{"id":"semetey-2-2013:p1041:b003:l011","ordinal":266714,"en":"It was ever the Kazakh custom"},{"id":"semetey-2-2013:p1041:b003:l012","ordinal":266715,"en":"To bluster loudly."},{"id":"semetey-2-2013:p1041:b003:l013","ordinal":266716,"en":"Ah, my river’s fountainhead,"},{"id":"semetey-2-2013:p1041:b003:l014","ordinal":266717,"en":"My champion, seen only in my old age!"},{"id":"semetey-2-2013:p1041:b003:l015","ordinal":266718,"en":"I was a forlorn soul in my bridal youth,"},{"id":"semetey-2-2013:p1041:b003:l016","ordinal":266719,"en":"And late indeed to braid my hair."},{"id":"semetey-2-2013:p1041:b003:l017","ordinal":266720,"en":"From the imposing Manas,"},{"id":"semetey-2-2013:p1041:b003:l018","ordinal":266721,"en":"My foal, I bore you when I was near death."},{"id":"semetey-2-2013:p1041:b003:l019","ordinal":266722,"en":"You who stirred turmoil throughout the world—"},{"id":"semetey-2-2013:p1041:b003:l020","ordinal":266723,"en":"Semetey and Ümötöy,"},{"id":"semetey-2-2013:p1041:b003:l021","ordinal":266724,"en":"You two maternal cousins"},{"id":"semetey-2-2013:p1041:b003:l022","ordinal":266725,"en":"Were born on the same day."},{"id":"semetey-2-2013:p1041:b003:l023","ordinal":266726,"en":"Ninety beasts were slaughtered at your feasts,"},{"id":"semetey-2-2013:p1041:b003:l024","ordinal":266727,"en":"And you were given matching names."},{"id":"semetey-2-2013:p1041:b003:l025","ordinal":266728,"en":"You were maternal cousins;"},{"id":"semetey-2-2013:p1041:b003:l026","ordinal":266729,"en":"Kinship bound you."},{"id":"semetey-2-2013:p1041:b003:l027","ordinal":266730,"en":"No good comes from striking one’s kin;"},{"id":"semetey-2-2013:p1041:b003:l028","ordinal":266731,"en":"Two true men should not oppose each other."},{"id":"semetey-2-2013:p1041:b003:l029","ordinal":266732,"en":"One should never attack a close relation;"},{"id":"semetey-2-2013:p1041:b003:l030","ordinal":266733,"en":"No good comes from spilling kindred blood."},{"id":"semetey-2-2013:p1041:b003:l031","ordinal":266734,"en":"Accept what he says;"},{"id":"semetey-2-2013:p1041:b003:l032","ordinal":266735,"en":"Give him whatever he desires—"},{"id":"semetey-2-2013:p1041:b003:l033","ordinal":266736,"en":"Abundant wealth and countless herds!"},{"id":"semetey-2-2013:p1041:b003:l034","ordinal":266737,"en":"Send him peacefully on his way;"},{"id":"semetey-2-2013:p1041:b003:l035","ordinal":266738,"en":"Make peace without hostility"},{"id":"semetey-2-2013:p1041:b003:l036","ordinal":266739,"en":"And remain on friendly terms!"},{"id":"semetey-2-2013:p1041:b003:l037","ordinal":266740,"en":"The reason you must do this is that"},{"id":"semetey-2-2013:p1041:b003:l038","ordinal":266741,"en":"My elder sister Akerkech"},{"id":"semetey-2-2013:p1041:b003:l039","ordinal":266742,"en":"Was a woman revered by all,"},{"id":"semetey-2-2013:p1041:b005:l001","ordinal":266743,"en":"A blessed lady."},{"id":"semetey-2-2013:p1041:b005:l002","ordinal":266744,"en":"She was one for whom the white felt was spread,"},{"id":"semetey-2-2013:p1041:b005:l003","ordinal":266745,"en":"And among unfortunate womankind"},{"id":"semetey-2-2013:p1041:b005:l004","ordinal":266746,"en":"She possessed sacred power."},{"id":"semetey-2-2013:p1041:b005:l005","ordinal":266747,"en":"With lambent, sheep-like eyes,"},{"id":"semetey-2-2013:p1041:b005:l006","ordinal":266748,"en":"A fair face without a freckle,"},{"id":"semetey-2-2013:p1041:b005:l007","ordinal":266749,"en":"A stately neck and radiant eyes,"},{"id":"semetey-2-2013:p1041:b005:l008","ordinal":266750,"en":"Sweet in speech, with a honeyed tongue—"},{"id":"semetey-2-2013:p1041:b005:l009","ordinal":266751,"en":"No woman like her exists in all the world."},{"id":"semetey-2-2013:p1041:b005:l010","ordinal":266752,"en":"Full and radiant as the full moon,"}]
