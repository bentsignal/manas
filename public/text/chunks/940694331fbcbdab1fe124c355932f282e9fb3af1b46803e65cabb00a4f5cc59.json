[{"id":"semetey-2-2013:p0049:b005:l031","ordinal":189953,"en":"As though he would never see his Chinese again,"},{"id":"semetey-2-2013:p0049:b005:l032","ordinal":189954,"en":"Karagul stood grieving."},{"id":"semetey-2-2013:p0049:b005:l033","ordinal":189955,"en":"With a cotton sash and broad boots,"},{"id":"semetey-2-2013:p0049:b005:l034","ordinal":189956,"en":"The hulking great Kalmyk,"},{"id":"semetey-2-2013:p0049:b005:l035","ordinal":189957,"en":"With a leather saddle-cloth and twisted waist,"},{"id":"semetey-2-2013:p0049:b005:l036","ordinal":189958,"en":"The rank-smelling warrior Kalmyk—"},{"id":"semetey-2-2013:p0049:b005:l037","ordinal":189959,"en":"At the sight of him the heart was divided;"},{"id":"semetey-2-2013:p0049:b005:l038","ordinal":189960,"en":"Among all sons of men ever created,"},{"id":"semetey-2-2013:p0049:b005:l039","ordinal":189961,"en":"He appeared the greatest."},{"id":"semetey-2-2013:p0050:b003:l001","ordinal":189962,"en":"Beneath him he had a thoroughbred steed;"},{"id":"semetey-2-2013:p0050:b003:l002","ordinal":189963,"en":"The great blue-gray-bearded Manchu,"},{"id":"semetey-2-2013:p0050:b003:l003","ordinal":189964,"en":"Though he had grown old and might die,"},{"id":"semetey-2-2013:p0050:b003:l004","ordinal":189965,"en":"Still had strength enough to lay waste to the world."},{"id":"semetey-2-2013:p0050:b003:l005","ordinal":189966,"en":"The corners of his two eyes"},{"id":"semetey-2-2013:p0050:b003:l006","ordinal":189967,"en":"Were like graves gaping open;"},{"id":"semetey-2-2013:p0050:b003:l007","ordinal":189968,"en":"His broad forehead spread wide,"},{"id":"semetey-2-2013:p0050:b003:l008","ordinal":189969,"en":"Like the seat of honor occupied by a rich man;"},{"id":"semetey-2-2013:p0050:b003:l009","ordinal":189970,"en":"His upturned mustache"},{"id":"semetey-2-2013:p0050:b003:l010","ordinal":189971,"en":"Was like the handle of a greased axe;"},{"id":"semetey-2-2013:p0050:b003:l011","ordinal":189972,"en":"His huge, jutting nose"},{"id":"semetey-2-2013:p0050:b003:l012","ordinal":189973,"en":"Was like the sheath of a selebe saber."},{"id":"semetey-2-2013:p0050:b003:l013","ordinal":189974,"en":"If you sit and ask of his renown:"},{"id":"semetey-2-2013:p0050:b003:l014","ordinal":189975,"en":"Born in Outer Beijing,"},{"id":"semetey-2-2013:p0050:b003:l015","ordinal":189976,"en":"Kongurbay had stirred such turmoil"},{"id":"semetey-2-2013:p0050:b003:l016","ordinal":189977,"en":"Not only among the Chinese, but throughout the age."},{"id":"semetey-2-2013:p0050:b003:l017","ordinal":189978,"en":"Dust rose wherever he traveled;"},{"id":"semetey-2-2013:p0050:b003:l018","ordinal":189979,"en":"At his voice, life fled."},{"id":"semetey-2-2013:p0050:b003:l019","ordinal":189980,"en":"He was the man who went forth to conflict,"},{"id":"semetey-2-2013:p0050:b003:l020","ordinal":189981,"en":"That was the heedless warrior."},{"id":"semetey-2-2013:p0050:b003:l021","ordinal":189982,"en":"Seeing his courage, the khagan’s men"},{"id":"semetey-2-2013:p0050:b003:l022","ordinal":189983,"en":"Carried out his spoken word."},{"id":"semetey-2-2013:p0050:b003:l023","ordinal":189984,"en":"Against the sudden coming of an enemy,"},{"id":"semetey-2-2013:p0050:b003:l024","ordinal":189985,"en":"They made him the fortress of Outer Beijing."},{"id":"semetey-2-2013:p0050:b003:l025","ordinal":189986,"en":"Have you heard the news?"},{"id":"semetey-2-2013:p0050:b003:l026","ordinal":189987,"en":"He slew whoever fought him;"},{"id":"semetey-2-2013:p0050:b003:l027","ordinal":189988,"en":"The resourceful Kalmyk"},{"id":"semetey-2-2013:p0050:b003:l028","ordinal":189989,"en":"Had cunning as well."},{"id":"semetey-2-2013:p0050:b003:l029","ordinal":189990,"en":"He was a master who knew the enemy’s stratagems,"},{"id":"semetey-2-2013:p0050:b003:l030","ordinal":189991,"en":"And had power as well."},{"id":"semetey-2-2013:p0050:b003:l031","ordinal":189992,"en":"He was the champion displayed for all to see;"},{"id":"semetey-2-2013:p0050:b003:l032","ordinal":189993,"en":"If you came to fight him,"},{"id":"semetey-2-2013:p0050:b003:l033","ordinal":189994,"en":"He was the mightiest khan of the Kechil."},{"id":"semetey-2-2013:p0050:b003:l034","ordinal":189995,"en":"His wisdom was great, his venom strong—"},{"id":"semetey-2-2013:p0050:b003:l035","ordinal":189996,"en":"Have you heard the news?"},{"id":"semetey-2-2013:p0050:b003:l036","ordinal":189997,"en":"He leveled the ground where he fought."},{"id":"semetey-2-2013:p0050:b003:l037","ordinal":189998,"en":"The Kechil khan, the great swine,"},{"id":"semetey-2-2013:p0050:b003:l038","ordinal":189999,"en":"The khan of Beijing, the foremost swine."},{"id":"semetey-2-2013:p0050:b003:l039","ordinal":190000,"en":"The great black horse that pranced"},{"id":"semetey-2-2013:p0050:b004:l001","ordinal":190001,"en":"He sent among the Ong Soloon,"},{"id":"semetey-2-2013:p0050:b004:l002","ordinal":190002,"en":"To have the judges inspect"},{"id":"semetey-2-2013:p0050:b004:l003","ordinal":190003,"en":"What its flesh and form were like."},{"id":"semetey-2-2013:p0050:b004:l004","ordinal":190004,"en":"A golden saddle with arched pommel,"},{"id":"semetey-2-2013:p0050:b004:l005","ordinal":190005,"en":"The doomed one took"},{"id":"semetey-2-2013:p0050:b004:l006","ordinal":190006,"en":"And had placed on Algara."},{"id":"semetey-2-2013:p0050:b004:l007","ordinal":190007,"en":"Sixty wrestlers and countless Soloon,"},{"id":"semetey-2-2013:p0050:b004:l008","ordinal":190008,"en":"Wondering what his plan might be,"},{"id":"semetey-2-2013:p0050:b004:l009","ordinal":190009,"en":"The great white-bearded Manchu"},{"id":"semetey-2-2013:p0050:b004:l010","ordinal":190010,"en":"Frightened all those people."},{"id":"semetey-2-2013:p0050:b004:l011","ordinal":190011,"en":"They fretted and wailed;"},{"id":"semetey-2-2013:p0050:b004:l012","ordinal":190012,"en":"His stricken people cried aloud."},{"id":"semetey-2-2013:p0050:b004:l013","ordinal":190013,"en":"When he had reached old age,"},{"id":"semetey-2-2013:p0050:b004:l014","ordinal":190014,"en":"They asked what would become of the noble hawk:"},{"id":"semetey-2-2013:p0050:b004:l015","ordinal":190015,"en":"“The hairs of his beard are white;"},{"id":"semetey-2-2013:p0050:b004:l016","ordinal":190016,"en":"It seems his time has come to depart on a journey."},{"id":"semetey-2-2013:p0050:b004:l017","ordinal":190017,"en":"Past eighty and nearing ninety,"},{"id":"semetey-2-2013:p0050:b004:l018","ordinal":190018,"en":"Such is his condition now."},{"id":"semetey-2-2013:p0050:b004:l019","ordinal":190019,"en":"Unable to take a companion as escort,"},{"id":"semetey-2-2013:p0050:b004:l020","ordinal":190020,"en":"Unable to take a vast host of ten thousand,"},{"id":"semetey-2-2013:p0050:b004:l021","ordinal":190021,"en":"Alas, the poor old father"},{"id":"semetey-2-2013:p0050:b004:l022","ordinal":190022,"en":"Seems to have grown aged."},{"id":"semetey-2-2013:p0050:b004:l023","ordinal":190023,"en":"Meeting by chance and in vain"},{"id":"semetey-2-2013:p0050:b004:l024","ordinal":190024,"en":"To feud with blood-drinking Manas’s son—"},{"id":"semetey-2-2013:p0050:b004:l025","ordinal":190025,"en":"Is it time for him to set out on his final journey?"},{"id":"semetey-2-2013:p0050:b004:l026","ordinal":190026,"en":"Now that his beard is blue-gray,"},{"id":"semetey-2-2013:p0050:b004:l027","ordinal":190027,"en":"The gray-maned wolf himself will surely not come."},{"id":"semetey-2-2013:p0050:b004:l028","ordinal":190028,"en":"Father, noble hawk, what shall I do?"},{"id":"semetey-2-2013:p0050:b004:l029","ordinal":190029,"en":"Surely he will not see Beijing again.”"},{"id":"semetey-2-2013:p0050:b004:l030","ordinal":190030,"en":"When the Kalmyk mounted to depart,"},{"id":"semetey-2-2013:p0050:b004:l031","ordinal":190031,"en":"His nobles wept and his khan wept,"},{"id":"semetey-2-2013:p0050:b004:l032","ordinal":190032,"en":"All that people wept,"},{"id":"semetey-2-2013:p0050:b004:l033","ordinal":190033,"en":"The mass of people grieving."},{"id":"semetey-2-2013:p0050:b004:l034","ordinal":190034,"en":"“Alas, the poor brave man,"},{"id":"semetey-2-2013:p0050:b004:l035","ordinal":190035,"en":"He has grown old,” they wept."},{"id":"semetey-2-2013:p0050:b004:l036","ordinal":190036,"en":"Whichever one you looked at,"},{"id":"semetey-2-2013:p0050:b004:l037","ordinal":190037,"en":"Wept, consumed by personal grief."},{"id":"semetey-2-2013:p0050:b004:l038","ordinal":190038,"en":"“He was the precious khan we cherished;"},{"id":"semetey-2-2013:p0050:b004:l039","ordinal":190039,"en":"May he return,” they wept."},{"id":"semetey-2-2013:p0051:b003:l001","ordinal":190040,"en":"The sun sank, shimmering,"},{"id":"semetey-2-2013:p0051:b003:l002","ordinal":190041,"en":"And the foremost of the people lay down."},{"id":"semetey-2-2013:p0051:b003:l003","ordinal":190042,"en":"From the encampment with gates of steel,"},{"id":"semetey-2-2013:p0051:b003:l004","ordinal":190043,"en":"From the fortress of Great Beijing,"},{"id":"semetey-2-2013:p0051:b003:l005","ordinal":190044,"en":"Jerking the reins of gold"},{"id":"semetey-2-2013:p0051:b003:l006","ordinal":190045,"en":"And urging Algara onward,"},{"id":"semetey-2-2013:p0051:b003:l007","ordinal":190046,"en":"The Kalcha’s state was such:"},{"id":"semetey-2-2013:p0051:b003:l008","ordinal":190047,"en":"The flesh of his forearms creased as he strained,"},{"id":"semetey-2-2013:p0051:b003:l009","ordinal":190048,"en":"“What is wrong with the dog?” he said,"},{"id":"semetey-2-2013:p0051:b003:l010","ordinal":190049,"en":"Quarreling with Algara."},{"id":"semetey-2-2013:p0051:b003:l011","ordinal":190050,"en":"When Algara opened his stride—"},{"id":"semetey-2-2013:p0051:b003:l012","ordinal":190051,"en":"That unsurpassed great black horse—"},{"id":"semetey-2-2013:p0051:b003:l013","ordinal":190052,"en":"If he stepped upon black stone,"},{"id":"semetey-2-2013:p0051:b003:l014","ordinal":190053,"en":"It burst and crumbled into powder;"},{"id":"semetey-2-2013:p0051:b003:l015","ordinal":190054,"en":"The madman’s black horse"},{"id":"semetey-2-2013:p0051:b003:l016","ordinal":190055,"en":"Flew rumbling like a cloud."},{"id":"semetey-2-2013:p0051:b003:l017","ordinal":190056,"en":"Around the hour of midnight,"},{"id":"semetey-2-2013:p0051:b003:l018","ordinal":190057,"en":"The Kalcha rose in agitation;"},{"id":"semetey-2-2013:p0051:b003:l019","ordinal":190058,"en":"Before midnight had even come,"},{"id":"semetey-2-2013:p0051:b003:l020","ordinal":190059,"en":"He reached the roaring Sary-Suu."},{"id":"semetey-2-2013:p0051:b003:l021","ordinal":190060,"en":"Coming upon the Sary-Suu,"},{"id":"semetey-2-2013:p0051:b003:l022","ordinal":190061,"en":"Algara stretched out his stride."},{"id":"semetey-2-2013:p0051:b003:l023","ordinal":190062,"en":"Was Algara not a thoroughbred?"},{"id":"semetey-2-2013:p0051:b003:l024","ordinal":190063,"en":"At the great roaring river,"},{"id":"semetey-2-2013:p0051:b003:l025","ordinal":190064,"en":"Algara did not draw back,"},{"id":"semetey-2-2013:p0051:b003:l026","ordinal":190065,"en":"But leapt wherever he met it."},{"id":"semetey-2-2013:p0051:b003:l027","ordinal":190066,"en":"To the pasture where the horses had lain,"},{"id":"semetey-2-2013:p0051:b003:l028","ordinal":190067,"en":"To the pass of Kyr-Kaiyng,"},{"id":"semetey-2-2013:p0051:b003:l029","ordinal":190068,"en":"To the shore of the salty Kürpüldök,"},{"id":"semetey-2-2013:p0051:b003:l030","ordinal":190069,"en":"To the horses’ grazing ground,"},{"id":"semetey-2-2013:p0051:b003:l031","ordinal":190070,"en":"Hero Kalcha came riding."},{"id":"semetey-2-2013:p0051:b003:l032","ordinal":190071,"en":"When he looked toward Zholum’s camp,"},{"id":"semetey-2-2013:p0051:b003:l033","ordinal":190072,"en":"Hoping his people were safe,"},{"id":"semetey-2-2013:p0051:b003:l034","ordinal":190073,"en":"The herdsman at Zholum’s camp"},{"id":"semetey-2-2013:p0051:b003:l035","ordinal":190074,"en":"Lay stretched out dead,"},{"id":"semetey-2-2013:p0051:b003:l036","ordinal":190075,"en":"His body remaining, his head gone,"},{"id":"semetey-2-2013:p0051:b003:l037","ordinal":190076,"en":"Plainly and utterly slain."},{"id":"semetey-2-2013:p0051:b003:l038","ordinal":190077,"en":"Dust had been churned in every direction;"},{"id":"semetey-2-2013:p0051:b003:l039","ordinal":190078,"en":"As though a giant beast had trampled it,"},{"id":"semetey-2-2013:p0051:b005:l001","ordinal":190079,"en":"All of Zholum’s camp"},{"id":"semetey-2-2013:p0051:b005:l002","ordinal":190080,"en":"Lay smashed and ground to bits."},{"id":"semetey-2-2013:p0051:b005:l003","ordinal":190081,"en":"“It is true that Karagul"},{"id":"semetey-2-2013:p0051:b005:l004","ordinal":190082,"en":"Saw what happened in this place."},{"id":"semetey-2-2013:p0051:b005:l005","ordinal":190083,"en":"And it is true that all the others"},{"id":"semetey-2-2013:p0051:b005:l006","ordinal":190084,"en":"Have been killed.”"},{"id":"semetey-2-2013:p0051:b005:l007","ordinal":190085,"en":"Then Kongurbai,"},{"id":"semetey-2-2013:p0051:b005:l008","ordinal":190086,"en":"Unable to stand still in his fury—"},{"id":"semetey-2-2013:p0051:b005:l009","ordinal":190087,"en":"With his great moon-crested golden pipe,"},{"id":"semetey-2-2013:p0051:b005:l010","ordinal":190088,"en":"That Kalcha huge as a yurt—"},{"id":"semetey-2-2013:p0051:b005:l011","ordinal":190089,"en":"Into its bowl he thrust"},{"id":"semetey-2-2013:p0051:b005:l012","ordinal":190090,"en":"A great handful of tobacco,"},{"id":"semetey-2-2013:p0051:b005:l013","ordinal":190091,"en":"And now took the pipe in hand."},{"id":"semetey-2-2013:p0051:b005:l014","ordinal":190092,"en":"He struck the Chinese flintstone,"},{"id":"semetey-2-2013:p0051:b005:l015","ordinal":190093,"en":"Set an ember upon it,"},{"id":"semetey-2-2013:p0051:b005:l016","ordinal":190094,"en":"And the keen-minded hero Kalcha"},{"id":"semetey-2-2013:p0051:b005:l017","ordinal":190095,"en":"Drew upon his pipe;"},{"id":"semetey-2-2013:p0051:b005:l018","ordinal":190096,"en":"It rasped aloud in the usual way,"},{"id":"semetey-2-2013:p0051:b005:l019","ordinal":190097,"en":"And when he released the smoke,"},{"id":"semetey-2-2013:p0051:b005:l020","ordinal":190098,"en":"It billowed like a sleeve."},{"id":"semetey-2-2013:p0051:b005:l021","ordinal":190099,"en":"The hair on his crown stood on end:"},{"id":"semetey-2-2013:p0051:b005:l022","ordinal":190100,"en":"“They have slaughtered my herdsmen,” he said,"},{"id":"semetey-2-2013:p0051:b005:l023","ordinal":190101,"en":"“And carried away my horses;"},{"id":"semetey-2-2013:p0051:b005:l024","ordinal":190102,"en":"They have worked another outrage,” he said."},{"id":"semetey-2-2013:p0051:b005:l025","ordinal":190103,"en":"Unable to collect his thoughts,"},{"id":"semetey-2-2013:p0051:b005:l026","ordinal":190104,"en":"He turned Algara’s head."},{"id":"semetey-2-2013:p0051:b005:l027","ordinal":190105,"en":"As though he had endured great grief"},{"id":"semetey-2-2013:p0051:b005:l028","ordinal":190106,"en":"For many days and nights,"},{"id":"semetey-2-2013:p0051:b005:l029","ordinal":190107,"en":"He stood there on that spot."},{"id":"semetey-2-2013:p0051:b005:l030","ordinal":190108,"en":"Kongurbai pursued behind them;"},{"id":"semetey-2-2013:p0051:b005:l031","ordinal":190109,"en":"Let us leave him there,"},{"id":"semetey-2-2013:p0051:b005:l032","ordinal":190110,"en":"And begin the news of Semetey,"},{"id":"semetey-2-2013:p0051:b005:l033","ordinal":190111,"en":"Who was driving the horses:"},{"id":"semetey-2-2013:p0051:b005:l034","ordinal":190112,"en":"Upon a towering mountain ridge,"},{"id":"semetey-2-2013:p0051:b005:l035","ordinal":190113,"en":"On a jutting spur,"},{"id":"semetey-2-2013:p0051:b005:l036","ordinal":190114,"en":"Lay Zhangy-Zher, found by Almambet."},{"id":"semetey-2-2013:p0051:b005:l037","ordinal":190115,"en":"There in Zhangy-Zher itself,"},{"id":"semetey-2-2013:p0051:b005:l038","ordinal":190116,"en":"At the mine where gold was dug—"},{"id":"semetey-2-2013:p0051:b005:l039","ordinal":190117,"en":"Upon the heights above that mine,"},{"id":"semetey-2-2013:p0052:b003:l001","ordinal":190118,"en":"Beneath a plane tree as large as a house,"},{"id":"semetey-2-2013:p0052:b003:l002","ordinal":190119,"en":"Your elder, old Bakai,"},{"id":"semetey-2-2013:p0052:b003:l003","ordinal":190120,"en":"Had removed the saddle"},{"id":"semetey-2-2013:p0052:b003:l004","ordinal":190121,"en":"From Kökcholok beneath him,"},{"id":"semetey-2-2013:p0052:b003:l005","ordinal":190122,"en":"Hobbled him with double fetters,"},{"id":"semetey-2-2013:p0052:b003:l006","ordinal":190123,"en":"Pillowed his head on the blue saddlecloth,"},{"id":"semetey-2-2013:p0052:b003:l007","ordinal":190124,"en":"And lay with his head toward the qibla."},{"id":"semetey-2-2013:p0052:b003:l008","ordinal":190125,"en":"The old man sleeping there"},{"id":"semetey-2-2013:p0052:b003:l009","ordinal":190126,"en":"Started awake from sleep,"},{"id":"semetey-2-2013:p0052:b003:l010","ordinal":190127,"en":"Turned onto his right side,"},{"id":"semetey-2-2013:p0052:b003:l011","ordinal":190128,"en":"Hastily performed his prayer,"},{"id":"semetey-2-2013:p0052:b003:l012","ordinal":190129,"en":"And saddled Kökcholok."},{"id":"semetey-2-2013:p0052:b003:l013","ordinal":190130,"en":"Their elder Bakai, the bringer of good fortune,"},{"id":"semetey-2-2013:p0052:b003:l014","ordinal":190131,"en":"When the dawn shone white,"},{"id":"semetey-2-2013:p0052:b003:l015","ordinal":190132,"en":"And light fell upon the earth,"},{"id":"semetey-2-2013:p0052:b003:l016","ordinal":190133,"en":"Led Aktaigan behind him"},{"id":"semetey-2-2013:p0052:b003:l017","ordinal":190134,"en":"And perched Akshumkar on his hand."},{"id":"semetey-2-2013:p0052:b003:l018","ordinal":190135,"en":"Sent before you, he brought good fortune;"},{"id":"semetey-2-2013:p0052:b003:l019","ordinal":190136,"en":"If you followed him, he was like a myriad troops."},{"id":"semetey-2-2013:p0052:b003:l020","ordinal":190137,"en":"He made known what others did not know—"},{"id":"semetey-2-2013:p0052:b003:l021","ordinal":190138,"en":"The wise old Bakai."},{"id":"semetey-2-2013:p0052:b003:l022","ordinal":190139,"en":"He made men perceive what they had not sensed—"},{"id":"semetey-2-2013:p0052:b003:l023","ordinal":190140,"en":"The true prophet Bakai."},{"id":"semetey-2-2013:p0052:b003:l024","ordinal":190141,"en":"At the empty pasture where no soul moved,"},{"id":"semetey-2-2013:p0052:b003:l025","ordinal":190142,"en":"“Where has Semetey gone?” he said."},{"id":"semetey-2-2013:p0052:b003:l026","ordinal":190143,"en":"On the broad foothill ridge,"},{"id":"semetey-2-2013:p0052:b003:l027","ordinal":190144,"en":"Bakai stood leaning and watched."},{"id":"semetey-2-2013:p0052:b003:l028","ordinal":190145,"en":"“Ride toward Agala, toward Kyzyl-Kum,"},{"id":"semetey-2-2013:p0052:b003:l029","ordinal":190146,"en":"The fatherland of Almambet;"},{"id":"semetey-2-2013:p0052:b003:l030","ordinal":190147,"en":"It was his father’s pasture."},{"id":"semetey-2-2013:p0052:b003:l031","ordinal":190148,"en":"When the soaring black bird,"},{"id":"semetey-2-2013:p0052:b003:l032","ordinal":190149,"en":"The lion Almang, went away,"},{"id":"semetey-2-2013:p0052:b003:l033","ordinal":190150,"en":"He left it behind long ago."},{"id":"semetey-2-2013:p0052:b003:l034","ordinal":190151,"en":"When hardship and an evil day befall you,"},{"id":"semetey-2-2013:p0052:b003:l035","ordinal":190152,"en":"He said it would be your refuge."},{"id":"semetey-2-2013:p0052:b003:l036","ordinal":190153,"en":"Instead of camping at Kyzyl-Kum,"},{"id":"semetey-2-2013:p0052:b003:l037","ordinal":190154,"en":"What word shall I hear of"},{"id":"semetey-2-2013:p0052:b003:l038","ordinal":190155,"en":"The inheritance Manas left behind?"},{"id":"semetey-2-2013:p0052:b003:l039","ordinal":190156,"en":"I will ride out to meet"},{"id":"semetey-2-2013:p0052:b004:l001","ordinal":190157,"en":"The lone one who is my shelter!”"},{"id":"semetey-2-2013:p0052:b004:l002","ordinal":190158,"en":"Saying this, hero Bakai"},{"id":"semetey-2-2013:p0052:b004:l003","ordinal":190159,"en":"Climbed the ridge and looked."},{"id":"semetey-2-2013:p0052:b004:l004","ordinal":190160,"en":"Hoping the boy was safe,"},{"id":"semetey-2-2013:p0052:b004:l005","ordinal":190161,"en":"He raised the hare-foot spyglass in his hand;"},{"id":"semetey-2-2013:p0052:b004:l006","ordinal":190162,"en":"Their elder, old Bakai,"},{"id":"semetey-2-2013:p0052:b004:l007","ordinal":190163,"en":"Opening and closing one eye,"},{"id":"semetey-2-2013:p0052:b004:l008","ordinal":190164,"en":"Looked for Semetey."},{"id":"semetey-2-2013:p0052:b004:l009","ordinal":190165,"en":"He saw him driving the herd with a roar,"},{"id":"semetey-2-2013:p0052:b004:l010","ordinal":190166,"en":"Having raided it entire and whole."},{"id":"semetey-2-2013:p0052:b004:l011","ordinal":190167,"en":"Across Kaspang’s Kara-Talaa,"},{"id":"semetey-2-2013:p0052:b004:l012","ordinal":190168,"en":"Countless black shapes like ants"},{"id":"semetey-2-2013:p0052:b004:l013","ordinal":190169,"en":"Spread glittering over the plain."},{"id":"semetey-2-2013:p0052:b004:l014","ordinal":190170,"en":"The accursed one had taken many animals,"},{"id":"semetey-2-2013:p0052:b004:l015","ordinal":190171,"en":"Not merely a few, but an abundance."},{"id":"semetey-2-2013:p0052:b004:l016","ordinal":190172,"en":"Their hoofbeats made the heavens resound;"},{"id":"semetey-2-2013:p0052:b004:l017","ordinal":190173,"en":"He had taken an endless mass of stock."},{"id":"semetey-2-2013:p0052:b004:l018","ordinal":190174,"en":"He had begun his fury fiercely,"},{"id":"semetey-2-2013:p0052:b004:l019","ordinal":190175,"en":"And slaughtered all the feeble ones,"},{"id":"semetey-2-2013:p0052:b004:l020","ordinal":190176,"en":"Leaving them along the road."},{"id":"semetey-2-2013:p0052:b004:l021","ordinal":190177,"en":"Swaying and streaming onward,"},{"id":"semetey-2-2013:p0052:b004:l022","ordinal":190178,"en":"The barren mares led the herd;"},{"id":"semetey-2-2013:p0052:b004:l023","ordinal":190179,"en":"He had sent the foals shivering"},{"id":"semetey-2-2013:p0052:b004:l024","ordinal":190180,"en":"And killed them in the water."},{"id":"semetey-2-2013:p0052:b004:l025","ordinal":190181,"en":"The whinnying brood mares"},{"id":"semetey-2-2013:p0052:b004:l026","ordinal":190182,"en":"He drove along with heavy steps."},{"id":"semetey-2-2013:p0052:b004:l027","ordinal":190183,"en":"At Echoing Zhar-Kyya,"},{"id":"semetey-2-2013:p0052:b004:l028","ordinal":190184,"en":"They began to file out one by one;"},{"id":"semetey-2-2013:p0052:b004:l029","ordinal":190185,"en":"They streamed over the great ridge."},{"id":"semetey-2-2013:p0052:b004:l030","ordinal":190186,"en":"When they came into that procession,"},{"id":"semetey-2-2013:p0052:b004:l031","ordinal":190187,"en":"Not one horse remained outside the file."},{"id":"semetey-2-2013:p0052:b004:l032","ordinal":190188,"en":"Their elder Bakai examined"},{"id":"semetey-2-2013:p0052:b004:l033","ordinal":190189,"en":"The horses Semetey had brought."},{"id":"semetey-2-2013:p0052:b004:l034","ordinal":190190,"en":"He flared up in anger,"},{"id":"semetey-2-2013:p0052:b004:l035","ordinal":190191,"en":"And in his old age mighty Bakai"},{"id":"semetey-2-2013:p0052:b004:l036","ordinal":190192,"en":"Found grief waiting before him."},{"id":"semetey-2-2013:p0052:b004:l037","ordinal":190193,"en":"His wail split the stones,"},{"id":"semetey-2-2013:p0052:b004:l038","ordinal":190194,"en":"His cry split heads,"},{"id":"semetey-2-2013:p0052:b004:l039","ordinal":190195,"en":"And he halted at Kapka-Tash."},{"id":"semetey-2-2013:p0053:b003:l001","ordinal":190196,"en":"His heart smoked fiercely with grief,"},{"id":"semetey-2-2013:p0053:b003:l002","ordinal":190197,"en":"And he mourned the days gone by."},{"id":"semetey-2-2013:p0053:b003:l003","ordinal":190198,"en":"As though held fast in place,"},{"id":"semetey-2-2013:p0053:b003:l004","ordinal":190199,"en":"Semetey, behind the herd,"},{"id":"semetey-2-2013:p0053:b003:l005","ordinal":190200,"en":"Stopped before Khan Bakai."},{"id":"semetey-2-2013:p0053:b003:l006","ordinal":190201,"en":"Poor Bakai wept long:"},{"id":"semetey-2-2013:p0053:b003:l007","ordinal":190202,"en":"“My gray-maned Manas, companion of my youth,"},{"id":"semetey-2-2013:p0053:b003:l008","ordinal":190203,"en":"If only you had not died!” he wept."},{"id":"semetey-2-2013:p0053:b003:l009","ordinal":190204,"en":"“Manas, my companion, sharer of my soul,"},{"id":"semetey-2-2013:p0053:b003:l010","ordinal":190205,"en":"Parted from you, my soul’s companion,"},{"id":"semetey-2-2013:p0053:b003:l011","ordinal":190206,"en":"You are nowhere among the living,"},{"id":"semetey-2-2013:p0053:b003:l012","ordinal":190207,"en":"Yet nowhere in the grave if called dead."},{"id":"semetey-2-2013:p0053:b003:l013","ordinal":190208,"en":"With a wail that splits stone,"}]
