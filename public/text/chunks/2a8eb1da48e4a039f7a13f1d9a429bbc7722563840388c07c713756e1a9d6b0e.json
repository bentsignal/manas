[{"id":"semetey-1-2013:p0456:b003:l028","ordinal":111617,"en":"He taught to govern the people."},{"id":"semetey-1-2013:p0456:b003:l029","ordinal":111618,"en":"The accursed man who came homeless"},{"id":"semetey-1-2013:p0456:b003:l030","ordinal":111619,"en":"Countless treasures, a white palace—"},{"id":"semetey-1-2013:p0456:b003:l031","ordinal":111620,"en":"He brought him into a house like this."},{"id":"semetey-1-2013:p0456:b003:l032","ordinal":111621,"en":"Your gray-maned father, guileless lion,"},{"id":"semetey-1-2013:p0456:b003:l033","ordinal":111622,"en":"Had the treasury opened."},{"id":"semetey-1-2013:p0456:b003:l034","ordinal":111623,"en":"Countless treasures, accumulated wealth—"},{"id":"semetey-1-2013:p0456:b003:l035","ordinal":111624,"en":"Saying the Kalmyk would become kin,"},{"id":"semetey-1-2013:p0456:b003:l036","ordinal":111625,"en":"He had it scattered and spent."},{"id":"semetey-1-2013:p0456:b003:l037","ordinal":111626,"en":"The man kept slaughtering and eating well-fed foals;"},{"id":"semetey-1-2013:p0456:b003:l038","ordinal":111627,"en":"All about him were words of discord."},{"id":"semetey-1-2013:p0456:b003:l039","ordinal":111628,"en":"“I will be Manas's equal kinsman,” he kept saying."},{"id":"semetey-1-2013:p0456:b004:l001","ordinal":111629,"en":"Drinking his kumys, he grew excited."},{"id":"semetey-1-2013:p0456:b004:l002","ordinal":111630,"en":"Against your lion father Manas,"},{"id":"semetey-1-2013:p0456:b004:l003","ordinal":111631,"en":"Finding no opening, he raged."},{"id":"semetey-1-2013:p0456:b004:l004","ordinal":111632,"en":"Your gray-maned father Manas's"},{"id":"semetey-1-2013:p0456:b004:l005","ordinal":111633,"en":"Liquor he drank in a frenzy."},{"id":"semetey-1-2013:p0456:b004:l006","ordinal":111634,"en":"As I kept watch upon them,"},{"id":"semetey-1-2013:p0456:b004:l007","ordinal":111635,"en":"Against your gray-maned father Manas,"},{"id":"semetey-1-2013:p0456:b004:l008","ordinal":111636,"en":"Unable to find a means, they grew excited."},{"id":"semetey-1-2013:p0456:b004:l009","ordinal":111637,"en":"At the edge of another marsh"},{"id":"semetey-1-2013:p0456:b004:l010","ordinal":111638,"en":"They would draw apart and talk."},{"id":"semetey-1-2013:p0456:b004:l011","ordinal":111639,"en":"When they had drunk their fill of liquor,"},{"id":"semetey-1-2013:p0456:b004:l012","ordinal":111640,"en":"The accursed men spurred one another on."},{"id":"semetey-1-2013:p0456:b004:l014","ordinal":111641,"en":"At your mother Kanykei's Kötörmö,"},{"id":"semetey-1-2013:p0456:b004:l015","ordinal":111642,"en":"On the spur of Kötörmö,"},{"id":"semetey-1-2013:p0456:b004:l016","ordinal":111643,"en":"They dug a passage no one knew,"},{"id":"semetey-1-2013:p0456:b004:l017","ordinal":111644,"en":"“So your father may fall into it,"},{"id":"semetey-1-2013:p0456:b004:l018","ordinal":111645,"en":"So his death may come this way.”"},{"id":"semetey-1-2013:p0456:b004:l019","ordinal":111646,"en":"Into Közkaman's house"},{"id":"semetey-1-2013:p0456:b004:l020","ordinal":111647,"en":"They dug a pit forty rope-lengths long."},{"id":"semetey-1-2013:p0456:b004:l021","ordinal":111648,"en":"The decorated clothes-pole's shaft,"},{"id":"semetey-1-2013:p0456:b004:l022","ordinal":111649,"en":"Their conduct grown somewhat perverse—"},{"id":"semetey-1-2013:p0456:b004:l023","ordinal":111650,"en":"I, your mother, watched and knew:"},{"id":"semetey-1-2013:p0456:b004:l024","ordinal":111651,"en":"Their rite was in the old Kalmyk manner."},{"id":"semetey-1-2013:p0456:b004:l025","ordinal":111652,"en":"Hearing scattered scraps of talk,"},{"id":"semetey-1-2013:p0456:b004:l026","ordinal":111653,"en":"I, the unfortunate one born to suffering,"},{"id":"semetey-1-2013:p0456:b004:l027","ordinal":111654,"en":"Heard that a great bronze idol"},{"id":"semetey-1-2013:p0456:b004:l028","ordinal":111655,"en":"Was in Közkaman's house,"},{"id":"semetey-1-2013:p0456:b004:l029","ordinal":111656,"en":"That they gathered in the dark of night"},{"id":"semetey-1-2013:p0456:b004:l030","ordinal":111657,"en":"And the Kalmyks worshipped it."},{"id":"semetey-1-2013:p0456:b004:l032","ordinal":111658,"en":"Alarmed, thinking over what was said,"},{"id":"semetey-1-2013:p0456:b004:l033","ordinal":111659,"en":"I wondered whether that Kalmyk"},{"id":"semetey-1-2013:p0456:b004:l034","ordinal":111660,"en":"Would bring about my end."},{"id":"semetey-1-2013:p0456:b004:l035","ordinal":111661,"en":"I had long known what he would do."},{"id":"semetey-1-2013:p0456:b004:l036","ordinal":111662,"en":"Against your khan father, that devil—"},{"id":"semetey-1-2013:p0456:b004:l037","ordinal":111663,"en":"I feared what he would do."},{"id":"semetey-1-2013:p0456:b004:l038","ordinal":111664,"en":"Yesterday, the numerous Argyn made for the valley,"},{"id":"semetey-1-2013:p0457:b003:l001","ordinal":111665,"en":"While they were encamped,"},{"id":"semetey-1-2013:p0457:b003:l002","ordinal":111666,"en":"While Argyn and Kyrgyz mingled"},{"id":"semetey-1-2013:p0457:b003:l003","ordinal":111667,"en":"Together there,"},{"id":"semetey-1-2013:p0457:b003:l004","ordinal":111668,"en":"When bored, they shot roe deer;"},{"id":"semetey-1-2013:p0457:b003:l005","ordinal":111669,"en":"When not bored, the forty companions"},{"id":"semetey-1-2013:p0457:b003:l006","ordinal":111670,"en":"Played freely."},{"id":"semetey-1-2013:p0457:b003:l007","ordinal":111671,"en":"When they arranged their entertainment,"},{"id":"semetey-1-2013:p0457:b003:l008","ordinal":111672,"en":"A yellow enclosure, a level riverbank—"},{"id":"semetey-1-2013:p0457:b003:l009","ordinal":111673,"en":"They laid out a forty-pace ordo court."},{"id":"semetey-1-2013:p0457:b003:l010","ordinal":111674,"en":"They shot skillfully at the knucklebones,"},{"id":"semetey-1-2013:p0457:b003:l011","ordinal":111675,"en":"Plunging into their pleasures."},{"id":"semetey-1-2013:p0457:b003:l012","ordinal":111676,"en":"The forty companions split into two sides."},{"id":"semetey-1-2013:p0457:b003:l013","ordinal":111677,"en":"The game of those lion-born heroes"},{"id":"semetey-1-2013:p0457:b003:l014","ordinal":111678,"en":"Was a fine sight."},{"id":"semetey-1-2013:p0457:b003:l015","ordinal":111679,"en":"Forty mares on each side"},{"id":"semetey-1-2013:p0457:b003:l016","ordinal":111680,"en":"They brought and staked."},{"id":"semetey-1-2013:p0457:b003:l017","ordinal":111681,"en":"The foremost of the companions,"},{"id":"semetey-1-2013:p0457:b003:l018","ordinal":111682,"en":"The winners, slaughtered their winnings."},{"id":"semetey-1-2013:p0457:b003:l019","ordinal":111683,"en":"Eating unbred yearlings from the herd,"},{"id":"semetey-1-2013:p0457:b003:l020","ordinal":111684,"en":"The forty champions, like blue ticks,"},{"id":"semetey-1-2013:p0457:b003:l021","ordinal":111685,"en":"Grew plump."},{"id":"semetey-1-2013:p0457:b003:l022","ordinal":111686,"en":"Shebiet games and one-legged tag"},{"id":"semetey-1-2013:p0457:b003:l023","ordinal":111687,"en":"Were being played."},{"id":"semetey-1-2013:p0457:b003:l024","ordinal":111688,"en":"Wearing paired marten-fur caps,"},{"id":"semetey-1-2013:p0457:b003:l025","ordinal":111689,"en":"They swayed about."},{"id":"semetey-1-2013:p0457:b003:l026","ordinal":111690,"en":"Drinking kumys, playing with girls,"},{"id":"semetey-1-2013:p0457:b003:l027","ordinal":111691,"en":"They reveled."},{"id":"semetey-1-2013:p0457:b003:l028","ordinal":111692,"en":"As they held their games,"},{"id":"semetey-1-2013:p0457:b003:l029","ordinal":111693,"en":"Giving no thought to treacherous words,"},{"id":"semetey-1-2013:p0457:b003:l030","ordinal":111694,"en":"The gray-maned hero played."},{"id":"semetey-1-2013:p0457:b003:l031","ordinal":111695,"en":"Thimble mouths, camel-calf eyes,"},{"id":"semetey-1-2013:p0457:b003:l032","ordinal":111696,"en":"Dark eyes darting coquettishly,"},{"id":"semetey-1-2013:p0457:b003:l033","ordinal":111697,"en":"Scarlet dresses, slender waists—"},{"id":"semetey-1-2013:p0457:b003:l034","ordinal":111698,"en":"They gathered a hundred maidens."},{"id":"semetey-1-2013:p0457:b003:l035","ordinal":111699,"en":"Ornamented braid-tassels, broad hips—"},{"id":"semetey-1-2013:p0457:b003:l036","ordinal":111700,"en":"They gathered a hundred young wives."},{"id":"semetey-1-2013:p0457:b003:l037","ordinal":111701,"en":"Of liquor distilled from kumys"},{"id":"semetey-1-2013:p0457:b003:l038","ordinal":111702,"en":"They gathered forty leather flasks."},{"id":"semetey-1-2013:p0457:b003:l039","ordinal":111703,"en":"Women and men drew apart."},{"id":"semetey-1-2013:p0457:b005:l001","ordinal":111704,"en":"A paradise in this world—"},{"id":"semetey-1-2013:p0457:b005:l002","ordinal":111705,"en":"The entertainment was marvelous."},{"id":"semetey-1-2013:p0457:b005:l003","ordinal":111706,"en":"Their laughter brought out the sun."},{"id":"semetey-1-2013:p0457:b005:l004","ordinal":111707,"en":"All forty champions"},{"id":"semetey-1-2013:p0457:b005:l005","ordinal":111708,"en":"Laughed and played and rejoiced."},{"id":"semetey-1-2013:p0457:b005:l006","ordinal":111709,"en":"Their revels brought on dawn."},{"id":"semetey-1-2013:p0457:b005:l007","ordinal":111710,"en":"When all forty companions"},{"id":"semetey-1-2013:p0457:b005:l008","ordinal":111711,"en":"Played their splendid games,"},{"id":"semetey-1-2013:p0457:b005:l009","ordinal":111712,"en":"I, your disgraced, ill-fated mother,"},{"id":"semetey-1-2013:p0457:b005:l010","ordinal":111713,"en":"Within the white palace,"},{"id":"semetey-1-2013:p0457:b005:l011","ordinal":111714,"en":"Was making the white padded armor."},{"id":"semetey-1-2013:p0457:b005:l012","ordinal":111715,"en":"Your guileless father"},{"id":"semetey-1-2013:p0457:b005:l013","ordinal":111716,"en":"Kökchököz and Közkaman"},{"id":"semetey-1-2013:p0457:b005:l014","ordinal":111717,"en":"Openly deceived."},{"id":"semetey-1-2013:p0457:b005:l015","ordinal":111718,"en":"That your father had gone to them—"},{"id":"semetey-1-2013:p0457:b005:l016","ordinal":111719,"en":"Of all forty champions,"},{"id":"semetey-1-2013:p0457:b005:l017","ordinal":111720,"en":"Not one had seen it."},{"id":"semetey-1-2013:p0457:b005:l018","ordinal":111721,"en":"My gray-maned hero went visiting;"},{"id":"semetey-1-2013:p0457:b005:l019","ordinal":111722,"en":"When he went to Kökchököz,"},{"id":"semetey-1-2013:p0457:b005:l020","ordinal":111723,"en":"Kökchököz and Közkaman"},{"id":"semetey-1-2013:p0457:b005:l021","ordinal":111724,"en":"Openly deceived him."},{"id":"semetey-1-2013:p0457:b005:l022","ordinal":111725,"en":"The guileless, generous lion,"},{"id":"semetey-1-2013:p0457:b005:l023","ordinal":111726,"en":"As though they were truly his kin,"},{"id":"semetey-1-2013:p0457:b005:l024","ordinal":111727,"en":"Went striding there."},{"id":"semetey-1-2013:p0457:b005:l025","ordinal":111728,"en":"Your guileless father—"},{"id":"semetey-1-2013:p0457:b005:l026","ordinal":111729,"en":"They deceived him"},{"id":"semetey-1-2013:p0457:b005:l027","ordinal":111730,"en":"And cast him openly into misery."},{"id":"semetey-1-2013:p0457:b005:l028","ordinal":111731,"en":"Your khan father knew nothing."},{"id":"semetey-1-2013:p0457:b005:l029","ordinal":111732,"en":"When he was truly deceived,"},{"id":"semetey-1-2013:p0457:b005:l030","ordinal":111733,"en":"They had drawn the line;"},{"id":"semetey-1-2013:p0457:b005:l031","ordinal":111734,"en":"For your guileless father"},{"id":"semetey-1-2013:p0457:b005:l032","ordinal":111735,"en":"They then prepared their dreadful spectacle."},{"id":"semetey-1-2013:p0457:b005:l033","ordinal":111736,"en":"They had dug my grave,"},{"id":"semetey-1-2013:p0457:b005:l034","ordinal":111737,"en":"The accursed dark Kalmyks;"},{"id":"semetey-1-2013:p0457:b005:l035","ordinal":111738,"en":"They had boiled my bitter misery."},{"id":"semetey-1-2013:p0457:b005:l036","ordinal":111739,"en":"Közkaman had stepped"},{"id":"semetey-1-2013:p0457:b005:l037","ordinal":111740,"en":"To my vat filled with liquor."},{"id":"semetey-1-2013:p0457:b005:l038","ordinal":111741,"en":"In this way he had reached"},{"id":"semetey-1-2013:p0457:b005:l039","ordinal":111742,"en":"The very depths of my ruin."},{"id":"semetey-1-2013:p0458:b003:l001","ordinal":111743,"en":"They had dug my grave deep."},{"id":"semetey-1-2013:p0458:b003:l002","ordinal":111744,"en":"Those Kalmyks had boiled my bitter misery,"},{"id":"semetey-1-2013:p0458:b003:l004","ordinal":111745,"en":"Had shown before my eyes"},{"id":"semetey-1-2013:p0458:b003:l005","ordinal":111746,"en":"Suffering no person had seen."},{"id":"semetey-1-2013:p0458:b003:l006","ordinal":111747,"en":"In a mood to visit,"},{"id":"semetey-1-2013:p0458:b003:l007","ordinal":111748,"en":"Your father went inside."},{"id":"semetey-1-2013:p0458:b003:l008","ordinal":111749,"en":"The wretches who came from China"},{"id":"semetey-1-2013:p0458:b003:l009","ordinal":111750,"en":"Told entertaining tales."},{"id":"semetey-1-2013:p0458:b003:l010","ordinal":111751,"en":"When your khan father entered,"},{"id":"semetey-1-2013:p0458:b003:l011","ordinal":111752,"en":"Acknowledging his worth, growing animated,"},{"id":"semetey-1-2013:p0458:b003:l012","ordinal":111753,"en":"The swine Közkaman spoke:"},{"id":"semetey-1-2013:p0458:b003:l013","ordinal":111754,"en":"“My Manas, since coming to you—"},{"id":"semetey-1-2013:p0458:b003:l014","ordinal":111755,"en":"We came worn thin and grew fat;"},{"id":"semetey-1-2013:p0458:b003:l015","ordinal":111756,"en":"We came hungry and ate our fill;"},{"id":"semetey-1-2013:p0458:b003:l016","ordinal":111757,"en":"We came diminished and grew complete."},{"id":"semetey-1-2013:p0458:b003:l017","ordinal":111758,"en":"We settled in Talas and made it home."},{"id":"semetey-1-2013:p0458:b003:l018","ordinal":111759,"en":"Exhausted, wandering from Beijing,"},{"id":"semetey-1-2013:p0458:b003:l019","ordinal":111760,"en":"My gray-maned hero, we made you our support!"},{"id":"semetey-1-2013:p0458:b003:l020","ordinal":111761,"en":"When we lived among the Kalmyks,"},{"id":"semetey-1-2013:p0458:b003:l021","ordinal":111762,"en":"We were dark Kalmyks, Manchu;"},{"id":"semetey-1-2013:p0458:b003:l022","ordinal":111763,"en":"We used to serve their khan."},{"id":"semetey-1-2013:p0458:b003:l023","ordinal":111764,"en":"When our service went amiss,"},{"id":"semetey-1-2013:p0458:b003:l024","ordinal":111765,"en":"We bowed like women"},{"id":"semetey-1-2013:p0458:b003:l025","ordinal":111766,"en":"And paid homage to the Chinese."},{"id":"semetey-1-2013:p0458:b003:l026","ordinal":111767,"en":"We found the Kyrgyz and eagerly reached for them;"},{"id":"semetey-1-2013:p0458:b003:l027","ordinal":111768,"en":"We escaped that bowing."},{"id":"semetey-1-2013:p0458:b003:l028","ordinal":111769,"en":"We would prosper if we went to Manas—"},{"id":"semetey-1-2013:p0458:b003:l029","ordinal":111770,"en":"So we too had thought."},{"id":"semetey-1-2013:p0458:b003:l030","ordinal":111771,"en":"When we went to Manas,"},{"id":"semetey-1-2013:p0458:b003:l031","ordinal":111772,"en":"We would all become sultans."},{"id":"semetey-1-2013:p0458:b003:l032","ordinal":111773,"en":"The one God granted our wish."},{"id":"semetey-1-2013:p0458:b003:l033","ordinal":111774,"en":"My stately lion, listen:"},{"id":"semetey-1-2013:p0458:b003:l034","ordinal":111775,"en":"Not a trace of sorrow remains with us!"},{"id":"semetey-1-2013:p0458:b003:l035","ordinal":111776,"en":"From the unbelievers of the dark faith"},{"id":"semetey-1-2013:p0458:b003:l036","ordinal":111777,"en":"Thus the one God delivered us!"},{"id":"semetey-1-2013:p0458:b003:l038","ordinal":111778,"en":"We renounced their idols."},{"id":"semetey-1-2013:p0458:b003:l039","ordinal":111779,"en":"We left behind, Khan Manas,"},{"id":"semetey-1-2013:p0458:b004:l001","ordinal":111780,"en":"The Chinese people in that distant steppe."},{"id":"semetey-1-2013:p0458:b004:l002","ordinal":111781,"en":"When we lived under the khagan,"},{"id":"semetey-1-2013:p0458:b004:l003","ordinal":111782,"en":"We ate badger meat."},{"id":"semetey-1-2013:p0458:b004:l004","ordinal":111783,"en":"If we reached Khan Manas and settled,"},{"id":"semetey-1-2013:p0458:b004:l005","ordinal":111784,"en":"Then these poor heads"},{"id":"semetey-1-2013:p0458:b004:l006","ordinal":111785,"en":"Would become sultans, we thought as we came."},{"id":"semetey-1-2013:p0458:b004:l007","ordinal":111786,"en":"All misfortunes were cut away."},{"id":"semetey-1-2013:p0458:b004:l008","ordinal":111787,"en":"This was God's gift:"},{"id":"semetey-1-2013:p0458:b004:l009","ordinal":111788,"en":"We met the mighty lion Manas."},{"id":"semetey-1-2013:p0458:b004:l010","ordinal":111789,"en":"Our severed, hapless lives were joined;"},{"id":"semetey-1-2013:p0458:b004:l011","ordinal":111790,"en":"The scattered Kalmyks were gathered."},{"id":"semetey-1-2013:p0458:b004:l012","ordinal":111791,"en":"We settled in Talas and made it home,"},{"id":"semetey-1-2013:p0458:b004:l013","ordinal":111792,"en":"Taking Khan Manas as our lion."},{"id":"semetey-1-2013:p0458:b004:l014","ordinal":111793,"en":"When we lived under the khagan,"},{"id":"semetey-1-2013:p0458:b004:l015","ordinal":111794,"en":"Our lives had shrunk to a handful."},{"id":"semetey-1-2013:p0458:b004:l016","ordinal":111795,"en":"When we came wandering, you eased our grief."},{"id":"semetey-1-2013:p0458:b004:l017","ordinal":111796,"en":"Live long, Manas, our khan!"},{"id":"semetey-1-2013:p0458:b004:l018","ordinal":111797,"en":"When we lived in Beijing,"},{"id":"semetey-1-2013:p0458:b004:l019","ordinal":111798,"en":"Prince Manas, listen,"},{"id":"semetey-1-2013:p0458:b004:l020","ordinal":111799,"en":"Our days were dark."},{"id":"semetey-1-2013:p0458:b004:l021","ordinal":111800,"en":"You freed us from the Kalmyks."},{"id":"semetey-1-2013:p0458:b004:l022","ordinal":111801,"en":"Live long, Manas, one of us!"},{"id":"semetey-1-2013:p0458:b004:l023","ordinal":111802,"en":"We came as a horseless Kalmyk."},{"id":"semetey-1-2013:p0458:b004:l024","ordinal":111803,"en":"The Kalmyk who came horseless—"},{"id":"semetey-1-2013:p0458:b004:l025","ordinal":111804,"en":"An argali-legged, bronze-limbed"},{"id":"semetey-1-2013:p0458:b004:l026","ordinal":111805,"en":"Swift steed you gave him to ride."},{"id":"semetey-1-2013:p0458:b004:l027","ordinal":111806,"en":"One of us came without a robe."},{"id":"semetey-1-2013:p0458:b004:l028","ordinal":111807,"en":"The kinsman who came without a robe—"},{"id":"semetey-1-2013:p0458:b004:l029","ordinal":111808,"en":"A golden collar, bronze sleeves,"},{"id":"semetey-1-2013:p0458:b004:l030","ordinal":111809,"en":"Double mail, lark-eyed rings,"},{"id":"semetey-1-2013:p0458:b004:l031","ordinal":111810,"en":"A gold-braided collar, a broad sleeveless coat,"},{"id":"semetey-1-2013:p0458:b004:l032","ordinal":111811,"en":"Impervious to bullets when worn in battle—"},{"id":"semetey-1-2013:p0458:b004:l033","ordinal":111812,"en":"You clothed him in a robe, Khan Manas."},{"id":"semetey-1-2013:p0458:b004:l034","ordinal":111813,"en":"The Kalmyk who came without a wife,"},{"id":"semetey-1-2013:p0458:b004:l035","ordinal":111814,"en":"Who came wandering all alone—"},{"id":"semetey-1-2013:p0458:b004:l036","ordinal":111815,"en":"Thimble mouth, camel-calf eyes,"},{"id":"semetey-1-2013:p0458:b004:l037","ordinal":111816,"en":"Dark eyes darting coquettishly,"},{"id":"semetey-1-2013:p0458:b004:l038","ordinal":111817,"en":"From the beauties of the Kyrgyz,"},{"id":"semetey-1-2013:p0458:b004:l039","ordinal":111818,"en":"Khan Manas, you gave him a wife."},{"id":"semetey-1-2013:p0459:b003:l001","ordinal":111819,"en":"Wandering here from the khagan,"},{"id":"semetey-1-2013:p0459:b003:l002","ordinal":111820,"en":"We saw no prince like you."},{"id":"semetey-1-2013:p0459:b003:l003","ordinal":111821,"en":"You held nine days of feasting without pause,"},{"id":"semetey-1-2013:p0459:b003:l004","ordinal":111822,"en":"And had cut off, my Sultan Manas,"},{"id":"semetey-1-2013:p0459:b003:l005","ordinal":111823,"en":"My hair, thick as a hand-mallet."},{"id":"semetey-1-2013:p0459:b003:l006","ordinal":111824,"en":"You freed, my generous lord,"},{"id":"semetey-1-2013:p0459:b003:l007","ordinal":111825,"en":"This head that came from the Kalmyks."},{"id":"semetey-1-2013:p0459:b003:l008","ordinal":111826,"en":"Now and then, my gray-maned hero,"},{"id":"semetey-1-2013:p0459:b003:l009","ordinal":111827,"en":"You did not come to eat my food."},{"id":"semetey-1-2013:p0459:b003:l010","ordinal":111828,"en":"You did not come to our home"},{"id":"semetey-1-2013:p0459:b003:l011","ordinal":111829,"en":"To ask, ‘How are you faring?’"},{"id":"semetey-1-2013:p0459:b003:l012","ordinal":111830,"en":"My king, you did not learn our condition."},{"id":"semetey-1-2013:p0459:b003:l013","ordinal":111831,"en":"You did not stop at our home,"},{"id":"semetey-1-2013:p0459:b003:l014","ordinal":111832,"en":"Did not take food from my hand."},{"id":"semetey-1-2013:p0459:b003:l015","ordinal":111833,"en":"Was gray-maned leopard Manas"},{"id":"semetey-1-2013:p0459:b003:l016","ordinal":111834,"en":"A khan before whom the people should hold back?"},{"id":"semetey-1-2013:p0459:b003:l017","ordinal":111835,"en":"When my khan Manas comes,"},{"id":"semetey-1-2013:p0459:b003:l018","ordinal":111836,"en":"I will not spare my life."},{"id":"semetey-1-2013:p0459:b003:l019","ordinal":111837,"en":"Is there any of that damned drink?”"},{"id":"semetey-1-2013:p0459:b003:l020","ordinal":111838,"en":"While Közkaman was speaking,"},{"id":"semetey-1-2013:p0459:b003:l021","ordinal":111839,"en":"Kökchököz rose to his feet."},{"id":"semetey-1-2013:p0459:b003:l022","ordinal":111840,"en":"One sip would bring death;"},{"id":"semetey-1-2013:p0459:b003:l023","ordinal":111841,"en":"One sniff would bring the end."},{"id":"semetey-1-2013:p0459:b003:l024","ordinal":111842,"en":"Poison of forty years had been mixed in,"},{"id":"semetey-1-2013:p0459:b003:l025","ordinal":111843,"en":"Its ferment brought to readiness,"},{"id":"semetey-1-2013:p0459:b003:l026","ordinal":111844,"en":"Killing those marked as enemies,"},{"id":"semetey-1-2013:p0459:b003:l027","ordinal":111845,"en":"Poured into a leather flask and prepared,"},{"id":"semetey-1-2013:p0459:b003:l028","ordinal":111846,"en":"For the guileless leopard,"},{"id":"semetey-1-2013:p0459:b003:l029","ordinal":111847,"en":"Kept for Khan Manas."},{"id":"semetey-1-2013:p0459:b003:l030","ordinal":111848,"en":"A dreadful poison that tormented at a touch—"},{"id":"semetey-1-2013:p0459:b003:l031","ordinal":111849,"en":"Into a gold-rimmed bowl"},{"id":"semetey-1-2013:p0459:b003:l032","ordinal":111850,"en":"Kökchököz, what else would he do,"},{"id":"semetey-1-2013:p0459:b003:l033","ordinal":111851,"en":"Poured it to the brim."},{"id":"semetey-1-2013:p0459:b003:l034","ordinal":111852,"en":"“We share one root of kinship,” he said."},{"id":"semetey-1-2013:p0459:b003:l035","ordinal":111853,"en":"To gray-maned Lord Manas"},{"id":"semetey-1-2013:p0459:b003:l036","ordinal":111854,"en":"Közkaman brought and offered it."},{"id":"semetey-1-2013:p0459:b003:l037","ordinal":111855,"en":"Did you see his foolishness?"},{"id":"semetey-1-2013:p0459:b003:l038","ordinal":111856,"en":"Taking it at once and turning it,"},{"id":"semetey-1-2013:p0459:b003:l039","ordinal":111857,"en":"The poison Közkaman offered—"},{"id":"semetey-1-2013:p0459:b005:l001","ordinal":111858,"en":"Khan Manas drank it all down."},{"id":"semetey-1-2013:p0459:b005:l002","ordinal":111859,"en":"When he drank, the gray-maned hero doubled over,"},{"id":"semetey-1-2013:p0459:b005:l003","ordinal":111860,"en":"Fell straight onto his head,"},{"id":"semetey-1-2013:p0459:b005:l004","ordinal":111861,"en":"His fine mustache flattened."},{"id":"semetey-1-2013:p0459:b005:l005","ordinal":111862,"en":"A terrible poison they had given him."},{"id":"semetey-1-2013:p0459:b005:l006","ordinal":111863,"en":"Like one departing for Judgment Day,"},{"id":"semetey-1-2013:p0459:b005:l007","ordinal":111864,"en":"His great eyes stared wide,"},{"id":"semetey-1-2013:p0459:b005:l008","ordinal":111865,"en":"Like one departing for the other world."},{"id":"semetey-1-2013:p0459:b005:l010","ordinal":111866,"en":"Sharing death, sharing one life—","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0459:b005:l011","ordinal":111867,"en":"Not one of those champions was there."},{"id":"semetey-1-2013:p0459:b005:l012","ordinal":111868,"en":"The pair Azhybai and Bakai were not there;"},{"id":"semetey-1-2013:p0459:b005:l013","ordinal":111869,"en":"Ocean-like Almambet and Chubak were not there;"},{"id":"semetey-1-2013:p0459:b005:l014","ordinal":111870,"en":"The heroes Syrgak and Serek were not there;"},{"id":"semetey-1-2013:p0459:b005:l015","ordinal":111871,"en":"The servant Shuutu and hero Yrchy were not there."},{"id":"semetey-1-2013:p0459:b005:l016","ordinal":111872,"en":"The cunning finder of a way,"}]
