[{"id":"semetey-1-2013:p0639:b003:l034","ordinal":125441,"en":"Dejected, grieving,"},{"id":"semetey-1-2013:p0639:b003:l035","ordinal":125442,"en":"Yet I did not die—life is sweet,"},{"id":"semetey-1-2013:p0639:b003:l036","ordinal":125443,"en":"My colt, though parted from my cauldron."},{"id":"semetey-1-2013:p0639:b003:l037","ordinal":125444,"en":"Had the cauldron I relied upon been beside me,"},{"id":"semetey-1-2013:p0639:b003:l039","ordinal":125445,"en":"Would I not have hunted my game?"},{"id":"semetey-1-2013:p0639:b004:l001","ordinal":125446,"en":"Would I not have kept myself alive?"},{"id":"semetey-1-2013:p0639:b004:l002","ordinal":125447,"en":"Had I eaten my fill, would I not have raised"},{"id":"semetey-1-2013:p0639:b004:l003","ordinal":125448,"en":"A great cloud of dust against those villains?"},{"id":"semetey-1-2013:p0639:b004:l004","ordinal":125449,"en":"When those dogs seized my cauldron,"},{"id":"semetey-1-2013:p0639:b004:l005","ordinal":125450,"en":"That was when they settled accounts with me."},{"id":"semetey-1-2013:p0639:b004:l006","ordinal":125451,"en":"‘This villain's cauldron—"},{"id":"semetey-1-2013:p0639:b004:l007","ordinal":125452,"en":"They have brought it,’ they said,"},{"id":"semetey-1-2013:p0639:b004:l008","ordinal":125453,"en":"Striking it with axes, pounding it,"},{"id":"semetey-1-2013:p0639:b004:l009","ordinal":125454,"en":"Abyke, Köbösh—the six villains—"},{"id":"semetey-1-2013:p0639:b004:l010","ordinal":125455,"en":"That was where they smashed the cauldron apart."},{"id":"semetey-1-2013:p0639:b004:l011","ordinal":125456,"en":"My guards grieved;"},{"id":"semetey-1-2013:p0639:b004:l012","ordinal":125457,"en":"They saw darkest night,"},{"id":"semetey-1-2013:p0639:b004:l013","ordinal":125458,"en":"Parted from their cauldron."},{"id":"semetey-1-2013:p0639:b004:l014","ordinal":125459,"en":"Taking axes, sobbing,"},{"id":"semetey-1-2013:p0639:b004:l015","ordinal":125460,"en":"‘Manas, whom we leaned upon, has died now!’"},{"id":"semetey-1-2013:p0639:b004:l016","ordinal":125461,"en":"So cried the forty guards,"},{"id":"semetey-1-2013:p0639:b004:l017","ordinal":125462,"en":"Each striking his own head,"},{"id":"semetey-1-2013:p0639:b004:l018","ordinal":125463,"en":"Wailing and crying aloud."},{"id":"semetey-1-2013:p0639:b004:l019","ordinal":125464,"en":"Thus they settled accounts with me;"},{"id":"semetey-1-2013:p0639:b004:l020","ordinal":125465,"en":"Khan Manas's sacred cauldron—"},{"id":"semetey-1-2013:p0639:b004:l021","ordinal":125466,"en":"There the villains smashed it apart."},{"id":"semetey-1-2013:p0639:b004:l022","ordinal":125467,"en":"I came back once,"},{"id":"semetey-1-2013:p0639:b004:l023","ordinal":125468,"en":"And saw its fragments."},{"id":"semetey-1-2013:p0639:b004:l024","ordinal":125469,"en":"I have words to speak openly:"},{"id":"semetey-1-2013:p0639:b004:l025","ordinal":125470,"en":"‘If my orphan, the generous one's son,"},{"id":"semetey-1-2013:p0639:b004:l026","ordinal":125471,"en":"Comes back to Talas,"},{"id":"semetey-1-2013:p0639:b004:l027","ordinal":125472,"en":"I shall cast it and take an omen."},{"id":"semetey-1-2013:p0639:b004:l028","ordinal":125473,"en":"If he takes after Manas himself,"},{"id":"semetey-1-2013:p0639:b004:l029","ordinal":125474,"en":"The cauldron will come out like you."},{"id":"semetey-1-2013:p0639:b004:l030","ordinal":125475,"en":"I shall measure it and take an omen."},{"id":"semetey-1-2013:p0639:b004:l031","ordinal":125476,"en":"Let me cast this cauldron;"},{"id":"semetey-1-2013:p0639:b004:l032","ordinal":125477,"en":"Then let me dry my tears.’”"},{"id":"semetey-1-2013:p0639:b004:l033","ordinal":125478,"en":"So saying, Bölökbai"},{"id":"semetey-1-2013:p0639:b004:l034","ordinal":125479,"en":"Made his bellows ready."},{"id":"semetey-1-2013:p0639:b004:l035","ordinal":125480,"en":"He prepared plenty of charcoal."},{"id":"semetey-1-2013:p0639:b004:l036","ordinal":125481,"en":"He had the charcoal scattered like sheep."},{"id":"semetey-1-2013:p0639:b004:l037","ordinal":125482,"en":"The forty guards, accustomed to the work,"},{"id":"semetey-1-2013:p0639:b004:l038","ordinal":125483,"en":"Pumped the bellows hard now."},{"id":"semetey-1-2013:p0639:b004:l039","ordinal":125484,"en":"He took an omen for the orphan."},{"id":"semetey-1-2013:p0640:b003:l001","ordinal":125485,"en":"Before this or that could be said,"},{"id":"semetey-1-2013:p0640:b003:l002","ordinal":125486,"en":"In the blink of an eye,"},{"id":"semetey-1-2013:p0640:b003:l003","ordinal":125487,"en":"He cast the cauldron anew."},{"id":"semetey-1-2013:p0640:b003:l004","ordinal":125488,"en":"Compared with when bloodthirsty Manas lived,"},{"id":"semetey-1-2013:p0640:b003:l005","ordinal":125489,"en":"It now stood greater still."},{"id":"semetey-1-2013:p0640:b003:l006","ordinal":125490,"en":"God had granted his wish."},{"id":"semetey-1-2013:p0640:b003:l007","ordinal":125491,"en":"The poor lame smith"},{"id":"semetey-1-2013:p0640:b003:l008","ordinal":125492,"en":"Had regained what he once had."},{"id":"semetey-1-2013:p0640:b003:l009","ordinal":125493,"en":"The cauldron was cast anew;"},{"id":"semetey-1-2013:p0640:b003:l010","ordinal":125494,"en":"The forty guards ate their fill."},{"id":"semetey-1-2013:p0640:b003:l011","ordinal":125495,"en":"Their tears ceased."},{"id":"semetey-1-2013:p0640:b003:l012","ordinal":125496,"en":"When they saw that cauldron,"},{"id":"semetey-1-2013:p0640:b003:l013","ordinal":125497,"en":"All shouted with joy,"},{"id":"semetey-1-2013:p0640:b003:l014","ordinal":125498,"en":"Crying the battle cry, ‘Manas!’"},{"id":"semetey-1-2013:p0640:b003:l015","ordinal":125499,"en":"Their knees bent to the ground;"},{"id":"semetey-1-2013:p0640:b003:l016","ordinal":125500,"en":"All hurried up in a row."},{"id":"semetey-1-2013:p0640:b003:l017","ordinal":125501,"en":"Bölökbai and old Bakai,"},{"id":"semetey-1-2013:p0640:b003:l018","ordinal":125502,"en":"All of the forty guards,"},{"id":"semetey-1-2013:p0640:b003:l019","ordinal":125503,"en":"Raised their hands and sobbed,"},{"id":"semetey-1-2013:p0640:b003:l020","ordinal":125504,"en":"Dedicating their wether to God,"},{"id":"semetey-1-2013:p0640:b003:l021","ordinal":125505,"en":"Crying out, ‘Amen!’"},{"id":"semetey-1-2013:p0640:b003:l022","ordinal":125506,"en":"Hanging their belts around their necks,"},{"id":"semetey-1-2013:p0640:b003:l023","ordinal":125507,"en":"‘Keep my orphan safe!’ they said,"},{"id":"semetey-1-2013:p0640:b003:l024","ordinal":125508,"en":"Pleading with God alone."},{"id":"semetey-1-2013:p0640:b003:l025","ordinal":125509,"en":"They slaughtered the gray wether now."},{"id":"semetey-1-2013:p0640:b003:l026","ordinal":125510,"en":"Into the cauldron where food would not boil,"},{"id":"semetey-1-2013:p0640:b003:l027","ordinal":125511,"en":"The heroes brought it,"},{"id":"semetey-1-2013:p0640:b003:l028","ordinal":125512,"en":"The wether vowed to Baabedin—"},{"id":"semetey-1-2013:p0640:b003:l029","ordinal":125513,"en":"They put in all of it now."},{"id":"semetey-1-2013:p0640:b003:l030","ordinal":125514,"en":"As though leopard Manas, bloodthirsty lion,"},{"id":"semetey-1-2013:p0640:b003:l031","ordinal":125515,"en":"Had come alive again today,"},{"id":"semetey-1-2013:p0640:b003:l032","ordinal":125516,"en":"With Bölökbai and Bakai at their head,"},{"id":"semetey-1-2013:p0640:b003:l033","ordinal":125517,"en":"And the forty guards as well,"},{"id":"semetey-1-2013:p0640:b003:l034","ordinal":125518,"en":"They fell into a mighty sleep."},{"id":"semetey-1-2013:p0640:b003:l035","ordinal":125519,"en":"Resting upon their elbows,"},{"id":"semetey-1-2013:p0640:b003:l036","ordinal":125520,"en":"Taking a little sleep,"},{"id":"semetey-1-2013:p0640:b003:l037","ordinal":125521,"en":"Lying until their hips grew numb,"},{"id":"semetey-1-2013:p0640:b003:l038","ordinal":125522,"en":"Sleeping on their sides until satisfied."},{"id":"semetey-1-2013:p0640:b003:l039","ordinal":125523,"en":"At that time, Semetey,"},{"id":"semetey-1-2013:p0640:b004:l001","ordinal":125524,"en":"After everyone had fallen asleep,"},{"id":"semetey-1-2013:p0640:b004:l002","ordinal":125525,"en":"For many days and many nights"},{"id":"semetey-1-2013:p0640:b004:l003","ordinal":125526,"en":"The orphan slave had eaten nothing."},{"id":"semetey-1-2013:p0640:b004:l004","ordinal":125527,"en":"He rose from sleep,"},{"id":"semetey-1-2013:p0640:b004:l005","ordinal":125528,"en":"What my elder, leopard Khan Bakai,"},{"id":"semetey-1-2013:p0640:b004:l006","ordinal":125529,"en":"Had cooked—the bull camel's meat—"},{"id":"semetey-1-2013:p0640:b004:l007","ordinal":125530,"en":"Your orphan saw it."},{"id":"semetey-1-2013:p0640:b004:l008","ordinal":125531,"en":"Making a skewer from a birch,"},{"id":"semetey-1-2013:p0640:b004:l009","ordinal":125532,"en":"Manas's son Semetey"},{"id":"semetey-1-2013:p0640:b004:l010","ordinal":125533,"en":"Began gulping down the meat."},{"id":"semetey-1-2013:p0640:b004:l011","ordinal":125534,"en":"Leaving the bones, he ate it all,"},{"id":"semetey-1-2013:p0640:b004:l012","ordinal":125535,"en":"Ate all the gray bull camel's meat."},{"id":"semetey-1-2013:p0640:b004:l014","ordinal":125536,"en":"‘Let elder Bakai eat,’","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0640:b004:l015","ordinal":125537,"en":"This rascal left not a spoonful of broth for that."},{"id":"semetey-1-2013:p0640:b004:l016","ordinal":125538,"en":"Bakai awoke from sleep,"},{"id":"semetey-1-2013:p0640:b004:l017","ordinal":125539,"en":"Turned onto his right side,"},{"id":"semetey-1-2013:p0640:b004:l018","ordinal":125540,"en":"Hurriedly said his prayers,"},{"id":"semetey-1-2013:p0640:b004:l019","ordinal":125541,"en":"Hung his belt around his neck,"},{"id":"semetey-1-2013:p0640:b004:l020","ordinal":125542,"en":"Taking the orphan for his hope,"},{"id":"semetey-1-2013:p0640:b004:l021","ordinal":125543,"en":"Pleaded with God alone,"},{"id":"semetey-1-2013:p0640:b004:l022","ordinal":125544,"en":"And went to the meat he had put in."},{"id":"semetey-1-2013:p0640:b004:l023","ordinal":125545,"en":"The cauldron remained; the meat was gone."},{"id":"semetey-1-2013:p0640:b004:l024","ordinal":125546,"en":"“He has eaten the meat of a whole camel,"},{"id":"semetey-1-2013:p0640:b004:l025","ordinal":125547,"en":"This shameless orphan!"},{"id":"semetey-1-2013:p0640:b004:l026","ordinal":125548,"en":"When leopard Manas lived,"},{"id":"semetey-1-2013:p0640:b004:l027","ordinal":125549,"en":"He, too, would eat a camel,"},{"id":"semetey-1-2013:p0640:b004:l028","ordinal":125550,"en":"But choice meat from each joint—"},{"id":"semetey-1-2013:p0640:b004:l029","ordinal":125551,"en":"‘Let elder Bakai eat,’ he would say,"},{"id":"semetey-1-2013:p0640:b004:l030","ordinal":125552,"en":"And leave it for wretched me."},{"id":"semetey-1-2013:p0640:b004:l031","ordinal":125553,"en":"My soul's companion, Manas, do not die!"},{"id":"semetey-1-2013:p0640:b004:l032","ordinal":125554,"en":"Parted from my Manas,"},{"id":"semetey-1-2013:p0640:b004:l033","ordinal":125555,"en":"Bakai, do not remain behind wailing!"},{"id":"semetey-1-2013:p0640:b004:l034","ordinal":125556,"en":"Brooding in my heart,"},{"id":"semetey-1-2013:p0640:b004:l035","ordinal":125557,"en":"Manas, take me with you, spare me humiliation"},{"id":"semetey-1-2013:p0640:b004:l036","ordinal":125558,"en":"Before the child left behind!"},{"id":"semetey-1-2013:p0640:b004:l037","ordinal":125559,"en":"When leopard Manas lived,"},{"id":"semetey-1-2013:p0640:b004:l038","ordinal":125560,"en":"Not only camel meat—"},{"id":"semetey-1-2013:p0640:b004:l039","ordinal":125561,"en":"I would slice and eat horse-belly fat,"},{"id":"semetey-1-2013:p0641:b003:l001","ordinal":125562,"en":"I would say, ‘Where is calamity?’"},{"id":"semetey-1-2013:p0641:b003:l002","ordinal":125563,"en":"The gray bull camel was a fine beast;"},{"id":"semetey-1-2013:p0641:b003:l003","ordinal":125564,"en":"It had been kept for mourning."},{"id":"semetey-1-2013:p0641:b003:l004","ordinal":125565,"en":"I was the one who tended it."},{"id":"semetey-1-2013:p0641:b003:l005","ordinal":125566,"en":"‘When my boy comes from there,"},{"id":"semetey-1-2013:p0641:b003:l006","ordinal":125567,"en":"Let me slaughter it in Manas's name,’"},{"id":"semetey-1-2013:p0641:b003:l007","ordinal":125568,"en":"That was the wish I cherished."},{"id":"semetey-1-2013:p0641:b003:l008","ordinal":125569,"en":"‘With the gray bull camel's meat,"},{"id":"semetey-1-2013:p0641:b003:l009","ordinal":125570,"en":"Let me openly eat my fill,’ I thought."},{"id":"semetey-1-2013:p0641:b003:l010","ordinal":125571,"en":"Without letting this wish come true,"},{"id":"semetey-1-2013:p0641:b003:l011","ordinal":125572,"en":"You have eaten the camel entirely!"},{"id":"semetey-1-2013:p0641:b003:l012","ordinal":125573,"en":"If you are not full, eat me;"},{"id":"semetey-1-2013:p0641:b003:l013","ordinal":125574,"en":"Eat the warriors Abyke and Köbösh."},{"id":"semetey-1-2013:p0641:b003:l014","ordinal":125575,"en":"If that proves too little,"},{"id":"semetey-1-2013:p0641:b003:l015","ordinal":125576,"en":"Eat your father's forty companions too!”"},{"id":"semetey-1-2013:p0641:b003:l016","ordinal":125577,"en":"Thus Bakai cursed him now."},{"id":"semetey-1-2013:p0641:b003:l017","ordinal":125578,"en":"Your orphan, the son of Manas,"},{"id":"semetey-1-2013:p0641:b003:l018","ordinal":125579,"en":"Had eaten his fill of camel."},{"id":"semetey-1-2013:p0641:b003:l019","ordinal":125580,"en":"Khan Bakai's heart grew warm:"},{"id":"semetey-1-2013:p0641:b003:l020","ordinal":125581,"en":"“My dear orphan"},{"id":"semetey-1-2013:p0641:b003:l021","ordinal":125582,"en":"Has fortune complete on every side."},{"id":"semetey-1-2013:p0641:b003:l022","ordinal":125583,"en":"He is a warrior who takes after his father;"},{"id":"semetey-1-2013:p0641:b003:l023","ordinal":125584,"en":"Every limb is broad."},{"id":"semetey-1-2013:p0641:b003:l024","ordinal":125585,"en":"My spring flowing down from the ridge,"},{"id":"semetey-1-2013:p0641:b003:l025","ordinal":125586,"en":"From my renowned lord Manas,"},{"id":"semetey-1-2013:p0641:b003:l026","ordinal":125587,"en":"My dear one left as a gift."},{"id":"semetey-1-2013:p0641:b003:l027","ordinal":125588,"en":"May he stay safe and well!"},{"id":"semetey-1-2013:p0641:b003:l028","ordinal":125589,"en":"Even if he eats six camels' meat,"},{"id":"semetey-1-2013:p0641:b003:l029","ordinal":125590,"en":"I shall ask God for it."},{"id":"semetey-1-2013:p0641:b003:l030","ordinal":125591,"en":"I have but one sun to look upon;"},{"id":"semetey-1-2013:p0641:b003:l031","ordinal":125592,"en":"Whom have I besides this one?"},{"id":"semetey-1-2013:p0641:b003:l032","ordinal":125593,"en":"‘Keep him safe,’ I said,"},{"id":"semetey-1-2013:p0641:b003:l033","ordinal":125594,"en":"And cried out to God alone."},{"id":"semetey-1-2013:p0641:b003:l034","ordinal":125595,"en":"The figure before my eyes,"},{"id":"semetey-1-2013:p0641:b003:l035","ordinal":125596,"en":"The presence before my brow,"},{"id":"semetey-1-2013:p0641:b003:l036","ordinal":125597,"en":"My heart is flame, my breast is embers."},{"id":"semetey-1-2013:p0641:b003:l037","ordinal":125598,"en":"My orphan left by Manas—"},{"id":"semetey-1-2013:p0641:b003:l038","ordinal":125599,"en":"I have no one else but him.”"},{"id":"semetey-1-2013:p0641:b003:l039","ordinal":125600,"en":"As Bakai sang,"},{"id":"semetey-1-2013:p0641:b005:l001","ordinal":125601,"en":"Bölökbai led the forty guards;"},{"id":"semetey-1-2013:p0641:b005:l002","ordinal":125602,"en":"They made ready by the cauldron,"},{"id":"semetey-1-2013:p0641:b005:l003","ordinal":125603,"en":"All together cooking meat."},{"id":"semetey-1-2013:p0641:b005:l004","ordinal":125604,"en":"When the meat was cooked,"},{"id":"semetey-1-2013:p0641:b005:l005","ordinal":125605,"en":"They spoke a blessing to Baabedin,"},{"id":"semetey-1-2013:p0641:b005:l006","ordinal":125606,"en":"Vowed a sheep to Khoroshon,"},{"id":"semetey-1-2013:p0641:b005:l007","ordinal":125607,"en":"And made ready for the cooked meat."},{"id":"semetey-1-2013:p0641:b005:l008","ordinal":125608,"en":"Bölökbai at their head, Khan Bakai,"},{"id":"semetey-1-2013:p0641:b005:l009","ordinal":125609,"en":"And the forty guards with them,"},{"id":"semetey-1-2013:p0641:b005:l010","ordinal":125610,"en":"The sorrow in their hearts—"},{"id":"semetey-1-2013:p0641:b005:l011","ordinal":125611,"en":"They dispelled every last part of it."},{"id":"semetey-1-2013:p0641:b005:l012","ordinal":125612,"en":"On the gray wether's meat,"},{"id":"semetey-1-2013:p0641:b005:l013","ordinal":125613,"en":"As though bloodthirsty leopard Manas"},{"id":"semetey-1-2013:p0641:b005:l014","ordinal":125614,"en":"Were still there, they bustled joyfully;"},{"id":"semetey-1-2013:p0641:b005:l015","ordinal":125615,"en":"Every one of them ate their fill."},{"id":"semetey-1-2013:p0641:b005:l016","ordinal":125616,"en":"Such was that meat's abundance:"},{"id":"semetey-1-2013:p0641:b005:l017","ordinal":125617,"en":"When warrior Manas lived,"},{"id":"semetey-1-2013:p0641:b005:l018","ordinal":125618,"en":"From within that cauldron,"},{"id":"semetey-1-2013:p0641:b005:l019","ordinal":125619,"en":"Five hundred people would eat their fill."},{"id":"semetey-1-2013:p0641:b005:l020","ordinal":125620,"en":"That cauldron filled to overflowing;"},{"id":"semetey-1-2013:p0641:b005:l021","ordinal":125621,"en":"More food remained boiling in it."},{"id":"semetey-1-2013:p0641:b005:l022","ordinal":125622,"en":"Who knows? We do not know, if it is true,"},{"id":"semetey-1-2013:p0641:b005:l023","ordinal":125623,"en":"Food had come from the unseen,"},{"id":"semetey-1-2013:p0641:b005:l024","ordinal":125624,"en":"And filled it up again."},{"id":"semetey-1-2013:p0641:b005:l025","ordinal":125625,"en":"The forty guards and Bölökbai,"},{"id":"semetey-1-2013:p0641:b005:l026","ordinal":125626,"en":"With leopard Bakai at their head,"},{"id":"semetey-1-2013:p0641:b005:l027","ordinal":125627,"en":"Had eaten a hearty fill."},{"id":"semetey-1-2013:p0641:b005:l028","ordinal":125628,"en":"Enough meat for another meal"},{"id":"semetey-1-2013:p0641:b005:l029","ordinal":125629,"en":"Was still left over."},{"id":"semetey-1-2013:p0641:b005:l030","ordinal":125630,"en":"The reason it was left over—"},{"id":"semetey-1-2013:p0641:b005:l031","ordinal":125631,"en":"When leopard Manas, bloodthirsty lion,"},{"id":"semetey-1-2013:p0641:b005:l032","ordinal":125632,"en":"Journeyed to Mecca,"},{"id":"semetey-1-2013:p0641:b005:l033","ordinal":125633,"en":"And visited Medina,"},{"id":"semetey-1-2013:p0641:b005:l034","ordinal":125634,"en":"Received a letter from the caliph,"},{"id":"semetey-1-2013:p0641:b005:l035","ordinal":125635,"en":"Received a blessing from the prince,"},{"id":"semetey-1-2013:p0641:b005:l036","ordinal":125636,"en":"And was named the conquering lord,"},{"id":"semetey-1-2013:p0641:b005:l037","ordinal":125637,"en":"When dear Manas set forth,"},{"id":"semetey-1-2013:p0641:b005:l038","ordinal":125638,"en":"When leopard Manas was alive,"},{"id":"semetey-1-2013:p0641:b005:l039","ordinal":125639,"en":"Exchanging shots for seven days without pause,"},{"id":"semetey-1-2013:p0642:b003:l001","ordinal":125640,"en":"When he brought down the Kaldai's banner,"},{"id":"semetey-1-2013:p0642:b003:l002","ordinal":125641,"en":"Upon the Kalmyks who came out on guard,"},{"id":"semetey-1-2013:p0642:b003:l003","ordinal":125642,"en":"He brought turmoil."},{"id":"semetey-1-2013:p0642:b003:l004","ordinal":125643,"en":"In those days, the Muslims of the world,"},{"id":"semetey-1-2013:p0642:b003:l005","ordinal":125644,"en":"From the infidels who held them besieged,"},{"id":"semetey-1-2013:p0642:b003:l006","ordinal":125645,"en":"He set them free."},{"id":"semetey-1-2013:p0642:b003:l007","ordinal":125646,"en":"When turmoil upon the face of the earth"},{"id":"semetey-1-2013:p0642:b003:l008","ordinal":125647,"en":"Was brought by Manas alone,"},{"id":"semetey-1-2013:p0642:b003:l009","ordinal":125648,"en":"On the ridge of Kum-Bulak,"},{"id":"semetey-1-2013:p0642:b003:l010","ordinal":125649,"en":"Where he performed his ablutions,"},{"id":"semetey-1-2013:p0642:b003:l011","ordinal":125650,"en":"In the desert of Mediyan,"},{"id":"semetey-1-2013:p0642:b003:l012","ordinal":125651,"en":"It was found through the unseen,"},{"id":"semetey-1-2013:p0642:b003:l013","ordinal":125652,"en":"Hanging in the open plain."},{"id":"semetey-1-2013:p0642:b003:l014","ordinal":125653,"en":"For Manas, visited by Khizir,"},{"id":"semetey-1-2013:p0642:b003:l015","ordinal":125654,"en":"That cauldron was found."},{"id":"semetey-1-2013:p0642:b003:l016","ordinal":125655,"en":"When the cauldron came to Manas,"},{"id":"semetey-1-2013:p0642:b003:l017","ordinal":125656,"en":"Sacred power came with it."},{"id":"semetey-1-2013:p0642:b003:l018","ordinal":125657,"en":"Bakai of Oluyat,"},{"id":"semetey-1-2013:p0642:b003:l019","ordinal":125658,"en":"Ajibai of Khan Argin,"},{"id":"semetey-1-2013:p0642:b003:l020","ordinal":125659,"en":"Chubak of Akbaltai,"},{"id":"semetey-1-2013:p0642:b003:l021","ordinal":125660,"en":"Almambet of Khan Aziz—"},{"id":"semetey-1-2013:p0642:b003:l022","ordinal":125661,"en":"Enough, all the mighty warriors were found."},{"id":"semetey-1-2013:p0642:b003:l023","ordinal":125662,"en":"For Manas, visited by Khizir,"},{"id":"semetey-1-2013:p0642:b003:l024","ordinal":125663,"en":"Many things were found."},{"id":"semetey-1-2013:p0642:b003:l025","ordinal":125664,"en":"Manas, visited by Baabedin,"},{"id":"semetey-1-2013:p0642:b003:l026","ordinal":125665,"en":"Encountered all the warriors."},{"id":"semetey-1-2013:p0642:b003:l027","ordinal":125666,"en":"The finest of cauldrons, the brass cauldron,"},{"id":"semetey-1-2013:p0642:b003:l028","ordinal":125667,"en":"The finest of wives, Kanykei—"},{"id":"semetey-1-2013:p0642:b003:l029","ordinal":125668,"en":"God alone brought them all;"},{"id":"semetey-1-2013:p0642:b003:l030","ordinal":125669,"en":"These were found for the sovereign."},{"id":"semetey-1-2013:p0642:b003:l031","ordinal":125670,"en":"Manas's supernatural cauldron,"},{"id":"semetey-1-2013:p0642:b003:l032","ordinal":125671,"en":"Its handles were folded fourfold."},{"id":"semetey-1-2013:p0642:b003:l033","ordinal":125672,"en":"Whenever he went on a holy campaign, he never left it,"},{"id":"semetey-1-2013:p0642:b003:l034","ordinal":125673,"en":"To give food to the army,"},{"id":"semetey-1-2013:p0642:b003:l035","ordinal":125674,"en":"He loaded that cauldron along."},{"id":"semetey-1-2013:p0642:b003:l036","ordinal":125675,"en":"The cauldron boiled, then quieted;"},{"id":"semetey-1-2013:p0642:b003:l037","ordinal":125676,"en":"All the guards ate their fill."},{"id":"semetey-1-2013:p0642:b003:l038","ordinal":125677,"en":"God's light shone upon the cauldron;"},{"id":"semetey-1-2013:p0642:b003:l039","ordinal":125678,"en":"Every belly was filled,"},{"id":"semetey-1-2013:p0642:b004:l001","ordinal":125679,"en":"Every sorrow was dispelled."},{"id":"semetey-1-2013:p0642:b004:l002","ordinal":125680,"en":"Entering Keng-Kol, finding the land,"},{"id":"semetey-1-2013:p0642:b004:l003","ordinal":125681,"en":"Finding Khan Manas's only son,"},{"id":"semetey-1-2013:p0642:b004:l004","ordinal":125682,"en":"A warrior like Semetey—"},{"id":"semetey-1-2013:p0642:b004:l005","ordinal":125683,"en":"The forty guards left naked,"},{"id":"semetey-1-2013:p0642:b004:l006","ordinal":125684,"en":"And Bölökbai, now smiling,"},{"id":"semetey-1-2013:p0642:b004:l007","ordinal":125685,"en":"Took the short path inward."},{"id":"semetey-1-2013:p0642:b004:l008","ordinal":125686,"en":"All the guards,"},{"id":"semetey-1-2013:p0642:b004:l009","ordinal":125687,"en":"With Khan Bakai at their head,"},{"id":"semetey-1-2013:p0642:b004:l010","ordinal":125688,"en":"He led toward the treasury."},{"id":"semetey-1-2013:p0642:b004:l011","ordinal":125689,"en":"Your poor one left by Manas,"},{"id":"semetey-1-2013:p0642:b004:l012","ordinal":125690,"en":"Your falcon left by the sovereign—"},{"id":"semetey-1-2013:p0642:b004:l013","ordinal":125691,"en":"The treasury his mother Kanykei had hidden,"},{"id":"semetey-1-2013:p0642:b004:l014","ordinal":125692,"en":"He opened its entrance now."},{"id":"semetey-1-2013:p0642:b004:l015","ordinal":125693,"en":"To all forty guards,"},{"id":"semetey-1-2013:p0642:b004:l016","ordinal":125694,"en":"Red gold and precious stones"},{"id":"semetey-1-2013:p0642:b004:l017","ordinal":125695,"en":"He scattered freely now."},{"id":"semetey-1-2013:p0642:b004:l018","ordinal":125696,"en":"Then he went farther in;"}]
