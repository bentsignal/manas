{"id": "sayakbay-ms-current146:pdf073:l014", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 73, "folio": 456, "line_in_page": 14, "raw": "Көөдөндө далай ыйлай бар,", "text": "Көөдөндө далай ыйлай бар,", "en": "There is much weeping in the breast,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Final phrase is difficult and provisional.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf073:l015", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 73, "folio": 456, "line_in_page": 15, "raw": "Тамашчысы, чондурсун,", "text": "Тамашчысы, чондурсун,", "en": "Let his jester make it grand,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Highly uncertain cursive line.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf073:l016", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 73, "folio": 456, "line_in_page": 16, "raw": "Чокоюңа кудай бар,", "text": "Чокоюңа кудай бар,", "en": "There is a god over your rough shoe,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Literal reading is clear enough, but proverbial sense is uncertain.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf073:l017", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 73, "folio": 456, "line_in_page": 17, "raw": "Сом темирге балта бар,", "text": "Сом темирге балта бар,", "en": "For solid iron there is an axe,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf073:l018", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 73, "folio": 456, "line_in_page": 18, "raw": "Чокоюңдагы алда бар.", "text": "Чокоюңдагы алда бар.", "en": "There is deceit within your rough shoe.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Proverbial wording is provisional.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf073:l019", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 73, "folio": 456, "line_in_page": 19, "raw": "Акылман балак билген ал,", "text": "Акылман балак билген ал,", "en": "That wise man knew the calamity,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The noun балак is an uncertain manuscript form.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf073:l020", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 73, "folio": 456, "line_in_page": 20, "raw": "Акылың тайыз хан болсоң,", "text": "Акылың тайыз хан болсоң,", "en": "If you are a shallow-witted khan,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf073:l021", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 73, "folio": 456, "line_in_page": 21, "raw": "Бу мойнумдан илип сал,", "text": "Бу мойнумдан илип сал,", "en": "Hang it from this neck of mine,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf073:l022", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 73, "folio": 456, "line_in_page": 22, "raw": "Көзөп айтып коргоду,", "text": "Көзөп айтып коргоду,", "en": "He spoke piercingly and defended it,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Verb is provisionally read Көзөп.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf073:l023", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 73, "folio": 456, "line_in_page": 23, "raw": "Көрүп айтып билгенди,", "text": "Көрүп айтып билгенди,", "en": "Speaking of what he saw and knew,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf073:l024", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 73, "folio": 456, "line_in_page": 24, "raw": "Аман салып алуучу,", "text": "Аман салып алуучу,", "en": "One who brings them safely through,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Elliptical participial line.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf073:l025", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 73, "folio": 456, "line_in_page": 25, "raw": "Ак калпак оңой эл эмес,", "text": "Ак калпак оңой эл эмес,", "en": "The white-kalpak people are not an easy people,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf073:l026", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 73, "folio": 456, "line_in_page": 26, "raw": "Карман башын кестирип,", "text": "Карман башын кестирип,", "en": "Having Karman’s head cut off,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Name Карман is provisional.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf073:l027", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 73, "folio": 456, "line_in_page": 27, "raw": "Колуңда турган мен эмес.", "text": "Колуңда турган мен эмес.", "en": "I am not one who stands in your hand.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf073:l028", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 73, "folio": 456, "line_in_page": 28, "raw": "Хан кылым кезде жар,", "text": "Хан кылым кезде жар,", "en": "When the khan’s age comes, cry out,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Highly uncertain cursive line.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf073:l029", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 73, "folio": 456, "line_in_page": 29, "raw": "Колуңда турган мен эмес,", "text": "Колуңда турган мен эмес,", "en": "I am not one who stands in your hand,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf073:l030", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 73, "folio": 456, "line_in_page": 30, "raw": "Душман сырын айттың деп,", "text": "Душман сырын айттың деп,", "en": "Saying, “You revealed the enemy’s secret,”", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf073:l031", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 73, "folio": 456, "line_in_page": 31, "raw": "Сенин бу кылганың эр эмес.", "text": "Сенин бу кылганың эр эмес.", "en": "This deed of yours is not manly.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf073:l032", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 73, "folio": 456, "line_in_page": 32, "raw": "Чынын айтып каргандың,", "text": "Чынын айтып каргандың,", "en": "You cursed him for speaking the truth,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Final verb is provisionally read каргандың.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf073:l033", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 73, "folio": 456, "line_in_page": 33, "raw": "Чыр кылсаң тийди сөрөсүң,", "text": "Чыр кылсаң тийди сөрөсүң,", "en": "If you make strife, its blow will reach you,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Highly uncertain cursive and interpretation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf073:l034", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 73, "folio": 456, "line_in_page": 34, "raw": "Каарданып какайсаң,", "text": "Каарданып какайсаң,", "en": "If you rage and stiffen in anger,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf073:l035", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 73, "folio": 456, "line_in_page": 35, "raw": "Карат кылып көрөсүң.", "text": "Карат кылып көрөсүң.", "en": "You will see it brought to submission.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Verb phrase is provisional.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf073:l036", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 73, "folio": 456, "line_in_page": 36, "raw": "Бекерлик болот мүшкүлүң.", "text": "Бекерлик болот мүшкүлүң.", "en": "Your folly will become your affliction.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Final noun normalized as мүшкүлүң from compressed cursive.", "bbox": null}
