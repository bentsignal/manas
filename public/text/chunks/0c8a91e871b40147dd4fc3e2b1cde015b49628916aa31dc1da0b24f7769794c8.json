[{"id":"semetey-1-2013:p1243:b003:l022","ordinal":171009,"en":"Saying, ‘Take his wife,’"},{"id":"semetey-1-2013:p1243:b003:l023","ordinal":171010,"en":"You drove us toward death."},{"id":"semetey-1-2013:p1243:b003:l024","ordinal":171011,"en":"You have become deranged—"},{"id":"semetey-1-2013:p1243:b003:l025","ordinal":171012,"en":"Why desire corruption so greatly?"},{"id":"semetey-1-2013:p1243:b003:l026","ordinal":171013,"en":"The one who charged and attacked me"},{"id":"semetey-1-2013:p1243:b003:l027","ordinal":171014,"en":"Was Semetey himself;"},{"id":"semetey-1-2013:p1243:b003:l028","ordinal":171015,"en":"For all the peoples of the age,"},{"id":"semetey-1-2013:p1243:b003:l029","ordinal":171016,"en":"His time to bring slaughter had come."},{"id":"semetey-1-2013:p1243:b003:l030","ordinal":171017,"en":"Aychürök, daughter of Akun,"},{"id":"semetey-1-2013:p1243:b003:l031","ordinal":171018,"en":"Had worn her horse's flanks lean,"},{"id":"semetey-1-2013:p1243:b003:l032","ordinal":171019,"en":"Traveling through the whole world;"},{"id":"semetey-1-2013:p1243:b003:l033","ordinal":171020,"en":"The time had come for her"},{"id":"semetey-1-2013:p1243:b003:l034","ordinal":171021,"en":"To bring merciless turmoil."},{"id":"semetey-1-2013:p1243:b003:l035","ordinal":171022,"en":"You foolish colt, you do not know it;"},{"id":"semetey-1-2013:p1243:b003:l036","ordinal":171023,"en":"Her husband was mighty Semetey,"},{"id":"semetey-1-2013:p1243:b003:l037","ordinal":171024,"en":"And the time had come for her"},{"id":"semetey-1-2013:p1243:b003:l038","ordinal":171025,"en":"To lead him here."},{"id":"semetey-1-2013:p1243:b003:l039","ordinal":171026,"en":"You meant to strip off my coat,"},{"id":"semetey-1-2013:p1243:b005:l001","ordinal":171027,"en":"Accursed fugitive slave;"},{"id":"semetey-1-2013:p1243:b005:l002","ordinal":171028,"en":"Listen to my answer."},{"id":"semetey-1-2013:p1243:b005:l003","ordinal":171029,"en":"You meant to show my eyes"},{"id":"semetey-1-2013:p1243:b005:l004","ordinal":171030,"en":"A wonder fit for men to see."},{"id":"semetey-1-2013:p1243:b005:l005","ordinal":171031,"en":"The son of Manas proved a lion;"},{"id":"semetey-1-2013:p1243:b005:l006","ordinal":171032,"en":"Semetey of terrible intent"},{"id":"semetey-1-2013:p1243:b005:l007","ordinal":171033,"en":"Had come to us this year—"},{"id":"semetey-1-2013:p1243:b005:l008","ordinal":171034,"en":"His time to bring slaughter had come."},{"id":"semetey-1-2013:p1243:b005:l009","ordinal":171035,"en":"While among your own people,"},{"id":"semetey-1-2013:p1243:b005:l010","ordinal":171036,"en":"You were hero Khoja;"},{"id":"semetey-1-2013:p1243:b005:l011","ordinal":171037,"en":"Stirring conflict over everything and nothing,"},{"id":"semetey-1-2013:p1243:b005:l012","ordinal":171038,"en":"You were infidel Khoja."},{"id":"semetey-1-2013:p1243:b005:l013","ordinal":171039,"en":"At Jeti-Özön, the Jediger—"},{"id":"semetey-1-2013:p1243:b005:l014","ordinal":171040,"en":"You reached and gathered them;"},{"id":"semetey-1-2013:p1243:b005:l015","ordinal":171041,"en":"Inciting this people,"},{"id":"semetey-1-2013:p1243:b005:l016","ordinal":171042,"en":"You caused them to be slaughtered."},{"id":"semetey-1-2013:p1243:b005:l017","ordinal":171043,"en":"At Kökötöy's memorial feast,"},{"id":"semetey-1-2013:p1243:b005:l018","ordinal":171044,"en":"You will not let me tell what I saw."},{"id":"semetey-1-2013:p1243:b005:l019","ordinal":171045,"en":"You bore black thoughts toward your kin;"},{"id":"semetey-1-2013:p1243:b005:l020","ordinal":171046,"en":"Indeed, Khoja, you will never prosper!"},{"id":"semetey-1-2013:p1243:b005:l021","ordinal":171047,"en":"Your senses have left you, hero Khoja;"},{"id":"semetey-1-2013:p1243:b005:l022","ordinal":171048,"en":"You understand nothing."},{"id":"semetey-1-2013:p1243:b005:l023","ordinal":171049,"en":"Father and mother—"},{"id":"semetey-1-2013:p1243:b005:l024","ordinal":171050,"en":"You curse them and make them a mockery!”"},{"id":"semetey-1-2013:p1243:b005:l025","ordinal":171051,"en":"As Toltoy stood speaking thus,"},{"id":"semetey-1-2013:p1243:b005:l026","ordinal":171052,"en":"Dear Khoja grew heated."},{"id":"semetey-1-2013:p1243:b005:l027","ordinal":171053,"en":"Now Chynkojo came forth,"},{"id":"semetey-1-2013:p1243:b005:l028","ordinal":171054,"en":"Speaking to hero Toltoy:"},{"id":"semetey-1-2013:p1243:b005:l029","ordinal":171055,"en":"“In pursuing a bride,"},{"id":"semetey-1-2013:p1243:b005:l030","ordinal":171056,"en":"You proved hero Toltoy;"},{"id":"semetey-1-2013:p1243:b005:l031","ordinal":171057,"en":"In cursing father and mother,"},{"id":"semetey-1-2013:p1243:b005:l032","ordinal":171058,"en":"You proved infidel Toltoy."},{"id":"semetey-1-2013:p1243:b005:l033","ordinal":171059,"en":"You do not know your own brutality;"},{"id":"semetey-1-2013:p1243:b005:l034","ordinal":171060,"en":"Father and mother—"},{"id":"semetey-1-2013:p1243:b005:l035","ordinal":171061,"en":"You curse them and make them a mockery."},{"id":"semetey-1-2013:p1243:b005:l036","ordinal":171062,"en":"Crying, ‘A boy speared me,’"},{"id":"semetey-1-2013:p1243:b005:l037","ordinal":171063,"en":"You come shouting."},{"id":"semetey-1-2013:p1243:b005:l038","ordinal":171064,"en":"My blustering Toltoy,"},{"id":"semetey-1-2013:p1243:b005:l039","ordinal":171065,"en":"If you continue thus, you will die!"},{"id":"semetey-1-2013:p1244:b003:l001","ordinal":171066,"en":"Becoming a stranger to the Argyn people,"},{"id":"semetey-1-2013:p1244:b003:l002","ordinal":171067,"en":"Was it wrong that I came to your village?"},{"id":"semetey-1-2013:p1244:b003:l003","ordinal":171068,"en":"You seem to have been defeated—"},{"id":"semetey-1-2013:p1244:b003:l004","ordinal":171069,"en":"Are all twelve parts of your body whole?"},{"id":"semetey-1-2013:p1244:b003:l005","ordinal":171070,"en":"Ill-fated Khan Toltoi,"},{"id":"semetey-1-2013:p1244:b003:l006","ordinal":171071,"en":"What shall I do with your lies?"},{"id":"semetey-1-2013:p1244:b003:l007","ordinal":171072,"en":"You said countless men led by Manas"},{"id":"semetey-1-2013:p1244:b003:l008","ordinal":171073,"en":"Had emerged from Batkal—"},{"id":"semetey-1-2013:p1244:b003:l009","ordinal":171074,"en":"Was this not a lie?"},{"id":"semetey-1-2013:p1244:b003:l010","ordinal":171075,"en":"Manas blessed by Kydyr had died"},{"id":"semetey-1-2013:p1244:b003:l011","ordinal":171076,"en":"And beheld the place of Judgment."},{"id":"semetey-1-2013:p1244:b003:l012","ordinal":171077,"en":"Saying Bakai had appeared,"},{"id":"semetey-1-2013:p1244:b003:l013","ordinal":171078,"en":"You spoke meaningless words."},{"id":"semetey-1-2013:p1244:b003:l014","ordinal":171079,"en":"Lord Bakai had been a khan;"},{"id":"semetey-1-2013:p1244:b003:l015","ordinal":171080,"en":"When his prince passed away,"},{"id":"semetey-1-2013:p1244:b003:l016","ordinal":171081,"en":"Herding camels in Talas,"},{"id":"semetey-1-2013:p1244:b003:l017","ordinal":171082,"en":"He was a broken man."},{"id":"semetey-1-2013:p1244:b003:l018","ordinal":171083,"en":"Saying Almambet had appeared,"},{"id":"semetey-1-2013:p1244:b003:l019","ordinal":171084,"en":"You spoke in reckless haste;"},{"id":"semetey-1-2013:p1244:b003:l020","ordinal":171085,"en":"He went to behold the face of Judgment,"},{"id":"semetey-1-2013:p1244:b003:l021","ordinal":171086,"en":"And has long been dead."},{"id":"semetey-1-2013:p1244:b003:l022","ordinal":171087,"en":"Saying Chubak had entered,"},{"id":"semetey-1-2013:p1244:b003:l023","ordinal":171088,"en":"You spread an uproar."},{"id":"semetey-1-2013:p1244:b003:l024","ordinal":171089,"en":"A star was eclipsed in the sky;"},{"id":"semetey-1-2013:p1244:b003:l025","ordinal":171090,"en":"In cowardice, Chubak fled Beijing"},{"id":"semetey-1-2013:p1244:b003:l026","ordinal":171091,"en":"And escaped alive."},{"id":"semetey-1-2013:p1244:b003:l027","ordinal":171092,"en":"He was a coward then;"},{"id":"semetey-1-2013:p1244:b003:l028","ordinal":171093,"en":"No one knows where he went."},{"id":"semetey-1-2013:p1244:b003:l029","ordinal":171094,"en":"Speaking so many useless words,"},{"id":"semetey-1-2013:p1244:b003:l030","ordinal":171095,"en":"Toltoi, you will never prosper;"},{"id":"semetey-1-2013:p1244:b003:l031","ordinal":171096,"en":"If you continue like this, poor man,"},{"id":"semetey-1-2013:p1244:b003:l032","ordinal":171097,"en":"There will never be another like you!"},{"id":"semetey-1-2013:p1244:b003:l033","ordinal":171098,"en":"“The shameless face"},{"id":"semetey-1-2013:p1244:b003:l034","ordinal":171099,"en":"Of that accursed Toltoi,"},{"id":"semetey-1-2013:p1244:b003:l035","ordinal":171100,"en":"Who has caused so much trouble”—"},{"id":"semetey-1-2013:p1244:b003:l036","ordinal":171101,"en":"As though slaughter had struck him,"},{"id":"semetey-1-2013:p1244:b003:l037","ordinal":171102,"en":"He lay twisted aside."},{"id":"semetey-1-2013:p1244:b003:l038","ordinal":171103,"en":"Saying, “Where is his flesh?”"},{"id":"semetey-1-2013:p1244:b003:l039","ordinal":171104,"en":"Chynkojo’s wrestler,"},{"id":"semetey-1-2013:p1244:b004:l001","ordinal":171105,"en":"Receiving Khojo’s command,"},{"id":"semetey-1-2013:p1244:b004:l002","ordinal":171106,"en":"Looked upon"},{"id":"semetey-1-2013:p1244:b004:l003","ordinal":171107,"en":"Dear hero Toltoi’s wound."},{"id":"semetey-1-2013:p1244:b004:l004","ordinal":171108,"en":"Below the belt at his waist,"},{"id":"semetey-1-2013:p1244:b004:l005","ordinal":171109,"en":"The flesh was torn and flayed,"},{"id":"semetey-1-2013:p1244:b004:l006","ordinal":171110,"en":"Gouged out and blackened,"},{"id":"semetey-1-2013:p1244:b004:l007","ordinal":171111,"en":"And swollen thick"},{"id":"semetey-1-2013:p1244:b004:l008","ordinal":171112,"en":"As though become a dark-red berry."},{"id":"semetey-1-2013:p1244:b004:l009","ordinal":171113,"en":"Among the Jediger host"},{"id":"semetey-1-2013:p1244:b004:l010","ordinal":171114,"en":"His healers were more than could be counted;"},{"id":"semetey-1-2013:p1244:b004:l011","ordinal":171115,"en":"His careful physicians were even more."},{"id":"semetey-1-2013:p1244:b004:l012","ordinal":171116,"en":"The healers gathered,"},{"id":"semetey-1-2013:p1244:b004:l013","ordinal":171117,"en":"Set a cupping horn upon the wound,"},{"id":"semetey-1-2013:p1244:b004:l014","ordinal":171118,"en":"And drew out together"},{"id":"semetey-1-2013:p1244:b004:l015","ordinal":171119,"en":"Every drop of bad blood."},{"id":"semetey-1-2013:p1244:b004:l016","ordinal":171120,"en":"There was medicine called “Üpü”;"},{"id":"semetey-1-2013:p1244:b004:l017","ordinal":171121,"en":"They applied it three times."},{"id":"semetey-1-2013:p1244:b004:l018","ordinal":171122,"en":"There was medicine called “Sebep”;"},{"id":"semetey-1-2013:p1244:b004:l019","ordinal":171123,"en":"They applied that as well."},{"id":"semetey-1-2013:p1244:b004:l020","ordinal":171124,"en":"Though they treated Toltoi,"},{"id":"semetey-1-2013:p1244:b004:l021","ordinal":171125,"en":"Who had come seeking a wife,"},{"id":"semetey-1-2013:p1244:b004:l022","ordinal":171126,"en":"The wound gave off a strange vapor;"},{"id":"semetey-1-2013:p1244:b004:l023","ordinal":171127,"en":"The patterned spear that had passed through"},{"id":"semetey-1-2013:p1244:b004:l024","ordinal":171128,"en":"Carried such a terrible poison."},{"id":"semetey-1-2013:p1244:b004:l025","ordinal":171129,"en":"Its point had been sharpened and formed—"},{"id":"semetey-1-2013:p1244:b004:l026","ordinal":171130,"en":"Semetey’s patterned spear,"},{"id":"semetey-1-2013:p1244:b004:l027","ordinal":171131,"en":"Whose sight delighted a man."},{"id":"semetey-1-2013:p1244:b004:l028","ordinal":171132,"en":"So that whoever it struck would fester and die,"},{"id":"semetey-1-2013:p1244:b004:l029","ordinal":171133,"en":"It had been tempered for six full days"},{"id":"semetey-1-2013:p1244:b004:l030","ordinal":171134,"en":"In a dragon’s venom."},{"id":"semetey-1-2013:p1244:b004:l031","ordinal":171135,"en":"Whenever it made a wound,"},{"id":"semetey-1-2013:p1244:b004:l032","ordinal":171136,"en":"The wound turned foul and festered—"},{"id":"semetey-1-2013:p1244:b004:l033","ordinal":171137,"en":"Such was the patterned spear’s nature."},{"id":"semetey-1-2013:p1244:b004:l034","ordinal":171138,"en":"Khojo saw it and spoke,"},{"id":"semetey-1-2013:p1244:b004:l035","ordinal":171139,"en":"Uttering a secret marvel:"},{"id":"semetey-1-2013:p1244:b004:l036","ordinal":171140,"en":"“No hero drove that spear;"},{"id":"semetey-1-2013:p1244:b004:l037","ordinal":171141,"en":"A child must have thrust it."},{"id":"semetey-1-2013:p1244:b004:l038","ordinal":171142,"en":"A hero does not punch with a spear—"},{"id":"semetey-1-2013:p1244:b004:l039","ordinal":171143,"en":"It was only a shallow thrust."},{"id":"semetey-1-2013:p1245:b003:l001","ordinal":171144,"en":"You have wept for nothing,"},{"id":"semetey-1-2013:p1245:b003:l002","ordinal":171145,"en":"You accursed Toltoi."},{"id":"semetey-1-2013:p1245:b003:l003","ordinal":171146,"en":"If Semetey had speared you, he would not spare you;"},{"id":"semetey-1-2013:p1245:b003:l004","ordinal":171147,"en":"He would never leave you alive."},{"id":"semetey-1-2013:p1245:b003:l005","ordinal":171148,"en":"After Semetey comes Kanchoro—"},{"id":"semetey-1-2013:p1245:b003:l006","ordinal":171149,"en":"What would you do if he speared you?"},{"id":"semetey-1-2013:p1245:b003:l007","ordinal":171150,"en":"You would not remain alive, Toltoi;"},{"id":"semetey-1-2013:p1245:b003:l008","ordinal":171151,"en":"You would depart this world."},{"id":"semetey-1-2013:p1245:b003:l009","ordinal":171152,"en":"Almambet was a Chinese-born man;"},{"id":"semetey-1-2013:p1245:b003:l010","ordinal":171153,"en":"As for this wound that pierced you,"},{"id":"semetey-1-2013:p1245:b003:l011","ordinal":171154,"en":"There is an orphan named Külchoro,"},{"id":"semetey-1-2013:p1245:b003:l012","ordinal":171155,"en":"The son of Almambet."},{"id":"semetey-1-2013:p1245:b003:l013","ordinal":171156,"en":"He was the one who speared you."},{"id":"semetey-1-2013:p1245:b003:l014","ordinal":171157,"en":"Hero Toltoi of the Jediger,"},{"id":"semetey-1-2013:p1245:b003:l015","ordinal":171158,"en":"You do not recognize your own folly;"},{"id":"semetey-1-2013:p1245:b003:l016","ordinal":171159,"en":"Having taken a spear wound from a child,"},{"id":"semetey-1-2013:p1245:b003:l017","ordinal":171160,"en":"You curse everything in sight."},{"id":"semetey-1-2013:p1245:b003:l018","ordinal":171161,"en":"Jediger—damn your father’s grave—"},{"id":"semetey-1-2013:p1245:b003:l019","ordinal":171162,"en":"If you flee, you have eaten filth;"},{"id":"semetey-1-2013:p1245:b003:l020","ordinal":171163,"en":"Consulting in pairs,"},{"id":"semetey-1-2013:p1245:b003:l021","ordinal":171164,"en":"What more did you say?”"},{"id":"semetey-1-2013:p1245:b003:l022","ordinal":171165,"en":"The many Black Jediger,"},{"id":"semetey-1-2013:p1245:b003:l023","ordinal":171166,"en":"With dear Khojo at their head,"},{"id":"semetey-1-2013:p1245:b003:l024","ordinal":171167,"en":"Grieved for Toltoi"},{"id":"semetey-1-2013:p1245:b003:l025","ordinal":171168,"en":"And lay crowded around him."},{"id":"semetey-1-2013:p1245:b003:l026","ordinal":171169,"en":"Seething Khan Toltoi—"},{"id":"semetey-1-2013:p1245:b003:l027","ordinal":171170,"en":"Let us leave him thus,"},{"id":"semetey-1-2013:p1245:b003:l028","ordinal":171171,"en":"Külchoro, who failed to spear him—"},{"id":"semetey-1-2013:p1245:b003:l029","ordinal":171172,"en":"Let us begin the tale from there."},{"id":"semetey-1-2013:p1245:b003:l030","ordinal":171173,"en":"Turning back and sobbing,"},{"id":"semetey-1-2013:p1245:b003:l031","ordinal":171174,"en":"At the end of his recourse, Külchoro"},{"id":"semetey-1-2013:p1245:b003:l032","ordinal":171175,"en":"Screamed and wept in shame:"},{"id":"semetey-1-2013:p1245:b003:l033","ordinal":171176,"en":"“Oh, my deeply dug grave!"},{"id":"semetey-1-2013:p1245:b003:l034","ordinal":171177,"en":"Damn your father’s grave, false world;"},{"id":"semetey-1-2013:p1245:b003:l035","ordinal":171178,"en":"Oh, my sorrow boiling over!”"},{"id":"semetey-1-2013:p1245:b003:l036","ordinal":171179,"en":"Saying these words then,"},{"id":"semetey-1-2013:p1245:b003:l037","ordinal":171180,"en":"He heaved in fury"},{"id":"semetey-1-2013:p1245:b003:l038","ordinal":171181,"en":"And trembled in grief."},{"id":"semetey-1-2013:p1245:b003:l039","ordinal":171182,"en":"“I am a champion of twelve years;"},{"id":"semetey-1-2013:p1245:b004:l001","ordinal":171183,"en":"My death came, yet I did not die."},{"id":"semetey-1-2013:p1245:b004:l002","ordinal":171184,"en":"I was not said to have died by Toltoi"},{"id":"semetey-1-2013:p1245:b004:l003","ordinal":171185,"en":"And did not behold the next world."},{"id":"semetey-1-2013:p1245:b004:l004","ordinal":171186,"en":"Before reaching my full strength,"},{"id":"semetey-1-2013:p1245:b004:l005","ordinal":171187,"en":"I did not die belatedly."},{"id":"semetey-1-2013:p1245:b004:l006","ordinal":171188,"en":"My beloved uncle,"},{"id":"semetey-1-2013:p1245:b004:l007","ordinal":171189,"en":"Without caring for his horse’s worth,"},{"id":"semetey-1-2013:p1245:b004:l008","ordinal":171190,"en":"Gave me his horse unstintingly."},{"id":"semetey-1-2013:p1245:b004:l009","ordinal":171191,"en":"What shall I do with this hellish world?"},{"id":"semetey-1-2013:p1245:b004:l010","ordinal":171192,"en":"My mountain-like uncle,"},{"id":"semetey-1-2013:p1245:b004:l011","ordinal":171193,"en":"Without caring for his armor’s worth,"},{"id":"semetey-1-2013:p1245:b004:l012","ordinal":171194,"en":"Gave me his armor unstintingly."},{"id":"semetey-1-2013:p1245:b004:l013","ordinal":171195,"en":"Mountain-like great Toltoi"},{"id":"semetey-1-2013:p1245:b004:l014","ordinal":171196,"en":"Fled bobbing away; I speared at him—"},{"id":"semetey-1-2013:p1245:b004:l015","ordinal":171197,"en":"How can I return, unworthy?"},{"id":"semetey-1-2013:p1245:b004:l016","ordinal":171198,"en":"My heart sinks; death is just."},{"id":"semetey-1-2013:p1245:b004:l017","ordinal":171199,"en":"If I serve faithfully, my heart is pure;"},{"id":"semetey-1-2013:p1245:b004:l018","ordinal":171200,"en":"After turning back, unable to spear"},{"id":"semetey-1-2013:p1245:b004:l019","ordinal":171201,"en":"That doomed Toltoi,"},{"id":"semetey-1-2013:p1245:b004:l020","ordinal":171202,"en":"Death is better than this disgrace!"},{"id":"semetey-1-2013:p1245:b004:l021","ordinal":171203,"en":"My beloved khan and uncle,"},{"id":"semetey-1-2013:p1245:b004:l022","ordinal":171204,"en":"Saying, ‘May his heart be rich with fat,’"},{"id":"semetey-1-2013:p1245:b004:l023","ordinal":171205,"en":"Fed him thick slices from the ribs;"},{"id":"semetey-1-2013:p1245:b004:l024","ordinal":171206,"en":"When did he ever let"},{"id":"semetey-1-2013:p1245:b004:l025","ordinal":171207,"en":"Argyn or Kyrgyz call me a mere child?"},{"id":"semetey-1-2013:p1245:b004:l026","ordinal":171208,"en":"We kicked together as foals and yearlings;"},{"id":"semetey-1-2013:p1245:b004:l027","ordinal":171209,"en":"My leopard uncle and I"},{"id":"semetey-1-2013:p1245:b004:l028","ordinal":171210,"en":"Fought to suck the same breast."},{"id":"semetey-1-2013:p1245:b004:l029","ordinal":171211,"en":"The stallion that could carry Altai—"},{"id":"semetey-1-2013:p1245:b004:l030","ordinal":171212,"en":"Unable to take that fool Toltoi,"},{"id":"semetey-1-2013:p1245:b004:l031","ordinal":171213,"en":"I stand wailing and weeping."},{"id":"semetey-1-2013:p1245:b004:l032","ordinal":171214,"en":"Toltoi of the Jediger—"},{"id":"semetey-1-2013:p1245:b004:l033","ordinal":171215,"en":"I thought him a hero, but he was lesser;"},{"id":"semetey-1-2013:p1245:b004:l034","ordinal":171216,"en":"The accursed, pale Toltoi"},{"id":"semetey-1-2013:p1245:b004:l035","ordinal":171217,"en":"Was level with the black earth."},{"id":"semetey-1-2013:p1245:b004:l036","ordinal":171218,"en":"When I shouted and leveled my spear,"},{"id":"semetey-1-2013:p1245:b004:l037","ordinal":171219,"en":"Though I am twelve years old,"},{"id":"semetey-1-2013:p1245:b004:l038","ordinal":171220,"en":"I lacked the strength to take Toltoi."},{"id":"semetey-1-2013:p1245:b004:l039","ordinal":171221,"en":"When I go in to my uncle,"},{"id":"semetey-1-2013:p1246:b003:l001","ordinal":171222,"en":"I do not even have a wound to show."},{"id":"semetey-1-2013:p1246:b003:l002","ordinal":171223,"en":"Unable to match Toltoi’s strength,"},{"id":"semetey-1-2013:p1246:b003:l003","ordinal":171224,"en":"Was I to return crestfallen?"},{"id":"semetey-1-2013:p1246:b003:l004","ordinal":171225,"en":"So this is what the filthy world is."},{"id":"semetey-1-2013:p1246:b003:l005","ordinal":171226,"en":"Wishing to die but unable,"},{"id":"semetey-1-2013:p1246:b003:l006","ordinal":171227,"en":"A strange ordeal befell my head;"},{"id":"semetey-1-2013:p1246:b003:l007","ordinal":171228,"en":"I could not take my own life."},{"id":"semetey-1-2013:p1246:b003:l008","ordinal":171229,"en":"How can I go without shame"},{"id":"semetey-1-2013:p1246:b003:l009","ordinal":171230,"en":"To my mountain-like uncle"},{"id":"semetey-1-2013:p1246:b003:l010","ordinal":171231,"en":"And say, ‘Toltoi escaped’?"},{"id":"semetey-1-2013:p1246:b003:l011","ordinal":171232,"en":"Speaking thus in this way,"},{"id":"semetey-1-2013:p1246:b003:l012","ordinal":171233,"en":"His heart was grievously torn;"},{"id":"semetey-1-2013:p1246:b003:l013","ordinal":171234,"en":"Unable to cease his sorrow,"},{"id":"semetey-1-2013:p1246:b003:l014","ordinal":171235,"en":"What could dear Choro do?"},{"id":"semetey-1-2013:p1246:b003:l015","ordinal":171236,"en":"Tears poured from his eyes."},{"id":"semetey-1-2013:p1246:b003:l016","ordinal":171237,"en":"Perhaps I should take"},{"id":"semetey-1-2013:p1246:b003:l017","ordinal":171238,"en":"The gold-cheeked battle-axe now,"},{"id":"semetey-1-2013:p1246:b003:l018","ordinal":171239,"en":"Smash my own head,"},{"id":"semetey-1-2013:p1246:b003:l019","ordinal":171240,"en":"And leave myself wounded."},{"id":"semetey-1-2013:p1246:b003:l020","ordinal":171241,"en":"I could reach my uncle moaning,"},{"id":"semetey-1-2013:p1246:b003:l021","ordinal":171242,"en":"Saying, ‘Toltoi struck me without mercy!’"},{"id":"semetey-1-2013:p1246:b003:l022","ordinal":171243,"en":"When I come groaning in pain,"},{"id":"semetey-1-2013:p1246:b003:l023","ordinal":171244,"en":"Would that valley-spring, sheer cliff,"},{"id":"semetey-1-2013:p1246:b003:l024","ordinal":171245,"en":"Learn by chance that I struck myself"},{"id":"semetey-1-2013:p1246:b003:l025","ordinal":171246,"en":"With the axe?"},{"id":"semetey-1-2013:p1246:b003:l026","ordinal":171247,"en":"That double-wiled shrew"},{"id":"semetey-1-2013:p1246:b003:l027","ordinal":171248,"en":"Was a wondrous servant woman,"},{"id":"semetey-1-2013:p1246:b003:l028","ordinal":171249,"en":"One of the overbearing ones,"},{"id":"semetey-1-2013:p1246:b003:l029","ordinal":171250,"en":"A person of sacred power."},{"id":"semetey-1-2013:p1246:b003:l030","ordinal":171251,"en":"She knew today"},{"id":"semetey-1-2013:p1246:b003:l031","ordinal":171252,"en":"The suffering that would come in six months."},{"id":"semetey-1-2013:p1246:b003:l032","ordinal":171253,"en":"Rather than that, let me go to my uncle"},{"id":"semetey-1-2013:p1246:b003:l033","ordinal":171254,"en":"And tell the truth,"},{"id":"semetey-1-2013:p1246:b003:l034","ordinal":171255,"en":"Saying, ‘The hardship happened this way.’"},{"id":"semetey-1-2013:p1246:b003:l035","ordinal":171256,"en":"Like a prince sunk in sorrow,"},{"id":"semetey-1-2013:p1246:b003:l036","ordinal":171257,"en":"Young Külchoro grieved."},{"id":"semetey-1-2013:p1246:b003:l037","ordinal":171258,"en":"As though his khan father, lion Almambet,"},{"id":"semetey-1-2013:p1246:b003:l038","ordinal":171259,"en":"Had died,"},{"id":"semetey-1-2013:p1246:b003:l039","ordinal":171260,"en":"Unable to cease his lament,"},{"id":"semetey-1-2013:p1246:b004:l001","ordinal":171261,"en":"He turned back toward Afghanistan;"},{"id":"semetey-1-2013:p1246:b004:l002","ordinal":171262,"en":"Having let Khan Toltoi escape,"},{"id":"semetey-1-2013:p1246:b004:l003","ordinal":171263,"en":"Your young man returned grieving."},{"id":"semetey-1-2013:p1246:b004:l004","ordinal":171264,"en":"His heart remained torn apart;"}]
