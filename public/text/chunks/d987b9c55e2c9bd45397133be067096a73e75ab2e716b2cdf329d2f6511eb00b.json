[{"id":"semetey-1-2013:p0750:b004:l029","ordinal":134401,"en":"Bakai reached the boy."},{"id":"semetey-1-2013:p0750:b004:l030","ordinal":134402,"en":"He turned Kokcholok's head."},{"id":"semetey-1-2013:p0750:b004:l031","ordinal":134403,"en":"Old gray-maned Bakai"},{"id":"semetey-1-2013:p0750:b004:l032","ordinal":134404,"en":"Now spoke many words:"},{"id":"semetey-1-2013:p0750:b004:l033","ordinal":134405,"en":"\"The forty warriors left by your father,"},{"id":"semetey-1-2013:p0750:b004:l034","ordinal":134406,"en":"The elders with Kyrgyl at their head—"},{"id":"semetey-1-2013:p0750:b004:l035","ordinal":134407,"en":"Shuutu the servant made a scene"},{"id":"semetey-1-2013:p0750:b004:l036","ordinal":134408,"en":"And sent them all away."},{"id":"semetey-1-2013:p0750:b004:l037","ordinal":134409,"en":"At their court, I reckon,"},{"id":"semetey-1-2013:p0750:b004:l038","ordinal":134410,"en":"The heroes Abyke and Kobosh remain."},{"id":"semetey-1-2013:p0750:b004:l039","ordinal":134411,"en":"Let us go straight in and speak,"},{"id":"semetey-1-2013:p0751:b003:l001","ordinal":134412,"en":"My darling orphan,"},{"id":"semetey-1-2013:p0751:b003:l002","ordinal":134413,"en":"And pour out our grievances."},{"id":"semetey-1-2013:p0751:b003:l003","ordinal":134414,"en":"The abundant wealth left by your father Manas—"},{"id":"semetey-1-2013:p0751:b003:l004","ordinal":134415,"en":"Let us ask them to give us a gift."},{"id":"semetey-1-2013:p0751:b003:l005","ordinal":134416,"en":"Shame on death"},{"id":"semetey-1-2013:p0751:b003:l006","ordinal":134417,"en":"Heed these words of mine."},{"id":"semetey-1-2013:p0751:b003:l007","ordinal":134418,"en":"If those fools would cease to be fools,"},{"id":"semetey-1-2013:p0751:b003:l008","ordinal":134419,"en":"Their thoughts would not be alien to ours."},{"id":"semetey-1-2013:p0751:b003:l009","ordinal":134420,"en":"They share a father with your father;"},{"id":"semetey-1-2013:p0751:b003:l010","ordinal":134421,"en":"These dogs are the younger wife's sons."},{"id":"semetey-1-2013:p0751:b003:l011","ordinal":134422,"en":"The most wicked of the six,"},{"id":"semetey-1-2013:p0751:b003:l012","ordinal":134423,"en":"Ignorant, wretched Kobosh—"},{"id":"semetey-1-2013:p0751:b003:l013","ordinal":134424,"en":"Consider your uncle Kobosh,"},{"id":"semetey-1-2013:p0751:b003:l014","ordinal":134425,"en":"That coarse, unruly wretch."},{"id":"semetey-1-2013:p0751:b003:l015","ordinal":134426,"en":"Think, orphan, and heed my words."},{"id":"semetey-1-2013:p0751:b003:l016","ordinal":134427,"en":"Know this service I do for you.\""},{"id":"semetey-1-2013:p0751:b003:l017","ordinal":134428,"en":"So spoke great Bakai,"},{"id":"semetey-1-2013:p0751:b003:l018","ordinal":134429,"en":"With Semetey following him."},{"id":"semetey-1-2013:p0751:b003:l019","ordinal":134430,"en":"Eagerly setting out on the road,"},{"id":"semetey-1-2013:p0751:b003:l020","ordinal":134431,"en":"To Abyke and Kobosh"},{"id":"semetey-1-2013:p0751:b003:l021","ordinal":134432,"en":"To go and greet them,"},{"id":"semetey-1-2013:p0751:b003:l022","ordinal":134433,"en":"The poor orphan grew excited,"},{"id":"semetey-1-2013:p0751:b003:l023","ordinal":134434,"en":"And kept questioning Bakai."},{"id":"semetey-1-2013:p0751:b003:l024","ordinal":134435,"en":"As the boy asked,"},{"id":"semetey-1-2013:p0751:b003:l025","ordinal":134436,"en":"Poor Bakai spoke thus:"},{"id":"semetey-1-2013:p0751:b003:l026","ordinal":134437,"en":"\"My orphan son, come this way."},{"id":"semetey-1-2013:p0751:b003:l027","ordinal":134438,"en":"When hero Manas died,"},{"id":"semetey-1-2013:p0751:b003:l028","ordinal":134439,"en":"When the people gathered and buried him,"},{"id":"semetey-1-2013:p0751:b003:l029","ordinal":134440,"en":"When misfortune and hardship came,"},{"id":"semetey-1-2013:p0751:b003:l030","ordinal":134441,"en":"The Argyn and the Kyrgyz—"},{"id":"semetey-1-2013:p0751:b003:l031","ordinal":134442,"en":"Abyke, Kobosh, the six scoundrels,"},{"id":"semetey-1-2013:p0751:b003:l032","ordinal":134443,"en":"Gathered them all together."},{"id":"semetey-1-2013:p0751:b003:l033","ordinal":134444,"en":"Let me strike a crushing blow."},{"id":"semetey-1-2013:p0751:b003:l034","ordinal":134445,"en":"'Give nine unbred yearlings,' they said,"},{"id":"semetey-1-2013:p0751:b003:l035","ordinal":134446,"en":"'Give ninety thousand camel-loads of tea,' they said,"},{"id":"semetey-1-2013:p0751:b003:l036","ordinal":134447,"en":"And imposed tribute on the Kyrgyz."},{"id":"semetey-1-2013:p0751:b003:l037","ordinal":134448,"en":"'When the moon is dark,"},{"id":"semetey-1-2013:p0751:b003:l038","ordinal":134449,"en":"The night is like this,' they said."},{"id":"semetey-1-2013:p0751:b003:l039","ordinal":134450,"en":"'When the magnanimous one passes away,"},{"id":"semetey-1-2013:p0751:b004:l001","ordinal":134451,"en":"The day is like this,' they said."},{"id":"semetey-1-2013:p0751:b004:l002","ordinal":134452,"en":"Unable to find what they demanded,"},{"id":"semetey-1-2013:p0751:b004:l003","ordinal":134453,"en":"The Kyrgyz moved away to one place."},{"id":"semetey-1-2013:p0751:b004:l004","ordinal":134454,"en":"Unable to find six thousand yearlings of barren mares,"},{"id":"semetey-1-2013:p0751:b004:l005","ordinal":134455,"en":"Unable to find sixty camel-loads of tea,"},{"id":"semetey-1-2013:p0751:b004:l006","ordinal":134456,"en":"The Argyn moved away to another place."},{"id":"semetey-1-2013:p0751:b004:l007","ordinal":134457,"en":"The Kyrgyz people left by bloodthirsty Manas"},{"id":"semetey-1-2013:p0751:b004:l009","ordinal":134458,"en":"Abyke and Kobosh scattered."},{"id":"semetey-1-2013:p0751:b004:l010","ordinal":134459,"en":"Unable to bear their tribute,"},{"id":"semetey-1-2013:p0751:b004:l011","ordinal":134460,"en":"All the numerous people"},{"id":"semetey-1-2013:p0751:b004:l012","ordinal":134461,"en":"Fled in every direction."},{"id":"semetey-1-2013:p0751:b004:l013","ordinal":134462,"en":"Unable to find their bearings,"},{"id":"semetey-1-2013:p0751:b004:l014","ordinal":134463,"en":"The Argyn people moved away to one place."},{"id":"semetey-1-2013:p0751:b004:l015","ordinal":134464,"en":"Hard-pressed and greatly humiliated,"},{"id":"semetey-1-2013:p0751:b004:l016","ordinal":134465,"en":"The Kyrgyz went away to another place."},{"id":"semetey-1-2013:p0751:b004:l017","ordinal":134466,"en":"After the lord passed away,"},{"id":"semetey-1-2013:p0751:b004:l018","ordinal":134467,"en":"The Kyrgyz people were left behind."},{"id":"semetey-1-2013:p0751:b004:l019","ordinal":134468,"en":"The scoundrels Abyke and Kobosh—"},{"id":"semetey-1-2013:p0751:b004:l020","ordinal":134469,"en":"God had struck them thus."},{"id":"semetey-1-2013:p0751:b004:l021","ordinal":134470,"en":"They plundered the people's goods"},{"id":"semetey-1-2013:p0751:b004:l022","ordinal":134471,"en":"And stirred up great strife."},{"id":"semetey-1-2013:p0751:b004:l023","ordinal":134472,"en":"Unable to find a way out,"},{"id":"semetey-1-2013:p0751:b004:l024","ordinal":134473,"en":"The Argyn people went away."},{"id":"semetey-1-2013:p0751:b004:l025","ordinal":134474,"en":"And so this dear land"},{"id":"semetey-1-2013:p0751:b004:l026","ordinal":134475,"en":"Lay gaping and empty."},{"id":"semetey-1-2013:p0751:b004:l027","ordinal":134476,"en":"When Manas lived,"},{"id":"semetey-1-2013:p0751:b004:l028","ordinal":134477,"en":"Here, among these dear people,"},{"id":"semetey-1-2013:p0751:b004:l029","ordinal":134478,"en":"The young wives drove lambs,"},{"id":"semetey-1-2013:p0751:b004:l030","ordinal":134479,"en":"The old women chewed fat tails."},{"id":"semetey-1-2013:p0751:b004:l031","ordinal":134480,"en":"After the lord passed away,"},{"id":"semetey-1-2013:p0751:b004:l032","ordinal":134481,"en":"Here, among these dear people,"},{"id":"semetey-1-2013:p0751:b004:l033","ordinal":134482,"en":"Not a tiny soul remained."},{"id":"semetey-1-2013:p0751:b004:l034","ordinal":134483,"en":"They plundered the people's goods"},{"id":"semetey-1-2013:p0751:b004:l035","ordinal":134484,"en":"And stirred up great strife."},{"id":"semetey-1-2013:p0751:b004:l036","ordinal":134485,"en":"This great court of Manas—"},{"id":"semetey-1-2013:p0751:b004:l037","ordinal":134486,"en":"All those foolish dogs"},{"id":"semetey-1-2013:p0751:b004:l038","ordinal":134487,"en":"Had taken possession of it."},{"id":"semetey-1-2013:p0751:b004:l039","ordinal":134488,"en":"Dog Kobosh mounted the throne,"},{"id":"semetey-1-2013:p0752:b003:l001","ordinal":134489,"en":"And became a sultan."},{"id":"semetey-1-2013:p0752:b003:l002","ordinal":134490,"en":"He plunged into pleasure."},{"id":"semetey-1-2013:p0752:b003:l003","ordinal":134491,"en":"When lord Manas lived,"},{"id":"semetey-1-2013:p0752:b003:l004","ordinal":134492,"en":"The throne he occupied, as big as a camel—"},{"id":"semetey-1-2013:p0752:b003:l005","ordinal":134493,"en":"Kobosh took Akylai,"},{"id":"semetey-1-2013:p0752:b003:l006","ordinal":134494,"en":"And lay there without rising."},{"id":"semetey-1-2013:p0752:b003:l007","ordinal":134495,"en":"Ill-intentioned Khan Kobosh"},{"id":"semetey-1-2013:p0752:b003:l008","ordinal":134496,"en":"Brought sorrow in this way."},{"id":"semetey-1-2013:p0752:b003:l009","ordinal":134497,"en":"What can be seen on this side—"},{"id":"semetey-1-2013:p0752:b003:l010","ordinal":134498,"en":"When he saw that sight,"},{"id":"semetey-1-2013:p0752:b003:l011","ordinal":134499,"en":"Your gray-maned elder Bakai's"},{"id":"semetey-1-2013:p0752:b003:l012","ordinal":134500,"en":"Heart was deeply troubled;"},{"id":"semetey-1-2013:p0752:b003:l013","ordinal":134501,"en":"Tears streamed from his eyes."},{"id":"semetey-1-2013:p0752:b003:l014","ordinal":134502,"en":"What is seen today is gone tomorrow."},{"id":"semetey-1-2013:p0752:b003:l015","ordinal":134503,"en":"Such is this shitty world."},{"id":"semetey-1-2013:p0752:b003:l016","ordinal":134504,"en":"What can be seen nearer than that"},{"id":"semetey-1-2013:p0752:b003:l017","ordinal":134505,"en":"Is Kanykei's white palace,"},{"id":"semetey-1-2013:p0752:b003:l018","ordinal":134506,"en":"Its gate of iron and solid tin."},{"id":"semetey-1-2013:p0752:b003:l019","ordinal":134507,"en":"Though a woman, Kanykei"},{"id":"semetey-1-2013:p0752:b003:l020","ordinal":134508,"en":"Surpassed many in majesty."},{"id":"semetey-1-2013:p0752:b003:l021","ordinal":134509,"en":"No one dared approach."},{"id":"semetey-1-2013:p0752:b003:l022","ordinal":134510,"en":"The white palace's doorway"},{"id":"semetey-1-2013:p0752:b003:l023","ordinal":134511,"en":"No man without courage had seen;"},{"id":"semetey-1-2013:p0752:b003:l024","ordinal":134512,"en":"No mortal could bear to come."},{"id":"semetey-1-2013:p0752:b003:l025","ordinal":134513,"en":"Kanykei's gleaming white palace—"},{"id":"semetey-1-2013:p0752:b003:l026","ordinal":134514,"en":"Its threshold is yellow gold,"},{"id":"semetey-1-2013:p0752:b003:l027","ordinal":134515,"en":"Its crown is gold, its roof poles copper."},{"id":"semetey-1-2013:p0752:b003:l028","ordinal":134516,"en":"When Manas was struck down and gone,"},{"id":"semetey-1-2013:p0752:b003:l029","ordinal":134517,"en":"It became booty at that very time."},{"id":"semetey-1-2013:p0752:b003:l030","ordinal":134518,"en":"Thinking much of the old days,"},{"id":"semetey-1-2013:p0752:b003:l031","ordinal":134519,"en":"Son, our minds are thrown into turmoil."},{"id":"semetey-1-2013:p0752:b003:l032","ordinal":134520,"en":"When falcon Manas lived,"},{"id":"semetey-1-2013:p0752:b003:l033","ordinal":134521,"en":"Our livestock filled the whole expanse."},{"id":"semetey-1-2013:p0752:b003:l034","ordinal":134522,"en":"When I think of today,"},{"id":"semetey-1-2013:p0752:b003:l035","ordinal":134523,"en":"Our life does not amount to a handful."},{"id":"semetey-1-2013:p0752:b003:l036","ordinal":134524,"en":"Valley upon valley, little valley,"},{"id":"semetey-1-2013:p0752:b003:l037","ordinal":134525,"en":"Thinking over it deeply,"},{"id":"semetey-1-2013:p0752:b003:l038","ordinal":134526,"en":"Tears stream from my eyes."},{"id":"semetey-1-2013:p0752:b003:l039","ordinal":134527,"en":"Khan Manas's treasury"},{"id":"semetey-1-2013:p0752:b004:l001","ordinal":134528,"en":"Seems to belong to Kobosh today.\""},{"id":"semetey-1-2013:p0752:b004:l002","ordinal":134529,"en":"So spoke great Bakai,"},{"id":"semetey-1-2013:p0752:b004:l003","ordinal":134530,"en":"Heading toward the court,"},{"id":"semetey-1-2013:p0752:b004:l004","ordinal":134531,"en":"Devastating Bakai shook with sobs."},{"id":"semetey-1-2013:p0752:b004:l005","ordinal":134532,"en":"This treasury standing here—"},{"id":"semetey-1-2013:p0752:b004:l006","ordinal":134533,"en":"If you ask what it was before,"},{"id":"semetey-1-2013:p0752:b004:l007","ordinal":134534,"en":"It was Khan Manas's white court."},{"id":"semetey-1-2013:p0752:b004:l008","ordinal":134535,"en":"If you ask what it is now,"},{"id":"semetey-1-2013:p0752:b004:l009","ordinal":134536,"en":"Your father's grave, this world!"},{"id":"semetey-1-2013:p0752:b004:l010","ordinal":134537,"en":"It is Abyke's white court."},{"id":"semetey-1-2013:p0752:b004:l011","ordinal":134538,"en":"Looming darkly there,"},{"id":"semetey-1-2013:p0752:b004:l012","ordinal":134539,"en":"Where he used to go for recreation,"},{"id":"semetey-1-2013:p0752:b004:l013","ordinal":134540,"en":"Was Khan Manas's garden."},{"id":"semetey-1-2013:p0752:b004:l014","ordinal":134541,"en":"What can be seen nearer than that"},{"id":"semetey-1-2013:p0752:b004:l015","ordinal":134542,"en":"Was my gray-maned one's throne."},{"id":"semetey-1-2013:p0752:b004:l016","ordinal":134543,"en":"If you ask about it now,"},{"id":"semetey-1-2013:p0752:b004:l017","ordinal":134544,"en":"That is Abyke's garden."},{"id":"semetey-1-2013:p0752:b004:l018","ordinal":134545,"en":"What appears in the gray haze"},{"id":"semetey-1-2013:p0752:b004:l019","ordinal":134546,"en":"Is Khan Kobosh's throne."},{"id":"semetey-1-2013:p0752:b004:l020","ordinal":134547,"en":"\"My darling orphan,"},{"id":"semetey-1-2013:p0752:b004:l021","ordinal":134548,"en":"My flowing river, my spring,"},{"id":"semetey-1-2013:p0752:b004:l022","ordinal":134549,"en":"My lamp found when I was dying,"},{"id":"semetey-1-2013:p0752:b004:l023","ordinal":134550,"en":"Remember these words of mine."},{"id":"semetey-1-2013:p0752:b004:l024","ordinal":134551,"en":"Do not act imperiously; heed me."},{"id":"semetey-1-2013:p0752:b004:l025","ordinal":134552,"en":"At your six uncles' homes"},{"id":"semetey-1-2013:p0752:b004:l026","ordinal":134553,"en":"There are pits they have dug,"},{"id":"semetey-1-2013:p0752:b004:l027","ordinal":134554,"en":"There is brine they have boiled,"},{"id":"semetey-1-2013:p0752:b004:l028","ordinal":134555,"en":"They have girded their loins,"},{"id":"semetey-1-2013:p0752:b004:l029","ordinal":134556,"en":"They have fortified their positions."},{"id":"semetey-1-2013:p0752:b004:l030","ordinal":134557,"en":"Enemies since your valiant father's time,"},{"id":"semetey-1-2013:p0752:b004:l031","ordinal":134558,"en":"The six scoundrels bear a grudge."},{"id":"semetey-1-2013:p0752:b004:l032","ordinal":134559,"en":"Your aged elder Bakai"},{"id":"semetey-1-2013:p0752:b004:l033","ordinal":134560,"en":"Will show you your six uncles today.\""},{"id":"semetey-1-2013:p0752:b004:l035","ordinal":134561,"en":"So spoke gray-maned Bakai,"},{"id":"semetey-1-2013:p0752:b004:l036","ordinal":134562,"en":"Heading toward Abyke,"},{"id":"semetey-1-2013:p0752:b004:l037","ordinal":134563,"en":"Taking a short path inward,"},{"id":"semetey-1-2013:p0752:b004:l038","ordinal":134564,"en":"Manas's only son"},{"id":"semetey-1-2013:p0752:b004:l039","ordinal":134565,"en":"He led along as his support."},{"id":"semetey-1-2013:p0753:b003:l001","ordinal":134566,"en":"\"My flowing river, my spring,"},{"id":"semetey-1-2013:p0753:b003:l002","ordinal":134567,"en":"The rascal left by Manas,"},{"id":"semetey-1-2013:p0753:b003:l003","ordinal":134568,"en":"My lamp that gives me shelter.\""},{"id":"semetey-1-2013:p0753:b003:l004","ordinal":134569,"en":"When Manas's son arrived,"},{"id":"semetey-1-2013:p0753:b003:l005","ordinal":134570,"en":"The scoundrels Abyke and Kobosh,"},{"id":"semetey-1-2013:p0753:b003:l006","ordinal":134571,"en":"Those wretches born rotten of their father,"},{"id":"semetey-1-2013:p0753:b003:l007","ordinal":134572,"en":"Had no one keeping watch."},{"id":"semetey-1-2013:p0753:b003:l008","ordinal":134573,"en":"Of the countless Chinese and Manchu,"},{"id":"semetey-1-2013:p0753:b003:l009","ordinal":134574,"en":"Being there in their midst,"},{"id":"semetey-1-2013:p0753:b003:l010","ordinal":134575,"en":"They gave no thought that they might die."},{"id":"semetey-1-2013:p0753:b003:l011","ordinal":134576,"en":"There were no greater fools than they."},{"id":"semetey-1-2013:p0753:b003:l012","ordinal":134577,"en":"Abyke and Kobosh's"},{"id":"semetey-1-2013:p0753:b003:l013","ordinal":134578,"en":"Court, where they made their dwelling—"},{"id":"semetey-1-2013:p0753:b003:l014","ordinal":134579,"en":"Bakai and Semetey"},{"id":"semetey-1-2013:p0753:b003:l015","ordinal":134580,"en":"Now dismounted there."},{"id":"semetey-1-2013:p0753:b003:l016","ordinal":134581,"en":"Bronze at the base, copper at the tip,"},{"id":"semetey-1-2013:p0753:b003:l017","ordinal":134582,"en":"Some four cubits high,"},{"id":"semetey-1-2013:p0753:b003:l018","ordinal":134583,"en":"To the ornate bronze tethering post"},{"id":"semetey-1-2013:p0753:b003:l019","ordinal":134584,"en":"They walked with heavy steps."},{"id":"semetey-1-2013:p0753:b003:l020","ordinal":134585,"en":"With white lead ropes plaited in knots,"},{"id":"semetey-1-2013:p0753:b003:l021","ordinal":134586,"en":"Kokcholok and Aktulpar"},{"id":"semetey-1-2013:p0753:b003:l022","ordinal":134587,"en":"They tied to the post with slipknots,"},{"id":"semetey-1-2013:p0753:b003:l023","ordinal":134588,"en":"Fastening them securely."},{"id":"semetey-1-2013:p0753:b003:l024","ordinal":134589,"en":"Into Abyke and Kobosh's court,"},{"id":"semetey-1-2013:p0753:b003:l025","ordinal":134590,"en":"Semetey and Khan Bakai"},{"id":"semetey-1-2013:p0753:b003:l026","ordinal":134591,"en":"Then entered."},{"id":"semetey-1-2013:p0753:b003:l027","ordinal":134592,"en":"Standing and pleading with them both,"},{"id":"semetey-1-2013:p0753:b003:l028","ordinal":134593,"en":"Abyke spoke these words:"},{"id":"semetey-1-2013:p0753:b003:l029","ordinal":134594,"en":"\"Peace, peace be upon you!"},{"id":"semetey-1-2013:p0753:b003:l030","ordinal":134595,"en":"My lion Bakai, are you well?"},{"id":"semetey-1-2013:p0753:b003:l031","ordinal":134596,"en":"We made a little trouble among kin—"},{"id":"semetey-1-2013:p0753:b003:l032","ordinal":134597,"en":"My Bakai who conquered it, are you well?"},{"id":"semetey-1-2013:p0753:b003:l033","ordinal":134598,"en":"The firmly blocked road—"},{"id":"semetey-1-2013:p0753:b003:l034","ordinal":134599,"en":"My Bakai who opened it, are you well?"},{"id":"semetey-1-2013:p0753:b003:l035","ordinal":134600,"en":"The great treasury, when you turned toward it—"},{"id":"semetey-1-2013:p0753:b003:l036","ordinal":134601,"en":"My Bakai who opened it, are you well?"},{"id":"semetey-1-2013:p0753:b003:l037","ordinal":134602,"en":"Bringing torment upon Beijing,"},{"id":"semetey-1-2013:p0753:b003:l038","ordinal":134603,"en":"My Bakai who conquered it, are you well?"},{"id":"semetey-1-2013:p0753:b003:l039","ordinal":134604,"en":"You who destroyed the enemy that faced you,"},{"id":"semetey-1-2013:p0753:b005:l001","ordinal":134605,"en":"My lion Bakai, are you well?"},{"id":"semetey-1-2013:p0753:b005:l002","ordinal":134606,"en":"The feeble soul leaning for support—"},{"id":"semetey-1-2013:p0753:b005:l003","ordinal":134607,"en":"Its support, Bakai, are you well?"},{"id":"semetey-1-2013:p0753:b005:l004","ordinal":134608,"en":"The wretched soul about to die—"},{"id":"semetey-1-2013:p0753:b005:l005","ordinal":134609,"en":"Its means of survival, Bakai, are you well?"},{"id":"semetey-1-2013:p0753:b005:l006","ordinal":134610,"en":"When angered, his enemy"},{"id":"semetey-1-2013:p0753:b005:l007","ordinal":134611,"en":"He erased from this world."},{"id":"semetey-1-2013:p0753:b005:l008","ordinal":134612,"en":"Bakai who drove them out, are you well?"},{"id":"semetey-1-2013:p0753:b005:l009","ordinal":134613,"en":"You who rekindled extinguished fires,"},{"id":"semetey-1-2013:p0753:b005:l010","ordinal":134614,"en":"Who brought dead souls back to life,"},{"id":"semetey-1-2013:p0753:b005:l011","ordinal":134615,"en":"Commanding Bakai, are you well?"},{"id":"semetey-1-2013:p0753:b005:l012","ordinal":134616,"en":"When hands are spread, saying Amen,"},{"id":"semetey-1-2013:p0753:b005:l013","ordinal":134617,"en":"My blessing, Bakai, are you well?"},{"id":"semetey-1-2013:p0753:b005:l014","ordinal":134618,"en":"My support left by Manas,"},{"id":"semetey-1-2013:p0753:b005:l015","ordinal":134619,"en":"My father Bakai, are you well?"},{"id":"semetey-1-2013:p0753:b005:l016","ordinal":134620,"en":"These descendants of Zhakyp,"},{"id":"semetey-1-2013:p0753:b005:l017","ordinal":134621,"en":"Mighty Manas, the falcon—"},{"id":"semetey-1-2013:p0753:b005:l018","ordinal":134622,"en":"You planted them into a garden,"},{"id":"semetey-1-2013:p0753:b005:l019","ordinal":134623,"en":"Kneaded them into a house,"},{"id":"semetey-1-2013:p0753:b005:l020","ordinal":134624,"en":"Joined what had broken,"},{"id":"semetey-1-2013:p0753:b005:l021","ordinal":134625,"en":"Gathered what had scattered,"},{"id":"semetey-1-2013:p0753:b005:l022","ordinal":134626,"en":"Rekindled extinguished fires,"},{"id":"semetey-1-2013:p0753:b005:l023","ordinal":134627,"en":"Brought dead souls back to life."},{"id":"semetey-1-2013:p0753:b005:l024","ordinal":134628,"en":"Set in front, you bring good fortune;"},{"id":"semetey-1-2013:p0753:b005:l025","ordinal":134629,"en":"Driven forward, you are like a mighty army."},{"id":"semetey-1-2013:p0753:b005:l026","ordinal":134630,"en":"A saint favored by the unseen protector,"},{"id":"semetey-1-2013:p0753:b005:l027","ordinal":134631,"en":"My elder Bakai, old man,"},{"id":"semetey-1-2013:p0753:b005:l028","ordinal":134632,"en":"You who wore a blue-gray lynx-fur cap,"},{"id":"semetey-1-2013:p0753:b005:l029","ordinal":134633,"en":"Who wielded a mottled blue shield,"},{"id":"semetey-1-2013:p0753:b005:l030","ordinal":134634,"en":"A truly saintly elder,"},{"id":"semetey-1-2013:p0753:b005:l031","ordinal":134635,"en":"My steadfast old Bakai."},{"id":"semetey-1-2013:p0753:b005:l032","ordinal":134636,"en":"While you watch over me, my belly is full;"},{"id":"semetey-1-2013:p0753:b005:l033","ordinal":134637,"en":"While I see you, my heart is content."},{"id":"semetey-1-2013:p0753:b005:l034","ordinal":134638,"en":"Elder, there is no greater legacy than you."},{"id":"semetey-1-2013:p0753:b005:l035","ordinal":134639,"en":"For twelve years,"},{"id":"semetey-1-2013:p0753:b005:l036","ordinal":134640,"en":"We have not seen one another."},{"id":"semetey-1-2013:p0753:b005:l037","ordinal":134641,"en":"Was this shitty world like this?"},{"id":"semetey-1-2013:p0753:b005:l038","ordinal":134642,"en":"Khan Bakai, elder, hear my words!"},{"id":"semetey-1-2013:p0753:b005:l039","ordinal":134643,"en":"When leopard Manas died,"},{"id":"semetey-1-2013:p0754:b003:l001","ordinal":134644,"en":"When the people suffered hardship,"},{"id":"semetey-1-2013:p0754:b003:l002","ordinal":134645,"en":"When good Khan Manas died,"},{"id":"semetey-1-2013:p0754:b003:l003","ordinal":134646,"en":"And all the people died with him,"},{"id":"semetey-1-2013:p0754:b003:l004","ordinal":134647,"en":"When we settled along the river,"},{"id":"semetey-1-2013:p0754:b003:l005","ordinal":134648,"en":"Bereft of the leopard,"},{"id":"semetey-1-2013:p0754:b003:l006","ordinal":134649,"en":"We wretches left behind"},{"id":"semetey-1-2013:p0754:b003:l007","ordinal":134650,"en":"Were like an extinguished fire."},{"id":"semetey-1-2013:p0754:b003:l008","ordinal":134651,"en":"Kanykei went away in mourning;"},{"id":"semetey-1-2013:p0754:b003:l009","ordinal":134652,"en":"Semetey fled away."},{"id":"semetey-1-2013:p0754:b003:l010","ordinal":134653,"en":"Kanykei went away a widow;"},{"id":"semetey-1-2013:p0754:b003:l011","ordinal":134654,"en":"Semetey went wandering."},{"id":"semetey-1-2013:p0754:b003:l012","ordinal":134655,"en":"Elder Bakai, whenever I think of it, I burn."},{"id":"semetey-1-2013:p0754:b003:l014","ordinal":134656,"en":"Manas's only son"}]
