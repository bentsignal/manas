[{"id":"semetey-1-2013:p1068:b004:l021","ordinal":157697,"en":"He brought turmoil upon us"},{"id":"semetey-1-2013:p1068:b004:l022","ordinal":157698,"en":"And came contending for Chürök."},{"id":"semetey-1-2013:p1068:b004:l023","ordinal":157699,"en":"When they laid a foul siege,"},{"id":"semetey-1-2013:p1068:b004:l024","ordinal":157700,"en":"And Toltoy of the Zhediger"},{"id":"semetey-1-2013:p1068:b004:l025","ordinal":157701,"en":"Slaughtered every person"},{"id":"semetey-1-2013:p1068:b004:l026","ordinal":157702,"en":"Who ventured outside,"},{"id":"semetey-1-2013:p1068:b004:l027","ordinal":157703,"en":"We stood and raced our horses;"},{"id":"semetey-1-2013:p1068:b004:l028","ordinal":157704,"en":"Because of you, Aychürök,"},{"id":"semetey-1-2013:p1068:b004:l029","ordinal":157705,"en":"We fired guns and drew bows,"},{"id":"semetey-1-2013:p1068:b004:l030","ordinal":157706,"en":"And stood fighting without fleeing!"},{"id":"semetey-1-2013:p1068:b004:l031","ordinal":157707,"en":"We held our ground for nine months;"},{"id":"semetey-1-2013:p1068:b004:l032","ordinal":157708,"en":"For nine days we fought without rest."},{"id":"semetey-1-2013:p1068:b004:l033","ordinal":157709,"en":"With teeth jutting out,"},{"id":"semetey-1-2013:p1068:b004:l034","ordinal":157710,"en":"Horse corpses became a mountain;"},{"id":"semetey-1-2013:p1068:b004:l035","ordinal":157711,"en":"With mustaches drooping,"},{"id":"semetey-1-2013:p1068:b004:l036","ordinal":157712,"en":"Men's corpses became bundled heaps."},{"id":"semetey-1-2013:p1068:b004:l037","ordinal":157713,"en":"Many formidable beks died;"},{"id":"semetey-1-2013:p1068:b004:l038","ordinal":157714,"en":"Many innocent people died."},{"id":"semetey-1-2013:p1068:b004:l039","ordinal":157715,"en":"Demanding, 'Give us Aychürök,'"}]
