[{"id":"semetey-1-2013:p1046:b003:l013","ordinal":156929,"en":"\"Wretched-day prince, you have consumed me!\""},{"id":"semetey-1-2013:p1046:b003:l014","ordinal":156930,"en":"When Chürök bucked without ceasing,"},{"id":"semetey-1-2013:p1046:b003:l015","ordinal":156931,"en":"She broke both lattice ties"},{"id":"semetey-1-2013:p1046:b003:l016","ordinal":156932,"en":"Together with their fastenings;"},{"id":"semetey-1-2013:p1046:b003:l017","ordinal":156933,"en":"When your prince thrust without stopping,"},{"id":"semetey-1-2013:p1046:b003:l018","ordinal":156934,"en":"He tore both seals of her maidenhood."},{"id":"semetey-1-2013:p1046:b003:l019","ordinal":156935,"en":"The luckless woman with her companion"},{"id":"semetey-1-2013:p1046:b003:l020","ordinal":156936,"en":"Satisfied the conqueror's desire."},{"id":"semetey-1-2013:p1046:b003:l021","ordinal":156937,"en":"Your ill-fated princely leopard"},{"id":"semetey-1-2013:p1046:b003:l022","ordinal":156938,"en":"Left your dear sister-in-law Chürök"},{"id":"semetey-1-2013:p1046:b003:l023","ordinal":156939,"en":"In a grievous state;"},{"id":"semetey-1-2013:p1046:b003:l024","ordinal":156940,"en":"Without letting Chürök stir,"},{"id":"semetey-1-2013:p1046:b003:l025","ordinal":156941,"en":"He lay upon her and pressed hard."},{"id":"semetey-1-2013:p1046:b003:l026","ordinal":156942,"en":"The leopard grew fierce"},{"id":"semetey-1-2013:p1046:b003:l027","ordinal":156943,"en":"And sank down like an old male camel;"},{"id":"semetey-1-2013:p1046:b003:l028","ordinal":156944,"en":"Without letting Chürök move,"},{"id":"semetey-1-2013:p1046:b003:l029","ordinal":156945,"en":"He spilled his yellow fluid into her."},{"id":"semetey-1-2013:p1046:b003:l030","ordinal":156946,"en":"Holding her firmly and making her struggle,"},{"id":"semetey-1-2013:p1046:b003:l031","ordinal":156947,"en":"He ravaged her private place."},{"id":"semetey-1-2013:p1046:b003:l032","ordinal":156948,"en":"When the sultan had finished his act,"},{"id":"semetey-1-2013:p1046:b003:l033","ordinal":156949,"en":"Aychürök stood and said this:"},{"id":"semetey-1-2013:p1046:b003:l034","ordinal":156950,"en":"\"These are the words I plead to say:"},{"id":"semetey-1-2013:p1046:b003:l035","ordinal":156951,"en":"Draw back again, my prince;"},{"id":"semetey-1-2013:p1046:b003:l036","ordinal":156952,"en":"My eyes are coming out,\" she said."},{"id":"semetey-1-2013:p1046:b003:l037","ordinal":156953,"en":"Your prince made his stallion rear,"},{"id":"semetey-1-2013:p1046:b003:l038","ordinal":156954,"en":"And drew out its tackle;"},{"id":"semetey-1-2013:p1046:b003:l039","ordinal":156955,"en":"For as long as meat takes to cook,"},{"id":"semetey-1-2013:p1046:b004:l001","ordinal":156956,"en":"Your Chürök lay unconscious."},{"id":"semetey-1-2013:p1046:b004:l002","ordinal":156957,"en":"Her strength vanished entirely;"},{"id":"semetey-1-2013:p1046:b004:l003","ordinal":156958,"en":"She nearly died, then recovered,"},{"id":"semetey-1-2013:p1046:b004:l004","ordinal":156959,"en":"And gathered her senses."},{"id":"semetey-1-2013:p1046:b004:l005","ordinal":156960,"en":"The quilt and white sheet"},{"id":"semetey-1-2013:p1046:b004:l006","ordinal":156961,"en":"Were covered in dark blood."},{"id":"semetey-1-2013:p1046:b004:l007","ordinal":156962,"en":"Concealing that blood had flowed,"},{"id":"semetey-1-2013:p1046:b004:l008","ordinal":156963,"en":"What could dear Chürök do?"},{"id":"semetey-1-2013:p1046:b004:l009","ordinal":156964,"en":"She gathered and swept it all away."},{"id":"semetey-1-2013:p1046:b004:l010","ordinal":156965,"en":"Your hero's twelve-handspan"},{"id":"semetey-1-2013:p1046:b004:l011","ordinal":156966,"en":"Great equipment—"},{"id":"semetey-1-2013:p1046:b004:l012","ordinal":156967,"en":"With a white kerchief of pure silk,"},{"id":"semetey-1-2013:p1046:b004:l013","ordinal":156968,"en":"She grasped it by hand and wiped it:"},{"id":"semetey-1-2013:p1046:b004:l014","ordinal":156969,"en":"\"Alas, prince, what shall I do?"},{"id":"semetey-1-2013:p1046:b004:l015","ordinal":156970,"en":"All my strength is gone;"},{"id":"semetey-1-2013:p1046:b004:l016","ordinal":156971,"en":"Hero, your instrument"},{"id":"semetey-1-2013:p1046:b004:l017","ordinal":156972,"en":"Reached every bone in my body,"},{"id":"semetey-1-2013:p1046:b004:l018","ordinal":156973,"en":"And passed beyond my navel,\" she said."},{"id":"semetey-1-2013:p1046:b004:l019","ordinal":156974,"en":"Unable to catch her breath, trembling,"},{"id":"semetey-1-2013:p1046:b004:l020","ordinal":156975,"en":"Chürök sobbed and wept."},{"id":"semetey-1-2013:p1046:b004:l021","ordinal":156976,"en":"The steed of Khan Bakay,"},{"id":"semetey-1-2013:p1046:b004:l022","ordinal":156977,"en":"Who began all that exists,"},{"id":"semetey-1-2013:p1046:b004:l023","ordinal":156978,"en":"The falcon of your hero,"},{"id":"semetey-1-2013:p1046:b004:l024","ordinal":156979,"en":"Who began the calamity."},{"id":"semetey-1-2013:p1046:b004:l025","ordinal":156980,"en":"Your dear sister-in-law Chürök,"},{"id":"semetey-1-2013:p1046:b004:l026","ordinal":156981,"en":"In the morning, before the prince,"},{"id":"semetey-1-2013:p1046:b004:l027","ordinal":156982,"en":"Opened the door and tottered;"},{"id":"semetey-1-2013:p1046:b004:l028","ordinal":156983,"en":"The poor woman's senses gone,"},{"id":"semetey-1-2013:p1046:b004:l029","ordinal":156984,"en":"She straddled like a louse-ridden horse."},{"id":"semetey-1-2013:p1046:b004:l030","ordinal":156985,"en":"In the morning, before the prince,"},{"id":"semetey-1-2013:p1046:b004:l031","ordinal":156986,"en":"She now hurried about serving him."},{"id":"semetey-1-2013:p1046:b004:l032","ordinal":156987,"en":"She had endured the affliction,"},{"id":"semetey-1-2013:p1046:b004:l033","ordinal":156988,"en":"Your poor, luckless sister-in-law,"},{"id":"semetey-1-2013:p1046:b004:l034","ordinal":156989,"en":"Blood streaming down her calves."},{"id":"semetey-1-2013:p1046:b004:l035","ordinal":156990,"en":"Within the fortress of the white palace,"},{"id":"semetey-1-2013:p1046:b004:l036","ordinal":156991,"en":"When two days had passed,"},{"id":"semetey-1-2013:p1046:b004:l037","ordinal":156992,"en":"Again your sister-in-law contrived"},{"id":"semetey-1-2013:p1046:b004:l038","ordinal":156993,"en":"To accommodate Semetey."},{"id":"semetey-1-2013:p1046:b004:l039","ordinal":156994,"en":"When one handspan had entered,"},{"id":"semetey-1-2013:p1047:b003:l001","ordinal":156995,"en":"Your sister-in-law lost awareness;"},{"id":"semetey-1-2013:p1047:b003:l002","ordinal":156996,"en":"When four handspans had entered,"},{"id":"semetey-1-2013:p1047:b003:l003","ordinal":156997,"en":"She groaned like a camel calf."},{"id":"semetey-1-2013:p1047:b003:l004","ordinal":156998,"en":"When six handspans had entered,"},{"id":"semetey-1-2013:p1047:b003:l005","ordinal":156999,"en":"She cried, \"Oh, my great-hearted one!\""},{"id":"semetey-1-2013:p1047:b003:l006","ordinal":157000,"en":"When nine handspans had entered,"},{"id":"semetey-1-2013:p1047:b003:l007","ordinal":157001,"en":"Like one suffering labor pains,"},{"id":"semetey-1-2013:p1047:b003:l008","ordinal":157002,"en":"She bleated like a goat and kid."},{"id":"semetey-1-2013:p1047:b003:l009","ordinal":157003,"en":"When ten handspans had entered,"},{"id":"semetey-1-2013:p1047:b003:l010","ordinal":157004,"en":"Moaning overtook her and she collapsed."},{"id":"semetey-1-2013:p1047:b003:l011","ordinal":157005,"en":"When twelve handspans had entered,"},{"id":"semetey-1-2013:p1047:b003:l012","ordinal":157006,"en":"\"My destroyer, you have consumed me!\" she cried,"},{"id":"semetey-1-2013:p1047:b003:l013","ordinal":157007,"en":"And stretched out like a hair rope."},{"id":"semetey-1-2013:p1047:b003:l014","ordinal":157008,"en":"Your hero's great instrument—"},{"id":"semetey-1-2013:p1047:b003:l015","ordinal":157009,"en":"She lay whimpering as he used it,"},{"id":"semetey-1-2013:p1047:b003:l016","ordinal":157010,"en":"Extending it into her precious place,"},{"id":"semetey-1-2013:p1047:b003:l017","ordinal":157011,"en":"And stilling the precious woman's soul."},{"id":"semetey-1-2013:p1047:b004:l001","ordinal":157012,"en":"Such were Aychürök's words,"},{"id":"semetey-1-2013:p1047:b004:l002","ordinal":157013,"en":"After burning for so many years;"},{"id":"semetey-1-2013:p1047:b004:l003","ordinal":157014,"en":"That was where the princely leopard Semetey"},{"id":"semetey-1-2013:p1047:b004:l004","ordinal":157015,"en":"Found contentment in his heart."},{"id":"semetey-1-2013:p1047:b004:l005","ordinal":157016,"en":"Within the white palace,"},{"id":"semetey-1-2013:p1047:b004:l006","ordinal":157017,"en":"When bored, they played ordo;"},{"id":"semetey-1-2013:p1047:b004:l007","ordinal":157018,"en":"They drank kumis and enjoyed maidens,"},{"id":"semetey-1-2013:p1047:b004:l008","ordinal":157019,"en":"And when not bored, lay together."},{"id":"semetey-1-2013:p1047:b004:l009","ordinal":157020,"en":"In pleasures of countless kinds,"},{"id":"semetey-1-2013:p1047:b004:l010","ordinal":157021,"en":"The gray wolves immersed themselves like this."},{"id":"semetey-1-2013:p1047:b004:l011","ordinal":157022,"en":"Morning and evening, twice a day,"},{"id":"semetey-1-2013:p1047:b004:l012","ordinal":157023,"en":"They remained without boredom in the palace."},{"id":"semetey-1-2013:p1047:b004:l013","ordinal":157024,"en":"Semetey's guests,"},{"id":"semetey-1-2013:p1047:b004:l014","ordinal":157025,"en":"Tümönbay, son of Tülkü,"},{"id":"semetey-1-2013:p1047:b004:l015","ordinal":157026,"en":"And Azhybay, son of Azhy—"},{"id":"semetey-1-2013:p1047:b004:l016","ordinal":157027,"en":"Now let me tell"},{"id":"semetey-1-2013:p1047:b004:l017","ordinal":157028,"en":"The tale of these two."},{"id":"semetey-1-2013:p1047:b006:l001","ordinal":157029,"en":"Of surpassing good will and noble thought,"},{"id":"semetey-1-2013:p1047:b006:l002","ordinal":157030,"en":"These were sons of brothers,"},{"id":"semetey-1-2013:p1047:b006:l003","ordinal":157031,"en":"And the finest men to come from Afghanistan."},{"id":"semetey-1-2013:p1047:b006:l004","ordinal":157032,"en":"Azhybay, son of Azhy,"},{"id":"semetey-1-2013:p1047:b006:l005","ordinal":157033,"en":"Sharpened his black tongue,"},{"id":"semetey-1-2013:p1047:b006:l006","ordinal":157034,"en":"And sang out before the khan."},{"id":"semetey-1-2013:p1047:b006:l007","ordinal":157035,"en":"Broad-jawed and flat-tongued,"},{"id":"semetey-1-2013:p1047:b006:l008","ordinal":157036,"en":"He was a formidable eloquent servant;"},{"id":"semetey-1-2013:p1047:b006:l009","ordinal":157037,"en":"When he accomplished a task without force,"},{"id":"semetey-1-2013:p1047:b006:l010","ordinal":157038,"en":"Among all people upon the earth"},{"id":"semetey-1-2013:p1047:b006:l011","ordinal":157039,"en":"He was a son beyond price."},{"id":"semetey-1-2013:p1047:b006:l012","ordinal":157040,"en":"Both eloquent and keen in argument,"},{"id":"semetey-1-2013:p1047:b006:l013","ordinal":157041,"en":"He was one to rely on for stratagems."},{"id":"semetey-1-2013:p1047:b006:l014","ordinal":157042,"en":"Tümönbay, son of Tülkü,"},{"id":"semetey-1-2013:p1047:b006:l015","ordinal":157043,"en":"Proud-hearted and stern-tempered,"},{"id":"semetey-1-2013:p1047:b006:l016","ordinal":157044,"en":"Was a thundering hero;"},{"id":"semetey-1-2013:p1047:b006:l017","ordinal":157045,"en":"His speech was venomous."},{"id":"semetey-1-2013:p1047:b007:l001","ordinal":157046,"en":"Toward a man who displeased him,"},{"id":"semetey-1-2013:p1047:b007:l002","ordinal":157047,"en":"He bore an anger that would not heal."},{"id":"semetey-1-2013:p1047:b007:l003","ordinal":157048,"en":"He had these words to say:"},{"id":"semetey-1-2013:p1047:b007:l004","ordinal":157049,"en":"\"Give me your eldest daughter,\" he demanded,"},{"id":"semetey-1-2013:p1047:b007:l005","ordinal":157050,"en":"And had come to besiege"},{"id":"semetey-1-2013:p1047:b007:l006","ordinal":157051,"en":"The city of Khan Akun."},{"id":"semetey-1-2013:p1047:b007:l007","ordinal":157052,"en":"Toltoy of the Zhediger"},{"id":"semetey-1-2013:p1047:b007:l008","ordinal":157053,"en":"Had troops in numbers that bent the earth."},{"id":"semetey-1-2013:p1047:b007:l009","ordinal":157054,"en":"\"I shall seize Aychürök,"},{"id":"semetey-1-2013:p1047:b007:l010","ordinal":157055,"en":"And inflict harsh suffering,\" was"},{"id":"semetey-1-2013:p1047:b007:l011","ordinal":157056,"en":"Chynkozho's intent."},{"id":"semetey-1-2013:p1047:b007:l012","ordinal":157057,"en":"The Zhediger had an army"},{"id":"semetey-1-2013:p1047:b007:l013","ordinal":157058,"en":"That would overrun Afghanistan."},{"id":"semetey-1-2013:p1047:b007:l014","ordinal":157059,"en":"To Chynkozho and Toltoy,"},{"id":"semetey-1-2013:p1047:b007:l015","ordinal":157060,"en":"\"By force I shall seize Chürök"},{"id":"semetey-1-2013:p1047:b007:l016","ordinal":157061,"en":"And deliver her into your hands,\" he said,"},{"id":"semetey-1-2013:p1047:b007:l017","ordinal":157062,"en":"Offering a white Koran as large as a horse's head,"},{"id":"semetey-1-2013:p1048:b003:l001","ordinal":157063,"en":"Which the two held as they swore their oath;"},{"id":"semetey-1-2013:p1048:b003:l002","ordinal":157064,"en":"These two had given their answer."},{"id":"semetey-1-2013:p1048:b003:l003","ordinal":157065,"en":"\"Since the appointed day,"},{"id":"semetey-1-2013:p1048:b003:l004","ordinal":157066,"en":"Seven days have passed,\" they said."},{"id":"semetey-1-2013:p1048:b003:l005","ordinal":157067,"en":"When the Zhediger grow angry,"},{"id":"semetey-1-2013:p1048:b003:l006","ordinal":157068,"en":"They have an army that will overrun the land;"},{"id":"semetey-1-2013:p1048:b003:l007","ordinal":157069,"en":"They have pits already dug,"},{"id":"semetey-1-2013:p1048:b003:l008","ordinal":157070,"en":"And bitter misery boiling."},{"id":"semetey-1-2013:p1048:b003:l009","ordinal":157071,"en":"Raging and roaring,"},{"id":"semetey-1-2013:p1048:b003:l010","ordinal":157072,"en":"They have mighty Kozho among them."},{"id":"semetey-1-2013:p1048:b003:l011","ordinal":157073,"en":"Khan Akun's great fortress"},{"id":"semetey-1-2013:p1048:b003:l012","ordinal":157074,"en":"Had a high tower;"},{"id":"semetey-1-2013:p1048:b003:l013","ordinal":157075,"en":"When one climbed and looked from above,"},{"id":"semetey-1-2013:p1048:b003:l014","ordinal":157076,"en":"The sight unsettled the heart,"},{"id":"semetey-1-2013:p1048:b003:l015","ordinal":157077,"en":"And the face of the world could be seen."},{"id":"semetey-1-2013:p1048:b003:l016","ordinal":157078,"en":"Azhybay and Tümönbay"},{"id":"semetey-1-2013:p1048:b003:l017","ordinal":157079,"en":"Hurried and ran there."},{"id":"semetey-1-2013:p1048:b003:l018","ordinal":157080,"en":"\"How lie the Zhediger?\" they wondered,"},{"id":"semetey-1-2013:p1048:b003:l019","ordinal":157081,"en":"For danger lay on that side."},{"id":"semetey-1-2013:p1048:b003:l020","ordinal":157082,"en":"Azhybay and Tümönbay,"},{"id":"semetey-1-2013:p1048:b003:l021","ordinal":157083,"en":"Bending their knees to the ground,"},{"id":"semetey-1-2013:p1048:b003:l022","ordinal":157084,"en":"Both ran up"},{"id":"semetey-1-2013:p1048:b003:l023","ordinal":157085,"en":"To the top of the tower."},{"id":"semetey-1-2013:p1048:b003:l024","ordinal":157086,"en":"When they climbed to the tower's top"},{"id":"semetey-1-2013:p1048:b003:l025","ordinal":157087,"en":"And sat looking out,"},{"id":"semetey-1-2013:p1048:b003:l026","ordinal":157088,"en":"A blue-gray haze parted from the sky;"},{"id":"semetey-1-2013:p1048:b003:l027","ordinal":157089,"en":"With hungry cries and uproar,"},{"id":"semetey-1-2013:p1048:b003:l028","ordinal":157090,"en":"The Zhediger host appeared."},{"id":"semetey-1-2013:p1048:b003:l029","ordinal":157091,"en":"Streaming along the bank,"},{"id":"semetey-1-2013:p1048:b003:l030","ordinal":157092,"en":"Their spears swayed like reeds;"},{"id":"semetey-1-2013:p1048:b003:l031","ordinal":157093,"en":"Along the bank road of Kum-Kyya,"},{"id":"semetey-1-2013:p1048:b003:l032","ordinal":157094,"en":"They came forth in splendor."},{"id":"semetey-1-2013:p1048:b003:l033","ordinal":157095,"en":"Indistinguishable as separate worms,"},{"id":"semetey-1-2013:p1048:b003:l034","ordinal":157096,"en":"They came boiling forth;"},{"id":"semetey-1-2013:p1048:b003:l035","ordinal":157097,"en":"Poor Toltoy drove one flank"},{"id":"semetey-1-2013:p1048:b003:l036","ordinal":157098,"en":"As they came onward."},{"id":"semetey-1-2013:p1048:b003:l037","ordinal":157099,"en":"See the reeds, see the flood;"},{"id":"semetey-1-2013:p1048:b003:l038","ordinal":157100,"en":"See the seething mass of people."},{"id":"semetey-1-2013:p1048:b003:l039","ordinal":157101,"en":"At the spur of Tash-Kyya,"},{"id":"semetey-1-2013:p1048:b004:l001","ordinal":157102,"en":"Most of them came forth;"},{"id":"semetey-1-2013:p1048:b004:l002","ordinal":157103,"en":"Through the narrow bank road,"},{"id":"semetey-1-2013:p1048:b004:l003","ordinal":157104,"en":"Half of them came forth."},{"id":"semetey-1-2013:p1048:b004:l004","ordinal":157105,"en":"They came with sharp iron"},{"id":"semetey-1-2013:p1048:b004:l005","ordinal":157106,"en":"Fitted to their spears;"},{"id":"semetey-1-2013:p1048:b004:l006","ordinal":157107,"en":"They came having prepared"},{"id":"semetey-1-2013:p1048:b004:l007","ordinal":157108,"en":"Their lions who would overrun the land."},{"id":"semetey-1-2013:p1048:b004:l008","ordinal":157109,"en":"At the very rear, Chynkozho"},{"id":"semetey-1-2013:p1048:b004:l009","ordinal":157110,"en":"Drove them as they came."},{"id":"semetey-1-2013:p1048:b004:l010","ordinal":157111,"en":"Like grains of sand, the Zhediger"},{"id":"semetey-1-2013:p1048:b004:l011","ordinal":157112,"en":"Came seething forth."},{"id":"semetey-1-2013:p1048:b004:l012","ordinal":157113,"en":"Toltoy of the Zhediger,"},{"id":"semetey-1-2013:p1048:b004:l013","ordinal":157114,"en":"Whose countless troops bent the earth,"},{"id":"semetey-1-2013:p1048:b004:l014","ordinal":157115,"en":"Drove peoples of every kind,"},{"id":"semetey-1-2013:p1048:b004:l015","ordinal":157116,"en":"Drove a multitude that bent the earth."},{"id":"semetey-1-2013:p1048:b004:l016","ordinal":157117,"en":"The world filled and the land shone"},{"id":"semetey-1-2013:p1048:b004:l017","ordinal":157118,"en":"With the army advancing under him."},{"id":"semetey-1-2013:p1048:b004:l018","ordinal":157119,"en":"To seize Chürök,"},{"id":"semetey-1-2013:p1048:b004:l019","ordinal":157120,"en":"He drove so many people;"},{"id":"semetey-1-2013:p1048:b004:l020","ordinal":157121,"en":"Seven divisions of Zhediger"},{"id":"semetey-1-2013:p1048:b004:l021","ordinal":157122,"en":"He had gathered and driven there."},{"id":"semetey-1-2013:p1048:b004:l022","ordinal":157123,"en":"Beneath the multitude of that host,"},{"id":"semetey-1-2013:p1048:b004:l023","ordinal":157124,"en":"The earth had sagged."},{"id":"semetey-1-2013:p1048:b004:l024","ordinal":157125,"en":"Tölök and Tölöbay"},{"id":"semetey-1-2013:p1048:b004:l025","ordinal":157126,"en":"Were upon the lower ridge face;"},{"id":"semetey-1-2013:p1048:b004:l026","ordinal":157127,"en":"Kalcha and Kadyrbay"},{"id":"semetey-1-2013:p1048:b004:l027","ordinal":157128,"en":"Were at the edge of the upper host."},{"id":"semetey-1-2013:p1048:b004:l028","ordinal":157129,"en":"All the Zhediger,"},{"id":"semetey-1-2013:p1048:b004:l029","ordinal":157130,"en":"Streaming along the bank,"},{"id":"semetey-1-2013:p1048:b004:l030","ordinal":157131,"en":"Surged toward the land."},{"id":"semetey-1-2013:p1048:b004:l031","ordinal":157132,"en":"Then Tümönbay's"},{"id":"semetey-1-2013:p1048:b004:l032","ordinal":157133,"en":"Heart was sorely troubled;"},{"id":"semetey-1-2013:p1048:b004:l033","ordinal":157134,"en":"To Azhybay's eyes,"},{"id":"semetey-1-2013:p1048:b004:l034","ordinal":157135,"en":"They appeared like ravenous devourers."},{"id":"semetey-1-2013:p1048:b004:l035","ordinal":157136,"en":"The dense black Zhediger"},{"id":"semetey-1-2013:p1048:b004:l036","ordinal":157137,"en":"Separated into division after division,"},{"id":"semetey-1-2013:p1048:b004:l037","ordinal":157138,"en":"And split into distinct groups."},{"id":"semetey-1-2013:p1048:b004:l038","ordinal":157139,"en":"Upon the face of Bolbogur,"},{"id":"semetey-1-2013:p1048:b004:l039","ordinal":157140,"en":"At the edge rode one upon a gray horse,"},{"id":"semetey-1-2013:p1049:b003:l001","ordinal":157141,"en":"The bravest was at the front,"},{"id":"semetey-1-2013:p1049:b003:l002","ordinal":157142,"en":"And the black-horse rider at the edge."},{"id":"semetey-1-2013:p1049:b003:l003","ordinal":157143,"en":"All those bearing spears"},{"id":"semetey-1-2013:p1049:b003:l004","ordinal":157144,"en":"Rode ahead and separated;"},{"id":"semetey-1-2013:p1049:b003:l005","ordinal":157145,"en":"Champions who struck with battle-axes"},{"id":"semetey-1-2013:p1049:b003:l006","ordinal":157146,"en":"Appeared along either flank."},{"id":"semetey-1-2013:p1049:b003:l007","ordinal":157147,"en":"Those skilled at drawing bows,"},{"id":"semetey-1-2013:p1049:b003:l008","ordinal":157148,"en":"The finest marksmen with guns,"},{"id":"semetey-1-2013:p1049:b003:l009","ordinal":157149,"en":"Spread out and inflicted hardship."},{"id":"semetey-1-2013:p1049:b003:l010","ordinal":157150,"en":"Those who would not bend beneath a whip"},{"id":"semetey-1-2013:p1049:b003:l011","ordinal":157151,"en":"He separated as champions;"},{"id":"semetey-1-2013:p1049:b003:l012","ordinal":157152,"en":"Those who would not flinch beneath a sword"},{"id":"semetey-1-2013:p1049:b003:l013","ordinal":157153,"en":"He separated as formidable men;"},{"id":"semetey-1-2013:p1049:b003:l014","ordinal":157154,"en":"Those who would not flee"},{"id":"semetey-1-2013:p1049:b003:l015","ordinal":157155,"en":"When a black musket cracked,"},{"id":"semetey-1-2013:p1049:b003:l016","ordinal":157156,"en":"Those who would not start"},{"id":"semetey-1-2013:p1049:b003:l017","ordinal":157157,"en":"When a fierce gun snapped,"},{"id":"semetey-1-2013:p1049:b003:l018","ordinal":157158,"en":"He gathered and drove together."},{"id":"semetey-1-2013:p1049:b003:l019","ordinal":157159,"en":"Chynkozho, son of Shygay,"},{"id":"semetey-1-2013:p1049:b003:l020","ordinal":157160,"en":"Kozho, resolute in his deeds,"},{"id":"semetey-1-2013:p1049:b003:l021","ordinal":157161,"en":"Had begun a great upheaval."},{"id":"semetey-1-2013:p1049:b003:l022","ordinal":157162,"en":"If we do not give Chürök in tribute,"},{"id":"semetey-1-2013:p1049:b003:l023","ordinal":157163,"en":"An army comes that will overrun us;"},{"id":"semetey-1-2013:p1049:b003:l024","ordinal":157164,"en":"When he rages and attacks,"},{"id":"semetey-1-2013:p1049:b003:l025","ordinal":157165,"en":"Mighty Toltoy comes,"},{"id":"semetey-1-2013:p1049:b003:l026","ordinal":157166,"en":"One who will begin the great tumult."},{"id":"semetey-1-2013:p1049:b003:l027","ordinal":157167,"en":"All the Zhediger,"},{"id":"semetey-1-2013:p1049:b003:l028","ordinal":157168,"en":"With the accomplished elder Tölök,"},{"id":"semetey-1-2013:p1049:b003:l029","ordinal":157169,"en":"Brandishing their spears,"},{"id":"semetey-1-2013:p1049:b003:l030","ordinal":157170,"en":"Had made themselves ready."},{"id":"semetey-1-2013:p1049:b003:l031","ordinal":157171,"en":"The Zhediger had gathered"},{"id":"semetey-1-2013:p1049:b003:l032","ordinal":157172,"en":"Around Buloo Khan."},{"id":"semetey-1-2013:p1049:b003:l033","ordinal":157173,"en":"If we do not accept his demand,"},{"id":"semetey-1-2013:p1049:b003:l034","ordinal":157174,"en":"If we do not give Aychürök,"},{"id":"semetey-1-2013:p1049:b003:l035","ordinal":157175,"en":"They will overrun us utterly and attack,"},{"id":"semetey-1-2013:p1049:b003:l036","ordinal":157176,"en":"Turn water into their orchards,"},{"id":"semetey-1-2013:p1049:b003:l037","ordinal":157177,"en":"And make gardens of our land;"},{"id":"semetey-1-2013:p1049:b003:l038","ordinal":157178,"en":"They will channel water all around,"},{"id":"semetey-1-2013:p1049:b003:l039","ordinal":157179,"en":"And every one of them will spur in,"},{"id":"semetey-1-2013:p1049:b005:l001","ordinal":157180,"en":"And emerge everywhere alike."},{"id":"semetey-1-2013:p1049:b005:l002","ordinal":157181,"en":"If we do not give Aychürök,"},{"id":"semetey-1-2013:p1049:b005:l003","ordinal":157182,"en":"If we do not accept his words,"},{"id":"semetey-1-2013:p1049:b005:l004","ordinal":157183,"en":"They will demolish every house,"},{"id":"semetey-1-2013:p1049:b005:l005","ordinal":157184,"en":"Cut down and topple the willows,"}]
