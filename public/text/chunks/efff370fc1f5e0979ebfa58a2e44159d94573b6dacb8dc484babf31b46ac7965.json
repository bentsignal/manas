[{"id":"semetey-1-2013:p1042:b003:l015","ordinal":155649,"en":"When they reached great Afghanistan,"},{"id":"semetey-1-2013:p1042:b003:l016","ordinal":155650,"en":"Its mastiffs barked thunderously,"},{"id":"semetey-1-2013:p1042:b003:l017","ordinal":155651,"en":"Its bitches yelped and barked,"},{"id":"semetey-1-2013:p1042:b003:l018","ordinal":155652,"en":"Its donkeys brayed on the rooftops,"},{"id":"semetey-1-2013:p1042:b003:l019","ordinal":155653,"en":"And roosters crowed from the city."},{"id":"semetey-1-2013:p1042:b003:l020","ordinal":155654,"en":"Broad Afghanistan lay there,"},{"id":"semetey-1-2013:p1042:b003:l021","ordinal":155655,"en":"Divided into guarded quarters,"},{"id":"semetey-1-2013:p1042:b003:l022","ordinal":155656,"en":"With dark smoke visible."},{"id":"semetey-1-2013:p1042:b003:l023","ordinal":155657,"en":"Broad Afghanistan lay there;"},{"id":"semetey-1-2013:p1042:b003:l024","ordinal":155658,"en":"Having traveled far upon the road,"},{"id":"semetey-1-2013:p1042:b003:l025","ordinal":155659,"en":"The lions filed into"},{"id":"semetey-1-2013:p1042:b003:l026","ordinal":155660,"en":"The palace prepared for them."},{"id":"semetey-1-2013:p1042:b003:l027","ordinal":155661,"en":"Aychürök's white palace"},{"id":"semetey-1-2013:p1042:b003:l028","ordinal":155662,"en":"Had iron gates and solid tin;"},{"id":"semetey-1-2013:p1042:b003:l029","ordinal":155663,"en":"Though the poor woman was only a maiden,"},{"id":"semetey-1-2013:p1042:b003:l030","ordinal":155664,"en":"Her retinue was exceedingly great."},{"id":"semetey-1-2013:p1042:b003:l031","ordinal":155665,"en":"At the mouth of the doorway,"},{"id":"semetey-1-2013:p1042:b003:l032","ordinal":155666,"en":"The champions posted as guards,"},{"id":"semetey-1-2013:p1042:b003:l033","ordinal":155667,"en":"Holding clubs as large as houses,"},{"id":"semetey-1-2013:p1042:b003:l034","ordinal":155668,"en":"All eighty rose to their feet."},{"id":"semetey-1-2013:p1042:b003:l035","ordinal":155669,"en":"Passing among those eighty,"},{"id":"semetey-1-2013:p1042:b003:l036","ordinal":155670,"en":"Your sister-in-law went on."},{"id":"semetey-1-2013:p1042:b003:l037","ordinal":155671,"en":"She murmured to some,"},{"id":"semetey-1-2013:p1042:b003:l038","ordinal":155672,"en":"And whispered to others;"},{"id":"semetey-1-2013:p1042:b003:l039","ordinal":155673,"en":"When they heard this news,"},{"id":"semetey-1-2013:p1042:b004:l001","ordinal":155674,"en":"The guards flew like arrows"},{"id":"semetey-1-2013:p1042:b004:l002","ordinal":155675,"en":"And took the prince's horse."},{"id":"semetey-1-2013:p1042:b004:l003","ordinal":155676,"en":"At a pillar whose post was gold,"},{"id":"semetey-1-2013:p1042:b004:l004","ordinal":155677,"en":"They tethered the exhausted Buurul"},{"id":"semetey-1-2013:p1042:b004:l005","ordinal":155678,"en":"High and secure."},{"id":"semetey-1-2013:p1042:b004:l006","ordinal":155679,"en":"Aychürök's forty young women"},{"id":"semetey-1-2013:p1042:b004:l007","ordinal":155680,"en":"Tied up horses in a bustle;"},{"id":"semetey-1-2013:p1042:b004:l008","ordinal":155681,"en":"Their quickness was beyond measure,"},{"id":"semetey-1-2013:p1042:b004:l009","ordinal":155682,"en":"As they tied them fast in a flash."},{"id":"semetey-1-2013:p1042:b004:l010","ordinal":155683,"en":"Within the white palace,"},{"id":"semetey-1-2013:p1042:b004:l011","ordinal":155684,"en":"In the great ceremonial pavilion,"},{"id":"semetey-1-2013:p1042:b004:l012","ordinal":155685,"en":"Akylay flew like an arrow,"},{"id":"semetey-1-2013:p1042:b004:l013","ordinal":155686,"en":"And his sister-in-law opened the door."},{"id":"semetey-1-2013:p1042:b004:l014","ordinal":155687,"en":"Led by the prince who had brought them,"},{"id":"semetey-1-2013:p1042:b004:l015","ordinal":155688,"en":"Twenty-five people entered now."},{"id":"semetey-1-2013:p1042:b004:l016","ordinal":155689,"en":"The prince now mounted the place of honor,"},{"id":"semetey-1-2013:p1042:b004:l017","ordinal":155690,"en":"An enormous golden throne like a camel."},{"id":"semetey-1-2013:p1042:b004:l018","ordinal":155691,"en":"Around it stood a grove of plane trees,"},{"id":"semetey-1-2013:p1042:b004:l019","ordinal":155692,"en":"And in its center a golden throne;"},{"id":"semetey-1-2013:p1042:b004:l020","ordinal":155693,"en":"This was a garden granted by the Creator."},{"id":"semetey-1-2013:p1042:b004:l021","ordinal":155694,"en":"The princely leopard Semetey"},{"id":"semetey-1-2013:p1042:b004:l022","ordinal":155695,"en":"At this time had gone as a bridegroom"},{"id":"semetey-1-2013:p1042:b004:l023","ordinal":155696,"en":"To Khan Akun's city."},{"id":"semetey-1-2013:p1042:b004:l024","ordinal":155697,"en":"Your renowned sister-in-law Aychürök—"},{"id":"semetey-1-2013:p1042:b004:l025","ordinal":155698,"en":"Ask not about the hero's estate;"},{"id":"semetey-1-2013:p1042:b004:l026","ordinal":155699,"en":"She had known plainly beforehand"},{"id":"semetey-1-2013:p1042:b004:l027","ordinal":155700,"en":"That the heroic princely conqueror would come."},{"id":"semetey-1-2013:p1042:b004:l028","ordinal":155701,"en":"\"The descendant of the formidable lion"},{"id":"semetey-1-2013:p1042:b004:l029","ordinal":155702,"en":"Will surely come,\" she had thought,"},{"id":"semetey-1-2013:p1042:b004:l030","ordinal":155703,"en":"And your sister-in-law stood preparing."},{"id":"semetey-1-2013:p1042:b004:l031","ordinal":155704,"en":"For the fourteen horses she made coverings"},{"id":"semetey-1-2013:p1042:b004:l032","ordinal":155705,"en":"Fashioned in the likeness of tigers."},{"id":"semetey-1-2013:p1042:b004:l033","ordinal":155706,"en":"She had their insides lined with fine velvet,"},{"id":"semetey-1-2013:p1042:b004:l034","ordinal":155707,"en":"And maidens and young women bite down the seams;"},{"id":"semetey-1-2013:p1042:b004:l035","ordinal":155708,"en":"She had golden beads set along their edges,"},{"id":"semetey-1-2013:p1042:b004:l036","ordinal":155709,"en":"And their faces embroidered wholly in silk,"},{"id":"semetey-1-2013:p1042:b004:l037","ordinal":155710,"en":"Had the pile twisted thick and shaggy,"},{"id":"semetey-1-2013:p1042:b004:l038","ordinal":155711,"en":"So that to anyone who saw their color"},{"id":"semetey-1-2013:p1042:b004:l039","ordinal":155712,"en":"They bore the very likeness of a tiger,"},{"id":"semetey-1-2013:p1043:b003:l001","ordinal":155713,"en":"And had them draped over the fourteen horses,"},{"id":"semetey-1-2013:p1043:b003:l002","ordinal":155714,"en":"Each tethered separately."},{"id":"semetey-1-2013:p1043:b003:l003","ordinal":155715,"en":"All fourteen horses"},{"id":"semetey-1-2013:p1043:b003:l004","ordinal":155716,"en":"She had strain beyond measure;"},{"id":"semetey-1-2013:p1043:b003:l005","ordinal":155717,"en":"At the edge of the fourteen horses,"},{"id":"semetey-1-2013:p1043:b003:l006","ordinal":155718,"en":"She had the towering Buurul"},{"id":"semetey-1-2013:p1043:b003:l007","ordinal":155719,"en":"Toss like one whose master had died."},{"id":"semetey-1-2013:p1043:b003:l008","ordinal":155720,"en":"The coverings of the fourteen horses—"},{"id":"semetey-1-2013:p1043:b003:l009","ordinal":155721,"en":"Hoof matched to hoof,"},{"id":"semetey-1-2013:p1043:b003:l010","ordinal":155722,"en":"Made exactly like a tiger;"},{"id":"semetey-1-2013:p1043:b003:l011","ordinal":155723,"en":"Ear matched to ear,"},{"id":"semetey-1-2013:p1043:b003:l012","ordinal":155724,"en":"Made wholly like a tiger."},{"id":"semetey-1-2013:p1043:b003:l013","ordinal":155725,"en":"On this side of the horses,"},{"id":"semetey-1-2013:p1043:b003:l014","ordinal":155726,"en":"\"Let no person see,\" she said,"},{"id":"semetey-1-2013:p1043:b003:l015","ordinal":155727,"en":"And had a splendid screen erected,"},{"id":"semetey-1-2013:p1043:b003:l016","ordinal":155728,"en":"With a white curtain drawn."},{"id":"semetey-1-2013:p1043:b003:l017","ordinal":155729,"en":"The luckless daughter of Akun,"},{"id":"semetey-1-2013:p1043:b003:l018","ordinal":155730,"en":"Displaying her distinction,"},{"id":"semetey-1-2013:p1043:b003:l019","ordinal":155731,"en":"Presented surpassing games and revelry"},{"id":"semetey-1-2013:p1043:b003:l020","ordinal":155732,"en":"To the gray-maned hero."},{"id":"semetey-1-2013:p1043:b003:l021","ordinal":155733,"en":"\"My precious prince has come,"},{"id":"semetey-1-2013:p1043:b003:l022","ordinal":155734,"en":"And God has granted my wish,\" she said."},{"id":"semetey-1-2013:p1043:b003:l023","ordinal":155735,"en":"Some sixty unbred mares"},{"id":"semetey-1-2013:p1043:b003:l024","ordinal":155736,"en":"She had slaughtered for his food,"},{"id":"semetey-1-2013:p1043:b003:l025","ordinal":155737,"en":"And upon gilded platters"},{"id":"semetey-1-2013:p1043:b003:l026","ordinal":155738,"en":"Had carved meat set out."},{"id":"semetey-1-2013:p1043:b003:l027","ordinal":155739,"en":"Your dear sister-in-law Chürök"},{"id":"semetey-1-2013:p1043:b003:l028","ordinal":155740,"en":"Had a curtain made from pure silk,"},{"id":"semetey-1-2013:p1043:b003:l029","ordinal":155741,"en":"Held and stretched from its sides,"},{"id":"semetey-1-2013:p1043:b003:l030","ordinal":155742,"en":"Raising her honor above the people"},{"id":"semetey-1-2013:p1043:b003:l031","ordinal":155743,"en":"And satisfying the affection of all who saw."},{"id":"semetey-1-2013:p1043:b003:l032","ordinal":155744,"en":"From silk quilts of every kind,"},{"id":"semetey-1-2013:p1043:b003:l033","ordinal":155745,"en":"Thirty young women and thirty maidens"},{"id":"semetey-1-2013:p1043:b003:l034","ordinal":155746,"en":"Had luxurious bedding spread."},{"id":"semetey-1-2013:p1043:b003:l035","ordinal":155747,"en":"Thirty young women and thirty maidens"},{"id":"semetey-1-2013:p1043:b003:l036","ordinal":155748,"en":"She had open their saddlebags,"},{"id":"semetey-1-2013:p1043:b003:l037","ordinal":155749,"en":"And for the custom called zhengetay,"},{"id":"semetey-1-2013:p1043:b003:l038","ordinal":155750,"en":"From pounds of golden embroidery thread,"},{"id":"semetey-1-2013:p1043:b003:l039","ordinal":155751,"en":"She had gifts scattered to them all,"},{"id":"semetey-1-2013:p1043:b005:l001","ordinal":155752,"en":"Winning their agreement with her wishes"},{"id":"semetey-1-2013:p1043:b005:l002","ordinal":155753,"en":"And duly giving the customary gift."},{"id":"semetey-1-2013:p1043:b005:l003","ordinal":155754,"en":"If you look upon these games,"},{"id":"semetey-1-2013:p1043:b005:l004","ordinal":155755,"en":"Aychürök, whom you have seen,"},{"id":"semetey-1-2013:p1043:b005:l005","ordinal":155756,"en":"Now staged the revelry."},{"id":"semetey-1-2013:p1043:b005:l006","ordinal":155757,"en":"Her dear head beheld joy,"},{"id":"semetey-1-2013:p1043:b005:l007","ordinal":155758,"en":"With maidens and young men mingled together."},{"id":"semetey-1-2013:p1043:b005:l008","ordinal":155759,"en":"Yesterday, your honored sister-in-law Aychürök,"},{"id":"semetey-1-2013:p1043:b005:l009","ordinal":155760,"en":"Hearing words from those who had come,"},{"id":"semetey-1-2013:p1043:b005:l010","ordinal":155761,"en":"Heard that, \"If he sees kumis and a maiden,"},{"id":"semetey-1-2013:p1043:b005:l011","ordinal":155762,"en":"The princely leopard and falcon"},{"id":"semetey-1-2013:p1043:b005:l012","ordinal":155763,"en":"Will die of delight.\""},{"id":"semetey-1-2013:p1043:b005:l013","ordinal":155764,"en":"She prepared things in every fashion;"},{"id":"semetey-1-2013:p1043:b005:l014","ordinal":155765,"en":"Of all that could be prepared,"},{"id":"semetey-1-2013:p1043:b005:l015","ordinal":155766,"en":"Nothing at all was lacking with Chürök."},{"id":"semetey-1-2013:p1043:b005:l016","ordinal":155767,"en":"Eighty young women and eighty maidens,"},{"id":"semetey-1-2013:p1043:b005:l017","ordinal":155768,"en":"Eighty young men and eighty lads"},{"id":"semetey-1-2013:p1043:b005:l018","ordinal":155769,"en":"Sprang about and held their games."},{"id":"semetey-1-2013:p1043:b005:l019","ordinal":155770,"en":"They twisted their kerchiefs"},{"id":"semetey-1-2013:p1043:b005:l020","ordinal":155771,"en":"Into clubs,"},{"id":"semetey-1-2013:p1043:b005:l021","ordinal":155772,"en":"Women and men mingled,"},{"id":"semetey-1-2013:p1043:b005:l022","ordinal":155773,"en":"Striking one another"},{"id":"semetey-1-2013:p1043:b005:l023","ordinal":155774,"en":"As they stood like this."},{"id":"semetey-1-2013:p1043:b005:l024","ordinal":155775,"en":"Women and men mingled,"},{"id":"semetey-1-2013:p1043:b005:l025","ordinal":155776,"en":"Taking turns with the kerchief-club,"},{"id":"semetey-1-2013:p1043:b005:l026","ordinal":155777,"en":"Striking the one each loved,"},{"id":"semetey-1-2013:p1043:b005:l027","ordinal":155778,"en":"And satisfying their desire in this way."},{"id":"semetey-1-2013:p1043:b005:l028","ordinal":155779,"en":"\"These are Aychürök's games,"},{"id":"semetey-1-2013:p1043:b005:l029","ordinal":155780,"en":"The wedding feast of Semetey,\" they said."},{"id":"semetey-1-2013:p1043:b005:l030","ordinal":155781,"en":"One woman and one man,"},{"id":"semetey-1-2013:p1043:b005:l031","ordinal":155782,"en":"Embracing, met as lovers,"},{"id":"semetey-1-2013:p1043:b005:l032","ordinal":155783,"en":"And kissed to ease their longing."},{"id":"semetey-1-2013:p1043:b005:l033","ordinal":155784,"en":"The men sang,"},{"id":"semetey-1-2013:p1043:b005:l034","ordinal":155785,"en":"The women listened,"},{"id":"semetey-1-2013:p1043:b005:l035","ordinal":155786,"en":"And played without tiring."},{"id":"semetey-1-2013:p1043:b005:l036","ordinal":155787,"en":"They went to those they loved,"},{"id":"semetey-1-2013:p1043:b005:l037","ordinal":155788,"en":"Drank kumis and grew merry,"},{"id":"semetey-1-2013:p1043:b005:l038","ordinal":155789,"en":"Their very bones growing warm;"},{"id":"semetey-1-2013:p1043:b005:l039","ordinal":155790,"en":"When one looked upon the edge of their bliss,"}]
