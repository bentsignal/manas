[{"id":"manas-2010:p1409:b001:l035","ordinal":60929,"en":"Its patterns would not fade in the least;"},{"id":"manas-2010:p1409:b001:l036","ordinal":60930,"en":"Even swept in floods for forty years,"},{"id":"manas-2010:p1409:b001:l037","ordinal":60931,"en":"Not an edge would budge—"},{"id":"manas-2010:p1409:b001:l038","ordinal":60932,"en":"The carpet with golden patterns"},{"id":"manas-2010:p1409:b001:l039","ordinal":60933,"en":"They brought and spread."},{"id":"manas-2010:p1409:b001:l040","ordinal":60934,"en":"Magnanimous Sultan Manas,"},{"id":"manas-2010:p1409:b001:l041","ordinal":60935,"en":"Upon that carpet,"},{"id":"manas-2010:p1409:b001:l042","ordinal":60936,"en":"They now seated him."},{"id":"manas-2010:p1410:b001:l001","ordinal":60937,"en":"As though he would divide an inheritance,"},{"id":"manas-2010:p1410:b001:l002","ordinal":60938,"en":"The Chinese multitude cried out,"},{"id":"manas-2010:p1410:b001:l003","ordinal":60939,"en":"And gathered around Manas."},{"id":"manas-2010:p1410:b001:l004","ordinal":60940,"en":"With Khan Esenkan at their head,"},{"id":"manas-2010:p1410:b001:l005","ordinal":60941,"en":"Who had fled from Talas,"},{"id":"manas-2010:p1410:b001:l006","ordinal":60942,"en":"They truly raised Manas aloft."},{"id":"manas-2010:p1410:b001:l007","ordinal":60943,"en":"Esenkan’s golden throne—"},{"id":"manas-2010:p1410:b001:l008","ordinal":60944,"en":"Seating him upon that golden throne,"},{"id":"manas-2010:p1410:b001:l009","ordinal":60945,"en":"Over Beijing of Kakan-Chin,"},{"id":"manas-2010:p1410:b001:l010","ordinal":60946,"en":"They proclaimed him khan."},{"id":"manas-2010:p1410:b001:l011","ordinal":60947,"en":"Taking tribute from Beijing,"},{"id":"manas-2010:p1410:b001:l012","ordinal":60948,"en":"Seated upon a golden throne as khan,"},{"id":"manas-2010:p1410:b001:l013","ordinal":60949,"en":"The mighty army of the twelve khans"},{"id":"manas-2010:p1410:b001:l014","ordinal":60950,"en":"All had their minds at ease."},{"id":"manas-2010:p1410:b001:l015","ordinal":60951,"en":"The elders Koshoy and Bakay were there;"},{"id":"manas-2010:p1410:b001:l016","ordinal":60952,"en":"All the champions were there."},{"id":"manas-2010:p1410:b001:l017","ordinal":60953,"en":"This time in Beijing,"},{"id":"manas-2010:p1410:b001:l018","ordinal":60954,"en":"Having many remarkable deeds performed,"},{"id":"manas-2010:p1410:b001:l019","ordinal":60955,"en":"The Kyrgyz had their freedom."},{"id":"manas-2010:p1410:b001:l020","ordinal":60956,"en":"With hero Manas at their head,"},{"id":"manas-2010:p1410:b001:l021","ordinal":60957,"en":"Having girls taken as tribute,"},{"id":"manas-2010:p1410:b001:l022","ordinal":60958,"en":"Upon the Chinese peoples of forty khans"},{"id":"manas-2010:p1410:b001:l023","ordinal":60959,"en":"They levied one horse per household,"},{"id":"manas-2010:p1410:b001:l024","ordinal":60960,"en":"Had them gathered, leaving none out,"},{"id":"manas-2010:p1410:b001:l025","ordinal":60961,"en":"“For the Kyrgyz army to eat,”"},{"id":"manas-2010:p1410:b001:l026","ordinal":60962,"en":"Had fat oxen slaughtered,"},{"id":"manas-2010:p1410:b001:l027","ordinal":60963,"en":"Had the guard firmly posted."},{"id":"manas-2010:p1410:b001:l028","ordinal":60964,"en":"All who went became lords;"},{"id":"manas-2010:p1410:b001:l029","ordinal":60965,"en":"The many troops, without division,"},{"id":"manas-2010:p1410:b001:l030","ordinal":60966,"en":"All became blue as iron."},{"id":"manas-2010:p1410:b001:l031","ordinal":60967,"en":"Over Beijing, which Solomon could not reach,"},{"id":"manas-2010:p1410:b001:l032","ordinal":60968,"en":"They now exercised rule;"},{"id":"manas-2010:p1410:b001:l033","ordinal":60969,"en":"Upon Beijing, which Alexander could not reach,"},{"id":"manas-2010:p1410:b001:l034","ordinal":60970,"en":"They now levied taxes."},{"id":"manas-2010:p1410:b001:l035","ordinal":60971,"en":"They made mares their slaughter meat;"},{"id":"manas-2010:p1410:b001:l036","ordinal":60972,"en":"Taking great levies and taxes,"},{"id":"manas-2010:p1410:b001:l037","ordinal":60973,"en":"They left many Chinese on foot."},{"id":"manas-2010:p1410:b001:l038","ordinal":60974,"en":"When the Muslim became khan,"},{"id":"manas-2010:p1410:b001:l039","ordinal":60975,"en":"Of Beijing in Kakan-Chin,"},{"id":"manas-2010:p1410:b001:l040","ordinal":60976,"en":"He plundered its riches."},{"id":"manas-2010:p1410:b001:l041","ordinal":60977,"en":"Bearing great levies and taxes,"},{"id":"manas-2010:p1410:b001:l042","ordinal":60978,"en":"The Chinese were left in torment."},{"id":"manas-2010:p1411:b001:l001","ordinal":60979,"en":"“One cauldron for every two households—"},{"id":"manas-2010:p1411:b001:l002","ordinal":60980,"en":"Keep yourselves alive,” he commanded."},{"id":"manas-2010:p1411:b001:l003","ordinal":60981,"en":"In gold, silver and precious stones,"},{"id":"manas-2010:p1411:b001:l004","ordinal":60982,"en":"He demanded and took tribute."},{"id":"manas-2010:p1411:b001:l005","ordinal":60983,"en":"From Esenkan’s people,"},{"id":"manas-2010:p1411:b001:l006","ordinal":60984,"en":"He gathered a countless multitude."},{"id":"manas-2010:p1411:b001:l007","ordinal":60985,"en":"Holding a feast for sixty days,"},{"id":"manas-2010:p1411:b001:l008","ordinal":60986,"en":"The Chinese man called Shuykuchu"},{"id":"manas-2010:p1411:b001:l009","ordinal":60987,"en":"He made a true Muslim."},{"id":"manas-2010:p1411:b001:l010","ordinal":60988,"en":"A Chinese man like Shuykuchu,"},{"id":"manas-2010:p1411:b001:l011","ordinal":60989,"en":"Having him cut with a sword,"},{"id":"manas-2010:p1411:b001:l012","ordinal":60990,"en":"Having him pressed down with an axe,"},{"id":"manas-2010:p1411:b001:l013","ordinal":60991,"en":"According to the Burut’s will,"},{"id":"manas-2010:p1411:b001:l014","ordinal":60992,"en":"Shuykuchu went along."},{"id":"manas-2010:p1411:b001:l015","ordinal":60993,"en":"Falsely a Muslim,"},{"id":"manas-2010:p1411:b001:l016","ordinal":60994,"en":"In truth remaining Chinese,"},{"id":"manas-2010:p1411:b001:l017","ordinal":60995,"en":"Shuykuchu went on living."},{"id":"manas-2010:p1411:b001:l018","ordinal":60996,"en":"Becoming a cook for Manas,"},{"id":"manas-2010:p1411:b001:l019","ordinal":60997,"en":"Shuykuchu kept entering his presence."},{"id":"manas-2010:p1411:b001:l020","ordinal":60998,"en":"How he conducted his affairs,"},{"id":"manas-2010:p1411:b001:l021","ordinal":60999,"en":"The weaknesses of Khan Manas,"},{"id":"manas-2010:p1411:b001:l022","ordinal":61000,"en":"Shuykuchu kept learning."},{"id":"manas-2010:p1411:b001:l023","ordinal":61001,"en":"His conduct and his deeds,"},{"id":"manas-2010:p1411:b001:l024","ordinal":61002,"en":"Shuykuchu kept writing down."},{"id":"manas-2010:p1411:b001:l025","ordinal":61003,"en":"In Beijing, where Solomon had not gone,"},{"id":"manas-2010:p1411:b001:l026","ordinal":61004,"en":"Having become a splendid khan,"},{"id":"manas-2010:p1411:b001:l027","ordinal":61005,"en":"Let us leave Manas thus;"},{"id":"manas-2010:p1411:b001:l028","ordinal":61006,"en":"Now let us begin the tale"},{"id":"manas-2010:p1411:b001:l029","ordinal":61007,"en":"Of him who fled to Beijing,"},{"id":"manas-2010:p1411:b001:l030","ordinal":61008,"en":"Let us begin with Kongurbay."},{"id":"manas-2010:p1411:b001:l031","ordinal":61009,"en":"To Inner Beijing itself,"},{"id":"manas-2010:p1411:b001:l032","ordinal":61010,"en":"Before Karykan,"},{"id":"manas-2010:p1411:b001:l033","ordinal":61011,"en":"Kongurbay had gone;"},{"id":"manas-2010:p1411:b001:l034","ordinal":61012,"en":"Throughout the world,"},{"id":"manas-2010:p1411:b001:l035","ordinal":61013,"en":"Kongurbay had sent word."},{"id":"manas-2010:p1411:b001:l036","ordinal":61014,"en":"“We have let the Muslims overcome us;"},{"id":"manas-2010:p1411:b001:l037","ordinal":61015,"en":"Esenkan’s Burulcha,"},{"id":"manas-2010:p1411:b001:l038","ordinal":61016,"en":"We have lost her to the Burut."},{"id":"manas-2010:p1411:b001:l039","ordinal":61017,"en":"In the fighting, khans died;"},{"id":"manas-2010:p1411:b001:l040","ordinal":61018,"en":"All the common soldiery died."},{"id":"manas-2010:p1411:b001:l041","ordinal":61019,"en":"The great wrestler with iron ears,"},{"id":"manas-2010:p1411:b001:l042","ordinal":61020,"en":"Kutan the Giant, went and was slain."},{"id":"manas-2010:p1412:b001:l001","ordinal":61021,"en":"With his forty lords at their head,"},{"id":"manas-2010:p1412:b001:l002","ordinal":61022,"en":"Ezkara, khan of the Manchu,"},{"id":"manas-2010:p1412:b001:l003","ordinal":61023,"en":"Was captured and bound."},{"id":"manas-2010:p1412:b001:l004","ordinal":61024,"en":"Of your Black Kalmyk people,"},{"id":"manas-2010:p1412:b001:l005","ordinal":61025,"en":"Dear Khan Zholoy died;"},{"id":"manas-2010:p1412:b001:l006","ordinal":61026,"en":"Among the khans of the Lower Sibe,"},{"id":"manas-2010:p1412:b001:l007","ordinal":61027,"en":"The wrestler Ylama died too."},{"id":"manas-2010:p1412:b001:l008","ordinal":61028,"en":"She was khan of the Torgut;"},{"id":"manas-2010:p1412:b001:l009","ordinal":61029,"en":"Though a woman, Kanyshay"},{"id":"manas-2010:p1412:b001:l010","ordinal":61030,"en":"Was a soul we relied upon."},{"id":"manas-2010:p1412:b001:l011","ordinal":61031,"en":"When the Burut swarmed in,"},{"id":"manas-2010:p1412:b001:l012","ordinal":61032,"en":"She died among the Torgut."},{"id":"manas-2010:p1412:b001:l013","ordinal":61033,"en":"Of your people called Solon,"},{"id":"manas-2010:p1412:b001:l014","ordinal":61034,"en":"Remaining where they had not died,"},{"id":"manas-2010:p1412:b001:l015","ordinal":61035,"en":"Fighting six months without rest,"},{"id":"manas-2010:p1412:b001:l016","ordinal":61036,"en":"Esenkan’s Börüköz—"},{"id":"manas-2010:p1412:b001:l017","ordinal":61037,"en":"A hero like him died."},{"id":"manas-2010:p1412:b001:l018","ordinal":61038,"en":"I had fierce battle fought;"},{"id":"manas-2010:p1412:b001:l019","ordinal":61039,"en":"Mighty, fierce heroes"},{"id":"manas-2010:p1412:b001:l020","ordinal":61040,"en":"I lost to the Burut."},{"id":"manas-2010:p1412:b001:l021","ordinal":61041,"en":"Now I am afraid:"},{"id":"manas-2010:p1412:b001:l022","ordinal":61042,"en":"‘He will plunder my riches;"},{"id":"manas-2010:p1412:b001:l023","ordinal":61043,"en":"If we do not pay his tribute in full,"},{"id":"manas-2010:p1412:b001:l024","ordinal":61044,"en":"If we do not obey his words,"},{"id":"manas-2010:p1412:b001:l025","ordinal":61045,"en":"Manas will bring torment,’ I fear."},{"id":"manas-2010:p1412:b001:l026","ordinal":61046,"en":"Their Manas is a mighty hero,"},{"id":"manas-2010:p1412:b001:l027","ordinal":61047,"en":"A lion guarded by the unseen patron."},{"id":"manas-2010:p1412:b001:l028","ordinal":61048,"en":"Set the others aside:"},{"id":"manas-2010:p1412:b001:l029","ordinal":61049,"en":"This Beijing where we stand,"},{"id":"manas-2010:p1412:b001:l030","ordinal":61050,"en":"He is a hero who could slaughter it alone."},{"id":"manas-2010:p1412:b001:l031","ordinal":61051,"en":"Chinese and Burut intermingled,"},{"id":"manas-2010:p1412:b001:l032","ordinal":61052,"en":"When the great battle took place,"},{"id":"manas-2010:p1412:b001:l033","ordinal":61053,"en":"Had it not been for Khan Madykan,"},{"id":"manas-2010:p1412:b001:l034","ordinal":61054,"en":"He would have resolved to strike;"},{"id":"manas-2010:p1412:b001:l035","ordinal":61055,"en":"Upon your heads, Karykan,"},{"id":"manas-2010:p1412:b001:l036","ordinal":61056,"en":"He would have done wonders no other man could do!"},{"id":"manas-2010:p1412:b001:l037","ordinal":61057,"en":"Dust rose from the intervening ground;"},{"id":"manas-2010:p1412:b001:l038","ordinal":61058,"en":"The fugitive pig, knower of secrets,"},{"id":"manas-2010:p1412:b001:l039","ordinal":61059,"en":"Almambet too came out to battle."},{"id":"manas-2010:p1412:b001:l040","ordinal":61060,"en":"Syrgak, Ulak Khan’s son—"},{"id":"manas-2010:p1412:b001:l041","ordinal":61061,"en":"I have never seen such a hero."},{"id":"manas-2010:p1412:b001:l042","ordinal":61062,"en":"He shook me fully awake;"},{"id":"manas-2010:p1413:b001:l001","ordinal":61063,"en":"Syrgak slaughtered"},{"id":"manas-2010:p1413:b001:l002","ordinal":61064,"en":"Your mighty Chinese people."},{"id":"manas-2010:p1413:b001:l003","ordinal":61065,"en":"Tall of body and broad of shoulder,"},{"id":"manas-2010:p1413:b001:l004","ordinal":61066,"en":"He is a hero equal to Manas,"},{"id":"manas-2010:p1413:b001:l005","ordinal":61067,"en":"Chubak, Akbaltay’s son."},{"id":"manas-2010:p1413:b001:l006","ordinal":61068,"en":"Finding words in a sudden crisis,"},{"id":"manas-2010:p1413:b001:l007","ordinal":61069,"en":"Finding eyes in darkness,"},{"id":"manas-2010:p1413:b001:l008","ordinal":61070,"en":"Finding a fortified ridge,"},{"id":"manas-2010:p1413:b001:l009","ordinal":61071,"en":"He is a hero who girds himself with resolve,"},{"id":"manas-2010:p1413:b001:l010","ordinal":61072,"en":"The one called champion Bakay."},{"id":"manas-2010:p1413:b001:l011","ordinal":61073,"en":"A lion among humankind,"},{"id":"manas-2010:p1413:b001:l012","ordinal":61074,"en":"All of those men,"},{"id":"manas-2010:p1413:b001:l013","ordinal":61075,"en":"Their Manas, who keeps them together,"},{"id":"manas-2010:p1413:b001:l014","ordinal":61076,"en":"Has the might of a mountain."},{"id":"manas-2010:p1413:b001:l015","ordinal":61077,"en":"At one glance, he is one man;"},{"id":"manas-2010:p1413:b001:l016","ordinal":61078,"en":"Approach him, and he is a thousand men."},{"id":"manas-2010:p1413:b001:l017","ordinal":61079,"en":"If I charge him from behind,"},{"id":"manas-2010:p1413:b001:l018","ordinal":61080,"en":"He has a dragon’s appearance."},{"id":"manas-2010:p1413:b001:l019","ordinal":61081,"en":"When he roars and extends his spear,"},{"id":"manas-2010:p1413:b001:l020","ordinal":61082,"en":"He has the terror of six thousand heroes."},{"id":"manas-2010:p1413:b001:l021","ordinal":61083,"en":"Throughout the face of the earth,"},{"id":"manas-2010:p1413:b001:l022","ordinal":61084,"en":"Respect for Manas has spread."},{"id":"manas-2010:p1413:b001:l023","ordinal":61085,"en":"His companions who came from everywhere,"},{"id":"manas-2010:p1413:b001:l024","ordinal":61086,"en":"Just like Manas himself,"},{"id":"manas-2010:p1413:b001:l025","ordinal":61087,"en":"Had become Khan Manas."},{"id":"manas-2010:p1413:b001:l026","ordinal":61088,"en":"Not just anyone could torment"},{"id":"manas-2010:p1413:b001:l027","ordinal":61089,"en":"This Manas who has come."},{"id":"manas-2010:p1413:b001:l028","ordinal":61090,"en":"Among the people of the whole wide world,"},{"id":"manas-2010:p1413:b001:l029","ordinal":61091,"en":"No champion remains who can resist him."},{"id":"manas-2010:p1413:b001:l030","ordinal":61092,"en":"When they face and enter the enemy,"},{"id":"manas-2010:p1413:b001:l031","ordinal":61093,"en":"If you ask of the champions,"},{"id":"manas-2010:p1413:b001:l032","ordinal":61094,"en":"Almambet and Chubak are there too;"},{"id":"manas-2010:p1413:b001:l033","ordinal":61095,"en":"To enter battle shouting,"},{"id":"manas-2010:p1413:b001:l034","ordinal":61096,"en":"His khans Ajybay and Bakay are there."},{"id":"manas-2010:p1413:b001:l035","ordinal":61097,"en":"Girls, gold and precious stones,"},{"id":"manas-2010:p1413:b001:l036","ordinal":61098,"en":"If we do not give them without hesitation,"},{"id":"manas-2010:p1413:b001:l037","ordinal":61099,"en":"He can bring a terrible spectacle upon us."},{"id":"manas-2010:p1413:b001:l038","ordinal":61100,"en":"When his Syrgak exerts himself,"},{"id":"manas-2010:p1413:b001:l039","ordinal":61101,"en":"He is like hardened red iron;"},{"id":"manas-2010:p1413:b001:l040","ordinal":61102,"en":"When his Manas truly roars,"},{"id":"manas-2010:p1413:b001:l041","ordinal":61103,"en":"His bulk is equal to a mountain.”"},{"id":"manas-2010:p1413:b001:l042","ordinal":61104,"en":"So many thoughts would not fit in his breast;"},{"id":"manas-2010:p1414:b001:l001","ordinal":61105,"en":"When he went to his great khan,"},{"id":"manas-2010:p1414:b001:l002","ordinal":61106,"en":"Kongurbay of the Chinese,"},{"id":"manas-2010:p1414:b001:l003","ordinal":61107,"en":"His tears streamed across ten fields."},{"id":"manas-2010:p1414:b001:l004","ordinal":61108,"en":"To Kongurbay himself,"},{"id":"manas-2010:p1414:b001:l005","ordinal":61109,"en":"Karykan stood and said:"},{"id":"manas-2010:p1414:b001:l006","ordinal":61110,"en":"“Of Beijing’s forty gates,"},{"id":"manas-2010:p1414:b001:l007","ordinal":61111,"en":"Have you seen one doorway?"},{"id":"manas-2010:p1414:b001:l008","ordinal":61112,"en":"Opening toward the setting sun,"},{"id":"manas-2010:p1414:b001:l009","ordinal":61113,"en":"‘Until the age of Judgment Day,"},{"id":"manas-2010:p1414:b001:l010","ordinal":61114,"en":"The city of Beijing shall not be taken,’"},{"id":"manas-2010:p1414:b001:l011","ordinal":61115,"en":"Is written upon its gate."},{"id":"manas-2010:p1414:b001:l012","ordinal":61116,"en":"‘Beijing shall not die of hunger,’"},{"id":"manas-2010:p1414:b001:l013","ordinal":61117,"en":"Upon this standing Beijing"},{"id":"manas-2010:p1414:b001:l014","ordinal":61118,"en":"God’s radiance has been scattered."},{"id":"manas-2010:p1414:b001:l015","ordinal":61119,"en":"This is the land upon which light poured down;"},{"id":"manas-2010:p1414:b001:l016","ordinal":61120,"en":"Thirty men, from ancient times,"},{"id":"manas-2010:p1414:b001:l017","ordinal":61121,"en":"Mounted golden thrones in this place."},{"id":"manas-2010:p1414:b001:l018","ordinal":61122,"en":"Solomon came to Beijing;"},{"id":"manas-2010:p1414:b001:l019","ordinal":61123,"en":"He was a hero who turned back."},{"id":"manas-2010:p1414:b001:l020","ordinal":61124,"en":"Untouched by the assault of a hostile army,"},{"id":"manas-2010:p1414:b001:l021","ordinal":61125,"en":"It is a people that remained unharmed."},{"id":"manas-2010:p1414:b001:l022","ordinal":61126,"en":"Knowing Manas’s valor,"},{"id":"manas-2010:p1414:b001:l023","ordinal":61127,"en":"Though I pressed the Burut many times,"},{"id":"manas-2010:p1414:b001:l024","ordinal":61128,"en":"I am the one who could not take them."},{"id":"manas-2010:p1414:b001:l025","ordinal":61129,"en":"Against this city of Beijing,"},{"id":"manas-2010:p1414:b001:l026","ordinal":61130,"en":"So many champions rode;"},{"id":"manas-2010:p1414:b001:l027","ordinal":61131,"en":"‘An enemy of discord shall arise within,"},{"id":"manas-2010:p1414:b001:l028","ordinal":61132,"en":"And over this standing Beijing"},{"id":"manas-2010:p1414:b001:l029","ordinal":61133,"en":"He shall rule for six months’—"},{"id":"manas-2010:p1414:b001:l030","ordinal":61134,"en":"Khan Manas, six years before,"},{"id":"manas-2010:p1414:b001:l031","ordinal":61135,"en":"Was recorded in our register."},{"id":"manas-2010:p1414:b001:l032","ordinal":61136,"en":"That standing Manas—"},{"id":"manas-2010:p1414:b001:l033","ordinal":61137,"en":"Those who heard the news grieved:"},{"id":"manas-2010:p1414:b001:l034","ordinal":61138,"en":"‘Almambet and Manas shall unite"},{"id":"manas-2010:p1414:b001:l035","ordinal":61139,"en":"And take the rule of Beijing,’"},{"id":"manas-2010:p1414:b001:l036","ordinal":61140,"en":"Was written in its book."},{"id":"manas-2010:p1414:b001:l037","ordinal":61141,"en":"Manas shall be khan for six months;"},{"id":"manas-2010:p1414:b001:l038","ordinal":61142,"en":"After that, there shall be peace."},{"id":"manas-2010:p1414:b001:l039","ordinal":61143,"en":"If he takes tribute without sparing,"},{"id":"manas-2010:p1414:b001:l040","ordinal":61144,"en":"Do not cling to wealth.”"},{"id":"manas-2010:p1414:b001:l041","ordinal":61145,"en":"Speaking thus, Karykan"},{"id":"manas-2010:p1414:b001:l042","ordinal":61146,"en":"Now showed terrible wrath,"},{"id":"manas-2010:p1415:b001:l001","ordinal":61147,"en":"Sending word to Beijing,"},{"id":"manas-2010:p1415:b001:l002","ordinal":61148,"en":"The many smiths there"},{"id":"manas-2010:p1415:b001:l003","ordinal":61149,"en":"He gathered, every one."},{"id":"manas-2010:p1415:b001:l004","ordinal":61150,"en":"When his smiths arrived,"},{"id":"manas-2010:p1415:b001:l005","ordinal":61151,"en":"He gave stern commands."},{"id":"manas-2010:p1415:b001:l006","ordinal":61152,"en":"Those who knew the nature of sharp steel,"},{"id":"manas-2010:p1415:b001:l007","ordinal":61153,"en":"The most skillful, he assembled."},{"id":"manas-2010:p1415:b001:l008","ordinal":61154,"en":"His smiths came together;"},{"id":"manas-2010:p1415:b001:l009","ordinal":61155,"en":"Having gold drawn over its handle,"},{"id":"manas-2010:p1415:b001:l010","ordinal":61156,"en":"Having poison spread upon its face,"},{"id":"manas-2010:p1415:b001:l011","ordinal":61157,"en":"They went on making the battle-axe,"},{"id":"manas-2010:p1415:b001:l012","ordinal":61158,"en":"Delighting all who saw it."},{"id":"manas-2010:p1415:b001:l013","ordinal":61159,"en":"In a dragon's venom"},{"id":"manas-2010:p1415:b001:l014","ordinal":61160,"en":"They steeped it six or seven times."},{"id":"manas-2010:p1415:b001:l015","ordinal":61161,"en":"“Let death arrive when it strikes;"},{"id":"manas-2010:p1415:b001:l016","ordinal":61162,"en":"Let its victim burst and shatter!"},{"id":"manas-2010:p1415:b001:l017","ordinal":61163,"en":"The enemy it encounters,"},{"id":"manas-2010:p1415:b001:l018","ordinal":61164,"en":"Let his death come in this way!”"},{"id":"manas-2010:p1415:b001:l019","ordinal":61165,"en":"When Manas mounted his throne,"},{"id":"manas-2010:p1415:b001:l020","ordinal":61166,"en":"Karykan was not dismayed."},{"id":"manas-2010:p1415:b001:l021","ordinal":61167,"en":"When many of his men were slaughtered,"},{"id":"manas-2010:p1415:b001:l022","ordinal":61168,"en":"Karykan did not waste away."},{"id":"manas-2010:p1415:b001:l023","ordinal":61169,"en":"He had long been a khan;"},{"id":"manas-2010:p1415:b001:l024","ordinal":61170,"en":"Except that he was an infidel,"},{"id":"manas-2010:p1415:b001:l025","ordinal":61171,"en":"He was a man of sacred power."},{"id":"manas-2010:p1415:b001:l026","ordinal":61172,"en":"Disaster that would come before him,"},{"id":"manas-2010:p1415:b001:l027","ordinal":61173,"en":"Six months in advance, Karykan"},{"id":"manas-2010:p1415:b001:l028","ordinal":61174,"en":"Was able to foresee."},{"id":"manas-2010:p1415:b001:l029","ordinal":61175,"en":"The whole city of Beijing"},{"id":"manas-2010:p1415:b001:l030","ordinal":61176,"en":"He was the khan who held in his sway."},{"id":"manas-2010:p1415:b001:l031","ordinal":61177,"en":"To Karykan himself"},{"id":"manas-2010:p1415:b001:l032","ordinal":61178,"en":"He was a close associate."},{"id":"manas-2010:p1415:b001:l033","ordinal":61179,"en":"If you considered his foresight,"},{"id":"manas-2010:p1415:b001:l034","ordinal":61180,"en":"Kongurbay, son of Alöökö,"},{"id":"manas-2010:p1415:b001:l035","ordinal":61181,"en":"Was the equal of Karykan."},{"id":"manas-2010:p1415:b001:l036","ordinal":61182,"en":"A fitting battle-axe,"},{"id":"manas-2010:p1415:b001:l037","ordinal":61183,"en":"After six months' work, they completed."},{"id":"manas-2010:p1415:b001:l038","ordinal":61184,"en":"Taking the axe, Kongurbay,"}]
