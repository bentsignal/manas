[{"id":"semetey-1-2013:p1028:b007:l002","ordinal":154625,"en":"Thinking, \"How will he attempt the crossing?"},{"id":"semetey-1-2013:p1028:b007:l003","ordinal":154626,"en":"If the enraged lion enters the Urgench"},{"id":"semetey-1-2013:p1028:b007:l004","ordinal":154627,"en":"Without heed,"},{"id":"semetey-1-2013:p1028:b007:l005","ordinal":154628,"en":"He may die there for nothing,\""},{"id":"semetey-1-2013:p1028:b007:l006","ordinal":154629,"en":"She uttered a cold incantation"},{"id":"semetey-1-2013:p1028:b007:l007","ordinal":154630,"en":"And worked magic upon the weather."},{"id":"semetey-1-2013:p1028:b007:l008","ordinal":154631,"en":"Clouds tore open in the sky,"},{"id":"semetey-1-2013:p1028:b007:l009","ordinal":154632,"en":"And over the mountains rising from the foothills,"}]
