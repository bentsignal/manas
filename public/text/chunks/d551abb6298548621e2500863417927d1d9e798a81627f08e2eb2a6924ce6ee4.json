[{"id":"semetey-1-2013:p0670:b003:l015","ordinal":127745,"en":"Riding their horses bareback."},{"id":"semetey-1-2013:p0670:b003:l016","ordinal":127746,"en":"When my father saw them from afar,"},{"id":"semetey-1-2013:p0670:b003:l017","ordinal":127747,"en":"They fled with a clatter."},{"id":"semetey-1-2013:p0670:b003:l018","ordinal":127748,"en":"Khan Azyz's Almambet,"},{"id":"semetey-1-2013:p0670:b003:l019","ordinal":127749,"en":"Mighty Bakai the Saint,"},{"id":"semetey-1-2013:p0670:b003:l020","ordinal":127750,"en":"And my father Manas, these three,"},{"id":"semetey-1-2013:p0670:b003:l021","ordinal":127751,"en":"Plundered and seized it as booty."},{"id":"semetey-1-2013:p0670:b003:l022","ordinal":127752,"en":"Ochogor when used in play,"},{"id":"semetey-1-2013:p0670:b003:l023","ordinal":127753,"en":"Koichagyr when used in earnest,"},{"id":"semetey-1-2013:p0670:b003:l024","ordinal":127754,"en":"When slung upon him, the dear thing"},{"id":"semetey-1-2013:p0670:b003:l025","ordinal":127755,"en":"Was the mirror upon his shoulder."},{"id":"semetey-1-2013:p0670:b003:l026","ordinal":127756,"en":"When turned against the attacking enemy,"},{"id":"semetey-1-2013:p0670:b003:l027","ordinal":127757,"en":"It was the solace of his entrusted soul."},{"id":"semetey-1-2013:p0670:b003:l028","ordinal":127758,"en":"Almabash, exceedingly keen,"},{"id":"semetey-1-2013:p0670:b003:l029","ordinal":127759,"en":"It would not fail for sixty days,"},{"id":"semetey-1-2013:p0670:b003:l030","ordinal":127760,"en":"Did not distinguish far from near."},{"id":"semetey-1-2013:p0670:b003:l031","ordinal":127761,"en":"From my magnanimous father Manas,"},{"id":"semetey-1-2013:p0670:b003:l032","ordinal":127762,"en":"Left in trust, Akkelte—"},{"id":"semetey-1-2013:p0670:b003:l033","ordinal":127763,"en":"Grandfather Zhakyp, where is it?"},{"id":"semetey-1-2013:p0670:b003:l034","ordinal":127764,"en":"Its keenness was known to the people."},{"id":"semetey-1-2013:p0670:b003:l035","ordinal":127765,"en":"The inheritance left by my peerless father,"},{"id":"semetey-1-2013:p0670:b003:l036","ordinal":127766,"en":"It was the weapon he chose to fire,"},{"id":"semetey-1-2013:p0670:b003:l037","ordinal":127767,"en":"Property left by the precious one."},{"id":"semetey-1-2013:p0670:b003:l038","ordinal":127768,"en":"Agree readily to what I say."},{"id":"semetey-1-2013:p0670:b003:l039","ordinal":127769,"en":"For me to carry as a gift,"},{"id":"semetey-1-2013:p0670:b004:l001","ordinal":127770,"en":"Give Akkelte to us."},{"id":"semetey-1-2013:p0670:b004:l002","ordinal":127771,"en":"There is another object too."},{"id":"semetey-1-2013:p0670:b004:l003","ordinal":127772,"en":"If you will not give it, Khan Zhakyp,"},{"id":"semetey-1-2013:p0670:b004:l004","ordinal":127773,"en":"My grandfather, dear as my own life,"},{"id":"semetey-1-2013:p0670:b004:l005","ordinal":127774,"en":"Terrible calamity awaits you."},{"id":"semetey-1-2013:p0670:b004:l006","ordinal":127775,"en":"The things left by Manas,"},{"id":"semetey-1-2013:p0670:b004:l007","ordinal":127776,"en":"Bring and give what I have named."},{"id":"semetey-1-2013:p0670:b004:l008","ordinal":127777,"en":"I followed the oral tradition,"},{"id":"semetey-1-2013:p0670:b004:l009","ordinal":127778,"en":"And about my father Manas's valor"},{"id":"semetey-1-2013:p0670:b004:l010","ordinal":127779,"en":"Asked those who knew."},{"id":"semetey-1-2013:p0670:b004:l011","ordinal":127780,"en":"When that father of mine died,"},{"id":"semetey-1-2013:p0670:b004:l012","ordinal":127781,"en":"The countless treasures left by Manas"},{"id":"semetey-1-2013:p0670:b004:l013","ordinal":127782,"en":"Your six sons plundered and divided."},{"id":"semetey-1-2013:p0670:b004:l014","ordinal":127783,"en":"Unable to keep possession of that wealth,"},{"id":"semetey-1-2013:p0670:b004:l015","ordinal":127784,"en":"My poor mother fled."},{"id":"semetey-1-2013:p0670:b004:l016","ordinal":127785,"en":"Suffering terrible humiliation,"},{"id":"semetey-1-2013:p0670:b004:l017","ordinal":127786,"en":"The poor woman was distraught."},{"id":"semetey-1-2013:p0670:b004:l018","ordinal":127787,"en":"Taken as booty, grandfather,"},{"id":"semetey-1-2013:p0670:b004:l019","ordinal":127788,"en":"My property remained with you."},{"id":"semetey-1-2013:p0670:b004:l020","ordinal":127789,"en":"Without dispute or quarrel,"},{"id":"semetey-1-2013:p0670:b004:l021","ordinal":127790,"en":"Agree to the words I say."},{"id":"semetey-1-2013:p0670:b004:l022","ordinal":127791,"en":"The wealth you kept as booty,"},{"id":"semetey-1-2013:p0670:b004:l023","ordinal":127792,"en":"I have grown now; give it back."},{"id":"semetey-1-2013:p0670:b004:l024","ordinal":127793,"en":"Long ago, at Kum-Bulak Pass,"},{"id":"semetey-1-2013:p0670:b004:l025","ordinal":127794,"en":"In the Mediyan desert,"},{"id":"semetey-1-2013:p0670:b004:l026","ordinal":127795,"en":"Where no soul traveled, where there was no water,"},{"id":"semetey-1-2013:p0670:b004:l027","ordinal":127796,"en":"On the vast still plain,"},{"id":"semetey-1-2013:p0670:b004:l028","ordinal":127797,"en":"My father Manas, the peerless lion,"},{"id":"semetey-1-2013:p0670:b004:l029","ordinal":127798,"en":"Wearing out horses, scouting the land,"},{"id":"semetey-1-2013:p0670:b004:l030","ordinal":127799,"en":"Loosing hounds and flying hawks,"},{"id":"semetey-1-2013:p0670:b004:l031","ordinal":127800,"en":"Roaming the land, watching the people,"},{"id":"semetey-1-2013:p0670:b004:l032","ordinal":127801,"en":"Gathering retainers, watching the country—"},{"id":"semetey-1-2013:p0670:b004:l033","ordinal":127802,"en":"When my accomplished father went there,"},{"id":"semetey-1-2013:p0670:b004:l034","ordinal":127803,"en":"God granted that they were encountered:"},{"id":"semetey-1-2013:p0670:b004:l035","ordinal":127804,"en":"For my wolf-maned lion father"},{"id":"semetey-1-2013:p0670:b004:l036","ordinal":127805,"en":"Six swords were found."},{"id":"semetey-1-2013:p0670:b004:l037","ordinal":127806,"en":"The finest of the swords,"},{"id":"semetey-1-2013:p0670:b004:l038","ordinal":127807,"en":"The one most suited to slaughter,"},{"id":"semetey-1-2013:p0670:b004:l039","ordinal":127808,"en":"My father took Zulpukor."},{"id":"semetey-1-2013:p0671:b003:l001","ordinal":127809,"en":"Khan Bakai's Oikuma,"},{"id":"semetey-1-2013:p0671:b003:l002","ordinal":127810,"en":"Azhibai's Achalbars,"},{"id":"semetey-1-2013:p0671:b003:l003","ordinal":127811,"en":"Almambet's Kylbolot,"},{"id":"semetey-1-2013:p0671:b003:l004","ordinal":127812,"en":"Zhoibolot taken by Chubak,"},{"id":"semetey-1-2013:p0671:b003:l006","ordinal":127813,"en":"Warrior Syrgak's Narkesken—","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0671:b003:l007","ordinal":127814,"en":"From my wolf-maned lion father,"},{"id":"semetey-1-2013:p0671:b003:l008","ordinal":127815,"en":"Six blades left in trust."},{"id":"semetey-1-2013:p0671:b003:l009","ordinal":127816,"en":"Long ago, my poor mother Kanykei,"},{"id":"semetey-1-2013:p0671:b003:l010","ordinal":127817,"en":"With spreading black mourning upon her head,"},{"id":"semetey-1-2013:p0671:b003:l011","ordinal":127818,"en":"Bereft of my father,"},{"id":"semetey-1-2013:p0671:b003:l013","ordinal":127819,"en":"At thirty-two years of age,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0671:b003:l014","ordinal":127820,"en":"Set her course toward Temir Khan."},{"id":"semetey-1-2013:p0671:b003:l015","ordinal":127821,"en":"Poor me, a babe in the cradle,"},{"id":"semetey-1-2013:p0671:b003:l016","ordinal":127822,"en":"She carried as she wandered to Bukhara."},{"id":"semetey-1-2013:p0671:b003:l017","ordinal":127823,"en":"The khan's wealth, his abundant property,"},{"id":"semetey-1-2013:p0671:b003:l018","ordinal":127824,"en":"Was scattered in turmoil."},{"id":"semetey-1-2013:p0671:b003:l019","ordinal":127825,"en":"Aiming sights and firing shots,"},{"id":"semetey-1-2013:p0671:b003:l020","ordinal":127826,"en":"Your six sons came and fell upon us."},{"id":"semetey-1-2013:p0671:b003:l021","ordinal":127827,"en":"To the widow and the orphan,"},{"id":"semetey-1-2013:p0671:b003:l022","ordinal":127828,"en":"You did whatever you pleased."},{"id":"semetey-1-2013:p0671:b003:l023","ordinal":127829,"en":"All the weapons of war"},{"id":"semetey-1-2013:p0671:b003:l024","ordinal":127830,"en":"Became booty."},{"id":"semetey-1-2013:p0671:b003:l025","ordinal":127831,"en":"Among all those things,"},{"id":"semetey-1-2013:p0671:b003:l026","ordinal":127832,"en":"The six blades remained in your hands."},{"id":"semetey-1-2013:p0671:b003:l027","ordinal":127833,"en":"The gifts left by my father,"},{"id":"semetey-1-2013:p0671:b003:l028","ordinal":127834,"en":"I have come to take; hand them over."},{"id":"semetey-1-2013:p0671:b003:l029","ordinal":127835,"en":"Long ago, Kanykei departed in mourning;"},{"id":"semetey-1-2013:p0671:b003:l030","ordinal":127836,"en":"Unable to bear your wrath,"},{"id":"semetey-1-2013:p0671:b003:l031","ordinal":127837,"en":"Semetey fled."},{"id":"semetey-1-2013:p0671:b003:l032","ordinal":127838,"en":"I plundered fine cloth and recovered."},{"id":"semetey-1-2013:p0671:b003:l033","ordinal":127839,"en":"Because of your mischief,"},{"id":"semetey-1-2013:p0671:b003:l034","ordinal":127840,"en":"I went to Bukhara and grew up."},{"id":"semetey-1-2013:p0671:b003:l035","ordinal":127841,"en":"I matured and became a man,"},{"id":"semetey-1-2013:p0671:b003:l036","ordinal":127842,"en":"Became the equal of other men's sons."},{"id":"semetey-1-2013:p0671:b003:l037","ordinal":127843,"en":"I lived an orphan and matured,"},{"id":"semetey-1-2013:p0671:b003:l038","ordinal":127844,"en":"Joined the ranks myself."},{"id":"semetey-1-2013:p0671:b003:l039","ordinal":127845,"en":"Hardened by drinking blood,"},{"id":"semetey-1-2013:p0671:b004:l001","ordinal":127846,"en":"This year I became known as bloodthirsty Semen."},{"id":"semetey-1-2013:p0671:b004:l002","ordinal":127847,"en":"Khan grandfather Zhakyp, hear this:"},{"id":"semetey-1-2013:p0671:b004:l003","ordinal":127848,"en":"Where are the herds left by my father?"},{"id":"semetey-1-2013:p0671:b004:l004","ordinal":127849,"en":"Where are the people left by magnanimous Manas?"},{"id":"semetey-1-2013:p0671:b004:l005","ordinal":127850,"en":"Come, grandfather, Khan Zhakyp,"},{"id":"semetey-1-2013:p0671:b004:l006","ordinal":127851,"en":"With a golden collar and bronze sleeves,"},{"id":"semetey-1-2013:p0671:b004:l007","ordinal":127852,"en":"Double mail with links like larks' eyes,"},{"id":"semetey-1-2013:p0671:b004:l008","ordinal":127853,"en":"A broad jacket and wide collar,"},{"id":"semetey-1-2013:p0671:b004:l009","ordinal":127854,"en":"My bloodthirsty leopard father"},{"id":"semetey-1-2013:p0671:b004:l010","ordinal":127855,"en":"Wore Akolpok in battle."},{"id":"semetey-1-2013:p0671:b004:l011","ordinal":127856,"en":"No bullet could pierce it in a firefight."},{"id":"semetey-1-2013:p0671:b004:l012","ordinal":127857,"en":"Its weft was exceptionally worked;"},{"id":"semetey-1-2013:p0671:b004:l013","ordinal":127858,"en":"Wearing it gladdened a person's heart."},{"id":"semetey-1-2013:p0671:b004:l014","ordinal":127859,"en":"Both padded armor and mail,"},{"id":"semetey-1-2013:p0671:b004:l015","ordinal":127860,"en":"Akolpok left by my father Manas,"},{"id":"semetey-1-2013:p0671:b004:l016","ordinal":127861,"en":"My poor, ill-fated mother Kanykei made it."},{"id":"semetey-1-2013:p0671:b004:l018","ordinal":127862,"en":"She twisted its weft sixfold,"},{"id":"semetey-1-2013:p0671:b004:l019","ordinal":127863,"en":"For the Great Campaign at Beijing,"},{"id":"semetey-1-2013:p0671:b004:l020","ordinal":127864,"en":"Intending it for that great slaughter."},{"id":"semetey-1-2013:p0671:b004:l021","ordinal":127865,"en":"Working it firmly with precious materials,"},{"id":"semetey-1-2013:p0671:b004:l022","ordinal":127866,"en":"She barely completed it in six years."},{"id":"semetey-1-2013:p0671:b004:l023","ordinal":127867,"en":"The shepherd of an entrusted life,"},{"id":"semetey-1-2013:p0671:b004:l024","ordinal":127868,"en":"There was no object like it."},{"id":"semetey-1-2013:p0671:b004:l025","ordinal":127869,"en":"Akolpok left by my father,"},{"id":"semetey-1-2013:p0671:b004:l026","ordinal":127870,"en":"It too seems to be in your hands."},{"id":"semetey-1-2013:p0671:b004:l027","ordinal":127871,"en":"Grandfather Zhakyp, give it back."},{"id":"semetey-1-2013:p0671:b004:l028","ordinal":127872,"en":"If you will not give the property I named,"},{"id":"semetey-1-2013:p0671:b004:l029","ordinal":127873,"en":"You are a wolf ready to tear me apart,"},{"id":"semetey-1-2013:p0671:b004:l030","ordinal":127874,"en":"The very embodiment of mischief."},{"id":"semetey-1-2013:p0671:b004:l031","ordinal":127875,"en":"Khan grandfather, you will see when I grow angry."},{"id":"semetey-1-2013:p0671:b004:l032","ordinal":127876,"en":"If you anger me again,"},{"id":"semetey-1-2013:p0671:b004:l033","ordinal":127877,"en":"Khan grandfather, you will die this instant."},{"id":"semetey-1-2013:p0671:b004:l034","ordinal":127878,"en":"For twelve years I did not see my people;"},{"id":"semetey-1-2013:p0671:b004:l035","ordinal":127879,"en":"I grew up wandering."},{"id":"semetey-1-2013:p0671:b004:l036","ordinal":127880,"en":"As soon as I come, you mix poison,"},{"id":"semetey-1-2013:p0671:b004:l037","ordinal":127881,"en":"And offer it upon my arrival."},{"id":"semetey-1-2013:p0671:b004:l038","ordinal":127882,"en":"Can there be a grandfather like you?"},{"id":"semetey-1-2013:p0671:b004:l039","ordinal":127883,"en":"You brought suffering upon my soul,"},{"id":"semetey-1-2013:p0672:b003:l001","ordinal":127884,"en":"Can anyone prosper who calls you father?"},{"id":"semetey-1-2013:p0672:b003:l002","ordinal":127885,"en":"Let me burn off your remaining hair,"},{"id":"semetey-1-2013:p0672:b003:l003","ordinal":127886,"en":"Pour in poison and see what happens"},{"id":"semetey-1-2013:p0672:b003:l004","ordinal":127887,"en":"To your head, my khan-father!”"},{"id":"semetey-1-2013:p0672:b003:l005","ordinal":127888,"en":"From blood-drinking, gray-maned Manas,"},{"id":"semetey-1-2013:p0672:b003:l006","ordinal":127889,"en":"Your dear one was born a blood-drinker."},{"id":"semetey-1-2013:p0672:b003:l007","ordinal":127890,"en":"Seizing the bowl, he said:"},{"id":"semetey-1-2013:p0672:b003:l008","ordinal":127891,"en":"“Wear your bowl on your head!"},{"id":"semetey-1-2013:p0672:b003:l009","ordinal":127892,"en":"I am not grateful at all"},{"id":"semetey-1-2013:p0672:b003:l010","ordinal":127893,"en":"For this food of yours steeped in poison.”"},{"id":"semetey-1-2013:p0672:b003:l011","ordinal":127894,"en":"He overturned the bowl"},{"id":"semetey-1-2013:p0672:b003:l012","ordinal":127895,"en":"On Khan Jakyp's head."},{"id":"semetey-1-2013:p0672:b003:l013","ordinal":127896,"en":"Then Jakyp's"},{"id":"semetey-1-2013:p0672:b003:l014","ordinal":127897,"en":"Hair burned with a hiss."},{"id":"semetey-1-2013:p0672:b003:l015","ordinal":127898,"en":"Did you see how strong the poison was?"},{"id":"semetey-1-2013:p0672:b003:l016","ordinal":127899,"en":"His beard and mustache"},{"id":"semetey-1-2013:p0672:b003:l017","ordinal":127900,"en":"Burned together, crackling."},{"id":"semetey-1-2013:p0672:b003:l018","ordinal":127901,"en":"His hair was gone; he was bald,"},{"id":"semetey-1-2013:p0672:b003:l019","ordinal":127902,"en":"Without mustache or beard."},{"id":"semetey-1-2013:p0672:b003:l020","ordinal":127903,"en":"Poor Khan Jakyp was dazed."},{"id":"semetey-1-2013:p0672:b003:l021","ordinal":127904,"en":"The skin of his head split;"},{"id":"semetey-1-2013:p0672:b003:l022","ordinal":127905,"en":"His dear boy Semetey grieved."},{"id":"semetey-1-2013:p0672:b003:l023","ordinal":127906,"en":"To cut Khan Jakyp down,"},{"id":"semetey-1-2013:p0672:b003:l024","ordinal":127907,"en":"The boy could not bring himself;"},{"id":"semetey-1-2013:p0672:b003:l029","ordinal":127908,"en":"The fool bore the name of “father.”","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0672:b003:l030","ordinal":127909,"en":"Unable to raise a hand against his father,"},{"id":"semetey-1-2013:p0672:b003:l031","ordinal":127910,"en":"Semetey was in turmoil."},{"id":"semetey-1-2013:p0672:b003:l032","ordinal":127911,"en":"Semetey's newly arriving—"},{"id":"semetey-1-2013:p0672:b003:l033","ordinal":127912,"en":"Jakyp's being half dead!"},{"id":"semetey-1-2013:p0672:b003:l034","ordinal":127913,"en":"Blood-drinking Bakai, the leopard,"},{"id":"semetey-1-2013:p0672:b003:l035","ordinal":127914,"en":"To Khan Jakyp's home"},{"id":"semetey-1-2013:p0672:b003:l036","ordinal":127915,"en":"Had come to see him."},{"id":"semetey-1-2013:p0672:b003:l037","ordinal":127916,"en":"While tiger Manas was alive,"},{"id":"semetey-1-2013:p0672:b003:l038","ordinal":127917,"en":"While he was Manas's companion,"},{"id":"semetey-1-2013:p0672:b003:l039","ordinal":127918,"en":"Beijing with its khakan—"},{"id":"semetey-1-2013:p0672:b003:l040","ordinal":127919,"en":"When they drove on to besiege it,"},{"id":"semetey-1-2013:p0672:b004:l001","ordinal":127920,"en":"When they spread havoc,"},{"id":"semetey-1-2013:p0672:b004:l002","ordinal":127921,"en":"Thrusting spears and breaking ranks,"},{"id":"semetey-1-2013:p0672:b004:l003","ordinal":127922,"en":"Those whose time had come fell to shots."},{"id":"semetey-1-2013:p0672:b004:l004","ordinal":127923,"en":"There were salt marshes to ford,"},{"id":"semetey-1-2013:p0672:b004:l005","ordinal":127924,"en":"There were great trenches dug,"},{"id":"semetey-1-2013:p0672:b004:l006","ordinal":127925,"en":"In swarming China, many ditches;"},{"id":"semetey-1-2013:p0672:b004:l007","ordinal":127926,"en":"Stirring it from the very roots,"},{"id":"semetey-1-2013:p0672:b004:l008","ordinal":127927,"en":"When they slaughtered its swarming people,"},{"id":"semetey-1-2013:p0672:b004:l009","ordinal":127928,"en":"Esen Khan's treasury—"},{"id":"semetey-1-2013:p0672:b004:l010","ordinal":127929,"en":"When the Kyrgyz took it as booty,"},{"id":"semetey-1-2013:p0672:b004:l011","ordinal":127930,"en":"Your dear Bakai, the gray-maned hero,"},{"id":"semetey-1-2013:p0672:b004:l012","ordinal":127931,"en":"To his friend, gray-maned Manas,"},{"id":"semetey-1-2013:p0672:b004:l013","ordinal":127932,"en":"The gray saddlebags he had offered—"},{"id":"semetey-1-2013:p0672:b004:l014","ordinal":127933,"en":"Among Khan Jakyp's stacked belongings"},{"id":"semetey-1-2013:p0672:b004:l015","ordinal":127934,"en":"They lay put away."},{"id":"semetey-1-2013:p0672:b004:l016","ordinal":127935,"en":"As soon as mighty Bakai saw them,"},{"id":"semetey-1-2013:p0672:b004:l017","ordinal":127936,"en":"The dear man grew sorrowful."},{"id":"semetey-1-2013:p0672:b004:l018","ordinal":127937,"en":"Inside those saddlebags,"},{"id":"semetey-1-2013:p0672:b004:l019","ordinal":127938,"en":"Rubies and gold were mixed."},{"id":"semetey-1-2013:p0672:b004:l020","ordinal":127939,"en":"“These saddlebags left by Manas!” he said,"},{"id":"semetey-1-2013:p0672:b004:l021","ordinal":127940,"en":"Clinging to them, refusing to let go."},{"id":"semetey-1-2013:p0672:b004:l022","ordinal":127941,"en":"“My possessions left by King Manas!” he said."},{"id":"semetey-1-2013:p0672:b004:l024","ordinal":127942,"en":"Bakai struggled with the gray saddlebags."},{"id":"semetey-1-2013:p0672:b004:l026","ordinal":127943,"en":"To take them away as booty"},{"id":"semetey-1-2013:p0672:b004:l027","ordinal":127944,"en":"Semetey set his mind."},{"id":"semetey-1-2013:p0672:b004:l028","ordinal":127945,"en":"When he saw those saddlebags,"},{"id":"semetey-1-2013:p0672:b004:l029","ordinal":127946,"en":"“My possessions left by my father!” he said."},{"id":"semetey-1-2013:p0672:b004:l031","ordinal":127947,"en":"Bakai and Semetey,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0672:b004:l032","ordinal":127948,"en":"Both taking hold of the saddlebags,"},{"id":"semetey-1-2013:p0672:b004:l033","ordinal":127949,"en":"To Kökcholok's side"},{"id":"semetey-1-2013:p0672:b004:l034","ordinal":127950,"en":"Dragged them out."},{"id":"semetey-1-2013:p0672:b004:l035","ordinal":127951,"en":"Bakai stood pleading,"},{"id":"semetey-1-2013:p0672:b004:l036","ordinal":127952,"en":"“Put them on Kökcholok!” he said,"},{"id":"semetey-1-2013:p0672:b004:l037","ordinal":127953,"en":"Begging Semetey."},{"id":"semetey-1-2013:p0672:b004:l038","ordinal":127954,"en":"Semetey, the gray-maned hero's son,"},{"id":"semetey-1-2013:p0672:b004:l039","ordinal":127955,"en":"Could not load those saddlebags;"},{"id":"semetey-1-2013:p0672:b004:l040","ordinal":127956,"en":"A curse on his childishness!"},{"id":"semetey-1-2013:p0673:b003:l001","ordinal":127957,"en":"He could not even move them."},{"id":"semetey-1-2013:p0673:b003:l002","ordinal":127958,"en":"Khan Bakai grew angry:"},{"id":"semetey-1-2013:p0673:b003:l003","ordinal":127959,"en":"“Children nowadays"},{"id":"semetey-1-2013:p0673:b003:l004","ordinal":127960,"en":"Drink butter dregs and shit grass."},{"id":"semetey-1-2013:p0673:b003:l005","ordinal":127961,"en":"When I was a boy in the old days,"},{"id":"semetey-1-2013:p0673:b003:l006","ordinal":127962,"en":"Unheeding, mad and drunk,"},{"id":"semetey-1-2013:p0673:b003:l007","ordinal":127963,"en":"I made white deer into cattle;"},{"id":"semetey-1-2013:p0673:b003:l008","ordinal":127964,"en":"I threw the whole world into turmoil."},{"id":"semetey-1-2013:p0673:b003:l009","ordinal":127965,"en":"Wearing armor no shot could pierce,"},{"id":"semetey-1-2013:p0673:b003:l010","ordinal":127966,"en":"Not saddlebags, wretched boy—"},{"id":"semetey-1-2013:p0673:b003:l011","ordinal":127967,"en":"I grappled with the whole world."},{"id":"semetey-1-2013:p0673:b003:l012","ordinal":127968,"en":"Children nowadays,"},{"id":"semetey-1-2013:p0673:b003:l013","ordinal":127969,"en":"May the damned brats perish!"},{"id":"semetey-1-2013:p0673:b003:l014","ordinal":127970,"en":"They have not the strength for saddlebags."},{"id":"semetey-1-2013:p0673:b003:l015","ordinal":127971,"en":"Barefoot and bareheaded,"},{"id":"semetey-1-2013:p0673:b003:l016","ordinal":127972,"en":"There was a time when the earth shook."},{"id":"semetey-1-2013:p0673:b003:l017","ordinal":127973,"en":"My dear youth has passed away."},{"id":"semetey-1-2013:p0673:b003:l018","ordinal":127974,"en":"When I was a boy like you,"},{"id":"semetey-1-2013:p0673:b003:l019","ordinal":127975,"en":"I would roast whoever challenged me."},{"id":"semetey-1-2013:p0673:b003:l020","ordinal":127976,"en":"Not saddlebags, wretched boy—"},{"id":"semetey-1-2013:p0673:b003:l021","ordinal":127977,"en":"A birch tree growing there,"},{"id":"semetey-1-2013:p0673:b003:l022","ordinal":127978,"en":"I would tear it out by the roots."},{"id":"semetey-1-2013:p0673:b003:l023","ordinal":127979,"en":"Until they reach twenty,"},{"id":"semetey-1-2013:p0673:b003:l024","ordinal":127980,"en":"Children nowadays"},{"id":"semetey-1-2013:p0673:b003:l025","ordinal":127981,"en":"Are still mere children, it seems."},{"id":"semetey-1-2013:p0673:b003:l026","ordinal":127982,"en":"One boiling still left within them,"},{"id":"semetey-1-2013:p0673:b003:l027","ordinal":127983,"en":"They are still half-cooked, it seems.”"},{"id":"semetey-1-2013:p0673:b003:l028","ordinal":127984,"en":"So saying these words,"},{"id":"semetey-1-2013:p0673:b003:l029","ordinal":127985,"en":"His elder Bakai worked himself up,"},{"id":"semetey-1-2013:p0673:b003:l030","ordinal":127986,"en":"And spoke at Semetey."},{"id":"semetey-1-2013:p0673:b003:l031","ordinal":127987,"en":"Seizing the saddlebags,"},{"id":"semetey-1-2013:p0673:b003:l032","ordinal":127988,"en":"Lion Bakai, the saint,"},{"id":"semetey-1-2013:p0673:b003:l033","ordinal":127989,"en":"Blessed by Khizir from his roots,"},{"id":"semetey-1-2013:p0673:b003:l034","ordinal":127990,"en":"A peerless wrestler, a saint,"},{"id":"semetey-1-2013:p0673:b003:l035","ordinal":127991,"en":"To Father Manas, the lord,"},{"id":"semetey-1-2013:p0673:b003:l036","ordinal":127992,"en":"The elder who had been a companion,"},{"id":"semetey-1-2013:p0673:b003:l037","ordinal":127993,"en":"Coughing with deep rumbles,"},{"id":"semetey-1-2013:p0673:b003:l038","ordinal":127994,"en":"The saddlebags left by Manas"},{"id":"semetey-1-2013:p0673:b003:l039","ordinal":127995,"en":"He lifted with one hand."},{"id":"semetey-1-2013:p0673:b005:l001","ordinal":127996,"en":"In anger he swung them away;"},{"id":"semetey-1-2013:p0673:b005:l002","ordinal":127997,"en":"Your unfortunate one, born capable,"},{"id":"semetey-1-2013:p0673:b005:l003","ordinal":127998,"en":"Threw them onto Kökcholok."},{"id":"semetey-1-2013:p0673:b005:l004","ordinal":127999,"en":"Pleading with the Creator,"},{"id":"semetey-1-2013:p0673:b005:l005","ordinal":128000,"en":"Those gray saddlebags there,"}]
