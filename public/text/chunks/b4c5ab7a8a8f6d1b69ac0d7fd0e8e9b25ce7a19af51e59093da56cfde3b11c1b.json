[{"id":"semetey-2-2013:p0006:b004:l030","ordinal":185601,"en":"Until the hero's pipe"},{"id":"semetey-2-2013:p0006:b004:l031","ordinal":185602,"en":"Lacked only five finger-widths of being full."},{"id":"semetey-2-2013:p0006:b004:l032","ordinal":185603,"en":"Striking Chinese flint and liver-stone,"},{"id":"semetey-2-2013:p0006:b004:l033","ordinal":185604,"en":"He made a spark and set an ember,"},{"id":"semetey-2-2013:p0006:b004:l034","ordinal":185605,"en":"And lit his pipe."},{"id":"semetey-2-2013:p0006:b004:l035","ordinal":185606,"en":"He sucked until it rumbled,"},{"id":"semetey-2-2013:p0006:b004:l036","ordinal":185607,"en":"Until his craving was satisfied."},{"id":"semetey-2-2013:p0006:b006:l001","ordinal":185608,"en":"When he let it go, it rumbled;"},{"id":"semetey-2-2013:p0006:b006:l002","ordinal":185609,"en":"The smoke from his pipe"},{"id":"semetey-2-2013:p0006:b006:l003","ordinal":185610,"en":"Billowed like the smoke of an army."},{"id":"semetey-2-2013:p0006:b006:l004","ordinal":185611,"en":"Algara beneath him—"},{"id":"semetey-2-2013:p0006:b006:l005","ordinal":185612,"en":"Did Algara not have"},{"id":"semetey-2-2013:p0006:b006:l006","ordinal":185613,"en":"Wings upon his flanks?"},{"id":"semetey-2-2013:p0006:b006:l007","ordinal":185614,"en":"This was the infidel's Black Horse."},{"id":"semetey-2-2013:p0006:b006:l008","ordinal":185615,"en":"Alööke's Kongurbai,"},{"id":"semetey-2-2013:p0006:b006:l009","ordinal":185616,"en":"Watching the guard and grieving over the road,"},{"id":"semetey-2-2013:p0006:b006:l010","ordinal":185617,"en":"As was always his custom—"},{"id":"semetey-2-2013:p0006:b006:l011","ordinal":185618,"en":"His tail was sparse and his mane scant;"},{"id":"semetey-2-2013:p0006:b006:l012","ordinal":185619,"en":"If he chased a kulan, it could not escape,"},{"id":"semetey-2-2013:p0006:b006:l013","ordinal":185620,"en":"He was skilled at pursuing an enemy."},{"id":"semetey-2-2013:p0006:b006:l014","ordinal":185621,"en":"Algara turned his head."},{"id":"semetey-2-2013:p0006:b006:l015","ordinal":185622,"en":"Shouting in anger,"},{"id":"semetey-2-2013:p0006:b006:l016","ordinal":185623,"en":"Kongurbai called Karagul."},{"id":"semetey-2-2013:p0006:b006:l017","ordinal":185624,"en":"Karagul came running,"},{"id":"semetey-2-2013:p0006:b006:l018","ordinal":185625,"en":"His knee bending to the ground;"},{"id":"semetey-2-2013:p0006:b006:l019","ordinal":185626,"en":"Before hero Kongurbai"},{"id":"semetey-2-2013:p0006:b006:l020","ordinal":185627,"en":"He bowed like a bride."},{"id":"semetey-2-2013:p0006:b006:l021","ordinal":185628,"en":"There was the dog's bloody name:"},{"id":"semetey-2-2013:p0006:b006:l022","ordinal":185629,"en":"When their chief came before them,"},{"id":"semetey-2-2013:p0006:b006:l023","ordinal":185630,"en":"It was the custom of the Chinese"},{"id":"semetey-2-2013:p0006:b006:l024","ordinal":185631,"en":"To bow like women."},{"id":"semetey-2-2013:p0006:b006:l025","ordinal":185632,"en":"Then Kongurbai"},{"id":"semetey-2-2013:p0006:b006:l026","ordinal":185633,"en":"Said this to Karagul,"},{"id":"semetey-2-2013:p0006:b006:l027","ordinal":185634,"en":"And at will spoke many horrors:"},{"id":"semetey-2-2013:p0006:b006:l028","ordinal":185635,"en":"“Your father's grave, Karagul!"},{"id":"semetey-2-2013:p0006:b006:l029","ordinal":185636,"en":"I reconnoitered the broad steppe and narrow road"},{"id":"semetey-2-2013:p0006:b006:l030","ordinal":185637,"en":"To their very ends;"},{"id":"semetey-2-2013:p0006:b006:l031","ordinal":185638,"en":"I went as far as"},{"id":"semetey-2-2013:p0006:b006:l032","ordinal":185639,"en":"The great and renowned Altai."},{"id":"semetey-2-2013:p0006:b006:l033","ordinal":185640,"en":"I made Algara's back sore"},{"id":"semetey-2-2013:p0006:b006:l034","ordinal":185641,"en":"And greatly pained my backside."},{"id":"semetey-2-2013:p0006:b006:l035","ordinal":185642,"en":"There was no cawing crow,"},{"id":"semetey-2-2013:p0006:b006:l036","ordinal":185643,"en":"No croaking raven,"},{"id":"semetey-2-2013:p0007:b003:l001","ordinal":185644,"en":"No vulture circles overhead;"},{"id":"semetey-2-2013:p0007:b003:l002","ordinal":185645,"en":"My leopard Karagul,"},{"id":"semetey-2-2013:p0007:b003:l003","ordinal":185646,"en":"There is none greater than me."},{"id":"semetey-2-2013:p0007:b003:l004","ordinal":185647,"en":"There is no boat upon the black water;"},{"id":"semetey-2-2013:p0007:b003:l005","ordinal":185648,"en":"While my splendid head remains,"},{"id":"semetey-2-2013:p0007:b003:l006","ordinal":185649,"en":"There is no one who can answer me back."},{"id":"semetey-2-2013:p0007:b003:l007","ordinal":185650,"en":"There is no boat upon the crosswise water;"},{"id":"semetey-2-2013:p0007:b003:l008","ordinal":185651,"en":"While my falcon head remains,"},{"id":"semetey-2-2013:p0007:b003:l009","ordinal":185652,"en":"There is no one who can equal me."},{"id":"semetey-2-2013:p0007:b003:l010","ordinal":185653,"en":"My argali lies upon my mountain pass,"},{"id":"semetey-2-2013:p0007:b003:l011","ordinal":185654,"en":"My duck lies upon my lake."},{"id":"semetey-2-2013:p0007:b003:l012","ordinal":185655,"en":"My fox lies, Karagul,"},{"id":"semetey-2-2013:p0007:b003:l013","ordinal":185656,"en":"Where I placed it in safekeeping."},{"id":"semetey-2-2013:p0007:b003:l014","ordinal":185657,"en":"Great Beijing is a wondrous city—"},{"id":"semetey-2-2013:p0007:b003:l015","ordinal":185658,"en":"I traveled to its farthest edge;"},{"id":"semetey-2-2013:p0007:b003:l016","ordinal":185659,"en":"All Beijing is an ancient city—"},{"id":"semetey-2-2013:p0007:b003:l017","ordinal":185660,"en":"I traveled to its very foundation."},{"id":"semetey-2-2013:p0007:b003:l018","ordinal":185661,"en":"Giving Algara no rest,"},{"id":"semetey-2-2013:p0007:b003:l019","ordinal":185662,"en":"I, a renowned great noble,"},{"id":"semetey-2-2013:p0007:b003:l020","ordinal":185663,"en":"Came roaming back from the Kakan."},{"id":"semetey-2-2013:p0007:b003:l021","ordinal":185664,"en":"No pass remains that I have not crossed,"},{"id":"semetey-2-2013:p0007:b003:l022","ordinal":185665,"en":"No land remains that I have not trodden;"},{"id":"semetey-2-2013:p0007:b003:l023","ordinal":185666,"en":"Crossing passes and treading stones,"},{"id":"semetey-2-2013:p0007:b003:l024","ordinal":185667,"en":"Algara grew lean,"},{"id":"semetey-2-2013:p0007:b003:l025","ordinal":185668,"en":"His manifest blood thickened,"},{"id":"semetey-2-2013:p0007:b003:l026","ordinal":185669,"en":"And Algara grew old."},{"id":"semetey-2-2013:p0007:b003:l027","ordinal":185670,"en":"I traveled through many lands;"},{"id":"semetey-2-2013:p0007:b003:l028","ordinal":185671,"en":"There is no gray, ridged mountain left,"},{"id":"semetey-2-2013:p0007:b003:l029","ordinal":185672,"en":"And no enemy left to face me."},{"id":"semetey-2-2013:p0007:b003:l030","ordinal":185673,"en":"No foe remains for me to grapple with;"},{"id":"semetey-2-2013:p0007:b003:l031","ordinal":185674,"en":"I will turn Algara loose—"},{"id":"semetey-2-2013:p0007:b003:l032","ordinal":185675,"en":"Let him grow stout, with no regret."},{"id":"semetey-2-2013:p0007:b003:l033","ordinal":185676,"en":"In winter, take the horses"},{"id":"semetey-2-2013:p0007:b003:l034","ordinal":185677,"en":"Up to Kyr-Kayyn to winter."},{"id":"semetey-2-2013:p0007:b003:l035","ordinal":185678,"en":"For every horse herder,"},{"id":"semetey-2-2013:p0007:b003:l036","ordinal":185679,"en":"Have marmot fur sewn upon his shoulders."},{"id":"semetey-2-2013:p0007:b003:l037","ordinal":185680,"en":"When autumn comes,"},{"id":"semetey-2-2013:p0007:b003:l038","ordinal":185681,"en":"Graze them in autumn at gray Kürpüldök;"},{"id":"semetey-2-2013:p0007:b003:l039","ordinal":185682,"en":"When spring comes,"},{"id":"semetey-2-2013:p0007:b005:l001","ordinal":185683,"en":"Drive them along the Sary-Suu!"},{"id":"semetey-2-2013:p0007:b005:l002","ordinal":185684,"en":"Great Lord Khan Kongurbai—"},{"id":"semetey-2-2013:p0007:b005:l003","ordinal":185685,"en":"Have you heard,"},{"id":"semetey-2-2013:p0007:b005:l004","ordinal":185686,"en":"Worthy lord, of the deeds I have done?"},{"id":"semetey-2-2013:p0007:b005:l005","ordinal":185687,"en":"My brow is high and my venom strong;"},{"id":"semetey-2-2013:p0007:b005:l006","ordinal":185688,"en":"While my splendid life remains,"},{"id":"semetey-2-2013:p0007:b005:l007","ordinal":185689,"en":"I will straighten out anyone who challenges me!"},{"id":"semetey-2-2013:p0007:b005:l008","ordinal":185690,"en":"Will anyone approach and escape me?"},{"id":"semetey-2-2013:p0007:b005:l009","ordinal":185691,"en":"Will one who meets me pass without dying?"},{"id":"semetey-2-2013:p0007:b005:l010","ordinal":185692,"en":"Beneath me is Algara;"},{"id":"semetey-2-2013:p0007:b005:l011","ordinal":185693,"en":"I possess my courser Algara—"},{"id":"semetey-2-2013:p0007:b005:l012","ordinal":185694,"en":"Will one who fights me remain alive?"},{"id":"semetey-2-2013:p0007:b005:l013","ordinal":185695,"en":"While my splendid life remains,"},{"id":"semetey-2-2013:p0007:b005:l014","ordinal":185696,"en":"Will anyone come swarming against me?"},{"id":"semetey-2-2013:p0007:b005:l015","ordinal":185697,"en":"Will a man grapple with me and win?"},{"id":"semetey-2-2013:p0007:b005:l016","ordinal":185698,"en":"Will any doomed man come before me?"},{"id":"semetey-2-2013:p0007:b005:l017","ordinal":185699,"en":"Will he bend me and take me captive?"},{"id":"semetey-2-2013:p0007:b005:l018","ordinal":185700,"en":"Will one who wrestles with me remain alive?"},{"id":"semetey-2-2013:p0007:b005:l019","ordinal":185701,"en":"My saddlecloth is made of leather;"},{"id":"semetey-2-2013:p0007:b005:l020","ordinal":185702,"en":"Known throughout this world"},{"id":"semetey-2-2013:p0007:b005:l021","ordinal":185703,"en":"Is my valor, Kongurbai’s valor!"},{"id":"semetey-2-2013:p0007:b005:l022","ordinal":185704,"en":"Yesterday—have you heard?"},{"id":"semetey-2-2013:p0007:b005:l023","ordinal":185705,"en":"When chaos broke loose,"},{"id":"semetey-2-2013:p0007:b005:l024","ordinal":185706,"en":"When the Bloodthirsty One came"},{"id":"semetey-2-2013:p0007:b005:l025","ordinal":185707,"en":"And wrested away the khanate of Beijing,"},{"id":"semetey-2-2013:p0007:b005:l026","ordinal":185708,"en":"When his undertaking reached Beijing,"},{"id":"semetey-2-2013:p0007:b005:l027","ordinal":185709,"en":"Untouched even by Alexander,"},{"id":"semetey-2-2013:p0007:b005:l028","ordinal":185710,"en":"When he took countless riches and girls"},{"id":"semetey-2-2013:p0007:b005:l029","ordinal":185711,"en":"As plunder,"},{"id":"semetey-2-2013:p0007:b005:l030","ordinal":185712,"en":"When he ravaged the throne,"},{"id":"semetey-2-2013:p0007:b005:l031","ordinal":185713,"en":"And slaughtered many heroes,"},{"id":"semetey-2-2013:p0007:b005:l032","ordinal":185714,"en":"Dust rose from his advance"},{"id":"semetey-2-2013:p0007:b005:l033","ordinal":185715,"en":"And souls fled at the sound of him."},{"id":"semetey-2-2013:p0007:b005:l034","ordinal":185716,"en":"In his fury, Khan Manas"},{"id":"semetey-2-2013:p0007:b005:l035","ordinal":185717,"en":"Drained the people of the Kakan;"},{"id":"semetey-2-2013:p0007:b005:l036","ordinal":185718,"en":"That Bloodthirsty One whose home burned"},{"id":"semetey-2-2013:p0007:b005:l037","ordinal":185719,"en":"At last died by my own hand."},{"id":"semetey-2-2013:p0007:b005:l038","ordinal":185720,"en":"Infidel and Muslim"},{"id":"semetey-2-2013:p0007:b005:l039","ordinal":185721,"en":"Stood their ground and fought,"},{"id":"semetey-2-2013:p0008:b003:l001","ordinal":185722,"en":"When hero Kozhozhash, the great marksman,"},{"id":"semetey-2-2013:p0008:b003:l002","ordinal":185723,"en":"Performed immeasurable feats of valor,"},{"id":"semetey-2-2013:p0008:b003:l003","ordinal":185724,"en":"When Almambet and Chubak,"},{"id":"semetey-2-2013:p0008:b003:l004","ordinal":185725,"en":"Baichoro and Syrgak,"},{"id":"semetey-2-2013:p0008:b003:l005","ordinal":185726,"en":"Were all slaughtered in succession,"},{"id":"semetey-2-2013:p0008:b003:l006","ordinal":185727,"en":"When Akkula fell to a bullet,"},{"id":"semetey-2-2013:p0008:b003:l007","ordinal":185728,"en":"And yesterday, when Almambet died a martyr,"},{"id":"semetey-2-2013:p0008:b003:l008","ordinal":185729,"en":"The blood-drinking Bloodthirsty One"},{"id":"semetey-2-2013:p0008:b003:l009","ordinal":185730,"en":"Lifted his saddle and tack"},{"id":"semetey-2-2013:p0008:b003:l010","ordinal":185731,"en":"And was left on foot in the field."},{"id":"semetey-2-2013:p0008:b003:l011","ordinal":185732,"en":"The lion’s courage at the edge of death—"},{"id":"semetey-2-2013:p0008:b003:l012","ordinal":185733,"en":"The courage of that desperate"},{"id":"semetey-2-2013:p0008:b003:l013","ordinal":185734,"en":"Burut doomed to die—"},{"id":"semetey-2-2013:p0008:b003:l014","ordinal":185735,"en":"Was shown then."},{"id":"semetey-2-2013:p0008:b003:l015","ordinal":185736,"en":"His rage began in earnest;"},{"id":"semetey-2-2013:p0008:b003:l016","ordinal":185737,"en":"Beginning with Kozhozhash,"},{"id":"semetey-2-2013:p0008:b003:l017","ordinal":185738,"en":"He shot down eight"},{"id":"semetey-2-2013:p0008:b003:l018","ordinal":185739,"en":"Of the treasury marksmen."},{"id":"semetey-2-2013:p0008:b003:l019","ordinal":185740,"en":"Gathering courage and making ready,"},{"id":"semetey-2-2013:p0008:b003:l020","ordinal":185741,"en":"Six thousand Chinese and countless kaldais"},{"id":"semetey-2-2013:p0008:b003:l021","ordinal":185742,"en":"Drew bows like pouring rain"},{"id":"semetey-2-2013:p0008:b003:l022","ordinal":185743,"en":"And shot arrows like hail;"},{"id":"semetey-2-2013:p0008:b003:l023","ordinal":185744,"en":"With my splendid self at their head,"},{"id":"semetey-2-2013:p0008:b003:l024","ordinal":185745,"en":"We made ready and closed in to seize him."},{"id":"semetey-2-2013:p0008:b003:l025","ordinal":185746,"en":"Then powder spilled from his powder flask;"},{"id":"semetey-2-2013:p0008:b003:l026","ordinal":185747,"en":"He despaired of his grieving life,"},{"id":"semetey-2-2013:p0008:b003:l027","ordinal":185748,"en":"Stepped ponderously and braced himself,"},{"id":"semetey-2-2013:p0008:b003:l028","ordinal":185749,"en":"Leaned upon Akkelte,"},{"id":"semetey-2-2013:p0008:b003:l029","ordinal":185750,"en":"And that Bloodthirsty One stood there."},{"id":"semetey-2-2013:p0008:b003:l030","ordinal":185751,"en":"Before one could say this or that,"},{"id":"semetey-2-2013:p0008:b003:l031","ordinal":185752,"en":"In the blink of an eye,"},{"id":"semetey-2-2013:p0008:b003:l032","ordinal":185753,"en":"Riding a horse like a blue courser,"},{"id":"semetey-2-2013:p0008:b003:l033","ordinal":185754,"en":"Wearing a blue lynx-fur cap,"},{"id":"semetey-2-2013:p0008:b003:l034","ordinal":185755,"en":"His gray-wolf companion Bakai,"},{"id":"semetey-2-2013:p0008:b003:l035","ordinal":185756,"en":"The Bloodthirsty One’s true confidant,"},{"id":"semetey-2-2013:p0008:b003:l036","ordinal":185757,"en":"Opened the great slaughter."},{"id":"semetey-2-2013:p0008:b003:l037","ordinal":185758,"en":"Before one could say this or that,"},{"id":"semetey-2-2013:p0008:b003:l038","ordinal":185759,"en":"In the blink of an eye,"},{"id":"semetey-2-2013:p0008:b003:l039","ordinal":185760,"en":"He put the six thousand Chinese and countless kaldais"},{"id":"semetey-2-2013:p0008:b003:l040","ordinal":185761,"en":"All to the sword and slaughtered them."},{"id":"semetey-2-2013:p0008:b005:l001","ordinal":185762,"en":"He revealed his might;"},{"id":"semetey-2-2013:p0008:b005:l002","ordinal":185763,"en":"Then mighty Bakai"},{"id":"semetey-2-2013:p0008:b005:l003","ordinal":185764,"en":"Mounted the champion Manas,"},{"id":"semetey-2-2013:p0008:b005:l004","ordinal":185765,"en":"The Bloodthirsty One, upon Arbuurul."},{"id":"semetey-2-2013:p0008:b005:l005","ordinal":185766,"en":"His eyes blazed like fire;"},{"id":"semetey-2-2013:p0008:b005:l006","ordinal":185767,"en":"The bloodlust truly seized"},{"id":"semetey-2-2013:p0008:b005:l007","ordinal":185768,"en":"The accursed Burut,"},{"id":"semetey-2-2013:p0008:b005:l008","ordinal":185769,"en":"And his rage began in earnest."},{"id":"semetey-2-2013:p0008:b005:l009","ordinal":185770,"en":"He utterly slaughtered"},{"id":"semetey-2-2013:p0008:b005:l010","ordinal":185771,"en":"The Chinese as numerous as stones."},{"id":"semetey-2-2013:p0008:b005:l011","ordinal":185772,"en":"In the battle that day,"},{"id":"semetey-2-2013:p0008:b005:l012","ordinal":185773,"en":"The mighty men in armor died,"},{"id":"semetey-2-2013:p0008:b005:l013","ordinal":185774,"en":"And the stone-countless host was wiped out."},{"id":"semetey-2-2013:p0008:b005:l014","ordinal":185775,"en":"He mounted Taibuurul"},{"id":"semetey-2-2013:p0008:b005:l015","ordinal":185776,"en":"And drove the teeming Chinese"},{"id":"semetey-2-2013:p0008:b005:l016","ordinal":185777,"en":"As far as the Kakan."},{"id":"semetey-2-2013:p0008:b005:l017","ordinal":185778,"en":"His rage began in earnest;"},{"id":"semetey-2-2013:p0008:b005:l018","ordinal":185779,"en":"Of the tightly barred gates,"},{"id":"semetey-2-2013:p0008:b005:l019","ordinal":185780,"en":"He smashed five at once"},{"id":"semetey-2-2013:p0008:b005:l020","ordinal":185781,"en":"And demolished them completely."},{"id":"semetey-2-2013:p0008:b005:l021","ordinal":185782,"en":"When the Bloodthirsty One withdrew,"},{"id":"semetey-2-2013:p0008:b005:l022","ordinal":185783,"en":"I reconnoitered the road behind him;"},{"id":"semetey-2-2013:p0008:b005:l023","ordinal":185784,"en":"I deliberately stayed and stalked him."},{"id":"semetey-2-2013:p0008:b005:l024","ordinal":185785,"en":"Azhybai, whom he posted as lookout,"},{"id":"semetey-2-2013:p0008:b005:l025","ordinal":185786,"en":"Had fallen into a deep sleep;"},{"id":"semetey-2-2013:p0008:b005:l026","ordinal":185787,"en":"I went straight toward him"},{"id":"semetey-2-2013:p0008:b005:l027","ordinal":185788,"en":"And struck the thick shaft"},{"id":"semetey-2-2013:p0008:b005:l028","ordinal":185789,"en":"Hard against solid bone as I passed."},{"id":"semetey-2-2013:p0008:b005:l029","ordinal":185790,"en":"My spear reached him,"},{"id":"semetey-2-2013:p0008:b005:l030","ordinal":185791,"en":"And he went away wounded."},{"id":"semetey-2-2013:p0008:b005:l031","ordinal":185792,"en":"Concealing his wound without speaking,"},{"id":"semetey-2-2013:p0008:b005:l032","ordinal":185793,"en":"The Bloodthirsty One let it fester and died, they say."},{"id":"semetey-2-2013:p0008:b005:l033","ordinal":185794,"en":"His own kin turned hostile,"},{"id":"semetey-2-2013:p0008:b005:l034","ordinal":185795,"en":"And divided his possessions"},{"id":"semetey-2-2013:p0008:b005:l035","ordinal":185796,"en":"In the hands of the orphaned child, they say."},{"id":"semetey-2-2013:p0008:b005:l036","ordinal":185797,"en":"That bitch Kanykei of old"},{"id":"semetey-2-2013:p0008:b005:l037","ordinal":185798,"en":"Carried him away along the border,"},{"id":"semetey-2-2013:p0008:b005:l038","ordinal":185799,"en":"And scattered much of her wealth, they say."},{"id":"semetey-2-2013:p0009:b003:l001","ordinal":185800,"en":"Carrying her child upon her back,"},{"id":"semetey-2-2013:p0009:b003:l002","ordinal":185801,"en":"She fled toward Karakhan, they say."},{"id":"semetey-2-2013:p0009:b003:l003","ordinal":185802,"en":"Into the city of Khan Temir"},{"id":"semetey-2-2013:p0009:b003:l004","ordinal":185803,"en":"She wandered and disappeared, they say;"},{"id":"semetey-2-2013:p0009:b003:l005","ordinal":185804,"en":"Into the city of Karakhan"},{"id":"semetey-2-2013:p0009:b003:l006","ordinal":185805,"en":"She fled and disappeared, they say."},{"id":"semetey-2-2013:p0009:b003:l007","ordinal":185806,"en":"Thus bereaved Kanykei departed,"},{"id":"semetey-2-2013:p0009:b003:l008","ordinal":185807,"en":"And Semetey fled away."},{"id":"semetey-2-2013:p0009:b003:l009","ordinal":185808,"en":"Living as an orphan, he grew to manhood,"},{"id":"semetey-2-2013:p0009:b003:l010","ordinal":185809,"en":"Joined the people of the land,"},{"id":"semetey-2-2013:p0009:b003:l011","ordinal":185810,"en":"Grew broad and vigorous, and became a hero,"},{"id":"semetey-2-2013:p0009:b003:l012","ordinal":185811,"en":"The equal of any hero’s son."},{"id":"semetey-2-2013:p0009:b003:l013","ordinal":185812,"en":"He came and settled in Talas, they say,"},{"id":"semetey-2-2013:p0009:b003:l014","ordinal":185813,"en":"And became manifestly a gray wolf"},{"id":"semetey-2-2013:p0009:b003:l015","ordinal":185814,"en":"Far surpassing his father, they say."},{"id":"semetey-2-2013:p0009:b003:l016","ordinal":185815,"en":"I heard he settled in Talas,"},{"id":"semetey-2-2013:p0009:b003:l017","ordinal":185816,"en":"At shrub-filled Keng-Kol."},{"id":"semetey-2-2013:p0009:b003:l018","ordinal":185817,"en":"I heard the Bloodthirsty One’s son Semetey"},{"id":"semetey-2-2013:p0009:b003:l019","ordinal":185818,"en":"Sucked dry"},{"id":"semetey-2-2013:p0009:b003:l020","ordinal":185819,"en":"Whoever offered resistance."},{"id":"semetey-2-2013:p0009:b003:l021","ordinal":185820,"en":"He emerged a greater hero than his father,"},{"id":"semetey-2-2013:p0009:b003:l022","ordinal":185821,"en":"A lion who convulsed the world;"},{"id":"semetey-2-2013:p0009:b003:l023","ordinal":185822,"en":"His name is heard scorching the earth."},{"id":"semetey-2-2013:p0009:b003:l024","ordinal":185823,"en":"I received it from the transmitters of tradition"},{"id":"semetey-2-2013:p0009:b003:l025","ordinal":185824,"en":"And asked those who knew."},{"id":"semetey-2-2013:p0009:b003:l026","ordinal":185825,"en":"I heard that orphan did as he pleased"},{"id":"semetey-2-2013:p0009:b003:l027","ordinal":185826,"en":"To every one"},{"id":"semetey-2-2013:p0009:b003:l028","ordinal":185827,"en":"Who challenged him."},{"id":"semetey-2-2013:p0009:b003:l029","ordinal":185828,"en":"I heard he cut down"},{"id":"semetey-2-2013:p0009:b003:l030","ordinal":185829,"en":"Anyone who crossed his path."},{"id":"semetey-2-2013:p0009:b003:l031","ordinal":185830,"en":"I fear that accursed one,"},{"id":"semetey-2-2013:p0009:b003:l032","ordinal":185831,"en":"For they say that orphan is coming;"},{"id":"semetey-2-2013:p0009:b003:l033","ordinal":185832,"en":"They say he will gird his waist firmly"},{"id":"semetey-2-2013:p0009:b003:l034","ordinal":185833,"en":"And pursue Manas’s blood-price"},{"id":"semetey-2-2013:p0009:b003:l035","ordinal":185834,"en":"From us who dwell in Beijing."},{"id":"semetey-2-2013:p0009:b003:l036","ordinal":185835,"en":"They say the misbegotten son is coming,"},{"id":"semetey-2-2013:p0009:b003:l037","ordinal":185836,"en":"Gathering troops and assembling an army."},{"id":"semetey-2-2013:p0009:b003:l038","ordinal":185837,"en":"They say he will bring distress upon Beijing."},{"id":"semetey-2-2013:p0009:b003:l039","ordinal":185838,"en":"Whether alive or dead,"},{"id":"semetey-2-2013:p0009:b006:l001","ordinal":185839,"en":"That splendid man and I"},{"id":"semetey-2-2013:p0009:b006:l002","ordinal":185840,"en":"Will face one another, they say."},{"id":"semetey-2-2013:p0009:b006:l003","ordinal":185841,"en":"I hear reports from messengers;"},{"id":"semetey-2-2013:p0009:b006:l004","ordinal":185842,"en":"I hear that champion, son of the Bloodthirsty One,"},{"id":"semetey-2-2013:p0009:b006:l005","ordinal":185843,"en":"Will not refrain from challenging us."},{"id":"semetey-2-2013:p0009:b006:l006","ordinal":185844,"en":"They say he is a valiant man who will clash;"},{"id":"semetey-2-2013:p0009:b006:l007","ordinal":185845,"en":"If his strength suffices, they say,"},{"id":"semetey-2-2013:p0009:b006:l008","ordinal":185846,"en":"He will battle even the Kakan."},{"id":"semetey-2-2013:p0009:b006:l009","ordinal":185847,"en":"I heard he surpasses"},{"id":"semetey-2-2013:p0009:b006:l010","ordinal":185848,"en":"His father Manas, the gray wolf."},{"id":"semetey-2-2013:p0009:b006:l011","ordinal":185849,"en":"I heard he does whatever he pleases"},{"id":"semetey-2-2013:p0009:b006:l012","ordinal":185850,"en":"In the land where he rules."},{"id":"semetey-2-2013:p0009:b006:l013","ordinal":185851,"en":"When his wrath was roused,"},{"id":"semetey-2-2013:p0009:b006:l014","ordinal":185852,"en":"I heard he slaughtered them all,"},{"id":"semetey-2-2013:p0009:b006:l015","ordinal":185853,"en":"Beginning with his own father, Khan Zhakyp."},{"id":"semetey-2-2013:p0009:b006:l016","ordinal":185854,"en":"With no soul left to protest,"},{"id":"semetey-2-2013:p0009:b006:l017","ordinal":185855,"en":"I heard a hero had arisen—"},{"id":"semetey-2-2013:p0009:b006:l018","ordinal":185856,"en":"An infidel fiercer"}]
