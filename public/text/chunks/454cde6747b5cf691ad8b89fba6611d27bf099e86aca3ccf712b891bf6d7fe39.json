[{"id":"seytek-2012:p0933:b002:l011","ordinal":368385,"en":"When their numbers overwhelmed her,"},{"id":"seytek-2012:p0933:b002:l012","ordinal":368386,"en":"The earth was churned into dust,"},{"id":"seytek-2012:p0933:b002:l013","ordinal":368387,"en":"As they closed in and encircled her,"},{"id":"seytek-2012:p0933:b002:l014","ordinal":368388,"en":"The ground sagged beneath the massed host,"},{"id":"seytek-2012:p0933:b002:l015","ordinal":368389,"en":"The maiden Kuyaly, the champion,"},{"id":"seytek-2012:p0933:b002:l016","ordinal":368390,"en":"As they were about to trap her in their midst,"},{"id":"seytek-2012:p0933:b002:l017","ordinal":368391,"en":"A roar arose upon their flank,"},{"id":"seytek-2012:p0933:b002:l018","ordinal":368392,"en":"A clamor splitting the sky,"},{"id":"seytek-2012:p0933:b002:l019","ordinal":368393,"en":"His warriors and lions,"},{"id":"seytek-2012:p0933:b002:l020","ordinal":368394,"en":"His champions and heroes,"},{"id":"seytek-2012:p0933:b002:l021","ordinal":368395,"en":"Those most skillful with the spear,"},{"id":"seytek-2012:p0933:b002:l022","ordinal":368396,"en":"Those strongest at devising stratagems,"},{"id":"seytek-2012:p0933:b002:l023","ordinal":368397,"en":"Brave Seytek, the hero’s son,"},{"id":"seytek-2012:p0933:b002:l024","ordinal":368398,"en":"Was coming forth with his chosen men,"},{"id":"seytek-2012:p0933:b002:l025","ordinal":368399,"en":"The swiftest fierce as ogres,"},{"id":"seytek-2012:p0933:b002:l026","ordinal":368400,"en":"Swooping like hawks upon their targets,"},{"id":"seytek-2012:p0933:b002:l027","ordinal":368401,"en":"Brave Seytek, the hero’s son,"},{"id":"seytek-2012:p0933:b002:l028","ordinal":368402,"en":"Was driving them forward."},{"id":"seytek-2012:p0933:b002:l029","ordinal":368403,"en":"Stretching out all who faced him,"},{"id":"seytek-2012:p0933:b002:l030","ordinal":368404,"en":"He came steadily onward."},{"id":"seytek-2012:p0933:b002:l031","ordinal":368405,"en":"“If fate has come, I shall die,” he said,"},{"id":"seytek-2012:p0933:b002:l032","ordinal":368406,"en":"“For the champion maiden Kuyaly,"},{"id":"seytek-2012:p0933:b002:l033","ordinal":368407,"en":"I shall stand as her protector,” he said,"},{"id":"seytek-2012:p0933:b002:l034","ordinal":368408,"en":"Brave Seytek, son of the lion,"},{"id":"seytek-2012:p0933:b002:l035","ordinal":368409,"en":"Drove back all who crowded upon him,"},{"id":"seytek-2012:p0933:b002:l036","ordinal":368410,"en":"Spearing heroes on the slope,"},{"id":"seytek-2012:p0933:b002:l037","ordinal":368411,"en":"Piercing many in succession,"},{"id":"seytek-2012:p0933:b002:l038","ordinal":368412,"en":"His spears split the army apart."},{"id":"seytek-2012:p0933:b002:l039","ordinal":368413,"en":"By the time the hero’s son arrived,"},{"id":"seytek-2012:p0933:b002:l040","ordinal":368414,"en":"Broad in spirit as Talas,"},{"id":"seytek-2012:p0933:b003:l001","ordinal":368415,"en":"In stature the image of Manas,"},{"id":"seytek-2012:p0933:b003:l002","ordinal":368416,"en":"In judgment the equal of Koshoy,"},{"id":"seytek-2012:p0933:b003:l003","ordinal":368417,"en":"Charging like a wild boar,"},{"id":"seytek-2012:p0933:b003:l004","ordinal":368418,"en":"The way he cleaved through their ranks"},{"id":"seytek-2012:p0933:b003:l005","ordinal":368419,"en":"Was like a winter blizzard."},{"id":"seytek-2012:p0933:b003:l006","ordinal":368420,"en":"Terrified at the sight of this,"},{"id":"seytek-2012:p0933:b003:l007","ordinal":368421,"en":"Sarybay, son of an ogre,"},{"id":"seytek-2012:p0933:b003:l008","ordinal":368422,"en":"Found no deep grave in which to hide,"},{"id":"seytek-2012:p0933:b003:l009","ordinal":368423,"en":"No friendly host to flee toward,"},{"id":"seytek-2012:p0933:b003:l010","ordinal":368424,"en":"As the dark army poured in,"},{"id":"seytek-2012:p0933:b003:l011","ordinal":368425,"en":"That was how they faced one another."},{"id":"seytek-2012:p0933:b003:l012","ordinal":368426,"en":"Standing face-to-face,"},{"id":"seytek-2012:p0933:b003:l013","ordinal":368427,"en":"Firing guns and drawing bows,"},{"id":"seytek-2012:p0933:b003:l014","ordinal":368428,"en":"They fought with wet, crushing blows,"},{"id":"seytek-2012:p0933:b003:l015","ordinal":368429,"en":"Clashing their spears,"},{"id":"seytek-2012:p0933:b003:l016","ordinal":368430,"en":"Raising a fearsome tumult,"},{"id":"seytek-2012:p0933:b003:l017","ordinal":368431,"en":"The armies met and uproar rose,"},{"id":"seytek-2012:p0933:b003:l018","ordinal":368432,"en":"Host crashed against host,"},{"id":"seytek-2012:p0933:b003:l019","ordinal":368433,"en":"They hammered one another,"},{"id":"seytek-2012:p0933:b003:l020","ordinal":368434,"en":"May God never show us such a sight,"},{"id":"seytek-2012:p0933:b003:l021","ordinal":368435,"en":"The tasseled standards seethed aloft,"},{"id":"seytek-2012:p0933:b003:l022","ordinal":368436,"en":"Their battle cries became a mighty roar,"},{"id":"seytek-2012:p0933:b003:l023","ordinal":368437,"en":"Such was the dreadful struggle,"},{"id":"seytek-2012:p0933:b003:l024","ordinal":368438,"en":"When the armies confronted each other,"},{"id":"seytek-2012:p0933:b003:l025","ordinal":368439,"en":"And waged battle without yielding,"},{"id":"seytek-2012:p0933:b003:l026","ordinal":368440,"en":"Baring their great teeth,"},{"id":"seytek-2012:p0933:b003:l027","ordinal":368441,"en":"Horses died until mountains were blocked,"},{"id":"seytek-2012:p0933:b003:l028","ordinal":368442,"en":"Mustaches bristled,"},{"id":"seytek-2012:p0933:b003:l029","ordinal":368443,"en":"Corpses of heroes rose like hills,"},{"id":"seytek-2012:p0933:b003:l030","ordinal":368444,"en":"Many mortals there beheld"},{"id":"seytek-2012:p0933:b003:l031","ordinal":368445,"en":"The journey from which none return,"},{"id":"seytek-2012:p0933:b003:l032","ordinal":368446,"en":"Drenched in crimson blood,"},{"id":"seytek-2012:p0933:b003:l033","ordinal":368447,"en":"Many mortals lay dying."},{"id":"seytek-2012:p0933:b003:l034","ordinal":368448,"en":"It was a grievous, mighty conflict,"},{"id":"seytek-2012:p0933:b003:l035","ordinal":368449,"en":"The people were slaughtered without mercy."},{"id":"seytek-2012:p0933:b003:l036","ordinal":368450,"en":"Spears shattered and lashings fell,"},{"id":"seytek-2012:p0933:b003:l037","ordinal":368451,"en":"Corpses of heroes formed mountains,"},{"id":"seytek-2012:p0933:b003:l038","ordinal":368452,"en":"An immeasurable slaughter took place."},{"id":"seytek-2012:p0933:b003:l039","ordinal":368453,"en":"The hollow filled with crimson blood,"},{"id":"seytek-2012:p0933:b003:l040","ordinal":368454,"en":"Deep ravines filled with corpses."},{"id":"seytek-2012:p0934:b002:l001","ordinal":368455,"en":"The souls of the living burned with anguish,"},{"id":"seytek-2012:p0934:b002:l002","ordinal":368456,"en":"And whoever looked upon that age"},{"id":"seytek-2012:p0934:b002:l003","ordinal":368457,"en":"Saw its falseness revealed,"},{"id":"seytek-2012:p0934:b002:l004","ordinal":368458,"en":"All scattered in confusion,"},{"id":"seytek-2012:p0934:b002:l005","ordinal":368459,"en":"Crushing without respite"},{"id":"seytek-2012:p0934:b002:l006","ordinal":368460,"en":"Those they had marked for their ranks,"},{"id":"seytek-2012:p0934:b002:l007","ordinal":368461,"en":"Engaged in riotous slaughter."},{"id":"seytek-2012:p0934:b002:l008","ordinal":368462,"en":"Many a splendid warhorse,"},{"id":"seytek-2012:p0934:b002:l009","ordinal":368463,"en":"Wandered riderless and bare of saddle."},{"id":"seytek-2012:p0934:b002:l010","ordinal":368464,"en":"Many a fleet courser,"},{"id":"seytek-2012:p0934:b002:l011","ordinal":368465,"en":"Neighed while dragging its reins,"},{"id":"seytek-2012:p0934:b002:l012","ordinal":368466,"en":"Its riderless heart grieving."},{"id":"seytek-2012:p0934:b002:l013","ordinal":368467,"en":"It was a dreadful, mighty conflict,"},{"id":"seytek-2012:p0934:b002:l014","ordinal":368468,"en":"Many among the people witnessed it,"},{"id":"seytek-2012:p0934:b002:l015","ordinal":368469,"en":"And many mortals lay dying."},{"id":"seytek-2012:p0934:b002:l016","ordinal":368470,"en":"All the warriors trembled,"},{"id":"seytek-2012:p0934:b002:l017","ordinal":368471,"en":"The people cried out one by one,"},{"id":"seytek-2012:p0934:b002:l018","ordinal":368472,"en":"Thrusting and fencing with spears,"},{"id":"seytek-2012:p0934:b002:l019","ordinal":368473,"en":"They kept slaughtering one another,"},{"id":"seytek-2012:p0934:b002:l020","ordinal":368474,"en":"The great conflict tightened its coils,"},{"id":"seytek-2012:p0934:b002:l021","ordinal":368475,"en":"Becoming a chaos beyond understanding,"},{"id":"seytek-2012:p0934:b002:l022","ordinal":368476,"en":"As they continued their strife,"},{"id":"seytek-2012:p0934:b002:l023","ordinal":368477,"en":"A terrible massacre took place."},{"id":"seytek-2012:p0934:b002:l024","ordinal":368478,"en":"When Sarybay’s troops saw brave Seytek’s bearing,"},{"id":"seytek-2012:p0934:b002:l025","ordinal":368479,"en":"They surrendered,"},{"id":"seytek-2012:p0934:b002:l026","ordinal":368480,"en":"Some heroes after others,"},{"id":"seytek-2012:p0934:b002:l027","ordinal":368481,"en":"Their knees buckling,"},{"id":"seytek-2012:p0934:b002:l028","ordinal":368482,"en":"Ran after him and bowed,"},{"id":"seytek-2012:p0934:b002:l029","ordinal":368483,"en":"Taking reins knotted with loops,"},{"id":"seytek-2012:p0934:b002:l030","ordinal":368484,"en":"And hanging them around their necks,"},{"id":"seytek-2012:p0934:b002:l031","ordinal":368485,"en":"While one man from another"},{"id":"seytek-2012:p0934:b002:l032","ordinal":368486,"en":"Contended to offer him a warhorse."},{"id":"seytek-2012:p0934:b002:l033","ordinal":368487,"en":"Hurrying and trotting forward,"},{"id":"seytek-2012:p0934:b002:l034","ordinal":368488,"en":"They came as envoys,"},{"id":"seytek-2012:p0934:b002:l035","ordinal":368489,"en":"Submitting to the hero,"},{"id":"seytek-2012:p0934:b002:l036","ordinal":368490,"en":"And vying to offer livestock."},{"id":"seytek-2012:p0934:b002:l037","ordinal":368491,"en":"They began according to ancient custom,"},{"id":"seytek-2012:p0934:b002:l038","ordinal":368492,"en":"And thus brought the fighting"},{"id":"seytek-2012:p0934:b002:l039","ordinal":368493,"en":"And conflict to an end."},{"id":"seytek-2012:p0934:b002:l040","ordinal":368494,"en":"The two armies that had clashed"},{"id":"seytek-2012:p0934:b003:l001","ordinal":368495,"en":"Made peace that day,"},{"id":"seytek-2012:p0934:b003:l002","ordinal":368496,"en":"They began speaking to one another,"},{"id":"seytek-2012:p0934:b003:l003","ordinal":368497,"en":"Gathered their wits and opened counsel,"},{"id":"seytek-2012:p0934:b003:l004","ordinal":368498,"en":"And began their sorrowful plea:"},{"id":"seytek-2012:p0934:b003:l005","ordinal":368499,"en":"“Because of what has happened,"},{"id":"seytek-2012:p0934:b003:l006","ordinal":368500,"en":"Because of Sarybay,"},{"id":"seytek-2012:p0934:b003:l007","ordinal":368501,"en":"We became an army tens of thousands strong,"},{"id":"seytek-2012:p0934:b003:l008","ordinal":368502,"en":"And the whole world was stirred."},{"id":"seytek-2012:p0934:b003:l009","ordinal":368503,"en":"Sarybay drove us here,"},{"id":"seytek-2012:p0934:b003:l010","ordinal":368504,"en":"Though he had neither rope nor cord,"},{"id":"seytek-2012:p0934:b003:l011","ordinal":368505,"en":"Sarybay brought us here in bonds."},{"id":"seytek-2012:p0934:b003:l012","ordinal":368506,"en":"He unleashed his terrible wrath,"},{"id":"seytek-2012:p0934:b003:l013","ordinal":368507,"en":"And even before Saikal’s many daughters-in-law"},{"id":"seytek-2012:p0934:b003:l014","ordinal":368508,"en":"Could look back toward their village,"},{"id":"seytek-2012:p0934:b003:l015","ordinal":368509,"en":"We suffered misery and innocent deaths,"},{"id":"seytek-2012:p0934:b003:l016","ordinal":368510,"en":"Though our livestock had grazed freely,"},{"id":"seytek-2012:p0934:b003:l017","ordinal":368511,"en":"And men despaired of life."},{"id":"seytek-2012:p0934:b003:l018","ordinal":368512,"en":"The cause of their despair"},{"id":"seytek-2012:p0934:b003:l019","ordinal":368513,"en":"Was an army vast as a hearth-fire,"},{"id":"seytek-2012:p0934:b003:l020","ordinal":368514,"en":"Which devastated the people without respite."},{"id":"seytek-2012:p0934:b003:l021","ordinal":368515,"en":"A tyrant named Sarybay arose,"},{"id":"seytek-2012:p0934:b003:l022","ordinal":368516,"en":"Gathering the people and mustering an army,"},{"id":"seytek-2012:p0934:b003:l023","ordinal":368517,"en":"Amassing the entire host in abundance."},{"id":"seytek-2012:p0934:b003:l024","ordinal":368518,"en":"When his khan gave the command,"},{"id":"seytek-2012:p0934:b003:l025","ordinal":368519,"en":"He stiffened and poured out his fury,"},{"id":"seytek-2012:p0934:b003:l026","ordinal":368520,"en":"And while he stood enraged,"},{"id":"seytek-2012:p0934:b003:l027","ordinal":368521,"en":"Could the Saruu voice any grievance?"},{"id":"seytek-2012:p0934:b003:l028","ordinal":368522,"en":"When your lord bellows from his throne,"},{"id":"seytek-2012:p0934:b003:l029","ordinal":368523,"en":"Is there a horse among the people that a camel could stop?"},{"id":"seytek-2012:p0934:b003:l030","ordinal":368524,"en":"Not a single head of livestock remained in the pens,"},{"id":"seytek-2012:p0934:b003:l031","ordinal":368525,"en":"Nor strength remained to turn and flee,"},{"id":"seytek-2012:p0934:b003:l032","ordinal":368526,"en":"Not a shod yearling remained,"},{"id":"seytek-2012:p0934:b003:l033","ordinal":368527,"en":"Not a living soul among the born remained."},{"id":"seytek-2012:p0934:b003:l034","ordinal":368528,"en":"He began such outrages,"},{"id":"seytek-2012:p0934:b003:l035","ordinal":368529,"en":"And anyone who resisted"},{"id":"seytek-2012:p0934:b003:l036","ordinal":368530,"en":"He slaughtered without leaving one alive."},{"id":"seytek-2012:p0934:b003:l037","ordinal":368531,"en":"He committed notorious atrocities,"},{"id":"seytek-2012:p0934:b003:l038","ordinal":368532,"en":"And brought every mortal low."},{"id":"seytek-2012:p0934:b003:l039","ordinal":368533,"en":"Seizing his moment, he scattered us,"},{"id":"seytek-2012:p0934:b003:l040","ordinal":368534,"en":"Raging and shouting,"},{"id":"seytek-2012:p0935:b002:l001","ordinal":368535,"en":"Bringing calamity upon mankind,"},{"id":"seytek-2012:p0935:b002:l002","ordinal":368536,"en":"Sarybay drove us here."},{"id":"seytek-2012:p0935:b002:l003","ordinal":368537,"en":"When he carried out his massacre,"},{"id":"seytek-2012:p0935:b002:l004","ordinal":368538,"en":"Saying, ‘Do as I command,’"},{"id":"seytek-2012:p0935:b002:l005","ordinal":368539,"en":"Sarybay brought us as his chosen force."},{"id":"seytek-2012:p0935:b002:l006","ordinal":368540,"en":"The black halter of the fugitives"},{"id":"seytek-2012:p0935:b002:l007","ordinal":368541,"en":"Sarybay brought concealed."},{"id":"seytek-2012:p0935:b002:l008","ordinal":368542,"en":"Our precious heads into calamity"},{"id":"seytek-2012:p0935:b002:l009","ordinal":368543,"en":"Sarybay brought entangled."},{"id":"seytek-2012:p0935:b002:l010","ordinal":368544,"en":"While the people lived in freedom,"},{"id":"seytek-2012:p0935:b002:l011","ordinal":368545,"en":"Hunting deer when they grew weary,"},{"id":"seytek-2012:p0935:b002:l012","ordinal":368546,"en":"And when they were not weary, the dear people"},{"id":"seytek-2012:p0935:b002:l013","ordinal":368547,"en":"Delighting in great festivities,"},{"id":"seytek-2012:p0935:b002:l014","ordinal":368548,"en":"Sharing joy together,"},{"id":"seytek-2012:p0935:b002:l015","ordinal":368549,"en":"While many peoples lived happily,"},{"id":"seytek-2012:p0935:b002:l016","ordinal":368550,"en":"He brought such strife upon the nation,"},{"id":"seytek-2012:p0935:b002:l017","ordinal":368551,"en":"And revealed horrors never seen by man."},{"id":"seytek-2012:p0935:b002:l018","ordinal":368552,"en":"The warriors’ misery boiled over,"},{"id":"seytek-2012:p0935:b002:l019","ordinal":368553,"en":"As though struck by a plague of turmoil,"},{"id":"seytek-2012:p0935:b002:l020","ordinal":368554,"en":"He drove souls onward without rest."},{"id":"seytek-2012:p0935:b002:l021","ordinal":368555,"en":"The infidel son of an ogre"},{"id":"seytek-2012:p0935:b002:l022","ordinal":368556,"en":"Was seized by his thirst for blood."},{"id":"seytek-2012:p0935:b002:l023","ordinal":368557,"en":"He ruined the nation and corrupted the people,"},{"id":"seytek-2012:p0935:b002:l024","ordinal":368558,"en":"Starting conflict and breaking the army,"},{"id":"seytek-2012:p0935:b002:l025","ordinal":368559,"en":"Humiliating the entire nation"},{"id":"seytek-2012:p0935:b002:l026","ordinal":368560,"en":"And oppressing all the people,"},{"id":"seytek-2012:p0935:b002:l027","ordinal":368561,"en":"Destroying all that had been completed,"},{"id":"seytek-2012:p0935:b002:l028","ordinal":368562,"en":"And leaving even resourceful men"},{"id":"seytek-2012:p0935:b002:l029","ordinal":368563,"en":"Helplessly ruined."},{"id":"seytek-2012:p0935:b002:l030","ordinal":368564,"en":"For every hundred men, one man"},{"id":"seytek-2012:p0935:b002:l031","ordinal":368565,"en":"Was appointed chief and drove them on."},{"id":"seytek-2012:p0935:b002:l032","ordinal":368566,"en":"Thus the dear people were oppressed,"},{"id":"seytek-2012:p0935:b002:l033","ordinal":368567,"en":"And their misery boiled over."},{"id":"seytek-2012:p0935:b002:l034","ordinal":368568,"en":"Please hear the people’s grievance;"},{"id":"seytek-2012:p0935:b002:l035","ordinal":368569,"en":"We have no inheritance left to divide."},{"id":"seytek-2012:p0935:b002:l036","ordinal":368570,"en":"Restrain your anger."},{"id":"seytek-2012:p0935:b002:l037","ordinal":368571,"en":"You fought the desperate Sarybay"},{"id":"seytek-2012:p0935:b002:l038","ordinal":368572,"en":"And struck him down,"},{"id":"seytek-2012:p0935:b002:l039","ordinal":368573,"en":"Laying him flat upon his back."},{"id":"seytek-2012:p0935:b002:l040","ordinal":368574,"en":"This tiny host has committed no crime,"},{"id":"seytek-2012:p0935:b003:l001","ordinal":368575,"en":"And has no strength left to fight."},{"id":"seytek-2012:p0935:b003:l002","ordinal":368576,"en":"Will you take us as your own people?"},{"id":"seytek-2012:p0935:b003:l003","ordinal":368577,"en":"Lion son of the bloodstained warrior,"},{"id":"seytek-2012:p0935:b003:l004","ordinal":368578,"en":"Will you heed these rightful words?"},{"id":"seytek-2012:p0935:b003:l005","ordinal":368579,"en":"Do not needlessly massacre"},{"id":"seytek-2012:p0935:b003:l006","ordinal":368580,"en":"The multitude who have done no wrong;"},{"id":"seytek-2012:p0935:b003:l007","ordinal":368581,"en":"Spare their spoonful of blood."},{"id":"seytek-2012:p0935:b003:l008","ordinal":368582,"en":"If by chance you find them guilty,"},{"id":"seytek-2012:p0935:b003:l009","ordinal":368583,"en":"Then, hero, slaughter them if you must."},{"id":"seytek-2012:p0935:b003:l010","ordinal":368584,"en":"But if the rumor spoken is true,"},{"id":"seytek-2012:p0935:b003:l011","ordinal":368585,"en":"On the dreadful Day of Judgment"},{"id":"seytek-2012:p0935:b003:l012","ordinal":368586,"en":"We shall make the ogre’s infidel son"},{"id":"seytek-2012:p0935:b003:l013","ordinal":368587,"en":"A scapegoat, saying, ‘He slaughtered the innocent,"},{"id":"seytek-2012:p0935:b003:l014","ordinal":368588,"en":"And committed this outrage.’"},{"id":"seytek-2012:p0935:b003:l015","ordinal":368589,"en":"So shall we bear witness against him."},{"id":"seytek-2012:p0935:b003:l016","ordinal":368590,"en":"Strike us fiercely if you will;"},{"id":"seytek-2012:p0935:b003:l017","ordinal":368591,"en":"Without count and without recourse,"},{"id":"seytek-2012:p0935:b003:l018","ordinal":368592,"en":"We have fallen into your hands today."},{"id":"seytek-2012:p0935:b003:l019","ordinal":368593,"en":"Take us as your own people."},{"id":"seytek-2012:p0935:b003:l020","ordinal":368594,"en":"Do not descend to Sarybay’s level"},{"id":"seytek-2012:p0935:b003:l021","ordinal":368595,"en":"And inflict grievous conflict upon us."},{"id":"seytek-2012:p0935:b003:l022","ordinal":368596,"en":"Do not slaughter all together"},{"id":"seytek-2012:p0935:b003:l023","ordinal":368597,"en":"The dear people who bear no guilt."},{"id":"seytek-2012:p0935:b003:l024","ordinal":368598,"en":"You will pass beyond a bloodstained hand,"},{"id":"seytek-2012:p0935:b003:l025","ordinal":368599,"en":"And reach the farthest bounds of the nation;"},{"id":"seytek-2012:p0935:b003:l026","ordinal":368600,"en":"It would betray supreme fairness and justice,"},{"id":"seytek-2012:p0935:b003:l027","ordinal":368601,"en":"Hero, if you failed to show them now."},{"id":"seytek-2012:p0935:b003:l028","ordinal":368602,"en":"When your noble bearing leads us,"},{"id":"seytek-2012:p0935:b003:l029","ordinal":368603,"en":"Reveal the mark of kingship."},{"id":"seytek-2012:p0935:b003:l030","ordinal":368604,"en":"Great trials run in your blood;"},{"id":"seytek-2012:p0935:b003:l031","ordinal":368605,"en":"Spare the spoonful of blood"},{"id":"seytek-2012:p0935:b003:l032","ordinal":368606,"en":"Of these guiltless people, hero."},{"id":"seytek-2012:p0935:b003:l033","ordinal":368607,"en":"Because of what has happened,"},{"id":"seytek-2012:p0935:b003:l034","ordinal":368608,"en":"We gathered as a people,"},{"id":"seytek-2012:p0935:b003:l035","ordinal":368609,"en":"Driven here by force,"},{"id":"seytek-2012:p0935:b003:l036","ordinal":368610,"en":"Bound without cord or rope,"},{"id":"seytek-2012:p0935:b003:l037","ordinal":368611,"en":"Our eyes darting in bewilderment."},{"id":"seytek-2012:p0935:b003:l038","ordinal":368612,"en":"For every thousand men, one"},{"id":"seytek-2012:p0935:b003:l039","ordinal":368613,"en":"Was appointed as chief."},{"id":"seytek-2012:p0935:b003:l040","ordinal":368614,"en":"All our affliction was thus:"},{"id":"seytek-2012:p0936:b002:l001","ordinal":368615,"en":"Those remarkable men who heeded no counsel,"},{"id":"seytek-2012:p0936:b002:l002","ordinal":368616,"en":"The meek who understood nothing,"},{"id":"seytek-2012:p0936:b002:l003","ordinal":368617,"en":"Those who plowed grain to sustain life,"},{"id":"seytek-2012:p0936:b002:l004","ordinal":368618,"en":"And cut hay in preparation for winter,"},{"id":"seytek-2012:p0936:b002:l005","ordinal":368619,"en":"Young and old alike,"},{"id":"seytek-2012:p0936:b002:l006","ordinal":368620,"en":"He drove away the entire people."},{"id":"seytek-2012:p0936:b002:l007","ordinal":368621,"en":"He bound burdens upon their backs"},{"id":"seytek-2012:p0936:b002:l008","ordinal":368622,"en":"And threw this nation into distress,"},{"id":"seytek-2012:p0936:b002:l009","ordinal":368623,"en":"Beginning a terrible conflict."},{"id":"seytek-2012:p0936:b002:l010","ordinal":368624,"en":"Pouring out his wrath, Sarybay"},{"id":"seytek-2012:p0936:b002:l011","ordinal":368625,"en":"Slaughtered them utterly.”"},{"id":"seytek-2012:p0936:b002:l012","ordinal":368626,"en":"So spoke the people amid their clamor,"},{"id":"seytek-2012:p0936:b002:l013","ordinal":368627,"en":"And the host cried out in uproar."},{"id":"seytek-2012:p0936:b002:l014","ordinal":368628,"en":"Before the descendant of the noble lion,"},{"id":"seytek-2012:p0936:b002:l015","ordinal":368629,"en":"They submitted to brave Seytek,"},{"id":"seytek-2012:p0936:b002:l016","ordinal":368630,"en":"And spoke before the people."},{"id":"seytek-2012:p0936:b002:l017","ordinal":368631,"en":"The heroes serving as mediators,"},{"id":"seytek-2012:p0936:b002:l018","ordinal":368632,"en":"Resourceful champions,"},{"id":"seytek-2012:p0936:b002:l019","ordinal":368633,"en":"Men who whetted their sharp tongues"},{"id":"seytek-2012:p0936:b002:l020","ordinal":368634,"en":"And spoke eloquently before khans,"},{"id":"seytek-2012:p0936:b002:l021","ordinal":368635,"en":"The most skillful spearmen,"},{"id":"seytek-2012:p0936:b002:l022","ordinal":368636,"en":"The strongest of the assembled host,"},{"id":"seytek-2012:p0936:b002:l023","ordinal":368637,"en":"Men who had seen much,"},{"id":"seytek-2012:p0936:b002:l024","ordinal":368638,"en":"And wise, eloquent counselors,"},{"id":"seytek-2012:p0936:b002:l025","ordinal":368639,"en":"Stood with hands folded."},{"id":"seytek-2012:p0936:b002:l026","ordinal":368640,"en":"Changdayak, the army’s finest,"}]
