{"id": "sayakbay-ms-current146:pdf181:l001", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 181, "folio": 564, "line_in_page": 1, "raw": "Курман жаны тынды дейт,", "text": "Курман жаны тынды дейт,", "en": "They say Kurman’s life came to rest.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf181:l002", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 181, "folio": 564, "line_in_page": 2, "raw": "Курман кийген куртумор,", "text": "Курман кийген куртумор,", "en": "The armored warrior whom Kurman clad,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, proper name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf181:l003", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 181, "folio": 564, "line_in_page": 3, "raw": "Таш сайганга тазалар,", "text": "Таш сайганга тазалар,", "en": "The pure warriors who pierced the stone,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, proper name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf181:l004", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 181, "folio": 564, "line_in_page": 4, "raw": "Беришин кийген берен деп,", "text": "Беришин кийген берен деп,", "en": "Calling him a brave man dressed in his mail,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, proper name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf181:l005", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 181, "folio": 564, "line_in_page": 5, "raw": "Билген жок баатырлар,", "text": "Билген жок баатырлар,", "en": "The heroes did not know it.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf181:l006", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 181, "folio": 564, "line_in_page": 6, "raw": "Найзага денгин алышар,", "text": "Найзага денгин алышар,", "en": "They met him with their spears,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf181:l007", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 181, "folio": 564, "line_in_page": 7, "raw": "Карагы толук калдайлар,", "text": "Карагы толук калдайлар,", "en": "The full host of dark Kalmyks.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, proper name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf181:l008", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 181, "folio": 564, "line_in_page": 8, "raw": "Күрөшкө чыккан куртумор,", "text": "Күрөшкө чыккан куртумор,", "en": "The armored warrior came out to wrestle.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf181:l009", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 181, "folio": 564, "line_in_page": 9, "raw": "Маса немине дегендер,", "text": "Маса немине дегендер,", "en": "Those who asked, “What is even a fly?”", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, proper name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf181:l010", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 181, "folio": 564, "line_in_page": 10, "raw": "Арбагандан жүрөгүн,", "text": "Арбагандан жүрөгүн,", "en": "From the heart of the one possessed,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, proper name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf181:l011", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 181, "folio": 564, "line_in_page": 11, "raw": "Аш ордуна жегендер,", "text": "Аш ордуна жегендер,", "en": "Those who consumed it in place of food.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, proper name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf181:l012", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 181, "folio": 564, "line_in_page": 12, "raw": "Тополоң түшүп өлдү дейт,", "text": "Тополоң түшүп өлдү дейт,", "en": "They say turmoil descended and he died.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf181:l013", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 181, "folio": 564, "line_in_page": 13, "raw": "Токтоосу жок жоо алып,", "text": "Токтоосу жок жоо алып,", "en": "Taking the enemy without pause,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, proper name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf181:l014", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 181, "folio": 564, "line_in_page": 14, "raw": "Тозок сала берди дейт,", "text": "Тозок сала берди дейт,", "en": "They say he kept inflicting torment.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf181:l015", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 181, "folio": 564, "line_in_page": 15, "raw": "Кармушту жанчыды дейт,", "text": "Кармушту жанчыды дейт,", "en": "They say he crushed Karmush.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, proper name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf181:l016", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 181, "folio": 564, "line_in_page": 16, "raw": "Кайрат кылган калдайдан,", "text": "Кайрат кылган калдайдан,", "en": "From the Kalmyk who summoned his courage,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf181:l017", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 181, "folio": 564, "line_in_page": 17, "raw": "Канын суудан чачты дейт,", "text": "Канын суудан чачты дейт,", "en": "They say he scattered his blood like water.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf181:l018", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 181, "folio": 564, "line_in_page": 18, "raw": "Курман тон кийген куртумун,", "text": "Курман тон кийген куртумун,", "en": "The armored man wearing Kurman’s coat,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf181:l019", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 181, "folio": 564, "line_in_page": 19, "raw": "Кууп жинин басты дейт,", "text": "Кууп жинин басты дейт,", "en": "They say he chased and subdued his spirit.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf181:l020", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 181, "folio": 564, "line_in_page": 20, "raw": "Курамал деген куртумун,", "text": "Курамал деген куртумун,", "en": "The armored man called Kuramal,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf181:l021", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 181, "folio": 564, "line_in_page": 21, "raw": "Күлгүзүп канын чачты дейт,", "text": "Күлгүзүп канын чачты дейт,", "en": "They say he made him writhe and spilled his blood.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf181:l022", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 181, "folio": 564, "line_in_page": 22, "raw": "Бука коодон төрө чыкты,", "text": "Бука коодон төрө чыкты,", "en": "A prince emerged from the bull-like host.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf181:l023", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 181, "folio": 564, "line_in_page": 23, "raw": "Бул кулагай эрөөнүн,", "text": "Бул кулагай эрөөнүн,", "en": "In this contest of the mighty,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, proper name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf181:l024", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 181, "folio": 564, "line_in_page": 24, "raw": "Мошук коюп басты дейт,", "text": "Мошук коюп басты дейт,", "en": "They say he pressed him down with a grip.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, proper name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf181:l025", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 181, "folio": 564, "line_in_page": 25, "raw": "Өзөктөн күйүп өрт чыгып,", "text": "Өзөктөн күйүп өрт чыгып,", "en": "Fire flared, burning from his core.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf181:l026", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 181, "folio": 564, "line_in_page": 26, "raw": "Өз ичинен жоо чыгып,", "text": "Өз ичинен жоо чыгып,", "en": "An enemy arose from within him.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf181:l027", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 181, "folio": 564, "line_in_page": 27, "raw": "Омуроо тийген ок болуп,", "text": "Омуроо тийген ок болуп,", "en": "Like a bullet striking the chest,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf181:l028", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 181, "folio": 564, "line_in_page": 28, "raw": "Тамырындай күйгүзгөн,", "text": "Тамырындай күйгүзгөн,", "en": "It burned through him like a root.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf181:l029", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 181, "folio": 564, "line_in_page": 29, "raw": "Талкалап отко чок болуп,", "text": "Талкалап отко чок болуп,", "en": "It shattered him and became embers in the fire.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf181:l030", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 181, "folio": 564, "line_in_page": 30, "raw": "Курамын мушту чачты дейт,", "text": "Курамын мушту чачты дейт,", "en": "They say he scattered the assembled force with his fist.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, proper name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf181:l031", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 181, "folio": 564, "line_in_page": 31, "raw": "Кыргызга барып жек көрсө,", "text": "Кыргызга барып жек көрсө,", "en": "If he went among the Kyrgyz and showed hatred,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf181:l032", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 181, "folio": 564, "line_in_page": 32, "raw": "Кытайдан жонун айттырар,", "text": "Кытайдан жонун айттырар,", "en": "He would make China present its back.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf181:l033", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 181, "folio": 564, "line_in_page": 33, "raw": "Маралча жетиштир,", "text": "Маралча жетиштир,", "en": "He pursued him like a maral.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, proper name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf181:l034", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 181, "folio": 564, "line_in_page": 34, "raw": "Урааны бугу, душман ит,", "text": "Урааны бугу, душман ит,", "en": "His battle cry was “Buгу”; the enemy was a dog.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf181:l035", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 181, "folio": 564, "line_in_page": 35, "raw": "Этек алар бүлдүрүп.", "text": "Этек алар бүлдүрүп.", "en": "He seized the hem and laid waste around him.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, proper name, or idiomatic interpretation requires later witness collation.", "bbox": null}
