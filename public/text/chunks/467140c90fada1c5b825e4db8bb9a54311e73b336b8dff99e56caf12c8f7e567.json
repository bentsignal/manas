[{"id":"semetey-2-2013:p1322:b004:l029","ordinal":288513,"en":"So the white falcon mangled himself."},{"id":"semetey-2-2013:p1322:b004:l030","ordinal":288514,"en":"Then he vanished across the steppe;"},{"id":"semetey-2-2013:p1322:b004:l031","ordinal":288515,"en":"The white falcon fled away."},{"id":"semetey-2-2013:p1322:b004:l032","ordinal":288516,"en":"No eye could catch sight of him,"},{"id":"semetey-2-2013:p1322:b004:l033","ordinal":288517,"en":"And no one knew where he had gone."},{"id":"semetey-2-2013:p1322:b004:l034","ordinal":288518,"en":"Vanishing, the white falcon"},{"id":"semetey-2-2013:p1322:b004:l035","ordinal":288519,"en":"Shredded his golden leash;"},{"id":"semetey-2-2013:p1322:b004:l036","ordinal":288520,"en":"Thus the noble creature tore it apart."},{"id":"semetey-2-2013:p1322:b004:l037","ordinal":288521,"en":"Seen by no person,"},{"id":"semetey-2-2013:p1322:b004:l038","ordinal":288522,"en":"Known by no living soul,"},{"id":"semetey-2-2013:p1322:b004:l039","ordinal":288523,"en":"The white falcon departed."},{"id":"semetey-2-2013:p1323:b003:l001","ordinal":288524,"en":"As Akshumkar did this,"},{"id":"semetey-2-2013:p1323:b003:l002","ordinal":288525,"en":"Warriors wept and khans wept,"},{"id":"semetey-2-2013:p1323:b003:l003","ordinal":288526,"en":"Everyone who saw him wept;"},{"id":"semetey-2-2013:p1323:b003:l004","ordinal":288527,"en":"Stone-hearted lions wept,"},{"id":"semetey-2-2013:p1323:b003:l005","ordinal":288528,"en":"Countless tireless heroes wept."},{"id":"semetey-2-2013:p1323:b003:l006","ordinal":288529,"en":"An uproar rose and the people wept—"},{"id":"semetey-2-2013:p1323:b003:l007","ordinal":288530,"en":"All who wept,"},{"id":"semetey-2-2013:p1323:b003:l008","ordinal":288531,"en":"Young and old,"},{"id":"semetey-2-2013:p1323:b003:l009","ordinal":288532,"en":"Bad and good alike,"},{"id":"semetey-2-2013:p1323:b003:l010","ordinal":288533,"en":"Wept, consumed by their own grief."},{"id":"semetey-2-2013:p1323:b003:l011","ordinal":288534,"en":"“Now that the bloodstained warrior is gone,"},{"id":"semetey-2-2013:p1323:b003:l012","ordinal":288535,"en":"What age and what days"},{"id":"semetey-2-2013:p1323:b003:l013","ordinal":288536,"en":"Will come upon us?” they wept."},{"id":"semetey-2-2013:p1323:b003:l014","ordinal":288537,"en":"The Greathearted One was gone from sight."},{"id":"semetey-2-2013:p1323:b003:l015","ordinal":288538,"en":"“How will the camps"},{"id":"semetey-2-2013:p1323:b003:l016","ordinal":288539,"en":"Of the Argyn and Kyrgyz settle?"},{"id":"semetey-2-2013:p1323:b003:l017","ordinal":288540,"en":"What will become of us?"},{"id":"semetey-2-2013:p1323:b003:l018","ordinal":288541,"en":"How will our people make camp?”"},{"id":"semetey-2-2013:p1323:b003:l019","ordinal":288542,"en":"The people's master was lost."},{"id":"semetey-2-2013:p1323:b003:l020","ordinal":288543,"en":"“What fate now awaits"},{"id":"semetey-2-2013:p1323:b003:l021","ordinal":288544,"en":"The Argyn and Kyrgyz?”"},{"id":"semetey-2-2013:p1323:b003:l022","ordinal":288545,"en":"The people wailed in tumult,"},{"id":"semetey-2-2013:p1323:b003:l023","ordinal":288546,"en":"Their clamor split the sky."},{"id":"semetey-2-2013:p1323:b003:l024","ordinal":288547,"en":"While the heroic sultan lived,"},{"id":"semetey-2-2013:p1323:b003:l025","ordinal":288548,"en":"The people cried and spoke of this,"},{"id":"semetey-2-2013:p1323:b003:l026","ordinal":288549,"en":"Telling horrors clear to all."},{"id":"semetey-2-2013:p1323:b003:l027","ordinal":288550,"en":"While the warrior still lived,"},{"id":"semetey-2-2013:p1323:b003:l028","ordinal":288551,"en":"We ate the barren mare's foal;"},{"id":"semetey-2-2013:p1323:b003:l029","ordinal":288552,"en":"If the Chinese shouted from the ridge"},{"id":"semetey-2-2013:p1323:b003:l030","ordinal":288553,"en":"And stirred a fierce battle,"},{"id":"semetey-2-2013:p1323:b003:l031","ordinal":288554,"en":"We used to ask, “Where is the danger?”"},{"id":"semetey-2-2013:p1323:b003:l032","ordinal":288555,"en":"There in Kara-Buura and Chatkal,"},{"id":"semetey-2-2013:p1323:b003:l033","ordinal":288556,"en":"When the Kyrgyz lay in proud abundance,"},{"id":"semetey-2-2013:p1323:b003:l034","ordinal":288557,"en":"Red haze brightened the land,"},{"id":"semetey-2-2013:p1323:b003:l035","ordinal":288558,"en":"Fine mares with foals stood tethered,"},{"id":"semetey-2-2013:p1323:b003:l036","ordinal":288559,"en":"And kumis flowed by day, spirits by night."},{"id":"semetey-2-2013:p1323:b003:l037","ordinal":288560,"en":"In those flourishing days,"},{"id":"semetey-2-2013:p1323:b003:l038","ordinal":288561,"en":"In those days we wore sable caps"},{"id":"semetey-2-2013:p1323:b003:l039","ordinal":288562,"en":"With paired trim, cocked jauntily."},{"id":"semetey-2-2013:p1323:b005:l001","ordinal":288563,"en":"When restless, we raided the foe;"},{"id":"semetey-2-2013:p1323:b005:l002","ordinal":288564,"en":"While our hero still lived,"},{"id":"semetey-2-2013:p1323:b005:l003","ordinal":288565,"en":"If Chinese armies met us head-on,"},{"id":"semetey-2-2013:p1323:b005:l004","ordinal":288566,"en":"We drove them all the way to Beijing."},{"id":"semetey-2-2013:p1323:b005:l005","ordinal":288567,"en":"We hunted deer in the hills"},{"id":"semetey-2-2013:p1323:b005:l006","ordinal":288568,"en":"And lived safe, untouched by sorrow."},{"id":"semetey-2-2013:p1323:b005:l007","ordinal":288569,"en":"Ours was a people whose daughters-in-law were lovely,"},{"id":"semetey-2-2013:p1323:b005:l008","ordinal":288570,"en":"With broad headdresses and long hair ornaments."},{"id":"semetey-2-2013:p1323:b005:l009","ordinal":288571,"en":"While the bloodstained hero lived,"},{"id":"semetey-2-2013:p1323:b005:l010","ordinal":288572,"en":"We asked, “How could disaster reach us?”"},{"id":"semetey-2-2013:p1323:b005:l011","ordinal":288573,"en":"Our land was hilly Talas;"},{"id":"semetey-2-2013:p1323:b005:l012","ordinal":288574,"en":"Now our rocky ridge has collapsed."},{"id":"semetey-2-2013:p1323:b005:l013","ordinal":288575,"en":"Parted from the warrior lion,"},{"id":"semetey-2-2013:p1323:b005:l014","ordinal":288576,"en":"Our backs seem broken,"},{"id":"semetey-2-2013:p1323:b005:l015","ordinal":288577,"en":"Our people seem to writhe in pain,"},{"id":"semetey-2-2013:p1323:b005:l016","ordinal":288578,"en":"Our fortune seems bound fast,"},{"id":"semetey-2-2013:p1323:b005:l017","ordinal":288579,"en":"And our hopes seem shattered."},{"id":"semetey-2-2013:p1323:b005:l018","ordinal":288580,"en":"There are argali on its hills,"},{"id":"semetey-2-2013:p1323:b005:l019","ordinal":288581,"en":"Silver on its sunny slopes,"},{"id":"semetey-2-2013:p1323:b005:l020","ordinal":288582,"en":"Wild asses on its pale plains,"},{"id":"semetey-2-2013:p1323:b005:l021","ordinal":288583,"en":"Ibex on its terraces,"},{"id":"semetey-2-2013:p1323:b005:l022","ordinal":288584,"en":"Snow upon its mountains,"},{"id":"semetey-2-2013:p1323:b005:l023","ordinal":288585,"en":"Game within its forests."},{"id":"semetey-2-2013:p1323:b005:l024","ordinal":288586,"en":"In Jylgyndy, Keng-Kol, and Talas"},{"id":"semetey-2-2013:p1323:b005:l025","ordinal":288587,"en":"All these delights abound."},{"id":"semetey-2-2013:p1323:b005:l026","ordinal":288588,"en":"Its springs boil up and overflow;"},{"id":"semetey-2-2013:p1323:b005:l027","ordinal":288589,"en":"Nightingales sing there,"},{"id":"semetey-2-2013:p1323:b005:l028","ordinal":288590,"en":"And hearing their songs,"},{"id":"semetey-2-2013:p1323:b005:l029","ordinal":288591,"en":"Young men soften with longing."},{"id":"semetey-2-2013:p1323:b005:l030","ordinal":288592,"en":"Talas was a spacious land,"},{"id":"semetey-2-2013:p1323:b005:l031","ordinal":288593,"en":"And these noble people here"},{"id":"semetey-2-2013:p1323:b005:l032","ordinal":288594,"en":"Were the free Kyrgyz nation."},{"id":"semetey-2-2013:p1323:b005:l033","ordinal":288595,"en":"No enemy advancing could defeat them,"},{"id":"semetey-2-2013:p1323:b005:l034","ordinal":288596,"en":"No host could prevail in combat."},{"id":"semetey-2-2013:p1323:b005:l035","ordinal":288597,"en":"These few Kyrgyz here"},{"id":"semetey-2-2013:p1323:b005:l036","ordinal":288598,"en":"Thrived upon the finest land;"},{"id":"semetey-2-2013:p1323:b005:l037","ordinal":288599,"en":"Before every doorway"},{"id":"semetey-2-2013:p1323:b005:l038","ordinal":288600,"en":"A thousand mares were tethered."},{"id":"semetey-2-2013:p1323:b005:l039","ordinal":288601,"en":"We were a people living at liberty,"},{"id":"semetey-2-2013:p1325:b003:l001","ordinal":288602,"en":"When told to take a cap, we cut off a head;"},{"id":"semetey-2-2013:p1325:b003:l002","ordinal":288603,"en":"When told to drink water, we drank poison;"},{"id":"semetey-2-2013:p1325:b003:l003","ordinal":288604,"en":"When told to spill blood, we spilled our souls."},{"id":"semetey-2-2013:p1325:b003:l004","ordinal":288605,"en":"We were a people equal to long clubs,"},{"id":"semetey-2-2013:p1325:b003:l005","ordinal":288606,"en":"Crooked cudgels, and stout staves."},{"id":"semetey-2-2013:p1325:b003:l006","ordinal":288607,"en":"When a man loves whom he chooses,"},{"id":"semetey-2-2013:p1325:b003:l007","ordinal":288608,"en":"What night equals the blessed Night of Power?"},{"id":"semetey-2-2013:p1325:b003:l008","ordinal":288609,"en":"While the bloodstained warrior watched this land,"},{"id":"semetey-2-2013:p1325:b003:l009","ordinal":288610,"en":"Was there ever a day of merely standing by?"},{"id":"semetey-2-2013:p1325:b003:l010","ordinal":288611,"en":"If the many Kyrgyz and Argyn"},{"id":"semetey-2-2013:p1325:b003:l011","ordinal":288612,"en":"Suddenly stretched in marching ranks,"},{"id":"semetey-2-2013:p1325:b003:l012","ordinal":288613,"en":"And unexpectedly joined battle,"},{"id":"semetey-2-2013:p1325:b003:l013","ordinal":288614,"en":"If our blood ran in slaughter"},{"id":"semetey-2-2013:p1325:b003:l014","ordinal":288615,"en":"And all of us were locked in combat,"},{"id":"semetey-2-2013:p1325:b003:l015","ordinal":288616,"en":"Where now is the tawny mountain pass"},{"id":"semetey-2-2013:p1325:b003:l016","ordinal":288617,"en":"To which we might flee in a stream?"},{"id":"semetey-2-2013:p1325:b003:l017","ordinal":288618,"en":"Where is the lion like the Greathearted One,"},{"id":"semetey-2-2013:p1325:b003:l018","ordinal":288619,"en":"Who would spare these people torment"},{"id":"semetey-2-2013:p1325:b003:l019","ordinal":288620,"en":"And divide the warring sides?"},{"id":"semetey-2-2013:p1325:b003:l020","ordinal":288621,"en":"Now there is no ridge to brace against,"},{"id":"semetey-2-2013:p1325:b003:l021","ordinal":288622,"en":"No place left to fortify;"},{"id":"semetey-2-2013:p1325:b003:l022","ordinal":288623,"en":"You have no khan whose figure is a mountain."},{"id":"semetey-2-2013:p1325:b003:l023","ordinal":288624,"en":"Parted from your protecting khan,"},{"id":"semetey-2-2013:p1325:b003:l024","ordinal":288625,"en":"You many Kyrgyz have no strength."},{"id":"semetey-2-2013:p1325:b003:l025","ordinal":288626,"en":"What becomes of a rolling, hilly land"},{"id":"semetey-2-2013:p1325:b003:l026","ordinal":288627,"en":"Whose people have left it desolate?"},{"id":"semetey-2-2013:p1325:b003:l027","ordinal":288628,"en":"What becomes of a soul burning openly,"},{"id":"semetey-2-2013:p1325:b003:l028","ordinal":288629,"en":"Or livestock abandoned without an owner?"},{"id":"semetey-2-2013:p1325:b003:l029","ordinal":288630,"en":"Parted from our noble lion,"},{"id":"semetey-2-2013:p1325:b003:l030","ordinal":288631,"en":"What kinds of hell"},{"id":"semetey-2-2013:p1325:b003:l031","ordinal":288632,"en":"Must we Kyrgyz now endure?"},{"id":"semetey-2-2013:p1325:b003:l032","ordinal":288633,"en":"No cotton is planted for us"},{"id":"semetey-2-2013:p1325:b003:l033","ordinal":288634,"en":"In Keng-Kol now;"},{"id":"semetey-2-2013:p1325:b003:l034","ordinal":288635,"en":"There is no time to lounge at ease."},{"id":"semetey-2-2013:p1325:b003:l035","ordinal":288636,"en":"Is there still a garden planted in Talas?"},{"id":"semetey-2-2013:p1325:b003:l036","ordinal":288637,"en":"We have lost our fortunate lion;"},{"id":"semetey-2-2013:p1325:b003:l037","ordinal":288638,"en":"Is this a time to sprawl in idleness?"},{"id":"semetey-2-2013:p1325:b003:l038","ordinal":288639,"en":"Have we now a garden planted"},{"id":"semetey-2-2013:p1325:b003:l039","ordinal":288640,"en":"Upon the hill?"},{"id":"semetey-2-2013:p1325:b004:l001","ordinal":288641,"en":"Is this a time for swaggering rest?"},{"id":"semetey-2-2013:p1325:b004:l002","ordinal":288642,"en":"Many enemies weigh upon our minds;"},{"id":"semetey-2-2013:p1325:b004:l003","ordinal":288643,"en":"An enemy stands ready to bury us."},{"id":"semetey-2-2013:p1325:b004:l004","ordinal":288644,"en":"There is the oppression"},{"id":"semetey-2-2013:p1325:b004:l005","ordinal":288645,"en":"Of Alty-Shaar and Kokand."},{"id":"semetey-2-2013:p1325:b004:l006","ordinal":288646,"en":"With sashes wound like turbans,"},{"id":"semetey-2-2013:p1325:b004:l007","ordinal":288647,"en":"Praying to the Almighty,"},{"id":"semetey-2-2013:p1325:b004:l008","ordinal":288648,"en":"Their crooked threat still stands."},{"id":"semetey-2-2013:p1325:b004:l009","ordinal":288649,"en":"You have no supporting presence, no backbone,"},{"id":"semetey-2-2013:p1325:b004:l010","ordinal":288650,"en":"You have lost your true gray-maned lion."},{"id":"semetey-2-2013:p1325:b004:l011","ordinal":288651,"en":"The one seen today is gone tomorrow;"},{"id":"semetey-2-2013:p1325:b004:l012","ordinal":288652,"en":"Your heart is flame and your breast is ember—"},{"id":"semetey-2-2013:p1325:b004:l013","ordinal":288653,"en":"Such is this worthless world!"},{"id":"semetey-2-2013:p1325:b004:l014","ordinal":288654,"en":"The Greathearted gray-maned lion"},{"id":"semetey-2-2013:p1325:b004:l015","ordinal":288655,"en":"Who endured every hell is not here!"},{"id":"semetey-2-2013:p1325:b004:l016","ordinal":288656,"en":"The assembled people grieved and said this,"},{"id":"semetey-2-2013:p1325:b004:l017","ordinal":288657,"en":"Speaking of mankind's dreadful calamity;"},{"id":"semetey-2-2013:p1325:b004:l018","ordinal":288658,"en":"Their ribs seemed to split,"},{"id":"semetey-2-2013:p1325:b004:l019","ordinal":288659,"en":"And tears poured from their eyes."},{"id":"semetey-2-2013:p1325:b004:l020","ordinal":288660,"en":"They heard the tale from the great host:"},{"id":"semetey-2-2013:p1325:b004:l021","ordinal":288661,"en":"No one knew where he was,"},{"id":"semetey-2-2013:p1325:b004:l022","ordinal":288662,"en":"And they heard that Semetey had vanished."},{"id":"semetey-2-2013:p1325:b004:l023","ordinal":288663,"en":"The people wailed in anguish,"},{"id":"semetey-2-2013:p1325:b004:l024","ordinal":288664,"en":"Despairing of their tiny lives."},{"id":"semetey-2-2013:p1325:b004:l025","ordinal":288665,"en":"Semetey had gone from among them,"},{"id":"semetey-2-2013:p1325:b004:l026","ordinal":288666,"en":"And the multitude stood in uproar."},{"id":"semetey-2-2013:p1325:b004:l027","ordinal":288667,"en":"As though each person's father had died,"},{"id":"semetey-2-2013:p1325:b004:l028","ordinal":288668,"en":"The crescent-tipped golden banners filled the field."},{"id":"semetey-2-2013:p1325:b004:l029","ordinal":288669,"en":"As the multitude stood grieving,"},{"id":"semetey-2-2013:p1325:b004:l030","ordinal":288670,"en":"A clamor split the sky."},{"id":"semetey-2-2013:p1325:b004:l031","ordinal":288671,"en":"Overwhelmed by dreadful disaster,"},{"id":"semetey-2-2013:p1325:b004:l032","ordinal":288672,"en":"They abandoned utterly"},{"id":"semetey-2-2013:p1325:b004:l033","ordinal":288673,"en":"Not only their livestock but their lives."},{"id":"semetey-2-2013:p1325:b004:l034","ordinal":288674,"en":"The people wailed in anguish,"},{"id":"semetey-2-2013:p1325:b004:l035","ordinal":288675,"en":"Running up and down;"},{"id":"semetey-2-2013:p1325:b004:l036","ordinal":288676,"en":"When they heard about Semetey,"},{"id":"semetey-2-2013:p1325:b004:l037","ordinal":288677,"en":"They plunged into the tumult,"},{"id":"semetey-2-2013:p1325:b004:l038","ordinal":288678,"en":"And fell into a vast,"},{"id":"semetey-2-2013:p1325:b004:l039","ordinal":288679,"en":"Unhealed uproar."},{"id":"semetey-2-2013:p1326:b003:l001","ordinal":288680,"en":"Turning wisdom over and pondering,"},{"id":"semetey-2-2013:p1326:b003:l002","ordinal":288681,"en":"They withdrew into the hills."},{"id":"semetey-2-2013:p1326:b003:l003","ordinal":288682,"en":"The people wailed and tumult broke out;"},{"id":"semetey-2-2013:p1326:b003:l004","ordinal":288683,"en":"They plunged into the uproar,"},{"id":"semetey-2-2013:p1326:b003:l005","ordinal":288684,"en":"And entered an ordeal"},{"id":"semetey-2-2013:p1326:b003:l006","ordinal":288685,"en":"No common people could face."},{"id":"semetey-2-2013:p1326:b003:l007","ordinal":288686,"en":"If the Chinese swarm over the ridge,"},{"id":"semetey-2-2013:p1326:b003:l008","ordinal":288687,"en":"You have no khan to answer them,"},{"id":"semetey-2-2013:p1326:b003:l009","ordinal":288688,"en":"No strength with which to fight."},{"id":"semetey-2-2013:p1326:b003:l010","ordinal":288689,"en":"Unable to cross and escape,"},{"id":"semetey-2-2013:p1326:b003:l011","ordinal":288690,"en":"Will women and men together"},{"id":"semetey-2-2013:p1326:b003:l012","ordinal":288691,"en":"Be taken into captivity?"},{"id":"semetey-2-2013:p1326:b003:l013","ordinal":288692,"en":"Without dying or disappearing,"},{"id":"semetey-2-2013:p1326:b003:l014","ordinal":288693,"en":"Will we survive the humiliation,"},{"id":"semetey-2-2013:p1326:b003:l015","ordinal":288694,"en":"Living on as slaves,"},{"id":"semetey-2-2013:p1326:b003:l016","ordinal":288695,"en":"And be brought to misery?"},{"id":"semetey-2-2013:p1326:b003:l017","ordinal":288696,"en":"Called the people of that bloodstained warrior,"},{"id":"semetey-2-2013:p1326:b003:l018","ordinal":288697,"en":"Will we be cast into the grave?"},{"id":"semetey-2-2013:p1326:b003:l019","ordinal":288698,"en":"Will firearms strike us from the front,"},{"id":"semetey-2-2013:p1326:b003:l020","ordinal":288699,"en":"And will we be torn apart?”"},{"id":"semetey-2-2013:p1326:b003:l021","ordinal":288700,"en":"For the hero Semetey,"},{"id":"semetey-2-2013:p1326:b003:l022","ordinal":288701,"en":"All the Kyrgyz people wept;"},{"id":"semetey-2-2013:p1326:b003:l023","ordinal":288702,"en":"The wise and skillful wept,"},{"id":"semetey-2-2013:p1326:b003:l024","ordinal":288703,"en":"Slender-waisted girls"},{"id":"semetey-2-2013:p1326:b003:l025","ordinal":288704,"en":"In crimson dresses wept;"},{"id":"semetey-2-2013:p1326:b003:l026","ordinal":288705,"en":"White-bearded elders wept,"},{"id":"semetey-2-2013:p1326:b003:l027","ordinal":288706,"en":"Every kind of living soul wept,"},{"id":"semetey-2-2013:p1326:b003:l028","ordinal":288707,"en":"Old and young alike wept."},{"id":"semetey-2-2013:p1326:b003:l029","ordinal":288708,"en":"The people lamented in tumult,"},{"id":"semetey-2-2013:p1326:b003:l030","ordinal":288709,"en":"Despairing of their tiny lives;"},{"id":"semetey-2-2013:p1326:b003:l031","ordinal":288710,"en":"Wearing black and swallowing blood,"},{"id":"semetey-2-2013:p1326:b003:l032","ordinal":288711,"en":"The many Argyn and Kyrgyz,"},{"id":"semetey-2-2013:p1326:b003:l033","ordinal":288712,"en":"The whole great nation, stood in uproar."},{"id":"semetey-2-2013:p1326:b003:l034","ordinal":288713,"en":"As the people wailed,"},{"id":"semetey-2-2013:p1326:b003:l035","ordinal":288714,"en":"Kanchoro shouted in frenzy,"},{"id":"semetey-2-2013:p1326:b003:l036","ordinal":288715,"en":"Calling for warrior Kyiaz,"},{"id":"semetey-2-2013:p1326:b003:l037","ordinal":288716,"en":"And began his reign of fury."},{"id":"semetey-2-2013:p1326:b003:l038","ordinal":288717,"en":"When they saw Kanchoro's rage,"},{"id":"semetey-2-2013:p1326:b003:l039","ordinal":288718,"en":"The white-bearded elders"},{"id":"semetey-2-2013:p1326:b004:l001","ordinal":288719,"en":"And all the weeping people"},{"id":"semetey-2-2013:p1326:b004:l002","ordinal":288720,"en":"Fled and scattered."},{"id":"semetey-2-2013:p1326:b004:l003","ordinal":288721,"en":"Taking a spear with a steel socket"},{"id":"semetey-2-2013:p1326:b004:l004","ordinal":288722,"en":"And a keen, gaping point,"},{"id":"semetey-2-2013:p1326:b004:l005","ordinal":288723,"en":"Girding on an unsheathed sword"},{"id":"semetey-2-2013:p1326:b004:l006","ordinal":288724,"en":"As though ready to strike,"},{"id":"semetey-2-2013:p1326:b004:l007","ordinal":288725,"en":"He arrayed all his weapons:"},{"id":"semetey-2-2013:p1326:b004:l008","ordinal":288726,"en":"The jezail, the club, the iron-headed mace—"},{"id":"semetey-2-2013:p1326:b004:l009","ordinal":288727,"en":"He made all of them ready."},{"id":"semetey-2-2013:p1326:b004:l010","ordinal":288728,"en":"At Semetey's treasury,"},{"id":"semetey-2-2013:p1326:b004:l011","ordinal":288729,"en":"He seized the keeper"},{"id":"semetey-2-2013:p1326:b004:l012","ordinal":288730,"en":"Who guarded the gate,"},{"id":"semetey-2-2013:p1326:b004:l013","ordinal":288731,"en":"And forced open the treasury door."},{"id":"semetey-2-2013:p1326:b004:l014","ordinal":288732,"en":"Beginning with Bolokbai, the forty Kalmyks—"},{"id":"semetey-2-2013:p1326:b004:l015","ordinal":288733,"en":"He slaughtered all forty Kalmyks."},{"id":"semetey-2-2013:p1326:b004:l016","ordinal":288734,"en":"In that treasury Kanchoro,"},{"id":"semetey-2-2013:p1326:b004:l017","ordinal":288735,"en":"The accursed traitor, gorged himself."},{"id":"semetey-2-2013:p1326:b004:l018","ordinal":288736,"en":"He plundered the fine cloth,"},{"id":"semetey-2-2013:p1326:b004:l019","ordinal":288737,"en":"And unleashed wickedness like a dog."},{"id":"semetey-2-2013:p1326:b004:l020","ordinal":288738,"en":"He ripped an entire sable skin"},{"id":"semetey-2-2013:p1326:b004:l021","ordinal":288739,"en":"Lengthwise,"},{"id":"semetey-2-2013:p1326:b004:l022","ordinal":288740,"en":"And wrapped it around his leggings."},{"id":"semetey-2-2013:p1326:b004:l023","ordinal":288741,"en":"Swaggering like a hero,"},{"id":"semetey-2-2013:p1326:b004:l024","ordinal":288742,"en":"Strutting as though mighty,"},{"id":"semetey-2-2013:p1326:b004:l025","ordinal":288743,"en":"He climbed a hill and shouted,"},{"id":"semetey-2-2013:p1326:b004:l026","ordinal":288744,"en":"Calling to Kyiaz of the Jediger:"},{"id":"semetey-2-2013:p1326:b004:l027","ordinal":288745,"en":"“Come, every one of you!”"},{"id":"semetey-2-2013:p1326:b004:l028","ordinal":288746,"en":"Standing upon the hill, Kanchoro—"},{"id":"semetey-2-2013:p1326:b004:l029","ordinal":288747,"en":"That pale retainer struck by ancestral wrath—"},{"id":"semetey-2-2013:p1326:b004:l030","ordinal":288748,"en":"Cried, “Know a khan's might!"},{"id":"semetey-2-2013:p1326:b004:l031","ordinal":288749,"en":"Make booty of the Argyn and Nogai,"},{"id":"semetey-2-2013:p1326:b004:l032","ordinal":288750,"en":"You damned Jediger!"},{"id":"semetey-2-2013:p1326:b004:l033","ordinal":288751,"en":"Go in and take them as spoil."},{"id":"semetey-2-2013:p1326:b004:l034","ordinal":288752,"en":"See which among them has courage."},{"id":"semetey-2-2013:p1326:b004:l035","ordinal":288753,"en":"Their remaining livestock, girls, and women"},{"id":"semetey-2-2013:p1326:b004:l036","ordinal":288754,"en":"Are the khan's spoils;"},{"id":"semetey-2-2013:p1326:b004:l037","ordinal":288755,"en":"Measure and divide them by the whip."},{"id":"semetey-2-2013:p1326:b004:l038","ordinal":288756,"en":"There is so much costly gold and silver"},{"id":"semetey-2-2013:p1326:b004:l039","ordinal":288757,"en":"You will fail to load it all;"},{"id":"semetey-2-2013:p1327:b003:l001","ordinal":288758,"en":"There are noble brides and beautiful girls"},{"id":"semetey-2-2013:p1327:b003:l002","ordinal":288759,"en":"Beyond your power to carry off."},{"id":"semetey-2-2013:p1327:b003:l003","ordinal":288760,"en":"Drive seven thousand red camels,"},{"id":"semetey-2-2013:p1327:b003:l004","ordinal":288761,"en":"And braid the camels' tails."},{"id":"semetey-2-2013:p1327:b003:l005","ordinal":288762,"en":"See this fine spectacle"},{"id":"semetey-2-2013:p1327:b003:l006","ordinal":288763,"en":"Provided by Chubak's son Choro!"},{"id":"semetey-2-2013:p1327:b003:l007","ordinal":288764,"en":"Six hundred thousand horses graze the hills,"},{"id":"semetey-2-2013:p1327:b003:l008","ordinal":288765,"en":"Fine piebald steeds,"},{"id":"semetey-2-2013:p1327:b003:l009","ordinal":288766,"en":"Thoroughbreds and racers mingled together."},{"id":"semetey-2-2013:p1327:b003:l010","ordinal":288767,"en":"There are countless swift ponies;"},{"id":"semetey-2-2013:p1327:b003:l011","ordinal":288768,"en":"In Talas there is no owner"}]
