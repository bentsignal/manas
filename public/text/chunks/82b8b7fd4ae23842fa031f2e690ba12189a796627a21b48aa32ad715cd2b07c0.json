[{"id":"manas-2010:p1435:b001:l008","ordinal":61953,"en":"Your many people, taking thought,"},{"id":"manas-2010:p1435:b001:l009","ordinal":61954,"en":"Were prospering there."},{"id":"manas-2010:p1435:b001:l010","ordinal":61955,"en":"Kumys by day, girls by night—"},{"id":"manas-2010:p1435:b001:l011","ordinal":61956,"en":"That was how things were."},{"id":"manas-2010:p1435:b001:l012","ordinal":61957,"en":"Caps faced with marten fur"},{"id":"manas-2010:p1435:b001:l013","ordinal":61958,"en":"Were swaying to and fro."},{"id":"manas-2010:p1435:b001:l014","ordinal":61959,"en":"When bored, they shot roe deer;"},{"id":"manas-2010:p1435:b001:l015","ordinal":61960,"en":"When not bored, they lay at ease."},{"id":"manas-2010:p1435:b001:l016","ordinal":61961,"en":"They were enjoying life."},{"id":"manas-2010:p1435:b001:l017","ordinal":61962,"en":"Why should I tell of all the rest?"},{"id":"manas-2010:p1435:b001:l018","ordinal":61963,"en":"Keng-Kol, Talas, the plains are safe."},{"id":"manas-2010:p1435:b001:l019","ordinal":61964,"en":"When we set out this way,"},{"id":"manas-2010:p1435:b001:l020","ordinal":61965,"en":"The newly born child was safe."},{"id":"manas-2010:p1435:b001:l021","ordinal":61966,"en":"Aruuke, the wife you married,"},{"id":"manas-2010:p1435:b001:l022","ordinal":61967,"en":"She too is safe at this time"},{"id":"manas-2010:p1435:b001:l023","ordinal":61968,"en":"And sends you many special greetings!"},{"id":"manas-2010:p1435:b001:l024","ordinal":61969,"en":"The bridle you kept for your horse—"},{"id":"manas-2010:p1435:b001:l025","ordinal":61970,"en":"Inside Aruuke,"},{"id":"manas-2010:p1435:b001:l026","ordinal":61971,"en":"It is about to be born,"},{"id":"manas-2010:p1435:b001:l027","ordinal":61972,"en":"Your unborn child left in her womb!"},{"id":"manas-2010:p1435:b001:l028","ordinal":61973,"en":"‘Let him come to Beijing without delay,’ they say,"},{"id":"manas-2010:p1435:b001:l029","ordinal":61974,"en":"‘Let him see this sorrowing soul,’ they say.”"},{"id":"manas-2010:p1435:b001:l030","ordinal":61975,"en":"When he heard such words,"},{"id":"manas-2010:p1435:b001:l031","ordinal":61976,"en":"With golden forelock and fiery belt,"},{"id":"manas-2010:p1435:b001:l032","ordinal":61977,"en":"The only son of Azizkhan"},{"id":"manas-2010:p1435:b001:l033","ordinal":61978,"en":"Had his heart pulled many ways."},{"id":"manas-2010:p1435:b001:l034","ordinal":61979,"en":"Rejoicing beyond measure,"},{"id":"manas-2010:p1435:b001:l035","ordinal":61980,"en":"Stretching himself like a lion,"},{"id":"manas-2010:p1435:b001:l036","ordinal":61981,"en":"Restless in his sorrow,"},{"id":"manas-2010:p1435:b001:l037","ordinal":61982,"en":"The precious warrior stood looking on."},{"id":"manas-2010:p1435:b001:l038","ordinal":61983,"en":"“That precious bird, the wild duck,"},{"id":"manas-2010:p1435:b001:l039","ordinal":61984,"en":"Flies over the plain without returning,” they say."},{"id":"manas-2010:p1435:b001:l040","ordinal":61985,"en":"Your precious Almam rejoices"},{"id":"manas-2010:p1435:b001:l041","ordinal":61986,"en":"For the child left in the womb."},{"id":"manas-2010:p1435:b001:l042","ordinal":61987,"en":"“That wretched bird, the kite,"},{"id":"manas-2010:p1436:b001:l001","ordinal":61988,"en":"Swoops over the plain,” they say."},{"id":"manas-2010:p1436:b001:l002","ordinal":61989,"en":"Your Almam rejoices in delight"},{"id":"manas-2010:p1436:b001:l003","ordinal":61990,"en":"For the child within the womb!"},{"id":"manas-2010:p1436:b001:l004","ordinal":61991,"en":"Sarala beneath him,"},{"id":"manas-2010:p1436:b001:l005","ordinal":61992,"en":"Ceaselessly turning sideways,"},{"id":"manas-2010:p1436:b001:l006","ordinal":61993,"en":"Came bounding forth."},{"id":"manas-2010:p1436:b001:l007","ordinal":61994,"en":"Joy entered his heart;"},{"id":"manas-2010:p1436:b001:l008","ordinal":61995,"en":"In the wake of joy,"},{"id":"manas-2010:p1436:b001:l009","ordinal":61996,"en":"Your Alake, for the sake of one child,"},{"id":"manas-2010:p1436:b001:l010","ordinal":61997,"en":"That exceptional wolf-man lion,"},{"id":"manas-2010:p1436:b001:l011","ordinal":61998,"en":"Came forth weeping!"},{"id":"manas-2010:p1436:b001:l012","ordinal":61999,"en":"The reason for his tears was this:"},{"id":"manas-2010:p1436:b001:l013","ordinal":62000,"en":"Nine thousand horses in the mountains,"},{"id":"manas-2010:p1436:b001:l014","ordinal":62001,"en":"Among them warhorses and noble steeds."},{"id":"manas-2010:p1436:b001:l015","ordinal":62002,"en":"A herd of swift horses, with no minds;"},{"id":"manas-2010:p1436:b001:l016","ordinal":62003,"en":"Almambet could not contain himself:"},{"id":"manas-2010:p1436:b001:l017","ordinal":62004,"en":"To tend and take them over,"},{"id":"manas-2010:p1436:b001:l018","ordinal":62005,"en":"He had no male child behind him."},{"id":"manas-2010:p1436:b001:l019","ordinal":62006,"en":"His noble steed, a blaze-faced charger—"},{"id":"manas-2010:p1436:b001:l020","ordinal":62007,"en":"When death comes and his days end,"},{"id":"manas-2010:p1436:b001:l021","ordinal":62008,"en":"Where might this wretched head not lie?"},{"id":"manas-2010:p1436:b001:l022","ordinal":62009,"en":"The chargers he rode were all well fed;"},{"id":"manas-2010:p1436:b001:l023","ordinal":62010,"en":"What made your Alake grieve"},{"id":"manas-2010:p1436:b001:l024","ordinal":62011,"en":"Was having no male child behind him."},{"id":"manas-2010:p1436:b001:l025","ordinal":62012,"en":"His wife, Aruuke, Agynai’s daughter,"},{"id":"manas-2010:p1436:b001:l026","ordinal":62013,"en":"Since she had sent a certain gift,"},{"id":"manas-2010:p1436:b001:l027","ordinal":62014,"en":"Since he had received and seen her gift,"},{"id":"manas-2010:p1436:b001:l028","ordinal":62015,"en":"Sparing not his troubled life,"},{"id":"manas-2010:p1436:b001:l029","ordinal":62016,"en":"He vowed sheep to Khoroson,"},{"id":"manas-2010:p1436:b001:l030","ordinal":62017,"en":"He vowed a horse to Babedin:"},{"id":"manas-2010:p1436:b001:l031","ordinal":62018,"en":"“Even if I die, I have no regret;"},{"id":"manas-2010:p1436:b001:l032","ordinal":62019,"en":"Not a speck of regret remains in me!"},{"id":"manas-2010:p1436:b001:l033","ordinal":62020,"en":"I may give myself to Heaven."},{"id":"manas-2010:p1436:b001:l034","ordinal":62021,"en":"Now that such news has reached me,"},{"id":"manas-2010:p1436:b001:l035","ordinal":62022,"en":"How could I remain downcast?"},{"id":"manas-2010:p1436:b001:l036","ordinal":62023,"en":"Sarala, the charger among horses,"},{"id":"manas-2010:p1436:b001:l037","ordinal":62024,"en":"I shall slaughter as a sacrifice."},{"id":"manas-2010:p1436:b001:l038","ordinal":62025,"en":"The sorrow within my heart—"},{"id":"manas-2010:p1436:b001:l039","ordinal":62026,"en":"Thus shall I clear it away!”"},{"id":"manas-2010:p1436:b001:l040","ordinal":62027,"en":"Almambet came rejoicing,"},{"id":"manas-2010:p1436:b001:l041","ordinal":62028,"en":"That outstanding charger Sarala"},{"id":"manas-2010:p1436:b001:l042","ordinal":62029,"en":"To slaughter as a sacrifice."},{"id":"manas-2010:p1437:b001:l001","ordinal":62030,"en":"Then Khan Manas"},{"id":"manas-2010:p1437:b001:l002","ordinal":62031,"en":"Among many different thoughts"},{"id":"manas-2010:p1437:b001:l003","ordinal":62032,"en":"Was dividing his attention."},{"id":"manas-2010:p1437:b001:l004","ordinal":62033,"en":"From atop his golden throne,"},{"id":"manas-2010:p1437:b001:l005","ordinal":62034,"en":"He took up his spyglass,"},{"id":"manas-2010:p1437:b001:l006","ordinal":62035,"en":"Turned its ring,"},{"id":"manas-2010:p1437:b001:l007","ordinal":62036,"en":"Set it firmly to his eye,"},{"id":"manas-2010:p1437:b001:l008","ordinal":62037,"en":"And Almambet approaching"},{"id":"manas-2010:p1437:b001:l009","ordinal":62038,"en":"He saw there before him!"},{"id":"manas-2010:p1437:b001:l010","ordinal":62039,"en":"When he saw Almambet,"},{"id":"manas-2010:p1437:b001:l011","ordinal":62040,"en":"The precious lion who had sat unmoving,"},{"id":"manas-2010:p1437:b001:l012","ordinal":62041,"en":"Lest he suddenly slaughter Sarala,"},{"id":"manas-2010:p1437:b001:l013","ordinal":62042,"en":"That lion warrior took fright."},{"id":"manas-2010:p1437:b001:l014","ordinal":62043,"en":"Lest Almambet in his joy"},{"id":"manas-2010:p1437:b001:l015","ordinal":62044,"en":"Truly bring disaster upon them,"},{"id":"manas-2010:p1437:b001:l016","ordinal":62045,"en":"Lest that noble steed Sarala,"},{"id":"manas-2010:p1437:b001:l017","ordinal":62046,"en":"In his joy, Almambet"},{"id":"manas-2010:p1437:b001:l018","ordinal":62047,"en":"Slaughter as a sacrifice,"},{"id":"manas-2010:p1437:b001:l019","ordinal":62048,"en":"He thought and found a plan."},{"id":"manas-2010:p1437:b001:l020","ordinal":62049,"en":"Argynkhan’s Ajybai,"},{"id":"manas-2010:p1437:b001:l021","ordinal":62050,"en":"With Kalkaman’s Black Horse alongside,"},{"id":"manas-2010:p1437:b001:l022","ordinal":62051,"en":"He sent galloping to meet him."},{"id":"manas-2010:p1437:b001:l023","ordinal":62052,"en":"Kalkaman’s Black Horse—"},{"id":"manas-2010:p1437:b001:l024","ordinal":62053,"en":"Whenever a companion took offense,"},{"id":"manas-2010:p1437:b001:l025","ordinal":62054,"en":"It was the custom to offer him that horse."},{"id":"manas-2010:p1437:b001:l026","ordinal":62055,"en":"As Sarala was about to be slaughtered,"},{"id":"manas-2010:p1437:b001:l027","ordinal":62056,"en":"It went as a gift, did you see,"},{"id":"manas-2010:p1437:b001:l028","ordinal":62057,"en":"That Black Horse I spoke of."},{"id":"manas-2010:p1437:b001:l029","ordinal":62058,"en":"A gleaming scimitar in his right hand,"},{"id":"manas-2010:p1437:b001:l030","ordinal":62059,"en":"Preventing Sarala’s slaughter,"},{"id":"manas-2010:p1437:b001:l031","ordinal":62060,"en":"Ajybai stood holding him back."},{"id":"manas-2010:p1437:b001:l032","ordinal":62061,"en":"“Do not slaughter Sarala!”"},{"id":"manas-2010:p1437:b001:l033","ordinal":62062,"en":"Ajybai kept imploring:"},{"id":"manas-2010:p1437:b001:l034","ordinal":62063,"en":"“Warrior Almam, heed my words."},{"id":"manas-2010:p1437:b001:l035","ordinal":62064,"en":"The days that God has brought upon us"},{"id":"manas-2010:p1437:b001:l036","ordinal":62065,"en":"We have no choice but to endure."},{"id":"manas-2010:p1437:b001:l037","ordinal":62066,"en":"Consider it, Almambet:"},{"id":"manas-2010:p1437:b001:l038","ordinal":62067,"en":"You lived childless for many years."},{"id":"manas-2010:p1437:b001:l039","ordinal":62068,"en":"If you slaughter Sarala,"},{"id":"manas-2010:p1437:b001:l040","ordinal":62069,"en":"We shall camp along the river;"},{"id":"manas-2010:p1437:b001:l041","ordinal":62070,"en":"Amid an enemy blazing like fire,"},{"id":"manas-2010:p1437:b001:l042","ordinal":62071,"en":"We shall be like a fire put out!"},{"id":"manas-2010:p1438:b001:l001","ordinal":62072,"en":"“If you sacrifice Sarala,"},{"id":"manas-2010:p1438:b001:l002","ordinal":62073,"en":"Will the Chinese not dance and laugh?"},{"id":"manas-2010:p1438:b001:l003","ordinal":62074,"en":"‘The rash fugitive’s"},{"id":"manas-2010:p1438:b001:l004","ordinal":62075,"en":"Back is broken!’ will they not say?"},{"id":"manas-2010:p1438:b001:l005","ordinal":62076,"en":"Heed my words, Almambet:"},{"id":"manas-2010:p1438:b001:l006","ordinal":62077,"en":"For a child still in the womb,"},{"id":"manas-2010:p1438:b001:l007","ordinal":62078,"en":"By sacrificing Sarala,"},{"id":"manas-2010:p1438:b001:l008","ordinal":62079,"en":"Do not break my back."},{"id":"manas-2010:p1438:b001:l009","ordinal":62080,"en":"Where a horse could be sacrificed without shame,"},{"id":"manas-2010:p1438:b001:l010","ordinal":62081,"en":"Here are no tamarisk-grown plains of Keng-Kol;"},{"id":"manas-2010:p1438:b001:l011","ordinal":62082,"en":"Do not sacrifice Sarala;"},{"id":"manas-2010:p1438:b001:l012","ordinal":62083,"en":"Where Sarala could be sacrificed,"},{"id":"manas-2010:p1438:b001:l013","ordinal":62084,"en":"Here are no banks of great Talas!"},{"id":"manas-2010:p1438:b001:l014","ordinal":62085,"en":"Now, by unbelievers of another faith,"},{"id":"manas-2010:p1438:b001:l015","ordinal":62086,"en":"We are held surrounded;"},{"id":"manas-2010:p1438:b001:l016","ordinal":62087,"en":"By the red-tasselled Chinese,"},{"id":"manas-2010:p1438:b001:l017","ordinal":62088,"en":"We are held under pressure."},{"id":"manas-2010:p1438:b001:l018","ordinal":62089,"en":"Of the red sword of steel,"},{"id":"manas-2010:p1438:b001:l019","ordinal":62090,"en":"We stand at the collar of its hilt;"},{"id":"manas-2010:p1438:b001:l020","ordinal":62091,"en":"Among the Chinese whom no torrent reaches,"},{"id":"manas-2010:p1438:b001:l021","ordinal":62092,"en":"We stand in their midst!"},{"id":"manas-2010:p1438:b001:l022","ordinal":62093,"en":"If they draw their bows like falling rain,"},{"id":"manas-2010:p1438:b001:l023","ordinal":62094,"en":"If the Chinese mass and overwhelm us,"},{"id":"manas-2010:p1438:b001:l024","ordinal":62095,"en":"With no courser to ride on reconnaissance,"},{"id":"manas-2010:p1438:b001:l025","ordinal":62096,"en":"Will our strength not leave us?"},{"id":"manas-2010:p1438:b001:l026","ordinal":62097,"en":"If we part with Sarala,"},{"id":"manas-2010:p1438:b001:l027","ordinal":62098,"en":"This Beijing that Chalyar never reached,"},{"id":"manas-2010:p1438:b001:l028","ordinal":62099,"en":"Will it not mass and overwhelm us?"},{"id":"manas-2010:p1438:b001:l029","ordinal":62100,"en":"Think a little, Almambet:"},{"id":"manas-2010:p1438:b001:l030","ordinal":62101,"en":"Will our means not fail us then?"},{"id":"manas-2010:p1438:b001:l031","ordinal":62102,"en":"Sarala beneath you"},{"id":"manas-2010:p1438:b001:l032","ordinal":62103,"en":"Was your wing: do not fold it!"},{"id":"manas-2010:p1438:b001:l033","ordinal":62104,"en":"Black night will fall upon your head."},{"id":"manas-2010:p1438:b001:l034","ordinal":62105,"en":"If you heed me, Almambet,"},{"id":"manas-2010:p1438:b001:l035","ordinal":62106,"en":"Do not part with Sarala!"},{"id":"manas-2010:p1438:b001:l036","ordinal":62107,"en":"If you part with Sarala,"},{"id":"manas-2010:p1438:b001:l037","ordinal":62108,"en":"Will those Chinese, crying out,"},{"id":"manas-2010:p1438:b001:l038","ordinal":62109,"en":"Not surround you,"},{"id":"manas-2010:p1438:b001:l039","ordinal":62110,"en":"Will they not bring hell upon your head?"},{"id":"manas-2010:p1438:b001:l040","ordinal":62111,"en":"If you part with Sarala,"},{"id":"manas-2010:p1438:b001:l041","ordinal":62112,"en":"Will they not surround you?"},{"id":"manas-2010:p1438:b001:l042","ordinal":62113,"en":"The fierce enemy all around you,"},{"id":"manas-2010:p1439:b001:l001","ordinal":62114,"en":"Will they not throw you in a deep pit?"},{"id":"manas-2010:p1439:b001:l002","ordinal":62115,"en":"My ocean, Almambet, heed my words:"},{"id":"manas-2010:p1439:b001:l003","ordinal":62116,"en":"Sacrifice this one, not Sarala!”"},{"id":"manas-2010:p1439:b001:l004","ordinal":62117,"en":"Broad jaw, broad tongue,"},{"id":"manas-2010:p1439:b001:l005","ordinal":62118,"en":"Azhybay, peerless in speech,"},{"id":"manas-2010:p1439:b001:l006","ordinal":62119,"en":"Stood holding the black horse."},{"id":"manas-2010:p1439:b001:l007","ordinal":62120,"en":"To your unshaken Almambet,"},{"id":"manas-2010:p1439:b001:l008","ordinal":62121,"en":"Kalkaman’s black horse,"},{"id":"manas-2010:p1439:b001:l009","ordinal":62122,"en":"Before your noble hawk,"},{"id":"manas-2010:p1439:b001:l010","ordinal":62123,"en":"He presented it crosswise."},{"id":"manas-2010:p1439:b001:l011","ordinal":62124,"en":"Unable to stand still, Almambet,"},{"id":"manas-2010:p1439:b001:l012","ordinal":62125,"en":"The sabre with a mottled neck,"},{"id":"manas-2010:p1439:b001:l013","ordinal":62126,"en":"Almambet took it up."},{"id":"manas-2010:p1439:b001:l014","ordinal":62127,"en":"The forelock and the ears"},{"id":"manas-2010:p1439:b001:l015","ordinal":62128,"en":"Of Kalkaman’s black horse"},{"id":"manas-2010:p1439:b001:l016","ordinal":62129,"en":"He seized together."},{"id":"manas-2010:p1439:b001:l017","ordinal":62130,"en":"Your unshaken lion,"},{"id":"manas-2010:p1439:b001:l018","ordinal":62131,"en":"After standing a while, the black horse"},{"id":"manas-2010:p1439:b001:l019","ordinal":62132,"en":"He slaughtered as a horse sacrifice."},{"id":"manas-2010:p1439:b001:l020","ordinal":62133,"en":"His heart not bursting from joy,"},{"id":"manas-2010:p1439:b001:l021","ordinal":62134,"en":"With warrior Shuutu following him,"},{"id":"manas-2010:p1439:b001:l022","ordinal":62135,"en":"To Manas on the golden throne,"},{"id":"manas-2010:p1439:b001:l023","ordinal":62136,"en":"He brought him there."},{"id":"manas-2010:p1439:b001:l024","ordinal":62137,"en":"Shuutu stood before Manas"},{"id":"manas-2010:p1439:b001:l025","ordinal":62138,"en":"And told the news from Talas:"},{"id":"manas-2010:p1439:b001:l026","ordinal":62139,"en":"“Along river-filled Talas,"},{"id":"manas-2010:p1439:b001:l027","ordinal":62140,"en":"Your people have filled the pastures."},{"id":"manas-2010:p1439:b001:l028","ordinal":62141,"en":"The child born, Semetey,"},{"id":"manas-2010:p1439:b001:l029","ordinal":62142,"en":"Has grown into a cradle infant."},{"id":"manas-2010:p1439:b001:l030","ordinal":62143,"en":"To the Argyn and Ogoy people,"},{"id":"manas-2010:p1439:b001:l031","ordinal":62144,"en":"The steed standing saddled,"},{"id":"manas-2010:p1439:b001:l032","ordinal":62145,"en":"Without letting its fullness show,"},{"id":"manas-2010:p1439:b001:l033","ordinal":62146,"en":"You yourself, leopard Manas,"},{"id":"manas-2010:p1439:b001:l034","ordinal":62147,"en":"That you yourself were absent,"},{"id":"manas-2010:p1439:b001:l035","ordinal":62148,"en":"She raised her own head as a banner,"},{"id":"manas-2010:p1439:b001:l036","ordinal":62149,"en":"Made her woman’s self a warrior,"},{"id":"manas-2010:p1439:b001:l037","ordinal":62150,"en":"Joined what was broken,"},{"id":"manas-2010:p1439:b001:l038","ordinal":62151,"en":"Gathered what was scattered."},{"id":"manas-2010:p1439:b001:l039","ordinal":62152,"en":"Weeping, Kanykey"},{"id":"manas-2010:p1439:b001:l040","ordinal":62153,"en":"Gave six swift horses."},{"id":"manas-2010:p1439:b001:l041","ordinal":62154,"en":"‘From Beijing that Chalyar never touched,"},{"id":"manas-2010:p1439:b001:l042","ordinal":62155,"en":"Let him return without lingering,’ she said."},{"id":"manas-2010:p1440:b001:l001","ordinal":62156,"en":"‘In Beijing that the Flood never touched,"},{"id":"manas-2010:p1440:b001:l002","ordinal":62157,"en":"Let my mighty lord not linger;"},{"id":"manas-2010:p1440:b001:l003","ordinal":62158,"en":"Let him return to Talas quickly."},{"id":"manas-2010:p1440:b001:l004","ordinal":62159,"en":"In strong-backed Beijing,"},{"id":"manas-2010:p1440:b001:l005","ordinal":62160,"en":"If he lies heedless, he will die."},{"id":"manas-2010:p1440:b001:l006","ordinal":62161,"en":"Let my king take heed:"},{"id":"manas-2010:p1440:b001:l007","ordinal":62162,"en":"This champion Semetey,"},{"id":"manas-2010:p1440:b001:l008","ordinal":62163,"en":"When will he see his only son?"},{"id":"manas-2010:p1440:b001:l009","ordinal":62164,"en":"In Beijing whose ridges are costly,"},{"id":"manas-2010:p1440:b001:l010","ordinal":62165,"en":"If he lies without looking back, he will die."},{"id":"manas-2010:p1440:b001:l011","ordinal":62166,"en":"Even if he does not die, my king"},{"id":"manas-2010:p1440:b001:l012","ordinal":62167,"en":"Will suffer grievous torment."},{"id":"manas-2010:p1440:b001:l013","ordinal":62168,"en":"Let him withdraw from Beijing now;"},{"id":"manas-2010:p1440:b001:l014","ordinal":62169,"en":"Let him return this way,’ she said."},{"id":"manas-2010:p1440:b001:l015","ordinal":62170,"en":"‘In the kakan’s Beijing,"},{"id":"manas-2010:p1440:b001:l016","ordinal":62171,"en":"My king, filled with wrath,"},{"id":"manas-2010:p1440:b001:l017","ordinal":62172,"en":"Untroubled, without thinking,"},{"id":"manas-2010:p1440:b001:l018","ordinal":62173,"en":"Will refuse and stay lying there."},{"id":"manas-2010:p1440:b001:l019","ordinal":62174,"en":"The many troops of seven khans,"},{"id":"manas-2010:p1440:b001:l020","ordinal":62175,"en":"The twelve khans of Islam—"},{"id":"manas-2010:p1440:b001:l021","ordinal":62176,"en":"He will bear the guilt for them...’"},{"id":"manas-2010:p1440:b001:l022","ordinal":62177,"en":"That letter she entrusted to me:"},{"id":"manas-2010:p1440:b001:l023","ordinal":62178,"en":"From the edge of Great Beijing,"},{"id":"manas-2010:p1440:b001:l024","ordinal":62179,"en":"From the jut of the mountain’s end,"},{"id":"manas-2010:p1440:b001:l025","ordinal":62180,"en":"From a dark spur jutting down,"},{"id":"manas-2010:p1440:b001:l026","ordinal":62181,"en":"Cotton sash, wide boots,"},{"id":"manas-2010:p1440:b001:l027","ordinal":62182,"en":"Kongurbay, khan of the monks,"},{"id":"manas-2010:p1440:b001:l028","ordinal":62183,"en":"Charged out with a thunderous roar."},{"id":"manas-2010:p1440:b001:l029","ordinal":62184,"en":"I had no strength to resist;"},{"id":"manas-2010:p1440:b001:l030","ordinal":62185,"en":"My whole body shuddered."},{"id":"manas-2010:p1440:b001:l031","ordinal":62186,"en":"I was terribly alarmed;"},{"id":"manas-2010:p1440:b001:l032","ordinal":62187,"en":"In my fear, sparing nothing,"},{"id":"manas-2010:p1440:b001:l033","ordinal":62188,"en":"I fled before him."},{"id":"manas-2010:p1440:b001:l034","ordinal":62189,"en":"Buurul, just entering maturity,"},{"id":"manas-2010:p1440:b001:l035","ordinal":62190,"en":"Neighed, not letting me rein him in."},{"id":"manas-2010:p1440:b001:l036","ordinal":62191,"en":"Alöökö’s Kongurbay,"},{"id":"manas-2010:p1440:b001:l037","ordinal":62192,"en":"Forcing me against the dark water,"},{"id":"manas-2010:p1440:b001:l038","ordinal":62193,"en":"As he came to trap and catch me,"},{"id":"manas-2010:p1440:b001:l039","ordinal":62194,"en":"As he was about to seize my coat hem,"},{"id":"manas-2010:p1440:b001:l040","ordinal":62195,"en":"Tormenting my solitary life,"},{"id":"manas-2010:p1440:b001:l041","ordinal":62196,"en":"Just as he was about to kill me,"},{"id":"manas-2010:p1440:b001:l042","ordinal":62197,"en":"The fierce, swift Buurul,"},{"id":"manas-2010:p1441:b001:l001","ordinal":62198,"en":"I struck hard upon his thigh."},{"id":"manas-2010:p1441:b001:l002","ordinal":62199,"en":"He turned his neck like a stag;"},{"id":"manas-2010:p1441:b001:l003","ordinal":62200,"en":"The swift courser Taybuurul,"},{"id":"manas-2010:p1441:b001:l004","ordinal":62201,"en":"Through mud an arrowshot across,"},{"id":"manas-2010:p1441:b001:l005","ordinal":62202,"en":"Raced without delay."},{"id":"manas-2010:p1441:b001:l006","ordinal":62203,"en":"The mouth of my belt pouch opened;"},{"id":"manas-2010:p1441:b001:l007","ordinal":62204,"en":"The letter entrusted to me for you"},{"id":"manas-2010:p1441:b001:l008","ordinal":62205,"en":"Spilled into the water and drifted away."},{"id":"manas-2010:p1441:b001:l009","ordinal":62206,"en":"If you say I lost it, take your letter;"},{"id":"manas-2010:p1441:b001:l010","ordinal":62207,"en":"My tiger Manas, leopard,"},{"id":"manas-2010:p1441:b001:l011","ordinal":62208,"en":"Take my livestock, offered in recompense!"}]
