[{"id":"semetey-1-2013:p0971:b005:l037","ordinal":150273,"en":"Had God struck the prince senseless?"},{"id":"semetey-1-2013:p0971:b005:l038","ordinal":150274,"en":"To set the bird upon the swan,"},{"id":"semetey-1-2013:p0971:b005:l039","ordinal":150275,"en":"And have it bring the swan down,"},{"id":"semetey-1-2013:p0972:b003:l001","ordinal":150276,"en":"The poor prince grew eager,"},{"id":"semetey-1-2013:p0972:b003:l002","ordinal":150277,"en":"And appealed to the Almighty."},{"id":"semetey-1-2013:p0972:b003:l003","ordinal":150278,"en":"He gripped the falcon on his arm"},{"id":"semetey-1-2013:p0972:b003:l004","ordinal":150279,"en":"And drew it close against his side;"},{"id":"semetey-1-2013:p0972:b003:l005","ordinal":150280,"en":"He touched Buurul beneath him"},{"id":"semetey-1-2013:p0972:b003:l006","ordinal":150281,"en":"With his heel beneath the foreleg."},{"id":"semetey-1-2013:p0972:b003:l007","ordinal":150282,"en":"The young prince made Buurul"},{"id":"semetey-1-2013:p0972:b003:l008","ordinal":150283,"en":"Step forward with long, rolling strides,"},{"id":"semetey-1-2013:p0972:b003:l009","ordinal":150284,"en":"And trot with a rocking gait;"},{"id":"semetey-1-2013:p0972:b003:l010","ordinal":150285,"en":"He sat holding the bird at an angle,"},{"id":"semetey-1-2013:p0972:b003:l011","ordinal":150286,"en":"Bringing it into the proper position,"},{"id":"semetey-1-2013:p0972:b003:l012","ordinal":150287,"en":"And made the falcon quiver,"},{"id":"semetey-1-2013:p0972:b003:l013","ordinal":150288,"en":"Ready to remove its hood."},{"id":"semetey-1-2013:p0972:b003:l014","ordinal":150289,"en":"The tiger who loomed like a mountain"},{"id":"semetey-1-2013:p0972:b003:l015","ordinal":150290,"en":"Prepared to cast it headlong,"},{"id":"semetey-1-2013:p0972:b003:l016","ordinal":150291,"en":"And made the falcon ready."},{"id":"semetey-1-2013:p0972:b003:l017","ordinal":150292,"en":"Kulchoro and Kanchoro,"},{"id":"semetey-1-2013:p0972:b003:l018","ordinal":150293,"en":"These two legacies left by bygone lions,"},{"id":"semetey-1-2013:p0972:b003:l019","ordinal":150294,"en":"Came racing up together,"},{"id":"semetey-1-2013:p0972:b003:l020","ordinal":150295,"en":"With Kulchoro crying urgently;"},{"id":"semetey-1-2013:p0972:b003:l021","ordinal":150296,"en":"The two of them arrived."},{"id":"semetey-1-2013:p0972:b003:l022","ordinal":150297,"en":"Tall and broad-shouldered,"},{"id":"semetey-1-2013:p0972:b003:l023","ordinal":150298,"en":"Kulchoro, son of Almambet,"},{"id":"semetey-1-2013:p0972:b003:l024","ordinal":150299,"en":"Both a strongman and a lion,"},{"id":"semetey-1-2013:p0972:b003:l025","ordinal":150300,"en":"Began speaking these words"},{"id":"semetey-1-2013:p0972:b003:l026","ordinal":150301,"en":"To his elder kinsman:"},{"id":"semetey-1-2013:p0972:b003:l027","ordinal":150302,"en":"“Kulchoro and Kanchoro—"},{"id":"semetey-1-2013:p0972:b003:l028","ordinal":150303,"en":"We two were twin boys,"},{"id":"semetey-1-2013:p0972:b003:l029","ordinal":150304,"en":"And souls who became companions to you."},{"id":"semetey-1-2013:p0972:b003:l030","ordinal":150305,"en":"If we choro died,"},{"id":"semetey-1-2013:p0972:b003:l031","ordinal":150306,"en":"We were sons worth no more than dog hide;"},{"id":"semetey-1-2013:p0972:b003:l032","ordinal":150307,"en":"While we remained alive,"},{"id":"semetey-1-2013:p0972:b003:l033","ordinal":150308,"en":"We were servants worth no more than sheepskin."},{"id":"semetey-1-2013:p0972:b003:l034","ordinal":150309,"en":"Having girded his waist firmly,"},{"id":"semetey-1-2013:p0972:b003:l035","ordinal":150310,"en":"The brave Semetey"},{"id":"semetey-1-2013:p0972:b003:l036","ordinal":150311,"en":"Was born together"},{"id":"semetey-1-2013:p0972:b003:l037","ordinal":150312,"en":"With our own selves."},{"id":"semetey-1-2013:p0972:b003:l038","ordinal":150313,"en":"Your dear mother Kanykey,"},{"id":"semetey-1-2013:p0972:b003:l039","ordinal":150314,"en":"Who shared the bloodline of Manas, now gone beyond,"},{"id":"semetey-1-2013:p0972:b004:l001","ordinal":150315,"en":"Came forth wounded from her womb;"},{"id":"semetey-1-2013:p0972:b004:l002","ordinal":150316,"en":"Look here, tiger—"},{"id":"semetey-1-2013:p0972:b004:l003","ordinal":150317,"en":"When were we ever sons of Manas?"},{"id":"semetey-1-2013:p0972:b004:l004","ordinal":150318,"en":"My poor elder kinsman, hear my words."},{"id":"semetey-1-2013:p0972:b004:l005","ordinal":150319,"en":"Though we are servants, if we grow unruly,"},{"id":"semetey-1-2013:p0972:b004:l006","ordinal":150320,"en":"While you, my khan and elder, are here,"},{"id":"semetey-1-2013:p0972:b004:l007","ordinal":150321,"en":"And rage and swallow our anger,"},{"id":"semetey-1-2013:p0972:b004:l008","ordinal":150322,"en":"If we set the bird upon the swan"},{"id":"semetey-1-2013:p0972:b004:l009","ordinal":150323,"en":"And drink our fill of joy,"},{"id":"semetey-1-2013:p0972:b004:l010","ordinal":150324,"en":"While our tiger elder is present,"},{"id":"semetey-1-2013:p0972:b004:l011","ordinal":150325,"en":"Let us cough loudly together"},{"id":"semetey-1-2013:p0972:b004:l012","ordinal":150326,"en":"And raise our downcast spirits!"},{"id":"semetey-1-2013:p0972:b004:l013","ordinal":150327,"en":"When you mounted a horse, you mounted indeed,"},{"id":"semetey-1-2013:p0972:b004:l014","ordinal":150328,"en":"My elder, Prince Semetey—"},{"id":"semetey-1-2013:p0972:b004:l015","ordinal":150329,"en":"What horns have you suddenly grown?"},{"id":"semetey-1-2013:p0972:b004:l016","ordinal":150330,"en":"Your Akshunkar should alight"},{"id":"semetey-1-2013:p0972:b004:l017","ordinal":150331,"en":"Upon the hands of these two;"},{"id":"semetey-1-2013:p0972:b004:l018","ordinal":150332,"en":"If you fly the falcon alone,"},{"id":"semetey-1-2013:p0972:b004:l019","ordinal":150333,"en":"You would need two heads!”"},{"id":"semetey-1-2013:p0972:b004:l020","ordinal":150334,"en":"While the boys spoke in this way,"},{"id":"semetey-1-2013:p0972:b004:l021","ordinal":150335,"en":"The world lay level around them,"},{"id":"semetey-1-2013:p0972:b004:l022","ordinal":150336,"en":"And the sea spread out like this;"},{"id":"semetey-1-2013:p0972:b004:l023","ordinal":150337,"en":"When one looked into its depths,"},{"id":"semetey-1-2013:p0972:b004:l024","ordinal":150338,"en":"It seemed broader than the face of the earth."},{"id":"semetey-1-2013:p0972:b004:l025","ordinal":150339,"en":"He could not say of the falcon on his hand,"},{"id":"semetey-1-2013:p0972:b004:l026","ordinal":150340,"en":"“I will not give it,”"},{"id":"semetey-1-2013:p0972:b004:l027","ordinal":150341,"en":"Nor turn away the brave man’s wish;"},{"id":"semetey-1-2013:p0972:b004:l028","ordinal":150342,"en":"The famous heir of Manas"},{"id":"semetey-1-2013:p0972:b004:l029","ordinal":150343,"en":"Handed over the falcon."},{"id":"semetey-1-2013:p0972:b004:l030","ordinal":150344,"en":"Eager to fly it at the swan,"},{"id":"semetey-1-2013:p0972:b004:l031","ordinal":150345,"en":"Kulchoro took it,"},{"id":"semetey-1-2013:p0972:b004:l032","ordinal":150346,"en":"Steadied all his thoughts,"},{"id":"semetey-1-2013:p0972:b004:l033","ordinal":150347,"en":"And settled the white falcon on his hand."},{"id":"semetey-1-2013:p0972:b004:l034","ordinal":150348,"en":"Taking the falcon, Kulchoro"},{"id":"semetey-1-2013:p0972:b004:l035","ordinal":150349,"en":"Fastened and secured it again,"},{"id":"semetey-1-2013:p0972:b004:l036","ordinal":150350,"en":"Attached Akshunkar’s long leash"},{"id":"semetey-1-2013:p0972:b004:l037","ordinal":150351,"en":"To the belt around his waist,"},{"id":"semetey-1-2013:p0972:b004:l038","ordinal":150352,"en":"Hurried Semetey onward,"},{"id":"semetey-1-2013:p0972:b004:l039","ordinal":150353,"en":"Though he did not know the proper way to the contest,"},{"id":"semetey-1-2013:p0973:b003:l001","ordinal":150354,"en":"Not knowing the manner of how"},{"id":"semetey-1-2013:p0973:b003:l002","ordinal":150355,"en":"One should approach the swan,"},{"id":"semetey-1-2013:p0973:b003:l003","ordinal":150356,"en":"He came trotting with pounding hooves,"},{"id":"semetey-1-2013:p0973:b003:l004","ordinal":150357,"en":"Saying, “Let the swan fly away,”"},{"id":"semetey-1-2013:p0973:b003:l005","ordinal":150358,"en":"And drove it into full view."},{"id":"semetey-1-2013:p0973:b003:l006","ordinal":150359,"en":"Unable to contain his excitement,"},{"id":"semetey-1-2013:p0973:b003:l007","ordinal":150360,"en":"Semetey came riding up."},{"id":"semetey-1-2013:p0973:b003:l008","ordinal":150361,"en":"Then Kulchoro spoke these words,"},{"id":"semetey-1-2013:p0973:b003:l009","ordinal":150362,"en":"Uttering an uncanny thought no man could know:"},{"id":"semetey-1-2013:p0973:b003:l010","ordinal":150363,"en":"“Understand my precious words;"},{"id":"semetey-1-2013:p0973:b003:l011","ordinal":150364,"en":"Blessed elder, heed what I say!"},{"id":"semetey-1-2013:p0973:b003:l012","ordinal":150365,"en":"Let us not set the bird upon the swan,"},{"id":"semetey-1-2013:p0973:b003:l013","ordinal":150366,"en":"And not drink our fill of joy."},{"id":"semetey-1-2013:p0973:b003:l014","ordinal":150367,"en":"I have looked upon this swan;"},{"id":"semetey-1-2013:p0973:b003:l015","ordinal":150368,"en":"When it calls with that resonant cry,"},{"id":"semetey-1-2013:p0973:b003:l016","ordinal":150369,"en":"Its voice is unlike a swan’s."},{"id":"semetey-1-2013:p0973:b003:l017","ordinal":150370,"en":"When it shakes itself like drifting sand,"},{"id":"semetey-1-2013:p0973:b003:l018","ordinal":150371,"en":"Its form changes a thousand ways."},{"id":"semetey-1-2013:p0973:b003:l019","ordinal":150372,"en":"It must be one of the spirits,"},{"id":"semetey-1-2013:p0973:b003:l020","ordinal":150373,"en":"The very embodiment of a sacred power."},{"id":"semetey-1-2013:p0973:b003:l021","ordinal":150374,"en":"It has transformed itself into a swan;"},{"id":"semetey-1-2013:p0973:b003:l022","ordinal":150375,"en":"My poor elder, hear my words:"},{"id":"semetey-1-2013:p0973:b003:l023","ordinal":150376,"en":"It is the source of some great calamity,"},{"id":"semetey-1-2013:p0973:b003:l024","ordinal":150377,"en":"A swan come from Mecca,"},{"id":"semetey-1-2013:p0973:b003:l025","ordinal":150378,"en":"And it has five young."},{"id":"semetey-1-2013:p0973:b003:l026","ordinal":150379,"en":"Let us not bring it down for nothing,"},{"id":"semetey-1-2013:p0973:b003:l027","ordinal":150380,"en":"And fall into its curse."},{"id":"semetey-1-2013:p0973:b003:l028","ordinal":150381,"en":"Bloodthirsty elder, listen:"},{"id":"semetey-1-2013:p0973:b003:l029","ordinal":150382,"en":"If we fly a bird at this swan of omen,"},{"id":"semetey-1-2013:p0973:b003:l030","ordinal":150383,"en":"It will bring shame upon us."},{"id":"semetey-1-2013:p0973:b003:l031","ordinal":150384,"en":"This swan is no ordinary creature;"},{"id":"semetey-1-2013:p0973:b003:l032","ordinal":150385,"en":"It has a form resembling a human,"},{"id":"semetey-1-2013:p0973:b003:l033","ordinal":150386,"en":"Or else it may transform"},{"id":"semetey-1-2013:p0973:b003:l034","ordinal":150387,"en":"And cast its demon upon us."},{"id":"semetey-1-2013:p0973:b003:l035","ordinal":150388,"en":"It is a swan of wondrous power,"},{"id":"semetey-1-2013:p0973:b003:l036","ordinal":150389,"en":"One of the miracles!”"},{"id":"semetey-1-2013:p0973:b003:l037","ordinal":150390,"en":"While the boy spoke in this way,"},{"id":"semetey-1-2013:p0973:b003:l038","ordinal":150391,"en":"The tiger swelled with daring,"},{"id":"semetey-1-2013:p0973:b003:l039","ordinal":150392,"en":"And with a booming voice"},{"id":"semetey-1-2013:p0973:b004:l001","ordinal":150393,"en":"Spoke to Kulchoro:"},{"id":"semetey-1-2013:p0973:b004:l002","ordinal":150394,"en":"“How much sin can there be in a swan?"},{"id":"semetey-1-2013:p0973:b004:l003","ordinal":150395,"en":"Boy, you have grown quite mad."},{"id":"semetey-1-2013:p0973:b004:l004","ordinal":150396,"en":"For no good reason you hunger"},{"id":"semetey-1-2013:p0973:b004:l005","ordinal":150397,"en":"To say, ‘I shall fly the bird.’"},{"id":"semetey-1-2013:p0973:b004:l006","ordinal":150398,"en":"Though still a boy yourself,"},{"id":"semetey-1-2013:p0973:b004:l007","ordinal":150399,"en":"You stand there like a bakshy,"},{"id":"semetey-1-2013:p0973:b004:l008","ordinal":150400,"en":"Reciting every omen;"},{"id":"semetey-1-2013:p0973:b004:l009","ordinal":150401,"en":"You have become a fine one indeed."},{"id":"semetey-1-2013:p0973:b004:l010","ordinal":150402,"en":"Taking omens from things that do not exist,"},{"id":"semetey-1-2013:p0973:b004:l011","ordinal":150403,"en":"You have frightened yourself,"},{"id":"semetey-1-2013:p0973:b004:l012","ordinal":150404,"en":"Muttering so many words"},{"id":"semetey-1-2013:p0973:b004:l013","ordinal":150405,"en":"That you bar my way."},{"id":"semetey-1-2013:p0973:b004:l014","ordinal":150406,"en":"If it is a swan come from Mecca,"},{"id":"semetey-1-2013:p0973:b004:l015","ordinal":150407,"en":"If it has five young,"},{"id":"semetey-1-2013:p0973:b004:l016","ordinal":150408,"en":"Let it face me and swallow me;"},{"id":"semetey-1-2013:p0973:b004:l017","ordinal":150409,"en":"If it is a swan of wondrous power,"},{"id":"semetey-1-2013:p0973:b004:l018","ordinal":150410,"en":"Let it kill me outright."},{"id":"semetey-1-2013:p0973:b004:l019","ordinal":150411,"en":"Is there sin in taking a swan?"},{"id":"semetey-1-2013:p0973:b004:l020","ordinal":150412,"en":"Can one prosper by fearing a bird?"},{"id":"semetey-1-2013:p0973:b004:l021","ordinal":150413,"en":"Can the sin of killing a swan"},{"id":"semetey-1-2013:p0973:b004:l022","ordinal":150414,"en":"Be greater than that of killing a man?"},{"id":"semetey-1-2013:p0973:b004:l023","ordinal":150415,"en":"When I had reached the age of twelve,"},{"id":"semetey-1-2013:p0973:b004:l024","ordinal":150416,"en":"There in the fortress of Bukhara,"},{"id":"semetey-1-2013:p0973:b004:l025","ordinal":150417,"en":"When my father Temir Khan"},{"id":"semetey-1-2013:p0973:b004:l026","ordinal":150418,"en":"Agreed to what I asked,"},{"id":"semetey-1-2013:p0973:b004:l027","ordinal":150419,"en":"And held the funeral feast for my father Manas,"},{"id":"semetey-1-2013:p0973:b004:l028","ordinal":150420,"en":"I began my feats of destruction:"},{"id":"semetey-1-2013:p0973:b004:l029","ordinal":150421,"en":"I tore one arm completely"},{"id":"semetey-1-2013:p0973:b004:l030","ordinal":150422,"en":"From the camel-strong wrestler."},{"id":"semetey-1-2013:p0973:b004:l031","ordinal":150423,"en":"Where then was my death?"},{"id":"semetey-1-2013:p0973:b004:l032","ordinal":150424,"en":"Where did sin overtake me?"},{"id":"semetey-1-2013:p0973:b004:l033","ordinal":150425,"en":"When I migrated to Talas,"},{"id":"semetey-1-2013:p0973:b004:l034","ordinal":150426,"en":"I loaded my cartridge pouch and fired,"},{"id":"semetey-1-2013:p0973:b004:l035","ordinal":150427,"en":"And among the Kokand champions,"},{"id":"semetey-1-2013:p0973:b004:l036","ordinal":150428,"en":"Beginning with Janaaly and Karach,"},{"id":"semetey-1-2013:p0973:b004:l037","ordinal":150429,"en":"I devoured them all without remainder."},{"id":"semetey-1-2013:p0973:b004:l038","ordinal":150430,"en":"Where then was my death?"},{"id":"semetey-1-2013:p0973:b004:l039","ordinal":150431,"en":"Where did sin overtake me?”"},{"id":"semetey-1-2013:p0974:b003:l001","ordinal":150432,"en":"I bloodied the deep-flowing river;"},{"id":"semetey-1-2013:p0974:b003:l002","ordinal":150433,"en":"When my quarrel came upon me,"},{"id":"semetey-1-2013:p0974:b003:l003","ordinal":150434,"en":"I laid low my own father."},{"id":"semetey-1-2013:p0974:b003:l004","ordinal":150435,"en":"I bloodied my white blade;"},{"id":"semetey-1-2013:p0974:b003:l005","ordinal":150436,"en":"When my anger truly rose,"},{"id":"semetey-1-2013:p0974:b003:l006","ordinal":150437,"en":"I laid Abyke low."},{"id":"semetey-1-2013:p0974:b003:l007","ordinal":150438,"en":"I bloodied my blue-steel blade;"},{"id":"semetey-1-2013:p0974:b003:l008","ordinal":150439,"en":"When my great fury came upon me,"},{"id":"semetey-1-2013:p0974:b003:l009","ordinal":150440,"en":"I laid Khan Köbösh low."},{"id":"semetey-1-2013:p0974:b003:l010","ordinal":150441,"en":"I slaughtered the forty choros,"},{"id":"semetey-1-2013:p0974:b003:l011","ordinal":150442,"en":"And slaughtered them for what they had done."},{"id":"semetey-1-2013:p0974:b003:l012","ordinal":150443,"en":"I burned the rolling country,"},{"id":"semetey-1-2013:p0974:b003:l013","ordinal":150444,"en":"And set the grassy land aflame."},{"id":"semetey-1-2013:p0974:b003:l014","ordinal":150445,"en":"I poured blood into the dark water—"},{"id":"semetey-1-2013:p0974:b003:l015","ordinal":150446,"en":"Where then was my death?”"},{"id":"semetey-1-2013:p0974:b003:l016","ordinal":150447,"en":"The dear lion raged,"},{"id":"semetey-1-2013:p0974:b003:l017","ordinal":150448,"en":"The renowned hero left as an heir"},{"id":"semetey-1-2013:p0974:b003:l018","ordinal":150449,"en":"By the blue-maned champion Manas;"},{"id":"semetey-1-2013:p0974:b003:l019","ordinal":150450,"en":"His anger now rose unchecked,"},{"id":"semetey-1-2013:p0974:b003:l020","ordinal":150451,"en":"And he tore the falcon from Kulchoro’s hand."},{"id":"semetey-1-2013:p0974:b003:l021","ordinal":150452,"en":"When the precious leash braided by Kanykey"},{"id":"semetey-1-2013:p0974:b003:l022","ordinal":150453,"en":"Was pulled taut as the level sea,"},{"id":"semetey-1-2013:p0974:b003:l023","ordinal":150454,"en":"One half of that leash snapped"},{"id":"semetey-1-2013:p0974:b003:l024","ordinal":150455,"en":"And remained with Kulchoro;"},{"id":"semetey-1-2013:p0974:b003:l025","ordinal":150456,"en":"Your swaggering madman"},{"id":"semetey-1-2013:p0974:b003:l026","ordinal":150457,"en":"Wrenched the falcon away."},{"id":"semetey-1-2013:p0974:b003:l027","ordinal":150458,"en":"He swept off its hood,"},{"id":"semetey-1-2013:p0974:b003:l028","ordinal":150459,"en":"And showed it the white swan;"},{"id":"semetey-1-2013:p0974:b003:l029","ordinal":150460,"en":"Water streamed from its nostrils,"},{"id":"semetey-1-2013:p0974:b003:l030","ordinal":150461,"en":"Its throat feathers bristled,"},{"id":"semetey-1-2013:p0974:b003:l031","ordinal":150462,"en":"It toppled and cried harshly,"},{"id":"semetey-1-2013:p0974:b003:l032","ordinal":150463,"en":"Struggled and flashed,"},{"id":"semetey-1-2013:p0974:b003:l033","ordinal":150464,"en":"And would not remain upon the hand."},{"id":"semetey-1-2013:p0974:b003:l034","ordinal":150465,"en":"Your madman’s falcon"},{"id":"semetey-1-2013:p0974:b003:l035","ordinal":150466,"en":"Surged forward, unaware it might die;"},{"id":"semetey-1-2013:p0974:b003:l036","ordinal":150467,"en":"And your prince himself said,"},{"id":"semetey-1-2013:p0974:b003:l037","ordinal":150468,"en":"“Before it reaches the marked place,"},{"id":"semetey-1-2013:p0974:b003:l038","ordinal":150469,"en":"It will leave us cursed,”"},{"id":"semetey-1-2013:p0974:b003:l039","ordinal":150470,"en":"And waved it toward the open side,"},{"id":"semetey-1-2013:p0974:b004:l001","ordinal":150471,"en":"Thrusting it in every direction."},{"id":"semetey-1-2013:p0974:b004:l002","ordinal":150472,"en":"His temples tightened with fury,"},{"id":"semetey-1-2013:p0974:b004:l003","ordinal":150473,"en":"And Semetey, brave son of Manas,"},{"id":"semetey-1-2013:p0974:b004:l004","ordinal":150474,"en":"Struggled with Akshunkar."},{"id":"semetey-1-2013:p0974:b004:l005","ordinal":150475,"en":"“It has reached the very height of its form,” he said;"},{"id":"semetey-1-2013:p0974:b004:l006","ordinal":150476,"en":"“It has stood pent up for many days"},{"id":"semetey-1-2013:p0974:b004:l007","ordinal":150477,"en":"And wholly passed beyond its proper form,” he said."},{"id":"semetey-1-2013:p0974:b004:l008","ordinal":150478,"en":"Driving it onward without tiring,"},{"id":"semetey-1-2013:p0974:b004:l009","ordinal":150479,"en":"Thinking it might strike a stone,"},{"id":"semetey-1-2013:p0974:b004:l010","ordinal":150480,"en":"He pulled the mouth of tireless Buurul"},{"id":"semetey-1-2013:p0974:b004:l011","ordinal":150481,"en":"And turned the horse around."},{"id":"semetey-1-2013:p0974:b004:l012","ordinal":150482,"en":"“Go, wondrous creature,” he said;"},{"id":"semetey-1-2013:p0974:b004:l013","ordinal":150483,"en":"“Put all your strength into it,” he said,"},{"id":"semetey-1-2013:p0974:b004:l014","ordinal":150484,"en":"And raised the bucket-sized falcon"},{"id":"semetey-1-2013:p0974:b004:l015","ordinal":150485,"en":"Before hurling it aloft."},{"id":"semetey-1-2013:p0974:b004:l016","ordinal":150486,"en":"Your noble Akshunkar"},{"id":"semetey-1-2013:p0974:b004:l017","ordinal":150487,"en":"Shot from the glove like an arrow;"},{"id":"semetey-1-2013:p0974:b004:l018","ordinal":150488,"en":"The blue-maned hero’s falcon"},{"id":"semetey-1-2013:p0974:b004:l019","ordinal":150489,"en":"Rose and set itself on course,"},{"id":"semetey-1-2013:p0974:b004:l020","ordinal":150490,"en":"Soon seeming lost from sight."},{"id":"semetey-1-2013:p0974:b004:l021","ordinal":150491,"en":"It circled and hovered,"},{"id":"semetey-1-2013:p0974:b004:l022","ordinal":150492,"en":"Banked backward in flight,"},{"id":"semetey-1-2013:p0974:b004:l023","ordinal":150493,"en":"And beat its wings."},{"id":"semetey-1-2013:p0974:b004:l024","ordinal":150494,"en":"When the madman’s falcon"},{"id":"semetey-1-2013:p0974:b004:l025","ordinal":150495,"en":"Caught sight of the swan,"},{"id":"semetey-1-2013:p0974:b004:l026","ordinal":150496,"en":"It thundered till ears went deaf,"},{"id":"semetey-1-2013:p0974:b004:l027","ordinal":150497,"en":"And roared as though no bigger than a fist."},{"id":"semetey-1-2013:p0974:b004:l028","ordinal":150498,"en":"It reached the tent-sized white swan"},{"id":"semetey-1-2013:p0974:b004:l029","ordinal":150499,"en":"Before an arrow could,"},{"id":"semetey-1-2013:p0974:b004:l030","ordinal":150500,"en":"Drove that swan down against the earth,"},{"id":"semetey-1-2013:p0974:b004:l031","ordinal":150501,"en":"And struck it as it swept past."},{"id":"semetey-1-2013:p0974:b004:l032","ordinal":150502,"en":"Dust flew and feathers billowed;"},{"id":"semetey-1-2013:p0974:b004:l033","ordinal":150503,"en":"When Akshunkar struck it,"},{"id":"semetey-1-2013:p0974:b004:l034","ordinal":150504,"en":"Its cry was heard in the heavens."},{"id":"semetey-1-2013:p0974:b004:l035","ordinal":150505,"en":"The tent-sized white swan’s"},{"id":"semetey-1-2013:p0974:b004:l036","ordinal":150506,"en":"Head plunged into the mud;"},{"id":"semetey-1-2013:p0974:b004:l037","ordinal":150507,"en":"Its strength failed as it staggered,"},{"id":"semetey-1-2013:p0974:b004:l038","ordinal":150508,"en":"And it crawled toward the gray reeds,"},{"id":"semetey-1-2013:p0974:b004:l039","ordinal":150509,"en":"Calling “Kukulook!” as it floundered,"},{"id":"semetey-1-2013:p0975:b003:l001","ordinal":150510,"en":"Its strength gone, it waddled,"},{"id":"semetey-1-2013:p0975:b003:l002","ordinal":150511,"en":"And that white swan stood exhausted."},{"id":"semetey-1-2013:p0975:b003:l003","ordinal":150512,"en":"Semetey’s great war drum,"},{"id":"semetey-1-2013:p0975:b003:l004","ordinal":150513,"en":"Covered in waist hide—"},{"id":"semetey-1-2013:p0975:b003:l005","ordinal":150514,"en":"The mighty drum was made to resound perfectly;"},{"id":"semetey-1-2013:p0975:b003:l006","ordinal":150515,"en":"Was it not Bölekbay’s skill"},{"id":"semetey-1-2013:p0975:b003:l007","ordinal":150516,"en":"That fashioned the mighty drum so well?"},{"id":"semetey-1-2013:p0975:b003:l008","ordinal":150517,"en":"When it was struck in the central land,"},{"id":"semetey-1-2013:p0975:b003:l009","ordinal":150518,"en":"Its blow could truly carry"},{"id":"semetey-1-2013:p0975:b003:l010","ordinal":150519,"en":"Across a journey of six days."},{"id":"semetey-1-2013:p0975:b003:l011","ordinal":150520,"en":"When the war drum was beaten hard,"},{"id":"semetey-1-2013:p0975:b003:l012","ordinal":150521,"en":"The earth split with its rumbling,"},{"id":"semetey-1-2013:p0975:b003:l013","ordinal":150522,"en":"And the mountains echoed and roared."},{"id":"semetey-1-2013:p0975:b003:l014","ordinal":150523,"en":"The leopard struck the war drum;"},{"id":"semetey-1-2013:p0975:b003:l015","ordinal":150524,"en":"In the marshes of Ala-Köl,"},{"id":"semetey-1-2013:p0975:b003:l016","ordinal":150525,"en":"While the tiger’s Akshunkar"},{"id":"semetey-1-2013:p0975:b003:l017","ordinal":150526,"en":"Fought with the white swan"},{"id":"semetey-1-2013:p0975:b003:l018","ordinal":150527,"en":"And remained locked in struggle,"},{"id":"semetey-1-2013:p0975:b003:l019","ordinal":150528,"en":"He shouted, “Manas! Manas!”"}]
