[{"id":"semetey-1-2013:p1078:b004:l021","ordinal":158465,"en":"Day passed and night came,"},{"id":"semetey-1-2013:p1078:b004:l022","ordinal":158466,"en":"Darkness settled as brows turned black."},{"id":"semetey-1-2013:p1078:b004:l023","ordinal":158467,"en":"His eyes bound by night travel,"},{"id":"semetey-1-2013:p1078:b004:l024","ordinal":158468,"en":"He crossed winding ravines,"},{"id":"semetey-1-2013:p1078:b004:l025","ordinal":158469,"en":"And passed twisting mountains."},{"id":"semetey-1-2013:p1078:b004:l026","ordinal":158470,"en":"Seeing a broad black river,"},{"id":"semetey-1-2013:p1078:b004:l027","ordinal":158471,"en":"He traveled without turning aside,"},{"id":"semetey-1-2013:p1078:b004:l028","ordinal":158472,"en":"Covering much ground without sparing his horse."},{"id":"semetey-1-2013:p1078:b004:l029","ordinal":158473,"en":"Now he drew near"},{"id":"semetey-1-2013:p1078:b004:l030","ordinal":158474,"en":"The junction of nine roads,"},{"id":"semetey-1-2013:p1078:b004:l031","ordinal":158475,"en":"At the boundary of Börü-Koy:"},{"id":"semetey-1-2013:p1078:b004:l032","ordinal":158476,"en":"One road came into Afghanistan,"},{"id":"semetey-1-2013:p1078:b004:l033","ordinal":158477,"en":"A black road went to Kashgar;"},{"id":"semetey-1-2013:p1078:b004:l034","ordinal":158478,"en":"One road came into Afghanistan,"},{"id":"semetey-1-2013:p1078:b004:l035","ordinal":158479,"en":"A straight road went to Turpan;"},{"id":"semetey-1-2013:p1078:b004:l036","ordinal":158480,"en":"One road came into Afghanistan,"},{"id":"semetey-1-2013:p1078:b004:l037","ordinal":158481,"en":"A marked road went to Beijing;"},{"id":"semetey-1-2013:p1078:b004:l038","ordinal":158482,"en":"One road came into Afghanistan—"},{"id":"semetey-1-2013:p1079:b003:l001","ordinal":158483,"en":"A perilous road went to Kokon;"},{"id":"semetey-1-2013:p1079:b003:l002","ordinal":158484,"en":"One road came into Afghanistan,"},{"id":"semetey-1-2013:p1079:b003:l003","ordinal":158485,"en":"The safe road of Andijan."},{"id":"semetey-1-2013:p1079:b003:l004","ordinal":158486,"en":"He circled and surveyed them all;"},{"id":"semetey-1-2013:p1079:b003:l005","ordinal":158487,"en":"The orphan boy Külchoro"},{"id":"semetey-1-2013:p1079:b003:l006","ordinal":158488,"en":"Now marveled at the land."},{"id":"semetey-1-2013:p1079:b003:l007","ordinal":158489,"en":"As Külchoro looked carefully,"},{"id":"semetey-1-2013:p1079:b003:l008","ordinal":158490,"en":"There was the crest of a rise;"},{"id":"semetey-1-2013:p1079:b003:l009","ordinal":158491,"en":"When he rode up and looked,"},{"id":"semetey-1-2013:p1079:b003:l010","ordinal":158492,"en":"There stood Manas's cairn."},{"id":"semetey-1-2013:p1079:b003:l011","ordinal":158493,"en":"Upon the cairn stone"},{"id":"semetey-1-2013:p1079:b003:l012","ordinal":158494,"en":"Was Almambet's inscription."},{"id":"semetey-1-2013:p1079:b003:l013","ordinal":158495,"en":"Yesterday, when they were bringing disgrace"},{"id":"semetey-1-2013:p1079:b003:l014","ordinal":158496,"en":"Upon the kozho in Kokon,"},{"id":"semetey-1-2013:p1079:b003:l015","ordinal":158497,"en":"When they were imposing violent turmoil"},{"id":"semetey-1-2013:p1079:b003:l016","ordinal":158498,"en":"Across the face of the earth,"},{"id":"semetey-1-2013:p1079:b003:l017","ordinal":158499,"en":"When mighty leopard Manas"},{"id":"semetey-1-2013:p1079:b003:l018","ordinal":158500,"en":"Struck the Kyzylbash people"},{"id":"semetey-1-2013:p1079:b003:l019","ordinal":158501,"en":"And returned them facing home,"},{"id":"semetey-1-2013:p1079:b003:l020","ordinal":158502,"en":"That was when heroic leopard Manas"},{"id":"semetey-1-2013:p1079:b003:l021","ordinal":158503,"en":"Had gone down there;"},{"id":"semetey-1-2013:p1079:b003:l022","ordinal":158504,"en":"It was the place where Almambet,"},{"id":"semetey-1-2013:p1079:b003:l023","ordinal":158505,"en":"Chubak, and brave Manas had lain."},{"id":"semetey-1-2013:p1079:b003:l024","ordinal":158506,"en":"\"This is the black stone's inscription;"},{"id":"semetey-1-2013:p1079:b003:l025","ordinal":158507,"en":"This is the name of Khan Almambet."},{"id":"semetey-1-2013:p1079:b003:l026","ordinal":158508,"en":"This is a pass left by the forefathers,"},{"id":"semetey-1-2013:p1079:b003:l027","ordinal":158509,"en":"A place where heroes lay."},{"id":"semetey-1-2013:p1079:b003:l028","ordinal":158510,"en":"It is a pass brave Toltoy"},{"id":"semetey-1-2013:p1079:b003:l029","ordinal":158511,"en":"Will cross without noticing."},{"id":"semetey-1-2013:p1079:b003:l030","ordinal":158512,"en":"Over there is Batkalysh Hill, Besh-Belchir;"},{"id":"semetey-1-2013:p1079:b003:l031","ordinal":158513,"en":"Sovereign God, bring it face to face"},{"id":"semetey-1-2013:p1079:b003:l032","ordinal":158514,"en":"With boastful Toltoy."},{"id":"semetey-1-2013:p1079:b003:l033","ordinal":158515,"en":"If he suddenly arrives,"},{"id":"semetey-1-2013:p1079:b003:l034","ordinal":158516,"en":"If Toltoy unexpectedly appears,"},{"id":"semetey-1-2013:p1079:b003:l035","ordinal":158517,"en":"Let us level our spears straight"},{"id":"semetey-1-2013:p1079:b003:l036","ordinal":158518,"en":"And fight without drawing back."},{"id":"semetey-1-2013:p1079:b003:l037","ordinal":158519,"en":"Let us be drenched in bloody blood,"},{"id":"semetey-1-2013:p1079:b003:l038","ordinal":158520,"en":"And stand fighting without fleeing."},{"id":"semetey-1-2013:p1079:b003:l039","ordinal":158521,"en":"If brave Toltoy suddenly turns and runs,"},{"id":"semetey-1-2013:p1079:b004:l001","ordinal":158522,"en":"Buurul will drive him onto the plain;"},{"id":"semetey-1-2013:p1079:b004:l002","ordinal":158523,"en":"From the feather-grass-covered rise,"},{"id":"semetey-1-2013:p1079:b004:l003","ordinal":158524,"en":"From the broad-backed high pass,"},{"id":"semetey-1-2013:p1079:b004:l004","ordinal":158525,"en":"Unless he dies, Buurul will catch him."},{"id":"semetey-1-2013:p1079:b004:l005","ordinal":158526,"en":"God, guide the path"},{"id":"semetey-1-2013:p1079:b004:l006","ordinal":158527,"en":"Of the lions gone before;"},{"id":"semetey-1-2013:p1079:b004:l007","ordinal":158528,"en":"Lion Manas, with whom twelve joined hands,"},{"id":"semetey-1-2013:p1079:b004:l008","ordinal":158529,"en":"Stand as my protector.\""},{"id":"semetey-1-2013:p1079:b004:l009","ordinal":158530,"en":"Growing bold and bracing himself,"},{"id":"semetey-1-2013:p1079:b004:l010","ordinal":158531,"en":"The renowned leopard kinsman"},{"id":"semetey-1-2013:p1079:b004:l011","ordinal":158532,"en":"Swayed as though struck from this side."},{"id":"semetey-1-2013:p1079:b004:l012","ordinal":158533,"en":"Humming, without a care:"},{"id":"semetey-1-2013:p1079:b004:l013","ordinal":158534,"en":"\"Toltoy of the Zhediger"},{"id":"semetey-1-2013:p1079:b004:l014","ordinal":158535,"en":"Is said to be approaching.\""},{"id":"semetey-1-2013:p1079:b004:l015","ordinal":158536,"en":"He did not value him at his trouser cuff."},{"id":"semetey-1-2013:p1079:b004:l016","ordinal":158537,"en":"God Almighty, the Omnipotent,"},{"id":"semetey-1-2013:p1079:b004:l017","ordinal":158538,"en":"Had given courage and proud daring"},{"id":"semetey-1-2013:p1079:b004:l018","ordinal":158539,"en":"Without measure."},{"id":"semetey-1-2013:p1079:b004:l019","ordinal":158540,"en":"The leopard's Syrnayza—"},{"id":"semetey-1-2013:p1079:b004:l020","ordinal":158541,"en":"Ill-fated Külchoro"},{"id":"semetey-1-2013:p1079:b004:l021","ordinal":158542,"en":"Now took it firmly in his hand."},{"id":"semetey-1-2013:p1079:b004:l022","ordinal":158543,"en":"The white reins steeped in dye"},{"id":"semetey-1-2013:p1079:b004:l023","ordinal":158544,"en":"He wound twice around"},{"id":"semetey-1-2013:p1079:b004:l024","ordinal":158545,"en":"The pommel of Akkangky."},{"id":"semetey-1-2013:p1079:b004:l025","ordinal":158546,"en":"Saying, \"I take the risk—Allah, support me,\""},{"id":"semetey-1-2013:p1079:b004:l026","ordinal":158547,"en":"He now planted Semetey's Syrnayza"},{"id":"semetey-1-2013:p1079:b004:l027","ordinal":158548,"en":"Firmly into the earth."},{"id":"semetey-1-2013:p1079:b004:l028","ordinal":158549,"en":"He now set up a stone support."},{"id":"semetey-1-2013:p1079:b004:l029","ordinal":158550,"en":"Without saying Toltoy was coming,"},{"id":"semetey-1-2013:p1079:b004:l030","ordinal":158551,"en":"Lion-born Külchoro"},{"id":"semetey-1-2013:p1079:b004:l031","ordinal":158552,"en":"Grew weary and fell asleep."},{"id":"semetey-1-2013:p1079:b004:l032","ordinal":158553,"en":"He now began to snore;"},{"id":"semetey-1-2013:p1079:b004:l033","ordinal":158554,"en":"Fearless Külchoro"},{"id":"semetey-1-2013:p1079:b004:l034","ordinal":158555,"en":"Slept on without stirring."},{"id":"semetey-1-2013:p1079:b004:l035","ordinal":158556,"en":"He lay there propped up,"},{"id":"semetey-1-2013:p1079:b004:l036","ordinal":158557,"en":"Sleeping in the saddle."},{"id":"semetey-1-2013:p1079:b004:l037","ordinal":158558,"en":"As for Külchoro's guest,"},{"id":"semetey-1-2013:p1079:b004:l038","ordinal":158559,"en":"Now let me tell"},{"id":"semetey-1-2013:p1079:b004:l039","ordinal":158560,"en":"The tale of brave Toltoy."},{"id":"semetey-1-2013:p1080:b004:l001","ordinal":158561,"en":"Chynkozho, son of Shygay,"},{"id":"semetey-1-2013:p1080:b004:l002","ordinal":158562,"en":"Kozho, costly and forceful in his deeds,"},{"id":"semetey-1-2013:p1080:b004:l003","ordinal":158563,"en":"Of Argyn-Kyrgyz stock,"},{"id":"semetey-1-2013:p1080:b004:l004","ordinal":158564,"en":"Kozho whose fortune was complete,"},{"id":"semetey-1-2013:p1080:b004:l005","ordinal":158565,"en":"A renowned hero among"},{"id":"semetey-1-2013:p1080:b004:l006","ordinal":158566,"en":"Round-headed mortals."},{"id":"semetey-1-2013:p1080:b004:l007","ordinal":158567,"en":"Taking instruction from Manas,"},{"id":"semetey-1-2013:p1080:b004:l008","ordinal":158568,"en":"Lion Kozho had seen many things."},{"id":"semetey-1-2013:p1080:b004:l009","ordinal":158569,"en":"Dear Kozho, the brave servant,"},{"id":"semetey-1-2013:p1080:b004:l010","ordinal":158570,"en":"Had a black hat large as a cauldron;"},{"id":"semetey-1-2013:p1080:b004:l011","ordinal":158571,"en":"The brave-born Karkybar"},{"id":"semetey-1-2013:p1080:b004:l012","ordinal":158572,"en":"Had stature worth an army."},{"id":"semetey-1-2013:p1080:b004:l013","ordinal":158573,"en":"His appearance was more fearsome than a man's;"},{"id":"semetey-1-2013:p1080:b004:l014","ordinal":158574,"en":"He had the will to rule"},{"id":"semetey-1-2013:p1080:b004:l015","ordinal":158575,"en":"The eighteen thousand worlds."},{"id":"semetey-1-2013:p1080:b004:l016","ordinal":158576,"en":"There was authority upon his brow;"},{"id":"semetey-1-2013:p1080:b004:l017","ordinal":158577,"en":"He had the power to shout commands"},{"id":"semetey-1-2013:p1080:b004:l018","ordinal":158578,"en":"To all the Zhediger."},{"id":"semetey-1-2013:p1080:b004:l019","ordinal":158579,"en":"For fear of Chynkozho's wrath,"},{"id":"semetey-1-2013:p1080:b004:l020","ordinal":158580,"en":"No person came repeatedly before him."},{"id":"semetey-1-2013:p1080:b004:l021","ordinal":158581,"en":"The vast black Zhediger,"},{"id":"semetey-1-2013:p1080:b004:l022","ordinal":158582,"en":"Led by Khan Toltoy,"},{"id":"semetey-1-2013:p1080:b004:l023","ordinal":158583,"en":"Gave him no answer back."},{"id":"semetey-1-2013:p1080:b004:l024","ordinal":158584,"en":"At that time no one"},{"id":"semetey-1-2013:p1080:b004:l025","ordinal":158585,"en":"Paid Kozho any heed;"},{"id":"semetey-1-2013:p1080:b004:l026","ordinal":158586,"en":"When Kozho grew impetuous,"},{"id":"semetey-1-2013:p1080:b004:l027","ordinal":158587,"en":"No one remained to turn back his lasso."},{"id":"semetey-1-2013:p1080:b004:l028","ordinal":158588,"en":"His menace was fierce, his venom strong;"},{"id":"semetey-1-2013:p1080:b004:l029","ordinal":158589,"en":"When Chynkozho grew angry,"},{"id":"semetey-1-2013:p1080:b004:l030","ordinal":158590,"en":"He flattened the Zhediger."},{"id":"semetey-1-2013:p1080:b004:l031","ordinal":158591,"en":"When true frenzy seized him,"},{"id":"semetey-1-2013:p1080:b004:l032","ordinal":158592,"en":"Chynkozho's Black Horse"},{"id":"semetey-1-2013:p1080:b004:l033","ordinal":158593,"en":"Had wings"},{"id":"semetey-1-2013:p1080:b004:l034","ordinal":158594,"en":"Along its flanks."},{"id":"semetey-1-2013:p1080:b004:l035","ordinal":158595,"en":"When Chynkozho grew angry,"},{"id":"semetey-1-2013:p1080:b004:l036","ordinal":158596,"en":"He habitually struck all the Zhediger"},{"id":"semetey-1-2013:p1080:b004:l037","ordinal":158597,"en":"And crushed them like grain."},{"id":"semetey-1-2013:p1080:b005:l001","ordinal":158598,"en":"He had a people who raged;"},{"id":"semetey-1-2013:p1080:b005:l002","ordinal":158599,"en":"Have you heard the news?"},{"id":"semetey-1-2013:p1080:b005:l003","ordinal":158600,"en":"When his courage flared,"},{"id":"semetey-1-2013:p1080:b005:l004","ordinal":158601,"en":"He customarily drank the blood"},{"id":"semetey-1-2013:p1080:b005:l005","ordinal":158602,"en":"Of all the Zhediger."},{"id":"semetey-1-2013:p1080:b005:l006","ordinal":158603,"en":"Brave Kozho, son of Shygay,"},{"id":"semetey-1-2013:p1080:b005:l007","ordinal":158604,"en":"Had he not brought upon them"},{"id":"semetey-1-2013:p1080:b005:l008","ordinal":158605,"en":"Turmoil no person had seen?"},{"id":"semetey-1-2013:p1080:b005:l009","ordinal":158606,"en":"Promising to obtain Aychürök,"},{"id":"semetey-1-2013:p1080:b005:l010","ordinal":158607,"en":"Had he not driven and brought"},{"id":"semetey-1-2013:p1080:b005:l011","ordinal":158608,"en":"The vast black Zhediger,"},{"id":"semetey-1-2013:p1080:b005:l012","ordinal":158609,"en":"All of them rank by rank?"},{"id":"semetey-1-2013:p1080:b005:l013","ordinal":158610,"en":"To bring disorder upon Afghanistan,"},{"id":"semetey-1-2013:p1080:b005:l014","ordinal":158611,"en":"To seize Aychürök,"},{"id":"semetey-1-2013:p1080:b005:l015","ordinal":158612,"en":"Had he not led here"},{"id":"semetey-1-2013:p1080:b005:l016","ordinal":158613,"en":"All the Zhediger?"},{"id":"semetey-1-2013:p1080:b005:l017","ordinal":158614,"en":"Had the Zhediger not helplessly left"},{"id":"semetey-1-2013:p1080:b005:l018","ordinal":158615,"en":"Their own wealth behind"},{"id":"semetey-1-2013:p1080:b005:l019","ordinal":158616,"en":"In Zheti-Özön?"},{"id":"semetey-1-2013:p1080:b005:l020","ordinal":158617,"en":"When the sun sank shimmering,"},{"id":"semetey-1-2013:p1080:b005:l021","ordinal":158618,"en":"Chynkozho, son of Shygay,"},{"id":"semetey-1-2013:p1080:b005:l022","ordinal":158619,"en":"Wrapped himself in his mottled blue coat."},{"id":"semetey-1-2013:p1080:b005:l023","ordinal":158620,"en":"If you had seen Chynkozho,"},{"id":"semetey-1-2013:p1080:b005:l024","ordinal":158621,"en":"He strained like a blue bear;"},{"id":"semetey-1-2013:p1080:b005:l025","ordinal":158622,"en":"In anger he began"},{"id":"semetey-1-2013:p1080:b005:l026","ordinal":158623,"en":"To speak harsh words to Toltoy."},{"id":"semetey-1-2013:p1080:b005:l027","ordinal":158624,"en":"Chynkozho overwhelmed"},{"id":"semetey-1-2013:p1080:b005:l028","ordinal":158625,"en":"And all but devoured"},{"id":"semetey-1-2013:p1080:b005:l029","ordinal":158626,"en":"Every one of the Zhediger."},{"id":"semetey-1-2013:p1080:b005:l030","ordinal":158627,"en":"All the Zhediger,"},{"id":"semetey-1-2013:p1080:b005:l031","ordinal":158628,"en":"Including Tölöbay and old Kalcha, said:"},{"id":"semetey-1-2013:p1080:b005:l032","ordinal":158629,"en":"\"When we said Kozho had come,"},{"id":"semetey-1-2013:p1080:b005:l033","ordinal":158630,"en":"It was disaster that had come!"},{"id":"semetey-1-2013:p1080:b005:l034","ordinal":158631,"en":"When we thought a hero had come,"},{"id":"semetey-1-2013:p1080:b005:l035","ordinal":158632,"en":"It was calamity that had come!"},{"id":"semetey-1-2013:p1080:b005:l036","ordinal":158633,"en":"We were a people living at ease;"},{"id":"semetey-1-2013:p1080:b005:l037","ordinal":158634,"en":"Will God strike us for his frenzy?\""},{"id":"semetey-1-2013:p1081:b003:l001","ordinal":158635,"en":"\"By contriving his way along, this Kozho"},{"id":"semetey-1-2013:p1081:b003:l002","ordinal":158636,"en":"Will slaughter all the people!\""},{"id":"semetey-1-2013:p1081:b003:l003","ordinal":158637,"en":"They split apart,"},{"id":"semetey-1-2013:p1081:b003:l004","ordinal":158638,"en":"And whispered among themselves."},{"id":"semetey-1-2013:p1081:b003:l005","ordinal":158639,"en":"Was this the edge of the Zhediger,"},{"id":"semetey-1-2013:p1081:b003:l006","ordinal":158640,"en":"Or the shameless face of those people"},{"id":"semetey-1-2013:p1081:b003:l007","ordinal":158641,"en":"Who spoke their words openly?"},{"id":"semetey-1-2013:p1081:b003:l008","ordinal":158642,"en":"If you take heed, Chynkozho"},{"id":"semetey-1-2013:p1081:b003:l009","ordinal":158643,"en":"Had heard the edge"},{"id":"semetey-1-2013:p1081:b003:l010","ordinal":158644,"en":"Of those sly words just spoken,"},{"id":"semetey-1-2013:p1081:b003:l011","ordinal":158645,"en":"And had heard the end"},{"id":"semetey-1-2013:p1081:b003:l012","ordinal":158646,"en":"Of the ominous words now uttered."},{"id":"semetey-1-2013:p1081:b003:l013","ordinal":158647,"en":"Having heard them, Chynkozho"},{"id":"semetey-1-2013:p1081:b003:l014","ordinal":158648,"en":"Grew angry;"},{"id":"semetey-1-2013:p1081:b003:l015","ordinal":158649,"en":"Chynkozho pounded the earth."},{"id":"semetey-1-2013:p1081:b003:l016","ordinal":158650,"en":"Surrendering wholly to his courage,"},{"id":"semetey-1-2013:p1081:b003:l017","ordinal":158651,"en":"He shouted out his words:"},{"id":"semetey-1-2013:p1081:b003:l018","ordinal":158652,"en":"\"Vast black Zhediger,"},{"id":"semetey-1-2013:p1081:b003:l019","ordinal":158653,"en":"You have seen my courage;"},{"id":"semetey-1-2013:p1081:b003:l020","ordinal":158654,"en":"All of you came here"},{"id":"semetey-1-2013:p1081:b003:l021","ordinal":158655,"en":"Asking me to obtain a wife for you."},{"id":"semetey-1-2013:p1081:b003:l022","ordinal":158656,"en":"Speaking two by two,"},{"id":"semetey-1-2013:p1081:b003:l023","ordinal":158657,"en":"What did you just say?"},{"id":"semetey-1-2013:p1081:b003:l024","ordinal":158658,"en":"Sons of bitches, Zhediger—"},{"id":"semetey-1-2013:p1081:b003:l025","ordinal":158659,"en":"If you flee, you will eat shit!"},{"id":"semetey-1-2013:p1081:b003:l026","ordinal":158660,"en":"Vast black Zhediger,"},{"id":"semetey-1-2013:p1081:b003:l027","ordinal":158661,"en":"Let your bearded elders come;"},{"id":"semetey-1-2013:p1081:b003:l028","ordinal":158662,"en":"Come, all you Zhediger!"},{"id":"semetey-1-2013:p1081:b003:l029","ordinal":158663,"en":"Let your finest spearman come,"},{"id":"semetey-1-2013:p1081:b003:l030","ordinal":158664,"en":"Your strongest battle-axe wielder come,"},{"id":"semetey-1-2013:p1081:b003:l031","ordinal":158665,"en":"Your ablest deviser of means come."},{"id":"semetey-1-2013:p1081:b003:l032","ordinal":158666,"en":"Let your elder who has seen much come;"},{"id":"semetey-1-2013:p1081:b003:l033","ordinal":158667,"en":"Come, every one of you with sense."},{"id":"semetey-1-2013:p1081:b003:l034","ordinal":158668,"en":"I shall place the matter before you"},{"id":"semetey-1-2013:p1081:b003:l035","ordinal":158669,"en":"And find the means to settle it."},{"id":"semetey-1-2013:p1081:b003:l036","ordinal":158670,"en":"If the old man will not give his daughter,"},{"id":"semetey-1-2013:p1081:b003:l037","ordinal":158671,"en":"I shall ride headlong against"},{"id":"semetey-1-2013:p1081:b003:l038","ordinal":158672,"en":"Those sons of bitches, the Afghans,"},{"id":"semetey-1-2013:p1081:b003:l039","ordinal":158673,"en":"And find the full means to settle it."},{"id":"semetey-1-2013:p1081:b005:l001","ordinal":158674,"en":"Yesterday Tümönbay, son of Tülkü,"},{"id":"semetey-1-2013:p1081:b005:l002","ordinal":158675,"en":"And Azhybay, son of Azhy,"},{"id":"semetey-1-2013:p1081:b005:l003","ordinal":158676,"en":"Carried wondrous words between us:"},{"id":"semetey-1-2013:p1081:b005:l004","ordinal":158677,"en":"Before six days had passed,"},{"id":"semetey-1-2013:p1081:b005:l005","ordinal":158678,"en":"They left promising to give Aychürök."},{"id":"semetey-1-2013:p1081:b005:l006","ordinal":158679,"en":"Vast black Zhediger!"},{"id":"semetey-1-2013:p1081:b005:l007","ordinal":158680,"en":"What do you say to Toltoy going"},{"id":"semetey-1-2013:p1081:b005:l008","ordinal":158681,"en":"As bridegroom to Akun?"},{"id":"semetey-1-2013:p1081:b005:l009","ordinal":158682,"en":"What do you say to Toltoy staying,"},{"id":"semetey-1-2013:p1081:b005:l010","ordinal":158683,"en":"Immersed in a wondrous pleasure,"},{"id":"semetey-1-2013:p1081:b005:l011","ordinal":158684,"en":"Lying in one bed,"},{"id":"semetey-1-2013:p1081:b005:l012","ordinal":158685,"en":"Eating meat from one dish,"},{"id":"semetey-1-2013:p1081:b005:l013","ordinal":158686,"en":"Facing each other over one dish?"},{"id":"semetey-1-2013:p1081:b005:l014","ordinal":158687,"en":"What do you say to Toltoy coming?"},{"id":"semetey-1-2013:p1081:b005:l015","ordinal":158688,"en":"O Zhediger, vast multitude!"},{"id":"semetey-1-2013:p1081:b005:l016","ordinal":158689,"en":"Rise and speak plainly;"},{"id":"semetey-1-2013:p1081:b005:l017","ordinal":158690,"en":"Without groaning as though struck ten times,"},{"id":"semetey-1-2013:p1081:b005:l018","ordinal":158691,"en":"Speak quickly."},{"id":"semetey-1-2013:p1081:b005:l019","ordinal":158692,"en":"Think of what comes after and speak;"},{"id":"semetey-1-2013:p1081:b005:l020","ordinal":158693,"en":"Let the matter remain clear."},{"id":"semetey-1-2013:p1081:b005:l021","ordinal":158694,"en":"Hold back no evident secret—speak.\""},{"id":"semetey-1-2013:p1081:b005:l022","ordinal":158695,"en":"Chynkozho, son of Shygay,"},{"id":"semetey-1-2013:p1081:b005:l023","ordinal":158696,"en":"Growled and surged;"},{"id":"semetey-1-2013:p1081:b005:l024","ordinal":158697,"en":"He spoke to the vast black Zhediger,"},{"id":"semetey-1-2013:p1081:b005:l025","ordinal":158698,"en":"Demanding that they answer."},{"id":"semetey-1-2013:p1081:b005:l026","ordinal":158699,"en":"Kozho stood roaring."},{"id":"semetey-1-2013:p1081:b005:l027","ordinal":158700,"en":"Among the vast black Zhediger,"},{"id":"semetey-1-2013:p1081:b005:l028","ordinal":158701,"en":"There was no one to speak."},{"id":"semetey-1-2013:p1081:b005:l029","ordinal":158702,"en":"Chynkozho's shout"},{"id":"semetey-1-2013:p1081:b005:l030","ordinal":158703,"en":"Sounded like lightning;"},{"id":"semetey-1-2013:p1081:b005:l031","ordinal":158704,"en":"Of all the Zhediger,"},{"id":"semetey-1-2013:p1081:b005:l032","ordinal":158705,"en":"Not one soul raised himself."},{"id":"semetey-1-2013:p1081:b005:l033","ordinal":158706,"en":"Their heads sank into the ground;"},{"id":"semetey-1-2013:p1081:b005:l034","ordinal":158707,"en":"They looked down and whimpered,"},{"id":"semetey-1-2013:p1081:b005:l035","ordinal":158708,"en":"Scratching the earth and groaning."},{"id":"semetey-1-2013:p1081:b005:l036","ordinal":158709,"en":"Even their strongest, old Tölök,"},{"id":"semetey-1-2013:p1081:b005:l037","ordinal":158710,"en":"As though slaughter had struck,"},{"id":"semetey-1-2013:p1081:b005:l038","ordinal":158711,"en":"Collapsed into whimpering;"},{"id":"semetey-1-2013:p1081:b005:l039","ordinal":158712,"en":"All the Zhediger did the same."},{"id":"semetey-1-2013:p1082:b003:l001","ordinal":158713,"en":"For as long as meat took to cook,"},{"id":"semetey-1-2013:p1082:b003:l002","ordinal":158714,"en":"All the Zhediger"},{"id":"semetey-1-2013:p1082:b003:l003","ordinal":158715,"en":"Remained without moving."},{"id":"semetey-1-2013:p1082:b003:l004","ordinal":158716,"en":"Brave Toltoy, son of Bagysh,"},{"id":"semetey-1-2013:p1082:b003:l005","ordinal":158717,"en":"Jerked his head up from the ground."},{"id":"semetey-1-2013:p1082:b003:l006","ordinal":158718,"en":"Honking like a young goose,"},{"id":"semetey-1-2013:p1082:b003:l007","ordinal":158719,"en":"He spoke words of substance;"},{"id":"semetey-1-2013:p1082:b003:l008","ordinal":158720,"en":"Brave Toltoy voiced"}]
