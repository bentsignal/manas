[{"id":"semetey-1-2013:p0205:b004:l008","ordinal":92417,"en":"Bending from horseback,"},{"id":"semetey-1-2013:p0205:b004:l009","ordinal":92418,"en":"From Akborchuk's back,"},{"id":"semetey-1-2013:p0205:b004:l010","ordinal":92419,"en":"Your noble sister-in-law Kanykey"},{"id":"semetey-1-2013:p0205:b004:l011","ordinal":92420,"en":"Leaped down and ran."},{"id":"semetey-1-2013:p0205:b004:l012","ordinal":92421,"en":"Speaking softly in anguish,"},{"id":"semetey-1-2013:p0205:b004:l013","ordinal":92422,"en":"Calling her 'Mother,' she pleaded:"},{"id":"semetey-1-2013:p0205:b004:l014","ordinal":92423,"en":"\"My river, great as a mountain,"},{"id":"semetey-1-2013:p0205:b004:l015","ordinal":92424,"en":"From my honored Kyrgyz people,"},{"id":"semetey-1-2013:p0205:b004:l016","ordinal":92425,"en":"Carrying you on my broad back,"},{"id":"semetey-1-2013:p0205:b004:l017","ordinal":92426,"en":"My saint whom I brought here."},{"id":"semetey-1-2013:p0205:b004:l018","ordinal":92427,"en":"At the sight of you, my heart is content."},{"id":"semetey-1-2013:p0205:b004:l019","ordinal":92428,"en":"My venerable white lady, my sacred mother,"},{"id":"semetey-1-2013:p0205:b004:l020","ordinal":92429,"en":"I have no Mecca but you!"},{"id":"semetey-1-2013:p0205:b004:l021","ordinal":92430,"en":"Valiant mother, listen."},{"id":"semetey-1-2013:p0205:b004:l022","ordinal":92431,"en":"I have no support to lean on."},{"id":"semetey-1-2013:p0205:b004:l023","ordinal":92432,"en":"If I race Taytoru for a prize,"},{"id":"semetey-1-2013:p0205:b004:l024","ordinal":92433,"en":"My renowned Kyrgyz people are not here!"},{"id":"semetey-1-2013:p0205:b004:l025","ordinal":92434,"en":"Who would show kindness"},{"id":"semetey-1-2013:p0205:b004:l026","ordinal":92435,"en":"To a widow like me?"},{"id":"semetey-1-2013:p0205:b004:l027","ordinal":92436,"en":"Let me race to divine my fate,"},{"id":"semetey-1-2013:p0205:b004:l028","ordinal":92437,"en":"Mother, my steed Taytoru."},{"id":"semetey-1-2013:p0205:b004:l029","ordinal":92438,"en":"If Taytoru comes through,"},{"id":"semetey-1-2013:p0205:b004:l030","ordinal":92439,"en":"I shall see some good fortune."},{"id":"semetey-1-2013:p0205:b004:l031","ordinal":92440,"en":"The countless prizes in Bukhara,"},{"id":"semetey-1-2013:p0205:b004:l032","ordinal":92441,"en":"Mother, I shall divide by the measure of a whip."},{"id":"semetey-1-2013:p0205:b004:l033","ordinal":92442,"en":"The only one left by your Slayer son,"},{"id":"semetey-1-2013:p0205:b004:l034","ordinal":92443,"en":"This year, mother, I shall see with my own eyes."},{"id":"semetey-1-2013:p0205:b004:l035","ordinal":92444,"en":"I shall send word to your people."},{"id":"semetey-1-2013:p0205:b004:l036","ordinal":92445,"en":"On the only one left by my khan,"},{"id":"semetey-1-2013:p0205:b004:l037","ordinal":92446,"en":"I shall place my golden crown,"},{"id":"semetey-1-2013:p0205:b004:l038","ordinal":92447,"en":"And seat him on the golden throne."},{"id":"semetey-1-2013:p0205:b004:l039","ordinal":92448,"en":"To this Bukhara here,"},{"id":"semetey-1-2013:p0206:b003:l001","ordinal":92449,"en":"This year I shall raise him as khan."},{"id":"semetey-1-2013:p0206:b003:l002","ordinal":92450,"en":"If Taytoru falls behind,"},{"id":"semetey-1-2013:p0206:b003:l003","ordinal":92451,"en":"A dreadful day will fall upon my head."},{"id":"semetey-1-2013:p0206:b003:l004","ordinal":92452,"en":"I shall suffer, my thoughts torn apart;"},{"id":"semetey-1-2013:p0206:b003:l005","ordinal":92453,"en":"I shall shed my own blood."},{"id":"semetey-1-2013:p0206:b003:l006","ordinal":92454,"en":"For sixty sheep and forty yearlings,"},{"id":"semetey-1-2013:p0206:b003:l007","ordinal":92455,"en":"The Aktinte that I bought"},{"id":"semetey-1-2013:p0206:b003:l008","ordinal":92456,"en":"I shall draw from its sheath."},{"id":"semetey-1-2013:p0206:b003:l009","ordinal":92457,"en":"Today this accursed soul of mine"},{"id":"semetey-1-2013:p0206:b003:l010","ordinal":92458,"en":"I shall offer up as a sacrifice."},{"id":"semetey-1-2013:p0206:b003:l011","ordinal":92459,"en":"I shall die in suffering."},{"id":"semetey-1-2013:p0206:b003:l012","ordinal":92460,"en":"Mother, today I shall see the face of Judgment!"},{"id":"semetey-1-2013:p0206:b003:l013","ordinal":92461,"en":"Give me your blessing; let me receive it."},{"id":"semetey-1-2013:p0206:b003:l014","ordinal":92462,"en":"Before my sovereign father,"},{"id":"semetey-1-2013:p0206:b003:l015","ordinal":92463,"en":"Let me go like a man."},{"id":"semetey-1-2013:p0206:b003:l016","ordinal":92464,"en":"If Taytoru comes through,"},{"id":"semetey-1-2013:p0206:b003:l017","ordinal":92465,"en":"If the true divine power supports me,"},{"id":"semetey-1-2013:p0206:b003:l018","ordinal":92466,"en":"In this Bukhara here"},{"id":"semetey-1-2013:p0206:b003:l019","ordinal":92467,"en":"Let me make a spectacle."},{"id":"semetey-1-2013:p0206:b003:l020","ordinal":92468,"en":"Do not withhold your prayer from me,"},{"id":"semetey-1-2013:p0206:b003:l021","ordinal":92469,"en":"My mother, like a prophet;"},{"id":"semetey-1-2013:p0206:b003:l022","ordinal":92470,"en":"Do not withhold your blessing from me!\""},{"id":"semetey-1-2013:p0206:b003:l023","ordinal":92471,"en":"The venerable white lady Chyiyrdy"},{"id":"semetey-1-2013:p0206:b003:l024","ordinal":92472,"en":"Raised her hands, spreading them wide,"},{"id":"semetey-1-2013:p0206:b003:l025","ordinal":92473,"en":"Coughing with deep, repeated coughs."},{"id":"semetey-1-2013:p0206:b003:l026","ordinal":92474,"en":"Saying, 'Allah!' she raised her hands,"},{"id":"semetey-1-2013:p0206:b003:l027","ordinal":92475,"en":"And wept again, saying, 'Creator!'"},{"id":"semetey-1-2013:p0206:b003:l028","ordinal":92476,"en":"She wept piteously to the one God,"},{"id":"semetey-1-2013:p0206:b003:l029","ordinal":92477,"en":"Raising her hands, weeping piteously."},{"id":"semetey-1-2013:p0206:b003:l030","ordinal":92478,"en":"To Manas, gone to the other world,"},{"id":"semetey-1-2013:p0206:b003:l031","ordinal":92479,"en":"She wept again, saying, 'Give support!'"},{"id":"semetey-1-2013:p0206:b003:l032","ordinal":92480,"en":"\"Ajybay and Bakay, you two khans,"},{"id":"semetey-1-2013:p0206:b003:l033","ordinal":92481,"en":"Give support in every undertaking."},{"id":"semetey-1-2013:p0206:b003:l034","ordinal":92482,"en":"My dear one God,"},{"id":"semetey-1-2013:p0206:b003:l035","ordinal":92483,"en":"Make my child Kanykey's undertaking prosper!"},{"id":"semetey-1-2013:p0206:b003:l036","ordinal":92484,"en":"Almambet and Chubak, my twins,"},{"id":"semetey-1-2013:p0206:b003:l037","ordinal":92485,"en":"Look upon my widow."},{"id":"semetey-1-2013:p0206:b003:l038","ordinal":92486,"en":"Syrgak and Serek, my oceans,"},{"id":"semetey-1-2013:p0206:b003:l039","ordinal":92487,"en":"Urge on this sister-in-law of yours!"},{"id":"semetey-1-2013:p0206:b004:l001","ordinal":92488,"en":"Sixty kinds of guardian spirit,"},{"id":"semetey-1-2013:p0206:b004:l002","ordinal":92489,"en":"Forty-two Khizr-Ilyases,"},{"id":"semetey-1-2013:p0206:b004:l003","ordinal":92490,"en":"God, make her undertaking prosper;"},{"id":"semetey-1-2013:p0206:b004:l004","ordinal":92491,"en":"Support my widow!"},{"id":"semetey-1-2013:p0206:b004:l005","ordinal":92492,"en":"My poor widowed child,"},{"id":"semetey-1-2013:p0206:b004:l006","ordinal":92493,"en":"My dear one God,"},{"id":"semetey-1-2013:p0206:b004:l007","ordinal":92494,"en":"If you created her as a living soul,"},{"id":"semetey-1-2013:p0206:b004:l008","ordinal":92495,"en":"Do not make her hang her head!"},{"id":"semetey-1-2013:p0206:b004:l009","ordinal":92496,"en":"God, do not let a bird of prey eat the swan."},{"id":"semetey-1-2013:p0206:b004:l010","ordinal":92497,"en":"This child of mine who goes about sobbing,"},{"id":"semetey-1-2013:p0206:b004:l011","ordinal":92498,"en":"If you created her as a living soul,"},{"id":"semetey-1-2013:p0206:b004:l012","ordinal":92499,"en":"In this Bukhara here,"},{"id":"semetey-1-2013:p0206:b004:l013","ordinal":92500,"en":"Do not let them call her a ruined woman!"},{"id":"semetey-1-2013:p0206:b004:l014","ordinal":92501,"en":"O God, do not let a bird of prey eat the goose."},{"id":"semetey-1-2013:p0206:b004:l015","ordinal":92502,"en":"This child of mine, Kanykey,"},{"id":"semetey-1-2013:p0206:b004:l016","ordinal":92503,"en":"If you created her as a living soul,"},{"id":"semetey-1-2013:p0206:b004:l017","ordinal":92504,"en":"In this Bukhara here,"},{"id":"semetey-1-2013:p0206:b004:l018","ordinal":92505,"en":"Do not let them call her a fugitive woman."},{"id":"semetey-1-2013:p0206:b004:l019","ordinal":92506,"en":"O Kanykey, my foal,"},{"id":"semetey-1-2013:p0206:b004:l020","ordinal":92507,"en":"May God grant your wish;"},{"id":"semetey-1-2013:p0206:b004:l021","ordinal":92508,"en":"This Taytoru of yours,"},{"id":"semetey-1-2013:p0206:b004:l022","ordinal":92509,"en":"May he come through in Bukhara!"},{"id":"semetey-1-2013:p0206:b004:l023","ordinal":92510,"en":"May God grant your wish;"},{"id":"semetey-1-2013:p0206:b004:l024","ordinal":92511,"en":"May God lift your sorrow;"},{"id":"semetey-1-2013:p0206:b004:l025","ordinal":92512,"en":"May God relieve your grief!\""},{"id":"semetey-1-2013:p0206:b004:l026","ordinal":92513,"en":"Your mourning sister-in-law Kanykey,"},{"id":"semetey-1-2013:p0206:b004:l027","ordinal":92514,"en":"Receiving her mother Chyiyrdy's blessing,"},{"id":"semetey-1-2013:p0206:b004:l028","ordinal":92515,"en":"Kanykey, the wife of Manas,"},{"id":"semetey-1-2013:p0206:b004:l029","ordinal":92516,"en":"Mounted and set out toward Bukhara,"},{"id":"semetey-1-2013:p0206:b004:l030","ordinal":92517,"en":"Taking a direct route through the foothills."},{"id":"semetey-1-2013:p0206:b004:l031","ordinal":92518,"en":"Your mother led Taytoru,"},{"id":"semetey-1-2013:p0206:b004:l032","ordinal":92519,"en":"Her banner fluttering,"},{"id":"semetey-1-2013:p0206:b004:l033","ordinal":92520,"en":"All her equipment"},{"id":"semetey-1-2013:p0206:b004:l034","ordinal":92521,"en":"Flashing along her body."},{"id":"semetey-1-2013:p0206:b004:l035","ordinal":92522,"en":"Those who saw her were unsettled."},{"id":"semetey-1-2013:p0206:b004:l036","ordinal":92523,"en":"In appearance and bearing,"},{"id":"semetey-1-2013:p0206:b004:l037","ordinal":92524,"en":"She looked like hero Manas of old."},{"id":"semetey-1-2013:p0206:b004:l038","ordinal":92525,"en":"A black-spotted leopard"},{"id":"semetey-1-2013:p0206:b004:l039","ordinal":92526,"en":"Raged at her side,"},{"id":"semetey-1-2013:p0207:b003:l001","ordinal":92527,"en":"Your dear, fierce sister-in-law"},{"id":"semetey-1-2013:p0207:b003:l002","ordinal":92528,"en":"It supported invisibly."},{"id":"semetey-1-2013:p0207:b003:l003","ordinal":92529,"en":"A short-tailed spotted lion,"},{"id":"semetey-1-2013:p0207:b003:l004","ordinal":92530,"en":"Raging close beside her,"},{"id":"semetey-1-2013:p0207:b003:l005","ordinal":92531,"en":"Gave its support as well."},{"id":"semetey-1-2013:p0207:b003:l006","ordinal":92532,"en":"When your sister-in-law grew wrathful,"},{"id":"semetey-1-2013:p0207:b003:l007","ordinal":92533,"en":"Her very tidings could take one's life."},{"id":"semetey-1-2013:p0207:b003:l008","ordinal":92534,"en":"If you looked upon her face,"},{"id":"semetey-1-2013:p0207:b003:l009","ordinal":92535,"en":"Between her two cheeks"},{"id":"semetey-1-2013:p0207:b003:l010","ordinal":92536,"en":"Grew enough hair for a felt sock."},{"id":"semetey-1-2013:p0207:b003:l011","ordinal":92537,"en":"Flame hissed from her mouth."},{"id":"semetey-1-2013:p0207:b003:l012","ordinal":92538,"en":"Her formidable teeth, like a gate,"},{"id":"semetey-1-2013:p0207:b003:l013","ordinal":92539,"en":"Scattered like grains of millet."},{"id":"semetey-1-2013:p0207:b003:l014","ordinal":92540,"en":"Flame poured from her mouth;"},{"id":"semetey-1-2013:p0207:b003:l015","ordinal":92541,"en":"She looked like an enormous mountain."},{"id":"semetey-1-2013:p0207:b003:l016","ordinal":92542,"en":"When she entered Bukhara,"},{"id":"semetey-1-2013:p0207:b003:l017","ordinal":92543,"en":"The eight khans in Bukhara"},{"id":"semetey-1-2013:p0207:b003:l018","ordinal":92544,"en":"Were deeply troubled."},{"id":"semetey-1-2013:p0207:b003:l019","ordinal":92545,"en":"In appearance and bearing,"},{"id":"semetey-1-2013:p0207:b003:l020","ordinal":92546,"en":"Your sister-in-law looked like a devouring monster."},{"id":"semetey-1-2013:p0207:b003:l021","ordinal":92547,"en":"Not knowing she was a woman,"},{"id":"semetey-1-2013:p0207:b003:l022","ordinal":92548,"en":"The eight khans in Bukhara"},{"id":"semetey-1-2013:p0207:b003:l023","ordinal":92549,"en":"Split apart and scurried away."},{"id":"semetey-1-2013:p0207:b003:l024","ordinal":92550,"en":"With both hands upon their breasts,"},{"id":"semetey-1-2013:p0207:b003:l025","ordinal":92551,"en":"All cried out greetings."},{"id":"semetey-1-2013:p0207:b003:l026","ordinal":92552,"en":"Their white-turbaned khojas,"},{"id":"semetey-1-2013:p0207:b003:l027","ordinal":92553,"en":"Their mullahs who studied sacred lessons,"},{"id":"semetey-1-2013:p0207:b003:l028","ordinal":92554,"en":"All their long-eared ones,"},{"id":"semetey-1-2013:p0207:b003:l029","ordinal":92555,"en":"Their elders with grizzled beards—"},{"id":"semetey-1-2013:p0207:b003:l030","ordinal":92556,"en":"Not just one of them,"},{"id":"semetey-1-2013:p0207:b003:l031","ordinal":92557,"en":"But all the people of Bukhara"},{"id":"semetey-1-2013:p0207:b003:l032","ordinal":92558,"en":"Split apart and scurried away,"},{"id":"semetey-1-2013:p0207:b003:l033","ordinal":92559,"en":"Calling out greetings."},{"id":"semetey-1-2013:p0207:b003:l034","ordinal":92560,"en":"Bukhara stood halted in confusion."},{"id":"semetey-1-2013:p0207:b003:l035","ordinal":92561,"en":"Not knowing she was a woman,"},{"id":"semetey-1-2013:p0207:b003:l036","ordinal":92562,"en":"Astonished at your sister-in-law,"},{"id":"semetey-1-2013:p0207:b003:l037","ordinal":92563,"en":"Many of the people of Bukhara"},{"id":"semetey-1-2013:p0207:b003:l038","ordinal":92564,"en":"Crowded round and whispered:"},{"id":"semetey-1-2013:p0207:b003:l039","ordinal":92565,"en":"\"He is renowned; he is a support."},{"id":"semetey-1-2013:p0207:b004:l001","ordinal":92566,"en":"Where has this hero come from?"},{"id":"semetey-1-2013:p0207:b004:l002","ordinal":92567,"en":"Broad of chest, wide of breast,"},{"id":"semetey-1-2013:p0207:b004:l003","ordinal":92568,"en":"He is an imposing lion."},{"id":"semetey-1-2013:p0207:b004:l004","ordinal":92569,"en":"All twelve parts of his body are sound."},{"id":"semetey-1-2013:p0207:b004:l005","ordinal":92570,"en":"For this realm here,"},{"id":"semetey-1-2013:p0207:b004:l006","ordinal":92571,"en":"He is an iron fortress of defense."},{"id":"semetey-1-2013:p0207:b004:l007","ordinal":92572,"en":"The Chinese beyond the ridge,"},{"id":"semetey-1-2013:p0207:b004:l008","ordinal":92573,"en":"He is a hero who could slaughter them."},{"id":"semetey-1-2013:p0207:b004:l009","ordinal":92574,"en":"Those who give insolent replies,"},{"id":"semetey-1-2013:p0207:b004:l010","ordinal":92575,"en":"His words could silence."},{"id":"semetey-1-2013:p0207:b004:l011","ordinal":92576,"en":"If an enemy boldly rose up,"},{"id":"semetey-1-2013:p0207:b004:l012","ordinal":92577,"en":"For this palm-sized realm,"},{"id":"semetey-1-2013:p0207:b004:l013","ordinal":92578,"en":"He is a lion who could lend support."},{"id":"semetey-1-2013:p0207:b004:l014","ordinal":92579,"en":"Six amulets at a time upon his horse,"},{"id":"semetey-1-2013:p0207:b004:l015","ordinal":92580,"en":"He is a hero who would fasten them."},{"id":"semetey-1-2013:p0207:b004:l016","ordinal":92581,"en":"This palm-sized realm of Islam,"},{"id":"semetey-1-2013:p0207:b004:l017","ordinal":92582,"en":"Without chafing their mounts' backs,"},{"id":"semetey-1-2013:p0207:b004:l018","ordinal":92583,"en":"Without hurting their hearts,"},{"id":"semetey-1-2013:p0207:b004:l019","ordinal":92584,"en":"He is a lion who could care for them."},{"id":"semetey-1-2013:p0207:b004:l020","ordinal":92585,"en":"His appearance and bearing,"},{"id":"semetey-1-2013:p0207:b004:l021","ordinal":92586,"en":"His figure on horseback,"},{"id":"semetey-1-2013:p0207:b004:l022","ordinal":92587,"en":"Look like Manas."},{"id":"semetey-1-2013:p0207:b004:l023","ordinal":92588,"en":"Perhaps he is Manas's sister's son,"},{"id":"semetey-1-2013:p0207:b004:l024","ordinal":92589,"en":"Or perhaps Manas's maternal uncle."},{"id":"semetey-1-2013:p0207:b004:l025","ordinal":92590,"en":"What is his battle cry, what is his identity?"},{"id":"semetey-1-2013:p0207:b004:l026","ordinal":92591,"en":"What lineage does he come from?"},{"id":"semetey-1-2013:p0207:b004:l027","ordinal":92592,"en":"Your father's grave, Muslims!"},{"id":"semetey-1-2013:p0207:b004:l028","ordinal":92593,"en":"When that Manas died,"},{"id":"semetey-1-2013:p0207:b004:l029","ordinal":92594,"en":"The people of Islam were hard pressed."},{"id":"semetey-1-2013:p0207:b004:l030","ordinal":92595,"en":"When mighty Manas died,"},{"id":"semetey-1-2013:p0207:b004:l031","ordinal":92596,"en":"We of Islam were left lamenting;"},{"id":"semetey-1-2013:p0207:b004:l032","ordinal":92597,"en":"We Muslims were left weeping."},{"id":"semetey-1-2013:p0207:b004:l033","ordinal":92598,"en":"God does not leave a place empty."},{"id":"semetey-1-2013:p0207:b004:l034","ordinal":92599,"en":"He is a lion like Manas."},{"id":"semetey-1-2013:p0207:b004:l035","ordinal":92600,"en":"This palm-sized realm of Islam,"},{"id":"semetey-1-2013:p0207:b004:l036","ordinal":92601,"en":"He is a hero who could protect it."},{"id":"semetey-1-2013:p0207:b004:l037","ordinal":92602,"en":"Setting honor aside, here"},{"id":"semetey-1-2013:p0207:b004:l038","ordinal":92603,"en":"If we raise this man as khan,"},{"id":"semetey-1-2013:p0207:b004:l039","ordinal":92604,"en":"He will drive white deer and make them cattle;"},{"id":"semetey-1-2013:p0208:b003:l001","ordinal":92605,"en":"He will throw the whole world into confusion;"},{"id":"semetey-1-2013:p0208:b003:l002","ordinal":92606,"en":"He will drive blue-gray deer and make them cattle,"},{"id":"semetey-1-2013:p0208:b003:l003","ordinal":92607,"en":"And confound everyone he sees."},{"id":"semetey-1-2013:p0208:b003:l004","ordinal":92608,"en":"The one God had granted"},{"id":"semetey-1-2013:p0208:b003:l005","ordinal":92609,"en":"Whatever he wished."},{"id":"semetey-1-2013:p0208:b003:l006","ordinal":92610,"en":"His age had reached forty-four;"},{"id":"semetey-1-2013:p0208:b003:l007","ordinal":92611,"en":"That was the age he had attained.\""},{"id":"semetey-1-2013:p0208:b003:l008","ordinal":92612,"en":"The peoples of eight khans were astonished,"},{"id":"semetey-1-2013:p0208:b003:l009","ordinal":92613,"en":"All crowding round to look."},{"id":"semetey-1-2013:p0208:b003:l010","ordinal":92614,"en":"The eight khans who did not recognize her,"},{"id":"semetey-1-2013:p0208:b003:l011","ordinal":92615,"en":"Let us leave them thus."},{"id":"semetey-1-2013:p0208:b003:l012","ordinal":92616,"en":"The people of Bukhara who knew her,"},{"id":"semetey-1-2013:p0208:b003:l013","ordinal":92617,"en":"Let us begin to tell of them."},{"id":"semetey-1-2013:p0208:b003:l014","ordinal":92618,"en":"The people of Bukhara saw your sister-in-law,"},{"id":"semetey-1-2013:p0208:b003:l015","ordinal":92619,"en":"Stabbing at the tracks she left."},{"id":"semetey-1-2013:p0208:b003:l016","ordinal":92620,"en":"All Bukhara gathered,"},{"id":"semetey-1-2013:p0208:b003:l017","ordinal":92621,"en":"Slandering your sister-in-law:"},{"id":"semetey-1-2013:p0208:b003:l018","ordinal":92622,"en":"\"A woman who goes wrong never comes to good."},{"id":"semetey-1-2013:p0208:b003:l019","ordinal":92623,"en":"People, those called women"},{"id":"semetey-1-2013:p0208:b003:l020","ordinal":92624,"en":"Can never be true Muslims."},{"id":"semetey-1-2013:p0208:b003:l021","ordinal":92625,"en":"The reason they cannot—"},{"id":"semetey-1-2013:p0208:b003:l022","ordinal":92626,"en":"She trotted like a hunting hound."},{"id":"semetey-1-2013:p0208:b003:l023","ordinal":92627,"en":"Bereft of Khan Manas,"},{"id":"semetey-1-2013:p0208:b003:l024","ordinal":92628,"en":"That bitch came wandering from Talas the other day."},{"id":"semetey-1-2013:p0208:b003:l026","ordinal":92629,"en":"She had no means of livelihood at all."},{"id":"semetey-1-2013:p0208:b003:l027","ordinal":92630,"en":"Hardship had fallen upon her head."},{"id":"semetey-1-2013:p0208:b003:l028","ordinal":92631,"en":"Bereft of her Slayer,"},{"id":"semetey-1-2013:p0208:b003:l029","ordinal":92632,"en":"At thirty-two years of age,"},{"id":"semetey-1-2013:p0208:b003:l030","ordinal":92633,"en":"Letting them find her weakness,"},{"id":"semetey-1-2013:p0208:b003:l031","ordinal":92634,"en":"Letting the six wretches slash her breast,"},{"id":"semetey-1-2013:p0208:b003:l032","ordinal":92635,"en":"Letting her wealth be plundered,"},{"id":"semetey-1-2013:p0208:b003:l033","ordinal":92636,"en":"Letting the six wretches wreak havoc."},{"id":"semetey-1-2013:p0208:b003:l034","ordinal":92637,"en":"In felt socks, without overshoes,"},{"id":"semetey-1-2013:p0208:b003:l035","ordinal":92638,"en":"She came grieving and wandering."},{"id":"semetey-1-2013:p0208:b003:l036","ordinal":92639,"en":"Without boots, in felt socks,"},{"id":"semetey-1-2013:p0208:b003:l037","ordinal":92640,"en":"She barely kept herself alive."},{"id":"semetey-1-2013:p0208:b003:l038","ordinal":92641,"en":"Wandering here on the brink of death,"},{"id":"semetey-1-2013:p0208:b003:l039","ordinal":92642,"en":"The child she had borne"},{"id":"semetey-1-2013:p0208:b004:l001","ordinal":92643,"en":"She gave to our Ysmayyl."},{"id":"semetey-1-2013:p0208:b004:l002","ordinal":92644,"en":"Wearing a loose felt cloak,"},{"id":"semetey-1-2013:p0208:b004:l003","ordinal":92645,"en":"Riding a brown young mare, swaying about,"},{"id":"semetey-1-2013:p0208:b004:l004","ordinal":92646,"en":"She came grieving and wandering."},{"id":"semetey-1-2013:p0208:b004:l005","ordinal":92647,"en":"The child in her arms,"},{"id":"semetey-1-2013:p0208:b004:l006","ordinal":92648,"en":"Having his little twig cut,"},{"id":"semetey-1-2013:p0208:b004:l007","ordinal":92649,"en":"Having the ritual performed,"},{"id":"semetey-1-2013:p0208:b004:l008","ordinal":92650,"en":"Having him step over a dog's bowl,"},{"id":"semetey-1-2013:p0208:b004:l009","ordinal":92651,"en":"Having him step over a sword's edge,"},{"id":"semetey-1-2013:p0208:b004:l010","ordinal":92652,"en":"Saying, 'Ysmayyl, raise him,'"},{"id":"semetey-1-2013:p0208:b004:l011","ordinal":92653,"en":"She came wandering from Talas."},{"id":"semetey-1-2013:p0208:b004:l012","ordinal":92654,"en":"The only child she counted as her fortune"},{"id":"semetey-1-2013:p0208:b004:l013","ordinal":92655,"en":"She gave to Ysmayyl."},{"id":"semetey-1-2013:p0208:b004:l014","ordinal":92656,"en":"The child being raised"},{"id":"semetey-1-2013:p0208:b004:l015","ordinal":92657,"en":"Reached twelve this year."},{"id":"semetey-1-2013:p0208:b004:l016","ordinal":92658,"en":"Since the death of Manas the Slayer,"},{"id":"semetey-1-2013:p0208:b004:l017","ordinal":92659,"en":"Twelve years have passed this year."},{"id":"semetey-1-2013:p0208:b004:l018","ordinal":92660,"en":"Calling from the mountaintop,"},{"id":"semetey-1-2013:p0208:b004:l019","ordinal":92661,"en":"This year she has become a snowcock."},{"id":"semetey-1-2013:p0208:b004:l020","ordinal":92662,"en":"Somehow to marry a man,"},{"id":"semetey-1-2013:p0208:b004:l021","ordinal":92663,"en":"To go about seeking men,"},{"id":"semetey-1-2013:p0208:b004:l022","ordinal":92664,"en":"This bitch has become eager."},{"id":"semetey-1-2013:p0208:b004:l023","ordinal":92665,"en":"Rejoicing at her husband's death,"},{"id":"semetey-1-2013:p0208:b004:l024","ordinal":92666,"en":"Dressing in men's clothes,"},{"id":"semetey-1-2013:p0208:b004:l025","ordinal":92667,"en":"Taking a direct route along a narrow path,"},{"id":"semetey-1-2013:p0208:b004:l026","ordinal":92668,"en":"In her old age, a horse of hers"},{"id":"semetey-1-2013:p0208:b004:l027","ordinal":92669,"en":"She leads, saying, 'I shall race him.'"},{"id":"semetey-1-2013:p0208:b004:l028","ordinal":92670,"en":"Let him cut the willow on the knoll;"},{"id":"semetey-1-2013:p0208:b004:l029","ordinal":92671,"en":"The khan of Bukhara, Temir Khan,"},{"id":"semetey-1-2013:p0208:b004:l030","ordinal":92672,"en":"Let him restrain his wayward daughter!"}]
