[{"id":"semetey-2-2013:p1213:b004:l005","ordinal":280065,"en":"He grasped him at the waist and folded him,"},{"id":"semetey-2-2013:p1213:b004:l006","ordinal":280066,"en":"Crying, “Do not die, my lionhearted uncle!”"},{"id":"semetey-2-2013:p1213:b004:l007","ordinal":280067,"en":"Then he loaded him upon Bozaiman."},{"id":"semetey-2-2013:p1213:b004:l008","ordinal":280068,"en":"By the black springs of Kainar,"},{"id":"semetey-2-2013:p1213:b004:l009","ordinal":280069,"en":"Beside the straight plane tree,"},{"id":"semetey-2-2013:p1213:b004:l010","ordinal":280070,"en":"Below Tört-Kül,"},{"id":"semetey-2-2013:p1213:b004:l011","ordinal":280071,"en":"In the garden planted by noble khans,"},{"id":"semetey-2-2013:p1213:b004:l012","ordinal":280072,"en":"Facing Jylgynduu,"},{"id":"semetey-2-2013:p1213:b004:l013","ordinal":280073,"en":"On the near side of Keng-Kol,"},{"id":"semetey-2-2013:p1213:b004:l014","ordinal":280074,"en":"In the lower hollow of Keng-Shor,"},{"id":"semetey-2-2013:p1213:b004:l015","ordinal":280075,"en":"Along Tal-Mazar,"},{"id":"semetey-2-2013:p1213:b004:l016","ordinal":280076,"en":"He hacked and hollowed out"},{"id":"semetey-2-2013:p1213:b004:l017","ordinal":280077,"en":"A grave-shaped place,"},{"id":"semetey-2-2013:p1213:b004:l018","ordinal":280078,"en":"And hiding his face from sight,"},{"id":"semetey-2-2013:p1213:b004:l019","ordinal":280079,"en":"He laid Sary Khan to rest."},{"id":"semetey-2-2013:p1213:b004:l020","ordinal":280080,"en":"Leaving none of his grief unspoken,"},{"id":"semetey-2-2013:p1213:b004:l021","ordinal":280081,"en":"He tried to drive Bozaiman away."},{"id":"semetey-2-2013:p1213:b004:l022","ordinal":280082,"en":"Whinnying mournfully,"},{"id":"semetey-2-2013:p1213:b004:l023","ordinal":280083,"en":"The gray stallion would not obey."},{"id":"semetey-2-2013:p1213:b004:l024","ordinal":280084,"en":"Though beaten, he balked and would not move;"},{"id":"semetey-2-2013:p1213:b004:l025","ordinal":280085,"en":"The gray stallion refused."},{"id":"semetey-2-2013:p1213:b004:l026","ordinal":280086,"en":"Unable to turn his noble neck,"},{"id":"semetey-2-2013:p1213:b004:l027","ordinal":280087,"en":"The gray stallion stood fast."},{"id":"semetey-2-2013:p1213:b004:l028","ordinal":280088,"en":"Like a wild ass, he turned his neck"},{"id":"semetey-2-2013:p1213:b004:l029","ordinal":280089,"en":"Toward the qibla."},{"id":"semetey-2-2013:p1213:b004:l030","ordinal":280090,"en":"Though driven, he stood braying,"},{"id":"semetey-2-2013:p1213:b004:l031","ordinal":280091,"en":"And the gray stallion would not move."},{"id":"semetey-2-2013:p1213:b004:l032","ordinal":280092,"en":"“Well then, if the ancient tales"},{"id":"semetey-2-2013:p1213:b004:l033","ordinal":280093,"en":"Are true,"},{"id":"semetey-2-2013:p1213:b004:l034","ordinal":280094,"en":"My creature, my gray stallion,"},{"id":"semetey-2-2013:p1213:b004:l035","ordinal":280095,"en":"Go ahead to await my uncle Sary Khan."},{"id":"semetey-2-2013:p1213:b004:l036","ordinal":280096,"en":"Go as his companion, noble beast;"},{"id":"semetey-2-2013:p1213:b004:l037","ordinal":280097,"en":"Go together with my uncle."},{"id":"semetey-2-2013:p1213:b004:l038","ordinal":280098,"en":"If you remain alive and ply the world,"},{"id":"semetey-2-2013:p1213:b004:l039","ordinal":280099,"en":"No beast like you will ever leave mortal time.”"},{"id":"semetey-2-2013:p1214:b003:l001","ordinal":280100,"en":"The mighty-born Külchoro"},{"id":"semetey-2-2013:p1214:b003:l002","ordinal":280101,"en":"Seized both ears"},{"id":"semetey-2-2013:p1214:b003:l003","ordinal":280102,"en":"Together with the forelock."},{"id":"semetey-2-2013:p1214:b003:l004","ordinal":280103,"en":"He made the stallion snort"},{"id":"semetey-2-2013:p1214:b003:l005","ordinal":280104,"en":"And felled him where he stood."},{"id":"semetey-2-2013:p1214:b003:l006","ordinal":280105,"en":"Ah, that strong-born, mighty lion"},{"id":"semetey-2-2013:p1214:b003:l007","ordinal":280106,"en":"Then cut off his head."},{"id":"semetey-2-2013:p1214:b003:l008","ordinal":280107,"en":"Until Sary Khan was buried,"},{"id":"semetey-2-2013:p1214:b003:l009","ordinal":280108,"en":"Until the gray stallion was slaughtered—"},{"id":"semetey-2-2013:p1214:b003:l010","ordinal":280109,"en":"Leave this matter here."},{"id":"semetey-2-2013:p1214:b003:l011","ordinal":280110,"en":"Now begin the tale of Kanchoro,"},{"id":"semetey-2-2013:p1214:b003:l012","ordinal":280111,"en":"Whose soul departed amid matchlock fire"},{"id":"semetey-2-2013:p1214:b003:l013","ordinal":280112,"en":"And the drawing of bows."},{"id":"semetey-2-2013:p1214:b003:l014","ordinal":280113,"en":"He gathered the Jediger and led the host,"},{"id":"semetey-2-2013:p1214:b003:l015","ordinal":280114,"en":"So vast it made the earth sag."},{"id":"semetey-2-2013:p1214:b003:l016","ordinal":280115,"en":"The vanguard roared,"},{"id":"semetey-2-2013:p1214:b003:l017","ordinal":280116,"en":"And when one looked upon the rising tumult,"},{"id":"semetey-2-2013:p1214:b003:l018","ordinal":280117,"en":"They were shouting, “Kanchoro!”"},{"id":"semetey-2-2013:p1214:b003:l019","ordinal":280118,"en":"He gathered the strong and led the host,"},{"id":"semetey-2-2013:p1214:b003:l020","ordinal":280119,"en":"Leading no small force, but a multitude,"},{"id":"semetey-2-2013:p1214:b003:l021","ordinal":280120,"en":"Driving the entire army together."},{"id":"semetey-2-2013:p1214:b003:l022","ordinal":280121,"en":"Firing matchlocks and drawing bows,"},{"id":"semetey-2-2013:p1214:b003:l023","ordinal":280122,"en":"They surged forward"},{"id":"semetey-2-2013:p1214:b003:l024","ordinal":280123,"en":"To surround the sultan upon the ridge,"},{"id":"semetey-2-2013:p1214:b003:l025","ordinal":280124,"en":"And close around him,"},{"id":"semetey-2-2013:p1214:b003:l026","ordinal":280125,"en":"To wage battle unto death,"},{"id":"semetey-2-2013:p1214:b003:l027","ordinal":280126,"en":"To exact their vengeful grudge,"},{"id":"semetey-2-2013:p1214:b003:l028","ordinal":280127,"en":"To bring a day of bitter grief,"},{"id":"semetey-2-2013:p1214:b003:l029","ordinal":280128,"en":"And offer the gray-wolf hero Semetey"},{"id":"semetey-2-2013:p1214:b003:l030","ordinal":280129,"en":"As a sacrifice."},{"id":"semetey-2-2013:p1214:b003:l031","ordinal":280130,"en":"The great dark host of Jediger,"},{"id":"semetey-2-2013:p1214:b003:l032","ordinal":280131,"en":"Its ranks upon the rise roaring,"},{"id":"semetey-2-2013:p1214:b003:l033","ordinal":280132,"en":"By the might of almighty God,"},{"id":"semetey-2-2013:p1214:b003:l034","ordinal":280133,"en":"Charged to the last man."},{"id":"semetey-2-2013:p1214:b003:l035","ordinal":280134,"en":"The Jediger covered the earth,"},{"id":"semetey-2-2013:p1214:b003:l036","ordinal":280135,"en":"Shouting “Kyyaz!” as their battle cry."},{"id":"semetey-2-2013:p1214:b003:l037","ordinal":280136,"en":"The army advanced and the people clamored,"},{"id":"semetey-2-2013:p1214:b003:l038","ordinal":280137,"en":"Their renowned men at the front,"},{"id":"semetey-2-2013:p1214:b003:l039","ordinal":280138,"en":"Their heroes along the flanks,"},{"id":"semetey-2-2013:p1214:b004:l001","ordinal":280139,"en":"Ordered to seize and crush him,"},{"id":"semetey-2-2013:p1214:b004:l002","ordinal":280140,"en":"While that fool Kanchoro stayed behind."},{"id":"semetey-2-2013:p1214:b004:l003","ordinal":280141,"en":"The host surged with a deafening uproar,"},{"id":"semetey-2-2013:p1214:b004:l004","ordinal":280142,"en":"Striking the great war drum with a crash,"},{"id":"semetey-2-2013:p1214:b004:l005","ordinal":280143,"en":"The trumpets deafening the ears,"},{"id":"semetey-2-2013:p1214:b004:l006","ordinal":280144,"en":"The drums pounding loudly,"},{"id":"semetey-2-2013:p1214:b004:l007","ordinal":280145,"en":"As they drew near the hero."},{"id":"semetey-2-2013:p1214:b004:l008","ordinal":280146,"en":"The clamorous army came onward."},{"id":"semetey-2-2013:p1214:b004:l009","ordinal":280147,"en":"Külchoro, son of Almambet,"},{"id":"semetey-2-2013:p1214:b004:l010","ordinal":280148,"en":"When he saw the onrushing host,"},{"id":"semetey-2-2013:p1214:b004:l011","ordinal":280149,"en":"Felt his ribs torn apart;"},{"id":"semetey-2-2013:p1214:b004:l012","ordinal":280150,"en":"Tears poured from his eyes,"},{"id":"semetey-2-2013:p1214:b004:l013","ordinal":280151,"en":"And his heart was deeply troubled."},{"id":"semetey-2-2013:p1214:b004:l014","ordinal":280152,"en":"He tightened his belt in earnest,"},{"id":"semetey-2-2013:p1214:b004:l015","ordinal":280153,"en":"And, unable to endure it,"},{"id":"semetey-2-2013:p1214:b004:l016","ordinal":280154,"en":"His whole heart caught fire."},{"id":"semetey-2-2013:p1214:b004:l017","ordinal":280155,"en":"He gripped his spear and made ready,"},{"id":"semetey-2-2013:p1214:b004:l018","ordinal":280156,"en":"And buckled on his scabbardless sword."},{"id":"semetey-2-2013:p1214:b004:l019","ordinal":280157,"en":"His sword would spare no life;"},{"id":"semetey-2-2013:p1214:b004:l020","ordinal":280158,"en":"His heart was torn asunder."},{"id":"semetey-2-2013:p1214:b004:l021","ordinal":280159,"en":"Death’s grim, tumultuous work"},{"id":"semetey-2-2013:p1214:b004:l022","ordinal":280160,"en":"Seemed very near"},{"id":"semetey-2-2013:p1214:b004:l023","ordinal":280161,"en":"To the gray-wolf Choro’s eyes."},{"id":"semetey-2-2013:p1214:b004:l024","ordinal":280162,"en":"“Now my silver-eyed, sun-faced,"},{"id":"semetey-2-2013:p1214:b004:l025","ordinal":280163,"en":"Thunder-voiced uncle,"},{"id":"semetey-2-2013:p1214:b004:l026","ordinal":280164,"en":"The figure who gave me shelter,"},{"id":"semetey-2-2013:p1214:b004:l027","ordinal":280165,"en":"My sovereign and sultan—"},{"id":"semetey-2-2013:p1214:b004:l028","ordinal":280166,"en":"If the great dark Jediger horde"},{"id":"semetey-2-2013:p1214:b004:l029","ordinal":280167,"en":"Overruns him while I give no aid,"},{"id":"semetey-2-2013:p1214:b004:l030","ordinal":280168,"en":"What inheritance could satisfy me?"},{"id":"semetey-2-2013:p1214:b004:l031","ordinal":280169,"en":"Before my uncle, towering like a rugged mountain,"},{"id":"semetey-2-2013:p1214:b004:l032","ordinal":280170,"en":"I shall die first"},{"id":"semetey-2-2013:p1214:b004:l033","ordinal":280171,"en":"And go as a sacrifice."},{"id":"semetey-2-2013:p1214:b004:l034","ordinal":280172,"en":"If I turn away in battle,"},{"id":"semetey-2-2013:p1214:b004:l035","ordinal":280173,"en":"Though his shelter is worth a hundred armies,"},{"id":"semetey-2-2013:p1214:b004:l036","ordinal":280174,"en":"And lose the one who shields me,"},{"id":"semetey-2-2013:p1214:b004:l037","ordinal":280175,"en":"What inheritance could satisfy me?"},{"id":"semetey-2-2013:p1214:b004:l038","ordinal":280176,"en":"He carved me meat and gave me fat,"},{"id":"semetey-2-2013:p1214:b004:l039","ordinal":280177,"en":"And fed me butter when I hungered."},{"id":"semetey-2-2013:p1215:b003:l001","ordinal":280178,"en":"He sharpened and trained me for war."},{"id":"semetey-2-2013:p1215:b003:l002","ordinal":280179,"en":"Almambet, who departed for the other world,"},{"id":"semetey-2-2013:p1215:b003:l003","ordinal":280180,"en":"Guarded me better than my father."},{"id":"semetey-2-2013:p1215:b003:l004","ordinal":280181,"en":"When I reached the age of six,"},{"id":"semetey-2-2013:p1215:b003:l005","ordinal":280182,"en":"He had an amulet hung around my neck."},{"id":"semetey-2-2013:p1215:b003:l006","ordinal":280183,"en":"Wishing me to become a peerless gray wolf,"},{"id":"semetey-2-2013:p1215:b003:l007","ordinal":280184,"en":"He raised me with tender affection,"},{"id":"semetey-2-2013:p1215:b003:l008","ordinal":280185,"en":"Led me with him and made me a warrior,"},{"id":"semetey-2-2013:p1215:b003:l009","ordinal":280186,"en":"And made me equal to his own heroic son."},{"id":"semetey-2-2013:p1215:b003:l010","ordinal":280187,"en":"He made me raid true Kakan and Beijing"},{"id":"semetey-2-2013:p1215:b003:l011","ordinal":280188,"en":"Without the least mercy."},{"id":"semetey-2-2013:p1215:b003:l012","ordinal":280189,"en":"How could I let myself be parted"},{"id":"semetey-2-2013:p1215:b003:l013","ordinal":280190,"en":"From my dark gray-wolf lion?"},{"id":"semetey-2-2013:p1215:b003:l014","ordinal":280191,"en":"How could I abandon"},{"id":"semetey-2-2013:p1215:b003:l015","ordinal":280192,"en":"My noble gray-wolf hero,"},{"id":"semetey-2-2013:p1215:b003:l016","ordinal":280193,"en":"My fearsome, blood-spilling uncle?"},{"id":"semetey-2-2013:p1215:b003:l017","ordinal":280194,"en":"The Jediger are ten thousand and I am alone,"},{"id":"semetey-2-2013:p1215:b003:l018","ordinal":280195,"en":"Yet for seven months without rest"},{"id":"semetey-2-2013:p1215:b003:l019","ordinal":280196,"en":"I shall fight them to mutual destruction."},{"id":"semetey-2-2013:p1215:b003:l020","ordinal":280197,"en":"Against the massed Jediger"},{"id":"semetey-2-2013:p1215:b003:l021","ordinal":280198,"en":"I shall stand and level my spear;"},{"id":"semetey-2-2013:p1215:b003:l022","ordinal":280199,"en":"For ninety days without rest I shall fight,"},{"id":"semetey-2-2013:p1215:b003:l023","ordinal":280200,"en":"And unleash hellish wrath."},{"id":"semetey-2-2013:p1215:b003:l024","ordinal":280201,"en":"I shall rescue"},{"id":"semetey-2-2013:p1215:b003:l025","ordinal":280202,"en":"My valiant lionhearted uncle;"},{"id":"semetey-2-2013:p1215:b003:l026","ordinal":280203,"en":"I shall drive the strong before me and slaughter them."},{"id":"semetey-2-2013:p1215:b003:l027","ordinal":280204,"en":"For this peerless gray wolf"},{"id":"semetey-2-2013:p1215:b003:l028","ordinal":280205,"en":"I shall fall as a sacrifice at his feet!”"},{"id":"semetey-2-2013:p1215:b003:l029","ordinal":280206,"en":"Thus spoke Külchoro:"},{"id":"semetey-2-2013:p1215:b003:l030","ordinal":280207,"en":"“I shall drive away their strongest."},{"id":"semetey-2-2013:p1215:b003:l031","ordinal":280208,"en":"Damn you, Jediger—"},{"id":"semetey-2-2013:p1215:b003:l032","ordinal":280209,"en":"He who spares an enemy will be wounded;"},{"id":"semetey-2-2013:p1215:b003:l033","ordinal":280210,"en":"He who spares his horse is left afield."},{"id":"semetey-2-2013:p1215:b003:l034","ordinal":280211,"en":"I shall strike down even the blameless"},{"id":"semetey-2-2013:p1215:b003:l035","ordinal":280212,"en":"And make a slaughter of them."},{"id":"semetey-2-2013:p1215:b003:l036","ordinal":280213,"en":"I shall drive the boastful Jediger"},{"id":"semetey-2-2013:p1215:b003:l037","ordinal":280214,"en":"Toward Jeti-Özön,"},{"id":"semetey-2-2013:p1215:b003:l038","ordinal":280215,"en":"Make them cry, ‘Jakey, mercy!’"},{"id":"semetey-2-2013:p1215:b003:l039","ordinal":280216,"en":"And force them truly to taste torment."},{"id":"semetey-2-2013:p1215:b004:l001","ordinal":280217,"en":"Those who survive the dead"},{"id":"semetey-2-2013:p1215:b004:l002","ordinal":280218,"en":"I shall make cry, ‘Akebai, mercy!’"},{"id":"semetey-2-2013:p1215:b004:l003","ordinal":280219,"en":"I shall make a glorious massacre."},{"id":"semetey-2-2013:p1215:b004:l004","ordinal":280220,"en":"Between Kyyaz and Kanchoro,"},{"id":"semetey-2-2013:p1215:b004:l005","ordinal":280221,"en":"I shall take the head of one."},{"id":"semetey-2-2013:p1215:b004:l006","ordinal":280222,"en":"Before my uncle"},{"id":"semetey-2-2013:p1215:b004:l007","ordinal":280223,"en":"I shall offer it in sacrifice."},{"id":"semetey-2-2013:p1215:b004:l008","ordinal":280224,"en":"While my uncle’s eyes still see,"},{"id":"semetey-2-2013:p1215:b004:l009","ordinal":280225,"en":"I shall wage a battle,"},{"id":"semetey-2-2013:p1215:b004:l010","ordinal":280226,"en":"Make their blood flow like water,"},{"id":"semetey-2-2013:p1215:b004:l011","ordinal":280227,"en":"And exact my long-carried vengeance."},{"id":"semetey-2-2013:p1215:b004:l012","ordinal":280228,"en":"While his eyes are still alive,"},{"id":"semetey-2-2013:p1215:b004:l013","ordinal":280229,"en":"For my lord, my gray-wolf uncle,"},{"id":"semetey-2-2013:p1215:b004:l014","ordinal":280230,"en":"I shall become a sacrifice."},{"id":"semetey-2-2013:p1215:b004:l015","ordinal":280231,"en":"Making them cry, ‘Poor Choro!’"},{"id":"semetey-2-2013:p1215:b004:l016","ordinal":280232,"en":"I shall unleash a mighty exchange of fire.”"},{"id":"semetey-2-2013:p1215:b004:l017","ordinal":280233,"en":"Thus spoke Külchoro,"},{"id":"semetey-2-2013:p1215:b004:l018","ordinal":280234,"en":"Thick-armed and stonehearted,"},{"id":"semetey-2-2013:p1215:b004:l019","ordinal":280235,"en":"The broad-limbed, formidable warrior."},{"id":"semetey-2-2013:p1215:b004:l020","ordinal":280236,"en":"He buckled on his scabbardless sword;"},{"id":"semetey-2-2013:p1215:b004:l021","ordinal":280237,"en":"The tiger-born lion Choro"},{"id":"semetey-2-2013:p1215:b004:l022","ordinal":280238,"en":"Seemed about to become a storm,"},{"id":"semetey-2-2013:p1215:b004:l023","ordinal":280239,"en":"Ready to slaughter whoever crossed his path."},{"id":"semetey-2-2013:p1215:b004:l024","ordinal":280240,"en":"Wrath spread across his face,"},{"id":"semetey-2-2013:p1215:b004:l025","ordinal":280241,"en":"And he strained like a lion."},{"id":"semetey-2-2013:p1215:b004:l026","ordinal":280242,"en":"The formidable gray wolf"},{"id":"semetey-2-2013:p1215:b004:l027","ordinal":280243,"en":"Found his battle cunning,"},{"id":"semetey-2-2013:p1215:b004:l028","ordinal":280244,"en":"And thundered in anger."},{"id":"semetey-2-2013:p1215:b004:l029","ordinal":280245,"en":"No soul could withstand his awesome presence;"},{"id":"semetey-2-2013:p1215:b004:l030","ordinal":280246,"en":"All men trembled."},{"id":"semetey-2-2013:p1215:b004:l031","ordinal":280247,"en":"He thundered in fury,"},{"id":"semetey-2-2013:p1215:b004:l032","ordinal":280248,"en":"No soul able to withstand his might;"},{"id":"semetey-2-2013:p1215:b004:l033","ordinal":280249,"en":"All who saw him quaked."},{"id":"semetey-2-2013:p1215:b004:l034","ordinal":280250,"en":"Behold what your Choro was like:"},{"id":"semetey-2-2013:p1215:b004:l035","ordinal":280251,"en":"The bold and dashing lion Choro,"},{"id":"semetey-2-2013:p1215:b004:l036","ordinal":280252,"en":"Peerless in swiftness,"},{"id":"semetey-2-2013:p1215:b004:l037","ordinal":280253,"en":"The clashing hero Choro."},{"id":"semetey-2-2013:p1215:b004:l038","ordinal":280254,"en":"He looked to either side;"},{"id":"semetey-2-2013:p1215:b004:l039","ordinal":280255,"en":"Behold your gray-wolf Choro,"},{"id":"semetey-2-2013:p1216:b003:l001","ordinal":280256,"en":"Licking his lips."},{"id":"semetey-2-2013:p1216:b003:l002","ordinal":280257,"en":"Both champion and lion,"},{"id":"semetey-2-2013:p1216:b003:l003","ordinal":280258,"en":"A hero poised like a falcon,"},{"id":"semetey-2-2013:p1216:b003:l004","ordinal":280259,"en":"He made the whole world submit,"},{"id":"semetey-2-2013:p1216:b003:l005","ordinal":280260,"en":"And threw all he faced into turmoil."},{"id":"semetey-2-2013:p1216:b003:l006","ordinal":280261,"en":"When he seized his sword with a shout,"},{"id":"semetey-2-2013:p1216:b003:l007","ordinal":280262,"en":"Those who came against him"},{"id":"semetey-2-2013:p1216:b003:l008","ordinal":280263,"en":"Were drenched in black blood."},{"id":"semetey-2-2013:p1216:b003:l009","ordinal":280264,"en":"Diviners judged and foretold"},{"id":"semetey-2-2013:p1216:b003:l010","ordinal":280265,"en":"That he was the mightiest in the world."},{"id":"semetey-2-2013:p1216:b003:l011","ordinal":280266,"en":"When he swung his sword with a shout,"},{"id":"semetey-2-2013:p1216:b003:l012","ordinal":280267,"en":"A great many"},{"id":"semetey-2-2013:p1216:b003:l013","ordinal":280268,"en":"Of humankind perished."},{"id":"semetey-2-2013:p1216:b003:l014","ordinal":280269,"en":"Trembling at the sound of his name,"},{"id":"semetey-2-2013:p1216:b003:l015","ordinal":280270,"en":"Even the people of distant Beijing withered."},{"id":"semetey-2-2013:p1216:b003:l016","ordinal":280271,"en":"When he faced them and leveled his spear,"},{"id":"semetey-2-2013:p1216:b003:l017","ordinal":280272,"en":"All mortals fell beneath it."},{"id":"semetey-2-2013:p1216:b003:l018","ordinal":280273,"en":"Of all whom ears had heard and eyes had seen,"},{"id":"semetey-2-2013:p1216:b003:l019","ordinal":280274,"en":"None was as mighty as Choro."},{"id":"semetey-2-2013:p1216:b003:l020","ordinal":280275,"en":"If you ask what Külchoro was like,"},{"id":"semetey-2-2013:p1216:b003:l021","ordinal":280276,"en":"He was the red ember of the saxaul,"},{"id":"semetey-2-2013:p1216:b003:l022","ordinal":280277,"en":"The tempered steel bullet of the firearm."},{"id":"semetey-2-2013:p1216:b003:l023","ordinal":280278,"en":"Both champion and lion,"},{"id":"semetey-2-2013:p1216:b003:l024","ordinal":280279,"en":"Among all sons born of men,"},{"id":"semetey-2-2013:p1216:b003:l025","ordinal":280280,"en":"No hero could equal him."},{"id":"semetey-2-2013:p1216:b003:l026","ordinal":280281,"en":"Armored against bullets,"},{"id":"semetey-2-2013:p1216:b003:l027","ordinal":280282,"en":"From beyond the forked pass and high ridge,"},{"id":"semetey-2-2013:p1216:b003:l028","ordinal":280283,"en":"Without letting them reach his heroic uncle,"},{"id":"semetey-2-2013:p1216:b003:l029","ordinal":280284,"en":"He met the earth-covering Jediger"},{"id":"semetey-2-2013:p1216:b003:l030","ordinal":280285,"en":"And attacked them in return."},{"id":"semetey-2-2013:p1216:b003:l031","ordinal":280286,"en":"Stooping low, he speared warriors."},{"id":"semetey-2-2013:p1216:b003:l032","ordinal":280287,"en":"The peerless champion, that gallant man,"},{"id":"semetey-2-2013:p1216:b003:l033","ordinal":280288,"en":"Impaled twenty or thirty at a thrust,"},{"id":"semetey-2-2013:p1216:b003:l034","ordinal":280289,"en":"Spearing all within his reach—"},{"id":"semetey-2-2013:p1216:b003:l035","ordinal":280290,"en":"Where now were their leaders?"},{"id":"semetey-2-2013:p1216:b003:l036","ordinal":280291,"en":"He speared all who assailed him—"},{"id":"semetey-2-2013:p1216:b003:l037","ordinal":280292,"en":"Where now were their bloodthirsty men?"},{"id":"semetey-2-2013:p1216:b003:l038","ordinal":280293,"en":"While peerless Manas lived,"},{"id":"semetey-2-2013:p1216:b003:l039","ordinal":280294,"en":"So that worthy men might receive gifts,"},{"id":"semetey-2-2013:p1216:b004:l001","ordinal":280295,"en":"Seven banners given as tribute"},{"id":"semetey-2-2013:p1216:b004:l002","ordinal":280296,"en":"Were planted in seven places."},{"id":"semetey-2-2013:p1216:b004:l003","ordinal":280297,"en":"Such was the consummate warrior,"},{"id":"semetey-2-2013:p1216:b004:l004","ordinal":280298,"en":"Making those he reached fall slain."},{"id":"semetey-2-2013:p1216:b004:l005","ordinal":280299,"en":"Six banners given by nobles"},{"id":"semetey-2-2013:p1216:b004:l006","ordinal":280300,"en":"He planted in six places,"},{"id":"semetey-2-2013:p1216:b004:l007","ordinal":280301,"en":"Driving them down and slaughtering them."},{"id":"semetey-2-2013:p1216:b004:l008","ordinal":280302,"en":"With a steel shaft and sharpened point,"},{"id":"semetey-2-2013:p1216:b004:l009","ordinal":280303,"en":"The keen-tipped ornamented spears"},{"id":"semetey-2-2013:p1216:b004:l010","ordinal":280304,"en":"Were thrust as they charged,"},{"id":"semetey-2-2013:p1216:b004:l011","ordinal":280305,"en":"Striking the measured ground,"},{"id":"semetey-2-2013:p1216:b004:l012","ordinal":280306,"en":"Clashing against one another."},{"id":"semetey-2-2013:p1216:b004:l013","ordinal":280307,"en":"He sent his spear whistling,"},{"id":"semetey-2-2013:p1216:b004:l014","ordinal":280308,"en":"And hurled the Jediger heroes"},{"id":"semetey-2-2013:p1216:b004:l015","ordinal":280309,"en":"From their saddles with his spear."},{"id":"semetey-2-2013:p1216:b004:l016","ordinal":280310,"en":"Making them cry, “Jakey, mercy!”"},{"id":"semetey-2-2013:p1216:b004:l017","ordinal":280311,"en":"He drove the Jediger"},{"id":"semetey-2-2013:p1216:b004:l018","ordinal":280312,"en":"Headlong before him."},{"id":"semetey-2-2013:p1216:b004:l019","ordinal":280313,"en":"Those places that had boasted of their strength,"},{"id":"semetey-2-2013:p1216:b004:l020","ordinal":280314,"en":"He subdued one after another."},{"id":"semetey-2-2013:p1216:b004:l021","ordinal":280315,"en":"Leaving none who fought him alive,"},{"id":"semetey-2-2013:p1216:b004:l022","ordinal":280316,"en":"He laid them low as he advanced."},{"id":"semetey-2-2013:p1216:b004:l023","ordinal":280317,"en":"Driving the Jediger headlong,"},{"id":"semetey-2-2013:p1216:b004:l024","ordinal":280318,"en":"He came onward, felling them."},{"id":"semetey-2-2013:p1216:b004:l025","ordinal":280319,"en":"The lionhood of noble-born Choro"},{"id":"semetey-2-2013:p1216:b004:l026","ordinal":280320,"en":"Was plain to see."}]
