[{"id":"semetey-1-2013:p0956:b003:l005","ordinal":150017,"en":"He who gave his hand to twelve spiritual guides,"},{"id":"semetey-1-2013:p0956:b003:l006","ordinal":150018,"en":"My father-in-law, departed as a holy man—"},{"id":"semetey-1-2013:p0956:b003:l007","ordinal":150019,"en":"Let me honor his ancestral spirit."},{"id":"semetey-1-2013:p0956:b004:l001","ordinal":150020,"en":"Let me fly down Talas"},{"id":"semetey-1-2013:p0956:b004:l002","ordinal":150021,"en":"And reach the great mausoleum;"},{"id":"semetey-1-2013:p0956:b004:l003","ordinal":150022,"en":"My father who went to the other world,"},{"id":"semetey-1-2013:p0956:b004:l004","ordinal":150023,"en":"Let me visit his tomb in reverence."},{"id":"semetey-1-2013:p0956:b004:l005","ordinal":150024,"en":"Then flying swiftly onward,"},{"id":"semetey-1-2013:p0956:b004:l006","ordinal":150025,"en":"Roaming down Ken-Kol,"},{"id":"semetey-1-2013:p0956:b004:l007","ordinal":150026,"en":"Unfortunate Aichurok arrived."},{"id":"semetey-1-2013:p0956:b006:l001","ordinal":150027,"en":"The great mausoleum in Talas—"},{"id":"semetey-1-2013:p0956:b006:l002","ordinal":150028,"en":"Beside that great mausoleum,"},{"id":"semetey-1-2013:p0956:b006:l003","ordinal":150029,"en":"For Manas, gone to the other world,"},{"id":"semetey-1-2013:p0956:b006:l004","ordinal":150030,"en":"She recited a blessing, saying, “Amen.”"},{"id":"semetey-1-2013:p0956:b006:l005","ordinal":150031,"en":"The surah called “Tappat”"},{"id":"semetey-1-2013:p0956:b006:l006","ordinal":150032,"en":"She recited astonishingly fast."},{"id":"semetey-1-2013:p0956:b006:l007","ordinal":150033,"en":"When she looked this way,"},{"id":"semetey-1-2013:p0956:b006:l008","ordinal":150034,"en":"Argyn and Kyrgyz had drawn toward the lowlands"},{"id":"semetey-1-2013:p0956:b006:l009","ordinal":150035,"en":"And were settled there."},{"id":"semetey-1-2013:p0956:b006:l010","ordinal":150036,"en":"Kumys by day, girls by night—"},{"id":"semetey-1-2013:p0956:b006:l011","ordinal":150037,"en":"Such were their days then."},{"id":"semetey-1-2013:p0956:b006:l012","ordinal":150038,"en":"Wearing a sable hat to match,"},{"id":"semetey-1-2013:p0956:b006:l013","ordinal":150039,"en":"They swayed about then;"},{"id":"semetey-1-2013:p0956:b006:l014","ordinal":150040,"en":"Linked together, the Kyrgyz"},{"id":"semetey-1-2013:p0956:b006:l015","ordinal":150041,"en":"Were rejoicing then."},{"id":"semetey-1-2013:p0956:b006:l016","ordinal":150042,"en":"At that time the Kyrgyz people"},{"id":"semetey-1-2013:p0956:b006:l017","ordinal":150043,"en":"Had taken whole otter pelts"},{"id":"semetey-1-2013:p0956:b006:l018","ordinal":150044,"en":"And split them open lengthwise."},{"id":"semetey-1-2013:p0956:b006:l019","ordinal":150045,"en":"There was an orchard planted in Talas;"},{"id":"semetey-1-2013:p0956:b006:l020","ordinal":150046,"en":"He was arrested."},{"id":"semetey-1-2013:p0956:b006:l021","ordinal":150047,"en":"At that time among the Kyrgyz,"},{"id":"semetey-1-2013:p0956:b006:l022","ordinal":150048,"en":"The poor man drove a thousand sheep,"},{"id":"semetey-1-2013:p0956:b006:l023","ordinal":150049,"en":"The old woman chewed fat tail."},{"id":"semetey-1-2013:p0956:b006:l024","ordinal":150050,"en":"Of the teeming Kyrgyz,"},{"id":"semetey-1-2013:p0956:b006:l025","ordinal":150051,"en":"What trouble of theirs should I tell?"},{"id":"semetey-1-2013:p0956:b006:l026","ordinal":150052,"en":"With ornamented hair-braids and broad hips,"},{"id":"semetey-1-2013:p0956:b006:l027","ordinal":150053,"en":"Beautiful were the Kyrgyz daughters-in-law."},{"id":"semetey-1-2013:p0956:b007:l001","ordinal":150054,"en":"In red dresses, with slender waists,"},{"id":"semetey-1-2013:p0956:b007:l002","ordinal":150055,"en":"Beautiful were the Kyrgyz girls."},{"id":"semetey-1-2013:p0956:b007:l003","ordinal":150056,"en":"In black coats and white felt hats,"},{"id":"semetey-1-2013:p0956:b007:l004","ordinal":150057,"en":"Handsome were the Kyrgyz people."},{"id":"semetey-1-2013:p0956:b007:l005","ordinal":150058,"en":"More rice than millet and barley,"},{"id":"semetey-1-2013:p0956:b007:l006","ordinal":150059,"en":"More silver than tin,"},{"id":"semetey-1-2013:p0956:b007:l007","ordinal":150060,"en":"More foxes than gray hares,"},{"id":"semetey-1-2013:p0956:b007:l008","ordinal":150061,"en":"Much property heaped at their thresholds;"},{"id":"semetey-1-2013:p0956:b007:l009","ordinal":150062,"en":"They wore fox fur and sable."},{"id":"semetey-1-2013:p0956:b007:l010","ordinal":150063,"en":"The orphan had grown to maturity,"},{"id":"semetey-1-2013:p0956:b007:l011","ordinal":150064,"en":"Joined his own people,"},{"id":"semetey-1-2013:p0956:b007:l012","ordinal":150065,"en":"And Semetey had become their leader."},{"id":"semetey-1-2013:p0956:b007:l013","ordinal":150066,"en":"Aichurok did not know this;"},{"id":"semetey-1-2013:p0956:b007:l014","ordinal":150067,"en":"She was astonished at what she saw."},{"id":"semetey-1-2013:p0956:b007:l015","ordinal":150068,"en":"Their fine men wore"},{"id":"semetey-1-2013:p0956:b007:l016","ordinal":150069,"en":"Black caps of blue lynx fur;"},{"id":"semetey-1-2013:p0956:b007:l017","ordinal":150070,"en":"All their fine men"},{"id":"semetey-1-2013:p0956:b007:l018","ordinal":150071,"en":"Were alike in their fearlessness."},{"id":"semetey-1-2013:p0956:b007:l019","ordinal":150072,"en":"They had winged steeds beneath them;"},{"id":"semetey-1-2013:p0956:b007:l020","ordinal":150073,"en":"When six or seven went together,"},{"id":"semetey-1-2013:p0956:b007:l021","ordinal":150074,"en":"They had strength to match Chynkojo."},{"id":"semetey-1-2013:p0956:b007:l022","ordinal":150075,"en":"All of them rode"},{"id":"semetey-1-2013:p0956:b007:l023","ordinal":150076,"en":"Karabair warhorses,"},{"id":"semetey-1-2013:p0956:b007:l024","ordinal":150077,"en":"With sieve-like lungs and copper forelegs."},{"id":"semetey-1-2013:p0956:b007:l025","ordinal":150078,"en":"Jilgynduu, Ken-Kol, and Talas—"},{"id":"semetey-1-2013:p0956:b007:l026","ordinal":150079,"en":"Delighted to see those lands,"},{"id":"semetey-1-2013:p0956:b007:l027","ordinal":150080,"en":"Aichurok now rejoiced."},{"id":"semetey-1-2013:p0957:b003:l001","ordinal":150081,"en":"Delighted to see her people,"},{"id":"semetey-1-2013:p0957:b003:l002","ordinal":150082,"en":"The horse's mouth is weak,"},{"id":"semetey-1-2013:p0957:b003:l003","ordinal":150083,"en":"You ride like an animal."},{"id":"semetey-1-2013:p0957:b003:l004","ordinal":150084,"en":"The backs of their spears were like hair-braids;"},{"id":"semetey-1-2013:p0957:b003:l005","ordinal":150085,"en":"The Kyrgyz people are not here."},{"id":"semetey-1-2013:p0957:b003:l006","ordinal":150086,"en":"Aichurok was amazed:"},{"id":"semetey-1-2013:p0957:b003:l007","ordinal":150087,"en":"“Are these my father-in-law's people?"},{"id":"semetey-1-2013:p0957:b003:l008","ordinal":150088,"en":"Let me go and see his horses."},{"id":"semetey-1-2013:p0957:b003:l009","ordinal":150089,"en":"When I learned from those who knew,"},{"id":"semetey-1-2013:p0957:b003:l010","ordinal":150090,"en":"When I asked the knowledgeable,"},{"id":"semetey-1-2013:p0957:b003:l011","ordinal":150091,"en":"Many people told me:"},{"id":"semetey-1-2013:p0957:b003:l012","ordinal":150092,"en":"‘His horses are red roans,’ they said."},{"id":"semetey-1-2013:p0957:b003:l014","ordinal":150093,"en":"All the people told me:"},{"id":"semetey-1-2013:p0957:b003:l015","ordinal":150094,"en":"‘Your father-in-law's horses"},{"id":"semetey-1-2013:p0957:b003:l016","ordinal":150095,"en":"Are dark roans,’ they said."},{"id":"semetey-1-2013:p0957:b003:l017","ordinal":150096,"en":"Let me find out truly and certainly,"},{"id":"semetey-1-2013:p0957:b003:l018","ordinal":150097,"en":"And of the noble man gone to the other world,"},{"id":"semetey-1-2013:p0957:b003:l019","ordinal":150098,"en":"Let me honor his ancestral spirit.”"},{"id":"semetey-1-2013:p0957:b003:l020","ordinal":150099,"en":"As a swan she cried hoarsely,"},{"id":"semetey-1-2013:p0957:b003:l021","ordinal":150100,"en":"Unable to see her companion clearly,"},{"id":"semetey-1-2013:p0957:b003:l022","ordinal":150101,"en":"Poor Churok fluttered gently."},{"id":"semetey-1-2013:p0957:b003:l023","ordinal":150102,"en":"In the hollow of Uch-Koshoi,"},{"id":"semetey-1-2013:p0957:b003:l024","ordinal":150103,"en":"Along Tash-Tulga,"},{"id":"semetey-1-2013:p0957:b003:l025","ordinal":150104,"en":"At Kara-Buura and Chatkal,"},{"id":"semetey-1-2013:p0957:b003:l026","ordinal":150105,"en":"Where the Argyn lay at ease,"},{"id":"semetey-1-2013:p0957:b003:l027","ordinal":150106,"en":"She saw ridge after hilly ridge,"},{"id":"semetey-1-2013:p0957:b003:l028","ordinal":150107,"en":"Saw wondrous places among the hills."},{"id":"semetey-1-2013:p0957:b003:l029","ordinal":150108,"en":"Grazing on those hills"},{"id":"semetey-1-2013:p0957:b003:l030","ordinal":150109,"en":"Were countless horses, a vast multitude."},{"id":"semetey-1-2013:p0957:b003:l031","ordinal":150110,"en":"In the hills were mottled-headed horses,"},{"id":"semetey-1-2013:p0957:b003:l032","ordinal":150111,"en":"Piebald and chestnut mixed together,"},{"id":"semetey-1-2013:p0957:b003:l033","ordinal":150112,"en":"Ash-gray ones with rings on their legs,"},{"id":"semetey-1-2013:p0957:b003:l034","ordinal":150113,"en":"Fat ones that had never been ridden."},{"id":"semetey-1-2013:p0957:b003:l035","ordinal":150114,"en":"Her gaze could not encompass them;"},{"id":"semetey-1-2013:p0957:b003:l036","ordinal":150115,"en":"The teeming multitude of horses—"},{"id":"semetey-1-2013:p0957:b003:l037","ordinal":150116,"en":"Their kinds could not be distinguished."},{"id":"semetey-1-2013:p0957:b003:l038","ordinal":150117,"en":"With stallions' manes and mares' bellies,"},{"id":"semetey-1-2013:p0957:b003:l039","ordinal":150118,"en":"One kind among those horses"},{"id":"semetey-1-2013:p0957:b004:l001","ordinal":150119,"en":"Were fully alike, all dun,"},{"id":"semetey-1-2013:p0957:b004:l002","ordinal":150120,"en":"With amulet-shaped marks upon their foreheads."},{"id":"semetey-1-2013:p0957:b004:l003","ordinal":150121,"en":"There were more geldings than stallions;"},{"id":"semetey-1-2013:p0957:b004:l004","ordinal":150122,"en":"All were renowned winged steeds,"},{"id":"semetey-1-2013:p0957:b004:l005","ordinal":150123,"en":"Karabair warhorses,"},{"id":"semetey-1-2013:p0957:b004:l006","ordinal":150124,"en":"Plainly different from ordinary livestock."},{"id":"semetey-1-2013:p0957:b004:l007","ordinal":150125,"en":"Their foals were like horses in their third year;"},{"id":"semetey-1-2013:p0957:b004:l008","ordinal":150126,"en":"Such wonderful beasts, curse them!"},{"id":"semetey-1-2013:p0957:b004:l009","ordinal":150127,"en":"No one who saw them could leave;"},{"id":"semetey-1-2013:p0957:b004:l010","ordinal":150128,"en":"Look at the kinds in that great herd."},{"id":"semetey-1-2013:p0957:b004:l011","ordinal":150129,"en":"One breed among the horses"},{"id":"semetey-1-2013:p0957:b004:l012","ordinal":150130,"en":"Was mottled yellow like starlings;"},{"id":"semetey-1-2013:p0957:b004:l013","ordinal":150131,"en":"One other part of the herd"},{"id":"semetey-1-2013:p0957:b004:l014","ordinal":150132,"en":"Was coal-black."},{"id":"semetey-1-2013:p0957:b004:l015","ordinal":150133,"en":"As she watched the horses,"},{"id":"semetey-1-2013:p0957:b004:l016","ordinal":150134,"en":"Smiling Churok was astonished."},{"id":"semetey-1-2013:p0957:b004:l017","ordinal":150135,"en":"“When we learned from those who knew,"},{"id":"semetey-1-2013:p0957:b004:l018","ordinal":150136,"en":"When we asked the knowledgeable,"},{"id":"semetey-1-2013:p0957:b004:l019","ordinal":150137,"en":"My father-in-law's horses"},{"id":"semetey-1-2013:p0957:b004:l020","ordinal":150138,"en":"Along this Talas"},{"id":"semetey-1-2013:p0957:b004:l021","ordinal":150139,"en":"Were said to be dark roans."},{"id":"semetey-1-2013:p0957:b004:l022","ordinal":150140,"en":"The horses of distinct appearance,"},{"id":"semetey-1-2013:p0957:b004:l023","ordinal":150141,"en":"That looked different from the rest—"},{"id":"semetey-1-2013:p0957:b004:l024","ordinal":150142,"en":"The leopard's horses"},{"id":"semetey-1-2013:p0957:b004:l025","ordinal":150143,"en":"Were said to be red roans."},{"id":"semetey-1-2013:p0957:b004:l026","ordinal":150144,"en":"When the leopard warrior died,"},{"id":"semetey-1-2013:p0957:b004:l027","ordinal":150145,"en":"When the people gathered and buried him,"},{"id":"semetey-1-2013:p0957:b004:l028","ordinal":150146,"en":"When they camped along the river,"},{"id":"semetey-1-2013:p0957:b004:l029","ordinal":150147,"en":"After the leopard passed away,"},{"id":"semetey-1-2013:p0957:b004:l030","ordinal":150148,"en":"Did all the mass of people"},{"id":"semetey-1-2013:p0957:b004:l031","ordinal":150149,"en":"Become as though their fire had gone out?"},{"id":"semetey-1-2013:p0957:b004:l032","ordinal":150150,"en":"Had they heard the news—"},{"id":"semetey-1-2013:p0957:b004:l033","ordinal":150151,"en":"The many Chinese, the great Manchu host—"},{"id":"semetey-1-2013:p0957:b004:l034","ordinal":150152,"en":"And overrun the place and settled here?"},{"id":"semetey-1-2013:p0957:b004:l035","ordinal":150153,"en":"Had they taken possession of his horses"},{"id":"semetey-1-2013:p0957:b004:l036","ordinal":150154,"en":"And put red stallions among them?"},{"id":"semetey-1-2013:p0957:b004:l037","ordinal":150155,"en":"Was it through this that his horses"},{"id":"semetey-1-2013:p0957:b004:l038","ordinal":150156,"en":"Had become all red?”"},{"id":"semetey-1-2013:p0957:b004:l039","ordinal":150157,"en":"Looking on, Aichurok"},{"id":"semetey-1-2013:p0958:b003:l001","ordinal":150158,"en":"Her sun grew overcast in the sky,"},{"id":"semetey-1-2013:p0958:b003:l002","ordinal":150159,"en":"Sixty cares came upon her at once;"},{"id":"semetey-1-2013:p0958:b003:l003","ordinal":150160,"en":"Her heart was torn,"},{"id":"semetey-1-2013:p0958:b003:l004","ordinal":150161,"en":"Her tears poured down."},{"id":"semetey-1-2013:p0958:b003:l005","ordinal":150162,"en":"At the sight of the horses, Churok's"},{"id":"semetey-1-2013:p0958:b003:l006","ordinal":150163,"en":"Heart was truly troubled:"},{"id":"semetey-1-2013:p0958:b003:l007","ordinal":150164,"en":"“Finding no support to rely upon,"},{"id":"semetey-1-2013:p0958:b003:l008","ordinal":150165,"en":"No mortal is as unfortunate as I,"},{"id":"semetey-1-2013:p0958:b003:l009","ordinal":150166,"en":"Searching hard and finding no husband!"},{"id":"semetey-1-2013:p0958:b003:l010","ordinal":150167,"en":"Shall I die seeking a husband?"},{"id":"semetey-1-2013:p0958:b003:l011","ordinal":150168,"en":"From Toltoi of the Jediger,"},{"id":"semetey-1-2013:p0958:b003:l012","ordinal":150169,"en":"Shall I suffer utter humiliation?"},{"id":"semetey-1-2013:p0958:b003:l013","ordinal":150170,"en":"In many places I have seen mighty men,"},{"id":"semetey-1-2013:p0958:b003:l014","ordinal":150171,"en":"Yet found no husband to my liking, all alone;"},{"id":"semetey-1-2013:p0958:b003:l015","ordinal":150172,"en":"My misery has boiled over."},{"id":"semetey-1-2013:p0958:b003:l016","ordinal":150173,"en":"Black and gray shirt"},{"id":"semetey-1-2013:p0958:b003:l017","ordinal":150174,"en":"With what face shall I wear it?"},{"id":"semetey-1-2013:p0958:b003:l018","ordinal":150175,"en":"To Toltoi of the Jediger,"},{"id":"semetey-1-2013:p0958:b003:l019","ordinal":150176,"en":"As a wife taken in booty,"},{"id":"semetey-1-2013:p0958:b003:l020","ordinal":150177,"en":"With what face shall I be married?"},{"id":"semetey-1-2013:p0958:b003:l021","ordinal":150178,"en":"I have wandered through so many places;"},{"id":"semetey-1-2013:p0958:b003:l022","ordinal":150179,"en":"How can I go on without finding a husband?”"},{"id":"semetey-1-2013:p0958:b003:l023","ordinal":150180,"en":"Her thoughts badly troubled,"},{"id":"semetey-1-2013:p0958:b003:l024","ordinal":150181,"en":"Falteringly, Aichurok flew."},{"id":"semetey-1-2013:p0958:b003:l025","ordinal":150182,"en":"Opposite Bar-Kol,"},{"id":"semetey-1-2013:p0958:b003:l026","ordinal":150183,"en":"Aichurok alighted to keep watch."},{"id":"semetey-1-2013:p0958:b003:l027","ordinal":150184,"en":"As the day grew late, in the afternoon,"},{"id":"semetey-1-2013:p0958:b003:l028","ordinal":150185,"en":"When the coolness fell,"},{"id":"semetey-1-2013:p0958:b003:l029","ordinal":150186,"en":"She saw another wonder:"},{"id":"semetey-1-2013:p0958:b003:l030","ordinal":150187,"en":"From below Tort-Kul,"},{"id":"semetey-1-2013:p0958:b003:l031","ordinal":150188,"en":"From the orchard planted by Lord Manas,"},{"id":"semetey-1-2013:p0958:b003:l032","ordinal":150189,"en":"From Kanykei's palace,"},{"id":"semetey-1-2013:p0958:b003:l033","ordinal":150190,"en":"From Chachykei's enclosure,"},{"id":"semetey-1-2013:p0958:b003:l034","ordinal":150191,"en":"With a marten-fur cap upon his head,"},{"id":"semetey-1-2013:p0958:b003:l035","ordinal":150192,"en":"Out for a stroll had come"},{"id":"semetey-1-2013:p0958:b003:l036","ordinal":150193,"en":"Manas's son Semetey."},{"id":"semetey-1-2013:p0958:b003:l037","ordinal":150194,"en":"A warrior of impetuous spirit,"},{"id":"semetey-1-2013:p0958:b003:l038","ordinal":150195,"en":"Beyond Manas, gone to the other world,"},{"id":"semetey-1-2013:p0958:b003:l039","ordinal":150196,"en":"That lion had been born far greater."},{"id":"semetey-1-2013:p0958:b004:l001","ordinal":150197,"en":"She studied him in wonder:"},{"id":"semetey-1-2013:p0958:b004:l002","ordinal":150198,"en":"“This is my beloved,” she said,"},{"id":"semetey-1-2013:p0958:b004:l003","ordinal":150199,"en":"And Aichurok stood watching."},{"id":"semetey-1-2013:p0958:b004:l004","ordinal":150200,"en":"He rode horses hard and ranged the land,"},{"id":"semetey-1-2013:p0958:b004:l005","ordinal":150201,"en":"Loosed hounds and flew hunting birds."},{"id":"semetey-1-2013:p0958:b004:l006","ordinal":150202,"en":"His protector was Kojosan;"},{"id":"semetey-1-2013:p0958:b004:l007","ordinal":150203,"en":"Those he had pledged himself to were the forty chilten."},{"id":"semetey-1-2013:p0958:b004:l008","ordinal":150204,"en":"One of those forty chilten,"},{"id":"semetey-1-2013:p0958:b004:l009","ordinal":150205,"en":"A black-spotted leopard,"},{"id":"semetey-1-2013:p0958:b004:l010","ordinal":150206,"en":"Bounded at his side,"},{"id":"semetey-1-2013:p0958:b004:l011","ordinal":150207,"en":"With the presence of a thousand men;"},{"id":"semetey-1-2013:p0958:b004:l012","ordinal":150208,"en":"Thus it protected him."},{"id":"semetey-1-2013:p0958:b004:l013","ordinal":150209,"en":"Looking to his right,"},{"id":"semetey-1-2013:p0958:b004:l014","ordinal":150210,"en":"A bobtailed, wolf-maned lion"},{"id":"semetey-1-2013:p0958:b004:l015","ordinal":150211,"en":"Bounded close beside him,"},{"id":"semetey-1-2013:p0958:b004:l016","ordinal":150212,"en":"Thus protecting him."},{"id":"semetey-1-2013:p0958:b004:l017","ordinal":150213,"en":"A dragon, a white serpent,"},{"id":"semetey-1-2013:p0958:b004:l018","ordinal":150214,"en":"Opened its mouth and hissed,"},{"id":"semetey-1-2013:p0958:b004:l019","ordinal":150215,"en":"As though drawing breath to swallow,"},{"id":"semetey-1-2013:p0958:b004:l020","ordinal":150216,"en":"With the appearance of an immense host,"},{"id":"semetey-1-2013:p0958:b004:l021","ordinal":150217,"en":"It crawled behind him."},{"id":"semetey-1-2013:p0958:b004:l022","ordinal":150218,"en":"The giant black bird Zumuruk,"},{"id":"semetey-1-2013:p0958:b004:l023","ordinal":150219,"en":"Poised to snatch at any moment,"},{"id":"semetey-1-2013:p0958:b004:l024","ordinal":150220,"en":"Spread its legs and loomed"},{"id":"semetey-1-2013:p0958:b004:l025","ordinal":150221,"en":"Above him as he went."},{"id":"semetey-1-2013:p0958:b004:l026","ordinal":150222,"en":"Wondrously beautiful, with narrow eyes,"},{"id":"semetey-1-2013:p0958:b004:l027","ordinal":150223,"en":"Took hold of the bridle and bit."},{"id":"semetey-1-2013:p0958:b004:l028","ordinal":150224,"en":"Someone accompanied him."},{"id":"semetey-1-2013:p0958:b004:l029","ordinal":150225,"en":"Seen from the front,"},{"id":"semetey-1-2013:p0958:b004:l030","ordinal":150226,"en":"He had the awe of six thousand warriors;"},{"id":"semetey-1-2013:p0958:b004:l031","ordinal":150227,"en":"Seen from behind,"},{"id":"semetey-1-2013:p0958:b004:l032","ordinal":150228,"en":"He had the appearance of a dragon."},{"id":"semetey-1-2013:p0958:b004:l033","ordinal":150229,"en":"His face was like oiled wheat,"},{"id":"semetey-1-2013:p0958:b004:l034","ordinal":150230,"en":"His eyes like mist at dusk;"},{"id":"semetey-1-2013:p0958:b004:l035","ordinal":150231,"en":"His right shoulder was broad."},{"id":"semetey-1-2013:p0958:b004:l036","ordinal":150232,"en":"Whenever his fury seized him,"},{"id":"semetey-1-2013:p0958:b004:l037","ordinal":150233,"en":"The eighteen thousand worlds"},{"id":"semetey-1-2013:p0958:b004:l038","ordinal":150234,"en":"He was a warrior who could lay waste."},{"id":"semetey-1-2013:p0958:b004:l039","ordinal":150235,"en":"His brow was high, his wrath was fierce,"},{"id":"semetey-1-2013:p0959:b003:l001","ordinal":150236,"en":"He lays flat whoever attacks him."},{"id":"semetey-1-2013:p0959:b003:l002","ordinal":150237,"en":"Konurbay, khan of Beijing,"},{"id":"semetey-1-2013:p0959:b003:l003","ordinal":150238,"en":"Would flee without facing him;"},{"id":"semetey-1-2013:p0959:b003:l004","ordinal":150239,"en":"If he faced Manas's heroic son,"},{"id":"semetey-1-2013:p0959:b003:l005","ordinal":150240,"en":"He would fall dead."},{"id":"semetey-1-2013:p0959:b003:l006","ordinal":150241,"en":"If Toltoy and Kojo"},{"id":"semetey-1-2013:p0959:b003:l007","ordinal":150242,"en":"Charged in with spears and cries,"},{"id":"semetey-1-2013:p0959:b003:l008","ordinal":150243,"en":"He would throw them into turmoil."},{"id":"semetey-1-2013:p0959:b003:l009","ordinal":150244,"en":"Broad-chested and wide-breasted,"},{"id":"semetey-1-2013:p0959:b003:l010","ordinal":150245,"en":"He was a majestic lion;"},{"id":"semetey-1-2013:p0959:b003:l011","ordinal":150246,"en":"Among the giants upon the earth,"},{"id":"semetey-1-2013:p0959:b003:l012","ordinal":150247,"en":"He was a warrior fit to stand alone."},{"id":"semetey-1-2013:p0959:b003:l013","ordinal":150248,"en":"Never turning back before death,"},{"id":"semetey-1-2013:p0959:b003:l014","ordinal":150249,"en":"This gray wolf, let alone Toltoy,"},{"id":"semetey-1-2013:p0959:b003:l015","ordinal":150250,"en":"Would not retreat even from hell."},{"id":"semetey-1-2013:p0959:b003:l016","ordinal":150251,"en":"No one could come against him;"},{"id":"semetey-1-2013:p0959:b003:l017","ordinal":150252,"en":"Whoever faced him would die."},{"id":"semetey-1-2013:p0959:b003:l018","ordinal":150253,"en":"Tall and broad-shouldered,"},{"id":"semetey-1-2013:p0959:b003:l019","ordinal":150254,"en":"Both champion and lion,"},{"id":"semetey-1-2013:p0959:b003:l020","ordinal":150255,"en":"She had found the man destined for her"},{"id":"semetey-1-2013:p0959:b003:l021","ordinal":150256,"en":"And stood there amazed."},{"id":"semetey-1-2013:p0959:b003:l022","ordinal":150257,"en":"He was an exceptionally born lion,"},{"id":"semetey-1-2013:p0959:b003:l023","ordinal":150258,"en":"Tiger-hearted and thick-necked;"},{"id":"semetey-1-2013:p0959:b003:l024","ordinal":150259,"en":"Fortunate Semetey"},{"id":"semetey-1-2013:p0959:b003:l025","ordinal":150260,"en":"Was a red fortress of iron"},{"id":"semetey-1-2013:p0959:b003:l026","ordinal":150261,"en":"Established for these Kyrgyz."},{"id":"semetey-1-2013:p0959:b003:l027","ordinal":150262,"en":"Standing proud and taking none as his equal,"},{"id":"semetey-1-2013:p0959:b003:l028","ordinal":150263,"en":"Refusing to count any man his peer—"},{"id":"semetey-1-2013:p0959:b003:l029","ordinal":150264,"en":"Such conduct suited the gray wolf."},{"id":"semetey-1-2013:p0959:b003:l030","ordinal":150265,"en":"That she had sought so long without finding him"},{"id":"semetey-1-2013:p0959:b003:l031","ordinal":150266,"en":"Was a God-stricken affair."},{"id":"semetey-1-2013:p0959:b003:l032","ordinal":150267,"en":"Could there be a man who would not join"},{"id":"semetey-1-2013:p0959:b003:l033","ordinal":150268,"en":"In true amusement and delight,"},{"id":"semetey-1-2013:p0959:b003:l034","ordinal":150269,"en":"Who would not lie playfully pinching"},{"id":"semetey-1-2013:p0959:b003:l035","ordinal":150270,"en":"And teasing the gray wolf?”"},{"id":"semetey-1-2013:p0959:b003:l036","ordinal":150271,"en":"Aychürök rejoiced greatly;"},{"id":"semetey-1-2013:p0959:b003:l037","ordinal":150272,"en":"Sitting and looking sidelong,"}]
