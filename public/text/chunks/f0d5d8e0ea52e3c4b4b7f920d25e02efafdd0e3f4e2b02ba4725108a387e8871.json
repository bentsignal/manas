[{"id":"semetey-1-2013:p0691:b003:l004","ordinal":129793,"en":"It was God's doing."},{"id":"semetey-1-2013:p0691:b003:l005","ordinal":129794,"en":"Wishing to embrace him and sin,"},{"id":"semetey-1-2013:p0691:b003:l006","ordinal":129795,"en":"Wishing to play in his embrace,"},{"id":"semetey-1-2013:p0691:b003:l007","ordinal":129796,"en":"When my eyes closed in sleep,"},{"id":"semetey-1-2013:p0691:b003:l008","ordinal":129797,"en":"I would join him and play."},{"id":"semetey-1-2013:p0691:b003:l009","ordinal":129798,"en":"When I woke, no such mortal was there;"},{"id":"semetey-1-2013:p0691:b003:l010","ordinal":129799,"en":"Then I would wail and burn with anguish."},{"id":"semetey-1-2013:p0691:b003:l011","ordinal":129800,"en":"For the lover I saw in my dream,"},{"id":"semetey-1-2013:p0691:b003:l012","ordinal":129801,"en":"Wishing I might see him awake,"},{"id":"semetey-1-2013:p0691:b003:l013","ordinal":129802,"en":"I was filled with longing."},{"id":"semetey-1-2013:p0691:b003:l014","ordinal":129803,"en":"For the boy called Almambet,"},{"id":"semetey-1-2013:p0691:b003:l015","ordinal":129804,"en":"To see him once while awake,"},{"id":"semetey-1-2013:p0691:b003:l016","ordinal":129805,"en":"And then to die—"},{"id":"semetey-1-2013:p0691:b003:l017","ordinal":129806,"en":"That was my prayer."},{"id":"semetey-1-2013:p0691:b003:l018","ordinal":129807,"en":"As I longed for Almambet,"},{"id":"semetey-1-2013:p0691:b003:l019","ordinal":129808,"en":"I learned from those who knew,"},{"id":"semetey-1-2013:p0691:b003:l020","ordinal":129809,"en":"Giving out gold by the pood,"},{"id":"semetey-1-2013:p0691:b003:l021","ordinal":129810,"en":"I questioned those who knew."},{"id":"semetey-1-2013:p0691:b003:l022","ordinal":129811,"en":"Guarding the palace,"},{"id":"semetey-1-2013:p0691:b003:l023","ordinal":129812,"en":"My father the khan's champion called Lungkodu"},{"id":"semetey-1-2013:p0691:b003:l025","ordinal":129813,"en":"Told me the truth:"},{"id":"semetey-1-2013:p0691:b003:l026","ordinal":129814,"en":"“In the city of Tash-Kopuro,"},{"id":"semetey-1-2013:p0691:b003:l027","ordinal":129815,"en":"His father is a lesser khan."},{"id":"semetey-1-2013:p0691:b003:l028","ordinal":129816,"en":"Having studied sorcery,"},{"id":"semetey-1-2013:p0691:b003:l029","ordinal":129817,"en":"He startles the eyes of those who see him."},{"id":"semetey-1-2013:p0691:b003:l030","ordinal":129818,"en":"He has reached twelve years of age,"},{"id":"semetey-1-2013:p0691:b003:l031","ordinal":129819,"en":"Rides the horse Aysarala,"},{"id":"semetey-1-2013:p0691:b003:l032","ordinal":129820,"en":"And is a son called Almambet."},{"id":"semetey-1-2013:p0691:b003:l033","ordinal":129821,"en":"When you look at Almambet,"},{"id":"semetey-1-2013:p0691:b003:l034","ordinal":129822,"en":"He shines as though moonlight fell upon him—"},{"id":"semetey-1-2013:p0691:b003:l035","ordinal":129823,"en":"Such a boy is Almambet."},{"id":"semetey-1-2013:p0691:b003:l036","ordinal":129824,"en":"There is no boy so handsome;"},{"id":"semetey-1-2013:p0691:b003:l037","ordinal":129825,"en":"There is no way to capture him."},{"id":"semetey-1-2013:p0691:b003:l038","ordinal":129826,"en":"In China, the land of forty khans,"},{"id":"semetey-1-2013:p0691:b003:l039","ordinal":129827,"en":"There is no boy so wonderful."},{"id":"semetey-1-2013:p0691:b005:l001","ordinal":129828,"en":"Yesterday, when he toppled the official's banner,"},{"id":"semetey-1-2013:p0691:b005:l003","ordinal":129829,"en":"Sarala with his stake-like neck,"},{"id":"semetey-1-2013:p0691:b005:l004","ordinal":129830,"en":"When I was making it bow,"},{"id":"semetey-1-2013:p0691:b005:l005","ordinal":129831,"en":"I saw him here and burned with longing."},{"id":"semetey-1-2013:p0691:b005:l006","ordinal":129832,"en":"Yesterday, Sarala with his cow-like haunches,"},{"id":"semetey-1-2013:p0691:b005:l007","ordinal":129833,"en":"When he sent him surging along,"},{"id":"semetey-1-2013:p0691:b005:l008","ordinal":129834,"en":"When he pursued Kongurbay,"},{"id":"semetey-1-2013:p0691:b005:l009","ordinal":129835,"en":"I saw him here and burned with longing."},{"id":"semetey-1-2013:p0691:b005:l010","ordinal":129836,"en":"Yesterday, matted-tailed Sarala,"},{"id":"semetey-1-2013:p0691:b005:l011","ordinal":129837,"en":"When he sent him racing,"},{"id":"semetey-1-2013:p0691:b005:l012","ordinal":129838,"en":"Of the great lord Kongurbay,"},{"id":"semetey-1-2013:p0691:b005:l013","ordinal":129839,"en":"When he chased his sentry,"},{"id":"semetey-1-2013:p0691:b005:l014","ordinal":129840,"en":"I saw the truth for myself;"},{"id":"semetey-1-2013:p0691:b005:l015","ordinal":129841,"en":"I was filled with longing.”"},{"id":"semetey-1-2013:p0691:b005:l016","ordinal":129842,"en":"As the champion spoke,"},{"id":"semetey-1-2013:p0691:b005:l017","ordinal":129843,"en":"“That is the one I saw in my dream,” I said,"},{"id":"semetey-1-2013:p0691:b005:l018","ordinal":129844,"en":"My heart melting with affection,"},{"id":"semetey-1-2013:p0691:b005:l019","ordinal":129845,"en":"My flesh and nails are stretched apart."},{"id":"semetey-1-2013:p0691:b005:l020","ordinal":129846,"en":"My thoughts drawn away,"},{"id":"semetey-1-2013:p0691:b005:l021","ordinal":129847,"en":"Tears spilling from my eyes."},{"id":"semetey-1-2013:p0691:b005:l022","ordinal":129848,"en":"That day, my wretched soul"},{"id":"semetey-1-2013:p0691:b005:l023","ordinal":129849,"en":"Ached and throbbed with burning pain."},{"id":"semetey-1-2013:p0691:b005:l024","ordinal":129850,"en":"For the one I saw in my dream,"},{"id":"semetey-1-2013:p0691:b005:l025","ordinal":129851,"en":"To see him awake as I wished,"},{"id":"semetey-1-2013:p0691:b005:l026","ordinal":129852,"en":"And then to die—"},{"id":"semetey-1-2013:p0691:b005:l027","ordinal":129853,"en":"That was what I asked of God."},{"id":"semetey-1-2013:p0691:b005:l028","ordinal":129854,"en":"Pouring out gold by the pood,"},{"id":"semetey-1-2013:p0691:b005:l029","ordinal":129855,"en":"Wretched me, I scattered so much of my wealth."},{"id":"semetey-1-2013:p0691:b005:l030","ordinal":129856,"en":"Hoping to see him in the end,"},{"id":"semetey-1-2013:p0691:b005:l031","ordinal":129857,"en":"I spent so much of my strength."},{"id":"semetey-1-2013:p0691:b005:l032","ordinal":129858,"en":"I burned, wondering if I would see him,"},{"id":"semetey-1-2013:p0691:b005:l033","ordinal":129859,"en":"And kept asking more and more."},{"id":"semetey-1-2013:p0691:b005:l034","ordinal":129860,"en":"My heart melted with affection;"},{"id":"semetey-1-2013:p0691:b005:l035","ordinal":129861,"en":"My heart of flesh stretched with longing."},{"id":"semetey-1-2013:p0691:b005:l036","ordinal":129862,"en":"The person I had seen in my dream—"},{"id":"semetey-1-2013:p0691:b005:l037","ordinal":129863,"en":"To see him awake and die,"},{"id":"semetey-1-2013:p0691:b005:l038","ordinal":129864,"en":"I wandered, sick with longing,"},{"id":"semetey-1-2013:p0691:b005:l039","ordinal":129865,"en":"Wishing to see Almambet,"},{"id":"semetey-1-2013:p0692:b003:l001","ordinal":129866,"en":"He stared, dumbfounded with astonishment."},{"id":"semetey-1-2013:p0692:b003:l002","ordinal":129867,"en":"Whether I sat or rose, it was in my thoughts;"},{"id":"semetey-1-2013:p0692:b003:l003","ordinal":129868,"en":"I marveled at what a thing this was."},{"id":"semetey-1-2013:p0692:b003:l004","ordinal":129869,"en":"As I looked in wonder,"},{"id":"semetey-1-2013:p0692:b003:l005","ordinal":129870,"en":"I heard news of the turmoil."},{"id":"semetey-1-2013:p0692:b003:l006","ordinal":129871,"en":"That day I saw this world's"},{"id":"semetey-1-2013:p0692:b003:l007","ordinal":129872,"en":"Disorder that would never heal."},{"id":"semetey-1-2013:p0692:b003:l008","ordinal":129873,"en":"Of my Almam, whom I saw in my dream,"},{"id":"semetey-1-2013:p0692:b003:l009","ordinal":129874,"en":"Now I saw the wonder while awake."},{"id":"semetey-1-2013:p0692:b003:l010","ordinal":129875,"en":"When noon had passed,"},{"id":"semetey-1-2013:p0692:b003:l011","ordinal":129876,"en":"When the afternoon hour arrived,"},{"id":"semetey-1-2013:p0692:b003:l012","ordinal":129877,"en":"Gray-mottled pennants, red banners,"},{"id":"semetey-1-2013:p0692:b003:l013","ordinal":129878,"en":"A great uproar all along the way,"},{"id":"semetey-1-2013:p0692:b003:l014","ordinal":129879,"en":"A white-mottled field, red banners,"},{"id":"semetey-1-2013:p0692:b003:l015","ordinal":129880,"en":"Piercing cries and tumult,"},{"id":"semetey-1-2013:p0692:b003:l016","ordinal":129881,"en":"Drums booming,"},{"id":"semetey-1-2013:p0692:b003:l017","ordinal":129882,"en":"Great guns cracking,"},{"id":"semetey-1-2013:p0692:b003:l018","ordinal":129883,"en":"Bows rattling,"},{"id":"semetey-1-2013:p0692:b003:l019","ordinal":129884,"en":"Great guns clattering,"},{"id":"semetey-1-2013:p0692:b003:l020","ordinal":129885,"en":"The golden-doored gateway"},{"id":"semetey-1-2013:p0692:b003:l021","ordinal":129886,"en":"Of my father Esen Khan's palace—"},{"id":"semetey-1-2013:p0692:b003:l022","ordinal":129887,"en":"With six strong mules"},{"id":"semetey-1-2013:p0692:b003:l023","ordinal":129888,"en":"They pulled its gates,"},{"id":"semetey-1-2013:p0692:b003:l024","ordinal":129889,"en":"And sixty champion guards"},{"id":"semetey-1-2013:p0692:b003:l025","ordinal":129890,"en":"Had them opened swiftly."},{"id":"semetey-1-2013:p0692:b003:l026","ordinal":129891,"en":"When they opened them and looked,"},{"id":"semetey-1-2013:p0692:b003:l027","ordinal":129892,"en":"Sixty governors, forty officials,"},{"id":"semetey-1-2013:p0692:b003:l028","ordinal":129893,"en":"Their elder,"},{"id":"semetey-1-2013:p0692:b003:l029","ordinal":129894,"en":"With a cotton sash and broad boots,"},{"id":"semetey-1-2013:p0692:b003:l030","ordinal":129895,"en":"Was Kongurbay, khan of the Kalmyks."},{"id":"semetey-1-2013:p0692:b003:l031","ordinal":129896,"en":"If you ask about Kongurbay,"},{"id":"semetey-1-2013:p0692:b003:l032","ordinal":129897,"en":"As for these Chinese,"},{"id":"semetey-1-2013:p0692:b003:l033","ordinal":129898,"en":"That's the roof you put on the roof"},{"id":"semetey-1-2013:p0692:b003:l034","ordinal":129899,"en":"He was the mighty khan of the Kalmyks."},{"id":"semetey-1-2013:p0692:b003:l035","ordinal":129900,"en":"Of those Chinese called Kalmyks,"},{"id":"semetey-1-2013:p0692:b003:l036","ordinal":129901,"en":"It's a stone"},{"id":"semetey-1-2013:p0692:b003:l037","ordinal":129902,"en":"Of the Chinese and Kalmyks,"},{"id":"semetey-1-2013:p0692:b003:l038","ordinal":129903,"en":"He was the formidable, mighty lord."},{"id":"semetey-1-2013:p0692:b003:l039","ordinal":129904,"en":"Know his greatness from this:"},{"id":"semetey-1-2013:p0692:b004:l001","ordinal":129905,"en":"He settled wherever the land was best,"},{"id":"semetey-1-2013:p0692:b004:l002","ordinal":129906,"en":"And answered to no one."},{"id":"semetey-1-2013:p0692:b004:l003","ordinal":129907,"en":"His ox grew old and he himself died;"},{"id":"semetey-1-2013:p0692:b004:l004","ordinal":129908,"en":"They divided the dead man's livestock equally."},{"id":"semetey-1-2013:p0692:b004:l005","ordinal":129909,"en":"He consecrated his goat as sacred;"},{"id":"semetey-1-2013:p0692:b004:l006","ordinal":129910,"en":"That was this unbeliever's custom."},{"id":"semetey-1-2013:p0692:b004:l007","ordinal":129911,"en":"He never wore underdrawers,"},{"id":"semetey-1-2013:p0692:b004:l008","ordinal":129912,"en":"Nor sat down to urinate on the ground."},{"id":"semetey-1-2013:p0692:b004:l009","ordinal":129913,"en":"Such was that unbeliever's way:"},{"id":"semetey-1-2013:p0692:b004:l010","ordinal":129914,"en":"He did not consort with women."},{"id":"semetey-1-2013:p0692:b004:l011","ordinal":129915,"en":"The horse he rode was untamed;"},{"id":"semetey-1-2013:p0692:b004:l012","ordinal":129916,"en":"If he saw a woman, he kept apart."},{"id":"semetey-1-2013:p0692:b004:l013","ordinal":129917,"en":"He caught and saddled his unruly horse."},{"id":"semetey-1-2013:p0692:b004:l014","ordinal":129918,"en":"Before a great idol the size of a house,"},{"id":"semetey-1-2013:p0692:b004:l015","ordinal":129919,"en":"Saying, “This is God,”"},{"id":"semetey-1-2013:p0692:b004:l016","ordinal":129920,"en":"He worshiped from morning until night."},{"id":"semetey-1-2013:p0692:b004:l017","ordinal":129921,"en":"Among the Chinese in Beijing,"},{"id":"semetey-1-2013:p0692:b004:l018","ordinal":129922,"en":"There arose a khan called Alooko."},{"id":"semetey-1-2013:p0692:b004:l019","ordinal":129923,"en":"Kongurbay, son of Alooko—"},{"id":"semetey-1-2013:p0692:b004:l020","ordinal":129924,"en":"The thunder of his approach took lives."},{"id":"semetey-1-2013:p0692:b004:l021","ordinal":129925,"en":"That khan of Beijing, Kongurbay,"},{"id":"semetey-1-2013:p0692:b004:l022","ordinal":129926,"en":"Was a mighty khan on watch,"},{"id":"semetey-1-2013:p0692:b004:l023","ordinal":129927,"en":"A resolute and powerful man."},{"id":"semetey-1-2013:p0692:b004:l024","ordinal":129928,"en":"Sixty Chinese and countless officials,"},{"id":"semetey-1-2013:p0692:b004:l025","ordinal":129929,"en":"With Kongurbay their elder,"},{"id":"semetey-1-2013:p0692:b004:l026","ordinal":129930,"en":"Fled together in a clattering rush."},{"id":"semetey-1-2013:p0692:b004:l027","ordinal":129931,"en":"Before Esen Khan"},{"id":"semetey-1-2013:p0692:b004:l028","ordinal":129932,"en":"He came in lamenting, to make his complaint."},{"id":"semetey-1-2013:p0692:b004:l029","ordinal":129933,"en":"When I looked at Kongurbay,"},{"id":"semetey-1-2013:p0692:b004:l030","ordinal":129934,"en":"He was a swirling mass of dust;"},{"id":"semetey-1-2013:p0692:b004:l031","ordinal":129935,"en":"Steam barrel is blood,"},{"id":"semetey-1-2013:p0692:b004:l032","ordinal":129936,"en":"Kongurbay up above"},{"id":"semetey-1-2013:p0692:b004:l033","ordinal":129937,"en":"Was deeply troubled in spirit;"},{"id":"semetey-1-2013:p0692:b004:l034","ordinal":129938,"en":"Algara beneath him"},{"id":"semetey-1-2013:p0692:b004:l035","ordinal":129939,"en":"Looked gray with dust."},{"id":"semetey-1-2013:p0692:b004:l036","ordinal":129940,"en":"Kongurbay up above"},{"id":"semetey-1-2013:p0692:b004:l037","ordinal":129941,"en":"Was bathed in pitch-black blood;"},{"id":"semetey-1-2013:p0692:b004:l038","ordinal":129942,"en":"Algara beneath him"},{"id":"semetey-1-2013:p0692:b004:l039","ordinal":129943,"en":"Was bathed in scarlet blood."},{"id":"semetey-1-2013:p0693:b003:l001","ordinal":129944,"en":"Then Kongurbay spoke a word,"},{"id":"semetey-1-2013:p0693:b003:l002","ordinal":129945,"en":"Lodging foul words in my thoughts."},{"id":"semetey-1-2013:p0693:b003:l003","ordinal":129946,"en":"Before my father Esen Khan,"},{"id":"semetey-1-2013:p0693:b003:l004","ordinal":129947,"en":"He turned Algara's head."},{"id":"semetey-1-2013:p0693:b003:l005","ordinal":129948,"en":"Shouting his shitty words without restraint,"},{"id":"semetey-1-2013:p0693:b003:l006","ordinal":129949,"en":"Before my father the khan,"},{"id":"semetey-1-2013:p0693:b003:l007","ordinal":129950,"en":"He cursed in Kalmyk:"},{"id":"semetey-1-2013:p0693:b003:l008","ordinal":129951,"en":"“My soul is burning, Esen Khan!"},{"id":"semetey-1-2013:p0693:b003:l009","ordinal":129952,"en":"I met with trouble on the watch."},{"id":"semetey-1-2013:p0693:b003:l010","ordinal":129953,"en":"Azyz Khan's bastard fool,"},{"id":"semetey-1-2013:p0693:b003:l011","ordinal":129954,"en":"His son who resembles a Kyrgyz—"},{"id":"semetey-1-2013:p0693:b003:l012","ordinal":129955,"en":"From him I saw this spectacle."},{"id":"semetey-1-2013:p0693:b003:l013","ordinal":129956,"en":"Ever since I became Kongurbay,"},{"id":"semetey-1-2013:p0693:b003:l014","ordinal":129957,"en":"Ever since I bore the name Kongurbay,"},{"id":"semetey-1-2013:p0693:b003:l015","ordinal":129958,"en":"The black Chinese and Manchus—"},{"id":"semetey-1-2013:p0693:b003:l016","ordinal":129959,"en":"As khan, I drained their people;"},{"id":"semetey-1-2013:p0693:b003:l017","ordinal":129960,"en":"I went out and camped on watch."},{"id":"semetey-1-2013:p0693:b003:l018","ordinal":129961,"en":"The black Chinese and Manchus,"},{"id":"semetey-1-2013:p0693:b003:l019","ordinal":129962,"en":"Even if all their people gathered,"},{"id":"semetey-1-2013:p0693:b003:l020","ordinal":129963,"en":"No one brought me trouble."},{"id":"semetey-1-2013:p0693:b003:l021","ordinal":129964,"en":"Let their forty tribes gather:"},{"id":"semetey-1-2013:p0693:b003:l022","ordinal":129965,"en":"No one remained who could stand against me."},{"id":"semetey-1-2013:p0693:b003:l023","ordinal":129966,"en":"When I moved, dust rose from the ground;"},{"id":"semetey-1-2013:p0693:b003:l024","ordinal":129967,"en":"My wrath took lives."},{"id":"semetey-1-2013:p0693:b003:l025","ordinal":129968,"en":"Today I met with trouble—"},{"id":"semetey-1-2013:p0693:b003:l026","ordinal":129969,"en":"Among mortals I have seen none like him."},{"id":"semetey-1-2013:p0693:b003:l027","ordinal":129970,"en":"A spectacle no man would cause."},{"id":"semetey-1-2013:p0693:b003:l028","ordinal":129971,"en":"From the place where I stood watch,"},{"id":"semetey-1-2013:p0693:b003:l029","ordinal":129972,"en":"At the edge of Kan-Jailak,"},{"id":"semetey-1-2013:p0693:b003:l030","ordinal":129973,"en":"From the bare ground for tethering horses,"},{"id":"semetey-1-2013:p0693:b003:l031","ordinal":129974,"en":"Azyz Khan's bastard pig,"},{"id":"semetey-1-2013:p0693:b003:l032","ordinal":129975,"en":"The unbeliever called Almambet—"},{"id":"semetey-1-2013:p0693:b003:l033","ordinal":129976,"en":"From him I suffered humiliation."},{"id":"semetey-1-2013:p0693:b003:l034","ordinal":129977,"en":"I came back alive, without dying."},{"id":"semetey-1-2013:p0693:b003:l035","ordinal":129978,"en":"The torments of Judgment Day—"},{"id":"semetey-1-2013:p0693:b003:l036","ordinal":129979,"en":"Without seeing them, I came back alive."},{"id":"semetey-1-2013:p0693:b003:l037","ordinal":129980,"en":"From that damned pig"},{"id":"semetey-1-2013:p0693:b003:l038","ordinal":129981,"en":"I came back alive, without dying."},{"id":"semetey-1-2013:p0693:b003:l039","ordinal":129982,"en":"The unbeliever has reached twelve years of age."},{"id":"semetey-1-2013:p0693:b004:l001","ordinal":129983,"en":"At fifteen, he will bring us to no good;"},{"id":"semetey-1-2013:p0693:b004:l002","ordinal":129984,"en":"He will leave none of us unharmed."},{"id":"semetey-1-2013:p0693:b004:l003","ordinal":129985,"en":"He will not let us turn a plow;"},{"id":"semetey-1-2013:p0693:b004:l004","ordinal":129986,"en":"He will not let us remain in Beijing."},{"id":"semetey-1-2013:p0693:b004:l005","ordinal":129987,"en":"Listen carefully to my words."},{"id":"semetey-1-2013:p0693:b004:l006","ordinal":129988,"en":"When he reaches sixteen,"},{"id":"semetey-1-2013:p0693:b004:l007","ordinal":129989,"en":"He will not let us ride a maned mare,"},{"id":"semetey-1-2013:p0693:b004:l008","ordinal":129990,"en":"Nor let us eat a fat-tailed lamb."},{"id":"semetey-1-2013:p0693:b004:l009","ordinal":129991,"en":"He will not let us keep proper watch;"},{"id":"semetey-1-2013:p0693:b004:l010","ordinal":129992,"en":"From China's people under forty khans,"},{"id":"semetey-1-2013:p0693:b004:l011","ordinal":129993,"en":"He will not let us collect a scrap of tax."},{"id":"semetey-1-2013:p0693:b004:l012","ordinal":129994,"en":"If you live, you will see:"},{"id":"semetey-1-2013:p0693:b004:l013","ordinal":129995,"en":"We will see many a spectacle;"},{"id":"semetey-1-2013:p0693:b004:l014","ordinal":129996,"en":"If we resist, we will die."},{"id":"semetey-1-2013:p0693:b004:l015","ordinal":129997,"en":"If that fool lives,"},{"id":"semetey-1-2013:p0693:b004:l016","ordinal":129998,"en":"We will suffer sore humiliation from him."},{"id":"semetey-1-2013:p0693:b004:l017","ordinal":129999,"en":"Cut down the riverside willow:"},{"id":"semetey-1-2013:p0693:b004:l018","ordinal":130000,"en":"It is spreading in flames."},{"id":"semetey-1-2013:p0693:b004:l019","ordinal":130001,"en":"My khan, restrain Almambet!"},{"id":"semetey-1-2013:p0693:b004:l020","ordinal":130002,"en":"If you do not restrain Almambet,"},{"id":"semetey-1-2013:p0693:b004:l021","ordinal":130003,"en":"If you do not find his roots and cut them,"},{"id":"semetey-1-2013:p0693:b004:l022","ordinal":130004,"en":"Either let him stay in Beijing,"},{"id":"semetey-1-2013:p0693:b004:l023","ordinal":130005,"en":"Or let me stay in Beijing.”"},{"id":"semetey-1-2013:p0693:b004:l024","ordinal":130006,"en":"So saying, Kongurbay"},{"id":"semetey-1-2013:p0693:b004:l025","ordinal":130007,"en":"Spoke to my father,"},{"id":"semetey-1-2013:p0693:b004:l026","ordinal":130008,"en":"And lodged foul words in my heart."},{"id":"semetey-1-2013:p0693:b004:l027","ordinal":130009,"en":"I stood listening to him,"},{"id":"semetey-1-2013:p0693:b004:l028","ordinal":130010,"en":"While he went on speaking."},{"id":"semetey-1-2013:p0693:b004:l029","ordinal":130011,"en":"“Agree to what I say,” he said,"},{"id":"semetey-1-2013:p0693:b004:l030","ordinal":130012,"en":"“Give me Kan-Zhaylak,” he said."},{"id":"semetey-1-2013:p0693:b004:l031","ordinal":130013,"en":"Before a word could be spoken,"},{"id":"semetey-1-2013:p0693:b004:l032","ordinal":130014,"en":"Before an eye could open and close,"},{"id":"semetey-1-2013:p0693:b004:l033","ordinal":130015,"en":"He struck Sarala once on the thigh,"},{"id":"semetey-1-2013:p0693:b004:l034","ordinal":130016,"en":"Into the countless Chinese"},{"id":"semetey-1-2013:p0693:b004:l035","ordinal":130017,"en":"He plunged and attacked."},{"id":"semetey-1-2013:p0693:b004:l036","ordinal":130018,"en":"He who would bow to no one in the world,"},{"id":"semetey-1-2013:p0693:b004:l037","ordinal":130019,"en":"The wretch who fancied himself a hero—"},{"id":"semetey-1-2013:p0693:b004:l038","ordinal":130020,"en":"The spear that struck so violently"},{"id":"semetey-1-2013:p0693:b004:l039","ordinal":130021,"en":"I could find no way to deal with the wretch."},{"id":"semetey-1-2013:p0694:b003:l001","ordinal":130022,"en":"When the practiced swine struck,"},{"id":"semetey-1-2013:p0694:b003:l002","ordinal":130023,"en":"My eyes rolled wildly,"},{"id":"semetey-1-2013:p0694:b003:l003","ordinal":130024,"en":"My legs dangled."},{"id":"semetey-1-2013:p0694:b003:l004","ordinal":130025,"en":"My strength fled, my power drained,"},{"id":"semetey-1-2013:p0694:b003:l005","ordinal":130026,"en":"Black blood poured from my side."},{"id":"semetey-1-2013:p0694:b003:l006","ordinal":130027,"en":"To spill my blood by the flaskful,"},{"id":"semetey-1-2013:p0694:b003:l007","ordinal":130028,"en":"That fool came close"},{"id":"semetey-1-2013:p0694:b003:l008","ordinal":130029,"en":"To tearing apart my ribs."},{"id":"semetey-1-2013:p0694:b003:l009","ordinal":130030,"en":"Sixty Chinese and countless officials"},{"id":"semetey-1-2013:p0694:b003:l010","ordinal":130031,"en":"Stepped between us,"},{"id":"semetey-1-2013:p0694:b003:l011","ordinal":130032,"en":"And safe and sound"},{"id":"semetey-1-2013:p0694:b003:l012","ordinal":130033,"en":"They pulled me free."},{"id":"semetey-1-2013:p0694:b003:l013","ordinal":130034,"en":"Seven Kalmyks on that road"},{"id":"semetey-1-2013:p0694:b003:l014","ordinal":130035,"en":"Died while helping me."},{"id":"semetey-1-2013:p0694:b003:l015","ordinal":130036,"en":"In the desert of It-Olbos"},{"id":"semetey-1-2013:p0694:b003:l016","ordinal":130037,"en":"He began the havoc."},{"id":"semetey-1-2013:p0694:b003:l017","ordinal":130038,"en":"From atop Alkara,"},{"id":"semetey-1-2013:p0694:b003:l018","ordinal":130039,"en":"He thrust me down six times."},{"id":"semetey-1-2013:p0694:b003:l019","ordinal":130040,"en":"He cut me down and left me.”"},{"id":"semetey-1-2013:p0694:b003:l020","ordinal":130041,"en":"As Kongurbay spoke,"},{"id":"semetey-1-2013:p0694:b003:l021","ordinal":130042,"en":"Hearing the full truth,"},{"id":"semetey-1-2013:p0694:b003:l022","ordinal":130043,"en":"I wept bitterly to the one God:"},{"id":"semetey-1-2013:p0694:b003:l023","ordinal":130044,"en":"“To see his face,” I said,"},{"id":"semetey-1-2013:p0694:b003:l024","ordinal":130045,"en":"“To see him, and then to die,” I said,"},{"id":"semetey-1-2013:p0694:b003:l025","ordinal":130046,"en":"And stood weeping to God."},{"id":"semetey-1-2013:p0694:b003:l026","ordinal":130047,"en":"To see his tiny, living soul,"},{"id":"semetey-1-2013:p0694:b003:l027","ordinal":130048,"en":"To satisfy my true longing,"}]
