{"id": "sayakbay-ms-current146:pdf092:l001", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 92, "folio": 475, "line_in_page": 1, "raw": "Кыжырыма кабылса,", "text": "Кыжырыма кабылса,", "en": "If he incurs my wrath,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf092:l002", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 92, "folio": 475, "line_in_page": 2, "raw": "Кыйратып башын аламын,", "text": "Кыйратып башын аламын,", "en": "I will destroy him and take his head,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf092:l003", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 92, "folio": 475, "line_in_page": 3, "raw": "Чындап жиним кармаса,", "text": "Чындап жиним кармаса,", "en": "If my fury truly seizes me,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf092:l004", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 92, "folio": 475, "line_in_page": 4, "raw": "Айткандарга көнбөсө,", "text": "Айткандарга көнбөсө,", "en": "If he refuses what has been said,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf092:l005", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 92, "folio": 475, "line_in_page": 5, "raw": "Чын багынып баш ийип,", "text": "Чын багынып баш ийип,", "en": "If he does not truly submit and bow his head,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf092:l006", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 92, "folio": 475, "line_in_page": 6, "raw": "Букара болуп келбесе,", "text": "Букара болуп келбесе,", "en": "If he does not come as a subject,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf092:l007", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 92, "folio": 475, "line_in_page": 7, "raw": "Буурсунун бурдурбаймын,", "text": "Буурсунун бурдурбаймын,", "en": "I will not let him turn his plough,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf092:l008", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 92, "folio": 475, "line_in_page": 8, "raw": "Буруп оокат кылдырбаймын,", "text": "Буруп оокат кылдырбаймын,", "en": "I will not let him turn to his livelihood,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf092:l009", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 92, "folio": 475, "line_in_page": 9, "raw": "Жер бетине бастырып,", "text": "Жер бетине бастырып,", "en": "Though he walks upon the face of the earth,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf092:l010", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 92, "folio": 475, "line_in_page": 10, "raw": "Эгин-тегин чачтырып,", "text": "Эгин-тегин чачтырып,", "en": "Though he scatters seed and grain,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf092:l011", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 92, "folio": 475, "line_in_page": 11, "raw": "Эгер оокат кылдырбаймын!", "text": "Эгер оокат кылдырбаймын!", "en": "I will not let him make a living!", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf092:l012", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 92, "folio": 475, "line_in_page": 12, "raw": "Жай тартырып кырдырбаймын,", "text": "Жай тартырып кырдырбаймын,", "en": "I will not let them range freely and reap,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure exact printed counterpart for this line.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf092:l013", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 92, "folio": 475, "line_in_page": 13, "raw": "Элине эгин айдатпаймын,", "text": "Элине эгин айдатпаймын,", "en": "I will not let his people sow grain,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure exact printed counterpart for this line.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf092:l014", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 92, "folio": 475, "line_in_page": 14, "raw": "Элин тоого жайлатпаймын,", "text": "Элин тоого жайлатпаймын,", "en": "I will not let his people summer in the mountains,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure exact printed counterpart for this line.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf092:l015", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 92, "folio": 475, "line_in_page": 15, "raw": "Салмактап жиним кармаса,", "text": "Салмактап жиним кармаса,", "en": "If my weighty fury takes hold,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf092:l016", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 92, "folio": 475, "line_in_page": 16, "raw": "Сан-түмөнүн кырамын,", "text": "Сан-түмөнүн кырамын,", "en": "I will slaughter his countless myriads,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf092:l017", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 92, "folio": 475, "line_in_page": 17, "raw": "Сары оорудай сандалтып,", "text": "Сары оорудай сандалтып,", "en": "I will leave them wandering like victims of yellow sickness,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf092:l018", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 92, "folio": 475, "line_in_page": 18, "raw": "Кетпес кезик кыламын.", "text": "Кетпес кезик кыламын.", "en": "I will give them an affliction that never leaves.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf092:l019", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 92, "folio": 475, "line_in_page": 19, "raw": "Кыр-кырынан ок атып,", "text": "Кыр-кырынан ок атып,", "en": "Shooting from ridge after ridge,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf092:l020", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 92, "folio": 475, "line_in_page": 20, "raw": "Кыйрынын баарын жоготом,", "text": "Кыйрынын баарын жоготом,", "en": "I will erase every last remnant of them,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf092:l021", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 92, "folio": 475, "line_in_page": 21, "raw": "Деген сөзгө көнсүн де.", "text": "Деген сөзгө көнсүн де.", "en": "Tell him to submit to these words.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf092:l022", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 92, "folio": 475, "line_in_page": 22, "raw": "Кенендин кызы Кермекаш,", "text": "Кенендин кызы Кермекаш,", "en": "Kenen’s daughter Kermekash,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure exact printed counterpart for this line.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf092:l023", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 92, "folio": 475, "line_in_page": 23, "raw": "Кермеден сулуу бейбагың,", "text": "Кермеден сулуу бейбагың,", "en": "Your poor beauty, fairer than one behind a screen,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure exact printed counterpart for this line.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf092:l024", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 92, "folio": 475, "line_in_page": 24, "raw": "Бадана тонду кийгизип,", "text": "Бадана тонду кийгизип,", "en": "Dress her in a ring-mail coat,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure exact printed counterpart for this line.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf092:l025", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 92, "folio": 475, "line_in_page": 25, "raw": "Кертулпарга мингизип,", "text": "Кертулпарга мингизип,", "en": "Mount her upon Kertulpar,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure exact printed counterpart for this line.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf092:l026", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 92, "folio": 475, "line_in_page": 26, "raw": "Айдай күлүк артсын де,", "text": "Айдай күлүк артсын де,", "en": "Tell her to ride the moon-swift racer,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure exact printed counterpart for this line.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf092:l027", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 92, "folio": 475, "line_in_page": 27, "raw": "Оюн-жыйын көр болбой,", "text": "Оюн-жыйын көр болбой,", "en": "Without being deprived of games and gatherings,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure exact printed counterpart for this line.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf092:l028", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 92, "folio": 475, "line_in_page": 28, "raw": "Жаңсыз адам жеткизет,", "text": "Жаңсыз адам жеткизет,", "en": "A lifeless man will deliver her,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure exact printed counterpart for this line.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf092:l029", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 92, "folio": 475, "line_in_page": 29, "raw": "Чоюн колун төрт алып,", "text": "Чоюн колун төрт алып,", "en": "Taking four iron hands,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure exact printed counterpart for this line.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf092:l030", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 92, "folio": 475, "line_in_page": 30, "raw": "Чоюп айланып кеткизет,", "text": "Чоюп айланып кеткизет,", "en": "Stretching around, he will carry her away,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure exact printed counterpart for this line.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf092:l031", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 92, "folio": 475, "line_in_page": 31, "raw": "Арбай коюп адам көр болот,", "text": "Арбай коюп адам көр болот,", "en": "A man left sprawling will be a pitiful sight,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure exact printed counterpart for this line.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf092:l032", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 92, "folio": 475, "line_in_page": 32, "raw": "Аксыман миң ок болот,", "text": "Аксыман миң ок болот,", "en": "A thousand arrows will be like white frost,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure exact printed counterpart for this line.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf092:l033", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 92, "folio": 475, "line_in_page": 33, "raw": "Деп айткан сөзгө көнсүн де.", "text": "Деп айткан сөзгө көнсүн де.", "en": "Tell him to submit to the words spoken.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure exact printed counterpart for this line.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf092:l034", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 92, "folio": 475, "line_in_page": 34, "raw": "Чыңтеңир минип турганда,", "text": "Чыңтеңир минип турганда,", "en": "When Chyngteñir mounts and stands ready,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure exact printed counterpart for this line.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf092:l035", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 92, "folio": 475, "line_in_page": 35, "raw": "Ай-ааламдын баарына,", "text": "Ай-ааламдын баарына,", "en": "Across the whole moonlit world,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure exact printed counterpart for this line.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf092:l036", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 92, "folio": 475, "line_in_page": 36, "raw": "Падышалык кылганга,", "text": "Падышалык кылганга,", "en": "To rule as sovereign,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure exact printed counterpart for this line.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf092:l037", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 92, "folio": 475, "line_in_page": 37, "raw": "Ар шумдарды берсин де.", "text": "Ар шумдарды берсин де.", "en": "Tell them to surrender every villain.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure exact printed counterpart for this line.", "bbox": null}
