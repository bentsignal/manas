[{"id":"semetey-1-2013:p0927:b003:l028","ordinal":146945,"en":"The countless Muslim troops"},{"id":"semetey-1-2013:p0927:b003:l029","ordinal":146946,"en":"To have you alone lead,"},{"id":"semetey-1-2013:p0927:b003:l030","ordinal":146947,"en":"To gird our waists firmly,"},{"id":"semetey-1-2013:p0927:b003:l031","ordinal":146948,"en":"To take you as our aid,"},{"id":"semetey-1-2013:p0927:b003:l032","ordinal":146949,"en":"To face Kongurbai in Beijing"},{"id":"semetey-1-2013:p0927:b003:l033","ordinal":146950,"en":"And pursue the blood-price,"},{"id":"semetey-1-2013:p0927:b003:l034","ordinal":146951,"en":"To inflict grievous torment,"},{"id":"semetey-1-2013:p0927:b003:l035","ordinal":146952,"en":"My champion has sent us to you,"},{"id":"semetey-1-2013:p0927:b003:l036","ordinal":146953,"en":"Over the Argyn and Kyrgyz"},{"id":"semetey-1-2013:p0927:b003:l037","ordinal":146954,"en":"To raise you as their lord."},{"id":"semetey-1-2013:p0927:b003:l038","ordinal":146955,"en":"With a rosy countenance, a radiant face,"},{"id":"semetey-1-2013:p0927:b003:l039","ordinal":146956,"en":"A glowing red ember was he."},{"id":"semetey-1-2013:p0927:b004:l001","ordinal":146957,"en":"In this fleeting world"},{"id":"semetey-1-2013:p0927:b004:l002","ordinal":146958,"en":"There was none like Kulchoro."},{"id":"semetey-1-2013:p0927:b004:l003","ordinal":146959,"en":"The fulfillment of Semetey's wish,"},{"id":"semetey-1-2013:p0927:b004:l004","ordinal":146960,"en":"Girded with a silver belt,"},{"id":"semetey-1-2013:p0927:b004:l005","ordinal":146961,"en":"His sunlike face shining with light,"},{"id":"semetey-1-2013:p0927:b004:l006","ordinal":146962,"en":"This smiling boy"},{"id":"semetey-1-2013:p0927:b004:l007","ordinal":146963,"en":"Was Almambet's son."},{"id":"semetey-1-2013:p0927:b004:l008","ordinal":146964,"en":"Of middling height, broad-shouldered,"},{"id":"semetey-1-2013:p0927:b004:l009","ordinal":146965,"en":"At their feast ninety beasts had been slaughtered;"},{"id":"semetey-1-2013:p0927:b004:l010","ordinal":146966,"en":"He had been named Kanchoro."},{"id":"semetey-1-2013:p0927:b004:l011","ordinal":146967,"en":"He was dear Chubak's son."},{"id":"semetey-1-2013:p0927:b004:l012","ordinal":146968,"en":"You were their honored kinsman;"},{"id":"semetey-1-2013:p0927:b004:l013","ordinal":146969,"en":"My Kozho, know their worth."},{"id":"semetey-1-2013:p0927:b004:l014","ordinal":146970,"en":"We raised peerless steeds, calling them noble horses;"},{"id":"semetey-1-2013:p0927:b004:l015","ordinal":146971,"en":"Unable to stay away, we came, calling you kin."},{"id":"semetey-1-2013:p0927:b004:l016","ordinal":146972,"en":"I have spoken at length—heed my words."},{"id":"semetey-1-2013:p0927:b004:l017","ordinal":146973,"en":"My gray-maned Kozho, understand."},{"id":"semetey-1-2013:p0927:b004:l018","ordinal":146974,"en":"You were my exceptional Kozho;"},{"id":"semetey-1-2013:p0927:b004:l019","ordinal":146975,"en":"I was Bakai, bringer of good fortune.”"},{"id":"semetey-1-2013:p0927:b004:l020","ordinal":146976,"en":"When he spoke in this way,"},{"id":"semetey-1-2013:p0927:b004:l021","ordinal":146977,"en":"Kozho began to rage:"},{"id":"semetey-1-2013:p0927:b004:l022","ordinal":146978,"en":"“Valiant uncle Bakai!"},{"id":"semetey-1-2013:p0927:b004:l023","ordinal":146979,"en":"I will not accept these words of yours;"},{"id":"semetey-1-2013:p0927:b004:l024","ordinal":146980,"en":"I will not go to Talas."},{"id":"semetey-1-2013:p0927:b004:l025","ordinal":146981,"en":"His bloodthirsty father Manas—"},{"id":"semetey-1-2013:p0927:b004:l026","ordinal":146982,"en":"This hand deceived him six times."},{"id":"semetey-1-2013:p0927:b004:l027","ordinal":146983,"en":"Talas amid the mountains—"},{"id":"semetey-1-2013:p0927:b004:l028","ordinal":146984,"en":"How could I go and make it my homeland?"},{"id":"semetey-1-2013:p0927:b004:l029","ordinal":146985,"en":"To Temir Khan's city"},{"id":"semetey-1-2013:p0927:b004:l030","ordinal":146986,"en":"He wandered and grew up,"},{"id":"semetey-1-2013:p0927:b004:l031","ordinal":146987,"en":"That orphan rotten at the root—"},{"id":"semetey-1-2013:p0927:b004:l032","ordinal":146988,"en":"How could I go and make him a hero!"},{"id":"semetey-1-2013:p0927:b004:l033","ordinal":146989,"en":"Do not grieve, Bakai; hear my words."},{"id":"semetey-1-2013:p0927:b004:l034","ordinal":146990,"en":"In hilly Ken-Kol,"},{"id":"semetey-1-2013:p0927:b004:l035","ordinal":146991,"en":"How could I pitch my village?"},{"id":"semetey-1-2013:p0927:b004:l036","ordinal":146992,"en":"Manas's foolish son Semetey—"},{"id":"semetey-1-2013:p0927:b004:l037","ordinal":146993,"en":"Taking that one as my support,"},{"id":"semetey-1-2013:p0927:b004:l038","ordinal":146994,"en":"How could I go there and prosper?"},{"id":"semetey-1-2013:p0927:b004:l039","ordinal":146995,"en":"Set your words right."},{"id":"semetey-1-2013:p0928:b003:l001","ordinal":146996,"en":"Uncle Bakai, before I topple you yourself!"},{"id":"semetey-1-2013:p0928:b003:l002","ordinal":146997,"en":"Do not turn your eyes askance;"},{"id":"semetey-1-2013:p0928:b003:l003","ordinal":146998,"en":"Do not twist your words!"},{"id":"semetey-1-2013:p0928:b003:l004","ordinal":146999,"en":"Is your Talas such a superior land?"},{"id":"semetey-1-2013:p0928:b003:l005","ordinal":147000,"en":"Is Semetey a greater hero than I?"},{"id":"semetey-1-2013:p0928:b003:l009","ordinal":147001,"en":"To Manas's foolish orphan son","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0928:b003:l010","ordinal":147002,"en":"I will not pitch my village as a subject!”"},{"id":"semetey-1-2013:p0928:b003:l011","ordinal":147003,"en":"While Kozho was raging,"},{"id":"semetey-1-2013:p0928:b003:l012","ordinal":147004,"en":"Almambet's Kulchoro,"},{"id":"semetey-1-2013:p0928:b003:l013","ordinal":147005,"en":"Who had not yet charged shouting into battle,"},{"id":"semetey-1-2013:p0928:b003:l014","ordinal":147006,"en":"Between an enemy and a friend"},{"id":"semetey-1-2013:p0928:b003:l015","ordinal":147007,"en":"Had not yet learned to distinguish."},{"id":"semetey-1-2013:p0928:b003:l016","ordinal":147008,"en":"Kulchoro slipped away,"},{"id":"semetey-1-2013:p0928:b003:l017","ordinal":147009,"en":"And caused mischief there."},{"id":"semetey-1-2013:p0928:b003:l018","ordinal":147010,"en":"Chynkozho's Black Horse—"},{"id":"semetey-1-2013:p0928:b003:l019","ordinal":147011,"en":"He cut a notch then,"},{"id":"semetey-1-2013:p0928:b003:l020","ordinal":147012,"en":"And put Ogoy's earmark upon it."},{"id":"semetey-1-2013:p0928:b003:l021","ordinal":147013,"en":"Pulling free of its tether,"},{"id":"semetey-1-2013:p0928:b003:l022","ordinal":147014,"en":"The sly one's Black Horse"},{"id":"semetey-1-2013:p0928:b003:l023","ordinal":147015,"en":"Hurried away with nimble steps."},{"id":"semetey-1-2013:p0928:b003:l024","ordinal":147016,"en":"That accursed one's Black Horse"},{"id":"semetey-1-2013:p0928:b003:l025","ordinal":147017,"en":"Fled toward Kebez-Too."},{"id":"semetey-1-2013:p0928:b003:l026","ordinal":147018,"en":"The mount beneath him"},{"id":"semetey-1-2013:p0928:b003:l027","ordinal":147019,"en":"Was Abyke's Aktelki."},{"id":"semetey-1-2013:p0928:b003:l028","ordinal":147020,"en":"The mighty orphan Kulchoro,"},{"id":"semetey-1-2013:p0928:b003:l029","ordinal":147021,"en":"Lashing his whip to right and left,"},{"id":"semetey-1-2013:p0928:b003:l030","ordinal":147022,"en":"Spurring this way and that,"},{"id":"semetey-1-2013:p0928:b003:l031","ordinal":147023,"en":"Pursued the Black Horse."},{"id":"semetey-1-2013:p0928:b003:l032","ordinal":147024,"en":"Chasing and chasing, unable to catch it,"},{"id":"semetey-1-2013:p0928:b003:l033","ordinal":147025,"en":"The companion came onto the main road."},{"id":"semetey-1-2013:p0928:b003:l034","ordinal":147026,"en":"Keeping beyond his reach as he pursued,"},{"id":"semetey-1-2013:p0928:b003:l035","ordinal":147027,"en":"The Black Horse gained a ridge."},{"id":"semetey-1-2013:p0928:b003:l036","ordinal":147028,"en":"He let the Black Horse escape."},{"id":"semetey-1-2013:p0928:b003:l037","ordinal":147029,"en":"Cutting its ear, Kulchoro"},{"id":"semetey-1-2013:p0928:b003:l038","ordinal":147030,"en":"Had left his mark upon the Black Horse."},{"id":"semetey-1-2013:p0928:b003:l039","ordinal":147031,"en":"While they were raging,"},{"id":"semetey-1-2013:p0928:b004:l001","ordinal":147032,"en":"Kulchoro came back."},{"id":"semetey-1-2013:p0928:b004:l002","ordinal":147033,"en":"Arguing and pressing his case,"},{"id":"semetey-1-2013:p0928:b004:l003","ordinal":147034,"en":"Chynkozho was carrying on."},{"id":"semetey-1-2013:p0928:b004:l004","ordinal":147035,"en":"Roaring like a raging stream,"},{"id":"semetey-1-2013:p0928:b004:l005","ordinal":147036,"en":"Raging like a hungry camel bull,"},{"id":"semetey-1-2013:p0928:b004:l006","ordinal":147037,"en":"Bellowing like a bull,"},{"id":"semetey-1-2013:p0928:b004:l007","ordinal":147038,"en":"Summoning his old fury,"},{"id":"semetey-1-2013:p0928:b004:l008","ordinal":147039,"en":"He rumbled and stormed,"},{"id":"semetey-1-2013:p0928:b004:l009","ordinal":147040,"en":"Speaking against Khan Bakai."},{"id":"semetey-1-2013:p0928:b004:l010","ordinal":147041,"en":"He had all things in abundance;"},{"id":"semetey-1-2013:p0928:b004:l011","ordinal":147042,"en":"His right shoulder was broad."},{"id":"semetey-1-2013:p0928:b004:l012","ordinal":147043,"en":"Were it not for his raging madness,"},{"id":"semetey-1-2013:p0928:b004:l013","ordinal":147044,"en":"He was a hero who could shatter the Oirat."},{"id":"semetey-1-2013:p0928:b004:l014","ordinal":147045,"en":"He was a surging lion."},{"id":"semetey-1-2013:p0928:b004:l015","ordinal":147046,"en":"However mountainlike he was,"},{"id":"semetey-1-2013:p0928:b004:l016","ordinal":147047,"en":"In wisdom he was lacking."},{"id":"semetey-1-2013:p0928:b004:l017","ordinal":147048,"en":"If that Kozho had been resourceful,"},{"id":"semetey-1-2013:p0928:b004:l018","ordinal":147049,"en":"All the world"},{"id":"semetey-1-2013:p0928:b004:l019","ordinal":147050,"en":"He could have made submit."},{"id":"semetey-1-2013:p0928:b004:l020","ordinal":147051,"en":"Your dear uncle Kozho,"},{"id":"semetey-1-2013:p0928:b004:l021","ordinal":147052,"en":"When he raged like a lion,"},{"id":"semetey-1-2013:p0928:b004:l022","ordinal":147053,"en":"Had a black fur cap like a cauldron."},{"id":"semetey-1-2013:p0928:b004:l023","ordinal":147054,"en":"If Chynkozho were wise"},{"id":"semetey-1-2013:p0928:b004:l024","ordinal":147055,"en":"And joined with Semetey,"},{"id":"semetey-1-2013:p0928:b004:l025","ordinal":147056,"en":"All the Chinese and their khagan"},{"id":"semetey-1-2013:p0928:b004:l026","ordinal":147057,"en":"He had the power to put to trial."},{"id":"semetey-1-2013:p0928:b004:l027","ordinal":147058,"en":"All his twelve bodily members were complete;"},{"id":"semetey-1-2013:p0928:b004:l028","ordinal":147059,"en":"He was born an imposing hero."},{"id":"semetey-1-2013:p0928:b004:l029","ordinal":147060,"en":"If you looked upon Chynkozho,"},{"id":"semetey-1-2013:p0928:b004:l030","ordinal":147061,"en":"Kozho was capable in all he did."},{"id":"semetey-1-2013:p0928:b004:l031","ordinal":147062,"en":"Tall and broad-shouldered,"},{"id":"semetey-1-2013:p0928:b004:l032","ordinal":147063,"en":"More imposing than other men, Kozho—"},{"id":"semetey-1-2013:p0928:b004:l033","ordinal":147064,"en":"Which of his qualities shall we tell?"},{"id":"semetey-1-2013:p0928:b004:l034","ordinal":147065,"en":"Both a hero and a lion,"},{"id":"semetey-1-2013:p0928:b004:l035","ordinal":147066,"en":"If you looked upon Chynkozho,"},{"id":"semetey-1-2013:p0928:b004:l036","ordinal":147067,"en":"He was an exceptional man of distinctive splendor."},{"id":"semetey-1-2013:p0928:b004:l037","ordinal":147068,"en":"Clad in a blue flower-patterned coat,"},{"id":"semetey-1-2013:p0928:b004:l038","ordinal":147069,"en":"If you looked upon Chynkozho,"},{"id":"semetey-1-2013:p0928:b004:l039","ordinal":147070,"en":"He raged like a gray tiger,"},{"id":"semetey-1-2013:p0929:b003:l001","ordinal":147071,"en":"All his anger rose,"},{"id":"semetey-1-2013:p0929:b003:l002","ordinal":147072,"en":"His scalp drew tight by a span,"},{"id":"semetey-1-2013:p0929:b003:l003","ordinal":147073,"en":"And he quarreled with Bakai."},{"id":"semetey-1-2013:p0929:b003:l004","ordinal":147074,"en":"Your uncle Bakai, an exceptional lion,"},{"id":"semetey-1-2013:p0929:b003:l005","ordinal":147075,"en":"The dear hero could not gather himself."},{"id":"semetey-1-2013:p0929:b003:l006","ordinal":147076,"en":"With his beard grown white,"},{"id":"semetey-1-2013:p0929:b003:l007","ordinal":147077,"en":"While away upon his journey,"},{"id":"semetey-1-2013:p0929:b003:l008","ordinal":147078,"en":"He had no means to contend"},{"id":"semetey-1-2013:p0929:b003:l009","ordinal":147079,"en":"In his old age."},{"id":"semetey-1-2013:p0929:b003:l010","ordinal":147080,"en":"Caps of gray lynx and marten—"},{"id":"semetey-1-2013:p0929:b003:l011","ordinal":147081,"en":"Who had not worn them swaying?"},{"id":"semetey-1-2013:p0929:b003:l012","ordinal":147082,"en":"Not Kozho alone: before Bakai"},{"id":"semetey-1-2013:p0929:b003:l013","ordinal":147083,"en":"Even Beijing's khan had trembled."},{"id":"semetey-1-2013:p0929:b003:l015","ordinal":147084,"en":"Your leopard uncle Bakai's","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0929:b003:l016","ordinal":147085,"en":"Heart burned fiercely with grief."},{"id":"semetey-1-2013:p0929:b003:l017","ordinal":147086,"en":"Wishing to die, he could not die;"},{"id":"semetey-1-2013:p0929:b003:l018","ordinal":147087,"en":"He could not take his own life."},{"id":"semetey-1-2013:p0929:b003:l019","ordinal":147088,"en":"God would not take Bakai."},{"id":"semetey-1-2013:p0929:b003:l020","ordinal":147089,"en":"Stern Bakai, because of Kozho—"},{"id":"semetey-1-2013:p0929:b003:l021","ordinal":147090,"en":"If he would die, life was too sweet;"},{"id":"semetey-1-2013:p0929:b003:l022","ordinal":147091,"en":"If he would sink into the earth, the ground was hard."},{"id":"semetey-1-2013:p0929:b003:l023","ordinal":147092,"en":"Before even that much time had passed,"},{"id":"semetey-1-2013:p0929:b003:l024","ordinal":147093,"en":"Before a word could be spoken,"},{"id":"semetey-1-2013:p0929:b003:l025","ordinal":147094,"en":"In the blink of an eye,"},{"id":"semetey-1-2013:p0929:b003:l026","ordinal":147095,"en":"His father, lion and goshawk—"},{"id":"semetey-1-2013:p0929:b003:l027","ordinal":147096,"en":"Kulchoro was born surpassing him."},{"id":"semetey-1-2013:p0929:b003:l028","ordinal":147097,"en":"While Kozho stood raging,"},{"id":"semetey-1-2013:p0929:b003:l029","ordinal":147098,"en":"While he committed this outrage,"},{"id":"semetey-1-2013:p0929:b003:l030","ordinal":147099,"en":"Felt fury spread throughout his body."},{"id":"semetey-1-2013:p0929:b003:l031","ordinal":147100,"en":"Ormonbek and Kanchoro—"},{"id":"semetey-1-2013:p0929:b003:l032","ordinal":147101,"en":"He looked at those two."},{"id":"semetey-1-2013:p0929:b003:l033","ordinal":147102,"en":"Unable to withstand his wrath,"},{"id":"semetey-1-2013:p0929:b003:l034","ordinal":147103,"en":"Ormonbek and Kanchoro"},{"id":"semetey-1-2013:p0929:b003:l035","ordinal":147104,"en":"Their hearts leaped within them;"},{"id":"semetey-1-2013:p0929:b003:l036","ordinal":147105,"en":"The weapon grips slipped from their hands."},{"id":"semetey-1-2013:p0929:b003:l037","ordinal":147106,"en":"Shygai's son Chynkozho"},{"id":"semetey-1-2013:p0929:b003:l038","ordinal":147107,"en":"Seemed about to seize them both,"},{"id":"semetey-1-2013:p0929:b003:l039","ordinal":147108,"en":"And lay them across his knee."},{"id":"semetey-1-2013:p0929:b005:l001","ordinal":147109,"en":"Unable to rise, they trembled,"},{"id":"semetey-1-2013:p0929:b005:l002","ordinal":147110,"en":"And scraped the earth, quaking."},{"id":"semetey-1-2013:p0929:b005:l003","ordinal":147111,"en":"At the sight of those two,"},{"id":"semetey-1-2013:p0929:b005:l004","ordinal":147112,"en":"The adept Chynkozho"},{"id":"semetey-1-2013:p0929:b005:l005","ordinal":147113,"en":"Burst into renewed fury,"},{"id":"semetey-1-2013:p0929:b005:l006","ordinal":147114,"en":"Changing his expression in many ways,"},{"id":"semetey-1-2013:p0929:b005:l007","ordinal":147115,"en":"Worked himself into a rage,"},{"id":"semetey-1-2013:p0929:b005:l008","ordinal":147116,"en":"And muttered to himself."},{"id":"semetey-1-2013:p0929:b005:l009","ordinal":147117,"en":"While Kozho carried on thus,"},{"id":"semetey-1-2013:p0929:b005:l010","ordinal":147118,"en":"His father, Lord Alma—"},{"id":"semetey-1-2013:p0929:b005:l011","ordinal":147119,"en":"Kulchoro was born surpassing him."},{"id":"semetey-1-2013:p0929:b005:l012","ordinal":147120,"en":"Did not look about him."},{"id":"semetey-1-2013:p0929:b005:l013","ordinal":147121,"en":"While Kozho stood spurring himself on,"},{"id":"semetey-1-2013:p0929:b005:l014","ordinal":147122,"en":"He spared his life not at all."},{"id":"semetey-1-2013:p0929:b005:l015","ordinal":147123,"en":"Without glancing all around,"},{"id":"semetey-1-2013:p0929:b005:l016","ordinal":147124,"en":"While Kozho stood shouting,"},{"id":"semetey-1-2013:p0929:b005:l017","ordinal":147125,"en":"Not sparing his life in the least, he said:"},{"id":"semetey-1-2013:p0929:b005:l018","ordinal":147126,"en":"“I greeted you before your face,"},{"id":"semetey-1-2013:p0929:b005:l020","ordinal":147127,"en":"Yet you shout without cause.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0929:b005:l021","ordinal":147128,"en":"Now I shall call you simply Kozho!"},{"id":"semetey-1-2013:p0929:b005:l022","ordinal":147129,"en":"You bellow, Kozho,"},{"id":"semetey-1-2013:p0929:b005:l023","ordinal":147130,"en":"As though a demon had struck your wife."},{"id":"semetey-1-2013:p0929:b005:l024","ordinal":147131,"en":"You have flown into a madness,"},{"id":"semetey-1-2013:p0929:b005:l025","ordinal":147132,"en":"As though your quarry had just escaped."},{"id":"semetey-1-2013:p0929:b005:l026","ordinal":147133,"en":"Do not rage without cause, Kozho."},{"id":"semetey-1-2013:p0929:b005:l027","ordinal":147134,"en":"You have no Oigut people in Sary-Kol."},{"id":"semetey-1-2013:p0929:b005:l028","ordinal":147135,"en":"As though stricken with the yellow sickness,"},{"id":"semetey-1-2013:p0929:b005:l029","ordinal":147136,"en":"Do not contend without cause!"},{"id":"semetey-1-2013:p0929:b005:l030","ordinal":147137,"en":"You are getting carried away, Kozho."},{"id":"semetey-1-2013:p0929:b005:l032","ordinal":147138,"en":"These people whom you brought to their knees,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0929:b005:l033","ordinal":147139,"en":"To Manas, who went to the world beyond,"},{"id":"semetey-1-2013:p0929:b005:l034","ordinal":147140,"en":"You handed over as subjects."},{"id":"semetey-1-2013:p0929:b005:l035","ordinal":147141,"en":"Do not rumble, do not rage."},{"id":"semetey-1-2013:p0929:b005:l036","ordinal":147142,"en":"Do not thunder and mutter, Kozho."},{"id":"semetey-1-2013:p0929:b005:l037","ordinal":147143,"en":"If you mean trouble, Kozho,"},{"id":"semetey-1-2013:p0929:b005:l038","ordinal":147144,"en":"Name the support on which you rely;"},{"id":"semetey-1-2013:p0929:b005:l039","ordinal":147145,"en":"Name the place where you will flee and hide."},{"id":"semetey-1-2013:p0930:b003:l001","ordinal":147146,"en":"Name the pit we shall dig for you."},{"id":"semetey-1-2013:p0930:b003:l002","ordinal":147147,"en":"Give your answer without evasion!"},{"id":"semetey-1-2013:p0930:b003:l003","ordinal":147148,"en":"If you would fight, Kozho,"},{"id":"semetey-1-2013:p0930:b003:l004","ordinal":147149,"en":"Name the army you have made ready!"},{"id":"semetey-1-2013:p0930:b003:l005","ordinal":147150,"en":"Zulfiqar, left by Manas,"},{"id":"semetey-1-2013:p0930:b003:l006","ordinal":147151,"en":"I have come to grease."},{"id":"semetey-1-2013:p0930:b003:l007","ordinal":147152,"en":"With my chilling might, Chynkozho,"},{"id":"semetey-1-2013:p0930:b003:l008","ordinal":147153,"en":"I have come to lay you low."},{"id":"semetey-1-2013:p0930:b003:l009","ordinal":147154,"en":"If you call me a blood-drinker, I drink blood;"},{"id":"semetey-1-2013:p0930:b003:l010","ordinal":147155,"en":"I am that bloodthirsty lion himself."},{"id":"semetey-1-2013:p0930:b003:l011","ordinal":147156,"en":"Of your leopard Semetey"},{"id":"semetey-1-2013:p0930:b003:l012","ordinal":147157,"en":"I am the dark eye that keeps watch."},{"id":"semetey-1-2013:p0930:b003:l013","ordinal":147158,"en":"If you call me a hero, I am a hero."},{"id":"semetey-1-2013:p0930:b003:l014","ordinal":147159,"en":"Of blustering men like you,"},{"id":"semetey-1-2013:p0930:b003:l015","ordinal":147160,"en":"If my precious life does not perish,"},{"id":"semetey-1-2013:p0930:b003:l016","ordinal":147161,"en":"I am worth eighty!"},{"id":"semetey-1-2013:p0930:b003:l017","ordinal":147162,"en":"Agree to what I say."},{"id":"semetey-1-2013:p0930:b003:l018","ordinal":147163,"en":"The tribute you paid my father Manas,"},{"id":"semetey-1-2013:p0930:b003:l019","ordinal":147164,"en":"Counting twelve years,"},{"id":"semetey-1-2013:p0930:b003:l020","ordinal":147165,"en":"Pay it in full today!"},{"id":"semetey-1-2013:p0930:b003:l021","ordinal":147166,"en":"If you will not accept these words,"},{"id":"semetey-1-2013:p0930:b003:l022","ordinal":147167,"en":"If you will not give that tribute,"},{"id":"semetey-1-2013:p0930:b003:l023","ordinal":147168,"en":"I shall trample your very crown!"},{"id":"semetey-1-2013:p0930:b003:l024","ordinal":147169,"en":"I shall scatter your four kinds of livestock!"},{"id":"semetey-1-2013:p0930:b003:l025","ordinal":147170,"en":"I shall bind your champions."},{"id":"semetey-1-2013:p0930:b003:l026","ordinal":147171,"en":"If you keep blustering like this,"},{"id":"semetey-1-2013:p0930:b003:l027","ordinal":147172,"en":"I shall offer you as a sacrifice!"},{"id":"semetey-1-2013:p0930:b003:l028","ordinal":147173,"en":"If your words go crooked,"},{"id":"semetey-1-2013:p0930:b003:l029","ordinal":147174,"en":"If you keep shouting,"},{"id":"semetey-1-2013:p0930:b003:l030","ordinal":147175,"en":"I shall destroy you yourself."},{"id":"semetey-1-2013:p0930:b003:l031","ordinal":147176,"en":"You have sorely provoked my wrath."},{"id":"semetey-1-2013:p0930:b003:l032","ordinal":147177,"en":"Watch, Chynkozho:"},{"id":"semetey-1-2013:p0930:b003:l033","ordinal":147178,"en":"An orphan who has grown to strength,"},{"id":"semetey-1-2013:p0930:b003:l034","ordinal":147179,"en":"I have now come into my own!”"},{"id":"semetey-1-2013:p0930:b003:l035","ordinal":147180,"en":"So Kulchoro spoke."},{"id":"semetey-1-2013:p0930:b003:l036","ordinal":147181,"en":"“Let the slave go!”"},{"id":"semetey-1-2013:p0930:b003:l037","ordinal":147182,"en":"Kozho charged forward."},{"id":"semetey-1-2013:p0930:b003:l038","ordinal":147183,"en":"Shygai's son Kozho,"},{"id":"semetey-1-2013:p0930:b003:l039","ordinal":147184,"en":"Struggling like a woman whose husband had died,"},{"id":"semetey-1-2013:p0930:b004:l001","ordinal":147185,"en":"Bakai seized and held."},{"id":"semetey-1-2013:p0930:b004:l002","ordinal":147186,"en":"Almambet's son Choro,"},{"id":"semetey-1-2013:p0930:b004:l003","ordinal":147187,"en":"Struggling like a lion,"},{"id":"semetey-1-2013:p0930:b004:l004","ordinal":147188,"en":"Ormonbek seized and held."},{"id":"semetey-1-2013:p0930:b004:l005","ordinal":147189,"en":"Raging and wrenching about,"},{"id":"semetey-1-2013:p0930:b004:l006","ordinal":147190,"en":"Struggling without restraint,"},{"id":"semetey-1-2013:p0930:b004:l007","ordinal":147191,"en":"While Kozho thrashed in his frenzy,"},{"id":"semetey-1-2013:p0930:b004:l008","ordinal":147192,"en":"The immeasurably brave Kulchoro"},{"id":"semetey-1-2013:p0930:b004:l009","ordinal":147193,"en":"His dark-cheeked whip—"},{"id":"semetey-1-2013:p0930:b004:l010","ordinal":147194,"en":"He seized and swung it round."},{"id":"semetey-1-2013:p0930:b004:l011","ordinal":147195,"en":"Making Kozho's head ring,"},{"id":"semetey-1-2013:p0930:b004:l012","ordinal":147196,"en":"He struck him upon the crown."},{"id":"semetey-1-2013:p0930:b004:l013","ordinal":147197,"en":"Your Kozho, who thought himself a lord,"},{"id":"semetey-1-2013:p0930:b004:l014","ordinal":147198,"en":"When the whip struck his crown,"},{"id":"semetey-1-2013:p0930:b004:l015","ordinal":147199,"en":"Sat down, retching."},{"id":"semetey-1-2013:p0930:b004:l017","ordinal":147200,"en":"The hero Kozho, who thought himself great,","gapBefore":"[Source wording unresolved; translation pending]"}]
