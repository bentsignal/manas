{"id": "sayakbay-ms-current146:pdf094:l020", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 94, "folio": 477, "line_in_page": 20, "raw": "Колдогуңда эринке,", "text": "Колдогуңда эринке,", "en": "While the warrior is in your hands,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf094:l021", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 94, "folio": 477, "line_in_page": 21, "raw": "Өнөр жет мойнуна,", "text": "Өнөр жет мойнуна,", "en": "Let skill reach his neck,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
