[{"id":"semetey-1-2013:p0466:b003:l028","ordinal":112385,"en":"She who joined me when tiny as a louse,"},{"id":"semetey-1-2013:p0466:b003:l029","ordinal":112386,"en":"Who united with me when small as a thumb,"},{"id":"semetey-1-2013:p0466:b003:l030","ordinal":112387,"en":"Whom I met when tiny as a tick,"},{"id":"semetey-1-2013:p0466:b003:l031","ordinal":112388,"en":"The dusky beauty,"},{"id":"semetey-1-2013:p0466:b003:l032","ordinal":112389,"en":"The radiant one among Muslims,"},{"id":"semetey-1-2013:p0466:b003:l033","ordinal":112390,"en":"Fierce Kanykei is not here."},{"id":"semetey-1-2013:p0466:b003:l034","ordinal":112391,"en":"The youngest of twelve daughters,"},{"id":"semetey-1-2013:p0466:b003:l035","ordinal":112392,"en":"God's beloved servant,"},{"id":"semetey-1-2013:p0466:b003:l036","ordinal":112393,"en":"If only Kanykei stood watching,"},{"id":"semetey-1-2013:p0466:b003:l037","ordinal":112394,"en":"Then let that fool Kokchokoz and Kozkaman"},{"id":"semetey-1-2013:p0466:b003:l038","ordinal":112395,"en":"Try to inflict their humiliation!"},{"id":"semetey-1-2013:p0466:b003:l039","ordinal":112396,"en":"When he grew enraged,"},{"id":"semetey-1-2013:p0466:b004:l001","ordinal":112397,"en":"He unleashed a tumult."},{"id":"semetey-1-2013:p0466:b004:l002","ordinal":112398,"en":"When his anger truly rose,"},{"id":"semetey-1-2013:p0466:b004:l003","ordinal":112399,"en":"He struck a camel flat:"},{"id":"semetey-1-2013:p0466:b004:l004","ordinal":112400,"en":"Akayar, the camel-lifter."},{"id":"semetey-1-2013:p0466:b004:l005","ordinal":112401,"en":"When I slaughtered a people with its lord,"},{"id":"semetey-1-2013:p0466:b004:l006","ordinal":112402,"en":"I captured him at four years old"},{"id":"semetey-1-2013:p0466:b004:l007","ordinal":112403,"en":"And brought him home, my champion."},{"id":"semetey-1-2013:p0466:b004:l008","ordinal":112404,"en":"Parted from my champion,"},{"id":"semetey-1-2013:p0466:b004:l009","ordinal":112405,"en":"I am left upon the open plain!”"},{"id":"semetey-1-2013:p0466:b004:l010","ordinal":112406,"en":"While King Manas, the dear lion,"},{"id":"semetey-1-2013:p0466:b004:l011","ordinal":112407,"en":"Was longing for them all,"},{"id":"semetey-1-2013:p0466:b004:l012","ordinal":112408,"en":"Your mighty lion Akayar"},{"id":"semetey-1-2013:p0466:b004:l013","ordinal":112409,"en":"Was standing watching,"},{"id":"semetey-1-2013:p0466:b004:l014","ordinal":112410,"en":"Holding his sword at the ready,"},{"id":"semetey-1-2013:p0466:b004:l015","ordinal":112411,"en":"Thinking this within himself:"},{"id":"semetey-1-2013:p0466:b004:l016","ordinal":112412,"en":"“If my precious Manas remembers me,"},{"id":"semetey-1-2013:p0466:b004:l017","ordinal":112413,"en":"I shall charge in shouting"},{"id":"semetey-1-2013:p0466:b004:l018","ordinal":112414,"en":"And rescue him from the Chinese.”"},{"id":"semetey-1-2013:p0466:b004:l019","ordinal":112415,"en":"At that time Akayar"},{"id":"semetey-1-2013:p0466:b004:l020","ordinal":112416,"en":"Was standing watching."},{"id":"semetey-1-2013:p0466:b004:l021","ordinal":112417,"en":"Akayar gave his full attention,"},{"id":"semetey-1-2013:p0466:b004:l022","ordinal":112418,"en":"And stood looking on,"},{"id":"semetey-1-2013:p0466:b004:l023","ordinal":112419,"en":"Not valuing his life so much as a hair."},{"id":"semetey-1-2013:p0466:b004:l024","ordinal":112420,"en":"For his precious, wolf-like Manas,"},{"id":"semetey-1-2013:p0466:b004:l025","ordinal":112421,"en":"To sacrifice himself,"},{"id":"semetey-1-2013:p0466:b004:l026","ordinal":112422,"en":"He was burning with desire."},{"id":"semetey-1-2013:p0466:b004:l027","ordinal":112423,"en":"When he heard the words that counted him,"},{"id":"semetey-1-2013:p0466:b004:l028","ordinal":112424,"en":"When generous Manas, the leopard,"},{"id":"semetey-1-2013:p0466:b004:l029","ordinal":112425,"en":"Cried out, ‘Akayar!’"},{"id":"semetey-1-2013:p0466:b004:l030","ordinal":112426,"en":"Without looking about him,"},{"id":"semetey-1-2013:p0466:b004:l031","ordinal":112427,"en":"Without sparing his threadlike life,"},{"id":"semetey-1-2013:p0466:b004:l032","ordinal":112428,"en":"Without looking all around,"},{"id":"semetey-1-2013:p0466:b004:l033","ordinal":112429,"en":"Without sparing his life at all,"},{"id":"semetey-1-2013:p0466:b004:l034","ordinal":112430,"en":"His eyes blazed like fire."},{"id":"semetey-1-2013:p0466:b004:l035","ordinal":112431,"en":"He all but died with rage."},{"id":"semetey-1-2013:p0466:b004:l036","ordinal":112432,"en":"His great teeth, broad as doors,"},{"id":"semetey-1-2013:p0466:b004:l037","ordinal":112433,"en":"He ground as though crushing millet."},{"id":"semetey-1-2013:p0466:b004:l038","ordinal":112434,"en":"His eyes blazed like a lion's."},{"id":"semetey-1-2013:p0466:b004:l039","ordinal":112435,"en":"Without stopping, raising his cry,"},{"id":"semetey-1-2013:p0467:b003:l001","ordinal":112436,"en":"A champion such as Akayar"},{"id":"semetey-1-2013:p0467:b003:l002","ordinal":112437,"en":"Was seized by bloodlust."},{"id":"semetey-1-2013:p0467:b003:l003","ordinal":112438,"en":"Told to take a hat, he cut off a head:"},{"id":"semetey-1-2013:p0467:b003:l004","ordinal":112439,"en":"Such an exceptional champion was he."},{"id":"semetey-1-2013:p0467:b003:l005","ordinal":112440,"en":"Told to spill blood, he spilled stomach contents:"},{"id":"semetey-1-2013:p0467:b003:l006","ordinal":112441,"en":"Such was the force he possessed."},{"id":"semetey-1-2013:p0467:b003:l007","ordinal":112442,"en":"Told to drink water, he drank poison:"},{"id":"semetey-1-2013:p0467:b003:l008","ordinal":112443,"en":"Such a rough, rugged hero was he."},{"id":"semetey-1-2013:p0467:b003:l009","ordinal":112444,"en":"Entering to help at the risk of death,"},{"id":"semetey-1-2013:p0467:b003:l010","ordinal":112445,"en":"Fighting men bent on killing,"},{"id":"semetey-1-2013:p0467:b003:l011","ordinal":112446,"en":"To your dear mother Kanykei,"},{"id":"semetey-1-2013:p0467:b003:l012","ordinal":112447,"en":"That sacred, fierce woman,"},{"id":"semetey-1-2013:p0467:b003:l013","ordinal":112448,"en":"That was when he sent word."},{"id":"semetey-1-2013:p0467:b003:l014","ordinal":112449,"en":"When they were about to finish him,"},{"id":"semetey-1-2013:p0467:b003:l015","ordinal":112450,"en":"Refusing to yield to Akayar,"},{"id":"semetey-1-2013:p0467:b003:l016","ordinal":112451,"en":"Your doomed, bloodthirsty father—"},{"id":"semetey-1-2013:p0467:b003:l017","ordinal":112452,"en":"When they were about to cut off his head,"},{"id":"semetey-1-2013:p0467:b003:l018","ordinal":112453,"en":"To plunder his valuables,"},{"id":"semetey-1-2013:p0467:b003:l019","ordinal":112454,"en":"To wreak such destruction,"},{"id":"semetey-1-2013:p0467:b003:l020","ordinal":112455,"en":"When the Chinese pressed in without turning,"},{"id":"semetey-1-2013:p0467:b003:l021","ordinal":112456,"en":"Your peerless father Manas—"},{"id":"semetey-1-2013:p0467:b003:l022","ordinal":112457,"en":"When they were about to take his head thus,"},{"id":"semetey-1-2013:p0467:b003:l023","ordinal":112458,"en":"To erase him from this world,"},{"id":"semetey-1-2013:p0467:b003:l024","ordinal":112459,"en":"To do away with him,"},{"id":"semetey-1-2013:p0467:b003:l025","ordinal":112460,"en":"When Kokchokoz and Kozkaman"},{"id":"semetey-1-2013:p0467:b003:l026","ordinal":112461,"en":"Were about to go to the khan of Chyn Kakan,"},{"id":"semetey-1-2013:p0467:b003:l027","ordinal":112462,"en":"His severed head fastened to them,"},{"id":"semetey-1-2013:p0467:b003:l028","ordinal":112463,"en":"Bearing their glad tidings,"},{"id":"semetey-1-2013:p0467:b003:l029","ordinal":112464,"en":"That Akayar there"},{"id":"semetey-1-2013:p0467:b003:l030","ordinal":112465,"en":"Rekindled his extinguished fire,"},{"id":"semetey-1-2013:p0467:b003:l031","ordinal":112466,"en":"Revived his dead soul,"},{"id":"semetey-1-2013:p0467:b003:l032","ordinal":112467,"en":"Joined what had broken in his life."},{"id":"semetey-1-2013:p0467:b003:l033","ordinal":112468,"en":"He did not stand watching without fighting."},{"id":"semetey-1-2013:p0467:b003:l034","ordinal":112469,"en":"With a furious shout,"},{"id":"semetey-1-2013:p0467:b003:l035","ordinal":112470,"en":"That Akayar charged in,"},{"id":"semetey-1-2013:p0467:b003:l036","ordinal":112471,"en":"The poor man raising ‘Manas!’ as his battle cry."},{"id":"semetey-1-2013:p0467:b003:l037","ordinal":112472,"en":"I, your disgraced, unfortunate mother,"},{"id":"semetey-1-2013:p0467:b003:l038","ordinal":112473,"en":"Have told you the tale; listen."},{"id":"semetey-1-2013:p0467:b003:l039","ordinal":112474,"en":"Let me tell you what happened."},{"id":"semetey-1-2013:p0467:b005:l001","ordinal":112475,"en":"Do not grieve, orphan; listen!"},{"id":"semetey-1-2013:p0467:b005:l002","ordinal":112476,"en":"As I speak these words,"},{"id":"semetey-1-2013:p0467:b005:l003","ordinal":112477,"en":"It was truly a lament to Allah."},{"id":"semetey-1-2013:p0467:b005:l004","ordinal":112478,"en":"His voice was heard, he was unseen:"},{"id":"semetey-1-2013:p0467:b005:l005","ordinal":112479,"en":"Upon your mother's shoulder,"},{"id":"semetey-1-2013:p0467:b005:l006","ordinal":112480,"en":"The suffering of six months ahead"},{"id":"semetey-1-2013:p0467:b005:l007","ordinal":112481,"en":"He could make known at once."},{"id":"semetey-1-2013:p0467:b005:l008","ordinal":112482,"en":"There was a naked child."},{"id":"semetey-1-2013:p0467:b005:l009","ordinal":112483,"en":"Your dear mother Kanykei"},{"id":"semetey-1-2013:p0467:b005:l010","ordinal":112484,"en":"Was a soul descended from saints."},{"id":"semetey-1-2013:p0467:b005:l011","ordinal":112485,"en":"‘God, who strikes men,"},{"id":"semetey-1-2013:p0467:b005:l012","ordinal":112486,"en":"Will surely strike,’ I feared."},{"id":"semetey-1-2013:p0467:b005:l013","ordinal":112487,"en":"‘Such tribulation, such dark deeds,"},{"id":"semetey-1-2013:p0467:b005:l014","ordinal":112488,"en":"These Kalmyks here"},{"id":"semetey-1-2013:p0467:b005:l015","ordinal":112489,"en":"Will commit,’ I feared."},{"id":"semetey-1-2013:p0467:b005:l016","ordinal":112490,"en":"My tears poured down,"},{"id":"semetey-1-2013:p0467:b005:l017","ordinal":112491,"en":"My heart was sorely shaken,"},{"id":"semetey-1-2013:p0467:b005:l018","ordinal":112492,"en":"My eyes were burning fire,"},{"id":"semetey-1-2013:p0467:b005:l019","ordinal":112493,"en":"My heart was burning coals."},{"id":"semetey-1-2013:p0467:b005:l020","ordinal":112494,"en":"Unable to be still, I grew agitated."},{"id":"semetey-1-2013:p0467:b005:l021","ordinal":112495,"en":"Your mother, built like a warrior,"},{"id":"semetey-1-2013:p0467:b005:l022","ordinal":112496,"en":"Was stirred that day."},{"id":"semetey-1-2013:p0467:b005:l023","ordinal":112497,"en":"My palms twitched, my eyes fluttered;"},{"id":"semetey-1-2013:p0467:b005:l024","ordinal":112498,"en":"I saw signs of suffering."},{"id":"semetey-1-2013:p0467:b005:l025","ordinal":112499,"en":"‘If they find the means, the Chinese"},{"id":"semetey-1-2013:p0467:b005:l026","ordinal":112500,"en":"Today upon my bloodthirsty lord"},{"id":"semetey-1-2013:p0467:b005:l027","ordinal":112501,"en":"Will bring some torment"},{"id":"semetey-1-2013:p0467:b005:l028","ordinal":112502,"en":"In this way,’ I feared."},{"id":"semetey-1-2013:p0467:b005:l029","ordinal":112503,"en":"My dear hair, thick as a girth strap,"},{"id":"semetey-1-2013:p0467:b005:l030","ordinal":112504,"en":"I bound tightly upon my crown."},{"id":"semetey-1-2013:p0467:b005:l031","ordinal":112505,"en":"Mail that no shot could pierce,"},{"id":"semetey-1-2013:p0467:b005:l032","ordinal":112506,"en":"I put on four layers."},{"id":"semetey-1-2013:p0467:b005:l033","ordinal":112507,"en":"‘Some devilry the Chinese"},{"id":"semetey-1-2013:p0467:b005:l034","ordinal":112508,"en":"Will devise,’ I feared."},{"id":"semetey-1-2013:p0467:b005:l035","ordinal":112509,"en":"He would not tire if ridden six months,"},{"id":"semetey-1-2013:p0467:b005:l036","ordinal":112510,"en":"Your father's Ak-kula,"},{"id":"semetey-1-2013:p0467:b005:l037","ordinal":112511,"en":"Foal of a young mare,"},{"id":"semetey-1-2013:p0467:b005:l038","ordinal":112512,"en":"The Duldul of the horse herds."},{"id":"semetey-1-2013:p0467:b005:l039","ordinal":112513,"en":"Feeding him millet from the rice fields,"},{"id":"semetey-1-2013:p0468:b003:l001","ordinal":112514,"en":"I trained him to a sweat each day."},{"id":"semetey-1-2013:p0468:b003:l002","ordinal":112515,"en":"Giving him barley from a hanging feedbag,"},{"id":"semetey-1-2013:p0468:b003:l003","ordinal":112516,"en":"I trained him to a sweat each month."},{"id":"semetey-1-2013:p0468:b003:l004","ordinal":112517,"en":"On that day when they would harm your father,"},{"id":"semetey-1-2013:p0468:b003:l005","ordinal":112518,"en":"I awoke with a start from sleep,"},{"id":"semetey-1-2013:p0468:b003:l006","ordinal":112519,"en":"Turned onto my right side,"},{"id":"semetey-1-2013:p0468:b003:l007","ordinal":112520,"en":"As dawn broke clear,"},{"id":"semetey-1-2013:p0468:b003:l008","ordinal":112521,"en":"Hurriedly said my prayers,"},{"id":"semetey-1-2013:p0468:b003:l009","ordinal":112522,"en":"And saddled Ak-kula."},{"id":"semetey-1-2013:p0468:b003:l010","ordinal":112523,"en":"From my currant-dark eyes,"},{"id":"semetey-1-2013:p0468:b003:l011","ordinal":112524,"en":"Tears streamed a whip's length."},{"id":"semetey-1-2013:p0468:b003:l012","ordinal":112525,"en":"From my quail-like eyes,"},{"id":"semetey-1-2013:p0468:b003:l013","ordinal":112526,"en":"Tears fell in separate streams."},{"id":"semetey-1-2013:p0468:b003:l014","ordinal":112527,"en":"The bones of my ribs seemed torn apart,"},{"id":"semetey-1-2013:p0468:b003:l015","ordinal":112528,"en":"The tears poured from my eyes."},{"id":"semetey-1-2013:p0468:b003:l016","ordinal":112529,"en":"‘What condition is my bloodthirsty lord in?’"},{"id":"semetey-1-2013:p0468:b003:l017","ordinal":112530,"en":"The thought tore my mind apart."},{"id":"semetey-1-2013:p0468:b003:l018","ordinal":112531,"en":"In the lowlands of broad Talas,"},{"id":"semetey-1-2013:p0468:b003:l019","ordinal":112532,"en":"The mullah who had come from Mecca—"},{"id":"semetey-1-2013:p0468:b003:l020","ordinal":112533,"en":"Without turning aside to call upon him,"},{"id":"semetey-1-2013:p0468:b003:l021","ordinal":112534,"en":"I, poor soul, entered"},{"id":"semetey-1-2013:p0468:b003:l022","ordinal":112535,"en":"Kazkaman's great yurt."},{"id":"semetey-1-2013:p0468:b003:l023","ordinal":112536,"en":"When I came near the great yurt,"},{"id":"semetey-1-2013:p0468:b003:l024","ordinal":112537,"en":"As dawn broke clear,"},{"id":"semetey-1-2013:p0468:b003:l025","ordinal":112538,"en":"When light touched the earth,"},{"id":"semetey-1-2013:p0468:b003:l026","ordinal":112539,"en":"Kozkaman's champions"},{"id":"semetey-1-2013:p0468:b003:l027","ordinal":112540,"en":"Were rushing about in a flurry."},{"id":"semetey-1-2013:p0468:b003:l028","ordinal":112541,"en":"I saw their faces changed,"},{"id":"semetey-1-2013:p0468:b003:l029","ordinal":112542,"en":"Caught in a calamity."},{"id":"semetey-1-2013:p0468:b003:l030","ordinal":112543,"en":"When I looked at some champions,"},{"id":"semetey-1-2013:p0468:b003:l031","ordinal":112544,"en":"They seemed like men whose wives were spirit-stricken,"},{"id":"semetey-1-2013:p0468:b003:l032","ordinal":112545,"en":"Like fugitives with pursuers close behind."},{"id":"semetey-1-2013:p0468:b003:l033","ordinal":112546,"en":"When I looked at other champions,"},{"id":"semetey-1-2013:p0468:b003:l034","ordinal":112547,"en":"They seemed to be pursuing their quarry,"},{"id":"semetey-1-2013:p0468:b003:l035","ordinal":112548,"en":"As though their wives had borne sons."},{"id":"semetey-1-2013:p0468:b003:l036","ordinal":112549,"en":"Taking their swords, they hurried about;"},{"id":"semetey-1-2013:p0468:b003:l037","ordinal":112550,"en":"Their leaders of ten bobbed in their saddles."},{"id":"semetey-1-2013:p0468:b003:l038","ordinal":112551,"en":"From Kokchokoz's great yurt,"},{"id":"semetey-1-2013:p0468:b003:l039","ordinal":112552,"en":"Spears and swords jutted up."},{"id":"semetey-1-2013:p0468:b004:l001","ordinal":112553,"en":"Pale mottled pennants and red banners,"},{"id":"semetey-1-2013:p0468:b004:l002","ordinal":112554,"en":"Within Kozkaman's house,"},{"id":"semetey-1-2013:p0468:b004:l003","ordinal":112555,"en":"A tumult of ‘Woe!’ and shouting."},{"id":"semetey-1-2013:p0468:b004:l004","ordinal":112556,"en":"Crescent standards and red banners,"},{"id":"semetey-1-2013:p0468:b004:l005","ordinal":112557,"en":"Within that Kalmyk's house,"},{"id":"semetey-1-2013:p0468:b004:l006","ordinal":112558,"en":"Piercing cries and turmoil."},{"id":"semetey-1-2013:p0468:b004:l007","ordinal":112559,"en":"When I looked carefully,"},{"id":"semetey-1-2013:p0468:b004:l008","ordinal":112560,"en":"A faint voice thudded out."},{"id":"semetey-1-2013:p0468:b004:l009","ordinal":112561,"en":"As I attended here and there,"},{"id":"semetey-1-2013:p0468:b004:l010","ordinal":112562,"en":"Raising ‘Manas!’ as the battle cry,"},{"id":"semetey-1-2013:p0468:b004:l011","ordinal":112563,"en":"It was Akayar's voice,"},{"id":"semetey-1-2013:p0468:b004:l012","ordinal":112564,"en":"Booming out now and then."},{"id":"semetey-1-2013:p0468:b004:l013","ordinal":112565,"en":"God, who strikes men,"},{"id":"semetey-1-2013:p0468:b004:l014","ordinal":112566,"en":"Had struck him utterly."},{"id":"semetey-1-2013:p0468:b004:l015","ordinal":112567,"en":"Your leopard father, the bloodthirsty lion,"},{"id":"semetey-1-2013:p0468:b004:l016","ordinal":112568,"en":"Had drunk much poison from the Kalmyks."},{"id":"semetey-1-2013:p0468:b004:l017","ordinal":112569,"en":"Between life and death,"},{"id":"semetey-1-2013:p0468:b004:l018","ordinal":112570,"en":"His thin moustache drooping,"},{"id":"semetey-1-2013:p0468:b004:l019","ordinal":112571,"en":"As though about to depart for Judgment,"},{"id":"semetey-1-2013:p0468:b004:l020","ordinal":112572,"en":"Your father was utterly undone."},{"id":"semetey-1-2013:p0468:b004:l021","ordinal":112573,"en":"Akayar grew furious."},{"id":"semetey-1-2013:p0468:b004:l022","ordinal":112574,"en":"May I be sacrificed to God!"},{"id":"semetey-1-2013:p0468:b004:l023","ordinal":112575,"en":"Without concern for his own safety,"},{"id":"semetey-1-2013:p0468:b004:l024","ordinal":112576,"en":"He counted all the Chinese champions"},{"id":"semetey-1-2013:p0468:b004:l025","ordinal":112577,"en":"As nothing beside him."},{"id":"semetey-1-2013:p0468:b004:l026","ordinal":112578,"en":"Valor and a champion's strength,"},{"id":"semetey-1-2013:p0468:b004:l027","ordinal":112579,"en":"Allah Almighty, the one God,"},{"id":"semetey-1-2013:p0468:b004:l028","ordinal":112580,"en":"Had given him beyond measure."},{"id":"semetey-1-2013:p0468:b004:l029","ordinal":112581,"en":"Coughing in fury,"},{"id":"semetey-1-2013:p0468:b004:l030","ordinal":112582,"en":"Your father, vast as Ala-Too,"},{"id":"semetey-1-2013:p0468:b004:l031","ordinal":112583,"en":"The exceptional champion Akayar"},{"id":"semetey-1-2013:p0468:b004:l032","ordinal":112584,"en":"Lifted like a young child."},{"id":"semetey-1-2013:p0468:b004:l033","ordinal":112585,"en":"Your father, heavy as lead,"},{"id":"semetey-1-2013:p0468:b004:l034","ordinal":112586,"en":"He carried running, without stopping."},{"id":"semetey-1-2013:p0468:b004:l035","ordinal":112587,"en":"In Kozkaman's great yurt,"},{"id":"semetey-1-2013:p0468:b004:l036","ordinal":112588,"en":"He showed himself a hero."},{"id":"semetey-1-2013:p0468:b004:l037","ordinal":112589,"en":"Your mountain-like leopard father"},{"id":"semetey-1-2013:p0468:b004:l038","ordinal":112590,"en":"In Kozkaman's doorway,"},{"id":"semetey-1-2013:p0468:b004:l039","ordinal":112591,"en":"Caught crosswise."},{"id":"semetey-1-2013:p0469:b003:l001","ordinal":112592,"en":"Akayar did not stop."},{"id":"semetey-1-2013:p0469:b003:l003","ordinal":112593,"en":"Your ocean-like father lay upon his back.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0469:b003:l004","ordinal":112594,"en":"Quivering like a fur cap,"},{"id":"semetey-1-2013:p0469:b003:l005","ordinal":112595,"en":"Kozkaman's great yurt,"},{"id":"semetey-1-2013:p0469:b003:l006","ordinal":112596,"en":"Its lattice walls shattered."},{"id":"semetey-1-2013:p0469:b003:l007","ordinal":112597,"en":"Such was Akayar's valor,"},{"id":"semetey-1-2013:p0469:b003:l008","ordinal":112598,"en":"For your wolf-like father Manas,"},{"id":"semetey-1-2013:p0469:b003:l009","ordinal":112599,"en":"Such was the lion's service he performed."},{"id":"semetey-1-2013:p0469:b003:l010","ordinal":112600,"en":"Your father's body"},{"id":"semetey-1-2013:p0469:b003:l011","ordinal":112601,"en":"In Akayar's arms"},{"id":"semetey-1-2013:p0469:b003:l012","ordinal":112602,"en":"Looked like that of a dead man."},{"id":"semetey-1-2013:p0469:b003:l013","ordinal":112603,"en":"I, your unfortunate mother,"},{"id":"semetey-1-2013:p0469:b003:l014","ordinal":112604,"en":"Shed tears from my eyes."},{"id":"semetey-1-2013:p0469:b003:l015","ordinal":112605,"en":"Striking Ak-kula on the thigh,"},{"id":"semetey-1-2013:p0469:b003:l016","ordinal":112606,"en":"Into the foremost group of Kalmyks"},{"id":"semetey-1-2013:p0469:b003:l017","ordinal":112607,"en":"I plunged and attacked."},{"id":"semetey-1-2013:p0469:b003:l018","ordinal":112608,"en":"Those who came face to face,"},{"id":"semetey-1-2013:p0469:b003:l019","ordinal":112609,"en":"I sent sprawling with my axe."},{"id":"semetey-1-2013:p0469:b003:l020","ordinal":112610,"en":"Those who came upon my flank,"},{"id":"semetey-1-2013:p0469:b003:l021","ordinal":112611,"en":"I made dance with my sword."},{"id":"semetey-1-2013:p0469:b003:l022","ordinal":112612,"en":"Their champions standing farther off,"},{"id":"semetey-1-2013:p0469:b003:l023","ordinal":112613,"en":"I sent sprawling with my spear."},{"id":"semetey-1-2013:p0469:b003:l024","ordinal":112614,"en":"Fighting in distress,"},{"id":"semetey-1-2013:p0469:b003:l025","ordinal":112615,"en":"Caught in a tumult,"},{"id":"semetey-1-2013:p0469:b003:l026","ordinal":112616,"en":"As I struck and struggled,"},{"id":"semetey-1-2013:p0469:b003:l027","ordinal":112617,"en":"Azhybai and Khan Bakai were absent,"},{"id":"semetey-1-2013:p0469:b003:l028","ordinal":112618,"en":"All forty choros were absent,"},{"id":"semetey-1-2013:p0469:b003:l029","ordinal":112619,"en":"Almambet and Chubak, the pair, were absent,"},{"id":"semetey-1-2013:p0469:b003:l030","ordinal":112620,"en":"Serek and Syrgak were both absent."},{"id":"semetey-1-2013:p0469:b003:l031","ordinal":112621,"en":"Such is this filthy world!"},{"id":"semetey-1-2013:p0469:b003:l032","ordinal":112622,"en":"Thick embers fell upon my head:"},{"id":"semetey-1-2013:p0469:b003:l033","ordinal":112623,"en":"Kozkaman and Kokchokoz"},{"id":"semetey-1-2013:p0469:b003:l034","ordinal":112624,"en":"Fired thick volleys of shot!"},{"id":"semetey-1-2013:p0469:b003:l035","ordinal":112625,"en":"Upon me, your unfortunate mother,"},{"id":"semetey-1-2013:p0469:b003:l036","ordinal":112626,"en":"The blows of many bullets struck."},{"id":"semetey-1-2013:p0469:b003:l037","ordinal":112627,"en":"My head was covered in blood."},{"id":"semetey-1-2013:p0469:b003:l038","ordinal":112628,"en":"My two flailing arms"},{"id":"semetey-1-2013:p0469:b003:l039","ordinal":112629,"en":"Could no longer rise, limp and powerless."},{"id":"semetey-1-2013:p0469:b004:l001","ordinal":112630,"en":"My whole body"},{"id":"semetey-1-2013:p0469:b004:l002","ordinal":112631,"en":"Was covered in dark, clotted blood."},{"id":"semetey-1-2013:p0469:b004:l003","ordinal":112632,"en":"My fly-like life cried out."},{"id":"semetey-1-2013:p0469:b004:l004","ordinal":112633,"en":"All my weapons"},{"id":"semetey-1-2013:p0469:b004:l005","ordinal":112634,"en":"Shattered under battle-axe blows."},{"id":"semetey-1-2013:p0469:b004:l006","ordinal":112635,"en":"Because of your bloodthirsty father,"},{"id":"semetey-1-2013:p0469:b004:l007","ordinal":112636,"en":"I, a woman, was left to face it."},{"id":"semetey-1-2013:p0469:b004:l008","ordinal":112637,"en":"Your bloodthirsty father was drunk;"},{"id":"semetey-1-2013:p0469:b004:l009","ordinal":112638,"en":"Your wretched mother Kanykei"},{"id":"semetey-1-2013:p0469:b004:l010","ordinal":112639,"en":"Fought with the Kalmyks."},{"id":"semetey-1-2013:p0469:b004:l011","ordinal":112640,"en":"That Kalmyk's intention—"}]
