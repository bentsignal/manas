[{"id":"semetey-2-2013:p1402:b003:l001","ordinal":293633,"en":"Without looking around him,"},{"id":"semetey-2-2013:p1402:b003:l002","ordinal":293634,"en":"Not sparing so much as a hair,"},{"id":"semetey-2-2013:p1402:b003:l003","ordinal":293635,"en":"He conceived a plan no man could fathom,"},{"id":"semetey-2-2013:p1402:b003:l004","ordinal":293636,"en":"And lavishly spent abundant wealth"},{"id":"semetey-2-2013:p1402:b003:l005","ordinal":293637,"en":"And countless livestock upon the feast."},{"id":"semetey-2-2013:p1402:b003:l006","ordinal":293638,"en":"Across the plain of Zherge-Tal,"},{"id":"semetey-2-2013:p1402:b003:l007","ordinal":293639,"en":"Along the banks of Jeti-Suu,"},{"id":"semetey-2-2013:p1402:b003:l008","ordinal":293640,"en":"He raised loud laughter."},{"id":"semetey-2-2013:p1402:b003:l009","ordinal":293641,"en":"Among the Zhediger of Jeti-Ozon,"},{"id":"semetey-2-2013:p1402:b003:l010","ordinal":293642,"en":"He gathered everyone without exception."},{"id":"semetey-2-2013:p1402:b003:l011","ordinal":293643,"en":"The people assembled and packed the place;"},{"id":"semetey-2-2013:p1402:b003:l012","ordinal":293644,"en":"The folk of Jeti-Ozon crowded in."},{"id":"semetey-2-2013:p1402:b003:l013","ordinal":293645,"en":"He opened the treasury,"},{"id":"semetey-2-2013:p1402:b003:l014","ordinal":293646,"en":"And all the amassed gold and wealth"},{"id":"semetey-2-2013:p1402:b003:l015","ordinal":293647,"en":"He scattered lavishly."},{"id":"semetey-2-2013:p1402:b003:l016","ordinal":293648,"en":"He began the games on a boundless scale,"},{"id":"semetey-2-2013:p1402:b003:l017","ordinal":293649,"en":"And all the countless goods"},{"id":"semetey-2-2013:p1402:b003:l018","ordinal":293650,"en":"He utterly gave away."},{"id":"semetey-2-2013:p1402:b003:l019","ordinal":293651,"en":"He slaughtered stallions with tusk-long teeth,"},{"id":"semetey-2-2013:p1402:b003:l020","ordinal":293652,"en":"And specially chosen mares;"},{"id":"semetey-2-2013:p1402:b003:l021","ordinal":293653,"en":"Their two humps standing high,"},{"id":"semetey-2-2013:p1402:b003:l022","ordinal":293654,"en":"He slaughtered ungainly camels,"},{"id":"semetey-2-2013:p1402:b003:l023","ordinal":293655,"en":"Setting out wealth beyond measure."},{"id":"semetey-2-2013:p1402:b003:l024","ordinal":293656,"en":"When the formidable gray wolf had died,"},{"id":"semetey-2-2013:p1402:b003:l025","ordinal":293657,"en":"To the palace taken as spoil,"},{"id":"semetey-2-2013:p1402:b003:l026","ordinal":293658,"en":"Before the khan's dark-eyed lady,"},{"id":"semetey-2-2013:p1402:b003:l027","ordinal":293659,"en":"Before dear Churok herself,"},{"id":"semetey-2-2013:p1402:b003:l028","ordinal":293660,"en":"He summoned the people's biys,"},{"id":"semetey-2-2013:p1402:b003:l029","ordinal":293661,"en":"Gathering all those rulers,"},{"id":"semetey-2-2013:p1402:b003:l030","ordinal":293662,"en":"And hero Kiyaz brought them"},{"id":"semetey-2-2013:p1402:b003:l031","ordinal":293663,"en":"Into Aichurok's dwelling."},{"id":"semetey-2-2013:p1402:b003:l032","ordinal":293664,"en":"The khojas in mottled robes,"},{"id":"semetey-2-2013:p1402:b003:l033","ordinal":293665,"en":"The mullahs wrapped in turbans,"},{"id":"semetey-2-2013:p1402:b003:l034","ordinal":293666,"en":"The eloquent and learned elders—"},{"id":"semetey-2-2013:p1402:b003:l035","ordinal":293667,"en":"So they might carefully behold"},{"id":"semetey-2-2013:p1402:b003:l036","ordinal":293668,"en":"Aichurok's beauty and diversion,"},{"id":"semetey-2-2013:p1402:b003:l037","ordinal":293669,"en":"He gathered all the people."},{"id":"semetey-2-2013:p1402:b003:l038","ordinal":293670,"en":"Those closest to himself,"},{"id":"semetey-2-2013:p1402:b003:l039","ordinal":293671,"en":"Kiyaz gathered his khans"},{"id":"semetey-2-2013:p1402:b004:l001","ordinal":293672,"en":"Into Aichurok's palace."},{"id":"semetey-2-2013:p1402:b004:l002","ordinal":293673,"en":"To his khans and royal kin,"},{"id":"semetey-2-2013:p1402:b004:l003","ordinal":293674,"en":"To everyone close to him,"},{"id":"semetey-2-2013:p1402:b004:l004","ordinal":293675,"en":"To his tiger-hearted heroes,"},{"id":"semetey-2-2013:p1402:b004:l005","ordinal":293676,"en":"To those who rode beside him,"},{"id":"semetey-2-2013:p1402:b004:l006","ordinal":293677,"en":"To his wise and capable lords,"},{"id":"semetey-2-2013:p1402:b004:l007","ordinal":293678,"en":"He displayed Aichurok's bearing,"},{"id":"semetey-2-2013:p1402:b004:l008","ordinal":293679,"en":"Testing the judgment of them all."},{"id":"semetey-2-2013:p1402:b004:l009","ordinal":293680,"en":"The khan proclaimed the viewing,"},{"id":"semetey-2-2013:p1402:b004:l010","ordinal":293681,"en":"And before the noble, unfortunate woman"},{"id":"semetey-2-2013:p1402:b004:l011","ordinal":293682,"en":"Those who faced her stood amazed."},{"id":"semetey-2-2013:p1402:b004:l012","ordinal":293683,"en":"Why had she remained apart from the people?"},{"id":"semetey-2-2013:p1402:b004:l013","ordinal":293684,"en":"Her waist was sheathed, her face moonlike—"},{"id":"semetey-2-2013:p1402:b004:l014","ordinal":293685,"en":"Ah, what a radiant, unfortunate lady!"},{"id":"semetey-2-2013:p1402:b004:l015","ordinal":293686,"en":"Supple as an ermine,"},{"id":"semetey-2-2013:p1402:b004:l016","ordinal":293687,"en":"Her face glittered like the sun;"},{"id":"semetey-2-2013:p1402:b004:l017","ordinal":293688,"en":"She sat in dignity, glowing."},{"id":"semetey-2-2013:p1402:b004:l018","ordinal":293689,"en":"Sixty clasps and forty buttons"},{"id":"semetey-2-2013:p1402:b004:l019","ordinal":293690,"en":"Flashed upon her breast."},{"id":"semetey-2-2013:p1402:b004:l020","ordinal":293691,"en":"The Zhediger who saw her"},{"id":"semetey-2-2013:p1402:b004:l021","ordinal":293692,"en":"Despaired of every woman they had seen."},{"id":"semetey-2-2013:p1402:b004:l022","ordinal":293693,"en":"At the overwhelming wonder,"},{"id":"semetey-2-2013:p1402:b004:l023","ordinal":293694,"en":"Whoever looked upon her trembled."},{"id":"semetey-2-2013:p1402:b004:l024","ordinal":293695,"en":"When Churok whispered,"},{"id":"semetey-2-2013:p1402:b004:l025","ordinal":293696,"en":"Her voice was like a brass komuz;"},{"id":"semetey-2-2013:p1402:b004:l026","ordinal":293697,"en":"The black hair down her back"},{"id":"semetey-2-2013:p1402:b004:l027","ordinal":293698,"en":"Was like the plumage of a parrot."},{"id":"semetey-2-2013:p1402:b004:l028","ordinal":293699,"en":"When she turned, her face flashed;"},{"id":"semetey-2-2013:p1402:b004:l029","ordinal":293700,"en":"Great earrings fashioned of gold"},{"id":"semetey-2-2013:p1402:b004:l030","ordinal":293701,"en":"Glittered upon her breast."},{"id":"semetey-2-2013:p1402:b004:l031","ordinal":293702,"en":"And then there was Churok—"},{"id":"semetey-2-2013:p1402:b004:l032","ordinal":293703,"en":"No, not Churok, but a force of upheaval,"},{"id":"semetey-2-2013:p1402:b004:l033","ordinal":293704,"en":"That infidel woman of singular nature,"},{"id":"semetey-2-2013:p1402:b004:l034","ordinal":293705,"en":"That graceful lady,"},{"id":"semetey-2-2013:p1402:b004:l035","ordinal":293706,"en":"The renowned Lady Churok."},{"id":"semetey-2-2013:p1402:b004:l036","ordinal":293707,"en":"This woman was no mere Churok,"},{"id":"semetey-2-2013:p1402:b004:l037","ordinal":293708,"en":"But turmoil that could ruin a people;"},{"id":"semetey-2-2013:p1402:b004:l038","ordinal":293709,"en":"That champion, Akun's daughter,"},{"id":"semetey-2-2013:p1402:b004:l039","ordinal":293710,"en":"Truly was the moon itself."},{"id":"semetey-2-2013:p1403:b003:l001","ordinal":293711,"en":"For noble men, Churok"},{"id":"semetey-2-2013:p1403:b003:l002","ordinal":293712,"en":"Truly was a fitting companion."},{"id":"semetey-2-2013:p1403:b003:l003","ordinal":293713,"en":"This woman truly possessed"},{"id":"semetey-2-2013:p1403:b003:l004","ordinal":293714,"en":"A power to ruin peoples"},{"id":"semetey-2-2013:p1403:b003:l005","ordinal":293715,"en":"And slaughter nations."},{"id":"semetey-2-2013:p1403:b003:l006","ordinal":293716,"en":"Good heavens, if blood fell upon black earth,"},{"id":"semetey-2-2013:p1403:b003:l007","ordinal":293717,"en":"Behold her flesh, whiter than snow;"},{"id":"semetey-2-2013:p1403:b003:l008","ordinal":293718,"en":"If blood fell upon snow,"},{"id":"semetey-2-2013:p1403:b003:l009","ordinal":293719,"en":"Behold her face, redder than blood."},{"id":"semetey-2-2013:p1403:b003:l010","ordinal":293720,"en":"Supple as an ermine,"},{"id":"semetey-2-2013:p1403:b003:l011","ordinal":293721,"en":"When Aichurok smiled,"},{"id":"semetey-2-2013:p1403:b003:l012","ordinal":293722,"en":"Her broad white teeth gleamed."},{"id":"semetey-2-2013:p1403:b003:l013","ordinal":293723,"en":"Seeing Churok's form,"},{"id":"semetey-2-2013:p1403:b003:l014","ordinal":293724,"en":"All the khans raised a clamor."},{"id":"semetey-2-2013:p1403:b003:l015","ordinal":293725,"en":"Many a man, meaning to carve meat,"},{"id":"semetey-2-2013:p1403:b003:l016","ordinal":293726,"en":"Cut his own hand along with it."},{"id":"semetey-2-2013:p1403:b003:l017","ordinal":293727,"en":"The people bustled in amazement;"},{"id":"semetey-2-2013:p1403:b003:l018","ordinal":293728,"en":"The nation rejoiced and proclaimed"},{"id":"semetey-2-2013:p1403:b003:l019","ordinal":293729,"en":"That the peerless, unfortunate lady"},{"id":"semetey-2-2013:p1403:b003:l020","ordinal":293730,"en":"Had astonished the Zhediger people."},{"id":"semetey-2-2013:p1403:b003:l021","ordinal":293731,"en":"They marveled at her beauty:"},{"id":"semetey-2-2013:p1403:b003:l022","ordinal":293732,"en":"The noble, luckless woman"},{"id":"semetey-2-2013:p1403:b003:l023","ordinal":293733,"en":"Was indeed a renowned beauty."},{"id":"semetey-2-2013:p1403:b003:l024","ordinal":293734,"en":"\"Our people were disrupted and strife arose;"},{"id":"semetey-2-2013:p1403:b003:l025","ordinal":293735,"en":"It was fitting that hero Kojo and hero Toltoy"},{"id":"semetey-2-2013:p1403:b003:l026","ordinal":293736,"en":"Were slain,\""},{"id":"semetey-2-2013:p1403:b003:l027","ordinal":293737,"en":"They said of the events gone by."},{"id":"semetey-2-2013:p1403:b003:l028","ordinal":293738,"en":"Because of that radiant, luckless woman,"},{"id":"semetey-2-2013:p1403:b003:l029","ordinal":293739,"en":"Because of renowned Churok,"},{"id":"semetey-2-2013:p1403:b003:l030","ordinal":293740,"en":"Gray-maned Toltoy the lion died;"},{"id":"semetey-2-2013:p1403:b003:l031","ordinal":293741,"en":"Chynkojo and Tolok died together,"},{"id":"semetey-2-2013:p1403:b003:l032","ordinal":293742,"en":"And many souls died in grief."},{"id":"semetey-2-2013:p1403:b003:l033","ordinal":293743,"en":"Because of this overwhelming woman,"},{"id":"semetey-2-2013:p1403:b003:l034","ordinal":293744,"en":"Many khans who met her died;"},{"id":"semetey-2-2013:p1403:b003:l035","ordinal":293745,"en":"Because of this Churok,"},{"id":"semetey-2-2013:p1403:b003:l036","ordinal":293746,"en":"They took up spear and sword,"},{"id":"semetey-2-2013:p1403:b003:l037","ordinal":293747,"en":"Fired guns and drew bows,"},{"id":"semetey-2-2013:p1403:b003:l038","ordinal":293748,"en":"And fought in bloody clashes."},{"id":"semetey-2-2013:p1403:b003:l039","ordinal":293749,"en":"Look—the people died;"},{"id":"semetey-2-2013:p1403:b005:l001","ordinal":293750,"en":"See how many giants died,"},{"id":"semetey-2-2013:p1403:b005:l002","ordinal":293751,"en":"One alone and many together;"},{"id":"semetey-2-2013:p1403:b005:l003","ordinal":293752,"en":"Heroes died in suffering."},{"id":"semetey-2-2013:p1403:b005:l004","ordinal":293753,"en":"The people were slaughtered amid clamor;"},{"id":"semetey-2-2013:p1403:b005:l005","ordinal":293754,"en":"The heavenly people fell into turmoil."},{"id":"semetey-2-2013:p1403:b005:l006","ordinal":293755,"en":"The nation split into hostile camps,"},{"id":"semetey-2-2013:p1403:b005:l007","ordinal":293756,"en":"Opposing and attacking one another,"},{"id":"semetey-2-2013:p1403:b005:l008","ordinal":293757,"en":"Ripping lungs and piercing gallbladders,"},{"id":"semetey-2-2013:p1403:b005:l009","ordinal":293758,"en":"Killing and cutting off heads;"},{"id":"semetey-2-2013:p1403:b005:l010","ordinal":293759,"en":"Many peoples suffered massacre."},{"id":"semetey-2-2013:p1403:b005:l011","ordinal":293760,"en":"It was a God-struck affair;"},{"id":"semetey-2-2013:p1403:b005:l012","ordinal":293761,"en":"That the multitude suffered torment"},{"id":"semetey-2-2013:p1403:b005:l013","ordinal":293762,"en":"Was true without a lie."},{"id":"semetey-2-2013:p1403:b005:l014","ordinal":293763,"en":"It was a blessed and wondrous night."},{"id":"semetey-2-2013:p1403:b005:l015","ordinal":293764,"en":"Ah, that radiant, daring woman"},{"id":"semetey-2-2013:p1403:b005:l016","ordinal":293765,"en":"Was a heavenly noble lady,"},{"id":"semetey-2-2013:p1403:b005:l017","ordinal":293766,"en":"The very firebrand"},{"id":"semetey-2-2013:p1403:b005:l018","ordinal":293767,"en":"Who had peoples raided and heroes slain."},{"id":"semetey-2-2013:p1403:b005:l019","ordinal":293768,"en":"Her name was beautiful Churok,"},{"id":"semetey-2-2013:p1403:b005:l020","ordinal":293769,"en":"Yet she was turmoil, not mere Churok."},{"id":"semetey-2-2013:p1403:b005:l021","ordinal":293770,"en":"She was an infidel woman"},{"id":"semetey-2-2013:p1403:b005:l022","ordinal":293771,"en":"Who shook nations and disrupted peoples,"},{"id":"semetey-2-2013:p1403:b005:l023","ordinal":293772,"en":"The very night of divine power,"},{"id":"semetey-2-2013:p1403:b005:l024","ordinal":293773,"en":"The very firebrand herself."},{"id":"semetey-2-2013:p1403:b005:l025","ordinal":293774,"en":"Whoever saw her burned like an ember;"},{"id":"semetey-2-2013:p1403:b005:l026","ordinal":293775,"en":"Seeing the fierce woman's beauty,"},{"id":"semetey-2-2013:p1403:b005:l027","ordinal":293776,"en":"What soul could look and remain unmoved?"},{"id":"semetey-2-2013:p1403:b005:l028","ordinal":293777,"en":"\"If only she were my wife,\""},{"id":"semetey-2-2013:p1403:b005:l029","ordinal":293778,"en":"Thought every soul who saw her and burned."},{"id":"semetey-2-2013:p1403:b005:l030","ordinal":293779,"en":"Ah, that radiant, luckless woman"},{"id":"semetey-2-2013:p1403:b005:l031","ordinal":293780,"en":"Was herself a noble peri,"},{"id":"semetey-2-2013:p1403:b005:l032","ordinal":293781,"en":"The dark eye at the heart of turmoil,"},{"id":"semetey-2-2013:p1403:b005:l033","ordinal":293782,"en":"One of the truest beauties."},{"id":"semetey-2-2013:p1403:b005:l034","ordinal":293783,"en":"The noble, unfortunate woman"},{"id":"semetey-2-2013:p1403:b005:l035","ordinal":293784,"en":"Had ranged over the breadth of the earth;"},{"id":"semetey-2-2013:p1403:b005:l036","ordinal":293785,"en":"When this shapeshifting woman transformed,"},{"id":"semetey-2-2013:p1403:b005:l037","ordinal":293786,"en":"She flew and wandered"},{"id":"semetey-2-2013:p1403:b005:l038","ordinal":293787,"en":"Through the four corners of the world,"},{"id":"semetey-2-2013:p1403:b005:l039","ordinal":293788,"en":"Fanning a tail like a parrot's."},{"id":"semetey-2-2013:p1404:b003:l001","ordinal":293789,"en":"The accursed woman Aichurok"},{"id":"semetey-2-2013:p1404:b003:l002","ordinal":293790,"en":"Had flown over and surveyed"},{"id":"semetey-2-2013:p1404:b003:l003","ordinal":293791,"en":"Every inhabited land."},{"id":"semetey-2-2013:p1404:b003:l004","ordinal":293792,"en":"Her eyes saw into the distance;"},{"id":"semetey-2-2013:p1404:b003:l005","ordinal":293793,"en":"She was a wise woman who had seen many lands."},{"id":"semetey-2-2013:p1404:b003:l006","ordinal":293794,"en":"Among all women in flowing dresses,"},{"id":"semetey-2-2013:p1404:b003:l007","ordinal":293795,"en":"She alone had won the race."},{"id":"semetey-2-2013:p1404:b003:l008","ordinal":293796,"en":"When the luckless one was a girl,"},{"id":"semetey-2-2013:p1404:b003:l009","ordinal":293797,"en":"Her father Akun wrapped and veiled her in gold"},{"id":"semetey-2-2013:p1404:b003:l010","ordinal":293798,"en":"And had her raised in splendor."},{"id":"semetey-2-2013:p1404:b003:l011","ordinal":293799,"en":"Knowing she was a noble peri,"},{"id":"semetey-2-2013:p1404:b003:l012","ordinal":293800,"en":"A great judge surpassing the people,"},{"id":"semetey-2-2013:p1404:b003:l013","ordinal":293801,"en":"One with ears to hear and eyes to see,"},{"id":"semetey-2-2013:p1404:b003:l014","ordinal":293802,"en":"A discerning judge of sorrow approved her."},{"id":"semetey-2-2013:p1404:b003:l015","ordinal":293803,"en":"After accepting Akun's hospitality"},{"id":"semetey-2-2013:p1404:b003:l016","ordinal":293804,"en":"And eating the meal he offered,"},{"id":"semetey-2-2013:p1404:b003:l017","ordinal":293805,"en":"He departed saying, \"This daughter of yours"},{"id":"semetey-2-2013:p1404:b003:l018","ordinal":293806,"en":"Will bring upheaval upon the earth.\""},{"id":"semetey-2-2013:p1404:b003:l019","ordinal":293807,"en":"With a tail trailing like a cuckoo's,"},{"id":"semetey-2-2013:p1404:b003:l020","ordinal":293808,"en":"The great sage father Kuroshon"},{"id":"semetey-2-2013:p1404:b003:l021","ordinal":293809,"en":"Saw her and judged her."},{"id":"semetey-2-2013:p1404:b003:l022","ordinal":293810,"en":"Looking upon her outward form,"},{"id":"semetey-2-2013:p1404:b003:l023","ordinal":293811,"en":"He found her perfect in every measure."},{"id":"semetey-2-2013:p1404:b003:l024","ordinal":293812,"en":"My father Kuroshon uttered a marvel;"},{"id":"semetey-2-2013:p1404:b003:l025","ordinal":293813,"en":"He said this to Khan Akun:"},{"id":"semetey-2-2013:p1404:b003:l026","ordinal":293814,"en":"\"From the ridge of the Mediyan desert,"},{"id":"semetey-2-2013:p1404:b003:l027","ordinal":293815,"en":"From the shore of Bel-Soorun,"},{"id":"semetey-2-2013:p1404:b003:l028","ordinal":293816,"en":"While pursuing game and surveying the land,"},{"id":"semetey-2-2013:p1404:b003:l029","ordinal":293817,"en":"You found Churok in the open plain"},{"id":"semetey-2-2013:p1404:b003:l030","ordinal":293818,"en":"When she was still an infant."},{"id":"semetey-2-2013:p1404:b003:l031","ordinal":293819,"en":"As though finding the Night of Power,"},{"id":"semetey-2-2013:p1404:b003:l032","ordinal":293820,"en":"You rejoiced at that blessing,"},{"id":"semetey-2-2013:p1404:b003:l033","ordinal":293821,"en":"Your heart surging,"},{"id":"semetey-2-2013:p1404:b003:l034","ordinal":293822,"en":"And named her Churok."},{"id":"semetey-2-2013:p1404:b003:l035","ordinal":293823,"en":"When I observe her,"},{"id":"semetey-2-2013:p1404:b003:l036","ordinal":293824,"en":"Many a soul will lose his senses,"},{"id":"semetey-2-2013:p1404:b003:l037","ordinal":293825,"en":"Thinking, 'If only she were mine.'"},{"id":"semetey-2-2013:p1404:b003:l038","ordinal":293826,"en":"Infidel and Muslim alike"},{"id":"semetey-2-2013:p1404:b003:l039","ordinal":293827,"en":"Will lose their wits and contend;"},{"id":"semetey-2-2013:p1404:b004:l001","ordinal":293828,"en":"The peoples who see her will quarrel."},{"id":"semetey-2-2013:p1404:b004:l002","ordinal":293829,"en":"Your Churok will prove truly beautiful,"},{"id":"semetey-2-2013:p1404:b004:l003","ordinal":293830,"en":"And strife will arise before her."},{"id":"semetey-2-2013:p1404:b004:l004","ordinal":293831,"en":"She is a peri herself,"},{"id":"semetey-2-2013:p1404:b004:l005","ordinal":293832,"en":"The dark eye at the heart of conflict."},{"id":"semetey-2-2013:p1404:b004:l006","ordinal":293833,"en":"She is one of those firebrands"},{"id":"semetey-2-2013:p1404:b004:l007","ordinal":293834,"en":"Who divide peoples and slaughter nations."},{"id":"semetey-2-2013:p1404:b004:l008","ordinal":293835,"en":"Her face is a burning ember;"},{"id":"semetey-2-2013:p1404:b004:l009","ordinal":293836,"en":"No servant of God is her equal."},{"id":"semetey-2-2013:p1404:b004:l010","ordinal":293837,"en":"Heed these words:"},{"id":"semetey-2-2013:p1404:b004:l011","ordinal":293838,"en":"Give her to a lionhearted hero"},{"id":"semetey-2-2013:p1404:b004:l012","ordinal":293839,"en":"Who will yield to no one in the world."},{"id":"semetey-2-2013:p1404:b004:l013","ordinal":293840,"en":"She is a maiden famed as Churok;"},{"id":"semetey-2-2013:p1404:b004:l014","ordinal":293841,"en":"If your daughter lives,"},{"id":"semetey-2-2013:p1404:b004:l015","ordinal":293842,"en":"Her conflicts will shake the age."},{"id":"semetey-2-2013:p1404:b004:l016","ordinal":293843,"en":"She is famed as a noble peri;"},{"id":"semetey-2-2013:p1404:b004:l017","ordinal":293844,"en":"If this child of yours lives,"},{"id":"semetey-2-2013:p1404:b004:l018","ordinal":293845,"en":"Her troubles will touch all humankind."},{"id":"semetey-2-2013:p1404:b004:l019","ordinal":293846,"en":"Will those who desire to take her"},{"id":"semetey-2-2013:p1404:b004:l020","ordinal":293847,"en":"Ever lie still without quarreling?\""},{"id":"semetey-2-2013:p1404:b004:l021","ordinal":293848,"en":"That discerning father who saw her"},{"id":"semetey-2-2013:p1404:b004:l022","ordinal":293849,"en":"Sharpened his precious tongue"},{"id":"semetey-2-2013:p1404:b004:l023","ordinal":293850,"en":"And before Khan Akun"},{"id":"semetey-2-2013:p1404:b004:l024","ordinal":293851,"en":"Spoke for many days."},{"id":"semetey-2-2013:p1404:b004:l025","ordinal":293852,"en":"He began every kind of discourse;"},{"id":"semetey-2-2013:p1404:b004:l026","ordinal":293853,"en":"Each of his words was excellent."},{"id":"semetey-2-2013:p1404:b004:l027","ordinal":293854,"en":"If you attend to your discerning father,"},{"id":"semetey-2-2013:p1404:b004:l028","ordinal":293855,"en":"And consider every word,"},{"id":"semetey-2-2013:p1404:b004:l029","ordinal":293856,"en":"Each strikes like a spear."},{"id":"semetey-2-2013:p1404:b004:l030","ordinal":293857,"en":"If your name is Khan Akun,"},{"id":"semetey-2-2013:p1404:b004:l031","ordinal":293858,"en":"If you are one who clearly knows"},{"id":"semetey-2-2013:p1404:b004:l032","ordinal":293859,"en":"What comes and what departs,"},{"id":"semetey-2-2013:p1404:b004:l033","ordinal":293860,"en":"Joy and suffering,"},{"id":"semetey-2-2013:p1404:b004:l034","ordinal":293861,"en":"Violence and humiliation,"},{"id":"semetey-2-2013:p1404:b004:l035","ordinal":293862,"en":"Then heed these words"},{"id":"semetey-2-2013:p1404:b004:l036","ordinal":293863,"en":"And find her rightful master."},{"id":"semetey-2-2013:p1404:b004:l037","ordinal":293864,"en":"Her remote ancestor was Tugol Khan,"},{"id":"semetey-2-2013:p1404:b004:l038","ordinal":293865,"en":"Khydyr's blessing entered her lineage;"},{"id":"semetey-2-2013:p1404:b004:l039","ordinal":293866,"en":"Her foremost ancestor was Babyr Khan,"},{"id":"semetey-2-2013:p1405:b003:l001","ordinal":293867,"en":"From Chayan and Boyon,"},{"id":"semetey-2-2013:p1405:b003:l002","ordinal":293868,"en":"From Ilek and Tumon,"},{"id":"semetey-2-2013:p1405:b003:l003","ordinal":293869,"en":"From Nogoi Khan himself,"},{"id":"semetey-2-2013:p1405:b003:l004","ordinal":293870,"en":"From the line of hero Kara Khan,"},{"id":"semetey-2-2013:p1405:b003:l005","ordinal":293871,"en":"From evil-minded Zhakyp,"},{"id":"semetey-2-2013:p1405:b003:l006","ordinal":293872,"en":"His true-born descendant,"},{"id":"semetey-2-2013:p1405:b003:l007","ordinal":293873,"en":"Born after going to Altai,"},{"id":"semetey-2-2013:p1405:b003:l008","ordinal":293874,"en":"Who brought commotion to the world,"},{"id":"semetey-2-2013:p1405:b003:l009","ordinal":293875,"en":"Whose eyes saw into the distance,"},{"id":"semetey-2-2013:p1405:b003:l010","ordinal":293876,"en":"Who alone won every contest,"},{"id":"semetey-2-2013:p1405:b003:l011","ordinal":293877,"en":"Whom no man defeated in combat,"},{"id":"semetey-2-2013:p1405:b003:l012","ordinal":293878,"en":"Whom no hostile foe approached,"},{"id":"semetey-2-2013:p1405:b003:l013","ordinal":293879,"en":"Zhakyp Khan's only son,"},{"id":"semetey-2-2013:p1405:b003:l014","ordinal":293880,"en":"The plane tree of the world's peoples,"},{"id":"semetey-2-2013:p1405:b003:l015","ordinal":293881,"en":"The refuge of the Kyrgyz—"},{"id":"semetey-2-2013:p1405:b003:l016","ordinal":293882,"en":"To Manas, Zhakyp's only son,"},{"id":"semetey-2-2013:p1405:b003:l017","ordinal":293883,"en":"In Keng-Kol and Talas,"},{"id":"semetey-2-2013:p1405:b003:l018","ordinal":293884,"en":"Give her as a bride, he said."},{"id":"semetey-2-2013:p1405:b003:l019","ordinal":293885,"en":"\"Give her to Manas and you will prosper;"},{"id":"semetey-2-2013:p1405:b003:l020","ordinal":293886,"en":"Give her to the hero and you will flourish."},{"id":"semetey-2-2013:p1405:b003:l021","ordinal":293887,"en":"Gold coins and ruby stones"},{"id":"semetey-2-2013:p1405:b003:l022","ordinal":293888,"en":"You will place in your treasury,"}]
