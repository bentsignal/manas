[{"id":"semetey-1-2013:p1349:b004:l023","ordinal":180225,"en":"Sated with campaigns and roads,"},{"id":"semetey-1-2013:p1349:b004:l024","ordinal":180226,"en":"Who brought a calamity"},{"id":"semetey-1-2013:p1349:b004:l025","ordinal":180227,"en":"Upon Beijing."},{"id":"semetey-1-2013:p1349:b004:l026","ordinal":180228,"en":"My heroic uncle Bakay"},{"id":"semetey-1-2013:p1349:b004:l027","ordinal":180229,"en":"Is the waist I gird upon my own!"},{"id":"semetey-1-2013:p1349:b004:l028","ordinal":180230,"en":"My support, like a vast army to my soul,"},{"id":"semetey-1-2013:p1349:b004:l029","ordinal":180231,"en":"Master of roads and knower of lands,"},{"id":"semetey-1-2013:p1349:b004:l030","ordinal":180232,"en":"Is he not skillful Bakay,"},{"id":"semetey-1-2013:p1349:b004:l031","ordinal":180233,"en":"And in Beijing where battles were waged,"},{"id":"semetey-1-2013:p1349:b004:l032","ordinal":180234,"en":"Is he not renowned Bakay?"},{"id":"semetey-1-2013:p1349:b004:l033","ordinal":180235,"en":"My uncle Bakay who knows the road,"},{"id":"semetey-1-2013:p1349:b004:l034","ordinal":180236,"en":"My grandfather like a prophet,"},{"id":"semetey-1-2013:p1349:b004:l035","ordinal":180237,"en":"My uncle Bakay like a father,"},{"id":"semetey-1-2013:p1349:b004:l036","ordinal":180238,"en":"Who sits giving counsel,"},{"id":"semetey-1-2013:p1349:b004:l037","ordinal":180239,"en":"I will lead onto the road to Beijing,"},{"id":"semetey-1-2013:p1349:b004:l038","ordinal":180240,"en":"Whence no traveler returns—"},{"id":"semetey-1-2013:p1349:b004:l039","ordinal":180241,"en":"My tiger uncle Bakay."},{"id":"semetey-1-2013:p1350:b003:l001","ordinal":180242,"en":"My elder, wise old Bakay,"},{"id":"semetey-1-2013:p1350:b003:l002","ordinal":180243,"en":"My saint left above all others"},{"id":"semetey-1-2013:p1350:b003:l003","ordinal":180244,"en":"By my father Sultan Manas!"},{"id":"semetey-1-2013:p1350:b003:l004","ordinal":180245,"en":"My father's confidant,"},{"id":"semetey-1-2013:p1350:b003:l005","ordinal":180246,"en":"The eternal companion"},{"id":"semetey-1-2013:p1350:b003:l006","ordinal":180247,"en":"Of my lion father, the hero."},{"id":"semetey-1-2013:p1350:b003:l007","ordinal":180248,"en":"They shared death and shared life,"},{"id":"semetey-1-2013:p1350:b003:l008","ordinal":180249,"en":"Companions gathered in this world,"},{"id":"semetey-1-2013:p1350:b003:l009","ordinal":180250,"en":"Faithful companions sharing death."},{"id":"semetey-1-2013:p1350:b003:l010","ordinal":180251,"en":"When scouting, they shared one road;"},{"id":"semetey-1-2013:p1350:b003:l011","ordinal":180252,"en":"Entering battle, they shared one army."},{"id":"semetey-1-2013:p1350:b003:l012","ordinal":180253,"en":"Lion Sultan Bakay—"},{"id":"semetey-1-2013:p1350:b003:l013","ordinal":180254,"en":"I choose him and send him on the road."},{"id":"semetey-1-2013:p1350:b003:l014","ordinal":180255,"en":"Great Kalmyk Khan Kongurbay—"},{"id":"semetey-1-2013:p1350:b003:l015","ordinal":180256,"en":"If Almighty Allah supports me,"},{"id":"semetey-1-2013:p1350:b003:l016","ordinal":180257,"en":"I will raid his horses."},{"id":"semetey-1-2013:p1350:b003:l017","ordinal":180258,"en":"Yesterday, while my lion father lived,"},{"id":"semetey-1-2013:p1350:b003:l018","ordinal":180259,"en":"While the falcons remained safe,"},{"id":"semetey-1-2013:p1350:b003:l019","ordinal":180260,"en":"Butcher-prince Bakay—"},{"id":"semetey-1-2013:p1350:b003:l020","ordinal":180261,"en":"Was he not the uncle who went there?"},{"id":"semetey-1-2013:p1350:b003:l021","ordinal":180262,"en":"Calamity upon the khan—"},{"id":"semetey-1-2013:p1350:b003:l022","ordinal":180263,"en":"Was he not the uncle who brought it?"},{"id":"semetey-1-2013:p1350:b003:l023","ordinal":180264,"en":"Gathering tribute from Beijing,"},{"id":"semetey-1-2013:p1350:b003:l024","ordinal":180265,"en":"Was it not Bakay who took it?"},{"id":"semetey-1-2013:p1350:b003:l025","ordinal":180266,"en":"The gloomy city of Tüp-Beijing—"},{"id":"semetey-1-2013:p1350:b003:l026","ordinal":180267,"en":"Was it not Bakay who besieged it?"},{"id":"semetey-1-2013:p1350:b003:l027","ordinal":180268,"en":"Of Beijing's Manchu Chinese,"},{"id":"semetey-1-2013:p1350:b003:l028","ordinal":180269,"en":"Their strong men in armored coats,"},{"id":"semetey-1-2013:p1350:b003:l029","ordinal":180270,"en":"Their bald men who girded stones—"},{"id":"semetey-1-2013:p1350:b003:l030","ordinal":180271,"en":"Was it not Bakay who beat them?"},{"id":"semetey-1-2013:p1350:b003:l031","ordinal":180272,"en":"Riding a courser and grasping the banner,"},{"id":"semetey-1-2013:p1350:b003:l032","ordinal":180273,"en":"Was it not Bakay who went forth?"},{"id":"semetey-1-2013:p1350:b003:l033","ordinal":180274,"en":"Was it not Bakay who fought six months without cease"},{"id":"semetey-1-2013:p1350:b003:l034","ordinal":180275,"en":"And drove them before him"},{"id":"semetey-1-2013:p1350:b003:l035","ordinal":180276,"en":"While lion Manas lived?"},{"id":"semetey-1-2013:p1350:b003:l036","ordinal":180277,"en":"Was it not Bakay who brought"},{"id":"semetey-1-2013:p1350:b003:l037","ordinal":180278,"en":"True slaughter upon the khan,"},{"id":"semetey-1-2013:p1350:b003:l038","ordinal":180279,"en":"In the days of true Manas,"},{"id":"semetey-1-2013:p1350:b003:l039","ordinal":180280,"en":"The golden throne ridden by Chylava—"},{"id":"semetey-1-2013:p1350:b004:l001","ordinal":180281,"en":"Truly entering Beijing,"},{"id":"semetey-1-2013:p1350:b004:l002","ordinal":180282,"en":"Was it not Bakay who seized it?"},{"id":"semetey-1-2013:p1350:b004:l003","ordinal":180283,"en":"Armor that no bullet could pierce—"},{"id":"semetey-1-2013:p1350:b004:l004","ordinal":180284,"en":"Was it not Bakay who wore it?"},{"id":"semetey-1-2013:p1350:b004:l005","ordinal":180285,"en":"The teeming infidel,"},{"id":"semetey-1-2013:p1350:b004:l006","ordinal":180286,"en":"Warrior Khan Kongurbay—"},{"id":"semetey-1-2013:p1350:b004:l007","ordinal":180287,"en":"Was it not Bakay who surveyed their land"},{"id":"semetey-1-2013:p1350:b004:l008","ordinal":180288,"en":"And traveled knowing it well?"},{"id":"semetey-1-2013:p1350:b004:l009","ordinal":180289,"en":"The road to Beijing has five branches;"},{"id":"semetey-1-2013:p1350:b004:l010","ordinal":180290,"en":"Marking and distinguishing them all,"},{"id":"semetey-1-2013:p1350:b004:l011","ordinal":180291,"en":"Was it not Bakay who knew them?"},{"id":"semetey-1-2013:p1350:b004:l012","ordinal":180292,"en":"The blue courser's head—"},{"id":"semetey-1-2013:p1350:b004:l013","ordinal":180293,"en":"Was it not Bakay who once turned it?"},{"id":"semetey-1-2013:p1350:b004:l014","ordinal":180294,"en":"Thrusting his spear into the many foes,"},{"id":"semetey-1-2013:p1350:b004:l015","ordinal":180295,"en":"Was it not Bakay who stood?"},{"id":"semetey-1-2013:p1350:b004:l016","ordinal":180296,"en":"Shattering those who opposed him,"},{"id":"semetey-1-2013:p1350:b004:l017","ordinal":180297,"en":"Was it not Bakay who slaughtered them?"},{"id":"semetey-1-2013:p1350:b004:l018","ordinal":180298,"en":"When bows poured arrows like rain"},{"id":"semetey-1-2013:p1350:b004:l019","ordinal":180299,"en":"And guns fired bullets like hail,"},{"id":"semetey-1-2013:p1350:b004:l020","ordinal":180300,"en":"Was it not Bakay who stood unmoving"},{"id":"semetey-1-2013:p1350:b004:l021","ordinal":180301,"en":"Beneath the banner?"},{"id":"semetey-1-2013:p1350:b004:l022","ordinal":180302,"en":"Beijing's daughter as tribute—"},{"id":"semetey-1-2013:p1350:b004:l023","ordinal":180303,"en":"Was it not Bakay who took her?"},{"id":"semetey-1-2013:p1350:b004:l024","ordinal":180304,"en":"While his dear Manas lived,"},{"id":"semetey-1-2013:p1350:b004:l025","ordinal":180305,"en":"Slaughter upon those who challenged them—"},{"id":"semetey-1-2013:p1350:b004:l026","ordinal":180306,"en":"Was it not Bakay who brought it?"},{"id":"semetey-1-2013:p1350:b004:l027","ordinal":180307,"en":"My uncle Bakay, my falcon,"},{"id":"semetey-1-2013:p1350:b004:l028","ordinal":180308,"en":"The inheritance left by Manas;"},{"id":"semetey-1-2013:p1350:b004:l029","ordinal":180309,"en":"The one I will fight is Kakan-Chyn,"},{"id":"semetey-1-2013:p1350:b004:l030","ordinal":180310,"en":"The one I will confront is Bakburchun."},{"id":"semetey-1-2013:p1350:b004:l031","ordinal":180311,"en":"My heroic uncle Bakay—"},{"id":"semetey-1-2013:p1350:b004:l032","ordinal":180312,"en":"If I make him my renowned companion,"},{"id":"semetey-1-2013:p1350:b004:l033","ordinal":180313,"en":"Kongurbay is indeed a hero;"},{"id":"semetey-1-2013:p1350:b004:l034","ordinal":180314,"en":"I will face him, fight six months,"},{"id":"semetey-1-2013:p1350:b004:l035","ordinal":180315,"en":"And bring conflict upon that swine."},{"id":"semetey-1-2013:p1350:b004:l036","ordinal":180316,"en":"The road to Beijing has five defiles;"},{"id":"semetey-1-2013:p1350:b004:l037","ordinal":180317,"en":"My renowned uncle Bakay"},{"id":"semetey-1-2013:p1350:b004:l038","ordinal":180318,"en":"Will lead me straight against the enemy."},{"id":"semetey-1-2013:p1350:b004:l039","ordinal":180319,"en":"Great Beijing, ancient people,"},{"id":"semetey-1-2013:p1351:b003:l001","ordinal":180320,"en":"Whose multitude, we hear, is like black worms."},{"id":"semetey-1-2013:p1351:b003:l002","ordinal":180321,"en":"We continued from tradition"},{"id":"semetey-1-2013:p1351:b003:l003","ordinal":180322,"en":"And asked those who knew."},{"id":"semetey-1-2013:p1351:b003:l004","ordinal":180323,"en":"To Beijing, which Alexander could not conquer,"},{"id":"semetey-1-2013:p1351:b003:l005","ordinal":180324,"en":"Leveling his spear and drawing his bow,"},{"id":"semetey-1-2013:p1351:b003:l006","ordinal":180325,"en":"Was it not Bakay who went?"},{"id":"semetey-1-2013:p1351:b003:l007","ordinal":180326,"en":"While my Sultan Manas lived,"},{"id":"semetey-1-2013:p1351:b003:l008","ordinal":180327,"en":"Beijing, which Solomon could not conquer—"},{"id":"semetey-1-2013:p1351:b003:l009","ordinal":180328,"en":"Seizing its khanate there,"},{"id":"semetey-1-2013:p1351:b003:l010","ordinal":180329,"en":"Was it not Bakay who took it?"},{"id":"semetey-1-2013:p1351:b003:l011","ordinal":180330,"en":"When battle begins, a bringer of good fortune,"},{"id":"semetey-1-2013:p1351:b003:l012","ordinal":180331,"en":"Against a fighting foe, like a vast army—"},{"id":"semetey-1-2013:p1351:b003:l013","ordinal":180332,"en":"Is he not skillful Bakay?"},{"id":"semetey-1-2013:p1351:b003:l014","ordinal":180333,"en":"Making known what was unknown,"},{"id":"semetey-1-2013:p1351:b003:l015","ordinal":180334,"en":"My learned old Bakay;"},{"id":"semetey-1-2013:p1351:b003:l016","ordinal":180335,"en":"Making one perceive what was unnoticed,"},{"id":"semetey-1-2013:p1351:b003:l017","ordinal":180336,"en":"My falcon, saintly Bakay."},{"id":"semetey-1-2013:p1351:b003:l018","ordinal":180337,"en":"My elder, old Bakay,"},{"id":"semetey-1-2013:p1351:b003:l019","ordinal":180338,"en":"A saint who has seen much;"},{"id":"semetey-1-2013:p1351:b003:l020","ordinal":180339,"en":"Though my elder is old,"},{"id":"semetey-1-2013:p1351:b003:l021","ordinal":180340,"en":"I will take him as my companion."},{"id":"semetey-1-2013:p1351:b003:l022","ordinal":180341,"en":"The reason I make him my companion:"},{"id":"semetey-1-2013:p1351:b003:l023","ordinal":180342,"en":"My poor uncle Bakay"},{"id":"semetey-1-2013:p1351:b003:l024","ordinal":180343,"en":"Is my falcon left as an inheritance"},{"id":"semetey-1-2013:p1351:b003:l025","ordinal":180344,"en":"By my departed father Manas."},{"id":"semetey-1-2013:p1351:b003:l026","ordinal":180345,"en":"If I put my falcon uncle Bakay before me,"},{"id":"semetey-1-2013:p1351:b003:l027","ordinal":180346,"en":"He brings good fortune;"},{"id":"semetey-1-2013:p1351:b003:l028","ordinal":180347,"en":"If he walks behind me, he is my blessing;"},{"id":"semetey-1-2013:p1351:b003:l029","ordinal":180348,"en":"If I take shelter in him, he is like a vast army."},{"id":"semetey-1-2013:p1351:b003:l030","ordinal":180349,"en":"I will journey to the khan,"},{"id":"semetey-1-2013:p1351:b003:l031","ordinal":180350,"en":"For I know the greatness"},{"id":"semetey-1-2013:p1351:b003:l032","ordinal":180351,"en":"Of my blue-maned uncle Bakay."},{"id":"semetey-1-2013:p1351:b003:l033","ordinal":180352,"en":"One road to Beijing"},{"id":"semetey-1-2013:p1351:b003:l034","ordinal":180353,"en":"Has a dug-out pit."},{"id":"semetey-1-2013:p1351:b003:l035","ordinal":180354,"en":"One road, I hear,"},{"id":"semetey-1-2013:p1351:b003:l036","ordinal":180355,"en":"Has boiling salt water."},{"id":"semetey-1-2013:p1351:b003:l037","ordinal":180356,"en":"One road to Beijing"},{"id":"semetey-1-2013:p1351:b003:l038","ordinal":180357,"en":"Has a blocked pass."},{"id":"semetey-1-2013:p1351:b003:l039","ordinal":180358,"en":"One road to Beijing, I hear,"},{"id":"semetey-1-2013:p1351:b004:l001","ordinal":180359,"en":"Has a flood that sweeps all away."},{"id":"semetey-1-2013:p1351:b004:l002","ordinal":180360,"en":"When pursuing my royal father's blood price,"},{"id":"semetey-1-2013:p1351:b004:l003","ordinal":180361,"en":"If I extinguish the fire kindled"},{"id":"semetey-1-2013:p1351:b004:l004","ordinal":180362,"en":"By the clamoring Chinese,"},{"id":"semetey-1-2013:p1351:b004:l005","ordinal":180363,"en":"Seize the khanate"},{"id":"semetey-1-2013:p1351:b004:l006","ordinal":180364,"en":"From their lord, Manchu Kongurbay,"},{"id":"semetey-1-2013:p1351:b004:l007","ordinal":180365,"en":"And drive him toward the khan."},{"id":"semetey-1-2013:p1351:b004:l008","ordinal":180366,"en":"My mind has turned to hardship,"},{"id":"semetey-1-2013:p1351:b004:l009","ordinal":180367,"en":"To girding my waist firmly,"},{"id":"semetey-1-2013:p1351:b004:l010","ordinal":180368,"en":"To rolling up my sleeves against"},{"id":"semetey-1-2013:p1351:b004:l011","ordinal":180369,"en":"Kongurbay in Beijing,"},{"id":"semetey-1-2013:p1351:b004:l012","ordinal":180370,"en":"And pursuing my father's blood price."},{"id":"semetey-1-2013:p1351:b004:l013","ordinal":180371,"en":"Upon the Gün-zhang-zhung people"},{"id":"semetey-1-2013:p1351:b004:l014","ordinal":180372,"en":"I will bring terrible slaughter;"},{"id":"semetey-1-2013:p1351:b004:l015","ordinal":180373,"en":"This year I will avenge"},{"id":"semetey-1-2013:p1351:b004:l016","ordinal":180374,"en":"Falcon Chubak and Almam."},{"id":"semetey-1-2013:p1351:b004:l017","ordinal":180375,"en":"Great Beijing, unreachable by flood—"},{"id":"semetey-1-2013:p1351:b004:l018","ordinal":180376,"en":"If venturesome Allah supports me,"},{"id":"semetey-1-2013:p1351:b004:l019","ordinal":180377,"en":"I will test myself against it;"},{"id":"semetey-1-2013:p1351:b004:l020","ordinal":180378,"en":"If fate arrives and my days end,"},{"id":"semetey-1-2013:p1351:b004:l021","ordinal":180379,"en":"I will die in Great Beijing."},{"id":"semetey-1-2013:p1351:b004:l022","ordinal":180380,"en":"How can I live"},{"id":"semetey-1-2013:p1351:b004:l023","ordinal":180381,"en":"Without charging and waging war"},{"id":"semetey-1-2013:p1351:b004:l024","ordinal":180382,"en":"Against the teeming khan,"},{"id":"semetey-1-2013:p1351:b004:l025","ordinal":180383,"en":"Without avenging my royal father?"},{"id":"semetey-1-2013:p1351:b004:l026","ordinal":180384,"en":"For the sake of the falcons,"},{"id":"semetey-1-2013:p1351:b004:l027","ordinal":180385,"en":"I will bring slaughter upon China;"},{"id":"semetey-1-2013:p1351:b004:l028","ordinal":180386,"en":"I will go and avenge the falcons"},{"id":"semetey-1-2013:p1351:b004:l029","ordinal":180387,"en":"Who met Judgment Day"},{"id":"semetey-1-2013:p1351:b004:l030","ordinal":180388,"en":"At the hands of the red-naveled Kalmyks."},{"id":"semetey-1-2013:p1351:b004:l031","ordinal":180389,"en":"I will bring slaughter upon Beijing."},{"id":"semetey-1-2013:p1351:b004:l032","ordinal":180390,"en":"Without avenging my hero father, the lion,"},{"id":"semetey-1-2013:p1351:b004:l033","ordinal":180391,"en":"And the falcons,"},{"id":"semetey-1-2013:p1351:b004:l034","ordinal":180392,"en":"How can I remain alive?"},{"id":"semetey-1-2013:p1351:b004:l035","ordinal":180393,"en":"I will campaign against Kakan-Chyn,"},{"id":"semetey-1-2013:p1351:b004:l036","ordinal":180394,"en":"And contend in battle"},{"id":"semetey-1-2013:p1351:b004:l037","ordinal":180395,"en":"With warrior Khan Kongurbay;"},{"id":"semetey-1-2013:p1351:b004:l038","ordinal":180396,"en":"I will fight him at close quarters"},{"id":"semetey-1-2013:p1351:b004:l039","ordinal":180397,"en":"And spill his blood without ceasing."},{"id":"semetey-1-2013:p1352:b003:l001","ordinal":180398,"en":"I will tread upon the head"},{"id":"semetey-1-2013:p1352:b003:l002","ordinal":180399,"en":"Of the lordly Chinese,"},{"id":"semetey-1-2013:p1352:b003:l003","ordinal":180400,"en":"And scatter the four kinds of livestock"},{"id":"semetey-1-2013:p1352:b003:l004","ordinal":180401,"en":"Of the swine who struck you from above."},{"id":"semetey-1-2013:p1352:b003:l005","ordinal":180402,"en":"If I do not ride forth facing"},{"id":"semetey-1-2013:p1352:b003:l006","ordinal":180403,"en":"Heroic Beijing,"},{"id":"semetey-1-2013:p1352:b003:l007","ordinal":180404,"en":"And lay grievous hardship"},{"id":"semetey-1-2013:p1352:b003:l008","ordinal":180405,"en":"Upon the Kalmyks at Beijing's gate!"},{"id":"semetey-1-2013:p1352:b003:l009","ordinal":180406,"en":"If I do not truly enter"},{"id":"semetey-1-2013:p1352:b003:l010","ordinal":180407,"en":"Chynmachyn's Beijing and bring slaughter,"},{"id":"semetey-1-2013:p1352:b003:l011","ordinal":180408,"en":"And this year avenge the falcons"},{"id":"semetey-1-2013:p1352:b003:l012","ordinal":180409,"en":"Who departed for the true world!”"},{"id":"semetey-1-2013:p1352:b003:l013","ordinal":180410,"en":"The fine brave son of Manas,"},{"id":"semetey-1-2013:p1352:b003:l014","ordinal":180411,"en":"Speaking many words with flashing eyes,"},{"id":"semetey-1-2013:p1352:b003:l015","ordinal":180412,"en":"Was impossible to look upon;"},{"id":"semetey-1-2013:p1352:b003:l016","ordinal":180413,"en":"The hero's youthful son"},{"id":"semetey-1-2013:p1352:b003:l017","ordinal":180414,"en":"Was truly seized by bloodlust."},{"id":"semetey-1-2013:p1352:b003:l018","ordinal":180415,"en":"Flame poured from his mouth,"},{"id":"semetey-1-2013:p1352:b003:l019","ordinal":180416,"en":"And the warrior aspect"},{"id":"semetey-1-2013:p1352:b003:l020","ordinal":180417,"en":"Of Manas's blue-maned son appeared."},{"id":"semetey-1-2013:p1352:b003:l021","ordinal":180418,"en":"The dear lion grew agitated,"},{"id":"semetey-1-2013:p1352:b003:l022","ordinal":180419,"en":"Girding on his gray purse,"},{"id":"semetey-1-2013:p1352:b003:l023","ordinal":180420,"en":"Scowling in fury,"},{"id":"semetey-1-2013:p1352:b003:l024","ordinal":180421,"en":"Distracting the minds of all who saw him."},{"id":"semetey-1-2013:p1352:b003:l025","ordinal":180422,"en":"When he came in anger,"},{"id":"semetey-1-2013:p1352:b003:l026","ordinal":180423,"en":"The descendant of the blood-drinker"},{"id":"semetey-1-2013:p1352:b003:l027","ordinal":180424,"en":"Showed the form of a lion."},{"id":"semetey-1-2013:p1352:b003:l028","ordinal":180425,"en":"Straining like a gray tiger,"},{"id":"semetey-1-2013:p1352:b003:l029","ordinal":180426,"en":"He prepared to pursue the blood price"},{"id":"semetey-1-2013:p1352:b003:l030","ordinal":180427,"en":"From Kakan-Chyn's Beijing."},{"id":"semetey-1-2013:p1352:b003:l031","ordinal":180428,"en":"The ill-starred heir left as a gift"},{"id":"semetey-1-2013:p1352:b003:l032","ordinal":180429,"en":"By blue-maned hero Manas"},{"id":"semetey-1-2013:p1352:b003:l033","ordinal":180430,"en":"Would not turn back from doom,"},{"id":"semetey-1-2013:p1352:b003:l034","ordinal":180431,"en":"Nor retreat a hair from death;"},{"id":"semetey-1-2013:p1352:b003:l035","ordinal":180432,"en":"His brow was high, his venom strong,"},{"id":"semetey-1-2013:p1352:b003:l036","ordinal":180433,"en":"And he set right whoever attacked him."},{"id":"semetey-1-2013:p1352:b003:l037","ordinal":180434,"en":"From his fathers and forefathers"},{"id":"semetey-1-2013:p1352:b003:l038","ordinal":180435,"en":"There were eighty-four armed men."},{"id":"semetey-1-2013:p1352:b004:l001","ordinal":180436,"en":"From the beginning, wherever these blue-maned wolves"},{"id":"semetey-1-2013:p1352:b004:l002","ordinal":180437,"en":"Struck, there was red fire."},{"id":"semetey-1-2013:p1352:b004:l003","ordinal":180438,"en":"From his fathers and forefathers,"},{"id":"semetey-1-2013:p1352:b004:l004","ordinal":180439,"en":"He thought only what he himself wished,"},{"id":"semetey-1-2013:p1352:b004:l005","ordinal":180440,"en":"Heedless of anyone,"},{"id":"semetey-1-2013:p1352:b004:l006","ordinal":180441,"en":"Even if his doom arrived now,"},{"id":"semetey-1-2013:p1352:b004:l007","ordinal":180442,"en":"Even if he died at once,"},{"id":"semetey-1-2013:p1352:b004:l008","ordinal":180443,"en":"Taking no other person's word."},{"id":"semetey-1-2013:p1352:b004:l009","ordinal":180444,"en":"He acted on everything he saw,"},{"id":"semetey-1-2013:p1352:b004:l010","ordinal":180445,"en":"Descendant of the empty-headed line,"},{"id":"semetey-1-2013:p1352:b004:l011","ordinal":180446,"en":"Who poured blood into black water,"},{"id":"semetey-1-2013:p1352:b004:l012","ordinal":180447,"en":"Own son of Khan Manas."},{"id":"semetey-1-2013:p1352:b004:l013","ordinal":180448,"en":"He greased the grassy earth,"},{"id":"semetey-1-2013:p1352:b004:l014","ordinal":180449,"en":"And when provoked,"},{"id":"semetey-1-2013:p1352:b004:l015","ordinal":180450,"en":"Laid low even his own kin."},{"id":"semetey-1-2013:p1352:b004:l016","ordinal":180451,"en":"Descendant of the accursed one,"},{"id":"semetey-1-2013:p1352:b004:l017","ordinal":180452,"en":"Smoking more as he was exhausted,"},{"id":"semetey-1-2013:p1352:b004:l018","ordinal":180453,"en":"Own son of turbulent Manas,"},{"id":"semetey-1-2013:p1352:b004:l019","ordinal":180454,"en":"Growing stronger whenever men died."},{"id":"semetey-1-2013:p1352:b004:l020","ordinal":180455,"en":"He took his weapons and made ready,"},{"id":"semetey-1-2013:p1352:b004:l021","ordinal":180456,"en":"Preparing to mount and ride"},{"id":"semetey-1-2013:p1352:b004:l022","ordinal":180457,"en":"Against clamoring China."},{"id":"semetey-1-2013:p1352:b004:l023","ordinal":180458,"en":"Which of his deeds shall I tell?"},{"id":"semetey-1-2013:p1352:b004:l024","ordinal":180459,"en":"This butcher's youthful son"},{"id":"semetey-1-2013:p1352:b004:l025","ordinal":180460,"en":"Drives white deer and makes them cattle;"},{"id":"semetey-1-2013:p1352:b004:l026","ordinal":180461,"en":"He makes the enemy he fights his servant."},{"id":"semetey-1-2013:p1352:b004:l027","ordinal":180462,"en":"He drives blue deer and makes them cattle;"},{"id":"semetey-1-2013:p1352:b004:l028","ordinal":180463,"en":"He makes the enemy he targets his servant."},{"id":"semetey-1-2013:p1352:b004:l029","ordinal":180464,"en":"Sharpening his keen steel,"},{"id":"semetey-1-2013:p1352:b004:l030","ordinal":180465,"en":"Preparing his weapons,"},{"id":"semetey-1-2013:p1352:b004:l031","ordinal":180466,"en":"Rejoicing at the word Beijing,"},{"id":"semetey-1-2013:p1352:b004:l032","ordinal":180467,"en":"The hero's youthful son—"},{"id":"semetey-1-2013:p1352:b004:l033","ordinal":180468,"en":"He put on his bulletproof coat."},{"id":"semetey-1-2013:p1352:b004:l034","ordinal":180469,"en":"Ah, poor lion, swaggering,"},{"id":"semetey-1-2013:p1352:b004:l035","ordinal":180470,"en":"His face transformed by wrath—"},{"id":"semetey-1-2013:p1352:b004:l036","ordinal":180471,"en":"(The youth born after"},{"id":"semetey-1-2013:p1352:b004:l037","ordinal":180472,"en":"His father, magnanimous Manas:"},{"id":"semetey-1-2013:p1352:b004:l038","ordinal":180473,"en":"Which of his deeds can we tell?)"},{"id":"semetey-1-2013:p1352:b004:l039","ordinal":180474,"en":"To journey on campaign to Beijing,"},{"id":"semetey-1-2013:p1353:b003:l001","ordinal":180475,"en":"To raid every one of the countless livestock"},{"id":"semetey-1-2013:p1353:b003:l002","ordinal":180476,"en":"Kongurbay gathered as tribute,"},{"id":"semetey-1-2013:p1353:b003:l003","ordinal":180477,"en":"Leaving none behind,"},{"id":"semetey-1-2013:p1353:b003:l004","ordinal":180478,"en":"The prince stood prepared."},{"id":"semetey-1-2013:p1353:b003:l005","ordinal":180479,"en":"His butcher uncle Bakay"},{"id":"semetey-1-2013:p1353:b003:l006","ordinal":180480,"en":"Put on a blue lynx-fur cap,"}]
