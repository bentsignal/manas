[{"id":"semetey-1-2013:p0761:b005:l007","ordinal":134657,"en":"No mortal could stand against him;"},{"id":"semetey-1-2013:p0761:b005:l008","ordinal":134658,"en":"The enemy he faced fell."},{"id":"semetey-1-2013:p0761:b005:l009","ordinal":134659,"en":"Then my distressed mother Kanykey—"},{"id":"semetey-1-2013:p0761:b005:l010","ordinal":134660,"en":"You went straight in to her,"},{"id":"semetey-1-2013:p0761:b005:l011","ordinal":134661,"en":"Wreaked havoc upon my mother,"},{"id":"semetey-1-2013:p0761:b005:l012","ordinal":134662,"en":"And seized this from her."},{"id":"semetey-1-2013:p0761:b005:l013","ordinal":134663,"en":"I came to ask; agree,"},{"id":"semetey-1-2013:p0761:b005:l014","ordinal":134664,"en":"And give me Bozkise."},{"id":"semetey-1-2013:p0761:b005:l015","ordinal":134665,"en":"When that wondrous thing was slung,"},{"id":"semetey-1-2013:p0761:b005:l016","ordinal":134666,"en":"It was the mirror of the shoulder blade."},{"id":"semetey-1-2013:p0761:b005:l017","ordinal":134667,"en":"If it struck the enemy in battle once,"},{"id":"semetey-1-2013:p0761:b005:l018","ordinal":134668,"en":"It was the support of one's entrusted life."},{"id":"semetey-1-2013:p0761:b005:l019","ordinal":134669,"en":"It is property left by my father,"},{"id":"semetey-1-2013:p0761:b005:l020","ordinal":134670,"en":"A keen weapon to carry."},{"id":"semetey-1-2013:p0761:b005:l021","ordinal":134671,"en":"Where is Akkelte? Tell me this!"},{"id":"semetey-1-2013:p0761:b005:l022","ordinal":134672,"en":"When my father died,"},{"id":"semetey-1-2013:p0761:b005:l023","ordinal":134673,"en":"On the hills were mottled-headed horses,"},{"id":"semetey-1-2013:p0761:b005:l024","ordinal":134674,"en":"Coursers and swift steeds mingled—"},{"id":"semetey-1-2013:p0761:b005:l025","ordinal":134675,"en":"Where is the livestock my father left?"},{"id":"semetey-1-2013:p0761:b005:l026","ordinal":134676,"en":"Uncle Abyke, tell me this:"},{"id":"semetey-1-2013:p0761:b005:l027","ordinal":134677,"en":"Treasures filling eight buildings,"},{"id":"semetey-1-2013:p0761:b005:l028","ordinal":134678,"en":"Red gold coins and yellow gold,"},{"id":"semetey-1-2013:p0761:b005:l029","ordinal":134679,"en":"Gemstones and rubies mingled—"},{"id":"semetey-1-2013:p0761:b005:l030","ordinal":134680,"en":"Uncle Abyke, tell me this."},{"id":"semetey-1-2013:p0761:b005:l031","ordinal":134681,"en":"Narbuurul, left by my father,"},{"id":"semetey-1-2013:p0761:b005:l032","ordinal":134682,"en":"Born in the desert, raised upon stone,"},{"id":"semetey-1-2013:p0761:b005:l034","ordinal":134683,"en":"Who raced with wild asses,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0761:b005:l035","ordinal":134684,"en":"With the maiden Saykal's Algara,"},{"id":"semetey-1-2013:p0761:b005:l036","ordinal":134685,"en":"The winged steed, born of the same kin."},{"id":"semetey-1-2013:p0761:b005:l037","ordinal":134686,"en":"High-backed, short of stature,"},{"id":"semetey-1-2013:p0761:b005:l038","ordinal":134687,"en":"He would not falter upon the hills;"},{"id":"semetey-1-2013:p0761:b005:l039","ordinal":134688,"en":"Until he reached his sixty-fourth year,"},{"id":"semetey-1-2013:p0762:b003:l001","ordinal":134689,"en":"He would not grow old grinding his teeth."},{"id":"semetey-1-2013:p0762:b003:l002","ordinal":134690,"en":"When he came to compete,"},{"id":"semetey-1-2013:p0762:b003:l003","ordinal":134691,"en":"The roan horse given as a gift,"},{"id":"semetey-1-2013:p0762:b003:l004","ordinal":134692,"en":"With a camel's forelock and a short mane,"},{"id":"semetey-1-2013:p0762:b003:l005","ordinal":134693,"en":"A courser left by my father, Khan Manas."},{"id":"semetey-1-2013:p0762:b003:l007","ordinal":134694,"en":"When Saykal gave him as a gift,"},{"id":"semetey-1-2013:p0762:b003:l008","ordinal":134695,"en":"When he arrived as a yearling,"},{"id":"semetey-1-2013:p0762:b003:l009","ordinal":134696,"en":"They had owl feathers fixed upon his head,"},{"id":"semetey-1-2013:p0762:b003:l010","ordinal":134697,"en":"Had him kept in a dark place,"},{"id":"semetey-1-2013:p0762:b003:l011","ordinal":134698,"en":"A horse judge tested and approved him,"},{"id":"semetey-1-2013:p0762:b003:l012","ordinal":134699,"en":"And had a rich covering laid upon him."},{"id":"semetey-1-2013:p0762:b003:l013","ordinal":134700,"en":"Twisting his neck like a stag,"},{"id":"semetey-1-2013:p0762:b003:l014","ordinal":134701,"en":"If a precipice a bowshot wide appeared,"},{"id":"semetey-1-2013:p0762:b003:l015","ordinal":134702,"en":"He galloped on without delay."},{"id":"semetey-1-2013:p0762:b003:l016","ordinal":134703,"en":"Once they knew his speed,"},{"id":"semetey-1-2013:p0762:b003:l017","ordinal":134704,"en":"Giving gold by the pood and fine cloth,"},{"id":"semetey-1-2013:p0762:b003:l018","ordinal":134705,"en":"The khan of Bukhara asked for him."},{"id":"semetey-1-2013:p0762:b003:l019","ordinal":134706,"en":"Twisting his neck like a wild sheep,"},{"id":"semetey-1-2013:p0762:b003:l020","ordinal":134707,"en":"If a trench a rope's length wide appeared,"},{"id":"semetey-1-2013:p0762:b003:l021","ordinal":134708,"en":"He cleared it without hesitation and raced on."},{"id":"semetey-1-2013:p0762:b003:l022","ordinal":134709,"en":"When they knew his excellence,"},{"id":"semetey-1-2013:p0762:b003:l023","ordinal":134710,"en":"Offering red gold with coaxing words,"},{"id":"semetey-1-2013:p0762:b003:l024","ordinal":134711,"en":"The khan of Andijan asked for him."},{"id":"semetey-1-2013:p0762:b003:l025","ordinal":134712,"en":"They would not give him to those who asked;"},{"id":"semetey-1-2013:p0762:b003:l026","ordinal":134713,"en":"Far from giving Buurul away,"},{"id":"semetey-1-2013:p0762:b003:l027","ordinal":134714,"en":"No person without ritual washing rode him."},{"id":"semetey-1-2013:p0762:b003:l028","ordinal":134715,"en":"Then there were Muzburchak and Khan Kokcho,"},{"id":"semetey-1-2013:p0762:b003:l029","ordinal":134716,"en":"There were the giants Koshoi and Toshtuk,"},{"id":"semetey-1-2013:p0762:b003:l030","ordinal":134717,"en":"All the mighty Muslim champions were there."},{"id":"semetey-1-2013:p0762:b003:l031","ordinal":134718,"en":"When Almambet had passed as a martyr,"},{"id":"semetey-1-2013:p0762:b003:l032","ordinal":134719,"en":"And my father was left standing tall,"},{"id":"semetey-1-2013:p0762:b003:l033","ordinal":134720,"en":"Kozhozhash, son of Karazhoi,"},{"id":"semetey-1-2013:p0762:b003:l034","ordinal":134721,"en":"Brought upon him grievous trouble."},{"id":"semetey-1-2013:p0762:b003:l035","ordinal":134722,"en":"Leaning upon Akkelte,"},{"id":"semetey-1-2013:p0762:b003:l036","ordinal":134723,"en":"My noble father stood bereft,"},{"id":"semetey-1-2013:p0762:b003:l037","ordinal":134724,"en":"Bewildered, finding no way out,"},{"id":"semetey-1-2013:p0762:b003:l038","ordinal":134725,"en":"Grieving and sorrowing,"},{"id":"semetey-1-2013:p0762:b003:l039","ordinal":134726,"en":"Having lost Akkula,"},{"id":"semetey-1-2013:p0762:b004:l001","ordinal":134727,"en":"When my leopard father stood there,"},{"id":"semetey-1-2013:p0762:b004:l002","ordinal":134728,"en":"Saint-like Khan Bakay"},{"id":"semetey-1-2013:p0762:b004:l003","ordinal":134729,"en":"Buurul, in his fifth year—"},{"id":"semetey-1-2013:p0762:b004:l004","ordinal":134730,"en":"When he arrived bringing him,"},{"id":"semetey-1-2013:p0762:b004:l005","ordinal":134731,"en":"When my father mounted Buurul,"},{"id":"semetey-1-2013:p0762:b004:l006","ordinal":134732,"en":"And spurred him into the enemy,"},{"id":"semetey-1-2013:p0762:b004:l007","ordinal":134733,"en":"Turning the black Chinese back,"},{"id":"semetey-1-2013:p0762:b004:l008","ordinal":134734,"en":"Driving them toward Beijing,"},{"id":"semetey-1-2013:p0762:b004:l009","ordinal":134735,"en":"When he traveled six months without rest,"},{"id":"semetey-1-2013:p0762:b004:l010","ordinal":134736,"en":"My lead-boned father"},{"id":"semetey-1-2013:p0762:b004:l011","ordinal":134737,"en":"He carried without fail."},{"id":"semetey-1-2013:p0762:b004:l012","ordinal":134738,"en":"My father, like a towering mountain,"},{"id":"semetey-1-2013:p0762:b004:l013","ordinal":134739,"en":"He bore at a run without faltering."},{"id":"semetey-1-2013:p0762:b004:l014","ordinal":134740,"en":"When my father was about to die,"},{"id":"semetey-1-2013:p0762:b004:l015","ordinal":134741,"en":"About to face Judgment Day,"},{"id":"semetey-1-2013:p0762:b004:l016","ordinal":134742,"en":"Buurul, nearing his fifth year,"},{"id":"semetey-1-2013:p0762:b004:l017","ordinal":134743,"en":"Was tethered beside him."},{"id":"semetey-1-2013:p0762:b004:l018","ordinal":134744,"en":"My precious leopard father"},{"id":"semetey-1-2013:p0762:b004:l019","ordinal":134745,"en":"Found comfort in him there."},{"id":"semetey-1-2013:p0762:b004:l020","ordinal":134746,"en":"Buurul, the horse allotted to me—"},{"id":"semetey-1-2013:p0762:b004:l021","ordinal":134747,"en":"I was asking what had become of him."},{"id":"semetey-1-2013:p0762:b004:l022","ordinal":134748,"en":"At the place where he was tethered,"},{"id":"semetey-1-2013:p0762:b004:l024","ordinal":134749,"en":"That wondrous creature neighed,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0762:b004:l025","ordinal":134750,"en":"Pawed and tore at the earth."},{"id":"semetey-1-2013:p0762:b004:l026","ordinal":134751,"en":"Though an animal, that wondrous creature"},{"id":"semetey-1-2013:p0762:b004:l027","ordinal":134752,"en":"Stood observing mourning."},{"id":"semetey-1-2013:p0762:b004:l028","ordinal":134753,"en":"Where is a Kyrgyz soul in Talas?"},{"id":"semetey-1-2013:p0762:b004:l029","ordinal":134754,"en":"Where is an animal like Buurul?"},{"id":"semetey-1-2013:p0762:b004:l030","ordinal":134755,"en":"Where is this property of mine, where is it?"},{"id":"semetey-1-2013:p0762:b004:l031","ordinal":134756,"en":"Then Abyke said this:"},{"id":"semetey-1-2013:p0762:b004:l032","ordinal":134757,"en":"“My dear orphan,"},{"id":"semetey-1-2013:p0762:b004:l033","ordinal":134758,"en":"What you say is true as well;"},{"id":"semetey-1-2013:p0762:b004:l034","ordinal":134759,"en":"Everything you say is true."},{"id":"semetey-1-2013:p0762:b004:l035","ordinal":134760,"en":"Your noble father Manas—"},{"id":"semetey-1-2013:p0762:b004:l036","ordinal":134761,"en":"What he had, and what he lacked,"},{"id":"semetey-1-2013:p0762:b004:l037","ordinal":134762,"en":"Appeared like an image before my eyes."},{"id":"semetey-1-2013:p0762:b004:l038","ordinal":134763,"en":"Such is this shitty world!"},{"id":"semetey-1-2013:p0762:b004:l039","ordinal":134764,"en":"Sorrow within me, embers without,"},{"id":"semetey-1-2013:p0763:b003:l001","ordinal":134765,"en":"There is no one to heed my words,"},{"id":"semetey-1-2013:p0763:b003:l002","ordinal":134766,"en":"My flowing river and spring,"},{"id":"semetey-1-2013:p0763:b003:l003","ordinal":134767,"en":"My long-awaited darling."},{"id":"semetey-1-2013:p0763:b003:l004","ordinal":134768,"en":"You have sent alive into the grave"},{"id":"semetey-1-2013:p0763:b003:l005","ordinal":134769,"en":"Your uncle Abyke."},{"id":"semetey-1-2013:p0763:b003:l006","ordinal":134770,"en":"Today you showed your fierce courage."},{"id":"semetey-1-2013:p0763:b003:l007","ordinal":134771,"en":"I have withered without dying,"},{"id":"semetey-1-2013:p0763:b003:l008","ordinal":134772,"en":"And you have asked me for Kumaiyk."},{"id":"semetey-1-2013:p0763:b003:l009","ordinal":134773,"en":"The story of Kumaiyk—"},{"id":"semetey-1-2013:p0763:b003:l010","ordinal":134774,"en":"How could I fail to tell it?"},{"id":"semetey-1-2013:p0763:b003:l011","ordinal":134775,"en":"Your father, Khan Manas, the leopard,"},{"id":"semetey-1-2013:p0763:b003:l012","ordinal":134776,"en":"My saint who has passed away,"},{"id":"semetey-1-2013:p0763:b003:l014","ordinal":134777,"en":"At the place where he performed his ablutions,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0763:b003:l015","ordinal":134778,"en":"Kumaiyk was found,"},{"id":"semetey-1-2013:p0763:b003:l016","ordinal":134779,"en":"Encountered through the unseen world."},{"id":"semetey-1-2013:p0763:b003:l017","ordinal":134780,"en":"A blue vulture had borne and left him;"},{"id":"semetey-1-2013:p0763:b003:l018","ordinal":134781,"en":"He was found after three days."},{"id":"semetey-1-2013:p0763:b003:l019","ordinal":134782,"en":"When he took him in his hand and looked,"},{"id":"semetey-1-2013:p0763:b003:l020","ordinal":134783,"en":"Your leopard father, your guardian spirit,"},{"id":"semetey-1-2013:p0763:b003:l021","ordinal":134784,"en":"There was a gray pup the size of a fist."},{"id":"semetey-1-2013:p0763:b003:l022","ordinal":134785,"en":"Manas stood astonished."},{"id":"semetey-1-2013:p0763:b003:l023","ordinal":134786,"en":"“This is truly Kumaiyk,” he said,"},{"id":"semetey-1-2013:p0763:b003:l024","ordinal":134787,"en":"Your uncle Bakay the leopard,"},{"id":"semetey-1-2013:p0763:b003:l025","ordinal":134788,"en":"Having examined Kumaiyk."},{"id":"semetey-1-2013:p0763:b003:l026","ordinal":134789,"en":"Kanykey in Bukhara"},{"id":"semetey-1-2013:p0763:b003:l027","ordinal":134790,"en":"Was a maiden at that time."},{"id":"semetey-1-2013:p0763:b003:l028","ordinal":134791,"en":"He took him and arrived there."},{"id":"semetey-1-2013:p0763:b003:l029","ordinal":134792,"en":"Around Kumaiyk's neck"},{"id":"semetey-1-2013:p0763:b003:l030","ordinal":134793,"en":"She put a collar of steel."},{"id":"semetey-1-2013:p0763:b003:l031","ordinal":134794,"en":"Kanykey beyond measure"},{"id":"semetey-1-2013:p0763:b003:l032","ordinal":134795,"en":"Reared him with boundless care."},{"id":"semetey-1-2013:p0763:b003:l033","ordinal":134796,"en":"Do not ask about Kumaiyk!"},{"id":"semetey-1-2013:p0763:b003:l034","ordinal":134797,"en":"Poor Manas's mighty hunter,"},{"id":"semetey-1-2013:p0763:b003:l035","ordinal":134798,"en":"His bearing surpassed a human's."},{"id":"semetey-1-2013:p0763:b003:l036","ordinal":134799,"en":"Set upon a tiger with a cry of “Attack!”"},{"id":"semetey-1-2013:p0763:b003:l037","ordinal":134800,"en":"He did not flee like a mere dog."},{"id":"semetey-1-2013:p0763:b003:l038","ordinal":134801,"en":"Set upon a bear with a cry of “Attack!”"},{"id":"semetey-1-2013:p0763:b003:l039","ordinal":134802,"en":"He ravaged whatever he bit,"},{"id":"semetey-1-2013:p0763:b005:l001","ordinal":134803,"en":"Making the one who unleashed him laugh."},{"id":"semetey-1-2013:p0763:b005:l002","ordinal":134804,"en":"That Kumaiyk left by Manas,"},{"id":"semetey-1-2013:p0763:b005:l003","ordinal":134805,"en":"When Manas died,"},{"id":"semetey-1-2013:p0763:b005:l004","ordinal":134806,"en":"Would give himself to no one else."},{"id":"semetey-1-2013:p0763:b005:l005","ordinal":134807,"en":"Kumaiyk wasted away,"},{"id":"semetey-1-2013:p0763:b005:l006","ordinal":134808,"en":"Grew weak observing mourning;"},{"id":"semetey-1-2013:p0763:b005:l007","ordinal":134809,"en":"Kumaiyk wasted away."},{"id":"semetey-1-2013:p0763:b005:l008","ordinal":134810,"en":"When Kumaiyk howled,"},{"id":"semetey-1-2013:p0763:b005:l009","ordinal":134811,"en":"When they saw Kumaiyk,"},{"id":"semetey-1-2013:p0763:b005:l010","ordinal":134812,"en":"Living mortals wept."},{"id":"semetey-1-2013:p0763:b005:l011","ordinal":134813,"en":"Huddled like a quail,"},{"id":"semetey-1-2013:p0763:b005:l012","ordinal":134814,"en":"Kumaiyk crouched,"},{"id":"semetey-1-2013:p0763:b005:l013","ordinal":134815,"en":"His eyes filling with tears;"},{"id":"semetey-1-2013:p0763:b005:l014","ordinal":134816,"en":"Kumaiyk shed them."},{"id":"semetey-1-2013:p0763:b005:l015","ordinal":134817,"en":"Your five reckless uncles"},{"id":"semetey-1-2013:p0763:b005:l016","ordinal":134818,"en":"Harbored evil thoughts,"},{"id":"semetey-1-2013:p0763:b005:l017","ordinal":134819,"en":"And fought with the hound:"},{"id":"semetey-1-2013:p0763:b005:l018","ordinal":134820,"en":"“He has no tongue to speak,"},{"id":"semetey-1-2013:p0763:b005:l019","ordinal":134821,"en":"His dog too shall come to no good—"},{"id":"semetey-1-2013:p0763:b005:l020","ordinal":134822,"en":"The hero, fierce Manas—"},{"id":"semetey-1-2013:p0763:b005:l021","ordinal":134823,"en":"It will not be as when he was here,” they said."},{"id":"semetey-1-2013:p0763:b005:l022","ordinal":134824,"en":"Grabbing him by the collar to train him,"},{"id":"semetey-1-2013:p0763:b005:l023","ordinal":134825,"en":"Dragging him under the whip,"},{"id":"semetey-1-2013:p0763:b005:l024","ordinal":134826,"en":"They left him mottled red,"},{"id":"semetey-1-2013:p0763:b005:l025","ordinal":134827,"en":"Gathered round and beat him."},{"id":"semetey-1-2013:p0763:b005:l026","ordinal":134828,"en":"This year his grief filled him within."},{"id":"semetey-1-2013:p0763:b005:l027","ordinal":134829,"en":"On one side, raging at him,"},{"id":"semetey-1-2013:p0763:b005:l028","ordinal":134830,"en":"Akylay turned against him."},{"id":"semetey-1-2013:p0763:b005:l029","ordinal":134831,"en":"The shepherd tormented him;"},{"id":"semetey-1-2013:p0763:b005:l030","ordinal":134832,"en":"The horse-herder beat him."},{"id":"semetey-1-2013:p0763:b005:l031","ordinal":134833,"en":"Kumaiyk, noblest among animals,"},{"id":"semetey-1-2013:p0763:b005:l032","ordinal":134834,"en":"Suffered with his ears flattened."},{"id":"semetey-1-2013:p0763:b005:l033","ordinal":134835,"en":"Kobosh used force against him;"},{"id":"semetey-1-2013:p0763:b005:l034","ordinal":134836,"en":"Akylay tormented him."},{"id":"semetey-1-2013:p0763:b005:l035","ordinal":134837,"en":"When the people moved uphill,"},{"id":"semetey-1-2013:p0763:b005:l036","ordinal":134838,"en":"Hoping he would faint and die,"},{"id":"semetey-1-2013:p0763:b005:l037","ordinal":134839,"en":"They gave him softened lung meat."},{"id":"semetey-1-2013:p0763:b005:l038","ordinal":134840,"en":"When the people moved downhill,"},{"id":"semetey-1-2013:p0763:b005:l039","ordinal":134841,"en":"They husked the barley,"},{"id":"semetey-1-2013:p0764:b003:l001","ordinal":134842,"en":"Taking the barley bran,"},{"id":"semetey-1-2013:p0764:b003:l002","ordinal":134843,"en":"They made it into gruel and gave it to him."},{"id":"semetey-1-2013:p0764:b003:l003","ordinal":134844,"en":"The bran pierced his lungs;"},{"id":"semetey-1-2013:p0764:b003:l004","ordinal":134845,"en":"His matted coat would not fall away,"},{"id":"semetey-1-2013:p0764:b003:l005","ordinal":134846,"en":"And he was left coughing."},{"id":"semetey-1-2013:p0764:b003:l006","ordinal":134847,"en":"Kumaiyk wasted away;"},{"id":"semetey-1-2013:p0764:b003:l007","ordinal":134848,"en":"He came to be called a thief."},{"id":"semetey-1-2013:p0764:b003:l008","ordinal":134849,"en":"That wondrous creature Kumaiyk"},{"id":"semetey-1-2013:p0764:b003:l009","ordinal":134850,"en":"Was given a bad name."},{"id":"semetey-1-2013:p0764:b003:l010","ordinal":134851,"en":"Onto a saddle-shaped ridge"},{"id":"semetey-1-2013:p0764:b003:l011","ordinal":134852,"en":"Kumaiyk climbed,"},{"id":"semetey-1-2013:p0764:b003:l012","ordinal":134853,"en":"And howled for three days."},{"id":"semetey-1-2013:p0764:b003:l013","ordinal":134854,"en":"A wise old man said:"},{"id":"semetey-1-2013:p0764:b003:l014","ordinal":134855,"en":"“Manas's son, the orphan hero,"},{"id":"semetey-1-2013:p0764:b003:l015","ordinal":134856,"en":"Has reached twelve years of age;"},{"id":"semetey-1-2013:p0764:b003:l016","ordinal":134857,"en":"This year his time to come has arrived.”"},{"id":"semetey-1-2013:p0764:b003:l017","ordinal":134858,"en":"Kumaiyk fled in a frenzy;"},{"id":"semetey-1-2013:p0764:b003:l018","ordinal":134859,"en":"Somehow, my orphan, he met you."},{"id":"semetey-1-2013:p0764:b003:l019","ordinal":134860,"en":"Akshumkar, of whom you speak—"},{"id":"semetey-1-2013:p0764:b003:l020","ordinal":134861,"en":"Everything you say is true."},{"id":"semetey-1-2013:p0764:b003:l021","ordinal":134862,"en":"When Manas the leopard died,"},{"id":"semetey-1-2013:p0764:b003:l022","ordinal":134863,"en":"Akshumkar vanished into the unseen."},{"id":"semetey-1-2013:p0764:b003:l023","ordinal":134864,"en":"His desire, in this way,"},{"id":"semetey-1-2013:p0764:b003:l024","ordinal":134865,"en":"Akshumkar had attained."},{"id":"semetey-1-2013:p0764:b003:l025","ordinal":134866,"en":"Since Manas the lion died,"},{"id":"semetey-1-2013:p0764:b003:l026","ordinal":134867,"en":"It has been twelve full years"},{"id":"semetey-1-2013:p0764:b003:l027","ordinal":134868,"en":"Since Akshumkar departed."},{"id":"semetey-1-2013:p0764:b003:l028","ordinal":134869,"en":"This year I learned from those who knew,"},{"id":"semetey-1-2013:p0764:b003:l029","ordinal":134870,"en":"I questioned the herders."},{"id":"semetey-1-2013:p0764:b003:l030","ordinal":134871,"en":"He has surveyed the land,"},{"id":"semetey-1-2013:p0764:b003:l031","ordinal":134872,"en":"And has reached Talas."},{"id":"semetey-1-2013:p0764:b003:l032","ordinal":134873,"en":"On the slope of that mountain,"},{"id":"semetey-1-2013:p0764:b003:l033","ordinal":134874,"en":"On the level place where sakers breed,"},{"id":"semetey-1-2013:p0764:b003:l034","ordinal":134875,"en":"Upon hard rock, the falcon's nest"},{"id":"semetey-1-2013:p0764:b003:l035","ordinal":134876,"en":"He has arrived and built, they say."},{"id":"semetey-1-2013:p0764:b003:l036","ordinal":134877,"en":"That Akshumkar,"},{"id":"semetey-1-2013:p0764:b003:l037","ordinal":134878,"en":"Roaming all the ridges,"},{"id":"semetey-1-2013:p0764:b003:l038","ordinal":134879,"en":"Has blocked the pass, they say."},{"id":"semetey-1-2013:p0764:b003:l039","ordinal":134880,"en":"The passing swans and migrant geese—"},{"id":"semetey-1-2013:p0764:b004:l001","ordinal":134881,"en":"He has wrought fierce slaughter, they say."},{"id":"semetey-1-2013:p0764:b004:l002","ordinal":134882,"en":"Then, along Chech-Tobo,"},{"id":"semetey-1-2013:p0764:b004:l003","ordinal":134883,"en":"He surveyed At-Bashy."},{"id":"semetey-1-2013:p0764:b004:l004","ordinal":134884,"en":"At Chatyr-Kol in Ak-Say,"},{"id":"semetey-1-2013:p0764:b004:l005","ordinal":134885,"en":"The falcon there—"},{"id":"semetey-1-2013:p0764:b004:l006","ordinal":134886,"en":"Akshumkar reached it,"},{"id":"semetey-1-2013:p0764:b004:l007","ordinal":134887,"en":"And they mated."},{"id":"semetey-1-2013:p0764:b004:l008","ordinal":134888,"en":"This year that wondrous creature"},{"id":"semetey-1-2013:p0764:b004:l009","ordinal":134889,"en":"Was heavy with young."},{"id":"semetey-1-2013:p0764:b004:l010","ordinal":134890,"en":"Surveying the cliff of which I spoke,"},{"id":"semetey-1-2013:p0764:b004:l011","ordinal":134891,"en":"It built a spacious nest,"},{"id":"semetey-1-2013:p0764:b004:l012","ordinal":134892,"en":"Laid its brood in winter,"},{"id":"semetey-1-2013:p0764:b004:l013","ordinal":134893,"en":"And left it frozen."},{"id":"semetey-1-2013:p0764:b004:l014","ordinal":134894,"en":"When the days grew long,"},{"id":"semetey-1-2013:p0764:b004:l015","ordinal":134895,"en":"Roaring through the ravines,"},{"id":"semetey-1-2013:p0764:b004:l016","ordinal":134896,"en":"Yellow waters swelled and flowed."},{"id":"semetey-1-2013:p0764:b004:l018","ordinal":134897,"en":"When living creatures thronged,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0764:b004:l019","ordinal":134898,"en":"When the snow slipped away,"},{"id":"semetey-1-2013:p0764:b004:l020","ordinal":134899,"en":"When warmth reached the earth,"},{"id":"semetey-1-2013:p0764:b004:l021","ordinal":134900,"en":"Akshumkar, left by your father,"},{"id":"semetey-1-2013:p0764:b004:l022","ordinal":134901,"en":"Shed its breast feathers, they say."},{"id":"semetey-1-2013:p0764:b004:l023","ordinal":134902,"en":"Brooding for thirty-two days,"},{"id":"semetey-1-2013:p0764:b004:l024","ordinal":134903,"en":"It hatched its eggs, they say."},{"id":"semetey-1-2013:p0764:b004:l026","ordinal":134904,"en":"My dear orphan,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0764:b004:l027","ordinal":134905,"en":"That is property you may take."},{"id":"semetey-1-2013:p0764:b004:l028","ordinal":134906,"en":"Now the young are at the pinfeather stage."},{"id":"semetey-1-2013:p0764:b004:l029","ordinal":134907,"en":"The six keen blades descended from heaven,"},{"id":"semetey-1-2013:p0764:b004:l030","ordinal":134908,"en":"The very finest of swords,"},{"id":"semetey-1-2013:p0764:b004:l031","ordinal":134909,"en":"Zulpukor, left by Manas,"},{"id":"semetey-1-2013:p0764:b004:l032","ordinal":134910,"en":"Khan Bakay's Kylbolot,"},{"id":"semetey-1-2013:p0764:b004:l033","ordinal":134911,"en":"Zhoybolot, which Akybay took,"},{"id":"semetey-1-2013:p0764:b004:l034","ordinal":134912,"en":"Zhoykuma, which Almambet took,"}]
