[{"id":"semetey-1-2013:p1009:b003:l003","ordinal":154113,"en":"From running so hard,"},{"id":"semetey-1-2013:p1009:b003:l004","ordinal":154114,"en":"Felt his senses reel and scatter."},{"id":"semetey-1-2013:p1009:b003:l005","ordinal":154115,"en":"His tail, fine as willow silk,"},{"id":"semetey-1-2013:p1009:b003:l006","ordinal":154116,"en":"Separated into strand after strand"},{"id":"semetey-1-2013:p1009:b003:l007","ordinal":154117,"en":"And streamed behind him."},{"id":"semetey-1-2013:p1009:b003:l008","ordinal":154118,"en":"When visible, Buurul shuddered and flashed;"},{"id":"semetey-1-2013:p1009:b003:l009","ordinal":154119,"en":"When unseen, he billowed like blue smoke."},{"id":"semetey-1-2013:p1009:b003:l010","ordinal":154120,"en":"His mouth gaped wide as a cavern;"},{"id":"semetey-1-2013:p1009:b003:l011","ordinal":154121,"en":"As one watched the courser,"},{"id":"semetey-1-2013:p1009:b003:l012","ordinal":154122,"en":"White foam mingled with blood"},{"id":"semetey-1-2013:p1009:b003:l013","ordinal":154123,"en":"Scattered across his chest."},{"id":"semetey-1-2013:p1009:b003:l014","ordinal":154124,"en":"When he ran down a slope,"},{"id":"semetey-1-2013:p1009:b003:l015","ordinal":154125,"en":"That creature unlike other beasts"},{"id":"semetey-1-2013:p1009:b003:l016","ordinal":154126,"en":"Raced with flying birds."},{"id":"semetey-1-2013:p1009:b003:l017","ordinal":154127,"en":"His four basin-wide hooves,"},{"id":"semetey-1-2013:p1009:b003:l018","ordinal":154128,"en":"Once his flesh grew hot,"},{"id":"semetey-1-2013:p1009:b003:l019","ordinal":154129,"en":"Struck against one another."},{"id":"semetey-1-2013:p1009:b003:l020","ordinal":154130,"en":"Kulchoro upon his back"},{"id":"semetey-1-2013:p1009:b003:l021","ordinal":154131,"en":"Wrestled with the mouth"},{"id":"semetey-1-2013:p1009:b003:l022","ordinal":154132,"en":"Of Buurul standing in the line."},{"id":"semetey-1-2013:p1009:b003:l023","ordinal":154133,"en":"His hands cramped upon the white reins knotted in loops;"},{"id":"semetey-1-2013:p1009:b004:l001","ordinal":154134,"en":"He could not pull them back."},{"id":"semetey-1-2013:p1009:b004:l002","ordinal":154135,"en":"This poor beast was truly born of the unseen"},{"id":"semetey-1-2013:p1009:b004:l003","ordinal":154136,"en":"And had broken into an open run:"},{"id":"semetey-1-2013:p1009:b004:l004","ordinal":154137,"en":"\"Will he go racing headlong?"},{"id":"semetey-1-2013:p1009:b004:l005","ordinal":154138,"en":"If broken, hollow ground appears,"},{"id":"semetey-1-2013:p1009:b004:l006","ordinal":154139,"en":"Will my death come needlessly?"},{"id":"semetey-1-2013:p1009:b004:l007","ordinal":154140,"en":"Is this how my fate will end?"},{"id":"semetey-1-2013:p1009:b004:l008","ordinal":154141,"en":"I have never seen,\" said Kulchoro,"},{"id":"semetey-1-2013:p1009:b004:l009","ordinal":154142,"en":"\"A kinsman like Semetey!\""},{"id":"semetey-1-2013:p1009:b004:l010","ordinal":154143,"en":"He traveled on unable to rein the mouth"},{"id":"semetey-1-2013:p1009:b004:l011","ordinal":154144,"en":"Of the courser restored to fighting condition."},{"id":"semetey-1-2013:p1009:b004:l012","ordinal":154145,"en":"His eyes rolled wildly,"},{"id":"semetey-1-2013:p1009:b004:l013","ordinal":154146,"en":"And his legs dangled loose;"},{"id":"semetey-1-2013:p1009:b004:l014","ordinal":154147,"en":"Struggling against the horse's mouth,"},{"id":"semetey-1-2013:p1009:b004:l015","ordinal":154148,"en":"Kulchoro traveled on"},{"id":"semetey-1-2013:p1009:b004:l016","ordinal":154149,"en":"Clinging to Akkangky."},{"id":"semetey-1-2013:p1009:b004:l017","ordinal":154150,"en":"Struggling for his life,"},{"id":"semetey-1-2013:p1009:b004:l018","ordinal":154151,"en":"Kulchoro grappled fiercely"},{"id":"semetey-1-2013:p1009:b004:l019","ordinal":154152,"en":"With renowned Buurul."},{"id":"semetey-1-2013:p1009:b004:l020","ordinal":154153,"en":"Tall Buurul carried him away"},{"id":"semetey-1-2013:p1009:b004:l021","ordinal":154154,"en":"Into the hollow of Ak-Kyya,"},{"id":"semetey-1-2013:p1009:b004:l022","ordinal":154155,"en":"Then wheeled, descended, and stopped"},{"id":"semetey-1-2013:p1009:b004:l023","ordinal":154156,"en":"Beside Great Urgench."},{"id":"semetey-1-2013:p1009:b006:l001","ordinal":154157,"en":"Looking, the eye could seize nothing;"},{"id":"semetey-1-2013:p1009:b006:l002","ordinal":154158,"en":"The mist-shrouded companion"},{"id":"semetey-1-2013:p1009:b006:l003","ordinal":154159,"en":"Could not tell what lay before him."},{"id":"semetey-1-2013:p1009:b006:l004","ordinal":154160,"en":"For as long as it takes tea to boil,"},{"id":"semetey-1-2013:p1009:b006:l005","ordinal":154161,"en":"Like a person overcome with exhaustion,"},{"id":"semetey-1-2013:p1009:b006:l006","ordinal":154162,"en":"He could not open his streaming eyes,"},{"id":"semetey-1-2013:p1009:b006:l007","ordinal":154163,"en":"Nor properly settle his heart."},{"id":"semetey-1-2013:p1009:b006:l008","ordinal":154164,"en":"As he stood there dumbfounded,"},{"id":"semetey-1-2013:p1009:b006:l009","ordinal":154165,"en":"The high mountains thundered;"},{"id":"semetey-1-2013:p1009:b006:l010","ordinal":154166,"en":"When Choro stopped and looked,"},{"id":"semetey-1-2013:p1009:b008:l001","ordinal":154167,"en":"The birches and poplars"},{"id":"semetey-1-2013:p1009:b008:l002","ordinal":154168,"en":"Roared as though a wind were blowing."},{"id":"semetey-1-2013:p1009:b008:l003","ordinal":154169,"en":"It pounded until the ear went deaf,"},{"id":"semetey-1-2013:p1009:b008:l004","ordinal":154170,"en":"Gathering and rushing with a roar."},{"id":"semetey-1-2013:p1009:b008:l005","ordinal":154171,"en":"Its name was the River Urgench,"},{"id":"semetey-1-2013:p1009:b008:l006","ordinal":154172,"en":"And its surface was foam and vapor."},{"id":"semetey-1-2013:p1009:b008:l007","ordinal":154173,"en":"Overturning and pouring onward,"},{"id":"semetey-1-2013:p1009:b008:l008","ordinal":154174,"en":"When he looked downstream,"},{"id":"semetey-1-2013:p1009:b008:l009","ordinal":154175,"en":"It appeared like four rivers."},{"id":"semetey-1-2013:p1009:b008:l010","ordinal":154176,"en":"It thundered in humps like a camel's back,"},{"id":"semetey-1-2013:p1010:b003:l001","ordinal":154177,"en":"The free body of your lordly companion"},{"id":"semetey-1-2013:p1010:b003:l002","ordinal":154178,"en":"Shuddered and trembled through its length."},{"id":"semetey-1-2013:p1010:b003:l003","ordinal":154179,"en":"The mud rolled like a gray turban;"},{"id":"semetey-1-2013:p1010:b003:l004","ordinal":154180,"en":"Heroic Kulchoro"},{"id":"semetey-1-2013:p1010:b003:l005","ordinal":154181,"en":"Drew back, invoking God."},{"id":"semetey-1-2013:p1010:b003:l006","ordinal":154182,"en":"When he looked at Great Urgench,"},{"id":"semetey-1-2013:p1010:b003:l007","ordinal":154183,"en":"It was filled with spectacle."},{"id":"semetey-1-2013:p1010:b003:l008","ordinal":154184,"en":"It surged and thundered in billows;"},{"id":"semetey-1-2013:p1010:b003:l009","ordinal":154185,"en":"Its middle ran violently fast,"},{"id":"semetey-1-2013:p1010:b003:l010","ordinal":154186,"en":"All its waters flowing together without circling,"},{"id":"semetey-1-2013:p1010:b003:l011","ordinal":154187,"en":"Flowing far greater than a sea."},{"id":"semetey-1-2013:p1010:b003:l012","ordinal":154188,"en":"Its center rushed beyond all measure,"},{"id":"semetey-1-2013:p1010:b003:l013","ordinal":154189,"en":"And avalanche snow flowed at its edges."},{"id":"semetey-1-2013:p1010:b003:l014","ordinal":154190,"en":"The sight opened the heart;"},{"id":"semetey-1-2013:p1010:b003:l015","ordinal":154191,"en":"It appeared like a lake and river together."},{"id":"semetey-1-2013:p1010:b003:l016","ordinal":154192,"en":"If you would see a wonder, see it here:"},{"id":"semetey-1-2013:p1010:b003:l017","ordinal":154193,"en":"Young firs and pines"},{"id":"semetey-1-2013:p1010:b003:l018","ordinal":154194,"en":"Were torn out by their roots,"},{"id":"semetey-1-2013:p1010:b003:l019","ordinal":154195,"en":"Struck against the bank,"},{"id":"semetey-1-2013:p1010:b003:l020","ordinal":154196,"en":"And stripped the cliffside bare."},{"id":"semetey-1-2013:p1010:b003:l021","ordinal":154197,"en":"Watching it, Kulchoro"},{"id":"semetey-1-2013:p1010:b003:l022","ordinal":154198,"en":"Felt his whole age shrivel."},{"id":"semetey-1-2013:p1010:b003:l023","ordinal":154199,"en":"Every gully and slope was flushed red;"},{"id":"semetey-1-2013:p1010:b003:l024","ordinal":154200,"en":"Crosscurrents strong enough to sweep away horses"},{"id":"semetey-1-2013:p1010:b003:l025","ordinal":154201,"en":"Spurted from every place,"},{"id":"semetey-1-2013:p1010:b003:l026","ordinal":154202,"en":"Joining in a thousand channels."},{"id":"semetey-1-2013:p1010:b003:l027","ordinal":154203,"en":"Pines and rafts swept along,"},{"id":"semetey-1-2013:p1010:b003:l028","ordinal":154204,"en":"And birches and willows floated;"},{"id":"semetey-1-2013:p1010:b003:l029","ordinal":154205,"en":"They gathered into a flood"},{"id":"semetey-1-2013:p1010:b003:l030","ordinal":154206,"en":"And struck against every bank."},{"id":"semetey-1-2013:p1010:b003:l031","ordinal":154207,"en":"The companion watching it cried,"},{"id":"semetey-1-2013:p1010:b003:l032","ordinal":154208,"en":"\"May God preserve me!\""},{"id":"semetey-1-2013:p1010:b003:l033","ordinal":154209,"en":"Far from being able to cross it then,"},{"id":"semetey-1-2013:p1010:b003:l034","ordinal":154210,"en":"His whole age shriveled."},{"id":"semetey-1-2013:p1010:b003:l035","ordinal":154211,"en":"Foam fluttered upon its surface;"},{"id":"semetey-1-2013:p1010:b003:l036","ordinal":154212,"en":"House-sized stones from its bed"},{"id":"semetey-1-2013:p1010:b003:l037","ordinal":154213,"en":"All rolled onward with a clatter."},{"id":"semetey-1-2013:p1010:b003:l038","ordinal":154214,"en":"It gathered force like the cuckoo's call;"},{"id":"semetey-1-2013:p1010:b003:l039","ordinal":154215,"en":"Great Urgench rushed and roared,"},{"id":"semetey-1-2013:p1010:b004:l001","ordinal":154216,"en":"Taking on countless different forms."},{"id":"semetey-1-2013:p1010:b004:l002","ordinal":154217,"en":"The earth split and cliffs collapsed,"},{"id":"semetey-1-2013:p1010:b004:l003","ordinal":154218,"en":"And all the water turned to mud."},{"id":"semetey-1-2013:p1010:b004:l004","ordinal":154219,"en":"Kulchoro, watching,"},{"id":"semetey-1-2013:p1010:b004:l005","ordinal":154220,"en":"Clutched his collar and invoked God."},{"id":"semetey-1-2013:p1010:b004:l006","ordinal":154221,"en":"A gray roll of mud as large as a house"},{"id":"semetey-1-2013:p1010:b004:l007","ordinal":154222,"en":"Fell in and churned away;"},{"id":"semetey-1-2013:p1010:b004:l008","ordinal":154223,"en":"Kulchoro watched closely,"},{"id":"semetey-1-2013:p1010:b004:l009","ordinal":154224,"en":"And his whole age shriveled."},{"id":"semetey-1-2013:p1010:b004:l010","ordinal":154225,"en":"If he cast a bridle into the rebounding foam"},{"id":"semetey-1-2013:p1010:b004:l011","ordinal":154226,"en":"That flowed along its edge, it could not touch bottom;"},{"id":"semetey-1-2013:p1010:b004:l012","ordinal":154227,"en":"Even a swift fox could not range across it."},{"id":"semetey-1-2013:p1010:b004:l013","ordinal":154228,"en":"Kulchoro did not think,"},{"id":"semetey-1-2013:p1010:b004:l014","ordinal":154229,"en":"\"I shall reach the farther bank.\""},{"id":"semetey-1-2013:p1010:b004:l015","ordinal":154230,"en":"If he cast a rope into the foam"},{"id":"semetey-1-2013:p1010:b004:l016","ordinal":154231,"en":"Kicked upward by the torrent, it could not touch bottom;"},{"id":"semetey-1-2013:p1010:b004:l017","ordinal":154232,"en":"Even a fox could not range its high banks."},{"id":"semetey-1-2013:p1010:b004:l018","ordinal":154233,"en":"From the force of Urgench"},{"id":"semetey-1-2013:p1010:b004:l019","ordinal":154234,"en":"A roaring windstorm blew."},{"id":"semetey-1-2013:p1010:b004:l020","ordinal":154235,"en":"Birches and willows, roots and all,"},{"id":"semetey-1-2013:p1010:b004:l021","ordinal":154236,"en":"Swept past in a thundering mass."},{"id":"semetey-1-2013:p1010:b004:l022","ordinal":154237,"en":"A person saying, \"I shall cross\"—"},{"id":"semetey-1-2013:p1010:b004:l023","ordinal":154238,"en":"It would reach up to his kidneys"},{"id":"semetey-1-2013:p1010:b004:l024","ordinal":154239,"en":"If this flood struck him,"},{"id":"semetey-1-2013:p1010:b004:l025","ordinal":154240,"en":"It would tear him limb from limb."},{"id":"semetey-1-2013:p1010:b004:l026","ordinal":154241,"en":"All the glaciers had broken apart"},{"id":"semetey-1-2013:p1010:b004:l027","ordinal":154242,"en":"And poured down in an altered flood."},{"id":"semetey-1-2013:p1010:b004:l028","ordinal":154243,"en":"Spreading wide, flowing, and spilling,"},{"id":"semetey-1-2013:p1010:b004:l029","ordinal":154244,"en":"When one looked at Great Urgench,"},{"id":"semetey-1-2013:p1010:b004:l030","ordinal":154245,"en":"To the companion standing there"},{"id":"semetey-1-2013:p1010:b004:l031","ordinal":154246,"en":"It appeared like a devouring beast."},{"id":"semetey-1-2013:p1010:b004:l032","ordinal":154247,"en":"Urgench had entered flood like this"},{"id":"semetey-1-2013:p1010:b004:l033","ordinal":154248,"en":"Because your discerning sister-in-law Churok,"},{"id":"semetey-1-2013:p1010:b004:l034","ordinal":154249,"en":"That troublesome poor woman,"},{"id":"semetey-1-2013:p1010:b004:l035","ordinal":154250,"en":"Knew that her lord would come."},{"id":"semetey-1-2013:p1010:b004:l036","ordinal":154251,"en":"\"If that gray wolf is a hero,"},{"id":"semetey-1-2013:p1010:b004:l037","ordinal":154252,"en":"Let him ride forward and cross the water;"},{"id":"semetey-1-2013:p1010:b004:l038","ordinal":154253,"en":"If he is a coward, let him falter"},{"id":"semetey-1-2013:p1010:b004:l039","ordinal":154254,"en":"And flee back the way he came,\""},{"id":"semetey-1-2013:p1011:b003:l001","ordinal":154255,"en":"Of poor Kozho and Toltoy—"},{"id":"semetey-1-2013:p1011:b003:l002","ordinal":154256,"en":"If Semetey possesses their courage,"},{"id":"semetey-1-2013:p1011:b003:l003","ordinal":154257,"en":"Let him pursue the matter to its end;"},{"id":"semetey-1-2013:p1011:b003:l004","ordinal":154258,"en":"If Semetey lacks courage,"},{"id":"semetey-1-2013:p1011:b003:l005","ordinal":154259,"en":"Let him turn back"},{"id":"semetey-1-2013:p1011:b003:l006","ordinal":154260,"en":"From this flowing river.\""},{"id":"semetey-1-2013:p1011:b003:l007","ordinal":154261,"en":"Pondering every kind of scheme,"},{"id":"semetey-1-2013:p1011:b003:l008","ordinal":154262,"en":"To test his heroism"},{"id":"semetey-1-2013:p1011:b003:l009","ordinal":154263,"en":"And take her vengeance"},{"id":"semetey-1-2013:p1011:b003:l010","ordinal":154264,"en":"Still unspent upon Chynkojo and Toltoy,"},{"id":"semetey-1-2013:p1011:b003:l011","ordinal":154265,"en":"She read words in Arabic"},{"id":"semetey-1-2013:p1011:b003:l012","ordinal":154266,"en":"And cast a spell upon the weather."},{"id":"semetey-1-2013:p1011:b003:l013","ordinal":154267,"en":"All the glaciers broke apart,"},{"id":"semetey-1-2013:p1011:b003:l014","ordinal":154268,"en":"And springs overflowed and streamed;"},{"id":"semetey-1-2013:p1011:b003:l015","ordinal":154269,"en":"Hail fell across all the uplands,"},{"id":"semetey-1-2013:p1011:b003:l016","ordinal":154270,"en":"And rain across the riverlands;"},{"id":"semetey-1-2013:p1011:b003:l017","ordinal":154271,"en":"Every slope ran red,"},{"id":"semetey-1-2013:p1011:b003:l018","ordinal":154272,"en":"And pale water flowing from the heights"},{"id":"semetey-1-2013:p1011:b003:l019","ordinal":154273,"en":"Joined from every direction."},{"id":"semetey-1-2013:p1011:b003:l020","ordinal":154274,"en":"It flowed black and filthy,"},{"id":"semetey-1-2013:p1011:b003:l021","ordinal":154275,"en":"Filling the gorge as one body."},{"id":"semetey-1-2013:p1011:b003:l022","ordinal":154276,"en":"Because of Churok,"},{"id":"semetey-1-2013:p1011:b003:l023","ordinal":154277,"en":"It ran muddy and stinking of dung,"},{"id":"semetey-1-2013:p1011:b003:l024","ordinal":154278,"en":"Entering a flood no one could withstand."},{"id":"semetey-1-2013:p1011:b003:l025","ordinal":154279,"en":"Those who saw it invoked God;"},{"id":"semetey-1-2013:p1011:b003:l026","ordinal":154280,"en":"Its foam heaved and divided,"},{"id":"semetey-1-2013:p1011:b003:l027","ordinal":154281,"en":"And to the companion watching"},{"id":"semetey-1-2013:p1011:b003:l028","ordinal":154282,"en":"It appeared like a devouring beast."},{"id":"semetey-1-2013:p1011:b003:l029","ordinal":154283,"en":"Kulchoro, who had never seen such water,"},{"id":"semetey-1-2013:p1011:b003:l030","ordinal":154284,"en":"Grieved at the sight of it."},{"id":"semetey-1-2013:p1011:b003:l031","ordinal":154285,"en":"When he saw Great Urgench,"},{"id":"semetey-1-2013:p1011:b003:l032","ordinal":154286,"en":"The poor hero stood in terror,"},{"id":"semetey-1-2013:p1011:b003:l033","ordinal":154287,"en":"Despairing of his borrowed life:"},{"id":"semetey-1-2013:p1011:b003:l034","ordinal":154288,"en":"\"Does one who crosses this Urgench"},{"id":"semetey-1-2013:p1011:b003:l035","ordinal":154289,"en":"Not die in terrible distress,"},{"id":"semetey-1-2013:p1011:b003:l036","ordinal":154290,"en":"And behold the face of Judgment Day?"},{"id":"semetey-1-2013:p1011:b003:l037","ordinal":154291,"en":"Does one who crosses ever turn back?"},{"id":"semetey-1-2013:p1011:b003:l038","ordinal":154292,"en":"Does one who meets it return alive?"},{"id":"semetey-1-2013:p1011:b003:l039","ordinal":154293,"en":"It is water like a devouring beast."},{"id":"semetey-1-2013:p1011:b005:l001","ordinal":154294,"en":"I shall return to my elder Semetey"},{"id":"semetey-1-2013:p1011:b005:l002","ordinal":154295,"en":"And tell my elder"},{"id":"semetey-1-2013:p1011:b005:l003","ordinal":154296,"en":"That its waters are too fierce.\""},{"id":"semetey-1-2013:p1011:b005:l004","ordinal":154297,"en":"Kulchoro wheeled about"},{"id":"semetey-1-2013:p1011:b005:l005","ordinal":154298,"en":"And now turned Buurul's head;"},{"id":"semetey-1-2013:p1011:b005:l006","ordinal":154299,"en":"He turned and stood examining"},{"id":"semetey-1-2013:p1011:b005:l007","ordinal":154300,"en":"The land and water of this Urgench."},{"id":"semetey-1-2013:p1011:b005:l008","ordinal":154301,"en":"Ah, that creature, Great Urgench:"},{"id":"semetey-1-2013:p1011:b005:l009","ordinal":154302,"en":"Its leaves were broad as leather,"},{"id":"semetey-1-2013:p1011:b005:l010","ordinal":154303,"en":"Its black beetles thick as thumbs,"},{"id":"semetey-1-2013:p1011:b005:l011","ordinal":154304,"en":"Its lizards like snakes,"},{"id":"semetey-1-2013:p1011:b005:l012","ordinal":154305,"en":"And its snakes like ropes seven fathoms long."},{"id":"semetey-1-2013:p1011:b005:l013","ordinal":154306,"en":"Almighty God in his power"},{"id":"semetey-1-2013:p1011:b005:l014","ordinal":154307,"en":"Creates living souls of every kind."},{"id":"semetey-1-2013:p1011:b005:l015","ordinal":154308,"en":"Its saplings were like plane trees,"},{"id":"semetey-1-2013:p1011:b005:l016","ordinal":154309,"en":"Its small birds like snowcocks,"},{"id":"semetey-1-2013:p1011:b005:l017","ordinal":154310,"en":"And its hogweed stalks thick as forearms;"},{"id":"semetey-1-2013:p1011:b005:l018","ordinal":154311,"en":"When you looked at its red deer,"},{"id":"semetey-1-2013:p1011:b005:l019","ordinal":154312,"en":"They were like pale, white-faced cows."},{"id":"semetey-1-2013:p1011:b005:l020","ordinal":154313,"en":"It was a broad and tranquil land,"},{"id":"semetey-1-2013:p1011:b005:l021","ordinal":154314,"en":"Its apples ripening until they became compost,"},{"id":"semetey-1-2013:p1011:b005:l022","ordinal":154315,"en":"A place of wonders of every kind."},{"id":"semetey-1-2013:p1011:b005:l023","ordinal":154316,"en":"Kulchoro stood astonished;"},{"id":"semetey-1-2013:p1011:b005:l024","ordinal":154317,"en":"When he looked toward the farther bank,"},{"id":"semetey-1-2013:p1011:b005:l025","ordinal":154318,"en":"Thirty daughters-in-law and thirty maidens"},{"id":"semetey-1-2013:p1011:b005:l026","ordinal":154319,"en":"Were there beginning their games."},{"id":"semetey-1-2013:p1011:b005:l027","ordinal":154320,"en":"In their midst Aychurok"},{"id":"semetey-1-2013:p1011:b005:l028","ordinal":154321,"en":"Flashed like a poppy."},{"id":"semetey-1-2013:p1011:b005:l029","ordinal":154322,"en":"The fitted coat and fine dress"},{"id":"semetey-1-2013:p1011:b005:l030","ordinal":154323,"en":"Of the poor, formidable beauty"},{"id":"semetey-1-2013:p1011:b005:l031","ordinal":154324,"en":"Showed their hems billowing."},{"id":"semetey-1-2013:p1011:b005:l032","ordinal":154325,"en":"Aychurok, daughter of Akun,"},{"id":"semetey-1-2013:p1011:b005:l033","ordinal":154326,"en":"Wore a skullcap made of gold;"},{"id":"semetey-1-2013:p1011:b005:l034","ordinal":154327,"en":"She appeared worth the whole world,"},{"id":"semetey-1-2013:p1011:b005:l035","ordinal":154328,"en":"That poor daughter of Akun."},{"id":"semetey-1-2013:p1011:b005:l036","ordinal":154329,"en":"Of moon-beautiful Churok,"},{"id":"semetey-1-2013:p1011:b005:l037","ordinal":154330,"en":"Which enchantment shall we tell?"},{"id":"semetey-1-2013:p1011:b005:l038","ordinal":154331,"en":"When snow falls upon black earth,"},{"id":"semetey-1-2013:p1011:b005:l039","ordinal":154332,"en":"Look at the snow, and you see her flesh;"},{"id":"semetey-1-2013:p1012:b003:l001","ordinal":154333,"en":"When blood falls upon snow,"},{"id":"semetey-1-2013:p1012:b003:l002","ordinal":154334,"en":"Look at the blood, and you see her face;"},{"id":"semetey-1-2013:p1012:b003:l003","ordinal":154335,"en":"Look at sugar, and you hear her speech;"},{"id":"semetey-1-2013:p1012:b003:l004","ordinal":154336,"en":"Look at the morning star, and you see her eyes."},{"id":"semetey-1-2013:p1012:b003:l005","ordinal":154337,"en":"Her waist was sheath-slender, her face moon-bright,"},{"id":"semetey-1-2013:p1012:b003:l006","ordinal":154338,"en":"That renowned beauty, poor woman."},{"id":"semetey-1-2013:p1012:b003:l007","ordinal":154339,"en":"She stepped forward in radiance;"},{"id":"semetey-1-2013:p1012:b003:l008","ordinal":154340,"en":"A little gold-covered amulet"},{"id":"semetey-1-2013:p1012:b003:l009","ordinal":154341,"en":"Floated upon her breast."},{"id":"semetey-1-2013:p1012:b003:l010","ordinal":154342,"en":"Maidens and daughters-in-law stood together;"},{"id":"semetey-1-2013:p1012:b003:l011","ordinal":154343,"en":"Mighty Churok among them"},{"id":"semetey-1-2013:p1012:b003:l012","ordinal":154344,"en":"Made merry."},{"id":"semetey-1-2013:p1012:b003:l013","ordinal":154345,"en":"Her laughter made the sun set,"},{"id":"semetey-1-2013:p1012:b003:l014","ordinal":154346,"en":"And her revelry brought the dawn."},{"id":"semetey-1-2013:p1012:b003:l015","ordinal":154347,"en":"Behind the swing"},{"id":"semetey-1-2013:p1012:b003:l016","ordinal":154348,"en":"They played the game of Shabyyat;"},{"id":"semetey-1-2013:p1012:b003:l017","ordinal":154349,"en":"Maidens and daughters-in-law mingled"},{"id":"semetey-1-2013:p1012:b003:l018","ordinal":154350,"en":"And played in growing excitement."},{"id":"semetey-1-2013:p1012:b003:l019","ordinal":154351,"en":"Among the daughters-in-law was Kermekash,"},{"id":"semetey-1-2013:p1012:b003:l020","ordinal":154352,"en":"And eloquent beauty Karachach;"},{"id":"semetey-1-2013:p1012:b003:l021","ordinal":154353,"en":"At the head of the maidens was Kynymjan,"},{"id":"semetey-1-2013:p1012:b003:l022","ordinal":154354,"en":"And formidable beauty Tynymkan."},{"id":"semetey-1-2013:p1012:b003:l023","ordinal":154355,"en":"There was Sugalak of the irrigator,"},{"id":"semetey-1-2013:p1012:b003:l024","ordinal":154356,"en":"Among those maidens,"},{"id":"semetey-1-2013:p1012:b003:l025","ordinal":154357,"en":"And Birmoyun of the grain grower;"},{"id":"semetey-1-2013:p1012:b003:l026","ordinal":154358,"en":"Thimble-mouthed Oyumkan,"},{"id":"semetey-1-2013:p1012:b003:l027","ordinal":154359,"en":"And among all those maidens,"},{"id":"semetey-1-2013:p1012:b003:l028","ordinal":154360,"en":"Proudly pacing Kanymjan;"},{"id":"semetey-1-2013:p1012:b003:l029","ordinal":154361,"en":"Camel-calf-eyed Bolpokan,"},{"id":"semetey-1-2013:p1012:b003:l030","ordinal":154362,"en":"And incomparable beauty Kanymjan."},{"id":"semetey-1-2013:p1012:b003:l031","ordinal":154363,"en":"Your sister-in-law with her matched companions"},{"id":"semetey-1-2013:p1012:b003:l032","ordinal":154364,"en":"Placed her arm around Kolkunay;"},{"id":"semetey-1-2013:p1012:b003:l033","ordinal":154365,"en":"Altynay sang laments beside her,"},{"id":"semetey-1-2013:p1012:b003:l034","ordinal":154366,"en":"And Kermekash shared her counsel;"},{"id":"semetey-1-2013:p1012:b003:l035","ordinal":154367,"en":"They walked with stately bearing,"},{"id":"semetey-1-2013:p1012:b003:l036","ordinal":154368,"en":"With eloquent beauty Karakash."}]
