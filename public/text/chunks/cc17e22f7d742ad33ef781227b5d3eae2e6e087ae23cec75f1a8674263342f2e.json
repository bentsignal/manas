[{"id":"seytek-2012:p0113:b003:l023","ordinal":301569,"en":"Subduing whoever challenged him,"},{"id":"seytek-2012:p0113:b003:l024","ordinal":301570,"en":"Bringing disaster upon whoever fought him,"},{"id":"seytek-2012:p0113:b003:l025","ordinal":301571,"en":"Throwing all who saw him into tumult—"},{"id":"seytek-2012:p0113:b003:l026","ordinal":301572,"en":"Such havoc he seemed destined to wreak."},{"id":"seytek-2012:p0113:b003:l027","ordinal":301573,"en":"Not merely Kyyaz, but all the peoples,"},{"id":"seytek-2012:p0113:b003:l028","ordinal":301574,"en":"The Chinese host and the hosts of Rum,"},{"id":"seytek-2012:p0113:b003:l029","ordinal":301575,"en":"He looked destined to conquer."},{"id":"seytek-2012:p0113:b003:l030","ordinal":301576,"en":"Upon his enemies, he looked destined"},{"id":"seytek-2012:p0113:b003:l031","ordinal":301577,"en":"To cast terror and turmoil."},{"id":"seytek-2012:p0113:b003:l032","ordinal":301578,"en":"He crouched like a lion;"},{"id":"seytek-2012:p0113:b003:l033","ordinal":301579,"en":"If he faced those who came to blows with him,"},{"id":"seytek-2012:p0113:b003:l034","ordinal":301580,"en":"He looked ready to slaughter them all."},{"id":"seytek-2012:p0113:b003:l035","ordinal":301581,"en":"His broad ears were like shields,"},{"id":"seytek-2012:p0113:b003:l036","ordinal":301582,"en":"His bright eyes like morning stars—"},{"id":"seytek-2012:p0113:b003:l037","ordinal":301583,"en":"Would any mortal dare face him?"},{"id":"seytek-2012:p0113:b003:l038","ordinal":301584,"en":"Against the hero’s son,"},{"id":"seytek-2012:p0113:b003:l039","ordinal":301585,"en":"Could anyone who faced him remain alive?"},{"id":"seytek-2012:p0113:b003:l040","ordinal":301586,"en":"His body was straight as a plane tree."},{"id":"seytek-2012:p0114:b002:l001","ordinal":301587,"en":"Like a spring flowing from a ravine,"},{"id":"seytek-2012:p0114:b002:l002","ordinal":301588,"en":"They stood face-to-face."},{"id":"seytek-2012:p0114:b002:l003","ordinal":301589,"en":"Overcome with love and yearning,"},{"id":"seytek-2012:p0114:b002:l004","ordinal":301590,"en":"They melted into one another."},{"id":"seytek-2012:p0114:b002:l005","ordinal":301591,"en":"Any mortal who saw them rejoiced"},{"id":"seytek-2012:p0114:b002:l006","ordinal":301592,"en":"As they swayed together like molten silver."},{"id":"seytek-2012:p0114:b002:l007","ordinal":301593,"en":"With a cry like a lion,"},{"id":"seytek-2012:p0114:b002:l008","ordinal":301594,"en":"He pressed the boy to his breast, sobbing;"},{"id":"seytek-2012:p0114:b002:l009","ordinal":301595,"en":"Külchoro’s head and limbs"},{"id":"seytek-2012:p0114:b002:l010","ordinal":301596,"en":"Shook as he wailed."},{"id":"seytek-2012:p0114:b002:l011","ordinal":301597,"en":"“Are you the vision for which I prayed?"},{"id":"seytek-2012:p0114:b002:l012","ordinal":301598,"en":"Are you the plane tree left by my elder?"},{"id":"seytek-2012:p0114:b002:l013","ordinal":301599,"en":"You are all the vengeance left by the hero,"},{"id":"seytek-2012:p0114:b002:l014","ordinal":301600,"en":"The mirror left by my lord."},{"id":"seytek-2012:p0114:b002:l015","ordinal":301601,"en":"Your elder has withered away like this,"},{"id":"seytek-2012:p0114:b002:l016","ordinal":301602,"en":"Passing his days in servitude,"},{"id":"seytek-2012:p0114:b002:l017","ordinal":301603,"en":"Drinking water through a reed."},{"id":"seytek-2012:p0114:b002:l018","ordinal":301604,"en":"I longed to die but could not die,"},{"id":"seytek-2012:p0114:b002:l019","ordinal":301605,"en":"Could not take my own life,"},{"id":"seytek-2012:p0114:b002:l020","ordinal":301606,"en":"Could not bring death upon myself."},{"id":"seytek-2012:p0114:b002:l021","ordinal":301607,"en":"When my hapless head endured"},{"id":"seytek-2012:p0114:b002:l022","ordinal":301608,"en":"True misery and deepest humiliation,"},{"id":"seytek-2012:p0114:b002:l023","ordinal":301609,"en":"I wandered long, burning and tormented."},{"id":"seytek-2012:p0114:b002:l024","ordinal":301610,"en":"My treasure left by my lord,"},{"id":"seytek-2012:p0114:b002:l025","ordinal":301611,"en":"How long I have yearned to see you!"},{"id":"seytek-2012:p0114:b002:l026","ordinal":301612,"en":"In my black, collared felt cloak,"},{"id":"seytek-2012:p0114:b002:l027","ordinal":301613,"en":"When I went apart to gather firewood,"},{"id":"seytek-2012:p0114:b002:l028","ordinal":301614,"en":"I met only suffering."},{"id":"seytek-2012:p0114:b002:l029","ordinal":301615,"en":"Abandoned to the enemy’s scorn,"},{"id":"seytek-2012:p0114:b002:l030","ordinal":301616,"en":"The great ditch I dug became my lot;"},{"id":"seytek-2012:p0114:b002:l031","ordinal":301617,"en":"Your elder grieved and was disgraced."},{"id":"seytek-2012:p0114:b002:l032","ordinal":301618,"en":"Though I sobbed, God would not take me;"},{"id":"seytek-2012:p0114:b002:l033","ordinal":301619,"en":"This ruined soul cried aloud,"},{"id":"seytek-2012:p0114:b002:l034","ordinal":301620,"en":"Unable even to walk by himself."},{"id":"seytek-2012:p0114:b002:l035","ordinal":301621,"en":"If I would enter the earth, the ground was hard;"},{"id":"seytek-2012:p0114:b002:l036","ordinal":301622,"en":"If I would die, life was sweet."},{"id":"seytek-2012:p0114:b002:l037","ordinal":301623,"en":"Neither dying nor vanishing, I lived on,"},{"id":"seytek-2012:p0114:b002:l038","ordinal":301624,"en":"Wondering what I should do."},{"id":"seytek-2012:p0114:b002:l039","ordinal":301625,"en":"I lived in hope of seeing"},{"id":"seytek-2012:p0114:b002:l040","ordinal":301626,"en":"Even a glimpse of the boy.”"},{"id":"seytek-2012:p0114:b003:l001","ordinal":301627,"en":"His whole being dissolved,"},{"id":"seytek-2012:p0114:b003:l002","ordinal":301628,"en":"His flesh and sinews stretched with yearning;"},{"id":"seytek-2012:p0114:b003:l003","ordinal":301629,"en":"His heart became burning embers,"},{"id":"seytek-2012:p0114:b003:l004","ordinal":301630,"en":"As though his extinguished fire had kindled anew."},{"id":"seytek-2012:p0114:b003:l005","ordinal":301631,"en":"His dying soul revived,"},{"id":"seytek-2012:p0114:b003:l006","ordinal":301632,"en":"As though God had fulfilled his wish,"},{"id":"seytek-2012:p0114:b003:l007","ordinal":301633,"en":"As though the vanished Semetey"},{"id":"seytek-2012:p0114:b003:l008","ordinal":301634,"en":"Had returned alive that very day."},{"id":"seytek-2012:p0114:b003:l009","ordinal":301635,"en":"The wretched Choro’s"},{"id":"seytek-2012:p0114:b003:l010","ordinal":301636,"en":"Pale face softened;"},{"id":"seytek-2012:p0114:b003:l011","ordinal":301637,"en":"Tears flowing from both eyes"},{"id":"seytek-2012:p0114:b003:l012","ordinal":301638,"en":"Poured down his chest."},{"id":"seytek-2012:p0114:b003:l013","ordinal":301639,"en":"The sorrowful ones met,"},{"id":"seytek-2012:p0114:b003:l014","ordinal":301640,"en":"Their hearts burning and dissolving;"},{"id":"seytek-2012:p0114:b003:l015","ordinal":301641,"en":"The lost were found,"},{"id":"seytek-2012:p0114:b003:l016","ordinal":301642,"en":"And the ill-fated Choro’s"},{"id":"seytek-2012:p0114:b003:l017","ordinal":301643,"en":"Honor was restored that day."},{"id":"seytek-2012:p0114:b003:l018","ordinal":301644,"en":"When he saw the boy,"},{"id":"seytek-2012:p0114:b003:l019","ordinal":301645,"en":"How could Külchoro not burn with feeling?"},{"id":"seytek-2012:p0114:b003:l020","ordinal":301646,"en":"Tears streaming down both cheeks"},{"id":"seytek-2012:p0114:b003:l021","ordinal":301647,"en":"Fell upon his chest."},{"id":"seytek-2012:p0114:b003:l022","ordinal":301648,"en":"He wailed with such a cry"},{"id":"seytek-2012:p0114:b003:l023","ordinal":301649,"en":"That his voice reached God;"},{"id":"seytek-2012:p0114:b003:l024","ordinal":301650,"en":"Overcome with anguish, Külchoro"},{"id":"seytek-2012:p0114:b003:l025","ordinal":301651,"en":"Fell upon the boy and embraced him."},{"id":"seytek-2012:p0114:b003:l026","ordinal":301652,"en":"Holding him close, Külchoro"},{"id":"seytek-2012:p0114:b003:l027","ordinal":301653,"en":"Stood weeping with piercing cries."},{"id":"seytek-2012:p0114:b003:l028","ordinal":301654,"en":"Pressing the orphan to his breast,"},{"id":"seytek-2012:p0114:b003:l029","ordinal":301655,"en":"He stood sobbing bitterly."},{"id":"seytek-2012:p0114:b003:l030","ordinal":301656,"en":"As Külchoro held him,"},{"id":"seytek-2012:p0114:b003:l031","ordinal":301657,"en":"The birch wept, the willow wept,"},{"id":"seytek-2012:p0114:b003:l032","ordinal":301658,"en":"And every watching soul wept."},{"id":"seytek-2012:p0114:b003:l033","ordinal":301659,"en":"All those many people cried,"},{"id":"seytek-2012:p0114:b003:l034","ordinal":301660,"en":"Consumed by their own grief;"},{"id":"seytek-2012:p0114:b003:l035","ordinal":301661,"en":"They wept, saying that when misery befalls a hero,"},{"id":"seytek-2012:p0114:b003:l036","ordinal":301662,"en":"This is how it must be."},{"id":"seytek-2012:p0114:b003:l037","ordinal":301663,"en":"Like elder and younger brothers reunited,"},{"id":"seytek-2012:p0114:b003:l038","ordinal":301664,"en":"They stood mingled together;"},{"id":"seytek-2012:p0114:b003:l039","ordinal":301665,"en":"Like the hair of a white gazelle,"},{"id":"seytek-2012:p0114:b003:l040","ordinal":301666,"en":"They stood drawn close together."},{"id":"seytek-2012:p0115:b002:l001","ordinal":301667,"en":"Deprived of my swift steed,"},{"id":"seytek-2012:p0115:b002:l002","ordinal":301668,"en":"I came back a clumsy wretch."},{"id":"seytek-2012:p0115:b002:l003","ordinal":301669,"en":"Deprived of flowing mane and tail,"},{"id":"seytek-2012:p0115:b002:l004","ordinal":301670,"en":"I came back dull and broken."},{"id":"seytek-2012:p0115:b002:l005","ordinal":301671,"en":"My two eyes gouged out,"},{"id":"seytek-2012:p0115:b002:l006","ordinal":301672,"en":"My two shoulders flayed,"},{"id":"seytek-2012:p0115:b002:l007","ordinal":301673,"en":"Captured and grieving,"},{"id":"seytek-2012:p0115:b002:l008","ordinal":301674,"en":"Parted from my beloved,"},{"id":"seytek-2012:p0115:b002:l009","ordinal":301675,"en":"With every spirit beaten from me,"},{"id":"seytek-2012:p0115:b002:l010","ordinal":301676,"en":"I came back meek as a mullah."},{"id":"seytek-2012:p0115:b002:l011","ordinal":301677,"en":"Captured and disgraced,"},{"id":"seytek-2012:p0115:b002:l012","ordinal":301678,"en":"My days passing in humiliation,"},{"id":"seytek-2012:p0115:b002:l013","ordinal":301679,"en":"I came back reduced to a pacing nag."},{"id":"seytek-2012:p0115:b002:l014","ordinal":301680,"en":"My hands bound, my eyes staring,"},{"id":"seytek-2012:p0115:b002:l015","ordinal":301681,"en":"I came back trapped in a net."},{"id":"seytek-2012:p0115:b002:l016","ordinal":301682,"en":"From a place no man could escape,"},{"id":"seytek-2012:p0115:b002:l017","ordinal":301683,"en":"I came back as from a fortress."},{"id":"seytek-2012:p0115:b002:l018","ordinal":301684,"en":"To the infidel in his full strength,"},{"id":"seytek-2012:p0115:b002:l019","ordinal":301685,"en":"To mighty hero Kyyaz,"},{"id":"seytek-2012:p0115:b002:l020","ordinal":301686,"en":"I went as plunder."},{"id":"seytek-2012:p0115:b002:l021","ordinal":301687,"en":"I went after breaking my own pride,"},{"id":"seytek-2012:p0115:b002:l022","ordinal":301688,"en":"I went and surrendered myself as spoil."},{"id":"seytek-2012:p0115:b002:l023","ordinal":301689,"en":"In her old age, Kanykei,"},{"id":"seytek-2012:p0115:b002:l024","ordinal":301690,"en":"And when Chyyrdy had grown aged—"},{"id":"seytek-2012:p0115:b002:l025","ordinal":301691,"en":"Killing my lord day after day,"},{"id":"seytek-2012:p0115:b002:l026","ordinal":301692,"en":"He dragged away from Talas"},{"id":"seytek-2012:p0115:b002:l027","ordinal":301693,"en":"My two venerable mothers,"},{"id":"seytek-2012:p0115:b002:l028","ordinal":301694,"en":"He plundered my people,"},{"id":"seytek-2012:p0115:b002:l029","ordinal":301695,"en":"He broke my back,"},{"id":"seytek-2012:p0115:b002:l030","ordinal":301696,"en":"And raided my village in Keng-Kol."},{"id":"seytek-2012:p0115:b002:l031","ordinal":301697,"en":"Kanchoro took away"},{"id":"seytek-2012:p0115:b002:l032","ordinal":301698,"en":"Akbala, daughter of Jamgyrchy—"},{"id":"seytek-2012:p0115:b002:l033","ordinal":301699,"en":"My wife, the fair Akbala."},{"id":"seytek-2012:p0115:b002:l034","ordinal":301700,"en":"Those swine killed"},{"id":"seytek-2012:p0115:b002:l035","ordinal":301701,"en":"My giant warrior Er Sarykan,"},{"id":"seytek-2012:p0115:b002:l036","ordinal":301702,"en":"They shattered my brain"},{"id":"seytek-2012:p0115:b002:l037","ordinal":301703,"en":"And brought me endless grief."},{"id":"seytek-2012:p0115:b002:l038","ordinal":301704,"en":"When I recall the old days,"},{"id":"seytek-2012:p0115:b002:l039","ordinal":301705,"en":"These ribs of mine"},{"id":"seytek-2012:p0115:b002:l040","ordinal":301706,"en":"Part layer from layer."},{"id":"seytek-2012:p0115:b003:l001","ordinal":301707,"en":"After that, I went about"},{"id":"seytek-2012:p0115:b003:l002","ordinal":301708,"en":"Wishing to die and leave this world."},{"id":"seytek-2012:p0115:b003:l003","ordinal":301709,"en":"Then I saw your orphaned eyes,"},{"id":"seytek-2012:p0115:b003:l004","ordinal":301710,"en":"Young falcon left by the hero,"},{"id":"seytek-2012:p0115:b003:l005","ordinal":301711,"en":"And longed to behold you."},{"id":"seytek-2012:p0115:b003:l006","ordinal":301712,"en":"Eager to see you, I hurried,"},{"id":"seytek-2012:p0115:b003:l007","ordinal":301713,"en":"Staggering beneath firewood,"},{"id":"seytek-2012:p0115:b003:l008","ordinal":301714,"en":"Beaten with clubs by the herdsmen,"},{"id":"seytek-2012:p0115:b003:l009","ordinal":301715,"en":"Ravaged and thrashed,"},{"id":"seytek-2012:p0115:b003:l010","ordinal":301716,"en":"With cudgels raining on my back."},{"id":"seytek-2012:p0115:b003:l011","ordinal":301717,"en":"“Master, show me mercy,” I begged,"},{"id":"seytek-2012:p0115:b003:l012","ordinal":301718,"en":"Pleading even with lowly slaves."},{"id":"seytek-2012:p0115:b003:l013","ordinal":301719,"en":"Your uncle went about flayed raw,"},{"id":"seytek-2012:p0115:b003:l014","ordinal":301720,"en":"With no strength left to fight,"},{"id":"seytek-2012:p0115:b003:l015","ordinal":301721,"en":"His shoulders deeply gouged."},{"id":"seytek-2012:p0115:b003:l016","ordinal":301722,"en":"Your uncle, once like a mighty stallion,"},{"id":"seytek-2012:p0115:b003:l017","ordinal":301723,"en":"Became pliant as leather,"},{"id":"seytek-2012:p0115:b003:l018","ordinal":301724,"en":"And all I saw was turmoil."},{"id":"seytek-2012:p0115:b003:l019","ordinal":301725,"en":"Instead of food, I drank"},{"id":"seytek-2012:p0115:b003:l020","ordinal":301726,"en":"Nine bucketfuls of water,"},{"id":"seytek-2012:p0115:b003:l021","ordinal":301727,"en":"Stretched out like a hide,"},{"id":"seytek-2012:p0115:b003:l022","ordinal":301728,"en":"While a horse’s knobby ankle bone"},{"id":"seytek-2012:p0115:b003:l023","ordinal":301729,"en":"Was given me in place of food."},{"id":"seytek-2012:p0115:b003:l024","ordinal":301730,"en":"Your uncle suffered pillage,"},{"id":"seytek-2012:p0115:b003:l025","ordinal":301731,"en":"His precious body endured beatings."},{"id":"seytek-2012:p0115:b003:l026","ordinal":301732,"en":"Clubs struck my back,"},{"id":"seytek-2012:p0115:b003:l027","ordinal":301733,"en":"Spikes pierced my rump."},{"id":"seytek-2012:p0115:b003:l028","ordinal":301734,"en":"I set out to gather firewood,"},{"id":"seytek-2012:p0115:b003:l029","ordinal":301735,"en":"And three times every day"},{"id":"seytek-2012:p0115:b003:l030","ordinal":301736,"en":"I was wrapped in thorns."},{"id":"seytek-2012:p0115:b003:l031","ordinal":301737,"en":"I was mauled by strongmen,"},{"id":"seytek-2012:p0115:b003:l032","ordinal":301738,"en":"Beaten by the herdsmen."},{"id":"seytek-2012:p0115:b003:l033","ordinal":301739,"en":"Long did I carry firewood,"},{"id":"seytek-2012:p0115:b003:l034","ordinal":301740,"en":"Hoping, if I did not die, to see"},{"id":"seytek-2012:p0115:b003:l035","ordinal":301741,"en":"The orphan left as our legacy."},{"id":"seytek-2012:p0115:b003:l036","ordinal":301742,"en":"May God never inflict upon another"},{"id":"seytek-2012:p0115:b003:l037","ordinal":301743,"en":"The humiliations I endured,"},{"id":"seytek-2012:p0115:b003:l038","ordinal":301744,"en":"My son, nor the torment that befell me."},{"id":"seytek-2012:p0115:b003:l039","ordinal":301745,"en":"My horns broken, left forlorn,"},{"id":"seytek-2012:p0115:b003:l040","ordinal":301746,"en":"I came back shorn of all power."},{"id":"seytek-2012:p0116:b002:l001","ordinal":301747,"en":"No mortal can deny it."},{"id":"seytek-2012:p0116:b002:l002","ordinal":301748,"en":"His fortunes were perfectly balanced;"},{"id":"seytek-2012:p0116:b002:l003","ordinal":301749,"en":"When you looked into his heart,"},{"id":"seytek-2012:p0116:b002:l004","ordinal":301750,"en":"It was broader than the whole earth."},{"id":"seytek-2012:p0116:b002:l005","ordinal":301751,"en":"God will never create another man"},{"id":"seytek-2012:p0116:b002:l006","ordinal":301752,"en":"Made like your father."},{"id":"seytek-2012:p0116:b002:l007","ordinal":301753,"en":"Your father was a fierce gray-maned lion,"},{"id":"seytek-2012:p0116:b002:l008","ordinal":301754,"en":"Who tethered fourteen steeds,"},{"id":"seytek-2012:p0116:b002:l009","ordinal":301755,"en":"And dwelt in central Keng-Kol."},{"id":"seytek-2012:p0116:b002:l010","ordinal":301756,"en":"If an enemy came out shooting,"},{"id":"seytek-2012:p0116:b002:l011","ordinal":301757,"en":"He drove them before him."},{"id":"seytek-2012:p0116:b002:l012","ordinal":301758,"en":"Whoever stirred his wrath,"},{"id":"seytek-2012:p0116:b002:l013","ordinal":301759,"en":"He crushed between his fangs."},{"id":"seytek-2012:p0116:b002:l014","ordinal":301760,"en":"My son, such is my story."},{"id":"seytek-2012:p0116:b002:l015","ordinal":301761,"en":"Your dear father’s confidant,"},{"id":"seytek-2012:p0116:b002:l016","ordinal":301762,"en":"The noble Choro, his companion,"},{"id":"seytek-2012:p0116:b002:l017","ordinal":301763,"en":"Whose stallion carried him to Altai,"},{"id":"seytek-2012:p0116:b002:l018","ordinal":301764,"en":"Was your father’s kinsman."},{"id":"seytek-2012:p0116:b002:l019","ordinal":301765,"en":"They kicked together like foals,"},{"id":"seytek-2012:p0116:b002:l020","ordinal":301766,"en":"And contended for the same breast."},{"id":"seytek-2012:p0116:b002:l021","ordinal":301767,"en":"Liver and choice cuts"},{"id":"seytek-2012:p0116:b002:l022","ordinal":301768,"en":"Were divided equally for them,"},{"id":"seytek-2012:p0116:b002:l023","ordinal":301769,"en":"And the countless Nogai and Kyrgyz"},{"id":"seytek-2012:p0116:b002:l024","ordinal":301770,"en":"Called them the foremost of sons."},{"id":"seytek-2012:p0116:b002:l025","ordinal":301771,"en":"So that we might become true brothers,"},{"id":"seytek-2012:p0116:b002:l026","ordinal":301772,"en":"Our mother Kanykei gave both of us"},{"id":"seytek-2012:p0116:b002:l027","ordinal":301773,"en":"Milk from her own breast."},{"id":"seytek-2012:p0116:b002:l028","ordinal":301774,"en":"From the left breast Kanchoro sucked,"},{"id":"seytek-2012:p0116:b002:l029","ordinal":301775,"en":"Dark crimson blood flowed."},{"id":"seytek-2012:p0116:b002:l030","ordinal":301776,"en":"From the right breast Külchoro sucked,"},{"id":"seytek-2012:p0116:b002:l031","ordinal":301777,"en":"Pure white milk welled like a spring."},{"id":"seytek-2012:p0116:b002:l032","ordinal":301778,"en":"“I have seen an omen in the boys,”"},{"id":"seytek-2012:p0116:b002:l033","ordinal":301779,"en":"Your sorrowful mother wept."},{"id":"seytek-2012:p0116:b002:l034","ordinal":301780,"en":"“Külchoro, for whom milk sprang forth”—"},{"id":"seytek-2012:p0116:b002:l035","ordinal":301781,"en":"These were my mother Kanykei’s words—"},{"id":"seytek-2012:p0116:b002:l036","ordinal":301782,"en":"“If Külchoro survives"},{"id":"seytek-2012:p0116:b002:l037","ordinal":301783,"en":"And you heed my words from the start,"},{"id":"seytek-2012:p0116:b002:l038","ordinal":301784,"en":"He will be your inheritance and support."},{"id":"seytek-2012:p0116:b002:l039","ordinal":301785,"en":"But this Kanchoro here,"},{"id":"seytek-2012:p0116:b002:l040","ordinal":301786,"en":"To tell you the truth,"},{"id":"seytek-2012:p0116:b003:l001","ordinal":301787,"en":"Is a cursed and grievous menace;"},{"id":"seytek-2012:p0116:b003:l002","ordinal":301788,"en":"It shows in your blood-uncle.”"},{"id":"seytek-2012:p0116:b003:l003","ordinal":301789,"en":"The Jediger surged in wildly,"},{"id":"seytek-2012:p0116:b003:l004","ordinal":301790,"en":"And mighty Kyyaz emerged as their chief."},{"id":"seytek-2012:p0116:b003:l005","ordinal":301791,"en":"The enemy among us was Kanchoro,"},{"id":"seytek-2012:p0116:b003:l006","ordinal":301792,"en":"Who became a man of infamous name."},{"id":"seytek-2012:p0116:b003:l007","ordinal":301793,"en":"He shattered my happiness"},{"id":"seytek-2012:p0116:b003:l008","ordinal":301794,"en":"And destroyed my golden throne."},{"id":"seytek-2012:p0116:b003:l009","ordinal":301795,"en":"He left my people wailing"},{"id":"seytek-2012:p0116:b003:l010","ordinal":301796,"en":"And broke my back."},{"id":"seytek-2012:p0116:b003:l011","ordinal":301797,"en":"He felled my flourishing tree,"},{"id":"seytek-2012:p0116:b003:l012","ordinal":301798,"en":"And tore down all my dwellings."},{"id":"seytek-2012:p0116:b003:l013","ordinal":301799,"en":"He made widows of braided women,"},{"id":"seytek-2012:p0116:b003:l014","ordinal":301800,"en":"And trampled proud young lords"},{"id":"seytek-2012:p0116:b003:l015","ordinal":301801,"en":"Underfoot like loose wool."},{"id":"seytek-2012:p0116:b003:l016","ordinal":301802,"en":"He bloodied the mouth of my gateway"},{"id":"seytek-2012:p0116:b003:l017","ordinal":301803,"en":"And turned my black road to dust."},{"id":"seytek-2012:p0116:b003:l018","ordinal":301804,"en":"Many powerful lionhearted warriors"},{"id":"seytek-2012:p0116:b003:l019","ordinal":301805,"en":"He utterly swept away."},{"id":"seytek-2012:p0116:b003:l020","ordinal":301806,"en":"At Talas he slaughtered"},{"id":"seytek-2012:p0116:b003:l021","ordinal":301807,"en":"My giant, Semetey."},{"id":"seytek-2012:p0116:b003:l022","ordinal":301808,"en":"He battered my head again and again,"},{"id":"seytek-2012:p0116:b003:l023","ordinal":301809,"en":"And brought me endless grief."},{"id":"seytek-2012:p0116:b003:l024","ordinal":301810,"en":"My helpless people were plundered;"},{"id":"seytek-2012:p0116:b003:l025","ordinal":301811,"en":"I do not know whether he lives or is dead—"},{"id":"seytek-2012:p0116:b003:l026","ordinal":301812,"en":"My uncle, heroic Bakai."},{"id":"seytek-2012:p0116:b003:l027","ordinal":301813,"en":"He left my land of Talas desolate"},{"id":"seytek-2012:p0116:b003:l028","ordinal":301814,"en":"And scattered my Kyrgyz people."},{"id":"seytek-2012:p0116:b003:l029","ordinal":301815,"en":"He ignored all my pleas"},{"id":"seytek-2012:p0116:b003:l030","ordinal":301816,"en":"And cut down my remaining men with swords."},{"id":"seytek-2012:p0116:b003:l031","ordinal":301817,"en":"In his day your Külchoro"},{"id":"seytek-2012:p0116:b003:l032","ordinal":301818,"en":"Conquered Beijing and grew mighty,"},{"id":"seytek-2012:p0116:b003:l033","ordinal":301819,"en":"But parted from his hero,"},{"id":"seytek-2012:p0116:b003:l034","ordinal":301820,"en":"Your hapless uncle fell into disgrace."},{"id":"seytek-2012:p0116:b003:l035","ordinal":301821,"en":"Your father, the formidable Semetey,"},{"id":"seytek-2012:p0116:b003:l036","ordinal":301822,"en":"Was a lion favored by the spirits."},{"id":"seytek-2012:p0116:b003:l037","ordinal":301823,"en":"God will not soon create"},{"id":"seytek-2012:p0116:b003:l038","ordinal":301824,"en":"Among mortal men"}]
