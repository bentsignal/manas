[{"id":"semetey-1-2013:p1179:b003:l016","ordinal":166145,"en":"I once made that promise."},{"id":"semetey-1-2013:p1179:b003:l017","ordinal":166146,"en":"Having found Chürök and brought her home,"},{"id":"semetey-1-2013:p1179:b003:l018","ordinal":166147,"en":"I slaughtered ninety beasts for her feast."},{"id":"semetey-1-2013:p1179:b003:l019","ordinal":166148,"en":"Saying, ‘My senior wife has borne a maiden,’"},{"id":"semetey-1-2013:p1179:b003:l020","ordinal":166149,"en":"I named her Chürök."},{"id":"semetey-1-2013:p1179:b003:l021","ordinal":166150,"en":"Become my co-father-in-law;"},{"id":"semetey-1-2013:p1179:b003:l022","ordinal":166151,"en":"God has given you a child."},{"id":"semetey-1-2013:p1179:b003:l023","ordinal":166152,"en":"Lion lord, snow leopard,"},{"id":"semetey-1-2013:p1179:b003:l024","ordinal":166153,"en":"Take her to be your daughter-in-law.”"},{"id":"semetey-1-2013:p1179:b003:l025","ordinal":166154,"en":"Akun Khan spoke with pride:"},{"id":"semetey-1-2013:p1179:b003:l026","ordinal":166155,"en":"“The Chürök whom I found"},{"id":"semetey-1-2013:p1179:b003:l027","ordinal":166156,"en":"Is a fitting match for you, Khan Manas.”"},{"id":"semetey-1-2013:p1179:b003:l028","ordinal":166157,"en":"Bloodthirsty snow-leopard Manas,"},{"id":"semetey-1-2013:p1179:b003:l029","ordinal":166158,"en":"Delighted with Akun Khan,"},{"id":"semetey-1-2013:p1179:b003:l030","ordinal":166159,"en":"Drove up seven hundred chestnut horses,"},{"id":"semetey-1-2013:p1179:b003:l031","ordinal":166160,"en":"A sight that distracted all who beheld it."},{"id":"semetey-1-2013:p1179:b003:l032","ordinal":166161,"en":"Among the seven hundred,"},{"id":"semetey-1-2013:p1179:b003:l033","ordinal":166162,"en":"Was a gray stallion of Kambar-Ata’s line;"},{"id":"semetey-1-2013:p1179:b003:l034","ordinal":166163,"en":"He placed the gray stallion at their head,"},{"id":"semetey-1-2013:p1179:b003:l035","ordinal":166164,"en":"And upon the gray stallion’s head"},{"id":"semetey-1-2013:p1179:b003:l036","ordinal":166165,"en":"Displayed a blaze as broad as a pail."},{"id":"semetey-1-2013:p1179:b003:l037","ordinal":166166,"en":"He gave six hundred piebald horses,"},{"id":"semetey-1-2013:p1179:b003:l038","ordinal":166167,"en":"Drove the livestock and became his co-father-in-law."},{"id":"semetey-1-2013:p1179:b005:l001","ordinal":166168,"en":"Great Manas bowed in homage,"},{"id":"semetey-1-2013:p1179:b005:l002","ordinal":166169,"en":"Folded his hands and tasted the ceremonial fat."},{"id":"semetey-1-2013:p1179:b005:l003","ordinal":166170,"en":"Many words remain if one attends to them;"},{"id":"semetey-1-2013:p1179:b005:l004","ordinal":166171,"en":"This was where they became pledged in betrothal."},{"id":"semetey-1-2013:p1179:b005:l005","ordinal":166172,"en":"The matter of that betrothal was settled,"},{"id":"semetey-1-2013:p1179:b005:l006","ordinal":166173,"en":"At the games on Karkyra,"},{"id":"semetey-1-2013:p1179:b005:l007","ordinal":166174,"en":"At Kökötöy’s celebration,"},{"id":"semetey-1-2013:p1179:b005:l008","ordinal":166175,"en":"At Kökötöy’s funeral feast,"},{"id":"semetey-1-2013:p1179:b005:l009","ordinal":166176,"en":"Before the great assembly."},{"id":"semetey-1-2013:p1179:b005:l010","ordinal":166177,"en":"All manner of people were there,"},{"id":"semetey-1-2013:p1179:b005:l011","ordinal":166178,"en":"And the one directing the feast then"},{"id":"semetey-1-2013:p1179:b005:l012","ordinal":166179,"en":"Was generous Khan Manas."},{"id":"semetey-1-2013:p1179:b005:l013","ordinal":166180,"en":"Manas emerged as khan of the Kyrgyz,"},{"id":"semetey-1-2013:p1179:b005:l014","ordinal":166181,"en":"His courage driving the breath from foes."},{"id":"semetey-1-2013:p1179:b005:l015","ordinal":166182,"en":"The Black Kalmyk and Manchu hosts"},{"id":"semetey-1-2013:p1179:b005:l016","ordinal":166183,"en":"Swarmed upon them by force of numbers."},{"id":"semetey-1-2013:p1179:b005:l017","ordinal":166184,"en":"When they were about to plunder and carry all away,"},{"id":"semetey-1-2013:p1179:b005:l018","ordinal":166185,"en":"The sons of the Muslim faith"},{"id":"semetey-1-2013:p1179:b005:l019","ordinal":166186,"en":"Were protected by snow-leopard Manas."},{"id":"semetey-1-2013:p1179:b005:l020","ordinal":166187,"en":"Kökötöy’s gold-crescented"},{"id":"semetey-1-2013:p1179:b005:l021","ordinal":166188,"en":"Crimson banner"},{"id":"semetey-1-2013:p1179:b005:l022","ordinal":166189,"en":"Was raised then by Bokmurun."},{"id":"semetey-1-2013:p1179:b005:l023","ordinal":166190,"en":"The uproar was too great for the earth to bear."},{"id":"semetey-1-2013:p1179:b005:l024","ordinal":166191,"en":"He had fire struck from the flint,"},{"id":"semetey-1-2013:p1179:b005:l025","ordinal":166192,"en":"Bokmurun, the rich man’s son,"},{"id":"semetey-1-2013:p1179:b005:l026","ordinal":166193,"en":"Summoned infidel and Muslim alike,"},{"id":"semetey-1-2013:p1179:b005:l027","ordinal":166194,"en":"Inviting every one without exception."},{"id":"semetey-1-2013:p1179:b005:l028","ordinal":166195,"en":"He covered the earth in dust"},{"id":"semetey-1-2013:p1179:b005:l029","ordinal":166196,"en":"And won renown among the people."},{"id":"semetey-1-2013:p1179:b005:l030","ordinal":166197,"en":"The Black Kalmyk and Manchu hosts"},{"id":"semetey-1-2013:p1179:b005:l031","ordinal":166198,"en":"Had their mouths sealed and spoke no word."},{"id":"semetey-1-2013:p1179:b005:l032","ordinal":166199,"en":"The lion lord, brave Manas,"},{"id":"semetey-1-2013:p1179:b005:l033","ordinal":166200,"en":"Was born for the good fortune"},{"id":"semetey-1-2013:p1179:b005:l034","ordinal":166201,"en":"Of the people of the Muslim faith."},{"id":"semetey-1-2013:p1179:b005:l035","ordinal":166202,"en":"All the firewood was cut,"},{"id":"semetey-1-2013:p1179:b005:l036","ordinal":166203,"en":"And the quarrels between infidel and Muslim"},{"id":"semetey-1-2013:p1179:b005:l037","ordinal":166204,"en":"Were brought to an end."},{"id":"semetey-1-2013:p1179:b005:l038","ordinal":166205,"en":"Infidel and Muslim alike"},{"id":"semetey-1-2013:p1179:b005:l039","ordinal":166206,"en":"Seethed in multitudes like black beetles."},{"id":"semetey-1-2013:p1180:b003:l001","ordinal":166207,"en":"All the people gathered;"},{"id":"semetey-1-2013:p1180:b003:l002","ordinal":166208,"en":"There is much grief that must be told."},{"id":"semetey-1-2013:p1180:b003:l003","ordinal":166209,"en":"For Kökötöy's memorial feast,"},{"id":"semetey-1-2013:p1180:b003:l004","ordinal":166210,"en":"Many champions rendered service."},{"id":"semetey-1-2013:p1180:b003:l005","ordinal":166211,"en":"Bokmurun of Kökötöy"},{"id":"semetey-1-2013:p1180:b003:l006","ordinal":166212,"en":"Stirred great commotion among the people;"},{"id":"semetey-1-2013:p1180:b003:l007","ordinal":166213,"en":"Every great pit"},{"id":"semetey-1-2013:p1180:b003:l008","ordinal":166214,"en":"He had dug and prepared properly."},{"id":"semetey-1-2013:p1180:b003:l009","ordinal":166215,"en":"Kökötöy's countless livestock"},{"id":"semetey-1-2013:p1180:b003:l010","ordinal":166216,"en":"He had slaughtered without counting."},{"id":"semetey-1-2013:p1180:b004:l001","ordinal":166217,"en":"Everyone who came"},{"id":"semetey-1-2013:p1180:b004:l002","ordinal":166218,"en":"He filled with fat from the rump."},{"id":"semetey-1-2013:p1180:b004:l003","ordinal":166219,"en":"Bokmurun of Kökötöy"},{"id":"semetey-1-2013:p1180:b004:l004","ordinal":166220,"en":"Was himself a peerless youth;"},{"id":"semetey-1-2013:p1180:b004:l005","ordinal":166221,"en":"Parted from his father,"},{"id":"semetey-1-2013:p1180:b004:l006","ordinal":166222,"en":"He had reached thirteen years of age."},{"id":"semetey-1-2013:p1180:b004:l007","ordinal":166223,"en":"A treasury filling forty rooms—"},{"id":"semetey-1-2013:p1180:b004:l008","ordinal":166224,"en":"He opened the treasury."},{"id":"semetey-1-2013:p1180:b004:l009","ordinal":166225,"en":"Kökötöy's vast wealth"},{"id":"semetey-1-2013:p1180:b004:l010","ordinal":166226,"en":"He scattered like charcoal."},{"id":"semetey-1-2013:p1180:b006:l001","ordinal":166227,"en":"Kökötöy's many strongmen"},{"id":"semetey-1-2013:p1180:b006:l002","ordinal":166228,"en":"Dug and prepared the pit;"},{"id":"semetey-1-2013:p1180:b006:l003","ordinal":166229,"en":"Kökötöy's black male camel"},{"id":"semetey-1-2013:p1180:b006:l004","ordinal":166230,"en":"They tethered in that pit."},{"id":"semetey-1-2013:p1180:b006:l005","ordinal":166231,"en":"Surpassing all people in his custom,"},{"id":"semetey-1-2013:p1180:b006:l006","ordinal":166232,"en":"Upon the black camel's head"},{"id":"semetey-1-2013:p1180:b006:l007","ordinal":166233,"en":"He had a silver bridle fastened"},{"id":"semetey-1-2013:p1180:b006:l008","ordinal":166234,"en":"And a costly carpet spread."},{"id":"semetey-1-2013:p1180:b006:l009","ordinal":166235,"en":"Kökötöy's green-hued"},{"id":"semetey-1-2013:p1180:b006:l010","ordinal":166236,"en":"Blue saddlebag,"},{"id":"semetey-1-2013:p1180:b006:l011","ordinal":166237,"en":"No ordinary camel bag but one for a great bull camel—"},{"id":"semetey-1-2013:p1180:b006:l012","ordinal":166238,"en":"Kökötöy's many treasures"},{"id":"semetey-1-2013:p1180:b006:l013","ordinal":166239,"en":"Filled many saddlebags there."},{"id":"semetey-1-2013:p1180:b006:l014","ordinal":166240,"en":"Inside that saddlebag,"},{"id":"semetey-1-2013:p1180:b006:l015","ordinal":166241,"en":"What was there, and what was not?"},{"id":"semetey-1-2013:p1180:b006:l016","ordinal":166242,"en":"The head grew dizzy at the sight."},{"id":"semetey-1-2013:p1180:b006:l017","ordinal":166243,"en":"Inside that saddlebag,"},{"id":"semetey-1-2013:p1180:b006:l018","ordinal":166244,"en":"Rubies and gold were mingled."},{"id":"semetey-1-2013:p1180:b006:l019","ordinal":166245,"en":"For his father's memorial feast,"},{"id":"semetey-1-2013:p1180:b006:l020","ordinal":166246,"en":"The wretched youth spared not his life:"},{"id":"semetey-1-2013:p1180:b006:l021","ordinal":166247,"en":"“Black male camel left by the prince,"},{"id":"semetey-1-2013:p1180:b006:l022","ordinal":166248,"en":"Masterless beast fallen upon your head—"},{"id":"semetey-1-2013:p1180:b006:l023","ordinal":166249,"en":"How could I begrudge it for my father?"},{"id":"semetey-1-2013:p1180:b006:l024","ordinal":166250,"en":"How could I heed the gaze"},{"id":"semetey-1-2013:p1180:b006:l025","ordinal":166251,"en":"Of this wretched false world?"},{"id":"semetey-1-2013:p1180:b007:l001","ordinal":166252,"en":"I have a spectacle for the people;"},{"id":"semetey-1-2013:p1180:b007:l002","ordinal":166253,"en":"Upon the black male camel"},{"id":"semetey-1-2013:p1180:b007:l003","ordinal":166254,"en":"I have wealth for the multitude to plunder."},{"id":"semetey-1-2013:p1180:b007:l004","ordinal":166255,"en":"I have a secret gathered here;"},{"id":"semetey-1-2013:p1180:b007:l005","ordinal":166256,"en":"For infidel and Muslim,"},{"id":"semetey-1-2013:p1180:b007:l006","ordinal":166257,"en":"There is a wonder that will make them laugh."},{"id":"semetey-1-2013:p1180:b007:l007","ordinal":166258,"en":"I have a song drawn from the camp;"},{"id":"semetey-1-2013:p1180:b007:l008","ordinal":166259,"en":"For Kalmak and Kyrgyz,"},{"id":"semetey-1-2013:p1180:b007:l009","ordinal":166260,"en":"I have a rite to perform."},{"id":"semetey-1-2013:p1180:b007:l010","ordinal":166261,"en":"If you do not submit to that rite,"},{"id":"semetey-1-2013:p1180:b007:l011","ordinal":166262,"en":"I have a quarrel to raise."},{"id":"semetey-1-2013:p1180:b007:l012","ordinal":166263,"en":"To openly strip away"},{"id":"semetey-1-2013:p1180:b007:l013","ordinal":166264,"en":"Kökötöy's many treasures,"},{"id":"semetey-1-2013:p1180:b007:l014","ordinal":166265,"en":"Let naked women come forth;"},{"id":"semetey-1-2013:p1180:b007:l015","ordinal":166266,"en":"Walk up and strip them away."},{"id":"semetey-1-2013:p1180:b007:l016","ordinal":166267,"en":"Remain there having grown rich."},{"id":"semetey-1-2013:p1180:b007:l017","ordinal":166268,"en":"For infidel and Muslim,"},{"id":"semetey-1-2013:p1180:b007:l018","ordinal":166269,"en":"For all the great multitude,"},{"id":"semetey-1-2013:p1180:b007:l019","ordinal":166270,"en":"Put on a spectacle.”"},{"id":"semetey-1-2013:p1180:b007:l020","ordinal":166271,"en":"Infidel and Muslim"},{"id":"semetey-1-2013:p1180:b007:l021","ordinal":166272,"en":"Gathered together,"},{"id":"semetey-1-2013:p1180:b007:l022","ordinal":166273,"en":"Counseling one another and asking,"},{"id":"semetey-1-2013:p1180:b007:l023","ordinal":166274,"en":"“Where is there wealth like this?”"},{"id":"semetey-1-2013:p1180:b007:l024","ordinal":166275,"en":"Until their council was satisfied and complete,"},{"id":"semetey-1-2013:p1180:b007:l025","ordinal":166276,"en":"With a face like an old gourd,"},{"id":"semetey-1-2013:p1181:b003:l001","ordinal":166277,"en":"With buttocks six palms wide,"},{"id":"semetey-1-2013:p1181:b003:l002","ordinal":166278,"en":"Her name was Orongu."},{"id":"semetey-1-2013:p1181:b003:l003","ordinal":166279,"en":"Can a human be like this?"},{"id":"semetey-1-2013:p1181:b003:l004","ordinal":166280,"en":"Grim in appearance and fierce in wrath,"},{"id":"semetey-1-2013:p1181:b003:l005","ordinal":166281,"en":"Her lineage was from the Black Chinese—"},{"id":"semetey-1-2013:p1181:b003:l006","ordinal":166282,"en":"Can a woman be like this?"},{"id":"semetey-1-2013:p1181:b003:l007","ordinal":166283,"en":"This infidel felt no shame;"},{"id":"semetey-1-2013:p1181:b003:l008","ordinal":166284,"en":"Would she spare any living soul?"},{"id":"semetey-1-2013:p1181:b003:l009","ordinal":166285,"en":"While people gathered,"},{"id":"semetey-1-2013:p1181:b003:l010","ordinal":166286,"en":"Swarming like black worms,"},{"id":"semetey-1-2013:p1181:b003:l011","ordinal":166287,"en":"Orongu came out naked."},{"id":"semetey-1-2013:p1181:b003:l012","ordinal":166288,"en":"She prepared every kind of beast;"},{"id":"semetey-1-2013:p1181:b003:l013","ordinal":166289,"en":"Following an ancient rite,"},{"id":"semetey-1-2013:p1181:b003:l014","ordinal":166290,"en":"She had hair two fingers long"},{"id":"semetey-1-2013:p1181:b003:l015","ordinal":166291,"en":"Tied behind her."},{"id":"semetey-1-2013:p1181:b003:l016","ordinal":166292,"en":"Orongu strode forward;"},{"id":"semetey-1-2013:p1181:b003:l017","ordinal":166293,"en":"Hero Ürbü, son of Taz,"},{"id":"semetey-1-2013:p1181:b003:l018","ordinal":166294,"en":"Mounted her like a stallion."},{"id":"semetey-1-2013:p1181:b003:l019","ordinal":166295,"en":"Neighing like a stallion,"},{"id":"semetey-1-2013:p1181:b003:l020","ordinal":166296,"en":"Bleating like a he-goat,"},{"id":"semetey-1-2013:p1181:b003:l021","ordinal":166297,"en":"Surging like a ram,"},{"id":"semetey-1-2013:p1181:b003:l022","ordinal":166298,"en":"Straining like a bull camel,"},{"id":"semetey-1-2013:p1181:b003:l023","ordinal":166299,"en":"Hero Ürbü, who made the people laugh,"},{"id":"semetey-1-2013:p1181:b003:l024","ordinal":166300,"en":"Upon that woman Orongu"},{"id":"semetey-1-2013:p1181:b003:l025","ordinal":166301,"en":"Became like a stallion."},{"id":"semetey-1-2013:p1181:b003:l026","ordinal":166302,"en":"Could any woman's boldness"},{"id":"semetey-1-2013:p1181:b003:l027","ordinal":166303,"en":"Match Orongu's?"},{"id":"semetey-1-2013:p1181:b004:l001","ordinal":166304,"en":"When Ürbü drew near,"},{"id":"semetey-1-2013:p1181:b004:l002","ordinal":166305,"en":"Saying, “I shall untie the camel,”"},{"id":"semetey-1-2013:p1181:b004:l003","ordinal":166306,"en":"Orongu hurried onward."},{"id":"semetey-1-2013:p1181:b004:l004","ordinal":166307,"en":"Gripping her firearm and bleating,"},{"id":"semetey-1-2013:p1181:b004:l005","ordinal":166308,"en":"Hero Ürbü behind her"},{"id":"semetey-1-2013:p1181:b004:l006","ordinal":166309,"en":"Neighed like a stallion."},{"id":"semetey-1-2013:p1181:b004:l007","ordinal":166310,"en":"Bending toward the camel,"},{"id":"semetey-1-2013:p1181:b004:l008","ordinal":166311,"en":"Orongu began the rite."},{"id":"semetey-1-2013:p1181:b004:l009","ordinal":166312,"en":"Hero Ürbü shoved like a stallion"},{"id":"semetey-1-2013:p1181:b004:l010","ordinal":166313,"en":"And flung her over."},{"id":"semetey-1-2013:p1181:b004:l011","ordinal":166314,"en":"Those who valued modesty"},{"id":"semetey-1-2013:p1181:b004:l012","ordinal":166315,"en":"Fled out from among the people."},{"id":"semetey-1-2013:p1181:b004:l013","ordinal":166316,"en":"Watching in amazement"},{"id":"semetey-1-2013:p1181:b004:l014","ordinal":166317,"en":"Stood lion Manas."},{"id":"semetey-1-2013:p1181:b004:l015","ordinal":166318,"en":"Orongu's strongman,"},{"id":"semetey-1-2013:p1181:b004:l016","ordinal":166319,"en":"The black male camel in the pit—"},{"id":"semetey-1-2013:p1181:b004:l017","ordinal":166320,"en":"Bending over, she untied it."},{"id":"semetey-1-2013:p1181:b004:l018","ordinal":166321,"en":"The woman Orongu would not prosper;"},{"id":"semetey-1-2013:p1181:b004:l019","ordinal":166322,"en":"Before all those people,"},{"id":"semetey-1-2013:p1181:b004:l020","ordinal":166323,"en":"Her face did not even pale."},{"id":"semetey-1-2013:p1181:b004:l021","ordinal":166324,"en":"Orongu untied the camel"},{"id":"semetey-1-2013:p1181:b004:l022","ordinal":166325,"en":"And created another spectacle;"},{"id":"semetey-1-2013:p1181:b004:l023","ordinal":166326,"en":"Among women, Orongu"},{"id":"semetey-1-2013:p1181:b004:l024","ordinal":166327,"en":"Was a champion without shame."},{"id":"semetey-1-2013:p1181:b004:l025","ordinal":166328,"en":"She untied the camel;"},{"id":"semetey-1-2013:p1181:b004:l026","ordinal":166329,"en":"The woman Orongu proved a prince"},{"id":"semetey-1-2013:p1181:b004:l027","ordinal":166330,"en":"And remained there enriched."},{"id":"semetey-1-2013:p1181:b006:l001","ordinal":166331,"en":"After the camel-untying contest passed,"},{"id":"semetey-1-2013:p1181:b006:l002","ordinal":166332,"en":"After this spectacle had ended,"},{"id":"semetey-1-2013:p1181:b006:l003","ordinal":166333,"en":"Bokmurun of Kökötöy,"},{"id":"semetey-1-2013:p1181:b006:l004","ordinal":166334,"en":"Scattering his wealth,"},{"id":"semetey-1-2013:p1181:b006:l005","ordinal":166335,"en":"Making every people laugh,"},{"id":"semetey-1-2013:p1181:b006:l006","ordinal":166336,"en":"Made his riches known"},{"id":"semetey-1-2013:p1181:b006:l007","ordinal":166337,"en":"To the whole multitude,"},{"id":"semetey-1-2013:p1181:b006:l008","ordinal":166338,"en":"Infidel and Muslim:"},{"id":"semetey-1-2013:p1181:b007:l001","ordinal":166339,"en":"“Among the Muslims, Khan Koshoy,"},{"id":"semetey-1-2013:p1181:b007:l002","ordinal":166340,"en":"Lion Sultan Khan Manas—"},{"id":"semetey-1-2013:p1181:b007:l003","ordinal":166341,"en":"Your people stand here;"},{"id":"semetey-1-2013:p1181:b007:l004","ordinal":166342,"en":"Your fierce and formidable"},{"id":"semetey-1-2013:p1181:b007:l005","ordinal":166343,"en":"Giants stand here;"},{"id":"semetey-1-2013:p1181:b007:l006","ordinal":166344,"en":"People of the Muslim faith,"},{"id":"semetey-1-2013:p1181:b007:l007","ordinal":166345,"en":"All of you stand here."},{"id":"semetey-1-2013:p1181:b007:l008","ordinal":166346,"en":"I have counsel and words;"},{"id":"semetey-1-2013:p1182:b003:l001","ordinal":166347,"en":"Noble prince and lion,"},{"id":"semetey-1-2013:p1182:b003:l002","ordinal":166348,"en":"I have a matter for your counsel."},{"id":"semetey-1-2013:p1182:b003:l003","ordinal":166349,"en":"I am mint sprung from the water;"},{"id":"semetey-1-2013:p1182:b003:l004","ordinal":166350,"en":"From your Sultan Kökötöy,"},{"id":"semetey-1-2013:p1182:b003:l005","ordinal":166351,"en":"I am the only one left."},{"id":"semetey-1-2013:p1182:b003:l006","ordinal":166352,"en":"When my valiant father passed,"},{"id":"semetey-1-2013:p1182:b003:l007","ordinal":166353,"en":"I had no life apart from him;"},{"id":"semetey-1-2013:p1182:b003:l008","ordinal":166354,"en":"Left behind by my father to bear the burden,"},{"id":"semetey-1-2013:p1182:b003:l009","ordinal":166355,"en":"I have no younger brother beneath me for support."},{"id":"semetey-1-2013:p1182:b003:l010","ordinal":166356,"en":"I have the swift horse Maaniker;"},{"id":"semetey-1-2013:p1182:b003:l011","ordinal":166357,"en":"There is no charger besides him."},{"id":"semetey-1-2013:p1182:b003:l012","ordinal":166358,"en":"Nor have I elder kin behind me;"},{"id":"semetey-1-2013:p1182:b003:l013","ordinal":166359,"en":"I have only my solitary life."},{"id":"semetey-1-2013:p1182:b003:l014","ordinal":166360,"en":"Across the four corners of the world,"},{"id":"semetey-1-2013:p1182:b003:l015","ordinal":166361,"en":"I have livestock surrounding me."},{"id":"semetey-1-2013:p1182:b003:l016","ordinal":166362,"en":"After my dear father passed,"},{"id":"semetey-1-2013:p1182:b003:l017","ordinal":166363,"en":"After he departed without turning back"},{"id":"semetey-1-2013:p1182:b003:l018","ordinal":166364,"en":"To the world from which none return,"},{"id":"semetey-1-2013:p1182:b003:l019","ordinal":166365,"en":"I shall institute contests for the people."},{"id":"semetey-1-2013:p1182:b003:l020","ordinal":166366,"en":"How can I remain empty-handed"},{"id":"semetey-1-2013:p1182:b003:l021","ordinal":166367,"en":"Without arranging contests?"},{"id":"semetey-1-2013:p1182:b003:l022","ordinal":166368,"en":"For Khan Kökötöy's memorial rites,"},{"id":"semetey-1-2013:p1182:b003:l023","ordinal":166369,"en":"Look, assembled people:"},{"id":"semetey-1-2013:p1182:b003:l024","ordinal":166370,"en":"I have strength enough for the people;"},{"id":"semetey-1-2013:p1182:b003:l025","ordinal":166371,"en":"If I held feasts for another five years,"},{"id":"semetey-1-2013:p1182:b003:l026","ordinal":166372,"en":"I have livestock enough to last."},{"id":"semetey-1-2013:p1182:b003:l027","ordinal":166373,"en":"Prepared for the horse-race prizes,"},{"id":"semetey-1-2013:p1182:b003:l028","ordinal":166374,"en":"I have nine camel loads."},{"id":"semetey-1-2013:p1182:b003:l029","ordinal":166375,"en":"I have ninety thousand barren mares;"},{"id":"semetey-1-2013:p1182:b003:l030","ordinal":166376,"en":"I have a feast to give the people."},{"id":"semetey-1-2013:p1182:b003:l031","ordinal":166377,"en":"I have sheep beyond counting;"},{"id":"semetey-1-2013:p1182:b003:l032","ordinal":166378,"en":"When told, I have such wonders."},{"id":"semetey-1-2013:p1182:b003:l033","ordinal":166379,"en":"I have cattle beyond counting."},{"id":"semetey-1-2013:p1182:b003:l034","ordinal":166380,"en":"I had fire struck for Koroson"},{"id":"semetey-1-2013:p1182:b003:l035","ordinal":166381,"en":"And invited every one,"},{"id":"semetey-1-2013:p1182:b003:l036","ordinal":166382,"en":"Infidel and Muslim."},{"id":"semetey-1-2013:p1182:b003:l037","ordinal":166383,"en":"Horse trainers who tether horses,"},{"id":"semetey-1-2013:p1182:b003:l038","ordinal":166384,"en":"Competitors who race horses—"},{"id":"semetey-1-2013:p1182:b003:l039","ordinal":166385,"en":"For my dear father's memorial feast,"},{"id":"semetey-1-2013:p1182:b004:l001","ordinal":166386,"en":"You have gathered in great numbers."},{"id":"semetey-1-2013:p1182:b004:l002","ordinal":166387,"en":"I have seventy divisions of people;"},{"id":"semetey-1-2013:p1182:b004:l003","ordinal":166388,"en":"To all the accomplished people,"},{"id":"semetey-1-2013:p1182:b004:l004","ordinal":166389,"en":"I have words to speak today."},{"id":"semetey-1-2013:p1182:b004:l005","ordinal":166390,"en":"For my father's memorial feast,"},{"id":"semetey-1-2013:p1182:b004:l006","ordinal":166391,"en":"I shall slaughter countless black-blazed mares;"},{"id":"semetey-1-2013:p1182:b004:l007","ordinal":166392,"en":"I shall slaughter tens of thousands of camels."},{"id":"semetey-1-2013:p1182:b004:l008","ordinal":166393,"en":"I shall load goods upon camels and offer them;"},{"id":"semetey-1-2013:p1182:b004:l009","ordinal":166394,"en":"I shall offer slaves together with their children."},{"id":"semetey-1-2013:p1182:b004:l010","ordinal":166395,"en":"The treasury filling forty rooms—"},{"id":"semetey-1-2013:p1182:b004:l011","ordinal":166396,"en":"I shall divide and offer twenty rooms of it."},{"id":"semetey-1-2013:p1182:b004:l012","ordinal":166397,"en":"The people and khans are here;"},{"id":"semetey-1-2013:p1182:b004:l013","ordinal":166398,"en":"To rich Bokmurun's words,"},{"id":"semetey-1-2013:p1182:b004:l014","ordinal":166399,"en":"All of you listen closely."},{"id":"semetey-1-2013:p1182:b004:l015","ordinal":166400,"en":"There are prizes for one hundred nine horses;"}]
