[{"id":"semetey-1-2013:p1042:b003:l015","ordinal":155649,"en":"When they reached great Afghanistan,"},{"id":"semetey-1-2013:p1042:b003:l016","ordinal":155650,"en":"Its mastiffs barked thunderously,"},{"id":"semetey-1-2013:p1042:b003:l017","ordinal":155651,"en":"Its bitches yelped and barked,"},{"id":"semetey-1-2013:p1042:b003:l018","ordinal":155652,"en":"Its donkeys brayed on the rooftops,"},{"id":"semetey-1-2013:p1042:b003:l019","ordinal":155653,"en":"And roosters crowed from the city."},{"id":"semetey-1-2013:p1042:b003:l020","ordinal":155654,"en":"Broad Afghanistan lay there,"},{"id":"semetey-1-2013:p1042:b003:l021","ordinal":155655,"en":"Divided into guarded quarters,"},{"id":"semetey-1-2013:p1042:b003:l022","ordinal":155656,"en":"With dark smoke visible."},{"id":"semetey-1-2013:p1042:b003:l023","ordinal":155657,"en":"Broad Afghanistan lay there;"},{"id":"semetey-1-2013:p1042:b003:l024","ordinal":155658,"en":"Having traveled far upon the road,"},{"id":"semetey-1-2013:p1042:b003:l025","ordinal":155659,"en":"The lions filed into"},{"id":"semetey-1-2013:p1042:b003:l026","ordinal":155660,"en":"The palace prepared for them."},{"id":"semetey-1-2013:p1042:b003:l027","ordinal":155661,"en":"Aychürök's white palace"},{"id":"semetey-1-2013:p1042:b003:l028","ordinal":155662,"en":"Had iron gates and solid tin;"},{"id":"semetey-1-2013:p1042:b003:l029","ordinal":155663,"en":"Though the poor woman was only a maiden,"},{"id":"semetey-1-2013:p1042:b003:l030","ordinal":155664,"en":"Her retinue was exceedingly great."},{"id":"semetey-1-2013:p1042:b003:l031","ordinal":155665,"en":"At the mouth of the doorway,"},{"id":"semetey-1-2013:p1042:b003:l032","ordinal":155666,"en":"The champions posted as guards,"},{"id":"semetey-1-2013:p1042:b003:l033","ordinal":155667,"en":"Holding clubs as large as houses,"},{"id":"semetey-1-2013:p1042:b003:l034","ordinal":155668,"en":"All eighty rose to their feet."},{"id":"semetey-1-2013:p1042:b003:l035","ordinal":155669,"en":"Passing among those eighty,"},{"id":"semetey-1-2013:p1042:b003:l036","ordinal":155670,"en":"Your sister-in-law went on."},{"id":"semetey-1-2013:p1042:b003:l037","ordinal":155671,"en":"She murmured to some,"},{"id":"semetey-1-2013:p1042:b003:l038","ordinal":155672,"en":"And whispered to others;"},{"id":"semetey-1-2013:p1042:b003:l039","ordinal":155673,"en":"When they heard this news,"},{"id":"semetey-1-2013:p1042:b004:l001","ordinal":155674,"en":"The guards flew like arrows"},{"id":"semetey-1-2013:p1042:b004:l002","ordinal":155675,"en":"And took the prince's horse."},{"id":"semetey-1-2013:p1042:b004:l003","ordinal":155676,"en":"At a pillar whose post was gold,"},{"id":"semetey-1-2013:p1042:b004:l004","ordinal":155677,"en":"They tethered the exhausted Buurul"},{"id":"semetey-1-2013:p1042:b004:l005","ordinal":155678,"en":"High and secure."},{"id":"semetey-1-2013:p1042:b004:l006","ordinal":155679,"en":"Aychürök's forty young women"},{"id":"semetey-1-2013:p1042:b004:l007","ordinal":155680,"en":"Tied up horses in a bustle;"},{"id":"semetey-1-2013:p1042:b004:l008","ordinal":155681,"en":"Their quickness was beyond measure,"},{"id":"semetey-1-2013:p1042:b004:l009","ordinal":155682,"en":"As they tied them fast in a flash."},{"id":"semetey-1-2013:p1042:b004:l010","ordinal":155683,"en":"Within the white palace,"},{"id":"semetey-1-2013:p1042:b004:l011","ordinal":155684,"en":"In the great ceremonial pavilion,"},{"id":"semetey-1-2013:p1042:b004:l012","ordinal":155685,"en":"Akylay flew like an arrow,"},{"id":"semetey-1-2013:p1042:b004:l013","ordinal":155686,"en":"And his sister-in-law opened the door."},{"id":"semetey-1-2013:p1042:b004:l014","ordinal":155687,"en":"Led by the prince who had brought them,"},{"id":"semetey-1-2013:p1042:b004:l015","ordinal":155688,"en":"Twenty-five people entered now."},{"id":"semetey-1-2013:p1042:b004:l016","ordinal":155689,"en":"The prince now mounted the place of honor,"},{"id":"semetey-1-2013:p1042:b004:l017","ordinal":155690,"en":"An enormous golden throne like a camel."},{"id":"semetey-1-2013:p1042:b004:l018","ordinal":155691,"en":"Around it stood a grove of plane trees,"},{"id":"semetey-1-2013:p1042:b004:l019","ordinal":155692,"en":"And in its center a golden throne;"},{"id":"semetey-1-2013:p1042:b004:l020","ordinal":155693,"en":"This was a garden granted by the Creator."},{"id":"semetey-1-2013:p1042:b004:l021","ordinal":155694,"en":"The princely leopard Semetey"},{"id":"semetey-1-2013:p1042:b004:l022","ordinal":155695,"en":"At this time had gone as a bridegroom"},{"id":"semetey-1-2013:p1042:b004:l023","ordinal":155696,"en":"To Khan Akun's city."},{"id":"semetey-1-2013:p1042:b004:l024","ordinal":155697,"en":"Your renowned sister-in-law Aychürök—"},{"id":"semetey-1-2013:p1042:b004:l025","ordinal":155698,"en":"Ask not about the hero's estate;"},{"id":"semetey-1-2013:p1042:b004:l026","ordinal":155699,"en":"She had known plainly beforehand"},{"id":"semetey-1-2013:p1042:b004:l027","ordinal":155700,"en":"That the heroic princely conqueror would come."},{"id":"semetey-1-2013:p1042:b004:l028","ordinal":155701,"en":"\"The descendant of the formidable lion"},{"id":"semetey-1-2013:p1042:b004:l029","ordinal":155702,"en":"Will surely come,\" she had thought,"},{"id":"semetey-1-2013:p1042:b004:l030","ordinal":155703,"en":"And your sister-in-law stood preparing."},{"id":"semetey-1-2013:p1042:b004:l031","ordinal":155704,"en":"For the fourteen horses she made coverings"},{"id":"semetey-1-2013:p1042:b004:l032","ordinal":155705,"en":"Fashioned in the likeness of tigers."},{"id":"semetey-1-2013:p1042:b004:l033","ordinal":155706,"en":"She had their insides lined with fine velvet,"},{"id":"semetey-1-2013:p1042:b004:l034","ordinal":155707,"en":"And maidens and young women bite down the seams;"},{"id":"semetey-1-2013:p1042:b004:l035","ordinal":155708,"en":"She had golden beads set along their edges,"},{"id":"semetey-1-2013:p1042:b004:l036","ordinal":155709,"en":"And their faces embroidered wholly in silk,"},{"id":"semetey-1-2013:p1042:b004:l037","ordinal":155710,"en":"Had the pile twisted thick and shaggy,"},{"id":"semetey-1-2013:p1042:b004:l038","ordinal":155711,"en":"So that to anyone who saw their color"},{"id":"semetey-1-2013:p1042:b004:l039","ordinal":155712,"en":"They bore the very likeness of a tiger,"},{"id":"semetey-1-2013:p1043:b003:l001","ordinal":155713,"en":"And had them draped over the fourteen horses,"},{"id":"semetey-1-2013:p1043:b003:l002","ordinal":155714,"en":"Each tethered separately."},{"id":"semetey-1-2013:p1043:b003:l003","ordinal":155715,"en":"All fourteen horses"},{"id":"semetey-1-2013:p1043:b003:l004","ordinal":155716,"en":"She had strain beyond measure;"},{"id":"semetey-1-2013:p1043:b003:l005","ordinal":155717,"en":"At the edge of the fourteen horses,"},{"id":"semetey-1-2013:p1043:b003:l006","ordinal":155718,"en":"She had the towering Buurul"},{"id":"semetey-1-2013:p1043:b003:l007","ordinal":155719,"en":"Toss like one whose master had died."},{"id":"semetey-1-2013:p1043:b003:l008","ordinal":155720,"en":"The coverings of the fourteen horses—"},{"id":"semetey-1-2013:p1043:b003:l009","ordinal":155721,"en":"Hoof matched to hoof,"},{"id":"semetey-1-2013:p1043:b003:l010","ordinal":155722,"en":"Made exactly like a tiger;"},{"id":"semetey-1-2013:p1043:b003:l011","ordinal":155723,"en":"Ear matched to ear,"},{"id":"semetey-1-2013:p1043:b003:l012","ordinal":155724,"en":"Made wholly like a tiger."},{"id":"semetey-1-2013:p1043:b003:l013","ordinal":155725,"en":"On this side of the horses,"},{"id":"semetey-1-2013:p1043:b003:l014","ordinal":155726,"en":"\"Let no person see,\" she said,"},{"id":"semetey-1-2013:p1043:b003:l015","ordinal":155727,"en":"And had a splendid screen erected,"},{"id":"semetey-1-2013:p1043:b003:l016","ordinal":155728,"en":"With a white curtain drawn."},{"id":"semetey-1-2013:p1043:b003:l017","ordinal":155729,"en":"The luckless daughter of Akun,"},{"id":"semetey-1-2013:p1043:b003:l018","ordinal":155730,"en":"Displaying her distinction,"},{"id":"semetey-1-2013:p1043:b003:l019","ordinal":155731,"en":"Presented surpassing games and revelry"},{"id":"semetey-1-2013:p1043:b003:l020","ordinal":155732,"en":"To the gray-maned hero."},{"id":"semetey-1-2013:p1043:b003:l021","ordinal":155733,"en":"\"My precious prince has come,"},{"id":"semetey-1-2013:p1043:b003:l022","ordinal":155734,"en":"And God has granted my wish,\" she said."},{"id":"semetey-1-2013:p1043:b003:l023","ordinal":155735,"en":"Some sixty unbred mares"},{"id":"semetey-1-2013:p1043:b003:l024","ordinal":155736,"en":"She had slaughtered for his food,"},{"id":"semetey-1-2013:p1043:b003:l025","ordinal":155737,"en":"And upon gilded platters"},{"id":"semetey-1-2013:p1043:b003:l026","ordinal":155738,"en":"Had carved meat set out."},{"id":"semetey-1-2013:p1043:b003:l027","ordinal":155739,"en":"Your dear sister-in-law Chürök"},{"id":"semetey-1-2013:p1043:b003:l028","ordinal":155740,"en":"Had a curtain made from pure silk,"},{"id":"semetey-1-2013:p1043:b003:l029","ordinal":155741,"en":"Held and stretched from its sides,"},{"id":"semetey-1-2013:p1043:b003:l030","ordinal":155742,"en":"Raising her honor above the people"},{"id":"semetey-1-2013:p1043:b003:l031","ordinal":155743,"en":"And satisfying the affection of all who saw."},{"id":"semetey-1-2013:p1043:b003:l032","ordinal":155744,"en":"From silk quilts of every kind,"},{"id":"semetey-1-2013:p1043:b003:l033","ordinal":155745,"en":"Thirty young women and thirty maidens"},{"id":"semetey-1-2013:p1043:b003:l034","ordinal":155746,"en":"Had luxurious bedding spread."},{"id":"semetey-1-2013:p1043:b003:l035","ordinal":155747,"en":"Thirty young women and thirty maidens"},{"id":"semetey-1-2013:p1043:b003:l036","ordinal":155748,"en":"She had open their saddlebags,"},{"id":"semetey-1-2013:p1043:b003:l037","ordinal":155749,"en":"And for the custom called zhengetay,"},{"id":"semetey-1-2013:p1043:b003:l038","ordinal":155750,"en":"From pounds of golden embroidery thread,"},{"id":"semetey-1-2013:p1043:b003:l039","ordinal":155751,"en":"She had gifts scattered to them all,"},{"id":"semetey-1-2013:p1043:b005:l001","ordinal":155752,"en":"Winning their agreement with her wishes"},{"id":"semetey-1-2013:p1043:b005:l002","ordinal":155753,"en":"And duly giving the customary gift."},{"id":"semetey-1-2013:p1043:b005:l003","ordinal":155754,"en":"If you look upon these games,"},{"id":"semetey-1-2013:p1043:b005:l004","ordinal":155755,"en":"Aychürök, whom you have seen,"},{"id":"semetey-1-2013:p1043:b005:l005","ordinal":155756,"en":"Now staged the revelry."},{"id":"semetey-1-2013:p1043:b005:l006","ordinal":155757,"en":"Her dear head beheld joy,"},{"id":"semetey-1-2013:p1043:b005:l007","ordinal":155758,"en":"With maidens and young men mingled together."},{"id":"semetey-1-2013:p1043:b005:l008","ordinal":155759,"en":"Yesterday, your honored sister-in-law Aychürök,"},{"id":"semetey-1-2013:p1043:b005:l009","ordinal":155760,"en":"Hearing words from those who had come,"},{"id":"semetey-1-2013:p1043:b005:l010","ordinal":155761,"en":"Heard that, \"If he sees kumis and a maiden,"},{"id":"semetey-1-2013:p1043:b005:l011","ordinal":155762,"en":"The princely leopard and falcon"},{"id":"semetey-1-2013:p1043:b005:l012","ordinal":155763,"en":"Will die of delight.\""},{"id":"semetey-1-2013:p1043:b005:l013","ordinal":155764,"en":"She prepared things in every fashion;"},{"id":"semetey-1-2013:p1043:b005:l014","ordinal":155765,"en":"Of all that could be prepared,"},{"id":"semetey-1-2013:p1043:b005:l015","ordinal":155766,"en":"Nothing at all was lacking with Chürök."},{"id":"semetey-1-2013:p1043:b005:l016","ordinal":155767,"en":"Eighty young women and eighty maidens,"},{"id":"semetey-1-2013:p1043:b005:l017","ordinal":155768,"en":"Eighty young men and eighty lads"},{"id":"semetey-1-2013:p1043:b005:l018","ordinal":155769,"en":"Sprang about and held their games."},{"id":"semetey-1-2013:p1043:b005:l019","ordinal":155770,"en":"They twisted their kerchiefs"},{"id":"semetey-1-2013:p1043:b005:l020","ordinal":155771,"en":"Into clubs,"},{"id":"semetey-1-2013:p1043:b005:l021","ordinal":155772,"en":"Women and men mingled,"},{"id":"semetey-1-2013:p1043:b005:l022","ordinal":155773,"en":"Striking one another"},{"id":"semetey-1-2013:p1043:b005:l023","ordinal":155774,"en":"As they stood like this."},{"id":"semetey-1-2013:p1043:b005:l024","ordinal":155775,"en":"Women and men mingled,"},{"id":"semetey-1-2013:p1043:b005:l025","ordinal":155776,"en":"Taking turns with the kerchief-club,"},{"id":"semetey-1-2013:p1043:b005:l026","ordinal":155777,"en":"Striking the one each loved,"},{"id":"semetey-1-2013:p1043:b005:l027","ordinal":155778,"en":"And satisfying their desire in this way."},{"id":"semetey-1-2013:p1043:b005:l028","ordinal":155779,"en":"\"These are Aychürök's games,"},{"id":"semetey-1-2013:p1043:b005:l029","ordinal":155780,"en":"The wedding feast of Semetey,\" they said."},{"id":"semetey-1-2013:p1043:b005:l030","ordinal":155781,"en":"One woman and one man,"},{"id":"semetey-1-2013:p1043:b005:l031","ordinal":155782,"en":"Embracing, met as lovers,"},{"id":"semetey-1-2013:p1043:b005:l032","ordinal":155783,"en":"And kissed to ease their longing."},{"id":"semetey-1-2013:p1043:b005:l033","ordinal":155784,"en":"The men sang,"},{"id":"semetey-1-2013:p1043:b005:l034","ordinal":155785,"en":"The women listened,"},{"id":"semetey-1-2013:p1043:b005:l035","ordinal":155786,"en":"And played without tiring."},{"id":"semetey-1-2013:p1043:b005:l036","ordinal":155787,"en":"They went to those they loved,"},{"id":"semetey-1-2013:p1043:b005:l037","ordinal":155788,"en":"Drank kumis and grew merry,"},{"id":"semetey-1-2013:p1043:b005:l038","ordinal":155789,"en":"Their very bones growing warm;"},{"id":"semetey-1-2013:p1043:b005:l039","ordinal":155790,"en":"When one looked upon the edge of their bliss,"},{"id":"semetey-1-2013:p1044:b003:l001","ordinal":155791,"en":"Your dear sister-in-law Aychürök"},{"id":"semetey-1-2013:p1044:b003:l002","ordinal":155792,"en":"Staged revelry of this kind:"},{"id":"semetey-1-2013:p1044:b003:l003","ordinal":155793,"en":"\"Let my precious one enjoy himself;"},{"id":"semetey-1-2013:p1044:b003:l004","ordinal":155794,"en":"Without wondering, 'Where is my elder sister?'"},{"id":"semetey-1-2013:p1044:b003:l005","ordinal":155795,"en":"Or bringing us to mind,"},{"id":"semetey-1-2013:p1044:b003:l006","ordinal":155796,"en":"Let men and women"},{"id":"semetey-1-2013:p1044:b003:l007","ordinal":155797,"en":"Play delightful games,\" she said."},{"id":"semetey-1-2013:p1044:b003:l008","ordinal":155798,"en":"Wise Chürök devised this."},{"id":"semetey-1-2013:p1044:b003:l009","ordinal":155799,"en":"Earlier Chürök had provisions prepared:"},{"id":"semetey-1-2013:p1044:b003:l010","ordinal":155800,"en":"\"If there are games, let them drink.\""},{"id":"semetey-1-2013:p1044:b003:l011","ordinal":155801,"en":"There was black arak at the side,"},{"id":"semetey-1-2013:p1044:b003:l012","ordinal":155802,"en":"And arak in a Kalmyk-style flask."},{"id":"semetey-1-2013:p1044:b003:l013","ordinal":155803,"en":"Receiving Chürök's command,"},{"id":"semetey-1-2013:p1044:b003:l014","ordinal":155804,"en":"They all ran for the arak;"},{"id":"semetey-1-2013:p1044:b003:l015","ordinal":155805,"en":"A young man pulled the stopper and a maiden poured,"},{"id":"semetey-1-2013:p1044:b003:l016","ordinal":155806,"en":"And among the young women, poor Kermekash"},{"id":"semetey-1-2013:p1044:b003:l017","ordinal":155807,"en":"Held it out."},{"id":"semetey-1-2013:p1044:b003:l018","ordinal":155808,"en":"They poured it into wooden bowls,"},{"id":"semetey-1-2013:p1044:b003:l019","ordinal":155809,"en":"And all gathered round."},{"id":"semetey-1-2013:p1044:b003:l020","ordinal":155810,"en":"They found delight in the games,"},{"id":"semetey-1-2013:p1044:b003:l021","ordinal":155811,"en":"Leaving not one person empty-handed,"},{"id":"semetey-1-2013:p1044:b003:l022","ordinal":155812,"en":"And exchanged sarymerden verses."},{"id":"semetey-1-2013:p1044:b003:l023","ordinal":155813,"en":"Drinking arak and raising a din,"},{"id":"semetey-1-2013:p1044:b003:l024","ordinal":155814,"en":"Women and men mingled"},{"id":"semetey-1-2013:p1044:b003:l025","ordinal":155815,"en":"And entered into the clamor;"},{"id":"semetey-1-2013:p1044:b003:l026","ordinal":155816,"en":"An irrepressible merriment"},{"id":"semetey-1-2013:p1044:b003:l027","ordinal":155817,"en":"Had entered the festive throng."},{"id":"semetey-1-2013:p1044:b003:l028","ordinal":155818,"en":"They played in pairs,"},{"id":"semetey-1-2013:p1044:b003:l029","ordinal":155819,"en":"One woman and one man—"},{"id":"semetey-1-2013:p1044:b003:l030","ordinal":155820,"en":"If you would see games, see them here."},{"id":"semetey-1-2013:p1044:b003:l031","ordinal":155821,"en":"They led one another away,"},{"id":"semetey-1-2013:p1044:b003:l032","ordinal":155822,"en":"Coupling two by two;"},{"id":"semetey-1-2013:p1044:b003:l033","ordinal":155823,"en":"Many there were behaving badly."},{"id":"semetey-1-2013:p1044:b003:l034","ordinal":155824,"en":"\"Come now, what kind of person are you?"},{"id":"semetey-1-2013:p1044:b003:l035","ordinal":155825,"en":"You will tell someone,"},{"id":"semetey-1-2013:p1044:b003:l036","ordinal":155826,"en":"And mock me with the tale,\" they said;"},{"id":"semetey-1-2013:p1044:b003:l037","ordinal":155827,"en":"Many quarreled with young men,"},{"id":"semetey-1-2013:p1044:b003:l038","ordinal":155828,"en":"And would not consent."},{"id":"semetey-1-2013:p1044:b003:l039","ordinal":155829,"en":"\"Oh heavens, here is gold,\" they said;"},{"id":"semetey-1-2013:p1044:b004:l001","ordinal":155830,"en":"Many more pleaded."},{"id":"semetey-1-2013:p1044:b004:l002","ordinal":155831,"en":"\"You have ruined what was mine,\" they said,"},{"id":"semetey-1-2013:p1044:b004:l003","ordinal":155832,"en":"Scowling at one another;"},{"id":"semetey-1-2013:p1044:b004:l004","ordinal":155833,"en":"Many took offense."},{"id":"semetey-1-2013:p1044:b004:l005","ordinal":155834,"en":"Their anger flared beyond words,"},{"id":"semetey-1-2013:p1044:b004:l006","ordinal":155835,"en":"And many grappled together;"},{"id":"semetey-1-2013:p1044:b004:l007","ordinal":155836,"en":"Out on the steppe, scowling,"},{"id":"semetey-1-2013:p1044:b004:l008","ordinal":155837,"en":"Many came to blows."},{"id":"semetey-1-2013:p1044:b004:l009","ordinal":155838,"en":"Gripping one another's waistbands,"},{"id":"semetey-1-2013:p1044:b004:l010","ordinal":155839,"en":"\"My love, please consent,\" they said;"},{"id":"semetey-1-2013:p1044:b004:l011","ordinal":155840,"en":"Many hurried about."},{"id":"semetey-1-2013:p1044:b004:l012","ordinal":155841,"en":"\"Someone will see us"},{"id":"semetey-1-2013:p1044:b004:l013","ordinal":155842,"en":"While we are doing it,\" they said;"},{"id":"semetey-1-2013:p1044:b004:l014","ordinal":155843,"en":"And many ran away."},{"id":"semetey-1-2013:p1044:b004:l019","ordinal":155844,"en":"Akylay, daughter of Shooruk,","gapBefore":"[Passage withheld: sexual content involving a minor]"},{"id":"semetey-1-2013:p1044:b004:l020","ordinal":155845,"en":"That lively poor girl,"},{"id":"semetey-1-2013:p1044:b004:l021","ordinal":155846,"en":"Was seized by Külchoro;"},{"id":"semetey-1-2013:p1044:b004:l022","ordinal":155847,"en":"They went to a dark place,"},{"id":"semetey-1-2013:p1044:b004:l023","ordinal":155848,"en":"And remained there embracing,"},{"id":"semetey-1-2013:p1044:b004:l024","ordinal":155849,"en":"Taking a shortcut by a narrow path."},{"id":"semetey-1-2013:p1044:b004:l025","ordinal":155850,"en":"Baytaylak, son of Bakay,"},{"id":"semetey-1-2013:p1044:b004:l026","ordinal":155851,"en":"Led Kermekash,"},{"id":"semetey-1-2013:p1044:b004:l027","ordinal":155852,"en":"The foremost of the young women;"},{"id":"semetey-1-2013:p1044:b004:l028","ordinal":155853,"en":"Kalyk of Sarykan"},{"id":"semetey-1-2013:p1044:b004:l029","ordinal":155854,"en":"Had taken hold of Umsunay;"},{"id":"semetey-1-2013:p1044:b004:l030","ordinal":155855,"en":"And Shayymbet, son of Zhamgyrchy,"},{"id":"semetey-1-2013:p1044:b004:l031","ordinal":155856,"en":"Mounted the beauty"},{"id":"semetey-1-2013:p1044:b004:l032","ordinal":155857,"en":"Named Ayymkan."},{"id":"semetey-1-2013:p1044:b004:l033","ordinal":155858,"en":"Women and men mingled,"},{"id":"semetey-1-2013:p1044:b004:l034","ordinal":155859,"en":"Played until they were spent;"},{"id":"semetey-1-2013:p1044:b004:l035","ordinal":155860,"en":"A great revel appeared."},{"id":"semetey-1-2013:p1044:b004:l036","ordinal":155861,"en":"They divided two by two,"},{"id":"semetey-1-2013:p1044:b004:l037","ordinal":155862,"en":"Finding the games delightful,"},{"id":"semetey-1-2013:p1044:b004:l038","ordinal":155863,"en":"And raced three-year-old horses against each other;"},{"id":"semetey-1-2013:p1044:b004:l039","ordinal":155864,"en":"Maidens and young men side by side,"},{"id":"semetey-1-2013:p1045:b003:l001","ordinal":155865,"en":"Such was the revelry she staged."},{"id":"semetey-1-2013:p1045:b003:l002","ordinal":155866,"en":"The games of maidens and young men—"},{"id":"semetey-1-2013:p1045:b003:l003","ordinal":155867,"en":"Let us leave them here like this."},{"id":"semetey-1-2013:p1045:b003:l004","ordinal":155868,"en":"Of your dear Chürök and Semetey,"},{"id":"semetey-1-2013:p1045:b003:l005","ordinal":155869,"en":"Let us now begin the tale."},{"id":"semetey-1-2013:p1045:b003:l006","ordinal":155870,"en":"Sixty pillows and forty quilts,"},{"id":"semetey-1-2013:p1045:b003:l007","ordinal":155871,"en":"She had lavishly spread as bedding;"},{"id":"semetey-1-2013:p1045:b003:l008","ordinal":155872,"en":"It was a wondrous spectacle,"},{"id":"semetey-1-2013:p1045:b003:l009","ordinal":155873,"en":"Filling the human heart with affection."},{"id":"semetey-1-2013:p1045:b003:l010","ordinal":155874,"en":"She had a curtain made of pure silk"},{"id":"semetey-1-2013:p1045:b003:l011","ordinal":155875,"en":"Stretched broadly across the wall;"},{"id":"semetey-1-2013:p1045:b003:l012","ordinal":155876,"en":"Aychürök, daughter of Akun,"},{"id":"semetey-1-2013:p1045:b003:l013","ordinal":155877,"en":"Increased her splendor in this way."},{"id":"semetey-1-2013:p1045:b003:l014","ordinal":155878,"en":"Her incomparable conqueror,"},{"id":"semetey-1-2013:p1045:b003:l015","ordinal":155879,"en":"Her princely leopard and sultan—"},{"id":"semetey-1-2013:p1045:b003:l016","ordinal":155880,"en":"Swiftly she removed his boots,"},{"id":"semetey-1-2013:p1045:b003:l017","ordinal":155881,"en":"And nimbly removed his clothes;"},{"id":"semetey-1-2013:p1045:b003:l018","ordinal":155882,"en":"She laid the prince and sultan down"},{"id":"semetey-1-2013:p1045:b003:l019","ordinal":155883,"en":"Upon the great bed for delight."},{"id":"semetey-1-2013:p1045:b003:l020","ordinal":155884,"en":"After the sultan had lain down,"},{"id":"semetey-1-2013:p1045:b003:l021","ordinal":155885,"en":"Aychürök, daughter of Akun—"},{"id":"semetey-1-2013:p1045:b003:l022","ordinal":155886,"en":"Know her purity from this—"},{"id":"semetey-1-2013:p1045:b003:l023","ordinal":155887,"en":"Now put her hands into water"},{"id":"semetey-1-2013:p1045:b003:l024","ordinal":155888,"en":"And performed the hand ablution;"},{"id":"semetey-1-2013:p1045:b003:l025","ordinal":155889,"en":"She poured the water of ghusl over herself,"},{"id":"semetey-1-2013:p1045:b003:l026","ordinal":155890,"en":"Purified herself and prepared,"},{"id":"semetey-1-2013:p1045:b003:l027","ordinal":155891,"en":"And prayed to the Almighty."},{"id":"semetey-1-2013:p1045:b003:l028","ordinal":155892,"en":"Preparing to lie in the embrace"},{"id":"semetey-1-2013:p1045:b003:l029","ordinal":155893,"en":"Of the poor sultan,"},{"id":"semetey-1-2013:p1045:b003:l030","ordinal":155894,"en":"\"If only I reach my gray-maned wolf,\" she thought;"},{"id":"semetey-1-2013:p1045:b003:l031","ordinal":155895,"en":"Had she not endured in longing,"},{"id":"semetey-1-2013:p1045:b003:l032","ordinal":155896,"en":"Never approaching any person,"},{"id":"semetey-1-2013:p1045:b003:l033","ordinal":155897,"en":"And lived unharmed?"},{"id":"semetey-1-2013:p1045:b003:l034","ordinal":155898,"en":"The gray wolf lay huddled,"},{"id":"semetey-1-2013:p1045:b003:l035","ordinal":155899,"en":"His thoughts sorely distracted;"},{"id":"semetey-1-2013:p1045:b003:l036","ordinal":155900,"en":"Aychürök, daughter of Akun,"},{"id":"semetey-1-2013:p1045:b003:l037","ordinal":155901,"en":"Appeared like the whole world to him."},{"id":"semetey-1-2013:p1045:b003:l038","ordinal":155902,"en":"Fragrant as musk, gleaming like copper,"},{"id":"semetey-1-2013:p1045:b003:l039","ordinal":155903,"en":"She appeared like a fairy maiden."},{"id":"semetey-1-2013:p1045:b004:l001","ordinal":155904,"en":"Your prince's thoughts were swept away;"}]
