{"id": "sayakbay-ms-current142:pdf026:l062", "source_id": "sayakbay-ms-current142", "pdf_sha256": "2b1fd33d35b9fec662724180743e44a26bc44d8b347d5f99c373acf98cb6c73f", "page": 26, "folio": 2343, "line_in_page": 62, "raw": "Олжону бөлүшүп эр өлмөк,", "text": "Олжону бөлүшүп эр өлмөк,", "en": "Dividing the booty, a hero was to die,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Final verb is faint.", "bbox": null}
