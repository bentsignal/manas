[{"id":"semetey-1-2013:p1173:b003:l011","ordinal":166657,"en":"I will see the face of Judgment Day,\" I said."},{"id":"semetey-1-2013:p1173:b003:l012","ordinal":166658,"en":"When Manas returned to Talas,"},{"id":"semetey-1-2013:p1173:b003:l013","ordinal":166659,"en":"My poor soul sought vengeance"},{"id":"semetey-1-2013:p1173:b003:l014","ordinal":166660,"en":"To catch him from behind,"},{"id":"semetey-1-2013:p1173:b003:l015","ordinal":166661,"en":"To stalk the bloodletter"},{"id":"semetey-1-2013:p1173:b003:l016","ordinal":166662,"en":"And offer him as a sacrifice,"},{"id":"semetey-1-2013:p1173:b003:l017","ordinal":166663,"en":"And thus take revenge"},{"id":"semetey-1-2013:p1173:b003:l018","ordinal":166664,"en":"For being left unmarried."},{"id":"semetey-1-2013:p1173:b003:l019","ordinal":166665,"en":"My poor hair, thick as sedge,"},{"id":"semetey-1-2013:p1173:b003:l020","ordinal":166666,"en":"I tied tightly atop my head,"},{"id":"semetey-1-2013:p1173:b003:l021","ordinal":166667,"en":"And put on a man's clothing."},{"id":"semetey-1-2013:p1173:b003:l022","ordinal":166668,"en":"A golden-cheeked battle-axe"},{"id":"semetey-1-2013:p1173:b003:l023","ordinal":166669,"en":"I fastened firmly to my arm;"},{"id":"semetey-1-2013:p1173:b003:l024","ordinal":166670,"en":"The double-edged Zulpukor"},{"id":"semetey-1-2013:p1173:b003:l025","ordinal":166671,"en":"I strapped on loosely."},{"id":"semetey-1-2013:p1173:b003:l026","ordinal":166672,"en":"When I pursued"},{"id":"semetey-1-2013:p1173:b003:l027","ordinal":166673,"en":"Generous Lord Manas,"},{"id":"semetey-1-2013:p1173:b003:l028","ordinal":166674,"en":"Firing a gun and drawing a bow,"},{"id":"semetey-1-2013:p1173:b003:l029","ordinal":166675,"en":"Thinking to stalk and slaughter him,"},{"id":"semetey-1-2013:p1173:b003:l030","ordinal":166676,"en":"To put the broad-chested lord"},{"id":"semetey-1-2013:p1173:b003:l031","ordinal":166677,"en":"To death,"},{"id":"semetey-1-2013:p1173:b003:l032","ordinal":166678,"en":"I advanced in terrible rage,"},{"id":"semetey-1-2013:p1173:b003:l033","ordinal":166679,"en":"Saying I had been left unmarried as a girl—"},{"id":"semetey-1-2013:p1173:b003:l034","ordinal":166680,"en":"A grievous wrong before all the world;"},{"id":"semetey-1-2013:p1173:b003:l035","ordinal":166681,"en":"Among the Kyrgyz there is no such deed."},{"id":"semetey-1-2013:p1173:b003:l036","ordinal":166682,"en":"When I stalked the leopard,"},{"id":"semetey-1-2013:p1173:b003:l037","ordinal":166683,"en":"He had camped"},{"id":"semetey-1-2013:p1173:b003:l038","ordinal":166684,"en":"On a spur of the accursed mountain,"},{"id":"semetey-1-2013:p1173:b003:l039","ordinal":166685,"en":"Playing chatyrash and making merry;"},{"id":"semetey-1-2013:p1173:b004:l001","ordinal":166686,"en":"So he was passing his time."},{"id":"semetey-1-2013:p1173:b004:l002","ordinal":166687,"en":"They were slaughtering"},{"id":"semetey-1-2013:p1173:b004:l003","ordinal":166688,"en":"Forty barren foals."},{"id":"semetey-1-2013:p1173:b004:l004","ordinal":166689,"en":"Without a care for worldly goods,"},{"id":"semetey-1-2013:p1173:b004:l005","ordinal":166690,"en":"He was living in pleasure."},{"id":"semetey-1-2013:p1173:b004:l006","ordinal":166691,"en":"All forty companions"},{"id":"semetey-1-2013:p1173:b004:l007","ordinal":166692,"en":"Surrounded the hero"},{"id":"semetey-1-2013:p1173:b004:l008","ordinal":166693,"en":"In a circle."},{"id":"semetey-1-2013:p1173:b004:l009","ordinal":166694,"en":"The hero of the forty companions,"},{"id":"semetey-1-2013:p1173:b004:l010","ordinal":166695,"en":"Saintly hero Bakay,"},{"id":"semetey-1-2013:p1173:b004:l011","ordinal":166696,"en":"The valiant one among them all,"},{"id":"semetey-1-2013:p1173:b004:l012","ordinal":166697,"en":"Had readied his bow, poor soul."},{"id":"semetey-1-2013:p1173:b004:l013","ordinal":166698,"en":"As I meant to shoot Manas,"},{"id":"semetey-1-2013:p1173:b004:l014","ordinal":166699,"en":"Grease issued from my fingers"},{"id":"semetey-1-2013:p1173:b004:l015","ordinal":166700,"en":"And blood from beneath my nails."},{"id":"semetey-1-2013:p1173:b004:l016","ordinal":166701,"en":"When I raised the bow to my face"},{"id":"semetey-1-2013:p1173:b004:l017","ordinal":166702,"en":"And drew near the valiant man,"},{"id":"semetey-1-2013:p1173:b004:l018","ordinal":166703,"en":"Nine guardian spirits"},{"id":"semetey-1-2013:p1173:b004:l019","ordinal":166704,"en":"Stood at the armpit"},{"id":"semetey-1-2013:p1173:b004:l020","ordinal":166705,"en":"Of the hero favored by Khojos;"},{"id":"semetey-1-2013:p1173:b004:l021","ordinal":166706,"en":"Forty chiltens supported him"},{"id":"semetey-1-2013:p1173:b004:l022","ordinal":166707,"en":"And fixed their precious gaze upon him."},{"id":"semetey-1-2013:p1173:b004:l023","ordinal":166708,"en":"All forty lions"},{"id":"semetey-1-2013:p1173:b004:l024","ordinal":166709,"en":"Had then surrounded"},{"id":"semetey-1-2013:p1173:b004:l025","ordinal":166710,"en":"The hero."},{"id":"semetey-1-2013:p1173:b004:l026","ordinal":166711,"en":"A black-striped leopard"},{"id":"semetey-1-2013:p1173:b004:l027","ordinal":166712,"en":"Strained at his side."},{"id":"semetey-1-2013:p1173:b004:l028","ordinal":166713,"en":"Unable to endure the sight,"},{"id":"semetey-1-2013:p1173:b004:l029","ordinal":166714,"en":"When I saw his guardians,"},{"id":"semetey-1-2013:p1173:b004:l030","ordinal":166715,"en":"I thought, \"Alas, lion and leopard,"},{"id":"semetey-1-2013:p1173:b004:l031","ordinal":166716,"en":"Let him leave me unmarried if he wishes;"},{"id":"semetey-1-2013:p1173:b004:l032","ordinal":166717,"en":"Let his heart make me a concubine if it wishes."},{"id":"semetey-1-2013:p1173:b004:l033","ordinal":166718,"en":"If he will not take me from Bukhara,"},{"id":"semetey-1-2013:p1173:b004:l034","ordinal":166719,"en":"I will gather girls from forty households,"},{"id":"semetey-1-2013:p1173:b004:l035","ordinal":166720,"en":"Go stay in a white yurt,"},{"id":"semetey-1-2013:p1173:b004:l036","ordinal":166721,"en":"And ingratiate myself as his wife.\""},{"id":"semetey-1-2013:p1173:b004:l037","ordinal":166722,"en":"I formed this plan,"},{"id":"semetey-1-2013:p1173:b004:l038","ordinal":166723,"en":"Turned back my black-blazed courser,"},{"id":"semetey-1-2013:p1173:b004:l039","ordinal":166724,"en":"And galloped away,"},{"id":"semetey-1-2013:p1174:b003:l001","ordinal":166725,"en":"Heading toward Bukhara."},{"id":"semetey-1-2013:p1174:b003:l002","ordinal":166726,"en":"At the nose of the accursed mountain,"},{"id":"semetey-1-2013:p1174:b003:l003","ordinal":166727,"en":"At its looming promontory,"},{"id":"semetey-1-2013:p1174:b003:l004","ordinal":166728,"en":"Just as I reached it,"},{"id":"semetey-1-2013:p1174:b003:l005","ordinal":166729,"en":"When I turned my horse's head,"},{"id":"semetey-1-2013:p1174:b003:l006","ordinal":166730,"en":"He was clearing the road,"},{"id":"semetey-1-2013:p1174:b003:l007","ordinal":166731,"en":"Standing watch,"},{"id":"semetey-1-2013:p1174:b003:l008","ordinal":166732,"en":"Mounted on a red chestnut horse,"},{"id":"semetey-1-2013:p1174:b003:l009","ordinal":166733,"en":"Its hair tail tightly knotted,"},{"id":"semetey-1-2013:p1174:b003:l010","ordinal":166734,"en":"Finding no mountain to assail,"},{"id":"semetey-1-2013:p1174:b003:l011","ordinal":166735,"en":"Finding no enemy to fight,"},{"id":"semetey-1-2013:p1174:b003:l012","ordinal":166736,"en":"Consumed by his own thoughts."},{"id":"semetey-1-2013:p1174:b003:l013","ordinal":166737,"en":"Like an eagle of Orolmo-Too,"},{"id":"semetey-1-2013:p1174:b003:l014","ordinal":166738,"en":"Perched without a wrist-rest,"},{"id":"semetey-1-2013:p1174:b003:l015","ordinal":166739,"en":"I saw hero Agysh"},{"id":"semetey-1-2013:p1174:b003:l016","ordinal":166740,"en":"Riding out toward me."},{"id":"semetey-1-2013:p1174:b003:l017","ordinal":166741,"en":"When I saw hero Agysh,"},{"id":"semetey-1-2013:p1174:b003:l018","ordinal":166742,"en":"His whole body was sinew;"},{"id":"semetey-1-2013:p1174:b003:l019","ordinal":166743,"en":"He was a man useful in need,"},{"id":"semetey-1-2013:p1174:b003:l020","ordinal":166744,"en":"A lion kinsman of generous spirit."},{"id":"semetey-1-2013:p1174:b003:l021","ordinal":166745,"en":"Against a champion like Tukubay,"},{"id":"semetey-1-2013:p1174:b003:l022","ordinal":166746,"en":"Agysh will serve, O people;"},{"id":"semetey-1-2013:p1174:b003:l023","ordinal":166747,"en":"To wrestle and win honor,"},{"id":"semetey-1-2013:p1174:b003:l024","ordinal":166748,"en":"Put elbow-sized Agysh,"},{"id":"semetey-1-2013:p1174:b003:l025","ordinal":166749,"en":"O lion and leopard lord,"},{"id":"semetey-1-2013:p1174:b003:l026","ordinal":166750,"en":"Into the wrestling match."},{"id":"semetey-1-2013:p1174:b003:l027","ordinal":166751,"en":"Peerless Agysh was a hero;"},{"id":"semetey-1-2013:p1174:b003:l028","ordinal":166752,"en":"When infidel and Muslim"},{"id":"semetey-1-2013:p1174:b003:l029","ordinal":166753,"en":"Clashed together,"},{"id":"semetey-1-2013:p1174:b003:l030","ordinal":166754,"en":"He was a man who won honor."},{"id":"semetey-1-2013:p1174:b003:l031","ordinal":166755,"en":"When I saw hero Agysh,"},{"id":"semetey-1-2013:p1174:b003:l032","ordinal":166756,"en":"His strength was immense;"},{"id":"semetey-1-2013:p1174:b003:l033","ordinal":166757,"en":"The valiant, highborn champion"},{"id":"semetey-1-2013:p1174:b003:l034","ordinal":166758,"en":"Was himself a mighty hero."},{"id":"semetey-1-2013:p1174:b003:l035","ordinal":166759,"en":"Fierce champion Tukubay"},{"id":"semetey-1-2013:p1174:b003:l036","ordinal":166760,"en":"Was a man fit for him to grapple."},{"id":"semetey-1-2013:p1174:b003:l037","ordinal":166761,"en":"To throw him and win honor,"},{"id":"semetey-1-2013:p1174:b003:l038","ordinal":166762,"en":"My joyous leopard lord,"},{"id":"semetey-1-2013:p1174:b003:l039","ordinal":166763,"en":"Agysh is the champion you have found.\""},{"id":"semetey-1-2013:p1174:b004:l001","ordinal":166764,"en":"The wrathful leopard"},{"id":"semetey-1-2013:p1174:b004:l002","ordinal":166765,"en":"Heeded the queen's words."},{"id":"semetey-1-2013:p1174:b004:l003","ordinal":166766,"en":"Twelve companions and Kyrgylchal"},{"id":"semetey-1-2013:p1174:b004:l004","ordinal":166767,"en":"Received the hero's command"},{"id":"semetey-1-2013:p1174:b004:l005","ordinal":166768,"en":"And went to seek Agysh."},{"id":"semetey-1-2013:p1174:b004:l006","ordinal":166769,"en":"Though they searched mountain and hill,"},{"id":"semetey-1-2013:p1174:b004:l007","ordinal":166770,"en":"Agysh could not be found there."},{"id":"semetey-1-2013:p1174:b004:l008","ordinal":166771,"en":"Though they searched the gathered people,"},{"id":"semetey-1-2013:p1174:b004:l009","ordinal":166772,"en":"Agysh could not be found there."},{"id":"semetey-1-2013:p1174:b004:l010","ordinal":166773,"en":"He had had his tent adorned with gold."},{"id":"semetey-1-2013:p1174:b004:l011","ordinal":166774,"en":"When they migrated from Tashkent,"},{"id":"semetey-1-2013:p1174:b004:l012","ordinal":166775,"en":"Saying, \"Let them provide adornment,\""},{"id":"semetey-1-2013:p1174:b004:l013","ordinal":166776,"en":"Kokotoy's Bokmurun"},{"id":"semetey-1-2013:p1174:b004:l014","ordinal":166777,"en":"Summoned exactly sixty palace girls,"},{"id":"semetey-1-2013:p1174:b004:l015","ordinal":166778,"en":"And had those girls brought."},{"id":"semetey-1-2013:p1174:b004:l016","ordinal":166779,"en":"At Khan Kokotoy's feast,"},{"id":"semetey-1-2013:p1174:b004:l017","ordinal":166780,"en":"The palace girls were playing"},{"id":"semetey-1-2013:p1174:b004:l018","ordinal":166781,"en":"Along Jele-Karkyra."},{"id":"semetey-1-2013:p1174:b004:l019","ordinal":166782,"en":"Your unruly ruffian Agysh"},{"id":"semetey-1-2013:p1174:b004:l020","ordinal":166783,"en":"Had gone to the palace girls"},{"id":"semetey-1-2013:p1174:b004:l021","ordinal":166784,"en":"And was playing splendid games."},{"id":"semetey-1-2013:p1174:b004:l022","ordinal":166785,"en":"A great player, a girl's delight—"},{"id":"semetey-1-2013:p1174:b004:l023","ordinal":166786,"en":"Such was your Agysh's way."},{"id":"semetey-1-2013:p1174:b004:l024","ordinal":166787,"en":"In a house with girls, he played the fiddle;"},{"id":"semetey-1-2013:p1174:b004:l025","ordinal":166788,"en":"In a house with kumis, he served the cups."},{"id":"semetey-1-2013:p1174:b004:l026","ordinal":166789,"en":"With his red belt trailing—"},{"id":"semetey-1-2013:p1174:b004:l027","ordinal":166790,"en":"Such was Agysh's way—"},{"id":"semetey-1-2013:p1174:b004:l028","ordinal":166791,"en":"Whenever he saw a girl, he asked for her."},{"id":"semetey-1-2013:p1174:b004:l029","ordinal":166792,"en":"With his black belt trailing—"},{"id":"semetey-1-2013:p1174:b004:l030","ordinal":166793,"en":"Such was Agysh's way—"},{"id":"semetey-1-2013:p1174:b004:l031","ordinal":166794,"en":"Whenever he saw a woman, he asked for her."},{"id":"semetey-1-2013:p1174:b004:l032","ordinal":166795,"en":"When he saw a girl, he grew animated"},{"id":"semetey-1-2013:p1174:b004:l033","ordinal":166796,"en":"And began a splendid song;"},{"id":"semetey-1-2013:p1174:b004:l034","ordinal":166797,"en":"When hero Agysh saw a woman,"},{"id":"semetey-1-2013:p1174:b004:l035","ordinal":166798,"en":"He nearly died of longing."},{"id":"semetey-1-2013:p1174:b004:l036","ordinal":166799,"en":"Hero Agysh was staying"},{"id":"semetey-1-2013:p1174:b004:l037","ordinal":166800,"en":"With the palace girls."},{"id":"semetey-1-2013:p1174:b004:l038","ordinal":166801,"en":"Kumis by day and girls by night—"},{"id":"semetey-1-2013:p1174:b004:l039","ordinal":166802,"en":"So he was passing his time."},{"id":"semetey-1-2013:p1175:b003:l001","ordinal":166803,"en":"A blue lynx coat and a black cap—"},{"id":"semetey-1-2013:p1175:b003:l002","ordinal":166804,"en":"Such was his splendid attire."},{"id":"semetey-1-2013:p1175:b003:l003","ordinal":166805,"en":"There he made merry;"},{"id":"semetey-1-2013:p1175:b003:l004","ordinal":166806,"en":"What else could dear Agysh do?"},{"id":"semetey-1-2013:p1175:b003:l005","ordinal":166807,"en":"He was enjoying himself."},{"id":"semetey-1-2013:p1175:b003:l006","ordinal":166808,"en":"The twelve choros, led by Kyrgylchal,"},{"id":"semetey-1-2013:p1175:b003:l007","ordinal":166809,"en":"Had gone to bring the news."},{"id":"semetey-1-2013:p1175:b003:l008","ordinal":166810,"en":"As though slaughter had fallen"},{"id":"semetey-1-2013:p1175:b003:l009","ordinal":166811,"en":"Upon brave Agysh,"},{"id":"semetey-1-2013:p1175:b003:l010","ordinal":166812,"en":"Old Kyrgyl, their leader,"},{"id":"semetey-1-2013:p1175:b003:l011","ordinal":166813,"en":"Collapsed in ruin."},{"id":"semetey-1-2013:p1175:b003:l012","ordinal":166814,"en":"When they came to brave Agysh,"},{"id":"semetey-1-2013:p1175:b003:l013","ordinal":166815,"en":"Speaking softly but gravely,"},{"id":"semetey-1-2013:p1175:b003:l014","ordinal":166816,"en":"Kyrgylchal began his speech:"},{"id":"semetey-1-2013:p1175:b003:l015","ordinal":166817,"en":"“Hero Agysh, hear my words."},{"id":"semetey-1-2013:p1175:b003:l016","ordinal":166818,"en":"It is Khan Kökötöy’s funeral feast,"},{"id":"semetey-1-2013:p1175:b003:l017","ordinal":166819,"en":"And all the people have gathered there."},{"id":"semetey-1-2013:p1175:b003:l018","ordinal":166820,"en":"Infidel and Muslim alike—"},{"id":"semetey-1-2013:p1175:b003:l019","ordinal":166821,"en":"Bloodthirsty Manas is their leader."},{"id":"semetey-1-2013:p1175:b003:l020","ordinal":166822,"en":"The infidels’ champion, Hairy-Sole,"},{"id":"semetey-1-2013:p1175:b003:l021","ordinal":166823,"en":"Has brought the end of the age."},{"id":"semetey-1-2013:p1175:b003:l022","ordinal":166824,"en":"His eyes are like the sockets of a shield;"},{"id":"semetey-1-2013:p1175:b003:l023","ordinal":166825,"en":"Tükübai is a gray-maned wolf,"},{"id":"semetey-1-2013:p1175:b003:l024","ordinal":166826,"en":"As though he would devour whoever he sees."},{"id":"semetey-1-2013:p1175:b003:l025","ordinal":166827,"en":"Manas has sent us to seek you."},{"id":"semetey-1-2013:p1175:b003:l026","ordinal":166828,"en":"He has six fleet horses,"},{"id":"semetey-1-2013:p1175:b003:l027","ordinal":166829,"en":"And generous lord Manas"},{"id":"semetey-1-2013:p1175:b003:l028","ordinal":166830,"en":"Has sent a palm-sized letter."},{"id":"semetey-1-2013:p1175:b003:l029","ordinal":166831,"en":"You bear the name of a young warrior;"},{"id":"semetey-1-2013:p1175:b003:l030","ordinal":166832,"en":"Choose a thoroughbred and ride."},{"id":"semetey-1-2013:p1175:b003:l031","ordinal":166833,"en":"Kanykei saw you from afar"},{"id":"semetey-1-2013:p1175:b003:l032","ordinal":166834,"en":"And fixed her special gaze on you;"},{"id":"semetey-1-2013:p1175:b003:l033","ordinal":166835,"en":"She has taken a great liking to you."},{"id":"semetey-1-2013:p1175:b003:l034","ordinal":166836,"en":"If your death has come, go and die;"},{"id":"semetey-1-2013:p1175:b003:l035","ordinal":166837,"en":"But if fortune favors you, brave Agysh,"},{"id":"semetey-1-2013:p1175:b003:l036","ordinal":166838,"en":"Split an infidel like Tükübai"},{"id":"semetey-1-2013:p1175:b003:l037","ordinal":166839,"en":"Cleanly into two."},{"id":"semetey-1-2013:p1175:b003:l038","ordinal":166840,"en":"Hook him and trip him from within;"},{"id":"semetey-1-2013:p1175:b003:l039","ordinal":166841,"en":"Tükübai is formidable,"},{"id":"semetey-1-2013:p1175:b004:l001","ordinal":166842,"en":"But win us a prize from the Chinese."},{"id":"semetey-1-2013:p1175:b004:l002","ordinal":166843,"en":"There are infidels like black beetles,"},{"id":"semetey-1-2013:p1175:b004:l003","ordinal":166844,"en":"And hero Khan Kongurbai is there."},{"id":"semetey-1-2013:p1175:b004:l004","ordinal":166845,"en":"He has gathered many champions,"},{"id":"semetey-1-2013:p1175:b004:l005","ordinal":166846,"en":"Saying, ‘I will throw down the Buruts.’"},{"id":"semetey-1-2013:p1175:b004:l006","ordinal":166847,"en":"The wretch has come for that purpose;"},{"id":"semetey-1-2013:p1175:b004:l007","ordinal":166848,"en":"Tükübai has entered the wrestling."},{"id":"semetey-1-2013:p1175:b004:l008","ordinal":166849,"en":"Against a palm-sized Burut,"},{"id":"semetey-1-2013:p1175:b004:l009","ordinal":166850,"en":"He has come to settle matters."},{"id":"semetey-1-2013:p1175:b004:l010","ordinal":166851,"en":"Elbow-sized brave Agysh,"},{"id":"semetey-1-2013:p1175:b004:l011","ordinal":166852,"en":"What are you like as a wrestler?"},{"id":"semetey-1-2013:p1175:b004:l012","ordinal":166853,"en":"Hear my words, Agysh."},{"id":"semetey-1-2013:p1175:b004:l013","ordinal":166854,"en":"Wondering, ‘Can he win the prize?’"},{"id":"semetey-1-2013:p1175:b004:l014","ordinal":166855,"en":"Your own kinswoman sent us."},{"id":"semetey-1-2013:p1175:b004:l015","ordinal":166856,"en":"Against that hideous infidel,"},{"id":"semetey-1-2013:p1175:b004:l016","ordinal":166857,"en":"Stand and wrestle him."},{"id":"semetey-1-2013:p1175:b004:l017","ordinal":166858,"en":"For the palm-sized Muslims,"},{"id":"semetey-1-2013:p1175:b004:l018","ordinal":166859,"en":"Win the true prize."},{"id":"semetey-1-2013:p1175:b004:l019","ordinal":166860,"en":"If your strength begins to fail,"},{"id":"semetey-1-2013:p1175:b004:l020","ordinal":166861,"en":"Endure disgrace from the wrestler."},{"id":"semetey-1-2013:p1175:b004:l021","ordinal":166862,"en":"Never let them say Agysh was thrown;"},{"id":"semetey-1-2013:p1175:b004:l022","ordinal":166863,"en":"If the prize is lost,"},{"id":"semetey-1-2013:p1175:b004:l023","ordinal":166864,"en":"Do not live on—die there."},{"id":"semetey-1-2013:p1175:b004:l024","ordinal":166865,"en":"If you are a champion, Agysh,"},{"id":"semetey-1-2013:p1175:b004:l025","ordinal":166866,"en":"Tear apart the ribs"},{"id":"semetey-1-2013:p1175:b004:l026","ordinal":166867,"en":"Of an infidel like Tükübai."},{"id":"semetey-1-2013:p1175:b004:l027","ordinal":166868,"en":"If you heed me, know that"},{"id":"semetey-1-2013:p1175:b004:l028","ordinal":166869,"en":"I myself have come to you, brave Agysh."},{"id":"semetey-1-2013:p1175:b004:l029","ordinal":166870,"en":"To put you into the wrestling,"},{"id":"semetey-1-2013:p1175:b004:l030","ordinal":166871,"en":"Your time has come, brave Agysh."},{"id":"semetey-1-2013:p1175:b004:l031","ordinal":166872,"en":"Go grapple fiercely"},{"id":"semetey-1-2013:p1175:b004:l032","ordinal":166873,"en":"With that swaggering swine;"},{"id":"semetey-1-2013:p1175:b004:l033","ordinal":166874,"en":"From the hulking, mountain-like infidel,"},{"id":"semetey-1-2013:p1175:b004:l034","ordinal":166875,"en":"Win us one prize.”"},{"id":"semetey-1-2013:p1175:b004:l035","ordinal":166876,"en":"Kyrgylchal, leader of the Forty,"},{"id":"semetey-1-2013:p1175:b004:l036","ordinal":166877,"en":"With the twelve choros at his head,"},{"id":"semetey-1-2013:p1175:b004:l037","ordinal":166878,"en":"Selected Agysh"},{"id":"semetey-1-2013:p1175:b004:l038","ordinal":166879,"en":"And drove him to the place"},{"id":"semetey-1-2013:p1175:b004:l039","ordinal":166880,"en":"Where all the people had gathered."},{"id":"semetey-1-2013:p1176:b003:l001","ordinal":166881,"en":"To Khan Manas’s encampment"},{"id":"semetey-1-2013:p1176:b003:l002","ordinal":166882,"en":"Dear Agysh came."},{"id":"semetey-1-2013:p1176:b003:l003","ordinal":166883,"en":"They dressed him in badana armor;"},{"id":"semetey-1-2013:p1176:b003:l004","ordinal":166884,"en":"Badana was the name of the trousers."},{"id":"semetey-1-2013:p1176:b003:l005","ordinal":166885,"en":"They made him run up and down;"},{"id":"semetey-1-2013:p1176:b003:l006","ordinal":166886,"en":"Those badana trousers were exceptional,"},{"id":"semetey-1-2013:p1176:b003:l007","ordinal":166887,"en":"Fashioned to fit him"},{"id":"semetey-1-2013:p1176:b003:l008","ordinal":166888,"en":"By your poor, fair sister-in-law."},{"id":"semetey-1-2013:p1176:b003:l009","ordinal":166889,"en":"Silk within and cotton cloth without,"},{"id":"semetey-1-2013:p1176:b003:l010","ordinal":166890,"en":"Double-layered badana with lark-eye links:"},{"id":"semetey-1-2013:p1176:b003:l011","ordinal":166891,"en":"Fire would not pass through if tinder burned,"},{"id":"semetey-1-2013:p1176:b003:l012","ordinal":166892,"en":"Nor a bullet if a musket fired."},{"id":"semetey-1-2013:p1176:b003:l013","ordinal":166893,"en":"Now was the time to wear them."},{"id":"semetey-1-2013:p1176:b003:l014","ordinal":166894,"en":"They were half a kez thick."},{"id":"semetey-1-2013:p1176:b003:l015","ordinal":166895,"en":"From a treasury saddlebag,"},{"id":"semetey-1-2013:p1176:b003:l016","ordinal":166896,"en":"The unfortunate khan’s wife"},{"id":"semetey-1-2013:p1176:b003:l017","ordinal":166897,"en":"Displayed her careful provision;"},{"id":"semetey-1-2013:p1176:b003:l018","ordinal":166898,"en":"Upon Agysh, as was fitting,"},{"id":"semetey-1-2013:p1176:b003:l019","ordinal":166899,"en":"She put the badana armor."},{"id":"semetey-1-2013:p1176:b003:l020","ordinal":166900,"en":"When they saw her provision,"},{"id":"semetey-1-2013:p1176:b003:l021","ordinal":166901,"en":"Infidel and Muslim,"},{"id":"semetey-1-2013:p1176:b003:l022","ordinal":166902,"en":"All the assembled people,"},{"id":"semetey-1-2013:p1176:b003:l023","ordinal":166903,"en":"And khans as huge as mountains,"},{"id":"semetey-1-2013:p1176:b003:l024","ordinal":166904,"en":"Said, “She is truly a lord’s wife,”"},{"id":"semetey-1-2013:p1176:b003:l025","ordinal":166905,"en":"And every khan was pleased."},{"id":"semetey-1-2013:p1176:b003:l026","ordinal":166906,"en":"Her chest held riches beyond count;"},{"id":"semetey-1-2013:p1176:b003:l027","ordinal":166907,"en":"Kanysh, wife of Manas,"},{"id":"semetey-1-2013:p1176:b003:l028","ordinal":166908,"en":"Had everything one could name."},{"id":"semetey-1-2013:p1176:b003:l029","ordinal":166909,"en":"Against the mountain-sized champion,"},{"id":"semetey-1-2013:p1176:b003:l030","ordinal":166910,"en":"Elbow-sized brave Agysh,"},{"id":"semetey-1-2013:p1176:b003:l031","ordinal":166911,"en":"All sinew from head to foot,"},{"id":"semetey-1-2013:p1176:b003:l032","ordinal":166912,"en":"Stepped forward then,"}]
