[{"id":"semetey-1-2013:p1406:b003:l006","ordinal":183553,"en":"Tethered his dapple-gray steed."},{"id":"semetey-1-2013:p1406:b003:l007","ordinal":183554,"en":"If an enemy came out shooting,"},{"id":"semetey-1-2013:p1406:b003:l008","ordinal":183555,"en":"He drove them before him."},{"id":"semetey-1-2013:p1406:b003:l009","ordinal":183556,"en":"Whoever stirred his anger,"},{"id":"semetey-1-2013:p1406:b003:l010","ordinal":183557,"en":"He took between his teeth and chewed;"},{"id":"semetey-1-2013:p1406:b003:l011","ordinal":183558,"en":"No one who faced him remained alive."},{"id":"semetey-1-2013:p1406:b003:l012","ordinal":183559,"en":"He wronged no mortal;"},{"id":"semetey-1-2013:p1406:b003:l013","ordinal":183560,"en":"That was your hero himself,"},{"id":"semetey-1-2013:p1406:b003:l014","ordinal":183561,"en":"At the time he came to Beijing!"},{"id":"semetey-1-2013:p1406:b003:l015","ordinal":183562,"en":"In Bakai's old age,"},{"id":"semetey-1-2013:p1406:b003:l016","ordinal":183563,"en":"He had taken him as his support!"},{"id":"semetey-1-2013:p1406:b004:l001","ordinal":183564,"en":"His uncle, old Bakai,"},{"id":"semetey-1-2013:p1406:b004:l002","ordinal":183565,"en":"Was a saint who had seen so much."},{"id":"semetey-1-2013:p1406:b004:l003","ordinal":183566,"en":"Khan Bakai led the way"},{"id":"semetey-1-2013:p1406:b004:l004","ordinal":183567,"en":"Through steep, narrow mountains"},{"id":"semetey-1-2013:p1406:b004:l005","ordinal":183568,"en":"And along winding roads."},{"id":"semetey-1-2013:p1406:b004:l006","ordinal":183569,"en":"Bakai traveled without turning,"},{"id":"semetey-1-2013:p1406:b004:l007","ordinal":183570,"en":"Riding far without sparing the horse;"},{"id":"semetey-1-2013:p1406:b004:l008","ordinal":183571,"en":"He crossed lands of pale haze"},{"id":"semetey-1-2013:p1406:b004:l009","ordinal":183572,"en":"And passed over rugged ridges."},{"id":"semetey-1-2013:p1406:b004:l010","ordinal":183573,"en":"How could your hero hold back?"},{"id":"semetey-1-2013:p1406:b004:l011","ordinal":183574,"en":"The projecting spur of the mountain"},{"id":"semetey-1-2013:p1406:b004:l012","ordinal":183575,"en":"Was where saintly Bakai arrived."},{"id":"semetey-1-2013:p1406:b004:l013","ordinal":183576,"en":"He now turned Kökcholok's head;"},{"id":"semetey-1-2013:p1406:b004:l014","ordinal":183577,"en":"Gray-wolf lion Bakai"},{"id":"semetey-1-2013:p1406:b004:l015","ordinal":183578,"en":"Spoke on without wearying"},{"id":"semetey-1-2013:p1406:b004:l016","ordinal":183579,"en":"To hero Semetey."},{"id":"semetey-1-2013:p1406:b006:l001","ordinal":183580,"en":"My dear young hero!"},{"id":"semetey-1-2013:p1406:b006:l002","ordinal":183581,"en":"That dark, towering shape"},{"id":"semetey-1-2013:p1406:b006:l003","ordinal":183582,"en":"Is the pass where the wild ram lies;"},{"id":"semetey-1-2013:p1406:b006:l004","ordinal":183583,"en":"That blue expanse straining the eye,"},{"id":"semetey-1-2013:p1406:b006:l005","ordinal":183584,"en":"That blue peak shaped like a skewer—"},{"id":"semetey-1-2013:p1406:b006:l006","ordinal":183585,"en":"That is the pass from which the guardian watches!"},{"id":"semetey-1-2013:p1406:b006:l007","ordinal":183586,"en":"That tangled spring and black ridge"},{"id":"semetey-1-2013:p1406:b006:l008","ordinal":183587,"en":"Are where the accursed wild ram"},{"id":"semetey-1-2013:p1406:b006:l009","ordinal":183588,"en":"Guards its life."},{"id":"semetey-1-2013:p1406:b006:l010","ordinal":183589,"en":"That hellish Akkulja"},{"id":"semetey-1-2013:p1406:b006:l011","ordinal":183590,"en":"Stops upon the mountain summit,"},{"id":"semetey-1-2013:p1406:b006:l012","ordinal":183591,"en":"Grazes at Toguz-Töbö,"},{"id":"semetey-1-2013:p1406:b006:l013","ordinal":183592,"en":"Drinks water from Keng-Bulak,"},{"id":"semetey-1-2013:p1406:b006:l014","ordinal":183593,"en":"And faces the plain to chew its cud."},{"id":"semetey-1-2013:p1406:b006:l015","ordinal":183594,"en":"From all that I have told you, it appears"},{"id":"semetey-1-2013:p1406:b006:l016","ordinal":183595,"en":"To be the trusted ear"},{"id":"semetey-1-2013:p1406:b006:l017","ordinal":183596,"en":"Of the Kalcha, khan of the monks."},{"id":"semetey-1-2013:p1406:b006:l018","ordinal":183597,"en":"If it happens to hear news,"},{"id":"semetey-1-2013:p1406:b006:l019","ordinal":183598,"en":"It gallops along the slope;"},{"id":"semetey-1-2013:p1406:b007:l001","ordinal":183599,"en":"That swine, ablaze with rage,"},{"id":"semetey-1-2013:p1406:b007:l002","ordinal":183600,"en":"Carries news in every direction."},{"id":"semetey-1-2013:p1406:b007:l003","ordinal":183601,"en":"Your gray-wolf uncle Bakai"},{"id":"semetey-1-2013:p1406:b007:l004","ordinal":183602,"en":"Stood measuring the ground."},{"id":"semetey-1-2013:p1406:b007:l005","ordinal":183603,"en":"They dismounted and ran,"},{"id":"semetey-1-2013:p1406:b007:l006","ordinal":183604,"en":"Striding awkwardly;"},{"id":"semetey-1-2013:p1406:b007:l007","ordinal":183605,"en":"Akkelte and Kökchybuk—"},{"id":"semetey-1-2013:p1406:b007:l008","ordinal":183606,"en":"They readied them and took them in hand."},{"id":"semetey-1-2013:p1406:b007:l009","ordinal":183607,"en":"Chinese flint and liver-stone"},{"id":"semetey-1-2013:p1406:b007:l010","ordinal":183608,"en":"The heroes struck together,"},{"id":"semetey-1-2013:p1406:b007:l011","ordinal":183609,"en":"And set fire to their matchcords."},{"id":"semetey-1-2013:p1406:b007:l012","ordinal":183610,"en":"The purest of marksmen,"},{"id":"semetey-1-2013:p1406:b007:l013","ordinal":183611,"en":"His forked gun-rest stood ready."},{"id":"semetey-1-2013:p1406:b007:l014","ordinal":183612,"en":"When they reached the pass,"},{"id":"semetey-1-2013:p1406:b007:l015","ordinal":183613,"en":"Let me tell of the hero's state:"},{"id":"semetey-1-2013:p1406:b007:l016","ordinal":183614,"en":"Semetey now prepared to shoot,"},{"id":"semetey-1-2013:p1406:b007:l017","ordinal":183615,"en":"And your uncle Bakai then"},{"id":"semetey-1-2013:p1406:b007:l018","ordinal":183616,"en":"Implored Semetey:"},{"id":"semetey-1-2013:p1406:b007:l019","ordinal":183617,"en":"“Oh, my river spring in a valley,"},{"id":"semetey-1-2013:p1407:b003:l001","ordinal":183618,"en":"My champion, gained at death’s door!"},{"id":"semetey-1-2013:p1407:b003:l002","ordinal":183619,"en":"Oh, my pale-gray, solemn darling,"},{"id":"semetey-1-2013:p1407:b003:l003","ordinal":183620,"en":"My gray hawk, my morning star!"},{"id":"semetey-1-2013:p1407:b003:l004","ordinal":183621,"en":"Before now you had not reconnoitered the road to Beijing,"},{"id":"semetey-1-2013:p1407:b003:l005","ordinal":183622,"en":"Gone out on the hunt and shot a wild ram,"},{"id":"semetey-1-2013:p1407:b003:l006","ordinal":183623,"en":"Nor gained practice with wild game!"},{"id":"semetey-1-2013:p1407:b003:l007","ordinal":183624,"en":"You had not judged the quarry’s course,"},{"id":"semetey-1-2013:p1407:b003:l008","ordinal":183625,"en":"Nor, standing forth in triumph,"},{"id":"semetey-1-2013:p1407:b003:l009","ordinal":183626,"en":"Had you shot down Akkulja!"},{"id":"semetey-1-2013:p1407:b003:l010","ordinal":183627,"en":"My beloved foal,"},{"id":"semetey-1-2013:p1407:b003:l011","ordinal":183628,"en":"Do not stare too high by accident,"},{"id":"semetey-1-2013:p1407:b003:l012","ordinal":183629,"en":"Or loose your aim awry;"},{"id":"semetey-1-2013:p1407:b003:l013","ordinal":183630,"en":"Do not let your bullet fly too far,"},{"id":"semetey-1-2013:p1407:b003:l014","ordinal":183631,"en":"Lest Kuukulja escape alive"},{"id":"semetey-1-2013:p1407:b003:l015","ordinal":183632,"en":"And bring about our ruin!"},{"id":"semetey-1-2013:p1407:b003:l016","ordinal":183633,"en":"Let it not dig my deep grave,"},{"id":"semetey-1-2013:p1407:b003:l017","ordinal":183634,"en":"Carry this news to its khan,"},{"id":"semetey-1-2013:p1407:b003:l018","ordinal":183635,"en":"And set my sorrow boiling!"},{"id":"semetey-1-2013:p1407:b003:l019","ordinal":183636,"en":"Let it not give news to the army,"},{"id":"semetey-1-2013:p1407:b003:l020","ordinal":183637,"en":"Give the news to its khan,"},{"id":"semetey-1-2013:p1407:b003:l021","ordinal":183638,"en":"So that all the Chinese converge,"},{"id":"semetey-1-2013:p1407:b003:l022","ordinal":183639,"en":"Drawing their bows like rain,"},{"id":"semetey-1-2013:p1407:b003:l023","ordinal":183640,"en":"Firing bullets like hail,"},{"id":"semetey-1-2013:p1407:b003:l024","ordinal":183641,"en":"And amid the dense dust,"},{"id":"semetey-1-2013:p1407:b003:l025","ordinal":183642,"en":"Standing their ground to fight,"},{"id":"semetey-1-2013:p1407:b003:l026","ordinal":183643,"en":"Leave us caught in blackest night."},{"id":"semetey-1-2013:p1407:b003:l027","ordinal":183644,"en":"Give this orphaned soul your support;"},{"id":"semetey-1-2013:p1407:b003:l028","ordinal":183645,"en":"The knack of Akkelte was mine,"},{"id":"semetey-1-2013:p1407:b003:l029","ordinal":183646,"en":"My breast was wise and my hand skilled,"},{"id":"semetey-1-2013:p1407:b003:l030","ordinal":183647,"en":"I had the needed mastery;"},{"id":"semetey-1-2013:p1407:b003:l031","ordinal":183648,"en":"When I went hunting I was fortunate,"},{"id":"semetey-1-2013:p1407:b003:l032","ordinal":183649,"en":"And had the finest skill!"},{"id":"semetey-1-2013:p1407:b003:l033","ordinal":183650,"en":"You who once knew no failure"},{"id":"semetey-1-2013:p1407:b003:l034","ordinal":183651,"en":"Had a champion’s prowess;"},{"id":"semetey-1-2013:p1407:b003:l035","ordinal":183652,"en":"Do not overshoot,"},{"id":"semetey-1-2013:p1407:b003:l036","ordinal":183653,"en":"You careless, headstrong child!"},{"id":"semetey-1-2013:p1407:b003:l037","ordinal":183654,"en":"While Bakai spoke in this way,"},{"id":"semetey-1-2013:p1407:b003:l038","ordinal":183655,"en":"Fierce anger seized him;"},{"id":"semetey-1-2013:p1407:b003:l039","ordinal":183656,"en":"At his uncle, old Bakai,"},{"id":"semetey-1-2013:p1407:b004:l001","ordinal":183657,"en":"The blood-drinking one raged"},{"id":"semetey-1-2013:p1407:b004:l002","ordinal":183658,"en":"As though he would swallow him whole:"},{"id":"semetey-1-2013:p1407:b004:l003","ordinal":183659,"en":"“You have a chest, but no eyes;"},{"id":"semetey-1-2013:p1407:b004:l004","ordinal":183660,"en":"Buried old uncle, what are you saying?!"},{"id":"semetey-1-2013:p1407:b004:l005","ordinal":183661,"en":"Your beard is white as a swan,"},{"id":"semetey-1-2013:p1407:b004:l006","ordinal":183662,"en":"And when the journey is close at hand,"},{"id":"semetey-1-2013:p1407:b004:l007","ordinal":183663,"en":"You rush about saying, ‘I shall shoot’—"},{"id":"semetey-1-2013:p1407:b004:l008","ordinal":183664,"en":"Time-stricken uncle, what are you saying?!"},{"id":"semetey-1-2013:p1407:b004:l009","ordinal":183665,"en":"Long ago, when you were young,"},{"id":"semetey-1-2013:p1407:b004:l010","ordinal":183666,"en":"You grew used to shooting wild rams;"},{"id":"semetey-1-2013:p1407:b004:l011","ordinal":183667,"en":"You do not recognize your own decrepitude,"},{"id":"semetey-1-2013:p1407:b004:l012","ordinal":183668,"en":"You worn-out champion, old man,"},{"id":"semetey-1-2013:p1407:b004:l013","ordinal":183669,"en":"And will not stop contesting the road!”"},{"id":"semetey-1-2013:p1407:b004:l014","ordinal":183670,"en":"Semetey grew furious,"},{"id":"semetey-1-2013:p1407:b004:l015","ordinal":183671,"en":"Gripped Akkelte and pulled it to him;"},{"id":"semetey-1-2013:p1407:b004:l016","ordinal":183672,"en":"When Bakai grappled for it,"},{"id":"semetey-1-2013:p1407:b004:l017","ordinal":183673,"en":"He swept him aside with his left hand."},{"id":"semetey-1-2013:p1407:b004:l018","ordinal":183674,"en":"Ah, withered world, be damned—"},{"id":"semetey-1-2013:p1407:b004:l019","ordinal":183675,"en":"Your aged uncle Bakai"},{"id":"semetey-1-2013:p1407:b004:l020","ordinal":183676,"en":"He shoved away, leaving him standing gaunt."},{"id":"semetey-1-2013:p1407:b004:l021","ordinal":183677,"en":"Today the death of your uncle Bakai"},{"id":"semetey-1-2013:p1407:b004:l022","ordinal":183678,"en":"At last became plain."},{"id":"semetey-1-2013:p1407:b004:l023","ordinal":183679,"en":"“Bakai was once a great khan;"},{"id":"semetey-1-2013:p1407:b004:l024","ordinal":183680,"en":"Take me now without further torment,”"},{"id":"semetey-1-2013:p1407:b004:l025","ordinal":183681,"en":"Bakai said, sitting hunched."},{"id":"semetey-1-2013:p1407:b004:l026","ordinal":183682,"en":"“I was once a great man;"},{"id":"semetey-1-2013:p1407:b004:l027","ordinal":183683,"en":"God, take me before I suffer this,”"},{"id":"semetey-1-2013:p1407:b004:l028","ordinal":183684,"en":"Bakai said, sitting hunched."},{"id":"semetey-1-2013:p1407:b004:l029","ordinal":183685,"en":"Your uncle, once mountain-like,"},{"id":"semetey-1-2013:p1407:b004:l030","ordinal":183686,"en":"Stooped like a camel sunk to its knees."},{"id":"semetey-1-2013:p1407:b004:l031","ordinal":183687,"en":"Kuukulja, watching from its lookout,"},{"id":"semetey-1-2013:p1407:b004:l032","ordinal":183688,"en":"Set off at a rolling run,"},{"id":"semetey-1-2013:p1407:b004:l033","ordinal":183689,"en":"Struck a black rock as large as a house"},{"id":"semetey-1-2013:p1407:b004:l034","ordinal":183690,"en":"With a resounding crash;"},{"id":"semetey-1-2013:p1407:b004:l035","ordinal":183691,"en":"First butting against a stone"},{"id":"semetey-1-2013:p1407:b004:l036","ordinal":183692,"en":"Was the wild ram’s habit,"},{"id":"semetey-1-2013:p1407:b004:l037","ordinal":183693,"en":"Then it would tear off grass."},{"id":"semetey-1-2013:p1407:b004:l038","ordinal":183694,"en":"Kuukulja made straight ahead,"},{"id":"semetey-1-2013:p1407:b004:l039","ordinal":183695,"en":"Parting like blue mist,"},{"id":"semetey-1-2013:p1408:b003:l001","ordinal":183696,"en":"Beneath your gray wolf,"},{"id":"semetey-1-2013:p1408:b003:l002","ordinal":183697,"en":"Showing half a target."},{"id":"semetey-1-2013:p1408:b003:l003","ordinal":183698,"en":"When the wild ram appeared,"},{"id":"semetey-1-2013:p1408:b003:l004","ordinal":183699,"en":"Akkelte, left by Manas,"},{"id":"semetey-1-2013:p1408:b003:l005","ordinal":183700,"en":"He bent into position and took aim;"},{"id":"semetey-1-2013:p1408:b003:l006","ordinal":183701,"en":"With a thunderous bang, at the ram,"},{"id":"semetey-1-2013:p1408:b003:l007","ordinal":183702,"en":"At the accursed creature’s flank,"},{"id":"semetey-1-2013:p1408:b003:l008","ordinal":183703,"en":"He sent the shot flying."},{"id":"semetey-1-2013:p1408:b003:l009","ordinal":183704,"en":"The excited braggart"},{"id":"semetey-1-2013:p1408:b003:l010","ordinal":183705,"en":"Raised his gaze and watched;"},{"id":"semetey-1-2013:p1408:b003:l011","ordinal":183706,"en":"From a spear’s length away, the wild ram"},{"id":"semetey-1-2013:p1408:b003:l012","ordinal":183707,"en":"He had shot at long range."},{"id":"semetey-1-2013:p1408:b003:l013","ordinal":183708,"en":"Then your uncle Bakai"},{"id":"semetey-1-2013:p1408:b003:l014","ordinal":183709,"en":"Tore at his beard and flung it,"},{"id":"semetey-1-2013:p1408:b003:l015","ordinal":183710,"en":"Tugged at his mustache and cast it aside."},{"id":"semetey-1-2013:p1408:b003:l016","ordinal":183711,"en":"When placed in front, he was good fortune;"},{"id":"semetey-1-2013:p1408:b003:l017","ordinal":183712,"en":"When following behind, he was like a countless army."},{"id":"semetey-1-2013:p1408:b003:l018","ordinal":183713,"en":"He found words in sudden peril,"},{"id":"semetey-1-2013:p1408:b003:l019","ordinal":183714,"en":"And found sight in darkness."},{"id":"semetey-1-2013:p1408:b003:l020","ordinal":183715,"en":"Your uncle, old Bakai,"},{"id":"semetey-1-2013:p1408:b003:l021","ordinal":183716,"en":"Was the holy sage left behind"},{"id":"semetey-1-2013:p1408:b003:l022","ordinal":183717,"en":"By bloodthirsty lion Manas."},{"id":"semetey-1-2013:p1408:b003:l023","ordinal":183718,"en":"Do not ask how your uncle fared:"},{"id":"semetey-1-2013:p1408:b003:l024","ordinal":183719,"en":"Your uncle Bakai roared,"},{"id":"semetey-1-2013:p1408:b003:l025","ordinal":183720,"en":"Stamping the ground beneath him,"},{"id":"semetey-1-2013:p1408:b003:l026","ordinal":183721,"en":"And scolded his young Semetey:"},{"id":"semetey-1-2013:p1408:b003:l027","ordinal":183722,"en":"“Alas, swollen fool, be damned;"},{"id":"semetey-1-2013:p1408:b003:l028","ordinal":183723,"en":"May there never be two such as you!"},{"id":"semetey-1-2013:p1408:b003:l029","ordinal":183724,"en":"Did I not tell you earlier?"},{"id":"semetey-1-2013:p1408:b003:l030","ordinal":183725,"en":"Did you not hear me earlier?"},{"id":"semetey-1-2013:p1408:b003:l031","ordinal":183726,"en":"By shooting the wild ram from afar,"},{"id":"semetey-1-2013:p1408:b003:l032","ordinal":183727,"en":"Have you set my sorrow boiling?”"},{"id":"semetey-1-2013:p1408:b003:l033","ordinal":183728,"en":"In fury he scolded him,"},{"id":"semetey-1-2013:p1408:b003:l034","ordinal":183729,"en":"And Bakai charged at him;"},{"id":"semetey-1-2013:p1408:b003:l035","ordinal":183730,"en":"His bloodthirsty hero’s Akkelte"},{"id":"semetey-1-2013:p1408:b003:l036","ordinal":183731,"en":"He tore now from his hand."},{"id":"semetey-1-2013:p1408:b003:l037","ordinal":183732,"en":"Fine-grained powder for rapid fire—"},{"id":"semetey-1-2013:p1408:b003:l038","ordinal":183733,"en":"The careful, hapless Bakai"},{"id":"semetey-1-2013:p1408:b003:l039","ordinal":183734,"en":"Readied it in his slender hand,"},{"id":"semetey-1-2013:p1408:b004:l001","ordinal":183735,"en":"And poured the powder with a rattle."},{"id":"semetey-1-2013:p1408:b004:l002","ordinal":183736,"en":"He struck the gunstock once against the ground;"},{"id":"semetey-1-2013:p1408:b004:l003","ordinal":183737,"en":"Your uncle, lion Bakai,"},{"id":"semetey-1-2013:p1408:b004:l004","ordinal":183738,"en":"Held the gun firm as a bullet"},{"id":"semetey-1-2013:p1408:b004:l005","ordinal":183739,"en":"And leveled it at Akkulja."},{"id":"semetey-1-2013:p1408:b004:l006","ordinal":183740,"en":"As it was about to cross"},{"id":"semetey-1-2013:p1408:b004:l007","ordinal":183741,"en":"The rise shaped like a saddleback,"},{"id":"semetey-1-2013:p1408:b004:l008","ordinal":183742,"en":"Your uncle Bakai, the keen hunter,"},{"id":"semetey-1-2013:p1408:b004:l009","ordinal":183743,"en":"Judged the moment with cunning."},{"id":"semetey-1-2013:p1408:b004:l010","ordinal":183744,"en":"A tremendous commotion"},{"id":"semetey-1-2013:p1408:b004:l011","ordinal":183745,"en":"Akkelte unleashed as it fired;"},{"id":"semetey-1-2013:p1408:b004:l012","ordinal":183746,"en":"Straight through Akkulja’s waist"},{"id":"semetey-1-2013:p1408:b004:l013","ordinal":183747,"en":"Akkelte’s shot passed!"},{"id":"semetey-1-2013:p1408:b004:l014","ordinal":183748,"en":"Akkelte cracked aloud,"},{"id":"semetey-1-2013:p1408:b004:l015","ordinal":183749,"en":"And the wild ram fell with a thud!"},{"id":"semetey-1-2013:p1408:b004:l016","ordinal":183750,"en":"Having shot down the wild ram,"},{"id":"semetey-1-2013:p1408:b004:l017","ordinal":183751,"en":"Gray-wolf elder Bakai"},{"id":"semetey-1-2013:p1408:b004:l018","ordinal":183752,"en":"Had a thousand cares within his breast,"},{"id":"semetey-1-2013:p1408:b004:l019","ordinal":183753,"en":"And tears enough for a thousand plains!"},{"id":"semetey-1-2013:p1408:b004:l020","ordinal":183754,"en":"He struck his chest with a crack,"},{"id":"semetey-1-2013:p1408:b004:l021","ordinal":183755,"en":"His heart torn apart;"},{"id":"semetey-1-2013:p1408:b004:l022","ordinal":183756,"en":"From your uncle, old Bakai,"},{"id":"semetey-1-2013:p1408:b004:l023","ordinal":183757,"en":"The tears poured down!"},{"id":"semetey-1-2013:p1408:b004:l024","ordinal":183758,"en":"Smoke billowed from his mouth,"},{"id":"semetey-1-2013:p1408:b004:l025","ordinal":183759,"en":"And tears streamed from his eyes."},{"id":"semetey-1-2013:p1408:b004:l026","ordinal":183760,"en":"“Alas, Manas, would that you had not died;"},{"id":"semetey-1-2013:p1408:b004:l027","ordinal":183761,"en":"Would that Bakai had not lived to see this disgrace!"},{"id":"semetey-1-2013:p1408:b004:l028","ordinal":183762,"en":"When I besieged Kara-Shaar and Kambyl,"},{"id":"semetey-1-2013:p1408:b004:l029","ordinal":183763,"en":"When I held them under siege,"},{"id":"semetey-1-2013:p1408:b004:l030","ordinal":183764,"en":"When I made the Manchus howl"},{"id":"semetey-1-2013:p1408:b004:l031","ordinal":183765,"en":"And beat them down,"},{"id":"semetey-1-2013:p1408:b004:l032","ordinal":183766,"en":"Why did I not die then!"},{"id":"semetey-1-2013:p1408:b004:l033","ordinal":183767,"en":"When I wore at a jaunty tilt"},{"id":"semetey-1-2013:p1408:b004:l034","ordinal":183768,"en":"My double-lapelled sable cap,"},{"id":"semetey-1-2013:p1408:b004:l035","ordinal":183769,"en":"When I mounted Beijing’s throne"},{"id":"semetey-1-2013:p1408:b004:l036","ordinal":183770,"en":"And lived in delight,"},{"id":"semetey-1-2013:p1408:b004:l037","ordinal":183771,"en":"Why did I not die then!"},{"id":"semetey-1-2013:p1408:b004:l038","ordinal":183772,"en":"When I disdained the whole world,"},{"id":"semetey-1-2013:p1408:b004:l039","ordinal":183773,"en":"While my mighty Manas lived,"},{"id":"semetey-1-2013:p1409:b003:l001","ordinal":183774,"en":"I had not lived to see such a thing;"},{"id":"semetey-1-2013:p1409:b003:l002","ordinal":183775,"en":"My eyes reddening like a raven’s,"},{"id":"semetey-1-2013:p1409:b003:l003","ordinal":183776,"en":"This wretched soul of mine until now"},{"id":"semetey-1-2013:p1409:b003:l004","ordinal":183777,"en":"Had somehow gone on without dying!"},{"id":"semetey-1-2013:p1409:b003:l005","ordinal":183778,"en":"My horns broken, left blunt,"},{"id":"semetey-1-2013:p1409:b003:l006","ordinal":183779,"en":"I have become hornless!"},{"id":"semetey-1-2013:p1409:b003:l007","ordinal":183780,"en":"Bereft of mane and tail,"},{"id":"semetey-1-2013:p1409:b003:l008","ordinal":183781,"en":"I have become a mere stump!"},{"id":"semetey-1-2013:p1409:b003:l009","ordinal":183782,"en":"Alas, Manas, damn you for dying;"},{"id":"semetey-1-2013:p1409:b003:l010","ordinal":183783,"en":"Would that Bakai had not lived to see disgrace!"},{"id":"semetey-1-2013:p1409:b003:l011","ordinal":183784,"en":"My sire died—what a day of sorrow—"},{"id":"semetey-1-2013:p1409:b003:l012","ordinal":183785,"en":"And a camel’s load was laid upon a yearling;"},{"id":"semetey-1-2013:p1409:b003:l013","ordinal":183786,"en":"When my lord passed from sight,"},{"id":"semetey-1-2013:p1409:b003:l014","ordinal":183787,"en":"I herded camels to survive—"},{"id":"semetey-1-2013:p1409:b003:l015","ordinal":183788,"en":"Why was I cast into such hell!"},{"id":"semetey-1-2013:p1409:b003:l016","ordinal":183789,"en":"Failing to die beside my companion,"},{"id":"semetey-1-2013:p1409:b003:l017","ordinal":183790,"en":"I have lived on in ruin;"},{"id":"semetey-1-2013:p1409:b003:l018","ordinal":183791,"en":"Parted from my comrade,"},{"id":"semetey-1-2013:p1409:b003:l019","ordinal":183792,"en":"Out on the empty steppe"},{"id":"semetey-1-2013:p1409:b003:l020","ordinal":183793,"en":"I have been left to howl!"},{"id":"semetey-1-2013:p1409:b003:l021","ordinal":183794,"en":"When I fitted a head"},{"id":"semetey-1-2013:p1409:b003:l022","ordinal":183795,"en":"To the black spear Zulpukor,"},{"id":"semetey-1-2013:p1409:b003:l023","ordinal":183796,"en":"While leopard Manas lived,"},{"id":"semetey-1-2013:p1409:b003:l024","ordinal":183797,"en":"When infidel and Muslim alike"},{"id":"semetey-1-2013:p1409:b003:l025","ordinal":183798,"en":"I led at the head,"},{"id":"semetey-1-2013:p1409:b003:l026","ordinal":183799,"en":"Why did I not die then!"},{"id":"semetey-1-2013:p1409:b003:l027","ordinal":183800,"en":"When I swung the curved blade"},{"id":"semetey-1-2013:p1409:b003:l028","ordinal":183801,"en":"Against my forearm,"},{"id":"semetey-1-2013:p1409:b003:l029","ordinal":183802,"en":"When I shattered"},{"id":"semetey-1-2013:p1409:b003:l030","ordinal":183803,"en":"And took the face of the earth,"},{"id":"semetey-1-2013:p1409:b003:l031","ordinal":183804,"en":"In the full strength of my courage,"},{"id":"semetey-1-2013:p1409:b003:l032","ordinal":183805,"en":"While my bloodthirsty hero lived,"},{"id":"semetey-1-2013:p1409:b003:l033","ordinal":183806,"en":"Why did I not die then!"},{"id":"semetey-1-2013:p1409:b003:l034","ordinal":183807,"en":"When I hung a battle-axe"},{"id":"semetey-1-2013:p1409:b003:l035","ordinal":183808,"en":"Upon the lattice wall,"}]
