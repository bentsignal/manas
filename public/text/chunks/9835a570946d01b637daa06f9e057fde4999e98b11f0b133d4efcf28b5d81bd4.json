[{"id":"sayakbay-ms-current146:pdf117:l021","ordinal":391681,"en":"Asking about affairs among the Chinese,"},{"id":"sayakbay-ms-current146:pdf117:l022","ordinal":391682,"en":"I was a son who knew them,"},{"id":"sayakbay-ms-current146:pdf117:l023","ordinal":391683,"en":"Riding the cloud and cloaked in frost,"},{"id":"sayakbay-ms-current146:pdf117:l024","ordinal":391684,"en":"I was one of the heroes who roamed."},{"id":"sayakbay-ms-current146:pdf117:l025","ordinal":391685,"en":"A true Kyrgyz man among the four,"},{"id":"sayakbay-ms-current146:pdf117:l026","ordinal":391686,"en":"A turn lasting six months,"},{"id":"sayakbay-ms-current146:pdf117:l027","ordinal":391687,"en":"Since then the Kyrgyz have not taken it."},{"id":"sayakbay-ms-current146:pdf117:l028","ordinal":391688,"en":"We are becoming men,"},{"id":"sayakbay-ms-current146:pdf117:l029","ordinal":391689,"en":"My people remain without lawful union,"},{"id":"sayakbay-ms-current146:pdf117:l030","ordinal":391690,"en":"Before the khan, the eye of the horde,"},{"id":"sayakbay-ms-current146:pdf117:l031","ordinal":391691,"en":"Among the horde’s maidens,"},{"id":"sayakbay-ms-current146:pdf117:l032","ordinal":391692,"en":"As in former times last year,"},{"id":"sayakbay-ms-current146:pdf117:l033","ordinal":391693,"en":"In the city of conquest,"},{"id":"sayakbay-ms-current146:pdf117:l034","ordinal":391694,"en":"My ancestors gave birth to me."},{"id":"sayakbay-ms-current146:pdf117:l035","ordinal":391695,"en":"Whatever kind of khan my ancestor was,"},{"id":"sayakbay-ms-current146:pdf117:l036","ordinal":391696,"en":"He was one who led the people."}]
