[{"id":"semetey-1-2013:p1049:b005:l006","ordinal":157185,"en":"And raze it all smooth."},{"id":"semetey-1-2013:p1049:b005:l007","ordinal":157186,"en":"In Akun's old age,"},{"id":"semetey-1-2013:p1049:b005:l008","ordinal":157187,"en":"Saying, \"He will not give his old maid daughter,\""},{"id":"semetey-1-2013:p1049:b005:l009","ordinal":157188,"en":"They will humiliate him!"},{"id":"semetey-1-2013:p1049:b005:l010","ordinal":157189,"en":"Azhybay and Tümönbay—"},{"id":"semetey-1-2013:p1049:b005:l011","ordinal":157190,"en":"They will enslave us both"},{"id":"semetey-1-2013:p1049:b005:l012","ordinal":157191,"en":"And send us to tend their horses!\""},{"id":"semetey-1-2013:p1049:b005:l013","ordinal":157192,"en":"So saying and tormenting himself, Azhybay,"},{"id":"semetey-1-2013:p1049:b005:l014","ordinal":157193,"en":"After he had seen this,"},{"id":"semetey-1-2013:p1049:b005:l015","ordinal":157194,"en":"Lost the strength of his arms,"},{"id":"semetey-1-2013:p1049:b005:l016","ordinal":157195,"en":"And the courage left his heart."},{"id":"semetey-1-2013:p1049:b005:l017","ordinal":157196,"en":"The Zhediger had begun their affliction;"},{"id":"semetey-1-2013:p1049:b005:l018","ordinal":157197,"en":"When he saw this display,"},{"id":"semetey-1-2013:p1049:b005:l019","ordinal":157198,"en":"Azhybay proved a coward"},{"id":"semetey-1-2013:p1049:b005:l020","ordinal":157199,"en":"And nearly fell"},{"id":"semetey-1-2013:p1049:b005:l021","ordinal":157200,"en":"From the top of the tower."},{"id":"semetey-1-2013:p1049:b005:l022","ordinal":157201,"en":"Taking the shortcut down the tower,"},{"id":"semetey-1-2013:p1049:b005:l023","ordinal":157202,"en":"Tümönbay led Azhybay down,"},{"id":"semetey-1-2013:p1049:b005:l024","ordinal":157203,"en":"With the greatest struggle,"},{"id":"semetey-1-2013:p1049:b005:l025","ordinal":157204,"en":"Until he had brought him below."},{"id":"semetey-1-2013:p1049:b005:l026","ordinal":157205,"en":"Azhybay, terrified and distraught,"},{"id":"semetey-1-2013:p1049:b005:l027","ordinal":157206,"en":"Pleaded with Tümönbay:"},{"id":"semetey-1-2013:p1049:b005:l028","ordinal":157207,"en":"\"My dear Tümönbay!"},{"id":"semetey-1-2013:p1049:b005:l029","ordinal":157208,"en":"Because of Aychürök,"},{"id":"semetey-1-2013:p1049:b005:l030","ordinal":157209,"en":"Mortal danger has come upon us;"},{"id":"semetey-1-2013:p1049:b005:l031","ordinal":157210,"en":"With mighty Kozho at their head,"},{"id":"semetey-1-2013:p1049:b005:l032","ordinal":157211,"en":"An army comes that will overrun us."},{"id":"semetey-1-2013:p1049:b005:l033","ordinal":157212,"en":"If we do not go out to meet them,"},{"id":"semetey-1-2013:p1049:b005:l034","ordinal":157213,"en":"Driving eighty fat barren mares,"},{"id":"semetey-1-2013:p1049:b005:l035","ordinal":157214,"en":"All of them matching gray beasts,"},{"id":"semetey-1-2013:p1049:b005:l036","ordinal":157215,"en":"And carry them as tribute,"},{"id":"semetey-1-2013:p1049:b005:l037","ordinal":157216,"en":"Halt their great army,"},{"id":"semetey-1-2013:p1049:b005:l038","ordinal":157217,"en":"And gain a seven-day reprieve,"},{"id":"semetey-1-2013:p1049:b005:l039","ordinal":157218,"en":"The dense black Zhediger"},{"id":"semetey-1-2013:p1050:b003:l001","ordinal":157219,"en":"If we do not accept what he says,"},{"id":"semetey-1-2013:p1050:b003:l002","ordinal":157220,"en":"If we do not give Aychürök"},{"id":"semetey-1-2013:p1050:b003:l003","ordinal":157221,"en":"To Toltoy as tribute,"},{"id":"semetey-1-2013:p1050:b003:l004","ordinal":157222,"en":"He will act with great cruelty."},{"id":"semetey-1-2013:p1050:b003:l005","ordinal":157223,"en":"Chynkozho, son of Shygay,"},{"id":"semetey-1-2013:p1050:b003:l006","ordinal":157224,"en":"Kozho, resolute in his deeds,"},{"id":"semetey-1-2013:p1050:b003:l007","ordinal":157225,"en":"Will slaughter us and only then be satisfied!"},{"id":"semetey-1-2013:p1050:b003:l008","ordinal":157226,"en":"If we do not give Aychürök in tribute,"},{"id":"semetey-1-2013:p1050:b003:l009","ordinal":157227,"en":"If we do not go and settle it that way,"},{"id":"semetey-1-2013:p1050:b003:l010","ordinal":157228,"en":"He will cut off our heads without ceasing,"},{"id":"semetey-1-2013:p1050:b003:l011","ordinal":157229,"en":"Reach down to our very roots,"},{"id":"semetey-1-2013:p1050:b003:l012","ordinal":157230,"en":"Plunder all our goods,"},{"id":"semetey-1-2013:p1050:b003:l013","ordinal":157231,"en":"And inflict grievous ruin."},{"id":"semetey-1-2013:p1050:b003:l014","ordinal":157232,"en":"For the aging maiden Chürök,"},{"id":"semetey-1-2013:p1050:b003:l015","ordinal":157233,"en":"If we do not go to meet him,"},{"id":"semetey-1-2013:p1050:b003:l016","ordinal":157234,"en":"He will begin the great tumult"},{"id":"semetey-1-2013:p1050:b003:l017","ordinal":157235,"en":"And utterly slaughter"},{"id":"semetey-1-2013:p1050:b003:l018","ordinal":157236,"en":"The dense black Afghans!\""},{"id":"semetey-1-2013:p1050:b003:l019","ordinal":157237,"en":"When Azhybay said this,"},{"id":"semetey-1-2013:p1050:b003:l020","ordinal":157238,"en":"Many people before the others"},{"id":"semetey-1-2013:p1050:b003:l021","ordinal":157239,"en":"Began to clamor;"},{"id":"semetey-1-2013:p1050:b003:l022","ordinal":157240,"en":"Many people took fright"},{"id":"semetey-1-2013:p1050:b003:l023","ordinal":157241,"en":"And quickly agreed."},{"id":"semetey-1-2013:p1050:b003:l024","ordinal":157242,"en":"Their knees bent,"},{"id":"semetey-1-2013:p1050:b003:l025","ordinal":157243,"en":"And their young men ran."},{"id":"semetey-1-2013:p1050:b003:l026","ordinal":157244,"en":"From Khan Akun's court,"},{"id":"semetey-1-2013:p1050:b003:l027","ordinal":157245,"en":"As tribute for Toltoy,"},{"id":"semetey-1-2013:p1050:b003:l028","ordinal":157246,"en":"They drove some forty red camels;"},{"id":"semetey-1-2013:p1050:b003:l029","ordinal":157247,"en":"As tribute for Kozho,"},{"id":"semetey-1-2013:p1050:b003:l030","ordinal":157248,"en":"They drove eighty-eight gray beasts,"},{"id":"semetey-1-2013:p1050:b003:l031","ordinal":157249,"en":"All of them fat and barren."},{"id":"semetey-1-2013:p1050:b003:l032","ordinal":157250,"en":"They took men with the tribute"},{"id":"semetey-1-2013:p1050:b003:l033","ordinal":157251,"en":"And many head of livestock,"},{"id":"semetey-1-2013:p1050:b003:l034","ordinal":157252,"en":"Prepared their white banner,"},{"id":"semetey-1-2013:p1050:b003:l035","ordinal":157253,"en":"And bound it high as the sky."},{"id":"semetey-1-2013:p1050:b003:l036","ordinal":157254,"en":"The Zhediger's people"},{"id":"semetey-1-2013:p1050:b003:l037","ordinal":157255,"en":"Now went out to meet them."},{"id":"semetey-1-2013:p1050:b003:l038","ordinal":157256,"en":"Together with their livestock,"},{"id":"semetey-1-2013:p1050:b003:l039","ordinal":157257,"en":"Before warrior Kozho,"},{"id":"semetey-1-2013:p1050:b004:l001","ordinal":157258,"en":"They now brought the tribute."},{"id":"semetey-1-2013:p1050:b004:l002","ordinal":157259,"en":"Azhybay and Tümönbay"},{"id":"semetey-1-2013:p1050:b004:l003","ordinal":157260,"en":"Folded their hands across their bellies"},{"id":"semetey-1-2013:p1050:b004:l004","ordinal":157261,"en":"And bowed in submission."},{"id":"semetey-1-2013:p1050:b004:l005","ordinal":157262,"en":"When he saw this tribute,"},{"id":"semetey-1-2013:p1050:b004:l006","ordinal":157263,"en":"Chynkozho, son of Shygay,"},{"id":"semetey-1-2013:p1050:b004:l007","ordinal":157264,"en":"Kozho, resolute in his deeds—"},{"id":"semetey-1-2013:p1050:b004:l008","ordinal":157265,"en":"When his wrath took hold,"},{"id":"semetey-1-2013:p1050:b004:l009","ordinal":157266,"en":"His custom was to begin a great tumult;"},{"id":"semetey-1-2013:p1050:b004:l010","ordinal":157267,"en":"When he entered battle against an enemy,"},{"id":"semetey-1-2013:p1050:b004:l011","ordinal":157268,"en":"His black horse flew into the sky;"},{"id":"semetey-1-2013:p1050:b004:l012","ordinal":157269,"en":"His custom was to lay waste"},{"id":"semetey-1-2013:p1050:b004:l013","ordinal":157270,"en":"All those he fought."},{"id":"semetey-1-2013:p1050:b004:l014","ordinal":157271,"en":"Chynkozho, son of Shygay,"},{"id":"semetey-1-2013:p1050:b004:l015","ordinal":157272,"en":"Born a khan surpassing the Argyn,"},{"id":"semetey-1-2013:p1050:b004:l016","ordinal":157273,"en":"When his wrath took hold,"},{"id":"semetey-1-2013:p1050:b004:l017","ordinal":157274,"en":"Life fled from the Zhediger."},{"id":"semetey-1-2013:p1050:b004:l018","ordinal":157275,"en":"Raging and roaring,"},{"id":"semetey-1-2013:p1050:b004:l019","ordinal":157276,"en":"Mighty Kozho thundered;"},{"id":"semetey-1-2013:p1050:b004:l020","ordinal":157277,"en":"Roaring in anger,"},{"id":"semetey-1-2013:p1050:b004:l021","ordinal":157278,"en":"He called Toltoy of the Zhediger"},{"id":"semetey-1-2013:p1050:b004:l022","ordinal":157279,"en":"And ordered him to come near."},{"id":"semetey-1-2013:p1050:b004:l023","ordinal":157280,"en":"When Toltoy approached,"},{"id":"semetey-1-2013:p1050:b004:l024","ordinal":157281,"en":"Mighty Kozho glared in anger"},{"id":"semetey-1-2013:p1050:b004:l025","ordinal":157282,"en":"And began to speak:"},{"id":"semetey-1-2013:p1050:b004:l026","ordinal":157283,"en":"\"Your father's grave, warrior Toltoy!"},{"id":"semetey-1-2013:p1050:b004:l027","ordinal":157284,"en":"We became pale stars in the sky,"},{"id":"semetey-1-2013:p1050:b004:l028","ordinal":157285,"en":"And friends until Judgment Day."},{"id":"semetey-1-2013:p1050:b004:l029","ordinal":157286,"en":"At this time, oh Toltoy,"},{"id":"semetey-1-2013:p1050:b004:l030","ordinal":157287,"en":"While my dear head remains,"},{"id":"semetey-1-2013:p1050:b004:l031","ordinal":157288,"en":"If an enemy comes to challenge us,"},{"id":"semetey-1-2013:p1050:b004:l032","ordinal":157289,"en":"I shall slaughter them utterly."},{"id":"semetey-1-2013:p1050:b004:l033","ordinal":157290,"en":"While my own head remains,"},{"id":"semetey-1-2013:p1050:b004:l034","ordinal":157291,"en":"If you heed my words, oh Toltoy,"},{"id":"semetey-1-2013:p1050:b004:l035","ordinal":157292,"en":"Over the whole world"},{"id":"semetey-1-2013:p1050:b004:l036","ordinal":157293,"en":"I shall raise you up as khan!"},{"id":"semetey-1-2013:p1050:b004:l037","ordinal":157294,"en":"Do you understand, oh Toltoy?"},{"id":"semetey-1-2013:p1050:b004:l038","ordinal":157295,"en":"The Afghans have submitted;"},{"id":"semetey-1-2013:p1050:b004:l039","ordinal":157296,"en":"Do you see that all have come?"},{"id":"semetey-1-2013:p1051:b003:l001","ordinal":157297,"en":"The land shines with their tribute;"},{"id":"semetey-1-2013:p1051:b003:l002","ordinal":157298,"en":"Do you see that their livestock has come?"},{"id":"semetey-1-2013:p1051:b003:l003","ordinal":157299,"en":"Out of their wits with fear, from Afghanistan"},{"id":"semetey-1-2013:p1051:b003:l004","ordinal":157300,"en":"Envoys have come—do you see!"},{"id":"semetey-1-2013:p1051:b003:l005","ordinal":157301,"en":"Had those envoys not come,"},{"id":"semetey-1-2013:p1051:b003:l006","ordinal":157302,"en":"They would have suffered"},{"id":"semetey-1-2013:p1051:b003:l007","ordinal":157303,"en":"Remarkable humiliation from me—do you see?!"},{"id":"semetey-1-2013:p1051:b003:l008","ordinal":157304,"en":"Folding their hands before us,"},{"id":"semetey-1-2013:p1051:b003:l009","ordinal":157305,"en":"They intend to give Chürök"},{"id":"semetey-1-2013:p1051:b003:l010","ordinal":157306,"en":"As tribute—do you see?!"},{"id":"semetey-1-2013:p1051:b003:l011","ordinal":157307,"en":"If they do not give Aychürök,"},{"id":"semetey-1-2013:p1051:b003:l012","ordinal":157308,"en":"The many Afghans will be crushed"},{"id":"semetey-1-2013:p1051:b003:l013","ordinal":157309,"en":"And die—do you see?"},{"id":"semetey-1-2013:p1051:b003:l014","ordinal":157310,"en":"Let us hear the envoys' words;"},{"id":"semetey-1-2013:p1051:b003:l015","ordinal":157311,"en":"If they do not give Aychürök,"},{"id":"semetey-1-2013:p1051:b003:l016","ordinal":157312,"en":"If they do not accept what was said,"},{"id":"semetey-1-2013:p1051:b003:l017","ordinal":157313,"en":"Then let us ride out to shoot!\""},{"id":"semetey-1-2013:p1051:b003:l018","ordinal":157314,"en":"When Kozho said this,"},{"id":"semetey-1-2013:p1051:b003:l019","ordinal":157315,"en":"Toltoy stood and said:"},{"id":"semetey-1-2013:p1051:b003:l020","ordinal":157316,"en":"\"The envoys who have come between us,"},{"id":"semetey-1-2013:p1051:b003:l021","ordinal":157317,"en":"Tümönbay, son of Tülkü,"},{"id":"semetey-1-2013:p1051:b003:l022","ordinal":157318,"en":"And Azhybay, son of Azhy—"},{"id":"semetey-1-2013:p1051:b003:l023","ordinal":157319,"en":"I myself do not trust"},{"id":"semetey-1-2013:p1051:b003:l024","ordinal":157320,"en":"That eloquent-tongued hero at all,"},{"id":"semetey-1-2013:p1051:b003:l025","ordinal":157321,"en":"That infidel-like man"},{"id":"semetey-1-2013:p1051:b003:l026","ordinal":157322,"en":"Whose wish has never been fulfilled."},{"id":"semetey-1-2013:p1051:b003:l027","ordinal":157323,"en":"Yesterday, when the people drove uphill,"},{"id":"semetey-1-2013:p1051:b003:l028","ordinal":157324,"en":"At the time called At-Kara-Til,"},{"id":"semetey-1-2013:p1051:b003:l029","ordinal":157325,"en":"You yourself were there, Kozho;"},{"id":"semetey-1-2013:p1051:b003:l030","ordinal":157326,"en":"We took horses by their leads,"},{"id":"semetey-1-2013:p1051:b003:l031","ordinal":157327,"en":"And Afghan and Zhediger"},{"id":"semetey-1-2013:p1051:b003:l032","ordinal":157328,"en":"Shouted war cries and fought."},{"id":"semetey-1-2013:p1051:b003:l033","ordinal":157329,"en":"We mounted stallions from the tether line,"},{"id":"semetey-1-2013:p1051:b003:l034","ordinal":157330,"en":"Took poles from the ground,"},{"id":"semetey-1-2013:p1051:b003:l035","ordinal":157331,"en":"And fought for seven days."},{"id":"semetey-1-2013:p1051:b003:l036","ordinal":157332,"en":"A band of men died among the Afghans,"},{"id":"semetey-1-2013:p1051:b003:l037","ordinal":157333,"en":"And a band of men died among us;"},{"id":"semetey-1-2013:p1051:b003:l038","ordinal":157334,"en":"Because of Aychürök,"},{"id":"semetey-1-2013:p1051:b003:l039","ordinal":157335,"en":"We made a merciless slaughter."},{"id":"semetey-1-2013:p1051:b005:l001","ordinal":157336,"en":"Azhybay came between us,"},{"id":"semetey-1-2013:p1051:b005:l002","ordinal":157337,"en":"Saying, 'I accept your demand.'"},{"id":"semetey-1-2013:p1051:b005:l003","ordinal":157338,"en":"He is surpassingly eloquent by nature,"},{"id":"semetey-1-2013:p1051:b005:l004","ordinal":157339,"en":"And has the habit of deceiving."},{"id":"semetey-1-2013:p1051:b005:l005","ordinal":157340,"en":"There is neither Chürök nor even a morsel;"},{"id":"semetey-1-2013:p1051:b005:l006","ordinal":157341,"en":"We were left sitting in disappointment,"},{"id":"semetey-1-2013:p1051:b005:l007","ordinal":157342,"en":"With necks outstretched like howling dogs."},{"id":"semetey-1-2013:p1051:b005:l008","ordinal":157343,"en":"Swift-tongued, eloquent, and argumentative,"},{"id":"semetey-1-2013:p1051:b005:l009","ordinal":157344,"en":"His nature is exceptionally gifted,"},{"id":"semetey-1-2013:p1051:b005:l010","ordinal":157345,"en":"And he always has the habit"},{"id":"semetey-1-2013:p1051:b005:l011","ordinal":157346,"en":"Of deceiving us."},{"id":"semetey-1-2013:p1051:b005:l012","ordinal":157347,"en":"Know this that I have said;"},{"id":"semetey-1-2013:p1051:b005:l013","ordinal":157348,"en":"My lion Kozho, heed my words!"},{"id":"semetey-1-2013:p1051:b005:l014","ordinal":157349,"en":"Let us not accept what he says;"},{"id":"semetey-1-2013:p1051:b005:l015","ordinal":157350,"en":"Let us not keep babbling"},{"id":"semetey-1-2013:p1051:b005:l016","ordinal":157351,"en":"With that over-eloquent dog."},{"id":"semetey-1-2013:p1051:b005:l017","ordinal":157352,"en":"Let us seize their envoys,"},{"id":"semetey-1-2013:p1051:b005:l018","ordinal":157353,"en":"And upon Afghanistan lying here,"},{"id":"semetey-1-2013:p1051:b005:l019","ordinal":157354,"en":"Let us stage a splendid slaughter;"},{"id":"semetey-1-2013:p1051:b005:l020","ordinal":157355,"en":"Let us seize by force"},{"id":"semetey-1-2013:p1051:b005:l021","ordinal":157356,"en":"The Chürök they refuse when asked!"},{"id":"semetey-1-2013:p1051:b005:l022","ordinal":157357,"en":"My precious Kozho, heed my words;"},{"id":"semetey-1-2013:p1051:b005:l023","ordinal":157358,"en":"Let us forge tempered steel"},{"id":"semetey-1-2013:p1051:b005:l024","ordinal":157359,"en":"And overrun the accursed Afghans,"},{"id":"semetey-1-2013:p1051:b005:l025","ordinal":157360,"en":"Laying them waste!"},{"id":"semetey-1-2013:p1051:b005:l026","ordinal":157361,"en":"Let us smash their lattice willows,"},{"id":"semetey-1-2013:p1051:b005:l027","ordinal":157362,"en":"Make their young women and maidens weep,"},{"id":"semetey-1-2013:p1051:b005:l028","ordinal":157363,"en":"Smash their roof poles,"},{"id":"semetey-1-2013:p1051:b005:l029","ordinal":157364,"en":"Make their sons and daughters weep,"},{"id":"semetey-1-2013:p1051:b005:l030","ordinal":157365,"en":"And demolish their city."},{"id":"semetey-1-2013:p1051:b005:l031","ordinal":157366,"en":"Let us take entirely as plunder"},{"id":"semetey-1-2013:p1051:b005:l032","ordinal":157367,"en":"The children in their hands,"},{"id":"semetey-1-2013:p1051:b005:l033","ordinal":157368,"en":"And drive out of the Afghans"},{"id":"semetey-1-2013:p1051:b005:l034","ordinal":157369,"en":"All their distant arrogance."},{"id":"semetey-1-2013:p1051:b005:l035","ordinal":157370,"en":"Let us shatter their stone city"},{"id":"semetey-1-2013:p1051:b005:l036","ordinal":157371,"en":"And utterly conquer it;"},{"id":"semetey-1-2013:p1051:b005:l037","ordinal":157372,"en":"Let us devastate their sandy steppe"},{"id":"semetey-1-2013:p1051:b005:l038","ordinal":157373,"en":"And leave all the Afghans"},{"id":"semetey-1-2013:p1051:b005:l039","ordinal":157374,"en":"Howling like dogs upon the plain,"},{"id":"semetey-1-2013:p1052:b003:l001","ordinal":157375,"en":"Let us overrun them utterly"},{"id":"semetey-1-2013:p1052:b003:l002","ordinal":157376,"en":"And stage our spectacle."},{"id":"semetey-1-2013:p1052:b003:l003","ordinal":157377,"en":"Driving an army that makes the land shine,"},{"id":"semetey-1-2013:p1052:b003:l004","ordinal":157378,"en":"Driving all the host in abundance,"},{"id":"semetey-1-2013:p1052:b003:l005","ordinal":157379,"en":"Let them give Chürök if they will;"},{"id":"semetey-1-2013:p1052:b003:l006","ordinal":157380,"en":"If they will not give Chürök,"},{"id":"semetey-1-2013:p1052:b003:l007","ordinal":157381,"en":"We shall begin the turmoil!\""},{"id":"semetey-1-2013:p1052:b003:l008","ordinal":157382,"en":"Then Kozho said this:"},{"id":"semetey-1-2013:p1052:b003:l009","ordinal":157383,"en":"\"Hero Toltoy, whose soul has fled,"},{"id":"semetey-1-2013:p1052:b003:l010","ordinal":157384,"en":"Does one prosper by doing evil"},{"id":"semetey-1-2013:p1052:b003:l011","ordinal":157385,"en":"To people who have sought friendship?"},{"id":"semetey-1-2013:p1052:b003:l012","ordinal":157386,"en":"Are the Afghan people fit for coercion?"},{"id":"semetey-1-2013:p1052:b003:l013","ordinal":157387,"en":"Let us not commit this violence."},{"id":"semetey-1-2013:p1052:b003:l014","ordinal":157388,"en":"If the Afghans come to equal terms,"},{"id":"semetey-1-2013:p1052:b003:l015","ordinal":157389,"en":"Let us become in-laws, drive livestock,"},{"id":"semetey-1-2013:p1052:b003:l016","ordinal":157390,"en":"Bow to one another and chew the fat,"},{"id":"semetey-1-2013:p1052:b003:l017","ordinal":157391,"en":"And return this way!"},{"id":"semetey-1-2013:p1052:b003:l018","ordinal":157392,"en":"Let us take the maiden with mutual honor"},{"id":"semetey-1-2013:p1052:b003:l019","ordinal":157393,"en":"And depart without resentment."},{"id":"semetey-1-2013:p1052:b003:l020","ordinal":157394,"en":"Let us go to their envoys;"},{"id":"semetey-1-2013:p1052:b003:l021","ordinal":157395,"en":"If they will give Chürök,"},{"id":"semetey-1-2013:p1052:b003:l022","ordinal":157396,"en":"Let us take their promise;"},{"id":"semetey-1-2013:p1052:b003:l023","ordinal":157397,"en":"If they will not give Chürök,"},{"id":"semetey-1-2013:p1052:b003:l024","ordinal":157398,"en":"Then let us begin the battle."},{"id":"semetey-1-2013:p1052:b003:l025","ordinal":157399,"en":"Look carefully, warrior Toltoy:"},{"id":"semetey-1-2013:p1052:b003:l026","ordinal":157400,"en":"Livestock has come as tribute,"},{"id":"semetey-1-2013:p1052:b003:l027","ordinal":157401,"en":"The khan has come leading them,"},{"id":"semetey-1-2013:p1052:b003:l028","ordinal":157402,"en":"Grievous force has come upon Afghanistan,"},{"id":"semetey-1-2013:p1052:b003:l029","ordinal":157403,"en":"All their nobles have come."},{"id":"semetey-1-2013:p1052:b003:l030","ordinal":157404,"en":"Let us hear the envoys' answer,"},{"id":"semetey-1-2013:p1052:b003:l031","ordinal":157405,"en":"And then ride out to war!\""},{"id":"semetey-1-2013:p1052:b003:l032","ordinal":157406,"en":"When mighty Kozho waved"},{"id":"semetey-1-2013:p1052:b003:l033","ordinal":157407,"en":"The red banner mottled gray and white,"},{"id":"semetey-1-2013:p1052:b003:l034","ordinal":157408,"en":"It was the signal to dismount;"},{"id":"semetey-1-2013:p1052:b003:l035","ordinal":157409,"en":"All the Zhediger"},{"id":"semetey-1-2013:p1052:b003:l036","ordinal":157410,"en":"Boiled down from their horses."},{"id":"semetey-1-2013:p1052:b003:l037","ordinal":157411,"en":"Swarming like ants,"},{"id":"semetey-1-2013:p1052:b003:l038","ordinal":157412,"en":"They spread out and dismounted."},{"id":"semetey-1-2013:p1052:b003:l039","ordinal":157413,"en":"Dividing into groups of ten and five,"},{"id":"semetey-1-2013:p1052:b004:l001","ordinal":157414,"en":"They gathered around the field cauldrons."},{"id":"semetey-1-2013:p1052:b004:l002","ordinal":157415,"en":"Chynkozho and warrior Tölök"},{"id":"semetey-1-2013:p1052:b004:l003","ordinal":157416,"en":"Had the Zhediger dismount."},{"id":"semetey-1-2013:p1052:b004:l004","ordinal":157417,"en":"Hurrying between the sides came"},{"id":"semetey-1-2013:p1052:b004:l005","ordinal":157418,"en":"Azhybay, son of Azhy,"},{"id":"semetey-1-2013:p1052:b004:l006","ordinal":157419,"en":"And Tümönbay, son of Tülkü."},{"id":"semetey-1-2013:p1052:b004:l007","ordinal":157420,"en":"Azhybay, son of Azhy,"},{"id":"semetey-1-2013:p1052:b004:l008","ordinal":157421,"en":"Was a surpassingly eloquent servant,"},{"id":"semetey-1-2013:p1052:b004:l009","ordinal":157422,"en":"Swift-tongued and skilled in argument,"},{"id":"semetey-1-2013:p1052:b004:l010","ordinal":157423,"en":"A man of exceptional eloquence."},{"id":"semetey-1-2013:p1052:b004:l011","ordinal":157424,"en":"Tümönbay, son of Tülkü,"},{"id":"semetey-1-2013:p1052:b004:l012","ordinal":157425,"en":"Proud-hearted and blustering,"},{"id":"semetey-1-2013:p1052:b004:l013","ordinal":157426,"en":"Very courageous and stern,"},{"id":"semetey-1-2013:p1052:b004:l014","ordinal":157427,"en":"Was a ruthless hero"},{"id":"semetey-1-2013:p1052:b004:l015","ordinal":157428,"en":"Who never turned back from death."},{"id":"semetey-1-2013:p1052:b004:l016","ordinal":157429,"en":"After seeing Kozho and Tölök"},{"id":"semetey-1-2013:p1052:b004:l017","ordinal":157430,"en":"Coming toward them,"},{"id":"semetey-1-2013:p1052:b004:l018","ordinal":157431,"en":"They had their thoroughbreds prepared"},{"id":"semetey-1-2013:p1052:b004:l019","ordinal":157432,"en":"And the horses tethered far away."},{"id":"semetey-1-2013:p1052:b004:l020","ordinal":157433,"en":"They spread foods of every sweet and fine kind"},{"id":"semetey-1-2013:p1052:b004:l021","ordinal":157434,"en":"In abundance before Kozho,"},{"id":"semetey-1-2013:p1052:b004:l022","ordinal":157435,"en":"And beneath him had a thick layer"},{"id":"semetey-1-2013:p1052:b004:l023","ordinal":157436,"en":"Of splendid carpets of every kind laid."},{"id":"semetey-1-2013:p1052:b004:l024","ordinal":157437,"en":"Tölök and Chynkozho"},{"id":"semetey-1-2013:p1052:b004:l025","ordinal":157438,"en":"Halted the Zhediger host"},{"id":"semetey-1-2013:p1052:b004:l026","ordinal":157439,"en":"And the two now came between the sides."},{"id":"semetey-1-2013:p1052:b004:l027","ordinal":157440,"en":"When he saw the appearance"}]
