[{"id":"semetey-1-2013:p0248:b004:l016","ordinal":95745,"en":"Above his ears and forelock,"},{"id":"semetey-1-2013:p0248:b004:l017","ordinal":95746,"en":"Two fingerbreadths higher,"},{"id":"semetey-1-2013:p0248:b004:l018","ordinal":95747,"en":"With a blank charge,"},{"id":"semetey-1-2013:p0248:b004:l019","ordinal":95748,"en":"Your unfortunate mother Kanykei"},{"id":"semetey-1-2013:p0248:b004:l020","ordinal":95749,"en":"Fired once with a boom."},{"id":"semetey-1-2013:p0248:b004:l021","ordinal":95750,"en":"Taytoru, that extraordinary racer,"},{"id":"semetey-1-2013:p0248:b004:l022","ordinal":95751,"en":"Now lowered his head to the ground."},{"id":"semetey-1-2013:p0248:b004:l023","ordinal":95752,"en":"Pounding the dark earth,"},{"id":"semetey-1-2013:p0248:b004:l024","ordinal":95753,"en":"When he heard Syrbarang's voice,"},{"id":"semetey-1-2013:p0248:b004:l025","ordinal":95754,"en":"He darted forward again and again."},{"id":"semetey-1-2013:p0248:b004:l026","ordinal":95755,"en":"He stretched his stride like a wild ram;"},{"id":"semetey-1-2013:p0248:b004:l027","ordinal":95756,"en":"How mightily he bounded on!"},{"id":"semetey-1-2013:p0248:b004:l028","ordinal":95757,"en":"Your elder Koshoi, my mighty elder,"},{"id":"semetey-1-2013:p0248:b004:l029","ordinal":95758,"en":"Once rode to Beijing."},{"id":"semetey-1-2013:p0248:b004:l030","ordinal":95759,"en":"Manas had not yet existed then;"},{"id":"semetey-1-2013:p0248:b004:l031","ordinal":95760,"en":"Far from that, your Manas"},{"id":"semetey-1-2013:p0248:b004:l032","ordinal":95761,"en":"Had not yet come into the world."},{"id":"semetey-1-2013:p0248:b004:l033","ordinal":95762,"en":"For seven years Khan Koshoi"},{"id":"semetey-1-2013:p0248:b004:l034","ordinal":95763,"en":"Had been in Mecca,"},{"id":"semetey-1-2013:p0248:b004:l035","ordinal":95764,"en":"While the handful of Muslims"},{"id":"semetey-1-2013:p0248:b004:l036","ordinal":95765,"en":"Were ruled by the Chinese,"},{"id":"semetey-1-2013:p0248:b004:l037","ordinal":95766,"en":"Who imposed their own will"},{"id":"semetey-1-2013:p0248:b004:l038","ordinal":95767,"en":"Upon the Muslims."},{"id":"semetey-1-2013:p0248:b004:l039","ordinal":95768,"en":"Making a trough from pinewood,"},{"id":"semetey-1-2013:p0249:b003:l001","ordinal":95769,"en":"Many Chinese gathered,"},{"id":"semetey-1-2013:p0249:b003:l002","ordinal":95770,"en":"Ez-Kara, khan of the Manchu,"},{"id":"semetey-1-2013:p0249:b003:l003","ordinal":95771,"en":"Warrior Joloy, khan of the Kalmyks,"},{"id":"semetey-1-2013:p0249:b003:l004","ordinal":95772,"en":"Ylama, the Chinese giant."},{"id":"semetey-1-2013:p0249:b003:l005","ordinal":95773,"en":"Against Samarkand,"},{"id":"semetey-1-2013:p0249:b003:l006","ordinal":95774,"en":"When they fought and wrought a slaughter,"},{"id":"semetey-1-2013:p0249:b003:l007","ordinal":95775,"en":"Bilerik, son of Aikhoja,"},{"id":"semetey-1-2013:p0249:b003:l008","ordinal":95776,"en":"The Muslims' cherished only son,"},{"id":"semetey-1-2013:p0249:b003:l009","ordinal":95777,"en":"When the Chinese seized him,"},{"id":"semetey-1-2013:p0249:b003:l010","ordinal":95778,"en":"Into a great dungeon forty ropes high,"},{"id":"semetey-1-2013:p0249:b003:l011","ordinal":95779,"en":"When they took him and cast him,"},{"id":"semetey-1-2013:p0249:b003:l012","ordinal":95780,"en":"When God struck those unbelievers,"},{"id":"semetey-1-2013:p0249:b003:l013","ordinal":95781,"en":"Six thousand ingots and a thousand otter pelts"},{"id":"semetey-1-2013:p0249:b003:l014","ordinal":95782,"en":"They demanded as tribute."},{"id":"semetey-1-2013:p0249:b003:l015","ordinal":95783,"en":"At that time, Taytoru"},{"id":"semetey-1-2013:p0249:b003:l016","ordinal":95784,"en":"Was the horse that Khan Koshoi, father of the people,"},{"id":"semetey-1-2013:p0249:b003:l017","ordinal":95785,"en":"Rode on his campaign."},{"id":"semetey-1-2013:p0249:b003:l018","ordinal":95786,"en":"Having suffered humiliation from the unbelievers,"},{"id":"semetey-1-2013:p0249:b003:l019","ordinal":95787,"en":"When Koshoi rode there,"},{"id":"semetey-1-2013:p0249:b003:l020","ordinal":95788,"en":"In Kakanchyn's Beijing,"},{"id":"semetey-1-2013:p0249:b003:l021","ordinal":95789,"en":"When he fought single combats,"},{"id":"semetey-1-2013:p0249:b003:l022","ordinal":95790,"en":"The imprisoned Bilerik,"},{"id":"semetey-1-2013:p0249:b003:l023","ordinal":95791,"en":"When Koshoi won him back,"},{"id":"semetey-1-2013:p0249:b003:l024","ordinal":95792,"en":"The Manchu and Black Kalmyks,"},{"id":"semetey-1-2013:p0249:b003:l025","ordinal":95793,"en":"Their warriors broke into groups,"},{"id":"semetey-1-2013:p0249:b003:l026","ordinal":95794,"en":"Drew their bows like rain."},{"id":"semetey-1-2013:p0249:b003:l027","ordinal":95795,"en":"That slaughter then,"},{"id":"semetey-1-2013:p0249:b003:l028","ordinal":95796,"en":"Taytoru had witnessed."},{"id":"semetey-1-2013:p0249:b003:l029","ordinal":95797,"en":"So many guns and bows,"},{"id":"semetey-1-2013:p0249:b003:l030","ordinal":95798,"en":"The bullets of firing weapons,"},{"id":"semetey-1-2013:p0249:b003:l031","ordinal":95799,"en":"Taytoru had grown used to them."},{"id":"semetey-1-2013:p0249:b003:l032","ordinal":95800,"en":"When the gun's report rang out,"},{"id":"semetey-1-2013:p0249:b003:l033","ordinal":95801,"en":"Taytoru, that splendid racer,"},{"id":"semetey-1-2013:p0249:b003:l034","ordinal":95802,"en":"Now lowered his head to the ground,"},{"id":"semetey-1-2013:p0249:b003:l035","ordinal":95803,"en":"Cast his poor life aside,"},{"id":"semetey-1-2013:p0249:b003:l036","ordinal":95804,"en":"And strode like a wild ram."},{"id":"semetey-1-2013:p0249:b003:l037","ordinal":95805,"en":"When he came before her,"},{"id":"semetey-1-2013:p0249:b003:l038","ordinal":95806,"en":"If you looked closely, Taytoru"},{"id":"semetey-1-2013:p0249:b003:l039","ordinal":95807,"en":"Had broken away from Chong-Kashka;"},{"id":"semetey-1-2013:p0249:b005:l001","ordinal":95808,"en":"There was Taytoru,"},{"id":"semetey-1-2013:p0249:b005:l002","ordinal":95809,"en":"Drawing alongside Chong-Küröng."},{"id":"semetey-1-2013:p0249:b005:l003","ordinal":95810,"en":"So many worries her breast could not hold them—"},{"id":"semetey-1-2013:p0249:b005:l004","ordinal":95811,"en":"When she saw Taytoru,"},{"id":"semetey-1-2013:p0249:b005:l005","ordinal":95812,"en":"Your fierce, raging sister-in-law's"},{"id":"semetey-1-2013:p0249:b005:l006","ordinal":95813,"en":"Tears flooded ten fields!"},{"id":"semetey-1-2013:p0249:b005:l007","ordinal":95814,"en":"Unable to twist her rope-like hair,"},{"id":"semetey-1-2013:p0249:b005:l008","ordinal":95815,"en":"Unable to stand without screaming and weeping,"},{"id":"semetey-1-2013:p0249:b005:l009","ordinal":95816,"en":"Without looking round,"},{"id":"semetey-1-2013:p0249:b005:l010","ordinal":95817,"en":"That truly mighty woman,"},{"id":"semetey-1-2013:p0249:b005:l011","ordinal":95818,"en":"Sparing not her life, worth but a coin,"},{"id":"semetey-1-2013:p0249:b005:l012","ordinal":95819,"en":"Without looking this way and that,"},{"id":"semetey-1-2013:p0249:b005:l013","ordinal":95820,"en":"The poor soul was carried away."},{"id":"semetey-1-2013:p0249:b005:l014","ordinal":95821,"en":"This damned life,"},{"id":"semetey-1-2013:p0249:b005:l015","ordinal":95822,"en":"She valued not a hair, sparing it not."},{"id":"semetey-1-2013:p0249:b005:l016","ordinal":95823,"en":"Sobbing, \"O God!\""},{"id":"semetey-1-2013:p0249:b005:l017","ordinal":95824,"en":"Then crying, \"My magnanimous one!\""},{"id":"semetey-1-2013:p0249:b005:l018","ordinal":95825,"en":"Your noble sister-in-law Kanykei"},{"id":"semetey-1-2013:p0249:b005:l019","ordinal":95826,"en":"Lashed her whip this way and that,"},{"id":"semetey-1-2013:p0249:b005:l020","ordinal":95827,"en":"Spurred right and left,"},{"id":"semetey-1-2013:p0249:b005:l021","ordinal":95828,"en":"Roared like a warrior,"},{"id":"semetey-1-2013:p0249:b005:l022","ordinal":95829,"en":"Raised the battle cry, \"Manas!\""},{"id":"semetey-1-2013:p0249:b005:l023","ordinal":95830,"en":"At that moment, your sister-in-law"},{"id":"semetey-1-2013:p0249:b005:l024","ordinal":95831,"en":"Raised the full-throated battle cry."},{"id":"semetey-1-2013:p0249:b005:l025","ordinal":95832,"en":"Wherever she could reach Tory,"},{"id":"semetey-1-2013:p0249:b005:l026","ordinal":95833,"en":"The great lead rope tied in knotted loops,"},{"id":"semetey-1-2013:p0249:b005:l027","ordinal":95834,"en":"Your mother snatched up"},{"id":"semetey-1-2013:p0249:b005:l028","ordinal":95835,"en":"And struck his flank."},{"id":"semetey-1-2013:p0249:b005:l029","ordinal":95836,"en":"When your sister-in-law took the lead rope,"},{"id":"semetey-1-2013:p0249:b005:l030","ordinal":95837,"en":"Her poor heart was torn,"},{"id":"semetey-1-2013:p0249:b005:l031","ordinal":95838,"en":"Tears poured from her eyes."},{"id":"semetey-1-2013:p0249:b005:l032","ordinal":95839,"en":"Her golden earrings, big as bowls—"},{"id":"semetey-1-2013:p0249:b005:l033","ordinal":95840,"en":"Damn her womanhood!—"},{"id":"semetey-1-2013:p0249:b005:l034","ordinal":95841,"en":"Showed upon her earlobes."},{"id":"semetey-1-2013:p0249:b005:l035","ordinal":95842,"en":"When your sister-in-law took the lead rope,"},{"id":"semetey-1-2013:p0249:b005:l036","ordinal":95843,"en":"Naked Khizyr and young Aydar"},{"id":"semetey-1-2013:p0249:b005:l037","ordinal":95844,"en":"Took hold of the bridle and bit."},{"id":"semetey-1-2013:p0249:b005:l038","ordinal":95845,"en":"The forty saints, Khizyr and his khoja"},{"id":"semetey-1-2013:p0249:b005:l039","ordinal":95846,"en":"Joined in urging the horse on."},{"id":"semetey-1-2013:p0250:b003:l001","ordinal":95847,"en":"The black-spotted leopard,"},{"id":"semetey-1-2013:p0250:b003:l002","ordinal":95848,"en":"Charging beside her then,"},{"id":"semetey-1-2013:p0250:b003:l003","ordinal":95849,"en":"Raised an unseen cry of encouragement."},{"id":"semetey-1-2013:p0250:b003:l004","ordinal":95850,"en":"Manas, visited by Khizyr—"},{"id":"semetey-1-2013:p0250:b003:l005","ordinal":95851,"en":"The saints who had protected him"},{"id":"semetey-1-2013:p0250:b003:l006","ordinal":95852,"en":"Joined in urging the horse on."},{"id":"semetey-1-2013:p0250:b003:l007","ordinal":95853,"en":"(Much is false, much is true;"},{"id":"semetey-1-2013:p0250:b003:l008","ordinal":95854,"en":"Those renowned conquerors,"},{"id":"semetey-1-2013:p0250:b003:l009","ordinal":95855,"en":"No one has returned from seeing them."},{"id":"semetey-1-2013:p0250:b003:l010","ordinal":95856,"en":"Half is false, half is true;"},{"id":"semetey-1-2013:p0250:b003:l011","ordinal":95857,"en":"Unless the Creator himself knows,"},{"id":"semetey-1-2013:p0250:b003:l012","ordinal":95858,"en":"No one has returned from their side.)"},{"id":"semetey-1-2013:p0250:b003:l013","ordinal":95859,"en":"From Allah Most High alone,"},{"id":"semetey-1-2013:p0250:b003:l014","ordinal":95860,"en":"She came seeking help,"},{"id":"semetey-1-2013:p0250:b003:l015","ordinal":95861,"en":"Sparing not her fly-like life,"},{"id":"semetey-1-2013:p0250:b003:l016","ordinal":95862,"en":"Imploring the true God."},{"id":"semetey-1-2013:p0250:b003:l017","ordinal":95863,"en":"The racer Taytoru,"},{"id":"semetey-1-2013:p0250:b003:l018","ordinal":95864,"en":"Your mother came urging onward."},{"id":"semetey-1-2013:p0250:b003:l019","ordinal":95865,"en":"That truly strong, poor woman,"},{"id":"semetey-1-2013:p0250:b003:l020","ordinal":95866,"en":"Guiding him on level ground,"},{"id":"semetey-1-2013:p0250:b003:l021","ordinal":95867,"en":"Where she caught hold of Tory,"},{"id":"semetey-1-2013:p0250:b003:l022","ordinal":95868,"en":"Your sister-in-law dragged him like a fur cap."},{"id":"semetey-1-2013:p0250:b003:l023","ordinal":95869,"en":"Guiding him down the slope,"},{"id":"semetey-1-2013:p0250:b003:l024","ordinal":95870,"en":"Where Tory descended,"},{"id":"semetey-1-2013:p0250:b003:l025","ordinal":95871,"en":"Your immensely strong sister-in-law"},{"id":"semetey-1-2013:p0250:b003:l026","ordinal":95872,"en":"Dragged him light as a feather."},{"id":"semetey-1-2013:p0250:b003:l027","ordinal":95873,"en":"She opened her mouth like a gaping maw."},{"id":"semetey-1-2013:p0250:b003:l028","ordinal":95874,"en":"The great lead rope tied in knotted loops,"},{"id":"semetey-1-2013:p0250:b003:l029","ordinal":95875,"en":"The mallet-like flesh of her white breasts,"},{"id":"semetey-1-2013:p0250:b003:l030","ordinal":95876,"en":"She brought down and pressed."},{"id":"semetey-1-2013:p0250:b003:l031","ordinal":95877,"en":"Crying the battle cry, \"Manas!\""},{"id":"semetey-1-2013:p0250:b003:l032","ordinal":95878,"en":"As she urged Taytoru on,"},{"id":"semetey-1-2013:p0250:b003:l033","ordinal":95879,"en":"He broke away from Chong-Küröng."},{"id":"semetey-1-2013:p0250:b003:l034","ordinal":95880,"en":"Taytoru came forward,"},{"id":"semetey-1-2013:p0250:b003:l035","ordinal":95881,"en":"Drawing alongside Aktulpar."},{"id":"semetey-1-2013:p0250:b003:l036","ordinal":95882,"en":"Aktulpar, an extraordinarily swift steed,"},{"id":"semetey-1-2013:p0250:b003:l037","ordinal":95883,"en":"Was a true racer too."},{"id":"semetey-1-2013:p0250:b003:l038","ordinal":95884,"en":"When they entered a downward slope,"},{"id":"semetey-1-2013:p0250:b003:l039","ordinal":95885,"en":"Aktulpar led by a neck;"},{"id":"semetey-1-2013:p0250:b004:l001","ordinal":95886,"en":"When they began climbing,"},{"id":"semetey-1-2013:p0250:b004:l002","ordinal":95887,"en":"Taytoru led by a neck."},{"id":"semetey-1-2013:p0250:b004:l003","ordinal":95888,"en":"Matched evenly, the noble racing horses,"},{"id":"semetey-1-2013:p0250:b004:l004","ordinal":95889,"en":"The two raced fiercely,"},{"id":"semetey-1-2013:p0250:b004:l005","ordinal":95890,"en":"Their two stirrups clashing."},{"id":"semetey-1-2013:p0250:b004:l006","ordinal":95891,"en":"Your courageous mother Kanykei,"},{"id":"semetey-1-2013:p0250:b004:l007","ordinal":95892,"en":"Roaring in fury,"},{"id":"semetey-1-2013:p0250:b004:l008","ordinal":95893,"en":"Ajybay and Bakai, the two khans,"},{"id":"semetey-1-2013:p0250:b004:l009","ordinal":95894,"en":"Called upon them both."},{"id":"semetey-1-2013:p0250:b004:l010","ordinal":95895,"en":"There was no hill even ankle-high,"},{"id":"semetey-1-2013:p0250:b004:l011","ordinal":95896,"en":"No ravine as big as a saddlecloth,"},{"id":"semetey-1-2013:p0250:b004:l012","ordinal":95897,"en":"No furrow scratched by a plough,"},{"id":"semetey-1-2013:p0250:b004:l013","ordinal":95898,"en":"No burrow dug by a marmot."},{"id":"semetey-1-2013:p0250:b004:l014","ordinal":95899,"en":"When they reached the sandy desert,"},{"id":"semetey-1-2013:p0250:b004:l015","ordinal":95900,"en":"Eyes reddening like a raven's,"},{"id":"semetey-1-2013:p0250:b004:l016","ordinal":95901,"en":"Ahead of Aktulpar,"},{"id":"semetey-1-2013:p0250:b004:l017","ordinal":95902,"en":"Your sister-in-law brought"},{"id":"semetey-1-2013:p0250:b004:l018","ordinal":95903,"en":"The racer Taytoru,"},{"id":"semetey-1-2013:p0250:b004:l019","ordinal":95904,"en":"Sending him six bowshots ahead."},{"id":"semetey-1-2013:p0250:b004:l020","ordinal":95905,"en":"When they reached the sandy plain,"},{"id":"semetey-1-2013:p0250:b004:l021","ordinal":95906,"en":"Eyes reddening like a gazelle's,"},{"id":"semetey-1-2013:p0250:b004:l022","ordinal":95907,"en":"Tory, sixty years beyond his first four,"},{"id":"semetey-1-2013:p0250:b004:l023","ordinal":95908,"en":"Your sister-in-law brought forward,"},{"id":"semetey-1-2013:p0250:b004:l024","ordinal":95909,"en":"Sending him seven bowshots ahead."},{"id":"semetey-1-2013:p0250:b004:l025","ordinal":95910,"en":"Dividing the hair down her back in ten,"},{"id":"semetey-1-2013:p0250:b004:l026","ordinal":95911,"en":"Your sister-in-law came binding it up."},{"id":"semetey-1-2013:p0250:b004:l027","ordinal":95912,"en":"The poor one left by a precious man,"},{"id":"semetey-1-2013:p0250:b004:l028","ordinal":95913,"en":"With blank charges,"},{"id":"semetey-1-2013:p0250:b004:l029","ordinal":95914,"en":"Firing now and then,"},{"id":"semetey-1-2013:p0250:b004:l030","ordinal":95915,"en":"The racer Taytoru,"},{"id":"semetey-1-2013:p0250:b004:l031","ordinal":95916,"en":"She came driving onward."},{"id":"semetey-1-2013:p0250:b004:l032","ordinal":95917,"en":"The poor woman with a warrior's frame,"},{"id":"semetey-1-2013:p0250:b004:l033","ordinal":95918,"en":"Her two eyes blazing,"},{"id":"semetey-1-2013:p0250:b004:l034","ordinal":95919,"en":"Came forth in fiery radiance."},{"id":"semetey-1-2013:p0250:b004:l035","ordinal":95920,"en":"With blank charges,"},{"id":"semetey-1-2013:p0250:b004:l036","ordinal":95921,"en":"The racer Taytoru,"},{"id":"semetey-1-2013:p0250:b004:l037","ordinal":95922,"en":"Your fierce mother Kanykei,"},{"id":"semetey-1-2013:p0250:b004:l038","ordinal":95923,"en":"Firing thunderous shots,"},{"id":"semetey-1-2013:p0250:b004:l039","ordinal":95924,"en":"Came driving onward."},{"id":"semetey-1-2013:p0251:b003:l001","ordinal":95925,"en":"Once God had granted her wish,"},{"id":"semetey-1-2013:p0251:b003:l002","ordinal":95926,"en":"Once Taytoru had come out ahead,"},{"id":"semetey-1-2013:p0251:b003:l003","ordinal":95927,"en":"All her thoughts scattered;"},{"id":"semetey-1-2013:p0251:b003:l004","ordinal":95928,"en":"Unable to stand counting her worries,"},{"id":"semetey-1-2013:p0251:b003:l005","ordinal":95929,"en":"Her tears poured down:"},{"id":"semetey-1-2013:p0251:b003:l006","ordinal":95930,"en":"\"My banner fixed upon a spear,"},{"id":"semetey-1-2013:p0251:b003:l007","ordinal":95931,"en":"My gift left by the magnanimous one,"},{"id":"semetey-1-2013:p0251:b003:l008","ordinal":95932,"en":"My hoof left by a noble steed,"},{"id":"semetey-1-2013:p0251:b003:l009","ordinal":95933,"en":"My dear, unspent warhorse—"},{"id":"semetey-1-2013:p0251:b003:l010","ordinal":95934,"en":"He has not turned his mind elsewhere,"},{"id":"semetey-1-2013:p0251:b003:l011","ordinal":95935,"en":"Has not yet clearly seen that I, unfortunate one,"},{"id":"semetey-1-2013:p0251:b003:l012","ordinal":95936,"en":"Am his mother."},{"id":"semetey-1-2013:p0251:b003:l013","ordinal":95937,"en":"If the tassel is hung upon his spear,"},{"id":"semetey-1-2013:p0251:b003:l014","ordinal":95938,"en":"Manas, gone to the other world—"},{"id":"semetey-1-2013:p0251:b003:l015","ordinal":95939,"en":"If he learns that this is his father!"},{"id":"semetey-1-2013:p0251:b003:l016","ordinal":95940,"en":"If my foal takes after his father,"},{"id":"semetey-1-2013:p0251:b003:l017","ordinal":95941,"en":"He will be a lion protected by Shay."},{"id":"semetey-1-2013:p0251:b003:l018","ordinal":95942,"en":"He will trouble not a single soul;"},{"id":"semetey-1-2013:p0251:b003:l019","ordinal":95943,"en":"He will be a hard-hearted warrior."},{"id":"semetey-1-2013:p0251:b003:l020","ordinal":95944,"en":"My foal's right shoulder blade will be broad;"},{"id":"semetey-1-2013:p0251:b003:l021","ordinal":95945,"en":"He will be a lion who crushes the Oirat."},{"id":"semetey-1-2013:p0251:b003:l022","ordinal":95946,"en":"When Semetey was newly born,"},{"id":"semetey-1-2013:p0251:b003:l023","ordinal":95947,"en":"The Russians ate at his feast and departed."},{"id":"semetey-1-2013:p0251:b003:l024","ordinal":95948,"en":"'If he lives, your foal"},{"id":"semetey-1-2013:p0251:b003:l025","ordinal":95949,"en":"Will crush the Oirat,' they said as they left."},{"id":"semetey-1-2013:p0251:b003:l026","ordinal":95950,"en":"The Chinese ate at his feast and departed."},{"id":"semetey-1-2013:p0251:b003:l027","ordinal":95951,"en":"'If he lives, this child"},{"id":"semetey-1-2013:p0251:b003:l028","ordinal":95952,"en":"Will shake the world,' they said as they left."},{"id":"semetey-1-2013:p0251:b003:l029","ordinal":95953,"en":"If by chance Semetey"},{"id":"semetey-1-2013:p0251:b003:l030","ordinal":95954,"en":"Hears words from gossiping people,"},{"id":"semetey-1-2013:p0251:b003:l031","ordinal":95955,"en":"Hears that his father is Manas,"},{"id":"semetey-1-2013:p0251:b003:l032","ordinal":95956,"en":"Might he think evil of me?"},{"id":"semetey-1-2013:p0251:b003:l033","ordinal":95957,"en":"'When my dear father died,"},{"id":"semetey-1-2013:p0251:b003:l034","ordinal":95958,"en":"Mother, you put on men's clothes,' he may say."},{"id":"semetey-1-2013:p0251:b003:l036","ordinal":95959,"en":"'What a foolish mother you are!"},{"id":"semetey-1-2013:p0251:b003:l037","ordinal":95960,"en":"What were you seeking?' he may say."},{"id":"semetey-1-2013:p0251:b003:l038","ordinal":95961,"en":"Might he gouge out my eyes in bitterness?"},{"id":"semetey-1-2013:p0251:b003:l039","ordinal":95962,"en":"That boy, burning with rage,"},{"id":"semetey-1-2013:p0251:b005:l001","ordinal":95963,"en":"Might he seize me,"},{"id":"semetey-1-2013:p0251:b005:l002","ordinal":95964,"en":"Gouge out my eyes,"},{"id":"semetey-1-2013:p0251:b005:l003","ordinal":95965,"en":"That warrior taking after his father—"},{"id":"semetey-1-2013:p0251:b005:l004","ordinal":95966,"en":"Might he put me to death?"},{"id":"semetey-1-2013:p0251:b005:l005","ordinal":95967,"en":"Now that God has given so much,"},{"id":"semetey-1-2013:p0251:b005:l006","ordinal":95968,"en":"Now that my Taytoru has come out ahead,"},{"id":"semetey-1-2013:p0251:b005:l007","ordinal":95969,"en":"By wearing men's clothes,"},{"id":"semetey-1-2013:p0251:b005:l008","ordinal":95970,"en":"What wish could I fulfill?"},{"id":"semetey-1-2013:p0251:b005:l009","ordinal":95971,"en":"From this time onward, O one God,"},{"id":"semetey-1-2013:p0251:b005:l010","ordinal":95972,"en":"Let me remain in mourning."},{"id":"semetey-1-2013:p0251:b005:l011","ordinal":95973,"en":"Alas, may a fierce leopard never die,"},{"id":"semetey-1-2013:p0251:b005:l012","ordinal":95974,"en":"May no head suffer such grief."},{"id":"semetey-1-2013:p0251:b005:l013","ordinal":95975,"en":"Grief like this,"},{"id":"semetey-1-2013:p0251:b005:l014","ordinal":95976,"en":"If you created us as living souls, God,"},{"id":"semetey-1-2013:p0251:b005:l015","ordinal":95977,"en":"From this time onward, O one God,"},{"id":"semetey-1-2013:p0251:b005:l016","ordinal":95978,"en":"Do not give it to the Muslim people!\""},{"id":"semetey-1-2013:p0251:b005:l017","ordinal":95979,"en":"The poor soul wept in anguish,"},{"id":"semetey-1-2013:p0251:b005:l018","ordinal":95980,"en":"Her rosy face smeared like mud,"},{"id":"semetey-1-2013:p0251:b005:l019","ordinal":95981,"en":"Her tall body bowed down."},{"id":"semetey-1-2013:p0251:b005:l020","ordinal":95982,"en":"\"My Semetey will wear it,\" she had said—"},{"id":"semetey-1-2013:p0251:b005:l021","ordinal":95983,"en":"The marten-fur cap she had made,"},{"id":"semetey-1-2013:p0251:b005:l022","ordinal":95984,"en":"Now she snatched into her hand"},{"id":"semetey-1-2013:p0251:b005:l023","ordinal":95985,"en":"And put into the white saddlebags."},{"id":"semetey-1-2013:p0251:b005:l024","ordinal":95986,"en":"Its collar gold, its sleeves copper,"},{"id":"semetey-1-2013:p0251:b005:l025","ordinal":95987,"en":"Double mail with rings like larks' eyes,"},{"id":"semetey-1-2013:p0251:b005:l026","ordinal":95988,"en":"A fine-cloth sash, a broad sleeveless coat,"},{"id":"semetey-1-2013:p0251:b005:l027","ordinal":95989,"en":"That handsome robe of fine white cloth—"},{"id":"semetey-1-2013:p0251:b005:l028","ordinal":95990,"en":"She took it off again and folded it."},{"id":"semetey-1-2013:p0251:b005:l029","ordinal":95991,"en":"Your dear mother Kanykei,"},{"id":"semetey-1-2013:p0251:b005:l030","ordinal":95992,"en":"Fitting it into the white saddlebags,"},{"id":"semetey-1-2013:p0251:b005:l031","ordinal":95993,"en":"Put it there as well."},{"id":"semetey-1-2013:p0251:b005:l032","ordinal":95994,"en":"Her dear hair, thick as a girth,"},{"id":"semetey-1-2013:p0251:b005:l033","ordinal":95995,"en":"Your impetuous mother Kanykei"},{"id":"semetey-1-2013:p0251:b005:l034","ordinal":95996,"en":"Spread across her breast."},{"id":"semetey-1-2013:p0251:b005:l035","ordinal":95997,"en":"Her dear hair like strands of silk,"},{"id":"semetey-1-2013:p0251:b005:l036","ordinal":95998,"en":"Your mother, reddening it,"},{"id":"semetey-1-2013:p0251:b005:l037","ordinal":95999,"en":"Spread it down before her."},{"id":"semetey-1-2013:p0251:b005:l038","ordinal":96000,"en":"Her dark hair loose,"}]
