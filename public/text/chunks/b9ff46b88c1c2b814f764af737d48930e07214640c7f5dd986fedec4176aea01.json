[{"id":"manas-2010:p1690:b001:l015","ordinal":72705,"en":"His ear and forelock"},{"id":"manas-2010:p1690:b001:l016","ordinal":72706,"en":"Your champion cut off."},{"id":"manas-2010:p1690:b001:l017","ordinal":72707,"en":"Moaning, he could only smell them;"},{"id":"manas-2010:p1690:b001:l018","ordinal":72708,"en":"Clasping them, he could only smell them."},{"id":"manas-2010:p1690:b001:l019","ordinal":72709,"en":"‘My companion, my dun horse!’ he said, smelling them."},{"id":"manas-2010:p1690:b001:l020","ordinal":72710,"en":"Your champion Manas, the fierce-maned khan,"},{"id":"manas-2010:p1690:b001:l021","ordinal":72711,"en":"Affliction upon his toil-worn life,"},{"id":"manas-2010:p1690:b001:l022","ordinal":72712,"en":"The leopard stood in deep distress."},{"id":"manas-2010:p1690:b001:l023","ordinal":72713,"en":"How could your champion spare himself?"},{"id":"manas-2010:p1690:b001:l024","ordinal":72714,"en":"Leaning upon Akkelte,"},{"id":"manas-2010:p1690:b001:l025","ordinal":72715,"en":"Having lost Akkula to a bullet,"},{"id":"manas-2010:p1690:b001:l026","ordinal":72716,"en":"Having let Almambet pass as a martyr,"},{"id":"manas-2010:p1690:b001:l027","ordinal":72717,"en":"Having had his wings broken,"},{"id":"manas-2010:p1690:b001:l028","ordinal":72718,"en":"Sitting in mourning,"},{"id":"manas-2010:p1690:b001:l029","ordinal":72719,"en":"Bereft of Khan Chubak,"},{"id":"manas-2010:p1690:b001:l030","ordinal":72720,"en":"When the champions had all been there,"},{"id":"manas-2010:p1690:b001:l031","ordinal":72721,"en":"From that damned Beijing"},{"id":"manas-2010:p1690:b001:l032","ordinal":72722,"en":"He had plundered and taken many girls."},{"id":"manas-2010:p1690:b001:l033","ordinal":72723,"en":"A day of ruin fell upon his head;"},{"id":"manas-2010:p1690:b001:l034","ordinal":72724,"en":"Your generous one had devoured his champions."},{"id":"manas-2010:p1690:b001:l035","ordinal":72725,"en":"Against seething Beijing,"},{"id":"manas-2010:p1690:b001:l036","ordinal":72726,"en":"Charging, he thrust his lance once."},{"id":"manas-2010:p1690:b001:l037","ordinal":72727,"en":"“Having plundered so much gold,"},{"id":"manas-2010:p1690:b001:l038","ordinal":72728,"en":"O God, now I am to leave defeated,"},{"id":"manas-2010:p1690:b001:l039","ordinal":72729,"en":"Having devoured the noble ones."},{"id":"manas-2010:p1690:b001:l040","ordinal":72730,"en":"Almambet leading was my lucky path,"},{"id":"manas-2010:p1690:b001:l041","ordinal":72731,"en":"Syrgak driving the foe was my vast army."},{"id":"manas-2010:p1690:b001:l042","ordinal":72732,"en":"Bereft of my vast army,"},{"id":"manas-2010:p1691:b001:l001","ordinal":72733,"en":"Was this the time for wasting sickness to strike?"},{"id":"manas-2010:p1691:b001:l002","ordinal":72734,"en":"Bereft of my illustrious Chubak,"},{"id":"manas-2010:p1691:b001:l003","ordinal":72735,"en":"Was this the hour to leave like this?"},{"id":"manas-2010:p1691:b001:l004","ordinal":72736,"en":"Earlier, in the hollow of Zhylgyndy,"},{"id":"manas-2010:p1691:b001:l005","ordinal":72737,"en":"Along the broad Talas,"},{"id":"manas-2010:p1691:b001:l006","ordinal":72738,"en":"I used to cut and eat horse-rump meat."},{"id":"manas-2010:p1691:b001:l007","ordinal":72739,"en":"If Chubak was at my side,"},{"id":"manas-2010:p1691:b001:l008","ordinal":72740,"en":"I thought, ‘I shall overthrow Zhang-Zhung.’"},{"id":"manas-2010:p1691:b001:l009","ordinal":72741,"en":"When I rested peacefully, wretched soul,"},{"id":"manas-2010:p1691:b001:l010","ordinal":72742,"en":"I used to cut and eat horse-belly fat."},{"id":"manas-2010:p1691:b001:l011","ordinal":72743,"en":"When honored Almambet watched over me,"},{"id":"manas-2010:p1691:b001:l012","ordinal":72744,"en":"I thought, ‘Who could contend with me?’"},{"id":"manas-2010:p1691:b001:l013","ordinal":72745,"en":"The black-steel Zulpuqor,"},{"id":"manas-2010:p1691:b001:l014","ordinal":72746,"en":"I thought I would wield and thrust."},{"id":"manas-2010:p1691:b001:l015","ordinal":72747,"en":"When Syrgak watched over me,"},{"id":"manas-2010:p1691:b001:l016","ordinal":72748,"en":"The eighteen thousand worlds,"},{"id":"manas-2010:p1691:b001:l017","ordinal":72749,"en":"Wretched soul, I thought I would jostle them all!"},{"id":"manas-2010:p1691:b001:l018","ordinal":72750,"en":"A bulletproof outer robe,"},{"id":"manas-2010:p1691:b001:l019","ordinal":72751,"en":"I thought I would wear."},{"id":"manas-2010:p1691:b001:l020","ordinal":72752,"en":"If the devastating one was at my side,"},{"id":"manas-2010:p1691:b001:l021","ordinal":72753,"en":"The eighteen thousand worlds,"},{"id":"manas-2010:p1691:b001:l022","ordinal":72754,"en":"I thought I would challenge them all!"},{"id":"manas-2010:p1691:b001:l023","ordinal":72755,"en":"The Russians upon my right,"},{"id":"manas-2010:p1691:b001:l024","ordinal":72756,"en":"When I was mowing them down,"},{"id":"manas-2010:p1691:b001:l025","ordinal":72757,"en":"The Chinese upon my flank,"},{"id":"manas-2010:p1691:b001:l026","ordinal":72758,"en":"When I was slaughtering them,"},{"id":"manas-2010:p1691:b001:l027","ordinal":72759,"en":"Turning Beijing back without flinching,"},{"id":"manas-2010:p1691:b001:l028","ordinal":72760,"en":"Damn it, how shall I turn back now,"},{"id":"manas-2010:p1691:b001:l029","ordinal":72761,"en":"Bereft of the champions,"},{"id":"manas-2010:p1691:b001:l030","ordinal":72762,"en":"Almambet and Chubak, their names paired?"},{"id":"manas-2010:p1691:b001:l031","ordinal":72763,"en":"Against Beijing untouched even by holy Ali,"},{"id":"manas-2010:p1691:b001:l032","ordinal":72764,"en":"Did I think my strength would suffice?"},{"id":"manas-2010:p1691:b001:l033","ordinal":72765,"en":"Fighting here,"},{"id":"manas-2010:p1691:b001:l034","ordinal":72766,"en":"Bereft of the lions,"},{"id":"manas-2010:p1691:b001:l035","ordinal":72767,"en":"Did I think I would leave alive?"},{"id":"manas-2010:p1691:b001:l036","ordinal":72768,"en":"O God, you made me a lion who slaughtered unbelievers;"},{"id":"manas-2010:p1691:b001:l037","ordinal":72769,"en":"Taking dear Alma from me,"},{"id":"manas-2010:p1691:b001:l038","ordinal":72770,"en":"God, why have you diminished me so greatly?"},{"id":"manas-2010:p1691:b001:l039","ordinal":72771,"en":"Load on the burden of endurance,"},{"id":"manas-2010:p1691:b001:l040","ordinal":72772,"en":"Merciless, deceitful world;"},{"id":"manas-2010:p1691:b001:l041","ordinal":72773,"en":"Now take back the life you entrusted."},{"id":"manas-2010:p1691:b001:l042","ordinal":72774,"en":"From Beijing with its forbidding cliffs,"},{"id":"manas-2010:p1692:b001:l001","ordinal":72775,"en":"If I ride the red horse, I shall pass through;"},{"id":"manas-2010:p1692:b001:l002","ordinal":72776,"en":"Bereft of the heroes,"},{"id":"manas-2010:p1692:b001:l003","ordinal":72777,"en":"How can I leave alone now?"},{"id":"manas-2010:p1692:b001:l004","ordinal":72778,"en":"In the hills, white-headed horses,"},{"id":"manas-2010:p1692:b001:l005","ordinal":72779,"en":"Thoroughbreds and noble steeds together;"},{"id":"manas-2010:p1692:b001:l006","ordinal":72780,"en":"The one who would gather them,"},{"id":"manas-2010:p1692:b001:l007","ordinal":72781,"en":"My son left behind, is young."},{"id":"manas-2010:p1692:b001:l008","ordinal":72782,"en":"Do not leave me helpless and alone;"},{"id":"manas-2010:p1692:b001:l009","ordinal":72783,"en":"Almambet, Chubak, take me with you."},{"id":"manas-2010:p1692:b001:l010","ordinal":72784,"en":"Bereft of Akkula,"},{"id":"manas-2010:p1692:b001:l011","ordinal":72785,"en":"I stand helpless on foot."},{"id":"manas-2010:p1692:b001:l012","ordinal":72786,"en":"My brothers Almambet and Chubak are gone;"},{"id":"manas-2010:p1692:b001:l013","ordinal":72787,"en":"What can I possibly do now?!”"},{"id":"manas-2010:p1692:b001:l014","ordinal":72788,"en":"As he stood in fury,"},{"id":"manas-2010:p1692:b001:l015","ordinal":72789,"en":"What twelve ages had never brought,"},{"id":"manas-2010:p1692:b001:l016","ordinal":72790,"en":"At that moment, upon the Generous One—"},{"id":"manas-2010:p1692:b001:l017","ordinal":72791,"en":"No one remained to rein him in."},{"id":"manas-2010:p1692:b001:l018","ordinal":72792,"en":"At that moment, your Generous One"},{"id":"manas-2010:p1692:b001:l019","ordinal":72793,"en":"Came forth in fury."},{"id":"manas-2010:p1692:b001:l020","ordinal":72794,"en":"When slung, the mirror of his shoulder,"},{"id":"manas-2010:p1692:b001:l021","ordinal":72795,"en":"When fired once at a contending foe,"},{"id":"manas-2010:p1692:b001:l022","ordinal":72796,"en":"The dear support of life held in trust."},{"id":"manas-2010:p1692:b001:l023","ordinal":72797,"en":"Earlier, my prince, leopard Manas,"},{"id":"manas-2010:p1692:b001:l024","ordinal":72798,"en":"His fortune in Altay,"},{"id":"manas-2010:p1692:b001:l025","ordinal":72799,"en":"When it was setting forth,"},{"id":"manas-2010:p1692:b001:l026","ordinal":72800,"en":"His mother Chyyrdy,"},{"id":"manas-2010:p1692:b001:l027","ordinal":72801,"en":"When she was giving birth,"},{"id":"manas-2010:p1692:b001:l028","ordinal":72802,"en":"In the travail God had made,"},{"id":"manas-2010:p1692:b001:l029","ordinal":72803,"en":"Before the elder wife"},{"id":"manas-2010:p1692:b001:l030","ordinal":72804,"en":"There had come then"},{"id":"manas-2010:p1692:b001:l031","ordinal":72805,"en":"A white-bearded wandering holy man."},{"id":"manas-2010:p1692:b001:l032","ordinal":72806,"en":"“Elder wife, heed my words,” he said."},{"id":"manas-2010:p1692:b001:l033","ordinal":72807,"en":"“This child is a lion."},{"id":"manas-2010:p1692:b001:l034","ordinal":72808,"en":"When he reaches twelve years,"},{"id":"manas-2010:p1692:b001:l035","ordinal":72809,"en":"Entrust this to him,” he said,"},{"id":"manas-2010:p1692:b001:l036","ordinal":72810,"en":"And gave a steel bullet then."},{"id":"manas-2010:p1692:b001:l037","ordinal":72811,"en":"“When his dear, proudly upright back"},{"id":"manas-2010:p1692:b001:l038","ordinal":72812,"en":"Bends, let him fire it."},{"id":"manas-2010:p1692:b001:l039","ordinal":72813,"en":"When his poor head, shaped like an apple,"},{"id":"manas-2010:p1692:b001:l040","ordinal":72814,"en":"Comes under strain, let him fire it."},{"id":"manas-2010:p1692:b001:l041","ordinal":72815,"en":"Despairing of his life held in trust,"},{"id":"manas-2010:p1692:b001:l042","ordinal":72816,"en":"When he is weary, let him fire it."},{"id":"manas-2010:p1693:b001:l001","ordinal":72817,"en":"Those whose fathers are utter unbelievers,"},{"id":"manas-2010:p1693:b001:l002","ordinal":72818,"en":"When they besiege him, let him fire it.”"},{"id":"manas-2010:p1693:b001:l003","ordinal":72819,"en":"At his birth, he touched it to his mouth."},{"id":"manas-2010:p1693:b001:l004","ordinal":72820,"en":"Your formidable mother Chyyrdy"},{"id":"manas-2010:p1693:b001:l005","ordinal":72821,"en":"And Kanykey, joining together,"},{"id":"manas-2010:p1693:b001:l006","ordinal":72822,"en":"Had hidden that bullet,"},{"id":"manas-2010:p1693:b001:l007","ordinal":72823,"en":"Sewing it into Akolpok's collar."},{"id":"manas-2010:p1693:b001:l008","ordinal":72824,"en":"Clutching his collar in anguish,"},{"id":"manas-2010:p1693:b001:l009","ordinal":72825,"en":"As that fierce-maned one stood,"},{"id":"manas-2010:p1693:b001:l010","ordinal":72826,"en":"He grieved, thinking of Almambet."},{"id":"manas-2010:p1693:b001:l011","ordinal":72827,"en":"The single bullet sewn in the collar"},{"id":"manas-2010:p1693:b001:l012","ordinal":72828,"en":"Caught his hand like a button."},{"id":"manas-2010:p1693:b001:l013","ordinal":72829,"en":"When the bullet touched his hand,"},{"id":"manas-2010:p1693:b001:l014","ordinal":72830,"en":"The leopard tore the stitches open at once."},{"id":"manas-2010:p1693:b001:l015","ordinal":72831,"en":"Half a charge of fine-shooting powder,"},{"id":"manas-2010:p1693:b001:l016","ordinal":72832,"en":"Into Akkelte's mouth the leopard"},{"id":"manas-2010:p1693:b001:l017","ordinal":72833,"en":"Poured from the powder flask."},{"id":"manas-2010:p1693:b001:l018","ordinal":72834,"en":"That sacred steel bullet"},{"id":"manas-2010:p1693:b001:l019","ordinal":72835,"en":"He rammed in with a rumble."},{"id":"manas-2010:p1693:b001:l020","ordinal":72836,"en":"The finely made telescope"},{"id":"manas-2010:p1693:b001:l021","ordinal":72837,"en":"He turned seven times."},{"id":"manas-2010:p1693:b001:l022","ordinal":72838,"en":"“See where it reaches,” he said;"},{"id":"manas-2010:p1693:b001:l023","ordinal":72839,"en":"The king aimed at seven rope-lengths."},{"id":"manas-2010:p1693:b001:l024","ordinal":72840,"en":"“Trust in God!” he said, the telescope"},{"id":"manas-2010:p1693:b001:l025","ordinal":72841,"en":"Turning ten times."},{"id":"manas-2010:p1693:b001:l026","ordinal":72842,"en":"“See the place you face,” he said,"},{"id":"manas-2010:p1693:b001:l027","ordinal":72843,"en":"Aiming at ten rope-lengths."},{"id":"manas-2010:p1693:b001:l028","ordinal":72844,"en":"The dear lord, the leopard,"},{"id":"manas-2010:p1693:b001:l029","ordinal":72845,"en":"Bound it again, fitting it close."},{"id":"manas-2010:p1693:b001:l030","ordinal":72846,"en":"That great telescope,"},{"id":"manas-2010:p1693:b001:l031","ordinal":72847,"en":"On top of Akkelte,"},{"id":"manas-2010:p1693:b001:l032","ordinal":72848,"en":"He bound and fastened together."},{"id":"manas-2010:p1693:b001:l033","ordinal":72849,"en":"Your noble lord, the goshawk,"},{"id":"manas-2010:p1693:b001:l034","ordinal":72850,"en":"Took Akkelte in his hand."},{"id":"manas-2010:p1693:b001:l035","ordinal":72851,"en":"A black rock like a saddle-shaped ridge,"},{"id":"manas-2010:p1693:b001:l036","ordinal":72852,"en":"Your king patiently took hold of,"},{"id":"manas-2010:p1693:b001:l037","ordinal":72853,"en":"And rested it upon it then."},{"id":"manas-2010:p1693:b001:l038","ordinal":72854,"en":"Pointing into the haze,"},{"id":"manas-2010:p1693:b001:l039","ordinal":72855,"en":"Dim and angular,"},{"id":"manas-2010:p1693:b001:l040","ordinal":72856,"en":"Of the unblessed black unbelievers"},{"id":"manas-2010:p1693:b001:l041","ordinal":72857,"en":"He caught sight of a corner,"},{"id":"manas-2010:p1693:b001:l042","ordinal":72858,"en":"Seething like ants."},{"id":"manas-2010:p1694:b001:l001","ordinal":72859,"en":"The surrounding black unbelievers'"},{"id":"manas-2010:p1694:b001:l002","ordinal":72860,"en":"People he now saw."},{"id":"manas-2010:p1694:b001:l003","ordinal":72861,"en":"The earth had turned to dust;"},{"id":"manas-2010:p1694:b001:l004","ordinal":72862,"en":"Receiving word from their khan,"},{"id":"manas-2010:p1694:b001:l005","ordinal":72863,"en":"Ninety Beijings had risen."},{"id":"manas-2010:p1694:b001:l006","ordinal":72864,"en":"There were many remarkable men;"},{"id":"manas-2010:p1694:b001:l007","ordinal":72865,"en":"Raging and boasting,"},{"id":"manas-2010:p1694:b001:l008","ordinal":72866,"en":"The swine Kojozhash had become khan in Beijing."},{"id":"manas-2010:p1694:b001:l009","ordinal":72867,"en":"The proud black unbelievers'"},{"id":"manas-2010:p1694:b001:l010","ordinal":72868,"en":"Lords he had gathered."},{"id":"manas-2010:p1694:b001:l011","ordinal":72869,"en":"Their champions, the Fierce One and Kojozhash,"},{"id":"manas-2010:p1694:b001:l012","ordinal":72870,"en":"Nine khans in all,"},{"id":"manas-2010:p1694:b001:l013","ordinal":72871,"en":"The unbelievers lay boasting."},{"id":"manas-2010:p1694:b001:l014","ordinal":72872,"en":"Before Chynchy Khan, Kojozhash"},{"id":"manas-2010:p1694:b001:l015","ordinal":72873,"en":"Boasted mightily:"},{"id":"manas-2010:p1694:b001:l016","ordinal":72874,"en":"“There is no ship upon the dark water."},{"id":"manas-2010:p1694:b001:l017","ordinal":72875,"en":"Chinese, as long as my dear head lives,"},{"id":"manas-2010:p1694:b001:l018","ordinal":72876,"en":"No one can resist you."},{"id":"manas-2010:p1694:b001:l019","ordinal":72877,"en":"There is no lord but me."},{"id":"manas-2010:p1694:b001:l020","ordinal":72878,"en":"When battle brought slaughter,"},{"id":"manas-2010:p1694:b001:l021","ordinal":72879,"en":"I overthrew the Burut's Almambet."},{"id":"manas-2010:p1694:b001:l022","ordinal":72880,"en":"Akbaltay's Chubak,"},{"id":"manas-2010:p1694:b001:l023","ordinal":72881,"en":"That roaring reckless one,"},{"id":"manas-2010:p1694:b001:l024","ordinal":72882,"en":"I cast out from this Beijing."},{"id":"manas-2010:p1694:b001:l025","ordinal":72883,"en":"When my fury truly rose,"},{"id":"manas-2010:p1694:b001:l026","ordinal":72884,"en":"I forged steel into a bullet;"},{"id":"manas-2010:p1694:b001:l027","ordinal":72885,"en":"The brim of the black felt hat"},{"id":"manas-2010:p1694:b001:l028","ordinal":72886,"en":"I erased from this Beijing."},{"id":"manas-2010:p1694:b001:l029","ordinal":72887,"en":"The worthless ones without courage"},{"id":"manas-2010:p1694:b001:l030","ordinal":72888,"en":"I captured alive."},{"id":"manas-2010:p1694:b001:l031","ordinal":72889,"en":"When they provoked my anger,"},{"id":"manas-2010:p1694:b001:l032","ordinal":72890,"en":"Of Khan Manas's forty companions,"},{"id":"manas-2010:p1694:b001:l033","ordinal":72891,"en":"I slew twelve."},{"id":"manas-2010:p1694:b001:l034","ordinal":72892,"en":"The wishes of the living Burut"},{"id":"manas-2010:p1694:b001:l035","ordinal":72893,"en":"I have ruined like this."},{"id":"manas-2010:p1694:b001:l036","ordinal":72894,"en":"Their khan Manas himself"},{"id":"manas-2010:p1694:b001:l037","ordinal":72895,"en":"I made howl upon the ridge."},{"id":"manas-2010:p1694:b001:l038","ordinal":72896,"en":"Those who defied me"},{"id":"manas-2010:p1694:b001:l039","ordinal":72897,"en":"I simply destroyed like this."},{"id":"manas-2010:p1694:b001:l040","ordinal":72898,"en":"The shameless soul who still lives"},{"id":"manas-2010:p1694:b001:l041","ordinal":72899,"en":"Strains on, thinking he will not die."},{"id":"manas-2010:p1694:b001:l042","ordinal":72900,"en":"Wounded, fierce-maned Manas's"},{"id":"manas-2010:p1695:b001:l001","ordinal":72901,"en":"Horse I shot down."},{"id":"manas-2010:p1695:b001:l002","ordinal":72902,"en":"Now alone, where can he escape?"},{"id":"manas-2010:p1695:b001:l003","ordinal":72903,"en":"Their wounded Sultan Manas,"},{"id":"manas-2010:p1695:b001:l004","ordinal":72904,"en":"Let us swarm and seize him."},{"id":"manas-2010:p1695:b001:l005","ordinal":72905,"en":"The medicine called Üpü,"},{"id":"manas-2010:p1695:b001:l006","ordinal":72906,"en":"Let us put it upon his wound."},{"id":"manas-2010:p1695:b001:l007","ordinal":72907,"en":"By whatever means, Manas"},{"id":"manas-2010:p1695:b001:l008","ordinal":72908,"en":"Let us heal."},{"id":"manas-2010:p1695:b001:l009","ordinal":72909,"en":"Without killing or losing him,"},{"id":"manas-2010:p1695:b001:l010","ordinal":72910,"en":"Let us bind him and take him to Beijing."},{"id":"manas-2010:p1695:b001:l011","ordinal":72911,"en":"The forty wanton women in Beijing,"},{"id":"manas-2010:p1695:b001:l012","ordinal":72912,"en":"The women of the royal household,"},{"id":"manas-2010:p1695:b001:l013","ordinal":72913,"en":"Without shame, the Generous One"},{"id":"manas-2010:p1695:b001:l014","ordinal":72914,"en":"Let us take to them and keep as a stud."},{"id":"manas-2010:p1695:b001:l015","ordinal":72915,"en":"From Manas, father of his people,"},{"id":"manas-2010:p1695:b001:l016","ordinal":72916,"en":"Let us obtain the offspring we desire."},{"id":"manas-2010:p1695:b001:l017","ordinal":72917,"en":"Those seething women and girls,"},{"id":"manas-2010:p1695:b001:l018","ordinal":72918,"en":"Let us take him to them as a stud."},{"id":"manas-2010:p1695:b001:l019","ordinal":72919,"en":"From the girls and women, excelling,"},{"id":"manas-2010:p1695:b001:l020","ordinal":72920,"en":"If a son is born,"},{"id":"manas-2010:p1695:b001:l021","ordinal":72921,"en":"In the emperor's Beijing,"},{"id":"manas-2010:p1695:b001:l022","ordinal":72922,"en":"In Karykhan's place,"},{"id":"manas-2010:p1695:b001:l023","ordinal":72923,"en":"Putting a golden crown upon him,"},{"id":"manas-2010:p1695:b001:l024","ordinal":72924,"en":"Seating him upon the golden throne,"},{"id":"manas-2010:p1695:b001:l025","ordinal":72925,"en":"Of palm-sized Beijing,"},{"id":"manas-2010:p1695:b001:l026","ordinal":72926,"en":"Giving him its unity and making it known,"},{"id":"manas-2010:p1695:b001:l027","ordinal":72927,"en":"Let us send word to the people."},{"id":"manas-2010:p1695:b001:l028","ordinal":72928,"en":"Over the imperial realm itself,"},{"id":"manas-2010:p1695:b001:l029","ordinal":72929,"en":"If a son is born of him,"},{"id":"manas-2010:p1695:b001:l030","ordinal":72930,"en":"Let us raise him as khan!”"},{"id":"manas-2010:p1695:b001:l031","ordinal":72931,"en":"Thus spoke Kojozhash."},{"id":"manas-2010:p1695:b001:l032","ordinal":72932,"en":"The Kalmyks' dark spirits,"},{"id":"manas-2010:p1695:b001:l033","ordinal":72933,"en":"A flask of that strong liquor,"},{"id":"manas-2010:p1695:b001:l034","ordinal":72934,"en":"They tipped up and drank together,"},{"id":"manas-2010:p1695:b001:l035","ordinal":72935,"en":"Raised and swallowed together."},{"id":"manas-2010:p1695:b001:l036","ordinal":72936,"en":"Their Buddha image made of bronze,"},{"id":"manas-2010:p1695:b001:l037","ordinal":72937,"en":"In the windswept barren plain,"},{"id":"manas-2010:p1695:b001:l038","ordinal":72938,"en":"They had hung and tied up."},{"id":"manas-2010:p1695:b001:l039","ordinal":72939,"en":"Before the bronze-and-copper Buddha image,"},{"id":"manas-2010:p1695:b001:l040","ordinal":72940,"en":"Rising and bowing in worship,"},{"id":"manas-2010:p1695:b001:l041","ordinal":72941,"en":"The unbelievers offered penitence."},{"id":"manas-2010:p1695:b001:l042","ordinal":72942,"en":"Shouting in fury,"},{"id":"manas-2010:p1696:b001:l001","ordinal":72943,"en":"All of their khans"},{"id":"manas-2010:p1696:b001:l002","ordinal":72944,"en":"Stood proudly, shouting battle cries,"},{"id":"manas-2010:p1696:b001:l003","ordinal":72945,"en":"Roaring in their fury."},{"id":"manas-2010:p1696:b001:l004","ordinal":72946,"en":"Kojojash kept boasting:"},{"id":"manas-2010:p1696:b001:l005","ordinal":72947,"en":"“Among the red-scabbarded Chinese,"},{"id":"manas-2010:p1696:b001:l006","ordinal":72948,"en":"I myself am the strongest!"},{"id":"manas-2010:p1696:b001:l007","ordinal":72949,"en":"The Chinese people of forty khans—"},{"id":"manas-2010:p1696:b001:l008","ordinal":72950,"en":"I shall take all their khanates!"},{"id":"manas-2010:p1696:b001:l009","ordinal":72951,"en":"Of this Chinese people with its king,"},{"id":"manas-2010:p1696:b001:l010","ordinal":72952,"en":"I myself have become the chief!"},{"id":"manas-2010:p1696:b001:l011","ordinal":72953,"en":"The Buruts who dared oppose us—"},{"id":"manas-2010:p1696:b001:l012","ordinal":72954,"en":"I have drained them of everything!”"},{"id":"manas-2010:p1696:b001:l013","ordinal":72955,"en":"Joykara and Kojojash,"},{"id":"manas-2010:p1696:b001:l014","ordinal":72956,"en":"Shuykuchu and Körögöch,"},{"id":"manas-2010:p1696:b001:l015","ordinal":72957,"en":"Ugarkulak and Kanzharkol,"},{"id":"manas-2010:p1696:b001:l016","ordinal":72958,"en":"Bozkertik standing across from them,"},{"id":"manas-2010:p1696:b001:l017","ordinal":72959,"en":"With Zhelzhetpes, the eight"},{"id":"manas-2010:p1696:b001:l018","ordinal":72960,"en":"Now stood in a row."}]
