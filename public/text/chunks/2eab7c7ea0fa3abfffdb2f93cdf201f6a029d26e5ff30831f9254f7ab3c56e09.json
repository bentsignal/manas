[{"id":"semetey-1-2013:p0767:b003:l033","ordinal":135681,"en":"Narbuurul, left by your father—"},{"id":"semetey-1-2013:p0767:b003:l034","ordinal":135682,"en":"When your father Manas died,"},{"id":"semetey-1-2013:p0767:b003:l035","ordinal":135683,"en":"Buurul observed mourning."},{"id":"semetey-1-2013:p0767:b003:l036","ordinal":135684,"en":"Tethered, he would not stand still;"},{"id":"semetey-1-2013:p0767:b003:l037","ordinal":135685,"en":"Released, he would not graze."},{"id":"semetey-1-2013:p0767:b003:l038","ordinal":135686,"en":"Neighing and shaking his head,"},{"id":"semetey-1-2013:p0767:b003:l039","ordinal":135687,"en":"Distressed and bewildered,"},{"id":"semetey-1-2013:p0767:b004:l001","ordinal":135688,"en":"Though an animal, that wondrous creature"},{"id":"semetey-1-2013:p0767:b004:l002","ordinal":135689,"en":"Cried aloud in mourning."},{"id":"semetey-1-2013:p0767:b004:l003","ordinal":135690,"en":"His forelock thinned upon his crown;"},{"id":"semetey-1-2013:p0767:b004:l004","ordinal":135691,"en":"Tears poured from his eyes."},{"id":"semetey-1-2013:p0767:b004:l005","ordinal":135692,"en":"Bellowing without cease,"},{"id":"semetey-1-2013:p0767:b004:l006","ordinal":135693,"en":"It's a shame, Buurul horse."},{"id":"semetey-1-2013:p0767:b004:l007","ordinal":135694,"en":"His desire, in this way,"},{"id":"semetey-1-2013:p0767:b004:l008","ordinal":135695,"en":"Buurul had attained."},{"id":"semetey-1-2013:p0767:b004:l009","ordinal":135696,"en":"With seven thousand coursers following,"},{"id":"semetey-1-2013:p0767:b004:l010","ordinal":135697,"en":"Buurul departed."},{"id":"semetey-1-2013:p0767:b004:l011","ordinal":135698,"en":"Unseen by a single person,"},{"id":"semetey-1-2013:p0767:b004:l012","ordinal":135699,"en":"Letting no one catch him,"},{"id":"semetey-1-2013:p0767:b004:l013","ordinal":135700,"en":"He stopped upon the mountaintop,"},{"id":"semetey-1-2013:p0767:b004:l014","ordinal":135701,"en":"And grazed upon nine hills."},{"id":"semetey-1-2013:p0767:b004:l015","ordinal":135702,"en":"He grazed where there were no people,"},{"id":"semetey-1-2013:p0767:b004:l016","ordinal":135703,"en":"Drank water in deserted places."},{"id":"semetey-1-2013:p0767:b004:l017","ordinal":135704,"en":"From that day to this,"},{"id":"semetey-1-2013:p0767:b004:l018","ordinal":135705,"en":"He cannot be caught by the eye."},{"id":"semetey-1-2013:p0767:b004:l019","ordinal":135706,"en":"He has vanished into the unseen;"},{"id":"semetey-1-2013:p0767:b004:l020","ordinal":135707,"en":"No one knows where he is."},{"id":"semetey-1-2013:p0767:b004:l021","ordinal":135708,"en":"There is no one who says, “I saw him”;"},{"id":"semetey-1-2013:p0767:b004:l022","ordinal":135709,"en":"No mortal who says, “I know.”"},{"id":"semetey-1-2013:p0767:b004:l023","ordinal":135710,"en":"My support in life, left by Manas,"},{"id":"semetey-1-2013:p0767:b004:l024","ordinal":135711,"en":"My mirror, left by my khan!"},{"id":"semetey-1-2013:p0767:b004:l025","ordinal":135712,"en":"When your father Manas was here,"},{"id":"semetey-1-2013:p0767:b004:l026","ordinal":135713,"en":"Six multitudes of horses upon the hills,"},{"id":"semetey-1-2013:p0767:b004:l027","ordinal":135714,"en":"Coursers and swift steeds mingled,"},{"id":"semetey-1-2013:p0767:b004:l028","ordinal":135715,"en":"Increased and did not diminish."},{"id":"semetey-1-2013:p0767:b004:l029","ordinal":135716,"en":"The keen steel left by your father"},{"id":"semetey-1-2013:p0767:b004:l030","ordinal":135717,"en":"Has grown finer, never chipped."},{"id":"semetey-1-2013:p0767:b004:l031","ordinal":135718,"en":"The treasure left by your father"},{"id":"semetey-1-2013:p0767:b004:l032","ordinal":135719,"en":"Has only filled, never dwindled."},{"id":"semetey-1-2013:p0767:b004:l033","ordinal":135720,"en":"Here is the livestock your father left,"},{"id":"semetey-1-2013:p0767:b004:l034","ordinal":135721,"en":"Here are the people your father left,"},{"id":"semetey-1-2013:p0767:b004:l035","ordinal":135722,"en":"Here is the treasure your father left,"},{"id":"semetey-1-2013:p0767:b004:l036","ordinal":135723,"en":"Here is the property your father left!"},{"id":"semetey-1-2013:p0767:b004:l037","ordinal":135724,"en":"Your father Manas, the leopard—"},{"id":"semetey-1-2013:p0767:b004:l038","ordinal":135725,"en":"‘Kutu's son is mighty!’"},{"id":"semetey-1-2013:p0767:b004:l039","ordinal":135726,"en":"If you come and settle in Talas,"},{"id":"semetey-1-2013:p0768:b003:l001","ordinal":135727,"en":"My dear orphan,"},{"id":"semetey-1-2013:p0768:b003:l002","ordinal":135728,"en":"This great people standing here"},{"id":"semetey-1-2013:p0768:b003:l003","ordinal":135729,"en":"Are the subjects your father left."},{"id":"semetey-1-2013:p0768:b003:l004","ordinal":135730,"en":"Long I wandered in grief and distress,"},{"id":"semetey-1-2013:p0768:b003:l005","ordinal":135731,"en":"The orphan of Khan Manas—"},{"id":"semetey-1-2013:p0768:b003:l006","ordinal":135732,"en":"I wondered when he would arrive."},{"id":"semetey-1-2013:p0768:b003:l007","ordinal":135733,"en":"Here is the treasury, here the people,"},{"id":"semetey-1-2013:p0768:b003:l008","ordinal":135734,"en":"Who pined for you, my orphan—"},{"id":"semetey-1-2013:p0768:b003:l009","ordinal":135735,"en":"Here am I, your uncle Abyke!"},{"id":"semetey-1-2013:p0768:b003:l010","ordinal":135736,"en":"Abyke, the wise kinsman,"},{"id":"semetey-1-2013:p0768:b003:l011","ordinal":135737,"en":"To the child who came from afar"},{"id":"semetey-1-2013:p0768:b003:l012","ordinal":135738,"en":"Now gave his counsel earnestly;"},{"id":"semetey-1-2013:p0768:b003:l013","ordinal":135739,"en":"The orphan who came from afar"},{"id":"semetey-1-2013:p0768:b003:l014","ordinal":135740,"en":"He greeted, standing there in tears."},{"id":"semetey-1-2013:p0768:b003:l015","ordinal":135741,"en":"What Abyke had said—"},{"id":"semetey-1-2013:p0768:b003:l016","ordinal":135742,"en":"Let us leave that aside for now,"},{"id":"semetey-1-2013:p0768:b003:l017","ordinal":135743,"en":"In Akylay's embrace,"},{"id":"semetey-1-2013:p0768:b003:l018","ordinal":135744,"en":"He had lain for days and nights—"},{"id":"semetey-1-2013:p0768:b003:l019","ordinal":135745,"en":"Let us begin to tell of Kobosh:"},{"id":"semetey-1-2013:p0768:b003:l020","ordinal":135746,"en":"Foolish and envious,"},{"id":"semetey-1-2013:p0768:b003:l021","ordinal":135747,"en":"Among the six was Kobosh, born to wickedness."},{"id":"semetey-1-2013:p0768:b003:l022","ordinal":135748,"en":"The swine was truly worse than most."},{"id":"semetey-1-2013:p0768:b003:l023","ordinal":135749,"en":"Like a vicious stallion,"},{"id":"semetey-1-2013:p0768:b003:l024","ordinal":135750,"en":"He was a thudding wretch;"},{"id":"semetey-1-2013:p0768:b003:l025","ordinal":135751,"en":"Like a boar in the forest,"},{"id":"semetey-1-2013:p0768:b003:l026","ordinal":135752,"en":"He was a grunting wretch."},{"id":"semetey-1-2013:p0768:b003:l027","ordinal":135753,"en":"From the direction of prayer,"},{"id":"semetey-1-2013:p0768:b003:l028","ordinal":135754,"en":"He was no wretch to be a breeze,"},{"id":"semetey-1-2013:p0768:b003:l029","ordinal":135755,"en":"Nor one to join with the orphan"},{"id":"semetey-1-2013:p0768:b003:l030","ordinal":135756,"en":"And become one people."},{"id":"semetey-1-2013:p0768:b003:l031","ordinal":135757,"en":"Like a black young ram,"},{"id":"semetey-1-2013:p0768:b003:l032","ordinal":135758,"en":"That wretch would beat them."},{"id":"semetey-1-2013:p0768:b003:l033","ordinal":135759,"en":"Whoever fell into his hands,"},{"id":"semetey-1-2013:p0768:b003:l034","ordinal":135760,"en":"That wretch would beat them."},{"id":"semetey-1-2013:p0768:b003:l035","ordinal":135761,"en":"Taxes and tribute on his people"},{"id":"semetey-1-2013:p0768:b003:l036","ordinal":135762,"en":"That wretch kept raining down;"},{"id":"semetey-1-2013:p0768:b003:l037","ordinal":135763,"en":"Anyone who opposed him"},{"id":"semetey-1-2013:p0768:b003:l038","ordinal":135764,"en":"He thrust alive into the earth,"},{"id":"semetey-1-2013:p0768:b003:l039","ordinal":135765,"en":"And kept them buried underfoot."},{"id":"semetey-1-2013:p0768:b004:l001","ordinal":135766,"en":"Among the six, Kobosh was khan;"},{"id":"semetey-1-2013:p0768:b004:l002","ordinal":135767,"en":"Such was the suffering he caused,"},{"id":"semetey-1-2013:p0768:b004:l003","ordinal":135768,"en":"And he himself was a fool."},{"id":"semetey-1-2013:p0768:b004:l004","ordinal":135769,"en":"Kobosh stood there, gathering rage,"},{"id":"semetey-1-2013:p0768:b004:l005","ordinal":135770,"en":"To the orphan son of Manas"},{"id":"semetey-1-2013:p0768:b004:l006","ordinal":135771,"en":"Speaking without restraint."},{"id":"semetey-1-2013:p0768:b004:l007","ordinal":135772,"en":"Kobosh began his threats;"},{"id":"semetey-1-2013:p0768:b004:l008","ordinal":135773,"en":"The orphan son of Manas"},{"id":"semetey-1-2013:p0768:b004:l009","ordinal":135774,"en":"Cut them down outright."},{"id":"semetey-1-2013:p0768:b004:l010","ordinal":135775,"en":"His bellow split heads,"},{"id":"semetey-1-2013:p0768:b004:l011","ordinal":135776,"en":"His shout split stone."},{"id":"semetey-1-2013:p0768:b004:l012","ordinal":135777,"en":"Raging and roaring,"},{"id":"semetey-1-2013:p0768:b004:l013","ordinal":135778,"en":"Dear Kobosh thundered:"},{"id":"semetey-1-2013:p0768:b004:l014","ordinal":135779,"en":"“To Temir Khan’s city"},{"id":"semetey-1-2013:p0768:b004:l015","ordinal":135780,"en":"You wandered, you orphan slave;"},{"id":"semetey-1-2013:p0768:b004:l016","ordinal":135781,"en":"To Kara Khan’s city"},{"id":"semetey-1-2013:p0768:b004:l017","ordinal":135782,"en":"You fled, you fugitive slave;"},{"id":"semetey-1-2013:p0768:b004:l018","ordinal":135783,"en":"This damned orphan—"},{"id":"semetey-1-2013:p0768:b004:l019","ordinal":135784,"en":"Look at what he is doing."},{"id":"semetey-1-2013:p0768:b004:l020","ordinal":135785,"en":"I shall kill him, sever his head,"},{"id":"semetey-1-2013:p0768:b004:l021","ordinal":135786,"en":"And put him out like a fire."},{"id":"semetey-1-2013:p0768:b004:l022","ordinal":135787,"en":"When a cliff falls, water bears it up;"},{"id":"semetey-1-2013:p0768:b004:l023","ordinal":135788,"en":"If this lone slave dies, who will uphold him?!"},{"id":"semetey-1-2013:p0768:b004:l024","ordinal":135789,"en":"You damned orphan slave,"},{"id":"semetey-1-2013:p0768:b004:l025","ordinal":135790,"en":"What remained to you from your father, Khan Manas?"},{"id":"semetey-1-2013:p0768:b004:l027","ordinal":135791,"en":"A short-tailed dun mare remained,"},{"id":"semetey-1-2013:p0768:b004:l028","ordinal":135792,"en":"A single maggot-ridden camel remained,"},{"id":"semetey-1-2013:p0768:b004:l029","ordinal":135793,"en":"A black cow with a torn nostril remained,"},{"id":"semetey-1-2013:p0768:b004:l030","ordinal":135794,"en":"A tattered black yurt remained."},{"id":"semetey-1-2013:p0768:b004:l031","ordinal":135795,"en":"Your father Manas"},{"id":"semetey-1-2013:p0768:b004:l032","ordinal":135796,"en":"Entered a black little hut;"},{"id":"semetey-1-2013:p0768:b004:l033","ordinal":135797,"en":"Your father spent his days"},{"id":"semetey-1-2013:p0768:b004:l034","ordinal":135798,"en":"Fighting with anyone and everyone."},{"id":"semetey-1-2013:p0768:b004:l035","ordinal":135799,"en":"With these wishes your father,"},{"id":"semetey-1-2013:p0768:b004:l036","ordinal":135800,"en":"Loading his baggage onto a calf,"},{"id":"semetey-1-2013:p0768:b004:l037","ordinal":135801,"en":"Making you suffer hell like this."},{"id":"semetey-1-2013:p0768:b004:l038","ordinal":135802,"en":"Your father Manas, the fool,"},{"id":"semetey-1-2013:p0768:b004:l039","ordinal":135803,"en":"Used to ride Akkula,"},{"id":"semetey-1-2013:p0769:b003:l001","ordinal":135804,"en":"Fighting whoever faced him,"},{"id":"semetey-1-2013:p0769:b003:l002","ordinal":135805,"en":"Going about with threats."},{"id":"semetey-1-2013:p0769:b003:l003","ordinal":135806,"en":"Akkula, whom your father rode,"},{"id":"semetey-1-2013:p0769:b003:l004","ordinal":135807,"en":"Was a horse of ours."},{"id":"semetey-1-2013:p0769:b003:l005","ordinal":135808,"en":"That Manas, with his bullying,"},{"id":"semetey-1-2013:p0769:b003:l006","ordinal":135809,"en":"Rode him by force."},{"id":"semetey-1-2013:p0769:b003:l007","ordinal":135810,"en":"When one of his moods seized him,"},{"id":"semetey-1-2013:p0769:b003:l008","ordinal":135811,"en":"He gelded a thoroughbred to make a mount,"},{"id":"semetey-1-2013:p0769:b003:l009","ordinal":135812,"en":"And estranged us from Altai."},{"id":"semetey-1-2013:p0769:b003:l010","ordinal":135813,"en":"This one's father, foolish Manas—"},{"id":"semetey-1-2013:p0769:b003:l011","ordinal":135814,"en":"Where did he ever raid a people?"},{"id":"semetey-1-2013:p0769:b003:l012","ordinal":135815,"en":"Your father was a fool,"},{"id":"semetey-1-2013:p0769:b003:l013","ordinal":135816,"en":"Who lived upon our livestock."},{"id":"semetey-1-2013:p0769:b003:l014","ordinal":135817,"en":"He started scandalous affairs;"},{"id":"semetey-1-2013:p0769:b003:l015","ordinal":135818,"en":"When they came from the Kalmyks, received with honor,"},{"id":"semetey-1-2013:p0769:b003:l016","ordinal":135819,"en":"Kinsmen such as Kozkaman"},{"id":"semetey-1-2013:p0769:b003:l017","ordinal":135820,"en":"He slaughtered all together."},{"id":"semetey-1-2013:p0769:b003:l018","ordinal":135821,"en":"Made of pine,"},{"id":"semetey-1-2013:p0769:b003:l019","ordinal":135822,"en":"He stirred up trouble with the Chinese"},{"id":"semetey-1-2013:p0769:b003:l020","ordinal":135823,"en":"And made us their enemies."},{"id":"semetey-1-2013:p0769:b003:l021","ordinal":135824,"en":"This damned orphan—"},{"id":"semetey-1-2013:p0769:b003:l022","ordinal":135825,"en":"Look at what he has done!"},{"id":"semetey-1-2013:p0769:b003:l023","ordinal":135826,"en":"How many people did Manas leave,"},{"id":"semetey-1-2013:p0769:b003:l024","ordinal":135827,"en":"What livestock did your father leave?"},{"id":"semetey-1-2013:p0769:b003:l025","ordinal":135828,"en":"Akshumkar, whom you speak of,"},{"id":"semetey-1-2013:p0769:b003:l026","ordinal":135829,"en":"I myself took from the nest"},{"id":"semetey-1-2013:p0769:b003:l027","ordinal":135830,"en":"And flew him for my pleasure."},{"id":"semetey-1-2013:p0769:b003:l028","ordinal":135831,"en":"You damned orphan slave,"},{"id":"semetey-1-2013:p0769:b003:l029","ordinal":135832,"en":"When was he ever Manas's bird!"},{"id":"semetey-1-2013:p0769:b003:l030","ordinal":135833,"en":"From the desert of Mediyan,"},{"id":"semetey-1-2013:p0769:b003:l031","ordinal":135834,"en":"From the place I washed for prayer,"},{"id":"semetey-1-2013:p0769:b003:l032","ordinal":135835,"en":"I found and took Kumayyk;"},{"id":"semetey-1-2013:p0769:b003:l033","ordinal":135836,"en":"I tended him as a puppy,"},{"id":"semetey-1-2013:p0769:b003:l034","ordinal":135837,"en":"Kept him until he was grown,"},{"id":"semetey-1-2013:p0769:b003:l035","ordinal":135838,"en":"Had discerning judges assess him,"},{"id":"semetey-1-2013:p0769:b003:l036","ordinal":135839,"en":"That's why"},{"id":"semetey-1-2013:p0769:b003:l037","ordinal":135840,"en":"Had a collar put upon his neck,"},{"id":"semetey-1-2013:p0769:b003:l038","ordinal":135841,"en":"Had keepers care for him—"},{"id":"semetey-1-2013:p0769:b003:l039","ordinal":135842,"en":"My own dog, whom I found."},{"id":"semetey-1-2013:p0769:b005:l001","ordinal":135843,"en":"You damned orphan slave,"},{"id":"semetey-1-2013:p0769:b005:l002","ordinal":135844,"en":"When was he ever Manas's dog?"},{"id":"semetey-1-2013:p0769:b005:l003","ordinal":135845,"en":"Yesterday I went and raided the Afghans;"},{"id":"semetey-1-2013:p0769:b005:l004","ordinal":135846,"en":"How could Margilan remain unharmed?"},{"id":"semetey-1-2013:p0769:b005:l005","ordinal":135847,"en":"When I humiliated the religious master,"},{"id":"semetey-1-2013:p0769:b005:l006","ordinal":135848,"en":"When I beat the mullah,"},{"id":"semetey-1-2013:p0769:b005:l007","ordinal":135849,"en":"I seized Akolpok—"},{"id":"semetey-1-2013:p0769:b005:l008","ordinal":135850,"en":"When was it ever Manas's coat?"},{"id":"semetey-1-2013:p0769:b005:l009","ordinal":135851,"en":"You damned orphan slave,"},{"id":"semetey-1-2013:p0769:b005:l010","ordinal":135852,"en":"Look at what he is saying!"},{"id":"semetey-1-2013:p0769:b005:l011","ordinal":135853,"en":"What he calls Boz Kise,"},{"id":"semetey-1-2013:p0769:b005:l012","ordinal":135854,"en":"What nonsense he is speaking!"},{"id":"semetey-1-2013:p0769:b005:l013","ordinal":135855,"en":"When I roamed through Medina,"},{"id":"semetey-1-2013:p0769:b005:l014","ordinal":135856,"en":"When I went toward Mecca,"},{"id":"semetey-1-2013:p0769:b005:l015","ordinal":135857,"en":"From the ridge of Medina,"},{"id":"semetey-1-2013:p0769:b005:l016","ordinal":135858,"en":"From the place where the fairy played,"},{"id":"semetey-1-2013:p0769:b005:l017","ordinal":135859,"en":"It came upon me from the unseen,"},{"id":"semetey-1-2013:p0769:b005:l018","ordinal":135860,"en":"And was found by my very self."},{"id":"semetey-1-2013:p0769:b005:l019","ordinal":135861,"en":"You damned orphan slave,"},{"id":"semetey-1-2013:p0769:b005:l020","ordinal":135862,"en":"When was it ever Manas's possession?"},{"id":"semetey-1-2013:p0769:b005:l021","ordinal":135863,"en":"This damned orphan—"},{"id":"semetey-1-2013:p0769:b005:l022","ordinal":135864,"en":"Look at what he is doing."},{"id":"semetey-1-2013:p0769:b005:l023","ordinal":135865,"en":"Beyond Andijan,"},{"id":"semetey-1-2013:p0769:b005:l024","ordinal":135866,"en":"This side of Amangen,"},{"id":"semetey-1-2013:p0769:b005:l025","ordinal":135867,"en":"Under the wing of the khan of Kokand,"},{"id":"semetey-1-2013:p0769:b005:l026","ordinal":135868,"en":"From the moonlike yellow plain,"},{"id":"semetey-1-2013:p0769:b005:l027","ordinal":135869,"en":"Sixty Russian land surveyors,"},{"id":"semetey-1-2013:p0769:b005:l028","ordinal":135870,"en":"Having their carts pulled along,"},{"id":"semetey-1-2013:p0769:b005:l029","ordinal":135871,"en":"Wearing their yellow coats,"},{"id":"semetey-1-2013:p0769:b005:l030","ordinal":135872,"en":"Riding their mares bareback—"},{"id":"semetey-1-2013:p0769:b005:l031","ordinal":135873,"en":"When the surveyors came out,"},{"id":"semetey-1-2013:p0769:b005:l032","ordinal":135874,"en":"I slaughtered and robbed the Russians;"},{"id":"semetey-1-2013:p0769:b005:l033","ordinal":135875,"en":"From that Russian's back,"},{"id":"semetey-1-2013:p0769:b005:l034","ordinal":135876,"en":"I snatched it from his hand;"},{"id":"semetey-1-2013:p0769:b005:l035","ordinal":135877,"en":"I fell upon them, wreaking havoc,"},{"id":"semetey-1-2013:p0769:b005:l036","ordinal":135878,"en":"I myself seized it."},{"id":"semetey-1-2013:p0769:b005:l037","ordinal":135879,"en":"You damned orphan slave,"},{"id":"semetey-1-2013:p0769:b005:l038","ordinal":135880,"en":"When was it ever Manas's gun?"},{"id":"semetey-1-2013:p0769:b005:l039","ordinal":135881,"en":"Yesterday, when I went ravaging Bukhara,"},{"id":"semetey-1-2013:p0770:b003:l001","ordinal":135882,"en":"When they plundered my costly cloth,"},{"id":"semetey-1-2013:p0770:b003:l002","ordinal":135883,"en":"It struck whatever met its wrath;"},{"id":"semetey-1-2013:p0770:b003:l003","ordinal":135884,"en":"Found in a deserted place,"},{"id":"semetey-1-2013:p0770:b003:l004","ordinal":135885,"en":"The six keen blades fallen from heaven"},{"id":"semetey-1-2013:p0770:b003:l005","ordinal":135886,"en":"I myself discovered."},{"id":"semetey-1-2013:p0770:b003:l006","ordinal":135887,"en":"You damned orphan slave,"},{"id":"semetey-1-2013:p0770:b003:l007","ordinal":135888,"en":"When were they ever Manas's property?"},{"id":"semetey-1-2013:p0770:b003:l008","ordinal":135889,"en":"From the pass of Yrgayty,"},{"id":"semetey-1-2013:p0770:b003:l009","ordinal":135890,"en":"When I truly advanced to meet them,"},{"id":"semetey-1-2013:p0770:b003:l010","ordinal":135891,"en":"When I wrought great havoc,"},{"id":"semetey-1-2013:p0770:b003:l011","ordinal":135892,"en":"Below Old Turpan,"},{"id":"semetey-1-2013:p0770:b003:l012","ordinal":135893,"en":"Facing Great Barbar,"},{"id":"semetey-1-2013:p0770:b003:l013","ordinal":135894,"en":"Beside the Lop River,"},{"id":"semetey-1-2013:p0770:b003:l014","ordinal":135895,"en":"When I attacked the Noygut,"},{"id":"semetey-1-2013:p0770:b003:l015","ordinal":135896,"en":"Against Karacha's Saykal,"},{"id":"semetey-1-2013:p0770:b003:l016","ordinal":135897,"en":"When I went to battle,"},{"id":"semetey-1-2013:p0770:b003:l017","ordinal":135898,"en":"Against renowned Saykal,"},{"id":"semetey-1-2013:p0770:b003:l018","ordinal":135899,"en":"When I went to joust,"},{"id":"semetey-1-2013:p0770:b003:l019","ordinal":135900,"en":"When we stood facing each other,"},{"id":"semetey-1-2013:p0770:b003:l020","ordinal":135901,"en":"When we fought fiercely,"},{"id":"semetey-1-2013:p0770:b003:l021","ordinal":135902,"en":"Advancing and thrusting our lances,"},{"id":"semetey-1-2013:p0770:b003:l022","ordinal":135903,"en":"When we met, our lances"},{"id":"semetey-1-2013:p0770:b003:l023","ordinal":135904,"en":"We broke across their middles."},{"id":"semetey-1-2013:p0770:b003:l024","ordinal":135905,"en":"We stood braced against each other,"},{"id":"semetey-1-2013:p0770:b003:l025","ordinal":135906,"en":"Fighting face to face again and again,"},{"id":"semetey-1-2013:p0770:b003:l026","ordinal":135907,"en":"Firing guns and drawing bows,"},{"id":"semetey-1-2013:p0770:b003:l027","ordinal":135908,"en":"Fighting without fleeing,"},{"id":"semetey-1-2013:p0770:b003:l028","ordinal":135909,"en":"Battling with battle-axes,"},{"id":"semetey-1-2013:p0770:b003:l029","ordinal":135910,"en":"Unable to close our eyes,"},{"id":"semetey-1-2013:p0770:b003:l030","ordinal":135911,"en":"Wrestling from horseback,"},{"id":"semetey-1-2013:p0770:b003:l031","ordinal":135912,"en":"Grappling by the collars,"},{"id":"semetey-1-2013:p0770:b003:l032","ordinal":135913,"en":"At the pass of Yrgayty,"},{"id":"semetey-1-2013:p0770:b003:l033","ordinal":135914,"en":"Swaying against one another,"},{"id":"semetey-1-2013:p0770:b003:l034","ordinal":135915,"en":"Fighting just like that—"},{"id":"semetey-1-2013:p0770:b003:l035","ordinal":135916,"en":"Karacha's Saykal"},{"id":"semetey-1-2013:p0770:b003:l036","ordinal":135917,"en":"I myself struck with my lance."},{"id":"semetey-1-2013:p0770:b003:l037","ordinal":135918,"en":"You damned orphan slave,"},{"id":"semetey-1-2013:p0770:b003:l038","ordinal":135919,"en":"Buurul, the horse you speak of—"},{"id":"semetey-1-2013:p0770:b003:l039","ordinal":135920,"en":"When was he ever Manas's livestock?"},{"id":"semetey-1-2013:p0770:b004:l001","ordinal":135921,"en":"Six multitudes of horses on the hills,"},{"id":"semetey-1-2013:p0770:b004:l002","ordinal":135922,"en":"Famous swift horses, mottled-headed,"},{"id":"semetey-1-2013:p0770:b004:l003","ordinal":135923,"en":"With thoroughbreds and coursers among them,"},{"id":"semetey-1-2013:p0770:b004:l004","ordinal":135924,"en":"These herds filling the valley"},{"id":"semetey-1-2013:p0770:b004:l005","ordinal":135925,"en":"Are my own stock, allotted by fate."},{"id":"semetey-1-2013:p0770:b004:l006","ordinal":135926,"en":"When were they ever Manas's livestock?"},{"id":"semetey-1-2013:p0770:b004:l007","ordinal":135927,"en":"That guileless Manas—"},{"id":"semetey-1-2013:p0770:b004:l008","ordinal":135928,"en":"How much livestock did he ever have?"},{"id":"semetey-1-2013:p0770:b004:l009","ordinal":135929,"en":"This damned orphan—"},{"id":"semetey-1-2013:p0770:b004:l010","ordinal":135930,"en":"Have you seen what he has done?"},{"id":"semetey-1-2013:p0770:b004:l011","ordinal":135931,"en":"Making a claim on a falsehood,"},{"id":"semetey-1-2013:p0770:b004:l012","ordinal":135932,"en":"Have you seen what he is doing?"},{"id":"semetey-1-2013:p0770:b004:l013","ordinal":135933,"en":"And tell many tales that divide the people."},{"id":"semetey-1-2013:p0770:b004:l014","ordinal":135934,"en":"He says, ‘This much is mine.’"},{"id":"semetey-1-2013:p0770:b004:l015","ordinal":135935,"en":"He plots with brazen malice,"},{"id":"semetey-1-2013:p0770:b004:l016","ordinal":135936,"en":"And makes false claims against me."}]
