[{"id":"semetey-2-2013:p1356:b003:l005","ordinal":290049,"en":"Bringing misery upon his poor soul,"},{"id":"semetey-2-2013:p1356:b003:l006","ordinal":290050,"en":"And committing violence."},{"id":"semetey-2-2013:p1356:b003:l007","ordinal":290051,"en":"As twilight came and the sun set,"},{"id":"semetey-2-2013:p1356:b003:l008","ordinal":290052,"en":"The Zhediger forced their way in."},{"id":"semetey-2-2013:p1356:b003:l009","ordinal":290053,"en":"The Zhediger entered and seized"},{"id":"semetey-2-2013:p1356:b003:l010","ordinal":290054,"en":"Aichurok's White Palace."},{"id":"semetey-2-2013:p1356:b003:l011","ordinal":290055,"en":"May God never show such a sight!"},{"id":"semetey-2-2013:p1356:b003:l012","ordinal":290056,"en":"They traveled in turmoil,"},{"id":"semetey-2-2013:p1356:b003:l013","ordinal":290057,"en":"The army massed thick as fog,"},{"id":"semetey-2-2013:p1356:b003:l014","ordinal":290058,"en":"And the Zhediger entered in ranks."},{"id":"semetey-2-2013:p1356:b003:l015","ordinal":290059,"en":"Gold, silver, countless coins—"},{"id":"semetey-2-2013:p1356:b003:l016","ordinal":290060,"en":"The Zhediger plundered much."},{"id":"semetey-2-2013:p1356:b003:l017","ordinal":290061,"en":"Akzholtoi, now alone,"},{"id":"semetey-2-2013:p1356:b003:l018","ordinal":290062,"en":"Grieved in sorrow,"},{"id":"semetey-2-2013:p1356:b003:l019","ordinal":290063,"en":"Having lost the gatekeepers"},{"id":"semetey-2-2013:p1356:b003:l020","ordinal":290064,"en":"Who had served as his support."},{"id":"semetey-2-2013:p1356:b003:l021","ordinal":290065,"en":"His elders were soaked in blood;"},{"id":"semetey-2-2013:p1356:b003:l022","ordinal":290066,"en":"His guards and lions,"},{"id":"semetey-2-2013:p1356:b003:l023","ordinal":290067,"en":"The heroes bound at his waist,"},{"id":"semetey-2-2013:p1356:b003:l024","ordinal":290068,"en":"Were taken by the Zhediger."},{"id":"semetey-2-2013:p1356:b003:l025","ordinal":290069,"en":"Though shot, no bullet pierced"},{"id":"semetey-2-2013:p1356:b003:l026","ordinal":290070,"en":"The accursed Kanchoro."},{"id":"semetey-2-2013:p1356:b003:l027","ordinal":290071,"en":"As though he had prospered,"},{"id":"semetey-2-2013:p1356:b003:l028","ordinal":290072,"en":"He had drawn on and worn Ak-Olpok,"},{"id":"semetey-2-2013:p1356:b003:l029","ordinal":290073,"en":"With golden collar, copper sleeves,"},{"id":"semetey-2-2013:p1356:b003:l030","ordinal":290074,"en":"Silken weave and lark-eye rings."},{"id":"semetey-2-2013:p1356:b003:l031","ordinal":290075,"en":"When merely brandished, it set things ablaze;"},{"id":"semetey-2-2013:p1356:b003:l032","ordinal":290076,"en":"When truly fired, it blasted its target."},{"id":"semetey-2-2013:p1356:b003:l033","ordinal":290077,"en":"When he slung it on, it was"},{"id":"semetey-2-2013:p1356:b003:l034","ordinal":290078,"en":"The answer to every turmoil;"},{"id":"semetey-2-2013:p1356:b003:l035","ordinal":290079,"en":"When the wretch aimed it,"},{"id":"semetey-2-2013:p1356:b003:l036","ordinal":290080,"en":"It became the companion of his flylike soul."},{"id":"semetey-2-2013:p1356:b003:l037","ordinal":290081,"en":"Akkelte, refused to any who asked,"},{"id":"semetey-2-2013:p1356:b003:l038","ordinal":290082,"en":"Was in Khan Kanchoro's hands."},{"id":"semetey-2-2013:p1356:b003:l039","ordinal":290083,"en":"Seeing this misery,"},{"id":"semetey-2-2013:p1356:b004:l001","ordinal":290084,"en":"Finding no pass to cross,"},{"id":"semetey-2-2013:p1356:b004:l002","ordinal":290085,"en":"Finding no lion to support him,"},{"id":"semetey-2-2013:p1356:b004:l003","ordinal":290086,"en":"Despairing of his precious life,"},{"id":"semetey-2-2013:p1356:b004:l004","ordinal":290087,"en":"He held the short gun Chortkelte."},{"id":"semetey-2-2013:p1356:b004:l005","ordinal":290088,"en":"Gripping Chortkelte, he ran."},{"id":"semetey-2-2013:p1356:b004:l006","ordinal":290089,"en":"As twilight came and the sun set,"},{"id":"semetey-2-2013:p1356:b004:l007","ordinal":290090,"en":"While the people lay utterly still,"},{"id":"semetey-2-2013:p1356:b004:l008","ordinal":290091,"en":"Before stars divided the sky,"},{"id":"semetey-2-2013:p1356:b004:l009","ordinal":290092,"en":"His eyes dimmed and night fell;"},{"id":"semetey-2-2013:p1356:b004:l010","ordinal":290093,"en":"Nothing at all could be seen."},{"id":"semetey-2-2013:p1356:b004:l011","ordinal":290094,"en":"Then Akzholtoi,"},{"id":"semetey-2-2013:p1356:b004:l012","ordinal":290095,"en":"Toward Kaiypchy Pass,"},{"id":"semetey-2-2013:p1356:b004:l013","ordinal":290096,"en":"Toward the ridge of Kanzhailak,"},{"id":"semetey-2-2013:p1356:b004:l014","ordinal":290097,"en":"Gathering strength in his flylike soul,"},{"id":"semetey-2-2013:p1356:b004:l015","ordinal":290098,"en":"Scattered all his worldly hopes."},{"id":"semetey-2-2013:p1356:b004:l016","ordinal":290099,"en":"One gray wolf, unable to endure,"},{"id":"semetey-2-2013:p1356:b004:l017","ordinal":290100,"en":"Fled toward Kaiypchy."},{"id":"semetey-2-2013:p1356:b004:l018","ordinal":290101,"en":"Before the Zhediger could seize him,"},{"id":"semetey-2-2013:p1356:b004:l019","ordinal":290102,"en":"Before they could torment him without mercy,"},{"id":"semetey-2-2013:p1356:b004:l020","ordinal":290103,"en":"Before they cut off his head like a sheep's,"},{"id":"semetey-2-2013:p1356:b004:l021","ordinal":290104,"en":"Before they brought him utterly to ruin,"},{"id":"semetey-2-2013:p1356:b004:l022","ordinal":290105,"en":"Before their flood trampled him,"},{"id":"semetey-2-2013:p1356:b004:l023","ordinal":290106,"en":"He, the son of the smith Bolokbai,"},{"id":"semetey-2-2013:p1356:b004:l024","ordinal":290107,"en":"That extraordinary weather-working servant,"},{"id":"semetey-2-2013:p1356:b004:l025","ordinal":290108,"en":"Made rain fall upon the uplands"},{"id":"semetey-2-2013:p1356:b004:l026","ordinal":290109,"en":"And drew fog over the foothills."},{"id":"semetey-2-2013:p1356:b004:l027","ordinal":290110,"en":"The weather broke and the sun was veiled."},{"id":"semetey-2-2013:p1356:b004:l028","ordinal":290111,"en":"Running on foot day and night,"},{"id":"semetey-2-2013:p1356:b004:l029","ordinal":290112,"en":"Toward Kaiypchy's Kara-Too,"},{"id":"semetey-2-2013:p1356:b004:l030","ordinal":290113,"en":"Toward the pass between twin peaks,"},{"id":"semetey-2-2013:p1356:b004:l031","ordinal":290114,"en":"The route by which his father Bolokbai escaped the foe,"},{"id":"semetey-2-2013:p1356:b004:l032","ordinal":290115,"en":"The ridge used for flight,"},{"id":"semetey-2-2013:p1356:b004:l033","ordinal":290116,"en":"While the weather broke and the sun was veiled,"},{"id":"semetey-2-2013:p1356:b004:l034","ordinal":290117,"en":"Akzholtoi fled and escaped."},{"id":"semetey-2-2013:p1356:b004:l035","ordinal":290118,"en":"Akzholtoi became invisible;"},{"id":"semetey-2-2013:p1356:b004:l036","ordinal":290119,"en":"No human being approached him."},{"id":"semetey-2-2013:p1356:b004:l037","ordinal":290120,"en":"From Kanchoro's wrath,"},{"id":"semetey-2-2013:p1356:b004:l038","ordinal":290121,"en":"Akzholtoi vanished."},{"id":"semetey-2-2013:p1356:b004:l039","ordinal":290122,"en":"He had been khan of the treasury gate,"},{"id":"semetey-2-2013:p1357:b003:l001","ordinal":290123,"en":"And his honor had been great."},{"id":"semetey-2-2013:p1357:b003:l002","ordinal":290124,"en":"Leading his poor soul away,"},{"id":"semetey-2-2013:p1357:b003:l003","ordinal":290125,"en":"He set out toward Kaiypchy-Too,"},{"id":"semetey-2-2013:p1357:b003:l004","ordinal":290126,"en":"Leaving sixty women and mourning sisters-in-law,"},{"id":"semetey-2-2013:p1357:b003:l005","ordinal":290127,"en":"Leaving the camp desolate."},{"id":"semetey-2-2013:p1357:b003:l006","ordinal":290128,"en":"They had encircled the palace,"},{"id":"semetey-2-2013:p1357:b003:l007","ordinal":290129,"en":"And when the bright dawn advanced,"},{"id":"semetey-2-2013:p1357:b003:l008","ordinal":290130,"en":"When stars fled across the sky"},{"id":"semetey-2-2013:p1357:b003:l009","ordinal":290131,"en":"And moved toward the qibla,"},{"id":"semetey-2-2013:p1357:b003:l010","ordinal":290132,"en":"As the first light whitened,"},{"id":"semetey-2-2013:p1357:b003:l011","ordinal":290133,"en":"When the cold wind before sunrise"},{"id":"semetey-2-2013:p1357:b003:l012","ordinal":290134,"en":"Struck and made the bones ache,"},{"id":"semetey-2-2013:p1357:b003:l013","ordinal":290135,"en":"As the dawn's light appeared,"},{"id":"semetey-2-2013:p1357:b003:l014","ordinal":290136,"en":"The stars fled across the sky"},{"id":"semetey-2-2013:p1357:b003:l015","ordinal":290137,"en":"And withdrew toward the qibla."},{"id":"semetey-2-2013:p1357:b003:l016","ordinal":290138,"en":"The haze that blinded the eye"},{"id":"semetey-2-2013:p1357:b003:l017","ordinal":290139,"en":"Lifted upward into the heavens."},{"id":"semetey-2-2013:p1357:b003:l018","ordinal":290140,"en":"The earth seemed to split as dawn broke;"},{"id":"semetey-2-2013:p1357:b003:l019","ordinal":290141,"en":"The separate peaks of Orkoi Mountain"},{"id":"semetey-2-2013:p1357:b003:l020","ordinal":290142,"en":"Became clearly visible."},{"id":"semetey-2-2013:p1357:b003:l021","ordinal":290143,"en":"When the earth opened to the day,"},{"id":"semetey-2-2013:p1357:b003:l022","ordinal":290144,"en":"Girding their waists securely,"},{"id":"semetey-2-2013:p1357:b003:l023","ordinal":290145,"en":"They raised a roar that split the earth."},{"id":"semetey-2-2013:p1357:b003:l024","ordinal":290146,"en":"If you wish to hear that roar:"},{"id":"semetey-2-2013:p1357:b003:l025","ordinal":290147,"en":"They shouted, \"Kanchoro!\""},{"id":"semetey-2-2013:p1357:b003:l026","ordinal":290148,"en":"And the courageous lions"},{"id":"semetey-2-2013:p1357:b003:l027","ordinal":290149,"en":"Drove the Zhediger in."},{"id":"semetey-2-2013:p1357:b003:l028","ordinal":290150,"en":"Upon the sixty sisters-in-law and mourning women,"},{"id":"semetey-2-2013:p1357:b003:l029","ordinal":290151,"en":"They attacked all together;"},{"id":"semetey-2-2013:p1357:b003:l030","ordinal":290152,"en":"The Zhediger flooded in."},{"id":"semetey-2-2013:p1357:b003:l031","ordinal":290153,"en":"That multitude of Zhediger"},{"id":"semetey-2-2013:p1357:b003:l032","ordinal":290154,"en":"Cut down the plane trees,"},{"id":"semetey-2-2013:p1357:b003:l033","ordinal":290155,"en":"Pushed over the walls,"},{"id":"semetey-2-2013:p1357:b003:l034","ordinal":290156,"en":"Cut down the willows,"},{"id":"semetey-2-2013:p1357:b003:l035","ordinal":290157,"en":"And demolished every building."},{"id":"semetey-2-2013:p1357:b003:l036","ordinal":290158,"en":"They turned the gateway bloody,"},{"id":"semetey-2-2013:p1357:b003:l037","ordinal":290159,"en":"Made the brave renowned,"},{"id":"semetey-2-2013:p1357:b003:l038","ordinal":290160,"en":"Made Kanchoro khan"},{"id":"semetey-2-2013:p1357:b003:l039","ordinal":290161,"en":"Over the corrupted multitude,"},{"id":"semetey-2-2013:p1357:b004:l001","ordinal":290162,"en":"And the Zhediger flooded in."},{"id":"semetey-2-2013:p1357:b004:l002","ordinal":290163,"en":"They slaughtered and destroyed the heroes,"},{"id":"semetey-2-2013:p1357:b004:l003","ordinal":290164,"en":"Smashed the doors,"},{"id":"semetey-2-2013:p1357:b004:l004","ordinal":290165,"en":"And made the women scream;"},{"id":"semetey-2-2013:p1357:b004:l005","ordinal":290166,"en":"The Zhediger trampled their way inside."},{"id":"semetey-2-2013:p1357:b004:l006","ordinal":290167,"en":"The treasury that sustained the world—"},{"id":"semetey-2-2013:p1357:b004:l007","ordinal":290168,"en":"They opened its doors."},{"id":"semetey-2-2013:p1357:b004:l008","ordinal":290169,"en":"Refined gold and white silver,"},{"id":"semetey-2-2013:p1357:b004:l009","ordinal":290170,"en":"All the great treasures,"},{"id":"semetey-2-2013:p1357:b004:l010","ordinal":290171,"en":"The Zhediger took as spoil"},{"id":"semetey-2-2013:p1357:b004:l011","ordinal":290172,"en":"And scattered breast-deep."},{"id":"semetey-2-2013:p1357:b004:l012","ordinal":290173,"en":"They widowed those with husbands,"},{"id":"semetey-2-2013:p1357:b004:l013","ordinal":290174,"en":"Beat silk into raw wool,"},{"id":"semetey-2-2013:p1357:b004:l014","ordinal":290175,"en":"And seized the noble brides and Aksakal's women,"},{"id":"semetey-2-2013:p1357:b004:l015","ordinal":290176,"en":"Plundering and enslaving them."},{"id":"semetey-2-2013:p1357:b004:l016","ordinal":290177,"en":"They raided and seized the palace,"},{"id":"semetey-2-2013:p1357:b004:l017","ordinal":290178,"en":"Pulled out the fortress posts,"},{"id":"semetey-2-2013:p1357:b004:l018","ordinal":290179,"en":"Destroyed the stone city,"},{"id":"semetey-2-2013:p1357:b004:l019","ordinal":290180,"en":"And plundered it completely."},{"id":"semetey-2-2013:p1357:b004:l020","ordinal":290181,"en":"They scorched the earthen fort"},{"id":"semetey-2-2013:p1357:b004:l021","ordinal":290182,"en":"And sacked it utterly."},{"id":"semetey-2-2013:p1357:b004:l022","ordinal":290183,"en":"They wrought every conflict they knew,"},{"id":"semetey-2-2013:p1357:b004:l023","ordinal":290184,"en":"Plundered the treasury and settled in ease."},{"id":"semetey-2-2013:p1357:b004:l024","ordinal":290185,"en":"They drove red-tailed riding camels,"},{"id":"semetey-2-2013:p1357:b004:l025","ordinal":290186,"en":"Braiding their flowing tails;"},{"id":"semetey-2-2013:p1357:b004:l026","ordinal":290187,"en":"Gold in pitchers and coins like sand,"},{"id":"semetey-2-2013:p1357:b004:l027","ordinal":290188,"en":"They plundered and divided with approval."},{"id":"semetey-2-2013:p1357:b004:l028","ordinal":290189,"en":"Crimson cloth with golden weave—"},{"id":"semetey-2-2013:p1357:b004:l029","ordinal":290190,"en":"They divided all of it."},{"id":"semetey-2-2013:p1357:b004:l030","ordinal":290191,"en":"All the Kyrgyz were surrounded;"},{"id":"semetey-2-2013:p1357:b004:l031","ordinal":290192,"en":"Girls were seized and plundered as spoil."},{"id":"semetey-2-2013:p1357:b004:l032","ordinal":290193,"en":"The Zhediger, glutted with booty,"},{"id":"semetey-2-2013:p1357:b004:l033","ordinal":290194,"en":"Shouted in wild confusion,"},{"id":"semetey-2-2013:p1357:b004:l034","ordinal":290195,"en":"Saying, \"We have won great spoil!\""},{"id":"semetey-2-2013:p1357:b004:l035","ordinal":290196,"en":"And raising the cry, \"Kiyaz!\""},{"id":"semetey-2-2013:p1357:b004:l036","ordinal":290197,"en":"They pulled out the palace posts,"},{"id":"semetey-2-2013:p1357:b004:l037","ordinal":290198,"en":"Plundered everything together,"},{"id":"semetey-2-2013:p1357:b004:l038","ordinal":290199,"en":"And wrought horror without hardship."},{"id":"semetey-2-2013:p1357:b004:l039","ordinal":290200,"en":"The thundering Zhediger"},{"id":"semetey-2-2013:p1358:b003:l001","ordinal":290201,"en":"They plundered everything and settled in ease."},{"id":"semetey-2-2013:p1358:b003:l002","ordinal":290202,"en":"The bloodthirsty khan’s treasury—"},{"id":"semetey-2-2013:p1358:b003:l003","ordinal":290203,"en":"They could not finish dividing it."},{"id":"semetey-2-2013:p1358:b003:l004","ordinal":290204,"en":"Gold and silver"},{"id":"semetey-2-2013:p1358:b003:l005","ordinal":290205,"en":"They could not load it all."},{"id":"semetey-2-2013:p1358:b003:l006","ordinal":290206,"en":"Noble brides and beautiful girls"},{"id":"semetey-2-2013:p1358:b003:l007","ordinal":290207,"en":"They could not finish carrying off."},{"id":"semetey-2-2013:p1358:b003:l008","ordinal":290208,"en":"The great host of the Kara-Zhediger,"},{"id":"semetey-2-2013:p1358:b003:l009","ordinal":290209,"en":"With Khan Kanchoro grown rich,"},{"id":"semetey-2-2013:p1358:b003:l010","ordinal":290210,"en":"Glutted with all the world’s wealth,"},{"id":"semetey-2-2013:p1358:b003:l011","ordinal":290211,"en":"Made for humankind until Judgment Day"},{"id":"semetey-2-2013:p1358:b003:l012","ordinal":290212,"en":"An unforgettable example,"},{"id":"semetey-2-2013:p1358:b003:l013","ordinal":290213,"en":"Flooding in and seizing the land,"},{"id":"semetey-2-2013:p1358:b003:l014","ordinal":290214,"en":"Slaughtering and destroying many,"},{"id":"semetey-2-2013:p1358:b003:l015","ordinal":290215,"en":"They overcame the infidels guarding the gate,"},{"id":"semetey-2-2013:p1358:b003:l016","ordinal":290216,"en":"And entered to plunder the women in the palace."},{"id":"semetey-2-2013:p1358:b003:l017","ordinal":290217,"en":"They pulled out the roof poles and laid them flat,"},{"id":"semetey-2-2013:p1358:b003:l018","ordinal":290218,"en":"They knocked down the main pillars,"},{"id":"semetey-2-2013:p1358:b003:l019","ordinal":290219,"en":"And Aychyrok’s White Palace"},{"id":"semetey-2-2013:p1358:b003:l020","ordinal":290220,"en":"Was what brave Kyiaz meant to take."},{"id":"semetey-2-2013:p1358:b003:l021","ordinal":290221,"en":"When he came and surrounded it,"},{"id":"semetey-2-2013:p1358:b003:l022","ordinal":290222,"en":"When he tried to force Chyrok,"},{"id":"semetey-2-2013:p1358:b003:l023","ordinal":290223,"en":"Inside the palace Aychyrok"},{"id":"semetey-2-2013:p1358:b003:l024","ordinal":290224,"en":"Sat there in proud composure,"},{"id":"semetey-2-2013:p1358:b003:l025","ordinal":290225,"en":"Too weary even to speak."},{"id":"semetey-2-2013:p1358:b003:l026","ordinal":290226,"en":"This woman Aychyrok,"},{"id":"semetey-2-2013:p1358:b003:l027","ordinal":290227,"en":"This radiant beauty,"},{"id":"semetey-2-2013:p1358:b003:l028","ordinal":290228,"en":"Her mail coat shimmered,"},{"id":"semetey-2-2013:p1358:b003:l029","ordinal":290229,"en":"She shone like the rising moon;"},{"id":"semetey-2-2013:p1358:b003:l030","ordinal":290230,"en":"The hapless fairy maiden’s"},{"id":"semetey-2-2013:p1358:b003:l031","ordinal":290231,"en":"Manner was like this."},{"id":"semetey-2-2013:p1358:b003:l032","ordinal":290232,"en":"Pearl and ruby buttons,"},{"id":"semetey-2-2013:p1358:b003:l033","ordinal":290233,"en":"Each as large as a fist, lay on her breast;"},{"id":"semetey-2-2013:p1358:b003:l034","ordinal":290234,"en":"She spoke sadly, yet still shone."},{"id":"semetey-2-2013:p1358:b003:l035","ordinal":290235,"en":"Her sixty-keyed amulet"},{"id":"semetey-2-2013:p1358:b003:l036","ordinal":290236,"en":"Hung, it seemed, upon the breast"},{"id":"semetey-2-2013:p1358:b003:l037","ordinal":290237,"en":"Of that ill-fated celestial maiden, jingling."},{"id":"semetey-2-2013:p1358:b003:l038","ordinal":290238,"en":"With a thimble-small mouth and camel-calf eyes,"},{"id":"semetey-2-2013:p1358:b003:l039","ordinal":290239,"en":"A sheath-slender waist and a snow-white face—"},{"id":"semetey-2-2013:p1358:b004:l001","ordinal":290240,"en":"Look well upon her marks of beauty."},{"id":"semetey-2-2013:p1358:b004:l002","ordinal":290241,"en":"This woman Aychyrok,"},{"id":"semetey-2-2013:p1358:b004:l003","ordinal":290242,"en":"This graceful beauty,"},{"id":"semetey-2-2013:p1358:b004:l004","ordinal":290243,"en":"Had a gentle bearing and honeyed speech;"},{"id":"semetey-2-2013:p1358:b004:l005","ordinal":290244,"en":"No such soul is born among humankind."},{"id":"semetey-2-2013:p1358:b004:l006","ordinal":290245,"en":"She swayed like a poppy,"},{"id":"semetey-2-2013:p1358:b004:l007","ordinal":290246,"en":"In a fitted vest and silk gown."},{"id":"semetey-2-2013:p1358:b004:l008","ordinal":290247,"en":"The pampered, hapless woman’s"},{"id":"semetey-2-2013:p1358:b004:l009","ordinal":290248,"en":"Hem streamed out like a spring."},{"id":"semetey-2-2013:p1358:b004:l010","ordinal":290249,"en":"When Aychyrok looked straight at him,"},{"id":"semetey-2-2013:p1358:b004:l011","ordinal":290250,"en":"To brave Kyiaz’s eyes"},{"id":"semetey-2-2013:p1358:b004:l012","ordinal":290251,"en":"She seemed like the rising moon."},{"id":"semetey-2-2013:p1358:b004:l013","ordinal":290252,"en":"When he saw Aychyrok,"},{"id":"semetey-2-2013:p1358:b004:l014","ordinal":290253,"en":"Brave Kyiaz, son of Agysh,"},{"id":"semetey-2-2013:p1358:b004:l015","ordinal":290254,"en":"Nearly lost his reason,"},{"id":"semetey-2-2013:p1358:b004:l016","ordinal":290255,"en":"And stared, consumed with grief."},{"id":"semetey-2-2013:p1358:b004:l017","ordinal":290256,"en":"The hapless woman, faintly smiling,"},{"id":"semetey-2-2013:p1358:b004:l018","ordinal":290257,"en":"Had a face wounded though bright as the sun,"},{"id":"semetey-2-2013:p1358:b004:l019","ordinal":290258,"en":"And sorrow shadowed her smiling head."},{"id":"semetey-2-2013:p1358:b004:l020","ordinal":290259,"en":"Her dear hair, long as meadow grass,"},{"id":"semetey-2-2013:p1358:b004:l021","ordinal":290260,"en":"Was spread across her breast."},{"id":"semetey-2-2013:p1358:b004:l022","ordinal":290261,"en":"Into her white face, smooth as a mirror,"},{"id":"semetey-2-2013:p1358:b004:l023","ordinal":290262,"en":"Five fingernails had dug deep."},{"id":"semetey-2-2013:p1358:b004:l024","ordinal":290263,"en":"When brave Kyiaz came and surrounded her,"},{"id":"semetey-2-2013:p1358:b004:l025","ordinal":290264,"en":"Aychyrok despaired of life,"},{"id":"semetey-2-2013:p1358:b004:l026","ordinal":290265,"en":"Her color drained and her face went pale."},{"id":"semetey-2-2013:p1358:b004:l027","ordinal":290266,"en":"Blood flowing from both cheeks"},{"id":"semetey-2-2013:p1358:b004:l028","ordinal":290267,"en":"Poured down over her breast."},{"id":"semetey-2-2013:p1358:b004:l029","ordinal":290268,"en":"Then Chyrok formed a plan:"},{"id":"semetey-2-2013:p1358:b004:l030","ordinal":290269,"en":"If Kyiaz came close,"},{"id":"semetey-2-2013:p1358:b004:l031","ordinal":290270,"en":"“I will draw Zulpukor from its sheath"},{"id":"semetey-2-2013:p1358:b004:l032","ordinal":290271,"en":"And bring a final, crushing disaster"},{"id":"semetey-2-2013:p1358:b004:l033","ordinal":290272,"en":"Upon this rabid dog."},{"id":"semetey-2-2013:p1358:b004:l034","ordinal":290273,"en":"I will somehow find my chance;"},{"id":"semetey-2-2013:p1358:b004:l035","ordinal":290274,"en":"I will strike off this unclean slave’s head,"},{"id":"semetey-2-2013:p1358:b004:l036","ordinal":290275,"en":"And settle the calamity once and for all."},{"id":"semetey-2-2013:p1358:b004:l037","ordinal":290276,"en":"The black blood from inside him"},{"id":"semetey-2-2013:p1358:b004:l038","ordinal":290277,"en":"I will gulp down and swallow.”"},{"id":"semetey-2-2013:p1358:b004:l039","ordinal":290278,"en":"Such was her fierce and terrible wrath."},{"id":"semetey-2-2013:p1359:b003:l001","ordinal":290279,"en":"Thinking, “I will take this infidel captive."},{"id":"semetey-2-2013:p1359:b003:l002","ordinal":290280,"en":"Here inside this palace"},{"id":"semetey-2-2013:p1359:b003:l003","ordinal":290281,"en":"I will split her like a lean sheep.”"},{"id":"semetey-2-2013:p1359:b003:l004","ordinal":290282,"en":"Yesterday, while bloodthirsty Manas lived,"},{"id":"semetey-2-2013:p1359:b003:l005","ordinal":290283,"en":"It descended from heaven and came to him,"},{"id":"semetey-2-2013:p1359:b003:l006","ordinal":290284,"en":"So he might gird himself and ride against the foe:"},{"id":"semetey-2-2013:p1359:b003:l007","ordinal":290285,"en":"Zulpukor, found for valiant Khan Manas."},{"id":"semetey-2-2013:p1359:b003:l008","ordinal":290286,"en":"Zulpukor, which hews down whatever is thrust before it,"},{"id":"semetey-2-2013:p1359:b003:l009","ordinal":290287,"en":"Which, once drawn, could not be stayed,"},{"id":"semetey-2-2013:p1359:b003:l010","ordinal":290288,"en":"Which, when a man swung it as he wished,"},{"id":"semetey-2-2013:p1359:b003:l011","ordinal":290289,"en":"Never returned without drinking blood."},{"id":"semetey-2-2013:p1359:b003:l012","ordinal":290290,"en":"When eagerly drawn from its sheath,"},{"id":"semetey-2-2013:p1359:b003:l013","ordinal":290291,"en":"Its reach lengthened with every stroke;"},{"id":"semetey-2-2013:p1359:b003:l014","ordinal":290292,"en":"Its blue-green edge glowed red,"},{"id":"semetey-2-2013:p1359:b003:l015","ordinal":290293,"en":"And set the grass afire when laid upon it."},{"id":"semetey-2-2013:p1359:b003:l016","ordinal":290294,"en":"Whatever it struck was cut down at once;"},{"id":"semetey-2-2013:p1359:b003:l017","ordinal":290295,"en":"Struck against stone, it raised dust,"},{"id":"semetey-2-2013:p1359:b003:l018","ordinal":290296,"en":"Struck against man, it drew blood."},{"id":"semetey-2-2013:p1359:b003:l019","ordinal":290297,"en":"From renowned Manas of old,"},{"id":"semetey-2-2013:p1359:b003:l020","ordinal":290298,"en":"Zulpukor remained as an heirloom."},{"id":"semetey-2-2013:p1359:b003:l021","ordinal":290299,"en":"Her necklace rattling on her breast,"},{"id":"semetey-2-2013:p1359:b003:l022","ordinal":290300,"en":"The wretched woman, heedless of all,"},{"id":"semetey-2-2013:p1359:b003:l023","ordinal":290301,"en":"Her camel-calf eyes flashing,"},{"id":"semetey-2-2013:p1359:b003:l024","ordinal":290302,"en":"Made early words become late deeds;"},{"id":"semetey-2-2013:p1359:b003:l025","ordinal":290303,"en":"To strike down brave Kyyaz,"},{"id":"semetey-2-2013:p1359:b003:l026","ordinal":290304,"en":"The renowned infidel Chürök"}]
