[{"id":"semetey-1-2013:p0233:b005:l024","ordinal":94721,"en":"Alooke had known."},{"id":"semetey-1-2013:p0233:b005:l025","ordinal":94722,"en":"Unable to find a way out,"},{"id":"semetey-1-2013:p0233:b005:l026","ordinal":94723,"en":"He had fallen into panic."},{"id":"semetey-1-2013:p0233:b005:l027","ordinal":94724,"en":"Upon some six hundred mules"},{"id":"semetey-1-2013:p0233:b005:l028","ordinal":94725,"en":"He loaded his gold"},{"id":"semetey-1-2013:p0233:b005:l029","ordinal":94726,"en":"And Alooke fled."},{"id":"semetey-1-2013:p0233:b005:l030","ordinal":94727,"en":"Taking all his kaldai officials,"},{"id":"semetey-1-2013:p0233:b005:l031","ordinal":94728,"en":"Hastening toward Beijing,"},{"id":"semetey-1-2013:p0233:b005:l032","ordinal":94729,"en":"He crossed broad Kashgar,"},{"id":"semetey-1-2013:p0233:b005:l033","ordinal":94730,"en":"Passed through great Turpan."},{"id":"semetey-1-2013:p0233:b005:l034","ordinal":94731,"en":"In Ak-Chiy of Aksy,"},{"id":"semetey-1-2013:p0233:b005:l035","ordinal":94732,"en":"At the spur where the mountains ended,"},{"id":"semetey-1-2013:p0233:b005:l036","ordinal":94733,"en":"Upon the rounded headland,"},{"id":"semetey-1-2013:p0233:b005:l037","ordinal":94734,"en":"Beside the flowing water,"},{"id":"semetey-1-2013:p0233:b005:l038","ordinal":94735,"en":"In the valley of Kum-Aryk,"},{"id":"semetey-1-2013:p0233:b005:l039","ordinal":94736,"en":"When he pitched his golden tent,"},{"id":"semetey-1-2013:p0234:b003:l001","ordinal":94737,"en":"When he rested on his journey,"},{"id":"semetey-1-2013:p0234:b003:l002","ordinal":94738,"en":"With coral plumes and precious beads,"},{"id":"semetey-1-2013:p0234:b003:l003","ordinal":94739,"en":"His lungtung headman stood watch."},{"id":"semetey-1-2013:p0234:b003:l004","ordinal":94740,"en":"Making his sentry loom conspicuously,"},{"id":"semetey-1-2013:p0234:b003:l005","ordinal":94741,"en":"He posted his kaldai as guard."},{"id":"semetey-1-2013:p0234:b003:l006","ordinal":94742,"en":"The finest of his executioners,"},{"id":"semetey-1-2013:p0234:b003:l007","ordinal":94743,"en":"Seven champions, stood there."},{"id":"semetey-1-2013:p0234:b003:l008","ordinal":94744,"en":"When Manas Khan entered Samarkand,"},{"id":"semetey-1-2013:p0234:b003:l009","ordinal":94745,"en":"There was no khan like Alooke there."},{"id":"semetey-1-2013:p0234:b003:l010","ordinal":94746,"en":"He slaughtered the remaining Chinese;"},{"id":"semetey-1-2013:p0234:b003:l011","ordinal":94747,"en":"Manas Khan gave a stern command."},{"id":"semetey-1-2013:p0234:b003:l012","ordinal":94748,"en":"Then out of fear,"},{"id":"semetey-1-2013:p0234:b003:l013","ordinal":94749,"en":"The humbled man turned back."},{"id":"semetey-1-2013:p0234:b003:l014","ordinal":94750,"en":"Aikozho of Samarkand"},{"id":"semetey-1-2013:p0234:b003:l015","ordinal":94751,"en":"Said, 'His trail went this way,'"},{"id":"semetey-1-2013:p0234:b003:l016","ordinal":94752,"en":"And told him the direction."},{"id":"semetey-1-2013:p0234:b003:l017","ordinal":94753,"en":"Following the tracks in pursuit,"},{"id":"semetey-1-2013:p0234:b003:l018","ordinal":94754,"en":"He crossed broad Kashgar."},{"id":"semetey-1-2013:p0234:b003:l019","ordinal":94755,"en":"Through Turpan and Zhaman-Suu,"},{"id":"semetey-1-2013:p0234:b003:l020","ordinal":94756,"en":"Your warrior traveled days and nights."},{"id":"semetey-1-2013:p0234:b003:l021","ordinal":94757,"en":"Tracking every fading footprint,"},{"id":"semetey-1-2013:p0234:b003:l022","ordinal":94758,"en":"He pursued him till he paled."},{"id":"semetey-1-2013:p0234:b003:l023","ordinal":94759,"en":"Tracking every bleached footprint,"},{"id":"semetey-1-2013:p0234:b003:l024","ordinal":94760,"en":"He pursued him till he blanched."},{"id":"semetey-1-2013:p0234:b003:l025","ordinal":94761,"en":"In the valley of Kum-Aryk,"},{"id":"semetey-1-2013:p0234:b003:l026","ordinal":94762,"en":"Upon the riverbank,"},{"id":"semetey-1-2013:p0234:b003:l027","ordinal":94763,"en":"Alooke and the warrior Manas"},{"id":"semetey-1-2013:p0234:b003:l028","ordinal":94764,"en":"Fought a merciless battle."},{"id":"semetey-1-2013:p0234:b003:l029","ordinal":94765,"en":"They exchanged fire for six days,"},{"id":"semetey-1-2013:p0234:b003:l030","ordinal":94766,"en":"Neither could overcome the other."},{"id":"semetey-1-2013:p0234:b003:l031","ordinal":94767,"en":"For six more days the leopard"},{"id":"semetey-1-2013:p0234:b003:l032","ordinal":94768,"en":"Stood dueling with spears,"},{"id":"semetey-1-2013:p0234:b003:l033","ordinal":94769,"en":"Jousting with their spears,"},{"id":"semetey-1-2013:p0234:b003:l034","ordinal":94770,"en":"The spear points bending."},{"id":"semetey-1-2013:p0234:b003:l035","ordinal":94771,"en":"Upon the slope of Yrgaity,"},{"id":"semetey-1-2013:p0234:b003:l036","ordinal":94772,"en":"Swaying in their saddles,"},{"id":"semetey-1-2013:p0234:b003:l037","ordinal":94773,"en":"Fighting hard in earnest,"},{"id":"semetey-1-2013:p0234:b003:l038","ordinal":94774,"en":"When the dawn shone clear,"},{"id":"semetey-1-2013:p0234:b003:l039","ordinal":94775,"en":"When light fell upon the earth,"},{"id":"semetey-1-2013:p0234:b004:l001","ordinal":94776,"en":"Fortunate Manas, the young lion,"},{"id":"semetey-1-2013:p0234:b004:l002","ordinal":94777,"en":"The swaggering Chinese-Manchu"},{"id":"semetey-1-2013:p0234:b004:l003","ordinal":94778,"en":"That noble warrior brought down."},{"id":"semetey-1-2013:p0234:b004:l004","ordinal":94779,"en":"He plundered his valuables,"},{"id":"semetey-1-2013:p0234:b004:l005","ordinal":94780,"en":"Wrought thorough devastation."},{"id":"semetey-1-2013:p0234:b004:l006","ordinal":94781,"en":"Some six hundred of his champions,"},{"id":"semetey-1-2013:p0234:b004:l007","ordinal":94782,"en":"With Alooke at their head,"},{"id":"semetey-1-2013:p0234:b004:l008","ordinal":94783,"en":"Your fierce lion Manas"},{"id":"semetey-1-2013:p0234:b004:l009","ordinal":94784,"en":"Slaughtered utterly."},{"id":"semetey-1-2013:p0234:b004:l010","ordinal":94785,"en":"The countless livestock gathered as customs dues,"},{"id":"semetey-1-2013:p0234:b004:l011","ordinal":94786,"en":"The countless gold amassed in the treasury,"},{"id":"semetey-1-2013:p0234:b004:l012","ordinal":94787,"en":"He brought back again."},{"id":"semetey-1-2013:p0234:b004:l013","ordinal":94788,"en":"To the needy Muslim faithful"},{"id":"semetey-1-2013:p0234:b004:l014","ordinal":94789,"en":"He distributed six of them."},{"id":"semetey-1-2013:p0234:b004:l015","ordinal":94790,"en":"Then the Muslims,"},{"id":"semetey-1-2013:p0234:b004:l016","ordinal":94791,"en":"Through the support of Manas,"},{"id":"semetey-1-2013:p0234:b004:l017","ordinal":94792,"en":"Made their living in this way."},{"id":"semetey-1-2013:p0234:b004:l018","ordinal":94793,"en":"From the desert of Mediyan,"},{"id":"semetey-1-2013:p0234:b004:l019","ordinal":94794,"en":"Beyond Andizhan,"},{"id":"semetey-1-2013:p0234:b004:l020","ordinal":94795,"en":"From the ridge of Ak-Talaa,"},{"id":"semetey-1-2013:p0234:b004:l021","ordinal":94796,"en":"Where a company of saints had gathered,"},{"id":"semetey-1-2013:p0234:b004:l022","ordinal":94797,"en":"From the place of their assembly,"},{"id":"semetey-1-2013:p0234:b004:l023","ordinal":94798,"en":"He met a certain man—"},{"id":"semetey-1-2013:p0234:b004:l024","ordinal":94799,"en":"One man, yet worth a thousand men—"},{"id":"semetey-1-2013:p0234:b004:l025","ordinal":94800,"en":"Wearing a blue-gray lynx-fur cap,"},{"id":"semetey-1-2013:p0234:b004:l026","ordinal":94801,"en":"Brandishing a mottled shield,"},{"id":"semetey-1-2013:p0234:b004:l027","ordinal":94802,"en":"His head arrayed in lavish gold,"},{"id":"semetey-1-2013:p0234:b004:l028","ordinal":94803,"en":"His feet supported by white silver."},{"id":"semetey-1-2013:p0234:b004:l029","ordinal":94804,"en":"It was the lion Bakai,"},{"id":"semetey-1-2013:p0234:b004:l030","ordinal":94805,"en":"The peerless one among the saints,"},{"id":"semetey-1-2013:p0234:b004:l031","ordinal":94806,"en":"Who then encountered Manas."},{"id":"semetey-1-2013:p0234:b004:l032","ordinal":94807,"en":"'I shall be a pale star in the sky."},{"id":"semetey-1-2013:p0234:b004:l033","ordinal":94808,"en":"With you, Manas Khan,"},{"id":"semetey-1-2013:p0234:b004:l034","ordinal":94809,"en":"I shall be friends unto the next world."},{"id":"semetey-1-2013:p0234:b004:l035","ordinal":94810,"en":"You shall lay your troubles upon me,"},{"id":"semetey-1-2013:p0234:b004:l036","ordinal":94811,"en":"You shall heed my words."},{"id":"semetey-1-2013:p0234:b004:l037","ordinal":94812,"en":"I shall plant you and make a garden,"},{"id":"semetey-1-2013:p0234:b004:l038","ordinal":94813,"en":"I shall build you and make a house."},{"id":"semetey-1-2013:p0234:b004:l039","ordinal":94814,"en":"May no untimely misfortune come."},{"id":"semetey-1-2013:p0235:b003:l001","ordinal":94815,"en":"Over the eighteen thousand worlds,"},{"id":"semetey-1-2013:p0235:b003:l002","ordinal":94816,"en":"I shall lead you and make you khan."},{"id":"semetey-1-2013:p0235:b003:l003","ordinal":94817,"en":"If we clash with the other side,"},{"id":"semetey-1-2013:p0235:b003:l004","ordinal":94818,"en":"If we exchange fire, there are mighty men."},{"id":"semetey-1-2013:p0235:b003:l005","ordinal":94819,"en":"There is something, once seized, impossible to find,"},{"id":"semetey-1-2013:p0235:b003:l006","ordinal":94820,"en":"An object no warrior can lay hands upon.'"},{"id":"semetey-1-2013:p0235:b003:l007","ordinal":94821,"en":"Beyond Andizhan,"},{"id":"semetey-1-2013:p0235:b003:l008","ordinal":94822,"en":"On this side of Amangen,"},{"id":"semetey-1-2013:p0235:b003:l009","ordinal":94823,"en":"In moon-bright Sary-Talaa,"},{"id":"semetey-1-2013:p0235:b003:l010","ordinal":94824,"en":"Sixty Russian surveyors"},{"id":"semetey-1-2013:p0235:b003:l011","ordinal":94825,"en":"Had come out, making a clamor."},{"id":"semetey-1-2013:p0235:b003:l012","ordinal":94826,"en":"Khydyr-blessed Bakai, the precious lion,"},{"id":"semetey-1-2013:p0235:b003:l013","ordinal":94827,"en":"Had seized it in a raid."},{"id":"semetey-1-2013:p0235:b003:l014","ordinal":94828,"en":"A cluster of ornaments upon its head,"},{"id":"semetey-1-2013:p0235:b003:l015","ordinal":94829,"en":"Your tiger's object was of Russian make."},{"id":"semetey-1-2013:p0235:b003:l016","ordinal":94830,"en":"The imposing, mighty Bakai"},{"id":"semetey-1-2013:p0235:b003:l017","ordinal":94831,"en":"Had come and settled in Talas,"},{"id":"semetey-1-2013:p0235:b003:l018","ordinal":94832,"en":"Become his friend till Judgment Day,"},{"id":"semetey-1-2013:p0235:b003:l019","ordinal":94833,"en":"And that very telescope"},{"id":"semetey-1-2013:p0235:b003:l020","ordinal":94834,"en":"Had presented to Manas."},{"id":"semetey-1-2013:p0235:b003:l021","ordinal":94835,"en":"Twisting and turning it seven times,"},{"id":"semetey-1-2013:p0235:b003:l022","ordinal":94836,"en":"The accomplished smith Bolokbai"},{"id":"semetey-1-2013:p0235:b003:l023","ordinal":94837,"en":"Had worked on it for seven years."},{"id":"semetey-1-2013:p0235:b003:l024","ordinal":94838,"en":"The reason he could improve it:"},{"id":"semetey-1-2013:p0235:b003:l025","ordinal":94839,"en":"Bolokbai, whom you have seen,"},{"id":"semetey-1-2013:p0235:b003:l026","ordinal":94840,"en":"Conversed in the ordinary way"},{"id":"semetey-1-2013:p0235:b003:l027","ordinal":94841,"en":"And was a friend of David."},{"id":"semetey-1-2013:p0235:b003:l028","ordinal":94842,"en":"Applying all his skill,"},{"id":"semetey-1-2013:p0235:b003:l029","ordinal":94843,"en":"Shaving its screw threads,"},{"id":"semetey-1-2013:p0235:b003:l030","ordinal":94844,"en":"He fashioned it to fit exactly."},{"id":"semetey-1-2013:p0235:b003:l031","ordinal":94845,"en":"'When my lord, my sultan,"},{"id":"semetey-1-2013:p0235:b003:l032","ordinal":94846,"en":"Went toward Kakan,"},{"id":"semetey-1-2013:p0235:b003:l033","ordinal":94847,"en":"Having settled in Talas,"},{"id":"semetey-1-2013:p0235:b003:l034","ordinal":94848,"en":"Twelve scholars of the Islamic faith,"},{"id":"semetey-1-2013:p0235:b003:l035","ordinal":94849,"en":"Those followers of Islam there,"},{"id":"semetey-1-2013:p0235:b003:l036","ordinal":94850,"en":"He drove within under escort."},{"id":"semetey-1-2013:p0235:b003:l037","ordinal":94851,"en":"He traveled to Beijing,' she said,"},{"id":"semetey-1-2013:p0235:b003:l038","ordinal":94852,"en":"'It met so many eyes,' she said."},{"id":"semetey-1-2013:p0235:b003:l039","ordinal":94853,"en":"'In the leopard's hand,"},{"id":"semetey-1-2013:p0235:b005:l001","ordinal":94854,"en":"For how many years it traveled,' she said."},{"id":"semetey-1-2013:p0235:b005:l002","ordinal":94855,"en":"'His object remains, he is gone."},{"id":"semetey-1-2013:p0235:b005:l003","ordinal":94856,"en":"My swift steed's eyes are gone."},{"id":"semetey-1-2013:p0235:b005:l004","ordinal":94857,"en":"Seen today, gone tomorrow—"},{"id":"semetey-1-2013:p0235:b005:l005","ordinal":94858,"en":"Were you always thus, you shit of a world?'"},{"id":"semetey-1-2013:p0235:b005:l006","ordinal":94859,"en":"From its eyepiece,"},{"id":"semetey-1-2013:p0235:b005:l007","ordinal":94860,"en":"Sniffing deeply again and again,"},{"id":"semetey-1-2013:p0235:b005:l008","ordinal":94861,"en":"As though she saw her companion Manas,"},{"id":"semetey-1-2013:p0235:b005:l009","ordinal":94862,"en":"She embraced it and breathed its scent."},{"id":"semetey-1-2013:p0235:b005:l010","ordinal":94863,"en":"With the leopard's telescope,"},{"id":"semetey-1-2013:p0235:b005:l011","ordinal":94864,"en":"She turned Akborchuk's head."},{"id":"semetey-1-2013:p0235:b005:l012","ordinal":94865,"en":"The noble woman Kanykei"},{"id":"semetey-1-2013:p0235:b005:l013","ordinal":94866,"en":"Stood looking through the telescope."},{"id":"semetey-1-2013:p0235:b005:l014","ordinal":94867,"en":"Turning its wheel,"},{"id":"semetey-1-2013:p0235:b005:l015","ordinal":94868,"en":"Putting it right to her eye,"},{"id":"semetey-1-2013:p0235:b005:l016","ordinal":94869,"en":"Turning its screw,"},{"id":"semetey-1-2013:p0235:b005:l017","ordinal":94870,"en":"Drawing it up to her eye,"},{"id":"semetey-1-2013:p0235:b005:l018","ordinal":94871,"en":"She pulled its wings open,"},{"id":"semetey-1-2013:p0235:b005:l019","ordinal":94872,"en":"Trained the telescope on the horses,"},{"id":"semetey-1-2013:p0235:b005:l020","ordinal":94873,"en":"Learned the horses' news."},{"id":"semetey-1-2013:p0235:b005:l021","ordinal":94874,"en":"Holding it firm without a tremor,"},{"id":"semetey-1-2013:p0235:b005:l022","ordinal":94875,"en":"With effort fitting it to her eye,"},{"id":"semetey-1-2013:p0235:b005:l023","ordinal":94876,"en":"She now gazed carefully through it."},{"id":"semetey-1-2013:p0235:b005:l024","ordinal":94877,"en":"At the edge of Ken-Kepe,"},{"id":"semetey-1-2013:p0235:b005:l025","ordinal":94878,"en":"On the nearer slope of Kyrym,"},{"id":"semetey-1-2013:p0235:b005:l026","ordinal":94879,"en":"Cloud after cloud of dust rose."},{"id":"semetey-1-2013:p0235:b005:l027","ordinal":94880,"en":"When she saw the billowing dust,"},{"id":"semetey-1-2013:p0235:b005:l028","ordinal":94881,"en":"Your sister-in-law's soul nearly fled."},{"id":"semetey-1-2013:p0235:b005:l029","ordinal":94882,"en":"Looking into the rising dust,"},{"id":"semetey-1-2013:p0235:b005:l030","ordinal":94883,"en":"She saw her father's Aktulpar"},{"id":"semetey-1-2013:p0235:b005:l031","ordinal":94884,"en":"Racing far ahead."},{"id":"semetey-1-2013:p0235:b005:l032","ordinal":94885,"en":"Her father's Aktulpar"},{"id":"semetey-1-2013:p0235:b005:l033","ordinal":94886,"en":"Had taken the very lead."},{"id":"semetey-1-2013:p0235:b005:l034","ordinal":94887,"en":"Looking behind it,"},{"id":"semetey-1-2013:p0235:b005:l035","ordinal":94888,"en":"She saw dust from the great blaze-faced horse."},{"id":"semetey-1-2013:p0235:b005:l036","ordinal":94889,"en":"Looking behind that,"},{"id":"semetey-1-2013:p0235:b005:l037","ordinal":94890,"en":"There was the horse Chongkuron."},{"id":"semetey-1-2013:p0235:b005:l038","ordinal":94891,"en":"Looking behind the three,"},{"id":"semetey-1-2013:p0235:b005:l039","ordinal":94892,"en":"Koloykan's fine steed Karakashka"},{"id":"semetey-1-2013:p0236:b003:l001","ordinal":94893,"en":"When she looked, it was scarcely visible."},{"id":"semetey-1-2013:p0236:b003:l002","ordinal":94894,"en":"Temir Khan's four wondrous steeds"},{"id":"semetey-1-2013:p0236:b003:l003","ordinal":94895,"en":"Had run far ahead."},{"id":"semetey-1-2013:p0236:b003:l004","ordinal":94896,"en":"Of any other horse,"},{"id":"semetey-1-2013:p0236:b003:l005","ordinal":94897,"en":"Where it was could not be known."},{"id":"semetey-1-2013:p0236:b003:l006","ordinal":94898,"en":"'When the moon is dark,"},{"id":"semetey-1-2013:p0236:b003:l007","ordinal":94899,"en":"What becomes of the night?' she said."},{"id":"semetey-1-2013:p0236:b003:l008","ordinal":94900,"en":"'If Taitoru falls behind,"},{"id":"semetey-1-2013:p0236:b003:l009","ordinal":94901,"en":"Have I now lost all recourse?"},{"id":"semetey-1-2013:p0236:b003:l010","ordinal":94902,"en":"What becomes of my day?' she said."},{"id":"semetey-1-2013:p0236:b003:l011","ordinal":94903,"en":"'An iron net stretched beneath me,"},{"id":"semetey-1-2013:p0236:b003:l012","ordinal":94904,"en":"Heavy misfortune written on my brow."},{"id":"semetey-1-2013:p0236:b003:l013","ordinal":94905,"en":"Alas, my brow bone was sloping,"},{"id":"semetey-1-2013:p0236:b003:l015","ordinal":94906,"en":"When my king passed away,"},{"id":"semetey-1-2013:p0236:b003:l016","ordinal":94907,"en":"My share of life was scant."},{"id":"semetey-1-2013:p0236:b003:l017","ordinal":94908,"en":"Do not let a bird of prey eat the goose."},{"id":"semetey-1-2013:p0236:b003:l018","ordinal":94909,"en":"If you willed to create me, God,"},{"id":"semetey-1-2013:p0236:b003:l019","ordinal":94910,"en":"Do not let them call me a fugitive woman."},{"id":"semetey-1-2013:p0236:b003:l020","ordinal":94911,"en":"Do not let a bird of prey eat the swan."},{"id":"semetey-1-2013:p0236:b003:l021","ordinal":94912,"en":"By the son born from my womb—"},{"id":"semetey-1-2013:p0236:b003:l022","ordinal":94913,"en":"\"Thus the shameless woman"},{"id":"semetey-1-2013:p0236:b003:l023","ordinal":94914,"en":"Died,\" do not let them say."},{"id":"semetey-1-2013:p0236:b003:l024","ordinal":94915,"en":"Do not dig my pit."},{"id":"semetey-1-2013:p0236:b003:l025","ordinal":94916,"en":"If you willed to create me, God,"},{"id":"semetey-1-2013:p0236:b003:l026","ordinal":94917,"en":"Do not boil my misery."},{"id":"semetey-1-2013:p0236:b003:l027","ordinal":94918,"en":"Through the only child born from my womb,"},{"id":"semetey-1-2013:p0236:b003:l028","ordinal":94919,"en":"God, do not boil my misery."},{"id":"semetey-1-2013:p0236:b003:l029","ordinal":94920,"en":"Were you a night with a darkened moon?"},{"id":"semetey-1-2013:p0236:b003:l030","ordinal":94921,"en":"With Taitoru left behind,"},{"id":"semetey-1-2013:p0236:b003:l031","ordinal":94922,"en":"Were you the day my death would come?"},{"id":"semetey-1-2013:p0236:b003:l032","ordinal":94923,"en":"My dear hair as thick as a girth,"},{"id":"semetey-1-2013:p0236:b003:l033","ordinal":94924,"en":"Spreading it upon my breast,"},{"id":"semetey-1-2013:p0236:b003:l034","ordinal":94925,"en":"Am I to braid it?"},{"id":"semetey-1-2013:p0236:b003:l035","ordinal":94926,"en":"By the light born of my own body,"},{"id":"semetey-1-2013:p0236:b003:l036","ordinal":94927,"en":"Am I, the woman who herself bore him,"},{"id":"semetey-1-2013:p0236:b003:l037","ordinal":94928,"en":"To die?!'"},{"id":"semetey-1-2013:p0236:b003:l038","ordinal":94929,"en":"Upon the saddle-shaped ridge,"},{"id":"semetey-1-2013:p0236:b003:l039","ordinal":94930,"en":"Your noble sister-in-law Kanykei,"},{"id":"semetey-1-2013:p0236:b004:l001","ordinal":94931,"en":"Crying out in tears, unable to rise,"},{"id":"semetey-1-2013:p0236:b004:l002","ordinal":94932,"en":"Found not a fly's worth of recourse."},{"id":"semetey-1-2013:p0236:b004:l003","ordinal":94933,"en":"Unable to turn her horse's head,"},{"id":"semetey-1-2013:p0236:b004:l004","ordinal":94934,"en":"Crying out, unable to stand,"},{"id":"semetey-1-2013:p0236:b004:l005","ordinal":94935,"en":"The leopard's great telescope"},{"id":"semetey-1-2013:p0236:b004:l006","ordinal":94936,"en":"She turned again toward her eye,"},{"id":"semetey-1-2013:p0236:b004:l007","ordinal":94937,"en":"Put it up once more,"},{"id":"semetey-1-2013:p0236:b004:l008","ordinal":94938,"en":"Extended the telescope again."},{"id":"semetey-1-2013:p0236:b004:l009","ordinal":94939,"en":"To God whose command is mighty,"},{"id":"semetey-1-2013:p0236:b004:l010","ordinal":94940,"en":"She stood offering prayer."},{"id":"semetey-1-2013:p0236:b004:l011","ordinal":94941,"en":"Bursting into sobs,"},{"id":"semetey-1-2013:p0236:b004:l012","ordinal":94942,"en":"The telescope you have seen"},{"id":"semetey-1-2013:p0236:b004:l013","ordinal":94943,"en":"She held firmly to her eye."},{"id":"semetey-1-2013:p0236:b004:l014","ordinal":94944,"en":"Her composure all exhausted,"},{"id":"semetey-1-2013:p0236:b004:l015","ordinal":94945,"en":"She stood sobbing in tears,"},{"id":"semetey-1-2013:p0236:b004:l016","ordinal":94946,"en":"Stood wailing piercingly."},{"id":"semetey-1-2013:p0236:b004:l017","ordinal":94947,"en":"When she looked through the telescope,"},{"id":"semetey-1-2013:p0236:b004:l018","ordinal":94948,"en":"Upon the ridge of Ken-Moinok"},{"id":"semetey-1-2013:p0236:b004:l019","ordinal":94949,"en":"Her swift steed was coming."},{"id":"semetey-1-2013:p0236:b004:l020","ordinal":94950,"en":"Upon the ridge of broad Kyrym,"},{"id":"semetey-1-2013:p0236:b004:l021","ordinal":94951,"en":"Unable to lower his head to the ground,"},{"id":"semetey-1-2013:p0236:b004:l022","ordinal":94952,"en":"Unable to stride like a wild sheep,"},{"id":"semetey-1-2013:p0236:b004:l023","ordinal":94953,"en":"Her swift steed was coming."},{"id":"semetey-1-2013:p0236:b004:l024","ordinal":94954,"en":"When she counted then,"},{"id":"semetey-1-2013:p0236:b004:l025","ordinal":94955,"en":"He was behind three hundred horses."},{"id":"semetey-1-2013:p0236:b004:l026","ordinal":94956,"en":"Taitoru, raced to seek an omen,"},{"id":"semetey-1-2013:p0236:b004:l027","ordinal":94957,"en":"Was behind three hundred horses."},{"id":"semetey-1-2013:p0236:b004:l028","ordinal":94958,"en":"How could he run now?"},{"id":"semetey-1-2013:p0236:b004:l029","ordinal":94959,"en":"Crying out in tears, the poor soul"},{"id":"semetey-1-2013:p0236:b004:l030","ordinal":94960,"en":"Now despaired of her fly-small life."},{"id":"semetey-1-2013:p0236:b004:l031","ordinal":94961,"en":"Unable to draw back her running nose,"},{"id":"semetey-1-2013:p0236:b004:l032","ordinal":94962,"en":"Unable to wipe the tears from her eyes,"},{"id":"semetey-1-2013:p0236:b004:l033","ordinal":94963,"en":"Her poor heart torn apart,"},{"id":"semetey-1-2013:p0236:b004:l034","ordinal":94964,"en":"Tears flowing from her eyes,"},{"id":"semetey-1-2013:p0236:b004:l035","ordinal":94965,"en":"Her ribs coming apart,"},{"id":"semetey-1-2013:p0236:b004:l036","ordinal":94966,"en":"The tears that came mixed with blood"},{"id":"semetey-1-2013:p0236:b004:l037","ordinal":94967,"en":"Of Akborchuk, whom you have seen,"},{"id":"semetey-1-2013:p0236:b004:l038","ordinal":94968,"en":"They poured down the mane."},{"id":"semetey-1-2013:p0236:b004:l039","ordinal":94969,"en":"From care too great for her breast,"},{"id":"semetey-1-2013:p0237:b003:l001","ordinal":94970,"en":"The poor soul stood in fear"},{"id":"semetey-1-2013:p0237:b003:l002","ordinal":94971,"en":"Of the child born from her breast."},{"id":"semetey-1-2013:p0237:b003:l003","ordinal":94972,"en":"'Ah, alas, you empty world,"},{"id":"semetey-1-2013:p0237:b003:l004","ordinal":94973,"en":"My brow bone was sloping,"},{"id":"semetey-1-2013:p0237:b003:l005","ordinal":94974,"en":"My share of life was scant."},{"id":"semetey-1-2013:p0237:b003:l006","ordinal":94975,"en":"It is a night with a darkened moon;"},{"id":"semetey-1-2013:p0237:b003:l007","ordinal":94976,"en":"Today is the day my death will come!"}]
