[{"id":"manas-2010:p1282:b001:l009","ordinal":55553,"en":"Despaired of his life."},{"id":"manas-2010:p1282:b001:l010","ordinal":55554,"en":"“When will he reach me?” he thought."},{"id":"manas-2010:p1282:b001:l011","ordinal":55555,"en":"“From the vast Chinese army,"},{"id":"manas-2010:p1282:b001:l012","ordinal":55556,"en":"When will he break me free?” he thought."},{"id":"manas-2010:p1282:b001:l013","ordinal":55557,"en":"He watched with desperate longing."},{"id":"manas-2010:p1282:b001:l014","ordinal":55558,"en":"“When will he bring slaughter?” he thought."},{"id":"manas-2010:p1282:b001:l015","ordinal":55559,"en":"“At this time when I am hard pressed,"},{"id":"manas-2010:p1282:b001:l016","ordinal":55560,"en":"When will warrior Chubak arrive"},{"id":"manas-2010:p1282:b001:l017","ordinal":55561,"en":"And break me free?” he thought."},{"id":"manas-2010:p1282:b001:l018","ordinal":55562,"en":"As for your Chubak, leaving Manas aside,"},{"id":"manas-2010:p1282:b001:l019","ordinal":55563,"en":"He could find no way to save himself."},{"id":"manas-2010:p1282:b001:l020","ordinal":55564,"en":"Orokkyr and Börüköz,"},{"id":"manas-2010:p1282:b001:l021","ordinal":55565,"en":"The two had waged battle against him."},{"id":"manas-2010:p1282:b001:l022","ordinal":55566,"en":"Steeped in crimson blood,"},{"id":"manas-2010:p1282:b001:l023","ordinal":55567,"en":"He could not turn to look."},{"id":"manas-2010:p1282:b001:l024","ordinal":55568,"en":"Seeing this, your Manas"},{"id":"manas-2010:p1282:b001:l025","ordinal":55569,"en":"At Akbaltay's Chubak"},{"id":"manas-2010:p1282:b001:l026","ordinal":55570,"en":"Took deep offense."},{"id":"manas-2010:p1282:b001:l027","ordinal":55571,"en":"Bringing slaughter to the Chinese,"},{"id":"manas-2010:p1282:b001:l028","ordinal":55572,"en":"Almambet, born a champion,"},{"id":"manas-2010:p1282:b001:l029","ordinal":55573,"en":"Was proving his worth."},{"id":"manas-2010:p1282:b001:l030","ordinal":55574,"en":"“That daughter-fucking gray mule,"},{"id":"manas-2010:p1282:b001:l031","ordinal":55575,"en":"When will it cease to move?” he thought."},{"id":"manas-2010:p1282:b001:l032","ordinal":55576,"en":"Glancing back like a white falcon,"},{"id":"manas-2010:p1282:b001:l033","ordinal":55577,"en":"From time to time, far off,"},{"id":"manas-2010:p1282:b001:l034","ordinal":55578,"en":"Casting his eyes from afar,"},{"id":"manas-2010:p1282:b001:l035","ordinal":55579,"en":"Was he not keeping watch!"},{"id":"manas-2010:p1282:b001:l036","ordinal":55580,"en":"When Almambet looked closely,"},{"id":"manas-2010:p1282:b001:l037","ordinal":55581,"en":"With the Kalcha Kongurbay at their head,"},{"id":"manas-2010:p1282:b001:l038","ordinal":55582,"en":"Manas, born a leopard,"},{"id":"manas-2010:p1282:b001:l039","ordinal":55583,"en":"They had encircled twelve deep."},{"id":"manas-2010:p1282:b001:l040","ordinal":55584,"en":"Isolating Manas,"},{"id":"manas-2010:p1282:b001:l041","ordinal":55585,"en":"To capture him alive,"},{"id":"manas-2010:p1282:b001:l042","ordinal":55586,"en":"They had brought him torment."}]
