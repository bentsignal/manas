{"id": "sayakbay-ms-current146:pdf068:l033", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 68, "folio": 451, "line_in_page": 33, "raw": "Миңге берсең Желжетпес,", "text": "Миңге берсең Желжетпес,", "en": "If you give it to thousands, Zhelzhetpes,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Cursive reading, word division, or idiomatic interpretation is provisional.", "bbox": null}
