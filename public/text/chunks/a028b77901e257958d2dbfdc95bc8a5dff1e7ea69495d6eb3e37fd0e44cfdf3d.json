[{"id":"semetey-1-2013:p0975:b003:l020","ordinal":150529,"en":"And raised the battle cry of Manas."},{"id":"semetey-1-2013:p0975:b003:l021","ordinal":150530,"en":"Overcome with joy,"},{"id":"semetey-1-2013:p0975:b003:l022","ordinal":150531,"en":"He pleaded with the two boys beside him,"},{"id":"semetey-1-2013:p0975:b003:l023","ordinal":150532,"en":"Calling, “Hurry and reach it!"},{"id":"semetey-1-2013:p0975:b003:l024","ordinal":150533,"en":"Kulchoro and Kanchoro,"},{"id":"semetey-1-2013:p0975:b003:l025","ordinal":150534,"en":"My two equal supports,"},{"id":"semetey-1-2013:p0975:b003:l026","ordinal":150535,"en":"You two, my younger brothers,"},{"id":"semetey-1-2013:p0975:b003:l027","ordinal":150536,"en":"Reach it before an arrow could;"},{"id":"semetey-1-2013:p0975:b003:l028","ordinal":150537,"en":"Get there and cut its throat."},{"id":"semetey-1-2013:p0975:b003:l029","ordinal":150538,"en":"Bind it securely again"},{"id":"semetey-1-2013:p0975:b003:l030","ordinal":150539,"en":"And fasten it to the saddle straps."},{"id":"semetey-1-2013:p0975:b003:l031","ordinal":150540,"en":"Slaughter it lawfully,"},{"id":"semetey-1-2013:p0975:b003:l032","ordinal":150541,"en":"And take it as a gift"},{"id":"semetey-1-2013:p0975:b003:l033","ordinal":150542,"en":"To my dear mother Kanykey!”"},{"id":"semetey-1-2013:p0975:b003:l034","ordinal":150543,"en":"After the falcon took it,"},{"id":"semetey-1-2013:p0975:b003:l035","ordinal":150544,"en":"Kulchoro and Kanchoro,"},{"id":"semetey-1-2013:p0975:b003:l036","ordinal":150545,"en":"The two choros, raced each other,"},{"id":"semetey-1-2013:p0975:b003:l037","ordinal":150546,"en":"Their stirrups striking together."},{"id":"semetey-1-2013:p0975:b003:l038","ordinal":150547,"en":"Before they could reach the swan,"},{"id":"semetey-1-2013:p0975:b003:l039","ordinal":150548,"en":"Wearing his handsome patterned coat,"},{"id":"semetey-1-2013:p0975:b004:l001","ordinal":150549,"en":"Semetey, brave son of Manas,"},{"id":"semetey-1-2013:p0975:b004:l002","ordinal":150550,"en":"Thundered along the road."},{"id":"semetey-1-2013:p0975:b004:l003","ordinal":150551,"en":"He made his neck turn like a stag’s;"},{"id":"semetey-1-2013:p0975:b004:l004","ordinal":150552,"en":"Buurul was a true courser,"},{"id":"semetey-1-2013:p0975:b004:l005","ordinal":150553,"en":"And when game appeared along its path,"},{"id":"semetey-1-2013:p0975:b004:l006","ordinal":150554,"en":"It sprang without delay."},{"id":"semetey-1-2013:p0975:b004:l007","ordinal":150555,"en":"He charged straight toward the swan;"},{"id":"semetey-1-2013:p0975:b004:l008","ordinal":150556,"en":"Poor Buurul’s hoofbeats"},{"id":"semetey-1-2013:p0975:b004:l009","ordinal":150557,"en":"Shattered the ground beneath him,"},{"id":"semetey-1-2013:p0975:b004:l010","ordinal":150558,"en":"And he flew roaring like a cloud."},{"id":"semetey-1-2013:p0975:b004:l011","ordinal":150559,"en":"Before one could say this or that,"},{"id":"semetey-1-2013:p0975:b004:l012","ordinal":150560,"en":"In the time it takes to blink,"},{"id":"semetey-1-2013:p0975:b004:l013","ordinal":150561,"en":"Semetey arrived like a master."},{"id":"semetey-1-2013:p0975:b004:l014","ordinal":150562,"en":"He had gone the length of a spear,"},{"id":"semetey-1-2013:p0975:b004:l015","ordinal":150563,"en":"Keeping his eyes fixed on the white swan."},{"id":"semetey-1-2013:p0975:b004:l016","ordinal":150564,"en":"Wondrous Akshunkar lay there,"},{"id":"semetey-1-2013:p0975:b004:l017","ordinal":150565,"en":"Clinging to the white swan’s neck;"},{"id":"semetey-1-2013:p0975:b004:l018","ordinal":150566,"en":"The white swan lay thrashing,"},{"id":"semetey-1-2013:p0975:b004:l019","ordinal":150567,"en":"Locked in battle with Akshunkar."},{"id":"semetey-1-2013:p0975:b004:l020","ordinal":150568,"en":"Raging, he made a sudden move,"},{"id":"semetey-1-2013:p0975:b004:l021","ordinal":150569,"en":"From tireless Buurul"},{"id":"semetey-1-2013:p0975:b004:l022","ordinal":150570,"en":"He sprang and leapt down."},{"id":"semetey-1-2013:p0975:b004:l023","ordinal":150571,"en":"The swan fled, and the falcon was gone;"},{"id":"semetey-1-2013:p0975:b004:l024","ordinal":150572,"en":"When Semetey opened his eyes,"},{"id":"semetey-1-2013:p0975:b004:l025","ordinal":150573,"en":"Such is the worthlessness of this world."},{"id":"semetey-1-2013:p0975:b004:l026","ordinal":150574,"en":"He saw the swan crawling away;"},{"id":"semetey-1-2013:p0975:b004:l027","ordinal":150575,"en":"The blue-maned tiger"},{"id":"semetey-1-2013:p0975:b004:l028","ordinal":150576,"en":"Reached out his hand to seize it,"},{"id":"semetey-1-2013:p0975:b004:l029","ordinal":150577,"en":"But caught the joint of its wing"},{"id":"semetey-1-2013:p0975:b004:l030","ordinal":150578,"en":"With an unsteady grip."},{"id":"semetey-1-2013:p0975:b004:l031","ordinal":150579,"en":"The white swan tore itself free"},{"id":"semetey-1-2013:p0975:b004:l032","ordinal":150580,"en":"And escaped into the deep water."},{"id":"semetey-1-2013:p0975:b004:l033","ordinal":150581,"en":"Where it crossed into Ala-Köl,"},{"id":"semetey-1-2013:p0975:b004:l034","ordinal":150582,"en":"The swaggering madman"},{"id":"semetey-1-2013:p0975:b004:l035","ordinal":150583,"en":"Caught it by the throat."},{"id":"semetey-1-2013:p0975:b004:l036","ordinal":150584,"en":"He pulled back in grief,"},{"id":"semetey-1-2013:p0975:b004:l037","ordinal":150585,"en":"And Semetey, still bewildered,"},{"id":"semetey-1-2013:p0975:b004:l038","ordinal":150586,"en":"Ran toward Arbuudan."},{"id":"semetey-1-2013:p0975:b004:l039","ordinal":150587,"en":"What could the desperate prince do?"}]
