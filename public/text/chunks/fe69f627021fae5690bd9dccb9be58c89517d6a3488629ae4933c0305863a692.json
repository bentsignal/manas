[{"id":"semetey-2-2013:p1319:b004:l007","ordinal":288257,"en":"Unable to advance, they stood amazed."},{"id":"semetey-2-2013:p1319:b004:l008","ordinal":288258,"en":"Lions guarded it all around—"},{"id":"semetey-2-2013:p1319:b004:l009","ordinal":288259,"en":"Such, if you understand, was that place."},{"id":"semetey-2-2013:p1319:b004:l010","ordinal":288260,"en":"In that palace amid the marsh,"},{"id":"semetey-2-2013:p1319:b004:l011","ordinal":288261,"en":"The unfortunate lady Aichurok"},{"id":"semetey-2-2013:p1319:b004:l012","ordinal":288262,"en":"Lay overwhelmed by grief,"},{"id":"semetey-2-2013:p1319:b004:l013","ordinal":288263,"en":"When the master gardener Akjoltoi"},{"id":"semetey-2-2013:p1319:b004:l014","ordinal":288264,"en":"Came running to her."},{"id":"semetey-2-2013:p1319:b004:l015","ordinal":288265,"en":"He told of Kanchoro, her enemy,"},{"id":"semetey-2-2013:p1319:b004:l016","ordinal":288266,"en":"And recounted the whole quarrel;"},{"id":"semetey-2-2013:p1319:b004:l017","ordinal":288267,"en":"He told what his own eyes had seen,"},{"id":"semetey-2-2013:p1319:b004:l018","ordinal":288268,"en":"And all the words he knew."},{"id":"semetey-2-2013:p1319:b004:l019","ordinal":288269,"en":"He related the great,"},{"id":"semetey-2-2013:p1319:b004:l020","ordinal":288270,"en":"Unhealed calamity."},{"id":"semetey-2-2013:p1319:b004:l021","ordinal":288271,"en":"He told of an uproar"},{"id":"semetey-2-2013:p1319:b004:l022","ordinal":288272,"en":"Too dreadful for words;"},{"id":"semetey-2-2013:p1319:b004:l023","ordinal":288273,"en":"He told his sorrow that beneath him"},{"id":"semetey-2-2013:p1319:b004:l024","ordinal":288274,"en":"He had no swift stallion."},{"id":"semetey-2-2013:p1319:b004:l025","ordinal":288275,"en":"He told how the many Black Jediger,"},{"id":"semetey-2-2013:p1319:b004:l026","ordinal":288276,"en":"Forty-two men, surrounded the hero"},{"id":"semetey-2-2013:p1319:b004:l027","ordinal":288277,"en":"And captured him."},{"id":"semetey-2-2013:p1319:b004:l028","ordinal":288278,"en":"He told how the Greathearted One,"},{"id":"semetey-2-2013:p1319:b004:l029","ordinal":288279,"en":"Left without a horse,"},{"id":"semetey-2-2013:p1319:b004:l030","ordinal":288280,"en":"Had remained behind."},{"id":"semetey-2-2013:p1319:b004:l031","ordinal":288281,"en":"Sharpening his bitter tongue,"},{"id":"semetey-2-2013:p1319:b004:l032","ordinal":288282,"en":"Khan Akjoltoi spoke on."},{"id":"semetey-2-2013:p1319:b004:l033","ordinal":288283,"en":"When the Jediger closed around them,"},{"id":"semetey-2-2013:p1319:b004:l034","ordinal":288284,"en":"Kanchoro gave the Jediger"},{"id":"semetey-2-2013:p1319:b004:l035","ordinal":288285,"en":"Every encouragement;"},{"id":"semetey-2-2013:p1319:b004:l036","ordinal":288286,"en":"An enemy arose from among their own,"},{"id":"semetey-2-2013:p1319:b004:l037","ordinal":288287,"en":"And pain welled from the very core."},{"id":"semetey-2-2013:p1319:b004:l038","ordinal":288288,"en":"He told all that had happened:"},{"id":"semetey-2-2013:p1319:b004:l039","ordinal":288289,"en":"“Father, the lion from afar—"},{"id":"semetey-2-2013:p1320:b003:l001","ordinal":288290,"en":"He stood unshaken, ringing like steel,"},{"id":"semetey-2-2013:p1320:b003:l002","ordinal":288291,"en":"Counting the swarming Jediger"},{"id":"semetey-2-2013:p1320:b003:l003","ordinal":288292,"en":"As no more than the hem of his robe."},{"id":"semetey-2-2013:p1320:b003:l004","ordinal":288293,"en":"The Greathearted Lion, left horseless,"},{"id":"semetey-2-2013:p1320:b003:l005","ordinal":288294,"en":"Turned his face toward the qibla,"},{"id":"semetey-2-2013:p1320:b003:l006","ordinal":288295,"en":"Girded on his sharp steel,"},{"id":"semetey-2-2013:p1320:b003:l007","ordinal":288296,"en":"And wrapped himself in his white armor;"},{"id":"semetey-2-2013:p1320:b003:l008","ordinal":288297,"en":"He did not draw back his outstretched foot,"},{"id":"semetey-2-2013:p1320:b003:l009","ordinal":288298,"en":"Nor open his once-closed eyes."},{"id":"semetey-2-2013:p1320:b003:l010","ordinal":288299,"en":"Yesterday Khan Kanchoro and Khan Kyiaz"},{"id":"semetey-2-2013:p1320:b003:l011","ordinal":288300,"en":"Charged and thrust their spears,"},{"id":"semetey-2-2013:p1320:b003:l012","ordinal":288301,"en":"Fired guns and loosed arrows,"},{"id":"semetey-2-2013:p1320:b003:l013","ordinal":288302,"en":"And besieged him where he stood."},{"id":"semetey-2-2013:p1320:b003:l014","ordinal":288303,"en":"I heard the noble lion, left horseless,"},{"id":"semetey-2-2013:p1320:b003:l015","ordinal":288304,"en":"Was treacherously struck by a spear—"},{"id":"semetey-2-2013:p1320:b003:l016","ordinal":288305,"en":"A shameful deed;"},{"id":"semetey-2-2013:p1320:b003:l017","ordinal":288306,"en":"That he died and his bones were never found,"},{"id":"semetey-2-2013:p1320:b003:l018","ordinal":288307,"en":"That the lion you yourselves had seen"},{"id":"semetey-2-2013:p1320:b003:l019","ordinal":288308,"en":"Vanished without a trace."},{"id":"semetey-2-2013:p1320:b003:l020","ordinal":288309,"en":"Mist rose from the ravine,"},{"id":"semetey-2-2013:p1320:b003:l021","ordinal":288310,"en":"And over the summit of Achkaikan-Tau"},{"id":"semetey-2-2013:p1320:b003:l022","ordinal":288311,"en":"Black clouds gathered;"},{"id":"semetey-2-2013:p1320:b003:l023","ordinal":288312,"en":"Mountains collapsed with a roar,"},{"id":"semetey-2-2013:p1320:b003:l024","ordinal":288313,"en":"Floodwater ran and slopes slid,"},{"id":"semetey-2-2013:p1320:b003:l025","ordinal":288314,"en":"Day and night became darkness,"},{"id":"semetey-2-2013:p1320:b003:l026","ordinal":288315,"en":"And the ravine filled with turbulent water."},{"id":"semetey-2-2013:p1320:b003:l027","ordinal":288316,"en":"The trees on the shaded slope"},{"id":"semetey-2-2013:p1320:b003:l028","ordinal":288317,"en":"Stood with their roots torn bare;"},{"id":"semetey-2-2013:p1320:b003:l029","ordinal":288318,"en":"The Jediger's gaunt horses"},{"id":"semetey-2-2013:p1320:b003:l030","ordinal":288319,"en":"Lay utterly dead and swollen."},{"id":"semetey-2-2013:p1320:b003:l031","ordinal":288320,"en":"I heard they reached"},{"id":"semetey-2-2013:p1320:b003:l032","ordinal":288321,"en":"The hero's inheritance;"},{"id":"semetey-2-2013:p1320:b003:l033","ordinal":288322,"en":"I heard my Greathearted One vanished"},{"id":"semetey-2-2013:p1320:b003:l034","ordinal":288323,"en":"And departed from this world."},{"id":"semetey-2-2013:p1320:b003:l035","ordinal":288324,"en":"These were the hero's own words:"},{"id":"semetey-2-2013:p1320:b003:l036","ordinal":288325,"en":"“In his old age, Khan Bakai,"},{"id":"semetey-2-2013:p1320:b003:l037","ordinal":288326,"en":"And in her old age, Chyiyrdy—"},{"id":"semetey-2-2013:p1320:b003:l038","ordinal":288327,"en":"May neither outlive me.”"},{"id":"semetey-2-2013:p1320:b003:l039","ordinal":288328,"en":"He said my aged mother Kanykei,"},{"id":"semetey-2-2013:p1320:b004:l001","ordinal":288329,"en":"Whose brow-bone arches high,"},{"id":"semetey-2-2013:p1320:b004:l002","ordinal":288330,"en":"Had always been fated"},{"id":"semetey-2-2013:p1320:b004:l003","ordinal":288331,"en":"To see few happy days;"},{"id":"semetey-2-2013:p1320:b004:l004","ordinal":288332,"en":"Her hair at the nape was coarse,"},{"id":"semetey-2-2013:p1320:b004:l005","ordinal":288333,"en":"Her lot was heavy sorrow."},{"id":"semetey-2-2013:p1320:b004:l006","ordinal":288334,"en":"“Do not let her shriek and tear her face,"},{"id":"semetey-2-2013:p1320:b004:l007","ordinal":288335,"en":"Do not let her rage,"},{"id":"semetey-2-2013:p1320:b004:l008","ordinal":288336,"en":"Do not let her take her tiny life."},{"id":"semetey-2-2013:p1320:b004:l009","ordinal":288337,"en":"If my dear mother does not die,"},{"id":"semetey-2-2013:p1320:b004:l010","ordinal":288338,"en":"Though senseless hardship may strike her,"},{"id":"semetey-2-2013:p1320:b004:l011","ordinal":288339,"en":"Let her live to see it,"},{"id":"semetey-2-2013:p1320:b004:l012","ordinal":288340,"en":"The child six months formed"},{"id":"semetey-2-2013:p1320:b004:l013","ordinal":288341,"en":"Within Aichurok's womb."},{"id":"semetey-2-2013:p1320:b004:l014","ordinal":288342,"en":"Slaughter ninety beasts for his feast;"},{"id":"semetey-2-2013:p1320:b004:l015","ordinal":288343,"en":"If the child is a boy,"},{"id":"semetey-2-2013:p1320:b004:l016","ordinal":288344,"en":"Give him the name Seitek.”"},{"id":"semetey-2-2013:p1320:b004:l017","ordinal":288345,"en":"Those were the prince's necessary words;"},{"id":"semetey-2-2013:p1320:b004:l018","ordinal":288346,"en":"That is exactly what he said."},{"id":"semetey-2-2013:p1320:b004:l019","ordinal":288347,"en":"“Make him like the morning star in heaven,"},{"id":"semetey-2-2013:p1320:b004:l020","ordinal":288348,"en":"The one appointed by destiny;"},{"id":"semetey-2-2013:p1320:b004:l021","ordinal":288349,"en":"If Kulchoro lives,"},{"id":"semetey-2-2013:p1320:b004:l022","ordinal":288350,"en":"Make the boy his companion."},{"id":"semetey-2-2013:p1320:b004:l023","ordinal":288351,"en":"Against the enemy who comes head-on,"},{"id":"semetey-2-2013:p1320:b004:l024","ordinal":288352,"en":"He will be his host of warriors;"},{"id":"semetey-2-2013:p1320:b004:l025","ordinal":288353,"en":"If Kulchoro survives,"},{"id":"semetey-2-2013:p1320:b004:l026","ordinal":288354,"en":"He will be his wing."},{"id":"semetey-2-2013:p1320:b004:l027","ordinal":288355,"en":"Growing strong and becoming a man,"},{"id":"semetey-2-2013:p1320:b004:l028","ordinal":288356,"en":"He will stand equal to heroes' sons."},{"id":"semetey-2-2013:p1320:b004:l029","ordinal":288357,"en":"The child left in the womb will mature,"},{"id":"semetey-2-2013:p1320:b004:l030","ordinal":288358,"en":"Meet my poor kinsman,"},{"id":"semetey-2-2013:p1320:b004:l031","ordinal":288359,"en":"And find the lands of Jylgyndy,"},{"id":"semetey-2-2013:p1320:b004:l032","ordinal":288360,"en":"Broad Keng-Kol, and wide Talas."},{"id":"semetey-2-2013:p1320:b004:l033","ordinal":288361,"en":"He will find the happy Kyrgyz"},{"id":"semetey-2-2013:p1320:b004:l034","ordinal":288362,"en":"And the many Argyn people.”"},{"id":"semetey-2-2013:p1320:b004:l035","ordinal":288363,"en":"The bloodstained warrior's last command"},{"id":"semetey-2-2013:p1320:b004:l036","ordinal":288364,"en":"Was this, to be told to Aichurok:"},{"id":"semetey-2-2013:p1320:b004:l037","ordinal":288365,"en":"“Do not claw your face bloody,"},{"id":"semetey-2-2013:p1320:b004:l038","ordinal":288366,"en":"Do not loose your black hair."},{"id":"semetey-2-2013:p1320:b004:l039","ordinal":288367,"en":"When this grievous, crushing calamity"},{"id":"semetey-2-2013:p1321:b003:l001","ordinal":288368,"en":"Has fallen upon your noble head,"},{"id":"semetey-2-2013:p1321:b003:l002","ordinal":288369,"en":"Do no such thing."},{"id":"semetey-2-2013:p1321:b003:l003","ordinal":288370,"en":"Make your mourning head a man,"},{"id":"semetey-2-2013:p1321:b003:l004","ordinal":288371,"en":"Make your woman's head a banner;"},{"id":"semetey-2-2013:p1321:b003:l005","ordinal":288372,"en":"Against Kanchoro and Kyiaz"},{"id":"semetey-2-2013:p1321:b003:l006","ordinal":288373,"en":"Raise an uproar no man has seen."},{"id":"semetey-2-2013:p1321:b003:l007","ordinal":288374,"en":"Drive your caravan forth,"},{"id":"semetey-2-2013:p1321:b003:l008","ordinal":288375,"en":"And take revenge without grieving"},{"id":"semetey-2-2013:p1321:b003:l009","ordinal":288376,"en":"On those babbling fools."},{"id":"semetey-2-2013:p1321:b003:l010","ordinal":288377,"en":"Lead your migration from Talas;"},{"id":"semetey-2-2013:p1321:b003:l011","ordinal":288378,"en":"If you are a tigress, a lioness,"},{"id":"semetey-2-2013:p1321:b003:l012","ordinal":288379,"en":"If you truly are Aichurok,"},{"id":"semetey-2-2013:p1321:b003:l013","ordinal":288380,"en":"Take vengeance on the traitors!”"},{"id":"semetey-2-2013:p1321:b003:l014","ordinal":288381,"en":"Thus Akjoltoi"},{"id":"semetey-2-2013:p1321:b003:l015","ordinal":288382,"en":"Spoke these words to her."},{"id":"semetey-2-2013:p1321:b003:l016","ordinal":288383,"en":"Kulchoro, who was your wing,"},{"id":"semetey-2-2013:p1321:b003:l017","ordinal":288384,"en":"Had his temple pierced and was made a slave;"},{"id":"semetey-2-2013:p1321:b003:l018","ordinal":288385,"en":"The warrior's shoulder was cut,"},{"id":"semetey-2-2013:p1321:b003:l019","ordinal":288386,"en":"And he was enslaved as a herdsman."},{"id":"semetey-2-2013:p1321:b003:l020","ordinal":288387,"en":"Kanchoro sharpened his keen broadsword"},{"id":"semetey-2-2013:p1321:b003:l021","ordinal":288388,"en":"And slaughtered all the rest,"},{"id":"semetey-2-2013:p1321:b003:l022","ordinal":288389,"en":"Leaving no one alive."},{"id":"semetey-2-2013:p1321:b003:l023","ordinal":288390,"en":"He spilled and churned their yellow blood;"},{"id":"semetey-2-2013:p1321:b003:l024","ordinal":288391,"en":"My forefather, old Bakai,"},{"id":"semetey-2-2013:p1321:b003:l025","ordinal":288392,"en":"Suffered outrage upon outrage,"},{"id":"semetey-2-2013:p1321:b003:l026","ordinal":288393,"en":"And they dragged him in the kok-boru game."},{"id":"semetey-2-2013:p1321:b003:l027","ordinal":288394,"en":"In fury and anguish,"},{"id":"semetey-2-2013:p1321:b003:l028","ordinal":288395,"en":"The many Argyn and the Kyrgyz host"},{"id":"semetey-2-2013:p1321:b003:l029","ordinal":288396,"en":"Despaired of their precious lives.”"},{"id":"semetey-2-2013:p1321:b003:l030","ordinal":288397,"en":"Ah, when Akjoltoi"},{"id":"semetey-2-2013:p1321:b003:l031","ordinal":288398,"en":"Had said these things,"},{"id":"semetey-2-2013:p1321:b003:l032","ordinal":288399,"en":"Old Chyiyrdy"},{"id":"semetey-2-2013:p1321:b003:l033","ordinal":288400,"en":"Tensed like a hawk,"},{"id":"semetey-2-2013:p1321:b003:l034","ordinal":288401,"en":"And pleading with Kanykei,"},{"id":"semetey-2-2013:p1321:b003:l035","ordinal":288402,"en":"For six thousand camels and a thousand colts,"},{"id":"semetey-2-2013:p1321:b003:l036","ordinal":288403,"en":"She had bought the white dagger;"},{"id":"semetey-2-2013:p1321:b003:l037","ordinal":288404,"en":"She drew it from its sheath."},{"id":"semetey-2-2013:p1321:b003:l038","ordinal":288405,"en":"Shrieking aloud,"},{"id":"semetey-2-2013:p1321:b003:l039","ordinal":288406,"en":"“How can I remain after my darling?”"},{"id":"semetey-2-2013:p1321:b005:l001","ordinal":288407,"en":"She aimed it at her breast."},{"id":"semetey-2-2013:p1321:b005:l002","ordinal":288408,"en":"The old mother herself"},{"id":"semetey-2-2013:p1321:b005:l003","ordinal":288409,"en":"Drew it across her body."},{"id":"semetey-2-2013:p1321:b005:l004","ordinal":288410,"en":"His unfortunate mother Kanykei,"},{"id":"semetey-2-2013:p1321:b005:l005","ordinal":288411,"en":"Wailing and sobbing, could not stand,"},{"id":"semetey-2-2013:p1321:b005:l006","ordinal":288412,"en":"Yet could not take her own life;"},{"id":"semetey-2-2013:p1321:b005:l007","ordinal":288413,"en":"Her color fled and her senses reeled"},{"id":"semetey-2-2013:p1321:b005:l008","ordinal":288414,"en":"As they struggled over the white dagger."},{"id":"semetey-2-2013:p1321:b005:l009","ordinal":288415,"en":"She screamed and wept aloud,"},{"id":"semetey-2-2013:p1321:b005:l010","ordinal":288416,"en":"“Ah, my only one!” she sobbed."},{"id":"semetey-2-2013:p1321:b005:l011","ordinal":288417,"en":"From her quail-like eyes"},{"id":"semetey-2-2013:p1321:b005:l012","ordinal":288418,"en":"Uncommon tears of blood flowed."},{"id":"semetey-2-2013:p1321:b005:l013","ordinal":288419,"en":"Her strength left her as she screamed;"},{"id":"semetey-2-2013:p1321:b005:l014","ordinal":288420,"en":"As she screamed, from her eyes"},{"id":"semetey-2-2013:p1321:b005:l015","ordinal":288421,"en":"Dark blood poured."},{"id":"semetey-2-2013:p1321:b005:l016","ordinal":288422,"en":"“My morning star!” she cried,"},{"id":"semetey-2-2013:p1321:b005:l017","ordinal":288423,"en":"“My only one!” she sobbed."},{"id":"semetey-2-2013:p1321:b005:l018","ordinal":288424,"en":"Her ribs seemed to split apart,"},{"id":"semetey-2-2013:p1321:b005:l019","ordinal":288425,"en":"And tears poured from her eyes."},{"id":"semetey-2-2013:p1321:b005:l020","ordinal":288426,"en":"The palace ridge where she stood"},{"id":"semetey-2-2013:p1321:b005:l021","ordinal":288427,"en":"Was washed by the tears from both eyes,"},{"id":"semetey-2-2013:p1321:b005:l022","ordinal":288428,"en":"Which spread like a flood into a pool."},{"id":"semetey-2-2013:p1321:b005:l023","ordinal":288429,"en":"Your noble mother Kanykei"},{"id":"semetey-2-2013:p1321:b005:l024","ordinal":288430,"en":"Sobbed, “My dear foal!”"},{"id":"semetey-2-2013:p1321:b005:l025","ordinal":288431,"en":"And cried, “My cherished one!”"},{"id":"semetey-2-2013:p1321:b005:l026","ordinal":288432,"en":"Calling him her ash-gray camel calf, she sobbed:"},{"id":"semetey-2-2013:p1321:b005:l027","ordinal":288433,"en":"“Late in life I braided my hair,"},{"id":"semetey-2-2013:p1321:b005:l028","ordinal":288434,"en":"After long yearning I saw your face."},{"id":"semetey-2-2013:p1321:b005:l029","ordinal":288435,"en":"Now before my eyes"},{"id":"semetey-2-2013:p1321:b005:l030","ordinal":288436,"en":"Lies only pitch-black night."},{"id":"semetey-2-2013:p1321:b005:l031","ordinal":288437,"en":"My sole hope and support—"},{"id":"semetey-2-2013:p1321:b005:l032","ordinal":288438,"en":"Whom have I besides you?”"},{"id":"semetey-2-2013:p1321:b005:l033","ordinal":288439,"en":"Thus Kanykei"},{"id":"semetey-2-2013:p1321:b005:l034","ordinal":288440,"en":"Stood weeping in anguish,"},{"id":"semetey-2-2013:p1321:b005:l035","ordinal":288441,"en":"Lamenting and sobbing,"},{"id":"semetey-2-2013:p1321:b005:l036","ordinal":288442,"en":"Unable to catch her breath."},{"id":"semetey-2-2013:p1321:b005:l037","ordinal":288443,"en":"If he was dead, he was not in the grave;"},{"id":"semetey-2-2013:p1321:b005:l038","ordinal":288444,"en":"If alive, he was nowhere among the living."},{"id":"semetey-2-2013:p1321:b005:l039","ordinal":288445,"en":"Exhausted by grief, bleeding,"},{"id":"semetey-2-2013:p1322:b003:l001","ordinal":288446,"en":"Her strength left Kanykei;"},{"id":"semetey-2-2013:p1322:b003:l002","ordinal":288447,"en":"She lost consciousness,"},{"id":"semetey-2-2013:p1322:b003:l003","ordinal":288448,"en":"Her face turned ashen,"},{"id":"semetey-2-2013:p1322:b003:l004","ordinal":288449,"en":"And unable to stand, she fell,"},{"id":"semetey-2-2013:p1322:b003:l005","ordinal":288450,"en":"Lying there insensible."},{"id":"semetey-2-2013:p1322:b003:l006","ordinal":288451,"en":"When Kanykei's voice was heard,"},{"id":"semetey-2-2013:p1322:b003:l007","ordinal":288452,"en":"The birch grieved and the willow wept,"},{"id":"semetey-2-2013:p1322:b003:l008","ordinal":288453,"en":"And all the gathered people wept."},{"id":"semetey-2-2013:p1322:b003:l009","ordinal":288454,"en":"Every nose steamed with breath,"},{"id":"semetey-2-2013:p1322:b003:l010","ordinal":288455,"en":"The heroes raised a great clamor,"},{"id":"semetey-2-2013:p1322:b003:l011","ordinal":288456,"en":"All the people were in uproar;"},{"id":"semetey-2-2013:p1322:b003:l012","ordinal":288457,"en":"The earth shook and stones wept,"},{"id":"semetey-2-2013:p1322:b003:l013","ordinal":288458,"en":"The chiefs of all the Kyrgyz wept,"},{"id":"semetey-2-2013:p1322:b003:l014","ordinal":288459,"en":"The deep earth beneath them wept,"},{"id":"semetey-2-2013:p1322:b003:l015","ordinal":288460,"en":"And the warriors, led by Akjoltoi, wept."},{"id":"semetey-2-2013:p1322:b003:l016","ordinal":288461,"en":"Have you heard the tale from long ago"},{"id":"semetey-2-2013:p1322:b003:l017","ordinal":288462,"en":"Of the creature found by providence"},{"id":"semetey-2-2013:p1322:b003:l018","ordinal":288463,"en":"In the desert of Media"},{"id":"semetey-2-2013:p1322:b003:l019","ordinal":288464,"en":"And brought to Khan Manas—"},{"id":"semetey-2-2013:p1322:b003:l020","ordinal":288465,"en":"Kumaiyk, born of royal stock?"},{"id":"semetey-2-2013:p1322:b003:l021","ordinal":288466,"en":"Opening his mouth, he howled,"},{"id":"semetey-2-2013:p1322:b003:l022","ordinal":288467,"en":"And bayed in mourning;"},{"id":"semetey-2-2013:p1322:b003:l023","ordinal":288468,"en":"Parted from Semetey,"},{"id":"semetey-2-2013:p1322:b003:l024","ordinal":288469,"en":"The white sighthound met disaster."},{"id":"semetey-2-2013:p1322:b003:l025","ordinal":288470,"en":"Casting off his collar,"},{"id":"semetey-2-2013:p1322:b003:l026","ordinal":288471,"en":"The white hound vanished."},{"id":"semetey-2-2013:p1322:b003:l027","ordinal":288472,"en":"Black-eyed, with blue-gray legs,"},{"id":"semetey-2-2013:p1322:b003:l028","ordinal":288473,"en":"He tucked his wings and never stooped;"},{"id":"semetey-2-2013:p1322:b003:l029","ordinal":288474,"en":"His talons were iron, his jesses brass,"},{"id":"semetey-2-2013:p1322:b003:l030","ordinal":288475,"en":"He let no goose rise from a lake."},{"id":"semetey-2-2013:p1322:b003:l031","ordinal":288476,"en":"His wings spanned two fathoms,"},{"id":"semetey-2-2013:p1322:b003:l032","ordinal":288477,"en":"And nothing he struck escaped alive;"},{"id":"semetey-2-2013:p1322:b003:l033","ordinal":288478,"en":"He ate flesh upon his master's hand."},{"id":"semetey-2-2013:p1322:b003:l034","ordinal":288479,"en":"His steel pinions flashed pale;"},{"id":"semetey-2-2013:p1322:b003:l035","ordinal":288480,"en":"When he coursed at game,"},{"id":"semetey-2-2013:p1322:b003:l036","ordinal":288481,"en":"He fulfilled every true desire."},{"id":"semetey-2-2013:p1322:b003:l037","ordinal":288482,"en":"With silken leash and golden anklet,"},{"id":"semetey-2-2013:p1322:b003:l038","ordinal":288483,"en":"The peerless white falcon Akshumkar"},{"id":"semetey-2-2013:p1322:b003:l039","ordinal":288484,"en":"Beat his wings at any living prey;"},{"id":"semetey-2-2013:p1322:b004:l001","ordinal":288485,"en":"When his gray-maned master flew him,"},{"id":"semetey-2-2013:p1322:b004:l002","ordinal":288486,"en":"He carried nine bustards at a time."},{"id":"semetey-2-2013:p1322:b004:l003","ordinal":288487,"en":"A saker falcon thirsted for his head,"},{"id":"semetey-2-2013:p1322:b004:l004","ordinal":288488,"en":"And brought the bird to Semetey;"},{"id":"semetey-2-2013:p1322:b004:l005","ordinal":288489,"en":"He was raised in the royal mews."},{"id":"semetey-2-2013:p1322:b004:l006","ordinal":288490,"en":"“This must be a portent,”"},{"id":"semetey-2-2013:p1322:b004:l007","ordinal":288491,"en":"Khan Bakai judged and approved him."},{"id":"semetey-2-2013:p1322:b004:l008","ordinal":288492,"en":"He had gold set on his collar;"},{"id":"semetey-2-2013:p1322:b004:l009","ordinal":288493,"en":"When urged, he danced upon the hand,"},{"id":"semetey-2-2013:p1322:b004:l010","ordinal":288494,"en":"And when this eagle soared,"},{"id":"semetey-2-2013:p1322:b004:l011","ordinal":288495,"en":"He left no creature alive."},{"id":"semetey-2-2013:p1322:b004:l012","ordinal":288496,"en":"When he drove straight at prey,"},{"id":"semetey-2-2013:p1322:b004:l013","ordinal":288497,"en":"His eyes saw it from afar."},{"id":"semetey-2-2013:p1322:b004:l014","ordinal":288498,"en":"He wheeled upon anything flying true,"},{"id":"semetey-2-2013:p1322:b004:l015","ordinal":288499,"en":"Never settling straight, but sweeping wide;"},{"id":"semetey-2-2013:p1322:b004:l016","ordinal":288500,"en":"The one who flew him rejoiced."},{"id":"semetey-2-2013:p1322:b004:l017","ordinal":288501,"en":"When the falcon drove head-on,"},{"id":"semetey-2-2013:p1322:b004:l018","ordinal":288502,"en":"No living thing remained unfallen."},{"id":"semetey-2-2013:p1322:b004:l019","ordinal":288503,"en":"Such was the white falcon you would see—"},{"id":"semetey-2-2013:p1322:b004:l020","ordinal":288504,"en":"A bird to cast loose,"},{"id":"semetey-2-2013:p1322:b004:l021","ordinal":288505,"en":"Semetey's own treasured possession."},{"id":"semetey-2-2013:p1322:b004:l022","ordinal":288506,"en":"Mourning, the white falcon"},{"id":"semetey-2-2013:p1322:b004:l023","ordinal":288507,"en":"Twisted and cried harshly,"},{"id":"semetey-2-2013:p1322:b004:l024","ordinal":288508,"en":"Clawed and tore at his own legs,"},{"id":"semetey-2-2013:p1322:b004:l025","ordinal":288509,"en":"And struck against his hood."},{"id":"semetey-2-2013:p1322:b004:l026","ordinal":288510,"en":"When a hand was raised, he refused food;"},{"id":"semetey-2-2013:p1322:b004:l027","ordinal":288511,"en":"Deep in mourning,"},{"id":"semetey-2-2013:p1322:b004:l028","ordinal":288512,"en":"He tore the feathers from his breast—"}]
