[{"id":"manas-2010:p1245:b001:l020","ordinal":54017,"en":"‘Amid this battle,"},{"id":"manas-2010:p1245:b001:l021","ordinal":54018,"en":"I am left alone; what can I do?"},{"id":"manas-2010:p1245:b001:l022","ordinal":54019,"en":"I, Syrgak, have no luck!"},{"id":"manas-2010:p1245:b001:l023","ordinal":54020,"en":"He went driving away the horses;"},{"id":"manas-2010:p1245:b001:l024","ordinal":54021,"en":"The lion Almambet is absent too.’"},{"id":"manas-2010:p1245:b001:l025","ordinal":54022,"en":"Raging, Khan Syrgak"},{"id":"manas-2010:p1245:b001:l026","ordinal":54023,"en":"Reached Ylama."},{"id":"manas-2010:p1245:b001:l027","ordinal":54024,"en":"The mighty fighter Ylama,"},{"id":"manas-2010:p1245:b001:l028","ordinal":54025,"en":"From atop Bozkertik,"},{"id":"manas-2010:p1245:b001:l029","ordinal":54026,"en":"He knocked flying as he passed."},{"id":"manas-2010:p1245:b001:l030","ordinal":54027,"en":"Before he could reach him and cut off his head,"},{"id":"manas-2010:p1245:b001:l031","ordinal":54028,"en":"The forty nobles beside him"},{"id":"manas-2010:p1245:b001:l032","ordinal":54029,"en":"Crowded round and mounted him,"},{"id":"manas-2010:p1245:b001:l033","ordinal":54030,"en":"And took him away unharmed."},{"id":"manas-2010:p1245:b001:l034","ordinal":54031,"en":"Seeing the multitude of Chinese,"},{"id":"manas-2010:p1245:b001:l035","ordinal":54032,"en":"Hero Syrgak, born a leopard,"},{"id":"manas-2010:p1245:b001:l036","ordinal":54033,"en":"Despaired of his single life."},{"id":"manas-2010:p1245:b001:l037","ordinal":54034,"en":"‘Why should I stay alive?"},{"id":"manas-2010:p1245:b001:l038","ordinal":54035,"en":"For the mighty army behind me,"},{"id":"manas-2010:p1245:b001:l039","ordinal":54036,"en":"Let me give myself in sacrifice!"},{"id":"manas-2010:p1245:b001:l040","ordinal":54037,"en":"Why should I stay alive?"},{"id":"manas-2010:p1245:b001:l041","ordinal":54038,"en":"Risking my own head in battle,"},{"id":"manas-2010:p1245:b001:l042","ordinal":54039,"en":"Struggling against the infidel,"},{"id":"manas-2010:p1246:b001:l001","ordinal":54040,"en":"Let me bring him to his end!’"},{"id":"manas-2010:p1246:b001:l002","ordinal":54041,"en":"Saying this, hero Syrgak"},{"id":"manas-2010:p1246:b001:l003","ordinal":54042,"en":"Entered deep into the army."},{"id":"manas-2010:p1246:b001:l004","ordinal":54043,"en":"When Syrgak entered among them,"},{"id":"manas-2010:p1246:b001:l005","ordinal":54044,"en":"When he struck in fury,"},{"id":"manas-2010:p1246:b001:l006","ordinal":54045,"en":"Their fangs jutting out,"},{"id":"manas-2010:p1246:b001:l007","ordinal":54046,"en":"Dead horses formed a mountain;"},{"id":"manas-2010:p1246:b001:l008","ordinal":54047,"en":"Their mustaches twisted,"},{"id":"manas-2010:p1246:b001:l009","ordinal":54048,"en":"Dead heroes lay in heaps."},{"id":"manas-2010:p1246:b001:l010","ordinal":54049,"en":"Fighting without sparing his life,"},{"id":"manas-2010:p1246:b001:l011","ordinal":54050,"en":"While he grappled with them,"},{"id":"manas-2010:p1246:b001:l012","ordinal":54051,"en":"Azizkan's only son—"},{"id":"manas-2010:p1246:b001:l013","ordinal":54052,"en":"Was he not worrying?"},{"id":"manas-2010:p1246:b001:l014","ordinal":54053,"en":"When, toward the vast Chinese army,"},{"id":"manas-2010:p1246:b001:l015","ordinal":54054,"en":"Syrgak had turned back,"},{"id":"manas-2010:p1246:b001:l016","ordinal":54055,"en":"‘What has happened?’ Taking his spyglass,"},{"id":"manas-2010:p1246:b001:l017","ordinal":54056,"en":"Climbing onto a ridge,"},{"id":"manas-2010:p1246:b001:l018","ordinal":54057,"en":"Was he not watching?"},{"id":"manas-2010:p1246:b001:l019","ordinal":54058,"en":"‘My leopard, gray-maned Syrgak,"},{"id":"manas-2010:p1246:b001:l020","ordinal":54059,"en":"He was truly a gray-maned hero."},{"id":"manas-2010:p1246:b001:l021","ordinal":54060,"en":"This very year, my Syrgak"},{"id":"manas-2010:p1246:b001:l022","ordinal":54061,"en":"Was twenty years old."},{"id":"manas-2010:p1246:b001:l023","ordinal":54062,"en":"He was in fighting trim,"},{"id":"manas-2010:p1246:b001:l024","ordinal":54063,"en":"At the height of his spirit,"},{"id":"manas-2010:p1246:b001:l025","ordinal":54064,"en":"Never retreating from the enemy,"},{"id":"manas-2010:p1246:b001:l026","ordinal":54065,"en":"He was of the leopard's breed."},{"id":"manas-2010:p1246:b001:l027","ordinal":54066,"en":"Alöökö's son Kongurbay"},{"id":"manas-2010:p1246:b001:l028","ordinal":54067,"en":"Was at the height of his strength this year.’"},{"id":"manas-2010:p1246:b001:l029","ordinal":54068,"en":"Saying this, Almambet"},{"id":"manas-2010:p1246:b001:l030","ordinal":54069,"en":"Stood watching Syrgak."},{"id":"manas-2010:p1246:b001:l031","ordinal":54070,"en":"With Kongurbay at their head,"},{"id":"manas-2010:p1246:b001:l032","ordinal":54071,"en":"The Chinese had brought torment upon him."},{"id":"manas-2010:p1246:b001:l033","ordinal":54072,"en":"Preparing to bind him,"},{"id":"manas-2010:p1246:b001:l034","ordinal":54073,"en":"All the Chinese swarming,"},{"id":"manas-2010:p1246:b001:l035","ordinal":54074,"en":"They had surrounded Syrgak."},{"id":"manas-2010:p1246:b001:l036","ordinal":54075,"en":"‘Perish, you and your horses!"},{"id":"manas-2010:p1246:b001:l037","ordinal":54076,"en":"Driving horses before me,"},{"id":"manas-2010:p1246:b001:l038","ordinal":54077,"en":"What wish shall I fulfill?"},{"id":"manas-2010:p1246:b001:l039","ordinal":54078,"en":"If my death has come, I shall die."},{"id":"manas-2010:p1246:b001:l040","ordinal":54079,"en":"If my death has not yet come,"},{"id":"manas-2010:p1246:b001:l041","ordinal":54080,"en":"Let me turn back and charge,"},{"id":"manas-2010:p1246:b001:l042","ordinal":54081,"en":"Let me spill the infidel's blood!"},{"id":"manas-2010:p1247:b001:l001","ordinal":54082,"en":"To Syrgak standing there,"},{"id":"manas-2010:p1247:b001:l002","ordinal":54083,"en":"Let me give my support!’"},{"id":"manas-2010:p1247:b001:l003","ordinal":54084,"en":"Having said this, Almambet—"},{"id":"manas-2010:p1247:b001:l004","ordinal":54085,"en":"Sarala with his lean, cow-like rump,"},{"id":"manas-2010:p1247:b001:l005","ordinal":54086,"en":"Shattering the face of the earth—"},{"id":"manas-2010:p1247:b001:l006","ordinal":54087,"en":"Almambet upon Sarala"},{"id":"manas-2010:p1247:b001:l007","ordinal":54088,"en":"Came racing along."},{"id":"manas-2010:p1247:b001:l008","ordinal":54089,"en":"In his haste, Almambet"},{"id":"manas-2010:p1247:b001:l009","ordinal":54090,"en":"Whipped him right and left,"},{"id":"manas-2010:p1247:b001:l010","ordinal":54091,"en":"Spurred him this way and that."},{"id":"manas-2010:p1247:b001:l011","ordinal":54092,"en":"Sarala beneath him"},{"id":"manas-2010:p1247:b001:l012","ordinal":54093,"en":"Surged forward, black all over;"},{"id":"manas-2010:p1247:b001:l013","ordinal":54094,"en":"His dear head like a roe deer's"},{"id":"manas-2010:p1247:b001:l014","ordinal":54095,"en":"Was shrouded in black dust."},{"id":"manas-2010:p1247:b001:l015","ordinal":54096,"en":"Your Alake came roaring,"},{"id":"manas-2010:p1247:b001:l016","ordinal":54097,"en":"Calling, ‘Dear Syrgak!’"},{"id":"manas-2010:p1247:b001:l017","ordinal":54098,"en":"The infidels surrounding him,"},{"id":"manas-2010:p1247:b001:l018","ordinal":54099,"en":"He tossed about with Sarala."},{"id":"manas-2010:p1247:b001:l019","ordinal":54100,"en":"The infidels, like ants,"},{"id":"manas-2010:p1247:b001:l020","ordinal":54101,"en":"Your Alake sent crawling."},{"id":"manas-2010:p1247:b001:l021","ordinal":54102,"en":"Through their center, your Alake"},{"id":"manas-2010:p1247:b001:l022","ordinal":54103,"en":"Came carving a way;"},{"id":"manas-2010:p1247:b001:l023","ordinal":54104,"en":"Around their edges, dear Syrgak"},{"id":"manas-2010:p1247:b001:l024","ordinal":54105,"en":"Came slaughtering them."},{"id":"manas-2010:p1247:b001:l025","ordinal":54106,"en":"Almambet and Syrgak joined together;"},{"id":"manas-2010:p1247:b001:l026","ordinal":54107,"en":"When they fought without restraint,"},{"id":"manas-2010:p1247:b001:l027","ordinal":54108,"en":"Look at the dust flying in a haze!"},{"id":"manas-2010:p1247:b001:l028","ordinal":54109,"en":"Look at the many dead souls!"},{"id":"manas-2010:p1247:b001:l029","ordinal":54110,"en":"Among those souls,"},{"id":"manas-2010:p1247:b001:l030","ordinal":54111,"en":"Look at the black blood, horse-chest deep!"},{"id":"manas-2010:p1247:b001:l031","ordinal":54112,"en":"When one infidel died,"},{"id":"manas-2010:p1247:b001:l032","ordinal":54113,"en":"A thousand swarmed back in;"},{"id":"manas-2010:p1247:b001:l033","ordinal":54114,"en":"Look at the lives flooding over them!"},{"id":"manas-2010:p1247:b001:l034","ordinal":54115,"en":"Look at the grass upon the earth!"},{"id":"manas-2010:p1247:b001:l035","ordinal":54116,"en":"Look at the Chinese, numerous as grass!"},{"id":"manas-2010:p1247:b001:l036","ordinal":54117,"en":"Look at the ants, look at the worms!"},{"id":"manas-2010:p1247:b001:l037","ordinal":54118,"en":"Look at the Chinese, numerous as worms!"},{"id":"manas-2010:p1247:b001:l038","ordinal":54119,"en":"Look at the great ditch they dug!"},{"id":"manas-2010:p1247:b001:l039","ordinal":54120,"en":"Look at the misery they have stirred!"},{"id":"manas-2010:p1247:b001:l040","ordinal":54121,"en":"Hearing the news, from Beijing,"},{"id":"manas-2010:p1247:b001:l041","ordinal":54122,"en":"Anew, all over again,"},{"id":"manas-2010:p1247:b001:l042","ordinal":54123,"en":"Look at the huge Chinese force swarming in!"},{"id":"manas-2010:p1248:b001:l001","ordinal":54124,"en":"Steeped in blood upon blood,"},{"id":"manas-2010:p1248:b001:l002","ordinal":54125,"en":"The gray-maned heroes, born leopards,"},{"id":"manas-2010:p1248:b001:l003","ordinal":54126,"en":"Entered and fought without fleeing."},{"id":"manas-2010:p1248:b001:l004","ordinal":54127,"en":"They took no rest at night;"},{"id":"manas-2010:p1248:b001:l005","ordinal":54128,"en":"They did not lie idle by day."},{"id":"manas-2010:p1248:b001:l006","ordinal":54129,"en":"Fighting day and night,"},{"id":"manas-2010:p1248:b001:l007","ordinal":54130,"en":"Battling with all their strength,"},{"id":"manas-2010:p1248:b001:l008","ordinal":54131,"en":"Leveling the face of the earth,"},{"id":"manas-2010:p1248:b001:l009","ordinal":54132,"en":"The Chinese swarming over the land,"},{"id":"manas-2010:p1248:b001:l010","ordinal":54133,"en":"With fluttering banners,"},{"id":"manas-2010:p1248:b001:l011","ordinal":54134,"en":"With armies covering the land,"},{"id":"manas-2010:p1248:b001:l012","ordinal":54135,"en":"Filled the face of the earth."},{"id":"manas-2010:p1248:b001:l013","ordinal":54136,"en":"Renowned Manas was not here."},{"id":"manas-2010:p1248:b001:l014","ordinal":54137,"en":"The multitude of Chinese seemed"},{"id":"manas-2010:p1248:b001:l015","ordinal":54138,"en":"About to deny the champions escape."},{"id":"manas-2010:p1248:b001:l016","ordinal":54139,"en":"When he knew they could not escape,"},{"id":"manas-2010:p1248:b001:l017","ordinal":54140,"en":"When the Chinese, numerous as sand,"},{"id":"manas-2010:p1248:b001:l018","ordinal":54141,"en":"Kept swarming in,"},{"id":"manas-2010:p1248:b001:l019","ordinal":54142,"en":"Sarala, whom he rode to war—"},{"id":"manas-2010:p1248:b001:l020","ordinal":54143,"en":"Had he not trained him before entering?"},{"id":"manas-2010:p1248:b001:l021","ordinal":54144,"en":"Six thousand boys had gone together;"},{"id":"manas-2010:p1248:b001:l022","ordinal":54145,"en":"When six thousand boys went,"},{"id":"manas-2010:p1248:b001:l023","ordinal":54146,"en":"Six boys had gone together,"},{"id":"manas-2010:p1248:b001:l024","ordinal":54147,"en":"And stratagems and wisdom,"},{"id":"manas-2010:p1248:b001:l025","ordinal":54148,"en":"Had he not studied and returned?"},{"id":"manas-2010:p1248:b001:l026","ordinal":54149,"en":"That the Chinese would act this way,"},{"id":"manas-2010:p1248:b001:l027","ordinal":54150,"en":"Had he not known before coming?"},{"id":"manas-2010:p1248:b001:l028","ordinal":54151,"en":"Karykan's sleeveless fur coat,"},{"id":"manas-2010:p1248:b001:l029","ordinal":54152,"en":"And Esenkan's weather-conjuring"},{"id":"manas-2010:p1248:b001:l030","ordinal":54153,"en":"Magic stone,"},{"id":"manas-2010:p1248:b001:l031","ordinal":54154,"en":"As gifts from Beijing,"},{"id":"manas-2010:p1248:b001:l032","ordinal":54155,"en":"Almambet, born a champion,"},{"id":"manas-2010:p1248:b001:l033","ordinal":54156,"en":"Setting forth from the very beginning,"},{"id":"manas-2010:p1248:b001:l034","ordinal":54157,"en":"Had he not brought them with him?"},{"id":"manas-2010:p1248:b001:l035","ordinal":54158,"en":"Esenkan's sleeveless fur coat,"},{"id":"manas-2010:p1248:b001:l036","ordinal":54159,"en":"He shook it by the collar."},{"id":"manas-2010:p1248:b001:l037","ordinal":54160,"en":"Karykan's weather stone,"},{"id":"manas-2010:p1248:b001:l038","ordinal":54161,"en":"Taking it, Almambet"},{"id":"manas-2010:p1248:b001:l039","ordinal":54162,"en":"Placed it in the spring-fed stream."},{"id":"manas-2010:p1248:b001:l040","ordinal":54163,"en":"When he put it in the stream,"},{"id":"manas-2010:p1248:b001:l041","ordinal":54164,"en":"When Almambet worked his weather magic,"},{"id":"manas-2010:p1248:b001:l042","ordinal":54165,"en":"Clouds came sweeping from the sky;"},{"id":"manas-2010:p1249:b001:l001","ordinal":54166,"en":"Clouds crowded down upon the earth."},{"id":"manas-2010:p1249:b001:l002","ordinal":54167,"en":"The sun unseen, twilight fell;"},{"id":"manas-2010:p1249:b001:l003","ordinal":54168,"en":"The moon unseen, a dim light flickered."},{"id":"manas-2010:p1249:b001:l004","ordinal":54169,"en":"Rain fell throughout the lowlands;"},{"id":"manas-2010:p1249:b001:l005","ordinal":54170,"en":"Hail fell throughout the foothills;"},{"id":"manas-2010:p1249:b001:l006","ordinal":54171,"en":"Snow covered the mountain peaks;"},{"id":"manas-2010:p1249:b001:l007","ordinal":54172,"en":"Wild beasts were penned in the forest."},{"id":"manas-2010:p1249:b001:l008","ordinal":54173,"en":"Lightning struck all the dry stalks;"},{"id":"manas-2010:p1249:b001:l009","ordinal":54174,"en":"All the grass rustled,"},{"id":"manas-2010:p1249:b001:l010","ordinal":54175,"en":"Sleet fell and turned to ice;"},{"id":"manas-2010:p1249:b001:l011","ordinal":54176,"en":"The summer day became winter."},{"id":"manas-2010:p1249:b001:l012","ordinal":54177,"en":"The many Chinese in thin clothes,"},{"id":"manas-2010:p1249:b001:l013","ordinal":54178,"en":"Unable to bear the cold,"},{"id":"manas-2010:p1249:b001:l014","ordinal":54179,"en":"Became whimpering girls."},{"id":"manas-2010:p1249:b001:l015","ordinal":54180,"en":"Huddled like goats,"},{"id":"manas-2010:p1249:b001:l016","ordinal":54181,"en":"Their faces pinched,"},{"id":"manas-2010:p1249:b001:l017","ordinal":54182,"en":"As the Chinese stood shivering,"},{"id":"manas-2010:p1249:b001:l018","ordinal":54183,"en":"Almambet and Syrgak, their names in rhyme,"},{"id":"manas-2010:p1249:b001:l019","ordinal":54184,"en":"Fought without restraint."},{"id":"manas-2010:p1249:b001:l020","ordinal":54185,"en":"Throwing away their lives, the two lions"},{"id":"manas-2010:p1249:b001:l021","ordinal":54186,"en":"Fought without sparing themselves;"},{"id":"manas-2010:p1249:b001:l022","ordinal":54187,"en":"Making red blood flow,"},{"id":"manas-2010:p1249:b001:l023","ordinal":54188,"en":"They slaughtered the Chinese."},{"id":"manas-2010:p1249:b001:l024","ordinal":54189,"en":"From the flank, Syrgak roared;"},{"id":"manas-2010:p1249:b001:l025","ordinal":54190,"en":"Into their center, Almambet"},{"id":"manas-2010:p1249:b001:l026","ordinal":54191,"en":"Drove them, crushing them down."},{"id":"manas-2010:p1249:b001:l027","ordinal":54192,"en":"Churning with his spear,"},{"id":"manas-2010:p1249:b001:l028","ordinal":54193,"en":"He entered, destroying the Chinese."},{"id":"manas-2010:p1249:b001:l029","ordinal":54194,"en":"Kürpüldök's Sary-Suu—"},{"id":"manas-2010:p1249:b001:l030","ordinal":54195,"en":"Along that river's banks,"},{"id":"manas-2010:p1249:b001:l031","ordinal":54196,"en":"He drove the Chinese before him."},{"id":"manas-2010:p1249:b001:l032","ordinal":54197,"en":"All crowded into the water,"},{"id":"manas-2010:p1249:b001:l033","ordinal":54198,"en":"When the Chinese entered,"},{"id":"manas-2010:p1249:b001:l034","ordinal":54199,"en":"Their fangs jutting out,"},{"id":"manas-2010:p1249:b001:l035","ordinal":54200,"en":"Dead horses formed a mountain;"},{"id":"manas-2010:p1249:b001:l036","ordinal":54201,"en":"Their mustaches twisted,"},{"id":"manas-2010:p1249:b001:l037","ordinal":54202,"en":"Dead heroes lay in heaps."},{"id":"manas-2010:p1249:b001:l038","ordinal":54203,"en":"Seeing this slaughter,"},{"id":"manas-2010:p1249:b001:l039","ordinal":54204,"en":"Surging up from their depths,"},{"id":"manas-2010:p1249:b001:l040","ordinal":54205,"en":"The Chinese stirred in vast hosts."},{"id":"manas-2010:p1249:b001:l041","ordinal":54206,"en":"The news had reached"},{"id":"manas-2010:p1249:b001:l042","ordinal":54207,"en":"Their khan Karykan."},{"id":"manas-2010:p1250:b001:l001","ordinal":54208,"en":"They spread the news far and wide,"},{"id":"manas-2010:p1250:b001:l002","ordinal":54209,"en":"Throughout Kakan-Chin."},{"id":"manas-2010:p1250:b001:l003","ordinal":54210,"en":"From all Chinese Beijing,"},{"id":"manas-2010:p1250:b001:l004","ordinal":54211,"en":"From the land of the one-eyed people,"},{"id":"manas-2010:p1250:b001:l005","ordinal":54212,"en":"More had come."},{"id":"manas-2010:p1250:b001:l006","ordinal":54213,"en":"Those who would let neither people nor beasts,"},{"id":"manas-2010:p1250:b001:l007","ordinal":54214,"en":"Nor even winged creatures escape,"},{"id":"manas-2010:p1250:b001:l008","ordinal":54215,"en":"Had come as well."},{"id":"manas-2010:p1250:b001:l009","ordinal":54216,"en":"When one infidel died,"},{"id":"manas-2010:p1250:b001:l010","ordinal":54217,"en":"A thousand came in his place."},{"id":"manas-2010:p1250:b001:l011","ordinal":54218,"en":"Gathering his strength,"},{"id":"manas-2010:p1250:b001:l012","ordinal":54219,"en":"The trick rider, the swift runner,"},{"id":"manas-2010:p1250:b001:l013","ordinal":54220,"en":"Who came out when the Chinese rose,"},{"id":"manas-2010:p1250:b001:l014","ordinal":54221,"en":"With his foot marksmen streaming behind,"},{"id":"manas-2010:p1250:b001:l015","ordinal":54222,"en":"Karazhoy had arrived."},{"id":"manas-2010:p1250:b001:l016","ordinal":54223,"en":"The Chinese, detachment by detachment,"},{"id":"manas-2010:p1250:b001:l017","ordinal":54224,"en":"Came without breaking formation."},{"id":"manas-2010:p1250:b001:l018","ordinal":54225,"en":"The mighty army arranged itself;"},{"id":"manas-2010:p1250:b001:l019","ordinal":54226,"en":"They came in order."},{"id":"manas-2010:p1250:b001:l020","ordinal":54227,"en":"From the finest spearmen,"},{"id":"manas-2010:p1250:b001:l021","ordinal":54228,"en":"He set the mighty fighters apart."},{"id":"manas-2010:p1250:b001:l022","ordinal":54229,"en":"Among those counted ordinary,"},{"id":"manas-2010:p1250:b001:l023","ordinal":54230,"en":"He set the rest apart,"},{"id":"manas-2010:p1250:b001:l024","ordinal":54231,"en":"Sent them into the It-Ölbös desert."},{"id":"manas-2010:p1250:b001:l025","ordinal":54232,"en":"He set his chosen marksmen apart;"},{"id":"manas-2010:p1250:b001:l026","ordinal":54233,"en":"With Karazhoy as their leader,"},{"id":"manas-2010:p1250:b001:l027","ordinal":54234,"en":"They gathered their fury."},{"id":"manas-2010:p1250:b001:l028","ordinal":54235,"en":"The bow-drawers all assembled,"},{"id":"manas-2010:p1250:b001:l029","ordinal":54236,"en":"Readying their quivers."},{"id":"manas-2010:p1250:b001:l030","ordinal":54237,"en":"Beneath the Chinese people's tread,"},{"id":"manas-2010:p1250:b001:l031","ordinal":54238,"en":"Not a speck of dust lay still."},{"id":"manas-2010:p1250:b001:l032","ordinal":54239,"en":"Almambet prayed for faith;"},{"id":"manas-2010:p1250:b001:l033","ordinal":54240,"en":"Hero Syrgak had no life left in him."},{"id":"manas-2010:p1250:b001:l034","ordinal":54241,"en":"‘Come, come, come!’"},{"id":"manas-2010:p1250:b001:l035","ordinal":54242,"en":"Calling ‘Come!’ as their battle cry,"},{"id":"manas-2010:p1250:b001:l036","ordinal":54243,"en":"The multitude of Chinese came from the foothills,"},{"id":"manas-2010:p1250:b001:l037","ordinal":54244,"en":"Flooding over them like a lake."},{"id":"manas-2010:p1250:b001:l038","ordinal":54245,"en":"‘Hail, hail, hail!’ they cried,"},{"id":"manas-2010:p1250:b001:l039","ordinal":54246,"en":"Calling ‘Hail!’ as their battle cry."},{"id":"manas-2010:p1250:b001:l040","ordinal":54247,"en":"With Khan Zholoy at their head,"},{"id":"manas-2010:p1250:b001:l041","ordinal":54248,"en":"The mighty Kalmyk host from the flank"},{"id":"manas-2010:p1250:b001:l042","ordinal":54249,"en":"Charged in together,"},{"id":"manas-2010:p1251:b001:l001","ordinal":54250,"en":"When the Chinese charged in,"},{"id":"manas-2010:p1251:b001:l002","ordinal":54251,"en":"The Chinese peoples of twelve khans,"},{"id":"manas-2010:p1251:b001:l003","ordinal":54252,"en":"With Khan Kongurbay at their head,"},{"id":"manas-2010:p1251:b001:l004","ordinal":54253,"en":"When they came like this,"},{"id":"manas-2010:p1251:b001:l005","ordinal":54254,"en":"The two lions, bereft of a way out,"},{"id":"manas-2010:p1251:b001:l006","ordinal":54255,"en":"Were separated to either side."},{"id":"manas-2010:p1251:b001:l007","ordinal":54256,"en":"Hero Syrgak struggled;"},{"id":"manas-2010:p1251:b001:l008","ordinal":54257,"en":"The eye could not pick him out;"},{"id":"manas-2010:p1251:b001:l009","ordinal":54258,"en":"One could not tell where he was."},{"id":"manas-2010:p1251:b001:l010","ordinal":54259,"en":"He was parted from Almambet."},{"id":"manas-2010:p1251:b001:l011","ordinal":54260,"en":"Struggling for his life,"},{"id":"manas-2010:p1251:b001:l012","ordinal":54261,"en":"Shrouded in black dust,"},{"id":"manas-2010:p1251:b001:l013","ordinal":54262,"en":"Almambet was to grapple"},{"id":"manas-2010:p1251:b001:l014","ordinal":54263,"en":"With the renowned seven khans."},{"id":"manas-2010:p1251:b001:l015","ordinal":54264,"en":"With golden hair crest and tasseled belt,"},{"id":"manas-2010:p1251:b001:l016","ordinal":54265,"en":"Azizkan's hawk,"},{"id":"manas-2010:p1251:b001:l017","ordinal":54266,"en":"Who had fought so many battles before,"},{"id":"manas-2010:p1251:b001:l018","ordinal":54267,"en":"Had become an expert against the Chinese,"},{"id":"manas-2010:p1251:b001:l019","ordinal":54268,"en":"Poor champion Almambet."},{"id":"manas-2010:p1251:b001:l020","ordinal":54269,"en":"Sarala beneath him"},{"id":"manas-2010:p1251:b001:l021","ordinal":54270,"en":"Lowered his head toward the earth."},{"id":"manas-2010:p1251:b001:l022","ordinal":54271,"en":"Six thousand Chinese, a thousand governors,"},{"id":"manas-2010:p1251:b001:l023","ordinal":54272,"en":"Their elder Kongurbay,"}]
