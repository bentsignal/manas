[{"id":"sayakbay-ms-current143:pdf102:l015","ordinal":391169,"en":"They poured blood into clear water,"},{"id":"sayakbay-ms-current143:pdf102:l016","ordinal":391170,"en":"Raised dust in combat,"},{"id":"sayakbay-ms-current143:pdf102:l017","ordinal":391171,"en":"Played hopping games and ordo,"},{"id":"sayakbay-ms-current143:pdf102:l026","ordinal":391172,"en":"[On hearing their renowned names,]"},{"id":"sayakbay-ms-current143:pdf102:l028","ordinal":391173,"en":"Stayed in Kakan, not venturing out,"},{"id":"sayakbay-ms-current143:pdf102:l030","ordinal":391174,"en":"All the heroes gather,"},{"id":"sayakbay-ms-current143:pdf102:l031","ordinal":391175,"en":"The enemy’s path is closed,"},{"id":"sayakbay-ms-current143:pdf102:l033","ordinal":391176,"en":"[For Seytek, the dark hour—]"},{"id":"sayakbay-ms-current143:pdf103:l001","ordinal":391177,"en":"No enemy remained to confront them,"},{"id":"sayakbay-ms-current143:pdf103:l002","ordinal":391178,"en":"Once, throughout the wide world,"},{"id":"sayakbay-ms-current143:pdf103:l004","ordinal":391179,"en":"At the court with steel gates,"},{"id":"sayakbay-ms-current143:pdf103:l011","ordinal":391180,"en":"This palace of abundant delights,"},{"id":"sayakbay-ms-current143:pdf103:l018","ordinal":391181,"en":"Baimyrza and Akjoltoi,"},{"id":"sayakbay-ms-current143:pdf103:l028","ordinal":391182,"en":"Sweat trickling from their brows,"},{"id":"sayakbay-ms-current143:pdf103:l030","ordinal":391183,"en":"Drinking arak [in great draughts],"},{"id":"sayakbay-ms-current143:pdf103:l032","ordinal":391184,"en":"Then those lions,"},{"id":"sayakbay-ms-current143:pdf103:l034","ordinal":391185,"en":"Plunged into uproar,"},{"id":"sayakbay-ms-current143:pdf104:l007","ordinal":391186,"en":"“This Seitek's good fortune,"},{"id":"sayakbay-ms-current143:pdf105:l004","ordinal":391187,"en":"The proud, cocklike hero,"},{"id":"sayakbay-ms-current143:pdf105:l021","ordinal":391188,"en":"“If such good fortune comes,” they said,"},{"id":"sayakbay-ms-current143:pdf105:l030","ordinal":391189,"en":"Two young men ran,"},{"id":"sayakbay-ms-current143:pdf106:l001","ordinal":391190,"en":"A white halter tied with ornamental knots,"},{"id":"sayakbay-ms-current143:pdf106:l010","ordinal":391191,"en":"They saddled it magnificently,"},{"id":"sayakbay-ms-current143:pdf106:l013","ordinal":391192,"en":"Almanbet, who had passed before,"},{"id":"sayakbay-ms-current143:pdf106:l019","ordinal":391193,"en":"If you ask about the white saddle frame,"},{"id":"sayakbay-ms-current143:pdf106:l021","ordinal":391194,"en":"Left no join ill-fitted,"},{"id":"sayakbay-ms-current143:pdf106:l026","ordinal":391195,"en":"Far from giving the saddle away,"},{"id":"sayakbay-ms-current143:pdf106:l031","ordinal":391196,"en":"So the rider's heart would be satisfied,"},{"id":"sayakbay-ms-current143:pdf106:l033","ordinal":391197,"en":"He had carved with ornament,"},{"id":"sayakbay-ms-current143:pdf107:l004","ordinal":391198,"en":"Astonished all the people,"},{"id":"sayakbay-ms-current143:pdf107:l013","ordinal":391199,"en":"Telling one another, “Go on,”"},{"id":"sayakbay-ms-current143:pdf107:l025","ordinal":391200,"en":"He took a spear with a handspan-long tip,"},{"id":"sayakbay-ms-current143:pdf107:l027","ordinal":391201,"en":"The people gathered in ranks,"},{"id":"sayakbay-ms-current143:pdf107:l028","ordinal":391202,"en":"Heading toward Bermet,"},{"id":"sayakbay-ms-current143:pdf107:l033","ordinal":391203,"en":"The six stewards tending the horses,"},{"id":"sayakbay-ms-current143:pdf108:l011","ordinal":391204,"en":"Unable to stay still, the heroes raced,"},{"id":"sayakbay-ms-current143:pdf108:l017","ordinal":391205,"en":"Charging and thrusting spears,"},{"id":"sayakbay-ms-current143:pdf108:l023","ordinal":391206,"en":"[By the hems of their coats,]"},{"id":"sayakbay-ms-current143:pdf108:l025","ordinal":391207,"en":"Chasing and shooting wild asses,"},{"id":"sayakbay-ms-current143:pdf108:l026","ordinal":391208,"en":"[How,]"},{"id":"sayakbay-ms-current143:pdf108:l030","ordinal":391209,"en":"This fleeting world's life,"},{"id":"sayakbay-ms-current143:pdf108:l031","ordinal":391210,"en":"Passing it in enjoyment,"},{"id":"sayakbay-ms-current143:pdf109:l012","ordinal":391211,"en":"They camped in that broad valley,"},{"id":"sayakbay-ms-current143:pdf109:l022","ordinal":391212,"en":"A sorrowful mortal softened to tears,"},{"id":"sayakbay-ms-current143:pdf109:l023","ordinal":391213,"en":"Wild predators dwelt there,"},{"id":"sayakbay-ms-current143:pdf109:l024","ordinal":391214,"en":"No mortal had ever come there,"},{"id":"sayakbay-ms-current143:pdf109:l025","ordinal":391215,"en":"Birches grew thick, making a shelter,"},{"id":"sayakbay-ms-current143:pdf109:l031","ordinal":391216,"en":"Shelducks and geese mingled,"},{"id":"sayakbay-ms-current143:pdf109:l036","ordinal":391217,"en":"[Katiyuu], monkeys, and butterflies,"},{"id":"sayakbay-ms-current143:pdf109:l037","ordinal":391218,"en":"Filled its forest."},{"id":"sayakbay-ms-current143:pdf110:l006","ordinal":391219,"en":"When a startled deer leaped away,"},{"id":"sayakbay-ms-current143:pdf110:l011","ordinal":391220,"en":"Its great hares like wild asses,"},{"id":"sayakbay-ms-current143:pdf110:l014","ordinal":391221,"en":"Had created them in every form,"},{"id":"sayakbay-ms-current143:pdf110:l016","ordinal":391222,"en":"[There is a tiger,]"},{"id":"sayakbay-ms-current143:pdf110:l019","ordinal":391223,"en":"Shooting and butchering deer,"},{"id":"sayakbay-ms-current143:pdf110:l022","ordinal":391224,"en":"The pleasures of their hunting,"},{"id":"sayakbay-ms-current143:pdf110:l024","ordinal":391225,"en":"Such was the delight of hunting,"},{"id":"sayakbay-ms-current143:pdf111:l005","ordinal":391226,"en":"Almighty God [had bestowed without measure],"},{"id":"sayakbay-ms-current143:pdf111:l020","ordinal":391227,"en":"His thoughts scattering a thousand ways,"},{"id":"sayakbay-ms-current143:pdf111:l024","ordinal":391228,"en":"Kulan-maned Kulun Sur,"},{"id":"sayakbay-ms-current143:pdf112:l004","ordinal":391229,"en":"Curse mortal frailty,"},{"id":"sayakbay-ms-current143:pdf112:l005","ordinal":391230,"en":"His tiny soul cried out,"},{"id":"sayakbay-ms-current143:pdf114:l013","ordinal":391231,"en":"Kulansur stood tethered,"},{"id":"sayakbay-ms-current143:pdf114:l018","ordinal":391232,"en":"And now mounted Kulansur."},{"id":"sayakbay-ms-current143:pdf114:l021","ordinal":391233,"en":"Kulansur beneath him,"},{"id":"sayakbay-ms-current143:pdf114:l023","ordinal":391234,"en":"Given free rein, the fierce beast,"},{"id":"sayakbay-ms-current143:pdf115:l001","ordinal":391235,"en":"Akjoltoi's Kulansur,"},{"id":"sayakbay-ms-current143:pdf115:l032","ordinal":391236,"en":"A passionate person could never leave."},{"id":"sayakbay-ms-current143:pdf116:l003","ordinal":391237,"en":"A young man keen on hunting,"},{"id":"sayakbay-ms-current143:pdf118:l012","ordinal":391238,"en":"Plane trees beyond imagining,"},{"id":"sayakbay-ms-current143:pdf118:l023","ordinal":391239,"en":"[Its lion among fanged beasts,]"},{"id":"sayakbay-ms-current143:pdf118:l024","ordinal":391240,"en":"It is a land where none shoots,"},{"id":"sayakbay-ms-current143:pdf118:l026","ordinal":391241,"en":"[It is a land unable to contain them,]"},{"id":"sayakbay-ms-current143:pdf119:l008","ordinal":391242,"en":"From his charging spear-thrust,"},{"id":"sayakbay-ms-current143:pdf119:l013","ordinal":391243,"en":"If an enemy appeared before him,"},{"id":"sayakbay-ms-current143:pdf119:l022","ordinal":391244,"en":"Across the untrodden plain,"},{"id":"sayakbay-ms-current143:pdf119:l027","ordinal":391245,"en":"Haze stretched beyond sight."},{"id":"sayakbay-ms-current143:pdf120:l002","ordinal":391246,"en":"If a wild ass wandered there in play,"},{"id":"sayakbay-ms-current143:pdf120:l015","ordinal":391247,"en":"Making one a hero to another,"},{"id":"sayakbay-ms-current143:pdf120:l017","ordinal":391248,"en":"Look at this marvel,"},{"id":"sayakbay-ms-current143:pdf120:l019","ordinal":391249,"en":"[There is a city encircled all around,]"},{"id":"sayakbay-ms-current143:pdf120:l020","ordinal":391250,"en":"[Casting a dark hue upon the city,]"},{"id":"sayakbay-ms-current143:pdf121:l007","ordinal":391251,"en":"Toward the expanse of Ken-Ozon,"},{"id":"sayakbay-ms-current143:pdf121:l018","ordinal":391252,"en":"[The creatures he gazed upon,]"},{"id":"sayakbay-ms-current143:pdf121:l028","ordinal":391253,"en":"The spyglass inherited from the Magnanimous One,"},{"id":"sayakbay-ms-current143:pdf122:l008","ordinal":391254,"en":"[Beside the girl, a blue tent,]"},{"id":"sayakbay-ms-current143:pdf122:l009","ordinal":391255,"en":"Black tents, blue tents,"},{"id":"sayakbay-ms-current143:pdf122:l010","ordinal":391256,"en":"Many tents pitched in rows,"},{"id":"sayakbay-ms-current143:pdf122:l011","ordinal":391257,"en":"Brilliantly colored possessions,"},{"id":"sayakbay-ms-current143:pdf123:l001","ordinal":391258,"en":"In one corner of the tent,"},{"id":"sayakbay-ms-current143:pdf123:l004","ordinal":391259,"en":"On one side of the tent,"},{"id":"sayakbay-ms-current143:pdf123:l008","ordinal":391260,"en":"In another corner of the tent,"},{"id":"sayakbay-ms-current143:pdf123:l026","ordinal":391261,"en":"From champions of many kinds,"},{"id":"sayakbay-ms-current143:pdf124:l029","ordinal":391262,"en":"She would enjoy delight with him,"},{"id":"sayakbay-ms-current143:pdf124:l031","ordinal":391263,"en":"Their faces touching in a narrow bed,"},{"id":"sayakbay-ms-current143:pdf125:l011","ordinal":391264,"en":"If he were a man worthy of his father,"},{"id":"sayakbay-ms-current143:pdf126:l030","ordinal":391265,"en":"This passionate woman who came seeking him"},{"id":"sayakbay-ms-current143:pdf127:l001","ordinal":391266,"en":"Facing toward the qibla,"},{"id":"sayakbay-ms-current143:pdf127:l013","ordinal":391267,"en":"She crossed the wilds and hunted game,"},{"id":"sayakbay-ms-current143:pdf127:l028","ordinal":391268,"en":"A white palace fashioned of gold."},{"id":"sayakbay-ms-current143:pdf127:l030","ordinal":391269,"en":"Dazzling the eyes of those who saw."},{"id":"sayakbay-ms-current143:pdf128:l005","ordinal":391270,"en":"Keep yourself attentive,"},{"id":"sayakbay-ms-current143:pdf128:l011","ordinal":391271,"en":"Consider yourself carefully,"},{"id":"sayakbay-ms-current143:pdf128:l015","ordinal":391272,"en":"His earliest forefather was Tümön Khan,"},{"id":"sayakbay-ms-current143:pdf128:l023","ordinal":391273,"en":"For the Kara-Khitai and [Manchu],"},{"id":"sayakbay-ms-current143:pdf128:l024","ordinal":391274,"en":"In their hearts, an incurable,"},{"id":"sayakbay-ms-current143:pdf128:l029","ordinal":391275,"en":"When they fought, they spilled their foes' blood,"},{"id":"sayakbay-ms-current143:pdf128:l030","ordinal":391276,"en":"Of enemies who rose against them,"},{"id":"sayakbay-ms-current143:pdf128:l034","ordinal":391277,"en":"They emptied [Thailand],"},{"id":"sayakbay-ms-current143:pdf129:l008","ordinal":391278,"en":"Exulting in his valor,"},{"id":"sayakbay-ms-current143:pdf129:l009","ordinal":391279,"en":"Great in sacred power,"},{"id":"sayakbay-ms-current143:pdf129:l010","ordinal":391280,"en":"He encountered the Night of Power,"},{"id":"sayakbay-ms-current143:pdf129:l019","ordinal":391281,"en":"He is that Manas's descendant,"},{"id":"sayakbay-ms-current143:pdf129:l030","ordinal":391282,"en":"“Such is your allotted course,” he said,"},{"id":"sayakbay-ms-current143:pdf129:l032","ordinal":391283,"en":"With whom to lie in a narrow bed,"},{"id":"sayakbay-ms-current143:pdf129:l036","ordinal":391284,"en":"This world is full of delight,"},{"id":"sayakbay-ms-current143:pdf130:l009","ordinal":391285,"en":"“Such is your allotted course,” he said,"},{"id":"sayakbay-ms-current143:pdf130:l011","ordinal":391286,"en":"“Immerse yourself in delight,” he said,"},{"id":"sayakbay-ms-current143:pdf130:l014","ordinal":391287,"en":"“Your partner for eternity,”"},{"id":"sayakbay-ms-current143:pdf130:l017","ordinal":391288,"en":"“Examine his bearing,” he said,"},{"id":"sayakbay-ms-current143:pdf130:l032","ordinal":391289,"en":"It lunged and surged forward,"},{"id":"sayakbay-ms-current143:pdf131:l003","ordinal":391290,"en":"In Seitek [the lion] alone,"},{"id":"sayakbay-ms-current143:pdf131:l005","ordinal":391291,"en":"Before him was a striped tiger,"},{"id":"sayakbay-ms-current143:pdf131:l007","ordinal":391292,"en":"No mortal could be like him,"},{"id":"sayakbay-ms-current143:pdf131:l010","ordinal":391293,"en":"As though about to cut everyone down,"},{"id":"sayakbay-ms-current143:pdf131:l013","ordinal":391294,"en":"Sixty of them bore spears,"},{"id":"sayakbay-ms-current143:pdf131:l015","ordinal":391295,"en":"If these men grew angry,"},{"id":"sayakbay-ms-current143:pdf131:l026","ordinal":391296,"en":"His like existed nowhere in the world,"},{"id":"sayakbay-ms-current143:pdf131:l035","ordinal":391297,"en":"Sitting and gazing at his beauty,"},{"id":"sayakbay-ms-current143:pdf132:l015","ordinal":391298,"en":"Trusting in God, who grants ease,"},{"id":"sayakbay-ms-current143:pdf132:l016","ordinal":391299,"en":"No mortal could approach him,"},{"id":"sayakbay-ms-current143:pdf132:l018","ordinal":391300,"en":"“This is the mate I shall join,”"},{"id":"sayakbay-ms-current143:pdf132:l019","ordinal":391301,"en":"Earnestly pleading with God,"},{"id":"sayakbay-ms-current143:pdf132:l028","ordinal":391302,"en":"His beauty was unlike any person's,"},{"id":"sayakbay-ms-current143:pdf132:l029","ordinal":391303,"en":"He appeared like a blue, towering mountain,"},{"id":"sayakbay-ms-current143:pdf132:l030","ordinal":391304,"en":"Of the sky and heavens,"},{"id":"sayakbay-ms-current143:pdf132:l031","ordinal":391305,"en":"He appeared to be their pillar,"},{"id":"sayakbay-ms-current143:pdf132:l032","ordinal":391306,"en":"Of your moon and sun,"},{"id":"sayakbay-ms-current143:pdf132:l033","ordinal":391307,"en":"He seemed their very embodiment,"},{"id":"sayakbay-ms-current143:pdf133:l011","ordinal":391308,"en":"“Such shall be your [destiny],”"},{"id":"sayakbay-ms-current143:pdf133:l012","ordinal":391309,"en":"God's eternal [decree],"},{"id":"sayakbay-ms-current143:pdf133:l017","ordinal":391310,"en":"They placed the youth in my care,"},{"id":"sayakbay-ms-current143:pdf133:l018","ordinal":391311,"en":"Into the delight of merriment,"},{"id":"sayakbay-ms-current143:pdf133:l019","ordinal":391312,"en":"I entered a blessed night,"},{"id":"sayakbay-ms-current143:pdf133:l022","ordinal":391313,"en":"I lay in a narrow bed,"},{"id":"sayakbay-ms-current143:pdf133:l024","ordinal":391314,"en":"I experienced that night,"},{"id":"sayakbay-ms-current143:pdf133:l038","ordinal":391315,"en":"Leave your present land,"},{"id":"sayakbay-ms-current143:pdf133:l040","ordinal":391316,"en":"Find this lion of yours."},{"id":"sayakbay-ms-current143:pdf134:l016","ordinal":391317,"en":"Lying in a narrow bed,"},{"id":"sayakbay-ms-current143:pdf134:l021","ordinal":391318,"en":"When we lay in one bed,"},{"id":"sayakbay-ms-current143:pdf134:l025","ordinal":391319,"en":"It was the Creator's doing,"},{"id":"sayakbay-ms-current143:pdf134:l027","ordinal":391320,"en":"When light touched the earth,"},{"id":"sayakbay-ms-current143:pdf134:l035","ordinal":391321,"en":"Wandering, I could not find him anywhere,"},{"id":"sayakbay-ms-current143:pdf134:l042","ordinal":391322,"en":"When I remembered, my heart became an ember,"},{"id":"sayakbay-ms-current143:pdf134:l044","ordinal":391323,"en":"My lion vanished from my embrace."},{"id":"sayakbay-ms-current143:pdf135:l001","ordinal":391324,"en":"Pale beneath the sun,"},{"id":"sayakbay-ms-current143:pdf135:l009","ordinal":391325,"en":"To the companion maiden beside her,"},{"id":"sayakbay-ms-current143:pdf135:l017","ordinal":391326,"en":"My sunlike friend Külaiym,"},{"id":"sayakbay-ms-current143:pdf135:l020","ordinal":391327,"en":"Because of lion Seitek,"},{"id":"sayakbay-ms-current143:pdf135:l023","ordinal":391328,"en":"I waste away with a wasting illness,"},{"id":"sayakbay-ms-current143:pdf136:l001","ordinal":391329,"en":"I lose my sleep at night."},{"id":"sayakbay-ms-current143:pdf136:l010","ordinal":391330,"en":"The sun rises from my right breast,"},{"id":"sayakbay-ms-current143:pdf136:l011","ordinal":391331,"en":"The moon rises from my left breast."},{"id":"sayakbay-ms-current143:pdf136:l012","ordinal":391332,"en":"Between my two breasts,"},{"id":"sayakbay-ms-current143:pdf136:l018","ordinal":391333,"en":"Holding them firmly without letting go,"},{"id":"sayakbay-ms-current143:pdf136:l031","ordinal":391334,"en":"When I seized and swung them,"},{"id":"sayakbay-ms-current143:pdf137:l014","ordinal":391335,"en":"I climbed the heights, surveying the land."},{"id":"sayakbay-ms-current143:pdf137:l020","ordinal":391336,"en":"All the fanged creatures,"},{"id":"sayakbay-ms-current143:pdf137:l022","ordinal":391337,"en":"They all fled and disappeared,"},{"id":"sayakbay-ms-current143:pdf137:l031","ordinal":391338,"en":"All the people cried out,"},{"id":"sayakbay-ms-current143:pdf137:l034","ordinal":391339,"en":"I brought under my control and wore down."},{"id":"sayakbay-ms-current143:pdf137:l037","ordinal":391340,"en":"I witnessed such a marvelous event."},{"id":"sayakbay-ms-current143:pdf138:l001","ordinal":391341,"en":"Called a tent, it was a white palace—"},{"id":"sayakbay-ms-current143:pdf138:l002","ordinal":391342,"en":"The account of the one who adorned it"},{"id":"sayakbay-ms-current143:pdf138:l003","ordinal":391343,"en":"Would take a long telling."},{"id":"sayakbay-ms-current143:pdf138:l004","ordinal":391344,"en":"A single tent at its entrance,"},{"id":"sayakbay-ms-current143:pdf138:l005","ordinal":391345,"en":"Yet beyond it another vista appeared,"},{"id":"sayakbay-ms-current143:pdf138:l006","ordinal":391346,"en":"And inside, it seemed a thousand tents."},{"id":"sayakbay-ms-current143:pdf138:l008","ordinal":391347,"en":"Grey-maned Seytek and Akjoltoi"},{"id":"sayakbay-ms-current143:pdf138:l009","ordinal":391348,"en":"Seemed to be playing ordo."},{"id":"sayakbay-ms-current143:pdf138:l011","ordinal":391349,"en":"Brave Seytek, seeker of the maiden,"},{"id":"sayakbay-ms-current143:pdf138:l012","ordinal":391350,"en":"With thirteen young men beside him,"},{"id":"sayakbay-ms-current143:pdf138:l013","ordinal":391351,"en":"Seemed to fit there with horses and gear."},{"id":"sayakbay-ms-current143:pdf138:l015","ordinal":391352,"en":"Around Bermet, the fairy's daughter,"},{"id":"sayakbay-ms-current143:pdf138:l016","ordinal":391353,"en":"Were eighty maidens,"},{"id":"sayakbay-ms-current143:pdf138:l017","ordinal":391354,"en":"All fitting there spaciously."},{"id":"sayakbay-ms-current143:pdf138:l018","ordinal":391355,"en":"Seeing this, Akjoltoi"},{"id":"sayakbay-ms-current143:pdf138:l019","ordinal":391356,"en":"Could hardly keep from rejoicing."},{"id":"sayakbay-ms-current143:pdf138:l020","ordinal":391357,"en":"At the entrance of the tent,"},{"id":"sayakbay-ms-current143:pdf138:l021","ordinal":391358,"en":"A guardian stood watching;"},{"id":"sayakbay-ms-current143:pdf138:l022","ordinal":391359,"en":"Do not ask what sort of guardian."},{"id":"sayakbay-ms-current143:pdf138:l023","ordinal":391360,"en":"She received Bermet's commands,"},{"id":"sayakbay-ms-current143:pdf138:l024","ordinal":391361,"en":"And wherever Bermet sent her,"},{"id":"sayakbay-ms-current143:pdf138:l025","ordinal":391362,"en":"She brought calamity."},{"id":"sayakbay-ms-current143:pdf138:l026","ordinal":391363,"en":"She stood ready with an iron-headed club,"},{"id":"sayakbay-ms-current143:pdf138:l027","ordinal":391364,"en":"And wore human noses and ears"},{"id":"sayakbay-ms-current143:pdf138:l028","ordinal":391365,"en":"As amulets around her."},{"id":"sayakbay-ms-current143:pdf138:l029","ordinal":391366,"en":"Anyone seeing her outward form"},{"id":"sayakbay-ms-current143:pdf138:l030","ordinal":391367,"en":"Lost his senses."},{"id":"sayakbay-ms-current143:pdf138:l031","ordinal":391368,"en":"The hapless fairy maiden"},{"id":"sayakbay-ms-current143:pdf138:l033","ordinal":391369,"en":"And had them arrayed splendidly."},{"id":"sayakbay-ms-current143:pdf138:l034","ordinal":391370,"en":"The radiant hapless maiden,"},{"id":"sayakbay-ms-current143:pdf139:l001","ordinal":391371,"en":"If there were a hero favored by the sacred powers,"},{"id":"sayakbay-ms-current143:pdf139:l002","ordinal":391372,"en":"If there were a man who took after his forefathers,"},{"id":"sayakbay-ms-current143:pdf139:l003","ordinal":391373,"en":"He would pass among the champions,"},{"id":"sayakbay-ms-current143:pdf139:l004","ordinal":391374,"en":"So that the guardian spirit might strike him, she thought."},{"id":"sayakbay-ms-current143:pdf139:l005","ordinal":391375,"en":"If he were one who did not take after his father,"},{"id":"sayakbay-ms-current143:pdf139:l006","ordinal":391376,"en":"Let him squander his own wealth, she thought,"},{"id":"sayakbay-ms-current143:pdf139:l007","ordinal":391377,"en":"And recoil and flee again, she thought."},{"id":"sayakbay-ms-current143:pdf139:l008","ordinal":391378,"en":"If he were a dark grey-maned hero,"},{"id":"sayakbay-ms-current143:pdf139:l009","ordinal":391379,"en":"If he were a bloodthirsty sultan hero,"},{"id":"sayakbay-ms-current143:pdf139:l010","ordinal":391380,"en":"He would pour out his wrath and grow grim,"},{"id":"sayakbay-ms-current143:pdf139:l011","ordinal":391381,"en":"And enter among the champions, she thought,"},{"id":"sayakbay-ms-current143:pdf139:l012","ordinal":391382,"en":"Making tumult and strife,"},{"id":"sayakbay-ms-current143:pdf139:l013","ordinal":391383,"en":"And casting the desert into turmoil, she thought,"},{"id":"sayakbay-ms-current143:pdf139:l014","ordinal":391384,"en":"Making slaughter and raising dust,"},{"id":"sayakbay-ms-current143:pdf139:l015","ordinal":391385,"en":"Attacking like a leopard,"},{"id":"sayakbay-ms-current143:pdf139:l016","ordinal":391386,"en":"And striking from the flank, she thought."},{"id":"sayakbay-ms-current143:pdf139:l017","ordinal":391387,"en":"If he were a foolish coward,"},{"id":"sayakbay-ms-current143:pdf139:l018","ordinal":391388,"en":"He would panic and find no counsel, she thought,"},{"id":"sayakbay-ms-current143:pdf139:l019","ordinal":391389,"en":"And flee toward his village, she thought."},{"id":"sayakbay-ms-current143:pdf139:l020","ordinal":391390,"en":"She stationed warrior guards from among the champions,"},{"id":"sayakbay-ms-current143:pdf139:l021","ordinal":391391,"en":"And set every kind of danger in equal measure;"},{"id":"sayakbay-ms-current143:pdf139:l022","ordinal":391392,"en":"The radiant hapless one,"},{"id":"sayakbay-ms-current143:pdf139:l023","ordinal":391393,"en":"Your unfortunate fairy maiden,"},{"id":"sayakbay-ms-current143:pdf139:l024","ordinal":391394,"en":"Was wise indeed."},{"id":"sayakbay-ms-current143:pdf139:l025","ordinal":391395,"en":"To test the champion before marrying,"},{"id":"sayakbay-ms-current143:pdf139:l026","ordinal":391396,"en":"To gauge his valor and heroic strength,"},{"id":"sayakbay-ms-current143:pdf139:l027","ordinal":391397,"en":"And learn them through such a trial,"},{"id":"sayakbay-ms-current143:pdf139:l028","ordinal":391398,"en":"If Seytek proved base,"},{"id":"sayakbay-ms-current143:pdf139:l029","ordinal":391399,"en":"She would not approach him, much less marry him,"},{"id":"sayakbay-ms-current143:pdf139:l030","ordinal":391400,"en":"But would scatter all her wealth,"},{"id":"sayakbay-ms-current143:pdf139:l031","ordinal":391401,"en":"Recite enchantments and transform herself,"},{"id":"sayakbay-ms-current143:pdf139:l032","ordinal":391402,"en":"And flee toward the fairies."},{"id":"sayakbay-ms-current143:pdf139:l033","ordinal":391403,"en":"She considered it wisely,"},{"id":"sayakbay-ms-current143:pdf139:l034","ordinal":391404,"en":"Pondering many things."},{"id":"sayakbay-ms-current143:pdf139:l035","ordinal":391405,"en":"If Seytek proved a champion,"},{"id":"sayakbay-ms-current143:pdf140:l001","ordinal":391406,"en":"Sharing meat from a single platter,"},{"id":"sayakbay-ms-current143:pdf140:l002","ordinal":391407,"en":"Meeting one another to see,"},{"id":"sayakbay-ms-current143:pdf140:l003","ordinal":391408,"en":"If Seytek satisfied her heart,"},{"id":"sayakbay-ms-current143:pdf140:l004","ordinal":391409,"en":"She would follow him even unto death."},{"id":"sayakbay-ms-current143:pdf140:l005","ordinal":391410,"en":"She had guarded her virgin self,"},{"id":"sayakbay-ms-current143:pdf140:l006","ordinal":391411,"en":"To surrender what she held in trust."},{"id":"sayakbay-ms-current143:pdf140:l007","ordinal":391412,"en":"So Bermet could observe and know"},{"id":"sayakbay-ms-current143:pdf140:l008","ordinal":391413,"en":"His valor and heroic strength,"},{"id":"sayakbay-ms-current143:pdf140:l009","ordinal":391414,"en":"And fill her heart with him,"},{"id":"sayakbay-ms-current143:pdf140:l010","ordinal":391415,"en":"Only then would she marry."},{"id":"sayakbay-ms-current143:pdf140:l011","ordinal":391416,"en":"The paired, hapless one,"},{"id":"sayakbay-ms-current143:pdf140:l012","ordinal":391417,"en":"A world like the shining moon,"},{"id":"sayakbay-ms-current143:pdf140:l013","ordinal":391418,"en":"The wondrous, incorrigible maiden,"},{"id":"sayakbay-ms-current143:pdf140:l014","ordinal":391419,"en":"Had wearied horses and surveyed lands,"},{"id":"sayakbay-ms-current143:pdf140:l015","ordinal":391420,"en":"Unleashed hounds and flown birds,"},{"id":"sayakbay-ms-current143:pdf140:l016","ordinal":391421,"en":"Thinking: if he bore the signs of valor,"},{"id":"sayakbay-ms-current143:pdf140:l017","ordinal":391422,"en":"In the end he would come seeking,"},{"id":"sayakbay-ms-current143:pdf140:l018","ordinal":391423,"en":"And if he came, he would see."},{"id":"sayakbay-ms-current143:pdf140:l019","ordinal":391424,"en":"If his heart were faint,"}]
