[{"id":"manas-2010:p0273:b001:l003","ordinal":12289,"en":"Among those troops,"},{"id":"manas-2010:p0273:b001:l004","ordinal":12290,"en":"What was there, what was not!"},{"id":"manas-2010:p0273:b001:l005","ordinal":12291,"en":"There was the giant, old Koshoy;"},{"id":"manas-2010:p0273:b001:l006","ordinal":12292,"en":"The swordsmen gathered,"},{"id":"manas-2010:p0273:b001:l007","ordinal":12293,"en":"Wrathfully making ready,"},{"id":"manas-2010:p0273:b001:l008","ordinal":12294,"en":"With your elder Khan Koshoy at their head,"},{"id":"manas-2010:p0273:b001:l009","ordinal":12295,"en":"A thousand giants mounted."},{"id":"manas-2010:p0273:b001:l010","ordinal":12296,"en":"Taking up their weapons,"},{"id":"manas-2010:p0273:b001:l011","ordinal":12297,"en":"Your champion elder Koshoy was there;"},{"id":"manas-2010:p0273:b001:l012","ordinal":12298,"en":"They barred the ridge."},{"id":"manas-2010:p0273:b001:l013","ordinal":12299,"en":"When renowned Koshoy looked,"},{"id":"manas-2010:p0273:b001:l014","ordinal":12300,"en":"He was riding the tulpar Toruchaar,"},{"id":"manas-2010:p0273:b001:l015","ordinal":12301,"en":"He was wearing silk no bullet could pierce,"},{"id":"manas-2010:p0273:b001:l016","ordinal":12302,"en":"He was riding a horse no bullet could catch."},{"id":"manas-2010:p0273:b001:l017","ordinal":12303,"en":"His bulk was equal to a mountain,"},{"id":"manas-2010:p0273:b001:l018","ordinal":12304,"en":"As though to devour whoever appeared."},{"id":"manas-2010:p0273:b001:l019","ordinal":12305,"en":"His protectors were one group of nine;"},{"id":"manas-2010:p0273:b001:l020","ordinal":12306,"en":"It was their time to protect him."},{"id":"manas-2010:p0273:b001:l021","ordinal":12307,"en":"His supporters were one group of nine;"},{"id":"manas-2010:p0273:b001:l022","ordinal":12308,"en":"It was their time to uphold him."},{"id":"manas-2010:p0273:b001:l023","ordinal":12309,"en":"His world was in perfect balance;"},{"id":"manas-2010:p0273:b001:l024","ordinal":12310,"en":"He was a lion protected by Shay."},{"id":"manas-2010:p0273:b001:l025","ordinal":12311,"en":"If one looked into his inner being,"},{"id":"manas-2010:p0273:b001:l026","ordinal":12312,"en":"It was broader than the face of the earth."},{"id":"manas-2010:p0273:b001:l027","ordinal":12313,"en":"“Oh, my child, the one whose name we heard so often,"},{"id":"manas-2010:p0273:b001:l028","ordinal":12314,"en":"The one whose coming we awaited,"},{"id":"manas-2010:p0273:b001:l029","ordinal":12315,"en":"The servant of the Almighty,"},{"id":"manas-2010:p0273:b001:l030","ordinal":12316,"en":"Old Jakyp's only son,"},{"id":"manas-2010:p0273:b001:l031","ordinal":12317,"en":"The fortress of the Kyrgyz people,"},{"id":"manas-2010:p0273:b001:l032","ordinal":12318,"en":"The hero of many peoples,"},{"id":"manas-2010:p0273:b001:l033","ordinal":12319,"en":"Who will go straight into darkly looming Beijing"},{"id":"manas-2010:p0273:b001:l034","ordinal":12320,"en":"And thrust his spear—"},{"id":"manas-2010:p0273:b001:l035","ordinal":12321,"en":"It is lion Manas himself!"},{"id":"manas-2010:p0273:b001:l036","ordinal":12322,"en":"Not merely Manas himself,"},{"id":"manas-2010:p0273:b001:l037","ordinal":12323,"en":"It is his own dark, gazing eyes!"},{"id":"manas-2010:p0273:b001:l038","ordinal":12324,"en":"Seeking kin, support and a shore,"},{"id":"manas-2010:p0273:b001:l039","ordinal":12325,"en":"The man, the white goshawk, has come!"},{"id":"manas-2010:p0273:b001:l040","ordinal":12326,"en":"Mighty Manas has been found,"},{"id":"manas-2010:p0273:b001:l041","ordinal":12327,"en":"Your lurking enemy will be struck down."},{"id":"manas-2010:p0273:b001:l042","ordinal":12328,"en":"Kyrgyz people, small as a palm,"},{"id":"manas-2010:p0273:b001:l043","ordinal":12329,"en":"Through him your shame will be covered,"},{"id":"manas-2010:p0273:b001:l044","ordinal":12330,"en":"Your exposed places will be covered."},{"id":"manas-2010:p0273:b001:l045","ordinal":12331,"en":"The one you would toil to seek,"},{"id":"manas-2010:p0273:b001:l046","ordinal":12332,"en":"Your wolf-maned Manas has been found;"},{"id":"manas-2010:p0273:b001:l047","ordinal":12333,"en":"God has plainly granted him,"},{"id":"manas-2010:p0273:b001:l048","ordinal":12334,"en":"The one your people longed and prayed for"},{"id":"manas-2010:p0274:b001:l001","ordinal":12335,"en":"The leopard Manas has come."},{"id":"manas-2010:p0274:b001:l002","ordinal":12336,"en":"Akbaltay of the Noygut,"},{"id":"manas-2010:p0274:b001:l003","ordinal":12337,"en":"That champion told the news,"},{"id":"manas-2010:p0274:b001:l004","ordinal":12338,"en":"Wearing out his horse, scouting the road,"},{"id":"manas-2010:p0274:b001:l005","ordinal":12339,"en":"The lion has come this way!”"},{"id":"manas-2010:p0274:b001:l006","ordinal":12340,"en":"When Koshoy said this,"},{"id":"manas-2010:p0274:b001:l007","ordinal":12341,"en":"Everyone but brave Koshoy"},{"id":"manas-2010:p0274:b001:l008","ordinal":12342,"en":"Dismounted, calling out,"},{"id":"manas-2010:p0274:b001:l009","ordinal":12343,"en":"And greeted him with sobs."},{"id":"manas-2010:p0274:b001:l010","ordinal":12344,"en":"Those who kept courts and ruled peoples,"},{"id":"manas-2010:p0274:b001:l011","ordinal":12345,"en":"All the mighty men and giants,"},{"id":"manas-2010:p0274:b001:l012","ordinal":12346,"en":"Bent their knees to the ground,"},{"id":"manas-2010:p0274:b001:l013","ordinal":12347,"en":"Ran about in confusion,"},{"id":"manas-2010:p0274:b001:l014","ordinal":12348,"en":"Shouted in delight,"},{"id":"manas-2010:p0274:b001:l015","ordinal":12349,"en":"Unable to contain their joy,"},{"id":"manas-2010:p0274:b001:l016","ordinal":12350,"en":"Raised the battle cry “Manas!”"},{"id":"manas-2010:p0274:b001:l017","ordinal":12351,"en":"Surged up and down,"},{"id":"manas-2010:p0274:b001:l018","ordinal":12352,"en":"Many giants hurried, panting,"},{"id":"manas-2010:p0274:b001:l019","ordinal":12353,"en":"And bowed low at his hem."},{"id":"manas-2010:p0274:b001:l020","ordinal":12354,"en":"If you ask how Manas was,"},{"id":"manas-2010:p0274:b001:l021","ordinal":12355,"en":"His eyes blazed in anger;"},{"id":"manas-2010:p0274:b001:l022","ordinal":12356,"en":"At the sight of the frightened people"},{"id":"manas-2010:p0274:b001:l023","ordinal":12357,"en":"His thirst for blood truly seized him."},{"id":"manas-2010:p0274:b001:l024","ordinal":12358,"en":"Such was the leopard's nature."},{"id":"manas-2010:p0274:b001:l025","ordinal":12359,"en":"He had a black cap like a cauldron,"},{"id":"manas-2010:p0274:b001:l026","ordinal":12360,"en":"Unbeliever and Muslim alike"},{"id":"manas-2010:p0274:b001:l027","ordinal":12361,"en":"He had the power to suck in."},{"id":"manas-2010:p0274:b001:l028","ordinal":12362,"en":"Of medium height, broad-shouldered,"},{"id":"manas-2010:p0274:b001:l029","ordinal":12363,"en":"Both a wrestler and a lion,"},{"id":"manas-2010:p0274:b001:l030","ordinal":12364,"en":"An exceptional, wolf-maned hero."},{"id":"manas-2010:p0274:b001:l031","ordinal":12365,"en":"At the sight of brave Manas"},{"id":"manas-2010:p0274:b001:l032","ordinal":12366,"en":"The Muslim people said:"},{"id":"manas-2010:p0274:b001:l033","ordinal":12367,"en":"“Both a wrestler and a lion—"},{"id":"manas-2010:p0274:b001:l034","ordinal":12368,"en":"Such a hero is not born among men."},{"id":"manas-2010:p0274:b001:l035","ordinal":12369,"en":"If we make Ala-Too our homeland,"},{"id":"manas-2010:p0274:b001:l036","ordinal":12370,"en":"Bring our unity together,"},{"id":"manas-2010:p0274:b001:l037","ordinal":12371,"en":"The bloodthirsty leopard Manas,"},{"id":"manas-2010:p0274:b001:l038","ordinal":12372,"en":"If we raise him up as khan,"},{"id":"manas-2010:p0274:b001:l039","ordinal":12373,"en":"Against the Chinese beyond the ridge,"},{"id":"manas-2010:p0274:b001:l040","ordinal":12374,"en":"He is a son who will bring slaughter."},{"id":"manas-2010:p0274:b001:l041","ordinal":12375,"en":"There are guns before us,"},{"id":"manas-2010:p0274:b001:l042","ordinal":12376,"en":"Many enemies to contend with."},{"id":"manas-2010:p0274:b001:l043","ordinal":12377,"en":"Set him on barren ground,"},{"id":"manas-2010:p0274:b001:l044","ordinal":12378,"en":"Oh, my dear, he would become a house!"},{"id":"manas-2010:p0274:b001:l045","ordinal":12379,"en":"Over the whole wide world"},{"id":"manas-2010:p0274:b001:l046","ordinal":12380,"en":"He would become khan!"},{"id":"manas-2010:p0274:b001:l047","ordinal":12381,"en":"Both a wrestler and a lion—"},{"id":"manas-2010:p0274:b001:l048","ordinal":12382,"en":"Such a hero is not born among men."},{"id":"manas-2010:p0275:b001:l001","ordinal":12383,"en":"His sweeping strokes are eighty-four,"},{"id":"manas-2010:p0275:b001:l002","ordinal":12384,"en":"Wherever he strikes is red fire."},{"id":"manas-2010:p0275:b001:l003","ordinal":12385,"en":"For a people few as a palmful,"},{"id":"manas-2010:p0275:b001:l004","ordinal":12386,"en":"He was born as their good fortune,"},{"id":"manas-2010:p0275:b001:l005","ordinal":12387,"en":"Against an enemy who grapples with him"},{"id":"manas-2010:p0275:b001:l006","ordinal":12388,"en":"He will raise a mighty uproar."},{"id":"manas-2010:p0275:b001:l007","ordinal":12389,"en":"All twelve parts of his body are sound,"},{"id":"manas-2010:p0275:b001:l008","ordinal":12390,"en":"Your bold, wolf-maned one"},{"id":"manas-2010:p0275:b001:l009","ordinal":12391,"en":"Is the Muslims' fortress."},{"id":"manas-2010:p0275:b001:l010","ordinal":12392,"en":"Allah Most High, the one God,"},{"id":"manas-2010:p0275:b001:l011","ordinal":12393,"en":"The wolf-maned lion Manas"},{"id":"manas-2010:p0275:b001:l012","ordinal":12394,"en":"Has now driven here,”"},{"id":"manas-2010:p0275:b001:l013","ordinal":12395,"en":"So the Muslims said."},{"id":"manas-2010:p0275:b001:l014","ordinal":12396,"en":"Slaughtering mares for Baabedin,"},{"id":"manas-2010:p0275:b001:l015","ordinal":12397,"en":"The prosperous slaughtering camels,"},{"id":"manas-2010:p0275:b001:l016","ordinal":12398,"en":"All joining in offerings to Baabedin,"},{"id":"manas-2010:p0275:b001:l017","ordinal":12399,"en":"Saying, “Hero Manas has come,”"},{"id":"manas-2010:p0275:b001:l018","ordinal":12400,"en":"They prepared to hold a feast."},{"id":"manas-2010:p0275:b001:l019","ordinal":12401,"en":"Their elder Kudaynazar,"},{"id":"manas-2010:p0275:b001:l020","ordinal":12402,"en":"Raised a joyful uproar,"},{"id":"manas-2010:p0275:b001:l021","ordinal":12403,"en":"All the people who had come."},{"id":"manas-2010:p0275:b001:l022","ordinal":12404,"en":"The people ran in gladness;"},{"id":"manas-2010:p0275:b001:l023","ordinal":12405,"en":"When the people were thus engaged,"},{"id":"manas-2010:p0275:b001:l024","ordinal":12406,"en":"Riding a bay leopard of a horse,"},{"id":"manas-2010:p0275:b001:l025","ordinal":12407,"en":"Wearing a broad, shot-proof coat,"},{"id":"manas-2010:p0275:b001:l026","ordinal":12408,"en":"Towering like a mighty mountain,"},{"id":"manas-2010:p0275:b001:l027","ordinal":12409,"en":"His great mustache jutting out,"},{"id":"manas-2010:p0275:b001:l028","ordinal":12410,"en":"Your great elder Koshoy sat tall,"},{"id":"manas-2010:p0275:b001:l029","ordinal":12411,"en":"His white beard gleaming."},{"id":"manas-2010:p0275:b001:l030","ordinal":12412,"en":"Your elder Koshoy then,"},{"id":"manas-2010:p0275:b001:l031","ordinal":12413,"en":"Honked like a migrating goose;"},{"id":"manas-2010:p0275:b001:l032","ordinal":12414,"en":"Your elder of unmatched appearance,"},{"id":"manas-2010:p0275:b001:l033","ordinal":12415,"en":"His whole figure shone."},{"id":"manas-2010:p0275:b001:l034","ordinal":12416,"en":"His bulk was equal to a mountain,"},{"id":"manas-2010:p0275:b001:l035","ordinal":12417,"en":"As though he would devour whoever he met."},{"id":"manas-2010:p0275:b001:l036","ordinal":12418,"en":"Bloodthirsty Koshoy, your elder khan,"},{"id":"manas-2010:p0275:b001:l037","ordinal":12419,"en":"His wide eyes like the morning star,"},{"id":"manas-2010:p0275:b001:l038","ordinal":12420,"en":"His moonlike ears like shields,"},{"id":"manas-2010:p0275:b001:l039","ordinal":12421,"en":"Readied his battle gear,"},{"id":"manas-2010:p0275:b001:l040","ordinal":12422,"en":"Girded on a keen steel sword,"},{"id":"manas-2010:p0275:b001:l041","ordinal":12423,"en":"And prayed to the Creator."},{"id":"manas-2010:p0275:b001:l042","ordinal":12424,"en":"With a golden-bladed battle-axe"},{"id":"manas-2010:p0275:b001:l043","ordinal":12425,"en":"Looped snugly about his wrist,"},{"id":"manas-2010:p0275:b001:l044","ordinal":12426,"en":"Your wise elder Koshoy"},{"id":"manas-2010:p0275:b001:l045","ordinal":12427,"en":"Came out before Manas,"},{"id":"manas-2010:p0275:b001:l046","ordinal":12428,"en":"Preparing to greet him."},{"id":"manas-2010:p0275:b001:l047","ordinal":12429,"en":"Your elder, aged Koshoy,"},{"id":"manas-2010:p0275:b001:l048","ordinal":12430,"en":"Came out before Manas;"},{"id":"manas-2010:p0276:b001:l001","ordinal":12431,"en":"The saintly man greeted him:"},{"id":"manas-2010:p0276:b001:l002","ordinal":12432,"en":"“My champion born a leopard,"},{"id":"manas-2010:p0276:b001:l003","ordinal":12433,"en":"My champion, I searched long for you,"},{"id":"manas-2010:p0276:b001:l004","ordinal":12434,"en":"And suffered much, my dear!"},{"id":"manas-2010:p0276:b001:l005","ordinal":12435,"en":"Born away in Altay,"},{"id":"manas-2010:p0276:b001:l006","ordinal":12436,"en":"In Black Kalmyk Beijing"},{"id":"manas-2010:p0276:b001:l007","ordinal":12437,"en":"They heard your fame and raised an uproar."},{"id":"manas-2010:p0276:b001:l008","ordinal":12438,"en":"Nine hundred mares were slaughtered for your feast,"},{"id":"manas-2010:p0276:b001:l009","ordinal":12439,"en":"You were given the name Manas!"},{"id":"manas-2010:p0276:b001:l010","ordinal":12440,"en":"He made all twelve parts of you sound,"},{"id":"manas-2010:p0276:b001:l011","ordinal":12441,"en":"My Allah Most High made you a lion."},{"id":"manas-2010:p0276:b001:l012","ordinal":12442,"en":"Though I have neither seen nor known you,"},{"id":"manas-2010:p0276:b001:l013","ordinal":12443,"en":"Rich Jakyp's only son—"},{"id":"manas-2010:p0276:b001:l014","ordinal":12444,"en":"My child Manas, are you well?!"},{"id":"manas-2010:p0276:b001:l015","ordinal":12445,"en":"Is there a willow planted on the bluff?"},{"id":"manas-2010:p0276:b001:l016","ordinal":12446,"en":"You are the steadfast lion himself."},{"id":"manas-2010:p0276:b001:l017","ordinal":12447,"en":"Without seeking your many people,"},{"id":"manas-2010:p0276:b001:l018","ordinal":12448,"en":"Is there reason to live among Kalmyks?"},{"id":"manas-2010:p0276:b001:l019","ordinal":12449,"en":"Now look, wolf-maned one, where are your people?!"},{"id":"manas-2010:p0276:b001:l020","ordinal":12450,"en":"You were born a prince in China;"},{"id":"manas-2010:p0276:b001:l021","ordinal":12451,"en":"Is there reason to wander in exile?"},{"id":"manas-2010:p0276:b001:l022","ordinal":12452,"en":"On a day of hardship, Manas, where are your people?!"},{"id":"manas-2010:p0276:b001:l023","ordinal":12453,"en":"You became a blood-spiller against Kakan;"},{"id":"manas-2010:p0276:b001:l024","ordinal":12454,"en":"Is there reason not to return?!"},{"id":"manas-2010:p0276:b001:l025","ordinal":12455,"en":"Moving out of Altay,"},{"id":"manas-2010:p0276:b001:l026","ordinal":12456,"en":"When will you settle in your land?!"},{"id":"manas-2010:p0276:b001:l027","ordinal":12457,"en":"To your small Kyrgyz people,"},{"id":"manas-2010:p0276:b001:l028","ordinal":12458,"en":"When will you become a protector?!"},{"id":"manas-2010:p0276:b001:l029","ordinal":12459,"en":"Your people left abandoned,"},{"id":"manas-2010:p0276:b001:l030","ordinal":12460,"en":"When will you take charge of them?!"},{"id":"manas-2010:p0276:b001:l031","ordinal":12461,"en":"If you fight while living in Altay,"},{"id":"manas-2010:p0276:b001:l032","ordinal":12462,"en":"With neither mane nor tail at all,"},{"id":"manas-2010:p0276:b001:l033","ordinal":12463,"en":"You will come to grief!"},{"id":"manas-2010:p0276:b001:l034","ordinal":12464,"en":"Find your land of Talas,"},{"id":"manas-2010:p0276:b001:l035","ordinal":12465,"en":"Care for, my foal,"},{"id":"manas-2010:p0276:b001:l036","ordinal":12466,"en":"Your flourishing Kyrgyz people!"},{"id":"manas-2010:p0276:b001:l037","ordinal":12467,"en":"Ah, my foal, Manas Khan!"},{"id":"manas-2010:p0276:b001:l038","ordinal":12468,"en":"If you ask about me—"},{"id":"manas-2010:p0276:b001:l039","ordinal":12469,"en":"In the desert of Mediyan,"},{"id":"manas-2010:p0276:b001:l040","ordinal":12470,"en":"In the place where saints had lived,"},{"id":"manas-2010:p0276:b001:l041","ordinal":12471,"en":"At the shrine called Baabedin,"},{"id":"manas-2010:p0276:b001:l042","ordinal":12472,"en":"That is exactly where I was born."},{"id":"manas-2010:p0276:b001:l043","ordinal":12473,"en":"Your grandfather Karakan had died."},{"id":"manas-2010:p0276:b001:l044","ordinal":12474,"en":"When that Karakan died,"},{"id":"manas-2010:p0276:b001:l045","ordinal":12475,"en":"With forty young men following him,"},{"id":"manas-2010:p0276:b001:l046","ordinal":12476,"en":"When your brave elder Koshoy came,"},{"id":"manas-2010:p0276:b001:l047","ordinal":12477,"en":"They had smashed his stone fortress,"},{"id":"manas-2010:p0276:b001:l048","ordinal":12478,"en":"And done whatever they pleased;"},{"id":"manas-2010:p0277:b001:l001","ordinal":12479,"en":"All the people, every one,"},{"id":"manas-2010:p0277:b001:l002","ordinal":12480,"en":"Döngö and Zholoy had slaughtered."},{"id":"manas-2010:p0277:b001:l003","ordinal":12481,"en":"Karakan's eight sons,"},{"id":"manas-2010:p0277:b001:l004","ordinal":12482,"en":"When they seized and divided them together,"},{"id":"manas-2010:p0277:b001:l005","ordinal":12483,"en":"One of us went far away,"},{"id":"manas-2010:p0277:b001:l006","ordinal":12484,"en":"One went to the depths."},{"id":"manas-2010:p0277:b001:l007","ordinal":12485,"en":"They divided his offspring, humiliating them,"},{"id":"manas-2010:p0277:b001:l008","ordinal":12486,"en":"They slaughtered outright by force."},{"id":"manas-2010:p0277:b001:l009","ordinal":12487,"en":"When great Karakan died,"},{"id":"manas-2010:p0277:b001:l010","ordinal":12488,"en":"Karakan's many people,"},{"id":"manas-2010:p0277:b001:l011","ordinal":12489,"en":"When the Black Chinese and Manchus"},{"id":"manas-2010:p0277:b001:l012","ordinal":12490,"en":"Divided them, measuring with a whip,"},{"id":"manas-2010:p0277:b001:l013","ordinal":12491,"en":"With forty young men beside me,"},{"id":"manas-2010:p0277:b001:l014","ordinal":12492,"en":"I girded my sturdy waist,"},{"id":"manas-2010:p0277:b001:l015","ordinal":12493,"en":"Against the Manchus swarming over the earth"},{"id":"manas-2010:p0277:b001:l016","ordinal":12494,"en":"I entered alone and attacked."},{"id":"manas-2010:p0277:b001:l017","ordinal":12495,"en":"Standing on either side,"},{"id":"manas-2010:p0277:b001:l018","ordinal":12496,"en":"Firing guns and drawing bows,"},{"id":"manas-2010:p0277:b001:l019","ordinal":12497,"en":"Fighting without fleeing,"},{"id":"manas-2010:p0277:b001:l020","ordinal":12498,"en":"Thrusting spears hard,"},{"id":"manas-2010:p0277:b001:l021","ordinal":12499,"en":"The spears that sank deep"},{"id":"manas-2010:p0277:b001:l022","ordinal":12500,"en":"They braced against with a foot and pulled free."},{"id":"manas-2010:p0277:b001:l023","ordinal":12501,"en":"Standing face to face,"},{"id":"manas-2010:p0277:b001:l024","ordinal":12502,"en":"Firing guns and drawing bows,"},{"id":"manas-2010:p0277:b001:l025","ordinal":12503,"en":"Fighting with wet smacking blows,"},{"id":"manas-2010:p0277:b001:l026","ordinal":12504,"en":"Clashing with courage,"},{"id":"manas-2010:p0277:b001:l027","ordinal":12505,"en":"Battling with crashing blows,"},{"id":"manas-2010:p0277:b001:l028","ordinal":12506,"en":"Many heroes died in single combat."},{"id":"manas-2010:p0277:b001:l029","ordinal":12507,"en":"Zhügörü, the giant's son,"},{"id":"manas-2010:p0277:b001:l030","ordinal":12508,"en":"He died in that struggle."},{"id":"manas-2010:p0277:b001:l031","ordinal":12509,"en":"Skilled spearmen died,"},{"id":"manas-2010:p0277:b001:l032","ordinal":12510,"en":"Mighty wielders of battle-axes died."},{"id":"manas-2010:p0277:b001:l033","ordinal":12511,"en":"My close companions,"},{"id":"manas-2010:p0277:b001:l034","ordinal":12512,"en":"The forty-one giants I had led died."},{"id":"manas-2010:p0277:b001:l035","ordinal":12513,"en":"Caught and subjected to suffering,"},{"id":"manas-2010:p0277:b001:l036","ordinal":12514,"en":"My battle against the Chinese"},{"id":"manas-2010:p0277:b001:l037","ordinal":12515,"en":"Had lasted fifty-eight days,"},{"id":"manas-2010:p0277:b001:l038","ordinal":12516,"en":"When I escaped and went to Mecca."},{"id":"manas-2010:p0277:b001:l039","ordinal":12517,"en":"I was struck at my flank;"},{"id":"manas-2010:p0277:b001:l040","ordinal":12518,"en":"All the mighty men"},{"id":"manas-2010:p0277:b001:l041","ordinal":12519,"en":"I lost as gifts to the Chinese."},{"id":"manas-2010:p0277:b001:l042","ordinal":12520,"en":"Passing through seventy days,"},{"id":"manas-2010:p0277:b001:l043","ordinal":12521,"en":"Brave Koshoy was wounded."},{"id":"manas-2010:p0277:b001:l044","ordinal":12522,"en":"Wounded in seventy places,"},{"id":"manas-2010:p0277:b001:l045","ordinal":12523,"en":"The Kalmyks surged, I was alone,"},{"id":"manas-2010:p0277:b001:l046","ordinal":12524,"en":"A bullet struck and split my ankle;"},{"id":"manas-2010:p0277:b001:l047","ordinal":12525,"en":"When I could no longer turn,"},{"id":"manas-2010:p0277:b001:l048","ordinal":12526,"en":"There was an empty, unpeopled steppe,"},{"id":"manas-2010:p0278:b001:l001","ordinal":12527,"en":"Koshoy, alone of all the heroes,"},{"id":"manas-2010:p0278:b001:l002","ordinal":12528,"en":"Had wounds in many places."},{"id":"manas-2010:p0278:b001:l003","ordinal":12529,"en":"There was no swift steed to ride at ease,"},{"id":"manas-2010:p0278:b001:l004","ordinal":12530,"en":"If I swept in to attack,"},{"id":"manas-2010:p0278:b001:l005","ordinal":12531,"en":"No kinsman to stand by me."},{"id":"manas-2010:p0278:b001:l006","ordinal":12532,"en":"While fighting the Chinese,"},{"id":"manas-2010:p0278:b001:l007","ordinal":12533,"en":"I had my wing struck by a bullet;"},{"id":"manas-2010:p0278:b001:l008","ordinal":12534,"en":"I knew that it was struck."},{"id":"manas-2010:p0278:b001:l009","ordinal":12535,"en":"When I was left towering alone,"},{"id":"manas-2010:p0278:b001:l010","ordinal":12536,"en":"Alas, Manas, hear my words,"},{"id":"manas-2010:p0278:b001:l011","ordinal":12537,"en":"I fled and entered Mecca."},{"id":"manas-2010:p0278:b001:l012","ordinal":12538,"en":"I had no strength to turn back so;"},{"id":"manas-2010:p0278:b001:l013","ordinal":12539,"en":"Then I let myself be struck,"},{"id":"manas-2010:p0278:b001:l014","ordinal":12540,"en":"Bereft of heroes."},{"id":"manas-2010:p0278:b001:l015","ordinal":12541,"en":"Thinking, ‘Someone of the lineage will arise,’"},{"id":"manas-2010:p0278:b001:l016","ordinal":12542,"en":"I had made you my banner."},{"id":"manas-2010:p0278:b001:l017","ordinal":12543,"en":"Thinking, ‘When he is born, he will be Manas,’"},{"id":"manas-2010:p0278:b001:l018","ordinal":12544,"en":"I knew you before you were born."}]
