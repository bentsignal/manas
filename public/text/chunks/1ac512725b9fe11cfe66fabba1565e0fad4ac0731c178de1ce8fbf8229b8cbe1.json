[{"id":"semetey-1-2013:p0757:b004:l003","ordinal":134913,"en":"Manas's wife Akylai—"},{"id":"semetey-1-2013:p0757:b004:l004","ordinal":134914,"en":"Embracing Akylai,"},{"id":"semetey-1-2013:p0757:b004:l005","ordinal":134915,"en":"He lay there day and night."},{"id":"semetey-1-2013:p0757:b004:l006","ordinal":134916,"en":"Your uncle Kobosh, rumbling,"},{"id":"semetey-1-2013:p0757:b004:l007","ordinal":134917,"en":"Was immersed in great pleasure."},{"id":"semetey-1-2013:p0757:b004:l008","ordinal":134918,"en":"He would not rise, thundering away."},{"id":"semetey-1-2013:p0757:b004:l009","ordinal":134919,"en":"Kobosh would not wake; he rumbled."},{"id":"semetey-1-2013:p0757:b004:l010","ordinal":134920,"en":"God had taken bloodthirsty Manas."},{"id":"semetey-1-2013:p0757:b004:l011","ordinal":134921,"en":"The golden throne left by the Bloodthirsty One"},{"id":"semetey-1-2013:p0757:b004:l012","ordinal":134922,"en":"Kobosh had taken possession of."},{"id":"semetey-1-2013:p0757:b004:l013","ordinal":134923,"en":"Upon the golden throne"},{"id":"semetey-1-2013:p0757:b004:l014","ordinal":134924,"en":"Kobosh had taken Akylai."},{"id":"semetey-1-2013:p0757:b004:l015","ordinal":134925,"en":"Eating yearlings of barren mares,"},{"id":"semetey-1-2013:p0757:b004:l016","ordinal":134926,"en":"Eating frozen goat fat,"},{"id":"semetey-1-2013:p0757:b004:l017","ordinal":134927,"en":"Your foolish, heroic uncle Kobosh"},{"id":"semetey-1-2013:p0757:b004:l018","ordinal":134928,"en":"Lay there, swollen with arrogance."},{"id":"semetey-1-2013:p0757:b004:l019","ordinal":134929,"en":"If something occurred to him,"},{"id":"semetey-1-2013:p0757:b004:l020","ordinal":134930,"en":"Hero Kobosh would commit an outrage."},{"id":"semetey-1-2013:p0757:b004:l021","ordinal":134931,"en":"To impoverished widows and orphans,"},{"id":"semetey-1-2013:p0757:b004:l022","ordinal":134932,"en":"Hero Kobosh issued orders."},{"id":"semetey-1-2013:p0757:b004:l023","ordinal":134933,"en":"Anyone who crossed him"},{"id":"semetey-1-2013:p0757:b004:l024","ordinal":134934,"en":"He had shut in a pit."},{"id":"semetey-1-2013:p0757:b004:l025","ordinal":134935,"en":"Anyone who angered him"},{"id":"semetey-1-2013:p0757:b004:l026","ordinal":134936,"en":"He had beheaded with a sword."},{"id":"semetey-1-2013:p0757:b004:l027","ordinal":134937,"en":"Old and aged people,"},{"id":"semetey-1-2013:p0757:b004:l028","ordinal":134938,"en":"Elders grown decrepit,"},{"id":"semetey-1-2013:p0757:b004:l029","ordinal":134939,"en":"When a whim seized him,"},{"id":"semetey-1-2013:p0757:b004:l030","ordinal":134940,"en":"He made them work rawhide."},{"id":"semetey-1-2013:p0757:b004:l031","ordinal":134941,"en":"When a whim seized him,"},{"id":"semetey-1-2013:p0757:b004:l032","ordinal":134942,"en":"All those people"},{"id":"semetey-1-2013:p0757:b004:l033","ordinal":134943,"en":"He made dance for amusement."},{"id":"semetey-1-2013:p0757:b004:l034","ordinal":134944,"en":"All the countless people"},{"id":"semetey-1-2013:p0757:b004:l035","ordinal":134945,"en":"He wearied in just this way."},{"id":"semetey-1-2013:p0757:b004:l036","ordinal":134946,"en":"By force, hero Kobosh"},{"id":"semetey-1-2013:p0757:b004:l037","ordinal":134947,"en":"Made many lands submit."},{"id":"semetey-1-2013:p0757:b004:l038","ordinal":134948,"en":"He imposed heavy tribute on the people."},{"id":"semetey-1-2013:p0757:b004:l039","ordinal":134949,"en":"Unable to bear his tribute,"},{"id":"semetey-1-2013:p0758:b003:l001","ordinal":134950,"en":"The Argyn are left weeping."},{"id":"semetey-1-2013:p0758:b003:l002","ordinal":134951,"en":"Powerless against Kobosh,"},{"id":"semetey-1-2013:p0758:b003:l003","ordinal":134952,"en":"Many more go about loathing him."},{"id":"semetey-1-2013:p0758:b003:l004","ordinal":134953,"en":"‘Alas, Manas, do not die!’"},{"id":"semetey-1-2013:p0758:b003:l005","ordinal":134954,"en":"Many more keep yearning:"},{"id":"semetey-1-2013:p0758:b003:l006","ordinal":134955,"en":"‘While that Manas was alive,"},{"id":"semetey-1-2013:p0758:b003:l007","ordinal":134956,"en":"When bored, we would shoot roe deer;"},{"id":"semetey-1-2013:p0758:b003:l008","ordinal":134957,"en":"When not bored, we would lie at ease."},{"id":"semetey-1-2013:p0758:b003:l009","ordinal":134958,"en":"Riding horses in their third year, flying hawks,"},{"id":"semetey-1-2013:p0758:b003:l010","ordinal":134959,"en":"We played in wild delight."},{"id":"semetey-1-2013:p0758:b003:l011","ordinal":134960,"en":"How could we have known such hell?"},{"id":"semetey-1-2013:p0758:b003:l012","ordinal":134961,"en":"What could dear Kobosh do?"},{"id":"semetey-1-2013:p0758:b003:l013","ordinal":134962,"en":"He made calves carry loads,"},{"id":"semetey-1-2013:p0758:b003:l014","ordinal":134963,"en":"Made us endure such hell,"},{"id":"semetey-1-2013:p0758:b003:l015","ordinal":134964,"en":"Had the goat butcher slaughtered;"},{"id":"semetey-1-2013:p0758:b003:l016","ordinal":134965,"en":"He meant to make us suffer.’"},{"id":"semetey-1-2013:p0758:b003:l017","ordinal":134966,"en":"From time to time, growing violent,"},{"id":"semetey-1-2013:p0758:b003:l018","ordinal":134967,"en":"A khan like Kobosh arises;"},{"id":"semetey-1-2013:p0758:b003:l019","ordinal":134968,"en":"His voice drives the soul out."},{"id":"semetey-1-2013:p0758:b003:l020","ordinal":134969,"en":"When Köbösh drew back and struck,"},{"id":"semetey-1-2013:p0758:b003:l021","ordinal":134970,"en":"Immersed in many pleasures,"},{"id":"semetey-1-2013:p0758:b003:l022","ordinal":134971,"en":"As Akylai and that Kobosh"},{"id":"semetey-1-2013:p0758:b003:l023","ordinal":134972,"en":"Lay entwined together,"},{"id":"semetey-1-2013:p0758:b003:l024","ordinal":134973,"en":"Manas's son, the orphan slave,"},{"id":"semetey-1-2013:p0758:b003:l025","ordinal":134974,"en":"Was sorely troubled in his thoughts."},{"id":"semetey-1-2013:p0758:b003:l026","ordinal":134975,"en":"The orphan who had wandered here"},{"id":"semetey-1-2013:p0758:b003:l027","ordinal":134976,"en":"Shed tears from his eyes."},{"id":"semetey-1-2013:p0758:b003:l028","ordinal":134977,"en":"As though his father had died today,"},{"id":"semetey-1-2013:p0758:b003:l029","ordinal":134978,"en":"His mind was sorely troubled."},{"id":"semetey-1-2013:p0758:b003:l030","ordinal":134979,"en":"At his pompous uncle Kobosh,"},{"id":"semetey-1-2013:p0758:b003:l031","ordinal":134980,"en":"He seemed to grow angry:"},{"id":"semetey-1-2013:p0758:b003:l032","ordinal":134981,"en":"‘Who pledged allegiance to twelve spiritual guides—"},{"id":"semetey-1-2013:p0758:b003:l033","ordinal":134982,"en":"May my holy father never die!"},{"id":"semetey-1-2013:p0758:b003:l034","ordinal":134983,"en":"May I never be left fatherless!"},{"id":"semetey-1-2013:p0758:b003:l035","ordinal":134984,"en":"Such humiliation as this—"},{"id":"semetey-1-2013:p0758:b003:l036","ordinal":134985,"en":"May no mortal be made to suffer it!’"},{"id":"semetey-1-2013:p0758:b003:l037","ordinal":134986,"en":"Steeling himself, burning within,"},{"id":"semetey-1-2013:p0758:b003:l038","ordinal":134987,"en":"The orphan could not stand watching."},{"id":"semetey-1-2013:p0758:b003:l039","ordinal":134988,"en":"The warrior born of Manas—"},{"id":"semetey-1-2013:p0758:b004:l001","ordinal":134989,"en":"Here was where he would spread havoc."},{"id":"semetey-1-2013:p0758:b004:l002","ordinal":134990,"en":"The orphan now made a stir;"},{"id":"semetey-1-2013:p0758:b004:l003","ordinal":134991,"en":"Of Manas, gone to the world to come,"},{"id":"semetey-1-2013:p0758:b004:l004","ordinal":134992,"en":"He stood demanding the possessions:"},{"id":"semetey-1-2013:p0758:b004:l005","ordinal":134993,"en":"‘Uncle Abyke, hear my words."},{"id":"semetey-1-2013:p0758:b004:l006","ordinal":134994,"en":"My father has died."},{"id":"semetey-1-2013:p0758:b004:l007","ordinal":134995,"en":"The countless riches left by my father—"},{"id":"semetey-1-2013:p0758:b004:l008","ordinal":134996,"en":"When you plundered and divided them,"},{"id":"semetey-1-2013:p0758:b004:l009","ordinal":134997,"en":"When you contrived matters thus,"},{"id":"semetey-1-2013:p0758:b004:l010","ordinal":134998,"en":"My poor widowed mother—"},{"id":"semetey-1-2013:p0758:b004:l011","ordinal":134999,"en":"When you struck and split her breast,"},{"id":"semetey-1-2013:p0758:b004:l012","ordinal":135000,"en":"To Temir Khan's city,"},{"id":"semetey-1-2013:p0758:b004:l013","ordinal":135001,"en":"When my mother went wandering,"},{"id":"semetey-1-2013:p0758:b004:l014","ordinal":135002,"en":"My dear mother Kanykei,"},{"id":"semetey-1-2013:p0758:b004:l015","ordinal":135003,"en":"When she fled toward Karakan,"},{"id":"semetey-1-2013:p0758:b004:l016","ordinal":135004,"en":"All the great wealth,"},{"id":"semetey-1-2013:p0758:b004:l017","ordinal":135005,"en":"When you ruined and scattered it,"},{"id":"semetey-1-2013:p0758:b004:l018","ordinal":135006,"en":"In those days, when you plundered the valuables,"},{"id":"semetey-1-2013:p0758:b004:l019","ordinal":135007,"en":"When the boar stirred up trouble,"},{"id":"semetey-1-2013:p0758:b004:l020","ordinal":135008,"en":"Ten days after my father died,"},{"id":"semetey-1-2013:p0758:b004:l021","ordinal":135009,"en":"Toward my unfortunate mother,"},{"id":"semetey-1-2013:p0758:b004:l022","ordinal":135010,"en":"When you became a predator,"},{"id":"semetey-1-2013:p0758:b004:l023","ordinal":135011,"en":"Every treasure, wealth and possession,"},{"id":"semetey-1-2013:p0758:b004:l024","ordinal":135012,"en":"When you took it as booty,"},{"id":"semetey-1-2013:p0758:b004:l025","ordinal":135013,"en":"While I was still in the cradle,"},{"id":"semetey-1-2013:p0758:b004:l026","ordinal":135014,"en":"My mother Chiyirdi,"},{"id":"semetey-1-2013:p0758:b004:l027","ordinal":135015,"en":"When she pulled me out and fled straight ahead,"},{"id":"semetey-1-2013:p0758:b004:l028","ordinal":135016,"en":"My cradle standing empty,"},{"id":"semetey-1-2013:p0758:b004:l029","ordinal":135017,"en":"My brave mother Kanykei,"},{"id":"semetey-1-2013:p0758:b004:l030","ordinal":135018,"en":"The slave woman's child,"},{"id":"semetey-1-2013:p0758:b004:l031","ordinal":135019,"en":"Taking him from his swaddling clothes,"},{"id":"semetey-1-2013:p0758:b004:l032","ordinal":135020,"en":"When she bound him in the cradle,"},{"id":"semetey-1-2013:p0758:b004:l033","ordinal":135021,"en":"My mother nursing him,"},{"id":"semetey-1-2013:p0758:b004:l034","ordinal":135022,"en":"When she put her breast in his mouth,"},{"id":"semetey-1-2013:p0758:b004:l035","ordinal":135023,"en":"Your shouting split stones."},{"id":"semetey-1-2013:p0758:b004:l036","ordinal":135024,"en":"Upon my wretched mother,"},{"id":"semetey-1-2013:p0758:b004:l037","ordinal":135025,"en":"When you burst in raging,"},{"id":"semetey-1-2013:p0758:b004:l038","ordinal":135026,"en":"You found just the right way!"},{"id":"semetey-1-2013:p0758:b004:l039","ordinal":135027,"en":"Striking my mother with a battle-axe—"},{"id":"semetey-1-2013:p0759:b003:l001","ordinal":135028,"en":"You struck her down, screaming."},{"id":"semetey-1-2013:p0759:b003:l002","ordinal":135029,"en":"Knew my mother would choose a hero."},{"id":"semetey-1-2013:p0759:b003:l004","ordinal":135030,"en":"The treasury left by Manas,"},{"id":"semetey-1-2013:p0759:b003:l005","ordinal":135031,"en":"You plundered it utterly."},{"id":"semetey-1-2013:p0759:b003:l006","ordinal":135032,"en":"Thus you did just as you pleased."},{"id":"semetey-1-2013:p0759:b003:l007","ordinal":135033,"en":"The wealth left by my father,"},{"id":"semetey-1-2013:p0759:b003:l008","ordinal":135034,"en":"You took as booty and rested content."},{"id":"semetey-1-2013:p0759:b003:l009","ordinal":135035,"en":"Until I reached twelve years of age,"},{"id":"semetey-1-2013:p0759:b003:l010","ordinal":135036,"en":"Because of you, my elder kinsmen,"},{"id":"semetey-1-2013:p0759:b003:l011","ordinal":135037,"en":"Because of your foolish deeds,"},{"id":"semetey-1-2013:p0759:b003:l012","ordinal":135038,"en":"Into Temir Khan's city"},{"id":"semetey-1-2013:p0759:b003:l013","ordinal":135039,"en":"I wandered and made a living;"},{"id":"semetey-1-2013:p0759:b003:l014","ordinal":135040,"en":"Into Kara Khan's city"},{"id":"semetey-1-2013:p0759:b003:l015","ordinal":135041,"en":"I fled and made a living."},{"id":"semetey-1-2013:p0759:b003:l016","ordinal":135042,"en":"When we wandered to Temir Khan,"},{"id":"semetey-1-2013:p0759:b003:l017","ordinal":135043,"en":"As for me, still in swaddling clothes,"},{"id":"semetey-1-2013:p0759:b003:l018","ordinal":135044,"en":"“Upon my child while he is young,"},{"id":"semetey-1-2013:p0759:b003:l019","ordinal":135045,"en":"Someone will bring suffering,” she thought."},{"id":"semetey-1-2013:p0759:b003:l020","ordinal":135046,"en":"My mother Kanykei"},{"id":"semetey-1-2013:p0759:b003:l021","ordinal":135047,"en":"She cut through my twig,"},{"id":"semetey-1-2013:p0759:b003:l022","ordinal":135048,"en":"The cutting rite she performed for me,"},{"id":"semetey-1-2013:p0759:b003:l023","ordinal":135049,"en":"Made me step over a dog's bowl,"},{"id":"semetey-1-2013:p0759:b003:l024","ordinal":135050,"en":"Made me step across a sword's edge."},{"id":"semetey-1-2013:p0759:b003:l025","ordinal":135051,"en":"Thus she suffered humiliation;"},{"id":"semetey-1-2013:p0759:b003:l026","ordinal":135052,"en":"She gave me to her own brother Ysmayyl."},{"id":"semetey-1-2013:p0759:b003:l027","ordinal":135053,"en":"When holy sages spread their hands,"},{"id":"semetey-1-2013:p0759:b003:l028","ordinal":135054,"en":"I knew nothing of blessings;"},{"id":"semetey-1-2013:p0759:b003:l029","ordinal":135055,"en":"Of Manas, gone to the other world,"},{"id":"semetey-1-2013:p0759:b003:l030","ordinal":135056,"en":"I knew nothing of his being my father."},{"id":"semetey-1-2013:p0759:b003:l031","ordinal":135057,"en":"A wretched soul born to such a fate,"},{"id":"semetey-1-2013:p0759:b003:l032","ordinal":135058,"en":"I grew up wandering."},{"id":"semetey-1-2013:p0759:b003:l033","ordinal":135059,"en":"Circling around you,"},{"id":"semetey-1-2013:p0759:b003:l034","ordinal":135060,"en":"Until I reached twelve,"},{"id":"semetey-1-2013:p0759:b003:l035","ordinal":135061,"en":"Temir Khan's little camel,"},{"id":"semetey-1-2013:p0759:b003:l036","ordinal":135062,"en":"Ysmayyl's son—"},{"id":"semetey-1-2013:p0759:b003:l037","ordinal":135063,"en":"That was what I was, poor soul."},{"id":"semetey-1-2013:p0759:b003:l038","ordinal":135064,"en":"When I reached twelve years of age,"},{"id":"semetey-1-2013:p0759:b003:l039","ordinal":135065,"en":"Finding no mountain to hurl myself against,"},{"id":"semetey-1-2013:p0759:b004:l001","ordinal":135066,"en":"Finding no foe to fight,"},{"id":"semetey-1-2013:p0759:b004:l002","ordinal":135067,"en":"Finding no head to wrench off,"},{"id":"semetey-1-2013:p0759:b004:l003","ordinal":135068,"en":"Finding no stone to bite,"},{"id":"semetey-1-2013:p0759:b004:l004","ordinal":135069,"en":"I locked up the wandering dervishes,"},{"id":"semetey-1-2013:p0759:b004:l005","ordinal":135070,"en":"I beat the mendicants."},{"id":"semetey-1-2013:p0759:b004:l006","ordinal":135071,"en":"If I saw a khoja, I kicked him"},{"id":"semetey-1-2013:p0759:b004:l007","ordinal":135072,"en":"And locked him in his mosque."},{"id":"semetey-1-2013:p0759:b004:l008","ordinal":135073,"en":"When they saw my wild behavior,"},{"id":"semetey-1-2013:p0759:b004:l009","ordinal":135074,"en":"All the people of Bukhara grew weary."},{"id":"semetey-1-2013:p0759:b004:l010","ordinal":135075,"en":"Temir Khan took fright;"},{"id":"semetey-1-2013:p0759:b004:l011","ordinal":135076,"en":"His mind alarmed, he pondered,"},{"id":"semetey-1-2013:p0759:b004:l012","ordinal":135077,"en":"And gathered the people of eight khans."},{"id":"semetey-1-2013:p0759:b004:l013","ordinal":135078,"en":"Then the widow Kanykei,"},{"id":"semetey-1-2013:p0759:b004:l014","ordinal":135079,"en":"When Taitoru was sixty asy old,"},{"id":"semetey-1-2013:p0759:b004:l015","ordinal":135080,"en":"Entered Taitoru in the race."},{"id":"semetey-1-2013:p0759:b004:l016","ordinal":135081,"en":"Kanykei's Taitoru"},{"id":"semetey-1-2013:p0759:b004:l017","ordinal":135082,"en":"To the great city of Bukhara"},{"id":"semetey-1-2013:p0759:b004:l018","ordinal":135083,"en":"Came far out in front."},{"id":"semetey-1-2013:p0759:b004:l019","ordinal":135084,"en":"The many prizes in Bukhara,"},{"id":"semetey-1-2013:p0759:b004:l020","ordinal":135085,"en":"I gathered them all."},{"id":"semetey-1-2013:p0759:b004:l021","ordinal":135086,"en":"Not taking half a coin's worth of goods,"},{"id":"semetey-1-2013:p0759:b004:l022","ordinal":135087,"en":"Not taking half a penny's worth of hair,"},{"id":"semetey-1-2013:p0759:b004:l023","ordinal":135088,"en":"To all the wrestlers"},{"id":"semetey-1-2013:p0759:b004:l024","ordinal":135089,"en":"I gave them as booty."},{"id":"semetey-1-2013:p0759:b004:l025","ordinal":135090,"en":"Those watching crowded round;"},{"id":"semetey-1-2013:p0759:b004:l026","ordinal":135091,"en":"The people looked on in wonder."},{"id":"semetey-1-2013:p0759:b004:l027","ordinal":135092,"en":"When the crowd had gathered,"},{"id":"semetey-1-2013:p0759:b004:l028","ordinal":135093,"en":"Offering a thousand dark camels,"},{"id":"semetey-1-2013:p0759:b004:l029","ordinal":135094,"en":"Offering a thousand black mares with white blazes,"},{"id":"semetey-1-2013:p0759:b004:l030","ordinal":135095,"en":"Temir Khan proclaimed:"},{"id":"semetey-1-2013:p0759:b004:l031","ordinal":135096,"en":"“Let the wrestlers wrestle on foot;"},{"id":"semetey-1-2013:p0759:b004:l032","ordinal":135097,"en":"Let the loser go empty-handed!”"},{"id":"semetey-1-2013:p0759:b004:l033","ordinal":135098,"en":"Making it known to the people,"},{"id":"semetey-1-2013:p0759:b004:l034","ordinal":135099,"en":"He made his proclamation"},{"id":"semetey-1-2013:p0759:b004:l035","ordinal":135100,"en":"And gave his stern command."},{"id":"semetey-1-2013:p0759:b004:l036","ordinal":135101,"en":"From Kokand came Too-Balban;"},{"id":"semetey-1-2013:p0759:b004:l037","ordinal":135102,"en":"From Bukhara came Ak-Balban."},{"id":"semetey-1-2013:p0759:b004:l038","ordinal":135103,"en":"The champions wrestled on foot,"},{"id":"semetey-1-2013:p0759:b004:l039","ordinal":135104,"en":"Clashing like gray bulls."},{"id":"semetey-1-2013:p0760:b003:l001","ordinal":135105,"en":"Biting like stallions,"},{"id":"semetey-1-2013:p0760:b003:l002","ordinal":135106,"en":"Gnashing like hungry male camels,"},{"id":"semetey-1-2013:p0760:b003:l003","ordinal":135107,"en":"Gripping one another's trouser legs,"},{"id":"semetey-1-2013:p0760:b003:l004","ordinal":135108,"en":"Tripping each other without sparing their lives."},{"id":"semetey-1-2013:p0760:b003:l005","ordinal":135109,"en":"That Ak-Balban of Bukhara"},{"id":"semetey-1-2013:p0760:b003:l006","ordinal":135110,"en":"Grew weak;"},{"id":"semetey-1-2013:p0760:b003:l007","ordinal":135111,"en":"Too-Balban of Kokand"},{"id":"semetey-1-2013:p0760:b003:l008","ordinal":135112,"en":"Lifted him and dashed him down."},{"id":"semetey-1-2013:p0760:b003:l009","ordinal":135113,"en":"When all the many prizes of Bukhara"},{"id":"semetey-1-2013:p0760:b003:l010","ordinal":135114,"en":"He drove away,"},{"id":"semetey-1-2013:p0760:b003:l011","ordinal":135115,"en":"Wrestling with Too-Balban,"},{"id":"semetey-1-2013:p0760:b003:l012","ordinal":135116,"en":"Semetey put him to torment."},{"id":"semetey-1-2013:p0760:b003:l013","ordinal":135117,"en":"A champion such as Too-Balban"},{"id":"semetey-1-2013:p0760:b003:l014","ordinal":135118,"en":"He lifted and dashed once to the ground;"},{"id":"semetey-1-2013:p0760:b003:l015","ordinal":135119,"en":"When he tore his arm out,"},{"id":"semetey-1-2013:p0760:b003:l016","ordinal":135120,"en":"Through this, Too-Balban"},{"id":"semetey-1-2013:p0760:b003:l017","ordinal":135121,"en":"Met his death."},{"id":"semetey-1-2013:p0760:b003:l018","ordinal":135122,"en":"“He will surpass Manas,”"},{"id":"semetey-1-2013:p0760:b003:l019","ordinal":135123,"en":"All the people began to whisper."},{"id":"semetey-1-2013:p0760:b003:l021","ordinal":135124,"en":"Not content to stop at that,"},{"id":"semetey-1-2013:p0760:b003:l022","ordinal":135125,"en":"The mount beneath me"},{"id":"semetey-1-2013:p0760:b003:l023","ordinal":135126,"en":"Was Temir Khan's Aktulpar;"},{"id":"semetey-1-2013:p0760:b003:l024","ordinal":135127,"en":"What I held on my hand"},{"id":"semetey-1-2013:p0760:b003:l025","ordinal":135128,"en":"Was Ysmayyl's falcon."},{"id":"semetey-1-2013:p0760:b003:l026","ordinal":135129,"en":"I went out flying the falcon"},{"id":"semetey-1-2013:p0760:b003:l027","ordinal":135130,"en":"And heard the bald charcoal burner's words."},{"id":"semetey-1-2013:p0760:b003:l028","ordinal":135131,"en":"“Your great people are the Kyrgyz,” I heard."},{"id":"semetey-1-2013:p0760:b003:l029","ordinal":135132,"en":"“Your horse has a white blaze,"},{"id":"semetey-1-2013:p0760:b003:l030","ordinal":135133,"en":"Your father is someone else.”"},{"id":"semetey-1-2013:p0760:b003:l031","ordinal":135134,"en":"Sarytaz said a word;"},{"id":"semetey-1-2013:p0760:b003:l032","ordinal":135135,"en":"He put a troubling word into my thoughts."},{"id":"semetey-1-2013:p0760:b003:l033","ordinal":135136,"en":"I heard the words of that damned bald man:"},{"id":"semetey-1-2013:p0760:b003:l034","ordinal":135137,"en":"“My people are the Kyrgyz,” I heard."},{"id":"semetey-1-2013:p0760:b003:l035","ordinal":135138,"en":"“Manas is your father,"},{"id":"semetey-1-2013:p0760:b003:l036","ordinal":135139,"en":"Talas is your land,"},{"id":"semetey-1-2013:p0760:b003:l037","ordinal":135140,"en":"Kanykei is your mother,"},{"id":"semetey-1-2013:p0760:b003:l038","ordinal":135141,"en":"Ysmayyl is your mother's brother;"},{"id":"semetey-1-2013:p0760:b003:l039","ordinal":135142,"en":"Abyke and Kobosh in Talas are your elder kinsmen;"},{"id":"semetey-1-2013:p0760:b004:l001","ordinal":135143,"en":"Akun Khan is your father-in-law,"},{"id":"semetey-1-2013:p0760:b004:l002","ordinal":135144,"en":"Aichurok is your wife.”"},{"id":"semetey-1-2013:p0760:b004:l003","ordinal":135145,"en":"Sarytaz said a word;"},{"id":"semetey-1-2013:p0760:b004:l004","ordinal":135146,"en":"He put a troubling word into my thoughts."},{"id":"semetey-1-2013:p0760:b004:l005","ordinal":135147,"en":"I chose to mount Aktulpar;"},{"id":"semetey-1-2013:p0760:b004:l006","ordinal":135148,"en":"And came expressly in search of you."},{"id":"semetey-1-2013:p0760:b004:l007","ordinal":135149,"en":"From far away I came of my own will,"},{"id":"semetey-1-2013:p0760:b004:l008","ordinal":135150,"en":"Saying, “Abyke and Kobosh are my kin.”"},{"id":"semetey-1-2013:p0760:b004:l009","ordinal":135151,"en":"You whom I regard in my father's place,"},{"id":"semetey-1-2013:p0760:b004:l010","ordinal":135152,"en":"Abyke, on whom I lean,"},{"id":"semetey-1-2013:p0760:b004:l011","ordinal":135153,"en":"Hear the words I mean to say."},{"id":"semetey-1-2013:p0760:b004:l012","ordinal":135154,"en":"Kumaiyk, left by my father Manas,"},{"id":"semetey-1-2013:p0760:b004:l013","ordinal":135155,"en":"That keen hunter known to the people,"},{"id":"semetey-1-2013:p0760:b004:l014","ordinal":135156,"en":"The inheritance left by my father Manas,"},{"id":"semetey-1-2013:p0760:b004:l015","ordinal":135157,"en":"From the banks of great Talas"},{"id":"semetey-1-2013:p0760:b004:l016","ordinal":135158,"en":"Has strayed into your keeping."},{"id":"semetey-1-2013:p0760:b004:l017","ordinal":135159,"en":"Where is that treasure, the white sighthound?"},{"id":"semetey-1-2013:p0760:b004:l018","ordinal":135160,"en":"Tell me what has become of him."},{"id":"semetey-1-2013:p0760:b004:l019","ordinal":135161,"en":"Long ago, the bird a kite hatched and raised,"},{"id":"semetey-1-2013:p0760:b004:l020","ordinal":135162,"en":"God Almighty, to my khan father,"},{"id":"semetey-1-2013:p0760:b004:l021","ordinal":135163,"en":"Brought it to Khan Manas—"},{"id":"semetey-1-2013:p0760:b004:l022","ordinal":135164,"en":"His talons iron, his jess fastener copper,"},{"id":"semetey-1-2013:p0760:b004:l023","ordinal":135165,"en":"Two cubits in girth,"},{"id":"semetey-1-2013:p0760:b004:l024","ordinal":135166,"en":"Whose striking talons never missed,"},{"id":"semetey-1-2013:p0760:b004:l025","ordinal":135167,"en":"Whom no keen hunting bird could match,"},{"id":"semetey-1-2013:p0760:b004:l026","ordinal":135168,"en":"Black-eyed, with speckled legs,"}]
