[{"id":"semetey-1-2013:p0103:b003:l038","ordinal":84737,"en":"Let me return within six days.”"},{"id":"semetey-1-2013:p0103:b003:l039","ordinal":84738,"en":"So spoke Khan Bakai,"},{"id":"semetey-1-2013:p0103:b004:l001","ordinal":84739,"en":"Shaking hands and saying farewell."},{"id":"semetey-1-2013:p0103:b004:l002","ordinal":84740,"en":"Their hearts were torn apart;"},{"id":"semetey-1-2013:p0103:b004:l003","ordinal":84741,"en":"Tears poured down."},{"id":"semetey-1-2013:p0103:b004:l004","ordinal":84742,"en":"The widow cried out weeping."},{"id":"semetey-1-2013:p0103:b004:l005","ordinal":84743,"en":"When Khan Bakai said he would go,"},{"id":"semetey-1-2013:p0103:b004:l006","ordinal":84744,"en":"As though his father were departing,"},{"id":"semetey-1-2013:p0103:b004:l007","ordinal":84745,"en":"Unable to find any peace,"},{"id":"semetey-1-2013:p0103:b004:l008","ordinal":84746,"en":"The orphan too sobbed bitterly."},{"id":"semetey-1-2013:p0103:b004:l009","ordinal":84747,"en":"Chyiyrdy grieved and wept,"},{"id":"semetey-1-2013:p0103:b004:l010","ordinal":84748,"en":"Giving Bakai her solemn charge:"},{"id":"semetey-1-2013:p0103:b004:l011","ordinal":84749,"en":"“My hiding place is a stone cave;"},{"id":"semetey-1-2013:p0103:b004:l012","ordinal":84750,"en":"Semetey is my hope."},{"id":"semetey-1-2013:p0103:b004:l013","ordinal":84751,"en":"Hero Bakai, my strength to rely upon,"},{"id":"semetey-1-2013:p0103:b004:l014","ordinal":84752,"en":"Hear my words clearly."},{"id":"semetey-1-2013:p0103:b004:l015","ordinal":84753,"en":"If God grants a clear road,"},{"id":"semetey-1-2013:p0103:b004:l016","ordinal":84754,"en":"My Bakai, return and look into my eyes."},{"id":"semetey-1-2013:p0103:b004:l017","ordinal":84755,"en":"Survey the junction of Ken-Kol and return,"},{"id":"semetey-1-2013:p0103:b004:l018","ordinal":84756,"en":"Saintly Bakai, Kojosan."},{"id":"semetey-1-2013:p0103:b004:l019","ordinal":84757,"en":"Keep Semetey in your thoughts—"},{"id":"semetey-1-2013:p0103:b004:l020","ordinal":84758,"en":"Your only one, your orphan."},{"id":"semetey-1-2013:p0103:b004:l021","ordinal":84759,"en":"Let me be your sacrifice, Khan Bakai!"},{"id":"semetey-1-2013:p0103:b004:l022","ordinal":84760,"en":"Do not charge off in exhaustion"},{"id":"semetey-1-2013:p0103:b004:l023","ordinal":84761,"en":"To the six villains; return."},{"id":"semetey-1-2013:p0103:b004:l024","ordinal":84762,"en":"We remain in the wilderness."},{"id":"semetey-1-2013:p0103:b004:l025","ordinal":84763,"en":"Khan Bakai, come back within six days!"},{"id":"semetey-1-2013:p0103:b004:l027","ordinal":84764,"en":"You were an impetuous hero."},{"id":"semetey-1-2013:p0103:b004:l028","ordinal":84765,"en":"Khan Bakai, return without scouting Talas's junction."},{"id":"semetey-1-2013:p0103:b004:l030","ordinal":84766,"en":"We remain in a cave in the earth."},{"id":"semetey-1-2013:p0103:b004:l031","ordinal":84767,"en":"Accomplished Bakai the leopard,"},{"id":"semetey-1-2013:p0103:b004:l032","ordinal":84768,"en":"Come back within seven days!"},{"id":"semetey-1-2013:p0103:b004:l033","ordinal":84769,"en":"If you stay beyond seven days,"},{"id":"semetey-1-2013:p0103:b004:l034","ordinal":84770,"en":"Grieving and weeping without cease,"},{"id":"semetey-1-2013:p0103:b004:l035","ordinal":84771,"en":"We shall abandon hope of you."},{"id":"semetey-1-2013:p0103:b004:l036","ordinal":84772,"en":"We shall scatter the wild sheep's meat"},{"id":"semetey-1-2013:p0103:b004:l037","ordinal":84773,"en":"And walk away weeping in exhaustion."},{"id":"semetey-1-2013:p0103:b004:l038","ordinal":84774,"en":"Oh, Khan Bakai, my foal,"},{"id":"semetey-1-2013:p0103:b004:l039","ordinal":84775,"en":"We shall watch the hills,"},{"id":"semetey-1-2013:p0104:b003:l001","ordinal":84776,"en":"We shall grieve for six days."},{"id":"semetey-1-2013:p0104:b003:l002","ordinal":84777,"en":"If you stay beyond six days,"},{"id":"semetey-1-2013:p0104:b003:l003","ordinal":84778,"en":"We shall scatter the wild ram's meat."},{"id":"semetey-1-2013:p0104:b003:l004","ordinal":84779,"en":"Despairing of you, the renowned one,"},{"id":"semetey-1-2013:p0104:b003:l005","ordinal":84780,"en":"Oh, Khan Bakai, my foal,"},{"id":"semetey-1-2013:p0104:b003:l006","ordinal":84781,"en":"We shall wander away over the ridge."},{"id":"semetey-1-2013:p0104:b003:l007","ordinal":84782,"en":"The spring that flows from the hills,"},{"id":"semetey-1-2013:p0104:b003:l008","ordinal":84783,"en":"Do not forget, Khan Bakai—"},{"id":"semetey-1-2013:p0104:b003:l009","ordinal":84784,"en":"The orphan Magnanimous Manas left behind!”"},{"id":"semetey-1-2013:p0104:b003:l010","ordinal":84785,"en":"So Chyiyrdy spoke,"},{"id":"semetey-1-2013:p0104:b003:l011","ordinal":84786,"en":"Showing her widow's plight."},{"id":"semetey-1-2013:p0104:b003:l012","ordinal":84787,"en":"Before the accomplished lord Bakai,"},{"id":"semetey-1-2013:p0104:b003:l013","ordinal":84788,"en":"The child, solid as a tombstone,"},{"id":"semetey-1-2013:p0104:b003:l014","ordinal":84789,"en":"She made wave his limbs and laugh."},{"id":"semetey-1-2013:p0104:b003:l015","ordinal":84790,"en":"Khan Bakai took him as his hope,"},{"id":"semetey-1-2013:p0104:b003:l016","ordinal":84791,"en":"Saying, ‘The morning star my lord left,"},{"id":"semetey-1-2013:p0104:b003:l017","ordinal":84792,"en":"Our willow growing beside the river,"},{"id":"semetey-1-2013:p0104:b003:l018","ordinal":84793,"en":"The only child Manas left behind.’"},{"id":"semetey-1-2013:p0104:b003:l020","ordinal":84794,"en":"Saying this, Khan Bakai—"},{"id":"semetey-1-2013:p0104:b003:l021","ordinal":84795,"en":"Allah's sun clouded over in the sky."},{"id":"semetey-1-2013:p0104:b003:l022","ordinal":84796,"en":"His heart burned in bitter grief;"},{"id":"semetey-1-2013:p0104:b003:l023","ordinal":84797,"en":"Sixty cares came into his head."},{"id":"semetey-1-2013:p0104:b003:l024","ordinal":84798,"en":"His tongue tied, he could not speak;"},{"id":"semetey-1-2013:p0104:b003:l025","ordinal":84799,"en":"His heart turned sick."},{"id":"semetey-1-2013:p0104:b003:l026","ordinal":84800,"en":"Unable to keep looking at the orphan,"},{"id":"semetey-1-2013:p0104:b003:l027","ordinal":84801,"en":"The poor man turned his horse's head."},{"id":"semetey-1-2013:p0104:b003:l029","ordinal":84802,"en":"Entrusting him as a precious charge,"},{"id":"semetey-1-2013:p0104:b003:l030","ordinal":84803,"en":"Khan Bakai set out toward Talas."},{"id":"semetey-1-2013:p0104:b003:l032","ordinal":84804,"en":"The banner fluttered in his hand."},{"id":"semetey-1-2013:p0104:b003:l033","ordinal":84805,"en":"The gold-cheeked battle-axe"},{"id":"semetey-1-2013:p0104:b003:l034","ordinal":84806,"en":"Glittered at his wrist."},{"id":"semetey-1-2013:p0104:b003:l035","ordinal":84807,"en":"Blue boots stood stiff upon his feet;"},{"id":"semetey-1-2013:p0104:b003:l036","ordinal":84808,"en":"A blue spear stood erect in his hand."},{"id":"semetey-1-2013:p0104:b003:l037","ordinal":84809,"en":"His fearsome sword hung at his side."},{"id":"semetey-1-2013:p0104:b003:l038","ordinal":84810,"en":"If you considered your uncle Bakai,"},{"id":"semetey-1-2013:p0104:b003:l039","ordinal":84811,"en":"He appeared an enormous mountain."},{"id":"semetey-1-2013:p0104:b004:l001","ordinal":84812,"en":"Blue flame came from his mouth,"},{"id":"semetey-1-2013:p0104:b004:l002","ordinal":84813,"en":"Hissing here and there."},{"id":"semetey-1-2013:p0104:b004:l003","ordinal":84814,"en":"His precious teeth, broad as doors,"},{"id":"semetey-1-2013:p0104:b004:l004","ordinal":84815,"en":"Crunched as though grinding millet."},{"id":"semetey-1-2013:p0104:b004:l005","ordinal":84816,"en":"Changing aspect with each step,"},{"id":"semetey-1-2013:p0104:b004:l006","ordinal":84817,"en":"He muttered against Talas's six villains."},{"id":"semetey-1-2013:p0104:b004:l007","ordinal":84818,"en":"His face was like oiled wheat;"},{"id":"semetey-1-2013:p0104:b004:l008","ordinal":84819,"en":"His eyes were like dark mist."},{"id":"semetey-1-2013:p0104:b004:l009","ordinal":84820,"en":"As he rode, curses broke from him;"},{"id":"semetey-1-2013:p0104:b004:l010","ordinal":84821,"en":"He seemed a life-taking demon."},{"id":"semetey-1-2013:p0104:b004:l011","ordinal":84822,"en":"At a careless glance, a thousand men;"},{"id":"semetey-1-2013:p0104:b004:l012","ordinal":84823,"en":"Look closely, and he was one."},{"id":"semetey-1-2013:p0104:b004:l013","ordinal":84824,"en":"Lucky when sent ahead—"},{"id":"semetey-1-2013:p0104:b004:l014","ordinal":84825,"en":"Such was your uncle, hero Bakai."},{"id":"semetey-1-2013:p0104:b004:l015","ordinal":84826,"en":"Behind you, worth a host of troops—"},{"id":"semetey-1-2013:p0104:b004:l016","ordinal":84827,"en":"Such was your champion, Lion Bakai."},{"id":"semetey-1-2013:p0104:b004:l017","ordinal":84828,"en":"Dying of sorrow,"},{"id":"semetey-1-2013:p0104:b004:l018","ordinal":84829,"en":"That was Bakai's time of grief."},{"id":"semetey-1-2013:p0104:b004:l020","ordinal":84830,"en":"That was the whiteness of his beard."},{"id":"semetey-1-2013:p0104:b004:l021","ordinal":84831,"en":"Without sparing his precious life,"},{"id":"semetey-1-2013:p0104:b004:l022","ordinal":84832,"en":"Your fierce Leopard Bakai"},{"id":"semetey-1-2013:p0104:b004:l023","ordinal":84833,"en":"Was setting out on his journey."},{"id":"semetey-1-2013:p0104:b004:l024","ordinal":84834,"en":"Concealing his frame, vast as Ken-Kol,"},{"id":"semetey-1-2013:p0104:b004:l025","ordinal":84835,"en":"On a day of grief and hardship,"},{"id":"semetey-1-2013:p0104:b004:l026","ordinal":84836,"en":"Khan Bakai rode in sorrow."},{"id":"semetey-1-2013:p0104:b004:l027","ordinal":84837,"en":"Having sent his Semetey into flight,"},{"id":"semetey-1-2013:p0104:b004:l028","ordinal":84838,"en":"His wings broken,"},{"id":"semetey-1-2013:p0104:b004:l029","ordinal":84839,"en":"He thought, ‘How can I stay alive?’"},{"id":"semetey-1-2013:p0104:b004:l030","ordinal":84840,"en":"That was his time of grief."},{"id":"semetey-1-2013:p0104:b004:l031","ordinal":84841,"en":"She whom he had relied upon,"},{"id":"semetey-1-2013:p0104:b004:l032","ordinal":84842,"en":"Parting from Kanykei,"},{"id":"semetey-1-2013:p0104:b004:l033","ordinal":84843,"en":"Mighty Bakai wished to die,"},{"id":"semetey-1-2013:p0104:b004:l034","ordinal":84844,"en":"But could not take his own life."},{"id":"semetey-1-2013:p0104:b004:l035","ordinal":84845,"en":"Unable to bear it, he howled and wept."},{"id":"semetey-1-2013:p0104:b004:l036","ordinal":84846,"en":"Ak Chybyk upon his broad shoulder,"},{"id":"semetey-1-2013:p0104:b004:l037","ordinal":84847,"en":"A spear glittering in his hand,"},{"id":"semetey-1-2013:p0104:b004:l038","ordinal":84848,"en":"The gray steed beneath him"},{"id":"semetey-1-2013:p0104:b004:l039","ordinal":84849,"en":"He lashed now on one side, now the other,"},{"id":"semetey-1-2013:p0105:b003:l001","ordinal":84850,"en":"Spurring on this side and that,"},{"id":"semetey-1-2013:p0105:b003:l002","ordinal":84851,"en":"Without looking around,"},{"id":"semetey-1-2013:p0105:b003:l003","ordinal":84852,"en":"Without sparing life at all,"},{"id":"semetey-1-2013:p0105:b003:l004","ordinal":84853,"en":"Without surveying his surroundings,"},{"id":"semetey-1-2013:p0105:b003:l005","ordinal":84854,"en":"Then Bakai the leopard"},{"id":"semetey-1-2013:p0105:b003:l006","ordinal":84855,"en":"Spared his life not a hair's breadth."},{"id":"semetey-1-2013:p0105:b003:l007","ordinal":84856,"en":"Khan Bakai's steed"},{"id":"semetey-1-2013:p0105:b003:l008","ordinal":84857,"en":"Had lowered its head to the earth."},{"id":"semetey-1-2013:p0105:b003:l009","ordinal":84858,"en":"The wind could not match its trot;"},{"id":"semetey-1-2013:p0105:b003:l010","ordinal":84859,"en":"It had broken into full flight."},{"id":"semetey-1-2013:p0105:b003:l011","ordinal":84860,"en":"No beast could match its stride;"},{"id":"semetey-1-2013:p0105:b003:l012","ordinal":84861,"en":"Its gallop had become extraordinary."},{"id":"semetey-1-2013:p0105:b003:l013","ordinal":84862,"en":"Tossing its forelock to the sky,"},{"id":"semetey-1-2013:p0105:b003:l014","ordinal":84863,"en":"Plunging its hooves into the earth,"},{"id":"semetey-1-2013:p0105:b003:l015","ordinal":84864,"en":"The black steel bit"},{"id":"semetey-1-2013:p0105:b003:l016","ordinal":84865,"en":"Clattering in its throat,"},{"id":"semetey-1-2013:p0105:b003:l017","ordinal":84866,"en":"Its tail, like strands of silk,"},{"id":"semetey-1-2013:p0105:b003:l018","ordinal":84867,"en":"Lashing its flanks,"},{"id":"semetey-1-2013:p0105:b003:l019","ordinal":84868,"en":"Its mouth gaping wide,"},{"id":"semetey-1-2013:p0105:b003:l020","ordinal":84869,"en":"White foam mixed with blood"},{"id":"semetey-1-2013:p0105:b003:l021","ordinal":84870,"en":"Splashed upon its breast."},{"id":"semetey-1-2013:p0105:b003:l022","ordinal":84871,"en":"Its feet thundered on the ground;"},{"id":"semetey-1-2013:p0105:b003:l023","ordinal":84872,"en":"The black steel bit"},{"id":"semetey-1-2013:p0105:b003:l024","ordinal":84873,"en":"Clashed in its throat."},{"id":"semetey-1-2013:p0105:b003:l025","ordinal":84874,"en":"When it ran downhill,"},{"id":"semetey-1-2013:p0105:b003:l026","ordinal":84875,"en":"Its forelegs struck like a deer's."},{"id":"semetey-1-2013:p0105:b003:l027","ordinal":84876,"en":"When it met rises and descents,"},{"id":"semetey-1-2013:p0105:b003:l028","ordinal":84877,"en":"Its mane and tail streamed out."},{"id":"semetey-1-2013:p0105:b003:l029","ordinal":84878,"en":"When it reached the level plain,"},{"id":"semetey-1-2013:p0105:b003:l030","ordinal":84879,"en":"It raced the flying birds."},{"id":"semetey-1-2013:p0105:b003:l031","ordinal":84880,"en":"The white reins in knotted braid"},{"id":"semetey-1-2013:p0105:b003:l032","ordinal":84881,"en":"Bakai pulled with both hands;"},{"id":"semetey-1-2013:p0105:b003:l033","ordinal":84882,"en":"Both his arms grew numb."},{"id":"semetey-1-2013:p0105:b003:l034","ordinal":84883,"en":"Jerking like a woman whose husband had died,"},{"id":"semetey-1-2013:p0105:b003:l035","ordinal":84884,"en":"That immeasurably swift steed—"},{"id":"semetey-1-2013:p0105:b003:l036","ordinal":84885,"en":"He wrestled with its mouth."},{"id":"semetey-1-2013:p0105:b003:l037","ordinal":84886,"en":"The ground it trod flew into fragments;"},{"id":"semetey-1-2013:p0105:b003:l038","ordinal":84887,"en":"Clods as large as little huts"},{"id":"semetey-1-2013:p0105:b003:l039","ordinal":84888,"en":"Whistled above its head."},{"id":"semetey-1-2013:p0105:b005:l001","ordinal":84889,"en":"Tearing up the face of the earth,"},{"id":"semetey-1-2013:p0105:b005:l002","ordinal":84890,"en":"Racing on the gray steed,"},{"id":"semetey-1-2013:p0105:b005:l003","ordinal":84891,"en":"Fierce Bakai the leopard,"},{"id":"semetey-1-2013:p0105:b005:l004","ordinal":84892,"en":"The saint who had seen so much,"},{"id":"semetey-1-2013:p0105:b005:l005","ordinal":84893,"en":"As dusk fell and the sun set,"},{"id":"semetey-1-2013:p0105:b005:l006","ordinal":84894,"en":"While the first people lay quiet,"},{"id":"semetey-1-2013:p0105:b005:l007","ordinal":84895,"en":"Spurred toward Talas"},{"id":"semetey-1-2013:p0105:b005:l008","ordinal":84896,"en":"And entered in the night."},{"id":"semetey-1-2013:p0105:b005:l009","ordinal":84897,"en":"Broad Budurmak valley—"},{"id":"semetey-1-2013:p0105:b005:l010","ordinal":84898,"en":"He searched its corner."},{"id":"semetey-1-2013:p0105:b005:l011","ordinal":84899,"en":"Finding no horses in the sheltered hollow,"},{"id":"semetey-1-2013:p0105:b005:l012","ordinal":84900,"en":"He turned aside."},{"id":"semetey-1-2013:p0105:b005:l013","ordinal":84901,"en":"Through Tekechi Khan's and Shygai Khan's lands"},{"id":"semetey-1-2013:p0105:b005:l014","ordinal":84902,"en":"He rode, trampling onward."},{"id":"semetey-1-2013:p0105:b005:l015","ordinal":84903,"en":"The broad valley of Zhylgynduu,"},{"id":"semetey-1-2013:p0105:b005:l016","ordinal":84904,"en":"He searched that broad valley."},{"id":"semetey-1-2013:p0105:b005:l017","ordinal":84905,"en":"“Vanish with your horses!"},{"id":"semetey-1-2013:p0105:b005:l018","ordinal":84906,"en":"Have I become one who merely smiles?”"},{"id":"semetey-1-2013:p0105:b005:l019","ordinal":84907,"en":"He grew furious."},{"id":"semetey-1-2013:p0105:b005:l020","ordinal":84908,"en":"The gray steed beneath him"},{"id":"semetey-1-2013:p0105:b005:l021","ordinal":84909,"en":"He struck with the whip."},{"id":"semetey-1-2013:p0105:b005:l022","ordinal":84910,"en":"Its flesh split like a sheep's;"},{"id":"semetey-1-2013:p0105:b005:l023","ordinal":84911,"en":"The gray steed under the lash"},{"id":"semetey-1-2013:p0105:b005:l024","ordinal":84912,"en":"Stretched its back like a hare."},{"id":"semetey-1-2013:p0105:b005:l025","ordinal":84913,"en":"At the mountain's final spur,"},{"id":"semetey-1-2013:p0105:b005:l026","ordinal":84914,"en":"At the blunt jutting point,"},{"id":"semetey-1-2013:p0105:b005:l027","ordinal":84915,"en":"Bakai pressed onward"},{"id":"semetey-1-2013:p0105:b005:l028","ordinal":84916,"en":"To Kara-Buura and Chatkal."},{"id":"semetey-1-2013:p0105:b005:l029","ordinal":84917,"en":"When the Kyrgyz lay at ease,"},{"id":"semetey-1-2013:p0105:b005:l030","ordinal":84918,"en":"When Khan Manas lived,"},{"id":"semetey-1-2013:p0105:b005:l031","ordinal":84919,"en":"Strong winds and breezes"},{"id":"semetey-1-2013:p0105:b005:l032","ordinal":84920,"en":"Would pass across the hills;"},{"id":"semetey-1-2013:p0105:b005:l033","ordinal":84921,"en":"The great mottled-headed herds"},{"id":"semetey-1-2013:p0105:b005:l034","ordinal":84922,"en":"Would come in to rest."},{"id":"semetey-1-2013:p0105:b005:l035","ordinal":84923,"en":"Bakai rode through,"},{"id":"semetey-1-2013:p0105:b005:l036","ordinal":84924,"en":"But finding no horses there,"},{"id":"semetey-1-2013:p0105:b005:l037","ordinal":84925,"en":"He grew furious."},{"id":"semetey-1-2013:p0105:b005:l038","ordinal":84926,"en":"To Kabak and Ak-Chiy"},{"id":"semetey-1-2013:p0105:b005:l039","ordinal":84927,"en":"He drove his horse and reached them."},{"id":"semetey-1-2013:p0106:b003:l001","ordinal":84928,"en":"Zhamgyrchy of the Eshteks—"},{"id":"semetey-1-2013:p0106:b003:l002","ordinal":84929,"en":"To Zhamgyrchy's great headquarters"},{"id":"semetey-1-2013:p0106:b003:l003","ordinal":84930,"en":"He rode, trampling onward."},{"id":"semetey-1-2013:p0106:b003:l004","ordinal":84931,"en":"Zhamgyrchy of the Eshteks"},{"id":"semetey-1-2013:p0106:b003:l005","ordinal":84932,"en":"Had donned an iron coat"},{"id":"semetey-1-2013:p0106:b003:l006","ordinal":84933,"en":"And mounted Telkyzyl."},{"id":"semetey-1-2013:p0106:b003:l007","ordinal":84934,"en":"Mottled-headed horses filled the hills,"},{"id":"semetey-1-2013:p0106:b003:l008","ordinal":84935,"en":"Khan Manas's countless horses,"},{"id":"semetey-1-2013:p0106:b003:l009","ordinal":84936,"en":"Thoroughbreds and chargers mingled."},{"id":"semetey-1-2013:p0106:b003:l010","ordinal":84937,"en":"When they had plundered the possessions,"},{"id":"semetey-1-2013:p0106:b003:l011","ordinal":84938,"en":"When the six villains came and wrought havoc,"},{"id":"semetey-1-2013:p0106:b003:l012","ordinal":84939,"en":"Extinguishing the fire he had kindled,"},{"id":"semetey-1-2013:p0106:b003:l013","ordinal":84940,"en":"Erasing Manas's name,"},{"id":"semetey-1-2013:p0106:b003:l014","ordinal":84941,"en":"Zhamgyrchy of the Eshteks"},{"id":"semetey-1-2013:p0106:b003:l015","ordinal":84942,"en":"Climbed a hill and shouted,"},{"id":"semetey-1-2013:p0106:b003:l016","ordinal":84943,"en":"Raising only the battle cry, “Kobosh!”"},{"id":"semetey-1-2013:p0106:b003:l017","ordinal":84944,"en":"He took possession of the horses,"},{"id":"semetey-1-2013:p0106:b003:l018","ordinal":84945,"en":"Acting the master from outside."},{"id":"semetey-1-2013:p0106:b003:l019","ordinal":84946,"en":"A whole otter pelt"},{"id":"semetey-1-2013:p0106:b003:l020","ordinal":84947,"en":"He had slit apart"},{"id":"semetey-1-2013:p0106:b003:l021","ordinal":84948,"en":"And tucked into his trouser cuff."},{"id":"semetey-1-2013:p0106:b003:l022","ordinal":84949,"en":"His nose bulged like a leather bottle."},{"id":"semetey-1-2013:p0106:b003:l023","ordinal":84950,"en":"(Claiming ownership of the horses,"},{"id":"semetey-1-2013:p0106:b003:l024","ordinal":84951,"en":"He swelled as though their master.)"},{"id":"semetey-1-2013:p0106:b003:l025","ordinal":84952,"en":"When you looked at Zhamgyrchy,"},{"id":"semetey-1-2013:p0106:b003:l026","ordinal":84953,"en":"He swelled like a slave whose master had died."},{"id":"semetey-1-2013:p0106:b003:l027","ordinal":84954,"en":"When Bakai came to the bluff,"},{"id":"semetey-1-2013:p0106:b003:l028","ordinal":84955,"en":"He shouted in anger,"},{"id":"semetey-1-2013:p0106:b003:l029","ordinal":84956,"en":"Calling, “Who are you?”"},{"id":"semetey-1-2013:p0106:b003:l030","ordinal":84957,"en":"“I shall slaughter Zhamgyrchy,"},{"id":"semetey-1-2013:p0106:b003:l031","ordinal":84958,"en":"I shall put him to death,"},{"id":"semetey-1-2013:p0106:b003:l032","ordinal":84959,"en":"I shall gouge out both his eyes,"},{"id":"semetey-1-2013:p0106:b003:l033","ordinal":84960,"en":"Rip his belly open,"},{"id":"semetey-1-2013:p0106:b003:l034","ordinal":84961,"en":"And the dark blood within"},{"id":"semetey-1-2013:p0106:b003:l035","ordinal":84962,"en":"I shall swallow by handfuls to my fill!”"},{"id":"semetey-1-2013:p0106:b003:l036","ordinal":84963,"en":"Accomplished Bakai the leopard"},{"id":"semetey-1-2013:p0106:b003:l037","ordinal":84964,"en":"Arrived before an arrow could."},{"id":"semetey-1-2013:p0106:b003:l038","ordinal":84965,"en":"The Eshteks' champion,"},{"id":"semetey-1-2013:p0106:b003:l039","ordinal":84966,"en":"Hero Zhamgyrchy, that warrior,"},{"id":"semetey-1-2013:p0106:b004:l001","ordinal":84967,"en":"From atop Telkyzyl"},{"id":"semetey-1-2013:p0106:b004:l002","ordinal":84968,"en":"Bakai the leopard"},{"id":"semetey-1-2013:p0106:b004:l003","ordinal":84969,"en":"Struck down as he swept past."},{"id":"semetey-1-2013:p0106:b004:l004","ordinal":84970,"en":"As he turned to cut off his head,"},{"id":"semetey-1-2013:p0106:b004:l005","ordinal":84971,"en":"To knock it off like an apple,"},{"id":"semetey-1-2013:p0106:b004:l006","ordinal":84972,"en":"The reckless man of the Eshteks—"},{"id":"semetey-1-2013:p0106:b004:l007","ordinal":84973,"en":"As he bent to behead him,"},{"id":"semetey-1-2013:p0106:b004:l008","ordinal":84974,"en":"'Here stands a city with its sovereign;"},{"id":"semetey-1-2013:p0106:b004:l009","ordinal":84975,"en":"Sovereign Bakai the leopard;"},{"id":"semetey-1-2013:p0106:b004:l010","ordinal":84976,"en":"If you would take my head, here I am!”"},{"id":"semetey-1-2013:p0106:b004:l011","ordinal":84977,"en":"Dismounting in distress,"},{"id":"semetey-1-2013:p0106:b004:l012","ordinal":84978,"en":"He poured out his words to Bakai,"},{"id":"semetey-1-2013:p0106:b004:l013","ordinal":84979,"en":"Pleading at once:"},{"id":"semetey-1-2013:p0106:b004:l014","ordinal":84980,"en":"“Here are the honored Kyrgyz people."},{"id":"semetey-1-2013:p0106:b004:l015","ordinal":84981,"en":"Uncle Bakai, if you would shed my blood, here I am."},{"id":"semetey-1-2013:p0106:b004:l017","ordinal":84982,"en":"Do not dig my pit;"},{"id":"semetey-1-2013:p0106:b004:l018","ordinal":84983,"en":"Uncle Bakai, do not boil my misery."},{"id":"semetey-1-2013:p0106:b004:l019","ordinal":84984,"en":"Do not destroy this wretched life."},{"id":"semetey-1-2013:p0106:b004:l020","ordinal":84985,"en":"Do not point your sword at us;"},{"id":"semetey-1-2013:p0106:b004:l021","ordinal":84986,"en":"Do not end this life by cutting it off."},{"id":"semetey-1-2013:p0106:b004:l022","ordinal":84987,"en":"Uncle Bakai, you are my khan;"},{"id":"semetey-1-2013:p0106:b004:l023","ordinal":84988,"en":"You are the one who can find my way out."},{"id":"semetey-1-2013:p0106:b004:l024","ordinal":84989,"en":"Since my hero Manas died,"},{"id":"semetey-1-2013:p0106:b004:l025","ordinal":84990,"en":"You are my strength to rely upon,"},{"id":"semetey-1-2013:p0106:b004:l026","ordinal":84991,"en":"Renowned Bakai, my lion."},{"id":"semetey-1-2013:p0106:b004:l027","ordinal":84992,"en":"My valiant uncle, hear my words!"}]
