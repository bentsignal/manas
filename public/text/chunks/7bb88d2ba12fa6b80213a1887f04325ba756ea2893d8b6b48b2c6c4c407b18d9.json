[{"id":"manas-2010:p0952:b001:l007","ordinal":41729,"en":"Eleven of those daughters"},{"id":"manas-2010:p0952:b001:l008","ordinal":41730,"en":"I have given to eleven khans."},{"id":"manas-2010:p0952:b001:l009","ordinal":41731,"en":"My cherished child Kanykey"},{"id":"manas-2010:p0952:b001:l010","ordinal":41732,"en":"Is worth them all,"},{"id":"manas-2010:p0952:b001:l011","ordinal":41733,"en":"The strongest of many girls,"},{"id":"manas-2010:p0952:b001:l012","ordinal":41734,"en":"The skillful one among the long-haired,"},{"id":"manas-2010:p0952:b001:l013","ordinal":41735,"en":"The finest among women."},{"id":"manas-2010:p0952:b001:l014","ordinal":41736,"en":"The champion of young girls,"},{"id":"manas-2010:p0952:b001:l015","ordinal":41737,"en":"For this Temirkan who stands here,"},{"id":"manas-2010:p0952:b001:l016","ordinal":41738,"en":"A champion granted by fortune."},{"id":"manas-2010:p0952:b001:l017","ordinal":41739,"en":"My child Kanykey,"},{"id":"manas-2010:p0952:b001:l018","ordinal":41740,"en":"When she reached six years old,"},{"id":"manas-2010:p0952:b001:l019","ordinal":41741,"en":"I caressed her and braided her hair."},{"id":"manas-2010:p0952:b001:l020","ordinal":41742,"en":"If six thousand sons were put together,"},{"id":"manas-2010:p0952:b001:l021","ordinal":41743,"en":"I loved her more than all of them."},{"id":"manas-2010:p0952:b001:l022","ordinal":41744,"en":"This child of mine, Kanykey,"},{"id":"manas-2010:p0952:b001:l023","ordinal":41745,"en":"Was a child of sacred power,"},{"id":"manas-2010:p0952:b001:l024","ordinal":41746,"en":"For leopard Sultan Manas"},{"id":"manas-2010:p0952:b001:l025","ordinal":41747,"en":"She was a worthy soul."},{"id":"manas-2010:p0952:b001:l026","ordinal":41748,"en":"What would happen six months ahead"},{"id":"manas-2010:p0952:b001:l027","ordinal":41749,"en":"She could tell this very moment."},{"id":"manas-2010:p0952:b001:l028","ordinal":41750,"en":"On my child's right shoulder"},{"id":"manas-2010:p0952:b001:l029","ordinal":41751,"en":"There was naked Kydyr."},{"id":"manas-2010:p0952:b001:l030","ordinal":41752,"en":"The youngest of twelve daughters,"},{"id":"manas-2010:p0952:b001:l031","ordinal":41753,"en":"Temirkan's darling,"},{"id":"manas-2010:p0952:b001:l032","ordinal":41754,"en":"Heaven's beloved servant,"},{"id":"manas-2010:p0952:b001:l033","ordinal":41755,"en":"Radiant among created mortals,"},{"id":"manas-2010:p0952:b001:l034","ordinal":41756,"en":"The beauty of twelve daughters,"},{"id":"manas-2010:p0952:b001:l035","ordinal":41757,"en":"Among spear-fighters, Kanykey"},{"id":"manas-2010:p0952:b001:l036","ordinal":41758,"en":"Has skill as well."},{"id":"manas-2010:p0952:b001:l037","ordinal":41759,"en":"In finding wisdom and resource"},{"id":"manas-2010:p0952:b001:l038","ordinal":41760,"en":"She has mastery as well."},{"id":"manas-2010:p0952:b001:l039","ordinal":41761,"en":"This child of mine, Kanykey,"},{"id":"manas-2010:p0952:b001:l040","ordinal":41762,"en":"Girding herself in men's clothes,"},{"id":"manas-2010:p0952:b001:l041","ordinal":41763,"en":"Has worn them too."},{"id":"manas-2010:p0952:b001:l042","ordinal":41764,"en":"When all the khans gathered,"},{"id":"manas-2010:p0953:b001:l001","ordinal":41765,"en":"When they came bringing turmoil,"},{"id":"manas-2010:p0953:b001:l002","ordinal":41766,"en":"Passing among them like a black jackdaw,"},{"id":"manas-2010:p0953:b001:l003","ordinal":41767,"en":"She has attacked them too."},{"id":"manas-2010:p0953:b001:l004","ordinal":41768,"en":"With a warrior's frame, immensely stubborn,"},{"id":"manas-2010:p0953:b001:l005","ordinal":41769,"en":"My child Kanykey"},{"id":"manas-2010:p0953:b001:l006","ordinal":41770,"en":"Has fought many peoples with the spear."},{"id":"manas-2010:p0953:b001:l007","ordinal":41771,"en":"Her prowess is renowned."},{"id":"manas-2010:p0953:b001:l008","ordinal":41772,"en":"My champion child Kanykey,"},{"id":"manas-2010:p0953:b001:l009","ordinal":41773,"en":"Earlier, when I was in Bukhara,"},{"id":"manas-2010:p0953:b001:l010","ordinal":41774,"en":"All the khans gathered,"},{"id":"manas-2010:p0953:b001:l011","ordinal":41775,"en":"Saying, “Give us Kanykey,”"},{"id":"manas-2010:p0953:b001:l012","ordinal":41776,"en":"Laying claim to that precious head."},{"id":"manas-2010:p0953:b001:l013","ordinal":41777,"en":"Kanykey went out to single combat,"},{"id":"manas-2010:p0953:b001:l014","ordinal":41778,"en":"Fought with her spear alone,"},{"id":"manas-2010:p0953:b001:l015","ordinal":41779,"en":"Brought great turmoil."},{"id":"manas-2010:p0953:b001:l016","ordinal":41780,"en":"This very Bukhara,"},{"id":"manas-2010:p0953:b001:l017","ordinal":41781,"en":"From enemies who came to besiege it,"},{"id":"manas-2010:p0953:b001:l018","ordinal":41782,"en":"She freed four times."},{"id":"manas-2010:p0953:b001:l019","ordinal":41783,"en":"That my child was a hero,"},{"id":"manas-2010:p0953:b001:l020","ordinal":41784,"en":"I noticed and knew long ago."},{"id":"manas-2010:p0953:b001:l021","ordinal":41785,"en":"Wishing to give her to a worthy house,"},{"id":"manas-2010:p0953:b001:l022","ordinal":41786,"en":"From God Most High"},{"id":"manas-2010:p0953:b001:l023","ordinal":41787,"en":"I have been asking for Manas."},{"id":"manas-2010:p0953:b001:l024","ordinal":41788,"en":"We greeted and saw one another's faces."},{"id":"manas-2010:p0953:b001:l025","ordinal":41789,"en":"I shall agree to what you say."},{"id":"manas-2010:p0953:b001:l026","ordinal":41790,"en":"The Kanykey you desire,"},{"id":"manas-2010:p0953:b001:l027","ordinal":41791,"en":"I shall give to your Manas."},{"id":"manas-2010:p0953:b001:l028","ordinal":41792,"en":"If you came for Kanykey, my Bakay,"},{"id":"manas-2010:p0953:b001:l029","ordinal":41793,"en":"Take my child Kanykey."},{"id":"manas-2010:p0953:b001:l030","ordinal":41794,"en":"Take my true word of promise."},{"id":"manas-2010:p0953:b001:l031","ordinal":41795,"en":"If you need it, my Bakay,"},{"id":"manas-2010:p0953:b001:l032","ordinal":41796,"en":"Take me too, with my head tossed back!"},{"id":"manas-2010:p0953:b001:l033","ordinal":41797,"en":"Let us immerse ourselves in enjoyment,"},{"id":"manas-2010:p0953:b001:l034","ordinal":41798,"en":"Talk without tiring,"},{"id":"manas-2010:p0953:b001:l035","ordinal":41799,"en":"Let us enjoy ourselves."},{"id":"manas-2010:p0953:b001:l036","ordinal":41800,"en":"Sultan Bakay the leopard,"},{"id":"manas-2010:p0953:b001:l037","ordinal":41801,"en":"Stay at our home."},{"id":"manas-2010:p0953:b001:l038","ordinal":41802,"en":"As the foremost of our kin by marriage,"},{"id":"manas-2010:p0953:b001:l039","ordinal":41803,"en":"Be our guest!"},{"id":"manas-2010:p0953:b001:l040","ordinal":41804,"en":"Let it be as I wish;"},{"id":"manas-2010:p0953:b001:l041","ordinal":41805,"en":"All my chests"},{"id":"manas-2010:p0953:b001:l042","ordinal":41806,"en":"Fill with yellow gold!"},{"id":"manas-2010:p0954:b001:l001","ordinal":41807,"en":"Let it be as my heart desires;"},{"id":"manas-2010:p0954:b001:l002","ordinal":41808,"en":"All my coffers"},{"id":"manas-2010:p0954:b001:l003","ordinal":41809,"en":"Fill with abundant gold!"},{"id":"manas-2010:p0954:b001:l004","ordinal":41810,"en":"Make my wall-felts greasy with fat;"},{"id":"manas-2010:p0954:b001:l005","ordinal":41811,"en":"The whole throng of Bukhara"},{"id":"manas-2010:p0954:b001:l006","ordinal":41812,"en":"Make rich beyond measure."},{"id":"manas-2010:p0954:b001:l007","ordinal":41813,"en":"Agree to what I say;"},{"id":"manas-2010:p0954:b001:l008","ordinal":41814,"en":"Let us embrace and become kin,"},{"id":"manas-2010:p0954:b001:l009","ordinal":41815,"en":"Give what I ask."},{"id":"manas-2010:p0954:b001:l010","ordinal":41816,"en":"Since I have agreed to his words,"},{"id":"manas-2010:p0954:b001:l011","ordinal":41817,"en":"My cherished child Kanykey,"},{"id":"manas-2010:p0954:b001:l012","ordinal":41818,"en":"Since I have given her to your blood-drinker,"},{"id":"manas-2010:p0954:b001:l013","ordinal":41819,"en":"Give a thousand dark camels,"},{"id":"manas-2010:p0954:b001:l014","ordinal":41820,"en":"Give a thousand black mares with white blazes!"},{"id":"manas-2010:p0954:b001:l015","ordinal":41821,"en":"If Kanykey bears, she will bear a lion,"},{"id":"manas-2010:p0954:b001:l016","ordinal":41822,"en":"She will bear a dark, blue-maned warrior."},{"id":"manas-2010:p0954:b001:l017","ordinal":41823,"en":"I have set a great bride-price; heed me."},{"id":"manas-2010:p0954:b001:l018","ordinal":41824,"en":"My blue-maned Bakay, understand!"},{"id":"manas-2010:p0954:b001:l019","ordinal":41825,"en":"Some time had passed;"},{"id":"manas-2010:p0954:b001:l020","ordinal":41826,"en":"That Kanykey, my foal,"},{"id":"manas-2010:p0954:b001:l021","ordinal":41827,"en":"Taking eighty maiden attendants,"},{"id":"manas-2010:p0954:b001:l022","ordinal":41828,"en":"Had gone out for an outing."},{"id":"manas-2010:p0954:b001:l023","ordinal":41829,"en":"When she returns from the outing,"},{"id":"manas-2010:p0954:b001:l024","ordinal":41830,"en":"Braid her hair as a good omen."},{"id":"manas-2010:p0954:b001:l025","ordinal":41831,"en":"The appointed span is ten days;"},{"id":"manas-2010:p0954:b001:l026","ordinal":41832,"en":"See Kanykey!"},{"id":"manas-2010:p0954:b001:l027","ordinal":41833,"en":"Countless treasures, abundant wealth,"},{"id":"manas-2010:p0954:b001:l028","ordinal":41834,"en":"Give as the gift for first seeing her!’"},{"id":"manas-2010:p0954:b001:l029","ordinal":41835,"en":"When Temirkan said this,"},{"id":"manas-2010:p0954:b001:l030","ordinal":41836,"en":"The guest house had five halls,"},{"id":"manas-2010:p0954:b001:l031","ordinal":41837,"en":"Great was their strength,"},{"id":"manas-2010:p0954:b001:l032","ordinal":41838,"en":"Their doors iron and solid tin."},{"id":"manas-2010:p0954:b001:l033","ordinal":41839,"en":"Though Kanykey was a girl,"},{"id":"manas-2010:p0954:b001:l034","ordinal":41840,"en":"Such was her excellent service."},{"id":"manas-2010:p0954:b001:l035","ordinal":41841,"en":"Forty holy men of Bukhara,"},{"id":"manas-2010:p0954:b001:l036","ordinal":41842,"en":"Within that palace,"},{"id":"manas-2010:p0954:b001:l037","ordinal":41843,"en":"All bustled and ran,"},{"id":"manas-2010:p0954:b001:l038","ordinal":41844,"en":"Now took the gray steed."},{"id":"manas-2010:p0954:b001:l039","ordinal":41845,"en":"At the guest-house palace,"},{"id":"manas-2010:p0954:b001:l040","ordinal":41846,"en":"Champion Bakay then"},{"id":"manas-2010:p0954:b001:l041","ordinal":41847,"en":"Now dismounted from his horse."},{"id":"manas-2010:p0954:b001:l042","ordinal":41848,"en":"Spreading out riches,"},{"id":"manas-2010:p0955:b001:l001","ordinal":41849,"en":"Red raisins, a barren young mare,"},{"id":"manas-2010:p0955:b001:l002","ordinal":41850,"en":"For your elder Lord Bakay"},{"id":"manas-2010:p0955:b001:l003","ordinal":41851,"en":"They boiled until tender."},{"id":"manas-2010:p0955:b001:l004","ordinal":41852,"en":"When Bakay entered as a guest,"},{"id":"manas-2010:p0955:b001:l005","ordinal":41853,"en":"Leopard Manas and the forty companions,"},{"id":"manas-2010:p0955:b001:l006","ordinal":41854,"en":"Loading eighty camels with gold coins,"},{"id":"manas-2010:p0955:b001:l007","ordinal":41855,"en":"Not traveling by day, pressing on by night,"},{"id":"manas-2010:p0955:b001:l008","ordinal":41856,"en":"To that palace of Bukhara,"},{"id":"manas-2010:p0955:b001:l009","ordinal":41857,"en":"Their tusks jutting out,"},{"id":"manas-2010:p0955:b001:l010","ordinal":41858,"en":"Their lower lips hanging down,"},{"id":"manas-2010:p0955:b001:l011","ordinal":41859,"en":"Their loads piled high upon them,"},{"id":"manas-2010:p0955:b001:l012","ordinal":41860,"en":"Their necks raised like ducks',"},{"id":"manas-2010:p0955:b001:l013","ordinal":41861,"en":"As dusk fell, as the sun set,"},{"id":"manas-2010:p0955:b001:l014","ordinal":41862,"en":"As the early sleepers all lay down,"},{"id":"manas-2010:p0955:b001:l015","ordinal":41863,"en":"Into the palace in Bukhara"},{"id":"manas-2010:p0955:b001:l016","ordinal":41864,"en":"The blue-maned one turned and entered."},{"id":"manas-2010:p0955:b001:l017","ordinal":41865,"en":"Yraman's singer son,"},{"id":"manas-2010:p0955:b001:l018","ordinal":41866,"en":"His tasseled waist-cord forty-jointed,"},{"id":"manas-2010:p0955:b001:l019","ordinal":41867,"en":"Before the magnanimous lion"},{"id":"manas-2010:p0955:b001:l020","ordinal":41868,"en":"Sang and spoke his song."},{"id":"manas-2010:p0955:b001:l021","ordinal":41869,"en":"As he entered through that gate,"},{"id":"manas-2010:p0955:b001:l022","ordinal":41870,"en":"The mighty warriors drew apart."},{"id":"manas-2010:p0955:b001:l023","ordinal":41871,"en":"Warrior Manas, visited by Kydyr,"},{"id":"manas-2010:p0955:b001:l024","ordinal":41872,"en":"Loomed like a towering mountain."},{"id":"manas-2010:p0955:b001:l025","ordinal":41873,"en":"The plane-tree garden in Bukhara,"},{"id":"manas-2010:p0955:b001:l026","ordinal":41874,"en":"His God one, his faith pure,"},{"id":"manas-2010:p0955:b001:l027","ordinal":41875,"en":"As a bridegroom to Bukhara,"},{"id":"manas-2010:p0955:b001:l028","ordinal":41876,"en":"The blue-maned warrior came that moment."},{"id":"manas-2010:p0955:b001:l029","ordinal":41877,"en":"Loaded upon Zhelmayaan,"},{"id":"manas-2010:p0955:b001:l030","ordinal":41878,"en":"Had they not brought"},{"id":"manas-2010:p0955:b001:l031","ordinal":41879,"en":"The camel-sized throne their lord would mount?"},{"id":"manas-2010:p0955:b001:l032","ordinal":41880,"en":"The forty companions, two by two,"},{"id":"manas-2010:p0955:b001:l033","ordinal":41881,"en":"Making his dun horse prance,"},{"id":"manas-2010:p0955:b001:l034","ordinal":41882,"en":"That raging mighty creature,"},{"id":"manas-2010:p0955:b001:l035","ordinal":41883,"en":"Twelve companions led."},{"id":"manas-2010:p0955:b001:l036","ordinal":41884,"en":"Into royal Bukhara, looming large,"},{"id":"manas-2010:p0955:b001:l037","ordinal":41885,"en":"Khan Manas entered."},{"id":"manas-2010:p0955:b001:l038","ordinal":41886,"en":"Taking eighty beautiful girls,"},{"id":"manas-2010:p0955:b001:l039","ordinal":41887,"en":"Kanykey, who had gone on an outing,"},{"id":"manas-2010:p0955:b001:l040","ordinal":41888,"en":"Arrived at the same time."},{"id":"manas-2010:p0955:b001:l041","ordinal":41889,"en":"Kanykey's eighty girls,"},{"id":"manas-2010:p0955:b001:l042","ordinal":41890,"en":"Not eighty girls but eighty craftswomen,"},{"id":"manas-2010:p0956:b001:l001","ordinal":41891,"en":"Thimble-mouthed, camel-calf-eyed,"},{"id":"manas-2010:p0956:b001:l002","ordinal":41892,"en":"All alike, dark-eyed,"},{"id":"manas-2010:p0956:b001:l003","ordinal":41893,"en":"Scarlet jackets, languid eyes,"},{"id":"manas-2010:p0956:b001:l004","ordinal":41894,"en":"From fluttering beauties"},{"id":"manas-2010:p0956:b001:l005","ordinal":41895,"en":"She had gathered the finest."},{"id":"manas-2010:p0956:b001:l006","ordinal":41896,"en":"The blood-drinker visited by Kydyr"},{"id":"manas-2010:p0956:b001:l007","ordinal":41897,"en":"She now studied from outside."},{"id":"manas-2010:p0956:b001:l008","ordinal":41898,"en":"That unbeliever Kanykey,"},{"id":"manas-2010:p0956:b001:l009","ordinal":41899,"en":"Your poor soul, a cultivator of wisdom,"},{"id":"manas-2010:p0956:b001:l010","ordinal":41900,"en":"Studied the blue-maned one from outside."},{"id":"manas-2010:p0956:b001:l011","ordinal":41901,"en":"Musk wafting, a scent of brass rising,"},{"id":"manas-2010:p0956:b001:l012","ordinal":41902,"en":"Her rump showing like a wild ewe's,"},{"id":"manas-2010:p0956:b001:l013","ordinal":41903,"en":"Her white throat gleaming,"},{"id":"manas-2010:p0956:b001:l014","ordinal":41904,"en":"Speaking softly, saying this,"},{"id":"manas-2010:p0956:b001:l015","ordinal":41905,"en":"With the down of an owl,"},{"id":"manas-2010:p0956:b001:l016","ordinal":41906,"en":"With the voice of a nightingale,"},{"id":"manas-2010:p0956:b001:l017","ordinal":41907,"en":"No idle words are spoken:"},{"id":"manas-2010:p0956:b001:l018","ordinal":41908,"en":"Eighty girls, all alike,"},{"id":"manas-2010:p0956:b001:l019","ordinal":41909,"en":"Were Kanykey's companions."},{"id":"manas-2010:p0956:b001:l020","ordinal":41910,"en":"To her confidantes she spoke:"},{"id":"manas-2010:p0956:b001:l021","ordinal":41911,"en":"‘Man, a mighty one has come to Bukhara!"},{"id":"manas-2010:p0956:b001:l022","ordinal":41912,"en":"Have you seen him?’ she said."},{"id":"manas-2010:p0956:b001:l023","ordinal":41913,"en":"‘He is a leopard, he is a lion."},{"id":"manas-2010:p0956:b001:l024","ordinal":41914,"en":"The one God has brought us face to face;"},{"id":"manas-2010:p0956:b001:l025","ordinal":41915,"en":"For this unfortunate one's fortune,"},{"id":"manas-2010:p0956:b001:l026","ordinal":41916,"en":"He is the warrior written down."},{"id":"manas-2010:p0956:b001:l027","ordinal":41917,"en":"No such dream comes to mind in sleep:"},{"id":"manas-2010:p0956:b001:l028","ordinal":41918,"en":"Honored Manas coming as bridegroom,"},{"id":"manas-2010:p0956:b001:l029","ordinal":41919,"en":"Such a thing does not happen in an age."},{"id":"manas-2010:p0956:b001:l030","ordinal":41920,"en":"That the blue-maned one was truly such,"},{"id":"manas-2010:p0956:b001:l031","ordinal":41921,"en":"I had long desired and known."},{"id":"manas-2010:p0956:b001:l032","ordinal":41922,"en":"“How might the blood-drinker come?”"},{"id":"manas-2010:p0956:b001:l033","ordinal":41923,"en":"I have been asking God."},{"id":"manas-2010:p0956:b001:l034","ordinal":41924,"en":"To unite when I was little as a louse,"},{"id":"manas-2010:p0956:b001:l035","ordinal":41925,"en":"To join when I was small as a thumb,"},{"id":"manas-2010:p0956:b001:l036","ordinal":41926,"en":"He is that very hero."},{"id":"manas-2010:p0956:b001:l037","ordinal":41927,"en":"Bringing everything together, the Almighty"},{"id":"manas-2010:p0956:b001:l038","ordinal":41928,"en":"Has now driven him here!"},{"id":"manas-2010:p0956:b001:l039","ordinal":41929,"en":"Earlier, at Chubak riding Kögala,"},{"id":"manas-2010:p0956:b001:l040","ordinal":41930,"en":"When I openly thrust my spear,"},{"id":"manas-2010:p0956:b001:l041","ordinal":41931,"en":"When I brought the end of the world,"},{"id":"manas-2010:p0956:b001:l042","ordinal":41932,"en":"When I chased him toward Alay,"},{"id":"manas-2010:p0957:b001:l001","ordinal":41933,"en":"That Chubak, Akbaltay's son,"},{"id":"manas-2010:p0957:b001:l002","ordinal":41934,"en":"When he was flustered, finding no way out,"},{"id":"manas-2010:p0957:b001:l003","ordinal":41935,"en":"Stumbling in confusion then,"},{"id":"manas-2010:p0957:b001:l004","ordinal":41936,"en":"That Chubak who had come to take me,"},{"id":"manas-2010:p0957:b001:l005","ordinal":41937,"en":"When he fled toward Alay,"},{"id":"manas-2010:p0957:b001:l006","ordinal":41938,"en":"Five men emerged upon the ridge."},{"id":"manas-2010:p0957:b001:l007","ordinal":41939,"en":"It was the renowned lion himself,"},{"id":"manas-2010:p0957:b001:l008","ordinal":41940,"en":"Not merely Manas himself,"},{"id":"manas-2010:p0957:b001:l009","ordinal":41941,"en":"But his very seeing black eyes!"},{"id":"manas-2010:p0957:b001:l010","ordinal":41942,"en":"Akbaltay's warrior Chubak"},{"id":"manas-2010:p0957:b001:l011","ordinal":41943,"en":"Must have told him the whole affair."},{"id":"manas-2010:p0957:b001:l012","ordinal":41944,"en":"Hearing the news from Chubak,"},{"id":"manas-2010:p0957:b001:l013","ordinal":41945,"en":"The blood-drinker must have set out prepared."},{"id":"manas-2010:p0957:b001:l014","ordinal":41946,"en":"If they do not agree to his words,"},{"id":"manas-2010:p0957:b001:l015","ordinal":41947,"en":"If they do not give what he needs,"},{"id":"manas-2010:p0957:b001:l016","ordinal":41948,"en":"He will bring remarkable slaughter."},{"id":"manas-2010:p0957:b001:l017","ordinal":41949,"en":"If someone provokes his anger,"},{"id":"manas-2010:p0957:b001:l018","ordinal":41950,"en":"This very Bukhara,"},{"id":"manas-2010:p0957:b001:l019","ordinal":41951,"en":"He will behead it with his sword."},{"id":"manas-2010:p0957:b001:l020","ordinal":41952,"en":"Grim in appearance, fiercely menacing,"},{"id":"manas-2010:p0957:b001:l021","ordinal":41953,"en":"He has leveled those who attacked him."},{"id":"manas-2010:p0957:b001:l022","ordinal":41954,"en":"Never sated when he drinks blood,"},{"id":"manas-2010:p0957:b001:l023","ordinal":41955,"en":"None who challenged him survived."},{"id":"manas-2010:p0957:b001:l024","ordinal":41956,"en":"He is a champion, he is a lion,"},{"id":"manas-2010:p0957:b001:l025","ordinal":41957,"en":"He is a renowned blue-maned warrior."},{"id":"manas-2010:p0957:b001:l026","ordinal":41958,"en":"Established upon the earth,"},{"id":"manas-2010:p0957:b001:l027","ordinal":41959,"en":"He is an iron wall, a fortress."},{"id":"manas-2010:p0957:b001:l028","ordinal":41960,"en":"His taking Alöökö,"},{"id":"manas-2010:p0957:b001:l029","ordinal":41961,"en":"Of the swarming Chinese"},{"id":"manas-2010:p0957:b001:l030","ordinal":41962,"en":"His striking off their heads with his sword,"},{"id":"manas-2010:p0957:b001:l031","ordinal":41963,"en":"His might is fitting."},{"id":"manas-2010:p0957:b001:l032","ordinal":41964,"en":"Driving his giants behind him,"},{"id":"manas-2010:p0957:b001:l033","ordinal":41965,"en":"This champion has girded himself"},{"id":"manas-2010:p0957:b001:l034","ordinal":41966,"en":"For longing for poor me."},{"id":"manas-2010:p0957:b001:l035","ordinal":41967,"en":"If I take the lord as husband,"},{"id":"manas-2010:p0957:b001:l036","ordinal":41968,"en":"He is a lion who will ease my distress."},{"id":"manas-2010:p0957:b001:l037","ordinal":41969,"en":"If I join what has broken,"},{"id":"manas-2010:p0957:b001:l038","ordinal":41970,"en":"If I gather what has scattered,"},{"id":"manas-2010:p0957:b001:l039","ordinal":41971,"en":"To the eighteen thousand worlds"},{"id":"manas-2010:p0957:b001:l040","ordinal":41972,"en":"He is a warrior whose strength will reach."},{"id":"manas-2010:p0957:b001:l041","ordinal":41973,"en":"He is a lion who will ease hardship."},{"id":"manas-2010:p0957:b001:l042","ordinal":41974,"en":"If we serve the lord,"},{"id":"manas-2010:p0958:b001:l001","ordinal":41975,"en":"Not just the Chinese, the whole world—"},{"id":"manas-2010:p0958:b001:l002","ordinal":41976,"en":"He is a warrior who will prove their equal."},{"id":"manas-2010:p0958:b001:l003","ordinal":41977,"en":"Forming a marriage alliance, he gave livestock."},{"id":"manas-2010:p0958:b001:l004","ordinal":41978,"en":"Let me look at the blue-maned one's form."},{"id":"manas-2010:p0958:b001:l005","ordinal":41979,"en":"For my lord, created unique,"},{"id":"manas-2010:p0958:b001:l006","ordinal":41980,"en":"Making my great head a banner,"},{"id":"manas-2010:p0958:b001:l007","ordinal":41981,"en":"Making my woman's self a warrior,"},{"id":"manas-2010:p0958:b001:l008","ordinal":41982,"en":"Let me become his support."},{"id":"manas-2010:p0958:b001:l009","ordinal":41983,"en":"That the blood-drinker was truly such,"},{"id":"manas-2010:p0958:b001:l010","ordinal":41984,"en":"I, unfortunate Kanykey,"}]
