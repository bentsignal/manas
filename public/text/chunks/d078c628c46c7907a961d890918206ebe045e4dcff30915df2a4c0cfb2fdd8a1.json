[{"id":"sayakbay-ms-current144:pdf055:l020","ordinal":390145,"en":"So he might wear it against his foes,"},{"id":"sayakbay-ms-current144:pdf055:l022","ordinal":390146,"en":"To finish them all, spilling their blood,"},{"id":"sayakbay-ms-current144:pdf055:l023","ordinal":390147,"en":"[To sweep dust across their land,]"},{"id":"sayakbay-ms-current144:pdf055:l025","ordinal":390148,"en":"[Its outer surface was so splendid,]"},{"id":"sayakbay-ms-current144:pdf055:l026","ordinal":390149,"en":"My dear one with the brass thimble,"},{"id":"sayakbay-ms-current144:pdf055:l027","ordinal":390150,"en":"[Such was her sturdy handiwork,]"},{"id":"sayakbay-ms-current144:pdf055:l028","ordinal":390151,"en":"The purest of those in flowing dresses,"},{"id":"sayakbay-ms-current144:pdf056:l001","ordinal":390152,"en":"She herself was queen among women,"},{"id":"sayakbay-ms-current144:pdf056:l006","ordinal":390153,"en":"To that unfortunate Perizaada,"},{"id":"sayakbay-ms-current144:pdf056:l007","ordinal":390154,"en":"No mortal could compare,"},{"id":"sayakbay-ms-current144:pdf056:l016","ordinal":390155,"en":"[Enchanting the moon and sun,]"},{"id":"sayakbay-ms-current144:pdf056:l017","ordinal":390156,"en":"[That day's spectacle,]"},{"id":"sayakbay-ms-current144:pdf056:l018","ordinal":390157,"en":"Such was the dream she saw,"},{"id":"sayakbay-ms-current144:pdf056:l023","ordinal":390158,"en":"Gnawing whatever crossed its path,"},{"id":"sayakbay-ms-current144:pdf056:l027","ordinal":390159,"en":"Every living beast and creature,"},{"id":"sayakbay-ms-current144:pdf056:l030","ordinal":390160,"en":"Scorched, [scattering sand,]"},{"id":"sayakbay-ms-current144:pdf056:l033","ordinal":390161,"en":"[The two hunting dogs Seytek set loose,]"},{"id":"sayakbay-ms-current144:pdf057:l001","ordinal":390162,"en":"[All creatures despaired of life,]"},{"id":"sayakbay-ms-current144:pdf057:l002","ordinal":390163,"en":"What has happened,"},{"id":"sayakbay-ms-current144:pdf057:l003","ordinal":390164,"en":"She pondered within her dream."},{"id":"sayakbay-ms-current144:pdf057:l014","ordinal":390165,"en":"All the fanged beasts,"},{"id":"sayakbay-ms-current144:pdf057:l018","ordinal":390166,"en":"The four corners of the world,"},{"id":"sayakbay-ms-current144:pdf057:l024","ordinal":390167,"en":"Every renowned place,"},{"id":"sayakbay-ms-current144:pdf058:l002","ordinal":390168,"en":"Riding far, exploring the land,"},{"id":"sayakbay-ms-current144:pdf058:l008","ordinal":390169,"en":"The noble leopard Seytek,"},{"id":"sayakbay-ms-current144:pdf058:l024","ordinal":390170,"en":"Fighting, he could not prevail,"},{"id":"sayakbay-ms-current144:pdf058:l026","ordinal":390171,"en":"It came to rest in the west."},{"id":"sayakbay-ms-current144:pdf058:l027","ordinal":390172,"en":"Scorching the face of the earth,"},{"id":"sayakbay-ms-current144:pdf059:l001","ordinal":390173,"en":"[What he was to do,]"},{"id":"sayakbay-ms-current144:pdf059:l021","ordinal":390174,"en":"The crops they had sown,"},{"id":"sayakbay-ms-current144:pdf059:l023","ordinal":390175,"en":"Those who resisted,"},{"id":"sayakbay-ms-current144:pdf059:l024","ordinal":390176,"en":"It swallowed like flies."},{"id":"sayakbay-ms-current144:pdf059:l030","ordinal":390177,"en":"Those who resisted,"},{"id":"sayakbay-ms-current144:pdf060:l004","ordinal":390178,"en":"Unfortunate Perizaada,"},{"id":"sayakbay-ms-current144:pdf060:l008","ordinal":390179,"en":"The lady Perizaada,"},{"id":"sayakbay-ms-current144:pdf060:l016","ordinal":390180,"en":"The noble leopard Seytek,"},{"id":"sayakbay-ms-current144:pdf060:l018","ordinal":390181,"en":"Dipping his hands in water,"},{"id":"sayakbay-ms-current144:pdf060:l019","ordinal":390182,"en":"The two cycles of dawn prayer,"},{"id":"sayakbay-ms-current144:pdf060:l020","ordinal":390183,"en":"He now performed in the morning,"},{"id":"sayakbay-ms-current144:pdf060:l023","ordinal":390184,"en":"He saddled Kulunsur,"},{"id":"sayakbay-ms-current144:pdf060:l024","ordinal":390185,"en":"Of the prancing dark horse,"},{"id":"sayakbay-ms-current144:pdf060:l027","ordinal":390186,"en":"Lest it chafe his hands,"},{"id":"sayakbay-ms-current144:pdf061:l004","ordinal":390187,"en":"Its rear entirely silver,"},{"id":"sayakbay-ms-current144:pdf061:l005","ordinal":390188,"en":"Its two sides of broad iron,"},{"id":"sayakbay-ms-current144:pdf061:l026","ordinal":390189,"en":"So he would not falter in battle,"},{"id":"sayakbay-ms-current144:pdf061:l028","ordinal":390190,"en":"Not to press the horse's flanks,"},{"id":"sayakbay-ms-current144:pdf062:l002","ordinal":390191,"en":"The carefully crafted saddle,"},{"id":"sayakbay-ms-current144:pdf062:l003","ordinal":390192,"en":"Remember us who fashioned it,"},{"id":"sayakbay-ms-current144:pdf062:l004","ordinal":390193,"en":"[Saddling and mounting the horse,]"},{"id":"sayakbay-ms-current144:pdf062:l005","ordinal":390194,"en":"To saddle it for distant journeys,"},{"id":"sayakbay-ms-current144:pdf062:l006","ordinal":390195,"en":"[The ironworker's steadfast purpose,]"},{"id":"sayakbay-ms-current144:pdf062:l007","ordinal":390196,"en":"Setting a wondrous value upon it,"},{"id":"sayakbay-ms-current144:pdf062:l008","ordinal":390197,"en":"Honoring him, soothing his heart,"},{"id":"sayakbay-ms-current144:pdf062:l009","ordinal":390198,"en":"Reading prayers for the departed,"},{"id":"sayakbay-ms-current144:pdf062:l010","ordinal":390199,"en":"Calling him the generous hero,"},{"id":"sayakbay-ms-current144:pdf062:l013","ordinal":390200,"en":"He saddled Kulunsur,"},{"id":"sayakbay-ms-current144:pdf062:l022","ordinal":390201,"en":"Rejoicing at the mention of death,"},{"id":"sayakbay-ms-current144:pdf062:l031","ordinal":390202,"en":"The lion Akjoltoy,"},{"id":"sayakbay-ms-current144:pdf063:l001","ordinal":390203,"en":"Riding a horse like Kulunsur,"},{"id":"sayakbay-ms-current144:pdf063:l010","ordinal":390204,"en":"[Like a lion guarding a fortress,]"},{"id":"sayakbay-ms-current144:pdf063:l011","ordinal":390205,"en":"[His accustomed fury was mighty,]"},{"id":"sayakbay-ms-current144:pdf063:l012","ordinal":390206,"en":"[Like one protecting countless troops,]"},{"id":"sayakbay-ms-current144:pdf063:l013","ordinal":390207,"en":"If bitter enemies came,"},{"id":"sayakbay-ms-current144:pdf063:l014","ordinal":390208,"en":"If a mighty challenger came to fight,"},{"id":"sayakbay-ms-current144:pdf063:l015","ordinal":390209,"en":"[If a host came by divine power,]"},{"id":"sayakbay-ms-current144:pdf063:l016","ordinal":390210,"en":"[If pointed missiles came in battle,]"},{"id":"sayakbay-ms-current144:pdf063:l017","ordinal":390211,"en":"He never turned back, showing no concern,"},{"id":"sayakbay-ms-current144:pdf063:l018","ordinal":390212,"en":"[Striking with his weapon,]"},{"id":"sayakbay-ms-current144:pdf063:l019","ordinal":390213,"en":"[He would not compare it to his people,]"},{"id":"sayakbay-ms-current144:pdf063:l020","ordinal":390214,"en":"In courage and heroic strength,"},{"id":"sayakbay-ms-current144:pdf063:l021","ordinal":390215,"en":"He knew his people well,"},{"id":"sayakbay-ms-current144:pdf063:l022","ordinal":390216,"en":"He was an immeasurable hero."},{"id":"sayakbay-ms-current144:pdf063:l024","ordinal":390217,"en":"A noble champion, a mighty lion,"},{"id":"sayakbay-ms-current144:pdf063:l025","ordinal":390218,"en":"Renowned among his people."},{"id":"sayakbay-ms-current144:pdf063:l026","ordinal":390219,"en":"[One who gathered his mighty leopards,]"},{"id":"sayakbay-ms-current144:pdf063:l027","ordinal":390220,"en":"Of the noble hero Seytek,"},{"id":"sayakbay-ms-current144:pdf063:l028","ordinal":390221,"en":"[One who continued his journeys,]"},{"id":"sayakbay-ms-current144:pdf063:l029","ordinal":390222,"en":"[He destroys their banner, leveling it,]"},{"id":"sayakbay-ms-current144:pdf063:l030","ordinal":390223,"en":"He makes his enemies his subjects,"},{"id":"sayakbay-ms-current144:pdf064:l001","ordinal":390224,"en":"[Making the level land his own,]"},{"id":"sayakbay-ms-current144:pdf064:l002","ordinal":390225,"en":"[Making the surviving people his subjects,]"},{"id":"sayakbay-ms-current144:pdf064:l003","ordinal":390226,"en":"[A warrior who knew many paths,]"},{"id":"sayakbay-ms-current144:pdf064:l004","ordinal":390227,"en":"A far-seeing wise man,"},{"id":"sayakbay-ms-current144:pdf064:l005","ordinal":390228,"en":"Among the multitude,"},{"id":"sayakbay-ms-current144:pdf064:l007","ordinal":390229,"en":"[Speaking calmly of …,]"},{"id":"sayakbay-ms-current144:pdf064:l008","ordinal":390230,"en":"[Fortune that shattered what split apart,]"},{"id":"sayakbay-ms-current144:pdf064:l009","ordinal":390231,"en":"Many enemies rose against him,"},{"id":"sayakbay-ms-current144:pdf064:l010","ordinal":390232,"en":"The Kalmyks numbering forty thousand,"},{"id":"sayakbay-ms-current144:pdf064:l011","ordinal":390233,"en":"[Karachyt stood apart,]"},{"id":"sayakbay-ms-current144:pdf064:l012","ordinal":390234,"en":"[The reason he became Karakan,]"},{"id":"sayakbay-ms-current144:pdf064:l013","ordinal":390235,"en":"[The Jediger within the seven,]"},{"id":"sayakbay-ms-current144:pdf064:l014","ordinal":390236,"en":"When the youth assembled an army,"},{"id":"sayakbay-ms-current144:pdf064:l015","ordinal":390237,"en":"[Turning the age upside down,]"},{"id":"sayakbay-ms-current144:pdf064:l016","ordinal":390238,"en":"Kankoro, son of Chubak,"},{"id":"sayakbay-ms-current144:pdf064:l017","ordinal":390239,"en":"When he performed lionlike deeds,"},{"id":"sayakbay-ms-current144:pdf064:l018","ordinal":390240,"en":"At a young age, unaware of death,"},{"id":"sayakbay-ms-current144:pdf064:l019","ordinal":390241,"en":"At that time Akjoltoy,"},{"id":"sayakbay-ms-current144:pdf064:l020","ordinal":390242,"en":"Was a boy just thirteen,"},{"id":"sayakbay-ms-current144:pdf064:l021","ordinal":390243,"en":"[Not yet fully grown,]"},{"id":"sayakbay-ms-current144:pdf064:l022","ordinal":390244,"en":"[Not yet filled out into manhood,]"},{"id":"sayakbay-ms-current144:pdf064:l023","ordinal":390245,"en":"After his father Kutubiy died,"},{"id":"sayakbay-ms-current144:pdf064:l024","ordinal":390246,"en":"Before he had a warrior's build,"},{"id":"sayakbay-ms-current144:pdf064:l025","ordinal":390247,"en":"[Still at the age of chasing butterflies,]"},{"id":"sayakbay-ms-current144:pdf064:l026","ordinal":390248,"en":"Joltoy was then a child,"},{"id":"sayakbay-ms-current144:pdf064:l027","ordinal":390249,"en":"[If seized, dearer than life,]"},{"id":"sayakbay-ms-current144:pdf064:l028","ordinal":390250,"en":"Evil-minded Kankoro,"},{"id":"sayakbay-ms-current144:pdf064:l030","ordinal":390251,"en":"[Ordering him to be struck,]"},{"id":"sayakbay-ms-current144:pdf064:l031","ordinal":390252,"en":"[The boy awaiting his turn,]"},{"id":"sayakbay-ms-current144:pdf064:l032","ordinal":390253,"en":"The poor child despairing of life,"},{"id":"sayakbay-ms-current144:pdf065:l001","ordinal":390254,"en":"[Darkness had overtaken his deeds,]"},{"id":"sayakbay-ms-current144:pdf065:l002","ordinal":390255,"en":"[His life lay in torment,]"},{"id":"sayakbay-ms-current144:pdf065:l003","ordinal":390256,"en":"[As noble Seytek appeared,]"},{"id":"sayakbay-ms-current144:pdf065:l004","ordinal":390257,"en":"The warrior Akjoltoy fled."},{"id":"sayakbay-ms-current144:pdf065:l005","ordinal":390258,"en":"Hearing the news, he was alarmed,"},{"id":"sayakbay-ms-current144:pdf065:l006","ordinal":390259,"en":"[The unfortunate one had remained,]"},{"id":"sayakbay-ms-current144:pdf065:l007","ordinal":390260,"en":"[With the forty and the people …,]"},{"id":"sayakbay-ms-current144:pdf065:l008","ordinal":390261,"en":"[Supported by others, he escaped,]"},{"id":"sayakbay-ms-current144:pdf065:l009","ordinal":390262,"en":"[Taking the maiden who gave counsel,]"},{"id":"sayakbay-ms-current144:pdf065:l010","ordinal":390263,"en":"Your poor mother Kanykey,"},{"id":"sayakbay-ms-current144:pdf065:l011","ordinal":390264,"en":"[So blood would not burn …,]"},{"id":"sayakbay-ms-current144:pdf065:l012","ordinal":390265,"en":"[From the departed hero's youth,]"},{"id":"sayakbay-ms-current144:pdf065:l013","ordinal":390266,"en":"[Turning from the offered life,]"},{"id":"sayakbay-ms-current144:pdf065:l014","ordinal":390267,"en":"No swift horse to ride against the foe,"},{"id":"sayakbay-ms-current144:pdf065:l015","ordinal":390268,"en":"No kinsman to offer protection,"},{"id":"sayakbay-ms-current144:pdf065:l016","ordinal":390269,"en":"His heart burning into embers,"},{"id":"sayakbay-ms-current144:pdf065:l017","ordinal":390270,"en":"With no one to counsel him,"},{"id":"sayakbay-ms-current144:pdf065:l018","ordinal":390271,"en":"[Stranded in the midst of it,]"},{"id":"sayakbay-ms-current144:pdf065:l020","ordinal":390272,"en":"No people among whom to settle,"},{"id":"sayakbay-ms-current144:pdf065:l021","ordinal":390273,"en":"Afraid of Kankoro,"},{"id":"sayakbay-ms-current144:pdf065:l022","ordinal":390274,"en":"His soul wept in sorrow,"},{"id":"sayakbay-ms-current144:pdf065:l023","ordinal":390275,"en":"[Sitting and waiting in hope,]"},{"id":"sayakbay-ms-current144:pdf065:l024","ordinal":390276,"en":"[The blood enemy had taken much,]"},{"id":"sayakbay-ms-current144:pdf065:l025","ordinal":390277,"en":"[Escaping so many threats,]"},{"id":"sayakbay-ms-current144:pdf065:l026","ordinal":390278,"en":"[Akjoltoy reading from …,]"},{"id":"sayakbay-ms-current144:pdf065:l027","ordinal":390279,"en":"[He had long been called Joltoy.]"},{"id":"sayakbay-ms-current144:pdf065:l028","ordinal":390280,"en":"[Had it lodged like a thorn?]"},{"id":"sayakbay-ms-current144:pdf065:l029","ordinal":390281,"en":"[Receiving a letter from his lone people,]"},{"id":"sayakbay-ms-current144:pdf065:l030","ordinal":390282,"en":"[With the Kyrgyz alone,]"},{"id":"sayakbay-ms-current144:pdf065:l031","ordinal":390283,"en":"[At white dawn, behind him,]"},{"id":"sayakbay-ms-current144:pdf065:l032","ordinal":390284,"en":"[Hearing much from Umay,]"},{"id":"sayakbay-ms-current144:pdf066:l001","ordinal":390285,"en":"By his command, how many were set against them?"},{"id":"sayakbay-ms-current144:pdf066:l002","ordinal":390286,"en":"Striking them, saying divine power had done it,"},{"id":"sayakbay-ms-current144:pdf066:l003","ordinal":390287,"en":"That act of repudiation was his,"},{"id":"sayakbay-ms-current144:pdf066:l004","ordinal":390288,"en":"His mother was ill-fated,"},{"id":"sayakbay-ms-current144:pdf066:l005","ordinal":390289,"en":"He struck, saying it was wrath,"},{"id":"sayakbay-ms-current144:pdf066:l006","ordinal":390290,"en":"This deed concerned the mighty Jолтой,"},{"id":"sayakbay-ms-current144:pdf066:l007","ordinal":390291,"en":"He struck, calling him a hero,"},{"id":"sayakbay-ms-current144:pdf066:l008","ordinal":390292,"en":"Treating Akjoltoy as of little worth,"},{"id":"sayakbay-ms-current144:pdf066:l009","ordinal":390293,"en":"Turmoil had fallen upon his head,"},{"id":"sayakbay-ms-current144:pdf066:l010","ordinal":390294,"en":"He spoke a false offering,"},{"id":"sayakbay-ms-current144:pdf066:l011","ordinal":390295,"en":"He struck the foe without surveying the ground,"},{"id":"sayakbay-ms-current144:pdf066:l012","ordinal":390296,"en":"Turning the enemy from its road,"},{"id":"sayakbay-ms-current144:pdf066:l013","ordinal":390297,"en":"The troubled souls of the age grew afraid,"},{"id":"sayakbay-ms-current144:pdf066:l014","ordinal":390298,"en":"Only three arrows encircled him,"},{"id":"sayakbay-ms-current144:pdf066:l015","ordinal":390299,"en":"Go forward and awaken,"},{"id":"sayakbay-ms-current144:pdf066:l016","ordinal":390300,"en":"They watched while blood was shed,"},{"id":"sayakbay-ms-current144:pdf066:l017","ordinal":390301,"en":"Ak Joltoy closed his eyes,"},{"id":"sayakbay-ms-current144:pdf066:l018","ordinal":390302,"en":"Dear Joltoy was a lion,"},{"id":"sayakbay-ms-current144:pdf066:l019","ordinal":390303,"en":"When they met, he overcame the warrior,"},{"id":"sayakbay-ms-current144:pdf066:l020","ordinal":390304,"en":"Breaking their ranks, he took the enemy,"},{"id":"sayakbay-ms-current144:pdf066:l021","ordinal":390305,"en":"Advancing without wavering, he took their livestock,"},{"id":"sayakbay-ms-current144:pdf066:l022","ordinal":390306,"en":"At dawn his word sent the army into attack,"},{"id":"sayakbay-ms-current144:pdf066:l023","ordinal":390307,"en":"The child’s eyes were astonished,"},{"id":"sayakbay-ms-current144:pdf066:l024","ordinal":390308,"en":"To sever his own head,"},{"id":"sayakbay-ms-current144:pdf066:l025","ordinal":390309,"en":"They made the second sultan a khan,"},{"id":"sayakbay-ms-current144:pdf066:l026","ordinal":390310,"en":"Toward Kok Bakay’s city,"},{"id":"sayakbay-ms-current144:pdf066:l027","ordinal":390311,"en":"The hearts of those who saw it were shaken,"},{"id":"sayakbay-ms-current144:pdf066:l028","ordinal":390312,"en":"His people cried out the name Seytek,"},{"id":"sayakbay-ms-current144:pdf066:l029","ordinal":390313,"en":"Sixty thousand Chinese lay there,"},{"id":"sayakbay-ms-current144:pdf066:l030","ordinal":390314,"en":"A different day of encounter had come,"},{"id":"sayakbay-ms-current144:pdf066:l031","ordinal":390315,"en":"Ak Joltoy arrived there."},{"id":"sayakbay-ms-current144:pdf067:l001","ordinal":390316,"en":"So that the hidden Chinese would not strike,"},{"id":"sayakbay-ms-current144:pdf067:l002","ordinal":390317,"en":"Seytek’s young son,"},{"id":"sayakbay-ms-current144:pdf067:l003","ordinal":390318,"en":"While Joltoy moved among them,"},{"id":"sayakbay-ms-current144:pdf067:l004","ordinal":390319,"en":"Thousands closed in from behind,"},{"id":"sayakbay-ms-current144:pdf067:l005","ordinal":390320,"en":"He leveled his sword toward the enemy,"},{"id":"sayakbay-ms-current144:pdf067:l006","ordinal":390321,"en":"He split their dark ranks and advanced,"},{"id":"sayakbay-ms-current144:pdf067:l007","ordinal":390322,"en":"Coming onto the plain, he became formidable,"},{"id":"sayakbay-ms-current144:pdf067:l008","ordinal":390323,"en":"There were grim words of battle,"},{"id":"sayakbay-ms-current144:pdf067:l009","ordinal":390324,"en":"Hero Seytek, the gray-maned warrior,"},{"id":"sayakbay-ms-current144:pdf067:l010","ordinal":390325,"en":"Recognizing the young warrior as his own,"},{"id":"sayakbay-ms-current144:pdf067:l011","ordinal":390326,"en":"Seven eagles formed his outer guard,"},{"id":"sayakbay-ms-current144:pdf067:l012","ordinal":390327,"en":"He stayed by day and traveled at night,"},{"id":"sayakbay-ms-current144:pdf067:l013","ordinal":390328,"en":"What living soul could stand firm?"},{"id":"sayakbay-ms-current144:pdf067:l014","ordinal":390329,"en":"The gray-maned warrior chose him as a friend,"},{"id":"sayakbay-ms-current144:pdf067:l015","ordinal":390330,"en":"He found the plain and made it his land,"},{"id":"sayakbay-ms-current144:pdf067:l016","ordinal":390331,"en":"He gathered the Kyrgyz and made them a people,"},{"id":"sayakbay-ms-current144:pdf067:l017","ordinal":390332,"en":"When he rode out, he bound the enemy,"},{"id":"sayakbay-ms-current144:pdf067:l018","ordinal":390333,"en":"He did not fall in battle,"},{"id":"sayakbay-ms-current144:pdf067:l019","ordinal":390334,"en":"When illness came, he recovered,"},{"id":"sayakbay-ms-current144:pdf067:l020","ordinal":390335,"en":"In this life his soul seemed undying,"},{"id":"sayakbay-ms-current144:pdf067:l021","ordinal":390336,"en":"They recognized him and established his camp,"},{"id":"sayakbay-ms-current144:pdf067:l023","ordinal":390337,"en":"For the gray-maned champion and his men,"},{"id":"sayakbay-ms-current144:pdf067:l024","ordinal":390338,"en":"The bells rang out resoundingly,"},{"id":"sayakbay-ms-current144:pdf067:l025","ordinal":390339,"en":"They grew strong beside Seytek,"},{"id":"sayakbay-ms-current144:pdf067:l026","ordinal":390340,"en":"May many strangers never see it,"},{"id":"sayakbay-ms-current144:pdf067:l027","ordinal":390341,"en":"Their strength together became a shield,"},{"id":"sayakbay-ms-current144:pdf067:l028","ordinal":390342,"en":"The choicest provisions were gathered,"},{"id":"sayakbay-ms-current144:pdf067:l029","ordinal":390343,"en":"The companions who had seen the land,"},{"id":"sayakbay-ms-current144:pdf067:l030","ordinal":390344,"en":"While riding the bay colt forward,"},{"id":"sayakbay-ms-current144:pdf067:l032","ordinal":390345,"en":"They adorned it with white pearls."},{"id":"sayakbay-ms-current144:pdf068:l001","ordinal":390346,"en":"While journeying onward, they kept counsel,"},{"id":"sayakbay-ms-current144:pdf068:l002","ordinal":390347,"en":"He was a champion destined to prevail,"},{"id":"sayakbay-ms-current144:pdf068:l003","ordinal":390348,"en":"Many cruel men seemed impossible to kill,"},{"id":"sayakbay-ms-current144:pdf068:l004","ordinal":390349,"en":"His eyes appeared keen as a bird of prey,"},{"id":"sayakbay-ms-current144:pdf068:l005","ordinal":390350,"en":"He addressed his words to the bride,"},{"id":"sayakbay-ms-current144:pdf068:l006","ordinal":390351,"en":"He spoke with a reproachful tone,"},{"id":"sayakbay-ms-current144:pdf068:l007","ordinal":390352,"en":"He stirred what could not be spread out,"},{"id":"sayakbay-ms-current144:pdf068:l008","ordinal":390353,"en":"From your words, sweet as sugar,"},{"id":"sayakbay-ms-current144:pdf068:l009","ordinal":390354,"en":"His bent waist would not let the blow reach him,"},{"id":"sayakbay-ms-current144:pdf068:l010","ordinal":390355,"en":"From the serenely beautiful woman,"},{"id":"sayakbay-ms-current144:pdf068:l012","ordinal":390356,"en":"From rice that could not be reached,"},{"id":"sayakbay-ms-current144:pdf068:l013","ordinal":390357,"en":"They bent back and struggled with the enemy,"},{"id":"sayakbay-ms-current144:pdf068:l014","ordinal":390358,"en":"He truly came among the warriors,"},{"id":"sayakbay-ms-current144:pdf068:l015","ordinal":390359,"en":"A thousand gleamed like maidens,"},{"id":"sayakbay-ms-current144:pdf068:l016","ordinal":390360,"en":"Beauty came upon her,"},{"id":"sayakbay-ms-current144:pdf068:l017","ordinal":390361,"en":"When Ak Joltoy looked upon her,"},{"id":"sayakbay-ms-current144:pdf068:l018","ordinal":390362,"en":"Now stand and understand,"},{"id":"sayakbay-ms-current144:pdf068:l019","ordinal":390363,"en":"The champion abandoned his former manner,"},{"id":"sayakbay-ms-current144:pdf068:l020","ordinal":390364,"en":"Descending from freedom,"},{"id":"sayakbay-ms-current144:pdf068:l021","ordinal":390365,"en":"Emerging from spring, they crowded together,"},{"id":"sayakbay-ms-current144:pdf068:l022","ordinal":390366,"en":"Now then, for Joltoy,"},{"id":"sayakbay-ms-current144:pdf068:l023","ordinal":390367,"en":"Did fortune favor his road?"},{"id":"sayakbay-ms-current144:pdf068:l024","ordinal":390368,"en":"He now took up his fierce bearing,"},{"id":"sayakbay-ms-current144:pdf068:l025","ordinal":390369,"en":"The white switch struck at nothing,"},{"id":"sayakbay-ms-current144:pdf068:l026","ordinal":390370,"en":"They drove Joltoy from their hands,"},{"id":"sayakbay-ms-current144:pdf068:l027","ordinal":390371,"en":"The hidden livestock of one enclosure,"},{"id":"sayakbay-ms-current144:pdf068:l028","ordinal":390372,"en":"From the khans who had fallen,"},{"id":"sayakbay-ms-current144:pdf068:l029","ordinal":390373,"en":"They settled and watched from afar,"},{"id":"sayakbay-ms-current144:pdf068:l030","ordinal":390374,"en":"He paled before setting out,"},{"id":"sayakbay-ms-current144:pdf068:l031","ordinal":390375,"en":"He took hold of the pale horse."},{"id":"sayakbay-ms-current144:pdf069:l001","ordinal":390376,"en":"After the difficult affair had taken place,"},{"id":"sayakbay-ms-current144:pdf069:l002","ordinal":390377,"en":"When he spoke in a burst of spirit,"},{"id":"sayakbay-ms-current144:pdf069:l003","ordinal":390378,"en":"The cauldron of the warriors,"},{"id":"sayakbay-ms-current144:pdf069:l004","ordinal":390379,"en":"The copper-faced old woman appeared,"},{"id":"sayakbay-ms-current144:pdf069:l005","ordinal":390380,"en":"The white pearls were deeply buried,"},{"id":"sayakbay-ms-current144:pdf069:l006","ordinal":390381,"en":"Amid noise and bustle, they tethered the horses,"},{"id":"sayakbay-ms-current144:pdf069:l007","ordinal":390382,"en":"He spoke of his swiftness,"},{"id":"sayakbay-ms-current144:pdf069:l008","ordinal":390383,"en":"They bound one to the swift warrior,"},{"id":"sayakbay-ms-current144:pdf069:l009","ordinal":390384,"en":"His majesty surpassed that of other men,"},{"id":"sayakbay-ms-current144:pdf069:l010","ordinal":390385,"en":"The enemy stood upon reaching one ridge,"},{"id":"sayakbay-ms-current144:pdf069:l011","ordinal":390386,"en":"The marksman’s shot passed a hair’s breadth,"},{"id":"sayakbay-ms-current144:pdf069:l012","ordinal":390387,"en":"Blood dripped from his sword,"},{"id":"sayakbay-ms-current144:pdf069:l013","ordinal":390388,"en":"He drove the Kara-Kalpak onward,"},{"id":"sayakbay-ms-current144:pdf069:l014","ordinal":390389,"en":"They reached the flank of Ala-Too,"},{"id":"sayakbay-ms-current144:pdf069:l015","ordinal":390390,"en":"Such was his swiftness,"},{"id":"sayakbay-ms-current144:pdf069:l016","ordinal":390391,"en":"Now he drew it and remained,"},{"id":"sayakbay-ms-current144:pdf069:l017","ordinal":390392,"en":"After Ak Joltoy arrived,"},{"id":"sayakbay-ms-current144:pdf069:l018","ordinal":390393,"en":"He saw how swift he was,"},{"id":"sayakbay-ms-current144:pdf069:l019","ordinal":390394,"en":"He struck from the flank,"},{"id":"sayakbay-ms-current144:pdf069:l020","ordinal":390395,"en":"These black foes called Joltoy a dog,"},{"id":"sayakbay-ms-current144:pdf069:l021","ordinal":390396,"en":"Their eyes did not trust the Kalmyks,"},{"id":"sayakbay-ms-current144:pdf069:l022","ordinal":390397,"en":"The massed enemy advanced at a trot,"},{"id":"sayakbay-ms-current144:pdf069:l023","ordinal":390398,"en":"The warrior lifted the stake,"},{"id":"sayakbay-ms-current144:pdf069:l024","ordinal":390399,"en":"Of dark-thighed Joltoy,"},{"id":"sayakbay-ms-current144:pdf069:l025","ordinal":390400,"en":"He descended safely,"}]
