[{"id":"semetey-1-2013:p1026:b003:l012","ordinal":155393,"en":"Has cast his chilling lasso"},{"id":"semetey-1-2013:p1026:b003:l013","ordinal":155394,"en":"Over the languishing Churok."},{"id":"semetey-1-2013:p1026:b003:l014","ordinal":155395,"en":"He tethered Buurul far away;"},{"id":"semetey-1-2013:p1026:b003:l015","ordinal":155396,"en":"Where maidens played Orompoi,"},{"id":"semetey-1-2013:p1026:b003:l016","ordinal":155397,"en":"He remained absorbed in play."},{"id":"semetey-1-2013:p1026:b003:l017","ordinal":155398,"en":"God has taken all sense from Choro;"},{"id":"semetey-1-2013:p1026:b003:l018","ordinal":155399,"en":"Where maidens played Shabyyat,"},{"id":"semetey-1-2013:p1026:b003:l019","ordinal":155400,"en":"He made merry without haste."},{"id":"semetey-1-2013:p1026:b003:l020","ordinal":155401,"en":"Without saying, 'I have my hulking uncle,'"},{"id":"semetey-1-2013:p1026:b003:l021","ordinal":155402,"en":"With maidens who had hung a swing,"},{"id":"semetey-1-2013:p1026:b003:l022","ordinal":155403,"en":"He has stayed there frolicking!\""},{"id":"semetey-1-2013:p1026:b003:l023","ordinal":155404,"en":"Seeing this, your lord could not remain still;"},{"id":"semetey-1-2013:p1026:b003:l024","ordinal":155405,"en":"Smoke billowed from his mouth,"},{"id":"semetey-1-2013:p1026:b003:l025","ordinal":155406,"en":"And flame streamed from his eyes."},{"id":"semetey-1-2013:p1026:b003:l026","ordinal":155407,"en":"His fire-like eyes blazed;"},{"id":"semetey-1-2013:p1026:b003:l027","ordinal":155408,"en":"The gray-maned lord bristled,"},{"id":"semetey-1-2013:p1026:b003:l028","ordinal":155409,"en":"And bloodlust seized him."},{"id":"semetey-1-2013:p1026:b003:l029","ordinal":155410,"en":"Semetey grew furious,"},{"id":"semetey-1-2013:p1026:b003:l030","ordinal":155411,"en":"As though Kulchoro had taken"},{"id":"semetey-1-2013:p1026:b003:l031","ordinal":155412,"en":"His beautiful wife Churok:"},{"id":"semetey-1-2013:p1026:b003:l032","ordinal":155413,"en":"\"If I do not sacrifice"},{"id":"semetey-1-2013:p1026:b003:l033","ordinal":155414,"en":"Those two across the river!"},{"id":"semetey-1-2013:p1026:b003:l034","ordinal":155415,"en":"If I do not take every vengeance"},{"id":"semetey-1-2013:p1026:b003:l035","ordinal":155416,"en":"Upon Akun on the farther side!"},{"id":"semetey-1-2013:p1026:b003:l036","ordinal":155417,"en":"If he does not return the livestock of my lordly father Manas,"},{"id":"semetey-1-2013:p1026:b003:l037","ordinal":155418,"en":"If I do not trample upon the head"},{"id":"semetey-1-2013:p1026:b003:l038","ordinal":155419,"en":"Of that self-styled lord Akun"},{"id":"semetey-1-2013:p1026:b003:l039","ordinal":155420,"en":"And scatter all four kinds of his livestock!"},{"id":"semetey-1-2013:p1026:b004:l001","ordinal":155421,"en":"If I do not drive off his mares in pursuit"},{"id":"semetey-1-2013:p1026:b004:l002","ordinal":155422,"en":"And bring out all his hidden spite;"},{"id":"semetey-1-2013:p1026:b004:l003","ordinal":155423,"en":"If he comes near, may I rain blows"},{"id":"semetey-1-2013:p1026:b004:l004","ordinal":155424,"en":"And dash out his brains!"},{"id":"semetey-1-2013:p1026:b004:l005","ordinal":155425,"en":"Now he has struck my fury;"},{"id":"semetey-1-2013:p1026:b004:l006","ordinal":155426,"en":"Let alone Akun—may I not rest"},{"id":"semetey-1-2013:p1026:b004:l007","ordinal":155427,"en":"Until I myself have slaughtered"},{"id":"semetey-1-2013:p1026:b004:l008","ordinal":155428,"en":"Both Churok and Kulchoro!\""},{"id":"semetey-1-2013:p1026:b004:l009","ordinal":155429,"en":"The lion grew furious"},{"id":"semetey-1-2013:p1026:b004:l010","ordinal":155430,"en":"And burned with jealousy for his wife."},{"id":"semetey-1-2013:p1026:b004:l011","ordinal":155431,"en":"He loosed a lion's voice"},{"id":"semetey-1-2013:p1026:b004:l012","ordinal":155432,"en":"And shouted menacingly;"},{"id":"semetey-1-2013:p1026:b004:l013","ordinal":155433,"en":"Unable to contain his anger,"},{"id":"semetey-1-2013:p1026:b004:l014","ordinal":155434,"en":"He called out for Kanchoro."},{"id":"semetey-1-2013:p1026:b004:l015","ordinal":155435,"en":"Hearing his voice, Kanchoro,"},{"id":"semetey-1-2013:p1026:b004:l016","ordinal":155436,"en":"Saying, \"What has happened to my lord?\""},{"id":"semetey-1-2013:p1026:b004:l017","ordinal":155437,"en":"Flew like an arrow"},{"id":"semetey-1-2013:p1026:b004:l018","ordinal":155438,"en":"And reached the gray-maned hero's side."},{"id":"semetey-1-2013:p1026:b004:l019","ordinal":155439,"en":"He raged and swaggered in fury;"},{"id":"semetey-1-2013:p1026:b004:l020","ordinal":155440,"en":"God had struck the bloodthirsty man."},{"id":"semetey-1-2013:p1026:b004:l021","ordinal":155441,"en":"As though his khan-father Manas had died,"},{"id":"semetey-1-2013:p1026:b004:l022","ordinal":155442,"en":"He stood there enraged:"},{"id":"semetey-1-2013:p1026:b004:l023","ordinal":155443,"en":"\"Come here, Kanchoro."},{"id":"semetey-1-2013:p1026:b004:l024","ordinal":155444,"en":"I have seen a marvel and a spectacle;"},{"id":"semetey-1-2013:p1026:b004:l025","ordinal":155445,"en":"I will spare no wretched soul,"},{"id":"semetey-1-2013:p1026:b004:l026","ordinal":155446,"en":"For I have met a grievous calamity!"},{"id":"semetey-1-2013:p1026:b004:l027","ordinal":155447,"en":"If a khan provokes my anger, let him die;"},{"id":"semetey-1-2013:p1026:b004:l028","ordinal":155448,"en":"Today, let every soul"},{"id":"semetey-1-2013:p1026:b004:l029","ordinal":155449,"en":"Who opposes me die!\""},{"id":"semetey-1-2013:p1026:b004:l030","ordinal":155450,"en":"He shouted in fury;"},{"id":"semetey-1-2013:p1026:b004:l031","ordinal":155451,"en":"Your gray-maned hero, agitated and hurried,"},{"id":"semetey-1-2013:p1026:b004:l032","ordinal":155452,"en":"Called to Kanchoro:"},{"id":"semetey-1-2013:p1026:b004:l033","ordinal":155453,"en":"\"When I climb, you are my support;"},{"id":"semetey-1-2013:p1026:b004:l034","ordinal":155454,"en":"My anger has risen and made me rigid,"},{"id":"semetey-1-2013:p1026:b004:l035","ordinal":155455,"en":"Kanchoro, my little brother!"},{"id":"semetey-1-2013:p1026:b004:l036","ordinal":155456,"en":"Drive the fourteen horses here;"},{"id":"semetey-1-2013:p1026:b004:l037","ordinal":155457,"en":"From among those fourteen horses,"},{"id":"semetey-1-2013:p1026:b004:l038","ordinal":155458,"en":"For me to ride into Afghanistan,"},{"id":"semetey-1-2013:p1026:b004:l039","ordinal":155459,"en":"To take vengeance upon the wicked,"},{"id":"semetey-1-2013:p1027:b003:l001","ordinal":155460,"en":"Ready Taitoru for me!"},{"id":"semetey-1-2013:p1027:b003:l002","ordinal":155461,"en":"That Taitoru I tell you to prepare"},{"id":"semetey-1-2013:p1027:b003:l003","ordinal":155462,"en":"Is a renowned swift horse."},{"id":"semetey-1-2013:p1027:b003:l004","ordinal":155463,"en":"When my heroic father died,"},{"id":"semetey-1-2013:p1027:b003:l005","ordinal":155464,"en":"When my distressed mother suffered calamity,"},{"id":"semetey-1-2013:p1027:b003:l006","ordinal":155465,"en":"Khan Koshoi of the Katagan,"},{"id":"semetey-1-2013:p1027:b003:l007","ordinal":155466,"en":"My uncle, father of the people,"},{"id":"semetey-1-2013:p1027:b003:l008","ordinal":155467,"en":"Gave that horse at Asa."},{"id":"semetey-1-2013:p1027:b003:l009","ordinal":155468,"en":"Drive them here, my Choro, drive them here!"},{"id":"semetey-1-2013:p1027:b003:l010","ordinal":155469,"en":"Quickly drive the fourteen horses;"},{"id":"semetey-1-2013:p1027:b003:l011","ordinal":155470,"en":"Saddle Taitoru and drive him swiftly!\""},{"id":"semetey-1-2013:p1027:b003:l012","ordinal":155471,"en":"After hearing this command,"},{"id":"semetey-1-2013:p1027:b003:l013","ordinal":155472,"en":"Kanchoro flew like an arrow."},{"id":"semetey-1-2013:p1027:b003:l014","ordinal":155473,"en":"Some twenty-five souls,"},{"id":"semetey-1-2013:p1027:b003:l015","ordinal":155474,"en":"All sons of khans,"},{"id":"semetey-1-2013:p1027:b003:l016","ordinal":155475,"en":"The great cauldron used for cooking food,"},{"id":"semetey-1-2013:p1027:b003:l017","ordinal":155476,"en":"And six grooms who tended the horses—"},{"id":"semetey-1-2013:p1027:b003:l018","ordinal":155477,"en":"All rushed about in confusion."},{"id":"semetey-1-2013:p1027:b003:l019","ordinal":155478,"en":"In their haste, those young men"},{"id":"semetey-1-2013:p1027:b003:l020","ordinal":155479,"en":"Nearly bowed their faces to the black earth."},{"id":"semetey-1-2013:p1027:b003:l021","ordinal":155480,"en":"They pulled the stakes of the gold-tethered tent,"},{"id":"semetey-1-2013:p1027:b003:l022","ordinal":155481,"en":"Folded it together,"},{"id":"semetey-1-2013:p1027:b003:l023","ordinal":155482,"en":"And loaded it without a moment's delay"},{"id":"semetey-1-2013:p1027:b003:l024","ordinal":155483,"en":"Upon the bay horse Archa-Toru."},{"id":"semetey-1-2013:p1027:b003:l025","ordinal":155484,"en":"They drove all fourteen horses"},{"id":"semetey-1-2013:p1027:b003:l026","ordinal":155485,"en":"Loose before them,"},{"id":"semetey-1-2013:p1027:b003:l027","ordinal":155486,"en":"And reached their lord"},{"id":"semetey-1-2013:p1027:b003:l028","ordinal":155487,"en":"In the blink of an eye,"},{"id":"semetey-1-2013:p1027:b003:l029","ordinal":155488,"en":"Before anyone could say this or that,"},{"id":"semetey-1-2013:p1027:b003:l030","ordinal":155489,"en":"All in a single breath."},{"id":"semetey-1-2013:p1027:b003:l031","ordinal":155490,"en":"Kanchoro flew like an arrow,"},{"id":"semetey-1-2013:p1027:b003:l032","ordinal":155491,"en":"Taking the direct road toward his lord."},{"id":"semetey-1-2013:p1027:b003:l033","ordinal":155492,"en":"For the swaggering unfortunate man,"},{"id":"semetey-1-2013:p1027:b003:l034","ordinal":155493,"en":"Kanchoro saddled without delay"},{"id":"semetey-1-2013:p1027:b003:l035","ordinal":155494,"en":"And led Taitoru forward."},{"id":"semetey-1-2013:p1027:b003:l036","ordinal":155495,"en":"He dressed his lord"},{"id":"semetey-1-2013:p1027:b003:l037","ordinal":155496,"en":"In the blue armor-coat;"},{"id":"semetey-1-2013:p1027:b003:l038","ordinal":155497,"en":"If you would see such a deed,"},{"id":"semetey-1-2013:p1027:b003:l039","ordinal":155498,"en":"Then, making him loom magnificently,"},{"id":"semetey-1-2013:p1027:b005:l001","ordinal":155499,"en":"He mounted him upon Taitoru."},{"id":"semetey-1-2013:p1027:b005:l002","ordinal":155500,"en":"All his equipment was fastened on;"},{"id":"semetey-1-2013:p1027:b005:l003","ordinal":155501,"en":"Upon a frame fitted exactly to the camel his lord rode,"},{"id":"semetey-1-2013:p1027:b005:l004","ordinal":155502,"en":"It was loaded behind the saddle."},{"id":"semetey-1-2013:p1027:b005:l005","ordinal":155503,"en":"Skilled beyond all others,"},{"id":"semetey-1-2013:p1027:b005:l006","ordinal":155504,"en":"While the heroic lord still lived,"},{"id":"semetey-1-2013:p1027:b005:l007","ordinal":155505,"en":"Poor master Bolokbai"},{"id":"semetey-1-2013:p1027:b005:l008","ordinal":155506,"en":"Had crafted it to fit perfectly."},{"id":"semetey-1-2013:p1027:b005:l009","ordinal":155507,"en":"The gold-edged war drum"},{"id":"semetey-1-2013:p1027:b005:l010","ordinal":155508,"en":"Was covered with rhinoceros hide."},{"id":"semetey-1-2013:p1027:b005:l011","ordinal":155509,"en":"The warriors marching into Afghanistan"},{"id":"semetey-1-2013:p1027:b005:l012","ordinal":155510,"en":"Numbered twenty-five."},{"id":"semetey-1-2013:p1027:b005:l013","ordinal":155511,"en":"When they traveled on a distant campaign,"},{"id":"semetey-1-2013:p1027:b005:l014","ordinal":155512,"en":"From their fathers and forefathers"},{"id":"semetey-1-2013:p1027:b005:l015","ordinal":155513,"en":"It was their custom to beat the war drum."},{"id":"semetey-1-2013:p1027:b005:l016","ordinal":155514,"en":"Receiving word from his lord,"},{"id":"semetey-1-2013:p1027:b005:l017","ordinal":155515,"en":"Kalyk of Sarykan"},{"id":"semetey-1-2013:p1027:b005:l018","ordinal":155516,"en":"Took the iron-headed mace in hand."},{"id":"semetey-1-2013:p1027:b005:l019","ordinal":155517,"en":"He set the war drum deliberately"},{"id":"semetey-1-2013:p1027:b005:l020","ordinal":155518,"en":"In the very center."},{"id":"semetey-1-2013:p1027:b005:l021","ordinal":155519,"en":"The earth split and the mountains shifted;"},{"id":"semetey-1-2013:p1027:b005:l022","ordinal":155520,"en":"Ears were deafened by its roar."},{"id":"semetey-1-2013:p1027:b005:l023","ordinal":155521,"en":"For as long as meat takes to cook,"},{"id":"semetey-1-2013:p1027:b005:l024","ordinal":155522,"en":"All fourteen horses"},{"id":"semetey-1-2013:p1027:b005:l025","ordinal":155523,"en":"Shied and stamped without ceasing."},{"id":"semetey-1-2013:p1027:b005:l026","ordinal":155524,"en":"They set out toward Opol."},{"id":"semetey-1-2013:p1027:b005:l027","ordinal":155525,"en":"Of that swaggering unfortunate man,"},{"id":"semetey-1-2013:p1027:b005:l028","ordinal":155526,"en":"Which deed can one recount?"},{"id":"semetey-1-2013:p1027:b005:l029","ordinal":155527,"en":"They traveled day and night,"},{"id":"semetey-1-2013:p1027:b005:l030","ordinal":155528,"en":"Never stopping to rest on an elbow;"},{"id":"semetey-1-2013:p1027:b005:l031","ordinal":155529,"en":"They had the horns and trumpets sounded,"},{"id":"semetey-1-2013:p1027:b005:l032","ordinal":155530,"en":"And loaded the army's gear upon the coursers."},{"id":"semetey-1-2013:p1027:b005:l033","ordinal":155531,"en":"They traveled without sparing the horses,"},{"id":"semetey-1-2013:p1027:b005:l034","ordinal":155532,"en":"Covering great distances without restraint."},{"id":"semetey-1-2013:p1027:b005:l035","ordinal":155533,"en":"Your lord began the spectacle;"},{"id":"semetey-1-2013:p1027:b005:l036","ordinal":155534,"en":"He whipped the fourteen horses onward."},{"id":"semetey-1-2013:p1027:b005:l037","ordinal":155535,"en":"The lion, rough by nature,"},{"id":"semetey-1-2013:p1027:b005:l038","ordinal":155536,"en":"Slaughtered and left behind"},{"id":"semetey-1-2013:p1027:b005:l039","ordinal":155537,"en":"Every living creature and head of livestock."},{"id":"semetey-1-2013:p1027:b005:l040","ordinal":155538,"en":"When they heard his shout,"},{"id":"semetey-1-2013:p1028:b003:l001","ordinal":155539,"en":"The fourteen horses, mere animals though they were,"},{"id":"semetey-1-2013:p1028:b003:l002","ordinal":155540,"en":"Flattened their right ears;"},{"id":"semetey-1-2013:p1028:b003:l003","ordinal":155541,"en":"In terror, the fourteen horses"},{"id":"semetey-1-2013:p1028:b003:l004","ordinal":155542,"en":"Flung the crust of the black earth"},{"id":"semetey-1-2013:p1028:b003:l005","ordinal":155543,"en":"Up toward the sky."},{"id":"semetey-1-2013:p1028:b003:l006","ordinal":155544,"en":"They traveled in haste and agitation,"},{"id":"semetey-1-2013:p1028:b003:l007","ordinal":155545,"en":"Covering great distances without sparing the horses."},{"id":"semetey-1-2013:p1028:b003:l008","ordinal":155546,"en":"Many meadows and many grasses"},{"id":"semetey-1-2013:p1028:b003:l009","ordinal":155547,"en":"Were erased beneath their hooves;"},{"id":"semetey-1-2013:p1028:b003:l010","ordinal":155548,"en":"Behind your lord,"},{"id":"semetey-1-2013:p1028:b003:l011","ordinal":155549,"en":"Wolves and foxes fed their fill."},{"id":"semetey-1-2013:p1028:b003:l012","ordinal":155550,"en":"When he came to certain places,"},{"id":"semetey-1-2013:p1028:b003:l013","ordinal":155551,"en":"He appeared like a cuckoo;"},{"id":"semetey-1-2013:p1028:b003:l014","ordinal":155552,"en":"In wrath and astonishment,"},{"id":"semetey-1-2013:p1028:b003:l015","ordinal":155553,"en":"He berated the fourteen horses."},{"id":"semetey-1-2013:p1028:b003:l016","ordinal":155554,"en":"Under the gray-maned hero's anger,"},{"id":"semetey-1-2013:p1028:b003:l017","ordinal":155555,"en":"No person could stand and look upon him."},{"id":"semetey-1-2013:p1028:b003:l018","ordinal":155556,"en":"His aspect was grim and his venom strong;"},{"id":"semetey-1-2013:p1028:b003:l019","ordinal":155557,"en":"When frenzy seized his spirit,"},{"id":"semetey-1-2013:p1028:b003:l020","ordinal":155558,"en":"He leveled whoever opposed him."},{"id":"semetey-1-2013:p1028:b003:l021","ordinal":155559,"en":"The more he was exhausted, the more he smoldered;"},{"id":"semetey-1-2013:p1028:b003:l022","ordinal":155560,"en":"His power mounted from its very roots."},{"id":"semetey-1-2013:p1028:b003:l023","ordinal":155561,"en":"Wherever he passed,"},{"id":"semetey-1-2013:p1028:b003:l024","ordinal":155562,"en":"A thriving market seemed to arise;"},{"id":"semetey-1-2013:p1028:b003:l025","ordinal":155563,"en":"Khizr had supported him from the beginning."},{"id":"semetey-1-2013:p1028:b004:l001","ordinal":155564,"en":"For seven generations his fathers were mighty khans;"},{"id":"semetey-1-2013:p1028:b004:l002","ordinal":155565,"en":"He was the very image of a man-eating demon,"},{"id":"semetey-1-2013:p1028:b004:l003","ordinal":155566,"en":"Blessed seven times by Khizr."},{"id":"semetey-1-2013:p1028:b004:l004","ordinal":155567,"en":"From father to forefather,"},{"id":"semetey-1-2013:p1028:b004:l005","ordinal":155568,"en":"Openhearted audacity was their custom;"},{"id":"semetey-1-2013:p1028:b004:l006","ordinal":155569,"en":"Their nature was to cast disorder"},{"id":"semetey-1-2013:p1028:b004:l007","ordinal":155570,"en":"Across the whole wide world."},{"id":"semetey-1-2013:p1028:b004:l008","ordinal":155571,"en":"Tell him to drink water, and he drinks poison;"},{"id":"semetey-1-2013:p1028:b004:l009","ordinal":155572,"en":"Tell him to take a hat, and he cuts off a head."},{"id":"semetey-1-2013:p1028:b004:l010","ordinal":155573,"en":"Tell him to spill blood, and he spills souls;"},{"id":"semetey-1-2013:p1028:b004:l011","ordinal":155574,"en":"The madman destroys whoever opposes him,"},{"id":"semetey-1-2013:p1028:b004:l012","ordinal":155575,"en":"And what engulfs him is red fire."},{"id":"semetey-1-2013:p1028:b004:l013","ordinal":155576,"en":"His fathers and forefathers"},{"id":"semetey-1-2013:p1028:b004:l014","ordinal":155577,"en":"Filled their quivers with arrows"},{"id":"semetey-1-2013:p1028:b004:l015","ordinal":155578,"en":"And annihilated whoever challenged them."},{"id":"semetey-1-2013:p1028:b004:l016","ordinal":155579,"en":"Driving fourteen horses from the Kyrgyz lands,"},{"id":"semetey-1-2013:p1028:b004:l017","ordinal":155580,"en":"The bloodthirsty man marched into Afghanistan;"},{"id":"semetey-1-2013:p1028:b004:l018","ordinal":155581,"en":"If an enemy came forth in hostility,"},{"id":"semetey-1-2013:p1028:b004:l019","ordinal":155582,"en":"It was his custom to drink their blood."},{"id":"semetey-1-2013:p1028:b004:l020","ordinal":155583,"en":"Gray-maned Semetey raged,"},{"id":"semetey-1-2013:p1028:b004:l021","ordinal":155584,"en":"As though someone had carried away"},{"id":"semetey-1-2013:p1028:b004:l022","ordinal":155585,"en":"Churok, the wife he was to take."},{"id":"semetey-1-2013:p1028:b004:l023","ordinal":155586,"en":"God forbid one should behold him—"},{"id":"semetey-1-2013:p1028:b004:l024","ordinal":155587,"en":"The imperious son of Manas,"},{"id":"semetey-1-2013:p1028:b004:l025","ordinal":155588,"en":"Who had killed his own father."},{"id":"semetey-1-2013:p1028:b006:l001","ordinal":155589,"en":"Semetey, born greater"},{"id":"semetey-1-2013:p1028:b006:l002","ordinal":155590,"en":"Than his gray-maned father Manas,"},{"id":"semetey-1-2013:p1028:b006:l003","ordinal":155591,"en":"Appeared upon the plain of Ak-Kyya"},{"id":"semetey-1-2013:p1028:b006:l004","ordinal":155592,"en":"With fourteen horses."},{"id":"semetey-1-2013:p1028:b006:l005","ordinal":155593,"en":"Your gray-maned hero reached"},{"id":"semetey-1-2013:p1028:b006:l006","ordinal":155594,"en":"The bank of the Great Urgench."},{"id":"semetey-1-2013:p1028:b006:l007","ordinal":155595,"en":"In a place with high, sheer cliffs,"},{"id":"semetey-1-2013:p1028:b006:l008","ordinal":155596,"en":"Aichurok, the daughter of Akun,"},{"id":"semetey-1-2013:p1028:b006:l009","ordinal":155597,"en":"That wondrous wretched woman,"},{"id":"semetey-1-2013:p1028:b007:l001","ordinal":155598,"en":"Knew that the lord would come."},{"id":"semetey-1-2013:p1028:b007:l002","ordinal":155599,"en":"Thinking, \"How will he attempt the crossing?"},{"id":"semetey-1-2013:p1028:b007:l003","ordinal":155600,"en":"If the enraged lion enters the Urgench"},{"id":"semetey-1-2013:p1028:b007:l004","ordinal":155601,"en":"Without heed,"},{"id":"semetey-1-2013:p1028:b007:l005","ordinal":155602,"en":"He may die there for nothing,\""},{"id":"semetey-1-2013:p1028:b007:l006","ordinal":155603,"en":"She uttered a cold incantation"},{"id":"semetey-1-2013:p1028:b007:l007","ordinal":155604,"en":"And worked magic upon the weather."},{"id":"semetey-1-2013:p1028:b007:l008","ordinal":155605,"en":"Clouds tore open in the sky,"},{"id":"semetey-1-2013:p1028:b007:l009","ordinal":155606,"en":"And over the mountains rising from the foothills,"},{"id":"semetey-1-2013:p1029:b003:l001","ordinal":155607,"en":"There was neither hail nor rain;"},{"id":"semetey-1-2013:p1029:b003:l002","ordinal":155608,"en":"A freezing wind appeared."},{"id":"semetey-1-2013:p1029:b003:l003","ordinal":155609,"en":"All the lesser streams,"},{"id":"semetey-1-2013:p1029:b003:l004","ordinal":155610,"en":"Troubled and splashing,"},{"id":"semetey-1-2013:p1029:b003:l005","ordinal":155611,"en":"Separated and flowed in every direction."},{"id":"semetey-1-2013:p1029:b003:l006","ordinal":155612,"en":"Not one of a thousand running waters remained;"},{"id":"semetey-1-2013:p1029:b003:l007","ordinal":155613,"en":"Only the Great Urgench was left,"},{"id":"semetey-1-2013:p1029:b003:l008","ordinal":155614,"en":"Its stones visible in the riverbed."},{"id":"semetey-1-2013:p1029:b003:l009","ordinal":155615,"en":"Aichurok, the daughter of Akun,"},{"id":"semetey-1-2013:p1029:b003:l010","ordinal":155616,"en":"That clever-born wretched woman,"},{"id":"semetey-1-2013:p1029:b003:l011","ordinal":155617,"en":"Revealed her form as a weather-worker."},{"id":"semetey-1-2013:p1029:b003:l012","ordinal":155618,"en":"Not a spoonful of water ran from the springs;"},{"id":"semetey-1-2013:p1029:b003:l013","ordinal":155619,"en":"It lay frozen outside,"},{"id":"semetey-1-2013:p1029:b003:l014","ordinal":155620,"en":"As though the depths of winter had come."},{"id":"semetey-1-2013:p1029:b003:l015","ordinal":155621,"en":"So powerful was her incantation"},{"id":"semetey-1-2013:p1029:b003:l016","ordinal":155622,"en":"That the heads of the glaciers froze."},{"id":"semetey-1-2013:p1029:b003:l017","ordinal":155623,"en":"Through her spell, the Great Urgench"},{"id":"semetey-1-2013:p1029:b003:l018","ordinal":155624,"en":"Lay without flowing,"},{"id":"semetey-1-2013:p1029:b003:l019","ordinal":155625,"en":"Only a waterskin's little measure of water stirring."},{"id":"semetey-1-2013:p1029:b003:l020","ordinal":155626,"en":"If you would behold Semetey,"},{"id":"semetey-1-2013:p1029:b003:l021","ordinal":155627,"en":"He pleaded with his Allah"},{"id":"semetey-1-2013:p1029:b003:l022","ordinal":155628,"en":"And strained like a white tiger."},{"id":"semetey-1-2013:p1029:b003:l023","ordinal":155629,"en":"Driving fourteen horses from the Argyn,"},{"id":"semetey-1-2013:p1029:b003:l024","ordinal":155630,"en":"He drove all those horses"},{"id":"semetey-1-2013:p1029:b003:l025","ordinal":155631,"en":"So hard they seemed about to die;"},{"id":"semetey-1-2013:p1029:b003:l026","ordinal":155632,"en":"Their white foam streamed."},{"id":"semetey-1-2013:p1029:b003:l027","ordinal":155633,"en":"He drove them swiftly without stopping."},{"id":"semetey-1-2013:p1029:b003:l028","ordinal":155634,"en":"Then Semetey grew furious;"},{"id":"semetey-1-2013:p1029:b003:l029","ordinal":155635,"en":"As though Kalmyks had raided"},{"id":"semetey-1-2013:p1029:b003:l030","ordinal":155636,"en":"The populous Kyrgyz nation,"},{"id":"semetey-1-2013:p1029:b003:l031","ordinal":155637,"en":"He had his trumpet drawn out"},{"id":"semetey-1-2013:p1029:b003:l032","ordinal":155638,"en":"And advanced in dread majesty."},{"id":"semetey-1-2013:p1029:b003:l033","ordinal":155639,"en":"He urged the fourteen horses onward;"},{"id":"semetey-1-2013:p1029:b003:l034","ordinal":155640,"en":"No person could approach his anger,"},{"id":"semetey-1-2013:p1029:b003:l035","ordinal":155641,"en":"And no one wished to see his frowning brow."},{"id":"semetey-1-2013:p1029:b003:l036","ordinal":155642,"en":"Of the extravagantly born gray-maned hero,"},{"id":"semetey-1-2013:p1029:b003:l037","ordinal":155643,"en":"Which deed can one recount?"},{"id":"semetey-1-2013:p1029:b003:l038","ordinal":155644,"en":"He who had pastured at Middle Keng-Kol"},{"id":"semetey-1-2013:p1029:b003:l039","ordinal":155645,"en":"And tethered his fourteen horses—"},{"id":"semetey-1-2013:p1029:b004:l001","ordinal":155646,"en":"If enemies came out shooting,"},{"id":"semetey-1-2013:p1029:b004:l002","ordinal":155647,"en":"He drove them before him,"},{"id":"semetey-1-2013:p1029:b004:l003","ordinal":155648,"en":"And, lion that he was,"}]
