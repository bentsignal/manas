[{"id":"manas-2010:p0738:b001:l008","ordinal":32769,"en":"Its name remains even now,"},{"id":"manas-2010:p0738:b001:l009","ordinal":32770,"en":"The place they scattered his four kinds of livestock."},{"id":"manas-2010:p0738:b001:l010","ordinal":32771,"en":"In Kashalay's deep hollow,"},{"id":"manas-2010:p0738:b001:l011","ordinal":32772,"en":"Beside the Kum-Aryk River,"},{"id":"manas-2010:p0738:b001:l012","ordinal":32773,"en":"Making the excitement costly,"},{"id":"manas-2010:p0738:b001:l013","ordinal":32774,"en":"Alöökö was resourceful."},{"id":"manas-2010:p0738:b001:l014","ordinal":32775,"en":"He had draped a silk robe over his shoulders,"},{"id":"manas-2010:p0738:b001:l015","ordinal":32776,"en":"And mounted a pacer that did not trot."},{"id":"manas-2010:p0738:b001:l016","ordinal":32777,"en":"(Sixty Manchus and forty nobles"},{"id":"manas-2010:p0738:b001:l017","ordinal":32778,"en":"He had taken beside him.)"},{"id":"manas-2010:p0738:b001:l018","ordinal":32779,"en":"The gold he had plundered,"},{"id":"manas-2010:p0738:b001:l019","ordinal":32780,"en":"He scattered upon the open plain."},{"id":"manas-2010:p0738:b001:l020","ordinal":32781,"en":"His sorcerer conjuring the weather,"},{"id":"manas-2010:p0738:b001:l021","ordinal":32782,"en":"Alöökö was resourceful;"},{"id":"manas-2010:p0738:b001:l022","ordinal":32783,"en":"He fled toward Beijing."},{"id":"manas-2010:p0738:b001:l023","ordinal":32784,"en":"When bloodthirsty Manas attacked,"},{"id":"manas-2010:p0738:b001:l024","ordinal":32785,"en":"Look at the great turmoil!"},{"id":"manas-2010:p0738:b001:l025","ordinal":32786,"en":"Joining what had broken,"},{"id":"manas-2010:p0738:b001:l026","ordinal":32787,"en":"Gathering what had scattered,"},{"id":"manas-2010:p0738:b001:l027","ordinal":32788,"en":"His wise elder Bakay,"},{"id":"manas-2010:p0738:b001:l028","ordinal":32789,"en":"Look at all his service!"},{"id":"manas-2010:p0738:b001:l029","ordinal":32790,"en":"When going in against Alöökö,"},{"id":"manas-2010:p0738:b001:l030","ordinal":32791,"en":"When striking with a battle cry,"},{"id":"manas-2010:p0738:b001:l031","ordinal":32792,"en":"‘Our task may go awry,’ he said,"},{"id":"manas-2010:p0738:b001:l032","ordinal":32793,"en":"‘Alöökö, may he burn to death,"},{"id":"manas-2010:p0738:b001:l033","ordinal":32794,"en":"May happen to escape,’ he said."},{"id":"manas-2010:p0738:b001:l034","ordinal":32795,"en":"Khan Manas's forty wolves,"},{"id":"manas-2010:p0738:b001:l035","ordinal":32796,"en":"Before they struck the enemy,"},{"id":"manas-2010:p0738:b001:l036","ordinal":32797,"en":"He had gathered them together,"},{"id":"manas-2010:p0738:b001:l037","ordinal":32798,"en":"And set them moving in a line."},{"id":"manas-2010:p0738:b001:l038","ordinal":32799,"en":"When a black gun boomed,"},{"id":"manas-2010:p0738:b001:l039","ordinal":32800,"en":"From heroes who would not flee,"},{"id":"manas-2010:p0738:b001:l040","ordinal":32801,"en":"Hero Bakay had chosen."},{"id":"manas-2010:p0738:b001:l041","ordinal":32802,"en":"When a fearsome gun cracked,"},{"id":"manas-2010:p0738:b001:l042","ordinal":32803,"en":"From champions who did not startle,"},{"id":"manas-2010:p0739:b001:l001","ordinal":32804,"en":"Mighty Bakay had found them."},{"id":"manas-2010:p0739:b001:l002","ordinal":32805,"en":"Turning wise plans in his mind,"},{"id":"manas-2010:p0739:b001:l003","ordinal":32806,"en":"Along the route of escape,"},{"id":"manas-2010:p0739:b001:l004","ordinal":32807,"en":"Beside Dyngshang-Talaa,"},{"id":"manas-2010:p0739:b001:l005","ordinal":32808,"en":"He had sent twelve champions."},{"id":"manas-2010:p0739:b001:l006","ordinal":32809,"en":"The twelve champions then,"},{"id":"manas-2010:p0739:b001:l007","ordinal":32810,"en":"Receiving orders, blocked the way."},{"id":"manas-2010:p0739:b001:l008","ordinal":32811,"en":"Your elder, lion Bakay's"},{"id":"manas-2010:p0739:b001:l009","ordinal":32812,"en":"Wisdom had far surpassed all."},{"id":"manas-2010:p0739:b001:l010","ordinal":32813,"en":"Along the road they blocked,"},{"id":"manas-2010:p0739:b001:l011","ordinal":32814,"en":"From that day until this,"},{"id":"manas-2010:p0739:b001:l012","ordinal":32815,"en":"The name Twelve Champions remains."},{"id":"manas-2010:p0739:b001:l013","ordinal":32816,"en":"All twelve of them"},{"id":"manas-2010:p0739:b001:l014","ordinal":32817,"en":"Were brave men who could ravage the Oirats."},{"id":"manas-2010:p0739:b001:l015","ordinal":32818,"en":"Those champions' names:"},{"id":"manas-2010:p0739:b001:l016","ordinal":32819,"en":"Küldür and Chalybay,"},{"id":"manas-2010:p0739:b001:l017","ordinal":32820,"en":"Serek and Shuutu, those two,"},{"id":"manas-2010:p0739:b001:l018","ordinal":32821,"en":"Tölgöchü and Yrchy Uulu,"},{"id":"manas-2010:p0739:b001:l019","ordinal":32822,"en":"Baychoro and Boz Uulu,"},{"id":"manas-2010:p0739:b001:l020","ordinal":32823,"en":"Far-seeing Dangyl,"},{"id":"manas-2010:p0739:b001:l021","ordinal":32824,"en":"Foremost among spearmen,"},{"id":"manas-2010:p0739:b001:l022","ordinal":32825,"en":"The twelve champions had gone ahead."},{"id":"manas-2010:p0739:b001:l023","ordinal":32826,"en":"Of warrior Alöökö,"},{"id":"manas-2010:p0739:b001:l024","ordinal":32827,"en":"Coming out in front of him then,"},{"id":"manas-2010:p0739:b001:l025","ordinal":32828,"en":"The twelve champions blocked the way."},{"id":"manas-2010:p0739:b001:l026","ordinal":32829,"en":"A churning, low-lying fog,"},{"id":"manas-2010:p0739:b001:l027","ordinal":32830,"en":"The twelve saw the dust."},{"id":"manas-2010:p0739:b001:l028","ordinal":32831,"en":"Desperately, without stopping,"},{"id":"manas-2010:p0739:b001:l029","ordinal":32832,"en":"One band fleeing fast,"},{"id":"manas-2010:p0739:b001:l030","ordinal":32833,"en":"The twelve saw the people."},{"id":"manas-2010:p0739:b001:l031","ordinal":32834,"en":"Küldür and Chalybay"},{"id":"manas-2010:p0739:b001:l032","ordinal":32835,"en":"Stood watching on lookout."},{"id":"manas-2010:p0739:b001:l033","ordinal":32836,"en":"The other ten wolves"},{"id":"manas-2010:p0739:b001:l034","ordinal":32837,"en":"Shouted and thrust their spears."},{"id":"manas-2010:p0739:b001:l035","ordinal":32838,"en":"When the ten emerged onto the road,"},{"id":"manas-2010:p0739:b001:l036","ordinal":32839,"en":"Alöökö was a destroyer."},{"id":"manas-2010:p0739:b001:l037","ordinal":32840,"en":"Drawing bows, sending arrows like rain,"},{"id":"manas-2010:p0739:b001:l038","ordinal":32841,"en":"Firing bullets like hail,"},{"id":"manas-2010:p0739:b001:l039","ordinal":32842,"en":"They stood face to face."},{"id":"manas-2010:p0739:b001:l040","ordinal":32843,"en":"Such was their skill:"},{"id":"manas-2010:p0739:b001:l041","ordinal":32844,"en":"Firing guns and drawing bows,"},{"id":"manas-2010:p0739:b001:l042","ordinal":32845,"en":"They fought with crashing blows,"},{"id":"manas-2010:p0740:b001:l001","ordinal":32846,"en":"Those struck by gunfire fell in heaps;"},{"id":"manas-2010:p0740:b001:l002","ordinal":32847,"en":"Those whose doom had come fell to bullets."},{"id":"manas-2010:p0740:b001:l003","ordinal":32848,"en":"Unable to withstand the spear-points,"},{"id":"manas-2010:p0740:b001:l004","ordinal":32849,"en":"The padded coats were torn."},{"id":"manas-2010:p0740:b001:l005","ordinal":32850,"en":"Masses of fiber like cauldron-baskets"},{"id":"manas-2010:p0740:b001:l006","ordinal":32851,"en":"Were ripped out on spear-points."},{"id":"manas-2010:p0740:b001:l007","ordinal":32852,"en":"The twelve renowned champions,"},{"id":"manas-2010:p0740:b001:l008","ordinal":32853,"en":"Their valor unlike any other's,"},{"id":"manas-2010:p0740:b001:l009","ordinal":32854,"en":"No empty word is spoken:"},{"id":"manas-2010:p0740:b001:l010","ordinal":32855,"en":"Wolves who could ravage the world,"},{"id":"manas-2010:p0740:b001:l011","ordinal":32856,"en":"Lion Manas's attendants,"},{"id":"manas-2010:p0740:b001:l012","ordinal":32857,"en":"Exchanged much gunfire."},{"id":"manas-2010:p0740:b001:l013","ordinal":32858,"en":"Not letting Alöökö escape,"},{"id":"manas-2010:p0740:b001:l014","ordinal":32859,"en":"For six full days,"},{"id":"manas-2010:p0740:b001:l015","ordinal":32860,"en":"They blocked his path."},{"id":"manas-2010:p0740:b001:l016","ordinal":32861,"en":"Valiant Manas the leopard"},{"id":"manas-2010:p0740:b001:l017","ordinal":32862,"en":"Had begun a fierce slaughter."},{"id":"manas-2010:p0740:b001:l018","ordinal":32863,"en":"Alöökö's vast army laden with gold,"},{"id":"manas-2010:p0740:b001:l019","ordinal":32864,"en":"He had slaughtered them all."},{"id":"manas-2010:p0740:b001:l020","ordinal":32865,"en":"He had butchered his heroes."},{"id":"manas-2010:p0740:b001:l021","ordinal":32866,"en":"Beside that gold,"},{"id":"manas-2010:p0740:b001:l022","ordinal":32867,"en":"Ready to carry it away,"},{"id":"manas-2010:p0740:b001:l023","ordinal":32868,"en":"He had stationed the forty champions."},{"id":"manas-2010:p0740:b001:l024","ordinal":32869,"en":"The two heroes Azhybay and Bakay,"},{"id":"manas-2010:p0740:b001:l025","ordinal":32870,"en":"He took as companions."},{"id":"manas-2010:p0740:b001:l026","ordinal":32871,"en":"Then the lion prince,"},{"id":"manas-2010:p0740:b001:l027","ordinal":32872,"en":"Of warrior Khan Alöökö,"},{"id":"manas-2010:p0740:b001:l028","ordinal":32873,"en":"Set out along the fleeing tracks."},{"id":"manas-2010:p0740:b001:l029","ordinal":32874,"en":"Azhybay's Kartküröng,"},{"id":"manas-2010:p0740:b001:l030","ordinal":32875,"en":"Khan Manas's Akkula,"},{"id":"manas-2010:p0740:b001:l031","ordinal":32876,"en":"Khan Bakay's gray wondrous steed,"},{"id":"manas-2010:p0740:b001:l032","ordinal":32877,"en":"On the three wondrous steeds they raced,"},{"id":"manas-2010:p0740:b001:l033","ordinal":32878,"en":"Struggling with their horses' mouths,"},{"id":"manas-2010:p0740:b001:l034","ordinal":32879,"en":"Making them prance and toss,"},{"id":"manas-2010:p0740:b001:l035","ordinal":32880,"en":"Making them pant and surge."},{"id":"manas-2010:p0740:b001:l036","ordinal":32881,"en":"The deeds of the valiant ones,"},{"id":"manas-2010:p0740:b001:l037","ordinal":32882,"en":"The havoc they brought upon the Chinese!"},{"id":"manas-2010:p0740:b001:l038","ordinal":32883,"en":"Panting, the three raced,"},{"id":"manas-2010:p0740:b001:l039","ordinal":32884,"en":"Their stirrups clashing."},{"id":"manas-2010:p0740:b001:l040","ordinal":32885,"en":"When they entered a descent,"},{"id":"manas-2010:p0740:b001:l041","ordinal":32886,"en":"The gray wondrous steed led by a neck."},{"id":"manas-2010:p0740:b001:l042","ordinal":32887,"en":"When they came to uneven, hilly ground,"},{"id":"manas-2010:p0741:b001:l001","ordinal":32888,"en":"Akkula led by a body length,"},{"id":"manas-2010:p0741:b001:l002","ordinal":32889,"en":"But when they reached the open plain,"},{"id":"manas-2010:p0741:b001:l003","ordinal":32890,"en":"Kartküröng led as he pleased."},{"id":"manas-2010:p0741:b001:l004","ordinal":32891,"en":"Valiant Bakai and Khan Manas"},{"id":"manas-2010:p0741:b001:l005","ordinal":32892,"en":"Grew boundlessly excited;"},{"id":"manas-2010:p0741:b001:l006","ordinal":32893,"en":"Out on the wide yellow plain"},{"id":"manas-2010:p0741:b001:l007","ordinal":32894,"en":"The wolf-maned hero now arrived."},{"id":"manas-2010:p0741:b001:l008","ordinal":32895,"en":"Such was the nature of that plain:"},{"id":"manas-2010:p0741:b001:l009","ordinal":32896,"en":"Not a blade of grass to nibble,"},{"id":"manas-2010:p0741:b001:l010","ordinal":32897,"en":"Not a drop of water anywhere."},{"id":"manas-2010:p0741:b001:l011","ordinal":32898,"en":"The land was hidden, shrouded;"},{"id":"manas-2010:p0741:b001:l012","ordinal":32899,"en":"The face of the earth could not be seen,"},{"id":"manas-2010:p0741:b001:l013","ordinal":32900,"en":"As ground fog settled and swirled."},{"id":"manas-2010:p0741:b001:l014","ordinal":32901,"en":"Nothing could be caught by the eye;"},{"id":"manas-2010:p0741:b001:l015","ordinal":32902,"en":"The earth's face lay in ground fog,"},{"id":"manas-2010:p0741:b001:l016","ordinal":32903,"en":"And none could tell what lay where."},{"id":"manas-2010:p0741:b001:l017","ordinal":32904,"en":"The haze would not lift from the ground;"},{"id":"manas-2010:p0741:b001:l018","ordinal":32905,"en":"No mountain peak, even cap-sized, could be seen."},{"id":"manas-2010:p0741:b001:l019","ordinal":32906,"en":"Hills and hollows lay beyond,"},{"id":"manas-2010:p0741:b001:l020","ordinal":32907,"en":"The plain of Ak-Özön on this side."},{"id":"manas-2010:p0741:b001:l021","ordinal":32908,"en":"When they rode into it,"},{"id":"manas-2010:p0741:b001:l022","ordinal":32909,"en":"Shouting came from the farther side."},{"id":"manas-2010:p0741:b001:l023","ordinal":32910,"en":"Listening to those shouts,"},{"id":"manas-2010:p0741:b001:l024","ordinal":32911,"en":"They heard the battle cry, “Manas!”"},{"id":"manas-2010:p0741:b001:l025","ordinal":32912,"en":"On the nearer side, more shouting;"},{"id":"manas-2010:p0741:b001:l026","ordinal":32913,"en":"Listening carefully,"},{"id":"manas-2010:p0741:b001:l027","ordinal":32914,"en":"They heard the battle cry, “Kakan!”"},{"id":"manas-2010:p0741:b001:l028","ordinal":32915,"en":"The twelve fearsome men who had gone ahead,"},{"id":"manas-2010:p0741:b001:l029","ordinal":32916,"en":"Whose valor was extraordinary,"},{"id":"manas-2010:p0741:b001:l030","ordinal":32917,"en":"Had outstripped the others."},{"id":"manas-2010:p0741:b001:l031","ordinal":32918,"en":"Allowing no escape to either side,"},{"id":"manas-2010:p0741:b001:l032","ordinal":32919,"en":"They had the warrior Alööke—"},{"id":"manas-2010:p0741:b001:l033","ordinal":32920,"en":"Those twelve champions and valiant Shuutu—"},{"id":"manas-2010:p0741:b001:l034","ordinal":32921,"en":"Blocked before them."},{"id":"manas-2010:p0741:b001:l035","ordinal":32922,"en":"For Kakan-Chyn's Beijing,"},{"id":"manas-2010:p0741:b001:l036","ordinal":32923,"en":"A gateway with doors of steel,"},{"id":"manas-2010:p0741:b001:l037","ordinal":32924,"en":"Alööke of the Chinese"},{"id":"manas-2010:p0741:b001:l038","ordinal":32925,"en":"Proved a formidable warrior."},{"id":"manas-2010:p0741:b001:l039","ordinal":32926,"en":"He charged amid a great uproar,"},{"id":"manas-2010:p0741:b001:l040","ordinal":32927,"en":"Shattering the twelve,"},{"id":"manas-2010:p0741:b001:l041","ordinal":32928,"en":"And was about to overwhelm them."},{"id":"manas-2010:p0741:b001:l042","ordinal":32929,"en":"Alööke, ablaze with deadly fury,"},{"id":"manas-2010:p0742:b001:l001","ordinal":32930,"en":"Was breaking free on every side,"},{"id":"manas-2010:p0742:b001:l002","ordinal":32931,"en":"Ready to make his escape."},{"id":"manas-2010:p0742:b001:l003","ordinal":32932,"en":"At that very moment,"},{"id":"manas-2010:p0742:b001:l004","ordinal":32933,"en":"Striking Akkula once on the flank,"},{"id":"manas-2010:p0742:b001:l005","ordinal":32934,"en":"The lion prince"},{"id":"manas-2010:p0742:b001:l006","ordinal":32935,"en":"Raised the battle cry, “Manas!”"},{"id":"manas-2010:p0742:b001:l007","ordinal":32936,"en":"When bloodthirsty Manas arrived,"},{"id":"manas-2010:p0742:b001:l008","ordinal":32937,"en":"Shouts rose from the flank;"},{"id":"manas-2010:p0742:b001:l009","ordinal":32938,"en":"Valiant Bakai arrived as well,"},{"id":"manas-2010:p0742:b001:l010","ordinal":32939,"en":"Raising the battle cry, “Manas!”"},{"id":"manas-2010:p0742:b001:l011","ordinal":32940,"en":"Shouts rose from the sloping side;"},{"id":"manas-2010:p0742:b001:l012","ordinal":32941,"en":"Your wolf-maned champion Ajy,"},{"id":"manas-2010:p0742:b001:l013","ordinal":32942,"en":"Maneuvering upon Kartküröng,"},{"id":"manas-2010:p0742:b001:l014","ordinal":32943,"en":"Sent all he met crawling to the ground,"},{"id":"manas-2010:p0742:b001:l015","ordinal":32944,"en":"Raising the battle cry, “Manas!”"},{"id":"manas-2010:p0742:b001:l016","ordinal":32945,"en":"From the front, the companions"},{"id":"manas-2010:p0742:b001:l017","ordinal":32946,"en":"Raised their shout of “Manas!”"},{"id":"manas-2010:p0742:b001:l018","ordinal":32947,"en":"However great his valor,"},{"id":"manas-2010:p0742:b001:l019","ordinal":32948,"en":"Alööke looked on"},{"id":"manas-2010:p0742:b001:l020","ordinal":32949,"en":"And now had no recourse left."},{"id":"manas-2010:p0742:b001:l021","ordinal":32950,"en":"They slaughtered without ceasing,"},{"id":"manas-2010:p0742:b001:l022","ordinal":32951,"en":"And caught him between them."},{"id":"manas-2010:p0742:b001:l023","ordinal":32952,"en":"Alööke and his governor"},{"id":"manas-2010:p0742:b001:l024","ordinal":32953,"en":"Dismounted from their horses."},{"id":"manas-2010:p0742:b001:l025","ordinal":32954,"en":"Their knees bent—"},{"id":"manas-2010:p0742:b001:l026","ordinal":32955,"en":"When the Chinese are defeated,"},{"id":"manas-2010:p0742:b001:l027","ordinal":32956,"en":"Such, it seems, is their custom—"},{"id":"manas-2010:p0742:b001:l028","ordinal":32957,"en":"Before Khan Manas"},{"id":"manas-2010:p0742:b001:l029","ordinal":32958,"en":"They bowed like brides."},{"id":"manas-2010:p0742:b001:l030","ordinal":32959,"en":"Once Alööke had been captured,"},{"id":"manas-2010:p0742:b001:l031","ordinal":32960,"en":"That warrior Manas of yours"},{"id":"manas-2010:p0742:b001:l032","ordinal":32961,"en":"Began a dreadful torment."},{"id":"manas-2010:p0742:b001:l033","ordinal":32962,"en":"The Manchus beside him,"},{"id":"manas-2010:p0742:b001:l034","ordinal":32963,"en":"His nobles and princes,"},{"id":"manas-2010:p0742:b001:l035","ordinal":32964,"en":"Those who did not rule the people,"},{"id":"manas-2010:p0742:b001:l036","ordinal":32965,"en":"He cut them all down."},{"id":"manas-2010:p0742:b001:l037","ordinal":32966,"en":"He sharpened his black tongue:"},{"id":"manas-2010:p0742:b001:l038","ordinal":32967,"en":"“Khan, do not kill me!”"},{"id":"manas-2010:p0742:b001:l039","ordinal":32968,"en":"Alööke was quick-witted;"},{"id":"manas-2010:p0742:b001:l040","ordinal":32969,"en":"He poured out words like these:"},{"id":"manas-2010:p0742:b001:l041","ordinal":32970,"en":"“Well done, Manas, wolf-maned warrior!"},{"id":"manas-2010:p0742:b001:l042","ordinal":32971,"en":"You truly are a lion."},{"id":"manas-2010:p0743:b001:l001","ordinal":32972,"en":"A peerless, blood-drinking champion,"},{"id":"manas-2010:p0743:b001:l002","ordinal":32973,"en":"A true warrior you are."},{"id":"manas-2010:p0743:b001:l003","ordinal":32974,"en":"Upright Manas, my wolf-maned one,"},{"id":"manas-2010:p0743:b001:l004","ordinal":32975,"en":"Born in the broad Altai,"},{"id":"manas-2010:p0743:b001:l005","ordinal":32976,"en":"You were known to be a lion."},{"id":"manas-2010:p0743:b001:l006","ordinal":32977,"en":"When they heard your fame,"},{"id":"manas-2010:p0743:b001:l007","ordinal":32978,"en":"The khans of Kakan-Chyn"},{"id":"manas-2010:p0743:b001:l008","ordinal":32979,"en":"Were distressed to their very core."},{"id":"manas-2010:p0743:b001:l009","ordinal":32980,"en":"When they said that you were born,"},{"id":"manas-2010:p0743:b001:l010","ordinal":32981,"en":"My collarbone gave a jolt,"},{"id":"manas-2010:p0743:b001:l011","ordinal":32982,"en":"My dung-filled guts shook."},{"id":"manas-2010:p0743:b001:l012","ordinal":32983,"en":"That swine, the warrior Esenkan—"},{"id":"manas-2010:p0743:b001:l013","ordinal":32984,"en":"Did you see his foolishness?"},{"id":"manas-2010:p0743:b001:l014","ordinal":32985,"en":"‘Manas was born; that wolf-maned one"},{"id":"manas-2010:p0743:b001:l015","ordinal":32986,"en":"I captured long ago,’ he said."},{"id":"manas-2010:p0743:b001:l016","ordinal":32987,"en":"‘To a dungeon forty rope-lengths deep"},{"id":"manas-2010:p0743:b001:l017","ordinal":32988,"en":"I took him and threw him in,’ he said."},{"id":"manas-2010:p0743:b001:l018","ordinal":32989,"en":"That ill-starred Manchu—"},{"id":"manas-2010:p0743:b001:l019","ordinal":32990,"en":"What can I do about the lies he told?"},{"id":"manas-2010:p0743:b001:l020","ordinal":32991,"en":"My bloodthirsty Manas, you have come;"},{"id":"manas-2010:p0743:b001:l021","ordinal":32992,"en":"I am a hare caught in your hand."},{"id":"manas-2010:p0743:b001:l022","ordinal":32993,"en":"You have kept on slaughtering;"},{"id":"manas-2010:p0743:b001:l023","ordinal":32994,"en":"I heard no news, received no word,"},{"id":"manas-2010:p0743:b001:l024","ordinal":32995,"en":"Never heard, ‘Khan Manas is coming.’"},{"id":"manas-2010:p0743:b001:l025","ordinal":32996,"en":"For long I knew nothing of your fame."},{"id":"manas-2010:p0743:b001:l026","ordinal":32997,"en":"When I held my white dwelling there,"},{"id":"manas-2010:p0743:b001:l027","ordinal":32998,"en":"I levied tribute on the Burut,"},{"id":"manas-2010:p0743:b001:l028","ordinal":32999,"en":"Taking and consuming without mercy."},{"id":"manas-2010:p0743:b001:l029","ordinal":33000,"en":"From your women I took the skilled craftswomen;"},{"id":"manas-2010:p0743:b001:l030","ordinal":33001,"en":"As tribute I took"},{"id":"manas-2010:p0743:b001:l031","ordinal":33002,"en":"Your fairest, beautiful girls."},{"id":"manas-2010:p0743:b001:l032","ordinal":33003,"en":"Hear this from me, Manas:"},{"id":"manas-2010:p0743:b001:l033","ordinal":33004,"en":"Long ago I had paid in full"},{"id":"manas-2010:p0743:b001:l034","ordinal":33005,"en":"The price of my life in this world."},{"id":"manas-2010:p0743:b001:l035","ordinal":33006,"en":"I took aim at your champions;"},{"id":"manas-2010:p0743:b001:l036","ordinal":33007,"en":"I fought with serpents,"},{"id":"manas-2010:p0743:b001:l037","ordinal":33008,"en":"Destroyed every one of them,"},{"id":"manas-2010:p0743:b001:l038","ordinal":33009,"en":"And seized the city of Margalang."},{"id":"manas-2010:p0743:b001:l039","ordinal":33010,"en":"My Burut, in your land"},{"id":"manas-2010:p0743:b001:l040","ordinal":33011,"en":"I was a khan with a white dwelling."},{"id":"manas-2010:p0743:b001:l041","ordinal":33012,"en":"My strength and power then"},{"id":"manas-2010:p0743:b001:l042","ordinal":33013,"en":"Were like those of Solomon."},{"id":"manas-2010:p0744:b001:l001","ordinal":33014,"en":"I was a pillar risen from Beijing;"},{"id":"manas-2010:p0744:b001:l002","ordinal":33015,"en":"For the countless Chinese people"},{"id":"manas-2010:p0744:b001:l003","ordinal":33016,"en":"I was a fortified city, a stronghold."},{"id":"manas-2010:p0744:b001:l004","ordinal":33017,"en":"The Chinese had need of me."},{"id":"manas-2010:p0744:b001:l005","ordinal":33018,"en":"Bind me without hurting me;"},{"id":"manas-2010:p0744:b001:l006","ordinal":33019,"en":"Put me in an iron cage."},{"id":"manas-2010:p0744:b001:l007","ordinal":33020,"en":"In Beijing with its forty gates,"},{"id":"manas-2010:p0744:b001:l008","ordinal":33021,"en":"He is a ruler, not a god,"},{"id":"manas-2010:p0744:b001:l009","ordinal":33022,"en":"Yet all the deeds he does"},{"id":"manas-2010:p0744:b001:l010","ordinal":33023,"en":"Are not far from those of your God—"},{"id":"manas-2010:p0744:b001:l011","ordinal":33024,"en":"Karykan, the khan of Beijing."}]
