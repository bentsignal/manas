[{"id":"semetey-1-2013:p0482:b004:l038","ordinal":113921,"en":"Your father's grave, forty nobles!"},{"id":"semetey-1-2013:p0482:b004:l039","ordinal":113922,"en":"Has your moment to be needed come?"},{"id":"semetey-1-2013:p0483:b003:l001","ordinal":113923,"en":"Have the vanished fugitives camped here?"},{"id":"semetey-1-2013:p0483:b003:l003","ordinal":113924,"en":"Forty companions, has your expedition prospered?"},{"id":"semetey-1-2013:p0483:b003:l005","ordinal":113925,"en":"May your bustling good fortune open,"},{"id":"semetey-1-2013:p0483:b003:l006","ordinal":113926,"en":"May all your grief scatter."},{"id":"semetey-1-2013:p0483:b003:l007","ordinal":113927,"en":"Black steel, impenetrable to bullets—"},{"id":"semetey-1-2013:p0483:b003:l008","ordinal":113928,"en":"Your father's grave, forty nobles!—"},{"id":"semetey-1-2013:p0483:b003:l009","ordinal":113929,"en":"The time has come to put it on."},{"id":"semetey-1-2013:p0483:b003:l010","ordinal":113930,"en":"Like jackdaws upon the fugitives,"},{"id":"semetey-1-2013:p0483:b003:l011","ordinal":113931,"en":"Companions, the time has come to strike."},{"id":"semetey-1-2013:p0483:b003:l012","ordinal":113932,"en":"Making them shriek, beating them,"},{"id":"semetey-1-2013:p0483:b003:l013","ordinal":113933,"en":"Heroes, the time has come to strike!"},{"id":"semetey-1-2013:p0483:b003:l014","ordinal":113934,"en":"Without fastening a bridle, riding bareback,"},{"id":"semetey-1-2013:p0483:b003:l015","ordinal":113935,"en":"The time has come to ride the fugitives."},{"id":"semetey-1-2013:p0483:b003:l016","ordinal":113936,"en":"Yraman's Yrchuul,"},{"id":"semetey-1-2013:p0483:b003:l017","ordinal":113937,"en":"His tasseled drawstring of forty joints,"},{"id":"semetey-1-2013:p0483:b003:l018","ordinal":113938,"en":"Sing here beside me."},{"id":"semetey-1-2013:p0483:b003:l019","ordinal":113939,"en":"My dark Tölög the diviner,"},{"id":"semetey-1-2013:p0483:b003:l020","ordinal":113940,"en":"Cast your divination; I shall see."},{"id":"semetey-1-2013:p0483:b003:l021","ordinal":113941,"en":"Spear in hand, breaking their ranks,"},{"id":"semetey-1-2013:p0483:b003:l022","ordinal":113942,"en":"Falling to bullets if death is due,"},{"id":"semetey-1-2013:p0483:b003:l023","ordinal":113943,"en":"I shall behold a marvelous slaughter!”"},{"id":"semetey-1-2013:p0483:b003:l024","ordinal":113944,"en":"Yraman's singer"},{"id":"semetey-1-2013:p0483:b003:l025","ordinal":113945,"en":"Began to sing his words;"},{"id":"semetey-1-2013:p0483:b003:l026","ordinal":113946,"en":"Dark Tölög the diviner"},{"id":"semetey-1-2013:p0483:b003:l027","ordinal":113947,"en":"Cast his divination:"},{"id":"semetey-1-2013:p0483:b003:l028","ordinal":113948,"en":"“The departed fugitives have camped;"},{"id":"semetey-1-2013:p0483:b003:l029","ordinal":113949,"en":"Your journey has prospered."},{"id":"semetey-1-2013:p0483:b003:l030","ordinal":113950,"en":"Like springs upon the hills,"},{"id":"semetey-1-2013:p0483:b003:l031","ordinal":113951,"en":"The time has come to join;"},{"id":"semetey-1-2013:p0483:b003:l032","ordinal":113952,"en":"Like flour of white wheat,"},{"id":"semetey-1-2013:p0483:b003:l033","ordinal":113953,"en":"The time has come to mingle as dough;"},{"id":"semetey-1-2013:p0483:b003:l034","ordinal":113954,"en":"Like hair of the white antelope,"},{"id":"semetey-1-2013:p0483:b003:l035","ordinal":113955,"en":"The time has come to be drawn out."},{"id":"semetey-1-2013:p0483:b003:l036","ordinal":113956,"en":"Like Venus in the sky,"},{"id":"semetey-1-2013:p0483:b003:l037","ordinal":113957,"en":"Perhaps the time has come to shine pale;"},{"id":"semetey-1-2013:p0483:b003:l038","ordinal":113958,"en":"The generous lord will rejoin us safely,"},{"id":"semetey-1-2013:p0483:b003:l039","ordinal":113959,"en":"Perhaps the time has come for friendship!”"},{"id":"semetey-1-2013:p0483:b005:l001","ordinal":113960,"en":"Casting his divination, speaking truly,"},{"id":"semetey-1-2013:p0483:b005:l002","ordinal":113961,"en":"“The fugitives below shall not escape;"},{"id":"semetey-1-2013:p0483:b005:l003","ordinal":113962,"en":"My lordly elder, Khan Manas, is coming,” he said."},{"id":"semetey-1-2013:p0483:b005:l005","ordinal":113963,"en":"Before he could close his mouth,"},{"id":"semetey-1-2013:p0483:b005:l006","ordinal":113964,"en":"A shout came from behind:"},{"id":"semetey-1-2013:p0483:b005:l007","ordinal":113965,"en":"Akayar and Kanykei"},{"id":"semetey-1-2013:p0483:b005:l008","ordinal":113966,"en":"Were coming from afar,"},{"id":"semetey-1-2013:p0483:b005:l009","ordinal":113967,"en":"Crying “Manas!” as their battle-cry."},{"id":"semetey-1-2013:p0483:b005:l010","ordinal":113968,"en":"My devastating sister-in-law Kanykei,"},{"id":"semetey-1-2013:p0483:b005:l011","ordinal":113969,"en":"Her great hair, thick as a girth,"},{"id":"semetey-1-2013:p0483:b005:l012","ordinal":113970,"en":"Had wound and tied upon her crown."},{"id":"semetey-1-2013:p0483:b005:l013","ordinal":113971,"en":"Khan Manas's old cap"},{"id":"semetey-1-2013:p0483:b005:l014","ordinal":113972,"en":"She had pulled down upon her head."},{"id":"semetey-1-2013:p0483:b005:l015","ordinal":113973,"en":"The black-cheeked battle-axe"},{"id":"semetey-1-2013:p0483:b005:l016","ordinal":113974,"en":"She had fastened snugly at her wrist."},{"id":"semetey-1-2013:p0483:b005:l017","ordinal":113975,"en":"Arkesken, the black steel sword,"},{"id":"semetey-1-2013:p0483:b005:l018","ordinal":113976,"en":"She had drawn from its sheath."},{"id":"semetey-1-2013:p0483:b005:l019","ordinal":113977,"en":"Her black, white-blazed thoroughbred's"},{"id":"semetey-1-2013:p0483:b005:l020","ordinal":113978,"en":"Belly-girth she had pulled tight,"},{"id":"semetey-1-2013:p0483:b005:l021","ordinal":113979,"en":"Its crupper she had lengthened,"},{"id":"semetey-1-2013:p0483:b005:l022","ordinal":113980,"en":"Lashing right and left,"},{"id":"semetey-1-2013:p0483:b005:l023","ordinal":113981,"en":"Spurring this way and that,"},{"id":"semetey-1-2013:p0483:b005:l024","ordinal":113982,"en":"Making a warrior of her woman's self,"},{"id":"semetey-1-2013:p0483:b005:l025","ordinal":113983,"en":"Making a banner of her towering head,"},{"id":"semetey-1-2013:p0483:b005:l026","ordinal":113984,"en":"Upon the fugitives' tracks"},{"id":"semetey-1-2013:p0483:b005:l027","ordinal":113985,"en":"She had pursued relentlessly,"},{"id":"semetey-1-2013:p0483:b005:l028","ordinal":113986,"en":"Chasing till she turned yellow."},{"id":"semetey-1-2013:p0483:b005:l029","ordinal":113987,"en":"Upon their bare tracks she pressed relentlessly,"},{"id":"semetey-1-2013:p0483:b005:l030","ordinal":113988,"en":"Chasing till she turned pale."},{"id":"semetey-1-2013:p0483:b005:l031","ordinal":113989,"en":"The youngest of six lions,"},{"id":"semetey-1-2013:p0483:b005:l032","ordinal":113990,"en":"Allah's beloved servant,"},{"id":"semetey-1-2013:p0483:b005:l033","ordinal":113991,"en":"She had mounted on Akkula,"},{"id":"semetey-1-2013:p0483:b005:l034","ordinal":113992,"en":"Clothed in the white padded armor."},{"id":"semetey-1-2013:p0483:b005:l035","ordinal":113993,"en":"The great gun Ak-Kelte,"},{"id":"semetey-1-2013:p0483:b005:l036","ordinal":113994,"en":"When the noble one slung it on,"},{"id":"semetey-1-2013:p0483:b005:l037","ordinal":113995,"en":"Was the mirror of his shoulder;"},{"id":"semetey-1-2013:p0483:b005:l038","ordinal":113996,"en":"When turned on an enemy in combat,"},{"id":"semetey-1-2013:p0483:b005:l039","ordinal":113997,"en":"It was the solace of his borrowed life."},{"id":"semetey-1-2013:p0484:b003:l001","ordinal":113998,"en":"Its loud report was its mark,"},{"id":"semetey-1-2013:p0484:b003:l002","ordinal":113999,"en":"If an enemy came out shooting,"},{"id":"semetey-1-2013:p0484:b003:l003","ordinal":114000,"en":"It was the companion of his borrowed life."},{"id":"semetey-1-2013:p0484:b003:l004","ordinal":114001,"en":"Fired in play, an ochogor gun;"},{"id":"semetey-1-2013:p0484:b003:l005","ordinal":114002,"en":"In earnest, Chorkelte;"},{"id":"semetey-1-2013:p0484:b003:l006","ordinal":114003,"en":"On inspection, Koychagyr;"},{"id":"semetey-1-2013:p0484:b003:l007","ordinal":114004,"en":"Of surpassing steel, Almabash."},{"id":"semetey-1-2013:p0484:b003:l008","ordinal":114005,"en":"Unfailing for sixty days,"},{"id":"semetey-1-2013:p0484:b003:l009","ordinal":114006,"en":"Making no distinction between far and near,"},{"id":"semetey-1-2013:p0484:b003:l010","ordinal":114007,"en":"The living gun Ak-Kelte"},{"id":"semetey-1-2013:p0484:b003:l011","ordinal":114008,"en":"Hung about Khan Manas's neck."},{"id":"semetey-1-2013:p0484:b003:l012","ordinal":114009,"en":"Flashing as though moonlight struck it,"},{"id":"semetey-1-2013:p0484:b003:l013","ordinal":114010,"en":"Of the six blades fallen from heaven,"},{"id":"semetey-1-2013:p0484:b003:l014","ordinal":114011,"en":"The finest among swords,"},{"id":"semetey-1-2013:p0484:b003:l015","ordinal":114012,"en":"Zulpukor, which Manas had received,"},{"id":"semetey-1-2013:p0484:b003:l016","ordinal":114013,"en":"Gleamed at his wrist."},{"id":"semetey-1-2013:p0484:b003:l017","ordinal":114014,"en":"The painted spear Bölökbai had made"},{"id":"semetey-1-2013:p0484:b003:l018","ordinal":114015,"en":"Shimmered beneath his knee."},{"id":"semetey-1-2013:p0484:b003:l019","ordinal":114016,"en":"The banner seemed a mountain;"},{"id":"semetey-1-2013:p0484:b003:l020","ordinal":114017,"en":"The noble lion, proud as a cock,"},{"id":"semetey-1-2013:p0484:b003:l021","ordinal":114018,"en":"Seemed like Mount Opol."},{"id":"semetey-1-2013:p0484:b003:l022","ordinal":114019,"en":"When Almambet, Chubak and Bakai"},{"id":"semetey-1-2013:p0484:b003:l023","ordinal":114020,"en":"Saw their generous lord before them,"},{"id":"semetey-1-2013:p0484:b003:l024","ordinal":114021,"en":"As though they might never see him again,"},{"id":"semetey-1-2013:p0484:b003:l025","ordinal":114022,"en":"Those heroes who had been grieving"},{"id":"semetey-1-2013:p0484:b003:l026","ordinal":114023,"en":"Poured tears from their eyes."},{"id":"semetey-1-2013:p0484:b003:l027","ordinal":114024,"en":"Their king, Manas the lion,"},{"id":"semetey-1-2013:p0484:b003:l028","ordinal":114025,"en":"Before the mighty men's eyes"},{"id":"semetey-1-2013:p0484:b003:l029","ordinal":114026,"en":"Appeared alive, not dead."},{"id":"semetey-1-2013:p0484:b003:l030","ordinal":114027,"en":"His forty companions cried out,"},{"id":"semetey-1-2013:p0484:b003:l031","ordinal":114028,"en":"As though seeing their father,"},{"id":"semetey-1-2013:p0484:b003:l032","ordinal":114029,"en":"To the One God their wishes"},{"id":"semetey-1-2013:p0484:b003:l033","ordinal":114030,"en":"They offered, sobbing."},{"id":"semetey-1-2013:p0484:b003:l034","ordinal":114031,"en":"Almambet and Bakai, the lions,"},{"id":"semetey-1-2013:p0484:b003:l035","ordinal":114032,"en":"Cried “Baabedin!” and offered prayers,"},{"id":"semetey-1-2013:p0484:b003:l036","ordinal":114033,"en":"Vowed sheep to Koroshon,"},{"id":"semetey-1-2013:p0484:b003:l037","ordinal":114034,"en":"To Allah the Exalted, the One,"},{"id":"semetey-1-2013:p0484:b003:l038","ordinal":114035,"en":"Vowed crescent-hoofed horses,"},{"id":"semetey-1-2013:p0484:b003:l039","ordinal":114036,"en":"Quickly uttering every wish."},{"id":"semetey-1-2013:p0484:b004:l001","ordinal":114037,"en":"“My wolf-lord has come!” they said,"},{"id":"semetey-1-2013:p0484:b004:l002","ordinal":114038,"en":"“God has granted our wish!” they said."},{"id":"semetey-1-2013:p0484:b004:l003","ordinal":114039,"en":"Severed steel was joined again."},{"id":"semetey-1-2013:p0484:b004:l004","ordinal":114040,"en":"When they saw the panther,"},{"id":"semetey-1-2013:p0484:b004:l005","ordinal":114041,"en":"Khan Manas's forty noble companions"},{"id":"semetey-1-2013:p0484:b004:l006","ordinal":114042,"en":"All rejoiced together."},{"id":"semetey-1-2013:p0484:b004:l007","ordinal":114043,"en":"Stars streamed down from the sky;"},{"id":"semetey-1-2013:p0484:b004:l008","ordinal":114044,"en":"With the wolf-man lion, the forty companions"},{"id":"semetey-1-2013:p0484:b004:l009","ordinal":114045,"en":"Were reunited safe and sound."},{"id":"semetey-1-2013:p0484:b004:l010","ordinal":114046,"en":"Bakai the panther, the wolf-man hero,"},{"id":"semetey-1-2013:p0484:b004:l011","ordinal":114047,"en":"Pursued the fugitives' tracks,"},{"id":"semetey-1-2013:p0484:b004:l012","ordinal":114048,"en":"Skirted along the bank,"},{"id":"semetey-1-2013:p0484:b004:l013","ordinal":114049,"en":"Roamed through Jerge-Talaa,"},{"id":"semetey-1-2013:p0484:b004:l014","ordinal":114050,"en":"Crossed Moinokcho,"},{"id":"semetey-1-2013:p0484:b004:l015","ordinal":114051,"en":"Traversed Üch-Aral,"},{"id":"semetey-1-2013:p0484:b004:l016","ordinal":114052,"en":"Üch-Aral at the head of the Ili."},{"id":"semetey-1-2013:p0484:b004:l017","ordinal":114053,"en":"Ögüz-Ashuu and Tai-Ashuu—"},{"id":"semetey-1-2013:p0484:b004:l018","ordinal":114054,"en":"He crossed both in succession."},{"id":"semetey-1-2013:p0484:b004:l019","ordinal":114055,"en":"The two plains, Künes and Jyldyz,"},{"id":"semetey-1-2013:p0484:b004:l020","ordinal":114056,"en":"He traversed both, leaving neither out."},{"id":"semetey-1-2013:p0484:b004:l021","ordinal":114057,"en":"Közkaman had gone and halted"},{"id":"semetey-1-2013:p0484:b004:l022","ordinal":114058,"en":"At the foot of Mount Ambal,"},{"id":"semetey-1-2013:p0484:b004:l023","ordinal":114059,"en":"Rejoicing, “We have escaped!"},{"id":"semetey-1-2013:p0484:b004:l024","ordinal":114060,"en":"We have rid ourselves of every grief!"},{"id":"semetey-1-2013:p0484:b004:l025","ordinal":114061,"en":"That dark wolf-lord whom we sought out,"},{"id":"semetey-1-2013:p0484:b004:l026","ordinal":114062,"en":"By tricking him and serving a meal,"},{"id":"semetey-1-2013:p0484:b004:l027","ordinal":114063,"en":"We have thoroughly slaughtered!”"},{"id":"semetey-1-2013:p0484:b004:l028","ordinal":114064,"en":"To send news to Beijing,"},{"id":"semetey-1-2013:p0484:b004:l029","ordinal":114065,"en":"To the Khakan's khan,"},{"id":"semetey-1-2013:p0484:b004:l030","ordinal":114066,"en":"Before Karykan,"},{"id":"semetey-1-2013:p0484:b004:l031","ordinal":114067,"en":"To go with glad tidings,"},{"id":"semetey-1-2013:p0484:b004:l032","ordinal":114068,"en":"Of the numerous Chinese people of forty tribes"},{"id":"semetey-1-2013:p0484:b004:l033","ordinal":114069,"en":"To receive a khanate—"},{"id":"semetey-1-2013:p0484:b004:l034","ordinal":114070,"en":"The fleeing Kalmyks rejoiced"},{"id":"semetey-1-2013:p0484:b004:l035","ordinal":114071,"en":"And lay at their ease."},{"id":"semetey-1-2013:p0484:b004:l036","ordinal":114072,"en":"To a ridge like a saddle's waist,"},{"id":"semetey-1-2013:p0484:b004:l037","ordinal":114073,"en":"Bakai the panther, tracking them,"},{"id":"semetey-1-2013:p0484:b004:l038","ordinal":114074,"en":"Bent low and went in to look."},{"id":"semetey-1-2013:p0484:b004:l039","ordinal":114075,"en":"Gray-mottled haze, red banners,"},{"id":"semetey-1-2013:p0485:b003:l001","ordinal":114076,"en":"The Chinese people's keen sovereign,"},{"id":"semetey-1-2013:p0485:b003:l002","ordinal":114077,"en":"Such, it seemed, was the Chinese clamor."},{"id":"semetey-1-2013:p0485:b003:l003","ordinal":114078,"en":"They had beaten their drums,"},{"id":"semetey-1-2013:p0485:b003:l004","ordinal":114079,"en":"Calling it “the game of slaughtering Manas.”"},{"id":"semetey-1-2013:p0485:b003:l005","ordinal":114080,"en":"Their Kalmyks swayed"},{"id":"semetey-1-2013:p0485:b003:l006","ordinal":114081,"en":"And danced with all their might."},{"id":"semetey-1-2013:p0485:b003:l007","ordinal":114082,"en":"Khan Bakai's entry"},{"id":"semetey-1-2013:p0485:b003:l008","ordinal":114083,"en":"Jeldeiboz, standing watch,"},{"id":"semetey-1-2013:p0485:b003:l009","ordinal":114084,"en":"Had clearly seen."},{"id":"semetey-1-2013:p0485:b003:l010","ordinal":114085,"en":"The steed beneath him"},{"id":"semetey-1-2013:p0485:b003:l011","ordinal":114086,"en":"He lashed, shouting,"},{"id":"semetey-1-2013:p0485:b003:l012","ordinal":114087,"en":"To Közkaman and Kökchököz"},{"id":"semetey-1-2013:p0485:b003:l013","ordinal":114088,"en":"Crying out his battle-cry."},{"id":"semetey-1-2013:p0485:b003:l014","ordinal":114089,"en":"“Kökchököz and Közkaman!"},{"id":"semetey-1-2013:p0485:b003:l015","ordinal":114090,"en":"The striking idol has struck us!"},{"id":"semetey-1-2013:p0485:b003:l016","ordinal":114091,"en":"Reckless Manas and forty mighty men"},{"id":"semetey-1-2013:p0485:b003:l017","ordinal":114092,"en":"Are pursuing at your heels."},{"id":"semetey-1-2013:p0485:b003:l018","ordinal":114093,"en":"Almambet has gone on patrol;"},{"id":"semetey-1-2013:p0485:b003:l019","ordinal":114094,"en":"Bakai, hero of the saints—"},{"id":"semetey-1-2013:p0485:b003:l020","ordinal":114095,"en":"Think of it: a dreadful, grievous affair!—"},{"id":"semetey-1-2013:p0485:b003:l021","ordinal":114096,"en":"Has pressed relentlessly upon your tracks,"},{"id":"semetey-1-2013:p0485:b003:l022","ordinal":114097,"en":"Chasing till he turns yellow."},{"id":"semetey-1-2013:p0485:b003:l023","ordinal":114098,"en":"To pursue you to the Khakan"},{"id":"semetey-1-2013:p0485:b003:l024","ordinal":114099,"en":"And wreak havoc,"},{"id":"semetey-1-2013:p0485:b003:l025","ordinal":114100,"en":"All forty mighty men"},{"id":"semetey-1-2013:p0485:b003:l026","ordinal":114101,"en":"Have pledged their word."},{"id":"semetey-1-2013:p0485:b003:l027","ordinal":114102,"en":"Their Manas was a consummate khan;"},{"id":"semetey-1-2013:p0485:b003:l028","ordinal":114103,"en":"The least of his companions"},{"id":"semetey-1-2013:p0485:b003:l029","ordinal":114104,"en":"Was worth a thousand men."},{"id":"semetey-1-2013:p0485:b003:l030","ordinal":114105,"en":"The pit dug for us has come,"},{"id":"semetey-1-2013:p0485:b003:l031","ordinal":114106,"en":"Disaster for our precious lives has come."},{"id":"semetey-1-2013:p0485:b003:l032","ordinal":114107,"en":"However much I spoke, you would not listen;"},{"id":"semetey-1-2013:p0485:b003:l033","ordinal":114108,"en":"My khans, has God struck you?"},{"id":"semetey-1-2013:p0485:b003:l034","ordinal":114109,"en":"Pursuing as far as the Khakan—"},{"id":"semetey-1-2013:p0485:b003:l035","ordinal":114110,"en":"Has God struck the Buruts?"},{"id":"semetey-1-2013:p0485:b003:l036","ordinal":114111,"en":"Traveling day and night,"},{"id":"semetey-1-2013:p0485:b003:l037","ordinal":114112,"en":"You refuse when I say, ‘Let us flee.’"},{"id":"semetey-1-2013:p0485:b003:l038","ordinal":114113,"en":"The time to be lashed has come."},{"id":"semetey-1-2013:p0485:b003:l039","ordinal":114114,"en":"Ah, Közkaman, you will come to no good!"},{"id":"semetey-1-2013:p0485:b004:l001","ordinal":114115,"en":"Every companion came running;"},{"id":"semetey-1-2013:p0485:b004:l002","ordinal":114116,"en":"Khan Manas, whom they called dead,"},{"id":"semetey-1-2013:p0485:b004:l003","ordinal":114117,"en":"Has risen today, as you can see."},{"id":"semetey-1-2013:p0485:b004:l004","ordinal":114118,"en":"You indulge in other deeds:"},{"id":"semetey-1-2013:p0485:b004:l005","ordinal":114119,"en":"You take Kyrgyz girls as booty"},{"id":"semetey-1-2013:p0485:b004:l006","ordinal":114120,"en":"And make them your wives."},{"id":"semetey-1-2013:p0485:b004:l007","ordinal":114121,"en":"‘The destroyer Manas is dead,’ you say."},{"id":"semetey-1-2013:p0485:b004:l008","ordinal":114122,"en":"You keep calling me 'sister-in-law.'"},{"id":"semetey-1-2013:p0485:b004:l009","ordinal":114123,"en":"I have seen Manas's mighty men."},{"id":"semetey-1-2013:p0485:b004:l010","ordinal":114124,"en":"Damned Közkaman,"},{"id":"semetey-1-2013:p0485:b004:l011","ordinal":114125,"en":"How will you find a way out?"},{"id":"semetey-1-2013:p0485:b004:l012","ordinal":114126,"en":"Great Beijing, the distant city—"},{"id":"semetey-1-2013:p0485:b004:l013","ordinal":114127,"en":"Before you reach that place, Közkaman,"},{"id":"semetey-1-2013:p0485:b004:l014","ordinal":114128,"en":"It seems you will be dead."},{"id":"semetey-1-2013:p0485:b004:l015","ordinal":114129,"en":"When bored, you shoot roe deer;"},{"id":"semetey-1-2013:p0485:b004:l016","ordinal":114130,"en":"When not bored, you wretch,"},{"id":"semetey-1-2013:p0485:b004:l017","ordinal":114131,"en":"You lie playing with girls."},{"id":"semetey-1-2013:p0485:b004:l018","ordinal":114132,"en":"Manas the lion, blessed by Khidr, has come;"},{"id":"semetey-1-2013:p0485:b004:l019","ordinal":114133,"en":"Today you will suffer pressure."},{"id":"semetey-1-2013:p0485:b004:l020","ordinal":114134,"en":"When I say, ‘Send word to the watch,’"},{"id":"semetey-1-2013:p0485:b004:l021","ordinal":114135,"en":"When I say, ‘Send word to the Khakan,’"},{"id":"semetey-1-2013:p0485:b004:l022","ordinal":114136,"en":"‘Those who let no opponent go,"},{"id":"semetey-1-2013:p0485:b004:l023","ordinal":114137,"en":"Recruit some of those warriors,’ I say—"},{"id":"semetey-1-2013:p0485:b004:l024","ordinal":114138,"en":"You will not comply, my scoundrel."},{"id":"semetey-1-2013:p0485:b004:l025","ordinal":114139,"en":"You have had us all slaughtered."},{"id":"semetey-1-2013:p0485:b004:l026","ordinal":114140,"en":"Ah, Kökchököz, you will come to no good!"},{"id":"semetey-1-2013:p0485:b004:l027","ordinal":114141,"en":"The deep-dug pit has come;"},{"id":"semetey-1-2013:p0485:b004:l028","ordinal":114142,"en":"Equal to his Manas,"},{"id":"semetey-1-2013:p0485:b004:l029","ordinal":114143,"en":"Look, mighty Bakai has come."},{"id":"semetey-1-2013:p0485:b004:l030","ordinal":114144,"en":"When bored, you shoot wild asses."},{"id":"semetey-1-2013:p0485:b004:l031","ordinal":114145,"en":"You fool come from Beijing,"},{"id":"semetey-1-2013:p0485:b004:l032","ordinal":114146,"en":"Never considering that they have champions,"},{"id":"semetey-1-2013:p0485:b004:l033","ordinal":114147,"en":"You lie playing all the harder!"},{"id":"semetey-1-2013:p0485:b004:l034","ordinal":114148,"en":"Ah, Kökchököz and Közkaman,"},{"id":"semetey-1-2013:p0485:b004:l035","ordinal":114149,"en":"Take your game instead of a captive girl;"},{"id":"semetey-1-2013:p0485:b004:l036","ordinal":114150,"en":"Take your mother instead of a clever girl!"},{"id":"semetey-1-2013:p0485:b004:l037","ordinal":114151,"en":"But instead of taking a wife, good heavens,"},{"id":"semetey-1-2013:p0485:b004:l038","ordinal":114152,"en":"Have you seen what I have seen,"},{"id":"semetey-1-2013:p0485:b004:l039","ordinal":114153,"en":"You great dog lying there in a frenzy?"},{"id":"semetey-1-2013:p0486:b003:l001","ordinal":114154,"en":"Have you learned what I know?"},{"id":"semetey-1-2013:p0486:b003:l002","ordinal":114155,"en":"From the jutting mountain spur,"},{"id":"semetey-1-2013:p0486:b003:l003","ordinal":114156,"en":"From the overhanging promontory,"},{"id":"semetey-1-2013:p0486:b003:l004","ordinal":114157,"en":"From a cleft like a forked saddle,"},{"id":"semetey-1-2013:p0486:b003:l005","ordinal":114158,"en":"Dust billows and billows out."},{"id":"semetey-1-2013:p0486:b003:l006","ordinal":114159,"en":"I watched the billowing dust:"},{"id":"semetey-1-2013:p0486:b003:l007","ordinal":114160,"en":"It was the dust of the gray winged steed."},{"id":"semetey-1-2013:p0486:b003:l008","ordinal":114161,"en":"The rider mounted upon it"},{"id":"semetey-1-2013:p0486:b003:l009","ordinal":114162,"en":"Was a man like Bakai."},{"id":"semetey-1-2013:p0486:b003:l010","ordinal":114163,"en":"A wrathful bellow—"},{"id":"semetey-1-2013:p0486:b003:l011","ordinal":114164,"en":"When I lent an ear a little,"},{"id":"semetey-1-2013:p0486:b003:l012","ordinal":114165,"en":"He was shouting the battle cry, ‘Manas!’"},{"id":"semetey-1-2013:p0486:b003:l013","ordinal":114166,"en":"When I looked behind him—"},{"id":"semetey-1-2013:p0486:b003:l014","ordinal":114167,"en":"As huge as half a mountain,"},{"id":"semetey-1-2013:p0486:b003:l015","ordinal":114168,"en":"As though he would devour whoever he met."},{"id":"semetey-1-2013:p0486:b003:l016","ordinal":114169,"en":"Yesterday, he treated his golden throne as worthless;"},{"id":"semetey-1-2013:p0486:b003:l017","ordinal":114170,"en":"Saying, ‘He will not enter Islam,’"},{"id":"semetey-1-2013:p0486:b003:l018","ordinal":114171,"en":"He slew his own father."},{"id":"semetey-1-2013:p0486:b003:l019","ordinal":114172,"en":"They held back only from dying,"},{"id":"semetey-1-2013:p0486:b003:l020","ordinal":114173,"en":"Until the supple reeds ripened,"},{"id":"semetey-1-2013:p0486:b003:l021","ordinal":114174,"en":"Until the autumn gossamer flew,"},{"id":"semetey-1-2013:p0486:b003:l022","ordinal":114175,"en":"Fighting hard for six months,"},{"id":"semetey-1-2013:p0486:b003:l023","ordinal":114176,"en":"He brought devastation to Beijing."}]
