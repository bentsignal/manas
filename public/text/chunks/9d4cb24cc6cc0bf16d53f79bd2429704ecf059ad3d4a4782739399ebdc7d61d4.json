[{"id":"manas-2010:p1055:b001:l033","ordinal":46081,"en":"Would I not have taken and shattered"},{"id":"manas-2010:p1055:b001:l034","ordinal":46082,"en":"That city of Beijing?"},{"id":"manas-2010:p1055:b001:l035","ordinal":46083,"en":"Would I not have brought upon it"},{"id":"manas-2010:p1055:b001:l036","ordinal":46084,"en":"The calamity of the end of the world?"},{"id":"manas-2010:p1055:b001:l037","ordinal":46085,"en":"If you had told me the truth,"},{"id":"manas-2010:p1055:b001:l038","ordinal":46086,"en":"Would I not have made them taste their salt?"},{"id":"manas-2010:p1055:b001:l039","ordinal":46087,"en":"Would I not have let the Kyrgyz seize"},{"id":"manas-2010:p1055:b001:l040","ordinal":46088,"en":"Their pure and beautiful girls?"},{"id":"manas-2010:p1055:b001:l041","ordinal":46089,"en":"Would I not have broken their fortresses,"},{"id":"manas-2010:p1055:b001:l042","ordinal":46090,"en":"Going five times by now,"},{"id":"manas-2010:p1056:b001:l001","ordinal":46091,"en":"Would I not have made their lords crawl?"},{"id":"manas-2010:p1056:b001:l002","ordinal":46092,"en":"Would I not have slaughtered the Chinese"},{"id":"manas-2010:p1056:b001:l003","ordinal":46093,"en":"Chiefs who thought themselves so mighty?"},{"id":"manas-2010:p1056:b001:l004","ordinal":46094,"en":"Would I not have burned their tents,"},{"id":"manas-2010:p1056:b001:l005","ordinal":46095,"en":"Would I not have killed their heroes?"},{"id":"manas-2010:p1056:b001:l006","ordinal":46096,"en":"Enough, Almambet—may you never prosper!"},{"id":"manas-2010:p1056:b001:l007","ordinal":46097,"en":"May you never become two!"},{"id":"manas-2010:p1056:b001:l008","ordinal":46098,"en":"The reason I say this—"},{"id":"manas-2010:p1056:b001:l009","ordinal":46099,"en":"Let me return to former times:"},{"id":"manas-2010:p1056:b001:l010","ordinal":46100,"en":"Saying, “I shall plunder their gold,"},{"id":"manas-2010:p1056:b001:l011","ordinal":46101,"en":"And maiden Saykal, Karacha Khan's daughter,"},{"id":"manas-2010:p1056:b001:l012","ordinal":46102,"en":"I shall take as spoil,”"},{"id":"manas-2010:p1056:b001:l013","ordinal":46103,"en":"When I gathered Akkula's reins,"},{"id":"manas-2010:p1056:b001:l014","ordinal":46104,"en":"The elder Khan Bakay was there,"},{"id":"manas-2010:p1056:b001:l015","ordinal":46105,"en":"All forty warriors were there."},{"id":"manas-2010:p1056:b001:l016","ordinal":46106,"en":"When we crossed Bikirtik,"},{"id":"manas-2010:p1056:b001:l017","ordinal":46107,"en":"When we traversed broad Kakshaal,"},{"id":"manas-2010:p1056:b001:l018","ordinal":46108,"en":"From beside the flowing river"},{"id":"manas-2010:p1056:b001:l019","ordinal":46109,"en":"Khan Saykal came to fight,"},{"id":"manas-2010:p1056:b001:l020","ordinal":46110,"en":"From the hollow of Uluu-Too."},{"id":"manas-2010:p1056:b001:l021","ordinal":46111,"en":"When Chubak went out scouting,"},{"id":"manas-2010:p1056:b001:l022","ordinal":46112,"en":"When Saykal brought devastation,"},{"id":"manas-2010:p1056:b001:l023","ordinal":46113,"en":"Chubak was not the only hero,"},{"id":"manas-2010:p1056:b001:l024","ordinal":46114,"en":"I was not one to stand and watch:"},{"id":"manas-2010:p1056:b001:l025","ordinal":46115,"en":"The forty wolves charged in."},{"id":"manas-2010:p1056:b001:l026","ordinal":46116,"en":"Even then, unafraid,"},{"id":"manas-2010:p1056:b001:l027","ordinal":46117,"en":"Untroubled and unworried,"},{"id":"manas-2010:p1056:b001:l028","ordinal":46118,"en":"Maiden Saykal stood watching."},{"id":"manas-2010:p1056:b001:l029","ordinal":46119,"en":"When she raised havoc against Chubak,"},{"id":"manas-2010:p1056:b001:l030","ordinal":46120,"en":"When dear champion Khan Bakay"},{"id":"manas-2010:p1056:b001:l031","ordinal":46121,"en":"Had come down from his horse,"},{"id":"manas-2010:p1056:b001:l032","ordinal":46122,"en":"When the warriors' very deaths"},{"id":"manas-2010:p1056:b001:l033","ordinal":46123,"en":"Were about to overtake them,"},{"id":"manas-2010:p1056:b001:l034","ordinal":46124,"en":"Driving the forty warriors' forty steeds"},{"id":"manas-2010:p1056:b001:l035","ordinal":46125,"en":"Ahead of her,"},{"id":"manas-2010:p1056:b001:l036","ordinal":46126,"en":"When maiden Saykal, foremost among humankind,"},{"id":"manas-2010:p1056:b001:l037","ordinal":46127,"en":"Was about to depart,"},{"id":"manas-2010:p1056:b001:l038","ordinal":46128,"en":"You turned a summer day to winter,"},{"id":"manas-2010:p1056:b001:l039","ordinal":46129,"en":"And Saykal, most beautiful of maidens,"},{"id":"manas-2010:p1056:b001:l040","ordinal":46130,"en":"You chilled upon a summer day,"},{"id":"manas-2010:p1056:b001:l041","ordinal":46131,"en":"Turning her garments to ice."},{"id":"manas-2010:p1056:b001:l042","ordinal":46132,"en":"Then you rescued Chubak,"},{"id":"manas-2010:p1057:b001:l001","ordinal":46133,"en":"You stooped and brought him slung behind you—"},{"id":"manas-2010:p1057:b001:l002","ordinal":46134,"en":"Syrgak, who had been left on foot."},{"id":"manas-2010:p1057:b001:l003","ordinal":46135,"en":"On that journey, for the forty warriors,"},{"id":"manas-2010:p1057:b001:l004","ordinal":46136,"en":"You joined what had been broken,"},{"id":"manas-2010:p1057:b001:l005","ordinal":46137,"en":"You gathered what had scattered."},{"id":"manas-2010:p1057:b001:l006","ordinal":46138,"en":"You kindled their unburning fire,"},{"id":"manas-2010:p1057:b001:l007","ordinal":46139,"en":"You revived their dead souls."},{"id":"manas-2010:p1057:b001:l008","ordinal":46140,"en":"Then Karacha's Saykal"},{"id":"manas-2010:p1057:b001:l009","ordinal":46141,"en":"Came rushing out before me."},{"id":"manas-2010:p1057:b001:l010","ordinal":46142,"en":"The forty lion-wolf warriors,"},{"id":"manas-2010:p1057:b001:l011","ordinal":46143,"en":"Old Kyrgyl, leader of the forty,"},{"id":"manas-2010:p1057:b001:l012","ordinal":46144,"en":"Shuutu, whose hat was like a yurt's felt roof—"},{"id":"manas-2010:p1057:b001:l013","ordinal":46145,"en":"She speared three in a row, bringing them down;"},{"id":"manas-2010:p1057:b001:l014","ordinal":46146,"en":"All the warriors who offered resistance"},{"id":"manas-2010:p1057:b001:l015","ordinal":46147,"en":"She speared and shattered."},{"id":"manas-2010:p1057:b001:l016","ordinal":46148,"en":"Then a red spear of keen steel"},{"id":"manas-2010:p1057:b001:l017","ordinal":46149,"en":"You fitted for me, Almambet."},{"id":"manas-2010:p1057:b001:l018","ordinal":46150,"en":"In sixty days of exchanging fire,"},{"id":"manas-2010:p1057:b001:l019","ordinal":46151,"en":"You alone joined me"},{"id":"manas-2010:p1057:b001:l020","ordinal":46152,"en":"And held out, Almambet."},{"id":"manas-2010:p1057:b001:l021","ordinal":46153,"en":"As we went through those days,"},{"id":"manas-2010:p1057:b001:l022","ordinal":46154,"en":"“Against his skin, something no bullet can pierce—"},{"id":"manas-2010:p1057:b001:l023","ordinal":46155,"en":"He must wear it,” I thought."},{"id":"manas-2010:p1057:b001:l024","ordinal":46156,"en":"“This Great Beijing standing here—"},{"id":"manas-2010:p1057:b001:l025","ordinal":46157,"en":"He must know it,” I thought."},{"id":"manas-2010:p1057:b001:l026","ordinal":46158,"en":"When I saw this valor of yours,"},{"id":"manas-2010:p1057:b001:l027","ordinal":46159,"en":"I struck up a conversation,"},{"id":"manas-2010:p1057:b001:l028","ordinal":46160,"en":"“Did you know Beijing?”"},{"id":"manas-2010:p1057:b001:l029","ordinal":46161,"en":"I asked you here."},{"id":"manas-2010:p1057:b001:l030","ordinal":46162,"en":"“Bulletproof armor against my skin—"},{"id":"manas-2010:p1057:b001:l031","ordinal":46163,"en":"May I never prosper if I wore it."},{"id":"manas-2010:p1057:b001:l032","ordinal":46164,"en":"The Chinese people's Great Beijing—"},{"id":"manas-2010:p1057:b001:l033","ordinal":46165,"en":"May I never prosper if I knew it,”"},{"id":"manas-2010:p1057:b001:l034","ordinal":46166,"en":"You cried, lamenting so much."},{"id":"manas-2010:p1057:b001:l035","ordinal":46167,"en":"Enough, Almambet, my hero!"},{"id":"manas-2010:p1057:b001:l036","ordinal":46168,"en":"You meant to rob me of my means,"},{"id":"manas-2010:p1057:b001:l037","ordinal":46169,"en":"Gathering them halfway along,"},{"id":"manas-2010:p1057:b001:l038","ordinal":46170,"en":"You meant to slaughter my people."},{"id":"manas-2010:p1057:b001:l039","ordinal":46171,"en":"You meant to break me, Almambet,"},{"id":"manas-2010:p1057:b001:l040","ordinal":46172,"en":"Making my back ache now."},{"id":"manas-2010:p1057:b001:l041","ordinal":46173,"en":"By withholding Beijing's story,"},{"id":"manas-2010:p1057:b001:l042","ordinal":46174,"en":"You meant to chill my body."},{"id":"manas-2010:p1058:b001:l001","ordinal":46175,"en":"It seems you have been sparing"},{"id":"manas-2010:p1058:b001:l002","ordinal":46176,"en":"Your forty tribes of Chinese people."},{"id":"manas-2010:p1058:b001:l003","ordinal":46177,"en":"Here, as for Beijing,"},{"id":"manas-2010:p1058:b001:l004","ordinal":46178,"en":"It became clear that you were sparing it."},{"id":"manas-2010:p1058:b001:l005","ordinal":46179,"en":"When I learned that you were sparing them,"},{"id":"manas-2010:p1058:b001:l006","ordinal":46180,"en":"Lion, gray-maned Almambet,"},{"id":"manas-2010:p1058:b001:l007","ordinal":46181,"en":"My heart was deeply troubled."},{"id":"manas-2010:p1058:b001:l008","ordinal":46182,"en":"Hero, had you told of Beijing from the start,"},{"id":"manas-2010:p1058:b001:l009","ordinal":46183,"en":"Would I not have thrust, with a shout,"},{"id":"manas-2010:p1058:b001:l010","ordinal":46184,"en":"My spear at Inner Beijing?"},{"id":"manas-2010:p1058:b001:l011","ordinal":46185,"en":"Would I not have made Chinese blood flow"},{"id":"manas-2010:p1058:b001:l012","ordinal":46186,"en":"Across so many, many plains?"},{"id":"manas-2010:p1058:b001:l013","ordinal":46187,"en":"Would I not have slaughtered the Chinese"},{"id":"manas-2010:p1058:b001:l014","ordinal":46188,"en":"Lords with their red tufts?"},{"id":"manas-2010:p1058:b001:l015","ordinal":46189,"en":"Would I not have destroyed the Chinese"},{"id":"manas-2010:p1058:b001:l016","ordinal":46190,"en":"Cities they had fortified?"},{"id":"manas-2010:p1058:b001:l017","ordinal":46191,"en":"Seeking words, drawing them out,"},{"id":"manas-2010:p1058:b001:l018","ordinal":46192,"en":"Your manner of speaking became clear;"},{"id":"manas-2010:p1058:b001:l019","ordinal":46193,"en":"The countless Chinese and Inner Beijing—"},{"id":"manas-2010:p1058:b001:l020","ordinal":46194,"en":"It became clear that you were sparing them."},{"id":"manas-2010:p1058:b001:l021","ordinal":46195,"en":"So many curious tricks"},{"id":"manas-2010:p1058:b001:l022","ordinal":46196,"en":"It seems you had not found."},{"id":"manas-2010:p1058:b001:l023","ordinal":46197,"en":"Saying, “The countless Chinese are my people,”"},{"id":"manas-2010:p1058:b001:l024","ordinal":46198,"en":"It seems you had kept silent."},{"id":"manas-2010:p1058:b001:l025","ordinal":46199,"en":"“Why should I tell Manas"},{"id":"manas-2010:p1058:b001:l026","ordinal":46200,"en":"My secret?” you must have thought."},{"id":"manas-2010:p1058:b001:l027","ordinal":46201,"en":"“Somehow I shall go to Beijing,"},{"id":"manas-2010:p1058:b001:l028","ordinal":46202,"en":"And, making my people my protection,"},{"id":"manas-2010:p1058:b001:l029","ordinal":46203,"en":"Depart,” you must have thought."},{"id":"manas-2010:p1058:b001:l030","ordinal":46204,"en":"After Khan Manas said this"},{"id":"manas-2010:p1058:b001:l031","ordinal":46205,"en":"And stood expressing his resentment,"},{"id":"manas-2010:p1058:b001:l032","ordinal":46206,"en":"Almambet then spoke:"},{"id":"manas-2010:p1058:b001:l033","ordinal":46207,"en":"“Khan Manas,"},{"id":"manas-2010:p1058:b001:l034","ordinal":46208,"en":"Here is that land of Beijing."},{"id":"manas-2010:p1058:b001:l035","ordinal":46209,"en":"You have been offended all this while—"},{"id":"manas-2010:p1058:b001:l036","ordinal":46210,"en":"Cut off my head; here I am!"},{"id":"manas-2010:p1058:b001:l037","ordinal":46211,"en":"How could I not know Beijing,"},{"id":"manas-2010:p1058:b001:l038","ordinal":46212,"en":"How could I not have seen Beijing?"},{"id":"manas-2010:p1058:b001:l039","ordinal":46213,"en":"A curse upon being a subject!"},{"id":"manas-2010:p1058:b001:l040","ordinal":46214,"en":"You meant to lodge your guest overnight,"},{"id":"manas-2010:p1058:b001:l041","ordinal":46215,"en":"Brooding halfway along,"},{"id":"manas-2010:p1058:b001:l042","ordinal":46216,"en":"You meant to make me tell a tale."},{"id":"manas-2010:p1059:b001:l001","ordinal":46217,"en":"Taking offense, you brought me hell;"},{"id":"manas-2010:p1059:b001:l002","ordinal":46218,"en":"Scowling upon Tal-Choku,"},{"id":"manas-2010:p1059:b001:l003","ordinal":46219,"en":"You brought me great suffering."},{"id":"manas-2010:p1059:b001:l004","ordinal":46220,"en":"You meant to have me scout, Khan Manas,"},{"id":"manas-2010:p1059:b001:l005","ordinal":46221,"en":"That sprawling city of Beijing."},{"id":"manas-2010:p1059:b001:l006","ordinal":46222,"en":"You meant to bring down upon my head"},{"id":"manas-2010:p1059:b001:l007","ordinal":46223,"en":"Calamity from far away."},{"id":"manas-2010:p1059:b001:l008","ordinal":46224,"en":"You turned my secret inside out,"},{"id":"manas-2010:p1059:b001:l009","ordinal":46225,"en":"You meant to make me tell here"},{"id":"manas-2010:p1059:b001:l010","ordinal":46226,"en":"The very truth about myself."},{"id":"manas-2010:p1059:b001:l011","ordinal":46227,"en":"The countless Chinese with their red tufts—"},{"id":"manas-2010:p1059:b001:l012","ordinal":46228,"en":"Do you think I came without seeing them?"},{"id":"manas-2010:p1059:b001:l013","ordinal":46229,"en":"That sprawling Beijing—"},{"id":"manas-2010:p1059:b001:l014","ordinal":46230,"en":"Do you think I came without knowing it?"},{"id":"manas-2010:p1059:b001:l015","ordinal":46231,"en":"The curving ridge of Kara-Kyr—"},{"id":"manas-2010:p1059:b001:l016","ordinal":46232,"en":"Do you think I came without traversing it?"},{"id":"manas-2010:p1059:b001:l017","ordinal":46233,"en":"The yellow gold of Beijing—"},{"id":"manas-2010:p1059:b001:l018","ordinal":46234,"en":"Do you think I came without scattering it?"},{"id":"manas-2010:p1059:b001:l019","ordinal":46235,"en":"Among the Black Chinese and Manchus,"},{"id":"manas-2010:p1059:b001:l020","ordinal":46236,"en":"With a cotton girdle and belt"},{"id":"manas-2010:p1059:b001:l021","ordinal":46237,"en":"I was bound—let me tell you."},{"id":"manas-2010:p1059:b001:l022","ordinal":46238,"en":"I, a luckless, wretched soul,"},{"id":"manas-2010:p1059:b001:l023","ordinal":46239,"en":"In this very Beijing"},{"id":"manas-2010:p1059:b001:l024","ordinal":46240,"en":"Was born—let me tell you."},{"id":"manas-2010:p1059:b001:l025","ordinal":46241,"en":"My waist curved like a lion's,"},{"id":"manas-2010:p1059:b001:l026","ordinal":46242,"en":"Six years earlier,"},{"id":"manas-2010:p1059:b001:l027","ordinal":46243,"en":"Before one such as I was born:"},{"id":"manas-2010:p1059:b001:l028","ordinal":46244,"en":"'If one named Almambet is born,"},{"id":"manas-2010:p1059:b001:l029","ordinal":46245,"en":"He will destroy us at the root,"},{"id":"manas-2010:p1059:b001:l030","ordinal":46246,"en":"The Chinese of deep-rooted Beijing—"},{"id":"manas-2010:p1059:b001:l031","ordinal":46247,"en":"He will slaughter them all,'"},{"id":"manas-2010:p1059:b001:l032","ordinal":46248,"en":"In the great emperor Esenkan’s"},{"id":"manas-2010:p1059:b001:l033","ordinal":46249,"en":"Register it was inscribed."},{"id":"manas-2010:p1059:b001:l034","ordinal":46250,"en":"When they saw this inscription,"},{"id":"manas-2010:p1059:b001:l035","ordinal":46251,"en":"Great Beijing took fright"},{"id":"manas-2010:p1059:b001:l036","ordinal":46252,"en":"And spread the rumor:"},{"id":"manas-2010:p1059:b001:l037","ordinal":46253,"en":"Upon Kakan-Chin's Beijing"},{"id":"manas-2010:p1059:b001:l038","ordinal":46254,"en":"He would bring humiliation."},{"id":"manas-2010:p1059:b001:l039","ordinal":46255,"en":"'If Almambet should be born,"},{"id":"manas-2010:p1059:b001:l040","ordinal":46256,"en":"He will not spare broad Beijing;"},{"id":"manas-2010:p1059:b001:l041","ordinal":46257,"en":"He will put it thoroughly to rights,'"},{"id":"manas-2010:p1059:b001:l042","ordinal":46258,"en":"Said the command issued to the people:"},{"id":"manas-2010:p1060:b001:l001","ordinal":46259,"en":"He inflicted upon the people"},{"id":"manas-2010:p1060:b001:l002","ordinal":46260,"en":"An unheard-of horror."},{"id":"manas-2010:p1060:b001:l003","ordinal":46261,"en":"Of the city with its gates,"},{"id":"manas-2010:p1060:b001:l004","ordinal":46262,"en":"He gathered the countless inhabitants."},{"id":"manas-2010:p1060:b001:l005","ordinal":46263,"en":"Whenever a woman bore a child,"},{"id":"manas-2010:p1060:b001:l006","ordinal":46264,"en":"'Bring us the child to see,' he said,"},{"id":"manas-2010:p1060:b001:l007","ordinal":46265,"en":"Tormenting all his people."},{"id":"manas-2010:p1060:b001:l008","ordinal":46266,"en":"Unable to endure his wrath,"},{"id":"manas-2010:p1060:b001:l009","ordinal":46267,"en":"His people could find no peace."},{"id":"manas-2010:p1060:b001:l010","ordinal":46268,"en":"Such, in Beijing,"},{"id":"manas-2010:p1060:b001:l011","ordinal":46269,"en":"Was my turmoil, Khan Manas."},{"id":"manas-2010:p1060:b001:l012","ordinal":46270,"en":"That is why, concerning Beijing,"},{"id":"manas-2010:p1060:b001:l013","ordinal":46271,"en":"I had not told its circumstances."},{"id":"manas-2010:p1060:b001:l014","ordinal":46272,"en":"Chewing white wheat and swearing an oath—"},{"id":"manas-2010:p1060:b001:l015","ordinal":46273,"en":"It is true I did not eat it."},{"id":"manas-2010:p1060:b001:l016","ordinal":46274,"en":"For this reason, it is also true"},{"id":"manas-2010:p1060:b001:l017","ordinal":46275,"en":"That I did not speak of Beijing."},{"id":"manas-2010:p1060:b001:l018","ordinal":46276,"en":"'If I happen to tell,"},{"id":"manas-2010:p1060:b001:l019","ordinal":46277,"en":"Manas will drive his army onward"},{"id":"manas-2010:p1060:b001:l020","ordinal":46278,"en":"And slaughter the whole world,' I thought;"},{"id":"manas-2010:p1060:b001:l021","ordinal":46279,"en":"It is true I did not tell."},{"id":"manas-2010:p1060:b001:l022","ordinal":46280,"en":"'If I happen to speak of Beijing,"},{"id":"manas-2010:p1060:b001:l023","ordinal":46281,"en":"They will say I know the Chinese situation;"},{"id":"manas-2010:p1060:b001:l024","ordinal":46282,"en":"If the Kyrgyz people are wiped out,"},{"id":"manas-2010:p1060:b001:l025","ordinal":46283,"en":"Disgrace will remain,' I thought."},{"id":"manas-2010:p1060:b001:l026","ordinal":46284,"en":"'Manas will wreak havoc,' I thought,"},{"id":"manas-2010:p1060:b001:l027","ordinal":46285,"en":"'For the poor, countless people's suffering,"},{"id":"manas-2010:p1060:b001:l028","ordinal":46286,"en":"He will bear the guilt,' I thought."},{"id":"manas-2010:p1060:b001:l029","ordinal":46287,"en":"That is why, concerning Beijing,"},{"id":"manas-2010:p1060:b001:l030","ordinal":46288,"en":"I did not tell you from the beginning, Manas."},{"id":"manas-2010:p1060:b001:l031","ordinal":46289,"en":"From this very Beijing"},{"id":"manas-2010:p1060:b001:l032","ordinal":46290,"en":"A khan named Alöökö arose."},{"id":"manas-2010:p1060:b001:l033","ordinal":46291,"en":"Alöökö's Kongurbay—"},{"id":"manas-2010:p1060:b001:l034","ordinal":46292,"en":"When humankind heard his fame,"},{"id":"manas-2010:p1060:b001:l035","ordinal":46293,"en":"His voice alone made their souls depart."},{"id":"manas-2010:p1060:b001:l036","ordinal":46294,"en":"An ember rising from the hearth,"},{"id":"manas-2010:p1060:b001:l037","ordinal":46295,"en":"When he reached nine years of age,"},{"id":"manas-2010:p1060:b001:l038","ordinal":46296,"en":"The Kalcha began his mischief."},{"id":"manas-2010:p1060:b001:l039","ordinal":46297,"en":"When he reached eleven years,"},{"id":"manas-2010:p1060:b001:l040","ordinal":46298,"en":"Unable to withstand his wrath,"},{"id":"manas-2010:p1060:b001:l041","ordinal":46299,"en":"The countless people of Kakan-Chin"},{"id":"manas-2010:p1060:b001:l042","ordinal":46300,"en":"Were thrown into disarray."},{"id":"manas-2010:p1061:b001:l001","ordinal":46301,"en":"When he reached thirteen years,"},{"id":"manas-2010:p1061:b001:l002","ordinal":46302,"en":"He brought turmoil upon the people,"},{"id":"manas-2010:p1061:b001:l003","ordinal":46303,"en":"He seized the monks' khanate."},{"id":"manas-2010:p1061:b001:l004","ordinal":46304,"en":"After that, in Beijing,"},{"id":"manas-2010:p1061:b001:l005","ordinal":46305,"en":"He became the ruler."},{"id":"manas-2010:p1061:b001:l006","ordinal":46306,"en":"At that time, Kongurbay"},{"id":"manas-2010:p1061:b001:l007","ordinal":46307,"en":"My father's Khan-Zhaylak—"},{"id":"manas-2010:p1061:b001:l008","ordinal":46308,"en":"Withholding it by force,"},{"id":"manas-2010:p1061:b001:l009","ordinal":46309,"en":"He seized it entirely."},{"id":"manas-2010:p1061:b001:l010","ordinal":46310,"en":"Esenkan's son Börüköz"},{"id":"manas-2010:p1061:b001:l011","ordinal":46311,"en":"Also grew powerful in Beijing."},{"id":"manas-2010:p1061:b001:l012","ordinal":46312,"en":"My poor father, who had no child,"},{"id":"manas-2010:p1061:b001:l013","ordinal":46313,"en":"Was humiliated worse than anyone."},{"id":"manas-2010:p1061:b001:l014","ordinal":46314,"en":"Those two wretches grew great in Beijing."},{"id":"manas-2010:p1061:b001:l015","ordinal":46315,"en":"My father Azizkan,"},{"id":"manas-2010:p1061:b001:l016","ordinal":46316,"en":"For the sake of a male child,"},{"id":"manas-2010:p1061:b001:l017","ordinal":46317,"en":"Had taken sixty wives."},{"id":"manas-2010:p1061:b001:l018","ordinal":46318,"en":"Until he reached seventy,"},{"id":"manas-2010:p1061:b001:l019","ordinal":46319,"en":"None of the sixty wives gave birth."},{"id":"manas-2010:p1061:b001:l020","ordinal":46320,"en":"My dear father Azizkan"},{"id":"manas-2010:p1061:b001:l021","ordinal":46321,"en":"Was left without an heir."},{"id":"manas-2010:p1061:b001:l022","ordinal":46322,"en":"Weeping bitterly in exhaustion,"},{"id":"manas-2010:p1061:b001:l023","ordinal":46323,"en":"Distressed by longing for a child:"},{"id":"manas-2010:p1061:b001:l024","ordinal":46324,"en":"'Alöökö's Kongurbay"},{"id":"manas-2010:p1061:b001:l025","ordinal":46325,"en":"Has sucked the whole world dry,' he said."},{"id":"manas-2010:p1061:b001:l026","ordinal":46326,"en":"'Esenkan's Börüköz"},{"id":"manas-2010:p1061:b001:l027","ordinal":46327,"en":"Has become the khan of Beijing."},{"id":"manas-2010:p1061:b001:l028","ordinal":46328,"en":"No heir has been born of me—"},{"id":"manas-2010:p1061:b001:l029","ordinal":46329,"en":"What a terrible thing has happened!'"},{"id":"manas-2010:p1061:b001:l030","ordinal":46330,"en":"Beijing's khan Karykan,"},{"id":"manas-2010:p1061:b001:l031","ordinal":46331,"en":"Alöökö Khan, Azizkan,"},{"id":"manas-2010:p1061:b001:l032","ordinal":46332,"en":"And Esenkan—the four were brothers."},{"id":"manas-2010:p1061:b001:l033","ordinal":46333,"en":"All were sons of one emperor."},{"id":"manas-2010:p1061:b001:l034","ordinal":46334,"en":"Over Beijing with its forty gates,"},{"id":"manas-2010:p1061:b001:l035","ordinal":46335,"en":"The Chinese people's Karykan,"},{"id":"manas-2010:p1061:b001:l036","ordinal":46336,"en":"A man of sacred power,"}]
