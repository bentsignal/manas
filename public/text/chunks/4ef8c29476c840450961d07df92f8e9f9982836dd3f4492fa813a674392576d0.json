[{"id":"semetey-1-2013:p1413:b004:l006","ordinal":185089,"en":"Kuuördök at the watch-post"},{"id":"semetey-1-2013:p1413:b004:l007","ordinal":185090,"en":"Circled in the air,"},{"id":"semetey-1-2013:p1413:b004:l008","ordinal":185091,"en":"Flying backward and banking."},{"id":"semetey-1-2013:p1413:b004:l009","ordinal":185092,"en":"The remarkable Kuuördök—"},{"id":"semetey-1-2013:p1413:b004:l010","ordinal":185093,"en":"His beak is long, his neck is copper,"},{"id":"semetey-1-2013:p1413:b004:l011","ordinal":185094,"en":"Its girth two fathoms,"},{"id":"semetey-1-2013:p1413:b004:l012","ordinal":185095,"en":"With an iron tail, swiftest of all;"},{"id":"semetey-1-2013:p1413:b004:l013","ordinal":185096,"en":"When frenzied Kuuördök"},{"id":"semetey-1-2013:p1413:b004:l014","ordinal":185097,"en":"Rose, no living creature could catch it."},{"id":"semetey-1-2013:p1413:b004:l015","ordinal":185098,"en":"As it rose,"},{"id":"semetey-1-2013:p1413:b004:l016","ordinal":185099,"en":"Semetey, born after"},{"id":"semetey-1-2013:p1413:b004:l017","ordinal":185100,"en":"His father Manas the gray wolf,"},{"id":"semetey-1-2013:p1413:b004:l018","ordinal":185101,"en":"Shouted in anger,"},{"id":"semetey-1-2013:p1413:b004:l019","ordinal":185102,"en":"Raised the cry of \"Bloodthirsty One!\""},{"id":"semetey-1-2013:p1413:b004:l020","ordinal":185103,"en":"He set the falcon in position,"},{"id":"semetey-1-2013:p1413:b004:l021","ordinal":185104,"en":"Brought it keenly onto the quarry,"},{"id":"semetey-1-2013:p1413:b004:l022","ordinal":185105,"en":"And watched it soar,"},{"id":"semetey-1-2013:p1413:b004:l023","ordinal":185106,"en":"Looking to either side."},{"id":"semetey-1-2013:p1413:b004:l024","ordinal":185107,"en":"Semetey's Akshumkar"},{"id":"semetey-1-2013:p1413:b004:l025","ordinal":185108,"en":"Was a champion beyond compare,"},{"id":"semetey-1-2013:p1413:b004:l026","ordinal":185109,"en":"Utterly peerless in the hunt."},{"id":"semetey-1-2013:p1413:b004:l027","ordinal":185110,"en":"No quarry escaped before it;"},{"id":"semetey-1-2013:p1413:b004:l028","ordinal":185111,"en":"Its talons were iron, its beak brass,"},{"id":"semetey-1-2013:p1413:b004:l029","ordinal":185112,"en":"Its girth two fathoms."},{"id":"semetey-1-2013:p1413:b004:l030","ordinal":185113,"en":"Black eyes, blue legs,"},{"id":"semetey-1-2013:p1413:b004:l031","ordinal":185114,"en":"It never turned back from what it saw,"},{"id":"semetey-1-2013:p1413:b004:l032","ordinal":185115,"en":"And left no morsel in a pail uneaten."},{"id":"semetey-1-2013:p1413:b004:l033","ordinal":185116,"en":"It would not let a goose rise from the lake,"},{"id":"semetey-1-2013:p1413:b004:l034","ordinal":185117,"en":"But folded its wings and stooped upon it;"},{"id":"semetey-1-2013:p1413:b004:l035","ordinal":185118,"en":"It would not let a swan rise from the lake,"},{"id":"semetey-1-2013:p1413:b004:l036","ordinal":185119,"en":"But gathered its tail and stooped upon it."},{"id":"semetey-1-2013:p1413:b004:l037","ordinal":185120,"en":"The champion who trained it as a hunting bird"},{"id":"semetey-1-2013:p1413:b004:l038","ordinal":185121,"en":"Was a young man touched by Khizir,"},{"id":"semetey-1-2013:p1413:b004:l039","ordinal":185122,"en":"To whom God himself had granted it!"},{"id":"semetey-1-2013:p1414:b003:l001","ordinal":185123,"en":"Beating the drum and raising a cry,"},{"id":"semetey-1-2013:p1414:b003:l002","ordinal":185124,"en":"Your capable uncle Bakai"},{"id":"semetey-1-2013:p1414:b003:l003","ordinal":185125,"en":"Came riding here and there;"},{"id":"semetey-1-2013:p1414:b003:l004","ordinal":185126,"en":"Kökcholok came snorting,"},{"id":"semetey-1-2013:p1414:b003:l005","ordinal":185127,"en":"As Bakai fired his gun and drew his bow."},{"id":"semetey-1-2013:p1414:b003:l006","ordinal":185128,"en":"Your uncle Bakai, bringer of good fortune,"},{"id":"semetey-1-2013:p1414:b003:l007","ordinal":185129,"en":"Urged it on without cease."},{"id":"semetey-1-2013:p1414:b003:l008","ordinal":185130,"en":"At that moment Kuuördök"},{"id":"semetey-1-2013:p1414:b003:l009","ordinal":185131,"en":"Flew up from the lake;"},{"id":"semetey-1-2013:p1414:b003:l010","ordinal":185132,"en":"When it had risen,"},{"id":"semetey-1-2013:p1414:b003:l011","ordinal":185133,"en":"Your young son of the gray wolf"},{"id":"semetey-1-2013:p1414:b003:l012","ordinal":185134,"en":"Cast Akshumkar at it."},{"id":"semetey-1-2013:p1414:b003:l013","ordinal":185135,"en":"Striking a rock and falling limp,"},{"id":"semetey-1-2013:p1414:b003:l014","ordinal":185136,"en":"Akshumkar lay unconscious"},{"id":"semetey-1-2013:p1414:b003:l015","ordinal":185137,"en":"For the time it takes tea to boil."},{"id":"semetey-1-2013:p1414:b003:l016","ordinal":185138,"en":"Bakai shouted out:"},{"id":"semetey-1-2013:p1414:b003:l017","ordinal":185139,"en":"\"Wretched child, be ruined!"},{"id":"semetey-1-2013:p1414:b003:l018","ordinal":185140,"en":"You never heed my words;"},{"id":"semetey-1-2013:p1414:b003:l019","ordinal":185141,"en":"You are always ill-fated,"},{"id":"semetey-1-2013:p1414:b003:l020","ordinal":185142,"en":"Bent on gouging out my eyes!"},{"id":"semetey-1-2013:p1414:b003:l021","ordinal":185143,"en":"No matter what I say, you will not listen;"},{"id":"semetey-1-2013:p1414:b003:l022","ordinal":185144,"en":"Arrogant son, you will come to no good!\""},{"id":"semetey-1-2013:p1414:b003:l023","ordinal":185145,"en":"Tearing out and flinging away his beard,"},{"id":"semetey-1-2013:p1414:b003:l024","ordinal":185146,"en":"Tugging and flinging his mustache,"},{"id":"semetey-1-2013:p1414:b003:l025","ordinal":185147,"en":"Staggering up and down,"},{"id":"semetey-1-2013:p1414:b003:l026","ordinal":185148,"en":"Your uncle Bakai wailed"},{"id":"semetey-1-2013:p1414:b003:l027","ordinal":185149,"en":"And beat himself upon the head:"},{"id":"semetey-1-2013:p1414:b003:l028","ordinal":185150,"en":"\"Alas, Manas—if only you had not died!"},{"id":"semetey-1-2013:p1414:b003:l029","ordinal":185151,"en":"Then this wretched soul would not see such disgrace!"},{"id":"semetey-1-2013:p1414:b003:l030","ordinal":185152,"en":"Curse you, Manas—if only you had not died,"},{"id":"semetey-1-2013:p1414:b003:l031","ordinal":185153,"en":"Then Bakai would not see such suffering!"},{"id":"semetey-1-2013:p1414:b003:l032","ordinal":185154,"en":"I have withered like grass in a dry streambed;"},{"id":"semetey-1-2013:p1414:b003:l033","ordinal":185155,"en":"When Manas passed away"},{"id":"semetey-1-2013:p1414:b003:l034","ordinal":185156,"en":"No one heeds my words,"},{"id":"semetey-1-2013:p1414:b003:l035","ordinal":185157,"en":"And I am like a fire gone out!"},{"id":"semetey-1-2013:p1414:b003:l036","ordinal":185158,"en":"Curse you, Manas, for dying"},{"id":"semetey-1-2013:p1414:b003:l037","ordinal":185159,"en":"And leaving your dependent"},{"id":"semetey-1-2013:p1414:b003:l038","ordinal":185160,"en":"To a wretch like this!\" he cried."},{"id":"semetey-1-2013:p1414:b003:l039","ordinal":185161,"en":"As Bakai stood thus,"},{"id":"semetey-1-2013:p1414:b004:l001","ordinal":185162,"en":"Akshumkar recovered its senses,"},{"id":"semetey-1-2013:p1414:b004:l002","ordinal":185163,"en":"Shook itself and voided its bowels;"},{"id":"semetey-1-2013:p1414:b004:l003","ordinal":185164,"en":"The gray wolf's falcon"},{"id":"semetey-1-2013:p1414:b004:l004","ordinal":185165,"en":"Rose and flew anew,"},{"id":"semetey-1-2013:p1414:b004:l005","ordinal":185166,"en":"It circled in the air,"},{"id":"semetey-1-2013:p1414:b004:l006","ordinal":185167,"en":"Flying backward and banking;"},{"id":"semetey-1-2013:p1414:b004:l007","ordinal":185168,"en":"It climbed and righted itself,"},{"id":"semetey-1-2013:p1414:b004:l008","ordinal":185169,"en":"As though it had lost sight of the quarry;"},{"id":"semetey-1-2013:p1414:b004:l009","ordinal":185170,"en":"With twelve tail-feathers and forty pinions,"},{"id":"semetey-1-2013:p1414:b004:l010","ordinal":185171,"en":"It now beat its wings mightily,"},{"id":"semetey-1-2013:p1414:b004:l011","ordinal":185172,"en":"Drawing itself tight with a hiss,"},{"id":"semetey-1-2013:p1414:b004:l012","ordinal":185173,"en":"Its roar breaking forth."},{"id":"semetey-1-2013:p1414:b004:l013","ordinal":185174,"en":"At times,"},{"id":"semetey-1-2013:p1414:b004:l014","ordinal":185175,"en":"It looked like a gray sparrow;"},{"id":"semetey-1-2013:p1414:b004:l015","ordinal":185176,"en":"Fluttering its wings,"},{"id":"semetey-1-2013:p1414:b004:l016","ordinal":185177,"en":"Quivering faster than an arrow,"},{"id":"semetey-1-2013:p1414:b004:l017","ordinal":185178,"en":"Its wingbeats could not be seen;"},{"id":"semetey-1-2013:p1414:b004:l018","ordinal":185179,"en":"It began the tumult,"},{"id":"semetey-1-2013:p1414:b004:l019","ordinal":185180,"en":"Risking its very life."},{"id":"semetey-1-2013:p1414:b004:l020","ordinal":185181,"en":"Toward the fortress with iron gates,"},{"id":"semetey-1-2013:p1414:b004:l021","ordinal":185182,"en":"Toward old Khan's palace,"},{"id":"semetey-1-2013:p1414:b004:l022","ordinal":185183,"en":"Ringed by plane trees,"},{"id":"semetey-1-2013:p1414:b004:l023","ordinal":185184,"en":"With a golden throne at its center,"},{"id":"semetey-1-2013:p1414:b004:l024","ordinal":185185,"en":"Beneath the golden throne,"},{"id":"semetey-1-2013:p1414:b004:l025","ordinal":185186,"en":"A bottomless black well;"},{"id":"semetey-1-2013:p1414:b004:l026","ordinal":185187,"en":"The gray-winged duck had nearly arrived"},{"id":"semetey-1-2013:p1414:b004:l027","ordinal":185188,"en":"And was about to descend."},{"id":"semetey-1-2013:p1414:b004:l028","ordinal":185189,"en":"Just as it was about to alight"},{"id":"semetey-1-2013:p1414:b004:l029","ordinal":185190,"en":"Before mighty elder Kary Khan,"},{"id":"semetey-1-2013:p1414:b004:l030","ordinal":185191,"en":"Spread the news in every direction,"},{"id":"semetey-1-2013:p1414:b004:l031","ordinal":185192,"en":"And reach the bottom,"},{"id":"semetey-1-2013:p1414:b004:l032","ordinal":185193,"en":"The gray wolf's Akshumkar"},{"id":"semetey-1-2013:p1414:b004:l033","ordinal":185194,"en":"Folded over with a hiss;"},{"id":"semetey-1-2013:p1414:b004:l034","ordinal":185195,"en":"Reaching before the arrow,"},{"id":"semetey-1-2013:p1414:b004:l035","ordinal":185196,"en":"It seized the duck where it caught it,"},{"id":"semetey-1-2013:p1414:b004:l036","ordinal":185197,"en":"Without having his khan informed,"},{"id":"semetey-1-2013:p1414:b004:l037","ordinal":185198,"en":"The leopard's Akshumkar"},{"id":"semetey-1-2013:p1414:b004:l038","ordinal":185199,"en":"Struck and carried it away."},{"id":"semetey-1-2013:p1414:b004:l039","ordinal":185200,"en":"It lifted Kuuördök,"},{"id":"semetey-1-2013:p1415:b003:l001","ordinal":185201,"en":"He circled back, hovering,"},{"id":"semetey-1-2013:p1415:b003:l002","ordinal":185202,"en":"And drew near the Pole Star."},{"id":"semetey-1-2013:p1415:b003:l003","ordinal":185203,"en":"From the falcon once carried"},{"id":"semetey-1-2013:p1415:b003:l004","ordinal":185204,"en":"By his father Manas, the gray wolf,"},{"id":"semetey-1-2013:p1415:b003:l005","ordinal":185205,"en":"A bird had been born as a legacy held in trust;"},{"id":"semetey-1-2013:p1415:b003:l006","ordinal":185206,"en":"Allah ordained that it should come"},{"id":"semetey-1-2013:p1415:b003:l007","ordinal":185207,"en":"To the young champion, the noble lord’s son."},{"id":"semetey-1-2013:p1415:b003:l008","ordinal":185208,"en":"When loosed, that champion was his treasure,"},{"id":"semetey-1-2013:p1415:b003:l009","ordinal":185209,"en":"The treasure left as a gift"},{"id":"semetey-1-2013:p1415:b003:l010","ordinal":185210,"en":"By valiant Manas, the gray wolf!"},{"id":"semetey-1-2013:p1415:b003:l011","ordinal":185211,"en":"It had utterly torn apart"},{"id":"semetey-1-2013:p1415:b003:l012","ordinal":185212,"en":"The breast and chest,"},{"id":"semetey-1-2013:p1415:b003:l013","ordinal":185213,"en":"And feasted to its heart’s content"},{"id":"semetey-1-2013:p1415:b003:l014","ordinal":185214,"en":"Upon the dark flesh of the breast."},{"id":"semetey-1-2013:p1415:b003:l015","ordinal":185215,"en":"Your noble Akshumkar"},{"id":"semetey-1-2013:p1415:b003:l016","ordinal":185216,"en":"Flashed beneath the moon in the sky,"},{"id":"semetey-1-2013:p1415:b003:l017","ordinal":185217,"en":"Lifting the wild duck,"},{"id":"semetey-1-2013:p1415:b003:l018","ordinal":185218,"en":"And came down from the sky in triumph,"},{"id":"semetey-1-2013:p1415:b003:l019","ordinal":185219,"en":"Crying out loudly!"},{"id":"semetey-1-2013:p1415:b003:l020","ordinal":185220,"en":"His eyes beheld the falcon,"},{"id":"semetey-1-2013:p1415:b003:l021","ordinal":185221,"en":"The accursed wild duck"},{"id":"semetey-1-2013:p1415:b003:l022","ordinal":185222,"en":"That Akshumkar had snatched and brought;"},{"id":"semetey-1-2013:p1415:b003:l023","ordinal":185223,"en":"His uncle, old Bakai,"},{"id":"semetey-1-2013:p1415:b003:l024","ordinal":185224,"en":"Saw it coming with his own eyes!"},{"id":"semetey-1-2013:p1415:b003:l025","ordinal":185225,"en":"“My beloved Akshumkar,"},{"id":"semetey-1-2013:p1415:b003:l026","ordinal":185226,"en":"May aged Bakai circle in devotion"},{"id":"semetey-1-2013:p1415:b003:l027","ordinal":185227,"en":"Around a champion like you!"},{"id":"semetey-1-2013:p1415:b003:l028","ordinal":185228,"en":"Merely seeing you leaves my heart content;"},{"id":"semetey-1-2013:p1415:b003:l029","ordinal":185229,"en":"Apart from you, my champion,"},{"id":"semetey-1-2013:p1415:b003:l030","ordinal":185230,"en":"I possess no treasure—"},{"id":"semetey-1-2013:p1415:b003:l031","ordinal":185231,"en":"From your eyes like black currants,"},{"id":"semetey-1-2013:p1415:b003:l032","ordinal":185232,"en":"From you who caught the wild duck!"},{"id":"semetey-1-2013:p1415:b003:l033","ordinal":185233,"en":"Now that I, Bakai, am old,"},{"id":"semetey-1-2013:p1415:b003:l034","ordinal":185234,"en":"My beloved Akshumkar,"},{"id":"semetey-1-2013:p1415:b003:l035","ordinal":185235,"en":"May I be your sacrifice!”"},{"id":"semetey-1-2013:p1415:b003:l036","ordinal":185236,"en":"Rejoicing, Khan Bakai"},{"id":"semetey-1-2013:p1415:b003:l037","ordinal":185237,"en":"Swiftly invoked Babedin,"},{"id":"semetey-1-2013:p1415:b003:l038","ordinal":185238,"en":"Promised a sheep to Koroson,"},{"id":"semetey-1-2013:p1415:b003:l039","ordinal":185239,"en":"And before Allah Most High, the One,"},{"id":"semetey-1-2013:p1415:b004:l001","ordinal":185240,"en":"Also spoke the vow of Aituyak."},{"id":"semetey-1-2013:p1415:b004:l002","ordinal":185241,"en":"All his longing subsided;"},{"id":"semetey-1-2013:p1415:b004:l003","ordinal":185242,"en":"Your uncle and Semetey"},{"id":"semetey-1-2013:p1415:b004:l004","ordinal":185243,"en":"Had their eyes opened wide as umach,"},{"id":"semetey-1-2013:p1415:b004:l005","ordinal":185244,"en":"And all their sorrow subsided."},{"id":"semetey-1-2013:p1415:b004:l006","ordinal":185245,"en":"Near the forked pass,"},{"id":"semetey-1-2013:p1415:b004:l007","ordinal":185246,"en":"To the high, level upland,"},{"id":"semetey-1-2013:p1415:b004:l008","ordinal":185247,"en":"To the level ground covered in fescue,"},{"id":"semetey-1-2013:p1415:b004:l009","ordinal":185248,"en":"To lovely Kara-Kyya,"},{"id":"semetey-1-2013:p1415:b004:l010","ordinal":185249,"en":"They turned aside to camp."},{"id":"semetey-1-2013:p1415:b004:l011","ordinal":185250,"en":"For your aged uncle Bakai,"},{"id":"semetey-1-2013:p1415:b004:l012","ordinal":185251,"en":"They sliced rump meat and served mane-fat;"},{"id":"semetey-1-2013:p1415:b004:l013","ordinal":185252,"en":"Without delay they had him begin his tale."},{"id":"semetey-1-2013:p1415:b004:l014","ordinal":185253,"en":"For valiant old Bakai,"},{"id":"semetey-1-2013:p1415:b004:l015","ordinal":185254,"en":"They had a fattened lamb and sweet head"},{"id":"semetey-1-2013:p1415:b004:l016","ordinal":185255,"en":"Boiled into bor."},{"id":"semetey-1-2013:p1415:b004:l017","ordinal":185256,"en":"They heaped up sugar like snow"},{"id":"semetey-1-2013:p1415:b004:l018","ordinal":185257,"en":"And scooped out yellow butter."},{"id":"semetey-1-2013:p1415:b004:l019","ordinal":185258,"en":"They served a thousand and one kinds of food,"},{"id":"semetey-1-2013:p1415:b004:l020","ordinal":185259,"en":"Plunging their elder uncle Bakai"},{"id":"semetey-1-2013:p1415:b004:l021","ordinal":185260,"en":"Into every kind of pleasure;"},{"id":"semetey-1-2013:p1415:b004:l022","ordinal":185261,"en":"The luxuriant turf and clean ground"},{"id":"semetey-1-2013:p1415:b004:l023","ordinal":185262,"en":"Pleased the gray-wolf hero."},{"id":"semetey-1-2013:p1415:b004:l024","ordinal":185263,"en":"They had him begin tales of every kind,"},{"id":"semetey-1-2013:p1415:b004:l025","ordinal":185264,"en":"And gave their poor uncle Bakai"},{"id":"semetey-1-2013:p1415:b004:l026","ordinal":185265,"en":"A Bayandos pillow upon which to rest."},{"id":"semetey-1-2013:p1415:b004:l027","ordinal":185266,"en":"Their uncle Bakai, your sage,"},{"id":"semetey-1-2013:p1415:b004:l028","ordinal":185267,"en":"Now fell into a hero’s sleep."},{"id":"semetey-1-2013:p1415:b004:l029","ordinal":185268,"en":"For the gray wolf born after"},{"id":"semetey-1-2013:p1415:b004:l030","ordinal":185269,"en":"His father, Lord Manas,"},{"id":"semetey-1-2013:p1415:b004:l031","ordinal":185270,"en":"There was the Akkangky saddle made by Almambet,"},{"id":"semetey-1-2013:p1415:b004:l032","ordinal":185271,"en":"The Kangky saddle fitted for Semetey."},{"id":"semetey-1-2013:p1415:b004:l033","ordinal":185272,"en":"Its front bow was pure gold,"},{"id":"semetey-1-2013:p1415:b004:l034","ordinal":185273,"en":"Its rear bow solid silver,"},{"id":"semetey-1-2013:p1415:b004:l035","ordinal":185274,"en":"And its two sides broad iron;"},{"id":"semetey-1-2013:p1415:b004:l036","ordinal":185275,"en":"It would not shift when ridden downhill."},{"id":"semetey-1-2013:p1415:b004:l037","ordinal":185276,"en":"The splendid hero, the lord’s son,"},{"id":"semetey-1-2013:p1415:b004:l038","ordinal":185277,"en":"Rested his head upon Akkangky,"},{"id":"semetey-1-2013:p1415:b004:l039","ordinal":185278,"en":"With his head toward the qibla,"},{"id":"semetey-1-2013:p1416:b003:l001","ordinal":185279,"en":"Covered himself with Akolpok,"},{"id":"semetey-1-2013:p1416:b003:l002","ordinal":185280,"en":"Prayed to the spirit"},{"id":"semetey-1-2013:p1416:b003:l003","ordinal":185281,"en":"Of his father Manas, the gray wolf,"},{"id":"semetey-1-2013:p1416:b003:l004","ordinal":185282,"en":"And fell into a hero’s sleep."},{"id":"semetey-1-2013:p1416:b003:l005","ordinal":185283,"en":"They removed the saddles"},{"id":"semetey-1-2013:p1416:b003:l006","ordinal":185284,"en":"From Kökcholok and Taibuurul,"},{"id":"semetey-1-2013:p1416:b003:l007","ordinal":185285,"en":"Leaving them bare-backed,"},{"id":"semetey-1-2013:p1416:b003:l008","ordinal":185286,"en":"And tethered the ancient coursers high."},{"id":"semetey-1-2013:p1416:b003:l009","ordinal":185287,"en":"They lay upon their sides and rested,"},{"id":"semetey-1-2013:p1416:b003:l010","ordinal":185288,"en":"Lay down and slept their fill,"},{"id":"semetey-1-2013:p1416:b003:l011","ordinal":185289,"en":"Rested propped upon an elbow,"},{"id":"semetey-1-2013:p1416:b003:l012","ordinal":185290,"en":"And took a brief doze."},{"id":"semetey-1-2013:p1416:b003:l013","ordinal":185291,"en":"When the time of truthful dawn arrived,"},{"id":"semetey-1-2013:p1416:b003:l014","ordinal":185292,"en":"When daybreak turned yellow,"},{"id":"semetey-1-2013:p1416:b003:l015","ordinal":185293,"en":"The stars separated above them,"},{"id":"semetey-1-2013:p1416:b003:l016","ordinal":185294,"en":"And dawn appeared, swelling bright."},{"id":"semetey-1-2013:p1416:b003:l017","ordinal":185295,"en":"The stars scattered across the sky,"},{"id":"semetey-1-2013:p1416:b003:l018","ordinal":185296,"en":"Trembling toward the qibla;"},{"id":"semetey-1-2013:p1416:b003:l019","ordinal":185297,"en":"The cold wind of dawn roared,"},{"id":"semetey-1-2013:p1416:b003:l020","ordinal":185298,"en":"And the reed-tops shivered."},{"id":"semetey-1-2013:p1416:b003:l021","ordinal":185299,"en":"Every living creature awoke,"},{"id":"semetey-1-2013:p1416:b003:l022","ordinal":185300,"en":"And fledgling larks twittered;"},{"id":"semetey-1-2013:p1416:b003:l023","ordinal":185301,"en":"Insects began to stir,"},{"id":"semetey-1-2013:p1416:b003:l024","ordinal":185302,"en":"And the sun’s countenance prepared to meet the earth."},{"id":"semetey-1-2013:p1416:b003:l025","ordinal":185303,"en":"Your uncle, old Bakai—"},{"id":"semetey-1-2013:p1416:b003:l026","ordinal":185304,"en":"That hero Bakai—"},{"id":"semetey-1-2013:p1416:b003:l027","ordinal":185305,"en":"Hero Bakai started awake,"},{"id":"semetey-1-2013:p1416:b003:l028","ordinal":185306,"en":"Prayed to the Almighty,"},{"id":"semetey-1-2013:p1416:b003:l029","ordinal":185307,"en":"And prepared to give fodder"},{"id":"semetey-1-2013:p1416:b003:l030","ordinal":185308,"en":"To the rangy courser."},{"id":"semetey-1-2013:p1416:b003:l031","ordinal":185309,"en":"One tuft of fescue among eighty grasses—"},{"id":"semetey-1-2013:p1416:b003:l032","ordinal":185310,"en":"He had the prancing courser"},{"id":"semetey-1-2013:p1416:b003:l033","ordinal":185311,"en":"Graze it in great mouthfuls,"},{"id":"semetey-1-2013:p1416:b003:l034","ordinal":185312,"en":"And evenly quenched his thirst"},{"id":"semetey-1-2013:p1416:b003:l035","ordinal":185313,"en":"At the bubbling spring."},{"id":"semetey-1-2013:p1416:b003:l036","ordinal":185314,"en":"He made Buurul prance,"},{"id":"semetey-1-2013:p1416:b003:l037","ordinal":185315,"en":"Rolled him upon the green turf,"},{"id":"semetey-1-2013:p1416:b003:l038","ordinal":185316,"en":"And your uncle Bakai, the gray-wolf lion,"},{"id":"semetey-1-2013:p1416:b003:l039","ordinal":185317,"en":"Tethered Buurul high."},{"id":"semetey-1-2013:p1416:b004:l001","ordinal":185318,"en":"Scraping him with a currycomb,"},{"id":"semetey-1-2013:p1416:b004:l002","ordinal":185319,"en":"They made Buurul a splendid sight"},{"id":"semetey-1-2013:p1416:b004:l003","ordinal":185320,"en":"And cleaned away his heavy sweat."},{"id":"semetey-1-2013:p1416:b004:l004","ordinal":185321,"en":"When Bakai looked from the ridge,"},{"id":"semetey-1-2013:p1416:b004:l005","ordinal":185322,"en":"The strands of his coat separated one by one;"},{"id":"semetey-1-2013:p1416:b004:l006","ordinal":185323,"en":"When he examined him on every side,"},{"id":"semetey-1-2013:p1416:b004:l007","ordinal":185324,"en":"The marks of a courser were revealed."},{"id":"semetey-1-2013:p1416:b004:l008","ordinal":185325,"en":"He could race a bird in flight;"},{"id":"semetey-1-2013:p1416:b004:l009","ordinal":185326,"en":"The flank-flesh that would yield rump-fat"},{"id":"semetey-1-2013:p1416:b004:l010","ordinal":185327,"en":"Had drawn back and lengthened,"},{"id":"semetey-1-2013:p1416:b004:l011","ordinal":185328,"en":"Clinging close to the ribs."},{"id":"semetey-1-2013:p1416:b004:l012","ordinal":185329,"en":"His forelegs were short, his body great;"},{"id":"semetey-1-2013:p1416:b004:l013","ordinal":185330,"en":"The marks of a thoroughbred appeared:"},{"id":"semetey-1-2013:p1416:b004:l014","ordinal":185331,"en":"Mattock hooves and a broad rump,"},{"id":"semetey-1-2013:p1416:b004:l015","ordinal":185332,"en":"A courser bred upon spacious land."},{"id":"semetey-1-2013:p1416:b004:l016","ordinal":185333,"en":"Born in sand and raised among rocks,"},{"id":"semetey-1-2013:p1416:b004:l017","ordinal":185334,"en":"He had grown apart without seeing a living soul;"},{"id":"semetey-1-2013:p1416:b004:l018","ordinal":185335,"en":"He had raced with wild asses,"},{"id":"semetey-1-2013:p1416:b004:l019","ordinal":185336,"en":"With Kylkara of Maiden Saikal"},{"id":"semetey-1-2013:p1416:b004:l020","ordinal":185337,"en":"And Kongurbai’s Algara—"},{"id":"semetey-1-2013:p1416:b004:l021","ordinal":185338,"en":"He had contended with those steeds."},{"id":"semetey-1-2013:p1416:b004:l022","ordinal":185339,"en":"As a three-year-old he was guarded with great care,"},{"id":"semetey-1-2013:p1416:b004:l023","ordinal":185340,"en":"With an owl plume fastened upon his head;"},{"id":"semetey-1-2013:p1416:b004:l024","ordinal":185341,"en":"Learned Lady Kanykei,"},{"id":"semetey-1-2013:p1416:b004:l025","ordinal":185342,"en":"Fearing that someone’s evil eye would strike him,"},{"id":"semetey-1-2013:p1416:b004:l026","ordinal":185343,"en":"Had him raised in a dark place,"},{"id":"semetey-1-2013:p1416:b004:l027","ordinal":185344,"en":"Without letting anyone know,"}]
