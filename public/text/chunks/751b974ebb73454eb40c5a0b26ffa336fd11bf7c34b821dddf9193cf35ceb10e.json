[{"id":"semetey-1-2013:p1065:b003:l027","ordinal":157441,"en":"What a waist she has girded!"},{"id":"semetey-1-2013:p1065:b003:l028","ordinal":157442,"en":"Where did this toil-stricken bitch"},{"id":"semetey-1-2013:p1065:b003:l029","ordinal":157443,"en":"Find such a husband?"},{"id":"semetey-1-2013:p1065:b003:l030","ordinal":157444,"en":"If one of these breaks free,"},{"id":"semetey-1-2013:p1065:b003:l031","ordinal":157445,"en":"It will surely eat us!"},{"id":"semetey-1-2013:p1065:b003:l032","ordinal":157446,"en":"Can anyone prosper who devises"},{"id":"semetey-1-2013:p1065:b003:l033","ordinal":157447,"en":"Every kind of lawless deed?"},{"id":"semetey-1-2013:p1065:b003:l034","ordinal":157448,"en":"Can anyone prosper who gathers"},{"id":"semetey-1-2013:p1065:b003:l035","ordinal":157449,"en":"And ties up fourteen tigers?!"},{"id":"semetey-1-2013:p1065:b003:l036","ordinal":157450,"en":"She has worn down horses' flanks,"},{"id":"semetey-1-2013:p1065:b003:l037","ordinal":157451,"en":"The wretched woman of consummate arts,"},{"id":"semetey-1-2013:p1065:b003:l038","ordinal":157452,"en":"Flying about and traversing"},{"id":"semetey-1-2013:p1065:b003:l039","ordinal":157453,"en":"The whole wide world."},{"id":"semetey-1-2013:p1065:b005:l001","ordinal":157454,"en":"Of Chürök's forty arts,"},{"id":"semetey-1-2013:p1065:b005:l002","ordinal":157455,"en":"Which art can we know?"},{"id":"semetey-1-2013:p1065:b005:l003","ordinal":157456,"en":"Is one of these the mountain pass lying closed,"},{"id":"semetey-1-2013:p1065:b005:l004","ordinal":157457,"en":"Or is it the wretched Chürök's husband"},{"id":"semetey-1-2013:p1065:b005:l005","ordinal":157458,"en":"Who came from Beijing?!"},{"id":"semetey-1-2013:p1065:b005:l006","ordinal":157459,"en":"We knew it from the beginning:"},{"id":"semetey-1-2013:p1065:b005:l007","ordinal":157460,"en":"A sidelong look was always in her eyes,"},{"id":"semetey-1-2013:p1065:b005:l008","ordinal":157461,"en":"A crooked edge was always in her words;"},{"id":"semetey-1-2013:p1065:b005:l009","ordinal":157462,"en":"Given the chance, Azhybay,"},{"id":"semetey-1-2013:p1065:b005:l010","ordinal":157463,"en":"She was always ready to trip me!"},{"id":"semetey-1-2013:p1065:b005:l011","ordinal":157464,"en":"A slant was always in her eyes,"},{"id":"semetey-1-2013:p1065:b005:l012","ordinal":157465,"en":"Perversity was always in her words;"},{"id":"semetey-1-2013:p1065:b005:l013","ordinal":157466,"en":"When the moment suited this Chürök,"},{"id":"semetey-1-2013:p1065:b005:l014","ordinal":157467,"en":"She was ready to work her Tümönbay trick on you!\""},{"id":"semetey-1-2013:p1065:b005:l015","ordinal":157468,"en":"Azhybay and Tümönbay"},{"id":"semetey-1-2013:p1065:b005:l016","ordinal":157469,"en":"Stood rigid, unable to walk,"},{"id":"semetey-1-2013:p1065:b005:l017","ordinal":157470,"en":"Quarreling with one another:"},{"id":"semetey-1-2013:p1065:b005:l018","ordinal":157471,"en":"\"We must have come to experience"},{"id":"semetey-1-2013:p1065:b005:l019","ordinal":157472,"en":"Torment like Judgment Day;"},{"id":"semetey-1-2013:p1065:b005:l020","ordinal":157473,"en":"We must have come to die"},{"id":"semetey-1-2013:p1065:b005:l021","ordinal":157474,"en":"At the hands of maiden Chürök!"},{"id":"semetey-1-2013:p1065:b005:l022","ordinal":157475,"en":"When Chynkozho strikes with a roar,"},{"id":"semetey-1-2013:p1065:b005:l023","ordinal":157476,"en":"Will he spare a soul?"},{"id":"semetey-1-2013:p1065:b005:l024","ordinal":157477,"en":"When fourteen tigers gather and maul us,"},{"id":"semetey-1-2013:p1065:b005:l025","ordinal":157478,"en":"Will they spare a soul?!"},{"id":"semetey-1-2013:p1065:b005:l026","ordinal":157479,"en":"Chürök has raised"},{"id":"semetey-1-2013:p1065:b005:l027","ordinal":157480,"en":"This calamitous turmoil;"},{"id":"semetey-1-2013:p1065:b005:l028","ordinal":157481,"en":"We have died before living out our lives,"},{"id":"semetey-1-2013:p1065:b005:l029","ordinal":157482,"en":"And suffered disgrace from the infidels!\""},{"id":"semetey-1-2013:p1065:b005:l030","ordinal":157483,"en":"When Azhybay and Tümönbay"},{"id":"semetey-1-2013:p1065:b005:l031","ordinal":157484,"en":"Saw those tigers,"},{"id":"semetey-1-2013:p1065:b005:l032","ordinal":157485,"en":"The strength left their arms,"},{"id":"semetey-1-2013:p1065:b005:l033","ordinal":157486,"en":"And courage left their hearts."},{"id":"semetey-1-2013:p1065:b005:l034","ordinal":157487,"en":"Azhybay cowered against Tümönbay;"},{"id":"semetey-1-2013:p1065:b005:l035","ordinal":157488,"en":"From inside Azhybay's trousers,"},{"id":"semetey-1-2013:p1065:b005:l036","ordinal":157489,"en":"His urine streamed out."},{"id":"semetey-1-2013:p1065:b005:l037","ordinal":157490,"en":"Words deserted Tümönbay's mouth,"},{"id":"semetey-1-2013:p1065:b005:l038","ordinal":157491,"en":"And the staring light deserted Azhybay's eyes."}]
