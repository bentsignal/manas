{"id": "sayakbay-ms-current146:pdf038:l003", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 38, "folio": 421, "line_in_page": 3, "raw": "Жерге арбак жолуккан,", "text": "Жерге арбак жолуккан,", "en": "On earth he encountered a spirit,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The middle noun is provisionally read арбак.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf038:l004", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 38, "folio": 421, "line_in_page": 4, "raw": "Кара жер жуткан бурутка,", "text": "Кара жер жуткан бурутка,", "en": "To the Burut whom the black earth swallowed,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The final ethnonym is pale and provisionally read бурутка.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf038:l005", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 38, "folio": 421, "line_in_page": 5, "raw": "Кеттим туруп жан чыдайт,", "text": "Кеттим туруп жан чыдайт,", "en": "I have gone—yet the soul endures,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Several letters in the middle are faint; completion-first translation is provisional.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf038:l006", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 38, "folio": 421, "line_in_page": 6, "raw": "Кызыталак бу журтка,", "text": "Кызыталак бу журтка,", "en": "To this accursed people,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf038:l007", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 38, "folio": 421, "line_in_page": 7, "raw": "Сурап ага тон болгон,", "text": "Сурап ага тон болгон,", "en": "Having asked, it became a robe for him,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The first phrase and object are difficult; literal provisional rendering.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf038:l008", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 38, "folio": 421, "line_in_page": 8, "raw": "Суранганы койбогон,", "text": "Суранганы койбогон,", "en": "He did not cease from asking,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf038:l009", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 38, "folio": 421, "line_in_page": 9, "raw": "Кайза алганда ок болгон,", "text": "Кайза алганда ок болгон,", "en": "When he took the lance, it became an arrow,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "First weapon word is provisionally read кайза.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf038:l010", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 38, "folio": 421, "line_in_page": 10, "raw": "Караңгыда айдаса,", "text": "Караңгыда айдаса,", "en": "If he drove them in the darkness,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf038:l011", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 38, "folio": 421, "line_in_page": 11, "raw": "Кабылган сыңдуу жоо болгон,", "text": "Кабылган сыңдуу жоо болгон,", "en": "There was an enemy like one who had fallen upon them,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Middle word is faint and provisionally read сыңдуу.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf038:l012", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 38, "folio": 421, "line_in_page": 12, "raw": "Сенин сексен төрт болгон,", "text": "Сенин сексен төрт болгон,", "en": "Yours became eighty-four,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The numeral phrase is legible but its referent depends on preceding context.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf038:l013", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 38, "folio": 421, "line_in_page": 13, "raw": "Серпишкени мөөр болгон,", "text": "Серпишкени мөөр болгон,", "en": "What he struck against became a seal,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The first verb and noun are provisional.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf038:l014", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 38, "folio": 421, "line_in_page": 14, "raw": "Бастырганы чак болгон,", "text": "Бастырганы чак болгон,", "en": "What he made march was swift,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Final adjective is provisionally read чак.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf038:l015", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 38, "folio": 421, "line_in_page": 15, "raw": "Байкашканы даң болгон,", "text": "Байкашканы даң болгон,", "en": "What he observed became renowned,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Final noun is provisionally read даң.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf038:l016", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 38, "folio": 421, "line_in_page": 16, "raw": "Кызыталак буруттун,", "text": "Кызыталак буруттун,", "en": "Of the accursed Burut,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf038:l017", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 38, "folio": 421, "line_in_page": 17, "raw": "Бузуу деген жүрөгүң,", "text": "Бузуу деген жүрөгүң,", "en": "Your heart that is bent on destruction,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "First noun may be бузуу; translation follows that reading.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf038:l018", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 38, "folio": 421, "line_in_page": 18, "raw": "Өзү жүрөр тилиңде,", "text": "Өзү жүрөр тилиңде,", "en": "He himself goes upon your tongue,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Final noun is provisionally read тилиңде.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf038:l019", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 38, "folio": 421, "line_in_page": 19, "raw": "Ар дайым душман зилинде,", "text": "Ар дайым душман зилинде,", "en": "Always bearing the enemy’s rancor,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Opening phrase is faint; read by sense as Ар дайым.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf038:l020", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 38, "folio": 421, "line_in_page": 20, "raw": "Аркайган өзөн Ала-Тоо,", "text": "Аркайган өзөн Ала-Тоо,", "en": "The broad-valleyed Ala-Too,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Second word is provisionally read өзөн.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf038:l021", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 38, "folio": 421, "line_in_page": 21, "raw": "Аңырадай чалгып жер эмес,", "text": "Аңырадай чалгып жер эмес,", "en": "It is no land to sweep across like an open waste,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Opening simile and verb are difficult; provisional reading.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf038:l022", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 38, "folio": 421, "line_in_page": 22, "raw": "Ак калпактуу кыргыз журт,", "text": "Ак калпактуу кыргыз журт,", "en": "The white-kalpak Kyrgyz people,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf038:l023", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 38, "folio": 421, "line_in_page": 23, "raw": "Акырда биздин Кытайга,", "text": "Акырда биздин Кытайга,", "en": "In the end, against our Chinese realm,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Opening word is provisionally read Акырда.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf038:l024", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 38, "folio": 421, "line_in_page": 24, "raw": "Айтылбашы кончуу эл эмес,", "text": "Айтылбашы кончуу эл эмес,", "en": "They are no people whose settling goes unspoken,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The line is faint and the syntax remains uncertain.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf038:l025", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 38, "folio": 421, "line_in_page": 25, "raw": "Үч тайлак даяр кабырда,", "text": "Үч тайлак даяр кабырда,", "en": "Three young camels stand ready at the grave,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The noun кабырда is provisional; context is unclear.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf038:l026", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 38, "folio": 421, "line_in_page": 26, "raw": "Күйүт алган бугу жер,", "text": "Күйүт алган бугу жер,", "en": "A grieving land of the Bugu,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Final phrase is provisionally read бугу жер.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf038:l027", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 38, "folio": 421, "line_in_page": 27, "raw": "Кытайга душман зилинде,", "text": "Кытайга душман зилинде,", "en": "Bearing enmity toward the Chinese,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf038:l028", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 38, "folio": 421, "line_in_page": 28, "raw": "Ошо чыкты Кенен деп,", "text": "Ошо чыкты Кенен деп,", "en": "They say that Kenen has now arisen,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf038:l029", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 38, "folio": 421, "line_in_page": 29, "raw": "Кенендин колу белен деп,", "text": "Кенендин колу белен деп,", "en": "They say Kenen’s army stands ready,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf038:l030", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 38, "folio": 421, "line_in_page": 30, "raw": "Акылы артык, заары күч,", "text": "Акылы артык, заары күч,", "en": "His wisdom is surpassing, his fury strong,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf038:l031", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 38, "folio": 421, "line_in_page": 31, "raw": "Айласы журттан терең деп,", "text": "Айласы журттан терең деп,", "en": "They say his cunning is deeper than the people’s,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf038:l032", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 38, "folio": 421, "line_in_page": 32, "raw": "Эбегей, Көгөй эки кан,", "text": "Эбегей, Көгөй эки кан,", "en": "Ebegei and Kögöi, the two khans,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf038:l033", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 38, "folio": 421, "line_in_page": 33, "raw": "Эр болгону ал экөө,", "text": "Эр болгону ал экөө,", "en": "Those two were valiant men,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The participial wording is slightly faint; translation follows the visible manuscript variant.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf038:l034", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 38, "folio": 421, "line_in_page": 34, "raw": "Белгини колго баштаарбы,", "text": "Белгини колго баштаарбы,", "en": "Will they lead the standard into battle?", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The object may be белгини; колго is interpreted as “into the host/battle.”", "bbox": null}
{"id": "sayakbay-ms-current146:pdf038:l035", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 38, "folio": 421, "line_in_page": 35, "raw": "Кененге жороо болом деп,", "text": "Кененге жороо болом деп,", "en": "Saying, “I will become Kenen’s companion,”", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
