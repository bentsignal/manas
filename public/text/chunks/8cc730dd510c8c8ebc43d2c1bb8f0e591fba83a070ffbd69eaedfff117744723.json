[{"id":"seytek-2012:p0993:b004:l038","ordinal":373249,"en":"His gold and possessions"},{"id":"seytek-2012:p0993:b004:l039","ordinal":373250,"en":"The teeming people seized as spoil,"},{"id":"seytek-2012:p0993:b004:l040","ordinal":373251,"en":"Precious jewels of red gold—"},{"id":"seytek-2012:p0994:b002:l001","ordinal":373252,"en":"The grateful people seized them all,"},{"id":"seytek-2012:p0994:b002:l002","ordinal":373253,"en":"Until they lay in heaps like burial mounds."},{"id":"seytek-2012:p0994:b002:l003","ordinal":373254,"en":"Kuyaly’s vengeance was not sated;"},{"id":"seytek-2012:p0994:b002:l004","ordinal":373255,"en":"She too was a surpassing gray wolf."},{"id":"seytek-2012:p0994:b002:l005","ordinal":373256,"en":"Kuyaly performed a fearsome deed"},{"id":"seytek-2012:p0994:b002:l006","ordinal":373257,"en":"And issued her command."},{"id":"seytek-2012:p0994:b002:l007","ordinal":373258,"en":"The thousand wrestlers under her"},{"id":"seytek-2012:p0994:b002:l008","ordinal":373259,"en":"She now assembled."},{"id":"seytek-2012:p0994:b002:l009","ordinal":373260,"en":"She marched them back and forth,"},{"id":"seytek-2012:p0994:b002:l010","ordinal":373261,"en":"Then formed them into a long column."},{"id":"seytek-2012:p0994:b002:l011","ordinal":373262,"en":"From the countless wrestlers"},{"id":"seytek-2012:p0994:b002:l012","ordinal":373263,"en":"Kuyaly selected one,"},{"id":"seytek-2012:p0994:b002:l013","ordinal":373264,"en":"From the thousand wrestlers"},{"id":"seytek-2012:p0994:b002:l014","ordinal":373265,"en":"Kuyaly brought forth another."},{"id":"seytek-2012:p0994:b002:l015","ordinal":373266,"en":"One by one from every group"},{"id":"seytek-2012:p0994:b002:l016","ordinal":373267,"en":"Kuyaly chose them out."},{"id":"seytek-2012:p0994:b002:l017","ordinal":373268,"en":"When their number reached ninety,"},{"id":"seytek-2012:p0994:b002:l018","ordinal":373269,"en":"Now put the words in their proper place:"},{"id":"seytek-2012:p0994:b002:l019","ordinal":373270,"en":"“Troubled times have befallen us.”"},{"id":"seytek-2012:p0994:b002:l020","ordinal":373271,"en":"With bull necks and camel-like frames,"},{"id":"seytek-2012:p0994:b002:l021","ordinal":373272,"en":"Their struggling could destroy a life."},{"id":"seytek-2012:p0994:b002:l022","ordinal":373273,"en":"Some of the wrestlers there"},{"id":"seytek-2012:p0994:b002:l023","ordinal":373274,"en":"Were broad of chest but short in stature;"},{"id":"seytek-2012:p0994:b002:l024","ordinal":373275,"en":"Some wrestlers were such"},{"id":"seytek-2012:p0994:b002:l025","ordinal":373276,"en":"That their whole bodies seemed black stone."},{"id":"seytek-2012:p0994:b002:l026","ordinal":373277,"en":"Such were some of the wrestlers."},{"id":"seytek-2012:p0994:b002:l027","ordinal":373278,"en":"Their bristling mustaches"},{"id":"seytek-2012:p0994:b002:l028","ordinal":373279,"en":"Were like the hafts of battle-axes."},{"id":"seytek-2012:p0994:b002:l029","ordinal":373280,"en":"When you looked at some,"},{"id":"seytek-2012:p0994:b002:l030","ordinal":373281,"en":"Their finely fashioned noses"},{"id":"seytek-2012:p0994:b002:l031","ordinal":373282,"en":"Were like the sheaths of sabers."},{"id":"seytek-2012:p0994:b002:l032","ordinal":373283,"en":"When you looked at others,"},{"id":"seytek-2012:p0994:b002:l033","ordinal":373284,"en":"Their lower jaws hung loose,"},{"id":"seytek-2012:p0994:b002:l034","ordinal":373285,"en":"Like great leather sacks."},{"id":"seytek-2012:p0994:b002:l035","ordinal":373286,"en":"Some heroic wrestlers"},{"id":"seytek-2012:p0994:b002:l036","ordinal":373287,"en":"Were splendidly formed."},{"id":"seytek-2012:p0994:b002:l037","ordinal":373288,"en":"“Obey whatever you are told,”"},{"id":"seytek-2012:p0994:b002:l038","ordinal":373289,"en":"And each raised his noble head,"},{"id":"seytek-2012:p0994:b002:l039","ordinal":373290,"en":"Ready to perform his service."},{"id":"seytek-2012:p0994:b002:l040","ordinal":373291,"en":"If told to dam a river, they could shatter stone"},{"id":"seytek-2012:p0994:b003:l001","ordinal":373292,"en":"And turn the river from its course;"},{"id":"seytek-2012:p0994:b003:l002","ordinal":373293,"en":"Crushing all without raising their heads,"},{"id":"seytek-2012:p0994:b003:l003","ordinal":373294,"en":"They could grind stones into meal."},{"id":"seytek-2012:p0994:b003:l004","ordinal":373295,"en":"Such wrestlers were among them."},{"id":"seytek-2012:p0994:b003:l005","ordinal":373296,"en":"They had been born into this world"},{"id":"seytek-2012:p0994:b003:l006","ordinal":373297,"en":"And come, it is said, as wrestlers."},{"id":"seytek-2012:p0994:b003:l007","ordinal":373298,"en":"They had faced grievous, burdensome trials"},{"id":"seytek-2012:p0994:b003:l008","ordinal":373299,"en":"And endured much hardship, it is said."},{"id":"seytek-2012:p0994:b003:l009","ordinal":373300,"en":"They were stationed beneath the battle standard,"},{"id":"seytek-2012:p0994:b003:l010","ordinal":373301,"en":"Ready to tie the firmest knot."},{"id":"seytek-2012:p0994:b003:l011","ordinal":373302,"en":"They could swing mattocks with sweeping strokes,"},{"id":"seytek-2012:p0994:b003:l012","ordinal":373303,"en":"Fill their broad bellies,"},{"id":"seytek-2012:p0994:b003:l013","ordinal":373304,"en":"And sustain their mighty bodies."},{"id":"seytek-2012:p0994:b003:l014","ordinal":373305,"en":"She gathered ninety wrestlers,"},{"id":"seytek-2012:p0994:b003:l015","ordinal":373306,"en":"Choosing them from the strongest."},{"id":"seytek-2012:p0994:b003:l016","ordinal":373307,"en":"That infidel Sarybai"},{"id":"seytek-2012:p0994:b003:l017","ordinal":373308,"en":"Was made to pay his true account."},{"id":"seytek-2012:p0994:b003:l018","ordinal":373309,"en":"She had the ninety mighty wrestlers"},{"id":"seytek-2012:p0994:b003:l019","ordinal":373310,"en":"Hack his body into pieces,"},{"id":"seytek-2012:p0994:b003:l020","ordinal":373311,"en":"Making a great spectacle,"},{"id":"seytek-2012:p0994:b003:l021","ordinal":373312,"en":"And gather firewood from the forest."},{"id":"seytek-2012:p0994:b003:l022","ordinal":373313,"en":"To settle his true account,"},{"id":"seytek-2012:p0994:b003:l023","ordinal":373314,"en":"They piled it mountain-high and set it ablaze."},{"id":"seytek-2012:p0994:b003:l024","ordinal":373315,"en":"The contentious villain Sarybai,"},{"id":"seytek-2012:p0994:b003:l025","ordinal":373316,"en":"Who had shown his savagery,"},{"id":"seytek-2012:p0994:b003:l026","ordinal":373317,"en":"Was cast into the fire and burned."},{"id":"seytek-2012:p0994:b003:l027","ordinal":373318,"en":"They shouted the glad tidings,"},{"id":"seytek-2012:p0994:b003:l028","ordinal":373319,"en":"Burned him and scattered his ashes."},{"id":"seytek-2012:p0994:b003:l029","ordinal":373320,"en":"For having defeated Sarybai,"},{"id":"seytek-2012:p0994:b003:l030","ordinal":373321,"en":"Maiden Kuyaly and hero Seytek"},{"id":"seytek-2012:p0994:b003:l031","ordinal":373322,"en":"Had no regret at all;"},{"id":"seytek-2012:p0994:b003:l032","ordinal":373323,"en":"There was no regret that he had died."},{"id":"seytek-2012:p0994:b003:l033","ordinal":373324,"en":"Their wish had fallen into their hands,"},{"id":"seytek-2012:p0994:b003:l034","ordinal":373325,"en":"And fortune had entered their path."},{"id":"seytek-2012:p0994:b003:l035","ordinal":373326,"en":"The offspring of the honor-bound lion,"},{"id":"seytek-2012:p0994:b003:l036","ordinal":373327,"en":"Receiving a blessing from Baabedin,"},{"id":"seytek-2012:p0994:b003:l037","ordinal":373328,"en":"To follow the path of their lion forefather,"},{"id":"seytek-2012:p0994:b003:l038","ordinal":373329,"en":"Received the blessing, “Moon-hoofed one.”"},{"id":"seytek-2012:p0994:b003:l039","ordinal":373330,"en":"They summoned all the people,"},{"id":"seytek-2012:p0994:b003:l040","ordinal":373331,"en":"And for the infidel Khan Sarybai"},{"id":"seytek-2012:p0995:b002:l001","ordinal":373332,"en":"They pitched a royal encampment,"},{"id":"seytek-2012:p0995:b002:l002","ordinal":373333,"en":"With kumiss by day and maidens by night,"},{"id":"seytek-2012:p0995:b002:l003","ordinal":373334,"en":"And held revels through the night."},{"id":"seytek-2012:p0995:b002:l004","ordinal":373335,"en":"That was a land of summer pastures,"},{"id":"seytek-2012:p0995:b002:l005","ordinal":373336,"en":"And he was the lion who brought his people joy."},{"id":"seytek-2012:p0995:b002:l006","ordinal":373337,"en":"The people’s faces brightened;"},{"id":"seytek-2012:p0995:b002:l007","ordinal":373338,"en":"After suffering great humiliation,"},{"id":"seytek-2012:p0995:b002:l008","ordinal":373339,"en":"Being held as though doomed to misery,"},{"id":"seytek-2012:p0995:b002:l009","ordinal":373340,"en":"And grieving without consolation,"},{"id":"seytek-2012:p0995:b002:l010","ordinal":373341,"en":"They were delivered from Sarybai."},{"id":"seytek-2012:p0995:b002:l011","ordinal":373342,"en":"All the assembled people—"},{"id":"seytek-2012:p0995:b002:l012","ordinal":373343,"en":"Their venerable elders,"},{"id":"seytek-2012:p0995:b002:l013","ordinal":373344,"en":"Their sages and eloquent speakers,"},{"id":"seytek-2012:p0995:b002:l014","ordinal":373345,"en":"And their many capable men—"},{"id":"seytek-2012:p0995:b002:l015","ordinal":373346,"en":"Conceived a radiant plan"},{"id":"seytek-2012:p0995:b002:l016","ordinal":373347,"en":"And held a feast in honor"},{"id":"seytek-2012:p0995:b002:l017","ordinal":373348,"en":"Of Kuyaly and the hero Seytek."},{"id":"seytek-2012:p0995:b002:l018","ordinal":373349,"en":"“That infidel Sarybai"},{"id":"seytek-2012:p0995:b002:l019","ordinal":373350,"en":"Plundered brides at his pleasure,” they said."},{"id":"seytek-2012:p0995:b002:l020","ordinal":373351,"en":"When you looked to the farthest reaches,"},{"id":"seytek-2012:p0995:b002:l021","ordinal":373352,"en":"The clouds had vanished,"},{"id":"seytek-2012:p0995:b002:l022","ordinal":373353,"en":"The night was departing and dawn breaking."},{"id":"seytek-2012:p0995:b002:l023","ordinal":373354,"en":"He had no voice left to utter a sound,"},{"id":"seytek-2012:p0995:b002:l024","ordinal":373355,"en":"No hand left to stretch forth."},{"id":"seytek-2012:p0995:b002:l025","ordinal":373356,"en":"“We have given Sarybai his due,” they said;"},{"id":"seytek-2012:p0995:b002:l026","ordinal":373357,"en":"He had vanished from this world."},{"id":"seytek-2012:p0995:b002:l027","ordinal":373358,"en":"“God has granted what we desired,” they said,"},{"id":"seytek-2012:p0995:b002:l028","ordinal":373359,"en":"And the blessed Night of Power descended."},{"id":"seytek-2012:p0995:b002:l029","ordinal":373360,"en":"Allah Most High, the one God,"},{"id":"seytek-2012:p0995:b002:l030","ordinal":373361,"en":"Had now granted it to them."},{"id":"seytek-2012:p0995:b002:l031","ordinal":373362,"en":"The oppressor of the people was subdued,"},{"id":"seytek-2012:p0995:b002:l032","ordinal":373363,"en":"Light poured down upon mankind,"},{"id":"seytek-2012:p0995:b002:l033","ordinal":373364,"en":"And the heavens shone with radiance."},{"id":"seytek-2012:p0995:b002:l034","ordinal":373365,"en":"The grievous calamity and great turmoil"},{"id":"seytek-2012:p0995:b002:l035","ordinal":373366,"en":"Subsided when Sarybai died."},{"id":"seytek-2012:p0995:b002:l036","ordinal":373367,"en":"Ruinous fury disappeared,"},{"id":"seytek-2012:p0995:b002:l037","ordinal":373368,"en":"The people prospered in exultation,"},{"id":"seytek-2012:p0995:b002:l038","ordinal":373369,"en":"And order among the folk was restored."},{"id":"seytek-2012:p0995:b002:l039","ordinal":373370,"en":"Their thoughts turned toward progress,"},{"id":"seytek-2012:p0995:b003:l001","ordinal":373371,"en":"And the times encountered prosperity."},{"id":"seytek-2012:p0995:b003:l002","ordinal":373372,"en":"They scattered his ashes to the sky,"},{"id":"seytek-2012:p0995:b003:l003","ordinal":373373,"en":"And extinguished the scattered brands."},{"id":"seytek-2012:p0995:b003:l004","ordinal":373374,"en":"From this world they cleansed away"},{"id":"seytek-2012:p0995:b003:l005","ordinal":373375,"en":"The infidel entirely."},{"id":"seytek-2012:p0995:b003:l006","ordinal":373376,"en":"Their great desire was fulfilled,"},{"id":"seytek-2012:p0995:b003:l007","ordinal":373377,"en":"And death came to the great villain."},{"id":"seytek-2012:p0995:b003:l008","ordinal":373378,"en":"Goodness entered the world;"},{"id":"seytek-2012:p0995:b003:l009","ordinal":373379,"en":"The incurable sickness that had struck,"},{"id":"seytek-2012:p0995:b003:l010","ordinal":373380,"en":"The myriad arrows lodged in their ribs,"},{"id":"seytek-2012:p0995:b003:l011","ordinal":373381,"en":"Was healed and subsided."},{"id":"seytek-2012:p0995:b003:l012","ordinal":373382,"en":"Resentful brows relaxed,"},{"id":"seytek-2012:p0995:b003:l013","ordinal":373383,"en":"Their wretched anguish abated,"},{"id":"seytek-2012:p0995:b003:l014","ordinal":373384,"en":"And their moon-bright faces cleared."},{"id":"seytek-2012:p0995:b003:l015","ordinal":373385,"en":"The people clamored and held a feast;"},{"id":"seytek-2012:p0995:b003:l016","ordinal":373386,"en":"The wicked swine was gone,"},{"id":"seytek-2012:p0995:b003:l017","ordinal":373387,"en":"And order among the people was restored."},{"id":"seytek-2012:p0995:b003:l018","ordinal":373388,"en":"Sarybai had waged war"},{"id":"seytek-2012:p0995:b003:l019","ordinal":373389,"en":"For many months and many years,"},{"id":"seytek-2012:p0995:b003:l020","ordinal":373390,"en":"And they had suffered, held in misery."},{"id":"seytek-2012:p0995:b003:l021","ordinal":373391,"en":"On that day the multitude,"},{"id":"seytek-2012:p0995:b003:l022","ordinal":373392,"en":"From the dire and savage affliction,"},{"id":"seytek-2012:p0995:b003:l023","ordinal":373393,"en":"Through the support of Seytek"},{"id":"seytek-2012:p0995:b003:l024","ordinal":373394,"en":"And the heroism of Kuyaly,"},{"id":"seytek-2012:p0995:b003:l025","ordinal":373395,"en":"Were delivered from Sarybai."},{"id":"seytek-2012:p0995:b003:l026","ordinal":373396,"en":"The people settled down in peace,"},{"id":"seytek-2012:p0995:b003:l027","ordinal":373397,"en":"Lying at ease upon their well-fed flanks."},{"id":"seytek-2012:p0995:b003:l028","ordinal":373398,"en":"They migrated freely to mountain pastures,"},{"id":"seytek-2012:p0995:b003:l029","ordinal":373399,"en":"And settled upon the foothills."},{"id":"seytek-2012:p0995:b003:l030","ordinal":373400,"en":"They lived according to their will,"},{"id":"seytek-2012:p0995:b003:l031","ordinal":373401,"en":"Hunting deer whenever they grew bored."},{"id":"seytek-2012:p0995:b003:l032","ordinal":373402,"en":"When the multitude was not weary,"},{"id":"seytek-2012:p0995:b003:l033","ordinal":373403,"en":"They played freely together,"},{"id":"seytek-2012:p0995:b003:l034","ordinal":373404,"en":"Rode young horses and flew hunting birds,"},{"id":"seytek-2012:p0995:b003:l035","ordinal":373405,"en":"Marked out the ordo field and cast their knucklebones,"},{"id":"seytek-2012:p0995:b003:l036","ordinal":373406,"en":"And won surpassing honor."},{"id":"seytek-2012:p0995:b003:l037","ordinal":373407,"en":"Amid grand and lively festivities,"},{"id":"seytek-2012:p0995:b003:l038","ordinal":373408,"en":"They raced horses and young steeds,"},{"id":"seytek-2012:p0995:b003:l039","ordinal":373409,"en":"Along the banks of broad Talas."},{"id":"seytek-2012:p0996:b002:l001","ordinal":373410,"en":"On the banks of broad Talas,"},{"id":"seytek-2012:p0996:b002:l002","ordinal":373411,"en":"Below Tört-Kül,"},{"id":"seytek-2012:p0996:b002:l003","ordinal":373412,"en":"In the garden once planted"},{"id":"seytek-2012:p0996:b002:l004","ordinal":373413,"en":"By the gray wolf Prince Manas,"},{"id":"seytek-2012:p0996:b002:l005","ordinal":373414,"en":"The son inherited from his father"},{"id":"seytek-2012:p0996:b002:l006","ordinal":373415,"en":"The throne upon which he sat,"},{"id":"seytek-2012:p0996:b002:l007","ordinal":373416,"en":"And his palace was of gold."},{"id":"seytek-2012:p0996:b002:l008","ordinal":373417,"en":"When they saw Aichürök,"},{"id":"seytek-2012:p0996:b002:l009","ordinal":373418,"en":"At the edge of the open steppe,"},{"id":"seytek-2012:p0996:b002:l010","ordinal":373419,"en":"Near the seer’s dark cave,"},{"id":"seytek-2012:p0996:b002:l011","ordinal":373420,"en":"Before the golden throne,"},{"id":"seytek-2012:p0996:b002:l012","ordinal":373421,"en":"The people swarmed like teeming worms"},{"id":"seytek-2012:p0996:b002:l013","ordinal":373422,"en":"And gathered together."},{"id":"seytek-2012:p0996:b002:l014","ordinal":373423,"en":"Some wore wound turbans,"},{"id":"seytek-2012:p0996:b002:l015","ordinal":373424,"en":"And prayed, crying, “My God!”"},{"id":"seytek-2012:p0996:b002:l016","ordinal":373425,"en":"They had full, ripened grain"},{"id":"seytek-2012:p0996:b002:l017","ordinal":373426,"en":"And herds of all four kinds."},{"id":"seytek-2012:p0996:b002:l018","ordinal":373427,"en":"They wore mottled robes,"},{"id":"seytek-2012:p0996:b002:l019","ordinal":373428,"en":"And did not roam about wrestling."},{"id":"seytek-2012:p0996:b002:l020","ordinal":373429,"en":"They crowded in from every side,"},{"id":"seytek-2012:p0996:b002:l021","ordinal":373430,"en":"Their blue felt caps trampled underfoot."},{"id":"seytek-2012:p0996:b002:l022","ordinal":373431,"en":"From their encampments their livestock covered the green,"},{"id":"seytek-2012:p0996:b002:l023","ordinal":373432,"en":"And the people came in mounted companies."},{"id":"seytek-2012:p0996:b002:l024","ordinal":373433,"en":"People of every kind arrived."},{"id":"seytek-2012:p0996:b002:l025","ordinal":373434,"en":"The reason the people came was this:"},{"id":"seytek-2012:p0996:b002:l026","ordinal":373435,"en":"Sarybai had been consigned to the fire,"},{"id":"seytek-2012:p0996:b002:l027","ordinal":373436,"en":"And the long-suffering people"},{"id":"seytek-2012:p0996:b002:l028","ordinal":373437,"en":"Were delivered on that day."},{"id":"seytek-2012:p0996:b002:l029","ordinal":373438,"en":"Their moonlike faces brightened,"},{"id":"seytek-2012:p0996:b002:l030","ordinal":373439,"en":"Their pounding hearts grew calm,"},{"id":"seytek-2012:p0996:b002:l031","ordinal":373440,"en":"And true contentment filled them;"},{"id":"seytek-2012:p0996:b002:l032","ordinal":373441,"en":"Their faces truly brightened."},{"id":"seytek-2012:p0996:b002:l033","ordinal":373442,"en":"The stored and guarded treasury,"},{"id":"seytek-2012:p0996:b002:l034","ordinal":373443,"en":"To every one of the people,"},{"id":"seytek-2012:p0996:b002:l035","ordinal":373444,"en":"Because fierce Sarybai was dead,"},{"id":"seytek-2012:p0996:b002:l036","ordinal":373445,"en":"They scattered without withholding a thing."},{"id":"seytek-2012:p0996:b002:l037","ordinal":373446,"en":"Dead fires were kindled anew,"},{"id":"seytek-2012:p0996:b002:l038","ordinal":373447,"en":"The dying returned to life,"},{"id":"seytek-2012:p0996:b002:l039","ordinal":373448,"en":"The severed were joined,"},{"id":"seytek-2012:p0996:b002:l040","ordinal":373449,"en":"And the scattered were gathered."},{"id":"seytek-2012:p0996:b003:l001","ordinal":373450,"en":"Burning hearts grew calm,"},{"id":"seytek-2012:p0996:b003:l002","ordinal":373451,"en":"Furrowed brows relaxed,"},{"id":"seytek-2012:p0996:b003:l003","ordinal":373452,"en":"Their painful ailments subsided,"},{"id":"seytek-2012:p0996:b003:l004","ordinal":373453,"en":"And the people’s spirits rose."},{"id":"seytek-2012:p0996:b003:l005","ordinal":373454,"en":"Multitudes of every kind arrived,"},{"id":"seytek-2012:p0996:b003:l006","ordinal":373455,"en":"Many coming from every tribe."},{"id":"seytek-2012:p0996:b003:l007","ordinal":373456,"en":"They devised wonders beyond imagining,"},{"id":"seytek-2012:p0996:b003:l008","ordinal":373457,"en":"As though surpassing the moonlit world."},{"id":"seytek-2012:p0996:b003:l009","ordinal":373458,"en":"The great feast they held then"},{"id":"seytek-2012:p0996:b003:l010","ordinal":373459,"en":"Seemed to cover the face of the earth."},{"id":"seytek-2012:p0996:b003:l011","ordinal":373460,"en":"They heaped up glowing red embers,"},{"id":"seytek-2012:p0996:b003:l012","ordinal":373461,"en":"And the encamped people voiced their grievances."},{"id":"seytek-2012:p0996:b003:l013","ordinal":373462,"en":"Those who knew and those who had seen"},{"id":"seytek-2012:p0996:b003:l014","ordinal":373463,"en":"Heard it from long-eared elders;"},{"id":"seytek-2012:p0996:b003:l015","ordinal":373464,"en":"From all these countless people,"},{"id":"seytek-2012:p0996:b003:l016","ordinal":373465,"en":"A great assembly formed,"},{"id":"seytek-2012:p0996:b003:l017","ordinal":373466,"en":"And the uproar split the sky."},{"id":"seytek-2012:p0996:b003:l018","ordinal":373467,"en":"Dust flew into the heavens"},{"id":"seytek-2012:p0996:b003:l019","ordinal":373468,"en":"As the people gathered in throngs."},{"id":"seytek-2012:p0996:b003:l020","ordinal":373469,"en":"It became a most joyous feast,"},{"id":"seytek-2012:p0996:b003:l021","ordinal":373470,"en":"And the grateful people could not rejoice enough."},{"id":"seytek-2012:p0996:b003:l022","ordinal":373471,"en":"“When Sarybai held us captive,"},{"id":"seytek-2012:p0996:b003:l023","ordinal":373472,"en":"Unable to stir from one place,"},{"id":"seytek-2012:p0996:b003:l024","ordinal":373473,"en":"We endured six or seven months;"},{"id":"seytek-2012:p0996:b003:l025","ordinal":373474,"en":"We suffered exceedingly,"},{"id":"seytek-2012:p0996:b003:l026","ordinal":373475,"en":"All because of Sarybai,” they said."},{"id":"seytek-2012:p0996:b003:l027","ordinal":373476,"en":"From Sarybai’s venom"},{"id":"seytek-2012:p0996:b003:l028","ordinal":373477,"en":"Red-tailed riding camels died,"},{"id":"seytek-2012:p0996:b003:l029","ordinal":373478,"en":"And the finest red-necked champions,"},{"id":"seytek-2012:p0996:b003:l030","ordinal":373479,"en":"Souls whose like could not be found, died."},{"id":"seytek-2012:p0996:b003:l031","ordinal":373480,"en":"He fought to possess this Talas;"},{"id":"seytek-2012:p0996:b003:l032","ordinal":373481,"en":"Many men and many lions"},{"id":"seytek-2012:p0996:b003:l033","ordinal":373482,"en":"He drove away, estranged from their people."},{"id":"seytek-2012:p0996:b003:l034","ordinal":373483,"en":"He extinguished the burning fire"},{"id":"seytek-2012:p0996:b003:l035","ordinal":373484,"en":"And carried off the plunder in one night;"},{"id":"seytek-2012:p0996:b003:l036","ordinal":373485,"en":"Thus he brought the people to ruin."},{"id":"seytek-2012:p0996:b003:l037","ordinal":373486,"en":"He made mankind grieve,"},{"id":"seytek-2012:p0996:b003:l038","ordinal":373487,"en":"Made every back stoop,"},{"id":"seytek-2012:p0996:b003:l039","ordinal":373488,"en":"And made dear eyes bulge with anguish."},{"id":"seytek-2012:p0996:b003:l040","ordinal":373489,"en":"He savaged the courageous"},{"id":"seytek-2012:p0997:b002:l001","ordinal":373490,"en":"And tore at them without sparing a soul."},{"id":"seytek-2012:p0997:b002:l002","ordinal":373491,"en":"The cur took them as plunder"},{"id":"seytek-2012:p0997:b002:l003","ordinal":373492,"en":"And uprooted the settled folk."},{"id":"seytek-2012:p0997:b002:l004","ordinal":373493,"en":"He spread strife and turmoil through the world"},{"id":"seytek-2012:p0997:b002:l005","ordinal":373494,"en":"And left souls burning in his wake."},{"id":"seytek-2012:p0997:b002:l006","ordinal":373495,"en":"At the slightest blink he took a life,"},{"id":"seytek-2012:p0997:b002:l007","ordinal":373496,"en":"Sarybai, shaped like a wild boar."},{"id":"seytek-2012:p0997:b002:l008","ordinal":373497,"en":"Upon hero Kuyaly and Seytek"},{"id":"seytek-2012:p0997:b002:l009","ordinal":373498,"en":"Descended the people’s fortune and blessing."},{"id":"seytek-2012:p0997:b002:l010","ordinal":373499,"en":"The torment inflicted by Sarybai"},{"id":"seytek-2012:p0997:b002:l011","ordinal":373500,"en":"Became a mark of infamy carved in stone."},{"id":"seytek-2012:p0997:b002:l012","ordinal":373501,"en":"The madman burned in the fire;"},{"id":"seytek-2012:p0997:b002:l013","ordinal":373502,"en":"The ruin he had brought upon the people"},{"id":"seytek-2012:p0997:b002:l014","ordinal":373503,"en":"Had become a pestilent sickness,"},{"id":"seytek-2012:p0997:b002:l015","ordinal":373504,"en":"Oppressing many people,"}]
