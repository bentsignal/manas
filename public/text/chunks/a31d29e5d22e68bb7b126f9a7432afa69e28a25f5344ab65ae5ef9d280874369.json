[{"id":"manas-2010:p0817:b001:l022","ordinal":36097,"en":"If you should regret it, Azhybay,"},{"id":"manas-2010:p0817:b001:l023","ordinal":36098,"en":"Leave two of mine, take one;"},{"id":"manas-2010:p0817:b001:l024","ordinal":36099,"en":"Leave my child, take my wife!"},{"id":"manas-2010:p0817:b001:l025","ordinal":36100,"en":"Know that this is what I say."},{"id":"manas-2010:p0817:b001:l026","ordinal":36101,"en":"My lion Azhy, heed my words."},{"id":"manas-2010:p0817:b001:l027","ordinal":36102,"en":"If you travel hungry,"},{"id":"manas-2010:p0817:b001:l028","ordinal":36103,"en":"Pour my blood into a leather flask and take it!"},{"id":"manas-2010:p0817:b001:l029","ordinal":36104,"en":"If that does not satisfy you,"},{"id":"manas-2010:p0817:b001:l030","ordinal":36105,"en":"Take the life within my breast!"},{"id":"manas-2010:p0817:b001:l031","ordinal":36106,"en":"I have sought refuge in you, Manas;"},{"id":"manas-2010:p0817:b001:l032","ordinal":36107,"en":"Today I entered your faith."},{"id":"manas-2010:p0817:b001:l033","ordinal":36108,"en":"Seeking anew, I found a warrior;"},{"id":"manas-2010:p0817:b001:l034","ordinal":36109,"en":"In a new place I found land."},{"id":"manas-2010:p0817:b001:l035","ordinal":36110,"en":"Opening the Quran, I learned its writing;"},{"id":"manas-2010:p0817:b001:l036","ordinal":36111,"en":"I learned God's name by heart."},{"id":"manas-2010:p0817:b001:l037","ordinal":36112,"en":"I have a beauty of grave disposition,"},{"id":"manas-2010:p0817:b001:l038","ordinal":36113,"en":"For your precious lion Manas,"},{"id":"manas-2010:p0817:b001:l039","ordinal":36114,"en":"I have a worthy daughter."},{"id":"manas-2010:p0817:b001:l040","ordinal":36115,"en":"Her waist like a sheath, her face like the moon,"},{"id":"manas-2010:p0817:b001:l041","ordinal":36116,"en":"A marvel to those who see her,"},{"id":"manas-2010:p0817:b001:l042","ordinal":36117,"en":"Grown to walk like a doe,"},{"id":"manas-2010:p0818:b001:l001","ordinal":36118,"en":"Her hair winding about her waist,"},{"id":"manas-2010:p0818:b001:l002","ordinal":36119,"en":"Grown like a deer,"},{"id":"manas-2010:p0818:b001:l003","ordinal":36120,"en":"Her hair winding about her feet,"},{"id":"manas-2010:p0818:b001:l004","ordinal":36121,"en":"Lithe as a lynx,"},{"id":"manas-2010:p0818:b001:l005","ordinal":36122,"en":"She was given the name Akylay."},{"id":"manas-2010:p0818:b001:l006","ordinal":36123,"en":"Shooruk's daughter Akylay—"},{"id":"manas-2010:p0818:b001:l007","ordinal":36124,"en":"How she rustles, wondrous girl!"},{"id":"manas-2010:p0818:b001:l008","ordinal":36125,"en":"Look at silk, look at her hair;"},{"id":"manas-2010:p0818:b001:l009","ordinal":36126,"en":"Look at an apple, look at her head."},{"id":"manas-2010:p0818:b001:l010","ordinal":36127,"en":"Do not menace my people;"},{"id":"manas-2010:p0818:b001:l011","ordinal":36128,"en":"My own daughter Akylay"},{"id":"manas-2010:p0818:b001:l012","ordinal":36129,"en":"Is worthy of your Manas!’"},{"id":"manas-2010:p0818:b001:l013","ordinal":36130,"en":"His people wept, reciting the creed,"},{"id":"manas-2010:p0818:b001:l014","ordinal":36131,"en":"Entered the faith with cries."},{"id":"manas-2010:p0818:b001:l015","ordinal":36132,"en":"He ran to his palace,"},{"id":"manas-2010:p0818:b001:l016","ordinal":36133,"en":"His women, his beauties—"},{"id":"manas-2010:p0818:b001:l017","ordinal":36134,"en":"He gathered them all, leaving none,"},{"id":"manas-2010:p0818:b001:l018","ordinal":36135,"en":"His beautiful dark-eyed daughters."},{"id":"manas-2010:p0818:b001:l019","ordinal":36136,"en":"A sight to satisfy desire,"},{"id":"manas-2010:p0818:b001:l020","ordinal":36137,"en":"Lest the scorching sun strike them,"},{"id":"manas-2010:p0818:b001:l021","ordinal":36138,"en":"He had built white palaces."},{"id":"manas-2010:p0818:b001:l022","ordinal":36139,"en":"The stately white palace"},{"id":"manas-2010:p0818:b001:l023","ordinal":36140,"en":"Was wonderfully cool."},{"id":"manas-2010:p0818:b001:l024","ordinal":36141,"en":"Khan Shooruk, a khan known to the people;"},{"id":"manas-2010:p0818:b001:l025","ordinal":36142,"en":"Khan Shooruk's daughter Akylay—"},{"id":"manas-2010:p0818:b001:l026","ordinal":36143,"en":"How she rustles, wondrous girl!"},{"id":"manas-2010:p0818:b001:l027","ordinal":36144,"en":"Peacock tail feathers"},{"id":"manas-2010:p0818:b001:l028","ordinal":36145,"en":"She wore in ninety patterns."},{"id":"manas-2010:p0818:b001:l029","ordinal":36146,"en":"What she wore upon her head"},{"id":"manas-2010:p0818:b001:l030","ordinal":36147,"en":"Was a skullcap made of gold."},{"id":"manas-2010:p0818:b001:l031","ordinal":36148,"en":"Whoever saw her marveled:"},{"id":"manas-2010:p0818:b001:l032","ordinal":36149,"en":"Shooruk's daughter, the minx!"},{"id":"manas-2010:p0818:b001:l033","ordinal":36150,"en":"Her beauty, her graceful figure,"},{"id":"manas-2010:p0818:b001:l034","ordinal":36151,"en":"Seemed beyond human measure—"},{"id":"manas-2010:p0818:b001:l035","ordinal":36152,"en":"Akylay's splendor."},{"id":"manas-2010:p0818:b001:l036","ordinal":36153,"en":"Her down was like an owl's feathers,"},{"id":"manas-2010:p0818:b001:l037","ordinal":36154,"en":"Her voice like a nightingale's voice."},{"id":"manas-2010:p0818:b001:l038","ordinal":36155,"en":"Her teeth gleamed white,"},{"id":"manas-2010:p0818:b001:l039","ordinal":36156,"en":"She smiled, radiant,"},{"id":"manas-2010:p0818:b001:l040","ordinal":36157,"en":"Thimble-mouthed, camel-eyed;"},{"id":"manas-2010:p0818:b001:l041","ordinal":36158,"en":"Every one of them had dark eyes."},{"id":"manas-2010:p0818:b001:l042","ordinal":36159,"en":"At that hapless one's beauty,"},{"id":"manas-2010:p0819:b001:l001","ordinal":36160,"en":"No mortal could remain unmoved."},{"id":"manas-2010:p0819:b001:l002","ordinal":36161,"en":"To blood-drinking Manas himself,"},{"id":"manas-2010:p0819:b001:l003","ordinal":36162,"en":"With Akylay at their head,"},{"id":"manas-2010:p0819:b001:l004","ordinal":36163,"en":"He offered his ladies, they say."},{"id":"manas-2010:p0819:b001:l005","ordinal":36164,"en":"Taking gold coins loaded on elephants,"},{"id":"manas-2010:p0819:b001:l006","ordinal":36165,"en":"Taking beauties without turning back,"},{"id":"manas-2010:p0819:b001:l007","ordinal":36166,"en":"With Akylay at their head,"},{"id":"manas-2010:p0819:b001:l008","ordinal":36167,"en":"From Khan Shooruk's people"},{"id":"manas-2010:p0819:b001:l009","ordinal":36168,"en":"Taking eighty beautiful girls,"},{"id":"manas-2010:p0819:b001:l010","ordinal":36169,"en":"Raiding and devastating the Kalcha,"},{"id":"manas-2010:p0819:b001:l011","ordinal":36170,"en":"Magnanimous Manas the leopard"},{"id":"manas-2010:p0819:b001:l012","ordinal":36171,"en":"Showed the people his lion prowess."},{"id":"manas-2010:p0819:b001:l013","ordinal":36172,"en":"The appointed time was forty-one days,"},{"id":"manas-2010:p0819:b001:l014","ordinal":36173,"en":"To stay as a guest before returning."},{"id":"manas-2010:p0819:b001:l015","ordinal":36174,"en":"To satisfy his desire abundantly,"},{"id":"manas-2010:p0819:b001:l016","ordinal":36175,"en":"They brought the blue-maned warrior"},{"id":"manas-2010:p0819:b001:l017","ordinal":36176,"en":"Into a palace with a strong enclosure."},{"id":"manas-2010:p0819:b001:l018","ordinal":36177,"en":"For his feast they slaughtered ninety beasts,"},{"id":"manas-2010:p0819:b001:l019","ordinal":36178,"en":"With many games and entertainments,"},{"id":"manas-2010:p0819:b001:l020","ordinal":36179,"en":"Setting out wealth in bales."},{"id":"manas-2010:p0819:b001:l021","ordinal":36180,"en":"They drank spirits and homemade grape wine."},{"id":"manas-2010:p0819:b001:l022","ordinal":36181,"en":"At Akylay's wedding feast,"},{"id":"manas-2010:p0819:b001:l023","ordinal":36182,"en":"The people of India mingled."},{"id":"manas-2010:p0819:b001:l024","ordinal":36183,"en":"While your precious Manas was there,"},{"id":"manas-2010:p0819:b001:l025","ordinal":36184,"en":"All the forty companions,"},{"id":"manas-2010:p0819:b001:l026","ordinal":36185,"en":"Those dear souls, enjoyed themselves."},{"id":"manas-2010:p0819:b001:l027","ordinal":36186,"en":"Showing her rump like a wild ewe,"},{"id":"manas-2010:p0819:b001:l028","ordinal":36187,"en":"The beauty among the girls then,"},{"id":"manas-2010:p0819:b001:l029","ordinal":36188,"en":"Displaying her white breasts—"},{"id":"manas-2010:p0819:b001:l030","ordinal":36189,"en":"Man, Shooruk's daughter Akylay"},{"id":"manas-2010:p0819:b001:l031","ordinal":36190,"en":"Looked like a fairy-born beauty."},{"id":"manas-2010:p0819:b001:l032","ordinal":36191,"en":"Each time the blue-maned warrior saw her,"},{"id":"manas-2010:p0819:b001:l033","ordinal":36192,"en":"His heart was sorely stirred."},{"id":"manas-2010:p0819:b001:l034","ordinal":36193,"en":"Shooruk's daughter Akylay,"},{"id":"manas-2010:p0819:b001:l035","ordinal":36194,"en":"In the blood-drinking lion's eyes,"},{"id":"manas-2010:p0819:b001:l036","ordinal":36195,"en":"Looked like a fairy-born beauty."},{"id":"manas-2010:p0819:b001:l037","ordinal":36196,"en":"Marvels, diversions, boisterous games—"},{"id":"manas-2010:p0819:b001:l038","ordinal":36197,"en":"All the warriors took part now."},{"id":"manas-2010:p0819:b001:l039","ordinal":36198,"en":"Your saintly elder, warrior Bakay,"},{"id":"manas-2010:p0819:b001:l040","ordinal":36199,"en":"That beautiful Akylay"},{"id":"manas-2010:p0819:b001:l041","ordinal":36200,"en":"Now married to Manas."},{"id":"manas-2010:p0819:b001:l042","ordinal":36201,"en":"The unmarried companions"},{"id":"manas-2010:p0820:b001:l001","ordinal":36202,"en":"Took girls of unsurpassed beauty,"},{"id":"manas-2010:p0820:b001:l002","ordinal":36203,"en":"Took gold coins loaded on elephants,"},{"id":"manas-2010:p0820:b001:l003","ordinal":36204,"en":"Took a thousand dark-eyed girls,"},{"id":"manas-2010:p0820:b001:l004","ordinal":36205,"en":"Took gold, goods and riches."},{"id":"manas-2010:p0820:b001:l005","ordinal":36206,"en":"The forty companions could not load it all."},{"id":"manas-2010:p0820:b001:l006","ordinal":36207,"en":"They took girls as their spoils,"},{"id":"manas-2010:p0820:b001:l007","ordinal":36208,"en":"Broke in and took the city."},{"id":"manas-2010:p0820:b001:l008","ordinal":36209,"en":"His name was Khan Shooruk."},{"id":"manas-2010:p0820:b001:l009","ordinal":36210,"en":"Its young and its old,"},{"id":"manas-2010:p0820:b001:l010","ordinal":36211,"en":"They made them all Muslims."},{"id":"manas-2010:p0820:b001:l011","ordinal":36212,"en":"Showing the warrior's prowess openly,"},{"id":"manas-2010:p0820:b001:l012","ordinal":36213,"en":"The renowned Kalcha, Khan Shooruk,"},{"id":"manas-2010:p0820:b001:l013","ordinal":36214,"en":"They faced and brought into the faith,"},{"id":"manas-2010:p0820:b001:l014","ordinal":36215,"en":"Turned his face toward them and pulled him in."},{"id":"manas-2010:p0820:b001:l015","ordinal":36216,"en":"Sending his warriors and champions"},{"id":"manas-2010:p0820:b001:l016","ordinal":36217,"en":"Across the face of the earth,"},{"id":"manas-2010:p0820:b001:l017","ordinal":36218,"en":"Your lion Manas, the blue-maned warrior,"},{"id":"manas-2010:p0820:b001:l018","ordinal":36219,"en":"Made each place he reached submit."},{"id":"manas-2010:p0820:b001:l019","ordinal":36220,"en":"His fortune was complete,"},{"id":"manas-2010:p0820:b001:l020","ordinal":36221,"en":"His fame was heard among the people."},{"id":"manas-2010:p0820:b001:l021","ordinal":36222,"en":"A lion protected by Shay,"},{"id":"manas-2010:p0820:b001:l022","ordinal":36223,"en":"He fattened his horses, arranging matters,"},{"id":"manas-2010:p0820:b001:l023","ordinal":36224,"en":"Made his single self into forty."},{"id":"manas-2010:p0820:b001:l024","ordinal":36225,"en":"The blood-drinker born a leopard—"},{"id":"manas-2010:p0820:b001:l025","ordinal":36226,"en":"The enemies he charged were shattered."},{"id":"manas-2010:p0820:b001:l026","ordinal":36227,"en":"Such was the blood-drinker's way:"},{"id":"manas-2010:p0820:b001:l027","ordinal":36228,"en":"His valor became known."},{"id":"manas-2010:p0820:b001:l028","ordinal":36229,"en":"Taking a wife, establishing a household,"},{"id":"manas-2010:p0820:b001:l029","ordinal":36230,"en":"He turned back then."},{"id":"manas-2010:p0820:b001:l030","ordinal":36231,"en":"The wife Manas took"},{"id":"manas-2010:p0820:b001:l031","ordinal":36232,"en":"Was Shooruk's daughter Akylay—"},{"id":"manas-2010:p0820:b001:l032","ordinal":36233,"en":"How she rustles, wondrous girl!"},{"id":"manas-2010:p0820:b001:l033","ordinal":36234,"en":"Magnanimous Manas traveled on,"},{"id":"manas-2010:p0820:b001:l034","ordinal":36235,"en":"Traveling far, sparing no horses,"},{"id":"manas-2010:p0820:b001:l035","ordinal":36236,"en":"Skirting the Maymun desert,"},{"id":"manas-2010:p0820:b001:l036","ordinal":36237,"en":"All his choice steeds"},{"id":"manas-2010:p0820:b001:l037","ordinal":36238,"en":"Being shod anew."},{"id":"manas-2010:p0820:b001:l038","ordinal":36239,"en":"Wealth surged in waves to the eye."},{"id":"manas-2010:p0820:b001:l039","ordinal":36240,"en":"Wherever the blue-maned warrior went,"},{"id":"manas-2010:p0820:b001:l040","ordinal":36241,"en":"There were games and entertainment."},{"id":"manas-2010:p0820:b001:l041","ordinal":36242,"en":"Where the warriors camped,"},{"id":"manas-2010:p0820:b001:l042","ordinal":36243,"en":"If bored, they shot roe deer;"},{"id":"manas-2010:p0821:b001:l001","ordinal":36244,"en":"If not bored, then"},{"id":"manas-2010:p0821:b001:l002","ordinal":36245,"en":"They played at wrestling."},{"id":"manas-2010:p0821:b001:l003","ordinal":36246,"en":"When the forty companions grew excited,"},{"id":"manas-2010:p0821:b001:l004","ordinal":36247,"en":"They played the hopping game."},{"id":"manas-2010:p0821:b001:l005","ordinal":36248,"en":"Untroubled, without a stir,"},{"id":"manas-2010:p0821:b001:l006","ordinal":36249,"en":"They stayed there playing."},{"id":"manas-2010:p0821:b001:l007","ordinal":36250,"en":"Over ridges shaped like saddle backs"},{"id":"manas-2010:p0821:b001:l008","ordinal":36251,"en":"They bent and crossed."},{"id":"manas-2010:p0821:b001:l009","ordinal":36252,"en":"Old Bakay the falcon,"},{"id":"manas-2010:p0821:b001:l010","ordinal":36253,"en":"The saint who had seen many lands,"},{"id":"manas-2010:p0821:b001:l011","ordinal":36254,"en":"Shouted to the mighty warriors,"},{"id":"manas-2010:p0821:b001:l012","ordinal":36255,"en":"Called the mighty warriors:"},{"id":"manas-2010:p0821:b001:l013","ordinal":36256,"en":"‘Forty mighty warriors led by Manas,"},{"id":"manas-2010:p0821:b001:l014","ordinal":36257,"en":"Come all together, leaving none behind!"},{"id":"manas-2010:p0821:b001:l015","ordinal":36258,"en":"At the world's far end, Zhelpinish—"},{"id":"manas-2010:p0821:b001:l016","ordinal":36259,"en":"When I was in Zhelpinish,"},{"id":"manas-2010:p0821:b001:l017","ordinal":36260,"en":"Manas appeared in my dream."},{"id":"manas-2010:p0821:b001:l018","ordinal":36261,"en":"I wore my horse to exhaustion,"},{"id":"manas-2010:p0821:b001:l019","ordinal":36262,"en":"The four corners of the round world"},{"id":"manas-2010:p0821:b001:l020","ordinal":36263,"en":"I circled four times."},{"id":"manas-2010:p0821:b001:l021","ordinal":36264,"en":"Where my gray steed had not trodden—"},{"id":"manas-2010:p0821:b001:l022","ordinal":36265,"en":"Seeking the blue-maned warrior without finding him,"},{"id":"manas-2010:p0821:b001:l023","ordinal":36266,"en":"Not a single place remained."},{"id":"manas-2010:p0821:b001:l024","ordinal":36267,"en":"That your elder Bakay had not seen—"},{"id":"manas-2010:p0821:b001:l025","ordinal":36268,"en":"Not a single people remained."},{"id":"manas-2010:p0821:b001:l026","ordinal":36269,"en":"As I searched the face of the earth,"},{"id":"manas-2010:p0821:b001:l027","ordinal":36270,"en":"I grew headstrong in my valor."},{"id":"manas-2010:p0821:b001:l028","ordinal":36271,"en":"Their battle cry was “Generous lineage”:"},{"id":"manas-2010:p0821:b001:l029","ordinal":36272,"en":"I encountered the Teke."},{"id":"manas-2010:p0821:b001:l030","ordinal":36273,"en":"Zhanaaly and Karach were brothers,"},{"id":"manas-2010:p0821:b001:l031","ordinal":36274,"en":"Khans of those Turkmen."},{"id":"manas-2010:p0821:b001:l032","ordinal":36275,"en":"Karach's daughter Körpöyan"},{"id":"manas-2010:p0821:b001:l033","ordinal":36276,"en":"With your lion elder Bakay"},{"id":"manas-2010:p0821:b001:l034","ordinal":36277,"en":"She was a woman in love."},{"id":"manas-2010:p0821:b001:l035","ordinal":36278,"en":"Gold and goldwork by the pood"},{"id":"manas-2010:p0821:b001:l036","ordinal":36279,"en":"I had loaded on camels."},{"id":"manas-2010:p0821:b001:l037","ordinal":36280,"en":"According to Muslim law,"},{"id":"manas-2010:p0821:b001:l038","ordinal":36281,"en":"Saying, “Give us your daughter,”"},{"id":"manas-2010:p0821:b001:l039","ordinal":36282,"en":"I went to place betrothal earrings."},{"id":"manas-2010:p0821:b001:l040","ordinal":36283,"en":"He did not take my gold,"},{"id":"manas-2010:p0821:b001:l041","ordinal":36284,"en":"He did not turn his attention to me,"},{"id":"manas-2010:p0821:b001:l042","ordinal":36285,"en":"He did not accept my words,"},{"id":"manas-2010:p0822:b001:l001","ordinal":36286,"en":"He did not give his daughter to me."},{"id":"manas-2010:p0822:b001:l002","ordinal":36287,"en":"The generous Teke mounted horses,"},{"id":"manas-2010:p0822:b001:l003","ordinal":36288,"en":"Donned coats of blue iron,"},{"id":"manas-2010:p0822:b001:l004","ordinal":36289,"en":"From the ridge of bleak Chambyl"},{"id":"manas-2010:p0822:b001:l005","ordinal":36290,"en":"They burst out raging to fight."},{"id":"manas-2010:p0822:b001:l006","ordinal":36291,"en":"The two giants Zhanaaly and Karach,"},{"id":"manas-2010:p0822:b001:l007","ordinal":36292,"en":"For fourteen days and nights,"},{"id":"manas-2010:p0822:b001:l008","ordinal":36293,"en":"With your elder, warrior Bakay,"},{"id":"manas-2010:p0822:b001:l009","ordinal":36294,"en":"Kept fighting with spears."},{"id":"manas-2010:p0822:b001:l010","ordinal":36295,"en":"They thought nothing of me."},{"id":"manas-2010:p0822:b001:l011","ordinal":36296,"en":"Your elder touched by Kydyr—"},{"id":"manas-2010:p0822:b001:l012","ordinal":36297,"en":"Those fools did not recognize him."},{"id":"manas-2010:p0822:b001:l013","ordinal":36298,"en":"Damn being alone!"},{"id":"manas-2010:p0822:b001:l014","ordinal":36299,"en":"I passed through suffering."},{"id":"manas-2010:p0822:b001:l015","ordinal":36300,"en":"Unable to take Körpöyan,"},{"id":"manas-2010:p0822:b001:l016","ordinal":36301,"en":"“If blue-maned Manas is found,"},{"id":"manas-2010:p0822:b001:l017","ordinal":36302,"en":"I shall show you a thing or two,” I said,"},{"id":"manas-2010:p0822:b001:l018","ordinal":36303,"en":"And departed full of regret."},{"id":"manas-2010:p0822:b001:l019","ordinal":36304,"en":"Unable to take Körpöyan,"},{"id":"manas-2010:p0822:b001:l020","ordinal":36305,"en":"Unable to reach my desire,"},{"id":"manas-2010:p0822:b001:l021","ordinal":36306,"en":"I went out into the open wilderness."},{"id":"manas-2010:p0822:b001:l022","ordinal":36307,"en":"“Oh, solitude, damn you!” I said,"},{"id":"manas-2010:p0822:b001:l023","ordinal":36308,"en":"And bit my thumb."},{"id":"manas-2010:p0822:b001:l024","ordinal":36309,"en":"I traveled far, pondering,"},{"id":"manas-2010:p0822:b001:l025","ordinal":36310,"en":"Thinking, “If only Manas would come.”"},{"id":"manas-2010:p0822:b001:l026","ordinal":36311,"en":"The one I faced was Zhanaaly;"},{"id":"manas-2010:p0822:b001:l027","ordinal":36312,"en":"My beloved, sharing my wishes, Körpöyan."},{"id":"manas-2010:p0822:b001:l028","ordinal":36313,"en":"I shall become Karach's kin by marriage;"},{"id":"manas-2010:p0822:b001:l029","ordinal":36314,"en":"I shall not spare my bare life"},{"id":"manas-2010:p0822:b001:l030","ordinal":36315,"en":"If Karach makes peace with me."},{"id":"manas-2010:p0822:b001:l031","ordinal":36316,"en":"My breast is full of faith."},{"id":"manas-2010:p0822:b001:l032","ordinal":36317,"en":"The wandering holy man named Kydyr—"},{"id":"manas-2010:p0822:b001:l033","ordinal":36318,"en":"That poor Körpöyan"},{"id":"manas-2010:p0822:b001:l034","ordinal":36319,"en":"Was married to me in my dream."},{"id":"manas-2010:p0822:b001:l035","ordinal":36320,"en":"Look, oh, lads:"},{"id":"manas-2010:p0822:b001:l036","ordinal":36321,"en":"‘May God make him yours forever,"},{"id":"manas-2010:p0822:b001:l037","ordinal":36322,"en":"Unable to reach Körpöyan,"},{"id":"manas-2010:p0822:b001:l038","ordinal":36323,"en":"I grieve a great deal."},{"id":"manas-2010:p0822:b001:l039","ordinal":36324,"en":"Months ended, a year passed,"},{"id":"manas-2010:p0822:b001:l040","ordinal":36325,"en":"So many days passed between."},{"id":"manas-2010:p0822:b001:l041","ordinal":36326,"en":"This damned, deceitful world—"},{"id":"manas-2010:p0822:b001:l042","ordinal":36327,"en":"See how it dealt its pleasures to Bakay!"},{"id":"manas-2010:p0823:b001:l001","ordinal":36328,"en":"For Körpöyan's sake,"},{"id":"manas-2010:p0823:b001:l002","ordinal":36329,"en":"Going out to single combat,"},{"id":"manas-2010:p0823:b001:l003","ordinal":36330,"en":"Fighting with spears seven days without rest,"},{"id":"manas-2010:p0823:b001:l004","ordinal":36331,"en":"I wore thin and exhausted"},{"id":"manas-2010:p0823:b001:l005","ordinal":36332,"en":"The steed beneath me."},{"id":"manas-2010:p0823:b001:l006","ordinal":36333,"en":"Thus I failed to take"},{"id":"manas-2010:p0823:b001:l007","ordinal":36334,"en":"My wife for the hereafter."},{"id":"manas-2010:p0823:b001:l008","ordinal":36335,"en":"Unable to reach what I desired,"},{"id":"manas-2010:p0823:b001:l009","ordinal":36336,"en":"Unable to break straight in,"},{"id":"manas-2010:p0823:b001:l010","ordinal":36337,"en":"Unable to put her behind my saddle,"},{"id":"manas-2010:p0823:b001:l011","ordinal":36338,"en":"Unable to take her as spoils—"},{"id":"manas-2010:p0823:b001:l012","ordinal":36339,"en":"They were a people of seven clans,"},{"id":"manas-2010:p0823:b001:l013","ordinal":36340,"en":"Wolves toward the enemy."},{"id":"manas-2010:p0823:b001:l014","ordinal":36341,"en":"They were many, I alone;"},{"id":"manas-2010:p0823:b001:l015","ordinal":36342,"en":"For sixty days I fought."},{"id":"manas-2010:p0823:b001:l016","ordinal":36343,"en":"For sixty days I moved among them,"},{"id":"manas-2010:p0823:b001:l017","ordinal":36344,"en":"And barely escaped then,"},{"id":"manas-2010:p0823:b001:l018","ordinal":36345,"en":"Wounded in six places."},{"id":"manas-2010:p0823:b001:l019","ordinal":36346,"en":"Prepared against the enemy,"},{"id":"manas-2010:p0823:b001:l020","ordinal":36347,"en":"They were a people who barred one's way."},{"id":"manas-2010:p0823:b001:l021","ordinal":36348,"en":"Their boys wore daggers;"},{"id":"manas-2010:p0823:b001:l022","ordinal":36349,"en":"Upon your elder touched by Kydyr"},{"id":"manas-2010:p0823:b001:l023","ordinal":36350,"en":"They rushed with shouts."},{"id":"manas-2010:p0823:b001:l024","ordinal":36351,"en":"They were ten thousand, I alone;"},{"id":"manas-2010:p0823:b001:l025","ordinal":36352,"en":"What power have I against God?"}]
