[{"id":"semetey-1-2013:p0260:b003:l011","ordinal":96769,"en":"She had all but glimpsed."},{"id":"semetey-1-2013:p0260:b003:l012","ordinal":96770,"en":"Weeping breathlessly and screaming,"},{"id":"semetey-1-2013:p0260:b003:l013","ordinal":96771,"en":"Halfway along the road, Kanykei,"},{"id":"semetey-1-2013:p0260:b003:l014","ordinal":96772,"en":"When she saw his spirit,"},{"id":"semetey-1-2013:p0260:b003:l015","ordinal":96773,"en":"Had nearly died."},{"id":"semetey-1-2013:p0260:b003:l016","ordinal":96774,"en":"Tearing both her cheeks,"},{"id":"semetey-1-2013:p0260:b003:l017","ordinal":96775,"en":"She had fallen into anguish."},{"id":"semetey-1-2013:p0260:b003:l018","ordinal":96776,"en":"As though her lord, heroic Manas,"},{"id":"semetey-1-2013:p0260:b003:l019","ordinal":96777,"en":"Had died this very day,"},{"id":"semetey-1-2013:p0260:b003:l020","ordinal":96778,"en":"She had begun lamenting Manas again."},{"id":"semetey-1-2013:p0260:b003:l021","ordinal":96779,"en":"Seeing her lament,"},{"id":"semetey-1-2013:p0260:b003:l022","ordinal":96780,"en":"The boy's heart was wounded."},{"id":"semetey-1-2013:p0260:b003:l023","ordinal":96781,"en":"The sixty distinguished champions—"},{"id":"semetey-1-2013:p0260:b003:l024","ordinal":96782,"en":"Their hearts ached, every one."},{"id":"semetey-1-2013:p0260:b003:l025","ordinal":96783,"en":"Once he had seen his sister,"},{"id":"semetey-1-2013:p0260:b003:l026","ordinal":96784,"en":"The marvelous hero Semetey,"},{"id":"semetey-1-2013:p0260:b003:l027","ordinal":96785,"en":"Shouting, 'Manas! Manas!'"},{"id":"semetey-1-2013:p0260:b003:l028","ordinal":96786,"en":"Came out from the bank,"},{"id":"semetey-1-2013:p0260:b003:l029","ordinal":96787,"en":"Raising the battle cry, 'Manas!'"},{"id":"semetey-1-2013:p0260:b003:l030","ordinal":96788,"en":"When the boy cried, 'Manas!'"},{"id":"semetey-1-2013:p0260:b003:l031","ordinal":96789,"en":"The whole hollow rang with shouting."},{"id":"semetey-1-2013:p0260:b003:l032","ordinal":96790,"en":"All the hills and hollows"},{"id":"semetey-1-2013:p0260:b003:l033","ordinal":96791,"en":"Raised the battle cry, 'Manas!'"},{"id":"semetey-1-2013:p0260:b003:l034","ordinal":96792,"en":"The young hawk Semetey"},{"id":"semetey-1-2013:p0260:b003:l035","ordinal":96793,"en":"Did not hush his shouting."},{"id":"semetey-1-2013:p0260:b003:l036","ordinal":96794,"en":"His battle cry of 'Manas!'"},{"id":"semetey-1-2013:p0260:b003:l037","ordinal":96795,"en":"The boy did not still then."},{"id":"semetey-1-2013:p0260:b003:l038","ordinal":96796,"en":"Upon the courser beneath him"},{"id":"semetey-1-2013:p0260:b003:l039","ordinal":96797,"en":"He laid the whip from side to side,"},{"id":"semetey-1-2013:p0260:b004:l001","ordinal":96798,"en":"Spurring left and right."},{"id":"semetey-1-2013:p0260:b004:l002","ordinal":96799,"en":"He raised a mighty battle cry."},{"id":"semetey-1-2013:p0260:b004:l003","ordinal":96800,"en":"'My magnanimous brother-in-law Manas!'"},{"id":"semetey-1-2013:p0260:b004:l004","ordinal":96801,"en":"Semetey roared,"},{"id":"semetey-1-2013:p0260:b004:l005","ordinal":96802,"en":"Drew alongside and took the lead rope."},{"id":"semetey-1-2013:p0260:b004:l006","ordinal":96803,"en":"He opened his mouth with an 'Ah!'"},{"id":"semetey-1-2013:p0260:b004:l007","ordinal":96804,"en":"The white lead rope with knotted loops"},{"id":"semetey-1-2013:p0260:b004:l008","ordinal":96805,"en":"He snatched from the boy,"},{"id":"semetey-1-2013:p0260:b004:l009","ordinal":96806,"en":"(From this side of the open plain)."},{"id":"semetey-1-2013:p0260:b004:l010","ordinal":96807,"en":"Then the marvelous young hero"},{"id":"semetey-1-2013:p0260:b004:l011","ordinal":96808,"en":"Pressed it to his breast."},{"id":"semetey-1-2013:p0260:b004:l012","ordinal":96809,"en":"Tirelessly, young Semetey"},{"id":"semetey-1-2013:p0260:b004:l013","ordinal":96810,"en":"Drew Taytoru along."},{"id":"semetey-1-2013:p0260:b004:l014","ordinal":96811,"en":"Shouting, 'Manas! Manas!'"},{"id":"semetey-1-2013:p0260:b004:l015","ordinal":96812,"en":"Raising the battle cry, 'Manas!'"},{"id":"semetey-1-2013:p0260:b004:l016","ordinal":96813,"en":"He urged Taytoru onward."},{"id":"semetey-1-2013:p0260:b004:l017","ordinal":96814,"en":"The boy looked behind him,"},{"id":"semetey-1-2013:p0260:b004:l018","ordinal":96815,"en":"Thinking of his elder sister."},{"id":"semetey-1-2013:p0260:b004:l019","ordinal":96816,"en":"His dear sister Kanykei,"},{"id":"semetey-1-2013:p0260:b004:l020","ordinal":96817,"en":"With a great black covering on her head,"},{"id":"semetey-1-2013:p0260:b004:l021","ordinal":96818,"en":"Bereft of her blood-shedding lord,"},{"id":"semetey-1-2013:p0260:b004:l022","ordinal":96819,"en":"At thirty-two years of age"},{"id":"semetey-1-2013:p0260:b004:l023","ordinal":96820,"en":"Had become a helpless old woman."},{"id":"semetey-1-2013:p0260:b004:l024","ordinal":96821,"en":"Fleeing and wandering to Bukhara,"},{"id":"semetey-1-2013:p0260:b004:l025","ordinal":96822,"en":"The poor wretch had grown thin."},{"id":"semetey-1-2013:p0260:b004:l026","ordinal":96823,"en":"The wise, fierce, marvelous hero,"},{"id":"semetey-1-2013:p0260:b004:l027","ordinal":96824,"en":"The capable boy, spoke these words:"},{"id":"semetey-1-2013:p0260:b004:l028","ordinal":96825,"en":"“My Taikush, with a thoroughbred’s mane,"},{"id":"semetey-1-2013:p0260:b004:l029","ordinal":96826,"en":"Bereft of your magnanimous lord,"},{"id":"semetey-1-2013:p0260:b004:l030","ordinal":96827,"en":"You came destitute to Bukhara,"},{"id":"semetey-1-2013:p0260:b004:l031","ordinal":96828,"en":"My sorrow-laden unfortunate!"},{"id":"semetey-1-2013:p0260:b004:l032","ordinal":96829,"en":"Ah, my darling elder sister,"},{"id":"semetey-1-2013:p0260:b004:l033","ordinal":96830,"en":"I shall not let a hawk devour the swan."},{"id":"semetey-1-2013:p0260:b004:l034","ordinal":96831,"en":"Unless this wretched head of mine should die,"},{"id":"semetey-1-2013:p0260:b004:l035","ordinal":96832,"en":"I shall not let them call you a wretched woman!"},{"id":"semetey-1-2013:p0260:b004:l036","ordinal":96833,"en":"I shall not let a hawk devour the goose."},{"id":"semetey-1-2013:p0260:b004:l037","ordinal":96834,"en":"Unless this dear head of mine should die,"},{"id":"semetey-1-2013:p0260:b004:l038","ordinal":96835,"en":"I shall not let them call you a fugitive woman!"},{"id":"semetey-1-2013:p0260:b004:l039","ordinal":96836,"en":"While this dear head remains alive,"},{"id":"semetey-1-2013:p0261:b003:l001","ordinal":96837,"en":"I shall not let the winged strike you,"},{"id":"semetey-1-2013:p0261:b003:l002","ordinal":96838,"en":"Nor let the whip-bearers beat you."},{"id":"semetey-1-2013:p0261:b003:l003","ordinal":96839,"en":"I shall not let them speak ill of you,"},{"id":"semetey-1-2013:p0261:b003:l004","ordinal":96840,"en":"I shall not give you a bad name."},{"id":"semetey-1-2013:p0261:b003:l005","ordinal":96841,"en":"If anyone humiliates you,"},{"id":"semetey-1-2013:p0261:b003:l006","ordinal":96842,"en":"I shall not stand by and watch!"},{"id":"semetey-1-2013:p0261:b003:l007","ordinal":96843,"en":"I myself shall take charge of your prize,"},{"id":"semetey-1-2013:p0261:b003:l008","ordinal":96844,"en":"And gather it all together."},{"id":"semetey-1-2013:p0261:b003:l009","ordinal":96845,"en":"'How are you faring?'"},{"id":"semetey-1-2013:p0261:b003:l010","ordinal":96846,"en":"I shall come calling in due season,"},{"id":"semetey-1-2013:p0261:b003:l011","ordinal":96847,"en":"And keep my eyes upon you!"},{"id":"semetey-1-2013:p0261:b003:l012","ordinal":96848,"en":"I shall sit and talk with you,"},{"id":"semetey-1-2013:p0261:b003:l013","ordinal":96849,"en":"'How are you faring?'"},{"id":"semetey-1-2013:p0261:b003:l014","ordinal":96850,"en":"Seven times I shall ask!"},{"id":"semetey-1-2013:p0261:b003:l015","ordinal":96851,"en":"I shall truly watch over you."},{"id":"semetey-1-2013:p0261:b003:l016","ordinal":96852,"en":"If the true Almighty supports me,"},{"id":"semetey-1-2013:p0261:b003:l017","ordinal":96853,"en":"Sister, I myself shall"},{"id":"semetey-1-2013:p0261:b003:l018","ordinal":96854,"en":"Make you my holy shrine!"},{"id":"semetey-1-2013:p0261:b003:l019","ordinal":96855,"en":"My ill-fated, hollow-browed one,"},{"id":"semetey-1-2013:p0261:b003:l020","ordinal":96856,"en":"Bereft of your sovereign,"},{"id":"semetey-1-2013:p0261:b003:l021","ordinal":96857,"en":"To Temir Khan's city"},{"id":"semetey-1-2013:p0261:b003:l022","ordinal":96858,"en":"You came wandering, my poor one!"},{"id":"semetey-1-2013:p0261:b003:l023","ordinal":96859,"en":"Oh, sister, unfortunate slavewoman,"},{"id":"semetey-1-2013:p0261:b003:l024","ordinal":96860,"en":"You have no waist to gird,"},{"id":"semetey-1-2013:p0261:b003:l025","ordinal":96861,"en":"You fled and came here in earnest,"},{"id":"semetey-1-2013:p0261:b003:l026","ordinal":96862,"en":"Without your renowned Kyrgyz people."},{"id":"semetey-1-2013:p0261:b003:l027","ordinal":96863,"en":"There is no sieve over people's mouths."},{"id":"semetey-1-2013:p0261:b003:l028","ordinal":96864,"en":"Saying, 'I shall race my horse in Bukhara,'"},{"id":"semetey-1-2013:p0261:b003:l029","ordinal":96865,"en":"Do not become a needless laughingstock."},{"id":"semetey-1-2013:p0261:b003:l030","ordinal":96866,"en":"Do not let dust catch your eyes;"},{"id":"semetey-1-2013:p0261:b003:l031","ordinal":96867,"en":"Letting them call you a hell-bound woman,"},{"id":"semetey-1-2013:p0261:b003:l032","ordinal":96868,"en":"Do not let the enemy sap your strength!"},{"id":"semetey-1-2013:p0261:b003:l033","ordinal":96869,"en":"My accomplished sister, my poor one,"},{"id":"semetey-1-2013:p0261:b003:l034","ordinal":96870,"en":"Do not dress him in your arrow-proof coat."},{"id":"semetey-1-2013:p0261:b003:l035","ordinal":96871,"en":"Letting them call you a widow,"},{"id":"semetey-1-2013:p0261:b003:l036","ordinal":96872,"en":"Sister, do not reveal your widowhood!"},{"id":"semetey-1-2013:p0261:b003:l037","ordinal":96873,"en":"I myself shall claim your prize,"},{"id":"semetey-1-2013:p0261:b003:l038","ordinal":96874,"en":"And, refusing to let them call you a widow,"},{"id":"semetey-1-2013:p0261:b003:l039","ordinal":96875,"en":"I shall watch over you closely."},{"id":"semetey-1-2013:p0261:b004:l001","ordinal":96876,"en":"Do not let your face brush the level ground;"},{"id":"semetey-1-2013:p0261:b004:l002","ordinal":96877,"en":"Letting them call you a shameless woman,"},{"id":"semetey-1-2013:p0261:b004:l003","ordinal":96878,"en":"Do not let just anyone sap your strength!"},{"id":"semetey-1-2013:p0261:b004:l004","ordinal":96879,"en":"Do not let your hem touch the earth."},{"id":"semetey-1-2013:p0261:b004:l005","ordinal":96880,"en":"Letting them call you a wandering woman,"},{"id":"semetey-1-2013:p0261:b004:l006","ordinal":96881,"en":"Do not torment me so!'"},{"id":"semetey-1-2013:p0261:b004:l007","ordinal":96882,"en":"Saying this, Semetey"},{"id":"semetey-1-2013:p0261:b004:l008","ordinal":96883,"en":"Raised his cry of 'Manas!'"},{"id":"semetey-1-2013:p0261:b004:l009","ordinal":96884,"en":"The racer Taytoru"},{"id":"semetey-1-2013:p0261:b004:l010","ordinal":96885,"en":"He urged onward to Bukhara!"},{"id":"semetey-1-2013:p0261:b004:l011","ordinal":96886,"en":"Once Semetey took Taytoru in hand,"},{"id":"semetey-1-2013:p0261:b004:l012","ordinal":96887,"en":"Then your dear mother Kanykei—"},{"id":"semetey-1-2013:p0261:b004:l013","ordinal":96888,"en":"God's sun clouded over in the sky,"},{"id":"semetey-1-2013:p0261:b004:l014","ordinal":96889,"en":"Sixty cares came upon her head at once."},{"id":"semetey-1-2013:p0261:b004:l015","ordinal":96890,"en":"Her poor heart was divided."},{"id":"semetey-1-2013:p0261:b004:l016","ordinal":96891,"en":"Her only child, gained through such hardship,"},{"id":"semetey-1-2013:p0261:b004:l017","ordinal":96892,"en":"Appeared before her on the road."},{"id":"semetey-1-2013:p0261:b004:l018","ordinal":96893,"en":"When she saw her orphan,"},{"id":"semetey-1-2013:p0261:b004:l019","ordinal":96894,"en":"Grieving, weeping and distraught,"},{"id":"semetey-1-2013:p0261:b004:l020","ordinal":96895,"en":"Before God whose command is mighty,"},{"id":"semetey-1-2013:p0261:b004:l021","ordinal":96896,"en":"Before his command, your mother"},{"id":"semetey-1-2013:p0261:b004:l022","ordinal":96897,"en":"Offered prayers and supplications:"},{"id":"semetey-1-2013:p0261:b004:l023","ordinal":96898,"en":"'Now that my son has taken his horse,"},{"id":"semetey-1-2013:p0261:b004:l024","ordinal":96899,"en":"Why should I go after him?"},{"id":"semetey-1-2013:p0261:b004:l025","ordinal":96900,"en":"Since God has expressly granted this,"},{"id":"semetey-1-2013:p0261:b004:l026","ordinal":96901,"en":"Since my Taytoru has come out in front,"},{"id":"semetey-1-2013:p0261:b004:l027","ordinal":96902,"en":"Since the owner has taken his horse,"},{"id":"semetey-1-2013:p0261:b004:l028","ordinal":96903,"en":"Since my darling, gained through such hardship,"},{"id":"semetey-1-2013:p0261:b004:l029","ordinal":96904,"en":"Has himself begun to urge it onward,"},{"id":"semetey-1-2013:p0261:b004:l030","ordinal":96905,"en":"By bustling along behind him,"},{"id":"semetey-1-2013:p0261:b004:l031","ordinal":96906,"en":"What wish should I attain?"},{"id":"semetey-1-2013:p0261:b004:l032","ordinal":96907,"en":"My gift left by my khan"},{"id":"semetey-1-2013:p0261:b004:l033","ordinal":96908,"en":"Has gladly taken his horse;"},{"id":"semetey-1-2013:p0261:b004:l034","ordinal":96909,"en":"Now I shall return to my palace.'"},{"id":"semetey-1-2013:p0261:b004:l035","ordinal":96910,"en":"Riding on in distress,"},{"id":"semetey-1-2013:p0261:b004:l036","ordinal":96911,"en":"Your poor mother Kanykei,"},{"id":"semetey-1-2013:p0261:b004:l037","ordinal":96912,"en":"Of the orphan left by Manas,"},{"id":"semetey-1-2013:p0261:b004:l038","ordinal":96913,"en":"Saw the form and pleaded:"},{"id":"semetey-1-2013:p0261:b004:l039","ordinal":96914,"en":"'My beloved God,"},{"id":"semetey-1-2013:p0262:b003:l001","ordinal":96915,"en":"Has the horse's owner taken him?"},{"id":"semetey-1-2013:p0262:b003:l002","ordinal":96916,"en":"My heart has lightened so greatly;"},{"id":"semetey-1-2013:p0262:b003:l003","ordinal":96917,"en":"Has God truly granted this?"},{"id":"semetey-1-2013:p0262:b003:l004","ordinal":96918,"en":"My river with a valley, my spring,"},{"id":"semetey-1-2013:p0262:b003:l005","ordinal":96919,"en":"My little one won at death's door,"},{"id":"semetey-1-2013:p0262:b003:l006","ordinal":96920,"en":"My plump darling, my gray-pied goshawk,"},{"id":"semetey-1-2013:p0262:b003:l007","ordinal":96921,"en":"My gray goshawk, my morning star,"},{"id":"semetey-1-2013:p0262:b003:l008","ordinal":96922,"en":"My gift left by my khan,"},{"id":"semetey-1-2013:p0262:b003:l009","ordinal":96923,"en":"Whom I kissed with parted lips,"},{"id":"semetey-1-2013:p0262:b003:l010","ordinal":96924,"en":"Whom I saw with opened eyes!"},{"id":"semetey-1-2013:p0262:b003:l011","ordinal":96925,"en":"I have bright days left to see."},{"id":"semetey-1-2013:p0262:b003:l012","ordinal":96926,"en":"I pleaded with the one God."},{"id":"semetey-1-2013:p0262:b003:l013","ordinal":96927,"en":"Who else have I but him?"},{"id":"semetey-1-2013:p0262:b003:l014","ordinal":96928,"en":"My hoof left by a mighty steed,"},{"id":"semetey-1-2013:p0262:b003:l015","ordinal":96929,"en":"My tireless swift horse, my little one,"},{"id":"semetey-1-2013:p0262:b003:l016","ordinal":96930,"en":"My banner fixed upon a spear,"},{"id":"semetey-1-2013:p0262:b003:l017","ordinal":96931,"en":"My gift left by a noble one!”"},{"id":"semetey-1-2013:p0262:b003:l018","ordinal":96932,"en":"So she pleaded,"},{"id":"semetey-1-2013:p0262:b003:l019","ordinal":96933,"en":"When she saw this orphan of hers,"},{"id":"semetey-1-2013:p0262:b003:l020","ordinal":96934,"en":"To God whose command is mighty,"},{"id":"semetey-1-2013:p0262:b003:l021","ordinal":96935,"en":"Praying and beseeching:"},{"id":"semetey-1-2013:p0262:b003:l022","ordinal":96936,"en":"“Living as a widow, flopping about,"},{"id":"semetey-1-2013:p0262:b003:l023","ordinal":96937,"en":"Galloping after them, flapping along,"},{"id":"semetey-1-2013:p0262:b003:l024","ordinal":96938,"en":"What wish would I fulfill?"},{"id":"semetey-1-2013:p0262:b003:l025","ordinal":96939,"en":"Without being seen by anyone,"},{"id":"semetey-1-2013:p0262:b003:l026","ordinal":96940,"en":"Let me enter my palace.”"},{"id":"semetey-1-2013:p0262:b003:l027","ordinal":96941,"en":"Your mother with a warrior's frame"},{"id":"semetey-1-2013:p0262:b003:l028","ordinal":96942,"en":"Turned swiftly back."},{"id":"semetey-1-2013:p0262:b003:l029","ordinal":96943,"en":"Your cherished mother Kanykey"},{"id":"semetey-1-2013:p0262:b003:l030","ordinal":96944,"en":"Darted toward the palace."},{"id":"semetey-1-2013:p0262:b003:l031","ordinal":96945,"en":"On a spur of broad Bukhara,"},{"id":"semetey-1-2013:p0262:b003:l032","ordinal":96946,"en":"At the projecting end of Keruu-Kyr,"},{"id":"semetey-1-2013:p0262:b003:l033","ordinal":96947,"en":"On Bukhara's nearer ridge,"},{"id":"semetey-1-2013:p0262:b003:l034","ordinal":96948,"en":"When your sister-in-law fled there,"},{"id":"semetey-1-2013:p0262:b003:l035","ordinal":96949,"en":"With eight hundred households under her,"},{"id":"semetey-1-2013:p0262:b003:l036","ordinal":96950,"en":"There was Kanykey's white palace,"},{"id":"semetey-1-2013:p0262:b003:l037","ordinal":96951,"en":"Its gate of iron and solid tin."},{"id":"semetey-1-2013:p0262:b003:l038","ordinal":96952,"en":"However widowed she might be,"},{"id":"semetey-1-2013:p0262:b003:l039","ordinal":96953,"en":"Her grandeur was very great."},{"id":"semetey-1-2013:p0262:b004:l001","ordinal":96954,"en":"Kanykey who went to the palace—"},{"id":"semetey-1-2013:p0262:b004:l002","ordinal":96955,"en":"Let us leave her thus."},{"id":"semetey-1-2013:p0262:b004:l003","ordinal":96956,"en":"Yesterday Kanykey went there in mourning;"},{"id":"semetey-1-2013:p0262:b004:l004","ordinal":96957,"en":"Semetey fled to Bukhara."},{"id":"semetey-1-2013:p0262:b004:l005","ordinal":96958,"en":"Let us begin telling of the orphan."},{"id":"semetey-1-2013:p0262:b004:l006","ordinal":96959,"en":"At that moment Semetey"},{"id":"semetey-1-2013:p0262:b004:l007","ordinal":96960,"en":"Raised the battle cry, “Manas!”"},{"id":"semetey-1-2013:p0262:b004:l008","ordinal":96961,"en":"The orphan slave left by Manas,"},{"id":"semetey-1-2013:p0262:b004:l009","ordinal":96962,"en":"“Manas! Manas! Manas!” he cried,"},{"id":"semetey-1-2013:p0262:b004:l010","ordinal":96963,"en":"Raising the battle cry, “Manas!”"},{"id":"semetey-1-2013:p0262:b004:l011","ordinal":96964,"en":"All the lowlands and mountains"},{"id":"semetey-1-2013:p0262:b004:l012","ordinal":96965,"en":"Seemed to break into a run."},{"id":"semetey-1-2013:p0262:b004:l013","ordinal":96966,"en":"Khan Manas, gone to the other world,"},{"id":"semetey-1-2013:p0262:b004:l014","ordinal":96967,"en":"Seemed to have come to life."},{"id":"semetey-1-2013:p0262:b004:l015","ordinal":96968,"en":"The misty gray plain"},{"id":"semetey-1-2013:p0262:b004:l016","ordinal":96969,"en":"Seemed to have a city."},{"id":"semetey-1-2013:p0262:b004:l017","ordinal":96970,"en":"Fleet Manas, the dear lion,"},{"id":"semetey-1-2013:p0262:b004:l018","ordinal":96971,"en":"Seemed now to have a son."},{"id":"semetey-1-2013:p0262:b004:l019","ordinal":96972,"en":"When the boy said, “Manas!”"},{"id":"semetey-1-2013:p0262:b004:l020","ordinal":96973,"en":"Birches wept, willows wept,"},{"id":"semetey-1-2013:p0262:b004:l021","ordinal":96974,"en":"Every watching soul wept,"},{"id":"semetey-1-2013:p0262:b004:l022","ordinal":96975,"en":"The white-turbaned khoja wept,"},{"id":"semetey-1-2013:p0262:b004:l023","ordinal":96976,"en":"The mullah studying his lesson wept,"},{"id":"semetey-1-2013:p0262:b004:l024","ordinal":96977,"en":"The hard-hearted hero wept,"},{"id":"semetey-1-2013:p0262:b004:l025","ordinal":96978,"en":"The people wept, the khan wept."},{"id":"semetey-1-2013:p0262:b004:l026","ordinal":96979,"en":"When the boy said, “Manas!”"},{"id":"semetey-1-2013:p0262:b004:l027","ordinal":96980,"en":"All the people who wished for him wept."},{"id":"semetey-1-2013:p0262:b004:l028","ordinal":96981,"en":"All those who wept"},{"id":"semetey-1-2013:p0262:b004:l029","ordinal":96982,"en":"Wept nursing their own grief."},{"id":"semetey-1-2013:p0262:b004:l030","ordinal":96983,"en":"“From every worthy young man,"},{"id":"semetey-1-2013:p0262:b004:l031","ordinal":96984,"en":"A male child, a single hoof,"},{"id":"semetey-1-2013:p0262:b004:l032","ordinal":96985,"en":"May one remain,” they wept."},{"id":"semetey-1-2013:p0262:b004:l033","ordinal":96986,"en":"“From the green ravine among the hills,"},{"id":"semetey-1-2013:p0262:b004:l034","ordinal":96987,"en":"May a spring remain,” they wept."},{"id":"semetey-1-2013:p0262:b004:l035","ordinal":96988,"en":"“From every worthy young man,"},{"id":"semetey-1-2013:p0262:b004:l036","ordinal":96989,"en":"A male child, a single hoof,"},{"id":"semetey-1-2013:p0262:b004:l037","ordinal":96990,"en":"May a lamp remain,” they wept."},{"id":"semetey-1-2013:p0262:b004:l038","ordinal":96991,"en":"The gray-maned hero Manas,"},{"id":"semetey-1-2013:p0262:b004:l039","ordinal":96992,"en":"The one Almighty Allah"},{"id":"semetey-1-2013:p0263:b003:l001","ordinal":96993,"en":"Had truly taken away."},{"id":"semetey-1-2013:p0263:b003:l002","ordinal":96994,"en":"As a surviving hoof, Semetey"},{"id":"semetey-1-2013:p0263:b003:l003","ordinal":96995,"en":"Behind your goshawk"},{"id":"semetey-1-2013:p0263:b003:l004","ordinal":96996,"en":"Had truly remained."},{"id":"semetey-1-2013:p0263:b003:l005","ordinal":96997,"en":"Revered Khan Manas"},{"id":"semetey-1-2013:p0263:b003:l006","ordinal":96998,"en":"Had truly been a khan."},{"id":"semetey-1-2013:p0263:b003:l007","ordinal":96999,"en":"His sacred power like a mountain,"},{"id":"semetey-1-2013:p0263:b003:l008","ordinal":97000,"en":"Such a soul he truly was."},{"id":"semetey-1-2013:p0263:b003:l009","ordinal":97001,"en":"Not yet wearing a robe upon his back,"},{"id":"semetey-1-2013:p0263:b003:l010","ordinal":97002,"en":"The little slave urging the horse ahead"},{"id":"semetey-1-2013:p0263:b003:l011","ordinal":97003,"en":"Of the noble Magnanimous Manas,"},{"id":"semetey-1-2013:p0263:b003:l012","ordinal":97004,"en":"He did not yet know he was his father."},{"id":"semetey-1-2013:p0263:b003:l013","ordinal":97005,"en":"“Did you see? When he says ‘Manas,’"},{"id":"semetey-1-2013:p0263:b003:l014","ordinal":97006,"en":"His mouth fills with it,” they said."},{"id":"semetey-1-2013:p0263:b003:l015","ordinal":97007,"en":"“What God has done,"},{"id":"semetey-1-2013:p0263:b003:l016","ordinal":97008,"en":"There is no choice but to bear,” they said."},{"id":"semetey-1-2013:p0263:b003:l017","ordinal":97009,"en":"“Behind gray-maned Manas,"},{"id":"semetey-1-2013:p0263:b003:l018","ordinal":97010,"en":"There has truly remained"},{"id":"semetey-1-2013:p0263:b003:l019","ordinal":97011,"en":"One child, Semetey,” they said."},{"id":"semetey-1-2013:p0263:b003:l020","ordinal":97012,"en":"“The Creator's decree"},{"id":"semetey-1-2013:p0263:b003:l021","ordinal":97013,"en":"He has escaped,” they said."},{"id":"semetey-1-2013:p0263:b003:l022","ordinal":97014,"en":"“With Semetey remaining behind him,"},{"id":"semetey-1-2013:p0263:b003:l023","ordinal":97015,"en":"Great Manas, gone to the other world,"},{"id":"semetey-1-2013:p0263:b003:l024","ordinal":97016,"en":"Has not truly died,” they said."},{"id":"semetey-1-2013:p0263:b003:l025","ordinal":97017,"en":"“A lamp burning before us,” they said."},{"id":"semetey-1-2013:p0263:b003:l026","ordinal":97018,"en":"“From Manas, gone to the other world,"},{"id":"semetey-1-2013:p0263:b003:l027","ordinal":97019,"en":"A little one plainly remains,” they said."},{"id":"semetey-1-2013:p0263:b003:l028","ordinal":97020,"en":"Then the boy Semetey"},{"id":"semetey-1-2013:p0263:b003:l029","ordinal":97021,"en":"Raised the battle cry, “Manas!”"},{"id":"semetey-1-2013:p0263:b003:l030","ordinal":97022,"en":"He began urging Taytoru onward."},{"id":"semetey-1-2013:p0263:b003:l031","ordinal":97023,"en":"All the ridges rang with shouting."},{"id":"semetey-1-2013:p0263:b003:l032","ordinal":97024,"en":"See the wonder of the world!"}]
