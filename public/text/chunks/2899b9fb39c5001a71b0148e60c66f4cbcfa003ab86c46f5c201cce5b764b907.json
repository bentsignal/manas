[{"id":"semetey-1-2013:p0878:b003:l037","ordinal":143361,"en":"The forty warriors had become seasoned."},{"id":"semetey-1-2013:p0878:b003:l038","ordinal":143362,"en":"When dear Manas lived,"},{"id":"semetey-1-2013:p0878:b003:l039","ordinal":143363,"en":"Fighting lance battles with many foes,"},{"id":"semetey-1-2013:p0878:b004:l001","ordinal":143364,"en":"The forty warriors had grown experienced."},{"id":"semetey-1-2013:p0878:b004:l002","ordinal":143365,"en":"Their eyes blazed like fire,"},{"id":"semetey-1-2013:p0878:b004:l003","ordinal":143366,"en":"Their bloodlust seized them."},{"id":"semetey-1-2013:p0878:b004:l004","ordinal":143367,"en":"With shrill shouts and ringing battle cries,"},{"id":"semetey-1-2013:p0878:b004:l005","ordinal":143368,"en":"No man could match them in a struggle,"},{"id":"semetey-1-2013:p0878:b004:l006","ordinal":143369,"en":"No beast's teeth could pierce them."},{"id":"semetey-1-2013:p0878:b004:l007","ordinal":143370,"en":"The forty warriors advanced in a fury,"},{"id":"semetey-1-2013:p0878:b004:l008","ordinal":143371,"en":"Speaking against the only son Semetey:"},{"id":"semetey-1-2013:p0878:b004:l009","ordinal":143372,"en":"‘To Temir Khan's city,"},{"id":"semetey-1-2013:p0878:b004:l010","ordinal":143373,"en":"The orphan who wandered away—"},{"id":"semetey-1-2013:p0878:b004:l011","ordinal":143374,"en":"Trample him and seize him!"},{"id":"semetey-1-2013:p0878:b004:l012","ordinal":143375,"en":"Drag him out upon the road,"},{"id":"semetey-1-2013:p0878:b004:l013","ordinal":143376,"en":"And slaughter him as a sacrifice!"},{"id":"semetey-1-2013:p0878:b004:l014","ordinal":143377,"en":"Drag Kanykei out,"},{"id":"semetey-1-2013:p0878:b004:l015","ordinal":143378,"en":"And tear her apart for the great hounds."},{"id":"semetey-1-2013:p0878:b004:l016","ordinal":143379,"en":"Beat old Bakai with clubs,"},{"id":"semetey-1-2013:p0878:b004:l017","ordinal":143380,"en":"And put him behind a camel."},{"id":"semetey-1-2013:p0878:b004:l018","ordinal":143381,"en":"Sary Taz, who stirred up trouble—"},{"id":"semetey-1-2013:p0878:b004:l019","ordinal":143382,"en":"Gouge out his eyes!"},{"id":"semetey-1-2013:p0878:b004:l020","ordinal":143383,"en":"Seize him, seize him, seize him!"},{"id":"semetey-1-2013:p0878:b004:l021","ordinal":143384,"en":"Bind the orphan slave!’ they cried."},{"id":"semetey-1-2013:p0878:b004:l022","ordinal":143385,"en":"Unable to reach the great court,"},{"id":"semetey-1-2013:p0878:b004:l023","ordinal":143386,"en":"Nor daring to go in against the boy,"},{"id":"semetey-1-2013:p0878:b004:l024","ordinal":143387,"en":"They took turns,"},{"id":"semetey-1-2013:p0878:b004:l025","ordinal":143388,"en":"Firing their guns."},{"id":"semetey-1-2013:p0878:b004:l026","ordinal":143389,"en":"They stood unable to enter,"},{"id":"semetey-1-2013:p0878:b004:l027","ordinal":143390,"en":"And fought with their guns."},{"id":"semetey-1-2013:p0878:b004:l029","ordinal":143391,"en":"Broad-mouthed, painted arrows—","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0878:b004:l030","ordinal":143392,"en":"Their fighting was a wondrous tale."},{"id":"semetey-1-2013:p0878:b004:l031","ordinal":143393,"en":"All were warriors left by Manas."},{"id":"semetey-1-2013:p0878:b004:l035","ordinal":143394,"en":"Mingling sound with sound,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0878:b004:l036","ordinal":143395,"en":"They fired with a mighty thunder."},{"id":"semetey-1-2013:p0878:b004:l037","ordinal":143396,"en":"As they fired without sparing themselves,"},{"id":"semetey-1-2013:p0878:b004:l038","ordinal":143397,"en":"The short guns in their hands"},{"id":"semetey-1-2013:p0878:b004:l039","ordinal":143398,"en":"Joined their voices together,"},{"id":"semetey-1-2013:p0879:b003:l001","ordinal":143399,"en":"Smoke streamed from their mouths."},{"id":"semetey-1-2013:p0879:b003:l002","ordinal":143400,"en":"The steel guns' bullets shrieked;"},{"id":"semetey-1-2013:p0879:b003:l003","ordinal":143401,"en":"Chipping away with every hit,"},{"id":"semetey-1-2013:p0879:b003:l004","ordinal":143402,"en":"The court's walls crumbled."},{"id":"semetey-1-2013:p0879:b003:l005","ordinal":143403,"en":"The guns' voices clattered,"},{"id":"semetey-1-2013:p0879:b003:l006","ordinal":143404,"en":"The arrows pattered."},{"id":"semetey-1-2013:p0879:b003:l007","ordinal":143405,"en":"God, do not let us see their faces!"},{"id":"semetey-1-2013:p0879:b003:l008","ordinal":143406,"en":"Like peas roasting,"},{"id":"semetey-1-2013:p0879:b003:l009","ordinal":143407,"en":"They stood without sparing themselves,"},{"id":"semetey-1-2013:p0879:b003:l010","ordinal":143408,"en":"And all fought together."},{"id":"semetey-1-2013:p0879:b003:l011","ordinal":143409,"en":"With the forty warriors at their head,"},{"id":"semetey-1-2013:p0879:b003:l012","ordinal":143410,"en":"They all swept down together."},{"id":"semetey-1-2013:p0879:b003:l013","ordinal":143411,"en":"Your orphan's court"},{"id":"semetey-1-2013:p0879:b003:l014","ordinal":143412,"en":"They encircled twelve times."},{"id":"semetey-1-2013:p0879:b003:l017","ordinal":143413,"en":"Look at the haze, look at the fire!","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0879:b003:l018","ordinal":143414,"en":"Almighty One, whose command is strong,"},{"id":"semetey-1-2013:p0879:b003:l019","ordinal":143415,"en":"Look at the bullets striking without turning aside!"},{"id":"semetey-1-2013:p0879:b003:l020","ordinal":143416,"en":"When they came to besiege it,"},{"id":"semetey-1-2013:p0879:b003:l021","ordinal":143417,"en":"Gray haze and burning dust arose."},{"id":"semetey-1-2013:p0879:b003:l022","ordinal":143418,"en":"‘What will become of my only son?’"},{"id":"semetey-1-2013:p0879:b003:l023","ordinal":143419,"en":"Two souls stood weeping."},{"id":"semetey-1-2013:p0879:b003:l024","ordinal":143420,"en":"‘The orphan who does not stir—"},{"id":"semetey-1-2013:p0879:b003:l025","ordinal":143421,"en":"They may suddenly overwhelm him."},{"id":"semetey-1-2013:p0879:b003:l026","ordinal":143422,"en":"The orphan gained through mortal suffering—"},{"id":"semetey-1-2013:p0879:b003:l027","ordinal":143423,"en":"His death may come needlessly,’ they thought."},{"id":"semetey-1-2013:p0879:b003:l028","ordinal":143424,"en":"That valiant mother of yours, Kanykei,"},{"id":"semetey-1-2013:p0879:b003:l029","ordinal":143425,"en":"Her heart greatly troubled,"},{"id":"semetey-1-2013:p0879:b003:l030","ordinal":143426,"en":"Tears pouring from her eyes,"},{"id":"semetey-1-2013:p0879:b003:l031","ordinal":143427,"en":"Allah's sun clouded in the heavens,"},{"id":"semetey-1-2013:p0879:b003:l032","ordinal":143428,"en":"Sixty anxieties came upon her at once."},{"id":"semetey-1-2013:p0879:b003:l033","ordinal":143429,"en":"Your valiant mother Kanykei—"},{"id":"semetey-1-2013:p0879:b003:l034","ordinal":143430,"en":"Do not ask of the unfortunate woman's plight."},{"id":"semetey-1-2013:p0879:b003:l035","ordinal":143431,"en":"Almambet's painted musket"},{"id":"semetey-1-2013:p0879:b003:l036","ordinal":143432,"en":"She took into her hands."},{"id":"semetey-1-2013:p0879:b003:l037","ordinal":143433,"en":"Leaning to the right, she fired once,"},{"id":"semetey-1-2013:p0879:b003:l039","ordinal":143434,"en":"Leaning to the left, she fired once,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0879:b004:l001","ordinal":143435,"en":"And felled their sultans."},{"id":"semetey-1-2013:p0879:b004:l002","ordinal":143436,"en":"Without revealing she was a woman,"},{"id":"semetey-1-2013:p0879:b004:l003","ordinal":143437,"en":"Those dogs Abyke and Kobosh"},{"id":"semetey-1-2013:p0879:b004:l004","ordinal":143438,"en":"She kept from entering the court."},{"id":"semetey-1-2013:p0879:b004:l005","ordinal":143439,"en":"Heroically built, an extraordinary warrior,"},{"id":"semetey-1-2013:p0879:b004:l006","ordinal":143440,"en":"Your precious mother Kanykei"},{"id":"semetey-1-2013:p0879:b004:l007","ordinal":143441,"en":"Showed extraordinary courage."},{"id":"semetey-1-2013:p0879:b004:l008","ordinal":143442,"en":"She kept asking God for help."},{"id":"semetey-1-2013:p0879:b004:l009","ordinal":143443,"en":"Your dear mother Kanykei"},{"id":"semetey-1-2013:p0879:b004:l010","ordinal":143444,"en":"Displayed a mighty, fearsome power."},{"id":"semetey-1-2013:p0879:b004:l011","ordinal":143445,"en":"Then the rascal son of Manas,"},{"id":"semetey-1-2013:p0879:b004:l012","ordinal":143446,"en":"Utterly unconcerned,"},{"id":"semetey-1-2013:p0879:b004:l013","ordinal":143447,"en":"The young lord, that hero,"},{"id":"semetey-1-2013:p0879:b004:l014","ordinal":143448,"en":"Did not draw back his outstretched legs,"},{"id":"semetey-1-2013:p0879:b004:l015","ordinal":143449,"en":"Nor open his closed eyes."},{"id":"semetey-1-2013:p0879:b004:l016","ordinal":143450,"en":"He slept soundly without a care."},{"id":"semetey-1-2013:p0879:b004:l017","ordinal":143451,"en":"The enemy surrounding him"},{"id":"semetey-1-2013:p0879:b004:l018","ordinal":143452,"en":"He did not consider them worth a thing."},{"id":"semetey-1-2013:p0879:b004:l019","ordinal":143453,"en":"Then, in Chachykei's fortress,"},{"id":"semetey-1-2013:p0879:b004:l020","ordinal":143454,"en":"In Kanykei's royal court,"},{"id":"semetey-1-2013:p0879:b004:l021","ordinal":143455,"en":"When it was nearly noon,"},{"id":"semetey-1-2013:p0879:b004:l022","ordinal":143456,"en":"He woke with a start."},{"id":"semetey-1-2013:p0879:b004:l023","ordinal":143457,"en":"Turning onto his right side,"},{"id":"semetey-1-2013:p0879:b004:l025","ordinal":143458,"en":"He stretched like a gray tiger.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0879:b004:l026","ordinal":143459,"en":"He put his hands in water,"},{"id":"semetey-1-2013:p0879:b004:l027","ordinal":143460,"en":"Performed the washing of his hands,"},{"id":"semetey-1-2013:p0879:b004:l028","ordinal":143461,"en":"And pleaded with the one God."},{"id":"semetey-1-2013:p0879:b004:l029","ordinal":143462,"en":"Startled, he recited his prayer,"},{"id":"semetey-1-2013:p0879:b004:l030","ordinal":143463,"en":"And saddled the noble steed."},{"id":"semetey-1-2013:p0879:b004:l031","ordinal":143464,"en":"He leaped from his place and ran,"},{"id":"semetey-1-2013:p0879:b004:l032","ordinal":143465,"en":"Put on Akolpok,"},{"id":"semetey-1-2013:p0879:b004:l033","ordinal":143466,"en":"And pleaded with the Creator."},{"id":"semetey-1-2013:p0879:b004:l034","ordinal":143467,"en":"Boz Kise, left by Manas,"},{"id":"semetey-1-2013:p0879:b004:l035","ordinal":143468,"en":"He took and fastened at his waist."},{"id":"semetey-1-2013:p0879:b004:l036","ordinal":143469,"en":"Preparing his equipment,"},{"id":"semetey-1-2013:p0879:b004:l037","ordinal":143470,"en":"Your poor child, the lord's son,"},{"id":"semetey-1-2013:p0879:b004:l038","ordinal":143471,"en":"Like a cloud about to rain again,"},{"id":"semetey-1-2013:p0879:b004:l039","ordinal":143472,"en":"Had wrath gathering upon his face."},{"id":"semetey-1-2013:p0880:b003:l001","ordinal":143473,"en":"Of the six keen weapons fallen from heaven,"},{"id":"semetey-1-2013:p0880:b003:l002","ordinal":143474,"en":"The choicest of swords,"},{"id":"semetey-1-2013:p0880:b003:l003","ordinal":143475,"en":"Zulfiqar, which Manas had obtained—"},{"id":"semetey-1-2013:p0880:b003:l004","ordinal":143476,"en":"When drawn from its sheath with a shout,"},{"id":"semetey-1-2013:p0880:b003:l005","ordinal":143477,"en":"It never went idly without drinking blood."},{"id":"semetey-1-2013:p0880:b003:l006","ordinal":143478,"en":"Unless it drank its fill of blood,"},{"id":"semetey-1-2013:p0880:b003:l007","ordinal":143479,"en":"It would not enter its sheath when put away."},{"id":"semetey-1-2013:p0880:b003:l008","ordinal":143480,"en":"When swung, it never returned empty."},{"id":"semetey-1-2013:p0880:b003:l009","ordinal":143481,"en":"When swung in wrath,"},{"id":"semetey-1-2013:p0880:b003:l010","ordinal":143482,"en":"Its sharpness was plain to see;"},{"id":"semetey-1-2013:p0880:b003:l011","ordinal":143483,"en":"At a stroke, an elephant split in two."},{"id":"semetey-1-2013:p0880:b003:l012","ordinal":143484,"en":"Hardened through drinking blood,"},{"id":"semetey-1-2013:p0880:b003:l013","ordinal":143485,"en":"Khan Manas, who wielded it,"},{"id":"semetey-1-2013:p0880:b003:l014","ordinal":143486,"en":"Was called the ‘blood-drinking Burut.’"},{"id":"semetey-1-2013:p0880:b003:l015","ordinal":143487,"en":"Its sharpness was known to the people,"},{"id":"semetey-1-2013:p0880:b003:l016","ordinal":143488,"en":"An inheritance left by his father Manas."},{"id":"semetey-1-2013:p0880:b003:l017","ordinal":143489,"en":"Composing himself in wrath,"},{"id":"semetey-1-2013:p0880:b003:l018","ordinal":143490,"en":"He fastened on Zulfiqar."},{"id":"semetey-1-2013:p0880:b003:l020","ordinal":143491,"en":"Your father's friend Bolokbai,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0880:b003:l021","ordinal":143492,"en":"Who had stirred the Altai Khan star in heaven—"},{"id":"semetey-1-2013:p0880:b003:l023","ordinal":143493,"en":"David and Bolokbai"},{"id":"semetey-1-2013:p0880:b003:l024","ordinal":143494,"en":"Had made friendship sixty times."},{"id":"semetey-1-2013:p0880:b003:l025","ordinal":143495,"en":"Weeping bitterly to the one God,"},{"id":"semetey-1-2013:p0880:b003:l026","ordinal":143496,"en":"‘Let the orphan take it when he comes;"},{"id":"semetey-1-2013:p0880:b003:l027","ordinal":143497,"en":"If my orphan comes safely,"},{"id":"semetey-1-2013:p0880:b003:l028","ordinal":143498,"en":"Let him bring terror upon the foe,’ he said."},{"id":"semetey-1-2013:p0880:b003:l029","ordinal":143499,"en":"The toiling smith Bolokbai,"},{"id":"semetey-1-2013:p0880:b003:l031","ordinal":143500,"en":"Joined with David,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0880:b003:l032","ordinal":143501,"en":"And made the white battle-axe."},{"id":"semetey-1-2013:p0880:b003:l033","ordinal":143502,"en":"He had gold beaten onto its handle,"},{"id":"semetey-1-2013:p0880:b003:l034","ordinal":143503,"en":"And poison spread upon its edge."},{"id":"semetey-1-2013:p0880:b003:l035","ordinal":143504,"en":"‘If only it were my axe,’"},{"id":"semetey-1-2013:p0880:b003:l036","ordinal":143505,"en":"The mighty men who saw it admired it."},{"id":"semetey-1-2013:p0880:b003:l037","ordinal":143506,"en":"He fashioned its edge of steel,"},{"id":"semetey-1-2013:p0880:b003:l038","ordinal":143507,"en":"‘May everyone it strikes"},{"id":"semetey-1-2013:p0880:b003:l039","ordinal":143508,"en":"Be overcome and die,’ he said."},{"id":"semetey-1-2013:p0880:b004:l001","ordinal":143509,"en":"In dragon's poison,"},{"id":"semetey-1-2013:p0880:b004:l002","ordinal":143510,"en":"He tempered it sixty times."},{"id":"semetey-1-2013:p0880:b004:l003","ordinal":143511,"en":"When it came to its charcoal,"},{"id":"semetey-1-2013:p0880:b004:l004","ordinal":143512,"en":"The Boiorokcho forest was consumed."},{"id":"semetey-1-2013:p0880:b004:l005","ordinal":143513,"en":"When it came to its bellows,"},{"id":"semetey-1-2013:p0880:b004:l006","ordinal":143514,"en":"Many young bulls were slaughtered."},{"id":"semetey-1-2013:p0880:b004:l007","ordinal":143515,"en":"Lest the handle strike off to one side,"},{"id":"semetey-1-2013:p0880:b004:l008","ordinal":143516,"en":"Of honeysuckle and meadowsweet,"},{"id":"semetey-1-2013:p0880:b004:l009","ordinal":143517,"en":"He fashioned a curved handle."},{"id":"semetey-1-2013:p0880:b004:l010","ordinal":143518,"en":"Lest the handle split,"},{"id":"semetey-1-2013:p0880:b004:l011","ordinal":143519,"en":"He had it covered with elephant hide."},{"id":"semetey-1-2013:p0880:b004:l012","ordinal":143520,"en":"So no mishap would occur,"},{"id":"semetey-1-2013:p0880:b004:l013","ordinal":143521,"en":"So it would not fly from the hand,"},{"id":"semetey-1-2013:p0880:b004:l014","ordinal":143522,"en":"He had an autumn gelded goat slaughtered."},{"id":"semetey-1-2013:p0880:b004:l015","ordinal":143523,"en":"The hide of that goat"},{"id":"semetey-1-2013:p0880:b004:l016","ordinal":143524,"en":"He had made into suede,"},{"id":"semetey-1-2013:p0880:b004:l017","ordinal":143525,"en":"Had strongmen stretch it,"},{"id":"semetey-1-2013:p0880:b004:l018","ordinal":143526,"en":"Twisted it into shape,"},{"id":"semetey-1-2013:p0880:b004:l019","ordinal":143527,"en":"And made it into a wrist loop."},{"id":"semetey-1-2013:p0880:b004:l020","ordinal":143528,"en":"The exceptional smith Bolokbai,"},{"id":"semetey-1-2013:p0880:b004:l021","ordinal":143529,"en":"‘Let the noble orphan take it,’ he said,"},{"id":"semetey-1-2013:p0880:b004:l022","ordinal":143530,"en":"Deliberately choosing, fired with zeal,"},{"id":"semetey-1-2013:p0880:b004:l023","ordinal":143531,"en":"Had made a surpassing battle-axe."},{"id":"semetey-1-2013:p0880:b004:l024","ordinal":143532,"en":"Your orphan took it,"},{"id":"semetey-1-2013:p0880:b004:l025","ordinal":143533,"en":"Pleading with the one God,"},{"id":"semetey-1-2013:p0880:b004:l026","ordinal":143534,"en":"And fastened it snugly at his waist."},{"id":"semetey-1-2013:p0880:b004:l027","ordinal":143535,"en":"The living gun Akkelte—"},{"id":"semetey-1-2013:p0880:b004:l028","ordinal":143536,"en":"For shooting, that was the steel weapon;"},{"id":"semetey-1-2013:p0880:b004:l029","ordinal":143537,"en":"Against a grappling enemy,"},{"id":"semetey-1-2013:p0880:b004:l030","ordinal":143538,"en":"That was the treasure that caused distress."},{"id":"semetey-1-2013:p0880:b004:l031","ordinal":143539,"en":"Smoke clogged its ear;"},{"id":"semetey-1-2013:p0880:b004:l032","ordinal":143540,"en":"With every pull, it grew stronger."},{"id":"semetey-1-2013:p0880:b004:l033","ordinal":143541,"en":"The enemy hearing its voice"},{"id":"semetey-1-2013:p0880:b004:l034","ordinal":143542,"en":"Was thrown into roaring confusion."},{"id":"semetey-1-2013:p0880:b004:l035","ordinal":143543,"en":"When its piercing voice rang out,"},{"id":"semetey-1-2013:p0880:b004:l036","ordinal":143544,"en":"It rumbled like a camel with her calf."},{"id":"semetey-1-2013:p0880:b004:l037","ordinal":143545,"en":"On hearing its mighty voice,"},{"id":"semetey-1-2013:p0880:b004:l038","ordinal":143546,"en":"The enemy could not stand and watch,"},{"id":"semetey-1-2013:p0880:b004:l039","ordinal":143547,"en":"But fled back, trembling."},{"id":"semetey-1-2013:p0881:b003:l001","ordinal":143548,"en":"If its bullet struck squarely,"},{"id":"semetey-1-2013:p0881:b003:l002","ordinal":143549,"en":"Not a handspan of bone remained."},{"id":"semetey-1-2013:p0881:b003:l003","ordinal":143550,"en":"No enemy could face it."},{"id":"semetey-1-2013:p0881:b003:l004","ordinal":143551,"en":"When they heard Akkelte's voice,"},{"id":"semetey-1-2013:p0881:b003:l005","ordinal":143552,"en":"The Chinese in Beijing fell into turmoil."},{"id":"semetey-1-2013:p0881:b003:l006","ordinal":143553,"en":"Akkelte, the weapon to fire,"},{"id":"semetey-1-2013:p0881:b003:l007","ordinal":143554,"en":"An inheritance left by his father Manas—"},{"id":"semetey-1-2013:p0881:b003:l008","ordinal":143555,"en":"Semetey, born a lion,"},{"id":"semetey-1-2013:p0881:b003:l009","ordinal":143556,"en":"Slung it across his shoulder blade."},{"id":"semetey-1-2013:p0881:b003:l010","ordinal":143557,"en":"That dear hero stood tall,"},{"id":"semetey-1-2013:p0881:b003:l011","ordinal":143558,"en":"Against the crouching enemy,"},{"id":"semetey-1-2013:p0881:b003:l012","ordinal":143559,"en":"He brought upheaval to that place."},{"id":"semetey-1-2013:p0881:b003:l013","ordinal":143560,"en":"His father, magnanimous Manas—"},{"id":"semetey-1-2013:p0881:b003:l014","ordinal":143561,"en":"He was a dear lion born surpassing him."},{"id":"semetey-1-2013:p0881:b003:l015","ordinal":143562,"en":"Turning and setting himself right,"},{"id":"semetey-1-2013:p0881:b003:l016","ordinal":143563,"en":"Gathering strength like a lion,"},{"id":"semetey-1-2013:p0881:b003:l017","ordinal":143564,"en":"He wrapped himself in Akolpok."},{"id":"semetey-1-2013:p0881:b003:l018","ordinal":143565,"en":"If you would look upon Semetey,"},{"id":"semetey-1-2013:p0881:b003:l019","ordinal":143566,"en":"He surged like a white tiger,"},{"id":"semetey-1-2013:p0881:b003:l020","ordinal":143567,"en":"To Manas, who went to the other world,"},{"id":"semetey-1-2013:p0881:b003:l021","ordinal":143568,"en":"Pleading with his spirit."},{"id":"semetey-1-2013:p0881:b003:l022","ordinal":143569,"en":"His eyes blazed fiercely like fire,"},{"id":"semetey-1-2013:p0881:b003:l023","ordinal":143570,"en":"His thirst for blood seized him in earnest."},{"id":"semetey-1-2013:p0881:b003:l024","ordinal":143571,"en":"His dear teeth, as broad as doors,"},{"id":"semetey-1-2013:p0881:b003:l025","ordinal":143572,"en":"Crumbled like grains of millet."},{"id":"semetey-1-2013:p0881:b003:l026","ordinal":143573,"en":"From both corners of his mouth, blue flame—"},{"id":"semetey-1-2013:p0881:b003:l027","ordinal":143574,"en":"Blue flame poured out, hissing."},{"id":"semetey-1-2013:p0881:b003:l028","ordinal":143575,"en":"Courage radiated from his head,"},{"id":"semetey-1-2013:p0881:b003:l029","ordinal":143576,"en":"His lion's nature showed."},{"id":"semetey-1-2013:p0881:b003:l030","ordinal":143577,"en":"The young lord was a hero,"},{"id":"semetey-1-2013:p0881:b003:l031","ordinal":143578,"en":"His father, magnanimous Manas,"},{"id":"semetey-1-2013:p0881:b003:l032","ordinal":143579,"en":"He resembled without the slightest difference."},{"id":"semetey-1-2013:p0881:b003:l033","ordinal":143580,"en":"Surging forth on his own,"},{"id":"semetey-1-2013:p0881:b003:l034","ordinal":143581,"en":"At the entrance to the court,"},{"id":"semetey-1-2013:p0881:b003:l035","ordinal":143582,"en":"He appeared before his mother Kanykei."},{"id":"semetey-1-2013:p0881:b003:l036","ordinal":143583,"en":"When they saw their only son,"},{"id":"semetey-1-2013:p0881:b003:l037","ordinal":143584,"en":"Kanykei in her advancing years,"},{"id":"semetey-1-2013:p0881:b003:l038","ordinal":143585,"en":"Chiyyrdy in her old age,"},{"id":"semetey-1-2013:p0881:b003:l039","ordinal":143586,"en":"Both his mothers wept."},{"id":"semetey-1-2013:p0881:b005:l001","ordinal":143587,"en":"Then your leopard-mother Kanykei"},{"id":"semetey-1-2013:p0881:b005:l002","ordinal":143588,"en":"Appeared weighed down with sorrow,"},{"id":"semetey-1-2013:p0881:b005:l003","ordinal":143589,"en":"Her heart torn apart."},{"id":"semetey-1-2013:p0881:b005:l004","ordinal":143590,"en":"Both his mothers together"},{"id":"semetey-1-2013:p0881:b005:l005","ordinal":143591,"en":"Led Buurul, as great as a camel,"},{"id":"semetey-1-2013:p0881:b005:l006","ordinal":143592,"en":"And brought him before the boy."},{"id":"semetey-1-2013:p0881:b005:l007","ordinal":143593,"en":"Hanging their belts about their necks,"},{"id":"semetey-1-2013:p0881:b005:l008","ordinal":143594,"en":"To the one Creator God,"},{"id":"semetey-1-2013:p0881:b005:l009","ordinal":143595,"en":"‘Give him aid!’ they pleaded."},{"id":"semetey-1-2013:p0881:b005:l010","ordinal":143596,"en":"Both his mothers wept,"},{"id":"semetey-1-2013:p0881:b005:l011","ordinal":143597,"en":"Spreading their palms and saying, ‘Amen!’"},{"id":"semetey-1-2013:p0881:b005:l012","ordinal":143598,"en":"They cried aloud, pressed close together."},{"id":"semetey-1-2013:p0881:b005:l013","ordinal":143599,"en":"The poor, true elder wives"},{"id":"semetey-1-2013:p0881:b005:l014","ordinal":143600,"en":"Entrusted him to the one God."},{"id":"semetey-1-2013:p0881:b005:l015","ordinal":143601,"en":"‘My spring that feeds the valley's river,"},{"id":"semetey-1-2013:p0881:b005:l016","ordinal":143602,"en":"My lamp gained through mortal suffering!"},{"id":"semetey-1-2013:p0881:b005:l017","ordinal":143603,"en":"My hoof left by the peerless steed,"},{"id":"semetey-1-2013:p0881:b005:l019","ordinal":143604,"en":"My flag fixed upon a spear,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0881:b005:l020","ordinal":143605,"en":"My gift left by the magnanimous hero!"},{"id":"semetey-1-2013:p0881:b005:l021","ordinal":143606,"en":"My poor child, because of you,"},{"id":"semetey-1-2013:p0881:b005:l022","ordinal":143607,"en":"Both your mothers weep,"},{"id":"semetey-1-2013:p0881:b005:l023","ordinal":143608,"en":"Both tormenting their precious souls."},{"id":"semetey-1-2013:p0881:b005:l024","ordinal":143609,"en":"Our poor souls cannot escape our grief."},{"id":"semetey-1-2013:p0881:b005:l026","ordinal":143610,"en":"The lamp gained through mortal suffering,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0881:b005:l027","ordinal":143611,"en":"Both your poor mothers lean upon."},{"id":"semetey-1-2013:p0881:b005:l028","ordinal":143612,"en":"Passing through dark places,"},{"id":"semetey-1-2013:p0881:b005:l029","ordinal":143613,"en":"We came back to this place,"},{"id":"semetey-1-2013:p0881:b005:l030","ordinal":143614,"en":"My orphan, taking you as our protection."},{"id":"semetey-1-2013:p0881:b005:l031","ordinal":143615,"en":"Cursed be that protection!"},{"id":"semetey-1-2013:p0881:b005:l032","ordinal":143616,"en":"It seems we came here to die,"}]
