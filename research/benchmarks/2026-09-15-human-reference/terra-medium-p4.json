{
  "lines": [
    {"line": 1, "english": "Kochku came in a show of strength,", "note": ""},
    {"line": 2, "english": "with his champions in scores of forty,", "note": ""},
    {"line": 3, "english": "mounted on red-dun horses,", "note": ""},
    {"line": 4, "english": "setting out in anger,", "note": ""},
    {"line": 5, "english": "having received a letter from Esen Khan.", "note": ""},
    {"line": 6, "english": "What was poor Kochku to do?", "note": ""},
    {"line": 7, "english": "Taking men from among the skilled guards,", "note": ""},
    {"line": 8, "english": "the experts at thrusting spears,", "note": ""},
    {"line": 9, "english": "he took a force of about seven hundred;", "note": ""},
    {"line": 10, "english": "thus had that Kochku come,", "note": ""},
    {"line": 11, "english": "making his outer garment flutter,", "note": ""},
    {"line": 12, "english": "making his coat of mail gleam,", "note": ""},
    {"line": 13, "english": "with dust flying up to the sky,", "note": ""},
    {"line": 14, "english": "as the army marched, raising dust.", "note": ""},
    {"line": 15, "english": "What the soldiers bore", "note": ""},
    {"line": 16, "english": "were great bows and secret arrows.", "note": ""},
    {"line": 17, "english": "To Bay Jakyp's ears", "note": ""},
    {"line": 18, "english": "the news was brought.", "note": ""},
    {"line": 19, "english": "His bellowing split the stones;", "note": ""},
    {"line": 20, "english": "Kochku came worked up,", "note": ""},
    {"line": 21, "english": "his shouting splitting heads:", "note": ""}
  ]
}
