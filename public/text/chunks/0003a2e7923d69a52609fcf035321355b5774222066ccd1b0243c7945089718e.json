[{"id":"sayakbay-ms-current144:pdf164:l001","ordinal":392705,"en":"How long did he play there?"},{"id":"sayakbay-ms-current144:pdf164:l002","ordinal":392706,"en":"“I am free after taking down the load.”"},{"id":"sayakbay-ms-current144:pdf164:l004","ordinal":392707,"en":"I shall see what stratagem he uses."},{"id":"sayakbay-ms-current144:pdf164:l005","ordinal":392708,"en":"Hero Joltoy struck him."},{"id":"sayakbay-ms-current144:pdf164:l006","ordinal":392709,"en":"May he not surrender the life entrusted to him."},{"id":"sayakbay-ms-current144:pdf164:l007","ordinal":392710,"en":"Let his people become a dark mass."},{"id":"sayakbay-ms-current144:pdf164:l008","ordinal":392711,"en":"Your vast anger rose high."},{"id":"sayakbay-ms-current144:pdf164:l010","ordinal":392712,"en":"Let Seitek act without delay."},{"id":"sayakbay-ms-current144:pdf164:l011","ordinal":392713,"en":"Let him spread out his summer gear."},{"id":"sayakbay-ms-current144:pdf164:l012","ordinal":392714,"en":"Now let the challenger advance."},{"id":"sayakbay-ms-current144:pdf164:l013","ordinal":392715,"en":"Let them grapple until their souls reel."},{"id":"sayakbay-ms-current144:pdf164:l014","ordinal":392716,"en":"If the two still possess their free lives,"},{"id":"sayakbay-ms-current144:pdf164:l015","ordinal":392717,"en":"they called it the blue water of Adyr."},{"id":"sayakbay-ms-current144:pdf164:l016","ordinal":392718,"en":"Its pouring flood was like three dunes."},{"id":"sayakbay-ms-current144:pdf164:l017","ordinal":392719,"en":"Each day they bent under the strain."},{"id":"sayakbay-ms-current144:pdf164:l018","ordinal":392720,"en":"Yesterday his eyes glared as he shouted."},{"id":"sayakbay-ms-current144:pdf164:l019","ordinal":392721,"en":"When he struck and split the earth,"},{"id":"sayakbay-ms-current144:pdf164:l020","ordinal":392722,"en":"he became like a star from the sky."},{"id":"sayakbay-ms-current144:pdf164:l021","ordinal":392723,"en":"He fell, cleaving into the ground."},{"id":"sayakbay-ms-current144:pdf164:l022","ordinal":392724,"en":"At dawn, the two young men’s"},{"id":"sayakbay-ms-current144:pdf164:l023","ordinal":392725,"en":"dripping foam scattered about."},{"id":"sayakbay-ms-current144:pdf164:l024","ordinal":392726,"en":"Water thundered through the valley."},{"id":"sayakbay-ms-current144:pdf164:l025","ordinal":392727,"en":"The grasses he knew swayed softly."},{"id":"sayakbay-ms-current144:pdf164:l026","ordinal":392728,"en":"Across the hollow of countless graves,"},{"id":"sayakbay-ms-current144:pdf164:l027","ordinal":392729,"en":"their tops trembled whenever the wind blew."},{"id":"sayakbay-ms-current144:pdf165:l001","ordinal":392730,"en":"From a peak beyond the eye’s reach,"},{"id":"sayakbay-ms-current144:pdf165:l002","ordinal":392731,"en":"the mountain seemed ready to scatter like dust."},{"id":"sayakbay-ms-current144:pdf165:l003","ordinal":392732,"en":"The mountain summit came into view."},{"id":"sayakbay-ms-current144:pdf165:l004","ordinal":392733,"en":"Its flames divided into a thousand branches."},{"id":"sayakbay-ms-current144:pdf165:l005","ordinal":392734,"en":"Alas, it was broken into hollows and rises."},{"id":"sayakbay-ms-current144:pdf165:l006","ordinal":392735,"en":"From a tower beyond the eye’s reach,"},{"id":"sayakbay-ms-current144:pdf165:l007","ordinal":392736,"en":"the mountain summit could be seen."},{"id":"sayakbay-ms-current144:pdf165:l008","ordinal":392737,"en":"They were already tearing it down."},{"id":"sayakbay-ms-current144:pdf165:l009","ordinal":392738,"en":"Far away, where the beast stood,"},{"id":"sayakbay-ms-current144:pdf165:l010","ordinal":392739,"en":"they had fastened it with a rope."},{"id":"sayakbay-ms-current144:pdf165:l011","ordinal":392740,"en":"When the day began to demand its due,"},{"id":"sayakbay-ms-current144:pdf165:l012","ordinal":392741,"en":"into the valley of the blue dome,"},{"id":"sayakbay-ms-current144:pdf165:l013","ordinal":392742,"en":"toward a warrior beyond the eye’s reach,"},{"id":"sayakbay-ms-current144:pdf165:l014","ordinal":392743,"en":"hero Seitek descended to the ground."},{"id":"sayakbay-ms-current144:pdf165:l015","ordinal":392744,"en":"There were many mottled peaks."},{"id":"sayakbay-ms-current144:pdf165:l016","ordinal":392745,"en":"Now the land was a place of pouring torrents."},{"id":"sayakbay-ms-current144:pdf165:l017","ordinal":392746,"en":"The spring flowed and overflowed."},{"id":"sayakbay-ms-current144:pdf165:l018","ordinal":392747,"en":"The nightingale sang out melodiously."},{"id":"sayakbay-ms-current144:pdf165:l019","ordinal":392748,"en":"No person turned away from its fragrance."},{"id":"sayakbay-ms-current144:pdf165:l020","ordinal":392749,"en":"The black-eared beasts fled."},{"id":"sayakbay-ms-current144:pdf165:l021","ordinal":392750,"en":"No eagle had ever perched there."},{"id":"sayakbay-ms-current144:pdf165:l022","ordinal":392751,"en":"Many souls cried out in commotion."},{"id":"sayakbay-ms-current144:pdf165:l023","ordinal":392752,"en":"From the three-eared headland,"},{"id":"sayakbay-ms-current144:pdf165:l024","ordinal":392753,"en":"within it rose three islands."},{"id":"sayakbay-ms-current144:pdf165:l026","ordinal":392754,"en":"he had gone away for no cause."},{"id":"sayakbay-ms-current144:pdf165:l027","ordinal":392755,"en":"Had the sun already gone down?"},{"id":"sayakbay-ms-current144:pdf166:l001","ordinal":392756,"en":"[The great mountain clattered],"},{"id":"sayakbay-ms-current144:pdf166:l002","ordinal":392757,"en":"[Its peak was worn away],"},{"id":"sayakbay-ms-current144:pdf166:l003","ordinal":392758,"en":"Cliffs split and water fell,"},{"id":"sayakbay-ms-current144:pdf166:l005","ordinal":392759,"en":"The surroundings were hazy,"},{"id":"sayakbay-ms-current144:pdf166:l006","ordinal":392760,"en":"[Seitek saw it while rushing],"},{"id":"sayakbay-ms-current144:pdf166:l008","ordinal":392761,"en":"[Their bullets whistled],"},{"id":"sayakbay-ms-current144:pdf166:l009","ordinal":392762,"en":"The war drums thundered,"},{"id":"sayakbay-ms-current144:pdf166:l010","ordinal":392763,"en":"He raised the battle cry with a roar."},{"id":"sayakbay-ms-current144:pdf166:l012","ordinal":392764,"en":"That an enemy had advanced,"},{"id":"sayakbay-ms-current144:pdf166:l013","ordinal":392765,"en":"[Now leaning back, he called his battle cry]."},{"id":"sayakbay-ms-current144:pdf166:l014","ordinal":392766,"en":"His ninety giants had overwhelmed him,"},{"id":"sayakbay-ms-current144:pdf166:l015","ordinal":392767,"en":"Without rope, without cord,"},{"id":"sayakbay-ms-current144:pdf166:l016","ordinal":392768,"en":"[All swarmed, leaving no enemy apart],"},{"id":"sayakbay-ms-current144:pdf166:l021","ordinal":392769,"en":"[They plunged him into visible misery],"},{"id":"sayakbay-ms-current144:pdf166:l030","ordinal":392770,"en":"Your dear elder was undone."},{"id":"sayakbay-ms-current144:pdf167:l002","ordinal":392771,"en":"Your poor elder was like a slender shrub."},{"id":"sayakbay-ms-current144:pdf167:l003","ordinal":392772,"en":"[He had stature but no strength],"},{"id":"sayakbay-ms-current144:pdf167:l004","ordinal":392773,"en":"Such is this filthy world."},{"id":"sayakbay-ms-current144:pdf167:l006","ordinal":392774,"en":"Your elder had encountered it."},{"id":"sayakbay-ms-current144:pdf167:l009","ordinal":392775,"en":"To the wrath of the wrathful,"},{"id":"sayakbay-ms-current144:pdf167:l010","ordinal":392776,"en":"The poor warrior had succumbed."},{"id":"sayakbay-ms-current144:pdf167:l012","ordinal":392777,"en":"[Perhaps he fell without trusting fate],"},{"id":"sayakbay-ms-current144:pdf167:l013","ordinal":392778,"en":"Into the seething Chinese gunfire."},{"id":"sayakbay-ms-current144:pdf167:l015","ordinal":392779,"en":"God, protect your servant,"},{"id":"sayakbay-ms-current144:pdf167:l017","ordinal":392780,"en":"His might, if you saw it, was mountainlike."},{"id":"sayakbay-ms-current144:pdf167:l018","ordinal":392781,"en":"Humiliating such a brave man,"},{"id":"sayakbay-ms-current144:pdf167:l019","ordinal":392782,"en":"And my fierce elder,"},{"id":"sayakbay-ms-current144:pdf167:l020","ordinal":392783,"en":"[He was slain by a spearman],"},{"id":"sayakbay-ms-current144:pdf167:l021","ordinal":392784,"en":"Your resourceful champion,"},{"id":"sayakbay-ms-current144:pdf167:l022","ordinal":392785,"en":"Your peerless valiant hero,"},{"id":"sayakbay-ms-current144:pdf167:l023","ordinal":392786,"en":"The warrior born for your good fortune,"},{"id":"sayakbay-ms-current144:pdf167:l024","ordinal":392787,"en":"The wrathful infidel destroyed him,"},{"id":"sayakbay-ms-current144:pdf167:l025","ordinal":392788,"en":"Thus God struck us down."},{"id":"sayakbay-ms-current144:pdf167:l026","ordinal":392789,"en":"The horn broke from your head,"},{"id":"sayakbay-ms-current144:pdf167:l027","ordinal":392790,"en":"Will it remain hornless?"},{"id":"sayakbay-ms-current144:pdf167:l028","ordinal":392791,"en":"Without your tail, without your mane,"},{"id":"sayakbay-ms-current144:pdf167:l029","ordinal":392792,"en":"Parted from the mighty warrior,"},{"id":"sayakbay-ms-current144:pdf167:l030","ordinal":392793,"en":"Will it remain maimed?"},{"id":"sayakbay-ms-current144:pdf167:l031","ordinal":392794,"en":"Alas, parted from your tail,"},{"id":"sayakbay-ms-current144:pdf168:l001","ordinal":392795,"en":"[Will he become like a wild ass],"},{"id":"sayakbay-ms-current144:pdf168:l002","ordinal":392796,"en":"Deprived of feet to walk with,"},{"id":"sayakbay-ms-current144:pdf168:l003","ordinal":392797,"en":"Will he become like a snake?"},{"id":"sayakbay-ms-current144:pdf168:l004","ordinal":392798,"en":"Creator, grant your protection,"},{"id":"sayakbay-ms-current144:pdf168:l005","ordinal":392799,"en":"What warrior Joltoy has suffered,"},{"id":"sayakbay-ms-current144:pdf168:l006","ordinal":392800,"en":"From now on, Creator,"},{"id":"sayakbay-ms-current144:pdf168:l007","ordinal":392801,"en":"[Do not lay it upon me], he said."},{"id":"sayakbay-ms-current144:pdf168:l010","ordinal":392802,"en":"[Against your fierce, mighty host],"},{"id":"sayakbay-ms-current144:pdf168:l011","ordinal":392803,"en":"[Those caught in hardship],"},{"id":"sayakbay-ms-current144:pdf168:l017","ordinal":392804,"en":"It is the Creator's command."},{"id":"sayakbay-ms-current144:pdf168:l018","ordinal":392805,"en":"[Let me face whatever falls upon me]."},{"id":"sayakbay-ms-current144:pdf168:l020","ordinal":392806,"en":"To the mountainlike protector of good fortune,"},{"id":"sayakbay-ms-current144:pdf168:l021","ordinal":392807,"en":"Let me be a companion."},{"id":"sayakbay-ms-current144:pdf168:l022","ordinal":392808,"en":"Thus spoke warrior Seitek,"},{"id":"sayakbay-ms-current144:pdf168:l023","ordinal":392809,"en":"His roar split heads,"},{"id":"sayakbay-ms-current144:pdf168:l026","ordinal":392810,"en":"[Like a dragon, like a bullet],"},{"id":"sayakbay-ms-current144:pdf168:l027","ordinal":392811,"en":"[His eyes' pupils bulging],"},{"id":"sayakbay-ms-current144:pdf168:l028","ordinal":392812,"en":"[Raising a slaughtering battle cry],"},{"id":"sayakbay-ms-current144:pdf168:l029","ordinal":392813,"en":"Seething with rage upon rage,"},{"id":"sayakbay-ms-current144:pdf168:l030","ordinal":392814,"en":"[Charge, Seitek, at the infidel],"},{"id":"sayakbay-ms-current144:pdf168:l031","ordinal":392815,"en":"[Some taken from among the sheep],"},{"id":"sayakbay-ms-current144:pdf169:l003","ordinal":392816,"en":"Companions appeared from the unseen,"},{"id":"sayakbay-ms-current144:pdf169:l004","ordinal":392817,"en":"[From the dear lion's lair],"},{"id":"sayakbay-ms-current144:pdf169:l005","ordinal":392818,"en":"[Karaanot rendered service]."},{"id":"sayakbay-ms-current144:pdf169:l007","ordinal":392819,"en":"As though about to tear them apart,"},{"id":"sayakbay-ms-current144:pdf169:l009","ordinal":392820,"en":"At the side, one gray tiger,"},{"id":"sayakbay-ms-current144:pdf169:l010","ordinal":392821,"en":"Crawling beneath him,"},{"id":"sayakbay-ms-current144:pdf169:l012","ordinal":392822,"en":"[There was a dark-striped beast],"},{"id":"sayakbay-ms-current144:pdf169:l014","ordinal":392823,"en":"It lunged beside him."},{"id":"sayakbay-ms-current144:pdf169:l016","ordinal":392824,"en":"[Holding close and circling him],"},{"id":"sayakbay-ms-current144:pdf169:l021","ordinal":392825,"en":"Someone behind him urged him on,"},{"id":"sayakbay-ms-current144:pdf169:l022","ordinal":392826,"en":"Saying, seize your enemy!"},{"id":"sayakbay-ms-current144:pdf169:l027","ordinal":392827,"en":"They gave him mountainlike steadiness."},{"id":"sayakbay-ms-current144:pdf169:l028","ordinal":392828,"en":"[If he halted somewhere with a shout],"},{"id":"sayakbay-ms-current144:pdf169:l029","ordinal":392829,"en":"Beyond the Chinese capacity to resist,"},{"id":"sayakbay-ms-current144:pdf169:l030","ordinal":392830,"en":"[Dark-fated and formidable],"},{"id":"sayakbay-ms-current144:pdf169:l031","ordinal":392831,"en":"[Unless appointed death should take him],"},{"id":"sayakbay-ms-current144:pdf170:l001","ordinal":392832,"en":"Saying, Seitek's life is needed,"},{"id":"sayakbay-ms-current144:pdf170:l002","ordinal":392833,"en":"[The slanderer who draws lives],"},{"id":"sayakbay-ms-current144:pdf170:l003","ordinal":392834,"en":"Unless he himself chooses to take it,"},{"id":"sayakbay-ms-current144:pdf170:l004","ordinal":392835,"en":"None could match him in combat."},{"id":"sayakbay-ms-current144:pdf170:l005","ordinal":392836,"en":"These were ninety-six,"},{"id":"sayakbay-ms-current144:pdf170:l006","ordinal":392837,"en":"Even if all Beijing swarmed him,"},{"id":"sayakbay-ms-current144:pdf170:l008","ordinal":392838,"en":"Even if they trampled the whole world,"},{"id":"sayakbay-ms-current144:pdf170:l009","ordinal":392839,"en":"Devastating land and disrupting waters,"},{"id":"sayakbay-ms-current144:pdf170:l010","ordinal":392840,"en":"Even if Chinese from forty khanates attacked,"},{"id":"sayakbay-ms-current144:pdf170:l011","ordinal":392841,"en":"They could not bend and defeat him."},{"id":"sayakbay-ms-current144:pdf170:l012","ordinal":392842,"en":"Against his heat and cold,"},{"id":"sayakbay-ms-current144:pdf170:l013","ordinal":392843,"en":"[Against his confirmed fury],"},{"id":"sayakbay-ms-current144:pdf170:l014","ordinal":392844,"en":"Against his strength and appearance,"},{"id":"sayakbay-ms-current144:pdf170:l015","ordinal":392845,"en":"No person could approach unexpectedly,"},{"id":"sayakbay-ms-current144:pdf170:l017","ordinal":392846,"en":"[Ah, the ordeal of the bloodthirsty lion]."},{"id":"sayakbay-ms-current144:pdf170:l018","ordinal":392847,"en":"When stirred, he killed,"},{"id":"sayakbay-ms-current144:pdf170:l019","ordinal":392848,"en":"His torment was felt by the soul."},{"id":"sayakbay-ms-current144:pdf170:l020","ordinal":392849,"en":"When he lunged with renewed vigor,"},{"id":"sayakbay-ms-current144:pdf170:l021","ordinal":392850,"en":"[Those who saw him spat in dread],"},{"id":"sayakbay-ms-current144:pdf170:l022","ordinal":392851,"en":"When they learned the true news,"},{"id":"sayakbay-ms-current144:pdf170:l023","ordinal":392852,"en":"[Donning his headdress, he entered],"},{"id":"sayakbay-ms-current144:pdf170:l024","ordinal":392853,"en":"His heroism and leonine courage,"},{"id":"sayakbay-ms-current144:pdf170:l025","ordinal":392854,"en":"Became known to the Chinese."},{"id":"sayakbay-ms-current144:pdf170:l026","ordinal":392855,"en":"What he faced was destroyed,"},{"id":"sayakbay-ms-current144:pdf170:l027","ordinal":392856,"en":"The fierce opponent who faced him vanished."},{"id":"sayakbay-ms-current144:pdf170:l028","ordinal":392857,"en":"When they came to fight,"},{"id":"sayakbay-ms-current144:pdf170:l029","ordinal":392858,"en":"He punished and devoured them."},{"id":"sayakbay-ms-current144:pdf170:l031","ordinal":392859,"en":"No mortal could withstand him,"},{"id":"sayakbay-ms-current144:pdf171:l001","ordinal":392860,"en":"Steel outside, gold within,"},{"id":"sayakbay-ms-current144:pdf171:l002","ordinal":392861,"en":"[Tall and thickset, broad-shouldered],"},{"id":"sayakbay-ms-current144:pdf171:l003","ordinal":392862,"en":"[The dear lion of Uzukan],"},{"id":"sayakbay-ms-current144:pdf171:l006","ordinal":392863,"en":"[A great plane tree in a tangled forest],"},{"id":"sayakbay-ms-current144:pdf171:l009","ordinal":392864,"en":"[Great Bilgich crossed our path],"},{"id":"sayakbay-ms-current144:pdf171:l011","ordinal":392865,"en":"He threw the ninety-four into confusion."},{"id":"sayakbay-ms-current144:pdf171:l013","ordinal":392866,"en":"[Driving it through the openings],"},{"id":"sayakbay-ms-current144:pdf171:l014","ordinal":392867,"en":"Trotting it with a bouncing gait,"},{"id":"sayakbay-ms-current144:pdf171:l015","ordinal":392868,"en":"Kulunsur appeared mountainlike,"},{"id":"sayakbay-ms-current144:pdf171:l018","ordinal":392869,"en":"Striking Kulunsur once on the flank,"},{"id":"sayakbay-ms-current144:pdf171:l021","ordinal":392870,"en":"[His armor seethed, his soul burned],"},{"id":"sayakbay-ms-current144:pdf171:l023","ordinal":392871,"en":"Does a warrior not die for honor?"},{"id":"sayakbay-ms-current144:pdf171:l024","ordinal":392872,"en":"What God Almighty has ordained,"},{"id":"sayakbay-ms-current144:pdf171:l025","ordinal":392873,"en":"[Does the entrusted soul not witness it]?"},{"id":"sayakbay-ms-current144:pdf171:l027","ordinal":392874,"en":"Will one not give it whenever required?"},{"id":"sayakbay-ms-current144:pdf171:l028","ordinal":392875,"en":"When this head is besieged,"},{"id":"sayakbay-ms-current144:pdf171:l029","ordinal":392876,"en":"[Where is the Almighty's appointed death],"},{"id":"sayakbay-ms-current144:pdf171:l031","ordinal":392877,"en":"Against the warrior whose wrath was raised,"},{"id":"sayakbay-ms-current144:pdf172:l001","ordinal":392878,"en":"Let me try a clash,"},{"id":"sayakbay-ms-current144:pdf172:l002","ordinal":392879,"en":"Showing myself to the enemy warrior,"},{"id":"sayakbay-ms-current144:pdf172:l005","ordinal":392880,"en":"The warrior's blood being shed,"},{"id":"sayakbay-ms-current144:pdf172:l006","ordinal":392881,"en":"[Rather than being trampled, to equal ground],"},{"id":"sayakbay-ms-current144:pdf172:l007","ordinal":392882,"en":"Let a warrior die at an enemy's hand,"},{"id":"sayakbay-ms-current144:pdf172:l011","ordinal":392883,"en":"Where one's cord was cut and swaddling washed,"},{"id":"sayakbay-ms-current144:pdf172:l013","ordinal":392884,"en":"Honor lost and backs broken,"},{"id":"sayakbay-ms-current144:pdf172:l014","ordinal":392885,"en":"Rather than the people being plundered,"},{"id":"sayakbay-ms-current144:pdf172:l015","ordinal":392886,"en":"[Let me see what strength can do],"},{"id":"sayakbay-ms-current144:pdf172:l018","ordinal":392887,"en":"When I saw him, I had no fear,"},{"id":"sayakbay-ms-current144:pdf172:l019","ordinal":392888,"en":"Seeing his presence, I knew no dread."},{"id":"sayakbay-ms-current144:pdf172:l020","ordinal":392889,"en":"I have seen the ninety-four,"},{"id":"sayakbay-ms-current144:pdf172:l021","ordinal":392890,"en":"[Let me see them in all the world],"},{"id":"sayakbay-ms-current144:pdf172:l026","ordinal":392891,"en":"He covered what lay exposed,"},{"id":"sayakbay-ms-current144:pdf172:l027","ordinal":392892,"en":"He filled my hungry belly,"},{"id":"sayakbay-ms-current144:pdf172:l028","ordinal":392893,"en":"[He made Ala-Too a saddle],"},{"id":"sayakbay-ms-current144:pdf172:l029","ordinal":392894,"en":"In my youth when I knew nothing,"},{"id":"sayakbay-ms-current144:pdf172:l030","ordinal":392895,"en":"He led me and made me a warrior,"},{"id":"sayakbay-ms-current144:pdf172:l031","ordinal":392896,"en":"My warrior elder Ak Joltoy,"},{"id":"sayakbay-ms-current144:pdf173:l001","ordinal":392897,"en":"For my warrior elder Joltoy,"},{"id":"sayakbay-ms-current144:pdf173:l003","ordinal":392898,"en":"Against the wrathful infidel,"},{"id":"sayakbay-ms-current144:pdf173:l004","ordinal":392899,"en":"Being a protector to Joltoy,"},{"id":"sayakbay-ms-current144:pdf173:l005","ordinal":392900,"en":"To my dear heroic elder,"},{"id":"sayakbay-ms-current144:pdf173:l006","ordinal":392901,"en":"[Against the infidel who darkened his days],"},{"id":"sayakbay-ms-current144:pdf173:l009","ordinal":392902,"en":"For the arrogant there is God,"},{"id":"sayakbay-ms-current144:pdf173:l012","ordinal":392903,"en":"My people living freely,"},{"id":"sayakbay-ms-current144:pdf173:l014","ordinal":392904,"en":"Repeatedly plundering and oppressing,"},{"id":"sayakbay-ms-current144:pdf173:l015","ordinal":392905,"en":"[Continually taking my herds],"},{"id":"sayakbay-ms-current144:pdf173:l017","ordinal":392906,"en":"Making my people bow,"},{"id":"sayakbay-ms-current144:pdf173:l019","ordinal":392907,"en":"[My elder Joltoy, my support],"},{"id":"sayakbay-ms-current144:pdf173:l020","ordinal":392908,"en":"His roar split heads,"},{"id":"sayakbay-ms-current144:pdf173:l024","ordinal":392909,"en":"When he saw warrior Seitek,"},{"id":"sayakbay-ms-current144:pdf173:l025","ordinal":392910,"en":"His blood boiled and surged,"},{"id":"sayakbay-ms-current144:pdf173:l026","ordinal":392911,"en":"A protector appeared before his eyes,"},{"id":"sayakbay-ms-current144:pdf173:l027","ordinal":392912,"en":"Strength returned, enough to chew stone,"},{"id":"sayakbay-ms-current144:pdf173:l028","ordinal":392913,"en":"He stood up with a roar."},{"id":"sayakbay-ms-current144:pdf173:l029","ordinal":392914,"en":"Saying, my protector has arrived,"},{"id":"sayakbay-ms-current144:pdf173:l031","ordinal":392915,"en":"[Now my thoughts found comfort],"},{"id":"sayakbay-ms-current144:pdf174:l002","ordinal":392916,"en":"If I die now, I have no regret."},{"id":"sayakbay-ms-current144:pdf174:l004","ordinal":392917,"en":"[If I die from a bullet],"},{"id":"sayakbay-ms-current144:pdf174:l005","ordinal":392918,"en":"If I perish by misfortune,"},{"id":"sayakbay-ms-current144:pdf174:l006","ordinal":392919,"en":"You will take my waist and fold me,"},{"id":"sayakbay-ms-current144:pdf174:l007","ordinal":392920,"en":"[Making a support to carry me],"},{"id":"sayakbay-ms-current144:pdf174:l008","ordinal":392921,"en":"You will carry me to Ala-Too."},{"id":"sayakbay-ms-current144:pdf174:l010","ordinal":392922,"en":"At the wrathful one's hands,"},{"id":"sayakbay-ms-current144:pdf174:l012","ordinal":392923,"en":"[Without dwelling on terrible hardship],"},{"id":"sayakbay-ms-current144:pdf174:l013","ordinal":392924,"en":"[Without letting wolves ravage the body],"},{"id":"sayakbay-ms-current144:pdf174:l014","ordinal":392925,"en":"Food for beasts,"},{"id":"sayakbay-ms-current144:pdf174:l015","ordinal":392926,"en":"[Without disgracing the departed soul],"},{"id":"sayakbay-ms-current144:pdf174:l016","ordinal":392927,"en":"You will dig the earth with a hoe,"},{"id":"sayakbay-ms-current144:pdf174:l017","ordinal":392928,"en":"Reciting the Quran and a sermon,"},{"id":"sayakbay-ms-current144:pdf174:l018","ordinal":392929,"en":"Seitek has come to bury me, he thought."},{"id":"sayakbay-ms-current144:pdf174:l019","ordinal":392930,"en":"Giving thanks to God,"},{"id":"sayakbay-ms-current144:pdf174:l020","ordinal":392931,"en":"[Seeking support from the young man],"},{"id":"sayakbay-ms-current144:pdf174:l021","ordinal":392932,"en":"Rejoicing greatly after anxiety,"},{"id":"sayakbay-ms-current144:pdf174:l022","ordinal":392933,"en":"[Not fearing, by God's protection],"},{"id":"sayakbay-ms-current144:pdf174:l023","ordinal":392934,"en":"[His spirit strengthened, his heart content],"},{"id":"sayakbay-ms-current144:pdf174:l024","ordinal":392935,"en":"Saying, a protector has visibly arrived,"},{"id":"sayakbay-ms-current144:pdf174:l027","ordinal":392936,"en":"Taking courage in his heart,"},{"id":"sayakbay-ms-current144:pdf174:l029","ordinal":392937,"en":"Seeing a multitude in a single warrior,"},{"id":"sayakbay-ms-current144:pdf174:l030","ordinal":392938,"en":"[His burning anguish subsided],"},{"id":"sayakbay-ms-current144:pdf175:l004","ordinal":392939,"en":"Do not ask about that side,"},{"id":"sayakbay-ms-current144:pdf175:l005","ordinal":392940,"en":"A dark cliff with a rocky ridge,"},{"id":"sayakbay-ms-current144:pdf175:l006","ordinal":392941,"en":"[A great peak where two could not pass],"},{"id":"sayakbay-ms-current144:pdf175:l007","ordinal":392942,"en":"[Below was a narrow steep slope],"},{"id":"sayakbay-ms-current144:pdf175:l008","ordinal":392943,"en":"The maddened Chinese had Joltoy,"},{"id":"sayakbay-ms-current144:pdf175:l009","ordinal":392944,"en":"Do not ask where they besieged him."},{"id":"sayakbay-ms-current144:pdf175:l010","ordinal":392945,"en":"[Hurling stars from the sky],"},{"id":"sayakbay-ms-current144:pdf175:l011","ordinal":392946,"en":"[The place of their final stratagem],"},{"id":"sayakbay-ms-current144:pdf175:l012","ordinal":392947,"en":"The ninety-four joined together,"},{"id":"sayakbay-ms-current144:pdf175:l013","ordinal":392948,"en":"Surging forward, they thrust their spears."},{"id":"sayakbay-ms-current144:pdf175:l014","ordinal":392949,"en":"[Weariness came upon the lone man],"},{"id":"sayakbay-ms-current144:pdf175:l015","ordinal":392950,"en":"Your elder Joltoy was undone."},{"id":"sayakbay-ms-current144:pdf175:l016","ordinal":392951,"en":"[Towering like a great register],"},{"id":"sayakbay-ms-current144:pdf175:l017","ordinal":392952,"en":"[Seen, his chest seemed split],"},{"id":"sayakbay-ms-current144:pdf175:l019","ordinal":392953,"en":"He appeared as though a whole people were seen,"},{"id":"sayakbay-ms-current144:pdf175:l020","ordinal":392954,"en":"[Your heroic young falcon],"},{"id":"sayakbay-ms-current144:pdf175:l021","ordinal":392955,"en":"[The forefather of renown],"},{"id":"sayakbay-ms-current144:pdf175:l022","ordinal":392956,"en":"[An unyielding terror to the enemy],"},{"id":"sayakbay-ms-current144:pdf175:l023","ordinal":392957,"en":"[Readying his sacred power and girding himself],"},{"id":"sayakbay-ms-current144:pdf175:l025","ordinal":392958,"en":"[Ahead rose a roaring clamor],"},{"id":"sayakbay-ms-current144:pdf175:l026","ordinal":392959,"en":"[Badyrek's heroism],"},{"id":"sayakbay-ms-current144:pdf175:l028","ordinal":392960,"en":"Thus he waged his campaign,"}]
