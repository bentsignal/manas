[{"id":"seytek-1991-continuation:p0339:b001:l032","ordinal":386561,"en":"Heed what your elder,"},{"id":"seytek-1991-continuation:p0339:b001:l033","ordinal":386562,"en":"The hero Kogoy, says;"},{"id":"seytek-1991-continuation:p0339:b001:l034","ordinal":386563,"en":"Grant me your highest blessing!"},{"id":"seytek-1991-continuation:p0339:b001:l035","ordinal":386564,"en":"If death comes and my days end,"},{"id":"seytek-1991-continuation:p0339:b001:l036","ordinal":386565,"en":"If I perish from a stray shot,"},{"id":"seytek-1991-continuation:p0339:b001:l037","ordinal":386566,"en":"And am destroyed by a chance blow,"},{"id":"seytek-1991-continuation:p0339:b001:l038","ordinal":386567,"en":"Say that renowned Kogoy died,"},{"id":"seytek-1991-continuation:p0339:b001:l039","ordinal":386568,"en":"That this honored, precious soul"},{"id":"seytek-1991-continuation:p0339:b001:l040","ordinal":386569,"en":"Gave the life that was needed"},{"id":"seytek-1991-continuation:p0339:b001:l041","ordinal":386570,"en":"For the soaring Ala-Too,"},{"id":"seytek-1991-continuation:p0339:b001:l042","ordinal":386571,"en":"For the white-capped Kyrgyz people,"},{"id":"seytek-1991-continuation:p0339:b001:l043","ordinal":386572,"en":"For honor and for dignity;"},{"id":"seytek-1991-continuation:p0339:b001:l044","ordinal":386573,"en":"Bury me with your own hands!"},{"id":"seytek-1991-continuation:p0339:b001:l045","ordinal":386574,"en":"To go against Odukan,"},{"id":"seytek-1991-continuation:p0339:b001:l046","ordinal":386575,"en":"And answer the infidel who humiliates us,"},{"id":"seytek-1991-continuation:p0339:b001:l047","ordinal":386576,"en":"If death does not take me—"},{"id":"seytek-1991-continuation:p0339:b001:l048","ordinal":386577,"en":"Noble white-capped Kyrgyz people,"},{"id":"seytek-1991-continuation:p0339:b001:l049","ordinal":386578,"en":"With Er Kenen in your midst…”"},{"id":"seytek-1991-continuation:p0339:b003:l001","ordinal":386579,"en":"Every wise diviner,"},{"id":"seytek-1991-continuation:p0339:b003:l002","ordinal":386580,"en":"Every hero from whom wisdom springs,"},{"id":"seytek-1991-continuation:p0339:b003:l003","ordinal":386581,"en":"Spread their palms and gave their hands."},{"id":"seytek-1991-continuation:p0339:b003:l004","ordinal":386582,"en":"They gave him armor no bullet could pierce,"},{"id":"seytek-1991-continuation:p0339:b003:l005","ordinal":386583,"en":"A helmet of blue steel,"},{"id":"seytek-1991-continuation:p0339:b003:l006","ordinal":386584,"en":"And richly fashioned plate armor."},{"id":"seytek-1991-continuation:p0339:b003:l007","ordinal":386585,"en":"They dressed him in blue steel"},{"id":"seytek-1991-continuation:p0339:b003:l008","ordinal":386586,"en":"Beautifully suited to his body."},{"id":"seytek-1991-continuation:p0339:b003:l009","ordinal":386587,"en":"Toburchak, with his handsome neck,"},{"id":"seytek-1991-continuation:p0339:b003:l010","ordinal":386588,"en":"Who grazed on the Chambyl ridge,"},{"id":"seytek-1991-continuation:p0339:b003:l011","ordinal":386589,"en":"Born a true racing steed,"},{"id":"seytek-1991-continuation:p0339:b003:l012","ordinal":386590,"en":"They gave Er Kogoy to mount."},{"id":"seytek-1991-continuation:p0339:b003:l013","ordinal":386591,"en":"They clasped and pressed his hand,"},{"id":"seytek-1991-continuation:p0339:b003:l014","ordinal":386592,"en":"Entrusted him to the spirits of the ancestors"},{"id":"seytek-1991-continuation:p0339:b003:l015","ordinal":386593,"en":"And to the Creator,"},{"id":"seytek-1991-continuation:p0339:b004:l001","ordinal":386594,"en":"And sent Kogoy forth."},{"id":"seytek-1991-continuation:p0339:b005:l001","ordinal":386595,"en":"Toward fork-necked Akyska,"},{"id":"seytek-1991-continuation:p0339:b005:l002","ordinal":386596,"en":"Toward remote Tankyska,"},{"id":"seytek-1991-continuation:p0339:b005:l003","ordinal":386597,"en":"Into mist beyond the reach of sight,"},{"id":"seytek-1991-continuation:p0339:b005:l004","ordinal":386598,"en":"To the very edge of the haze,"},{"id":"seytek-1991-continuation:p0339:b005:l005","ordinal":386599,"en":"To the yellow plain where battle was joined,"},{"id":"seytek-1991-continuation:p0339:b005:l006","ordinal":386600,"en":"Across the face of that yellow plain,"},{"id":"seytek-1991-continuation:p0339:b005:l007","ordinal":386601,"en":"Kogoy rode."},{"id":"seytek-1991-continuation:p0339:b005:l008","ordinal":386602,"en":"When Odukan saw him,"},{"id":"seytek-1991-continuation:p0339:b005:l009","ordinal":386603,"en":"His eyes flashed like a lion's."},{"id":"seytek-1991-continuation:p0339:b005:l010","ordinal":386604,"en":"A fit of rage seized him;"},{"id":"seytek-1991-continuation:p0339:b005:l011","ordinal":386605,"en":"He ground and gnashed"},{"id":"seytek-1991-continuation:p0339:b005:l012","ordinal":386606,"en":"Those gate-like front teeth."},{"id":"seytek-1991-continuation:p0339:b005:l013","ordinal":386607,"en":"He turned his rhinoceros mouth,"},{"id":"seytek-1991-continuation:p0339:b005:l014","ordinal":386608,"en":"Cut a road across the plain,"},{"id":"seytek-1991-continuation:p0339:b005:l015","ordinal":386609,"en":"And attacked Er Kogoy."},{"id":"seytek-1991-continuation:p0339:b005:l016","ordinal":386610,"en":"The hero on one side and giant on the other"},{"id":"seytek-1991-continuation:p0339:b005:l017","ordinal":386611,"en":"Shouted and leveled their spears;"},{"id":"seytek-1991-continuation:p0339:b005:l018","ordinal":386612,"en":"They fought by turns."},{"id":"seytek-1991-continuation:p0339:b005:l019","ordinal":386613,"en":"They measured and matched each other,"},{"id":"seytek-1991-continuation:p0339:b005:l020","ordinal":386614,"en":"Fighting with spears."},{"id":"seytek-1991-continuation:p0339:b005:l021","ordinal":386615,"en":"They came at one another head-on"},{"id":"seytek-1991-continuation:p0339:b005:l022","ordinal":386616,"en":"And fought with iron maces."},{"id":"seytek-1991-continuation:p0339:b005:l023","ordinal":386617,"en":"The rim of the blue-steel helmet"},{"id":"seytek-1991-continuation:p0339:b005:l024","ordinal":386618,"en":"Was battered and crushed."},{"id":"seytek-1991-continuation:p0339:b005:l025","ordinal":386619,"en":"The broad-rumped bay stallion with mattock-like hooves,"},{"id":"seytek-1991-continuation:p0339:b005:l026","ordinal":386620,"en":"Who never tired on patrol,"},{"id":"seytek-1991-continuation:p0339:b005:l027","ordinal":386621,"en":"Toburchak of the open steppe,"},{"id":"seytek-1991-continuation:p0339:b005:l028","ordinal":386622,"en":"Had his back broken."},{"id":"seytek-1991-continuation:p0339:b005:l029","ordinal":386623,"en":"His wings were clipped—"},{"id":"seytek-1991-continuation:p0339:b005:l030","ordinal":386624,"en":"What could our elder Kogoy do?"},{"id":"seytek-1991-continuation:p0339:b005:l031","ordinal":386625,"en":"He was parted from Toburchak."},{"id":"seytek-1991-continuation:p0339:b005:l032","ordinal":386626,"en":"A bullet brought Toburchak down,"},{"id":"seytek-1991-continuation:p0339:b005:l033","ordinal":386627,"en":"And the foe tore Kogoy's coat."},{"id":"seytek-1991-continuation:p0340:b001:l001","ordinal":386628,"en":"Then Er Kogoy"},{"id":"seytek-1991-continuation:p0340:b001:l002","ordinal":386629,"en":"Bent at the waist from fighting on foot."},{"id":"seytek-1991-continuation:p0340:b001:l003","ordinal":386630,"en":"His frail life was pressed hard;"},{"id":"seytek-1991-continuation:p0340:b001:l004","ordinal":386631,"en":"His strength failed and calamity came."},{"id":"seytek-1991-continuation:p0340:b001:l005","ordinal":386632,"en":"It became a night that blinded the eyes,"},{"id":"seytek-1991-continuation:p0340:b001:l006","ordinal":386633,"en":"A day of disaster to behold."},{"id":"seytek-1991-continuation:p0340:b001:l007","ordinal":386634,"en":"Not letting his wound-up turban fall,"},{"id":"seytek-1991-continuation:p0340:b001:l008","ordinal":386635,"en":"Not letting Er Odu take him,"},{"id":"seytek-1991-continuation:p0340:b001:l009","ordinal":386636,"en":"He fought beyond all measure—"},{"id":"seytek-1991-continuation:p0340:b001:l010","ordinal":386637,"en":"Who had ever seen such a deed!"},{"id":"seytek-1991-continuation:p0340:b001:l011","ordinal":386638,"en":"Blood flowed from his dark eyes;"},{"id":"seytek-1991-continuation:p0340:b001:l012","ordinal":386639,"en":"Poor Kogoy was bewildered."},{"id":"seytek-1991-continuation:p0340:b001:l013","ordinal":386640,"en":"His two hands that had served him"},{"id":"seytek-1991-continuation:p0340:b001:l014","ordinal":386641,"en":"Could no longer rise and were paralyzed."},{"id":"seytek-1991-continuation:p0340:b001:l015","ordinal":386642,"en":"His precious head, the lock of life,"},{"id":"seytek-1991-continuation:p0340:b001:l016","ordinal":386643,"en":"Became a red bucket of blood."},{"id":"seytek-1991-continuation:p0340:b001:l017","ordinal":386644,"en":"He lost consciousness and bled,"},{"id":"seytek-1991-continuation:p0340:b001:l018","ordinal":386645,"en":"His strength gone, his body weak."},{"id":"seytek-1991-continuation:p0340:b001:l019","ordinal":386646,"en":"His dear eyes seemed about to close,"},{"id":"seytek-1991-continuation:p0340:b001:l020","ordinal":386647,"en":"Drooping and hanging dimly."},{"id":"seytek-1991-continuation:p0340:b001:l021","ordinal":386648,"en":"Accursed pale Death"},{"id":"seytek-1991-continuation:p0340:b001:l022","ordinal":386649,"en":"Was seen approaching his brow."},{"id":"seytek-1991-continuation:p0340:b001:l023","ordinal":386650,"en":"Odukan stood there thus."},{"id":"seytek-1991-continuation:p0340:b001:l024","ordinal":386651,"en":"A prince among his Kaldays,"},{"id":"seytek-1991-continuation:p0340:b001:l025","ordinal":386652,"en":"A cruel prince who had seen much,"},{"id":"seytek-1991-continuation:p0340:b001:l026","ordinal":386653,"en":"A slave-marksman who never missed,"},{"id":"seytek-1991-continuation:p0340:b001:l027","ordinal":386654,"en":"Proud of his marksmanship,"},{"id":"seytek-1991-continuation:p0340:b001:l028","ordinal":386655,"en":"Hid behind him."},{"id":"seytek-1991-continuation:p0340:b001:l029","ordinal":386656,"en":"“Aim between the forked shoulders;"},{"id":"seytek-1991-continuation:p0340:b001:l030","ordinal":386657,"en":"The face of the skull is the mark,"},{"id":"seytek-1991-continuation:p0340:b001:l031","ordinal":386658,"en":"The very center of the measure.”"},{"id":"seytek-1991-continuation:p0340:b001:l032","ordinal":386659,"en":"He set a bullet as large as a sheep's head"},{"id":"seytek-1991-continuation:p0340:b001:l033","ordinal":386660,"en":"Firmly against the sight,"},{"id":"seytek-1991-continuation:p0340:b001:l034","ordinal":386661,"en":"Bound it to certain death,"},{"id":"seytek-1991-continuation:p0340:b001:l035","ordinal":386662,"en":"And struck, splitting his head."},{"id":"seytek-1991-continuation:p0340:b001:l036","ordinal":386663,"en":"His soul left before the smoke cleared;"},{"id":"seytek-1991-continuation:p0340:b001:l037","ordinal":386664,"en":"The fatal bullet struck his temple."},{"id":"seytek-1991-continuation:p0340:b001:l038","ordinal":386665,"en":"Our poor elder Kogoy"},{"id":"seytek-1991-continuation:p0340:b001:l039","ordinal":386666,"en":"Had departed for Mecca."},{"id":"seytek-1991-continuation:p0340:b001:l040","ordinal":386667,"en":"Seeing this, Ebegey cried:"},{"id":"seytek-1991-continuation:p0340:b001:l041","ordinal":386668,"en":"“Rather than lose my comrade"},{"id":"seytek-1991-continuation:p0340:b001:l042","ordinal":386669,"en":"And let the Kyrgyz be cast into fire,"},{"id":"seytek-1991-continuation:p0340:b001:l043","ordinal":386670,"en":"Rather than lose one of my horns"},{"id":"seytek-1991-continuation:p0340:b001:l044","ordinal":386671,"en":"And remain a hornless beast,"},{"id":"seytek-1991-continuation:p0340:b001:l045","ordinal":386672,"en":"Rather than lose mane and tail"},{"id":"seytek-1991-continuation:p0340:b001:l046","ordinal":386673,"en":"And remain a stunted thing,"},{"id":"seytek-1991-continuation:p0340:b001:l047","ordinal":386674,"en":"May I sink unborn into the deep;"},{"id":"seytek-1991-continuation:p0340:b001:l048","ordinal":386675,"en":"May I die and not remain alive!"},{"id":"seytek-1991-continuation:p0340:b001:l049","ordinal":386676,"en":"My figure before me,"},{"id":"seytek-1991-continuation:p0340:b003:l001","ordinal":386677,"en":"My watchful Kogoy,"},{"id":"seytek-1991-continuation:p0340:b003:l002","ordinal":386678,"en":"My bannered mountain ridge"},{"id":"seytek-1991-continuation:p0340:b003:l003","ordinal":386679,"en":"No enemy caravan could cross,"},{"id":"seytek-1991-continuation:p0340:b003:l004","ordinal":386680,"en":"My greatest lion in time of need—"},{"id":"seytek-1991-continuation:p0340:b003:l005","ordinal":386681,"en":"Let me die for my twin!"},{"id":"seytek-1991-continuation:p0340:b003:l006","ordinal":386682,"en":"My truly created golden soul,"},{"id":"seytek-1991-continuation:p0340:b003:l007","ordinal":386683,"en":"If the Creator truly wills it,"},{"id":"seytek-1991-continuation:p0340:b003:l008","ordinal":386684,"en":"I will give up this fly-like life.”"},{"id":"seytek-1991-continuation:p0340:b003:l009","ordinal":386685,"en":"Thus Ebegey spoke,"},{"id":"seytek-1991-continuation:p0340:b003:l010","ordinal":386686,"en":"Whipping the gray racer Aksutkul"},{"id":"seytek-1991-continuation:p0340:b003:l011","ordinal":386687,"en":"From side to side,"},{"id":"seytek-1991-continuation:p0340:b003:l012","ordinal":386688,"en":"Driving him right and left."},{"id":"seytek-1991-continuation:p0340:b003:l013","ordinal":386689,"en":"He struck the stallion's flank"},{"id":"seytek-1991-continuation:p0340:b003:l014","ordinal":386690,"en":"And shouted, “Comrade!”"},{"id":"seytek-1991-continuation:p0340:b003:l015","ordinal":386691,"en":"As he attacked Er Odu."},{"id":"seytek-1991-continuation:p0340:b003:l016","ordinal":386692,"en":"They stood face-to-face,"},{"id":"seytek-1991-continuation:p0340:b003:l017","ordinal":386693,"en":"Loosened the mouths of their steeds,"},{"id":"seytek-1991-continuation:p0340:b003:l018","ordinal":386694,"en":"And without frowning or knitting a brow,"},{"id":"seytek-1991-continuation:p0340:b003:l019","ordinal":386695,"en":"At once thrust their spears."},{"id":"seytek-1991-continuation:p0340:b003:l020","ordinal":386696,"en":"Their spears shattered against each other;"},{"id":"seytek-1991-continuation:p0340:b003:l021","ordinal":386697,"en":"They wearied through many days."},{"id":"seytek-1991-continuation:p0340:b003:l022","ordinal":386698,"en":"All the blood was swallowed up;"},{"id":"seytek-1991-continuation:p0340:b003:l023","ordinal":386699,"en":"Their impenetrable armor, impossible to seize,"},{"id":"seytek-1991-continuation:p0340:b003:l024","ordinal":386700,"en":"Was torn into shreds."},{"id":"seytek-1991-continuation:p0340:b003:l025","ordinal":386701,"en":"They waged a fierce battle."},{"id":"seytek-1991-continuation:p0340:b003:l026","ordinal":386702,"en":"The two giants struck each other"},{"id":"seytek-1991-continuation:p0340:b003:l027","ordinal":386703,"en":"With iron-headed maces."},{"id":"seytek-1991-continuation:p0340:b003:l028","ordinal":386704,"en":"They covered the hilltop in blood"},{"id":"seytek-1991-continuation:p0340:b003:l029","ordinal":386705,"en":"And every eyelash in dust."},{"id":"seytek-1991-continuation:p0340:b003:l030","ordinal":386706,"en":"Unable to overcome each other,"},{"id":"seytek-1991-continuation:p0340:b003:l031","ordinal":386707,"en":"Their strength only increased."},{"id":"seytek-1991-continuation:p0340:b003:l032","ordinal":386708,"en":"They seized each other's collars,"},{"id":"seytek-1991-continuation:p0340:b003:l033","ordinal":386709,"en":"Wrestled and grappled,"},{"id":"seytek-1991-continuation:p0340:b003:l034","ordinal":386710,"en":"And made an astounding spectacle."},{"id":"seytek-1991-continuation:p0340:b003:l035","ordinal":386711,"en":"Choyun Alp, worth ten Odukans,"},{"id":"seytek-1991-continuation:p0340:b003:l036","ordinal":386712,"en":"A devastating giant,"},{"id":"seytek-1991-continuation:p0340:b003:l037","ordinal":386713,"en":"A champion of the royal treasury,"},{"id":"seytek-1991-continuation:p0340:b003:l038","ordinal":386714,"en":"With muscles like a bull's back,"},{"id":"seytek-1991-continuation:p0340:b003:l039","ordinal":386715,"en":"Able to devour those who resisted,"},{"id":"seytek-1991-continuation:p0340:b003:l040","ordinal":386716,"en":"Arrived and joined the attack."},{"id":"seytek-1991-continuation:p0340:b003:l041","ordinal":386717,"en":"He swung his axe wildly"},{"id":"seytek-1991-continuation:p0340:b003:l042","ordinal":386718,"en":"At your ancestor, father of the people,"},{"id":"seytek-1991-continuation:p0340:b003:l043","ordinal":386719,"en":"And clubbed him right and left."},{"id":"seytek-1991-continuation:p0340:b003:l044","ordinal":386720,"en":"When your heroic elder could find no escape"},{"id":"seytek-1991-continuation:p0340:b003:l045","ordinal":386721,"en":"And was caught between the two,"},{"id":"seytek-1991-continuation:p0340:b003:l046","ordinal":386722,"en":"The swift hero Jeljetpes"},{"id":"seytek-1991-continuation:p0340:b003:l047","ordinal":386723,"en":"And the accomplished champion Er Kenen"},{"id":"seytek-1991-continuation:p0340:b003:l048","ordinal":386724,"en":"Charged together."},{"id":"seytek-1991-continuation:p0340:b003:l049","ordinal":386725,"en":"Having lost Er Kogoy,"},{"id":"seytek-1991-continuation:p0341:b001:l001","ordinal":386726,"en":"If we let Ebegey fall to a bullet,"},{"id":"seytek-1991-continuation:p0341:b001:l002","ordinal":386727,"en":"We may as well camp along the Kok-Ozon"},{"id":"seytek-1991-continuation:p0341:b001:l003","ordinal":386728,"en":"And become like a fire gone out."},{"id":"seytek-1991-continuation:p0341:b001:l004","ordinal":386729,"en":"While the Chinese challenge us alone,"},{"id":"seytek-1991-continuation:p0341:b001:l005","ordinal":386730,"en":"While the enemy pours out his rage,"},{"id":"seytek-1991-continuation:p0341:b001:l006","ordinal":386731,"en":"While black calamity burns like fire"},{"id":"seytek-1991-continuation:p0341:b001:l007","ordinal":386732,"en":"And overwhelms the poor hero,"},{"id":"seytek-1991-continuation:p0341:b001:l008","ordinal":386733,"en":"If we conceal our comradeship,"},{"id":"seytek-1991-continuation:p0341:b001:l009","ordinal":386734,"en":"Strike not a single blow,"},{"id":"seytek-1991-continuation:p0341:b001:l010","ordinal":386735,"en":"Turn our faces away and close our eyes,"},{"id":"seytek-1991-continuation:p0341:b001:l011","ordinal":386736,"en":"Will our fortunate elder"},{"id":"seytek-1991-continuation:p0341:b001:l012","ordinal":386737,"en":"Not think us powerless?"},{"id":"seytek-1991-continuation:p0341:b001:l013","ordinal":386738,"en":"Will they not say those two have no support"},{"id":"seytek-1991-continuation:p0341:b001:l014","ordinal":386739,"en":"And mount them like black donkeys?"},{"id":"seytek-1991-continuation:p0341:b001:l015","ordinal":386740,"en":"If true death has come, let us die;"},{"id":"seytek-1991-continuation:p0341:b001:l016","ordinal":386741,"en":"Let us become a support"},{"id":"seytek-1991-continuation:p0341:b001:l017","ordinal":386742,"en":"For the humiliated gray-maned leopard,"},{"id":"seytek-1991-continuation:p0341:b001:l018","ordinal":386743,"en":"For elder Er Ebegey,"},{"id":"seytek-1991-continuation:p0341:b001:l019","ordinal":386744,"en":"For a forebear dearer than a father!"},{"id":"seytek-1991-continuation:p0341:b001:l020","ordinal":386745,"en":"Er Kenen gathered his courage,"},{"id":"seytek-1991-continuation:p0341:b001:l021","ordinal":386746,"en":"As did the accomplished Jeljetpes."},{"id":"seytek-1991-continuation:p0341:b001:l022","ordinal":386747,"en":"The two giants would not stand idle."},{"id":"seytek-1991-continuation:p0341:b001:l023","ordinal":386748,"en":"To begin an unequal battle,"},{"id":"seytek-1991-continuation:p0341:b001:l024","ordinal":386749,"en":"To free the captive Ebegey"},{"id":"seytek-1991-continuation:p0341:b001:l025","ordinal":386750,"en":"From the iron lariat net,"},{"id":"seytek-1991-continuation:p0341:b001:l026","ordinal":386751,"en":"From the black demon's bullets,"},{"id":"seytek-1991-continuation:p0341:b001:l027","ordinal":386752,"en":"From the infidel's deep pit,"},{"id":"seytek-1991-continuation:p0341:b001:l028","ordinal":386753,"en":"From the embers of burning hell,"},{"id":"seytek-1991-continuation:p0341:b001:l029","ordinal":386754,"en":"From the hands of the two giants,"},{"id":"seytek-1991-continuation:p0341:b001:l030","ordinal":386755,"en":"To rescue him,"},{"id":"seytek-1991-continuation:p0341:b001:l031","ordinal":386756,"en":"They broke through the formation and opened a road."},{"id":"seytek-1991-continuation:p0341:b001:l032","ordinal":386757,"en":"The two splendid falcons"},{"id":"seytek-1991-continuation:p0341:b001:l033","ordinal":386758,"en":"Came and attacked the pair."},{"id":"seytek-1991-continuation:p0341:b001:l034","ordinal":386759,"en":"Choyun Alp stood at the front."},{"id":"seytek-1991-continuation:p0341:b001:l035","ordinal":386760,"en":"Before that giant hero"},{"id":"seytek-1991-continuation:p0341:b001:l036","ordinal":386761,"en":"Could say a word or turn aside,"},{"id":"seytek-1991-continuation:p0341:b001:l037","ordinal":386762,"en":"In the blink of an eye,"},{"id":"seytek-1991-continuation:p0341:b001:l038","ordinal":386763,"en":"Jeljetpes proved his strength."},{"id":"seytek-1991-continuation:p0341:b001:l039","ordinal":386764,"en":"Broad at the base and sharp at the point,"},{"id":"seytek-1991-continuation:p0341:b001:l040","ordinal":386765,"en":"His spear bloodied any foe he thrust at."},{"id":"seytek-1991-continuation:p0341:b001:l041","ordinal":386766,"en":"Its iron was smelted and worked,"},{"id":"seytek-1991-continuation:p0341:b001:l042","ordinal":386767,"en":"Its edge was sharpened,"},{"id":"seytek-1991-continuation:p0341:b001:l043","ordinal":386768,"en":"Filed again and again with a file,"},{"id":"seytek-1991-continuation:p0341:b001:l044","ordinal":386769,"en":"Hammered again and again with a hammer,"},{"id":"seytek-1991-continuation:p0341:b001:l045","ordinal":386770,"en":"Hammered without rest for eighty days,"},{"id":"seytek-1991-continuation:p0341:b001:l046","ordinal":386771,"en":"Tempered, crushed, and beaten;"},{"id":"seytek-1991-continuation:p0341:b001:l047","ordinal":386772,"en":"Its charcoal leapt like sheep,"},{"id":"seytek-1991-continuation:p0341:b001:l048","ordinal":386773,"en":"And it shattered every bellows."},{"id":"seytek-1991-continuation:p0341:b001:l049","ordinal":386774,"en":"His servant Dynshokor"},{"id":"seytek-1991-continuation:p0341:b003:l001","ordinal":386775,"en":"Made the master smith weep."},{"id":"seytek-1991-continuation:p0341:b003:l002","ordinal":386776,"en":"Its solid workmanship was unsurpassed."},{"id":"seytek-1991-continuation:p0341:b003:l003","ordinal":386777,"en":"Yengkor, who came from Beijing"},{"id":"seytek-1991-continuation:p0341:b003:l004","ordinal":386778,"en":"And had befriended the prophet David,"},{"id":"seytek-1991-continuation:p0341:b003:l005","ordinal":386779,"en":"Was the smith who made"},{"id":"seytek-1991-continuation:p0341:b003:l006","ordinal":386780,"en":"Jeljetpes's spear."},{"id":"seytek-1991-continuation:p0341:b003:l007","ordinal":386781,"en":"When its point touched a man,"},{"id":"seytek-1991-continuation:p0341:b003:l008","ordinal":386782,"en":"He paled and wilted like grass;"},{"id":"seytek-1991-continuation:p0341:b003:l009","ordinal":386783,"en":"When its point struck true,"},{"id":"seytek-1991-continuation:p0341:b003:l010","ordinal":386784,"en":"His life left before he could draw breath."},{"id":"seytek-1991-continuation:p0341:b003:l011","ordinal":386785,"en":"It had been tempered in poison,"},{"id":"seytek-1991-continuation:p0341:b003:l012","ordinal":386786,"en":"Heated twelve times red-hot"},{"id":"seytek-1991-continuation:p0341:b003:l013","ordinal":386787,"en":"In the poison of an albasty demon."},{"id":"seytek-1991-continuation:p0341:b003:l014","ordinal":386788,"en":"Such was his spear and equipment;"},{"id":"seytek-1991-continuation:p0341:b003:l015","ordinal":386789,"en":"Such was the stratagem"},{"id":"seytek-1991-continuation:p0341:b003:l016","ordinal":386790,"en":"Of your elder Er Jeljetpes."},{"id":"seytek-1991-continuation:p0341:b003:l017","ordinal":386791,"en":"When the fully armed infidel,"},{"id":"seytek-1991-continuation:p0341:b003:l018","ordinal":386792,"en":"The giant hero Choyun Alp,"},{"id":"seytek-1991-continuation:p0341:b003:l019","ordinal":386793,"en":"Joined Odukan"},{"id":"seytek-1991-continuation:p0341:b003:l020","ordinal":386794,"en":"To wage immeasurable battle,"},{"id":"seytek-1991-continuation:p0341:b003:l021","ordinal":386795,"en":"When those two matching madmen"},{"id":"seytek-1991-continuation:p0341:b003:l022","ordinal":386796,"en":"Were about to spill Ebegey's blood,"},{"id":"seytek-1991-continuation:p0341:b003:l023","ordinal":386797,"en":"Plunge him into deepest misery,"},{"id":"seytek-1991-continuation:p0341:b003:l024","ordinal":386798,"en":"And inflict on Ebegey"},{"id":"seytek-1991-continuation:p0341:b003:l025","ordinal":386799,"en":"A torment no man could bear,"},{"id":"seytek-1991-continuation:p0341:b003:l026","ordinal":386800,"en":"Your elder Er Jeljetpes"},{"id":"seytek-1991-continuation:p0341:b003:l027","ordinal":386801,"en":"Came upon him from behind."},{"id":"seytek-1991-continuation:p0341:b003:l028","ordinal":386802,"en":"At the lower edge of his hair,"},{"id":"seytek-1991-continuation:p0341:b003:l029","ordinal":386803,"en":"At the bare rim of his temple,"},{"id":"seytek-1991-continuation:p0341:b003:l030","ordinal":386804,"en":"He thrust his spear straight through."},{"id":"seytek-1991-continuation:p0341:b003:l031","ordinal":386805,"en":"From Choyun Alp's head"},{"id":"seytek-1991-continuation:p0341:b003:l032","ordinal":386806,"en":"Blood flowed like an irrigation ditch;"},{"id":"seytek-1991-continuation:p0341:b003:l033","ordinal":386807,"en":"The spear passed through his brain,"},{"id":"seytek-1991-continuation:p0341:b003:l034","ordinal":386808,"en":"And his life went out mingled with blood."},{"id":"seytek-1991-continuation:p0341:b003:l035","ordinal":386809,"en":"He whipped the bay stallion,"},{"id":"seytek-1991-continuation:p0341:b003:l036","ordinal":386810,"en":"Shouting in anger."},{"id":"seytek-1991-continuation:p0341:b003:l037","ordinal":386811,"en":"The mighty, fortunate hero,"},{"id":"seytek-1991-continuation:p0341:b003:l038","ordinal":386812,"en":"Who was like a host when he rode in front,"},{"id":"seytek-1991-continuation:p0341:b003:l039","ordinal":386813,"en":"Cried to his elder Er Ebegey,"},{"id":"seytek-1991-continuation:p0341:b003:l040","ordinal":386814,"en":"“Gather your senses!”"},{"id":"seytek-1991-continuation:p0341:b003:l041","ordinal":386815,"en":"His gray-wolf courage revealed,"},{"id":"seytek-1991-continuation:p0341:b003:l042","ordinal":386816,"en":"He thrust beneath the steel shield"}]
