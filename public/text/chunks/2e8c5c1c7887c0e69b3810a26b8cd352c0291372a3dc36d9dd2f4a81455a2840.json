[{"id":"semetey-1-2013:p0903:b003:l018","ordinal":145153,"en":"Its khojas in patterned robes,"},{"id":"semetey-1-2013:p0903:b003:l019","ordinal":145154,"en":"Its mullahs who give lessons,"},{"id":"semetey-1-2013:p0903:b003:l020","ordinal":145155,"en":"I shall slaughter as sacrifices,"},{"id":"semetey-1-2013:p0903:b003:l021","ordinal":145156,"en":"Have them dragged onto the road,"},{"id":"semetey-1-2013:p0903:b003:l022","ordinal":145157,"en":"And torn apart by dogs!"},{"id":"semetey-1-2013:p0903:b003:l023","ordinal":145158,"en":"Once, on the rugged grassy heights,"},{"id":"semetey-1-2013:p0903:b003:l024","ordinal":145159,"en":"Of the misty plain,"},{"id":"semetey-1-2013:p0903:b003:l025","ordinal":145160,"en":"At its nearer grassy edge,"},{"id":"semetey-1-2013:p0903:b003:l026","ordinal":145161,"en":"Of the moon-pale yellow plain,"},{"id":"semetey-1-2013:p0903:b003:l027","ordinal":145162,"en":"At its nearer end,"},{"id":"semetey-1-2013:p0903:b003:l028","ordinal":145163,"en":"Kokand's khan Kozubek"},{"id":"semetey-1-2013:p0903:b003:l029","ordinal":145164,"en":"Seized him in the open, they say,"},{"id":"semetey-1-2013:p0903:b003:l030","ordinal":145165,"en":"There, Chubak's"},{"id":"semetey-1-2013:p0903:b003:l031","ordinal":145166,"en":"Head was cut off, they say."},{"id":"semetey-1-2013:p0903:b003:l032","ordinal":145167,"en":"Some people tell this."},{"id":"semetey-1-2013:p0903:b003:l034","ordinal":145168,"en":"Unless I die before long,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0903:b003:l035","ordinal":145169,"en":"I shall bring humiliation upon Kokand,"},{"id":"semetey-1-2013:p0903:b003:l036","ordinal":145170,"en":"For Chubak, my father's companion,"},{"id":"semetey-1-2013:p0903:b003:l037","ordinal":145171,"en":"I shall surely take revenge!"},{"id":"semetey-1-2013:p0903:b003:l038","ordinal":145172,"en":"Some people tell this:"},{"id":"semetey-1-2013:p0903:b003:l039","ordinal":145173,"en":"Struck by a bullet, the hero Chubak,"},{"id":"semetey-1-2013:p0903:b004:l001","ordinal":145174,"en":"Black blood flowed from his mouth,"},{"id":"semetey-1-2013:p0903:b004:l002","ordinal":145175,"en":"The leopard's strength ebbed away,"},{"id":"semetey-1-2013:p0903:b004:l003","ordinal":145176,"en":"Khan Chubak wandered on,"},{"id":"semetey-1-2013:p0903:b004:l004","ordinal":145177,"en":"Black blood streaming from his chest,"},{"id":"semetey-1-2013:p0903:b004:l005","ordinal":145178,"en":"Roaming the whole world,"},{"id":"semetey-1-2013:p0903:b004:l006","ordinal":145179,"en":"Through Old Turpan and broad Barbar,"},{"id":"semetey-1-2013:p0903:b004:l007","ordinal":145180,"en":"Traveling from the Kerege side,"},{"id":"semetey-1-2013:p0903:b004:l008","ordinal":145181,"en":"Wandering the gray plain,"},{"id":"semetey-1-2013:p0903:b004:l009","ordinal":145182,"en":"Skirting the gray shrines."},{"id":"semetey-1-2013:p0903:b004:l010","ordinal":145183,"en":"Tradition tells this story:"},{"id":"semetey-1-2013:p0903:b004:l011","ordinal":145184,"en":"Our father Chubak"},{"id":"semetey-1-2013:p0903:b004:l012","ordinal":145185,"en":"Forded Kum-Aryk, they say,"},{"id":"semetey-1-2013:p0903:b004:l013","ordinal":145186,"en":"Wandering through dark groves,"},{"id":"semetey-1-2013:p0903:b004:l015","ordinal":145187,"en":"Of the poplar-covered promontories,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0903:b004:l016","ordinal":145188,"en":"He wandered along their tops,"},{"id":"semetey-1-2013:p0903:b004:l018","ordinal":145189,"en":"Following the banks of Jaman-Suu.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0903:b004:l019","ordinal":145190,"en":"What could dear Chubak do?"},{"id":"semetey-1-2013:p0903:b004:l020","ordinal":145191,"en":"I heard he entered Kashgar."},{"id":"semetey-1-2013:p0903:b004:l021","ordinal":145192,"en":"The people of Kashgar seized him,"},{"id":"semetey-1-2013:p0903:b004:l022","ordinal":145193,"en":"They killed Khan Chubak."},{"id":"semetey-1-2013:p0903:b004:l023","ordinal":145194,"en":"Coughing in harsh bursts,"},{"id":"semetey-1-2013:p0903:b004:l024","ordinal":145195,"en":"Raising my head from the pillow,"},{"id":"semetey-1-2013:p0903:b004:l025","ordinal":145196,"en":"Unless, before I reach my full strength,"},{"id":"semetey-1-2013:p0903:b004:l026","ordinal":145197,"en":"I die before long,"},{"id":"semetey-1-2013:p0903:b004:l027","ordinal":145198,"en":"Upon this Kashgar"},{"id":"semetey-1-2013:p0903:b004:l028","ordinal":145199,"en":"I shall bring upheaval."},{"id":"semetey-1-2013:p0903:b004:l029","ordinal":145200,"en":"For Chubak, my father's companion,"},{"id":"semetey-1-2013:p0903:b004:l030","ordinal":145201,"en":"I shall take revenge without delay."},{"id":"semetey-1-2013:p0903:b004:l031","ordinal":145202,"en":"When my death comes, I shall die."},{"id":"semetey-1-2013:p0903:b004:l032","ordinal":145203,"en":"If you stand by me, forty companions,"},{"id":"semetey-1-2013:p0903:b004:l033","ordinal":145204,"en":"The decree that God has sent,"},{"id":"semetey-1-2013:p0903:b004:l034","ordinal":145205,"en":"I shall face it when it falls upon me."},{"id":"semetey-1-2013:p0903:b004:l035","ordinal":145206,"en":"My khan father was such a hero;"},{"id":"semetey-1-2013:p0903:b004:l036","ordinal":145207,"en":"Against the eighteen thousand worlds"},{"id":"semetey-1-2013:p0903:b004:l037","ordinal":145208,"en":"I shall go on fighting."},{"id":"semetey-1-2013:p0903:b004:l038","ordinal":145209,"en":"I can find no mountain to hurl myself against,"},{"id":"semetey-1-2013:p0903:b004:l039","ordinal":145210,"en":"If you stand by me, forty companions,"},{"id":"semetey-1-2013:p0904:b003:l001","ordinal":145211,"en":"I can find no foe to fight."},{"id":"semetey-1-2013:p0904:b003:l002","ordinal":145212,"en":"Give me a spear and send me against the foe;"},{"id":"semetey-1-2013:p0904:b003:l003","ordinal":145213,"en":"Every mountain I grapple with,"},{"id":"semetey-1-2013:p0904:b003:l004","ordinal":145214,"en":"If I do not crush it to powder,"},{"id":"semetey-1-2013:p0904:b003:l005","ordinal":145215,"en":"Then take my head!"},{"id":"semetey-1-2013:p0904:b003:l006","ordinal":145216,"en":"Stand by me when I enter combat,"},{"id":"semetey-1-2013:p0904:b003:l007","ordinal":145217,"en":"Stand by me when I enter battle!\""},{"id":"semetey-1-2013:p0904:b003:l008","ordinal":145218,"en":"The brave orphan left by Manas,"},{"id":"semetey-1-2013:p0904:b003:l009","ordinal":145219,"en":"Speaking words beyond compare,"},{"id":"semetey-1-2013:p0904:b003:l010","ordinal":145220,"en":"With six multitudes of horses on the hills,"},{"id":"semetey-1-2013:p0904:b003:l011","ordinal":145221,"en":"Thoroughbreds and swift steeds mingled,"},{"id":"semetey-1-2013:p0904:b003:l012","ordinal":145222,"en":"From among those horses"},{"id":"semetey-1-2013:p0904:b003:l013","ordinal":145223,"en":"He slaughtered six hundred white-gray mares."},{"id":"semetey-1-2013:p0904:b003:l014","ordinal":145224,"en":"That son of Manas"},{"id":"semetey-1-2013:p0904:b003:l015","ordinal":145225,"en":"Set all his former deeds aside."},{"id":"semetey-1-2013:p0904:b003:l016","ordinal":145226,"en":"Bakai, at the head of the forty companions,"},{"id":"semetey-1-2013:p0904:b003:l017","ordinal":145227,"en":"He swathed in rich horse fat,"},{"id":"semetey-1-2013:p0904:b003:l018","ordinal":145228,"en":"And propped upon horse tripe."},{"id":"semetey-1-2013:p0904:b003:l019","ordinal":145229,"en":"All the forty companions,"},{"id":"semetey-1-2013:p0904:b003:l020","ordinal":145230,"en":"If bored, he let them shoot roe deer;"},{"id":"semetey-1-2013:p0904:b003:l021","ordinal":145231,"en":"If not bored, he let them rest,"},{"id":"semetey-1-2013:p0904:b003:l022","ordinal":145232,"en":"Settling them back in their places,"},{"id":"semetey-1-2013:p0904:b003:l023","ordinal":145233,"en":"Letting them drink spirits without a care."},{"id":"semetey-1-2013:p0904:b003:l024","ordinal":145234,"en":"When thirsty, he gave them tea;"},{"id":"semetey-1-2013:p0904:b003:l025","ordinal":145235,"en":"When not thirsty, he gave them butter,"},{"id":"semetey-1-2013:p0904:b003:l026","ordinal":145236,"en":"Piling up sugar like snow,"},{"id":"semetey-1-2013:p0904:b003:l027","ordinal":145237,"en":"Heaping up yellow butter,"},{"id":"semetey-1-2013:p0904:b003:l028","ordinal":145238,"en":"Making their yurt felt greasy."},{"id":"semetey-1-2013:p0904:b003:l029","ordinal":145239,"en":"Whenever he met a companion,"},{"id":"semetey-1-2013:p0904:b003:l030","ordinal":145240,"en":"He enriched him on every side."},{"id":"semetey-1-2013:p0904:b003:l031","ordinal":145241,"en":"He clothed them in coats no bullet could pierce,"},{"id":"semetey-1-2013:p0904:b003:l032","ordinal":145242,"en":"Mounted them on horses no bullet could catch,"},{"id":"semetey-1-2013:p0904:b003:l034","ordinal":145243,"en":"Had every piece of their equipment","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0904:b003:l035","ordinal":145244,"en":"Put properly in order,"},{"id":"semetey-1-2013:p0904:b003:l036","ordinal":145245,"en":"Had their spears well prepared,"},{"id":"semetey-1-2013:p0904:b003:l037","ordinal":145246,"en":"Had their battle-axes readied."},{"id":"semetey-1-2013:p0904:b003:l038","ordinal":145247,"en":"To bring slaughter upon the world,"},{"id":"semetey-1-2013:p0904:b003:l039","ordinal":145248,"en":"Semetey, son of the mighty man,"},{"id":"semetey-1-2013:p0904:b004:l001","ordinal":145249,"en":"Prepared with eagerness."},{"id":"semetey-1-2013:p0904:b004:l002","ordinal":145250,"en":"To avenge himself on the Chinese,"},{"id":"semetey-1-2013:p0904:b004:l003","ordinal":145251,"en":"The orphan did not fail to think it through:"},{"id":"semetey-1-2013:p0904:b004:l004","ordinal":145252,"en":"He readied fourteen horses."},{"id":"semetey-1-2013:p0904:b004:l006","ordinal":145253,"en":"They stayed in Talas for five days.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0904:b004:l007","ordinal":145254,"en":"Marking an ordo circle forty foot-lengths across,"},{"id":"semetey-1-2013:p0904:b004:l008","ordinal":145255,"en":"They eagerly shot their knucklebones,"},{"id":"semetey-1-2013:p0904:b004:l009","ordinal":145256,"en":"Staking forty young mares"},{"id":"semetey-1-2013:p0904:b004:l010","ordinal":145257,"en":"As their prizes,"},{"id":"semetey-1-2013:p0904:b004:l011","ordinal":145258,"en":"The winners slaughtering what they won."},{"id":"semetey-1-2013:p0904:b004:l012","ordinal":145259,"en":"With amusements and games,"},{"id":"semetey-1-2013:p0904:b004:l013","ordinal":145260,"en":"The forty companions were thus sated."},{"id":"semetey-1-2013:p0904:b004:l014","ordinal":145261,"en":"While he maintained the forty companions,"},{"id":"semetey-1-2013:p0904:b004:l015","ordinal":145262,"en":"While the boy ruled as khan,"},{"id":"semetey-1-2013:p0904:b004:l016","ordinal":145263,"en":"In Talas at that time,"},{"id":"semetey-1-2013:p0904:b004:l017","ordinal":145264,"en":"Rice was more plentiful than common grain,"},{"id":"semetey-1-2013:p0904:b004:l018","ordinal":145265,"en":"Silver more plentiful than tin,"},{"id":"semetey-1-2013:p0904:b004:l019","ordinal":145266,"en":"Foxes more plentiful than gray hares,"},{"id":"semetey-1-2013:p0904:b004:l020","ordinal":145267,"en":"Much wealth was stored in bundles."},{"id":"semetey-1-2013:p0904:b004:l021","ordinal":145268,"en":"They wore fox and sable furs;"},{"id":"semetey-1-2013:p0904:b004:l022","ordinal":145269,"en":"The forty companions and the multitude—"},{"id":"semetey-1-2013:p0904:b004:l023","ordinal":145270,"en":"Their life in those days,"},{"id":"semetey-1-2013:p0904:b004:l024","ordinal":145271,"en":"To the people of the world's last days,"},{"id":"semetey-1-2013:p0904:b004:l025","ordinal":145272,"en":"Became a tale worthy of telling."},{"id":"semetey-1-2013:p0904:b004:l026","ordinal":145273,"en":"(With rich braid ornaments and broad hips,"},{"id":"semetey-1-2013:p0904:b004:l027","ordinal":145274,"en":"Beautiful were the Kyrgyz brides;"},{"id":"semetey-1-2013:p0904:b004:l028","ordinal":145275,"en":"In red dresses, with crescent waists,"},{"id":"semetey-1-2013:p0904:b004:l029","ordinal":145276,"en":"Beautiful were the Kyrgyz girls;"},{"id":"semetey-1-2013:p0904:b004:l030","ordinal":145277,"en":"In black coats and white kalpaks,"},{"id":"semetey-1-2013:p0904:b004:l031","ordinal":145278,"en":"Handsome were the Kyrgyz young men.)"},{"id":"semetey-1-2013:p0904:b004:l032","ordinal":145279,"en":"In those days, the forty companions,"},{"id":"semetey-1-2013:p0904:b004:l033","ordinal":145280,"en":"With two marten-fur caps apiece"},{"id":"semetey-1-2013:p0904:b004:l034","ordinal":145281,"en":"Set on their brows, swayed in grandeur,"},{"id":"semetey-1-2013:p0904:b004:l035","ordinal":145282,"en":"Over the Argyn and Kyrgyz,"},{"id":"semetey-1-2013:p0904:b004:l036","ordinal":145283,"en":"Living joyfully as sultans."},{"id":"semetey-1-2013:p0904:b004:l037","ordinal":145284,"en":"The lost orphan had been found,"},{"id":"semetey-1-2013:p0904:b004:l038","ordinal":145285,"en":"The Kyrgyz people's shame was covered."},{"id":"semetey-1-2013:p0904:b004:l039","ordinal":145286,"en":"Manas, who had gone to the other world,"},{"id":"semetey-1-2013:p0905:b003:l001","ordinal":145287,"en":"It was as though he were still among them."},{"id":"semetey-1-2013:p0905:b003:l002","ordinal":145288,"en":"Pitching their court, the forty companions"},{"id":"semetey-1-2013:p0905:b003:l003","ordinal":145289,"en":"Settled again in Talas."},{"id":"semetey-1-2013:p0905:b003:l004","ordinal":145290,"en":"All the forty companions"},{"id":"semetey-1-2013:p0905:b003:l005","ordinal":145291,"en":"At Uirulmo-Saz"},{"id":"semetey-1-2013:p0905:b003:l006","ordinal":145292,"en":"Gathered round in assembly,"},{"id":"semetey-1-2013:p0905:b003:l007","ordinal":145293,"en":"At Chogulma-Saz"},{"id":"semetey-1-2013:p0905:b003:l008","ordinal":145294,"en":"Came together in assembly,"},{"id":"semetey-1-2013:p0905:b003:l009","ordinal":145295,"en":"Seeking one another out and meeting,"},{"id":"semetey-1-2013:p0905:b003:l010","ordinal":145296,"en":"Chasing one another in pursuit,"},{"id":"semetey-1-2013:p0905:b003:l011","ordinal":145297,"en":"Growing wild together,"},{"id":"semetey-1-2013:p0905:b003:l012","ordinal":145298,"en":"Hatching wicked plans."},{"id":"semetey-1-2013:p0905:b004:l001","ordinal":145299,"en":"The oath struck those oath-accursed men;"},{"id":"semetey-1-2013:p0905:b004:l002","ordinal":145300,"en":"The forty companions became fools."},{"id":"semetey-1-2013:p0905:b004:l003","ordinal":145301,"en":"A wickedness no one knew"},{"id":"semetey-1-2013:p0905:b004:l004","ordinal":145302,"en":"The forty companions resolved to devise."},{"id":"semetey-1-2013:p0905:b004:l005","ordinal":145303,"en":"They had died in earlier days,"},{"id":"semetey-1-2013:p0905:b004:l006","ordinal":145304,"en":"Tazbaimat and their elder Kyrgyl;"},{"id":"semetey-1-2013:p0905:b004:l007","ordinal":145305,"en":"Now kept that wickedness alive,"},{"id":"semetey-1-2013:p0905:b004:l008","ordinal":145306,"en":"All the forty companions."},{"id":"semetey-1-2013:p0905:b004:l009","ordinal":145307,"en":"Among the forty companions,"},{"id":"semetey-1-2013:p0905:b004:l010","ordinal":145308,"en":"What was there, and what was not?"},{"id":"semetey-1-2013:p0905:b004:l011","ordinal":145309,"en":"Damn you, fleeting world,"},{"id":"semetey-1-2013:p0905:b004:l012","ordinal":145310,"en":"Such was this shitty world!"},{"id":"semetey-1-2013:p0905:b006:l001","ordinal":145311,"en":"The forty swinish companions did not mend,"},{"id":"semetey-1-2013:p0905:b006:l002","ordinal":145312,"en":"They left no lurking wickedness undone,"},{"id":"semetey-1-2013:p0905:b006:l003","ordinal":145313,"en":"They would not side with Semetey."},{"id":"semetey-1-2013:p0905:b006:l004","ordinal":145314,"en":"Among those companions,"},{"id":"semetey-1-2013:p0905:b006:l005","ordinal":145315,"en":"There were leopards among spearmen,"},{"id":"semetey-1-2013:p0905:b006:l006","ordinal":145316,"en":"Skillful companions too;"},{"id":"semetey-1-2013:p0905:b006:l007","ordinal":145317,"en":"Clever in counsel, knowing their work,"},{"id":"semetey-1-2013:p0905:b006:l008","ordinal":145318,"en":"Excellent companions too;"},{"id":"semetey-1-2013:p0905:b006:l009","ordinal":145319,"en":"Wielders of the battle-axe,"},{"id":"semetey-1-2013:p0905:b006:l010","ordinal":145320,"en":"Warrior companions too;"},{"id":"semetey-1-2013:p0905:b006:l011","ordinal":145321,"en":"Whose secrets no one knew,"},{"id":"semetey-1-2013:p0905:b006:l012","ordinal":145322,"en":"Infidel companions too;"},{"id":"semetey-1-2013:p0905:b006:l013","ordinal":145323,"en":"Going wherever someone cried, 'Shoo!'"},{"id":"semetey-1-2013:p0905:b006:l014","ordinal":145324,"en":"Worthless companions too;"},{"id":"semetey-1-2013:p0905:b006:l015","ordinal":145325,"en":"Blustering, unable to grasp words,"},{"id":"semetey-1-2013:p0905:b006:l016","ordinal":145326,"en":"Ignorant companions too;"},{"id":"semetey-1-2013:p0905:b006:l017","ordinal":145327,"en":"Unable to speak or utter words,"},{"id":"semetey-1-2013:p0905:b006:l018","ordinal":145328,"en":"Inarticulate companions too;"},{"id":"semetey-1-2013:p0905:b006:l019","ordinal":145329,"en":"Unable to go outside at night,"},{"id":"semetey-1-2013:p0905:b006:l020","ordinal":145330,"en":"Cowardly companions too;"},{"id":"semetey-1-2013:p0905:b006:l021","ordinal":145331,"en":"Knowing much wisdom and cunning,"},{"id":"semetey-1-2013:p0905:b006:l022","ordinal":145332,"en":"Learned companions too;"},{"id":"semetey-1-2013:p0905:b008:l001","ordinal":145333,"en":"Exceedingly unruly, never keeping peace,"},{"id":"semetey-1-2013:p0905:b008:l002","ordinal":145334,"en":"Cruel companions too;"},{"id":"semetey-1-2013:p0905:b008:l003","ordinal":145335,"en":"Knowing their work in many ways,"},{"id":"semetey-1-2013:p0905:b008:l004","ordinal":145336,"en":"Clear-minded companions too;"},{"id":"semetey-1-2013:p0905:b008:l005","ordinal":145337,"en":"Spreading petty gossip,"},{"id":"semetey-1-2013:p0905:b008:l006","ordinal":145338,"en":"Disruptive companions too."},{"id":"semetey-1-2013:p0905:b008:l007","ordinal":145339,"en":"The best of the forty companions,"},{"id":"semetey-1-2013:p0905:b008:l008","ordinal":145340,"en":"The champion on whom they relied,"},{"id":"semetey-1-2013:p0905:b008:l009","ordinal":145341,"en":"The outstanding one among the forty,"},{"id":"semetey-1-2013:p0905:b008:l010","ordinal":145342,"en":"That God-stricken man was there,"},{"id":"semetey-1-2013:p0905:b008:l011","ordinal":145343,"en":"Chyibyt and Kochkor were there together."},{"id":"semetey-1-2013:p0905:b008:l012","ordinal":145344,"en":"The wicked Adybai and Kolbai were there;"},{"id":"semetey-1-2013:p0905:b008:l013","ordinal":145345,"en":"Their villainy kept increasing,"},{"id":"semetey-1-2013:p0905:b008:l014","ordinal":145346,"en":"Such were these wicked men."},{"id":"semetey-1-2013:p0905:b008:l015","ordinal":145347,"en":"Raging and blustering,"},{"id":"semetey-1-2013:p0905:b008:l016","ordinal":145348,"en":"Like men possessed by an evil spirit,"},{"id":"semetey-1-2013:p0905:b008:l017","ordinal":145349,"en":"Rousing their courage, stamping,"},{"id":"semetey-1-2013:p0905:b008:l018","ordinal":145350,"en":"Growing eager and defiant,"},{"id":"semetey-1-2013:p0905:b008:l019","ordinal":145351,"en":"That daughter-cursing Kochkor began:"},{"id":"semetey-1-2013:p0905:b008:l020","ordinal":145352,"en":"\"Damn you, forty companions,"},{"id":"semetey-1-2013:p0905:b008:l021","ordinal":145353,"en":"All forty of you were red lions,"},{"id":"semetey-1-2013:p0905:b008:l022","ordinal":145354,"en":"Compared with reckless Manas,"},{"id":"semetey-1-2013:p0906:b003:l001","ordinal":145355,"en":"In what way were you his inferiors?"},{"id":"semetey-1-2013:p0906:b003:l002","ordinal":145356,"en":"You brought slaughter upon the world,"},{"id":"semetey-1-2013:p0906:b003:l003","ordinal":145357,"en":"And Manas took the credit for the deeds."},{"id":"semetey-1-2013:p0906:b003:l004","ordinal":145358,"en":"When a hero was speared, you speared him;"},{"id":"semetey-1-2013:p0906:b003:l005","ordinal":145359,"en":"Damn you, forty companions,"},{"id":"semetey-1-2013:p0906:b003:l006","ordinal":145360,"en":"The fame remained with Manas!"},{"id":"semetey-1-2013:p0906:b003:l007","ordinal":145361,"en":"Manas was no greater hero than you;"},{"id":"semetey-1-2013:p0906:b003:l008","ordinal":145362,"en":"The valor of the forty companions"},{"id":"semetey-1-2013:p0906:b003:l010","ordinal":145363,"en":"Damn you, forty companions,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0906:b003:l011","ordinal":145364,"en":"Drink stones instead of spirits!"},{"id":"semetey-1-2013:p0906:b003:l012","ordinal":145365,"en":"Rather than become a boy's companions,"},{"id":"semetey-1-2013:p0906:b003:l013","ordinal":145366,"en":"Drink your fathers' blood as well!"},{"id":"semetey-1-2013:p0906:b003:l014","ordinal":145367,"en":"The valor of the forty companions—"},{"id":"semetey-1-2013:p0906:b003:l015","ordinal":145368,"en":"Can humankind equal it?"},{"id":"semetey-1-2013:p0906:b003:l016","ordinal":145369,"en":"Will you forty companions spend"},{"id":"semetey-1-2013:p0906:b003:l017","ordinal":145370,"en":"Your whole lives as companions?"},{"id":"semetey-1-2013:p0906:b003:l018","ordinal":145371,"en":"With your ardor roused, forty companions,"},{"id":"semetey-1-2013:p0906:b003:l019","ordinal":145372,"en":"Finding no mountain to hurl yourselves against,"},{"id":"semetey-1-2013:p0906:b003:l020","ordinal":145373,"en":"Finding no foe to fight,"},{"id":"semetey-1-2013:p0906:b003:l021","ordinal":145374,"en":"All forty were khans of forty clans,"},{"id":"semetey-1-2013:p0906:b003:l022","ordinal":145375,"en":"All forty were precious lions,"},{"id":"semetey-1-2013:p0906:b003:l023","ordinal":145376,"en":"All forty were wolves from forty places,"},{"id":"semetey-1-2013:p0906:b003:l025","ordinal":145377,"en":"Your battle cries split stone;"},{"id":"semetey-1-2013:p0906:b003:l026","ordinal":145378,"en":"All forty came to Talas from forty places."},{"id":"semetey-1-2013:p0906:b003:l029","ordinal":145379,"en":"You became Manas's companions.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0906:b003:l030","ordinal":145380,"en":"Going back to Keng-Kol,"},{"id":"semetey-1-2013:p0906:b003:l031","ordinal":145381,"en":"You mean to settle there, it seems;"},{"id":"semetey-1-2013:p0906:b003:l032","ordinal":145382,"en":"To Manas's only son"},{"id":"semetey-1-2013:p0906:b003:l033","ordinal":145383,"en":"You mean to return and gather,"},{"id":"semetey-1-2013:p0906:b003:l034","ordinal":145384,"en":"And serve him, it seems."},{"id":"semetey-1-2013:p0906:b003:l035","ordinal":145385,"en":"In the foremost rank of foolishness,"},{"id":"semetey-1-2013:p0906:b003:l036","ordinal":145386,"en":"Who could match you forty companions?"},{"id":"semetey-1-2013:p0906:b003:l037","ordinal":145387,"en":"From father to son,"},{"id":"semetey-1-2013:p0906:b003:l038","ordinal":145388,"en":"Will your lives pass entirely in service?"},{"id":"semetey-1-2013:p0906:b003:l039","ordinal":145389,"en":"Will the forty companions, their strength gone,"},{"id":"semetey-1-2013:p0906:b004:l001","ordinal":145390,"en":"Go scouting again?"},{"id":"semetey-1-2013:p0906:b004:l002","ordinal":145391,"en":"Manas's orphan, who came wandering back—"},{"id":"semetey-1-2013:p0906:b004:l003","ordinal":145392,"en":"Will you make him your lord?"},{"id":"semetey-1-2013:p0906:b004:l004","ordinal":145393,"en":"Better that you had never been born!"},{"id":"semetey-1-2013:p0906:b004:l005","ordinal":145394,"en":"Damn you, forty companions,"},{"id":"semetey-1-2013:p0906:b004:l006","ordinal":145395,"en":"Better die than see this!"},{"id":"semetey-1-2013:p0906:b004:l007","ordinal":145396,"en":"Manas's orphan son—"},{"id":"semetey-1-2013:p0906:b004:l008","ordinal":145397,"en":"See his great oppression:"},{"id":"semetey-1-2013:p0906:b004:l009","ordinal":145398,"en":"He catches and slaughters your colts."},{"id":"semetey-1-2013:p0906:b004:l010","ordinal":145399,"en":"If you make that orphan your lord,"},{"id":"semetey-1-2013:p0906:b004:l011","ordinal":145400,"en":"He will drain much of your strength."},{"id":"semetey-1-2013:p0906:b004:l012","ordinal":145401,"en":"Where could that orphan slave have found it?"},{"id":"semetey-1-2013:p0906:b004:l013","ordinal":145402,"en":"He will ruin your well-being."},{"id":"semetey-1-2013:p0906:b004:l014","ordinal":145403,"en":"Damn you, forty companions,"},{"id":"semetey-1-2013:p0906:b004:l015","ordinal":145404,"en":"Will the boy understand and value"},{"id":"semetey-1-2013:p0906:b004:l016","ordinal":145405,"en":"Your royal dignity?"},{"id":"semetey-1-2013:p0906:b004:l017","ordinal":145406,"en":"When you incur Semetey's wrath,"},{"id":"semetey-1-2013:p0906:b004:l018","ordinal":145407,"en":"He will dig your pit deep,"},{"id":"semetey-1-2013:p0906:b004:l019","ordinal":145408,"en":"He will bring misery upon you."}]
