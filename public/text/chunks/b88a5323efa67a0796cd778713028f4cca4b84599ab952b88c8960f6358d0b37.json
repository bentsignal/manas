[{"id":"semetey-1-2013:p0309:b003:l022","ordinal":100353,"en":"The reckless boy kept traveling,"},{"id":"semetey-1-2013:p0309:b003:l023","ordinal":100354,"en":"Sparing no horse, he traveled far."},{"id":"semetey-1-2013:p0309:b003:l024","ordinal":100355,"en":"Without sparing himself, he traveled,"},{"id":"semetey-1-2013:p0309:b003:l025","ordinal":100356,"en":"Semetey did not stop to hold back."},{"id":"semetey-1-2013:p0309:b003:l026","ordinal":100357,"en":"Drawing near broad Ak-Chiy,"},{"id":"semetey-1-2013:p0309:b003:l027","ordinal":100358,"en":"Along the single path beside it,"},{"id":"semetey-1-2013:p0309:b003:l028","ordinal":100359,"en":"Again the mighty orphan boy"},{"id":"semetey-1-2013:p0309:b003:l029","ordinal":100360,"en":"Skirted the edge of Ak-Chiy,"},{"id":"semetey-1-2013:p0309:b003:l030","ordinal":100361,"en":"And roamed about May-Bulak."},{"id":"semetey-1-2013:p0309:b003:l031","ordinal":100362,"en":"His elder sister Kanykei,"},{"id":"semetey-1-2013:p0309:b003:l032","ordinal":100363,"en":"When the poor woman was a maiden,"},{"id":"semetey-1-2013:p0309:b003:l033","ordinal":100364,"en":"Would go out for pleasure"},{"id":"semetey-1-2013:p0309:b003:l034","ordinal":100365,"en":"To sacred Keng-Kolchuk."},{"id":"semetey-1-2013:p0309:b003:l035","ordinal":100366,"en":"Drawing near Keng-Kolchuk Mountain,"},{"id":"semetey-1-2013:p0309:b003:l036","ordinal":100367,"en":"Onto Keng-Kolchuk's broad ridge"},{"id":"semetey-1-2013:p0309:b003:l037","ordinal":100368,"en":"The boy came up."},{"id":"semetey-1-2013:p0309:b003:l038","ordinal":100369,"en":"Below, through dusty haze,"},{"id":"semetey-1-2013:p0309:b003:l039","ordinal":100370,"en":"He saw gray scrubland."},{"id":"semetey-1-2013:p0309:b004:l001","ordinal":100371,"en":"Its corners loomed through the haze,"},{"id":"semetey-1-2013:p0309:b004:l002","ordinal":100372,"en":"Its edges took shape dimly."},{"id":"semetey-1-2013:p0309:b004:l003","ordinal":100373,"en":"Here and there within it"},{"id":"semetey-1-2013:p0309:b004:l004","ordinal":100374,"en":"Plane trees as large as houses showed."},{"id":"semetey-1-2013:p0309:b004:l005","ordinal":100375,"en":"When he saw those plane trees,"},{"id":"semetey-1-2013:p0309:b004:l006","ordinal":100376,"en":"The boy's heart was stirred."},{"id":"semetey-1-2013:p0309:b004:l007","ordinal":100377,"en":"Kuleshen's Kul-Tokoy—"},{"id":"semetey-1-2013:p0309:b004:l008","ordinal":100378,"en":"Its forest was a fine place."},{"id":"semetey-1-2013:p0309:b004:l009","ordinal":100379,"en":"It had ridge upon rugged ridge,"},{"id":"semetey-1-2013:p0309:b004:l010","ordinal":100380,"en":"And rough mountain passes."},{"id":"semetey-1-2013:p0309:b004:l011","ordinal":100381,"en":"Hill upon hill formed its ridges,"},{"id":"semetey-1-2013:p0309:b004:l012","ordinal":100382,"en":"Its passes ran through foothills."},{"id":"semetey-1-2013:p0309:b004:l013","ordinal":100383,"en":"'My father calls the lower part Kul-Tokoy.'"},{"id":"semetey-1-2013:p0309:b004:l015","ordinal":100384,"en":"Into Kuleshen's Kul-Tokoy"},{"id":"semetey-1-2013:p0309:b004:l016","ordinal":100385,"en":"He entered laughing."},{"id":"semetey-1-2013:p0309:b004:l017","ordinal":100386,"en":"There were scattered marshes;"},{"id":"semetey-1-2013:p0309:b004:l018","ordinal":100387,"en":"Within that forest"},{"id":"semetey-1-2013:p0309:b004:l019","ordinal":100388,"en":"Geese flew singly."},{"id":"semetey-1-2013:p0309:b004:l020","ordinal":100389,"en":"Pintails teemed, stirring the water,"},{"id":"semetey-1-2013:p0309:b004:l021","ordinal":100390,"en":"Red-headed ducks bobbed,"},{"id":"semetey-1-2013:p0309:b004:l022","ordinal":100391,"en":"The cranes cried out;"},{"id":"semetey-1-2013:p0309:b004:l023","ordinal":100392,"en":"When its other cranes called,"},{"id":"semetey-1-2013:p0309:b004:l024","ordinal":100393,"en":"They clamored like women whose husbands had died."},{"id":"semetey-1-2013:p0309:b004:l025","ordinal":100394,"en":"There was snow upon its mountains,"},{"id":"semetey-1-2013:p0309:b004:l026","ordinal":100395,"en":"There were rooks in its forest,"},{"id":"semetey-1-2013:p0309:b004:l027","ordinal":100396,"en":"There were creatures of every kind."},{"id":"semetey-1-2013:p0309:b004:l028","ordinal":100397,"en":"The one God had created"},{"id":"semetey-1-2013:p0309:b004:l029","ordinal":100398,"en":"Such a forest as this,"},{"id":"semetey-1-2013:p0309:b004:l030","ordinal":100399,"en":"Fashioning it into a wondrous dwelling."},{"id":"semetey-1-2013:p0309:b004:l031","ordinal":100400,"en":"Its birds hatched in the birches—"},{"id":"semetey-1-2013:p0309:b004:l032","ordinal":100401,"en":"Good heavens, they were preparing to fly!"},{"id":"semetey-1-2013:p0309:b004:l033","ordinal":100402,"en":"Its birds hatched in the poplars,"},{"id":"semetey-1-2013:p0309:b004:l034","ordinal":100403,"en":"Eagerly bestirring themselves to fly."},{"id":"semetey-1-2013:p0309:b004:l035","ordinal":100404,"en":"Its red plane trees were as large as houses;"},{"id":"semetey-1-2013:p0309:b004:l036","ordinal":100405,"en":"Over and over came the cries"},{"id":"semetey-1-2013:p0309:b004:l037","ordinal":100406,"en":"Of its sweet-voiced snowcocks."},{"id":"semetey-1-2013:p0309:b004:l038","ordinal":100407,"en":"Even after sixty days of enjoyment,"},{"id":"semetey-1-2013:p0309:b004:l039","ordinal":100408,"en":"One would never have one's fill,"},{"id":"semetey-1-2013:p0310:b003:l001","ordinal":100409,"en":"Of the delight of this forest."},{"id":"semetey-1-2013:p0310:b003:l002","ordinal":100410,"en":"Its cuckoos raise their melodies,"},{"id":"semetey-1-2013:p0310:b003:l003","ordinal":100411,"en":"Calling from every willow."},{"id":"semetey-1-2013:p0310:b003:l004","ordinal":100412,"en":"When the cuckoos sing their songs,"},{"id":"semetey-1-2013:p0310:b003:l005","ordinal":100413,"en":"A grieving soul can scarcely bear to hear,"},{"id":"semetey-1-2013:p0310:b003:l006","ordinal":100414,"en":"Yet cannot move a handspan outside."},{"id":"semetey-1-2013:p0310:b003:l007","ordinal":100415,"en":"Its nightingales sing until dawn;"},{"id":"semetey-1-2013:p0310:b003:l008","ordinal":100416,"en":"Their voices take a thousand forms."},{"id":"semetey-1-2013:p0310:b003:l009","ordinal":100417,"en":"A sorrowful soul can scarcely bear to listen;"},{"id":"semetey-1-2013:p0310:b003:l010","ordinal":100418,"en":"All those burdened with grief"},{"id":"semetey-1-2013:p0310:b003:l011","ordinal":100419,"en":"Cannot leave this forest."},{"id":"semetey-1-2013:p0310:b003:l012","ordinal":100420,"en":"Kuleshen's Kul-Tokoy"},{"id":"semetey-1-2013:p0310:b003:l013","ordinal":100421,"en":"Was a place for laughter and delight,"},{"id":"semetey-1-2013:p0310:b003:l014","ordinal":100422,"en":"Every wondrous occupation—"},{"id":"semetey-1-2013:p0310:b003:l015","ordinal":100423,"en":"A place to learn it and take pleasure,"},{"id":"semetey-1-2013:p0310:b003:l016","ordinal":100424,"en":"A place where a true man"},{"id":"semetey-1-2013:p0310:b003:l017","ordinal":100425,"en":"Could do what he knew and take pleasure,"},{"id":"semetey-1-2013:p0310:b003:l018","ordinal":100426,"en":"Where a brave young man"},{"id":"semetey-1-2013:p0310:b003:l019","ordinal":100427,"en":"Could remain of his own free will,"},{"id":"semetey-1-2013:p0310:b003:l020","ordinal":100428,"en":"Pitching tents, tethering mares,"},{"id":"semetey-1-2013:p0310:b003:l021","ordinal":100429,"en":"And settling down to camp."},{"id":"semetey-1-2013:p0310:b003:l022","ordinal":100430,"en":"Its apples ripened and became manure,"},{"id":"semetey-1-2013:p0310:b003:l023","ordinal":100431,"en":"Its fallen oleaster fruit filled the ravines."},{"id":"semetey-1-2013:p0310:b003:l024","ordinal":100432,"en":"Its leaves were like tanned hide,"},{"id":"semetey-1-2013:p0310:b003:l025","ordinal":100433,"en":"Its black widow spiders thumb-sized,"},{"id":"semetey-1-2013:p0310:b003:l026","ordinal":100434,"en":"Its chervil thick as a wrist."},{"id":"semetey-1-2013:p0310:b003:l027","ordinal":100435,"en":"When its maral deer fled at a shout,"},{"id":"semetey-1-2013:p0310:b003:l028","ordinal":100436,"en":"They were like pale cows with white blazes."},{"id":"semetey-1-2013:p0310:b003:l029","ordinal":100437,"en":"Its pheasants were like red leather pails."},{"id":"semetey-1-2013:p0310:b003:l030","ordinal":100438,"en":"It was a place to roam for pleasure."},{"id":"semetey-1-2013:p0310:b003:l031","ordinal":100439,"en":"'With sacred virtue settled here,"},{"id":"semetey-1-2013:p0310:b003:l032","ordinal":100440,"en":"My father calls it Kul-Tokoy.'"},{"id":"semetey-1-2013:p0310:b003:l033","ordinal":100441,"en":"Along the winding water,"},{"id":"semetey-1-2013:p0310:b003:l034","ordinal":100442,"en":"Through willows that hid the sky,"},{"id":"semetey-1-2013:p0310:b003:l035","ordinal":100443,"en":"The boy rode swiftly, rejoicing."},{"id":"semetey-1-2013:p0310:b003:l036","ordinal":100444,"en":"He cast off Akshumkar,"},{"id":"semetey-1-2013:p0310:b003:l037","ordinal":100445,"en":"Made it seize geese and ducks,"},{"id":"semetey-1-2013:p0310:b003:l038","ordinal":100446,"en":"And all his saddle straps"},{"id":"semetey-1-2013:p0310:b003:l039","ordinal":100447,"en":"Were marked with geese and swans."},{"id":"semetey-1-2013:p0310:b004:l001","ordinal":100448,"en":"Skirting Kul-Tokoy,"},{"id":"semetey-1-2013:p0310:b004:l002","ordinal":100449,"en":"When the saddle straps could hold no more,"},{"id":"semetey-1-2013:p0310:b004:l003","ordinal":100450,"en":"He fastened them to the crupper."},{"id":"semetey-1-2013:p0310:b004:l004","ordinal":100451,"en":"His mount was Aktulpar,"},{"id":"semetey-1-2013:p0310:b004:l005","ordinal":100452,"en":"In his hand was Akshumkar."},{"id":"semetey-1-2013:p0310:b004:l006","ordinal":100453,"en":"It was the time he entered a wondrous place,"},{"id":"semetey-1-2013:p0310:b004:l007","ordinal":100454,"en":"The time he flew his falcon boldly,"},{"id":"semetey-1-2013:p0310:b004:l008","ordinal":100455,"en":"The world forgotten from his mind,"},{"id":"semetey-1-2013:p0310:b004:l009","ordinal":100456,"en":"The time the boy took his pleasure."},{"id":"semetey-1-2013:p0310:b004:l010","ordinal":100457,"en":"Making Akshumkar ready,"},{"id":"semetey-1-2013:p0310:b004:l011","ordinal":100458,"en":"Semetey swung it out."},{"id":"semetey-1-2013:p0310:b004:l012","ordinal":100459,"en":"'Such joy and entertainment,"},{"id":"semetey-1-2013:p0310:b004:l013","ordinal":100460,"en":"Such wonders I have seen today!'"},{"id":"semetey-1-2013:p0310:b004:l014","ordinal":100461,"en":"Semetey reveled."},{"id":"semetey-1-2013:p0310:b004:l015","ordinal":100462,"en":"At the head of Batkaktuu,"},{"id":"semetey-1-2013:p0310:b004:l016","ordinal":100463,"en":"Where thorns mingled with willows,"},{"id":"semetey-1-2013:p0310:b004:l017","ordinal":100464,"en":"At the meeting of the thickets,"},{"id":"semetey-1-2013:p0310:b004:l018","ordinal":100465,"en":"The boy was taking his pleasure."},{"id":"semetey-1-2013:p0310:b004:l019","ordinal":100466,"en":"Ysmayyl's kettledrum"},{"id":"semetey-1-2013:p0310:b004:l020","ordinal":100467,"en":"Clanged when struck with a whip."},{"id":"semetey-1-2013:p0310:b004:l021","ordinal":100468,"en":"If a club struck the damned thing,"},{"id":"semetey-1-2013:p0310:b004:l022","ordinal":100469,"en":"It boomed, shaking the earth."},{"id":"semetey-1-2013:p0310:b004:l023","ordinal":100470,"en":"The whip with dark handle"},{"id":"semetey-1-2013:p0310:b004:l024","ordinal":100471,"en":"He grasped and swung round."},{"id":"semetey-1-2013:p0310:b004:l025","ordinal":100472,"en":"Into the middle of the kettledrum"},{"id":"semetey-1-2013:p0310:b004:l026","ordinal":100473,"en":"Semetey struck."},{"id":"semetey-1-2013:p0310:b004:l027","ordinal":100474,"en":"Wild cries and hollow cheers"},{"id":"semetey-1-2013:p0310:b004:l028","ordinal":100475,"en":"He sent ringing through the forest."},{"id":"semetey-1-2013:p0310:b004:l029","ordinal":100476,"en":"A blue hen pheasant, big as a little pail,"},{"id":"semetey-1-2013:p0310:b004:l030","ordinal":100477,"en":"With iron spurs and a copper jess-plate,"},{"id":"semetey-1-2013:p0310:b004:l031","ordinal":100478,"en":"Its golden wings two ells long,"},{"id":"semetey-1-2013:p0310:b004:l032","ordinal":100479,"en":"Shot straight upward with a whir,"},{"id":"semetey-1-2013:p0310:b004:l033","ordinal":100480,"en":"And fluttered eastward."},{"id":"semetey-1-2013:p0310:b004:l034","ordinal":100481,"en":"It seemed lit by moonlight."},{"id":"semetey-1-2013:p0310:b004:l035","ordinal":100482,"en":"Manas's orphaned son,"},{"id":"semetey-1-2013:p0310:b004:l036","ordinal":100483,"en":"Enchanted by the hen pheasant,"},{"id":"semetey-1-2013:p0310:b004:l037","ordinal":100484,"en":"Had his heart deeply stirred."},{"id":"semetey-1-2013:p0310:b004:l038","ordinal":100485,"en":"Was it Khizyr, rather than a pheasant?"},{"id":"semetey-1-2013:p0310:b004:l039","ordinal":100486,"en":"To reach its mountain slope,"},{"id":"semetey-1-2013:p0311:b003:l001","ordinal":100487,"en":"Was it an envoy passing between them?"},{"id":"semetey-1-2013:p0311:b003:l002","ordinal":100488,"en":"Was it the eye of a saint?"},{"id":"semetey-1-2013:p0311:b003:l003","ordinal":100489,"en":"Sary Khan and Semetey—"},{"id":"semetey-1-2013:p0311:b003:l004","ordinal":100490,"en":"Was this the time to bring them together?"},{"id":"semetey-1-2013:p0311:b003:l005","ordinal":100491,"en":"Unable to bear seeing the pheasant escape,"},{"id":"semetey-1-2013:p0311:b003:l006","ordinal":100492,"en":"He turned Aktulpar's head."},{"id":"semetey-1-2013:p0311:b003:l007","ordinal":100493,"en":"Leaning sideways, Semetey"},{"id":"semetey-1-2013:p0311:b003:l008","ordinal":100494,"en":"Cast Akshumkar forth."},{"id":"semetey-1-2013:p0311:b003:l009","ordinal":100495,"en":"The mighty champion, the dear lion,"},{"id":"semetey-1-2013:p0311:b003:l010","ordinal":100496,"en":"Ah, the dear warrior, fierce as a cock,"},{"id":"semetey-1-2013:p0311:b003:l011","ordinal":100497,"en":"Began with great fury."},{"id":"semetey-1-2013:p0311:b003:l012","ordinal":100498,"en":"He launched Akshumkar with such force"},{"id":"semetey-1-2013:p0311:b003:l013","ordinal":100499,"en":"That Aktulpar beneath him"},{"id":"semetey-1-2013:p0311:b003:l014","ordinal":100500,"en":"Nearly fell."},{"id":"semetey-1-2013:p0311:b003:l015","ordinal":100501,"en":"It stumbled and sank out of sight,"},{"id":"semetey-1-2013:p0311:b003:l016","ordinal":100502,"en":"Tripped and righted itself,"},{"id":"semetey-1-2013:p0311:b003:l017","ordinal":100503,"en":"Its fetlocks bending,"},{"id":"semetey-1-2013:p0311:b003:l018","ordinal":100504,"en":"Turning round and staggering."},{"id":"semetey-1-2013:p0311:b003:l019","ordinal":100505,"en":"Aktulpar, a true racer,"},{"id":"semetey-1-2013:p0311:b003:l020","ordinal":100506,"en":"Barely recovered its balance."},{"id":"semetey-1-2013:p0311:b003:l021","ordinal":100507,"en":"Akshumkar, released from the hand,"},{"id":"semetey-1-2013:p0311:b003:l022","ordinal":100508,"en":"Rose and set its course,"},{"id":"semetey-1-2013:p0311:b003:l023","ordinal":100509,"en":"As though it had not seen its quarry."},{"id":"semetey-1-2013:p0311:b003:l024","ordinal":100510,"en":"It circled and hovered,"},{"id":"semetey-1-2013:p0311:b003:l025","ordinal":100511,"en":"Flying back, tilting away."},{"id":"semetey-1-2013:p0311:b003:l026","ordinal":100512,"en":"With iron talons and a copper jess-plate,"},{"id":"semetey-1-2013:p0311:b003:l027","ordinal":100513,"en":"Two ells around,"},{"id":"semetey-1-2013:p0311:b003:l028","ordinal":100514,"en":"Black-eyed, with blue-flecked legs,"},{"id":"semetey-1-2013:p0311:b003:l029","ordinal":100515,"en":"It never spared what it was shown,"},{"id":"semetey-1-2013:p0311:b003:l030","ordinal":100516,"en":"Never filled itself with a pail of meat,"},{"id":"semetey-1-2013:p0311:b003:l031","ordinal":100517,"en":"Never ceased its eager fluttering,"},{"id":"semetey-1-2013:p0311:b003:l032","ordinal":100518,"en":"Never filled itself with a platter of meat."},{"id":"semetey-1-2013:p0311:b003:l033","ordinal":100519,"en":"'You do not fold your wings and stoop,"},{"id":"semetey-1-2013:p0311:b003:l034","ordinal":100520,"en":"Yet you let no goose fly from the lake;"},{"id":"semetey-1-2013:p0311:b003:l035","ordinal":100521,"en":"You do not fold your tail and stoop—"},{"id":"semetey-1-2013:p0311:b003:l036","ordinal":100522,"en":"Why has God struck you so?"},{"id":"semetey-1-2013:p0311:b003:l037","ordinal":100523,"en":"Let alone a pheasant, Akshumkar,"},{"id":"semetey-1-2013:p0311:b003:l038","ordinal":100524,"en":"You let no swan fly from the lake!"},{"id":"semetey-1-2013:p0311:b003:l039","ordinal":100525,"en":"I shall untie your tether and free you,"},{"id":"semetey-1-2013:p0311:b004:l001","ordinal":100526,"en":"And part with you in this forest."},{"id":"semetey-1-2013:p0311:b004:l002","ordinal":100527,"en":"If I do not speak my words of pardon,"},{"id":"semetey-1-2013:p0311:b004:l003","ordinal":100528,"en":"Become a stranger to you here,"},{"id":"semetey-1-2013:p0311:b004:l004","ordinal":100529,"en":"And turn back toward Bukhara!'"},{"id":"semetey-1-2013:p0311:b004:l005","ordinal":100530,"en":"Then, saying this,"},{"id":"semetey-1-2013:p0311:b004:l006","ordinal":100531,"en":"He shouted in fury,"},{"id":"semetey-1-2013:p0311:b004:l007","ordinal":100532,"en":"Raising the battle cry, 'Temir!'"},{"id":"semetey-1-2013:p0311:b004:l008","ordinal":100533,"en":"The whip with dark handle"},{"id":"semetey-1-2013:p0311:b004:l009","ordinal":100534,"en":"He grasped and swung round."},{"id":"semetey-1-2013:p0311:b004:l010","ordinal":100535,"en":"Aktulpar beneath him"},{"id":"semetey-1-2013:p0311:b004:l011","ordinal":100536,"en":"He struck upon the hock."},{"id":"semetey-1-2013:p0311:b004:l012","ordinal":100537,"en":"The white reins of tanned hide"},{"id":"semetey-1-2013:p0311:b004:l013","ordinal":100538,"en":"He let loose without pulling them back."},{"id":"semetey-1-2013:p0311:b004:l014","ordinal":100539,"en":"The blood-drinker's offspring"},{"id":"semetey-1-2013:p0311:b004:l015","ordinal":100540,"en":"Began pursuing the pheasant."},{"id":"semetey-1-2013:p0311:b004:l016","ordinal":100541,"en":"Wild cries and hollow cheers—"},{"id":"semetey-1-2013:p0311:b004:l017","ordinal":100542,"en":"He spared not his voice,"},{"id":"semetey-1-2013:p0311:b004:l018","ordinal":100543,"en":"And began pursuing the pheasant."},{"id":"semetey-1-2013:p0311:b004:l019","ordinal":100544,"en":"The pheasant in the sky, he on the ground,"},{"id":"semetey-1-2013:p0311:b004:l020","ordinal":100545,"en":"He made a spectacle there."},{"id":"semetey-1-2013:p0311:b004:l021","ordinal":100546,"en":"Aktulpar, now in full condition,"},{"id":"semetey-1-2013:p0311:b004:l022","ordinal":100547,"en":"Tore up the ground beneath it."},{"id":"semetey-1-2013:p0311:b004:l023","ordinal":100548,"en":"Clods as large as a great cauldron"},{"id":"semetey-1-2013:p0311:b004:l024","ordinal":100549,"en":"Above the dear young lord's"},{"id":"semetey-1-2013:p0311:b004:l025","ordinal":100550,"en":"Head went whirling."},{"id":"semetey-1-2013:p0311:b004:l026","ordinal":100551,"en":"Its hooves thundered upon the earth;"},{"id":"semetey-1-2013:p0311:b004:l027","ordinal":100552,"en":"Its dark steel bit"},{"id":"semetey-1-2013:p0311:b004:l028","ordinal":100553,"en":"Clattered within its throat."},{"id":"semetey-1-2013:p0311:b004:l029","ordinal":100554,"en":"Its mouth gaped like a ravenous maw;"},{"id":"semetey-1-2013:p0311:b004:l030","ordinal":100555,"en":"White foam mixed with blood"},{"id":"semetey-1-2013:p0311:b004:l031","ordinal":100556,"en":"Spattered its breast."},{"id":"semetey-1-2013:p0311:b004:l032","ordinal":100557,"en":"The earth split as it flashed across;"},{"id":"semetey-1-2013:p0311:b004:l033","ordinal":100558,"en":"The winged racer Aktulpar"},{"id":"semetey-1-2013:p0311:b004:l034","ordinal":100559,"en":"Ran straight on, drawing near."},{"id":"semetey-1-2013:p0311:b004:l035","ordinal":100560,"en":"Ysmayyl's Akshumkar,"},{"id":"semetey-1-2013:p0311:b004:l036","ordinal":100561,"en":"Making a short flight and wheeling,"},{"id":"semetey-1-2013:p0311:b004:l037","ordinal":100562,"en":"Shot ahead of an arrow."},{"id":"semetey-1-2013:p0311:b004:l038","ordinal":100563,"en":"Turning in a tight circle,"},{"id":"semetey-1-2013:p0311:b004:l039","ordinal":100564,"en":"It darted toward the pheasant,"},{"id":"semetey-1-2013:p0312:b003:l001","ordinal":100565,"en":"Just as it reached to seize its prey,"},{"id":"semetey-1-2013:p0312:b003:l002","ordinal":100566,"en":"It plunged straight down and was checked."},{"id":"semetey-1-2013:p0312:b003:l003","ordinal":100567,"en":"Into a grass shelter, a half-sized dwelling,"},{"id":"semetey-1-2013:p0312:b003:l004","ordinal":100568,"en":"The pheasant slipped uncaught and escaped."},{"id":"semetey-1-2013:p0312:b003:l005","ordinal":100569,"en":"Enthralled by the pheasant,"},{"id":"semetey-1-2013:p0312:b003:l006","ordinal":100570,"en":"The orphan favored by Khizyr came on,"},{"id":"semetey-1-2013:p0312:b003:l007","ordinal":100571,"en":"Beating the kettledrum,"},{"id":"semetey-1-2013:p0312:b003:l008","ordinal":100572,"en":"And looking fiercely about."},{"id":"semetey-1-2013:p0312:b003:l009","ordinal":100573,"en":"To find the pheasant,"},{"id":"semetey-1-2013:p0312:b003:l010","ordinal":100574,"en":"He gave no heed to his surroundings,"},{"id":"semetey-1-2013:p0312:b003:l011","ordinal":100575,"en":"Sparing himself not at all,"},{"id":"semetey-1-2013:p0312:b003:l012","ordinal":100576,"en":"Making his horse trample the forest."},{"id":"semetey-1-2013:p0312:b003:l013","ordinal":100577,"en":"Angry and tense,"},{"id":"semetey-1-2013:p0312:b003:l014","ordinal":100578,"en":"At the falcon that had failed to catch it"},{"id":"semetey-1-2013:p0312:b003:l015","ordinal":100579,"en":"He scolded harder than at a man:"},{"id":"semetey-1-2013:p0312:b003:l016","ordinal":100580,"en":"'A harrier is a bird, and so are you."},{"id":"semetey-1-2013:p0312:b003:l017","ordinal":100581,"en":"If you were not a mere harrier,"},{"id":"semetey-1-2013:p0312:b003:l018","ordinal":100582,"en":"If you caught the pheasant for me,"},{"id":"semetey-1-2013:p0312:b003:l019","ordinal":100583,"en":"If I took it and slaughtered it lawfully,"},{"id":"semetey-1-2013:p0312:b003:l020","ordinal":100584,"en":"If I fastened it to my saddle straps,"},{"id":"semetey-1-2013:p0312:b003:l021","ordinal":100585,"en":"To my dear sister Kanykei,"},{"id":"semetey-1-2013:p0312:b003:l022","ordinal":100586,"en":"That widow living as a fugitive,"},{"id":"semetey-1-2013:p0312:b003:l023","ordinal":100587,"en":"If I went bearing it as a gift,"},{"id":"semetey-1-2013:p0312:b003:l024","ordinal":100588,"en":"From my fierce brother-in-law Khan Manas,"},{"id":"semetey-1-2013:p0312:b003:l025","ordinal":100589,"en":"The great wealth lying hidden—"},{"id":"semetey-1-2013:p0312:b003:l026","ordinal":100590,"en":"If I asked for it and received it,"},{"id":"semetey-1-2013:p0312:b003:l027","ordinal":100591,"en":"I could take my pleasure with a contented heart."},{"id":"semetey-1-2013:p0312:b003:l028","ordinal":100592,"en":"Damn your father's grave, Akshumkar!"},{"id":"semetey-1-2013:p0312:b003:l029","ordinal":100593,"en":"I should have no complaint against you!"},{"id":"semetey-1-2013:p0312:b003:l030","ordinal":100594,"en":"If you reached and struck the pheasant,"},{"id":"semetey-1-2013:p0312:b003:l031","ordinal":100595,"en":"If you opened your eyes wide,"},{"id":"semetey-1-2013:p0312:b003:l032","ordinal":100596,"en":"I could bind it up and fold it,"},{"id":"semetey-1-2013:p0312:b003:l033","ordinal":100597,"en":"And secure it to my saddle straps."},{"id":"semetey-1-2013:p0312:b003:l034","ordinal":100598,"en":"For the great matron, my kinswoman by marriage,"},{"id":"semetey-1-2013:p0312:b003:l035","ordinal":100599,"en":"If you caught the pheasant for me,"},{"id":"semetey-1-2013:p0312:b003:l036","ordinal":100600,"en":"When I went to present it,"},{"id":"semetey-1-2013:p0312:b003:l037","ordinal":100601,"en":"The enemy-surveying instrument left by Manas,"},{"id":"semetey-1-2013:p0312:b003:l038","ordinal":100602,"en":"That precious telescope,"},{"id":"semetey-1-2013:p0312:b003:l039","ordinal":100603,"en":"I could ask for it as a gift."},{"id":"semetey-1-2013:p0312:b004:l001","ordinal":100604,"en":"To that kinswoman by marriage, my sister,"},{"id":"semetey-1-2013:p0312:b004:l002","ordinal":100605,"en":"When I would go bearing a gift,"},{"id":"semetey-1-2013:p0312:b004:l003","ordinal":100606,"en":"You failed to reach the pheasant:"},{"id":"semetey-1-2013:p0312:b004:l004","ordinal":100607,"en":"Has God struck you?"},{"id":"semetey-1-2013:p0312:b004:l005","ordinal":100608,"en":"Meat from a yearling sheep's hock—"}]
