[{"id":"manas-2010:p1415:b001:l039","ordinal":61185,"en":"Resting neither by day"},{"id":"manas-2010:p1415:b001:l040","ordinal":61186,"en":"Nor sleeping through the night,"},{"id":"manas-2010:p1415:b001:l041","ordinal":61187,"en":"Kept prowling, that Kongurbay."},{"id":"manas-2010:p1415:b001:l042","ordinal":61188,"en":"With Koshoy and Bakay at their head,"},{"id":"manas-2010:p1416:b001:l001","ordinal":61189,"en":"They proclaimed his khanship."},{"id":"manas-2010:p1416:b001:l002","ordinal":61190,"en":"“Manas has become khan of Beijing"},{"id":"manas-2010:p1416:b001:l003","ordinal":61191,"en":"And mounted the golden throne!” they said."},{"id":"manas-2010:p1416:b001:l004","ordinal":61192,"en":"Setting him upon Zhelmaian,"},{"id":"manas-2010:p1416:b001:l005","ordinal":61193,"en":"Hero Shuutu, with his felt-roof-sized hat,"},{"id":"manas-2010:p1416:b001:l006","ordinal":61194,"en":"They sent to announce the good news."},{"id":"manas-2010:p1416:b001:l007","ordinal":61195,"en":"To Kanykey's presence,"},{"id":"manas-2010:p1416:b001:l008","ordinal":61196,"en":"The broad-humped black camel,"},{"id":"manas-2010:p1416:b001:l009","ordinal":61197,"en":"Hero Manas's Zhelmaian—"},{"id":"manas-2010:p1416:b001:l010","ordinal":61198,"en":"No wind could match his trot,"},{"id":"manas-2010:p1416:b001:l011","ordinal":61199,"en":"No beast could match his walk."},{"id":"manas-2010:p1416:b001:l012","ordinal":61200,"en":"Zhelmaian, swiftest among beasts,"},{"id":"manas-2010:p1416:b001:l013","ordinal":61201,"en":"Escaped the eye when one looked;"},{"id":"manas-2010:p1416:b001:l014","ordinal":61202,"en":"His running could not be perceived."},{"id":"manas-2010:p1416:b001:l015","ordinal":61203,"en":"Then hero Shuutu"},{"id":"manas-2010:p1416:b001:l016","ordinal":61204,"en":"Spread the news among the people,"},{"id":"manas-2010:p1416:b001:l017","ordinal":61205,"en":"To the Argyn and Nogoy in Talas,"},{"id":"manas-2010:p1416:b001:l018","ordinal":61206,"en":"To Kaynar's dark-eyed beauty."},{"id":"manas-2010:p1416:b001:l019","ordinal":61207,"en":"Bearing good news, he went"},{"id":"manas-2010:p1416:b001:l020","ordinal":61208,"en":"To Kanykey herself."},{"id":"manas-2010:p1416:b001:l021","ordinal":61209,"en":"“Upon the Chinese emperor's Beijing"},{"id":"manas-2010:p1416:b001:l022","ordinal":61210,"en":"He swept and waged war."},{"id":"manas-2010:p1416:b001:l023","ordinal":61211,"en":"Fighting six months without rest,"},{"id":"manas-2010:p1416:b001:l024","ordinal":61212,"en":"We destroyed Beijing's palace;"},{"id":"manas-2010:p1416:b001:l025","ordinal":61213,"en":"We slaughtered its shaven-headed priests."},{"id":"manas-2010:p1416:b001:l026","ordinal":61214,"en":"From Beijing we seized"},{"id":"manas-2010:p1416:b001:l027","ordinal":61215,"en":"Many a splendid pacing horse."},{"id":"manas-2010:p1416:b001:l028","ordinal":61216,"en":"We raised the dust of Beijing;"},{"id":"manas-2010:p1416:b001:l029","ordinal":61217,"en":"We slaughtered many of its khans."},{"id":"manas-2010:p1416:b001:l030","ordinal":61218,"en":"Of famed Chinese Beijing,"},{"id":"manas-2010:p1416:b001:l031","ordinal":61219,"en":"We felled all its willows;"},{"id":"manas-2010:p1416:b001:l032","ordinal":61220,"en":"We pushed its buildings down."},{"id":"manas-2010:p1416:b001:l033","ordinal":61221,"en":"Beijing where no prophet had trodden,"},{"id":"manas-2010:p1416:b001:l034","ordinal":61222,"en":"We entered at its head and made a road."},{"id":"manas-2010:p1416:b001:l035","ordinal":61223,"en":"Beijing that no one dared touch,"},{"id":"manas-2010:p1416:b001:l036","ordinal":61224,"en":"We entered and attacked."},{"id":"manas-2010:p1416:b001:l037","ordinal":61225,"en":"Besides launching our attack,"},{"id":"manas-2010:p1416:b001:l038","ordinal":61226,"en":"We took much splendid booty;"},{"id":"manas-2010:p1416:b001:l039","ordinal":61227,"en":"We took gold coins in elephant-loads."},{"id":"manas-2010:p1416:b001:l040","ordinal":61228,"en":"We took a thousand dark-eyed ones."},{"id":"manas-2010:p1416:b001:l041","ordinal":61229,"en":"Beijing that Alexander never attacked,"},{"id":"manas-2010:p1416:b001:l042","ordinal":61230,"en":"We found a way and assaulted."},{"id":"manas-2010:p1417:b001:l001","ordinal":61231,"en":"Beijing that Chalyar could not reach,"},{"id":"manas-2010:p1417:b001:l002","ordinal":61232,"en":"We overturned, entering within;"},{"id":"manas-2010:p1417:b001:l003","ordinal":61233,"en":"Our strength sufficed, and we took it."},{"id":"manas-2010:p1417:b001:l004","ordinal":61234,"en":"Beijing untouched by the Flood,"},{"id":"manas-2010:p1417:b001:l005","ordinal":61235,"en":"Scattering its people to pieces,"},{"id":"manas-2010:p1417:b001:l006","ordinal":61236,"en":"We crushed and conquered."},{"id":"manas-2010:p1417:b001:l007","ordinal":61237,"en":"We smashed it to fragments;"},{"id":"manas-2010:p1417:b001:l008","ordinal":61238,"en":"We bloodied our lance points;"},{"id":"manas-2010:p1417:b001:l009","ordinal":61239,"en":"We turned heaven and earth to dust."},{"id":"manas-2010:p1417:b001:l010","ordinal":61240,"en":"Passing among the Chinese,"},{"id":"manas-2010:p1417:b001:l011","ordinal":61241,"en":"We slaughtered, destroyed and crippled them."},{"id":"manas-2010:p1417:b001:l012","ordinal":61242,"en":"Putting a golden crown upon him,"},{"id":"manas-2010:p1417:b001:l013","ordinal":61243,"en":"Magnanimous warrior Manas"},{"id":"manas-2010:p1417:b001:l014","ordinal":61244,"en":"We made khan of Great Beijing.”"},{"id":"manas-2010:p1417:b001:l015","ordinal":61245,"en":"After Shuutu had gone with the news,"},{"id":"manas-2010:p1417:b001:l016","ordinal":61246,"en":"After he had delivered the news,"},{"id":"manas-2010:p1417:b001:l017","ordinal":61247,"en":"Kanykey, the khan's wife,"},{"id":"manas-2010:p1417:b001:l018","ordinal":61248,"en":"The beauty of the dusky-complexioned,"},{"id":"manas-2010:p1417:b001:l019","ordinal":61249,"en":"The radiant one among Muslims,"},{"id":"manas-2010:p1417:b001:l020","ordinal":61250,"en":"When Shuutu came with the news,"},{"id":"manas-2010:p1417:b001:l021","ordinal":61251,"en":"Stood weeping with piercing cries."},{"id":"manas-2010:p1417:b001:l022","ordinal":61252,"en":"Her tears flowed in ten streams;"},{"id":"manas-2010:p1417:b001:l023","ordinal":61253,"en":"She stood sobbing and wailing."},{"id":"manas-2010:p1417:b001:l024","ordinal":61254,"en":"How could Kanykey rejoice?"},{"id":"manas-2010:p1417:b001:l025","ordinal":61255,"en":"Far from rejoicing, she grieved."},{"id":"manas-2010:p1417:b001:l026","ordinal":61256,"en":"“Instead of saying he mastered Beijing,"},{"id":"manas-2010:p1417:b001:l027","ordinal":61257,"en":"Say he has come to know hardship!"},{"id":"manas-2010:p1417:b001:l028","ordinal":61258,"en":"Instead of saying he mounted a golden throne,"},{"id":"manas-2010:p1417:b001:l029","ordinal":61259,"en":"Say his appointed death has come!"},{"id":"manas-2010:p1417:b001:l030","ordinal":61260,"en":"At Beijing untouched by torrents,"},{"id":"manas-2010:p1417:b001:l031","ordinal":61261,"en":"His shouting lance attack"},{"id":"manas-2010:p1417:b001:l032","ordinal":61262,"en":"Means the people will be left slaughtered."},{"id":"manas-2010:p1417:b001:l033","ordinal":61263,"en":"Beijing the Flood could not cover—"},{"id":"manas-2010:p1417:b001:l034","ordinal":61264,"en":"Did he say he would enter without stopping?"},{"id":"manas-2010:p1417:b001:l035","ordinal":61265,"en":"Though I tried to stop him, he would not listen."},{"id":"manas-2010:p1417:b001:l036","ordinal":61266,"en":"A young son remains behind;"},{"id":"manas-2010:p1417:b001:l037","ordinal":61267,"en":"Did he mean to cast me into hell?"},{"id":"manas-2010:p1417:b001:l038","ordinal":61268,"en":"Beijing where no prophet trod—"},{"id":"manas-2010:p1417:b001:l039","ordinal":61269,"en":"Did he say his worth would suffice?"},{"id":"manas-2010:p1417:b001:l040","ordinal":61270,"en":"My forehead bone was curved;"},{"id":"manas-2010:p1417:b001:l041","ordinal":61271,"en":"After my sovereign passes away,"},{"id":"manas-2010:p1417:b001:l042","ordinal":61272,"en":"My means of living would be scant."},{"id":"manas-2010:p1418:b001:l001","ordinal":61273,"en":"My people's taking Beijing"},{"id":"manas-2010:p1418:b001:l002","ordinal":61274,"en":"Means this wretch is left in trouble!"},{"id":"manas-2010:p1418:b001:l003","ordinal":61275,"en":"Beijing, whose ridges are costly,"},{"id":"manas-2010:p1418:b001:l004","ordinal":61276,"en":"He called a journey of five days."},{"id":"manas-2010:p1418:b001:l005","ordinal":61277,"en":"My champion called himself mighty;"},{"id":"manas-2010:p1418:b001:l006","ordinal":61278,"en":"He called the people of Beijing lowly."},{"id":"manas-2010:p1418:b001:l007","ordinal":61279,"en":"If he stays in Beijing as khan,"},{"id":"manas-2010:p1418:b001:l008","ordinal":61280,"en":"Do not let them strike from a flanking way."},{"id":"manas-2010:p1418:b001:l009","ordinal":61281,"en":"If he keeps delighting in Beijing,"},{"id":"manas-2010:p1418:b001:l010","ordinal":61282,"en":"All his keen warriors"},{"id":"manas-2010:p1418:b001:l011","ordinal":61283,"en":"He will let the Chinese take as gifts!"},{"id":"manas-2010:p1418:b001:l012","ordinal":61284,"en":"What I have heard of Beijing—"},{"id":"manas-2010:p1418:b001:l013","ordinal":61285,"en":"Those who went there did not turn back;"},{"id":"manas-2010:p1418:b001:l014","ordinal":61286,"en":"Those who met it did not return safely!"},{"id":"manas-2010:p1418:b001:l015","ordinal":61287,"en":"If one pleaded and asked,"},{"id":"manas-2010:p1418:b001:l016","ordinal":61288,"en":"He who stays in Beijing would die."},{"id":"manas-2010:p1418:b001:l017","ordinal":61289,"en":"Consider it, hero Shuutu:"},{"id":"manas-2010:p1418:b001:l018","ordinal":61290,"en":"When would he see his child?"},{"id":"manas-2010:p1418:b001:l019","ordinal":61291,"en":"If he dies while staying in Beijing,"},{"id":"manas-2010:p1418:b001:l020","ordinal":61292,"en":"On the hills are blaze-faced horses;"},{"id":"manas-2010:p1418:b001:l021","ordinal":61293,"en":"A young son remains behind."},{"id":"manas-2010:p1418:b001:l022","ordinal":61294,"en":"There is no kinsman to lean upon;"},{"id":"manas-2010:p1418:b001:l023","ordinal":61295,"en":"All the relatives are enemies."},{"id":"manas-2010:p1418:b001:l024","ordinal":61296,"en":"In Talas, the Argyn and Nogoy are their own masters."},{"id":"manas-2010:p1418:b001:l025","ordinal":61297,"en":"If he dies in Beijing,"},{"id":"manas-2010:p1418:b001:l026","ordinal":61298,"en":"The tears in my eyes will never dry!”"},{"id":"manas-2010:p1418:b001:l027","ordinal":61299,"en":"That night, as Kanykey lay,"},{"id":"manas-2010:p1418:b001:l028","ordinal":61300,"en":"She saw something unimagined;"},{"id":"manas-2010:p1418:b001:l029","ordinal":61301,"en":"She dreamed a dreadful dream."},{"id":"manas-2010:p1418:b001:l030","ordinal":61302,"en":"Fire rose from Talas and burned;"},{"id":"manas-2010:p1418:b001:l031","ordinal":61303,"en":"All the ridges collapsed."},{"id":"manas-2010:p1418:b001:l032","ordinal":61304,"en":"The vast lake and river dried up;"},{"id":"manas-2010:p1418:b001:l033","ordinal":61305,"en":"The plane tree withered!"},{"id":"manas-2010:p1418:b001:l034","ordinal":61306,"en":"Startled awake from sleep,"},{"id":"manas-2010:p1418:b001:l035","ordinal":61307,"en":"She stood weeping and shrieking."},{"id":"manas-2010:p1418:b001:l036","ordinal":61308,"en":"Kanykey, the khan's daughter,"},{"id":"manas-2010:p1418:b001:l037","ordinal":61309,"en":"Stood sobbing and wailing."},{"id":"manas-2010:p1418:b001:l038","ordinal":61310,"en":"Her ribs torn with grief,"},{"id":"manas-2010:p1418:b001:l039","ordinal":61311,"en":"Tears pouring from her eyes,"},{"id":"manas-2010:p1418:b001:l040","ordinal":61312,"en":"Her heart grievously broken,"},{"id":"manas-2010:p1418:b001:l041","ordinal":61313,"en":"The broad world grown narrow,"},{"id":"manas-2010:p1418:b001:l042","ordinal":61314,"en":"That imposing Manas—"},{"id":"manas-2010:p1419:b001:l001","ordinal":61315,"en":"She longed to see him once."},{"id":"manas-2010:p1419:b001:l002","ordinal":61316,"en":"The reason for her longing:"},{"id":"manas-2010:p1419:b001:l003","ordinal":61317,"en":"When the Beijing campaign began,"},{"id":"manas-2010:p1419:b001:l004","ordinal":61318,"en":"After she had borne Semetey,"},{"id":"manas-2010:p1419:b001:l005","ordinal":61319,"en":"He departed ten days later."},{"id":"manas-2010:p1419:b001:l006","ordinal":61320,"en":"The joy of Manas's company,"},{"id":"manas-2010:p1419:b001:l007","ordinal":61321,"en":"Had she not been denied it?"},{"id":"manas-2010:p1419:b001:l008","ordinal":61322,"en":"Yearning for her lord,"},{"id":"manas-2010:p1419:b001:l009","ordinal":61323,"en":"Kanykey, embracing him—"},{"id":"manas-2010:p1419:b001:l010","ordinal":61324,"en":"Had she not been denied lying so?"},{"id":"manas-2010:p1419:b001:l011","ordinal":61325,"en":"“If he stays heedlessly in Beijing,"},{"id":"manas-2010:p1419:b001:l012","ordinal":61326,"en":"My champion may suddenly die."},{"id":"manas-2010:p1419:b001:l013","ordinal":61327,"en":"United with him when tiny,"},{"id":"manas-2010:p1419:b001:l014","ordinal":61328,"en":"Joined to him when thumb-sized,"},{"id":"manas-2010:p1419:b001:l015","ordinal":61329,"en":"When will he see this wretched woman?”"},{"id":"manas-2010:p1419:b001:l016","ordinal":61330,"en":"So Kanykey stood grieving."},{"id":"manas-2010:p1419:b001:l017","ordinal":61331,"en":"From dark eyes like blackcurrants,"},{"id":"manas-2010:p1419:b001:l018","ordinal":61332,"en":"Tears ran a whip's length;"},{"id":"manas-2010:p1419:b001:l019","ordinal":61333,"en":"From dark eyes like a saker falcon's,"},{"id":"manas-2010:p1419:b001:l020","ordinal":61334,"en":"Tears fell with every blink."},{"id":"manas-2010:p1419:b001:l021","ordinal":61335,"en":"Weeping, too weak to stand,"},{"id":"manas-2010:p1419:b001:l022","ordinal":61336,"en":"Unable to find a way,"},{"id":"manas-2010:p1419:b001:l023","ordinal":61337,"en":"To Shuutu with the felt-roof-sized hat"},{"id":"manas-2010:p1419:b001:l024","ordinal":61338,"en":"She gave six swift horses,"},{"id":"manas-2010:p1419:b001:l025","ordinal":61339,"en":"And a letter the size of her palm."},{"id":"manas-2010:p1419:b001:l026","ordinal":61340,"en":"Crying out her sorrow,"},{"id":"manas-2010:p1419:b001:l027","ordinal":61341,"en":"Sobbing, burning with grief—"},{"id":"manas-2010:p1419:b001:l028","ordinal":61342,"en":"Khan Saykal, daughter of Karacha Khan,"},{"id":"manas-2010:p1419:b001:l029","ordinal":61343,"en":"Had given Arbuudan as a gift."},{"id":"manas-2010:p1419:b001:l030","ordinal":61344,"en":"Sixty foals had been killed"},{"id":"manas-2010:p1419:b001:l031","ordinal":61345,"en":"To foster and rear Arbuudan."},{"id":"manas-2010:p1419:b001:l032","ordinal":61346,"en":"Owl feathers were fixed to his head;"},{"id":"manas-2010:p1419:b001:l033","ordinal":61347,"en":"He was allotted to Semetey"},{"id":"manas-2010:p1419:b001:l034","ordinal":61348,"en":"And tended by the forty companions."},{"id":"manas-2010:p1419:b001:l035","ordinal":61349,"en":"Taibuurul, who was with Manas,"},{"id":"manas-2010:p1419:b001:l036","ordinal":61350,"en":"Was reaching his fifth year,"},{"id":"manas-2010:p1419:b001:l037","ordinal":61351,"en":"Was fit to ride on campaign."},{"id":"manas-2010:p1419:b001:l038","ordinal":61352,"en":"Each of his limbs was exceptional;"},{"id":"manas-2010:p1419:b001:l039","ordinal":61353,"en":"He was unlike other beasts."},{"id":"manas-2010:p1419:b001:l040","ordinal":61354,"en":"Twisting his neck like a stag,"},{"id":"manas-2010:p1419:b001:l041","ordinal":61355,"en":"If a pit a target's distance wide appeared,"},{"id":"manas-2010:p1419:b001:l042","ordinal":61356,"en":"He bounded without hesitation."},{"id":"manas-2010:p1420:b001:l001","ordinal":61357,"en":"Hearing of his swiftness,"},{"id":"manas-2010:p1420:b001:l002","ordinal":61358,"en":"Offering gold by the pood and ornaments,"},{"id":"manas-2010:p1420:b001:l003","ordinal":61359,"en":"The khan of Bukhara had asked for him."},{"id":"manas-2010:p1420:b001:l004","ordinal":61360,"en":"They would not give him when asked."},{"id":"manas-2010:p1420:b001:l005","ordinal":61361,"en":"Far from giving Buurul away,"},{"id":"manas-2010:p1420:b001:l006","ordinal":61362,"en":"No one without ritual ablution rode him."},{"id":"manas-2010:p1420:b001:l007","ordinal":61363,"en":"Twisting his neck like a wild sheep,"},{"id":"manas-2010:p1420:b001:l008","ordinal":61364,"en":"If a pit a rope's length wide appeared,"},{"id":"manas-2010:p1420:b001:l009","ordinal":61365,"en":"He bounded unwaveringly."},{"id":"manas-2010:p1420:b001:l010","ordinal":61366,"en":"His neck curved like an apple,"},{"id":"manas-2010:p1420:b001:l011","ordinal":61367,"en":"If a cliff a lance's height appeared,"},{"id":"manas-2010:p1420:b001:l012","ordinal":61368,"en":"He sprang and bounded like a roe deer."},{"id":"manas-2010:p1420:b001:l013","ordinal":61369,"en":"A hardy Karabayyr warhorse,"},{"id":"manas-2010:p1420:b001:l014","ordinal":61370,"en":"Sieve-like lungs and copper forelegs,"},{"id":"manas-2010:p1420:b001:l015","ordinal":61371,"en":"No mother claimed to have borne him,"},{"id":"manas-2010:p1420:b001:l016","ordinal":61372,"en":"No stallion father had sired him;"},{"id":"manas-2010:p1420:b001:l017","ordinal":61373,"en":"A pure child of the unseen realm."},{"id":"manas-2010:p1420:b001:l018","ordinal":61374,"en":"Semetey, still a babe in the cradle,"},{"id":"manas-2010:p1420:b001:l019","ordinal":61375,"en":"She dressed in mail armor."},{"id":"manas-2010:p1420:b001:l020","ordinal":61376,"en":"As an auspicious rite, the tiny child"},{"id":"manas-2010:p1420:b001:l021","ordinal":61377,"en":"Semetey she mounted upon the horse."},{"id":"manas-2010:p1420:b001:l022","ordinal":61378,"en":"Gold ingots and rubies"},{"id":"manas-2010:p1420:b001:l023","ordinal":61379,"en":"She placed in his saddlebags."},{"id":"manas-2010:p1420:b001:l024","ordinal":61380,"en":"From his grandfather Jakyp,"},{"id":"manas-2010:p1420:b001:l025","ordinal":61381,"en":"To receive a pure blessing,"},{"id":"manas-2010:p1420:b001:l026","ordinal":61382,"en":"Leading Semetey,"},{"id":"manas-2010:p1420:b001:l027","ordinal":61383,"en":"Kanykey set out."},{"id":"manas-2010:p1420:b001:l028","ordinal":61384,"en":"At his grandfather Khan Jakyp's house,"},{"id":"manas-2010:p1420:b001:l029","ordinal":61385,"en":"Grain beer stood in a wooden tub."},{"id":"manas-2010:p1420:b001:l030","ordinal":61386,"en":"Within that grain beer,"},{"id":"manas-2010:p1420:b001:l031","ordinal":61387,"en":"Potent poison was mixed as well."},{"id":"manas-2010:p1420:b001:l032","ordinal":61388,"en":"At that moment Khan Jakyp—"},{"id":"manas-2010:p1420:b001:l033","ordinal":61389,"en":"“There is deceit in his eyes;"},{"id":"manas-2010:p1420:b001:l034","ordinal":61390,"en":"He means to trip me up."},{"id":"manas-2010:p1420:b001:l035","ordinal":61391,"en":"There is crookedness in his eyes,"},{"id":"manas-2010:p1420:b001:l036","ordinal":61392,"en":"There is guile in his words."},{"id":"manas-2010:p1420:b001:l037","ordinal":61393,"en":"If he can find a way, without mercy,"},{"id":"manas-2010:p1420:b001:l038","ordinal":61394,"en":"He means to act against me.”"},{"id":"manas-2010:p1420:b001:l039","ordinal":61395,"en":"Looking and speaking together,"},{"id":"manas-2010:p1420:b001:l040","ordinal":61396,"en":"His senior wife Bakdöölöt"},{"id":"manas-2010:p1420:b001:l041","ordinal":61397,"en":"And he consulted."},{"id":"manas-2010:p1420:b001:l042","ordinal":61398,"en":"“As a wife she ruined the people;"},{"id":"manas-2010:p1421:b001:l001","ordinal":61399,"en":"As a maiden, the hussy"},{"id":"manas-2010:p1421:b001:l002","ordinal":61400,"en":"Shook the age and wrecked the land."},{"id":"manas-2010:p1421:b001:l003","ordinal":61401,"en":"When that wretch was a maiden,"},{"id":"manas-2010:p1421:b001:l004","ordinal":61402,"en":"The world saw the trouble she caused."},{"id":"manas-2010:p1421:b001:l005","ordinal":61403,"en":"When Manas went to marry her,"},{"id":"manas-2010:p1421:b001:l006","ordinal":61404,"en":"With hungry steel, Manas's"},{"id":"manas-2010:p1421:b001:l007","ordinal":61405,"en":"Arm she pierced and wounded."},{"id":"manas-2010:p1421:b001:l008","ordinal":61406,"en":"A great quarrel that will never heal"},{"id":"manas-2010:p1421:b001:l009","ordinal":61407,"en":"She is coming to contrive."},{"id":"manas-2010:p1421:b001:l010","ordinal":61408,"en":"Her tiny wriggling creature"},{"id":"manas-2010:p1421:b001:l011","ordinal":61409,"en":"She has brought along, strapped on."},{"id":"manas-2010:p1421:b001:l012","ordinal":61410,"en":"Something from us"},{"id":"manas-2010:p1421:b001:l013","ordinal":61411,"en":"She is coming to ask.”"},{"id":"manas-2010:p1421:b001:l014","ordinal":61412,"en":"When Jakyp said this,"},{"id":"manas-2010:p1421:b001:l015","ordinal":61413,"en":"As though pierced in a gland,"},{"id":"manas-2010:p1421:b001:l016","ordinal":61414,"en":"Bakdöölöt started in alarm."},{"id":"manas-2010:p1421:b001:l017","ordinal":61415,"en":"“Wretched dried-up head, you will never prosper!"},{"id":"manas-2010:p1421:b001:l018","ordinal":61416,"en":"Always chattering away,"},{"id":"manas-2010:p1421:b001:l019","ordinal":61417,"en":"You will not stop your mischief!"},{"id":"manas-2010:p1421:b001:l020","ordinal":61418,"en":"If you go on like this, dried-up old man,"},{"id":"manas-2010:p1421:b001:l021","ordinal":61419,"en":"You will never prosper at all!"},{"id":"manas-2010:p1421:b001:l022","ordinal":61420,"en":"With your beard already white,"},{"id":"manas-2010:p1421:b001:l023","ordinal":61421,"en":"At the time when death is near,"},{"id":"manas-2010:p1421:b001:l024","ordinal":61422,"en":"You still cannot leave such words alone!"},{"id":"manas-2010:p1421:b001:l025","ordinal":61423,"en":"Your banner fastened to a lance,"},{"id":"manas-2010:p1421:b001:l026","ordinal":61424,"en":"If Semetey lives safely,"},{"id":"manas-2010:p1421:b001:l027","ordinal":61425,"en":"He is your gift born of magnanimous Manas."},{"id":"manas-2010:p1421:b001:l028","ordinal":61426,"en":"Your hoof born of a splendid steed,"},{"id":"manas-2010:p1421:b001:l029","ordinal":61427,"en":"From your goshawk son Manas,"},{"id":"manas-2010:p1421:b001:l030","ordinal":61428,"en":"Your only little darling born."},{"id":"manas-2010:p1421:b001:l031","ordinal":61429,"en":"They gathered like a fold."},{"id":"manas-2010:p1421:b001:l032","ordinal":61430,"en":"When infidels and Muslims"},{"id":"manas-2010:p1421:b001:l033","ordinal":61431,"en":"Stood facing one another,"},{"id":"manas-2010:p1421:b001:l034","ordinal":61432,"en":"He was your keen one conceived by a blessing."},{"id":"manas-2010:p1421:b001:l035","ordinal":61433,"en":"Consider it, you dried-up head!"},{"id":"manas-2010:p1421:b001:l036","ordinal":61434,"en":"While this Manas is alive,"},{"id":"manas-2010:p1421:b001:l037","ordinal":61435,"en":"There is no boat upon the dark water;"},{"id":"manas-2010:p1421:b001:l038","ordinal":61436,"en":"Among the people over all the earth,"},{"id":"manas-2010:p1421:b001:l039","ordinal":61437,"en":"There is none to defy you!"},{"id":"manas-2010:p1421:b001:l040","ordinal":61438,"en":"While your son Manas lives,"},{"id":"manas-2010:p1421:b001:l041","ordinal":61439,"en":"You have rinsed your mouth with honey;"},{"id":"manas-2010:p1421:b001:l042","ordinal":61440,"en":"You have become a great man."}]
