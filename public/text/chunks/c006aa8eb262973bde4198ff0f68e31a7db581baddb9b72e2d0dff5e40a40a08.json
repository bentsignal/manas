[{"id":"manas-2010:p1673:b001:l014","ordinal":71937,"en":"His two eyes became four with eagerness."},{"id":"manas-2010:p1673:b001:l015","ordinal":71938,"en":"“If the infidel falls into my hands,"},{"id":"manas-2010:p1673:b001:l016","ordinal":71939,"en":"Let me slaughter him as a sacrifice;"},{"id":"manas-2010:p1673:b001:l017","ordinal":71940,"en":"The black blood within him,"},{"id":"manas-2010:p1673:b001:l018","ordinal":71941,"en":"Let me swallow it by handfuls,” he said."},{"id":"manas-2010:p1673:b001:l019","ordinal":71942,"en":"With cotton belt and broad boots,"},{"id":"manas-2010:p1673:b001:l020","ordinal":71943,"en":"Kongurbay, khan of the monks—"},{"id":"manas-2010:p1673:b001:l021","ordinal":71944,"en":"As he was about to seize him by the hem,"},{"id":"manas-2010:p1673:b001:l022","ordinal":71945,"en":"About to lay him out lengthwise,"},{"id":"manas-2010:p1673:b001:l023","ordinal":71946,"en":"About to cut off his head like a sheep's,"},{"id":"manas-2010:p1673:b001:l024","ordinal":71947,"en":"About to split his belly like a melon,"},{"id":"manas-2010:p1673:b001:l025","ordinal":71948,"en":"Then Ajybay, Argynkan's son,"},{"id":"manas-2010:p1673:b001:l026","ordinal":71949,"en":"Shouted in his excitement,"},{"id":"manas-2010:p1673:b001:l027","ordinal":71950,"en":"Called out, “Alake!”"},{"id":"manas-2010:p1673:b001:l028","ordinal":71951,"en":"Rousing him, making him jerk,"},{"id":"manas-2010:p1673:b001:l029","ordinal":71952,"en":"Aziz Khan's champion,"},{"id":"manas-2010:p1673:b001:l030","ordinal":71953,"en":"Making him writhe like a bereaved wife,"},{"id":"manas-2010:p1673:b001:l031","ordinal":71954,"en":"He drew back and led away,"},{"id":"manas-2010:p1673:b001:l032","ordinal":71955,"en":"Kindling his extinguished fire,"},{"id":"manas-2010:p1673:b001:l033","ordinal":71956,"en":"Reviving his deadened life."},{"id":"manas-2010:p1673:b001:l034","ordinal":71957,"en":"The reason he did so:"},{"id":"manas-2010:p1673:b001:l035","ordinal":71958,"en":"Absorbed in chasing the grim-faced one,"},{"id":"manas-2010:p1673:b001:l036","ordinal":71959,"en":"Your dear lion Alma, blessed by Kydyr,"},{"id":"manas-2010:p1673:b001:l037","ordinal":71960,"en":"Had pursued him fiercely."},{"id":"manas-2010:p1673:b001:l038","ordinal":71961,"en":"To Beijing's deadly gate,"},{"id":"manas-2010:p1673:b001:l039","ordinal":71962,"en":"Your Alake had half a bowshot left;"},{"id":"manas-2010:p1673:b001:l040","ordinal":71963,"en":"To being seized and slaughtered by the Chinese,"},{"id":"manas-2010:p1673:b001:l041","ordinal":71964,"en":"Your Alake had drawn near."},{"id":"manas-2010:p1673:b001:l042","ordinal":71965,"en":"When he saw this peril,"},{"id":"manas-2010:p1674:b001:l001","ordinal":71966,"en":"Ajybay, Argynkan's son,"},{"id":"manas-2010:p1674:b001:l002","ordinal":71967,"en":"Made your Alake cry out and took him alongside."},{"id":"manas-2010:p1674:b001:l003","ordinal":71968,"en":"“Alake, they have a pit dug ready;"},{"id":"manas-2010:p1674:b001:l004","ordinal":71969,"en":"Pretending to flee, Kongurbay"},{"id":"manas-2010:p1674:b001:l005","ordinal":71970,"en":"Has misery waiting to boil for you."},{"id":"manas-2010:p1674:b001:l006","ordinal":71971,"en":"To strike with axes,"},{"id":"manas-2010:p1674:b001:l007","ordinal":71972,"en":"Look, he has many mighty men."},{"id":"manas-2010:p1674:b001:l008","ordinal":71973,"en":"Kongurbay's black horse,"},{"id":"manas-2010:p1674:b001:l009","ordinal":71974,"en":"His black horse did have"},{"id":"manas-2010:p1674:b001:l010","ordinal":71975,"en":"Wings upon its flanks."},{"id":"manas-2010:p1674:b001:l011","ordinal":71976,"en":"The eye cannot follow its movement;"},{"id":"manas-2010:p1674:b001:l012","ordinal":71977,"en":"Except a flying crow,"},{"id":"manas-2010:p1674:b001:l013","ordinal":71978,"en":"No other living thing can match it."},{"id":"manas-2010:p1674:b001:l014","ordinal":71979,"en":"Kongurbay, khan of the monks,"},{"id":"manas-2010:p1674:b001:l015","ordinal":71980,"en":"You cannot overpower him even grappling close."},{"id":"manas-2010:p1674:b001:l016","ordinal":71981,"en":"If you keep pursuing, striving to match him,"},{"id":"manas-2010:p1674:b001:l017","ordinal":71982,"en":"Anger is a devil, wisdom a friend;"},{"id":"manas-2010:p1674:b001:l018","ordinal":71983,"en":"Alöökö's Kongurbay,"},{"id":"manas-2010:p1674:b001:l019","ordinal":71984,"en":"Will he not capture you alive?"},{"id":"manas-2010:p1674:b001:l020","ordinal":71985,"en":"Gouging out both your eyes,"},{"id":"manas-2010:p1674:b001:l021","ordinal":71986,"en":"Will he not inflict this torment,"},{"id":"manas-2010:p1674:b001:l022","ordinal":71987,"en":"Take his boundless vengeance,"},{"id":"manas-2010:p1674:b001:l023","ordinal":71988,"en":"Bring such calamity upon you?"},{"id":"manas-2010:p1674:b001:l024","ordinal":71989,"en":"Your heroes Syrgak and Chubak are absent."},{"id":"manas-2010:p1674:b001:l025","ordinal":71990,"en":"Alake, with the deeply rooted infidels,"},{"id":"manas-2010:p1674:b001:l026","ordinal":71991,"en":"Do not vie without good cause."},{"id":"manas-2010:p1674:b001:l027","ordinal":71992,"en":"You have no support to rely on;"},{"id":"manas-2010:p1674:b001:l028","ordinal":71993,"en":"To bind your wounded waist,"},{"id":"manas-2010:p1674:b001:l029","ordinal":71994,"en":"Your champion, your lion Syrgak is absent."},{"id":"manas-2010:p1674:b001:l030","ordinal":71995,"en":"Of all you look to, you stand utterly alone;"},{"id":"manas-2010:p1674:b001:l031","ordinal":71996,"en":"There is no one else for you to turn to."},{"id":"manas-2010:p1674:b001:l032","ordinal":71997,"en":"Do not plunge in without good cause!”"},{"id":"manas-2010:p1674:b001:l033","ordinal":71998,"en":"Giving much courageous counsel,"},{"id":"manas-2010:p1674:b001:l034","ordinal":71999,"en":"Calling him “My leopard Almam,”"},{"id":"manas-2010:p1674:b001:l035","ordinal":72000,"en":"Your Alma, like Kambar,"},{"id":"manas-2010:p1674:b001:l036","ordinal":72001,"en":"He turned and led away."},{"id":"manas-2010:p1674:b001:l037","ordinal":72002,"en":"The seething, mighty host,"},{"id":"manas-2010:p1674:b001:l038","ordinal":72003,"en":"The costly road lay dug out;"},{"id":"manas-2010:p1674:b001:l039","ordinal":72004,"en":"With Khan Kojozhash at their head,"},{"id":"manas-2010:p1674:b001:l040","ordinal":72005,"en":"Almambet and my Ajy,"},{"id":"manas-2010:p1674:b001:l041","ordinal":72006,"en":"They swarmed upon them on that road!"},{"id":"manas-2010:p1674:b001:l042","ordinal":72007,"en":"The countless Chinese, Kojozhash,"},{"id":"manas-2010:p1675:b001:l001","ordinal":72008,"en":"Brought calamity upon their heads."},{"id":"manas-2010:p1675:b001:l002","ordinal":72009,"en":"In the desert of It-Ölbös,"},{"id":"manas-2010:p1675:b001:l003","ordinal":72010,"en":"Azizkan's only son,"},{"id":"manas-2010:p1675:b001:l004","ordinal":72011,"en":"Good heavens, they surrounded him."},{"id":"manas-2010:p1675:b001:l005","ordinal":72012,"en":"There was no crag a goose could not circle;"},{"id":"manas-2010:p1675:b001:l006","ordinal":72013,"en":"To stand beside him as support,"},{"id":"manas-2010:p1675:b001:l007","ordinal":72014,"en":"There was no mountain, the leopard Manas."},{"id":"manas-2010:p1675:b001:l008","ordinal":72015,"en":"He had no support to rely on;"},{"id":"manas-2010:p1675:b001:l009","ordinal":72016,"en":"In the slaughter he faced,"},{"id":"manas-2010:p1675:b001:l010","ordinal":72017,"en":"Not one of his champions was there."},{"id":"manas-2010:p1675:b001:l011","ordinal":72018,"en":"Do not ask about the great campaign;"},{"id":"manas-2010:p1675:b001:l012","ordinal":72019,"en":"The slaughtered people were beyond counting."},{"id":"manas-2010:p1675:b001:l013","ordinal":72020,"en":"To shout and stand by him,"},{"id":"manas-2010:p1675:b001:l014","ordinal":72021,"en":"His precious Syrgak was not here."},{"id":"manas-2010:p1675:b001:l015","ordinal":72022,"en":"Who had stirred the stars in the sky,"},{"id":"manas-2010:p1675:b001:l016","ordinal":72023,"en":"Who had sworn friendship into the next world,"},{"id":"manas-2010:p1675:b001:l017","ordinal":72024,"en":"His devastating hero Chubak was absent;"},{"id":"manas-2010:p1675:b001:l018","ordinal":72025,"en":"To rise towering and fire,"},{"id":"manas-2010:p1675:b001:l019","ordinal":72026,"en":"His devastating lion Manas was absent!"},{"id":"manas-2010:p1675:b001:l020","ordinal":72027,"en":"Finding no mountain for a crow to circle,"},{"id":"manas-2010:p1675:b001:l021","ordinal":72028,"en":"To stand by him as support,"},{"id":"manas-2010:p1675:b001:l022","ordinal":72029,"en":"Finding no honored sultan, no hero,"},{"id":"manas-2010:p1675:b001:l023","ordinal":72030,"en":"Without counting the hours of the day,"},{"id":"manas-2010:p1675:b001:l024","ordinal":72031,"en":"Without taking rest by day,"},{"id":"manas-2010:p1675:b001:l025","ordinal":72032,"en":"Fighting day and night,"},{"id":"manas-2010:p1675:b001:l026","ordinal":72033,"en":"He could find no peace for his life."},{"id":"manas-2010:p1675:b001:l027","ordinal":72034,"en":"After seven days of fighting through,"},{"id":"manas-2010:p1675:b001:l028","ordinal":72035,"en":"Wounded in seventy places,"},{"id":"manas-2010:p1675:b001:l029","ordinal":72036,"en":"He had fled away."},{"id":"manas-2010:p1675:b001:l030","ordinal":72037,"en":"Argynkan's unfortunate son,"},{"id":"manas-2010:p1675:b001:l031","ordinal":72038,"en":"Fought on alone;"},{"id":"manas-2010:p1675:b001:l032","ordinal":72039,"en":"Azizkan's young hawk,"},{"id":"manas-2010:p1675:b001:l033","ordinal":72040,"en":"Fortunate when he entered a firefight,"},{"id":"manas-2010:p1675:b001:l034","ordinal":72041,"en":"The noble one's desire was not sated."},{"id":"manas-2010:p1675:b001:l035","ordinal":72042,"en":"Making Sarala prance,"},{"id":"manas-2010:p1675:b001:l036","ordinal":72043,"en":"Making whoever he met crawl,"},{"id":"manas-2010:p1675:b001:l037","ordinal":72044,"en":"Smashing seven thousand of them,"},{"id":"manas-2010:p1675:b001:l038","ordinal":72045,"en":"Thrusting his spear wherever he reached,"},{"id":"manas-2010:p1675:b001:l039","ordinal":72046,"en":"“That consummate Kojozhash,"},{"id":"manas-2010:p1675:b001:l040","ordinal":72047,"en":"Where is that swine?” he cried."},{"id":"manas-2010:p1675:b001:l041","ordinal":72048,"en":"Bloody battle, a great field of war—"},{"id":"manas-2010:p1675:b001:l042","ordinal":72049,"en":"Blood flowed through the broad ravine!"},{"id":"manas-2010:p1676:b001:l001","ordinal":72050,"en":"Running on, leaning without rest,"},{"id":"manas-2010:p1676:b001:l002","ordinal":72051,"en":"His flesh had grown heated;"},{"id":"manas-2010:p1676:b001:l003","ordinal":72052,"en":"His dear head, like a feedbag,"},{"id":"manas-2010:p1676:b001:l004","ordinal":72053,"en":"Was drenched in pitch-dark blood."},{"id":"manas-2010:p1676:b001:l005","ordinal":72054,"en":"Looking neither up nor down,"},{"id":"manas-2010:p1676:b001:l006","ordinal":72055,"en":"Khan Aziz's only son"},{"id":"manas-2010:p1676:b001:l007","ordinal":72056,"en":"Never thought, “I shall die.”"},{"id":"manas-2010:p1676:b001:l008","ordinal":72057,"en":"Without looking around,"},{"id":"manas-2010:p1676:b001:l009","ordinal":72058,"en":"“A bullet may strike me,"},{"id":"manas-2010:p1676:b001:l010","ordinal":72059,"en":"My appointed death may come like this”—"},{"id":"manas-2010:p1676:b001:l011","ordinal":72060,"en":"He felt no such fear of the Chinese."},{"id":"manas-2010:p1676:b001:l012","ordinal":72061,"en":"Kongurbay pressed fiercely in,"},{"id":"manas-2010:p1676:b001:l013","ordinal":72062,"en":"With Ay Zhang-Zhung leading the elders."},{"id":"manas-2010:p1676:b001:l014","ordinal":72063,"en":"Tormenting and smashing"},{"id":"manas-2010:p1676:b001:l015","ordinal":72064,"en":"All those who came,"},{"id":"manas-2010:p1676:b001:l016","ordinal":72065,"en":"Draining the Chinese of strength,"},{"id":"manas-2010:p1676:b001:l017","ordinal":72066,"en":"The reason he kept fighting:"},{"id":"manas-2010:p1676:b001:l018","ordinal":72067,"en":"Dear Alma, the heroes' support,"},{"id":"manas-2010:p1676:b001:l019","ordinal":72068,"en":"Would not count them worth his boot-leg,"},{"id":"manas-2010:p1676:b001:l020","ordinal":72069,"en":"Except Kojozhash alone."},{"id":"manas-2010:p1676:b001:l021","ordinal":72070,"en":"The reason he held them so low:"},{"id":"manas-2010:p1676:b001:l022","ordinal":72071,"en":"Sarala with cowlike lean haunches,"},{"id":"manas-2010:p1676:b001:l023","ordinal":72072,"en":"Had he not saddled him and gone?"},{"id":"manas-2010:p1676:b001:l024","ordinal":72073,"en":"Before the dragon,"},{"id":"manas-2010:p1676:b001:l025","ordinal":72074,"en":"The secret lore of shooting,"},{"id":"manas-2010:p1676:b001:l026","ordinal":72075,"en":"Had dear Alma not studied it?"},{"id":"manas-2010:p1676:b001:l027","ordinal":72076,"en":"Against his skin, a fine white shirt,"},{"id":"manas-2010:p1676:b001:l028","ordinal":72077,"en":"Had dear Alma not put it on?"},{"id":"manas-2010:p1676:b001:l029","ordinal":72078,"en":"The stratagems of battle,"},{"id":"manas-2010:p1676:b001:l030","ordinal":72079,"en":"Had he not learned them from the Chinese?"},{"id":"manas-2010:p1676:b001:l031","ordinal":72080,"en":"The forked ridge and mountain pass,"},{"id":"manas-2010:p1676:b001:l032","ordinal":72081,"en":"Your Alma never feared to cross;"},{"id":"manas-2010:p1676:b001:l033","ordinal":72082,"en":"His gold and golden coins,"},{"id":"manas-2010:p1676:b001:l034","ordinal":72083,"en":"Your Alma never feared to scatter."},{"id":"manas-2010:p1676:b001:l035","ordinal":72084,"en":"The Kara-Kytay and Manzhuu,"},{"id":"manas-2010:p1676:b001:l036","ordinal":72085,"en":"Would your Alma fear to drive them?"},{"id":"manas-2010:p1676:b001:l037","ordinal":72086,"en":"If Kongurbay fell into his hands,"},{"id":"manas-2010:p1676:b001:l038","ordinal":72087,"en":"Would your Alma fear to slay him?"},{"id":"manas-2010:p1676:b001:l039","ordinal":72088,"en":"The Chinese multitude was beyond counting;"},{"id":"manas-2010:p1676:b001:l040","ordinal":72089,"en":"They had gone without looking back,"},{"id":"manas-2010:p1676:b001:l041","ordinal":72090,"en":"The forty valiant companions were not here!"},{"id":"manas-2010:p1676:b001:l042","ordinal":72091,"en":"The red lance and Zulpuqor"},{"id":"manas-2010:p1677:b001:l001","ordinal":72092,"en":"Your lion Alma wielded with precision."},{"id":"manas-2010:p1677:b001:l002","ordinal":72093,"en":"In that crushing, slaughterous campaign,"},{"id":"manas-2010:p1677:b001:l003","ordinal":72094,"en":"Your lion Alma endured."},{"id":"manas-2010:p1677:b001:l004","ordinal":72095,"en":"In the unbelievers' iron-stretched"},{"id":"manas-2010:p1677:b001:l005","ordinal":72096,"en":"Net your lion Alma remained;"},{"id":"manas-2010:p1677:b001:l006","ordinal":72097,"en":"In the black Kalmyk and Shibee"},{"id":"manas-2010:p1677:b001:l007","ordinal":72098,"en":"Army your lion Alma remained."},{"id":"manas-2010:p1677:b001:l008","ordinal":72099,"en":"There was no day and no night for him,"},{"id":"manas-2010:p1677:b001:l009","ordinal":72100,"en":"He took no time to rest."},{"id":"manas-2010:p1677:b001:l010","ordinal":72101,"en":"Azizkhan's morning star,"},{"id":"manas-2010:p1677:b001:l011","ordinal":72102,"en":"Alas, even in death there was no regret."},{"id":"manas-2010:p1677:b001:l012","ordinal":72103,"en":"In the desert of It-Ölbös,"},{"id":"manas-2010:p1677:b001:l013","ordinal":72104,"en":"Thundering Kün Zhang-Zhung,"},{"id":"manas-2010:p1677:b001:l014","ordinal":72105,"en":"As he pressed to raise a slaughter,"},{"id":"manas-2010:p1677:b001:l015","ordinal":72106,"en":"Azizkhan's Almambet,"},{"id":"manas-2010:p1677:b001:l016","ordinal":72107,"en":"Your resourceful hero, arrived."},{"id":"manas-2010:p1677:b001:l017","ordinal":72108,"en":"Zhang-Zhung, huge as a barrel,"},{"id":"manas-2010:p1677:b001:l018","ordinal":72109,"en":"From his gray rhinoceros,"},{"id":"manas-2010:p1677:b001:l019","ordinal":72110,"en":"The immeasurable dear lion"},{"id":"manas-2010:p1677:b001:l020","ordinal":72111,"en":"Thrust down as he passed."},{"id":"manas-2010:p1677:b001:l021","ordinal":72112,"en":"Dear Alma's hungry steel blade,"},{"id":"manas-2010:p1677:b001:l022","ordinal":72113,"en":"When eagerly drawn from its sheath,"},{"id":"manas-2010:p1677:b001:l023","ordinal":72114,"en":"Would not return without drinking blood,"},{"id":"manas-2010:p1677:b001:l024","ordinal":72115,"en":"Never swung and came back empty,"},{"id":"manas-2010:p1677:b001:l025","ordinal":72116,"en":"Never struck stone without splitting it."},{"id":"manas-2010:p1677:b001:l026","ordinal":72117,"en":"Taking Oykuma in his hand,"},{"id":"manas-2010:p1677:b001:l027","ordinal":72118,"en":"At that moment, to the Manzhuu,"},{"id":"manas-2010:p1677:b001:l028","ordinal":72119,"en":"Your devastating Alma arrived."},{"id":"manas-2010:p1677:b001:l029","ordinal":72120,"en":"As soon as he reached Zhang-Zhung,"},{"id":"manas-2010:p1677:b001:l030","ordinal":72121,"en":"He cut him into twelve pieces."},{"id":"manas-2010:p1677:b001:l031","ordinal":72122,"en":"When Kün Zhang-Zhung had died,"},{"id":"manas-2010:p1677:b001:l032","ordinal":72123,"en":"Alöökö's Kongurbay,"},{"id":"manas-2010:p1677:b001:l033","ordinal":72124,"en":"Finding himself alone,"},{"id":"manas-2010:p1677:b001:l034","ordinal":72125,"en":"Shouted in fury"},{"id":"manas-2010:p1677:b001:l035","ordinal":72126,"en":"And called Kojozhash."},{"id":"manas-2010:p1677:b001:l036","ordinal":72127,"en":"“My support that I relied upon—"},{"id":"manas-2010:p1677:b001:l037","ordinal":72128,"en":"Look well, Kojozhash!"},{"id":"manas-2010:p1677:b001:l038","ordinal":72129,"en":"This fugitive has slaughtered"},{"id":"manas-2010:p1677:b001:l039","ordinal":72130,"en":"My stately lion."},{"id":"manas-2010:p1677:b001:l040","ordinal":72131,"en":"He has dug me a deep trench,"},{"id":"manas-2010:p1677:b001:l041","ordinal":72132,"en":"He has boiled up so much misery for me;"},{"id":"manas-2010:p1677:b001:l042","ordinal":72133,"en":"He has slaughtered, do you see,"},{"id":"manas-2010:p1678:b001:l001","ordinal":72134,"en":"So many of my mighty Chinese."},{"id":"manas-2010:p1678:b001:l002","ordinal":72135,"en":"Dust rose wherever he moved,"},{"id":"manas-2010:p1678:b001:l003","ordinal":72136,"en":"His voice drove life from men;"},{"id":"manas-2010:p1678:b001:l004","ordinal":72137,"en":"He woke me wide awake,"},{"id":"manas-2010:p1678:b001:l005","ordinal":72138,"en":"He has reduced my people to rags!"},{"id":"manas-2010:p1678:b001:l006","ordinal":72139,"en":"Unless you take aim at Almambet,"},{"id":"manas-2010:p1678:b001:l007","ordinal":72140,"en":"The emperor's Beijing,"},{"id":"manas-2010:p1678:b001:l008","ordinal":72141,"en":"The Chinese, made to howl—"},{"id":"manas-2010:p1678:b001:l009","ordinal":72142,"en":"Riding his Sarala,"},{"id":"manas-2010:p1678:b001:l010","ordinal":72143,"en":"As a tale for his people,"},{"id":"manas-2010:p1678:b001:l011","ordinal":72144,"en":"He will drive them in their multitudes home."},{"id":"manas-2010:p1678:b001:l012","ordinal":72145,"en":"May God strike this fugitive wretch!"},{"id":"manas-2010:p1678:b001:l013","ordinal":72146,"en":"The emperor's Beijing,"},{"id":"manas-2010:p1678:b001:l014","ordinal":72147,"en":"If this fugitive grows angry,"},{"id":"manas-2010:p1678:b001:l015","ordinal":72148,"en":"He will drive and slaughter it;"},{"id":"manas-2010:p1678:b001:l016","ordinal":72149,"en":"He will wreak devastation upon it all."},{"id":"manas-2010:p1678:b001:l017","ordinal":72150,"en":"See this fugitive's measure:"},{"id":"manas-2010:p1678:b001:l018","ordinal":72151,"en":"He survives where death does not take him;"},{"id":"manas-2010:p1678:b001:l019","ordinal":72152,"en":"Managing somehow, with trickery,"},{"id":"manas-2010:p1678:b001:l020","ordinal":72153,"en":"He will take so many heads!”"},{"id":"manas-2010:p1678:b001:l021","ordinal":72154,"en":"Before he could close his mouth,"},{"id":"manas-2010:p1678:b001:l022","ordinal":72155,"en":"Six thousand Chinese and countless governors"},{"id":"manas-2010:p1678:b001:l023","ordinal":72156,"en":"He plunged among and attacked—"},{"id":"manas-2010:p1678:b001:l024","ordinal":72157,"en":"What a hero was dear Alma!"},{"id":"manas-2010:p1678:b001:l025","ordinal":72158,"en":"The steed Sarala beneath him,"},{"id":"manas-2010:p1678:b001:l026","ordinal":72159,"en":"On the plain called It-Ölbös,"},{"id":"manas-2010:p1678:b001:l027","ordinal":72160,"en":"Cotton sash and wide boots,"},{"id":"manas-2010:p1678:b001:l028","ordinal":72161,"en":"Kongurbay, khan of the monks,"},{"id":"manas-2010:p1678:b001:l029","ordinal":72162,"en":"Was reached faster than an arrow."},{"id":"manas-2010:p1678:b001:l030","ordinal":72163,"en":"Your perfect goshawk, lion Alma,"},{"id":"manas-2010:p1678:b001:l031","ordinal":72164,"en":"From Algara's back"},{"id":"manas-2010:p1678:b001:l032","ordinal":72165,"en":"The lion-like Fierce One"},{"id":"manas-2010:p1678:b001:l033","ordinal":72166,"en":"Thrust down as he passed."},{"id":"manas-2010:p1678:b001:l034","ordinal":72167,"en":"When the Fierce One fell from his horse,"},{"id":"manas-2010:p1678:b001:l035","ordinal":72168,"en":"Six thousand governors and countless Chinese"},{"id":"manas-2010:p1678:b001:l036","ordinal":72169,"en":"Attacked together."},{"id":"manas-2010:p1678:b001:l037","ordinal":72170,"en":"When the Chinese swarmed,"},{"id":"manas-2010:p1678:b001:l038","ordinal":72171,"en":"Their bow-drawing spearmen"},{"id":"manas-2010:p1678:b001:l039","ordinal":72172,"en":"All arrived together."},{"id":"manas-2010:p1678:b001:l040","ordinal":72173,"en":"Your devastating lion Alma"},{"id":"manas-2010:p1678:b001:l041","ordinal":72174,"en":"They enclosed in their midst."},{"id":"manas-2010:p1678:b001:l042","ordinal":72175,"en":"His poor life came under strain;"},{"id":"manas-2010:p1679:b001:l001","ordinal":72176,"en":"Lances broke and bent."},{"id":"manas-2010:p1679:b001:l002","ordinal":72177,"en":"Perish, world, with your day of taking life!"},{"id":"manas-2010:p1679:b001:l003","ordinal":72178,"en":"His life held in trust came under strain."},{"id":"manas-2010:p1679:b001:l004","ordinal":72179,"en":"For sixty days he fought among them;"},{"id":"manas-2010:p1679:b001:l005","ordinal":72180,"en":"Your noble one broke free,"},{"id":"manas-2010:p1679:b001:l006","ordinal":72181,"en":"Wounded in sixty places."},{"id":"manas-2010:p1679:b001:l007","ordinal":72182,"en":"For seventy days he fought among them;"},{"id":"manas-2010:p1679:b001:l008","ordinal":72183,"en":"Dear Alma broke free,"},{"id":"manas-2010:p1679:b001:l009","ordinal":72184,"en":"Wounded in seventy places."},{"id":"manas-2010:p1679:b001:l010","ordinal":72185,"en":"When your Alma escaped,"},{"id":"manas-2010:p1679:b001:l011","ordinal":72186,"en":"See the hail, see the embers,"},{"id":"manas-2010:p1679:b001:l012","ordinal":72187,"en":"See the shots striking separately!"},{"id":"manas-2010:p1679:b001:l013","ordinal":72188,"en":"See the rain, see the downpour,"},{"id":"manas-2010:p1679:b001:l014","ordinal":72189,"en":"See the shots striking all together!"},{"id":"manas-2010:p1679:b001:l015","ordinal":72190,"en":"Crying “Zhang-Zhung!” as their battle cry,"},{"id":"manas-2010:p1679:b001:l016","ordinal":72191,"en":"See the Chinese army swarming!"},{"id":"manas-2010:p1679:b001:l017","ordinal":72192,"en":"See the mighty Kojozhash!"}]
