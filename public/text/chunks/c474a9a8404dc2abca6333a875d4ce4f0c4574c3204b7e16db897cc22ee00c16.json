[{"id":"semetey-1-2013:p0817:b005:l038","ordinal":139521,"en":"The youngest of nine sons,"},{"id":"semetey-1-2013:p0817:b005:l039","ordinal":139522,"en":"A servant of the one God,"},{"id":"semetey-1-2013:p0817:b005:l040","ordinal":139523,"en":"The champion among many mighty men—"},{"id":"semetey-1-2013:p0818:b003:l001","ordinal":139524,"en":"Eleman's hero Toshtuk—"},{"id":"semetey-1-2013:p0818:b003:l002","ordinal":139525,"en":"Since he had gone beneath the earth,"},{"id":"semetey-1-2013:p0818:b003:l003","ordinal":139526,"en":"Seven years had passed."},{"id":"semetey-1-2013:p0818:b003:l004","ordinal":139527,"en":"Since he had returned above the earth,"},{"id":"semetey-1-2013:p0818:b003:l005","ordinal":139528,"en":"Forty-seven days had passed."},{"id":"semetey-1-2013:p0818:b003:l006","ordinal":139529,"en":"From Eleman's countless herds,"},{"id":"semetey-1-2013:p0818:b003:l007","ordinal":139530,"en":"Nine hundred barren mares were slaughtered."},{"id":"semetey-1-2013:p0818:b003:l008","ordinal":139531,"en":"The people gathered for festivities,"},{"id":"semetey-1-2013:p0818:b003:l009","ordinal":139532,"en":"And wise old Koshoi was there."},{"id":"semetey-1-2013:p0818:b003:l010","ordinal":139533,"en":"The precious warrior Manas was absent;"},{"id":"semetey-1-2013:p0818:b003:l011","ordinal":139534,"en":"All the other mighty heroes were there:"},{"id":"semetey-1-2013:p0818:b003:l012","ordinal":139535,"en":"Zhamgyrchy from the Eshteks,"},{"id":"semetey-1-2013:p0818:b003:l013","ordinal":139536,"en":"Khan Kokcho from the Kazakhs,"},{"id":"semetey-1-2013:p0818:b003:l014","ordinal":139537,"en":"Muzburchak, son of Buudaiyk—"},{"id":"semetey-1-2013:p0818:b003:l015","ordinal":139538,"en":"Which of them shall we name?"},{"id":"semetey-1-2013:p0818:b003:l016","ordinal":139539,"en":"The multitude, the people were there,"},{"id":"semetey-1-2013:p0818:b003:l017","ordinal":139540,"en":"The heroes of every nation were there,"},{"id":"semetey-1-2013:p0818:b003:l018","ordinal":139541,"en":"All the Muslim people were there then."},{"id":"semetey-1-2013:p0818:b003:l019","ordinal":139542,"en":"Skilled lancers were there,"},{"id":"semetey-1-2013:p0818:b003:l020","ordinal":139543,"en":"And worthy men of full resource."},{"id":"semetey-1-2013:p0818:b003:l021","ordinal":139544,"en":"Just and worthy khans were there;"},{"id":"semetey-1-2013:p0818:b003:l022","ordinal":139545,"en":"All the people were there."},{"id":"semetey-1-2013:p0818:b003:l023","ordinal":139546,"en":"The Zhediger's hero Bagysh,"},{"id":"semetey-1-2013:p0818:b003:l024","ordinal":139547,"en":"Who is Toltoy's father—"},{"id":"semetey-1-2013:p0818:b003:l025","ordinal":139548,"en":"All those men"},{"id":"semetey-1-2013:p0818:b003:l026","ordinal":139549,"en":"Blessed the betrothal to Chachykei."},{"id":"semetey-1-2013:p0818:b003:l027","ordinal":139550,"en":"Driving livestock to seal the marriage bond,"},{"id":"semetey-1-2013:p0818:b003:l028","ordinal":139551,"en":"At that feast of Toshtuk,"},{"id":"semetey-1-2013:p0818:b003:l029","ordinal":139552,"en":"You bowed in thanks, chewing fat."},{"id":"semetey-1-2013:p0818:b003:l030","ordinal":139553,"en":"Driving six hundred piebald beasts,"},{"id":"semetey-1-2013:p0818:b003:l031","ordinal":139554,"en":"Turning the hearts of those who saw,"},{"id":"semetey-1-2013:p0818:b003:l032","ordinal":139555,"en":"A white-gray horse as large as a hut,"},{"id":"semetey-1-2013:p0818:b003:l033","ordinal":139556,"en":"Upon that horse's forelock"},{"id":"semetey-1-2013:p0818:b003:l034","ordinal":139557,"en":"A bowl-sized silk ornament was displayed."},{"id":"semetey-1-2013:p0818:b003:l035","ordinal":139558,"en":"‘May your marriage alliance be blessed,’"},{"id":"semetey-1-2013:p0818:b003:l036","ordinal":139559,"en":"Said old Koshoi, spreading his palms."},{"id":"semetey-1-2013:p0818:b003:l037","ordinal":139560,"en":"To the bearded men and elders,"},{"id":"semetey-1-2013:p0818:b003:l038","ordinal":139561,"en":"The matter was well known."},{"id":"semetey-1-2013:p0818:b003:l039","ordinal":139562,"en":"Toltoy, the son of Bagysh,"},{"id":"semetey-1-2013:p0818:b003:l040","ordinal":139563,"en":"Has her as his promised bride."},{"id":"semetey-1-2013:p0818:b004:l001","ordinal":139564,"en":"He has a grave claim already sealed."},{"id":"semetey-1-2013:p0818:b004:l002","ordinal":139565,"en":"He too is of Kyrgyz lineage,"},{"id":"semetey-1-2013:p0818:b004:l003","ordinal":139566,"en":"This one too is of Kyrgyz lineage,"},{"id":"semetey-1-2013:p0818:b004:l004","ordinal":139567,"en":"And both have enemies to confront."},{"id":"semetey-1-2013:p0818:b004:l005","ordinal":139568,"en":"‘He took Chachykei away,’ they will say;"},{"id":"semetey-1-2013:p0818:b004:l006","ordinal":139569,"en":"The Zhediger people will have a claim against Semetey."},{"id":"semetey-1-2013:p0818:b004:l007","ordinal":139570,"en":"She has a betrothed in a known place;"},{"id":"semetey-1-2013:p0818:b004:l008","ordinal":139571,"en":"There is talk of endless turmoil."},{"id":"semetey-1-2013:p0818:b004:l009","ordinal":139572,"en":"I do not begrudge my daughter,"},{"id":"semetey-1-2013:p0818:b004:l010","ordinal":139573,"en":"But this could bring us to destruction."},{"id":"semetey-1-2013:p0818:b004:l011","ordinal":139574,"en":"When we give this Chachykei,"},{"id":"semetey-1-2013:p0818:b004:l012","ordinal":139575,"en":"If the great mass of Zhediger"},{"id":"semetey-1-2013:p0818:b004:l013","ordinal":139576,"en":"Surges down upon us with battle cries,"},{"id":"semetey-1-2013:p0818:b004:l014","ordinal":139577,"en":"What shall we be able to do?"},{"id":"semetey-1-2013:p0818:b004:l015","ordinal":139578,"en":"How shall our encampment remain settled?"},{"id":"semetey-1-2013:p0818:b004:l016","ordinal":139579,"en":"This wretched matter has its conditions:"},{"id":"semetey-1-2013:p0818:b004:l017","ordinal":139580,"en":"Toltoy of the Zhediger"},{"id":"semetey-1-2013:p0818:b004:l018","ordinal":139581,"en":"Has an oath of betrothal."},{"id":"semetey-1-2013:p0818:b004:l019","ordinal":139582,"en":"We have needlessly fallen into torment;"},{"id":"semetey-1-2013:p0818:b004:l020","ordinal":139583,"en":"How are we to escape his oath?’"},{"id":"semetey-1-2013:p0818:b004:l021","ordinal":139584,"en":"While Shaatemir was saying this,"},{"id":"semetey-1-2013:p0818:b004:l022","ordinal":139585,"en":"Temir Khan grew wrathful,"},{"id":"semetey-1-2013:p0818:b004:l023","ordinal":139586,"en":"And now his fury seized him."},{"id":"semetey-1-2013:p0818:b004:l024","ordinal":139587,"en":"The people watching"},{"id":"semetey-1-2013:p0818:b004:l025","ordinal":139588,"en":"Had not the slightest strength remaining."},{"id":"semetey-1-2013:p0818:b004:l026","ordinal":139589,"en":"‘Your father's grave, you Bukharans!"},{"id":"semetey-1-2013:p0818:b004:l027","ordinal":139590,"en":"Your elders with beards white as swans—"},{"id":"semetey-1-2013:p0818:b004:l028","ordinal":139591,"en":"I shall utterly slaughter all of you."},{"id":"semetey-1-2013:p0818:b004:l029","ordinal":139592,"en":"I shall dig your pit deep,"},{"id":"semetey-1-2013:p0818:b004:l030","ordinal":139593,"en":"And boil up your misery."},{"id":"semetey-1-2013:p0818:b004:l031","ordinal":139594,"en":"Before your very eyes,"},{"id":"semetey-1-2013:p0818:b004:l032","ordinal":139595,"en":"I shall show marvels no people have seen!"},{"id":"semetey-1-2013:p0818:b004:l033","ordinal":139596,"en":"Over this Bukhara here,"},{"id":"semetey-1-2013:p0818:b004:l034","ordinal":139597,"en":"My seven forefathers were khans,"},{"id":"semetey-1-2013:p0818:b004:l035","ordinal":139598,"en":"Ruling the people with justice."},{"id":"semetey-1-2013:p0818:b004:l036","ordinal":139599,"en":"When did I wrong you, Bukharans,"},{"id":"semetey-1-2013:p0818:b004:l037","ordinal":139600,"en":"Even in the matter of your piebald colt?"},{"id":"semetey-1-2013:p0818:b004:l038","ordinal":139601,"en":"This time I will not consent"},{"id":"semetey-1-2013:p0818:b004:l039","ordinal":139602,"en":"To the way you drag things out."},{"id":"semetey-1-2013:p0818:b004:l040","ordinal":139603,"en":"Not merely one girl—Semetey"},{"id":"semetey-1-2013:p0819:b003:l001","ordinal":139604,"en":"Let him take eighty girls, here they are!"},{"id":"semetey-1-2013:p0819:b003:l002","ordinal":139605,"en":"Let him take all the people of Bukhara."},{"id":"semetey-1-2013:p0819:b003:l003","ordinal":139606,"en":"If Semetey wants,"},{"id":"semetey-1-2013:p0819:b003:l004","ordinal":139607,"en":"Let him cut my beard and take me too."},{"id":"semetey-1-2013:p0819:b003:l005","ordinal":139608,"en":"Let him take all four kinds of livestock,"},{"id":"semetey-1-2013:p0819:b003:l006","ordinal":139609,"en":"Let him take Bukhara's golden throne."},{"id":"semetey-1-2013:p0819:b003:l007","ordinal":139610,"en":"If he wishes, let him take old me!"},{"id":"semetey-1-2013:p0819:b003:l008","ordinal":139611,"en":"From this orphan standing here,"},{"id":"semetey-1-2013:p0819:b003:l009","ordinal":139612,"en":"I would not withhold my very life."},{"id":"semetey-1-2013:p0819:b003:l010","ordinal":139613,"en":"Saying, “They give away a betrothed girl,”"},{"id":"semetey-1-2013:p0819:b003:l011","ordinal":139614,"en":"If Toltoy grows angry,"},{"id":"semetey-1-2013:p0819:b003:l012","ordinal":139615,"en":"I have an answer ready to meet him,"},{"id":"semetey-1-2013:p0819:b003:l013","ordinal":139616,"en":"And an army ready to contend with him."},{"id":"semetey-1-2013:p0819:b003:l014","ordinal":139617,"en":"If he comes out to a lance fight, I shall face him;"},{"id":"semetey-1-2013:p0819:b003:l015","ordinal":139618,"en":"I shall answer him myself."},{"id":"semetey-1-2013:p0819:b003:l016","ordinal":139619,"en":"The obligation and the trouble"},{"id":"semetey-1-2013:p0819:b003:l017","ordinal":139620,"en":"I shall meet in advance."},{"id":"semetey-1-2013:p0819:b003:l018","ordinal":139621,"en":"If the Zhediger babble,"},{"id":"semetey-1-2013:p0819:b003:l019","ordinal":139622,"en":"I shall bring a thorough slaughter."},{"id":"semetey-1-2013:p0819:b003:l020","ordinal":139623,"en":"Whatever torment comes from it,"},{"id":"semetey-1-2013:p0819:b003:l021","ordinal":139624,"en":"I shall meet it myself.’"},{"id":"semetey-1-2013:p0819:b003:l022","ordinal":139625,"en":"The thousand strongmen of the royal treasury"},{"id":"semetey-1-2013:p0819:b003:l023","ordinal":139626,"en":"Were given the command."},{"id":"semetey-1-2013:p0819:b003:l024","ordinal":139627,"en":"Semetey and Chachykei"},{"id":"semetey-1-2013:p0819:b003:l025","ordinal":139628,"en":"To the gated fortress,"},{"id":"semetey-1-2013:p0819:b003:l026","ordinal":139629,"en":"To Temir Khan's royal court,"},{"id":"semetey-1-2013:p0819:b003:l027","ordinal":139630,"en":"They brought them there."},{"id":"semetey-1-2013:p0819:b003:l028","ordinal":139631,"en":"Slaughtering ninety fat mares,"},{"id":"semetey-1-2013:p0819:b003:l029","ordinal":139632,"en":"Slaughtering ninety milk-fed camel calves,"},{"id":"semetey-1-2013:p0819:b003:l030","ordinal":139633,"en":"Heaping up clarified butter,"},{"id":"semetey-1-2013:p0819:b003:l031","ordinal":139634,"en":"Filling the place with wealth,"},{"id":"semetey-1-2013:p0819:b003:l032","ordinal":139635,"en":"Spreading food and drink everywhere,"},{"id":"semetey-1-2013:p0819:b003:l033","ordinal":139636,"en":"Staging festivities no one could devise,"},{"id":"semetey-1-2013:p0819:b003:l034","ordinal":139637,"en":"Ninety from each of four kinds,"},{"id":"semetey-1-2013:p0819:b003:l035","ordinal":139638,"en":"He had each kind of livestock slaughtered."},{"id":"semetey-1-2013:p0819:b003:l036","ordinal":139639,"en":"Every wandering dervish and pauper"},{"id":"semetey-1-2013:p0819:b003:l037","ordinal":139640,"en":"He fed for ninety days in succession."},{"id":"semetey-1-2013:p0819:b003:l038","ordinal":139641,"en":"He launched great festivities,"},{"id":"semetey-1-2013:p0819:b003:l039","ordinal":139642,"en":"With fat lambs and tender heads,"},{"id":"semetey-1-2013:p0819:b005:l001","ordinal":139643,"en":"He had them boiled vigorously until done."},{"id":"semetey-1-2013:p0819:b005:l002","ordinal":139644,"en":"Merriment brought the dawn,"},{"id":"semetey-1-2013:p0819:b005:l003","ordinal":139645,"en":"And laughter saw the sun set."},{"id":"semetey-1-2013:p0819:b005:l004","ordinal":139646,"en":"In those days in Bukhara,"},{"id":"semetey-1-2013:p0819:b005:l005","ordinal":139647,"en":"He had the dutars played,"},{"id":"semetey-1-2013:p0819:b005:l006","ordinal":139648,"en":"And about sixty of his Sarts"},{"id":"semetey-1-2013:p0819:b005:l007","ordinal":139649,"en":"He had them all sing songs."},{"id":"semetey-1-2013:p0819:b005:l008","ordinal":139650,"en":"He had the booming drums struck,"},{"id":"semetey-1-2013:p0819:b005:l009","ordinal":139651,"en":"And those who performed these dances,"},{"id":"semetey-1-2013:p0819:b005:l010","ordinal":139652,"en":"The women dancers, he had brought,"},{"id":"semetey-1-2013:p0819:b005:l011","ordinal":139653,"en":"Increasing the entertainment."},{"id":"semetey-1-2013:p0819:b005:l012","ordinal":139654,"en":"They slaughtered a calf for the rite,"},{"id":"semetey-1-2013:p0819:b005:l013","ordinal":139655,"en":"And had the kok-boru contest played."},{"id":"semetey-1-2013:p0819:b005:l014","ordinal":139656,"en":"Entering the kok-boru,"},{"id":"semetey-1-2013:p0819:b005:l015","ordinal":139657,"en":"The strongmen swaggered about,"},{"id":"semetey-1-2013:p0819:b005:l016","ordinal":139658,"en":"And the khojas bustled grandly."},{"id":"semetey-1-2013:p0819:b005:l017","ordinal":139659,"en":"Gripping their whips between their teeth,"},{"id":"semetey-1-2013:p0819:b005:l018","ordinal":139660,"en":"Each urged on his lone horse."},{"id":"semetey-1-2013:p0819:b005:l019","ordinal":139661,"en":"They made wondrous entertainments,"},{"id":"semetey-1-2013:p0819:b005:l020","ordinal":139662,"en":"And great feats no one had seen:"},{"id":"semetey-1-2013:p0819:b005:l021","ordinal":139663,"en":"Bald men butted heads with one another."},{"id":"semetey-1-2013:p0819:b005:l022","ordinal":139664,"en":"To the bald man who won the butting,"},{"id":"semetey-1-2013:p0819:b005:l023","ordinal":139665,"en":"They granted what he asked,"},{"id":"semetey-1-2013:p0819:b005:l024","ordinal":139666,"en":"From the treasury's single-humped camels,"},{"id":"semetey-1-2013:p0819:b005:l025","ordinal":139667,"en":"Catching nine and giving them to him."},{"id":"semetey-1-2013:p0819:b005:l026","ordinal":139668,"en":"With festivities no one had known,"},{"id":"semetey-1-2013:p0819:b005:l027","ordinal":139669,"en":"They held a feast for nine days."},{"id":"semetey-1-2013:p0819:b005:l028","ordinal":139670,"en":"Of the white-turbaned khojas,"},{"id":"semetey-1-2013:p0819:b005:l029","ordinal":139671,"en":"And the lesson-reading mullahs,"},{"id":"semetey-1-2013:p0819:b005:l030","ordinal":139672,"en":"They gathered the learned men."},{"id":"semetey-1-2013:p0819:b005:l031","ordinal":139673,"en":"It was Bukhara's custom:"},{"id":"semetey-1-2013:p0819:b005:l032","ordinal":139674,"en":"They recited the khutba and solemnized the marriage."},{"id":"semetey-1-2013:p0819:b005:l033","ordinal":139675,"en":"At that time Semetey"},{"id":"semetey-1-2013:p0819:b005:l034","ordinal":139676,"en":"Took a wife and established a household."},{"id":"semetey-1-2013:p0819:b005:l035","ordinal":139677,"en":"He became a khan like his father,"},{"id":"semetey-1-2013:p0819:b005:l036","ordinal":139678,"en":"A man of surpassing honor."},{"id":"semetey-1-2013:p0819:b005:l037","ordinal":139679,"en":"Your orphan, son of the gray-maned hero,"},{"id":"semetey-1-2013:p0819:b005:l038","ordinal":139680,"en":"Prepared to move to Talas,"},{"id":"semetey-1-2013:p0819:b005:l039","ordinal":139681,"en":"To go to where his father Manas had lived."},{"id":"semetey-1-2013:p0820:b004:l001","ordinal":139682,"en":"Manas's orphan son—"},{"id":"semetey-1-2013:p0820:b004:l002","ordinal":139683,"en":"His coming departure was plain to see."},{"id":"semetey-1-2013:p0820:b004:l003","ordinal":139684,"en":"Bukhara, which had raised him,"},{"id":"semetey-1-2013:p0820:b004:l004","ordinal":139685,"en":"Shed tears from its eyes."},{"id":"semetey-1-2013:p0820:b004:l005","ordinal":139686,"en":"Its ruler Temir Khan wept,"},{"id":"semetey-1-2013:p0820:b004:l006","ordinal":139687,"en":"And Ysmayyl wept as well."},{"id":"semetey-1-2013:p0820:b004:l007","ordinal":139688,"en":"Then the people of Bukhara wept together."},{"id":"semetey-1-2013:p0820:b004:l009","ordinal":139689,"en":"All those who wept"},{"id":"semetey-1-2013:p0820:b004:l010","ordinal":139690,"en":"Wept in sorrow for themselves."},{"id":"semetey-1-2013:p0820:b004:l011","ordinal":139691,"en":"‘If he were Bukhara's protector,"},{"id":"semetey-1-2013:p0820:b004:l012","ordinal":139692,"en":"This dear orphan of ours,"},{"id":"semetey-1-2013:p0820:b004:l013","ordinal":139693,"en":"No calamity would befall us,’ they wept."},{"id":"semetey-1-2013:p0820:b004:l014","ordinal":139694,"en":"In the city of broad Bukhara,"},{"id":"semetey-1-2013:p0820:b004:l015","ordinal":139695,"en":"Treasure filled eight buildings:"},{"id":"semetey-1-2013:p0820:b004:l016","ordinal":139696,"en":"Red gold coins and rubies,"},{"id":"semetey-1-2013:p0820:b004:l017","ordinal":139697,"en":"Mixed with costly goods."},{"id":"semetey-1-2013:p0820:b004:l018","ordinal":139698,"en":"The royal strongmen,"},{"id":"semetey-1-2013:p0820:b004:l019","ordinal":139699,"en":"Having received the khan's command,"},{"id":"semetey-1-2013:p0820:b004:l020","ordinal":139700,"en":"Upon eighty red-tailed single-humped camels,"},{"id":"semetey-1-2013:p0820:b004:l021","ordinal":139701,"en":"Gold and rubies"},{"id":"semetey-1-2013:p0820:b004:l022","ordinal":139702,"en":"They loaded without stint."},{"id":"semetey-1-2013:p0820:b004:l023","ordinal":139703,"en":"As Semetey's inheritance,"},{"id":"semetey-1-2013:p0820:b004:l024","ordinal":139704,"en":"Saying, ‘Take these when you go,’"},{"id":"semetey-1-2013:p0820:b004:l025","ordinal":139705,"en":"They brought them to him,"},{"id":"semetey-1-2013:p0820:b004:l026","ordinal":139706,"en":"And to the orphan son of Manas"},{"id":"semetey-1-2013:p0820:b004:l027","ordinal":139707,"en":"Presented them as gifts."},{"id":"semetey-1-2013:p0820:b004:l028","ordinal":139708,"en":"They agreed to what he said."},{"id":"semetey-1-2013:p0820:b004:l029","ordinal":139709,"en":"To load the eighty camels,"},{"id":"semetey-1-2013:p0820:b004:l030","ordinal":139710,"en":"And lead them toward Talas,"},{"id":"semetey-1-2013:p0820:b004:l031","ordinal":139711,"en":"They provided eighty strongmen."},{"id":"semetey-1-2013:p0820:b004:l032","ordinal":139712,"en":"Eighty warriors became"},{"id":"semetey-1-2013:p0820:b004:l033","ordinal":139713,"en":"Semetey's companions."},{"id":"semetey-1-2013:p0820:b004:l034","ordinal":139714,"en":"When the camels were led out,"},{"id":"semetey-1-2013:p0820:b004:l035","ordinal":139715,"en":"The sight diverted one's heart;"},{"id":"semetey-1-2013:p0820:b004:l036","ordinal":139716,"en":"The red single-humped camels looked splendid."},{"id":"semetey-1-2013:p0820:b005:l001","ordinal":139717,"en":"Upon the red single-humped camels,"},{"id":"semetey-1-2013:p0820:b005:l002","ordinal":139718,"en":"Patterned carpets were folded."},{"id":"semetey-1-2013:p0820:b005:l003","ordinal":139719,"en":"Pearls, treasures and rubies"},{"id":"semetey-1-2013:p0820:b005:l004","ordinal":139720,"en":"Were loaded on the red camels."},{"id":"semetey-1-2013:p0820:b005:l005","ordinal":139721,"en":"The camels filed along in a row."},{"id":"semetey-1-2013:p0820:b005:l006","ordinal":139722,"en":"Seeing this wealth,"},{"id":"semetey-1-2013:p0820:b005:l007","ordinal":139723,"en":"The remarkable orphan rejoiced."},{"id":"semetey-1-2013:p0820:b005:l008","ordinal":139724,"en":"The red camels carrying the wealth"},{"id":"semetey-1-2013:p0820:b005:l009","ordinal":139725,"en":"Came from Temir Khan's treasury herds;"},{"id":"semetey-1-2013:p0820:b005:l010","ordinal":139726,"en":"Their appearance was most splendid."},{"id":"semetey-1-2013:p0820:b005:l011","ordinal":139727,"en":"Their fangs jutted out,"},{"id":"semetey-1-2013:p0820:b005:l012","ordinal":139728,"en":"Their lower lips drooped,"},{"id":"semetey-1-2013:p0820:b005:l013","ordinal":139729,"en":"Their swan-like necks rose proudly."},{"id":"semetey-1-2013:p0820:b005:l014","ordinal":139730,"en":"They towered as though they would devour one."},{"id":"semetey-1-2013:p0820:b005:l015","ordinal":139731,"en":"The sight diverted one's heart,"},{"id":"semetey-1-2013:p0820:b005:l016","ordinal":139732,"en":"Their throat knobs showing."},{"id":"semetey-1-2013:p0820:b005:l017","ordinal":139733,"en":"Step by stately step they walked,"},{"id":"semetey-1-2013:p0820:b005:l018","ordinal":139734,"en":"Setting all four feet evenly,"},{"id":"semetey-1-2013:p0820:b005:l019","ordinal":139735,"en":"Dust settling on their long hair,"},{"id":"semetey-1-2013:p0820:b005:l020","ordinal":139736,"en":"A booming sound arising."},{"id":"semetey-1-2013:p0820:b005:l021","ordinal":139737,"en":"God creates living souls."},{"id":"semetey-1-2013:p0820:b005:l022","ordinal":139738,"en":"Eighty strongmen serving him"},{"id":"semetey-1-2013:p0820:b005:l023","ordinal":139739,"en":"Led those camels,"},{"id":"semetey-1-2013:p0820:b005:l024","ordinal":139740,"en":"As your gray-maned hero moved to Talas."},{"id":"semetey-1-2013:p0820:b005:l025","ordinal":139741,"en":"Semetey's Sary Khan"},{"id":"semetey-1-2013:p0820:b005:l026","ordinal":139742,"en":"Held in his hands"},{"id":"semetey-1-2013:p0820:b005:l027","ordinal":139743,"en":"A red banner with a golden crescent."},{"id":"semetey-1-2013:p0820:b005:l028","ordinal":139744,"en":"If an enemy came out to shoot,"},{"id":"semetey-1-2013:p0820:b005:l029","ordinal":139745,"en":"Both strongman and lion,"},{"id":"semetey-1-2013:p0820:b005:l030","ordinal":139746,"en":"He would throw the world into tumult."},{"id":"semetey-1-2013:p0820:b005:l031","ordinal":139747,"en":"Sary Khan's Kalyk,"},{"id":"semetey-1-2013:p0820:b005:l032","ordinal":139748,"en":"When he had cast down the kaldai's banner,"},{"id":"semetey-1-2013:p0820:b005:l034","ordinal":139749,"en":"To the Muslim people too"},{"id":"semetey-1-2013:p0820:b005:l035","ordinal":139750,"en":"Had brought the benefit of his light."},{"id":"semetey-1-2013:p0820:b005:l036","ordinal":139751,"en":"God creates living souls."},{"id":"semetey-1-2013:p0821:b003:l001","ordinal":139752,"en":"Eighty-eight souls in all,"},{"id":"semetey-1-2013:p0821:b003:l002","ordinal":139753,"en":"Your orphan, the son of Manas,"},{"id":"semetey-1-2013:p0821:b003:l003","ordinal":139754,"en":"Was moving to Talas."},{"id":"semetey-1-2013:p0821:b003:l004","ordinal":139755,"en":"The saint who had borne Manas,"},{"id":"semetey-1-2013:p0821:b003:l005","ordinal":139756,"en":"Chiyyrdy, at ninety-five,"},{"id":"semetey-1-2013:p0821:b003:l006","ordinal":139757,"en":"Set her gray pacer moving,"},{"id":"semetey-1-2013:p0821:b003:l007","ordinal":139758,"en":"Turning many hearts toward her,"},{"id":"semetey-1-2013:p0821:b003:l008","ordinal":139759,"en":"Her whitening hair showing,"},{"id":"semetey-1-2013:p0821:b003:l009","ordinal":139760,"en":"Reclining like Mount Opol,"},{"id":"semetey-1-2013:p0821:b003:l010","ordinal":139761,"en":"Sitting grandly on the gray pacer,"},{"id":"semetey-1-2013:p0821:b003:l011","ordinal":139762,"en":"The elder wife took this road."},{"id":"semetey-1-2013:p0821:b003:l012","ordinal":139763,"en":"Your extraordinary mother Kanykei—"},{"id":"semetey-1-2013:p0821:b003:l013","ordinal":139764,"en":"Heroically built, an extraordinary warrior,"},{"id":"semetey-1-2013:p0821:b003:l014","ordinal":139765,"en":"Her right shoulder blade was broad,"},{"id":"semetey-1-2013:p0821:b003:l015","ordinal":139766,"en":"An unmatched lion among women."},{"id":"semetey-1-2013:p0821:b003:l016","ordinal":139767,"en":"Emboldened by her courage,"},{"id":"semetey-1-2013:p0821:b003:l017","ordinal":139768,"en":"Kanykei at fourteen"},{"id":"semetey-1-2013:p0821:b003:l018","ordinal":139769,"en":"Had met that Manas."},{"id":"semetey-1-2013:p0821:b003:l019","ordinal":139770,"en":"They had joined when thumb-small,"},{"id":"semetey-1-2013:p0821:b003:l020","ordinal":139771,"en":"United when tiny as lice."},{"id":"semetey-1-2013:p0821:b003:l021","ordinal":139772,"en":"Sultan Manas, the gray-maned hero,"},{"id":"semetey-1-2013:p0821:b003:l022","ordinal":139773,"en":"She planted and tended into a garden,"},{"id":"semetey-1-2013:p0821:b003:l023","ordinal":139774,"en":"Built and raised into a house."},{"id":"semetey-1-2013:p0821:b003:l024","ordinal":139775,"en":"She joined what had broken,"},{"id":"semetey-1-2013:p0821:b003:l025","ordinal":139776,"en":"Gathered what had scattered."}]
