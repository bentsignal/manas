[{"id":"semetey-1-2013:p0837:b003:l030","ordinal":140289,"en":"Readying his painted spear,"},{"id":"semetey-1-2013:p0837:b003:l031","ordinal":140290,"en":"To Manas, gone to the other world,"},{"id":"semetey-1-2013:p0837:b003:l032","ordinal":140291,"en":"He prayed for his spirit’s aid."},{"id":"semetey-1-2013:p0837:b003:l033","ordinal":140292,"en":"Shouting “Manas!”"},{"id":"semetey-1-2013:p0837:b003:l034","ordinal":140293,"en":"Crying “Manas!” as his battle cry,"},{"id":"semetey-1-2013:p0837:b003:l035","ordinal":140294,"en":"He struck Arbuudan on the flank,"},{"id":"semetey-1-2013:p0837:b003:l036","ordinal":140295,"en":"Attacked the champions."},{"id":"semetey-1-2013:p0837:b003:l037","ordinal":140296,"en":"Semetey, Manas’s son,"},{"id":"semetey-1-2013:p0837:b003:l038","ordinal":140297,"en":"Played with them a little;"},{"id":"semetey-1-2013:p0837:b003:l039","ordinal":140298,"en":"As he played, ten champions"},{"id":"semetey-1-2013:p0837:b004:l001","ordinal":140299,"en":"Lay dead."},{"id":"semetey-1-2013:p0837:b004:l002","ordinal":140300,"en":"A thousand champions had come to challenge him,"},{"id":"semetey-1-2013:p0837:b004:l003","ordinal":140301,"en":"Entangling themselves in death."},{"id":"semetey-1-2013:p0837:b004:l004","ordinal":140302,"en":"Taking Zulpukor in hand,"},{"id":"semetey-1-2013:p0837:b004:l005","ordinal":140303,"en":"Attacking the champions,"},{"id":"semetey-1-2013:p0837:b004:l006","ordinal":140304,"en":"Without looking about him,"},{"id":"semetey-1-2013:p0837:b004:l007","ordinal":140305,"en":"Without sparing his own life,"},{"id":"semetey-1-2013:p0837:b004:l008","ordinal":140306,"en":"Entwined with the champions,"},{"id":"semetey-1-2013:p0837:b004:l009","ordinal":140307,"en":"He joined the general melee."},{"id":"semetey-1-2013:p0837:b004:l010","ordinal":140308,"en":"Thirty of their beks, in one place,"},{"id":"semetey-1-2013:p0837:b004:l011","ordinal":140309,"en":"Lay dead together."},{"id":"semetey-1-2013:p0837:b004:l012","ordinal":140310,"en":"Raising a mighty cry,"},{"id":"semetey-1-2013:p0837:b004:l013","ordinal":140311,"en":"When he fought that fierce battle,"},{"id":"semetey-1-2013:p0837:b004:l014","ordinal":140312,"en":"Forty champions died in one place."},{"id":"semetey-1-2013:p0837:b004:l015","ordinal":140313,"en":"Roaring in wrath,"},{"id":"semetey-1-2013:p0837:b004:l016","ordinal":140314,"en":"Attacking right and left,"},{"id":"semetey-1-2013:p0837:b004:l017","ordinal":140315,"en":"Thrusting his spear this way and that,"},{"id":"semetey-1-2013:p0837:b004:l018","ordinal":140316,"en":"Wherever his spear could reach,"},{"id":"semetey-1-2013:p0837:b004:l019","ordinal":140317,"en":"He struck down with the spear;"},{"id":"semetey-1-2013:p0837:b004:l020","ordinal":140318,"en":"Wherever his sword could reach,"},{"id":"semetey-1-2013:p0837:b004:l021","ordinal":140319,"en":"He slashed and felled them."},{"id":"semetey-1-2013:p0837:b004:l022","ordinal":140320,"en":"As he swung this way and that,"},{"id":"semetey-1-2013:p0837:b004:l023","ordinal":140321,"en":"They died five or ten at a time."},{"id":"semetey-1-2013:p0837:b004:l024","ordinal":140322,"en":"When they met him face to face,"},{"id":"semetey-1-2013:p0837:b004:l025","ordinal":140323,"en":"Khans Janaaly and Karach died."},{"id":"semetey-1-2013:p0837:b004:l026","ordinal":140324,"en":"Their khojas in motley robes,"},{"id":"semetey-1-2013:p0837:b004:l027","ordinal":140325,"en":"Their mullahs in white turbans,"},{"id":"semetey-1-2013:p0837:b004:l028","ordinal":140326,"en":"He drove before him."},{"id":"semetey-1-2013:p0837:b004:l029","ordinal":140327,"en":"Of the thousand champions who came,"},{"id":"semetey-1-2013:p0837:b004:l030","ordinal":140328,"en":"Many had died;"},{"id":"semetey-1-2013:p0837:b004:l031","ordinal":140329,"en":"The champions, all together,"},{"id":"semetey-1-2013:p0837:b004:l032","ordinal":140330,"en":"The boy brought to their end."},{"id":"semetey-1-2013:p0837:b004:l033","ordinal":140331,"en":"Among the thousand champions,"},{"id":"semetey-1-2013:p0837:b004:l034","ordinal":140332,"en":"Their cruppers broken,"},{"id":"semetey-1-2013:p0837:b004:l035","ordinal":140333,"en":"Many were in distress;"},{"id":"semetey-1-2013:p0837:b004:l036","ordinal":140334,"en":"Opening their mouths to the sky,"},{"id":"semetey-1-2013:p0837:b004:l037","ordinal":140335,"en":"Many went howling."},{"id":"semetey-1-2013:p0837:b004:l038","ordinal":140336,"en":"Their girths broken,"},{"id":"semetey-1-2013:p0837:b004:l039","ordinal":140337,"en":"Many were in a panic."},{"id":"semetey-1-2013:p0838:b003:l001","ordinal":140338,"en":"“We have fallen into calamity,” they cried;"},{"id":"semetey-1-2013:p0838:b003:l002","ordinal":140339,"en":"Many were fleeing."},{"id":"semetey-1-2013:p0838:b003:l003","ordinal":140340,"en":"Of many mighty stallions,"},{"id":"semetey-1-2013:p0838:b003:l004","ordinal":140341,"en":"The saddles had slipped onto their necks;"},{"id":"semetey-1-2013:p0838:b003:l005","ordinal":140342,"en":"Many were wrenching themselves free,"},{"id":"semetey-1-2013:p0838:b003:l006","ordinal":140343,"en":"Many swift noble steeds,"},{"id":"semetey-1-2013:p0838:b003:l007","ordinal":140344,"en":"Their saddles and saddlecloths still upon them,"},{"id":"semetey-1-2013:p0838:b003:l008","ordinal":140345,"en":"Had no masters to mount and ride;"},{"id":"semetey-1-2013:p0838:b003:l009","ordinal":140346,"en":"Many were being led alongside."},{"id":"semetey-1-2013:p0838:b003:l010","ordinal":140347,"en":"“My dear, precious kinsman"},{"id":"semetey-1-2013:p0838:b003:l011","ordinal":140348,"en":"Has died in such-and-such a place,"},{"id":"semetey-1-2013:p0838:b003:l012","ordinal":140349,"en":"Has met Judgment,” they cried;"},{"id":"semetey-1-2013:p0838:b003:l013","ordinal":140350,"en":"Many went wailing."},{"id":"semetey-1-2013:p0838:b003:l014","ordinal":140351,"en":"In panic for their precious lives,"},{"id":"semetey-1-2013:p0838:b003:l015","ordinal":140352,"en":"Many had lost all hope."},{"id":"semetey-1-2013:p0838:b003:l016","ordinal":140353,"en":"Folding their arms upon their breasts,"},{"id":"semetey-1-2013:p0838:b003:l017","ordinal":140354,"en":"Many came running."},{"id":"semetey-1-2013:p0838:b003:l018","ordinal":140355,"en":"“We came because of the khan’s wrath;"},{"id":"semetey-1-2013:p0838:b003:l019","ordinal":140356,"en":"We have died unawares,” they cried;"},{"id":"semetey-1-2013:p0838:b003:l020","ordinal":140357,"en":"Many made their lament."},{"id":"semetey-1-2013:p0838:b003:l021","ordinal":140358,"en":"Taking their spears and darting about,"},{"id":"semetey-1-2013:p0838:b003:l022","ordinal":140359,"en":"Many still attacked."},{"id":"semetey-1-2013:p0838:b003:l023","ordinal":140360,"en":"“Hero, we submit as slaves!”"},{"id":"semetey-1-2013:p0838:b003:l024","ordinal":140361,"en":"Many pleaded."},{"id":"semetey-1-2013:p0838:b003:l025","ordinal":140362,"en":"A hero himself, grim of face,"},{"id":"semetey-1-2013:p0838:b003:l026","ordinal":140363,"en":"Riding a red-chestnut horse,"},{"id":"semetey-1-2013:p0838:b003:l027","ordinal":140364,"en":"Its long tail tightly knotted,"},{"id":"semetey-1-2013:p0838:b003:l028","ordinal":140365,"en":"A golden-cheeked battleaxe"},{"id":"semetey-1-2013:p0838:b003:l029","ordinal":140366,"en":"Hung from his wrist."},{"id":"semetey-1-2013:p0838:b003:l030","ordinal":140367,"en":"He looked like the angel of death;"},{"id":"semetey-1-2013:p0838:b003:l031","ordinal":140368,"en":"To see him troubled the heart."},{"id":"semetey-1-2013:p0838:b003:l032","ordinal":140369,"en":"Equipped with every kind of gear,"},{"id":"semetey-1-2013:p0838:b003:l033","ordinal":140370,"en":"Pouncing like a lion,"},{"id":"semetey-1-2013:p0838:b003:l035","ordinal":140371,"en":"The tip of his spear curved,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0838:b003:l036","ordinal":140372,"en":"Rough in appearance, grim of face,"},{"id":"semetey-1-2013:p0838:b003:l037","ordinal":140373,"en":"He was a great champion above the multitude."},{"id":"semetey-1-2013:p0838:b003:l038","ordinal":140374,"en":"The peoples of four khans had gathered"},{"id":"semetey-1-2013:p0838:b003:l039","ordinal":140375,"en":"And sent this one champion."},{"id":"semetey-1-2013:p0838:b004:l001","ordinal":140376,"en":"As large as a mountain,"},{"id":"semetey-1-2013:p0838:b004:l002","ordinal":140377,"en":"Fierce in strength, bitter of face,"},{"id":"semetey-1-2013:p0838:b004:l003","ordinal":140378,"en":"He seemed ready to devour whoever appeared."},{"id":"semetey-1-2013:p0838:b004:l004","ordinal":140379,"en":"The sound of his approach"},{"id":"semetey-1-2013:p0838:b004:l005","ordinal":140380,"en":"Rumbled as though the earth were splitting."},{"id":"semetey-1-2013:p0838:b004:l006","ordinal":140381,"en":"“Manas’s orphan slave,"},{"id":"semetey-1-2013:p0838:b004:l007","ordinal":140382,"en":"Even if you have seventy lives,"},{"id":"semetey-1-2013:p0838:b004:l008","ordinal":140383,"en":"Now you have died by my hand,"},{"id":"semetey-1-2013:p0838:b004:l009","ordinal":140384,"en":"Now you have met Judgment!” he cried."},{"id":"semetey-1-2013:p0838:b004:l010","ordinal":140385,"en":"He thundered in arrogant boasts;"},{"id":"semetey-1-2013:p0838:b004:l011","ordinal":140386,"en":"At the champion’s boasting,"},{"id":"semetey-1-2013:p0838:b004:l012","ordinal":140387,"en":"The earth rumbled and split."},{"id":"semetey-1-2013:p0838:b004:l013","ordinal":140388,"en":"Watching his wrath,"},{"id":"semetey-1-2013:p0838:b004:l015","ordinal":140389,"en":"The heart could not help trembling.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0838:b004:l016","ordinal":140390,"en":"The champion of Hindustan"},{"id":"semetey-1-2013:p0838:b004:l017","ordinal":140391,"en":"Was named Orokjan."},{"id":"semetey-1-2013:p0838:b004:l018","ordinal":140392,"en":"Orokjan’s size"},{"id":"semetey-1-2013:p0838:b004:l019","ordinal":140393,"en":"Was that of a little hill."},{"id":"semetey-1-2013:p0838:b004:l020","ordinal":140394,"en":"Having fought in many lands,"},{"id":"semetey-1-2013:p0838:b004:l021","ordinal":140395,"en":"He was an experienced man."},{"id":"semetey-1-2013:p0838:b004:l022","ordinal":140396,"en":"Among spearmen he was skilled;"},{"id":"semetey-1-2013:p0838:b004:l023","ordinal":140397,"en":"He too was an accomplished master,"},{"id":"semetey-1-2013:p0838:b004:l024","ordinal":140398,"en":"Resourceful and adept."},{"id":"semetey-1-2013:p0838:b004:l025","ordinal":140399,"en":"Sparing no effort, that champion"},{"id":"semetey-1-2013:p0838:b004:l026","ordinal":140400,"en":"Cried, “Come here for single combat!”"},{"id":"semetey-1-2013:p0838:b004:l027","ordinal":140401,"en":"Kyljeerde’s head"},{"id":"semetey-1-2013:p0838:b004:l028","ordinal":140402,"en":"He turned and rode forth."},{"id":"semetey-1-2013:p0838:b004:l029","ordinal":140403,"en":"Shouting loudly, his spear"},{"id":"semetey-1-2013:p0838:b004:l030","ordinal":140404,"en":"Leveled, he came forward!"},{"id":"semetey-1-2013:p0838:b004:l031","ordinal":140405,"en":"As though an evil spirit had seized his wife,"},{"id":"semetey-1-2013:p0838:b004:l032","ordinal":140406,"en":"As though fleeing with pursuers close behind,"},{"id":"semetey-1-2013:p0838:b004:l033","ordinal":140407,"en":"As though pursuing someone close ahead,"},{"id":"semetey-1-2013:p0838:b004:l034","ordinal":140408,"en":"As though his wife had borne a son,"},{"id":"semetey-1-2013:p0838:b004:l035","ordinal":140409,"en":"He hastened in great agitation."},{"id":"semetey-1-2013:p0838:b004:l036","ordinal":140410,"en":"From the broad riverbed without a pebble,"},{"id":"semetey-1-2013:p0838:b004:l038","ordinal":140411,"en":"No foe would escape his spear.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0838:b004:l039","ordinal":140412,"en":"Your sultan, Manas’s son—"},{"id":"semetey-1-2013:p0839:b003:l001","ordinal":140413,"en":"When Orokjan had just arrived,"},{"id":"semetey-1-2013:p0839:b003:l002","ordinal":140414,"en":"He turned Buurul’s head,"},{"id":"semetey-1-2013:p0839:b003:l003","ordinal":140415,"en":"Without fretting over brow or eyebrow,"},{"id":"semetey-1-2013:p0839:b003:l004","ordinal":140416,"en":"And stood watching somberly."},{"id":"semetey-1-2013:p0839:b003:l005","ordinal":140417,"en":"“Let the champion take his turn;"},{"id":"semetey-1-2013:p0839:b003:l006","ordinal":140418,"en":"Let him have no regrets."},{"id":"semetey-1-2013:p0839:b003:l007","ordinal":140419,"en":"If this champion has the strength,"},{"id":"semetey-1-2013:p0839:b003:l008","ordinal":140420,"en":"Let him slaughter me before a boar;"},{"id":"semetey-1-2013:p0839:b003:l010","ordinal":140421,"en":"Semetey held his ground.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0839:b003:l011","ordinal":140422,"en":"When Orok charged and thrust,"},{"id":"semetey-1-2013:p0839:b003:l012","ordinal":140423,"en":"“My brow! My eyebrow!”—"},{"id":"semetey-1-2013:p0839:b003:l013","ordinal":140424,"en":"Semetey did not recoil."},{"id":"semetey-1-2013:p0839:b003:l014","ordinal":140425,"en":"Beyond his fierce father Manas,"},{"id":"semetey-1-2013:p0839:b003:l015","ordinal":140426,"en":"He was a hero born greater still."},{"id":"semetey-1-2013:p0839:b003:l016","ordinal":140427,"en":"The painted spear with its thickened iron head"},{"id":"semetey-1-2013:p0839:b003:l017","ordinal":140428,"en":"He grasped it ready in his hand."},{"id":"semetey-1-2013:p0839:b003:l018","ordinal":140429,"en":"Your hero bent and hunched his back,"},{"id":"semetey-1-2013:p0839:b003:l019","ordinal":140430,"en":"His eyes bulged,"},{"id":"semetey-1-2013:p0839:b003:l020","ordinal":140431,"en":"His ribs stood out."},{"id":"semetey-1-2013:p0839:b003:l021","ordinal":140432,"en":"Without looking around him,"},{"id":"semetey-1-2013:p0839:b003:l022","ordinal":140433,"en":"Your orphan, son of the ocean,"},{"id":"semetey-1-2013:p0839:b003:l023","ordinal":140434,"en":"Spared not his own life."},{"id":"semetey-1-2013:p0839:b003:l024","ordinal":140435,"en":"When the boy leveled his spear,"},{"id":"semetey-1-2013:p0839:b003:l025","ordinal":140436,"en":"Orokjan stood before him."},{"id":"semetey-1-2013:p0839:b003:l026","ordinal":140437,"en":"Manas’s son reached him;"},{"id":"semetey-1-2013:p0839:b003:l027","ordinal":140438,"en":"From Kyljeerde’s back,"},{"id":"semetey-1-2013:p0839:b003:l028","ordinal":140439,"en":"The moment he reached Orok,"},{"id":"semetey-1-2013:p0839:b003:l029","ordinal":140440,"en":"He pitched him down as he passed."},{"id":"semetey-1-2013:p0839:b003:l030","ordinal":140441,"en":"Zulpukor, left by his father Manas—"},{"id":"semetey-1-2013:p0839:b003:l031","ordinal":140442,"en":"Grasping it by the hilt,"},{"id":"semetey-1-2013:p0839:b003:l032","ordinal":140443,"en":"Drawing it from its sheath,"},{"id":"semetey-1-2013:p0839:b003:l033","ordinal":140444,"en":"He cut off Orok’s head."},{"id":"semetey-1-2013:p0839:b003:l034","ordinal":140445,"en":"Of all the thousand champions,"},{"id":"semetey-1-2013:p0839:b003:l035","ordinal":140446,"en":"Those remaining alive—"},{"id":"semetey-1-2013:p0839:b003:l036","ordinal":140447,"en":"Their own possessions across the field"},{"id":"semetey-1-2013:p0839:b003:l037","ordinal":140448,"en":"Many scattered and abandoned."},{"id":"semetey-1-2013:p0839:b003:l038","ordinal":140449,"en":"Each in whatever direction he faced,"},{"id":"semetey-1-2013:p0839:b003:l039","ordinal":140450,"en":"Many fled away."},{"id":"semetey-1-2013:p0839:b004:l001","ordinal":140451,"en":"Their uproar scattered like dust;"},{"id":"semetey-1-2013:p0839:b004:l002","ordinal":140452,"en":"All the champions went singly,"},{"id":"semetey-1-2013:p0839:b004:l003","ordinal":140453,"en":"Unable to regain their composure,"},{"id":"semetey-1-2013:p0839:b004:l004","ordinal":140454,"en":"Struggling for their lives,"},{"id":"semetey-1-2013:p0839:b004:l005","ordinal":140455,"en":"The champions wandered one by one."},{"id":"semetey-1-2013:p0839:b004:l006","ordinal":140456,"en":"Fleeing in distress, the champions"},{"id":"semetey-1-2013:p0839:b004:l007","ordinal":140457,"en":"Before the kushbegi"},{"id":"semetey-1-2013:p0839:b004:l008","ordinal":140458,"en":"Ran in agitation."},{"id":"semetey-1-2013:p0839:b004:l009","ordinal":140459,"en":"All the champions who arrived"},{"id":"semetey-1-2013:p0839:b004:l010","ordinal":140460,"en":"Maligned him to the kushbegi:"},{"id":"semetey-1-2013:p0839:b004:l011","ordinal":140461,"en":"“He is no ordinary orphan boy."},{"id":"semetey-1-2013:p0839:b004:l012","ordinal":140462,"en":"All eighteen thousand worlds—"},{"id":"semetey-1-2013:p0839:b004:l013","ordinal":140463,"en":"He would give them no peace."},{"id":"semetey-1-2013:p0839:b004:l014","ordinal":140464,"en":"The imposing wolf has died;"},{"id":"semetey-1-2013:p0839:b004:l015","ordinal":140465,"en":"Many who faced him have died."},{"id":"semetey-1-2013:p0839:b004:l016","ordinal":140466,"en":"Khans Janaaly and Karach have died;"},{"id":"semetey-1-2013:p0839:b004:l017","ordinal":140467,"en":"Champion Orokjan has died too."},{"id":"semetey-1-2013:p0839:b004:l018","ordinal":140468,"en":"Manas’s orphan son"},{"id":"semetey-1-2013:p0839:b004:l019","ordinal":140469,"en":"Has Buurul beneath him."},{"id":"semetey-1-2013:p0839:b004:l020","ordinal":140470,"en":"Not merely us, the peoples of four khans—"},{"id":"semetey-1-2013:p0839:b004:l021","ordinal":140471,"en":"Upon all eighteen thousand worlds"},{"id":"semetey-1-2013:p0839:b004:l022","ordinal":140472,"en":"He has the strength to wreak slaughter."},{"id":"semetey-1-2013:p0839:b004:l023","ordinal":140473,"en":"Broad-chested, with a mighty breast,"},{"id":"semetey-1-2013:p0839:b004:l024","ordinal":140474,"en":"He is a son worthy of a hero."},{"id":"semetey-1-2013:p0839:b004:l025","ordinal":140475,"en":"Beyond his fierce father Manas,"},{"id":"semetey-1-2013:p0839:b004:l026","ordinal":140476,"en":"He is born a greater terror."},{"id":"semetey-1-2013:p0839:b004:l027","ordinal":140477,"en":"Whoever grapples with him will not prosper;"},{"id":"semetey-1-2013:p0839:b004:l028","ordinal":140478,"en":"Whoever clashes with him will not remain unharmed."},{"id":"semetey-1-2013:p0839:b004:l029","ordinal":140479,"en":"We have seen the boy’s terror;"},{"id":"semetey-1-2013:p0839:b004:l030","ordinal":140480,"en":"We have stepped upon"},{"id":"semetey-1-2013:p0839:b004:l031","ordinal":140481,"en":"A dragon’s tail."},{"id":"semetey-1-2013:p0839:b004:l032","ordinal":140482,"en":"We have taken fright at the boy."},{"id":"semetey-1-2013:p0839:b004:l033","ordinal":140483,"en":"His renown is great, his face is grim,"},{"id":"semetey-1-2013:p0839:b004:l034","ordinal":140484,"en":"Fierce and resolute as a lion,"},{"id":"semetey-1-2013:p0839:b004:l035","ordinal":140485,"en":"No man can go to match him;"},{"id":"semetey-1-2013:p0839:b004:l036","ordinal":140486,"en":"None who challenges him can remain alive."},{"id":"semetey-1-2013:p0839:b004:l037","ordinal":140487,"en":"He merely played a little;"},{"id":"semetey-1-2013:p0839:b004:l038","ordinal":140488,"en":"Thirty champions died together."},{"id":"semetey-1-2013:p0839:b004:l039","ordinal":140489,"en":"These eyes, may they be gouged out, saw it."},{"id":"semetey-1-2013:p0840:b003:l001","ordinal":140490,"en":"Those whose death had come were caught;"},{"id":"semetey-1-2013:p0840:b003:l002","ordinal":140491,"en":"All whose death had not come"},{"id":"semetey-1-2013:p0840:b003:l003","ordinal":140492,"en":"Barely escaped by fleeing."},{"id":"semetey-1-2013:p0840:b003:l004","ordinal":140493,"en":"If you keep contending with him, this orphan"},{"id":"semetey-1-2013:p0840:b003:l005","ordinal":140494,"en":"Will plunder the fine cloth;"},{"id":"semetey-1-2013:p0840:b003:l006","ordinal":140495,"en":"Will he not cause terrible havoc?"},{"id":"semetey-1-2013:p0840:b003:l007","ordinal":140496,"en":"Destroying you,"},{"id":"semetey-1-2013:p0840:b003:l008","ordinal":140497,"en":"Slaughtering us,"},{"id":"semetey-1-2013:p0840:b003:l009","ordinal":140498,"en":"With thimble mouths and camel-calf eyes,"},{"id":"semetey-1-2013:p0840:b003:l010","ordinal":140499,"en":"With roving dark eyes,"},{"id":"semetey-1-2013:p0840:b003:l011","ordinal":140500,"en":"‘He will take the girls as plunder,’ we thought;"},{"id":"semetey-1-2013:p0840:b003:l012","ordinal":140501,"en":"We greatly feared this being."},{"id":"semetey-1-2013:p0840:b003:l013","ordinal":140502,"en":"A thousand champions, as though we would not spare him,"},{"id":"semetey-1-2013:p0840:b003:l014","ordinal":140503,"en":"We thrust our spears and joined battle,"},{"id":"semetey-1-2013:p0840:b003:l015","ordinal":140504,"en":"And fell needlessly into torment."},{"id":"semetey-1-2013:p0840:b003:l016","ordinal":140505,"en":"He could humiliate the khojas,"},{"id":"semetey-1-2013:p0840:b003:l017","ordinal":140506,"en":"Drive off and slaughter the mullahs."},{"id":"semetey-1-2013:p0840:b003:l018","ordinal":140507,"en":"If you keep contending, this orphan"},{"id":"semetey-1-2013:p0840:b003:l019","ordinal":140508,"en":"Will bring us to our end,"},{"id":"semetey-1-2013:p0840:b003:l020","ordinal":140509,"en":"Will slaughter us entirely.”"},{"id":"semetey-1-2013:p0840:b003:l021","ordinal":140510,"en":"Hearing the champions, Kozubek—"},{"id":"semetey-1-2013:p0840:b003:l022","ordinal":140511,"en":"This khan lost his composure."},{"id":"semetey-1-2013:p0840:b003:l023","ordinal":140512,"en":"Never satisfied with begging and consuming,"},{"id":"semetey-1-2013:p0840:b003:l024","ordinal":140513,"en":"Never abandoning his greed,"},{"id":"semetey-1-2013:p0840:b003:l025","ordinal":140514,"en":"“That bastard of Kyrgyz stock"},{"id":"semetey-1-2013:p0840:b003:l026","ordinal":140515,"en":"Will bring calamity,” he thought."},{"id":"semetey-1-2013:p0840:b003:l027","ordinal":140516,"en":"“The peoples of four khans, every one,"},{"id":"semetey-1-2013:p0840:b003:l028","ordinal":140517,"en":"He will slaughter today,” he thought."},{"id":"semetey-1-2013:p0840:b003:l029","ordinal":140518,"en":"“If this orphan continues thus,"},{"id":"semetey-1-2013:p0840:b003:l031","ordinal":140519,"en":"Their wide robes flapping,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0840:b003:l033","ordinal":140520,"en":"Their breasts bared,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0840:b003:l034","ordinal":140521,"en":"In terrible haste,"},{"id":"semetey-1-2013:p0840:b003:l035","ordinal":140522,"en":"They fled awkwardly to the palace,"},{"id":"semetey-1-2013:p0840:b003:l036","ordinal":140523,"en":"Their hearts troubled,"},{"id":"semetey-1-2013:p0840:b003:l037","ordinal":140524,"en":"Their chests exposed,"},{"id":"semetey-1-2013:p0840:b003:l038","ordinal":140525,"en":"Their noses flaring,"},{"id":"semetey-1-2013:p0840:b003:l039","ordinal":140526,"en":"Fleeing in frantic haste."},{"id":"semetey-1-2013:p0840:b004:l001","ordinal":140527,"en":"Scolding their sentries,"},{"id":"semetey-1-2013:p0840:b004:l002","ordinal":140528,"en":"Bolting their doors,"},{"id":"semetey-1-2013:p0840:b004:l003","ordinal":140529,"en":"They fled into the palace;"},{"id":"semetey-1-2013:p0840:b004:l004","ordinal":140530,"en":"Kokand shut itself within the palace."},{"id":"semetey-1-2013:p0840:b004:l005","ordinal":140531,"en":"Driving the champions, shouting,"},{"id":"semetey-1-2013:p0840:b004:l006","ordinal":140532,"en":"Those left alive"},{"id":"semetey-1-2013:p0840:b004:l007","ordinal":140533,"en":"Semetey came pursuing,"},{"id":"semetey-1-2013:p0840:b004:l008","ordinal":140534,"en":"Sweeping them toward Kokand."},{"id":"semetey-1-2013:p0840:b004:l009","ordinal":140535,"en":"Sary Khan, with eyes like little bowls,"},{"id":"semetey-1-2013:p0840:b004:l010","ordinal":140536,"en":"Took the road and sped forward,"},{"id":"semetey-1-2013:p0840:b004:l011","ordinal":140537,"en":"Shouting “Semetey!”"},{"id":"semetey-1-2013:p0840:b004:l012","ordinal":140538,"en":"Urging his horse, he reached him."},{"id":"semetey-1-2013:p0840:b004:l013","ordinal":140539,"en":"Sary Khan came up,"},{"id":"semetey-1-2013:p0840:b004:l014","ordinal":140540,"en":"Took hold of the bit,"},{"id":"semetey-1-2013:p0840:b004:l015","ordinal":140541,"en":"And spoke words of wisdom:"},{"id":"semetey-1-2013:p0840:b004:l016","ordinal":140542,"en":"“My spring before me,"},{"id":"semetey-1-2013:p0840:b004:l017","ordinal":140543,"en":"My lamp upon which I rely!"},{"id":"semetey-1-2013:p0840:b004:l018","ordinal":140544,"en":"Your father Manas, that surpassing lion,"}]
