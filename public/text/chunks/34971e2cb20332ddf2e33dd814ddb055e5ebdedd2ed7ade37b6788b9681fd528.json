[{"id":"manas-2010:p1361:b001:l031","ordinal":58881,"en":"Syrgak, son of Ulak Khan,"},{"id":"manas-2010:p1361:b001:l032","ordinal":58882,"en":"Would not yield to the Lama;"},{"id":"manas-2010:p1361:b001:l033","ordinal":58883,"en":"The young fellow was your lion."},{"id":"manas-2010:p1361:b001:l034","ordinal":58884,"en":"Swinging back with his battle-axe,"},{"id":"manas-2010:p1361:b001:l035","ordinal":58885,"en":"Among the Chinese before him"},{"id":"manas-2010:p1361:b001:l036","ordinal":58886,"en":"He entered, smashing through."},{"id":"manas-2010:p1361:b001:l037","ordinal":58887,"en":"Torment never told of"},{"id":"manas-2010:p1361:b001:l038","ordinal":58888,"en":"Hero Syrgak unleashed."},{"id":"manas-2010:p1361:b001:l039","ordinal":58889,"en":"Snatching him away across his saddle,"},{"id":"manas-2010:p1361:b001:l040","ordinal":58890,"en":"That warrior Azhybay"},{"id":"manas-2010:p1361:b001:l041","ordinal":58891,"en":"Hero Syrgak brought out."},{"id":"manas-2010:p1361:b001:l042","ordinal":58892,"en":"Led along riderless at his command,"},{"id":"manas-2010:p1362:b001:l001","ordinal":58893,"en":"Sacred Manas's"},{"id":"manas-2010:p1362:b001:l002","ordinal":58894,"en":"Black horse of Kalkaman—"},{"id":"manas-2010:p1362:b001:l003","ordinal":58895,"en":"Whichever companion was left on foot,"},{"id":"manas-2010:p1362:b001:l004","ordinal":58896,"en":"Whatever the battle might be,"},{"id":"manas-2010:p1362:b001:l005","ordinal":58897,"en":"From beginning to end,"},{"id":"manas-2010:p1362:b001:l006","ordinal":58898,"en":"It was his custom to mount him on it."},{"id":"manas-2010:p1362:b001:l007","ordinal":58899,"en":"That too was a splendid steed."},{"id":"manas-2010:p1362:b001:l008","ordinal":58900,"en":"Syrgak reached it,"},{"id":"manas-2010:p1362:b001:l009","ordinal":58901,"en":"Mounted Azhybay upon it,"},{"id":"manas-2010:p1362:b001:l010","ordinal":58902,"en":"And from among the Chinese"},{"id":"manas-2010:p1362:b001:l011","ordinal":58903,"en":"Tore him free and led him away."},{"id":"manas-2010:p1362:b001:l012","ordinal":58904,"en":"Then hero Bakay,"},{"id":"manas-2010:p1362:b001:l013","ordinal":58905,"en":"Whipping the gray steed,"},{"id":"manas-2010:p1362:b001:l014","ordinal":58906,"en":"Not sparing his threadlike life,"},{"id":"manas-2010:p1362:b001:l015","ordinal":58907,"en":"Reached Khan Zholoy."},{"id":"manas-2010:p1362:b001:l016","ordinal":58908,"en":"Zholoy, khan of the Kalmyks,"},{"id":"manas-2010:p1362:b001:l017","ordinal":58909,"en":"The instant hero Bakay reached him,"},{"id":"manas-2010:p1362:b001:l018","ordinal":58910,"en":"From the back of Achbuudan"},{"id":"manas-2010:p1362:b001:l019","ordinal":58911,"en":"He hurled down as he passed."},{"id":"manas-2010:p1362:b001:l020","ordinal":58912,"en":"Upon the splendid steed Kögala,"},{"id":"manas-2010:p1362:b001:l021","ordinal":58913,"en":"Chubak, son of Akbaltay—"},{"id":"manas-2010:p1362:b001:l022","ordinal":58914,"en":"Before the many champions could take Zholoy"},{"id":"manas-2010:p1362:b001:l023","ordinal":58915,"en":"Safely away,"},{"id":"manas-2010:p1362:b001:l024","ordinal":58916,"en":"Warrior Chubak arrived."},{"id":"manas-2010:p1362:b001:l025","ordinal":58917,"en":"Of Zholoy, khan of the Kalmyks,"},{"id":"manas-2010:p1362:b001:l026","ordinal":58918,"en":"The instant hero Chubak reached him,"},{"id":"manas-2010:p1362:b001:l027","ordinal":58919,"en":"He cut off the head as he passed."},{"id":"manas-2010:p1362:b001:l028","ordinal":58920,"en":"Golden forelock and tasselled belt—"},{"id":"manas-2010:p1362:b001:l029","ordinal":58921,"en":"Azizkhan's only son"},{"id":"manas-2010:p1362:b001:l030","ordinal":58922,"en":"Went on destroying without mercy."},{"id":"manas-2010:p1362:b001:l031","ordinal":58923,"en":"Hero-born Almambet,"},{"id":"manas-2010:p1362:b001:l032","ordinal":58924,"en":"Galloping on Sarala,"},{"id":"manas-2010:p1362:b001:l033","ordinal":58925,"en":"Six thousand Chinese, a thousand governors—"},{"id":"manas-2010:p1362:b001:l034","ordinal":58926,"en":"Among those governors,"},{"id":"manas-2010:p1362:b001:l035","ordinal":58927,"en":"A great governor named Temirkol—"},{"id":"manas-2010:p1362:b001:l036","ordinal":58928,"en":"He reached that great governor."},{"id":"manas-2010:p1362:b001:l037","ordinal":58929,"en":"Choosing the largest, Almambet,"},{"id":"manas-2010:p1362:b001:l038","ordinal":58930,"en":"The instant he reached them, seven"},{"id":"manas-2010:p1362:b001:l039","ordinal":58931,"en":"He flung down as he passed."},{"id":"manas-2010:p1362:b001:l040","ordinal":58932,"en":"If you looked at that moment—"},{"id":"manas-2010:p1362:b001:l041","ordinal":58933,"en":"The black felt hat's brim,"},{"id":"manas-2010:p1362:b001:l042","ordinal":58934,"en":"No one knew from where he had arrived,"},{"id":"manas-2010:p1363:b001:l001","ordinal":58935,"en":"Khan Manas's Syrgak!"},{"id":"manas-2010:p1363:b001:l002","ordinal":58936,"en":"The seven fallen governors,"},{"id":"manas-2010:p1363:b001:l003","ordinal":58937,"en":"With Temirkol first,"},{"id":"manas-2010:p1363:b001:l004","ordinal":58938,"en":"He beheaded as he passed."},{"id":"manas-2010:p1363:b001:l005","ordinal":58939,"en":"Azizkhan's Almambet,"},{"id":"manas-2010:p1363:b001:l006","ordinal":58940,"en":"Galloping farther beyond,"},{"id":"manas-2010:p1363:b001:l007","ordinal":58941,"en":"Dark in the mist, jutting at the corners,"},{"id":"manas-2010:p1363:b001:l008","ordinal":58942,"en":"Hazy and pointed at its edges—"},{"id":"manas-2010:p1363:b001:l009","ordinal":58943,"en":"That was the place called It-Ötpös."},{"id":"manas-2010:p1363:b001:l010","ordinal":58944,"en":"Throughout It-Ötpös,"},{"id":"manas-2010:p1363:b001:l011","ordinal":58945,"en":"Swarming like ants,"},{"id":"manas-2010:p1363:b001:l012","ordinal":58946,"en":"That was the Chinese multitude."},{"id":"manas-2010:p1363:b001:l013","ordinal":58947,"en":"Splitting them apart, Almambet,"},{"id":"manas-2010:p1363:b001:l014","ordinal":58948,"en":"That was where he entered again."},{"id":"manas-2010:p1363:b001:l015","ordinal":58949,"en":"The Iron Giant and Kanzharkol,"},{"id":"manas-2010:p1363:b001:l016","ordinal":58950,"en":"Surrounding your Almam,"},{"id":"manas-2010:p1363:b001:l017","ordinal":58951,"en":"That was where they swept upon him."},{"id":"manas-2010:p1363:b001:l018","ordinal":58952,"en":"He would not yield to their onslaught,"},{"id":"manas-2010:p1363:b001:l019","ordinal":58953,"en":"Their red lance, their banner."},{"id":"manas-2010:p1363:b001:l020","ordinal":58954,"en":"He did not turn his head then,"},{"id":"manas-2010:p1363:b001:l021","ordinal":58955,"en":"When the Chinese came pressing,"},{"id":"manas-2010:p1363:b001:l022","ordinal":58956,"en":"That champion Almambet."},{"id":"manas-2010:p1363:b001:l023","ordinal":58957,"en":"Serek and Syrgak,"},{"id":"manas-2010:p1363:b001:l024","ordinal":58958,"en":"Old Kyrgyl and Chubak—"},{"id":"manas-2010:p1363:b001:l025","ordinal":58959,"en":"Delightful world, may you come to ruin!"},{"id":"manas-2010:p1363:b001:l026","ordinal":58960,"en":"It was their hour to die."},{"id":"manas-2010:p1363:b001:l027","ordinal":58961,"en":"Azizkhan's Almambet"},{"id":"manas-2010:p1363:b001:l028","ordinal":58962,"en":"Reached Orokkyr."},{"id":"manas-2010:p1363:b001:l029","ordinal":58963,"en":"That champion Orokkyr,"},{"id":"manas-2010:p1363:b001:l030","ordinal":58964,"en":"From horseback, his huge body sprawling,"},{"id":"manas-2010:p1363:b001:l031","ordinal":58965,"en":"He hurled down as he passed."},{"id":"manas-2010:p1363:b001:l032","ordinal":58966,"en":"Chubak, son of Akbaltay,"},{"id":"manas-2010:p1363:b001:l033","ordinal":58967,"en":"Who made the whole world cry out,"},{"id":"manas-2010:p1363:b001:l034","ordinal":58968,"en":"That keen warrior unlike other men,"},{"id":"manas-2010:p1363:b001:l035","ordinal":58969,"en":"Your keen champion Chubak,"},{"id":"manas-2010:p1363:b001:l036","ordinal":58970,"en":"Before he reached Orokkyr—"},{"id":"manas-2010:p1363:b001:l037","ordinal":58971,"en":"Cotton belt and broad boots—"},{"id":"manas-2010:p1363:b001:l038","ordinal":58972,"en":"Kongurbay, khan of the shaven-headed ones,"},{"id":"manas-2010:p1363:b001:l039","ordinal":58973,"en":"As your towering champion Chubak"},{"id":"manas-2010:p1363:b001:l040","ordinal":58974,"en":"Bent down to cut off his head,"},{"id":"manas-2010:p1363:b001:l041","ordinal":58975,"en":"Came up from the flank."},{"id":"manas-2010:p1363:b001:l042","ordinal":58976,"en":"Chubak, son of Khan Baltay,"},{"id":"manas-2010:p1364:b001:l001","ordinal":58977,"en":"From the back of Kögala"},{"id":"manas-2010:p1364:b001:l002","ordinal":58978,"en":"He hurled down as he passed."},{"id":"manas-2010:p1364:b001:l003","ordinal":58979,"en":"All the Chinese gathered;"},{"id":"manas-2010:p1364:b001:l004","ordinal":58980,"en":"Their champion Orokbash"},{"id":"manas-2010:p1364:b001:l005","ordinal":58981,"en":"They surrounded."},{"id":"manas-2010:p1364:b001:l006","ordinal":58982,"en":"For Chubak, son of Akbaltay,"},{"id":"manas-2010:p1364:b001:l007","ordinal":58983,"en":"Fortunate Bakay and Almambet,"},{"id":"manas-2010:p1364:b001:l008","ordinal":58984,"en":"All of them at the fore,"},{"id":"manas-2010:p1364:b001:l009","ordinal":58985,"en":"Were thrown into urgent distress."},{"id":"manas-2010:p1364:b001:l010","ordinal":58986,"en":"Agayar, who could lift a camel,"},{"id":"manas-2010:p1364:b001:l011","ordinal":58987,"en":"A warrior of Lord Manas,"},{"id":"manas-2010:p1364:b001:l012","ordinal":58988,"en":"From amid the thick embers,"},{"id":"manas-2010:p1364:b001:l013","ordinal":58989,"en":"Snatching Chubak away,"},{"id":"manas-2010:p1364:b001:l014","ordinal":58990,"en":"Onto Kögala's back"},{"id":"manas-2010:p1364:b001:l015","ordinal":58991,"en":"Lifted him and set him down."},{"id":"manas-2010:p1364:b001:l016","ordinal":58992,"en":"Mule-riding Koyonboz"},{"id":"manas-2010:p1364:b001:l017","ordinal":58993,"en":"Was a khan of the Chinese."},{"id":"manas-2010:p1364:b001:l018","ordinal":58994,"en":"When a dark day fell upon them,"},{"id":"manas-2010:p1364:b001:l019","ordinal":58995,"en":"He was the life of the Chinese."},{"id":"manas-2010:p1364:b001:l020","ordinal":58996,"en":"All the heroes"},{"id":"manas-2010:p1364:b001:l021","ordinal":58997,"en":"Met and grappled,"},{"id":"manas-2010:p1364:b001:l022","ordinal":58998,"en":"Thrusting in turns,"},{"id":"manas-2010:p1364:b001:l023","ordinal":58999,"en":"Fighting with lances."},{"id":"manas-2010:p1364:b001:l024","ordinal":59000,"en":"Their points broke and scattered;"},{"id":"manas-2010:p1364:b001:l025","ordinal":59001,"en":"The shafts remained in their hands."},{"id":"manas-2010:p1364:b001:l026","ordinal":59002,"en":"They struck with swords,"},{"id":"manas-2010:p1364:b001:l027","ordinal":59003,"en":"They fought with battle-axes."},{"id":"manas-2010:p1364:b001:l028","ordinal":59004,"en":"The points broke and scattered;"},{"id":"manas-2010:p1364:b001:l029","ordinal":59005,"en":"The handles remained in their hands."},{"id":"manas-2010:p1364:b001:l030","ordinal":59006,"en":"They struck with swords;"},{"id":"manas-2010:p1364:b001:l031","ordinal":59007,"en":"The sheaths remained in their hands."},{"id":"manas-2010:p1364:b001:l032","ordinal":59008,"en":"They fired muskets,"},{"id":"manas-2010:p1364:b001:l033","ordinal":59009,"en":"Drawing their bows to shoot,"},{"id":"manas-2010:p1364:b001:l034","ordinal":59010,"en":"Until their ammunition ran out."},{"id":"manas-2010:p1364:b001:l035","ordinal":59011,"en":"After their ammunition was gone,"},{"id":"manas-2010:p1364:b001:l036","ordinal":59012,"en":"They wrenched and heaved at one another."},{"id":"manas-2010:p1364:b001:l037","ordinal":59013,"en":"No clothes remained upon them;"},{"id":"manas-2010:p1364:b001:l038","ordinal":59014,"en":"They shook each other on horseback."},{"id":"manas-2010:p1364:b001:l039","ordinal":59015,"en":"Again and again they moved,"},{"id":"manas-2010:p1364:b001:l040","ordinal":59016,"en":"Charging into one another."},{"id":"manas-2010:p1364:b001:l041","ordinal":59017,"en":"Their dear lives were hard pressed;"},{"id":"manas-2010:p1364:b001:l042","ordinal":59018,"en":"They swayed upon their horses."},{"id":"manas-2010:p1365:b001:l001","ordinal":59019,"en":"They stood losing consciousness;"},{"id":"manas-2010:p1365:b001:l002","ordinal":59020,"en":"Blood flowed in a red river."},{"id":"manas-2010:p1365:b001:l003","ordinal":59021,"en":"The Chinese and the Kyrgyz"},{"id":"manas-2010:p1365:b001:l004","ordinal":59022,"en":"Waged a slaughtering battle."},{"id":"manas-2010:p1365:b001:l005","ordinal":59023,"en":"Not sparing their threadlike lives,"},{"id":"manas-2010:p1365:b001:l006","ordinal":59024,"en":"They fought with terrible force."},{"id":"manas-2010:p1365:b001:l007","ordinal":59025,"en":"Their mighty hero Kongurbay"},{"id":"manas-2010:p1365:b001:l008","ordinal":59026,"en":"Drew onto a ridge and braced himself."},{"id":"manas-2010:p1365:b001:l009","ordinal":59027,"en":"Unable to contain his fury,"},{"id":"manas-2010:p1365:b001:l010","ordinal":59028,"en":"Unable to find the smallest stratagem,"},{"id":"manas-2010:p1365:b001:l011","ordinal":59029,"en":"“Syrgak of the Buruts—"},{"id":"manas-2010:p1365:b001:l012","ordinal":59030,"en":"Why, he is still alive!"},{"id":"manas-2010:p1365:b001:l013","ordinal":59031,"en":"I thought him dead, but he lives;"},{"id":"manas-2010:p1365:b001:l014","ordinal":59032,"en":"He is one of those who cannot die."},{"id":"manas-2010:p1365:b001:l015","ordinal":59033,"en":"Were he not a Burut,"},{"id":"manas-2010:p1365:b001:l016","ordinal":59034,"en":"He would be a hero among mankind!”"},{"id":"manas-2010:p1365:b001:l017","ordinal":59035,"en":"Thinking out a plan, before Syrgak"},{"id":"manas-2010:p1365:b001:l018","ordinal":59036,"en":"Kongurbay appeared."},{"id":"manas-2010:p1365:b001:l019","ordinal":59037,"en":"“This time, from Syrgak"},{"id":"manas-2010:p1365:b001:l020","ordinal":59038,"en":"Let me pretend to flee."},{"id":"manas-2010:p1365:b001:l021","ordinal":59039,"en":"To the great pit already dug,"},{"id":"manas-2010:p1365:b001:l022","ordinal":59040,"en":"Let me lure him along,"},{"id":"manas-2010:p1365:b001:l023","ordinal":59041,"en":"And headstrong Syrgak"},{"id":"manas-2010:p1365:b001:l024","ordinal":59042,"en":"Let me cast into that pit."},{"id":"manas-2010:p1365:b001:l025","ordinal":59043,"en":"When Syrgak falls into the pit,"},{"id":"manas-2010:p1365:b001:l026","ordinal":59044,"en":"I shall put him beneath the stones!”"},{"id":"manas-2010:p1365:b001:l027","ordinal":59045,"en":"Thinking this, he pretended to flee;"},{"id":"manas-2010:p1365:b001:l028","ordinal":59046,"en":"He wheeled and darted aside."},{"id":"manas-2010:p1365:b001:l029","ordinal":59047,"en":"To deceive him, Kongurbay"},{"id":"manas-2010:p1365:b001:l030","ordinal":59048,"en":"Flashed away on Algara."},{"id":"manas-2010:p1365:b001:l031","ordinal":59049,"en":"Dark in the mist, jutting at the corners,"},{"id":"manas-2010:p1365:b001:l032","ordinal":59050,"en":"Hazy and pointed at its edges—"},{"id":"manas-2010:p1365:b001:l033","ordinal":59051,"en":"That was the land of Outer Beijing."},{"id":"manas-2010:p1365:b001:l034","ordinal":59052,"en":"Made as high as a cliff,"},{"id":"manas-2010:p1365:b001:l035","ordinal":59053,"en":"That was the barrier they had built."},{"id":"manas-2010:p1365:b001:l036","ordinal":59054,"en":"If you looked at that barrier,"},{"id":"manas-2010:p1365:b001:l037","ordinal":59055,"en":"They had built it all around;"},{"id":"manas-2010:p1365:b001:l038","ordinal":59056,"en":"That was the land of the Chinese multitude."},{"id":"manas-2010:p1365:b001:l039","ordinal":59057,"en":"To trap him against it,"},{"id":"manas-2010:p1365:b001:l040","ordinal":59058,"en":"Kongurbay fled away."},{"id":"manas-2010:p1365:b001:l041","ordinal":59059,"en":"Hero Syrgak, burning within,"},{"id":"manas-2010:p1365:b001:l042","ordinal":59060,"en":"When Kongurbay fled,"},{"id":"manas-2010:p1366:b001:l001","ordinal":59061,"en":"Without looking ahead or behind,"},{"id":"manas-2010:p1366:b001:l002","ordinal":59062,"en":"Without asking, “What may lie ahead?”"},{"id":"manas-2010:p1366:b001:l003","ordinal":59063,"en":"Without thinking it through wisely,"},{"id":"manas-2010:p1366:b001:l004","ordinal":59064,"en":"Hero Syrgak pursued him,"},{"id":"manas-2010:p1366:b001:l005","ordinal":59065,"en":"Now sparing none of his strength."},{"id":"manas-2010:p1366:b001:l006","ordinal":59066,"en":"The wretch Fierce One fled in earnest,"},{"id":"manas-2010:p1366:b001:l007","ordinal":59067,"en":"That scheming fellow, may he perish!"},{"id":"manas-2010:p1366:b001:l008","ordinal":59068,"en":"Unable to catch Kongurbay,"},{"id":"manas-2010:p1366:b001:l009","ordinal":59069,"en":"His two eyes becoming four,"},{"id":"manas-2010:p1366:b001:l010","ordinal":59070,"en":"“Let me seize him by his lowest hem!”"},{"id":"manas-2010:p1366:b001:l011","ordinal":59071,"en":"Syrgak went on, blazing with fury."},{"id":"manas-2010:p1366:b001:l012","ordinal":59072,"en":"Kongurbay, son of Alöökö,"},{"id":"manas-2010:p1366:b001:l013","ordinal":59073,"en":"When he drew near the pit,"},{"id":"manas-2010:p1366:b001:l014","ordinal":59074,"en":"When Syrgak came pursuing,"},{"id":"manas-2010:p1366:b001:l015","ordinal":59075,"en":"Azizkhan's Almambet"},{"id":"manas-2010:p1366:b001:l016","ordinal":59076,"en":"Caught up, chasing from behind."},{"id":"manas-2010:p1366:b001:l017","ordinal":59077,"en":"The instant he reached Syrgak,"},{"id":"manas-2010:p1366:b001:l018","ordinal":59078,"en":"He took the lead-rein and turned,"},{"id":"manas-2010:p1366:b001:l019","ordinal":59079,"en":"Leading Syrgak away."},{"id":"manas-2010:p1366:b001:l020","ordinal":59080,"en":"Keeping Syrgak beside him,"},{"id":"manas-2010:p1366:b001:l021","ordinal":59081,"en":"Hero Almambet said this:"},{"id":"manas-2010:p1366:b001:l022","ordinal":59082,"en":"“Your fleeing foe Kongurbay,"},{"id":"manas-2010:p1366:b001:l023","ordinal":59083,"en":"That infidel has mighty stratagems!"},{"id":"manas-2010:p1366:b001:l024","ordinal":59084,"en":"Is he not pretending to flee?"},{"id":"manas-2010:p1366:b001:l025","ordinal":59085,"en":"Trapping you against his dug pit,"},{"id":"manas-2010:p1366:b001:l026","ordinal":59086,"en":"Your soul, carried away with zeal,"},{"id":"manas-2010:p1366:b001:l027","ordinal":59087,"en":"Will he not bring to disaster?"},{"id":"manas-2010:p1366:b001:l028","ordinal":59088,"en":"Kongurbay of the dark faith—"},{"id":"manas-2010:p1366:b001:l029","ordinal":59089,"en":"Will God not strike the faithless one?"},{"id":"manas-2010:p1366:b001:l030","ordinal":59090,"en":"If you fall into the Fierce One's hands,"},{"id":"manas-2010:p1366:b001:l031","ordinal":59091,"en":"Making your soul shriek,"},{"id":"manas-2010:p1366:b001:l032","ordinal":59092,"en":"Will he not slaughter you like a fly?”"},{"id":"manas-2010:p1366:b001:l033","ordinal":59093,"en":"Saying this, Syrgak"},{"id":"manas-2010:p1366:b001:l034","ordinal":59094,"en":"Almambet led away."},{"id":"manas-2010:p1366:b001:l035","ordinal":59095,"en":"When they turned back,"},{"id":"manas-2010:p1366:b001:l036","ordinal":59096,"en":"Look at the misty dust!"},{"id":"manas-2010:p1366:b001:l037","ordinal":59097,"en":"Fighting with thudding blows,"},{"id":"manas-2010:p1366:b001:l038","ordinal":59098,"en":"Look at the people dying!"},{"id":"manas-2010:p1366:b001:l039","ordinal":59099,"en":"Fighting fiercely in earnest,"},{"id":"manas-2010:p1366:b001:l040","ordinal":59100,"en":"Heaving upon his bull,"},{"id":"manas-2010:p1366:b001:l041","ordinal":59101,"en":"Look at that giant Madykan!"},{"id":"manas-2010:p1366:b001:l042","ordinal":59102,"en":"Making his bull prance,"},{"id":"manas-2010:p1367:b001:l001","ordinal":59103,"en":"Felling everyone he encountered,"},{"id":"manas-2010:p1367:b001:l002","ordinal":59104,"en":"Making them mottled red with blood,"},{"id":"manas-2010:p1367:b001:l003","ordinal":59105,"en":"He went on slaughtering and smashing."},{"id":"manas-2010:p1367:b001:l004","ordinal":59106,"en":"Blood sprang forth wherever he went;"},{"id":"manas-2010:p1367:b001:l005","ordinal":59107,"en":"Lives departed at his very voice."},{"id":"manas-2010:p1367:b001:l006","ordinal":59108,"en":"Mule-riding Koyonboz,"},{"id":"manas-2010:p1367:b001:l007","ordinal":59109,"en":"The endless multitude of Chinese,"},{"id":"manas-2010:p1367:b001:l008","ordinal":59110,"en":"All had joined him as companions."},{"id":"manas-2010:p1367:b001:l009","ordinal":59111,"en":"Madykan of the Chinese,"},{"id":"manas-2010:p1367:b001:l010","ordinal":59112,"en":"Laying low everyone he encountered,"},{"id":"manas-2010:p1367:b001:l011","ordinal":59113,"en":"Without looking back, surging forward,"},{"id":"manas-2010:p1367:b001:l012","ordinal":59114,"en":"Eleman's youngest son,"},{"id":"manas-2010:p1367:b001:l013","ordinal":59115,"en":"Hero Töshtük, he reached."},{"id":"manas-2010:p1367:b001:l014","ordinal":59116,"en":"From the back of Chalkuyruk"},{"id":"manas-2010:p1367:b001:l015","ordinal":59117,"en":"He hurled him down as he passed."},{"id":"manas-2010:p1367:b001:l016","ordinal":59118,"en":"Mule-riding Koyonboz"},{"id":"manas-2010:p1367:b001:l017","ordinal":59119,"en":"Charged in, that daughter-seller,"},{"id":"manas-2010:p1367:b001:l018","ordinal":59120,"en":"To cut off Töshtük's head."},{"id":"manas-2010:p1367:b001:l019","ordinal":59121,"en":"Before Koyonboz could reach him,"},{"id":"manas-2010:p1367:b001:l020","ordinal":59122,"en":"Your leopard, hero Manas,"},{"id":"manas-2010:p1367:b001:l021","ordinal":59123,"en":"From the back of his mule,"},{"id":"manas-2010:p1367:b001:l022","ordinal":59124,"en":"That champion Koyonboz"},{"id":"manas-2010:p1367:b001:l023","ordinal":59125,"en":"Thrust down as he passed."},{"id":"manas-2010:p1367:b001:l024","ordinal":59126,"en":"Then your mighty Bakay,"},{"id":"manas-2010:p1367:b001:l025","ordinal":59127,"en":"Of that champion Koyonboz,"},{"id":"manas-2010:p1367:b001:l026","ordinal":59128,"en":"(Before other Chinese could reach him)"},{"id":"manas-2010:p1367:b001:l027","ordinal":59129,"en":"Cut off the head as he passed."},{"id":"manas-2010:p1367:b001:l028","ordinal":59130,"en":"The mighty khan of the Chinese"},{"id":"manas-2010:p1367:b001:l029","ordinal":59131,"en":"At the hands of Manas and Bakay"},{"id":"manas-2010:p1367:b001:l030","ordinal":59132,"en":"Met his death."},{"id":"manas-2010:p1367:b001:l031","ordinal":59133,"en":"To Töshtük, left on foot,"},{"id":"manas-2010:p1367:b001:l032","ordinal":59134,"en":"Akbaltay's keen warrior,"},{"id":"manas-2010:p1367:b001:l033","ordinal":59135,"en":"Lion Chubak, arrived."},{"id":"manas-2010:p1367:b001:l034","ordinal":59136,"en":"Reaching him, he set him on a horse"}]
