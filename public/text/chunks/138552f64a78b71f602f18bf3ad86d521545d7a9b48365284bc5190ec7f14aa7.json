[{"id":"semetey-1-2013:p0677:b003:l001","ordinal":128257,"en":"Toppled and demolished its buildings,"},{"id":"semetey-1-2013:p0677:b003:l002","ordinal":128258,"en":"Left it utterly flat,"},{"id":"semetey-1-2013:p0677:b003:l003","ordinal":128259,"en":"Thus brought it to its end."},{"id":"semetey-1-2013:p0677:b003:l004","ordinal":128260,"en":"They settled along the valley."},{"id":"semetey-1-2013:p0677:b003:l005","ordinal":128261,"en":"When the blood-shedder passed away,"},{"id":"semetey-1-2013:p0677:b003:l006","ordinal":128262,"en":"Damn it, the desolate palace"},{"id":"semetey-1-2013:p0677:b003:l007","ordinal":128263,"en":"Was like a fire gone out."},{"id":"semetey-1-2013:p0677:b003:l008","ordinal":128264,"en":"They did their villainy—"},{"id":"semetey-1-2013:p0677:b003:l009","ordinal":128265,"en":"Abyke, Kobosh, the six scoundrels"},{"id":"semetey-1-2013:p0677:b003:l010","ordinal":128266,"en":"Took their revenge upon the palace.\""},{"id":"semetey-1-2013:p0677:b003:l011","ordinal":128267,"en":"Seeing this, mighty Bakay,"},{"id":"semetey-1-2013:p0677:b003:l012","ordinal":128268,"en":"His two eyes darting wildly,"},{"id":"semetey-1-2013:p0677:b003:l013","ordinal":128269,"en":"Swooned and hung limp."},{"id":"semetey-1-2013:p0677:b003:l014","ordinal":128270,"en":"The land left by his father—"},{"id":"semetey-1-2013:p0677:b003:l015","ordinal":128271,"en":"Showing the way, gathering an army,"},{"id":"semetey-1-2013:p0677:b003:l016","ordinal":128272,"en":"Crying, \"My tiger Manas, why did you die?\""},{"id":"semetey-1-2013:p0677:b003:l017","ordinal":128273,"en":"Your uncle Bakay of many deeds"},{"id":"semetey-1-2013:p0677:b003:l018","ordinal":128274,"en":"Let out a ringing wail."},{"id":"semetey-1-2013:p0677:b003:l020","ordinal":128275,"en":"His heart was heavy with grief,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0677:b003:l021","ordinal":128276,"en":"He raised his voice and moaned."},{"id":"semetey-1-2013:p0677:b003:l022","ordinal":128277,"en":"Holy Bakay, the precious lion,"},{"id":"semetey-1-2013:p0677:b003:l023","ordinal":128278,"en":"Then broke into ringing sobs."},{"id":"semetey-1-2013:p0677:b003:l024","ordinal":128279,"en":"If you ask of his former days,"},{"id":"semetey-1-2013:p0677:b003:l025","ordinal":128280,"en":"He was known as Bakay the hero."},{"id":"semetey-1-2013:p0677:b003:l026","ordinal":128281,"en":"His black eyes, like a saker falcon's,"},{"id":"semetey-1-2013:p0677:b003:l027","ordinal":128282,"en":"Filled with tears without blinking."},{"id":"semetey-1-2013:p0677:b003:l028","ordinal":128283,"en":"\"All your world was left in disgrace."},{"id":"semetey-1-2013:p0677:b003:l029","ordinal":128284,"en":"You who pledged allegiance to twelve spiritual masters,"},{"id":"semetey-1-2013:p0677:b003:l030","ordinal":128285,"en":"My holy Manas, take me with you!"},{"id":"semetey-1-2013:p0677:b003:l031","ordinal":128286,"en":"Alas, Manas, why did you die?"},{"id":"semetey-1-2013:p0677:b003:l032","ordinal":128287,"en":"Why must Bakay suffer such humiliation?"},{"id":"semetey-1-2013:p0677:b003:l033","ordinal":128288,"en":"If God creates a living soul,"},{"id":"semetey-1-2013:p0677:b003:l034","ordinal":128289,"en":"May such a calamity"},{"id":"semetey-1-2013:p0677:b003:l035","ordinal":128290,"en":"Never be given to His mortal creature!"},{"id":"semetey-1-2013:p0677:b003:l036","ordinal":128291,"en":"My dear orphan,"},{"id":"semetey-1-2013:p0677:b003:l037","ordinal":128292,"en":"Your father Manas was a lion,"},{"id":"semetey-1-2013:p0677:b003:l038","ordinal":128293,"en":"Who threw the whole world into turmoil,"},{"id":"semetey-1-2013:p0677:b003:l039","ordinal":128294,"en":"A lion born above the rest."},{"id":"semetey-1-2013:p0677:b004:l001","ordinal":128295,"en":"A mortal like your father—"},{"id":"semetey-1-2013:p0677:b004:l002","ordinal":128296,"en":"The one God, creator of life,"},{"id":"semetey-1-2013:p0677:b004:l003","ordinal":128297,"en":"Will surely not grant another soon."},{"id":"semetey-1-2013:p0677:b004:l004","ordinal":128298,"en":"Before Mecca,"},{"id":"semetey-1-2013:p0677:b004:l005","ordinal":128299,"en":"Your khan father was its support."},{"id":"semetey-1-2013:p0677:b004:l006","ordinal":128300,"en":"Islam stretched far and still—"},{"id":"semetey-1-2013:p0677:b004:l007","ordinal":128301,"en":"That was your khan father's land."},{"id":"semetey-1-2013:p0677:b004:l008","ordinal":128302,"en":"Your father Manas, bringer of good fortune,"},{"id":"semetey-1-2013:p0677:b004:l009","ordinal":128303,"en":"Was a mighty heroic support."},{"id":"semetey-1-2013:p0677:b004:l010","ordinal":128304,"en":"A mortal like your father,"},{"id":"semetey-1-2013:p0677:b004:l011","ordinal":128305,"en":"Our Almighty Allah, the Creator,"},{"id":"semetey-1-2013:p0677:b004:l012","ordinal":128306,"en":"Will surely not grant another soon."},{"id":"semetey-1-2013:p0677:b004:l013","ordinal":128307,"en":"Your father Manas, the fierce-maned khan,"},{"id":"semetey-1-2013:p0677:b004:l014","ordinal":128308,"en":"Was born in Altay and rose from there."},{"id":"semetey-1-2013:p0677:b004:l015","ordinal":128309,"en":"The Forty Saints, Kyzyr and Ilyas—"},{"id":"semetey-1-2013:p0677:b004:l016","ordinal":128310,"en":"Forty-two were his companions on the road."},{"id":"semetey-1-2013:p0677:b004:l017","ordinal":128311,"en":"The Almighty Creator put his affairs right,"},{"id":"semetey-1-2013:p0677:b004:l018","ordinal":128312,"en":"Bare-bodied Kydyr gave him support."},{"id":"semetey-1-2013:p0677:b004:l019","ordinal":128313,"en":"Your fierce-maned father—"},{"id":"semetey-1-2013:p0677:b004:l020","ordinal":128314,"en":"None who faced him survived."},{"id":"semetey-1-2013:p0677:b004:l021","ordinal":128315,"en":"When your father Manas lived,"},{"id":"semetey-1-2013:p0677:b004:l022","ordinal":128316,"en":"Five spiritual masters came from Mecca,"},{"id":"semetey-1-2013:p0677:b004:l024","ordinal":128317,"en":"Your father, the renowned one,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0677:b004:l025","ordinal":128318,"en":"Made the enemies he faced crawl."},{"id":"semetey-1-2013:p0677:b004:l026","ordinal":128319,"en":"When he reached twelve,"},{"id":"semetey-1-2013:p0677:b004:l027","ordinal":128320,"en":"He raided a khan's seat and took spoils."},{"id":"semetey-1-2013:p0677:b004:l028","ordinal":128321,"en":"Throughout the whole wide world"},{"id":"semetey-1-2013:p0677:b004:l029","ordinal":128322,"en":"Your father Manas stirred up strife."},{"id":"semetey-1-2013:p0677:b004:l030","ordinal":128323,"en":"When your father mounted Akkula,"},{"id":"semetey-1-2013:p0677:b004:l031","ordinal":128324,"en":"When he donned Akolpok,"},{"id":"semetey-1-2013:p0677:b004:l032","ordinal":128325,"en":"When he charged the foe with a shout,"},{"id":"semetey-1-2013:p0677:b004:l033","ordinal":128326,"en":"A black-spotted leopard"},{"id":"semetey-1-2013:p0677:b004:l034","ordinal":128327,"en":"Sprang at his flank,"},{"id":"semetey-1-2013:p0677:b004:l035","ordinal":128328,"en":"A short-tailed, dark-maned lion"},{"id":"semetey-1-2013:p0677:b004:l036","ordinal":128329,"en":"Ran beside him, ready for action."},{"id":"semetey-1-2013:p0677:b004:l037","ordinal":128330,"en":"Your father, fierce-maned Manas—"},{"id":"semetey-1-2013:p0677:b004:l038","ordinal":128331,"en":"If one looked at his front,"},{"id":"semetey-1-2013:p0677:b004:l039","ordinal":128332,"en":"He had the fearsome presence of six thousand warriors,"},{"id":"semetey-1-2013:p0678:b003:l001","ordinal":128333,"en":"If your father turned his back,"},{"id":"semetey-1-2013:p0678:b003:l002","ordinal":128334,"en":"He had the form of a dragon."},{"id":"semetey-1-2013:p0678:b003:l003","ordinal":128335,"en":"His face was like wheat browned in oil,"},{"id":"semetey-1-2013:p0678:b003:l004","ordinal":128336,"en":"His eyes were like mist at dusk."},{"id":"semetey-1-2013:p0678:b003:l005","ordinal":128337,"en":"Your generous father Manas—"},{"id":"semetey-1-2013:p0678:b003:l006","ordinal":128338,"en":"That was how he looked."},{"id":"semetey-1-2013:p0678:b003:l007","ordinal":128339,"en":"When your father Manas lived,"},{"id":"semetey-1-2013:p0678:b003:l008","ordinal":128340,"en":"Argyn and Kyrgyz mingled—"},{"id":"semetey-1-2013:p0678:b003:l009","ordinal":128341,"en":"That was how his people were."},{"id":"semetey-1-2013:p0678:b003:l010","ordinal":128342,"en":"When your father dwelt here,"},{"id":"semetey-1-2013:p0678:b003:l011","ordinal":128343,"en":"Famous Ken-Kol, broad Talas—"},{"id":"semetey-1-2013:p0678:b003:l012","ordinal":128344,"en":"That was how his land was."},{"id":"semetey-1-2013:p0678:b003:l013","ordinal":128345,"en":"Hill after hill comes into view,"},{"id":"semetey-1-2013:p0678:b003:l014","ordinal":128346,"en":"A rolling ridge with rugged passes."},{"id":"semetey-1-2013:p0678:b003:l015","ordinal":128347,"en":"From the hills the wild sheep pour,"},{"id":"semetey-1-2013:p0678:b003:l016","ordinal":128348,"en":"The grass upon the hills grows sparse."},{"id":"semetey-1-2013:p0678:b003:l017","ordinal":128349,"en":"Rugged ridge after ridge appears,"},{"id":"semetey-1-2013:p0678:b003:l018","ordinal":128350,"en":"A place called Budurmak appears."},{"id":"semetey-1-2013:p0678:b003:l019","ordinal":128351,"en":"From the rough heights the deer pour,"},{"id":"semetey-1-2013:p0678:b003:l020","ordinal":128352,"en":"The grass upon the heights grows sparse."},{"id":"semetey-1-2013:p0678:b003:l021","ordinal":128353,"en":"Talas, our precious land,"},{"id":"semetey-1-2013:p0678:b003:l022","ordinal":128354,"en":"Its people have vanished now;"},{"id":"semetey-1-2013:p0678:b003:l023","ordinal":128355,"en":"Now it lies alone."},{"id":"semetey-1-2013:p0678:b003:l024","ordinal":128356,"en":"When its image appears before my eyes,"},{"id":"semetey-1-2013:p0678:b003:l025","ordinal":128357,"en":"My tears pour down."},{"id":"semetey-1-2013:p0678:b003:l026","ordinal":128358,"en":"Bereft of its honored people,"},{"id":"semetey-1-2013:p0678:b003:l027","ordinal":128359,"en":"My dear Talas looks deserted."},{"id":"semetey-1-2013:p0678:b003:l029","ordinal":128360,"en":"Do not ask what Talas is like:"},{"id":"semetey-1-2013:p0678:b003:l030","ordinal":128361,"en":"Its springs brim and overflow,"},{"id":"semetey-1-2013:p0678:b003:l031","ordinal":128362,"en":"The nightingale sings sorrowfully."},{"id":"semetey-1-2013:p0678:b003:l032","ordinal":128363,"en":"No grieving person would listen;"},{"id":"semetey-1-2013:p0678:b003:l033","ordinal":128364,"en":"A mortal who turned to listen"},{"id":"semetey-1-2013:p0678:b003:l034","ordinal":128365,"en":"Would not step a handspan out of it."},{"id":"semetey-1-2013:p0678:b003:l035","ordinal":128366,"en":"This is sorrowful Talas,"},{"id":"semetey-1-2013:p0678:b003:l036","ordinal":128367,"en":"I am Bakay of these accursed days."},{"id":"semetey-1-2013:p0678:b003:l037","ordinal":128368,"en":"When its cuckoo sings from a willow,"},{"id":"semetey-1-2013:p0678:b003:l038","ordinal":128369,"en":"A grieving mortal cannot bear to listen."},{"id":"semetey-1-2013:p0678:b003:l039","ordinal":128370,"en":"A mortal who turned to listen,"},{"id":"semetey-1-2013:p0678:b004:l001","ordinal":128371,"en":"At this cuckoo's voice,"},{"id":"semetey-1-2013:p0678:b004:l002","ordinal":128372,"en":"Could not turn and walk away."},{"id":"semetey-1-2013:p0678:b004:l003","ordinal":128373,"en":"Do not ask what Talas is like:"},{"id":"semetey-1-2013:p0678:b004:l004","ordinal":128374,"en":"Its mountains have snow,"},{"id":"semetey-1-2013:p0678:b004:l005","ordinal":128375,"en":"Its forests have rooks,"},{"id":"semetey-1-2013:p0678:b004:l006","ordinal":128376,"en":"Its hills have wild sheep,"},{"id":"semetey-1-2013:p0678:b004:l007","ordinal":128377,"en":"Its rugged heights have deer,"},{"id":"semetey-1-2013:p0678:b004:l008","ordinal":128378,"en":"Its terraces have ibex,"},{"id":"semetey-1-2013:p0678:b004:l009","ordinal":128379,"en":"Its plains have wild asses,"},{"id":"semetey-1-2013:p0678:b004:l010","ordinal":128380,"en":"Its hollows have hares,"},{"id":"semetey-1-2013:p0678:b004:l011","ordinal":128381,"en":"Its depressions have snakes."},{"id":"semetey-1-2013:p0678:b004:l012","ordinal":128382,"en":"It has separate little marshes,"},{"id":"semetey-1-2013:p0678:b004:l013","ordinal":128383,"en":"It has geese flying singly,"},{"id":"semetey-1-2013:p0678:b004:l014","ordinal":128384,"en":"Their slender tails swaying,"},{"id":"semetey-1-2013:p0678:b004:l015","ordinal":128385,"en":"Their red heads bobbing."},{"id":"semetey-1-2013:p0678:b004:l016","ordinal":128386,"en":"These creatures grew at liberty,"},{"id":"semetey-1-2013:p0678:b004:l017","ordinal":128387,"en":"Its snowcocks crying out."},{"id":"semetey-1-2013:p0678:b004:l018","ordinal":128388,"en":"Beside those snowcocks,"},{"id":"semetey-1-2013:p0678:b004:l019","ordinal":128389,"en":"Had they not grown freely,"},{"id":"semetey-1-2013:p0678:b004:l020","ordinal":128390,"en":"Its plane trees too broad to embrace?"},{"id":"semetey-1-2013:p0678:b004:l021","ordinal":128391,"en":"Never until death will it be quenched,"},{"id":"semetey-1-2013:p0678:b004:l022","ordinal":128392,"en":"Bakay Khan's longing."},{"id":"semetey-1-2013:p0678:b004:l023","ordinal":128393,"en":"Its apples ripened and turned to mulch,"},{"id":"semetey-1-2013:p0678:b004:l024","ordinal":128394,"en":"Its walnuts ripened and filled the ravine."},{"id":"semetey-1-2013:p0678:b004:l025","ordinal":128395,"en":"Such was your land of Talas."},{"id":"semetey-1-2013:p0678:b004:l026","ordinal":128396,"en":"Have you seen what Talas is like,"},{"id":"semetey-1-2013:p0678:b004:l027","ordinal":128397,"en":"My dear orphan?"},{"id":"semetey-1-2013:p0678:b004:l028","ordinal":128398,"en":"Its birds laid eggs in the birches,"},{"id":"semetey-1-2013:p0678:b004:l029","ordinal":128399,"en":"And stand ready to take flight."},{"id":"semetey-1-2013:p0678:b004:l031","ordinal":128400,"en":"They stir, ready to take flight.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0678:b004:l032","ordinal":128401,"en":"Your Manas died long ago,"},{"id":"semetey-1-2013:p0678:b004:l033","ordinal":128402,"en":"Your Talas was left deserted.\""},{"id":"semetey-1-2013:p0678:b004:l034","ordinal":128403,"en":"Meanwhile, as Bakay Khan"},{"id":"semetey-1-2013:p0678:b004:l035","ordinal":128404,"en":"Was showing him the land,"},{"id":"semetey-1-2013:p0678:b004:l036","ordinal":128405,"en":"Dusk fell and the sun set,"},{"id":"semetey-1-2013:p0678:b004:l037","ordinal":128406,"en":"Every living creature lay still."},{"id":"semetey-1-2013:p0678:b004:l038","ordinal":128407,"en":"Then Bakay Khan and Semetey,"},{"id":"semetey-1-2013:p0678:b004:l039","ordinal":128408,"en":"Taking the white saddle for a pillow,"},{"id":"semetey-1-2013:p0679:b003:l001","ordinal":128409,"en":"With their heads toward Mecca,"},{"id":"semetey-1-2013:p0679:b003:l002","ordinal":128410,"en":"The bulletproof battle-coat"},{"id":"semetey-1-2013:p0679:b003:l003","ordinal":128411,"en":"Laid against their hips,"},{"id":"semetey-1-2013:p0679:b003:l004","ordinal":128412,"en":"They prayed to the Creator."},{"id":"semetey-1-2013:p0679:b003:l005","ordinal":128413,"en":"Resting on their elbows, they slept,"},{"id":"semetey-1-2013:p0679:b003:l006","ordinal":128414,"en":"Dozing and taking their rest."},{"id":"semetey-1-2013:p0679:b003:l007","ordinal":128415,"en":"Old Bakay, the valiant one,"},{"id":"semetey-1-2013:p0679:b003:l008","ordinal":128416,"en":"And young Semetey, the leopard,"},{"id":"semetey-1-2013:p0679:b003:l009","ordinal":128417,"en":"Fell into a giant's sleep."},{"id":"semetey-1-2013:p0679:b003:l010","ordinal":128418,"en":"When he startled awake from sleep,"},{"id":"semetey-1-2013:p0679:b003:l011","ordinal":128419,"en":"And turned onto his right side,"},{"id":"semetey-1-2013:p0679:b003:l012","ordinal":128420,"en":"Stars from the sky, one by one,"},{"id":"semetey-1-2013:p0679:b003:l013","ordinal":128421,"en":"Quivered toward Mecca."},{"id":"semetey-1-2013:p0679:b003:l014","ordinal":128422,"en":"Stars broke away overhead,"},{"id":"semetey-1-2013:p0679:b003:l015","ordinal":128423,"en":"Spilling toward Mecca."},{"id":"semetey-1-2013:p0679:b003:l016","ordinal":128424,"en":"Behind the dawn a swelling rose,"},{"id":"semetey-1-2013:p0679:b003:l017","ordinal":128425,"en":"The dawn broke, rising in a mound,"},{"id":"semetey-1-2013:p0679:b003:l018","ordinal":128426,"en":"The dawn's bright splendor appeared,"},{"id":"semetey-1-2013:p0679:b003:l019","ordinal":128427,"en":"Light spilled over the earth."},{"id":"semetey-1-2013:p0679:b003:l020","ordinal":128428,"en":"The cold dawn wind whistled,"},{"id":"semetey-1-2013:p0679:b003:l021","ordinal":128429,"en":"The reed-tops rattled,"},{"id":"semetey-1-2013:p0679:b003:l022","ordinal":128430,"en":"Young larks chirped at daybreak."},{"id":"semetey-1-2013:p0679:b003:l024","ordinal":128431,"en":"When the bright dawn advanced,"},{"id":"semetey-1-2013:p0679:b003:l025","ordinal":128432,"en":"When light reached the earth,"},{"id":"semetey-1-2013:p0679:b003:l026","ordinal":128433,"en":"Semetey sprang to his feet."},{"id":"semetey-1-2013:p0679:b003:l027","ordinal":128434,"en":"It was the hollow of Zhylgynduu,"},{"id":"semetey-1-2013:p0679:b003:l028","ordinal":128435,"en":"Kanykey's Kotormo,"},{"id":"semetey-1-2013:p0679:b003:l029","ordinal":128436,"en":"It was beside Kotormo."},{"id":"semetey-1-2013:p0679:b003:l030","ordinal":128437,"en":"Your Talas was a wondrous land,"},{"id":"semetey-1-2013:p0679:b003:l031","ordinal":128438,"en":"Things without life and living creatures"},{"id":"semetey-1-2013:p0679:b003:l032","ordinal":128439,"en":"Were all left to themselves then."},{"id":"semetey-1-2013:p0679:b003:l033","ordinal":128440,"en":"We do not know for certain if it is true:"},{"id":"semetey-1-2013:p0679:b003:l034","ordinal":128441,"en":"Much is false, much is true,"},{"id":"semetey-1-2013:p0679:b003:l035","ordinal":128442,"en":"No one has been and seen it."},{"id":"semetey-1-2013:p0679:b003:l036","ordinal":128443,"en":"Half is false, half is true,"},{"id":"semetey-1-2013:p0679:b003:l037","ordinal":128444,"en":"No one has come from beside him."},{"id":"semetey-1-2013:p0679:b003:l038","ordinal":128445,"en":"Of the fierce-maned hero whose deeds were singular"},{"id":"semetey-1-2013:p0679:b003:l039","ordinal":128446,"en":"I tell a tale for entertainment,"},{"id":"semetey-1-2013:p0679:b004:l001","ordinal":128447,"en":"To recount his deeds."},{"id":"semetey-1-2013:p0679:b004:l002","ordinal":128448,"en":"At that time, your Talas—"},{"id":"semetey-1-2013:p0679:b004:l003","ordinal":128449,"en":"No people had settled there for twelve years,"},{"id":"semetey-1-2013:p0679:b004:l004","ordinal":128450,"en":"And Talas had been left deserted."},{"id":"semetey-1-2013:p0679:b004:l005","ordinal":128451,"en":"Stags, hinds and two-year-old colts—"},{"id":"semetey-1-2013:p0679:b004:l006","ordinal":128452,"en":"These had taken possession of it."},{"id":"semetey-1-2013:p0679:b004:l008","ordinal":128453,"en":"They trampled people to death,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0679:b004:l009","ordinal":128454,"en":"Its countless wild asses."},{"id":"semetey-1-2013:p0679:b004:l010","ordinal":128455,"en":"Of Talas left alone,"},{"id":"semetey-1-2013:p0679:b004:l011","ordinal":128456,"en":"What marvels shall we tell?"},{"id":"semetey-1-2013:p0679:b004:l012","ordinal":128457,"en":"Its twigs were like plane trees,"},{"id":"semetey-1-2013:p0679:b004:l013","ordinal":128458,"en":"Its plane trees were like towers,"},{"id":"semetey-1-2013:p0679:b004:l014","ordinal":128459,"en":"Its little birds were like snowcocks."},{"id":"semetey-1-2013:p0679:b004:l015","ordinal":128460,"en":"Seeing these, Semetey"},{"id":"semetey-1-2013:p0679:b004:l016","ordinal":128461,"en":"Now turned Aktulpar's head."},{"id":"semetey-1-2013:p0679:b004:l017","ordinal":128462,"en":"Manas's son, the valiant orphan,"},{"id":"semetey-1-2013:p0679:b004:l018","ordinal":128463,"en":"Now talked of what he saw."},{"id":"semetey-1-2013:p0679:b004:l019","ordinal":128464,"en":"There were plane trees like houses,"},{"id":"semetey-1-2013:p0679:b004:l020","ordinal":128465,"en":"All around the plane trees"},{"id":"semetey-1-2013:p0679:b004:l021","ordinal":128466,"en":"Hemlock grew thick as an arm."},{"id":"semetey-1-2013:p0679:b004:l022","ordinal":128467,"en":"When its hinds startled and dashed away,"},{"id":"semetey-1-2013:p0679:b004:l023","ordinal":128468,"en":"They were like dun cows with white blazes."},{"id":"semetey-1-2013:p0679:b004:l024","ordinal":128469,"en":"There was plentiful bistort,"},{"id":"semetey-1-2013:p0679:b004:l025","ordinal":128470,"en":"Its snowcocks cried in the mountains."},{"id":"semetey-1-2013:p0679:b004:l026","ordinal":128471,"en":"These were wondrous things,"},{"id":"semetey-1-2013:p0679:b004:l027","ordinal":128472,"en":"Its plane trees growing in varied forms."},{"id":"semetey-1-2013:p0679:b004:l028","ordinal":128473,"en":"Besides its plane trees, it had willows,"},{"id":"semetey-1-2013:p0679:b004:l029","ordinal":128474,"en":"It had every true delight."},{"id":"semetey-1-2013:p0679:b004:l030","ordinal":128475,"en":"It was a deserted land,"},{"id":"semetey-1-2013:p0679:b004:l032","ordinal":128476,"en":"It had willows growing on the plain,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0679:b004:l033","ordinal":128477,"en":"Still more delights were there."},{"id":"semetey-1-2013:p0679:b004:l034","ordinal":128478,"en":"Its willow-tops bent down,"},{"id":"semetey-1-2013:p0679:b004:l035","ordinal":128479,"en":"Drawing lines upon its sand."},{"id":"semetey-1-2013:p0679:b004:l036","ordinal":128480,"en":"Apples and apricots ripened and fell,"},{"id":"semetey-1-2013:p0679:b004:l037","ordinal":128481,"en":"An arshin deep by measure,"},{"id":"semetey-1-2013:p0679:b004:l038","ordinal":128482,"en":"Breaking down into dark compost."},{"id":"semetey-1-2013:p0679:b004:l039","ordinal":128483,"en":"Ah, dear living Talas,"},{"id":"semetey-1-2013:p0680:b003:l001","ordinal":128484,"en":"Was it not the choicest land?"},{"id":"semetey-1-2013:p0680:b003:l002","ordinal":128485,"en":"Would not the Kyrgyz who dwelt there prosper?"},{"id":"semetey-1-2013:p0680:b003:l003","ordinal":128486,"en":"The poor young orphan,"},{"id":"semetey-1-2013:p0680:b003:l004","ordinal":128487,"en":"Seeing his land, was filled with wonder."},{"id":"semetey-1-2013:p0680:b003:l005","ordinal":128488,"en":"Clear springs, a cool breeze—"},{"id":"semetey-1-2013:p0680:b003:l006","ordinal":128489,"en":"It was a land beside paradise,"},{"id":"semetey-1-2013:p0680:b003:l007","ordinal":128490,"en":"Abundance spilling from its ridges,"},{"id":"semetey-1-2013:p0680:b003:l008","ordinal":128491,"en":"Looking like paradise itself."},{"id":"semetey-1-2013:p0680:b003:l009","ordinal":128492,"en":"\"What a land broad Talas is!"},{"id":"semetey-1-2013:p0680:b003:l010","ordinal":128493,"en":"Who made Talas his home—"},{"id":"semetey-1-2013:p0680:b003:l011","ordinal":128494,"en":"What a hero my father was!"},{"id":"semetey-1-2013:p0680:b003:l012","ordinal":128495,"en":"That I was left fatherless"},{"id":"semetey-1-2013:p0680:b003:l013","ordinal":128496,"en":"Is a disgrace to anyone who knows."},{"id":"semetey-1-2013:p0680:b003:l014","ordinal":128497,"en":"Do not leave me with the name of orphan;"},{"id":"semetey-1-2013:p0680:b003:l015","ordinal":128498,"en":"My perfect father, take me with you!\""},{"id":"semetey-1-2013:p0680:b003:l016","ordinal":128499,"en":"Gripping his painted spear, he trembled."},{"id":"semetey-1-2013:p0680:b003:l017","ordinal":128500,"en":"Your orphan, son of the mighty beast,"},{"id":"semetey-1-2013:p0680:b003:l018","ordinal":128501,"en":"Rode weeping, shaken with sobs."},{"id":"semetey-1-2013:p0680:b003:l019","ordinal":128502,"en":"Without turning back, your uncle Bakay—"},{"id":"semetey-1-2013:p0680:b003:l020","ordinal":128503,"en":"Over pass after separate pass—"},{"id":"semetey-1-2013:p0680:b003:l021","ordinal":128504,"en":"Your matchless uncle Bakay Khan"},{"id":"semetey-1-2013:p0680:b003:l022","ordinal":128505,"en":"Went on leading the way."},{"id":"semetey-1-2013:p0680:b003:l023","ordinal":128506,"en":"If you ask of Bakay,"},{"id":"semetey-1-2013:p0680:b003:l024","ordinal":128507,"en":"Bakay Khan, the son of Bay,"},{"id":"semetey-1-2013:p0680:b003:l025","ordinal":128508,"en":"The hero was of a different kind."},{"id":"semetey-1-2013:p0680:b003:l026","ordinal":128509,"en":"He rinsed his mouth with honey,"},{"id":"semetey-1-2013:p0680:b003:l027","ordinal":128510,"en":"Wore a hat of blue-gray lynx fur,"},{"id":"semetey-1-2013:p0680:b003:l028","ordinal":128511,"en":"Wielded a blue-mottled shield."},{"id":"semetey-1-2013:p0680:b003:l030","ordinal":128512,"en":"Rested his feet on pure gold.","gapBefore":"[Source wording unresolved; translation pending]"}]
