{"id": "sayakbay-ms-current146:pdf073:l004", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 73, "folio": 456, "line_in_page": 4, "raw": "Сенин элиң көп болуп,", "text": "Сенин элиң көп болуп,", "en": "Though your people are many,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf073:l005", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 73, "folio": 456, "line_in_page": 5, "raw": "Аз гана кыргыз чын эмес,", "text": "Аз гана кыргыз чын эмес,", "en": "The few Kyrgyz are no falsehood,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The emphatic construction is provisional.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf073:l006", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 73, "folio": 456, "line_in_page": 6, "raw": "Чамасын чактап сыр айтсак,", "text": "Чамасын чактап сыр айтсак,", "en": "If we gauge their strength and tell the secret,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Both idiom and verb are provisional.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf073:l007", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 73, "folio": 456, "line_in_page": 7, "raw": "Чабылгандай бакырдың,", "text": "Чабылгандай бакырдың,", "en": "You bellowed as though struck down,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Simile is clear; verb form is provisional.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf073:l008", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 73, "folio": 456, "line_in_page": 8, "raw": "Ханым, сенин бу кылганың чын эмес.", "text": "Ханым, сенин бу кылганың чын эмес.", "en": "My khan, what you have done is not right.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf073:l009", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 73, "folio": 456, "line_in_page": 9, "raw": "Хан буйругу темир тор,", "text": "Хан буйругу темир тор,", "en": "A khan’s command is an iron snare,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf073:l010", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 73, "folio": 456, "line_in_page": 10, "raw": "Каардансаң, какайсаң,", "text": "Каардансаң, какайсаң,", "en": "When you rage and stiffen in anger,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf073:l011", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 73, "folio": 456, "line_in_page": 11, "raw": "Кайнайт экен биздин шор.", "text": "Кайнайт экен биздин шор.", "en": "Our misery begins to boil.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
