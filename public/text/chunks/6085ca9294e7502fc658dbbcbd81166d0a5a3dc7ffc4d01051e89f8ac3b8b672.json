[{"id":"semetey-1-2013:p0586:b004:l020","ordinal":121857,"en":"He does not die after all!’"},{"id":"semetey-1-2013:p0586:b004:l021","ordinal":121858,"en":"Busy, noisy,"},{"id":"semetey-1-2013:p0586:b004:l022","ordinal":121859,"en":"Taytoru had come first in Bukhara."},{"id":"semetey-1-2013:p0586:b004:l023","ordinal":121860,"en":"The poor orphan left by Manas"},{"id":"semetey-1-2013:p0586:b004:l024","ordinal":121861,"en":"The many prizes in Bukhara"},{"id":"semetey-1-2013:p0586:b004:l025","ordinal":121862,"en":"He swept up completely."},{"id":"semetey-1-2013:p0586:b004:l026","ordinal":121863,"en":"Bukhara's eighty wrestlers"},{"id":"semetey-1-2013:p0586:b004:l027","ordinal":121864,"en":"Said, ‘What of your promise, sir?’"},{"id":"semetey-1-2013:p0586:b004:l028","ordinal":121865,"en":"And stood up in a row."},{"id":"semetey-1-2013:p0586:b004:l029","ordinal":121866,"en":"Then the orphan Semetey"},{"id":"semetey-1-2013:p0586:b004:l030","ordinal":121867,"en":"Agreed to what they said."},{"id":"semetey-1-2013:p0586:b004:l031","ordinal":121868,"en":"There were a thousand dark camels,"},{"id":"semetey-1-2013:p0586:b004:l032","ordinal":121869,"en":"A thousand black mares with white blazes,"},{"id":"semetey-1-2013:p0586:b004:l033","ordinal":121870,"en":"Seven houses full of yellow gold,"},{"id":"semetey-1-2013:p0586:b004:l034","ordinal":121871,"en":"With rubies and diamonds mixed among it."},{"id":"semetey-1-2013:p0586:b004:l035","ordinal":121872,"en":"The boy became their owner."},{"id":"semetey-1-2013:p0586:b004:l036","ordinal":121873,"en":"Without keeping half a copper coin,"},{"id":"semetey-1-2013:p0586:b004:l037","ordinal":121874,"en":"Without setting aside half a mare,"},{"id":"semetey-1-2013:p0586:b004:l038","ordinal":121875,"en":"The many prizes in Bukhara,"},{"id":"semetey-1-2013:p0586:b004:l039","ordinal":121876,"en":"To the wrestlers, Semetey"},{"id":"semetey-1-2013:p0587:b003:l001","ordinal":121877,"en":"Divided them and gave them away."},{"id":"semetey-1-2013:p0587:b003:l002","ordinal":121878,"en":"The people crowded around to watch"},{"id":"semetey-1-2013:p0587:b003:l003","ordinal":121879,"en":"And marvelled at the boy:"},{"id":"semetey-1-2013:p0587:b003:l004","ordinal":121880,"en":"‘Whom God has truly created—"},{"id":"semetey-1-2013:p0587:b003:l005","ordinal":121881,"en":"Truly, he is His servant;"},{"id":"semetey-1-2013:p0587:b003:l006","ordinal":121882,"en":"Of poor Manas the mighty warrior,"},{"id":"semetey-1-2013:p0587:b003:l007","ordinal":121883,"en":"Truly, he is the son.’"},{"id":"semetey-1-2013:p0587:b003:l008","ordinal":121884,"en":"Without speaking openly, they shifted about."},{"id":"semetey-1-2013:p0587:b003:l009","ordinal":121885,"en":"The eight khans traded rumours,"},{"id":"semetey-1-2013:p0587:b003:l010","ordinal":121886,"en":"Each one shifting about."},{"id":"semetey-1-2013:p0587:b003:l011","ordinal":121887,"en":"While this was going on,"},{"id":"semetey-1-2013:p0587:b003:l012","ordinal":121888,"en":"Temir Khan in Bukhara"},{"id":"semetey-1-2013:p0587:b003:l013","ordinal":121889,"en":"Had a proclamation made to his people:"},{"id":"semetey-1-2013:p0587:b003:l014","ordinal":121890,"en":"‘My only son shall ascend the throne!’"},{"id":"semetey-1-2013:p0587:b003:l015","ordinal":121891,"en":"Upon a gold-patterned carpet"},{"id":"semetey-1-2013:p0587:b003:l016","ordinal":121892,"en":"They placed the boy."},{"id":"semetey-1-2013:p0587:b003:l017","ordinal":121893,"en":"Sixty wrestlers lifted him"},{"id":"semetey-1-2013:p0587:b003:l018","ordinal":121894,"en":"And, to Bukhara's golden throne,"},{"id":"semetey-1-2013:p0587:b003:l019","ordinal":121895,"en":"Carried him all the way."},{"id":"semetey-1-2013:p0587:b003:l020","ordinal":121896,"en":"Placing my golden crown upon you,"},{"id":"semetey-1-2013:p0587:b003:l021","ordinal":121897,"en":"They seated him on the golden throne;"},{"id":"semetey-1-2013:p0587:b003:l022","ordinal":121898,"en":"Saying “Amen!” over the boy,"},{"id":"semetey-1-2013:p0587:b003:l023","ordinal":121899,"en":"They raised him up as khan."},{"id":"semetey-1-2013:p0587:b003:l024","ordinal":121900,"en":"With this, in Bukhara"},{"id":"semetey-1-2013:p0587:b003:l025","ordinal":121901,"en":"An uproar broke out."},{"id":"semetey-1-2013:p0587:b003:l026","ordinal":121902,"en":"Then Bukhara's khan, Temir Khan,"},{"id":"semetey-1-2013:p0587:b003:l027","ordinal":121903,"en":"Was deeply moved;"},{"id":"semetey-1-2013:p0587:b003:l028","ordinal":121904,"en":"Tears streamed from his eyes."},{"id":"semetey-1-2013:p0587:b003:l029","ordinal":121905,"en":"When Semetey ascended the throne,"},{"id":"semetey-1-2013:p0587:b003:l030","ordinal":121906,"en":"The khan seemed overjoyed."},{"id":"semetey-1-2013:p0587:b003:l031","ordinal":121907,"en":"From the top of the minaret"},{"id":"semetey-1-2013:p0587:b003:l032","ordinal":121908,"en":"He roared fiercely,"},{"id":"semetey-1-2013:p0587:b003:l033","ordinal":121909,"en":"Summoning the peoples of eight khans:"},{"id":"semetey-1-2013:p0587:b003:l034","ordinal":121910,"en":"‘My dear eight khans,"},{"id":"semetey-1-2013:p0587:b003:l035","ordinal":121911,"en":"Let your great men come, your elders come;"},{"id":"semetey-1-2013:p0587:b003:l036","ordinal":121912,"en":"All you people, come, every one!"},{"id":"semetey-1-2013:p0587:b003:l037","ordinal":121913,"en":"I invite you to a solemn feast."},{"id":"semetey-1-2013:p0587:b003:l038","ordinal":121914,"en":"My dear eight khans,"},{"id":"semetey-1-2013:p0587:b003:l039","ordinal":121915,"en":"When my boy ascends the throne,"},{"id":"semetey-1-2013:p0587:b005:l001","ordinal":121916,"en":"How could I spare my livestock?"},{"id":"semetey-1-2013:p0587:b005:l002","ordinal":121917,"en":"Not just my livestock, eight khans—"},{"id":"semetey-1-2013:p0587:b005:l003","ordinal":121918,"en":"How could I spare even my life?"},{"id":"semetey-1-2013:p0587:b005:l004","ordinal":121919,"en":"My dear eight khans,"},{"id":"semetey-1-2013:p0587:b005:l005","ordinal":121920,"en":"This Semetey standing here"},{"id":"semetey-1-2013:p0587:b005:l006","ordinal":121921,"en":"Is my spring that feeds a river,"},{"id":"semetey-1-2013:p0587:b005:l007","ordinal":121922,"en":"My long-awaited little orphan."},{"id":"semetey-1-2013:p0587:b005:l008","ordinal":121923,"en":"My precious star in heaven,"},{"id":"semetey-1-2013:p0587:b005:l009","ordinal":121924,"en":"My silver-fox and otter fur upon my collar,"},{"id":"semetey-1-2013:p0587:b005:l010","ordinal":121925,"en":"My deep-rooted sacred plane tree,"},{"id":"semetey-1-2013:p0587:b005:l011","ordinal":121926,"en":"My long-awaited only child."},{"id":"semetey-1-2013:p0587:b005:l012","ordinal":121927,"en":"Listen, my people: since I became Temir Khan,"},{"id":"semetey-1-2013:p0587:b005:l014","ordinal":121928,"en":"Since I acquired the name Temir Khan,"},{"id":"semetey-1-2013:p0587:b005:l015","ordinal":121929,"en":"Since I grew to maturity and became a man,"},{"id":"semetey-1-2013:p0587:b005:l016","ordinal":121930,"en":"Standing equal to other men's sons,"},{"id":"semetey-1-2013:p0587:b005:l017","ordinal":121931,"en":"Since I put on this golden crown of mine"},{"id":"semetey-1-2013:p0587:b005:l018","ordinal":121932,"en":"And ruled Bukhara,"},{"id":"semetey-1-2013:p0587:b005:l019","ordinal":121933,"en":"I married, established a household and kept livestock,"},{"id":"semetey-1-2013:p0587:b005:l020","ordinal":121934,"en":"And supported so many people."},{"id":"semetey-1-2013:p0587:b005:l021","ordinal":121935,"en":"Then my wide world grew narrow:"},{"id":"semetey-1-2013:p0587:b005:l022","ordinal":121936,"en":"I yearned for just one child."},{"id":"semetey-1-2013:p0587:b005:l023","ordinal":121937,"en":"When I prayed to God for a child,"},{"id":"semetey-1-2013:p0587:b005:l024","ordinal":121938,"en":"I had twelve daughters in succession."},{"id":"semetey-1-2013:p0587:b005:l025","ordinal":121939,"en":"The thirteenth was Kanykey;"},{"id":"semetey-1-2013:p0587:b005:l026","ordinal":121940,"en":"The fourteenth, Ysmayyl."},{"id":"semetey-1-2013:p0587:b005:l027","ordinal":121941,"en":"At long last, I had an only son."},{"id":"semetey-1-2013:p0587:b005:l028","ordinal":121942,"en":"Listen to my words, my people:"},{"id":"semetey-1-2013:p0587:b005:l029","ordinal":121943,"en":"Ysmayyl's child"},{"id":"semetey-1-2013:p0587:b005:l030","ordinal":121944,"en":"Is this Semetey standing here."},{"id":"semetey-1-2013:p0587:b005:l031","ordinal":121945,"en":"My cherished one, born of my son."},{"id":"semetey-1-2013:p0587:b005:l032","ordinal":121946,"en":"When my only son ascends the throne,"},{"id":"semetey-1-2013:p0587:b005:l033","ordinal":121947,"en":"How could I begrudge my life?"},{"id":"semetey-1-2013:p0587:b005:l034","ordinal":121948,"en":"For this child's feast"},{"id":"semetey-1-2013:p0587:b005:l035","ordinal":121949,"en":"I put up a thousand dark camels,"},{"id":"semetey-1-2013:p0587:b005:l036","ordinal":121950,"en":"A thousand black mares with white blazes,"},{"id":"semetey-1-2013:p0587:b005:l037","ordinal":121951,"en":"And gold weighed out by the pood."},{"id":"semetey-1-2013:p0587:b005:l038","ordinal":121952,"en":"One wrestler stepped out from that side;"},{"id":"semetey-1-2013:p0587:b005:l039","ordinal":121953,"en":"One wrestler stepped out from this side."},{"id":"semetey-1-2013:p0588:b003:l001","ordinal":121954,"en":"Hold a wrestling match on foot!"},{"id":"semetey-1-2013:p0588:b003:l002","ordinal":121955,"en":"Let the man thrown down go empty-handed;"},{"id":"semetey-1-2013:p0588:b003:l003","ordinal":121956,"en":"Let the winner grow rich!"},{"id":"semetey-1-2013:p0588:b003:l004","ordinal":121957,"en":"At Semetey's feast,"},{"id":"semetey-1-2013:p0588:b003:l005","ordinal":121958,"en":"Say, “Such were the feats of skill,"},{"id":"semetey-1-2013:p0588:b003:l006","ordinal":121959,"en":"Such was the example set,"},{"id":"semetey-1-2013:p0588:b003:l007","ordinal":121960,"en":"Such was the entertainment,"},{"id":"semetey-1-2013:p0588:b003:l008","ordinal":121961,"en":"Such were the deeds!”"},{"id":"semetey-1-2013:p0588:b003:l009","ordinal":121962,"en":"You seven khans, to your own lands,"},{"id":"semetey-1-2013:p0588:b003:l010","ordinal":121963,"en":"When you arrive, tell of it."},{"id":"semetey-1-2013:p0588:b003:l011","ordinal":121964,"en":"To the old men lying at home,"},{"id":"semetey-1-2013:p0588:b003:l012","ordinal":121965,"en":"To the children crawling about,"},{"id":"semetey-1-2013:p0588:b003:l013","ordinal":121966,"en":"Go and tell it for all to hear."},{"id":"semetey-1-2013:p0588:b003:l014","ordinal":121967,"en":"If this prize of mine is too small,"},{"id":"semetey-1-2013:p0588:b003:l015","ordinal":121968,"en":"Stake this garden of mine belonging to the treasury;"},{"id":"semetey-1-2013:p0588:b003:l016","ordinal":121969,"en":"Stake the golden throne I sit upon;"},{"id":"semetey-1-2013:p0588:b003:l017","ordinal":121970,"en":"Stake my Tajik people who work with hoes."},{"id":"semetey-1-2013:p0588:b003:l018","ordinal":121971,"en":"If this prize of mine is too small,"},{"id":"semetey-1-2013:p0588:b003:l019","ordinal":121972,"en":"Shave my beard and stake me, my people!’"},{"id":"semetey-1-2013:p0588:b003:l020","ordinal":121973,"en":"Thus he staked his gold lavishly"},{"id":"semetey-1-2013:p0588:b003:l021","ordinal":121974,"en":"At that feast of Semetey's,"},{"id":"semetey-1-2013:p0588:b003:l022","ordinal":121975,"en":"Staking both his livestock and himself."},{"id":"semetey-1-2013:p0588:b003:l023","ordinal":121976,"en":"While he had the proclamation made,"},{"id":"semetey-1-2013:p0588:b003:l024","ordinal":121977,"en":"Töö the Wrestler came out from Kokand;"},{"id":"semetey-1-2013:p0588:b003:l025","ordinal":121978,"en":"Ak the Wrestler came out from Bukhara."},{"id":"semetey-1-2013:p0588:b003:l026","ordinal":121979,"en":"They knew each other,"},{"id":"semetey-1-2013:p0588:b003:l027","ordinal":121980,"en":"But without a great feast"},{"id":"semetey-1-2013:p0588:b003:l028","ordinal":121981,"en":"The wrestlers had been unable to meet."},{"id":"semetey-1-2013:p0588:b003:l029","ordinal":121982,"en":"Then Ak the Wrestler of Bukhara"},{"id":"semetey-1-2013:p0588:b003:l030","ordinal":121983,"en":"And Töö the Wrestler of Kokand"},{"id":"semetey-1-2013:p0588:b003:l031","ordinal":121984,"en":"Wrestled each other on foot."},{"id":"semetey-1-2013:p0588:b003:l032","ordinal":121985,"en":"They tore at each other like hungry wolves,"},{"id":"semetey-1-2013:p0588:b003:l033","ordinal":121986,"en":"Wrestling mercilessly."},{"id":"semetey-1-2013:p0588:b003:l034","ordinal":121987,"en":"They snapped at each other like hungry bull camels,"},{"id":"semetey-1-2013:p0588:b003:l035","ordinal":121988,"en":"Grappling without sparing themselves,"},{"id":"semetey-1-2013:p0588:b003:l036","ordinal":121989,"en":"Tearing at each other's trouser legs."},{"id":"semetey-1-2013:p0588:b003:l037","ordinal":121990,"en":"For eight days"},{"id":"semetey-1-2013:p0588:b003:l038","ordinal":121991,"en":"Neither wrestler could throw the other."},{"id":"semetey-1-2013:p0588:b003:l039","ordinal":121992,"en":"They tore at whatever part they could see,"},{"id":"semetey-1-2013:p0588:b004:l001","ordinal":121993,"en":"Butting like gray rams."},{"id":"semetey-1-2013:p0588:b004:l002","ordinal":121994,"en":"The wrestlers' struggle"},{"id":"semetey-1-2013:p0588:b004:l003","ordinal":121995,"en":"Had lasted nine days"},{"id":"semetey-1-2013:p0588:b004:l004","ordinal":121996,"en":"When Bukhara's Ak the Wrestler"},{"id":"semetey-1-2013:p0588:b004:l005","ordinal":121997,"en":"Lost his strength."},{"id":"semetey-1-2013:p0588:b004:l006","ordinal":121998,"en":"Töö the Wrestler of Kokand"},{"id":"semetey-1-2013:p0588:b004:l007","ordinal":121999,"en":"Lifted him and hurled him down,"},{"id":"semetey-1-2013:p0588:b004:l008","ordinal":122000,"en":"The many treasures and staked livestock—"},{"id":"semetey-1-2013:p0588:b004:l009","ordinal":122001,"en":"He seized them all."},{"id":"semetey-1-2013:p0588:b004:l010","ordinal":122002,"en":"Seeing this, Semetey,"},{"id":"semetey-1-2013:p0588:b004:l011","ordinal":122003,"en":"The fierce hero, burned with anguish."},{"id":"semetey-1-2013:p0588:b004:l012","ordinal":122004,"en":"‘A man of Kokand, over a man of Bukhara—"},{"id":"semetey-1-2013:p0588:b004:l013","ordinal":122005,"en":"How can he win?"},{"id":"semetey-1-2013:p0588:b004:l014","ordinal":122006,"en":"Töö the Wrestler, over this Ak the Wrestler—"},{"id":"semetey-1-2013:p0588:b004:l015","ordinal":122007,"en":"How can he throw him?"},{"id":"semetey-1-2013:p0588:b004:l016","ordinal":122008,"en":"That these people of Bukhara"},{"id":"semetey-1-2013:p0588:b004:l017","ordinal":122009,"en":"Should be humiliated—what does that mean?"},{"id":"semetey-1-2013:p0588:b004:l018","ordinal":122010,"en":"The honour lost is mine;"},{"id":"semetey-1-2013:p0588:b004:l019","ordinal":122011,"en":"Whose is the honour gained?"},{"id":"semetey-1-2013:p0588:b004:l020","ordinal":122012,"en":"May I sink away unborn!"},{"id":"semetey-1-2013:p0588:b004:l021","ordinal":122013,"en":"If I let this honour be lost,"},{"id":"semetey-1-2013:p0588:b004:l022","ordinal":122014,"en":"Let me die rather than go on living."},{"id":"semetey-1-2013:p0588:b004:l023","ordinal":122015,"en":"To have my honour taken—"},{"id":"semetey-1-2013:p0588:b004:l024","ordinal":122016,"en":"Rather than this, my wretched soul,"},{"id":"semetey-1-2013:p0588:b004:l025","ordinal":122017,"en":"May I sink away unborn!"},{"id":"semetey-1-2013:p0588:b004:l026","ordinal":122018,"en":"This golden throne here,"},{"id":"semetey-1-2013:p0588:b004:l027","ordinal":122019,"en":"I shall stake it as a prize"},{"id":"semetey-1-2013:p0588:b004:l028","ordinal":122020,"en":"And try my hand at wrestling."},{"id":"semetey-1-2013:p0588:b004:l029","ordinal":122021,"en":"If the wrestler throws me,"},{"id":"semetey-1-2013:p0588:b004:l030","ordinal":122022,"en":"I shall give him my golden throne."},{"id":"semetey-1-2013:p0588:b004:l031","ordinal":122023,"en":"If I throw the wrestler,"},{"id":"semetey-1-2013:p0588:b004:l032","ordinal":122024,"en":"I shall seize him and split his head,"},{"id":"semetey-1-2013:p0588:b004:l033","ordinal":122025,"en":"And tear his ribs apart."},{"id":"semetey-1-2013:p0588:b004:l034","ordinal":122026,"en":"When my days are done, let me die."},{"id":"semetey-1-2013:p0588:b004:l035","ordinal":122027,"en":"With this wrestler who thinks himself strong,"},{"id":"semetey-1-2013:p0588:b004:l036","ordinal":122028,"en":"Let me try a wrestling bout!’"},{"id":"semetey-1-2013:p0588:b004:l037","ordinal":122029,"en":"Thus he spoke these words,"},{"id":"semetey-1-2013:p0588:b004:l038","ordinal":122030,"en":"And from atop the golden throne"},{"id":"semetey-1-2013:p0588:b004:l039","ordinal":122031,"en":"He roared fiercely,"},{"id":"semetey-1-2013:p0589:b003:l001","ordinal":122032,"en":"Then he called to Camel Wrestler:"},{"id":"semetey-1-2013:p0589:b003:l002","ordinal":122033,"en":"“My wrestler, turn your head this way!"},{"id":"semetey-1-2013:p0589:b003:l003","ordinal":122034,"en":"My age has reached twelve;"},{"id":"semetey-1-2013:p0589:b003:l004","ordinal":122035,"en":"I will wrestle, wrestler—wait."},{"id":"semetey-1-2013:p0589:b003:l005","ordinal":122036,"en":"Go away sated with abundant spoils;"},{"id":"semetey-1-2013:p0589:b003:l006","ordinal":122037,"en":"I have staked my city of Bukhara,"},{"id":"semetey-1-2013:p0589:b003:l007","ordinal":122038,"en":"Take away my subject people!"},{"id":"semetey-1-2013:p0589:b003:l008","ordinal":122039,"en":"Turn your horse's head;"},{"id":"semetey-1-2013:p0589:b003:l009","ordinal":122040,"en":"If you are a lion, my wrestler,"},{"id":"semetey-1-2013:p0589:b003:l010","ordinal":122041,"en":"Let us grapple once."},{"id":"semetey-1-2013:p0589:b003:l011","ordinal":122042,"en":"Stand in the place ahead!”"},{"id":"semetey-1-2013:p0589:b003:l012","ordinal":122043,"en":"Saying this, Semetey,"},{"id":"semetey-1-2013:p0589:b003:l013","ordinal":122044,"en":"Bending his knees toward the ground,"},{"id":"semetey-1-2013:p0589:b003:l014","ordinal":122045,"en":"From atop the golden throne"},{"id":"semetey-1-2013:p0589:b003:l015","ordinal":122046,"en":"The boy ran down at a rush."},{"id":"semetey-1-2013:p0589:b003:l016","ordinal":122047,"en":"Your father's grave, Camel Wrestler!"},{"id":"semetey-1-2013:p0589:b003:l017","ordinal":122048,"en":"Swollen with pride after throwing his opponent,"},{"id":"semetey-1-2013:p0589:b003:l018","ordinal":122049,"en":"Raging, looming large,"},{"id":"semetey-1-2013:p0589:b003:l019","ordinal":122050,"en":"His nose bulging like a leather sack:"},{"id":"semetey-1-2013:p0589:b003:l020","ordinal":122051,"en":"“This wretched child,"},{"id":"semetey-1-2013:p0589:b003:l021","ordinal":122052,"en":"Let me seize him now;"},{"id":"semetey-1-2013:p0589:b003:l022","ordinal":122053,"en":"Let me seize him and dash him to the ground."},{"id":"semetey-1-2013:p0589:b003:l023","ordinal":122054,"en":"His age has reached twelve;"},{"id":"semetey-1-2013:p0589:b003:l024","ordinal":122055,"en":"Let me knock his madness far away."},{"id":"semetey-1-2013:p0589:b003:l025","ordinal":122056,"en":"If God grants it, the golden throne"},{"id":"semetey-1-2013:p0589:b003:l026","ordinal":122057,"en":"Let me seize and mount."},{"id":"semetey-1-2013:p0589:b003:l027","ordinal":122058,"en":"His age has reached twelve;"},{"id":"semetey-1-2013:p0589:b003:l028","ordinal":122059,"en":"Let me bring all my strength upon the wretch."},{"id":"semetey-1-2013:p0589:b003:l029","ordinal":122060,"en":"The golden throne beneath him,"},{"id":"semetey-1-2013:p0589:b003:l030","ordinal":122061,"en":"Let me take it from the boy like this.”"},{"id":"semetey-1-2013:p0589:b003:l031","ordinal":122062,"en":"Camel Wrestler stood waiting."},{"id":"semetey-1-2013:p0589:b003:l032","ordinal":122063,"en":"The twelve-year-old scourge"},{"id":"semetey-1-2013:p0589:b003:l033","ordinal":122064,"en":"Ismail then intercepted."},{"id":"semetey-1-2013:p0589:b003:l034","ordinal":122065,"en":"Then Ismail stood and said:"},{"id":"semetey-1-2013:p0589:b003:l036","ordinal":122066,"en":"“My child, you have not yet reached twelve;"},{"id":"semetey-1-2013:p0589:b003:l037","ordinal":122067,"en":"Your time to wrestle has not yet come."},{"id":"semetey-1-2013:p0589:b003:l038","ordinal":122068,"en":"You have not reached fifteen;"},{"id":"semetey-1-2013:p0589:b003:l039","ordinal":122069,"en":"Your mother's white milk"},{"id":"semetey-1-2013:p0589:b004:l001","ordinal":122070,"en":"Has not yet left your palate."},{"id":"semetey-1-2013:p0589:b004:l002","ordinal":122071,"en":"A khan does not wrestle in a bout."},{"id":"semetey-1-2013:p0589:b004:l003","ordinal":122072,"en":"What are you doing, my son, what are you doing?"},{"id":"semetey-1-2013:p0589:b004:l004","ordinal":122073,"en":"A khan does not wrestle for a prize.”"},{"id":"semetey-1-2013:p0589:b004:l005","ordinal":122074,"en":"Saying this, Ismail"},{"id":"semetey-1-2013:p0589:b004:l006","ordinal":122075,"en":"Now held the boy back."},{"id":"semetey-1-2013:p0589:b004:l007","ordinal":122076,"en":"Then the boy said this,"},{"id":"semetey-1-2013:p0589:b004:l008","ordinal":122077,"en":"Spoke shocking words no one had heard:"},{"id":"semetey-1-2013:p0589:b004:l009","ordinal":122078,"en":"“Alas, father, let me go!"},{"id":"semetey-1-2013:p0589:b004:l010","ordinal":122079,"en":"Whose honor has been won?"},{"id":"semetey-1-2013:p0589:b004:l011","ordinal":122080,"en":"Whose honor has been lost?"},{"id":"semetey-1-2013:p0589:b004:l012","ordinal":122081,"en":"Those whose support was like iron,"},{"id":"semetey-1-2013:p0589:b004:l013","ordinal":122082,"en":"The Bukharans' countless prizes—"},{"id":"semetey-1-2013:p0589:b004:l014","ordinal":122083,"en":"The Kokand men looted them,"},{"id":"semetey-1-2013:p0589:b004:l015","ordinal":122084,"en":"I will not let it be said they took them all!"},{"id":"semetey-1-2013:p0589:b004:l016","ordinal":122085,"en":"My age has reached twelve;"},{"id":"semetey-1-2013:p0589:b004:l017","ordinal":122086,"en":"If my death has come, I shall die."},{"id":"semetey-1-2013:p0589:b004:l018","ordinal":122087,"en":"With Kokand's Camel Wrestler"},{"id":"semetey-1-2013:p0589:b004:l019","ordinal":122088,"en":"I shall try a bout of wrestling."},{"id":"semetey-1-2013:p0589:b004:l020","ordinal":122089,"en":"If I throw the wrestler,"},{"id":"semetey-1-2013:p0589:b004:l021","ordinal":122090,"en":"I shall attain my wish;"},{"id":"semetey-1-2013:p0589:b004:l022","ordinal":122091,"en":"If the wrestler throws me,"},{"id":"semetey-1-2013:p0589:b004:l023","ordinal":122092,"en":"I shall depart in my youth."},{"id":"semetey-1-2013:p0589:b004:l024","ordinal":122093,"en":"Father, one without fervor has no faith;"},{"id":"semetey-1-2013:p0589:b004:l025","ordinal":122094,"en":"One without honor has no dignity."},{"id":"semetey-1-2013:p0589:b004:l026","ordinal":122095,"en":"Letting my honor be taken,"},{"id":"semetey-1-2013:p0589:b004:l027","ordinal":122096,"en":"Father, should God strike me down?"},{"id":"semetey-1-2013:p0589:b004:l028","ordinal":122097,"en":"‘Stop, you are twelve,’ you say;"},{"id":"semetey-1-2013:p0589:b004:l029","ordinal":122098,"en":"Father, should God strike you down instead?"},{"id":"semetey-1-2013:p0589:b004:l030","ordinal":122099,"en":"Offering advice without reason,"},{"id":"semetey-1-2013:p0589:b004:l031","ordinal":122100,"en":"You seem to get ahead of yourself."},{"id":"semetey-1-2013:p0589:b004:l032","ordinal":122101,"en":"How many people from death,"},{"id":"semetey-1-2013:p0589:b004:l033","ordinal":122102,"en":"Father, can you hold back?"},{"id":"semetey-1-2013:p0589:b004:l034","ordinal":122103,"en":"Father, like a black-eyed ram,"},{"id":"semetey-1-2013:p0589:b004:l035","ordinal":122104,"en":"You bob about."},{"id":"semetey-1-2013:p0589:b004:l036","ordinal":122105,"en":"Like a male black crow,"},{"id":"semetey-1-2013:p0589:b004:l037","ordinal":122106,"en":"You bob about."},{"id":"semetey-1-2013:p0589:b004:l038","ordinal":122107,"en":"You have no honor, no dignity;"},{"id":"semetey-1-2013:p0589:b004:l039","ordinal":122108,"en":"You are a foolish man."},{"id":"semetey-1-2013:p0590:b003:l001","ordinal":122109,"en":"“Alas, father, let me go!"},{"id":"semetey-1-2013:p0590:b003:l002","ordinal":122110,"en":"When God Most High, the Almighty,"},{"id":"semetey-1-2013:p0590:b003:l003","ordinal":122111,"en":"Gives His mighty command,"},{"id":"semetey-1-2013:p0590:b003:l004","ordinal":122112,"en":"Azrael, the taker of souls,"}]
