[{"id":"manas-2010:p1826:b001:l008","ordinal":78337,"en":"Of your sultan, Khan Manas,"},{"id":"manas-2010:p1826:b001:l009","ordinal":78338,"en":"She was the spouse for the next world."},{"id":"manas-2010:p1826:b001:l010","ordinal":78339,"en":"Though she was a woman, Saikal's"},{"id":"manas-2010:p1826:b001:l011","ordinal":78340,"en":"Fortune and standing matched his."},{"id":"manas-2010:p1826:b001:l012","ordinal":78341,"en":"Parted from her equal,"},{"id":"manas-2010:p1826:b001:l013","ordinal":78342,"en":"At that time maiden Saikal"},{"id":"manas-2010:p1826:b001:l014","ordinal":78343,"en":"Had wasted away."},{"id":"manas-2010:p1826:b001:l015","ordinal":78344,"en":"Maiden Saikal was khan of the Oirats."},{"id":"manas-2010:p1826:b001:l016","ordinal":78345,"en":"Under maiden Saikal's command,"},{"id":"manas-2010:p1826:b001:l017","ordinal":78346,"en":"Led by warrior Bolot,"},{"id":"manas-2010:p1826:b001:l018","ordinal":78347,"en":"Were forty companions."},{"id":"manas-2010:p1826:b001:l019","ordinal":78348,"en":"Saikal, daughter of Karacha,"},{"id":"manas-2010:p1826:b001:l020","ordinal":78349,"en":"Was deft among spearfighters."},{"id":"manas-2010:p1826:b001:l021","ordinal":78350,"en":"Apart from being a woman,"},{"id":"manas-2010:p1826:b001:l022","ordinal":78351,"en":"She was mighty enough to rule the world."},{"id":"manas-2010:p1826:b001:l023","ordinal":78352,"en":"Her right shoulder was broad;"},{"id":"manas-2010:p1826:b001:l024","ordinal":78353,"en":"Her twelve bodily members were balanced."},{"id":"manas-2010:p1826:b001:l025","ordinal":78354,"en":"Led by warrior Bolot,"},{"id":"manas-2010:p1826:b001:l026","ordinal":78355,"en":"Finding no enemy to fight,"},{"id":"manas-2010:p1826:b001:l027","ordinal":78356,"en":"Finding no mountain to dash against,"},{"id":"manas-2010:p1826:b001:l028","ordinal":78357,"en":"They were swelling with pride."},{"id":"manas-2010:p1826:b001:l029","ordinal":78358,"en":"From the spur of the mountain below,"},{"id":"manas-2010:p1826:b001:l030","ordinal":78359,"en":"Dust rose in billowing bursts."},{"id":"manas-2010:p1826:b001:l031","ordinal":78360,"en":"Looking at the billowing dust,"},{"id":"manas-2010:p1826:b001:l032","ordinal":78361,"en":"It was warrior Bolot's dust;"},{"id":"manas-2010:p1826:b001:l033","ordinal":78362,"en":"He was a man like forty wrestlers."},{"id":"manas-2010:p1826:b001:l034","ordinal":78363,"en":"“Saikal has married Manas,” they said."},{"id":"manas-2010:p1826:b001:l035","ordinal":78364,"en":"The forty companions longed for it:"},{"id":"manas-2010:p1826:b001:l036","ordinal":78365,"en":"“I shall reach Talas and settle there;"},{"id":"manas-2010:p1826:b001:l037","ordinal":78366,"en":"I shall become Manas's companion,” each said,"},{"id":"manas-2010:p1826:b001:l038","ordinal":78367,"en":"Burning with desire."},{"id":"manas-2010:p1826:b001:l039","ordinal":78368,"en":"Saikal, daughter of Karacha,"},{"id":"manas-2010:p1826:b001:l040","ordinal":78369,"en":"Came straight before them,"},{"id":"manas-2010:p1826:b001:l041","ordinal":78370,"en":"And they saw her mourning dress."},{"id":"manas-2010:p1826:b001:l042","ordinal":78371,"en":"“May your Khan Manas not die!” they cried,"},{"id":"manas-2010:p1827:b001:l001","ordinal":78372,"en":"Roaring with grief,"},{"id":"manas-2010:p1827:b001:l002","ordinal":78373,"en":"Led by warrior Bolot,"},{"id":"manas-2010:p1827:b001:l003","ordinal":78374,"en":"They raised an outcry."},{"id":"manas-2010:p1827:b001:l004","ordinal":78375,"en":"All in mourning, staggering,"},{"id":"manas-2010:p1827:b001:l005","ordinal":78376,"en":"Precious Saikal went onward."},{"id":"manas-2010:p1827:b001:l006","ordinal":78377,"en":"Karacha was khan of the Oigut,"},{"id":"manas-2010:p1827:b001:l007","ordinal":78378,"en":"A man of sacred power."},{"id":"manas-2010:p1827:b001:l008","ordinal":78379,"en":"“Maiden Saikal is Manas's wife”—"},{"id":"manas-2010:p1827:b001:l009","ordinal":78380,"en":"That report had reached him."},{"id":"manas-2010:p1827:b001:l010","ordinal":78381,"en":"“For the support she relied upon,"},{"id":"manas-2010:p1827:b001:l011","ordinal":78382,"en":"My foal has come home grieving,"},{"id":"manas-2010:p1827:b001:l012","ordinal":78383,"en":"For her lion, Manas."},{"id":"manas-2010:p1827:b001:l013","ordinal":78384,"en":"Who would not grieve, who would refrain,"},{"id":"manas-2010:p1827:b001:l014","ordinal":78385,"en":"For the equal she had married?"},{"id":"manas-2010:p1827:b001:l015","ordinal":78386,"en":"Stately Manas, that precious warrior—"},{"id":"manas-2010:p1827:b001:l016","ordinal":78387,"en":"Was he a lion not worth mourning?"},{"id":"manas-2010:p1827:b001:l017","ordinal":78388,"en":"My child has come home grieving,” he said."},{"id":"manas-2010:p1827:b001:l018","ordinal":78389,"en":"Sixty women lament-singers"},{"id":"manas-2010:p1827:b001:l019","ordinal":78390,"en":"He had set up a mourning effigy for her."},{"id":"manas-2010:p1827:b001:l020","ordinal":78391,"en":"That day, when Saikal settled there,"},{"id":"manas-2010:p1827:b001:l021","ordinal":78392,"en":"As the pale dawn broke,"},{"id":"manas-2010:p1827:b001:l022","ordinal":78393,"en":"When light touched the court,"},{"id":"manas-2010:p1827:b001:l023","ordinal":78394,"en":"Warrior Bolot recited the profession of faith."},{"id":"manas-2010:p1827:b001:l024","ordinal":78395,"en":"Before spending one night at the court,"},{"id":"manas-2010:p1827:b001:l025","ordinal":78396,"en":"Saikal, daughter of Karacha,"},{"id":"manas-2010:p1827:b001:l026","ordinal":78397,"en":"Had departed this world."},{"id":"manas-2010:p1827:b001:l027","ordinal":78398,"en":"Grieving and weeping, finding no relief,"},{"id":"manas-2010:p1827:b001:l028","ordinal":78399,"en":"Her father, Khan Karacha,"},{"id":"manas-2010:p1827:b001:l029","ordinal":78400,"en":"Could not find Saikal's body."},{"id":"manas-2010:p1827:b001:l030","ordinal":78401,"en":"Her court remained, but she was gone."},{"id":"manas-2010:p1827:b001:l031","ordinal":78402,"en":"Looking, they could not see her;"},{"id":"manas-2010:p1827:b001:l032","ordinal":78403,"en":"No one knew where she was."},{"id":"manas-2010:p1827:b001:l033","ordinal":78404,"en":"After Saikal had died thus,"},{"id":"manas-2010:p1827:b001:l034","ordinal":78405,"en":"How she had vanished before burial—"},{"id":"manas-2010:p1827:b001:l035","ordinal":78406,"en":"When her many people saw this,"},{"id":"manas-2010:p1827:b001:l036","ordinal":78407,"en":"The white-bearded elders said:"},{"id":"manas-2010:p1827:b001:l037","ordinal":78408,"en":"“To be with Manas in the next world,"},{"id":"manas-2010:p1827:b001:l038","ordinal":78409,"en":"Saikal, favored by Khizr, has gone.”"},{"id":"manas-2010:p1827:b001:l039","ordinal":78410,"en":"All grieving from the heart,"},{"id":"manas-2010:p1827:b001:l040","ordinal":78411,"en":"They knew Saikal, favored by Khizr, was a hero."},{"id":"manas-2010:p1827:b001:l041","ordinal":78412,"en":"To Manas, her companion in the next world,"},{"id":"manas-2010:p1827:b001:l042","ordinal":78413,"en":"Having bidden her people farewell,"},{"id":"manas-2010:p1828:b001:l001","ordinal":78414,"en":"She had gone to join him."},{"id":"manas-2010:p1828:b001:l002","ordinal":78415,"en":"Let us leave Saikal thus."},{"id":"manas-2010:p1828:b001:l003","ordinal":78416,"en":"Kokboru, son of Urumkan—"},{"id":"manas-2010:p1828:b001:l004","ordinal":78417,"en":"Let us begin with Kokboru."},{"id":"manas-2010:p1828:b001:l005","ordinal":78418,"en":"The stars in the sky were pale."},{"id":"manas-2010:p1828:b001:l006","ordinal":78419,"en":"With blue-maned warrior Manas"},{"id":"manas-2010:p1828:b001:l007","ordinal":78420,"en":"He was a friend into the next world."},{"id":"manas-2010:p1828:b001:l008","ordinal":78421,"en":"Setting straight out on the road,"},{"id":"manas-2010:p1828:b001:l009","ordinal":78422,"en":"Traveling far without sparing his horse,"},{"id":"manas-2010:p1828:b001:l010","ordinal":78423,"en":"Crossing mountains like knucklebones,"},{"id":"manas-2010:p1828:b001:l011","ordinal":78424,"en":"Crossing hollows like saddlecloths,"},{"id":"manas-2010:p1828:b001:l012","ordinal":78425,"en":"He came to the place called Chambyl."},{"id":"manas-2010:p1828:b001:l013","ordinal":78426,"en":"Those who dwelt in Chambyl"},{"id":"manas-2010:p1828:b001:l014","ordinal":78427,"en":"Were called Janaaly and Karach."},{"id":"manas-2010:p1828:b001:l015","ordinal":78428,"en":"Mounting stallions from the tether-line,"},{"id":"manas-2010:p1828:b001:l016","ordinal":78429,"en":"Taking poles from the ground,"},{"id":"manas-2010:p1828:b001:l017","ordinal":78430,"en":"Crying, “O my patron!”"},{"id":"manas-2010:p1828:b001:l018","ordinal":78431,"en":"They fought a terrible battle."},{"id":"manas-2010:p1828:b001:l019","ordinal":78432,"en":"Champion Kokboru had wreaked havoc there;"},{"id":"manas-2010:p1828:b001:l020","ordinal":78433,"en":"Six times before"},{"id":"manas-2010:p1828:b001:l021","ordinal":78434,"en":"He had gone and raided it."},{"id":"manas-2010:p1828:b001:l022","ordinal":78435,"en":"They had split gallbladders and severed heads;"},{"id":"manas-2010:p1828:b001:l023","ordinal":78436,"en":"A hatred lasting unto death remained."},{"id":"manas-2010:p1828:b001:l024","ordinal":78437,"en":"Mighty men emerged from their land;"},{"id":"manas-2010:p1828:b001:l025","ordinal":78438,"en":"Troops thronged everywhere."},{"id":"manas-2010:p1828:b001:l026","ordinal":78439,"en":"From the Afghan land beyond,"},{"id":"manas-2010:p1828:b001:l027","ordinal":78440,"en":"To the saddle-shaped pass,"},{"id":"manas-2010:p1828:b001:l028","ordinal":78441,"en":"As he bent forward and reached it,"},{"id":"manas-2010:p1828:b001:l029","ordinal":78442,"en":"A red banner with pale-gray mottling,"},{"id":"manas-2010:p1828:b001:l030","ordinal":78443,"en":"There was an uproar of “Woe, woe!”"},{"id":"manas-2010:p1828:b001:l031","ordinal":78444,"en":"A red banner with white mottling,"},{"id":"manas-2010:p1828:b001:l032","ordinal":78445,"en":"When he went beyond it,"},{"id":"manas-2010:p1828:b001:l033","ordinal":78446,"en":"There was shouting and uproar."},{"id":"manas-2010:p1828:b001:l034","ordinal":78447,"en":"Fluttering banners approached,"},{"id":"manas-2010:p1828:b001:l035","ordinal":78448,"en":"An army that bent the earth approached."},{"id":"manas-2010:p1828:b001:l036","ordinal":78449,"en":"Looking at the ranks beyond,"},{"id":"manas-2010:p1828:b001:l037","ordinal":78450,"en":"Spearheads struck together;"},{"id":"manas-2010:p1828:b001:l038","ordinal":78451,"en":"Men's heads knocked together."},{"id":"manas-2010:p1828:b001:l039","ordinal":78452,"en":"Leaders of ten circled about,"},{"id":"manas-2010:p1828:b001:l040","ordinal":78453,"en":"Leaders of fifty stood out."},{"id":"manas-2010:p1828:b001:l041","ordinal":78454,"en":"There were pale-gray-mottled banners,"},{"id":"manas-2010:p1828:b001:l042","ordinal":78455,"en":"There was a deep, wide trench dug out,"},{"id":"manas-2010:p1829:b001:l001","ordinal":78456,"en":"An army of many thousands."},{"id":"manas-2010:p1829:b001:l002","ordinal":78457,"en":"The marksmen who never missed"},{"id":"manas-2010:p1829:b001:l003","ordinal":78458,"en":"They had assigned to the slopes;"},{"id":"manas-2010:p1829:b001:l004","ordinal":78459,"en":"The deft spearfighters"},{"id":"manas-2010:p1829:b001:l005","ordinal":78460,"en":"They had stationed upon the hills."},{"id":"manas-2010:p1829:b001:l006","ordinal":78461,"en":"Swordsmen were at the front,"},{"id":"manas-2010:p1829:b001:l007","ordinal":78462,"en":"Mighty men upon the flanks;"},{"id":"manas-2010:p1829:b001:l008","ordinal":78463,"en":"Axemen were at the front,"},{"id":"manas-2010:p1829:b001:l009","ordinal":78464,"en":"Warriors upon the flanks."},{"id":"manas-2010:p1829:b001:l010","ordinal":78465,"en":"Those who would fight to the death,"},{"id":"manas-2010:p1829:b001:l011","ordinal":78466,"en":"Who would stand their ground in battle—"},{"id":"manas-2010:p1829:b001:l012","ordinal":78467,"en":"They had formed their leopards into one division."},{"id":"manas-2010:p1829:b001:l013","ordinal":78468,"en":"Those who would not groan beneath a sword—"},{"id":"manas-2010:p1829:b001:l014","ordinal":78469,"en":"They had formed their mighty men into one division."},{"id":"manas-2010:p1829:b001:l015","ordinal":78470,"en":"Those who would not notice an axe-blow—"},{"id":"manas-2010:p1829:b001:l016","ordinal":78471,"en":"They had formed their warriors into one division."},{"id":"manas-2010:p1829:b001:l017","ordinal":78472,"en":"When a black gun cracked,"},{"id":"manas-2010:p1829:b001:l018","ordinal":78473,"en":"Those who would not flee formed one division."},{"id":"manas-2010:p1829:b001:l019","ordinal":78474,"en":"When a fierce gun snapped,"},{"id":"manas-2010:p1829:b001:l020","ordinal":78475,"en":"Those who would not startle formed one division."},{"id":"manas-2010:p1829:b001:l021","ordinal":78476,"en":"Janaaly and Karach, the two scoundrels,"},{"id":"manas-2010:p1829:b001:l022","ordinal":78477,"en":"Had been plotting vengeance."},{"id":"manas-2010:p1829:b001:l023","ordinal":78478,"en":"“Manas has died,” they said,"},{"id":"manas-2010:p1829:b001:l024","ordinal":78479,"en":"“These men came for that.”"},{"id":"manas-2010:p1829:b001:l025","ordinal":78480,"en":"So they had blocked their roads."},{"id":"manas-2010:p1829:b001:l027","ordinal":78481,"en":"Your accomplished khan Kokboru","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"manas-2010:p1829:b001:l028","ordinal":78482,"en":"Urged his horse Kuukazyk forward."},{"id":"manas-2010:p1829:b001:l029","ordinal":78483,"en":"Into the gathered multitude of troops"},{"id":"manas-2010:p1829:b001:l030","ordinal":78484,"en":"He charged alone."},{"id":"manas-2010:p1829:b001:l031","ordinal":78485,"en":"Through their center, Kokboru"},{"id":"manas-2010:p1829:b001:l032","ordinal":78486,"en":"Drove, gouging a path."},{"id":"manas-2010:p1829:b001:l033","ordinal":78487,"en":"Around their edges, little Koyonaaly"},{"id":"manas-2010:p1829:b001:l034","ordinal":78488,"en":"Drove, slaughtering them."},{"id":"manas-2010:p1829:b001:l035","ordinal":78489,"en":"Through their center, your only child"},{"id":"manas-2010:p1829:b001:l036","ordinal":78490,"en":"Came, gouging a path."},{"id":"manas-2010:p1829:b001:l037","ordinal":78491,"en":"Along both flanks, your falcon,"},{"id":"manas-2010:p1829:b001:l038","ordinal":78492,"en":"Kokboru himself,"},{"id":"manas-2010:p1829:b001:l039","ordinal":78493,"en":"Came slaughtering them."},{"id":"manas-2010:p1829:b001:l040","ordinal":78494,"en":"Those who fled far off in haste,"},{"id":"manas-2010:p1829:b001:l041","ordinal":78495,"en":"Koyonaaly, the young blue-maned one,"},{"id":"manas-2010:p1829:b001:l042","ordinal":78496,"en":"Toppled with his spear."},{"id":"manas-2010:p1830:b001:l001","ordinal":78497,"en":"Those who fled farther still,"},{"id":"manas-2010:p1830:b001:l002","ordinal":78498,"en":"He struck with his short gun,"},{"id":"manas-2010:p1830:b001:l003","ordinal":78499,"en":"Herded together, drove and scattered."},{"id":"manas-2010:p1830:b001:l004","ordinal":78500,"en":"Taking no rest by day,"},{"id":"manas-2010:p1830:b001:l005","ordinal":78501,"en":"Taking no sleep by night,"},{"id":"manas-2010:p1830:b001:l006","ordinal":78502,"en":"Upon Chambyl-Bel's ridges,"},{"id":"manas-2010:p1830:b001:l007","ordinal":78503,"en":"A terrible battle raged."},{"id":"manas-2010:p1830:b001:l008","ordinal":78504,"en":"With fangs jutting out,"},{"id":"manas-2010:p1830:b001:l009","ordinal":78505,"en":"Dead horses made a mountain;"},{"id":"manas-2010:p1830:b001:l010","ordinal":78506,"en":"With mustaches bristling,"},{"id":"manas-2010:p1830:b001:l011","ordinal":78507,"en":"Dead warriors lay in heaps."},{"id":"manas-2010:p1830:b001:l012","ordinal":78508,"en":"Many a swift winged steed,"},{"id":"manas-2010:p1830:b001:l013","ordinal":78509,"en":"Its saddle slipped beneath its belly,"},{"id":"manas-2010:p1830:b001:l014","ordinal":78510,"en":"Many shied away, refusing to be caught."},{"id":"manas-2010:p1830:b001:l015","ordinal":78511,"en":"Many a mighty man,"},{"id":"manas-2010:p1830:b001:l016","ordinal":78512,"en":"“Alas, my dear kinsman"},{"id":"manas-2010:p1830:b001:l017","ordinal":78513,"en":"Has died in such-and-such a place!” he cried;"},{"id":"manas-2010:p1830:b001:l018","ordinal":78514,"en":"Many wandered about wailing."},{"id":"manas-2010:p1830:b001:l019","ordinal":78515,"en":"Hurrying, stumbling, crowding together,"},{"id":"manas-2010:p1830:b001:l020","ordinal":78516,"en":"The foolish-born, wretched people"},{"id":"manas-2010:p1830:b001:l021","ordinal":78517,"en":"Scrambled for their horses."},{"id":"manas-2010:p1830:b001:l022","ordinal":78518,"en":"All fled in a rush;"},{"id":"manas-2010:p1830:b001:l023","ordinal":78519,"en":"Your people, ruined and distressed,"},{"id":"manas-2010:p1830:b001:l024","ordinal":78520,"en":"Pleaded, “We submit as your slaves.”"},{"id":"manas-2010:p1830:b001:l025","ordinal":78521,"en":"Falling captive and crying out,"},{"id":"manas-2010:p1830:b001:l026","ordinal":78522,"en":"Your great people stood there."},{"id":"manas-2010:p1830:b001:l027","ordinal":78523,"en":"To the boy Koyonaaly"},{"id":"manas-2010:p1830:b001:l028","ordinal":78524,"en":"They offered their horses."},{"id":"manas-2010:p1830:b001:l029","ordinal":78525,"en":"“I will not slaughter the people needlessly,” he said,"},{"id":"manas-2010:p1830:b001:l030","ordinal":78526,"en":"And yielded to their plea."},{"id":"manas-2010:p1830:b001:l031","ordinal":78527,"en":"To all the great people"},{"id":"manas-2010:p1830:b001:l032","ordinal":78528,"en":"He swore he would not slaughter them."},{"id":"manas-2010:p1830:b001:l033","ordinal":78529,"en":"His sworn father, Khan Manas,"},{"id":"manas-2010:p1830:b001:l034","ordinal":78530,"en":"Had given him a tent as a gift;"},{"id":"manas-2010:p1830:b001:l035","ordinal":78531,"en":"He pitched it upon the pass."},{"id":"manas-2010:p1830:b001:l036","ordinal":78532,"en":"With collars of gold and sleeves of brass,"},{"id":"manas-2010:p1830:b001:l037","ordinal":78533,"en":"Double mail and lark's-eye links,"},{"id":"manas-2010:p1830:b001:l038","ordinal":78534,"en":"The bulletproof coats—"},{"id":"manas-2010:p1830:b001:l039","ordinal":78535,"en":"The warrior took them all off."},{"id":"manas-2010:p1830:b001:l040","ordinal":78536,"en":"Pillowing his head upon the white saddle,"},{"id":"manas-2010:p1830:b001:l041","ordinal":78537,"en":"His head toward the qibla,"},{"id":"manas-2010:p1830:b001:l042","ordinal":78538,"en":"Praying to his Allah,"},{"id":"manas-2010:p1831:b001:l001","ordinal":78539,"en":"The bulletproof armor"},{"id":"manas-2010:p1831:b001:l002","ordinal":78540,"en":"He drew snugly over himself."},{"id":"manas-2010:p1831:b001:l003","ordinal":78541,"en":"Your warrior fell asleep."},{"id":"manas-2010:p1831:b001:l004","ordinal":78542,"en":"He was twelve years old."},{"id":"manas-2010:p1831:b001:l005","ordinal":78543,"en":"Against that blazing plane tree,"},{"id":"manas-2010:p1831:b001:l006","ordinal":78544,"en":"Janaaly the swine bore enmity."},{"id":"manas-2010:p1831:b001:l007","ordinal":78545,"en":"“Beside the rib bone,” he said,"},{"id":"manas-2010:p1831:b001:l008","ordinal":78546,"en":"“Right at the head of the heart.”"},{"id":"manas-2010:p1831:b001:l009","ordinal":78547,"en":"With a flick, his bullet flew."},{"id":"manas-2010:p1831:b001:l010","ordinal":78548,"en":"The only child Koyonaaly"},{"id":"manas-2010:p1831:b001:l011","ordinal":78549,"en":"Was struck by the bullet of fate."},{"id":"manas-2010:p1831:b001:l012","ordinal":78550,"en":"Falling in his flowering days,"},{"id":"manas-2010:p1831:b001:l013","ordinal":78551,"en":"He perished while still young."},{"id":"manas-2010:p1831:b001:l014","ordinal":78552,"en":"Then his father Kokboru"},{"id":"manas-2010:p1831:b001:l015","ordinal":78553,"en":"Dropped straight from Kuukazyk's saddle,"},{"id":"manas-2010:p1831:b001:l016","ordinal":78554,"en":"Doubled over, his legs drawn together."},{"id":"manas-2010:p1831:b001:l017","ordinal":78555,"en":"Having gone to Talas and returned,"},{"id":"manas-2010:p1831:b001:l018","ordinal":78556,"en":"Bereft of the one who would cherish her,"},{"id":"manas-2010:p1831:b001:l019","ordinal":78557,"en":"His mother Külnaary"},{"id":"manas-2010:p1831:b001:l020","ordinal":78558,"en":"Sank down there."},{"id":"manas-2010:p1831:b001:l021","ordinal":78559,"en":"Tears mingled with blood"},{"id":"manas-2010:p1831:b001:l022","ordinal":78560,"en":"She poured out there."},{"id":"manas-2010:p1831:b001:l023","ordinal":78561,"en":"Calling, “Manas, favored by Khizr,”"},{"id":"manas-2010:p1831:b001:l024","ordinal":78562,"en":"Struck from the ridge-side,"},{"id":"manas-2010:p1831:b001:l025","ordinal":78563,"en":"His little Koyonaaly"},{"id":"manas-2010:p1831:b001:l026","ordinal":78564,"en":"He lost to that Janaaly."},{"id":"manas-2010:p1831:b001:l027","ordinal":78565,"en":"By the people of Chambyl-Bel,"},{"id":"manas-2010:p1831:b001:l028","ordinal":78566,"en":"Struck from the right side,"},{"id":"manas-2010:p1831:b001:l029","ordinal":78567,"en":"The only child, twelve years old,"},{"id":"manas-2010:p1831:b001:l030","ordinal":78568,"en":"Was taken midway on the road."},{"id":"manas-2010:p1831:b001:l031","ordinal":78569,"en":"Having gone to Manas and returned,"},{"id":"manas-2010:p1831:b001:l032","ordinal":78570,"en":"From his kingly child,"},{"id":"manas-2010:p1831:b001:l033","ordinal":78571,"en":"He was parted midway."},{"id":"manas-2010:p1831:b001:l034","ordinal":78572,"en":"Looking, he could not see him;"},{"id":"manas-2010:p1831:b001:l035","ordinal":78573,"en":"The boy's body could not be found."},{"id":"manas-2010:p1831:b001:l036","ordinal":78574,"en":"“How can I reach my land?"},{"id":"manas-2010:p1831:b001:l037","ordinal":78575,"en":"My only child, here—"},{"id":"manas-2010:p1831:b001:l038","ordinal":78576,"en":"How can I leave without burying him?” he said."},{"id":"manas-2010:p1831:b001:l039","ordinal":78577,"en":"Kokboru wept bitterly"},{"id":"manas-2010:p1831:b001:l040","ordinal":78578,"en":"And was overcome with anguish."},{"id":"manas-2010:p1831:b001:l041","ordinal":78579,"en":"Külnaary came behind him;"},{"id":"manas-2010:p1831:b001:l042","ordinal":78580,"en":"She was Khan Karacha's daughter."},{"id":"manas-2010:p1832:b001:l001","ordinal":78581,"en":"She was the most skillful of women;"},{"id":"manas-2010:p1832:b001:l002","ordinal":78582,"en":"Consider her: she was a seer."},{"id":"manas-2010:p1832:b001:l003","ordinal":78583,"en":"She was a handmaid rich in wisdom."},{"id":"manas-2010:p1832:b001:l004","ordinal":78584,"en":"Külnaary, Boru's wife,"},{"id":"manas-2010:p1832:b001:l005","ordinal":78585,"en":"Whose wisdom surpassed others':"},{"id":"manas-2010:p1832:b001:l006","ordinal":78586,"en":"“To your friend, Sultan Manas,"},{"id":"manas-2010:p1832:b001:l007","ordinal":78587,"en":"Did you not consent, my sovereign?"},{"id":"manas-2010:p1832:b001:l008","ordinal":78588,"en":"Your only light from the nest—"},{"id":"manas-2010:p1832:b001:l009","ordinal":78589,"en":"When he asked for your light,"},{"id":"manas-2010:p1832:b001:l010","ordinal":78590,"en":"To your friend Manas, your lion,"},{"id":"manas-2010:p1832:b001:l011","ordinal":78591,"en":"Did you not give him, my sovereign?"},{"id":"manas-2010:p1832:b001:l012","ordinal":78592,"en":"Will grieving for your only child bring good?"}]
