[{"id":"manas-2010:p0677:b001:l009","ordinal":30209,"en":"A strong one came, a hero came;"},{"id":"manas-2010:p0677:b001:l010","ordinal":30210,"en":"My champion, through your good fortune,"},{"id":"manas-2010:p0677:b001:l011","ordinal":30211,"en":"Two falcon heroes came together."},{"id":"manas-2010:p0677:b001:l012","ordinal":30212,"en":"If you ask, you will find and know."},{"id":"manas-2010:p0677:b001:l013","ordinal":30213,"en":"‘Bakay has gathered heroes,’ you will say;"},{"id":"manas-2010:p0677:b001:l014","ordinal":30214,"en":"My sacred blue-maned one,"},{"id":"manas-2010:p0677:b001:l015","ordinal":30215,"en":"You will be grateful."},{"id":"manas-2010:p0677:b001:l016","ordinal":30216,"en":"Two exceptionally gifted people,"},{"id":"manas-2010:p0677:b001:l017","ordinal":30217,"en":"Moreover, they are Muslims;"},{"id":"manas-2010:p0677:b001:l018","ordinal":30218,"en":"They themselves follow Islam;"},{"id":"manas-2010:p0677:b001:l019","ordinal":30219,"en":"In essence, they are your inheritance."},{"id":"manas-2010:p0677:b001:l020","ordinal":30220,"en":"Let me tell you of one:"},{"id":"manas-2010:p0677:b001:l021","ordinal":30221,"en":"He is a singer who sings;"},{"id":"manas-2010:p0677:b001:l022","ordinal":30222,"en":"He is a blessing for you alone."},{"id":"manas-2010:p0677:b001:l023","ordinal":30223,"en":"If you care for him, he is a friend your equal;"},{"id":"manas-2010:p0677:b001:l024","ordinal":30224,"en":"Strange in manner, fierce in wrath,"},{"id":"manas-2010:p0677:b001:l025","ordinal":30225,"en":"He is a hero equal to you."},{"id":"manas-2010:p0677:b001:l026","ordinal":30226,"en":"Champions and lions,"},{"id":"manas-2010:p0677:b001:l027","ordinal":30227,"en":"Allah Most High, the Almighty,"},{"id":"manas-2010:p0677:b001:l028","ordinal":30228,"en":"Now grants them to you."},{"id":"manas-2010:p0677:b001:l029","ordinal":30229,"en":"If you listen well to my words,"},{"id":"manas-2010:p0677:b001:l030","ordinal":30230,"en":"All those who come"},{"id":"manas-2010:p0677:b001:l031","ordinal":30231,"en":"Will be an inheritance for you."},{"id":"manas-2010:p0677:b001:l032","ordinal":30232,"en":"Fighting and exchanging shots,"},{"id":"manas-2010:p0677:b001:l033","ordinal":30233,"en":"You made a spectacle in Altay."},{"id":"manas-2010:p0677:b001:l034","ordinal":30234,"en":"The forty companions you had gathered,"},{"id":"manas-2010:p0677:b001:l035","ordinal":30235,"en":"By Esenkan's champion,"},{"id":"manas-2010:p0677:b001:l036","ordinal":30236,"en":"Great Zholoy, you had them slaughtered."},{"id":"manas-2010:p0677:b001:l037","ordinal":30237,"en":"‘I am utterly alone,’ you said,"},{"id":"manas-2010:p0677:b001:l038","ordinal":30238,"en":"And wandered in sorrow."},{"id":"manas-2010:p0677:b001:l039","ordinal":30239,"en":"Champions your equal,"},{"id":"manas-2010:p0677:b001:l040","ordinal":30240,"en":"Throwing the world into turmoil,"},{"id":"manas-2010:p0677:b001:l041","ordinal":30241,"en":"Merciless mighty men,"},{"id":"manas-2010:p0677:b001:l042","ordinal":30242,"en":"Upon your head visited by Kydyr,"},{"id":"manas-2010:p0678:b001:l001","ordinal":30243,"en":"They have been found as companions."},{"id":"manas-2010:p0678:b001:l002","ordinal":30244,"en":"Born alone in Altay,"},{"id":"manas-2010:p0678:b001:l003","ordinal":30245,"en":"It was the doing of Allah alone."},{"id":"manas-2010:p0678:b001:l004","ordinal":30246,"en":"Do not regret, saying, ‘I am alone.’"},{"id":"manas-2010:p0678:b001:l005","ordinal":30247,"en":"Your kinsmen will number eighty-four."},{"id":"manas-2010:p0678:b001:l006","ordinal":30248,"en":"The world's four corners,"},{"id":"manas-2010:p0678:b001:l007","ordinal":30249,"en":"If you clash, you will lay them waste."},{"id":"manas-2010:p0678:b001:l008","ordinal":30250,"en":"You will drain those who grapple with you."},{"id":"manas-2010:p0678:b001:l009","ordinal":30251,"en":"While your precious head remains,"},{"id":"manas-2010:p0678:b001:l010","ordinal":30252,"en":"You will be khan of the world.”"},{"id":"manas-2010:p0678:b001:l011","ordinal":30253,"en":"Before Khan Bakay finished speaking,"},{"id":"manas-2010:p0678:b001:l012","ordinal":30254,"en":"Before he closed his mouth,"},{"id":"manas-2010:p0678:b001:l013","ordinal":30255,"en":"Before one could say this or that,"},{"id":"manas-2010:p0678:b001:l014","ordinal":30256,"en":"In the opening and closing of an eye,"},{"id":"manas-2010:p0678:b001:l015","ordinal":30257,"en":"Azhybay, Argyn Khan's son,"},{"id":"manas-2010:p0678:b001:l016","ordinal":30258,"en":"Brought two people."},{"id":"manas-2010:p0678:b001:l017","ordinal":30259,"en":"Of middling height, broad-shouldered,"},{"id":"manas-2010:p0678:b001:l018","ordinal":30260,"en":"They were heroes who would shatter the Oirat."},{"id":"manas-2010:p0678:b001:l019","ordinal":30261,"en":"For service as companions, Azhybay,"},{"id":"manas-2010:p0678:b001:l020","ordinal":30262,"en":"Escorting both people,"},{"id":"manas-2010:p0678:b001:l021","ordinal":30263,"en":"Had brought them there."},{"id":"manas-2010:p0678:b001:l022","ordinal":30264,"en":"Azhybay, Argyn Khan's son,"},{"id":"manas-2010:p0678:b001:l023","ordinal":30265,"en":"Bending his knees toward the ground,"},{"id":"manas-2010:p0678:b001:l024","ordinal":30266,"en":"From atop Kartküröng,"},{"id":"manas-2010:p0678:b001:l025","ordinal":30267,"en":"Flew down and ran."},{"id":"manas-2010:p0678:b001:l026","ordinal":30268,"en":"Before Khan Manas,"},{"id":"manas-2010:p0678:b001:l027","ordinal":30269,"en":"He bowed and gave greeting:"},{"id":"manas-2010:p0678:b001:l028","ordinal":30270,"en":"“You are Manas, you are a lion;"},{"id":"manas-2010:p0678:b001:l029","ordinal":30271,"en":"My falcon visited by Kydyr,"},{"id":"manas-2010:p0678:b001:l030","ordinal":30272,"en":"You are father to all."},{"id":"manas-2010:p0678:b001:l031","ordinal":30273,"en":"They came from the unseen;"},{"id":"manas-2010:p0678:b001:l032","ordinal":30274,"en":"From the unknown yellow steppe,"},{"id":"manas-2010:p0678:b001:l033","ordinal":30275,"en":"To become your friends,"},{"id":"manas-2010:p0678:b001:l034","ordinal":30276,"en":"Two champions have been found."},{"id":"manas-2010:p0678:b001:l035","ordinal":30277,"en":"Among skillful spearmen,"},{"id":"manas-2010:p0678:b001:l036","ordinal":30278,"en":"When you attack a shouting enemy,"},{"id":"manas-2010:p0678:b001:l037","ordinal":30279,"en":"They will die together with you,"},{"id":"manas-2010:p0678:b001:l038","ordinal":30280,"en":"Among the merciless mighty ones."},{"id":"manas-2010:p0678:b001:l039","ordinal":30281,"en":"Your honor is wholly sheltered."},{"id":"manas-2010:p0678:b001:l040","ordinal":30282,"en":"My lion, through your good fortune,"},{"id":"manas-2010:p0678:b001:l041","ordinal":30283,"en":"Two lions have been found."},{"id":"manas-2010:p0678:b001:l042","ordinal":30284,"en":"I found two young men,"},{"id":"manas-2010:p0679:b001:l001","ordinal":30285,"en":"They are gifts, they are lions;"},{"id":"manas-2010:p0679:b001:l002","ordinal":30286,"en":"My champion, through your good fortune,"},{"id":"manas-2010:p0679:b001:l003","ordinal":30287,"en":"They are heroes who will be steadfast companions."},{"id":"manas-2010:p0679:b001:l004","ordinal":30288,"en":"Like Venus and the Pleiades,"},{"id":"manas-2010:p0679:b001:l005","ordinal":30289,"en":"They show the makings of guides."},{"id":"manas-2010:p0679:b001:l006","ordinal":30290,"en":"Sharing death, joined in life,"},{"id":"manas-2010:p0679:b001:l007","ordinal":30291,"en":"They show the makings of companions."},{"id":"manas-2010:p0679:b001:l008","ordinal":30292,"en":"Keeping a court and keeping a home,"},{"id":"manas-2010:p0679:b001:l009","ordinal":30293,"en":"They are heroes who will settle with you."},{"id":"manas-2010:p0679:b001:l010","ordinal":30294,"en":"My lion, your true companions,"},{"id":"manas-2010:p0679:b001:l011","ordinal":30295,"en":"They are heroes who will become them."},{"id":"manas-2010:p0679:b001:l012","ordinal":30296,"en":"Their prowess is extraordinary;"},{"id":"manas-2010:p0679:b001:l013","ordinal":30297,"en":"I found two valiant men,"},{"id":"manas-2010:p0679:b001:l014","ordinal":30298,"en":"Peerless ones who will shake the world."},{"id":"manas-2010:p0679:b001:l015","ordinal":30299,"en":"‘Warrior companion’ is a harsh word;"},{"id":"manas-2010:p0679:b001:l016","ordinal":30300,"en":"Take them as friends."},{"id":"manas-2010:p0679:b001:l017","ordinal":30301,"en":"Destroying those you encounter,"},{"id":"manas-2010:p0679:b001:l018","ordinal":30302,"en":"Now slaughter them."},{"id":"manas-2010:p0679:b001:l019","ordinal":30303,"en":"They are comfort, they are lions;"},{"id":"manas-2010:p0679:b001:l020","ordinal":30304,"en":"To satisfy your deepest longing,"},{"id":"manas-2010:p0679:b001:l021","ordinal":30305,"en":"They are lions without equal."},{"id":"manas-2010:p0679:b001:l022","ordinal":30306,"en":"To your head of surpassing fortune,"},{"id":"manas-2010:p0679:b001:l023","ordinal":30307,"en":"They come from the unseen."},{"id":"manas-2010:p0679:b001:l024","ordinal":30308,"en":"From nowhere, champions are found."},{"id":"manas-2010:p0679:b001:l025","ordinal":30309,"en":"They are companions, they are support;"},{"id":"manas-2010:p0679:b001:l026","ordinal":30310,"en":"They are heroes who understand your ways."},{"id":"manas-2010:p0679:b001:l027","ordinal":30311,"en":"Their service will fulfill your wish."},{"id":"manas-2010:p0679:b001:l028","ordinal":30312,"en":"If you care for the two,"},{"id":"manas-2010:p0679:b001:l029","ordinal":30313,"en":"Their conduct will soothe your soul."},{"id":"manas-2010:p0679:b001:l030","ordinal":30314,"en":"With honest intent and faithful service,"},{"id":"manas-2010:p0679:b001:l031","ordinal":30315,"en":"They are heroes who will serve."},{"id":"manas-2010:p0679:b001:l032","ordinal":30316,"en":"In great strife that brings havoc,"},{"id":"manas-2010:p0679:b001:l033","ordinal":30317,"en":"In great slaughter where blood is spilled,"},{"id":"manas-2010:p0679:b001:l034","ordinal":30318,"en":"When it grows fierce and all is shattered,"},{"id":"manas-2010:p0679:b001:l035","ordinal":30319,"en":"Beneath the banner, without moving,"},{"id":"manas-2010:p0679:b001:l036","ordinal":30320,"en":"They are heroes who will stand."},{"id":"manas-2010:p0679:b001:l037","ordinal":30321,"en":"For you, noble blue-maned falcon,"},{"id":"manas-2010:p0679:b001:l038","ordinal":30322,"en":"They will be companions."},{"id":"manas-2010:p0679:b001:l039","ordinal":30323,"en":"Their excellence is truly proven."},{"id":"manas-2010:p0679:b001:l040","ordinal":30324,"en":"If you make the two your companions,"},{"id":"manas-2010:p0679:b001:l041","ordinal":30325,"en":"They will be supports equal to you.”"},{"id":"manas-2010:p0679:b001:l042","ordinal":30326,"en":"Azhybay spoke these words;"},{"id":"manas-2010:p0680:b001:l001","ordinal":30327,"en":"Before he closed his mouth,"},{"id":"manas-2010:p0680:b001:l002","ordinal":30328,"en":"The sight stirred the heart."},{"id":"manas-2010:p0680:b001:l003","ordinal":30329,"en":"To the blue-maned lion himself,"},{"id":"manas-2010:p0680:b001:l004","ordinal":30330,"en":"Two lions appeared."},{"id":"manas-2010:p0680:b001:l005","ordinal":30331,"en":"One was hero Shuutu, his cap like a yurt's felt cover,"},{"id":"manas-2010:p0680:b001:l006","ordinal":30332,"en":"The noble falcon of humankind."},{"id":"manas-2010:p0680:b001:l007","ordinal":30333,"en":"If you ask about his father,"},{"id":"manas-2010:p0680:b001:l008","ordinal":30334,"en":"He was the son of England's khan:"},{"id":"manas-2010:p0680:b001:l009","ordinal":30335,"en":"“Seeing Manas in my dream,"},{"id":"manas-2010:p0680:b001:l010","ordinal":30336,"en":"I longed for you yourself,"},{"id":"manas-2010:p0680:b001:l011","ordinal":30337,"en":"Pleased by your words."},{"id":"manas-2010:p0680:b001:l012","ordinal":30338,"en":"Unable to bear my longing,"},{"id":"manas-2010:p0680:b001:l013","ordinal":30339,"en":"I entered Russia in excitement."},{"id":"manas-2010:p0680:b001:l014","ordinal":30340,"en":"My destroyer, to you yourself,"},{"id":"manas-2010:p0680:b001:l015","ordinal":30341,"en":"Today I have come and met you."},{"id":"manas-2010:p0680:b001:l016","ordinal":30342,"en":"I fled my village and wandered astray."},{"id":"manas-2010:p0680:b001:l017","ordinal":30343,"en":"Hearing much of you as lion and hero,"},{"id":"manas-2010:p0680:b001:l018","ordinal":30344,"en":"I came expressly to join you."},{"id":"manas-2010:p0680:b001:l019","ordinal":30345,"en":"In secluded tracts of steppe,"},{"id":"manas-2010:p0680:b001:l020","ordinal":30346,"en":"I wandered there for six years."},{"id":"manas-2010:p0680:b001:l021","ordinal":30347,"en":"Seeing you in my dream,"},{"id":"manas-2010:p0680:b001:l022","ordinal":30348,"en":"I knew my longing for you.”"},{"id":"manas-2010:p0680:b001:l023","ordinal":30349,"en":"Hero Shuutu spoke these words"},{"id":"manas-2010:p0680:b001:l024","ordinal":30350,"en":"And joined the blue-maned one's company."},{"id":"manas-2010:p0680:b001:l025","ordinal":30351,"en":"One was Yraman's singer son,"},{"id":"manas-2010:p0680:b001:l026","ordinal":30352,"en":"His drawstring tasselled, with forty knots,"},{"id":"manas-2010:p0680:b001:l027","ordinal":30353,"en":"The slave whose fur cap bore a tuft,"},{"id":"manas-2010:p0680:b001:l028","ordinal":30354,"en":"The slave whose speaking mouth was bold."},{"id":"manas-2010:p0680:b001:l029","ordinal":30355,"en":"He was still young in years."},{"id":"manas-2010:p0680:b001:l030","ordinal":30356,"en":"If difficult trouble arose,"},{"id":"manas-2010:p0680:b001:l031","ordinal":30357,"en":"Beside falcon Manas,"},{"id":"manas-2010:p0680:b001:l032","ordinal":30358,"en":"At his side he would sing."},{"id":"manas-2010:p0680:b001:l033","ordinal":30359,"en":"The boldest of the young men,"},{"id":"manas-2010:p0680:b001:l034","ordinal":30360,"en":"Yraman's singer son,"},{"id":"manas-2010:p0680:b001:l035","ordinal":30361,"en":"Was the best among many."},{"id":"manas-2010:p0680:b001:l036","ordinal":30362,"en":"If there were crooked, slanting words,"},{"id":"manas-2010:p0680:b001:l037","ordinal":30363,"en":"He understood without missing a flicker."},{"id":"manas-2010:p0680:b001:l038","ordinal":30364,"en":"If trouble came upon one's head,"},{"id":"manas-2010:p0680:b001:l039","ordinal":30365,"en":"Unless a person were dead,"},{"id":"manas-2010:p0680:b001:l040","ordinal":30366,"en":"Every living person would laugh."},{"id":"manas-2010:p0680:b001:l041","ordinal":30367,"en":"The signs of things to come,"},{"id":"manas-2010:p0680:b001:l042","ordinal":30368,"en":"That merry young man,"},{"id":"manas-2010:p0681:b001:l001","ordinal":30369,"en":"Would undo sorrowful affairs,"},{"id":"manas-2010:p0681:b001:l002","ordinal":30370,"en":"Would make valiant men laugh."},{"id":"manas-2010:p0681:b001:l003","ordinal":30371,"en":"The descendant of a known place,"},{"id":"manas-2010:p0681:b001:l004","ordinal":30372,"en":"As for his father's origin,"},{"id":"manas-2010:p0681:b001:l005","ordinal":30373,"en":"He came of the Russian people."},{"id":"manas-2010:p0681:b001:l006","ordinal":30374,"en":"The singer who broke through crowds,"},{"id":"manas-2010:p0681:b001:l007","ordinal":30375,"en":"Of blood-drinking leopard Manas,"},{"id":"manas-2010:p0681:b001:l008","ordinal":30376,"en":"He would stand beneath the banner."},{"id":"manas-2010:p0681:b001:l009","ordinal":30377,"en":"Coming from the unseen,"},{"id":"manas-2010:p0681:b001:l010","ordinal":30378,"en":"Driven by God, destined to share salt,"},{"id":"manas-2010:p0681:b001:l011","ordinal":30379,"en":"He was found for Khan Manas."},{"id":"manas-2010:p0681:b001:l012","ordinal":30380,"en":"Sent ahead, they brought good fortune;"},{"id":"manas-2010:p0681:b001:l013","ordinal":30381,"en":"These four exceptional companions,"},{"id":"manas-2010:p0681:b001:l014","ordinal":30382,"en":"Following behind, were his countless army."},{"id":"manas-2010:p0681:b001:l015","ordinal":30383,"en":"Mending what had broken,"},{"id":"manas-2010:p0681:b001:l016","ordinal":30384,"en":"Gathering what had scattered,"},{"id":"manas-2010:p0681:b001:l017","ordinal":30385,"en":"Hero Manas's champions,"},{"id":"manas-2010:p0681:b001:l018","ordinal":30386,"en":"Azhybay, Bakay, hero Shuutu,"},{"id":"manas-2010:p0681:b001:l019","ordinal":30387,"en":"And Yraman's singer son,"},{"id":"manas-2010:p0681:b001:l020","ordinal":30388,"en":"Were your blood-drinker's mighty men."},{"id":"manas-2010:p0681:b001:l021","ordinal":30389,"en":"All the mighty heroes"},{"id":"manas-2010:p0681:b001:l022","ordinal":30390,"en":"Were the blue-maned hero's retainers."},{"id":"manas-2010:p0681:b001:l023","ordinal":30391,"en":"Knowing men, cultivators of wisdom,"},{"id":"manas-2010:p0681:b001:l024","ordinal":30392,"en":"Came and met the lion."},{"id":"manas-2010:p0681:b001:l025","ordinal":30393,"en":"Spearmen who could hook their foes,"},{"id":"manas-2010:p0681:b001:l026","ordinal":30394,"en":"Those who faced multitudes alone,"},{"id":"manas-2010:p0681:b001:l027","ordinal":30395,"en":"Came to the blood-drinking lion,"},{"id":"manas-2010:p0681:b001:l028","ordinal":30396,"en":"Mighty men who rode alone."},{"id":"manas-2010:p0681:b001:l029","ordinal":30397,"en":"Shuutu and the Singer were met;"},{"id":"manas-2010:p0681:b001:l030","ordinal":30398,"en":"Honor was sheltered, not laid bare."},{"id":"manas-2010:p0681:b001:l031","ordinal":30399,"en":"For Manas, visited by Kydyr,"},{"id":"manas-2010:p0681:b001:l032","ordinal":30400,"en":"All the falcon heroes were found."},{"id":"manas-2010:p0681:b001:l033","ordinal":30401,"en":"His solitary life became five;"},{"id":"manas-2010:p0681:b001:l034","ordinal":30402,"en":"Your blue-maned one now turned back."},{"id":"manas-2010:p0681:b001:l035","ordinal":30403,"en":"Taking booty from the Russians,"},{"id":"manas-2010:p0681:b001:l036","ordinal":30404,"en":"He now returned with Akkelte."},{"id":"manas-2010:p0681:b001:l037","ordinal":30405,"en":"Having seized it from the steppe,"},{"id":"manas-2010:p0681:b001:l038","ordinal":30406,"en":"Your falcon of surpassing fortune"},{"id":"manas-2010:p0681:b001:l039","ordinal":30407,"en":"Now turned back from the steppe."},{"id":"manas-2010:p0681:b001:l040","ordinal":30408,"en":"Heading toward Ala-Too,"},{"id":"manas-2010:p0681:b001:l041","ordinal":30409,"en":"Sparing no horses, traveling far,"},{"id":"manas-2010:p0681:b001:l042","ordinal":30410,"en":"What he wished for coming late,"},{"id":"manas-2010:p0682:b001:l001","ordinal":30411,"en":"His solitary life became five."},{"id":"manas-2010:p0682:b001:l002","ordinal":30412,"en":"He had lords, he had khans;"},{"id":"manas-2010:p0682:b001:l003","ordinal":30413,"en":"Making the unknown known,"},{"id":"manas-2010:p0682:b001:l004","ordinal":30414,"en":"Alone like a countless army,"},{"id":"manas-2010:p0682:b001:l005","ordinal":30415,"en":"He had learned old Bakay;"},{"id":"manas-2010:p0682:b001:l006","ordinal":30416,"en":"He had all the knowing men."},{"id":"manas-2010:p0682:b001:l007","ordinal":30417,"en":"Settling the land of broad Talas,"},{"id":"manas-2010:p0682:b001:l008","ordinal":30418,"en":"Lord Manas, the sultan,"},{"id":"manas-2010:p0682:b001:l009","ordinal":30419,"en":"They raised as khan, binding their resolve."},{"id":"manas-2010:p0682:b001:l010","ordinal":30420,"en":"What had broken was joined again;"},{"id":"manas-2010:p0682:b001:l011","ordinal":30421,"en":"Warrior Bakay, the champion, was there."},{"id":"manas-2010:p0682:b001:l012","ordinal":30422,"en":"The blue-maned Lord Manas"},{"id":"manas-2010:p0682:b001:l013","ordinal":30423,"en":"They raised as khan with joy."},{"id":"manas-2010:p0682:b001:l014","ordinal":30424,"en":"Horses grew fat and fit;"},{"id":"manas-2010:p0682:b001:l015","ordinal":30425,"en":"Heroes gathered and numbered forty."},{"id":"manas-2010:p0682:b001:l016","ordinal":30426,"en":"All the blue-maned ones came;"},{"id":"manas-2010:p0682:b001:l017","ordinal":30427,"en":"Champions heard the news."},{"id":"manas-2010:p0682:b001:l018","ordinal":30428,"en":"Making Talas their home,"},{"id":"manas-2010:p0682:b001:l019","ordinal":30429,"en":"It was the time he brought them there."},{"id":"manas-2010:p0682:b001:l020","ordinal":30430,"en":"Bringing those who faced him under his rule,"},{"id":"manas-2010:p0682:b001:l021","ordinal":30431,"en":"Your blue-maned champion Manas"},{"id":"manas-2010:p0682:b001:l022","ordinal":30432,"en":"Had swept them down."},{"id":"manas-2010:p0682:b001:l023","ordinal":30433,"en":"Touched by Kydyr, many"},{"id":"manas-2010:p0682:b001:l024","ordinal":30434,"en":"He was taking in."},{"id":"manas-2010:p0682:b001:l025","ordinal":30435,"en":"To many, the tale"},{"id":"manas-2010:p0682:b001:l026","ordinal":30436,"en":"He was telling."},{"id":"manas-2010:p0682:b001:l027","ordinal":30437,"en":"He had champions, he had khans;"},{"id":"manas-2010:p0682:b001:l028","ordinal":30438,"en":"Twelve who together gave their hands,"},{"id":"manas-2010:p0682:b001:l029","ordinal":30439,"en":"And Bakay the destroyer was there too."},{"id":"manas-2010:p0682:b001:l030","ordinal":30440,"en":"When bored, they hunted roe deer;"},{"id":"manas-2010:p0682:b001:l031","ordinal":30441,"en":"When not bored, they lay at ease."},{"id":"manas-2010:p0682:b001:l032","ordinal":30442,"en":"The Argyn and Kyrgyz turned toward the lowlands;"},{"id":"manas-2010:p0682:b001:l033","ordinal":30443,"en":"In Talas, as of old,"},{"id":"manas-2010:p0682:b001:l034","ordinal":30444,"en":"They had settled down."},{"id":"manas-2010:p0682:b001:l035","ordinal":30445,"en":"Fermented mare's milk by day, girls by night—"},{"id":"manas-2010:p0682:b001:l036","ordinal":30446,"en":"Such had become their days."},{"id":"manas-2010:p0682:b001:l037","ordinal":30447,"en":"A lion supported by Saint Shay,"},{"id":"manas-2010:p0682:b001:l038","ordinal":30448,"en":"All twelve members evenly formed,"},{"id":"manas-2010:p0682:b001:l039","ordinal":30449,"en":"Dust rising from his movements,"},{"id":"manas-2010:p0682:b001:l040","ordinal":30450,"en":"His champion's nature showed."},{"id":"manas-2010:p0682:b001:l041","ordinal":30451,"en":"At his voice, souls fled;"},{"id":"manas-2010:p0682:b001:l042","ordinal":30452,"en":"Driving white deer and making them cattle,"},{"id":"manas-2010:p0683:b001:l001","ordinal":30453,"en":"Throwing those who grappled with him into turmoil,"},{"id":"manas-2010:p0683:b001:l002","ordinal":30454,"en":"Chasing gray deer and making them cattle,"},{"id":"manas-2010:p0683:b001:l003","ordinal":30455,"en":"Throwing his chosen enemies into turmoil,"},{"id":"manas-2010:p0683:b001:l004","ordinal":30456,"en":"Setting fire to grassy land,"},{"id":"manas-2010:p0683:b001:l005","ordinal":30457,"en":"Kindling the land of dry grass,"},{"id":"manas-2010:p0683:b001:l006","ordinal":30458,"en":"Gathering sand and making it stone,"},{"id":"manas-2010:p0683:b001:l007","ordinal":30459,"en":"Falcon Manas, the blue-maned hero,"},{"id":"manas-2010:p0683:b001:l008","ordinal":30460,"en":"Gathered slaves and made them leaders."},{"id":"manas-2010:p0683:b001:l009","ordinal":30461,"en":"Taking Talas as his own land,"},{"id":"manas-2010:p0683:b001:l010","ordinal":30462,"en":"The few people, worn and scattered,"},{"id":"manas-2010:p0683:b001:l011","ordinal":30463,"en":"He gathered again and made a nation."},{"id":"manas-2010:p0683:b001:l012","ordinal":30464,"en":"Your falcon visited by Kydyr"}]
