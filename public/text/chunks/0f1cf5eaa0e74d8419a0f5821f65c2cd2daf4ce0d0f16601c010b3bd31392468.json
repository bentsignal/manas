[{"id":"manas-2010:p1477:b001:l040","ordinal":63745,"en":"If death is due, let us die!"},{"id":"manas-2010:p1477:b001:l041","ordinal":63746,"en":"While we remain alive, undying,"},{"id":"manas-2010:p1477:b001:l042","ordinal":63747,"en":"The Muslims who followed us—"},{"id":"manas-2010:p1478:b001:l001","ordinal":63748,"en":"To the Chinese and Manchus,"},{"id":"manas-2010:p1478:b001:l002","ordinal":63749,"en":"How can we give them up as spoils!"},{"id":"manas-2010:p1478:b001:l003","ordinal":63750,"en":"If we abandon the vast army and flee,"},{"id":"manas-2010:p1478:b001:l004","ordinal":63751,"en":"Will they not lay the guilt upon us?"},{"id":"manas-2010:p1478:b001:l005","ordinal":63752,"en":"Will they not suffer terrible misery?"},{"id":"manas-2010:p1478:b001:l006","ordinal":63753,"en":"Will they not all be thrown into turmoil?"},{"id":"manas-2010:p1478:b001:l007","ordinal":63754,"en":"Will they not be pursued as far as Mecca?"},{"id":"manas-2010:p1478:b001:l008","ordinal":63755,"en":"Will the Muslims not be slaughtered?"},{"id":"manas-2010:p1478:b001:l009","ordinal":63756,"en":"Will the plunder not be seized?"},{"id":"manas-2010:p1478:b001:l010","ordinal":63757,"en":"Will the Chinese not wreak havoc!"},{"id":"manas-2010:p1478:b001:l011","ordinal":63758,"en":"‘They let the Muslims be slaughtered,"},{"id":"manas-2010:p1478:b001:l012","ordinal":63759,"en":"And the forty companions fled,’ they will say:"},{"id":"manas-2010:p1478:b001:l013","ordinal":63760,"en":"An evil name in this world!"},{"id":"manas-2010:p1478:b001:l014","ordinal":63761,"en":"When we reach the hereafter,"},{"id":"manas-2010:p1478:b001:l015","ordinal":63762,"en":"The countless slaughtered Muslims—"},{"id":"manas-2010:p1478:b001:l016","ordinal":63763,"en":"Will they not seize us by the collar?"},{"id":"manas-2010:p1478:b001:l017","ordinal":63764,"en":"For the descendants left behind,"},{"id":"manas-2010:p1478:b001:l018","ordinal":63765,"en":"Will not that evil name remain!"},{"id":"manas-2010:p1478:b001:l019","ordinal":63766,"en":"Alas, forty companions,"},{"id":"manas-2010:p1478:b001:l020","ordinal":63767,"en":"You forty were lions from forty places;"},{"id":"manas-2010:p1478:b001:l021","ordinal":63768,"en":"To fierce, blue-maned Manas,"},{"id":"manas-2010:p1478:b001:l022","ordinal":63769,"en":"Which of you was inferior?"},{"id":"manas-2010:p1478:b001:l023","ordinal":63770,"en":"‘While the forty companions live,"},{"id":"manas-2010:p1478:b001:l024","ordinal":63771,"en":"I shall not suffer at the enemy's hands’—"},{"id":"manas-2010:p1478:b001:l025","ordinal":63772,"en":"That was the hope I cherished."},{"id":"manas-2010:p1478:b001:l026","ordinal":63773,"en":"Upon the Chinese and Manchus"},{"id":"manas-2010:p1478:b001:l027","ordinal":63774,"en":"Let us bring a terrible slaughter;"},{"id":"manas-2010:p1478:b001:l028","ordinal":63775,"en":"Fierce, blue-maned Manas—"},{"id":"manas-2010:p1478:b001:l029","ordinal":63776,"en":"Let us rescue him."},{"id":"manas-2010:p1478:b001:l030","ordinal":63777,"en":"Truly making our word firm,"},{"id":"manas-2010:p1478:b001:l031","ordinal":63778,"en":"Lion-born Chubak,"},{"id":"manas-2010:p1478:b001:l032","ordinal":63779,"en":"In Khan Manas's place,"},{"id":"manas-2010:p1478:b001:l033","ordinal":63780,"en":"Let us raise as khan;"},{"id":"manas-2010:p1478:b001:l034","ordinal":63781,"en":"From the Muslims encamped here,"},{"id":"manas-2010:p1478:b001:l035","ordinal":63782,"en":"Let us choose the finest steeds to ride;"},{"id":"manas-2010:p1478:b001:l036","ordinal":63783,"en":"Upon the Manchus, Chinese and Kalmyks,"},{"id":"manas-2010:p1478:b001:l037","ordinal":63784,"en":"Let us strike like falcons!"},{"id":"manas-2010:p1478:b001:l038","ordinal":63785,"en":"Stained with red blood,"},{"id":"manas-2010:p1478:b001:l039","ordinal":63786,"en":"Slaughtering and cutting down the Chinese,"},{"id":"manas-2010:p1478:b001:l040","ordinal":63787,"en":"To the foot of Inner Beijing,"},{"id":"manas-2010:p1478:b001:l041","ordinal":63788,"en":"Let us drive and press them back."},{"id":"manas-2010:p1478:b001:l042","ordinal":63789,"en":"Kongurbay, khan of the monks—"},{"id":"manas-2010:p1479:b001:l001","ordinal":63790,"en":"If we encounter him,"},{"id":"manas-2010:p1479:b001:l002","ordinal":63791,"en":"Let us take him alive;"},{"id":"manas-2010:p1479:b001:l003","ordinal":63792,"en":"Before Khan Manas,"},{"id":"manas-2010:p1479:b001:l004","ordinal":63793,"en":"Bringing the grim-faced one,"},{"id":"manas-2010:p1479:b001:l005","ordinal":63794,"en":"Let us rip his belly open;"},{"id":"manas-2010:p1479:b001:l006","ordinal":63795,"en":"Pulling out his lungs,"},{"id":"manas-2010:p1479:b001:l007","ordinal":63796,"en":"Let us wave them as an offering!"},{"id":"manas-2010:p1479:b001:l008","ordinal":63797,"en":"My dear forty companions,"},{"id":"manas-2010:p1479:b001:l009","ordinal":63798,"en":"Whatever happens, let us die!"},{"id":"manas-2010:p1479:b001:l010","ordinal":63799,"en":"Let us not return alive from Beijing;"},{"id":"manas-2010:p1479:b001:l011","ordinal":63800,"en":"If a day of dire hardship comes,"},{"id":"manas-2010:p1479:b001:l012","ordinal":63801,"en":"Let none of us turn and flee!"},{"id":"manas-2010:p1479:b001:l013","ordinal":63802,"en":"If our champion falls to a bullet,"},{"id":"manas-2010:p1479:b001:l014","ordinal":63803,"en":"That means his resolve was weak;"},{"id":"manas-2010:p1479:b001:l015","ordinal":63804,"en":"Let us not stand looking back!”"},{"id":"manas-2010:p1479:b001:l016","ordinal":63805,"en":"Do you think it was only the companions?"},{"id":"manas-2010:p1479:b001:l017","ordinal":63806,"en":"There were Muzburchak and Khan Kökchö,"},{"id":"manas-2010:p1479:b001:l018","ordinal":63807,"en":"The Eshteks' Zhamgyrchy,"},{"id":"manas-2010:p1479:b001:l019","ordinal":63808,"en":"And Kökötöy's Bokmurun—"},{"id":"manas-2010:p1479:b001:l020","ordinal":63809,"en":"Those two champions were there as well."},{"id":"manas-2010:p1479:b001:l021","ordinal":63810,"en":"Taking Almambet's words"},{"id":"manas-2010:p1479:b001:l022","ordinal":63811,"en":"As support and encouragement,"},{"id":"manas-2010:p1479:b001:l023","ordinal":63812,"en":"Like their leopard Manas,"},{"id":"manas-2010:p1479:b001:l024","ordinal":63813,"en":"They took him as their protector and lion:"},{"id":"manas-2010:p1479:b001:l025","ordinal":63814,"en":"“That will be good!” they said,"},{"id":"manas-2010:p1479:b001:l026","ordinal":63815,"en":"Raising their hands and shouting;"},{"id":"manas-2010:p1479:b001:l027","ordinal":63816,"en":"To fight the enemy to destruction,"},{"id":"manas-2010:p1479:b001:l028","ordinal":63817,"en":"They all rose with a roar."},{"id":"manas-2010:p1479:b001:l029","ordinal":63818,"en":"“What you have said is wise,” they said;"},{"id":"manas-2010:p1479:b001:l030","ordinal":63819,"en":"“That will be good, hero,” they said;"},{"id":"manas-2010:p1479:b001:l031","ordinal":63820,"en":"“Even if he survives and lives,"},{"id":"manas-2010:p1479:b001:l032","ordinal":63821,"en":"What aim will he attain?” they said."},{"id":"manas-2010:p1479:b001:l033","ordinal":63822,"en":"“Whoever should turn and flee,"},{"id":"manas-2010:p1479:b001:l034","ordinal":63823,"en":"May he become an infidel, betray the faith,"},{"id":"manas-2010:p1479:b001:l035","ordinal":63824,"en":"And die without belief!” they said."},{"id":"manas-2010:p1479:b001:l036","ordinal":63825,"en":"Chewing white wheat flour,"},{"id":"manas-2010:p1479:b001:l037","ordinal":63826,"en":"Taking hold of the holy Quran,"},{"id":"manas-2010:p1479:b001:l038","ordinal":63827,"en":"All together they rose with a clamor"},{"id":"manas-2010:p1479:b001:l039","ordinal":63828,"en":"And now pronounced the solemn prayer."},{"id":"manas-2010:p1479:b001:l040","ordinal":63829,"en":"Hero Serek came with news,"},{"id":"manas-2010:p1479:b001:l041","ordinal":63830,"en":"Hurrying, breathless, he arrived:"},{"id":"manas-2010:p1479:b001:l042","ordinal":63831,"en":"“Are you lying idle, Muslims?"},{"id":"manas-2010:p1480:b001:l001","ordinal":63832,"en":"A broad-dug pit has come;"},{"id":"manas-2010:p1480:b001:l002","ordinal":63833,"en":"Unlike our palm-sized force,"},{"id":"manas-2010:p1480:b001:l003","ordinal":63834,"en":"From the countless Chinese and Manchus,"},{"id":"manas-2010:p1480:b001:l004","ordinal":63835,"en":"With Kongurbay at their head,"},{"id":"manas-2010:p1480:b001:l005","ordinal":63836,"en":"An army covering the world has come!"},{"id":"manas-2010:p1480:b001:l006","ordinal":63837,"en":"Valiant Almambet, my fierce champion,"},{"id":"manas-2010:p1480:b001:l007","ordinal":63838,"en":"Earth flies up, a dust cloud has come;"},{"id":"manas-2010:p1480:b001:l008","ordinal":63839,"en":"Surging, the Chinese are on the move;"},{"id":"manas-2010:p1480:b001:l009","ordinal":63840,"en":"In tumult, their army has come."},{"id":"manas-2010:p1480:b001:l010","ordinal":63841,"en":"Not merely one, but all of them—"},{"id":"manas-2010:p1480:b001:l011","ordinal":63842,"en":"An uncountable multitude has come!”"},{"id":"manas-2010:p1480:b001:l012","ordinal":63843,"en":"Bringing the news, hero Serek"},{"id":"manas-2010:p1480:b001:l013","ordinal":63844,"en":"Proclaimed it to the people."},{"id":"manas-2010:p1480:b001:l014","ordinal":63845,"en":"After hearing this,"},{"id":"manas-2010:p1480:b001:l015","ordinal":63846,"en":"Among all the Muslims,"},{"id":"manas-2010:p1480:b001:l016","ordinal":63847,"en":"Those with courage rejoiced;"},{"id":"manas-2010:p1480:b001:l017","ordinal":63848,"en":"The feeble ones without courage,"},{"id":"manas-2010:p1480:b001:l018","ordinal":63849,"en":"With pitch-dark night descending on them,"},{"id":"manas-2010:p1480:b001:l019","ordinal":63850,"en":"Grieved and burned with anguish."},{"id":"manas-2010:p1480:b001:l020","ordinal":63851,"en":"All their heroes"},{"id":"manas-2010:p1480:b001:l021","ordinal":63852,"en":"Took up their arms;"},{"id":"manas-2010:p1480:b001:l022","ordinal":63853,"en":"The fearful cowards,"},{"id":"manas-2010:p1480:b001:l023","ordinal":63854,"en":"“To swell our ranks before the enemy,” they said,"},{"id":"manas-2010:p1480:b001:l024","ordinal":63855,"en":"They placed among themselves."},{"id":"manas-2010:p1480:b001:l025","ordinal":63856,"en":"All the champions"},{"id":"manas-2010:p1480:b001:l026","ordinal":63857,"en":"Took heart and called upon God:"},{"id":"manas-2010:p1480:b001:l027","ordinal":63858,"en":"“Almambet, Chubak, hero Syrgak,"},{"id":"manas-2010:p1480:b001:l028","ordinal":63859,"en":"Ajybay and Muzburchak,"},{"id":"manas-2010:p1480:b001:l029","ordinal":63860,"en":"Zhamgyrchy and hero Kökchö—"},{"id":"manas-2010:p1480:b001:l030","ordinal":63861,"en":"May these men be safe!” they said."},{"id":"manas-2010:p1480:b001:l031","ordinal":63862,"en":"Putting their trust in the seven,"},{"id":"manas-2010:p1480:b001:l032","ordinal":63863,"en":"The hawks, the wolves of war,"},{"id":"manas-2010:p1480:b001:l033","ordinal":63864,"en":"The champions who feared no enemy,"},{"id":"manas-2010:p1480:b001:l034","ordinal":63865,"en":"Formed into ordered ranks of troops,"},{"id":"manas-2010:p1480:b001:l035","ordinal":63866,"en":"A great multitude, no small force;"},{"id":"manas-2010:p1480:b001:l036","ordinal":63867,"en":"Driving the army forward in a broad array,"},{"id":"manas-2010:p1480:b001:l037","ordinal":63868,"en":"The Muslims' red banner"},{"id":"manas-2010:p1480:b001:l038","ordinal":63869,"en":"They entrusted to Ajybay;"},{"id":"manas-2010:p1480:b001:l039","ordinal":63870,"en":"All the outstanding warriors"},{"id":"manas-2010:p1480:b001:l040","ordinal":63871,"en":"Surged toward the Chinese."},{"id":"manas-2010:p1480:b001:l041","ordinal":63872,"en":"All the fearful ones"},{"id":"manas-2010:p1480:b001:l042","ordinal":63873,"en":"Struggled along in their midst,"}]
