[{"id":"manas-2010:p1312:b001:l031","ordinal":56833,"en":"Elder Bakay, farewell!"},{"id":"manas-2010:p1312:b001:l032","ordinal":56834,"en":"The day of death has come."},{"id":"manas-2010:p1312:b001:l033","ordinal":56835,"en":"Your friend Manas, the leopard,"},{"id":"manas-2010:p1312:b001:l034","ordinal":56836,"en":"Lies watching under siege."},{"id":"manas-2010:p1312:b001:l035","ordinal":56837,"en":"Your Almambet and Chubak,"},{"id":"manas-2010:p1312:b001:l036","ordinal":56838,"en":"They remain at the mercy of the attackers."},{"id":"manas-2010:p1312:b001:l037","ordinal":56839,"en":"The peoples of forty khans have risen."},{"id":"manas-2010:p1312:b001:l038","ordinal":56840,"en":"“I shall bring a fog that will never clear,”"},{"id":"manas-2010:p1312:b001:l039","ordinal":56841,"en":"Says the renowned Kongurbay,"},{"id":"manas-2010:p1312:b001:l040","ordinal":56842,"en":"Who has drawn near to Manas."},{"id":"manas-2010:p1312:b001:l041","ordinal":56843,"en":"“I shall bind him alive,” he says,"},{"id":"manas-2010:p1312:b001:l042","ordinal":56844,"en":"Upon his saddle and saddlecloth,"},{"id":"manas-2010:p1313:b001:l001","ordinal":56845,"en":"Manas ran on foot."},{"id":"manas-2010:p1313:b001:l002","ordinal":56846,"en":"When the Chinese pressed upon him,"},{"id":"manas-2010:p1313:b001:l003","ordinal":56847,"en":"In haste he despaired of life."},{"id":"manas-2010:p1313:b001:l004","ordinal":56848,"en":"These were words Manas spoke;"},{"id":"manas-2010:p1313:b001:l005","ordinal":56849,"en":"To Ajybay and Bakay,"},{"id":"manas-2010:p1313:b001:l006","ordinal":56850,"en":"“Be sure to tell them,” he said."},{"id":"manas-2010:p1313:b001:l007","ordinal":56851,"en":"Know that I am left in grief!"},{"id":"manas-2010:p1313:b001:l008","ordinal":56852,"en":"Your hope, Khan Bakay,"},{"id":"manas-2010:p1313:b001:l009","ordinal":56853,"en":"Now give up all hope of me!"},{"id":"manas-2010:p1313:b001:l010","ordinal":56854,"en":"Do not bar my road, Bakay;"},{"id":"manas-2010:p1313:b001:l011","ordinal":56855,"en":"Let go of my hand!’"},{"id":"manas-2010:p1313:b001:l012","ordinal":56856,"en":"Saying this, dear Syrgak"},{"id":"manas-2010:p1313:b001:l013","ordinal":56857,"en":"Fled without restraint."},{"id":"manas-2010:p1313:b001:l014","ordinal":56858,"en":"He who found a road in darkness,"},{"id":"manas-2010:p1313:b001:l015","ordinal":56859,"en":"Who wore a gray lynx-fur cap,"},{"id":"manas-2010:p1313:b001:l016","ordinal":56860,"en":"Who wielded a mottled blue shield,"},{"id":"manas-2010:p1313:b001:l017","ordinal":56861,"en":"Who wrapped his head in gold,"},{"id":"manas-2010:p1313:b001:l018","ordinal":56862,"en":"Who rested his feet upon white down,"},{"id":"manas-2010:p1313:b001:l019","ordinal":56863,"en":"Who cut and chewed rich horsemeat,"},{"id":"manas-2010:p1313:b001:l020","ordinal":56864,"en":"Whose eyes blazed like a lion's—"},{"id":"manas-2010:p1313:b001:l021","ordinal":56865,"en":"Khan Bakay, Bay’s son,"},{"id":"manas-2010:p1313:b001:l022","ordinal":56866,"en":"He was the lion guarded by the unseen patron,"},{"id":"manas-2010:p1313:b001:l023","ordinal":56867,"en":"He was the hero surpassing other men."},{"id":"manas-2010:p1313:b001:l024","ordinal":56868,"en":"If their frail lives were hard pressed,"},{"id":"manas-2010:p1313:b001:l025","ordinal":56869,"en":"For Manas and the forty companions,"},{"id":"manas-2010:p1313:b001:l026","ordinal":56870,"en":"He was the hero who devised counsel."},{"id":"manas-2010:p1313:b001:l027","ordinal":56871,"en":"Know his sacred power from this:"},{"id":"manas-2010:p1313:b001:l028","ordinal":56872,"en":"Against his bare skin, a white camel-wool shirt,"},{"id":"manas-2010:p1313:b001:l029","ordinal":56873,"en":"Was it not Bakay who wore it?"},{"id":"manas-2010:p1313:b001:l030","ordinal":56874,"en":"The calamity that would befall them,"},{"id":"manas-2010:p1313:b001:l031","ordinal":56875,"en":"Three months before it came,"},{"id":"manas-2010:p1313:b001:l032","ordinal":56876,"en":"Was it not Bakay who knew?"},{"id":"manas-2010:p1313:b001:l033","ordinal":56877,"en":"His wisdom a river broad as a lake,"},{"id":"manas-2010:p1313:b001:l034","ordinal":56878,"en":"The elder whose majesty towered like a mountain,"},{"id":"manas-2010:p1313:b001:l035","ordinal":56879,"en":"To find and give counsel,"},{"id":"manas-2010:p1313:b001:l036","ordinal":56880,"en":"Noble Bakay was a saint."},{"id":"manas-2010:p1313:b001:l037","ordinal":56881,"en":"Syrgak would not yield and dashed away."},{"id":"manas-2010:p1313:b001:l038","ordinal":56882,"en":"Gray-maned Bakay, heaven-born,"},{"id":"manas-2010:p1313:b001:l039","ordinal":56883,"en":"Urged his mount on ahead;"},{"id":"manas-2010:p1313:b001:l040","ordinal":56884,"en":"When he drew alongside,"},{"id":"manas-2010:p1313:b001:l041","ordinal":56885,"en":"Bakay took hold of the lead rope."},{"id":"manas-2010:p1313:b001:l042","ordinal":56886,"en":"Your Bakay, born resourceful,"},{"id":"manas-2010:p1314:b001:l001","ordinal":56887,"en":"Kökchebich's lead rope,"},{"id":"manas-2010:p1314:b001:l002","ordinal":56888,"en":"Tearing it from his hand,"},{"id":"manas-2010:p1314:b001:l003","ordinal":56889,"en":"Put through his stirrup."},{"id":"manas-2010:p1314:b001:l004","ordinal":56890,"en":"What a man Bakay was!"},{"id":"manas-2010:p1314:b001:l005","ordinal":56891,"en":"What a beast his gray steed was!"},{"id":"manas-2010:p1314:b001:l006","ordinal":56892,"en":"As though breaking in unbroken beasts,"},{"id":"manas-2010:p1314:b001:l007","ordinal":56893,"en":"Bakay together with his horse,"},{"id":"manas-2010:p1314:b001:l008","ordinal":56894,"en":"For a bowshot's distance, without yielding,"},{"id":"manas-2010:p1314:b001:l009","ordinal":56895,"en":"Kökchebich dragged along."},{"id":"manas-2010:p1314:b001:l010","ordinal":56896,"en":"Then princely Bakay,"},{"id":"manas-2010:p1314:b001:l011","ordinal":56897,"en":"Angry with Syrgak, said:"},{"id":"manas-2010:p1314:b001:l012","ordinal":56898,"en":"‘A battle-axe struck your temple,"},{"id":"manas-2010:p1314:b001:l013","ordinal":56899,"en":"And you howl and weep!"},{"id":"manas-2010:p1314:b001:l014","ordinal":56900,"en":"As though your father Ulak Khan had hit you,"},{"id":"manas-2010:p1314:b001:l015","ordinal":56901,"en":"You take such deep offense."},{"id":"manas-2010:p1314:b001:l016","ordinal":56902,"en":"All those Muslims are enemies;"},{"id":"manas-2010:p1314:b001:l017","ordinal":56903,"en":"If you go and tell what you have seen,"},{"id":"manas-2010:p1314:b001:l018","ordinal":56904,"en":"You will bring disaster upon us."},{"id":"manas-2010:p1314:b001:l019","ordinal":56905,"en":"Taking a club of iron-hard wood,"},{"id":"manas-2010:p1314:b001:l020","ordinal":56906,"en":"Even struck upon the crown, you would not die!"},{"id":"manas-2010:p1314:b001:l021","ordinal":56907,"en":"Ajybay and Bakay together,"},{"id":"manas-2010:p1314:b001:l022","ordinal":56908,"en":"Standing in your way, you do not see."},{"id":"manas-2010:p1314:b001:l023","ordinal":56909,"en":"“An axe struck my temple,” you say,"},{"id":"manas-2010:p1314:b001:l024","ordinal":56910,"en":"And flee beyond all measure."},{"id":"manas-2010:p1314:b001:l025","ordinal":56911,"en":"My reckless, spirited one,"},{"id":"manas-2010:p1314:b001:l026","ordinal":56912,"en":"Upon the great army come from afar,"},{"id":"manas-2010:p1314:b001:l027","ordinal":56913,"en":"You bring such disorder!"},{"id":"manas-2010:p1314:b001:l028","ordinal":56914,"en":"Rather than leave you alive,"},{"id":"manas-2010:p1314:b001:l029","ordinal":56915,"en":"Let me gouge out your eyes now,"},{"id":"manas-2010:p1314:b001:l030","ordinal":56916,"en":"Let me slaughter Kökchebich!"},{"id":"manas-2010:p1314:b001:l031","ordinal":56917,"en":"Killing you with my own hands,"},{"id":"manas-2010:p1314:b001:l032","ordinal":56918,"en":"Let me leave you here!’"},{"id":"manas-2010:p1314:b001:l033","ordinal":56919,"en":"The black-jawed whip"},{"id":"manas-2010:p1314:b001:l034","ordinal":56920,"en":"Bakay gripped and swung;"},{"id":"manas-2010:p1314:b001:l035","ordinal":56921,"en":"Making Syrgak cry out,"},{"id":"manas-2010:p1314:b001:l036","ordinal":56922,"en":"He struck him upon the temple."},{"id":"manas-2010:p1314:b001:l037","ordinal":56923,"en":"With no more than a single blow,"},{"id":"manas-2010:p1314:b001:l038","ordinal":56924,"en":"Champion Bakay, the leopard,"},{"id":"manas-2010:p1314:b001:l039","ordinal":56925,"en":"Knocked him from his horse."},{"id":"manas-2010:p1314:b001:l040","ordinal":56926,"en":"Dear Syrgak, barely able to hold himself up,"},{"id":"manas-2010:p1314:b001:l041","ordinal":56927,"en":"Fell and tumbled down."},{"id":"manas-2010:p1314:b001:l042","ordinal":56928,"en":"When Bakay struck him,"},{"id":"manas-2010:p1315:b001:l001","ordinal":56929,"en":"The battle-axe's poison"},{"id":"manas-2010:p1315:b001:l002","ordinal":56930,"en":"Scattered from his temple."},{"id":"manas-2010:p1315:b001:l003","ordinal":56931,"en":"There in the middle of the road, Syrgak's"},{"id":"manas-2010:p1315:b001:l004","ordinal":56932,"en":"Eyes opened fully, clear and awake."},{"id":"manas-2010:p1315:b001:l005","ordinal":56933,"en":"Khan Bakay was skillful."},{"id":"manas-2010:p1315:b001:l006","ordinal":56934,"en":"When he slaughtered the Kyzylbash,"},{"id":"manas-2010:p1315:b001:l007","ordinal":56935,"en":"When he performed so many feats,"},{"id":"manas-2010:p1315:b001:l008","ordinal":56936,"en":"Medicine to help a person,"},{"id":"manas-2010:p1315:b001:l009","ordinal":56937,"en":"Had he not brought it along?"},{"id":"manas-2010:p1315:b001:l010","ordinal":56938,"en":"Torment and violence,"},{"id":"manas-2010:p1315:b001:l011","ordinal":56939,"en":"Bakay kept in mind;"},{"id":"manas-2010:p1315:b001:l012","ordinal":56940,"en":"Had he not carried it with him?"},{"id":"manas-2010:p1315:b001:l013","ordinal":56941,"en":"That Bakay had with him"},{"id":"manas-2010:p1315:b001:l014","ordinal":56942,"en":"A medicine called ‘Remedy’"},{"id":"manas-2010:p1315:b001:l015","ordinal":56943,"en":"And a medicine called ‘Aid.’"},{"id":"manas-2010:p1315:b001:l016","ordinal":56944,"en":"Some of that medicine then,"},{"id":"manas-2010:p1315:b001:l017","ordinal":56945,"en":"Hero Bakay took."},{"id":"manas-2010:p1315:b001:l018","ordinal":56946,"en":"Upon the temple struck by the battle-axe,"},{"id":"manas-2010:p1315:b001:l019","ordinal":56947,"en":"He smeared it five times."},{"id":"manas-2010:p1315:b001:l020","ordinal":56948,"en":"His pain disappeared;"},{"id":"manas-2010:p1315:b001:l021","ordinal":56949,"en":"Once again, dear Syrgak"},{"id":"manas-2010:p1315:b001:l022","ordinal":56950,"en":"Recovered as he had been before."},{"id":"manas-2010:p1315:b001:l023","ordinal":56951,"en":"Had the battle-axe struck squarely,"},{"id":"manas-2010:p1315:b001:l024","ordinal":56952,"en":"Would Syrgak remain a living man?"},{"id":"manas-2010:p1315:b001:l025","ordinal":56953,"en":"The spearman Kongurbay,"},{"id":"manas-2010:p1315:b001:l026","ordinal":56954,"en":"Had he taken aim and struck,"},{"id":"manas-2010:p1315:b001:l027","ordinal":56955,"en":"Would he have left Syrgak alive?"},{"id":"manas-2010:p1315:b001:l028","ordinal":56956,"en":"When grim-faced Kongurbay struck,"},{"id":"manas-2010:p1315:b001:l029","ordinal":56957,"en":"He had missed his aim."},{"id":"manas-2010:p1315:b001:l030","ordinal":56958,"en":"Not striking the temple squarely,"},{"id":"manas-2010:p1315:b001:l031","ordinal":56959,"en":"The battle-axe's pointed blade"},{"id":"manas-2010:p1315:b001:l032","ordinal":56960,"en":"Had struck a glancing blow."},{"id":"manas-2010:p1315:b001:l033","ordinal":56961,"en":"Unable to bear its poison,"},{"id":"manas-2010:p1315:b001:l034","ordinal":56962,"en":"Fleeing back unexpectedly,"},{"id":"manas-2010:p1315:b001:l035","ordinal":56963,"en":"Syrgak had been sucked down by the sea."},{"id":"manas-2010:p1315:b001:l036","ordinal":56964,"en":"When Syrgak came fleeing,"},{"id":"manas-2010:p1315:b001:l037","ordinal":56965,"en":"His hero, Khan Bakay,"},{"id":"manas-2010:p1315:b001:l038","ordinal":56966,"en":"His own Syrgak"},{"id":"manas-2010:p1315:b001:l039","ordinal":56967,"en":"Had healed as before."},{"id":"manas-2010:p1315:b001:l040","ordinal":56968,"en":"After his healing, to Syrgak,"},{"id":"manas-2010:p1315:b001:l041","ordinal":56969,"en":"Wise Bakay, the hawk,"},{"id":"manas-2010:p1315:b001:l042","ordinal":56970,"en":"Gave advice and counsel."},{"id":"manas-2010:p1316:b001:l001","ordinal":56971,"en":"After this, Khan Bakay,"},{"id":"manas-2010:p1316:b001:l002","ordinal":56972,"en":"Who had read books from of old,"},{"id":"manas-2010:p1316:b001:l003","ordinal":56973,"en":"His wisdom a full-flowing river,"},{"id":"manas-2010:p1316:b001:l004","ordinal":56974,"en":"The wise elder Bakay,"},{"id":"manas-2010:p1316:b001:l005","ordinal":56975,"en":"Who taught what was unknown,"},{"id":"manas-2010:p1316:b001:l006","ordinal":56976,"en":"Learned Bakay, the saint,"},{"id":"manas-2010:p1316:b001:l007","ordinal":56977,"en":"Who made the unperceived understood—"},{"id":"manas-2010:p1316:b001:l008","ordinal":56978,"en":"The hawk devised these words."},{"id":"manas-2010:p1316:b001:l009","ordinal":56979,"en":"‘Young Syrgak, hear my words!"},{"id":"manas-2010:p1316:b001:l010","ordinal":56980,"en":"If you have much to say, speak quickly;"},{"id":"manas-2010:p1316:b001:l011","ordinal":56981,"en":"Speak plainly, without groaning!"},{"id":"manas-2010:p1316:b001:l012","ordinal":56982,"en":"“Manas has been left bound,”"},{"id":"manas-2010:p1316:b001:l013","ordinal":56983,"en":"If you go shouting to the seven khans,"},{"id":"manas-2010:p1316:b001:l014","ordinal":56984,"en":"We shall all be left in torment."},{"id":"manas-2010:p1316:b001:l015","ordinal":56985,"en":"The reason for that torment:"},{"id":"manas-2010:p1316:b001:l016","ordinal":56986,"en":"We dwelt upon the land in Talas."},{"id":"manas-2010:p1316:b001:l017","ordinal":56987,"en":"Twelve vast hosts, a mighty army—"},{"id":"manas-2010:p1316:b001:l018","ordinal":56988,"en":"Think, Syrgak, and hear my words!"},{"id":"manas-2010:p1316:b001:l019","ordinal":56989,"en":"Twelve vast hosts of Muslims,"},{"id":"manas-2010:p1316:b001:l020","ordinal":56990,"en":"Throwing them into complete confusion,"},{"id":"manas-2010:p1316:b001:l021","ordinal":56991,"en":"We drove here under guard."},{"id":"manas-2010:p1316:b001:l022","ordinal":56992,"en":"To the witless fool,"},{"id":"manas-2010:p1316:b001:l023","ordinal":56993,"en":"To whoever said, “My horse is thin,”"},{"id":"manas-2010:p1316:b001:l024","ordinal":56994,"en":"“We shall slaughter and eat your horse,” we said."},{"id":"manas-2010:p1316:b001:l026","ordinal":56995,"en":"Great Altay, upon which they rely,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"manas-2010:p1316:b001:l027","ordinal":56996,"en":"Is it a land like Talas?"},{"id":"manas-2010:p1316:b001:l028","ordinal":56997,"en":"The scattered Muslims,"},{"id":"manas-2010:p1316:b001:l029","ordinal":56998,"en":"Are they the Ogoy people in Talas?"},{"id":"manas-2010:p1316:b001:l030","ordinal":56999,"en":"To blurt out their secrets,"},{"id":"manas-2010:p1316:b001:l031","ordinal":57000,"en":"Dear witless Syrgak,"},{"id":"manas-2010:p1316:b001:l032","ordinal":57001,"en":"Are they like you and me?"},{"id":"manas-2010:p1316:b001:l033","ordinal":57002,"en":"Look at the Muslims' strength!"},{"id":"manas-2010:p1316:b001:l034","ordinal":57003,"en":"There is malice in their eyes."},{"id":"manas-2010:p1316:b001:l035","ordinal":57004,"en":"If they could, my Syrgak,"},{"id":"manas-2010:p1316:b001:l036","ordinal":57005,"en":"They stand ready to strike you down."},{"id":"manas-2010:p1316:b001:l037","ordinal":57006,"en":"There is crookedness in their words;"},{"id":"manas-2010:p1316:b001:l038","ordinal":57007,"en":"There is crookedness in themselves."},{"id":"manas-2010:p1316:b001:l039","ordinal":57008,"en":"If Khan Manas falters,"},{"id":"manas-2010:p1316:b001:l040","ordinal":57009,"en":"They stand ready to slaughter you."},{"id":"manas-2010:p1316:b001:l041","ordinal":57010,"en":"I shall give you a letter on white paper,"},{"id":"manas-2010:p1316:b001:l042","ordinal":57011,"en":"To be called Manas's letter;"},{"id":"manas-2010:p1317:b001:l001","ordinal":57012,"en":"I shall give it quickly, without delay."},{"id":"manas-2010:p1317:b001:l002","ordinal":57013,"en":"When I reach the tent,"},{"id":"manas-2010:p1317:b001:l003","ordinal":57014,"en":"Hold up the letter and shout!"},{"id":"manas-2010:p1317:b001:l004","ordinal":57015,"en":"Call out, “Muslims!”"},{"id":"manas-2010:p1317:b001:l005","ordinal":57016,"en":"“We have taken so much gold and silver"},{"id":"manas-2010:p1317:b001:l006","ordinal":57017,"en":"We cannot load it all,” say."},{"id":"manas-2010:p1317:b001:l007","ordinal":57018,"en":"“We have taken fair-faced young wives and girls"},{"id":"manas-2010:p1317:b001:l008","ordinal":57019,"en":"We cannot manage them all,” say."},{"id":"manas-2010:p1317:b001:l009","ordinal":57020,"en":"“Fighting four months without rest,"},{"id":"manas-2010:p1317:b001:l010","ordinal":57021,"en":"We shattered the Kakan people."},{"id":"manas-2010:p1317:b001:l011","ordinal":57022,"en":"In the land of Outer Beijing,"},{"id":"manas-2010:p1317:b001:l012","ordinal":57023,"en":"Over the multitude of Chinese,"},{"id":"manas-2010:p1317:b001:l013","ordinal":57024,"en":"We raised Khan Manas high"},{"id":"manas-2010:p1317:b001:l014","ordinal":57025,"en":"And proclaimed him khan,” say."},{"id":"manas-2010:p1317:b001:l015","ordinal":57026,"en":"“Esenkan's Burulcha,"},{"id":"manas-2010:p1317:b001:l016","ordinal":57027,"en":"Ay Jangjung's Birmyskal,"},{"id":"manas-2010:p1317:b001:l017","ordinal":57028,"en":"Together with so many beautiful girls,"},{"id":"manas-2010:p1317:b001:l018","ordinal":57029,"en":"From Beijing of Kakan-Chin,"},{"id":"manas-2010:p1317:b001:l019","ordinal":57030,"en":"We have seized these,” say."},{"id":"manas-2010:p1317:b001:l020","ordinal":57031,"en":"“You capable, resourceful ones,"},{"id":"manas-2010:p1317:b001:l021","ordinal":57032,"en":"Take as many horses as you can,” say."},{"id":"manas-2010:p1317:b001:l022","ordinal":57033,"en":"“You weak ones without the strength,"},{"id":"manas-2010:p1317:b001:l023","ordinal":57034,"en":"Drive off six horses each,” say."},{"id":"manas-2010:p1317:b001:l024","ordinal":57035,"en":"“Let them see this narrow pass,” say."},{"id":"manas-2010:p1317:b001:l025","ordinal":57036,"en":"“Let the Muslim army unite;"},{"id":"manas-2010:p1317:b001:l026","ordinal":57037,"en":"Let them all come, not one remaining,” say."},{"id":"manas-2010:p1317:b001:l027","ordinal":57038,"en":"“The spoils, elder Koshoy"},{"id":"manas-2010:p1317:b001:l028","ordinal":57039,"en":"Himself shall divide as he thinks fit,” say."},{"id":"manas-2010:p1317:b001:l029","ordinal":57040,"en":"“This amusement, this spectacle,"},{"id":"manas-2010:p1317:b001:l030","ordinal":57041,"en":"Let my people come and see!” say.’"},{"id":"manas-2010:p1317:b001:l031","ordinal":57042,"en":"Saying this, Khan Bakay wrote a letter;"},{"id":"manas-2010:p1317:b001:l032","ordinal":57043,"en":"To leopard-champion Syrgak,"},{"id":"manas-2010:p1317:b001:l033","ordinal":57044,"en":"Bakay wrote and gave it."},{"id":"manas-2010:p1317:b001:l034","ordinal":57045,"en":"The two heroes, Ajybay and Bakay,"},{"id":"manas-2010:p1317:b001:l035","ordinal":57046,"en":"Mounted their horses."},{"id":"manas-2010:p1317:b001:l036","ordinal":57047,"en":"Bakay stretched his hands wide,"},{"id":"manas-2010:p1317:b001:l037","ordinal":57048,"en":"Facing Ajybay,"},{"id":"manas-2010:p1317:b001:l038","ordinal":57049,"en":"Extended both hands alike,"},{"id":"manas-2010:p1317:b001:l039","ordinal":57050,"en":"Raised his hands as he stepped forward."},{"id":"manas-2010:p1317:b001:l040","ordinal":57051,"en":"Thus, after him,"},{"id":"manas-2010:p1317:b001:l041","ordinal":57052,"en":"A champion like Ajybay,"},{"id":"manas-2010:p1317:b001:l042","ordinal":57053,"en":"He entrusted to the forty guardian saints."},{"id":"manas-2010:p1318:b001:l001","ordinal":57054,"en":"‘Farewell, Ajybay, my companion in soul!"},{"id":"manas-2010:p1318:b001:l002","ordinal":57055,"en":"If you lose what is entrusted, your name will be disgraced."},{"id":"manas-2010:p1318:b001:l003","ordinal":57056,"en":"Far away, you and the Magnanimous One,"},{"id":"manas-2010:p1318:b001:l004","ordinal":57057,"en":"Into the swarming infidels'"},{"id":"manas-2010:p1318:b001:l005","ordinal":57058,"en":"Seething place,"},{"id":"manas-2010:p1318:b001:l006","ordinal":57059,"en":"My leopard, you go."},{"id":"manas-2010:p1318:b001:l007","ordinal":57060,"en":"I entrust you to the one God!"},{"id":"manas-2010:p1318:b001:l008","ordinal":57061,"en":"Baychoro beside you,"},{"id":"manas-2010:p1318:b001:l009","ordinal":57062,"en":"He was a wolf in battle."},{"id":"manas-2010:p1318:b001:l010","ordinal":57063,"en":"Your other companion, Boz Uul,"},{"id":"manas-2010:p1318:b001:l011","ordinal":57064,"en":"Was an open-hearted man."},{"id":"manas-2010:p1318:b001:l012","ordinal":57065,"en":"Yraman's Singer's Son,"},{"id":"manas-2010:p1318:b001:l013","ordinal":57066,"en":"Who never retreated from the enemy,"},{"id":"manas-2010:p1318:b001:l014","ordinal":57067,"en":"Was a hero born a tiger."},{"id":"manas-2010:p1318:b001:l015","ordinal":57068,"en":"When he came in fury,"},{"id":"manas-2010:p1318:b001:l016","ordinal":57069,"en":"When his anger rose,"},{"id":"manas-2010:p1318:b001:l017","ordinal":57070,"en":"He brought alarming news with force;"},{"id":"manas-2010:p1318:b001:l018","ordinal":57071,"en":"He could knock down a camel with a blow."},{"id":"manas-2010:p1318:b001:l019","ordinal":57072,"en":"Five of you go to the lord."},{"id":"manas-2010:p1318:b001:l020","ordinal":57073,"en":"Akkula, entrusted to you,"},{"id":"manas-2010:p1318:b001:l021","ordinal":57074,"en":"The wings of your Magnanimous One,"},{"id":"manas-2010:p1318:b001:l022","ordinal":57075,"en":"You will lead him alongside."},{"id":"manas-2010:p1318:b001:l023","ordinal":57076,"en":"Unless you turn your face toward death,"},{"id":"manas-2010:p1318:b001:l024","ordinal":57077,"en":"Unless you show true courage,"},{"id":"manas-2010:p1318:b001:l025","ordinal":57078,"en":"This is the counsel I give:"},{"id":"manas-2010:p1318:b001:l026","ordinal":57079,"en":"Before seeing the champion's eyes,"},{"id":"manas-2010:p1318:b001:l027","ordinal":57080,"en":"You will fall into their hands.’"},{"id":"manas-2010:p1318:b001:l028","ordinal":57081,"en":"So said Khan Bakay then,"},{"id":"manas-2010:p1318:b001:l029","ordinal":57082,"en":"Speaking in this way,"},{"id":"manas-2010:p1318:b001:l030","ordinal":57083,"en":"Grasping his hand tightly."},{"id":"manas-2010:p1318:b001:l031","ordinal":57084,"en":"Akkula and the white padded armor,"},{"id":"manas-2010:p1318:b001:l032","ordinal":57085,"en":"Akkelte and the gray ammunition belt,"},{"id":"manas-2010:p1318:b001:l033","ordinal":57086,"en":"He entrusted to the five champions."},{"id":"manas-2010:p1318:b001:l034","ordinal":57087,"en":"Taking a shortcut along the mountain goat's path,"},{"id":"manas-2010:p1318:b001:l035","ordinal":57088,"en":"Ajybay set out, five men together."}]
