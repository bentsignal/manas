[{"id":"seytek-2012:p1051:b004:l010","ordinal":377857,"en":"When their mounting rage seized them,"},{"id":"seytek-2012:p1051:b004:l011","ordinal":377858,"en":"They laid the whole world waste."},{"id":"seytek-2012:p1051:b004:l012","ordinal":377859,"en":"They set grassy lands ablaze"},{"id":"seytek-2012:p1051:b004:l013","ordinal":377860,"en":"And burned the meadows;"},{"id":"seytek-2012:p1051:b004:l014","ordinal":377861,"en":"Whenever they seemed spent, they smoked anew,"},{"id":"seytek-2012:p1051:b004:l015","ordinal":377862,"en":"Growing stronger from their very roots."},{"id":"seytek-2012:p1051:b004:l016","ordinal":377863,"en":"They poured blood into the dark waters,"},{"id":"seytek-2012:p1051:b004:l017","ordinal":377864,"en":"Raising vast clouds of dust in battle,"},{"id":"seytek-2012:p1051:b004:l018","ordinal":377865,"en":"Kicking at knucklebones and storming the khan’s court,"},{"id":"seytek-2012:p1051:b004:l019","ordinal":377866,"en":"Throwing themselves wholly into such sport."},{"id":"seytek-2012:p1051:b004:l020","ordinal":377867,"en":"Where he stepped, Mount Küdür seemed to rise;"},{"id":"seytek-2012:p1051:b004:l021","ordinal":377868,"en":"Whatever he stalked became his enemy."},{"id":"seytek-2012:p1051:b004:l022","ordinal":377869,"en":"The fierce leopard Seytek"},{"id":"seytek-2012:p1051:b004:l023","ordinal":377870,"en":"Appeared magnificent as a lofty mountain."},{"id":"seytek-2012:p1051:b004:l024","ordinal":377871,"en":"In those days no mortal"},{"id":"seytek-2012:p1051:b004:l025","ordinal":377872,"en":"Could approach Talas to face him."},{"id":"seytek-2012:p1051:b004:l026","ordinal":377873,"en":"He had barred every perilous road;"},{"id":"seytek-2012:p1051:b004:l027","ordinal":377874,"en":"The Black Chinese and the countless Manchus"},{"id":"seytek-2012:p1051:b004:l028","ordinal":377875,"en":"Stayed huddled within Kakhan, never venturing out,"},{"id":"seytek-2012:p1051:b004:l029","ordinal":377876,"en":"For none possessed such courage."},{"id":"seytek-2012:p1051:b004:l030","ordinal":377877,"en":"All the heroes gathered,"},{"id":"seytek-2012:p1051:b004:l031","ordinal":377878,"en":"And the enemy’s path was blocked;"},{"id":"seytek-2012:p1051:b004:l032","ordinal":377879,"en":"No foe raided their pastures,"},{"id":"seytek-2012:p1051:b004:l033","ordinal":377880,"en":"And no confronting enemy survived."},{"id":"seytek-2012:p1051:b004:l034","ordinal":377881,"en":"Once, amid the vast world,"},{"id":"seytek-2012:p1051:b004:l035","ordinal":377882,"en":"While his fortune still stood secure,"},{"id":"seytek-2012:p1051:b004:l036","ordinal":377883,"en":"Within the fortress with gates of steel,"},{"id":"seytek-2012:p1051:b004:l037","ordinal":377884,"en":"In Kanykei’s stronghold,"},{"id":"seytek-2012:p1051:b004:l038","ordinal":377885,"en":"Five stout palaces had been built—"},{"id":"seytek-2012:p1051:b004:l039","ordinal":377886,"en":"Such was their heroic magnificence."},{"id":"seytek-2012:p1051:b004:l040","ordinal":377887,"en":"Many monuments of them remained in the world,"},{"id":"seytek-2012:p1052:b002:l001","ordinal":377888,"en":"Including a separate palace"},{"id":"seytek-2012:p1052:b002:l002","ordinal":377889,"en":"For Buurul, mighty as a camel stallion."},{"id":"seytek-2012:p1052:b002:l003","ordinal":377890,"en":"This splendid palace—"},{"id":"seytek-2012:p1052:b002:l004","ordinal":377891,"en":"Seen from outside, it looked like one palace;"},{"id":"seytek-2012:p1052:b002:l005","ordinal":377892,"en":"Once inside, it seemed a thousand palaces,"},{"id":"seytek-2012:p1052:b002:l006","ordinal":377893,"en":"So vast was its magnificence."},{"id":"seytek-2012:p1052:b002:l007","ordinal":377894,"en":"It was cast and sculpted as though molded,"},{"id":"seytek-2012:p1052:b002:l008","ordinal":377895,"en":"And its door was of white tin."},{"id":"seytek-2012:p1052:b002:l009","ordinal":377896,"en":"There were six stewards who tended the horses;"},{"id":"seytek-2012:p1052:b002:l010","ordinal":377897,"en":"Baimyrza and Akjoltoy,"},{"id":"seytek-2012:p1052:b002:l011","ordinal":377898,"en":"Whenever Seytek had need,"},{"id":"seytek-2012:p1052:b002:l012","ordinal":377899,"en":"Were keen-witted men who found a solution."},{"id":"seytek-2012:p1052:b002:l013","ordinal":377900,"en":"When Akjoltoy had spoken thus,"},{"id":"seytek-2012:p1052:b002:l014","ordinal":377901,"en":"All the heroes grew excited"},{"id":"seytek-2012:p1052:b002:l015","ordinal":377902,"en":"And every warrior became animated."},{"id":"seytek-2012:p1052:b002:l016","ordinal":377903,"en":"They played chess and won from one another,"},{"id":"seytek-2012:p1052:b002:l017","ordinal":377904,"en":"And drank kumis from the leather vat;"},{"id":"seytek-2012:p1052:b002:l018","ordinal":377905,"en":"When they heard the news of the maiden,"},{"id":"seytek-2012:p1052:b002:l019","ordinal":377906,"en":"They grew merry on kumis,"},{"id":"seytek-2012:p1052:b002:l020","ordinal":377907,"en":"Until sweat streamed from their brows,"},{"id":"seytek-2012:p1052:b002:l021","ordinal":377908,"en":"And they burst into clamor."},{"id":"seytek-2012:p1052:b002:l022","ordinal":377909,"en":"They drank spirits from horn cups"},{"id":"seytek-2012:p1052:b002:l023","ordinal":377910,"en":"And joined the celebration."},{"id":"seytek-2012:p1052:b002:l024","ordinal":377911,"en":"Then the lions gave themselves"},{"id":"seytek-2012:p1052:b002:l025","ordinal":377912,"en":"To unending merriment"},{"id":"seytek-2012:p1052:b002:l026","ordinal":377913,"en":"And plunged into the revelry."},{"id":"seytek-2012:p1052:b002:l027","ordinal":377914,"en":"“The one God has freely"},{"id":"seytek-2012:p1052:b002:l028","ordinal":377915,"en":"Granted us our desire,” they said;"},{"id":"seytek-2012:p1052:b002:l029","ordinal":377916,"en":"“To Seytek, blessed by Kydyr,"},{"id":"seytek-2012:p1052:b002:l030","ordinal":377917,"en":"A beauty from the peri folk has come,” they said."},{"id":"seytek-2012:p1052:b002:l031","ordinal":377918,"en":"A roaring tumult arose,"},{"id":"seytek-2012:p1052:b002:l032","ordinal":377919,"en":"And that day the clamor burst forth."},{"id":"seytek-2012:p1052:b002:l033","ordinal":377920,"en":"“A beauty has unexpectedly come to him,” they said;"},{"id":"seytek-2012:p1052:b002:l034","ordinal":377921,"en":"“This Seytek’s fortune"},{"id":"seytek-2012:p1052:b002:l035","ordinal":377922,"en":"Surpasses that of his father Semetey,” they said."},{"id":"seytek-2012:p1052:b002:l036","ordinal":377923,"en":"The reason it surpassed his father’s was this:"},{"id":"seytek-2012:p1052:b002:l037","ordinal":377924,"en":"His father, the fierce Semetey,"},{"id":"seytek-2012:p1052:b002:l038","ordinal":377925,"en":"Had won Aichürök,"},{"id":"seytek-2012:p1052:b002:l039","ordinal":377926,"en":"But suffered anguish and battled enemies;"},{"id":"seytek-2012:p1052:b002:l040","ordinal":377927,"en":"His ancient foes attacked,"},{"id":"seytek-2012:p1052:b003:l001","ordinal":377928,"en":"And his head was pledged to death."},{"id":"seytek-2012:p1052:b003:l002","ordinal":377929,"en":"The two giants, Chynkojo and Toltoy,"},{"id":"seytek-2012:p1052:b003:l003","ordinal":377930,"en":"Brought about a terrible slaughter."},{"id":"seytek-2012:p1052:b003:l004","ordinal":377931,"en":"When his father took Chürök,"},{"id":"seytek-2012:p1052:b003:l005","ordinal":377932,"en":"He plunged the people into suffering."},{"id":"seytek-2012:p1052:b003:l006","ordinal":377933,"en":"But for Seytek, whose fortune was greater,"},{"id":"seytek-2012:p1052:b003:l007","ordinal":377934,"en":"The hapless daughter of the peri"},{"id":"seytek-2012:p1052:b003:l008","ordinal":377935,"en":"Came of her own accord,"},{"id":"seytek-2012:p1052:b003:l009","ordinal":377936,"en":"Without galling a single steed"},{"id":"seytek-2012:p1052:b003:l010","ordinal":377937,"en":"Or causing pain to any soul."},{"id":"seytek-2012:p1052:b003:l011","ordinal":377938,"en":"When God wills, He grants;"},{"id":"seytek-2012:p1052:b003:l012","ordinal":377939,"en":"The Night of Destiny has come to us."},{"id":"seytek-2012:p1052:b003:l013","ordinal":377940,"en":"The people rejoiced and the nation surged,"},{"id":"seytek-2012:p1052:b003:l014","ordinal":377941,"en":"Swiftly invoking Baabedin;"},{"id":"seytek-2012:p1052:b003:l015","ordinal":377942,"en":"In the name of magnanimous Manas,"},{"id":"seytek-2012:p1052:b003:l016","ordinal":377943,"en":"They dedicated a moon-hoofed horse"},{"id":"seytek-2012:p1052:b003:l017","ordinal":377944,"en":"And spoke many splendid blessings."},{"id":"seytek-2012:p1052:b003:l018","ordinal":377945,"en":"The noble hero, until then unmoved,"},{"id":"seytek-2012:p1052:b003:l019","ordinal":377946,"en":"Ordered joyous games to begin"},{"id":"seytek-2012:p1052:b003:l020","ordinal":377947,"en":"And had brought forth a white mare"},{"id":"seytek-2012:p1052:b003:l021","ordinal":377948,"en":"That had borne no foal for six years."},{"id":"seytek-2012:p1052:b003:l022","ordinal":377949,"en":"When the mare was brought,"},{"id":"seytek-2012:p1052:b003:l023","ordinal":377950,"en":"That noble hero, proud as a rooster,"},{"id":"seytek-2012:p1052:b003:l024","ordinal":377951,"en":"Grasped both its ears and forelock"},{"id":"seytek-2012:p1052:b003:l025","ordinal":377952,"en":"Together in his hands."},{"id":"seytek-2012:p1052:b003:l026","ordinal":377953,"en":"Without binding the mare’s legs,"},{"id":"seytek-2012:p1052:b003:l027","ordinal":377954,"en":"He cut off its head."},{"id":"seytek-2012:p1052:b003:l028","ordinal":377955,"en":"He sacrificed it to the spirit"},{"id":"seytek-2012:p1052:b003:l029","ordinal":377956,"en":"Of his grandfather Manas."},{"id":"seytek-2012:p1052:b003:l030","ordinal":377957,"en":"When the young man sacrificed the mare,"},{"id":"seytek-2012:p1052:b003:l031","ordinal":377958,"en":"All the companions of the tiger’s heir"},{"id":"seytek-2012:p1052:b003:l032","ordinal":377959,"en":"Cried out together:"},{"id":"seytek-2012:p1052:b003:l033","ordinal":377960,"en":"“O noble leopard Manas,"},{"id":"seytek-2012:p1052:b003:l034","ordinal":377961,"en":"May your spirit uphold us!”"},{"id":"seytek-2012:p1052:b003:l035","ordinal":377962,"en":"All his comrades shouted,"},{"id":"seytek-2012:p1052:b003:l036","ordinal":377963,"en":"“What a boundless deed!”"},{"id":"seytek-2012:p1052:b003:l037","ordinal":377964,"en":"Every hero grew inspired,"},{"id":"seytek-2012:p1052:b003:l038","ordinal":377965,"en":"Every swift, armed young horseman"},{"id":"seytek-2012:p1052:b003:l039","ordinal":377966,"en":"Was filled with exultation:"},{"id":"seytek-2012:p1052:b003:l040","ordinal":377967,"en":"“If only such good fortune came"},{"id":"seytek-2012:p1053:b002:l001","ordinal":377968,"en":"To a mortal son like me,” they said;"},{"id":"seytek-2012:p1053:b002:l002","ordinal":377969,"en":"“If only the one God"},{"id":"seytek-2012:p1053:b002:l003","ordinal":377970,"en":"Granted a man his heart’s desire in this way,"},{"id":"seytek-2012:p1053:b002:l004","ordinal":377971,"en":"What regret could remain in a young man?"},{"id":"seytek-2012:p1053:b002:l005","ordinal":377972,"en":"If, by a man’s good fortune,"},{"id":"seytek-2012:p1053:b002:l006","ordinal":377973,"en":"Such a peri beauty came to him,” they said."},{"id":"seytek-2012:p1053:b002:l007","ordinal":377974,"en":"The people’s cries gradually subsided,"},{"id":"seytek-2012:p1053:b002:l008","ordinal":377975,"en":"And the crowd grew calm and quiet."},{"id":"seytek-2012:p1053:b002:l009","ordinal":377976,"en":"Into the echoing palace"},{"id":"seytek-2012:p1053:b002:l010","ordinal":377977,"en":"The young men came running,"},{"id":"seytek-2012:p1053:b002:l011","ordinal":377978,"en":"Throwing themselves into saddling the horse."},{"id":"seytek-2012:p1053:b002:l012","ordinal":377979,"en":"The leopard Seytek’s fierce nature"},{"id":"seytek-2012:p1053:b002:l013","ordinal":377980,"en":"And heroic spirit became manifest,"},{"id":"seytek-2012:p1053:b002:l014","ordinal":377981,"en":"While the immeasurably swift"},{"id":"seytek-2012:p1053:b002:l015","ordinal":377982,"en":"Attendants rushed in every direction."},{"id":"seytek-2012:p1053:b002:l016","ordinal":377983,"en":"A white halter made by a maid,"},{"id":"seytek-2012:p1053:b002:l017","ordinal":377984,"en":"A halter fitted to Kulansur,"},{"id":"seytek-2012:p1053:b002:l018","ordinal":377985,"en":"A white halter tied with rounded knots,"},{"id":"seytek-2012:p1053:b002:l019","ordinal":377986,"en":"Fitted for the mighty stallion—"},{"id":"seytek-2012:p1053:b002:l020","ordinal":377987,"en":"They fastened it upon Kulansur."},{"id":"seytek-2012:p1053:b002:l021","ordinal":377988,"en":"An impenetrable pure-white caparison"},{"id":"seytek-2012:p1053:b002:l022","ordinal":377989,"en":"They draped with fluttering skirts"},{"id":"seytek-2012:p1053:b002:l023","ordinal":377990,"en":"Across the prancing thoroughbred."},{"id":"seytek-2012:p1053:b002:l024","ordinal":377991,"en":"Steel shoes with silver nails"},{"id":"seytek-2012:p1053:b002:l025","ordinal":377992,"en":"They hammered onto his hooves."},{"id":"seytek-2012:p1053:b002:l026","ordinal":377993,"en":"They saddled him magnificently,"},{"id":"seytek-2012:p1053:b002:l027","ordinal":377994,"en":"Striking awe into everyone who saw;"},{"id":"seytek-2012:p1053:b002:l028","ordinal":377995,"en":"A leather saddlecloth and blue saddle pad"},{"id":"seytek-2012:p1053:b002:l029","ordinal":377996,"en":"They placed upon the thoroughbred."},{"id":"seytek-2012:p1053:b002:l030","ordinal":377997,"en":"They had brought from the palace"},{"id":"seytek-2012:p1053:b002:l031","ordinal":377998,"en":"The white saddle inherited"},{"id":"seytek-2012:p1053:b002:l032","ordinal":377999,"en":"From Almambet of old."},{"id":"seytek-2012:p1053:b002:l033","ordinal":378000,"en":"Calling it a legacy of the noble hero,"},{"id":"seytek-2012:p1053:b002:l034","ordinal":378001,"en":"They filled the people’s hearts with wonder."},{"id":"seytek-2012:p1053:b002:l035","ordinal":378002,"en":"The reason their hearts were satisfied—"},{"id":"seytek-2012:p1053:b002:l036","ordinal":378003,"en":"If you ask about that saddle—"},{"id":"seytek-2012:p1053:b002:l037","ordinal":378004,"en":"Forty craftsmen and Bölökbai"},{"id":"seytek-2012:p1053:b002:l038","ordinal":378005,"en":"Had fitted it without the slightest flaw,"},{"id":"seytek-2012:p1053:b002:l039","ordinal":378006,"en":"Assembling it piece by tiny piece."},{"id":"seytek-2012:p1053:b002:l040","ordinal":378007,"en":"When its value became known,"},{"id":"seytek-2012:p1053:b003:l001","ordinal":378008,"en":"Many khans asked for it."},{"id":"seytek-2012:p1053:b003:l002","ordinal":378009,"en":"It was never given to those who asked;"},{"id":"seytek-2012:p1053:b003:l003","ordinal":378010,"en":"Far from giving away the saddle,"},{"id":"seytek-2012:p1053:b003:l004","ordinal":378011,"en":"They never let an impure man ride it."},{"id":"seytek-2012:p1053:b003:l005","ordinal":378012,"en":"Its front bow was of white gold,"},{"id":"seytek-2012:p1053:b003:l006","ordinal":378013,"en":"And its rear bow of yellow gold."},{"id":"seytek-2012:p1053:b003:l007","ordinal":378014,"en":"So that it might shine on moonless nights"},{"id":"seytek-2012:p1053:b003:l008","ordinal":378015,"en":"And delight the heart of its rider,"},{"id":"seytek-2012:p1053:b003:l009","ordinal":378016,"en":"They had every part of the saddle"},{"id":"seytek-2012:p1053:b003:l010","ordinal":378017,"en":"Ornately carved."},{"id":"seytek-2012:p1053:b003:l011","ordinal":378018,"en":"Upon its front and rear bows"},{"id":"seytek-2012:p1053:b003:l012","ordinal":378019,"en":"They had rubies and precious jewels"},{"id":"seytek-2012:p1053:b003:l013","ordinal":378020,"en":"Set in clusters the size of bowls."},{"id":"seytek-2012:p1053:b003:l014","ordinal":378021,"en":"The white saddle was of matchless beauty"},{"id":"seytek-2012:p1053:b003:l015","ordinal":378022,"en":"And satisfied the heart of everyone who saw it."},{"id":"seytek-2012:p1053:b003:l016","ordinal":378023,"en":"The winged tulpar Kulansur"},{"id":"seytek-2012:p1053:b003:l017","ordinal":378024,"en":"Filled all the people with awe."},{"id":"seytek-2012:p1053:b003:l018","ordinal":378025,"en":"They saddled the moon-browed Kulansur"},{"id":"seytek-2012:p1053:b003:l019","ordinal":378026,"en":"With the golden saddle,"},{"id":"seytek-2012:p1053:b003:l020","ordinal":378027,"en":"Moving with immeasurable speed."},{"id":"seytek-2012:p1053:b003:l021","ordinal":378028,"en":"They quickly finished saddling the horse,"},{"id":"seytek-2012:p1053:b003:l022","ordinal":378029,"en":"Then laid on the bearskin crupper and white breastband"},{"id":"seytek-2012:p1053:b003:l023","ordinal":378030,"en":"And had the straps drawn tight."},{"id":"seytek-2012:p1053:b003:l024","ordinal":378031,"en":"Leading the horse straight ahead,"},{"id":"seytek-2012:p1053:b003:l025","ordinal":378032,"en":"They made him stride proudly,"},{"id":"seytek-2012:p1053:b003:l026","ordinal":378033,"en":"Urging one another onward."},{"id":"seytek-2012:p1053:b003:l027","ordinal":378034,"en":"When the leopard mounted his horse,"},{"id":"seytek-2012:p1053:b003:l028","ordinal":378035,"en":"They surged as though an enemy had come."},{"id":"seytek-2012:p1053:b003:l029","ordinal":378036,"en":"Clad imposingly in a golden coat,"},{"id":"seytek-2012:p1053:b003:l030","ordinal":378037,"en":"He loomed like a white, rocky mountain;"},{"id":"seytek-2012:p1053:b003:l031","ordinal":378038,"en":"His splendor appeared mountain-high"},{"id":"seytek-2012:p1053:b003:l032","ordinal":378039,"en":"And captivated all who saw him."},{"id":"seytek-2012:p1053:b003:l033","ordinal":378040,"en":"Straining like a hungry lion,"},{"id":"seytek-2012:p1053:b003:l034","ordinal":378041,"en":"The magnanimous hero rode forth,"},{"id":"seytek-2012:p1053:b003:l035","ordinal":378042,"en":"Equipped with all his weapons."},{"id":"seytek-2012:p1053:b003:l036","ordinal":378043,"en":"At his side hung a scabbardless saber;"},{"id":"seytek-2012:p1053:b003:l037","ordinal":378044,"en":"He took a spear with a steel shaft and sharp point,"},{"id":"seytek-2012:p1053:b003:l038","ordinal":378045,"en":"Its blade a full handspan long."},{"id":"seytek-2012:p1053:b003:l039","ordinal":378046,"en":"Wondering what spectacle would unfold,"},{"id":"seytek-2012:p1053:b003:l040","ordinal":378047,"en":"The gathered people lined the way."},{"id":"seytek-2012:p1054:b002:l001","ordinal":378048,"en":"Turning their faces toward Berish,"},{"id":"seytek-2012:p1054:b002:l002","ordinal":378049,"en":"The chosen heroes rode forth."},{"id":"seytek-2012:p1054:b002:l003","ordinal":378050,"en":"Lest rain should soak it,"},{"id":"seytek-2012:p1054:b002:l004","ordinal":378051,"en":"They loaded the white pavilion,"},{"id":"seytek-2012:p1054:b002:l005","ordinal":378052,"en":"And many heroes secured it upon a camel."},{"id":"seytek-2012:p1054:b002:l006","ordinal":378053,"en":"The six horse-tending stewards,"},{"id":"seytek-2012:p1054:b002:l007","ordinal":378054,"en":"All six equally valiant,"},{"id":"seytek-2012:p1054:b002:l008","ordinal":378055,"en":"Set out with all the falcons,"},{"id":"seytek-2012:p1054:b002:l009","ordinal":378056,"en":"Riding with longing toward the maiden."},{"id":"seytek-2012:p1054:b002:l010","ordinal":378057,"en":"Akjoltoy led the way,"},{"id":"seytek-2012:p1054:b002:l011","ordinal":378058,"en":"His swift horse leaving only a streak,"},{"id":"seytek-2012:p1054:b002:l012","ordinal":378059,"en":"As he left hills, ridges, and winding gullies"},{"id":"seytek-2012:p1054:b002:l013","ordinal":378060,"en":"Far behind."},{"id":"seytek-2012:p1054:b002:l014","ordinal":378061,"en":"Akjoltoy, surging with vigor,"},{"id":"seytek-2012:p1054:b002:l015","ordinal":378062,"en":"Led them onward."},{"id":"seytek-2012:p1054:b002:l016","ordinal":378063,"en":"Whenever they reached a suitable place,"},{"id":"seytek-2012:p1054:b002:l017","ordinal":378064,"en":"They sported upon their tulpars,"},{"id":"seytek-2012:p1054:b002:l018","ordinal":378065,"en":"And the restless heroes raced."},{"id":"seytek-2012:p1054:b002:l019","ordinal":378066,"en":"At other places"},{"id":"seytek-2012:p1054:b002:l020","ordinal":378067,"en":"They grappled from the very hem,"},{"id":"seytek-2012:p1054:b002:l021","ordinal":378068,"en":"And the reckless men seemed"},{"id":"seytek-2012:p1054:b002:l022","ordinal":378069,"en":"Ready to destroy one another,"},{"id":"seytek-2012:p1054:b002:l023","ordinal":378070,"en":"Until others seized their hands."},{"id":"seytek-2012:p1054:b002:l024","ordinal":378071,"en":"They charged, leveling spears,"},{"id":"seytek-2012:p1054:b002:l025","ordinal":378072,"en":"And struck one another with whips."},{"id":"seytek-2012:p1054:b002:l026","ordinal":378073,"en":"Across countless hills and countless deserts,"},{"id":"seytek-2012:p1054:b002:l027","ordinal":378074,"en":"They rode tirelessly onward."},{"id":"seytek-2012:p1054:b002:l028","ordinal":378075,"en":"Whenever they reached another place,"},{"id":"seytek-2012:p1054:b002:l029","ordinal":378076,"en":"They began astonishing games."},{"id":"seytek-2012:p1054:b002:l030","ordinal":378077,"en":"They immersed themselves in sport,"},{"id":"seytek-2012:p1054:b002:l031","ordinal":378078,"en":"Shooting when they saw wild asses,"},{"id":"seytek-2012:p1054:b002:l032","ordinal":378079,"en":"Chasing gazelles and overtaking them,"},{"id":"seytek-2012:p1054:b002:l033","ordinal":378080,"en":"And playing kök-börü,"},{"id":"seytek-2012:p1054:b002:l034","ordinal":378081,"en":"Revealing the secrets in their hearts."},{"id":"seytek-2012:p1054:b002:l035","ordinal":378082,"en":"The treasures of their dear lives"},{"id":"seytek-2012:p1054:b002:l036","ordinal":378083,"en":"They spent upon delight,"},{"id":"seytek-2012:p1054:b002:l037","ordinal":378084,"en":"Immersing themselves in every pleasure"},{"id":"seytek-2012:p1054:b002:l038","ordinal":378085,"en":"Until all their longings were eased."},{"id":"seytek-2012:p1054:b002:l039","ordinal":378086,"en":"As the heroes journeyed,"},{"id":"seytek-2012:p1054:b002:l040","ordinal":378087,"en":"Across the boundless plain"},{"id":"seytek-2012:p1054:b003:l001","ordinal":378088,"en":"They wrestled for the goat carcass from the ground."},{"id":"seytek-2012:p1054:b003:l002","ordinal":378089,"en":"They never traveled an ordinary journey,"},{"id":"seytek-2012:p1054:b003:l003","ordinal":378090,"en":"But turned it into a hunt."},{"id":"seytek-2012:p1054:b003:l004","ordinal":378091,"en":"They plunged into immense,"},{"id":"seytek-2012:p1054:b003:l005","ordinal":378092,"en":"Unending revelry."},{"id":"seytek-2012:p1054:b003:l006","ordinal":378093,"en":"They rode hard without sparing their horses"},{"id":"seytek-2012:p1054:b003:l007","ordinal":378094,"en":"And raced in a sweeping free-for-all."},{"id":"seytek-2012:p1054:b003:l008","ordinal":378095,"en":"They crossed nameless mountain passes"},{"id":"seytek-2012:p1054:b003:l009","ordinal":378096,"en":"And deserts no mortal had ever seen,"},{"id":"seytek-2012:p1054:b003:l010","ordinal":378097,"en":"Beholding wondrous beasts—"},{"id":"seytek-2012:p1054:b003:l011","ordinal":378098,"en":"Wild bulls and camel-like deer."},{"id":"seytek-2012:p1054:b003:l012","ordinal":378099,"en":"Upon the broad plain of Keng-Özön,"},{"id":"seytek-2012:p1054:b003:l013","ordinal":378100,"en":"They camped in the pleasant valley,"},{"id":"seytek-2012:p1054:b003:l014","ordinal":378101,"en":"And became guests of Keng-Özön."},{"id":"seytek-2012:p1054:b003:l015","ordinal":378102,"en":"Ah, wondrous Keng-Özön,"},{"id":"seytek-2012:p1054:b003:l016","ordinal":378103,"en":"A valley blessed with perfect abundance."},{"id":"seytek-2012:p1054:b003:l017","ordinal":378104,"en":"If you ask what that valley was like,"},{"id":"seytek-2012:p1054:b003:l018","ordinal":378105,"en":"Apples ripened until the boughs bent;"},{"id":"seytek-2012:p1054:b003:l019","ordinal":378106,"en":"It was a land beloved by God."},{"id":"seytek-2012:p1054:b003:l020","ordinal":378107,"en":"Its springs boiled up and overflowed,"},{"id":"seytek-2012:p1054:b003:l021","ordinal":378108,"en":"And nightingales sang mournfully."},{"id":"seytek-2012:p1054:b003:l022","ordinal":378109,"en":"When a sorrowful mortal heard"},{"id":"seytek-2012:p1054:b003:l023","ordinal":378110,"en":"The nightingale’s voice, he wept."},{"id":"seytek-2012:p1054:b003:l024","ordinal":378111,"en":"Wild beasts inhabited the land,"},{"id":"seytek-2012:p1054:b003:l025","ordinal":378112,"en":"Where no human being had ever come."}]
