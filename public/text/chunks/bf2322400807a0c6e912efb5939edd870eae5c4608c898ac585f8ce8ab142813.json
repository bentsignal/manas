[{"id":"semetey-1-2013:p1052:b004:l028","ordinal":157441,"en":"Of Tümönbay and Azhybay,"},{"id":"semetey-1-2013:p1052:b004:l029","ordinal":157442,"en":"Could Kozho stand without surging forward?"},{"id":"semetey-1-2013:p1052:b004:l030","ordinal":157443,"en":"\"Azhybay and Tümönbay,"},{"id":"semetey-1-2013:p1052:b004:l031","ordinal":157444,"en":"Tell the lawful and unlawful truth."},{"id":"semetey-1-2013:p1052:b004:l032","ordinal":157445,"en":"If you will not give her, name your danger;"},{"id":"semetey-1-2013:p1052:b004:l033","ordinal":157446,"en":"If you say you will, state your answer!"},{"id":"semetey-1-2013:p1052:b004:l034","ordinal":157447,"en":"If you say you will not give Chürök,"},{"id":"semetey-1-2013:p1052:b004:l035","ordinal":157448,"en":"Let us begin the turmoil;"},{"id":"semetey-1-2013:p1052:b004:l036","ordinal":157449,"en":"Let us send the armies over you,"},{"id":"semetey-1-2013:p1052:b004:l037","ordinal":157450,"en":"And set your bitter sorrows boiling."},{"id":"semetey-1-2013:p1052:b004:l038","ordinal":157451,"en":"Tell me the purpose for which you girded your waist;"},{"id":"semetey-1-2013:p1052:b004:l039","ordinal":157452,"en":"Tell me the place where you lie fortified,"},{"id":"semetey-1-2013:p1053:b003:l001","ordinal":157453,"en":"Tell me the man you girded to your waist!"},{"id":"semetey-1-2013:p1053:b003:l002","ordinal":157454,"en":"Azhybay, son of Azhy,"},{"id":"semetey-1-2013:p1053:b003:l003","ordinal":157455,"en":"You spoke idly;"},{"id":"semetey-1-2013:p1053:b003:l004","ordinal":157456,"en":"Saying, 'I shall give Aychürök,'"},{"id":"semetey-1-2013:p1053:b003:l005","ordinal":157457,"en":"You have deceived us for five months."},{"id":"semetey-1-2013:p1053:b003:l006","ordinal":157458,"en":"After seeing your false oath and lies,"},{"id":"semetey-1-2013:p1053:b003:l007","ordinal":157459,"en":"I resolved to inflict a spectacle;"},{"id":"semetey-1-2013:p1053:b003:l008","ordinal":157460,"en":"Do you see that I drove out"},{"id":"semetey-1-2013:p1053:b003:l009","ordinal":157461,"en":"My dense black army?"},{"id":"semetey-1-2013:p1053:b003:l010","ordinal":157462,"en":"If you love splendid quarrels and strife,"},{"id":"semetey-1-2013:p1053:b003:l011","ordinal":157463,"en":"Do not hold back, my Azhy;"},{"id":"semetey-1-2013:p1053:b003:l012","ordinal":157464,"en":"If you will not give Chürök,"},{"id":"semetey-1-2013:p1053:b003:l013","ordinal":157465,"en":"Prepare the host with which you will contend."},{"id":"semetey-1-2013:p1053:b003:l014","ordinal":157466,"en":"Fighting with you,"},{"id":"semetey-1-2013:p1053:b003:l015","ordinal":157467,"en":"We barely escaped death;"},{"id":"semetey-1-2013:p1053:b003:l016","ordinal":157468,"en":"Because of what happened before,"},{"id":"semetey-1-2013:p1053:b003:l017","ordinal":157469,"en":"Because of Aychürök,"},{"id":"semetey-1-2013:p1053:b003:l018","ordinal":157470,"en":"We narrowly escaped death."},{"id":"semetey-1-2013:p1053:b003:l019","ordinal":157471,"en":"Firing guns and drawing bows,"},{"id":"semetey-1-2013:p1053:b003:l020","ordinal":157472,"en":"We fought with cracking volleys."},{"id":"semetey-1-2013:p1053:b003:l021","ordinal":157473,"en":"For the lone maiden Chürök,"},{"id":"semetey-1-2013:p1053:b003:l022","ordinal":157474,"en":"A band of heroes died on your side,"},{"id":"semetey-1-2013:p1053:b003:l023","ordinal":157475,"en":"And a band of heroes died on mine."},{"id":"semetey-1-2013:p1053:b003:l024","ordinal":157476,"en":"Listen closely to my words, Azhy!"},{"id":"semetey-1-2013:p1053:b003:l025","ordinal":157477,"en":"Until the pliant stalks ripen,"},{"id":"semetey-1-2013:p1053:b003:l026","ordinal":157478,"en":"Until the law's ashes fly,"},{"id":"semetey-1-2013:p1053:b003:l027","ordinal":157479,"en":"If we barely escape death"},{"id":"semetey-1-2013:p1053:b003:l028","ordinal":157480,"en":"After fighting hard for six months,"},{"id":"semetey-1-2013:p1053:b003:l029","ordinal":157481,"en":"Does one prosper by loving strife?"},{"id":"semetey-1-2013:p1053:b003:l030","ordinal":157482,"en":"Will this bring us any benefit?\""},{"id":"semetey-1-2013:p1053:b003:l031","ordinal":157483,"en":"As Kozho stood surging with fury,"},{"id":"semetey-1-2013:p1053:b003:l032","ordinal":157484,"en":"Tümönbay, son of Tülkü,"},{"id":"semetey-1-2013:p1053:b003:l033","ordinal":157485,"en":"Proved a man of stern temperament."},{"id":"semetey-1-2013:p1053:b003:l034","ordinal":157486,"en":"Azhybay, son of Azhy,"},{"id":"semetey-1-2013:p1053:b003:l035","ordinal":157487,"en":"Was a hero of surpassing eloquence;"},{"id":"semetey-1-2013:p1053:b003:l036","ordinal":157488,"en":"Speaking softly but casting weighty words,"},{"id":"semetey-1-2013:p1053:b003:l037","ordinal":157489,"en":"Azhybay, son of Azhy,"},{"id":"semetey-1-2013:p1053:b003:l038","ordinal":157490,"en":"Began to address Chynkozho:"},{"id":"semetey-1-2013:p1053:b003:l039","ordinal":157491,"en":"\"If you advance, here is the steppe road;"},{"id":"semetey-1-2013:p1053:b004:l001","ordinal":157492,"en":"If you overrun us, here are the Afghan people;"},{"id":"semetey-1-2013:p1053:b004:l002","ordinal":157493,"en":"If you dig deep, here is the pit;"},{"id":"semetey-1-2013:p1053:b004:l003","ordinal":157494,"en":"If you would boil misery, here is the bitterness."},{"id":"semetey-1-2013:p1053:b004:l004","ordinal":157495,"en":"Warrior Kozho, hear my words;"},{"id":"semetey-1-2013:p1053:b004:l005","ordinal":157496,"en":"God knows, and you decide."},{"id":"semetey-1-2013:p1053:b004:l006","ordinal":157497,"en":"Take notice of poor men like us,"},{"id":"semetey-1-2013:p1053:b004:l007","ordinal":157498,"en":"My precious Kozho, rather than slaughtering us"},{"id":"semetey-1-2013:p1053:b004:l008","ordinal":157499,"en":"For the sake of a maiden."},{"id":"semetey-1-2013:p1053:b004:l009","ordinal":157500,"en":"Do not begin a wondrous conflict;"},{"id":"semetey-1-2013:p1053:b004:l010","ordinal":157501,"en":"Saying, 'He will not give Aychürök,"},{"id":"semetey-1-2013:p1053:b004:l011","ordinal":157502,"en":"He will not accept what I say,'"},{"id":"semetey-1-2013:p1053:b004:l012","ordinal":157503,"en":"Do not reduce palm-sized Afghanistan"},{"id":"semetey-1-2013:p1053:b004:l013","ordinal":157504,"en":"To slaughter!"},{"id":"semetey-1-2013:p1053:b004:l014","ordinal":157505,"en":"There is much sorrow in the breast,"},{"id":"semetey-1-2013:p1053:b004:l015","ordinal":157506,"en":"Blustering Chynkozho;"},{"id":"semetey-1-2013:p1053:b004:l016","ordinal":157507,"en":"God stands witness to these words!"},{"id":"semetey-1-2013:p1053:b004:l017","ordinal":157508,"en":"Take care, Chynkozho:"},{"id":"semetey-1-2013:p1053:b004:l018","ordinal":157509,"en":"I have no reason to begrudge my daughter."},{"id":"semetey-1-2013:p1053:b004:l019","ordinal":157510,"en":"You did not come as an in-law driving livestock,"},{"id":"semetey-1-2013:p1053:b004:l020","ordinal":157511,"en":"Bowing in submission and chewing fat;"},{"id":"semetey-1-2013:p1053:b004:l021","ordinal":157512,"en":"You did not depart after speaking kindly,"},{"id":"semetey-1-2013:p1053:b004:l022","ordinal":157513,"en":"Nor offer tea before us."},{"id":"semetey-1-2013:p1053:b004:l023","ordinal":157514,"en":"Saying, 'I shall take Aychürök,'"},{"id":"semetey-1-2013:p1053:b004:l024","ordinal":157515,"en":"You offered no colt for slaughter."},{"id":"semetey-1-2013:p1053:b004:l025","ordinal":157516,"en":"You gave no kindly words,"},{"id":"semetey-1-2013:p1053:b004:l026","ordinal":157517,"en":"Warrior, saying, 'He spoke badly,'"},{"id":"semetey-1-2013:p1053:b004:l027","ordinal":157518,"en":"You say,"},{"id":"semetey-1-2013:p1053:b004:l028","ordinal":157519,"en":"You have no grounds to bluster."},{"id":"semetey-1-2013:p1053:b004:l029","ordinal":157520,"en":"You made me taste humiliation,"},{"id":"semetey-1-2013:p1053:b004:l030","ordinal":157521,"en":"And after scorning my hospitality,"},{"id":"semetey-1-2013:p1053:b004:l031","ordinal":157522,"en":"You thought to take through contempt"},{"id":"semetey-1-2013:p1053:b004:l032","ordinal":157523,"en":"My daughter Aychürök."},{"id":"semetey-1-2013:p1053:b004:l033","ordinal":157524,"en":"Do not take offense at that maiden"},{"id":"semetey-1-2013:p1053:b004:l034","ordinal":157525,"en":"And vent your wrath."},{"id":"semetey-1-2013:p1053:b004:l035","ordinal":157526,"en":"Saying, 'He will not give Aychürök,'"},{"id":"semetey-1-2013:p1053:b004:l036","ordinal":157527,"en":"Do not flatten my city!"},{"id":"semetey-1-2013:p1053:b004:l037","ordinal":157528,"en":"It is also true that I did not accept"},{"id":"semetey-1-2013:p1053:b004:l038","ordinal":157529,"en":"Your pledged words,"},{"id":"semetey-1-2013:p1053:b004:l039","ordinal":157530,"en":"After you lied so many times"},{"id":"semetey-1-2013:p1054:b003:l001","ordinal":157531,"en":"Chürök, daughter of Khan Akun,"},{"id":"semetey-1-2013:p1054:b003:l002","ordinal":157532,"en":"It is also true that I did not give."},{"id":"semetey-1-2013:p1054:b003:l003","ordinal":157533,"en":"The reason I have not given her is this:"},{"id":"semetey-1-2013:p1054:b003:l004","ordinal":157534,"en":"At a known place she has one who girded his waist,"},{"id":"semetey-1-2013:p1054:b003:l005","ordinal":157535,"en":"A husband lying ready and resolved."},{"id":"semetey-1-2013:p1054:b003:l006","ordinal":157536,"en":"The conquering leopard Manas—"},{"id":"semetey-1-2013:p1054:b003:l007","ordinal":157537,"en":"His son Semetey"},{"id":"semetey-1-2013:p1054:b003:l008","ordinal":157538,"en":"Is her husband of terrible wrath."},{"id":"semetey-1-2013:p1054:b003:l009","ordinal":157539,"en":"If Semetey comes tomorrow,"},{"id":"semetey-1-2013:p1054:b003:l010","ordinal":157540,"en":"Raging and thundering,"},{"id":"semetey-1-2013:p1054:b003:l011","ordinal":157541,"en":"'Where have you given my wife?' he will demand,"},{"id":"semetey-1-2013:p1054:b003:l012","ordinal":157542,"en":"And he too will come roaring."},{"id":"semetey-1-2013:p1054:b003:l013","ordinal":157543,"en":"Descendant of Dümpök,"},{"id":"semetey-1-2013:p1054:b003:l014","ordinal":157544,"en":"Who blazes whenever extinguished;"},{"id":"semetey-1-2013:p1054:b003:l015","ordinal":157545,"en":"Descendant of the fire-marked one,"},{"id":"semetey-1-2013:p1054:b003:l016","ordinal":157546,"en":"Who multiplies whenever killed;"},{"id":"semetey-1-2013:p1054:b003:l017","ordinal":157547,"en":"The leopard himself,"},{"id":"semetey-1-2013:p1054:b003:l018","ordinal":157548,"en":"Who poured blood into black water."},{"id":"semetey-1-2013:p1054:b003:l019","ordinal":157549,"en":"His father Manas was a lion,"},{"id":"semetey-1-2013:p1054:b003:l020","ordinal":157550,"en":"A hero who made"},{"id":"semetey-1-2013:p1054:b003:l021","ordinal":157551,"en":"The whole world tremble."},{"id":"semetey-1-2013:p1054:b003:l022","ordinal":157552,"en":"His father was the leopard Manas,"},{"id":"semetey-1-2013:p1054:b003:l023","ordinal":157553,"en":"Who drove white deer and made them cattle,"},{"id":"semetey-1-2013:p1054:b003:l024","ordinal":157554,"en":"And threw the whole world into turmoil."},{"id":"semetey-1-2013:p1054:b003:l025","ordinal":157555,"en":"Have you heard the news"},{"id":"semetey-1-2013:p1054:b003:l026","ordinal":157556,"en":"That wrathful Manas was born a khan,"},{"id":"semetey-1-2013:p1054:b003:l027","ordinal":157557,"en":"And souls fled before his courage?"},{"id":"semetey-1-2013:p1054:b003:l028","ordinal":157558,"en":"While heroic Manas lived,"},{"id":"semetey-1-2013:p1054:b003:l029","ordinal":157559,"en":"No one who faced him remained alive;"},{"id":"semetey-1-2013:p1054:b003:l030","ordinal":157560,"en":"When they saw his heroism,"},{"id":"semetey-1-2013:p1054:b003:l031","ordinal":157561,"en":"The khan of Beijing wept."},{"id":"semetey-1-2013:p1054:b003:l032","ordinal":157562,"en":"The news of it still remains:"},{"id":"semetey-1-2013:p1054:b003:l033","ordinal":157563,"en":"Manas devastated the age,"},{"id":"semetey-1-2013:p1054:b003:l034","ordinal":157564,"en":"And slaughtered and destroyed"},{"id":"semetey-1-2013:p1054:b003:l035","ordinal":157565,"en":"Enemies who acted crookedly."},{"id":"semetey-1-2013:p1054:b003:l036","ordinal":157566,"en":"He hewed down those he fought"},{"id":"semetey-1-2013:p1054:b003:l037","ordinal":157567,"en":"And straightened every crooked thing."},{"id":"semetey-1-2013:p1054:b003:l038","ordinal":157568,"en":"The whole world gathered,"},{"id":"semetey-1-2013:p1054:b003:l039","ordinal":157569,"en":"Yet against falcon Manas the conqueror"},{"id":"semetey-1-2013:p1054:b004:l001","ordinal":157570,"en":"None could speak a word of outrage."},{"id":"semetey-1-2013:p1054:b004:l002","ordinal":157571,"en":"Wherever he spent the night,"},{"id":"semetey-1-2013:p1054:b004:l003","ordinal":157572,"en":"A deep-rooted shrine arose."},{"id":"semetey-1-2013:p1054:b004:l004","ordinal":157573,"en":"Descendant of the deathless one,"},{"id":"semetey-1-2013:p1054:b004:l005","ordinal":157574,"en":"Supported from his roots by Khydyr."},{"id":"semetey-1-2013:p1054:b004:l006","ordinal":157575,"en":"One of my ears has heard this:"},{"id":"semetey-1-2013:p1054:b004:l007","ordinal":157576,"en":"He blazes whenever extinguished,"},{"id":"semetey-1-2013:p1054:b004:l008","ordinal":157577,"en":"And multiplies whenever killed."},{"id":"semetey-1-2013:p1054:b004:l009","ordinal":157578,"en":"He turned away toward Bukhara"},{"id":"semetey-1-2013:p1054:b004:l010","ordinal":157579,"en":"And there recovered;"},{"id":"semetey-1-2013:p1054:b004:l011","ordinal":157580,"en":"Until he reached ten years,"},{"id":"semetey-1-2013:p1054:b004:l012","ordinal":157581,"en":"He remained lost in Bukhara."},{"id":"semetey-1-2013:p1054:b004:l013","ordinal":157582,"en":"When he reached twelve,"},{"id":"semetey-1-2013:p1054:b004:l014","ordinal":157583,"en":"He migrated from Bukhara and took the road,"},{"id":"semetey-1-2013:p1054:b004:l015","ordinal":157584,"en":"And, they say, occupied broad Talas."},{"id":"semetey-1-2013:p1054:b004:l016","ordinal":157585,"en":"They say he scattered the wealth"},{"id":"semetey-1-2013:p1054:b004:l017","ordinal":157586,"en":"Of Abyke and Köbösh,"},{"id":"semetey-1-2013:p1054:b004:l018","ordinal":157587,"en":"And took the place of Manas."},{"id":"semetey-1-2013:p1054:b004:l019","ordinal":157588,"en":"I hear travelers say:"},{"id":"semetey-1-2013:p1054:b004:l020","ordinal":157589,"en":"'From his great-hearted father Manas,"},{"id":"semetey-1-2013:p1054:b004:l021","ordinal":157590,"en":"The lion-child Semetey"},{"id":"semetey-1-2013:p1054:b004:l022","ordinal":157591,"en":"Emerged greater,' I hear."},{"id":"semetey-1-2013:p1054:b004:l023","ordinal":157592,"en":"Saying, 'We shall cause trouble beneath him,'"},{"id":"semetey-1-2013:p1054:b004:l024","ordinal":157593,"en":"Abyke and Köbösh died, they say;"},{"id":"semetey-1-2013:p1054:b004:l025","ordinal":157594,"en":"Through lack of wisdom, those dogs"},{"id":"semetey-1-2013:p1054:b004:l026","ordinal":157595,"en":"Saw the face of the other world, they say."},{"id":"semetey-1-2013:p1054:b004:l027","ordinal":157596,"en":"Look upon the great devilment"},{"id":"semetey-1-2013:p1054:b004:l028","ordinal":157597,"en":"Of that fierce mad youth."},{"id":"semetey-1-2013:p1054:b004:l029","ordinal":157598,"en":"They say he slaughtered his grandfather, great Zhakyp,"},{"id":"semetey-1-2013:p1054:b004:l030","ordinal":157599,"en":"And drank his fill of his blood;"},{"id":"semetey-1-2013:p1054:b004:l031","ordinal":157600,"en":"They say he slaughtered"},{"id":"semetey-1-2013:p1054:b004:l032","ordinal":157601,"en":"Everyone who challenged him."},{"id":"semetey-1-2013:p1054:b004:l033","ordinal":157602,"en":"When he migrated onward from Bukhara,"},{"id":"semetey-1-2013:p1054:b004:l034","ordinal":157603,"en":"From this side of Kokand,"},{"id":"semetey-1-2013:p1054:b004:l035","ordinal":157604,"en":"At the overturned edge"},{"id":"semetey-1-2013:p1054:b004:l036","ordinal":157605,"en":"Of a steppe broad as the moon,"},{"id":"semetey-1-2013:p1054:b004:l037","ordinal":157606,"en":"All Kokand gathered,"},{"id":"semetey-1-2013:p1054:b004:l038","ordinal":157607,"en":"All six thousand champions,"},{"id":"semetey-1-2013:p1054:b004:l039","ordinal":157608,"en":"Led by Zhanaaly and Karach,"},{"id":"semetey-1-2013:p1055:b003:l001","ordinal":157609,"en":"They went to wage war, they say;"},{"id":"semetey-1-2013:p1055:b003:l002","ordinal":157610,"en":"With Zhanaaly and Karach at their head,"},{"id":"semetey-1-2013:p1055:b003:l003","ordinal":157611,"en":"All of the great army"},{"id":"semetey-1-2013:p1055:b003:l004","ordinal":157612,"en":"Was slaughtered, they say."},{"id":"semetey-1-2013:p1055:b003:l005","ordinal":157613,"en":"Finding the Argyn and Kyrgyz people,"},{"id":"semetey-1-2013:p1055:b003:l006","ordinal":157614,"en":"Finding a land like Talas,"},{"id":"semetey-1-2013:p1055:b003:l007","ordinal":157615,"en":"Yesterday, when the boy came to Talas,"},{"id":"semetey-1-2013:p1055:b003:l008","ordinal":157616,"en":"His blue-lynx and sable cap"},{"id":"semetey-1-2013:p1055:b003:l009","ordinal":157617,"en":"Leaped as he dismounted, I heard."},{"id":"semetey-1-2013:p1055:b003:l010","ordinal":157618,"en":"When he was about to settle in Talas,"},{"id":"semetey-1-2013:p1055:b003:l011","ordinal":157619,"en":"'Aychürök is my wife,"},{"id":"semetey-1-2013:p1055:b003:l012","ordinal":157620,"en":"And Khan Akun is my father-in-law,'"},{"id":"semetey-1-2013:p1055:b003:l013","ordinal":157621,"en":"He sang as he dismounted, I heard."},{"id":"semetey-1-2013:p1055:b003:l014","ordinal":157622,"en":"When his anger was provoked,"},{"id":"semetey-1-2013:p1055:b003:l015","ordinal":157623,"en":"He slaughtered forty companions, they say;"},{"id":"semetey-1-2013:p1055:b003:l016","ordinal":157624,"en":"When they saw his might,"},{"id":"semetey-1-2013:p1055:b003:l017","ordinal":157625,"en":"The whole world fell"},{"id":"semetey-1-2013:p1055:b003:l018","ordinal":157626,"en":"Into the boy's hands, they say."},{"id":"semetey-1-2013:p1055:b003:l019","ordinal":157627,"en":"Azhybay, who went about lying,"},{"id":"semetey-1-2013:p1055:b003:l020","ordinal":157628,"en":"Is known for telling lies."},{"id":"semetey-1-2013:p1055:b003:l021","ordinal":157629,"en":"She has a father-in-law in a formidable place;"},{"id":"semetey-1-2013:p1055:b003:l022","ordinal":157630,"en":"Aychürök, daughter of Akun—"},{"id":"semetey-1-2013:p1055:b003:l023","ordinal":157631,"en":"The reason I could not seize and give her is this:"},{"id":"semetey-1-2013:p1055:b003:l024","ordinal":157632,"en":"Calamitous Chürök"},{"id":"semetey-1-2013:p1055:b003:l025","ordinal":157633,"en":"Has one who girded his waist for her,"},{"id":"semetey-1-2013:p1055:b003:l026","ordinal":157634,"en":"Has a place where he lies fortified,"},{"id":"semetey-1-2013:p1055:b003:l027","ordinal":157635,"en":"And has a husband in such a perilous land."},{"id":"semetey-1-2013:p1055:b003:l028","ordinal":157636,"en":"If we two go out to face him,"},{"id":"semetey-1-2013:p1055:b003:l029","ordinal":157637,"en":"The lion Semetey, rather than us,"},{"id":"semetey-1-2013:p1055:b003:l030","ordinal":157638,"en":"Has the power to throw"},{"id":"semetey-1-2013:p1055:b003:l031","ordinal":157639,"en":"The whole world into turmoil;"},{"id":"semetey-1-2013:p1055:b003:l032","ordinal":157640,"en":"She has such a commanding gray-wolf husband."},{"id":"semetey-1-2013:p1055:b003:l033","ordinal":157641,"en":"Aychürök, daughter of Akun—"},{"id":"semetey-1-2013:p1055:b003:l034","ordinal":157642,"en":"My Kozho, if you live, you will see:"},{"id":"semetey-1-2013:p1055:b003:l035","ordinal":157643,"en":"She will bring great turmoil upon the world."},{"id":"semetey-1-2013:p1055:b003:l036","ordinal":157644,"en":"Sheer cliff descending into the valley,"},{"id":"semetey-1-2013:p1055:b003:l037","ordinal":157645,"en":"Fiery and bold Chürök;"},{"id":"semetey-1-2013:p1055:b003:l038","ordinal":157646,"en":"When she assumes the form of a swan,"},{"id":"semetey-1-2013:p1055:b003:l039","ordinal":157647,"en":"Only Friday night knows where she flies."},{"id":"semetey-1-2013:p1055:b004:l001","ordinal":157648,"en":"Who knows where"},{"id":"semetey-1-2013:p1055:b004:l002","ordinal":157649,"en":"Calamitous Chürök may be!"},{"id":"semetey-1-2013:p1055:b004:l003","ordinal":157650,"en":"Unruly and raging Chürök,"},{"id":"semetey-1-2013:p1055:b004:l004","ordinal":157651,"en":"The turmoil born among mortals,"},{"id":"semetey-1-2013:p1055:b004:l005","ordinal":157652,"en":"Born never to fall into a man's snare,"},{"id":"semetey-1-2013:p1055:b004:l006","ordinal":157653,"en":"Never to fall into anyone's hands—"},{"id":"semetey-1-2013:p1055:b004:l007","ordinal":157654,"en":"Aychürök was born"},{"id":"semetey-1-2013:p1055:b004:l008","ordinal":157655,"en":"To be the Afghans' sorrow."},{"id":"semetey-1-2013:p1055:b004:l009","ordinal":157656,"en":"The people gathered in fascination"},{"id":"semetey-1-2013:p1055:b004:l010","ordinal":157657,"en":"And longed for Chürök."},{"id":"semetey-1-2013:p1055:b004:l011","ordinal":157658,"en":"Saying, 'I shall conquer her today,'"},{"id":"semetey-1-2013:p1055:b004:l012","ordinal":157659,"en":"You brought turmoil upon Afghanistan."},{"id":"semetey-1-2013:p1055:b004:l013","ordinal":157660,"en":"Do not roar, Chynkozho;"},{"id":"semetey-1-2013:p1055:b004:l014","ordinal":157661,"en":"Hold your army back for now."},{"id":"semetey-1-2013:p1055:b004:l015","ordinal":157662,"en":"I shall seize Chürök and give her to you;"},{"id":"semetey-1-2013:p1055:b004:l016","ordinal":157663,"en":"You yourself must bear"},{"id":"semetey-1-2013:p1055:b004:l017","ordinal":157664,"en":"The turmoil that follows behind her."},{"id":"semetey-1-2013:p1055:b004:l018","ordinal":157665,"en":"I have explained it plainly;"},{"id":"semetey-1-2013:p1055:b004:l019","ordinal":157666,"en":"Here is how the matter stands."},{"id":"semetey-1-2013:p1055:b004:l020","ordinal":157667,"en":"Listen, Chynkozho:"},{"id":"semetey-1-2013:p1055:b004:l021","ordinal":157668,"en":"She has a father-in-law in a turbulent land."},{"id":"semetey-1-2013:p1055:b004:l022","ordinal":157669,"en":"You committed violence many times;"},{"id":"semetey-1-2013:p1055:b004:l023","ordinal":157670,"en":"It is true that I did not consent."},{"id":"semetey-1-2013:p1055:b004:l024","ordinal":157671,"en":"You spoke many lying words;"},{"id":"semetey-1-2013:p1055:b004:l025","ordinal":157672,"en":"It is true that, fearing the end of it,"},{"id":"semetey-1-2013:p1055:b004:l026","ordinal":157673,"en":"I did not give Chürök."},{"id":"semetey-1-2013:p1055:b004:l027","ordinal":157674,"en":"You committed many kinds of violence;"},{"id":"semetey-1-2013:p1055:b004:l028","ordinal":157675,"en":"It is true that I did not consent."},{"id":"semetey-1-2013:p1055:b004:l029","ordinal":157676,"en":"Find wisdom and devise a plan;"},{"id":"semetey-1-2013:p1055:b004:l030","ordinal":157677,"en":"If you find wisdom, Chynkozho,"},{"id":"semetey-1-2013:p1055:b004:l031","ordinal":157678,"en":"Choose among women and take my masterwork."},{"id":"semetey-1-2013:p1055:b004:l032","ordinal":157679,"en":"You have come desiring her expressly;"},{"id":"semetey-1-2013:p1055:b004:l033","ordinal":157680,"en":"Take my daughter Aychürök!"},{"id":"semetey-1-2013:p1055:b004:l034","ordinal":157681,"en":"Together with the maiden, Chynkozho,"},{"id":"semetey-1-2013:p1055:b004:l035","ordinal":157682,"en":"Take my red-tailed knowledge;"},{"id":"semetey-1-2013:p1055:b004:l036","ordinal":157683,"en":"I am one whose soul feared turmoil—"},{"id":"semetey-1-2013:p1055:b004:l037","ordinal":157684,"en":"Understand what I have said!\""},{"id":"semetey-1-2013:p1055:b004:l038","ordinal":157685,"en":"Kozho stood surging with fury,"},{"id":"semetey-1-2013:p1055:b004:l039","ordinal":157686,"en":"Lashing the earth with his whip,"},{"id":"semetey-1-2013:p1056:b003:l001","ordinal":157687,"en":"And spoke to Azhybay:"},{"id":"semetey-1-2013:p1056:b003:l002","ordinal":157688,"en":"\"Accursed Azhybay!"},{"id":"semetey-1-2013:p1056:b003:l003","ordinal":157689,"en":"If you say you will give the maiden, tell the truth;"},{"id":"semetey-1-2013:p1056:b003:l004","ordinal":157690,"en":"Do not babble of grievous afflictions."},{"id":"semetey-1-2013:p1056:b003:l005","ordinal":157691,"en":"When I demand the maiden, you squirm,"},{"id":"semetey-1-2013:p1056:b003:l006","ordinal":157692,"en":"And provoke my anger"},{"id":"semetey-1-2013:p1056:b003:l007","ordinal":157693,"en":"By babbling empty words."},{"id":"semetey-1-2013:p1056:b003:l008","ordinal":157694,"en":"Is Talas where he dwells"},{"id":"semetey-1-2013:p1056:b003:l009","ordinal":157695,"en":"Greater than the waters of Zheti-Özön?"},{"id":"semetey-1-2013:p1056:b003:l010","ordinal":157696,"en":"Azhybay, sunk into the earth,"}]
