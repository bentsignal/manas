[{"id":"semetey-1-2013:p1118:b004:l022","ordinal":161537,"en":"Before much time had passed,"},{"id":"semetey-1-2013:p1118:b004:l023","ordinal":161538,"en":"Before one could say this or that,"},{"id":"semetey-1-2013:p1118:b004:l024","ordinal":161539,"en":"In the blink of an eye,"},{"id":"semetey-1-2013:p1118:b004:l025","ordinal":161540,"en":"The Muslim people parted,"},{"id":"semetey-1-2013:p1118:b004:l026","ordinal":161541,"en":"Splitting straight down the center."},{"id":"semetey-1-2013:p1118:b004:l027","ordinal":161542,"en":"If you had seen Orokkyr,"},{"id":"semetey-1-2013:p1118:b004:l028","ordinal":161543,"en":"He came prepared into their midst."},{"id":"semetey-1-2013:p1118:b004:l029","ordinal":161544,"en":"A thousand wrestlers serving the feast"},{"id":"semetey-1-2013:p1118:b004:l030","ordinal":161545,"en":"Surrounded him and took his horse."},{"id":"semetey-1-2013:p1118:b004:l031","ordinal":161546,"en":"The wrestlers took his horse;"},{"id":"semetey-1-2013:p1118:b004:l032","ordinal":161547,"en":"Swelling with pride among the people,"},{"id":"semetey-1-2013:p1118:b004:l033","ordinal":161548,"en":"Orokkyr dismounted."},{"id":"semetey-1-2013:p1118:b004:l034","ordinal":161549,"en":"From Kökötöy's great store of gold,"},{"id":"semetey-1-2013:p1118:b004:l035","ordinal":161550,"en":"For a hero such as Orokkyr,"},{"id":"semetey-1-2013:p1118:b004:l036","ordinal":161551,"en":"Kökötöy's son Bokmurun"},{"id":"semetey-1-2013:p1118:b004:l037","ordinal":161552,"en":"Presented him a gift."},{"id":"semetey-1-2013:p1118:b004:l038","ordinal":161553,"en":"Orokkyr accepted his gift"},{"id":"semetey-1-2013:p1118:b004:l039","ordinal":161554,"en":"And was pleased."}]
