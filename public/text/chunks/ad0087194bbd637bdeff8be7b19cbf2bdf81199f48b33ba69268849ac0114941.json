[{"id":"semetey-1-2013:p1092:b003:l020","ordinal":159489,"en":"Of infidel and Muslim alike"},{"id":"semetey-1-2013:p1092:b003:l021","ordinal":159490,"en":"And hold my father's feast;"},{"id":"semetey-1-2013:p1092:b003:l022","ordinal":159491,"en":"Thus I shall test the strength"},{"id":"semetey-1-2013:p1092:b003:l023","ordinal":159492,"en":"Of the countless herds my father gathered."},{"id":"semetey-1-2013:p1092:b003:l024","ordinal":159493,"en":"On the ridges I have six ilek of horses;"},{"id":"semetey-1-2013:p1092:b003:l025","ordinal":159494,"en":"I shall drive and stake them as prizes."},{"id":"semetey-1-2013:p1092:b003:l026","ordinal":159495,"en":"I have innumerable dark camels;"},{"id":"semetey-1-2013:p1092:b003:l027","ordinal":159496,"en":"Without counting, I shall stake them as prizes."},{"id":"semetey-1-2013:p1092:b003:l028","ordinal":159497,"en":"At my noble gray-wolf father's death,"},{"id":"semetey-1-2013:p1092:b003:l029","ordinal":159498,"en":"Proclaiming the grave prizes"},{"id":"semetey-1-2013:p1092:b003:l030","ordinal":159499,"en":"Before all the people,"},{"id":"semetey-1-2013:p1092:b003:l031","ordinal":159500,"en":"I shall now stake great prizes."},{"id":"semetey-1-2013:p1092:b003:l032","ordinal":159501,"en":"At Khan Kökötöy's feast,"},{"id":"semetey-1-2013:p1092:b003:l033","ordinal":159502,"en":"What mortal will rival me?"},{"id":"semetey-1-2013:p1092:b003:l034","ordinal":159503,"en":"When infidel and Muslim"},{"id":"semetey-1-2013:p1092:b003:l035","ordinal":159504,"en":"Come against one another,"},{"id":"semetey-1-2013:p1092:b003:l036","ordinal":159505,"en":"The bald men will butt heads with a crash;"},{"id":"semetey-1-2013:p1092:b003:l037","ordinal":159506,"en":"Then the spectacle will begin."},{"id":"semetey-1-2013:p1092:b003:l038","ordinal":159507,"en":"At this feast of mine,"},{"id":"semetey-1-2013:p1092:b003:l039","ordinal":159508,"en":"They will seize one another by the trouser cuffs,"},{"id":"semetey-1-2013:p1092:b004:l001","ordinal":159509,"en":"And the wrestlers will wrestle."},{"id":"semetey-1-2013:p1092:b004:l002","ordinal":159510,"en":"I shall open a city bazaar"},{"id":"semetey-1-2013:p1092:b004:l003","ordinal":159511,"en":"And scatter my dear father's"},{"id":"semetey-1-2013:p1092:b004:l004","ordinal":159512,"en":"Countless riches in heaps."},{"id":"semetey-1-2013:p1092:b004:l005","ordinal":159513,"en":"I shall gather all the giants"},{"id":"semetey-1-2013:p1092:b004:l006","ordinal":159514,"en":"Of infidel and Muslim alike."},{"id":"semetey-1-2013:p1092:b004:l007","ordinal":159515,"en":"When I stake abundant prizes,"},{"id":"semetey-1-2013:p1092:b004:l008","ordinal":159516,"en":"Their lance shafts will bend,"},{"id":"semetey-1-2013:p1092:b004:l009","ordinal":159517,"en":"And heroic men will joust."},{"id":"semetey-1-2013:p1092:b004:l010","ordinal":159518,"en":"My father Kökötöy's"},{"id":"semetey-1-2013:p1092:b004:l011","ordinal":159519,"en":"Surging, countless riches—"},{"id":"semetey-1-2013:p1092:b004:l012","ordinal":159520,"en":"I shall scatter them all for my father."},{"id":"semetey-1-2013:p1092:b004:l013","ordinal":159521,"en":"As arbiter I shall appoint"},{"id":"semetey-1-2013:p1092:b004:l014","ordinal":159522,"en":"Old Koshoy of the Katagan."},{"id":"semetey-1-2013:p1092:b004:l015","ordinal":159523,"en":"I have abundant, ample herds;"},{"id":"semetey-1-2013:p1092:b004:l016","ordinal":159524,"en":"I have the means to feast"},{"id":"semetey-1-2013:p1092:b004:l017","ordinal":159525,"en":"Infidel and Muslim alike"},{"id":"semetey-1-2013:p1092:b004:l018","ordinal":159526,"en":"For seven years."},{"id":"semetey-1-2013:p1092:b004:l019","ordinal":159527,"en":"If Kökötöy's great wealth"},{"id":"semetey-1-2013:p1092:b004:l020","ordinal":159528,"en":"Proves little rather than much,"},{"id":"semetey-1-2013:p1092:b004:l021","ordinal":159529,"en":"If much babbling arises among us"},{"id":"semetey-1-2013:p1092:b004:l022","ordinal":159530,"en":"And open kinsmen become foes,"},{"id":"semetey-1-2013:p1092:b004:l023","ordinal":159531,"en":"I shall divide the four kinds of livestock."},{"id":"semetey-1-2013:p1092:b004:l024","ordinal":159532,"en":"I shall impose hardship and grandeur"},{"id":"semetey-1-2013:p1092:b004:l025","ordinal":159533,"en":"Without holding back,"},{"id":"semetey-1-2013:p1092:b004:l026","ordinal":159534,"en":"And overwhelm all the people"},{"id":"semetey-1-2013:p1092:b004:l027","ordinal":159535,"en":"With my full force."},{"id":"semetey-1-2013:p1092:b004:l028","ordinal":159536,"en":"Until only one bull remains,"},{"id":"semetey-1-2013:p1092:b004:l029","ordinal":159537,"en":"I shall scatter my great riches."},{"id":"semetey-1-2013:p1092:b004:l030","ordinal":159538,"en":"There are many peoples who do not eat meat,"},{"id":"semetey-1-2013:p1092:b004:l031","ordinal":159539,"en":"Many mortals wandering about agape,"},{"id":"semetey-1-2013:p1092:b004:l032","ordinal":159540,"en":"Who know neither feasts nor horses."},{"id":"semetey-1-2013:p1092:b004:l033","ordinal":159541,"en":"I shall devise something worse than a raid:"},{"id":"semetey-1-2013:p1092:b004:l034","ordinal":159542,"en":"Let the gathered people be ruined;"},{"id":"semetey-1-2013:p1092:b004:l035","ordinal":159543,"en":"I shall hold a feast for Kökötöy."},{"id":"semetey-1-2013:p1092:b004:l036","ordinal":159544,"en":"If Kökötöy's great herds"},{"id":"semetey-1-2013:p1092:b004:l037","ordinal":159545,"en":"Unexpectedly prove insufficient,"},{"id":"semetey-1-2013:p1092:b004:l038","ordinal":159546,"en":"Upon the thundering Muslims,"},{"id":"semetey-1-2013:p1092:b004:l039","ordinal":159547,"en":"For my dear father's feast,"},{"id":"semetey-1-2013:p1093:b003:l001","ordinal":159548,"en":"I shall levy a tax upon every hearth;"},{"id":"semetey-1-2013:p1093:b003:l002","ordinal":159549,"en":"I shall discipline and beat them all,"},{"id":"semetey-1-2013:p1093:b003:l003","ordinal":159550,"en":"And gather everything, leaving nothing."},{"id":"semetey-1-2013:p1093:b003:l004","ordinal":159551,"en":"Uncle Koshoy, hear my words!"},{"id":"semetey-1-2013:p1093:b003:l005","ordinal":159552,"en":"Among the sheep is a sacred he-goat"},{"id":"semetey-1-2013:p1093:b003:l006","ordinal":159553,"en":"That never stirs from the flock."},{"id":"semetey-1-2013:p1093:b003:l007","ordinal":159554,"en":"Maintained by the treasury,"},{"id":"semetey-1-2013:p1093:b003:l008","ordinal":159555,"en":"In my dear father's palace"},{"id":"semetey-1-2013:p1093:b003:l009","ordinal":159556,"en":"Are two hundred pampered maidens."},{"id":"semetey-1-2013:p1093:b003:l010","ordinal":159557,"en":"Their bodies are richly adorned;"},{"id":"semetey-1-2013:p1093:b003:l011","ordinal":159558,"en":"I intend to stake them all"},{"id":"semetey-1-2013:p1093:b003:l012","ordinal":159559,"en":"As prizes.\""},{"id":"semetey-1-2013:p1093:b003:l013","ordinal":159560,"en":"Then, as though pierced in a gland,"},{"id":"semetey-1-2013:p1093:b003:l014","ordinal":159561,"en":"Hero Koshoy sprang up:"},{"id":"semetey-1-2013:p1093:b003:l015","ordinal":159562,"en":"\"My child, he who gives a feast incurs blame;"},{"id":"semetey-1-2013:p1093:b003:l016","ordinal":159563,"en":"He who gives a feast incurs sin."},{"id":"semetey-1-2013:p1093:b003:l017","ordinal":159564,"en":"Steel will strike on the descent,"},{"id":"semetey-1-2013:p1093:b003:l018","ordinal":159565,"en":"And we Kyrgyz will be few."},{"id":"semetey-1-2013:p1093:b003:l019","ordinal":159566,"en":"The black Chinese and Manchu people"},{"id":"semetey-1-2013:p1093:b003:l020","ordinal":159567,"en":"Will be enemies to our people."},{"id":"semetey-1-2013:p1093:b003:l021","ordinal":159568,"en":"There is the teeming black Chinese"},{"id":"semetey-1-2013:p1093:b003:l022","ordinal":159569,"en":"People of Kakan-Chyn;"},{"id":"semetey-1-2013:p1093:b003:l023","ordinal":159570,"en":"If they attack, they have the custom"},{"id":"semetey-1-2013:p1093:b003:l024","ordinal":159571,"en":"Of drinking Kyrgyz blood."},{"id":"semetey-1-2013:p1093:b003:l025","ordinal":159572,"en":"There is a crooked people;"},{"id":"semetey-1-2013:p1093:b003:l026","ordinal":159573,"en":"To straighten their perversity,"},{"id":"semetey-1-2013:p1093:b003:l027","ordinal":159574,"en":"There is the hellish wolf Zholoy."},{"id":"semetey-1-2013:p1093:b003:l028","ordinal":159575,"en":"There are black Chinese and many Manchus,"},{"id":"semetey-1-2013:p1093:b003:l029","ordinal":159576,"en":"Infidels seething in multitudes;"},{"id":"semetey-1-2013:p1093:b003:l030","ordinal":159577,"en":"Over all of them"},{"id":"semetey-1-2013:p1093:b003:l031","ordinal":159578,"en":"There is the hero Khan Kongurbay."},{"id":"semetey-1-2013:p1093:b003:l032","ordinal":159579,"en":"When his wrath seizes him,"},{"id":"semetey-1-2013:p1093:b003:l033","ordinal":159580,"en":"Might he not unleash havoc?"},{"id":"semetey-1-2013:p1093:b003:l034","ordinal":159581,"en":"The reason he would unleash havoc is this:"},{"id":"semetey-1-2013:p1093:b003:l035","ordinal":159582,"en":"Bloodthirsty Manas killed"},{"id":"semetey-1-2013:p1093:b003:l036","ordinal":159583,"en":"His father, Khan Alööke."},{"id":"semetey-1-2013:p1093:b003:l037","ordinal":159584,"en":"Might he not begin battle at the feast"},{"id":"semetey-1-2013:p1093:b003:l038","ordinal":159585,"en":"And inflict a single calamity?"},{"id":"semetey-1-2013:p1093:b003:l039","ordinal":159586,"en":"There is the capable Boroonchu,"},{"id":"semetey-1-2013:p1093:b004:l001","ordinal":159587,"en":"Who went and joined the Kakan;"},{"id":"semetey-1-2013:p1093:b004:l002","ordinal":159588,"en":"And Bozkertik of Tokushker—"},{"id":"semetey-1-2013:p1093:b004:l003","ordinal":159589,"en":"Those three are brothers."},{"id":"semetey-1-2013:p1093:b004:l004","ordinal":159590,"en":"Seeking to attack"},{"id":"semetey-1-2013:p1093:b004:l005","ordinal":159591,"en":"The tiger, bloodthirsty Manas,"},{"id":"semetey-1-2013:p1093:b004:l006","ordinal":159592,"en":"They too lost their father."},{"id":"semetey-1-2013:p1093:b004:l007","ordinal":159593,"en":"The steadfast black Chinese"},{"id":"semetey-1-2013:p1093:b004:l008","ordinal":159594,"en":"Have an unending vengeance."},{"id":"semetey-1-2013:p1093:b004:l009","ordinal":159595,"en":"If you summon the peoples"},{"id":"semetey-1-2013:p1093:b004:l010","ordinal":159596,"en":"To your khan-father Kökötöy's feast,"},{"id":"semetey-1-2013:p1093:b004:l011","ordinal":159597,"en":"They have lions who will fight us."},{"id":"semetey-1-2013:p1093:b004:l012","ordinal":159598,"en":"There is the elder Khan Kökötöy;"},{"id":"semetey-1-2013:p1093:b004:l013","ordinal":159599,"en":"Here are all"},{"id":"semetey-1-2013:p1093:b004:l014","ordinal":159600,"en":"The Kyrgyz khans' sons."},{"id":"semetey-1-2013:p1093:b004:l015","ordinal":159601,"en":"When Karakan arose from the Kyrgyz,"},{"id":"semetey-1-2013:p1093:b004:l016","ordinal":159602,"en":"Reigned as khan, and died,"},{"id":"semetey-1-2013:p1093:b004:l017","ordinal":159603,"en":"When he passed to the other world,"},{"id":"semetey-1-2013:p1093:b004:l018","ordinal":159604,"en":"All eight of Karakan's sons"},{"id":"semetey-1-2013:p1093:b004:l019","ordinal":159605,"en":"Were left powerless and bewildered,"},{"id":"semetey-1-2013:p1093:b004:l020","ordinal":159606,"en":"Left as crawling children."},{"id":"semetey-1-2013:p1093:b004:l021","ordinal":159607,"en":"The struggle for the khanate is a hard affair."},{"id":"semetey-1-2013:p1093:b004:l022","ordinal":159608,"en":"When they brought havoc upon"},{"id":"semetey-1-2013:p1093:b004:l023","ordinal":159609,"en":"These many Kyrgyz people"},{"id":"semetey-1-2013:p1093:b004:l024","ordinal":159610,"en":"And scattered those who resisted,"},{"id":"semetey-1-2013:p1093:b004:l025","ordinal":159611,"en":"When the Chinese day dawned,"},{"id":"semetey-1-2013:p1093:b004:l026","ordinal":159612,"en":"They pursued with gunfire"},{"id":"semetey-1-2013:p1093:b004:l027","ordinal":159613,"en":"Those who resisted."},{"id":"semetey-1-2013:p1093:b004:l028","ordinal":159614,"en":"When the fighting people"},{"id":"semetey-1-2013:p1093:b004:l029","ordinal":159615,"en":"Died enduring humiliation,"},{"id":"semetey-1-2013:p1093:b004:l030","ordinal":159616,"en":"Whoever fell into the Chinese hands—"},{"id":"semetey-1-2013:p1093:b004:l031","ordinal":159617,"en":"They drove one away to a hero"},{"id":"semetey-1-2013:p1093:b004:l032","ordinal":159618,"en":"And cast another into a ravine."},{"id":"semetey-1-2013:p1093:b004:l033","ordinal":159619,"en":"They drove one into captivity"},{"id":"semetey-1-2013:p1093:b004:l034","ordinal":159620,"en":"And another to Altay."},{"id":"semetey-1-2013:p1093:b004:l035","ordinal":159621,"en":"Zhakyp was exiled to Altay;"},{"id":"semetey-1-2013:p1093:b004:l036","ordinal":159622,"en":"The lion Manas, the bloodthirsty beast,"},{"id":"semetey-1-2013:p1093:b004:l037","ordinal":159623,"en":"Was born while they wandered in exile."},{"id":"semetey-1-2013:p1093:b004:l038","ordinal":159624,"en":"Born with perfect fortune,"},{"id":"semetey-1-2013:p1093:b004:l039","ordinal":159625,"en":"The dark gray wolf Manas"},{"id":"semetey-1-2013:p1094:b003:l001","ordinal":159626,"en":"Was born to dark-hearted Zhakyp,"},{"id":"semetey-1-2013:p1094:b003:l002","ordinal":159627,"en":"A dark-piebald lion."},{"id":"semetey-1-2013:p1094:b003:l003","ordinal":159628,"en":"When he reached twelve,"},{"id":"semetey-1-2013:p1094:b003:l004","ordinal":159629,"en":"He broke citadels and took booty."},{"id":"semetey-1-2013:p1094:b003:l005","ordinal":159630,"en":"No mortal like him had ever been;"},{"id":"semetey-1-2013:p1094:b003:l006","ordinal":159631,"en":"The enemies he faced slunk away."},{"id":"semetey-1-2013:p1094:b003:l007","ordinal":159632,"en":"When enraged, he seized them,"},{"id":"semetey-1-2013:p1094:b003:l008","ordinal":159633,"en":"And chewed those he seized."},{"id":"semetey-1-2013:p1094:b003:l009","ordinal":159634,"en":"Among the black Chinese and Manchus,"},{"id":"semetey-1-2013:p1094:b003:l010","ordinal":159635,"en":"No enemy remained to fight him."},{"id":"semetey-1-2013:p1094:b003:l011","ordinal":159636,"en":"When they heard the force of his courage,"},{"id":"semetey-1-2013:p1094:b003:l012","ordinal":159637,"en":"Khan Esenkan wept."},{"id":"semetey-1-2013:p1094:b003:l013","ordinal":159638,"en":"If you hold a feast for Kökötöy,"},{"id":"semetey-1-2013:p1094:b003:l014","ordinal":159639,"en":"Send a scout to Talas;"},{"id":"semetey-1-2013:p1094:b003:l015","ordinal":159640,"en":"Send word, my colt,"},{"id":"semetey-1-2013:p1094:b003:l016","ordinal":159641,"en":"To black-maned Manas!"},{"id":"semetey-1-2013:p1094:b003:l017","ordinal":159642,"en":"Hey, Bokmurun, think carefully:"},{"id":"semetey-1-2013:p1094:b003:l018","ordinal":159643,"en":"He is the support on whom to rely."},{"id":"semetey-1-2013:p1094:b003:l019","ordinal":159644,"en":"If you hold a feast for Kökötöy,"},{"id":"semetey-1-2013:p1094:b003:l020","ordinal":159645,"en":"He is the hero who will be your aid"},{"id":"semetey-1-2013:p1094:b003:l021","ordinal":159646,"en":"And the girding at your waist."},{"id":"semetey-1-2013:p1094:b003:l022","ordinal":159647,"en":"If you do not send word to Manas,"},{"id":"semetey-1-2013:p1094:b003:l023","ordinal":159648,"en":"May he not dig a well in your place,"},{"id":"semetey-1-2013:p1094:b003:l024","ordinal":159649,"en":"May he not surely trample you underfoot,"},{"id":"semetey-1-2013:p1094:b003:l025","ordinal":159650,"en":"May he not scatter your four kinds of livestock;"},{"id":"semetey-1-2013:p1094:b003:l026","ordinal":159651,"en":"May the Chinese day not dawn"},{"id":"semetey-1-2013:p1094:b003:l027","ordinal":159652,"en":"And slaughter every last person"},{"id":"semetey-1-2013:p1094:b003:l028","ordinal":159653,"en":"Who went to the feast."},{"id":"semetey-1-2013:p1094:b003:l029","ordinal":159654,"en":"Hairy-soled Tükübay,"},{"id":"semetey-1-2013:p1094:b003:l030","ordinal":159655,"en":"The remnant champion of the Chinese,"},{"id":"semetey-1-2013:p1094:b003:l031","ordinal":159656,"en":"Yearns to finish off"},{"id":"semetey-1-2013:p1094:b003:l032","ordinal":159657,"en":"The dwindling Burut;"},{"id":"semetey-1-2013:p1094:b003:l033","ordinal":159658,"en":"Yes, Kongurbay and Tükübay"},{"id":"semetey-1-2013:p1094:b003:l034","ordinal":159659,"en":"Carry this longing within them."},{"id":"semetey-1-2013:p1094:b003:l035","ordinal":159660,"en":"At their flank is Börüköz,"},{"id":"semetey-1-2013:p1094:b003:l036","ordinal":159661,"en":"A great Chinese champion;"},{"id":"semetey-1-2013:p1094:b003:l037","ordinal":159662,"en":"The lean diviner Ezkara"},{"id":"semetey-1-2013:p1094:b003:l038","ordinal":159663,"en":"Keeps watching us,"},{"id":"semetey-1-2013:p1094:b003:l039","ordinal":159664,"en":"Seeking to unleash havoc."},{"id":"semetey-1-2013:p1094:b004:l001","ordinal":159665,"en":"\"Anger is the devil, reason a friend\"—"},{"id":"semetey-1-2013:p1094:b004:l002","ordinal":159666,"en":"Oh, my colt Bokmurun!"},{"id":"semetey-1-2013:p1094:b004:l003","ordinal":159667,"en":"Add wisdom to your thought."},{"id":"semetey-1-2013:p1094:b004:l004","ordinal":159668,"en":"Do not gather the handful of Kyrgyz"},{"id":"semetey-1-2013:p1094:b004:l005","ordinal":159669,"en":"By saying you will hold a feast;"},{"id":"semetey-1-2013:p1094:b004:l006","ordinal":159670,"en":"Without renowned Manas,"},{"id":"semetey-1-2013:p1094:b004:l007","ordinal":159671,"en":"Do not bring ruin upon other peoples."},{"id":"semetey-1-2013:p1094:b004:l008","ordinal":159672,"en":"Oh, my colt Bokmurun!"},{"id":"semetey-1-2013:p1094:b004:l009","ordinal":159673,"en":"Do not rely upon your wealth,"},{"id":"semetey-1-2013:p1094:b004:l010","ordinal":159674,"en":"And do not hand the handful of Muslims"},{"id":"semetey-1-2013:p1094:b004:l011","ordinal":159675,"en":"Over to the Chinese"},{"id":"semetey-1-2013:p1094:b004:l012","ordinal":159676,"en":"And fall into calamity."},{"id":"semetey-1-2013:p1094:b004:l013","ordinal":159677,"en":"You are a son intoxicated by livestock;"},{"id":"semetey-1-2013:p1094:b004:l014","ordinal":159678,"en":"If you do not heed these words of mine,"},{"id":"semetey-1-2013:p1094:b004:l015","ordinal":159679,"en":"By summoning all the peoples,"},{"id":"semetey-1-2013:p1094:b004:l016","ordinal":159680,"en":"You will bring them into calamity."},{"id":"semetey-1-2013:p1094:b004:l017","ordinal":159681,"en":"The black Chinese and many Manchus"},{"id":"semetey-1-2013:p1094:b004:l018","ordinal":159682,"en":"Are no people who understand a feast."},{"id":"semetey-1-2013:p1094:b004:l019","ordinal":159683,"en":"When he hears the news and gathers his host,"},{"id":"semetey-1-2013:p1094:b004:l020","ordinal":159684,"en":"Might Khan Kongurbay not arrive?"},{"id":"semetey-1-2013:p1094:b004:l021","ordinal":159685,"en":"Without the tiger Manas,"},{"id":"semetey-1-2013:p1094:b004:l022","ordinal":159686,"en":"Might he not utterly slaughter"},{"id":"semetey-1-2013:p1094:b004:l023","ordinal":159687,"en":"Your vast black people?\""},{"id":"semetey-1-2013:p1094:b004:l024","ordinal":159688,"en":"When Koshoy had spoken thus,"},{"id":"semetey-1-2013:p1094:b004:l025","ordinal":159689,"en":"Bokmurun shook with agitation"},{"id":"semetey-1-2013:p1094:b004:l026","ordinal":159690,"en":"And sprang up:"},{"id":"semetey-1-2013:p1094:b004:l027","ordinal":159691,"en":"\"Uncle Koshoy, hear my words."},{"id":"semetey-1-2013:p1094:b004:l028","ordinal":159692,"en":"It is known among the people"},{"id":"semetey-1-2013:p1094:b004:l029","ordinal":159693,"en":"That Khan Kökötöy lived,"},{"id":"semetey-1-2013:p1094:b004:l030","ordinal":159694,"en":"And that Kökötöy's vast riches"},{"id":"semetey-1-2013:p1094:b004:l031","ordinal":159695,"en":"Filled the face of the earth."},{"id":"semetey-1-2013:p1094:b004:l032","ordinal":159696,"en":"Now I shall open their lock"},{"id":"semetey-1-2013:p1094:b004:l033","ordinal":159697,"en":"And scatter them among all the people,"},{"id":"semetey-1-2013:p1094:b004:l034","ordinal":159698,"en":"Leaving none of them out."},{"id":"semetey-1-2013:p1094:b004:l035","ordinal":159699,"en":"To all the people,"},{"id":"semetey-1-2013:p1094:b004:l036","ordinal":159700,"en":"To carry word,"},{"id":"semetey-1-2013:p1094:b004:l037","ordinal":159701,"en":"There is the swift horse Maaniker;"},{"id":"semetey-1-2013:p1094:b004:l038","ordinal":159702,"en":"For infidel and Muslim alike,"},{"id":"semetey-1-2013:p1094:b004:l039","ordinal":159703,"en":"To feast all the people,"},{"id":"semetey-1-2013:p1095:b003:l001","ordinal":159704,"en":"There is wealth in abundance."},{"id":"semetey-1-2013:p1095:b003:l002","ordinal":159705,"en":"I will send word to the people;"},{"id":"semetey-1-2013:p1095:b003:l003","ordinal":159706,"en":"While my dear head is still alive,"},{"id":"semetey-1-2013:p1095:b003:l004","ordinal":159707,"en":"I will gather everything in full."},{"id":"semetey-1-2013:p1095:b003:l005","ordinal":159708,"en":"Today I offered many prizes;"},{"id":"semetey-1-2013:p1095:b003:l006","ordinal":159709,"en":"Tomorrow I will offer great prizes."},{"id":"semetey-1-2013:p1095:b003:l007","ordinal":159710,"en":"Uncle Koshoy, wise man,"},{"id":"semetey-1-2013:p1095:b003:l008","ordinal":159711,"en":"Wisdom comes from an elder,"},{"id":"semetey-1-2013:p1095:b003:l009","ordinal":159712,"en":"From a hero like you."},{"id":"semetey-1-2013:p1095:b003:l010","ordinal":159713,"en":"If I cannot hold my father's memorial feast,"},{"id":"semetey-1-2013:p1095:b003:l011","ordinal":159714,"en":"My dear khan and uncle,"},{"id":"semetey-1-2013:p1095:b003:l012","ordinal":159715,"en":"Where can I go and hide?"},{"id":"semetey-1-2013:p1095:b003:l013","ordinal":159716,"en":"Between the Manchu and the Kyrgyz,"},{"id":"semetey-1-2013:p1095:b003:l014","ordinal":159717,"en":"I will dig hearths into the ground."},{"id":"semetey-1-2013:p1095:b003:l015","ordinal":159718,"en":"Infidel and Muslim alike,"},{"id":"semetey-1-2013:p1095:b003:l016","ordinal":159719,"en":"Everyone who comes to the feast,"},{"id":"semetey-1-2013:p1095:b003:l017","ordinal":159720,"en":"I will fill with pure white fat."},{"id":"semetey-1-2013:p1095:b003:l018","ordinal":159721,"en":"For my dear father's memorial feast,"},{"id":"semetey-1-2013:p1095:b003:l019","ordinal":159722,"en":"I will have autumn rice planted."},{"id":"semetey-1-2013:p1095:b003:l020","ordinal":159723,"en":"Great wealth and countless livestock,"},{"id":"semetey-1-2013:p1095:b003:l021","ordinal":159724,"en":"For my dear father's feast,"},{"id":"semetey-1-2013:p1095:b003:l022","ordinal":159725,"en":"I will scatter and display it all."},{"id":"semetey-1-2013:p1095:b003:l023","ordinal":159726,"en":"If I do not gather the four corners"},{"id":"semetey-1-2013:p1095:b003:l024","ordinal":159727,"en":"Of the whole world four times over,"},{"id":"semetey-1-2013:p1095:b003:l025","ordinal":159728,"en":"If I do not make such merriment"},{"id":"semetey-1-2013:p1095:b003:l026","ordinal":159729,"en":"At my princely father's memorial feast,"},{"id":"semetey-1-2013:p1095:b003:l027","ordinal":159730,"en":"May I die before I become Bokmurun."},{"id":"semetey-1-2013:p1095:b003:l028","ordinal":159731,"en":"Rather than walk about alive,"},{"id":"semetey-1-2013:p1095:b003:l029","ordinal":159732,"en":"May I sink away as though never born!"},{"id":"semetey-1-2013:p1095:b003:l030","ordinal":159733,"en":"Whoever crosses my stubborn will,"},{"id":"semetey-1-2013:p1095:b003:l031","ordinal":159734,"en":"I will strike down and kill."},{"id":"semetey-1-2013:p1095:b003:l032","ordinal":159735,"en":"For my dear father's memorial feast,"},{"id":"semetey-1-2013:p1095:b003:l033","ordinal":159736,"en":"I will make meat as high as Ala-Too,"},{"id":"semetey-1-2013:p1095:b003:l034","ordinal":159737,"en":"And broth as vast as Ala-Köl."},{"id":"semetey-1-2013:p1095:b003:l035","ordinal":159738,"en":"I will slaughter livestock beyond counting"},{"id":"semetey-1-2013:p1095:b003:l036","ordinal":159739,"en":"And feed everyone gathered around."},{"id":"semetey-1-2013:p1095:b003:l037","ordinal":159740,"en":"I will display my riches;"},{"id":"semetey-1-2013:p1095:b003:l038","ordinal":159741,"en":"I will distribute gold like stones."},{"id":"semetey-1-2013:p1095:b003:l039","ordinal":159742,"en":"I will cover the face of the earth in dust;"},{"id":"semetey-1-2013:p1095:b004:l001","ordinal":159743,"en":"Calling it “Khan Kökötöy's memorial feast,”"},{"id":"semetey-1-2013:p1095:b004:l002","ordinal":159744,"en":"I will make it renowned among the people."}]
