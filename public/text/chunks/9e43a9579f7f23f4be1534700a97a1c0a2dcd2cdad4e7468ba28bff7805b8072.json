[{"id":"semetey-1-2013:p1165:b004:l020","ordinal":165121,"en":"Infidels and Muslims"},{"id":"semetey-1-2013:p1165:b004:l021","ordinal":165122,"en":"Said wrestling would be held for sport,"},{"id":"semetey-1-2013:p1165:b004:l022","ordinal":165123,"en":"That whoever threw his opponent would win the prize,"},{"id":"semetey-1-2013:p1165:b004:l023","ordinal":165124,"en":"And whoever fell would be left with nothing."},{"id":"semetey-1-2013:p1165:b004:l024","ordinal":165125,"en":"The prize for all the wrestlers"},{"id":"semetey-1-2013:p1165:b004:l025","ordinal":165126,"en":"Was a thousand black Bactrian camels"},{"id":"semetey-1-2013:p1165:b004:l026","ordinal":165127,"en":"And a thousand black, blaze-faced mares."},{"id":"semetey-1-2013:p1165:b004:l027","ordinal":165128,"en":"Bringing them to war and having them guarded,"},{"id":"semetey-1-2013:p1165:b004:l028","ordinal":165129,"en":"Having anyone who came near them beaten,"},{"id":"semetey-1-2013:p1165:b004:l029","ordinal":165130,"en":"Among infidels and Muslims,"},{"id":"semetey-1-2013:p1165:b004:l030","ordinal":165131,"en":"Hero Manas had set them aside."},{"id":"semetey-1-2013:p1165:b004:l031","ordinal":165132,"en":"When Manas unleashed his wrath,"},{"id":"semetey-1-2013:p1165:b004:l032","ordinal":165133,"en":"The people gathered in a throng."},{"id":"semetey-1-2013:p1165:b004:l033","ordinal":165134,"en":"“The plundering Chinese and Manchus"},{"id":"semetey-1-2013:p1165:b004:l034","ordinal":165135,"en":"Lined up as though they had drunk poison."},{"id":"semetey-1-2013:p1165:b004:l035","ordinal":165136,"en":"The peoples chose not to flee;"},{"id":"semetey-1-2013:p1165:b004:l036","ordinal":165137,"en":"They stayed to watch the spectacle."},{"id":"semetey-1-2013:p1165:b004:l037","ordinal":165138,"en":"When Koshoi advanced, ready,"},{"id":"semetey-1-2013:p1165:b004:l038","ordinal":165139,"en":"Let us leave this matter here"},{"id":"semetey-1-2013:p1165:b004:l039","ordinal":165140,"en":"With the wrestler of the Kalmyks."},{"id":"semetey-1-2013:p1166:b003:l001","ordinal":165141,"en":"Let us begin the tale of Joloy."},{"id":"semetey-1-2013:p1166:b003:l002","ordinal":165142,"en":"For six years he traveled on foot,"},{"id":"semetey-1-2013:p1166:b003:l003","ordinal":165143,"en":"Greasing his great spear,"},{"id":"semetey-1-2013:p1166:b003:l004","ordinal":165144,"en":"Laying low those who fought him—"},{"id":"semetey-1-2013:p1166:b003:l005","ordinal":165145,"en":"Hero Joloy, reeking of blood."},{"id":"semetey-1-2013:p1166:b003:l006","ordinal":165146,"en":"For seven years he traveled on foot,"},{"id":"semetey-1-2013:p1166:b003:l007","ordinal":165147,"en":"Greasing his well-made spear,"},{"id":"semetey-1-2013:p1166:b003:l008","ordinal":165148,"en":"Laying low all he reached—"},{"id":"semetey-1-2013:p1166:b003:l009","ordinal":165149,"en":"Hero Joloy, reeking of demons."},{"id":"semetey-1-2013:p1166:b003:l010","ordinal":165150,"en":"Fuming and roaring in anger,"},{"id":"semetey-1-2013:p1166:b003:l011","ordinal":165151,"en":"Dear Joloy came thundering:"},{"id":"semetey-1-2013:p1166:b003:l012","ordinal":165152,"en":"“I will tear off the head"},{"id":"semetey-1-2013:p1166:b003:l013","ordinal":165153,"en":"Of the Burut who has come to wrestle."},{"id":"semetey-1-2013:p1166:b003:l014","ordinal":165154,"en":"Upon this palm-sized Burut"},{"id":"semetey-1-2013:p1166:b003:l015","ordinal":165155,"en":"I will heap suffering all at once,” he said."},{"id":"semetey-1-2013:p1166:b003:l016","ordinal":165156,"en":"Your infidel Joloy roared."},{"id":"semetey-1-2013:p1166:b003:l017","ordinal":165157,"en":"“I will take"},{"id":"semetey-1-2013:p1166:b003:l018","ordinal":165158,"en":"This fucking Burut's prize."},{"id":"semetey-1-2013:p1166:b003:l019","ordinal":165159,"en":"I will take his prize and bind him,” he said."},{"id":"semetey-1-2013:p1166:b003:l020","ordinal":165160,"en":"“This Burut who calls himself a hero,"},{"id":"semetey-1-2013:p1166:b003:l021","ordinal":165161,"en":"I will chase as far as Mecca,” he said."},{"id":"semetey-1-2013:p1166:b003:l022","ordinal":165162,"en":"From among the infidel people,"},{"id":"semetey-1-2013:p1166:b003:l023","ordinal":165163,"en":"To wrestle on foot,"},{"id":"semetey-1-2013:p1166:b003:l024","ordinal":165164,"en":"Joloy came out alone."},{"id":"semetey-1-2013:p1166:b003:l025","ordinal":165165,"en":"Joloy's form"},{"id":"semetey-1-2013:p1166:b003:l026","ordinal":165166,"en":"Looked as large as a yurt."},{"id":"semetey-1-2013:p1166:b003:l027","ordinal":165167,"en":"Joloy of the Kalmyks"},{"id":"semetey-1-2013:p1166:b003:l028","ordinal":165168,"en":"Was like a hungry lion or tiger;"},{"id":"semetey-1-2013:p1166:b003:l029","ordinal":165169,"en":"No one who wrestled him survived."},{"id":"semetey-1-2013:p1166:b003:l030","ordinal":165170,"en":"On the field where they would wrestle,"},{"id":"semetey-1-2013:p1166:b003:l031","ordinal":165171,"en":"At the high center"},{"id":"semetey-1-2013:p1166:b003:l032","ordinal":165172,"en":"Of the gleaming plain,"},{"id":"semetey-1-2013:p1166:b003:l033","ordinal":165173,"en":"Ancient Koshoi stood."},{"id":"semetey-1-2013:p1166:b003:l034","ordinal":165174,"en":"Saying, “I will seize and throw the old man,”"},{"id":"semetey-1-2013:p1166:b003:l035","ordinal":165175,"en":"God had struck Joloy."},{"id":"semetey-1-2013:p1166:b003:l036","ordinal":165176,"en":"Do not ask what Joloy was like:"},{"id":"semetey-1-2013:p1166:b003:l037","ordinal":165177,"en":"He was drunk on liquor;"},{"id":"semetey-1-2013:p1166:b003:l038","ordinal":165178,"en":"This infidel was"},{"id":"semetey-1-2013:p1166:b003:l039","ordinal":165179,"en":"Far younger than your elder."},{"id":"semetey-1-2013:p1166:b004:l001","ordinal":165180,"en":"It was the time when he settled"},{"id":"semetey-1-2013:p1166:b004:l002","ordinal":165181,"en":"The Black Kalmyks' disputes."},{"id":"semetey-1-2013:p1166:b004:l003","ordinal":165182,"en":"It was the time when that infidel,"},{"id":"semetey-1-2013:p1166:b004:l004","ordinal":165183,"en":"Steeled with courage, was in full force."},{"id":"semetey-1-2013:p1166:b004:l005","ordinal":165184,"en":"It was the time when Joloy"},{"id":"semetey-1-2013:p1166:b004:l006","ordinal":165185,"en":"Was mounting in strength like a stallion."},{"id":"semetey-1-2013:p1166:b004:l007","ordinal":165186,"en":"The Kalmyks' küpsör garment"},{"id":"semetey-1-2013:p1166:b004:l008","ordinal":165187,"en":"He wrapped puffed around his waist."},{"id":"semetey-1-2013:p1166:b004:l009","ordinal":165188,"en":"Sixty billy-goat hides"},{"id":"semetey-1-2013:p1166:b004:l010","ordinal":165189,"en":"He had sewn together as its outer layer"},{"id":"semetey-1-2013:p1166:b004:l011","ordinal":165190,"en":"And made into trousers."},{"id":"semetey-1-2013:p1166:b004:l012","ordinal":165191,"en":"Bareheaded, his head huge as a cauldron,"},{"id":"semetey-1-2013:p1166:b004:l013","ordinal":165192,"en":"Down the back of that damned infidel"},{"id":"semetey-1-2013:p1166:b004:l014","ordinal":165193,"en":"Hung braided"},{"id":"semetey-1-2013:p1166:b004:l015","ordinal":165194,"en":"Black hair thick as a club."},{"id":"semetey-1-2013:p1166:b004:l016","ordinal":165195,"en":"Koshoi went striding forward;"},{"id":"semetey-1-2013:p1166:b004:l017","ordinal":165196,"en":"Hero Joloy, a mighty man,"},{"id":"semetey-1-2013:p1166:b004:l018","ordinal":165197,"en":"Came out before him."},{"id":"semetey-1-2013:p1166:b004:l019","ordinal":165198,"en":"Joloy spoke to Koshoi:"},{"id":"semetey-1-2013:p1166:b004:l020","ordinal":165199,"en":"“You are dead, Burut,” he said."},{"id":"semetey-1-2013:p1166:b004:l021","ordinal":165200,"en":"“Fortunate Manas's blessed one,"},{"id":"semetey-1-2013:p1166:b004:l022","ordinal":165201,"en":"My fucking Burut,"},{"id":"semetey-1-2013:p1166:b004:l023","ordinal":165202,"en":"I will break your leg.”"},{"id":"semetey-1-2013:p1166:b004:l024","ordinal":165203,"en":"Roaring in fury,"},{"id":"semetey-1-2013:p1166:b004:l025","ordinal":165204,"en":"Joloy came upon him."},{"id":"semetey-1-2013:p1166:b004:l026","ordinal":165205,"en":"Your dear elder Koshoi said,"},{"id":"semetey-1-2013:p1166:b004:l027","ordinal":165206,"en":"“Kalmyk, take your turn,”"},{"id":"semetey-1-2013:p1166:b004:l028","ordinal":165207,"en":"And held out his forearm."},{"id":"semetey-1-2013:p1166:b004:l029","ordinal":165208,"en":"Joloy, huge as Opol-Too,"},{"id":"semetey-1-2013:p1166:b004:l030","ordinal":165209,"en":"Seized him by the forearm."},{"id":"semetey-1-2013:p1166:b004:l031","ordinal":165210,"en":"Was it not Koshoi who divided"},{"id":"semetey-1-2013:p1166:b004:l032","ordinal":165211,"en":"The frontier of Esenkan?"},{"id":"semetey-1-2013:p1166:b004:l033","ordinal":165212,"en":"Was it not Koshoi who had grown accustomed"},{"id":"semetey-1-2013:p1166:b004:l034","ordinal":165213,"en":"To grappling with many men?"},{"id":"semetey-1-2013:p1166:b004:l035","ordinal":165214,"en":"Was it not capable Koshoi,"},{"id":"semetey-1-2013:p1166:b004:l036","ordinal":165215,"en":"Born to be a wrestler on foot?"},{"id":"semetey-1-2013:p1166:b004:l037","ordinal":165216,"en":"Was it not renowned Koshoi,"},{"id":"semetey-1-2013:p1166:b004:l038","ordinal":165217,"en":"Who had grappled with so many giants?"},{"id":"semetey-1-2013:p1166:b004:l039","ordinal":165218,"en":"The day passed as they wrestled,"},{"id":"semetey-1-2013:p1167:b003:l001","ordinal":165219,"en":"Was it not Koshoy who came?"},{"id":"semetey-1-2013:p1167:b003:l002","ordinal":165220,"en":"Was it not Koshoy who laid out"},{"id":"semetey-1-2013:p1167:b003:l003","ordinal":165221,"en":"All the boastful Chinese"},{"id":"semetey-1-2013:p1167:b003:l004","ordinal":165222,"en":"At full length?"},{"id":"semetey-1-2013:p1167:b003:l005","ordinal":165223,"en":"Was it not Koshoy who won"},{"id":"semetey-1-2013:p1167:b003:l006","ordinal":165224,"en":"Victory in many places?"},{"id":"semetey-1-2013:p1167:b003:l007","ordinal":165225,"en":"Was it not Koshoy who fought many men"},{"id":"semetey-1-2013:p1167:b003:l008","ordinal":165226,"en":"Until he had his fill?"},{"id":"semetey-1-2013:p1167:b003:l009","ordinal":165227,"en":"Before the Kalmyk could say, \"Strike,\""},{"id":"semetey-1-2013:p1167:b003:l010","ordinal":165228,"en":"He tore the flesh from his arm."},{"id":"semetey-1-2013:p1167:b003:l011","ordinal":165229,"en":"Accursed old age!"},{"id":"semetey-1-2013:p1167:b003:l012","ordinal":165230,"en":"The skin of his arm"},{"id":"semetey-1-2013:p1167:b003:l013","ordinal":165231,"en":"Went into the hand"},{"id":"semetey-1-2013:p1167:b003:l014","ordinal":165232,"en":"Of Kalmyk champion Joloy."},{"id":"semetey-1-2013:p1167:b003:l015","ordinal":165233,"en":"\"I have lived to see old age,"},{"id":"semetey-1-2013:p1167:b003:l016","ordinal":165234,"en":"The mark of my decline;"},{"id":"semetey-1-2013:p1167:b003:l017","ordinal":165235,"en":"I have suffered shame from an infidel,\" he said."},{"id":"semetey-1-2013:p1167:b003:l018","ordinal":165236,"en":"Taking courage, Khan Koshoy,"},{"id":"semetey-1-2013:p1167:b003:l019","ordinal":165237,"en":"Old tiger Khan Koshoy,"},{"id":"semetey-1-2013:p1167:b003:l020","ordinal":165238,"en":"Seized millstone-sized Joloy"},{"id":"semetey-1-2013:p1167:b003:l021","ordinal":165239,"en":"By the quivering ribs."},{"id":"semetey-1-2013:p1167:b003:l022","ordinal":165240,"en":"From his side he tore"},{"id":"semetey-1-2013:p1167:b003:l023","ordinal":165241,"en":"A bowl-sized piece of blue flesh,"},{"id":"semetey-1-2013:p1167:b003:l024","ordinal":165242,"en":"And ripped it free."},{"id":"semetey-1-2013:p1167:b003:l025","ordinal":165243,"en":"Your old uncle Koshoy's"},{"id":"semetey-1-2013:p1167:b003:l026","ordinal":165244,"en":"Arm ran with blood;"},{"id":"semetey-1-2013:p1167:b003:l027","ordinal":165245,"en":"Kalmyk Khan Joloy's"},{"id":"semetey-1-2013:p1167:b003:l028","ordinal":165246,"en":"Side became like bread dough."},{"id":"semetey-1-2013:p1167:b003:l029","ordinal":165247,"en":"God spare us such a sight!"},{"id":"semetey-1-2013:p1167:b003:l030","ordinal":165248,"en":"They butted like blue rams,"},{"id":"semetey-1-2013:p1167:b003:l031","ordinal":165249,"en":"Tearing whatever they reached,"},{"id":"semetey-1-2013:p1167:b003:l032","ordinal":165250,"en":"Jerking like hungry stallions."},{"id":"semetey-1-2013:p1167:b003:l033","ordinal":165251,"en":"God spare us such a sight!"},{"id":"semetey-1-2013:p1167:b003:l034","ordinal":165252,"en":"They butted like blue bulls,"},{"id":"semetey-1-2013:p1167:b003:l035","ordinal":165253,"en":"Tearing whatever they saw."},{"id":"semetey-1-2013:p1167:b003:l036","ordinal":165254,"en":"Dust swirled in confusion;"},{"id":"semetey-1-2013:p1167:b003:l037","ordinal":165255,"en":"Whatever they gripped became pulp,"},{"id":"semetey-1-2013:p1167:b003:l038","ordinal":165256,"en":"And both were covered in red blood."},{"id":"semetey-1-2013:p1167:b003:l039","ordinal":165257,"en":"They tugged at their trouser cuffs."},{"id":"semetey-1-2013:p1167:b004:l001","ordinal":165258,"en":"If you are a champion, be like this:"},{"id":"semetey-1-2013:p1167:b004:l002","ordinal":165259,"en":"They crashed chest against chest,"},{"id":"semetey-1-2013:p1167:b004:l003","ordinal":165260,"en":"Tore the clothes they grasped,"},{"id":"semetey-1-2013:p1167:b004:l004","ordinal":165261,"en":"And butted harder than wild rams."},{"id":"semetey-1-2013:p1167:b004:l005","ordinal":165262,"en":"They grappled by the trouser cuffs,"},{"id":"semetey-1-2013:p1167:b004:l006","ordinal":165263,"en":"Testing the manner of their strength."},{"id":"semetey-1-2013:p1167:b004:l007","ordinal":165264,"en":"Joloy went about grieving:"},{"id":"semetey-1-2013:p1167:b004:l008","ordinal":165265,"en":"The great trousers on his legs,"},{"id":"semetey-1-2013:p1167:b004:l009","ordinal":165266,"en":"Made from sixty goatskins,"},{"id":"semetey-1-2013:p1167:b004:l010","ordinal":165267,"en":"Were ripped into shreds."},{"id":"semetey-1-2013:p1167:b004:l011","ordinal":165268,"en":"\"Those were sturdy trousers,\" he said,"},{"id":"semetey-1-2013:p1167:b004:l012","ordinal":165269,"en":"And Joloy went about grieving."},{"id":"semetey-1-2013:p1167:b004:l013","ordinal":165270,"en":"When they pulled the kangdagay trousers,"},{"id":"semetey-1-2013:p1167:b004:l014","ordinal":165271,"en":"They stretched out like a spring;"},{"id":"semetey-1-2013:p1167:b004:l015","ordinal":165272,"en":"When they let the kangdagay go,"},{"id":"semetey-1-2013:p1167:b004:l016","ordinal":165273,"en":"They gathered like a fold."},{"id":"semetey-1-2013:p1167:b004:l017","ordinal":165274,"en":"When he grasped them in fury,"},{"id":"semetey-1-2013:p1167:b004:l018","ordinal":165275,"en":"Joloy's hands were cut."},{"id":"semetey-1-2013:p1167:b004:l019","ordinal":165276,"en":"The fainthearted fled and scattered;"},{"id":"semetey-1-2013:p1167:b004:l020","ordinal":165277,"en":"Among infidel and Muslim,"},{"id":"semetey-1-2013:p1167:b004:l021","ordinal":165278,"en":"All those with courage"},{"id":"semetey-1-2013:p1167:b004:l022","ordinal":165279,"en":"Watched as entertainment."},{"id":"semetey-1-2013:p1167:b004:l023","ordinal":165280,"en":"The two champions met,"},{"id":"semetey-1-2013:p1167:b004:l024","ordinal":165281,"en":"And those who watched ached inside."},{"id":"semetey-1-2013:p1167:b004:l025","ordinal":165282,"en":"Kokotoy's abundant wealth"},{"id":"semetey-1-2013:p1167:b004:l026","ordinal":165283,"en":"Was then lavishly scattered"},{"id":"semetey-1-2013:p1167:b004:l027","ordinal":165284,"en":"For the spectacle."},{"id":"semetey-1-2013:p1167:b004:l028","ordinal":165285,"en":"The Karkyra plain,"},{"id":"semetey-1-2013:p1167:b004:l029","ordinal":165286,"en":"Where the champions' feet landed,"},{"id":"semetey-1-2013:p1167:b004:l030","ordinal":165287,"en":"Was gouged out like a trench."},{"id":"semetey-1-2013:p1167:b004:l031","ordinal":165288,"en":"All the sorrow of those watching"},{"id":"semetey-1-2013:p1167:b004:l032","ordinal":165289,"en":"Was relieved."},{"id":"semetey-1-2013:p1167:b004:l033","ordinal":165290,"en":"They wrestled for six days,"},{"id":"semetey-1-2013:p1167:b004:l034","ordinal":165291,"en":"Neither able to defeat the other."},{"id":"semetey-1-2013:p1167:b004:l035","ordinal":165292,"en":"When their wrestling"},{"id":"semetey-1-2013:p1167:b004:l036","ordinal":165293,"en":"Had lasted six full days,"},{"id":"semetey-1-2013:p1167:b004:l037","ordinal":165294,"en":"He was a man grown old—"},{"id":"semetey-1-2013:p1167:b004:l038","ordinal":165295,"en":"Your uncle, giant Koshoy,"},{"id":"semetey-1-2013:p1167:b004:l039","ordinal":165296,"en":"Of the Kalmyks' Joloy,"},{"id":"semetey-1-2013:p1168:b003:l001","ordinal":165297,"en":"Did not emerge from beneath his arm."},{"id":"semetey-1-2013:p1168:b003:l002","ordinal":165298,"en":"Accursed old age!"},{"id":"semetey-1-2013:p1168:b003:l003","ordinal":165299,"en":"Your uncle closed his eyes"},{"id":"semetey-1-2013:p1168:b003:l004","ordinal":165300,"en":"And now fell into deep sleep."},{"id":"semetey-1-2013:p1168:b003:l005","ordinal":165301,"en":"When your uncle fell asleep,"},{"id":"semetey-1-2013:p1168:b003:l006","ordinal":165302,"en":"Joloy lifted him with a grunt."},{"id":"semetey-1-2013:p1168:b003:l007","ordinal":165303,"en":"Boasting so greatly,"},{"id":"semetey-1-2013:p1168:b003:l008","ordinal":165304,"en":"He headed toward the strongest"},{"id":"semetey-1-2013:p1168:b003:l009","ordinal":165305,"en":"Of the jacket-clad Chinese:"},{"id":"semetey-1-2013:p1168:b003:l010","ordinal":165306,"en":"\"Now the Burut is dead;"},{"id":"semetey-1-2013:p1168:b003:l011","ordinal":165307,"en":"He has seen the face of Judgment Day."},{"id":"semetey-1-2013:p1168:b003:l012","ordinal":165308,"en":"Such a Burut cannot survive;"},{"id":"semetey-1-2013:p1168:b003:l013","ordinal":165309,"en":"He has seen what none have seen."},{"id":"semetey-1-2013:p1168:b003:l014","ordinal":165310,"en":"Even if he had eighty lives,"},{"id":"semetey-1-2013:p1168:b003:l015","ordinal":165311,"en":"The accursed Burut is dead."},{"id":"semetey-1-2013:p1168:b003:l016","ordinal":165312,"en":"Now I will throw the Burut down"},{"id":"semetey-1-2013:p1168:b003:l017","ordinal":165313,"en":"And drive his head into the ground,\" he said."},{"id":"semetey-1-2013:p1168:b003:l018","ordinal":165314,"en":"Poor Joloy swaggered,"},{"id":"semetey-1-2013:p1168:b003:l019","ordinal":165315,"en":"Boasting and striding proudly."},{"id":"semetey-1-2013:p1168:b003:l020","ordinal":165316,"en":"This boastful infidel"},{"id":"semetey-1-2013:p1168:b003:l021","ordinal":165317,"en":"Coughed with heavy grunts,"},{"id":"semetey-1-2013:p1168:b003:l022","ordinal":165318,"en":"Hoisted Koshoy of Katagan,"},{"id":"semetey-1-2013:p1168:b003:l023","ordinal":165319,"en":"And carried him"},{"id":"semetey-1-2013:p1168:b003:l024","ordinal":165320,"en":"To the village of Ay Jang-jung;"},{"id":"semetey-1-2013:p1168:b003:l025","ordinal":165321,"en":"He carried him again"},{"id":"semetey-1-2013:p1168:b003:l026","ordinal":165322,"en":"To the village of Kun Jang-jung."},{"id":"semetey-1-2013:p1168:b003:l027","ordinal":165323,"en":"He carried him onward again."},{"id":"semetey-1-2013:p1168:b003:l028","ordinal":165324,"en":"Ezkara, khan of the Manchus—"},{"id":"semetey-1-2013:p1168:b003:l029","ordinal":165325,"en":"Before Ezkara"},{"id":"semetey-1-2013:p1168:b003:l030","ordinal":165326,"en":"He now carried him once."},{"id":"semetey-1-2013:p1168:b003:l031","ordinal":165327,"en":"Then he rushed onward,"},{"id":"semetey-1-2013:p1168:b003:l032","ordinal":165328,"en":"And as he passed farther on,"},{"id":"semetey-1-2013:p1168:b003:l033","ordinal":165329,"en":"He was about to carry and fling him"},{"id":"semetey-1-2013:p1168:b003:l034","ordinal":165330,"en":"Before Kongurbay."},{"id":"semetey-1-2013:p1168:b003:l035","ordinal":165331,"en":"The Muslim people"},{"id":"semetey-1-2013:p1168:b003:l036","ordinal":165332,"en":"Lamented as though their backs had broken:"},{"id":"semetey-1-2013:p1168:b003:l037","ordinal":165333,"en":"\"Old Koshoy is dead,\" they cried,"},{"id":"semetey-1-2013:p1168:b003:l038","ordinal":165334,"en":"Wailing for their honor."},{"id":"semetey-1-2013:p1168:b004:l001","ordinal":165335,"en":"Joloy carried Koshoy"},{"id":"semetey-1-2013:p1168:b004:l002","ordinal":165336,"en":"And ran toward the finest"},{"id":"semetey-1-2013:p1168:b004:l003","ordinal":165337,"en":"Of the stone-bedecked Chinese."},{"id":"semetey-1-2013:p1168:b004:l004","ordinal":165338,"en":"Leopard Manas then"},{"id":"semetey-1-2013:p1168:b004:l005","ordinal":165339,"en":"Stood watching Koshoy"},{"id":"semetey-1-2013:p1168:b004:l006","ordinal":165340,"en":"And grieved in anguish:"},{"id":"semetey-1-2013:p1168:b004:l007","ordinal":165341,"en":"\"Accursed old age!"},{"id":"semetey-1-2013:p1168:b004:l008","ordinal":165342,"en":"You have experienced"},{"id":"semetey-1-2013:p1168:b004:l009","ordinal":165343,"en":"The torment of Judgment Day;"},{"id":"semetey-1-2013:p1168:b004:l010","ordinal":165344,"en":"Your strength has gone, poor man,"},{"id":"semetey-1-2013:p1168:b004:l011","ordinal":165345,"en":"And you have died.\""},{"id":"semetey-1-2013:p1168:b004:l012","ordinal":165346,"en":"He seized the black-jawed rawhide whip"},{"id":"semetey-1-2013:p1168:b004:l013","ordinal":165347,"en":"Whose strike deafened the ears,"},{"id":"semetey-1-2013:p1168:b004:l014","ordinal":165348,"en":"Swung it around,"},{"id":"semetey-1-2013:p1168:b004:l015","ordinal":165349,"en":"And charged toward Koshoy."},{"id":"semetey-1-2013:p1168:b004:l016","ordinal":165350,"en":"Your gray-maned hero Manas"},{"id":"semetey-1-2013:p1168:b004:l017","ordinal":165351,"en":"Struck the fatty flesh"},{"id":"semetey-1-2013:p1168:b004:l018","ordinal":165352,"en":"Of the fat tail."},{"id":"semetey-1-2013:p1168:b004:l019","ordinal":165353,"en":"Blood sprayed from the tail"},{"id":"semetey-1-2013:p1168:b004:l020","ordinal":165354,"en":"Of your sleeping uncle,"},{"id":"semetey-1-2013:p1168:b004:l021","ordinal":165355,"en":"And his eyes opened wide as grain mash."},{"id":"semetey-1-2013:p1168:b004:l022","ordinal":165356,"en":"He seized the tail,"},{"id":"semetey-1-2013:p1168:b004:l023","ordinal":165357,"en":"And from Khan Joloy's hands"},{"id":"semetey-1-2013:p1168:b004:l024","ordinal":165358,"en":"Made a camel-like bound."},{"id":"semetey-1-2013:p1168:b004:l025","ordinal":165359,"en":"Your uncle, hero Koshoy,"},{"id":"semetey-1-2013:p1168:b004:l026","ordinal":165360,"en":"Fell down from the back"},{"id":"semetey-1-2013:p1168:b004:l027","ordinal":165361,"en":"Of lordly Joloy."},{"id":"semetey-1-2013:p1168:b004:l028","ordinal":165362,"en":"Your practiced uncle, giant Koshoy,"},{"id":"semetey-1-2013:p1168:b004:l029","ordinal":165363,"en":"Performed the degey throw;"},{"id":"semetey-1-2013:p1168:b004:l030","ordinal":165364,"en":"Turning Joloy around,"},{"id":"semetey-1-2013:p1168:b004:l031","ordinal":165365,"en":"He slipped inside his stance."},{"id":"semetey-1-2013:p1168:b004:l032","ordinal":165366,"en":"Koshoy tripped Joloy."},{"id":"semetey-1-2013:p1168:b004:l033","ordinal":165367,"en":"\"Our Joloy will throw him,\" they said;"},{"id":"semetey-1-2013:p1168:b004:l034","ordinal":165368,"en":"The Black Kalmyks lamented,"},{"id":"semetey-1-2013:p1168:b004:l035","ordinal":165369,"en":"Shouting in separate groups,"},{"id":"semetey-1-2013:p1168:b004:l036","ordinal":165370,"en":"Calling their battle cry in waves:"},{"id":"semetey-1-2013:p1168:b004:l037","ordinal":165371,"en":"\"Burku-burku-burku!\""},{"id":"semetey-1-2013:p1168:b004:l038","ordinal":165372,"en":"\"Burku!\" cried the Black Kalmyks,"},{"id":"semetey-1-2013:p1169:b003:l001","ordinal":165373,"en":"\"Take the Burut by the legs;"},{"id":"semetey-1-2013:p1169:b003:l002","ordinal":165374,"en":"Lay him out full length,\" they said."},{"id":"semetey-1-2013:p1169:b003:l003","ordinal":165375,"en":"The Black Kalmyks said this,"},{"id":"semetey-1-2013:p1169:b003:l004","ordinal":165376,"en":"While the Muslim faithful cried:"}]
