{"id": "sayakbay-ms-current142:pdf028:l031", "source_id": "sayakbay-ms-current142", "pdf_sha256": "2b1fd33d35b9fec662724180743e44a26bc44d8b347d5f99c373acf98cb6c73f", "page": 28, "folio": 2345, "line_in_page": 31, "raw": "Мүйүшүн таянып толгонду,", "text": "Мүйүшүн таянып толгонду,", "en": "He leaned upon the corner, burdened,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "First and last words are difficult.", "bbox": null}
{"id": "sayakbay-ms-current142:pdf028:l032", "source_id": "sayakbay-ms-current142", "pdf_sha256": "2b1fd33d35b9fec662724180743e44a26bc44d8b347d5f99c373acf98cb6c73f", "page": 28, "folio": 2345, "line_in_page": 32, "raw": "Элиңден таштап кор кылдың,", "text": "Элиңден таштап кор кылдың,", "en": "You abandoned him among your people and disgraced him,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Pronoun and verbal phrase are uncertain.", "bbox": null}
{"id": "sayakbay-ms-current142:pdf028:l033", "source_id": "sayakbay-ms-current142", "pdf_sha256": "2b1fd33d35b9fec662724180743e44a26bc44d8b347d5f99c373acf98cb6c73f", "page": 28, "folio": 2345, "line_in_page": 33, "raw": "Көзүңө эмне балээң,", "text": "Көзүңө эмне балээң,", "en": "What calamity has come before your eyes?", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Final possessive form is unclear.", "bbox": null}
{"id": "sayakbay-ms-current142:pdf028:l034", "source_id": "sayakbay-ms-current142", "pdf_sha256": "2b1fd33d35b9fec662724180743e44a26bc44d8b347d5f99c373acf98cb6c73f", "page": 28, "folio": 2345, "line_in_page": 34, "raw": "Жети оозуңдан бузуп,", "text": "Жети оозуңдан бузуп,", "en": "Corrupting the words from your mouth,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Numeral and noun could be read differently.", "bbox": null}
{"id": "sayakbay-ms-current142:pdf028:l035", "source_id": "sayakbay-ms-current142", "pdf_sha256": "2b1fd33d35b9fec662724180743e44a26bc44d8b347d5f99c373acf98cb6c73f", "page": 28, "folio": 2345, "line_in_page": 35, "raw": "Не дейм ишиң кээрсиз,", "text": "Не дейм ишиң кээрсиз,", "en": "What can I say—your deed is merciless,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Last word is very faint.", "bbox": null}
{"id": "sayakbay-ms-current142:pdf028:l036", "source_id": "sayakbay-ms-current142", "pdf_sha256": "2b1fd33d35b9fec662724180743e44a26bc44d8b347d5f99c373acf98cb6c73f", "page": 28, "folio": 2345, "line_in_page": 36, "raw": "Жалгыз кыйынга малдандың,", "text": "Жалгыз кыйынга малдандың,", "en": "You relied upon a lone champion,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The middle phrase is difficult.", "bbox": null}
{"id": "sayakbay-ms-current142:pdf028:l037", "source_id": "sayakbay-ms-current142", "pdf_sha256": "2b1fd33d35b9fec662724180743e44a26bc44d8b347d5f99c373acf98cb6c73f", "page": 28, "folio": 2345, "line_in_page": 37, "raw": "Ар качандан бир каласың,", "text": "Ар качандан бир каласың,", "en": "At some point you will be left alone,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "First phrase and person ending are uncertain.", "bbox": null}
{"id": "sayakbay-ms-current142:pdf028:l038", "source_id": "sayakbay-ms-current142", "pdf_sha256": "2b1fd33d35b9fec662724180743e44a26bc44d8b347d5f99c373acf98cb6c73f", "page": 28, "folio": 2345, "line_in_page": 38, "raw": "Бузулганыңды койбодуң,", "text": "Бузулганыңды койбодуң,", "en": "You would not cease your wrongdoing,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Nominalized verb is hard to resolve.", "bbox": null}
{"id": "sayakbay-ms-current142:pdf028:l039", "source_id": "sayakbay-ms-current142", "pdf_sha256": "2b1fd33d35b9fec662724180743e44a26bc44d8b347d5f99c373acf98cb6c73f", "page": 28, "folio": 2345, "line_in_page": 39, "raw": "Манас канга тийбедиң,", "text": "Манас канга тийбедиң,", "en": "You did not reach Khan Manas,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Proper name appears to be Манас.", "bbox": null}
