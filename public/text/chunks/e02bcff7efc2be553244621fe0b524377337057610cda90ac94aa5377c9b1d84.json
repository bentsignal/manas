[{"id":"semetey-1-2013:p0867:b005:l039","ordinal":142593,"en":"If that army sweeps over us,"},{"id":"semetey-1-2013:p0868:b003:l001","ordinal":142594,"en":"Great peril will come upon our dear lives."},{"id":"semetey-1-2013:p0868:b003:l002","ordinal":142595,"en":"The two of us, khan uncle,"},{"id":"semetey-1-2013:p0868:b003:l003","ordinal":142596,"en":"They mean to seize if we fall into their hands,"},{"id":"semetey-1-2013:p0868:b003:l004","ordinal":142597,"en":"Manas's sole surviving presence"},{"id":"semetey-1-2013:p0868:b003:l005","ordinal":142598,"en":"They mean to put to death."},{"id":"semetey-1-2013:p0868:b003:l006","ordinal":142599,"en":"Strutting together and bellowing,"},{"id":"semetey-1-2013:p0868:b003:l007","ordinal":142600,"en":"God has struck the people;"},{"id":"semetey-1-2013:p0868:b003:l008","ordinal":142601,"en":"Shouting “Kobosh!” as their battle cry,"},{"id":"semetey-1-2013:p0868:b003:l009","ordinal":142602,"en":"They ready their swift steeds,"},{"id":"semetey-1-2013:p0868:b003:l010","ordinal":142603,"en":"As though an enemy had come from China,"},{"id":"semetey-1-2013:p0868:b003:l011","ordinal":142604,"en":"They ready their lances,"},{"id":"semetey-1-2013:p0868:b003:l012","ordinal":142605,"en":"Swaying in ranks along the edge,"},{"id":"semetey-1-2013:p0868:b003:l013","ordinal":142606,"en":"Surging over the ground."},{"id":"semetey-1-2013:p0868:b003:l014","ordinal":142607,"en":"Their lancers divide into groups,"},{"id":"semetey-1-2013:p0868:b003:l015","ordinal":142608,"en":"Their fearsome aspect showing."},{"id":"semetey-1-2013:p0868:b003:l016","ordinal":142609,"en":"The great army they have gathered"},{"id":"semetey-1-2013:p0868:b003:l017","ordinal":142610,"en":"Spreads out, making the earth heave."},{"id":"semetey-1-2013:p0868:b003:l018","ordinal":142611,"en":"Kokcho, khan of the Kazakhs,"},{"id":"semetey-1-2013:p0868:b003:l019","ordinal":142612,"en":"His son Umotoy,"},{"id":"semetey-1-2013:p0868:b003:l020","ordinal":142613,"en":"Muzburchak's Buyanbek,"},{"id":"semetey-1-2013:p0868:b003:l021","ordinal":142614,"en":"Urbu's army is there too,"},{"id":"semetey-1-2013:p0868:b003:l022","ordinal":142615,"en":"Alabek of Alty-Shaar,"},{"id":"semetey-1-2013:p0868:b003:l023","ordinal":142616,"en":"His army is there too."},{"id":"semetey-1-2013:p0868:b003:l024","ordinal":142617,"en":"They ready their lancers,"},{"id":"semetey-1-2013:p0868:b003:l025","ordinal":142618,"en":"All their battle-axes"},{"id":"semetey-1-2013:p0868:b003:l026","ordinal":142619,"en":"They place along the flanks."},{"id":"semetey-1-2013:p0868:b003:l027","ordinal":142620,"en":"Preparing their marksmen,"},{"id":"semetey-1-2013:p0868:b003:l028","ordinal":142621,"en":"They spread them through the center;"},{"id":"semetey-1-2013:p0868:b003:l029","ordinal":142622,"en":"Dividing into different groups,"},{"id":"semetey-1-2013:p0868:b003:l030","ordinal":142623,"en":"Their appearance is menacing."},{"id":"semetey-1-2013:p0868:b003:l031","ordinal":142624,"en":"Seething and swarming, they divide,"},{"id":"semetey-1-2013:p0868:b003:l032","ordinal":142625,"en":"Their fearsome appearance showing."},{"id":"semetey-1-2013:p0868:b003:l033","ordinal":142626,"en":"If we stand our ground without shame,"},{"id":"semetey-1-2013:p0868:b003:l034","ordinal":142627,"en":"An army comes that will overwhelm us;"},{"id":"semetey-1-2013:p0868:b003:l035","ordinal":142628,"en":"A dark day brings peril to our lives."},{"id":"semetey-1-2013:p0868:b003:l036","ordinal":142629,"en":"Flashing and glittering,"},{"id":"semetey-1-2013:p0868:b003:l037","ordinal":142630,"en":"Spreading out and dividing,"},{"id":"semetey-1-2013:p0868:b003:l038","ordinal":142631,"en":"With their swordsmen on the flanks—"},{"id":"semetey-1-2013:p0868:b003:l039","ordinal":142632,"en":"My dear Bakai, listen!"},{"id":"semetey-1-2013:p0868:b004:l001","ordinal":142633,"en":"Their strongest men are at the front."},{"id":"semetey-1-2013:p0868:b004:l002","ordinal":142634,"en":"Their lancers are on the flanks,"},{"id":"semetey-1-2013:p0868:b004:l003","ordinal":142635,"en":"Their lions at the front."},{"id":"semetey-1-2013:p0868:b004:l004","ordinal":142636,"en":"Surging like ants,"},{"id":"semetey-1-2013:p0868:b004:l005","ordinal":142637,"en":"They come pouring out;"},{"id":"semetey-1-2013:p0868:b004:l006","ordinal":142638,"en":"Whether they are insects, one cannot tell,"},{"id":"semetey-1-2013:p0868:b004:l007","ordinal":142639,"en":"They come seething out."},{"id":"semetey-1-2013:p0868:b004:l008","ordinal":142640,"en":"Those skilled in drawing bows"},{"id":"semetey-1-2013:p0868:b004:l009","ordinal":142641,"en":"They have set apart again;"},{"id":"semetey-1-2013:p0868:b004:l010","ordinal":142642,"en":"Their finest men of strength"},{"id":"semetey-1-2013:p0868:b004:l011","ordinal":142643,"en":"They have set apart separately."},{"id":"semetey-1-2013:p0868:b004:l012","ordinal":142644,"en":"All their wrestlers"},{"id":"semetey-1-2013:p0868:b004:l013","ordinal":142645,"en":"They have put in separate groups."},{"id":"semetey-1-2013:p0868:b004:l014","ordinal":142646,"en":"Driving all of them from behind,"},{"id":"semetey-1-2013:p0868:b004:l015","ordinal":142647,"en":"Kobosh has brought them on."},{"id":"semetey-1-2013:p0868:b004:l016","ordinal":142648,"en":"Against the countless Chinese of Kakan,"},{"id":"semetey-1-2013:p0868:b004:l017","ordinal":142649,"en":"As though setting out on a holy war,"},{"id":"semetey-1-2013:p0868:b004:l018","ordinal":142650,"en":"The six villains are accursed;"},{"id":"semetey-1-2013:p0868:b004:l019","ordinal":142651,"en":"God has struck them."},{"id":"semetey-1-2013:p0868:b004:l020","ordinal":142652,"en":"Abyke and Kobosh, two villains,"},{"id":"semetey-1-2013:p0868:b004:l021","ordinal":142653,"en":"By name there are six villains,"},{"id":"semetey-1-2013:p0868:b004:l022","ordinal":142654,"en":"Khan Manas's forty companions,"},{"id":"semetey-1-2013:p0868:b004:l023","ordinal":142655,"en":"All forty came from forty places—dogs and swine."},{"id":"semetey-1-2013:p0868:b004:l025","ordinal":142656,"en":"They no longer heed the ancestral spirit."},{"id":"semetey-1-2013:p0868:b004:l026","ordinal":142657,"en":"When mighty Manas was alive,"},{"id":"semetey-1-2013:p0868:b004:l027","ordinal":142658,"en":"All forty were companions who ravaged the world."},{"id":"semetey-1-2013:p0868:b004:l028","ordinal":142659,"en":"Holding pennons, raising banners,"},{"id":"semetey-1-2013:p0868:b004:l029","ordinal":142660,"en":"Shouting ‘Khan Kobosh!’"},{"id":"semetey-1-2013:p0868:b004:l030","ordinal":142661,"en":"The great trumpet booms,"},{"id":"semetey-1-2013:p0868:b004:l031","ordinal":142662,"en":"The shawm clatters;"},{"id":"semetey-1-2013:p0868:b004:l032","ordinal":142663,"en":"He leads the army along its way."},{"id":"semetey-1-2013:p0868:b004:l033","ordinal":142664,"en":"They have ceased to fear the ancestral spirit;"},{"id":"semetey-1-2013:p0868:b004:l034","ordinal":142665,"en":"They attack Manas's orphan."},{"id":"semetey-1-2013:p0868:b004:l035","ordinal":142666,"en":"If the moon is shrouded in darkness,"},{"id":"semetey-1-2013:p0868:b004:l036","ordinal":142667,"en":"What will become of the night?"},{"id":"semetey-1-2013:p0868:b004:l037","ordinal":142668,"en":"Uncle Bakai, find a way!"},{"id":"semetey-1-2013:p0868:b004:l038","ordinal":142669,"en":"If they overwhelm this orphan,"},{"id":"semetey-1-2013:p0868:b004:l039","ordinal":142670,"en":"What will become of our days?"},{"id":"semetey-1-2013:p0869:b003:l001","ordinal":142671,"en":"If an arrow comes unerringly to strike,"},{"id":"semetey-1-2013:p0869:b003:l002","ordinal":142672,"en":"If a mass comes surging upon us,"},{"id":"semetey-1-2013:p0869:b003:l003","ordinal":142673,"en":"I was your sorrowful hound;"},{"id":"semetey-1-2013:p0869:b003:l004","ordinal":142674,"en":"A way to meet so many foes"},{"id":"semetey-1-2013:p0869:b003:l005","ordinal":142675,"en":"You, Bakai, were the one to find."},{"id":"semetey-1-2013:p0869:b003:l006","ordinal":142676,"en":"You would join what had broken,"},{"id":"semetey-1-2013:p0869:b003:l007","ordinal":142677,"en":"You would gather what had scattered;"},{"id":"semetey-1-2013:p0869:b003:l008","ordinal":142678,"en":"You were mighty Bakai,"},{"id":"semetey-1-2013:p0869:b003:l009","ordinal":142679,"en":"The equal of your mighty Manas.”"},{"id":"semetey-1-2013:p0869:b003:l010","ordinal":142680,"en":"When Sary Khan had said this,"},{"id":"semetey-1-2013:p0869:b003:l011","ordinal":142681,"en":"Bakai stood and spoke:"},{"id":"semetey-1-2013:p0869:b003:l012","ordinal":142682,"en":"“Ah, Sary Khan, my age-mate!"},{"id":"semetey-1-2013:p0869:b003:l013","ordinal":142683,"en":"Who has seen cliffs no wild game can cross—"},{"id":"semetey-1-2013:p0869:b003:l014","ordinal":142684,"en":"Here stands your dear Bakai!"},{"id":"semetey-1-2013:p0869:b003:l015","ordinal":142685,"en":"Who brought havoc upon the world—"},{"id":"semetey-1-2013:p0869:b003:l016","ordinal":142686,"en":"Here stands Bakai!"},{"id":"semetey-1-2013:p0869:b003:l017","ordinal":142687,"en":"When leopard Manas was alive,"},{"id":"semetey-1-2013:p0869:b003:l018","ordinal":142688,"en":"When we scattered the unbelievers' herds,"},{"id":"semetey-1-2013:p0869:b003:l019","ordinal":142689,"en":"When we opened the way for Islam,"},{"id":"semetey-1-2013:p0869:b003:l020","ordinal":142690,"en":"Ah, Sary Khan, my age-mate!"},{"id":"semetey-1-2013:p0869:b003:l021","ordinal":142691,"en":"You have made me suffer torment today;"},{"id":"semetey-1-2013:p0869:b003:l022","ordinal":142692,"en":"You have made Bakai, in his old age,"},{"id":"semetey-1-2013:p0869:b003:l023","ordinal":142693,"en":"Speak of days long past."},{"id":"semetey-1-2013:p0869:b003:l024","ordinal":142694,"en":"In noble Manas's own time,"},{"id":"semetey-1-2013:p0869:b003:l025","ordinal":142695,"en":"When Bakai was about to die,"},{"id":"semetey-1-2013:p0869:b003:l026","ordinal":142696,"en":"The great imam of Mecca,"},{"id":"semetey-1-2013:p0869:b003:l027","ordinal":142697,"en":"Saying, ‘If my appointed death comes, I shall die,’"},{"id":"semetey-1-2013:p0869:b003:l028","ordinal":142698,"en":"For the small band of Muslims,"},{"id":"semetey-1-2013:p0869:b003:l029","ordinal":142699,"en":"Saying, ‘I shall serve as imam,’"},{"id":"semetey-1-2013:p0869:b003:l030","ordinal":142700,"en":"He came from the Arab land."},{"id":"semetey-1-2013:p0869:b003:l031","ordinal":142701,"en":"The small band of Muslims—"},{"id":"semetey-1-2013:p0869:b003:l032","ordinal":142702,"en":"The people filled the place, seething like insects."},{"id":"semetey-1-2013:p0869:b003:l033","ordinal":142703,"en":"Khan Koshoi of the Katagan"},{"id":"semetey-1-2013:p0869:b003:l034","ordinal":142704,"en":"Was the one who held the banner."},{"id":"semetey-1-2013:p0869:b003:l035","ordinal":142705,"en":"Mighty Almam was there too,"},{"id":"semetey-1-2013:p0869:b003:l036","ordinal":142706,"en":"The finest of the sixty,"},{"id":"semetey-1-2013:p0869:b003:l037","ordinal":142707,"en":"The strongest of the forty companions,"},{"id":"semetey-1-2013:p0869:b003:l038","ordinal":142708,"en":"Chubak and Syrgak were there together."},{"id":"semetey-1-2013:p0869:b003:l039","ordinal":142709,"en":"Kakan's people were a vast host—"},{"id":"semetey-1-2013:p0869:b004:l001","ordinal":142710,"en":"Their numbers were like a black swarm of insects."},{"id":"semetey-1-2013:p0869:b004:l002","ordinal":142711,"en":"We were drenched in bloody gore;"},{"id":"semetey-1-2013:p0869:b004:l003","ordinal":142712,"en":"For six months we fought without fleeing."},{"id":"semetey-1-2013:p0869:b004:l004","ordinal":142713,"en":"Going forth to single combat,"},{"id":"semetey-1-2013:p0869:b004:l005","ordinal":142714,"en":"For seven months we fought without ceasing."},{"id":"semetey-1-2013:p0869:b004:l006","ordinal":142715,"en":"Kara-Shaar and Kambyl—"},{"id":"semetey-1-2013:p0869:b004:l007","ordinal":142716,"en":"I was the Bakai who besieged them;"},{"id":"semetey-1-2013:p0869:b004:l008","ordinal":142717,"en":"The Manchus, with crashing blows—"},{"id":"semetey-1-2013:p0869:b004:l009","ordinal":142718,"en":"I was the Bakai who battered them."},{"id":"semetey-1-2013:p0869:b004:l010","ordinal":142719,"en":"Upon everyone I could reach,"},{"id":"semetey-1-2013:p0869:b004:l011","ordinal":142720,"en":"I was the Bakai who wrought havoc;"},{"id":"semetey-1-2013:p0869:b004:l012","ordinal":142721,"en":"The whole world, bringing it to submission—"},{"id":"semetey-1-2013:p0869:b004:l013","ordinal":142722,"en":"I was the Bakai who took it."},{"id":"semetey-1-2013:p0869:b004:l014","ordinal":142723,"en":"Does not a man whose time has come die?"},{"id":"semetey-1-2013:p0869:b004:l015","ordinal":142724,"en":"The fate that Allah ordains,"},{"id":"semetey-1-2013:p0869:b004:l016","ordinal":142725,"en":"Must not a wretched mortal face it?"},{"id":"semetey-1-2013:p0869:b004:l017","ordinal":142726,"en":"If an army comes to overwhelm us,"},{"id":"semetey-1-2013:p0869:b004:l018","ordinal":142727,"en":"Will not Bakai deal with it?"},{"id":"semetey-1-2013:p0869:b004:l019","ordinal":142728,"en":"When my mighty Manas died,"},{"id":"semetey-1-2013:p0869:b004:l020","ordinal":142729,"en":"For twelve years I remained;"},{"id":"semetey-1-2013:p0869:b004:l021","ordinal":142730,"en":"With those dogs Abyke and Kobosh"},{"id":"semetey-1-2013:p0869:b004:l022","ordinal":142731,"en":"For twelve years I exchanged shots."},{"id":"semetey-1-2013:p0869:b004:l023","ordinal":142732,"en":"Where is my death,"},{"id":"semetey-1-2013:p0869:b004:l024","ordinal":142733,"en":"My sight of Judgment Day?"},{"id":"semetey-1-2013:p0869:b004:l025","ordinal":142734,"en":"Our kin, sprung from the same root—"},{"id":"semetey-1-2013:p0869:b004:l026","ordinal":142735,"en":"We shall watch how far they go."},{"id":"semetey-1-2013:p0869:b004:l027","ordinal":142736,"en":"If they overstep the limit,"},{"id":"semetey-1-2013:p0869:b004:l028","ordinal":142737,"en":"Then we shall fight."},{"id":"semetey-1-2013:p0869:b004:l029","ordinal":142738,"en":"Those unbelieving sons of Kazakhs,"},{"id":"semetey-1-2013:p0869:b004:l030","ordinal":142739,"en":"Those wretches yelling their battle cries,"},{"id":"semetey-1-2013:p0869:b004:l031","ordinal":142740,"en":"If we clash, we shall slaughter them."},{"id":"semetey-1-2013:p0869:b004:l032","ordinal":142741,"en":"If we fight, slaughter will follow;"},{"id":"semetey-1-2013:p0869:b004:l033","ordinal":142742,"en":"Where shall we find brothers then?"},{"id":"semetey-1-2013:p0869:b004:l034","ordinal":142743,"en":"If an army comes to fight with lances,"},{"id":"semetey-1-2013:p0869:b004:l035","ordinal":142744,"en":"If our lives are in grave peril,"},{"id":"semetey-1-2013:p0869:b004:l036","ordinal":142745,"en":"Then let us wreak slaughter;"},{"id":"semetey-1-2013:p0869:b004:l037","ordinal":142746,"en":"Manas's orphan son—"},{"id":"semetey-1-2013:p0869:b004:l038","ordinal":142747,"en":"Let us rescue him,”"},{"id":"semetey-1-2013:p0870:b003:l001","ordinal":142748,"en":"Having spoken thus, mighty Bakai"},{"id":"semetey-1-2013:p0870:b003:l002","ordinal":142749,"en":"Took the war drum left by Manas"},{"id":"semetey-1-2013:p0870:b003:l003","ordinal":142750,"en":"Into his hands,"},{"id":"semetey-1-2013:p0870:b003:l004","ordinal":142751,"en":"And struck it in the middle."},{"id":"semetey-1-2013:p0870:b003:l005","ordinal":142752,"en":"The Argyn and the Kyrgyz"},{"id":"semetey-1-2013:p0870:b003:l006","ordinal":142753,"en":"He gathered, leaving no one out."},{"id":"semetey-1-2013:p0870:b003:l007","ordinal":142754,"en":"Bakai's son Baitailak"},{"id":"semetey-1-2013:p0870:b003:l008","ordinal":142755,"en":"Had never before ridden into battle,"},{"id":"semetey-1-2013:p0870:b003:l010","ordinal":142756,"en":"And did not yet know the ways of war."},{"id":"semetey-1-2013:p0870:b003:l011","ordinal":142757,"en":"Sary Khan's Kalyk,"},{"id":"semetey-1-2013:p0870:b003:l012","ordinal":142758,"en":"When the Muslims fought,"},{"id":"semetey-1-2013:p0870:b003:l013","ordinal":142759,"en":"And cast down the kaldai's banner,"},{"id":"semetey-1-2013:p0870:b003:l014","ordinal":142760,"en":"Had brought his light to the people."},{"id":"semetey-1-2013:p0870:b003:l015","ordinal":142761,"en":"They mounted horses no bullet could catch,"},{"id":"semetey-1-2013:p0870:b003:l016","ordinal":142762,"en":"And wore coats no bullet could pierce."},{"id":"semetey-1-2013:p0870:b003:l017","ordinal":142763,"en":"Taking their spears, they made ready,"},{"id":"semetey-1-2013:p0870:b003:l018","ordinal":142764,"en":"And fastened on their battle-axes."},{"id":"semetey-1-2013:p0870:b003:l019","ordinal":142765,"en":"Dressed in the garb of war,"},{"id":"semetey-1-2013:p0870:b003:l020","ordinal":142766,"en":"He too came rejoicing."},{"id":"semetey-1-2013:p0870:b003:l021","ordinal":142767,"en":"‘If my appointed death has come, I shall die;"},{"id":"semetey-1-2013:p0870:b003:l022","ordinal":142768,"en":"For the orphan son of Manas,"},{"id":"semetey-1-2013:p0870:b003:l023","ordinal":142769,"en":"I shall serve as a protector,’ he said."},{"id":"semetey-1-2013:p0870:b003:l024","ordinal":142770,"en":"Zhamgyrchy of the Eshteks"},{"id":"semetey-1-2013:p0870:b003:l025","ordinal":142771,"en":"Was an influential khan,"},{"id":"semetey-1-2013:p0870:b003:l026","ordinal":142772,"en":"For Manas, the gray-maned noble steed,"},{"id":"semetey-1-2013:p0870:b003:l027","ordinal":142773,"en":"He had been a steadfast support."},{"id":"semetey-1-2013:p0870:b004:l001","ordinal":142774,"en":"Sharing the same livestock pens,"},{"id":"semetey-1-2013:p0870:b004:l002","ordinal":142775,"en":"Sharing food as comrades,"},{"id":"semetey-1-2013:p0870:b004:l003","ordinal":142776,"en":"Zhamgyrchy's Shayymbet"},{"id":"semetey-1-2013:p0870:b004:l004","ordinal":142777,"en":"Took a pale-mottled flag and banner,"},{"id":"semetey-1-2013:p0870:b004:l005","ordinal":142778,"en":"And raised a clamorous cry."},{"id":"semetey-1-2013:p0870:b004:l006","ordinal":142779,"en":"‘If my appointed death has come, I shall die;"},{"id":"semetey-1-2013:p0870:b004:l007","ordinal":142780,"en":"For the orphan left by Manas,"},{"id":"semetey-1-2013:p0870:b004:l008","ordinal":142781,"en":"I shall serve as a protector,’ he said."},{"id":"semetey-1-2013:p0870:b004:l009","ordinal":142782,"en":"The strongman Shayymbet came."},{"id":"semetey-1-2013:p0870:b004:l010","ordinal":142783,"en":"All were sons of khans,"},{"id":"semetey-1-2013:p0870:b004:l011","ordinal":142784,"en":"With souls like angels of death."},{"id":"semetey-1-2013:p0870:b004:l012","ordinal":142785,"en":"Their elders, led by Bakai,"},{"id":"semetey-1-2013:p0870:b004:l013","ordinal":142786,"en":"Sary Khan upon Tuuchunak,"},{"id":"semetey-1-2013:p0870:b004:l014","ordinal":142787,"en":"And all the warriors,"},{"id":"semetey-1-2013:p0870:b004:l015","ordinal":142788,"en":"Prepared their weapons."},{"id":"semetey-1-2013:p0870:b004:l016","ordinal":142789,"en":"If Semetey were attacked,"},{"id":"semetey-1-2013:p0870:b004:l017","ordinal":142790,"en":"To sweep down upon the foe,"},{"id":"semetey-1-2013:p0870:b004:l018","ordinal":142791,"en":"All the warriors made ready."},{"id":"semetey-1-2013:p0870:b004:l019","ordinal":142792,"en":"In the hollow of Zhylgynduu,"},{"id":"semetey-1-2013:p0870:b004:l020","ordinal":142793,"en":"Along broad Talas,"},{"id":"semetey-1-2013:p0870:b004:l021","ordinal":142794,"en":"They divided into hundreds,"},{"id":"semetey-1-2013:p0870:b004:l022","ordinal":142795,"en":"All appearing like lions."},{"id":"semetey-1-2013:p0870:b004:l023","ordinal":142796,"en":"They turned their horses,"},{"id":"semetey-1-2013:p0870:b004:l024","ordinal":142797,"en":"And all stood watchfully."},{"id":"semetey-1-2013:p0870:b004:l025","ordinal":142798,"en":"Let us leave them thus."},{"id":"semetey-1-2013:p0870:b004:l026","ordinal":142799,"en":"Of the great army sweeping toward them,"},{"id":"semetey-1-2013:p0870:b004:l027","ordinal":142800,"en":"Let us now begin the news."},{"id":"semetey-1-2013:p0871:b004:l001","ordinal":142801,"en":"Abyke and Kobosh—two villains,"},{"id":"semetey-1-2013:p0871:b004:l002","ordinal":142802,"en":"Chyybyt and Kochkor—four villains,"},{"id":"semetey-1-2013:p0871:b004:l003","ordinal":142803,"en":"Azhybai and Kolbai—six villains,"},{"id":"semetey-1-2013:p0871:b004:l004","ordinal":142804,"en":"And the forty warriors left by Manas,"},{"id":"semetey-1-2013:p0871:b004:l005","ordinal":142805,"en":"Having raised Kobosh as khan,"},{"id":"semetey-1-2013:p0871:b004:l006","ordinal":142806,"en":"Gathered troops from hostile khans."},{"id":"semetey-1-2013:p0871:b004:l007","ordinal":142807,"en":"They gathered a vast, numerous army,"},{"id":"semetey-1-2013:p0871:b004:l008","ordinal":142808,"en":"Making it trample the face of the earth,"},{"id":"semetey-1-2013:p0871:b004:l009","ordinal":142809,"en":"Making it swarm across the land."},{"id":"semetey-1-2013:p0871:b004:l010","ordinal":142810,"en":"Men crowded together, swaying,"},{"id":"semetey-1-2013:p0871:b004:l011","ordinal":142811,"en":"Surging in confusion."},{"id":"semetey-1-2013:p0871:b004:l012","ordinal":142812,"en":"They spread their lancers out,"},{"id":"semetey-1-2013:p0871:b004:l013","ordinal":142813,"en":"With the forty warriors driving the rear."},{"id":"semetey-1-2013:p0871:b004:l015","ordinal":142814,"en":"An army came to trample all,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0871:b004:l016","ordinal":142815,"en":"Pale-mottled flags and banners came,"},{"id":"semetey-1-2013:p0871:b004:l017","ordinal":142816,"en":"A clamorous uproar came."},{"id":"semetey-1-2013:p0871:b004:l018","ordinal":142817,"en":"They divided into successive waves."},{"id":"semetey-1-2013:p0871:b004:l019","ordinal":142818,"en":"Watching them, Kanykei,"},{"id":"semetey-1-2013:p0871:b004:l020","ordinal":142819,"en":"Your dear, fierce mother,"},{"id":"semetey-1-2013:p0871:b004:l021","ordinal":142820,"en":"Shed tears from her eyes."},{"id":"semetey-1-2013:p0871:b004:l022","ordinal":142821,"en":"From those dear quail-like eyes,"},{"id":"semetey-1-2013:p0871:b004:l023","ordinal":142822,"en":"Tears fell in separate drops."},{"id":"semetey-1-2013:p0871:b004:l024","ordinal":142823,"en":"From those dear currant-like eyes,"},{"id":"semetey-1-2013:p0871:b004:l025","ordinal":142824,"en":"Tears streamed a whip's length."},{"id":"semetey-1-2013:p0871:b004:l026","ordinal":142825,"en":"‘My beloved Creator,"},{"id":"semetey-1-2013:p0871:b004:l027","ordinal":142826,"en":"Will they dig my pit?"},{"id":"semetey-1-2013:p0871:b004:l028","ordinal":142827,"en":"The orphan on whom I lean,"},{"id":"semetey-1-2013:p0871:b004:l029","ordinal":142828,"en":"Will they seize and slaughter him,"},{"id":"semetey-1-2013:p0871:b004:l030","ordinal":142829,"en":"And boil up my misery?"},{"id":"semetey-1-2013:p0871:b004:l031","ordinal":142830,"en":"The plump, pale-mottled female goshawk,"},{"id":"semetey-1-2013:p0871:b004:l032","ordinal":142831,"en":"The gray hawk, my morning star—"},{"id":"semetey-1-2013:p0871:b004:l033","ordinal":142832,"en":"If they overwhelm him, God will strike me down;"},{"id":"semetey-1-2013:p0871:b004:l034","ordinal":142833,"en":"What will Allah do?"},{"id":"semetey-1-2013:p0871:b004:l035","ordinal":142834,"en":"While these six villains live,"},{"id":"semetey-1-2013:p0871:b004:l036","ordinal":142835,"en":"Broad Talas will be no homeland for us,"},{"id":"semetey-1-2013:p0871:b005:l001","ordinal":142836,"en":"These Kyrgyz will be no people of ours."},{"id":"semetey-1-2013:p0871:b005:l002","ordinal":142837,"en":"Those six villains gathered before,"},{"id":"semetey-1-2013:p0871:b005:l003","ordinal":142838,"en":"And attacked my migrating household in Talas."},{"id":"semetey-1-2013:p0871:b005:l004","ordinal":142839,"en":"Cursed be my womanhood!"},{"id":"semetey-1-2013:p0871:b005:l005","ordinal":142840,"en":"I left without taking vengeance on the villains!"},{"id":"semetey-1-2013:p0871:b005:l006","ordinal":142841,"en":"They have words they keep repeating;"},{"id":"semetey-1-2013:p0871:b005:l007","ordinal":142842,"en":"Those dogs who will not perish"},{"id":"semetey-1-2013:p0871:b005:l008","ordinal":142843,"en":"Bear a spear's length of rancor."},{"id":"semetey-1-2013:p0871:b005:l009","ordinal":142844,"en":"When I fled this place,"},{"id":"semetey-1-2013:p0871:b005:l011","ordinal":142845,"en":"Cursed be my womanhood!","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0871:b005:l012","ordinal":142846,"en":"I left without exacting redress from the dogs!"},{"id":"semetey-1-2013:p0871:b005:l013","ordinal":142847,"en":"The spring flowing from the hills—"},{"id":"semetey-1-2013:p0871:b005:l014","ordinal":142848,"en":"Perhaps they have trampled it again."}]
