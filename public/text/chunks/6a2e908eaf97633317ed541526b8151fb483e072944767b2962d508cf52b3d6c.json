[{"id":"semetey-1-2013:p0995:b006:l030","ordinal":153089,"en":"An object seven days distant"},{"id":"semetey-1-2013:p0995:b006:l031","ordinal":153090,"en":"Appeared only seven rope-lengths away."},{"id":"semetey-1-2013:p0995:b006:l032","ordinal":153091,"en":"The tiger's great spyglass—"},{"id":"semetey-1-2013:p0995:b006:l033","ordinal":153092,"en":"He turned its focusing wheel,"},{"id":"semetey-1-2013:p0995:b006:l034","ordinal":153093,"en":"Set it to his keen eye,"},{"id":"semetey-1-2013:p0995:b006:l035","ordinal":153094,"en":"Turned its adjusting screw,"},{"id":"semetey-1-2013:p0995:b006:l036","ordinal":153095,"en":"And held it unwaveringly to his eye."},{"id":"semetey-1-2013:p0996:b003:l001","ordinal":153096,"en":"Holding it at a slant,"},{"id":"semetey-1-2013:p0996:b003:l002","ordinal":153097,"en":"He filled its field of view;"},{"id":"semetey-1-2013:p0996:b003:l003","ordinal":153098,"en":"Holding it steadily,"},{"id":"semetey-1-2013:p0996:b003:l004","ordinal":153099,"en":"He satisfied his heart."},{"id":"semetey-1-2013:p0996:b003:l005","ordinal":153100,"en":"Now he saw the city"},{"id":"semetey-1-2013:p0996:b003:l006","ordinal":153101,"en":"Of that same Khan Akun,"},{"id":"semetey-1-2013:p0996:b003:l007","ordinal":153102,"en":"And now he saw all the different kinds"},{"id":"semetey-1-2013:p0996:b003:l008","ordinal":153103,"en":"Of people living there."},{"id":"semetey-1-2013:p0996:b003:l009","ordinal":153104,"en":"They displayed surpassing finery,"},{"id":"semetey-1-2013:p0996:b003:l010","ordinal":153105,"en":"And loaded their burdens upon camels;"},{"id":"semetey-1-2013:p0996:b003:l011","ordinal":153106,"en":"It was a populous garden-land traveled by caravans,"},{"id":"semetey-1-2013:p0996:b003:l012","ordinal":153107,"en":"And its people were somewhat haughty."},{"id":"semetey-1-2013:p0996:b003:l013","ordinal":153108,"en":"They were a people resembling the Sarts,"},{"id":"semetey-1-2013:p0996:b003:l014","ordinal":153109,"en":"And their name, he learned, was Afghan."},{"id":"semetey-1-2013:p0996:b003:l015","ordinal":153110,"en":"Their trouser cuffs hung loose,"},{"id":"semetey-1-2013:p0996:b003:l016","ordinal":153111,"en":"And they wore striped trousers;"},{"id":"semetey-1-2013:p0996:b003:l017","ordinal":153112,"en":"At precisely sixty saddle-straps"},{"id":"semetey-1-2013:p0996:b003:l018","ordinal":153113,"en":"Their knives had sheaths."},{"id":"semetey-1-2013:p0996:b003:l019","ordinal":153114,"en":"Their shirts lay open upon bare chests;"},{"id":"semetey-1-2013:p0996:b003:l020","ordinal":153115,"en":"They were hook-nosed and dark-eyed."},{"id":"semetey-1-2013:p0996:b003:l021","ordinal":153116,"en":"There were people of countless forms;"},{"id":"semetey-1-2013:p0996:b003:l022","ordinal":153117,"en":"If you looked closely, Afghanistan"},{"id":"semetey-1-2013:p0996:b003:l023","ordinal":153118,"en":"Possessed a beauty all its own."},{"id":"semetey-1-2013:p0996:b003:l024","ordinal":153119,"en":"Even in the scorching height of summer"},{"id":"semetey-1-2013:p0996:b003:l025","ordinal":153120,"en":"They wore black hats broad as cauldrons."},{"id":"semetey-1-2013:p0996:b003:l026","ordinal":153121,"en":"They had donkeys, mules, and horses,"},{"id":"semetey-1-2013:p0996:b003:l027","ordinal":153122,"en":"And champions of many different kinds;"},{"id":"semetey-1-2013:p0996:b003:l028","ordinal":153123,"en":"In plain robes and dark-eyed,"},{"id":"semetey-1-2013:p0996:b003:l029","ordinal":153124,"en":"They had a population of countless kinds."},{"id":"semetey-1-2013:p0996:b003:l030","ordinal":153125,"en":"The khan of that Afghanistan"},{"id":"semetey-1-2013:p0996:b003:l031","ordinal":153126,"en":"Was a man endowed with sacred power,"},{"id":"semetey-1-2013:p0996:b003:l032","ordinal":153127,"en":"The vigorous elder Akun."},{"id":"semetey-1-2013:p0996:b003:l033","ordinal":153128,"en":"The city spread outward in cornered districts,"},{"id":"semetey-1-2013:p0996:b003:l034","ordinal":153129,"en":"Its distant limits sharpened beneath the haze."},{"id":"semetey-1-2013:p0996:b003:l035","ordinal":153130,"en":"Afghanistan was a considerable city;"},{"id":"semetey-1-2013:p0996:b003:l036","ordinal":153131,"en":"When he properly trained the spyglass upon it,"},{"id":"semetey-1-2013:p0996:b003:l037","ordinal":153132,"en":"He saw that it held such a population."},{"id":"semetey-1-2013:p0996:b003:l038","ordinal":153133,"en":"There in the land of Afghanistan"},{"id":"semetey-1-2013:p0996:b003:l039","ordinal":153134,"en":"Were mullahs wearing white turbans;"},{"id":"semetey-1-2013:p0996:b004:l001","ordinal":153135,"en":"Such was the account of them."},{"id":"semetey-1-2013:p0996:b004:l002","ordinal":153136,"en":"There were khojas in striped robes,"},{"id":"semetey-1-2013:p0996:b004:l003","ordinal":153137,"en":"A populace and a khan,"},{"id":"semetey-1-2013:p0996:b004:l004","ordinal":153138,"en":"And living souls of countless kinds."},{"id":"semetey-1-2013:p0996:b004:l005","ordinal":153139,"en":"Akun lacked nothing he desired;"},{"id":"semetey-1-2013:p0996:b004:l006","ordinal":153140,"en":"Guarding his treasury"},{"id":"semetey-1-2013:p0996:b004:l007","ordinal":153141,"en":"Stood black wrestlers in ordered ranks."},{"id":"semetey-1-2013:p0996:b004:l008","ordinal":153142,"en":"The wrestlers had a curious appearance:"},{"id":"semetey-1-2013:p0996:b004:l009","ordinal":153143,"en":"Trimmed beards and hairpieces;"},{"id":"semetey-1-2013:p0996:b004:l010","ordinal":153144,"en":"Strange indeed were these people."},{"id":"semetey-1-2013:p0996:b004:l011","ordinal":153145,"en":"They spoke a halting, broken tongue,"},{"id":"semetey-1-2013:p0996:b004:l012","ordinal":153146,"en":"And followed the Muslim faith."},{"id":"semetey-1-2013:p0996:b004:l013","ordinal":153147,"en":"Swaggering like black stallions,"},{"id":"semetey-1-2013:p0996:b004:l014","ordinal":153148,"en":"The people of Afghanistan"},{"id":"semetey-1-2013:p0996:b004:l015","ordinal":153149,"en":"Had a weakness for watching women."},{"id":"semetey-1-2013:p0996:b004:l016","ordinal":153150,"en":"Raised in arms without seeing a cradle,"},{"id":"semetey-1-2013:p0996:b004:l017","ordinal":153151,"en":"They had long heads shaped like mortars."},{"id":"semetey-1-2013:p0996:b004:l018","ordinal":153152,"en":"They had costly food"},{"id":"semetey-1-2013:p0996:b004:l019","ordinal":153153,"en":"Of red currants and raisins."},{"id":"semetey-1-2013:p0996:b004:l020","ordinal":153154,"en":"Their name, he learned, was Afghan;"},{"id":"semetey-1-2013:p0996:b004:l021","ordinal":153155,"en":"They were a rather feeble people."},{"id":"semetey-1-2013:p0996:b004:l022","ordinal":153156,"en":"Long ago, when my khan-father Manas lived,"},{"id":"semetey-1-2013:p0996:b004:l023","ordinal":153157,"en":"He raided them and took plunder,"},{"id":"semetey-1-2013:p0996:b004:l024","ordinal":153158,"en":"Taking elephants among the spoils,"},{"id":"semetey-1-2013:p0996:b004:l025","ordinal":153159,"en":"And loading the elephants with gold coins;"},{"id":"semetey-1-2013:p0996:b004:l026","ordinal":153160,"en":"He took a thousand dark-eyed women."},{"id":"semetey-1-2013:p0996:b004:l027","ordinal":153161,"en":"To raid them had been fitting,"},{"id":"semetey-1-2013:p0996:b004:l028","ordinal":153162,"en":"For it was a rather feeble land;"},{"id":"semetey-1-2013:p0996:b004:l029","ordinal":153163,"en":"What they said was true:"},{"id":"semetey-1-2013:p0996:b004:l030","ordinal":153164,"en":"Its women were beauties indeed."},{"id":"semetey-1-2013:p0996:b004:l031","ordinal":153165,"en":"If we should become enemies,"},{"id":"semetey-1-2013:p0996:b004:l032","ordinal":153166,"en":"And charge into battle,"},{"id":"semetey-1-2013:p0996:b004:l033","ordinal":153167,"en":"If they came against us head-on,"},{"id":"semetey-1-2013:p0996:b004:l034","ordinal":153168,"en":"We could slaughter them all."},{"id":"semetey-1-2013:p0996:b004:l035","ordinal":153169,"en":"If Kanchoro's wrath were roused,"},{"id":"semetey-1-2013:p0996:b004:l036","ordinal":153170,"en":"He could bind and capture their khans."},{"id":"semetey-1-2013:p0996:b004:l037","ordinal":153171,"en":"Baitaylak, man of Khan Bakay,"},{"id":"semetey-1-2013:p0996:b004:l038","ordinal":153172,"en":"Could take all of them as plunder;"},{"id":"semetey-1-2013:p0996:b004:l039","ordinal":153173,"en":"And Kalyk, man of Sarykan,"},{"id":"semetey-1-2013:p0997:b003:l001","ordinal":153174,"en":"Could strike them down like a gyrfalcon in battle."},{"id":"semetey-1-2013:p0997:b003:l002","ordinal":153175,"en":"Shayymbet, man of Jamgyrchy,"},{"id":"semetey-1-2013:p0997:b003:l003","ordinal":153176,"en":"Could meet them as an equal,"},{"id":"semetey-1-2013:p0997:b003:l004","ordinal":153177,"en":"And if we suddenly joined battle,"},{"id":"semetey-1-2013:p0997:b003:l005","ordinal":153178,"en":"If we unexpectedly fell upon each other,"},{"id":"semetey-1-2013:p0997:b003:l006","ordinal":153179,"en":"And I charged in with a roar,"},{"id":"semetey-1-2013:p0997:b003:l007","ordinal":153180,"en":"Their hearts would fail and they would die;"},{"id":"semetey-1-2013:p0997:b003:l008","ordinal":153181,"en":"That wretched, feeble people"},{"id":"semetey-1-2013:p0997:b003:l009","ordinal":153182,"en":"Would behold the face of Judgment Day."},{"id":"semetey-1-2013:p0997:b003:l010","ordinal":153183,"en":"They were an exceedingly weak people,"},{"id":"semetey-1-2013:p0997:b003:l011","ordinal":153184,"en":"And their name, he learned, was Afghan."},{"id":"semetey-1-2013:p0997:b003:l012","ordinal":153185,"en":"They had houses built with four corners,"},{"id":"semetey-1-2013:p0997:b003:l013","ordinal":153186,"en":"And bread made round;"},{"id":"semetey-1-2013:p0997:b003:l014","ordinal":153187,"en":"Displaying countless different forms,"},{"id":"semetey-1-2013:p0997:b003:l015","ordinal":153188,"en":"Almighty God in his power"},{"id":"semetey-1-2013:p0997:b003:l016","ordinal":153189,"en":"Had created them wondrously."},{"id":"semetey-1-2013:p0997:b003:l017","ordinal":153190,"en":"Your lord grew weary of the city."},{"id":"semetey-1-2013:p0997:b003:l018","ordinal":153191,"en":"Holding the spyglass at a slant,"},{"id":"semetey-1-2013:p0997:b003:l019","ordinal":153192,"en":"He filled its field of view;"},{"id":"semetey-1-2013:p0997:b003:l020","ordinal":153193,"en":"Holding it somewhat lower,"},{"id":"semetey-1-2013:p0997:b003:l021","ordinal":153194,"en":"He satisfied his heart."},{"id":"semetey-1-2013:p0997:b003:l022","ordinal":153195,"en":"He turned the right-hand wheel"},{"id":"semetey-1-2013:p0997:b003:l023","ordinal":153196,"en":"And directed it toward Opol."},{"id":"semetey-1-2013:p0997:b003:l024","ordinal":153197,"en":"Your lord settled himself,"},{"id":"semetey-1-2013:p0997:b003:l025","ordinal":153198,"en":"And from that distant forked place,"},{"id":"semetey-1-2013:p0997:b003:l026","ordinal":153199,"en":"He coiled like a dragon"},{"id":"semetey-1-2013:p0997:b003:l027","ordinal":153200,"en":"And gathered himself like a white tiger."},{"id":"semetey-1-2013:p0997:b003:l028","ordinal":153201,"en":"That poor, proud-standing hero"},{"id":"semetey-1-2013:p0997:b003:l029","ordinal":153202,"en":"Was seized by agitation."},{"id":"semetey-1-2013:p0997:b003:l030","ordinal":153203,"en":"Suddenly growing wrathful,"},{"id":"semetey-1-2013:p0997:b003:l031","ordinal":153204,"en":"Your tiger entrusted the spyglass"},{"id":"semetey-1-2013:p0997:b003:l032","ordinal":153205,"en":"To his own dear eye,"},{"id":"semetey-1-2013:p0997:b003:l033","ordinal":153206,"en":"Toward a spur of broad Opol,"},{"id":"semetey-1-2013:p0997:b003:l034","ordinal":153207,"en":"Toward the nose of the mountain there,"},{"id":"semetey-1-2013:p0997:b003:l035","ordinal":153208,"en":"Toward the meeting of nine roads,"},{"id":"semetey-1-2013:p0997:b003:l036","ordinal":153209,"en":"Toward the expanse of Boru-Koy,"},{"id":"semetey-1-2013:p0997:b003:l037","ordinal":153210,"en":"Toward the hollow of Ok-Kyya,"},{"id":"semetey-1-2013:p0997:b003:l038","ordinal":153211,"en":"Toward the banks of Great Urgench,"},{"id":"semetey-1-2013:p0997:b003:l039","ordinal":153212,"en":"He now trained the spyglass."},{"id":"semetey-1-2013:p0997:b004:l001","ordinal":153213,"en":"Beside the flowing water,"},{"id":"semetey-1-2013:p0997:b004:l002","ordinal":153214,"en":"The poor daughter of Akun"},{"id":"semetey-1-2013:p0997:b004:l003","ordinal":153215,"en":"Your lord now saw in full."},{"id":"semetey-1-2013:p0997:b004:l004","ordinal":153216,"en":"Your gray wolf, with a fierce appetite"},{"id":"semetey-1-2013:p0997:b004:l005","ordinal":153217,"en":"For liquor and women,"},{"id":"semetey-1-2013:p0997:b004:l006","ordinal":153218,"en":"Now fixed his eyes intently."},{"id":"semetey-1-2013:p0997:b004:l007","ordinal":153219,"en":"Amid thirty daughters-in-law and thirty maidens,"},{"id":"semetey-1-2013:p0997:b004:l008","ordinal":153220,"en":"He now saw"},{"id":"semetey-1-2013:p0997:b004:l009","ordinal":153221,"en":"Churok herself."},{"id":"semetey-1-2013:p0997:b004:l010","ordinal":153222,"en":"He began an uproar;"},{"id":"semetey-1-2013:p0997:b004:l011","ordinal":153223,"en":"Your lord of the dark day faltered,"},{"id":"semetey-1-2013:p0997:b004:l012","ordinal":153224,"en":"And when he saw Aychurok,"},{"id":"semetey-1-2013:p0997:b004:l013","ordinal":153225,"en":"He nearly dropped dead:"},{"id":"semetey-1-2013:p0997:b004:l014","ordinal":153226,"en":"\"Good heavens, I had thought,"},{"id":"semetey-1-2013:p0997:b004:l015","ordinal":153227,"en":"'I took a wife from Bukhara,'"},{"id":"semetey-1-2013:p0997:b004:l016","ordinal":153228,"en":"And had gone on believing it;"},{"id":"semetey-1-2013:p0997:b004:l017","ordinal":153229,"en":"But instead of taking a wife, good heavens,"},{"id":"semetey-1-2013:p0997:b004:l018","ordinal":153230,"en":"I have been living as a bachelor.\""},{"id":"semetey-1-2013:p0997:b004:l019","ordinal":153231,"en":"Thirty daughters-in-law and thirty maidens"},{"id":"semetey-1-2013:p0997:b004:l020","ordinal":153232,"en":"Moved lightly in their games;"},{"id":"semetey-1-2013:p0997:b004:l021","ordinal":153233,"en":"In their midst Aychurok"},{"id":"semetey-1-2013:p0997:b004:l022","ordinal":153234,"en":"Glittered like a poppy."},{"id":"semetey-1-2013:p0997:b004:l023","ordinal":153235,"en":"She wore a fitted dress and a sable coat,"},{"id":"semetey-1-2013:p0997:b004:l024","ordinal":153236,"en":"With its hem showing below."},{"id":"semetey-1-2013:p0997:b004:l025","ordinal":153237,"en":"Your lord's heart grew tender,"},{"id":"semetey-1-2013:p0997:b004:l026","ordinal":153238,"en":"And his mind was deeply stirred;"},{"id":"semetey-1-2013:p0997:b004:l027","ordinal":153239,"en":"Each time he looked, Aychurok"},{"id":"semetey-1-2013:p0997:b004:l028","ordinal":153240,"en":"Appeared like a precious jewel."},{"id":"semetey-1-2013:p0997:b004:l029","ordinal":153241,"en":"Green-patterned ornaments, powder, and rouge"},{"id":"semetey-1-2013:p0997:b004:l030","ordinal":153242,"en":"Of that sister-in-law Churok of yours"},{"id":"semetey-1-2013:p0997:b004:l031","ordinal":153243,"en":"Showed upon her bosom;"},{"id":"semetey-1-2013:p0997:b004:l032","ordinal":153244,"en":"Each time he looked he gasped,"},{"id":"semetey-1-2013:p0997:b004:l033","ordinal":153245,"en":"And your lord's heart opened."},{"id":"semetey-1-2013:p0997:b004:l034","ordinal":153246,"en":"Adorned and resolute,"},{"id":"semetey-1-2013:p0997:b004:l035","ordinal":153247,"en":"She swayed as though moving toward him."},{"id":"semetey-1-2013:p0997:b004:l036","ordinal":153248,"en":"Upon her head was a skullcap made of gold;"},{"id":"semetey-1-2013:p0997:b004:l037","ordinal":153249,"en":"Her splendor surpassed every living soul,"},{"id":"semetey-1-2013:p0997:b004:l038","ordinal":153250,"en":"That poor beauty, daughter of Akun."},{"id":"semetey-1-2013:p0997:b004:l039","ordinal":153251,"en":"The unfortunate daughter of the khan"},{"id":"semetey-1-2013:p0998:b003:l001","ordinal":153252,"en":"Would she not immerse herself"},{"id":"semetey-1-2013:p0998:b003:l002","ordinal":153253,"en":"In wondrous games and revelry?"},{"id":"semetey-1-2013:p0998:b003:l003","ordinal":153254,"en":"For the sake of this girl Churok,"},{"id":"semetey-1-2013:p0998:b003:l004","ordinal":153255,"en":"Would she not suffer"},{"id":"semetey-1-2013:p0998:b003:l005","ordinal":153256,"en":"The torments of the world?"},{"id":"semetey-1-2013:p0998:b003:l006","ordinal":153257,"en":"Would she not behold"},{"id":"semetey-1-2013:p0998:b003:l007","ordinal":153258,"en":"Every harsh decree of fate?"},{"id":"semetey-1-2013:p0998:b003:l008","ordinal":153259,"en":"Would she not die"},{"id":"semetey-1-2013:p0998:b003:l009","ordinal":153260,"en":"Locked in Churok's embrace?"},{"id":"semetey-1-2013:p0998:b003:l010","ordinal":153261,"en":"Would she not immerse herself"},{"id":"semetey-1-2013:p0998:b003:l011","ordinal":153262,"en":"In every wondrous delight?"},{"id":"semetey-1-2013:p0998:b003:l012","ordinal":153263,"en":"Would she not lie down"},{"id":"semetey-1-2013:p0998:b003:l013","ordinal":153264,"en":"Locked in Churok's embrace?"},{"id":"semetey-1-2013:p0998:b003:l014","ordinal":153265,"en":"Damn that robber of your father's grave!"},{"id":"semetey-1-2013:p0998:b003:l015","ordinal":153266,"en":"My destined path led away to Bukhara;"},{"id":"semetey-1-2013:p0998:b003:l016","ordinal":153267,"en":"Had my mighty father lived,"},{"id":"semetey-1-2013:p0998:b003:l017","ordinal":153268,"en":"This was the wife I should have taken first."},{"id":"semetey-1-2013:p0998:b003:l018","ordinal":153269,"en":"Accursed be God's taking"},{"id":"semetey-1-2013:p0998:b003:l019","ordinal":153270,"en":"Of my father in his youth;"},{"id":"semetey-1-2013:p0998:b003:l020","ordinal":153271,"en":"Accursed be the fate that left"},{"id":"semetey-1-2013:p0998:b003:l021","ordinal":153272,"en":"A son without his father while still young!"},{"id":"semetey-1-2013:p0998:b003:l022","ordinal":153273,"en":"This poor soul wandered far and long,"},{"id":"semetey-1-2013:p0998:b003:l023","ordinal":153274,"en":"Unable to find"},{"id":"semetey-1-2013:p0998:b003:l024","ordinal":153275,"en":"My Kyrgyz encampment in Talas."},{"id":"semetey-1-2013:p0998:b003:l025","ordinal":153276,"en":"I had failed to take"},{"id":"semetey-1-2013:p0998:b003:l026","ordinal":153277,"en":"A wife like Aychurok."},{"id":"semetey-1-2013:p0998:b003:l027","ordinal":153278,"en":"Accursed be my wandering"},{"id":"semetey-1-2013:p0998:b003:l028","ordinal":153279,"en":"To the city of Temir Khan;"},{"id":"semetey-1-2013:p0998:b003:l029","ordinal":153280,"en":"Unable to find and take my equal,"},{"id":"semetey-1-2013:p0998:b003:l030","ordinal":153281,"en":"I did not act as I should have!\""},{"id":"semetey-1-2013:p0998:b003:l031","ordinal":153282,"en":"Your lord stood there grieving,"},{"id":"semetey-1-2013:p0998:b003:l032","ordinal":153283,"en":"Transfixed by the sight of Churok."},{"id":"semetey-1-2013:p0998:b003:l033","ordinal":153284,"en":"Now let us tell"},{"id":"semetey-1-2013:p0998:b003:l034","ordinal":153285,"en":"What Aychurok had done."},{"id":"semetey-1-2013:p0998:b003:l035","ordinal":153286,"en":"There are two traditions about her fortune,"},{"id":"semetey-1-2013:p0998:b003:l036","ordinal":153287,"en":"A point disputed among the people."},{"id":"semetey-1-2013:p0998:b003:l037","ordinal":153288,"en":"Some people say:"},{"id":"semetey-1-2013:p0998:b003:l038","ordinal":153289,"en":"\"Churok is the daughter of a fairy,\""},{"id":"semetey-1-2013:p0998:b003:l039","ordinal":153290,"en":"And say the renowned unfortunate woman"},{"id":"semetey-1-2013:p0998:b004:l001","ordinal":153291,"en":"Threw her people into turmoil."},{"id":"semetey-1-2013:p0998:b004:l002","ordinal":153292,"en":"They say that from the pass of Mediyan,"},{"id":"semetey-1-2013:p0998:b004:l003","ordinal":153293,"en":"From the place where the fairy played,"},{"id":"semetey-1-2013:p0998:b004:l004","ordinal":153294,"en":"The noble hero Akun,"},{"id":"semetey-1-2013:p0998:b004:l005","ordinal":153295,"en":"Taking eighty wrestlers as attendants,"},{"id":"semetey-1-2013:p0998:b004:l006","ordinal":153296,"en":"While he was out hunting,"},{"id":"semetey-1-2013:p0998:b004:l007","ordinal":153297,"en":"Found Churok there."},{"id":"semetey-1-2013:p0998:b004:l008","ordinal":153298,"en":"Her miraculous power was unlike all others,"},{"id":"semetey-1-2013:p0998:b004:l009","ordinal":153299,"en":"Proud-standing Churok, the noble champion."},{"id":"semetey-1-2013:p0998:b004:l010","ordinal":153300,"en":"That discerning sister-in-law of yours had learned,"},{"id":"semetey-1-2013:p0998:b004:l011","ordinal":153301,"en":"\"My tiger lord, my Bloodthirsty One,"},{"id":"semetey-1-2013:p0998:b004:l012","ordinal":153302,"en":"Must be coming,\" she had thought."},{"id":"semetey-1-2013:p0998:b004:l013","ordinal":153303,"en":"\"Driving his train behind him,"},{"id":"semetey-1-2013:p0998:b004:l014","ordinal":153304,"en":"Because of his longing for Akshunkar,"},{"id":"semetey-1-2013:p0998:b004:l015","ordinal":153305,"en":"If the tiger's ardor rises,"},{"id":"semetey-1-2013:p0998:b004:l016","ordinal":153306,"en":"He will reach Opol;"},{"id":"semetey-1-2013:p0998:b004:l017","ordinal":153307,"en":"If the tiger's ardor rises,"},{"id":"semetey-1-2013:p0998:b004:l018","ordinal":153308,"en":"He will pursue the matter to its very end.\""},{"id":"semetey-1-2013:p0998:b004:l019","ordinal":153309,"en":"From the beginning, everything she had done"},{"id":"semetey-1-2013:p0998:b004:l020","ordinal":153310,"en":"Had been done in preparation;"},{"id":"semetey-1-2013:p0998:b004:l021","ordinal":153311,"en":"Devastating Aychurok"},{"id":"semetey-1-2013:p0998:b004:l022","ordinal":153312,"en":"Had gone out to await"},{"id":"semetey-1-2013:p0998:b004:l023","ordinal":153313,"en":"Her rough lord and husband."},{"id":"semetey-1-2013:p0998:b004:l024","ordinal":153314,"en":"She heard reports from those who came,"},{"id":"semetey-1-2013:p0998:b004:l025","ordinal":153315,"en":"And listened closely to knowledgeable people;"},{"id":"semetey-1-2013:p0998:b004:l026","ordinal":153316,"en":"She heard them say, \"Semetey,"},{"id":"semetey-1-2013:p0998:b004:l027","ordinal":153317,"en":"Son of the Magnanimous Manas,"},{"id":"semetey-1-2013:p0998:b004:l028","ordinal":153318,"en":"Would die for liquor and women.\""},{"id":"semetey-1-2013:p0998:b004:l029","ordinal":153319,"en":"When Aychurok heard this,"},{"id":"semetey-1-2013:p0998:b004:l030","ordinal":153320,"en":"She gathered women and skilled craftswomen,"},{"id":"semetey-1-2013:p0998:b004:l031","ordinal":153321,"en":"And exceptionally beautiful maidens"},{"id":"semetey-1-2013:p0998:b004:l032","ordinal":153322,"en":"Who had brushed themselves with powder and rouge."},{"id":"semetey-1-2013:p0998:b004:l033","ordinal":153323,"en":"Within the city of Akun Khan,"},{"id":"semetey-1-2013:p0998:b004:l034","ordinal":153324,"en":"Without letting a single person know,"},{"id":"semetey-1-2013:p0998:b004:l035","ordinal":153325,"en":"Without letting a single person perceive it,"},{"id":"semetey-1-2013:p0998:b004:l036","ordinal":153326,"en":"She chose maidens from among the Afghans."},{"id":"semetey-1-2013:p0998:b004:l037","ordinal":153327,"en":"Aychurok did not hold back"},{"id":"semetey-1-2013:p0998:b004:l038","ordinal":153328,"en":"From the radiant, red-cheeked beauties,"},{"id":"semetey-1-2013:p0998:b004:l039","ordinal":153329,"en":"In crimson dresses with ribboned waists,"},{"id":"semetey-1-2013:p0999:b003:l001","ordinal":153330,"en":"From shimmering beauties,"},{"id":"semetey-1-2013:p0999:b003:l002","ordinal":153331,"en":"Each day she chose one of that kind;"},{"id":"semetey-1-2013:p0999:b003:l003","ordinal":153332,"en":"From a thousand maidens she chose one."},{"id":"semetey-1-2013:p0999:b003:l004","ordinal":153333,"en":"One cheerful and gifted in games,"},{"id":"semetey-1-2013:p0999:b003:l005","ordinal":153334,"en":"Who paced with a swaying, ambling gait,"},{"id":"semetey-1-2013:p0999:b003:l006","ordinal":153335,"en":"From those she chose one."},{"id":"semetey-1-2013:p0999:b003:l007","ordinal":153336,"en":"From those whose hair was braided splendidly,"},{"id":"semetey-1-2013:p0999:b003:l008","ordinal":153337,"en":"Who moved proudly among young men"},{"id":"semetey-1-2013:p0999:b003:l009","ordinal":153338,"en":"And had seen many kinds of pleasure,"},{"id":"semetey-1-2013:p0999:b003:l010","ordinal":153339,"en":"From the accomplished ones she chose one."},{"id":"semetey-1-2013:p0999:b003:l011","ordinal":153340,"en":"From those whose hair was braided with precision,"},{"id":"semetey-1-2013:p0999:b003:l012","ordinal":153341,"en":"Who had played often with young men,"},{"id":"semetey-1-2013:p0999:b003:l013","ordinal":153342,"en":"Were accomplished in every affair,"},{"id":"semetey-1-2013:p0999:b003:l014","ordinal":153343,"en":"And accustomed to answering every demand,"},{"id":"semetey-1-2013:p0999:b003:l015","ordinal":153344,"en":"She carefully chose one."}]
