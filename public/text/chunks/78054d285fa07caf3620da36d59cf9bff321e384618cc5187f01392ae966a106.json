[{"id":"manas-2010:p1208:b001:l037","ordinal":52481,"en":"Such was their longstanding custom."},{"id":"manas-2010:p1208:b001:l038","ordinal":52482,"en":"When the girls came crowding round,"},{"id":"manas-2010:p1208:b001:l039","ordinal":52483,"en":"Syrgak stood enthralled."},{"id":"manas-2010:p1208:b001:l040","ordinal":52484,"en":"Since Syrgak became a warrior,"},{"id":"manas-2010:p1208:b001:l041","ordinal":52485,"en":"Since he won the name Syrgak,"},{"id":"manas-2010:p1208:b001:l042","ordinal":52486,"en":"He had never come to the Chinese before,"},{"id":"manas-2010:p1209:b001:l001","ordinal":52487,"en":"Such lovely girls and young wives"},{"id":"manas-2010:p1209:b001:l002","ordinal":52488,"en":"He had never seen anywhere."},{"id":"manas-2010:p1209:b001:l003","ordinal":52489,"en":"Almambet before him,"},{"id":"manas-2010:p1209:b001:l004","ordinal":52490,"en":"Meeting the girls and young wives,"},{"id":"manas-2010:p1209:b001:l005","ordinal":52491,"en":"Embracing their necks and kissing,"},{"id":"manas-2010:p1209:b001:l006","ordinal":52492,"en":"When he spoke, no one knew his tongue."},{"id":"manas-2010:p1209:b001:l007","ordinal":52493,"en":"He began singing songs."},{"id":"manas-2010:p1209:b001:l008","ordinal":52494,"en":"Syrgak beside him,"},{"id":"manas-2010:p1209:b001:l009","ordinal":52495,"en":"“God has struck us again!” he said,"},{"id":"manas-2010:p1209:b001:l010","ordinal":52496,"en":"And began harboring suspicion."},{"id":"manas-2010:p1209:b001:l011","ordinal":52497,"en":"Then Syrgak thought this:"},{"id":"manas-2010:p1209:b001:l012","ordinal":52498,"en":"“Killing their lookout,"},{"id":"manas-2010:p1209:b001:l013","ordinal":52499,"en":"He must have meant to get through."},{"id":"manas-2010:p1209:b001:l014","ordinal":52500,"en":"Becoming Chinese again,"},{"id":"manas-2010:p1209:b001:l015","ordinal":52501,"en":"He must have meant to leave!"},{"id":"manas-2010:p1209:b001:l016","ordinal":52502,"en":"If his treachery is revealed,"},{"id":"manas-2010:p1209:b001:l017","ordinal":52503,"en":"Let me stalk and catch him from behind."},{"id":"manas-2010:p1209:b001:l018","ordinal":52504,"en":"Let me cut off your head,"},{"id":"manas-2010:p1209:b001:l019","ordinal":52505,"en":"Before magnanimous Manas"},{"id":"manas-2010:p1209:b001:l020","ordinal":52506,"en":"Let me bring it back!”"},{"id":"manas-2010:p1209:b001:l021","ordinal":52507,"en":"Thus warrior Syrgak,"},{"id":"manas-2010:p1209:b001:l022","ordinal":52508,"en":"As he followed behind him,"},{"id":"manas-2010:p1209:b001:l023","ordinal":52509,"en":"A separate group of governors-general's daughters,"},{"id":"manas-2010:p1209:b001:l024","ordinal":52510,"en":"There were beauties in group after group."},{"id":"manas-2010:p1209:b001:l025","ordinal":52511,"en":"Upon Syrgak, newly arrived,"},{"id":"manas-2010:p1209:b001:l026","ordinal":52512,"en":"They all surged and crowded."},{"id":"manas-2010:p1209:b001:l027","ordinal":52513,"en":"Not letting a single one approach him,"},{"id":"manas-2010:p1209:b001:l028","ordinal":52514,"en":"Warrior Syrgak, the young fellow,"},{"id":"manas-2010:p1209:b001:l029","ordinal":52515,"en":"Made ready with his battle-axe."},{"id":"manas-2010:p1209:b001:l030","ordinal":52516,"en":"When they saw Syrgak's look,"},{"id":"manas-2010:p1209:b001:l031","ordinal":52517,"en":"The soft-eyed beauties"},{"id":"manas-2010:p1209:b001:l032","ordinal":52518,"en":"Drew back, swaying."},{"id":"manas-2010:p1209:b001:l033","ordinal":52519,"en":"Young Syrgak, the renowned one,"},{"id":"manas-2010:p1209:b001:l034","ordinal":52520,"en":"He was a soul unlike others."},{"id":"manas-2010:p1209:b001:l035","ordinal":52521,"en":"Seeing the girls, he paid no heed,"},{"id":"manas-2010:p1209:b001:l036","ordinal":52522,"en":"Did not value them as much as his trouser leg."},{"id":"manas-2010:p1209:b001:l037","ordinal":52523,"en":"Drawing back, the many girls"},{"id":"manas-2010:p1209:b001:l038","ordinal":52524,"en":"Spoke ill of Syrgak,"},{"id":"manas-2010:p1209:b001:l039","ordinal":52525,"en":"Cursing in Chinese,"},{"id":"manas-2010:p1209:b001:l040","ordinal":52526,"en":"Talking in murmurs,"},{"id":"manas-2010:p1209:b001:l041","ordinal":52527,"en":"They stood insulting him then."},{"id":"manas-2010:p1209:b001:l042","ordinal":52528,"en":"Syrgak stood glaring fiercely,"},{"id":"manas-2010:p1210:b001:l001","ordinal":52529,"en":"“Following the half-khan,"},{"id":"manas-2010:p1210:b001:l002","ordinal":52530,"en":"The madman who came,” they said,"},{"id":"manas-2010:p1210:b001:l003","ordinal":52531,"en":"Mocking and laughing,"},{"id":"manas-2010:p1210:b001:l004","ordinal":52532,"en":"The girls stood speaking ill of him."},{"id":"manas-2010:p1210:b001:l005","ordinal":52533,"en":"Esenkan's gateway,"},{"id":"manas-2010:p1210:b001:l006","ordinal":52534,"en":"Its doorway stood deserted."},{"id":"manas-2010:p1210:b001:l007","ordinal":52535,"en":"Not one of the sentries was there,"},{"id":"manas-2010:p1210:b001:l008","ordinal":52536,"en":"Not a single person guarding it."},{"id":"manas-2010:p1210:b001:l009","ordinal":52537,"en":"To reach Burulcha,"},{"id":"manas-2010:p1210:b001:l010","ordinal":52538,"en":"To greet her before going,"},{"id":"manas-2010:p1210:b001:l011","ordinal":52539,"en":"His two eyes became four."},{"id":"manas-2010:p1210:b001:l012","ordinal":52540,"en":"His insides filled with fire."},{"id":"manas-2010:p1210:b001:l013","ordinal":52541,"en":"Like Kükük and Zeynep,"},{"id":"manas-2010:p1210:b001:l014","ordinal":52542,"en":"Unable to meet, he ached."},{"id":"manas-2010:p1210:b001:l015","ordinal":52543,"en":"While it was thus,"},{"id":"manas-2010:p1210:b001:l016","ordinal":52544,"en":"A great fortress built high,"},{"id":"manas-2010:p1210:b001:l017","ordinal":52545,"en":"From the palace in the great fortress,"},{"id":"manas-2010:p1210:b001:l018","ordinal":52546,"en":"Esenkan's Burulcha,"},{"id":"manas-2010:p1210:b001:l019","ordinal":52547,"en":"When she saw Almambet,"},{"id":"manas-2010:p1210:b001:l020","ordinal":52548,"en":"Lost her senses, trembling."},{"id":"manas-2010:p1210:b001:l021","ordinal":52549,"en":"Her whole body melted,"},{"id":"manas-2010:p1210:b001:l022","ordinal":52550,"en":"She gazed helplessly."},{"id":"manas-2010:p1210:b001:l023","ordinal":52551,"en":"Tears flowed from both eyes,"},{"id":"manas-2010:p1210:b001:l024","ordinal":52552,"en":"Too weak to walk."},{"id":"manas-2010:p1210:b001:l025","ordinal":52553,"en":"Burulcha's slender grace"},{"id":"manas-2010:p1210:b001:l026","ordinal":52554,"en":"Was like a smoothly grown willow."},{"id":"manas-2010:p1210:b001:l027","ordinal":52555,"en":"Her plane-tree stature swayed,"},{"id":"manas-2010:p1210:b001:l028","ordinal":52556,"en":"Like Esenkan's garden."},{"id":"manas-2010:p1210:b001:l029","ordinal":52557,"en":"If snow falls upon the black earth,"},{"id":"manas-2010:p1210:b001:l030","ordinal":52558,"en":"Look at the snow, then at her flesh."},{"id":"manas-2010:p1210:b001:l031","ordinal":52559,"en":"If blood drips upon the snow,"},{"id":"manas-2010:p1210:b001:l032","ordinal":52560,"en":"Look at the blood, then at her face."},{"id":"manas-2010:p1210:b001:l033","ordinal":52561,"en":"When he saw Burulcha,"},{"id":"manas-2010:p1210:b001:l034","ordinal":52562,"en":"Your Alma could not stay still, overcome."},{"id":"manas-2010:p1210:b001:l035","ordinal":52563,"en":"Sarala beneath him,"},{"id":"manas-2010:p1210:b001:l036","ordinal":52564,"en":"He had warrior Syrgak hold him."},{"id":"manas-2010:p1210:b001:l037","ordinal":52565,"en":"Azizkan's only son,"},{"id":"manas-2010:p1210:b001:l038","ordinal":52566,"en":"His morning-star eyes shining,"},{"id":"manas-2010:p1210:b001:l039","ordinal":52567,"en":"The gear upon his body jingling,"},{"id":"manas-2010:p1210:b001:l040","ordinal":52568,"en":"Bracing one side,"},{"id":"manas-2010:p1210:b001:l041","ordinal":52569,"en":"Leaning upon his sword,"},{"id":"manas-2010:p1210:b001:l042","ordinal":52570,"en":"His neck upright like a rooster's,"},{"id":"manas-2010:p1211:b001:l001","ordinal":52571,"en":"He walked into the palace."},{"id":"manas-2010:p1211:b001:l002","ordinal":52572,"en":"Warrior Almambet, resplendent,"},{"id":"manas-2010:p1211:b001:l003","ordinal":52573,"en":"Esenkan's daughter Burulcha,"},{"id":"manas-2010:p1211:b001:l004","ordinal":52574,"en":"Taking her hand in greeting,"},{"id":"manas-2010:p1211:b001:l005","ordinal":52575,"en":"Embracing her closely,"},{"id":"manas-2010:p1211:b001:l006","ordinal":52576,"en":"He stood breathing the scent of her neck."},{"id":"manas-2010:p1211:b001:l007","ordinal":52577,"en":"“Did you reach the Muslims safely?"},{"id":"manas-2010:p1211:b001:l008","ordinal":52578,"en":"Did you remember me?"},{"id":"manas-2010:p1211:b001:l009","ordinal":52579,"en":"For so many years, no word:"},{"id":"manas-2010:p1211:b001:l010","ordinal":52580,"en":"You plunged me into hardship!"},{"id":"manas-2010:p1211:b001:l011","ordinal":52581,"en":"Did you return before this"},{"id":"manas-2010:p1211:b001:l012","ordinal":52582,"en":"And scout Beijing?"},{"id":"manas-2010:p1211:b001:l013","ordinal":52583,"en":"Did you consult Manas?"},{"id":"manas-2010:p1211:b001:l014","ordinal":52584,"en":"Without consulting Manas,"},{"id":"manas-2010:p1211:b001:l015","ordinal":52585,"en":"What are you, giving no word?"},{"id":"manas-2010:p1211:b001:l016","ordinal":52586,"en":"‘My lifelong friend,’ I said,"},{"id":"manas-2010:p1211:b001:l017","ordinal":52587,"en":"‘When will Almambet come?’ I said."},{"id":"manas-2010:p1211:b001:l018","ordinal":52588,"en":"To the teeming Chinese people"},{"id":"manas-2010:p1211:b001:l019","ordinal":52589,"en":"What was I, giving no answer?"},{"id":"manas-2010:p1211:b001:l020","ordinal":52590,"en":"You were a son of light,"},{"id":"manas-2010:p1211:b001:l021","ordinal":52591,"en":"Bearing much worry and grief,"},{"id":"manas-2010:p1211:b001:l022","ordinal":52592,"en":"Looking with longing beyond Beijing,"},{"id":"manas-2010:p1211:b001:l023","ordinal":52593,"en":"‘When will Almambet come?’"},{"id":"manas-2010:p1211:b001:l024","ordinal":52594,"en":"I was the one who burned.”"},{"id":"manas-2010:p1211:b001:l025","ordinal":52595,"en":"Then your Alma said this:"},{"id":"manas-2010:p1211:b001:l026","ordinal":52596,"en":"“When turmoil was brought upon the people,"},{"id":"manas-2010:p1211:b001:l027","ordinal":52597,"en":"To seize you and take you away,"},{"id":"manas-2010:p1211:b001:l028","ordinal":52598,"en":"I had no strength to gird myself."},{"id":"manas-2010:p1211:b001:l029","ordinal":52599,"en":"Behind me, to give me support,"},{"id":"manas-2010:p1211:b001:l030","ordinal":52600,"en":"When I fled this place,"},{"id":"manas-2010:p1211:b001:l031","ordinal":52601,"en":"I had no lion Manas behind me."},{"id":"manas-2010:p1211:b001:l032","ordinal":52602,"en":"I had a patterned reed screen woven."},{"id":"manas-2010:p1211:b001:l033","ordinal":52603,"en":"I left without turning back to you."},{"id":"manas-2010:p1211:b001:l034","ordinal":52604,"en":"My mother, at that time,"},{"id":"manas-2010:p1211:b001:l035","ordinal":52605,"en":"I lost to the Chinese upon the road."},{"id":"manas-2010:p1211:b001:l036","ordinal":52606,"en":"‘If I reach the Burut safely,"},{"id":"manas-2010:p1211:b001:l037","ordinal":52607,"en":"I shall find her bones,’ I said."},{"id":"manas-2010:p1211:b001:l038","ordinal":52608,"en":"‘Joining with the lion,"},{"id":"manas-2010:p1211:b001:l039","ordinal":52609,"en":"With a people, against the realm with a royal court,"},{"id":"manas-2010:p1211:b001:l040","ordinal":52610,"en":"Returning to Beijing,"},{"id":"manas-2010:p1211:b001:l041","ordinal":52611,"en":"I shall wreak a fierce slaughter,’ I said."},{"id":"manas-2010:p1211:b001:l042","ordinal":52612,"en":"‘God willing, Burulcha,"},{"id":"manas-2010:p1212:b001:l001","ordinal":52613,"en":"Then I shall take you,’ I said."},{"id":"manas-2010:p1212:b001:l002","ordinal":52614,"en":"When I went to the Burut,"},{"id":"manas-2010:p1212:b001:l003","ordinal":52615,"en":"What I saw was a bright night."},{"id":"manas-2010:p1212:b001:l004","ordinal":52616,"en":"Twelve khans, the many Kyrgyz,"},{"id":"manas-2010:p1212:b001:l005","ordinal":52617,"en":"Khan Manas in their midst,"},{"id":"manas-2010:p1212:b001:l006","ordinal":52618,"en":"Leading that army,"},{"id":"manas-2010:p1212:b001:l007","ordinal":52619,"en":"I, Azizkan's Alma,"},{"id":"manas-2010:p1212:b001:l008","ordinal":52620,"en":"This coming of mine, dear Bükösh,"},{"id":"manas-2010:p1212:b001:l009","ordinal":52621,"en":"If not for you, for whom is it?"},{"id":"manas-2010:p1212:b001:l010","ordinal":52622,"en":"Against fortified Beijing,"},{"id":"manas-2010:p1212:b001:l011","ordinal":52623,"en":"‘I shall advance and wreak slaughter,’ I said."},{"id":"manas-2010:p1212:b001:l012","ordinal":52624,"en":"My mind was set, my Bükösh!"},{"id":"manas-2010:p1212:b001:l013","ordinal":52625,"en":"Steady camel-calf eyes,"},{"id":"manas-2010:p1212:b001:l014","ordinal":52626,"en":"‘I shall seize you from your place of honor,’ I said."},{"id":"manas-2010:p1212:b001:l015","ordinal":52627,"en":"When I went to Manas,"},{"id":"manas-2010:p1212:b001:l016","ordinal":52628,"en":"Of the Burut living freely,"},{"id":"manas-2010:p1212:b001:l017","ordinal":52629,"en":"How could I occupy their throne?"},{"id":"manas-2010:p1212:b001:l018","ordinal":52630,"en":"When hardship pressed upon me,"},{"id":"manas-2010:p1212:b001:l019","ordinal":52631,"en":"You standing, weeping and crying out,"},{"id":"manas-2010:p1212:b001:l020","ordinal":52632,"en":"How could I go without remembering, Bükösh!”"},{"id":"manas-2010:p1212:b001:l021","ordinal":52633,"en":"Saying this, Almambet"},{"id":"manas-2010:p1212:b001:l022","ordinal":52634,"en":"Did not sink into pleasures."},{"id":"manas-2010:p1212:b001:l023","ordinal":52635,"en":"“It would bring ill luck on the journey,” he said."},{"id":"manas-2010:p1212:b001:l024","ordinal":52636,"en":"He did not unfasten his belt and lie down."},{"id":"manas-2010:p1212:b001:l025","ordinal":52637,"en":"Cherishing her precious soul,"},{"id":"manas-2010:p1212:b001:l026","ordinal":52638,"en":"Dozing now and then,"},{"id":"manas-2010:p1212:b001:l027","ordinal":52639,"en":"A golden-cheeked battle-axe,"},{"id":"manas-2010:p1212:b001:l028","ordinal":52640,"en":"Leaning his temple upon it,"},{"id":"manas-2010:p1212:b001:l029","ordinal":52641,"en":"The brim of his black felt hat,"},{"id":"manas-2010:p1212:b001:l030","ordinal":52642,"en":"His Syrgak holding the horses,"},{"id":"manas-2010:p1212:b001:l031","ordinal":52643,"en":"A battle-axe forged sharp,"},{"id":"manas-2010:p1212:b001:l032","ordinal":52644,"en":"He swung with a mighty grip."},{"id":"manas-2010:p1212:b001:l033","ordinal":52645,"en":"The side wall where Almambet rested,"},{"id":"manas-2010:p1212:b001:l034","ordinal":52646,"en":"He struck and split it open."},{"id":"manas-2010:p1212:b001:l035","ordinal":52647,"en":"“Almambet!” he shouted."},{"id":"manas-2010:p1212:b001:l036","ordinal":52648,"en":"Syrgak cried out:"},{"id":"manas-2010:p1212:b001:l037","ordinal":52649,"en":"“My beloved Almambet,"},{"id":"manas-2010:p1212:b001:l038","ordinal":52650,"en":"Is this a garden planted in Talas?"},{"id":"manas-2010:p1212:b001:l039","ordinal":52651,"en":"To lie laughing and playing,"},{"id":"manas-2010:p1212:b001:l040","ordinal":52652,"en":"Fermented mare's milk by day, girls by night,"},{"id":"manas-2010:p1212:b001:l041","ordinal":52653,"en":"Is this the time we had in Talas?"},{"id":"manas-2010:p1212:b001:l042","ordinal":52654,"en":"In a valley full of tamarisks,"},{"id":"manas-2010:p1213:b001:l001","ordinal":52655,"en":"Along the great Keng-Kol,"},{"id":"manas-2010:p1213:b001:l002","ordinal":52656,"en":"Is there a throne to mount without reproach?!"},{"id":"manas-2010:p1213:b001:l003","ordinal":52657,"en":"Do your hips not tire from lying down?"},{"id":"manas-2010:p1213:b001:l004","ordinal":52658,"en":"A red dress, a ribbon waist,"},{"id":"manas-2010:p1213:b001:l005","ordinal":52659,"en":"Burulcha, lovelier than other girls,"},{"id":"manas-2010:p1213:b001:l006","ordinal":52660,"en":"While you lie laughing and playing,"},{"id":"manas-2010:p1213:b001:l007","ordinal":52661,"en":"The lookout at the gate,"},{"id":"manas-2010:p1213:b001:l008","ordinal":52662,"en":"The sentries standing guard,"},{"id":"manas-2010:p1213:b001:l009","ordinal":52663,"en":"Will they not close the gateway?!"},{"id":"manas-2010:p1213:b001:l010","ordinal":52664,"en":"Biting our lips tight,"},{"id":"manas-2010:p1213:b001:l011","ordinal":52665,"en":"In the Chinese people's hands,"},{"id":"manas-2010:p1213:b001:l012","ordinal":52666,"en":"Will Almambet and Syrgak not remain?!"},{"id":"manas-2010:p1213:b001:l013","ordinal":52667,"en":"‘Wrapping on his battle-skirt,"},{"id":"manas-2010:p1213:b001:l014","ordinal":52668,"en":"A courser for Beijing to ride,’ they will say."},{"id":"manas-2010:p1213:b001:l015","ordinal":52669,"en":"‘Donning his leather trousers,"},{"id":"manas-2010:p1213:b001:l016","ordinal":52670,"en":"A courser for a governor to ride,’ they will say."},{"id":"manas-2010:p1213:b001:l017","ordinal":52671,"en":"The three noble steeds we rode here,"},{"id":"manas-2010:p1213:b001:l018","ordinal":52672,"en":"Will the Chinese not take them as booty?!”"},{"id":"manas-2010:p1213:b001:l019","ordinal":52673,"en":"When your Alma heard this,"},{"id":"manas-2010:p1213:b001:l020","ordinal":52674,"en":"A lion surpassing other men,"},{"id":"manas-2010:p1213:b001:l021","ordinal":52675,"en":"Having seen much fighting in Beijing,"},{"id":"manas-2010:p1213:b001:l022","ordinal":52676,"en":"The dear warrior had become an expert."},{"id":"manas-2010:p1213:b001:l023","ordinal":52677,"en":"Grasping his battle-axe firmly,"},{"id":"manas-2010:p1213:b001:l024","ordinal":52678,"en":"He sprang up tautly."},{"id":"manas-2010:p1213:b001:l025","ordinal":52679,"en":"Esenkan's Burulcha,"},{"id":"manas-2010:p1213:b001:l026","ordinal":52680,"en":"Ay Jangjung's daughter Birmyskal,"},{"id":"manas-2010:p1213:b001:l027","ordinal":52681,"en":"“To the lion warrior Manas,"},{"id":"manas-2010:p1213:b001:l028","ordinal":52682,"en":"Take a gift,” they said,"},{"id":"manas-2010:p1213:b001:l029","ordinal":52683,"en":"Springing up, crying out."},{"id":"manas-2010:p1213:b001:l030","ordinal":52684,"en":"“Raid the horses and take them with you."},{"id":"manas-2010:p1213:b001:l031","ordinal":52685,"en":"‘Your beloved was left grieving,’ say."},{"id":"manas-2010:p1213:b001:l032","ordinal":52686,"en":"Keep us firmly in your heart."},{"id":"manas-2010:p1213:b001:l033","ordinal":52687,"en":"I have given an object as a gift;"},{"id":"manas-2010:p1213:b001:l034","ordinal":52688,"en":"Put it in the pouch at your side."},{"id":"manas-2010:p1213:b001:l035","ordinal":52689,"en":"If you do not give it to Khan Manas,"},{"id":"manas-2010:p1213:b001:l036","ordinal":52690,"en":"If you do not see my tears,"},{"id":"manas-2010:p1213:b001:l037","ordinal":52691,"en":"If you do not return to Beijing,"},{"id":"manas-2010:p1213:b001:l038","ordinal":52692,"en":"I shall shoe my white-gray horse."},{"id":"manas-2010:p1213:b001:l039","ordinal":52693,"en":"‘Bear your oath yourself,’ I shall say."},{"id":"manas-2010:p1213:b001:l040","ordinal":52694,"en":"Then I shall seize you by the collar."},{"id":"manas-2010:p1213:b001:l041","ordinal":52695,"en":"If you take me, I am saved, my Alma."},{"id":"manas-2010:p1213:b001:l042","ordinal":52696,"en":"If you leave Beijing unable to take me,"},{"id":"manas-2010:p1214:b001:l001","ordinal":52697,"en":"Passing my life alone, without marrying,"},{"id":"manas-2010:p1214:b001:l002","ordinal":52698,"en":"Thinking of you, I shall die, my Alma!”"},{"id":"manas-2010:p1214:b001:l003","ordinal":52699,"en":"Clasping hands and bidding farewell,"},{"id":"manas-2010:p1214:b001:l004","ordinal":52700,"en":"Your Alma moved off briskly,"},{"id":"manas-2010:p1214:b001:l005","ordinal":52701,"en":"His sword jingling in its sheath,"},{"id":"manas-2010:p1214:b001:l006","ordinal":52702,"en":"Heading toward Kyr-Kayyng,"},{"id":"manas-2010:p1214:b001:l007","ordinal":52703,"en":"Almambet and Syrgak, the two warriors,"},{"id":"manas-2010:p1214:b001:l008","ordinal":52704,"en":"Set off resplendent."},{"id":"manas-2010:p1214:b001:l009","ordinal":52705,"en":"Lion Syrgak behind him:"},{"id":"manas-2010:p1214:b001:l010","ordinal":52706,"en":"“When shall I see the horses?”"},{"id":"manas-2010:p1214:b001:l011","ordinal":52707,"en":"This was Syrgak's longing."},{"id":"manas-2010:p1214:b001:l012","ordinal":52708,"en":"Along a winding stream,"},{"id":"manas-2010:p1214:b001:l013","ordinal":52709,"en":"Along a path no dog would prowl,"},{"id":"manas-2010:p1214:b001:l014","ordinal":52710,"en":"Known by name in Beijing,"},{"id":"manas-2010:p1214:b001:l015","ordinal":52711,"en":"Through the heights called Kyr-Kayyng,"},{"id":"manas-2010:p1214:b001:l016","ordinal":52712,"en":"When they reached those heights,"},{"id":"manas-2010:p1214:b001:l017","ordinal":52713,"en":"The eye could not take them all in."},{"id":"manas-2010:p1214:b001:l018","ordinal":52714,"en":"Teeming like ants,"},{"id":"manas-2010:p1214:b001:l019","ordinal":52715,"en":"One could not tell which was which."},{"id":"manas-2010:p1214:b001:l020","ordinal":52716,"en":"There were buildings to enclose them."},{"id":"manas-2010:p1214:b001:l021","ordinal":52717,"en":"Except that they were the unbelievers' livestock,"},{"id":"manas-2010:p1214:b001:l022","ordinal":52718,"en":"They were remarkable horses, living creatures."},{"id":"manas-2010:p1214:b001:l023","ordinal":52719,"en":"Among the herdsmen,"},{"id":"manas-2010:p1214:b001:l024","ordinal":52720,"en":"Sheerdey upon a bay stallion,"},{"id":"manas-2010:p1214:b001:l025","ordinal":52721,"en":"Zhangybay riding a stallion,"},{"id":"manas-2010:p1214:b001:l026","ordinal":52722,"en":"The chief herdsman Karagul,"},{"id":"manas-2010:p1214:b001:l027","ordinal":52723,"en":"There were two khans alike."},{"id":"manas-2010:p1214:b001:l028","ordinal":52724,"en":"“If we drive away the horses,"},{"id":"manas-2010:p1214:b001:l029","ordinal":52725,"en":"Making the broad salt flats thunder,"},{"id":"manas-2010:p1214:b001:l030","ordinal":52726,"en":"Keep it in mind, my Syrgak:"},{"id":"manas-2010:p1214:b001:l031","ordinal":52727,"en":"After the two herdsmen,"},{"id":"manas-2010:p1214:b001:l032","ordinal":52728,"en":"Kartküröng will lead along this road.”"},{"id":"manas-2010:p1214:b001:l033","ordinal":52729,"en":"Grasping the leading rope close,"},{"id":"manas-2010:p1214:b001:l034","ordinal":52730,"en":"Though Kartküröng was a beast,"},{"id":"manas-2010:p1214:b001:l035","ordinal":52731,"en":"With no tongue if he wished to speak,"},{"id":"manas-2010:p1214:b001:l036","ordinal":52732,"en":"Clearly entrusting the route to him,"},{"id":"manas-2010:p1214:b001:l037","ordinal":52733,"en":"Azhybay's Kartküröng,"},{"id":"manas-2010:p1214:b001:l038","ordinal":52734,"en":"When his years of maturity were counted,"},{"id":"manas-2010:p1214:b001:l039","ordinal":52735,"en":"Had reached sixty."},{"id":"manas-2010:p1214:b001:l040","ordinal":52736,"en":"The wind cannot catch his trot."}]
