[{"id":"semetey-1-2013:p1253:b003:l022","ordinal":171777,"en":"Did not fail to make ready either."},{"id":"semetey-1-2013:p1253:b003:l023","ordinal":171778,"en":"Army struck against army;"},{"id":"semetey-1-2013:p1253:b003:l024","ordinal":171779,"en":"Refusing to leave their people ungathered,"},{"id":"semetey-1-2013:p1253:b003:l025","ordinal":171780,"en":"Those advanced in years,"},{"id":"semetey-1-2013:p1253:b003:l026","ordinal":171781,"en":"Between fifty and sixty,"},{"id":"semetey-1-2013:p1253:b003:l027","ordinal":171782,"en":"Went into the middle ground."},{"id":"semetey-1-2013:p1253:b003:l028","ordinal":171783,"en":"There were khojas in white turbans"},{"id":"semetey-1-2013:p1253:b003:l029","ordinal":171784,"en":"As large as cauldrons,"},{"id":"semetey-1-2013:p1253:b003:l030","ordinal":171785,"en":"Whose shouts rang like the azan;"},{"id":"semetey-1-2013:p1253:b003:l031","ordinal":171786,"en":"There were mullahs in mottled robes."},{"id":"semetey-1-2013:p1253:b003:l032","ordinal":171787,"en":"Khoja and mullah took command,"},{"id":"semetey-1-2013:p1253:b003:l033","ordinal":171788,"en":"Gathering all their people together."},{"id":"semetey-1-2013:p1253:b003:l034","ordinal":171789,"en":"Khan Akun formed one division,"},{"id":"semetey-1-2013:p1253:b003:l035","ordinal":171790,"en":"And he too came out prepared,"},{"id":"semetey-1-2013:p1253:b003:l036","ordinal":171791,"en":"Taking troops of every age."},{"id":"semetey-1-2013:p1253:b003:l037","ordinal":171792,"en":"Tümönbai's force formed one division,"},{"id":"semetey-1-2013:p1253:b003:l038","ordinal":171793,"en":"Driving a vast, great army,"},{"id":"semetey-1-2013:p1253:b003:l039","ordinal":171794,"en":"Bringing forward in numbers"},{"id":"semetey-1-2013:p1253:b004:l001","ordinal":171795,"en":"The lions of the many Afghans."},{"id":"semetey-1-2013:p1253:b004:l002","ordinal":171796,"en":"Azhibai's force formed one division."},{"id":"semetey-1-2013:p1253:b004:l003","ordinal":171797,"en":"Their dust struck the sky;"},{"id":"semetey-1-2013:p1253:b004:l004","ordinal":171798,"en":"When the Zhediger engulfed them,"},{"id":"semetey-1-2013:p1253:b004:l005","ordinal":171799,"en":"The Afghan people gathered."},{"id":"semetey-1-2013:p1253:b004:l006","ordinal":171800,"en":"The black road seethed with dust,"},{"id":"semetey-1-2013:p1253:b004:l007","ordinal":171801,"en":"And people's heads reeled."},{"id":"semetey-1-2013:p1253:b004:l008","ordinal":171802,"en":"Many among the Afghan common folk,"},{"id":"semetey-1-2013:p1253:b004:l009","ordinal":171803,"en":"Like unbroken horses,"},{"id":"semetey-1-2013:p1253:b004:l010","ordinal":171804,"en":"Bucked about up and down."},{"id":"semetey-1-2013:p1253:b004:l011","ordinal":171805,"en":"Many went weeping, saying,"},{"id":"semetey-1-2013:p1253:b004:l012","ordinal":171806,"en":"\"Poor wives and young children"},{"id":"semetey-1-2013:p1253:b004:l013","ordinal":171807,"en":"Will all be killed.\""},{"id":"semetey-1-2013:p1253:b004:l014","ordinal":171808,"en":"Many trampled about, saying,"},{"id":"semetey-1-2013:p1253:b004:l015","ordinal":171809,"en":"\"These are people who have seen hell.\""},{"id":"semetey-1-2013:p1253:b004:l016","ordinal":171810,"en":"Many reviled Chürök,"},{"id":"semetey-1-2013:p1253:b004:l017","ordinal":171811,"en":"Saying, \"May hellish Chürök come to no good.\""},{"id":"semetey-1-2013:p1253:b004:l018","ordinal":171812,"en":"Many pondered Asan Kaigy-like grief,"},{"id":"semetey-1-2013:p1253:b004:l019","ordinal":171813,"en":"Thinking, \"Now we have been slaughtered,\""},{"id":"semetey-1-2013:p1253:b004:l020","ordinal":171814,"en":"And rushed about."},{"id":"semetey-1-2013:p1253:b004:l021","ordinal":171815,"en":"Despite their panic,"},{"id":"semetey-1-2013:p1253:b004:l022","ordinal":171816,"en":"They gathered them from the city,"},{"id":"semetey-1-2013:p1253:b004:l023","ordinal":171817,"en":"Good and bad mixed together,"},{"id":"semetey-1-2013:p1253:b004:l024","ordinal":171818,"en":"And assembled them all."},{"id":"semetey-1-2013:p1253:b004:l025","ordinal":171819,"en":"Khan Akun's gatekeeper,"},{"id":"semetey-1-2013:p1253:b004:l026","ordinal":171820,"en":"And the keeper under the gatekeeper,"},{"id":"semetey-1-2013:p1253:b004:l027","ordinal":171821,"en":"All mounted without exception."},{"id":"semetey-1-2013:p1253:b004:l028","ordinal":171822,"en":"The patrolmen and guards"},{"id":"semetey-1-2013:p1253:b004:l029","ordinal":171823,"en":"Also mounted without exception."},{"id":"semetey-1-2013:p1253:b004:l030","ordinal":171824,"en":"Thundering warriors"},{"id":"semetey-1-2013:p1253:b004:l031","ordinal":171825,"en":"And roaring heroes"},{"id":"semetey-1-2013:p1253:b004:l032","ordinal":171826,"en":"Mounted, not one remaining."},{"id":"semetey-1-2013:p1253:b004:l033","ordinal":171827,"en":"They mounted to gird themselves,"},{"id":"semetey-1-2013:p1253:b004:l034","ordinal":171828,"en":"To set their faces toward battle,"},{"id":"semetey-1-2013:p1253:b004:l035","ordinal":171829,"en":"And to die if death reached them;"},{"id":"semetey-1-2013:p1253:b004:l036","ordinal":171830,"en":"If their strength sufficed,"},{"id":"semetey-1-2013:p1253:b004:l037","ordinal":171831,"en":"To keep them from facing the Afghan city"},{"id":"semetey-1-2013:p1253:b004:l038","ordinal":171832,"en":"And defeat the Zhediger."},{"id":"semetey-1-2013:p1253:b004:l039","ordinal":171833,"en":"They stood facing one another,"},{"id":"semetey-1-2013:p1254:b003:l001","ordinal":171834,"en":"Firing guns and drawing bows,"},{"id":"semetey-1-2013:p1254:b003:l002","ordinal":171835,"en":"They fought in clashing combat,"},{"id":"semetey-1-2013:p1254:b003:l003","ordinal":171836,"en":"Dying when their death arrived,"},{"id":"semetey-1-2013:p1254:b003:l004","ordinal":171837,"en":"Meeting when all recourse was gone,"},{"id":"semetey-1-2013:p1254:b003:l005","ordinal":171838,"en":"Tearing at one another's muscles,"},{"id":"semetey-1-2013:p1254:b003:l006","ordinal":171839,"en":"Fighting without turning aside."},{"id":"semetey-1-2013:p1254:b003:l007","ordinal":171840,"en":"A great slaughter was about to occur;"},{"id":"semetey-1-2013:p1254:b003:l008","ordinal":171841,"en":"The strong who boasted of their might"},{"id":"semetey-1-2013:p1254:b003:l009","ordinal":171842,"en":"Were about to consume the powerless."},{"id":"semetey-1-2013:p1254:b003:l010","ordinal":171843,"en":"These two sides remained poised"},{"id":"semetey-1-2013:p1254:b003:l011","ordinal":171844,"en":"For a terrible slaughter."},{"id":"semetey-1-2013:p1254:b003:l012","ordinal":171845,"en":"The Afghan champions"},{"id":"semetey-1-2013:p1254:b003:l013","ordinal":171846,"en":"Encountered the Zhediger"},{"id":"semetey-1-2013:p1254:b003:l014","ordinal":171847,"en":"And now began the battle."},{"id":"semetey-1-2013:p1254:b003:l015","ordinal":171848,"en":"They had driven them behind them"},{"id":"semetey-1-2013:p1254:b003:l016","ordinal":171849,"en":"Because of their desire for Aichürök:"},{"id":"semetey-1-2013:p1254:b003:l017","ordinal":171850,"en":"The Afghans saying, \"We will not give Chürök,\""},{"id":"semetey-1-2013:p1254:b003:l018","ordinal":171851,"en":"And Toltoi of the Zhediger saying,"},{"id":"semetey-1-2013:p1254:b003:l019","ordinal":171852,"en":"\"I shall reach and seize Chürök,"},{"id":"semetey-1-2013:p1254:b003:l020","ordinal":171853,"en":"Even if she has gone into the earth.\""},{"id":"semetey-1-2013:p1254:b003:l021","ordinal":171854,"en":"His countless army made the earth sag."},{"id":"semetey-1-2013:p1254:b003:l022","ordinal":171855,"en":"Chynkojo, son of Shygai,"},{"id":"semetey-1-2013:p1254:b003:l023","ordinal":171856,"en":"Kojo, vigorous in his deeds,"},{"id":"semetey-1-2013:p1254:b003:l024","ordinal":171857,"en":"Was Kojo who walked in corrupt strife."},{"id":"semetey-1-2013:p1254:b003:l025","ordinal":171858,"en":"Kojo was a mountainlike hero,"},{"id":"semetey-1-2013:p1254:b003:l026","ordinal":171859,"en":"One of the damned."},{"id":"semetey-1-2013:p1254:b003:l027","ordinal":171860,"en":"He wickedly incited Toltoi,"},{"id":"semetey-1-2013:p1254:b003:l028","ordinal":171861,"en":"Had him drive his great people,"},{"id":"semetey-1-2013:p1254:b003:l029","ordinal":171862,"en":"And was the hero who brought them."},{"id":"semetey-1-2013:p1254:b003:l030","ordinal":171863,"en":"He engulfed them by force;"},{"id":"semetey-1-2013:p1254:b003:l031","ordinal":171864,"en":"The slaughter of the great people"},{"id":"semetey-1-2013:p1254:b003:l032","ordinal":171865,"en":"In the Afghan city"},{"id":"semetey-1-2013:p1254:b003:l033","ordinal":171866,"en":"Was Chynkojo's calamity."},{"id":"semetey-1-2013:p1254:b003:l034","ordinal":171867,"en":"Six forefathers before him had been khans;"},{"id":"semetey-1-2013:p1254:b003:l035","ordinal":171868,"en":"His strength reached across the world."},{"id":"semetey-1-2013:p1254:b003:l036","ordinal":171869,"en":"Manas and Chynkojo"},{"id":"semetey-1-2013:p1254:b003:l037","ordinal":171870,"en":"Were sons of brothers;"},{"id":"semetey-1-2013:p1254:b003:l038","ordinal":171871,"en":"Chynkojo's wound"},{"id":"semetey-1-2013:p1254:b003:l039","ordinal":171872,"en":"Would not heal in all the world."},{"id":"semetey-1-2013:p1254:b004:l001","ordinal":171873,"en":"Dear old Tölök"},{"id":"semetey-1-2013:p1254:b004:l002","ordinal":171874,"en":"Quarreled over what did not exist;"},{"id":"semetey-1-2013:p1254:b004:l003","ordinal":171875,"en":"Because of Chynkojo,"},{"id":"semetey-1-2013:p1254:b004:l004","ordinal":171876,"en":"All the people were being slaughtered."},{"id":"semetey-1-2013:p1254:b004:l005","ordinal":171877,"en":"He led the Zhediger."},{"id":"semetey-1-2013:p1254:b004:l006","ordinal":171878,"en":"Their lord named Chynkojo,"},{"id":"semetey-1-2013:p1254:b004:l007","ordinal":171879,"en":"Who had fled from Talas,"},{"id":"semetey-1-2013:p1254:b004:l008","ordinal":171880,"en":"Said he would seize"},{"id":"semetey-1-2013:p1254:b004:l009","ordinal":171881,"en":"The daughter-in-law of bloodthirsty Sultan Manas—"},{"id":"semetey-1-2013:p1254:b004:l010","ordinal":171882,"en":"Such was this infidel's corruption."},{"id":"semetey-1-2013:p1254:b004:l011","ordinal":171883,"en":"Chynkojo, son of Shygai,"},{"id":"semetey-1-2013:p1254:b004:l012","ordinal":171884,"en":"And their elder leader Tölöbai"},{"id":"semetey-1-2013:p1254:b004:l013","ordinal":171885,"en":"Had then driven"},{"id":"semetey-1-2013:p1254:b004:l014","ordinal":171886,"en":"All the Zhediger."},{"id":"semetey-1-2013:p1254:b004:l015","ordinal":171887,"en":"Kojo, son of Shygai,"},{"id":"semetey-1-2013:p1254:b004:l016","ordinal":171888,"en":"Was born a hero from the hearth,"},{"id":"semetey-1-2013:p1254:b004:l017","ordinal":171889,"en":"Surpassing many souls."},{"id":"semetey-1-2013:p1254:b004:l018","ordinal":171890,"en":"He was born equal in standing"},{"id":"semetey-1-2013:p1254:b004:l019","ordinal":171891,"en":"To oceanlike hero Manas."},{"id":"semetey-1-2013:p1254:b004:l020","ordinal":171892,"en":"Such was Kojo's condition:"},{"id":"semetey-1-2013:p1254:b004:l021","ordinal":171893,"en":"They were paternal kinsmen of equal rank."},{"id":"semetey-1-2013:p1254:b004:l022","ordinal":171894,"en":"Look at his savage conduct"},{"id":"semetey-1-2013:p1254:b004:l023","ordinal":171895,"en":"Toward lion hero Manas—"},{"id":"semetey-1-2013:p1254:b004:l024","ordinal":171896,"en":"Seeds of one wheat,"},{"id":"semetey-1-2013:p1254:b004:l025","ordinal":171897,"en":"Villages sharing one threshold,"},{"id":"semetey-1-2013:p1254:b004:l026","ordinal":171898,"en":"Their grandfathers closely united,"},{"id":"semetey-1-2013:p1254:b004:l027","ordinal":171899,"en":"Descendants from the same tip,"},{"id":"semetey-1-2013:p1254:b004:l028","ordinal":171900,"en":"Offspring from the same root,"},{"id":"semetey-1-2013:p1254:b004:l029","ordinal":171901,"en":"Sheep sharing one pen,"},{"id":"semetey-1-2013:p1254:b004:l030","ordinal":171902,"en":"Companions sharing one cauldron and meal,"},{"id":"semetey-1-2013:p1254:b004:l031","ordinal":171903,"en":"One in blood and heart,"},{"id":"semetey-1-2013:p1254:b004:l032","ordinal":171904,"en":"One in courage and arm."},{"id":"semetey-1-2013:p1254:b004:l033","ordinal":171905,"en":"Kojo forgot the spirit"},{"id":"semetey-1-2013:p1254:b004:l034","ordinal":171906,"en":"Of Manas, gone to the other world,"},{"id":"semetey-1-2013:p1254:b004:l035","ordinal":171907,"en":"And attacked the in-laws"},{"id":"semetey-1-2013:p1254:b004:l036","ordinal":171908,"en":"Of the princely son of Manas;"},{"id":"semetey-1-2013:p1254:b004:l037","ordinal":171909,"en":"He drove forth an upheaval"},{"id":"semetey-1-2013:p1254:b004:l038","ordinal":171910,"en":"And slaughtered the great people."},{"id":"semetey-1-2013:p1254:b004:l039","ordinal":171911,"en":"His Kara At, born for him to ride,"},{"id":"semetey-1-2013:p1255:b003:l001","ordinal":171912,"en":"Was a thoroughbred that seemed to fly."},{"id":"semetey-1-2013:p1255:b003:l002","ordinal":171913,"en":"Ruinous Kojo would come to no good,"},{"id":"semetey-1-2013:p1255:b003:l003","ordinal":171914,"en":"Though he was Semetey's kinsman;"},{"id":"semetey-1-2013:p1255:b003:l004","ordinal":171915,"en":"He gathered a great Black army"},{"id":"semetey-1-2013:p1255:b003:l005","ordinal":171916,"en":"And engulfed them in battle,"},{"id":"semetey-1-2013:p1255:b003:l006","ordinal":171917,"en":"Having turned black with rage,"},{"id":"semetey-1-2013:p1255:b003:l007","ordinal":171918,"en":"To seize the wife"},{"id":"semetey-1-2013:p1255:b003:l008","ordinal":171919,"en":"Of hero Khan Semetey."},{"id":"semetey-1-2013:p1255:b003:l009","ordinal":171920,"en":"Toltoi inflicted violence;"},{"id":"semetey-1-2013:p1255:b003:l010","ordinal":171921,"en":"By making war on Semetey,"},{"id":"semetey-1-2013:p1255:b003:l011","ordinal":171922,"en":"Chynkojo inflicted humiliation."},{"id":"semetey-1-2013:p1255:b003:l012","ordinal":171923,"en":"The peoples of the world gathered;"},{"id":"semetey-1-2013:p1255:b003:l013","ordinal":171924,"en":"Because of Chynkojo and Toltoi,"},{"id":"semetey-1-2013:p1255:b003:l014","ordinal":171925,"en":"Innocent, meek people were slaughtered."},{"id":"semetey-1-2013:p1255:b003:l015","ordinal":171926,"en":"Khan Akun was no feeble khan;"},{"id":"semetey-1-2013:p1255:b003:l016","ordinal":171927,"en":"Azhibai and Tümönbai"},{"id":"semetey-1-2013:p1255:b003:l017","ordinal":171928,"en":"Were not souls who would simply perish."},{"id":"semetey-1-2013:p1255:b003:l018","ordinal":171929,"en":"Where he cast his gaze was red fire;"},{"id":"semetey-1-2013:p1255:b003:l019","ordinal":171930,"en":"Semetey was no ordinary child."},{"id":"semetey-1-2013:p1255:b003:l020","ordinal":171931,"en":"When he saw the engulfing army,"},{"id":"semetey-1-2013:p1255:b003:l021","ordinal":171932,"en":"Azhibai, son of Azhy,"},{"id":"semetey-1-2013:p1255:b003:l022","ordinal":171933,"en":"Flew like an arrow,"},{"id":"semetey-1-2013:p1255:b003:l023","ordinal":171934,"en":"Hurrying and stumbling onward."},{"id":"semetey-1-2013:p1255:b003:l024","ordinal":171935,"en":"Aichürök's white palace"},{"id":"semetey-1-2013:p1255:b003:l025","ordinal":171936,"en":"Was ringed by a fortress wall,"},{"id":"semetey-1-2013:p1255:b003:l026","ordinal":171937,"en":"Surpassing in its splendor;"},{"id":"semetey-1-2013:p1255:b003:l027","ordinal":171938,"en":"Emil and Ezhibai"},{"id":"semetey-1-2013:p1255:b003:l028","ordinal":171939,"en":"Were guards at its door."},{"id":"semetey-1-2013:p1255:b003:l029","ordinal":171940,"en":"Passing among the guards"},{"id":"semetey-1-2013:p1255:b003:l030","ordinal":171941,"en":"And seeking Semetey's protection,"},{"id":"semetey-1-2013:p1255:b003:l031","ordinal":171942,"en":"When dawn shone white"},{"id":"semetey-1-2013:p1255:b003:l032","ordinal":171943,"en":"And light touched the earth,"},{"id":"semetey-1-2013:p1255:b003:l033","ordinal":171944,"en":"He went to the pavilion in the palace"},{"id":"semetey-1-2013:p1255:b003:l034","ordinal":171945,"en":"And brought news"},{"id":"semetey-1-2013:p1255:b003:l035","ordinal":171946,"en":"To hero Semetey."},{"id":"semetey-1-2013:p1255:b003:l036","ordinal":171947,"en":"His knee bent to the ground"},{"id":"semetey-1-2013:p1255:b003:l037","ordinal":171948,"en":"As he ran in panic."},{"id":"semetey-1-2013:p1255:b003:l038","ordinal":171949,"en":"The young hero, son of Manas,"},{"id":"semetey-1-2013:p1255:b003:l039","ordinal":171950,"en":"Dipped his hands in water"},{"id":"semetey-1-2013:p1255:b004:l001","ordinal":171951,"en":"And performed the hand ablution;"},{"id":"semetey-1-2013:p1255:b004:l002","ordinal":171952,"en":"He hurriedly recited the prayer,"},{"id":"semetey-1-2013:p1255:b004:l003","ordinal":171953,"en":"Saddled Taibuurul,"},{"id":"semetey-1-2013:p1255:b004:l004","ordinal":171954,"en":"And set his arms and armor in order."},{"id":"semetey-1-2013:p1255:b004:l005","ordinal":171955,"en":"He gathered himself like a black tiger;"},{"id":"semetey-1-2013:p1255:b004:l006","ordinal":171956,"en":"Like a cloud about to rain again,"},{"id":"semetey-1-2013:p1255:b004:l007","ordinal":171957,"en":"Wrath spread across his face."},{"id":"semetey-1-2013:p1255:b004:l008","ordinal":171958,"en":"He girded on Zulfiqar,"},{"id":"semetey-1-2013:p1255:b004:l009","ordinal":171959,"en":"Inherited from Manas."},{"id":"semetey-1-2013:p1255:b004:l010","ordinal":171960,"en":"Grieving over Chynkojo,"},{"id":"semetey-1-2013:p1255:b004:l011","ordinal":171961,"en":"He put on Akolpok,"},{"id":"semetey-1-2013:p1255:b004:l012","ordinal":171962,"en":"Slung on Zhazyiyl,"},{"id":"semetey-1-2013:p1255:b004:l013","ordinal":171963,"en":"And prayed to the Creator."},{"id":"semetey-1-2013:p1255:b004:l014","ordinal":171964,"en":"Smoldering anew whenever depleted,"},{"id":"semetey-1-2013:p1255:b004:l015","ordinal":171965,"en":"Growing stronger from the root,"},{"id":"semetey-1-2013:p1255:b004:l016","ordinal":171966,"en":"Such was Manas's deep-rooted line."},{"id":"semetey-1-2013:p1255:b004:l017","ordinal":171967,"en":"Increasing whenever one of them died,"},{"id":"semetey-1-2013:p1255:b004:l018","ordinal":171968,"en":"Such was Manas's ruling line."},{"id":"semetey-1-2013:p1255:b004:l019","ordinal":171969,"en":"Semetey took after Manas;"},{"id":"semetey-1-2013:p1255:b004:l020","ordinal":171970,"en":"Semetey wore"},{"id":"semetey-1-2013:p1255:b004:l021","ordinal":171971,"en":"A blue lynx-fur cap."},{"id":"semetey-1-2013:p1255:b004:l022","ordinal":171972,"en":"He grew wrathful at Kojo,"},{"id":"semetey-1-2013:p1255:b004:l023","ordinal":171973,"en":"As though he had no wife."},{"id":"semetey-1-2013:p1255:b004:l024","ordinal":171974,"en":"With a face like oiled wheat,"},{"id":"semetey-1-2013:p1255:b004:l025","ordinal":171975,"en":"With eyes like twilight mist,"},{"id":"semetey-1-2013:p1255:b004:l026","ordinal":171976,"en":"He was offspring of the brave."},{"id":"semetey-1-2013:p1255:b004:l027","ordinal":171977,"en":"When the inherited fervor"},{"id":"semetey-1-2013:p1255:b004:l028","ordinal":171978,"en":"Of his fathers and grandfathers seized him,"},{"id":"semetey-1-2013:p1255:b004:l029","ordinal":171979,"en":"He burned fortified cities."},{"id":"semetey-1-2013:p1255:b004:l030","ordinal":171980,"en":"When enemies pressed together,"},{"id":"semetey-1-2013:p1255:b004:l031","ordinal":171981,"en":"He never opened his flank in fear."},{"id":"semetey-1-2013:p1255:b004:l032","ordinal":171982,"en":"Whoever grappled with him,"},{"id":"semetey-1-2013:p1255:b004:l033","ordinal":171983,"en":"He crushed into the ground like a hare."},{"id":"semetey-1-2013:p1255:b004:l034","ordinal":171984,"en":"He subdued the enemy he faced;"},{"id":"semetey-1-2013:p1255:b004:l035","ordinal":171985,"en":"No enemy dared come out"},{"id":"semetey-1-2013:p1255:b004:l036","ordinal":171986,"en":"To face the valiant hero."},{"id":"semetey-1-2013:p1255:b004:l037","ordinal":171987,"en":"When an enemy did face him,"},{"id":"semetey-1-2013:p1255:b004:l038","ordinal":171988,"en":"He drenched his sword in blood."},{"id":"semetey-1-2013:p1255:b004:l039","ordinal":171989,"en":"No mortal defeated him face-to-face,"},{"id":"semetey-1-2013:p1256:b003:l001","ordinal":171990,"en":"Let alone any kinsman, the wretch"},{"id":"semetey-1-2013:p1256:b003:l002","ordinal":171991,"en":"Gave no quarter even to"},{"id":"semetey-1-2013:p1256:b003:l003","ordinal":171992,"en":"Kakanchin's Great Beijing."},{"id":"semetey-1-2013:p1256:b003:l004","ordinal":171993,"en":"His bearing was formidable, his venom strong;"},{"id":"semetey-1-2013:p1256:b003:l005","ordinal":171994,"en":"He laid flat whoever grappled with him."},{"id":"semetey-1-2013:p1256:b003:l006","ordinal":171995,"en":"When angered, he was a black-gray wolf;"},{"id":"semetey-1-2013:p1256:b003:l007","ordinal":171996,"en":"This son of the leopard"},{"id":"semetey-1-2013:p1256:b003:l008","ordinal":171997,"en":"Was red fire to whoever challenged him."},{"id":"semetey-1-2013:p1256:b003:l009","ordinal":171998,"en":"He summered at Middle Keng-Kol"},{"id":"semetey-1-2013:p1256:b003:l010","ordinal":171999,"en":"And tethered his fourteen horses."},{"id":"semetey-1-2013:p1256:b003:l011","ordinal":172000,"en":"If an enemy rode out shooting,"},{"id":"semetey-1-2013:p1256:b003:l012","ordinal":172001,"en":"He drove them before him."},{"id":"semetey-1-2013:p1256:b003:l013","ordinal":172002,"en":"When they provoked his anger,"},{"id":"semetey-1-2013:p1256:b003:l014","ordinal":172003,"en":"He caught and chewed them in his fangs."},{"id":"semetey-1-2013:p1256:b003:l015","ordinal":172004,"en":"Offspring of a lion-hero,"},{"id":"semetey-1-2013:p1256:b003:l016","ordinal":172005,"en":"He was never one of the common folk"},{"id":"semetey-1-2013:p1256:b003:l017","ordinal":172006,"en":"To offer resistance."},{"id":"semetey-1-2013:p1256:b003:l018","ordinal":172007,"en":"His courage was high and his venom strong;"},{"id":"semetey-1-2013:p1256:b003:l019","ordinal":172008,"en":"He laid flat whoever challenged him."},{"id":"semetey-1-2013:p1256:b003:l020","ordinal":172009,"en":"When Külchoro arrived safely,"},{"id":"semetey-1-2013:p1256:b003:l021","ordinal":172010,"en":"When Semetey saw his companion,"},{"id":"semetey-1-2013:p1256:b003:l022","ordinal":172011,"en":"He cried out, invoking Babedin;"},{"id":"semetey-1-2013:p1256:b003:l023","ordinal":172012,"en":"Saying that the boy had returned safely,"},{"id":"semetey-1-2013:p1256:b003:l024","ordinal":172013,"en":"Thirty daughters-in-law and thirty girls,"},{"id":"semetey-1-2013:p1256:b003:l025","ordinal":172014,"en":"With peerless Chürök at their head,"},{"id":"semetey-1-2013:p1256:b003:l026","ordinal":172015,"en":"Ran about crying out."},{"id":"semetey-1-2013:p1256:b003:l027","ordinal":172016,"en":"Then Aichürök entertained them as guests"},{"id":"semetey-1-2013:p1256:b003:l028","ordinal":172017,"en":"And held games and diversions,"},{"id":"semetey-1-2013:p1256:b003:l029","ordinal":172018,"en":"Gathering the elegant women."},{"id":"semetey-1-2013:p1256:b003:l030","ordinal":172019,"en":"The outer shell was bead-stone,"},{"id":"semetey-1-2013:p1256:b003:l031","ordinal":172020,"en":"With many kinds of sugary foods."},{"id":"semetey-1-2013:p1256:b003:l032","ordinal":172021,"en":"Crying aloud, \"Babedin!\""},{"id":"semetey-1-2013:p1256:b003:l033","ordinal":172022,"en":"Your formidable sister-in-law Aichürök"},{"id":"semetey-1-2013:p1256:b003:l034","ordinal":172023,"en":"Slaughtered a barren nursing mare,"},{"id":"semetey-1-2013:p1256:b003:l035","ordinal":172024,"en":"Set out the food and drink,"},{"id":"semetey-1-2013:p1256:b003:l036","ordinal":172025,"en":"And served tea in the aptama.*"},{"id":"semetey-1-2013:p1256:b003:l037","ordinal":172026,"en":"She had thirty daughters-in-law and thirty girls"},{"id":"semetey-1-2013:p1256:b003:l038","ordinal":172027,"en":"Gathered in extraordinary numbers,"},{"id":"semetey-1-2013:p1256:b003:l039","ordinal":172028,"en":"Had them play the orompoi game,"},{"id":"semetey-1-2013:p1256:b004:l001","ordinal":172029,"en":"And sated their longing for games."},{"id":"semetey-1-2013:p1256:b004:l002","ordinal":172030,"en":"Small-mouthed and camel-eyed,"},{"id":"semetey-1-2013:p1256:b004:l003","ordinal":172031,"en":"With dark eyes casting sideward glances,"},{"id":"semetey-1-2013:p1256:b004:l004","ordinal":172032,"en":"In crimson dresses and with moonlike waists,"}]
