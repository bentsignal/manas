[{"id":"semetey-1-2013:p0673:b005:l006","ordinal":128001,"en":"Your elder Bakai put them on Kökcholok,"},{"id":"semetey-1-2013:p0673:b005:l007","ordinal":128002,"en":"And mounted himself as well."},{"id":"semetey-1-2013:p0673:b005:l008","ordinal":128003,"en":"Semetey followed him."},{"id":"semetey-1-2013:p0673:b005:l009","ordinal":128004,"en":"From malicious Jakyp,"},{"id":"semetey-1-2013:p0673:b005:l010","ordinal":128005,"en":"Khan Manas's saddlebags"},{"id":"semetey-1-2013:p0673:b005:l011","ordinal":128006,"en":"He had seized and was taking away."},{"id":"semetey-1-2013:p0673:b005:l012","ordinal":128007,"en":"Warrior Bakai's Kökcholok,"},{"id":"semetey-1-2013:p0673:b005:l013","ordinal":128008,"en":"Under the weight of the saddlebags,"},{"id":"semetey-1-2013:p0673:b005:l014","ordinal":128009,"en":"Ah, that Kökcholok—"},{"id":"semetey-1-2013:p0673:b005:l016","ordinal":128010,"en":"His pasterns bent,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0673:b005:l017","ordinal":128011,"en":"His belly hung down to the ground."},{"id":"semetey-1-2013:p0673:b005:l018","ordinal":128012,"en":"“What will become of the dog?”"},{"id":"semetey-1-2013:p0673:b005:l019","ordinal":128013,"en":"Your elder Bakai looked about in alarm."},{"id":"semetey-1-2013:p0673:b005:l020","ordinal":128014,"en":"The horse's spine curved like a sickle;"},{"id":"semetey-1-2013:p0673:b005:l022","ordinal":128015,"en":"His back bent and sagged.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0673:b005:l023","ordinal":128016,"en":"Kökcholok stepped forward,"},{"id":"semetey-1-2013:p0673:b005:l024","ordinal":128017,"en":"That worthy noble steed,"},{"id":"semetey-1-2013:p0673:b005:l025","ordinal":128018,"en":"With a supple, ambling gait."},{"id":"semetey-1-2013:p0673:b005:l026","ordinal":128019,"en":"The wind could not match his trot;"},{"id":"semetey-1-2013:p0673:b005:l027","ordinal":128020,"en":"No beast could match his walk."},{"id":"semetey-1-2013:p0673:b005:l028","ordinal":128021,"en":"Steam billowed from his nostrils."},{"id":"semetey-1-2013:p0673:b005:l029","ordinal":128022,"en":"The black stones he trod upon"},{"id":"semetey-1-2013:p0673:b005:l030","ordinal":128023,"en":"Crumbled worse than charcoal."},{"id":"semetey-1-2013:p0673:b005:l031","ordinal":128024,"en":"Lord Bakai, your warrior elder,"},{"id":"semetey-1-2013:p0673:b005:l032","ordinal":128025,"en":"(Kayipchi's dark cave,"},{"id":"semetey-1-2013:p0673:b005:l033","ordinal":128026,"en":"When leopard Manas lived,"},{"id":"semetey-1-2013:p0673:b005:l034","ordinal":128027,"en":"The very cave where he hid treasure),"},{"id":"semetey-1-2013:p0673:b005:l035","ordinal":128028,"en":"To the cave where the treasury was gathered,"},{"id":"semetey-1-2013:p0673:b005:l036","ordinal":128029,"en":"He tipped and lowered them."},{"id":"semetey-1-2013:p0673:b005:l037","ordinal":128030,"en":"To that helpless one left by Manas,"},{"id":"semetey-1-2013:p0673:b005:l038","ordinal":128031,"en":"He handed over the gray saddlebags."},{"id":"semetey-1-2013:p0673:b005:l039","ordinal":128032,"en":"“The saddlebags left by Manas,” he said,"},{"id":"semetey-1-2013:p0673:b005:l040","ordinal":128033,"en":"Entrusting them to Bölökbai,"},{"id":"semetey-1-2013:p0674:b004:l001","ordinal":128034,"en":"Teaching what was unknown,"},{"id":"semetey-1-2013:p0674:b004:l002","ordinal":128035,"en":"The learned elder Bakai,"},{"id":"semetey-1-2013:p0674:b004:l003","ordinal":128036,"en":"Making the unperceived understood,"},{"id":"semetey-1-2013:p0674:b004:l004","ordinal":128037,"en":"Falcon Bakai, the saint."},{"id":"semetey-1-2013:p0674:b004:l005","ordinal":128038,"en":"As they rode farther on,"},{"id":"semetey-1-2013:p0674:b004:l006","ordinal":128039,"en":"Yellow foothills came into view."},{"id":"semetey-1-2013:p0674:b004:l007","ordinal":128040,"en":"Seeing the ridge, he wept;"},{"id":"semetey-1-2013:p0674:b004:l008","ordinal":128041,"en":"Jilgynduu, Keng-Kol, broad Talas—"},{"id":"semetey-1-2013:p0674:b004:l009","ordinal":128042,"en":"Seeing the land, he wept."},{"id":"semetey-1-2013:p0674:b004:l010","ordinal":128043,"en":"Kara-Buura and Chong-Chatkal—"},{"id":"semetey-1-2013:p0674:b004:l011","ordinal":128044,"en":"Seeing their mountainside hollows, he wept."},{"id":"semetey-1-2013:p0674:b004:l012","ordinal":128045,"en":"The multitude of Kyrgyz, the many Argin,"},{"id":"semetey-1-2013:p0674:b004:l013","ordinal":128046,"en":"Seeing where they had dwelt, he wept."},{"id":"semetey-1-2013:p0674:b004:l014","ordinal":128047,"en":"Your elder, leopard Bakai,"},{"id":"semetey-1-2013:p0674:b004:l015","ordinal":128048,"en":"The dark ridge where he used to stand watch—"},{"id":"semetey-1-2013:p0674:b004:l016","ordinal":128049,"en":"Seeing its peak, he wept."},{"id":"semetey-1-2013:p0674:b004:l017","ordinal":128050,"en":"God's sun grew overcast in the sky;"},{"id":"semetey-1-2013:p0674:b004:l018","ordinal":128051,"en":"Upon Khan Bakai's head,"},{"id":"semetey-1-2013:p0674:b004:l019","ordinal":128052,"en":"Sixty thoughts came at once:"},{"id":"semetey-1-2013:p0674:b004:l020","ordinal":128053,"en":"“My dear orphan,"},{"id":"semetey-1-2013:p0674:b004:l021","ordinal":128054,"en":"Seen today, gone tomorrow—"},{"id":"semetey-1-2013:p0674:b004:l022","ordinal":128055,"en":"Such is this world of shit."},{"id":"semetey-1-2013:p0674:b004:l023","ordinal":128056,"en":"Orphan, listen to my words."},{"id":"semetey-1-2013:p0674:b004:l024","ordinal":128057,"en":"In those days, when my caravan Manas lived,"},{"id":"semetey-1-2013:p0674:b004:l025","ordinal":128058,"en":"In a Kyrgyz cap of blue-gray lynx fur,"},{"id":"semetey-1-2013:p0674:b004:l026","ordinal":128059,"en":"When I tossed my head,"},{"id":"semetey-1-2013:p0674:b004:l027","ordinal":128060,"en":"Knowing the world,"},{"id":"semetey-1-2013:p0674:b004:l028","ordinal":128061,"en":"When I lived in delight,"},{"id":"semetey-1-2013:p0674:b004:l029","ordinal":128062,"en":"Lying on my back, acting like God,"},{"id":"semetey-1-2013:p0674:b004:l030","ordinal":128063,"en":"I would slice and eat rump meat."},{"id":"semetey-1-2013:p0674:b004:l031","ordinal":128064,"en":"When my soul's companion Manas lived,"},{"id":"semetey-1-2013:p0674:b004:l032","ordinal":128065,"en":"I would say, ‘Where is the angel of death for me?’"},{"id":"semetey-1-2013:p0674:b004:l033","ordinal":128066,"en":"After that Manas died,"},{"id":"semetey-1-2013:p0674:b004:l034","ordinal":128067,"en":"I was humiliated, herding camels."},{"id":"semetey-1-2013:p0674:b004:l035","ordinal":128068,"en":"While his lord was alive,"},{"id":"semetey-1-2013:p0674:b004:l036","ordinal":128069,"en":"Your elder, Lord Bakai—"},{"id":"semetey-1-2013:p0674:b005:l001","ordinal":128070,"en":"The marten cap upon his head,"},{"id":"semetey-1-2013:p0674:b005:l002","ordinal":128071,"en":"Who did not wear it and toss his head?"},{"id":"semetey-1-2013:p0674:b005:l003","ordinal":128072,"en":"When they heard of your elder, Khan Bakai,"},{"id":"semetey-1-2013:p0674:b005:l004","ordinal":128073,"en":"Great China, the khakan's people,"},{"id":"semetey-1-2013:p0674:b005:l005","ordinal":128074,"en":"The mighty peoples trembled."},{"id":"semetey-1-2013:p0674:b005:l006","ordinal":128075,"en":"My dear orphan,"},{"id":"semetey-1-2013:p0674:b005:l007","ordinal":128076,"en":"When I reckon up my past,"},{"id":"semetey-1-2013:p0674:b005:l008","ordinal":128077,"en":"My heart is sorely troubled,"},{"id":"semetey-1-2013:p0674:b005:l009","ordinal":128078,"en":"Tears spill from my eyes."},{"id":"semetey-1-2013:p0674:b005:l010","ordinal":128079,"en":"The overturned, treacherous world"},{"id":"semetey-1-2013:p0674:b005:l011","ordinal":128080,"en":"Seems to have gone without a backward glance."},{"id":"semetey-1-2013:p0674:b005:l012","ordinal":128081,"en":"The goodness that lay before me,"},{"id":"semetey-1-2013:p0674:b005:l013","ordinal":128082,"en":"I failed to see it."},{"id":"semetey-1-2013:p0674:b005:l014","ordinal":128083,"en":"Bruised black and blue, wretched man,"},{"id":"semetey-1-2013:p0674:b005:l015","ordinal":128084,"en":"While fierce Manas was alive,"},{"id":"semetey-1-2013:p0674:b005:l016","ordinal":128085,"en":"I failed to die."},{"id":"semetey-1-2013:p0674:b005:l017","ordinal":128086,"en":"Kara-Shaar and Kambil,"},{"id":"semetey-1-2013:p0674:b005:l018","ordinal":128087,"en":"When I held them in my grasp,"},{"id":"semetey-1-2013:p0674:b005:l019","ordinal":128088,"en":"The multitude of Manchus, the countless Torguts,"},{"id":"semetey-1-2013:p0674:b005:l020","ordinal":128089,"en":"When I struck them down,"},{"id":"semetey-1-2013:p0674:b005:l021","ordinal":128090,"en":"In the time of the wide world,"},{"id":"semetey-1-2013:p0674:b005:l022","ordinal":128091,"en":"While my fierce one was alive,"},{"id":"semetey-1-2013:p0674:b005:l023","ordinal":128092,"en":"Why did I not die then?"},{"id":"semetey-1-2013:p0674:b005:l024","ordinal":128093,"en":"Narkesken, that strikes men down,"},{"id":"semetey-1-2013:p0674:b005:l025","ordinal":128094,"en":"When I held it,"},{"id":"semetey-1-2013:p0674:b005:l026","ordinal":128095,"en":"Upon the world, turmoil—"},{"id":"semetey-1-2013:p0674:b005:l027","ordinal":128096,"en":"When I brought it,"},{"id":"semetey-1-2013:p0674:b005:l028","ordinal":128097,"en":"When sacred power rested upon my head,"},{"id":"semetey-1-2013:p0674:b005:l029","ordinal":128098,"en":"While Manas was safe and well,"},{"id":"semetey-1-2013:p0674:b005:l030","ordinal":128099,"en":"Why did I not die then?"},{"id":"semetey-1-2013:p0674:b005:l031","ordinal":128100,"en":"In those days, when I wore a shot-proof coat,"},{"id":"semetey-1-2013:p0674:b005:l032","ordinal":128101,"en":"The eighteen thousand worlds,"},{"id":"semetey-1-2013:p0674:b005:l033","ordinal":128102,"en":"When I trod them down like charcoal,"},{"id":"semetey-1-2013:p0674:b005:l034","ordinal":128103,"en":"Why did I not die then?"},{"id":"semetey-1-2013:p0674:b005:l035","ordinal":128104,"en":"Upon those I aimed at, turmoil—"},{"id":"semetey-1-2013:p0674:b005:l036","ordinal":128105,"en":"When I brought it,"},{"id":"semetey-1-2013:p0675:b003:l001","ordinal":128106,"en":"When from many lands"},{"id":"semetey-1-2013:p0675:b003:l002","ordinal":128107,"en":"I was taking tribute,"},{"id":"semetey-1-2013:p0675:b003:l003","ordinal":128108,"en":"A battle-axe with a golden cheek"},{"id":"semetey-1-2013:p0675:b003:l004","ordinal":128109,"en":"Upon my arm, poor soul,"},{"id":"semetey-1-2013:p0675:b003:l005","ordinal":128110,"en":"When I had it hanging there,"},{"id":"semetey-1-2013:p0675:b003:l006","ordinal":128111,"en":"When the whole wide world"},{"id":"semetey-1-2013:p0675:b003:l007","ordinal":128112,"en":"Was under my command,"},{"id":"semetey-1-2013:p0675:b003:l008","ordinal":128113,"en":"When, devastating the world,"},{"id":"semetey-1-2013:p0675:b003:l009","ordinal":128114,"en":"I swept across it,"},{"id":"semetey-1-2013:p0675:b003:l010","ordinal":128115,"en":"When a throne like a camel at the place of honor"},{"id":"semetey-1-2013:p0675:b003:l011","ordinal":128116,"en":"Was mine to mount,"},{"id":"semetey-1-2013:p0675:b003:l012","ordinal":128117,"en":"When all the peoples with their rulers"},{"id":"semetey-1-2013:p0675:b003:l013","ordinal":128118,"en":"Were mine to marshal,"},{"id":"semetey-1-2013:p0675:b003:l014","ordinal":128119,"en":"Why did I not die then?"},{"id":"semetey-1-2013:p0675:b003:l015","ordinal":128120,"en":"When my mighty warrior was still alive,"},{"id":"semetey-1-2013:p0675:b003:l016","ordinal":128121,"en":"I broke through Ombo and took spoils,"},{"id":"semetey-1-2013:p0675:b003:l017","ordinal":128122,"en":"Broke through its midst and opened a road,"},{"id":"semetey-1-2013:p0675:b003:l018","ordinal":128123,"en":"Herded white deer as cattle,"},{"id":"semetey-1-2013:p0675:b003:l019","ordinal":128124,"en":"Threw the places I fought into confusion,"},{"id":"semetey-1-2013:p0675:b003:l021","ordinal":128125,"en":"When my name reached there,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0675:b003:l022","ordinal":128126,"en":"When to the whole wide world"},{"id":"semetey-1-2013:p0675:b003:l023","ordinal":128127,"en":"My appeal could reach,"},{"id":"semetey-1-2013:p0675:b003:l024","ordinal":128128,"en":"Why did I not die then?"},{"id":"semetey-1-2013:p0675:b003:l025","ordinal":128129,"en":"When bored, we shot roe deer,"},{"id":"semetey-1-2013:p0675:b003:l026","ordinal":128130,"en":"When not, we lay at ease,"},{"id":"semetey-1-2013:p0675:b003:l027","ordinal":128131,"en":"When those great days of plenty"},{"id":"semetey-1-2013:p0675:b003:l028","ordinal":128132,"en":"Were upon us,"},{"id":"semetey-1-2013:p0675:b003:l029","ordinal":128133,"en":"When the laughing Kyrgyz and many Argyn"},{"id":"semetey-1-2013:p0675:b003:l030","ordinal":128134,"en":"Were settled there,"},{"id":"semetey-1-2013:p0675:b003:l031","ordinal":128135,"en":"When by day there was kumis, by night girls,"},{"id":"semetey-1-2013:p0675:b003:l032","ordinal":128136,"en":"And such was our life,"},{"id":"semetey-1-2013:p0675:b003:l033","ordinal":128137,"en":"Why did I not die then?"},{"id":"semetey-1-2013:p0675:b003:l034","ordinal":128138,"en":"Here along the Talas,"},{"id":"semetey-1-2013:p0675:b003:l035","ordinal":128139,"en":"When we laid out an ordo game of forty foot-lengths,"},{"id":"semetey-1-2013:p0675:b003:l036","ordinal":128140,"en":"And shot the knucklebones for sport,"},{"id":"semetey-1-2013:p0675:b003:l037","ordinal":128141,"en":"When a golden-mouthed trumpet"},{"id":"semetey-1-2013:p0675:b003:l038","ordinal":128142,"en":"Was played by a man of mirth,"},{"id":"semetey-1-2013:p0675:b003:l039","ordinal":128143,"en":"And a drum with a golden tuft"},{"id":"semetey-1-2013:p0675:b005:l001","ordinal":128144,"en":"Was beaten to entertain,"},{"id":"semetey-1-2013:p0675:b005:l002","ordinal":128145,"en":"Noble Manas was still there,"},{"id":"semetey-1-2013:p0675:b005:l003","ordinal":128146,"en":"When a fat lamb and its tasty head"},{"id":"semetey-1-2013:p0675:b005:l004","ordinal":128147,"en":"Were set to boil heartily,"},{"id":"semetey-1-2013:p0675:b005:l005","ordinal":128148,"en":"When bored, we shot roe deer,"},{"id":"semetey-1-2013:p0675:b005:l006","ordinal":128149,"en":"When not, here in Talas"},{"id":"semetey-1-2013:p0675:b005:l007","ordinal":128150,"en":"We played at liberty,"},{"id":"semetey-1-2013:p0675:b005:l008","ordinal":128151,"en":"Why did I not die then?"},{"id":"semetey-1-2013:p0675:b005:l009","ordinal":128152,"en":"When my blood-shedding Manas lived,"},{"id":"semetey-1-2013:p0675:b005:l010","ordinal":128153,"en":"There was the place he piled his treasury."},{"id":"semetey-1-2013:p0675:b005:l011","ordinal":128154,"en":"If I speak of my former days,"},{"id":"semetey-1-2013:p0675:b005:l012","ordinal":128155,"en":"It seems as though I boast—"},{"id":"semetey-1-2013:p0675:b005:l013","ordinal":128156,"en":"That wretched Bakay is me."},{"id":"semetey-1-2013:p0675:b005:l014","ordinal":128157,"en":"When your father Manas lived,"},{"id":"semetey-1-2013:p0675:b005:l015","ordinal":128158,"en":"When his honor was at its height,"},{"id":"semetey-1-2013:p0675:b005:l016","ordinal":128159,"en":"My dear orphan,"},{"id":"semetey-1-2013:p0675:b005:l017","ordinal":128160,"en":"This was the land your father made his home."},{"id":"semetey-1-2013:p0675:b005:l018","ordinal":128161,"en":"After your father passed away,"},{"id":"semetey-1-2013:p0675:b005:l019","ordinal":128162,"en":"This wretched land lay deserted."},{"id":"semetey-1-2013:p0675:b005:l020","ordinal":128163,"en":"When Manas, my twin, was here,"},{"id":"semetey-1-2013:p0675:b005:l021","ordinal":128164,"en":"Here was the dark eye of the spring,"},{"id":"semetey-1-2013:p0675:b005:l022","ordinal":128165,"en":"Here was the plane tree itself."},{"id":"semetey-1-2013:p0675:b005:l023","ordinal":128166,"en":"My dear orphan,"},{"id":"semetey-1-2013:p0675:b005:l024","ordinal":128167,"en":"Listen closely to my words!"},{"id":"semetey-1-2013:p0675:b005:l025","ordinal":128168,"en":"The bluish hillock lies in haze—"},{"id":"semetey-1-2013:p0675:b005:l027","ordinal":128169,"en":"The plain ahead is visible,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0675:b005:l028","ordinal":128170,"en":"Your poor uncle Bakay's heart is troubled."},{"id":"semetey-1-2013:p0675:b005:l030","ordinal":128171,"en":"There is the facing side of Bar-Kol,"},{"id":"semetey-1-2013:p0675:b005:l031","ordinal":128172,"en":"And visible this side of it,"},{"id":"semetey-1-2013:p0675:b005:l032","ordinal":128173,"en":"There is the garden King Manas planted."},{"id":"semetey-1-2013:p0675:b005:l033","ordinal":128174,"en":"The blue hill in gray haze—"},{"id":"semetey-1-2013:p0675:b005:l034","ordinal":128175,"en":"There is the throne King Manas mounted.\""},{"id":"semetey-1-2013:p0675:b005:l036","ordinal":128176,"en":"Telling at length of all his deeds,"},{"id":"semetey-1-2013:p0675:b005:l037","ordinal":128177,"en":"Your uncle, King Bakay,"},{"id":"semetey-1-2013:p0675:b005:l038","ordinal":128178,"en":"Was all but dying now."},{"id":"semetey-1-2013:p0675:b005:l039","ordinal":128179,"en":"\"I would go into the earth, but the ground is hard;"},{"id":"semetey-1-2013:p0676:b003:l001","ordinal":128180,"en":"I would die, but life is sweet."},{"id":"semetey-1-2013:p0676:b003:l002","ordinal":128181,"en":"The plane tree has been felled,"},{"id":"semetey-1-2013:p0676:b003:l003","ordinal":128182,"en":"Hardship has descended on me,"},{"id":"semetey-1-2013:p0676:b003:l004","ordinal":128183,"en":"This damned, faithless world—"},{"id":"semetey-1-2013:p0676:b003:l005","ordinal":128184,"en":"Grief weighs down my precious soul."},{"id":"semetey-1-2013:p0676:b003:l006","ordinal":128185,"en":"My long-awaited little one,"},{"id":"semetey-1-2013:p0676:b003:l007","ordinal":128186,"en":"For twelve years I herded camels,"},{"id":"semetey-1-2013:p0676:b003:l008","ordinal":128187,"en":"I wished to die of shame,"},{"id":"semetey-1-2013:p0676:b003:l009","ordinal":128188,"en":"Yet I did not die—what could I do?—"},{"id":"semetey-1-2013:p0676:b003:l010","ordinal":128189,"en":"Because you lived, my orphan."},{"id":"semetey-1-2013:p0676:b003:l011","ordinal":128190,"en":"When I remember Manas Khan,"},{"id":"semetey-1-2013:p0676:b003:l012","ordinal":128191,"en":"My ribs are cruelly torn apart,"},{"id":"semetey-1-2013:p0676:b003:l013","ordinal":128192,"en":"My tears pour down."},{"id":"semetey-1-2013:p0676:b003:l014","ordinal":128193,"en":"This damned, wretched life"},{"id":"semetey-1-2013:p0676:b003:l015","ordinal":128194,"en":"Seems all the sweeter to my eyes."},{"id":"semetey-1-2013:p0676:b003:l016","ordinal":128195,"en":"The house built crosswise—"},{"id":"semetey-1-2013:p0676:b003:l017","ordinal":128196,"en":"When I remember Manas,"},{"id":"semetey-1-2013:p0676:b003:l018","ordinal":128197,"en":"Grief weighs down my wretched soul."},{"id":"semetey-1-2013:p0676:b003:l019","ordinal":128198,"en":"When my king Manas lived,"},{"id":"semetey-1-2013:p0676:b003:l020","ordinal":128199,"en":"When all my wealth was mine,"},{"id":"semetey-1-2013:p0676:b003:l021","ordinal":128200,"en":"This hill on which we two now stand—"},{"id":"semetey-1-2013:p0676:b003:l022","ordinal":128201,"en":"My orphan foal, listen—"},{"id":"semetey-1-2013:p0676:b003:l023","ordinal":128202,"en":"This is where the story springs from:"},{"id":"semetey-1-2013:p0676:b003:l024","ordinal":128203,"en":"The golden throne your khan father mounted,"},{"id":"semetey-1-2013:p0676:b003:l025","ordinal":128204,"en":"A garden of plane trees all around."},{"id":"semetey-1-2013:p0676:b003:l026","ordinal":128205,"en":"Beneath the golden throne,"},{"id":"semetey-1-2013:p0676:b003:l027","ordinal":128206,"en":"Here is the tale of it:"},{"id":"semetey-1-2013:p0676:b003:l028","ordinal":128207,"en":"Even if soaked in water forty years,"},{"id":"semetey-1-2013:p0676:b003:l029","ordinal":128208,"en":"They would neither change their color nor decay;"},{"id":"semetey-1-2013:p0676:b003:l030","ordinal":128209,"en":"Even if cast in water eighty years,"},{"id":"semetey-1-2013:p0676:b003:l032","ordinal":128210,"en":"Carpets with golden patterns,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0676:b003:l033","ordinal":128211,"en":"Sixty of them were spread."},{"id":"semetey-1-2013:p0676:b003:l034","ordinal":128212,"en":"Upon those carpets,"},{"id":"semetey-1-2013:p0676:b003:l035","ordinal":128213,"en":"At their edges on all four sides,"},{"id":"semetey-1-2013:p0676:b003:l036","ordinal":128214,"en":"Was where they gripped and swung their maces,"},{"id":"semetey-1-2013:p0676:b003:l037","ordinal":128215,"en":"Was where the great guards stood."},{"id":"semetey-1-2013:p0676:b003:l038","ordinal":128216,"en":"They never saw an enemy's face;"},{"id":"semetey-1-2013:p0676:b003:l039","ordinal":128217,"en":"When my blood-shedder lived,"},{"id":"semetey-1-2013:p0676:b004:l001","ordinal":128218,"en":"No stranger came and went."},{"id":"semetey-1-2013:p0676:b004:l002","ordinal":128219,"en":"If you ask about this place,"},{"id":"semetey-1-2013:p0676:b004:l003","ordinal":128220,"en":"It was Kanykey's white palace,"},{"id":"semetey-1-2013:p0676:b004:l004","ordinal":128221,"en":"Its gate of iron, solid metal,"},{"id":"semetey-1-2013:p0676:b004:l005","ordinal":128222,"en":"So many guards stood at its door."},{"id":"semetey-1-2013:p0676:b004:l006","ordinal":128223,"en":"The faithless world has passed away—"},{"id":"semetey-1-2013:p0676:b004:l007","ordinal":128224,"en":"Damn it, what bliss there was!"},{"id":"semetey-1-2013:p0676:b004:l008","ordinal":128225,"en":"Within that palace,"},{"id":"semetey-1-2013:p0676:b004:l009","ordinal":128226,"en":"The guards were beyond counting,"},{"id":"semetey-1-2013:p0676:b004:l010","ordinal":128227,"en":"The champions were more numerous still."},{"id":"semetey-1-2013:p0676:b004:l011","ordinal":128228,"en":"No one got word of what was there;"},{"id":"semetey-1-2013:p0676:b004:l012","ordinal":128229,"en":"Into that palace"},{"id":"semetey-1-2013:p0676:b004:l013","ordinal":128230,"en":"No mortal went visiting."},{"id":"semetey-1-2013:p0676:b004:l014","ordinal":128231,"en":"When someone touched the threshold,"},{"id":"semetey-1-2013:p0676:b004:l015","ordinal":128232,"en":"The kettledrum was struck,"},{"id":"semetey-1-2013:p0676:b004:l016","ordinal":128233,"en":"And farther within,"},{"id":"semetey-1-2013:p0676:b004:l017","ordinal":128234,"en":"More guards were stationed,"},{"id":"semetey-1-2013:p0676:b004:l018","ordinal":128235,"en":"Who swarmed together at the alarm."},{"id":"semetey-1-2013:p0676:b004:l019","ordinal":128236,"en":"Human noses and ears"},{"id":"semetey-1-2013:p0676:b004:l020","ordinal":128237,"en":"They wore as amulets."},{"id":"semetey-1-2013:p0676:b004:l021","ordinal":128238,"en":"Those whom your father's hand had not touched,"},{"id":"semetey-1-2013:p0676:b004:l022","ordinal":128239,"en":"Some mortals, had survived unharmed."},{"id":"semetey-1-2013:p0676:b004:l023","ordinal":128240,"en":"When Manas, my twin, died,"},{"id":"semetey-1-2013:p0676:b004:l024","ordinal":128241,"en":"When my hapless soul met hardship,"},{"id":"semetey-1-2013:p0676:b004:l025","ordinal":128242,"en":"Abyke, Kobosh, the six scoundrels,"},{"id":"semetey-1-2013:p0676:b004:l026","ordinal":128243,"en":"Plundered and divided all my wealth."},{"id":"semetey-1-2013:p0676:b004:l027","ordinal":128244,"en":"When they plundered my costly cloth,"},{"id":"semetey-1-2013:p0676:b004:l028","ordinal":128245,"en":"When the dogs stirred up trouble,"},{"id":"semetey-1-2013:p0676:b004:l029","ordinal":128246,"en":"Your father's golden throne"},{"id":"semetey-1-2013:p0676:b004:l030","ordinal":128247,"en":"They badly wrecked."},{"id":"semetey-1-2013:p0676:b004:l031","ordinal":128248,"en":"Binding pinewood spears together,"},{"id":"semetey-1-2013:p0676:b004:l032","ordinal":128249,"en":"They made war on the golden throne,"},{"id":"semetey-1-2013:p0676:b004:l033","ordinal":128250,"en":"Saying, \"Manas's name shall not remain!\""},{"id":"semetey-1-2013:p0676:b004:l034","ordinal":128251,"en":"Forever bellowing,"},{"id":"semetey-1-2013:p0676:b004:l035","ordinal":128252,"en":"Saying, \"That fool's name shall not remain!\""},{"id":"semetey-1-2013:p0676:b004:l036","ordinal":128253,"en":"They felled all the plane trees,"},{"id":"semetey-1-2013:p0676:b004:l037","ordinal":128254,"en":"Uprooted the pillars and let water loose,"},{"id":"semetey-1-2013:p0676:b004:l038","ordinal":128255,"en":"Thus brought the palace down,"},{"id":"semetey-1-2013:p0676:b004:l039","ordinal":128256,"en":"Cut down its trees and laid them low,"}]
