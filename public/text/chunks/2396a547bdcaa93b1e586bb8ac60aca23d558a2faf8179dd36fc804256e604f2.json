[{"id":"manas-2010:p1251:b001:l024","ordinal":54273,"en":"Had joined the battle."},{"id":"manas-2010:p1251:b001:l025","ordinal":54274,"en":"On every side, the mighty fighters prepared;"},{"id":"manas-2010:p1251:b001:l026","ordinal":54275,"en":"They swarmed upon the hawk."},{"id":"manas-2010:p1251:b001:l027","ordinal":54276,"en":"That day, Sarala—"},{"id":"manas-2010:p1251:b001:l028","ordinal":54277,"en":"The wind could not match his trot—"},{"id":"manas-2010:p1251:b001:l029","ordinal":54278,"en":"Took strides like a mountain sheep."},{"id":"manas-2010:p1251:b001:l030","ordinal":54279,"en":"When they came to the slope,"},{"id":"manas-2010:p1251:b001:l031","ordinal":54280,"en":"Look at the earth, look at the dust!"},{"id":"manas-2010:p1251:b001:l032","ordinal":54281,"en":"Look at the surging Chinese lives!"},{"id":"manas-2010:p1251:b001:l033","ordinal":54282,"en":"Ezkara, khan of the Manchu,"},{"id":"manas-2010:p1251:b001:l034","ordinal":54283,"en":"Khan Zholoy, khan of the Kalmyks,"},{"id":"manas-2010:p1251:b001:l035","ordinal":54284,"en":"Karazhoy, the fearsome marksman,"},{"id":"manas-2010:p1251:b001:l036","ordinal":54285,"en":"Börüköz and Orokbash—"},{"id":"manas-2010:p1251:b001:l037","ordinal":54286,"en":"When he saw the seven giants,"},{"id":"manas-2010:p1251:b001:l038","ordinal":54287,"en":"The gray-maned lion Almambet,"},{"id":"manas-2010:p1251:b001:l039","ordinal":54288,"en":"Sparing his life not at all,"},{"id":"manas-2010:p1251:b001:l040","ordinal":54289,"en":"Reached the seven giants."},{"id":"manas-2010:p1251:b001:l041","ordinal":54290,"en":"Upon reaching them, all seven"},{"id":"manas-2010:p1251:b001:l042","ordinal":54291,"en":"He knocked down as he passed."},{"id":"manas-2010:p1252:b001:l001","ordinal":54292,"en":"The seven giants fallen from their horses—"},{"id":"manas-2010:p1252:b001:l002","ordinal":54293,"en":"What warriors were those seven giants!"},{"id":"manas-2010:p1252:b001:l003","ordinal":54294,"en":"Who felled all seven alike,"},{"id":"manas-2010:p1252:b001:l004","ordinal":54295,"en":"What a lion Almambet was!"},{"id":"manas-2010:p1252:b001:l005","ordinal":54296,"en":"When he speared the seven giants,"},{"id":"manas-2010:p1252:b001:l006","ordinal":54297,"en":"A hero like Almambet"},{"id":"manas-2010:p1252:b001:l007","ordinal":54298,"en":"Lost his senses, dazed;"},{"id":"manas-2010:p1252:b001:l008","ordinal":54299,"en":"His wits gone, he grew weak."},{"id":"manas-2010:p1252:b001:l009","ordinal":54300,"en":"The hero slipped from his saddle;"},{"id":"manas-2010:p1252:b001:l010","ordinal":54301,"en":"His feet slipped from the stirrups."},{"id":"manas-2010:p1252:b001:l011","ordinal":54302,"en":"Upon silk-maned Sarala,"},{"id":"manas-2010:p1252:b001:l012","ordinal":54303,"en":"The golden, broad-pommeled saddle,"},{"id":"manas-2010:p1252:b001:l013","ordinal":54304,"en":"He could not press down with his seat."},{"id":"manas-2010:p1252:b001:l014","ordinal":54305,"en":"The lead rope tied in rounded knots,"},{"id":"manas-2010:p1252:b001:l015","ordinal":54306,"en":"He could not grip it firmly."},{"id":"manas-2010:p1252:b001:l016","ordinal":54307,"en":"The stirrups with golden treads,"},{"id":"manas-2010:p1252:b001:l017","ordinal":54308,"en":"He could not fit his feet properly within."},{"id":"manas-2010:p1252:b001:l018","ordinal":54309,"en":"While the gray-maned hero swayed,"},{"id":"manas-2010:p1252:b001:l019","ordinal":54310,"en":"With cotton belt and roomy boots,"},{"id":"manas-2010:p1252:b001:l020","ordinal":54311,"en":"Kongurbay, khan of the monks,"},{"id":"manas-2010:p1252:b001:l021","ordinal":54312,"en":"Kongurbay, who knew the enemy's stratagems,"},{"id":"manas-2010:p1252:b001:l022","ordinal":54313,"en":"The slave, skillful among spearmen,"},{"id":"manas-2010:p1252:b001:l023","ordinal":54314,"en":"Braced himself with his polished spear;"},{"id":"manas-2010:p1252:b001:l024","ordinal":54315,"en":"His battle-axe and fighting gear,"},{"id":"manas-2010:p1252:b001:l025","ordinal":54316,"en":"He readied them all."},{"id":"manas-2010:p1252:b001:l026","ordinal":54317,"en":"While your Alma reeled,"},{"id":"manas-2010:p1252:b001:l027","ordinal":54318,"en":"The formidable Kongurbay"},{"id":"manas-2010:p1252:b001:l028","ordinal":54319,"en":"Came charging with a rumble."},{"id":"manas-2010:p1252:b001:l029","ordinal":54320,"en":"Charging from the flank,"},{"id":"manas-2010:p1252:b001:l030","ordinal":54321,"en":"Your grim-faced one reached him."},{"id":"manas-2010:p1252:b001:l031","ordinal":54322,"en":"From atop Sarala,"},{"id":"manas-2010:p1252:b001:l032","ordinal":54323,"en":"The hero Almambet"},{"id":"manas-2010:p1252:b001:l033","ordinal":54324,"en":"He knocked down as he passed."},{"id":"manas-2010:p1252:b001:l034","ordinal":54325,"en":"Leaning upon his battle-axe,"},{"id":"manas-2010:p1252:b001:l035","ordinal":54326,"en":"Your noble, gray-maned Alma,"},{"id":"manas-2010:p1252:b001:l036","ordinal":54327,"en":"When Kongurbay came and speared him,"},{"id":"manas-2010:p1252:b001:l037","ordinal":54328,"en":"Was deprived of his wings."},{"id":"manas-2010:p1252:b001:l038","ordinal":54329,"en":"He was parted from Sarala."},{"id":"manas-2010:p1252:b001:l039","ordinal":54330,"en":"Sarala, the surpassing racer,"},{"id":"manas-2010:p1252:b001:l040","ordinal":54331,"en":"Lowered his head toward the earth."},{"id":"manas-2010:p1252:b001:l041","ordinal":54332,"en":"The creature wiser than other beasts,"},{"id":"manas-2010:p1252:b001:l042","ordinal":54333,"en":"The lead rope tied in rounded knots,"},{"id":"manas-2010:p1253:b001:l001","ordinal":54334,"en":"Not letting it drag upon the dark earth,"},{"id":"manas-2010:p1253:b001:l002","ordinal":54335,"en":"He took it between his teeth."},{"id":"manas-2010:p1253:b001:l003","ordinal":54336,"en":"Through the vast host,"},{"id":"manas-2010:p1253:b001:l005","ordinal":54337,"en":"Had begun chasing after him.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"manas-2010:p1253:b001:l006","ordinal":54338,"en":"Under pursuit, not fleeing straight,"},{"id":"manas-2010:p1253:b001:l007","ordinal":54339,"en":"Sarala kept stopping."},{"id":"manas-2010:p1253:b001:l008","ordinal":54340,"en":"Like a mare whose foal was left behind,"},{"id":"manas-2010:p1253:b001:l009","ordinal":54341,"en":"Looking back for Almambet,"},{"id":"manas-2010:p1253:b001:l010","ordinal":54342,"en":"Sarala kept searching."},{"id":"manas-2010:p1253:b001:l011","ordinal":54343,"en":"Fleeing up and down,"},{"id":"manas-2010:p1253:b001:l012","ordinal":54344,"en":"Sarala kept bounding."},{"id":"manas-2010:p1253:b001:l013","ordinal":54345,"en":"Kongurbay's Algara,"},{"id":"manas-2010:p1253:b001:l014","ordinal":54346,"en":"Leaping beyond his reach,"},{"id":"manas-2010:p1253:b001:l015","ordinal":54347,"en":"Sarala kept tormenting."},{"id":"manas-2010:p1253:b001:l016","ordinal":54348,"en":"Over so many ridges,"},{"id":"manas-2010:p1253:b001:l017","ordinal":54349,"en":"Sarala kept crossing."},{"id":"manas-2010:p1253:b001:l018","ordinal":54350,"en":"Not letting the grim-faced one catch him,"},{"id":"manas-2010:p1253:b001:l019","ordinal":54351,"en":"Sarala kept fleeing."},{"id":"manas-2010:p1253:b001:l020","ordinal":54352,"en":"They had grown together, tiny as lice,"},{"id":"manas-2010:p1253:b001:l021","ordinal":54353,"en":"Joined while still within the womb."},{"id":"manas-2010:p1253:b001:l022","ordinal":54354,"en":"‘Where has Almambet been left?’"},{"id":"manas-2010:p1253:b001:l023","ordinal":54355,"en":"Looking back and neighing,"},{"id":"manas-2010:p1253:b001:l024","ordinal":54356,"en":"Sarala kept thinking."},{"id":"manas-2010:p1253:b001:l025","ordinal":54357,"en":"When he had fallen from his horse,"},{"id":"manas-2010:p1253:b001:l026","ordinal":54358,"en":"The Chinese brought torment upon him."},{"id":"manas-2010:p1253:b001:l027","ordinal":54359,"en":"Reaching him, the Chinese swarmed;"},{"id":"manas-2010:p1253:b001:l028","ordinal":54360,"en":"They surrounded him twelvefold."},{"id":"manas-2010:p1253:b001:l029","ordinal":54361,"en":"Then Almambet,"},{"id":"manas-2010:p1253:b001:l030","ordinal":54362,"en":"Without sparing his frail life,"},{"id":"manas-2010:p1253:b001:l031","ordinal":54363,"en":"Took his polished musket in hand,"},{"id":"manas-2010:p1253:b001:l032","ordinal":54364,"en":"Fired in every direction,"},{"id":"manas-2010:p1253:b001:l033","ordinal":54365,"en":"Keeping smoke about his head."},{"id":"manas-2010:p1253:b001:l034","ordinal":54366,"en":"The Chinese who had swarmed in"},{"id":"manas-2010:p1253:b001:l035","ordinal":54367,"en":"Galloped back in flight."},{"id":"manas-2010:p1253:b001:l036","ordinal":54368,"en":"When one came near him,"},{"id":"manas-2010:p1253:b001:l037","ordinal":54369,"en":"He struck once with his polished musket."},{"id":"manas-2010:p1253:b001:l038","ordinal":54370,"en":"The multitude of Chinese fled back,"},{"id":"manas-2010:p1253:b001:l039","ordinal":54371,"en":"Turned their horses and dashed away."},{"id":"manas-2010:p1253:b001:l040","ordinal":54372,"en":"Unable to gather courage and venture close,"},{"id":"manas-2010:p1253:b001:l041","ordinal":54373,"en":"The Chinese standing watching,"},{"id":"manas-2010:p1253:b001:l042","ordinal":54374,"en":"Kongurbay drove into the encirclement."},{"id":"manas-2010:p1254:b001:l001","ordinal":54375,"en":"‘Go and bind him!’"},{"id":"manas-2010:p1254:b001:l002","ordinal":54376,"en":"Calling to the mighty fighters,"},{"id":"manas-2010:p1254:b001:l003","ordinal":54377,"en":"Kongurbay drove them in."},{"id":"manas-2010:p1254:b001:l004","ordinal":54378,"en":"Earth flew without ceasing"},{"id":"manas-2010:p1254:b001:l005","ordinal":54379,"en":"From beside Almambet."},{"id":"manas-2010:p1254:b001:l006","ordinal":54380,"en":"Upon the lion under siege,"},{"id":"manas-2010:p1254:b001:l007","ordinal":54381,"en":"The multitude of Chinese and Kalmyks"},{"id":"manas-2010:p1254:b001:l008","ordinal":54382,"en":"Shot arrows like rain,"},{"id":"manas-2010:p1254:b001:l009","ordinal":54383,"en":"Poured down shots like hail."},{"id":"manas-2010:p1254:b001:l010","ordinal":54384,"en":"The warrior Kanzharkol from one side"},{"id":"manas-2010:p1254:b001:l011","ordinal":54385,"en":"Prepared, saying, ‘I shall catch him.’"},{"id":"manas-2010:p1254:b001:l012","ordinal":54386,"en":"Swarming like ants,"},{"id":"manas-2010:p1254:b001:l013","ordinal":54387,"en":"The Chinese crowded round."},{"id":"manas-2010:p1254:b001:l014","ordinal":54388,"en":"Azizkan's gray-maned son,"},{"id":"manas-2010:p1254:b001:l015","ordinal":54389,"en":"Not letting a lasso fall over his head,"},{"id":"manas-2010:p1254:b001:l016","ordinal":54390,"en":"To the Chinese swarming over the earth,"},{"id":"manas-2010:p1254:b001:l017","ordinal":54391,"en":"To not one did your Alma yield."},{"id":"manas-2010:p1254:b001:l018","ordinal":54392,"en":"The Chinese who came close,"},{"id":"manas-2010:p1254:b001:l019","ordinal":54393,"en":"He swept aside with his hungry steel sword."},{"id":"manas-2010:p1254:b001:l020","ordinal":54394,"en":"Those who pressed him hard,"},{"id":"manas-2010:p1254:b001:l021","ordinal":54395,"en":"He struck with his battle-axe."},{"id":"manas-2010:p1254:b001:l022","ordinal":54396,"en":"Struggling, hard pressed—"},{"id":"manas-2010:p1254:b001:l023","ordinal":54397,"en":"May the world lie desolate!—"},{"id":"manas-2010:p1254:b001:l024","ordinal":54398,"en":"His fortune turned terribly awry."},{"id":"manas-2010:p1254:b001:l025","ordinal":54399,"en":"‘When such a battle is upon us,"},{"id":"manas-2010:p1254:b001:l026","ordinal":54400,"en":"If only Akkula would turn his head!"},{"id":"manas-2010:p1254:b001:l027","ordinal":54401,"en":"If only my blood-drinker, born a leopard,"},{"id":"manas-2010:p1254:b001:l028","ordinal":54402,"en":"Hero Manas, stood watching!"},{"id":"manas-2010:p1254:b001:l029","ordinal":54403,"en":"If Manas stood watching,"},{"id":"manas-2010:p1254:b001:l030","ordinal":54404,"en":"Then let the multitude of Chinese"},{"id":"manas-2010:p1254:b001:l031","ordinal":54405,"en":"Swarm upon me like this"},{"id":"manas-2010:p1254:b001:l032","ordinal":54406,"en":"And cut short my entrusted life!"},{"id":"manas-2010:p1254:b001:l033","ordinal":54407,"en":"My grief is complete, beyond measure."},{"id":"manas-2010:p1254:b001:l034","ordinal":54408,"en":"When the Chinese press upon me,"},{"id":"manas-2010:p1254:b001:l035","ordinal":54409,"en":"Akzholtoy and Chubak are not here!’"},{"id":"manas-2010:p1254:b001:l036","ordinal":54410,"en":"So said Almambet then,"},{"id":"manas-2010:p1254:b001:l037","ordinal":54411,"en":"Without sparing his dear life."},{"id":"manas-2010:p1254:b001:l038","ordinal":54412,"en":"When he looked back,"},{"id":"manas-2010:p1254:b001:l039","ordinal":54413,"en":"Would you call what came before torment?"},{"id":"manas-2010:p1254:b001:l040","ordinal":54414,"en":"God had struck him down!"},{"id":"manas-2010:p1254:b001:l041","ordinal":54415,"en":"Taking a net of tempered iron,"},{"id":"manas-2010:p1254:b001:l042","ordinal":54416,"en":"Kutan the Giant, with iron ears,"},{"id":"manas-2010:p1255:b001:l001","ordinal":54417,"en":"And Kiten the Giant, with an iron navel,"},{"id":"manas-2010:p1255:b001:l002","ordinal":54418,"en":"Who had his horse firmly saddled,"},{"id":"manas-2010:p1255:b001:l003","ordinal":54419,"en":"In the city of jinn and spirits"},{"id":"manas-2010:p1255:b001:l004","ordinal":54420,"en":"Had been taught for six years."},{"id":"manas-2010:p1255:b001:l005","ordinal":54421,"en":"He spared no one he fought;"},{"id":"manas-2010:p1255:b001:l006","ordinal":54422,"en":"The meat of a whole pig"},{"id":"manas-2010:p1255:b001:l007","ordinal":54423,"en":"Could not satisfy him at one meal."},{"id":"manas-2010:p1255:b001:l008","ordinal":54424,"en":"He now saw those mighty giants."},{"id":"manas-2010:p1255:b001:l009","ordinal":54425,"en":"‘Upon Almambet's head,"},{"id":"manas-2010:p1255:b001:l010","ordinal":54426,"en":"I myself shall inflict hell!"},{"id":"manas-2010:p1255:b001:l011","ordinal":54427,"en":"I myself shall bind him!"},{"id":"manas-2010:p1255:b001:l012","ordinal":54428,"en":"Gouging out both his eyes,"},{"id":"manas-2010:p1255:b001:l013","ordinal":54429,"en":"Before Karykan in Beijing,"},{"id":"manas-2010:p1255:b001:l014","ordinal":54430,"en":"I shall take him as tribute!"},{"id":"manas-2010:p1255:b001:l015","ordinal":54431,"en":"If the fugitive falls into my hands,"},{"id":"manas-2010:p1255:b001:l016","ordinal":54432,"en":"My grievance from long ago,"},{"id":"manas-2010:p1255:b001:l017","ordinal":54433,"en":"Thus I shall avenge it!’"},{"id":"manas-2010:p1255:b001:l018","ordinal":54434,"en":"Both of them prepared alike."},{"id":"manas-2010:p1255:b001:l019","ordinal":54435,"en":"Like a moving avalanche,"},{"id":"manas-2010:p1255:b001:l020","ordinal":54436,"en":"They came rumbling."},{"id":"manas-2010:p1255:b001:l021","ordinal":54437,"en":"Your Alma under siege was no hero;"},{"id":"manas-2010:p1255:b001:l022","ordinal":54438,"en":"Whoever saw it shuddered."},{"id":"manas-2010:p1255:b001:l023","ordinal":54439,"en":"While matters stood like this,"},{"id":"manas-2010:p1255:b001:l024","ordinal":54440,"en":"So many cares could not fit within the breast."},{"id":"manas-2010:p1255:b001:l025","ordinal":54441,"en":"‘My precious one, where is my Alma?’"},{"id":"manas-2010:p1255:b001:l026","ordinal":54442,"en":"Syrgak's tears streamed ten ways."},{"id":"manas-2010:p1255:b001:l027","ordinal":54443,"en":"When he saw Almambet,"},{"id":"manas-2010:p1255:b001:l028","ordinal":54444,"en":"Unable to bear the grief,"},{"id":"manas-2010:p1255:b001:l029","ordinal":54445,"en":"Syrgak's voice reached God."},{"id":"manas-2010:p1255:b001:l030","ordinal":54446,"en":"‘My Alake, my twin lamb, my companion!"},{"id":"manas-2010:p1255:b001:l031","ordinal":54447,"en":"Parted from my twin,"},{"id":"manas-2010:p1255:b001:l032","ordinal":54448,"en":"How can I go on without dying?"},{"id":"manas-2010:p1255:b001:l034","ordinal":54449,"en":"My mighty, gray-maned Alma,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"manas-2010:p1255:b001:l035","ordinal":54450,"en":"Letting the Chinese take him as a gift,"},{"id":"manas-2010:p1255:b001:l036","ordinal":54451,"en":"What wish would I fulfill?"},{"id":"manas-2010:p1255:b001:l037","ordinal":54452,"en":"Rather than this, my mighty one,"},{"id":"manas-2010:p1255:b001:l038","ordinal":54453,"en":"For my noble sultan Alma,"},{"id":"manas-2010:p1255:b001:l039","ordinal":54454,"en":"Let me give myself in sacrifice!’"},{"id":"manas-2010:p1255:b001:l040","ordinal":54455,"en":"Saying this, hero Syrgak,"},{"id":"manas-2010:p1255:b001:l041","ordinal":54456,"en":"Roaring in fury,"},{"id":"manas-2010:p1255:b001:l042","ordinal":54457,"en":"Called out, ‘Khan Manas!’"},{"id":"manas-2010:p1256:b001:l001","ordinal":54458,"en":"For Almambet's sake,"},{"id":"manas-2010:p1256:b001:l002","ordinal":54459,"en":"He girded his waist firmly."},{"id":"manas-2010:p1256:b001:l003","ordinal":54460,"en":"Against infidels as numerous as a cow's hairs,"},{"id":"manas-2010:p1256:b001:l004","ordinal":54461,"en":"He entered alone and attacked."},{"id":"manas-2010:p1256:b001:l005","ordinal":54462,"en":"As he was about to cast his lasso,"},{"id":"manas-2010:p1256:b001:l006","ordinal":54463,"en":"The rumbling Kutan the Giant,"},{"id":"manas-2010:p1256:b001:l007","ordinal":54464,"en":"As he was about to bind your Alma,"},{"id":"manas-2010:p1256:b001:l008","ordinal":54465,"en":"That warrior Kutan the Giant,"},{"id":"manas-2010:p1256:b001:l009","ordinal":54466,"en":"Ulak Khan's Syrgak"},{"id":"manas-2010:p1256:b001:l010","ordinal":54467,"en":"Reached him faster than an arrow."},{"id":"manas-2010:p1256:b001:l011","ordinal":54468,"en":"Upon reaching Kutan,"},{"id":"manas-2010:p1256:b001:l012","ordinal":54469,"en":"He knocked him down as he passed."},{"id":"manas-2010:p1256:b001:l013","ordinal":54470,"en":"Your Syrgak steeped himself in blood upon blood."},{"id":"manas-2010:p1256:b001:l014","ordinal":54471,"en":"Against Kutan the Giant alone he did not fight;"},{"id":"manas-2010:p1256:b001:l015","ordinal":54472,"en":"Against all the Chinese infidels,"},{"id":"manas-2010:p1256:b001:l016","ordinal":54473,"en":"He entered alone and battled."},{"id":"manas-2010:p1256:b001:l017","ordinal":54474,"en":"The infidels who surrounded him,"},{"id":"manas-2010:p1256:b001:l018","ordinal":54475,"en":"From over Almambet,"},{"id":"manas-2010:p1256:b001:l019","ordinal":54476,"en":"He drove away and scattered."},{"id":"manas-2010:p1256:b001:l020","ordinal":54477,"en":"From over Almambet,"},{"id":"manas-2010:p1256:b001:l021","ordinal":54478,"en":"The infidels now drew away."},{"id":"manas-2010:p1256:b001:l022","ordinal":54479,"en":"As though he had seen his father,"},{"id":"manas-2010:p1256:b001:l023","ordinal":54480,"en":"Roaring, ‘Alake!’"},{"id":"manas-2010:p1256:b001:l024","ordinal":54481,"en":"Leopard Syrgak now reached him."},{"id":"manas-2010:p1256:b001:l025","ordinal":54482,"en":"‘Almambet, fierce hero, dear lion!"},{"id":"manas-2010:p1256:b001:l026","ordinal":54483,"en":"My Alake, if we lose you,"},{"id":"manas-2010:p1256:b001:l027","ordinal":54484,"en":"Our backs will break completely!"},{"id":"manas-2010:p1256:b001:l028","ordinal":54485,"en":"Among the multitude of Chinese and Manchu,"},{"id":"manas-2010:p1256:b001:l029","ordinal":54486,"en":"How have you fallen?"},{"id":"manas-2010:p1256:b001:l030","ordinal":54487,"en":"My dear Alake,"},{"id":"manas-2010:p1256:b001:l031","ordinal":54488,"en":"Into what misery have you plunged me?’"},{"id":"manas-2010:p1256:b001:l032","ordinal":54489,"en":"Hero Syrgak drew near."},{"id":"manas-2010:p1256:b001:l033","ordinal":54490,"en":"Calling, ‘Almambet!’"},{"id":"manas-2010:p1256:b001:l034","ordinal":54491,"en":"Saying this then,"},{"id":"manas-2010:p1256:b001:l035","ordinal":54492,"en":"He reached him faster than an arrow."},{"id":"manas-2010:p1256:b001:l036","ordinal":54493,"en":"Upon reaching him, hero Syrgak"},{"id":"manas-2010:p1256:b001:l037","ordinal":54494,"en":"Gripped him firmly by the shoulder,"},{"id":"manas-2010:p1256:b001:l038","ordinal":54495,"en":"Hoisted him like a feedbag,"},{"id":"manas-2010:p1256:b001:l039","ordinal":54496,"en":"Showed that he was a lion,"},{"id":"manas-2010:p1256:b001:l040","ordinal":54497,"en":"And seated him upon his right knee."},{"id":"manas-2010:p1256:b001:l041","ordinal":54498,"en":"‘Lower your head toward the earth!"},{"id":"manas-2010:p1256:b001:l042","ordinal":54499,"en":"Though a beast, you are my wings;"},{"id":"manas-2010:p1257:b001:l001","ordinal":54500,"en":"Take strides like a mountain sheep!’"},{"id":"manas-2010:p1257:b001:l002","ordinal":54501,"en":"Kökchebich beneath him"},{"id":"manas-2010:p1257:b001:l003","ordinal":54502,"en":"Bounded like a roe deer."},{"id":"manas-2010:p1257:b001:l004","ordinal":54503,"en":"The creature's body heated,"},{"id":"manas-2010:p1257:b001:l005","ordinal":54504,"en":"He ran, casting his life aside."},{"id":"manas-2010:p1257:b001:l006","ordinal":54505,"en":"Thus your gray-maned Syrgak,"},{"id":"manas-2010:p1257:b001:l007","ordinal":54506,"en":"In the blink of an eye,"},{"id":"manas-2010:p1257:b001:l008","ordinal":54507,"en":"With Kökchebich beneath him,"},{"id":"manas-2010:p1257:b001:l009","ordinal":54508,"en":"His back bent like a spring trap,"},{"id":"manas-2010:p1257:b001:l010","ordinal":54509,"en":"Over so many ridges and hillocks,"},{"id":"manas-2010:p1257:b001:l011","ordinal":54510,"en":"Bounded with them both aboard."},{"id":"manas-2010:p1257:b001:l012","ordinal":54511,"en":"At that time, that same"},{"id":"manas-2010:p1257:b001:l013","ordinal":54512,"en":"Sarala who had been fleeing,"},{"id":"manas-2010:p1257:b001:l014","ordinal":54513,"en":"Excited, alone on the plain,"},{"id":"manas-2010:p1257:b001:l015","ordinal":54514,"en":"Was grazing."},{"id":"manas-2010:p1257:b001:l016","ordinal":54515,"en":"Though a beast, his master"},{"id":"manas-2010:p1257:b001:l017","ordinal":54516,"en":"He was searching for."},{"id":"manas-2010:p1257:b001:l018","ordinal":54517,"en":"When he saw Almambet,"},{"id":"manas-2010:p1257:b001:l019","ordinal":54518,"en":"He neighed and came quickly."},{"id":"manas-2010:p1257:b001:l020","ordinal":54519,"en":"Sighing, turning broadside,"},{"id":"manas-2010:p1257:b001:l021","ordinal":54520,"en":"He offered his flank."},{"id":"manas-2010:p1257:b001:l022","ordinal":54521,"en":"Before the Chinese could reach them,"},{"id":"manas-2010:p1257:b001:l023","ordinal":54522,"en":"He sprang onto the horse."},{"id":"manas-2010:p1257:b001:l024","ordinal":54523,"en":"Kindling his extinguished fire,"},{"id":"manas-2010:p1257:b001:l025","ordinal":54524,"en":"Reviving his dead soul,"},{"id":"manas-2010:p1257:b001:l026","ordinal":54525,"en":"Ulak Khan's Syrgak"},{"id":"manas-2010:p1257:b001:l027","ordinal":54526,"en":"Sent Azizkan's gray-maned son"},{"id":"manas-2010:p1257:b001:l028","ordinal":54527,"en":"Back into battle."},{"id":"manas-2010:p1257:b001:l029","ordinal":54528,"en":"Making Sarala dance,"}]
