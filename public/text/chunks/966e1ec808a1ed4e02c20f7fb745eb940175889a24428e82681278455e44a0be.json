[{"id":"semetey-1-2013:p0864:b004:l013","ordinal":142337,"en":"Whatever enemy he faced,"},{"id":"semetey-1-2013:p0864:b004:l014","ordinal":142338,"en":"Was accustomed to come out for single combat."},{"id":"semetey-1-2013:p0864:b004:l015","ordinal":142339,"en":"When Sary Khan thrust his lance,"},{"id":"semetey-1-2013:p0864:b004:l016","ordinal":142340,"en":"Sary Khan's lance"},{"id":"semetey-1-2013:p0864:b004:l017","ordinal":142341,"en":"Was the first to reach its mark."},{"id":"semetey-1-2013:p0864:b004:l018","ordinal":142342,"en":"Baimat, who posed as a hero—"},{"id":"semetey-1-2013:p0864:b004:l019","ordinal":142343,"en":"His helmet of blue iron"},{"id":"semetey-1-2013:p0864:b004:l020","ordinal":142344,"en":"Flew off to the ground."},{"id":"semetey-1-2013:p0864:b004:l021","ordinal":142345,"en":"In a terrible hurry, Tazbaimat,"},{"id":"semetey-1-2013:p0864:b004:l022","ordinal":142346,"en":"Before he could take his shield in hand,"},{"id":"semetey-1-2013:p0864:b004:l023","ordinal":142347,"en":"Before he could save his life,"},{"id":"semetey-1-2013:p0864:b004:l024","ordinal":142348,"en":"Your ready uncle Sary,"},{"id":"semetey-1-2013:p0864:b004:l025","ordinal":142349,"en":"Drawing his cutting sword from its sheath,"},{"id":"semetey-1-2013:p0864:b004:l026","ordinal":142350,"en":"Arrived before an arrow could;"},{"id":"semetey-1-2013:p0864:b004:l027","ordinal":142351,"en":"Where he reached Baimat,"},{"id":"semetey-1-2013:p0864:b004:l028","ordinal":142352,"en":"He cut off his head as he passed."},{"id":"semetey-1-2013:p0864:b004:l029","ordinal":142353,"en":"Kokcho's son Umotoy"},{"id":"semetey-1-2013:p0864:b004:l030","ordinal":142354,"en":"Rushed upon his flank;"},{"id":"semetey-1-2013:p0864:b004:l031","ordinal":142355,"en":"Muzburchak's son Buyanbek"},{"id":"semetey-1-2013:p0864:b004:l032","ordinal":142356,"en":"Made ready on this side."},{"id":"semetey-1-2013:p0864:b004:l033","ordinal":142357,"en":"Khan Manas's forty companions,"},{"id":"semetey-1-2013:p0864:b004:l034","ordinal":142358,"en":"Drawing bows like falling rain,"},{"id":"semetey-1-2013:p0864:b004:l035","ordinal":142359,"en":"Firing shots like hail,"},{"id":"semetey-1-2013:p0864:b004:l036","ordinal":142360,"en":"Rushed at him from every side."},{"id":"semetey-1-2013:p0864:b004:l037","ordinal":142361,"en":"“Seize the bald man, seize him!”"},{"id":"semetey-1-2013:p0864:b004:l038","ordinal":142362,"en":"“Seize him and kill him!”"},{"id":"semetey-1-2013:p0864:b004:l039","ordinal":142363,"en":"Kyrgylchal came bellowing,"},{"id":"semetey-1-2013:p0865:b003:l001","ordinal":142364,"en":"Shouting “Kobosh!” as his battle cry."},{"id":"semetey-1-2013:p0865:b003:l002","ordinal":142365,"en":"(King Manas's name had faded;"},{"id":"semetey-1-2013:p0865:b003:l003","ordinal":142366,"en":"It had become “Giant Kobosh.”)"},{"id":"semetey-1-2013:p0865:b003:l004","ordinal":142367,"en":"Kyrgylchal, head of the forty,"},{"id":"semetey-1-2013:p0865:b003:l005","ordinal":142368,"en":"The mad old man who grew proud at forty,"},{"id":"semetey-1-2013:p0865:b003:l006","ordinal":142369,"en":"Who thought up a thousand misdeeds—"},{"id":"semetey-1-2013:p0865:b003:l007","ordinal":142370,"en":"Manas, that fleet steed,"},{"id":"semetey-1-2013:p0865:b003:l008","ordinal":142371,"en":"Had never said, “He has caused trouble.”"},{"id":"semetey-1-2013:p0865:b003:l009","ordinal":142372,"en":"What did dear Sary do?"},{"id":"semetey-1-2013:p0865:b003:l010","ordinal":142373,"en":"Toward Kyrgylchal,"},{"id":"semetey-1-2013:p0865:b003:l011","ordinal":142374,"en":"Without looking up or down,"},{"id":"semetey-1-2013:p0865:b003:l012","ordinal":142375,"en":"Without thinking he might die,"},{"id":"semetey-1-2013:p0865:b003:l013","ordinal":142376,"en":"The extraordinary hero Sary Khan,"},{"id":"semetey-1-2013:p0865:b003:l014","ordinal":142377,"en":"To Tuuchunak beneath him,"},{"id":"semetey-1-2013:p0865:b003:l015","ordinal":142378,"en":"Applied his whip left and right,"},{"id":"semetey-1-2013:p0865:b003:l016","ordinal":142379,"en":"Spurred him on both sides."},{"id":"semetey-1-2013:p0865:b003:l017","ordinal":142380,"en":"Sary Khan was skillful;"},{"id":"semetey-1-2013:p0865:b003:l018","ordinal":142381,"en":"Now he reached Kyrgylchal."},{"id":"semetey-1-2013:p0865:b003:l019","ordinal":142382,"en":"Stirring strife throughout the world,"},{"id":"semetey-1-2013:p0865:b003:l020","ordinal":142383,"en":"Was he not your uncle who divided it?"},{"id":"semetey-1-2013:p0865:b003:l021","ordinal":142384,"en":"Fighting every enemy,"},{"id":"semetey-1-2013:p0865:b003:l022","ordinal":142385,"en":"Was your uncle not accustomed to it!"},{"id":"semetey-1-2013:p0865:b003:l023","ordinal":142386,"en":"When he saw Kyrgylchal,"},{"id":"semetey-1-2013:p0865:b003:l024","ordinal":142387,"en":"Without looking around,"},{"id":"semetey-1-2013:p0865:b003:l025","ordinal":142388,"en":"Without sparing his life at all,"},{"id":"semetey-1-2013:p0865:b003:l026","ordinal":142389,"en":"Without looking from side to side,"},{"id":"semetey-1-2013:p0865:b003:l027","ordinal":142390,"en":"Without sparing his life a hair's breadth,"},{"id":"semetey-1-2013:p0865:b003:l028","ordinal":142391,"en":"Roaring in fury,"},{"id":"semetey-1-2013:p0865:b003:l029","ordinal":142392,"en":"Shouting “Manas!” as his battle cry,"},{"id":"semetey-1-2013:p0865:b003:l030","ordinal":142393,"en":"“The middle of the beard,” he said,"},{"id":"semetey-1-2013:p0865:b003:l031","ordinal":142394,"en":"“The edge of the gullet,” he said."},{"id":"semetey-1-2013:p0865:b003:l032","ordinal":142395,"en":"What did your accomplished uncle do?"},{"id":"semetey-1-2013:p0865:b003:l033","ordinal":142396,"en":"Kyrgyl, whom you saw,"},{"id":"semetey-1-2013:p0865:b003:l034","ordinal":142397,"en":"He reached and struck as he passed."},{"id":"semetey-1-2013:p0865:b003:l035","ordinal":142398,"en":"Without moving or wavering,"},{"id":"semetey-1-2013:p0865:b003:l036","ordinal":142399,"en":"Without shifting from the spot he fixed his gaze on,"},{"id":"semetey-1-2013:p0865:b003:l037","ordinal":142400,"en":"The point of the lance passed through,"},{"id":"semetey-1-2013:p0865:b003:l038","ordinal":142401,"en":"Reached the gullet;"},{"id":"semetey-1-2013:p0865:b003:l039","ordinal":142402,"en":"The first neck vertebra and the back of the skull"},{"id":"semetey-1-2013:p0865:b005:l001","ordinal":142403,"en":"It grazed as it passed."},{"id":"semetey-1-2013:p0865:b005:l002","ordinal":142404,"en":"What did your Kyrgylchal do?"},{"id":"semetey-1-2013:p0865:b005:l003","ordinal":142405,"en":"From Narkyzyl's back"},{"id":"semetey-1-2013:p0865:b005:l004","ordinal":142406,"en":"He fell with a rumble."},{"id":"semetey-1-2013:p0865:b005:l005","ordinal":142407,"en":"Two companions and one hero"},{"id":"semetey-1-2013:p0865:b005:l006","ordinal":142408,"en":"Had died at the khan's hands."},{"id":"semetey-1-2013:p0865:b005:l007","ordinal":142409,"en":"Making Tuuchunak rear,"},{"id":"semetey-1-2013:p0865:b005:l008","ordinal":142410,"en":"Dear hero Sary Khan"},{"id":"semetey-1-2013:p0865:b005:l009","ordinal":142411,"en":"Shattered whoever he encountered."},{"id":"semetey-1-2013:p0865:b005:l010","ordinal":142412,"en":"Moving back and forth,"},{"id":"semetey-1-2013:p0865:b005:l011","ordinal":142413,"en":"Sating themselves on blood without restraint,"},{"id":"semetey-1-2013:p0865:b005:l012","ordinal":142414,"en":"Drenched in dark blood,"},{"id":"semetey-1-2013:p0865:b005:l013","ordinal":142415,"en":"They fought without fleeing,"},{"id":"semetey-1-2013:p0865:b005:l014","ordinal":142416,"en":"Battled with their lances,"},{"id":"semetey-1-2013:p0865:b005:l015","ordinal":142417,"en":"Shouted their war cries,"},{"id":"semetey-1-2013:p0865:b005:l016","ordinal":142418,"en":"Drew bows and fired,"},{"id":"semetey-1-2013:p0865:b005:l017","ordinal":142419,"en":"Plunged from one fierce excitement into another,"},{"id":"semetey-1-2013:p0865:b005:l018","ordinal":142420,"en":"Like Chinese and Kyrgyz,"},{"id":"semetey-1-2013:p0865:b005:l019","ordinal":142421,"en":"They faced one another."},{"id":"semetey-1-2013:p0865:b005:l020","ordinal":142422,"en":"Suffering hardship,"},{"id":"semetey-1-2013:p0865:b005:l021","ordinal":142423,"en":"They fought fiercely face to face,"},{"id":"semetey-1-2013:p0865:b005:l022","ordinal":142424,"en":"Mounted stallions from the tethering line,"},{"id":"semetey-1-2013:p0865:b005:l023","ordinal":142425,"en":"Took up poles from the ground,"},{"id":"semetey-1-2013:p0865:b005:l024","ordinal":142426,"en":"Cried, “Oh, my patron!” and struck."},{"id":"semetey-1-2013:p0865:b005:l025","ordinal":142427,"en":"Now there was a terrible battle."},{"id":"semetey-1-2013:p0865:b005:l026","ordinal":142428,"en":"Bowshot rattled,"},{"id":"semetey-1-2013:p0865:b005:l027","ordinal":142429,"en":"Arrowheads whistled;"},{"id":"semetey-1-2013:p0865:b005:l029","ordinal":142430,"en":"They meant to devour your uncle.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0865:b005:l030","ordinal":142431,"en":"Seven wolves and one sheep—"},{"id":"semetey-1-2013:p0865:b005:l031","ordinal":142432,"en":"When they attack, will they leave its carcass?"},{"id":"semetey-1-2013:p0865:b005:l032","ordinal":142433,"en":"One accomplished man—"},{"id":"semetey-1-2013:p0865:b005:l033","ordinal":142434,"en":"If they beat him, will they leave his body?"},{"id":"semetey-1-2013:p0865:b005:l034","ordinal":142435,"en":"Five thousand men led by Kobosh"},{"id":"semetey-1-2013:p0865:b005:l035","ordinal":142436,"en":"Rushed at his throat;"},{"id":"semetey-1-2013:p0865:b005:l036","ordinal":142437,"en":"Six thousand led by Abyke"},{"id":"semetey-1-2013:p0865:b005:l037","ordinal":142438,"en":"Made ready on one side;"},{"id":"semetey-1-2013:p0865:b005:l039","ordinal":142439,"en":"All forty companions,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0866:b003:l001","ordinal":142440,"en":"Rushed upon Sary Khan."},{"id":"semetey-1-2013:p0866:b003:l002","ordinal":142441,"en":"“Seize the bald man, seize him!”"},{"id":"semetey-1-2013:p0866:b003:l003","ordinal":142442,"en":"“Seize him and kill him!”"},{"id":"semetey-1-2013:p0866:b003:l004","ordinal":142443,"en":"“Saddle his Tuuchunak!”"},{"id":"semetey-1-2013:p0866:b003:l005","ordinal":142444,"en":"“Gouge out his two eyes!”"},{"id":"semetey-1-2013:p0866:b003:l006","ordinal":142445,"en":"There were white banners,"},{"id":"semetey-1-2013:p0866:b003:l007","ordinal":142446,"en":"There was shouting tumult;"},{"id":"semetey-1-2013:p0866:b003:l008","ordinal":142447,"en":"Like tumbleweed flying,"},{"id":"semetey-1-2013:p0866:b003:l009","ordinal":142448,"en":"No one could tell who was who."},{"id":"semetey-1-2013:p0866:b003:l010","ordinal":142449,"en":"Now there was a mighty battle."},{"id":"semetey-1-2013:p0866:b003:l011","ordinal":142450,"en":"Of the companions left by Manas,"},{"id":"semetey-1-2013:p0866:b003:l012","ordinal":142451,"en":"Tazbaimat and old Kyrgyl had died;"},{"id":"semetey-1-2013:p0866:b003:l013","ordinal":142452,"en":"Of the khans they had summoned,"},{"id":"semetey-1-2013:p0866:b003:l014","ordinal":142453,"en":"Eloquent Urbu had died."},{"id":"semetey-1-2013:p0866:b003:l015","ordinal":142454,"en":"Because all three had died,"},{"id":"semetey-1-2013:p0866:b003:l016","ordinal":142455,"en":"Abyke charged in fiercely."},{"id":"semetey-1-2013:p0866:b003:l017","ordinal":142456,"en":"If you ask about Abyke,"},{"id":"semetey-1-2013:p0866:b003:l018","ordinal":142457,"en":"He was an outstanding marksman;"},{"id":"semetey-1-2013:p0866:b003:l019","ordinal":142458,"en":"If you ask about Kobosh,"},{"id":"semetey-1-2013:p0866:b003:l020","ordinal":142459,"en":"He was a thundering fellow."},{"id":"semetey-1-2013:p0866:b003:l021","ordinal":142460,"en":"Khan Manas's forty companions,"},{"id":"semetey-1-2013:p0866:b003:l022","ordinal":142461,"en":"Told to take a cap, cut off a head;"},{"id":"semetey-1-2013:p0866:b003:l023","ordinal":142462,"en":"Told to shed blood, spilled stomach contents;"},{"id":"semetey-1-2013:p0866:b003:l024","ordinal":142463,"en":"Told to drink water, drank poison."},{"id":"semetey-1-2013:p0866:b003:l025","ordinal":142464,"en":"Skilled among the lancers,"},{"id":"semetey-1-2013:p0866:b003:l026","ordinal":142465,"en":"Experts who knew the enemy's tactics,"},{"id":"semetey-1-2013:p0866:b003:l027","ordinal":142466,"en":"Shouting “Kobosh!” as their battle cry,"},{"id":"semetey-1-2013:p0866:b003:l028","ordinal":142467,"en":"The forty companions thrust their lances."},{"id":"semetey-1-2013:p0866:b003:l029","ordinal":142468,"en":"Tuuchunak and Sary Khan"},{"id":"semetey-1-2013:p0866:b003:l030","ordinal":142469,"en":"Were caught in their midst!"},{"id":"semetey-1-2013:p0866:b003:l031","ordinal":142470,"en":"Do not ask what Tuuchunak was like:"},{"id":"semetey-1-2013:p0866:b003:l032","ordinal":142471,"en":"His tail was sparse, his mane scant;"},{"id":"semetey-1-2013:p0866:b003:l033","ordinal":142472,"en":"He would not let an onager escape across the desert."},{"id":"semetey-1-2013:p0866:b003:l034","ordinal":142473,"en":"At the sight of such encircling enemies,"},{"id":"semetey-1-2013:p0866:b003:l035","ordinal":142474,"en":"He was immensely swift, intelligent and practiced."},{"id":"semetey-1-2013:p0866:b003:l036","ordinal":142475,"en":"When a lance was thrust, he did not flinch;"},{"id":"semetey-1-2013:p0866:b003:l037","ordinal":142476,"en":"He also had the steadiness of a working mount."},{"id":"semetey-1-2013:p0866:b003:l038","ordinal":142477,"en":"When his mouth was given freedom, he thundered away;"},{"id":"semetey-1-2013:p0866:b003:l039","ordinal":142478,"en":"He also had a racer's speed."},{"id":"semetey-1-2013:p0866:b004:l001","ordinal":142479,"en":"The wind could not catch his trot;"},{"id":"semetey-1-2013:p0866:b004:l003","ordinal":142480,"en":"No beast could match his pace,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0866:b004:l004","ordinal":142481,"en":"An extraordinary racing creature."},{"id":"semetey-1-2013:p0866:b004:l005","ordinal":142482,"en":"Allah's sun clouded over in the sky;"},{"id":"semetey-1-2013:p0866:b004:l006","ordinal":142483,"en":"When the villains pressed around him,"},{"id":"semetey-1-2013:p0866:b004:l007","ordinal":142484,"en":"Sixty hardships descended on his head at once."},{"id":"semetey-1-2013:p0866:b004:l009","ordinal":142485,"en":"There was a pit already dug;"},{"id":"semetey-1-2013:p0866:b004:l010","ordinal":142486,"en":"All the villains stirred."},{"id":"semetey-1-2013:p0866:b004:l011","ordinal":142487,"en":"Great sorrow lay before him."},{"id":"semetey-1-2013:p0866:b004:l012","ordinal":142488,"en":"When he looked around,"},{"id":"semetey-1-2013:p0866:b004:l013","ordinal":142489,"en":"There was a net no bird could escape."},{"id":"semetey-1-2013:p0866:b004:l014","ordinal":142490,"en":"The sun was eclipsed and darkened;"},{"id":"semetey-1-2013:p0866:b004:l015","ordinal":142491,"en":"Upon your uncle Sary's head"},{"id":"semetey-1-2013:p0866:b004:l016","ordinal":142492,"en":"Sixty cares descended at once."},{"id":"semetey-1-2013:p0866:b004:l017","ordinal":142493,"en":"The villains had overwhelmed him;"},{"id":"semetey-1-2013:p0866:b004:l018","ordinal":142494,"en":"Upon your uncle Sary's head"},{"id":"semetey-1-2013:p0866:b004:l019","ordinal":142495,"en":"They had brought the end of the world."},{"id":"semetey-1-2013:p0866:b004:l020","ordinal":142496,"en":"“If I fall into these dogs' hands,"},{"id":"semetey-1-2013:p0866:b004:l021","ordinal":142497,"en":"Will I die a wretched death,"},{"id":"semetey-1-2013:p0866:b004:l022","ordinal":142498,"en":"Will I see Judgment Day?"},{"id":"semetey-1-2013:p0866:b004:l023","ordinal":142499,"en":"That plump, gray-mottled hen-goshawk,"},{"id":"semetey-1-2013:p0866:b004:l024","ordinal":142500,"en":"That gray hawk, that morning star—"},{"id":"semetey-1-2013:p0866:b004:l025","ordinal":142501,"en":"Will I see Semetey?"},{"id":"semetey-1-2013:p0866:b004:l026","ordinal":142502,"en":"Bakai, my refuge, is not here;"},{"id":"semetey-1-2013:p0866:b004:l027","ordinal":142503,"en":"The Argyn, my support, are not here."},{"id":"semetey-1-2013:p0866:b004:l028","ordinal":142504,"en":"Am I to die in disgrace?"},{"id":"semetey-1-2013:p0866:b004:l029","ordinal":142505,"en":"Saying I would be a messenger,"},{"id":"semetey-1-2013:p0866:b004:l030","ordinal":142506,"en":"I have come to be cut down."},{"id":"semetey-1-2013:p0866:b004:l031","ordinal":142507,"en":"Intending to come as a mediator,"},{"id":"semetey-1-2013:p0866:b004:l032","ordinal":142508,"en":"I have come to be taken."},{"id":"semetey-1-2013:p0866:b004:l033","ordinal":142509,"en":"If I keep fighting them,"},{"id":"semetey-1-2013:p0866:b004:l034","ordinal":142510,"en":"I shall die a wretched death."},{"id":"semetey-1-2013:p0866:b004:l035","ordinal":142511,"en":"Whimpering like a young puppy,"},{"id":"semetey-1-2013:p0866:b004:l036","ordinal":142512,"en":"I shall die with difficulty."},{"id":"semetey-1-2013:p0866:b004:l037","ordinal":142513,"en":"By setting myself against them,"},{"id":"semetey-1-2013:p0866:b004:l038","ordinal":142514,"en":"Why should I try to match them?"},{"id":"semetey-1-2013:p0866:b004:l039","ordinal":142515,"en":"My ocean, orphan Semetey—"},{"id":"semetey-1-2013:p0867:b003:l001","ordinal":142516,"en":"Let me flee more quickly,"},{"id":"semetey-1-2013:p0867:b003:l002","ordinal":142517,"en":"Let me die a more honorable death."},{"id":"semetey-1-2013:p0867:b003:l003","ordinal":142518,"en":"My noble uncle Bakai—"},{"id":"semetey-1-2013:p0867:b003:l004","ordinal":142519,"en":"Let me see his face."},{"id":"semetey-1-2013:p0867:b003:l005","ordinal":142520,"en":"Lamenting, let me tell my sorrow,"},{"id":"semetey-1-2013:p0867:b003:l006","ordinal":142521,"en":"And then let me die!”"},{"id":"semetey-1-2013:p0867:b003:l007","ordinal":142522,"en":"So saying, Sary Khan"},{"id":"semetey-1-2013:p0867:b003:l008","ordinal":142523,"en":"Took his dark-sided heavy whip,"},{"id":"semetey-1-2013:p0867:b003:l009","ordinal":142524,"en":"Whose blow could deafen the ears,"},{"id":"semetey-1-2013:p0867:b003:l010","ordinal":142525,"en":"Seized it and swung it,"},{"id":"semetey-1-2013:p0867:b003:l011","ordinal":142526,"en":"Made the courser cry out"},{"id":"semetey-1-2013:p0867:b003:l012","ordinal":142527,"en":"With a stroke across its flank."},{"id":"semetey-1-2013:p0867:b003:l013","ordinal":142528,"en":"White reins woven in a special braid,"},{"id":"semetey-1-2013:p0867:b003:l014","ordinal":142529,"en":"Reins fitted to Tuuchunak—"},{"id":"semetey-1-2013:p0867:b003:l015","ordinal":142530,"en":"Steadying him, he let the reins go."},{"id":"semetey-1-2013:p0867:b003:l016","ordinal":142531,"en":"The heroic khan's Tuuchunak"},{"id":"semetey-1-2013:p0867:b003:l017","ordinal":142532,"en":"Lowered his head to the ground,"},{"id":"semetey-1-2013:p0867:b003:l018","ordinal":142533,"en":"Took strides like a mountain sheep,"},{"id":"semetey-1-2013:p0867:b003:l019","ordinal":142534,"en":"Dust billowing behind him."},{"id":"semetey-1-2013:p0867:b003:l020","ordinal":142535,"en":"Clods from his four hooves"},{"id":"semetey-1-2013:p0867:b003:l021","ordinal":142536,"en":"Whistled a lance's length into the air;"},{"id":"semetey-1-2013:p0867:b003:l022","ordinal":142537,"en":"The ground he trod burst apart."},{"id":"semetey-1-2013:p0867:b003:l023","ordinal":142538,"en":"At first they saw him once,"},{"id":"semetey-1-2013:p0867:b003:l024","ordinal":142539,"en":"Then they saw him once again;"},{"id":"semetey-1-2013:p0867:b003:l025","ordinal":142540,"en":"After that, who saw him?"},{"id":"semetey-1-2013:p0867:b003:l026","ordinal":142541,"en":"Before they could utter a sound,"},{"id":"semetey-1-2013:p0867:b003:l027","ordinal":142542,"en":"Before an eye could open and close,"},{"id":"semetey-1-2013:p0867:b003:l028","ordinal":142543,"en":"A blue-mottled cloud gathered in the sky;"},{"id":"semetey-1-2013:p0867:b003:l029","ordinal":142544,"en":"Sary Khan, born a fierce wolf,"},{"id":"semetey-1-2013:p0867:b003:l030","ordinal":142545,"en":"Fled in plain sight and escaped."},{"id":"semetey-1-2013:p0867:b003:l031","ordinal":142546,"en":"To Chachykei's fortress,"},{"id":"semetey-1-2013:p0867:b003:l032","ordinal":142547,"en":"To Kanykei's royal camp,"},{"id":"semetey-1-2013:p0867:b003:l033","ordinal":142548,"en":"Below Tort-Kul,"},{"id":"semetey-1-2013:p0867:b003:l034","ordinal":142549,"en":"To the side of lord Bakai,"},{"id":"semetey-1-2013:p0867:b003:l035","ordinal":142550,"en":"When the dawn broke clear,"},{"id":"semetey-1-2013:p0867:b003:l036","ordinal":142551,"en":"When light fell upon the earth,"},{"id":"semetey-1-2013:p0867:b003:l037","ordinal":142552,"en":"Your uncle Sary reached Talas."},{"id":"semetey-1-2013:p0867:b003:l038","ordinal":142553,"en":"Tuuchunak beneath him"},{"id":"semetey-1-2013:p0867:b003:l039","ordinal":142554,"en":"Had grown hot in the flesh,"},{"id":"semetey-1-2013:p0867:b005:l001","ordinal":142555,"en":"Tossing wildly and struggling,"},{"id":"semetey-1-2013:p0867:b005:l002","ordinal":142556,"en":"Straining as though his man had died,"},{"id":"semetey-1-2013:p0867:b005:l003","ordinal":142557,"en":"Had lowered his head to the ground."},{"id":"semetey-1-2013:p0867:b005:l004","ordinal":142558,"en":"Sary Khan upon him"},{"id":"semetey-1-2013:p0867:b005:l005","ordinal":142559,"en":"Could not gather up the reins and check him;"},{"id":"semetey-1-2013:p0867:b005:l006","ordinal":142560,"en":"He was in great difficulty."},{"id":"semetey-1-2013:p0867:b005:l007","ordinal":142561,"en":"He was covered in swirling dust;"},{"id":"semetey-1-2013:p0867:b005:l008","ordinal":142562,"en":"His whole body, every part,"},{"id":"semetey-1-2013:p0867:b005:l009","ordinal":142563,"en":"Was dark, dusky blood."},{"id":"semetey-1-2013:p0867:b005:l010","ordinal":142564,"en":"If you looked at Sary Khan,"},{"id":"semetey-1-2013:p0867:b005:l011","ordinal":142565,"en":"His two flailing arms"},{"id":"semetey-1-2013:p0867:b005:l012","ordinal":142566,"en":"Could not rise; they were paralyzed."},{"id":"semetey-1-2013:p0867:b005:l013","ordinal":142567,"en":"His dear head, as large as a herdsman's tent—"},{"id":"semetey-1-2013:p0867:b005:l014","ordinal":142568,"en":"May this world be ruined!—"},{"id":"semetey-1-2013:p0867:b005:l015","ordinal":142569,"en":"Was dark, dusky blood."},{"id":"semetey-1-2013:p0867:b005:l016","ordinal":142570,"en":"Fierce-wolf Bakai asked him for news,"},{"id":"semetey-1-2013:p0867:b005:l017","ordinal":142571,"en":"Asked insistently about his suffering:"},{"id":"semetey-1-2013:p0867:b005:l018","ordinal":142572,"en":"“Oh, Sary Khan, my hero,"},{"id":"semetey-1-2013:p0867:b005:l019","ordinal":142573,"en":"What did you see?” he asked."},{"id":"semetey-1-2013:p0867:b005:l020","ordinal":142574,"en":"What he had seen and learned,"},{"id":"semetey-1-2013:p0867:b005:l021","ordinal":142575,"en":"Sary Khan began to tell:"},{"id":"semetey-1-2013:p0867:b005:l022","ordinal":142576,"en":"“Lion Bakai, hear my words."},{"id":"semetey-1-2013:p0867:b005:l023","ordinal":142577,"en":"The Argyn and the Kyrgyz—"},{"id":"semetey-1-2013:p0867:b005:l024","ordinal":142578,"en":"We had come to see them;"},{"id":"semetey-1-2013:p0867:b005:l025","ordinal":142579,"en":"Going as a mediator, I, Sary Khan,"},{"id":"semetey-1-2013:p0867:b005:l026","ordinal":142580,"en":"Had gone to my death."},{"id":"semetey-1-2013:p0867:b005:l027","ordinal":142581,"en":"I saw cliffs no goose could circle,"},{"id":"semetey-1-2013:p0867:b005:l028","ordinal":142582,"en":"I saw seething myriads of enemies."},{"id":"semetey-1-2013:p0867:b005:l029","ordinal":142583,"en":"I saw the land on reaching Urbus;"},{"id":"semetey-1-2013:p0867:b005:l030","ordinal":142584,"en":"I saw heroes Abyke and Kobosh."},{"id":"semetey-1-2013:p0867:b005:l031","ordinal":142585,"en":"An envious multitude"},{"id":"semetey-1-2013:p0867:b005:l032","ordinal":142586,"en":"Of people they had gathered;"},{"id":"semetey-1-2013:p0867:b005:l033","ordinal":142587,"en":"Those who would split lungs and take gall,"},{"id":"semetey-1-2013:p0867:b005:l034","ordinal":142588,"en":"Khans they had gathered."},{"id":"semetey-1-2013:p0867:b005:l035","ordinal":142589,"en":"There were trenches already dug,"},{"id":"semetey-1-2013:p0867:b005:l036","ordinal":142590,"en":"Their army stirred in tens of thousands."},{"id":"semetey-1-2013:p0867:b005:l037","ordinal":142591,"en":"Seven banners came,"},{"id":"semetey-1-2013:p0867:b005:l038","ordinal":142592,"en":"An army that bent the earth came."}]
