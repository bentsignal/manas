{"id": "sayakbay-ms-current146:pdf034:l009", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 34, "folio": 417, "line_in_page": 9, "raw": "Акылынан ажырап,", "text": "Акылынан ажырап,", "en": "Lost their wits,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf034:l010", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 34, "folio": 417, "line_in_page": 10, "raw": "Ат-так куруп, шайланып,", "text": "Ат-так куруп, шайланып,", "en": "Saddling their horses and making ready,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The middle phrase is a difficult manuscript reading, provisionally normalized as ат-так куруп.", "bbox": null}
