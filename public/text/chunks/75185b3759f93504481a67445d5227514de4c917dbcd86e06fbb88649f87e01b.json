[{"id":"semetey-1-2013:p0794:b003:l016","ordinal":137729,"en":"And settled beside his camp,"},{"id":"semetey-1-2013:p0794:b003:l017","ordinal":137730,"en":"Because of what had happened,"},{"id":"semetey-1-2013:p0794:b003:l018","ordinal":137731,"en":"Because of Akerkech,"},{"id":"semetey-1-2013:p0794:b003:l019","ordinal":137732,"en":"Kökchö, the son of Aidarkan,"},{"id":"semetey-1-2013:p0794:b003:l020","ordinal":137733,"en":"We heard he beat him and departed."},{"id":"semetey-1-2013:p0794:b003:l021","ordinal":137734,"en":"Disappointed in Kökchö,"},{"id":"semetey-1-2013:p0794:b003:l022","ordinal":137735,"en":"He moved to Talas,"},{"id":"semetey-1-2013:p0794:b003:l023","ordinal":137736,"en":"Settled there and became a friend"},{"id":"semetey-1-2013:p0794:b003:l024","ordinal":137737,"en":"To your father, Sultan Manas."},{"id":"semetey-1-2013:p0794:b003:l025","ordinal":137738,"en":"Your lion father Manas—"},{"id":"semetey-1-2013:p0794:b003:l026","ordinal":137739,"en":"When God granted his desire,"},{"id":"semetey-1-2013:p0794:b003:l027","ordinal":137740,"en":"When Almam came from China,"},{"id":"semetey-1-2013:p0794:b003:l028","ordinal":137741,"en":"Ajybai and Khan Bakai were there,"},{"id":"semetey-1-2013:p0794:b003:l029","ordinal":137742,"en":"All the wise warriors were there."},{"id":"semetey-1-2013:p0794:b003:l030","ordinal":137743,"en":"To the lion who has come from afar,"},{"id":"semetey-1-2013:p0794:b003:l031","ordinal":137744,"en":"If we do not allot a horse,"},{"id":"semetey-1-2013:p0794:b003:l032","ordinal":137745,"en":"God will punish us severely,” we said,"},{"id":"semetey-1-2013:p0794:b003:l033","ordinal":137746,"en":"“Everyone will gossip,” we said."},{"id":"semetey-1-2013:p0794:b003:l034","ordinal":137747,"en":"We pondered and turned the matter over,"},{"id":"semetey-1-2013:p0794:b003:l035","ordinal":137748,"en":"Loaded wealth upon eighty camels,"},{"id":"semetey-1-2013:p0794:b003:l036","ordinal":137749,"en":"And said, “Go and ask for Aktulpar.”"},{"id":"semetey-1-2013:p0794:b003:l037","ordinal":137750,"en":"Your mother Kanykei"},{"id":"semetey-1-2013:p0794:b003:l038","ordinal":137751,"en":"We then sent to visit her parents."},{"id":"semetey-1-2013:p0794:b003:l039","ordinal":137752,"en":"At that time my dear child Kanykei,"},{"id":"semetey-1-2013:p0794:b004:l001","ordinal":137753,"en":"The loveliest of the dark-complexioned,"},{"id":"semetey-1-2013:p0794:b004:l002","ordinal":137754,"en":"The most radiant of the Muslims,"},{"id":"semetey-1-2013:p0794:b004:l003","ordinal":137755,"en":"Was a young wife of seventeen,"},{"id":"semetey-1-2013:p0794:b004:l004","ordinal":137756,"en":"And a servant beloved by God,"},{"id":"semetey-1-2013:p0794:b004:l005","ordinal":137757,"en":"The youngest of twelve daughters."},{"id":"semetey-1-2013:p0794:b004:l006","ordinal":137758,"en":"Her hair was braided down her back;"},{"id":"semetey-1-2013:p0794:b004:l007","ordinal":137759,"en":"More than all sixty sons"},{"id":"semetey-1-2013:p0794:b004:l008","ordinal":137760,"en":"He loved her."},{"id":"semetey-1-2013:p0794:b004:l009","ordinal":137761,"en":"Kanykei, the lord's wife,"},{"id":"semetey-1-2013:p0794:b004:l010","ordinal":137762,"en":"Went to visit her parents."},{"id":"semetey-1-2013:p0794:b004:l011","ordinal":137763,"en":"The wealth of eighty camels,"},{"id":"semetey-1-2013:p0794:b004:l012","ordinal":137764,"en":"Temirkan gathered it all"},{"id":"semetey-1-2013:p0794:b004:l013","ordinal":137765,"en":"And placed it in his treasury."},{"id":"semetey-1-2013:p0794:b004:l014","ordinal":137766,"en":"He would not agree to her request,"},{"id":"semetey-1-2013:p0794:b004:l015","ordinal":137767,"en":"Would not give Aktulpar."},{"id":"semetey-1-2013:p0794:b004:l016","ordinal":137768,"en":"Leaving her to whine like a howling dog,"},{"id":"semetey-1-2013:p0794:b004:l017","ordinal":137769,"en":"He sent your mother away empty-handed and dejected."},{"id":"semetey-1-2013:p0794:b004:l018","ordinal":137770,"en":"Your fierce father, Khan Manas, said:"},{"id":"semetey-1-2013:p0794:b004:l019","ordinal":137771,"en":"“That wretched shrew will never mend!"},{"id":"semetey-1-2013:p0794:b004:l020","ordinal":137772,"en":"When she is sent to visit her parents,"},{"id":"semetey-1-2013:p0794:b004:l021","ordinal":137773,"en":"She is not worth one of her father's yearlings!”"},{"id":"semetey-1-2013:p0794:b004:l023","ordinal":137774,"en":"Then he brought great sorrow upon her,"},{"id":"semetey-1-2013:p0794:b004:l024","ordinal":137775,"en":"He would not lie in her embrace."},{"id":"semetey-1-2013:p0794:b004:l025","ordinal":137776,"en":"She camped along the river,"},{"id":"semetey-1-2013:p0794:b004:l026","ordinal":137777,"en":"And was a neglected wife for six months."},{"id":"semetey-1-2013:p0794:b004:l027","ordinal":137778,"en":"Your mother Kanykei has her story:"},{"id":"semetey-1-2013:p0794:b004:l028","ordinal":137779,"en":"She ceased calling Temir father"},{"id":"semetey-1-2013:p0794:b004:l029","ordinal":137780,"en":"And became estranged from him."},{"id":"semetey-1-2013:p0794:b004:l030","ordinal":137781,"en":"Do not spoil what can be settled."},{"id":"semetey-1-2013:p0794:b004:l031","ordinal":137782,"en":"If you are a worthy person, my orphan,"},{"id":"semetey-1-2013:p0794:b004:l032","ordinal":137783,"en":"Do not destroy Aktulpar."},{"id":"semetey-1-2013:p0794:b004:l033","ordinal":137784,"en":"He was a khan struck by God,"},{"id":"semetey-1-2013:p0794:b004:l034","ordinal":137785,"en":"A man miserly with livestock."},{"id":"semetey-1-2013:p0794:b004:l035","ordinal":137786,"en":"Please heed what I say,"},{"id":"semetey-1-2013:p0794:b004:l036","ordinal":137787,"en":"My dear orphan;"},{"id":"semetey-1-2013:p0794:b004:l037","ordinal":137788,"en":"Take Aktulpar back"},{"id":"semetey-1-2013:p0794:b004:l038","ordinal":137789,"en":"And return him safe and sound."},{"id":"semetey-1-2013:p0794:b004:l039","ordinal":137790,"en":"Neither drawing close nor making enemies,"},{"id":"semetey-1-2013:p0795:b003:l001","ordinal":137791,"en":"Bring this joy to him."},{"id":"semetey-1-2013:p0795:b003:l002","ordinal":137792,"en":"Your grandfather’s blessing—"},{"id":"semetey-1-2013:p0795:b003:l003","ordinal":137793,"en":"Ask well and receive it."},{"id":"semetey-1-2013:p0795:b003:l004","ordinal":137794,"en":"Go safely and return soon;"},{"id":"semetey-1-2013:p0795:b003:l005","ordinal":137795,"en":"Go without delay and return happy."},{"id":"semetey-1-2013:p0795:b003:l006","ordinal":137796,"en":"The swift Narbuudan is beneath you;"},{"id":"semetey-1-2013:p0795:b003:l007","ordinal":137797,"en":"Rein him in on stony ground."},{"id":"semetey-1-2013:p0795:b003:l008","ordinal":137798,"en":"To your poor widowed mother,"},{"id":"semetey-1-2013:p0795:b003:l009","ordinal":137799,"en":"Say, “I have seen the accomplished Khan Bakai,”"},{"id":"semetey-1-2013:p0795:b003:l011","ordinal":137800,"en":"And convey my heartfelt greetings."},{"id":"semetey-1-2013:p0795:b003:l012","ordinal":137801,"en":"Your mother Kanykei bears a grievance:"},{"id":"semetey-1-2013:p0795:b003:l013","ordinal":137802,"en":"“Your grandfather's face,"},{"id":"semetey-1-2013:p0795:b003:l014","ordinal":137803,"en":"I shall not see while alive, even if I die,”"},{"id":"semetey-1-2013:p0795:b003:l015","ordinal":137804,"en":"She once made that vow."},{"id":"semetey-1-2013:p0795:b003:l016","ordinal":137805,"en":"Once, poor Kanykei,"},{"id":"semetey-1-2013:p0795:b003:l017","ordinal":137806,"en":"Showing the depths of her misery,"},{"id":"semetey-1-2013:p0795:b003:l018","ordinal":137807,"en":"Set ninety-year-old Chiyyrdy"},{"id":"semetey-1-2013:p0795:b003:l019","ordinal":137808,"en":"Upon her shoulders,"},{"id":"semetey-1-2013:p0795:b003:l020","ordinal":137809,"en":"Bound her firmly against her back."},{"id":"semetey-1-2013:p0795:b003:l021","ordinal":137810,"en":"“A gift left by the warrior,” she said,"},{"id":"semetey-1-2013:p0795:b003:l022","ordinal":137811,"en":"And in the fold of her overskirt"},{"id":"semetey-1-2013:p0795:b003:l023","ordinal":137812,"en":"Bound him securely in her care."},{"id":"semetey-1-2013:p0795:b003:l024","ordinal":137813,"en":"When her great wealth had scattered,"},{"id":"semetey-1-2013:p0795:b003:l025","ordinal":137814,"en":"When she fled Talas on foot,"},{"id":"semetey-1-2013:p0795:b003:l026","ordinal":137815,"en":"Renowned throughout the world,"},{"id":"semetey-1-2013:p0795:b003:l027","ordinal":137816,"en":"When she fled, finding no place,"},{"id":"semetey-1-2013:p0795:b003:l028","ordinal":137817,"en":"Never resting two days"},{"id":"semetey-1-2013:p0795:b003:l029","ordinal":137818,"en":"In any one place as she fled,"},{"id":"semetey-1-2013:p0795:b003:l030","ordinal":137819,"en":"Without overshoes, in felt stockings,"},{"id":"semetey-1-2013:p0795:b003:l031","ordinal":137820,"en":"The poor creature wept in sorrow."},{"id":"semetey-1-2013:p0795:b003:l032","ordinal":137821,"en":"Without boots, in felt stockings,"},{"id":"semetey-1-2013:p0795:b003:l033","ordinal":137822,"en":"The wretched creature wept aloud."},{"id":"semetey-1-2013:p0795:b003:l034","ordinal":137823,"en":"She set her face toward Bukhara,"},{"id":"semetey-1-2013:p0795:b003:l035","ordinal":137824,"en":"Carrying both of them alike."},{"id":"semetey-1-2013:p0795:b003:l036","ordinal":137825,"en":"The old woman coughed upon her back;"},{"id":"semetey-1-2013:p0795:b003:l037","ordinal":137826,"en":"Your mother carried the old woman and the child,"},{"id":"semetey-1-2013:p0795:b003:l038","ordinal":137827,"en":"Grieving as she went."},{"id":"semetey-1-2013:p0795:b003:l039","ordinal":137828,"en":"When I, Bakai, learned she had gone,"},{"id":"semetey-1-2013:p0795:b005:l001","ordinal":137829,"en":"I sent Kumaik racing after her trail."},{"id":"semetey-1-2013:p0795:b005:l002","ordinal":137830,"en":"At the reed-grown lake"},{"id":"semetey-1-2013:p0795:b005:l003","ordinal":137831,"en":"I caught up with her alone."},{"id":"semetey-1-2013:p0795:b005:l004","ordinal":137832,"en":"I gave her two fat horses,"},{"id":"semetey-1-2013:p0795:b005:l005","ordinal":137833,"en":"I gave her two leather bottles of milk."},{"id":"semetey-1-2013:p0795:b005:l006","ordinal":137834,"en":"I reached her and slaughtered for her"},{"id":"semetey-1-2013:p0795:b005:l007","ordinal":137835,"en":"A pale, white-blazed wether."},{"id":"semetey-1-2013:p0795:b005:l008","ordinal":137836,"en":"Your poor mother will never forget"},{"id":"semetey-1-2013:p0795:b005:l009","ordinal":137837,"en":"What happened then."},{"id":"semetey-1-2013:p0795:b005:l010","ordinal":137838,"en":"I clothed her in a robe of costly fabric,"},{"id":"semetey-1-2013:p0795:b005:l011","ordinal":137839,"en":"Mounted them on two cloud-like horses,"},{"id":"semetey-1-2013:p0795:b005:l012","ordinal":137840,"en":"Wept and sobbed as I made things ready,"},{"id":"semetey-1-2013:p0795:b005:l013","ordinal":137841,"en":"Told her to go to Bukhara."},{"id":"semetey-1-2013:p0795:b005:l014","ordinal":137842,"en":"My heart was torn,"},{"id":"semetey-1-2013:p0795:b005:l015","ordinal":137843,"en":"The tears poured from my eyes."},{"id":"semetey-1-2013:p0795:b005:l016","ordinal":137844,"en":"As I stood in great sorrow,"},{"id":"semetey-1-2013:p0795:b005:l017","ordinal":137845,"en":"Kanykei spoke a word,"},{"id":"semetey-1-2013:p0795:b005:l018","ordinal":137846,"en":"Words that put sorrow in my breast:"},{"id":"semetey-1-2013:p0795:b005:l019","ordinal":137847,"en":"Then my dear child Kanykei,"},{"id":"semetey-1-2013:p0795:b005:l020","ordinal":137848,"en":"Parted from Khan Manas,"},{"id":"semetey-1-2013:p0795:b005:l021","ordinal":137849,"en":"Trembled beneath her troubles."},{"id":"semetey-1-2013:p0795:b005:l022","ordinal":137850,"en":"Her large, dark head,"},{"id":"semetey-1-2013:p0795:b005:l023","ordinal":137851,"en":"Her bloodied face scratched,"},{"id":"semetey-1-2013:p0795:b005:l024","ordinal":137852,"en":"Her dark hair loose,"},{"id":"semetey-1-2013:p0795:b005:l025","ordinal":137853,"en":"The grief within her had not eased."},{"id":"semetey-1-2013:p0795:b005:l026","ordinal":137854,"en":"It was thirty days since he died,"},{"id":"semetey-1-2013:p0795:b005:l027","ordinal":137855,"en":"Not yet time for his fortieth-day feast."},{"id":"semetey-1-2013:p0795:b005:l028","ordinal":137856,"en":"My dear child Kanykei said:"},{"id":"semetey-1-2013:p0795:b005:l029","ordinal":137857,"en":"A man does not see hair on his face,"},{"id":"semetey-1-2013:p0795:b005:l030","ordinal":137858,"en":"“I shall die before my appointed death."},{"id":"semetey-1-2013:p0795:b005:l031","ordinal":137859,"en":"With my large, dark head,"},{"id":"semetey-1-2013:p0795:b005:l032","ordinal":137860,"en":"How can I face my elder?” she said."},{"id":"semetey-1-2013:p0795:b005:l033","ordinal":137861,"en":"Her voice reached God;"},{"id":"semetey-1-2013:p0795:b005:l034","ordinal":137862,"en":"She fell face down."},{"id":"semetey-1-2013:p0795:b005:l035","ordinal":137863,"en":"My child Kanykei said this,"},{"id":"semetey-1-2013:p0795:b005:l036","ordinal":137864,"en":"Told of a horror unknown to others:"},{"id":"semetey-1-2013:p0795:b005:l037","ordinal":137865,"en":"“My dear elder!"},{"id":"semetey-1-2013:p0795:b005:l038","ordinal":137866,"en":"How shall we attain our desire?"},{"id":"semetey-1-2013:p0795:b005:l039","ordinal":137867,"en":"I left Bukhara weeping."},{"id":"semetey-1-2013:p0796:b003:l001","ordinal":137868,"en":"Because of Aktulpar"},{"id":"semetey-1-2013:p0796:b003:l002","ordinal":137869,"en":"I renounced him as a father."},{"id":"semetey-1-2013:p0796:b003:l003","ordinal":137870,"en":"The ten commands the saints had given,"},{"id":"semetey-1-2013:p0796:b003:l004","ordinal":137871,"en":"I no longer called it a blessing."},{"id":"semetey-1-2013:p0796:b003:l005","ordinal":137872,"en":"That sickle-nosed man"},{"id":"semetey-1-2013:p0796:b003:l006","ordinal":137873,"en":"I no longer called father."},{"id":"semetey-1-2013:p0796:b003:l007","ordinal":137874,"en":"How can I go to my father?"},{"id":"semetey-1-2013:p0796:b003:l008","ordinal":137875,"en":"A widow, standing so proudly,"},{"id":"semetey-1-2013:p0796:b003:l009","ordinal":137876,"en":"How can I look him in the face?”"},{"id":"semetey-1-2013:p0796:b003:l010","ordinal":137877,"en":"Kanykei stood and said:"},{"id":"semetey-1-2013:p0796:b003:l011","ordinal":137878,"en":"“Why should I go to Bukhara?"},{"id":"semetey-1-2013:p0796:b003:l012","ordinal":137879,"en":"Sage elder, give me your blessing;"},{"id":"semetey-1-2013:p0796:b003:l013","ordinal":137880,"en":"Let me carry my orphan"},{"id":"semetey-1-2013:p0796:b003:l014","ordinal":137881,"en":"And go into Kokand."},{"id":"semetey-1-2013:p0796:b003:l015","ordinal":137882,"en":"Then hunted along that one,"},{"id":"semetey-1-2013:p0796:b003:l016","ordinal":137883,"en":"My only child, here—"},{"id":"semetey-1-2013:p0796:b003:l017","ordinal":137884,"en":"When black-hearted Kanykei"},{"id":"semetey-1-2013:p0796:b003:l018","ordinal":137885,"en":"Lay there saying this,"},{"id":"semetey-1-2013:p0796:b003:l019","ordinal":137886,"en":"When she plunged us all into torment,"},{"id":"semetey-1-2013:p0796:b003:l020","ordinal":137887,"en":"I turned Köktulpar's head,"},{"id":"semetey-1-2013:p0796:b003:l021","ordinal":137888,"en":"Beat my own head,"},{"id":"semetey-1-2013:p0796:b003:l022","ordinal":137889,"en":"And stood weeping aloud."},{"id":"semetey-1-2013:p0796:b004:l001","ordinal":137890,"en":"The beard upon my chin"},{"id":"semetey-1-2013:p0796:b004:l002","ordinal":137891,"en":"I plucked out, leaving not a hair."},{"id":"semetey-1-2013:p0796:b004:l003","ordinal":137892,"en":"I struck my own head"},{"id":"semetey-1-2013:p0796:b004:l004","ordinal":137893,"en":"And made this spectacle."},{"id":"semetey-1-2013:p0796:b004:l005","ordinal":137894,"en":"“Oh, Kanykei, my little foal,"},{"id":"semetey-1-2013:p0796:b004:l006","ordinal":137895,"en":"My wretched child, you will not mend;"},{"id":"semetey-1-2013:p0796:b004:l007","ordinal":137896,"en":"You will not abandon your fierceness."},{"id":"semetey-1-2013:p0796:b004:l008","ordinal":137897,"en":"If you go to Kokand, they will do no good;"},{"id":"semetey-1-2013:p0796:b004:l009","ordinal":137898,"en":"They will not leave my orphan unharmed."},{"id":"semetey-1-2013:p0796:b004:l010","ordinal":137899,"en":"When a woman's husband dies,"},{"id":"semetey-1-2013:p0796:b004:l011","ordinal":137900,"en":"Her own family should be close to her."},{"id":"semetey-1-2013:p0796:b004:l012","ordinal":137901,"en":"Make your way toward Temirkan,” I said,"},{"id":"semetey-1-2013:p0796:b004:l013","ordinal":137902,"en":"And hastily sent her on her way."},{"id":"semetey-1-2013:p0796:b004:l014","ordinal":137903,"en":"Do not blunt your steel;"},{"id":"semetey-1-2013:p0796:b004:l015","ordinal":137904,"en":"Do not destroy your white steed."},{"id":"semetey-1-2013:p0796:b004:l016","ordinal":137905,"en":"In the city of Bukhara,"},{"id":"semetey-1-2013:p0796:b004:l017","ordinal":137906,"en":"My dear orphan,"},{"id":"semetey-1-2013:p0796:b004:l018","ordinal":137907,"en":"It would be a disgrace to linger,’"},{"id":"semetey-1-2013:p0796:b004:l019","ordinal":137908,"en":"He said, telling him this,"},{"id":"semetey-1-2013:p0796:b004:l020","ordinal":137909,"en":"Making many things known,"},{"id":"semetey-1-2013:p0796:b004:l021","ordinal":137910,"en":"And sent the orphan, Manas's son,"},{"id":"semetey-1-2013:p0796:b004:l022","ordinal":137911,"en":"On his way toward Bukhara."},{"id":"semetey-1-2013:p0797:b004:l001","ordinal":137912,"en":"Your orphan, the warrior's son,"},{"id":"semetey-1-2013:p0797:b004:l002","ordinal":137913,"en":"When he had set out from Bukhara—"},{"id":"semetey-1-2013:p0797:b004:l003","ordinal":137914,"en":"‘Kanykei, grown old,"},{"id":"semetey-1-2013:p0797:b004:l004","ordinal":137915,"en":"And Chiyyrdy, aged,"},{"id":"semetey-1-2013:p0797:b004:l005","ordinal":137916,"en":"Opened their palms and spread their hands."},{"id":"semetey-1-2013:p0797:b004:l006","ordinal":137917,"en":"“O God!” they cried, spreading them wide,"},{"id":"semetey-1-2013:p0797:b004:l007","ordinal":137918,"en":"Praying and weeping much."},{"id":"semetey-1-2013:p0797:b004:l008","ordinal":137919,"en":"Both my mothers wept,"},{"id":"semetey-1-2013:p0797:b004:l009","ordinal":137920,"en":"Wept, “Come back without delay.”"},{"id":"semetey-1-2013:p0797:b004:l010","ordinal":137921,"en":"My poor mother Chiyyrdy,"},{"id":"semetey-1-2013:p0797:b004:l011","ordinal":137922,"en":"An elder of ninety-five!"},{"id":"semetey-1-2013:p0797:b004:l012","ordinal":137923,"en":"The saint who bore my father Manas"},{"id":"semetey-1-2013:p0797:b004:l013","ordinal":137924,"en":"Had raised a piercing cry."},{"id":"semetey-1-2013:p0797:b004:l014","ordinal":137925,"en":"She had counted the days,"},{"id":"semetey-1-2013:p0797:b004:l015","ordinal":137926,"en":"Written down the days,"},{"id":"semetey-1-2013:p0797:b004:l016","ordinal":137927,"en":"Bound the time with a limit:"},{"id":"semetey-1-2013:p0797:b004:l017","ordinal":137928,"en":"“Ten days to go there,"},{"id":"semetey-1-2013:p0797:b004:l018","ordinal":137929,"en":"Ten days to stay among the people,"},{"id":"semetey-1-2013:p0797:b004:l019","ordinal":137930,"en":"Ten days to return,"},{"id":"semetey-1-2013:p0797:b004:l020","ordinal":137931,"en":"Three periods—thirty days."},{"id":"semetey-1-2013:p0797:b004:l021","ordinal":137932,"en":"If you do not return in thirty days,”"},{"id":"semetey-1-2013:p0797:b004:l022","ordinal":137933,"en":"Those were my mother's words,"},{"id":"semetey-1-2013:p0797:b004:l023","ordinal":137934,"en":"My poor mother said, “Before my appointed death,"},{"id":"semetey-1-2013:p0797:b004:l024","ordinal":137935,"en":"I shall die.”"},{"id":"semetey-1-2013:p0797:b004:l025","ordinal":137936,"en":"Hunched like a kneeling camel,"},{"id":"semetey-1-2013:p0797:b004:l026","ordinal":137937,"en":"My mother, bowed down,"},{"id":"semetey-1-2013:p0797:b004:l027","ordinal":137938,"en":"Let her tears stream,"},{"id":"semetey-1-2013:p0797:b004:l028","ordinal":137939,"en":"My mother poured them out."},{"id":"semetey-1-2013:p0797:b004:l029","ordinal":137940,"en":"If I am two days late,"},{"id":"semetey-1-2013:p0797:b004:l030","ordinal":137941,"en":"Will an untimely death take her?"},{"id":"semetey-1-2013:p0797:b004:l031","ordinal":137942,"en":"Will she die in sorrow?"},{"id":"semetey-1-2013:p0797:b004:l032","ordinal":137943,"en":"Her appointed time is thirty days."},{"id":"semetey-1-2013:p0797:b004:l033","ordinal":137944,"en":"Will my mother die,"},{"id":"semetey-1-2013:p0797:b004:l034","ordinal":137945,"en":"And bring calamity upon us?’"},{"id":"semetey-1-2013:p0797:b004:l035","ordinal":137946,"en":"He traveled in haste,"},{"id":"semetey-1-2013:p0797:b004:l036","ordinal":137947,"en":"Covered much ground, sparing no horse."},{"id":"semetey-1-2013:p0797:b005:l001","ordinal":137948,"en":"Narbuudan beneath him,"},{"id":"semetey-1-2013:p0797:b005:l002","ordinal":137949,"en":"When the orphan boy mounted,"},{"id":"semetey-1-2013:p0797:b005:l003","ordinal":137950,"en":"Taibuurul that day—"},{"id":"semetey-1-2013:p0797:b005:l004","ordinal":137951,"en":"I do not know; if it is true—"},{"id":"semetey-1-2013:p0797:b005:l005","ordinal":137952,"en":"That day was in his prime."},{"id":"semetey-1-2013:p0797:b005:l006","ordinal":137953,"en":"When his sacred mane was grasped,"},{"id":"semetey-1-2013:p0797:b005:l007","ordinal":137954,"en":"Every fiber of his flesh was in condition."},{"id":"semetey-1-2013:p0797:b005:l008","ordinal":137955,"en":"He was ready to stretch out"},{"id":"semetey-1-2013:p0797:b005:l009","ordinal":137956,"en":"Upon the long road,"},{"id":"semetey-1-2013:p0797:b005:l010","ordinal":137957,"en":"Ready to speed like a winged creature"},{"id":"semetey-1-2013:p0797:b005:l011","ordinal":137958,"en":"And fly."},{"id":"semetey-1-2013:p0797:b005:l012","ordinal":137959,"en":"For twelve years"},{"id":"semetey-1-2013:p0797:b005:l013","ordinal":137960,"en":"He had grazed at liberty."},{"id":"semetey-1-2013:p0797:b005:l014","ordinal":137961,"en":"That Semetey would come,"},{"id":"semetey-1-2013:p0797:b005:l015","ordinal":137962,"en":"Though an animal, a living creature,"},{"id":"semetey-1-2013:p0797:b005:l016","ordinal":137963,"en":"He had known that year."},{"id":"semetey-1-2013:p0797:b005:l017","ordinal":137964,"en":"The armful of tail"},{"id":"semetey-1-2013:p0797:b005:l018","ordinal":137965,"en":"Of that roan horse you have seen"},{"id":"semetey-1-2013:p0797:b005:l019","ordinal":137966,"en":"Streamed out strand by strand."},{"id":"semetey-1-2013:p0797:b005:l020","ordinal":137967,"en":"When the poor boy mounted,"},{"id":"semetey-1-2013:p0797:b005:l021","ordinal":137968,"en":"My precious Taibuurul"},{"id":"semetey-1-2013:p0797:b005:l022","ordinal":137969,"en":"Brightened altogether."},{"id":"semetey-1-2013:p0797:b005:l023","ordinal":137970,"en":"Now your orphan, Manas's son,"},{"id":"semetey-1-2013:p0797:b005:l025","ordinal":137971,"en":"Had grown to maturity as an orphan,"},{"id":"semetey-1-2013:p0797:b005:l026","ordinal":137972,"en":"And thus joined his people."},{"id":"semetey-1-2013:p0797:b005:l027","ordinal":137973,"en":"He had grown up and become a warrior,"},{"id":"semetey-1-2013:p0797:b005:l028","ordinal":137974,"en":"The equal of a warrior's son."},{"id":"semetey-1-2013:p0797:b005:l029","ordinal":137975,"en":"Everyone who saw him was moved:"},{"id":"semetey-1-2013:p0797:b005:l030","ordinal":137976,"en":"The departed, fierce Manas—"},{"id":"semetey-1-2013:p0797:b005:l031","ordinal":137977,"en":"He looked exactly like him."},{"id":"semetey-1-2013:p0797:b005:l032","ordinal":137978,"en":"Khan Manas's Akolpok"},{"id":"semetey-1-2013:p0797:b005:l033","ordinal":137979,"en":"The orphan boy now put on."},{"id":"semetey-1-2013:p0797:b005:l034","ordinal":137980,"en":"With one set of nine buttons,"},{"id":"semetey-1-2013:p0797:b005:l035","ordinal":137981,"en":"From mountain-like Manas,"},{"id":"semetey-1-2013:p0797:b005:l036","ordinal":137982,"en":"The armor left as an inheritance,"},{"id":"semetey-1-2013:p0798:b003:l001","ordinal":137983,"en":"He fastened its buttons."},{"id":"semetey-1-2013:p0798:b003:l002","ordinal":137984,"en":"Its ties were one set of nine;"}]
