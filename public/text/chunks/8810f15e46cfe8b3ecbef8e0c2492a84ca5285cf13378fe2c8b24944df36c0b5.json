[{"id":"semetey-1-2013:p0700:b004:l039","ordinal":130561,"en":"He darted toward the hut."},{"id":"semetey-1-2013:p0700:b004:l040","ordinal":130562,"en":"Your orphan came running at a sprint."},{"id":"semetey-1-2013:p0701:b004:l001","ordinal":130563,"en":"Semetey, left behind by Manas,"},{"id":"semetey-1-2013:p0701:b004:l002","ordinal":130564,"en":"His thoughts distracted,"},{"id":"semetey-1-2013:p0701:b004:l003","ordinal":130565,"en":"Sat pondering,"},{"id":"semetey-1-2013:p0701:b004:l004","ordinal":130566,"en":"And what your valiant, hapless mother"},{"id":"semetey-1-2013:p0701:b004:l005","ordinal":130567,"en":"Had said appeared before his eyes."},{"id":"semetey-1-2013:p0701:b004:l006","ordinal":130568,"en":"“My mother Kanykei had said:"},{"id":"semetey-1-2013:p0701:b004:l007","ordinal":130569,"en":"‘If you reach Talas safely,"},{"id":"semetey-1-2013:p0701:b004:l008","ordinal":130570,"en":"Almambet's orphan son"},{"id":"semetey-1-2013:p0701:b004:l009","ordinal":130571,"en":"Bring back with you,’ she said."},{"id":"semetey-1-2013:p0701:b004:l010","ordinal":130572,"en":"‘His very presence is a mighty support;"},{"id":"semetey-1-2013:p0701:b004:l011","ordinal":130573,"en":"If that child lives and grows,"},{"id":"semetey-1-2013:p0701:b004:l012","ordinal":130574,"en":"No enemy will come raiding."},{"id":"semetey-1-2013:p0701:b004:l013","ordinal":130575,"en":"That hero will be your shelter,"},{"id":"semetey-1-2013:p0701:b004:l014","ordinal":130576,"en":"A lion greater than you,’ she said."},{"id":"semetey-1-2013:p0701:b004:l015","ordinal":130577,"en":"‘When he matures and grows,"},{"id":"semetey-1-2013:p0701:b004:l016","ordinal":130578,"en":"He will be a blazing red ember,’ she said."},{"id":"semetey-1-2013:p0701:b004:l017","ordinal":130579,"en":"‘In this faithless, transient world,"},{"id":"semetey-1-2013:p0701:b004:l018","ordinal":130580,"en":"None like him has been created,’ she said."},{"id":"semetey-1-2013:p0701:b004:l019","ordinal":130581,"en":"‘If you make him your companion,"},{"id":"semetey-1-2013:p0701:b004:l020","ordinal":130582,"en":"He is a bold one who will rout generals,’ she said."},{"id":"semetey-1-2013:p0701:b004:l021","ordinal":130583,"en":"‘If you make him your companion,"},{"id":"semetey-1-2013:p0701:b004:l022","ordinal":130584,"en":"My only son, he is braver than you,’ she said."},{"id":"semetey-1-2013:p0701:b004:l023","ordinal":130585,"en":"He did not give up his honor."},{"id":"semetey-1-2013:p0701:b004:l024","ordinal":130586,"en":"‘Through eighteen thousand worlds"},{"id":"semetey-1-2013:p0701:b004:l025","ordinal":130587,"en":"His plea will reach,’ she said."},{"id":"semetey-1-2013:p0701:b004:l026","ordinal":130588,"en":"‘He is a bullet that strikes red-hot,’ she said."},{"id":"semetey-1-2013:p0701:b004:l027","ordinal":130589,"en":"‘Bring him back here;"},{"id":"semetey-1-2013:p0701:b004:l028","ordinal":130590,"en":"In all the ages there is none like him,’ she said."},{"id":"semetey-1-2013:p0701:b004:l029","ordinal":130591,"en":"‘When he faces an adversary,"},{"id":"semetey-1-2013:p0701:b004:l030","ordinal":130592,"en":"He is steeped poison,’ she said."},{"id":"semetey-1-2013:p0701:b004:l031","ordinal":130593,"en":"‘When he faces one in combat,"},{"id":"semetey-1-2013:p0701:b004:l032","ordinal":130594,"en":"He is an unfallen blue banner,’ she said."},{"id":"semetey-1-2013:p0701:b004:l033","ordinal":130595,"en":"‘Charging into the enemy,"},{"id":"semetey-1-2013:p0701:b004:l034","ordinal":130596,"en":"He is red tumult raising strife,’ she said."},{"id":"semetey-1-2013:p0701:b004:l035","ordinal":130597,"en":"Those were my mother's words."},{"id":"semetey-1-2013:p0701:b004:l036","ordinal":130598,"en":"‘On your lowland side are Russians;"},{"id":"semetey-1-2013:p0701:b004:l037","ordinal":130599,"en":"On your highland side are Chinese."},{"id":"semetey-1-2013:p0701:b005:l001","ordinal":130600,"en":"You have many foes to fight to the death."},{"id":"semetey-1-2013:p0701:b005:l002","ordinal":130601,"en":"Take my words to heart and come;"},{"id":"semetey-1-2013:p0701:b005:l003","ordinal":130602,"en":"From your wolf-maned sworn father,"},{"id":"semetey-1-2013:p0701:b005:l004","ordinal":130603,"en":"The one gift plainly left behind,"},{"id":"semetey-1-2013:p0701:b005:l005","ordinal":130604,"en":"Bring Kulchoro with you!"},{"id":"semetey-1-2013:p0701:b005:l006","ordinal":130605,"en":"If you bring the warrior,"},{"id":"semetey-1-2013:p0701:b005:l007","ordinal":130606,"en":"He is strength bound to your waist,’ she said."},{"id":"semetey-1-2013:p0701:b005:l008","ordinal":130607,"en":"‘If an enemy confronts him,"},{"id":"semetey-1-2013:p0701:b005:l009","ordinal":130608,"en":"He never weakens and yields."},{"id":"semetey-1-2013:p0701:b005:l010","ordinal":130609,"en":"Than your sworn father Almam,"},{"id":"semetey-1-2013:p0701:b005:l011","ordinal":130610,"en":"He is a lion born greater,’ she said."},{"id":"semetey-1-2013:p0701:b005:l012","ordinal":130611,"en":"‘He is strength bound to your waist,’ she said."},{"id":"semetey-1-2013:p0701:b005:l013","ordinal":130612,"en":"‘When he matures into a hero,"},{"id":"semetey-1-2013:p0701:b005:l014","ordinal":130613,"en":"And stands equal among heroes' sons,"},{"id":"semetey-1-2013:p0701:b005:l015","ordinal":130614,"en":"He is a lion greater than you,’ she said."},{"id":"semetey-1-2013:p0701:b005:l016","ordinal":130615,"en":"‘His protector is Kozhosan;"},{"id":"semetey-1-2013:p0701:b005:l017","ordinal":130616,"en":"Those opening his path are the Forty Saints."},{"id":"semetey-1-2013:p0701:b005:l018","ordinal":130617,"en":"Such is Kulchoro's nature."},{"id":"semetey-1-2013:p0701:b005:l019","ordinal":130618,"en":"If you abandon him, you will earn disgrace;"},{"id":"semetey-1-2013:p0701:b005:l020","ordinal":130619,"en":"Kulchoro is entrusted to you.’"},{"id":"semetey-1-2013:p0701:b005:l021","ordinal":130620,"en":"My mother has her wisdom;"},{"id":"semetey-1-2013:p0701:b005:l022","ordinal":130621,"en":"My precious, hapless mother"},{"id":"semetey-1-2013:p0701:b005:l023","ordinal":130622,"en":"Entrusted him to me.”"},{"id":"semetey-1-2013:p0701:b005:l024","ordinal":130623,"en":"Saying this, Semetey,"},{"id":"semetey-1-2013:p0701:b005:l025","ordinal":130624,"en":"The orphan child left by Manas,"},{"id":"semetey-1-2013:p0701:b005:l026","ordinal":130625,"en":"Stirred and straightened himself."},{"id":"semetey-1-2013:p0701:b005:l027","ordinal":130626,"en":"Greater than his father, generous Manas,"},{"id":"semetey-1-2013:p0701:b005:l028","ordinal":130627,"en":"Was that noble hero born,"},{"id":"semetey-1-2013:p0701:b005:l029","ordinal":130628,"en":"That noble lion like a cock."},{"id":"semetey-1-2013:p0701:b005:l030","ordinal":130629,"en":"When the orphan stirred and looked,"},{"id":"semetey-1-2013:p0701:b005:l031","ordinal":130630,"en":"Running this way came"},{"id":"semetey-1-2013:p0701:b005:l032","ordinal":130631,"en":"A naked six-year-old child,"},{"id":"semetey-1-2013:p0701:b005:l033","ordinal":130632,"en":"Striking his own thighs with a whip,"},{"id":"semetey-1-2013:p0701:b005:l034","ordinal":130633,"en":"Making a game of it."},{"id":"semetey-1-2013:p0701:b005:l035","ordinal":130634,"en":"An old black fur cap"},{"id":"semetey-1-2013:p0701:b005:l036","ordinal":130635,"en":"They had taken for their kokboru game,"},{"id":"semetey-1-2013:p0701:b005:l037","ordinal":130636,"en":"Chasing one another in delight."},{"id":"semetey-1-2013:p0702:b003:l001","ordinal":130637,"en":"Bending their knees toward the earth,"},{"id":"semetey-1-2013:p0702:b003:l002","ordinal":130638,"en":"Among those children"},{"id":"semetey-1-2013:p0702:b003:l003","ordinal":130639,"en":"Kulchoro came running."},{"id":"semetey-1-2013:p0702:b003:l004","ordinal":130640,"en":"When he looked at Kulchoro,"},{"id":"semetey-1-2013:p0702:b003:l005","ordinal":130641,"en":"Barefoot and bareheaded,"},{"id":"semetey-1-2013:p0702:b003:l006","ordinal":130642,"en":"Your Alake Khan's child"},{"id":"semetey-1-2013:p0702:b003:l007","ordinal":130643,"en":"Was naked, without clothes."},{"id":"semetey-1-2013:p0702:b003:l008","ordinal":130644,"en":"When he saw Kulchoro,"},{"id":"semetey-1-2013:p0702:b003:l009","ordinal":130645,"en":"He thundered in anger;"},{"id":"semetey-1-2013:p0702:b003:l010","ordinal":130646,"en":"Then grief burned fiercely within him,"},{"id":"semetey-1-2013:p0702:b003:l011","ordinal":130647,"en":"And he wept, his voice booming."},{"id":"semetey-1-2013:p0702:b003:l012","ordinal":130648,"en":"Your hero, called brave Seme,"},{"id":"semetey-1-2013:p0702:b003:l013","ordinal":130649,"en":"His noble eyes like a saker's,"},{"id":"semetey-1-2013:p0702:b003:l014","ordinal":130650,"en":"Held tears without blinking."},{"id":"semetey-1-2013:p0702:b003:l015","ordinal":130651,"en":"The reason tears filled them:"},{"id":"semetey-1-2013:p0702:b003:l016","ordinal":130652,"en":"His heart was sorely troubled;"},{"id":"semetey-1-2013:p0702:b003:l017","ordinal":130653,"en":"The dear child he longed to see"},{"id":"semetey-1-2013:p0702:b003:l018","ordinal":130654,"en":"Appeared naked before his eyes."},{"id":"semetey-1-2013:p0702:b003:l019","ordinal":130655,"en":"“He too is a spring of a broad valley's river,"},{"id":"semetey-1-2013:p0702:b003:l020","ordinal":130656,"en":"My lionlike sworn father's"},{"id":"semetey-1-2013:p0702:b003:l021","ordinal":130657,"en":"Light, gained late in life."},{"id":"semetey-1-2013:p0702:b003:l022","ordinal":130658,"en":"Vast treasure and red gold,"},{"id":"semetey-1-2013:p0702:b003:l023","ordinal":130659,"en":"For longing for one child,"},{"id":"semetey-1-2013:p0702:b003:l024","ordinal":130660,"en":"He spent and scattered."},{"id":"semetey-1-2013:p0702:b003:l025","ordinal":130661,"en":"For a single camel-calf child from God,"},{"id":"semetey-1-2013:p0702:b003:l026","ordinal":130662,"en":"He pleaded in such misery."},{"id":"semetey-1-2013:p0702:b003:l027","ordinal":130663,"en":"The bridle kept for the lion's horse,"},{"id":"semetey-1-2013:p0702:b003:l028","ordinal":130664,"en":"The only son of a renowned khan—"},{"id":"semetey-1-2013:p0702:b003:l029","ordinal":130665,"en":"O God, does he live like this?!”"},{"id":"semetey-1-2013:p0702:b003:l030","ordinal":130666,"en":"Saying this, Semetey"},{"id":"semetey-1-2013:p0702:b003:l031","ordinal":130667,"en":"Opened his cavernous mouth,"},{"id":"semetey-1-2013:p0702:b003:l032","ordinal":130668,"en":"And Almambet's child,"},{"id":"semetey-1-2013:p0702:b003:l033","ordinal":130669,"en":"The orphan Kulchoro,"},{"id":"semetey-1-2013:p0702:b003:l034","ordinal":130670,"en":"He clasped to his breast."},{"id":"semetey-1-2013:p0702:b003:l035","ordinal":130671,"en":"Then, like the hairs of a white antelope,"},{"id":"semetey-1-2013:p0702:b003:l036","ordinal":130672,"en":"They became dearest friends;"},{"id":"semetey-1-2013:p0702:b003:l037","ordinal":130673,"en":"Like flour of white wheat,"},{"id":"semetey-1-2013:p0702:b003:l038","ordinal":130674,"en":"They mingled like kneaded dough."},{"id":"semetey-1-2013:p0702:b003:l039","ordinal":130675,"en":"“Make him like the morning star in heaven,"},{"id":"semetey-1-2013:p0702:b004:l001","ordinal":130676,"en":"They caressed one another."},{"id":"semetey-1-2013:p0702:b004:l002","ordinal":130677,"en":"The two orphans came together,"},{"id":"semetey-1-2013:p0702:b004:l003","ordinal":130678,"en":"And were united."},{"id":"semetey-1-2013:p0702:b004:l004","ordinal":130679,"en":"Their voices joined in equal weeping;"},{"id":"semetey-1-2013:p0702:b004:l005","ordinal":130680,"en":"They raised a booming lament."},{"id":"semetey-1-2013:p0702:b004:l006","ordinal":130681,"en":"While the orphans wept,"},{"id":"semetey-1-2013:p0702:b004:l007","ordinal":130682,"en":"Old Bakai wept blood;"},{"id":"semetey-1-2013:p0702:b004:l008","ordinal":130683,"en":"All the people wept."},{"id":"semetey-1-2013:p0702:b004:l009","ordinal":130684,"en":"Seeing these two,"},{"id":"semetey-1-2013:p0702:b004:l010","ordinal":130685,"en":"All sorrowful ones cried in grief."},{"id":"semetey-1-2013:p0702:b004:l011","ordinal":130686,"en":"Grown men wept, the people wept;"},{"id":"semetey-1-2013:p0702:b004:l012","ordinal":130687,"en":"All who remembered wept."},{"id":"semetey-1-2013:p0702:b004:l013","ordinal":130688,"en":"Not birches, but willows wept;"},{"id":"semetey-1-2013:p0702:b004:l014","ordinal":130689,"en":"Everyone who watched wept."},{"id":"semetey-1-2013:p0702:b004:l015","ordinal":130690,"en":"The children of lion heroes,"},{"id":"semetey-1-2013:p0702:b004:l016","ordinal":130691,"en":"Lost and straying, found each other."},{"id":"semetey-1-2013:p0702:b004:l017","ordinal":130692,"en":"The children of oceanlike heroes,"},{"id":"semetey-1-2013:p0702:b004:l018","ordinal":130693,"en":"Wandering, met each other."},{"id":"semetey-1-2013:p0702:b004:l019","ordinal":130694,"en":"Then they embraced and sobbed;"},{"id":"semetey-1-2013:p0702:b004:l020","ordinal":130695,"en":"The two orphans cried aloud."},{"id":"semetey-1-2013:p0702:b004:l021","ordinal":130696,"en":"Their bones pressed against each other,"},{"id":"semetey-1-2013:p0702:b004:l022","ordinal":130697,"en":"Their arms entwined."},{"id":"semetey-1-2013:p0702:b004:l023","ordinal":130698,"en":"Lost ones were recovered;"},{"id":"semetey-1-2013:p0702:b004:l024","ordinal":130699,"en":"The wandering orphan was found."},{"id":"semetey-1-2013:p0702:b004:l025","ordinal":130700,"en":"That wondrous hero, Manas's son,"},{"id":"semetey-1-2013:p0702:b004:l026","ordinal":130701,"en":"Made ready and spoke his lament:"},{"id":"semetey-1-2013:p0702:b004:l027","ordinal":130702,"en":"“Parched, without water,"},{"id":"semetey-1-2013:p0702:b004:l028","ordinal":130703,"en":"There is a wretch like a desert."},{"id":"semetey-1-2013:p0702:b004:l029","ordinal":130704,"en":"Wandering, unable to see his form,"},{"id":"semetey-1-2013:p0702:b004:l030","ordinal":130705,"en":"Is there a wretch like me?!"},{"id":"semetey-1-2013:p0702:b004:l031","ordinal":130706,"en":"The offspring of a noble-steed khan,"},{"id":"semetey-1-2013:p0702:b004:l032","ordinal":130707,"en":"Living by fleeing and wandering—"},{"id":"semetey-1-2013:p0702:b004:l033","ordinal":130708,"en":"O leopard father, do not die;"},{"id":"semetey-1-2013:p0702:b004:l034","ordinal":130709,"en":"Let this wretched soul not see sorrow!"},{"id":"semetey-1-2013:p0702:b004:l035","ordinal":130710,"en":"This wretched life of wandering,"},{"id":"semetey-1-2013:p0702:b004:l036","ordinal":130711,"en":"If You create us as living souls,"},{"id":"semetey-1-2013:p0702:b004:l037","ordinal":130712,"en":"Do not grant it to Your mortal creatures.”"},{"id":"semetey-1-2013:p0702:b004:l038","ordinal":130713,"en":"Thus Semetey sobbed;"},{"id":"semetey-1-2013:p0702:b004:l039","ordinal":130714,"en":"Six-year-old Kulchoro"},{"id":"semetey-1-2013:p0703:b003:l001","ordinal":130715,"en":"Wept and cried aloud like this:"},{"id":"semetey-1-2013:p0703:b003:l002","ordinal":130716,"en":"“My prop when I strive upward,"},{"id":"semetey-1-2013:p0703:b003:l003","ordinal":130717,"en":"Has my support, my elder brother, come?!"},{"id":"semetey-1-2013:p0703:b003:l004","ordinal":130718,"en":"The one I have long taken as my strength,"},{"id":"semetey-1-2013:p0703:b003:l005","ordinal":130719,"en":"Has my lion brother come?!"},{"id":"semetey-1-2013:p0703:b003:l006","ordinal":130720,"en":"Brother, I have spent so long tending lambs."},{"id":"semetey-1-2013:p0703:b003:l007","ordinal":130721,"en":"Alas for my fate! ‘My elder brother,"},{"id":"semetey-1-2013:p0703:b003:l008","ordinal":130722,"en":"When will he come?’ I kept asking."},{"id":"semetey-1-2013:p0703:b003:l009","ordinal":130723,"en":"Crying out my grief,"},{"id":"semetey-1-2013:p0703:b003:l010","ordinal":130724,"en":"I sobbed and lamented much."},{"id":"semetey-1-2013:p0703:b003:l011","ordinal":130725,"en":"To Temirkan's city,"},{"id":"semetey-1-2013:p0703:b003:l012","ordinal":130726,"en":"How have you fared in wandering?"},{"id":"semetey-1-2013:p0703:b003:l013","ordinal":130727,"en":"‘When will my ocean come?’"},{"id":"semetey-1-2013:p0703:b003:l014","ordinal":130728,"en":"How have I fared, waiting forlorn?!"},{"id":"semetey-1-2013:p0703:b003:l015","ordinal":130729,"en":"The children of noble-steed khans,"},{"id":"semetey-1-2013:p0703:b003:l016","ordinal":130730,"en":"Separated in different places—"},{"id":"semetey-1-2013:p0703:b003:l017","ordinal":130731,"en":"Is it right for us to suffer humiliation?!"},{"id":"semetey-1-2013:p0703:b003:l018","ordinal":130732,"en":"Alas, brother, where are our people now?!"},{"id":"semetey-1-2013:p0703:b003:l019","ordinal":130733,"en":"The children of princes—"},{"id":"semetey-1-2013:p0703:b003:l020","ordinal":130734,"en":"Is it right for us to live in flight?!"},{"id":"semetey-1-2013:p0703:b003:l021","ordinal":130735,"en":"Alas for this wretched life, brother—where are our people?!"},{"id":"semetey-1-2013:p0703:b003:l022","ordinal":130736,"en":"The offspring of nobles—"},{"id":"semetey-1-2013:p0703:b003:l023","ordinal":130737,"en":"Is it right for us to wander in exile?"},{"id":"semetey-1-2013:p0703:b003:l024","ordinal":130738,"en":"My valiant brother, where are our people?"},{"id":"semetey-1-2013:p0703:b003:l025","ordinal":130739,"en":"A prince's offspring—"},{"id":"semetey-1-2013:p0703:b003:l026","ordinal":130740,"en":"Should such a soul live in flight?"},{"id":"semetey-1-2013:p0703:b003:l027","ordinal":130741,"en":"My leopard brother, where are our people?!"},{"id":"semetey-1-2013:p0703:b003:l028","ordinal":130742,"en":"A noble hero's child—"},{"id":"semetey-1-2013:p0703:b003:l029","ordinal":130743,"en":"Should he live wandering,"},{"id":"semetey-1-2013:p0703:b003:l030","ordinal":130744,"en":"Yearning, unable to find the other?"},{"id":"semetey-1-2013:p0703:b003:l031","ordinal":130745,"en":"Can one prosper living like this!"},{"id":"semetey-1-2013:p0703:b003:l032","ordinal":130746,"en":"The children of princes—"},{"id":"semetey-1-2013:p0703:b003:l033","ordinal":130747,"en":"Should they live in flight,"},{"id":"semetey-1-2013:p0703:b003:l034","ordinal":130748,"en":"Parted from their countless people?"},{"id":"semetey-1-2013:p0703:b003:l035","ordinal":130749,"en":"Can a grieving man prosper!"},{"id":"semetey-1-2013:p0703:b003:l036","ordinal":130750,"en":"May this false world perish!"},{"id":"semetey-1-2013:p0703:b003:l037","ordinal":130751,"en":"Born from the womb, I saw only night."},{"id":"semetey-1-2013:p0703:b003:l038","ordinal":130752,"en":"Without a brother like you to bring me joy,"},{"id":"semetey-1-2013:p0703:b003:l039","ordinal":130753,"en":"I lived in servitude!"},{"id":"semetey-1-2013:p0703:b004:l001","ordinal":130754,"en":"God has troubled my thoughts."},{"id":"semetey-1-2013:p0703:b004:l002","ordinal":130755,"en":"The blows those dogs struck—"},{"id":"semetey-1-2013:p0703:b004:l003","ordinal":130756,"en":"Will they ever leave my aching bones!?"},{"id":"semetey-1-2013:p0703:b004:l004","ordinal":130757,"en":"Breaking me in like an untrained yearling,"},{"id":"semetey-1-2013:p0703:b004:l005","ordinal":130758,"en":"Each dog in turn snatched me away,"},{"id":"semetey-1-2013:p0703:b004:l006","ordinal":130759,"en":"Dragging me back and forth,"},{"id":"semetey-1-2013:p0703:b004:l007","ordinal":130760,"en":"Humiliating me without mercy."},{"id":"semetey-1-2013:p0703:b004:l008","ordinal":130761,"en":"Back and forth they dragged the orphan,"},{"id":"semetey-1-2013:p0703:b004:l009","ordinal":130762,"en":"Tossing and beating me like a kokboru prize."},{"id":"semetey-1-2013:p0703:b004:l010","ordinal":130763,"en":"My whole body shattered,"},{"id":"semetey-1-2013:p0703:b004:l011","ordinal":130764,"en":"Every bone throbbed."},{"id":"semetey-1-2013:p0703:b004:l012","ordinal":130765,"en":"If I lament, will God take me?"},{"id":"semetey-1-2013:p0703:b004:l013","ordinal":130766,"en":"The cruelty those dogs inflicted—"},{"id":"semetey-1-2013:p0703:b004:l014","ordinal":130767,"en":"Will it ever leave my aching bones?"},{"id":"semetey-1-2013:p0703:b004:l015","ordinal":130768,"en":"Abyke and Kobosh, two villains—"},{"id":"semetey-1-2013:p0703:b004:l016","ordinal":130769,"en":"From them I suffered humiliation."},{"id":"semetey-1-2013:p0703:b004:l017","ordinal":130770,"en":"Chyibyt and Kochkor, making four villains—"},{"id":"semetey-1-2013:p0703:b004:l018","ordinal":130771,"en":"From them I suffered violence."},{"id":"semetey-1-2013:p0703:b004:l019","ordinal":130772,"en":"Adybai and Kolbai, making six villains—"},{"id":"semetey-1-2013:p0703:b004:l020","ordinal":130773,"en":"From them I suffered humiliation."},{"id":"semetey-1-2013:p0703:b004:l021","ordinal":130774,"en":"To take my turn at shaming them,"},{"id":"semetey-1-2013:p0703:b004:l022","ordinal":130775,"en":"To raise an uproar and tumult,"},{"id":"semetey-1-2013:p0703:b004:l023","ordinal":130776,"en":"The moon is dark and the night is thin;"},{"id":"semetey-1-2013:p0703:b004:l024","ordinal":130777,"en":"In wretched childhood my strength is small."},{"id":"semetey-1-2013:p0703:b004:l025","ordinal":130778,"en":"I have endured humiliation so long."},{"id":"semetey-1-2013:p0703:b004:l026","ordinal":130779,"en":"‘Alas, my leopard brother,"},{"id":"semetey-1-2013:p0703:b004:l027","ordinal":130780,"en":"When will he come?’ I kept asking."},{"id":"semetey-1-2013:p0703:b004:l028","ordinal":130781,"en":"If my elder brother turns back,"},{"id":"semetey-1-2013:p0703:b004:l029","ordinal":130782,"en":"And comes to settle in Talas,"},{"id":"semetey-1-2013:p0703:b004:l030","ordinal":130783,"en":"If I move my camp from Keng-Kol,"},{"id":"semetey-1-2013:p0703:b004:l031","ordinal":130784,"en":"Upon those swaggering dogs"},{"id":"semetey-1-2013:p0703:b004:l032","ordinal":130785,"en":"I long to take revenge."},{"id":"semetey-1-2013:p0703:b004:l033","ordinal":130786,"en":"Moving my camp from Talas—"},{"id":"semetey-1-2013:p0703:b004:l034","ordinal":130787,"en":"Damn this childhood!"},{"id":"semetey-1-2013:p0703:b004:l035","ordinal":130788,"en":"I cannot take revenge upon those dogs."},{"id":"semetey-1-2013:p0703:b004:l036","ordinal":130789,"en":"His ribs have not yet filled out;"},{"id":"semetey-1-2013:p0703:b004:l037","ordinal":130790,"en":"My time to contend with those dogs has not come."},{"id":"semetey-1-2013:p0703:b004:l039","ordinal":130791,"en":"The flesh of his calves was not yet full;"},{"id":"semetey-1-2013:p0704:b003:l001","ordinal":130792,"en":"My time to wrestle those dogs from the saddle has not come."},{"id":"semetey-1-2013:p0704:b003:l002","ordinal":130793,"en":"If my brother comes, full-grown,"},{"id":"semetey-1-2013:p0704:b003:l003","ordinal":130794,"en":"If I drive my caravan from Keng-Kol,"},{"id":"semetey-1-2013:p0704:b003:l004","ordinal":130795,"en":"Upon those swaggering dogs"},{"id":"semetey-1-2013:p0704:b003:l005","ordinal":130796,"en":"Let me take my revenge without failing."},{"id":"semetey-1-2013:p0704:b003:l006","ordinal":130797,"en":"If I drive my caravan from Talas,"},{"id":"semetey-1-2013:p0704:b003:l007","ordinal":130798,"en":"Battling and smashing,"},{"id":"semetey-1-2013:p0704:b003:l008","ordinal":130799,"en":"Let me take tireless revenge upon those dogs.”"},{"id":"semetey-1-2013:p0704:b003:l009","ordinal":130800,"en":"Voicing this wish,"},{"id":"semetey-1-2013:p0704:b003:l010","ordinal":130801,"en":"The orphan would not stop."},{"id":"semetey-1-2013:p0704:b003:l011","ordinal":130802,"en":"The two orphans met,"},{"id":"semetey-1-2013:p0704:b003:l012","ordinal":130803,"en":"Softening like curds."},{"id":"semetey-1-2013:p0704:b003:l013","ordinal":130804,"en":"The people watching"},{"id":"semetey-1-2013:p0704:b003:l014","ordinal":130805,"en":"Felt every bone ache."},{"id":"semetey-1-2013:p0704:b003:l015","ordinal":130806,"en":"While the boys stood thus,"},{"id":"semetey-1-2013:p0704:b003:l016","ordinal":130807,"en":"Your heroic uncle Bakai,"},{"id":"semetey-1-2013:p0704:b003:l017","ordinal":130808,"en":"His white beard grown thin,"},{"id":"semetey-1-2013:p0704:b003:l018","ordinal":130809,"en":"Hailstone tears streaming from his eyes,"},{"id":"semetey-1-2013:p0704:b003:l019","ordinal":130810,"en":"Pouring down his collarbone—"},{"id":"semetey-1-2013:p0704:b003:l020","ordinal":130811,"en":"At that time Bakai"},{"id":"semetey-1-2013:p0704:b003:l021","ordinal":130812,"en":"Taking a hare's paw in his hand,"},{"id":"semetey-1-2013:p0704:b003:l022","ordinal":130813,"en":"And himself followed God's path."},{"id":"semetey-1-2013:p0704:b003:l023","ordinal":130814,"en":"Your sorrowful uncle Bakai sobbed,"},{"id":"semetey-1-2013:p0704:b003:l024","ordinal":130815,"en":"Crying, “My two lions!”"},{"id":"semetey-1-2013:p0704:b003:l025","ordinal":130816,"en":"He hurried between them,"}]
