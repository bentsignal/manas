[{"id":"semetey-1-2013:p1045:b004:l002","ordinal":155905,"en":"Until Aychürök came near,"},{"id":"semetey-1-2013:p1045:b004:l003","ordinal":155906,"en":"The great-hearted princely leopard"},{"id":"semetey-1-2013:p1045:b004:l004","ordinal":155907,"en":"Went limp and nearly fainted."},{"id":"semetey-1-2013:p1045:b004:l005","ordinal":155908,"en":"Until Chürök came beside him,"},{"id":"semetey-1-2013:p1045:b004:l006","ordinal":155909,"en":"His tiny soul cried out;"},{"id":"semetey-1-2013:p1045:b004:l007","ordinal":155910,"en":"He waited in frightened haste,"},{"id":"semetey-1-2013:p1045:b004:l008","ordinal":155911,"en":"Every bone in his body trembling."},{"id":"semetey-1-2013:p1045:b004:l009","ordinal":155912,"en":"Early time became late;"},{"id":"semetey-1-2013:p1045:b004:l010","ordinal":155913,"en":"\"When will Chürök come?\" he thought."},{"id":"semetey-1-2013:p1045:b004:l011","ordinal":155914,"en":"Your gray-maned wolf waited impatiently,"},{"id":"semetey-1-2013:p1045:b004:l012","ordinal":155915,"en":"His two eyes becoming four."},{"id":"semetey-1-2013:p1045:b004:l013","ordinal":155916,"en":"Aychürök, daughter of Akun,"},{"id":"semetey-1-2013:p1045:b004:l014","ordinal":155917,"en":"Pulled off and removed"},{"id":"semetey-1-2013:p1045:b004:l015","ordinal":155918,"en":"Her gown made of fine broadcloth."},{"id":"semetey-1-2013:p1045:b004:l016","ordinal":155919,"en":"Swaying softly like dressed leather,"},{"id":"semetey-1-2013:p1045:b004:l017","ordinal":155920,"en":"Whimpering like a puppy,"},{"id":"semetey-1-2013:p1045:b004:l018","ordinal":155921,"en":"Her face shining like the sun,"},{"id":"semetey-1-2013:p1045:b004:l019","ordinal":155922,"en":"She lay down embracing"},{"id":"semetey-1-2013:p1045:b004:l020","ordinal":155923,"en":"Her sultan's breast."},{"id":"semetey-1-2013:p1045:b004:l021","ordinal":155924,"en":"They immersed themselves in delight,"},{"id":"semetey-1-2013:p1045:b004:l022","ordinal":155925,"en":"And lay upon one bed;"},{"id":"semetey-1-2013:p1045:b004:l023","ordinal":155926,"en":"Like two graceful wild ducks,"},{"id":"semetey-1-2013:p1045:b004:l024","ordinal":155927,"en":"They now came together."},{"id":"semetey-1-2013:p1045:b004:l025","ordinal":155928,"en":"Like an argali ewe and ram,"},{"id":"semetey-1-2013:p1045:b004:l026","ordinal":155929,"en":"They now entwined."},{"id":"semetey-1-2013:p1045:b004:l027","ordinal":155930,"en":"They lay upon one bed,"},{"id":"semetey-1-2013:p1045:b004:l028","ordinal":155931,"en":"Immersed in pleasure like this,"},{"id":"semetey-1-2013:p1045:b004:l029","ordinal":155932,"en":"And mingled like"},{"id":"semetey-1-2013:p1045:b004:l030","ordinal":155933,"en":"Flour made from white wheat;"},{"id":"semetey-1-2013:p1045:b004:l031","ordinal":155934,"en":"They slid against one another"},{"id":"semetey-1-2013:p1045:b004:l032","ordinal":155935,"en":"Like the hair of a white gazelle."},{"id":"semetey-1-2013:p1045:b004:l033","ordinal":155936,"en":"They joined by their own will,"},{"id":"semetey-1-2013:p1045:b004:l034","ordinal":155937,"en":"Embracing and kissing,"},{"id":"semetey-1-2013:p1045:b004:l035","ordinal":155938,"en":"Speaking in whispers,"},{"id":"semetey-1-2013:p1045:b004:l036","ordinal":155939,"en":"And laughing with ringing voices."},{"id":"semetey-1-2013:p1045:b004:l037","ordinal":155940,"en":"As the lovers lay embraced,"},{"id":"semetey-1-2013:p1045:b004:l038","ordinal":155941,"en":"When the fierce conqueror stirred,"},{"id":"semetey-1-2013:p1045:b004:l039","ordinal":155942,"en":"Chürök sprang up with a whimper."},{"id":"semetey-1-2013:p1046:b003:l001","ordinal":155943,"en":"Rolling her eyes like a pheasant,"},{"id":"semetey-1-2013:p1046:b003:l002","ordinal":155944,"en":"The bold woman of singular nature"},{"id":"semetey-1-2013:p1046:b003:l003","ordinal":155945,"en":"Lay whimpering as he made her submit."},{"id":"semetey-1-2013:p1046:b003:l004","ordinal":155946,"en":"The luckless woman with her companion,"},{"id":"semetey-1-2013:p1046:b003:l005","ordinal":155947,"en":"Rolling her eyes like a rooster,"},{"id":"semetey-1-2013:p1046:b003:l006","ordinal":155948,"en":"Lay crying, \"Koykoy,\" as he made her submit."},{"id":"semetey-1-2013:p1046:b003:l007","ordinal":155949,"en":"His swaggering member, twelve handspans long—"},{"id":"semetey-1-2013:p1046:b003:l008","ordinal":155950,"en":"Without judging its mouth or root,"},{"id":"semetey-1-2013:p1046:b003:l009","ordinal":155951,"en":"When he thrust, it knotted within her;"},{"id":"semetey-1-2013:p1046:b003:l010","ordinal":155952,"en":"The luckless woman, who had never seen such a thing,"},{"id":"semetey-1-2013:p1046:b003:l011","ordinal":155953,"en":"Bent double like a trivet."},{"id":"semetey-1-2013:p1046:b003:l012","ordinal":155954,"en":"\"Oh, alas, my back!\" she cried;"},{"id":"semetey-1-2013:p1046:b003:l013","ordinal":155955,"en":"\"Wretched-day prince, you have consumed me!\""},{"id":"semetey-1-2013:p1046:b003:l014","ordinal":155956,"en":"When Chürök bucked without ceasing,"},{"id":"semetey-1-2013:p1046:b003:l015","ordinal":155957,"en":"She broke both lattice ties"},{"id":"semetey-1-2013:p1046:b003:l016","ordinal":155958,"en":"Together with their fastenings;"},{"id":"semetey-1-2013:p1046:b003:l017","ordinal":155959,"en":"When your prince thrust without stopping,"},{"id":"semetey-1-2013:p1046:b003:l018","ordinal":155960,"en":"He tore both seals of her maidenhood."},{"id":"semetey-1-2013:p1046:b003:l019","ordinal":155961,"en":"The luckless woman with her companion"},{"id":"semetey-1-2013:p1046:b003:l020","ordinal":155962,"en":"Satisfied the conqueror's desire."},{"id":"semetey-1-2013:p1046:b003:l021","ordinal":155963,"en":"Your ill-fated princely leopard"},{"id":"semetey-1-2013:p1046:b003:l022","ordinal":155964,"en":"Left your dear sister-in-law Chürök"},{"id":"semetey-1-2013:p1046:b003:l023","ordinal":155965,"en":"In a grievous state;"},{"id":"semetey-1-2013:p1046:b003:l024","ordinal":155966,"en":"Without letting Chürök stir,"},{"id":"semetey-1-2013:p1046:b003:l025","ordinal":155967,"en":"He lay upon her and pressed hard."},{"id":"semetey-1-2013:p1046:b003:l026","ordinal":155968,"en":"The leopard grew fierce"},{"id":"semetey-1-2013:p1046:b003:l027","ordinal":155969,"en":"And sank down like an old male camel;"},{"id":"semetey-1-2013:p1046:b003:l028","ordinal":155970,"en":"Without letting Chürök move,"},{"id":"semetey-1-2013:p1046:b003:l029","ordinal":155971,"en":"He spilled his yellow fluid into her."},{"id":"semetey-1-2013:p1046:b003:l030","ordinal":155972,"en":"Holding her firmly and making her struggle,"},{"id":"semetey-1-2013:p1046:b003:l031","ordinal":155973,"en":"He ravaged her private place."},{"id":"semetey-1-2013:p1046:b003:l032","ordinal":155974,"en":"When the sultan had finished his act,"},{"id":"semetey-1-2013:p1046:b003:l033","ordinal":155975,"en":"Aychürök stood and said this:"},{"id":"semetey-1-2013:p1046:b003:l034","ordinal":155976,"en":"\"These are the words I plead to say:"},{"id":"semetey-1-2013:p1046:b003:l035","ordinal":155977,"en":"Draw back again, my prince;"},{"id":"semetey-1-2013:p1046:b003:l036","ordinal":155978,"en":"My eyes are coming out,\" she said."},{"id":"semetey-1-2013:p1046:b003:l037","ordinal":155979,"en":"Your prince made his stallion rear,"},{"id":"semetey-1-2013:p1046:b003:l038","ordinal":155980,"en":"And drew out its tackle;"},{"id":"semetey-1-2013:p1046:b003:l039","ordinal":155981,"en":"For as long as meat takes to cook,"},{"id":"semetey-1-2013:p1046:b004:l001","ordinal":155982,"en":"Your Chürök lay unconscious."},{"id":"semetey-1-2013:p1046:b004:l002","ordinal":155983,"en":"Her strength vanished entirely;"},{"id":"semetey-1-2013:p1046:b004:l003","ordinal":155984,"en":"She nearly died, then recovered,"},{"id":"semetey-1-2013:p1046:b004:l004","ordinal":155985,"en":"And gathered her senses."},{"id":"semetey-1-2013:p1046:b004:l005","ordinal":155986,"en":"The quilt and white sheet"},{"id":"semetey-1-2013:p1046:b004:l006","ordinal":155987,"en":"Were covered in dark blood."},{"id":"semetey-1-2013:p1046:b004:l007","ordinal":155988,"en":"Concealing that blood had flowed,"},{"id":"semetey-1-2013:p1046:b004:l008","ordinal":155989,"en":"What could dear Chürök do?"},{"id":"semetey-1-2013:p1046:b004:l009","ordinal":155990,"en":"She gathered and swept it all away."},{"id":"semetey-1-2013:p1046:b004:l010","ordinal":155991,"en":"Your hero's twelve-handspan"},{"id":"semetey-1-2013:p1046:b004:l011","ordinal":155992,"en":"Great equipment—"},{"id":"semetey-1-2013:p1046:b004:l012","ordinal":155993,"en":"With a white kerchief of pure silk,"},{"id":"semetey-1-2013:p1046:b004:l013","ordinal":155994,"en":"She grasped it by hand and wiped it:"},{"id":"semetey-1-2013:p1046:b004:l014","ordinal":155995,"en":"\"Alas, prince, what shall I do?"},{"id":"semetey-1-2013:p1046:b004:l015","ordinal":155996,"en":"All my strength is gone;"},{"id":"semetey-1-2013:p1046:b004:l016","ordinal":155997,"en":"Hero, your instrument"},{"id":"semetey-1-2013:p1046:b004:l017","ordinal":155998,"en":"Reached every bone in my body,"},{"id":"semetey-1-2013:p1046:b004:l018","ordinal":155999,"en":"And passed beyond my navel,\" she said."},{"id":"semetey-1-2013:p1046:b004:l019","ordinal":156000,"en":"Unable to catch her breath, trembling,"},{"id":"semetey-1-2013:p1046:b004:l020","ordinal":156001,"en":"Chürök sobbed and wept."},{"id":"semetey-1-2013:p1046:b004:l021","ordinal":156002,"en":"The steed of Khan Bakay,"},{"id":"semetey-1-2013:p1046:b004:l022","ordinal":156003,"en":"Who began all that exists,"},{"id":"semetey-1-2013:p1046:b004:l023","ordinal":156004,"en":"The falcon of your hero,"},{"id":"semetey-1-2013:p1046:b004:l024","ordinal":156005,"en":"Who began the calamity."},{"id":"semetey-1-2013:p1046:b004:l025","ordinal":156006,"en":"Your dear sister-in-law Chürök,"},{"id":"semetey-1-2013:p1046:b004:l026","ordinal":156007,"en":"In the morning, before the prince,"},{"id":"semetey-1-2013:p1046:b004:l027","ordinal":156008,"en":"Opened the door and tottered;"},{"id":"semetey-1-2013:p1046:b004:l028","ordinal":156009,"en":"The poor woman's senses gone,"},{"id":"semetey-1-2013:p1046:b004:l029","ordinal":156010,"en":"She straddled like a louse-ridden horse."},{"id":"semetey-1-2013:p1046:b004:l030","ordinal":156011,"en":"In the morning, before the prince,"},{"id":"semetey-1-2013:p1046:b004:l031","ordinal":156012,"en":"She now hurried about serving him."},{"id":"semetey-1-2013:p1046:b004:l032","ordinal":156013,"en":"She had endured the affliction,"},{"id":"semetey-1-2013:p1046:b004:l033","ordinal":156014,"en":"Your poor, luckless sister-in-law,"},{"id":"semetey-1-2013:p1046:b004:l034","ordinal":156015,"en":"Blood streaming down her calves."},{"id":"semetey-1-2013:p1046:b004:l035","ordinal":156016,"en":"Within the fortress of the white palace,"},{"id":"semetey-1-2013:p1046:b004:l036","ordinal":156017,"en":"When two days had passed,"},{"id":"semetey-1-2013:p1046:b004:l037","ordinal":156018,"en":"Again your sister-in-law contrived"},{"id":"semetey-1-2013:p1046:b004:l038","ordinal":156019,"en":"To accommodate Semetey."},{"id":"semetey-1-2013:p1046:b004:l039","ordinal":156020,"en":"When one handspan had entered,"},{"id":"semetey-1-2013:p1047:b003:l001","ordinal":156021,"en":"Your sister-in-law lost awareness;"},{"id":"semetey-1-2013:p1047:b003:l002","ordinal":156022,"en":"When four handspans had entered,"},{"id":"semetey-1-2013:p1047:b003:l003","ordinal":156023,"en":"She groaned like a camel calf."},{"id":"semetey-1-2013:p1047:b003:l004","ordinal":156024,"en":"When six handspans had entered,"},{"id":"semetey-1-2013:p1047:b003:l005","ordinal":156025,"en":"She cried, \"Oh, my great-hearted one!\""},{"id":"semetey-1-2013:p1047:b003:l006","ordinal":156026,"en":"When nine handspans had entered,"},{"id":"semetey-1-2013:p1047:b003:l007","ordinal":156027,"en":"Like one suffering labor pains,"},{"id":"semetey-1-2013:p1047:b003:l008","ordinal":156028,"en":"She bleated like a goat and kid."},{"id":"semetey-1-2013:p1047:b003:l009","ordinal":156029,"en":"When ten handspans had entered,"},{"id":"semetey-1-2013:p1047:b003:l010","ordinal":156030,"en":"Moaning overtook her and she collapsed."},{"id":"semetey-1-2013:p1047:b003:l011","ordinal":156031,"en":"When twelve handspans had entered,"},{"id":"semetey-1-2013:p1047:b003:l012","ordinal":156032,"en":"\"My destroyer, you have consumed me!\" she cried,"},{"id":"semetey-1-2013:p1047:b003:l013","ordinal":156033,"en":"And stretched out like a hair rope."},{"id":"semetey-1-2013:p1047:b003:l014","ordinal":156034,"en":"Your hero's great instrument—"},{"id":"semetey-1-2013:p1047:b003:l015","ordinal":156035,"en":"She lay whimpering as he used it,"},{"id":"semetey-1-2013:p1047:b003:l016","ordinal":156036,"en":"Extending it into her precious place,"},{"id":"semetey-1-2013:p1047:b003:l017","ordinal":156037,"en":"And stilling the precious woman's soul."},{"id":"semetey-1-2013:p1047:b004:l001","ordinal":156038,"en":"Such were Aychürök's words,"},{"id":"semetey-1-2013:p1047:b004:l002","ordinal":156039,"en":"After burning for so many years;"},{"id":"semetey-1-2013:p1047:b004:l003","ordinal":156040,"en":"That was where the princely leopard Semetey"},{"id":"semetey-1-2013:p1047:b004:l004","ordinal":156041,"en":"Found contentment in his heart."},{"id":"semetey-1-2013:p1047:b004:l005","ordinal":156042,"en":"Within the white palace,"},{"id":"semetey-1-2013:p1047:b004:l006","ordinal":156043,"en":"When bored, they played ordo;"},{"id":"semetey-1-2013:p1047:b004:l007","ordinal":156044,"en":"They drank kumis and enjoyed maidens,"},{"id":"semetey-1-2013:p1047:b004:l008","ordinal":156045,"en":"And when not bored, lay together."},{"id":"semetey-1-2013:p1047:b004:l009","ordinal":156046,"en":"In pleasures of countless kinds,"},{"id":"semetey-1-2013:p1047:b004:l010","ordinal":156047,"en":"The gray wolves immersed themselves like this."},{"id":"semetey-1-2013:p1047:b004:l011","ordinal":156048,"en":"Morning and evening, twice a day,"},{"id":"semetey-1-2013:p1047:b004:l012","ordinal":156049,"en":"They remained without boredom in the palace."},{"id":"semetey-1-2013:p1047:b004:l013","ordinal":156050,"en":"Semetey's guests,"},{"id":"semetey-1-2013:p1047:b004:l014","ordinal":156051,"en":"Tümönbay, son of Tülkü,"},{"id":"semetey-1-2013:p1047:b004:l015","ordinal":156052,"en":"And Azhybay, son of Azhy—"},{"id":"semetey-1-2013:p1047:b004:l016","ordinal":156053,"en":"Now let me tell"},{"id":"semetey-1-2013:p1047:b004:l017","ordinal":156054,"en":"The tale of these two."},{"id":"semetey-1-2013:p1047:b006:l001","ordinal":156055,"en":"Of surpassing good will and noble thought,"},{"id":"semetey-1-2013:p1047:b006:l002","ordinal":156056,"en":"These were sons of brothers,"},{"id":"semetey-1-2013:p1047:b006:l003","ordinal":156057,"en":"And the finest men to come from Afghanistan."},{"id":"semetey-1-2013:p1047:b006:l004","ordinal":156058,"en":"Azhybay, son of Azhy,"},{"id":"semetey-1-2013:p1047:b006:l005","ordinal":156059,"en":"Sharpened his black tongue,"},{"id":"semetey-1-2013:p1047:b006:l006","ordinal":156060,"en":"And sang out before the khan."},{"id":"semetey-1-2013:p1047:b006:l007","ordinal":156061,"en":"Broad-jawed and flat-tongued,"},{"id":"semetey-1-2013:p1047:b006:l008","ordinal":156062,"en":"He was a formidable eloquent servant;"},{"id":"semetey-1-2013:p1047:b006:l009","ordinal":156063,"en":"When he accomplished a task without force,"},{"id":"semetey-1-2013:p1047:b006:l010","ordinal":156064,"en":"Among all people upon the earth"},{"id":"semetey-1-2013:p1047:b006:l011","ordinal":156065,"en":"He was a son beyond price."},{"id":"semetey-1-2013:p1047:b006:l012","ordinal":156066,"en":"Both eloquent and keen in argument,"},{"id":"semetey-1-2013:p1047:b006:l013","ordinal":156067,"en":"He was one to rely on for stratagems."},{"id":"semetey-1-2013:p1047:b006:l014","ordinal":156068,"en":"Tümönbay, son of Tülkü,"},{"id":"semetey-1-2013:p1047:b006:l015","ordinal":156069,"en":"Proud-hearted and stern-tempered,"},{"id":"semetey-1-2013:p1047:b006:l016","ordinal":156070,"en":"Was a thundering hero;"},{"id":"semetey-1-2013:p1047:b006:l017","ordinal":156071,"en":"His speech was venomous."},{"id":"semetey-1-2013:p1047:b007:l001","ordinal":156072,"en":"Toward a man who displeased him,"},{"id":"semetey-1-2013:p1047:b007:l002","ordinal":156073,"en":"He bore an anger that would not heal."},{"id":"semetey-1-2013:p1047:b007:l003","ordinal":156074,"en":"He had these words to say:"},{"id":"semetey-1-2013:p1047:b007:l004","ordinal":156075,"en":"\"Give me your eldest daughter,\" he demanded,"},{"id":"semetey-1-2013:p1047:b007:l005","ordinal":156076,"en":"And had come to besiege"},{"id":"semetey-1-2013:p1047:b007:l006","ordinal":156077,"en":"The city of Khan Akun."},{"id":"semetey-1-2013:p1047:b007:l007","ordinal":156078,"en":"Toltoy of the Zhediger"},{"id":"semetey-1-2013:p1047:b007:l008","ordinal":156079,"en":"Had troops in numbers that bent the earth."},{"id":"semetey-1-2013:p1047:b007:l009","ordinal":156080,"en":"\"I shall seize Aychürök,"},{"id":"semetey-1-2013:p1047:b007:l010","ordinal":156081,"en":"And inflict harsh suffering,\" was"},{"id":"semetey-1-2013:p1047:b007:l011","ordinal":156082,"en":"Chynkozho's intent."},{"id":"semetey-1-2013:p1047:b007:l012","ordinal":156083,"en":"The Zhediger had an army"},{"id":"semetey-1-2013:p1047:b007:l013","ordinal":156084,"en":"That would overrun Afghanistan."},{"id":"semetey-1-2013:p1047:b007:l014","ordinal":156085,"en":"To Chynkozho and Toltoy,"},{"id":"semetey-1-2013:p1047:b007:l015","ordinal":156086,"en":"\"By force I shall seize Chürök"},{"id":"semetey-1-2013:p1047:b007:l016","ordinal":156087,"en":"And deliver her into your hands,\" he said,"},{"id":"semetey-1-2013:p1047:b007:l017","ordinal":156088,"en":"Offering a white Koran as large as a horse's head,"}]
