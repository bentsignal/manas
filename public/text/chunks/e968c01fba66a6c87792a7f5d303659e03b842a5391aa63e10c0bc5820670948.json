:p0264:b002:l017","ordinal":314439,"en":"Your wings turn into snow,"},{"id":"seytek-2012:p0264:b002:l018","ordinal":314440,"en":"My murderous father is blue,"},{"id":"seytek-2012:p0264:b002:l019","ordinal":314441,"en":"Your son Seitek became snow,"},{"id":"seytek-2012:p0264:b002:l020","ordinal":314442,"en":"The great letter was blue"},{"id":"seytek-2012:p0264:b002:l021","ordinal":314443,"en":"Longing to see"},{"id":"seytek-2012:p0264:b002:l022","ordinal":314444,"en":"Where are you salty like me?"},{"id":"seytek-2012:p0264:b002:l023","ordinal":314445,"en":"Waiting for the animal"},{"id":"seytek-2012:p0264:b002:l024","ordinal":314446,"en":"This is what is left behind."},{"id":"seytek-2012:p0264:b002:l025","ordinal":314447,"en":"This is a narrow world -"},{"id":"seytek-2012:p0264:b002:l026","ordinal":314448,"en":"It's a fucking lie,"},{"id":"seytek-2012:p0264:b002:l027","ordinal":314449,"en":"My sea father is my shirt,"},{"id":"seytek-2012:p0264:b002:l028","ordinal":314450,"en":"We went astray, bad name,"},{"id":"seytek-2012:p0264:b002:l029","ordinal":314451,"en":"Twelve signed"},{"id":"seytek-2012:p0264:b002:l030","ordinal":314452,"en":"Don't let my father die."},{"id":"seytek-2012:p0264:b002:l031","ordinal":314453,"en":"Seitek, who saw the turn,"},{"id":"seytek-2012:p0264:b002:l032","ordinal":314454,"en":"Mourning his father,"},{"id":"seytek-2012:p0264:b002:l033","ordinal":314455,"en":"Crying and screaming"},{"id":"seytek-2012:p0264:b002:l034","ordinal":314456,"en":"Disappointed,"},{"id":"seytek-2012:p0264:b002:l035","ordinal":314457,"en":"Tears in his eyes."},{"id":"seytek-2012:p0264:b002:l036","ordinal":314458,"en":"Every brother left by my father,"},{"id":"seytek-2012:p0264:b002:l037","ordinal":314459,"en":"When the animal is standing like this"},{"id":"seytek-2012:p0264:b002:l038","ordinal":314460,"en":"I was the son's offspring,"},{"id":"seytek-2012:p0264:b002:l039","ordinal":314461,"en":"It's really summer"},{"id":"seytek-2012:p0264:b002:l040","ordinal":314462,"en":"I wish I could see it with my own eyes."},{"id":"seytek-2012:p0264:b003:l001","ordinal":314463,"en":"Twisting around"},{"id":"seytek-2012:p0264:b003:l002","ordinal":314464,"en":"The horse is watching,"},{"id":"seytek-2012:p0264:b003:l003","ordinal":314465,"en":"Separate tears,"},{"id":"seytek-2012:p0264:b003:l004","ordinal":314466,"en":"It pours from every steam."},{"id":"seytek-2012:p0264:b003:l005","ordinal":314467,"en":"When Buurul stood like this,"},{"id":"seytek-2012:p0264:b003:l006","ordinal":314468,"en":"Seitek, son of the hero"},{"id":"seytek-2012:p0264:b003:l007","ordinal":314469,"en":"Disappointed, separated"},{"id":"seytek-2012:p0264:b003:l008","ordinal":314470,"en":"Tears in his eyes,"},{"id":"seytek-2012:p0264:b003:l009","ordinal":314471,"en":"The right rib"},{"id":"seytek-2012:p0264:b003:l010","ordinal":314472,"en":"Separated from letter to letter,"},{"id":"seytek-2012:p0264:b003:l011","ordinal":314473,"en":"A horse from an animal"},{"id":"seytek-2012:p0264:b003:l012","ordinal":314474,"en":"How does father Semetei look like?"},{"id":"seytek-2012:p0264:b003:l013","ordinal":314475,"en":"Like a fly, the soul is chirping,"},{"id":"seytek-2012:p0264:b003:l014","ordinal":314476,"en":"The bones are broken,"},{"id":"seytek-2012:p0264:b003:l015","ordinal":314477,"en":"Buurul horse,"},{"id":"seytek-2012:p0264:b003:l016","ordinal":314478,"en":"What does the father look like"},{"id":"seytek-2012:p0264:b003:l017","ordinal":314479,"en":"Tears poured into his bosom,"},{"id":"seytek-2012:p0264:b003:l018","ordinal":314480,"en":"It happened to Buurul,"},{"id":"seytek-2012:p0264:b003:l019","ordinal":314481,"en":"My property left by my father,"},{"id":"seytek-2012:p0264:b003:l020","ordinal":314482,"en":"This is not my money"},{"id":"seytek-2012:p0264:b003:l021","ordinal":314483,"en":"My soul is hot in the sky."},{"id":"seytek-2012:p0264:b003:l022","ordinal":314484,"en":"Buurul came to meet,"},{"id":"seytek-2012:p0264:b003:l023","ordinal":314485,"en":"My blood has broken today."},{"id":"seytek-2012:p0264:b003:l024","ordinal":314486,"en":"My soul burned with fire,"},{"id":"seytek-2012:p0264:b003:l025","ordinal":314487,"en":"I am an orphan, wandering cattle,"},{"id":"seytek-2012:p0264:b003:l026","ordinal":314488,"en":"Shame on you."},{"id":"seytek-2012:p0264:b003:l027","ordinal":314489,"en":"Twelve signed,"},{"id":"seytek-2012:p0264:b003:l028","ordinal":314490,"en":"I'm sorry, my father"},{"id":"seytek-2012:p0264:b003:l029","ordinal":314491,"en":"Talas is a vast land"},{"id":"seytek-2012:p0264:b003:l030","ordinal":314492,"en":"A pillar of gold,"},{"id":"seytek-2012:p0264:b003:l031","ordinal":314493,"en":"When the name is like this"},{"id":"seytek-2012:p0264:b003:l032","ordinal":314494,"en":"I lost my father"},{"id":"seytek-2012:p0264:b003:l033","ordinal":314495,"en":"This soul is so vulnerable,"},{"id":"seytek-2012:p0264:b003:l034","ordinal":314496,"en":"Detached from the statue."},{"id":"seytek-2012:p0264:b003:l035","ordinal":314497,"en":"Sold to a caravan,"},{"id":"seytek-2012:p0264:b003:l036","ordinal":314498,"en":"They were hidden together."},{"id":"seytek-2012:p0264:b003:l037","ordinal":314499,"en":"Without a beak from an animal,"},{"id":"seytek-2012:p0264:b003:l038","ordinal":314500,"en":"Where are you salty?"},{"id":"seytek-2012:p0264:b003:l039","ordinal":314501,"en":"Father did not smell,"},{"id":"seytek-2012:p0264:b003:l040","ordinal":314502,"en":"Just look at the arcade"},{"id":"seytek-2012:p0265:b002:l001","ordinal":314503,"en":"He sniffed him deeply, again and again,"},{"id":"seytek-2012:p0265:b002:l002","ordinal":314504,"en":"From my father who passed before,"},{"id":"seytek-2012:p0265:b002:l003","ordinal":314505,"en":"He sniffed him, saying, “You remain as my inheritance,”"},{"id":"seytek-2012:p0265:b002:l004","ordinal":314506,"en":"And while Seytek stood weeping,"},{"id":"seytek-2012:p0265:b002:l005","ordinal":314507,"en":"Aichürök came wailing bitterly."},{"id":"seytek-2012:p0265:b002:l006","ordinal":314508,"en":"