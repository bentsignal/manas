[{"id":"semetey-2-2013:p1209:b005:l011","ordinal":278785,"en":"He was distraught and agitated,"},{"id":"semetey-2-2013:p1209:b005:l012","ordinal":278786,"en":"And, unable to find his bearings,"},{"id":"semetey-2-2013:p1209:b005:l013","ordinal":278787,"en":"He pleaded with Kanchoro:"},{"id":"semetey-2-2013:p1209:b005:l014","ordinal":278788,"en":"“My dear Kanchoro,"},{"id":"semetey-2-2013:p1209:b005:l015","ordinal":278789,"en":"Here is a rich city, and here is its land;"},{"id":"semetey-2-2013:p1209:b005:l016","ordinal":278790,"en":"If you would take my head, here I am."},{"id":"semetey-2-2013:p1209:b005:l017","ordinal":278791,"en":"Here is a land filled with cities;"},{"id":"semetey-2-2013:p1209:b005:l018","ordinal":278792,"en":"Hero, if you would spill blood, here we are!"},{"id":"semetey-2-2013:p1209:b005:l019","ordinal":278793,"en":"If you would strike like hail, here are our heads."},{"id":"semetey-2-2013:p1209:b005:l020","ordinal":278794,"en":"I have spoken—accept my words."},{"id":"semetey-2-2013:p1209:b005:l021","ordinal":278795,"en":"Devise whatever conflict you know best;"},{"id":"semetey-2-2013:p1209:b005:l022","ordinal":278796,"en":"If you would shoot, choose the way yourself."},{"id":"semetey-2-2013:p1209:b005:l023","ordinal":278797,"en":"Find the means yourself,"},{"id":"semetey-2-2013:p1209:b005:l024","ordinal":278798,"en":"And form the plan yourself."},{"id":"semetey-2-2013:p1209:b005:l025","ordinal":278799,"en":"The entire people of Jediger,"},{"id":"semetey-2-2013:p1209:b005:l026","ordinal":278800,"en":"Who dwell in Jeti-Özön, were gathered here,"},{"id":"semetey-2-2013:p1209:b005:l027","ordinal":278801,"en":"Yet such terrible calamity"},{"id":"semetey-2-2013:p1209:b005:l028","ordinal":278802,"en":"I have never seen before."},{"id":"semetey-2-2013:p1209:b005:l029","ordinal":278803,"en":"Take the heavy musket and lie in wait;"},{"id":"semetey-2-2013:p1209:b005:l030","ordinal":278804,"en":"Fire it as you see fit."},{"id":"semetey-2-2013:p1209:b005:l031","ordinal":278805,"en":"If you send a man against a foe whose ways he does not know,"},{"id":"semetey-2-2013:p1209:b005:l032","ordinal":278806,"en":"That will become grounds for reproach."},{"id":"semetey-2-2013:p1209:b005:l033","ordinal":278807,"en":"Sary Khan, whose ways you know,"},{"id":"semetey-2-2013:p1209:b005:l034","ordinal":278808,"en":"Has proved a formidable champion against this;"},{"id":"semetey-2-2013:p1209:b005:l035","ordinal":278809,"en":"Devise the means yourself.”"},{"id":"semetey-2-2013:p1209:b005:l036","ordinal":278810,"en":"So brave Kyyaz spoke,"},{"id":"semetey-2-2013:p1209:b005:l037","ordinal":278811,"en":"Bending his knees to the ground;"},{"id":"semetey-2-2013:p1209:b005:l038","ordinal":278812,"en":"From atop the bay horse"},{"id":"semetey-2-2013:p1209:b005:l039","ordinal":278813,"en":"He sprang down and ran,"},{"id":"semetey-2-2013:p1210:b003:l001","ordinal":278814,"en":"Turning pale as a gray horse from a white herd."},{"id":"semetey-2-2013:p1210:b003:l002","ordinal":278815,"en":"The stars stirred in the heavens;"},{"id":"semetey-2-2013:p1210:b003:l003","ordinal":278816,"en":"Let us be friends even in the next world,"},{"id":"semetey-2-2013:p1210:b003:l004","ordinal":278817,"en":"Our sheep sharing one fold."},{"id":"semetey-2-2013:p1210:b003:l005","ordinal":278818,"en":"If wealth is found, let us gather it together;"},{"id":"semetey-2-2013:p1210:b003:l006","ordinal":278819,"en":"Shall we not remain comrades?"},{"id":"semetey-2-2013:p1210:b003:l007","ordinal":278820,"en":"Take the task upon yourself;"},{"id":"semetey-2-2013:p1210:b003:l008","ordinal":278821,"en":"Find some way to accomplish it."},{"id":"semetey-2-2013:p1210:b003:l009","ordinal":278822,"en":"Jeti-Özön was our land,"},{"id":"semetey-2-2013:p1210:b003:l010","ordinal":278823,"en":"And Jediger was our people."},{"id":"semetey-2-2013:p1210:b003:l011","ordinal":278824,"en":"Hero, take both reins and the single lead-rope"},{"id":"semetey-2-2013:p1210:b003:l012","ordinal":278825,"en":"Firmly into your own hands;"},{"id":"semetey-2-2013:p1210:b003:l013","ordinal":278826,"en":"Become lord yourself, hero,"},{"id":"semetey-2-2013:p1210:b003:l014","ordinal":278827,"en":"Over the Jediger in Jeti-Suu."},{"id":"semetey-2-2013:p1210:b003:l015","ordinal":278828,"en":"Whether it brings sin or merit,"},{"id":"semetey-2-2013:p1210:b003:l016","ordinal":278829,"en":"Take command of us."},{"id":"semetey-2-2013:p1210:b003:l017","ordinal":278830,"en":"Against this champion Sary Khan,"},{"id":"semetey-2-2013:p1210:b003:l018","ordinal":278831,"en":"If you are a champion and a lion,"},{"id":"semetey-2-2013:p1210:b003:l019","ordinal":278832,"en":"Find some way to settle the score.”"},{"id":"semetey-2-2013:p1210:b003:l020","ordinal":278833,"en":"After he had spoken thus,"},{"id":"semetey-2-2013:p1210:b003:l021","ordinal":278834,"en":"Finding the counsel fitting,"},{"id":"semetey-2-2013:p1210:b003:l022","ordinal":278835,"en":"Your hero Choro"},{"id":"semetey-2-2013:p1210:b003:l023","ordinal":278836,"en":"Strapped on his heavy musket"},{"id":"semetey-2-2013:p1210:b003:l024","ordinal":278837,"en":"And readied his weapons."},{"id":"semetey-2-2013:p1210:b003:l025","ordinal":278838,"en":"At that moment Kanchoro—"},{"id":"semetey-2-2013:p1210:b003:l026","ordinal":278839,"en":"Among spearmen, Choro"},{"id":"semetey-2-2013:p1210:b003:l027","ordinal":278840,"en":"Had skill and cunning;"},{"id":"semetey-2-2013:p1210:b003:l028","ordinal":278841,"en":"As an expert marksman, Choro"},{"id":"semetey-2-2013:p1210:b003:l029","ordinal":278842,"en":"Had matchless prowess;"},{"id":"semetey-2-2013:p1210:b003:l030","ordinal":278843,"en":"As a deviser of stratagems, Choro"},{"id":"semetey-2-2013:p1210:b003:l031","ordinal":278844,"en":"Had skill and cunning—"},{"id":"semetey-2-2013:p1210:b003:l032","ordinal":278845,"en":"Blocked the ridge of Talas"},{"id":"semetey-2-2013:p1210:b003:l033","ordinal":278846,"en":"As far as the eye could see,"},{"id":"semetey-2-2013:p1210:b003:l034","ordinal":278847,"en":"And lay in wait at the place"},{"id":"semetey-2-2013:p1210:b003:l035","ordinal":278848,"en":"Where Sary Khan would come over the rise."},{"id":"semetey-2-2013:p1210:b003:l036","ordinal":278849,"en":"At that moment Sary Khan,"},{"id":"semetey-2-2013:p1210:b003:l037","ordinal":278850,"en":"Before one could cry, “Look out!”"},{"id":"semetey-2-2013:p1210:b003:l038","ordinal":278851,"en":"In the blink of an eye,"},{"id":"semetey-2-2013:p1210:b003:l039","ordinal":278852,"en":"Was overwhelmed by fury;"},{"id":"semetey-2-2013:p1210:b004:l001","ordinal":278853,"en":"Your uncle the khan, distraught,"},{"id":"semetey-2-2013:p1210:b004:l002","ordinal":278854,"en":"Could not find Semetey."},{"id":"semetey-2-2013:p1210:b004:l003","ordinal":278855,"en":"At that moment Sary Khan,"},{"id":"semetey-2-2013:p1210:b004:l004","ordinal":278856,"en":"His heroic heart constricted,"},{"id":"semetey-2-2013:p1210:b004:l005","ordinal":278857,"en":"Not knowing whom he approached,"},{"id":"semetey-2-2013:p1210:b004:l006","ordinal":278858,"en":"Rode up onto the ridge."},{"id":"semetey-2-2013:p1210:b004:l007","ordinal":278859,"en":"Kanchoro lay in ambush;"},{"id":"semetey-2-2013:p1210:b004:l008","ordinal":278860,"en":"Sary Khan came onto open ground"},{"id":"semetey-2-2013:p1210:b004:l009","ordinal":278861,"en":"And drew near to the hero Kanchoro,"},{"id":"semetey-2-2013:p1210:b004:l010","ordinal":278862,"en":"That treacherous infidel."},{"id":"semetey-2-2013:p1210:b004:l011","ordinal":278863,"en":"Sary Khan came close."},{"id":"semetey-2-2013:p1210:b004:l012","ordinal":278864,"en":"As he crossed the saddle-shaped pass,"},{"id":"semetey-2-2013:p1210:b004:l013","ordinal":278865,"en":"Over the rough white rising ground,"},{"id":"semetey-2-2013:p1210:b004:l014","ordinal":278866,"en":"With a broad flat below,"},{"id":"semetey-2-2013:p1210:b004:l015","ordinal":278867,"en":"And went farther on,"},{"id":"semetey-2-2013:p1210:b004:l016","ordinal":278868,"en":"At Echoing Jar-Kyya,"},{"id":"semetey-2-2013:p1210:b004:l017","ordinal":278869,"en":"Along a track wide enough for one horse,"},{"id":"semetey-2-2013:p1210:b004:l018","ordinal":278870,"en":"In that narrow winding defile,"},{"id":"semetey-2-2013:p1210:b004:l019","ordinal":278871,"en":"Where a black rock as large as a yurt"},{"id":"semetey-2-2013:p1210:b004:l020","ordinal":278872,"en":"Forced riders to squeeze past,"},{"id":"semetey-2-2013:p1210:b004:l021","ordinal":278873,"en":"The hero Kanchoro,"},{"id":"semetey-2-2013:p1210:b004:l022","ordinal":278874,"en":"That treacherous infidel,"},{"id":"semetey-2-2013:p1210:b004:l023","ordinal":278875,"en":"Displayed the perfection of his marksmanship;"},{"id":"semetey-2-2013:p1210:b004:l024","ordinal":278876,"en":"His deadly, formidable gun"},{"id":"semetey-2-2013:p1210:b004:l025","ordinal":278877,"en":"Destroyed whatever it was aimed at."},{"id":"semetey-2-2013:p1210:b004:l026","ordinal":278878,"en":"My uncle Sary rode straight in,"},{"id":"semetey-2-2013:p1210:b004:l027","ordinal":278879,"en":"My uncle Sary, defender of the people;"},{"id":"semetey-2-2013:p1210:b004:l028","ordinal":278880,"en":"Brave Kyyaz confronted him,"},{"id":"semetey-2-2013:p1210:b004:l029","ordinal":278881,"en":"And fought with Kyyaz."},{"id":"semetey-2-2013:p1210:b004:l030","ordinal":278882,"en":"Kanchoro’s steel bullet"},{"id":"semetey-2-2013:p1210:b004:l031","ordinal":278883,"en":"Struck Sary Khan in the forehead;"},{"id":"semetey-2-2013:p1210:b004:l032","ordinal":278884,"en":"The bullet of death fastened upon him."},{"id":"semetey-2-2013:p1210:b004:l033","ordinal":278885,"en":"His white beard, like mountain wormwood,"},{"id":"semetey-2-2013:p1210:b004:l034","ordinal":278886,"en":"Spread across his chest;"},{"id":"semetey-2-2013:p1210:b004:l035","ordinal":278887,"en":"My mighty khan, Uncle Sary,"},{"id":"semetey-2-2013:p1210:b004:l036","ordinal":278888,"en":"Fell upon the pass with his head split open."},{"id":"semetey-2-2013:p1210:b004:l037","ordinal":278889,"en":"His blood gushed out,"},{"id":"semetey-2-2013:p1210:b004:l038","ordinal":278890,"en":"And from your uncle Khan Sary"},{"id":"semetey-2-2013:p1210:b004:l039","ordinal":278891,"en":"His life fled with a cry."},{"id":"semetey-2-2013:p1211:b003:l001","ordinal":278892,"en":"Sary Khan’s death,"},{"id":"semetey-2-2013:p1211:b003:l002","ordinal":278893,"en":"The unyielding underworld"},{"id":"semetey-2-2013:p1211:b003:l003","ordinal":278894,"en":"That noble man had seen."},{"id":"semetey-2-2013:p1211:b003:l004","ordinal":278895,"en":"Before they could strip off his armor,"},{"id":"semetey-2-2013:p1211:b003:l005","ordinal":278896,"en":"Before death could reach"},{"id":"semetey-2-2013:p1211:b003:l006","ordinal":278897,"en":"That hero Sary Khan,"},{"id":"semetey-2-2013:p1211:b003:l007","ordinal":278898,"en":"Külchoro, son of Almambet,"},{"id":"semetey-2-2013:p1211:b003:l008","ordinal":278899,"en":"Was overwhelmed by countless cares:"},{"id":"semetey-2-2013:p1211:b003:l009","ordinal":278900,"en":"Praying that his gray-wolf uncle would not die,"},{"id":"semetey-2-2013:p1211:b003:l010","ordinal":278901,"en":"His tears streamed in ten directions."},{"id":"semetey-2-2013:p1211:b003:l011","ordinal":278902,"en":"Oh, Sary Khan, my uncle,"},{"id":"semetey-2-2013:p1211:b003:l012","ordinal":278903,"en":"You were left dishonored on the ridge;"},{"id":"semetey-2-2013:p1211:b003:l013","ordinal":278904,"en":"Alas, uncle, avenge this!"},{"id":"semetey-2-2013:p1211:b003:l014","ordinal":278905,"en":"You were left dishonored in the hollow;"},{"id":"semetey-2-2013:p1211:b003:l015","ordinal":278906,"en":"Oh, my uncle, avenge this!"},{"id":"semetey-2-2013:p1211:b003:l016","ordinal":278907,"en":"Tugging at the matchlock,"},{"id":"semetey-2-2013:p1211:b003:l017","ordinal":278908,"en":"Saying, “My noble uncle has died,"},{"id":"semetey-2-2013:p1211:b003:l018","ordinal":278909,"en":"He suffered this disgrace"},{"id":"semetey-2-2013:p1211:b003:l019","ordinal":278910,"en":"At the hands of that infidel Kanchoro,”"},{"id":"semetey-2-2013:p1211:b003:l020","ordinal":278911,"en":"He wailed and wailed,"},{"id":"semetey-2-2013:p1211:b003:l021","ordinal":278912,"en":"Beating his own head,"},{"id":"semetey-2-2013:p1211:b003:l022","ordinal":278913,"en":"Sobbing and weeping bitterly,"},{"id":"semetey-2-2013:p1211:b003:l023","ordinal":278914,"en":"Crying, “My mighty uncle!”"},{"id":"semetey-2-2013:p1211:b003:l024","ordinal":278915,"en":"His ribs seemed torn apart,"},{"id":"semetey-2-2013:p1211:b003:l025","ordinal":278916,"en":"His whole heart burned,"},{"id":"semetey-2-2013:p1211:b003:l026","ordinal":278917,"en":"His fly-like soul nearly left him."},{"id":"semetey-2-2013:p1211:b003:l027","ordinal":278918,"en":"They were fortunate men and lions both,"},{"id":"semetey-2-2013:p1211:b003:l028","ordinal":278919,"en":"My two uncles, Sary Khan and Bakai,"},{"id":"semetey-2-2013:p1211:b003:l029","ordinal":278920,"en":"They were the banners raised in Talas."},{"id":"semetey-2-2013:p1211:b003:l030","ordinal":278921,"en":"Fallen at the banner’s foot,"},{"id":"semetey-2-2013:p1211:b003:l031","ordinal":278922,"en":"Today my uncle Sary Khan lies slain."},{"id":"semetey-2-2013:p1211:b003:l032","ordinal":278923,"en":"Before meeting the one he was destined to meet,"},{"id":"semetey-2-2013:p1211:b003:l033","ordinal":278924,"en":"My majestic khan and uncle,"},{"id":"semetey-2-2013:p1211:b003:l034","ordinal":278925,"en":"Was this how your fortune hardened?"},{"id":"semetey-2-2013:p1211:b003:l035","ordinal":278926,"en":"Before encountering the one you were to encounter,"},{"id":"semetey-2-2013:p1211:b003:l036","ordinal":278927,"en":"My fortunate kinsman, my khan and uncle,"},{"id":"semetey-2-2013:p1211:b003:l037","ordinal":278928,"en":"Was this how your road was barred?"},{"id":"semetey-2-2013:p1211:b003:l038","ordinal":278929,"en":"Like the broad gray flood"},{"id":"semetey-2-2013:p1211:b003:l039","ordinal":278930,"en":"At the confluence of Jeti-Too, my khan and uncle,"},{"id":"semetey-2-2013:p1211:b005:l001","ordinal":278931,"en":"Do you now lie embracing the earth?"},{"id":"semetey-2-2013:p1211:b005:l002","ordinal":278932,"en":"You were a pass no enemy could cross,"},{"id":"semetey-2-2013:p1211:b005:l003","ordinal":278933,"en":"A hero who stood immovable."},{"id":"semetey-2-2013:p1211:b005:l004","ordinal":278934,"en":"Though men surpass men and women bear sons,"},{"id":"semetey-2-2013:p1211:b005:l005","ordinal":278935,"en":"Uncle, another gray-wolf hero like you"},{"id":"semetey-2-2013:p1211:b005:l006","ordinal":278936,"en":"Will never come into this world.”"},{"id":"semetey-2-2013:p1211:b005:l007","ordinal":278937,"en":"Bracing himself on his right side,"},{"id":"semetey-2-2013:p1211:b005:l008","ordinal":278938,"en":"He wept, “My mighty uncle!”"},{"id":"semetey-2-2013:p1211:b005:l009","ordinal":278939,"en":"Bracing himself on his left side,"},{"id":"semetey-2-2013:p1211:b005:l010","ordinal":278940,"en":"He wept, “My sovereign uncle!”"},{"id":"semetey-2-2013:p1211:b005:l011","ordinal":278941,"en":"The world darkened beneath clouds;"},{"id":"semetey-2-2013:p1211:b005:l012","ordinal":278942,"en":"Over Külchoro’s head"},{"id":"semetey-2-2013:p1211:b005:l013","ordinal":278943,"en":"A darkened world descended."},{"id":"semetey-2-2013:p1211:b005:l014","ordinal":278944,"en":"When that noble hero grew wrathful,"},{"id":"semetey-2-2013:p1211:b005:l015","ordinal":278945,"en":"His brow fell and his heart broke."},{"id":"semetey-2-2013:p1211:b005:l016","ordinal":278946,"en":"Death comes one day out of seven—"},{"id":"semetey-2-2013:p1211:b005:l017","ordinal":278947,"en":"Damn this deceitful world!—"},{"id":"semetey-2-2013:p1211:b005:l018","ordinal":278948,"en":"And grief fell upon him."},{"id":"semetey-2-2013:p1211:b005:l019","ordinal":278949,"en":"Oh, Sary Khan, my uncle,"},{"id":"semetey-2-2013:p1211:b005:l020","ordinal":278950,"en":"Your white beard was like soft down,"},{"id":"semetey-2-2013:p1211:b005:l021","ordinal":278951,"en":"Your sturdy bones were like brass."},{"id":"semetey-2-2013:p1211:b005:l022","ordinal":278952,"en":"You were noble and lionhearted,"},{"id":"semetey-2-2013:p1211:b005:l023","ordinal":278953,"en":"My uncle, a hero born for battle."},{"id":"semetey-2-2013:p1211:b005:l024","ordinal":278954,"en":"“If you die in combat, Külchoro,"},{"id":"semetey-2-2013:p1211:b005:l025","ordinal":278955,"en":"My son will bury you,” you used to say."},{"id":"semetey-2-2013:p1211:b005:l026","ordinal":278956,"en":"Among horses, the steed Tuuchunak—"},{"id":"semetey-2-2013:p1211:b005:l027","ordinal":278957,"en":"I shall slaughter the horse Tuuchunak."},{"id":"semetey-2-2013:p1211:b005:l028","ordinal":278958,"en":"My khan, my uncle Sary Khan,"},{"id":"semetey-2-2013:p1211:b005:l029","ordinal":278959,"en":"I shall bury with my own hands."},{"id":"semetey-2-2013:p1211:b005:l030","ordinal":278960,"en":"As his blood drained, his strength departed,"},{"id":"semetey-2-2013:p1211:b005:l031","ordinal":278961,"en":"And his face had turned pale."},{"id":"semetey-2-2013:p1211:b005:l032","ordinal":278962,"en":"The renowned man of Kyrgyz and Kazakh,"},{"id":"semetey-2-2013:p1211:b005:l033","ordinal":278963,"en":"My uncle, had met his death."},{"id":"semetey-2-2013:p1211:b005:l034","ordinal":278964,"en":"If my uncle Sary remains unburied,"},{"id":"semetey-2-2013:p1211:b005:l035","ordinal":278965,"en":"His two round crimson cheeks"},{"id":"semetey-2-2013:p1211:b005:l036","ordinal":278966,"en":"Will be pecked away by blue vultures."},{"id":"semetey-2-2013:p1211:b005:l037","ordinal":278967,"en":"My dear uncle Sary Khan"},{"id":"semetey-2-2013:p1211:b005:l038","ordinal":278968,"en":"Will become carrion for beasts."},{"id":"semetey-2-2013:p1211:b005:l039","ordinal":278969,"en":"Flapping as they peck at his belly,"},{"id":"semetey-2-2013:p1212:b003:l001","ordinal":278970,"en":"The bald black vultures will fly over him."},{"id":"semetey-2-2013:p1212:b003:l002","ordinal":278971,"en":"Crushing his sturdy bones,"},{"id":"semetey-2-2013:p1212:b003:l003","ordinal":278972,"en":"Wolves will tear the gray wolf apart."},{"id":"semetey-2-2013:p1212:b003:l004","ordinal":278973,"en":"Sniffing his blood and gore and whining,"},{"id":"semetey-2-2013:p1212:b003:l005","ordinal":278974,"en":"Accursed foxes will defile him."},{"id":"semetey-2-2013:p1212:b003:l006","ordinal":278975,"en":"Summoning the beasts of prey,"},{"id":"semetey-2-2013:p1212:b003:l007","ordinal":278976,"en":"Croaking ravens will fly above him.”"},{"id":"semetey-2-2013:p1212:b003:l008","ordinal":278977,"en":"Peerless in his swiftness,"},{"id":"semetey-2-2013:p1212:b003:l009","ordinal":278978,"en":"The valiant-born Külchoro cried:"},{"id":"semetey-2-2013:p1212:b003:l010","ordinal":278979,"en":"“My doomed uncle Sary Khan,"},{"id":"semetey-2-2013:p1212:b003:l011","ordinal":278980,"en":"Your face has faded pale!"},{"id":"semetey-2-2013:p1212:b003:l012","ordinal":278981,"en":"Death has taken the kinsman"},{"id":"semetey-2-2013:p1212:b003:l013","ordinal":278982,"en":"Who carved the meat and gave me honey."},{"id":"semetey-2-2013:p1212:b003:l014","ordinal":278983,"en":"Death came from the vile infidel,"},{"id":"semetey-2-2013:p1212:b003:l015","ordinal":278984,"en":"Unworthy of salt enough for a cooking pot."},{"id":"semetey-2-2013:p1212:b003:l016","ordinal":278985,"en":"May he never put forth shoots—"},{"id":"semetey-2-2013:p1212:b003:l017","ordinal":278986,"en":"Death came from that wretch."},{"id":"semetey-2-2013:p1212:b003:l018","ordinal":278987,"en":"Not from some distant stranger, but from kin;"},{"id":"semetey-2-2013:p1212:b003:l019","ordinal":278988,"en":"Death came from one close to us.”"},{"id":"semetey-2-2013:p1212:b003:l020","ordinal":278989,"en":"Saying this, Külchoro"},{"id":"semetey-2-2013:p1212:b003:l021","ordinal":278990,"en":"Grasped him at the waist and folded him."},{"id":"semetey-2-2013:p1212:b003:l022","ordinal":278991,"en":"Tuuchunak had been taken as spoil,"},{"id":"semetey-2-2013:p1212:b003:l023","ordinal":278992,"en":"So he loaded him upon some other beast."},{"id":"semetey-2-2013:p1212:b003:l024","ordinal":278993,"en":"Unable to cease circling him and weeping,"},{"id":"semetey-2-2013:p1212:b003:l025","ordinal":278994,"en":"Külchoro, son of Almambet,"},{"id":"semetey-2-2013:p1212:b003:l026","ordinal":278995,"en":"Could find no peace."},{"id":"semetey-2-2013:p1212:b003:l027","ordinal":278996,"en":"He sobbed, unable to die,"},{"id":"semetey-2-2013:p1212:b003:l028","ordinal":278997,"en":"Unable to take his own life."},{"id":"semetey-2-2013:p1212:b003:l029","ordinal":278998,"en":"The poor man had no kinsman beside him,"},{"id":"semetey-2-2013:p1212:b003:l030","ordinal":278999,"en":"No forest into which he could flee,"},{"id":"semetey-2-2013:p1212:b003:l031","ordinal":279000,"en":"No Nogai people loyal to him,"},{"id":"semetey-2-2013:p1212:b003:l032","ordinal":279001,"en":"No companion in his grievous trial,"},{"id":"semetey-2-2013:p1212:b003:l033","ordinal":279002,"en":"None of the blessed Kyrgyz there."},{"id":"semetey-2-2013:p1212:b003:l034","ordinal":279003,"en":"He paced about, restraining himself,"},{"id":"semetey-2-2013:p1212:b003:l035","ordinal":279004,"en":"Leaning upon"},{"id":"semetey-2-2013:p1212:b003:l036","ordinal":279005,"en":"His golden-bladed battle-axe."},{"id":"semetey-2-2013:p1212:b003:l037","ordinal":279006,"en":"Unable to find any peace,"},{"id":"semetey-2-2013:p1212:b003:l038","ordinal":279007,"en":"He stood bewildered."},{"id":"semetey-2-2013:p1212:b003:l039","ordinal":279008,"en":"Then mist arose from the ravines,"},{"id":"semetey-2-2013:p1212:b004:l001","ordinal":279009,"en":"And over the mountaintops"},{"id":"semetey-2-2013:p1212:b004:l002","ordinal":279010,"en":"Great clouds gathered."},{"id":"semetey-2-2013:p1212:b004:l003","ordinal":279011,"en":"Winds blew from every side,"},{"id":"semetey-2-2013:p1212:b004:l004","ordinal":279012,"en":"The grass trembled and stirred,"},{"id":"semetey-2-2013:p1212:b004:l005","ordinal":279013,"en":"Hail swept all the foothills,"},{"id":"semetey-2-2013:p1212:b004:l006","ordinal":279014,"en":"And from the sky a sixfold hailstorm"},{"id":"semetey-2-2013:p1212:b004:l007","ordinal":279015,"en":"Poured down in driving sheets."},{"id":"semetey-2-2013:p1212:b004:l008","ordinal":279016,"en":"Külchoro, his father’s only son,"},{"id":"semetey-2-2013:p1212:b004:l009","ordinal":279017,"en":"Stood muttering as the sky convulsed"},{"id":"semetey-2-2013:p1212:b004:l010","ordinal":279018,"en":"And the earth seemed to shift."},{"id":"semetey-2-2013:p1212:b004:l011","ordinal":279019,"en":"With no Argyn or Kyrgyz people there,"},{"id":"semetey-2-2013:p1212:b004:l012","ordinal":279020,"en":"The lionlike Choro"},{"id":"semetey-2-2013:p1212:b004:l013","ordinal":279021,"en":"Stood helpless."},{"id":"semetey-2-2013:p1212:b004:l014","ordinal":279022,"en":"Then, when the man looked toward the qibla,"},{"id":"semetey-2-2013:p1212:b004:l015","ordinal":279023,"en":"There among the horses was Bozaiman,"},{"id":"semetey-2-2013:p1212:b004:l016","ordinal":279024,"en":"A creature wiser than other beasts."},{"id":"semetey-2-2013:p1212:b004:l017","ordinal":279025,"en":"Heaving deep sighs and drawing in his breath,"},{"id":"semetey-2-2013:p1212:b004:l018","ordinal":279026,"en":"He broke away from the herd,"},{"id":"semetey-2-2013:p1212:b004:l019","ordinal":279027,"en":"And from among the horses"},{"id":"semetey-2-2013:p1212:b004:l020","ordinal":279028,"en":"The creature came galloping up."},{"id":"semetey-2-2013:p1212:b004:l021","ordinal":279029,"en":"He appeared before Külchoro,"},{"id":"semetey-2-2013:p1212:b004:l022","ordinal":279030,"en":"His tail and mane streaming apart,"},{"id":"semetey-2-2013:p1212:b004:l023","ordinal":279031,"en":"Flicking his ears playfully,"},{"id":"semetey-2-2013:p1212:b004:l024","ordinal":279032,"en":"Pounding and scattering the earth,"},{"id":"semetey-2-2013:p1212:b004:l025","ordinal":279033,"en":"Twisting his neck like a wild ass,"},{"id":"semetey-2-2013:p1212:b004:l026","ordinal":279034,"en":"Neighing and pawing the ground,"},{"id":"semetey-2-2013:p1212:b004:l027","ordinal":279035,"en":"Striking and battering the earth,"},{"id":"semetey-2-2013:p1212:b004:l028","ordinal":279036,"en":"His tail and mane flowing."},{"id":"semetey-2-2013:p1212:b004:l029","ordinal":279037,"en":"In that sacred creature"},{"id":"semetey-2-2013:p1212:b004:l030","ordinal":279038,"en":"He plainly beheld"},{"id":"semetey-2-2013:p1212:b004:l031","ordinal":279039,"en":"Kambar-Ata, patron of horses."},{"id":"semetey-2-2013:p1212:b004:l032","ordinal":279040,"en":"When he saw Bozaiman,"}]
