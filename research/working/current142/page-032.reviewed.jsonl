{"id": "sayakbay-ms-current142:pdf032:l041", "source_id": "sayakbay-ms-current142", "pdf_sha256": "2b1fd33d35b9fec662724180743e44a26bc44d8b347d5f99c373acf98cb6c73f", "page": 32, "folio": 2349, "line_in_page": 41, "raw": "Белгилүү нашар турмушума.", "text": "Белгилүү нашар турмушума.", "en": "To my well-known wretched life.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The final possessive form is cramped.", "bbox": null}
