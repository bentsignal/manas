[{"id":"semetey-2-2013:p0020:b003:l028","ordinal":187649,"en":"When the fierce gun cracks,"},{"id":"semetey-2-2013:p0020:b003:l029","ordinal":187650,"en":"Let warriors come to Beijing"},{"id":"semetey-2-2013:p0020:b003:l030","ordinal":187651,"en":"Who fight without flinching."},{"id":"semetey-2-2013:p0020:b003:l031","ordinal":187652,"en":"When the black gun bangs,"},{"id":"semetey-2-2013:p0020:b003:l032","ordinal":187653,"en":"Let warriors come to Beijing"},{"id":"semetey-2-2013:p0020:b003:l033","ordinal":187654,"en":"Who stand and fight without fleeing."},{"id":"semetey-2-2013:p0020:b003:l034","ordinal":187655,"en":"When we stand on opposite banks,"},{"id":"semetey-2-2013:p0020:b003:l035","ordinal":187656,"en":"Shouting and leveling spears,"},{"id":"semetey-2-2013:p0020:b003:l036","ordinal":187657,"en":"Firing guns and drawing bows,"},{"id":"semetey-2-2013:p0020:b003:l037","ordinal":187658,"en":"Clashing together in battle,"},{"id":"semetey-2-2013:p0020:b003:l038","ordinal":187659,"en":"With arrows whirring"},{"id":"semetey-2-2013:p0020:b003:l039","ordinal":187660,"en":"And wounds burning,"},{"id":"semetey-2-2013:p0020:b004:l001","ordinal":187661,"en":"May they perish, struck by bullets,"},{"id":"semetey-2-2013:p0020:b004:l002","ordinal":187662,"en":"And spill blood in streams."},{"id":"semetey-2-2013:p0020:b004:l003","ordinal":187663,"en":"If you come to Beijing, come thus;"},{"id":"semetey-2-2013:p0020:b004:l004","ordinal":187664,"en":"In the land of Beijing,"},{"id":"semetey-2-2013:p0020:b004:l005","ordinal":187665,"en":"If you fight, fight in this way"},{"id":"semetey-2-2013:p0020:b004:l006","ordinal":187666,"en":"Against the Chinese hero Khan Kongurbai."},{"id":"semetey-2-2013:p0020:b004:l007","ordinal":187667,"en":"Understand what I have said;"},{"id":"semetey-2-2013:p0020:b004:l008","ordinal":187668,"en":"Your uncle Joodur has spoken."},{"id":"semetey-2-2013:p0020:b004:l009","ordinal":187669,"en":"My lion, my son, heed me.”"},{"id":"semetey-2-2013:p0020:b004:l010","ordinal":187670,"en":"When Semetey heard this, he said:"},{"id":"semetey-2-2013:p0020:b004:l011","ordinal":187671,"en":"“My uncle whom I regard as a father,"},{"id":"semetey-2-2013:p0020:b004:l012","ordinal":187672,"en":"What you say is wise."},{"id":"semetey-2-2013:p0020:b004:l013","ordinal":187673,"en":"If I refuse to heed you,"},{"id":"semetey-2-2013:p0020:b004:l014","ordinal":187674,"en":"May my six forefathers be infidels.”"},{"id":"semetey-2-2013:p0020:b004:l015","ordinal":187675,"en":"Foolishness was struck by God"},{"id":"semetey-2-2013:p0020:b004:l016","ordinal":187676,"en":"From father to grandfather:"},{"id":"semetey-2-2013:p0020:b004:l017","ordinal":187677,"en":"His lion uncle Bakai was absent,"},{"id":"semetey-2-2013:p0020:b004:l018","ordinal":187678,"en":"And he let himself be deceived repeatedly"},{"id":"semetey-2-2013:p0020:b004:l019","ordinal":187679,"en":"By Karagul himself."},{"id":"semetey-2-2013:p0020:b004:l020","ordinal":187680,"en":"Karagul, son of Katal—"},{"id":"semetey-2-2013:p0020:b004:l021","ordinal":187681,"en":"Here was black calamity."},{"id":"semetey-2-2013:p0020:b004:l022","ordinal":187682,"en":"That raging swine's"},{"id":"semetey-2-2013:p0020:b004:l023","ordinal":187683,"en":"Deed was done in this way;"},{"id":"semetey-2-2013:p0020:b004:l024","ordinal":187684,"en":"Upon the young son of Manas"},{"id":"semetey-2-2013:p0020:b004:l025","ordinal":187685,"en":"He laid a singular corruption."},{"id":"semetey-2-2013:p0020:b004:l026","ordinal":187686,"en":"Foolishly born Semetey"},{"id":"semetey-2-2013:p0020:b004:l027","ordinal":187687,"en":"Said he would obey him;"},{"id":"semetey-2-2013:p0020:b004:l028","ordinal":187688,"en":"To the deceiver he said,"},{"id":"semetey-2-2013:p0020:b004:l029","ordinal":187689,"en":"“I shall give you my mother.”"},{"id":"semetey-2-2013:p0020:b004:l030","ordinal":187690,"en":"Then Karagul—"},{"id":"semetey-2-2013:p0020:b004:l031","ordinal":187691,"en":"God had now struck the slave—"},{"id":"semetey-2-2013:p0020:b004:l032","ordinal":187692,"en":"Took the gold-cheeked battle-axe"},{"id":"semetey-2-2013:p0020:b004:l033","ordinal":187693,"en":"And braced it at his waist,"},{"id":"semetey-2-2013:p0020:b004:l034","ordinal":187694,"en":"And now invoked Manas too."},{"id":"semetey-2-2013:p0020:b004:l035","ordinal":187695,"en":"Saying, “This is my true kinsman,”"},{"id":"semetey-2-2013:p0020:b004:l036","ordinal":187696,"en":"God now struck the prince."},{"id":"semetey-2-2013:p0020:b004:l037","ordinal":187697,"en":"The towering Arbuurul,"},{"id":"semetey-2-2013:p0020:b004:l038","ordinal":187698,"en":"When he took on his summer coat,"},{"id":"semetey-2-2013:p0020:b004:l039","ordinal":187699,"en":"That red-gray creature,"},{"id":"semetey-2-2013:p0021:b003:l001","ordinal":187700,"en":"In wintertime"},{"id":"semetey-2-2013:p0021:b003:l002","ordinal":187701,"en":"He turned black-gray."},{"id":"semetey-2-2013:p0021:b003:l003","ordinal":187702,"en":"He bent his neck like a stag;"},{"id":"semetey-2-2013:p0021:b003:l004","ordinal":187703,"en":"If game appeared a shot's length away,"},{"id":"semetey-2-2013:p0021:b003:l005","ordinal":187704,"en":"He bounded without hesitation."},{"id":"semetey-2-2013:p0021:b003:l006","ordinal":187705,"en":"When his excellence became known,"},{"id":"semetey-2-2013:p0021:b003:l007","ordinal":187706,"en":"The khan of Bukhara asked for him."},{"id":"semetey-2-2013:p0021:b003:l008","ordinal":187707,"en":"He was not given when requested;"},{"id":"semetey-2-2013:p0021:b003:l009","ordinal":187708,"en":"Far from giving Buurul away,"},{"id":"semetey-2-2013:p0021:b003:l010","ordinal":187709,"en":"No ritually impure man ever rode him."},{"id":"semetey-2-2013:p0021:b003:l011","ordinal":187710,"en":"The foolish hero, son of Manas,"},{"id":"semetey-2-2013:p0021:b003:l012","ordinal":187711,"en":"Resolved to inspect the herd"},{"id":"semetey-2-2013:p0021:b003:l013","ordinal":187712,"en":"And release into it"},{"id":"semetey-2-2013:p0021:b003:l014","ordinal":187713,"en":"The towering swift horse."},{"id":"semetey-2-2013:p0021:b003:l015","ordinal":187714,"en":"Then Semetey said:"},{"id":"semetey-2-2013:p0021:b003:l016","ordinal":187715,"en":"“While my uncle Joodur is here,"},{"id":"semetey-2-2013:p0021:b003:l017","ordinal":187716,"en":"I shall wear the bulletproof armor"},{"id":"semetey-2-2013:p0021:b003:l018","ordinal":187717,"en":"Of hero Kongurbai the Kalcha;"},{"id":"semetey-2-2013:p0021:b003:l019","ordinal":187718,"en":"I shall catch and ride myself"},{"id":"semetey-2-2013:p0021:b003:l020","ordinal":187719,"en":"The Kalcha's winged Black Horse."},{"id":"semetey-2-2013:p0021:b003:l021","ordinal":187720,"en":"This year I shall have Buurul lead the herd"},{"id":"semetey-2-2013:p0021:b003:l022","ordinal":187721,"en":"And drive it to Talas."},{"id":"semetey-2-2013:p0021:b003:l023","ordinal":187722,"en":"Uncle Joodur, your words are true;"},{"id":"semetey-2-2013:p0021:b003:l024","ordinal":187723,"en":"Everything you said is true."},{"id":"semetey-2-2013:p0021:b003:l025","ordinal":187724,"en":"I shall grow fat and refreshed,"},{"id":"semetey-2-2013:p0021:b003:l026","ordinal":187725,"en":"Gathering an army for Beijing,"},{"id":"semetey-2-2013:p0021:b003:l027","ordinal":187726,"en":"Not a few but many,"},{"id":"semetey-2-2013:p0021:b003:l028","ordinal":187727,"en":"And then bring slaughter"},{"id":"semetey-2-2013:p0021:b003:l029","ordinal":187728,"en":"Upon hero Kongurbai."},{"id":"semetey-2-2013:p0021:b003:l030","ordinal":187729,"en":"Thus shall I avenge"},{"id":"semetey-2-2013:p0021:b003:l031","ordinal":187730,"en":"My father who passed into eternity."},{"id":"semetey-2-2013:p0021:b003:l032","ordinal":187731,"en":"I shall gird my waist firmly,"},{"id":"semetey-2-2013:p0021:b003:l033","ordinal":187732,"en":"Commit myself and pray,"},{"id":"semetey-2-2013:p0021:b003:l034","ordinal":187733,"en":"And pursue my father's blood-price."},{"id":"semetey-2-2013:p0021:b003:l035","ordinal":187734,"en":"If fate arrives, I shall die;"},{"id":"semetey-2-2013:p0021:b003:l036","ordinal":187735,"en":"I shall contend with Kongurbai,"},{"id":"semetey-2-2013:p0021:b003:l037","ordinal":187736,"en":"The khan of the monks!”"},{"id":"semetey-2-2013:p0021:b003:l038","ordinal":187737,"en":"Having said this, Semetey"},{"id":"semetey-2-2013:p0021:b003:l039","ordinal":187738,"en":"Saddled Arbuurul"},{"id":"semetey-2-2013:p0021:b004:l001","ordinal":187739,"en":"With the Akkangky saddle made by Almambet:"},{"id":"semetey-2-2013:p0021:b004:l002","ordinal":187740,"en":"Its front bow of white gold,"},{"id":"semetey-2-2013:p0021:b004:l003","ordinal":187741,"en":"Its rear bow of pure silver,"},{"id":"semetey-2-2013:p0021:b004:l004","ordinal":187742,"en":"Both sides of broad iron."},{"id":"semetey-2-2013:p0021:b004:l005","ordinal":187743,"en":"Skilled when crossing passes,"},{"id":"semetey-2-2013:p0021:b004:l006","ordinal":187744,"en":"Alman, who departed for the next world,"},{"id":"semetey-2-2013:p0021:b004:l007","ordinal":187745,"en":"Had made it especially"},{"id":"semetey-2-2013:p0021:b004:l008","ordinal":187746,"en":"For the boy Semetey."},{"id":"semetey-2-2013:p0021:b004:l009","ordinal":187747,"en":"The great saddlecloth and leather sweat-pad"},{"id":"semetey-2-2013:p0021:b004:l010","ordinal":187748,"en":"Semetey stripped from Buurul,"},{"id":"semetey-2-2013:p0021:b004:l011","ordinal":187749,"en":"Deceived by Karagul;"},{"id":"semetey-2-2013:p0021:b004:l012","ordinal":187750,"en":"Your gray wolf began this deed."},{"id":"semetey-2-2013:p0021:b004:l013","ordinal":187751,"en":"He tied a white halter with a rosette knot"},{"id":"semetey-2-2013:p0021:b004:l014","ordinal":187752,"en":"Around his neck."},{"id":"semetey-2-2013:p0021:b004:l015","ordinal":187753,"en":"Once released, Buurul"},{"id":"semetey-2-2013:p0021:b004:l016","ordinal":187754,"en":"Led the vast herd."},{"id":"semetey-2-2013:p0021:b004:l017","ordinal":187755,"en":"Such was Buurul's excellence:"},{"id":"semetey-2-2013:p0021:b004:l018","ordinal":187756,"en":"He never panicked at a battle cry;"},{"id":"semetey-2-2013:p0021:b004:l019","ordinal":187757,"en":"On a moonless day,"},{"id":"semetey-2-2013:p0021:b004:l020","ordinal":187758,"en":"In a night when eyes could not see,"},{"id":"semetey-2-2013:p0021:b004:l021","ordinal":187759,"en":"He never misplaced a single step."},{"id":"semetey-2-2013:p0021:b004:l022","ordinal":187760,"en":"At a clamor he broke away;"},{"id":"semetey-2-2013:p0021:b004:l023","ordinal":187761,"en":"When he ran, the black earth"},{"id":"semetey-2-2013:p0021:b004:l024","ordinal":187762,"en":"Split layer by layer."},{"id":"semetey-2-2013:p0021:b004:l025","ordinal":187763,"en":"At all times that beast"},{"id":"semetey-2-2013:p0021:b004:l026","ordinal":187764,"en":"Showed the marks of a tulpar."},{"id":"semetey-2-2013:p0021:b004:l027","ordinal":187765,"en":"When urged onto stone,"},{"id":"semetey-2-2013:p0021:b004:l028","ordinal":187766,"en":"He did not slip from the heights."},{"id":"semetey-2-2013:p0021:b004:l029","ordinal":187767,"en":"In no way was he inferior"},{"id":"semetey-2-2013:p0021:b004:l030","ordinal":187768,"en":"To the kulan and game of the mountains."},{"id":"semetey-2-2013:p0021:b004:l031","ordinal":187769,"en":"Broad-chested with a low mane,"},{"id":"semetey-2-2013:p0021:b004:l032","ordinal":187770,"en":"Handsome Buurul horse,"},{"id":"semetey-2-2013:p0021:b004:l033","ordinal":187771,"en":"His hindquarters were like a ravine;"},{"id":"semetey-2-2013:p0021:b004:l034","ordinal":187772,"en":"His white front teeth"},{"id":"semetey-2-2013:p0021:b004:l035","ordinal":187773,"en":"Were like hammered steel."},{"id":"semetey-2-2013:p0021:b004:l036","ordinal":187774,"en":"He did not tire after six months' riding;"},{"id":"semetey-2-2013:p0021:b004:l037","ordinal":187775,"en":"Until sixty years of age,"},{"id":"semetey-2-2013:p0021:b004:l038","ordinal":187776,"en":"His tusklike teeth did not grow old."},{"id":"semetey-2-2013:p0021:b004:l039","ordinal":187777,"en":"His calves were like a boy's waist,"},{"id":"semetey-2-2013:p0022:b003:l001","ordinal":187778,"en":"His gait was like the high wind."},{"id":"semetey-2-2013:p0022:b003:l002","ordinal":187779,"en":"Toward the great herd"},{"id":"semetey-2-2013:p0022:b003:l003","ordinal":187780,"en":"Buurul advanced,"},{"id":"semetey-2-2013:p0022:b003:l004","ordinal":187781,"en":"Tossing his forelock to the sky"},{"id":"semetey-2-2013:p0022:b003:l005","ordinal":187782,"en":"And pounding his hooves into the earth."},{"id":"semetey-2-2013:p0022:b003:l006","ordinal":187783,"en":"He broke away at the head of the horses;"},{"id":"semetey-2-2013:p0022:b003:l007","ordinal":187784,"en":"As the beast drew straight ahead,"},{"id":"semetey-2-2013:p0022:b003:l008","ordinal":187785,"en":"His tulpar form appeared."},{"id":"semetey-2-2013:p0022:b003:l009","ordinal":187786,"en":"He had no tongue with which to speak,"},{"id":"semetey-2-2013:p0022:b003:l010","ordinal":187787,"en":"Yet was wiser than an animal."},{"id":"semetey-2-2013:p0022:b003:l011","ordinal":187788,"en":"Neighing and pawing the ground,"},{"id":"semetey-2-2013:p0022:b003:l012","ordinal":187789,"en":"He displayed his thoroughbred form,"},{"id":"semetey-2-2013:p0022:b003:l013","ordinal":187790,"en":"Flicking his forelock toward the sky"},{"id":"semetey-2-2013:p0022:b003:l014","ordinal":187791,"en":"And striking his willow-silk tail"},{"id":"semetey-2-2013:p0022:b003:l015","ordinal":187792,"en":"Against his hind legs."},{"id":"semetey-2-2013:p0022:b003:l016","ordinal":187793,"en":"Neighing with a rolling call,"},{"id":"semetey-2-2013:p0022:b003:l017","ordinal":187794,"en":"By God, the proud creature,"},{"id":"semetey-2-2013:p0022:b003:l018","ordinal":187795,"en":"Towering Arbuurul,"},{"id":"semetey-2-2013:p0022:b003:l019","ordinal":187796,"en":"Pounded the black earth."},{"id":"semetey-2-2013:p0022:b003:l020","ordinal":187797,"en":"Buurul horse left behind"},{"id":"semetey-2-2013:p0022:b003:l021","ordinal":187798,"en":"The prince, son of Manas."},{"id":"semetey-2-2013:p0022:b003:l022","ordinal":187799,"en":"The countless dark livestock gathered as tribute,"},{"id":"semetey-2-2013:p0022:b003:l023","ordinal":187800,"en":"The myriad treasury herds,"},{"id":"semetey-2-2013:p0022:b003:l024","ordinal":187801,"en":"Before a white cliff a rope-length high,"},{"id":"semetey-2-2013:p0022:b003:l025","ordinal":187802,"en":"The creature crossed in a single bound."},{"id":"semetey-2-2013:p0022:b003:l026","ordinal":187803,"en":"After that Buurul,"},{"id":"semetey-2-2013:p0022:b003:l027","ordinal":187804,"en":"The black stallion, father of horses,"},{"id":"semetey-2-2013:p0022:b003:l028","ordinal":187805,"en":"Ran after him without remaining behind;"},{"id":"semetey-2-2013:p0022:b003:l029","ordinal":187806,"en":"A bay stallion like a falcon hood,"},{"id":"semetey-2-2013:p0022:b003:l030","ordinal":187807,"en":"A yellow stallion with jingling ornaments—"},{"id":"semetey-2-2013:p0022:b003:l031","ordinal":187808,"en":"The great thundering herd"},{"id":"semetey-2-2013:p0022:b003:l032","ordinal":187809,"en":"All crossed after him."},{"id":"semetey-2-2013:p0022:b003:l033","ordinal":187810,"en":"The pattering foals and yearlings"},{"id":"semetey-2-2013:p0022:b003:l034","ordinal":187811,"en":"Died in the water;"},{"id":"semetey-2-2013:p0022:b003:l035","ordinal":187812,"en":"The whinnying mares and fillies"},{"id":"semetey-2-2013:p0022:b003:l036","ordinal":187813,"en":"Were left completely exhausted."},{"id":"semetey-2-2013:p0022:b003:l037","ordinal":187814,"en":"He raised the whole dark mass"},{"id":"semetey-2-2013:p0022:b003:l038","ordinal":187815,"en":"And thus Semetey took"},{"id":"semetey-2-2013:p0022:b003:l039","ordinal":187816,"en":"The thundering herd."},{"id":"semetey-2-2013:p0022:b004:l001","ordinal":187817,"en":"Do you see Karagul,"},{"id":"semetey-2-2013:p0022:b004:l002","ordinal":187818,"en":"Preparing treachery?"},{"id":"semetey-2-2013:p0022:b004:l003","ordinal":187819,"en":"Semetey stood here"},{"id":"semetey-2-2013:p0022:b004:l004","ordinal":187820,"en":"With a sheathe-less sword at his waist."},{"id":"semetey-2-2013:p0022:b004:l005","ordinal":187821,"en":"Karagul stood in anguish,"},{"id":"semetey-2-2013:p0022:b004:l006","ordinal":187822,"en":"Preparing the way to flee."},{"id":"semetey-2-2013:p0022:b004:l007","ordinal":187823,"en":"Do you see Semetey"},{"id":"semetey-2-2013:p0022:b004:l008","ordinal":187824,"en":"Begging Karagul to tell him"},{"id":"semetey-2-2013:p0022:b004:l009","ordinal":187825,"en":"Which was Kongurbai's horse?"},{"id":"semetey-2-2013:p0022:b004:l010","ordinal":187826,"en":"“Hey, my dear uncle,"},{"id":"semetey-2-2013:p0022:b004:l011","ordinal":187827,"en":"Did you see him leave from under me,"},{"id":"semetey-2-2013:p0022:b004:l012","ordinal":187828,"en":"My thoroughbred Arbuurul?"},{"id":"semetey-2-2013:p0022:b004:l013","ordinal":187829,"en":"Old Joodur, left from my father,"},{"id":"semetey-2-2013:p0022:b004:l014","ordinal":187830,"en":"My kinsman found upon the steppe."},{"id":"semetey-2-2013:p0022:b004:l015","ordinal":187831,"en":"Which is your infidel's Black Horse,"},{"id":"semetey-2-2013:p0022:b004:l016","ordinal":187832,"en":"So that I may ride it?"},{"id":"semetey-2-2013:p0022:b004:l017","ordinal":187833,"en":"Uncle, kindle my extinguished fire;"},{"id":"semetey-2-2013:p0022:b004:l018","ordinal":187834,"en":"Restore the dead soul."},{"id":"semetey-2-2013:p0022:b004:l019","ordinal":187835,"en":"Let me know your kinship;"},{"id":"semetey-2-2013:p0022:b004:l020","ordinal":187836,"en":"I shall thunder after the herd,"},{"id":"semetey-2-2013:p0022:b004:l021","ordinal":187837,"en":"Drive it from behind,"},{"id":"semetey-2-2013:p0022:b004:l022","ordinal":187838,"en":"And leave none at its roots,"},{"id":"semetey-2-2013:p0022:b004:l023","ordinal":187839,"en":"But drive them all into Talas!”"},{"id":"semetey-2-2013:p0022:b004:l024","ordinal":187840,"en":"Behind that herd,"},{"id":"semetey-2-2013:p0022:b004:l025","ordinal":187841,"en":"The black Kyyduukara horse"},{"id":"semetey-2-2013:p0022:b004:l026","ordinal":187842,"en":"Had remained apart."},{"id":"semetey-2-2013:p0022:b004:l027","ordinal":187843,"en":"Its figure and bearing,"},{"id":"semetey-2-2013:p0022:b004:l028","ordinal":187844,"en":"Its horse-like form,"},{"id":"semetey-2-2013:p0022:b004:l029","ordinal":187845,"en":"Stirred the heart at sight;"},{"id":"semetey-2-2013:p0022:b004:l030","ordinal":187846,"en":"The marks of a tulpar appeared."},{"id":"semetey-2-2013:p0022:b004:l031","ordinal":187847,"en":"God had struck the slave:"},{"id":"semetey-2-2013:p0022:b004:l032","ordinal":187848,"en":"Telling Semetey to ride it,"},{"id":"semetey-2-2013:p0022:b004:l033","ordinal":187849,"en":"He greatly praised"},{"id":"semetey-2-2013:p0022:b004:l034","ordinal":187850,"en":"The black Kyyduukara horse:"},{"id":"semetey-2-2013:p0022:b004:l035","ordinal":187851,"en":"“My dear Semetey,"},{"id":"semetey-2-2013:p0022:b004:l036","ordinal":187852,"en":"The great Black Horse, huge as a mountain,"},{"id":"semetey-2-2013:p0022:b004:l037","ordinal":187853,"en":"Was Algara himself."},{"id":"semetey-2-2013:p0022:b004:l038","ordinal":187854,"en":"This year that desolate swine"},{"id":"semetey-2-2013:p0022:b004:l039","ordinal":187855,"en":"Was seventy years of age."},{"id":"semetey-2-2013:p0023:b003:l001","ordinal":187856,"en":"Unless not a handspan of rein remained,"},{"id":"semetey-2-2013:p0023:b003:l002","ordinal":187857,"en":"Unless forty disasters struck,"},{"id":"semetey-2-2013:p0023:b003:l003","ordinal":187858,"en":"He would not let his rider be taken by the enemy."},{"id":"semetey-2-2013:p0023:b003:l004","ordinal":187859,"en":"Such was this Black Horse."},{"id":"semetey-2-2013:p0023:b003:l005","ordinal":187860,"en":"Born in the desert and raised among stones,"},{"id":"semetey-2-2013:p0023:b003:l006","ordinal":187861,"en":"The accursed one never became desert-worn;"},{"id":"semetey-2-2013:p0023:b003:l007","ordinal":187862,"en":"Raised apart by the unseen,"},{"id":"semetey-2-2013:p0023:b003:l008","ordinal":187863,"en":"The accursed one, in his third year,"},{"id":"semetey-2-2013:p0023:b003:l009","ordinal":187864,"en":"Raced with the kulan."},{"id":"semetey-2-2013:p0023:b003:l010","ordinal":187865,"en":"Have you heard of it?"},{"id":"semetey-2-2013:p0023:b003:l011","ordinal":187866,"en":"Kyz Saikal, daughter of Karacha Khan—"},{"id":"semetey-2-2013:p0023:b003:l012","ordinal":187867,"en":"The horse Kyz Saikal rode,"},{"id":"semetey-2-2013:p0023:b003:l013","ordinal":187868,"en":"The mighty tulpar Algara,"},{"id":"semetey-2-2013:p0023:b003:l014","ordinal":187869,"en":"Was born together with him."},{"id":"semetey-2-2013:p0023:b003:l015","ordinal":187870,"en":"When his mouth was released,"},{"id":"semetey-2-2013:p0023:b003:l016","ordinal":187871,"en":"When urged forward with a burst,"},{"id":"semetey-2-2013:p0023:b003:l017","ordinal":187872,"en":"He had a way of turning into an arrow."},{"id":"semetey-2-2013:p0023:b003:l018","ordinal":187873,"en":"When your uncle tells it,"},{"id":"semetey-2-2013:p0023:b003:l019","ordinal":187874,"en":"His tale has no end."},{"id":"semetey-2-2013:p0023:b003:l020","ordinal":187875,"en":"Such was Algara."},{"id":"semetey-2-2013:p0023:b003:l021","ordinal":187876,"en":"His tail and mane were no common things;"},{"id":"semetey-2-2013:p0023:b003:l022","ordinal":187877,"en":"Apart from hero Kalcha,"},{"id":"semetey-2-2013:p0023:b003:l023","ordinal":187878,"en":"No mortal ever rode him."},{"id":"semetey-2-2013:p0023:b003:l024","ordinal":187879,"en":"When he entered a crisis"},{"id":"semetey-2-2013:p0023:b003:l025","ordinal":187880,"en":"And opened his mouth,"},{"id":"semetey-2-2013:p0023:b003:l026","ordinal":187881,"en":"The beast flew roaring like a cloud;"},{"id":"semetey-2-2013:p0023:b003:l027","ordinal":187882,"en":"When stone touched his hoof,"},{"id":"semetey-2-2013:p0023:b003:l028","ordinal":187883,"en":"It burst apart layer by layer."},{"id":"semetey-2-2013:p0023:b003:l029","ordinal":187884,"en":"When angrily urged forward,"},{"id":"semetey-2-2013:p0023:b003:l030","ordinal":187885,"en":"His flesh separated like a sheep's,"},{"id":"semetey-2-2013:p0023:b003:l031","ordinal":187886,"en":"And his back straightened like a broad ridge."},{"id":"semetey-2-2013:p0023:b003:l032","ordinal":187887,"en":"When Kongurbai grew impassioned,"},{"id":"semetey-2-2013:p0023:b003:l033","ordinal":187888,"en":"He tied on his berenji waist-armor;"},{"id":"semetey-2-2013:p0023:b003:l034","ordinal":187889,"en":"The great Black Horse, swiftest of steeds,"},{"id":"semetey-2-2013:p0023:b003:l035","ordinal":187890,"en":"Circled Beijing of the Kakanchin"},{"id":"semetey-2-2013:p0023:b003:l036","ordinal":187891,"en":"In twelve days."},{"id":"semetey-2-2013:p0023:b003:l037","ordinal":187892,"en":"If you ride, the Black Horse is that steed;"},{"id":"semetey-2-2013:p0023:b003:l038","ordinal":187893,"en":"From the speed of this beast,"},{"id":"semetey-2-2013:p0023:b003:l039","ordinal":187894,"en":"In a fierce spear fight,"},{"id":"semetey-2-2013:p0023:b004:l001","ordinal":187895,"en":"Yesterday, when the clash came,"},{"id":"semetey-2-2013:p0023:b004:l002","ordinal":187896,"en":"Within the fortress"},{"id":"semetey-2-2013:p0023:b004:l003","ordinal":187897,"en":"Where your father gray-wolf Manas fought,"},{"id":"semetey-2-2013:p0023:b004:l004","ordinal":187898,"en":"When he entered dire straits,"},{"id":"semetey-2-2013:p0023:b004:l005","ordinal":187899,"en":"In the forty-day desert,"},{"id":"semetey-2-2013:p0023:b004:l006","ordinal":187900,"en":"Your khan father's Aimanboz,"},{"id":"semetey-2-2013:p0023:b004:l007","ordinal":187901,"en":"After going six days without water,"},{"id":"semetey-2-2013:p0023:b004:l008","ordinal":187902,"en":"Yesterday could travel no farther."},{"id":"semetey-2-2013:p0023:b004:l009","ordinal":187903,"en":"Six thousand Chinese and countless kaldays,"},{"id":"semetey-2-2013:p0023:b004:l010","ordinal":187904,"en":"With white-bearded Kongurbai,"}]
