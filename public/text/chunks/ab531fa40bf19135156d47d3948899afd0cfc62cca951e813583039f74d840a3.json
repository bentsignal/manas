[{"id":"semetey-1-2013:p0256:b004:l028","ordinal":96513,"en":"For the courser beneath him,"},{"id":"semetey-1-2013:p0256:b004:l029","ordinal":96514,"en":"He took the white whip with dark handle,"},{"id":"semetey-1-2013:p0256:b004:l030","ordinal":96515,"en":"Grasped it and swung it round."},{"id":"semetey-1-2013:p0256:b004:l031","ordinal":96516,"en":"The courser, great as a mountain,"},{"id":"semetey-1-2013:p0256:b004:l032","ordinal":96517,"en":"He struck upon the hock."},{"id":"semetey-1-2013:p0256:b004:l033","ordinal":96518,"en":"Tearing up the ground he trod,"},{"id":"semetey-1-2013:p0256:b004:l034","ordinal":96519,"en":"The marvelous leopard of a boy"},{"id":"semetey-1-2013:p0256:b004:l035","ordinal":96520,"en":"Galloped upon his courser,"},{"id":"semetey-1-2013:p0256:b004:l036","ordinal":96521,"en":"Across countless stones and sands,"},{"id":"semetey-1-2013:p0256:b004:l037","ordinal":96522,"en":"By Echo's steep Jar-Kyya cliff,"},{"id":"semetey-1-2013:p0256:b004:l038","ordinal":96523,"en":"The narrow track for a single beast,"},{"id":"semetey-1-2013:p0256:b004:l039","ordinal":96524,"en":"Along the slope of Urchuk Mountain,"},{"id":"semetey-1-2013:p0257:b003:l001","ordinal":96525,"en":"When restless, Semetey"},{"id":"semetey-1-2013:p0257:b003:l002","ordinal":96526,"en":"Would go up to his lookout place;"},{"id":"semetey-1-2013:p0257:b003:l003","ordinal":96527,"en":"Toward the pass of Chong-Karool"},{"id":"semetey-1-2013:p0257:b003:l004","ordinal":96528,"en":"He turned his courser's head."},{"id":"semetey-1-2013:p0257:b003:l005","ordinal":96529,"en":"Then Semetey"},{"id":"semetey-1-2013:p0257:b003:l006","ordinal":96530,"en":"Looked toward the tumult."},{"id":"semetey-1-2013:p0257:b003:l007","ordinal":96531,"en":"He listened to the tumult now,"},{"id":"semetey-1-2013:p0257:b003:l008","ordinal":96532,"en":"And learned what the commotion meant."},{"id":"semetey-1-2013:p0257:b003:l009","ordinal":96533,"en":"When he had heard that uproar:"},{"id":"semetey-1-2013:p0257:b003:l010","ordinal":96534,"en":"'O Almighty, Baabedin!"},{"id":"semetey-1-2013:p0257:b003:l011","ordinal":96535,"en":"Ah, Almighty, Baabedin!"},{"id":"semetey-1-2013:p0257:b003:l012","ordinal":96536,"en":"God creates the soul,"},{"id":"semetey-1-2013:p0257:b003:l013","ordinal":96537,"en":"And my soul is leaving me."},{"id":"semetey-1-2013:p0257:b003:l014","ordinal":96538,"en":"Champions, ride here all together!"},{"id":"semetey-1-2013:p0257:b003:l015","ordinal":96539,"en":"You white-bearded elders, ride!"},{"id":"semetey-1-2013:p0257:b003:l016","ordinal":96540,"en":"All you finest men, come here!"},{"id":"semetey-1-2013:p0257:b003:l017","ordinal":96541,"en":"Listen to the commotion,"},{"id":"semetey-1-2013:p0257:b003:l018","ordinal":96542,"en":"Learn what the tumult means."},{"id":"semetey-1-2013:p0257:b003:l019","ordinal":96543,"en":"If my sister's horse appears,"},{"id":"semetey-1-2013:p0257:b003:l020","ordinal":96544,"en":"Cheer that one onward."},{"id":"semetey-1-2013:p0257:b003:l021","ordinal":96545,"en":"My dear champions,"},{"id":"semetey-1-2013:p0257:b003:l022","ordinal":96546,"en":"Come here, you men!"},{"id":"semetey-1-2013:p0257:b003:l023","ordinal":96547,"en":"Have you learned what I have learned?"},{"id":"semetey-1-2013:p0257:b003:l024","ordinal":96548,"en":"Have you heard what I have heard?"},{"id":"semetey-1-2013:p0257:b003:l025","ordinal":96549,"en":"A shrill, shrill, shrill sound rises;"},{"id":"semetey-1-2013:p0257:b003:l026","ordinal":96550,"en":"The voice screams piercingly."},{"id":"semetey-1-2013:p0257:b003:l027","ordinal":96551,"en":"Across the broad hill pasture,"},{"id":"semetey-1-2013:p0257:b003:l028","ordinal":96552,"en":"It is the voice of one who shares our slope."},{"id":"semetey-1-2013:p0257:b003:l029","ordinal":96553,"en":"Her heart is filled with grief."},{"id":"semetey-1-2013:p0257:b003:l030","ordinal":96554,"en":"Is it not a woman's voice?"},{"id":"semetey-1-2013:p0257:b003:l031","ordinal":96555,"en":"My dear elder sister Kanykei—"},{"id":"semetey-1-2013:p0257:b003:l032","ordinal":96556,"en":"Did she not come here wandering?"},{"id":"semetey-1-2013:p0257:b003:l033","ordinal":96557,"en":"It is the voice of my own nestmate."},{"id":"semetey-1-2013:p0257:b003:l034","ordinal":96558,"en":"With neither mane nor tail at all,"},{"id":"semetey-1-2013:p0257:b003:l035","ordinal":96559,"en":"It is my poor unfortunate's voice!"},{"id":"semetey-1-2013:p0257:b003:l036","ordinal":96560,"en":"Bereft of her magnanimous lord,"},{"id":"semetey-1-2013:p0257:b003:l037","ordinal":96561,"en":"She fled and came here:"},{"id":"semetey-1-2013:p0257:b003:l038","ordinal":96562,"en":"It is my poor unfortunate's voice!"},{"id":"semetey-1-2013:p0257:b003:l039","ordinal":96563,"en":"Fleeing Talas, wandering on foot,"},{"id":"semetey-1-2013:p0257:b005:l001","ordinal":96564,"en":"My sister trudged along: it is her voice."},{"id":"semetey-1-2013:p0257:b005:l002","ordinal":96565,"en":"To Temir Khan's city"},{"id":"semetey-1-2013:p0257:b005:l003","ordinal":96566,"en":"She came wandering and made her life:"},{"id":"semetey-1-2013:p0257:b005:l004","ordinal":96567,"en":"It is that poor wretch's voice."},{"id":"semetey-1-2013:p0257:b005:l005","ordinal":96568,"en":"Her forehead bone is formed otherwise:"},{"id":"semetey-1-2013:p0257:b005:l006","ordinal":96569,"en":"It is my ill-fated sister's voice."},{"id":"semetey-1-2013:p0257:b005:l007","ordinal":96570,"en":"Bereft of her sovereign,"},{"id":"semetey-1-2013:p0257:b005:l008","ordinal":96571,"en":"She fled to Bukhara:"},{"id":"semetey-1-2013:p0257:b005:l009","ordinal":96572,"en":"It is my poor sister's voice."},{"id":"semetey-1-2013:p0257:b005:l010","ordinal":96573,"en":"Heaped treasure, countless possessions—"},{"id":"semetey-1-2013:p0257:b005:l011","ordinal":96574,"en":"My sister scattered them: it is her voice."},{"id":"semetey-1-2013:p0257:b005:l012","ordinal":96575,"en":"She suffered a terrible hell,"},{"id":"semetey-1-2013:p0257:b005:l013","ordinal":96576,"en":"Saying, 'When a woman's husband dies,"},{"id":"semetey-1-2013:p0257:b005:l014","ordinal":96577,"en":"Her birth family is her refuge,'"},{"id":"semetey-1-2013:p0257:b005:l015","ordinal":96578,"en":"To the great city of Bukhara"},{"id":"semetey-1-2013:p0257:b005:l016","ordinal":96579,"en":"My sister fled: it is her voice."},{"id":"semetey-1-2013:p0257:b005:l017","ordinal":96580,"en":"With no one to look after her,"},{"id":"semetey-1-2013:p0257:b005:l018","ordinal":96581,"en":"Grieving in Bukhara"},{"id":"semetey-1-2013:p0257:b005:l019","ordinal":96582,"en":"My sister dwells: it is her voice."},{"id":"semetey-1-2013:p0257:b005:l020","ordinal":96583,"en":"Hardship fell upon her lonely head;"},{"id":"semetey-1-2013:p0257:b005:l021","ordinal":96584,"en":"My sister came: it is her voice."},{"id":"semetey-1-2013:p0257:b005:l022","ordinal":96585,"en":"Bereft of her good fortune,"},{"id":"semetey-1-2013:p0257:b005:l023","ordinal":96586,"en":"Wandering tirelessly to Bukhara"},{"id":"semetey-1-2013:p0257:b005:l024","ordinal":96587,"en":"My sister came: it is her voice."},{"id":"semetey-1-2013:p0257:b005:l025","ordinal":96588,"en":"To Temir Khan's city,"},{"id":"semetey-1-2013:p0257:b005:l026","ordinal":96589,"en":"Wandering from Talas,"},{"id":"semetey-1-2013:p0257:b005:l027","ordinal":96590,"en":"My sister settled: it is her voice."},{"id":"semetey-1-2013:p0257:b005:l028","ordinal":96591,"en":"Disgraced before the whole world,"},{"id":"semetey-1-2013:p0257:b005:l029","ordinal":96592,"en":"That poor unfortunate: it is her voice."},{"id":"semetey-1-2013:p0257:b005:l030","ordinal":96593,"en":"Kara-Kyya, Kezeng-Tash!"},{"id":"semetey-1-2013:p0257:b005:l031","ordinal":96594,"en":"When I hear my sister's voice,"},{"id":"semetey-1-2013:p0257:b005:l032","ordinal":96595,"en":"Alas, day and world, may you never prosper!"},{"id":"semetey-1-2013:p0257:b005:l033","ordinal":96596,"en":"How many tears flow from my eyes!"},{"id":"semetey-1-2013:p0257:b005:l034","ordinal":96597,"en":"Champions, just think:"},{"id":"semetey-1-2013:p0257:b005:l035","ordinal":96598,"en":"Though she have a thousand white palaces,"},{"id":"semetey-1-2013:p0257:b005:l036","ordinal":96599,"en":"Cursed is the lack of food!"},{"id":"semetey-1-2013:p0257:b005:l037","ordinal":96600,"en":"Bereft of her magnanimous lord,"},{"id":"semetey-1-2013:p0257:b005:l038","ordinal":96601,"en":"She came destitute to Bukhara:"},{"id":"semetey-1-2013:p0257:b005:l039","ordinal":96602,"en":"Cursed is the lack of a head to guide her!"},{"id":"semetey-1-2013:p0258:b003:l001","ordinal":96603,"en":"If no water lies upon its face,"},{"id":"semetey-1-2013:p0258:b003:l002","ordinal":96604,"en":"Cursed be the barren plain!"},{"id":"semetey-1-2013:p0258:b003:l003","ordinal":96605,"en":"When a woman's khan has died,"},{"id":"semetey-1-2013:p0258:b003:l004","ordinal":96606,"en":"Cursed is her childlessness!"},{"id":"semetey-1-2013:p0258:b003:l005","ordinal":96607,"en":"While my brother-in-law Manas lived,"},{"id":"semetey-1-2013:p0258:b003:l006","ordinal":96608,"en":"My sister Kanykei was a fierce sovereign;"},{"id":"semetey-1-2013:p0258:b003:l007","ordinal":96609,"en":"Her prudent management and service"},{"id":"semetey-1-2013:p0258:b003:l008","ordinal":96610,"en":"Were equal to a monarch's."},{"id":"semetey-1-2013:p0258:b003:l009","ordinal":96611,"en":"When my heroic brother-in-law died,"},{"id":"semetey-1-2013:p0258:b003:l010","ordinal":96612,"en":"Cursed was her childlessness!"},{"id":"semetey-1-2013:p0258:b003:l011","ordinal":96613,"en":"To this city of Bukhara"},{"id":"semetey-1-2013:p0258:b003:l012","ordinal":96614,"en":"She came, a wandering soul."},{"id":"semetey-1-2013:p0258:b003:l013","ordinal":96615,"en":"The ravine crumbled and became a road;"},{"id":"semetey-1-2013:p0258:b003:l014","ordinal":96616,"en":"The prince's wife,"},{"id":"semetey-1-2013:p0258:b003:l015","ordinal":96617,"en":"My dear sister Kanykei,"},{"id":"semetey-1-2013:p0258:b003:l016","ordinal":96618,"en":"Wandered to Bukhara in humiliation."},{"id":"semetey-1-2013:p0258:b003:l017","ordinal":96619,"en":"No spring flowed before her;"},{"id":"semetey-1-2013:p0258:b003:l018","ordinal":96620,"en":"My poor, fierce sister"},{"id":"semetey-1-2013:p0258:b003:l019","ordinal":96621,"en":"Had no offspring left by her hero."},{"id":"semetey-1-2013:p0258:b003:l020","ordinal":96622,"en":"Once God lays this upon one's head,"},{"id":"semetey-1-2013:p0258:b003:l021","ordinal":96623,"en":"Men, there is no choice but to bear it."},{"id":"semetey-1-2013:p0258:b003:l022","ordinal":96624,"en":"My fierce brother-in-law passed away,"},{"id":"semetey-1-2013:p0258:b003:l023","ordinal":96625,"en":"Leaving no male child behind!"},{"id":"semetey-1-2013:p0258:b003:l024","ordinal":96626,"en":"My unfortunate sister Kanykei"},{"id":"semetey-1-2013:p0258:b003:l025","ordinal":96627,"en":"Wandered to Bukhara and settled,"},{"id":"semetey-1-2013:p0258:b003:l026","ordinal":96628,"en":"Heard rumours among the people,"},{"id":"semetey-1-2013:p0258:b003:l027","ordinal":96629,"en":"Hearing, 'She is a wandering woman.'"},{"id":"semetey-1-2013:p0258:b003:l028","ordinal":96630,"en":"Alas, my poor sister"},{"id":"semetey-1-2013:p0258:b003:l029","ordinal":96631,"en":"Had acquired a bad name."},{"id":"semetey-1-2013:p0258:b003:l030","ordinal":96632,"en":"My dear champions,"},{"id":"semetey-1-2013:p0258:b003:l031","ordinal":96633,"en":"I heard from those who came:"},{"id":"semetey-1-2013:p0258:b003:l032","ordinal":96634,"en":"As a test of fate in Bukhara,"},{"id":"semetey-1-2013:p0258:b003:l033","ordinal":96635,"en":"I heard, she raced Taytoru."},{"id":"semetey-1-2013:p0258:b003:l034","ordinal":96636,"en":"My dear sister Kanykei"},{"id":"semetey-1-2013:p0258:b003:l035","ordinal":96637,"en":"Clothed herself in men's attire,"},{"id":"semetey-1-2013:p0258:b003:l036","ordinal":96638,"en":"Grieving for her husband's death,"},{"id":"semetey-1-2013:p0258:b003:l037","ordinal":96639,"en":"Making her wandering self a lion,"},{"id":"semetey-1-2013:p0258:b003:l038","ordinal":96640,"en":"Making her woman's self a warrior,"},{"id":"semetey-1-2013:p0258:b003:l039","ordinal":96641,"en":"Bringing every limb into accord."},{"id":"semetey-1-2013:p0258:b004:l001","ordinal":96642,"en":"Buried treasure, may you never prosper!"},{"id":"semetey-1-2013:p0258:b004:l002","ordinal":96643,"en":"She made a lake of her tears."},{"id":"semetey-1-2013:p0258:b004:l003","ordinal":96644,"en":"The Boz Kise left by Manas"},{"id":"semetey-1-2013:p0258:b004:l004","ordinal":96645,"en":"She hung snugly round her neck,"},{"id":"semetey-1-2013:p0258:b004:l005","ordinal":96646,"en":"To the lord who had gone to the other world,"},{"id":"semetey-1-2013:p0258:b004:l006","ordinal":96647,"en":"To his spirit she prayed."},{"id":"semetey-1-2013:p0258:b004:l007","ordinal":96648,"en":"Thinking of her honor, my sister,"},{"id":"semetey-1-2013:p0258:b004:l008","ordinal":96649,"en":"A widow, stirred with excitement,"},{"id":"semetey-1-2013:p0258:b004:l009","ordinal":96650,"en":"Among Bukhara's eight city khans,"},{"id":"semetey-1-2013:p0258:b004:l010","ordinal":96651,"en":"Was seized with the wish to race her horse."},{"id":"semetey-1-2013:p0258:b004:l011","ordinal":96652,"en":"I heard she made a test of fate:"},{"id":"semetey-1-2013:p0258:b004:l012","ordinal":96653,"en":"If her bay horse came first,"},{"id":"semetey-1-2013:p0258:b004:l013","ordinal":96654,"en":"She would share the chief prize;"},{"id":"semetey-1-2013:p0258:b004:l014","ordinal":96655,"en":"If her bay horse fell behind,"},{"id":"semetey-1-2013:p0258:b004:l015","ordinal":96656,"en":"My dear sister"},{"id":"semetey-1-2013:p0258:b004:l016","ordinal":96657,"en":"Would die before her appointed death."},{"id":"semetey-1-2013:p0258:b004:l017","ordinal":96658,"en":"If there were a way in this world,"},{"id":"semetey-1-2013:p0258:b004:l018","ordinal":96659,"en":"She would see some good fortune."},{"id":"semetey-1-2013:p0258:b004:l019","ordinal":96660,"en":"As a test of fate, Taytoru"},{"id":"semetey-1-2013:p0258:b004:l020","ordinal":96661,"en":"Was the horse she raced, I heard."},{"id":"semetey-1-2013:p0258:b004:l021","ordinal":96662,"en":"Let us cry, 'Baabedin!'"},{"id":"semetey-1-2013:p0258:b004:l022","ordinal":96663,"en":"This is the day of the poor."},{"id":"semetey-1-2013:p0258:b004:l023","ordinal":96664,"en":"Let us watch, champions!"},{"id":"semetey-1-2013:p0258:b004:l024","ordinal":96665,"en":"A shrill, shrill, shrill sound rises;"},{"id":"semetey-1-2013:p0258:b004:l025","ordinal":96666,"en":"The voice screams piercingly."},{"id":"semetey-1-2013:p0258:b004:l026","ordinal":96667,"en":"At the end of the scream"},{"id":"semetey-1-2013:p0258:b004:l027","ordinal":96668,"en":"She earnestly cries, 'My lord!'"},{"id":"semetey-1-2013:p0258:b004:l028","ordinal":96669,"en":"Having wandered to Bukhara,"},{"id":"semetey-1-2013:p0258:b004:l029","ordinal":96670,"en":"It is my sister's voice."},{"id":"semetey-1-2013:p0258:b004:l030","ordinal":96671,"en":"Every wish of hers, the one God—"},{"id":"semetey-1-2013:p0258:b004:l031","ordinal":96672,"en":"Perhaps he has granted them this day!"},{"id":"semetey-1-2013:p0258:b004:l032","ordinal":96673,"en":"My unfortunate sister's Taytoru,"},{"id":"semetey-1-2013:p0258:b004:l033","ordinal":96674,"en":"Contending for the lead,"},{"id":"semetey-1-2013:p0258:b004:l034","ordinal":96675,"en":"Perhaps has reached us on this day."},{"id":"semetey-1-2013:p0258:b004:l035","ordinal":96676,"en":"For my poor, fierce sister,"},{"id":"semetey-1-2013:p0258:b004:l036","ordinal":96677,"en":"God has surely opened fortune's door."},{"id":"semetey-1-2013:p0258:b004:l037","ordinal":96678,"en":"For my unfortunate, fierce sister,"},{"id":"semetey-1-2013:p0258:b004:l038","ordinal":96679,"en":"God has surely opened the way."},{"id":"semetey-1-2013:p0258:b004:l039","ordinal":96680,"en":"'Live out the days written for you,' he says,"},{"id":"semetey-1-2013:p0259:b003:l001","ordinal":96681,"en":"Such must be the writing of the Creator."},{"id":"semetey-1-2013:p0259:b003:l002","ordinal":96682,"en":"The one God has granted her wish:"},{"id":"semetey-1-2013:p0259:b003:l003","ordinal":96683,"en":"The horse running at the head"},{"id":"semetey-1-2013:p0259:b003:l004","ordinal":96684,"en":"Must be my sister's horse called Taytoru."},{"id":"semetey-1-2013:p0259:b003:l005","ordinal":96685,"en":"When that poor woman lamented,"},{"id":"semetey-1-2013:p0259:b003:l006","ordinal":96686,"en":"God must have granted her wish!"},{"id":"semetey-1-2013:p0259:b003:l007","ordinal":96687,"en":"With hoe-like hooves and broad haunches,"},{"id":"semetey-1-2013:p0259:b003:l008","ordinal":96688,"en":"The courser of the open land,"},{"id":"semetey-1-2013:p0259:b003:l009","ordinal":96689,"en":"Handsome Taytoru,"},{"id":"semetey-1-2013:p0259:b003:l010","ordinal":96690,"en":"Must have moved into the lead."},{"id":"semetey-1-2013:p0259:b003:l011","ordinal":96691,"en":"For my poor, unfortunate sister,"},{"id":"semetey-1-2013:p0259:b003:l012","ordinal":96692,"en":"God must have lifted her gloom.'"},{"id":"semetey-1-2013:p0259:b003:l013","ordinal":96693,"en":"Then, saying these words,"},{"id":"semetey-1-2013:p0259:b003:l014","ordinal":96694,"en":"The marvelous orphan Semetey,"},{"id":"semetey-1-2013:p0259:b003:l015","ordinal":96695,"en":"His many cares overflowing his breast,"},{"id":"semetey-1-2013:p0259:b003:l016","ordinal":96696,"en":"Longed to witness this affair;"},{"id":"semetey-1-2013:p0259:b003:l017","ordinal":96697,"en":"His tears streamed ten ways."},{"id":"semetey-1-2013:p0259:b003:l018","ordinal":96698,"en":"Upon a ridge like a saddle's back,"},{"id":"semetey-1-2013:p0259:b003:l019","ordinal":96699,"en":"Semetey tossed restlessly."},{"id":"semetey-1-2013:p0259:b003:l020","ordinal":96700,"en":"His tears streamed ten ways:"},{"id":"semetey-1-2013:p0259:b003:l021","ordinal":96701,"en":"Semetey stood weeping!"},{"id":"semetey-1-2013:p0259:b003:l022","ordinal":96702,"en":"Without looking about him,"},{"id":"semetey-1-2013:p0259:b003:l023","ordinal":96703,"en":"Like a man staggering,"},{"id":"semetey-1-2013:p0259:b003:l024","ordinal":96704,"en":"Sparing himself not at all,"},{"id":"semetey-1-2013:p0259:b003:l025","ordinal":96705,"en":"He turned his courser's head."},{"id":"semetey-1-2013:p0259:b003:l026","ordinal":96706,"en":"Semetey, the hawk's surviving son,"},{"id":"semetey-1-2013:p0259:b003:l027","ordinal":96707,"en":"Looked straight across."},{"id":"semetey-1-2013:p0259:b003:l028","ordinal":96708,"en":"Upon the fearsome headland,"},{"id":"semetey-1-2013:p0259:b003:l029","ordinal":96709,"en":"At the spur of the winding mountain,"},{"id":"semetey-1-2013:p0259:b003:l030","ordinal":96710,"en":"It had lowered its head to the ground:"},{"id":"semetey-1-2013:p0259:b003:l031","ordinal":96711,"en":"That wondrous, mighty beast"},{"id":"semetey-1-2013:p0259:b003:l032","ordinal":96712,"en":"Had begun to run as never before."},{"id":"semetey-1-2013:p0259:b003:l033","ordinal":96713,"en":"It had lowered its neck to the ground:"},{"id":"semetey-1-2013:p0259:b003:l034","ordinal":96714,"en":"The well-shaped racer Taytoru"},{"id":"semetey-1-2013:p0259:b003:l035","ordinal":96715,"en":"Ran irresistibly onward."},{"id":"semetey-1-2013:p0259:b003:l036","ordinal":96716,"en":"Among six hundred and forty-three coursers,"},{"id":"semetey-1-2013:p0259:b003:l037","ordinal":96717,"en":"It had broken away at the head."},{"id":"semetey-1-2013:p0259:b003:l038","ordinal":96718,"en":"Until it reached the halfway point,"},{"id":"semetey-1-2013:p0259:b003:l039","ordinal":96719,"en":"It had contended with Aktulpar."},{"id":"semetey-1-2013:p0259:b005:l001","ordinal":96720,"en":"Its eyes reddening like a gazelle's,"},{"id":"semetey-1-2013:p0259:b005:l002","ordinal":96721,"en":"Ahead of Aktulpar"},{"id":"semetey-1-2013:p0259:b005:l003","ordinal":96722,"en":"Taytoru had moved,"},{"id":"semetey-1-2013:p0259:b005:l004","ordinal":96723,"en":"Stretching seven bowshots clear."},{"id":"semetey-1-2013:p0259:b005:l005","ordinal":96724,"en":"Its body had warmed up;"},{"id":"semetey-1-2013:p0259:b005:l006","ordinal":96725,"en":"The racer sixty years beyond its first four"},{"id":"semetey-1-2013:p0259:b005:l007","ordinal":96726,"en":"Now exerted its strength."},{"id":"semetey-1-2013:p0259:b005:l008","ordinal":96727,"en":"The ground beneath it crumbled;"},{"id":"semetey-1-2013:p0259:b005:l009","ordinal":96728,"en":"Clods as large as a great cauldron"},{"id":"semetey-1-2013:p0259:b005:l010","ordinal":96729,"en":"Whirled above its head."},{"id":"semetey-1-2013:p0259:b005:l011","ordinal":96730,"en":"Its stride stretched like a wild ewe's,"},{"id":"semetey-1-2013:p0259:b005:l012","ordinal":96731,"en":"Its eyes reddened like a wild ram's,"},{"id":"semetey-1-2013:p0259:b005:l013","ordinal":96732,"en":"Its mouth gaped like a ravenous maw."},{"id":"semetey-1-2013:p0259:b005:l014","ordinal":96733,"en":"White foam mixed with blood"},{"id":"semetey-1-2013:p0259:b005:l015","ordinal":96734,"en":"Spattered its breast."},{"id":"semetey-1-2013:p0259:b005:l016","ordinal":96735,"en":"It rattled its bit,"},{"id":"semetey-1-2013:p0259:b005:l017","ordinal":96736,"en":"And its tail like strands of silk"},{"id":"semetey-1-2013:p0259:b005:l018","ordinal":96737,"en":"Lashed between its hind legs."},{"id":"semetey-1-2013:p0259:b005:l019","ordinal":96738,"en":"Taytoru was coming,"},{"id":"semetey-1-2013:p0259:b005:l020","ordinal":96739,"en":"Racing a bird in flight."},{"id":"semetey-1-2013:p0259:b005:l021","ordinal":96740,"en":"The white reins with knotted loops"},{"id":"semetey-1-2013:p0259:b005:l022","ordinal":96741,"en":"Were gripped tight in both hands."},{"id":"semetey-1-2013:p0259:b005:l023","ordinal":96742,"en":"Torment no one should endure—"},{"id":"semetey-1-2013:p0259:b005:l024","ordinal":96743,"en":"My valiant sister Kanykei"},{"id":"semetey-1-2013:p0259:b005:l025","ordinal":96744,"en":"Was coming through it all."},{"id":"semetey-1-2013:p0259:b005:l026","ordinal":96745,"en":"At the racer Taytoru,"},{"id":"semetey-1-2013:p0259:b005:l027","ordinal":96746,"en":"My wretched, leopard-like sister,"},{"id":"semetey-1-2013:p0259:b005:l028","ordinal":96747,"en":"With blank charges,"},{"id":"semetey-1-2013:p0259:b005:l029","ordinal":96748,"en":"Kept making booming blows,"},{"id":"semetey-1-2013:p0259:b005:l030","ordinal":96749,"en":"Firing as she came."},{"id":"semetey-1-2013:p0259:b005:l031","ordinal":96750,"en":"My dear elder sister Kanykei—"},{"id":"semetey-1-2013:p0259:b005:l032","ordinal":96751,"en":"Cursed be her widowhood!"},{"id":"semetey-1-2013:p0259:b005:l033","ordinal":96752,"en":"From her dear, quail-like eyes"},{"id":"semetey-1-2013:p0259:b005:l034","ordinal":96753,"en":"Tears fell in separate streams."},{"id":"semetey-1-2013:p0259:b005:l035","ordinal":96754,"en":"From her dear eyes like currants,"},{"id":"semetey-1-2013:p0259:b005:l036","ordinal":96755,"en":"From my fierce, dear sister,"},{"id":"semetey-1-2013:p0259:b005:l037","ordinal":96756,"en":"Tears streamed a whip's length."},{"id":"semetey-1-2013:p0259:b005:l038","ordinal":96757,"en":"Many cares overflowed her breast;"},{"id":"semetey-1-2013:p0259:b005:l039","ordinal":96758,"en":"Her tears streamed a thousand ways."},{"id":"semetey-1-2013:p0260:b003:l001","ordinal":96759,"en":"My dear, poor sister's"},{"id":"semetey-1-2013:p0260:b003:l002","ordinal":96760,"en":"Bloody face was torn,"},{"id":"semetey-1-2013:p0260:b003:l003","ordinal":96761,"en":"Her black hair spread loose,"},{"id":"semetey-1-2013:p0260:b003:l004","ordinal":96762,"en":"Her widowhood plain to see,"},{"id":"semetey-1-2013:p0260:b003:l005","ordinal":96763,"en":"A great black covering upon her head."},{"id":"semetey-1-2013:p0260:b003:l006","ordinal":96764,"en":"Her Akborchuk paced along;"},{"id":"semetey-1-2013:p0260:b003:l007","ordinal":96765,"en":"Bloody tears, mingled with blood,"},{"id":"semetey-1-2013:p0260:b003:l008","ordinal":96766,"en":"From Akborchuk's mane"},{"id":"semetey-1-2013:p0260:b003:l009","ordinal":96767,"en":"Streamed a whip's length down."},{"id":"semetey-1-2013:p0260:b003:l010","ordinal":96768,"en":"Manas, whose spirit was noble,"}]
