[{"id":"manas-2010:p1214:b001:l041","ordinal":52737,"en":"Kartküröng, the accomplished courser,"},{"id":"manas-2010:p1214:b001:l042","ordinal":52738,"en":"No beast can match his walk,"},{"id":"manas-2010:p1215:b001:l001","ordinal":52739,"en":"Kartküröng, swifter than other beasts,"},{"id":"manas-2010:p1215:b001:l002","ordinal":52740,"en":"If he meets a determined enemy,"},{"id":"manas-2010:p1215:b001:l003","ordinal":52741,"en":"Will not tire his rider by pulling at the lead."},{"id":"manas-2010:p1215:b001:l004","ordinal":52742,"en":"Unless God truly strikes him,"},{"id":"manas-2010:p1215:b001:l005","ordinal":52743,"en":"He will not surrender his rider to the foe."},{"id":"manas-2010:p1215:b001:l006","ordinal":52744,"en":"He will not turn back to graze on fescue."},{"id":"manas-2010:p1215:b001:l007","ordinal":52745,"en":"Like a person who has marked the way,"},{"id":"manas-2010:p1215:b001:l008","ordinal":52746,"en":"He never strays from a road seen once."},{"id":"manas-2010:p1215:b001:l009","ordinal":52747,"en":"The leading rope tied with a rounded knot,"},{"id":"manas-2010:p1215:b001:l010","ordinal":52748,"en":"Wrapping it closely about the neck,"},{"id":"manas-2010:p1215:b001:l011","ordinal":52749,"en":"The worthy blue-maned Almambet,"},{"id":"manas-2010:p1215:b001:l012","ordinal":52750,"en":"Tying it loosely about his neck,"},{"id":"manas-2010:p1215:b001:l013","ordinal":52751,"en":"Entrusted it to Kartküröng:"},{"id":"manas-2010:p1215:b001:l014","ordinal":52752,"en":"“A teaching to be spoken of,” he said,"},{"id":"manas-2010:p1215:b001:l015","ordinal":52753,"en":"“A living creature, though a beast,"},{"id":"manas-2010:p1215:b001:l016","ordinal":52754,"en":"From magnanimous Manas's presence,"},{"id":"manas-2010:p1215:b001:l017","ordinal":52755,"en":"The wings we brought,” he said."},{"id":"manas-2010:p1215:b001:l018","ordinal":52756,"en":"“The side paths on either flank,"},{"id":"manas-2010:p1215:b001:l019","ordinal":52757,"en":"Leave the branching roads,” he said."},{"id":"manas-2010:p1215:b001:l020","ordinal":52758,"en":"“Without turning elsewhere,"},{"id":"manas-2010:p1215:b001:l021","ordinal":52759,"en":"My beloved Kartküröng,"},{"id":"manas-2010:p1215:b001:l022","ordinal":52760,"en":"Lead us toward the Muslims,” he said."},{"id":"manas-2010:p1215:b001:l023","ordinal":52761,"en":"Grasping the bit-ring and turning him,"},{"id":"manas-2010:p1215:b001:l024","ordinal":52762,"en":"Kartküröng, whom the sultan had given,"},{"id":"manas-2010:p1215:b001:l025","ordinal":52763,"en":"He released him there,"},{"id":"manas-2010:p1215:b001:l026","ordinal":52764,"en":"Sending him toward the horses."},{"id":"manas-2010:p1215:b001:l027","ordinal":52765,"en":"Golden forelock, tasseled sash,"},{"id":"manas-2010:p1215:b001:l028","ordinal":52766,"en":"Azizkan's only son,"},{"id":"manas-2010:p1215:b001:l029","ordinal":52767,"en":"Ulakkhan's Syrgak,"},{"id":"manas-2010:p1215:b001:l030","ordinal":52768,"en":"When they came to such a place,"},{"id":"manas-2010:p1215:b001:l031","ordinal":52769,"en":"Plane trees sheltering their nest,"},{"id":"manas-2010:p1215:b001:l032","ordinal":52770,"en":"They dashed toward the hills."},{"id":"manas-2010:p1215:b001:l033","ordinal":52771,"en":"Of the mass of horses on the hills,"},{"id":"manas-2010:p1215:b001:l034","ordinal":52772,"en":"Your champions came out behind."},{"id":"manas-2010:p1215:b001:l035","ordinal":52773,"en":"Firing once with the gun,"},{"id":"manas-2010:p1215:b001:l036","ordinal":52774,"en":"Firing three times in succession,"},{"id":"manas-2010:p1215:b001:l037","ordinal":52775,"en":"Pounding the drum,"},{"id":"manas-2010:p1215:b001:l038","ordinal":52776,"en":"Beating the great war drum,"},{"id":"manas-2010:p1215:b001:l039","ordinal":52777,"en":"Almambet and Syrgak together"},{"id":"manas-2010:p1215:b001:l040","ordinal":52778,"en":"Raided the horses, shouting."},{"id":"manas-2010:p1215:b001:l041","ordinal":52779,"en":"The countless horses thundered;"},{"id":"manas-2010:p1215:b001:l042","ordinal":52780,"en":"The place of the raid grew misty with dust,"},{"id":"manas-2010:p1216:b001:l001","ordinal":52781,"en":"The horses breaking from the middle,"},{"id":"manas-2010:p1216:b001:l002","ordinal":52782,"en":"Nobly born Almambet"},{"id":"manas-2010:p1216:b001:l003","ordinal":52783,"en":"Drove onward, cutting in upon them."},{"id":"manas-2010:p1216:b001:l004","ordinal":52784,"en":"The horses breaking to the side,"},{"id":"manas-2010:p1216:b001:l005","ordinal":52785,"en":"The boundless warrior Syrgak,"},{"id":"manas-2010:p1216:b001:l006","ordinal":52786,"en":"Not sending a single one back,"},{"id":"manas-2010:p1216:b001:l007","ordinal":52787,"en":"Drove onward with the rest."},{"id":"manas-2010:p1216:b001:l008","ordinal":52788,"en":"Multitudes upon multitudes of horses,"},{"id":"manas-2010:p1216:b001:l009","ordinal":52789,"en":"The earth splitting, they neighed."},{"id":"manas-2010:p1216:b001:l010","ordinal":52790,"en":"The fat mares would not move,"},{"id":"manas-2010:p1216:b001:l011","ordinal":52791,"en":"Leaning toward their own ground."},{"id":"manas-2010:p1216:b001:l012","ordinal":52792,"en":"One could not tell whether they were black"},{"id":"manas-2010:p1216:b001:l013","ordinal":52793,"en":"Or whether they were bay."},{"id":"manas-2010:p1216:b001:l014","ordinal":52794,"en":"The many horses they had raided"},{"id":"manas-2010:p1216:b001:l015","ordinal":52795,"en":"Were wrapped in pitch-black dust."},{"id":"manas-2010:p1216:b001:l016","ordinal":52796,"en":"Zhangybay riding a chestnut stallion"},{"id":"manas-2010:p1216:b001:l017","ordinal":52797,"en":"Was skilled among spearmen."},{"id":"manas-2010:p1216:b001:l018","ordinal":52798,"en":"Familiar since childhood,"},{"id":"manas-2010:p1216:b001:l019","ordinal":52799,"en":"With Almambet from long ago,"},{"id":"manas-2010:p1216:b001:l020","ordinal":52800,"en":"He was a capable man who knew him."},{"id":"manas-2010:p1216:b001:l021","ordinal":52801,"en":"“Against the fugitive I knew,"},{"id":"manas-2010:p1216:b001:l022","ordinal":52802,"en":"I shall turn and wage battle,” he said."},{"id":"manas-2010:p1216:b001:l023","ordinal":52803,"en":"“Parted from the countless horses,"},{"id":"manas-2010:p1216:b001:l024","ordinal":52804,"en":"How can I remain alive?” he said."},{"id":"manas-2010:p1216:b001:l025","ordinal":52805,"en":"“If my death has come, let me die."},{"id":"manas-2010:p1216:b001:l026","ordinal":52806,"en":"If my strength suffices, the horses,"},{"id":"manas-2010:p1216:b001:l027","ordinal":52807,"en":"Let me raid them back."},{"id":"manas-2010:p1216:b001:l028","ordinal":52808,"en":"At the very least, half of them,"},{"id":"manas-2010:p1216:b001:l029","ordinal":52809,"en":"Let me split them off with a thunder.”"},{"id":"manas-2010:p1216:b001:l030","ordinal":52810,"en":"Thinking this, Zhangybay"},{"id":"manas-2010:p1216:b001:l031","ordinal":52811,"en":"Cried “Go!” behind them, making ready."},{"id":"manas-2010:p1216:b001:l032","ordinal":52812,"en":"The herdsmen behind him,"},{"id":"manas-2010:p1216:b001:l033","ordinal":52813,"en":"All of them forty men,"},{"id":"manas-2010:p1216:b001:l034","ordinal":52814,"en":"At your Alma who raided the horses,"},{"id":"manas-2010:p1216:b001:l035","ordinal":52815,"en":"Shot arrows like rain,"},{"id":"manas-2010:p1216:b001:l036","ordinal":52816,"en":"Fired bullets like hail."},{"id":"manas-2010:p1216:b001:l037","ordinal":52817,"en":"They came up in a crowd,"},{"id":"manas-2010:p1216:b001:l038","ordinal":52818,"en":"Forty-one men galloping."},{"id":"manas-2010:p1216:b001:l039","ordinal":52819,"en":"Zhangybay, chief herdsman,"},{"id":"manas-2010:p1216:b001:l040","ordinal":52820,"en":"Spurred on the right and left,"},{"id":"manas-2010:p1216:b001:l041","ordinal":52821,"en":"Whipped on the right and left."},{"id":"manas-2010:p1216:b001:l042","ordinal":52822,"en":"The lacquered spear in his hand,"},{"id":"manas-2010:p1217:b001:l001","ordinal":52823,"en":"Bent and quivered,"},{"id":"manas-2010:p1217:b001:l002","ordinal":52824,"en":"Without sparing his fleeting life,"},{"id":"manas-2010:p1217:b001:l003","ordinal":52825,"en":"Heading straight for Almambet,"},{"id":"manas-2010:p1217:b001:l004","ordinal":52826,"en":"Zhanybay launched his charge,"},{"id":"manas-2010:p1217:b001:l005","ordinal":52827,"en":"Never thinking he might die."},{"id":"manas-2010:p1217:b001:l006","ordinal":52828,"en":"Golden forelock, tasseled belt—"},{"id":"manas-2010:p1217:b001:l007","ordinal":52829,"en":"Azizkhan's Almambet"},{"id":"manas-2010:p1217:b001:l008","ordinal":52830,"en":"Wheeled his mount and sped,"},{"id":"manas-2010:p1217:b001:l009","ordinal":52831,"en":"Paying no heed to the horses,"},{"id":"manas-2010:p1217:b001:l010","ordinal":52832,"en":"Leaving them behind at once."},{"id":"manas-2010:p1217:b001:l011","ordinal":52833,"en":"Light touched his moonlike face;"},{"id":"manas-2010:p1217:b001:l012","ordinal":52834,"en":"Azizkhan's Almambet"},{"id":"manas-2010:p1217:b001:l013","ordinal":52835,"en":"At the Chinese coming from behind"},{"id":"manas-2010:p1217:b001:l014","ordinal":52836,"en":"Charged with a shout and struck."},{"id":"manas-2010:p1217:b001:l015","ordinal":52837,"en":"Sweeping this way and that,"},{"id":"manas-2010:p1217:b001:l016","ordinal":52838,"en":"He passed straight through their midst."},{"id":"manas-2010:p1217:b001:l017","ordinal":52839,"en":"The Chinese he came upon—"},{"id":"manas-2010:p1217:b001:l018","ordinal":52840,"en":"Almambet, that consummate champion—"},{"id":"manas-2010:p1217:b001:l019","ordinal":52841,"en":"Off the chestnut stallion"},{"id":"manas-2010:p1217:b001:l020","ordinal":52842,"en":"He knocked him down as he passed."},{"id":"manas-2010:p1217:b001:l021","ordinal":52843,"en":"Meanwhile the forty horse-herders,"},{"id":"manas-2010:p1217:b001:l022","ordinal":52844,"en":"Before they could set him upright on his horse"},{"id":"manas-2010:p1217:b001:l023","ordinal":52845,"en":"And take him back into their company,"},{"id":"manas-2010:p1217:b001:l024","ordinal":52846,"en":"Syrgak, son of Ulak Khan,"},{"id":"manas-2010:p1217:b001:l025","ordinal":52847,"en":"At the sight of such an enemy,"},{"id":"manas-2010:p1217:b001:l026","ordinal":52848,"en":"That champion who never stopped,"},{"id":"manas-2010:p1217:b001:l027","ordinal":52849,"en":"Arrived as swiftly as the wind;"},{"id":"manas-2010:p1217:b001:l028","ordinal":52850,"en":"Across Zhanybay's neck"},{"id":"manas-2010:p1217:b001:l029","ordinal":52851,"en":"He slashed as he passed."},{"id":"manas-2010:p1217:b001:l030","ordinal":52852,"en":"Almambet and Syrgak joined together,"},{"id":"manas-2010:p1217:b001:l031","ordinal":52853,"en":"Licking their lips like lions;"},{"id":"manas-2010:p1217:b001:l032","ordinal":52854,"en":"The horse-herders whose doom had come,"},{"id":"manas-2010:p1217:b001:l033","ordinal":52855,"en":"Forty men, all of them able,"},{"id":"manas-2010:p1217:b001:l034","ordinal":52856,"en":"They slaughtered every one."},{"id":"manas-2010:p1217:b001:l035","ordinal":52857,"en":"Karagul, mounted on his bay stallion,"},{"id":"manas-2010:p1217:b001:l036","ordinal":52858,"en":"Cried “Go!” and dust rose as he rode."},{"id":"manas-2010:p1217:b001:l037","ordinal":52859,"en":"Karagul upon its back"},{"id":"manas-2010:p1217:b001:l038","ordinal":52860,"en":"Was beside himself with fury:"},{"id":"manas-2010:p1217:b001:l039","ordinal":52861,"en":"“Both these Buruts together"},{"id":"manas-2010:p1217:b001:l040","ordinal":52862,"en":"I shall pierce with a single thrust."},{"id":"manas-2010:p1217:b001:l041","ordinal":52863,"en":"Having let forty-one men be killed,"},{"id":"manas-2010:p1217:b001:l042","ordinal":52864,"en":"How can I leave alive?"},{"id":"manas-2010:p1218:b001:l001","ordinal":52865,"en":"I shall kill these two"},{"id":"manas-2010:p1218:b001:l002","ordinal":52866,"en":"And drive my horses away!”"},{"id":"manas-2010:p1218:b001:l003","ordinal":52867,"en":"To Kamyshtuu's plain"},{"id":"manas-2010:p1218:b001:l004","ordinal":52868,"en":"Karagul came alone."},{"id":"manas-2010:p1218:b001:l005","ordinal":52869,"en":"Almambet was ahead of the horses,"},{"id":"manas-2010:p1218:b001:l006","ordinal":52870,"en":"Resolute Syrgak behind them."},{"id":"manas-2010:p1218:b001:l007","ordinal":52871,"en":"Ready with his battle-axe,"},{"id":"manas-2010:p1218:b001:l008","ordinal":52872,"en":"His sword strapped tightly on,"},{"id":"manas-2010:p1218:b001:l009","ordinal":52873,"en":"Raging and blustering,"},{"id":"manas-2010:p1218:b001:l010","ordinal":52874,"en":"Not sparing his own life,"},{"id":"manas-2010:p1218:b001:l011","ordinal":52875,"en":"He came looming toward Syrgak."},{"id":"manas-2010:p1218:b001:l012","ordinal":52876,"en":"Light for a horse, fit for a yearling,"},{"id":"manas-2010:p1218:b001:l013","ordinal":52877,"en":"Hero Syrgak, that fierce-maned leopard,"},{"id":"manas-2010:p1218:b001:l014","ordinal":52878,"en":"From the ridge where the reeds ended,"},{"id":"manas-2010:p1218:b001:l015","ordinal":52879,"en":"With a Kalmak like Karagul"},{"id":"manas-2010:p1218:b001:l016","ordinal":52880,"en":"Hero Syrgak came face to face,"},{"id":"manas-2010:p1218:b001:l017","ordinal":52881,"en":"At the long projecting spur."},{"id":"manas-2010:p1218:b001:l018","ordinal":52882,"en":"When he saw hero Syrgak,"},{"id":"manas-2010:p1218:b001:l019","ordinal":52883,"en":"Unable to withstand his fury,"},{"id":"manas-2010:p1218:b001:l020","ordinal":52884,"en":"Unable to turn his bay stallion's head,"},{"id":"manas-2010:p1218:b001:l021","ordinal":52885,"en":"The Kalmak could not stand still;"},{"id":"manas-2010:p1218:b001:l022","ordinal":52886,"en":"Turning, he darted aside;"},{"id":"manas-2010:p1218:b001:l023","ordinal":52887,"en":"The Kalmak swerved to flee."},{"id":"manas-2010:p1218:b001:l024","ordinal":52888,"en":"Before an eye could blink,"},{"id":"manas-2010:p1218:b001:l025","ordinal":52889,"en":"Fierce-maned Syrgak reached him:"},{"id":"manas-2010:p1218:b001:l026","ordinal":52890,"en":"“The Kalmak's saddle-pommel,” he said,"},{"id":"manas-2010:p1218:b001:l027","ordinal":52891,"en":"“Right at the heart's very tip!”"},{"id":"manas-2010:p1218:b001:l028","ordinal":52892,"en":"He swung his lance around;"},{"id":"manas-2010:p1218:b001:l029","ordinal":52893,"en":"On reaching him, your champion"},{"id":"manas-2010:p1218:b001:l030","ordinal":52894,"en":"Began to strike and thrust."},{"id":"manas-2010:p1218:b001:l031","ordinal":52895,"en":"Kökchebich beneath him"},{"id":"manas-2010:p1218:b001:l032","ordinal":52896,"en":"Lowered his head to the earth;"},{"id":"manas-2010:p1218:b001:l033","ordinal":52897,"en":"Plowing the ground with his muzzle,"},{"id":"manas-2010:p1218:b001:l034","ordinal":52898,"en":"He opened his mouth like a ravening maw,"},{"id":"manas-2010:p1218:b001:l035","ordinal":52899,"en":"Scattering foam from his mouth."},{"id":"manas-2010:p1218:b001:l036","ordinal":52900,"en":"Kökchebich bolted onward;"},{"id":"manas-2010:p1218:b001:l037","ordinal":52901,"en":"The Kalmak was left behind."},{"id":"manas-2010:p1218:b001:l038","ordinal":52902,"en":"Karagul the Kalmak prepared himself,"},{"id":"manas-2010:p1218:b001:l039","ordinal":52903,"en":"Thinking how to escape death,"},{"id":"manas-2010:p1218:b001:l040","ordinal":52904,"en":"And kept a cunning trick in reserve."},{"id":"manas-2010:p1218:b001:l041","ordinal":52905,"en":"The forelock on his crown"},{"id":"manas-2010:p1218:b001:l042","ordinal":52906,"en":"Had he not knotted and braided?"},{"id":"manas-2010:p1219:b001:l001","ordinal":52907,"en":"He had studied with Almambet,"},{"id":"manas-2010:p1219:b001:l002","ordinal":52908,"en":"And become skilled in sorcery;"},{"id":"manas-2010:p1219:b001:l003","ordinal":52909,"en":"Had they not come up together?"},{"id":"manas-2010:p1219:b001:l004","ordinal":52910,"en":"He had seen many enemies before;"},{"id":"manas-2010:p1219:b001:l005","ordinal":52911,"en":"Was he not a seasoned Kalmak?"},{"id":"manas-2010:p1219:b001:l006","ordinal":52912,"en":"At that moment Karagul's"},{"id":"manas-2010:p1219:b001:l007","ordinal":52913,"en":"Horse swerved and stopped;"},{"id":"manas-2010:p1219:b001:l008","ordinal":52914,"en":"Into It-Kechpes's Kara-Suu"},{"id":"manas-2010:p1219:b001:l009","ordinal":52915,"en":"He swam with a dog-paddle stroke and vanished."},{"id":"manas-2010:p1219:b001:l010","ordinal":52916,"en":"After Karagul had fled,"},{"id":"manas-2010:p1219:b001:l011","ordinal":52917,"en":"Once the two heroes had attained"},{"id":"manas-2010:p1219:b001:l012","ordinal":52918,"en":"The goal on which they set their hearts,"},{"id":"manas-2010:p1219:b001:l013","ordinal":52919,"en":"They drove the horses by day;"},{"id":"manas-2010:p1219:b001:l014","ordinal":52920,"en":"Not by day alone,"},{"id":"manas-2010:p1219:b001:l015","ordinal":52921,"en":"Not lying down anywhere to spend the night,"},{"id":"manas-2010:p1219:b001:l016","ordinal":52922,"en":"They drove the horses at night as well."},{"id":"manas-2010:p1219:b001:l017","ordinal":52923,"en":"Not letting their steeds catch a breath,"},{"id":"manas-2010:p1219:b001:l018","ordinal":52924,"en":"Not lying down for a full sleep,"},{"id":"manas-2010:p1219:b001:l019","ordinal":52925,"en":"Not taking even a short nap,"},{"id":"manas-2010:p1219:b001:l020","ordinal":52926,"en":"Eating their food on horseback,"},{"id":"manas-2010:p1219:b001:l021","ordinal":52927,"en":"Dozing a little, then waking,"},{"id":"manas-2010:p1219:b001:l022","ordinal":52928,"en":"That the Chinese would pursue them—"},{"id":"manas-2010:p1219:b001:l023","ordinal":52929,"en":"They knew this as they came."},{"id":"manas-2010:p1219:b001:l024","ordinal":52930,"en":"With the horses driven before them,"},{"id":"manas-2010:p1219:b001:l025","ordinal":52931,"en":"Almost making them touch the sky,"},{"id":"manas-2010:p1219:b001:l026","ordinal":52932,"en":"They pressed and drove them on."},{"id":"manas-2010:p1219:b001:l027","ordinal":52933,"en":"The horses that had grown fat"},{"id":"manas-2010:p1219:b001:l028","ordinal":52934,"en":"They struck with their lances,"},{"id":"manas-2010:p1219:b001:l029","ordinal":52935,"en":"Driving and chasing them onward."},{"id":"manas-2010:p1219:b001:l030","ordinal":52936,"en":"Foals and yearlings could not keep up,"},{"id":"manas-2010:p1219:b001:l031","ordinal":52937,"en":"And were left along the road."},{"id":"manas-2010:p1219:b001:l032","ordinal":52938,"en":"Many dying, some still alive,"},{"id":"manas-2010:p1219:b001:l033","ordinal":52939,"en":"Were left along the road."},{"id":"manas-2010:p1219:b001:l034","ordinal":52940,"en":"Each swift horse separately"},{"id":"manas-2010:p1219:b001:l035","ordinal":52941,"en":"They drove on without a pause."},{"id":"manas-2010:p1219:b001:l036","ordinal":52942,"en":"Slanting felt hat, sparrowhawk eyes—"},{"id":"manas-2010:p1219:b001:l037","ordinal":52943,"en":"Champion Syrgak, the fierce-maned hero,"},{"id":"manas-2010:p1219:b001:l038","ordinal":52944,"en":"Made the horses neigh;"},{"id":"manas-2010:p1219:b001:l039","ordinal":52945,"en":"Riding out to that end,"},{"id":"manas-2010:p1219:b001:l040","ordinal":52946,"en":"Riding out to this end,"},{"id":"manas-2010:p1219:b001:l041","ordinal":52947,"en":"Striking them again and again,"},{"id":"manas-2010:p1219:b001:l042","ordinal":52948,"en":"He came on, thrusting and driving."},{"id":"manas-2010:p1220:b001:l001","ordinal":52949,"en":"Driving the horses in a frenzy,"},{"id":"manas-2010:p1220:b001:l002","ordinal":52950,"en":"Traveling such a distance in between,"},{"id":"manas-2010:p1220:b001:l003","ordinal":52951,"en":"To Kürpüldök's Sary-Suu"},{"id":"manas-2010:p1220:b001:l004","ordinal":52952,"en":"They came at last."},{"id":"manas-2010:p1220:b001:l005","ordinal":52953,"en":"At that moment Kartküröng"},{"id":"manas-2010:p1220:b001:l006","ordinal":52954,"en":"Lowered his head to the ground."},{"id":"manas-2010:p1220:b001:l007","ordinal":52955,"en":"Over rough, knotted stretches of road,"},{"id":"manas-2010:p1220:b001:l008","ordinal":52956,"en":"Küröng missed none of its turns;"},{"id":"manas-2010:p1220:b001:l009","ordinal":52957,"en":"Over hilly, branching roads,"},{"id":"manas-2010:p1220:b001:l010","ordinal":52958,"en":"He lost his way on none of those."},{"id":"manas-2010:p1220:b001:l011","ordinal":52959,"en":"Along the route they had passed before,"},{"id":"manas-2010:p1220:b001:l012","ordinal":52960,"en":"Kartküröng, wisest among beasts,"},{"id":"manas-2010:p1220:b001:l013","ordinal":52961,"en":"Came without turning aside."},{"id":"manas-2010:p1220:b001:l014","ordinal":52962,"en":"The narrow path Almambet had cut—"},{"id":"manas-2010:p1220:b001:l015","ordinal":52963,"en":"Küröng saw it;"},{"id":"manas-2010:p1220:b001:l016","ordinal":52964,"en":"Not straying a step from the road,"},{"id":"manas-2010:p1220:b001:l017","ordinal":52965,"en":"He came straight to the ford."},{"id":"manas-2010:p1220:b001:l018","ordinal":52966,"en":"When Küröng reached the ford,"},{"id":"manas-2010:p1220:b001:l019","ordinal":52967,"en":"Raising his head like a deer,"},{"id":"manas-2010:p1220:b001:l020","ordinal":52968,"en":"Turning to look at the herd,"},{"id":"manas-2010:p1220:b001:l021","ordinal":52969,"en":"He neighed once."},{"id":"manas-2010:p1220:b001:l022","ordinal":52970,"en":"Without turning aside, he halted,"},{"id":"manas-2010:p1220:b001:l023","ordinal":52971,"en":"Then rushed into the water."},{"id":"manas-2010:p1220:b001:l024","ordinal":52972,"en":"Kambar Ata's black stallion,"},{"id":"manas-2010:p1220:b001:l025","ordinal":52973,"en":"Without turning back or stopping,"},{"id":"manas-2010:p1220:b001:l026","ordinal":52974,"en":"Behind Kartküröng"},{"id":"manas-2010:p1220:b001:l027","ordinal":52975,"en":"Entered the water in turn."},{"id":"manas-2010:p1220:b001:l028","ordinal":52976,"en":"Behind that one,"},{"id":"manas-2010:p1220:b001:l029","ordinal":52977,"en":"The yellow stallion with bracelet markings"},{"id":"manas-2010:p1220:b001:l030","ordinal":52978,"en":"Entered the river without turning."},{"id":"manas-2010:p1220:b001:l031","ordinal":52979,"en":"The young, scrambling foals"},{"id":"manas-2010:p1220:b001:l032","ordinal":52980,"en":"Went into the water, neighing."},{"id":"manas-2010:p1220:b001:l033","ordinal":52981,"en":"Making the mares cry out,"},{"id":"manas-2010:p1220:b001:l034","ordinal":52982,"en":"They drove them away without their foals."},{"id":"manas-2010:p1220:b001:l035","ordinal":52983,"en":"All the weak ones"},{"id":"manas-2010:p1220:b001:l036","ordinal":52984,"en":"Were swept down the river;"},{"id":"manas-2010:p1220:b001:l037","ordinal":52985,"en":"All the outstanding ones"},{"id":"manas-2010:p1220:b001:l038","ordinal":52986,"en":"Crossed and emerged from the river."},{"id":"manas-2010:p1220:b001:l039","ordinal":52987,"en":"They began to drive them again;"},{"id":"manas-2010:p1220:b001:l040","ordinal":52988,"en":"All the choicest swift horses,"},{"id":"manas-2010:p1220:b001:l041","ordinal":52989,"en":"The two heroes, Almambet and Syrgak,"},{"id":"manas-2010:p1220:b001:l042","ordinal":52990,"en":"Drove along before them."},{"id":"manas-2010:p1221:b001:l001","ordinal":52991,"en":"When they emerged from the water,"},{"id":"manas-2010:p1221:b001:l002","ordinal":52992,"en":"The multitude of horses tore up the ground,"}]
