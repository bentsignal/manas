[{"id":"semetey-1-2013:p0530:b003:l036","ordinal":117249,"en":"Had looked out twice from there."},{"id":"semetey-1-2013:p0530:b003:l037","ordinal":117250,"en":"Ach-Maral, covered in white wormwood—"},{"id":"semetey-1-2013:p0530:b003:l038","ordinal":117251,"en":"It had looked out six times from there."},{"id":"semetey-1-2013:p0530:b003:l039","ordinal":117252,"en":"It had crossed Zhorgo Pass,"},{"id":"semetey-1-2013:p0530:b004:l001","ordinal":117253,"en":"Traversed the ridge of Kuiuk,"},{"id":"semetey-1-2013:p0530:b004:l002","ordinal":117254,"en":"Climbed up to Kum-Bulak."},{"id":"semetey-1-2013:p0530:b004:l003","ordinal":117255,"en":"Khan Manas's Kumaik"},{"id":"semetey-1-2013:p0530:b004:l004","ordinal":117256,"en":"Had watched from there for four days."},{"id":"semetey-1-2013:p0530:b004:l005","ordinal":117257,"en":"Today Kumaik"},{"id":"semetey-1-2013:p0530:b004:l006","ordinal":117258,"en":"Had seen him from Uch-Koshoi."},{"id":"semetey-1-2013:p0530:b004:l007","ordinal":117259,"en":"From the three terraces of Tash-Moinok,"},{"id":"semetey-1-2013:p0530:b004:l008","ordinal":117260,"en":"Semetey had traveled in anguish."},{"id":"semetey-1-2013:p0530:b004:l009","ordinal":117261,"en":"It wore a golden collar on its neck."},{"id":"semetey-1-2013:p0530:b004:l010","ordinal":117262,"en":"It had known he would come this year."},{"id":"semetey-1-2013:p0530:b004:l011","ordinal":117263,"en":"For the orphan left by Manas,"},{"id":"semetey-1-2013:p0530:b004:l012","ordinal":117264,"en":"It had grieved for twelve years."},{"id":"semetey-1-2013:p0530:b004:l013","ordinal":117265,"en":"From the villains Abyke and Kobosh"},{"id":"semetey-1-2013:p0530:b004:l014","ordinal":117266,"en":"It had suffered great humiliation."},{"id":"semetey-1-2013:p0530:b004:l015","ordinal":117267,"en":"When it saw Semetey,"},{"id":"semetey-1-2013:p0530:b004:l016","ordinal":117268,"en":"When Kumaik came near,"},{"id":"semetey-1-2013:p0530:b004:l017","ordinal":117269,"en":"To that only son Almighty Allah"},{"id":"semetey-1-2013:p0530:b004:l018","ordinal":117270,"en":"Had openly granted His favor."},{"id":"semetey-1-2013:p0530:b004:l019","ordinal":117271,"en":"When he looked at Kumaik,"},{"id":"semetey-1-2013:p0530:b004:l020","ordinal":117272,"en":"There was a golden collar on its neck."},{"id":"semetey-1-2013:p0530:b004:l021","ordinal":117273,"en":"“My mother Kanykei told me:"},{"id":"semetey-1-2013:p0530:b004:l022","ordinal":117274,"en":"If Kumaik comes,"},{"id":"semetey-1-2013:p0530:b004:l023","ordinal":117275,"en":"Around its neck it will wear"},{"id":"semetey-1-2013:p0530:b004:l024","ordinal":117276,"en":"A collar made of gold, she said."},{"id":"semetey-1-2013:p0530:b004:l025","ordinal":117277,"en":"My khan father's Kumaik—"},{"id":"semetey-1-2013:p0530:b004:l026","ordinal":117278,"en":"It is Kumaik itself!"},{"id":"semetey-1-2013:p0530:b004:l027","ordinal":117279,"en":"To me, born an only child,"},{"id":"semetey-1-2013:p0530:b004:l028","ordinal":117280,"en":"My inheritance from my father"},{"id":"semetey-1-2013:p0530:b004:l029","ordinal":117281,"en":"Has come to meet me."},{"id":"semetey-1-2013:p0530:b004:l030","ordinal":117282,"en":"It has appeared from the unseen world."},{"id":"semetey-1-2013:p0530:b004:l031","ordinal":117283,"en":"May I be sacrificed for you, Kumaik,"},{"id":"semetey-1-2013:p0530:b004:l032","ordinal":117284,"en":"Who was granted to my khan father, Manas the Lion!"},{"id":"semetey-1-2013:p0530:b004:l033","ordinal":117285,"en":"You never drew back from a bear,"},{"id":"semetey-1-2013:p0530:b004:l034","ordinal":117286,"en":"Never retreated from a tiger."},{"id":"semetey-1-2013:p0530:b004:l035","ordinal":117287,"en":"You destroyed whatever you bit,"},{"id":"semetey-1-2013:p0530:b004:l036","ordinal":117288,"en":"Brought joy to the master who loosed you."},{"id":"semetey-1-2013:p0530:b004:l037","ordinal":117289,"en":"Mighty one, renowned among the people,"},{"id":"semetey-1-2013:p0530:b004:l038","ordinal":117290,"en":"My precious inheritance left by my father!”"},{"id":"semetey-1-2013:p0531:b003:l001","ordinal":117291,"en":"Putting the gray pouch-belt about his neck,"},{"id":"semetey-1-2013:p0531:b003:l002","ordinal":117292,"en":"He pressed Kumaik's head to his breast."},{"id":"semetey-1-2013:p0531:b003:l004","ordinal":117293,"en":"“My mother told me:"},{"id":"semetey-1-2013:p0531:b003:l006","ordinal":117294,"en":"Kumaik will bear resentment, she said.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0531:b003:l007","ordinal":117295,"en":"My precious one left by my father Manas,"},{"id":"semetey-1-2013:p0531:b003:l008","ordinal":117296,"en":"Kumaik, who stands as a father to me,"},{"id":"semetey-1-2013:p0531:b003:l009","ordinal":117297,"en":"My mirror who has come to meet me!"},{"id":"semetey-1-2013:p0531:b003:l010","ordinal":117298,"en":"My ocean-like father, if only you had not died,"},{"id":"semetey-1-2013:p0531:b003:l011","ordinal":117299,"en":"If only this poor life had not known wandering!"},{"id":"semetey-1-2013:p0531:b003:l012","ordinal":117300,"en":"My leopard father, if only you had not died,"},{"id":"semetey-1-2013:p0531:b003:l013","ordinal":117301,"en":"If only this poor life had not known flight!"},{"id":"semetey-1-2013:p0531:b003:l014","ordinal":117302,"en":"May I be sacrificed for you, Kumaik!"},{"id":"semetey-1-2013:p0531:b003:l015","ordinal":117303,"en":"To Temir Khan's city"},{"id":"semetey-1-2013:p0531:b003:l016","ordinal":117304,"en":"I, poor creature, wandered away."},{"id":"semetey-1-2013:p0531:b003:l017","ordinal":117305,"en":"Bereft of your companion, Manas the Lion,"},{"id":"semetey-1-2013:p0531:b003:l018","ordinal":117306,"en":"You, poor creature, wandered aimlessly."},{"id":"semetey-1-2013:p0531:b003:l019","ordinal":117307,"en":"To Kara Khan's city,"},{"id":"semetey-1-2013:p0531:b003:l020","ordinal":117308,"en":"With no kinsman to care for me,"},{"id":"semetey-1-2013:p0531:b003:l021","ordinal":117309,"en":"I, poor creature, fled."},{"id":"semetey-1-2013:p0531:b003:l022","ordinal":117310,"en":"Bereft of Khan Manas,"},{"id":"semetey-1-2013:p0531:b003:l023","ordinal":117311,"en":"Seeking wolves across the steppe,"},{"id":"semetey-1-2013:p0531:b003:l024","ordinal":117312,"en":"You, poor creature, were left wandering!"},{"id":"semetey-1-2013:p0531:b003:l025","ordinal":117313,"en":"My leopard father, if only you had not died,"},{"id":"semetey-1-2013:p0531:b003:l026","ordinal":117314,"en":"If only I had not fled to Bukhara,"},{"id":"semetey-1-2013:p0531:b003:l027","ordinal":117315,"en":"Nor returned as an orphan!"},{"id":"semetey-1-2013:p0531:b003:l028","ordinal":117316,"en":"Left on the steppe without support,"},{"id":"semetey-1-2013:p0531:b003:l029","ordinal":117317,"en":"Such humiliation as this—"},{"id":"semetey-1-2013:p0531:b003:l030","ordinal":117318,"en":"May I be sacrificed for you, Kumaik—"},{"id":"semetey-1-2013:p0531:b003:l031","ordinal":117319,"en":"May God grant it to none of His servants!"},{"id":"semetey-1-2013:p0531:b003:l032","ordinal":117320,"en":"I, the destitute one left by my father,"},{"id":"semetey-1-2013:p0531:b003:l033","ordinal":117321,"en":"And you, the destitute one roaming the steppe!”"},{"id":"semetey-1-2013:p0531:b003:l034","ordinal":117322,"en":"When he saw Kumaik,"},{"id":"semetey-1-2013:p0531:b003:l035","ordinal":117323,"en":"The orphan boy left by Manas"},{"id":"semetey-1-2013:p0531:b003:l036","ordinal":117324,"en":"Felt as though he had seen his father Manas."},{"id":"semetey-1-2013:p0531:b003:l037","ordinal":117325,"en":"His heart was torn with grief,"},{"id":"semetey-1-2013:p0531:b003:l038","ordinal":117326,"en":"His tears poured out,"},{"id":"semetey-1-2013:p0531:b003:l039","ordinal":117327,"en":"His very ribs seemed to split apart."},{"id":"semetey-1-2013:p0531:b005:l001","ordinal":117328,"en":"As though his father Manas had risen from the dead"},{"id":"semetey-1-2013:p0531:b005:l002","ordinal":117329,"en":"And come before him,"},{"id":"semetey-1-2013:p0531:b005:l003","ordinal":117330,"en":"Embracing him and wailing aloud,"},{"id":"semetey-1-2013:p0531:b005:l004","ordinal":117331,"en":"Semetey was overwhelmed."},{"id":"semetey-1-2013:p0531:b005:l005","ordinal":117332,"en":"Kumaik howled and wailed,"},{"id":"semetey-1-2013:p0531:b005:l006","ordinal":117333,"en":"Semetey wept with ringing cries."},{"id":"semetey-1-2013:p0531:b005:l007","ordinal":117334,"en":"From his dear, quail-like eyes"},{"id":"semetey-1-2013:p0531:b005:l008","ordinal":117335,"en":"Tears fell in separate streams."},{"id":"semetey-1-2013:p0531:b005:l009","ordinal":117336,"en":"From his dark, falcon-like eyes"},{"id":"semetey-1-2013:p0531:b005:l010","ordinal":117337,"en":"Tears fell with every blink."},{"id":"semetey-1-2013:p0531:b005:l011","ordinal":117338,"en":"Greeting Kumaik,"},{"id":"semetey-1-2013:p0531:b005:l012","ordinal":117339,"en":"Semetey kissed him more fondly than a person."},{"id":"semetey-1-2013:p0531:b005:l013","ordinal":117340,"en":"When he saw Kumaik,"},{"id":"semetey-1-2013:p0531:b005:l014","ordinal":117341,"en":"The boy grieved, weeping blood,"},{"id":"semetey-1-2013:p0531:b005:l015","ordinal":117342,"en":"Unable to stop his anguished weeping:"},{"id":"semetey-1-2013:p0531:b005:l016","ordinal":117343,"en":"“My inheritance left by my khan father Manas,"},{"id":"semetey-1-2013:p0531:b005:l018","ordinal":117344,"en":"Oh, may I be sacrificed for you, Kumaik!"},{"id":"semetey-1-2013:p0531:b005:l019","ordinal":117345,"en":"Let no resentment remain in your heart!”"},{"id":"semetey-1-2013:p0531:b005:l020","ordinal":117346,"en":"Leading Kumaik,"},{"id":"semetey-1-2013:p0531:b005:l021","ordinal":117347,"en":"Semetey traveled on, deeply stirred."},{"id":"semetey-1-2013:p0531:b005:l022","ordinal":117348,"en":"A short-tailed dun mare, a creature of the unseen,"},{"id":"semetey-1-2013:p0531:b005:l023","ordinal":117349,"en":"Appeared before him."},{"id":"semetey-1-2013:p0531:b005:l024","ordinal":117350,"en":"He caught the dun mare and slaughtered it."},{"id":"semetey-1-2013:p0531:b005:l025","ordinal":117351,"en":"Its belly fat was a span thick."},{"id":"semetey-1-2013:p0531:b005:l026","ordinal":117352,"en":"“Until I come back this way,"},{"id":"semetey-1-2013:p0531:b005:l027","ordinal":117353,"en":"Eat your fill of this gift and rest,” he said,"},{"id":"semetey-1-2013:p0531:b005:l028","ordinal":117354,"en":"And left Kumaik there."},{"id":"semetey-1-2013:p0531:b005:l029","ordinal":117355,"en":"Then he journeyed farther,"},{"id":"semetey-1-2013:p0531:b005:l030","ordinal":117356,"en":"Crossed ridge after rugged ridge,"},{"id":"semetey-1-2013:p0531:b005:l031","ordinal":117357,"en":"Traversed rough, ridged country,"},{"id":"semetey-1-2013:p0531:b005:l032","ordinal":117358,"en":"And entered Ken-Kol."},{"id":"semetey-1-2013:p0531:b005:l033","ordinal":117359,"en":"In Ken-Kol he saw wonders."},{"id":"semetey-1-2013:p0531:b005:l034","ordinal":117360,"en":"On the curving slopes of Imerme-Too,"},{"id":"semetey-1-2013:p0531:b005:l035","ordinal":117361,"en":"On the broad ground where saker falcons nested,"},{"id":"semetey-1-2013:p0531:b005:l036","ordinal":117362,"en":"When generous Manas was alive,"},{"id":"semetey-1-2013:p0531:b005:l037","ordinal":117363,"en":"In the nests where falcons bred,"},{"id":"semetey-1-2013:p0531:b005:l038","ordinal":117364,"en":"He went on again, deeply stirred,"},{"id":"semetey-1-2013:p0531:b005:l039","ordinal":117365,"en":"Your orphan left by Manas."},{"id":"semetey-1-2013:p0532:b003:l001","ordinal":117366,"en":"He encountered a night blessed by Kydyr."},{"id":"semetey-1-2013:p0532:b003:l002","ordinal":117367,"en":"Akshumkar, left by his father Manas,"},{"id":"semetey-1-2013:p0532:b003:l003","ordinal":117368,"en":"Appeared before him."},{"id":"semetey-1-2013:p0532:b003:l004","ordinal":117369,"en":"“The orphan will come this year,”"},{"id":"semetey-1-2013:p0532:b003:l005","ordinal":117370,"en":"Akshumkar had known"},{"id":"semetey-1-2013:p0532:b003:l006","ordinal":117371,"en":"He would truly come."},{"id":"semetey-1-2013:p0532:b003:l007","ordinal":117372,"en":"Brooding on a nest, ranging along the rocks,"},{"id":"semetey-1-2013:p0532:b003:l008","ordinal":117373,"en":"It had grieved all the while."},{"id":"semetey-1-2013:p0532:b003:l009","ordinal":117374,"en":"The orphan left by Manas"},{"id":"semetey-1-2013:p0532:b003:l010","ordinal":117375,"en":"It had been seeking to see."},{"id":"semetey-1-2013:p0532:b003:l011","ordinal":117376,"en":"Its charge to that orphan"},{"id":"semetey-1-2013:p0532:b003:l012","ordinal":117377,"en":"It had been seeking to entrust."},{"id":"semetey-1-2013:p0532:b003:l013","ordinal":117378,"en":"When Manas the Leopard died,"},{"id":"semetey-1-2013:p0532:b003:l014","ordinal":117379,"en":"It broke its golden jesses,"},{"id":"semetey-1-2013:p0532:b003:l015","ordinal":117380,"en":"Akshumkar tore them apart."},{"id":"semetey-1-2013:p0532:b003:l016","ordinal":117381,"en":"Letting no one catch it,"},{"id":"semetey-1-2013:p0532:b003:l017","ordinal":117382,"en":"Letting no one see it,"},{"id":"semetey-1-2013:p0532:b003:l018","ordinal":117383,"en":"Akshumkar had flown away."},{"id":"semetey-1-2013:p0532:b003:l020","ordinal":117384,"en":"Akshumkar had vanished.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0532:b003:l021","ordinal":117385,"en":"Breaking its silver jesses,"},{"id":"semetey-1-2013:p0532:b003:l022","ordinal":117386,"en":"Akshumkar had disappeared into the unseen."},{"id":"semetey-1-2013:p0532:b003:l023","ordinal":117387,"en":"It ranged across the whole world."},{"id":"semetey-1-2013:p0532:b003:l024","ordinal":117388,"en":"The shrines upon the earth,"},{"id":"semetey-1-2013:p0532:b003:l025","ordinal":117389,"en":"It visited without missing one."},{"id":"semetey-1-2013:p0532:b003:l026","ordinal":117390,"en":"Zhelpinish at the world's end,"},{"id":"semetey-1-2013:p0532:b003:l027","ordinal":117391,"en":"The place where birds make pilgrimage,"},{"id":"semetey-1-2013:p0532:b003:l028","ordinal":117392,"en":"It had sought out."},{"id":"semetey-1-2013:p0532:b003:l029","ordinal":117393,"en":"After staying seven nights there,"},{"id":"semetey-1-2013:p0532:b003:l030","ordinal":117394,"en":"It had visited Medina."},{"id":"semetey-1-2013:p0532:b003:l031","ordinal":117395,"en":"Mecca and Medina—"},{"id":"semetey-1-2013:p0532:b003:l032","ordinal":117396,"en":"His khan father's Akshumkar"},{"id":"semetey-1-2013:p0532:b003:l033","ordinal":117397,"en":"Had stayed there for five years."},{"id":"semetey-1-2013:p0532:b003:l034","ordinal":117398,"en":"In Egypt and Baghdad"},{"id":"semetey-1-2013:p0532:b003:l035","ordinal":117399,"en":"It had spent seven winters."},{"id":"semetey-1-2013:p0532:b003:l036","ordinal":117400,"en":"“Those seven and those five"},{"id":"semetey-1-2013:p0532:b003:l037","ordinal":117401,"en":"Have made twelve years."},{"id":"semetey-1-2013:p0532:b003:l038","ordinal":117402,"en":"My orphan left by the generous lord,"},{"id":"semetey-1-2013:p0532:b003:l039","ordinal":117403,"en":"To the Kyrgyz in Talas"},{"id":"semetey-1-2013:p0532:b004:l001","ordinal":117404,"en":"The time has come for him to return."},{"id":"semetey-1-2013:p0532:b004:l002","ordinal":117405,"en":"The one God—"},{"id":"semetey-1-2013:p0532:b004:l003","ordinal":117406,"en":"The time has come to grant my wish.”"},{"id":"semetey-1-2013:p0532:b004:l004","ordinal":117407,"en":"That year Akshumkar,"},{"id":"semetey-1-2013:p0532:b004:l005","ordinal":117408,"en":"Hunting swans for food along the way,"},{"id":"semetey-1-2013:p0532:b004:l006","ordinal":117409,"en":"Traveled back from Mecca,"},{"id":"semetey-1-2013:p0532:b004:l007","ordinal":117410,"en":"Flew over the dry land,"},{"id":"semetey-1-2013:p0532:b004:l008","ordinal":117411,"en":"Searched the face of the earth."},{"id":"semetey-1-2013:p0532:b004:l009","ordinal":117412,"en":"Chatyr-Kol at the head of the Naryn—"},{"id":"semetey-1-2013:p0532:b004:l010","ordinal":117413,"en":"With a pale kumpai falcon there,"},{"id":"semetey-1-2013:p0532:b004:l011","ordinal":117414,"en":"It joined its body in courtship."},{"id":"semetey-1-2013:p0532:b004:l012","ordinal":117415,"en":"They had mated,"},{"id":"semetey-1-2013:p0532:b004:l013","ordinal":117416,"en":"And it was heavy with young."},{"id":"semetey-1-2013:p0532:b004:l014","ordinal":117417,"en":"To the curving slope of Imerme-Too,"},{"id":"semetey-1-2013:p0532:b004:l015","ordinal":117418,"en":"To the broad ground where saker falcons breed,"},{"id":"semetey-1-2013:p0532:b004:l016","ordinal":117419,"en":"It came and built a nest."},{"id":"semetey-1-2013:p0532:b004:l017","ordinal":117420,"en":"“Honoring my father's spirit,"},{"id":"semetey-1-2013:p0532:b004:l018","ordinal":117421,"en":"I shall obey his words."},{"id":"semetey-1-2013:p0532:b004:l019","ordinal":117422,"en":"My child to his child"},{"id":"semetey-1-2013:p0532:b004:l020","ordinal":117423,"en":"I shall give as a sacred trust.”"},{"id":"semetey-1-2013:p0532:b004:l021","ordinal":117424,"en":"The sorrows within its heart"},{"id":"semetey-1-2013:p0532:b004:l022","ordinal":117425,"en":"It banished, leaving none."},{"id":"semetey-1-2013:p0532:b004:l023","ordinal":117426,"en":"Laying its offspring in winter,"},{"id":"semetey-1-2013:p0532:b004:l024","ordinal":117427,"en":"Counting the measure of the days,"},{"id":"semetey-1-2013:p0532:b004:l025","ordinal":117428,"en":"It left them in the frost."},{"id":"semetey-1-2013:p0532:b004:l026","ordinal":117429,"en":"The cold ended and spring arrived."},{"id":"semetey-1-2013:p0532:b004:l027","ordinal":117430,"en":"When the season drew close to spring,"},{"id":"semetey-1-2013:p0532:b004:l028","ordinal":117431,"en":"When the days grew mild,"},{"id":"semetey-1-2013:p0532:b004:l029","ordinal":117432,"en":"With a rushing sound through the ravines,"},{"id":"semetey-1-2013:p0532:b004:l030","ordinal":117433,"en":"When meltwater flowed full,"},{"id":"semetey-1-2013:p0532:b004:l031","ordinal":117434,"en":"The patchy snow disappeared."},{"id":"semetey-1-2013:p0532:b004:l032","ordinal":117435,"en":"When the days grew mild,"},{"id":"semetey-1-2013:p0532:b004:l033","ordinal":117436,"en":"It spread the feathers of its breast."},{"id":"semetey-1-2013:p0532:b004:l034","ordinal":117437,"en":"Brooding for thirty-six days,"},{"id":"semetey-1-2013:p0532:b004:l035","ordinal":117438,"en":"The falcon hatched its offspring."},{"id":"semetey-1-2013:p0532:b004:l036","ordinal":117439,"en":"From Kaiypchy Pass"},{"id":"semetey-1-2013:p0532:b004:l037","ordinal":117440,"en":"It slaughtered geese."},{"id":"semetey-1-2013:p0532:b004:l038","ordinal":117441,"en":"From the river at Kum-Aryk"},{"id":"semetey-1-2013:p0532:b004:l039","ordinal":117442,"en":"It carried swans back."},{"id":"semetey-1-2013:p0533:b003:l001","ordinal":117443,"en":"Hunting snowcocks for food,"},{"id":"semetey-1-2013:p0533:b003:l002","ordinal":117444,"en":"It caught and tore open bustards."},{"id":"semetey-1-2013:p0533:b003:l003","ordinal":117445,"en":"“Semetey will come this year,”"},{"id":"semetey-1-2013:p0533:b003:l004","ordinal":117446,"en":"Akshumkar, left by his father Manas,"},{"id":"semetey-1-2013:p0533:b003:l005","ordinal":117447,"en":"Had longed for the orphan."},{"id":"semetey-1-2013:p0533:b003:l006","ordinal":117448,"en":"Flying over the mountains,"},{"id":"semetey-1-2013:p0533:b003:l007","ordinal":117449,"en":"Attacking whatever challenged it,"},{"id":"semetey-1-2013:p0533:b003:l008","ordinal":117450,"en":"The dear creature soared,"},{"id":"semetey-1-2013:p0533:b003:l009","ordinal":117451,"en":"Ranging over the earth."},{"id":"semetey-1-2013:p0533:b003:l010","ordinal":117452,"en":"The mighty falcon grew excited."},{"id":"semetey-1-2013:p0533:b003:l011","ordinal":117453,"en":"Its talons were iron, its jess-clasp gold."},{"id":"semetey-1-2013:p0533:b003:l012","ordinal":117454,"en":"Circling, Akshumkar"},{"id":"semetey-1-2013:p0533:b003:l013","ordinal":117455,"en":"Came upon Semetey."},{"id":"semetey-1-2013:p0533:b003:l014","ordinal":117456,"en":"“Ah, my mother told me:"},{"id":"semetey-1-2013:p0533:b003:l015","ordinal":117457,"en":"‘If fortune favors you, Akshumkar left by your father"},{"id":"semetey-1-2013:p0533:b003:l017","ordinal":117458,"en":"Will come to meet you,’ she said."},{"id":"semetey-1-2013:p0533:b003:l018","ordinal":117459,"en":"It is Akshumkar itself!"},{"id":"semetey-1-2013:p0533:b003:l019","ordinal":117460,"en":"Surely for me"},{"id":"semetey-1-2013:p0533:b003:l020","ordinal":117461,"en":"That dear creature has been grieving.”"},{"id":"semetey-1-2013:p0533:b003:l021","ordinal":117462,"en":"When he saw Akshumkar,"},{"id":"semetey-1-2013:p0533:b003:l022","ordinal":117463,"en":"It was as though his father Manas, this very day,"},{"id":"semetey-1-2013:p0533:b003:l023","ordinal":117464,"en":"Had come alive again beside him,"},{"id":"semetey-1-2013:p0533:b003:l024","ordinal":117465,"en":"As though God had granted his wish."},{"id":"semetey-1-2013:p0533:b003:l025","ordinal":117466,"en":"When he saw Akshumkar,"},{"id":"semetey-1-2013:p0533:b003:l026","ordinal":117467,"en":"Bracing his right side,"},{"id":"semetey-1-2013:p0533:b003:l027","ordinal":117468,"en":"“My formidable father!” he wept."},{"id":"semetey-1-2013:p0533:b003:l028","ordinal":117469,"en":"Bracing his left side,"},{"id":"semetey-1-2013:p0533:b003:l029","ordinal":117470,"en":"“My protector, my father!” he wept."},{"id":"semetey-1-2013:p0533:b003:l030","ordinal":117471,"en":"“The rushing place of two rivers—"},{"id":"semetey-1-2013:p0533:b003:l031","ordinal":117472,"en":"My khan father, like the stillness where they meet!"},{"id":"semetey-1-2013:p0533:b003:l032","ordinal":117473,"en":"Where two mountains meet,"},{"id":"semetey-1-2013:p0533:b003:l033","ordinal":117474,"en":"My khan father, like their rocky ridge!”"},{"id":"semetey-1-2013:p0533:b003:l034","ordinal":117475,"en":"Seeing Akshumkar, he cried aloud,"},{"id":"semetey-1-2013:p0533:b003:l035","ordinal":117476,"en":"Called out his khan father Manas's name,"},{"id":"semetey-1-2013:p0533:b003:l036","ordinal":117477,"en":"As though he had seen his fierce-maned father Manas."},{"id":"semetey-1-2013:p0533:b003:l038","ordinal":117478,"en":"Tears streamed from his eyes in all directions."},{"id":"semetey-1-2013:p0533:b003:l039","ordinal":117479,"en":"He could not even stop his running nose."},{"id":"semetey-1-2013:p0533:b004:l001","ordinal":117480,"en":"The boy could not wipe his tears."},{"id":"semetey-1-2013:p0533:b004:l002","ordinal":117481,"en":"When sorrow strikes, the heart"},{"id":"semetey-1-2013:p0533:b004:l003","ordinal":117482,"en":"Cannot stay still: it breaks apart."},{"id":"semetey-1-2013:p0533:b004:l004","ordinal":117483,"en":"The poor orphan boy left by Manas—"},{"id":"semetey-1-2013:p0533:b004:l005","ordinal":117484,"en":"His tears kept pouring out."},{"id":"semetey-1-2013:p0533:b004:l006","ordinal":117485,"en":"When he fell behind, Akshumkar"},{"id":"semetey-1-2013:p0533:b004:l007","ordinal":117486,"en":"Called loudly from the sky"},{"id":"semetey-1-2013:p0533:b004:l008","ordinal":117487,"en":"And above that boy"},{"id":"semetey-1-2013:p0533:b004:l009","ordinal":117488,"en":"Circled, flashing bright."},{"id":"semetey-1-2013:p0533:b004:l010","ordinal":117489,"en":"When the boy drew near,"},{"id":"semetey-1-2013:p0533:b004:l011","ordinal":117490,"en":"My dear Akshumkar"},{"id":"semetey-1-2013:p0533:b004:l012","ordinal":117491,"en":"Flew smoothly on, flashing bright."},{"id":"semetey-1-2013:p0533:b004:l013","ordinal":117492,"en":"Meeting Akshumkar,"},{"id":"semetey-1-2013:p0533:b004:l014","ordinal":117493,"en":"What had broken was joined again,"},{"id":"semetey-1-2013:p0533:b004:l015","ordinal":117494,"en":"What had scattered was gathered."},{"id":"semetey-1-2013:p0533:b004:l016","ordinal":117495,"en":"The orphan left by Manas—"},{"id":"semetey-1-2013:p0533:b004:l017","ordinal":117496,"en":"His life, frail as a fly, rejoiced."},{"id":"semetey-1-2013:p0533:b004:l018","ordinal":117497,"en":"What he had lost was found."},{"id":"semetey-1-2013:p0533:b004:l019","ordinal":117498,"en":"Thus his honor was restored."},{"id":"semetey-1-2013:p0533:b004:l020","ordinal":117499,"en":"Weeping, his eyes burned like coals."},{"id":"semetey-1-2013:p0533:b004:l021","ordinal":117500,"en":"To see Akshumkar,"},{"id":"semetey-1-2013:p0533:b004:l022","ordinal":117501,"en":"He watched with all his longing."},{"id":"semetey-1-2013:p0533:b004:l023","ordinal":117502,"en":"Walking straight on in distress,"},{"id":"semetey-1-2013:p0533:b004:l024","ordinal":117503,"en":"To God, whose command surpasses all,"},{"id":"semetey-1-2013:p0533:b004:l025","ordinal":117504,"en":"The boy prayed in supplication."}]
