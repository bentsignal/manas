{"id": "sayakbay-ms-current142:pdf032:l043", "source_id": "sayakbay-ms-current142", "pdf_sha256": "2b1fd33d35b9fec662724180743e44a26bc44d8b347d5f99c373acf98cb6c73f", "page": 32, "folio": 2349, "line_in_page": 43, "raw": "Разым келүү, келбесин,", "text": "Разым келүү, келбесин,", "en": "Whether my consent comes or not,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "First word and verbal construction are uncertain.", "bbox": null}
