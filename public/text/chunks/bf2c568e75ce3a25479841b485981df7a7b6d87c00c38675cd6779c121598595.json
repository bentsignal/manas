[{"id":"manas-2010:p1404:b001:l025","ordinal":60673,"en":"Surrounding and swarming in."},{"id":"manas-2010:p1404:b001:l026","ordinal":60674,"en":"When he saw them swarm,"},{"id":"manas-2010:p1404:b001:l027","ordinal":60675,"en":"Unable to collect his wits,"},{"id":"manas-2010:p1404:b001:l028","ordinal":60676,"en":"Esenkan was distraught."},{"id":"manas-2010:p1404:b001:l029","ordinal":60677,"en":"Thinking this in his mind,"},{"id":"manas-2010:p1404:b001:l030","ordinal":60678,"en":"Esenkan resolved to submit."},{"id":"manas-2010:p1404:b001:l031","ordinal":60679,"en":"With pressure upon him,"},{"id":"manas-2010:p1404:b001:l032","ordinal":60680,"en":"A thousand girls together with his daughter"},{"id":"manas-2010:p1404:b001:l033","ordinal":60681,"en":"Esenkan resolved to present as tribute."},{"id":"manas-2010:p1404:b001:l034","ordinal":60682,"en":"Whatever words he said,"},{"id":"manas-2010:p1404:b001:l035","ordinal":60683,"en":"Esenkan resolved to accept;"},{"id":"manas-2010:p1404:b001:l036","ordinal":60684,"en":"The khanship of Outer Beijing"},{"id":"manas-2010:p1404:b001:l037","ordinal":60685,"en":"Esenkan resolved to give."},{"id":"manas-2010:p1404:b001:l038","ordinal":60686,"en":"To a lineage of the Chinese people,"},{"id":"manas-2010:p1404:b001:l039","ordinal":60687,"en":"Word without holding back"},{"id":"manas-2010:p1404:b001:l040","ordinal":60688,"en":"Esenkan resolved to send."},{"id":"manas-2010:p1404:b001:l041","ordinal":60689,"en":"A group of the guard khans"},{"id":"manas-2010:p1404:b001:l042","ordinal":60690,"en":"Esenkan resolved to gather."},{"id":"manas-2010:p1405:b001:l001","ordinal":60691,"en":"Fair-faced young wives and beautiful girls"},{"id":"manas-2010:p1405:b001:l002","ordinal":60692,"en":"Driving forth to give as tribute,"},{"id":"manas-2010:p1405:b001:l003","ordinal":60693,"en":"Raising Manas as khan,"},{"id":"manas-2010:p1405:b001:l004","ordinal":60694,"en":"Begging for his life, from death"},{"id":"manas-2010:p1405:b001:l005","ordinal":60695,"en":"Esenkan resolved to escape."},{"id":"manas-2010:p1405:b001:l006","ordinal":60696,"en":"Esenkan’s daughter Burulcha,"},{"id":"manas-2010:p1405:b001:l007","ordinal":60697,"en":"And Ay Jangjung’s Birmyskal,"},{"id":"manas-2010:p1405:b001:l008","ordinal":60698,"en":"Putting these two girls at the head,"},{"id":"manas-2010:p1405:b001:l009","ordinal":60699,"en":"All the multitude of girls"},{"id":"manas-2010:p1405:b001:l010","ordinal":60700,"en":"He clothed in loosely draped silk,"},{"id":"manas-2010:p1405:b001:l011","ordinal":60701,"en":"And mounted on smooth amblers."},{"id":"manas-2010:p1405:b001:l012","ordinal":60702,"en":"Clothing them in pure red,"},{"id":"manas-2010:p1405:b001:l013","ordinal":60703,"en":"Behind the two girls—"},{"id":"manas-2010:p1405:b001:l014","ordinal":60704,"en":"When snow falls upon snowy ground,"},{"id":"manas-2010:p1405:b001:l015","ordinal":60705,"en":"Look at the snow and see their flesh;"},{"id":"manas-2010:p1405:b001:l016","ordinal":60706,"en":"When blood drips upon the snow,"},{"id":"manas-2010:p1405:b001:l017","ordinal":60707,"en":"Look at the blood and see their cheeks!"},{"id":"manas-2010:p1405:b001:l018","ordinal":60708,"en":"From such surpassing beauties,"},{"id":"manas-2010:p1405:b001:l019","ordinal":60709,"en":"Waists a handgrip wide, faces like the moon,"},{"id":"manas-2010:p1405:b001:l020","ordinal":60710,"en":"Rooster-like necks and long, thick hair,"},{"id":"manas-2010:p1405:b001:l021","ordinal":60711,"en":"He separated those who stood proudly."},{"id":"manas-2010:p1405:b001:l022","ordinal":60712,"en":"The languishing beauties,"},{"id":"manas-2010:p1405:b001:l023","ordinal":60713,"en":"Behind Burulcha,"},{"id":"manas-2010:p1405:b001:l024","ordinal":60714,"en":"He sent onward in groups."},{"id":"manas-2010:p1405:b001:l025","ordinal":60715,"en":"Thimble mouths and languid eyes,"},{"id":"manas-2010:p1405:b001:l026","ordinal":60716,"en":"Pendant-strung braids and reed-like waists,"},{"id":"manas-2010:p1405:b001:l027","ordinal":60717,"en":"The stately girls he set apart."},{"id":"manas-2010:p1405:b001:l028","ordinal":60718,"en":"Ayzhang’s daughter Birmyskal,"},{"id":"manas-2010:p1405:b001:l029","ordinal":60719,"en":"With Birmyskal at their head,"},{"id":"manas-2010:p1405:b001:l030","ordinal":60720,"en":"Of beauties such as these"},{"id":"manas-2010:p1405:b001:l031","ordinal":60721,"en":"He separated a company."},{"id":"manas-2010:p1405:b001:l032","ordinal":60722,"en":"With the two girls at the head,"},{"id":"manas-2010:p1405:b001:l033","ordinal":60723,"en":"Taking a thousand dark-eyed ones,"},{"id":"manas-2010:p1405:b001:l034","ordinal":60724,"en":"With so many camels leading,"},{"id":"manas-2010:p1405:b001:l035","ordinal":60725,"en":"Loading elephants and taking gold,"},{"id":"manas-2010:p1405:b001:l036","ordinal":60726,"en":"With Khan Esenkan at their head,"},{"id":"manas-2010:p1405:b001:l037","ordinal":60727,"en":"They came bearing tribute to Manas."},{"id":"manas-2010:p1405:b001:l038","ordinal":60728,"en":"Then Khan Manas,"},{"id":"manas-2010:p1405:b001:l039","ordinal":60729,"en":"To Koshoy and Bakay,"},{"id":"manas-2010:p1405:b001:l040","ordinal":60730,"en":"Spoke these words:"},{"id":"manas-2010:p1405:b001:l041","ordinal":60731,"en":"“Beauties among women are coming;"},{"id":"manas-2010:p1405:b001:l042","ordinal":60732,"en":"Before you, as tribute, so many"},{"id":"manas-2010:p1406:b001:l001","ordinal":60733,"en":"Surpassingly beautiful girls are coming;"},{"id":"manas-2010:p1406:b001:l002","ordinal":60734,"en":"There is something to be said."},{"id":"manas-2010:p1406:b001:l003","ordinal":60735,"en":"Of gold, gold coins and silk,"},{"id":"manas-2010:p1406:b001:l004","ordinal":60736,"en":"So much cloth is coming as tribute."},{"id":"manas-2010:p1406:b001:l005","ordinal":60737,"en":"Almambet, Azizkan’s son,"},{"id":"manas-2010:p1406:b001:l006","ordinal":60738,"en":"Was formerly khan in Beijing."},{"id":"manas-2010:p1406:b001:l007","ordinal":60739,"en":"Esenkan’s Burulcha—"},{"id":"manas-2010:p1406:b001:l008","ordinal":60740,"en":"That he would take her, from of old"},{"id":"manas-2010:p1406:b001:l009","ordinal":60741,"en":"He had a promise."},{"id":"manas-2010:p1406:b001:l010","ordinal":60742,"en":"What I say to you:"},{"id":"manas-2010:p1406:b001:l011","ordinal":60743,"en":"A beauty like Burulcha,"},{"id":"manas-2010:p1406:b001:l012","ordinal":60744,"en":"Do not separate her from Almambet."},{"id":"manas-2010:p1406:b001:l013","ordinal":60745,"en":"They say few souls surpass her;"},{"id":"manas-2010:p1406:b001:l014","ordinal":60746,"en":"Esenkan’s Burulcha"},{"id":"manas-2010:p1406:b001:l015","ordinal":60747,"en":"Is said to be a truly beautiful girl."},{"id":"manas-2010:p1406:b001:l016","ordinal":60748,"en":"Ay Jangjung’s daughter Birmyskal,"},{"id":"manas-2010:p1406:b001:l017","ordinal":60749,"en":"Called a khan of outstanding renown,"},{"id":"manas-2010:p1406:b001:l018","ordinal":60750,"en":"Her love for Chubak,"},{"id":"manas-2010:p1406:b001:l019","ordinal":60751,"en":"They say, has been true from of old."},{"id":"manas-2010:p1406:b001:l020","ordinal":60752,"en":"They call her a beauty among women,"},{"id":"manas-2010:p1406:b001:l021","ordinal":60753,"en":"A girl whose wisdom is full."},{"id":"manas-2010:p1406:b001:l022","ordinal":60754,"en":"If you heed my words, people,"},{"id":"manas-2010:p1406:b001:l023","ordinal":60755,"en":"When the two girls come,"},{"id":"manas-2010:p1406:b001:l024","ordinal":60756,"en":"Let us gather the mighty army;"},{"id":"manas-2010:p1406:b001:l025","ordinal":60757,"en":"Almambet and Chubak, the two heroes,"},{"id":"manas-2010:p1406:b001:l026","ordinal":60758,"en":"Let us wed them to those two!"},{"id":"manas-2010:p1406:b001:l027","ordinal":60759,"en":"Of Beijing, which we longed to reach,"},{"id":"manas-2010:p1406:b001:l028","ordinal":60760,"en":"Let us see the wonders, my people;"},{"id":"manas-2010:p1406:b001:l029","ordinal":60761,"en":"The gold they have brought,"},{"id":"manas-2010:p1406:b001:l030","ordinal":60762,"en":"Let us divide it by the handful!”"},{"id":"manas-2010:p1406:b001:l031","ordinal":60763,"en":"When they heard Manas’s words,"},{"id":"manas-2010:p1406:b001:l032","ordinal":60764,"en":"All of them, all the army,"},{"id":"manas-2010:p1406:b001:l033","ordinal":60765,"en":"Made their promise firm,"},{"id":"manas-2010:p1406:b001:l034","ordinal":60766,"en":"Swore an oath unto death:"},{"id":"manas-2010:p1406:b001:l035","ordinal":60767,"en":"“Whoever becomes divided from us,"},{"id":"manas-2010:p1406:b001:l036","ordinal":60768,"en":"May his oath strike him down at once!”"},{"id":"manas-2010:p1406:b001:l037","ordinal":60769,"en":"Chewing white wheat flour,"},{"id":"manas-2010:p1406:b001:l038","ordinal":60770,"en":"Grasping hands firmly,"},{"id":"manas-2010:p1406:b001:l039","ordinal":60771,"en":"“Let this be the rule,” they said,"},{"id":"manas-2010:p1406:b001:l040","ordinal":60772,"en":"Gathering their wise men,"},{"id":"manas-2010:p1406:b001:l041","ordinal":60773,"en":"Having all twelve khans"},{"id":"manas-2010:p1406:b001:l042","ordinal":60774,"en":"Hold a twig and cut it together,"},{"id":"manas-2010:p1407:b001:l001","ordinal":60775,"en":"The pure ones bound by their promise,"},{"id":"manas-2010:p1407:b001:l002","ordinal":60776,"en":"Thus spoke the great men;"},{"id":"manas-2010:p1407:b001:l003","ordinal":60777,"en":"When Manas conquered the Chinese,"},{"id":"manas-2010:p1407:b001:l004","ordinal":60778,"en":"These wonders came to pass."},{"id":"manas-2010:p1407:b001:l005","ordinal":60779,"en":"Burulcha and Birmyskal,"},{"id":"manas-2010:p1407:b001:l006","ordinal":60780,"en":"The two beauties at their head,"},{"id":"manas-2010:p1407:b001:l007","ordinal":60781,"en":"Many girls came as tribute."},{"id":"manas-2010:p1407:b001:l008","ordinal":60782,"en":"Taking pale, mottled pennants and banners,"},{"id":"manas-2010:p1407:b001:l009","ordinal":60783,"en":"Seeing Manas’s bearing,"},{"id":"manas-2010:p1407:b001:l010","ordinal":60784,"en":"Beijing of Kakan-Chin rejoiced."},{"id":"manas-2010:p1407:b001:l011","ordinal":60785,"en":"Esenkan and Ay Jangjung,"},{"id":"manas-2010:p1407:b001:l012","ordinal":60786,"en":"“Do not slaughter the people needlessly,” they said,"},{"id":"manas-2010:p1407:b001:l013","ordinal":60787,"en":"Before hero Manas,"},{"id":"manas-2010:p1407:b001:l014","ordinal":60788,"en":"Presenting tribute and pleading:"},{"id":"manas-2010:p1407:b001:l015","ordinal":60789,"en":"“Of Beijing in Kakan-Chin,"},{"id":"manas-2010:p1407:b001:l016","ordinal":60790,"en":"I have given you the khanship—know it!"},{"id":"manas-2010:p1407:b001:l017","ordinal":60791,"en":"The golden throne beneath me,"},{"id":"manas-2010:p1407:b001:l018","ordinal":60792,"en":"I have given you—take your seat!"},{"id":"manas-2010:p1407:b001:l019","ordinal":60793,"en":"Do not massacre my people;"},{"id":"manas-2010:p1407:b001:l020","ordinal":60794,"en":"Do not drive away my good fortune."},{"id":"manas-2010:p1407:b001:l021","ordinal":60795,"en":"Let me offer you as tribute"},{"id":"manas-2010:p1407:b001:l022","ordinal":60796,"en":"My Chinese peoples of forty khans!"},{"id":"manas-2010:p1407:b001:l023","ordinal":60797,"en":"By killing my Khan Ezkara,"},{"id":"manas-2010:p1407:b001:l024","ordinal":60798,"en":"Do not break my back!"},{"id":"manas-2010:p1407:b001:l025","ordinal":60799,"en":"As you wish, be khan as long as you will;"},{"id":"manas-2010:p1407:b001:l026","ordinal":60800,"en":"I have given my land of Beijing!"},{"id":"manas-2010:p1407:b001:l027","ordinal":60801,"en":"Be raised as khan over my people;"},{"id":"manas-2010:p1407:b001:l028","ordinal":60802,"en":"Let me serve you,"},{"id":"manas-2010:p1407:b001:l029","ordinal":60803,"en":"Let me submit to your words."},{"id":"manas-2010:p1407:b001:l030","ordinal":60804,"en":"Your men who have been slaughtered—"},{"id":"manas-2010:p1407:b001:l031","ordinal":60805,"en":"Let me pay their blood-price now!"},{"id":"manas-2010:p1407:b001:l032","ordinal":60806,"en":"Do not bring down all the houses;"},{"id":"manas-2010:p1407:b001:l033","ordinal":60807,"en":"Do not cut down and destroy the willows."},{"id":"manas-2010:p1407:b001:l034","ordinal":60808,"en":"The Chinese were an established people;"},{"id":"manas-2010:p1407:b001:l035","ordinal":60809,"en":"Do not crush and torment them!"},{"id":"manas-2010:p1407:b001:l036","ordinal":60810,"en":"Manas, if you are truly a khan,"},{"id":"manas-2010:p1407:b001:l037","ordinal":60811,"en":"Do not dig my pit;"},{"id":"manas-2010:p1407:b001:l038","ordinal":60812,"en":"Do not make my misery boil!"},{"id":"manas-2010:p1407:b001:l039","ordinal":60813,"en":"I too was a khan like you."},{"id":"manas-2010:p1407:b001:l040","ordinal":60814,"en":"Do not bind my hands;"},{"id":"manas-2010:p1407:b001:l041","ordinal":60815,"en":"Do not shatter my feet;"},{"id":"manas-2010:p1407:b001:l042","ordinal":60816,"en":"Do not send wandering into the wilderness"},{"id":"manas-2010:p1408:b001:l001","ordinal":60817,"en":"My multitude of Chinese people!"},{"id":"manas-2010:p1408:b001:l002","ordinal":60818,"en":"The stubborn who would not heed words"},{"id":"manas-2010:p1408:b001:l003","ordinal":60819,"en":"Heard this and grieved:"},{"id":"manas-2010:p1408:b001:l004","ordinal":60820,"en":"‘Manas will enter Beijing,’"},{"id":"manas-2010:p1408:b001:l005","ordinal":60821,"en":"Forty years before this,"},{"id":"manas-2010:p1408:b001:l006","ordinal":60822,"en":"Karykan in Beijing"},{"id":"manas-2010:p1408:b001:l007","ordinal":60823,"en":"Had it written in his register."},{"id":"manas-2010:p1408:b001:l008","ordinal":60824,"en":"Charging all around,"},{"id":"manas-2010:p1408:b001:l009","ordinal":60825,"en":"You have become the white tiger;"},{"id":"manas-2010:p1408:b001:l010","ordinal":60826,"en":"Unable to find a way to flee,"},{"id":"manas-2010:p1408:b001:l011","ordinal":60827,"en":"I have fallen into your hands."},{"id":"manas-2010:p1408:b001:l012","ordinal":60828,"en":"Charging as soon as you see,"},{"id":"manas-2010:p1408:b001:l013","ordinal":60829,"en":"You have become the gray-maned lion;"},{"id":"manas-2010:p1408:b001:l014","ordinal":60830,"en":"Offering girls because of your wrath,"},{"id":"manas-2010:p1408:b001:l015","ordinal":60831,"en":"I have fallen into your hands!”"},{"id":"manas-2010:p1408:b001:l016","ordinal":60832,"en":"When Esenkan said this,"},{"id":"manas-2010:p1408:b001:l017","ordinal":60833,"en":"All the guard khans,"},{"id":"manas-2010:p1408:b001:l018","ordinal":60834,"en":"Showing reverence to Manas,"},{"id":"manas-2010:p1408:b001:l019","ordinal":60835,"en":"Bowed with bent knees,"},{"id":"manas-2010:p1408:b001:l020","ordinal":60836,"en":"Bent low in submission."},{"id":"manas-2010:p1408:b001:l021","ordinal":60837,"en":"Behind them, the multitude of girls,"},{"id":"manas-2010:p1408:b001:l022","ordinal":60838,"en":"Showing reverence to Manas—"},{"id":"manas-2010:p1408:b001:l023","ordinal":60839,"en":"“Birmyskal and Burulcha,"},{"id":"manas-2010:p1408:b001:l024","ordinal":60840,"en":"A thousand girls with those two at the head”—"},{"id":"manas-2010:p1408:b001:l025","ordinal":60841,"en":"All came with pleading eyes."},{"id":"manas-2010:p1408:b001:l026","ordinal":60842,"en":"Rubies, gold and precious stones,"},{"id":"manas-2010:p1408:b001:l027","ordinal":60843,"en":"Loaded upon gelded camels,"},{"id":"manas-2010:p1408:b001:l028","ordinal":60844,"en":"White silver and yellow gold,"},{"id":"manas-2010:p1408:b001:l029","ordinal":60845,"en":"Borne upon elephants’ backs—"},{"id":"manas-2010:p1408:b001:l030","ordinal":60846,"en":"All of them, all the army,"},{"id":"manas-2010:p1408:b001:l031","ordinal":60847,"en":"Gathered and stood together."},{"id":"manas-2010:p1408:b001:l032","ordinal":60848,"en":"The girls who had come as tribute,"},{"id":"manas-2010:p1408:b001:l033","ordinal":60849,"en":"And the great quantity of gold and gold coins,"},{"id":"manas-2010:p1408:b001:l034","ordinal":60850,"en":"They divided as spoils."},{"id":"manas-2010:p1408:b001:l035","ordinal":60851,"en":"The gold and gold coins,"},{"id":"manas-2010:p1408:b001:l036","ordinal":60852,"en":"The many troops come on campaign"},{"id":"manas-2010:p1408:b001:l037","ordinal":60853,"en":"Could no longer load them all."},{"id":"manas-2010:p1408:b001:l038","ordinal":60854,"en":"The beauties white as the moon,"},{"id":"manas-2010:p1408:b001:l039","ordinal":60855,"en":"The purest of humankind,"},{"id":"manas-2010:p1408:b001:l040","ordinal":60856,"en":"The densely gathered troops"},{"id":"manas-2010:p1408:b001:l041","ordinal":60857,"en":"Could no longer manage them all."},{"id":"manas-2010:p1408:b001:l042","ordinal":60858,"en":"The established people, the multitude,"},{"id":"manas-2010:p1409:b001:l001","ordinal":60859,"en":"Koshoy, true to his promise,"},{"id":"manas-2010:p1409:b001:l002","ordinal":60860,"en":"Chose as their impartial arbiter."},{"id":"manas-2010:p1409:b001:l003","ordinal":60861,"en":"The army that went had no regrets."},{"id":"manas-2010:p1409:b001:l004","ordinal":60862,"en":"With hero Koshoy judging fairly,"},{"id":"manas-2010:p1409:b001:l005","ordinal":60863,"en":"When he came to divide the spoils,"},{"id":"manas-2010:p1409:b001:l006","ordinal":60864,"en":"Not a single man remained empty-handed."},{"id":"manas-2010:p1409:b001:l007","ordinal":60865,"en":"Their elders Koshoy and hero Bakay"},{"id":"manas-2010:p1409:b001:l008","ordinal":60866,"en":"Now took counsel together."},{"id":"manas-2010:p1409:b001:l009","ordinal":60867,"en":"Ay Jangjung’s daughter Birmyskal,"},{"id":"manas-2010:p1409:b001:l010","ordinal":60868,"en":"Having a golden tent erected,"},{"id":"manas-2010:p1409:b001:l011","ordinal":60869,"en":"They now married to Chubak."},{"id":"manas-2010:p1409:b001:l012","ordinal":60870,"en":"Muzburchak and Kökchö as arbiters,"},{"id":"manas-2010:p1409:b001:l013","ordinal":60871,"en":"They gathered them all."},{"id":"manas-2010:p1409:b001:l014","ordinal":60872,"en":"Esenkan’s daughter Burulcha,"},{"id":"manas-2010:p1409:b001:l015","ordinal":60873,"en":"To the golden-forelocked, tasseled-belted"},{"id":"manas-2010:p1409:b001:l016","ordinal":60874,"en":"Almambet, Azizkan’s son,"},{"id":"manas-2010:p1409:b001:l017","ordinal":60875,"en":"They now married her."},{"id":"manas-2010:p1409:b001:l018","ordinal":60876,"en":"Chubak, Akbaltay’s son,"},{"id":"manas-2010:p1409:b001:l019","ordinal":60877,"en":"To the city of Tash-Köpürö,"},{"id":"manas-2010:p1409:b001:l020","ordinal":60878,"en":"Placing a crown upon his head,"},{"id":"manas-2010:p1409:b001:l021","ordinal":60879,"en":"Seating him on a golden throne,"},{"id":"manas-2010:p1409:b001:l022","ordinal":60880,"en":"To the people of the half-khan,"},{"id":"manas-2010:p1409:b001:l023","ordinal":60881,"en":"They brought and made him khan."},{"id":"manas-2010:p1409:b001:l024","ordinal":60882,"en":"Golden-forelocked, tasseled-belted"},{"id":"manas-2010:p1409:b001:l025","ordinal":60883,"en":"Almambet, Azizkan’s son,"},{"id":"manas-2010:p1409:b001:l026","ordinal":60884,"en":"Over the Chinese called Torgut,"},{"id":"manas-2010:p1409:b001:l027","ordinal":60885,"en":"They made Almambet khan."},{"id":"manas-2010:p1409:b001:l028","ordinal":60886,"en":"Dividing them up in various ways,"},{"id":"manas-2010:p1409:b001:l029","ordinal":60887,"en":"(From every side, from them all),"},{"id":"manas-2010:p1409:b001:l030","ordinal":60888,"en":"The forces of the twelve khans,"},{"id":"manas-2010:p1409:b001:l031","ordinal":60889,"en":"On every side they made them khans."},{"id":"manas-2010:p1409:b001:l032","ordinal":60890,"en":"For Manas and the forty companions,"},{"id":"manas-2010:p1409:b001:l033","ordinal":60891,"en":"The Kyrgyz and Chinese together—"},{"id":"manas-2010:p1409:b001:l034","ordinal":60892,"en":"Even soaked in water forty years,"},{"id":"manas-2010:p1409:b001:l035","ordinal":60893,"en":"Its patterns would not fade in the least;"},{"id":"manas-2010:p1409:b001:l036","ordinal":60894,"en":"Even swept in floods for forty years,"},{"id":"manas-2010:p1409:b001:l037","ordinal":60895,"en":"Not an edge would budge—"},{"id":"manas-2010:p1409:b001:l038","ordinal":60896,"en":"The carpet with golden patterns"},{"id":"manas-2010:p1409:b001:l039","ordinal":60897,"en":"They brought and spread."},{"id":"manas-2010:p1409:b001:l040","ordinal":60898,"en":"Magnanimous Sultan Manas,"},{"id":"manas-2010:p1409:b001:l041","ordinal":60899,"en":"Upon that carpet,"},{"id":"manas-2010:p1409:b001:l042","ordinal":60900,"en":"They now seated him."},{"id":"manas-2010:p1410:b001:l001","ordinal":60901,"en":"As though he would divide an inheritance,"},{"id":"manas-2010:p1410:b001:l002","ordinal":60902,"en":"The Chinese multitude cried out,"},{"id":"manas-2010:p1410:b001:l003","ordinal":60903,"en":"And gathered around Manas."},{"id":"manas-2010:p1410:b001:l004","ordinal":60904,"en":"With Khan Esenkan at their head,"},{"id":"manas-2010:p1410:b001:l006","ordinal":60905,"en":"They truly raised Manas aloft.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"manas-2010:p1410:b001:l007","ordinal":60906,"en":"Esenkan’s golden throne—"},{"id":"manas-2010:p1410:b001:l008","ordinal":60907,"en":"Seating him upon that golden throne,"},{"id":"manas-2010:p1410:b001:l009","ordinal":60908,"en":"Over Beijing of Kakan-Chin,"},{"id":"manas-2010:p1410:b001:l010","ordinal":60909,"en":"They proclaimed him khan."},{"id":"manas-2010:p1410:b001:l011","ordinal":60910,"en":"Taking tribute from Beijing,"},{"id":"manas-2010:p1410:b001:l012","ordinal":60911,"en":"Seated upon a golden throne as khan,"},{"id":"manas-2010:p1410:b001:l013","ordinal":60912,"en":"The mighty army of the twelve khans"},{"id":"manas-2010:p1410:b001:l014","ordinal":60913,"en":"All had their minds at ease."},{"id":"manas-2010:p1410:b001:l015","ordinal":60914,"en":"The elders Koshoy and Bakay were there;"},{"id":"manas-2010:p1410:b001:l016","ordinal":60915,"en":"All the champions were there."},{"id":"manas-2010:p1410:b001:l017","ordinal":60916,"en":"This time in Beijing,"},{"id":"manas-2010:p1410:b001:l018","ordinal":60917,"en":"Having many remarkable deeds performed,"},{"id":"manas-2010:p1410:b001:l019","ordinal":60918,"en":"The Kyrgyz had their freedom."},{"id":"manas-2010:p1410:b001:l020","ordinal":60919,"en":"With hero Manas at their head,"},{"id":"manas-2010:p1410:b001:l021","ordinal":60920,"en":"Having girls taken as tribute,"},{"id":"manas-2010:p1410:b001:l022","ordinal":60921,"en":"Upon the Chinese peoples of forty khans"},{"id":"manas-2010:p1410:b001:l023","ordinal":60922,"en":"They levied one horse per household,"},{"id":"manas-2010:p1410:b001:l024","ordinal":60923,"en":"Had them gathered, leaving none out,"},{"id":"manas-2010:p1410:b001:l025","ordinal":60924,"en":"“For the Kyrgyz army to eat,”"},{"id":"manas-2010:p1410:b001:l026","ordinal":60925,"en":"Had fat oxen slaughtered,"},{"id":"manas-2010:p1410:b001:l027","ordinal":60926,"en":"Had the guard firmly posted."},{"id":"manas-2010:p1410:b001:l028","ordinal":60927,"en":"All who went became lords;"},{"id":"manas-2010:p1410:b001:l029","ordinal":60928,"en":"The many troops, without division,"}]
