[{"id":"manas-2010:p0958:b001:l011","ordinal":41985,"en":"Knew long ago."},{"id":"manas-2010:p0958:b001:l012","ordinal":41986,"en":"“If he is truly a khan,"},{"id":"manas-2010:p0958:b001:l013","ordinal":41987,"en":"He will come seeking Kanykey,” I said."},{"id":"manas-2010:p0958:b001:l014","ordinal":41988,"en":"From God Most High alone"},{"id":"manas-2010:p0958:b001:l015","ordinal":41989,"en":"I have been asking this.’"},{"id":"manas-2010:p0958:b001:l016","ordinal":41990,"en":"Thus Kanykey,"},{"id":"manas-2010:p0958:b001:l017","ordinal":41991,"en":"Herself still a little girl,"},{"id":"manas-2010:p0958:b001:l018","ordinal":41992,"en":"Her hair not yet long enough to braid,"},{"id":"manas-2010:p0958:b001:l019","ordinal":41993,"en":"Quickly vowed an offering to Baabedin,"},{"id":"manas-2010:p0958:b001:l020","ordinal":41994,"en":"Vowed a sheep to Koroson."},{"id":"manas-2010:p0958:b001:l021","ordinal":41995,"en":"Watching him from outside,"},{"id":"manas-2010:p0958:b001:l022","ordinal":41996,"en":"Taking his full measure,"},{"id":"manas-2010:p0958:b001:l023","ordinal":41997,"en":"Then the blood-drinker's"},{"id":"manas-2010:p0958:b001:l024","ordinal":41998,"en":"Blood-thirst she now understood."},{"id":"manas-2010:p0958:b001:l025","ordinal":41999,"en":"Like one who had found what was missing,"},{"id":"manas-2010:p0958:b001:l026","ordinal":42000,"en":"Fortunate Kanykey"},{"id":"manas-2010:p0958:b001:l027","ordinal":42001,"en":"Now smiled with shining eyes."},{"id":"manas-2010:p0958:b001:l028","ordinal":42002,"en":"Making the unknown known,"},{"id":"manas-2010:p0958:b001:l029","ordinal":42003,"en":"The learned elder Bakay,"},{"id":"manas-2010:p0958:b001:l030","ordinal":42004,"en":"Loading eighty camels with gold coins,"},{"id":"manas-2010:p0958:b001:l031","ordinal":42005,"en":"To Temirkan's court"},{"id":"manas-2010:p0958:b001:l032","ordinal":42006,"en":"Your ocean-like Bakay now went."},{"id":"manas-2010:p0958:b001:l033","ordinal":42007,"en":"As kin by marriage, driving livestock,"},{"id":"manas-2010:p0958:b001:l034","ordinal":42008,"en":"Offering homage, feasting on fat,"},{"id":"manas-2010:p0958:b001:l035","ordinal":42009,"en":"They remained embracing."},{"id":"manas-2010:p0958:b001:l036","ordinal":42010,"en":"In this court of Bukhara,"},{"id":"manas-2010:p0958:b001:l037","ordinal":42011,"en":"When Kanykey's age"},{"id":"manas-2010:p0958:b001:l038","ordinal":42012,"en":"Reaches seventeen years,"},{"id":"manas-2010:p0958:b001:l039","ordinal":42013,"en":"“Go back now,” he said,"},{"id":"manas-2010:p0958:b001:l040","ordinal":42014,"en":"“Then take my daughter,” he said."},{"id":"manas-2010:p0958:b001:l041","ordinal":42015,"en":"Not to agree if an enemy asked,"},{"id":"manas-2010:p0958:b001:l042","ordinal":42016,"en":"Not to give her to another khan,"},{"id":"manas-2010:p0959:b001:l001","ordinal":42017,"en":"Chewing white wheat flour together,"},{"id":"manas-2010:p0959:b001:l002","ordinal":42018,"en":"Licking the edge of a sword,"},{"id":"manas-2010:p0959:b001:l003","ordinal":42019,"en":"Making a solemn promise,"},{"id":"manas-2010:p0959:b001:l004","ordinal":42020,"en":"Taking hold of a twig"},{"id":"manas-2010:p0959:b001:l005","ordinal":42021,"en":"And cutting it in the middle,"},{"id":"manas-2010:p0959:b001:l006","ordinal":42022,"en":"To Bukhara with its twelve gates"},{"id":"manas-2010:p0959:b001:l007","ordinal":42023,"en":"The mighty warriors went and camped."},{"id":"manas-2010:p0959:b001:l008","ordinal":42024,"en":"With that fairy-born soul"},{"id":"manas-2010:p0959:b001:l009","ordinal":42025,"en":"They firmly bound a marriage alliance."},{"id":"manas-2010:p0959:b001:l010","ordinal":42026,"en":"Eighty girls stood at the gate;"},{"id":"manas-2010:p0959:b001:l011","ordinal":42027,"en":"Esteemed Kanykey,"},{"id":"manas-2010:p0959:b001:l012","ordinal":42028,"en":"From the red-robed, moon-waisted,"},{"id":"manas-2010:p0959:b001:l013","ordinal":42029,"en":"Gracefully moving beauties,"},{"id":"manas-2010:p0959:b001:l014","ordinal":42030,"en":"Leaving not so much as a hair,"},{"id":"manas-2010:p0959:b001:l015","ordinal":42031,"en":"Had gathered the finest together."},{"id":"manas-2010:p0959:b001:l016","ordinal":42032,"en":"The people assembled, the crowd swelled;"},{"id":"manas-2010:p0959:b001:l017","ordinal":42033,"en":"When the people stood at the gate,"},{"id":"manas-2010:p0959:b001:l018","ordinal":42034,"en":"Silver-eyed and sun-faced,"},{"id":"manas-2010:p0959:b001:l019","ordinal":42035,"en":"The roaring leopard"},{"id":"manas-2010:p0959:b001:l020","ordinal":42036,"en":"Prepared like a hawk."},{"id":"manas-2010:p0959:b001:l021","ordinal":42037,"en":"To the leopard herself"},{"id":"manas-2010:p0959:b001:l022","ordinal":42038,"en":"Counsel came from the unseen."},{"id":"manas-2010:p0959:b001:l023","ordinal":42039,"en":"Glowing in her coat of mail,"},{"id":"manas-2010:p0959:b001:l024","ordinal":42040,"en":"Temirkan's daughter Kanykey,"},{"id":"manas-2010:p0959:b001:l025","ordinal":42041,"en":"Her moonlike face shining—"},{"id":"manas-2010:p0959:b001:l026","ordinal":42042,"en":"When they saw Kanykey,"},{"id":"manas-2010:p0959:b001:l027","ordinal":42043,"en":"The people crowded round in wonder;"},{"id":"manas-2010:p0959:b001:l028","ordinal":42044,"en":"The people stood gazing."},{"id":"manas-2010:p0959:b001:l029","ordinal":42045,"en":"Beside the greathearted lion"},{"id":"manas-2010:p0959:b001:l030","ordinal":42046,"en":"Were Ajybay and Khan Bakay,"},{"id":"manas-2010:p0959:b001:l031","ordinal":42047,"en":"And his forty companions too."},{"id":"manas-2010:p0959:b001:l032","ordinal":42048,"en":"From the ridge of Kum-Bulak"},{"id":"manas-2010:p0959:b001:l033","ordinal":42049,"en":"The gray puppy they had found earlier,"},{"id":"manas-2010:p0959:b001:l034","ordinal":42050,"en":"His Kumayyk, was there too."},{"id":"manas-2010:p0959:b001:l035","ordinal":42051,"en":"Kumayyk, found while still young,"},{"id":"manas-2010:p0959:b001:l036","ordinal":42052,"en":"Was at an age when his eyes had not opened;"},{"id":"manas-2010:p0959:b001:l037","ordinal":42053,"en":"If Kumayyk were poorly tended,"},{"id":"manas-2010:p0959:b001:l038","ordinal":42054,"en":"He was in danger of dying."},{"id":"manas-2010:p0959:b001:l039","ordinal":42055,"en":"Ajybay and Bakay carried him"},{"id":"manas-2010:p0959:b001:l040","ordinal":42056,"en":"Toward the dusky-complexioned beauty,"},{"id":"manas-2010:p0959:b001:l041","ordinal":42057,"en":"The radiant one among Muslims,"},{"id":"manas-2010:p0959:b001:l042","ordinal":42058,"en":"And approached Kanykey:"},{"id":"manas-2010:p0960:b001:l001","ordinal":42059,"en":"From the ridge of Kum-Bulak,"},{"id":"manas-2010:p0960:b001:l002","ordinal":42060,"en":"From the place of ritual washing,"},{"id":"manas-2010:p0960:b001:l003","ordinal":42061,"en":"Kumayyk had been found:"},{"id":"manas-2010:p0960:b001:l004","ordinal":42062,"en":"“Put a collar round his neck,"},{"id":"manas-2010:p0960:b001:l005","ordinal":42063,"en":"And tend him very carefully."},{"id":"manas-2010:p0960:b001:l006","ordinal":42064,"en":"It would be shameful to let him die;"},{"id":"manas-2010:p0960:b001:l007","ordinal":42065,"en":"Kumayyk is entrusted to you!"},{"id":"manas-2010:p0960:b001:l008","ordinal":42066,"en":"Appearing from the unseen,"},{"id":"manas-2010:p0960:b001:l009","ordinal":42067,"en":"Through God's favor, for you"},{"id":"manas-2010:p0960:b001:l010","ordinal":42068,"en":"One of the peerless creatures was found."},{"id":"manas-2010:p0960:b001:l011","ordinal":42069,"en":"He ordained a gray vulture to bear a puppy"},{"id":"manas-2010:p0960:b001:l012","ordinal":42070,"en":"And sent him to you alone."},{"id":"manas-2010:p0960:b001:l013","ordinal":42071,"en":"If a man rears him, he will not stay;"},{"id":"manas-2010:p0960:b001:l014","ordinal":42072,"en":"He will vanish, I am told."},{"id":"manas-2010:p0960:b001:l015","ordinal":42073,"en":"Unless the finest of the wide-robed,"},{"id":"manas-2010:p0960:b001:l016","ordinal":42074,"en":"The sovereign among women,"},{"id":"manas-2010:p0960:b001:l017","ordinal":42075,"en":"A woman tends him,"},{"id":"manas-2010:p0960:b001:l018","ordinal":42076,"en":"He will come to harm, I am told."},{"id":"manas-2010:p0960:b001:l019","ordinal":42077,"en":"Kumayyk, whose origin is the unseen,"},{"id":"manas-2010:p0960:b001:l020","ordinal":42078,"en":"Unless a treasure of a woman rears him,"},{"id":"manas-2010:p0960:b001:l021","ordinal":42079,"en":"One day his desire"},{"id":"manas-2010:p0960:b001:l022","ordinal":42080,"en":"Will be fulfilled, I am told."},{"id":"manas-2010:p0960:b001:l023","ordinal":42081,"en":"He will not stay despite being reared;"},{"id":"manas-2010:p0960:b001:l024","ordinal":42082,"en":"In the end Kumayyk will flee"},{"id":"manas-2010:p0960:b001:l025","ordinal":42083,"en":"And depart, I am told."},{"id":"manas-2010:p0960:b001:l026","ordinal":42084,"en":"Understand what I have said;"},{"id":"manas-2010:p0960:b001:l027","ordinal":42085,"en":"Lion-hearted soul, heed my words!"},{"id":"manas-2010:p0960:b001:l028","ordinal":42086,"en":"Do not soil a single spot on him,"},{"id":"manas-2010:p0960:b001:l029","ordinal":42087,"en":"Nor break even half a hair!"},{"id":"manas-2010:p0960:b001:l030","ordinal":42088,"en":"Saint-born, I hear you are;"},{"id":"manas-2010:p0960:b001:l031","ordinal":42089,"en":"If you show your sacred power,"},{"id":"manas-2010:p0960:b001:l032","ordinal":42090,"en":"For a span of six months,"},{"id":"manas-2010:p0960:b001:l033","ordinal":42091,"en":"And after six months Kumayyk"},{"id":"manas-2010:p0960:b001:l034","ordinal":42092,"en":"You place safely in my hands,"},{"id":"manas-2010:p0960:b001:l035","ordinal":42093,"en":"I shall not strike you with a raised whip,"},{"id":"manas-2010:p0960:b001:l036","ordinal":42094,"en":"Nor take a co-wife behind your back."},{"id":"manas-2010:p0960:b001:l037","ordinal":42095,"en":"If you tend the puppy well"},{"id":"manas-2010:p0960:b001:l038","ordinal":42096,"en":"And show your lion's nature,"},{"id":"manas-2010:p0960:b001:l039","ordinal":42097,"en":"If you place him safely in my hands,"},{"id":"manas-2010:p0960:b001:l040","ordinal":42098,"en":"Should I fail to bow before you,"},{"id":"manas-2010:p0960:b001:l041","ordinal":42099,"en":"May the shaggy-breasted earth strike me,"},{"id":"manas-2010:p0960:b001:l042","ordinal":42100,"en":"May the open-topped sky strike me!"},{"id":"manas-2010:p0961:b001:l001","ordinal":42101,"en":"Do not grow heedlessly conceited"},{"id":"manas-2010:p0961:b001:l002","ordinal":42102,"en":"And accidentally bring him to the grave."},{"id":"manas-2010:p0961:b001:l003","ordinal":42103,"en":"Around Kumayyk's neck"},{"id":"manas-2010:p0961:b001:l004","ordinal":42104,"en":"Is a collar strap of gold."},{"id":"manas-2010:p0961:b001:l005","ordinal":42105,"en":"Should he happen to be lost,"},{"id":"manas-2010:p0961:b001:l006","ordinal":42106,"en":"Not merely Bukhara—"},{"id":"manas-2010:p0961:b001:l007","ordinal":42107,"en":"The livestock of all nations could not meet"},{"id":"manas-2010:p0961:b001:l008","ordinal":42108,"en":"The enormous claim for him."},{"id":"manas-2010:p0961:b001:l009","ordinal":42109,"en":"It would be shameful to let him die;"},{"id":"manas-2010:p0961:b001:l010","ordinal":42110,"en":"Kumayyk is entrusted to you!"},{"id":"manas-2010:p0961:b001:l011","ordinal":42111,"en":"If you rear Kumayyk well,"},{"id":"manas-2010:p0961:b001:l012","ordinal":42112,"en":"I shall slaughter ten thousand horses,"},{"id":"manas-2010:p0961:b001:l013","ordinal":42113,"en":"And give you the title 'My Lady.'"},{"id":"manas-2010:p0961:b001:l014","ordinal":42114,"en":"Like my cherished night,"},{"id":"manas-2010:p0961:b001:l015","ordinal":42115,"en":"Like the sun granted to my brow,"},{"id":"manas-2010:p0961:b001:l016","ordinal":42116,"en":"If Kumayyk's living presence is lost,"},{"id":"manas-2010:p0961:b001:l017","ordinal":42117,"en":"I shall turn my blessing into a curse"},{"id":"manas-2010:p0961:b001:l018","ordinal":42118,"en":"And utterly destroy your father."},{"id":"manas-2010:p0961:b001:l019","ordinal":42119,"en":"I shall allow no earth to be opened with a hoe;"},{"id":"manas-2010:p0961:b001:l020","ordinal":42120,"en":"If my Kumayyk is lost,"},{"id":"manas-2010:p0961:b001:l021","ordinal":42121,"en":"I shall allow no handful of seed to be sown."},{"id":"manas-2010:p0961:b001:l022","ordinal":42122,"en":"Here is the remarkable thing I say:"},{"id":"manas-2010:p0961:b001:l023","ordinal":42123,"en":"Beyond the means of the whole world"},{"id":"manas-2010:p0961:b001:l024","ordinal":42124,"en":"Is the compensation due for Kumayyk."},{"id":"manas-2010:p0961:b001:l025","ordinal":42125,"en":"Sixty young wives and eighty girls,"},{"id":"manas-2010:p0961:b001:l026","ordinal":42126,"en":"With Kanykey at their head,"},{"id":"manas-2010:p0961:b001:l027","ordinal":42127,"en":"Agreed to what he said."},{"id":"manas-2010:p0961:b001:l028","ordinal":42128,"en":"The gray puppy, small as a fist,"},{"id":"manas-2010:p0961:b001:l029","ordinal":42129,"en":"Your wolf-maned one called a lion"},{"id":"manas-2010:p0961:b001:l030","ordinal":42130,"en":"Now handed over as a trust."},{"id":"manas-2010:p0961:b001:l031","ordinal":42131,"en":"Taking him in her hands, she looked:"},{"id":"manas-2010:p0961:b001:l032","ordinal":42132,"en":"The gray puppy, small as a fist,"},{"id":"manas-2010:p0961:b001:l033","ordinal":42133,"en":"Without letting anyone know,"},{"id":"manas-2010:p0961:b001:l034","ordinal":42134,"en":"Without letting a single person notice,"},{"id":"manas-2010:p0961:b001:l035","ordinal":42135,"en":"She took into her own hands."},{"id":"manas-2010:p0961:b001:l036","ordinal":42136,"en":"His eyes had not yet opened;"},{"id":"manas-2010:p0961:b001:l037","ordinal":42137,"en":"Unless she watched and tended him closely,"},{"id":"manas-2010:p0961:b001:l038","ordinal":42138,"en":"That wretched Kumayyk"},{"id":"manas-2010:p0961:b001:l039","ordinal":42139,"en":"Was in danger of dying."},{"id":"manas-2010:p0961:b001:l040","ordinal":42140,"en":"Kanykey took the gray puppy;"},{"id":"manas-2010:p0961:b001:l041","ordinal":42141,"en":"God's sun in the sky grew clouded,"},{"id":"manas-2010:p0961:b001:l042","ordinal":42142,"en":"And sixty worries came upon her at once:"},{"id":"manas-2010:p0962:b001:l001","ordinal":42143,"en":"“If Kumayyk should die,"},{"id":"manas-2010:p0962:b001:l002","ordinal":42144,"en":"Will he destroy us all together?"},{"id":"manas-2010:p0962:b001:l003","ordinal":42145,"en":"Bukhara, small as a palm,"},{"id":"manas-2010:p0962:b001:l004","ordinal":42146,"en":"Will he utterly sack?"},{"id":"manas-2010:p0962:b001:l005","ordinal":42147,"en":"Making Kumayyk his excuse,"},{"id":"manas-2010:p0962:b001:l006","ordinal":42148,"en":"Will he bring punishment upon us?"},{"id":"manas-2010:p0962:b001:l007","ordinal":42149,"en":"On my father, khan of Bukhara,"},{"id":"manas-2010:p0962:b001:l008","ordinal":42150,"en":"Will he bring every trouble at once?"},{"id":"manas-2010:p0962:b001:l009","ordinal":42151,"en":"Slaughtering Bukhara,"},{"id":"manas-2010:p0962:b001:l010","ordinal":42152,"en":"Taking its girls and women as booty,"},{"id":"manas-2010:p0962:b001:l011","ordinal":42153,"en":"Will he carry them to his people?”"},{"id":"manas-2010:p0962:b001:l012","ordinal":42154,"en":"So thought Kanykey."},{"id":"manas-2010:p0962:b001:l013","ordinal":42155,"en":"She had a young mare slaughtered"},{"id":"manas-2010:p0962:b001:l014","ordinal":42156,"en":"Without letting anyone see."},{"id":"manas-2010:p0962:b001:l015","ordinal":42157,"en":"The young mare's rib fat"},{"id":"manas-2010:p0962:b001:l016","ordinal":42158,"en":"She had him suck with his tongue;"},{"id":"manas-2010:p0962:b001:l017","ordinal":42159,"en":"She fed him milk from her mouth."},{"id":"manas-2010:p0962:b001:l018","ordinal":42160,"en":"Without reclining on an elbow to rest,"},{"id":"manas-2010:p0962:b001:l019","ordinal":42161,"en":"Without snatching a moment's sleep,"},{"id":"manas-2010:p0962:b001:l020","ordinal":42162,"en":"Thus she reared the hunting hound."},{"id":"manas-2010:p0962:b001:l021","ordinal":42163,"en":"She had a steel collar fitted to his neck,"},{"id":"manas-2010:p0962:b001:l022","ordinal":42164,"en":"Had a tiger-skin covering laid upon his back,"},{"id":"manas-2010:p0962:b001:l023","ordinal":42165,"en":"Dug a pit forty rope-lengths deep,"},{"id":"manas-2010:p0962:b001:l024","ordinal":42166,"en":"And had him tethered and reared at the bottom."},{"id":"manas-2010:p0962:b001:l025","ordinal":42167,"en":"Spring came with moonless darkness;"},{"id":"manas-2010:p0962:b001:l026","ordinal":42168,"en":"Fanged creatures became his enemies."},{"id":"manas-2010:p0962:b001:l027","ordinal":42169,"en":"'Predators will steal him,' she thought,"},{"id":"manas-2010:p0962:b001:l028","ordinal":42170,"en":"'And bring him to his end.'"},{"id":"manas-2010:p0962:b001:l029","ordinal":42171,"en":"Giving a horse as a month's wages,"},{"id":"manas-2010:p0962:b001:l030","ordinal":42172,"en":"Paying promptly without stint,"},{"id":"manas-2010:p0962:b001:l031","ordinal":42173,"en":"She prepared and stationed lookouts,"},{"id":"manas-2010:p0962:b001:l032","ordinal":42174,"en":"Had strong guards posted,"},{"id":"manas-2010:p0962:b001:l033","ordinal":42175,"en":"And made them endure great hardship."},{"id":"manas-2010:p0962:b001:l034","ordinal":42176,"en":"Of the fanged creatures lying in wait"},{"id":"manas-2010:p0962:b001:l035","ordinal":42177,"en":"She had quite a number shot."},{"id":"manas-2010:p0962:b001:l036","ordinal":42178,"en":"When six months had passed,"},{"id":"manas-2010:p0962:b001:l037","ordinal":42179,"en":"The noble puppy Kumayyk"},{"id":"manas-2010:p0962:b001:l038","ordinal":42180,"en":"Reached the age to prowl."},{"id":"manas-2010:p0962:b001:l039","ordinal":42181,"en":"He proved a burning ember;"},{"id":"manas-2010:p0962:b001:l040","ordinal":42182,"en":"Among four-footed predators"},{"id":"manas-2010:p0962:b001:l041","ordinal":42183,"en":"None was so formidable."},{"id":"manas-2010:p0962:b001:l042","ordinal":42184,"en":"The steel collar upon his neck"},{"id":"manas-2010:p0963:b001:l001","ordinal":42185,"en":"He chewed apart."},{"id":"manas-2010:p0963:b001:l002","ordinal":42186,"en":"Eighty young wives and eighty girls"},{"id":"manas-2010:p0963:b001:l003","ordinal":42187,"en":"Were resting at their leisure;"},{"id":"manas-2010:p0963:b001:l004","ordinal":42188,"en":"Into the midst of the many girls,"},{"id":"manas-2010:p0963:b001:l005","ordinal":42189,"en":"As though about to slaughter them,"},{"id":"manas-2010:p0963:b001:l006","ordinal":42190,"en":"He came prowling."},{"id":"manas-2010:p0963:b001:l007","ordinal":42191,"en":"Before they could raise a shout,"},{"id":"manas-2010:p0963:b001:l008","ordinal":42192,"en":"Before they could seize his collar,"},{"id":"manas-2010:p0963:b001:l009","ordinal":42193,"en":"Into the embers of saxaul wood"},{"id":"manas-2010:p0963:b001:l010","ordinal":42194,"en":"He swept his tail."},{"id":"manas-2010:p0963:b001:l011","ordinal":42195,"en":"His tail touched the embers;"},{"id":"manas-2010:p0963:b001:l012","ordinal":42196,"en":"Three finger-widths of it burned."},{"id":"manas-2010:p0963:b001:l013","ordinal":42197,"en":"'He will inflict terrible suffering,' they thought,"},{"id":"manas-2010:p0963:b001:l014","ordinal":42198,"en":"'On Kumayyk's account"},{"id":"manas-2010:p0963:b001:l015","ordinal":42199,"en":"He will start a quarrel.'"},{"id":"manas-2010:p0963:b001:l016","ordinal":42200,"en":"Before they could rub it with fat,"},{"id":"manas-2010:p0963:b001:l017","ordinal":42201,"en":"Remove the burned part,"},{"id":"manas-2010:p0963:b001:l018","ordinal":42202,"en":"And wipe his fur clean,"},{"id":"manas-2010:p0963:b001:l019","ordinal":42203,"en":"Because of what had happened,"},{"id":"manas-2010:p0963:b001:l020","ordinal":42204,"en":"On Kumayyk's account,"},{"id":"manas-2010:p0963:b001:l021","ordinal":42205,"en":"God struck them in an extraordinary way:"},{"id":"manas-2010:p0963:b001:l022","ordinal":42206,"en":"Looking as huge as a mountain,"},{"id":"manas-2010:p0963:b001:l023","ordinal":42207,"en":"Troubling the hearts of those who saw him,"},{"id":"manas-2010:p0963:b001:l024","ordinal":42208,"en":"On Kumayyk's account"},{"id":"manas-2010:p0963:b001:l025","ordinal":42209,"en":"He arrived on his bridegroom's visit."},{"id":"manas-2010:p0963:b001:l026","ordinal":42210,"en":"Kumayyk, his tail burned,"},{"id":"manas-2010:p0963:b001:l027","ordinal":42211,"en":"Before the fiercely wrathful lord"},{"id":"manas-2010:p0963:b001:l028","ordinal":42212,"en":"Came prowling."},{"id":"manas-2010:p0963:b001:l029","ordinal":42213,"en":"When Manas saw the puppy,"},{"id":"manas-2010:p0963:b001:l030","ordinal":42214,"en":"His blood-drinking fury seized him."},{"id":"manas-2010:p0963:b001:l031","ordinal":42215,"en":"His white teeth, broad as a door,"},{"id":"manas-2010:p0963:b001:l032","ordinal":42216,"en":"Teeth unlike those of other people,"},{"id":"manas-2010:p0963:b001:l033","ordinal":42217,"en":"He ground again and again."},{"id":"manas-2010:p0963:b001:l034","ordinal":42218,"en":"“God, who strikes, has struck her!"},{"id":"manas-2010:p0963:b001:l035","ordinal":42219,"en":"The puppy I told her to rear"},{"id":"manas-2010:p0963:b001:l036","ordinal":42220,"en":"She has made a scrawny pup of him!"},{"id":"manas-2010:p0963:b001:l037","ordinal":42221,"en":"Without giving him her full attention,"},{"id":"manas-2010:p0963:b001:l038","ordinal":42222,"en":"God has struck the wretched girl!"},{"id":"manas-2010:p0963:b001:l039","ordinal":42223,"en":"Unequaled among mortals,"},{"id":"manas-2010:p0963:b001:l040","ordinal":42224,"en":"My champion she has reduced to misery!"},{"id":"manas-2010:p0963:b001:l041","ordinal":42225,"en":"She herself is still a little girl,"},{"id":"manas-2010:p0963:b001:l042","ordinal":42226,"en":"A conceited young noblewoman;"},{"id":"manas-2010:p0964:b001:l001","ordinal":42227,"en":"I see that God has struck her!"},{"id":"manas-2010:p0964:b001:l002","ordinal":42228,"en":"The puppy I said to rear"},{"id":"manas-2010:p0964:b001:l003","ordinal":42229,"en":"She has made a scrawny pup of him!"},{"id":"manas-2010:p0964:b001:l004","ordinal":42230,"en":"He took her by the hand and swung her round,"},{"id":"manas-2010:p0964:b001:l005","ordinal":42231,"en":"And kicked her under the arm."},{"id":"manas-2010:p0964:b001:l006","ordinal":42232,"en":"Before enjoying their happiness,"},{"id":"manas-2010:p0964:b001:l007","ordinal":42233,"en":"Before lying in her embrace,"},{"id":"manas-2010:p0964:b001:l008","ordinal":42234,"en":"Before gathering the learned men,"},{"id":"manas-2010:p0964:b001:l009","ordinal":42235,"en":"He seized her left hand and swung her round,"},{"id":"manas-2010:p0964:b001:l010","ordinal":42236,"en":"Kicked her under the arm,"},{"id":"manas-2010:p0964:b001:l011","ordinal":42237,"en":"And two of her ribs,"},{"id":"manas-2010:p0964:b001:l012","ordinal":42238,"en":"When the warrior's foot struck,"},{"id":"manas-2010:p0964:b001:l013","ordinal":42239,"en":"Were terribly shattered."},{"id":"manas-2010:p0964:b001:l014","ordinal":42240,"en":"The twelve pairs of ribs"}]
