[{"id":"semetey-1-2013:p0814:b004:l018","ordinal":139265,"en":"Let the worthy, rich in wisdom, come."},{"id":"semetey-1-2013:p0814:b004:l019","ordinal":139266,"en":"Let your white-turbaned khojas come,"},{"id":"semetey-1-2013:p0814:b004:l020","ordinal":139267,"en":"Let your lesson-reading mullahs come."},{"id":"semetey-1-2013:p0814:b004:l021","ordinal":139268,"en":"Let your elders, rich in wisdom, come,"},{"id":"semetey-1-2013:p0814:b004:l022","ordinal":139269,"en":"Come, all of you, young and old!"},{"id":"semetey-1-2013:p0814:b004:l023","ordinal":139270,"en":"My protector left by Manas,"},{"id":"semetey-1-2013:p0814:b004:l024","ordinal":139271,"en":"Semetey, my only fortune,"},{"id":"semetey-1-2013:p0814:b004:l025","ordinal":139272,"en":"For whom I raised a golden tent,"},{"id":"semetey-1-2013:p0814:b004:l026","ordinal":139273,"en":"My lion whom I cherished and reared!"},{"id":"semetey-1-2013:p0814:b004:l027","ordinal":139274,"en":"I saw you when you were tender;"},{"id":"semetey-1-2013:p0814:b004:l028","ordinal":139275,"en":"This child of mine, when newly born,"},{"id":"semetey-1-2013:p0814:b004:l029","ordinal":139276,"en":"I have nurtured and kept safe."},{"id":"semetey-1-2013:p0814:b004:l030","ordinal":139277,"en":"I am grateful to God:"},{"id":"semetey-1-2013:p0814:b004:l031","ordinal":139278,"en":"He has now reached twelve,"},{"id":"semetey-1-2013:p0814:b004:l032","ordinal":139279,"en":"And God has granted my desire."},{"id":"semetey-1-2013:p0814:b004:l033","ordinal":139280,"en":"He has grown mature, become a hero;"},{"id":"semetey-1-2013:p0814:b004:l034","ordinal":139281,"en":"Childhood has passed, his sense is full."},{"id":"semetey-1-2013:p0814:b004:l035","ordinal":139282,"en":"The time has come to join his people."},{"id":"semetey-1-2013:p0814:b004:l036","ordinal":139283,"en":"Twelve tail feathers, ten flight feathers—"},{"id":"semetey-1-2013:p0814:b004:l037","ordinal":139284,"en":"Consider, my people, he has matured."},{"id":"semetey-1-2013:p0814:b004:l038","ordinal":139285,"en":"He has become a khan who can maintain a court,"},{"id":"semetey-1-2013:p0814:b004:l039","ordinal":139286,"en":"A man of settled purpose."},{"id":"semetey-1-2013:p0815:b003:l001","ordinal":139287,"en":"His childhood days are gone;"},{"id":"semetey-1-2013:p0815:b003:l002","ordinal":139288,"en":"He has taken on a hero's form."},{"id":"semetey-1-2013:p0815:b003:l003","ordinal":139289,"en":"His childish foolishness is gone;"},{"id":"semetey-1-2013:p0815:b003:l004","ordinal":139290,"en":"He has grown into a hero's son."},{"id":"semetey-1-2013:p0815:b003:l005","ordinal":139291,"en":"I have hope in my child,"},{"id":"semetey-1-2013:p0815:b003:l006","ordinal":139292,"en":"That he will go and settle in Talas."},{"id":"semetey-1-2013:p0815:b003:l007","ordinal":139293,"en":"If this orphan survives,"},{"id":"semetey-1-2013:p0815:b003:l008","ordinal":139294,"en":"He will prove himself Manas's son."},{"id":"semetey-1-2013:p0815:b003:l009","ordinal":139295,"en":"I cherish hope in the child,"},{"id":"semetey-1-2013:p0815:b003:l010","ordinal":139296,"en":"That he will take after his father."},{"id":"semetey-1-2013:p0815:b003:l011","ordinal":139297,"en":"If he lives, my blessing"},{"id":"semetey-1-2013:p0815:b003:l012","ordinal":139298,"en":"To all the sorrowing people"},{"id":"semetey-1-2013:p0815:b003:l013","ordinal":139299,"en":"Will become a father."},{"id":"semetey-1-2013:p0815:b003:l014","ordinal":139300,"en":"If his life stretches long,"},{"id":"semetey-1-2013:p0815:b003:l015","ordinal":139301,"en":"He will stir up trouble in Kentan."},{"id":"semetey-1-2013:p0815:b003:l016","ordinal":139302,"en":"The heir left by Manas"},{"id":"semetey-1-2013:p0815:b003:l017","ordinal":139303,"en":"Will take vengeance for his wrongs."},{"id":"semetey-1-2013:p0815:b003:l018","ordinal":139304,"en":"Semetey standing here,"},{"id":"semetey-1-2013:p0815:b003:l019","ordinal":139305,"en":"The jeweled ornament left by Manas,"},{"id":"semetey-1-2013:p0815:b003:l020","ordinal":139306,"en":"The mirror left by the gray-maned hero—"},{"id":"semetey-1-2013:p0815:b003:l021","ordinal":139307,"en":"Mighty Bukhara, hear my words!"},{"id":"semetey-1-2013:p0815:b003:l022","ordinal":139308,"en":"Living an orphan, he has matured,"},{"id":"semetey-1-2013:p0815:b003:l023","ordinal":139309,"en":"And joined the ranks himself."},{"id":"semetey-1-2013:p0815:b003:l024","ordinal":139310,"en":"He has grown mature, become a hero,"},{"id":"semetey-1-2013:p0815:b003:l025","ordinal":139311,"en":"And stands equal to a hero's son."},{"id":"semetey-1-2013:p0815:b003:l026","ordinal":139312,"en":"Fortune has settled on his brow;"},{"id":"semetey-1-2013:p0815:b003:l027","ordinal":139313,"en":"The time for heroism has come!"},{"id":"semetey-1-2013:p0815:b003:l028","ordinal":139314,"en":"Your father's grave, you Bukharans!"},{"id":"semetey-1-2013:p0815:b003:l029","ordinal":139315,"en":"You dug my pit deep,"},{"id":"semetey-1-2013:p0815:b003:l030","ordinal":139316,"en":"Saying, ‘Your child has turned unruly,’"},{"id":"semetey-1-2013:p0815:b003:l031","ordinal":139317,"en":"You meant to boil up my misery!"},{"id":"semetey-1-2013:p0815:b003:l032","ordinal":139318,"en":"Now Semetey leaves for his people."},{"id":"semetey-1-2013:p0815:b003:l033","ordinal":139319,"en":"Come, not merely your worst, but all of you;"},{"id":"semetey-1-2013:p0815:b003:l034","ordinal":139320,"en":"Come together, all Bukhara!"},{"id":"semetey-1-2013:p0815:b003:l035","ordinal":139321,"en":"If this child leaves unmarried,"},{"id":"semetey-1-2013:p0815:b003:l036","ordinal":139322,"en":"Do not be left wailing, my people."},{"id":"semetey-1-2013:p0815:b003:l037","ordinal":139323,"en":"For the plump, pale-mottled goshawk,"},{"id":"semetey-1-2013:p0815:b003:l038","ordinal":139324,"en":"For the gray hawk, your morning star,"},{"id":"semetey-1-2013:p0815:b003:l039","ordinal":139325,"en":"Prepare his bride!"},{"id":"semetey-1-2013:p0815:b004:l001","ordinal":139326,"en":"Remember to give his share of livestock;"},{"id":"semetey-1-2013:p0815:b004:l002","ordinal":139327,"en":"He is moving to the Kyrgyz."},{"id":"semetey-1-2013:p0815:b004:l003","ordinal":139328,"en":"Give him your golden throne to sit upon!’"},{"id":"semetey-1-2013:p0815:b004:l004","ordinal":139329,"en":"While Temir Khan was speaking,"},{"id":"semetey-1-2013:p0815:b004:l005","ordinal":139330,"en":"Their faces changing, their color turning,"},{"id":"semetey-1-2013:p0815:b004:l006","ordinal":139331,"en":"The wretched people of Bukhara"},{"id":"semetey-1-2013:p0815:b004:l007","ordinal":139332,"en":"Thrust their heads toward the ground."},{"id":"semetey-1-2013:p0815:b004:l008","ordinal":139333,"en":"As though a massacre had struck them,"},{"id":"semetey-1-2013:p0815:b004:l009","ordinal":139334,"en":"Not one made the slightest sound."},{"id":"semetey-1-2013:p0815:b004:l010","ordinal":139335,"en":"All scraped at the earth in a row,"},{"id":"semetey-1-2013:p0815:b004:l011","ordinal":139336,"en":"Each with his head bent to the ground."},{"id":"semetey-1-2013:p0815:b004:l012","ordinal":139337,"en":"The white-bearded elders stared"},{"id":"semetey-1-2013:p0815:b004:l013","ordinal":139338,"en":"At the black-bearded men."},{"id":"semetey-1-2013:p0815:b004:l014","ordinal":139339,"en":"The black-bearded warriors"},{"id":"semetey-1-2013:p0815:b004:l015","ordinal":139340,"en":"Looked at the young men."},{"id":"semetey-1-2013:p0815:b004:l016","ordinal":139341,"en":"All the young men,"},{"id":"semetey-1-2013:p0815:b004:l017","ordinal":139342,"en":"As though a massacre had struck them,"},{"id":"semetey-1-2013:p0815:b004:l018","ordinal":139343,"en":"Fled away, one after another."},{"id":"semetey-1-2013:p0815:b004:l019","ordinal":139344,"en":"Bukhara's khan, Temir Khan,"},{"id":"semetey-1-2013:p0815:b004:l020","ordinal":139345,"en":"Saw that no counsel would come from these people,"},{"id":"semetey-1-2013:p0815:b004:l021","ordinal":139346,"en":"Watching now from the tower."},{"id":"semetey-1-2013:p0815:b004:l022","ordinal":139347,"en":"Jerking again and again,"},{"id":"semetey-1-2013:p0815:b004:l023","ordinal":139348,"en":"As though seized by a fit of rage,"},{"id":"semetey-1-2013:p0815:b004:l024","ordinal":139349,"en":"He shook and issued orders."},{"id":"semetey-1-2013:p0815:b004:l025","ordinal":139350,"en":"At the many people of Bukhara,"},{"id":"semetey-1-2013:p0815:b004:l026","ordinal":139351,"en":"He now grew angry."},{"id":"semetey-1-2013:p0815:b004:l027","ordinal":139352,"en":"‘Oh, people like straw stuffed in a sack,"},{"id":"semetey-1-2013:p0815:b004:l028","ordinal":139353,"en":"There is no support in a spiritless people!"},{"id":"semetey-1-2013:p0815:b004:l029","ordinal":139354,"en":"Your father's grave, you wretched people!"},{"id":"semetey-1-2013:p0815:b004:l030","ordinal":139355,"en":"If this orphan leaves without a wife,"},{"id":"semetey-1-2013:p0815:b004:l031","ordinal":139356,"en":"And should choke with pent-up anger,"},{"id":"semetey-1-2013:p0815:b004:l032","ordinal":139357,"en":"With all this gossip of yours besides,"},{"id":"semetey-1-2013:p0815:b004:l033","ordinal":139358,"en":"Will he not suddenly grow wrathful?"},{"id":"semetey-1-2013:p0815:b004:l034","ordinal":139359,"en":"If this orphan turns back,"},{"id":"semetey-1-2013:p0815:b004:l035","ordinal":139360,"en":"Will he not bring devastation,"},{"id":"semetey-1-2013:p0815:b004:l036","ordinal":139361,"en":"Will he not take vengeance far and wide?"},{"id":"semetey-1-2013:p0815:b004:l037","ordinal":139362,"en":"Will he not settle accounts with you this way?"},{"id":"semetey-1-2013:p0815:b004:l038","ordinal":139363,"en":"If this orphan runs wild,"},{"id":"semetey-1-2013:p0815:b004:l039","ordinal":139364,"en":"Will he not utterly destroy your people,"},{"id":"semetey-1-2013:p0816:b003:l001","ordinal":139365,"en":"Will he not beat your old madness out of you?"},{"id":"semetey-1-2013:p0816:b003:l002","ordinal":139366,"en":"Will he not plunder your treasury?"},{"id":"semetey-1-2013:p0816:b003:l003","ordinal":139367,"en":"If Semetey leaves without a wife,"},{"id":"semetey-1-2013:p0816:b003:l004","ordinal":139368,"en":"Will he not bring devastation?’"},{"id":"semetey-1-2013:p0816:b003:l005","ordinal":139369,"en":"Temir Khan grew angry,"},{"id":"semetey-1-2013:p0816:b003:l006","ordinal":139370,"en":"And had the reed horn sounded."},{"id":"semetey-1-2013:p0816:b003:l007","ordinal":139371,"en":"About eighty-five of his strongmen"},{"id":"semetey-1-2013:p0816:b003:l008","ordinal":139372,"en":"Made themselves ready."},{"id":"semetey-1-2013:p0816:b003:l009","ordinal":139373,"en":"He struck the people with terror,"},{"id":"semetey-1-2013:p0816:b003:l010","ordinal":139374,"en":"And made his orders harsh."},{"id":"semetey-1-2013:p0816:b003:l011","ordinal":139375,"en":"He roared in his wrath,"},{"id":"semetey-1-2013:p0816:b003:l012","ordinal":139376,"en":"And all the strongmen,"},{"id":"semetey-1-2013:p0816:b003:l013","ordinal":139377,"en":"Hurrying them, making them pant,"},{"id":"semetey-1-2013:p0816:b003:l014","ordinal":139378,"en":"He summoned: ‘Come here!’"},{"id":"semetey-1-2013:p0816:b003:l015","ordinal":139379,"en":"Temir Khan's strongmen"},{"id":"semetey-1-2013:p0816:b003:l016","ordinal":139380,"en":"Were all in haste and confusion."},{"id":"semetey-1-2013:p0816:b003:l017","ordinal":139381,"en":"The commanders of ten bobbed about;"},{"id":"semetey-1-2013:p0816:b003:l018","ordinal":139382,"en":"Commanders of fifty and a hundred"},{"id":"semetey-1-2013:p0816:b003:l019","ordinal":139383,"en":"Bustled, frightened out of their wits."},{"id":"semetey-1-2013:p0816:b003:l020","ordinal":139384,"en":"The commanders of a hundred ran,"},{"id":"semetey-1-2013:p0816:b003:l021","ordinal":139385,"en":"Greatly despairing for their lives."},{"id":"semetey-1-2013:p0816:b003:l022","ordinal":139386,"en":"When the strongmen arrived,"},{"id":"semetey-1-2013:p0816:b003:l023","ordinal":139387,"en":"Temir Khan stood and said:"},{"id":"semetey-1-2013:p0816:b003:l024","ordinal":139388,"en":"‘Strongmen, hear my words!"},{"id":"semetey-1-2013:p0816:b003:l025","ordinal":139389,"en":"Of Bukhara's twelve gates,"},{"id":"semetey-1-2013:p0816:b003:l026","ordinal":139390,"en":"Open all twelve entrances!"},{"id":"semetey-1-2013:p0816:b003:l027","ordinal":139391,"en":"Belonging to the treasury,"},{"id":"semetey-1-2013:p0816:b003:l028","ordinal":139392,"en":"I have twelve kinds of livestock."},{"id":"semetey-1-2013:p0816:b003:l029","ordinal":139393,"en":"For the one child Semetey,"},{"id":"semetey-1-2013:p0816:b003:l030","ordinal":139394,"en":"Spend them and give them away!"},{"id":"semetey-1-2013:p0816:b003:l031","ordinal":139395,"en":"In the gated royal court,"},{"id":"semetey-1-2013:p0816:b003:l032","ordinal":139396,"en":"The costly crimson cloth,"},{"id":"semetey-1-2013:p0816:b003:l033","ordinal":139397,"en":"Folded up from crimson cloth—"},{"id":"semetey-1-2013:p0816:b003:l034","ordinal":139398,"en":"Around the world's four corners,"},{"id":"semetey-1-2013:p0816:b003:l035","ordinal":139399,"en":"Sent around all four,"},{"id":"semetey-1-2013:p0816:b003:l036","ordinal":139400,"en":"They carried trading loads."},{"id":"semetey-1-2013:p0816:b003:l037","ordinal":139401,"en":"Bells as large as buckets,"},{"id":"semetey-1-2013:p0816:b003:l038","ordinal":139402,"en":"Pampering them, upon their necks"},{"id":"semetey-1-2013:p0816:b003:l039","ordinal":139403,"en":"They hung them all in great abundance."},{"id":"semetey-1-2013:p0816:b004:l001","ordinal":139404,"en":"Letting no other beast approach them,"},{"id":"semetey-1-2013:p0816:b004:l002","ordinal":139405,"en":"They reared them in the white palace."},{"id":"semetey-1-2013:p0816:b004:l003","ordinal":139406,"en":"With their fangs jutting out,"},{"id":"semetey-1-2013:p0816:b004:l004","ordinal":139407,"en":"Their lower lips hanging down,"},{"id":"semetey-1-2013:p0816:b004:l005","ordinal":139408,"en":"Their humps rising high,"},{"id":"semetey-1-2013:p0816:b004:l006","ordinal":139409,"en":"Their long hair flowing—"},{"id":"semetey-1-2013:p0816:b004:l007","ordinal":139410,"en":"Eighty red-tailed single-humped camels"},{"id":"semetey-1-2013:p0816:b004:l008","ordinal":139411,"en":"Bring to the treasury."},{"id":"semetey-1-2013:p0816:b004:l009","ordinal":139412,"en":"Of gold and silver,"},{"id":"semetey-1-2013:p0816:b004:l010","ordinal":139413,"en":"Load the gelded camels."},{"id":"semetey-1-2013:p0816:b004:l011","ordinal":139414,"en":"Agree to what I say;"},{"id":"semetey-1-2013:p0816:b004:l012","ordinal":139415,"en":"This orphan's inheritance"},{"id":"semetey-1-2013:p0816:b004:l013","ordinal":139416,"en":"Give him in this manner."},{"id":"semetey-1-2013:p0816:b004:l014","ordinal":139417,"en":"There is more I have to say;"},{"id":"semetey-1-2013:p0816:b004:l015","ordinal":139418,"en":"Once more, my people, heed my words!"},{"id":"semetey-1-2013:p0816:b004:l016","ordinal":139419,"en":"Bukhara's twelve gates—"},{"id":"semetey-1-2013:p0816:b004:l017","ordinal":139420,"en":"Set their doors open."},{"id":"semetey-1-2013:p0816:b004:l018","ordinal":139421,"en":"Five sets of nine, each headed by a mare,"},{"id":"semetey-1-2013:p0816:b004:l019","ordinal":139422,"en":"Slaughter at every entrance."},{"id":"semetey-1-2013:p0816:b004:l020","ordinal":139423,"en":"Twelve discerning judges,"},{"id":"semetey-1-2013:p0816:b004:l021","ordinal":139424,"en":"Clear-sighted men,"},{"id":"semetey-1-2013:p0816:b004:l022","ordinal":139425,"en":"Warriors who have seen much,"},{"id":"semetey-1-2013:p0816:b004:l023","ordinal":139426,"en":"Able men who know the truth,"},{"id":"semetey-1-2013:p0816:b004:l024","ordinal":139427,"en":"Worthy men of surpassing knowledge—"},{"id":"semetey-1-2013:p0816:b004:l025","ordinal":139428,"en":"Place them at each entrance."},{"id":"semetey-1-2013:p0816:b004:l026","ordinal":139429,"en":"Send word to the people:"},{"id":"semetey-1-2013:p0816:b004:l027","ordinal":139430,"en":"With thimble mouths and camel-calf eyes,"},{"id":"semetey-1-2013:p0816:b004:l028","ordinal":139431,"en":"Crimson dresses and slender waists,"},{"id":"semetey-1-2013:p0816:b004:l029","ordinal":139432,"en":"Of the graceful beauties,"},{"id":"semetey-1-2013:p0816:b004:l030","ordinal":139433,"en":"Let them be maidens, not married women;"},{"id":"semetey-1-2013:p0816:b004:l031","ordinal":139434,"en":"Let every one be truly beautiful."},{"id":"semetey-1-2013:p0816:b004:l032","ordinal":139435,"en":"With broad foreheads and dark eyes,"},{"id":"semetey-1-2013:p0816:b004:l033","ordinal":139436,"en":"Well-formed beauties with dark eyes,"},{"id":"semetey-1-2013:p0816:b004:l034","ordinal":139437,"en":"Below sixteen,"},{"id":"semetey-1-2013:p0816:b004:l035","ordinal":139438,"en":"And above ten,"},{"id":"semetey-1-2013:p0816:b004:l036","ordinal":139439,"en":"Girls between those ages—"},{"id":"semetey-1-2013:p0816:b004:l037","ordinal":139440,"en":"Gather every one of them,"},{"id":"semetey-1-2013:p0816:b004:l038","ordinal":139441,"en":"And set them filing past."},{"id":"semetey-1-2013:p0816:b004:l039","ordinal":139442,"en":"‘She is already betrothed,’"},{"id":"semetey-1-2013:p0816:b004:l040","ordinal":139443,"en":"Let no such excuse be found,"},{"id":"semetey-1-2013:p0817:b003:l001","ordinal":139444,"en":"Let them not fall into needless trouble."},{"id":"semetey-1-2013:p0817:b003:l002","ordinal":139445,"en":"Let them not evade the order."},{"id":"semetey-1-2013:p0817:b003:l003","ordinal":139446,"en":"Let the wretched people witness this,"},{"id":"semetey-1-2013:p0817:b003:l004","ordinal":139447,"en":"And not bring Judgment Day upon themselves."},{"id":"semetey-1-2013:p0817:b003:l005","ordinal":139448,"en":"Let no girl known"},{"id":"semetey-1-2013:p0817:b003:l006","ordinal":139449,"en":"And recognized among the people be left out."},{"id":"semetey-1-2013:p0817:b003:l007","ordinal":139450,"en":"No girl due to leave for bridewealth,"},{"id":"semetey-1-2013:p0817:b003:l008","ordinal":139451,"en":"No betrothed girl shall be left out!’"},{"id":"semetey-1-2013:p0817:b003:l009","ordinal":139452,"en":"After Temir Khan had shown his wrath,"},{"id":"semetey-1-2013:p0817:b003:l010","ordinal":139453,"en":"And the strongmen had heard the order,"},{"id":"semetey-1-2013:p0817:b003:l011","ordinal":139454,"en":"They demanded girls from every household,"},{"id":"semetey-1-2013:p0817:b003:l012","ordinal":139455,"en":"And gathered them, leaving none out."},{"id":"semetey-1-2013:p0817:b003:l013","ordinal":139456,"en":"Before the judges,"},{"id":"semetey-1-2013:p0817:b003:l014","ordinal":139457,"en":"They drove them in."},{"id":"semetey-1-2013:p0817:b003:l015","ordinal":139458,"en":"Girls filed this way and that;"},{"id":"semetey-1-2013:p0817:b003:l016","ordinal":139459,"en":"Bukhara was thrown into confusion."},{"id":"semetey-1-2013:p0817:b003:l017","ordinal":139460,"en":"When the fortress in Bukhara"},{"id":"semetey-1-2013:p0817:b003:l018","ordinal":139461,"en":"Was crowded with swarming girls,"},{"id":"semetey-1-2013:p0817:b003:l019","ordinal":139462,"en":"Koloy Khan of Bukhara,"},{"id":"semetey-1-2013:p0817:b003:l020","ordinal":139463,"en":"Straight-hearted and plain-spoken,"},{"id":"semetey-1-2013:p0817:b003:l021","ordinal":139464,"en":"An exceptional judge, clear-sighted—"},{"id":"semetey-1-2013:p0817:b003:l022","ordinal":139465,"en":"That Koloy whom you have seen,"},{"id":"semetey-1-2013:p0817:b003:l023","ordinal":139466,"en":"Who would break his bonds and die,"},{"id":"semetey-1-2013:p0817:b003:l024","ordinal":139467,"en":"Loved the orphan son of Manas"},{"id":"semetey-1-2013:p0817:b003:l025","ordinal":139468,"en":"With an exceptional love."},{"id":"semetey-1-2013:p0817:b003:l026","ordinal":139469,"en":"Never to spill from his palm,"},{"id":"semetey-1-2013:p0817:b003:l027","ordinal":139470,"en":"He cherished him like gathered treasure."},{"id":"semetey-1-2013:p0817:b003:l028","ordinal":139471,"en":"As the warm life within his breast,"},{"id":"semetey-1-2013:p0817:b003:l029","ordinal":139472,"en":"As his faith, he cherished him."},{"id":"semetey-1-2013:p0817:b003:l030","ordinal":139473,"en":"Bukhara's lord Koloy,"},{"id":"semetey-1-2013:p0817:b003:l031","ordinal":139474,"en":"Taking a short way through the interior,"},{"id":"semetey-1-2013:p0817:b003:l032","ordinal":139475,"en":"From among the filing girls"},{"id":"semetey-1-2013:p0817:b003:l033","ordinal":139476,"en":"Brought out one girl,"},{"id":"semetey-1-2013:p0817:b003:l034","ordinal":139477,"en":"Lord Koloy leading her by the hand."},{"id":"semetey-1-2013:p0817:b003:l035","ordinal":139478,"en":"The girl whom he led"},{"id":"semetey-1-2013:p0817:b003:l036","ordinal":139479,"en":"Was the child of a noble family,"},{"id":"semetey-1-2013:p0817:b003:l037","ordinal":139480,"en":"The daughter of Shaatemir."},{"id":"semetey-1-2013:p0817:b003:l038","ordinal":139481,"en":"She was still a young child,"},{"id":"semetey-1-2013:p0817:b003:l039","ordinal":139482,"en":"Her hair not yet long enough to braid,"},{"id":"semetey-1-2013:p0817:b003:l040","ordinal":139483,"en":"Her age not yet beyond fourteen."},{"id":"semetey-1-2013:p0817:b005:l001","ordinal":139484,"en":"On her head was a cap made of gold."},{"id":"semetey-1-2013:p0817:b005:l002","ordinal":139485,"en":"Shaatemir's Chachykei,"},{"id":"semetey-1-2013:p0817:b005:l003","ordinal":139486,"en":"An extremely beautiful, bold girl,"},{"id":"semetey-1-2013:p0817:b005:l004","ordinal":139487,"en":"Her waist a handspan, her face like the moon."},{"id":"semetey-1-2013:p0817:b005:l005","ordinal":139488,"en":"If blood should fall upon the dark earth,"},{"id":"semetey-1-2013:p0817:b005:l006","ordinal":139489,"en":"Look at snow, then at her complexion."},{"id":"semetey-1-2013:p0817:b005:l007","ordinal":139490,"en":"If blood should fall upon the snow,"},{"id":"semetey-1-2013:p0817:b005:l008","ordinal":139491,"en":"Look at that blood, then at her face."},{"id":"semetey-1-2013:p0817:b005:l009","ordinal":139492,"en":"Look at a pistachio, then at her teeth."},{"id":"semetey-1-2013:p0817:b005:l010","ordinal":139493,"en":"Look at the craftsmen's wire,"},{"id":"semetey-1-2013:p0817:b005:l011","ordinal":139494,"en":"Look at that wire, then at her hair."},{"id":"semetey-1-2013:p0817:b005:l012","ordinal":139495,"en":"Look at an apple, then at her head."},{"id":"semetey-1-2013:p0817:b005:l013","ordinal":139496,"en":"The sight diverted one's heart;"},{"id":"semetey-1-2013:p0817:b005:l014","ordinal":139497,"en":"Like the feathers of a parrot,"},{"id":"semetey-1-2013:p0817:b005:l015","ordinal":139498,"en":"She appeared in many changing hues."},{"id":"semetey-1-2013:p0817:b005:l016","ordinal":139499,"en":"Koloy had judged and chosen her."},{"id":"semetey-1-2013:p0817:b005:l017","ordinal":139500,"en":"Cutting off a head when told to take a cap,"},{"id":"semetey-1-2013:p0817:b005:l018","ordinal":139501,"en":"Temir Khan's strongman"},{"id":"semetey-1-2013:p0817:b005:l019","ordinal":139502,"en":"To the khan's golden throne"},{"id":"semetey-1-2013:p0817:b005:l020","ordinal":139503,"en":"Brought Shaatemir's daughter Chachykei,"},{"id":"semetey-1-2013:p0817:b005:l021","ordinal":139504,"en":"Taking hold of her and leading her there."},{"id":"semetey-1-2013:p0817:b005:l022","ordinal":139505,"en":"Shaatemir of Bukhara,"},{"id":"semetey-1-2013:p0817:b005:l023","ordinal":139506,"en":"Temir Khan and Koloy—these"},{"id":"semetey-1-2013:p0817:b005:l024","ordinal":139507,"en":"Were the children of brothers."},{"id":"semetey-1-2013:p0817:b005:l025","ordinal":139508,"en":"Before Temir Khan,"},{"id":"semetey-1-2013:p0817:b005:l026","ordinal":139509,"en":"Shaatemir went and made his plea:"},{"id":"semetey-1-2013:p0817:b005:l027","ordinal":139510,"en":"‘To this orphan son of Manas,"},{"id":"semetey-1-2013:p0817:b005:l028","ordinal":139511,"en":"I am glad you are giving her."},{"id":"semetey-1-2013:p0817:b005:l029","ordinal":139512,"en":"But Toltoy is her betrothed;"},{"id":"semetey-1-2013:p0817:b005:l030","ordinal":139513,"en":"Trouble will arise afterward,"},{"id":"semetey-1-2013:p0817:b005:l031","ordinal":139514,"en":"And that is why I grieve!"},{"id":"semetey-1-2013:p0817:b005:l032","ordinal":139515,"en":"When the Zhediger in Zheti-Suu"},{"id":"semetey-1-2013:p0817:b005:l033","ordinal":139516,"en":"Went forth in high spirits,"},{"id":"semetey-1-2013:p0817:b005:l034","ordinal":139517,"en":"The hero of the Zhediger,"},{"id":"semetey-1-2013:p0817:b005:l035","ordinal":139518,"en":"The accomplished Bagysh, was khan."},{"id":"semetey-1-2013:p0817:b005:l036","ordinal":139519,"en":"Beyond broad Kashgar,"},{"id":"semetey-1-2013:p0817:b005:l037","ordinal":139520,"en":"Along great Sary-Kol,"}]
