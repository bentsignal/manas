[{"id":"manas-2010:p1484:b001:l001","ordinal":64001,"en":"Thundering like the heavens;"},{"id":"manas-2010:p1484:b001:l002","ordinal":64002,"en":"Those who heard could not bear it,"},{"id":"manas-2010:p1484:b001:l003","ordinal":64003,"en":"Their whole bodies shuddered."},{"id":"manas-2010:p1484:b001:l004","ordinal":64004,"en":"The field where they charged"},{"id":"manas-2010:p1484:b001:l005","ordinal":64005,"en":"Had no furrow made by a plow,"},{"id":"manas-2010:p1484:b001:l006","ordinal":64006,"en":"No hole dug by a marmot."},{"id":"manas-2010:p1484:b001:l007","ordinal":64007,"en":"Without looking to either side,"},{"id":"manas-2010:p1484:b001:l008","ordinal":64008,"en":"The two lions charged,"},{"id":"manas-2010:p1484:b001:l009","ordinal":64009,"en":"Not sparing their fly-like lives."},{"id":"manas-2010:p1484:b001:l010","ordinal":64010,"en":"They met and thrust their lances;"},{"id":"manas-2010:p1484:b001:l011","ordinal":64011,"en":"Their horses buckled,"},{"id":"manas-2010:p1484:b001:l012","ordinal":64012,"en":"They shoved back and forth;"},{"id":"manas-2010:p1484:b001:l013","ordinal":64013,"en":"Their lances at the middle"},{"id":"manas-2010:p1484:b001:l014","ordinal":64014,"en":"Snapped clean in two."},{"id":"manas-2010:p1484:b001:l015","ordinal":64015,"en":"Seizing battle-axes,"},{"id":"manas-2010:p1484:b001:l016","ordinal":64016,"en":"They fought with them,"},{"id":"manas-2010:p1484:b001:l017","ordinal":64017,"en":"Neither letting the other strike home,"},{"id":"manas-2010:p1484:b001:l018","ordinal":64018,"en":"Parrying with the backs."},{"id":"manas-2010:p1484:b001:l019","ordinal":64019,"en":"They shifted their shields,"},{"id":"manas-2010:p1484:b001:l020","ordinal":64020,"en":"And the heroes found their openings,"},{"id":"manas-2010:p1484:b001:l021","ordinal":64021,"en":"Striking with battle-axes."},{"id":"manas-2010:p1484:b001:l022","ordinal":64022,"en":"When they came closer still,"},{"id":"manas-2010:p1484:b001:l023","ordinal":64023,"en":"They slashed with swords."},{"id":"manas-2010:p1484:b001:l024","ordinal":64024,"en":"When they came right up close,"},{"id":"manas-2010:p1484:b001:l025","ordinal":64025,"en":"They seized each other's collars,"},{"id":"manas-2010:p1484:b001:l026","ordinal":64026,"en":"Pulled from horseback,"},{"id":"manas-2010:p1484:b001:l027","ordinal":64027,"en":"Braced and wrenched,"},{"id":"manas-2010:p1484:b001:l028","ordinal":64028,"en":"Until no clothing remained on them,"},{"id":"manas-2010:p1484:b001:l029","ordinal":64029,"en":"Tearing and ripping it away."},{"id":"manas-2010:p1484:b001:l030","ordinal":64030,"en":"Baychoro, strong of arm,"},{"id":"manas-2010:p1484:b001:l031","ordinal":64031,"en":"Showed his valor:"},{"id":"manas-2010:p1484:b001:l032","ordinal":64032,"en":"The governor huge as a hut"},{"id":"manas-2010:p1484:b001:l033","ordinal":64033,"en":"He tipped headfirst from his seat,"},{"id":"manas-2010:p1484:b001:l034","ordinal":64034,"en":"Laying him across the sacred mane."},{"id":"manas-2010:p1484:b001:l035","ordinal":64035,"en":"When Kongurbay saw this,"},{"id":"manas-2010:p1484:b001:l036","ordinal":64036,"en":"His shout split stones;"},{"id":"manas-2010:p1484:b001:l037","ordinal":64037,"en":"Unable to contain his wrath,"},{"id":"manas-2010:p1484:b001:l038","ordinal":64038,"en":"“I shall torment the Burut!"},{"id":"manas-2010:p1484:b001:l039","ordinal":64039,"en":"From Baychoro's hands"},{"id":"manas-2010:p1484:b001:l040","ordinal":64040,"en":"I shall wrest him free!” he said."},{"id":"manas-2010:p1484:b001:l041","ordinal":64041,"en":"A wrestler called Zhöökülük"},{"id":"manas-2010:p1484:b001:l042","ordinal":64042,"en":"Struck his mule with the whip,"},{"id":"manas-2010:p1485:b001:l001","ordinal":64043,"en":"And reached Baychoro now."},{"id":"manas-2010:p1485:b001:l002","ordinal":64044,"en":"The brim of the black felt hat—"},{"id":"manas-2010:p1485:b001:l003","ordinal":64045,"en":"Have you heard of him,"},{"id":"manas-2010:p1485:b001:l004","ordinal":64046,"en":"Khan Manas's Syrgak,"},{"id":"manas-2010:p1485:b001:l005","ordinal":64047,"en":"Whenever others were in distress,"},{"id":"manas-2010:p1485:b001:l006","ordinal":64048,"en":"The darling who would rescue them?"},{"id":"manas-2010:p1485:b001:l007","ordinal":64049,"en":"Not letting him reach Baychoro,"},{"id":"manas-2010:p1485:b001:l008","ordinal":64050,"en":"He arrived like a bullet."},{"id":"manas-2010:p1485:b001:l009","ordinal":64051,"en":"As soon as he reached the wrestler,"},{"id":"manas-2010:p1485:b001:l010","ordinal":64052,"en":"From his mule's back"},{"id":"manas-2010:p1485:b001:l011","ordinal":64053,"en":"He drove him down with a thrust."},{"id":"manas-2010:p1485:b001:l012","ordinal":64054,"en":"“This is how one gives support!”"},{"id":"manas-2010:p1485:b001:l013","ordinal":64055,"en":"The governor who had come to duel"},{"id":"manas-2010:p1485:b001:l014","ordinal":64056,"en":"He seized by the bottom hem."},{"id":"manas-2010:p1485:b001:l015","ordinal":64057,"en":"On the blade-flat plain,"},{"id":"manas-2010:p1485:b001:l016","ordinal":64058,"en":"The fellow huge as a hut"},{"id":"manas-2010:p1485:b001:l017","ordinal":64059,"en":"He dragged like a goat carcass."},{"id":"manas-2010:p1485:b001:l018","ordinal":64060,"en":"Arkesken within its sheath,"},{"id":"manas-2010:p1485:b001:l019","ordinal":64061,"en":"Pulling it sideways, brave Syrgak"},{"id":"manas-2010:p1485:b001:l020","ordinal":64062,"en":"Drew out his sword now."},{"id":"manas-2010:p1485:b001:l021","ordinal":64063,"en":"The governor being dragged"},{"id":"manas-2010:p1485:b001:l022","ordinal":64064,"en":"He cut into separate pieces."},{"id":"manas-2010:p1485:b001:l023","ordinal":64065,"en":"When they saw these two,"},{"id":"manas-2010:p1485:b001:l024","ordinal":64066,"en":"When both alike had died,"},{"id":"manas-2010:p1485:b001:l025","ordinal":64067,"en":"Would the Chinese stand and watch?"},{"id":"manas-2010:p1485:b001:l026","ordinal":64068,"en":"Seven thousand of their governors"},{"id":"manas-2010:p1485:b001:l027","ordinal":64069,"en":"Charged and came sweeping in."},{"id":"manas-2010:p1485:b001:l028","ordinal":64070,"en":"Countless governors of their finest"},{"id":"manas-2010:p1485:b001:l029","ordinal":64071,"en":"Also came sweeping in."},{"id":"manas-2010:p1485:b001:l030","ordinal":64072,"en":"When the Chinese poured upon them,"},{"id":"manas-2010:p1485:b001:l031","ordinal":64073,"en":"How could the Muslims hold back?"},{"id":"manas-2010:p1485:b001:l032","ordinal":64074,"en":"They too swept into battle:"},{"id":"manas-2010:p1485:b001:l033","ordinal":64075,"en":"Their khans Muzburchak and Kökchö,"},{"id":"manas-2010:p1485:b001:l034","ordinal":64076,"en":"Their champions who stood prepared,"},{"id":"manas-2010:p1485:b001:l035","ordinal":64077,"en":"Their broad-chested men."},{"id":"manas-2010:p1485:b001:l036","ordinal":64078,"en":"Four thousand troops began to charge,"},{"id":"manas-2010:p1485:b001:l037","ordinal":64079,"en":"Their champions who would not turn back."},{"id":"manas-2010:p1485:b001:l038","ordinal":64080,"en":"Infidels and Muslims"},{"id":"manas-2010:p1485:b001:l039","ordinal":64081,"en":"Mingled and fought,"},{"id":"manas-2010:p1485:b001:l040","ordinal":64082,"en":"Dyed in scarlet blood,"},{"id":"manas-2010:p1485:b001:l041","ordinal":64083,"en":"Doing all the arts they knew."},{"id":"manas-2010:p1485:b001:l042","ordinal":64084,"en":"Wearing a coat of blue ribbed cloth,"},{"id":"manas-2010:p1486:b001:l001","ordinal":64085,"en":"Riding the steed Kögala,"},{"id":"manas-2010:p1486:b001:l002","ordinal":64086,"en":"Khan Baltay's Chubak,"},{"id":"manas-2010:p1486:b001:l003","ordinal":64087,"en":"Whose roar none could withstand,"},{"id":"manas-2010:p1486:b001:l004","ordinal":64088,"en":"Whose strength none could match in wrestling,"},{"id":"manas-2010:p1486:b001:l005","ordinal":64089,"en":"Entered among them, attacking."},{"id":"manas-2010:p1486:b001:l006","ordinal":64090,"en":"Azizkhan's Almambet,"},{"id":"manas-2010:p1486:b001:l007","ordinal":64091,"en":"His frail life put under strain,"},{"id":"manas-2010:p1486:b001:l008","ordinal":64092,"en":"“If they grow furious, things will go ill;"},{"id":"manas-2010:p1486:b001:l009","ordinal":64093,"en":"While Khan Manas is absent,"},{"id":"manas-2010:p1486:b001:l010","ordinal":64094,"en":"If the Chinese multitude sweeps upon us,"},{"id":"manas-2010:p1486:b001:l011","ordinal":64095,"en":"They will spare no Muslim,” he thought."},{"id":"manas-2010:p1486:b001:l012","ordinal":64096,"en":"Sarala with cowlike lean haunches"},{"id":"manas-2010:p1486:b001:l013","ordinal":64097,"en":"He sent racing, wheeling round;"},{"id":"manas-2010:p1486:b001:l014","ordinal":64098,"en":"The Manzhuu and Chinese he encountered"},{"id":"manas-2010:p1486:b001:l015","ordinal":64099,"en":"He slaughtered and shattered."},{"id":"manas-2010:p1486:b001:l016","ordinal":64100,"en":"Karykan's weather-stones"},{"id":"manas-2010:p1486:b001:l017","ordinal":64101,"en":"He took from his belt-pouch,"},{"id":"manas-2010:p1486:b001:l018","ordinal":64102,"en":"The stones that changed the weather."},{"id":"manas-2010:p1486:b001:l019","ordinal":64103,"en":"Bringing them together,"},{"id":"manas-2010:p1486:b001:l020","ordinal":64104,"en":"Into a bowl of dark water"},{"id":"manas-2010:p1486:b001:l021","ordinal":64105,"en":"He carried and placed them."},{"id":"manas-2010:p1486:b001:l022","ordinal":64106,"en":"Rattling words in Kalmyk,"},{"id":"manas-2010:p1486:b001:l023","ordinal":64107,"en":"Rumbling words in Chinese,"},{"id":"manas-2010:p1486:b001:l024","ordinal":64108,"en":"The spells that changed the weather"},{"id":"manas-2010:p1486:b001:l025","ordinal":64109,"en":"He recited, every one."},{"id":"manas-2010:p1486:b001:l026","ordinal":64110,"en":"In the opening and closing of an eye,"},{"id":"manas-2010:p1486:b001:l027","ordinal":64111,"en":"Before one could say this or that,"},{"id":"manas-2010:p1486:b001:l028","ordinal":64112,"en":"Clouds were driven from the sky,"},{"id":"manas-2010:p1486:b001:l029","ordinal":64113,"en":"Crowding the earth's surface."},{"id":"manas-2010:p1486:b001:l030","ordinal":64114,"en":"Hail fell over all the foothills;"},{"id":"manas-2010:p1486:b001:l031","ordinal":64115,"en":"Rain fell over all the lowlands."},{"id":"manas-2010:p1486:b001:l032","ordinal":64116,"en":"The moon vanished in faint gloom,"},{"id":"manas-2010:p1486:b001:l033","ordinal":64117,"en":"The sun vanished in dusk."},{"id":"manas-2010:p1486:b001:l034","ordinal":64118,"en":"Turning summer's day to winter,"},{"id":"manas-2010:p1486:b001:l035","ordinal":64119,"en":"The thinly clad Chinese"},{"id":"manas-2010:p1486:b001:l036","ordinal":64120,"en":"He made whimper like girls."},{"id":"manas-2010:p1486:b001:l037","ordinal":64121,"en":"Among the Chinese chilled by cold,"},{"id":"manas-2010:p1486:b001:l038","ordinal":64122,"en":"Almambet and Chubak together,"},{"id":"manas-2010:p1486:b001:l039","ordinal":64123,"en":"Brave Syrgak charging alongside,"},{"id":"manas-2010:p1486:b001:l040","ordinal":64124,"en":"The three entered battle."},{"id":"manas-2010:p1486:b001:l041","ordinal":64125,"en":"Through their middle, Almambet"},{"id":"manas-2010:p1486:b001:l042","ordinal":64126,"en":"Gouged a path of destruction."},{"id":"manas-2010:p1487:b001:l001","ordinal":64127,"en":"Around their edges, brave Syrgak"},{"id":"manas-2010:p1487:b001:l002","ordinal":64128,"en":"Slaughtered and felled them."},{"id":"manas-2010:p1487:b001:l003","ordinal":64129,"en":"Those who came before him,"},{"id":"manas-2010:p1487:b001:l004","ordinal":64130,"en":"Champion Chubak smashed."},{"id":"manas-2010:p1487:b001:l005","ordinal":64131,"en":"Wading through blood like water,"},{"id":"manas-2010:p1487:b001:l006","ordinal":64132,"en":"The massed Chinese and Manzhuu"},{"id":"manas-2010:p1487:b001:l007","ordinal":64133,"en":"The three keen warriors crushed."},{"id":"manas-2010:p1487:b001:l008","ordinal":64134,"en":"They slaughtered with a shout,"},{"id":"manas-2010:p1487:b001:l009","ordinal":64135,"en":"Raising the cry, “Islam!”"},{"id":"manas-2010:p1487:b001:l010","ordinal":64136,"en":"The Chinese, as many as a cow's hairs,"},{"id":"manas-2010:p1487:b001:l011","ordinal":64137,"en":"They threw into utter confusion,"},{"id":"manas-2010:p1487:b001:l012","ordinal":64138,"en":"And tore the battlefield to shreds."},{"id":"manas-2010:p1487:b001:l013","ordinal":64139,"en":"The three mighty ones slaughtered and destroyed;"},{"id":"manas-2010:p1487:b001:l014","ordinal":64140,"en":"The place of battle turned to blood,"},{"id":"manas-2010:p1487:b001:l015","ordinal":64141,"en":"Dust hid the sun."},{"id":"manas-2010:p1487:b001:l016","ordinal":64142,"en":"Behind them entered battle"},{"id":"manas-2010:p1487:b001:l017","ordinal":64143,"en":"Muzburchak, Kökchö and the forty companions,"},{"id":"manas-2010:p1487:b001:l018","ordinal":64144,"en":"With so many other heroes."},{"id":"manas-2010:p1487:b001:l019","ordinal":64145,"en":"All of them entered together,"},{"id":"manas-2010:p1487:b001:l020","ordinal":64146,"en":"Giving strength to the three keen warriors."},{"id":"manas-2010:p1487:b001:l021","ordinal":64147,"en":"The Chinese came in multitudes;"},{"id":"manas-2010:p1487:b001:l022","ordinal":64148,"en":"The Muslims, unafraid of numbers,"},{"id":"manas-2010:p1487:b001:l023","ordinal":64149,"en":"Fought them face to face."},{"id":"manas-2010:p1487:b001:l024","ordinal":64150,"en":"All the lances shattered,"},{"id":"manas-2010:p1487:b001:l025","ordinal":64151,"en":"The brave men fell,"},{"id":"manas-2010:p1487:b001:l026","ordinal":64152,"en":"Heroes reeled and collapsed,"},{"id":"manas-2010:p1487:b001:l027","ordinal":64153,"en":"Horses' backs broke;"},{"id":"manas-2010:p1487:b001:l028","ordinal":64154,"en":"Many corpses lay there."},{"id":"manas-2010:p1487:b001:l029","ordinal":64155,"en":"So many splendid steeds died,"},{"id":"manas-2010:p1487:b001:l030","ordinal":64156,"en":"Men of great valor died;"},{"id":"manas-2010:p1487:b001:l031","ordinal":64157,"en":"The dead piled up like mountains."},{"id":"manas-2010:p1487:b001:l032","ordinal":64158,"en":"The deep-rooted Chinese, the vast people,"},{"id":"manas-2010:p1487:b001:l033","ordinal":64159,"en":"Were stirred from their very foundations."},{"id":"manas-2010:p1487:b001:l034","ordinal":64160,"en":"When a thousand Chinese died,"},{"id":"manas-2010:p1487:b001:l035","ordinal":64161,"en":"Another thousand joined them."},{"id":"manas-2010:p1487:b001:l036","ordinal":64162,"en":"The sky and heavens turned over;"},{"id":"manas-2010:p1487:b001:l037","ordinal":64163,"en":"Like a mirage into the sky"},{"id":"manas-2010:p1487:b001:l038","ordinal":64164,"en":"Flew the grass twisted up from the earth."},{"id":"manas-2010:p1487:b001:l039","ordinal":64165,"en":"The open field where they fought"},{"id":"manas-2010:p1487:b001:l040","ordinal":64166,"en":"Had no hill as large as a saddle-pad,"},{"id":"manas-2010:p1487:b001:l041","ordinal":64167,"en":"No hollow that would hold an ankle-bone."},{"id":"manas-2010:p1487:b001:l042","ordinal":64168,"en":"An open plain, a sandy desert:"},{"id":"manas-2010:p1488:b001:l001","ordinal":64169,"en":"Muslims and Chinese faced each other;"},{"id":"manas-2010:p1488:b001:l002","ordinal":64170,"en":"This was where they shattered one another."},{"id":"manas-2010:p1488:b001:l003","ordinal":64171,"en":"The eye could not catch them when it looked;"},{"id":"manas-2010:p1488:b001:l004","ordinal":64172,"en":"Like tumbleweed flying,"},{"id":"manas-2010:p1488:b001:l005","ordinal":64173,"en":"Corpses lay every which way."},{"id":"manas-2010:p1488:b001:l006","ordinal":64174,"en":"Of Chinese and Kyrgyz,"},{"id":"manas-2010:p1488:b001:l007","ordinal":64175,"en":"One could not tell which was which."},{"id":"manas-2010:p1488:b001:l008","ordinal":64176,"en":"Their keen warriors swallowed blood,"},{"id":"manas-2010:p1488:b001:l009","ordinal":64177,"en":"Were dyed in scarlet blood;"},{"id":"manas-2010:p1488:b001:l010","ordinal":64178,"en":"Many heroes were destroyed."},{"id":"manas-2010:p1488:b001:l011","ordinal":64179,"en":"Both eyes gouged out,"},{"id":"manas-2010:p1488:b001:l012","ordinal":64180,"en":"All the living swallowed dust,"},{"id":"manas-2010:p1488:b001:l013","ordinal":64181,"en":"The dead lay swallowing blood."},{"id":"manas-2010:p1488:b001:l014","ordinal":64182,"en":"The warriors went on fighting,"},{"id":"manas-2010:p1488:b001:l015","ordinal":64183,"en":"Over the bodies of the dead"},{"id":"manas-2010:p1488:b001:l016","ordinal":64184,"en":"Leaping back and forth."},{"id":"manas-2010:p1488:b001:l017","ordinal":64185,"en":"All the men of valor"},{"id":"manas-2010:p1488:b001:l018","ordinal":64186,"en":"Laid whips upon their horses,"},{"id":"manas-2010:p1488:b001:l019","ordinal":64187,"en":"Made their mouths gape like pits,"},{"id":"manas-2010:p1488:b001:l020","ordinal":64188,"en":"And fought, wrenching at one another."},{"id":"manas-2010:p1488:b001:l021","ordinal":64189,"en":"Trampling corpses as though they were sand,"},{"id":"manas-2010:p1488:b001:l022","ordinal":64190,"en":"Azizkhan's Almambet"},{"id":"manas-2010:p1488:b001:l023","ordinal":64191,"en":"Had gathered his full strength"},{"id":"manas-2010:p1488:b001:l024","ordinal":64192,"en":"And fought in earnest."},{"id":"manas-2010:p1488:b001:l025","ordinal":64193,"en":"Raising the battle-cry, “Manas!”"},{"id":"manas-2010:p1488:b001:l026","ordinal":64194,"en":"Akbaltay's Chubak"},{"id":"manas-2010:p1488:b001:l027","ordinal":64195,"en":"Tore the Chinese to shreds,"},{"id":"manas-2010:p1488:b001:l028","ordinal":64196,"en":"Roaring like a lion."},{"id":"manas-2010:p1488:b001:l029","ordinal":64197,"en":"The Chinese multitude could not stand firm,"},{"id":"manas-2010:p1488:b001:l030","ordinal":64198,"en":"Could not muster strength against them;"},{"id":"manas-2010:p1488:b001:l031","ordinal":64199,"en":"They turned about and fled."},{"id":"manas-2010:p1488:b001:l032","ordinal":64200,"en":"Behind them, the three lions"},{"id":"manas-2010:p1488:b001:l033","ordinal":64201,"en":"Drove them into Beijing,"},{"id":"manas-2010:p1488:b001:l034","ordinal":64202,"en":"Scattering them like falcons."},{"id":"manas-2010:p1488:b001:l035","ordinal":64203,"en":"Through the middle, brave Chubak,"},{"id":"manas-2010:p1488:b001:l036","ordinal":64204,"en":"Who never knew death,"},{"id":"manas-2010:p1488:b001:l037","ordinal":64205,"en":"Gouged his way in."},{"id":"manas-2010:p1488:b001:l038","ordinal":64206,"en":"Their elders Muzburchak and Kökchö,"},{"id":"manas-2010:p1488:b001:l039","ordinal":64207,"en":"Sweeping upon the Chinese,"},{"id":"manas-2010:p1488:b001:l040","ordinal":64208,"en":"All the Muslims advanced."},{"id":"manas-2010:p1488:b001:l041","ordinal":64209,"en":"Alöökö's Fierce One,"},{"id":"manas-2010:p1488:b001:l042","ordinal":64210,"en":"The Chinese people's keen sovereign,"},{"id":"manas-2010:p1489:b001:l001","ordinal":64211,"en":"Was a hero with lake-deep wisdom;"},{"id":"manas-2010:p1489:b001:l002","ordinal":64212,"en":"Among Chinese, Manzhuu and Kalmyks,"},{"id":"manas-2010:p1489:b001:l003","ordinal":64213,"en":"He was the foremost lion."},{"id":"manas-2010:p1489:b001:l004","ordinal":64214,"en":"The plain where they fought"},{"id":"manas-2010:p1489:b001:l005","ordinal":64215,"en":"Stretched many days' journey."},{"id":"manas-2010:p1489:b001:l006","ordinal":64216,"en":"It lay at one far edge of Beijing,"},{"id":"manas-2010:p1489:b001:l007","ordinal":64217,"en":"Where no living soul stirred,"},{"id":"manas-2010:p1489:b001:l008","ordinal":64218,"en":"Known only to wild asses."},{"id":"manas-2010:p1489:b001:l009","ordinal":64219,"en":"The horses sank into sand,"},{"id":"manas-2010:p1489:b001:l010","ordinal":64220,"en":"The middles of saddles broke;"},{"id":"manas-2010:p1489:b001:l011","ordinal":64221,"en":"After many days of battle,"},{"id":"manas-2010:p1489:b001:l012","ordinal":64222,"en":"Many splendid steeds were exhausted,"},{"id":"manas-2010:p1489:b001:l013","ordinal":64223,"en":"So many people were weary."},{"id":"manas-2010:p1489:b001:l014","ordinal":64224,"en":"When he saw their weariness,"},{"id":"manas-2010:p1489:b001:l015","ordinal":64225,"en":"Kongurbay, who had been reckoning,"},{"id":"manas-2010:p1489:b001:l016","ordinal":64226,"en":"“They have reached the chosen place;"},{"id":"manas-2010:p1489:b001:l017","ordinal":64227,"en":"Buddha has granted my wish."},{"id":"manas-2010:p1489:b001:l018","ordinal":64228,"en":"All the Muslims"},{"id":"manas-2010:p1489:b001:l019","ordinal":64229,"en":"Have come to the place of death,” he thought."},{"id":"manas-2010:p1489:b001:l020","ordinal":64230,"en":"Calling Dagger-Hand,"},{"id":"manas-2010:p1489:b001:l021","ordinal":64231,"en":"“Take ten thousand troops with you;"},{"id":"manas-2010:p1489:b001:l022","ordinal":64232,"en":"Against Almambet and Chubak,"},{"id":"manas-2010:p1489:b001:l023","ordinal":64233,"en":"Go out before them and sweep upon them!”"},{"id":"manas-2010:p1489:b001:l024","ordinal":64234,"en":"He shouted his command."},{"id":"manas-2010:p1489:b001:l025","ordinal":64235,"en":"Let me tell you of Dagger-Hand:"},{"id":"manas-2010:p1489:b001:l026","ordinal":64236,"en":"When he reached the age of six,"},{"id":"manas-2010:p1489:b001:l027","ordinal":64237,"en":"His father and his mother"},{"id":"manas-2010:p1489:b001:l028","ordinal":64238,"en":"Had him reared apart."},{"id":"manas-2010:p1489:b001:l029","ordinal":64239,"en":"The children at six years old,"},{"id":"manas-2010:p1489:b001:l030","ordinal":64240,"en":"When they rose in the morning,"},{"id":"manas-2010:p1489:b001:l031","ordinal":64241,"en":"Were made to straighten up and wash their hands;"},{"id":"manas-2010:p1489:b001:l032","ordinal":64242,"en":"They were made to strike flour for a hundred days,"},{"id":"manas-2010:p1489:b001:l033","ordinal":64243,"en":"Made to strike sand for a hundred days."},{"id":"manas-2010:p1489:b001:l034","ordinal":64244,"en":"Such a man was called Dagger-Hand;"},{"id":"manas-2010:p1489:b001:l035","ordinal":64245,"en":"If he struck an assailant once,"},{"id":"manas-2010:p1489:b001:l036","ordinal":64246,"en":"He would split him open."},{"id":"manas-2010:p1489:b001:l037","ordinal":64247,"en":"Against Akbaltay's Chubak,"},{"id":"manas-2010:p1489:b001:l038","ordinal":64248,"en":"Six thousand troops swarmed."},{"id":"manas-2010:p1489:b001:l039","ordinal":64249,"en":"Azizkhan's Almambet,"},{"id":"manas-2010:p1489:b001:l040","ordinal":64250,"en":"Not yielding to those who swept upon him,"},{"id":"manas-2010:p1489:b001:l041","ordinal":64251,"en":"Against the hero-leopard Chubak,"},{"id":"manas-2010:p1489:b001:l042","ordinal":64252,"en":"Though they swarmed, allowed them no passage."},{"id":"manas-2010:p1490:b001:l001","ordinal":64253,"en":"For many days and many nights,"},{"id":"manas-2010:p1490:b001:l002","ordinal":64254,"en":"Almambet went on slaughtering."},{"id":"manas-2010:p1490:b001:l003","ordinal":64255,"en":"Almambet, hard at work,"},{"id":"manas-2010:p1490:b001:l004","ordinal":64256,"en":"Turned right and shot once,"}]
