[{"id":"semetey-1-2013:p0737:b005:l035","ordinal":132865,"en":"Her heart sorely troubled,"},{"id":"semetey-1-2013:p0737:b005:l036","ordinal":132866,"en":"Tears streaming from her eyes,"},{"id":"semetey-1-2013:p0737:b005:l037","ordinal":132867,"en":"‘The only child left by Manas—"},{"id":"semetey-1-2013:p0737:b005:l038","ordinal":132868,"en":"What will those six scoundrels do to him?’ she said."},{"id":"semetey-1-2013:p0737:b005:l039","ordinal":132869,"en":"She seems to suspect evil,"},{"id":"semetey-1-2013:p0738:b003:l001","ordinal":132870,"en":"Kardygach roamed the mountains."},{"id":"semetey-1-2013:p0738:b003:l002","ordinal":132871,"en":"Then Kardygach,"},{"id":"semetey-1-2013:p0738:b003:l003","ordinal":132872,"en":"Keeping out of Semetey's sight,"},{"id":"semetey-1-2013:p0738:b003:l004","ordinal":132873,"en":"The Telkurong beneath her"},{"id":"semetey-1-2013:p0738:b003:l005","ordinal":132874,"en":"Whipped on either side,"},{"id":"semetey-1-2013:p0738:b003:l006","ordinal":132875,"en":"Spurring this way and that,"},{"id":"semetey-1-2013:p0738:b003:l007","ordinal":132876,"en":"Through the land she knew,"},{"id":"semetey-1-2013:p0738:b003:l008","ordinal":132877,"en":"Along springs and streams in valleys,"},{"id":"semetey-1-2013:p0738:b003:l009","ordinal":132878,"en":"Keeping watch and scouting the road,"},{"id":"semetey-1-2013:p0738:b003:l010","ordinal":132879,"en":"Tracing tracks in anger,"},{"id":"semetey-1-2013:p0738:b003:l011","ordinal":132880,"en":"“Abyke, Kobosh, the six villains"},{"id":"semetey-1-2013:p0738:b003:l012","ordinal":132881,"en":"Will seize my orphan,” she thought."},{"id":"semetey-1-2013:p0738:b003:l013","ordinal":132882,"en":"“Some great dog may suddenly"},{"id":"semetey-1-2013:p0738:b004:l001","ordinal":132883,"en":"Make him vanish,” she thought."},{"id":"semetey-1-2013:p0738:b004:l002","ordinal":132884,"en":"“If they chance upon the orphan,"},{"id":"semetey-1-2013:p0738:b004:l003","ordinal":132885,"en":"Against those accursed, rootless kinsmen,"},{"id":"semetey-1-2013:p0738:b004:l004","ordinal":132886,"en":"I shall plunge straight in and level my spear."},{"id":"semetey-1-2013:p0738:b004:l005","ordinal":132887,"en":"Only when I have wiped them all out"},{"id":"semetey-1-2013:p0738:b004:l006","ordinal":132888,"en":"Shall I rest,” she thought."},{"id":"semetey-1-2013:p0738:b004:l007","ordinal":132889,"en":"Watching toward the field of battle,"},{"id":"semetey-1-2013:p0738:b004:l008","ordinal":132890,"en":"Until Semetey should turn back,"},{"id":"semetey-1-2013:p0738:b004:l009","ordinal":132891,"en":"Kardygach kept lookout."},{"id":"semetey-1-2013:p0738:b004:l010","ordinal":132892,"en":"Kardygach's deeds,"},{"id":"semetey-1-2013:p0738:b004:l011","ordinal":132893,"en":"Let us leave here;"},{"id":"semetey-1-2013:p0738:b004:l012","ordinal":132894,"en":"Of Bakai and Semetey,"},{"id":"semetey-1-2013:p0738:b004:l013","ordinal":132895,"en":"Let us begin the account."},{"id":"semetey-1-2013:p0738:b006:l001","ordinal":132896,"en":"Your aged uncle Bakai,"},{"id":"semetey-1-2013:p0738:b006:l002","ordinal":132897,"en":"Who teaches what is unknown,"},{"id":"semetey-1-2013:p0738:b006:l003","ordinal":132898,"en":"Is the learned one himself."},{"id":"semetey-1-2013:p0738:b006:l004","ordinal":132899,"en":"Who makes the unperceived perceived,"},{"id":"semetey-1-2013:p0738:b006:l005","ordinal":132900,"en":"Is the hawk's very dark-eyed presence."},{"id":"semetey-1-2013:p0738:b006:l006","ordinal":132901,"en":"Your uncle Bakai the Leopard,"},{"id":"semetey-1-2013:p0738:b006:l007","ordinal":132902,"en":"Without lingering, traveled on,"},{"id":"semetey-1-2013:p0738:b006:l008","ordinal":132903,"en":"Not sparing his horse, he went far."},{"id":"semetey-1-2013:p0738:b006:l009","ordinal":132904,"en":"“Kok-Zhaiyk at the head of Urbus,"},{"id":"semetey-1-2013:p0738:b006:l010","ordinal":132905,"en":"Of vile Abyke and Kobosh,"},{"id":"semetey-1-2013:p0738:b006:l011","ordinal":132906,"en":"That is the place they took for shelter."},{"id":"semetey-1-2013:p0738:b006:l012","ordinal":132907,"en":"The one who chased and scattered them all,"},{"id":"semetey-1-2013:p0738:b006:l013","ordinal":132908,"en":"I am that scourge, Bakai."},{"id":"semetey-1-2013:p0738:b006:l014","ordinal":132909,"en":"Unable to withstand my gunfire,"},{"id":"semetey-1-2013:p0738:b006:l015","ordinal":132910,"en":"Those are the people I fought with guns."},{"id":"semetey-1-2013:p0738:b006:l016","ordinal":132911,"en":"Lying on either bank,"},{"id":"semetey-1-2013:p0738:b006:l017","ordinal":132912,"en":"I, Bakai, with those dogs"},{"id":"semetey-1-2013:p0738:b006:l018","ordinal":132913,"en":"Traded shots for twelve years."},{"id":"semetey-1-2013:p0738:b006:l019","ordinal":132914,"en":"Wreaking devastation, I grew hardened."},{"id":"semetey-1-2013:p0738:b006:l020","ordinal":132915,"en":"Of Abyke's marksmen,"},{"id":"semetey-1-2013:p0738:b006:l021","ordinal":132916,"en":"I killed sixty,"},{"id":"semetey-1-2013:p0738:b007:l001","ordinal":132917,"en":"And earned the name Bloody-Neck."},{"id":"semetey-1-2013:p0738:b007:l002","ordinal":132918,"en":"Inflicting suffering as I went,"},{"id":"semetey-1-2013:p0738:b007:l003","ordinal":132919,"en":"Where was my prosperity?"},{"id":"semetey-1-2013:p0738:b007:l004","ordinal":132920,"en":"Left alone, apart from my people,"},{"id":"semetey-1-2013:p0738:b007:l005","ordinal":132921,"en":"I earned a bad name."},{"id":"semetey-1-2013:p0738:b007:l006","ordinal":132922,"en":"Listen carefully once again,"},{"id":"semetey-1-2013:p0738:b007:l007","ordinal":132923,"en":"My beloved fortress."},{"id":"semetey-1-2013:p0738:b007:l008","ordinal":132924,"en":"The forty warriors left by your father Manas—"},{"id":"semetey-1-2013:p0738:b007:l009","ordinal":132925,"en":"If you ask about them now,"},{"id":"semetey-1-2013:p0738:b007:l010","ordinal":132926,"en":"Those wicked-minded dogs and swine,"},{"id":"semetey-1-2013:p0738:b007:l011","ordinal":132927,"en":"All those rough-tempered unbelievers,"},{"id":"semetey-1-2013:p0738:b007:l012","ordinal":132928,"en":"Pressing claims in many places,"},{"id":"semetey-1-2013:p0738:b007:l013","ordinal":132929,"en":"Fighting enemies in many places,"},{"id":"semetey-1-2013:p0738:b007:l014","ordinal":132930,"en":"Those unbelievers became seasoned."},{"id":"semetey-1-2013:p0738:b007:l015","ordinal":132931,"en":"Killing heroes, cutting off heads,"},{"id":"semetey-1-2013:p0738:b007:l016","ordinal":132932,"en":"While your heroic father Manas lived,"},{"id":"semetey-1-2013:p0738:b007:l017","ordinal":132933,"en":"Those unbelievers became skilled."},{"id":"semetey-1-2013:p0738:b007:l018","ordinal":132934,"en":"Killing one-humped camels in many places,"},{"id":"semetey-1-2013:p0738:b007:l020","ordinal":132935,"en":"Killing heroes in many places,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0738:b007:l021","ordinal":132936,"en":"Those unbelievers became dependent."},{"id":"semetey-1-2013:p0739:b003:l001","ordinal":132937,"en":"Among the finest spearmen,"},{"id":"semetey-1-2013:p0739:b003:l002","ordinal":132938,"en":"There are skilled warriors too."},{"id":"semetey-1-2013:p0739:b003:l003","ordinal":132939,"en":"With wisdom like lakes and rivers,"},{"id":"semetey-1-2013:p0739:b003:l004","ordinal":132940,"en":"There are excellent warriors too."},{"id":"semetey-1-2013:p0739:b003:l005","ordinal":132941,"en":"Striking blindly across, rash in temper,"},{"id":"semetey-1-2013:p0739:b003:l006","ordinal":132942,"en":"There are blind warriors too."},{"id":"semetey-1-2013:p0739:b003:l007","ordinal":132943,"en":"With no wisdom in their breasts,"},{"id":"semetey-1-2013:p0739:b003:l008","ordinal":132944,"en":"There are blind warriors too."},{"id":"semetey-1-2013:p0739:b003:l009","ordinal":132945,"en":"Fighting when too much is said,"},{"id":"semetey-1-2013:p0739:b003:l010","ordinal":132946,"en":"There are hot-tempered warriors too."},{"id":"semetey-1-2013:p0739:b003:l011","ordinal":132947,"en":"With no sense in their heads,"},{"id":"semetey-1-2013:p0739:b003:l012","ordinal":132948,"en":"There are rude warriors too."},{"id":"semetey-1-2013:p0739:b003:l013","ordinal":132949,"en":"Going wherever they are driven,"},{"id":"semetey-1-2013:p0739:b003:l014","ordinal":132950,"en":"There are calf-like warriors too."},{"id":"semetey-1-2013:p0739:b003:l015","ordinal":132951,"en":"Loving their lives, tending only themselves,"},{"id":"semetey-1-2013:p0739:b003:l016","ordinal":132952,"en":"There are cowardly warriors too."},{"id":"semetey-1-2013:p0739:b003:l017","ordinal":132953,"en":"Without strength to squeeze a louse,"},{"id":"semetey-1-2013:p0739:b003:l018","ordinal":132954,"en":"Unable to do a hair's worth with their hands,"},{"id":"semetey-1-2013:p0739:b003:l019","ordinal":132955,"en":"There are babbling warriors too."},{"id":"semetey-1-2013:p0739:b003:l020","ordinal":132956,"en":"Tall of stature, straight of build,"},{"id":"semetey-1-2013:p0739:b003:l021","ordinal":132957,"en":"There are imposing warriors too."},{"id":"semetey-1-2013:p0739:b003:l022","ordinal":132958,"en":"Able to lift a camel,"},{"id":"semetey-1-2013:p0739:b003:l023","ordinal":132959,"en":"There are mighty wrestlers too."},{"id":"semetey-1-2013:p0739:b003:l024","ordinal":132960,"en":"Offering endless flattery,"},{"id":"semetey-1-2013:p0739:b003:l025","ordinal":132961,"en":"There are fawning warriors too."},{"id":"semetey-1-2013:p0739:b003:l026","ordinal":132962,"en":"Big-lunged and blustering,"},{"id":"semetey-1-2013:p0739:b003:l027","ordinal":132963,"en":"There are puffed-up warriors too."},{"id":"semetey-1-2013:p0739:b003:l028","ordinal":132964,"en":"Their own good fortune in the chest"},{"id":"semetey-1-2013:p0739:b003:l029","ordinal":132965,"en":"There are warriors who kick away."},{"id":"semetey-1-2013:p0739:b003:l030","ordinal":132966,"en":"Broad-jawed, broad-tongued,"},{"id":"semetey-1-2013:p0739:b003:l031","ordinal":132967,"en":"Unerring, outstanding men,"},{"id":"semetey-1-2013:p0739:b003:l032","ordinal":132968,"en":"There are eloquent warriors too."},{"id":"semetey-1-2013:p0739:b003:l033","ordinal":132969,"en":"Sharpening their dark tongues,"},{"id":"semetey-1-2013:p0739:b003:l034","ordinal":132970,"en":"Singing before the khan,"},{"id":"semetey-1-2013:p0739:b003:l035","ordinal":132971,"en":"There are excellent warriors too."},{"id":"semetey-1-2013:p0739:b003:l036","ordinal":132972,"en":"Soft-hearted, pure in intention,"},{"id":"semetey-1-2013:p0739:b003:l037","ordinal":132973,"en":"There are outstanding warriors too."},{"id":"semetey-1-2013:p0739:b003:l038","ordinal":132974,"en":"Remaining true to Manas's salt,"},{"id":"semetey-1-2013:p0739:b003:l039","ordinal":132975,"en":"There are warriors who will stay too."},{"id":"semetey-1-2013:p0739:b005:l001","ordinal":132976,"en":"Out of nowhere, upheaval"},{"id":"semetey-1-2013:p0739:b005:l002","ordinal":132977,"en":"There are warriors who will unleash."},{"id":"semetey-1-2013:p0739:b005:l003","ordinal":132978,"en":"My dear child, gained from death,"},{"id":"semetey-1-2013:p0739:b005:l004","ordinal":132979,"en":"Your five fingers are not equal."},{"id":"semetey-1-2013:p0739:b005:l005","ordinal":132980,"en":"Vile Abyke and Kobosh"},{"id":"semetey-1-2013:p0739:b005:l006","ordinal":132981,"en":"Are not men to be trusted."},{"id":"semetey-1-2013:p0739:b005:l007","ordinal":132982,"en":"Now, my orphan,"},{"id":"semetey-1-2013:p0739:b005:l008","ordinal":132983,"en":"The finest of the forty warriors,"},{"id":"semetey-1-2013:p0739:b005:l009","ordinal":132984,"en":"Their shaman who strikes with lungs,"},{"id":"semetey-1-2013:p0739:b005:l010","ordinal":132985,"en":"The best at finding arguments,"},{"id":"semetey-1-2013:p0739:b005:l011","ordinal":132986,"en":"The leader of the forty, Kyrgylchal,"},{"id":"semetey-1-2013:p0739:b005:l012","ordinal":132987,"en":"That mad old man, swollen with pride among the forty,"},{"id":"semetey-1-2013:p0739:b005:l013","ordinal":132988,"en":"In winter's bitterest forty-day cold,"},{"id":"semetey-1-2013:p0739:b005:l014","ordinal":132989,"en":"Made his old wife rise forty times."},{"id":"semetey-1-2013:p0739:b005:l015","ordinal":132990,"en":"An old lecher, potent forty times,"},{"id":"semetey-1-2013:p0739:b005:l016","ordinal":132991,"en":"Laughing outside, vile within,"},{"id":"semetey-1-2013:p0739:b005:l017","ordinal":132992,"en":"He has eyes that see differently;"},{"id":"semetey-1-2013:p0739:b005:l018","ordinal":132993,"en":"He has strange, various words."},{"id":"semetey-1-2013:p0739:b005:l019","ordinal":132994,"en":"From among the forty warriors,"},{"id":"semetey-1-2013:p0739:b005:l020","ordinal":132995,"en":"Swine Kyrgylchal will not disappear."},{"id":"semetey-1-2013:p0739:b005:l021","ordinal":132996,"en":"Until swine Kyrgylchal disappears,"},{"id":"semetey-1-2013:p0739:b005:l022","ordinal":132997,"en":"The warriors' affairs will not improve."},{"id":"semetey-1-2013:p0739:b005:l023","ordinal":132998,"en":"Kyrgyl, leader of the forty,"},{"id":"semetey-1-2013:p0739:b005:l024","ordinal":132999,"en":"That damned Kyrgyl,"},{"id":"semetey-1-2013:p0739:b005:l025","ordinal":133000,"en":"Has wrought mischief."},{"id":"semetey-1-2013:p0739:b005:l026","ordinal":133001,"en":"To your wolf-maned father Manas"},{"id":"semetey-1-2013:p0739:b005:l027","ordinal":133002,"en":"He caused much trouble."},{"id":"semetey-1-2013:p0739:b005:l028","ordinal":133003,"en":"Here is Tazbaimat of wicked conduct."},{"id":"semetey-1-2013:p0739:b005:l029","ordinal":133004,"en":"These two united,"},{"id":"semetey-1-2013:p0739:b005:l030","ordinal":133005,"en":"Speaking words that ruin a people,"},{"id":"semetey-1-2013:p0739:b005:l031","ordinal":133006,"en":"Speaking of a time of death,"},{"id":"semetey-1-2013:p0739:b005:l032","ordinal":133007,"en":"Dogging every step,"},{"id":"semetey-1-2013:p0739:b005:l033","ordinal":133008,"en":"Your mother Kanykei"},{"id":"semetey-1-2013:p0739:b005:l034","ordinal":133009,"en":"They slandered before the six villains."},{"id":"semetey-1-2013:p0739:b005:l035","ordinal":133010,"en":"They had the whole scheme worked out;"},{"id":"semetey-1-2013:p0739:b005:l036","ordinal":133011,"en":"To Temirkan's city,"},{"id":"semetey-1-2013:p0739:b005:l037","ordinal":133012,"en":"That dog drove her wandering."},{"id":"semetey-1-2013:p0739:b005:l038","ordinal":133013,"en":"To Karakan's city,"},{"id":"semetey-1-2013:p0739:b005:l039","ordinal":133014,"en":"That dog drove her in flight."},{"id":"semetey-1-2013:p0740:b003:l001","ordinal":133015,"en":"My beloved orphan,"},{"id":"semetey-1-2013:p0740:b003:l002","ordinal":133016,"en":"The strongest of the six villains,"},{"id":"semetey-1-2013:p0740:b003:l003","ordinal":133017,"en":"Dog Kobosh, they made khan."},{"id":"semetey-1-2013:p0740:b003:l004","ordinal":133018,"en":"They destroyed whoever opposed them;"},{"id":"semetey-1-2013:p0740:b003:l005","ordinal":133019,"en":"Now they camp along the ravine."},{"id":"semetey-1-2013:p0740:b003:l006","ordinal":133020,"en":"All the forty warriors"},{"id":"semetey-1-2013:p0740:b003:l007","ordinal":133021,"en":"Have grown ravenous as dogs."},{"id":"semetey-1-2013:p0740:b003:l008","ordinal":133022,"en":"My beloved orphan,"},{"id":"semetey-1-2013:p0740:b003:l009","ordinal":133023,"en":"Take heed of these words of mine."},{"id":"semetey-1-2013:p0740:b003:l010","ordinal":133024,"en":"Do not fail to listen when I tell all,"},{"id":"semetey-1-2013:p0740:b003:l011","ordinal":133025,"en":"And ruin my efforts."},{"id":"semetey-1-2013:p0740:b003:l012","ordinal":133026,"en":"Your uncle, Lord Bakai's—"},{"id":"semetey-1-2013:p0740:b003:l013","ordinal":133027,"en":"Listen well to my words,"},{"id":"semetey-1-2013:p0740:b003:l014","ordinal":133028,"en":"My high-browed shelter,"},{"id":"semetey-1-2013:p0740:b003:l015","ordinal":133029,"en":"My shelter left by Manas."},{"id":"semetey-1-2013:p0740:b003:l016","ordinal":133030,"en":"Common iron is not sharp,"},{"id":"semetey-1-2013:p0740:b003:l017","ordinal":133031,"en":"Son, dogs raised elsewhere are no people of ours."},{"id":"semetey-1-2013:p0740:b003:l018","ordinal":133032,"en":"Iron pieced together will not become sharp,"},{"id":"semetey-1-2013:p0740:b003:l019","ordinal":133033,"en":"Dogs raised as slaves will not become our people."},{"id":"semetey-1-2013:p0740:b003:l020","ordinal":133034,"en":"The cloud across the blue sky,"},{"id":"semetey-1-2013:p0740:b003:l021","ordinal":133035,"en":"Once risen high, will not disperse."},{"id":"semetey-1-2013:p0740:b003:l022","ordinal":133036,"en":"The six villains, kin of the same father,"},{"id":"semetey-1-2013:p0740:b003:l023","ordinal":133037,"en":"It seems will not settle in one camp with us."},{"id":"semetey-1-2013:p0740:b003:l024","ordinal":133038,"en":"All that silk and white cloth,"},{"id":"semetey-1-2013:p0740:b003:l025","ordinal":133039,"en":"No color fades and changes."},{"id":"semetey-1-2013:p0740:b003:l026","ordinal":133040,"en":"The six fools called kinsmen"},{"id":"semetey-1-2013:p0740:b003:l027","ordinal":133041,"en":"Show no sign of bringing prosperity."},{"id":"semetey-1-2013:p0740:b003:l028","ordinal":133042,"en":"A dark peak, a great jutting crag,"},{"id":"semetey-1-2013:p0740:b003:l029","ordinal":133043,"en":"However long it stands, will not become a hollow."},{"id":"semetey-1-2013:p0740:b003:l030","ordinal":133044,"en":"The kin you seek out willingly"},{"id":"semetey-1-2013:p0740:b003:l031","ordinal":133045,"en":"Will not value you and leave you unharmed."},{"id":"semetey-1-2013:p0740:b003:l032","ordinal":133046,"en":"The kin you seek out willingly"},{"id":"semetey-1-2013:p0740:b003:l033","ordinal":133047,"en":"Are no dogs who will know your worth."},{"id":"semetey-1-2013:p0740:b003:l034","ordinal":133048,"en":"Without grieving you,"},{"id":"semetey-1-2013:p0740:b003:l035","ordinal":133049,"en":"They are not people who will receive you."},{"id":"semetey-1-2013:p0740:b003:l036","ordinal":133050,"en":"How often have I told you before, orphan:"},{"id":"semetey-1-2013:p0740:b003:l037","ordinal":133051,"en":"This valley is no land for us;"},{"id":"semetey-1-2013:p0740:b003:l038","ordinal":133052,"en":"These six are no people of ours."},{"id":"semetey-1-2013:p0740:b003:l039","ordinal":133053,"en":"My spring of a river through the valley,"},{"id":"semetey-1-2013:p0740:b004:l001","ordinal":133054,"en":"My light, gained from death,"},{"id":"semetey-1-2013:p0740:b004:l002","ordinal":133055,"en":"The kin who cut off heads,"},{"id":"semetey-1-2013:p0740:b004:l003","ordinal":133056,"en":"We have come to see—do you understand?"},{"id":"semetey-1-2013:p0740:b004:l004","ordinal":133057,"en":"If we act clumsily, without care,"},{"id":"semetey-1-2013:p0740:b004:l005","ordinal":133058,"en":"We have come to die—do you understand?"},{"id":"semetey-1-2013:p0740:b004:l006","ordinal":133059,"en":"Your forty warriors left by your father,"},{"id":"semetey-1-2013:p0740:b004:l007","ordinal":133060,"en":"Let us learn where they are."},{"id":"semetey-1-2013:p0740:b004:l008","ordinal":133061,"en":"If they are not with the villains,"},{"id":"semetey-1-2013:p0740:b004:l009","ordinal":133062,"en":"Then let us go in.”"},{"id":"semetey-1-2013:p0740:b004:l010","ordinal":133063,"en":"So said Khan Bakai,"},{"id":"semetey-1-2013:p0740:b004:l011","ordinal":133064,"en":"Urging Kokcholok onward."},{"id":"semetey-1-2013:p0740:b004:l012","ordinal":133065,"en":"Your wolf-maned Bakai the Leopard"},{"id":"semetey-1-2013:p0740:b004:l013","ordinal":133066,"en":"Pressed toward the forty warriors."},{"id":"semetey-1-2013:p0740:b004:l014","ordinal":133067,"en":"Watching the hilly ground,"},{"id":"semetey-1-2013:p0740:b004:l015","ordinal":133068,"en":"Hiding behind hillocks, Khan Bakai,"},{"id":"semetey-1-2013:p0740:b004:l016","ordinal":133069,"en":"That noble hero, so experienced,"},{"id":"semetey-1-2013:p0740:b004:l017","ordinal":133070,"en":"Scouted and searched the land,"},{"id":"semetey-1-2013:p0740:b004:l018","ordinal":133071,"en":"Working his wisdom, pondering his thoughts."},{"id":"semetey-1-2013:p0740:b004:l019","ordinal":133072,"en":"The wise elder Bakai,"},{"id":"semetey-1-2013:p0740:b004:l020","ordinal":133073,"en":"Experienced in every task,"},{"id":"semetey-1-2013:p0740:b004:l021","ordinal":133074,"en":"A saint born clear-sighted,"},{"id":"semetey-1-2013:p0740:b004:l022","ordinal":133075,"en":"However many difficult tasks arose,"},{"id":"semetey-1-2013:p0740:b004:l023","ordinal":133076,"en":"Bakai found the way through."},{"id":"semetey-1-2013:p0740:b004:l024","ordinal":133077,"en":"In a quarrel that brought devastation,"},{"id":"semetey-1-2013:p0740:b004:l025","ordinal":133078,"en":"Bakai found the fitting words."},{"id":"semetey-1-2013:p0740:b004:l026","ordinal":133079,"en":"The stubborn one who grew obstinate,"},{"id":"semetey-1-2013:p0740:b004:l027","ordinal":133080,"en":"He knew how to force him to comply."},{"id":"semetey-1-2013:p0740:b004:l028","ordinal":133081,"en":"The fool who would not heed much advice,"},{"id":"semetey-1-2013:p0740:b004:l029","ordinal":133082,"en":"He knew how to handle him."},{"id":"semetey-1-2013:p0740:b004:l030","ordinal":133083,"en":"Your uncle Bakai brought good fortune;"},{"id":"semetey-1-2013:p0740:b004:l031","ordinal":133084,"en":"He was a lion rich in wisdom."},{"id":"semetey-1-2013:p0740:b004:l032","ordinal":133085,"en":"To see the forty warriors,"},{"id":"semetey-1-2013:p0740:b004:l033","ordinal":133086,"en":"To someone close at heart,"},{"id":"semetey-1-2013:p0740:b004:l034","ordinal":133087,"en":"To show himself and return,"},{"id":"semetey-1-2013:p0740:b004:l035","ordinal":133088,"en":"His wisdom a brimming river,"},{"id":"semetey-1-2013:p0740:b004:l036","ordinal":133089,"en":"My aged uncle Bakai"},{"id":"semetey-1-2013:p0740:b004:l037","ordinal":133090,"en":"Spurred into the hills,"},{"id":"semetey-1-2013:p0740:b004:l038","ordinal":133091,"en":"Darting onward with Kokcholok,"},{"id":"semetey-1-2013:p0740:b004:l039","ordinal":133092,"en":"Unnoticed by a single person,"},{"id":"semetey-1-2013:p0741:b003:l001","ordinal":133093,"en":"Unseen by a single soul,"},{"id":"semetey-1-2013:p0741:b003:l002","ordinal":133094,"en":"So great was his knowledge,"},{"id":"semetey-1-2013:p0741:b003:l004","ordinal":133095,"en":"“The dear child gained from death—","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0741:b003:l005","ordinal":133096,"en":"What might they do to him?”"},{"id":"semetey-1-2013:p0741:b003:l006","ordinal":133097,"en":"He went in fear—do you see?"},{"id":"semetey-1-2013:p0741:b003:l007","ordinal":133098,"en":"Of unbelieving Abyke and Kobosh,"},{"id":"semetey-1-2013:p0741:b003:l008","ordinal":133099,"en":"He went in dread—do you see?"},{"id":"semetey-1-2013:p0741:b003:l009","ordinal":133100,"en":"Following down the bank,"},{"id":"semetey-1-2013:p0741:b003:l010","ordinal":133101,"en":"Seven passes and forty hillocks,"},{"id":"semetey-1-2013:p0741:b003:l011","ordinal":133102,"en":"He searched them all without omission."},{"id":"semetey-1-2013:p0741:b003:l012","ordinal":133103,"en":"From a particular dark hill,"},{"id":"semetey-1-2013:p0741:b003:l013","ordinal":133104,"en":"When he looked from its flank,"},{"id":"semetey-1-2013:p0741:b003:l014","ordinal":133105,"en":"An unusual person appeared."},{"id":"semetey-1-2013:p0741:b003:l015","ordinal":133106,"en":"When he saw that person,"},{"id":"semetey-1-2013:p0741:b003:l016","ordinal":133107,"en":"Your wolfish uncle Bakai's"},{"id":"semetey-1-2013:p0741:b003:l017","ordinal":133108,"en":"Heart was sorely troubled."},{"id":"semetey-1-2013:p0741:b003:l018","ordinal":133109,"en":"The form and bearing,"},{"id":"semetey-1-2013:p0741:b003:l019","ordinal":133110,"en":"The appearance on horseback—"},{"id":"semetey-1-2013:p0741:b003:l020","ordinal":133111,"en":"It was one of the forty warriors."},{"id":"semetey-1-2013:p0741:b003:l021","ordinal":133112,"en":"Seeing this, mighty Bakai"},{"id":"semetey-1-2013:p0741:b003:l022","ordinal":133113,"en":"Looked from the ridges."},{"id":"semetey-1-2013:p0741:b003:l023","ordinal":133114,"en":"It did not look like Kyrgylchal."},{"id":"semetey-1-2013:p0741:b003:l024","ordinal":133115,"en":"When he looked from the front,"},{"id":"semetey-1-2013:p0741:b003:l025","ordinal":133116,"en":"It did not look like Baichoro."},{"id":"semetey-1-2013:p0741:b003:l026","ordinal":133117,"en":"When he watched the way he rode,"},{"id":"semetey-1-2013:p0741:b003:l027","ordinal":133118,"en":"It did not look like Tazbaimat."},{"id":"semetey-1-2013:p0741:b003:l028","ordinal":133119,"en":"Drawing very near, Khan Bakai,"},{"id":"semetey-1-2013:p0741:b003:l029","ordinal":133120,"en":"When valiant Bakai looked,"}]
