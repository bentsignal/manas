[{"id":"semetey-2-2013:p1124:b004:l034","ordinal":273153,"en":"It will bring you shame."},{"id":"semetey-2-2013:p1124:b004:l035","ordinal":273154,"en":"Brave Kyyaz of the Jediger"},{"id":"semetey-2-2013:p1124:b004:l036","ordinal":273155,"en":"Is not nobler-born than you;"},{"id":"semetey-2-2013:p1124:b004:l037","ordinal":273156,"en":"Look, hero, his courage is no greater than yours."},{"id":"semetey-2-2013:p1124:b004:l038","ordinal":273157,"en":"Roar and drive in your spear;"},{"id":"semetey-2-2013:p1124:b004:l039","ordinal":273158,"en":"You are the heroic lion Choro—"},{"id":"semetey-2-2013:p1125:b003:l001","ordinal":273159,"en":"From wrathful Kyyaz’s hand"},{"id":"semetey-2-2013:p1125:b003:l002","ordinal":273160,"en":"Deliver us.”"},{"id":"semetey-2-2013:p1125:b003:l003","ordinal":273161,"en":"So Kadyrbay"},{"id":"semetey-2-2013:p1125:b003:l004","ordinal":273162,"en":"Sharpened his eloquent tongue"},{"id":"semetey-2-2013:p1125:b003:l005","ordinal":273163,"en":"And poured out his heartfelt speech."},{"id":"semetey-2-2013:p1125:b003:l006","ordinal":273164,"en":"Finding Kadyrbay’s words just,"},{"id":"semetey-2-2013:p1125:b003:l007","ordinal":273165,"en":"The army clamored and raised an uproar."},{"id":"semetey-2-2013:p1125:b003:l008","ordinal":273166,"en":"If only they had found a way,"},{"id":"semetey-2-2013:p1125:b003:l009","ordinal":273167,"en":"The distressed people, surging in anger,"},{"id":"semetey-2-2013:p1125:b003:l010","ordinal":273168,"en":"Would have attacked Kyyaz themselves."},{"id":"semetey-2-2013:p1125:b003:l011","ordinal":273169,"en":"They crossed a ridge"},{"id":"semetey-2-2013:p1125:b003:l012","ordinal":273170,"en":"Shaped like the back of a saddle;"},{"id":"semetey-2-2013:p1125:b003:l013","ordinal":273171,"en":"Many who could find no other way"},{"id":"semetey-2-2013:p1125:b003:l014","ordinal":273172,"en":"Fled and reached that place."},{"id":"semetey-2-2013:p1125:b003:l015","ordinal":273173,"en":"Escaping, they went to Kyyaz"},{"id":"semetey-2-2013:p1125:b003:l016","ordinal":273174,"en":"And brought him the news."},{"id":"semetey-2-2013:p1125:b003:l017","ordinal":273175,"en":"After thrusting their spears in fury,"},{"id":"semetey-2-2013:p1125:b003:l018","ordinal":273176,"en":"The Jediger, for the time it takes meat to cook,"},{"id":"semetey-2-2013:p1125:b003:l019","ordinal":273177,"en":"Were left unable to speak,"},{"id":"semetey-2-2013:p1125:b003:l020","ordinal":273178,"en":"Grieving in distress."},{"id":"semetey-2-2013:p1125:b003:l021","ordinal":273179,"en":"Many men led by Tölöbay—"},{"id":"semetey-2-2013:p1125:b003:l022","ordinal":273180,"en":"Tölöbay, son of Tölök,"},{"id":"semetey-2-2013:p1125:b003:l023","ordinal":273181,"en":"And Kadyrbay, son of Kalcha—"},{"id":"semetey-2-2013:p1125:b003:l024","ordinal":273182,"en":"Men skilled upon the field of combat,"},{"id":"semetey-2-2013:p1125:b003:l025","ordinal":273183,"en":"Broad-mouthed and high-browed,"},{"id":"semetey-2-2013:p1125:b003:l026","ordinal":273184,"en":"Eloquent men who gladdened the soul,"},{"id":"semetey-2-2013:p1125:b003:l027","ordinal":273185,"en":"Capable men hurrying in alarm—"},{"id":"semetey-2-2013:p1125:b003:l028","ordinal":273186,"en":"Before brave Kyyaz"},{"id":"semetey-2-2013:p1125:b003:l029","ordinal":273187,"en":"Those strong men fled in dismay."},{"id":"semetey-2-2013:p1125:b003:l030","ordinal":273188,"en":"The people rushed about in panic and turmoil;"},{"id":"semetey-2-2013:p1125:b003:l031","ordinal":273189,"en":"Before brave Kyyaz"},{"id":"semetey-2-2013:p1125:b003:l032","ordinal":273190,"en":"They went and began to speak:"},{"id":"semetey-2-2013:p1125:b003:l033","ordinal":273191,"en":"“Here, take your spear!” they said."},{"id":"semetey-2-2013:p1125:b003:l034","ordinal":273192,"en":"Amid the people’s clamor, they cast"},{"id":"semetey-2-2013:p1125:b003:l035","ordinal":273193,"en":"His spear before brave Kyyaz."},{"id":"semetey-2-2013:p1125:b003:l036","ordinal":273194,"en":"Kadyrbay, son of Kalcha,"},{"id":"semetey-2-2013:p1125:b003:l037","ordinal":273195,"en":"Spoke fully and held nothing back:"},{"id":"semetey-2-2013:p1125:b003:l038","ordinal":273196,"en":"“Jeti-Suu is the land where you dwell;"},{"id":"semetey-2-2013:p1125:b003:l039","ordinal":273197,"en":"From Jeti-Suu you raised an army,"},{"id":"semetey-2-2013:p1125:b004:l001","ordinal":273198,"en":"A vast host that shook the earth."},{"id":"semetey-2-2013:p1125:b004:l002","ordinal":273199,"en":"You enlisted grim-hearted champions,"},{"id":"semetey-2-2013:p1125:b004:l003","ordinal":273200,"en":"Warriors who never retreat."},{"id":"semetey-2-2013:p1125:b004:l004","ordinal":273201,"en":"It seems we came to endure"},{"id":"semetey-2-2013:p1125:b004:l005","ordinal":273202,"en":"Great turmoil and terrible calamity;"},{"id":"semetey-2-2013:p1125:b004:l006","ordinal":273203,"en":"It seems we came to die"},{"id":"semetey-2-2013:p1125:b004:l007","ordinal":273204,"en":"At the hands of the bloodthirsty lion himself."},{"id":"semetey-2-2013:p1125:b004:l008","ordinal":273205,"en":"Assailing one blessed by Kydyr,"},{"id":"semetey-2-2013:p1125:b004:l009","ordinal":273206,"en":"We became needlessly entangled in slaughter;"},{"id":"semetey-2-2013:p1125:b004:l010","ordinal":273207,"en":"Assailing a lion-hearted champion,"},{"id":"semetey-2-2013:p1125:b004:l011","ordinal":273208,"en":"We became needlessly entangled with death."},{"id":"semetey-2-2013:p1125:b004:l012","ordinal":273209,"en":"It seems we came to witness"},{"id":"semetey-2-2013:p1125:b004:l013","ordinal":273210,"en":"Unbounded turmoil and great calamity."},{"id":"semetey-2-2013:p1125:b004:l014","ordinal":273211,"en":"I put my trust in Kanchoro,"},{"id":"semetey-2-2013:p1125:b004:l015","ordinal":273212,"en":"But your Kanchoro is a runaway slave;"},{"id":"semetey-2-2013:p1125:b004:l016","ordinal":273213,"en":"It seems we came today to die"},{"id":"semetey-2-2013:p1125:b004:l017","ordinal":273214,"en":"At the hands of the bloodthirsty lion."},{"id":"semetey-2-2013:p1125:b004:l018","ordinal":273215,"en":"Understand well the worth of peace."},{"id":"semetey-2-2013:p1125:b004:l019","ordinal":273216,"en":"You who rule Jeti-Suu,"},{"id":"semetey-2-2013:p1125:b004:l020","ordinal":273217,"en":"Who would surrender your comrade to no one"},{"id":"semetey-2-2013:p1125:b004:l021","ordinal":273218,"en":"And never yielded weeping before an enemy—"},{"id":"semetey-2-2013:p1125:b004:l022","ordinal":273219,"en":"You were a panther; remember that."},{"id":"semetey-2-2013:p1125:b004:l023","ordinal":273220,"en":"Ill-fated Kyyaz, heed my words."},{"id":"semetey-2-2013:p1125:b004:l024","ordinal":273221,"en":"The army has gone mad and seethes;"},{"id":"semetey-2-2013:p1125:b004:l025","ordinal":273222,"en":"The people clamor and the nation is in turmoil."},{"id":"semetey-2-2013:p1125:b004:l026","ordinal":273223,"en":"He has come to have them gathered;"},{"id":"semetey-2-2013:p1125:b004:l027","ordinal":273224,"en":"That fawning madman has come"},{"id":"semetey-2-2013:p1125:b004:l028","ordinal":273225,"en":"To have every one of these people"},{"id":"semetey-2-2013:p1125:b004:l029","ordinal":273226,"en":"Slaughtered."},{"id":"semetey-2-2013:p1125:b004:l030","ordinal":273227,"en":"Külchoro is a bullet already fired;"},{"id":"semetey-2-2013:p1125:b004:l031","ordinal":273228,"en":"Your boastful ally Kanchoro"},{"id":"semetey-2-2013:p1125:b004:l032","ordinal":273229,"en":"Has no gift for diplomacy."},{"id":"semetey-2-2013:p1125:b004:l033","ordinal":273230,"en":"Let us select countless swift steeds"},{"id":"semetey-2-2013:p1125:b004:l034","ordinal":273231,"en":"And offer them to the bloodthirsty hero."},{"id":"semetey-2-2013:p1125:b004:l035","ordinal":273232,"en":"Let the Jediger cease their frenzy,"},{"id":"semetey-2-2013:p1125:b004:l036","ordinal":273233,"en":"And return without a massacre."},{"id":"semetey-2-2013:p1125:b004:l037","ordinal":273234,"en":"If Külchoro comes surging in fury,"},{"id":"semetey-2-2013:p1125:b004:l038","ordinal":273235,"en":"He will do whatever he pleases."},{"id":"semetey-2-2013:p1125:b004:l039","ordinal":273236,"en":"If Semetey grows wrathful,"},{"id":"semetey-2-2013:p1126:b003:l001","ordinal":273237,"en":"He will slaughter every last person."},{"id":"semetey-2-2013:p1126:b003:l002","ordinal":273238,"en":"Külchoro would reap their midst"},{"id":"semetey-2-2013:p1126:b003:l003","ordinal":273239,"en":"As though cutting grain with a sickle."},{"id":"semetey-2-2013:p1126:b003:l004","ordinal":273240,"en":"Not merely the Jediger, but the whole world—"},{"id":"semetey-2-2013:p1126:b003:l005","ordinal":273241,"en":"Not merely the Kyrgyz, but all mankind,"},{"id":"semetey-2-2013:p1126:b003:l006","ordinal":273242,"en":"Not merely mankind, but Rome itself—"},{"id":"semetey-2-2013:p1126:b003:l007","ordinal":273243,"en":"If the gray-maned hero rose in wrath,"},{"id":"semetey-2-2013:p1126:b003:l008","ordinal":273244,"en":"He would swallow them all, leaving none."},{"id":"semetey-2-2013:p1126:b003:l009","ordinal":273245,"en":"If angered, he could chew up"},{"id":"semetey-2-2013:p1126:b003:l010","ordinal":273246,"en":"The old men and spit them out."},{"id":"semetey-2-2013:p1126:b003:l011","ordinal":273247,"en":"Hero, this panther Semetey"},{"id":"semetey-2-2013:p1126:b003:l012","ordinal":273248,"en":"Could devour all the Jediger;"},{"id":"semetey-2-2013:p1126:b003:l013","ordinal":273249,"en":"His brow seems broad enough to bar the sky,"},{"id":"semetey-2-2013:p1126:b003:l014","ordinal":273250,"en":"As though he could swallow all he sees."},{"id":"semetey-2-2013:p1126:b003:l015","ordinal":273251,"en":"His silhouette is like a cliff with an overhanging crest,"},{"id":"semetey-2-2013:p1126:b003:l016","ordinal":273252,"en":"His strength like tempered blue steel."},{"id":"semetey-2-2013:p1126:b003:l017","ordinal":273253,"en":"He seems able to devour whoever strikes at him;"},{"id":"semetey-2-2013:p1126:b003:l018","ordinal":273254,"en":"Every limb is like a tiger’s,"},{"id":"semetey-2-2013:p1126:b003:l019","ordinal":273255,"en":"And none who grapples with him survives."},{"id":"semetey-2-2013:p1126:b003:l020","ordinal":273256,"en":"I climbed a ridge and braced myself,"},{"id":"semetey-2-2013:p1126:b003:l021","ordinal":273257,"en":"And saw the champion’s figure"},{"id":"semetey-2-2013:p1126:b003:l022","ordinal":273258,"en":"Towering like a lofty snow-white mountain."},{"id":"semetey-2-2013:p1126:b003:l023","ordinal":273259,"en":"That gray-maned hero’s valor"},{"id":"semetey-2-2013:p1126:b003:l024","ordinal":273260,"en":"Is found in no other man."},{"id":"semetey-2-2013:p1126:b003:l025","ordinal":273261,"en":"I searched, but that formidable man’s courage"},{"id":"semetey-2-2013:p1126:b003:l026","ordinal":273262,"en":"Is found nowhere among the people."},{"id":"semetey-2-2013:p1126:b003:l027","ordinal":273263,"en":"Ah, the valor of that noble-hearted lord!"},{"id":"semetey-2-2013:p1126:b003:l028","ordinal":273264,"en":"Born for these Kyrgyz,"},{"id":"semetey-2-2013:p1126:b003:l029","ordinal":273265,"en":"He is a fortress of tempered blue steel."},{"id":"semetey-2-2013:p1126:b003:l030","ordinal":273266,"en":"Against the infidel hordes like black beetles,"},{"id":"semetey-2-2013:p1126:b003:l031","ordinal":273267,"en":"It was fitting that he slaughter their people"},{"id":"semetey-2-2013:p1126:b003:l032","ordinal":273268,"en":"And opened the road through Beijing."},{"id":"semetey-2-2013:p1126:b003:l033","ordinal":273269,"en":"Through Chinmachin and Kakan"},{"id":"semetey-2-2013:p1126:b003:l034","ordinal":273270,"en":"It was fitting that he opened a road;"},{"id":"semetey-2-2013:p1126:b003:l035","ordinal":273271,"en":"Slaughtering their frenzied Kalmak champions"},{"id":"semetey-2-2013:p1126:b003:l036","ordinal":273272,"en":"And destroying their warriors,"},{"id":"semetey-2-2013:p1126:b003:l037","ordinal":273273,"en":"It was fitting that he went there;"},{"id":"semetey-2-2013:p1126:b003:l038","ordinal":273274,"en":"It was fitting that he brought"},{"id":"semetey-2-2013:p1126:b003:l039","ordinal":273275,"en":"A murderous battle upon the Chinese."},{"id":"semetey-2-2013:p1126:b004:l001","ordinal":273276,"en":"From terrible disaster and calamity"},{"id":"semetey-2-2013:p1126:b004:l002","ordinal":273277,"en":"He truly delivered"},{"id":"semetey-2-2013:p1126:b004:l003","ordinal":273278,"en":"The Kyrgyz people."},{"id":"semetey-2-2013:p1126:b004:l004","ordinal":273279,"en":"I saw Semetey"},{"id":"semetey-2-2013:p1126:b004:l005","ordinal":273280,"en":"And lost my wits and senses;"},{"id":"semetey-2-2013:p1126:b004:l006","ordinal":273281,"en":"Unable to find a way, I panicked—"},{"id":"semetey-2-2013:p1126:b004:l007","ordinal":273282,"en":"My body trembling and my senses gone,"},{"id":"semetey-2-2013:p1126:b004:l008","ordinal":273283,"en":"I fled to you, brave Kyyaz."},{"id":"semetey-2-2013:p1126:b004:l009","ordinal":273284,"en":"I saw Semetey:"},{"id":"semetey-2-2013:p1126:b004:l010","ordinal":273285,"en":"High-eared and handsome of face."},{"id":"semetey-2-2013:p1126:b004:l011","ordinal":273286,"en":"If you catch word of that black-fated killer,"},{"id":"semetey-2-2013:p1126:b004:l012","ordinal":273287,"en":"Flee far away."},{"id":"semetey-2-2013:p1126:b004:l013","ordinal":273288,"en":"Like a ravenous lion or tiger,"},{"id":"semetey-2-2013:p1126:b004:l014","ordinal":273289,"en":"He is a man poised to seize his prey;"},{"id":"semetey-2-2013:p1126:b004:l015","ordinal":273290,"en":"Like a true tusked boar,"},{"id":"semetey-2-2013:p1126:b004:l016","ordinal":273291,"en":"He is a warrior poised to strike."},{"id":"semetey-2-2013:p1126:b004:l017","ordinal":273292,"en":"Born for the whole wide world,"},{"id":"semetey-2-2013:p1126:b004:l018","ordinal":273293,"en":"He appears like the constellation Ülkör;"},{"id":"semetey-2-2013:p1126:b004:l019","ordinal":273294,"en":"He seems like the pillar"},{"id":"semetey-2-2013:p1126:b004:l020","ordinal":273295,"en":"That props up the sky."},{"id":"semetey-2-2013:p1126:b004:l021","ordinal":273296,"en":"When you see that formidable man,"},{"id":"semetey-2-2013:p1126:b004:l022","ordinal":273297,"en":"Your heart is torn apart."},{"id":"semetey-2-2013:p1126:b004:l023","ordinal":273298,"en":"He seems like the unstoppable"},{"id":"semetey-2-2013:p1126:b004:l024","ordinal":273299,"en":"Tempest of the whole wide world."},{"id":"semetey-2-2013:p1126:b004:l025","ordinal":273300,"en":"When stirred, he can make the world heave;"},{"id":"semetey-2-2013:p1126:b004:l026","ordinal":273301,"en":"To the vast multitudes of Kyrgyz,"},{"id":"semetey-2-2013:p1126:b004:l027","ordinal":273302,"en":"To the flourishing Kyrgyz nation,"},{"id":"semetey-2-2013:p1126:b004:l028","ordinal":273303,"en":"He seems a father."},{"id":"semetey-2-2013:p1126:b004:l029","ordinal":273304,"en":"He is the dark, watchful eye"},{"id":"semetey-2-2013:p1126:b004:l030","ordinal":273305,"en":"Of all courageous champions;"},{"id":"semetey-2-2013:p1126:b004:l031","ordinal":273306,"en":"He is the very lion"},{"id":"semetey-2-2013:p1126:b004:l032","ordinal":273307,"en":"Who leads the nation and guards the people."},{"id":"semetey-2-2013:p1126:b004:l033","ordinal":273308,"en":"No living soul can face his wrath;"},{"id":"semetey-2-2013:p1126:b004:l034","ordinal":273309,"en":"Of those who grapple with the hero"},{"id":"semetey-2-2013:p1126:b004:l035","ordinal":273310,"en":"Who protects his people, none remains alive."},{"id":"semetey-2-2013:p1126:b004:l036","ordinal":273311,"en":"With one ear standing high,"},{"id":"semetey-2-2013:p1126:b004:l037","ordinal":273312,"en":"As if guarding a valley like a ridge,"},{"id":"semetey-2-2013:p1126:b004:l038","ordinal":273313,"en":"He could drain anyone who fought him"},{"id":"semetey-2-2013:p1126:b004:l039","ordinal":273314,"en":"More readily than he would crush a fly."},{"id":"semetey-2-2013:p1127:b003:l001","ordinal":273315,"en":"I saw the message of the murderer"},{"id":"semetey-2-2013:p1127:b003:l002","ordinal":273316,"en":"The nose is like a whole mountain"},{"id":"semetey-2-2013:p1127:b003:l003","ordinal":273317,"en":"Like swallowing a bubble,"},{"id":"semetey-2-2013:p1127:b003:l004","ordinal":273318,"en":"The head is like a mountain,"},{"id":"semetey-2-2013:p1127:b003:l005","ordinal":273319,"en":"Let's get started"},{"id":"semetey-2-2013:p1127:b003:l006","ordinal":273320,"en":"Just like eating."},{"id":"semetey-2-2013:p1127:b003:l007","ordinal":273321,"en":"A soul appeared under it"},{"id":"semetey-2-2013:p1127:b003:l008","ordinal":273322,"en":"The cause of death:"},{"id":"semetey-2-2013:p1127:b003:l009","ordinal":273323,"en":"There are six thousand types of men"},{"id":"semetey-2-2013:p1127:b003:l010","ordinal":273324,"en":"I look back"},{"id":"semetey-2-2013:p1127:b003:l011","ordinal":273325,"en":"Sixty thousand citizens"},{"id":"semetey-2-2013:p1127:b003:l012","ordinal":273326,"en":"Piers of white blue sky"},{"id":"semetey-2-2013:p1127:b003:l013","ordinal":273327,"en":"As if reaching the bottom,"},{"id":"semetey-2-2013:p1127:b003:l014","ordinal":273328,"en":"Aiza was stretching"},{"id":"semetey-2-2013:p1127:b003:l015","ordinal":273329,"en":"Now it's like drinking"},{"id":"semetey-2-2013:p1127:b003:l016","ordinal":273330,"en":"Black streak"},{"id":"semetey-2-2013:p1127:b003:l017","ordinal":273331,"en":"Lying on the side"},{"id":"semetey-2-2013:p1127:b003:l018","ordinal":273332,"en":"He stood like a mule,"},{"id":"semetey-2-2013:p1127:b003:l019","ordinal":273333,"en":"He saw the bottom and rested."},{"id":"semetey-2-2013:p1127:b003:l020","ordinal":273334,"en":"There are six thousand types of wrestlers,"},{"id":"semetey-2-2013:p1127:b003:l021","ordinal":273335,"en":"He saw the bottom and came out alive."},{"id":"semetey-2-2013:p1127:b003:l022","ordinal":273336,"en":"Now a devourer"},{"id":"semetey-2-2013:p1127:b003:l023","ordinal":273337,"en":"There is a type of dragon."},{"id":"semetey-2-2013:p1127:b003:l024","ordinal":273338,"en":"Beren faced the lion,"},{"id":"semetey-2-2013:p1127:b003:l025","ordinal":273339,"en":"Let's get to the grave"},{"id":"semetey-2-2013:p1127:b003:l026","ordinal":273340,"en":"Jurgun Kiyaz, let's go."},{"id":"semetey-2-2013:p1127:b003:l027","ordinal":273341,"en":"Separated from the crowd,"},{"id":"semetey-2-2013:p1127:b003:l028","ordinal":273342,"en":"Let's not be a part,"},{"id":"semetey-2-2013:p1127:b003:l029","ordinal":273343,"en":"The population is running and dying."},{"id":"semetey-2-2013:p1127:b003:l030","ordinal":273344,"en":"Let's not die."},{"id":"semetey-2-2013:p1127:b003:l031","ordinal":273345,"en":"Do not watch the carnage with interest"},{"id":"semetey-2-2013:p1127:b003:l032","ordinal":273346,"en":"Do not grow mustaches,"},{"id":"semetey-2-2013:p1127:b003:l033","ordinal":273347,"en":"Our Kyrgyz head,"},{"id":"semetey-2-2013:p1127:b003:l034","ordinal":273348,"en":"Does not die for nothing from China?"},{"id":"semetey-2-2013:p1127:b003:l035","ordinal":273349,"en":"Hiding in the darkness,"},{"id":"semetey-2-2013:p1127:b003:l036","ordinal":273350,"en":"Encountered by an evil ghost,"},{"id":"semetey-2-2013:p1127:b003:l037","ordinal":273351,"en":"Let's not die badly?"},{"id":"semetey-2-2013:p1127:b003:l038","ordinal":273352,"en":"Black blood came from the lungs,"},{"id":"semetey-2-2013:p1127:b003:l039","ordinal":273353,"en":"Shivering in a hurry,"},{"id":"semetey-2-2013:p1127:b004:l001","ordinal":273354,"en":"Hissing from the tumult,"},{"id":"semetey-2-2013:p1127:b004:l002","ordinal":273355,"en":"Let's not die badly?"},{"id":"semetey-2-2013:p1127:b004:l003","ordinal":273356,"en":"Jaketai made us slaves."},{"id":"semetey-2-2013:p1127:b004:l004","ordinal":273357,"en":"Death has come and gone,"},{"id":"semetey-2-2013:p1127:b004:l005","ordinal":273358,"en":"Black blood came out of my throat,"},{"id":"semetey-2-2013:p1127:b004:l006","ordinal":273359,"en":"Before dying,"},{"id":"semetey-2-2013:p1127:b004:l007","ordinal":273360,"en":"Ride like carnage,"},{"id":"semetey-2-2013:p1127:b004:l008","ordinal":273361,"en":"Shame is gone,"},{"id":"semetey-2-2013:p1127:b004:l009","ordinal":273362,"en":"Chama is ti