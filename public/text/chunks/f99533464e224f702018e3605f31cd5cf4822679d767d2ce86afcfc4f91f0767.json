[{"id":"manas-2010:p0214:b001:l013","ordinal":9473,"en":"To wage battle in earnest,"},{"id":"manas-2010:p0214:b001:l014","ordinal":9474,"en":"Khan Zholoy braced himself;"},{"id":"manas-2010:p0214:b001:l015","ordinal":9475,"en":"To wage true battle against Manas,"},{"id":"manas-2010:p0214:b001:l016","ordinal":9476,"en":"That pig, may his house burn,"},{"id":"manas-2010:p0214:b001:l017","ordinal":9477,"en":"Had drawn himself up grimly."},{"id":"manas-2010:p0214:b001:l018","ordinal":9478,"en":"Not sparing his fly-like life,"},{"id":"manas-2010:p0214:b001:l019","ordinal":9479,"en":"He had braced himself."},{"id":"manas-2010:p0214:b001:l020","ordinal":9480,"en":"‘This bloodthirsty one has raised turmoil"},{"id":"manas-2010:p0214:b001:l021","ordinal":9481,"en":"In this land of Altai."},{"id":"manas-2010:p0214:b001:l022","ordinal":9482,"en":"The bastard has brought slaughter"},{"id":"manas-2010:p0214:b001:l023","ordinal":9483,"en":"Upon my Black Kalmyk people."},{"id":"manas-2010:p0214:b001:l024","ordinal":9484,"en":"When I went to Beijing,"},{"id":"manas-2010:p0214:b001:l025","ordinal":9485,"en":"There was no soul to hold him back."},{"id":"manas-2010:p0214:b001:l026","ordinal":9486,"en":"The Black Kalmyks were silenced;"},{"id":"manas-2010:p0214:b001:l027","ordinal":9487,"en":"Their champions who came to challenge him"},{"id":"manas-2010:p0214:b001:l028","ordinal":9488,"en":"Were slaughtered, not one left."},{"id":"manas-2010:p0214:b001:l029","ordinal":9489,"en":"This bastard Burut's"},{"id":"manas-2010:p0214:b001:l030","ordinal":9490,"en":"Tread raised dust;"},{"id":"manas-2010:p0214:b001:l031","ordinal":9491,"en":"His voice took lives."},{"id":"manas-2010:p0214:b001:l032","ordinal":9492,"en":"The seer's eyes were blinded;"},{"id":"manas-2010:p0214:b001:l033","ordinal":9493,"en":"Born here in Altai,"},{"id":"manas-2010:p0214:b001:l034","ordinal":9494,"en":"This bastard Burut"},{"id":"manas-2010:p0214:b001:l035","ordinal":9495,"en":"Meant to raise uproar."},{"id":"manas-2010:p0214:b001:l036","ordinal":9496,"en":"From Esenkan's presence"},{"id":"manas-2010:p0214:b001:l037","ordinal":9497,"en":"We came, a great army."},{"id":"manas-2010:p0214:b001:l038","ordinal":9498,"en":"He made a terrible spectacle;"},{"id":"manas-2010:p0214:b001:l039","ordinal":9499,"en":"Countless multitudes, many champions,"},{"id":"manas-2010:p0214:b001:l040","ordinal":9500,"en":"We lost to one Burut."},{"id":"manas-2010:p0214:b001:l041","ordinal":9501,"en":"How shall I look upon the khan's face?"},{"id":"manas-2010:p0214:b001:l042","ordinal":9502,"en":"If I have the strength, let me clash;"},{"id":"manas-2010:p0214:b001:l043","ordinal":9503,"en":"Against this bastard Burut,"},{"id":"manas-2010:p0214:b001:l044","ordinal":9504,"en":"Let me try a battle.’"},{"id":"manas-2010:p0214:b001:l045","ordinal":9505,"en":"Thus Khan Zholoy spoke."},{"id":"manas-2010:p0214:b001:l046","ordinal":9506,"en":"That Manas was bloodthirsty,"},{"id":"manas-2010:p0214:b001:l047","ordinal":9507,"en":"He had now seen it."},{"id":"manas-2010:p0214:b001:l048","ordinal":9508,"en":"The champions full of strength,"},{"id":"manas-2010:p0215:b001:l001","ordinal":9509,"en":"He had singled them out."},{"id":"manas-2010:p0215:b001:l002","ordinal":9510,"en":"His saddle flaps fluttered;"},{"id":"manas-2010:p0215:b001:l003","ordinal":9511,"en":"Behind him his hair tuft"},{"id":"manas-2010:p0215:b001:l004","ordinal":9512,"en":"Swayed like a hand mallet."},{"id":"manas-2010:p0215:b001:l005","ordinal":9513,"en":"Achbuudan beneath him,"},{"id":"manas-2010:p0215:b001:l006","ordinal":9514,"en":"When he whipped him on either side,"},{"id":"manas-2010:p0215:b001:l007","ordinal":9515,"en":"The ground he trod shattered."},{"id":"manas-2010:p0215:b001:l008","ordinal":9516,"en":"Clods as large as great cauldrons"},{"id":"manas-2010:p0215:b001:l009","ordinal":9517,"en":"Whistled overhead."},{"id":"manas-2010:p0215:b001:l010","ordinal":9518,"en":"When he lunged, the black earth"},{"id":"manas-2010:p0215:b001:l011","ordinal":9519,"en":"Split apart layer by layer."},{"id":"manas-2010:p0215:b001:l012","ordinal":9520,"en":"This horse, may he burn to death,"},{"id":"manas-2010:p0215:b001:l013","ordinal":9521,"en":"Showed the bearing of a tulpar."},{"id":"manas-2010:p0215:b001:l014","ordinal":9522,"en":"The black-steel bit"},{"id":"manas-2010:p0215:b001:l015","ordinal":9523,"en":"Clattered in his throat."},{"id":"manas-2010:p0215:b001:l016","ordinal":9524,"en":"Great hooves like traveling huts"},{"id":"manas-2010:p0215:b001:l017","ordinal":9525,"en":"Crashed upon the ground when he thrust them out."},{"id":"manas-2010:p0215:b001:l018","ordinal":9526,"en":"Without looking all around,"},{"id":"manas-2010:p0215:b001:l019","ordinal":9527,"en":"Without sparing his life at all,"},{"id":"manas-2010:p0215:b001:l020","ordinal":9528,"en":"The wrathful hero Zholoy"},{"id":"manas-2010:p0215:b001:l021","ordinal":9529,"en":"Had no beard and no mustache."},{"id":"manas-2010:p0215:b001:l022","ordinal":9530,"en":"His strength was extraordinary;"},{"id":"manas-2010:p0215:b001:l023","ordinal":9531,"en":"Zholoy, who smelled of blood,"},{"id":"manas-2010:p0215:b001:l024","ordinal":9532,"en":"His valor was considerable."},{"id":"manas-2010:p0215:b001:l025","ordinal":9533,"en":"This Zholoy beyond all measure,"},{"id":"manas-2010:p0215:b001:l026","ordinal":9534,"en":"Who killed and was never sated with blood,"},{"id":"manas-2010:p0215:b001:l027","ordinal":9535,"en":"He was one of the life takers;"},{"id":"manas-2010:p0215:b001:l028","ordinal":9536,"en":"He was the very ogre."},{"id":"manas-2010:p0215:b001:l029","ordinal":9537,"en":"He had hardened through drinking blood."},{"id":"manas-2010:p0215:b001:l030","ordinal":9538,"en":"Full of wrath, fierce in menace,"},{"id":"manas-2010:p0215:b001:l031","ordinal":9539,"en":"Abandon hope with this unbeliever."},{"id":"manas-2010:p0215:b001:l032","ordinal":9540,"en":"The hair on his crown bristled;"},{"id":"manas-2010:p0215:b001:l033","ordinal":9541,"en":"He hunched as if about to devour."},{"id":"manas-2010:p0215:b001:l034","ordinal":9542,"en":"His chest like a charging boar's,"},{"id":"manas-2010:p0215:b001:l035","ordinal":9543,"en":"His eyes like a seizing bear's,"},{"id":"manas-2010:p0215:b001:l036","ordinal":9544,"en":"Those who saw him were troubled."},{"id":"manas-2010:p0215:b001:l037","ordinal":9545,"en":"The spear he thrust with a shout"},{"id":"manas-2010:p0215:b001:l038","ordinal":9546,"en":"Appeared like a pine tree."},{"id":"manas-2010:p0215:b001:l039","ordinal":9547,"en":"Those who saw him were troubled."},{"id":"manas-2010:p0215:b001:l040","ordinal":9548,"en":"A cast-iron mace head like a traveling hut"},{"id":"manas-2010:p0215:b001:l041","ordinal":9549,"en":"Hung by a loop around his wrist."},{"id":"manas-2010:p0215:b001:l042","ordinal":9550,"en":"Open your eyes if you see Zholoy!"},{"id":"manas-2010:p0215:b001:l043","ordinal":9551,"en":"A steel-bladed battle-axe,"},{"id":"manas-2010:p0215:b001:l044","ordinal":9552,"en":"Of Zholoy beyond all measure,"},{"id":"manas-2010:p0215:b001:l045","ordinal":9553,"en":"Hung in this hand of his."},{"id":"manas-2010:p0215:b001:l046","ordinal":9554,"en":"Do not ask of Zholoy's condition."},{"id":"manas-2010:p0215:b001:l047","ordinal":9555,"en":"When he breathed, his nose,"},{"id":"manas-2010:p0215:b001:l048","ordinal":9556,"en":"The nostrils of his nose,"},{"id":"manas-2010:p0216:b001:l001","ordinal":9557,"en":"Were like hollows in a ridged mountain."},{"id":"manas-2010:p0216:b001:l002","ordinal":9558,"en":"On a single cheek of that pig,"},{"id":"manas-2010:p0216:b001:l003","ordinal":9559,"en":"Twelve Sibe and forty Manchus"},{"id":"manas-2010:p0216:b001:l004","ordinal":9560,"en":"Could have played ordo."},{"id":"manas-2010:p0216:b001:l005","ordinal":9561,"en":"The corners of his two eyes"},{"id":"manas-2010:p0216:b001:l006","ordinal":9562,"en":"Were like the rims of gray hills."},{"id":"manas-2010:p0216:b001:l007","ordinal":9563,"en":"If you looked at one eye,"},{"id":"manas-2010:p0216:b001:l008","ordinal":9564,"en":"It was like a whole lake full of frogs."},{"id":"manas-2010:p0216:b001:l009","ordinal":9565,"en":"This wrathful unbeliever"},{"id":"manas-2010:p0216:b001:l010","ordinal":9566,"en":"Could simply swallow anyone who fought him."},{"id":"manas-2010:p0216:b001:l011","ordinal":9567,"en":"His brows were like a burned forest;"},{"id":"manas-2010:p0216:b001:l012","ordinal":9568,"en":"His drooping lips"},{"id":"manas-2010:p0216:b001:l013","ordinal":9569,"en":"Were like a horse herder's rawhide shoes."},{"id":"manas-2010:p0216:b001:l014","ordinal":9570,"en":"This Zholoy, may he burn to death,"},{"id":"manas-2010:p0216:b001:l015","ordinal":9571,"en":"Was mighty in valor, fierce in menace."},{"id":"manas-2010:p0216:b001:l016","ordinal":9572,"en":"Before this, in combat,"},{"id":"manas-2010:p0216:b001:l017","ordinal":9573,"en":"He had laid many flat."},{"id":"manas-2010:p0216:b001:l018","ordinal":9574,"en":"Before, on this side of Kap-Too,"},{"id":"manas-2010:p0216:b001:l019","ordinal":9575,"en":"Among the people of Sazangshang,"},{"id":"manas-2010:p0216:b001:l020","ordinal":9576,"en":"When the sun rose, those people"},{"id":"manas-2010:p0216:b001:l021","ordinal":9577,"en":"Spread across the fields like livestock."},{"id":"manas-2010:p0216:b001:l022","ordinal":9578,"en":"When the sun sank toward evening,"},{"id":"manas-2010:p0216:b001:l023","ordinal":9579,"en":"Wherever there was a burrow or a hollow,"},{"id":"manas-2010:p0216:b001:l024","ordinal":9580,"en":"They made ready to lie down together."},{"id":"manas-2010:p0216:b001:l025","ordinal":9581,"en":"Their khan Madykan,"},{"id":"manas-2010:p0216:b001:l026","ordinal":9582,"en":"With Mamytbek, the two khans,"},{"id":"manas-2010:p0216:b001:l027","ordinal":9583,"en":"Making ready to joust,"},{"id":"manas-2010:p0216:b001:l028","ordinal":9584,"en":"Was it not Zholoy who went there?"},{"id":"manas-2010:p0216:b001:l029","ordinal":9585,"en":"Calamity upon those people,"},{"id":"manas-2010:p0216:b001:l030","ordinal":9586,"en":"Was it not Zholoy who brought it?"},{"id":"manas-2010:p0216:b001:l031","ordinal":9587,"en":"Fighting for sixty days,"},{"id":"manas-2010:p0216:b001:l032","ordinal":9588,"en":"Was it not Zholoy who remained?"},{"id":"manas-2010:p0216:b001:l033","ordinal":9589,"en":"Madykan on his blue-gray bull,"},{"id":"manas-2010:p0216:b001:l034","ordinal":9590,"en":"Mamytbek on his gray mule,"},{"id":"manas-2010:p0216:b001:l035","ordinal":9591,"en":"Binding both alike,"},{"id":"manas-2010:p0216:b001:l036","ordinal":9592,"en":"Was it not Zholoy who took them?"},{"id":"manas-2010:p0216:b001:l037","ordinal":9593,"en":"‘Zholoy is a champion,’ they said;"},{"id":"manas-2010:p0216:b001:l038","ordinal":9594,"en":"His name became known among the people."},{"id":"manas-2010:p0216:b001:l039","ordinal":9595,"en":"In the mighty hero Esenkan's"},{"id":"manas-2010:p0216:b001:l040","ordinal":9596,"en":"Register it was written."},{"id":"manas-2010:p0216:b001:l041","ordinal":9597,"en":"Upon that champion Zholoy's"},{"id":"manas-2010:p0216:b001:l042","ordinal":9598,"en":"Neck they had hung a Chinese lumpu."},{"id":"manas-2010:p0216:b001:l043","ordinal":9599,"en":"In puds, gold and red gold thread,"},{"id":"manas-2010:p0216:b001:l044","ordinal":9600,"en":"From Esenkan's treasury,"},{"id":"manas-2010:p0216:b001:l045","ordinal":9601,"en":"They had poured it out in expenditure."},{"id":"manas-2010:p0216:b001:l046","ordinal":9602,"en":"He was maintained from the treasury."},{"id":"manas-2010:p0216:b001:l047","ordinal":9603,"en":"He was favored beyond others;"},{"id":"manas-2010:p0216:b001:l048","ordinal":9604,"en":"Do not ask of Zholoy's condition,"},{"id":"manas-2010:p0217:b001:l001","ordinal":9605,"en":"The champion who came from Beijing."},{"id":"manas-2010:p0217:b001:l002","ordinal":9606,"en":"Grimly ready for battle,"},{"id":"manas-2010:p0217:b001:l003","ordinal":9607,"en":"His Zholoy, steaming with anger,"},{"id":"manas-2010:p0217:b001:l004","ordinal":9608,"en":"Girded on a pud’s weight of iron."},{"id":"manas-2010:p0217:b001:l005","ordinal":9609,"en":"With a Russian-leather saddlecloth and narrow waist,"},{"id":"manas-2010:p0217:b001:l006","ordinal":9610,"en":"The steaming hero Zholoy,"},{"id":"manas-2010:p0217:b001:l007","ordinal":9611,"en":"Achbuudan beneath him,"},{"id":"manas-2010:p0217:b001:l008","ordinal":9612,"en":"His dust billowing like a mountain,"},{"id":"manas-2010:p0217:b001:l009","ordinal":9613,"en":"Had come out for single combat."},{"id":"manas-2010:p0217:b001:l010","ordinal":9614,"en":"Under the unbeliever's wrath,"},{"id":"manas-2010:p0217:b001:l011","ordinal":9615,"en":"The earth had bent."},{"id":"manas-2010:p0217:b001:l012","ordinal":9616,"en":"His black hair, like a hand mallet,"},{"id":"manas-2010:p0217:b001:l013","ordinal":9617,"en":"Swayed behind him."},{"id":"manas-2010:p0217:b001:l014","ordinal":9618,"en":"His saddle flaps fluttered."},{"id":"manas-2010:p0217:b001:l015","ordinal":9619,"en":"The blue-gray battlefield, the stone terrace—"},{"id":"manas-2010:p0217:b001:l016","ordinal":9620,"en":"He now came onto the field."},{"id":"manas-2010:p0217:b001:l017","ordinal":9621,"en":"Valiant Manas the leopard"},{"id":"manas-2010:p0217:b001:l018","ordinal":9622,"en":"Faced him and drew close."},{"id":"manas-2010:p0217:b001:l019","ordinal":9623,"en":"The dear lion of surpassing fortune,"},{"id":"manas-2010:p0217:b001:l020","ordinal":9624,"en":"Manas the lion went behind his shield."},{"id":"manas-2010:p0217:b001:l021","ordinal":9625,"en":"Shrill shouts and harsh encouragement,"},{"id":"manas-2010:p0217:b001:l022","ordinal":9626,"en":"Manas the lion entered the uproar."},{"id":"manas-2010:p0217:b001:l023","ordinal":9627,"en":"A great uproar that would not subside,"},{"id":"manas-2010:p0217:b001:l024","ordinal":9628,"en":"Manas the lion entered it."},{"id":"manas-2010:p0217:b001:l025","ordinal":9629,"en":"Kydyr by name, the forty chiltens,"},{"id":"manas-2010:p0217:b001:l026","ordinal":9630,"en":"Were the generous hero's companions."},{"id":"manas-2010:p0217:b001:l027","ordinal":9631,"en":"Forty children from forty households"},{"id":"manas-2010:p0217:b001:l028","ordinal":9632,"en":"Were Khan Manas's peers."},{"id":"manas-2010:p0217:b001:l029","ordinal":9633,"en":"Alas, with the hero Manas,"},{"id":"manas-2010:p0217:b001:l030","ordinal":9634,"en":"The companions he had gathered."},{"id":"manas-2010:p0217:b001:l031","ordinal":9635,"en":"Companions sharing one meal,"},{"id":"manas-2010:p0217:b001:l032","ordinal":9636,"en":"Their sheep sharing one enclosure,"},{"id":"manas-2010:p0217:b001:l033","ordinal":9637,"en":"Sharing death, sharing faith,"},{"id":"manas-2010:p0217:b001:l034","ordinal":9638,"en":"Gathered together in this world,"},{"id":"manas-2010:p0217:b001:l035","ordinal":9639,"en":"When they entered a joust, sharing spears,"},{"id":"manas-2010:p0217:b001:l036","ordinal":9640,"en":"When they took spoils, sharing the gain."},{"id":"manas-2010:p0217:b001:l037","ordinal":9641,"en":"The forty children, serving as support,"},{"id":"manas-2010:p0217:b001:l038","ordinal":9642,"en":"Watched the spectacle from the ridge."},{"id":"manas-2010:p0217:b001:l039","ordinal":9643,"en":"Your valiant, wolf-maned Manas"},{"id":"manas-2010:p0217:b001:l040","ordinal":9644,"en":"Attacked the hero Zholoy,"},{"id":"manas-2010:p0217:b001:l041","ordinal":9645,"en":"Struck Toruchaar once on the thigh,"},{"id":"manas-2010:p0217:b001:l042","ordinal":9646,"en":"Took his lacquered spear in hand."},{"id":"manas-2010:p0217:b001:l043","ordinal":9647,"en":"Zholoy, as great as a mountain,"},{"id":"manas-2010:p0217:b001:l044","ordinal":9648,"en":"He faced him in attack."},{"id":"manas-2010:p0217:b001:l045","ordinal":9649,"en":"When Manas drew near,"},{"id":"manas-2010:p0217:b001:l046","ordinal":9650,"en":"Then Zholoy said this:"},{"id":"manas-2010:p0217:b001:l047","ordinal":9651,"en":"‘Turn your horse's head awhile."},{"id":"manas-2010:p0217:b001:l048","ordinal":9652,"en":"Do not rush about, you Burut;"},{"id":"manas-2010:p0218:b001:l001","ordinal":9653,"en":"Stand awhile in the place ahead!"},{"id":"manas-2010:p0218:b001:l002","ordinal":9654,"en":"When they cry “Manas, Manas,”"},{"id":"manas-2010:p0218:b001:l003","ordinal":9655,"en":"You yourself have reached twelve,"},{"id":"manas-2010:p0218:b001:l004","ordinal":9656,"en":"Yet you loom and bluster."},{"id":"manas-2010:p0218:b001:l005","ordinal":9657,"en":"You have courage but no sense;"},{"id":"manas-2010:p0218:b001:l006","ordinal":9658,"en":"You care about nothing."},{"id":"manas-2010:p0218:b001:l007","ordinal":9659,"en":"Like a wineskin put in water,"},{"id":"manas-2010:p0218:b001:l008","ordinal":9660,"en":"You swell and strut."},{"id":"manas-2010:p0218:b001:l009","ordinal":9661,"en":"You were born in this Altai;"},{"id":"manas-2010:p0218:b001:l010","ordinal":9662,"en":"Your navel touched this place."},{"id":"manas-2010:p0218:b001:l011","ordinal":9663,"en":"Where is your humanity?"},{"id":"manas-2010:p0218:b001:l012","ordinal":9664,"en":"Obey what I say, Manas."},{"id":"manas-2010:p0218:b001:l013","ordinal":9665,"en":"If you truly are a Burut,"},{"id":"manas-2010:p0218:b001:l014","ordinal":9666,"en":"Give me my turn, Manas."},{"id":"manas-2010:p0218:b001:l015","ordinal":9667,"en":"I was the renowned hero Zholoy."},{"id":"manas-2010:p0218:b001:l016","ordinal":9668,"en":"A Burut child is no khan."},{"id":"manas-2010:p0218:b001:l017","ordinal":9669,"en":"The eighteen thousand worlds,"},{"id":"manas-2010:p0218:b001:l018","ordinal":9670,"en":"I was Zholoy who took them."},{"id":"manas-2010:p0218:b001:l019","ordinal":9671,"en":"Let us stand alone against each other;"},{"id":"manas-2010:p0218:b001:l020","ordinal":9672,"en":"Let us joust in single combat."},{"id":"manas-2010:p0218:b001:l021","ordinal":9673,"en":"A noble deed fitting for a hero,"},{"id":"manas-2010:p0218:b001:l022","ordinal":9674,"en":"Let us face each other alone.’"},{"id":"manas-2010:p0218:b001:l023","ordinal":9675,"en":"To what Zholoy said,"},{"id":"manas-2010:p0218:b001:l024","ordinal":9676,"en":"Noble Manas now agreed."},{"id":"manas-2010:p0218:b001:l025","ordinal":9677,"en":"The full-grown Khan Manas,"},{"id":"manas-2010:p0218:b001:l026","ordinal":9678,"en":"The leopard like a mountain,"},{"id":"manas-2010:p0218:b001:l027","ordinal":9679,"en":"Agreed to what he said."},{"id":"manas-2010:p0218:b001:l028","ordinal":9680,"en":"What he wanted was his turn;"},{"id":"manas-2010:p0218:b001:l029","ordinal":9681,"en":"Manas now gave him his turn:"},{"id":"manas-2010:p0218:b001:l030","ordinal":9682,"en":"‘Thrust your spear without mercy, Zholoy."},{"id":"manas-2010:p0218:b001:l031","ordinal":9683,"en":"If you hold back at all,"},{"id":"manas-2010:p0218:b001:l032","ordinal":9684,"en":"Then take your own mother, Zholoy!"},{"id":"manas-2010:p0218:b001:l033","ordinal":9685,"en":"Put forth all your strength, Zholoy;"},{"id":"manas-2010:p0218:b001:l034","ordinal":9686,"en":"Spear me down, Zholoy."},{"id":"manas-2010:p0218:b001:l035","ordinal":9687,"en":"If you cannot throw me down, my Zholoy,"},{"id":"manas-2010:p0218:b001:l036","ordinal":9688,"en":"A swift stroke will fall."},{"id":"manas-2010:p0218:b001:l037","ordinal":9689,"en":"Take heed, hero Zholoy;"},{"id":"manas-2010:p0218:b001:l038","ordinal":9690,"en":"Baltay will strike your head."},{"id":"manas-2010:p0218:b001:l039","ordinal":9691,"en":"I have begun annihilation smoothly."},{"id":"manas-2010:p0218:b001:l040","ordinal":9692,"en":"Here, Zholoy, hear my words:"},{"id":"manas-2010:p0218:b001:l041","ordinal":9693,"en":"I have slaughtered your champions!"},{"id":"manas-2010:p0218:b001:l042","ordinal":9694,"en":"If you are mighty, strain yourself."},{"id":"manas-2010:p0218:b001:l043","ordinal":9695,"en":"I scouted your ford and made a road."},{"id":"manas-2010:p0218:b001:l044","ordinal":9696,"en":"Hear these words of mine:"},{"id":"manas-2010:p0218:b001:l045","ordinal":9697,"en":"I castrated and humiliated your monks."},{"id":"manas-2010:p0218:b001:l046","ordinal":9698,"en":"Of your horses you mounted the swiftest."},{"id":"manas-2010:p0218:b001:l047","ordinal":9699,"en":"When my father Karakan died,"},{"id":"manas-2010:p0218:b001:l048","ordinal":9700,"en":"When the people gathered and buried him,"},{"id":"manas-2010:p0219:b001:l001","ordinal":9701,"en":"You took my livestock as spoils,"},{"id":"manas-2010:p0219:b001:l002","ordinal":9702,"en":"Slaughtering all I had."},{"id":"manas-2010:p0219:b001:l003","ordinal":9703,"en":"You broke my back;"},{"id":"manas-2010:p0219:b001:l004","ordinal":9704,"en":"You smashed and drove away"},{"id":"manas-2010:p0219:b001:l005","ordinal":9705,"en":"My greedy Kyrgyz people."},{"id":"manas-2010:p0219:b001:l006","ordinal":9706,"en":"Now I was born impetuous and have grown."},{"id":"manas-2010:p0219:b001:l007","ordinal":9707,"en":"Now I will strike your migrating camp at the ford."},{"id":"manas-2010:p0219:b001:l008","ordinal":9708,"en":"My stately Kalmyk,"},{"id":"manas-2010:p0219:b001:l009","ordinal":9709,"en":"Now I will take my revenge on you!"},{"id":"manas-2010:p0219:b001:l010","ordinal":9710,"en":"I will face and slaughter your giants."},{"id":"manas-2010:p0219:b001:l011","ordinal":9711,"en":"If I have the strength, I will smash,"},{"id":"manas-2010:p0219:b001:l012","ordinal":9712,"en":"My Zholoy, your brains."},{"id":"manas-2010:p0219:b001:l013","ordinal":9713,"en":"You have rolled up your sleeves and come out"},{"id":"manas-2010:p0219:b001:l014","ordinal":9714,"en":"From the kakan's city."},{"id":"manas-2010:p0219:b001:l015","ordinal":9715,"en":"If I seize and slaughter you,"},{"id":"manas-2010:p0219:b001:l016","ordinal":9716,"en":"Your blood will be finer than all."},{"id":"manas-2010:p0219:b001:l017","ordinal":9717,"en":"I will raise three turmoils at once."},{"id":"manas-2010:p0219:b001:l018","ordinal":9718,"en":"Not only your horses, clearing them all away,"},{"id":"manas-2010:p0219:b001:l019","ordinal":9719,"en":"I will raid and take your cattle too."},{"id":"manas-2010:p0219:b001:l020","ordinal":9720,"en":"Your lands of Altai and Orkoy,"},{"id":"manas-2010:p0219:b001:l021","ordinal":9721,"en":"If I do not circle and waylay them,"},{"id":"manas-2010:p0219:b001:l022","ordinal":9722,"en":"May I die no longer Manas,"},{"id":"manas-2010:p0219:b001:l023","ordinal":9723,"en":"If I do not break and scatter your court!"},{"id":"manas-2010:p0219:b001:l024","ordinal":9724,"en":"If I do not gird my waist firmly,"},{"id":"manas-2010:p0219:b001:l025","ordinal":9725,"en":"If I do not stand facing you,"},{"id":"manas-2010:p0219:b001:l026","ordinal":9726,"en":"Ah, my darting uncircumcised one,"},{"id":"manas-2010:p0219:b001:l027","ordinal":9727,"en":"If I do not chase you as far as Beijing,"},{"id":"manas-2010:p0219:b001:l028","ordinal":9728,"en":"If I do not thrust a spear into your breast,"}]
