[{"id":"semetey-1-2013:p0489:b005:l019","ordinal":114177,"en":"Thus found a faith in darkness."},{"id":"semetey-1-2013:p0489:b005:l020","ordinal":114178,"en":"Közkaman, son of Kökchököz—"},{"id":"semetey-1-2013:p0489:b005:l021","ordinal":114179,"en":"These two were of one nest;"},{"id":"semetey-1-2013:p0489:b005:l022","ordinal":114180,"en":"Not merely of one nest, but born in succession,"},{"id":"semetey-1-2013:p0489:b005:l023","ordinal":114181,"en":"Their belts firmly girded."},{"id":"semetey-1-2013:p0489:b005:l024","ordinal":114182,"en":"That unbeliever went to China and was born."},{"id":"semetey-1-2013:p0489:b005:l025","ordinal":114183,"en":"In Beijing's sacred well"},{"id":"semetey-1-2013:p0489:b005:l026","ordinal":114184,"en":"He went and bathed for six months."},{"id":"semetey-1-2013:p0489:b005:l027","ordinal":114185,"en":"At Közkaman's appearance,"},{"id":"semetey-1-2013:p0489:b005:l028","ordinal":114186,"en":"Those who saw him were frightened."},{"id":"semetey-1-2013:p0489:b005:l029","ordinal":114187,"en":"The law of the Chinese"},{"id":"semetey-1-2013:p0489:b005:l030","ordinal":114188,"en":"He had studied thoroughly."},{"id":"semetey-1-2013:p0489:b005:l031","ordinal":114189,"en":"Reciting wondrous spells,"},{"id":"semetey-1-2013:p0489:b005:l032","ordinal":114190,"en":"Those who heard Közkaman's name trembled."},{"id":"semetey-1-2013:p0489:b005:l034","ordinal":114191,"en":"Dust rose from his passage,"},{"id":"semetey-1-2013:p0489:b005:l035","ordinal":114192,"en":"Lives fled before his wrath."},{"id":"semetey-1-2013:p0489:b005:l036","ordinal":114193,"en":"He shattered those he met,"},{"id":"semetey-1-2013:p0489:b005:l037","ordinal":114194,"en":"Destroyed whoever crossed his path."},{"id":"semetey-1-2013:p0489:b005:l038","ordinal":114195,"en":"Kökchököz and Közkaman,"},{"id":"semetey-1-2013:p0489:b005:l039","ordinal":114196,"en":"Skilled horsemen, swift on foot,"},{"id":"semetey-1-2013:p0490:b003:l001","ordinal":114197,"en":"A great wrestler in state service,"},{"id":"semetey-1-2013:p0490:b003:l002","ordinal":114198,"en":"Who spared no life when grappling,"},{"id":"semetey-1-2013:p0490:b003:l003","ordinal":114199,"en":"Who could never drink his fill of blood."},{"id":"semetey-1-2013:p0490:b003:l004","ordinal":114200,"en":"From the very first day, his conduct"},{"id":"semetey-1-2013:p0490:b003:l005","ordinal":114201,"en":"In every place he reached"},{"id":"semetey-1-2013:p0490:b003:l006","ordinal":114202,"en":"Was to sow disorder."},{"id":"semetey-1-2013:p0490:b003:l007","ordinal":114203,"en":"He was the man Karykan of Beijing"},{"id":"semetey-1-2013:p0490:b003:l008","ordinal":114204,"en":"Trusted firmly."},{"id":"semetey-1-2013:p0490:b003:l009","ordinal":114205,"en":"Among the khagan's forty Chinese tribes,"},{"id":"semetey-1-2013:p0490:b003:l010","ordinal":114206,"en":"He was khan of one tribe."},{"id":"semetey-1-2013:p0490:b003:l011","ordinal":114207,"en":"He was the support they relied upon;"},{"id":"semetey-1-2013:p0490:b003:l012","ordinal":114208,"en":"Against all who faced him,"},{"id":"semetey-1-2013:p0490:b003:l013","ordinal":114209,"en":"He too was the hero who brought devastation."},{"id":"semetey-1-2013:p0490:b003:l014","ordinal":114210,"en":"After giving the warrior a strong poison,"},{"id":"semetey-1-2013:p0490:b003:l015","ordinal":114211,"en":"He set out toward Beijing,"},{"id":"semetey-1-2013:p0490:b003:l016","ordinal":114212,"en":"Loading gold coins upon elephants."},{"id":"semetey-1-2013:p0490:b003:l017","ordinal":114213,"en":"“The destroyer Manas is dead;"},{"id":"semetey-1-2013:p0490:b003:l018","ordinal":114214,"en":"He has seen the other world,” he said."},{"id":"semetey-1-2013:p0490:b003:l019","ordinal":114215,"en":"From the Kyrgyz girls,"},{"id":"semetey-1-2013:p0490:b003:l020","ordinal":114216,"en":"Thimble-mouthed, camel-calf-eyed,"},{"id":"semetey-1-2013:p0490:b003:l021","ordinal":114217,"en":"Coquettish beauties,"},{"id":"semetey-1-2013:p0490:b003:l022","ordinal":114218,"en":"He chose a thousand as booty."},{"id":"semetey-1-2013:p0490:b003:l023","ordinal":114219,"en":"He plundered their possessions,"},{"id":"semetey-1-2013:p0490:b003:l024","ordinal":114220,"en":"Wrought thorough destruction."},{"id":"semetey-1-2013:p0490:b003:l025","ordinal":114221,"en":"Whole otter pelts"},{"id":"semetey-1-2013:p0490:b003:l026","ordinal":114222,"en":"He tore apart"},{"id":"semetey-1-2013:p0490:b003:l027","ordinal":114223,"en":"And put upon his trouser-cuffs."},{"id":"semetey-1-2013:p0490:b003:l028","ordinal":114224,"en":"To carry away to Beijing,"},{"id":"semetey-1-2013:p0490:b003:l029","ordinal":114225,"en":"All of Khan Manas's treasure"},{"id":"semetey-1-2013:p0490:b003:l030","ordinal":114226,"en":"He loaded and traveled through the night,"},{"id":"semetey-1-2013:p0490:b003:l031","ordinal":114227,"en":"Taking it as booty."},{"id":"semetey-1-2013:p0490:b003:l032","ordinal":114228,"en":"When dawn broke bright,"},{"id":"semetey-1-2013:p0490:b003:l033","ordinal":114229,"en":"When light touched the earth,"},{"id":"semetey-1-2013:p0490:b003:l034","ordinal":114230,"en":"The stars parted overhead,"},{"id":"semetey-1-2013:p0490:b003:l035","ordinal":114231,"en":"Light poured onto the earth,"},{"id":"semetey-1-2013:p0490:b003:l036","ordinal":114232,"en":"The earth split, and the fescue"},{"id":"semetey-1-2013:p0490:b003:l037","ordinal":114233,"en":"Appeared with its grass."},{"id":"semetey-1-2013:p0490:b003:l038","ordinal":114234,"en":"Khan Manas's forty zaisans,"},{"id":"semetey-1-2013:p0490:b003:l039","ordinal":114235,"en":"The mighty Bakai and Almambet,"},{"id":"semetey-1-2013:p0490:b004:l001","ordinal":114236,"en":"The champion attacking from afar,"},{"id":"semetey-1-2013:p0490:b004:l002","ordinal":114237,"en":"Beyond any man's strength in a grapple,"},{"id":"semetey-1-2013:p0490:b004:l003","ordinal":114238,"en":"Chubak, son of Akbaltai,"},{"id":"semetey-1-2013:p0490:b004:l004","ordinal":114239,"en":"That supremely renowned hero."},{"id":"semetey-1-2013:p0490:b004:l005","ordinal":114240,"en":"Did they know of them,"},{"id":"semetey-1-2013:p0490:b004:l006","ordinal":114241,"en":"Khan Manas's renowned"},{"id":"semetey-1-2013:p0490:b004:l007","ordinal":114242,"en":"Warriors, his forty companions?"},{"id":"semetey-1-2013:p0490:b004:l008","ordinal":114243,"en":"Kökchököz and Közkaman,"},{"id":"semetey-1-2013:p0490:b004:l009","ordinal":114244,"en":"Ögüz-Ashuu and Tai-Ashuu—"},{"id":"semetey-1-2013:p0490:b004:l010","ordinal":114245,"en":"When they crossed these routes,"},{"id":"semetey-1-2013:p0490:b004:l011","ordinal":114246,"en":"Beyond them lay Chong-Zhyldyz."},{"id":"semetey-1-2013:p0490:b004:l012","ordinal":114247,"en":"Resting their horses, sleeping,"},{"id":"semetey-1-2013:p0490:b004:l013","ordinal":114248,"en":"The men lay down together."},{"id":"semetey-1-2013:p0490:b004:l014","ordinal":114249,"en":"Közkaman rushed in haste"},{"id":"semetey-1-2013:p0490:b004:l015","ordinal":114250,"en":"When Khan Manas's forty warriors"},{"id":"semetey-1-2013:p0490:b004:l016","ordinal":114251,"en":"Came down upon them."},{"id":"semetey-1-2013:p0490:b004:l017","ordinal":114252,"en":"The most skillful spearman"},{"id":"semetey-1-2013:p0490:b004:l018","ordinal":114253,"en":"Among those fugitives"},{"id":"semetey-1-2013:p0490:b004:l019","ordinal":114254,"en":"Was the mighty gray-maned Kökchököz."},{"id":"semetey-1-2013:p0490:b004:l020","ordinal":114255,"en":"Without looking about him,"},{"id":"semetey-1-2013:p0490:b004:l021","ordinal":114256,"en":"He spurred on and fought,"},{"id":"semetey-1-2013:p0490:b004:l022","ordinal":114257,"en":"Sparing his life not at all."},{"id":"semetey-1-2013:p0490:b004:l023","ordinal":114258,"en":"Calling out, putting forth his plea,"},{"id":"semetey-1-2013:p0490:b004:l024","ordinal":114259,"en":"Közkaman standing there said:"},{"id":"semetey-1-2013:p0490:b004:l025","ordinal":114260,"en":"“Khan Manas's forty champions,"},{"id":"semetey-1-2013:p0490:b004:l026","ordinal":114261,"en":"Turn your horses this way."},{"id":"semetey-1-2013:p0490:b004:l027","ordinal":114262,"en":"To a single combat with spears"},{"id":"semetey-1-2013:p0490:b004:l028","ordinal":114263,"en":"I pledge myself; stand and face me!"},{"id":"semetey-1-2013:p0490:b004:l029","ordinal":114264,"en":"If you defeat me with your spear,"},{"id":"semetey-1-2013:p0490:b004:l030","ordinal":114265,"en":"I will go and settle in Talas;"},{"id":"semetey-1-2013:p0490:b004:l031","ordinal":114266,"en":"I will become a true Muslim!"},{"id":"semetey-1-2013:p0490:b004:l032","ordinal":114267,"en":"I will eat white wheat flour."},{"id":"semetey-1-2013:p0490:b004:l033","ordinal":114268,"en":"Never again to practice discord or villainy,"},{"id":"semetey-1-2013:p0490:b004:l035","ordinal":114269,"en":"I will hold to the holy creed."},{"id":"semetey-1-2013:p0490:b004:l036","ordinal":114270,"en":"Of Almighty God"},{"id":"semetey-1-2013:p0490:b004:l037","ordinal":114271,"en":"I will acknowledge the oneness."},{"id":"semetey-1-2013:p0490:b004:l038","ordinal":114272,"en":"Bakai, listen carefully to my words,"},{"id":"semetey-1-2013:p0490:b004:l039","ordinal":114273,"en":"Without saying this or that,"},{"id":"semetey-1-2013:p0491:b003:l001","ordinal":114274,"en":"I will enter your true faith!"},{"id":"semetey-1-2013:p0491:b003:l002","ordinal":114275,"en":"If I defeat you with my spear,"},{"id":"semetey-1-2013:p0491:b003:l003","ordinal":114276,"en":"Go and settle under the khagan."},{"id":"semetey-1-2013:p0491:b003:l004","ordinal":114277,"en":"Say that the idol is God,"},{"id":"semetey-1-2013:p0491:b003:l005","ordinal":114278,"en":"And truly become an unbeliever with us!"},{"id":"semetey-1-2013:p0491:b003:l006","ordinal":114279,"en":"Let us mark out a place,"},{"id":"semetey-1-2013:p0491:b003:l007","ordinal":114280,"en":"Let us measure the ground."},{"id":"semetey-1-2013:p0491:b003:l008","ordinal":114281,"en":"My forty lords against forty companions,"},{"id":"semetey-1-2013:p0491:b003:l009","ordinal":114282,"en":"Let us hold single combats."},{"id":"semetey-1-2013:p0491:b003:l010","ordinal":114283,"en":"Fortunate Bakai, leopard,"},{"id":"semetey-1-2013:p0491:b003:l011","ordinal":114284,"en":"Fighting one against one,"},{"id":"semetey-1-2013:p0491:b003:l012","ordinal":114285,"en":"Let us leave no regrets!"},{"id":"semetey-1-2013:p0491:b003:l014","ordinal":114286,"en":"The custom is six by six.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0491:b003:l015","ordinal":114287,"en":"If you truly are a khan,"},{"id":"semetey-1-2013:p0491:b003:l016","ordinal":114288,"en":"My khan Bakai, leopard”—"},{"id":"semetey-1-2013:p0491:b003:l017","ordinal":114289,"en":"These were Kökchököz's words."},{"id":"semetey-1-2013:p0491:b003:l018","ordinal":114290,"en":"Fortunate Bakai heard him"},{"id":"semetey-1-2013:p0491:b003:l019","ordinal":114291,"en":"And gave the unbeliever his turn."},{"id":"semetey-1-2013:p0491:b003:l020","ordinal":114292,"en":"To what the dark Manchu and Chinese"},{"id":"semetey-1-2013:p0491:b003:l021","ordinal":114293,"en":"Had said, he agreed."},{"id":"semetey-1-2013:p0491:b003:l022","ordinal":114294,"en":"Almambet and Bakai, matching in name,"},{"id":"semetey-1-2013:p0491:b003:l023","ordinal":114295,"en":"Sent round among the forty zaisans,"},{"id":"semetey-1-2013:p0491:b003:l024","ordinal":114296,"en":"Set them filing out,"},{"id":"semetey-1-2013:p0491:b003:l025","ordinal":114297,"en":"And began to choose a hero."},{"id":"semetey-1-2013:p0491:b003:l026","ordinal":114298,"en":"Khan Manas's forty wolves,"},{"id":"semetey-1-2013:p0491:b003:l027","ordinal":114299,"en":"Some of them confused,"},{"id":"semetey-1-2013:p0491:b003:l028","ordinal":114300,"en":"Some competing for the duel,"},{"id":"semetey-1-2013:p0491:b003:l029","ordinal":114301,"en":"Saying, “I will go!”"},{"id":"semetey-1-2013:p0491:b003:l030","ordinal":114302,"en":"They readied their spears,"},{"id":"semetey-1-2013:p0491:b003:l031","ordinal":114303,"en":"All prepared their winged steeds."},{"id":"semetey-1-2013:p0491:b003:l032","ordinal":114304,"en":"The decree of the Creator,"},{"id":"semetey-1-2013:p0491:b003:l033","ordinal":114305,"en":"Should it fall upon them, they acknowledged."},{"id":"semetey-1-2013:p0491:b003:l034","ordinal":114306,"en":"Helmets of blue iron"},{"id":"semetey-1-2013:p0491:b003:l035","ordinal":114307,"en":"They set upside down upon their heads."},{"id":"semetey-1-2013:p0491:b003:l036","ordinal":114308,"en":"In wrath, that"},{"id":"semetey-1-2013:p0491:b003:l037","ordinal":114309,"en":"Leopard Bakai roared:"},{"id":"semetey-1-2013:p0491:b003:l038","ordinal":114310,"en":"“Khan Manas's forty zaisans,"},{"id":"semetey-1-2013:p0491:b003:l039","ordinal":114311,"en":"Come here!” he called."},{"id":"semetey-1-2013:p0491:b005:l001","ordinal":114312,"en":"“Khan Manas's forty zaisans,"},{"id":"semetey-1-2013:p0491:b005:l002","ordinal":114313,"en":"Let your hero among spearmen come;"},{"id":"semetey-1-2013:p0491:b005:l003","ordinal":114314,"en":"Let your ruthless lion come."},{"id":"semetey-1-2013:p0491:b005:l004","ordinal":114315,"en":"Come all, without hanging back;"},{"id":"semetey-1-2013:p0491:b005:l005","ordinal":114316,"en":"Let your khan who shatters peoples come!"},{"id":"semetey-1-2013:p0491:b005:l006","ordinal":114317,"en":"I will slaughter all forty companions,"},{"id":"semetey-1-2013:p0491:b005:l007","ordinal":114318,"en":"Unless your hearts are foolish."},{"id":"semetey-1-2013:p0491:b005:l008","ordinal":114319,"en":"Damn your fathers' graves, forty companions!"},{"id":"semetey-1-2013:p0491:b005:l009","ordinal":114320,"en":"This is your time to shatter peoples!"},{"id":"semetey-1-2013:p0491:b005:l010","ordinal":114321,"en":"What you lost has been found,"},{"id":"semetey-1-2013:p0491:b005:l011","ordinal":114322,"en":"Your honor covered as with ash."},{"id":"semetey-1-2013:p0491:b005:l012","ordinal":114323,"en":"Champions who lie in idleness,"},{"id":"semetey-1-2013:p0491:b005:l013","ordinal":114324,"en":"Here you have found your diversion."},{"id":"semetey-1-2013:p0491:b005:l014","ordinal":114325,"en":"My dear forty companions,"},{"id":"semetey-1-2013:p0491:b005:l015","ordinal":114326,"en":"When the black gun cracks,"},{"id":"semetey-1-2013:p0491:b005:l016","ordinal":114327,"en":"Do not flee and boil my misery!"},{"id":"semetey-1-2013:p0491:b005:l017","ordinal":114328,"en":"When the fierce gun snaps,"},{"id":"semetey-1-2013:p0491:b005:l018","ordinal":114329,"en":"Do not start with fear and boil my misery!"},{"id":"semetey-1-2013:p0491:b005:l019","ordinal":114330,"en":"Damn your fathers' graves, forty zaisans!"},{"id":"semetey-1-2013:p0491:b005:l020","ordinal":114331,"en":"All forty of you were lions from forty places;"},{"id":"semetey-1-2013:p0491:b005:l022","ordinal":114332,"en":"All forty were wolves for Khan Manas."},{"id":"semetey-1-2013:p0491:b005:l023","ordinal":114333,"en":"Each of you, my forty companions,"},{"id":"semetey-1-2013:p0491:b005:l024","ordinal":114334,"en":"Has a lion's fearsome majesty."},{"id":"semetey-1-2013:p0491:b005:l025","ordinal":114335,"en":"Közkaman comes out to fight;"},{"id":"semetey-1-2013:p0491:b005:l026","ordinal":114336,"en":"Which of you will go to single combat?"},{"id":"semetey-1-2013:p0491:b005:l027","ordinal":114337,"en":"Think well, forty companions:"},{"id":"semetey-1-2013:p0491:b005:l028","ordinal":114338,"en":"Which of you will go to the duel?"},{"id":"semetey-1-2013:p0491:b005:l029","ordinal":114339,"en":"For wounded Sultan Manas,"},{"id":"semetey-1-2013:p0491:b005:l030","ordinal":114340,"en":"Whether it brings sin or merit,"},{"id":"semetey-1-2013:p0491:b005:l031","ordinal":114341,"en":"Which of you will take up the duty?"},{"id":"semetey-1-2013:p0491:b005:l032","ordinal":114342,"en":"My dear ones from forty places,"},{"id":"semetey-1-2013:p0491:b005:l033","ordinal":114343,"en":"Which of you will go to the spear-contest?"},{"id":"semetey-1-2013:p0491:b005:l034","ordinal":114344,"en":"Which of you will raise the dust?"},{"id":"semetey-1-2013:p0491:b005:l035","ordinal":114345,"en":"Consider it, forty champions:"},{"id":"semetey-1-2013:p0491:b005:l036","ordinal":114346,"en":"Which of you will go to battle?"},{"id":"semetey-1-2013:p0491:b005:l037","ordinal":114347,"en":"Does not a mortal creature die?"},{"id":"semetey-1-2013:p0491:b005:l038","ordinal":114348,"en":"Damn your fathers' graves, forty champions!"},{"id":"semetey-1-2013:p0491:b005:l039","ordinal":114349,"en":"Which of you will win honor?"},{"id":"semetey-1-2013:p0492:b003:l001","ordinal":114350,"en":"Fortunate when I send you into battle,"},{"id":"semetey-1-2013:p0492:b003:l002","ordinal":114351,"en":"Like a countless army when I lead you,"},{"id":"semetey-1-2013:p0492:b003:l003","ordinal":114352,"en":"You too are standing here.”"},{"id":"semetey-1-2013:p0492:b003:l004","ordinal":114353,"en":"Your khan Bakai roared,"},{"id":"semetey-1-2013:p0492:b003:l005","ordinal":114354,"en":"Calling the forty champions."},{"id":"semetey-1-2013:p0492:b003:l006","ordinal":114355,"en":"“Golden forelock, tasseled belt,"},{"id":"semetey-1-2013:p0492:b003:l007","ordinal":114356,"en":"The only son of Azyz Khan—"},{"id":"semetey-1-2013:p0492:b003:l008","ordinal":114357,"en":"My red spear-banner,"},{"id":"semetey-1-2013:p0492:b003:l009","ordinal":114358,"en":"My gift that came from China,"},{"id":"semetey-1-2013:p0492:b003:l010","ordinal":114359,"en":"Leopard who came from the khagan,"},{"id":"semetey-1-2013:p0492:b003:l011","ordinal":114360,"en":"Pillar of my only one, Khan Manas,"},{"id":"semetey-1-2013:p0492:b003:l012","ordinal":114361,"en":"Almambet, you stand here."},{"id":"semetey-1-2013:p0492:b003:l013","ordinal":114362,"en":"Against the dark Kalmyk weather-sorcerer,"},{"id":"semetey-1-2013:p0492:b003:l014","ordinal":114363,"en":"Which of you will devise a way?”"},{"id":"semetey-1-2013:p0492:b003:l015","ordinal":114364,"en":"When Bakai Khan had spoken thus,"},{"id":"semetey-1-2013:p0492:b003:l016","ordinal":114365,"en":"Before he could close his mouth,"},{"id":"semetey-1-2013:p0492:b003:l017","ordinal":114366,"en":"The finest of the sixty,"},{"id":"semetey-1-2013:p0492:b003:l018","ordinal":114367,"en":"The champion of the forty companions,"},{"id":"semetey-1-2013:p0492:b003:l019","ordinal":114368,"en":"Riding a splendid courser,"},{"id":"semetey-1-2013:p0492:b003:l020","ordinal":114369,"en":"Wearing a coat blue as iron,"},{"id":"semetey-1-2013:p0492:b003:l021","ordinal":114370,"en":"Not shrinking a hair's breadth from death,"},{"id":"semetey-1-2013:p0492:b003:l022","ordinal":114371,"en":"Not turning back when sent into battle,"},{"id":"semetey-1-2013:p0492:b003:l023","ordinal":114372,"en":"Rejoicing at the mention of death,"},{"id":"semetey-1-2013:p0492:b003:l024","ordinal":114373,"en":"Known to be a khan,"},{"id":"semetey-1-2013:p0492:b003:l025","ordinal":114374,"en":"Never shedding his stern expression,"},{"id":"semetey-1-2013:p0492:b003:l026","ordinal":114375,"en":"Never retreating from a challenge,"},{"id":"semetey-1-2013:p0492:b003:l027","ordinal":114376,"en":"Light upon a horse, suited to a yearling,"},{"id":"semetey-1-2013:p0492:b003:l028","ordinal":114377,"en":"Short of sleep, watchful on the road,"},{"id":"semetey-1-2013:p0492:b003:l029","ordinal":114378,"en":"The edge of black steel—"},{"id":"semetey-1-2013:p0492:b003:l030","ordinal":114379,"en":"Have you heard of him?"},{"id":"semetey-1-2013:p0492:b003:l031","ordinal":114380,"en":"He too was of princely stock,"},{"id":"semetey-1-2013:p0492:b003:l032","ordinal":114381,"en":"Khan Manas's Syrgak,"},{"id":"semetey-1-2013:p0492:b003:l033","ordinal":114382,"en":"Who could throw the whole world into turmoil,"},{"id":"semetey-1-2013:p0492:b003:l034","ordinal":114383,"en":"My dear young scamp."},{"id":"semetey-1-2013:p0492:b003:l035","ordinal":114384,"en":"If he lived and grew to maturity,"},{"id":"semetey-1-2013:p0492:b003:l036","ordinal":114385,"en":"His strength would reach the whole world."},{"id":"semetey-1-2013:p0492:b003:l037","ordinal":114386,"en":"Manas and this Syrgak"},{"id":"semetey-1-2013:p0492:b003:l038","ordinal":114387,"en":"Were sons of brothers."},{"id":"semetey-1-2013:p0492:b003:l039","ordinal":114388,"en":"Of middling height, broad-shouldered,"},{"id":"semetey-1-2013:p0492:b004:l001","ordinal":114389,"en":"Renowned Syrgak the destroyer—"},{"id":"semetey-1-2013:p0492:b004:l002","ordinal":114390,"en":"His time to wreak destruction had come."},{"id":"semetey-1-2013:p0492:b004:l003","ordinal":114391,"en":"Khan Syrgak, son of Ulakkan,"},{"id":"semetey-1-2013:p0492:b004:l004","ordinal":114392,"en":"Turned Kökchebich's head."},{"id":"semetey-1-2013:p0492:b004:l005","ordinal":114393,"en":"“Gray-maned Bakai, dear Almambet,"},{"id":"semetey-1-2013:p0492:b004:l006","ordinal":114394,"en":"Look at me and hear my words!"},{"id":"semetey-1-2013:p0492:b004:l007","ordinal":114395,"en":"With the fugitive of our own stock"},{"id":"semetey-1-2013:p0492:b004:l008","ordinal":114396,"en":"I would join combat,"},{"id":"semetey-1-2013:p0492:b004:l009","ordinal":114397,"en":"To die if death arrives,"},{"id":"semetey-1-2013:p0492:b004:l010","ordinal":114398,"en":"Or, if I have the means, Khan Bakai,"},{"id":"semetey-1-2013:p0492:b004:l011","ordinal":114399,"en":"Upon the unbeliever of the Kalmyk faith"},{"id":"semetey-1-2013:p0492:b004:l012","ordinal":114400,"en":"To inflict humiliation,"},{"id":"semetey-1-2013:p0492:b004:l013","ordinal":114401,"en":"Crossing spears and breaking ranks,"},{"id":"semetey-1-2013:p0492:b004:l014","ordinal":114402,"en":"Falling to a bullet if my death has come,"},{"id":"semetey-1-2013:p0492:b004:l015","ordinal":114403,"en":"Facing the pit already dug,"},{"id":"semetey-1-2013:p0492:b004:l016","ordinal":114404,"en":"Facing the misery already boiled,"},{"id":"semetey-1-2013:p0492:b004:l017","ordinal":114405,"en":"Stopping only short of death,"},{"id":"semetey-1-2013:p0492:b004:l018","ordinal":114406,"en":"Against that Kalmyk servant"},{"id":"semetey-1-2013:p0492:b004:l019","ordinal":114407,"en":"Fighting to the utmost like this..."},{"id":"semetey-1-2013:p0492:b004:l020","ordinal":114408,"en":"Uncle Bakai, Almambet,"},{"id":"semetey-1-2013:p0492:b004:l021","ordinal":114409,"en":"My lions, give your blessing!"},{"id":"semetey-1-2013:p0492:b004:l022","ordinal":114410,"en":"If death draws near,"},{"id":"semetey-1-2013:p0492:b004:l023","ordinal":114411,"en":"Let me see the face of the other world."},{"id":"semetey-1-2013:p0492:b004:l024","ordinal":114412,"en":"Otherwise, if the Creator grants me honor,"},{"id":"semetey-1-2013:p0492:b004:l025","ordinal":114413,"en":"The troops of those fugitive Chinese ahead"},{"id":"semetey-1-2013:p0492:b004:l026","ordinal":114414,"en":"I will split in two."},{"id":"semetey-1-2013:p0492:b004:l027","ordinal":114415,"en":"Közkaman who harmed my uncle—"},{"id":"semetey-1-2013:p0492:b004:l028","ordinal":114416,"en":"If I catch him, I will spill his blood."},{"id":"semetey-1-2013:p0492:b004:l029","ordinal":114417,"en":"I will slaughter him as a sacrifice,"},{"id":"semetey-1-2013:p0492:b004:l030","ordinal":114418,"en":"Have him dragged along the road,"},{"id":"semetey-1-2013:p0492:b004:l031","ordinal":114419,"en":"For the wretch who abandoned proper conduct"},{"id":"semetey-1-2013:p0492:b004:l032","ordinal":114420,"en":"I will make a spectacle!"},{"id":"semetey-1-2013:p0492:b004:l033","ordinal":114421,"en":"Leopard Almambet, give your blessing;"},{"id":"semetey-1-2013:p0492:b004:l034","ordinal":114422,"en":"Let me go against the Chinese!”"},{"id":"semetey-1-2013:p0492:b004:l035","ordinal":114423,"en":"Syrgak's gray belt"},{"id":"semetey-1-2013:p0492:b004:l036","ordinal":114424,"en":"He fitted about his neck,"},{"id":"semetey-1-2013:p0492:b004:l037","ordinal":114425,"en":"Asking Bakai for a blessing,"},{"id":"semetey-1-2013:p0492:b004:l038","ordinal":114426,"en":"Young Syrgak pleaded."},{"id":"semetey-1-2013:p0492:b004:l039","ordinal":114427,"en":"Before he could close his mouth,"},{"id":"semetey-1-2013:p0493:b003:l001","ordinal":114428,"en":"Destroyer Bakai and Almambet—"},{"id":"semetey-1-2013:p0493:b003:l002","ordinal":114429,"en":"To Syrgak beside them,"},{"id":"semetey-1-2013:p0493:b003:l003","ordinal":114430,"en":"Before they could give their blessing,"},{"id":"semetey-1-2013:p0493:b003:l004","ordinal":114431,"en":"Roaring in wrath,"},{"id":"semetey-1-2013:p0493:b003:l005","ordinal":114432,"en":"Kökchököz came out for single combat:"}]
