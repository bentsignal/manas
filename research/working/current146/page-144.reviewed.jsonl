{"id": "sayakbay-ms-current146:pdf144:l001", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 144, "folio": 527, "line_in_page": 1, "raw": "Колуң менен курайсың,", "text": "Колуң менен курайсың,", "en": "You assemble it with your own hands,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf144:l002", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 144, "folio": 527, "line_in_page": 2, "raw": "Так таңдай эмине,", "text": "Так таңдай эмине,", "en": "What is this precise tongue of yours?", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf144:l003", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 144, "folio": 527, "line_in_page": 3, "raw": "Алмайын таалдан жуласың.", "text": "Алмайын таалдан жуласың.", "en": "You tear away what you cannot take by right.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf144:l004", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 144, "folio": 527, "line_in_page": 4, "raw": "Бузук да уул чордо үчүн,", "text": "Бузук да уул чордо үчүн,", "en": "For the unruly son and young warrior,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf144:l005", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 144, "folio": 527, "line_in_page": 5, "raw": "Эй, кыргыздак кыргыз журт,", "text": "Эй, кыргыздак кыргыз журт,", "en": "O Kyrgyz people of the Kyrgyz,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf144:l006", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 144, "folio": 527, "line_in_page": 6, "raw": "Аманынды көрүп,", "text": "Аманынды көрүп,", "en": "Seeing you safe and alive,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf144:l007", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 144, "folio": 527, "line_in_page": 7, "raw": "Айланды алып жериңден,", "text": "Айланды алып жериңден,", "en": "Circling and seizing your land,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf144:l008", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 144, "folio": 527, "line_in_page": 8, "raw": "Азыр мындай кылбайсың,", "text": "Азыр мындай кылбайсың,", "en": "You will not act this way now,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf144:l009", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 144, "folio": 527, "line_in_page": 9, "raw": "Кайрылгыс жаманыңды,", "text": "Кайрылгыс жаманыңды,", "en": "Your irredeemable evil,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf144:l010", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 144, "folio": 527, "line_in_page": 10, "raw": "Көрүнүшүн майданды,", "text": "Көрүнүшүн майданды,", "en": "The appearance of the battlefield,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf144:l011", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 144, "folio": 527, "line_in_page": 11, "raw": "Чыгарайын согуштан,", "text": "Чыгарайын согуштан,", "en": "Let me drive you from the battle,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf144:l012", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 144, "folio": 527, "line_in_page": 12, "raw": "Ээрчисе кетпес майтылуу,", "text": "Ээрчисе кетпес майтылуу,", "en": "A steadfast one who will not leave when followed,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf144:l013", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 144, "folio": 527, "line_in_page": 13, "raw": "Ушайын уруп кылбайын,", "text": "Ушайын уруп кылбайын,", "en": "Let me strike and shatter him,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf144:l014", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 144, "folio": 527, "line_in_page": 14, "raw": "Тилегиңди эмине,", "text": "Тилегиңди эмине,", "en": "What is it that you desire?", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf144:l015", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 144, "folio": 527, "line_in_page": 15, "raw": "Орт оңдой кылбайын.", "text": "Орт оңдой кылбайын.", "en": "Let me set the midst in order.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf144:l016", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 144, "folio": 527, "line_in_page": 16, "raw": "Майданга жеңип токтоду,", "text": "Майданга жеңип токтоду,", "en": "He prevailed and stood upon the battlefield,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf144:l017", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 144, "folio": 527, "line_in_page": 17, "raw": "Артыкча өзөк тил менен,", "text": "Артыкча өзөк тил менен,", "en": "With an exceptionally cutting tongue,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf144:l018", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 144, "folio": 527, "line_in_page": 18, "raw": "Аюудай тиш тил менен,", "text": "Аюудай тиш тил менен,", "en": "With teeth and tongue like a bear,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf144:l019", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 144, "folio": 527, "line_in_page": 19, "raw": "Заары кара уу тил менен,", "text": "Заары кара уу тил менен,", "en": "With a tongue of black and poisonous venom,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf144:l020", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 144, "folio": 527, "line_in_page": 20, "raw": "Кыргызды кордой баштады.", "text": "Кыргызды кордой баштады.", "en": "He began to humiliate the Kyrgyz.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf144:l021", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 144, "folio": 527, "line_in_page": 21, "raw": "Майданга чыгып баатырсың,", "text": "Майданга чыгып баатырсың,", "en": "You are a warrior who entered the field,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf144:l022", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 144, "folio": 527, "line_in_page": 22, "raw": "Аман жерди салышат,", "text": "Аман жерди салышат,", "en": "They cast aside the place of safety,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf144:l023", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 144, "folio": 527, "line_in_page": 23, "raw": "Балыкчылардай бар кем деп,", "text": "Балыкчылардай бар кем деп,", "en": "Calling them lesser men like fishermen,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf144:l024", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 144, "folio": 527, "line_in_page": 24, "raw": "Жаманың коюп мүрзөгө,", "text": "Жаманың коюп мүрзөгө,", "en": "Laying your wicked one in the grave,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf144:l025", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 144, "folio": 527, "line_in_page": 25, "raw": "Жададың сенден эрин кен,", "text": "Жададың сенден эрин кен,", "en": "Even the broad-hearted hero grew weary of you,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf144:l026", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 144, "folio": 527, "line_in_page": 26, "raw": "Кебинде көчкөн малың бар,", "text": "Кебинде көчкөн малың бар,", "en": "In your tale are herds that migrated,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf144:l027", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 144, "folio": 527, "line_in_page": 27, "raw": "Айтканыңды бир көрөр,", "text": "Айтканыңды бир көрөр,", "en": "One day you will see what your words bring,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf144:l028", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 144, "folio": 527, "line_in_page": 28, "raw": "Бузук менен алыш бар.", "text": "Бузук менен алыш бар.", "en": "There will be a struggle with the rebel.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf144:l029", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 144, "folio": 527, "line_in_page": 29, "raw": "Деп ошентип күркүрөп,", "text": "Деп ошентип күркүрөп,", "en": "Speaking thus, he thundered,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf144:l030", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 144, "folio": 527, "line_in_page": 30, "raw": "Айбаты артык бир көрөр,", "text": "Айбаты артык бир көрөр,", "en": "His formidable bearing surpassed all others,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf144:l031", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 144, "folio": 527, "line_in_page": 31, "raw": "Каарданып турганда,", "text": "Каарданып турганда,", "en": "As he stood enraged,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf144:l032", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 144, "folio": 527, "line_in_page": 32, "raw": "Калк жанынан түшүндү,", "text": "Калк жанынан түшүндү,", "en": "The people understood in their hearts,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf144:l033", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 144, "folio": 527, "line_in_page": 33, "raw": "Туман болуп күрүлдөдү.", "text": "Туман болуп күрүлдөдү.", "en": "He roared like gathering mist.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
