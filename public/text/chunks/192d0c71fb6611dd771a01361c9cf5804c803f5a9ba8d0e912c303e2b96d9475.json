[{"id":"semetey-1-2013:p0506:b003:l039","ordinal":115713,"en":"Would surely come, I had thought."},{"id":"semetey-1-2013:p0506:b004:l001","ordinal":115714,"en":"Agysh hummed, unconcerned,"},{"id":"semetey-1-2013:p0506:b004:l002","ordinal":115715,"en":"And me, standing watch,"},{"id":"semetey-1-2013:p0506:b004:l003","ordinal":115716,"en":"He deemed worth less than his trouser hem."},{"id":"semetey-1-2013:p0506:b004:l004","ordinal":115717,"en":"Driving mountain sheep, chasing wild asses,"},{"id":"semetey-1-2013:p0506:b004:l005","ordinal":115718,"en":"Wearing out his horse, ranging the land,"},{"id":"semetey-1-2013:p0506:b004:l006","ordinal":115719,"en":"Releasing dogs and flying his bird,"},{"id":"semetey-1-2013:p0506:b004:l007","ordinal":115720,"en":"Hero Agysh passed on."},{"id":"semetey-1-2013:p0506:b004:l008","ordinal":115721,"en":"His right shoulder blade was broad;"},{"id":"semetey-1-2013:p0506:b004:l009","ordinal":115722,"en":"His twelve bodily parts were well proportioned."},{"id":"semetey-1-2013:p0506:b004:l010","ordinal":115723,"en":"On horseback his prowess"},{"id":"semetey-1-2013:p0506:b004:l011","ordinal":115724,"en":"Was less than that of other giants,"},{"id":"semetey-1-2013:p0506:b004:l012","ordinal":115725,"en":"But when wrestling on foot,"},{"id":"semetey-1-2013:p0506:b004:l013","ordinal":115726,"en":"That hero Agysh"},{"id":"semetey-1-2013:p0506:b004:l014","ordinal":115727,"en":"Was the lion of many giants."},{"id":"semetey-1-2013:p0506:b004:l015","ordinal":115728,"en":"Excitedly driving wild asses,"},{"id":"semetey-1-2013:p0506:b004:l016","ordinal":115729,"en":"Without seeing your mother,"},{"id":"semetey-1-2013:p0506:b004:l017","ordinal":115730,"en":"Your Agysh passed in a frenzy."},{"id":"semetey-1-2013:p0506:b004:l018","ordinal":115731,"en":"The black, white-blazed thoroughbred—"},{"id":"semetey-1-2013:p0506:b004:l019","ordinal":115732,"en":"When I drew its bit and turned it,"},{"id":"semetey-1-2013:p0506:b004:l020","ordinal":115733,"en":"When I stood watch,"},{"id":"semetey-1-2013:p0506:b004:l021","ordinal":115734,"en":"Taking no sleep by day,"},{"id":"semetey-1-2013:p0506:b004:l022","ordinal":115735,"en":"Taking no rest by night,"},{"id":"semetey-1-2013:p0506:b004:l023","ordinal":115736,"en":"As I watched the patrol,"},{"id":"semetey-1-2013:p0506:b004:l024","ordinal":115737,"en":"Wearing a blue rep-cloth coat,"},{"id":"semetey-1-2013:p0506:b004:l025","ordinal":115738,"en":"Riding a horse such as Kokala,"},{"id":"semetey-1-2013:p0506:b004:l026","ordinal":115739,"en":"Carrying a spear without a horsehair tuft,"},{"id":"semetey-1-2013:p0506:b004:l027","ordinal":115740,"en":"A sword tied at his side,"},{"id":"semetey-1-2013:p0506:b004:l028","ordinal":115741,"en":"Turning the hearts of those who saw him,"},{"id":"semetey-1-2013:p0506:b004:l029","ordinal":115742,"en":"Your lion appeared like the Ala-Too."},{"id":"semetey-1-2013:p0506:b004:l030","ordinal":115743,"en":"Alai is no equal to Talas;"},{"id":"semetey-1-2013:p0506:b004:l031","ordinal":115744,"en":"Chubak was no less than Manas."},{"id":"semetey-1-2013:p0506:b004:l032","ordinal":115745,"en":"With wild shouts and shrill cheers,"},{"id":"semetey-1-2013:p0506:b004:l033","ordinal":115746,"en":"Chubak, son of Akbaltay,"},{"id":"semetey-1-2013:p0506:b004:l034","ordinal":115747,"en":"To seize Bukhara,"},{"id":"semetey-1-2013:p0506:b004:l035","ordinal":115748,"en":"To destroy its people with their royal seat,"},{"id":"semetey-1-2013:p0506:b004:l036","ordinal":115749,"en":"To wreak a mighty slaughter,"},{"id":"semetey-1-2013:p0506:b004:l037","ordinal":115750,"en":"To kill many of Bukhara's people,"},{"id":"semetey-1-2013:p0506:b004:l038","ordinal":115751,"en":"To seize its khanship—"},{"id":"semetey-1-2013:p0506:b004:l039","ordinal":115752,"en":"Such were Chubak's thoughts."},{"id":"semetey-1-2013:p0507:b003:l001","ordinal":115753,"en":"I, your mother Kanykey,"},{"id":"semetey-1-2013:p0507:b003:l002","ordinal":115754,"en":"Grieving that I was a girl,"},{"id":"semetey-1-2013:p0507:b003:l003","ordinal":115755,"en":"My precious soul clad in men's clothing,"},{"id":"semetey-1-2013:p0507:b003:l005","ordinal":115756,"en":"When clear dawn broke,"},{"id":"semetey-1-2013:p0507:b003:l006","ordinal":115757,"en":"When light fell on the earth,"},{"id":"semetey-1-2013:p0507:b003:l007","ordinal":115758,"en":"The golden-cheeked battle-axe"},{"id":"semetey-1-2013:p0507:b003:l008","ordinal":115759,"en":"I took up and swung."},{"id":"semetey-1-2013:p0507:b003:l009","ordinal":115760,"en":"My father's drum for battle—"},{"id":"semetey-1-2013:p0507:b003:l010","ordinal":115761,"en":"Making it clang then,"},{"id":"semetey-1-2013:p0507:b003:l011","ordinal":115762,"en":"I cast it into the midst."},{"id":"semetey-1-2013:p0507:b003:l012","ordinal":115763,"en":"I girded my waist firmly."},{"id":"semetey-1-2013:p0507:b003:l013","ordinal":115764,"en":"At Akbaltay's Chubak"},{"id":"semetey-1-2013:p0507:b003:l014","ordinal":115765,"en":"I attacked with spear in hand."},{"id":"semetey-1-2013:p0507:b003:l015","ordinal":115766,"en":"'White Ishan!' I roared,"},{"id":"semetey-1-2013:p0507:b003:l016","ordinal":115767,"en":"And 'Temir!' I shouted as my battle cry."},{"id":"semetey-1-2013:p0507:b003:l017","ordinal":115768,"en":"Stepped apart with courage,"},{"id":"semetey-1-2013:p0507:b003:l018","ordinal":115769,"en":"To Chubak, son of Akbaltay,"},{"id":"semetey-1-2013:p0507:b003:l019","ordinal":115770,"en":"I, your mother, appeared like a lion."},{"id":"semetey-1-2013:p0507:b003:l020","ordinal":115771,"en":"Hero Chubak was kingly."},{"id":"semetey-1-2013:p0507:b003:l021","ordinal":115772,"en":"He turned Kokala's head toward me,"},{"id":"semetey-1-2013:p0507:b003:l022","ordinal":115773,"en":"Saying, 'Whoever it is, let them take their spear-thrust turn.'"},{"id":"semetey-1-2013:p0507:b003:l024","ordinal":115774,"en":"With immense, wrathful strength,"},{"id":"semetey-1-2013:p0507:b003:l025","ordinal":115775,"en":"He stared straight ahead: 'Let them strike.'"},{"id":"semetey-1-2013:p0507:b003:l026","ordinal":115776,"en":"Turning Kokala's head,"},{"id":"semetey-1-2013:p0507:b003:l027","ordinal":115777,"en":"Your fierce Chubak stood there."},{"id":"semetey-1-2013:p0507:b003:l028","ordinal":115778,"en":"Enraged, my precious soul,"},{"id":"semetey-1-2013:p0507:b003:l029","ordinal":115779,"en":"My blood not even a spoonful,"},{"id":"semetey-1-2013:p0507:b003:l030","ordinal":115780,"en":"My falcon soul not a handful,"},{"id":"semetey-1-2013:p0507:b003:l031","ordinal":115781,"en":"The black, white-blazed thoroughbred"},{"id":"semetey-1-2013:p0507:b003:l032","ordinal":115782,"en":"Whenever he was freely given his head,"},{"id":"semetey-1-2013:p0507:b003:l033","ordinal":115783,"en":"The ridged, painted steel spear"},{"id":"semetey-1-2013:p0507:b003:l034","ordinal":115784,"en":"When I took the sword in hand,"},{"id":"semetey-1-2013:p0507:b003:l035","ordinal":115785,"en":"I reached him before an arrow could."},{"id":"semetey-1-2013:p0507:b003:l036","ordinal":115786,"en":"'At this edge of the belt,' I thought,"},{"id":"semetey-1-2013:p0507:b003:l037","ordinal":115787,"en":"'Across the ribs,' I thought,"},{"id":"semetey-1-2013:p0507:b003:l038","ordinal":115788,"en":"'Where it will pierce his lung,' I thought,"},{"id":"semetey-1-2013:p0507:b003:l039","ordinal":115789,"en":"As I took my painted spear in hand."},{"id":"semetey-1-2013:p0507:b005:l001","ordinal":115790,"en":"I, your fierce mother, the tempestuous woman,"},{"id":"semetey-1-2013:p0507:b005:l002","ordinal":115791,"en":"Reached him and struck."},{"id":"semetey-1-2013:p0507:b005:l003","ordinal":115792,"en":"Akbaltay's lion"},{"id":"semetey-1-2013:p0507:b005:l004","ordinal":115793,"en":"Slipped backward from his saddle,"},{"id":"semetey-1-2013:p0507:b005:l005","ordinal":115794,"en":"His foot slipped out of the stirrup,"},{"id":"semetey-1-2013:p0507:b005:l006","ordinal":115795,"en":"And Kokala's great lead rope"},{"id":"semetey-1-2013:p0507:b005:l007","ordinal":115796,"en":"He could not grasp properly."},{"id":"semetey-1-2013:p0507:b005:l008","ordinal":115797,"en":"Into the gold-tread stirrup"},{"id":"semetey-1-2013:p0507:b005:l009","ordinal":115798,"en":"He could not set his foot."},{"id":"semetey-1-2013:p0507:b005:l010","ordinal":115799,"en":"Chubak was left reeling."},{"id":"semetey-1-2013:p0507:b005:l011","ordinal":115800,"en":"A curse on being a woman!"},{"id":"semetey-1-2013:p0507:b005:l012","ordinal":115801,"en":"My eyes rolled wildly,"},{"id":"semetey-1-2013:p0507:b005:l013","ordinal":115802,"en":"My legs hung loose."},{"id":"semetey-1-2013:p0507:b005:l014","ordinal":115803,"en":"The face of the world darkened,"},{"id":"semetey-1-2013:p0507:b005:l015","ordinal":115804,"en":"This world grew narrow."},{"id":"semetey-1-2013:p0507:b005:l016","ordinal":115805,"en":"Striking with force at Chubak,"},{"id":"semetey-1-2013:p0507:b005:l017","ordinal":115806,"en":"That unruly one like the Ala-Too,"},{"id":"semetey-1-2013:p0507:b005:l018","ordinal":115807,"en":"My wits fled, my insides burned."},{"id":"semetey-1-2013:p0507:b005:l019","ordinal":115808,"en":"Death is shared by all; there is no warning."},{"id":"semetey-1-2013:p0507:b005:l020","ordinal":115809,"en":"Beside your mother"},{"id":"semetey-1-2013:p0507:b005:l021","ordinal":115810,"en":"There was no companion to help."},{"id":"semetey-1-2013:p0507:b005:l022","ordinal":115811,"en":"Before I could draw back,"},{"id":"semetey-1-2013:p0507:b005:l023","ordinal":115812,"en":"Lion Chubak had recovered."},{"id":"semetey-1-2013:p0507:b005:l024","ordinal":115813,"en":"Lashing Kokala with his whip,"},{"id":"semetey-1-2013:p0507:b005:l025","ordinal":115814,"en":"At me, your unfortunate mother,"},{"id":"semetey-1-2013:p0507:b005:l026","ordinal":115815,"en":"With rage that frightened souls away,"},{"id":"semetey-1-2013:p0507:b005:l027","ordinal":115816,"en":"He charged at that very place."},{"id":"semetey-1-2013:p0507:b005:l028","ordinal":115817,"en":"I gave Chubak his turn."},{"id":"semetey-1-2013:p0507:b005:l029","ordinal":115818,"en":"Raging, the fierce hero roared,"},{"id":"semetey-1-2013:p0507:b005:l030","ordinal":115819,"en":"Shouting 'Oygut!' as his battle cry."},{"id":"semetey-1-2013:p0507:b005:l031","ordinal":115820,"en":"Striking Kokala upon the thigh,"},{"id":"semetey-1-2013:p0507:b005:l032","ordinal":115821,"en":"Calling out 'Akbaltay!'"},{"id":"semetey-1-2013:p0507:b005:l033","ordinal":115822,"en":"I gave Chubak his turn,"},{"id":"semetey-1-2013:p0507:b005:l034","ordinal":115823,"en":"That unruly one approaching."},{"id":"semetey-1-2013:p0507:b005:l035","ordinal":115824,"en":"The black, white-blazed thoroughbred—"},{"id":"semetey-1-2013:p0507:b005:l036","ordinal":115825,"en":"As I drew its bit and turned it,"},{"id":"semetey-1-2013:p0507:b005:l037","ordinal":115826,"en":"Akbaltay's lion"},{"id":"semetey-1-2013:p0507:b005:l038","ordinal":115827,"en":"Reached me before an arrow could,"},{"id":"semetey-1-2013:p0507:b005:l039","ordinal":115828,"en":"And there, your mother—"},{"id":"semetey-1-2013:p0508:b003:l001","ordinal":115829,"en":"At the point of her right shoulder blade"},{"id":"semetey-1-2013:p0508:b003:l002","ordinal":115830,"en":"He struck with great force as he passed."},{"id":"semetey-1-2013:p0508:b003:l003","ordinal":115831,"en":"White fibers as large as a herder's yurt"},{"id":"semetey-1-2013:p0508:b003:l004","ordinal":115832,"en":"Flew clattering with the spear."},{"id":"semetey-1-2013:p0508:b003:l005","ordinal":115833,"en":"Khan Chubak's painted spear"},{"id":"semetey-1-2013:p0508:b003:l006","ordinal":115834,"en":"Shattered into eighty pieces."},{"id":"semetey-1-2013:p0508:b003:l007","ordinal":115835,"en":"When Chubak thrust his spear,"},{"id":"semetey-1-2013:p0508:b003:l008","ordinal":115836,"en":"I lurched aside and recovered."},{"id":"semetey-1-2013:p0508:b003:l009","ordinal":115837,"en":"I wept, calling on the one God."},{"id":"semetey-1-2013:p0508:b003:l010","ordinal":115838,"en":"At one time, wretched as I was,"},{"id":"semetey-1-2013:p0508:b003:l011","ordinal":115839,"en":"Against Khan Baltay's son"},{"id":"semetey-1-2013:p0508:b003:l012","ordinal":115840,"en":"I endured six times."},{"id":"semetey-1-2013:p0508:b003:l013","ordinal":115841,"en":"Chubak, whose spear had broken,"},{"id":"semetey-1-2013:p0508:b003:l014","ordinal":115842,"en":"I tormented, wretched me."},{"id":"semetey-1-2013:p0508:b003:l015","ordinal":115843,"en":"At Chubak, who acted like a giant,"},{"id":"semetey-1-2013:p0508:b003:l016","ordinal":115844,"en":"The thoroughbred beneath me"},{"id":"semetey-1-2013:p0508:b003:l017","ordinal":115845,"en":"I lashed with my whip on either side,"},{"id":"semetey-1-2013:p0508:b003:l018","ordinal":115846,"en":"Spurring to right and left,"},{"id":"semetey-1-2013:p0508:b003:l019","ordinal":115847,"en":"Not looking around me,"},{"id":"semetey-1-2013:p0508:b003:l020","ordinal":115848,"en":"Not sparing my life at all,"},{"id":"semetey-1-2013:p0508:b003:l021","ordinal":115849,"en":"Not casting a glance about,"},{"id":"semetey-1-2013:p0508:b003:l022","ordinal":115850,"en":"Not sparing my life a hair's breadth,"},{"id":"semetey-1-2013:p0508:b003:l023","ordinal":115851,"en":"Not valuing my blood at a spoonful,"},{"id":"semetey-1-2013:p0508:b003:l024","ordinal":115852,"en":"Not sparing my life at all."},{"id":"semetey-1-2013:p0508:b003:l025","ordinal":115853,"en":"Chubak, whose spear had broken—"},{"id":"semetey-1-2013:p0508:b003:l026","ordinal":115854,"en":"Did you see how helpless he became,"},{"id":"semetey-1-2013:p0508:b003:l027","ordinal":115855,"en":"That unruly son of Akbaltay?"},{"id":"semetey-1-2013:p0508:b003:l028","ordinal":115856,"en":"Down the saddle-shaped ridge,"},{"id":"semetey-1-2013:p0508:b003:l029","ordinal":115857,"en":"When Chubak bent and rode,"},{"id":"semetey-1-2013:p0508:b003:l030","ordinal":115858,"en":"Your mother pursued behind him."},{"id":"semetey-1-2013:p0508:b003:l031","ordinal":115859,"en":"To hero Chubak, in this way,"},{"id":"semetey-1-2013:p0508:b003:l032","ordinal":115860,"en":"When I played this sport upon him,"},{"id":"semetey-1-2013:p0508:b003:l033","ordinal":115861,"en":"On the black, white-blazed thoroughbred,"},{"id":"semetey-1-2013:p0508:b003:l034","ordinal":115862,"en":"From the saddle-shaped pass,"},{"id":"semetey-1-2013:p0508:b003:l035","ordinal":115863,"en":"I reached him faster than an arrow."},{"id":"semetey-1-2013:p0508:b003:l036","ordinal":115864,"en":"Holding my painted spear ready,"},{"id":"semetey-1-2013:p0508:b003:l037","ordinal":115865,"en":"Reeling Chubak"},{"id":"semetey-1-2013:p0508:b003:l038","ordinal":115866,"en":"I struck as I passed."},{"id":"semetey-1-2013:p0508:b003:l039","ordinal":115867,"en":"His eyes rolled wildly,"},{"id":"semetey-1-2013:p0508:b004:l001","ordinal":115868,"en":"His legs hung loose."},{"id":"semetey-1-2013:p0508:b004:l002","ordinal":115869,"en":"The sloping yellow valley—"},{"id":"semetey-1-2013:p0508:b004:l003","ordinal":115870,"en":"I thought to bend down and make sport."},{"id":"semetey-1-2013:p0508:b004:l004","ordinal":115871,"en":"Akbaltay's lion,"},{"id":"semetey-1-2013:p0508:b004:l005","ordinal":115872,"en":"If he fell into my hands now,"},{"id":"semetey-1-2013:p0508:b004:l006","ordinal":115873,"en":"I thought to slaughter as a sacrifice,"},{"id":"semetey-1-2013:p0508:b004:l007","ordinal":115874,"en":"And before my father, Khan Temir,"},{"id":"semetey-1-2013:p0508:b004:l008","ordinal":115875,"en":"To go proclaiming glad news."},{"id":"semetey-1-2013:p0508:b004:l009","ordinal":115876,"en":"Khan Baltay's son,"},{"id":"semetey-1-2013:p0508:b004:l010","ordinal":115877,"en":"At least I would make him never come a second time."},{"id":"semetey-1-2013:p0508:b004:l012","ordinal":115878,"en":"My son, when that quarrel first began,"},{"id":"semetey-1-2013:p0508:b004:l014","ordinal":115879,"en":"Khan Baltay's son—"},{"id":"semetey-1-2013:p0508:b004:l015","ordinal":115880,"en":"Your poor mother Kanykey,"},{"id":"semetey-1-2013:p0508:b004:l016","ordinal":115881,"en":"As I drove him before me,"},{"id":"semetey-1-2013:p0508:b004:l017","ordinal":115882,"en":"Without killing or losing him,"},{"id":"semetey-1-2013:p0508:b004:l018","ordinal":115883,"en":"Chubak, who acted like a king,"},{"id":"semetey-1-2013:p0508:b004:l019","ordinal":115884,"en":"I thought to capture alive."},{"id":"semetey-1-2013:p0508:b004:l020","ordinal":115885,"en":"Into Bukhara's dungeon, forty rope-lengths deep,"},{"id":"semetey-1-2013:p0508:b004:l021","ordinal":115886,"en":"I would cast him alive in torment."},{"id":"semetey-1-2013:p0508:b004:l022","ordinal":115887,"en":"His father Akbaltay's vast wealth,"},{"id":"semetey-1-2013:p0508:b004:l023","ordinal":115888,"en":"Saying, 'Your son is alive with us,'"},{"id":"semetey-1-2013:p0508:b004:l024","ordinal":115889,"en":"I would take as a reward for glad news."},{"id":"semetey-1-2013:p0508:b004:l025","ordinal":115890,"en":"For seven days I would beat him down,"},{"id":"semetey-1-2013:p0508:b004:l026","ordinal":115891,"en":"Or else Chubak"},{"id":"semetey-1-2013:p0508:b004:l027","ordinal":115892,"en":"I would leave utterly downcast."},{"id":"semetey-1-2013:p0508:b004:l028","ordinal":115893,"en":"When we entered the descent,"},{"id":"semetey-1-2013:p0508:b004:l029","ordinal":115894,"en":"Your mother's thoroughbred"},{"id":"semetey-1-2013:p0508:b004:l030","ordinal":115895,"en":"Planted its forelegs like a roe deer."},{"id":"semetey-1-2013:p0508:b004:l031","ordinal":115896,"en":"When we headed uphill,"},{"id":"semetey-1-2013:p0508:b004:l032","ordinal":115897,"en":"Hero Chubak's Kokala"},{"id":"semetey-1-2013:p0508:b004:l033","ordinal":115898,"en":"Spread its mane and tail."},{"id":"semetey-1-2013:p0508:b004:l034","ordinal":115899,"en":"When we reached the rounded hillocks,"},{"id":"semetey-1-2013:p0508:b004:l035","ordinal":115900,"en":"This mother's thoroughbred"},{"id":"semetey-1-2013:p0508:b004:l036","ordinal":115901,"en":"Bulged its neck like a bull."},{"id":"semetey-1-2013:p0508:b004:l037","ordinal":115902,"en":"When the hero leaned upon him,"},{"id":"semetey-1-2013:p0508:b004:l038","ordinal":115903,"en":"Khan Chubak's Kokala"},{"id":"semetey-1-2013:p0508:b004:l039","ordinal":115904,"en":"Flashed its eyes like flint."},{"id":"semetey-1-2013:p0509:b003:l001","ordinal":115905,"en":"Driving him over Arstanbap,"},{"id":"semetey-1-2013:p0509:b003:l002","ordinal":115906,"en":"I pursued Chubak without mercy,"},{"id":"semetey-1-2013:p0509:b003:l003","ordinal":115907,"en":"Across the gray plain of Andijan."},{"id":"semetey-1-2013:p0509:b003:l004","ordinal":115908,"en":"When we entered the descent,"},{"id":"semetey-1-2013:p0509:b003:l005","ordinal":115909,"en":"Kanykey's thoroughbred"},{"id":"semetey-1-2013:p0509:b003:l006","ordinal":115910,"en":"Drew closer and closer."},{"id":"semetey-1-2013:p0509:b003:l007","ordinal":115911,"en":"When we headed uphill,"},{"id":"semetey-1-2013:p0509:b003:l008","ordinal":115912,"en":"Khan Chubak's Kokala"},{"id":"semetey-1-2013:p0509:b003:l009","ordinal":115913,"en":"Sped away like a shimmer."},{"id":"semetey-1-2013:p0509:b003:l010","ordinal":115914,"en":"No hill the size of a knucklebone,"},{"id":"semetey-1-2013:p0509:b003:l011","ordinal":115915,"en":"No hollow the size of a saddlecloth,"},{"id":"semetey-1-2013:p0509:b003:l012","ordinal":115916,"en":"No furrow drawn by a plow,"},{"id":"semetey-1-2013:p0509:b003:l013","ordinal":115917,"en":"No burrow dug by a marmot,"},{"id":"semetey-1-2013:p0509:b003:l014","ordinal":115918,"en":"No stone to crack a marrowbone,"},{"id":"semetey-1-2013:p0509:b003:l015","ordinal":115919,"en":"No swelling marsh hummock."},{"id":"semetey-1-2013:p0509:b003:l016","ordinal":115920,"en":"Wild ducks grew weary flying there;"},{"id":"semetey-1-2013:p0509:b003:l017","ordinal":115921,"en":"When black crows flew,"},{"id":"semetey-1-2013:p0509:b003:l018","ordinal":115922,"en":"Their wings tired in the desert."},{"id":"semetey-1-2013:p0509:b003:l019","ordinal":115923,"en":"If a lapwing flew, it cried out;"},{"id":"semetey-1-2013:p0509:b003:l020","ordinal":115924,"en":"A vulture could not fly across—"},{"id":"semetey-1-2013:p0509:b003:l021","ordinal":115925,"en":"Its wings withered on the way."},{"id":"semetey-1-2013:p0509:b003:l022","ordinal":115926,"en":"Where a raven goes, its ears,"},{"id":"semetey-1-2013:p0509:b003:l023","ordinal":115927,"en":"A wild ass's hooves as it traveled"},{"id":"semetey-1-2013:p0509:b003:l024","ordinal":115928,"en":"Were burned in that desert."},{"id":"semetey-1-2013:p0509:b003:l025","ordinal":115929,"en":"From the ridge of Andijan,"},{"id":"semetey-1-2013:p0509:b003:l026","ordinal":115930,"en":"Stubbornly I leveled my spear."},{"id":"semetey-1-2013:p0509:b003:l027","ordinal":115931,"en":"Chubak's home was spacious Kashgar;"},{"id":"semetey-1-2013:p0509:b003:l028","ordinal":115932,"en":"I chased him toward Alay."},{"id":"semetey-1-2013:p0509:b003:l029","ordinal":115933,"en":"That blustering Chubak,"},{"id":"semetey-1-2013:p0509:b003:l030","ordinal":115934,"en":"I thought to pursue to Oygut,"},{"id":"semetey-1-2013:p0509:b003:l031","ordinal":115935,"en":"To fight ten days in Oygut,"},{"id":"semetey-1-2013:p0509:b003:l032","ordinal":115936,"en":"And make terrible sport of him."},{"id":"semetey-1-2013:p0509:b003:l033","ordinal":115937,"en":"As I rushed in, raging,"},{"id":"semetey-1-2013:p0509:b003:l034","ordinal":115938,"en":"From the ridge of Andijan,"},{"id":"semetey-1-2013:p0509:b003:l035","ordinal":115939,"en":"Where holy men had spent the night,"},{"id":"semetey-1-2013:p0509:b003:l036","ordinal":115940,"en":"From the place they had made a shrine,"},{"id":"semetey-1-2013:p0509:b003:l037","ordinal":115941,"en":"I saw a landmark, I saw a ridge,"},{"id":"semetey-1-2013:p0509:b003:l038","ordinal":115942,"en":"I saw a lion surpassing mortals."},{"id":"semetey-1-2013:p0509:b003:l039","ordinal":115943,"en":"His wide eyes were like Venus,"},{"id":"semetey-1-2013:p0509:b004:l001","ordinal":115944,"en":"And his great ears were like shields."},{"id":"semetey-1-2013:p0509:b004:l002","ordinal":115945,"en":"His size equaled a mountain;"},{"id":"semetey-1-2013:p0509:b004:l003","ordinal":115946,"en":"He seemed able to devour anyone he met."},{"id":"semetey-1-2013:p0509:b004:l004","ordinal":115947,"en":"Those who saw his majesty were afraid."},{"id":"semetey-1-2013:p0509:b004:l005","ordinal":115948,"en":"He had studied five years in Mecca,"},{"id":"semetey-1-2013:p0509:b004:l006","ordinal":115949,"en":"Received a document from the caliph,"},{"id":"semetey-1-2013:p0509:b004:l007","ordinal":115950,"en":"And a blessing from the prince."},{"id":"semetey-1-2013:p0509:b004:l008","ordinal":115951,"en":"He was called a renowned mighty hero."},{"id":"semetey-1-2013:p0509:b004:l009","ordinal":115952,"en":"He followed twelve spiritual masters."},{"id":"semetey-1-2013:p0509:b004:l010","ordinal":115953,"en":"When setting out, he was worth a countless host."},{"id":"semetey-1-2013:p0509:b004:l011","ordinal":115954,"en":"Naked Kyzyr had opened his way."},{"id":"semetey-1-2013:p0509:b004:l012","ordinal":115955,"en":"What twelve ages had never wrought,"},{"id":"semetey-1-2013:p0509:b004:l013","ordinal":115956,"en":"None remained who could withstand him."},{"id":"semetey-1-2013:p0509:b004:l014","ordinal":115957,"en":"Fortune favored him in everything."},{"id":"semetey-1-2013:p0509:b004:l015","ordinal":115958,"en":"He was a lion favored with victory."},{"id":"semetey-1-2013:p0509:b004:l016","ordinal":115959,"en":"Finding no mountain to strike against,"},{"id":"semetey-1-2013:p0509:b004:l017","ordinal":115960,"en":"Finding no enemy to fight,"},{"id":"semetey-1-2013:p0509:b004:l018","ordinal":115961,"en":"Having taken and subdued Andijan,"},{"id":"semetey-1-2013:p0509:b004:l019","ordinal":115962,"en":"It was your father himself, Khan Manas."},{"id":"semetey-1-2013:p0509:b004:l020","ordinal":115963,"en":"Watching the patrol, ranging the land,"},{"id":"semetey-1-2013:p0509:b004:l021","ordinal":115964,"en":"Your hero was out keeping watch."},{"id":"semetey-1-2013:p0509:b004:l023","ordinal":115965,"en":"His face was like oiled wheat,"},{"id":"semetey-1-2013:p0509:b004:l024","ordinal":115966,"en":"His eyes like twilight mist."},{"id":"semetey-1-2013:p0509:b004:l025","ordinal":115967,"en":"When he turned his front,"},{"id":"semetey-1-2013:p0509:b004:l026","ordinal":115968,"en":"He had the form of a lion;"}]
