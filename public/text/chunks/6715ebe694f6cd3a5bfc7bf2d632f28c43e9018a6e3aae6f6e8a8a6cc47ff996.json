[{"id":"sayakbay-ms-current144:pdf152:l014","ordinal":394753,"en":"They would die rather than abandon it."},{"id":"sayakbay-ms-current144:pdf152:l015","ordinal":394754,"en":"[Hard and blue as blue iron],"},{"id":"sayakbay-ms-current144:pdf152:l016","ordinal":394755,"en":"Utterly firm in their promises,"},{"id":"sayakbay-ms-current144:pdf152:l017","ordinal":394756,"en":"[Those skilled at close grappling],"},{"id":"sayakbay-ms-current144:pdf152:l018","ordinal":394757,"en":"The finest at shedding blood,"},{"id":"sayakbay-ms-current144:pdf152:l019","ordinal":394758,"en":"Those asking where disaster lay,"},{"id":"sayakbay-ms-current144:pdf152:l020","ordinal":394759,"en":"If Ak Joltoy fell into their hands,"},{"id":"sayakbay-ms-current144:pdf152:l021","ordinal":394760,"en":"They would eat him raw."},{"id":"sayakbay-ms-current144:pdf152:l022","ordinal":394761,"en":"The warrior's name was Great Balban."},{"id":"sayakbay-ms-current144:pdf152:l023","ordinal":394762,"en":"For the lone champion Joltoy,"},{"id":"sayakbay-ms-current144:pdf152:l024","ordinal":394763,"en":"The great conflict became a burden."},{"id":"sayakbay-ms-current144:pdf152:l025","ordinal":394764,"en":"The wrestlers roared,"},{"id":"sayakbay-ms-current144:pdf152:l026","ordinal":394765,"en":"[With a battle cry, they bent him],"},{"id":"sayakbay-ms-current144:pdf152:l027","ordinal":394766,"en":"[Charging at the order to overwhelm him],"},{"id":"sayakbay-ms-current144:pdf152:l028","ordinal":394767,"en":"[The wrestlers who had not yet swarmed]."},{"id":"sayakbay-ms-current144:pdf153:l001","ordinal":394768,"en":"[There is sorrow within me]."},{"id":"sayakbay-ms-current144:pdf153:l002","ordinal":394769,"en":"The great rhinoceros-steed beneath him,"},{"id":"sayakbay-ms-current144:pdf153:l003","ordinal":394770,"en":"[The mule's foal collapsed],"},{"id":"sayakbay-ms-current144:pdf153:l005","ordinal":394771,"en":"Only a spoonful of blood remained."},{"id":"sayakbay-ms-current144:pdf153:l007","ordinal":394772,"en":"[His sinews were torn apart],"},{"id":"sayakbay-ms-current144:pdf153:l008","ordinal":394773,"en":"[My eyes have become flattened],"},{"id":"sayakbay-ms-current144:pdf153:l009","ordinal":394774,"en":"[I myself have become bent],"},{"id":"sayakbay-ms-current144:pdf153:l011","ordinal":394775,"en":"My ribs are shattered and cracking,"},{"id":"sayakbay-ms-current144:pdf153:l013","ordinal":394776,"en":"[Parted from my warrior],"},{"id":"sayakbay-ms-current144:pdf153:l016","ordinal":394777,"en":"[Seeking a distant place],"},{"id":"sayakbay-ms-current144:pdf153:l017","ordinal":394778,"en":"The wide world has grown narrow,"},{"id":"sayakbay-ms-current144:pdf153:l018","ordinal":394779,"en":"[No sustenance helps me stand],"},{"id":"sayakbay-ms-current144:pdf153:l019","ordinal":394780,"en":"Yearning for a single swallow."},{"id":"sayakbay-ms-current144:pdf153:l020","ordinal":394781,"en":"My efforts exhausted, my strength gone,"},{"id":"sayakbay-ms-current144:pdf153:l023","ordinal":394782,"en":"Swarm him and thrust your spears,"},{"id":"sayakbay-ms-current144:pdf153:l024","ordinal":394783,"en":"That bastard Joltoy,"},{"id":"sayakbay-ms-current144:pdf153:l026","ordinal":394784,"en":"[Tear all the curs apart],"},{"id":"sayakbay-ms-current144:pdf153:l027","ordinal":394785,"en":"[Scatter them and burn their roots]."},{"id":"sayakbay-ms-current144:pdf154:l002","ordinal":394786,"en":"[Place his punishment in our hands]."},{"id":"sayakbay-ms-current144:pdf154:l003","ordinal":394787,"en":"Of the lone scourge Joltoy,"},{"id":"sayakbay-ms-current144:pdf154:l004","ordinal":394788,"en":"[Make his strides stretch wide]."},{"id":"sayakbay-ms-current144:pdf154:l005","ordinal":394789,"en":"Your elder Bilgich,"},{"id":"sayakbay-ms-current144:pdf154:l006","ordinal":394790,"en":"From the tormenting hell he has met,"},{"id":"sayakbay-ms-current144:pdf154:l007","ordinal":394791,"en":"Rescue him."},{"id":"sayakbay-ms-current144:pdf154:l012","ordinal":394792,"en":"That he was suffering severe hardship,"},{"id":"sayakbay-ms-current144:pdf154:l014","ordinal":394793,"en":"Would the wrestlers stand without attacking?"},{"id":"sayakbay-ms-current144:pdf154:l017","ordinal":394794,"en":"Would they refrain from swarming?"},{"id":"sayakbay-ms-current144:pdf154:l018","ordinal":394795,"en":"[The wretches had death in their eyes],"},{"id":"sayakbay-ms-current144:pdf154:l019","ordinal":394796,"en":"The bloodthirsty troops attacked together,"},{"id":"sayakbay-ms-current144:pdf154:l020","ordinal":394797,"en":"Against the chief warrior Joltoy,"},{"id":"sayakbay-ms-current144:pdf154:l021","ordinal":394798,"en":"[The lord vanished, coming out straight],"},{"id":"sayakbay-ms-current144:pdf154:l022","ordinal":394799,"en":"That was the moment of the great struggle."},{"id":"sayakbay-ms-current144:pdf154:l023","ordinal":394800,"en":"Such was the course of the fight."},{"id":"sayakbay-ms-current144:pdf154:l027","ordinal":394801,"en":"Who began a furious conflict,"},{"id":"sayakbay-ms-current144:pdf155:l002","ordinal":394802,"en":"[A great tumult of hacking and cutting],"},{"id":"sayakbay-ms-current144:pdf155:l003","ordinal":394803,"en":"[The mighty wrestler began],"},{"id":"sayakbay-ms-current144:pdf155:l005","ordinal":394804,"en":"The wrestlers began their battle."},{"id":"sayakbay-ms-current144:pdf155:l006","ordinal":394805,"en":"Against the lone warrior Joltoy,"},{"id":"sayakbay-ms-current144:pdf155:l007","ordinal":394806,"en":"[Against the champion in woven armor],"},{"id":"sayakbay-ms-current144:pdf155:l009","ordinal":394807,"en":"Standing face to face,"},{"id":"sayakbay-ms-current144:pdf155:l010","ordinal":394808,"en":"Firing guns and drawing bows,"},{"id":"sayakbay-ms-current144:pdf155:l011","ordinal":394809,"en":"Fighting with clattering blows,"},{"id":"sayakbay-ms-current144:pdf155:l013","ordinal":394810,"en":"Their Bilgich, who was nearly lost,"},{"id":"sayakbay-ms-current144:pdf155:l017","ordinal":394811,"en":"Could there be such torment?"},{"id":"sayakbay-ms-current144:pdf155:l019","ordinal":394812,"en":"[Chest, battered by their blows],"},{"id":"sayakbay-ms-current144:pdf155:l020","ordinal":394813,"en":"Drawing bows, making rain,"},{"id":"sayakbay-ms-current144:pdf155:l021","ordinal":394814,"en":"Shooting bullets like hail,"},{"id":"sayakbay-ms-current144:pdf155:l022","ordinal":394815,"en":"Thrusting spears and striking axes,"},{"id":"sayakbay-ms-current144:pdf155:l023","ordinal":394816,"en":"[Pressing him with grievous strife],"},{"id":"sayakbay-ms-current144:pdf155:l024","ordinal":394817,"en":"Your fearless elder Joltoy,"},{"id":"sayakbay-ms-current144:pdf155:l025","ordinal":394818,"en":"[Attacking without waiting his turn],"},{"id":"sayakbay-ms-current144:pdf155:l026","ordinal":394819,"en":"[His eyes clouded and bound],"},{"id":"sayakbay-ms-current144:pdf155:l027","ordinal":394820,"en":"If you saw it, this was dire hardship."},{"id":"sayakbay-ms-current144:pdf156:l002","ordinal":394821,"en":"Kulan Sur beneath him,"},{"id":"sayakbay-ms-current144:pdf156:l004","ordinal":394822,"en":"Though an animal, this creature,"},{"id":"sayakbay-ms-current144:pdf156:l005","ordinal":394823,"en":"[Stood firm against the danger],"},{"id":"sayakbay-ms-current144:pdf156:l007","ordinal":394824,"en":"[Knowing it, he darted aside],"},{"id":"sayakbay-ms-current144:pdf156:l011","ordinal":394825,"en":"Who had seen such an ordeal?"},{"id":"sayakbay-ms-current144:pdf156:l012","ordinal":394826,"en":"[His precious body full of holes],"},{"id":"sayakbay-ms-current144:pdf156:l013","ordinal":394827,"en":"A disastrous, grievous, great conflict,"},{"id":"sayakbay-ms-current144:pdf156:l015","ordinal":394828,"en":"[All the blood washed away],"},{"id":"sayakbay-ms-current144:pdf156:l016","ordinal":394829,"en":"All his clothing torn,"},{"id":"sayakbay-ms-current144:pdf156:l017","ordinal":394830,"en":"Iron ropes and little nets,"},{"id":"sayakbay-ms-current144:pdf156:l018","ordinal":394831,"en":"When they cast their nets together,"},{"id":"sayakbay-ms-current144:pdf156:l019","ordinal":394832,"en":"[Armored wrestler] Great Bilgich,"},{"id":"sayakbay-ms-current144:pdf156:l020","ordinal":394833,"en":"Urged on many wrestlers,"},{"id":"sayakbay-ms-current144:pdf156:l021","ordinal":394834,"en":"Bringing great conflict upon Joltoy."},{"id":"sayakbay-ms-current144:pdf156:l022","ordinal":394835,"en":"As Joltoy was about to depart,"},{"id":"sayakbay-ms-current144:pdf156:l023","ordinal":394836,"en":"As his death was about to arrive,"},{"id":"sayakbay-ms-current144:pdf156:l024","ordinal":394837,"en":"More and more, Bilgich's,"},{"id":"sayakbay-ms-current144:pdf156:l025","ordinal":394838,"en":"Marksmanship grew fiercer,"},{"id":"sayakbay-ms-current144:pdf156:l026","ordinal":394839,"en":"Hastening in the direction he faced,"},{"id":"sayakbay-ms-current144:pdf156:l027","ordinal":394840,"en":"When he brought unending hardship,"},{"id":"sayakbay-ms-current144:pdf156:l028","ordinal":394841,"en":"The renowned wondrous steed Kulan Sur,"},{"id":"sayakbay-ms-current144:pdf157:l002","ordinal":394842,"en":"[Across the wide-open charge],"},{"id":"sayakbay-ms-current144:pdf157:l003","ordinal":394843,"en":"[How could the courser break away],"},{"id":"sayakbay-ms-current144:pdf157:l004","ordinal":394844,"en":"[With a stone ridge ahead],"},{"id":"sayakbay-ms-current144:pdf157:l005","ordinal":394845,"en":"It was a path for a single horse."},{"id":"sayakbay-ms-current144:pdf157:l006","ordinal":394846,"en":"Your elder Joltoy was trapped,"},{"id":"sayakbay-ms-current144:pdf157:l007","ordinal":394847,"en":"Wedged within their encirclement,"},{"id":"sayakbay-ms-current144:pdf157:l011","ordinal":394848,"en":"This world is a merchant,"},{"id":"sayakbay-ms-current144:pdf157:l012","ordinal":394849,"en":"Its falsehood became apparent."},{"id":"sayakbay-ms-current144:pdf157:l013","ordinal":394850,"en":"When the wrestlers stood surrounding him,"},{"id":"sayakbay-ms-current144:pdf157:l014","ordinal":394851,"en":"[No hope for his flylike life],"},{"id":"sayakbay-ms-current144:pdf157:l015","ordinal":394852,"en":"[The reason it had vanished],"},{"id":"sayakbay-ms-current144:pdf157:l016","ordinal":394853,"en":"The two arms that gave him strength,"},{"id":"sayakbay-ms-current144:pdf157:l017","ordinal":394854,"en":"Were motionless and paralyzed."},{"id":"sayakbay-ms-current144:pdf157:l018","ordinal":394855,"en":"His precious head, his support for standing,"},{"id":"sayakbay-ms-current144:pdf157:l019","ordinal":394856,"en":"Became a red bucket of blood."},{"id":"sayakbay-ms-current144:pdf157:l020","ordinal":394857,"en":"His entire body,"},{"id":"sayakbay-ms-current144:pdf157:l021","ordinal":394858,"en":"Was motionless and paralyzed."},{"id":"sayakbay-ms-current144:pdf157:l022","ordinal":394859,"en":"The dear white-capped Kyrgyz people,"},{"id":"sayakbay-ms-current144:pdf157:l024","ordinal":394860,"en":"Looking around, there was no mountain,"},{"id":"sayakbay-ms-current144:pdf157:l025","ordinal":394861,"en":"[No company to march with],"},{"id":"sayakbay-ms-current144:pdf157:l026","ordinal":394862,"en":"[The five could not advance],"},{"id":"sayakbay-ms-current144:pdf157:l028","ordinal":394863,"en":"His dear warrior Seitek was absent,"},{"id":"sayakbay-ms-current144:pdf158:l001","ordinal":394864,"en":"[Chinese bones from the earth],"},{"id":"sayakbay-ms-current144:pdf158:l002","ordinal":394865,"en":"[Will they be buried together],"},{"id":"sayakbay-ms-current144:pdf158:l003","ordinal":394866,"en":"Ak Joltoy, a champion of honor,"},{"id":"sayakbay-ms-current144:pdf158:l004","ordinal":394867,"en":"God decreed this for him."},{"id":"sayakbay-ms-current144:pdf158:l006","ordinal":394868,"en":"Will he see a way back?"},{"id":"sayakbay-ms-current144:pdf158:l007","ordinal":394869,"en":"[Do not exhaust your soul with stratagems],"},{"id":"sayakbay-ms-current144:pdf158:l008","ordinal":394870,"en":"[Will he die at your feet],"},{"id":"sayakbay-ms-current144:pdf158:l009","ordinal":394871,"en":"Biting their fingers and shaking their heads,"},{"id":"sayakbay-ms-current144:pdf158:l011","ordinal":394872,"en":"[Alas, let me confront this age],"},{"id":"sayakbay-ms-current144:pdf158:l013","ordinal":394873,"en":"[Meeting with calamity],"},{"id":"sayakbay-ms-current144:pdf158:l014","ordinal":394874,"en":"Will your death arrive on the road?"},{"id":"sayakbay-ms-current144:pdf158:l015","ordinal":394875,"en":"These Chinese who became enemies,"},{"id":"sayakbay-ms-current144:pdf158:l016","ordinal":394876,"en":"[Will they kill him so easily]?"},{"id":"sayakbay-ms-current144:pdf158:l019","ordinal":394877,"en":"[Weakening, saying none remained standing],"},{"id":"sayakbay-ms-current144:pdf158:l020","ordinal":394878,"en":"As Joltoy stood [dazed],"},{"id":"sayakbay-ms-current144:pdf158:l021","ordinal":394879,"en":"The hero's son, warrior Seitek,"},{"id":"sayakbay-ms-current144:pdf158:l022","ordinal":394880,"en":"Unable to turn Kulunsur's head,"},{"id":"sayakbay-ms-current144:pdf158:l023","ordinal":394881,"en":"May God protect him!"},{"id":"sayakbay-ms-current144:pdf158:l024","ordinal":394882,"en":"Saying, where is Joltoy, my joy?"},{"id":"sayakbay-ms-current144:pdf158:l025","ordinal":394883,"en":"[The fierce warrior could not stand still],"},{"id":"sayakbay-ms-current144:pdf158:l026","ordinal":394884,"en":"[Wearing a golden robe],"},{"id":"sayakbay-ms-current144:pdf158:l027","ordinal":394885,"en":"Riding a pale gray horse like water,"},{"id":"sayakbay-ms-current144:pdf159:l001","ordinal":394886,"en":"Traveling day and night,"},{"id":"sayakbay-ms-current144:pdf159:l002","ordinal":394887,"en":"Wearing out his horse, traversing the land,"},{"id":"sayakbay-ms-current144:pdf159:l004","ordinal":394888,"en":"[Readying what he would shoot],"},{"id":"sayakbay-ms-current144:pdf159:l005","ordinal":394889,"en":"[Finding a pass among cliffs and hills],"},{"id":"sayakbay-ms-current144:pdf159:l006","ordinal":394890,"en":"[Rattling the horse's harness],"},{"id":"sayakbay-ms-current144:pdf159:l009","ordinal":394891,"en":"Muttering and rumbling,"},{"id":"sayakbay-ms-current144:pdf159:l010","ordinal":394892,"en":"[Changing as his horse grew weary],"},{"id":"sayakbay-ms-current144:pdf159:l012","ordinal":394893,"en":"To reach the distant figure,"},{"id":"sayakbay-ms-current144:pdf159:l013","ordinal":394894,"en":"Asking whether he was dead or alive,"},{"id":"sayakbay-ms-current144:pdf159:l015","ordinal":394895,"en":"The straight road of their pursuit,"},{"id":"sayakbay-ms-current144:pdf159:l016","ordinal":394896,"en":"[The poor man estimated its direction],"},{"id":"sayakbay-ms-current144:pdf159:l017","ordinal":394897,"en":"[My cherished] Ak Joltoy,"},{"id":"sayakbay-ms-current144:pdf159:l019","ordinal":394898,"en":"[Making trouble over carrying and binding],"},{"id":"sayakbay-ms-current144:pdf159:l020","ordinal":394899,"en":"[Hoping to reach one elder],"},{"id":"sayakbay-ms-current144:pdf159:l023","ordinal":394900,"en":"[The dear one stood astray],"},{"id":"sayakbay-ms-current144:pdf159:l024","ordinal":394901,"en":"[Your courser, straight from its origin],"},{"id":"sayakbay-ms-current144:pdf159:l025","ordinal":394902,"en":"[Protecting the people against invading foes],"},{"id":"sayakbay-ms-current144:pdf159:l026","ordinal":394903,"en":"Saying, the only one left by your father,"},{"id":"sayakbay-ms-current144:pdf159:l027","ordinal":394904,"en":"[My dear lord] Ak Joltoy,"},{"id":"sayakbay-ms-current144:pdf159:l028","ordinal":394905,"en":"[Thinking of his dear fierce warrior],"},{"id":"sayakbay-ms-current144:pdf160:l001","ordinal":394906,"en":"The reason Ak Joltoy was admirable,"},{"id":"sayakbay-ms-current144:pdf160:l002","ordinal":394907,"en":"His eyes saw from afar,"},{"id":"sayakbay-ms-current144:pdf160:l003","ordinal":394908,"en":"When great difficulty in word or deed arose,"},{"id":"sayakbay-ms-current144:pdf160:l004","ordinal":394909,"en":"Coming out alone from the contest,"},{"id":"sayakbay-ms-current144:pdf160:l006","ordinal":394910,"en":"His courage was the finest."},{"id":"sayakbay-ms-current144:pdf160:l007","ordinal":394911,"en":"He went without sparing his life, I say."},{"id":"sayakbay-ms-current144:pdf160:l010","ordinal":394912,"en":"He went as far as the khagan, I say."},{"id":"sayakbay-ms-current144:pdf160:l011","ordinal":394913,"en":"He was born to be a protector,"},{"id":"sayakbay-ms-current144:pdf160:l013","ordinal":394914,"en":"[He was the dear people's fortress],"},{"id":"sayakbay-ms-current144:pdf160:l015","ordinal":394915,"en":"[If a giant encircled them],"},{"id":"sayakbay-ms-current144:pdf160:l016","ordinal":394916,"en":"At the moment of clashing,"},{"id":"sayakbay-ms-current144:pdf160:l019","ordinal":394917,"en":"You who created people as living souls,"},{"id":"sayakbay-ms-current144:pdf160:l020","ordinal":394918,"en":"God, please protect Joltoy."},{"id":"sayakbay-ms-current144:pdf160:l021","ordinal":394919,"en":"[Joltoy was the eyes of many],"},{"id":"sayakbay-ms-current144:pdf160:l022","ordinal":394920,"en":"[He was the true inheritance itself],"},{"id":"sayakbay-ms-current144:pdf160:l026","ordinal":394921,"en":"God, please protect Joltoy,"},{"id":"sayakbay-ms-current144:pdf161:l001","ordinal":394922,"en":"Is the valiant Bermet a bad man?"},{"id":"sayakbay-ms-current144:pdf161:l002","ordinal":394923,"en":"The five youths said that Seitek was steadfast."},{"id":"sayakbay-ms-current144:pdf161:l003","ordinal":394924,"en":"You know the measure of his strength."},{"id":"sayakbay-ms-current144:pdf161:l004","ordinal":394925,"en":"At the white horde of his in-laws,"},{"id":"sayakbay-ms-current144:pdf161:l005","ordinal":394926,"en":"he drove the rear of the thousand onward."},{"id":"sayakbay-ms-current144:pdf161:l006","ordinal":394927,"en":"If the rumor about five thousand is true,"},{"id":"sayakbay-ms-current144:pdf161:l007","ordinal":394928,"en":"at dawn, in the year of the camel,"},{"id":"sayakbay-ms-current144:pdf161:l008","ordinal":394929,"en":"making sport with his words,"},{"id":"sayakbay-ms-current144:pdf161:l009","ordinal":394930,"en":"he stands demanding blood-price."},{"id":"sayakbay-ms-current144:pdf161:l010","ordinal":394931,"en":"There is no commoner left to seize."},{"id":"sayakbay-ms-current144:pdf161:l011","ordinal":394932,"en":"“Take hold and surrender me,” he said."},{"id":"sayakbay-ms-current144:pdf161:l012","ordinal":394933,"en":"he makes that his obligation."},{"id":"sayakbay-ms-current144:pdf161:l013","ordinal":394934,"en":"With no supporting host, the poor giant,"},{"id":"sayakbay-ms-current144:pdf161:l015","ordinal":394935,"en":"He stands demanding his blood-price."},{"id":"sayakbay-ms-current144:pdf161:l016","ordinal":394936,"en":"Has God taken Joltoy?"},{"id":"sayakbay-ms-current144:pdf161:l017","ordinal":394937,"en":"So spoke the hero Kunus,"},{"id":"sayakbay-ms-current144:pdf161:l018","ordinal":394938,"en":"that lion-hearted man who did not flinch,"},{"id":"sayakbay-ms-current144:pdf161:l020","ordinal":394939,"en":"Beneath him was the bay Kunan-sur."},{"id":"sayakbay-ms-current144:pdf161:l022","ordinal":394940,"en":"The sandy-colored creature was like shifting sand."},{"id":"sayakbay-ms-current144:pdf161:l023","ordinal":394941,"en":"He swept over the earth like a whirlwind."},{"id":"sayakbay-ms-current144:pdf161:l024","ordinal":394942,"en":"At the mouth of the dark ridge,"},{"id":"sayakbay-ms-current144:pdf161:l025","ordinal":394943,"en":"its hoofbeats clattered like a bell."},{"id":"sayakbay-ms-current144:pdf161:l026","ordinal":394944,"en":"It scorched the stones as though they were silk."},{"id":"sayakbay-ms-current144:pdf161:l027","ordinal":394945,"en":"The beast streamed onward, its soles pounding."},{"id":"sayakbay-ms-current144:pdf162:l001","ordinal":394946,"en":"He galloped until the land turned gray."},{"id":"sayakbay-ms-current144:pdf162:l002","ordinal":394947,"en":"He braced for battle like a spear."},{"id":"sayakbay-ms-current144:pdf162:l003","ordinal":394948,"en":"Across the three branches of the dark earth,"},{"id":"sayakbay-ms-current144:pdf162:l004","ordinal":394949,"en":"the great beast strode swiftly."},{"id":"sayakbay-ms-current144:pdf162:l005","ordinal":394950,"en":"they seemed to have been driven apart."},{"id":"sayakbay-ms-current144:pdf162:l006","ordinal":394951,"en":"Its chest rose like a steep cliff."},{"id":"sayakbay-ms-current144:pdf162:l007","ordinal":394952,"en":"It made the falcon cry out against the rock."},{"id":"sayakbay-ms-current144:pdf162:l008","ordinal":394953,"en":"Without stopping, it ran with a piercing rush."},{"id":"sayakbay-ms-current144:pdf162:l009","ordinal":394954,"en":"A mirage wavered along its road."},{"id":"sayakbay-ms-current144:pdf162:l010","ordinal":394955,"en":"The eagle in the sky"},{"id":"sayakbay-ms-current144:pdf162:l011","ordinal":394956,"en":"appeared as though there were two of them."},{"id":"sayakbay-ms-current144:pdf162:l012","ordinal":394957,"en":"the flowers that Bermet had given"},{"id":"sayakbay-ms-current144:pdf162:l013","ordinal":394958,"en":"looked like the water of paradise."},{"id":"sayakbay-ms-current144:pdf162:l015","ordinal":394959,"en":"he pressed onward with renown."},{"id":"sayakbay-ms-current144:pdf162:l016","ordinal":394960,"en":"Alas, the hero whose father was a khan,"},{"id":"sayakbay-ms-current144:pdf162:l017","ordinal":394961,"en":"shook the whole bright world."},{"id":"sayakbay-ms-current144:pdf162:l019","ordinal":394962,"en":"A mass gathered upon the yellow trail."},{"id":"sayakbay-ms-current144:pdf162:l020","ordinal":394963,"en":"Red was mingled into the yellow."},{"id":"sayakbay-ms-current144:pdf162:l021","ordinal":394964,"en":"A throng gathered on the autumn-colored track."},{"id":"sayakbay-ms-current144:pdf162:l022","ordinal":394965,"en":"They left behind dry sand."},{"id":"sayakbay-ms-current144:pdf162:l023","ordinal":394966,"en":"The mountain road became straight."},{"id":"sayakbay-ms-current144:pdf162:l024","ordinal":394967,"en":"This deed became a torment."},{"id":"sayakbay-ms-current144:pdf162:l025","ordinal":394968,"en":"The fierce one at the pass met the enemy."},{"id":"sayakbay-ms-current144:pdf162:l026","ordinal":394969,"en":"Nine tracks showed the shapes of living men."},{"id":"sayakbay-ms-current144:pdf162:l027","ordinal":394970,"en":"It was to become a great quagmire."},{"id":"sayakbay-ms-current144:pdf163:l001","ordinal":394971,"en":"White foam mingled with the sunlight."},{"id":"sayakbay-ms-current144:pdf163:l002","ordinal":394972,"en":"Seitek’s thirty champions"},{"id":"sayakbay-ms-current144:pdf163:l003","ordinal":394973,"en":"fought upon the open slope."},{"id":"sayakbay-ms-current144:pdf163:l004","ordinal":394974,"en":"They formed a rear guard along the ridge."},{"id":"sayakbay-ms-current144:pdf163:l005","ordinal":394975,"en":"Fearlessly they traveled the road."},{"id":"sayakbay-ms-current144:pdf163:l006","ordinal":394976,"en":"Kulan-sur trampled through the foam."},{"id":"sayakbay-ms-current144:pdf163:l007","ordinal":394977,"en":"The horse opened its eyes wide."},{"id":"sayakbay-ms-current144:pdf163:l008","ordinal":394978,"en":"Untroubled, he could find no arrow that had struck."},{"id":"sayakbay-ms-current144:pdf163:l009","ordinal":394979,"en":"He found no ember left by misfortune."},{"id":"sayakbay-ms-current144:pdf163:l010","ordinal":394980,"en":"The knowing warriors had fearsome strength."},{"id":"sayakbay-ms-current144:pdf163:l011","ordinal":394981,"en":"The hero did not spare the enemy’s life."},{"id":"sayakbay-ms-current144:pdf163:l012","ordinal":394982,"en":"He had him bound by a hair and cast aside."},{"id":"sayakbay-ms-current144:pdf163:l013","ordinal":394983,"en":"He moved then toward Joltoy."},{"id":"sayakbay-ms-current144:pdf163:l014","ordinal":394984,"en":"“Where shall I find the precious one?” he said."},{"id":"sayakbay-ms-current144:pdf163:l015","ordinal":394985,"en":"If noble Joltoy should approach,"},{"id":"sayakbay-ms-current144:pdf163:l016","ordinal":394986,"en":"what kind of battle-axe would meet him?"},{"id":"sayakbay-ms-current144:pdf163:l018","ordinal":394987,"en":"“If he looks, I shall turn back.”"},{"id":"sayakbay-ms-current144:pdf163:l019","ordinal":394988,"en":"“For how many years shall I journey?”"},{"id":"sayakbay-ms-current144:pdf163:l020","ordinal":394989,"en":"He made blood flow in the valley."},{"id":"sayakbay-ms-current144:pdf163:l021","ordinal":394990,"en":"May the torment he feared never come."},{"id":"sayakbay-ms-current144:pdf163:l022","ordinal":394991,"en":"Because of noble Joltoy,"},{"id":"sayakbay-ms-current144:pdf163:l023","ordinal":394992,"en":"may no living soul come against him."},{"id":"sayakbay-ms-current144:pdf163:l024","ordinal":394993,"en":"“Without Seitek, I shall die.”"},{"id":"sayakbay-ms-current144:pdf163:l025","ordinal":394994,"en":"“I will not stand idle; I am his hearth and support.”"},{"id":"sayakbay-ms-current144:pdf163:l026","ordinal":394995,"en":"He journeyed until he reached the people."},{"id":"sayakbay-ms-current144:pdf163:l027","ordinal":394996,"en":"He would suffer the wrath he had stirred."},{"id":"sayakbay-ms-current144:pdf164:l001","ordinal":394997,"en":"How long did he play there?"},{"id":"sayakbay-ms-current144:pdf164:l002","ordinal":394998,"en":"“I am free after taking down the load.”"},{"id":"sayakbay-ms-current144:pdf164:l004","ordinal":394999,"en":"I shall see what stratagem he uses."},{"id":"sayakbay-ms-current144:pdf164:l005","ordinal":395000,"en":"Hero Joltoy struck him."},{"id":"sayakbay-ms-current144:pdf164:l006","ordinal":395001,"en":"May he not surrender the life entrusted to him."},{"id":"sayakbay-ms-current144:pdf164:l007","ordinal":395002,"en":"Let his people become a dark mass."},{"id":"sayakbay-ms-current144:pdf164:l008","ordinal":395003,"en":"Your vast anger rose high."},{"id":"sayakbay-ms-current144:pdf164:l010","ordinal":395004,"en":"Let Seitek act without delay."},{"id":"sayakbay-ms-current144:pdf164:l011","ordinal":395005,"en":"Let him spread out his summer gear."},{"id":"sayakbay-ms-current144:pdf164:l012","ordinal":395006,"en":"Now let the challenger advance."},{"id":"sayakbay-ms-current144:pdf164:l013","ordinal":395007,"en":"Let them grapple until their souls reel."},{"id":"sayakbay-ms-current144:pdf164:l014","ordinal":395008,"en":"If the two still possess their free lives,"}]
