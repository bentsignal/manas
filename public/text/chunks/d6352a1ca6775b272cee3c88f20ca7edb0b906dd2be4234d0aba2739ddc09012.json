[{"id":"semetey-1-2013:p0754:b003:l015","ordinal":134657,"en":"I keep asking God for."},{"id":"semetey-1-2013:p0754:b003:l016","ordinal":134658,"en":"I inquired of knowledgeable men,"},{"id":"semetey-1-2013:p0754:b003:l017","ordinal":134659,"en":"I asked those who knew."},{"id":"semetey-1-2013:p0754:b003:l018","ordinal":134660,"en":"Unable to find a trace of the orphan,"},{"id":"semetey-1-2013:p0754:b003:l019","ordinal":134661,"en":"I withered away like this."},{"id":"semetey-1-2013:p0754:b003:l020","ordinal":134662,"en":"The dear bird called the wild duck"},{"id":"semetey-1-2013:p0754:b003:l021","ordinal":134663,"en":"Flies straight on for the open plain."},{"id":"semetey-1-2013:p0754:b003:l022","ordinal":134664,"en":"Elder, I grieve for the orphan boy."},{"id":"semetey-1-2013:p0754:b003:l023","ordinal":134665,"en":"The dear bird called the little bustard"},{"id":"semetey-1-2013:p0754:b003:l024","ordinal":134666,"en":"Flies swiftly for the open plain."},{"id":"semetey-1-2013:p0754:b003:l025","ordinal":134667,"en":"I become deeply sorrowful"},{"id":"semetey-1-2013:p0754:b003:l026","ordinal":134668,"en":"For the child left by the hero."},{"id":"semetey-1-2013:p0754:b003:l027","ordinal":134669,"en":"The wretched bird called the kite"},{"id":"semetey-1-2013:p0754:b003:l028","ordinal":134670,"en":"Swoops down for food."},{"id":"semetey-1-2013:p0754:b003:l029","ordinal":134671,"en":"The only son Manas had in his troubled days"},{"id":"semetey-1-2013:p0754:b003:l031","ordinal":134672,"en":"Went away in distress because of me."},{"id":"semetey-1-2013:p0754:b003:l032","ordinal":134673,"en":"The dear bird called the goshawk"},{"id":"semetey-1-2013:p0754:b003:l033","ordinal":134674,"en":"Flies straight on for food."},{"id":"semetey-1-2013:p0754:b003:l034","ordinal":134675,"en":"My dear sister-in-law Kanykei"},{"id":"semetey-1-2013:p0754:b003:l035","ordinal":134676,"en":"Took her support and fled,"},{"id":"semetey-1-2013:p0754:b003:l036","ordinal":134677,"en":"Went away offended because of me."},{"id":"semetey-1-2013:p0754:b003:l037","ordinal":134678,"en":"When leopard Manas died,"},{"id":"semetey-1-2013:p0754:b003:l038","ordinal":134679,"en":"Leopard elder, listen!"},{"id":"semetey-1-2013:p0754:b003:l039","ordinal":134680,"en":"They turned the heart of Talas into desert:"},{"id":"semetey-1-2013:p0754:b004:l001","ordinal":134681,"en":"Khan Tekechi, Khan Shygai,"},{"id":"semetey-1-2013:p0754:b004:l002","ordinal":134682,"en":"And Zhamgyrchy close by,"},{"id":"semetey-1-2013:p0754:b004:l003","ordinal":134683,"en":"Spreading slander between us,"},{"id":"semetey-1-2013:p0754:b004:l004","ordinal":134684,"en":"Made the two of us enemies."},{"id":"semetey-1-2013:p0754:b004:l005","ordinal":134685,"en":"'Six thousand ingots and a thousand otter pelts"},{"id":"semetey-1-2013:p0754:b004:l006","ordinal":134686,"en":"Bakai took as a bribe,' they said."},{"id":"semetey-1-2013:p0754:b004:l007","ordinal":134687,"en":"'Tekechi's Ormonbek"},{"id":"semetey-1-2013:p0754:b004:l008","ordinal":134688,"en":"He agreed to let escape,' they said."},{"id":"semetey-1-2013:p0754:b004:l009","ordinal":134689,"en":"We formed opposing factions;"},{"id":"semetey-1-2013:p0754:b004:l010","ordinal":134690,"en":"Malicious, careless talk arose,"},{"id":"semetey-1-2013:p0754:b004:l011","ordinal":134691,"en":"And for twelve years we fought."},{"id":"semetey-1-2013:p0754:b004:l012","ordinal":134692,"en":"Elder Bakai, hear my words."},{"id":"semetey-1-2013:p0754:b004:l013","ordinal":134693,"en":"Since lion Manas's death,"},{"id":"semetey-1-2013:p0754:b004:l014","ordinal":134694,"en":"Not thirty days had passed,"},{"id":"semetey-1-2013:p0754:b004:l015","ordinal":134695,"en":"When, hearing evil rumors,"},{"id":"semetey-1-2013:p0754:b004:l016","ordinal":134696,"en":"Afghanistan and India—"},{"id":"semetey-1-2013:p0754:b004:l017","ordinal":134697,"en":"The peoples of three khans clashed."},{"id":"semetey-1-2013:p0754:b004:l018","ordinal":134698,"en":"They mounted stallions from the tethering line,"},{"id":"semetey-1-2013:p0754:b004:l019","ordinal":134699,"en":"Picked up poles from the ground,"},{"id":"semetey-1-2013:p0754:b004:l020","ordinal":134700,"en":"And fought a terrible battle."},{"id":"semetey-1-2013:p0754:b004:l021","ordinal":134701,"en":"Men died and horses were taken;"},{"id":"semetey-1-2013:p0754:b004:l022","ordinal":134702,"en":"There was endless strife."},{"id":"semetey-1-2013:p0754:b004:l023","ordinal":134703,"en":"Six swift horses arrived,"},{"id":"semetey-1-2013:p0754:b004:l024","ordinal":134704,"en":"And from those people came a palm-sized letter:"},{"id":"semetey-1-2013:p0754:b004:l025","ordinal":134705,"en":"'When Manas died, let not all die with him;"},{"id":"semetey-1-2013:p0754:b004:l026","ordinal":134706,"en":"Do not become like an extinguished fire."},{"id":"semetey-1-2013:p0754:b004:l027","ordinal":134707,"en":"Let one of the chiefs come,' it said,"},{"id":"semetey-1-2013:p0754:b004:l028","ordinal":134708,"en":"'Let him examine this wrong,' it said,"},{"id":"semetey-1-2013:p0754:b004:l029","ordinal":134709,"en":"'The person who acted wrongly,"},{"id":"semetey-1-2013:p0754:b004:l030","ordinal":134710,"en":"Let him rout and crush,' it said,"},{"id":"semetey-1-2013:p0754:b004:l031","ordinal":134711,"en":"'Let him quickly set us straight,' it said."},{"id":"semetey-1-2013:p0754:b004:l032","ordinal":134712,"en":"When their urgent message came,"},{"id":"semetey-1-2013:p0754:b004:l033","ordinal":134713,"en":"Turning Aktelki's head with a lash,"},{"id":"semetey-1-2013:p0754:b004:l034","ordinal":134714,"en":"I rode over to you."},{"id":"semetey-1-2013:p0754:b004:l035","ordinal":134715,"en":"'When the best one dies, let not all die with him;"},{"id":"semetey-1-2013:p0754:b004:l036","ordinal":134716,"en":"Let us not become an extinguished fire."},{"id":"semetey-1-2013:p0754:b004:l037","ordinal":134717,"en":"The peoples of three khans are at war;"},{"id":"semetey-1-2013:p0754:b004:l038","ordinal":134718,"en":"I have heard there is strife."},{"id":"semetey-1-2013:p0754:b004:l039","ordinal":134719,"en":"The support left by Manas,"},{"id":"semetey-1-2013:p0755:b003:l001","ordinal":134720,"en":"My elder Bakai, let us go."},{"id":"semetey-1-2013:p0755:b003:l002","ordinal":134721,"en":"Let us not let Manas's absence be felt."},{"id":"semetey-1-2013:p0755:b003:l003","ordinal":134722,"en":"Come, elder, let us go."},{"id":"semetey-1-2013:p0755:b003:l004","ordinal":134723,"en":"Without sparing the wrongdoers,"},{"id":"semetey-1-2013:p0755:b003:l005","ordinal":134724,"en":"Let us rout and scatter them.'"},{"id":"semetey-1-2013:p0755:b003:l006","ordinal":134725,"en":"That is what I said."},{"id":"semetey-1-2013:p0755:b003:l007","ordinal":134726,"en":"When I spoke, Bakai, you wept,"},{"id":"semetey-1-2013:p0755:b003:l008","ordinal":134727,"en":"Tormenting your precious soul:"},{"id":"semetey-1-2013:p0755:b003:l009","ordinal":134728,"en":"'Hey, Abyke, my dear foal!"},{"id":"semetey-1-2013:p0755:b003:l010","ordinal":134729,"en":"After mountain-like Manas died,"},{"id":"semetey-1-2013:p0755:b003:l011","ordinal":134730,"en":"After Bakai suffered hell,"},{"id":"semetey-1-2013:p0755:b003:l012","ordinal":134731,"en":"Collapse, you and your assembly!"},{"id":"semetey-1-2013:p0755:b003:l013","ordinal":134732,"en":"How can I go to the assembly?"},{"id":"semetey-1-2013:p0755:b003:l014","ordinal":134733,"en":"When mountain-like Manas has died,"},{"id":"semetey-1-2013:p0755:b003:l015","ordinal":134734,"en":"If they say, \"Wretched Bakai, strutting,"},{"id":"semetey-1-2013:p0755:b003:l016","ordinal":134735,"en":"Has ridden to an assembly,\""},{"id":"semetey-1-2013:p0755:b003:l017","ordinal":134736,"en":"I shall die then.'"},{"id":"semetey-1-2013:p0755:b003:l018","ordinal":134737,"en":"You stubbornly refused, elder."},{"id":"semetey-1-2013:p0755:b003:l019","ordinal":134738,"en":"'I shall tend the orphan's camels,' you said,"},{"id":"semetey-1-2013:p0755:b003:l020","ordinal":134739,"en":"And put an end to the talk."},{"id":"semetey-1-2013:p0755:b003:l021","ordinal":134740,"en":"In your place, elder,"},{"id":"semetey-1-2013:p0755:b003:l022","ordinal":134741,"en":"I took Azhybai."},{"id":"semetey-1-2013:p0755:b003:l023","ordinal":134742,"en":"Absent for three or four months,"},{"id":"semetey-1-2013:p0755:b003:l024","ordinal":134743,"en":"To the peoples of the three khans below"},{"id":"semetey-1-2013:p0755:b003:l025","ordinal":134744,"en":"I went as an arbitrator."},{"id":"semetey-1-2013:p0755:b003:l026","ordinal":134745,"en":"By the time I returned from arbitrating,"},{"id":"semetey-1-2013:p0755:b003:l027","ordinal":134746,"en":"Bakai, my refuge, was gone."},{"id":"semetey-1-2013:p0755:b003:l028","ordinal":134747,"en":"The orphan left by Manas was gone;"},{"id":"semetey-1-2013:p0755:b003:l029","ordinal":134748,"en":"My mother Chyiyrdy was gone as well."},{"id":"semetey-1-2013:p0755:b003:l030","ordinal":134749,"en":"Over Zhorgonun-Bel,"},{"id":"semetey-1-2013:p0755:b003:l031","ordinal":134750,"en":"My sorrowful sister-in-law"},{"id":"semetey-1-2013:p0755:b003:l032","ordinal":134751,"en":"You sent fleeing from broad Talas."},{"id":"semetey-1-2013:p0755:b003:l033","ordinal":134752,"en":"Over Kuyuktun-Bel,"},{"id":"semetey-1-2013:p0755:b003:l034","ordinal":134753,"en":"My grieving, fierce sister-in-law"},{"id":"semetey-1-2013:p0755:b003:l035","ordinal":134754,"en":"You sent fleeing from this Talas."},{"id":"semetey-1-2013:p0755:b003:l036","ordinal":134755,"en":"You were a man whose ears heard far;"},{"id":"semetey-1-2013:p0755:b003:l037","ordinal":134756,"en":"You were an old man like a saint."},{"id":"semetey-1-2013:p0755:b003:l038","ordinal":134757,"en":"Have you heard news from Bukhara?"},{"id":"semetey-1-2013:p0755:b003:l039","ordinal":134758,"en":"You were a man like a saint."},{"id":"semetey-1-2013:p0755:b005:l001","ordinal":134759,"en":"Have you been toward Bukhara?"},{"id":"semetey-1-2013:p0755:b005:l002","ordinal":134760,"en":"Have you had news of my sister-in-law?"},{"id":"semetey-1-2013:p0755:b005:l003","ordinal":134761,"en":"Have you set out traveling?"},{"id":"semetey-1-2013:p0755:b005:l004","ordinal":134762,"en":"Have you heard news of the orphan?"},{"id":"semetey-1-2013:p0755:b005:l005","ordinal":134763,"en":"Accomplished elder, Khan Bakai,"},{"id":"semetey-1-2013:p0755:b005:l006","ordinal":134764,"en":"If you have heard news of the orphan,"},{"id":"semetey-1-2013:p0755:b005:l007","ordinal":134765,"en":"As a reward for good news,"},{"id":"semetey-1-2013:p0755:b005:l008","ordinal":134766,"en":"Take my steed Aktelki."},{"id":"semetey-1-2013:p0755:b005:l009","ordinal":134767,"en":"If this gift is too little,"},{"id":"semetey-1-2013:p0755:b005:l010","ordinal":134768,"en":"Take my blood, poured into a leather flask."},{"id":"semetey-1-2013:p0755:b005:l011","ordinal":134769,"en":"From that flowing river and spring,"},{"id":"semetey-1-2013:p0755:b005:l012","ordinal":134770,"en":"Somehow hear an answer for me,"},{"id":"semetey-1-2013:p0755:b005:l013","ordinal":134771,"en":"From the little one found when I was dying.\""},{"id":"semetey-1-2013:p0755:b005:l014","ordinal":134772,"en":"Then Bakai said:"},{"id":"semetey-1-2013:p0755:b005:l015","ordinal":134773,"en":"\"Oh, Abyke, my beloved foal,"},{"id":"semetey-1-2013:p0755:b005:l016","ordinal":134774,"en":"The orphan you seek will be found;"},{"id":"semetey-1-2013:p0755:b005:l017","ordinal":134775,"en":"The lost little one will be met."},{"id":"semetey-1-2013:p0755:b005:l018","ordinal":134776,"en":"If you have a reward for good news, give it now."},{"id":"semetey-1-2013:p0755:b005:l019","ordinal":134777,"en":"Here is your orphan; see him now!\""},{"id":"semetey-1-2013:p0755:b005:l020","ordinal":134778,"en":"When Khan Bakai spoke thus,"},{"id":"semetey-1-2013:p0755:b005:l021","ordinal":134779,"en":"The hairs of his beard separating one by one,"},{"id":"semetey-1-2013:p0755:b005:l022","ordinal":134780,"en":"Abyke trembled and wept,"},{"id":"semetey-1-2013:p0755:b005:l023","ordinal":134781,"en":"His nose running."},{"id":"semetey-1-2013:p0755:b005:l024","ordinal":134782,"en":"'The orphan left by the noble steed!' he said."},{"id":"semetey-1-2013:p0755:b005:l025","ordinal":134783,"en":"Abyke's limbs grew weak;"},{"id":"semetey-1-2013:p0755:b005:l026","ordinal":134784,"en":"Tears poured from his eyes."},{"id":"semetey-1-2013:p0755:b005:l027","ordinal":134785,"en":"He sobbed loudly, beating himself,"},{"id":"semetey-1-2013:p0755:b005:l028","ordinal":134786,"en":"Crying out and pleading with Semetey."},{"id":"semetey-1-2013:p0755:b005:l029","ordinal":134787,"en":"Dear Abyke, take care:"},{"id":"semetey-1-2013:p0755:b005:l030","ordinal":134788,"en":"His heart burned with grief."},{"id":"semetey-1-2013:p0755:b005:l031","ordinal":134789,"en":"His dark eyes, like a saker falcon's,"},{"id":"semetey-1-2013:p0755:b005:l032","ordinal":134790,"en":"Filled with tears without blinking."},{"id":"semetey-1-2013:p0755:b005:l033","ordinal":134791,"en":"\"You went far away, leaving me grieving,"},{"id":"semetey-1-2013:p0755:b005:l034","ordinal":134792,"en":"My dark-marked falcon,"},{"id":"semetey-1-2013:p0755:b005:l035","ordinal":134793,"en":"You have returned to Talas,"},{"id":"semetey-1-2013:p0755:b005:l036","ordinal":134794,"en":"My darling little one!"},{"id":"semetey-1-2013:p0755:b005:l037","ordinal":134795,"en":"My young goshawk left by the falcon,"},{"id":"semetey-1-2013:p0755:b005:l038","ordinal":134796,"en":"My dear unbred noble steed,"},{"id":"semetey-1-2013:p0755:b005:l039","ordinal":134797,"en":"My hoof left by the winged steed,"},{"id":"semetey-1-2013:p0756:b003:l001","ordinal":134798,"en":"My lamp left by Manas, that unbred noble steed,"},{"id":"semetey-1-2013:p0756:b003:l003","ordinal":134799,"en":"My banner fastened to a spear,"},{"id":"semetey-1-2013:p0756:b003:l004","ordinal":134800,"en":"My gift left by the magnanimous one, gone far away,"},{"id":"semetey-1-2013:p0756:b003:l006","ordinal":134801,"en":"Semetey alone, my support!"},{"id":"semetey-1-2013:p0756:b003:l007","ordinal":134802,"en":"Seeing the presence of that only son,"},{"id":"semetey-1-2013:p0756:b003:l008","ordinal":134803,"en":"I burn in flames."},{"id":"semetey-1-2013:p0756:b003:l009","ordinal":134804,"en":"The reason I burn in flames:"},{"id":"semetey-1-2013:p0756:b003:l010","ordinal":134805,"en":"My support left by the only one,"},{"id":"semetey-1-2013:p0756:b003:l011","ordinal":134806,"en":"My morning star beside the moon,"},{"id":"semetey-1-2013:p0756:b003:l012","ordinal":134807,"en":"My cherished sultan left by Manas,"},{"id":"semetey-1-2013:p0756:b003:l014","ordinal":134808,"en":"My sharp-eyed one left by the mighty,"},{"id":"semetey-1-2013:p0756:b003:l015","ordinal":134809,"en":"By precious Manas, that only one,"},{"id":"semetey-1-2013:p0756:b003:l016","ordinal":134810,"en":"My heir left behind,"},{"id":"semetey-1-2013:p0756:b003:l017","ordinal":134811,"en":"My presence bestowed by fate,"},{"id":"semetey-1-2013:p0756:b003:l018","ordinal":134812,"en":"My support left by the hero,"},{"id":"semetey-1-2013:p0756:b003:l019","ordinal":134813,"en":"My falcon flown from the nest,"},{"id":"semetey-1-2013:p0756:b003:l020","ordinal":134814,"en":"My winged steed born among horses."},{"id":"semetey-1-2013:p0756:b003:l021","ordinal":134815,"en":"I tended the treasury for a long time."},{"id":"semetey-1-2013:p0756:b003:l022","ordinal":134816,"en":"The orphan who was my support—"},{"id":"semetey-1-2013:p0756:b003:l023","ordinal":134817,"en":"I wondered whether he would come."},{"id":"semetey-1-2013:p0756:b003:l024","ordinal":134818,"en":"My darling orphan,"},{"id":"semetey-1-2013:p0756:b003:l025","ordinal":134819,"en":"Your countless livestock are with me,"},{"id":"semetey-1-2013:p0756:b003:l026","ordinal":134820,"en":"A trust I have tended."},{"id":"semetey-1-2013:p0756:b003:l027","ordinal":134821,"en":"To Khan Temir's city"},{"id":"semetey-1-2013:p0756:b003:l028","ordinal":134822,"en":"You went wandering, poor little one."},{"id":"semetey-1-2013:p0756:b003:l029","ordinal":134823,"en":"On the hills your horses fill six hosts:"},{"id":"semetey-1-2013:p0756:b003:l030","ordinal":134824,"en":"Moon-marked duns, with mottled heads,"},{"id":"semetey-1-2013:p0756:b003:l031","ordinal":134825,"en":"With thoroughbreds and noble steeds among them."},{"id":"semetey-1-2013:p0756:b003:l032","ordinal":134826,"en":"'My noble orphan will take them,' I thought."},{"id":"semetey-1-2013:p0756:b003:l033","ordinal":134827,"en":"'These horses from the father"},{"id":"semetey-1-2013:p0756:b003:l034","ordinal":134828,"en":"Will remain for the son,' I thought."},{"id":"semetey-1-2013:p0756:b003:l035","ordinal":134829,"en":"I tended them as a trust."},{"id":"semetey-1-2013:p0756:b003:l036","ordinal":134830,"en":"Leaving your uncle here gazing forlornly,"},{"id":"semetey-1-2013:p0756:b003:l037","ordinal":134831,"en":"To Karakan's city"},{"id":"semetey-1-2013:p0756:b003:l038","ordinal":134832,"en":"You went wandering, poor little one."},{"id":"semetey-1-2013:p0756:b003:l039","ordinal":134833,"en":"My soft, gray-mottled goshawk,"},{"id":"semetey-1-2013:p0756:b004:l001","ordinal":134834,"en":"Semetey standing here,"},{"id":"semetey-1-2013:p0756:b004:l002","ordinal":134835,"en":"My morning star to press to my breast,"},{"id":"semetey-1-2013:p0756:b004:l003","ordinal":134836,"en":"My deep-rooted plane tree untouched by wind,"},{"id":"semetey-1-2013:p0756:b004:l004","ordinal":134837,"en":"Who has grown up from orphanhood,"},{"id":"semetey-1-2013:p0756:b004:l005","ordinal":134838,"en":"My dark-marked falcon,"},{"id":"semetey-1-2013:p0756:b004:l006","ordinal":134839,"en":"My Pleiades overhead to guide me,"},{"id":"semetey-1-2013:p0756:b004:l007","ordinal":134840,"en":"If the Chinese enemy surrounds us on four sides,"},{"id":"semetey-1-2013:p0756:b004:l008","ordinal":134841,"en":"My unbreakable steel fortress!\""},{"id":"semetey-1-2013:p0756:b004:l009","ordinal":134842,"en":"Abyke spoke these words."},{"id":"semetey-1-2013:p0756:b004:l010","ordinal":134843,"en":"'The only one found when I was dying!' he said."},{"id":"semetey-1-2013:p0756:b004:l011","ordinal":134844,"en":"The boy Semetey alone"},{"id":"semetey-1-2013:p0756:b004:l012","ordinal":134845,"en":"He clasped about the neck,"},{"id":"semetey-1-2013:p0756:b004:l013","ordinal":134846,"en":"Sobbing loudly without stopping."},{"id":"semetey-1-2013:p0756:b004:l014","ordinal":134847,"en":"Beneath his chin,"},{"id":"semetey-1-2013:p0756:b004:l015","ordinal":134848,"en":"Above his throat,"},{"id":"semetey-1-2013:p0756:b004:l016","ordinal":134849,"en":"Your uncle Abyke"},{"id":"semetey-1-2013:p0756:b004:l017","ordinal":134850,"en":"Nuzzled him again and again, murmuring,"},{"id":"semetey-1-2013:p0756:b004:l018","ordinal":134851,"en":"Embracing him, weeping, deeply breathing his scent."},{"id":"semetey-1-2013:p0756:b004:l019","ordinal":134852,"en":"Abyke, a khan among the six, wept;"},{"id":"semetey-1-2013:p0756:b004:l020","ordinal":134853,"en":"White-bearded Bakai wept too."},{"id":"semetey-1-2013:p0756:b004:l021","ordinal":134854,"en":"Extinguished fires were rekindled."},{"id":"semetey-1-2013:p0756:b004:l022","ordinal":134855,"en":"That day Manas came back to life."},{"id":"semetey-1-2013:p0756:b004:l023","ordinal":134856,"en":"What else was it but coming back to life?"},{"id":"semetey-1-2013:p0756:b004:l024","ordinal":134857,"en":"The orphan they watched for had arrived;"},{"id":"semetey-1-2013:p0756:b004:l025","ordinal":134858,"en":"God had granted their wish."},{"id":"semetey-1-2013:p0756:b004:l026","ordinal":134859,"en":"The sorrowful ones reunited thus,"},{"id":"semetey-1-2013:p0756:b004:l027","ordinal":134860,"en":"And as they sobbed together,"},{"id":"semetey-1-2013:p0756:b004:l028","ordinal":134861,"en":"Ah, surrounded by a garden of plane trees,"},{"id":"semetey-1-2013:p0756:b004:l029","ordinal":134862,"en":"Stood Khan Manas's golden throne."},{"id":"semetey-1-2013:p0756:b004:l030","ordinal":134863,"en":"At the foot of the golden throne,"},{"id":"semetey-1-2013:p0756:b004:l031","ordinal":134864,"en":"Of so many designs,"},{"id":"semetey-1-2013:p0756:b004:l032","ordinal":134865,"en":"The orphan boy had never seen"},{"id":"semetey-1-2013:p0756:b004:l033","ordinal":134866,"en":"Anything so splendid."},{"id":"semetey-1-2013:p0756:b004:l034","ordinal":134867,"en":"At the foot of the golden throne,"},{"id":"semetey-1-2013:p0756:b004:l035","ordinal":134868,"en":"A great carpet patterned in gold—"},{"id":"semetey-1-2013:p0756:b004:l036","ordinal":134869,"en":"Even soaked in water for forty years,"},{"id":"semetey-1-2013:p0756:b004:l037","ordinal":134870,"en":"Not a hair would rot or fade."},{"id":"semetey-1-2013:p0756:b004:l038","ordinal":134871,"en":"Even soaked in water for eighty years,"},{"id":"semetey-1-2013:p0756:b004:l039","ordinal":134872,"en":"It would not fray, rot, or fade."},{"id":"semetey-1-2013:p0757:b003:l001","ordinal":134873,"en":"For so long that carpet"},{"id":"semetey-1-2013:p0757:b003:l002","ordinal":134874,"en":"Had not softened and rotted."},{"id":"semetey-1-2013:p0757:b003:l003","ordinal":134875,"en":"In those days, a man who would not heed words"},{"id":"semetey-1-2013:p0757:b003:l004","ordinal":134876,"en":"He frightened with his stare."},{"id":"semetey-1-2013:p0757:b003:l005","ordinal":134877,"en":"A man who did not understand his language"},{"id":"semetey-1-2013:p0757:b003:l006","ordinal":134878,"en":"He frightened with his fury."},{"id":"semetey-1-2013:p0757:b003:l007","ordinal":134879,"en":"The khoja in Kokand,"},{"id":"semetey-1-2013:p0757:b003:l008","ordinal":134880,"en":"When he was humiliating him,"},{"id":"semetey-1-2013:p0757:b003:l009","ordinal":134881,"en":"And Sanchybek in Samarkand—"},{"id":"semetey-1-2013:p0757:b003:l010","ordinal":134882,"en":"When he was beating him,"},{"id":"semetey-1-2013:p0757:b003:l011","ordinal":134883,"en":"The petitions officer in Bukhara,"},{"id":"semetey-1-2013:p0757:b003:l012","ordinal":134884,"en":"When he was imprisoning him,"},{"id":"semetey-1-2013:p0757:b003:l013","ordinal":134885,"en":"When he was bringing turmoil to Andijan,"},{"id":"semetey-1-2013:p0757:b003:l015","ordinal":134886,"en":"From the Six Cities, tribute"},{"id":"semetey-1-2013:p0757:b003:l016","ordinal":134887,"en":"He was taking then."},{"id":"semetey-1-2013:p0757:b003:l017","ordinal":134888,"en":"Drinking millet beer without stopping,"},{"id":"semetey-1-2013:p0757:b003:l018","ordinal":134889,"en":"He beat the khoja until he wailed."},{"id":"semetey-1-2013:p0757:b003:l019","ordinal":134890,"en":"Taking and drinking liquor,"},{"id":"semetey-1-2013:p0757:b003:l020","ordinal":134891,"en":"And taking, then,"},{"id":"semetey-1-2013:p0757:b003:l021","ordinal":134892,"en":"A prostitute as beautiful as glass,"},{"id":"semetey-1-2013:p0757:b003:l022","ordinal":134893,"en":"To gray-maned tiger Manas"},{"id":"semetey-1-2013:p0757:b003:l023","ordinal":134894,"en":"No one dared approach."},{"id":"semetey-1-2013:p0757:b003:l024","ordinal":134895,"en":"Those who saw his deeds were amazed."},{"id":"semetey-1-2013:p0757:b003:l025","ordinal":134896,"en":"Khan Manas's golden throne,"},{"id":"semetey-1-2013:p0757:b003:l026","ordinal":134897,"en":"His fortune ordained by fate—"},{"id":"semetey-1-2013:p0757:b003:l027","ordinal":134898,"en":"When hero Manas died,"},{"id":"semetey-1-2013:p0757:b003:l028","ordinal":134899,"en":"Hero Kobosh took possession."},{"id":"semetey-1-2013:p0757:b003:l029","ordinal":134900,"en":"Becoming a giant greater than all,"},{"id":"semetey-1-2013:p0757:b003:l030","ordinal":134901,"en":"He mounted the golden throne."},{"id":"semetey-1-2013:p0757:b003:l031","ordinal":134902,"en":"Khan Kobosh, without a care,"},{"id":"semetey-1-2013:p0757:b003:l032","ordinal":134903,"en":"Had become a sultan."},{"id":"semetey-1-2013:p0757:b003:l033","ordinal":134904,"en":"Abyke and Bakai—while these three"},{"id":"semetey-1-2013:p0757:b003:l034","ordinal":134905,"en":"Cried out to one another,"},{"id":"semetey-1-2013:p0757:b003:l035","ordinal":134906,"en":"Then gray-maned hero Kobosh"},{"id":"semetey-1-2013:p0757:b003:l036","ordinal":134907,"en":"Was utterly unconcerned,"},{"id":"semetey-1-2013:p0757:b003:l037","ordinal":134908,"en":"Those who were weeping,"},{"id":"semetey-1-2013:p0757:b003:l038","ordinal":134909,"en":"He did not value even as a scrap of hide."},{"id":"semetey-1-2013:p0757:b003:l039","ordinal":134910,"en":"Dear Kobosh sprawled in bulk,"},{"id":"semetey-1-2013:p0757:b004:l001","ordinal":134911,"en":"His nose jutting like a leather wineskin."},{"id":"semetey-1-2013:p0757:b004:l002","ordinal":134912,"en":"He was immersed in pleasure."}]
