{"id": "sayakbay-ms-current146:pdf067:l001", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 67, "folio": 450, "line_in_page": 1, "raw": "Акылман сөзүн кайрадан,", "text": "Акылман сөзүн кайрадан,", "en": "Again came the wise man’s words,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Opening line is unique to the manuscript and its syntax is elliptical.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf067:l002", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 67, "folio": 450, "line_in_page": 2, "raw": "Жел жетпес минтип сайрады.", "text": "Жел жетпес минтип сайрады.", "en": "Zhelzhetpes spoke out like this.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf067:l003", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 67, "folio": 450, "line_in_page": 3, "raw": "Көк ала тон жамынып,", "text": "Көк ала тон жамынып,", "en": "Putting on a blue-mottled coat,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf067:l004", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 67, "folio": 450, "line_in_page": 4, "raw": "Көрсөң шумдук Чыңтеңир", "text": "Көрсөң шумдук Чыңтеңир", "en": "Chyngteñir was a wonder to behold,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf067:l005", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 67, "folio": 450, "line_in_page": 5, "raw": "Көк жолборстой чамынып,", "text": "Көк жолборстой чамынып,", "en": "Raging like a blue tiger,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf067:l006", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 67, "folio": 450, "line_in_page": 6, "raw": "Көк албарсты байлады,", "text": "Көк албарсты байлады,", "en": "He bound the blue demon,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf067:l007", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 67, "folio": 450, "line_in_page": 7, "raw": "Камандай көзү жайнады:", "text": "Камандай көзү жайнады:", "en": "His eyes blazed like a boar’s:", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf067:l008", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 67, "folio": 450, "line_in_page": 8, "raw": "Тү, балакет Желжетпес,", "text": "Тү, балакет Желжетпес,", "en": "Bah, accursed Zhelzhetpes,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf067:l009", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 67, "folio": 450, "line_in_page": 9, "raw": "Бу кебиңди ким уксун,", "text": "Бу кебиңди ким уксун,", "en": "Who would listen to these words of yours?", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf067:l010", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 67, "folio": 450, "line_in_page": 10, "raw": "Бир караңгы түн уксун,", "text": "Бир караңгы түн уксун,", "en": "Let some dark night listen,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf067:l011", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 67, "folio": 450, "line_in_page": 11, "raw": "Айбан уксун, жан уксун,", "text": "Айбан уксун, жан уксун,", "en": "Let beasts hear, let living souls hear,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf067:l012", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 67, "folio": 450, "line_in_page": 12, "raw": "Ушул айткан кебиңди", "text": "Ушул айткан кебиңди", "en": "These words that you have spoken,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf067:l013", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 67, "folio": 450, "line_in_page": 13, "raw": "Төрт аяктуу мал уксун,", "text": "Төрт аяктуу мал уксун,", "en": "Let four-footed livestock hear,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf067:l014", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 67, "folio": 450, "line_in_page": 14, "raw": "Казылган кара көр уксун,", "text": "Казылган кара көр уксун,", "en": "Let the dug black grave hear,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf067:l015", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 67, "folio": 450, "line_in_page": 15, "raw": "Калдайган кара жер уксун!", "text": "Калдайган кара жер уксун!", "en": "Let the sprawling black earth hear!", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf067:l016", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 67, "folio": 450, "line_in_page": 16, "raw": "Жер ченөөгө жиберсем", "text": "Жер ченөөгө жиберсем", "en": "When I sent you to measure the land,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf067:l017", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 67, "folio": 450, "line_in_page": 17, "raw": "Эптүү адамдын бирисиң,", "text": "Эптүү адамдын бирисиң,", "en": "You were one of the capable men,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf067:l018", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 67, "folio": 450, "line_in_page": 18, "raw": "Ар качандан кыргызга", "text": "Ар качандан кыргызга", "en": "Yet all along, toward the Kyrgyz,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf067:l019", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 67, "folio": 450, "line_in_page": 19, "raw": "Боор ачууга жүрүсүң.", "text": "Боор ачууга жүрүсүң.", "en": "You have gone about showing compassion.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf067:l020", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 67, "folio": 450, "line_in_page": 20, "raw": "Баканооз чыгып ишиме,", "text": "Баканооз чыгып ишиме,", "en": "You emerged as a quarrelsome mouth against my work,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf067:l021", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 67, "folio": 450, "line_in_page": 21, "raw": "Бүлдүргүч чыгып кишиге,", "text": "Бүлдүргүч чыгып кишиге,", "en": "You emerged among men as a destroyer,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf067:l022", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 67, "folio": 450, "line_in_page": 22, "raw": "Этейин деген экенсиң,", "text": "Этейин деген экенсиң,", "en": "It seems you intended to do it,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf067:l023", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 67, "folio": 450, "line_in_page": 23, "raw": "Өзү чулдур кыргызга", "text": "Өзү чулдур кыргызга", "en": "To the stammering Kyrgyz themselves,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf067:l024", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 67, "folio": 450, "line_in_page": 24, "raw": "Кетейин деген экенсиң.", "text": "Кетейин деген экенсиң.", "en": "It seems you intended to leave.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf067:l025", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 67, "folio": 450, "line_in_page": 25, "raw": "Акыл ойлоп иш иштеп,", "text": "Акыл ойлоп иш иштеп,", "en": "Thinking with cunning and working your scheme,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "This begins a manuscript-only divergent passage; phrase is legible but idiomatic force is provisional.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf067:l026", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 67, "folio": 450, "line_in_page": 26, "raw": "Калп сөзүңдү куп кылып,", "text": "Калп сөзүңдү куп кылып,", "en": "Making your false words seem fitting,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf067:l027", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 67, "folio": 450, "line_in_page": 27, "raw": "Жактап калган экенсиң,", "text": "Жактап калган экенсиң,", "en": "It seems you remained defending them,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Verb is provisionally read Жактап.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf067:l028", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 67, "folio": 450, "line_in_page": 28, "raw": "Кара кыргыз тукумун,", "text": "Кара кыргыз тукумун,", "en": "The stock of the Kara Kyrgyz,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf067:l029", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 67, "folio": 450, "line_in_page": 29, "raw": "Сен мактап калган экенсиң.", "text": "Сен мактап калган экенсиң.", "en": "It seems you remained praising them.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf067:l030", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 67, "folio": 450, "line_in_page": 30, "raw": "Бу калп эле жүрдүң Кытайда,", "text": "Бу калп эле жүрдүң Кытайда,", "en": "You went about with this lie in China,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The locative Кытайда is clear; particles before it are somewhat compressed.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf067:l031", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 67, "folio": 450, "line_in_page": 31, "raw": "Берейин деген экенсиң,", "text": "Берейин деген экенсиң,", "en": "It seems you intended to give it away,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf067:l032", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 67, "folio": 450, "line_in_page": 32, "raw": "Укканда журту Кытайдын,", "text": "Укканда журту Кытайдын,", "en": "When the people of China heard it,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf067:l033", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 67, "folio": 450, "line_in_page": 33, "raw": "Бир түбүнө сен өзүң,", "text": "Бир түбүнө сен өзүң,", "en": "You yourself, at the root of it all,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Elliptical manuscript line; segmentation is provisional.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf067:l034", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 67, "folio": 450, "line_in_page": 34, "raw": "Жеринин деген экенсиң,", "text": "Жеринин деген экенсиң,", "en": "It seems you called it their land,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Opening word is provisionally read Жеринин.", "bbox": null}
