[{"id":"manas-2010:p0505:b001:l036","ordinal":23041,"en":"The dense army that filled the earth,"},{"id":"manas-2010:p0505:b001:l037","ordinal":23042,"en":"Utterly slaughtered, not one remaining,"},{"id":"manas-2010:p0505:b001:l038","ordinal":23043,"en":"Our misfortune has hardened upon us."},{"id":"manas-2010:p0505:b001:l039","ordinal":23044,"en":"Alas, Manas was a lion indeed,"},{"id":"manas-2010:p0505:b001:l040","ordinal":23045,"en":"One who would bring calamity."},{"id":"manas-2010:p0505:b001:l041","ordinal":23046,"en":"When our khan gave the command,"},{"id":"manas-2010:p0505:b001:l042","ordinal":23047,"en":"We used to advance with countless troops,"}]
