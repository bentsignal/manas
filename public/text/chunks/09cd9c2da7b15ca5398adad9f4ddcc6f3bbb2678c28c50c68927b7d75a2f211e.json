[{"id":"semetey-1-2013:p0436:b003:l019","ordinal":110081,"en":"His head adorned with all of gold,"},{"id":"semetey-1-2013:p0436:b003:l020","ordinal":110082,"en":"His feet resting on pure silver,"},{"id":"semetey-1-2013:p0436:b003:l021","ordinal":110083,"en":"Finding the right words unexpectedly,"},{"id":"semetey-1-2013:p0436:b003:l022","ordinal":110084,"en":"Finding sight in the darkness,"},{"id":"semetey-1-2013:p0436:b003:l023","ordinal":110085,"en":"Bringing good fortune when sent ahead,"},{"id":"semetey-1-2013:p0436:b003:l024","ordinal":110086,"en":"His uncle Bakay, worth a countless host,"},{"id":"semetey-1-2013:p0436:b003:l025","ordinal":110087,"en":"Also entered with a roar."},{"id":"semetey-1-2013:p0436:b003:l026","ordinal":110088,"en":"That excellent hero Bakay"},{"id":"semetey-1-2013:p0436:b003:l027","ordinal":110089,"en":"Also shouted 'Manas!' as his battle cry."},{"id":"semetey-1-2013:p0436:b003:l028","ordinal":110090,"en":"Riding a horse such as Sarala,"},{"id":"semetey-1-2013:p0436:b003:l029","ordinal":110091,"en":"Wearing yellow leather trousers,"},{"id":"semetey-1-2013:p0436:b003:l030","ordinal":110092,"en":"Holding a spear without a horsehair tuft,"},{"id":"semetey-1-2013:p0436:b003:l031","ordinal":110093,"en":"A naked sword tied at his side,"},{"id":"semetey-1-2013:p0436:b003:l032","ordinal":110094,"en":"With golden forelock and tasselled sash—"},{"id":"semetey-1-2013:p0436:b003:l033","ordinal":110095,"en":"The only son of Khan Azyz in Beijing—"},{"id":"semetey-1-2013:p0436:b003:l034","ordinal":110096,"en":"A roar came from ahead;"},{"id":"semetey-1-2013:p0436:b003:l035","ordinal":110097,"en":"When he heard Chubak's voice,"},{"id":"semetey-1-2013:p0436:b003:l036","ordinal":110098,"en":"He too came out from the hills,"},{"id":"semetey-1-2013:p0436:b003:l037","ordinal":110099,"en":"Shouting 'Manas!' as his battle cry."},{"id":"semetey-1-2013:p0436:b003:l038","ordinal":110100,"en":"Light on a horse, fit for a colt,"},{"id":"semetey-1-2013:p0436:b003:l039","ordinal":110101,"en":"Sleepless, watchful on the road,"},{"id":"semetey-1-2013:p0436:b004:l001","ordinal":110102,"en":"His support of black steel,"},{"id":"semetey-1-2013:p0436:b004:l002","ordinal":110103,"en":"Khan Manas's Syrgak,"},{"id":"semetey-1-2013:p0436:b004:l003","ordinal":110104,"en":"The finest of sixty,"},{"id":"semetey-1-2013:p0436:b004:l004","ordinal":110105,"en":"The strongest of forty companions,"},{"id":"semetey-1-2013:p0436:b004:l005","ordinal":110106,"en":"Riding an excellent thoroughbred,"},{"id":"semetey-1-2013:p0436:b004:l006","ordinal":110107,"en":"Wearing a coat of blue iron,"},{"id":"semetey-1-2013:p0436:b004:l007","ordinal":110108,"en":"Resting his sword in its sheath,"},{"id":"semetey-1-2013:p0436:b004:l008","ordinal":110109,"en":"When he attacked a shouting foe,"},{"id":"semetey-1-2013:p0436:b004:l009","ordinal":110110,"en":"He drenched him in bright-red blood."},{"id":"semetey-1-2013:p0436:b004:l010","ordinal":110111,"en":"Never shrinking from death,"},{"id":"semetey-1-2013:p0436:b004:l011","ordinal":110112,"en":"Never retreating from a shooting enemy,"},{"id":"semetey-1-2013:p0436:b004:l012","ordinal":110113,"en":"Never relaxing his stern expression,"},{"id":"semetey-1-2013:p0436:b004:l013","ordinal":110114,"en":"Never withdrawing once he thrust,"},{"id":"semetey-1-2013:p0436:b004:l014","ordinal":110115,"en":"His strength could reach the whole world."},{"id":"semetey-1-2013:p0436:b004:l015","ordinal":110116,"en":"Manas and that Syrgak"},{"id":"semetey-1-2013:p0436:b004:l016","ordinal":110117,"en":"Were the sons of brothers."},{"id":"semetey-1-2013:p0436:b004:l017","ordinal":110118,"en":"He too came roaring from the hills,"},{"id":"semetey-1-2013:p0436:b004:l018","ordinal":110119,"en":"When he heard Chubak's voice,"},{"id":"semetey-1-2013:p0436:b004:l019","ordinal":110120,"en":"Shouting 'Manas!' as his battle cry."},{"id":"semetey-1-2013:p0436:b004:l020","ordinal":110121,"en":"Ajybay, son of Argyn Khan,"},{"id":"semetey-1-2013:p0436:b004:l021","ordinal":110122,"en":"Who knew seventy different languages,"},{"id":"semetey-1-2013:p0436:b004:l022","ordinal":110123,"en":"Never retreating from one he reached,"},{"id":"semetey-1-2013:p0436:b004:l023","ordinal":110124,"en":"Never turning from one he met,"},{"id":"semetey-1-2013:p0436:b004:l024","ordinal":110125,"en":"Riding a horse such as Kartkuron,"},{"id":"semetey-1-2013:p0436:b004:l025","ordinal":110126,"en":"Wearing a black bulletproof coat,"},{"id":"semetey-1-2013:p0436:b004:l026","ordinal":110127,"en":"Roared in fury."},{"id":"semetey-1-2013:p0436:b004:l027","ordinal":110128,"en":"When he heard Chubak's voice,"},{"id":"semetey-1-2013:p0436:b004:l028","ordinal":110129,"en":"He too entered—did you see?—"},{"id":"semetey-1-2013:p0436:b004:l029","ordinal":110130,"en":"Shouting 'Manas!' as his battle cry."},{"id":"semetey-1-2013:p0436:b004:l030","ordinal":110131,"en":"Khan Manas's forty companions,"},{"id":"semetey-1-2013:p0436:b004:l031","ordinal":110132,"en":"All of them roaring,"},{"id":"semetey-1-2013:p0436:b004:l032","ordinal":110133,"en":"Entered the battle together,"},{"id":"semetey-1-2013:p0436:b004:l033","ordinal":110134,"en":"All shouting 'Manas!' as their battle cry."},{"id":"semetey-1-2013:p0436:b004:l034","ordinal":110135,"en":"Earth flew in streaming clouds."},{"id":"semetey-1-2013:p0436:b004:l035","ordinal":110136,"en":"Never shrinking from death,"},{"id":"semetey-1-2013:p0436:b004:l036","ordinal":110137,"en":"Manas and the forty companions"},{"id":"semetey-1-2013:p0436:b004:l037","ordinal":110138,"en":"Joined together at that very moment."},{"id":"semetey-1-2013:p0436:b004:l038","ordinal":110139,"en":"Drenched in dark blood,"},{"id":"semetey-1-2013:p0436:b004:l039","ordinal":110140,"en":"Those leopard-born warriors"},{"id":"semetey-1-2013:p0437:b003:l001","ordinal":110141,"en":"Fought without retreating."},{"id":"semetey-1-2013:p0437:b003:l002","ordinal":110142,"en":"Grasping spears, breaking ranks,"},{"id":"semetey-1-2013:p0437:b003:l003","ordinal":110143,"en":"Mortals whose hour had come fell to bullets."},{"id":"semetey-1-2013:p0437:b003:l004","ordinal":110144,"en":"They saw the great dug trench,"},{"id":"semetey-1-2013:p0437:b003:l006","ordinal":110145,"en":"Your Kyrgyz and Argyn in Talas","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0437:b003:l007","ordinal":110146,"en":"Were terribly hard pressed."},{"id":"semetey-1-2013:p0437:b003:l008","ordinal":110147,"en":"Your fortunate father was a lion."},{"id":"semetey-1-2013:p0437:b003:l009","ordinal":110148,"en":"Your father, across many lands,"},{"id":"semetey-1-2013:p0437:b003:l010","ordinal":110149,"en":"Was a hero who laid them waste."},{"id":"semetey-1-2013:p0437:b003:l011","ordinal":110150,"en":"When the mighty men came to hand,"},{"id":"semetey-1-2013:p0437:b003:l012","ordinal":110151,"en":"When his precious Chubak the lion"},{"id":"semetey-1-2013:p0437:b003:l013","ordinal":110152,"en":"Was known to have arrived,"},{"id":"semetey-1-2013:p0437:b003:l014","ordinal":110153,"en":"The gray cartridge belt fallen from heaven"},{"id":"semetey-1-2013:p0437:b003:l015","ordinal":110154,"en":"He fitted closely round his neck,"},{"id":"semetey-1-2013:p0437:b003:l016","ordinal":110155,"en":"And to the sole Creator, Jabbar,"},{"id":"semetey-1-2013:p0437:b003:l017","ordinal":110156,"en":"Your father then prayed."},{"id":"semetey-1-2013:p0437:b003:l018","ordinal":110157,"en":"Upon your khan father,"},{"id":"semetey-1-2013:p0437:b003:l019","ordinal":110158,"en":"Kongurbay, son of Alooke,"},{"id":"semetey-1-2013:p0437:b003:l020","ordinal":110159,"en":"With countless hosts upon hosts,"},{"id":"semetey-1-2013:p0437:b003:l021","ordinal":110160,"en":"Rushed in once again."},{"id":"semetey-1-2013:p0437:b003:l022","ordinal":110161,"en":"Brandishing his little axe,"},{"id":"semetey-1-2013:p0437:b003:l023","ordinal":110162,"en":"That splendid Kalcha"},{"id":"semetey-1-2013:p0437:b003:l024","ordinal":110163,"en":"Lumbered forward in fury,"},{"id":"semetey-1-2013:p0437:b003:l025","ordinal":110164,"en":"As though his runaway were escaping nearby,"},{"id":"semetey-1-2013:p0437:b003:l026","ordinal":110165,"en":"He was in a frantic flurry,"},{"id":"semetey-1-2013:p0437:b003:l027","ordinal":110166,"en":"As though an evil spirit had seized his wife,"},{"id":"semetey-1-2013:p0437:b003:l028","ordinal":110167,"en":"As though his pursuers were close behind,"},{"id":"semetey-1-2013:p0437:b003:l029","ordinal":110168,"en":"He was all in confusion,"},{"id":"semetey-1-2013:p0437:b003:l030","ordinal":110169,"en":"As though his wife had borne a son."},{"id":"semetey-1-2013:p0437:b003:l031","ordinal":110170,"en":"He lunged forward on Algara,"},{"id":"semetey-1-2013:p0437:b003:l032","ordinal":110171,"en":"Heaving as though her husband had died."},{"id":"semetey-1-2013:p0437:b003:l033","ordinal":110172,"en":"His spectacles gleamed,"},{"id":"semetey-1-2013:p0437:b003:l034","ordinal":110173,"en":"And a coral stone as large as a flask"},{"id":"semetey-1-2013:p0437:b003:l035","ordinal":110174,"en":"Glittered upon his crown."},{"id":"semetey-1-2013:p0437:b003:l036","ordinal":110175,"en":"His stirrup leathers flapped,"},{"id":"semetey-1-2013:p0437:b003:l037","ordinal":110176,"en":"His black hair braided like a mallet,"},{"id":"semetey-1-2013:p0437:b003:l038","ordinal":110177,"en":"His forelock hanging behind"},{"id":"semetey-1-2013:p0437:b003:l039","ordinal":110178,"en":"Swung upon his nape."},{"id":"semetey-1-2013:p0437:b004:l001","ordinal":110179,"en":"When his anger truly rose,"},{"id":"semetey-1-2013:p0437:b004:l002","ordinal":110180,"en":"His bristling mustache"},{"id":"semetey-1-2013:p0437:b004:l003","ordinal":110181,"en":"Looked like a battle-axe handle."},{"id":"semetey-1-2013:p0437:b004:l004","ordinal":110182,"en":"His ridged nose, remarkable in itself,"},{"id":"semetey-1-2013:p0437:b004:l005","ordinal":110183,"en":"Looked like a sword's sheath."},{"id":"semetey-1-2013:p0437:b004:l006","ordinal":110184,"en":"The space between his brows"},{"id":"semetey-1-2013:p0437:b004:l007","ordinal":110185,"en":"Resembled an open grave."},{"id":"semetey-1-2013:p0437:b004:l008","ordinal":110186,"en":"If you looked at his broad forehead,"},{"id":"semetey-1-2013:p0437:b004:l009","ordinal":110187,"en":"It resembled a rich man's high pasture."},{"id":"semetey-1-2013:p0437:b004:l010","ordinal":110188,"en":"Shouting with forty lords,"},{"id":"semetey-1-2013:p0437:b004:l011","ordinal":110189,"en":"He too cried 'Mondu!' as his battle cry."},{"id":"semetey-1-2013:p0437:b004:l012","ordinal":110190,"en":"Striking Algara upon the thigh,"},{"id":"semetey-1-2013:p0437:b004:l013","ordinal":110191,"en":"At your fierce father Manas"},{"id":"semetey-1-2013:p0437:b004:l014","ordinal":110192,"en":"He too charged without flinching."},{"id":"semetey-1-2013:p0437:b004:l015","ordinal":110193,"en":"The wrestlers of forty Chinese tribes"},{"id":"semetey-1-2013:p0437:b004:l016","ordinal":110194,"en":"Your father, now gone to Judgment,"},{"id":"semetey-1-2013:p0437:b004:l017","ordinal":110195,"en":"Took into their midst."},{"id":"semetey-1-2013:p0437:b004:l018","ordinal":110196,"en":"Your father stood majestic, unconcerned."},{"id":"semetey-1-2013:p0437:b004:l019","ordinal":110197,"en":"Though eighty spears struck at once,"},{"id":"semetey-1-2013:p0437:b004:l021","ordinal":110198,"en":"He deemed it worth less than his trouser hem.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0437:b004:l022","ordinal":110199,"en":"Kongurbay, son of Alooke,"},{"id":"semetey-1-2013:p0437:b004:l023","ordinal":110200,"en":"Against your fierce father Manas"},{"id":"semetey-1-2013:p0437:b004:l024","ordinal":110201,"en":"Displayed immeasurable courage."},{"id":"semetey-1-2013:p0437:b004:l025","ordinal":110202,"en":"That Chinese man from Beijing—"},{"id":"semetey-1-2013:p0437:b004:l026","ordinal":110203,"en":"Did you see what a hero he was?"},{"id":"semetey-1-2013:p0437:b004:l027","ordinal":110204,"en":"From emperor-ruled Beijing,"},{"id":"semetey-1-2013:p0437:b004:l028","ordinal":110205,"en":"Kongurbay, son of Alooke—"},{"id":"semetey-1-2013:p0437:b004:l029","ordinal":110206,"en":"Ah, his voice could frighten souls away."},{"id":"semetey-1-2013:p0437:b004:l030","ordinal":110207,"en":"A glowing ember born from the hearth,"},{"id":"semetey-1-2013:p0437:b004:l031","ordinal":110208,"en":"In the renowned city of Beijing"},{"id":"semetey-1-2013:p0437:b004:l032","ordinal":110209,"en":"A mighty one named Kongurbay was born."},{"id":"semetey-1-2013:p0437:b004:l033","ordinal":110210,"en":"When he reached six years of age,"},{"id":"semetey-1-2013:p0437:b004:l034","ordinal":110211,"en":"He stirred up trouble for the emperor."},{"id":"semetey-1-2013:p0437:b004:l035","ordinal":110212,"en":"Unable to bear his wrath,"},{"id":"semetey-1-2013:p0437:b004:l036","ordinal":110213,"en":"Great Beijing, where the unbelievers dwelt,"},{"id":"semetey-1-2013:p0437:b004:l037","ordinal":110214,"en":"Nearly fell into ruin."},{"id":"semetey-1-2013:p0437:b004:l038","ordinal":110215,"en":"When he reached eight years of age,"},{"id":"semetey-1-2013:p0437:b004:l039","ordinal":110216,"en":"He besieged the people of Beijing,"},{"id":"semetey-1-2013:p0438:b003:l001","ordinal":110217,"en":"When he reached nine,"},{"id":"semetey-1-2013:p0438:b003:l002","ordinal":110218,"en":"Among the stone-adorned Chinese"},{"id":"semetey-1-2013:p0438:b003:l003","ordinal":110219,"en":"He beat their bald-headed men."},{"id":"semetey-1-2013:p0438:b003:l004","ordinal":110220,"en":"Unable to bear his wrath,"},{"id":"semetey-1-2013:p0438:b003:l005","ordinal":110221,"en":"The city of Beijing grew weary."},{"id":"semetey-1-2013:p0438:b003:l006","ordinal":110222,"en":"When he reached twelve,"},{"id":"semetey-1-2013:p0438:b003:l008","ordinal":110223,"en":"They seated him on a golden throne.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0438:b003:l009","ordinal":110224,"en":"Of that great Beijing,"},{"id":"semetey-1-2013:p0438:b003:l010","ordinal":110225,"en":"They proclaimed him the great khan,"},{"id":"semetey-1-2013:p0438:b003:l011","ordinal":110226,"en":"And made him a wall built on a mountain slope."},{"id":"semetey-1-2013:p0438:b003:l012","ordinal":110227,"en":"To bar your generous father's way,"},{"id":"semetey-1-2013:p0438:b003:l013","ordinal":110228,"en":"They made him a mighty khan of the monks."},{"id":"semetey-1-2013:p0438:b003:l014","ordinal":110229,"en":"If you ask about Kongurbay,"},{"id":"semetey-1-2013:p0438:b003:l016","ordinal":110230,"en":"His custom when someone died","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0438:b003:l017","ordinal":110231,"en":"Was to divide the dead man's livestock equally."},{"id":"semetey-1-2013:p0438:b003:l018","ordinal":110232,"en":"He consecrated his castrated goat,"},{"id":"semetey-1-2013:p0438:b003:l019","ordinal":110233,"en":"And the horse he rode was sacred."},{"id":"semetey-1-2013:p0438:b003:l020","ordinal":110234,"en":"The custom he practiced"},{"id":"semetey-1-2013:p0438:b003:l021","ordinal":110235,"en":"Was to keep apart from women."},{"id":"semetey-1-2013:p0438:b003:l022","ordinal":110236,"en":"He wore mottled red;"},{"id":"semetey-1-2013:p0438:b003:l023","ordinal":110237,"en":"That unbeliever's practice"},{"id":"semetey-1-2013:p0438:b003:l024","ordinal":110238,"en":"Was to rejoice if one became a lama."},{"id":"semetey-1-2013:p0438:b003:l025","ordinal":110239,"en":"He did not squat to urinate;"},{"id":"semetey-1-2013:p0438:b003:l026","ordinal":110240,"en":"His robe's hem did not touch the ground."},{"id":"semetey-1-2013:p0438:b003:l027","ordinal":110241,"en":"Of Allah Most High, the One,"},{"id":"semetey-1-2013:p0438:b003:l028","ordinal":110242,"en":"He did not know the true oneness."},{"id":"semetey-1-2013:p0438:b003:l029","ordinal":110243,"en":"He saddled his unbroken horse,"},{"id":"semetey-1-2013:p0438:b003:l030","ordinal":110244,"en":"And a great bronze idol"},{"id":"semetey-1-2013:p0438:b003:l031","ordinal":110245,"en":"He hung and tied up, calling it God,"},{"id":"semetey-1-2013:p0438:b003:l032","ordinal":110246,"en":"And bowed in worship before it."},{"id":"semetey-1-2013:p0438:b003:l033","ordinal":110247,"en":"Kongurbay, khan of the monks,"},{"id":"semetey-1-2013:p0438:b003:l034","ordinal":110248,"en":"That massive boar—"},{"id":"semetey-1-2013:p0438:b003:l035","ordinal":110249,"en":"When Chinese as numerous as the earth"},{"id":"semetey-1-2013:p0438:b003:l036","ordinal":110250,"en":"Came swarming in,"},{"id":"semetey-1-2013:p0438:b003:l037","ordinal":110251,"en":"Hiding the ground, around your father"},{"id":"semetey-1-2013:p0438:b003:l038","ordinal":110252,"en":"They formed a ring."},{"id":"semetey-1-2013:p0438:b003:l039","ordinal":110253,"en":"Chubak, son of Akbaltay,"},{"id":"semetey-1-2013:p0438:b004:l001","ordinal":110254,"en":"Said, 'If suffering comes, I shall bear it;"},{"id":"semetey-1-2013:p0438:b004:l002","ordinal":110255,"en":"If my death comes, I shall die."},{"id":"semetey-1-2013:p0438:b004:l003","ordinal":110256,"en":"My sole friend to the next world,"},{"id":"semetey-1-2013:p0438:b004:l004","ordinal":110257,"en":"This Manas before me,"},{"id":"semetey-1-2013:p0438:b004:l005","ordinal":110258,"en":"I shall stand at his side.'"},{"id":"semetey-1-2013:p0438:b004:l006","ordinal":110259,"en":"Chubak, son of Akbaltay,"},{"id":"semetey-1-2013:p0438:b004:l007","ordinal":110260,"en":"That unruly scourge of the world,"},{"id":"semetey-1-2013:p0438:b004:l008","ordinal":110261,"en":"Entered the battle openly."},{"id":"semetey-1-2013:p0438:b004:l009","ordinal":110262,"en":"No sooner had that happened,"},{"id":"semetey-1-2013:p0438:b004:l010","ordinal":110263,"en":"Before an eye could open and close,"},{"id":"semetey-1-2013:p0438:b004:l011","ordinal":110264,"en":"Before one could say this or that,"},{"id":"semetey-1-2013:p0438:b004:l012","ordinal":110265,"en":"With golden forelock and tasselled sash,"},{"id":"semetey-1-2013:p0438:b004:l013","ordinal":110266,"en":"Khan Azyz's only son,"},{"id":"semetey-1-2013:p0438:b004:l014","ordinal":110267,"en":"Our Alake entered the battle."},{"id":"semetey-1-2013:p0438:b004:l015","ordinal":110268,"en":"The excellent hero Bakay,"},{"id":"semetey-1-2013:p0438:b004:l016","ordinal":110269,"en":"Wearing a blue-lynx fur cap,"},{"id":"semetey-1-2013:p0438:b004:l017","ordinal":110270,"en":"Flourishing a blue-mottled shield,"},{"id":"semetey-1-2013:p0438:b004:l018","ordinal":110271,"en":"Entered the battle again."},{"id":"semetey-1-2013:p0438:b004:l019","ordinal":110272,"en":"His black-capped support,"},{"id":"semetey-1-2013:p0438:b004:l020","ordinal":110273,"en":"Khan Manas's Syrgak,"},{"id":"semetey-1-2013:p0438:b004:l021","ordinal":110274,"en":"Entered the battle with them."},{"id":"semetey-1-2013:p0438:b004:l022","ordinal":110275,"en":"Argyn Khan's Ajybay"},{"id":"semetey-1-2013:p0438:b004:l023","ordinal":110276,"en":"Entered the battle too."},{"id":"semetey-1-2013:p0438:b004:l024","ordinal":110277,"en":"Yraman's son, the Singer,"},{"id":"semetey-1-2013:p0438:b004:l025","ordinal":110278,"en":"Hero Shuutu, with a cap like a yurt's roof felt,"},{"id":"semetey-1-2013:p0438:b004:l026","ordinal":110279,"en":"Khan Tomon's diviner,"},{"id":"semetey-1-2013:p0438:b004:l027","ordinal":110280,"en":"Manas's darling called Baychoro,"},{"id":"semetey-1-2013:p0438:b004:l028","ordinal":110281,"en":"Seregi, who sprang into action,"},{"id":"semetey-1-2013:p0438:b004:l029","ordinal":110282,"en":"Needed by Manas's fleeting life,"},{"id":"semetey-1-2013:p0438:b004:l030","ordinal":110283,"en":"His capable companion Bozuul,"},{"id":"semetey-1-2013:p0438:b004:l031","ordinal":110284,"en":"Aykojo in a mottled robe—"},{"id":"semetey-1-2013:p0438:b004:l032","ordinal":110285,"en":"The mullah whom Manas took along,"},{"id":"semetey-1-2013:p0438:b004:l034","ordinal":110286,"en":"Adysh with his forked beard—"},{"id":"semetey-1-2013:p0438:b004:l035","ordinal":110287,"en":"Forty spears extended from forty sides,"},{"id":"semetey-1-2013:p0438:b004:l036","ordinal":110288,"en":"All of them toward Manas."},{"id":"semetey-1-2013:p0438:b004:l037","ordinal":110289,"en":"Looking, one could not catch sight of them."},{"id":"semetey-1-2013:p0438:b004:l038","ordinal":110290,"en":"God, do not let us see such a sight!"},{"id":"semetey-1-2013:p0438:b004:l039","ordinal":110291,"en":"One could not tell who was who!"},{"id":"semetey-1-2013:p0439:b003:l001","ordinal":110292,"en":"The sky was clear, the earth obscured;"},{"id":"semetey-1-2013:p0439:b003:l002","ordinal":110293,"en":"The great battle brought slaughter."},{"id":"semetey-1-2013:p0439:b003:l003","ordinal":110294,"en":"Those whose appointed death came"},{"id":"semetey-1-2013:p0439:b003:l004","ordinal":110295,"en":"Were struck in the brow by battle-axes."},{"id":"semetey-1-2013:p0439:b003:l005","ordinal":110296,"en":"The weak, powerless, without courage"},{"id":"semetey-1-2013:p0439:b003:l006","ordinal":110297,"en":"Were setting out for Mecca."},{"id":"semetey-1-2013:p0439:b003:l007","ordinal":110298,"en":"Once the battle became a melee,"},{"id":"semetey-1-2013:p0439:b003:l008","ordinal":110299,"en":"The heroes separated into their own group,"},{"id":"semetey-1-2013:p0439:b003:l009","ordinal":110300,"en":"Their blood shed in suffering,"},{"id":"semetey-1-2013:p0439:b003:l010","ordinal":110301,"en":"The lions separated into their own group,"},{"id":"semetey-1-2013:p0439:b003:l011","ordinal":110302,"en":"The weak saw death before them,"},{"id":"semetey-1-2013:p0439:b003:l012","ordinal":110303,"en":"The skillful spearmen died,"},{"id":"semetey-1-2013:p0439:b003:l013","ordinal":110304,"en":"Many fine warriors died in the clash."},{"id":"semetey-1-2013:p0439:b003:l014","ordinal":110305,"en":"Kongurbay's black horse—"},{"id":"semetey-1-2013:p0439:b003:l015","ordinal":110306,"en":"I wonder, did that black horse have"},{"id":"semetey-1-2013:p0439:b003:l016","ordinal":110307,"en":"Wings upon its flanks?"},{"id":"semetey-1-2013:p0439:b003:l017","ordinal":110308,"en":"That slave, skilled among spearmen,"},{"id":"semetey-1-2013:p0439:b003:l018","ordinal":110309,"en":"Would always make the whole world"},{"id":"semetey-1-2013:p0439:b003:l019","ordinal":110310,"en":"Like a stirred mash of roasted flour."},{"id":"semetey-1-2013:p0439:b003:l020","ordinal":110311,"en":"As though mixing roasted flour,"},{"id":"semetey-1-2013:p0439:b003:l021","ordinal":110312,"en":"Without distinction between Muslim and unbeliever,"},{"id":"semetey-1-2013:p0439:b003:l022","ordinal":110313,"en":"Earth swarmed and dust flew,"},{"id":"semetey-1-2013:p0439:b003:l023","ordinal":110314,"en":"Not one blade was visible on the ground."},{"id":"semetey-1-2013:p0439:b003:l024","ordinal":110315,"en":"With their waists firmly girded,"},{"id":"semetey-1-2013:p0439:b003:l025","ordinal":110316,"en":"Your leopard father and hero Chubak,"},{"id":"semetey-1-2013:p0439:b003:l026","ordinal":110317,"en":"With elder Bakay among them,"},{"id":"semetey-1-2013:p0439:b003:l027","ordinal":110318,"en":"Attacked, plunging in alone."},{"id":"semetey-1-2013:p0439:b003:l028","ordinal":110319,"en":"As they wheeled and wheeled about,"},{"id":"semetey-1-2013:p0439:b003:l029","ordinal":110320,"en":"Twelve Manchus died at once."},{"id":"semetey-1-2013:p0439:b003:l030","ordinal":110321,"en":"Does not a mortal whose time has come die?"},{"id":"semetey-1-2013:p0439:b003:l031","ordinal":110322,"en":"Who has seen such a marvel?"},{"id":"semetey-1-2013:p0439:b003:l032","ordinal":110323,"en":"Seven banners and a red standard,"},{"id":"semetey-1-2013:p0439:b003:l033","ordinal":110324,"en":"Amid the great slaughter,"},{"id":"semetey-1-2013:p0439:b003:l034","ordinal":110325,"en":"Wild shouts and uproar,"},{"id":"semetey-1-2013:p0439:b003:l035","ordinal":110326,"en":"The thunder of the drum—"},{"id":"semetey-1-2013:p0439:b003:l036","ordinal":110327,"en":"It became a battle like no other."},{"id":"semetey-1-2013:p0439:b003:l037","ordinal":110328,"en":"Guns cracked loudly."},{"id":"semetey-1-2013:p0439:b003:l038","ordinal":110329,"en":"When heroes faced one another with spears,"},{"id":"semetey-1-2013:p0439:b003:l039","ordinal":110330,"en":"Their spears snapped with a crash,"},{"id":"semetey-1-2013:p0439:b004:l001","ordinal":110331,"en":"Swords shattered, clanging,"},{"id":"semetey-1-2013:p0439:b004:l002","ordinal":110332,"en":"And the heads of the battle-axes"},{"id":"semetey-1-2013:p0439:b004:l003","ordinal":110333,"en":"Flew screaming from their shafts."},{"id":"semetey-1-2013:p0439:b004:l004","ordinal":110334,"en":"Besieging Talas, stirring strife,"},{"id":"semetey-1-2013:p0439:b004:l005","ordinal":110335,"en":"Because of Khan Chubak's letter,"},{"id":"semetey-1-2013:p0439:b004:l006","ordinal":110336,"en":"Because of Kyrgylchal's obstruction,"}]
