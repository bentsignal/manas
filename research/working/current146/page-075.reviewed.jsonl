{"id": "sayakbay-ms-current146:pdf075:l001", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 75, "folio": 458, "line_in_page": 1, "raw": "Баатыр, эбегей жок теңсизсиң,", "text": "Баатыр, эбегей жок теңсизсиң,", "en": "Warrior, you are peerless and without equal,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf075:l002", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 75, "folio": 458, "line_in_page": 2, "raw": "Күйрүчүң бар, жалың бар,", "text": "Күйрүчүң бар, жалың бар,", "en": "You have burning force and flame,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf075:l003", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 75, "folio": 458, "line_in_page": 3, "raw": "Билгичиң бар, эшиң бар,", "text": "Билгичиң бар, эшиң бар,", "en": "You have wise men and companions,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf075:l004", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 75, "folio": 458, "line_in_page": 4, "raw": "Акыл табар чечиң бар,", "text": "Акыл табар чечиң бар,", "en": "You have eloquent men who find wise counsel,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf075:l005", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 75, "folio": 458, "line_in_page": 5, "raw": "Акбалаң шердигиң,", "text": "Акбалаң шердигиң,", "en": "Your champion Akbala,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf075:l006", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 75, "folio": 458, "line_in_page": 6, "raw": "Сурадай айтты, билип ал.", "text": "Сурадай айтты, билип ал.", "en": "Suradai spoke; understand this.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf075:l007", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 75, "folio": 458, "line_in_page": 7, "raw": "Түпкү атаң хан улук,", "text": "Түпкү атаң хан улук,", "en": "Your ancient forefather was a great khan,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf075:l008", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 75, "folio": 458, "line_in_page": 8, "raw": "Чың Теңир баатыр, билип ал.", "text": "Чың Теңир баатыр, билип ал.", "en": "Warrior Chyng Tengir, understand this.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf075:l009", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 75, "folio": 458, "line_in_page": 9, "raw": "Эшен төртөө тамырлаш,", "text": "Эшен төртөө тамырлаш,", "en": "The four eshens share one root,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf075:l010", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 75, "folio": 458, "line_in_page": 10, "raw": "Бурун кессең сүтү жок,", "text": "Бурун кессең сүтү жок,", "en": "If you cut its nose, there is no milk,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf075:l011", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 75, "folio": 458, "line_in_page": 11, "raw": "Мүйүз жоо жан жолдош,", "text": "Мүйүз жоо жан жолдош,", "en": "The horned foe is a companion of the soul,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf075:l012", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 75, "folio": 458, "line_in_page": 12, "raw": "Буудан сындар күнү жок,", "text": "Буудан сындар күнү жок,", "en": "There is no day when the thoroughbred fails,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf075:l013", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 75, "folio": 458, "line_in_page": 13, "raw": "Колундагы Жел жетпес,", "text": "Колундагы Жел жетпес,", "en": "Jeljetpes who stands in your hand,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf075:l014", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 75, "folio": 458, "line_in_page": 14, "raw": "Кылмышсыз сайсак оңбойсуң,", "text": "Кылмышсыз сайсак оңбойсуң,", "en": "If you strike the innocent, you will not prosper,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf075:l015", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 75, "folio": 458, "line_in_page": 15, "raw": "Коймо жинди козгойсуң,", "text": "Коймо жинди козгойсуң,", "en": "You will stir up a madness best left alone,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf075:l016", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 75, "folio": 458, "line_in_page": 16, "raw": "Каар чачып журт билесиң,", "text": "Каар чачып журт билесиң,", "en": "Scattering wrath, you rule the people,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf075:l017", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 75, "folio": 458, "line_in_page": 17, "raw": "Узак заман оңбойсуң.", "text": "Узак заман оңбойсуң.", "en": "You will not prosper for a long age.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf075:l018", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 75, "folio": 458, "line_in_page": 18, "raw": "Топонун курай урганда,", "text": "Топонун курай урганда,", "en": "When the storm beats down the reeds,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf075:l019", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 75, "folio": 458, "line_in_page": 19, "raw": "Балканыккан саат болуп,", "text": "Балканыккан саат болуп,", "en": "When the hour grows troubled,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf075:l020", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 75, "folio": 458, "line_in_page": 20, "raw": "Жакыныңнан каат болуп,", "text": "Жакыныңнан каат болуп,", "en": "When hardship comes from those close to you,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf075:l021", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 75, "folio": 458, "line_in_page": 21, "raw": "Тил албаган тил чыгып,", "text": "Тил албаган тил чыгып,", "en": "A tongue that will not obey will arise,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf075:l022", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 75, "folio": 458, "line_in_page": 22, "raw": "Жаак албаган жаак чыгып,", "text": "Жаак албаган жаак чыгып,", "en": "A jaw that will not submit will arise,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf075:l023", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 75, "folio": 458, "line_in_page": 23, "raw": "Калк дарыл, улук той,", "text": "Калк дарыл, улук той,", "en": "The people surge in a great assembly,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf075:l024", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 75, "folio": 458, "line_in_page": 24, "raw": "Торкуга сизге саат болуп,", "text": "Торкуга сизге саат болуп,", "en": "A perilous hour will come upon you,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf075:l025", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 75, "folio": 458, "line_in_page": 25, "raw": "Кеңири кыл санааны,", "text": "Кеңири кыл санааны,", "en": "Let your thoughts range widely,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf075:l026", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 75, "folio": 458, "line_in_page": 26, "raw": "Кеп кылып ойло талааны.", "text": "Кеп кылып ойло талааны.", "en": "Speak and consider the open field.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf075:l027", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 75, "folio": 458, "line_in_page": 27, "raw": "Бирдиги бар аз элиң,", "text": "Бирдиги бар аз элиң,", "en": "A small people with unity,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf075:l028", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 75, "folio": 458, "line_in_page": 28, "raw": "Бөрү ким бузат экен камаасын?", "text": "Бөрү ким бузат экен камаасын?", "en": "What wolf could break their enclosure?", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf075:l029", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 75, "folio": 458, "line_in_page": 29, "raw": "Бирдиги жок көп элиң,", "text": "Бирдиги жок көп элиң,", "en": "A numerous people without unity,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf075:l030", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 75, "folio": 458, "line_in_page": 30, "raw": "Ар ким жумшаар баласың.", "text": "Ар ким жумшаар баласың.", "en": "You become a child whom anyone may command.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf075:l031", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 75, "folio": 458, "line_in_page": 31, "raw": "Кылмышсызды кыйратып,", "text": "Кылмышсызды кыйратып,", "en": "Destroying the innocent,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf075:l032", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 75, "folio": 458, "line_in_page": 32, "raw": "Баатыр, бузба журттун санаасын.", "text": "Баатыр, бузба журттун санаасын.", "en": "Warrior, do not disturb the people’s peace of mind.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf075:l033", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 75, "folio": 458, "line_in_page": 33, "raw": "Күрмөчөнү күндө айтып,", "text": "Күрмөчөнү күндө айтып,", "en": "The armored men spoke day after day,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf075:l034", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 75, "folio": 458, "line_in_page": 34, "raw": "Таштуулары таза айтып,", "text": "Таштуулары таза айтып,", "en": "The stone-clad men spoke plainly,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf075:l035", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 75, "folio": 458, "line_in_page": 35, "raw": "Калдай айтып, калк айтып.", "text": "Калдай айтып, калк айтып.", "en": "The kaldais spoke, and the people spoke.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
