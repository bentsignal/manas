[{"id":"semetey-1-2013:p0888:b004:l008","ordinal":144129,"en":"Where can I see him now?”"},{"id":"semetey-1-2013:p0888:b004:l009","ordinal":144130,"en":"Many went wailing."},{"id":"semetey-1-2013:p0888:b004:l010","ordinal":144131,"en":"Taking many a swift horse,"},{"id":"semetey-1-2013:p0888:b004:l011","ordinal":144132,"en":"Many rushed about in excitement."},{"id":"semetey-1-2013:p0888:b004:l012","ordinal":144133,"en":"“Curses, alas, my kinsman"},{"id":"semetey-1-2013:p0888:b004:l013","ordinal":144134,"en":"Has died,” they said,"},{"id":"semetey-1-2013:p0888:b004:l014","ordinal":144135,"en":"And many went weeping."},{"id":"semetey-1-2013:p0888:b004:l015","ordinal":144136,"en":"Their cruppers broken,"},{"id":"semetey-1-2013:p0888:b004:l016","ordinal":144137,"en":"Their saddles slipped beneath the belly,"},{"id":"semetey-1-2013:p0888:b004:l017","ordinal":144138,"en":"Many were stopping along the way."},{"id":"semetey-1-2013:p0888:b004:l018","ordinal":144139,"en":"Their saddle girths broken,"},{"id":"semetey-1-2013:p0888:b004:l019","ordinal":144140,"en":"Many were in a panic."},{"id":"semetey-1-2013:p0888:b004:l020","ordinal":144141,"en":"Dropping their spears,"},{"id":"semetey-1-2013:p0888:b004:l021","ordinal":144142,"en":"Utterly losing their composure,"},{"id":"semetey-1-2013:p0888:b004:l022","ordinal":144143,"en":"Many were fleeing."},{"id":"semetey-1-2013:p0888:b004:l023","ordinal":144144,"en":"Startled and scattered over the steppe,"},{"id":"semetey-1-2013:p0888:b004:l024","ordinal":144145,"en":"Still more were stopping along the way."},{"id":"semetey-1-2013:p0888:b004:l025","ordinal":144146,"en":"“You fled for nothing,” they said,"},{"id":"semetey-1-2013:p0888:b004:l026","ordinal":144147,"en":"Reproaching one another harshly,"},{"id":"semetey-1-2013:p0888:b004:l027","ordinal":144148,"en":"And many went cursing."},{"id":"semetey-1-2013:p0888:b004:l028","ordinal":144149,"en":"Shattered and scattered in fragments,"},{"id":"semetey-1-2013:p0888:b004:l029","ordinal"