[{"id":"semetey-1-2013:p0912:b003:l035","ordinal":146689,"en":"The forty ill-behaved swine,"},{"id":"semetey-1-2013:p0912:b003:l036","ordinal":146690,"en":"Not one fool seems likely to look back."},{"id":"semetey-1-2013:p0912:b003:l037","ordinal":146691,"en":"Green-mottled silk—"},{"id":"semetey-1-2013:p0912:b003:l038","ordinal":146692,"en":"If I tear it at the side, it will not part;"},{"id":"semetey-1-2013:p0912:b003:l039","ordinal":146693,"en":"This is an infidel from whom your soul has come"},{"id":"semetey-1-2013:p0912:b003:l040","ordinal":146694,"en":"They seem unlikely to draw near."},{"id":"semetey-1-2013:p0912:b004:l001","ordinal":146695,"en":"Your kumys is in the little leather flask;"},{"id":"semetey-1-2013:p0912:b004:l002","ordinal":146696,"en":"If these dogs draw near,"},{"id":"semetey-1-2013:p0912:b004:l003","ordinal":146697,"en":"They will do harm in secret!"},{"id":"semetey-1-2013:p0912:b004:l004","ordinal":146698,"en":"And now, my child, listen!"},{"id":"semetey-1-2013:p0912:b004:l005","ordinal":146699,"en":"Your kumys poured into the wooden tub—"},{"id":"semetey-1-2013:p0912:b004:l006","ordinal":146700,"en":"If they can, the forty companions"},{"id":"semetey-1-2013:p0912:b004:l007","ordinal":146701,"en":"Karykan will give you his grove."},{"id":"semetey-1-2013:p0912:b004:l008","ordinal":146702,"en":"If you go raiding, the forty companions"},{"id":"semetey-1-2013:p0912:b004:l009","ordinal":146703,"en":"Will blow upon the meadowsweet embers."},{"id":"semetey-1-2013:p0912:b004:l010","ordinal":146704,"en":"If you make companions of the dogs,"},{"id":"semetey-1-2013:p0912:b004:l011","ordinal":146705,"en":"They will talk when you are hard pressed."},{"id":"semetey-1-2013:p0912:b004:l012","ordinal":146706,"en":"If you plead, they will not heed your words;"},{"id":"semetey-1-2013:p0912:b004:l013","ordinal":146707,"en":"They will break your spirit."},{"id":"semetey-1-2013:p0912:b004:l014","ordinal":146708,"en":"If these dogs set their minds to it,"},{"id":"semetey-1-2013:p0912:b004:l015","ordinal":146709,"en":"They will take your breath away!”"},{"id":"semetey-1-2013:p0912:b004:l016","ordinal":146710,"en":"Kanykei spoke these words:"},{"id":"semetey-1-2013:p0912:b004:l017","ordinal":146711,"en":"“The forty companions your father left—"},{"id":"semetey-1-2013:p0912:b004:l018","ordinal":146712,"en":"He loosened all six,"},{"id":"semetey-1-2013:p0912:b004:l019","ordinal":146713,"en":"Divide them all into separate groups"},{"id":"semetey-1-2013:p0912:b004:l020","ordinal":146714,"en":"And send them down into the depths."},{"id":"semetey-1-2013:p0912:b004:l021","ordinal":146715,"en":"Send one to the emperor,"},{"id":"semetey-1-2013:p0912:b004:l022","ordinal":146716,"en":"One to Altai,"},{"id":"semetey-1-2013:p0912:b004:l023","ordinal":146717,"en":"One to Khangai,"},{"id":"semetey-1-2013:p0912:b004:l024","ordinal":146718,"en":"One to the Irtysh."},{"id":"semetey-1-2013:p0912:b004:l025","ordinal":146719,"en":"If you do not take measures early,"},{"id":"semetey-1-2013:p0912:b004:l026","ordinal":146720,"en":"They are no servants who will remain your people;"},{"id":"semetey-1-2013:p0912:b004:l027","ordinal":146721,"en":"He is no slave who gives an easy way."},{"id":"semetey-1-2013:p0912:b004:l028","ordinal":146722,"en":"Harboring wickedness, devising schemes,"},{"id":"semetey-1-2013:p0912:b004:l029","ordinal":146723,"en":"The scoundrels will not be your loyal people."},{"id":"semetey-1-2013:p0912:b004:l030","ordinal":146724,"en":"Mice the size of knucklebones—"},{"id":"semetey-1-2013:p0912:b004:l031","ordinal":146725,"en":"I gathered ninety; they do not make a coat."},{"id":"semetey-1-2013:p0912:b004:l032","ordinal":146726,"en":"The forty companions, like hell itself,"},{"id":"semetey-1-2013:p0912:b004:l033","ordinal":146727,"en":"Will not stay and be your loyal people.”"},{"id":"semetey-1-2013:p0912:b004:l034","ordinal":146728,"en":"After his wolf-maned father Manas,"},{"id":"semetey-1-2013:p0912:b004:l035","ordinal":146729,"en":"Semetey had been born."},{"id":"semetey-1-2013:p0912:b004:l036","ordinal":146730,"en":"However much the elders spoke,"},{"id":"semetey-1-2013:p0912:b004:l037","ordinal":146731,"en":"He stayed angry and unmoved;"},{"id":"semetey-1-2013:p0912:b004:l038","ordinal":146732,"en":"Those words of the elders,"},{"id":"semetey-1-2013:p0912:b004:l039","ordinal":146733,"en":"He counted as worth nothing,"},{"id":"semetey-1-2013:p0912:b004:l040","ordinal":146734,"en":"And lay there unconcerned."},{"id":"semetey-1-2013:p0913:b004:l001","ordinal":146735,"en":"On the day of Thursday,"},{"id":"semetey-1-2013:p0913:b004:l002","ordinal":146736,"en":"On Friday's Night of Power,"},{"id":"semetey-1-2013:p0913:b004:l003","ordinal":146737,"en":"Talas was full of shouting,"},{"id":"semetey-1-2013:p0913:b004:l004","ordinal":146738,"en":"Calling out, “Semetey!”"},{"id":"semetey-1-2013:p0913:b004:l005","ordinal":146739,"en":"Then came the forty companions who had fled."},{"id":"semetey-1-2013:p0913:b004:l006","ordinal":146740,"en":"Along the broad Talas,"},{"id":"semetey-1-2013:p0913:b004:l007","ordinal":146741,"en":"At Kanykei's Kotormo,"},{"id":"semetey-1-2013:p0913:b004:l008","ordinal":146742,"en":"They crossed over Kotormo,"},{"id":"semetey-1-2013:p0913:b004:l009","ordinal":146743,"en":"Passed through Suusamyr,"},{"id":"semetey-1-2013:p0913:b004:l010","ordinal":146744,"en":"Swept over Kyzart,"},{"id":"semetey-1-2013:p0913:b004:l011","ordinal":146745,"en":"And roamed the broad Kochkor."},{"id":"semetey-1-2013:p0913:b004:l012","ordinal":146746,"en":"Then the forty companions"},{"id":"semetey-1-2013:p0913:b004:l013","ordinal":146747,"en":"Gave themselves over to merriment."},{"id":"semetey-1-2013:p0913:b004:l014","ordinal":146748,"en":"Their winged steeds that had borne the journey,"},{"id":"semetey-1-2013:p0913:b004:l015","ordinal":146749,"en":"They unsaddled, leaving their backs bare,"},{"id":"semetey-1-2013:p0913:b004:l016","ordinal":146750,"en":"Tethered them with their heads drawn up,"},{"id":"semetey-1-2013:p0913:b004:l017","ordinal":146751,"en":"And let them cool thoroughly."},{"id":"semetey-1-2013:p0913:b004:l018","ordinal":146752,"en":"They made tethering places of stone,"},{"id":"semetey-1-2013:p0913:b004:l019","ordinal":146753,"en":"And stood ready."},{"id":"semetey-1-2013:p0913:b004:l020","ordinal":146754,"en":"They spread out their food,"},{"id":"semetey-1-2013:p0913:b004:l021","ordinal":146755,"en":"Made ready their little camp kettles,"},{"id":"semetey-1-2013:p0913:b004:l022","ordinal":146756,"en":"The archers drew together;"},{"id":"semetey-1-2013:p0913:b004:l023","ordinal":146757,"en":"Their tent with reed supporting poles"},{"id":"semetey-1-2013:p0913:b004:l024","ordinal":146758,"en":"They pitched on level ground."},{"id":"semetey-1-2013:p0913:b004:l025","ordinal":146759,"en":"They slaughtered yearling fillies,"},{"id":"semetey-1-2013:p0913:b004:l026","ordinal":146760,"en":"Posted a strong watch,"},{"id":"semetey-1-2013:p0913:b004:l027","ordinal":146761,"en":"And lay there, the forty companions."},{"id":"semetey-1-2013:p0913:b004:l028","ordinal":146762,"en":"They made ready their spears,"},{"id":"semetey-1-2013:p0913:b004:l029","ordinal":146763,"en":"Prepared their guns,"},{"id":"semetey-1-2013:p0913:b004:l030","ordinal":146764,"en":"And lay there, the forty companions."},{"id":"semetey-1-2013:p0913:b004:l031","ordinal":146765,"en":"Descending from Kyzart,"},{"id":"semetey-1-2013:p0913:b004:l032","ordinal":146766,"en":"When Semetey looked through his spyglass,"},{"id":"semetey-1-2013:p0913:b004:l033","ordinal":146767,"en":"A blue-mottled tent appeared,"},{"id":"semetey-1-2013:p0913:b004:l034","ordinal":146768,"en":"Blue smoke rose apart."},{"id":"semetey-1-2013:p0913:b004:l035","ordinal":146769,"en":"There were tumultuous cries;"},{"id":"semetey-1-2013:p0913:b006:l001","ordinal":146770,"en":"When he looked at the forty companions,"},{"id":"semetey-1-2013:p0913:b006:l002","ordinal":146771,"en":"Their hostility was plain."},{"id":"semetey-1-2013:p0913:b006:l003","ordinal":146772,"en":"Smoke rose against the sky,"},{"id":"semetey-1-2013:p0913:b006:l004","ordinal":146773,"en":"The tent showed blue,"},{"id":"semetey-1-2013:p0913:b006:l005","ordinal":146774,"en":"With much shouting and fierce cheering."},{"id":"semetey-1-2013:p0913:b006:l006","ordinal":146775,"en":"Damn it, the forty companions"},{"id":"semetey-1-2013:p0913:b006:l007","ordinal":146776,"en":"Looked stubbornly defiant!"},{"id":"semetey-1-2013:p0913:b006:l008","ordinal":146777,"en":"Manas's son, the warrior orphan,"},{"id":"semetey-1-2013:p0913:b006:l009","ordinal":146778,"en":"Rode Buurul, urging him to surge forward."},{"id":"semetey-1-2013:p0913:b006:l010","ordinal":146779,"en":"His heart could not contain his many cares;"},{"id":"semetey-1-2013:p0913:b006:l011","ordinal":146780,"en":"When he saw the forty companions,"},{"id":"semetey-1-2013:p0913:b006:l012","ordinal":146781,"en":"His tears streamed in all directions."},{"id":"semetey-1-2013:p0913:b006:l013","ordinal":146782,"en":"The gray belt left by his father Manas,"},{"id":"semetey-1-2013:p0913:b006:l014","ordinal":146783,"en":"He unfastened and hung around his neck."},{"id":"semetey-1-2013:p0913:b006:l015","ordinal":146784,"en":"Leading Taibuurul,"},{"id":"semetey-1-2013:p0913:b006:l016","ordinal":146785,"en":"He pleaded with the forty companions:"},{"id":"semetey-1-2013:p0913:b006:l017","ordinal":146786,"en":"“Since I came to Talas,"},{"id":"semetey-1-2013:p0913:b006:l018","ordinal":146787,"en":"My dear forty companions,"},{"id":"semetey-1-2013:p0913:b006:l019","ordinal":146788,"en":"Your number has become sixty,"},{"id":"semetey-1-2013:p0913:b006:l020","ordinal":146789,"en":"My wings for circling flight."},{"id":"semetey-1-2013:p0913:b006:l021","ordinal":146790,"en":"Listen attentively to my words,"},{"id":"semetey-1-2013:p0913:b006:l022","ordinal":146791,"en":"My dear forty uncles;"},{"id":"semetey-1-2013:p0913:b006:l023","ordinal":146792,"en":"Do not utterly break my back."},{"id":"semetey-1-2013:p0913:b006:l024","ordinal":146793,"en":"‘He went to Talas—the forty companions,"},{"id":"semetey-1-2013:p0913:b006:l025","ordinal":146794,"en":"His iron-strong support—"},{"id":"semetey-1-2013:p0913:b006:l026","ordinal":146795,"en":"He scattered those companions!’"},{"id":"semetey-1-2013:p0913:b006:l027","ordinal":146796,"en":"Do not let them call me Manas's worthless son."},{"id":"semetey-1-2013:p0913:b006:l028","ordinal":146797,"en":"Do not kill my words,"},{"id":"semetey-1-2013:p0913:b006:l029","ordinal":146798,"en":"My dear forty uncles;"},{"id":"semetey-1-2013:p0913:b006:l030","ordinal":146799,"en":"Do not make me the subject of gossip!"},{"id":"semetey-1-2013:p0913:b006:l031","ordinal":146800,"en":"Do not leave me alive; slaughter me"},{"id":"semetey-1-2013:p0913:b006:l032","ordinal":146801,"en":"With your own hands, forty uncles!"},{"id":"semetey-1-2013:p0913:b006:l033","ordinal":146802,"en":"Bury me in a known place;"},{"id":"semetey-1-2013:p0913:b006:l034","ordinal":146803,"en":"If you are angry, forty uncles,"},{"id":"semetey-1-2013:p0913:b006:l035","ordinal":146804,"en":"Slaughter me, the orphan!”"},{"id":"semetey-1-2013:p0914:b003:l001","ordinal":146805,"en":"Khan Manas's forty companions,"},{"id":"semetey-1-2013:p0914:b003:l002","ordinal":146806,"en":"Chyibyt and Kochkor, two scoundrels,"},{"id":"semetey-1-2013:p0914:b003:l003","ordinal":146807,"en":"Adybai and Kolbai, making four scoundrels,"},{"id":"semetey-1-2013:p0914:b003:l004","ordinal":146808,"en":"All stood up together."},{"id":"semetey-1-2013:p0914:b003:l005","ordinal":146809,"en":"Firing guns and drawing bows,"},{"id":"semetey-1-2013:p0914:b003:l006","ordinal":146810,"en":"They fought with resounding crashes."},{"id":"semetey-1-2013:p0914:b003:l007","ordinal":146811,"en":"Khan Manas's forty companions,"},{"id":"semetey-1-2013:p0914:b003:l008","ordinal":146812,"en":"At the orphan who offered his head,"},{"id":"semetey-1-2013:p0914:b003:l009","ordinal":146813,"en":"Drew their bows in showers of rain,"},{"id":"semetey-1-2013:p0914:b003:l010","ordinal":146814,"en":"Fired their shots in showers of hail."},{"id":"semetey-1-2013:p0914:b003:l011","ordinal":146815,"en":"The forty skilled companions,"},{"id":"semetey-1-2013:p0914:b003:l012","ordinal":146816,"en":"Who had thrown the whole world into confusion,"},{"id":"semetey-1-2013:p0914:b003:l013","ordinal":146817,"en":"Both mighty wrestlers and lions,"},{"id":"semetey-1-2013:p0914:b003:l014","ordinal":146818,"en":"Upon Semetey's head"},{"id":"semetey-1-2013:p0914:b003:l015","ordinal":146819,"en":"Brought trouble there."},{"id":"semetey-1-2013:p0914:b003:l016","ordinal":146820,"en":"With their jazayyl guns all together,"},{"id":"semetey-1-2013:p0914:b003:l017","ordinal":146821,"en":"All forty companions,"},{"id":"semetey-1-2013:p0914:b003:l018","ordinal":146822,"en":"Their wise men and their elders,"},{"id":"semetey-1-2013:p0914:b003:l019","ordinal":146823,"en":"At the orphan standing there pleading,"},{"id":"semetey-1-2013:p0914:b003:l020","ordinal":146824,"en":"All rushed together."},{"id":"semetey-1-2013:p0914:b003:l021","ordinal":146825,"en":"The Ochogor with its steel muzzle—"},{"id":"semetey-1-2013:p0914:b003:l022","ordinal":146826,"en":"They stood in a row and fired a thousand times."},{"id":"semetey-1-2013:p0914:b003:l023","ordinal":146827,"en":"All forty companions"},{"id":"semetey-1-2013:p0914:b003:l024","ordinal":146828,"en":"He drew his bow, raining arrows,"},{"id":"semetey-1-2013:p0914:b003:l025","ordinal":146829,"en":"Wide-mouthed lacquered arrows—"},{"id":"semetey-1-2013:p0914:b003:l026","ordinal":146830,"en":"They snatched them up and shot a thousand."},{"id":"semetey-1-2013:p0914:b003:l027","ordinal":146831,"en":"The orphan who stood his ground,"},{"id":"semetey-1-2013:p0914:b003:l028","ordinal":146832,"en":"They meant to surround and seize;"},{"id":"semetey-1-2013:p0914:b003:l029","ordinal":146833,"en":"Their true intentions had turned evil:"},{"id":"semetey-1-2013:p0914:b003:l030","ordinal":146834,"en":"They meant to slaughter him as a sacrifice."},{"id":"semetey-1-2013:p0914:b003:l031","ordinal":146835,"en":"If they had the power,"},{"id":"semetey-1-2013:p0914:b003:l032","ordinal":146836,"en":"They would drag him onto the road"},{"id":"semetey-1-2013:p0914:b003:l033","ordinal":146837,"en":"For full-grown dogs to tear apart."},{"id":"semetey-1-2013:p0914:b003:l034","ordinal":146838,"en":"Chyibyt and Kochkor, two scoundrels,"},{"id":"semetey-1-2013:p0914:b003:l035","ordinal":146839,"en":"Adybai and Kolbai, making four scoundrels,"},{"id":"semetey-1-2013:p0914:b003:l036","ordinal":146840,"en":"Sons of a junior wife,"},{"id":"semetey-1-2013:p0914:b003:l037","ordinal":146841,"en":"Their thoughts had turned apart."},{"id":"semetey-1-2013:p0914:b003:l038","ordinal":146842,"en":"The forty companions left by Manas"},{"id":"semetey-1-2013:p0914:b003:l039","ordinal":146843,"en":"Pressed fiercely, drawing their bows."},{"id":"semetey-1-2013:p0914:b004:l001","ordinal":146844,"en":"Look at the haze and sparks,"},{"id":"semetey-1-2013:p0914:b004:l002","ordinal":146845,"en":"Look at the shots that strike without swerving;"},{"id":"semetey-1-2013:p0914:b004:l003","ordinal":146846,"en":"Thrusting spears from every corner,"},{"id":"semetey-1-2013:p0914:b004:l004","ordinal":146847,"en":"Look at the throng that swarmed upon him."},{"id":"semetey-1-2013:p0914:b004:l005","ordinal":146848,"en":"Piercing cries and fierce cheering—"},{"id":"semetey-1-2013:p0914:b004:l006","ordinal":146849,"en":"Those forty companions of Manas:"},{"id":"semetey-1-2013:p0914:b004:l007","ordinal":146850,"en":"A wolf's teeth could not pierce them in a fight,"},{"id":"semetey-1-2013:p0914:b004:l008","ordinal":146851,"en":"The world's strength could not overcome them."},{"id":"semetey-1-2013:p0914:b004:l009","ordinal":146852,"en":"Lacquered spears with deep sockets,"},{"id":"semetey-1-2013:p0914:b004:l010","ordinal":146853,"en":"With steel joined to their tips,"},{"id":"semetey-1-2013:p0914:b004:l011","ordinal":146854,"en":"That felled whoever came their way—"},{"id":"semetey-1-2013:p0914:b004:l012","ordinal":146855,"en":"The forty expert spearmen"},{"id":"semetey-1-2013:p0914:b004:l013","ordinal":146856,"en":"Shouted and thrust their spears,"},{"id":"semetey-1-2013:p0914:b004:l014","ordinal":146857,"en":"Pressing in by tens and fives,"},{"id":"semetey-1-2013:p0914:b004:l015","ordinal":146858,"en":"Striking with spears from every side."},{"id":"semetey-1-2013:p0914:b004:l016","ordinal":146859,"en":"Manas's son, the warrior orphan,"},{"id":"semetey-1-2013:p0914:b004:l017","ordinal":146860,"en":"Stood his ground unconcerned;"},{"id":"semetey-1-2013:p0914:b004:l018","ordinal":146861,"en":"All those spears"},{"id":"semetey-1-2013:p0914:b004:l019","ordinal":146862,"en":"He counted as nothing."},{"id":"semetey-1-2013:p0914:b004:l020","ordinal":146863,"en":"The orphan stood motionless."},{"id":"semetey-1-2013:p0914:b004:l021","ordinal":146864,"en":"They threw aside their spears"},{"id":"semetey-1-2013:p0914:b004:l022","ordinal":146865,"en":"And struck with axes."},{"id":"semetey-1-2013:p0914:b004:l023","ordinal":146866,"en":"They stormed and clamored,"},{"id":"semetey-1-2013:p0914:b004:l024","ordinal":146867,"en":"Swinging battle-axes, thrusting spears;"},{"id":"semetey-1-2013:p0914:b004:l025","ordinal":146868,"en":"The fighting grew costly."},{"id":"semetey-1-2013:p0914:b004:l026","ordinal":146869,"en":"They took their swords in hand,"},{"id":"semetey-1-2013:p0914:b004:l027","ordinal":146870,"en":"Without sparing themselves, at the orphan,"},{"id":"semetey-1-2013:p0914:b004:l028","ordinal":146871,"en":"Shouted and struck with swords."},{"id":"semetey-1-2013:p0914:b004:l029","ordinal":146872,"en":"The wolf-maned one's son, the warrior orphan—"},{"id":"semetey-1-2013:p0914:b004:l030","ordinal":146873,"en":"His breast could not contain his many cares."},{"id":"semetey-1-2013:p0914:b004:l031","ordinal":146874,"en":"The wolf-maned one's orphan son,"},{"id":"semetey-1-2013:p0914:b004:l032","ordinal":146875,"en":"His tears streamed in all directions."},{"id":"semetey-1-2013:p0914:b004:l033","ordinal":146876,"en":"The dear lion, proud as a cock,"},{"id":"semetey-1-2013:p0914:b004:l034","ordinal":146877,"en":"Though they inflicted such humiliation,"},{"id":"semetey-1-2013:p0914:b004:l035","ordinal":146878,"en":"The dear warrior did not move."},{"id":"semetey-1-2013:p0914:b004:l036","ordinal":146879,"en":"A helmet of blue iron"},{"id":"semetey-1-2013:p0914:b004:l037","ordinal":146880,"en":"Was on the wolf-maned orphan's head,"},{"id":"semetey-1-2013:p0914:b004:l038","ordinal":146881,"en":"Fitted down over it;"},{"id":"semetey-1-2013:p0914:b004:l039","ordinal":146882,"en":"The armor of his ribs—"},{"id":"semetey-1-2013:p0915:b003:l001","ordinal":146883,"en":"Impervious to missiles, upon the orphan's"},{"id":"semetey-1-2013:p0915:b003:l002","ordinal":146884,"en":"Shoulder blades it lay:"},{"id":"semetey-1-2013:p0915:b003:l003","ordinal":146885,"en":"His mother Kanykei"},{"id":"semetey-1-2013:p0915:b003:l004","ordinal":146886,"en":"Had fitted that iron securely."},{"id":"semetey-1-2013:p0915:b003:l005","ordinal":146887,"en":"The Akolpok left by Manas—"},{"id":"semetey-1-2013:p0915:b003:l006","ordinal":146888,"en":"Forged its metal from hard steel,"},{"id":"semetey-1-2013:p0915:b003:l007","ordinal":146889,"en":"It wearied the bullets of Kelte;"},{"id":"semetey-1-2013:p0915:b003:l008","ordinal":146890,"en":"One skilled artisan after another fashioned it,"},{"id":"semetey-1-2013:p0915:b003:l009","ordinal":146891,"en":"And submitted to the wise for testing."},{"id":"semetey-1-2013:p0915:b003:l010","ordinal":146892,"en":"Gold and silk intermingled,"},{"id":"semetey-1-2013:p0915:b003:l011","ordinal":146893,"en":"I shot sixty warriors."},{"id":"semetey-1-2013:p0915:b003:l012","ordinal":146894,"en":"In difficult, grievous straits,"},{"id":"semetey-1-2013:p0915:b003:l013","ordinal":146895,"en":"The Akolpok—not merely against forty companions—"},{"id":"semetey-1-2013:p0915:b003:l014","ordinal":146896,"en":"In battle against the Chinese emperor,"},{"id":"semetey-1-2013:p0915:b003:l015","ordinal":146897,"en":"When he brought terrible hell upon them,"},{"id":"semetey-1-2013:p0915:b003:l016","ordinal":146898,"en":"When he fired amid tumult,"},{"id":"semetey-1-2013:p0915:b003:l017","ordinal":146899,"en":"No striking missile passed through,"},{"id":"semetey-1-2013:p0915:b003:l018","ordinal":146900,"en":"No steel shot passed through."},{"id":"semetey-1-2013:p0915:b003:l019","ordinal":146901,"en":"From his wolf-maned father Manas,"},{"id":"semetey-1-2013:p0915:b003:l020","ordinal":146902,"en":"The Akolpok remained as a gift."},{"id":"semetey-1-2013:p0915:b003:l021","ordinal":146903,"en":"Trouble-laden and unfortunate,"},{"id":"semetey-1-2013:p0915:b003:l022","ordinal":146904,"en":"Your tiger mother Kanykei,"},{"id":"semetey-1-2013:p0915:b003:l023","ordinal":146905,"en":"Of the companions left by Manas,"},{"id":"semetey-1-2013:p0915:b003:l024","ordinal":146906,"en":"Foretold that they would become enemies."},{"id":"semetey-1-2013:p0915:b003:l025","ordinal":146907,"en":"Shrieked above the head"},{"id":"semetey-1-2013:p0915:b003:l026","ordinal":146908,"en":"May cross his path,” she said."},{"id":"semetey-1-2013:p0915:b003:l027","ordinal":146909,"en":"“Suddenly my orphan"},{"id":"semetey-1-2013:p0915:b003:l028","ordinal":146910,"en":"May meet a needless death,” she said."},{"id":"semetey-1-2013:p0915:b003:l029","ordinal":146911,"en":"The noble woman Kanykei"},{"id":"semetey-1-2013:p0915:b003:l030","ordinal":146912,"en":"Had clothed him in the Akolpok,"},{"id":"semetey-1-2013:p0915:b003:l031","ordinal":146913,"en":"And at his throat its fastenings"},{"id":"semetey-1-2013:p0915:b003:l032","ordinal":146914,"en":"Had tied across one another."},{"id":"semetey-1-2013:p0915:b003:l033","ordinal":146915,"en":"At the sight, the heart was stirred;"},{"id":"semetey-1-2013:p0915:b003:l034","ordinal":146916,"en":"The wolf-maned lord Manas—"},{"id":"semetey-1-2013:p0915:b003:l035","ordinal":146917,"en":"He looked just like him."},{"id":"semetey-1-2013:p0915:b003:l036","ordinal":146918,"en":"Having assailed the Khizr-blessed lion,"},{"id":"semetey-1-2013:p0915:b003:l037","ordinal":146919,"en":"The forty companions had no good fortune;"},{"id":"semetey-1-2013:p0915:b003:l038","ordinal":146920,"en":"There was no hole in the Akolpok."},{"id":"semetey-1-2013:p0915:b003:l039","ordinal":146921,"en":"What is seen today is gone tomorrow;"},{"id":"semetey-1-2013:p0915:b005:l001","ordinal":146922,"en":"His own kin had become enemies:"},{"id":"semetey-1-2013:p0915:b005:l002","ordinal":146923,"en":"Such is this shitty world!"},{"id":"semetey-1-2013:p0915:b005:l003","ordinal":146924,"en":"His insides burned, his liver was an ember."},{"id":"semetey-1-2013:p0915:b005:l004","ordinal":146925,"en":"“A wandering orphan,” they called him;"},{"id":"semetey-1-2013:p0915:b005:l005","ordinal":146926,"en":"No kinsman understood his secret grief."},{"id":"semetey-1-2013:p0915:b005:l006","ordinal":146927,"en":"“I went on calling you exceptional kin;"},{"id":"semetey-1-2013:p0915:b005:l007","ordinal":146928,"en":"Only a spoonful of my blood remains,"},{"id":"semetey-1-2013:p0915:b005:l008","ordinal":146929,"en":"My flesh is left blue and lean."},{"id":"semetey-1-2013:p0915:b005:l009","ordinal":146930,"en":"I rode Buurul, calling him a swift steed;"},{"id":"semetey-1-2013:p0915:b005:l010","ordinal":146931,"en":"Damn this empty world!"},{"id":"semetey-1-2013:p0915:b005:l011","ordinal":146932,"en":"I turned to you as my only kin."},{"id":"semetey-1-2013:p0915:b005:l012","ordinal":146933,"en":"Either my sorrow does not reach God,"},{"id":"semetey-1-2013:p0915:b005:l013","ordinal":146934,"en":"Or I cannot turn to my kin."},{"id":"semetey-1-2013:p0915:b005:l014","ordinal":146935,"en":"That my saddle straps had grown stiff,"},{"id":"semetey-1-2013:p0915:b005:l015","ordinal":146936,"en":"My horse knew as it staggered;"},{"id":"semetey-1-2013:p0915:b005:l016","ordinal":146937,"en":"That my dear soul had burned away,"},{"id":"semetey-1-2013:p0915:b005:l017","ordinal":146938,"en":"Strangers knew, my own kin did not."},{"id":"semetey-1-2013:p0915:b005:l018","ordinal":146939,"en":"Now, to streams in valleys and broad waters,"},{"id":"semetey-1-2013:p0915:b005:l019","ordinal":146940,"en":"I have no livestock to drive upstream."},{"id":"semetey-1-2013:p0915:b005:l020","ordinal":146941,"en":"My own kin have become my enemies;"},{"id":"semetey-1-2013:p0915:b005:l021","ordinal":146942,"en":"Now I have no life to spare from death."},{"id":"semetey-1-2013:p0915:b005:l022","ordinal":146943,"en":"Hilly Ken-Kol, broad Talas—"},{"id":"semetey-1-2013:p0915:b005:l023","ordinal":146944,"en":"I have no livestock to drive there."}]
