[{"id":"semetey-1-2013:p1116:b003:l011","ordinal":162305,"en":"If a quarrel happens by chance,"},{"id":"semetey-1-2013:p1116:b003:l012","ordinal":162306,"en":"If they happen to leave in anger,"},{"id":"semetey-1-2013:p1116:b003:l013","ordinal":162307,"en":"Perhaps they will slaughter us."},{"id":"semetey-1-2013:p1116:b003:l014","ordinal":162308,"en":"Perhaps they will lay low"},{"id":"semetey-1-2013:p1116:b003:l015","ordinal":162309,"en":"Every hero who raises his head."},{"id":"semetey-1-2013:p1116:b003:l016","ordinal":162310,"en":"Perhaps they will bind the weak and feeble"},{"id":"semetey-1-2013:p1116:b003:l017","ordinal":162311,"en":"And take them away"},{"id":"semetey-1-2013:p1116:b003:l018","ordinal":162312,"en":"To the seething Kalmyks.”"},{"id":"semetey-1-2013:p1116:b003:l019","ordinal":162313,"en":"When the Kalmyk vanguard arrived,"},{"id":"semetey-1-2013:p1116:b003:l020","ordinal":162314,"en":"The great people ran in fear,"},{"id":"semetey-1-2013:p1116:b003:l021","ordinal":162315,"en":"All despairing of life."},{"id":"semetey-1-2013:p1116:b003:l022","ordinal":162316,"en":"What could the wretched few people do,"},{"id":"semetey-1-2013:p1116:b003:l023","ordinal":162317,"en":"Stamping the ground in agitation?"},{"id":"semetey-1-2013:p1116:b003:l024","ordinal":162318,"en":"What recourse had those people"},{"id":"semetey-1-2013:p1116:b003:l025","ordinal":162319,"en":"As they blamed Bokmurun?"},{"id":"semetey-1-2013:p1116:b003:l026","ordinal":162320,"en":"Before much time had passed—"},{"id":"semetey-1-2013:p1116:b003:l027","ordinal":162321,"en":"May God never show us such a sight!—"},{"id":"semetey-1-2013:p1116:b003:l028","ordinal":162322,"en":"A din came that split the earth;"},{"id":"semetey-1-2013:p1116:b003:l029","ordinal":162323,"en":"Seven standard-banners came;"},{"id":"semetey-1-2013:p1116:b003:l030","ordinal":162324,"en":"An army spreading across the land came."},{"id":"semetey-1-2013:p1116:b003:l031","ordinal":162325,"en":"The spear points glittered;"},{"id":"semetey-1-2013:p1116:b003:l032","ordinal":162326,"en":"The people's heads swayed."},{"id":"semetey-1-2013:p1116:b003:l033","ordinal":162327,"en":"At the sight, the Muslims'"},{"id":"semetey-1-2013:p1116:b003:l034","ordinal":162328,"en":"Hearts throbbed without cease."},{"id":"semetey-1-2013:p1116:b003:l035","ordinal":162329,"en":"As though splitting the mountains, a multitude came;"},{"id":"semetey-1-2013:p1116:b003:l036","ordinal":162330,"en":"An army like a surging sea came."},{"id":"semetey-1-2013:p1116:b003:l037","ordinal":162331,"en":"Mountain-like Manas was not there;"},{"id":"semetey-1-2013:p1116:b003:l038","ordinal":162332,"en":"Tormented souls were stricken with anguish."},{"id":"semetey-1-2013:p1116:b003:l039","ordinal":162333,"en":"When they asked whose army it was,"},{"id":"semetey-1-2013:p1116:b004:l001","ordinal":162334,"en":"It was Khan Zholoy's army."},{"id":"semetey-1-2013:p1116:b004:l002","ordinal":162335,"en":"Bokmurun's arrogance"},{"id":"semetey-1-2013:p1116:b004:l003","ordinal":162336,"en":"Was the Muslim people's misfortune."},{"id":"semetey-1-2013:p1116:b004:l004","ordinal":162337,"en":"Khan Zholoy of the Kalmyks—"},{"id":"semetey-1-2013:p1116:b004:l005","ordinal":162338,"en":"His appearance and grandeur,"},{"id":"semetey-1-2013:p1116:b004:l006","ordinal":162339,"en":"His figure mounted on his horse,"},{"id":"semetey-1-2013:p1116:b004:l007","ordinal":162340,"en":"Looked as vast as Ala-Too."},{"id":"semetey-1-2013:p1116:b004:l008","ordinal":162341,"en":"Khan Zholoy of the Kalmyks"},{"id":"semetey-1-2013:p1116:b004:l009","ordinal":162342,"en":"Put on his gauntlet,"},{"id":"semetey-1-2013:p1116:b004:l010","ordinal":162343,"en":"Raging like a boar."},{"id":"semetey-1-2013:p1116:b004:l011","ordinal":162344,"en":"If you were to see Zholoy,"},{"id":"semetey-1-2013:p1116:b004:l012","ordinal":162345,"en":"He was the summit of a snowy mountain,"},{"id":"semetey-1-2013:p1116:b004:l013","ordinal":162346,"en":"The prince of the Black Kalmyks."},{"id":"semetey-1-2013:p1116:b004:l014","ordinal":162347,"en":"When Khan Zholoy entered,"},{"id":"semetey-1-2013:p1116:b004:l015","ordinal":162348,"en":"The mere handful of Muslims"},{"id":"semetey-1-2013:p1116:b004:l016","ordinal":162349,"en":"Split apart and scattered,"},{"id":"semetey-1-2013:p1116:b004:l017","ordinal":162350,"en":"All running without saying,"},{"id":"semetey-1-2013:p1116:b004:l018","ordinal":162351,"en":"“Welcome, guest, welcome.”"},{"id":"semetey-1-2013:p1116:b004:l019","ordinal":162352,"en":"Flying like arrows as they ran,"},{"id":"semetey-1-2013:p1116:b004:l020","ordinal":162353,"en":"Kökötöy's wrestlers"},{"id":"semetey-1-2013:p1116:b004:l021","ordinal":162354,"en":"Took Zholoy's horse;"},{"id":"semetey-1-2013:p1116:b004:l022","ordinal":162355,"en":"The mountain-like giant Zholoy"},{"id":"semetey-1-2013:p1116:b004:l023","ordinal":162356,"en":"Dismounted, swelling with pride."},{"id":"semetey-1-2013:p1116:b004:l024","ordinal":162357,"en":"Behind him his Kalmyks,"},{"id":"semetey-1-2013:p1116:b004:l025","ordinal":162358,"en":"Massed like hairs on a cow,"},{"id":"semetey-1-2013:p1116:b004:l026","ordinal":162359,"en":"Also dismounted together."},{"id":"semetey-1-2013:p1116:b004:l027","ordinal":162360,"en":"Kökötöy's son Bokmurun—"},{"id":"semetey-1-2013:p1116:b004:l028","ordinal":162361,"en":"The torment he brought upon the people!"},{"id":"semetey-1-2013:p1116:b004:l029","ordinal":162362,"en":"The great hardship that now arose"},{"id":"semetey-1-2013:p1116:b004:l030","ordinal":162363,"en":"Was the punishment of the Kalmyks."},{"id":"semetey-1-2013:p1116:b004:l031","ordinal":162364,"en":"Saying, “Have you arrived, honored guest?”"},{"id":"semetey-1-2013:p1116:b004:l032","ordinal":162365,"en":"Bokmurun walked forward"},{"id":"semetey-1-2013:p1116:b004:l033","ordinal":162366,"en":"Before Great Zholoy."},{"id":"semetey-1-2013:p1116:b004:l034","ordinal":162367,"en":"Bokmurun had exactly thirty thousand"},{"id":"semetey-1-2013:p1116:b004:l035","ordinal":162368,"en":"Wrestlers serving him;"},{"id":"semetey-1-2013:p1116:b004:l036","ordinal":162369,"en":"For Zholoy of the Kalmyks,"},{"id":"semetey-1-2013:p1116:b004:l037","ordinal":162370,"en":"They prepared the food he would eat."},{"id":"semetey-1-2013:p1116:b004:l038","ordinal":162371,"en":"The mere handful of Muslims wondered,"},{"id":"semetey-1-2013:p1116:b004:l039","ordinal":162372,"en":"“Good Lord, what will he do?”"},{"id":"semetey-1-2013:p1117:b003:l001","ordinal":162373,"en":"They had scarcely any sense left."},{"id":"semetey-1-2013:p1117:b003:l002","ordinal":162374,"en":"When he learned that the people were afraid,"},{"id":"semetey-1-2013:p1117:b003:l003","ordinal":162375,"en":"Kökötöy's son Bokmurun"},{"id":"semetey-1-2013:p1117:b003:l004","ordinal":162376,"en":"From Kökötöy's ingots of red gold"},{"id":"semetey-1-2013:p1117:b003:l005","ordinal":162377,"en":"Wrapped in great sheets of hide,"},{"id":"semetey-1-2013:p1117:b003:l006","ordinal":162378,"en":"Saying, “This is your reward,”"},{"id":"semetey-1-2013:p1117:b003:l007","ordinal":162379,"en":"He brought them before him"},{"id":"semetey-1-2013:p1117:b003:l008","ordinal":162380,"en":"And weighed out six."},{"id":"semetey-1-2013:p1117:b003:l009","ordinal":162381,"en":"Khan Zholoy of the Kalmyks"},{"id":"semetey-1-2013:p1117:b003:l010","ordinal":162382,"en":"Looked at the boy"},{"id":"semetey-1-2013:p1117:b003:l011","ordinal":162383,"en":"And was pleased."},{"id":"semetey-1-2013:p1117:b003:l012","ordinal":162384,"en":"For Khan Zholoy's slaughter beasts,"},{"id":"semetey-1-2013:p1117:b003:l013","ordinal":162385,"en":"He released and drove out a herd"},{"id":"semetey-1-2013:p1117:b003:l014","ordinal":162386,"en":"From Kökötöy's countless livestock."},{"id":"semetey-1-2013:p1117:b003:l015","ordinal":162387,"en":"Into brave Zholoy's hands,"},{"id":"semetey-1-2013:p1117:b003:l016","ordinal":162388,"en":"He gave six thousand wethers and a thousand mares"},{"id":"semetey-1-2013:p1117:b003:l017","ordinal":162389,"en":"For slaughter, they say."},{"id":"semetey-1-2013:p1117:b003:l018","ordinal":162390,"en":"Sugar piled like camels and cattle"},{"id":"semetey-1-2013:p1117:b003:l019","ordinal":162391,"en":"He gave them to break up, they say."},{"id":"semetey-1-2013:p1117:b003:l020","ordinal":162392,"en":"Firewood enough for six thousand camels"},{"id":"semetey-1-2013:p1117:b003:l021","ordinal":162393,"en":"He gave them to burn, they say."},{"id":"semetey-1-2013:p1117:b003:l022","ordinal":162394,"en":"Black liquor brought in loads,"},{"id":"semetey-1-2013:p1117:b003:l023","ordinal":162395,"en":"And liquor in Kalmyk leather flasks,"},{"id":"semetey-1-2013:p1117:b003:l024","ordinal":162396,"en":"From the days when trouble first arose,"},{"id":"semetey-1-2013:p1117:b003:l025","ordinal":162397,"en":"Kökötöy's son Bokmurun"},{"id":"semetey-1-2013:p1117:b003:l026","ordinal":162398,"en":"Had prepared beforehand."},{"id":"semetey-1-2013:p1117:b003:l027","ordinal":162399,"en":"Six zhaga measures and one leather flask"},{"id":"semetey-1-2013:p1117:b003:l028","ordinal":162400,"en":"He gave them for drink, they say."},{"id":"semetey-1-2013:p1117:b003:l029","ordinal":162401,"en":"All the wealth in the world"},{"id":"semetey-1-2013:p1117:b003:l030","ordinal":162402,"en":"He cast into the very center, they say."},{"id":"semetey-1-2013:p1117:b003:l031","ordinal":162403,"en":"He put Zholoy's heart at ease"},{"id":"semetey-1-2013:p1117:b003:l032","ordinal":162404,"en":"And, with his great army, settled Zholoy"},{"id":"semetey-1-2013:p1117:b003:l033","ordinal":162405,"en":"Against the foot of the hill, they say."},{"id":"semetey-1-2013:p1117:b003:l034","ordinal":162406,"en":"Let us leave this matter here"},{"id":"semetey-1-2013:p1117:b003:l035","ordinal":162407,"en":"And begin from the other side."},{"id":"semetey-1-2013:p1117:b003:l036","ordinal":162408,"en":"There was yet another spectacle."},{"id":"semetey-1-2013:p1117:b003:l037","ordinal":162409,"en":"Then dust curled into the sky;"},{"id":"semetey-1-2013:p1117:b003:l038","ordinal":162410,"en":"The great army that came covering the land"},{"id":"semetey-1-2013:p1117:b003:l039","ordinal":162411,"en":"Collided with one another,"},{"id":"semetey-1-2013:p1117:b004:l001","ordinal":162412,"en":"Drawing back and standing fast."},{"id":"semetey-1-2013:p1117:b004:l002","ordinal":162413,"en":"The great army that came to the feast"},{"id":"semetey-1-2013:p1117:b004:l003","ordinal":162414,"en":"Knew no human language at all,"},{"id":"semetey-1-2013:p1117:b004:l004","ordinal":162415,"en":"And quarreled in Shibee speech."},{"id":"semetey-1-2013:p1117:b004:l005","ordinal":162416,"en":"Their spears held ready,"},{"id":"semetey-1-2013:p1117:b004:l006","ordinal":162417,"en":"The Shibee people were a strange sight,"},{"id":"semetey-1-2013:p1117:b004:l007","ordinal":162418,"en":"Their swords belted on without scabbards."},{"id":"semetey-1-2013:p1117:b004:l008","ordinal":162419,"en":"They walked in swaying rows,"},{"id":"semetey-1-2013:p1117:b004:l009","ordinal":162420,"en":"Tying dirty black kerchiefs"},{"id":"semetey-1-2013:p1117:b004:l010","ordinal":162421,"en":"At the napes of their necks."},{"id":"semetey-1-2013:p1117:b004:l011","ordinal":162422,"en":"They dressed in the Shibee manner,"},{"id":"semetey-1-2013:p1117:b004:l012","ordinal":162423,"en":"Fashioned spears from reeds,"},{"id":"semetey-1-2013:p1117:b004:l013","ordinal":162424,"en":"And each man tied at his side"},{"id":"semetey-1-2013:p1117:b004:l014","ordinal":162425,"en":"A club as large as a fist."},{"id":"semetey-1-2013:p1117:b004:l015","ordinal":162426,"en":"When they roared, their speech could not be understood;"},{"id":"semetey-1-2013:p1117:b004:l016","ordinal":162427,"en":"They shouted at one another in Shibee."},{"id":"semetey-1-2013:p1117:b004:l017","ordinal":162428,"en":"They caught and ate badgers,"},{"id":"semetey-1-2013:p1117:b004:l018","ordinal":162429,"en":"And ate frogs and snakes alike."},{"id":"semetey-1-2013:p1117:b004:l019","ordinal":162430,"en":"Calling it Khan Kökötöy's memorial feast,"},{"id":"semetey-1-2013:p1117:b004:l020","ordinal":162431,"en":"The great mass of Shibee grew excited"},{"id":"semetey-1-2013:p1117:b004:l021","ordinal":162432,"en":"And covered the land."},{"id":"semetey-1-2013:p1117:b004:l022","ordinal":162433,"en":"Orokkyr, khan of the Shibee,"},{"id":"semetey-1-2013:p1117:b004:l023","ordinal":162434,"en":"Raged upon Kongkulboz;"},{"id":"semetey-1-2013:p1117:b004:l024","ordinal":162435,"en":"If you had seen him then,"},{"id":"semetey-1-2013:p1117:b004:l025","ordinal":162436,"en":"He was prepared in all his gear."},{"id":"semetey-1-2013:p1117:b004:l026","ordinal":162437,"en":"The sight divided one's attention;"},{"id":"semetey-1-2013:p1117:b004:l027","ordinal":162438,"en":"If you saw the Shibee people,"},{"id":"semetey-1-2013:p1117:b004:l028","ordinal":162439,"en":"They poured forth like ants."},{"id":"semetey-1-2013:p1117:b004:l029","ordinal":162440,"en":"He made Kongkulboz buck,"},{"id":"semetey-1-2013:p1117:b004:l030","ordinal":162441,"en":"Made it rear and wrench itself free."},{"id":"semetey-1-2013:p1117:b004:l031","ordinal":162442,"en":"Twelve targets ahead,"},{"id":"semetey-1-2013:p1117:b004:l032","ordinal":162443,"en":"He separated himself from the Shibee;"},{"id":"semetey-1-2013:p1117:b004:l033","ordinal":162444,"en":"Then his figure"},{"id":"semetey-1-2013:p1117:b004:l034","ordinal":162445,"en":"Looked like a naked blade."},{"id":"semetey-1-2013:p1117:b004:l035","ordinal":162446,"en":"Seven standard-banners came;"},{"id":"semetey-1-2013:p1117:b004:l036","ordinal":162447,"en":"A din that split the earth came."},{"id":"semetey-1-2013:p1117:b004:l037","ordinal":162448,"en":"Five times worse than before,"},{"id":"semetey-1-2013:p1117:b004:l038","ordinal":162449,"en":"An army that bent the earth came;"},{"id":"semetey-1-2013:p1117:b004:l039","ordinal":162450,"en":"When they saw such a host,"},{"id":"semetey-1-2013:p1118:b003:l001","ordinal":162451,"en":"Anguish struck the Muslims."},{"id":"semetey-1-2013:p1118:b003:l002","ordinal":162452,"en":"The dear people, who had never seen such a thing,"},{"id":"semetey-1-2013:p1118:b003:l003","ordinal":162453,"en":"Their temples drawn tight,"},{"id":"semetey-1-2013:p1118:b003:l004","ordinal":162454,"en":"Could find no composure"},{"id":"semetey-1-2013:p1118:b003:l005","ordinal":162455,"en":"And quarreled with their leader."},{"id":"semetey-1-2013:p1118:b003:l006","ordinal":162456,"en":"They stamped the ground where they stood,"},{"id":"semetey-1-2013:p1118:b003:l007","ordinal":162457,"en":"Each blaming another."},{"id":"semetey-1-2013:p1118:b003:l008","ordinal":162458,"en":"“We were a people living at ease;"},{"id":"semetey-1-2013:p1118:b003:l009","ordinal":162459,"en":"Have we now met disaster?"},{"id":"semetey-1-2013:p1118:b003:l010","ordinal":162460,"en":"Coming thoughtlessly to this feast,"},{"id":"semetey-1-2013:p1118:b003:l011","ordinal":162461,"en":"Have we suffered this humiliation"},{"id":"semetey-1-2013:p1118:b003:l012","ordinal":162462,"en":"From Kökötöy's bastard Bokmurun?"},{"id":"semetey-1-2013:p1118:b003:l013","ordinal":162463,"en":"Kökötöy's son Bokmurun"},{"id":"semetey-1-2013:p1118:b003:l014","ordinal":162464,"en":"Had an extraordinary design;"},{"id":"semetey-1-2013:p1118:b003:l015","ordinal":162465,"en":"He is the son Khan Kökötöy"},{"id":"semetey-1-2013:p1118:b003:l016","ordinal":162466,"en":"Found through grief."},{"id":"semetey-1-2013:p1118:b003:l017","ordinal":162467,"en":"Gathering people like ants,"},{"id":"semetey-1-2013:p1118:b003:l018","ordinal":162468,"en":"He has cast us into turmoil."},{"id":"semetey-1-2013:p1118:b003:l019","ordinal":162469,"en":"The tale would never end"},{"id":"semetey-1-2013:p1118:b003:l020","ordinal":162470,"en":"Of the strange peoples who have come."},{"id":"semetey-1-2013:p1118:b003:l021","ordinal":162471,"en":"May God strike these Shibee!"},{"id":"semetey-1-2013:p1118:b003:l022","ordinal":162472,"en":"Perhaps they will charge with spears"},{"id":"semetey-1-2013:p1118:b003:l023","ordinal":162473,"en":"And slaughter every one of us."},{"id":"semetey-1-2013:p1118:b003:l024","ordinal":162474,"en":"We came to see"},{"id":"semetey-1-2013:p1118:b003:l025","ordinal":162475,"en":"Kökötöy's great memorial feast;"},{"id":"semetey-1-2013:p1118:b003:l026","ordinal":162476,"en":"After suffering great disaster from the Chinese,"},{"id":"semetey-1-2013:p1118:b003:l027","ordinal":162477,"en":"It seems we have come here to die!"},{"id":"semetey-1-2013:p1118:b003:l028","ordinal":162478,"en":"When nine wolves fall upon sheep,"},{"id":"semetey-1-2013:p1118:b003:l029","ordinal":162479,"en":"Will they leave even the carcasses?"},{"id":"semetey-1-2013:p1118:b003:l030","ordinal":162480,"en":"When the surging Chinese beat these people,"},{"id":"semetey-1-2013:p1118:b003:l031","ordinal":162481,"en":"Will they leave even their carcasses?"},{"id":"semetey-1-2013:p1118:b003:l032","ordinal":162482,"en":"We came to witness"},{"id":"semetey-1-2013:p1118:b003:l033","ordinal":162483,"en":"The service of Köpkölöng;"},{"id":"semetey-1-2013:p1118:b003:l034","ordinal":162484,"en":"It seems we came to die"},{"id":"semetey-1-2013:p1118:b003:l035","ordinal":162485,"en":"At the hands of Kalmyks covering the earth."},{"id":"semetey-1-2013:p1118:b003:l036","ordinal":162486,"en":"If they charge without restraint,"},{"id":"semetey-1-2013:p1118:b003:l037","ordinal":162487,"en":"We will all meet our end together;"},{"id":"semetey-1-2013:p1118:b003:l038","ordinal":162488,"en":"Will they not slaughter us to the last?"},{"id":"semetey-1-2013:p1118:b003:l039","ordinal":162489,"en":"We ate no feast but ate stones;"},{"id":"semetey-1-2013:p1118:b004:l001","ordinal":162490,"en":"We ate no celebration but ate bullets."},{"id":"semetey-1-2013:p1118:b004:l002","ordinal":162491,"en":"If these Kalmyks attack together,"},{"id":"semetey-1-2013:p1118:b004:l003","ordinal":162492,"en":"They will all draw their bows;"},{"id":"semetey-1-2013:p1118:b004:l004","ordinal":162493,"en":"After slaughtering us all,"},{"id":"semetey-1-2013:p1118:b004:l005","ordinal":162494,"en":"They will sing their victory song."},{"id":"semetey-1-2013:p1118:b004:l006","ordinal":162495,"en":"Leaving none of us unharmed,"},{"id":"semetey-1-2013:p1118:b004:l007","ordinal":162496,"en":"They will take us as plunder."},{"id":"semetey-1-2013:p1118:b004:l008","ordinal":162497,"en":"They will bring hardship upon us together;"},{"id":"semetey-1-2013:p1118:b004:l009","ordinal":162498,"en":"They will slaughter every one of us!"},{"id":"semetey-1-2013:p1118:b004:l010","ordinal":162499,"en":"This is a glassy, open plain;"},{"id":"semetey-1-2013:p1118:b004:l011","ordinal":162500,"en":"There is no ridge to flee toward."},{"id":"semetey-1-2013:p1118:b004:l012","ordinal":162501,"en":"When we suffer calamity,"},{"id":"semetey-1-2013:p1118:b004:l013","ordinal":162502,"en":"The renowned lion Manas is not here"},{"id":"semetey-1-2013:p1118:b004:l014","ordinal":162503,"en":"To separate and rescue us."},{"id":"semetey-1-2013:p1118:b004:l015","ordinal":162504,"en":"There is no Talas to flee back upon;"},{"id":"semetey-1-2013:p1118:b004:l016","ordinal":162505,"en":"If they clash and fight,"},{"id":"semetey-1-2013:p1118:b004:l017","ordinal":162506,"en":"Princely Manas the leopard is not here"},{"id":"semetey-1-2013:p1118:b004:l018","ordinal":162507,"en":"To separate and rescue us.”"},{"id":"semetey-1-2013:p1118:b004:l019","ordinal":162508,"en":"The Muslims sighed and grieved,"},{"id":"semetey-1-2013:p1118:b004:l020","ordinal":162509,"en":"Overwhelmed"},{"id":"semetey-1-2013:p1118:b004:l021","ordinal":162510,"en":"And despairing of their entrusted lives."},{"id":"semetey-1-2013:p1118:b004:l022","ordinal":162511,"en":"Before much time had passed,"},{"id":"semetey-1-2013:p1118:b004:l023","ordinal":162512,"en":"Before one could say this or that,"},{"id":"semetey-1-2013:p1118:b004:l024","ordinal":162513,"en":"In the blink of an eye,"},{"id":"semetey-1-2013:p1118:b004:l025","ordinal":162514,"en":"The Muslim people parted,"},{"id":"semetey-1-2013:p1118:b004:l026","ordinal":162515,"en":"Splitting straight down the center."},{"id":"semetey-1-2013:p1118:b004:l027","ordinal":162516,"en":"If you had seen Orokkyr,"},{"id":"semetey-1-2013:p1118:b004:l028","ordinal":162517,"en":"He came prepared into their midst."},{"id":"semetey-1-2013:p1118:b004:l029","ordinal":162518,"en":"A thousand wrestlers serving the feast"},{"id":"semetey-1-2013:p1118:b004:l030","ordinal":162519,"en":"Surrounded him and took his horse."},{"id":"semetey-1-2013:p1118:b004:l031","ordinal":162520,"en":"The wrestlers took his horse;"},{"id":"semetey-1-2013:p1118:b004:l032","ordinal":162521,"en":"Swelling with pride among the people,"},{"id":"semetey-1-2013:p1118:b004:l033","ordinal":162522,"en":"Orokkyr dismounted."},{"id":"semetey-1-2013:p1118:b004:l034","ordinal":162523,"en":"From Kökötöy's great store of gold,"},{"id":"semetey-1-2013:p1118:b004:l035","ordinal":162524,"en":"For a hero such as Orokkyr,"},{"id":"semetey-1-2013:p1118:b004:l036","ordinal":162525,"en":"Kökötöy's son Bokmurun"},{"id":"semetey-1-2013:p1118:b004:l037","ordinal":162526,"en":"Presented him a gift."},{"id":"semetey-1-2013:p1118:b004:l038","ordinal":162527,"en":"Orokkyr accepted his gift"},{"id":"semetey-1-2013:p1118:b004:l039","ordinal":162528,"en":"And was pleased."},{"id":"semetey-1-2013:p1119:b003:l001","ordinal":162529,"en":"They say he gave seven thousand—a thousand yearling mares—"},{"id":"semetey-1-2013:p1119:b003:l002","ordinal":162530,"en":"For slaughter."},{"id":"semetey-1-2013:p1119:b003:l003","ordinal":162531,"en":"They say he gave lumps of sugar large as lying camels and cows"},{"id":"semetey-1-2013:p1119:b003:l004","ordinal":162532,"en":"For them to crack apart."},{"id":"semetey-1-2013:p1119:b003:l005","ordinal":162533,"en":"They say he gave the wood of seven thousand camels"},{"id":"semetey-1-2013:p1119:b003:l006","ordinal":162534,"en":"For them to burn."},{"id":"semetey-1-2013:p1119:b003:l007","ordinal":162535,"en":"Saying it was Kökötöy's feast,"},{"id":"semetey-1-2013:p1119:b003:l008","ordinal":162536,"en":"If you had seen the Shibee people,"},{"id":"semetey-1-2013:p1119:b003:l009","ordinal":162537,"en":"Saying it was a feast for the great gathering,"},{"id":"semetey-1-2013:p1119:b003:l010","ordinal":162538,"en":"They say they camped against the foothills."},{"id":"semetey-1-2013:p1119:b003:l011","ordinal":162539,"en":"There was yet another spectacle:"},{"id":"semetey-1-2013:p1119:b003:l012","ordinal":162540,"en":"A famed champion who came from Beijing,"},{"id":"semetey-1-2013:p1119:b003:l013","ordinal":162541,"en":"Whose form differed from mortal men,"},{"id":"semetey-1-2013:p1119:b003:l014","ordinal":162542,"en":"The renowned Kalcha lion."},{"id":"semetey-1-2013:p1119:b003:l015","ordinal":162543,"en":"With a cotton sash and broad boots,"},{"id":"semetey-1-2013:p1119:b003:l016","ordinal":162544,"en":"Kongurbay, khan of the monks,"},{"id":"semetey-1-2013:p1119:b003:l017","ordinal":162545,"en":"Moved like a dragon;"},{"id":"semetey-1-2013:p1119:b003:l018","ordinal":162546,"en":"Sixty nobles were his younger brothers."},{"id":"semetey-1-2013:p1119:b003:l019","ordinal":162547,"en":"Of all who came from Beijing of Kakan-Chyn,"},{"id":"semetey-1-2013:p1119:b003:l020","ordinal":162548,"en":"Who among them surpassed the Kalcha?"},{"id":"semetey-1-2013:p1119:b003:l021","ordinal":162549,"en":"Six thousand Chinese and countless kalday"},{"id":"semetey-1-2013:p1119:b003:l022","ordinal":162550,"en":"Were among the great khans of Beijing."},{"id":"semetey-1-2013:p1119:b003:l023","ordinal":162551,"en":"Their renowned khan Kongurbay,"},{"id":"semetey-1-2013:p1119:b003:l024","ordinal":162552,"en":"A servant more skillful than an intriguer,"},{"id":"semetey-1-2013:p1119:b003:l025","ordinal":162553,"en":"Who openly knew the enemy's stratagems,"},{"id":"semetey-1-2013:p1119:b003:l026","ordinal":162554,"en":"Was a mighty servant."},{"id":"semetey-1-2013:p1119:b003:l027","ordinal":162555,"en":"Do not ask of Kongurbay's station:"},{"id":"semetey-1-2013:p1119:b003:l028","ordinal":162556,"en":"Upon his head was his attire,"},{"id":"semetey-1-2013:p1119:b003:l029","ordinal":162557,"en":"Coral plumes and pearl stones,"},{"id":"semetey-1-2013:p1119:b003:l030","ordinal":162558,"en":"And among his company mingled the khan of the Zungars."},{"id":"semetey-1-2013:p1119:b003:l031","ordinal":162559,"en":"His guard spread grandly;"},{"id":"semetey-1-2013:p1119:b003:l032","ordinal":162560,"en":"A thousand souls came in his host."}]
