[{"id":"semetey-1-2013:p1075:b003:l038","ordinal":158209,"en":"Let me tell of the hero's condition."},{"id":"semetey-1-2013:p1075:b003:l039","ordinal":158210,"en":"Wrapped in the blue Kübө coat,"},{"id":"semetey-1-2013:p1075:b005:l001","ordinal":158211,"en":"Straining like a blue tiger,"},{"id":"semetey-1-2013:p1075:b005:l002","ordinal":158212,"en":"With a rope slung around his neck,"},{"id":"semetey-1-2013:p1075:b005:l003","ordinal":158213,"en":"He led a white-gray mare"},{"id":"semetey-1-2013:p1075:b005:l004","ordinal":158214,"en":"That had borne no foal for seven years."},{"id":"semetey-1-2013:p1075:b005:l005","ordinal":158215,"en":"The hero, son of Manas,"},{"id":"semetey-1-2013:p1075:b005:l006","ordinal":158216,"en":"Slung the rope around his neck"},{"id":"semetey-1-2013:p1075:b005:l007","ordinal":158217,"en":"And prayed to the Creator:"},{"id":"semetey-1-2013:p1075:b005:l008","ordinal":158218,"en":"He spread his hands, saying, \"Amen!\""},{"id":"semetey-1-2013:p1075:b005:l009","ordinal":158219,"en":"His heart cruelly divided,"},{"id":"semetey-1-2013:p1075:b005:l010","ordinal":158220,"en":"Tears pouring from his eyes,"},{"id":"semetey-1-2013:p1075:b005:l011","ordinal":158221,"en":"He slung around his neck"},{"id":"semetey-1-2013:p1075:b005:l012","ordinal":158222,"en":"The great purse left by Manas"},{"id":"semetey-1-2013:p1075:b005:l013","ordinal":158223,"en":"And prayed to the one God:"},{"id":"semetey-1-2013:p1075:b005:l014","ordinal":158224,"en":"\"Amen, God, amen!"},{"id":"semetey-1-2013:p1075:b005:l015","ordinal":158225,"en":"The one horse equal in worth to a life"},{"id":"semetey-1-2013:p1075:b005:l016","ordinal":158226,"en":"Carries the young boy away."},{"id":"semetey-1-2013:p1075:b005:l017","ordinal":158227,"en":"If you let it be flattened, that is disgrace."},{"id":"semetey-1-2013:p1075:b005:l018","ordinal":158228,"en":"Buurul, whom none would give when asked—"},{"id":"semetey-1-2013:p1075:b005:l019","ordinal":158229,"en":"When the boy mounted without inspiring envy,"},{"id":"semetey-1-2013:p1075:b005:l020","ordinal":158230,"en":"My age was cruelly scorched."},{"id":"semetey-1-2013:p1075:b005:l021","ordinal":158231,"en":"He is riding away to witness"},{"id":"semetey-1-2013:p1075:b005:l022","ordinal":158232,"en":"The suffering laid down by the Creator;"},{"id":"semetey-1-2013:p1075:b005:l023","ordinal":158233,"en":"A young boy of twelve"},{"id":"semetey-1-2013:p1075:b005:l024","ordinal":158234,"en":"Is riding away to die"},{"id":"semetey-1-2013:p1075:b005:l025","ordinal":158235,"en":"At Toltoy of the Zhediger's hands."},{"id":"semetey-1-2013:p1075:b005:l026","ordinal":158236,"en":"Will practiced Chynkozho"},{"id":"semetey-1-2013:p1075:b005:l027","ordinal":158237,"en":"Spear through and overturn"},{"id":"semetey-1-2013:p1075:b005:l028","ordinal":158238,"en":"The twelve-year-old boy,"},{"id":"semetey-1-2013:p1075:b005:l029","ordinal":158239,"en":"I lament before God,"},{"id":"semetey-1-2013:p1075:b005:l030","ordinal":158240,"en":"And take Buurul beneath him as plunder?!"},{"id":"semetey-1-2013:p1075:b005:l031","ordinal":158241,"en":"You have multiplied these worries so greatly;"},{"id":"semetey-1-2013:p1075:b005:l032","ordinal":158242,"en":"Will the Almighty reveal"},{"id":"semetey-1-2013:p1075:b005:l033","ordinal":158243,"en":"The boy, small as a crow?"},{"id":"semetey-1-2013:p1075:b005:l034","ordinal":158244,"en":"My thoroughbred Narbuudan"},{"id":"semetey-1-2013:p1075:b005:l035","ordinal":158245,"en":"Would not tire if ridden for six months."},{"id":"semetey-1-2013:p1075:b005:l036","ordinal":158246,"en":"I lament before God"},{"id":"semetey-1-2013:p1075:b005:l037","ordinal":158247,"en":"For Külchoro, my kinsman."},{"id":"semetey-1-2013:p1075:b005:l038","ordinal":158248,"en":"The prayer of my kinsman—"},{"id":"semetey-1-2013:p1075:b005:l039","ordinal":158249,"en":"Unable to remain standing, this poor soul—"}]
