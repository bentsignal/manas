[{"id":"manas-2010:p0417:b001:l015","ordinal":19201,"en":"Words of horror beyond men's knowing:"},{"id":"manas-2010:p0417:b001:l016","ordinal":19202,"en":"“My ruler Esen sent us;"},{"id":"manas-2010:p0417:b001:l017","ordinal":19203,"en":"How can we leave without fighting?"},{"id":"manas-2010:p0417:b001:l018","ordinal":19204,"en":"If we should leave without fighting,"},{"id":"manas-2010:p0417:b001:l019","ordinal":19205,"en":"'You returned in fear of Manas,' he will say;"},{"id":"manas-2010:p0417:b001:l020","ordinal":19206,"en":"Our lord Khan Esenkan"},{"id":"manas-2010:p0417:b001:l021","ordinal":19207,"en":"May suddenly slaughter us."},{"id":"manas-2010:p0417:b001:l022","ordinal":19208,"en":"Before this, when Esenkan"},{"id":"manas-2010:p0417:b001:l023","ordinal":19209,"en":"Gave his terrible order,"},{"id":"manas-2010:p0417:b001:l024","ordinal":19210,"en":"Giant Kaman and champion Döngö were there."},{"id":"manas-2010:p0417:b001:l025","ordinal":19211,"en":"Against that Burut—may his house burn!—"},{"id":"manas-2010:p0417:b001:l026","ordinal":19212,"en":"Many of us rushed recklessly;"},{"id":"manas-2010:p0417:b001:l027","ordinal":19213,"en":"We swarmed in and fought."},{"id":"manas-2010:p0417:b001:l028","ordinal":19214,"en":"To seize and bind the Burut,"},{"id":"manas-2010:p0417:b001:l029","ordinal":19215,"en":"Fierce wrath broke out."},{"id":"manas-2010:p0417:b001:l030","ordinal":19216,"en":"Your giants Döngö and Kaman,"},{"id":"manas-2010:p0417:b001:l031","ordinal":19217,"en":"He slaughtered them utterly."},{"id":"manas-2010:p0417:b001:l032","ordinal":19218,"en":"He brought great affliction;"},{"id":"manas-2010:p0417:b001:l033","ordinal":19219,"en":"Having the Kalmyks slaughtered,"},{"id":"manas-2010:p0417:b001:l034","ordinal":19220,"en":"He did whatever he pleased."},{"id":"manas-2010:p0417:b001:l035","ordinal":19221,"en":"Against the Kalmyk who fell captive,"},{"id":"manas-2010:p0417:b001:l036","ordinal":19222,"en":"He unleashed terrible wrath;"},{"id":"manas-2010:p0417:b001:l037","ordinal":19223,"en":"Inflicting cruel humiliation,"},{"id":"manas-2010:p0417:b001:l038","ordinal":19224,"en":"He cut off his testicles."},{"id":"manas-2010:p0417:b001:l039","ordinal":19225,"en":"He brought threefold turmoil at once."},{"id":"manas-2010:p0417:b001:l040","ordinal":19226,"en":"Not merely my horses, that Burut"},{"id":"manas-2010:p0417:b001:l041","ordinal":19227,"en":"Raided and took my cattle."},{"id":"manas-2010:p0417:b001:l042","ordinal":19228,"en":"Against this bloodstained one myself,"},{"id":"manas-2010:p0417:b001:l043","ordinal":19229,"en":"I attacked and learned suffering."},{"id":"manas-2010:p0417:b001:l044","ordinal":19230,"en":"If I were my own master,"},{"id":"manas-2010:p0417:b001:l045","ordinal":19231,"en":"I would not attack the bloodstained one."},{"id":"manas-2010:p0417:b001:l046","ordinal":19232,"en":"I myself would not grapple"},{"id":"manas-2010:p0417:b001:l047","ordinal":19233,"en":"With such a deceiver.”"},{"id":"manas-2010:p0417:b001:l048","ordinal":19234,"en":"Ezkara judged him and grieved;"},{"id":"manas-2010:p0418:b001:l001","ordinal":19235,"en":"The many soldiers who had swarmed there"},{"id":"manas-2010:p0418:b001:l002","ordinal":19236,"en":"Despaired of their precious lives."},{"id":"manas-2010:p0418:b001:l003","ordinal":19237,"en":"Bells rang fiercely;"},{"id":"manas-2010:p0418:b001:l004","ordinal":19238,"en":"The army lost its senses."},{"id":"manas-2010:p0418:b001:l005","ordinal":19239,"en":"To force gray-maned Manas to crouch,"},{"id":"manas-2010:p0418:b001:l006","ordinal":19240,"en":"The many lords prepared to overwhelm him."},{"id":"manas-2010:p0418:b001:l007","ordinal":19241,"en":"Those swaggering unbelievers,"},{"id":"manas-2010:p0418:b001:l008","ordinal":19242,"en":"After Esenkan gave his order,"},{"id":"manas-2010:p0418:b001:l009","ordinal":19243,"en":"From Chynmachyn and Beejin,"},{"id":"manas-2010:p0418:b001:l010","ordinal":19244,"en":"Many heroes had arrived."},{"id":"manas-2010:p0418:b001:l011","ordinal":19245,"en":"Loading ammunition on rhinoceroses,"},{"id":"manas-2010:p0418:b001:l012","ordinal":19246,"en":"Sounding trumpets and shawms,"},{"id":"manas-2010:p0418:b001:l013","ordinal":19247,"en":"Would those who came stand watching?"},{"id":"manas-2010:p0418:b001:l014","ordinal":19248,"en":"Without beginning battle and raising strife,"},{"id":"manas-2010:p0418:b001:l015","ordinal":19249,"en":"Would God strike the Kytay down?"},{"id":"manas-2010:p0418:b001:l016","ordinal":19250,"en":"They had taken orders from their khan;"},{"id":"manas-2010:p0418:b001:l017","ordinal":19251,"en":"Esenkan was their ruler,"},{"id":"manas-2010:p0418:b001:l018","ordinal":19252,"en":"They had sworn solemn oaths."},{"id":"manas-2010:p0418:b001:l019","ordinal":19253,"en":"His blood-drinking champions,"},{"id":"manas-2010:p0418:b001:l020","ordinal":19254,"en":"Raising tumult and clamor,"},{"id":"manas-2010:p0418:b001:l021","ordinal":19255,"en":"Set off in a sweeping charge."},{"id":"manas-2010:p0418:b001:l022","ordinal":19256,"en":"As his people migrated from Altay,"},{"id":"manas-2010:p0418:b001:l023","ordinal":19257,"en":"Such was the bloodstained hero's battle."},{"id":"manas-2010:p0418:b001:l024","ordinal":19258,"en":"The Kytay intended to reach him,"},{"id":"manas-2010:p0418:b001:l025","ordinal":19259,"en":"That bloodstained one born fierce,"},{"id":"manas-2010:p0418:b001:l026","ordinal":19260,"en":"To crush him and pass on,"},{"id":"manas-2010:p0418:b001:l027","ordinal":19261,"en":"If they had the strength to fight,"},{"id":"manas-2010:p0418:b001:l028","ordinal":19262,"en":"To bind him and take him to the Kakan."},{"id":"manas-2010:p0418:b001:l029","ordinal":19263,"en":"They had foot soldiers no horse could carry,"},{"id":"manas-2010:p0418:b001:l030","ordinal":19264,"en":"They had giants and mighty men."},{"id":"manas-2010:p0418:b001:l031","ordinal":19265,"en":"Straining as though rabid,"},{"id":"manas-2010:p0418:b001:l032","ordinal":19266,"en":"Their champions held in collars,"},{"id":"manas-2010:p0418:b001:l033","ordinal":19267,"en":"Upon the gray-maned one touched by Khizir,"},{"id":"manas-2010:p0418:b001:l034","ordinal":19268,"en":"They swarmed and rushed."},{"id":"manas-2010:p0418:b001:l035","ordinal":19269,"en":"Karazhoy, the great marksman,"},{"id":"manas-2010:p0418:b001:l036","ordinal":19270,"en":"Gathered his army and drove it hard;"},{"id":"manas-2010:p0418:b001:l037","ordinal":19271,"en":"He hurried his swift foot soldiers"},{"id":"manas-2010:p0418:b001:l038","ordinal":19272,"en":"And prepared along the bluff."},{"id":"manas-2010:p0418:b001:l039","ordinal":19273,"en":"Black-maned Boroonchu,"},{"id":"manas-2010:p0418:b001:l040","ordinal":19274,"en":"The champion who struck with an iron-headed mace,"},{"id":"manas-2010:p0418:b001:l041","ordinal":19275,"en":"Took a thousand chosen troops."},{"id":"manas-2010:p0418:b001:l042","ordinal":19276,"en":"Toward your bloodstained hero"},{"id":"manas-2010:p0418:b001:l043","ordinal":19277,"en":"He advanced in a sweeping charge."},{"id":"manas-2010:p0418:b001:l044","ordinal":19278,"en":"Zholoy of the Kalmyks,"},{"id":"manas-2010:p0418:b001:l045","ordinal":19279,"en":"Deft and skilled with the spear,"},{"id":"manas-2010:p0418:b001:l046","ordinal":19280,"en":"Drove them onward without resting,"},{"id":"manas-2010:p0418:b001:l047","ordinal":19281,"en":"An excellent, expert spearman."},{"id":"manas-2010:p0418:b001:l048","ordinal":19282,"en":"Great Döödür, riding a rhinoceros,"},{"id":"manas-2010:p0419:b001:l001","ordinal":19283,"en":"Rejoiced at the word of battle."},{"id":"manas-2010:p0419:b001:l002","ordinal":19284,"en":"Such was that one accursed to be crushed:"},{"id":"manas-2010:p0419:b001:l003","ordinal":19285,"en":"Clad in deep-blue iron,"},{"id":"manas-2010:p0419:b001:l004","ordinal":19286,"en":"He rejoiced at the cry of 'Enemy!'"},{"id":"manas-2010:p0419:b001:l005","ordinal":19287,"en":"Told to drink water, he drank poison;"},{"id":"manas-2010:p0419:b001:l006","ordinal":19288,"en":"He never drew back in fear of a man,"},{"id":"manas-2010:p0419:b001:l007","ordinal":19289,"en":"He never retreated from death."},{"id":"manas-2010:p0419:b001:l008","ordinal":19290,"en":"Their champions were renowned;"},{"id":"manas-2010:p0419:b001:l009","ordinal":19291,"en":"Facing one another,"},{"id":"manas-2010:p0419:b001:l010","ordinal":19292,"en":"They prepared to meet in battle."},{"id":"manas-2010:p0419:b001:l011","ordinal":19293,"en":"Drawing bows to rain arrows,"},{"id":"manas-2010:p0419:b001:l012","ordinal":19294,"en":"They prepared to fall upon Manas,"},{"id":"manas-2010:p0419:b001:l013","ordinal":19295,"en":"Firing shot like hail."},{"id":"manas-2010:p0419:b001:l014","ordinal":19296,"en":"They had outstanding men and giants;"},{"id":"manas-2010:p0419:b001:l015","ordinal":19297,"en":"Overwhelming the enemy in battle"},{"id":"manas-2010:p0419:b001:l016","ordinal":19298,"en":"Was their custom."},{"id":"manas-2010:p0419:b001:l017","ordinal":19299,"en":"Riding rhinoceroses and elephants,"},{"id":"manas-2010:p0419:b001:l018","ordinal":19300,"en":"The mighty ones had arrived."},{"id":"manas-2010:p0419:b001:l019","ordinal":19301,"en":"Firing guns and drawing bows,"},{"id":"manas-2010:p0419:b001:l020","ordinal":19302,"en":"They were esteemed for marksmanship."},{"id":"manas-2010:p0419:b001:l021","ordinal":19303,"en":"When a black gun crashed,"},{"id":"manas-2010:p0419:b001:l022","ordinal":19304,"en":"They had warriors who would not flee;"},{"id":"manas-2010:p0419:b001:l023","ordinal":19305,"en":"When a fierce gun cracked,"},{"id":"manas-2010:p0419:b001:l024","ordinal":19306,"en":"They had warriors who would not startle."},{"id":"manas-2010:p0419:b001:l025","ordinal":19307,"en":"From their great khan's presence,"},{"id":"manas-2010:p0419:b001:l026","ordinal":19308,"en":"To bring Manas bound,"},{"id":"manas-2010:p0419:b001:l027","ordinal":19309,"en":"To present him as a gift,"},{"id":"manas-2010:p0419:b001:l028","ordinal":19310,"en":"They had made thorough preparations."},{"id":"manas-2010:p0419:b001:l029","ordinal":19311,"en":"Giants no horse could carry,"},{"id":"manas-2010:p0419:b001:l030","ordinal":19312,"en":"Esenkan had sent them,"},{"id":"manas-2010:p0419:b001:l031","ordinal":19313,"en":"Footmen swifter than horses."},{"id":"manas-2010:p0419:b001:l032","ordinal":19314,"en":"Khans who would face him,"},{"id":"manas-2010:p0419:b001:l033","ordinal":19315,"en":"Esenkan had sent them;"},{"id":"manas-2010:p0419:b001:l034","ordinal":19316,"en":"Beyond any man's strength,"},{"id":"manas-2010:p0419:b001:l035","ordinal":19317,"en":"Champions like Ala-Too."},{"id":"manas-2010:p0419:b001:l036","ordinal":19318,"en":"Like bulls fattened in summer,"},{"id":"manas-2010:p0419:b001:l037","ordinal":19319,"en":"He sent his great hulking men;"},{"id":"manas-2010:p0419:b001:l038","ordinal":19320,"en":"Half a mountain in size,"},{"id":"manas-2010:p0419:b001:l039","ordinal":19321,"en":"He sent his towering men."},{"id":"manas-2010:p0419:b001:l040","ordinal":19322,"en":"Terrible slaughter in battle,"},{"id":"manas-2010:p0419:b001:l041","ordinal":19323,"en":"He sent those who would wreak it;"},{"id":"manas-2010:p0419:b001:l042","ordinal":19324,"en":"Simply binding whomever they looked upon,"},{"id":"manas-2010:p0419:b001:l043","ordinal":19325,"en":"He sent those who would seize them."},{"id":"manas-2010:p0419:b001:l044","ordinal":19326,"en":"Facing toward Manas,"},{"id":"manas-2010:p0419:b001:l045","ordinal":19327,"en":"All raised their spears."},{"id":"manas-2010:p0419:b001:l046","ordinal":19328,"en":"Now they unleashed fierce wrath;"},{"id":"manas-2010:p0419:b001:l047","ordinal":19329,"en":"Drawing bows to rain arrows,"},{"id":"manas-2010:p0419:b001:l048","ordinal":19330,"en":"They advanced in a sweeping charge!"},{"id":"manas-2010:p0420:b001:l001","ordinal":19331,"en":"Waving a banner mottled bay,"},{"id":"manas-2010:p0420:b001:l002","ordinal":19332,"en":"They had made themselves ready."},{"id":"manas-2010:p0420:b001:l003","ordinal":19333,"en":"The dense army launched its charge;"},{"id":"manas-2010:p0420:b001:l004","ordinal":19334,"en":"They had swept forward."},{"id":"manas-2010:p0420:b001:l005","ordinal":19335,"en":"Clubmen at the front,"},{"id":"manas-2010:p0420:b001:l006","ordinal":19336,"en":"Great champions on the flanks,"},{"id":"manas-2010:p0420:b001:l007","ordinal":19337,"en":"Swordsmen at the front—"},{"id":"manas-2010:p0420:b001:l008","ordinal":19338,"en":"Of the swarming unbelievers,"},{"id":"manas-2010:p0420:b001:l009","ordinal":19339,"en":"Of the heroes stronger than many,"},{"id":"manas-2010:p0420:b001:l010","ordinal":19340,"en":"The mightiest stood on the flanks."},{"id":"manas-2010:p0420:b001:l011","ordinal":19341,"en":"Readying their sharp swords and mail,"},{"id":"manas-2010:p0420:b001:l012","ordinal":19342,"en":"The unbelievers stood prepared,"},{"id":"manas-2010:p0420:b001:l013","ordinal":19343,"en":"Driving one another onward,"},{"id":"manas-2010:p0420:b001:l014","ordinal":19344,"en":"Dividing into wave after wave."},{"id":"manas-2010:p0420:b001:l015","ordinal":19345,"en":"Multitudes of troops appeared swarming;"},{"id":"manas-2010:p0420:b001:l016","ordinal":19346,"en":"Haze broke away from the sky."},{"id":"manas-2010:p0420:b001:l017","ordinal":19347,"en":"When their governors-general descended,"},{"id":"manas-2010:p0420:b001:l018","ordinal":19348,"en":"They seemed about to spare no soul."},{"id":"manas-2010:p0420:b001:l019","ordinal":19349,"en":"May God spare us the sight!"},{"id":"manas-2010:p0420:b001:l020","ordinal":19350,"en":"Spearheads struck one another,"},{"id":"manas-2010:p0420:b001:l021","ordinal":19351,"en":"Human heads knocked together."},{"id":"manas-2010:p0420:b001:l022","ordinal":19352,"en":"Leaders of ten wheeled about;"},{"id":"manas-2010:p0420:b001:l023","ordinal":19353,"en":"Leaders of fifty and a hundred"},{"id":"manas-2010:p0420:b001:l024","ordinal":19354,"en":"Ran from every side."},{"id":"manas-2010:p0420:b001:l025","ordinal":19355,"en":"All the leaders of a thousand,"},{"id":"manas-2010:p0420:b001:l026","ordinal":19356,"en":"Despairing of their precious lives,"},{"id":"manas-2010:p0420:b001:l027","ordinal":19357,"en":"Fell into a tumult;"},{"id":"manas-2010:p0420:b001:l028","ordinal":19358,"en":"The Chinese swept forward."},{"id":"manas-2010:p0420:b001:l029","ordinal":19359,"en":"If these Chinese were left alone,"},{"id":"manas-2010:p0420:b001:l030","ordinal":19360,"en":"Sparing not their own lives,"},{"id":"manas-2010:p0420:b001:l031","ordinal":19361,"en":"The Chinese would overwhelm them."},{"id":"manas-2010:p0420:b001:l032","ordinal":19362,"en":"If one watched their wrath,"},{"id":"manas-2010:p0420:b001:l033","ordinal":19363,"en":"They would bind Manas."},{"id":"manas-2010:p0420:b001:l034","ordinal":19364,"en":"Seizing him, into their pit"},{"id":"manas-2010:p0420:b001:l035","ordinal":19365,"en":"They intended to drag him."},{"id":"manas-2010:p0420:b001:l036","ordinal":19366,"en":"Into Esenkan's hands,"},{"id":"manas-2010:p0420:b001:l037","ordinal":19367,"en":"To give Manas bound,"},{"id":"manas-2010:p0420:b001:l038","ordinal":19368,"en":"All the Chinese massed together;"},{"id":"manas-2010:p0420:b001:l039","ordinal":19369,"en":"The unbelievers were prepared."},{"id":"manas-2010:p0420:b001:l040","ordinal":19370,"en":"Those who drew bows drew their bows;"},{"id":"manas-2010:p0420:b001:l041","ordinal":19371,"en":"They fell upon warrior Manas."},{"id":"manas-2010:p0420:b001:l042","ordinal":19372,"en":"May no living person see it!"},{"id":"manas-2010:p0420:b001:l043","ordinal":19373,"en":"Such oppression and hardship,"},{"id":"manas-2010:p0420:b001:l044","ordinal":19374,"en":"May He not give it to His mortal servant!"},{"id":"manas-2010:p0420:b001:l045","ordinal":19375,"en":"They had governors and they had khans."},{"id":"manas-2010:p0420:b001:l046","ordinal":19376,"en":"Upon Khan Manas, the dense army"},{"id":"manas-2010:p0420:b001:l047","ordinal":19377,"en":"Had swept with all its strength."},{"id":"manas-2010:p0420:b001:l048","ordinal":19378,"en":"When he saw them sweep upon him,"},{"id":"manas-2010:p0421:b001:l001","ordinal":19379,"en":"At the army's rear, Ezkara,"},{"id":"manas-2010:p0421:b001:l002","ordinal":19380,"en":"Once he had driven them with torment,"},{"id":"manas-2010:p0421:b001:l003","ordinal":19381,"en":"Their lords and their khans,"},{"id":"manas-2010:p0421:b001:l004","ordinal":19382,"en":"The men who led the army,"},{"id":"manas-2010:p0421:b001:l005","ordinal":19383,"en":"Urged one another onward,"},{"id":"manas-2010:p0421:b001:l006","ordinal":19384,"en":"Bloodthirsty wolf-man Manas's"},{"id":"manas-2010:p0421:b001:l007","ordinal":19385,"en":"Capture was their common wish."},{"id":"manas-2010:p0421:b001:l008","ordinal":19386,"en":"Ezkara and Zholoy said this"},{"id":"manas-2010:p0421:b001:l009","ordinal":19387,"en":"To the champions clad in ring-mail,"},{"id":"manas-2010:p0421:b001:l010","ordinal":19388,"en":"To their champions and warriors:"},{"id":"manas-2010:p0421:b001:l011","ordinal":19389,"en":"“Go and overwhelm him!"},{"id":"manas-2010:p0421:b001:l012","ordinal":19390,"en":"That daughter-damned Burut,"},{"id":"manas-2010:p0421:b001:l013","ordinal":19391,"en":"Do not let him go; bind him!"},{"id":"manas-2010:p0421:b001:l014","ordinal":19392,"en":"Heap humiliation on him like a sheep!"},{"id":"manas-2010:p0421:b001:l015","ordinal":19393,"en":"Let a thousand strike, not one;"},{"id":"manas-2010:p0421:b001:l016","ordinal":19394,"en":"Leave the weak aside; let the skilled strike."},{"id":"manas-2010:p0421:b001:l017","ordinal":19395,"en":"The wisest among the spearmen,"},{"id":"manas-2010:p0421:b001:l018","ordinal":19396,"en":"Let your merciless strong men strike!"},{"id":"manas-2010:p0421:b001:l019","ordinal":19397,"en":"Let your heroes strike, your khans strike!"},{"id":"manas-2010:p0421:b001:l020","ordinal":19398,"en":"Your mother's grave—upon that Burut,"},{"id":"manas-2010:p0421:b001:l021","ordinal":19399,"en":"Let every one of you strike!"},{"id":"manas-2010:p0421:b001:l022","ordinal":19400,"en":"Face him and thrust your spears;"},{"id":"manas-2010:p0421:b001:l023","ordinal":19401,"en":"Strike together with your swords."},{"id":"manas-2010:p0421:b001:l024","ordinal":19402,"en":"That foolish Burut Manas,"},{"id":"manas-2010:p0421:b001:l025","ordinal":19403,"en":"Bind him openly before us!"},{"id":"manas-2010:p0421:b001:l026","ordinal":19404,"en":"Yesterday, at the games in Orto-Beijing,"},{"id":"manas-2010:p0421:b001:l027","ordinal":19405,"en":"At Esenkan's feast,"},{"id":"manas-2010:p0421:b001:l028","ordinal":19406,"en":"You heard Esenkan's words."},{"id":"manas-2010:p0421:b001:l029","ordinal":19407,"en":"You with nets of iron rope,"},{"id":"manas-2010:p0421:b001:l030","ordinal":19408,"en":"You all armed with daggers,"},{"id":"manas-2010:p0421:b001:l031","ordinal":19409,"en":"You Torguts came forth, every one."},{"id":"manas-2010:p0421:b001:l032","ordinal":19410,"en":"His sport and his tumult—"},{"id":"manas-2010:p0421:b001:l033","ordinal":19411,"en":"You heard Esenkan's words!"},{"id":"manas-2010:p0421:b001:l034","ordinal":19412,"en":"The finest of the spearmen,"},{"id":"manas-2010:p0421:b001:l035","ordinal":19413,"en":"Your father's grave—upon that Burut,"},{"id":"manas-2010:p0421:b001:l036","ordinal":19414,"en":"Thrust your spears together!"},{"id":"manas-2010:p0421:b001:l037","ordinal":19415,"en":"Champions with maces and clubs,"},{"id":"manas-2010:p0421:b001:l038","ordinal":19416,"en":"Against that witless Burut champion,"},{"id":"manas-2010:p0421:b001:l039","ordinal":19417,"en":"Face him and strike your clubs."},{"id":"manas-2010:p0421:b001:l040","ordinal":19418,"en":"That bloodthirsty slayer of peoples,"},{"id":"manas-2010:p0421:b001:l041","ordinal":19419,"en":"That ill-intentioned deceiver,"},{"id":"manas-2010:p0421:b001:l042","ordinal":19420,"en":"Somehow find a way against him;"},{"id":"manas-2010:p0421:b001:l043","ordinal":19421,"en":"Devise it all together."},{"id":"manas-2010:p0421:b001:l044","ordinal":19422,"en":"You armed with maces and clubs,"},{"id":"manas-2010:p0421:b001:l045","ordinal":19423,"en":"Stand against him; do not flee!"},{"id":"manas-2010:p0421:b001:l046","ordinal":19424,"en":"Let your fools die;"},{"id":"manas-2010:p0421:b001:l047","ordinal":19425,"en":"You who remain after the dead—"},{"id":"manas-2010:p0421:b001:l048","ordinal":19426,"en":"That foolish Burut Manas,"},{"id":"manas-2010:p0422:b001:l001","ordinal":19427,"en":"Do not let him escape; give him bound!"},{"id":"manas-2010:p0422:b001:l002","ordinal":19428,"en":"If Manas should get away,"},{"id":"manas-2010:p0422:b001:l003","ordinal":19429,"en":"I shall make every trouble I know."},{"id":"manas-2010:p0422:b001:l004","ordinal":19430,"en":"Your father's grave, champions—"},{"id":"manas-2010:p0422:b001:l005","ordinal":19431,"en":"I shall slaughter every one of you!"},{"id":"manas-2010:p0422:b001:l006","ordinal":19432,"en":"I shall suck the strength from your mighty men;"},{"id":"manas-2010:p0422:b001:l007","ordinal":19433,"en":"I shall shatter your mighty men,"},{"id":"manas-2010:p0422:b001:l008","ordinal":19434,"en":"I shall slaughter you all."},{"id":"manas-2010:p0422:b001:l009","ordinal":19435,"en":"You are multitudes, he is alone;"},{"id":"manas-2010:p0422:b001:l010","ordinal":19436,"en":"Would it be right to let him escape?"},{"id":"manas-2010:p0422:b001:l011","ordinal":19437,"en":"That shambling wretch,"},{"id":"manas-2010:p0422:b001:l012","ordinal":19438,"en":"Can you let him get away?"},{"id":"manas-2010:p0422:b001:l013","ordinal":19439,"en":"Drive on, drive on, drive on!” they said."},{"id":"manas-2010:p0422:b001:l014","ordinal":19440,"en":"“Overwhelm and kill the Burut!” they said."},{"id":"manas-2010:p0422:b001:l015","ordinal":19441,"en":"“Slaughter his forty boys!” they said."},{"id":"manas-2010:p0422:b001:l016","ordinal":19442,"en":"“Make your sport like this!” they said."},{"id":"manas-2010:p0422:b001:l017","ordinal":19443,"en":"“Bring calamity upon his head!” they said."},{"id":"manas-2010:p0422:b001:l018","ordinal":19444,"en":"“Manas, whom your lord spoke of,"},{"id":"manas-2010:p0422:b001:l019","ordinal":19445,"en":"That bloodthirsty maker of war,"},{"id":"manas-2010:p0422:b001:l020","ordinal":19446,"en":"Kakanchyn's and Beijing's"},{"id":"manas-2010:p0422:b001:l021","ordinal":19447,"en":"Nest—that deceiver who would destroy it,"},{"id":"manas-2010:p0422:b001:l022","ordinal":19448,"en":"Heap humiliation on him like a sheep;"},{"id":"manas-2010:p0422:b001:l023","ordinal":19449,"en":"Do not let him go; bind him!"},{"id":"manas-2010:p0422:b001:l024","ordinal":19450,"en":"The words your Esenkan spoke—"},{"id":"manas-2010:p0422:b001:l025","ordinal":19451,"en":"Pouring wrath upon the bloodthirsty one,"},{"id":"manas-2010:p0422:b001:l026","ordinal":19452,"en":"Now find a way against him;"},{"id":"manas-2010:p0422:b001:l027","ordinal":19453,"en":"Devise some means!"},{"id":"manas-2010:p0422:b001:l028","ordinal":19454,"en":"From Kakanchyn, from Beijing,"},{"id":"manas-2010:p0422:b001:l029","ordinal":19455,"en":"‘Champions indeed, warriors indeed’—"},{"id":"manas-2010:p0422:b001:l030","ordinal":19456,"en":"We shall earn that name through this."}]
