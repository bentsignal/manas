[{"id":"seytek-2012:p0286:b003:l024","ordinal":317441,"en":"Our wondrous, spacious Talas"},{"id":"seytek-2012:p0286:b003:l025","ordinal":317442,"en":"Lay spread out wide,"},{"id":"seytek-2012:p0286:b003:l026","ordinal":317443,"en":"Its lofty mountains rising grandly."},{"id":"seytek-2012:p0286:b003:l027","ordinal":317444,"en":"Its springs surged and overflowed,"},{"id":"seytek-2012:p0286:b003:l028","ordinal":317445,"en":"Its nightingales sang and trilled,"},{"id":"seytek-2012:p0286:b003:l029","ordinal":317446,"en":"And sorrowing hearts melted into tears."},{"id":"seytek-2012:p0286:b003:l030","ordinal":317447,"en":"Its leaves are broad as hides,"},{"id":"seytek-2012:p0286:b003:l031","ordinal":317448,"en":"Its beetles large as thumbs,"},{"id":"seytek-2012:p0286:b003:l032","ordinal":317449,"en":"Its hogweed stalks thick as wrists;"},{"id":"seytek-2012:p0286:b003:l033","ordinal":317450,"en":"When its maral deer bolt away,"},{"id":"seytek-2012:p0286:b003:l034","ordinal":317451,"en":"They resemble pale-faced cows."},{"id":"seytek-2012:p0286:b003:l035","ordinal":317452,"en":"Its saplings are like plane trees,"},{"id":"seytek-2012:p0286:b003:l036","ordinal":317453,"en":"Its little birds like snowcocks,"},{"id":"seytek-2012:p0286:b003:l037","ordinal":317454,"en":"Its lizards like snakes."},{"id":"seytek-2012:p0286:b003:l038","ordinal":317455,"en":"Its wild asses are like three-year-old colts,"},{"id":"seytek-2012:p0286:b003:l039","ordinal":317456,"en":"And its gliding snakes"},{"id":"seytek-2012:p0286:b003:l040","ordinal":317457,"en":"Are like coiled ropes."},{"id":"seytek-2012:p0287:b002:l001","ordinal":317458,"en":"The people knew the worth of the land;"},{"id":"seytek-2012:p0287:b002:l002","ordinal":317459,"en":"Was it a place where anyone could remain idle?"},{"id":"seytek-2012:p0287:b002:l003","ordinal":317460,"en":"Was it a place where men would not compete"},{"id":"seytek-2012:p0287:b002:l004","ordinal":317461,"en":"In mass games of kökbörü,"},{"id":"seytek-2012:p0287:b002:l005","ordinal":317462,"en":"Where young men would not immerse themselves"},{"id":"seytek-2012:p0287:b002:l006","ordinal":317463,"en":"In every kind of pleasure,"},{"id":"seytek-2012:p0287:b002:l007","ordinal":317464,"en":"Roaming the hills and finding gold,"},{"id":"seytek-2012:p0287:b002:l008","ordinal":317465,"en":"Knotting their horses’ banner-like tails and racing them,"},{"id":"seytek-2012:p0287:b002:l009","ordinal":317466,"en":"The honored champion surging ahead,"},{"id":"seytek-2012:p0287:b002:l010","ordinal":317467,"en":"Taking up white steel and barring the road,"},{"id":"seytek-2012:p0287:b002:l011","ordinal":317468,"en":"Wearying horses while ranging the land,"},{"id":"seytek-2012:p0287:b002:l012","ordinal":317469,"en":"Setting loose hounds and flying hawks,"},{"id":"seytek-2012:p0287:b002:l013","ordinal":317470,"en":"And riding proudly prancing steeds?"},{"id":"seytek-2012:p0287:b002:l014","ordinal":317471,"en":"Could anyone fail to ride there?"},{"id":"seytek-2012:p0287:b002:l015","ordinal":317472,"en":"Girding their slender waists,"},{"id":"seytek-2012:p0287:b002:l016","ordinal":317473,"en":"Born as defenders of the Kyrgyz,"},{"id":"seytek-2012:p0287:b002:l017","ordinal":317474,"en":"Fastening belts around their trim waists,"},{"id":"seytek-2012:p0287:b002:l018","ordinal":317475,"en":"And attacking the enemy in battle—"},{"id":"seytek-2012:p0287:b002:l019","ordinal":317476,"en":"Could they fail to strike there?"},{"id":"seytek-2012:p0287:b002:l020","ordinal":317477,"en":"Drinking their fill of kumiss and courting girls,"},{"id":"seytek-2012:p0287:b002:l021","ordinal":317478,"en":"Men reveling amid delights—"},{"id":"seytek-2012:p0287:b002:l022","ordinal":317479,"en":"Could they fail to enjoy themselves there?"},{"id":"seytek-2012:p0287:b002:l023","ordinal":317480,"en":"With black hats like cauldrons,"},{"id":"seytek-2012:p0287:b002:l024","ordinal":317481,"en":"Raising the people’s fortress as their banner,"},{"id":"seytek-2012:p0287:b002:l025","ordinal":317482,"en":"Could they fail to sway in dance there?"},{"id":"seytek-2012:p0287:b002:l026","ordinal":317483,"en":"Laughing together in chorus,"},{"id":"seytek-2012:p0287:b002:l027","ordinal":317484,"en":"Could they fail to rejoice there?"},{"id":"seytek-2012:p0287:b002:l028","ordinal":317485,"en":"Our wondrous Talas"},{"id":"seytek-2012:p0287:b002:l029","ordinal":317486,"en":"Has hills and mountain passes,"},{"id":"seytek-2012:p0287:b002:l030","ordinal":317487,"en":"With countless kinds of grasses;"},{"id":"seytek-2012:p0287:b002:l031","ordinal":317488,"en":"It has most things people need."},{"id":"seytek-2012:p0287:b002:l032","ordinal":317489,"en":"Feather grass and other grasses grow,"},{"id":"seytek-2012:p0287:b002:l033","ordinal":317490,"en":"And from every mighty broad slope"},{"id":"seytek-2012:p0287:b002:l034","ordinal":317491,"en":"Springs pour forth like gold."},{"id":"seytek-2012:p0287:b002:l035","ordinal":317492,"en":"It is a land where men laugh with delight"},{"id":"seytek-2012:p0287:b002:l036","ordinal":317493,"en":"And young warriors may repose."},{"id":"seytek-2012:p0287:b002:l037","ordinal":317494,"en":"There livestock foal, bear young, and multiply;"},{"id":"seytek-2012:p0287:b002:l038","ordinal":317495,"en":"It is a land where people live in joy."},{"id":"seytek-2012:p0287:b002:l039","ordinal":317496,"en":"Our wondrous, spacious Talas"},{"id":"seytek-2012:p0287:b002:l040","ordinal":317497,"en":"Has forests and dense woodland,"},{"id":"seytek-2012:p0287:b003:l001","ordinal":317498,"en":"Appearing equal to paradise."},{"id":"seytek-2012:p0287:b003:l002","ordinal":317499,"en":"Snow blocks its mountain passes;"},{"id":"seytek-2012:p0287:b003:l003","ordinal":317500,"en":"Look carefully, and it possesses"},{"id":"seytek-2012:p0287:b003:l004","ordinal":317501,"en":"Every earthly delight mankind desires."},{"id":"seytek-2012:p0287:b003:l005","ordinal":317502,"en":"Fox-tail grass and woodruff,"},{"id":"seytek-2012:p0287:b003:l006","ordinal":317503,"en":"Blue wildflowers and white blossoms—"},{"id":"seytek-2012:p0287:b003:l007","ordinal":317504,"en":"Every kind of herb is there."},{"id":"seytek-2012:p0287:b003:l008","ordinal":317505,"en":"Anyone who sees it is fully satisfied,"},{"id":"seytek-2012:p0287:b003:l009","ordinal":317506,"en":"When beholding such a Talas."},{"id":"seytek-2012:p0287:b003:l010","ordinal":317507,"en":"It is as though a richly patterned carpet"},{"id":"seytek-2012:p0287:b003:l011","ordinal":317508,"en":"Had been spread across Talas."},{"id":"seytek-2012:p0287:b003:l012","ordinal":317509,"en":"Every beholder’s heart is content;"},{"id":"seytek-2012:p0287:b003:l013","ordinal":317510,"en":"Talas is wondrously beautiful."},{"id":"seytek-2012:p0287:b003:l014","ordinal":317511,"en":"It is a land where swift horses are stretched at the tether"},{"id":"seytek-2012:p0287:b003:l015","ordinal":317512,"en":"And kept tied there,"},{"id":"seytek-2012:p0287:b003:l016","ordinal":317513,"en":"A land of merriment by day and games by night,"},{"id":"seytek-2012:p0287:b003:l017","ordinal":317514,"en":"Where people spend the summer,"},{"id":"seytek-2012:p0287:b003:l018","ordinal":317515,"en":"Wearing paired sable hats"},{"id":"seytek-2012:p0287:b003:l019","ordinal":317516,"en":"And swaying in dance,"},{"id":"seytek-2012:p0287:b003:l020","ordinal":317517,"en":"Riding three-year-old colts and flying hawks,"},{"id":"seytek-2012:p0287:b003:l021","ordinal":317518,"en":"Living there in happiness."},{"id":"seytek-2012:p0287:b003:l022","ordinal":317519,"en":"When bored, they shoot roe deer,"},{"id":"seytek-2012:p0287:b003:l023","ordinal":317520,"en":"And play without weariness"},{"id":"seytek-2012:p0287:b003:l024","ordinal":317521,"en":"At countless delightful games,"},{"id":"seytek-2012:p0287:b003:l025","ordinal":317522,"en":"Taking keen, baying greyhounds"},{"id":"seytek-2012:p0287:b003:l026","ordinal":317523,"en":"And dark goshawks—"},{"id":"seytek-2012:p0287:b003:l027","ordinal":317524,"en":"Could they fail to hunt there?"},{"id":"seytek-2012:p0287:b003:l028","ordinal":317525,"en":"Could they fail to immerse themselves"},{"id":"seytek-2012:p0287:b003:l029","ordinal":317526,"en":"In rare games and pleasures?"},{"id":"seytek-2012:p0287:b003:l030","ordinal":317527,"en":"Could they ever have their fill"},{"id":"seytek-2012:p0287:b003:l031","ordinal":317528,"en":"Of its many entertainments and games?"},{"id":"seytek-2012:p0287:b003:l032","ordinal":317529,"en":"Would they not seek tracks on rugged ground"},{"id":"seytek-2012:p0287:b003:l033","ordinal":317530,"en":"And range across it?"},{"id":"seytek-2012:p0287:b003:l034","ordinal":317531,"en":"Could they fail to immerse themselves"},{"id":"seytek-2012:p0287:b003:l035","ordinal":317532,"en":"In rare games and pleasures?"},{"id":"seytek-2012:p0287:b003:l036","ordinal":317533,"en":"Competing for the true prize between them,"},{"id":"seytek-2012:p0287:b003:l037","ordinal":317534,"en":"Could they fail to shoot?"},{"id":"seytek-2012:p0287:b003:l038","ordinal":317535,"en":"Playing freely amid delights,"},{"id":"seytek-2012:p0287:b003:l039","ordinal":317536,"en":"Could they fail to revel?"},{"id":"seytek-2012:p0287:b003:l040","ordinal":317537,"en":"The people played freely, and all laughed,"},{"id":"seytek-2012:p0288:b002:l001","ordinal":317538,"en":"In Talas, the choicest of lands,"},{"id":"seytek-2012:p0288:b002:l002","ordinal":317539,"en":"All these delights abound."},{"id":"seytek-2012:p0288:b002:l003","ordinal":317540,"en":"When one looks upon a plane tree,"},{"id":"seytek-2012:p0288:b002:l004","ordinal":317541,"en":"Seeking out the creatures there,"},{"id":"seytek-2012:p0288:b002:l005","ordinal":317542,"en":"And examines one branch,"},{"id":"seytek-2012:p0288:b002:l006","ordinal":317543,"en":"A long-tailed shrike"},{"id":"seytek-2012:p0288:b002:l007","ordinal":317544,"en":"Appears upon one branch;"},{"id":"seytek-2012:p0288:b002:l008","ordinal":317545,"en":"Looking at another, one finds a hooded crow,"},{"id":"seytek-2012:p0288:b002:l009","ordinal":317546,"en":"And looking upon another—"},{"id":"seytek-2012:p0288:b002:l010","ordinal":317547,"en":"A ring-necked jackdaw."},{"id":"seytek-2012:p0288:b002:l011","ordinal":317548,"en":"When one looks at one branch,"},{"id":"seytek-2012:p0288:b002:l012","ordinal":317549,"en":"A great shaggy owl is perched there;"},{"id":"seytek-2012:p0288:b002:l013","ordinal":317550,"en":"Looking upon another,"},{"id":"seytek-2012:p0288:b002:l014","ordinal":317551,"en":"A compact sparrowhawk appears."},{"id":"seytek-2012:p0288:b002:l015","ordinal":317552,"en":"Upon a single plane tree"},{"id":"seytek-2012:p0288:b002:l016","ordinal":317553,"en":"Countless kinds of creatures have gathered."},{"id":"seytek-2012:p0288:b002:l017","ordinal":317554,"en":"Our wondrous, spacious Talas"},{"id":"seytek-2012:p0288:b002:l018","ordinal":317555,"en":"Is surely the richest of lands,"},{"id":"seytek-2012:p0288:b002:l019","ordinal":317556,"en":"And the Kyrgyz and the few Argyn who inhabit it"},{"id":"seytek-2012:p0288:b002:l020","ordinal":317557,"en":"Are surely the flower of all peoples."},{"id":"seytek-2012:p0288:b002:l021","ordinal":317558,"en":"Was it a land where the great Kyrgyz would not"},{"id":"seytek-2012:p0288:b002:l022","ordinal":317559,"en":"Camp for months on end,"},{"id":"seytek-2012:p0288:b002:l023","ordinal":317560,"en":"With revelry by day and games by night?"},{"id":"seytek-2012:p0288:b002:l024","ordinal":317561,"en":"Could such pleasures fail to flourish there?"},{"id":"seytek-2012:p0288:b002:l025","ordinal":317562,"en":"Wearing costly hats of blue lynx,"},{"id":"seytek-2012:p0288:b002:l026","ordinal":317563,"en":"Could they fail to sway in dance there?"},{"id":"seytek-2012:p0288:b002:l027","ordinal":317564,"en":"Playing many games together,"},{"id":"seytek-2012:p0288:b002:l028","ordinal":317565,"en":"Could they fail to rejoice there?"},{"id":"seytek-2012:p0288:b002:l029","ordinal":317566,"en":"“This is what life is for,”"},{"id":"seytek-2012:p0288:b002:l030","ordinal":317567,"en":"Could they fail to think there?"},{"id":"seytek-2012:p0288:b002:l031","ordinal":317568,"en":"With budlike mouths and camel-calf eyes,"},{"id":"seytek-2012:p0288:b002:l032","ordinal":317569,"en":"With teasing, alluring eyes,"},{"id":"seytek-2012:p0288:b002:l033","ordinal":317570,"en":"In crimson dresses, slender-waisted as the crescent moon—"},{"id":"seytek-2012:p0288:b002:l034","ordinal":317571,"en":"With such graceful beauties,"},{"id":"seytek-2012:p0288:b002:l035","ordinal":317572,"en":"Could men fail to lie there?"},{"id":"seytek-2012:p0288:b002:l036","ordinal":317573,"en":"Could they fail to lose themselves"},{"id":"seytek-2012:p0288:b002:l037","ordinal":317574,"en":"In splendid games and laughter?"},{"id":"seytek-2012:p0288:b002:l038","ordinal":317575,"en":"Upon the wide, level mountain plains,"},{"id":"seytek-2012:p0288:b002:l039","ordinal":317576,"en":"Could they fail to make camp?"},{"id":"seytek-2012:p0288:b002:l040","ordinal":317577,"en":"By day young wives, by night maidens—"},{"id":"seytek-2012:p0288:b003:l001","ordinal":317578,"en":"It has many a surging stronghold."},{"id":"seytek-2012:p0288:b003:l002","ordinal":317579,"en":"There is entertainment in abundance"},{"id":"seytek-2012:p0288:b003:l003","ordinal":317580,"en":"And every kind of pleasure."},{"id":"seytek-2012:p0288:b003:l004","ordinal":317581,"en":"It has oleaster, birch, and willow;"},{"id":"seytek-2012:p0288:b003:l005","ordinal":317582,"en":"Pines and birches reach toward the sky,"},{"id":"seytek-2012:p0288:b003:l006","ordinal":317583,"en":"And every kind of beauty is there."},{"id":"seytek-2012:p0288:b003:l007","ordinal":317584,"en":"Within those dense woods"},{"id":"seytek-2012:p0288:b003:l008","ordinal":317585,"en":"There are tawny lions,"},{"id":"seytek-2012:p0288:b003:l009","ordinal":317586,"en":"And striped-backed, ring-tailed"},{"id":"seytek-2012:p0288:b003:l010","ordinal":317587,"en":"Tigers as well."},{"id":"seytek-2012:p0288:b003:l011","ordinal":317588,"en":"Every creature endowed with life,"},{"id":"seytek-2012:p0288:b003:l012","ordinal":317589,"en":"Everything the ear has heard and the eye has seen,"},{"id":"seytek-2012:p0288:b003:l013","ordinal":317590,"en":"Everything people have spoken of, is there."},{"id":"seytek-2012:p0288:b003:l014","ordinal":317591,"en":"The world seethes, filled to overflowing;"},{"id":"seytek-2012:p0288:b003:l015","ordinal":317592,"en":"In our wondrous Talas"},{"id":"seytek-2012:p0288:b003:l016","ordinal":317593,"en":"All things have come into being in abundance."},{"id":"seytek-2012:p0288:b003:l017","ordinal":317594,"en":"Is it not the choicest of lands?"},{"id":"seytek-2012:p0288:b003:l018","ordinal":317595,"en":"Do not the Kyrgyz who dwell there prosper!"},{"id":"seytek-2012:p0288:b003:l019","ordinal":317596,"en":"Spacious Talas, our ancestral homeland—"},{"id":"seytek-2012:p0288:b003:l020","ordinal":317597,"en":"Was it not won by our forefathers!"},{"id":"seytek-2012:p0288:b003:l021","ordinal":317598,"en":"Ah, what a world this is—"},{"id":"seytek-2012:p0288:b003:l022","ordinal":317599,"en":"Would any man living here not prosper?"},{"id":"seytek-2012:p0288:b003:l023","ordinal":317600,"en":"Upon its terraced hills"},{"id":"seytek-2012:p0288:b003:l024","ordinal":317601,"en":"Wild goats and argali stand;"},{"id":"seytek-2012:p0288:b003:l025","ordinal":317602,"en":"Within its level forests"},{"id":"seytek-2012:p0288:b003:l026","ordinal":317603,"en":"Piglets and wild boars graze."},{"id":"seytek-2012:p0288:b003:l027","ordinal":317604,"en":"Every creature possessing life,"},{"id":"seytek-2012:p0288:b003:l028","ordinal":317605,"en":"In our wondrous Talas—"},{"id":"seytek-2012:p0288:b003:l029","ordinal":317606,"en":"Every living thing is there."},{"id":"seytek-2012:p0288:b003:l030","ordinal":317607,"en":"When you look toward the mountains,"},{"id":"seytek-2012:p0288:b003:l031","ordinal":317608,"en":"There is snow that never departs;"},{"id":"seytek-2012:p0288:b003:l032","ordinal":317609,"en":"When