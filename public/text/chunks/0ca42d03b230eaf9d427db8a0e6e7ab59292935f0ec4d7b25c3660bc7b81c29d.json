[{"id":"seytek-2012:p0214:b003:l040","ordinal":310529,"en":"From the infidel who ravaged the people,"},{"id":"seytek-2012:p0215:b002:l001","ordinal":310530,"en":"The earth itself shook and turned."},{"id":"seytek-2012:p0215:b002:l002","ordinal":310531,"en":"Bölökbay, the consummate craftsman,"},{"id":"seytek-2012:p0215:b002:l003","ordinal":310532,"en":"Who had befriended the prophet David,"},{"id":"seytek-2012:p0215:b002:l004","ordinal":310533,"en":"Took up a file and worked the iron."},{"id":"seytek-2012:p0215:b002:l005","ordinal":310534,"en":"Over a treasure beyond comprehension,"},{"id":"seytek-2012:p0215:b002:l006","ordinal":310535,"en":"He and David took counsel."},{"id":"seytek-2012:p0215:b002:l007","ordinal":310536,"en":"He fashioned the battle-axe,"},{"id":"seytek-2012:p0215:b002:l008","ordinal":310537,"en":"Perfecting every curve;"},{"id":"seytek-2012:p0215:b002:l009","ordinal":310538,"en":"Its socket was steel and its edge was sharp."},{"id":"seytek-2012:p0215:b002:l010","ordinal":310539,"en":"So that it would never recoil from the foe,"},{"id":"seytek-2012:p0215:b002:l011","ordinal":310540,"en":"He laid steel along its blade,"},{"id":"seytek-2012:p0215:b002:l012","ordinal":310541,"en":"And David bent and tempered it to perfection."},{"id":"seytek-2012:p0215:b002:l013","ordinal":310542,"en":"“So Choro may be its master,”"},{"id":"seytek-2012:p0215:b002:l014","ordinal":310543,"en":"He had a holy elder bless it."},{"id":"seytek-2012:p0215:b002:l015","ordinal":310544,"en":"While he was making it,"},{"id":"seytek-2012:p0215:b002:l016","ordinal":310545,"en":"The strain upon his forge was so great"},{"id":"seytek-2012:p0215:b002:l017","ordinal":310546,"en":"That tribute fell upon the Kyrgyz,"},{"id":"seytek-2012:p0215:b002:l018","ordinal":310547,"en":"And many young bulls were slaughtered."},{"id":"seytek-2012:p0215:b002:l019","ordinal":310548,"en":"The strain upon his forge was so great"},{"id":"seytek-2012:p0215:b002:l020","ordinal":310549,"en":"That a blue bend of forest was felled."},{"id":"seytek-2012:p0215:b002:l021","ordinal":310550,"en":"He hammered out its keen edge,"},{"id":"seytek-2012:p0215:b002:l022","ordinal":310551,"en":"So whatever it struck would not survive,"},{"id":"seytek-2012:p0215:b002:l023","ordinal":310552,"en":"But die doubled over,"},{"id":"seytek-2012:p0215:b002:l024","ordinal":310553,"en":"Its appointed doom fully met,"},{"id":"seytek-2012:p0215:b002:l025","ordinal":310554,"en":"Yellowing for want of any cure,"},{"id":"seytek-2012:p0215:b002:l026","ordinal":310555,"en":"And swiftly departing this world;"},{"id":"seytek-2012:p0215:b002:l027","ordinal":310556,"en":"He quenched it in human tears."},{"id":"seytek-2012:p0215:b002:l028","ordinal":310557,"en":"He made every piece of equipment ready"},{"id":"seytek-2012:p0215:b002:l029","ordinal":310558,"en":"And buckled on his battle-axe."},{"id":"seytek-2012:p0215:b002:l030","ordinal":310559,"en":"Fate’s line had now been drawn:"},{"id":"seytek-2012:p0215:b002:l031","ordinal":310560,"en":"Brave Kyyaz was destined to meet"},{"id":"seytek-2012:p0215:b002:l032","ordinal":310561,"en":"Fortunate brave Choro."},{"id":"seytek-2012:p0215:b002:l033","ordinal":310562,"en":"At a spur of the shouldered mountain,"},{"id":"seytek-2012:p0215:b002:l034","ordinal":310563,"en":"At the tip of the Sekichek ridge,"},{"id":"seytek-2012:p0215:b002:l035","ordinal":310564,"en":"His strength and courage"},{"id":"seytek-2012:p0215:b002:l036","ordinal":310565,"en":"Had now surpassed all others."},{"id":"seytek-2012:p0215:b002:l037","ordinal":310566,"en":"He had lain in wait for brave Kyyaz"},{"id":"seytek-2012:p0215:b002:l038","ordinal":310567,"en":"Of the Jediger, saying,"},{"id":"seytek-2012:p0215:b002:l039","ordinal":310568,"en":"“This is the path a hero must take.”"},{"id":"seytek-2012:p0215:b002:l040","ordinal":310569,"en":"He would fight and test his strength,"},{"id":"seytek-2012:p0215:b003:l001","ordinal":310570,"en":"His fame reaching distant Alay,"},{"id":"seytek-2012:p0215:b003:l002","ordinal":310571,"en":"His name known throughout many lands."},{"id":"seytek-2012:p0215:b003:l003","ordinal":310572,"en":"Great and wise fierce hero,"},{"id":"seytek-2012:p0215:b003:l004","ordinal":310573,"en":"Your battle cry stirred an uproar;"},{"id":"seytek-2012:p0215:b003:l005","ordinal":310574,"en":"Your courage and lionheartedness"},{"id":"seytek-2012:p0215:b003:l006","ordinal":310575,"en":"Surpassed those of all other mortals."},{"id":"seytek-2012:p0215:b003:l007","ordinal":310576,"en":"To bar valiant Kyyaz’s road,"},{"id":"seytek-2012:p0215:b003:l008","ordinal":310577,"en":"He summoned all his courage,"},{"id":"seytek-2012:p0215:b003:l009","ordinal":310578,"en":"Ready to die if death arrived,"},{"id":"seytek-2012:p0215:b003:l010","ordinal":310579,"en":"And, if fortune allowed, to make"},{"id":"seytek-2012:p0215:b003:l011","ordinal":310580,"en":"A spectacle of Kyyaz."},{"id":"seytek-2012:p0215:b003:l012","ordinal":310581,"en":"His threadlike life turned to ash,"},{"id":"seytek-2012:p0215:b003:l013","ordinal":310582,"en":"His mind surged into frenzy;"},{"id":"seytek-2012:p0215:b003:l014","ordinal":310583,"en":"He gave no thought to dying"},{"id":"seytek-2012:p0215:b003:l015","ordinal":310584,"en":"And did not spare his life from death."},{"id":"seytek-2012:p0215:b003:l016","ordinal":310585,"en":"Lion Choro, guarded by the spirits,"},{"id":"seytek-2012:p0215:b003:l017","ordinal":310586,"en":"Embarked upon a terrible feat of courage."},{"id":"seytek-2012:p0215:b003:l018","ordinal":310587,"en":"His precious, sweet life"},{"id":"seytek-2012:p0215:b003:l019","ordinal":310588,"en":"He bound to a hair and cast away."},{"id":"seytek-2012:p0215:b003:l020","ordinal":310589,"en":"The golden-cheeked battle-axe—"},{"id":"seytek-2012:p0215:b003:l021","ordinal":310590,"en":"Such was the nature of that axe:"},{"id":"seytek-2012:p0215:b003:l022","ordinal":310591,"en":"Its span-long blade gaped broad,"},{"id":"seytek-2012:p0215:b003:l023","ordinal":310592,"en":"Spreading blood wherever it struck;"},{"id":"seytek-2012:p0215:b003:l024","ordinal":310593,"en":"Its crown was like a mace-sized fist—"},{"id":"seytek-2012:p0215:b003:l025","ordinal":310594,"en":"Such was the nature of that weapon."},{"id":"seytek-2012:p0215:b003:l026","ordinal":310595,"en":"If you ask about the battle-axe,"},{"id":"seytek-2012:p0215:b003:l027","ordinal":310596,"en":"It would not rebound even from stone;"},{"id":"seytek-2012:p0215:b003:l028","ordinal":310597,"en":"If it struck iron in fury,"},{"id":"seytek-2012:p0215:b003:l029","ordinal":310598,"en":"It would not spin back."},{"id":"seytek-2012:p0215:b003:l030","ordinal":310599,"en":"When swung straight at the foe,"},{"id":"seytek-2012:p0215:b003:l031","ordinal":310600,"en":"Its blade flamed red with fire."},{"id":"seytek-2012:p0215:b003:l032","ordinal":310601,"en":"When its handle was grasped and swung,"},{"id":"seytek-2012:p0215:b003:l033","ordinal":310602,"en":"Its shaft lengthened forty fathoms."},{"id":"seytek-2012:p0215:b003:l034","ordinal":310603,"en":"Set upon grass, it started a fire;"},{"id":"seytek-2012:p0215:b003:l035","ordinal":310604,"en":"Whatever it struck died instantly."},{"id":"seytek-2012:p0215:b003:l036","ordinal":310605,"en":"When it struck stone, sparks flew,"},{"id":"seytek-2012:p0215:b003:l037","ordinal":310606,"en":"And fragments burst like bullets;"},{"id":"seytek-2012:p0215:b003:l038","ordinal":310607,"en":"It crushed whatever it bit into."},{"id":"seytek-2012:p0215:b003:l039","ordinal":310608,"en":"The lame smith Bölökbay"},{"id":"seytek-2012:p0215:b003:l040","ordinal":310609,"en":"And great master David had forged it."},{"id":"seytek-2012:p0216:b002:l001","ordinal":310610,"en":"Will he slaughter every living soul?"},{"id":"seytek-2012:p0216:b002:l002","ordinal":310611,"en":"Will he seize and devour my child?"},{"id":"seytek-2012:p0216:b002:l003","ordinal":310612,"en":"Will this wretched Kyyaz"},{"id":"seytek-2012:p0216:b002:l004","ordinal":310613,"en":"Spare not a single soul,"},{"id":"seytek-2012:p0216:b002:l005","ordinal":310614,"en":"But carry out a massacre?"},{"id":"seytek-2012:p0216:b002:l006","ordinal":310615,"en":"Do not grant death to my household,"},{"id":"seytek-2012:p0216:b002:l007","ordinal":310616,"en":"Do not make my sorrow boil."},{"id":"seytek-2012:p0216:b002:l008","ordinal":310617,"en":"Do not turn my words into lament,"},{"id":"seytek-2012:p0216:b002:l009","ordinal":310618,"en":"Do not leave me bereft,"},{"id":"seytek-2012:p0216:b002:l010","ordinal":310619,"en":"Do not break my back.”"},{"id":"seytek-2012:p0216:b002:l011","ordinal":310620,"en":"Thus spoke Aichürök;"},{"id":"seytek-2012:p0216:b002:l012","ordinal":310621,"en":"Her troubled heart would not be still,"},{"id":"seytek-2012:p0216:b002:l013","ordinal":310622,"en":"And tears poured from her eyes."},{"id":"seytek-2012:p0216:b002:l014","ordinal":310623,"en":"From those dear blackcurrant eyes,"},{"id":"seytek-2012:p0216:b002:l015","ordinal":310624,"en":"Tears streamed a whip’s length;"},{"id":"seytek-2012:p0216:b002:l016","ordinal":310625,"en":"From those large black eyes,"},{"id":"seytek-2012:p0216:b002:l017","ordinal":310626,"en":"Separate streams of tears flowed."},{"id":"seytek-2012:p0216:b002:l018","ordinal":310627,"en":"A dreadful deed came into her mind,"},{"id":"seytek-2012:p0216:b002:l019","ordinal":310628,"en":"A dire and calamitous deed to contemplate."},{"id":"seytek-2012:p0216:b002:l020","ordinal":310629,"en":"Her black hair, thick as meadow grass,"},{"id":"seytek-2012:p0216:b002:l021","ordinal":310630,"en":"Spilled across her breast,"},{"id":"seytek-2012:p0216:b002:l022","ordinal":310631,"en":"While twelve afflictions and a thousand cares"},{"id":"seytek-2012:p0216:b002:l023","ordinal":310632,"en":"Loomed close above her head."},{"id":"seytek-2012:p0216:b002:l024","ordinal":310633,"en":"Her mind reeled in bewilderment,"},{"id":"seytek-2012:p0216:b002:l025","ordinal":310634,"en":"As every calamity seemed to gather upon her."},{"id":"seytek-2012:p0216:b002:l026","ordinal":310635,"en":"“O holy one, set this right,” she said,"},{"id":"seytek-2012:p0216:b002:l027","ordinal":310636,"en":"“Set it right upon this very road."},{"id":"seytek-2012:p0216:b002:l028","ordinal":310637,"en":"My lionhearted father, gone to the other world,"},{"id":"seytek-2012:p0216:b002:l029","ordinal":310638,"en":"Support me with your spirit!”"},{"id":"seytek-2012:p0216:b002:l030","ordinal":310639,"en":"She put on her white headscarf,"},{"id":"seytek-2012:p0216:b002:l031","ordinal":310640,"en":"And the poor woman, unable to endure,"},{"id":"seytek-2012:p0216:b002:l032","ordinal":310641,"en":"Prayed to the true God,"},{"id":"seytek-2012:p0216:b002:l033","ordinal":310642,"en":"Wailing and weeping in anguish."},{"id":"seytek-2012:p0216:b002:l034","ordinal":310643,"en":"He was a valiant lion,"},{"id":"seytek-2012:p0216:b002:l035","ordinal":310644,"en":"And through his fathers and forefathers"},{"id":"seytek-2012:p0216:b002:l036","ordinal":310645,"en":"He descended from surpassing gray wolves."},{"id":"seytek-2012:p0216:b002:l037","ordinal":310646,"en":"God, preserve the boy;"},{"id":"seytek-2012:p0216:b002:l038","ordinal":310647,"en":"He himself is a panther, a gray wolf, a lion."},{"id":"seytek-2012:p0216:b002:l039","ordinal":310648,"en":"My illustrious Külchoro,"},{"id":"seytek-2012:p0216:b002:l040","ordinal":310649,"en":"Press on and wage your battle."},{"id":"seytek-2012:p0216:b003:l001","ordinal":310650,"en":"The foe with whom he must clash"},{"id":"seytek-2012:p0216:b003:l002","ordinal":310651,"en":"And fight until death"},{"id":"seytek-2012:p0216:b003:l003","ordinal":310652,"en":"Is the hated Khan Kyyaz."},{"id":"seytek-2012:p0216:b003:l004","ordinal":310653,"en":"To test himself in combat,"},{"id":"seytek-2012:p0216:b003:l005","ordinal":310654,"en":"Your warrior lies waiting on the road."},{"id":"seytek-2012:p0216:b003:l006","ordinal":310655,"en":"While the hero waited thus,"},{"id":"seytek-2012:p0216:b003:l007","ordinal":310656,"en":"Aichürök cried out in anguish"},{"id":"seytek-2012:p0216:b003:l008","ordinal":310657,"en":"For her long-suffering brother-in-law:"},{"id":"seytek-2012:p0216:b003:l009","ordinal":310658,"en":"“If the moon is veiled in darkness,"},{"id":"seytek-2012:p0216:b003:l010","ordinal":310659,"en":"What will become of his night?"},{"id":"seytek-2012:p0216:b003:l011","ordinal":310660,"en":"If fierce Kyyaz attacks"},{"id":"seytek-2012:p0216:b003:l012","ordinal":310661,"en":"My dear gray wolf Choro,"},{"id":"seytek-2012:p0216:b003:l013","ordinal":310662,"en":"What will become of his day?"},{"id":"seytek-2012:p0216:b003:l014","ordinal":310663,"en":"My brave brother-in-law was captured,"},{"id":"seytek-2012:p0216:b003:l015","ordinal":310664,"en":"Until only a spoonful of blood remained,"},{"id":"seytek-2012:p0216:b003:l016","ordinal":310665,"en":"His flesh bruised raw and blue."},{"id":"seytek-2012:p0216:b003:l017","ordinal":310666,"en":"He has neither strength nor power—"},{"id":"seytek-2012:p0216:b003:l018","ordinal":310667,"en":"What will become of him?"},{"id":"seytek-2012:p0216:b003:l019","ordinal":310668,"en":"If God unleashes calamity"},{"id":"seytek-2012:p0216:b003:l020","ordinal":310669,"en":"And Kyyaz suddenly"},{"id":"seytek-2012:p0216:b003:l021","ordinal":310670,"en":"Butchers Choro,"},{"id":"seytek-2012:p0216:b003:l022","ordinal":310671,"en":"Kyyaz will be filled with savage fury,"},{"id":"seytek-2012:p0216:b003:l023","ordinal":310672,"en":"And a day of terrible disaster will come."},{"id":"seytek-2012:p0216:b003:l024","ordinal":310673,"en":"Brave Kyyaz of the Jediger"},{"id":"seytek-2012:p0216:b003:l025","ordinal":310674,"en":"Will spare no life that seeks refuge;"},{"id":"seytek-2012:p0216:b003:l026","ordinal":310675,"en":"Though they beg, he will not leave a spoonful of blood."},{"id":"seytek-2012:p0216:b003:l027","ordinal":310676,"en":"He will destroy them root and branch,"},{"id":"seytek-2012:p0216:b003:l028","ordinal":310677,"en":"And pass on after slaughtering them all."},{"id":"seytek-2012:p0216:b003:l029","ordinal":310678,"en":"He will gouge out living eyes,"},{"id":"seytek-2012:p0216:b003:l030","ordinal":310679,"en":"Leave not one soul alive,"},{"id":"seytek-2012:p0216:b003:l031","ordinal":310680,"en":"And devour every living being."},{"id":"seytek-2012:p0216:b003:l032","ordinal":310681,"en":"Without the slightest pity for these souls,"},{"id":"seytek-2012:p0216:b003:l033","ordinal":310682,"en":"He will carry out a massacre.”"},{"id":"seytek-2012:p0216:b003:l034","ordinal":310683,"en":"Aichürök wailed and wept,"},{"id":"seytek-2012:p0216:b003:l035","ordinal":310684,"en":"Her heart pierced and divided by grief."},{"id":"seytek-2012:p0216:b003:l036","ordinal":310685,"en":"She prayed for Choro,"},{"id":"seytek-2012:p0216:b003:l037","ordinal":310686,"en":"And tears poured from her eyes."},{"id":"seytek-2012:p0216:b003:l038","ordinal":310687,"en":"Her heart was torn again and again:"},{"id":"seytek-2012:p0216:b003:l039","ordinal":310688,"en":"“If Choro should suddenly be slain,"},{"id":"seytek-2012:p0216:b003:l040","ordinal":310689,"en":"Will God strike us once more?”"},{"id":"seytek-2012:p0217:b002:l001","ordinal":310690,"en":"Many Kyrgyz people are sad"},{"id":"seytek-2012:p0217:b002:l002","ordinal":310691,"en":"From the hand of wrath"},{"id":"seytek-2012:p0217:b002:l003","ordinal":310692,"en":"Take it apart"},{"id":"seytek-2012:p0217:b002:l004","ordinal":310693,"en":"God bless you,"},{"id":"seytek-2012:p0217:b002:l005","ordinal":310694,"en":"God bless you."},{"id":"seytek-2012:p0217:b002:l006","ordinal":310695,"en":"A well-travelled brook,"},{"id":"seytek-2012:p0217:b002:l007","ordinal":310696,"en":"He went on a trip."},{"id":"seytek-2012:p0217:b002:l008","ordinal":310697,"en":"Shame on you if you take it away,"},{"id":"seytek-2012:p0217:b002:l009","ordinal":310698,"en":"Kulchoro is gone"},{"id":"seytek-2012:p0217:b002:l010","ordinal":310699,"en":"A trust for yourself."},{"id":"seytek-2012:p0217:b002:l011","ordinal":