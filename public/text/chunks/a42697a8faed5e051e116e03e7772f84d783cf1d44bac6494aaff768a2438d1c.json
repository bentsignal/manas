[{"id":"manas-2010:p0053:b002:l023","ordinal":1793,"en":"They crossed together now."},{"id":"manas-2010:p0053:b002:l024","ordinal":1794,"en":"Üch-Aral at the head of the Ile,"},{"id":"manas-2010:p0053:b002:l025","ordinal":1795,"en":"They had no choice but to ford it now."},{"id":"manas-2010:p0053:b002:l026","ordinal":1796,"en":"Ögüz-Ashuu, Tay-Ashuu,"},{"id":"manas-2010:p0053:b002:l027","ordinal":1797,"en":"Kichi-Jyldyz, Chong-Jyldyz,"},{"id":"manas-2010:p0053:b002:l028","ordinal":1798,"en":"They traversed them all now."},{"id":"manas-2010:p0053:b002:l029","ordinal":1799,"en":"Beyond lay Ak-Talaa;"},{"id":"manas-2010:p0053:b002:l030","ordinal":1800,"en":"They reached Ak-Talaa now."},{"id":"manas-2010:p0053:b002:l031","ordinal":1801,"en":"Ah, dear Ak-Talaa,"},{"id":"manas-2010:p0053:b002:l032","ordinal":1802,"en":"No land their forefathers had trodden!"},{"id":"manas-2010:p0053:b002:l033","ordinal":1803,"en":"Its people were Torgut, many Kalmyks,"},{"id":"manas-2010:p0053:b002:l034","ordinal":1804,"en":"A people seven forefathers had never seen."},{"id":"manas-2010:p0053:b002:l035","ordinal":1805,"en":"They reached Ak-Talaa and camped;"},{"id":"manas-2010:p0053:b002:l036","ordinal":1806,"en":"That day they stayed the night in Ak-Talaa."},{"id":"manas-2010:p0053:b002:l037","ordinal":1807,"en":"When the dawn broke clear,"},{"id":"manas-2010:p0053:b002:l038","ordinal":1808,"en":"When light reached and touched the earth,"},{"id":"manas-2010:p0053:b002:l039","ordinal":1809,"en":"When the true dawn broke,"},{"id":"manas-2010:p0053:b002:l040","ordinal":1810,"en":"When the dawn swelled forth,"},{"id":"manas-2010:p0053:b002:l041","ordinal":1811,"en":"Stars trembled overhead,"},{"id":"manas-2010:p0053:b002:l042","ordinal":1812,"en":"One by one turning toward the qibla;"},{"id":"manas-2010:p0053:b002:l043","ordinal":1813,"en":"Stars parted from the sky,"},{"id":"manas-2010:p0053:b002:l044","ordinal":1814,"en":"Dimmed and veiled in haze."},{"id":"manas-2010:p0053:b002:l045","ordinal":1815,"en":"The glow of dawn appeared,"},{"id":"manas-2010:p0053:b002:l046","ordinal":1816,"en":"Dawn's cold wind whistled,"},{"id":"manas-2010:p0053:b002:l047","ordinal":1817,"en":"The reed tops rustled sharply,"},{"id":"manas-2010:p0053:b002:l048","ordinal":1818,"en":"Young larks twittered,"},{"id":"manas-2010:p0054:b002:l001","ordinal":1819,"en":"The surface of its sand was scored,"},{"id":"manas-2010:p0054:b002:l002","ordinal":1820,"en":"The tops of its willows bent;"},{"id":"manas-2010:p0054:b002:l003","ordinal":1821,"en":"Thus lay Ak-Talaa."},{"id":"manas-2010:p0054:b002:l004","ordinal":1822,"en":"It was a land of rolling ridges,"},{"id":"manas-2010:p0054:b002:l005","ordinal":1823,"en":"An exceedingly beautiful place."},{"id":"manas-2010:p0054:b002:l006","ordinal":1824,"en":"It had pools and ponds and marshes,"},{"id":"manas-2010:p0054:b002:l007","ordinal":1825,"en":"Ducks and geese in separate flocks."},{"id":"manas-2010:p0054:b002:l008","ordinal":1826,"en":"Its apples ripened and fell to mulch,"},{"id":"manas-2010:p0054:b002:l009","ordinal":1827,"en":"Its ripe walnuts filled the ravines,"},{"id":"manas-2010:p0054:b002:l010","ordinal":1828,"en":"Its poppies swayed,"},{"id":"manas-2010:p0054:b002:l011","ordinal":1829,"en":"Its sorrel and wild rhubarb"},{"id":"manas-2010:p0054:b002:l012","ordinal":1830,"en":"All ripened and swayed luxuriantly:"},{"id":"manas-2010:p0054:b002:l013","ordinal":1831,"en":"Thus lay Ak-Talaa."},{"id":"manas-2010:p0054:b002:l014","ordinal":1832,"en":"In its midst were gushing spring waters;"},{"id":"manas-2010:p0054:b002:l015","ordinal":1833,"en":"Its wormwood glistened,"},{"id":"manas-2010:p0054:b002:l016","ordinal":1834,"en":"Its season was full of delight."},{"id":"manas-2010:p0054:b002:l017","ordinal":1835,"en":"Its river valley lay along the water;"},{"id":"manas-2010:p0054:b002:l018","ordinal":1836,"en":"No human foot had come to this place,"},{"id":"manas-2010:p0054:b002:l019","ordinal":1837,"en":"Its lands lay open and free."},{"id":"manas-2010:p0054:b002:l020","ordinal":1838,"en":"Its shoots were like plane trees,"},{"id":"manas-2010:p0054:b002:l021","ordinal":1839,"en":"Its plane trees like towers;"},{"id":"manas-2010:p0054:b002:l022","ordinal":1840,"en":"If you looked at its little birds,"},{"id":"manas-2010:p0054:b002:l023","ordinal":1841,"en":"They were like snowcocks crying in the mountains."},{"id":"manas-2010:p0054:b002:l024","ordinal":1842,"en":"Its lizards were like snakes;"},{"id":"manas-2010:p0054:b002:l025","ordinal":1843,"en":"If you looked at its snakes,"},{"id":"manas-2010:p0054:b002:l026","ordinal":1844,"en":"They were like ropes nine armspans long."},{"id":"manas-2010:p0054:b002:l027","ordinal":1845,"en":"Almighty God Most High"},{"id":"manas-2010:p0054:b002:l028","ordinal":1846,"en":"Had created living things of every kind;"},{"id":"manas-2010:p0054:b002:l029","ordinal":1847,"en":"Such was the land of Ak-Talaa."},{"id":"manas-2010:p0054:b002:l030","ordinal":1848,"en":"Its plain lay open and free."},{"id":"manas-2010:p0054:b002:l031","ordinal":1849,"en":"There was a creature called börsö;"},{"id":"manas-2010:p0054:b002:l032","ordinal":1850,"en":"From its belly, wobbling out,"},{"id":"manas-2010:p0054:b002:l033","ordinal":1851,"en":"Its young would emerge."},{"id":"manas-2010:p0054:b002:l034","ordinal":1852,"en":"Animals of every kind,"},{"id":"manas-2010:p0054:b002:l035","ordinal":1853,"en":"Every creature no human had seen was there."},{"id":"manas-2010:p0054:b002:l036","ordinal":1854,"en":"Wild human creatures and wild camels"},{"id":"manas-2010:p0054:b002:l037","ordinal":1855,"en":"Were there upon its hills."},{"id":"manas-2010:p0054:b002:l038","ordinal":1856,"en":"It was a land lying open and free;"},{"id":"manas-2010:p0054:b002:l039","ordinal":1857,"en":"Its far end, they called Altay."},{"id":"manas-2010:p0054:b002:l040","ordinal":1858,"en":"Inhabiting that Altay,"},{"id":"manas-2010:p0054:b002:l041","ordinal":1859,"en":"The Black Kalmyk and Manchu peoples"},{"id":"manas-2010:p0054:b002:l042","ordinal":1860,"en":"Were a teeming multitude."},{"id":"manas-2010:p0054:b002:l043","ordinal":1861,"en":"With Baltay and Jakyp at their head,"},{"id":"manas-2010:p0054:b002:l044","ordinal":1862,"en":"Their hands bound in hardship,"},{"id":"manas-2010:p0054:b002:l045","ordinal":1863,"en":"Forty households out of the Kyrgyz"},{"id":"manas-2010:p0054:b002:l046","ordinal":1864,"en":"Were driven away to Altay."},{"id":"manas-2010:p0054:b002:l047","ordinal":1865,"en":"The wretched ones driven there"},{"id":"manas-2010:p0054:b002:l048","ordinal":1866,"en":"Found the excellent land of Altay,"},{"id":"manas-2010:p0055:b002:l001","ordinal":1867,"en":"Found the Black Kalmyk people."},{"id":"manas-2010:p0055:b002:l002","ordinal":1868,"en":"They wandered away from the Kyrgyz and were lost;"},{"id":"manas-2010:p0055:b002:l003","ordinal":1869,"en":"All the many mourned,"},{"id":"manas-2010:p0055:b002:l004","ordinal":1870,"en":"Parted from their people in suffering."},{"id":"manas-2010:p0055:b002:l005","ordinal":1871,"en":"They were called Black Kalmyks;"},{"id":"manas-2010:p0055:b002:l006","ordinal":1872,"en":"They were a worthy, admirable people,"},{"id":"manas-2010:p0055:b002:l007","ordinal":1873,"en":"Dwelling in broad Altay,"},{"id":"manas-2010:p0055:b002:l008","ordinal":1874,"en":"Before their doorways"},{"id":"manas-2010:p0055:b002:l009","ordinal":1875,"en":"Tethering barren mares by the thousand."},{"id":"manas-2010:p0055:b002:l010","ordinal":1876,"en":"Beyond were Torgut and many Kalmyks;"},{"id":"manas-2010:p0055:b002:l011","ordinal":1877,"en":"They had horses grown old without a bullet striking them,"},{"id":"manas-2010:p0055:b002:l012","ordinal":1878,"en":"Horses frisking freely."},{"id":"manas-2010:p0055:b002:l013","ordinal":1879,"en":"Vast herds of all four kinds of livestock"},{"id":"manas-2010:p0055:b002:l014","ordinal":1880,"en":"Your mighty Kalmyks kept."},{"id":"manas-2010:p0055:b002:l015","ordinal":1881,"en":"The forty households driven there,"},{"id":"manas-2010:p0055:b002:l016","ordinal":1882,"en":"With Jakyp and Akbaltay at their head,"},{"id":"manas-2010:p0055:b002:l017","ordinal":1883,"en":"Forty Kyrgyz households, the wretched people,"},{"id":"manas-2010:p0055:b002:l018","ordinal":1884,"en":"Hired themselves as milkers and drank milk;"},{"id":"manas-2010:p0055:b002:l019","ordinal":1885,"en":"Thus they sustained their lives now."},{"id":"manas-2010:p0055:b002:l020","ordinal":1886,"en":"They grazed horses and rode working mounts;"},{"id":"manas-2010:p0055:b002:l021","ordinal":1887,"en":"That way they sustained their lives now."},{"id":"manas-2010:p0055:b002:l022","ordinal":1888,"en":"From the Black Kalmyks and Manchus,"},{"id":"manas-2010:p0055:b002:l023","ordinal":1889,"en":"Eating congealed goat fat,"},{"id":"manas-2010:p0055:b002:l024","ordinal":1890,"en":"Finding a way to eat a young barren filly,"},{"id":"manas-2010:p0055:b002:l025","ordinal":1891,"en":"Thus they sustained their lives now."},{"id":"manas-2010:p0055:b002:l026","ordinal":1892,"en":"Since their arrival among these Kalmyks,"},{"id":"manas-2010:p0055:b002:l027","ordinal":1893,"en":"Twelve months had now passed."},{"id":"manas-2010:p0055:b002:l028","ordinal":1894,"en":"Among the forty Kyrgyz households,"},{"id":"manas-2010:p0055:b002:l029","ordinal":1895,"en":"The wise man Akbaltay,"},{"id":"manas-2010:p0055:b002:l030","ordinal":1896,"en":"The gray bull brought from the Kyrgyz—"},{"id":"manas-2010:p0055:b002:l031","ordinal":1897,"en":"They slaughtered that gray bull;"},{"id":"manas-2010:p0055:b002:l032","ordinal":1898,"en":"The many sorrows filling their hearts,"},{"id":"manas-2010:p0055:b002:l033","ordinal":1899,"en":"They banished those many sorrows."},{"id":"manas-2010:p0055:b002:l034","ordinal":1900,"en":"Calling hoarsely like a young goose,"},{"id":"manas-2010:p0055:b002:l035","ordinal":1901,"en":"His white beard gleaming,"},{"id":"manas-2010:p0055:b002:l036","ordinal":1902,"en":"Your elder Baltay to the Kyrgyz"},{"id":"manas-2010:p0055:b002:l037","ordinal":1903,"en":"Spoke wise counsel with a bright face:"},{"id":"manas-2010:p0055:b002:l038","ordinal":1904,"en":"“Forty households come here as culprits,"},{"id":"manas-2010:p0055:b002:l039","ordinal":1905,"en":"Far away remain the Muslims,"},{"id":"manas-2010:p0055:b002:l040","ordinal":1906,"en":"The famed sacred capital of sheikhs;"},{"id":"manas-2010:p0055:b002:l041","ordinal":1907,"en":"We Muslims driven into exile,"},{"id":"manas-2010:p0055:b002:l042","ordinal":1908,"en":"Our land is called Altay."},{"id":"manas-2010:p0055:b002:l043","ordinal":1909,"en":"In Altay your Black Kalmyks"},{"id":"manas-2010:p0055:b002:l044","ordinal":1910,"en":"Are a very fine people."},{"id":"manas-2010:p0055:b002:l045","ordinal":1911,"en":"Lads, let us cast away every sorrow;"},{"id":"manas-2010:p0055:b002:l046","ordinal":1912,"en":"Grieving will not find the Kyrgyz for us."},{"id":"manas-2010:p0055:b002:l047","ordinal":1913,"en":"Let us dig the gold mines,"},{"id":"manas-2010:p0055:b002:l048","ordinal":1914,"en":"Let us hollow out the earth with hoes,"},{"id":"manas-2010:p0056:b002:l001","ordinal":1915,"en":"Before our precious lives end,"},{"id":"manas-2010:p0056:b002:l002","ordinal":1916,"en":"My children, let us eat our fill."},{"id":"manas-2010:p0056:b002:l003","ordinal":1917,"en":"Children, let us set all sorrow aside;"},{"id":"manas-2010:p0056:b002:l004","ordinal":1918,"en":"Grieving will not find the Kyrgyz,"},{"id":"manas-2010:p0056:b002:l005","ordinal":1919,"en":"Nor cover our shame once exposed."},{"id":"manas-2010:p0056:b002:l006","ordinal":1920,"en":"Children, we have"},{"id":"manas-2010:p0056:b002:l007","ordinal":1921,"en":"No support to gird ourselves with,"},{"id":"manas-2010:p0056:b002:l008","ordinal":1922,"en":"On whom we may place our hopes,"},{"id":"manas-2010:p0056:b002:l009","ordinal":1923,"en":"No renowned Kyrgyz people."},{"id":"manas-2010:p0056:b002:l010","ordinal":1924,"en":"We have no Ogoy to shelter us,"},{"id":"manas-2010:p0056:b002:l011","ordinal":1925,"en":"No forest to flee into,"},{"id":"manas-2010:p0056:b002:l012","ordinal":1926,"en":"No flowing spring of our people,"},{"id":"manas-2010:p0056:b002:l013","ordinal":1927,"en":"No time to lie at ease."},{"id":"manas-2010:p0056:b002:l014","ordinal":1928,"en":"We are poor folk keeping ourselves alive,"},{"id":"manas-2010:p0056:b002:l015","ordinal":1929,"en":"Among the Black Kalmyks and Manchus"},{"id":"manas-2010:p0056:b002:l016","ordinal":1930,"en":"We have been left."},{"id":"manas-2010:p0056:b002:l017","ordinal":1931,"en":"Altai is a splendid land;"},{"id":"manas-2010:p0056:b002:l018","ordinal":1932,"en":"The Kalmyks are imposing too,"},{"id":"manas-2010:p0056:b002:l019","ordinal":1933,"en":"Their nation is an excellent people."},{"id":"manas-2010:p0056:b002:l020","ordinal":1934,"en":"Hear the precious words I speak:"},{"id":"manas-2010:p0056:b002:l021","ordinal":1935,"en":"We have no tree planted on the slope,"},{"id":"manas-2010:p0056:b002:l022","ordinal":1936,"en":"No time to lie about in pride,"},{"id":"manas-2010:p0056:b002:l023","ordinal":1937,"en":"No tree standing on the plain,"},{"id":"manas-2010:p0056:b002:l024","ordinal":1938,"en":"No time to sprawl at ease."},{"id":"manas-2010:p0056:b002:l025","ordinal":1939,"en":"Let it take eight or nine years,"},{"id":"manas-2010:p0056:b002:l026","ordinal":1940,"en":"Let us spare ourselves no effort,"},{"id":"manas-2010:p0056:b002:l027","ordinal":1941,"en":"Let us work hard for our living,"},{"id":"manas-2010:p0056:b002:l028","ordinal":1942,"en":"Wrestling with the black earth."},{"id":"manas-2010:p0056:b002:l029","ordinal":1943,"en":"This land is called Altai;"},{"id":"manas-2010:p0056:b002:l030","ordinal":1944,"en":"The Black Kalmyks and Manchus"},{"id":"manas-2010:p0056:b002:l031","ordinal":1945,"en":"Are a people who know no grain."},{"id":"manas-2010:p0056:b002:l032","ordinal":1946,"en":"If the Creator lifts our misfortune,"},{"id":"manas-2010:p0056:b002:l033","ordinal":1947,"en":"You will lie back at ease;"},{"id":"manas-2010:p0056:b002:l034","ordinal":1948,"en":"Of the harvest you have earned,"},{"id":"manas-2010:p0056:b002:l035","ordinal":1949,"en":"You will sell a bowlful for a yearling."},{"id":"manas-2010:p0056:b002:l036","ordinal":1950,"en":"Work, children, work!"},{"id":"manas-2010:p0056:b002:l037","ordinal":1951,"en":"The hungry belly will be filled,"},{"id":"manas-2010:p0056:b002:l038","ordinal":1952,"en":"The lean will grow fat!”"},{"id":"manas-2010:p0056:b002:l039","ordinal":1953,"en":"Akbaltay gave his counsel;"},{"id":"manas-2010:p0056:b002:l040","ordinal":1954,"en":"He was a saintly man."},{"id":"manas-2010:p0056:b002:l041","ordinal":1955,"en":"The old man called Akbaltay"},{"id":"manas-2010:p0056:b002:l042","ordinal":1956,"en":"Possessed great wisdom."},{"id":"manas-2010:p0056:b002:l043","ordinal":1957,"en":"He was better than a spearman,"},{"id":"manas-2010:p0056:b002:l044","ordinal":1958,"en":"Skilled at finding a way."},{"id":"manas-2010:p0056:b002:l045","ordinal":1959,"en":"“Akbaltay is our khan;"},{"id":"manas-2010:p0056:b002:l046","ordinal":1960,"en":"When we wandered to this place,"},{"id":"manas-2010:p0056:b002:l047","ordinal":1961,"en":"The Creator gave us Akbaltay:"},{"id":"manas-2010:p0056:b002:l048","ordinal":1962,"en":"We still have days to live.”"},{"id":"manas-2010:p0057:b002:l001","ordinal":1963,"en":"Your valiant hero Baltay"},{"id":"manas-2010:p0057:b002:l002","ordinal":1964,"en":"Taught what was unknown;"},{"id":"manas-2010:p0057:b002:l003","ordinal":1965,"en":"Wise Baltay was a brave man."},{"id":"manas-2010:p0057:b002:l004","ordinal":1966,"en":"He made the unperceived perceived;"},{"id":"manas-2010:p0057:b002:l005","ordinal":1967,"en":"Keen-sighted Baltay was a lion."},{"id":"manas-2010:p0057:b002:l006","ordinal":1968,"en":"He was a man of sacred gifts,"},{"id":"manas-2010:p0057:b002:l007","ordinal":1969,"en":"His speech was clear when he spoke,"},{"id":"manas-2010:p0057:b002:l008","ordinal":1970,"en":"His eyes saw hidden things in this world;"},{"id":"manas-2010:p0057:b002:l009","ordinal":1971,"en":"He was a man of sacred gifts,"},{"id":"manas-2010:p0057:b002:l010","ordinal":1972,"en":"Known as the khan of the Noygut."},{"id":"manas-2010:p0057:b002:l011","ordinal":1973,"en":"“We wandered here from far away,"},{"id":"manas-2010:p0057:b002:l012","ordinal":1974,"en":"The Almighty gave us Akbaltay;"},{"id":"manas-2010:p0057:b002:l013","ordinal":1975,"en":"This great people standing here"},{"id":"manas-2010:p0057:b002:l014","ordinal":1976,"en":"Must have some good fortune.”"},{"id":"manas-2010:p0057:b002:l015","ordinal":1977,"en":"Baltay gave them hope."},{"id":"manas-2010:p0057:b002:l016","ordinal":1978,"en":"“Let us obey this Akbaltay,"},{"id":"manas-2010:p0057:b002:l017","ordinal":1979,"en":"Let sweat run from our brows,"},{"id":"manas-2010:p0057:b002:l018","ordinal":1980,"en":"Let us sow grain in abundance."},{"id":"manas-2010:p0057:b002:l019","ordinal":1981,"en":"Let us cast off all our grief,"},{"id":"manas-2010:p0057:b002:l020","ordinal":1982,"en":"This year let us dig the black earth"},{"id":"manas-2010:p0057:b002:l021","ordinal":1983,"en":"With our hoes."},{"id":"manas-2010:p0057:b002:l022","ordinal":1984,"en":"Rather than walk about stiffly,"},{"id":"manas-2010:p0057:b002:l023","ordinal":1985,"en":"Let us eat our fill this year;"},{"id":"manas-2010:p0057:b002:l024","ordinal":1986,"en":"Let us obey Akbaltay,"},{"id":"manas-2010:p0057:b002:l025","ordinal":1987,"en":"This year let us toil to gain livestock."},{"id":"manas-2010:p0057:b002:l026","ordinal":1988,"en":"Living souls need livestock,"},{"id":"manas-2010:p0057:b002:l027","ordinal":1989,"en":"Let us gather herds,"},{"id":"manas-2010:p0057:b002:l028","ordinal":1990,"en":"Let us grow fat and strong."},{"id":"manas-2010:p0057:b002:l029","ordinal":1991,"en":"Sparing no effort, gathering herds,"},{"id":"manas-2010:p0057:b002:l030","ordinal":1992,"en":"To the Black Kalmyks and Manchus"},{"id":"manas-2010:p0057:b002:l031","ordinal":1993,"en":"Let us become equal brothers."},{"id":"manas-2010:p0057:b002:l032","ordinal":1994,"en":"Let us throw all sorrow aside;"},{"id":"manas-2010:p0057:b002:l033","ordinal":1995,"en":"This year, with firm resolve,"},{"id":"manas-2010:p0057:b002:l034","ordinal":1996,"en":"Let us begin.”"},{"id":"manas-2010:p0057:b002:l035","ordinal":1997,"en":"“The words of your poor elder Baltay"},{"id":"manas-2010:p0057:b002:l036","ordinal":1998,"en":"Are wise,” he said."},{"id":"manas-2010:p0057:b002:l037","ordinal":1999,"en":"“Whoever disobeys Akbaltay,"},{"id":"manas-2010:p0057:b002:l038","ordinal":2000,"en":"His seven forefathers are unbelievers!"},{"id":"manas-2010:p0057:b002:l039","ordinal":2001,"en":"Wise Baltay has spoken this;"},{"id":"manas-2010:p0057:b002:l040","ordinal":2002,"en":"His thoughtful words are wisdom,”"},{"id":"manas-2010:p0057:b002:l041","ordinal":2003,"en":"My elder Jakyp said."},{"id":"manas-2010:p0057:b002:l042","ordinal":2004,"en":"All forty households,"},{"id":"manas-2010:p0057:b002:l043","ordinal":2005,"en":"Of this people who had wandered here,"},{"id":"manas-2010:p0057:b002:l044","ordinal":2006,"en":"Their elders Akbaltay and Jakyp,"},{"id":"manas-2010:p0057:b002:l045","ordinal":2007,"en":"All forty Kyrgyz households,"},{"id":"manas-2010:p0057:b002:l046","ordinal":2008,"en":"Every one set to work."},{"id":"manas-2010:p0057:b002:l047","ordinal":2009,"en":"They dug the gold mine;"},{"id":"manas-2010:p0057:b002:l048","ordinal":2010,"en":"The gold they had dug"},{"id":"manas-2010:p0058:b002:l001","ordinal":2011,"en":"They hid away in bags,"},{"id":"manas-2010:p0058:b002:l002","ordinal":2012,"en":"And when need arose, to the Kalmyks"},{"id":"manas-2010:p0058:b002:l003","ordinal":2013,"en":"They sold it for the four kinds of stock."},{"id":"manas-2010:p0058:b002:l004","ordinal":2014,"en":"They readied the plow beam,"},{"id":"manas-2010:p0058:b002:l005","ordinal":2015,"en":"Yoked their pair of oxen,"},{"id":"manas-2010:p0058:b002:l006","ordinal":2016,"en":"Opened the face of the earth,"},{"id":"manas-2010:p0058:b002:l007","ordinal":2017,"en":"Scattered seed by the handful."},{"id":"manas-2010:p0058:b002:l008","ordinal":2018,"en":"They plowed, and summer came;"},{"id":"manas-2010:p0058:b002:l009","ordinal":2019,"en":"The Kyrgyz grew immeasurably rich,"},{"id":"manas-2010:p0058:b002:l010","ordinal":2020,"en":"Chewing grains of white wheat,"},{"id":"manas-2010:p0058:b002:l011","ordinal":2021,"en":"Before their doors"},{"id":"manas-2010:p0058:b002:l012","ordinal":2022,"en":"Tethering six steeds apiece."},{"id":"manas-2010:p0058:b002:l013","ordinal":2023,"en":"Of the grain they had grown,"},{"id":"manas-2010:p0058:b002:l014","ordinal":2024,"en":"They sold a double handful for a sheep,"},{"id":"manas-2010:p0058:b002:l015","ordinal":2025,"en":"A bowlful for a yearling."},{"id":"manas-2010:p0058:b002:l016","ordinal":2026,"en":"They vied in tireless effort,"},{"id":"manas-2010:p0058:b002:l017","ordinal":2027,"en":"Grew rich in countless livestock,"},{"id":"manas-2010:p0058:b002:l018","ordinal":2028,"en":"Their hearts now at ease,"},{"id":"manas-2010:p0058:b002:l019","ordinal":2029,"en":"Bringing their wishes to fulfillment,"},{"id":"manas-2010:p0058:b002:l020","ordinal":2030,"en":"Every one of their chests"},{"id":"manas-2010:p0058:b002:l021","ordinal":2031,"en":"They filled with yellow gold and treasure."},{"id":"manas-2010:p0058:b002:l022","ordinal":2032,"en":"He filled his wealth with possessions,"},{"id":"manas-2010:p0058:b002:l023","ordinal":2033,"en":"Hid his pens in clouds of dust,"},{"id":"manas-2010:p0058:b002:l024","ordinal":2034,"en":"And was called Jakyp the Rich."},{"id":"manas-2010:p0058:b002:l025","ordinal":2035,"en":"Brave Jakyp kept countless livestock,"},{"id":"manas-2010:p0058:b002:l026","ordinal":2036,"en":"His four kinds of stock flourished;"},{"id":"manas-2010:p0058:b002:l027","ordinal":2037,"en":"Your noble elder Jakyp grew rich."},{"id":"manas-2010:p0058:b002:l028","ordinal":2038,"en":"With drooping lower lips,"},{"id":"manas-2010:p0058:b002:l029","ordinal":2039,"en":"Their two humps towering,"},{"id":"manas-2010:p0058:b002:l030","ordinal":2040,"en":"His gelded camels numbered six san;"},{"id":"manas-2010:p0058:b002:l031","ordinal":2041,"en":"Your elder Jakyp grew rich."},{"id":"manas-2010:p0058:b002:l032","ordinal":2042,"en":"While he lived in Altai,"},{"id":"manas-2010:p0058:b002:l033","ordinal":2043,"en":"Your fierce elder Jakyp's"},{"id":"manas-2010:p0058:b002:l034","ordinal":2044,"en":"Gold filled seven houses."},{"id":"manas-2010:p0058:b002:l036","ordinal":2045,"en":"On the hills, six san horses,"},{"id":"manas-2010:p0058:b002:l037","ordinal":2046,"en":"Argymaks and swift steeds mingled;"},{"id":"manas-2010:p0058:b002:l038","ordinal":2047,"en":"Jakyp kept countless livestock,"},{"id":"manas-2010:p0058:b002:l039","ordinal":2048,"en":"His heart at ease each day."}]
