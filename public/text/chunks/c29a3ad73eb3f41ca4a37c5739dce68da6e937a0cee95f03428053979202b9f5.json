[{"id":"semetey-1-2013:p0826:b004:l038","ordinal":139521,"en":"Look where he has crawled,” she said."},{"id":"semetey-1-2013:p0826:b004:l039","ordinal":139522,"en":"After my mother said this,"},{"id":"semetey-1-2013:p0827:b003:l001","ordinal":139523,"en":"After taking this counsel,"},{"id":"semetey-1-2013:p0827:b003:l002","ordinal":139524,"en":"I followed the tracks where you had crawled,"},{"id":"semetey-1-2013:p0827:b003:l003","ordinal":139525,"en":"And one of those protecting you"},{"id":"semetey-1-2013:p0827:b003:l004","ordinal":139526,"en":"I happened to come upon."},{"id":"semetey-1-2013:p0827:b003:l005","ordinal":139527,"en":"You lay alone upon your back,"},{"id":"semetey-1-2013:p0827:b003:l006","ordinal":139528,"en":"Enjoying yourself,"},{"id":"semetey-1-2013:p0827:b003:l007","ordinal":139529,"en":"At a snow-white doe"},{"id":"semetey-1-2013:p0827:b003:l008","ordinal":139530,"en":"You lay sucking milk."},{"id":"semetey-1-2013:p0827:b003:l009","ordinal":139531,"en":"I ran inside and came to you;"},{"id":"semetey-1-2013:p0827:b003:l010","ordinal":139532,"en":"The doe took fright."},{"id":"semetey-1-2013:p0827:b003:l011","ordinal":139533,"en":"You had suckled the doe to your fill;"},{"id":"semetey-1-2013:p0827:b003:l012","ordinal":139534,"en":"Milk had flowed from both corners of your mouth,"},{"id":"semetey-1-2013:p0827:b003:l013","ordinal":139535,"en":"Running down onto the ground;"},{"id":"semetey-1-2013:p0827:b003:l014","ordinal":139536,"en":"Two buckets of milk"},{"id":"semetey-1-2013:p0827:b003:l015","ordinal":139537,"en":"Had curdled there upon the earth."},{"id":"semetey-1-2013:p0827:b003:l016","ordinal":139538,"en":"I too ate my fill of it,"},{"id":"semetey-1-2013:p0827:b003:l017","ordinal":139539,"en":"And the sorrow within me"},{"id":"semetey-1-2013:p0827:b003:l018","ordinal":139540,"en":"I then set aside."},{"id":"semetey-1-2013:p0827:b003:l019","ordinal":139541,"en":"Showing this sign,"},{"id":"semetey-1-2013:p0827:b003:l020","ordinal":139542,"en":"That great plane tree of yours"},{"id":"semetey-1-2013:p0827:b003:l021","ordinal":139543,"en":"To me, your wretched mother,"},{"id":"semetey-1-2013:p0827:b003:l022","ordinal":139544,"en":"Must have been a mother.”"},{"id":"semetey-1-2013:p0827:b003:l023","ordinal":139545,"en":"Manas’s son, the brave orphan,"},{"id":"semetey-1-2013:p0827:b003:l024","ordinal":139546,"en":"Stood looking at the tree:"},{"id":"semetey-1-2013:p0827:b003:l025","ordinal":139547,"en":"The very form of the world,"},{"id":"semetey-1-2013:p0827:b003:l026","ordinal":139548,"en":"Such was this tree’s wonder."},{"id":"semetey-1-2013:p0827:b003:l027","ordinal":139549,"en":"He looked at one branch:"},{"id":"semetey-1-2013:p0827:b003:l028","ordinal":139550,"en":"A pied crow had bred there."},{"id":"semetey-1-2013:p0827:b003:l029","ordinal":139551,"en":"He looked at another branch:"},{"id":"semetey-1-2013:p0827:b003:l030","ordinal":139552,"en":"A gray-necked jackdaw had bred there."},{"id":"semetey-1-2013:p0827:b003:l031","ordinal":139553,"en":"He looked at another branch:"},{"id":"semetey-1-2013:p0827:b003:l032","ordinal":139554,"en":"A big-throated rook had bred there."},{"id":"semetey-1-2013:p0827:b003:l033","ordinal":139555,"en":"He looked at another branch:"},{"id":"semetey-1-2013:p0827:b003:l034","ordinal":139556,"en":"He saw one flying with drooping wings:"},{"id":"semetey-1-2013:p0827:b003:l035","ordinal":139557,"en":"A drooping-winged raptor had bred there,"},{"id":"semetey-1-2013:p0827:b003:l036","ordinal":139558,"en":"Such were its wonders;"},{"id":"semetey-1-2013:p0827:b003:l037","ordinal":139559,"en":"Every living creature had bred there.”"},{"id":"semetey-1-2013:p0827:b003:l038","ordinal":139560,"en":"They dismounted to pay reverence,"},{"id":"semetey-1-2013:p0827:b003:l039","ordinal":139561,"en":"Prayed and took their meal,"},{"id":"semetey-1-2013:p0827:b005:l001","ordinal":139562,"en":"Then properly saddled the noble steed."},{"id":"semetey-1-2013:p0827:b005:l002","ordinal":139563,"en":"They loudly recited the Koran,"},{"id":"semetey-1-2013:p0827:b005:l003","ordinal":139564,"en":"Traveled in haste without stopping,"},{"id":"semetey-1-2013:p0827:b005:l004","ordinal":139565,"en":"Went far, sparing no horse."},{"id":"semetey-1-2013:p0827:b005:l005","ordinal":139566,"en":"Karalduu-Döbö and Kara-Özön—"},{"id":"semetey-1-2013:p0827:b005:l006","ordinal":139567,"en":"Their dark ridges came into view."},{"id":"semetey-1-2013:p0827:b005:l007","ordinal":139568,"en":"When she saw those ridges,"},{"id":"semetey-1-2013:p0827:b005:l008","ordinal":139569,"en":"Dear, fierce Kanykei"},{"id":"semetey-1-2013:p0827:b005:l009","ordinal":139570,"en":"Was deeply troubled at heart."},{"id":"semetey-1-2013:p0827:b005:l010","ordinal":139571,"en":"Hunched like a hunting hound,"},{"id":"semetey-1-2013:p0827:b005:l011","ordinal":139572,"en":"Had she not trotted here, poor soul?"},{"id":"semetey-1-2013:p0827:b005:l012","ordinal":139573,"en":"Enduring much hardship and misery,"},{"id":"semetey-1-2013:p0827:b005:l013","ordinal":139574,"en":"Fleeing Talas, wandering on foot,"},{"id":"semetey-1-2013:p0827:b005:l014","ordinal":139575,"en":"Had she not come here, poor soul?"},{"id":"semetey-1-2013:p0827:b005:l015","ordinal":139576,"en":"Many lands and many roads—"},{"id":"semetey-1-2013:p0827:b005:l016","ordinal":139577,"en":"Had she not seen them, poor soul?"},{"id":"semetey-1-2013:p0827:b005:l017","ordinal":139578,"en":"When she came to that place,"},{"id":"semetey-1-2013:p0827:b005:l018","ordinal":139579,"en":"She turned her horse’s head,"},{"id":"semetey-1-2013:p0827:b005:l019","ordinal":139580,"en":"And spoke of that road:"},{"id":"semetey-1-2013:p0827:b005:l020","ordinal":139581,"en":"“Not a mountain the size of a knucklebone,"},{"id":"semetey-1-2013:p0827:b005:l021","ordinal":139582,"en":"Not a hollow the size of a saddlecloth,"},{"id":"semetey-1-2013:p0827:b005:l022","ordinal":139583,"en":"Not a furrow cut by a plow,"},{"id":"semetey-1-2013:p0827:b005:l023","ordinal":139584,"en":"Not a burrow dug by a marmot."},{"id":"semetey-1-2013:p0827:b005:l024","ordinal":139585,"en":"No crow flying and cawing,"},{"id":"semetey-1-2013:p0827:b005:l025","ordinal":139586,"en":"No raven flying and croaking."},{"id":"semetey-1-2013:p0827:b005:l026","ordinal":139587,"en":"Let me tell you of this road:"},{"id":"semetey-1-2013:p0827:b005:l027","ordinal":139588,"en":"Flame within me, embers without,"},{"id":"semetey-1-2013:p0827:b005:l028","ordinal":139589,"en":"No one to know my secret."},{"id":"semetey-1-2013:p0827:b005:l030","ordinal":139590,"en":"I shall tell much of my grief.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0827:b005:l031","ordinal":139591,"en":"When I scattered my wealth,"},{"id":"semetey-1-2013:p0827:b005:l032","ordinal":139592,"en":"When I fled Talas on foot,"},{"id":"semetey-1-2013:p0827:b005:l033","ordinal":139593,"en":"It was Aman-Jol itself—"},{"id":"semetey-1-2013:p0827:b005:l034","ordinal":139594,"en":"Indeed, its very black eye."},{"id":"semetey-1-2013:p0827:b005:l035","ordinal":139595,"en":"With their ears pricked up,"},{"id":"semetey-1-2013:p0827:b005:l036","ordinal":139596,"en":"Wolves do not travel this road."},{"id":"semetey-1-2013:p0827:b005:l037","ordinal":139597,"en":"With their tails trailing,"},{"id":"semetey-1-2013:p0827:b005:l038","ordinal":139598,"en":"Foxes do not travel this road."},{"id":"semetey-1-2013:p0828:b003:l001","ordinal":139599,"en":"Where no cold-hearted man comes and goes,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0828:b003:l002","ordinal":139600,"en":"Whose nature caravans do not know—"},{"id":"semetey-1-2013:p0828:b003:l003","ordinal":139601,"en":"This is the road called Aman-Jol."},{"id":"semetey-1-2013:p0828:b003:l004","ordinal":139602,"en":"There, taking shape in the haze,"},{"id":"semetey-1-2013:p0828:b003:l005","ordinal":139603,"en":"There, rising to a misty point,"},{"id":"semetey-1-2013:p0828:b003:l006","ordinal":139604,"en":"Swelling like a little bowl,"},{"id":"semetey-1-2013:p0828:b003:l007","ordinal":139605,"en":"Low fog falling apart along its edges,"},{"id":"semetey-1-2013:p0828:b003:l008","ordinal":139606,"en":"Dark smoke showing above it—"},{"id":"semetey-1-2013:p0828:b003:l009","ordinal":139607,"en":"That is the city called Khan Kokand."},{"id":"semetey-1-2013:p0828:b003:l011","ordinal":139608,"en":"The great city lying there,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0828:b003:l012","ordinal":139609,"en":"Rising to a point, is Samarkand."},{"id":"semetey-1-2013:p0828:b003:l013","ordinal":139610,"en":"There, its outline beyond the reach of sight—"},{"id":"semetey-1-2013:p0828:b003:l015","ordinal":139611,"en":"Listen, my only child—"},{"id":"semetey-1-2013:p0828:b003:l016","ordinal":139612,"en":"That is the city called Margalan."},{"id":"semetey-1-2013:p0828:b003:l017","ordinal":139613,"en":"Its name is heard, its shape unseen;"},{"id":"semetey-1-2013:p0828:b003:l018","ordinal":139614,"en":"My child, that is the road to Andijan."},{"id":"semetey-1-2013:p0828:b003:l019","ordinal":139615,"en":"Ruling Andijan"},{"id":"semetey-1-2013:p0828:b003:l020","ordinal":139616,"en":"Was fork-bearded Synchybek;"},{"id":"semetey-1-2013:p0828:b003:l021","ordinal":139617,"en":"In Alty-Shaar was Alabek."},{"id":"semetey-1-2013:p0828:b003:l022","ordinal":139618,"en":"Many tales were told of them;"},{"id":"semetey-1-2013:p0828:b003:l023","ordinal":139619,"en":"Their rulers were various beks."},{"id":"semetey-1-2013:p0828:b003:l024","ordinal":139620,"en":"Orphan, listen now!"},{"id":"semetey-1-2013:p0828:b003:l025","ordinal":139621,"en":"Malabek of Margalan,"},{"id":"semetey-1-2013:p0828:b003:l026","ordinal":139622,"en":"Sanchybek of Samarkand,"},{"id":"semetey-1-2013:p0828:b003:l027","ordinal":139623,"en":"Kozubek of Khan Kokand—"},{"id":"semetey-1-2013:p0828:b003:l028","ordinal":139624,"en":"Their thoroughbreds thundered."},{"id":"semetey-1-2013:p0828:b003:l029","ordinal":139625,"en":"The sacred city with its court,"},{"id":"semetey-1-2013:p0828:b003:l030","ordinal":139626,"en":"Great Kokand and Margalan—"},{"id":"semetey-1-2013:p0828:b003:l031","ordinal":139627,"en":"They themselves were blustering, bellowing men,"},{"id":"semetey-1-2013:p0828:b003:l032","ordinal":139628,"en":"Arrogant and contrary;"},{"id":"semetey-1-2013:p0828:b003:l033","ordinal":139629,"en":"Those people were like beasts."},{"id":"semetey-1-2013:p0828:b003:l034","ordinal":139630,"en":"They had round baked bread,"},{"id":"semetey-1-2013:p0828:b003:l035","ordinal":139631,"en":"And houses with four corners."},{"id":"semetey-1-2013:p0828:b003:l037","ordinal":139632,"en":"These shouting Sarts","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0828:b003:l038","ordinal":139633,"en":"Were rather hostile to your father Manas."},{"id":"semetey-1-2013:p0828:b003:l039","ordinal":139634,"en":"The reason they became enemies:"},{"id":"semetey-1-2013:p0828:b004:l001","ordinal":139635,"en":"When your father came from Altai"},{"id":"semetey-1-2013:p0828:b004:l002","ordinal":139636,"en":"And made Talas his home,"},{"id":"semetey-1-2013:p0828:b004:l003","ordinal":139637,"en":"A handful of Muslims"},{"id":"semetey-1-2013:p0828:b004:l004","ordinal":139638,"en":"He gathered about him as a father."},{"id":"semetey-1-2013:p0828:b004:l005","ordinal":139639,"en":"Of twelve Muslim khans,"},{"id":"semetey-1-2013:p0828:b004:l006","ordinal":139640,"en":"When two remained neutral,"},{"id":"semetey-1-2013:p0828:b004:l007","ordinal":139641,"en":"‘I shall attack your father,’ they said;"},{"id":"semetey-1-2013:p0828:b004:l008","ordinal":139642,"en":"When God struck the others,"},{"id":"semetey-1-2013:p0828:b004:l009","ordinal":139643,"en":"When they went to broad Talas,"},{"id":"semetey-1-2013:p0828:b004:l010","ordinal":139644,"en":"Into the warriors’ hands"},{"id":"semetey-1-2013:p0828:b004:l011","ordinal":139645,"en":"Fell the people of ten khans."},{"id":"semetey-1-2013:p0828:b004:l012","ordinal":139646,"en":"Your khan father, leopard Manas,"},{"id":"semetey-1-2013:p0828:b004:l013","ordinal":139647,"en":"Made his dwelling in Talas;"},{"id":"semetey-1-2013:p0828:b004:l014","ordinal":139648,"en":"The Muslim people of ten khans—"},{"id":"semetey-1-2013:p0828:b004:l015","ordinal":139649,"en":"He drove them all"},{"id":"semetey-1-2013:p0828:b004:l016","ordinal":139650,"en":"Under guard toward Beijing."},{"id":"semetey-1-2013:p0828:b004:l017","ordinal":139651,"en":"Beijing, beyond Sulaiman’s reach—"},{"id":"semetey-1-2013:p0828:b004:l018","ordinal":139652,"en":"When he called it to account,"},{"id":"semetey-1-2013:p0828:b004:l019","ordinal":139653,"en":"Beijing, untouched by Aaly-Sher—"},{"id":"semetey-1-2013:p0828:b004:l020","ordinal":139654,"en":"When he fought and wrought slaughter there,"},{"id":"semetey-1-2013:p0828:b004:l021","ordinal":139655,"en":"Proud lords and khans died,"},{"id":"semetey-1-2013:p0828:b004:l022","ordinal":139656,"en":"Everyone he met died."},{"id":"semetey-1-2013:p0828:b004:l023","ordinal":139657,"en":"Not knowing his deeds, the Kokand people,"},{"id":"semetey-1-2013:p0828:b004:l024","ordinal":139658,"en":"The peoples of four khans, gathered;"},{"id":"semetey-1-2013:p0828:b004:l026","ordinal":139659,"en":"Thus, when their conduct turned bad,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0828:b004:l028","ordinal":139660,"en":"Your leopard father"},{"id":"semetey-1-2013:p0828:b004:l029","ordinal":139661,"en":"Would humiliate Kokand."},{"id":"semetey-1-2013:p0828:b004:l030","ordinal":139662,"en":"Relentlessly, from the Sarts,"},{"id":"semetey-1-2013:p0828:b004:l031","ordinal":139663,"en":"He exacted heavy tribute."},{"id":"semetey-1-2013:p0828:b004:l032","ordinal":139664,"en":"From Alty-Shaar and Kokand"},{"id":"semetey-1-2013:p0828:b004:l033","ordinal":139665,"en":"He took tribute;"},{"id":"semetey-1-2013:p0828:b004:l034","ordinal":139666,"en":"He treated them like sheep."},{"id":"semetey-1-2013:p0828:b004:l035","ordinal":139667,"en":"Six thousand silver ingots, a thousand otter pelts"},{"id":"semetey-1-2013:p0828:b004:l036","ordinal":139668,"en":"He would take in tribute."},{"id":"semetey-1-2013:p0828:b004:l037","ordinal":139669,"en":"Unable to bear the tribute,"},{"id":"semetey-1-2013:p0828:b004:l038","ordinal":139670,"en":"Every people would weep."},{"id":"semetey-1-2013:p0828:b004:l039","ordinal":139671,"en":"They too have a vengeance to seek."},{"id":"semetey-1-2013:p0829:b003:l001","ordinal":139672,"en":"‘They have moved away from Bukhara,’"},{"id":"semetey-1-2013:p0829:b003:l002","ordinal":139673,"en":"They must have heard from caravans."},{"id":"semetey-1-2013:p0829:b003:l003","ordinal":139674,"en":"The peoples of four khans have surely united"},{"id":"semetey-1-2013:p0829:b003:l004","ordinal":139675,"en":"And gathered their armies."},{"id":"semetey-1-2013:p0829:b003:l005","ordinal":139676,"en":"To seize you,"},{"id":"semetey-1-2013:p0829:b003:l006","ordinal":139677,"en":"To put an end to you,"},{"id":"semetey-1-2013:p0829:b003:l007","ordinal":139678,"en":"The peoples of four khans have gathered,"},{"id":"semetey-1-2013:p0829:b003:l008","ordinal":139679,"en":"Chewing white wheat flour,"},{"id":"semetey-1-2013:p0829:b003:l009","ordinal":139680,"en":"Holding the Holy Koran,"},{"id":"semetey-1-2013:p0829:b003:l010","ordinal":139681,"en":"Invoking God as they speak,"},{"id":"semetey-1-2013:p0829:b003:l011","ordinal":139682,"en":"Making their promise firm,"},{"id":"semetey-1-2013:p0829:b003:l012","ordinal":139683,"en":"Swearing an oath unto death,"},{"id":"semetey-1-2013:p0829:b003:l013","ordinal":139684,"en":"They must have risen in uproar."},{"id":"semetey-1-2013:p0829:b003:l014","ordinal":139685,"en":"All those people"},{"id":"semetey-1-2013:p0829:b003:l015","ordinal":139686,"en":"Must be in great turmoil;"},{"id":"semetey-1-2013:p0829:b003:l016","ordinal":139687,"en":"They must have gathered their champions,"},{"id":"semetey-1-2013:p0829:b003:l017","ordinal":139688,"en":"The others must be plotting,"},{"id":"semetey-1-2013:p0829:b003:l018","ordinal":139689,"en":"They must have blocked your way."},{"id":"semetey-1-2013:p0829:b003:l019","ordinal":139690,"en":"It is no ridge to give us shelter,"},{"id":"semetey-1-2013:p0829:b003:l020","ordinal":139691,"en":"No people a mortal can trust."},{"id":"semetey-1-2013:p0829:b003:l021","ordinal":139692,"en":"‘He threw Tööbalban down;"},{"id":"semetey-1-2013:p0829:b003:l022","ordinal":139693,"en":"Though we begged him for mercy, he would not desist;"},{"id":"semetey-1-2013:p0829:b003:l023","ordinal":139694,"en":"He tore off one arm,"},{"id":"semetey-1-2013:p0829:b003:l024","ordinal":139695,"en":"He put him to death’—"},{"id":"semetey-1-2013:p0829:b003:l025","ordinal":139696,"en":"Kokand has that vengeance too."},{"id":"semetey-1-2013:p0829:b003:l026","ordinal":139697,"en":"My spring, my river in its valley,"},{"id":"semetey-1-2013:p0829:b003:l027","ordinal":139698,"en":"My child whom I gained at death’s door,"},{"id":"semetey-1-2013:p0829:b003:l028","ordinal":139699,"en":"That hill showing darkly"},{"id":"semetey-1-2013:p0829:b003:l029","ordinal":139700,"en":"Is the ridge of Khan Kokand."},{"id":"semetey-1-2013:p0829:b003:l030","ordinal":139701,"en":"At all times on that ridge"},{"id":"semetey-1-2013:p0829:b003:l031","ordinal":139702,"en":"A sentry has stood."},{"id":"semetey-1-2013:p0829:b003:l032","ordinal":139703,"en":"My darling orphan,"},{"id":"semetey-1-2013:p0829:b003:l033","ordinal":139704,"en":"Let us never come upon them."},{"id":"semetey-1-2013:p0829:b003:l034","ordinal":139705,"en":"I, your mother Kanykei—"},{"id":"semetey-1-2013:p0829:b003:l035","ordinal":139706,"en":"Understand her blessed words;"},{"id":"semetey-1-2013:p0829:b003:l036","ordinal":139707,"en":"My precious orphan, heed me!"},{"id":"semetey-1-2013:p0829:b003:l037","ordinal":139708,"en":"If we come upon this road,"},{"id":"semetey-1-2013:p0829:b003:l038","ordinal":139709,"en":"If you are captured by Kokand,"},{"id":"semetey-1-2013:p0829:b003:l039","ordinal":139710,"en":"If you challenge them, they will not let you prosper;"},{"id":"semetey-1-2013:p0829:b004:l001","ordinal":139711,"en":"Alas, Kokand will not leave you unharmed."},{"id":"semetey-1-2013:p0829:b004:l002","ordinal":139712,"en":"Gathered from four khans’ peoples,"},{"id":"semetey-1-2013:p0829:b004:l003","ordinal":139713,"en":"They have great numbers of troops,"},{"id":"semetey-1-2013:p0829:b004:l004","ordinal":139714,"en":"They have pits dug ready,"},{"id":"semetey-1-2013:p0829:b004:l005","ordinal":139715,"en":"They have brine boiling ready."},{"id":"semetey-1-2013:p0829:b004:l006","ordinal":139716,"en":"Aman-Jol, where your mother came wandering—"},{"id":"semetey-1-2013:p0829:b004:l008","ordinal":139717,"en":"Let us take Aman-Jol."},{"id":"semetey-1-2013:p0829:b004:l009","ordinal":139718,"en":"These people with their white devils—"},{"id":"semetey-1-2013:p0829:b004:l010","ordinal":139719,"en":"My darling foal,"},{"id":"semetey-1-2013:p0829:b004:l011","ordinal":139720,"en":"Let us pass away unseen."},{"id":"semetey-1-2013:p0829:b004:l012","ordinal":139721,"en":"These people riding on packsaddles—"},{"id":"semetey-1-2013:p0829:b004:l013","ordinal":139722,"en":"Why should we contend with them?"},{"id":"semetey-1-2013:p0829:b004:l014","ordinal":139723,"en":"This road is full of terror and trouble."},{"id":"semetey-1-2013:p0829:b004:l015","ordinal":139724,"en":"The land inherited from your father—"},{"id":"semetey-1-2013:p0829:b004:l016","ordinal":139725,"en":"Let us enter Talas."},{"id":"semetey-1-2013:p0829:b004:l017","ordinal":139726,"en":"White-bearded elders have said,"},{"id":"semetey-1-2013:p0829:b004:l018","ordinal":139727,"en":"All the wise have said:"},{"id":"semetey-1-2013:p0829:b004:l019","ordinal":139728,"en":"‘A man rests not till he reaches his people,"},{"id":"semetey-1-2013:p0829:b004:l020","ordinal":139729,"en":"A girl rests not till she marries a man,"},{"id":"semetey-1-2013:p0829:b004:l021","ordinal":139730,"en":"A dog rests not till it reaches its home.’"},{"id":"semetey-1-2013:p0829:b004:l022","ordinal":139731,"en":"My hoof left by the noble steed,"},{"id":"semetey-1-2013:p0829:b004:l023","ordinal":139732,"en":"My young one left by the falcon!"},{"id":"semetey-1-2013:p0829:b004:l024","ordinal":139733,"en":"Bukhara has rough ridges,"},{"id":"semetey-1-2013:p0829:b004:l025","ordinal":139734,"en":"And people inclined to mischief."},{"id":"semetey-1-2013:p0829:b004:l026","ordinal":139735,"en":"Do not lean on a rugged ridge;"},{"id":"semetey-1-2013:p0829:b004:l027","ordinal":139736,"en":"Do not contend with treacherous people."},{"id":"semetey-1-2013:p0829:b004:l029","ordinal":139737,"en":"You alone are my support.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0829:b004:l030","ordinal":139738,"en":"You have no support to rely upon;"},{"id":"semetey-1-2013:p0829:b004:l031","ordinal":139739,"en":"If a great army advances and surrounds you,"},{"id":"semetey-1-2013:p0829:b004:l032","ordinal":139740,"en":"You have no famed warrior Bakai."},{"id":"semetey-1-2013:p0829:b004:l033","ordinal":139741,"en":"There is no forest to flee into;"},{"id":"semetey-1-2013:p0829:b004:l034","ordinal":139742,"en":"Beside you, to give you shelter,"},{"id":"semetey-1-2013:p0829:b004:l035","ordinal":139743,"en":"There is no vast Kyrgyz people!”"},{"id":"semetey-1-2013:p0829:b004:l036","ordinal":139744,"en":"As his mother spoke,"},{"id":"semetey-1-2013:p0829:b004:l037","ordinal":139745,"en":"Would the incorrigible orphan mend his ways?"},{"id":"semetey-1-2013:p0829:b004:l038","ordinal":139746,"en":"Of your dear, fierce mother—"},{"id":"semetey-1-2013:p0830:b003:l001","ordinal":139747,"en":"Would he heed her words?"},{"id":"semetey-1-2013:p0830:b003:l002","ordinal":139748,"en":"Growing stronger whenever it seemed spent,"},{"id":"semetey-1-2013:p0830:b003:l003","ordinal":139749,"en":"The line of deep-rooted Manas;"},{"id":"semetey-1-2013:p0830:b003:l004","ordinal":139750,"en":"Increasing with every death,"},{"id":"semetey-1-2013:p0830:b003:l005","ordinal":139751,"en":"The line of mighty Manas—"},{"id":"semetey-1-2013:p0830:b003:l006","ordinal":139752,"en":"Semetey stood and said:"},{"id":"semetey-1-2013:p0830:b003:l007","ordinal":139753,"en":"“Alas, Mother, what are you saying?"},{"id":"semetey-1-2013:p0830:b003:l008","ordinal":139754,"en":"Who should hear these words of yours?"},{"id":"semetey-1-2013:p0830:b003:l009","ordinal":139755,"en":"Let only the dark night hear them;"},{"id":"semetey-1-2013:p0830:b003:l010","ordinal":139756,"en":"Who else should hear them?"},{"id":"semetey-1-2013:p0830:b003:l011","ordinal":139757,"en":"When we moved from Temirkan,"},{"id":"semetey-1-2013:p0830:b003:l012","ordinal":139758,"en":"‘He wandered in and grew up here,"},{"id":"semetey-1-2013:p0830:b003:l013","ordinal":139759,"en":"Then took his inheritance,’ will they not say?"},{"id":"semetey-1-2013:p0830:b003:l014","ordinal":139760,"en":"‘The wealth he received as his share"},{"id":"semetey-1-2013:p0830:b003:l015","ordinal":139761,"en":"He scattered and left,’ will they not say?"},{"id":"semetey-1-2013:p0830:b003:l016","ordinal":139762,"en":"‘That worthless son of Manas,"},{"id":"semetey-1-2013:p0830:b003:l018","ordinal":139763,"en":"Through mountains where no wild goat walks,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0830:b003:l019","ordinal":139764,"en":"He fled,’ will they not say?"},{"id":"semetey-1-2013:p0830:b003:l020","ordinal":139765,"en":"Their many people will gather;"},{"id":"semetey-1-2013:p0830:b003:l021","ordinal":139766,"en":"Will they not gossip and mock?"},{"id":"semetey-1-2013:p0830:b003:l022","ordinal":139767,"en":"A man destined to be struck down—"},{"id":"semetey-1-2013:p0830:b003:l023","ordinal":139768,"en":"Does not God strike him thus?"},{"id":"semetey-1-2013:p0830:b003:l024","ordinal":139769,"en":"The decree written by Allah—"},{"id":"semetey-1-2013:p0830:b003:l025","ordinal":139770,"en":"Must not a mortal soul meet it?"},{"id":"semetey-1-2013:p0830:b003:l026","ordinal":139771,"en":"When death comes and our days are ended,"},{"id":"semetey-1-2013:p0830:b003:l027","ordinal":139772,"en":"When the Creator gives command,"},{"id":"semetey-1-2013:p0830:b003:l028","ordinal":139773,"en":"When the angel who takes life"},{"id":"semetey-1-2013:p0830:b003:l029","ordinal":139774,"en":"Stretches his five fingers toward us,"},{"id":"semetey-1-2013:p0830:b003:l030","ordinal":139775,"en":"Then the glib tongue that speaks is stilled."},{"id":"semetey-1-2013:p0830:b003:l031","ordinal":139776,"en":"This world is truly vain;"}]
