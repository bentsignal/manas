[{"id":"manas-2010:p1043:b001:l035","ordinal":45569,"en":"If he could, that wretched slave"},{"id":"manas-2010:p1043:b001:l036","ordinal":45570,"en":"Was always seeking to trip me up."},{"id":"manas-2010:p1043:b001:l037","ordinal":45571,"en":"There was crookedness in his speech."},{"id":"manas-2010:p1043:b001:l038","ordinal":45572,"en":"Given the chance, that wretched slave"},{"id":"manas-2010:p1043:b001:l039","ordinal":45573,"en":"Was always seeking to cut me down."},{"id":"manas-2010:p1043:b001:l040","ordinal":45574,"en":"Common iron will not become keen steel;"},{"id":"manas-2010:p1043:b001:l041","ordinal":45575,"en":"Someone raised apart will not become one's people."},{"id":"manas-2010:p1043:b001:l042","ordinal":45576,"en":"Given the chance, that worthless dog—"},{"id":"manas-2010:p1044:b001:l001","ordinal":45577,"en":"He is capable of doing harm."},{"id":"manas-2010:p1044:b001:l002","ordinal":45578,"en":"He shares my father,"},{"id":"manas-2010:p1044:b001:l003","ordinal":45579,"en":"The son of my mother's rival wife."},{"id":"manas-2010:p1044:b001:l004","ordinal":45580,"en":"When I am gone—"},{"id":"manas-2010:p1044:b001:l005","ordinal":45581,"en":"Her forehead sloped back,"},{"id":"manas-2010:p1044:b001:l006","ordinal":45582,"en":"Unfortunate Kanykei,"},{"id":"manas-2010:p1044:b001:l007","ordinal":45583,"en":"Her share of fortune was scant,"},{"id":"manas-2010:p1044:b001:l008","ordinal":45584,"en":"The hair upon her forehead like grass."},{"id":"manas-2010:p1044:b001:l009","ordinal":45585,"en":"When I am gone,"},{"id":"manas-2010:p1044:b001:l010","ordinal":45586,"en":"She will bear suffering upon her face;"},{"id":"manas-2010:p1044:b001:l011","ordinal":45587,"en":"Her troubles will be many."},{"id":"manas-2010:p1044:b001:l012","ordinal":45588,"en":"Tamarisk-covered Keng-Kol, broad Talas—"},{"id":"manas-2010:p1044:b001:l013","ordinal":45589,"en":"Naming the land, he grieved;"},{"id":"manas-2010:p1044:b001:l014","ordinal":45590,"en":"The prosperous Kyrgyz, the many Nogoy—"},{"id":"manas-2010:p1044:b001:l015","ordinal":45591,"en":"Thinking of the people, he grieved:"},{"id":"manas-2010:p1044:b001:l016","ordinal":45592,"en":"“If I should die suddenly in Beijing,"},{"id":"manas-2010:p1044:b001:l017","ordinal":45593,"en":"Not listening to one another,"},{"id":"manas-2010:p1044:b001:l018","ordinal":45594,"en":"My hapless people in confusion,"},{"id":"manas-2010:p1044:b001:l019","ordinal":45595,"en":"Unable to bear one another,"},{"id":"manas-2010:p1044:b001:l020","ordinal":45596,"en":"May fall into discord."},{"id":"manas-2010:p1044:b001:l021","ordinal":45597,"en":"The many enemies lying in wait"},{"id":"manas-2010:p1044:b001:l022","ordinal":45598,"en":"My little handful of people—"},{"id":"manas-2010:p1044:b001:l023","ordinal":45599,"en":"May utterly destroy them...”"},{"id":"manas-2010:p1044:b001:l024","ordinal":45600,"en":"Saying this, Khan Manas,"},{"id":"manas-2010:p1044:b001:l025","ordinal":45601,"en":"Without taking the strap from his neck,"},{"id":"manas-2010:p1044:b001:l026","ordinal":45602,"en":"With a sudden tug, his spyglass"},{"id":"manas-2010:p1044:b001:l027","ordinal":45603,"en":"He drew from inside his robe."},{"id":"manas-2010:p1044:b001:l028","ordinal":45604,"en":"Last summer,"},{"id":"manas-2010:p1044:b001:l029","ordinal":45605,"en":"Because the spyglass had broken,"},{"id":"manas-2010:p1044:b001:l030","ordinal":45606,"en":"He had the face of the earth searched,"},{"id":"manas-2010:p1044:b001:l031","ordinal":45607,"en":"From the peoples of far-flung lands,"},{"id":"manas-2010:p1044:b001:l032","ordinal":45608,"en":"The master craftsman Bolokbai"},{"id":"manas-2010:p1044:b001:l033","ordinal":45609,"en":"Had specially had it brought."},{"id":"manas-2010:p1044:b001:l034","ordinal":45610,"en":"Bolokbai, who had come from Crimea,"},{"id":"manas-2010:p1044:b001:l035","ordinal":45611,"en":"Set things stirring when he worked the bellows;"},{"id":"manas-2010:p1044:b001:l036","ordinal":45612,"en":"He was a friend of David."},{"id":"manas-2010:p1044:b001:l037","ordinal":45613,"en":"The accomplished craftsman Bolokbai,"},{"id":"manas-2010:p1044:b001:l038","ordinal":45614,"en":"From his youth, Bolokbai"},{"id":"manas-2010:p1044:b001:l039","ordinal":45615,"en":"Had lived by his craft."},{"id":"manas-2010:p1044:b001:l040","ordinal":45616,"en":"Gazing intently day and night,"},{"id":"manas-2010:p1044:b001:l041","ordinal":45617,"en":"Fitting it precisely together,"},{"id":"manas-2010:p1044:b001:l042","ordinal":45618,"en":"He had made the great spyglass."},{"id":"manas-2010:p1045:b001:l001","ordinal":45619,"en":"He had a ruby split,"},{"id":"manas-2010:p1045:b001:l002","ordinal":45620,"en":"And set it in the glass."},{"id":"manas-2010:p1045:b001:l003","ordinal":45621,"en":"He worked long and carefully to make it right,"},{"id":"manas-2010:p1045:b001:l004","ordinal":45622,"en":"Adjusted for a six-month journey's reach."},{"id":"manas-2010:p1045:b001:l005","ordinal":45623,"en":"He had jewels set around its handle."},{"id":"manas-2010:p1045:b001:l006","ordinal":45624,"en":"“Your payment remains with me,” he said,"},{"id":"manas-2010:p1045:b001:l007","ordinal":45625,"en":"And had horses driven over as payment."},{"id":"manas-2010:p1045:b001:l008","ordinal":45626,"en":"Having come to settle in Talas,"},{"id":"manas-2010:p1045:b001:l009","ordinal":45627,"en":"Through his craftsmanship Bolokbai"},{"id":"manas-2010:p1045:b001:l010","ordinal":45628,"en":"Had become a companion of Manas."},{"id":"manas-2010:p1045:b001:l011","ordinal":45629,"en":"Made by that esteemed and gifted man,"},{"id":"manas-2010:p1045:b001:l012","ordinal":45630,"en":"The great spyglass he took in hand."},{"id":"manas-2010:p1045:b001:l013","ordinal":45631,"en":"He turned its ring,"},{"id":"manas-2010:p1045:b001:l014","ordinal":45632,"en":"Fixed his gaze intently,"},{"id":"manas-2010:p1045:b001:l015","ordinal":45633,"en":"Turned its screw,"},{"id":"manas-2010:p1045:b001:l016","ordinal":45634,"en":"Brought it round to his eye,"},{"id":"manas-2010:p1045:b001:l017","ordinal":45635,"en":"And held it there to look."},{"id":"manas-2010:p1045:b001:l018","ordinal":45636,"en":"He directed his gaze toward Talas,"},{"id":"manas-2010:p1045:b001:l019","ordinal":45637,"en":"And everything happening in Talas"},{"id":"manas-2010:p1045:b001:l020","ordinal":45638,"en":"He saw in full."},{"id":"manas-2010:p1045:b001:l021","ordinal":45639,"en":"“An ember has sprung from my own hearth!"},{"id":"manas-2010:p1045:b001:l022","ordinal":45640,"en":"While I am away at Beijing,"},{"id":"manas-2010:p1045:b001:l023","ordinal":45641,"en":"Over the many people of Talas"},{"id":"manas-2010:p1045:b001:l024","ordinal":45642,"en":"Abyke and Kobosh have made themselves lords."},{"id":"manas-2010:p1045:b001:l025","ordinal":45643,"en":"Mounting a hill, they swagger:"},{"id":"manas-2010:p1045:b001:l026","ordinal":45644,"en":"‘Now Manas is dead!"},{"id":"manas-2010:p1045:b001:l027","ordinal":45645,"en":"From Beijing, whence none return,"},{"id":"manas-2010:p1045:b001:l028","ordinal":45646,"en":"How could Manas ever come back?’"},{"id":"manas-2010:p1045:b001:l029","ordinal":45647,"en":"They climb the hill and strut,"},{"id":"manas-2010:p1045:b001:l030","ordinal":45648,"en":"Shouting toward the people."},{"id":"manas-2010:p1045:b001:l031","ordinal":45649,"en":"Abyke and Kobosh, those two scoundrels,"},{"id":"manas-2010:p1045:b001:l032","ordinal":45650,"en":"Raise the battle cry ‘Kobosh!’"},{"id":"manas-2010:p1045:b001:l033","ordinal":45651,"en":"They have run wild."},{"id":"manas-2010:p1045:b001:l034","ordinal":45652,"en":"On the Argyn and Kyrgyz of Talas"},{"id":"manas-2010:p1045:b001:l035","ordinal":45653,"en":"They have imposed a merciless levy:"},{"id":"manas-2010:p1045:b001:l036","ordinal":45654,"en":"‘Give seventy camel-loads of tea!"},{"id":"manas-2010:p1045:b001:l037","ordinal":45655,"en":"Give seven thousand yearlings suckled by barren mares!’"},{"id":"manas-2010:p1045:b001:l038","ordinal":45656,"en":"Unable to bear their taxes,"},{"id":"manas-2010:p1045:b001:l039","ordinal":45657,"en":"The Argyn have moved away."},{"id":"manas-2010:p1045:b001:l040","ordinal":45658,"en":"‘Alas, while the blood-shedding hero was here,"},{"id":"manas-2010:p1045:b001:l041","ordinal":45659,"en":"Without giving even a cup of tea,"},{"id":"manas-2010:p1045:b001:l042","ordinal":45660,"en":"Without giving a single storm-starved yearling,"},{"id":"manas-2010:p1046:b001:l001","ordinal":45661,"en":"We used to lie at ease,"},{"id":"manas-2010:p1046:b001:l002","ordinal":45662,"en":"Living splendidly in broad Talas."},{"id":"manas-2010:p1046:b001:l003","ordinal":45663,"en":"Mare's milk by day, maidens by night,"},{"id":"manas-2010:p1046:b001:l004","ordinal":45664,"en":"Playing the circle game of striking and dodging,"},{"id":"manas-2010:p1046:b001:l005","ordinal":45665,"en":"Weaned lambs and their tasty heads"},{"id":"manas-2010:p1046:b001:l006","ordinal":45666,"en":"Bubbling away at a rolling boil—"},{"id":"manas-2010:p1046:b001:l007","ordinal":45667,"en":"So we used to live in Talas."},{"id":"manas-2010:p1046:b001:l008","ordinal":45668,"en":"Since the hero Manas died,"},{"id":"manas-2010:p1046:b001:l009","ordinal":45669,"en":"Moonless, as long as a year—"},{"id":"manas-2010:p1046:b001:l010","ordinal":45670,"en":"Such is the night!"},{"id":"manas-2010:p1046:b001:l011","ordinal":45671,"en":"When power falls to a scoundrel,"},{"id":"manas-2010:p1046:b001:l012","ordinal":45672,"en":"Such is life!’ they say."},{"id":"manas-2010:p1046:b001:l013","ordinal":45673,"en":"The Kyrgyz and Nogoy have joined together,"},{"id":"manas-2010:p1046:b001:l014","ordinal":45674,"en":"And they too have fled elsewhere."},{"id":"manas-2010:p1046:b001:l015","ordinal":45675,"en":"Those men have made havoc,"},{"id":"manas-2010:p1046:b001:l016","ordinal":45676,"en":"Plundered the goods,"},{"id":"manas-2010:p1046:b001:l017","ordinal":45677,"en":"Broken into the treasury, sprawling at ease."},{"id":"manas-2010:p1046:b001:l018","ordinal":45678,"en":"For the poor, the destitute, the needy"},{"id":"manas-2010:p1046:b001:l019","ordinal":45679,"en":"They have shown no regard in their destruction."},{"id":"manas-2010:p1046:b001:l020","ordinal":45680,"en":"They have taken fine furs and beaver,"},{"id":"manas-2010:p1046:b001:l021","ordinal":45681,"en":"Divided them down the middle,"},{"id":"manas-2010:p1046:b001:l022","ordinal":45682,"en":"Without fearing the evil of such waste,"},{"id":"manas-2010:p1046:b001:l023","ordinal":45683,"en":"And used them for their trouser legs."},{"id":"manas-2010:p1046:b001:l024","ordinal":45684,"en":"Lolling like slaves whose master has died,"},{"id":"manas-2010:p1046:b001:l025","ordinal":45685,"en":"They have made themselves sultans."},{"id":"manas-2010:p1046:b001:l026","ordinal":45686,"en":"Then dear, fierce Kanykei,"},{"id":"manas-2010:p1046:b001:l027","ordinal":45687,"en":"Not twisting her rope-like hair,"},{"id":"manas-2010:p1046:b001:l028","ordinal":45688,"en":"Unable to stand there screaming in grief,"},{"id":"manas-2010:p1046:b001:l029","ordinal":45689,"en":"From her dear quail-like eyes"},{"id":"manas-2010:p1046:b001:l030","ordinal":45690,"en":"Tears fell in separate streams;"},{"id":"manas-2010:p1046:b001:l031","ordinal":45691,"en":"From her blackcurrant-dark eyes"},{"id":"manas-2010:p1046:b001:l032","ordinal":45692,"en":"Tears flowed a whip's length."},{"id":"manas-2010:p1046:b001:l033","ordinal":45693,"en":"‘When affairs go awry,"},{"id":"manas-2010:p1046:b001:l034","ordinal":45694,"en":"Such is the night!"},{"id":"manas-2010:p1046:b001:l035","ordinal":45695,"en":"When the dogs' turn comes,"},{"id":"manas-2010:p1046:b001:l036","ordinal":45696,"en":"Such is life!’ she said."},{"id":"manas-2010:p1046:b001:l037","ordinal":45697,"en":"Her long black braids"},{"id":"manas-2010:p1046:b001:l038","ordinal":45698,"en":"She bound firmly upon her crown."},{"id":"manas-2010:p1046:b001:l039","ordinal":45699,"en":"An old fur cap left at the rear camp"},{"id":"manas-2010:p1046:b001:l040","ordinal":45700,"en":"She pulled down over her head."},{"id":"manas-2010:p1046:b001:l041","ordinal":45701,"en":"On a black, white-blazed courser,"},{"id":"manas-2010:p1046:b001:l042","ordinal":45702,"en":"Kanykei in her haste"},{"id":"manas-2010:p1047:b001:l001","ordinal":45703,"en":"Leapt up bareback."},{"id":"manas-2010:p1047:b001:l002","ordinal":45704,"en":"Taking a horse-catching pole in hand,"},{"id":"manas-2010:p1047:b001:l003","ordinal":45705,"en":"She charged the six scoundrels."},{"id":"manas-2010:p1047:b001:l004","ordinal":45706,"en":"Riding the black, white-blazed courser,"},{"id":"manas-2010:p1047:b001:l005","ordinal":45707,"en":"Making it prance,"},{"id":"manas-2010:p1047:b001:l006","ordinal":45708,"en":"All those wicked men"},{"id":"manas-2010:p1047:b001:l007","ordinal":45709,"en":"She struck down and sent crawling."},{"id":"manas-2010:p1047:b001:l008","ordinal":45710,"en":"She turned her horse's head,"},{"id":"manas-2010:p1047:b001:l009","ordinal":45711,"en":"And all the wicked men"},{"id":"manas-2010:p1047:b001:l010","ordinal":45712,"en":"She drove into Talas."},{"id":"manas-2010:p1047:b001:l011","ordinal":45713,"en":"She rode down from Keng-Kol."},{"id":"manas-2010:p1047:b001:l012","ordinal":45714,"en":"All the goods they had plundered"},{"id":"manas-2010:p1047:b001:l013","ordinal":45715,"en":"She gathered up completely."},{"id":"manas-2010:p1047:b001:l014","ordinal":45716,"en":"The gold they had pillaged,"},{"id":"manas-2010:p1047:b001:l015","ordinal":45717,"en":"Kanykei gathered that too"},{"id":"manas-2010:p1047:b001:l016","ordinal":45718,"en":"And put it back in its place."},{"id":"manas-2010:p1047:b001:l017","ordinal":45719,"en":"Of the saddled courser,"},{"id":"manas-2010:p1047:b001:l018","ordinal":45720,"en":"She let no sign of its fullness show;"},{"id":"manas-2010:p1047:b001:l019","ordinal":45721,"en":"Of mountain-like Manas,"},{"id":"manas-2010:p1047:b001:l020","ordinal":45722,"en":"She let no sign of his absence show."},{"id":"manas-2010:p1047:b001:l021","ordinal":45723,"en":"Raising her head high as a banner,"},{"id":"manas-2010:p1047:b001:l022","ordinal":45724,"en":"Making herself, a woman, into a warrior—"},{"id":"manas-2010:p1047:b001:l023","ordinal":45725,"en":"When I left Talas,"},{"id":"manas-2010:p1047:b001:l024","ordinal":45726,"en":"Abyke brought disorder."},{"id":"manas-2010:p1047:b001:l025","ordinal":45727,"en":"Though a woman, Kanykei"},{"id":"manas-2010:p1047:b001:l026","ordinal":45728,"en":"Over this very Talas"},{"id":"manas-2010:p1047:b001:l027","ordinal":45729,"en":"Has taken command.”"},{"id":"manas-2010:p1047:b001:l028","ordinal":45730,"en":"After seeing this,"},{"id":"manas-2010:p1047:b001:l029","ordinal":45731,"en":"He rumbled in fury."},{"id":"manas-2010:p1047:b001:l030","ordinal":45732,"en":"Your blood-shedding leopard Manas"},{"id":"manas-2010:p1047:b001:l031","ordinal":45733,"en":"Stood watching, speaking in a low voice:"},{"id":"manas-2010:p1047:b001:l033","ordinal":45734,"en":"“After I have passed away,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"manas-2010:p1047:b001:l034","ordinal":45735,"en":"You will scatter what you gathered;"},{"id":"manas-2010:p1047:b001:l035","ordinal":45736,"en":"You will flee to your father Karakan."},{"id":"manas-2010:p1047:b001:l036","ordinal":45737,"en":"My poor one, utterly ruined!"},{"id":"manas-2010:p1047:b001:l037","ordinal":45738,"en":"When my eyes close,"},{"id":"manas-2010:p1047:b001:l038","ordinal":45739,"en":"Left without support, Kanykei,"},{"id":"manas-2010:p1047:b001:l039","ordinal":45740,"en":"You will suffer affliction;"},{"id":"manas-2010:p1047:b001:l040","ordinal":45741,"en":"You will flee toward Bukhara."},{"id":"manas-2010:p1047:b001:l041","ordinal":45742,"en":"Your forehead slopes rather low and back;"},{"id":"manas-2010:p1047:b001:l042","ordinal":45743,"en":"Your remaining days of life are few,"},{"id":"manas-2010:p1048:b001:l001","ordinal":45744,"en":"Unable to cross Zhorgo's ridge,"},{"id":"manas-2010:p1048:b001:l002","ordinal":45745,"en":"Unable to cross on foot, poor soul,"},{"id":"manas-2010:p1048:b001:l003","ordinal":45746,"en":"You will load your burden on your neck;"},{"id":"manas-2010:p1048:b001:l004","ordinal":45747,"en":"You will wail and suffer hardship."},{"id":"manas-2010:p1048:b001:l005","ordinal":45748,"en":"Dear, fierce Kanykey—"},{"id":"manas-2010:p1048:b001:l006","ordinal":45749,"en":"When Orozdu Khan's ten sons"},{"id":"manas-2010:p1048:b001:l007","ordinal":45750,"en":"Fell into discord, those bastards,"},{"id":"manas-2010:p1048:b001:l008","ordinal":45751,"en":"When they seized my spoils by force,"},{"id":"manas-2010:p1048:b001:l009","ordinal":45752,"en":"When they struck, bringing cliffs down,"},{"id":"manas-2010:p1048:b001:l010","ordinal":45753,"en":"When they intended to kill me,"},{"id":"manas-2010:p1048:b001:l011","ordinal":45754,"en":"Causing grievous suffering,"},{"id":"manas-2010:p1048:b001:l012","ordinal":45755,"en":"Having her breast shot through—"},{"id":"manas-2010:p1048:b001:l013","ordinal":45756,"en":"Dear wife Kanykey"},{"id":"manas-2010:p1048:b001:l014","ordinal":45757,"en":"Kindled my extinguished fire."},{"id":"manas-2010:p1048:b001:l015","ordinal":45758,"en":"Then she revived my dead soul;"},{"id":"manas-2010:p1048:b001:l016","ordinal":45759,"en":"The fierce woman showed her courage."},{"id":"manas-2010:p1048:b001:l017","ordinal":45760,"en":"She joined what had broken;"},{"id":"manas-2010:p1048:b001:l018","ordinal":45761,"en":"She gathered what I had scattered."},{"id":"manas-2010:p1048:b001:l019","ordinal":45762,"en":"My precious wedded Kanykey,"},{"id":"manas-2010:p1048:b001:l020","ordinal":45763,"en":"At every time, for my sake,"},{"id":"manas-2010:p1048:b001:l021","ordinal":45764,"en":"Tormented her own life."},{"id":"manas-2010:p1048:b001:l022","ordinal":45765,"en":"When Kökchököz and Közkaman"},{"id":"manas-2010:p1048:b001:l023","ordinal":45766,"en":"Came wandering from Beijing,"},{"id":"manas-2010:p1048:b001:l024","ordinal":45767,"en":"When they said, ‘I am your kinsman,’"},{"id":"manas-2010:p1048:b001:l025","ordinal":45768,"en":"When I divided and gave them their shares,"},{"id":"manas-2010:p1048:b001:l026","ordinal":45769,"en":"When they ate my fostered foal,"},{"id":"manas-2010:p1048:b001:l027","ordinal":45770,"en":"Spurring themselves, claiming equality,"},{"id":"manas-2010:p1048:b001:l028","ordinal":45771,"en":"When they said, ‘I am your equal kinsman,’"},{"id":"manas-2010:p1048:b001:l029","ordinal":45772,"en":"With grain beer fermented forty months,"},{"id":"manas-2010:p1048:b001:l030","ordinal":45773,"en":"When they gave me the deadly poison,"},{"id":"manas-2010:p1048:b001:l031","ordinal":45774,"en":"When they were about to cut off my head,"},{"id":"manas-2010:p1048:b001:l032","ordinal":45775,"en":"Those pigs, pressing close,"},{"id":"manas-2010:p1048:b001:l033","ordinal":45776,"en":"When they were about to sacrifice me,"},{"id":"manas-2010:p1048:b001:l034","ordinal":45777,"en":"Mounting Akkula and making him prance,"},{"id":"manas-2010:p1048:b001:l035","ordinal":45778,"en":"Kökchököz and Közkaman—"},{"id":"manas-2010:p1048:b001:l036","ordinal":45779,"en":"Those two fawning villains—"},{"id":"manas-2010:p1048:b001:l037","ordinal":45780,"en":"Dear, fierce Kanykey"},{"id":"manas-2010:p1048:b001:l038","ordinal":45781,"en":"Struck them down and made them crawl."},{"id":"manas-2010:p1048:b001:l039","ordinal":45782,"en":"Thus she revived my soul."},{"id":"manas-2010:p1048:b001:l040","ordinal":45783,"en":"Without illness striking, I became paralyzed;"},{"id":"manas-2010:p1048:b001:l041","ordinal":45784,"en":"Pierced in forty places,"},{"id":"manas-2010:p1048:b001:l042","ordinal":45785,"en":"I barely struggled back to life."},{"id":"manas-2010:p1049:b001:l001","ordinal":45786,"en":"After my eyes have closed,"},{"id":"manas-2010:p1049:b001:l002","ordinal":45787,"en":"Let khans die, never mind the common people;"},{"id":"manas-2010:p1049:b001:l003","ordinal":45788,"en":"Let those dogs Abyke and Köbösh die!”"},{"id":"manas-2010:p1049:b001:l004","ordinal":45789,"en":"With this, hero Manas"},{"id":"manas-2010:p1049:b001:l005","ordinal":45790,"en":"Turned toward the east."},{"id":"manas-2010:p1049:b001:l006","ordinal":45791,"en":"Aiming and adjusting his telescope,"},{"id":"manas-2010:p1049:b001:l007","ordinal":45792,"en":"He settled himself and gazed."},{"id":"manas-2010:p1049:b001:l008","ordinal":45793,"en":"Like a leopard, tiger or lion,"},{"id":"manas-2010:p1049:b001:l009","ordinal":45794,"en":"From atop the black rock,"},{"id":"manas-2010:p1049:b001:l010","ordinal":45795,"en":"He stood poised and stared."},{"id":"manas-2010:p1049:b001:l011","ordinal":45796,"en":"Emerging through the haze,"},{"id":"manas-2010:p1049:b001:l012","ordinal":45797,"en":"He saw Beijing's corner."},{"id":"manas-2010:p1049:b001:l013","ordinal":45798,"en":"Made into a fortress with towers,"},{"id":"manas-2010:p1049:b001:l014","ordinal":45799,"en":"He saw Beijing's encircling defenses."},{"id":"manas-2010:p1049:b001:l015","ordinal":45800,"en":"Seething like ants,"},{"id":"manas-2010:p1049:b001:l016","ordinal":45801,"en":"He saw Beijing's people."},{"id":"manas-2010:p1049:b001:l017","ordinal":45802,"en":"Beyond the haze,"},{"id":"manas-2010:p1049:b001:l018","ordinal":45803,"en":"With golden doors and gates,"},{"id":"manas-2010:p1049:b001:l019","ordinal":45804,"en":"He saw a court in Beijing."},{"id":"manas-2010:p1049:b001:l020","ordinal":45805,"en":"Fitted with golden horseshoes,"},{"id":"manas-2010:p1049:b001:l021","ordinal":45806,"en":"Adorned with a jeweled breastband,"},{"id":"manas-2010:p1049:b001:l022","ordinal":45807,"en":"Covered with a silken cloth,"},{"id":"manas-2010:p1049:b001:l023","ordinal":45808,"en":"He saw a pacing horse in Beijing."},{"id":"manas-2010:p1049:b001:l024","ordinal":45809,"en":"With a cliff forty cubits high,"},{"id":"manas-2010:p1049:b001:l025","ordinal":45810,"en":"And a ditch forty cubits deep,"},{"id":"manas-2010:p1049:b001:l026","ordinal":45811,"en":"He saw Beijing's moat."},{"id":"manas-2010:p1049:b001:l027","ordinal":45812,"en":"Set up to billow and sway,"},{"id":"manas-2010:p1049:b001:l028","ordinal":45813,"en":"He saw Beijing's grounds."},{"id":"manas-2010:p1049:b001:l029","ordinal":45814,"en":"Seething like a lake and river,"},{"id":"manas-2010:p1049:b001:l030","ordinal":45815,"en":"He saw Beijing's crowds."},{"id":"manas-2010:p1049:b001:l031","ordinal":45816,"en":"What so many mortals had never seen,"},{"id":"manas-2010:p1049:b001:l032","ordinal":45817,"en":"He saw wonders in Beijing."},{"id":"manas-2010:p1049:b001:l033","ordinal":45818,"en":"A black ridge stretching across,"},{"id":"manas-2010:p1049:b001:l034","ordinal":45819,"en":"He saw a mountain pass in Beijing."},{"id":"manas-2010:p1049:b001:l035","ordinal":45820,"en":"Seething everywhere like grains of sand,"},{"id":"manas-2010:p1049:b001:l036","ordinal":45821,"en":"He saw Beijing's people."},{"id":"manas-2010:p1049:b001:l037","ordinal":45822,"en":"Pied gravel slopes and red sand,"},{"id":"manas-2010:p1049:b001:l038","ordinal":45823,"en":"He saw Beijing's road."},{"id":"manas-2010:p1049:b001:l039","ordinal":45824,"en":"Great vultures wheeling with spread wings,"}]
