[{"id":"semetey-1-2013:p0790:b004:l032","ordinal":137473,"en":"It was as though brave Sultan Manas"},{"id":"semetey-1-2013:p0790:b004:l033","ordinal":137474,"en":"Were still alive."},{"id":"semetey-1-2013:p0790:b004:l034","ordinal":137475,"en":"He had grown fat and fresh,"},{"id":"semetey-1-2013:p0790:b004:l035","ordinal":137476,"en":"His strength had returned."},{"id":"semetey-1-2013:p0790:b004:l036","ordinal":137477,"en":"Before Semetey turned back,"},{"id":"semetey-1-2013:p0790:b004:l037","ordinal":137478,"en":"Before he returned from the people,"},{"id":"semetey-1-2013:p0790:b004:l038","ordinal":137479,"en":"He had pursued the wild sheep"},{"id":"semetey-1-2013:p0790:b004:l039","ordinal":137480,"en":"In the hills and torn them apart."},{"id":"semetey-1-2013:p0791:b003:l001","ordinal":137481,"en":"A spectacle to anyone who saw,"},{"id":"semetey-1-2013:p0791:b003:l002","ordinal":137482,"en":"He had performed such marvels."},{"id":"semetey-1-2013:p0791:b003:l003","ordinal":137483,"en":"The deer in the rugged country"},{"id":"semetey-1-2013:p0791:b003:l004","ordinal":137484,"en":"He drove apart and tore to pieces."},{"id":"semetey-1-2013:p0791:b003:l005","ordinal":137485,"en":"Among the wild asses in the hills"},{"id":"semetey-1-2013:p0791:b003:l006","ordinal":137486,"en":"He wrought merciless slaughter."},{"id":"semetey-1-2013:p0791:b003:l007","ordinal":137487,"en":"Poor Kumaik"},{"id":"semetey-1-2013:p0791:b003:l008","ordinal":137488,"en":"Had fully satisfied his craving."},{"id":"semetey-1-2013:p0791:b003:l009","ordinal":137489,"en":"Before the orphan and Bakai,"},{"id":"semetey-1-2013:p0791:b003:l010","ordinal":137490,"en":"When Kumaik came running,"},{"id":"semetey-1-2013:p0791:b003:l011","ordinal":137491,"en":"His coat had filled out like a beaver's."},{"id":"semetey-1-2013:p0791:b003:l012","ordinal":137492,"en":"It was as though magnanimous,"},{"id":"semetey-1-2013:p0791:b003:l013","ordinal":137493,"en":"Brave Manas were still alive."},{"id":"semetey-1-2013:p0791:b003:l014","ordinal":137494,"en":"When Kumaik howled,"},{"id":"semetey-1-2013:p0791:b003:l015","ordinal":137495,"en":"His voice equaled a lion's."},{"id":"semetey-1-2013:p0791:b003:l016","ordinal":137496,"en":"That legacy left by Manas"},{"id":"semetey-1-2013:p0791:b003:l017","ordinal":137497,"en":"Had fur that shimmered in three shades."},{"id":"semetey-1-2013:p0791:b003:l018","ordinal":137498,"en":"When the orphan looked again,"},{"id":"semetey-1-2013:p0791:b003:l019","ordinal":137499,"en":"He had the appearance of a lion,"},{"id":"semetey-1-2013:p0791:b003:l020","ordinal":137500,"en":"A steel collar round his neck."},{"id":"semetey-1-2013:p0791:b003:l021","ordinal":137501,"en":"‘My mother remained behind in tears,"},{"id":"semetey-1-2013:p0791:b003:l022","ordinal":137502,"en":"Saying, “Bring Kumaik with you.”"},{"id":"semetey-1-2013:p0791:b003:l023","ordinal":137503,"en":"She entrusted that task to me."},{"id":"semetey-1-2013:p0791:b003:l024","ordinal":137504,"en":"Elder Bakai, hear my words!"},{"id":"semetey-1-2013:p0791:b003:l025","ordinal":137505,"en":"It would be a disgrace to leave him."},{"id":"semetey-1-2013:p0791:b003:l026","ordinal":137506,"en":"To my dear mother"},{"id":"semetey-1-2013:p0791:b003:l027","ordinal":137507,"en":"Let me bring what she entrusted to me."},{"id":"semetey-1-2013:p0791:b003:l028","ordinal":137508,"en":"It was my mother's request:"},{"id":"semetey-1-2013:p0791:b003:l029","ordinal":137509,"en":"“Bring him with you,” she said,"},{"id":"semetey-1-2013:p0791:b003:l030","ordinal":137510,"en":"“Let me see him with my own eyes.”"},{"id":"semetey-1-2013:p0791:b003:l031","ordinal":137511,"en":"Let me take Kumaik with me,"},{"id":"semetey-1-2013:p0791:b003:l032","ordinal":137512,"en":"To my poor, unhappy mother,"},{"id":"semetey-1-2013:p0791:b003:l033","ordinal":137513,"en":"For the milk of her breast,"},{"id":"semetey-1-2013:p0791:b003:l034","ordinal":137514,"en":"Let me repay at least a little of my debt."},{"id":"semetey-1-2013:p0791:b003:l035","ordinal":137515,"en":"Finding Kumaik, he called on God;"},{"id":"semetey-1-2013:p0791:b003:l036","ordinal":137516,"en":"The poor orphan thought of this."},{"id":"semetey-1-2013:p0791:b003:l037","ordinal":137517,"en":"All the valleys and mountains"},{"id":"semetey-1-2013:p0791:b003:l038","ordinal":137518,"en":"Seemed to be running,"},{"id":"semetey-1-2013:p0791:b003:l039","ordinal":137519,"en":"His father Sultan Manas"},{"id":"semetey-1-2013:p0791:b004:l001","ordinal":137520,"en":"Seemed to have risen from the dead."},{"id":"semetey-1-2013:p0791:b004:l002","ordinal":137521,"en":"Brave Bakai, who led him,"},{"id":"semetey-1-2013:p0791:b004:l003","ordinal":137522,"en":"Urged his horse onward from there."},{"id":"semetey-1-2013:p0791:b004:l004","ordinal":137523,"en":"There were pools among the marshes,"},{"id":"semetey-1-2013:p0791:b004:l005","ordinal":137524,"en":"Geese rising in separate flocks."},{"id":"semetey-1-2013:p0791:b004:l006","ordinal":137525,"en":"The pintails swayed,"},{"id":"semetey-1-2013:p0791:b004:l007","ordinal":137526,"en":"The creatures lay there."},{"id":"semetey-1-2013:p0791:b004:l008","ordinal":137527,"en":"The red-headed ducks bobbed,"},{"id":"semetey-1-2013:p0791:b004:l009","ordinal":137528,"en":"The clear streams branched,"},{"id":"semetey-1-2013:p0791:b004:l010","ordinal":137529,"en":"Spread out in separate channels."},{"id":"semetey-1-2013:p0791:b004:l011","ordinal":137530,"en":"Migrant swans, geese and ducks,"},{"id":"semetey-1-2013:p0791:b004:l012","ordinal":137531,"en":"All confined, unable to fly,"},{"id":"semetey-1-2013:p0791:b004:l013","ordinal":137532,"en":"Those creatures lay there."},{"id":"semetey-1-2013:p0791:b004:l014","ordinal":137533,"en":"From the ridge above,"},{"id":"semetey-1-2013:p0791:b004:l015","ordinal":137534,"en":"Another marvel came into sight."},{"id":"semetey-1-2013:p0791:b004:l016","ordinal":137535,"en":"When Bakai saw it,"},{"id":"semetey-1-2013:p0791:b004:l017","ordinal":137536,"en":"The tears poured from his eyes."},{"id":"semetey-1-2013:p0791:b004:l018","ordinal":137537,"en":"What could your poor elder do?"},{"id":"semetey-1-2013:p0791:b004:l019","ordinal":137538,"en":"From his dear quail-like eyes"},{"id":"semetey-1-2013:p0791:b004:l020","ordinal":137539,"en":"Tears fell drop by drop."},{"id":"semetey-1-2013:p0791:b004:l021","ordinal":137540,"en":"From his dear blackcurrant eyes"},{"id":"semetey-1-2013:p0791:b004:l022","ordinal":137541,"en":"Tears streamed a whip's length."},{"id":"semetey-1-2013:p0791:b004:l023","ordinal":137542,"en":"Your elder, King Bakai,"},{"id":"semetey-1-2013:p0791:b004:l024","ordinal":137543,"en":"Was sorely moved at heart."},{"id":"semetey-1-2013:p0791:b004:l025","ordinal":137544,"en":"Khan Manas's Akshumkar,"},{"id":"semetey-1-2013:p0791:b004:l026","ordinal":137545,"en":"Saying, ‘His son will come today,’"},{"id":"semetey-1-2013:p0791:b004:l027","ordinal":137546,"en":"Seemed to be waiting to meet him."},{"id":"semetey-1-2013:p0791:b004:l028","ordinal":137547,"en":"That day Akshumkar"},{"id":"semetey-1-2013:p0791:b004:l029","ordinal":137548,"en":"Had blocked the mountain pass."},{"id":"semetey-1-2013:p0791:b004:l030","ordinal":137549,"en":"Among migrant swans and migrant geese"},{"id":"semetey-1-2013:p0791:b004:l031","ordinal":137550,"en":"He had wrought a marvelous slaughter,"},{"id":"semetey-1-2013:p0791:b004:l032","ordinal":137551,"en":"For Manas, who had gone to Judgment,"},{"id":"semetey-1-2013:p0791:b004:l033","ordinal":137552,"en":"It had honored his spirit."},{"id":"semetey-1-2013:p0791:b004:l034","ordinal":137553,"en":"‘Surely the orphan will come,’ he said,"},{"id":"semetey-1-2013:p0791:b004:l035","ordinal":137554,"en":"And waited upon his path."},{"id":"semetey-1-2013:p0791:b004:l036","ordinal":137555,"en":"God had granted his desire."},{"id":"semetey-1-2013:p0791:b004:l037","ordinal":137556,"en":"His fully fledged young one"},{"id":"semetey-1-2013:p0791:b004:l038","ordinal":137557,"en":"It had brought to the poplar."},{"id":"semetey-1-2013:p0791:b004:l039","ordinal":137558,"en":"‘The orphan at twelve,"},{"id":"semetey-1-2013:p0792:b003:l001","ordinal":137559,"en":"I shall fly and see him with my own eyes."},{"id":"semetey-1-2013:p0792:b003:l002","ordinal":137560,"en":"His father was Manas, the magnanimous lion."},{"id":"semetey-1-2013:p0792:b003:l003","ordinal":137561,"en":"Honoring Manas's spirit,"},{"id":"semetey-1-2013:p0792:b003:l004","ordinal":137562,"en":"My child to his child,"},{"id":"semetey-1-2013:p0792:b003:l005","ordinal":137563,"en":"I shall entrust,’ it said,"},{"id":"semetey-1-2013:p0792:b003:l006","ordinal":137564,"en":"And had now come."},{"id":"semetey-1-2013:p0792:b003:l007","ordinal":137565,"en":"Of that precious falcon,"},{"id":"semetey-1-2013:p0792:b003:l008","ordinal":137566,"en":"Such was the thought."},{"id":"semetey-1-2013:p0792:b003:l009","ordinal":137567,"en":"Do you see how it beats its wings—"},{"id":"semetey-1-2013:p0792:b003:l010","ordinal":137568,"en":"Its chick upon the plane tree?"},{"id":"semetey-1-2013:p0792:b003:l011","ordinal":137569,"en":"This orphan standing here"},{"id":"semetey-1-2013:p0792:b003:l012","ordinal":137570,"en":"Was favored in God's sight."},{"id":"semetey-1-2013:p0792:b003:l013","ordinal":137571,"en":"The young one was far larger"},{"id":"semetey-1-2013:p0792:b003:l014","ordinal":137572,"en":"Than its mother."},{"id":"semetey-1-2013:p0792:b003:l015","ordinal":137573,"en":"Its talons steel, its jess-fastener copper,"},{"id":"semetey-1-2013:p0792:b003:l016","ordinal":137574,"en":"Two kez around,"},{"id":"semetey-1-2013:p0792:b003:l017","ordinal":137575,"en":"His eyes are black, his legs blue-speckled."},{"id":"semetey-1-2013:p0792:b003:l018","ordinal":137576,"en":"It would not retreat from anything it saw."},{"id":"semetey-1-2013:p0792:b003:l019","ordinal":137577,"en":"Akshumkar, left by Manas,"},{"id":"semetey-1-2013:p0792:b003:l020","ordinal":137578,"en":"Had hatched and reared a splendid bird,"},{"id":"semetey-1-2013:p0792:b003:l021","ordinal":137579,"en":"By Allah's command the falcon"},{"id":"semetey-1-2013:p0792:b003:l022","ordinal":137580,"en":"Was brought to Semetey."},{"id":"semetey-1-2013:p0792:b003:l023","ordinal":137581,"en":"It was a bird to carry with him,"},{"id":"semetey-1-2013:p0792:b003:l024","ordinal":137582,"en":"A possession left by Manas."},{"id":"semetey-1-2013:p0792:b003:l025","ordinal":137583,"en":"Honoring Manas, Akshumkar"},{"id":"semetey-1-2013:p0792:b003:l026","ordinal":137584,"en":"Had come to give his young one,"},{"id":"semetey-1-2013:p0792:b003:l027","ordinal":137585,"en":"To give and entrust his young one,"},{"id":"semetey-1-2013:p0792:b003:l028","ordinal":137586,"en":"And then Akshumkar"},{"id":"semetey-1-2013:p0792:b003:l029","ordinal":137587,"en":"Would attain his desire."},{"id":"semetey-1-2013:p0792:b003:l030","ordinal":137588,"en":"Akshumkar's young one"},{"id":"semetey-1-2013:p0792:b003:l031","ordinal":137589,"en":"Had filled out its breast feathers."},{"id":"semetey-1-2013:p0792:b003:l032","ordinal":137590,"en":"Flew as though driven by whips."},{"id":"semetey-1-2013:p0792:b003:l033","ordinal":137591,"en":"Its wings had rounded out."},{"id":"semetey-1-2013:p0792:b003:l034","ordinal":137592,"en":"With no tongue to say what it wished,"},{"id":"semetey-1-2013:p0792:b003:l035","ordinal":137593,"en":"Wise, intelligent Akshumkar"},{"id":"semetey-1-2013:p0792:b003:l036","ordinal":137594,"en":"Geese, cranes and migrant swans"},{"id":"semetey-1-2013:p0792:b003:l037","ordinal":137595,"en":"He had gathered for food."},{"id":"semetey-1-2013:p0792:b003:l038","ordinal":137596,"en":"The geese and ducks penned there,"},{"id":"semetey-1-2013:p0792:b003:l039","ordinal":137597,"en":"At the sight of the falcon,"},{"id":"semetey-1-2013:p0792:b004:l001","ordinal":137598,"en":"Were frightened out of their senses."},{"id":"semetey-1-2013:p0792:b004:l002","ordinal":137599,"en":"None would raise its head;"},{"id":"semetey-1-2013:p0792:b004:l003","ordinal":137600,"en":"Each thrust its head into the water."},{"id":"semetey-1-2013:p0792:b004:l004","ordinal":137601,"en":"The rush of wings was heard;"},{"id":"semetey-1-2013:p0792:b004:l005","ordinal":137602,"en":"They tumbled this way and that,"},{"id":"semetey-1-2013:p0792:b004:l006","ordinal":137603,"en":"Their heads buried in the waterweed,"},{"id":"semetey-1-2013:p0792:b004:l007","ordinal":137604,"en":"Those living creatures remained there."},{"id":"semetey-1-2013:p0792:b004:l008","ordinal":137605,"en":"Your valiant orphan received him;"},{"id":"semetey-1-2013:p0792:b004:l009","ordinal":137606,"en":"What had broken was joined,"},{"id":"semetey-1-2013:p0792:b004:l010","ordinal":137607,"en":"What had scattered was gathered."},{"id":"semetey-1-2013:p0792:b004:l011","ordinal":137608,"en":"What had been lost was found,"},{"id":"semetey-1-2013:p0792:b004:l012","ordinal":137609,"en":"His honor was restored."},{"id":"semetey-1-2013:p0792:b004:l013","ordinal":137610,"en":"When he received Akshumkar,"},{"id":"semetey-1-2013:p0792:b004:l014","ordinal":137611,"en":"All the valleys and mountains"},{"id":"semetey-1-2013:p0792:b004:l015","ordinal":137612,"en":"Seemed to be running;"},{"id":"semetey-1-2013:p0792:b004:l016","ordinal":137613,"en":"His father, gone to the other world,"},{"id":"semetey-1-2013:p0792:b004:l017","ordinal":137614,"en":"Seemed to have risen from the dead."},{"id":"semetey-1-2013:p0792:b004:l018","ordinal":137615,"en":"His fierce elder Bakai,"},{"id":"semetey-1-2013:p0792:b004:l019","ordinal":137616,"en":"The old man who had seen much—"},{"id":"semetey-1-2013:p0792:b004:l020","ordinal":137617,"en":"See his readiness!"},{"id":"semetey-1-2013:p0792:b004:l021","ordinal":137618,"en":"Of your sage elder Bakai,"},{"id":"semetey-1-2013:p0792:b004:l022","ordinal":137619,"en":"See the resourcefulness!"},{"id":"semetey-1-2013:p0792:b004:l023","ordinal":137620,"en":"Without many words, without speaking,"},{"id":"semetey-1-2013:p0792:b004:l024","ordinal":137621,"en":"The old caravan-leader Bakai,"},{"id":"semetey-1-2013:p0792:b004:l025","ordinal":137622,"en":"The sage who had seen so much,"},{"id":"semetey-1-2013:p0792:b004:l026","ordinal":137623,"en":"From his belt-pouch"},{"id":"semetey-1-2013:p0792:b004:l027","ordinal":137624,"en":"Your elder took a cord."},{"id":"semetey-1-2013:p0792:b004:l028","ordinal":137625,"en":"It was a cord plaited of silk;"},{"id":"semetey-1-2013:p0792:b004:l029","ordinal":137626,"en":"He fastened it to Akshumkar."},{"id":"semetey-1-2013:p0792:b004:l030","ordinal":137627,"en":"While Bakai was doing this,"},{"id":"semetey-1-2013:p0792:b004:l031","ordinal":137628,"en":"That brave son of Manas said:"},{"id":"semetey-1-2013:p0792:b004:l032","ordinal":137629,"en":"‘Since God Most High has granted this,"},{"id":"semetey-1-2013:p0792:b004:l033","ordinal":137630,"en":"Since Akshumkar has come from his hidden realm,"},{"id":"semetey-1-2013:p0792:b004:l034","ordinal":137631,"en":"Bringing his young one,"},{"id":"semetey-1-2013:p0792:b004:l035","ordinal":137632,"en":"How can we hold anything back?"},{"id":"semetey-1-2013:p0792:b004:l036","ordinal":137633,"en":"My father, who went to the other world—"},{"id":"semetey-1-2013:p0792:b004:l037","ordinal":137634,"en":"Dedicating it to his spirit,"},{"id":"semetey-1-2013:p0792:b004:l038","ordinal":137635,"en":"Let us dedicate Aktulpar as a sacrifice.’"},{"id":"semetey-1-2013:p0792:b004:l039","ordinal":137636,"en":"When he mentioned Aktulpar,"},{"id":"semetey-1-2013:p0793:b003:l001","ordinal":137637,"en":"As though pierced by an awl,"},{"id":"semetey-1-2013:p0793:b003:l002","ordinal":137638,"en":"Brave Bakai sprang up:"},{"id":"semetey-1-2013:p0793:b003:l003","ordinal":137639,"en":"‘Alas, orphan, heed me!"},{"id":"semetey-1-2013:p0793:b003:l004","ordinal":137640,"en":"If you do not, it will be a disgrace."},{"id":"semetey-1-2013:p0793:b003:l005","ordinal":137641,"en":"Out of fear, your grandfather"},{"id":"semetey-1-2013:p0793:b003:l006","ordinal":137642,"en":"Entrusted Aktulpar to you."},{"id":"semetey-1-2013:p0793:b003:l007","ordinal":137643,"en":"If we slaughter the horse entrusted to us,"},{"id":"semetey-1-2013:p0793:b003:l008","ordinal":137644,"en":"If we put him to death,"},{"id":"semetey-1-2013:p0793:b003:l009","ordinal":137645,"en":"How can we prosper?"},{"id":"semetey-1-2013:p0793:b003:l010","ordinal":137646,"en":"We shall be a laughingstock to the people."},{"id":"semetey-1-2013:p0793:b003:l011","ordinal":137647,"en":"Your grandfather Temirkan"},{"id":"semetey-1-2013:p0793:b003:l012","ordinal":137648,"en":"Bears the name of father;"},{"id":"semetey-1-2013:p0793:b003:l013","ordinal":137649,"en":"Once we slaughter his horse,"},{"id":"semetey-1-2013:p0793:b003:l014","ordinal":137650,"en":"He may curse us."},{"id":"semetey-1-2013:p0793:b003:l015","ordinal":137651,"en":"Once you slaughter his horse,"},{"id":"semetey-1-2013:p0793:b003:l016","ordinal":137652,"en":"It will be a great shame.’"},{"id":"semetey-1-2013:p0793:b003:l017","ordinal":137653,"en":"Then Bakai said:"},{"id":"semetey-1-2013:p0793:b003:l018","ordinal":137654,"en":"‘Let me tell the story of this Aktulpar."},{"id":"semetey-1-2013:p0793:b003:l019","ordinal":137655,"en":"Your grandfather Temirkan,"},{"id":"semetey-1-2013:p0793:b003:l020","ordinal":137656,"en":"Who ruled Bukhara,"},{"id":"semetey-1-2013:p0793:b003:l021","ordinal":137657,"en":"Was a famous, splendid khan,"},{"id":"semetey-1-2013:p0793:b003:l022","ordinal":137658,"en":"But he was miserly with livestock."},{"id":"semetey-1-2013:p0793:b003:l023","ordinal":137659,"en":"Born to your elder,"},{"id":"semetey-1-2013:p0793:b003:l024","ordinal":137660,"en":"Beginning with your mother Kanykei,"},{"id":"semetey-1-2013:p0793:b003:l025","ordinal":137661,"en":"There were twelve daughters."},{"id":"semetey-1-2013:p0793:b003:l026","ordinal":137662,"en":"Among all the people"},{"id":"semetey-1-2013:p0793:b003:l027","ordinal":137663,"en":"He had spread his offspring."},{"id":"semetey-1-2013:p0793:b003:l028","ordinal":137664,"en":"The eldest of his daughters,"},{"id":"semetey-1-2013:p0793:b003:l029","ordinal":137665,"en":"The beauty among his daughters,"},{"id":"semetey-1-2013:p0793:b003:l030","ordinal":137666,"en":"With a waist like a sheath, a face like the moon,"},{"id":"semetey-1-2013:p0793:b003:l031","ordinal":137667,"en":"The renowned beauty Akerkech"},{"id":"semetey-1-2013:p0793:b003:l032","ordinal":137668,"en":"Was Kökchö's wife."},{"id":"semetey-1-2013:p0793:b003:l033","ordinal":137669,"en":"She was the finest of women,"},{"id":"semetey-1-2013:p0793:b003:l034","ordinal":137670,"en":"Temirkan's firstborn daughter."},{"id":"semetey-1-2013:p0793:b003:l036","ordinal":137671,"en":"Bringing eighty breeding she-camels,"},{"id":"semetey-1-2013:p0793:b003:l037","ordinal":137672,"en":"Akerkech once pleaded in distress"},{"id":"semetey-1-2013:p0793:b003:l038","ordinal":137673,"en":"And asked for Aktulpar."},{"id":"semetey-1-2013:p0793:b003:l039","ordinal":137674,"en":"He would not give Aktulpar;"},{"id":"semetey-1-2013:p0793:b005:l001","ordinal":137675,"en":"He would not consent to her request."},{"id":"semetey-1-2013:p0793:b005:l002","ordinal":137676,"en":"Because of Aktulpar,"},{"id":"semetey-1-2013:p0793:b005:l003","ordinal":137677,"en":"That daughter went away and became estranged."},{"id":"semetey-1-2013:p0793:b005:l004","ordinal":137678,"en":"Burulkan, whom Muzburchak married,"},{"id":"semetey-1-2013:p0793:b005:l005","ordinal":137679,"en":"Was also his daughter."},{"id":"semetey-1-2013:p0793:b005:l006","ordinal":137680,"en":"Because of what happened,"},{"id":"semetey-1-2013:p0793:b005:l007","ordinal":137681,"en":"Over the matter of Aktulpar,"},{"id":"semetey-1-2013:p0793:b005:l008","ordinal":137682,"en":"That daughter too went away and became estranged."},{"id":"semetey-1-2013:p0793:b005:l009","ordinal":137683,"en":"Ormonbek of Tekeche,"},{"id":"semetey-1-2013:p0793:b005:l010","ordinal":137684,"en":"And Oiumkan, whom Ormonbek married—"},{"id":"semetey-1-2013:p0793:b005:l011","ordinal":137685,"en":"Ormonbek was his son-in-law."},{"id":"semetey-1-2013:p0793:b005:l012","ordinal":137686,"en":"Temirkan had thus stood in the way;"},{"id":"semetey-1-2013:p0793:b005:l013","ordinal":137687,"en":"Because of Aktulpar,"},{"id":"semetey-1-2013:p0793:b005:l014","ordinal":137688,"en":"That son-in-law became estranged."},{"id":"semetey-1-2013:p0793:b005:l015","ordinal":137689,"en":"Stop, orphan, hear my words."},{"id":"semetey-1-2013:p0793:b005:l016","ordinal":137690,"en":"They bound up their pinewood spears;"},{"id":"semetey-1-2013:p0793:b005:l017","ordinal":137691,"en":"Because of Aktulpar,"},{"id":"semetey-1-2013:p0793:b005:l018","ordinal":137692,"en":"Against that very Temirkan"},{"id":"semetey-1-2013:p0793:b005:l019","ordinal":137693,"en":"Twelve sons-in-law made war."},{"id":"semetey-1-2013:p0793:b005:l020","ordinal":137694,"en":"They parted in resentment."},{"id":"semetey-1-2013:p0793:b005:l021","ordinal":137695,"en":"They died without looking upon one another."},{"id":"semetey-1-2013:p0793:b005:l022","ordinal":137696,"en":"When your khan father was alive,"},{"id":"semetey-1-2013:p0793:b005:l023","ordinal":137697,"en":"When prosperity endured,"},{"id":"semetey-1-2013:p0793:b005:l024","ordinal":137698,"en":"We heard a rumor from the people:"},{"id":"semetey-1-2013:p0793:b005:l025","ordinal":137699,"en":"The golden-forelocked, fiery-belted"},{"id":"semetey-1-2013:p0793:b005:l026","ordinal":137700,"en":"Only son of Khan Azozil,"},{"id":"semetey-1-2013:p0793:b005:l027","ordinal":137701,"en":"For the sake of his faith,"},{"id":"semetey-1-2013:p0793:b005:l028","ordinal":137702,"en":"Had fled his people and wandered;"},{"id":"semetey-1-2013:p0793:b005:l029","ordinal":137703,"en":"He had disputed the khanship in Beijing,"},{"id":"semetey-1-2013:p0793:b005:l030","ordinal":137704,"en":"They had fiercely pitted strength against strength."},{"id":"semetey-1-2013:p0793:b005:l031","ordinal":137705,"en":"Many Chinese giants had died,"},{"id":"semetey-1-2013:p0793:b005:l032","ordinal":137706,"en":"They had shed blood."},{"id":"semetey-1-2013:p0793:b005:l033","ordinal":137707,"en":"Who had scattered his gathered wealth,"},{"id":"semetey-1-2013:p0793:b005:l034","ordinal":137708,"en":"Desiring faith alone,"},{"id":"semetey-1-2013:p0793:b005:l035","ordinal":137709,"en":"To Kakan Chin’s Beijing,"},{"id":"semetey-1-2013:p0793:b005:l036","ordinal":137710,"en":"We heard he had brought turmoil."},{"id":"semetey-1-2013:p0793:b005:l037","ordinal":137711,"en":"Having strayed thus from his people,"},{"id":"semetey-1-2013:p0793:b005:l038","ordinal":137712,"en":"We quarreled fiercely:"},{"id":"semetey-1-2013:p0793:b005:l039","ordinal":137713,"en":"“There is no one who understands this of mine,"},{"id":"semetey-1-2013:p0794:b003:l001","ordinal":137714,"en":"Why should I remain here?” he said."},{"id":"semetey-1-2013:p0794:b003:l002","ordinal":137715,"en":"“I shall go among the Burut,” he said."},{"id":"semetey-1-2013:p0794:b003:l003","ordinal":137716,"en":"He killed his own father,"},{"id":"semetey-1-2013:p0794:b003:l004","ordinal":137717,"en":"His mother passed away a martyr."},{"id":"semetey-1-2013:p0794:b003:l005","ordinal":137718,"en":"We heard that, turning away from China,"},{"id":"semetey-1-2013:p0794:b003:l006","ordinal":137719,"en":"He entered Khangai."},{"id":"semetey-1-2013:p0794:b003:l007","ordinal":137720,"en":"Unable to gain a foothold in Khangai,"},{"id":"semetey-1-2013:p0794:b003:l008","ordinal":137721,"en":"He slaughtered and destroyed its khans;"},{"id":"semetey-1-2013:p0794:b003:l009","ordinal":137722,"en":"We heard he came out again."},{"id":"semetey-1-2013:p0794:b003:l010","ordinal":137723,"en":"From there, driven onward,"},{"id":"semetey-1-2013:p0794:b003:l011","ordinal":137724,"en":"We heard he came to Altai."},{"id":"semetey-1-2013:p0794:b003:l012","ordinal":137725,"en":"Unable to find room in Altai,"},{"id":"semetey-1-2013:p0794:b003:l013","ordinal":137726,"en":"He killed Khan Artyk;"},{"id":"semetey-1-2013:p0794:b003:l014","ordinal":137727,"en":"We heard he came to Sary-Arka."},{"id":"semetey-1-2013:p0794:b003:l015","ordinal":137728,"en":"When he reached Kökchö in Sary-Arka"}]
