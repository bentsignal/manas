{"id": "sayakbay-ms-current142:pdf026:l064", "source_id": "sayakbay-ms-current142", "pdf_sha256": "2b1fd33d35b9fec662724180743e44a26bc44d8b347d5f99c373acf98cb6c73f", "page": 26, "folio": 2343, "line_in_page": 64, "raw": "Кайгыланып баштап калды,", "text": "Кайгыланып баштап калды,", "en": "He was left grieving,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Bottom-edge line is partially cut off.", "bbox": null}
