{"id":"seytek-2012:p0144:b002:l019","ordinal":304877,"en":"There was a lot of noise,"},{"id":"seytek-2012:p0144:b002:l020","ordinal":304878,"en":"It was terrible, my dear."},{"id":"seytek-2012:p0144:b002:l021","ordinal":304879,"en":"Lose the bound waist,"},{"id":"seytek-2012:p0144:b002:l022","ordinal":304880,"en":"The air that gave me was gone,"},{"id":"seytek-2012:p0144:b002:l023","ordinal":304881,"en":"I landed along the river,"},{"id":"seytek-2012:p0144:b002:l024","ordinal":304882,"en":"I was too shy,"},{"id":"seytek-2012:p0144:b002:l025","ordinal":304883,"en":"I can't see, I'm sad"},{"id":"seytek-2012:p0144:b002:l026","ordinal":304884,"en":"Blood loss,"},{"id":"seytek-2012:p0144:b002:l027","ordinal":304885,"en":"Our poor food,"},{"id":"seytek-2012:p0144:b002:l028","ordinal":304886,"en":"Our lost head."},{"id":"seytek-2012:p0144:b002:l029","ordinal":304887,"en":"This is the fuel that raises"},{"id":"seytek-2012:p0144:b002:l030","ordinal":304888,"en":"A typical water day,"},{"id":"seytek-2012:p0144:b002:l031","ordinal":304889,"en":"Our blood that is guarded,"},{"id":"seytek-2012:p0144:b002:l032","ordinal":304890,"en":"A spoonful of our blood,"},{"id":"seytek-2012:p0144:b002:l033","ordinal":304891,"en":"We will be born and die"},{"id":"seytek-2012:p0144:b002:l034","ordinal":304892,"en":"Our mother is in mourning."},{"id":"seytek-2012:p0144:b002:l035","ordinal":304893,"en":"Our deserted Talas land,"},{"id":"seytek-2012:p0144:b002:l036","ordinal":304894,"en":"Our back was broken a long time ago."},{"id":"seytek-2012:p0144:b002:l037","ordinal":304895,"en":"Lost in the lake,"},{"id":"seytek-2012:p0144:b002:l038","ordinal":304896,"en":"We are clay,"}]
