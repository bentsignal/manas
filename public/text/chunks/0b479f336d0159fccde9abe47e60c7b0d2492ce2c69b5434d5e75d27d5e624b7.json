[{"id":"semetey-1-2013:p1068:b004:l021","ordinal":157697,"en":"He brought turmoil upon us"},{"id":"semetey-1-2013:p1068:b004:l022","ordinal":157698,"en":"And came contending for Chürök."},{"id":"semetey-1-2013:p1068:b004:l023","ordinal":157699,"en":"When they laid a foul siege,"},{"id":"semetey-1-2013:p1068:b004:l024","ordinal":157700,"en":"And Toltoy of the Zhediger"},{"id":"semetey-1-2013:p1068:b004:l025","ordinal":157701,"en":"Slaughtered every person"},{"id":"semetey-1-2013:p1068:b004:l026","ordinal":157702,"en":"Who ventured outside,"},{"id":"semetey-1-2013:p1068:b004:l027","ordinal":157703,"en":"We stood and raced our horses;"},{"id":"semetey-1-2013:p1068:b004:l028","ordinal":157704,"en":"Because of you, Aychürök,"},{"id":"semetey-1-2013:p1068:b004:l029","ordinal":157705,"en":"We fired guns and drew bows,"},{"id":"semetey-1-2013:p1068:b004:l030","ordinal":157706,"en":"And stood fighting without fleeing!"},{"id":"semetey-1-2013:p1068:b004:l031","ordinal":157707,"en":"We held our ground for nine months;"},{"id":"semetey-1-2013:p1068:b004:l032","ordinal":157708,"en":"For nine days we fought without rest."},{"id":"semetey-1-2013:p1068:b004:l033","ordinal":157709,"en":"With teeth jutting out,"},{"id":"semetey-1-2013:p1068:b004:l034","ordinal":157710,"en":"Horse corpses became a mountain;"},{"id":"semetey-1-2013:p1068:b004:l035","ordinal":157711,"en":"With mustaches drooping,"},{"id":"semetey-1-2013:p1068:b004:l036","ordinal":157712,"en":"Men's corpses became bundled heaps."},{"id":"semetey-1-2013:p1068:b004:l037","ordinal":157713,"en":"Many formidable beks died;"},{"id":"semetey-1-2013:p1068:b004:l038","ordinal":157714,"en":"Many innocent people died."},{"id":"semetey-1-2013:p1068:b004:l039","ordinal":157715,"en":"Demanding, 'Give us Aychürök,'"},{"id":"semetey-1-2013:p1069:b003:l001","ordinal":157716,"en":"Saying, 'Agree to what I say,'"},{"id":"semetey-1-2013:p1069:b003:l002","ordinal":157717,"en":"They came and overran us again;"},{"id":"semetey-1-2013:p1069:b003:l003","ordinal":157718,"en":"When death drew near,"},{"id":"semetey-1-2013:p1069:b003:l004","ordinal":157719,"en":"When all our strength was gone,"},{"id":"semetey-1-2013:p1069:b003:l005","ordinal":157720,"en":"They would not let us prepare Shamyyan,"},{"id":"semetey-1-2013:p1069:b003:l006","ordinal":157721,"en":"Would not let us plow crops into the earth,"},{"id":"semetey-1-2013:p1069:b003:l007","ordinal":157722,"en":"Would not let us break the earth's surface,"},{"id":"semetey-1-2013:p1069:b003:l008","ordinal":157723,"en":"Would not let us scatter a handful of seed."},{"id":"semetey-1-2013:p1069:b003:l009","ordinal":157724,"en":"After they laid their foul siege,"},{"id":"semetey-1-2013:p1069:b003:l010","ordinal":157725,"en":"After they made all pleasure costly,"},{"id":"semetey-1-2013:p1069:b003:l011","ordinal":157726,"en":"After they slaughtered the people without looking back,"},{"id":"semetey-1-2013:p1069:b003:l012","ordinal":157727,"en":"It is true that I resolved to agree"},{"id":"semetey-1-2013:p1069:b003:l013","ordinal":157728,"en":"So the people might be saved!"},{"id":"semetey-1-2013:p1069:b003:l014","ordinal":157729,"en":"It is true that I meant"},{"id":"semetey-1-2013:p1069:b003:l015","ordinal":157730,"en":"To bind you and take you"},{"id":"semetey-1-2013:p1069:b003:l016","ordinal":157731,"en":"To Toltoy of the Zhediger!"},{"id":"semetey-1-2013:p1069:b003:l017","ordinal":157732,"en":"Corruption has entered your mind;"},{"id":"semetey-1-2013:p1069:b003:l018","ordinal":157733,"en":"Do not bring disgrace"},{"id":"semetey-1-2013:p1069:b003:l019","ordinal":157734,"en":"Before your renowned princely husband."},{"id":"semetey-1-2013:p1069:b003:l020","ordinal":157735,"en":"Who will believe your words?"},{"id":"semetey-1-2013:p1069:b003:l021","ordinal":157736,"en":"Stop playing coy with your husband."},{"id":"semetey-1-2013:p1069:b003:l022","ordinal":157737,"en":"If suffering comes upon me,"},{"id":"semetey-1-2013:p1069:b003:l023","ordinal":157738,"en":"I have my Argyn people and my own strength"},{"id":"semetey-1-2013:p1069:b003:l024","ordinal":157739,"en":"To charge forth and make war."},{"id":"semetey-1-2013:p1069:b003:l025","ordinal":157740,"en":"You are my lawfully wedded wife in my embrace;"},{"id":"semetey-1-2013:p1069:b003:l026","ordinal":157741,"en":"If hardship presses a son of a bitch,"},{"id":"semetey-1-2013:p1069:b003:l027","ordinal":157742,"en":"I may resolve to give even her away!"},{"id":"semetey-1-2013:p1069:b003:l028","ordinal":157743,"en":"For the waist you have girded,"},{"id":"semetey-1-2013:p1069:b003:l029","ordinal":157744,"en":"Do not keep fiercely maligning"},{"id":"semetey-1-2013:p1069:b003:l030","ordinal":157745,"en":"Your renowned gray-maned husband!"},{"id":"semetey-1-2013:p1069:b003:l031","ordinal":157746,"en":"Semetey, born greater"},{"id":"semetey-1-2013:p1069:b003:l032","ordinal":157747,"en":"Than his father, gray-maned Manas,"},{"id":"semetey-1-2013:p1069:b003:l033","ordinal":157748,"en":"If you have heard reports about yourself,"},{"id":"semetey-1-2013:p1069:b003:l034","ordinal":157749,"en":"And keep believing your wife,"},{"id":"semetey-1-2013:p1069:b003:l035","ordinal":157750,"en":"Here is the city of Baashaluu,"},{"id":"semetey-1-2013:p1069:b003:l036","ordinal":157751,"en":"And here am I—cut off my head!\""},{"id":"semetey-1-2013:p1069:b003:l037","ordinal":157752,"en":"Unerring Azhybay"},{"id":"semetey-1-2013:p1069:b003:l038","ordinal":157753,"en":"Had spoken his fitting words;"},{"id":"semetey-1-2013:p1069:b003:l039","ordinal":157754,"en":"He revealed his eloquence."},{"id":"semetey-1-2013:p1069:b004:l001","ordinal":157755,"en":"Azhybay, eloquent beyond others,"},{"id":"semetey-1-2013:p1069:b004:l002","ordinal":157756,"en":"Drove every weighty word"},{"id":"semetey-1-2013:p1069:b004:l003","ordinal":157757,"en":"Into the heart"},{"id":"semetey-1-2013:p1069:b004:l004","ordinal":157758,"en":"Of prince Semetey."},{"id":"semetey-1-2013:p1069:b004:l005","ordinal":157759,"en":"Then Semetey,"},{"id":"semetey-1-2013:p1069:b004:l006","ordinal":157760,"en":"Hearing many kinds of words from Azhybay,"},{"id":"semetey-1-2013:p1069:b004:l007","ordinal":157761,"en":"Found all he said persuasive;"},{"id":"semetey-1-2013:p1069:b004:l008","ordinal":157762,"en":"Thinking, \"She is acting like a woman,\""},{"id":"semetey-1-2013:p1069:b004:l009","ordinal":157763,"en":"He came to hate Aychürök."},{"id":"semetey-1-2013:p1069:b004:l010","ordinal":157764,"en":"\"God has struck her,"},{"id":"semetey-1-2013:p1069:b004:l011","ordinal":157765,"en":"For maligning her own elder brother!\""},{"id":"semetey-1-2013:p1069:b004:l012","ordinal":157766,"en":"His eyes reddened like a lion's;"},{"id":"semetey-1-2013:p1069:b004:l013","ordinal":157767,"en":"The fearsome leopard"},{"id":"semetey-1-2013:p1069:b004:l014","ordinal":157768,"en":"Showed his venomous face"},{"id":"semetey-1-2013:p1069:b004:l015","ordinal":157769,"en":"And now stared at Chürök."},{"id":"semetey-1-2013:p1069:b004:l016","ordinal":157770,"en":"Unable to bear his anger,"},{"id":"semetey-1-2013:p1069:b004:l017","ordinal":157771,"en":"What could dear Chürök do?"},{"id":"semetey-1-2013:p1069:b004:l018","ordinal":157772,"en":"She hurried forward at an amble;"},{"id":"semetey-1-2013:p1069:b004:l019","ordinal":157773,"en":"Unable to bear his venom,"},{"id":"semetey-1-2013:p1069:b004:l020","ordinal":157774,"en":"While the gray-maned lion stared,"},{"id":"semetey-1-2013:p1069:b004:l021","ordinal":157775,"en":"She cowered behind the curtain."},{"id":"semetey-1-2013:p1069:b004:l022","ordinal":157776,"en":"Azhybay, son of Azhy,"},{"id":"semetey-1-2013:p1069:b004:l023","ordinal":157777,"en":"And Tümönbay, son of Tülkü,"},{"id":"semetey-1-2013:p1069:b004:l024","ordinal":157778,"en":"Now put the day in writing"},{"id":"semetey-1-2013:p1069:b004:l025","ordinal":157779,"en":"And received the reckoning of the date."},{"id":"semetey-1-2013:p1069:b004:l026","ordinal":157780,"en":"When seven days had passed,"},{"id":"semetey-1-2013:p1069:b004:l027","ordinal":157781,"en":"They said, \"Let brave Toltoy come"},{"id":"semetey-1-2013:p1069:b004:l028","ordinal":157782,"en":"As bridegroom to Aychürök.\""},{"id":"semetey-1-2013:p1069:b004:l029","ordinal":157783,"en":"Azhybay, son of Azhy,"},{"id":"semetey-1-2013:p1069:b004:l030","ordinal":157784,"en":"Now made the pledge."},{"id":"semetey-1-2013:p1069:b004:l031","ordinal":157785,"en":"Külchoro, son of Almambet,"},{"id":"semetey-1-2013:p1069:b004:l032","ordinal":157786,"en":"Was twelve years old then;"},{"id":"semetey-1-2013:p1069:b004:l033","ordinal":157787,"en":"He was a remarkable one,"},{"id":"semetey-1-2013:p1069:b004:l034","ordinal":157788,"en":"A glowing red ember,"},{"id":"semetey-1-2013:p1069:b004:l035","ordinal":157789,"en":"With no one like him in the world,"},{"id":"semetey-1-2013:p1069:b004:l036","ordinal":157790,"en":"A prodigy born among men,"},{"id":"semetey-1-2013:p1069:b004:l037","ordinal":157791,"en":"With no one like him among mortals."},{"id":"semetey-1-2013:p1069:b004:l038","ordinal":157792,"en":"The horse he rode was gray;"},{"id":"semetey-1-2013:p1069:b004:l039","ordinal":157793,"en":"From heroic Sultan Alma—"},{"id":"semetey-1-2013:p1070:b003:l001","ordinal":157794,"en":"Külchoro, left as a gift"},{"id":"semetey-1-2013:p1070:b003:l002","ordinal":157795,"en":"From heroic Sultan Alma,"},{"id":"semetey-1-2013:p1070:b003:l003","ordinal":157796,"en":"Was a man a spear's height tall."},{"id":"semetey-1-2013:p1070:b003:l004","ordinal":157797,"en":"In the palace with iron doors,"},{"id":"semetey-1-2013:p1070:b003:l005","ordinal":157798,"en":"Within the fortress Aychürök"},{"id":"semetey-1-2013:p1070:b003:l006","ordinal":157799,"en":"Had splendidly erected,"},{"id":"semetey-1-2013:p1070:b003:l007","ordinal":157800,"en":"When the pledged day was fulfilled,"},{"id":"semetey-1-2013:p1070:b003:l008","ordinal":157801,"en":"When the time came"},{"id":"semetey-1-2013:p1070:b003:l009","ordinal":157802,"en":"For Toltoy the bridegroom to arrive,"},{"id":"semetey-1-2013:p1070:b003:l010","ordinal":157803,"en":"The vast Afghan host was there,"},{"id":"semetey-1-2013:p1070:b003:l011","ordinal":157804,"en":"The common people and their khan;"},{"id":"semetey-1-2013:p1070:b003:l012","ordinal":157805,"en":"Khan Akun was there too,"},{"id":"semetey-1-2013:p1070:b003:l013","ordinal":157806,"en":"Azhybay, son of Azhy,"},{"id":"semetey-1-2013:p1070:b003:l014","ordinal":157807,"en":"Tümönbay, son of Tülkü,"},{"id":"semetey-1-2013:p1070:b003:l015","ordinal":157808,"en":"And all those who gave wise counsel—"},{"id":"semetey-1-2013:p1070:b004:l001","ordinal":157809,"en":"Every wise man was there."},{"id":"semetey-1-2013:p1070:b004:l002","ordinal":157810,"en":"\"Khan Semetey, our son-in-law, has arrived,\""},{"id":"semetey-1-2013:p1070:b004:l003","ordinal":157811,"en":"They said;"},{"id":"semetey-1-2013:p1070:b004:l004","ordinal":157812,"en":"The many Afghans in the city"},{"id":"semetey-1-2013:p1070:b004:l005","ordinal":157813,"en":"Had heard the news,"},{"id":"semetey-1-2013:p1070:b004:l006","ordinal":157814,"en":"As had their impetuous Bek Akun."},{"id":"semetey-1-2013:p1070:b004:l007","ordinal":157815,"en":"Saying, \"Lion Semetey the bridegroom"},{"id":"semetey-1-2013:p1070:b004:l008","ordinal":157816,"en":"Will rescue her"},{"id":"semetey-1-2013:p1070:b004:l009","ordinal":157817,"en":"From Toltoy of the Zhediger,"},{"id":"semetey-1-2013:p1070:b004:l010","ordinal":157818,"en":"And raise a great tumult,\""},{"id":"semetey-1-2013:p1070:b004:l011","ordinal":157819,"en":"All the Afghans gathered"},{"id":"semetey-1-2013:p1070:b004:l012","ordinal":157820,"en":"And invoked Bahauddin."},{"id":"semetey-1-2013:p1070:b004:l013","ordinal":157821,"en":"If the prose tale were told on,"},{"id":"semetey-1-2013:p1070:b004:l014","ordinal":157822,"en":"The tale of Choro, son of Almambet,"},{"id":"semetey-1-2013:p1070:b004:l015","ordinal":157823,"en":"Would never be exhausted."},{"id":"semetey-1-2013:p1070:b006:l001","ordinal":157824,"en":"At twelve years old, that remarkable boy"},{"id":"semetey-1-2013:p1070:b006:l002","ordinal":157825,"en":"Asked leave of Semetey,"},{"id":"semetey-1-2013:p1070:b006:l003","ordinal":157826,"en":"And bowed as he said:"},{"id":"semetey-1-2013:p1070:b006:l004","ordinal":157827,"en":"\"Blood-taking elder brother, leopard,"},{"id":"semetey-1-2013:p1070:b006:l005","ordinal":157828,"en":"My saint who made me your dependent,"},{"id":"semetey-1-2013:p1070:b006:l006","ordinal":157829,"en":"Give me your horse no bullet can catch;"},{"id":"semetey-1-2013:p1070:b006:l007","ordinal":157830,"en":"Give me your coat no bullet can pierce."},{"id":"semetey-1-2013:p1070:b006:l008","ordinal":157831,"en":"If you give me both, I shall put them on"},{"id":"semetey-1-2013:p1070:b006:l009","ordinal":157832,"en":"And learn what tyranny"},{"id":"semetey-1-2013:p1070:b006:l010","ordinal":157833,"en":"Arrogant Toltoy possesses!"},{"id":"semetey-1-2013:p1070:b006:l011","ordinal":157834,"en":"If God's written decree"},{"id":"semetey-1-2013:p1070:b006:l012","ordinal":157835,"en":"Is inscribed upon my brow, I shall see it;"},{"id":"semetey-1-2013:p1070:b006:l013","ordinal":157836,"en":"I shall die while jousting"},{"id":"semetey-1-2013:p1070:b006:l014","ordinal":157837,"en":"Against Toltoy of the Zhediger!"},{"id":"semetey-1-2013:p1070:b006:l015","ordinal":157838,"en":"That hulking infidel Toltoy,"},{"id":"semetey-1-2013:p1070:b006:l016","ordinal":157839,"en":"The hero coming as bridegroom—"},{"id":"semetey-1-2013:p1070:b006:l017","ordinal":157840,"en":"Whichever of Kozho and Toltoy"},{"id":"semetey-1-2013:p1070:b006:l018","ordinal":157841,"en":"Falls into my hands,"},{"id":"semetey-1-2013:p1070:b007:l001","ordinal":157842,"en":"If my death has come, I shall die;"},{"id":"semetey-1-2013:p1070:b007:l002","ordinal":157843,"en":"If it lies within my power,"},{"id":"semetey-1-2013:p1070:b007:l003","ordinal":157844,"en":"I shall make a spectacle of them for you!"},{"id":"semetey-1-2013:p1070:b007:l004","ordinal":157845,"en":"I intend to break their ranks"},{"id":"semetey-1-2013:p1070:b007:l005","ordinal":157846,"en":"In a clash of spears and see;"},{"id":"semetey-1-2013:p1070:b007:l006","ordinal":157847,"en":"If death comes to me from God,"},{"id":"semetey-1-2013:p1070:b007:l007","ordinal":157848,"en":"I intend to die!"},{"id":"semetey-1-2013:p1070:b007:l008","ordinal":157849,"en":"Whichever of Toltoy and Kozho"},{"id":"semetey-1-2013:p1070:b007:l009","ordinal":157850,"en":"Falls into my hands,"},{"id":"semetey-1-2013:p1070:b007:l010","ordinal":157851,"en":"I intend to make him a spectacle"},{"id":"semetey-1-2013:p1070:b007:l011","ordinal":157852,"en":"And present him to you."},{"id":"semetey-1-2013:p1070:b007:l012","ordinal":157853,"en":"That consummate prince Toltoy,"},{"id":"semetey-1-2013:p1070:b007:l013","ordinal":157854,"en":"That would-be brother-in-law—"},{"id":"semetey-1-2013:p1070:b007:l014","ordinal":157855,"en":"Let us be drenched in bloody blood,"},{"id":"semetey-1-2013:p1070:b007:l015","ordinal":157856,"en":"Let us stand and fight without fleeing,"},{"id":"semetey-1-2013:p1070:b007:l016","ordinal":157857,"en":"Let us grapple from the very skirts,"},{"id":"semetey-1-2013:p1070:b007:l017","ordinal":157858,"en":"Descend upon the open plain,"},{"id":"semetey-1-2013:p1070:b007:l018","ordinal":157859,"en":"And bring each other to an end.\""},{"id":"semetey-1-2013:p1071:b003:l001","ordinal":157860,"en":"Is this not the true delight?"},{"id":"semetey-1-2013:p1071:b003:l002","ordinal":157861,"en":"When we were in Talas,"},{"id":"semetey-1-2013:p1071:b003:l003","ordinal":157862,"en":"Among all the Argyn and Kyrgyz,"},{"id":"semetey-1-2013:p1071:b003:l004","ordinal":157863,"en":"This Choro who followed me"},{"id":"semetey-1-2013:p1071:b003:l005","ordinal":157864,"en":"Resolved, \"May I become a sacrifice"},{"id":"semetey-1-2013:p1071:b003:l006","ordinal":157865,"en":"Before my elder brother;"},{"id":"semetey-1-2013:p1071:b003:l007","ordinal":157866,"en":"May I pass on before him.\""},{"id":"semetey-1-2013:p1071:b003:l008","ordinal":157867,"en":"Such is exactly my resolve."},{"id":"semetey-1-2013:p1071:b003:l009","ordinal":157868,"en":"The ground of grappling is great turmoil;"},{"id":"semetey-1-2013:p1071:b003:l010","ordinal":157869,"en":"The ground of clashing is great delight."},{"id":"semetey-1-2013:p1071:b003:l011","ordinal":157870,"en":"Do not grieve because I am young,"},{"id":"semetey-1-2013:p1071:b003:l012","ordinal":157871,"en":"Blessed elder brother, leopard;"},{"id":"semetey-1-2013:p1071:b003:l013","ordinal":157872,"en":"Do people not die while young?"},{"id":"semetey-1-2013:p1071:b003:l014","ordinal":157873,"en":"Do not old and young alike meet"},{"id":"semetey-1-2013:p1071:b003:l015","ordinal":157874,"en":"The decree laid down by the Creator?"},{"id":"semetey-1-2013:p1071:b003:l016","ordinal":157875,"en":"My dear khan and elder brother,"},{"id":"semetey-1-2013:p1071:b003:l017","ordinal":157876,"en":"Against Toltoy who has come to our border,"},{"id":"semetey-1-2013:p1071:b003:l018","ordinal":157877,"en":"To give him his measured answer,"},{"id":"semetey-1-2013:p1071:b003:l019","ordinal":157878,"en":"To die locked in combat,"},{"id":"semetey-1-2013:p1071:b003:l020","ordinal":157879,"en":"I am the amulet hung upon the neck"},{"id":"semetey-1-2013:p1071:b003:l021","ordinal":157880,"en":"Of the piebald herd's tulpar."},{"id":"semetey-1-2013:p1071:b003:l022","ordinal":157881,"en":"While still young, I long"},{"id":"semetey-1-2013:p1071:b003:l023","ordinal":157882,"en":"To die once at Toltoy's hands."},{"id":"semetey-1-2013:p1071:b003:l024","ordinal":157883,"en":"If we shout and level spears"},{"id":"semetey-1-2013:p1071:b003:l025","ordinal":157884,"en":"Against Toltoy of the Zhediger,"},{"id":"semetey-1-2013:p1071:b003:l026","ordinal":157885,"en":"And fight him man to man,"},{"id":"semetey-1-2013:p1071:b003:l027","ordinal":157886,"en":"If the spear strikes with a shriek,"},{"id":"semetey-1-2013:p1071:b003:l028","ordinal":157887,"en":"If blood spills with a rush,"},{"id":"semetey-1-2013:p1071:b003:l029","ordinal":157888,"en":"If Syrnayza, as we joust,"},{"id":"semetey-1-2013:p1071:b003:l030","ordinal":157889,"en":"Splinters through the middle with a crack—"},{"id":"semetey-1-2013:p1071:b003:l031","ordinal":157890,"en":"Would that not be splendid?"},{"id":"semetey-1-2013:p1071:b003:l032","ordinal":157891,"en":"If you give me Akolpok, I shall wear it;"},{"id":"semetey-1-2013:p1071:b003:l033","ordinal":157892,"en":"If you give me Arbuudan, I shall ride it."},{"id":"semetey-1-2013:p1071:b003:l034","ordinal":157893,"en":"I have my Buurul steed beneath me;"},{"id":"semetey-1-2013:p1071:b003:l035","ordinal":157894,"en":"I have the strength to shatter"},{"id":"semetey-1-2013:p1071:b003:l036","ordinal":157895,"en":"Not merely Toltoy, but Kaldang."},{"id":"semetey-1-2013:p1071:b003:l037","ordinal":157896,"en":"Listen to my words, mighty elder brother:"},{"id":"semetey-1-2013:p1071:b003:l038","ordinal":157897,"en":"If I spear no man at twelve,"},{"id":"semetey-1-2013:p1071:b003:l039","ordinal":157898,"en":"Will I, at thirty-five,"},{"id":"semetey-1-2013:p1071:b004:l001","ordinal":157899,"en":"Catch even a tethered cow?\""},{"id":"semetey-1-2013:p1071:b004:l002","ordinal":157900,"en":"Then your gray-maned lion, son of Manas,"},{"id":"semetey-1-2013:p1071:b004:l003","ordinal":157901,"en":"As the boy stood pleading,"},{"id":"semetey-1-2013:p1071:b004:l004","ordinal":157902,"en":"Saw God's sun cloud over in the sky,"},{"id":"semetey-1-2013:p1071:b004:l005","ordinal":157903,"en":"And sixty worries came upon him:"},{"id":"semetey-1-2013:p1071:b004:l006","ordinal":157904,"en":"\"You mean to bring him face to face,"},{"id":"semetey-1-2013:p1071:b004:l007","ordinal":157905,"en":"My dear Almighty,"},{"id":"semetey-1-2013:p1071:b004:l008","ordinal":157906,"en":"With an inescapable sorrow;"},{"id":"semetey-1-2013:p1071:b004:l009","ordinal":157907,"en":"What can I do, when you have made"},{"id":"semetey-1-2013:p1071:b004:l010","ordinal":157908,"en":"A twelve-year-old boy gird his waist?"},{"id":"semetey-1-2013:p1071:b004:l011","ordinal":157909,"en":"Külchoro, for a boy like you,"},{"id":"semetey-1-2013:p1071:b004:l012","ordinal":157910,"en":"I would sacrifice my own dark life."},{"id":"semetey-1-2013:p1071:b004:l013","ordinal":157911,"en":"You are only a boy of twelve,"},{"id":"semetey-1-2013:p1071:b004:l014","ordinal":157912,"en":"A soul whose time is still young."},{"id":"semetey-1-2013:p1071:b004:l015","ordinal":157913,"en":"If I grieve in sorrow,"},{"id":"semetey-1-2013:p1071:b004:l016","ordinal":157914,"en":"What will our days become"},{"id":"semetey-1-2013:p1071:b004:l017","ordinal":157915,"en":"If I lose you,"},{"id":"semetey-1-2013:p1071:b004:l018","ordinal":157916,"en":"My companion, my Külchoro?"},{"id":"semetey-1-2013:p1071:b004:l019","ordinal":157917,"en":"My ribs will be torn apart,"},{"id":"semetey-1-2013:p1071:b004:l020","ordinal":157918,"en":"And tears will pour from my eyes;"},{"id":"semetey-1-2013:p1071:b004:l021","ordinal":157919,"en":"Because you are your father's only son,"},{"id":"semetey-1-2013:p1071:b004:l022","ordinal":157920,"en":"My heart is cruelly divided."},{"id":"semetey-1-2013:p1071:b004:l023","ordinal":157921,"en":"I have no mountain pass lying secure,"},{"id":"semetey-1-2013:p1071:b004:l024","ordinal":157922,"en":"No place where I may gird my waist;"},{"id":"semetey-1-2013:p1071:b004:l025","ordinal":157923,"en":"If hardship presses this toil-worn soul,"},{"id":"semetey-1-2013:p1071:b004:l026","ordinal":157924,"en":"My renowned lion Bakay,"},{"id":"semetey-1-2013:p1071:b004:l027","ordinal":157925,"en":"Who finds firm wisdom, is not here."},{"id":"semetey-1-2013:p1071:b004:l028","ordinal":157926,"en":"I came here among the Afghans;"},{"id":"semetey-1-2013:p1071:b004:l029","ordinal":157927,"en":"None of the renowned Kyrgyz are here."},{"id":"semetey-1-2013:p1071:b004:l030","ordinal":157928,"en":"My elder Sarykhan, who would be"},{"id":"semetey-1-2013:p1071:b004:l031","ordinal":157929,"en":"A binding support around my waist, is absent too."},{"id":"semetey-1-2013:p1071:b004:l032","ordinal":157930,"en":"There is no forest into which I can flee,"},{"id":"semetey-1-2013:p1071:b004:l033","ordinal":157931,"en":"No stepmother on whom I can rely,"},{"id":"semetey-1-2013:p1071:b004:l034","ordinal":157932,"en":"No cliff where even a goose cannot circle,"},{"id":"semetey-1-2013:p1071:b004:l035","ordinal":157933,"en":"No rugged black mountain of mine."},{"id":"semetey-1-2013:p1071:b004:l036","ordinal":157934,"en":"I have no thoroughbred to ride out;"},{"id":"semetey-1-2013:p1071:b004:l037","ordinal":157935,"en":"Sovereign God, it is only you,"},{"id":"semetey-1-2013:p1071:b004:l038","ordinal":157936,"en":"And I have no kin except the boy."},{"id":"semetey-1-2013:p1071:b004:l039","ordinal":157937,"en":"\"Semetey, Manas's boastful son—"}]
