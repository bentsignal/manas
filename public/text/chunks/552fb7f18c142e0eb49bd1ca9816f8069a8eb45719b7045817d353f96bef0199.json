[{"id":"semetey-1-2013:p1249:b008:l029","ordinal":171521,"en":"“Our venture rests with Almighty God.”"},{"id":"semetey-1-2013:p1250:b003:l001","ordinal":171522,"en":"Their marksmen were at the front;"},{"id":"semetey-1-2013:p1250:b003:l002","ordinal":171523,"en":"Their heroes were at the flanks."},{"id":"semetey-1-2013:p1250:b003:l003","ordinal":171524,"en":"Their hardy men were at the front;"},{"id":"semetey-1-2013:p1250:b003:l004","ordinal":171525,"en":"Their tigers were at the flanks."},{"id":"semetey-1-2013:p1250:b003:l005","ordinal":171526,"en":"Their spearmen were at the front;"},{"id":"semetey-1-2013:p1250:b003:l006","ordinal":171527,"en":"Their lions were at the flanks."},{"id":"semetey-1-2013:p1250:b003:l007","ordinal":171528,"en":"Without twitching the horses' mouths,"},{"id":"semetey-1-2013:p1250:b003:l008","ordinal":171529,"en":"Many here wheeled their mounts."},{"id":"semetey-1-2013:p1250:b003:l009","ordinal":171530,"en":"Holding spears and fitting banner tips,"},{"id":"semetey-1-2013:p1250:b003:l010","ordinal":171531,"en":"Many here stood ready."},{"id":"semetey-1-2013:p1250:b003:l011","ordinal":171532,"en":"Steeping themselves in bloody blood,"},{"id":"semetey-1-2013:p1250:b003:l012","ordinal":171533,"en":"Fighting without fleeing,"},{"id":"semetey-1-2013:p1250:b003:l013","ordinal":171534,"en":"Many here were warriors."},{"id":"semetey-1-2013:p1250:b003:l014","ordinal":171535,"en":"Streaming along the riverbank,"},{"id":"semetey-1-2013:p1250:b003:l015","ordinal":171536,"en":"Surging across the ground,"},{"id":"semetey-1-2013:p1250:b003:l016","ordinal":171537,"en":"They were told, “All advance abreast;"},{"id":"semetey-1-2013:p1250:b003:l017","ordinal":171538,"en":"Ride with room and do not collide.”"},{"id":"semetey-1-2013:p1250:b003:l018","ordinal":171539,"en":"Spearheads clashed;"},{"id":"semetey-1-2013:p1250:b003:l019","ordinal":171540,"en":"Men's heads knocked together."},{"id":"semetey-1-2013:p1250:b003:l020","ordinal":171541,"en":"Commanders of ten swept forward;"},{"id":"semetey-1-2013:p1250:b003:l021","ordinal":171542,"en":"Commanders of a hundred towered."},{"id":"semetey-1-2013:p1250:b003:l022","ordinal":171543,"en":"Their ancient fury stirred;"},{"id":"semetey-1-2013:p1250:b003:l023","ordinal":171544,"en":"They became an army of many thousands."},{"id":"semetey-1-2013:p1250:b003:l024","ordinal":171545,"en":"They had horns and trumpets sounded,"},{"id":"semetey-1-2013:p1250:b003:l025","ordinal":171546,"en":"Loaded troops upon rhinoceroses,"},{"id":"semetey-1-2013:p1250:b003:l026","ordinal":171547,"en":"Loaded ammunition on elephants,"},{"id":"semetey-1-2013:p1250:b003:l027","ordinal":171548,"en":"And gathered all the Jediger people"},{"id":"semetey-1-2013:p1250:b003:l028","ordinal":171549,"en":"To carry out merciless slaughter"},{"id":"semetey-1-2013:p1250:b003:l029","ordinal":171550,"en":"And seize Aychürök."},{"id":"semetey-1-2013:p1250:b003:l030","ordinal":171551,"en":"They went to exact, bit by bit,"},{"id":"semetey-1-2013:p1250:b003:l031","ordinal":171552,"en":"The vengeance of wounded Toltoy."},{"id":"semetey-1-2013:p1250:b003:l032","ordinal":171553,"en":"The drum's voice thundered;"},{"id":"semetey-1-2013:p1250:b003:l033","ordinal":171554,"en":"The brass horn's voice rang."},{"id":"semetey-1-2013:p1250:b003:l034","ordinal":171555,"en":"The gray-mottled pennant became their banner;"},{"id":"semetey-1-2013:p1250:b003:l035","ordinal":171556,"en":"A wailing clamor arose."},{"id":"semetey-1-2013:p1250:b003:l036","ordinal":171557,"en":"The white-mottled pennant became their banner;"},{"id":"semetey-1-2013:p1250:b003:l037","ordinal":171558,"en":"The air filled with battle cries and clamor."},{"id":"semetey-1-2013:p1250:b003:l038","ordinal":171559,"en":"Toltoy of the Jediger,"},{"id":"semetey-1-2013:p1250:b003:l039","ordinal":171560,"en":"His countless army bending the earth—"},{"id":"semetey-1-2013:p1250:b004:l001","ordinal":171561,"en":"His spearmen were at the front;"},{"id":"semetey-1-2013:p1250:b004:l002","ordinal":171562,"en":"The lion Toltoy was at the flank."},{"id":"semetey-1-2013:p1250:b004:l003","ordinal":171563,"en":"He was driving them forth;"},{"id":"semetey-1-2013:p1250:b004:l004","ordinal":171564,"en":"Swarming like ants,"},{"id":"semetey-1-2013:p1250:b004:l005","ordinal":171565,"en":"They came seething out."},{"id":"semetey-1-2013:p1250:b004:l006","ordinal":171566,"en":"It was impossible to tell if they were worms,"},{"id":"semetey-1-2013:p1250:b004:l007","ordinal":171567,"en":"Impossible to tell if they were people;"},{"id":"semetey-1-2013:p1250:b004:l008","ordinal":171568,"en":"They came seething out."},{"id":"semetey-1-2013:p1250:b004:l009","ordinal":171569,"en":"Their heroes were at the front;"},{"id":"semetey-1-2013:p1250:b004:l010","ordinal":171570,"en":"Renowned Kozho was at the flank."},{"id":"semetey-1-2013:p1250:b004:l011","ordinal":171571,"en":"Tölök and Tölöbay"},{"id":"semetey-1-2013:p1250:b004:l012","ordinal":171572,"en":"Were behind the lower army."},{"id":"semetey-1-2013:p1250:b004:l013","ordinal":171573,"en":"Kalcha and Kadyrbay"},{"id":"semetey-1-2013:p1250:b004:l014","ordinal":171574,"en":"Were at the army's qibla-side flank."},{"id":"semetey-1-2013:p1250:b004:l015","ordinal":171575,"en":"Wearing a black supa coat,"},{"id":"semetey-1-2013:p1250:b004:l016","ordinal":171576,"en":"Riding a black noble horse,"},{"id":"semetey-1-2013:p1250:b004:l017","ordinal":171577,"en":"Dear Kozho was at the flank."},{"id":"semetey-1-2013:p1250:b004:l018","ordinal":171578,"en":"Along the bank road of Kum-Kyya,"},{"id":"semetey-1-2013:p1250:b004:l019","ordinal":171579,"en":"They came forth in splendor;"},{"id":"semetey-1-2013:p1250:b004:l020","ordinal":171580,"en":"Behind raging Kozho,"},{"id":"semetey-1-2013:p1250:b004:l021","ordinal":171581,"en":"He drove them onward."},{"id":"semetey-1-2013:p1250:b004:l022","ordinal":171582,"en":"From beside Tash-Kyya,"},{"id":"semetey-1-2013:p1250:b004:l023","ordinal":171583,"en":"Most of them came forth;"},{"id":"semetey-1-2013:p1250:b004:l024","ordinal":171584,"en":"Along the bank road of Kum-Kyya,"},{"id":"semetey-1-2013:p1250:b004:l025","ordinal":171585,"en":"Half of them came forth."},{"id":"semetey-1-2013:p1250:b004:l026","ordinal":171586,"en":"Their great banner floated;"},{"id":"semetey-1-2013:p1250:b004:l027","ordinal":171587,"en":"The brass horn's voice clattered."},{"id":"semetey-1-2013:p1250:b004:l028","ordinal":171588,"en":"Sword points swayed;"},{"id":"semetey-1-2013:p1250:b004:l029","ordinal":171589,"en":"Spear tips flashed."},{"id":"semetey-1-2013:p1250:b004:l030","ordinal":171590,"en":"Their drums boomed."},{"id":"semetey-1-2013:p1250:b004:l031","ordinal":171591,"en":"Shouting to the great host, “Advance!”"},{"id":"semetey-1-2013:p1250:b004:l032","ordinal":171592,"en":"Hero Toltoy thundered."},{"id":"semetey-1-2013:p1250:b004:l033","ordinal":171593,"en":"Gun barrels appeared,"},{"id":"semetey-1-2013:p1250:b004:l034","ordinal":171594,"en":"Men's minds were shaken;"},{"id":"semetey-1-2013:p1250:b004:l035","ordinal":171595,"en":"As though gone mad, the Jediger"},{"id":"semetey-1-2013:p1250:b004:l036","ordinal":171596,"en":"Came forth clamoring."},{"id":"semetey-1-2013:p1250:b004:l037","ordinal":171597,"en":"Their surging people roared,"},{"id":"semetey-1-2013:p1250:b004:l038","ordinal":171598,"en":"Crying Toltoy's battle cry."},{"id":"semetey-1-2013:p1250:b004:l039","ordinal":171599,"en":"The people stirred and shouted,"},{"id":"semetey-1-2013:p1251:b003:l001","ordinal":171600,"en":"They raised the battle cry of \"Kojo!\""},{"id":"semetey-1-2013:p1251:b003:l002","ordinal":171601,"en":"The Zhediger striking from above"},{"id":"semetey-1-2013:p1251:b003:l003","ordinal":171602,"en":"Made the lower side roar,"},{"id":"semetey-1-2013:p1251:b003:l004","ordinal":171603,"en":"Raising the cry of \"Tölök!\""},{"id":"semetey-1-2013:p1251:b003:l005","ordinal":171604,"en":"Their flanks shouted,"},{"id":"semetey-1-2013:p1251:b003:l006","ordinal":171605,"en":"Raising the cry of \"Kalcha!\""},{"id":"semetey-1-2013:p1251:b003:l007","ordinal":171606,"en":"An agitated army was coming,"},{"id":"semetey-1-2013:p1251:b003:l008","ordinal":171607,"en":"Coming in multitudes to act."},{"id":"semetey-1-2013:p1251:b003:l009","ordinal":171608,"en":"A dug trench was coming,"},{"id":"semetey-1-2013:p1251:b003:l010","ordinal":171609,"en":"A great, seething affliction was coming."},{"id":"semetey-1-2013:p1251:b003:l011","ordinal":171610,"en":"An engulfing army was coming;"},{"id":"semetey-1-2013:p1251:b003:l012","ordinal":171611,"en":"Upon those who watched,"},{"id":"semetey-1-2013:p1251:b003:l013","ordinal":171612,"en":"A mighty upheaval descended."},{"id":"semetey-1-2013:p1251:b003:l014","ordinal":171613,"en":"Many made ready without pause,"},{"id":"semetey-1-2013:p1251:b003:l015","ordinal":171614,"en":"Spurring forward, saying,"},{"id":"semetey-1-2013:p1251:b003:l016","ordinal":171615,"en":"\"We entrust ourselves to the fight.\""},{"id":"semetey-1-2013:p1251:b003:l017","ordinal":171616,"en":"Many lamented, saying,"},{"id":"semetey-1-2013:p1251:b003:l018","ordinal":171617,"en":"\"If we bring this upheaval and war"},{"id":"semetey-1-2013:p1251:b003:l019","ordinal":171618,"en":"And die in it,"},{"id":"semetey-1-2013:p1251:b003:l020","ordinal":171619,"en":"What will become of our poor wives"},{"id":"semetey-1-2013:p1251:b003:l021","ordinal":171620,"en":"And young children?\""},{"id":"semetey-1-2013:p1251:b003:l022","ordinal":171621,"en":"Many lost their wits in panic"},{"id":"semetey-1-2013:p1251:b003:l023","ordinal":171622,"en":"And rushed about."},{"id":"semetey-1-2013:p1251:b003:l024","ordinal":171623,"en":"Many fled, saying,"},{"id":"semetey-1-2013:p1251:b003:l025","ordinal":171624,"en":"\"If we die there,"},{"id":"semetey-1-2013:p1251:b003:l026","ordinal":171625,"en":"What will become of a lone wife"},{"id":"semetey-1-2013:p1251:b003:l027","ordinal":171626,"en":"And a single child?\""},{"id":"semetey-1-2013:p1251:b003:l028","ordinal":171627,"en":"Many, trapped in the midst"},{"id":"semetey-1-2013:p1251:b003:l029","ordinal":171628,"en":"As though God would take them,"},{"id":"semetey-1-2013:p1251:b003:l030","ordinal":171629,"en":"Were subjected to plunder."},{"id":"semetey-1-2013:p1251:b003:l031","ordinal":171630,"en":"Many, saying they would turn back,"},{"id":"semetey-1-2013:p1251:b003:l032","ordinal":171631,"en":"Met the guards"},{"id":"semetey-1-2013:p1251:b003:l033","ordinal":171632,"en":"And were beaten."},{"id":"semetey-1-2013:p1251:b003:l034","ordinal":171633,"en":"The spearmen arrived;"},{"id":"semetey-1-2013:p1251:b003:l035","ordinal":171634,"en":"When their khans drove them forward,"},{"id":"semetey-1-2013:p1251:b003:l036","ordinal":171635,"en":"The great Black Zhediger"},{"id":"semetey-1-2013:p1251:b003:l037","ordinal":171636,"en":"Set out in a rabble."},{"id":"semetey-1-2013:p1251:b003:l038","ordinal":171637,"en":"Chynkojo, son of Shygai,"},{"id":"semetey-1-2013:p1251:b003:l039","ordinal":171638,"en":"Kojo, vigorous in his deeds,"},{"id":"semetey-1-2013:p1251:b005:l001","ordinal":171639,"en":"Shouted in anger"},{"id":"semetey-1-2013:p1251:b005:l002","ordinal":171640,"en":"And summoned the Zhediger."},{"id":"semetey-1-2013:p1251:b005:l003","ordinal":171641,"en":"He grew excited like a cuckoo;"},{"id":"semetey-1-2013:p1251:b005:l004","ordinal":171642,"en":"At his flank hero Toltoi"},{"id":"semetey-1-2013:p1251:b005:l005","ordinal":171643,"en":"Spoke to the Zhediger:"},{"id":"semetey-1-2013:p1251:b005:l006","ordinal":171644,"en":"\"Great Black Zhediger,"},{"id":"semetey-1-2013:p1251:b005:l007","ordinal":171645,"en":"Do not turn back and flee;"},{"id":"semetey-1-2013:p1251:b005:l008","ordinal":171646,"en":"Move steadily in your ranks,"},{"id":"semetey-1-2013:p1251:b005:l009","ordinal":171647,"en":"My Zhediger, do not hurry."},{"id":"semetey-1-2013:p1251:b005:l010","ordinal":171648,"en":"Let us surge in shouting"},{"id":"semetey-1-2013:p1251:b005:l011","ordinal":171649,"en":"And unleash a general battle;"},{"id":"semetey-1-2013:p1251:b005:l012","ordinal":171650,"en":"Let us bind the champions"},{"id":"semetey-1-2013:p1251:b005:l013","ordinal":171651,"en":"Of the Afghans who refused the girl."},{"id":"semetey-1-2013:p1251:b005:l014","ordinal":171652,"en":"If the lordly Afghans"},{"id":"semetey-1-2013:p1251:b005:l015","ordinal":171653,"en":"Will not give the old maid,"},{"id":"semetey-1-2013:p1251:b005:l016","ordinal":171654,"en":"Let us bind their prince."},{"id":"semetey-1-2013:p1251:b005:l017","ordinal":171655,"en":"Let us dig a well in their place of honor"},{"id":"semetey-1-2013:p1251:b005:l018","ordinal":171656,"en":"And scatter their four kinds of livestock."},{"id":"semetey-1-2013:p1251:b005:l019","ordinal":171657,"en":"These Afghans have gone mad,"},{"id":"semetey-1-2013:p1251:b005:l020","ordinal":171658,"en":"As though they had raised a champion;"},{"id":"semetey-1-2013:p1251:b005:l021","ordinal":171659,"en":"Let us plunder their goods"},{"id":"semetey-1-2013:p1251:b005:l022","ordinal":171660,"en":"And wreak destruction together."},{"id":"semetey-1-2013:p1251:b005:l023","ordinal":171661,"en":"Let us seize and slaughter their khans"},{"id":"semetey-1-2013:p1251:b005:l024","ordinal":171662,"en":"And gouge out their people's eyes."},{"id":"semetey-1-2013:p1251:b005:l025","ordinal":171663,"en":"If they will not give the old maid,"},{"id":"semetey-1-2013:p1251:b005:l026","ordinal":171664,"en":"Let us cover their plain with smoke,"},{"id":"semetey-1-2013:p1251:b005:l027","ordinal":171665,"en":"Raid everything without remainder,"},{"id":"semetey-1-2013:p1251:b005:l028","ordinal":171666,"en":"Turn water into their gardens"},{"id":"semetey-1-2013:p1251:b005:l029","ordinal":171667,"en":"And make them into vegetable plots."},{"id":"semetey-1-2013:p1251:b005:l030","ordinal":171668,"en":"Turn water onto their poplars"},{"id":"semetey-1-2013:p1251:b005:l031","ordinal":171669,"en":"And leave them staggering."},{"id":"semetey-1-2013:p1251:b005:l032","ordinal":171670,"en":"Let us bind old Akun"},{"id":"semetey-1-2013:p1251:b005:l033","ordinal":171671,"en":"And make him a slave."},{"id":"semetey-1-2013:p1251:b005:l034","ordinal":171672,"en":"Let us make Azhibai and Tümönbai"},{"id":"semetey-1-2013:p1251:b005:l035","ordinal":171673,"en":"Our herdsmen;"},{"id":"semetey-1-2013:p1251:b005:l036","ordinal":171674,"en":"Let us level their straight-built city"},{"id":"semetey-1-2013:p1251:b005:l037","ordinal":171675,"en":"And raid it without leaving a thing."},{"id":"semetey-1-2013:p1251:b005:l038","ordinal":171676,"en":"They have chosen war;"},{"id":"semetey-1-2013:p1251:b005:l039","ordinal":171677,"en":"Let us engage in strife."},{"id":"semetey-1-2013:p1252:b003:l001","ordinal":171678,"en":"Let us come out in single combat,"},{"id":"semetey-1-2013:p1252:b003:l002","ordinal":171679,"en":"Fight for seven days without pause,"},{"id":"semetey-1-2013:p1252:b003:l003","ordinal":171680,"en":"And let those whose death has come die;"},{"id":"semetey-1-2013:p1252:b003:l004","ordinal":171681,"en":"When what Allah has written"},{"id":"semetey-1-2013:p1252:b003:l005","ordinal":171682,"en":"Descends upon our heads, let us meet it."},{"id":"semetey-1-2013:p1252:b003:l006","ordinal":171683,"en":"Let us exhaust one another,"},{"id":"semetey-1-2013:p1252:b003:l007","ordinal":171684,"en":"Test one another's mettle,"},{"id":"semetey-1-2013:p1252:b003:l008","ordinal":171685,"en":"And make the contest splendid."},{"id":"semetey-1-2013:p1252:b003:l009","ordinal":171686,"en":"Not only the maiden Chürök—"},{"id":"semetey-1-2013:p1252:b003:l010","ordinal":171687,"en":"Let us seize all the beauties"},{"id":"semetey-1-2013:p1252:b003:l011","ordinal":171688,"en":"Of the accursed Afghans who lag behind the migration,"},{"id":"semetey-1-2013:p1252:b003:l012","ordinal":171689,"en":"Their sable caps turned back!\""},{"id":"semetey-1-2013:p1252:b003:l013","ordinal":171690,"en":"Toltoi roused himself thus,"},{"id":"semetey-1-2013:p1252:b003:l014","ordinal":171691,"en":"And Chynkojo spoke:"},{"id":"semetey-1-2013:p1252:b003:l015","ordinal":171692,"en":"\"You have lords, you have a khan,"},{"id":"semetey-1-2013:p1252:b003:l016","ordinal":171693,"en":"And all this multitude of people."},{"id":"semetey-1-2013:p1252:b003:l017","ordinal":171694,"en":"Let us wage relentless war"},{"id":"semetey-1-2013:p1252:b003:l018","ordinal":171695,"en":"Against the Afghans whose villages are whole."},{"id":"semetey-1-2013:p1252:b003:l019","ordinal":171696,"en":"Do not lose your wits,"},{"id":"semetey-1-2013:p1252:b003:l020","ordinal":171697,"en":"O Zhediger, do not flee,\""},{"id":"semetey-1-2013:p1252:b003:l021","ordinal":171698,"en":"Chynkojo said, driving them in."},{"id":"semetey-1-2013:p1252:b003:l022","ordinal":171699,"en":"He divided off the bowmen,"},{"id":"semetey-1-2013:p1252:b003:l023","ordinal":171700,"en":"Divided off the strong,"},{"id":"semetey-1-2013:p1252:b003:l024","ordinal":171701,"en":"Divided off the wise,"},{"id":"semetey-1-2013:p1252:b003:l025","ordinal":171702,"en":"And divided off the foolish;"},{"id":"semetey-1-2013:p1252:b003:l026","ordinal":171703,"en":"Thus Chynkojo arranged them."},{"id":"semetey-1-2013:p1252:b003:l027","ordinal":171704,"en":"They came wave after wave in multitudes,"},{"id":"semetey-1-2013:p1252:b003:l028","ordinal":171705,"en":"An army covering the earth,"},{"id":"semetey-1-2013:p1252:b003:l029","ordinal":171706,"en":"Their banners bending to the ground,"},{"id":"semetey-1-2013:p1252:b003:l030","ordinal":171707,"en":"Shouting until the earth resounded,"},{"id":"semetey-1-2013:p1252:b003:l031","ordinal":171708,"en":"Raising the cry of \"Zhediger!\""},{"id":"semetey-1-2013:p1252:b003:l032","ordinal":171709,"en":"Those whose swords were keenest,"},{"id":"semetey-1-2013:p1252:b003:l033","ordinal":171710,"en":"Whose spears had steel points,"},{"id":"semetey-1-2013:p1252:b003:l034","ordinal":171711,"en":"Heroes who struck with battle-axes,"},{"id":"semetey-1-2013:p1252:b003:l035","ordinal":171712,"en":"His heroes who struck with battle-axes,"},{"id":"semetey-1-2013:p1252:b003:l036","ordinal":171713,"en":"His warriors who drew bows,"},{"id":"semetey-1-2013:p1252:b003:l037","ordinal":171714,"en":"He made all surge forward together;"},{"id":"semetey-1-2013:p1252:b003:l038","ordinal":171715,"en":"Thus had Chynkojo arranged them."},{"id":"semetey-1-2013:p1252:b003:l039","ordinal":171716,"en":"He ordered the Zhediger"},{"id":"semetey-1-2013:p1252:b004:l001","ordinal":171717,"en":"And divided them into seven;"},{"id":"semetey-1-2013:p1252:b004:l002","ordinal":171718,"en":"With these he came ringing"},{"id":"semetey-1-2013:p1252:b004:l003","ordinal":171719,"en":"And wholly engulfed the land."},{"id":"semetey-1-2013:p1252:b004:l004","ordinal":171720,"en":"When Khan Akun's sentry"},{"id":"semetey-1-2013:p1252:b004:l005","ordinal":171721,"en":"Took a lamp and looked,"},{"id":"semetey-1-2013:p1252:b004:l006","ordinal":171722,"en":"Along the shore-road of Kum-Kyya"},{"id":"semetey-1-2013:p1252:b004:l007","ordinal":171723,"en":"They came spreading into view."},{"id":"semetey-1-2013:p1252:b004:l008","ordinal":171724,"en":"One could not tell them from worms,"},{"id":"semetey-1-2013:p1252:b004:l009","ordinal":171725,"en":"So thickly they came seething."},{"id":"semetey-1-2013:p1252:b004:l010","ordinal":171726,"en":"Along the side of Tash-Kyya,"},{"id":"semetey-1-2013:p1252:b004:l011","ordinal":171727,"en":"Most of them came into view;"},{"id":"semetey-1-2013:p1252:b004:l012","ordinal":171728,"en":"At the embankment of the shore-road,"},{"id":"semetey-1-2013:p1252:b004:l013","ordinal":171729,"en":"Half of them came into view."},{"id":"semetey-1-2013:p1252:b004:l014","ordinal":171730,"en":"Along the shore-road, moving softly,"},{"id":"semetey-1-2013:p1252:b004:l015","ordinal":171731,"en":"Most of them came into view."},{"id":"semetey-1-2013:p1252:b004:l016","ordinal":171732,"en":"Look at the reeds, look at the flood;"},{"id":"semetey-1-2013:p1252:b004:l017","ordinal":171733,"en":"Look at the people who will engulf them,"},{"id":"semetey-1-2013:p1252:b004:l018","ordinal":171734,"en":"Raising a cry and unleashing upheaval."},{"id":"semetey-1-2013:p1252:b004:l019","ordinal":171735,"en":"Look at the great host engulfing them,"},{"id":"semetey-1-2013:p1252:b004:l020","ordinal":171736,"en":"Raising its customary cry."},{"id":"semetey-1-2013:p1252:b004:l021","ordinal":171737,"en":"Look at the trench being dug;"},{"id":"semetey-1-2013:p1252:b004:l022","ordinal":171738,"en":"Look at the army coming engulfing them,"},{"id":"semetey-1-2013:p1252:b004:l023","ordinal":171739,"en":"Shrieking like crows."},{"id":"semetey-1-2013:p1252:b004:l024","ordinal":171740,"en":"Seeing them, the sentry"},{"id":"semetey-1-2013:p1252:b004:l025","ordinal":171741,"en":"Beat the doolbas."},{"id":"semetey-1-2013:p1252:b004:l026","ordinal":171742,"en":"The tower-mounted doolbas"},{"id":"semetey-1-2013:p1252:b004:l027","ordinal":171743,"en":"Was beaten hard,"},{"id":"semetey-1-2013:p1252:b004:l028","ordinal":171744,"en":"And Khan Akun's many soldiers"},{"id":"semetey-1-2013:p1252:b004:l029","ordinal":171745,"en":"Now rose and gathered."},{"id":"semetey-1-2013:p1252:b004:l030","ordinal":171746,"en":"They readied their coursers"},{"id":"semetey-1-2013:p1252:b004:l031","ordinal":171747,"en":"And tethered their swift steeds;"},{"id":"semetey-1-2013:p1252:b004:l032","ordinal":171748,"en":"Their unsheathed swords swayed."},{"id":"semetey-1-2013:p1252:b004:l033","ordinal":171749,"en":"The Afghans were formidable,"},{"id":"semetey-1-2013:p1252:b004:l034","ordinal":171750,"en":"And drew together in a body."},{"id":"semetey-1-2013:p1252:b004:l035","ordinal":171751,"en":"They had made a trough from pinewood;"},{"id":"semetey-1-2013:p1252:b004:l036","ordinal":171752,"en":"How many heroes had earlier"},{"id":"semetey-1-2013:p1252:b004:l037","ordinal":171753,"en":"Demanded of Akun,"},{"id":"semetey-1-2013:p1252:b004:l038","ordinal":171754,"en":"\"Give us your old maid.\""},{"id":"semetey-1-2013:p1252:b004:l039","ordinal":171755,"en":"Even then Almighty Allah"},{"id":"semetey-1-2013:p1253:b003:l001","ordinal":171756,"en":"Had kept his dear head safe."},{"id":"semetey-1-2013:p1253:b003:l002","ordinal":171757,"en":"All the khans made ready;"},{"id":"semetey-1-2013:p1253:b003:l003","ordinal":171758,"en":"All the warriors"},{"id":"semetey-1-2013:p1253:b003:l004","ordinal":171759,"en":"Readied sword and gun"},{"id":"semetey-1-2013:p1253:b003:l005","ordinal":171760,"en":"And prepared every weapon."},{"id":"semetey-1-2013:p1253:b003:l006","ordinal":171761,"en":"Their hearts were overcome,"},{"id":"semetey-1-2013:p1253:b003:l007","ordinal":171762,"en":"And they looked ravenous."},{"id":"semetey-1-2013:p1253:b003:l008","ordinal":171763,"en":"Their champions put on iron"},{"id":"semetey-1-2013:p1253:b003:l009","ordinal":171764,"en":"And marched in a line."},{"id":"semetey-1-2013:p1253:b003:l010","ordinal":171765,"en":"The Afghans' great army,"},{"id":"semetey-1-2013:p1253:b003:l011","ordinal":171766,"en":"Wrapping turbans about their waists,"},{"id":"semetey-1-2013:p1253:b003:l012","ordinal":171767,"en":"Made ready in frenzy."},{"id":"semetey-1-2013:p1253:b003:l013","ordinal":171768,"en":"With blue caps perched high"},{"id":"semetey-1-2013:p1253:b003:l014","ordinal":171769,"en":"And argamaks holding their heads proud,"},{"id":"semetey-1-2013:p1253:b003:l015","ordinal":171770,"en":"They wrapped broad sashes around themselves,"},{"id":"semetey-1-2013:p1253:b003:l016","ordinal":171771,"en":"Prayed to the Almighty,"},{"id":"semetey-1-2013:p1253:b003:l017","ordinal":171772,"en":"And made ready at the word \"enemy,\""},{"id":"semetey-1-2013:p1253:b003:l018","ordinal":171773,"en":"Preparing in utter commotion."},{"id":"semetey-1-2013:p1253:b003:l019","ordinal":171774,"en":"Tümönbai, son of Tülkü,"},{"id":"semetey-1-2013:p1253:b003:l020","ordinal":171775,"en":"Prepared his various troops."},{"id":"semetey-1-2013:p1253:b003:l021","ordinal":171776,"en":"Azhibai, son of Azhy,"}]
