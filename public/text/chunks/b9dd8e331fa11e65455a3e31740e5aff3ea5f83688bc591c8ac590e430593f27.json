[{"id":"manas-2010:p0829:b001:l039","ordinal":36609,"en":"The forty split in forty directions."},{"id":"manas-2010:p0829:b001:l040","ordinal":36610,"en":"If one beheld their wrath,"},{"id":"manas-2010:p0829:b001:l041","ordinal":36611,"en":"They seemed ready to slaughter, leaving none;"},{"id":"manas-2010:p0829:b001:l042","ordinal":36612,"en":"Their aspect was that of blood-drinkers."},{"id":"manas-2010:p0830:b001:l001","ordinal":36613,"en":"Manas had gathered them,"},{"id":"manas-2010:p0830:b001:l002","ordinal":36614,"en":"Collected from blood-drinkers,"},{"id":"manas-2010:p0830:b001:l003","ordinal":36615,"en":"A people called the forty companions."},{"id":"manas-2010:p0830:b001:l004","ordinal":36616,"en":"No mortal could defeat them in combat."},{"id":"manas-2010:p0830:b001:l005","ordinal":36617,"en":"All who attacked them,"},{"id":"manas-2010:p0830:b001:l006","ordinal":36618,"en":"They had the custom of drinking their blood."},{"id":"manas-2010:p0830:b001:l007","ordinal":36619,"en":"Thrusting spears and shouting,"},{"id":"manas-2010:p0830:b001:l008","ordinal":36620,"en":"Do you think these companions would not try?"},{"id":"manas-2010:p0830:b001:l009","ordinal":36621,"en":"The enemy they faced, in every direction,"},{"id":"manas-2010:p0830:b001:l010","ordinal":36622,"en":"Do you think these companions would not scatter?"},{"id":"manas-2010:p0830:b001:l011","ordinal":36623,"en":"To signal, “Enter battle,”"},{"id":"manas-2010:p0830:b001:l012","ordinal":36624,"en":"Tiger Bakay the leopard,"},{"id":"manas-2010:p0830:b001:l013","ordinal":36625,"en":"The great drum of elephant hide,"},{"id":"manas-2010:p0830:b001:l014","ordinal":36626,"en":"Now beat it, boom upon boom."},{"id":"manas-2010:p0830:b001:l015","ordinal":36627,"en":"All forty companions,"},{"id":"manas-2010:p0830:b001:l016","ordinal":36628,"en":"Their elders Kyrgyl and Bakay,"},{"id":"manas-2010:p0830:b001:l017","ordinal":36629,"en":"As though slaughter had struck,"},{"id":"manas-2010:p0830:b001:l018","ordinal":36630,"en":"Now shouted and thrust their spears."},{"id":"manas-2010:p0830:b001:l019","ordinal":36631,"en":"The forty companions, stirred to frenzy,"},{"id":"manas-2010:p0830:b001:l020","ordinal":36632,"en":"Zhanaaly and Karach, the two khans,"},{"id":"manas-2010:p0830:b001:l021","ordinal":36633,"en":"They reached those two khans."},{"id":"manas-2010:p0830:b001:l022","ordinal":36634,"en":"Their men numbered five hundred."},{"id":"manas-2010:p0830:b001:l023","ordinal":36635,"en":"Khan Manas's forty mighty men"},{"id":"manas-2010:p0830:b001:l024","ordinal":36636,"en":"Plunged among them."},{"id":"manas-2010:p0830:b001:l025","ordinal":36637,"en":"They mingled in battle;"},{"id":"manas-2010:p0830:b001:l026","ordinal":36638,"en":"Their resourcefulness was beyond measure."},{"id":"manas-2010:p0830:b001:l027","ordinal":36639,"en":"In the clash, each one,"},{"id":"manas-2010:p0830:b001:l028","ordinal":36640,"en":"Of Zhanaaly and Karach's men,"},{"id":"manas-2010:p0830:b001:l029","ordinal":36641,"en":"Speared six as he passed."},{"id":"manas-2010:p0830:b001:l030","ordinal":36642,"en":"Making their winged steeds prance,"},{"id":"manas-2010:p0830:b001:l031","ordinal":36643,"en":"Their agility beyond measure,"},{"id":"manas-2010:p0830:b001:l032","ordinal":36644,"en":"Zhanaaly's five hundred troops,"},{"id":"manas-2010:p0830:b001:l033","ordinal":36645,"en":"Before a word could be spoken,"},{"id":"manas-2010:p0830:b001:l034","ordinal":36646,"en":"In the opening and closing of an eye,"},{"id":"manas-2010:p0830:b001:l035","ordinal":36647,"en":"Zhanaaly's five hundred troops"},{"id":"manas-2010:p0830:b001:l036","ordinal":36648,"en":"They slaughtered utterly, laying them low."},{"id":"manas-2010:p0830:b001:l037","ordinal":36649,"en":"Looming like a towering mountain,"},{"id":"manas-2010:p0830:b001:l038","ordinal":36650,"en":"Devastating Manas approached."},{"id":"manas-2010:p0830:b001:l039","ordinal":36651,"en":"When they saw that devastating man,"},{"id":"manas-2010:p0830:b001:l040","ordinal":36652,"en":"Zhanaaly and Karach, the two khans,"},{"id":"manas-2010:p0830:b001:l041","ordinal":36653,"en":"The strength left their wrists,"},{"id":"manas-2010:p0830:b001:l042","ordinal":36654,"en":"The coverings left their hearts,"},{"id":"manas-2010:p0831:b001:l001","ordinal":36655,"en":"Their chests began to rattle,"},{"id":"manas-2010:p0831:b001:l002","ordinal":36656,"en":"Their beards began to tremble,"},{"id":"manas-2010:p0831:b001:l003","ordinal":36657,"en":"Their knees bent,"},{"id":"manas-2010:p0831:b001:l004","ordinal":36658,"en":"They hurried down from their horses."},{"id":"manas-2010:p0831:b001:l005","ordinal":36659,"en":"The great lead ropes knotted short"},{"id":"manas-2010:p0831:b001:l006","ordinal":36660,"en":"They cast about their necks."},{"id":"manas-2010:p0831:b001:l007","ordinal":36661,"en":"Their swift thoroughbred steeds,"},{"id":"manas-2010:p0831:b001:l008","ordinal":36662,"en":"They offered them all alike."},{"id":"manas-2010:p0831:b001:l009","ordinal":36663,"en":"Folding their hands against their breasts,"},{"id":"manas-2010:p0831:b001:l010","ordinal":36664,"en":"Before blood-stained Manas"},{"id":"manas-2010:p0831:b001:l011","ordinal":36665,"en":"They bowed in submission:"},{"id":"manas-2010:p0831:b001:l012","ordinal":36666,"en":"“If you are an unbeliever, my blood-stained lord,"},{"id":"manas-2010:p0831:b001:l013","ordinal":36667,"en":"You will slaughter us, leaving none."},{"id":"manas-2010:p0831:b001:l014","ordinal":36668,"en":"If you are a Muslim, my warrior,"},{"id":"manas-2010:p0831:b001:l015","ordinal":36669,"en":"You will save us."},{"id":"manas-2010:p0831:b001:l016","ordinal":36670,"en":"We too are of the faith of Islam;"},{"id":"manas-2010:p0831:b001:l017","ordinal":36671,"en":"In origin we are kin."},{"id":"manas-2010:p0831:b001:l018","ordinal":36672,"en":"Heed our words;"},{"id":"manas-2010:p0831:b001:l019","ordinal":36673,"en":"We have submitted to you."},{"id":"manas-2010:p0831:b001:l020","ordinal":36674,"en":"Impose your tribute."},{"id":"manas-2010:p0831:b001:l021","ordinal":36675,"en":"Without ravaging or scattering us, my warrior,"},{"id":"manas-2010:p0831:b001:l022","ordinal":36676,"en":"If you are truly a warrior,"},{"id":"manas-2010:p0831:b001:l023","ordinal":36677,"en":"Take us as your subjects."},{"id":"manas-2010:p0831:b001:l024","ordinal":36678,"en":"You are the Muslims' lion;"},{"id":"manas-2010:p0831:b001:l025","ordinal":36679,"en":"We have agreed to what you say."},{"id":"manas-2010:p0831:b001:l026","ordinal":36680,"en":"Two reins and one lead rope,"},{"id":"manas-2010:p0831:b001:l027","ordinal":36681,"en":"We now give to you."},{"id":"manas-2010:p0831:b001:l028","ordinal":36682,"en":"Throughout the year's twelve months,"},{"id":"manas-2010:p0831:b001:l029","ordinal":36683,"en":"Impose your tribute."},{"id":"manas-2010:p0831:b001:l030","ordinal":36684,"en":"Without killing or destroying us,"},{"id":"manas-2010:p0831:b001:l031","ordinal":36685,"en":"If you are truly a lion,"},{"id":"manas-2010:p0831:b001:l032","ordinal":36686,"en":"Take us as your subjects!"},{"id":"manas-2010:p0831:b001:l033","ordinal":36687,"en":"You were a warrior, you were a lion;"},{"id":"manas-2010:p0831:b001:l034","ordinal":36688,"en":"Let us agree to your commands!"},{"id":"manas-2010:p0831:b001:l035","ordinal":36689,"en":"Sixty otter pelts, a thousand silver ingots,"},{"id":"manas-2010:p0831:b001:l036","ordinal":36690,"en":"Let us give these each year!"},{"id":"manas-2010:p0831:b001:l037","ordinal":36691,"en":"To maintain a khan's treasury,"},{"id":"manas-2010:p0831:b001:l038","ordinal":36692,"en":"You need sacks full of such wealth."},{"id":"manas-2010:p0831:b001:l039","ordinal":36693,"en":"If you clash with those of another faith,"},{"id":"manas-2010:p0831:b001:l040","ordinal":36694,"en":"If you fight with unbelievers,"},{"id":"manas-2010:p0831:b001:l041","ordinal":36695,"en":"Subjects such as ourselves,"},{"id":"manas-2010:p0831:b001:l042","ordinal":36696,"en":"Even if poor, you need a people."},{"id":"manas-2010:p0832:b001:l001","ordinal":36697,"en":"Formerly, there was your saintly elder Bakay,"},{"id":"manas-2010:p0832:b001:l002","ordinal":36698,"en":"And all the champions were there."},{"id":"manas-2010:p0832:b001:l003","ordinal":36699,"en":"We were left where we had not died."},{"id":"manas-2010:p0832:b001:l004","ordinal":36700,"en":"Contending with Bakay over a girl,"},{"id":"manas-2010:p0832:b001:l005","ordinal":36701,"en":"We made a splendid battle."},{"id":"manas-2010:p0832:b001:l006","ordinal":36702,"en":"Since you yourself have come, blessed by Khizir,"},{"id":"manas-2010:p0832:b001:l007","ordinal":36703,"en":"Let us agree to what you say."},{"id":"manas-2010:p0832:b001:l008","ordinal":36704,"en":"The finest girl, Körpöyan,"},{"id":"manas-2010:p0832:b001:l009","ordinal":36705,"en":"Let us give her as a gift."},{"id":"manas-2010:p0832:b001:l010","ordinal":36706,"en":"A khan's heart is a lake, a river;"},{"id":"manas-2010:p0832:b001:l011","ordinal":36707,"en":"Forgive the grievance."},{"id":"manas-2010:p0832:b001:l012","ordinal":36708,"en":"Blood-stained Manas, leopard,"},{"id":"manas-2010:p0832:b001:l013","ordinal":36709,"en":"Do you not need supporters?"},{"id":"manas-2010:p0832:b001:l014","ordinal":36710,"en":"Zhanaaly and Karach,"},{"id":"manas-2010:p0832:b001:l015","ordinal":36711,"en":"Leave us behind alive."},{"id":"manas-2010:p0832:b001:l016","ordinal":36712,"en":"If you roar in terrible might,"},{"id":"manas-2010:p0832:b001:l017","ordinal":36713,"en":"Though we are many, we will die."},{"id":"manas-2010:p0832:b001:l018","ordinal":36714,"en":"You are a lion, we are mice;"},{"id":"manas-2010:p0832:b001:l019","ordinal":36715,"en":"If you strike, what will become of us?"},{"id":"manas-2010:p0832:b001:l020","ordinal":36716,"en":"Be willing to heed our words."},{"id":"manas-2010:p0832:b001:l021","ordinal":36717,"en":"If your heart remains unwilling,"},{"id":"manas-2010:p0832:b001:l022","ordinal":36718,"en":"Overturn and slaughter us all.”"},{"id":"manas-2010:p0832:b001:l023","ordinal":36719,"en":"Zhanaaly and Karach's numerous troops"},{"id":"manas-2010:p0832:b001:l024","ordinal":36720,"en":"Dismounted and gathered round."},{"id":"manas-2010:p0832:b001:l025","ordinal":36721,"en":"To the magnanimous lion himself"},{"id":"manas-2010:p0832:b001:l026","ordinal":36722,"en":"They turned and submitted utterly."},{"id":"manas-2010:p0832:b001:l027","ordinal":36723,"en":"Even in death there was no regret;"},{"id":"manas-2010:p0832:b001:l028","ordinal":36724,"en":"Against leopard lord Manas,"},{"id":"manas-2010:p0832:b001:l029","ordinal":36725,"en":"None remained who could turn a lasso pole!"},{"id":"manas-2010:p0832:b001:l030","ordinal":36726,"en":"Taking Khans Zhanaaly and Karach,"},{"id":"manas-2010:p0832:b001:l031","ordinal":36727,"en":"Such was the magnanimous man's exploit."},{"id":"manas-2010:p0832:b001:l032","ordinal":36728,"en":"If the wolf-man lived,"},{"id":"manas-2010:p0832:b001:l033","ordinal":36729,"en":"His havoc would reach the nations."},{"id":"manas-2010:p0832:b001:l034","ordinal":36730,"en":"He struck stone and made a road,"},{"id":"manas-2010:p0832:b001:l035","ordinal":36731,"en":"Laid many lands low."},{"id":"manas-2010:p0832:b001:l036","ordinal":36732,"en":"Making a costly sheath for his sword,"},{"id":"manas-2010:p0832:b001:l037","ordinal":36733,"en":"Raising strife in many lands,"},{"id":"manas-2010:p0832:b001:l038","ordinal":36734,"en":"Large fur caps and long coats,"},{"id":"manas-2010:p0832:b001:l039","ordinal":36735,"en":"Spreading boundless deeds of valor,"},{"id":"manas-2010:p0832:b001:l040","ordinal":36736,"en":"Subduing the people of Chambyl,"},{"id":"manas-2010:p0832:b001:l041","ordinal":36737,"en":"Long leather shoes and leather trousers,"},{"id":"manas-2010:p0832:b001:l042","ordinal":36738,"en":"Raiding the Kalcha and taking girls,"},{"id":"manas-2010:p0833:b001:l001","ordinal":36739,"en":"Your blood-stained warrior had set out,"},{"id":"manas-2010:p0833:b001:l002","ordinal":36740,"en":"Working his craft upon the earth."},{"id":"manas-2010:p0833:b001:l003","ordinal":36741,"en":"Untouched by Akkula's feet,"},{"id":"manas-2010:p0833:b001:l004","ordinal":36742,"en":"Could any land remain whole?"},{"id":"manas-2010:p0833:b001:l005","ordinal":36743,"en":"Never hearing his battle cry,"},{"id":"manas-2010:p0833:b001:l006","ordinal":36744,"en":"Could any warrior remain whole?"},{"id":"manas-2010:p0833:b001:l007","ordinal":36745,"en":"Unstruck by the gray falcon,"},{"id":"manas-2010:p0833:b001:l008","ordinal":36746,"en":"Could any swan remain whole?"},{"id":"manas-2010:p0833:b001:l009","ordinal":36747,"en":"Untouched by that Manas,"},{"id":"manas-2010:p0833:b001:l010","ordinal":36748,"en":"Could any people remain whole?"},{"id":"manas-2010:p0833:b001:l011","ordinal":36749,"en":"Before even that much time had passed,"},{"id":"manas-2010:p0833:b001:l012","ordinal":36750,"en":"Before this or that could be said,"},{"id":"manas-2010:p0833:b001:l013","ordinal":36751,"en":"In the opening and closing of an eye,"},{"id":"manas-2010:p0833:b001:l014","ordinal":36752,"en":"Körpöyan, of whom Bakay spoke,"},{"id":"manas-2010:p0833:b001:l015","ordinal":36753,"en":"Was the finest of women,"},{"id":"manas-2010:p0833:b001:l016","ordinal":36754,"en":"The daughter of Khan Karach."},{"id":"manas-2010:p0833:b001:l017","ordinal":36755,"en":"They dressed her in exquisite silk."},{"id":"manas-2010:p0833:b001:l018","ordinal":36756,"en":"“A winged steed for riding into battle,” they said,"},{"id":"manas-2010:p0833:b001:l019","ordinal":36757,"en":"And mounted her upon Artoru."},{"id":"manas-2010:p0833:b001:l020","ordinal":36758,"en":"Your elder, wolf-man Bakay,"},{"id":"manas-2010:p0833:b001:l021","ordinal":36759,"en":"Received Körpöyan as a gift."},{"id":"manas-2010:p0833:b001:l022","ordinal":36760,"en":"They made a scandal of it, they say;"},{"id":"manas-2010:p0833:b001:l023","ordinal":36761,"en":"They stood spreading gossip, they say."},{"id":"manas-2010:p0833:b001:l024","ordinal":36762,"en":"“They have drowned in booty,” they said;"},{"id":"manas-2010:p0833:b001:l025","ordinal":36763,"en":"“He made her a wife taken as booty,” they said."},{"id":"manas-2010:p0833:b001:l026","ordinal":36764,"en":"“He used his overwhelming force,” they said."},{"id":"manas-2010:p0833:b001:l027","ordinal":36765,"en":"Without a marriage rite, without a feast,"},{"id":"manas-2010:p0833:b001:l028","ordinal":36766,"en":"“He took a wife without the rite,” they said."},{"id":"manas-2010:p0833:b001:l029","ordinal":36767,"en":"There is a striking tale to tell:"},{"id":"manas-2010:p0833:b001:l030","ordinal":36768,"en":"Against the magnanimous man and Bakay,"},{"id":"manas-2010:p0833:b001:l031","ordinal":36769,"en":"Zhanaaly and Karach bore a grudge."},{"id":"manas-2010:p0833:b001:l032","ordinal":36770,"en":"Zhanaaly's Narkyzyl,"},{"id":"manas-2010:p0833:b001:l033","ordinal":36771,"en":"A true winged steed with no brains,"},{"id":"manas-2010:p0833:b001:l034","ordinal":36772,"en":"A pacing gait on the road, gentle to its rider,"},{"id":"manas-2010:p0833:b001:l035","ordinal":36773,"en":"A great broad-chested winged steed,"},{"id":"manas-2010:p0833:b001:l037","ordinal":36774,"en":"Owl-footed for long journeys,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"manas-2010:p0833:b001:l038","ordinal":36775,"en":"No such horse could be found."},{"id":"manas-2010:p0833:b001:l039","ordinal":36776,"en":"Upon the earth, for a warrior,"},{"id":"manas-2010:p0833:b001:l040","ordinal":36777,"en":"No such swift horse could be encountered."},{"id":"manas-2010:p0833:b001:l041","ordinal":36778,"en":"Your elder Bakay pondered this."},{"id":"manas-2010:p0833:b001:l042","ordinal":36779,"en":"The finest of forty companions,"},{"id":"manas-2010:p0834:b001:l001","ordinal":36780,"en":"More vigorous than many,"},{"id":"manas-2010:p0834:b001:l002","ordinal":36781,"en":"Open-browed, broad-chested,"},{"id":"manas-2010:p0834:b001:l003","ordinal":36782,"en":"To capable Boz Uul,"},{"id":"manas-2010:p0834:b001:l004","ordinal":36783,"en":"Your elder Bakay the leopard,"},{"id":"manas-2010:p0834:b001:l005","ordinal":36784,"en":"Biting his lip and winking,"},{"id":"manas-2010:p0834:b001:l006","ordinal":36785,"en":"Without the forty companions seeing,"},{"id":"manas-2010:p0834:b001:l007","ordinal":36786,"en":"Was making a gesture."},{"id":"manas-2010:p0834:b001:l008","ordinal":36787,"en":"His mighty man understood a wink,"},{"id":"manas-2010:p0834:b001:l009","ordinal":36788,"en":"One who made the distant near,"},{"id":"manas-2010:p0834:b001:l010","ordinal":36789,"en":"A close kinsman of Manas,"},{"id":"manas-2010:p0834:b001:l011","ordinal":36790,"en":"Toward Khan Bakay"},{"id":"manas-2010:p0834:b001:l012","ordinal":36791,"en":"He leaped like a roe deer."},{"id":"manas-2010:p0834:b001:l013","ordinal":36792,"en":"When he came to Khan Bakay,"},{"id":"manas-2010:p0834:b001:l014","ordinal":36793,"en":"Such was Bakay's way,"},{"id":"manas-2010:p0834:b001:l015","ordinal":36794,"en":"Known among warriors for his wisdom;"},{"id":"manas-2010:p0834:b001:l016","ordinal":36795,"en":"He spoke to Boz Uul:"},{"id":"manas-2010:p0834:b001:l017","ordinal":36796,"en":"“Chambyl-Bel is no land of ours."},{"id":"manas-2010:p0834:b001:l018","ordinal":36797,"en":"Zhanaaly and Karach, the two giants,"},{"id":"manas-2010:p0834:b001:l019","ordinal":36798,"en":"At bottom are no people of ours."},{"id":"manas-2010:p0834:b001:l020","ordinal":36799,"en":"Of Zhanaaly and Karach, the two,"},{"id":"manas-2010:p0834:b001:l021","ordinal":36800,"en":"Deceit lies in their words,"},{"id":"manas-2010:p0834:b001:l022","ordinal":36801,"en":"Mischief lies in their eyes."},{"id":"manas-2010:p0834:b001:l023","ordinal":36802,"en":"When they grow fat and recover,"},{"id":"manas-2010:p0834:b001:l024","ordinal":36803,"en":"They will chew through the lead rope."},{"id":"manas-2010:p0834:b001:l025","ordinal":36804,"en":"If we become a little weaker,"},{"id":"manas-2010:p0834:b001:l026","ordinal":36805,"en":"They stand ready to quarrel."},{"id":"manas-2010:p0834:b001:l027","ordinal":36806,"en":"When we leave this place,"},{"id":"manas-2010:p0834:b001:l028","ordinal":36807,"en":"He will throw his leg over the tethering rail;"},{"id":"manas-2010:p0834:b001:l029","ordinal":36808,"en":"Zhanaaly, whose words are cold,"},{"id":"manas-2010:p0834:b001:l030","ordinal":36809,"en":"Will sound the trumpet's tune."},{"id":"manas-2010:p0834:b001:l031","ordinal":36810,"en":"Before he returns to this land,"},{"id":"manas-2010:p0834:b001:l032","ordinal":36811,"en":"Narkyzyl, whom he will not give if asked,"},{"id":"manas-2010:p0834:b001:l033","ordinal":36812,"en":"Go cast a threatening lasso upon him."},{"id":"manas-2010:p0834:b001:l034","ordinal":36813,"en":"Narkyzyl, whom he will not give openly,"},{"id":"manas-2010:p0834:b001:l035","ordinal":36814,"en":"Ask unseen and bring him back."},{"id":"manas-2010:p0834:b001:l036","ordinal":36815,"en":"One fit to take as booty,"},{"id":"manas-2010:p0834:b001:l037","ordinal":36816,"en":"For Manas's wife Akylay,"},{"id":"manas-2010:p0834:b001:l038","ordinal":36817,"en":"He is a fitting mount.”"},{"id":"manas-2010:p0834:b001:l039","ordinal":36818,"en":"When Bakay said this,"},{"id":"manas-2010:p0834:b001:l040","ordinal":36819,"en":"Boz Uul flew like an arrow,"},{"id":"manas-2010:p0834:b001:l041","ordinal":36820,"en":"To Zhanaaly and Karach, the two,"},{"id":"manas-2010:p0834:b001:l042","ordinal":36821,"en":"And now reached them again."},{"id":"manas-2010:p0835:b001:l001","ordinal":36822,"en":"Narkyzyl beneath him"},{"id":"manas-2010:p0835:b001:l002","ordinal":36823,"en":"Has a whole armful of tail,"},{"id":"manas-2010:p0835:b001:l003","ordinal":36824,"en":"He shows the marks of a winged steed,"},{"id":"manas-2010:p0835:b001:l004","ordinal":36825,"en":"No ordinary tail and mane,"},{"id":"manas-2010:p0835:b001:l005","ordinal":36826,"en":"No mount for ordinary men."},{"id":"manas-2010:p0835:b001:l006","ordinal":36827,"en":"I came desiring the Red Steed;"},{"id":"manas-2010:p0835:b001:l007","ordinal":36828,"en":"At the sight of this Red Steed"},{"id":"manas-2010:p0835:b001:l008","ordinal":36829,"en":"My heart was stirred anew."},{"id":"manas-2010:p0835:b001:l009","ordinal":36830,"en":"With a bloody spear in hand,"},{"id":"manas-2010:p0835:b001:l010","ordinal":36831,"en":"Swaying this way and that,"},{"id":"manas-2010:p0835:b001:l011","ordinal":36832,"en":"He is a mount for the bloodstained warrior;"},{"id":"manas-2010:p0835:b001:l012","ordinal":36833,"en":"Turning his neck like a stag's,"},{"id":"manas-2010:p0835:b001:l013","ordinal":36834,"en":"Galloping over broken ground,"},{"id":"manas-2010:p0835:b001:l014","ordinal":36835,"en":"He is a mount for thoroughbreds to ride."},{"id":"manas-2010:p0835:b001:l015","ordinal":36836,"en":"With an unsheathed sword strapped on,"},{"id":"manas-2010:p0835:b001:l016","ordinal":36837,"en":"Circling back from the emperor's land,"},{"id":"manas-2010:p0835:b001:l017","ordinal":36838,"en":"He is a mount to ride to battle."},{"id":"manas-2010:p0835:b001:l018","ordinal":36839,"en":"His back is high, his withers low;"},{"id":"manas-2010:p0835:b001:l019","ordinal":36840,"en":"He will not falter on the hills."},{"id":"manas-2010:p0835:b001:l020","ordinal":36841,"en":"He shows the marks of a winged steed,"},{"id":"manas-2010:p0835:b001:l021","ordinal":36842,"en":"For fierce, wolf-maned Manas"},{"id":"manas-2010:p0835:b001:l022","ordinal":36843,"en":"He is a fitting mount."},{"id":"manas-2010:p0835:b001:l023","ordinal":36844,"en":"Agree to what I say:"},{"id":"manas-2010:p0835:b001:l024","ordinal":36845,"en":"Narkyzyl is the steed I want;"},{"id":"manas-2010:p0835:b001:l025","ordinal":36846,"en":"I came to ask for him—give him to me!"},{"id":"manas-2010:p0835:b001:l026","ordinal":36847,"en":"If you give Narkyzyl, I have this to say:"},{"id":"manas-2010:p0835:b001:l027","ordinal":36848,"en":"'If you do not give Narkyzyl,"},{"id":"manas-2010:p0835:b001:l028","ordinal":36849,"en":"In the end I shall have a grudge against you.'"},{"id":"manas-2010:p0835:b001:l029","ordinal":36850,"en":"Clad in chain mail,"},{"id":"manas-2010:p0835:b001:l030","ordinal":36851,"en":"He is a horse for heroes to ride!”"},{"id":"manas-2010:p0835:b001:l031","ordinal":36852,"en":"God had struck Boz Uul:"},{"id":"manas-2010:p0835:b001:l032","ordinal":36853,"en":"Speaking now fairly, now harshly,"},{"id":"manas-2010:p0835:b001:l033","ordinal":36854,"en":"He stood demanding Narkyzyl."},{"id":"manas-2010:p0835:b001:l034","ordinal":36855,"en":"He was a brave man; to Boz Uul"},{"id":"manas-2010:p0835:b001:l035","ordinal":36856,"en":"The lord could not say, “I will not,”"},{"id":"manas-2010:p0835:b001:l036","ordinal":36857,"en":"And stood there groaning."},{"id":"manas-2010:p0835:b001:l037","ordinal":36858,"en":"They lowered their heads,"},{"id":"manas-2010:p0835:b001:l038","ordinal":36859,"en":"Saying, “This is the worst trouble of all,”"},{"id":"manas-2010:p0835:b001:l039","ordinal":36860,"en":"And scratched the ground."},{"id":"manas-2010:p0835:b001:l040","ordinal":36861,"en":"Their strength was spent, their vigor gone;"},{"id":"manas-2010:p0835:b001:l041","ordinal":36862,"en":"They had no power to refuse!"},{"id":"manas-2010:p0835:b001:l042","ordinal":36863,"en":"Narkyzyl, whom he would not give when asked,"},{"id":"manas-2010:p0836:b001:l001","ordinal":36864,"en":"The stouthearted Boz Uul"}]
