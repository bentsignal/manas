[{"id":"semetey-1-2013:p0623:b004:l037","ordinal":124673,"en":"With your magnanimous lion father"},{"id":"semetey-1-2013:p0623:b004:l038","ordinal":124674,"en":"Saikal fought alone with spears."},{"id":"semetey-1-2013:p0623:b004:l039","ordinal":124675,"en":"The points of seven spears bent,"},{"id":"semetey-1-2013:p0624:b003:l001","ordinal":124676,"en":"Unable to overcome one another,"},{"id":"semetey-1-2013:p0624:b003:l002","ordinal":124677,"en":"They fought six days without pause,"},{"id":"semetey-1-2013:p0624:b003:l003","ordinal":124678,"en":"Remaining upright, never dismounting."},{"id":"semetey-1-2013:p0624:b003:l004","ordinal":124679,"en":"Only a giant like Almambet remained."},{"id":"semetey-1-2013:p0624:b003:l005","ordinal":124680,"en":"Khan Manas's forty champions"},{"id":"semetey-1-2013:p0624:b003:l006","ordinal":124681,"en":"Were all left on foot in the sand,"},{"id":"semetey-1-2013:p0624:b003:l007","ordinal":124682,"en":"Barely escaping death."},{"id":"semetey-1-2013:p0624:b003:l008","ordinal":124683,"en":"With golden forelock and tasselled sash,"},{"id":"semetey-1-2013:p0624:b003:l009","ordinal":124684,"en":"Khan Azyz's Almambet"},{"id":"semetey-1-2013:p0624:b003:l010","ordinal":124685,"en":"Fought alone without pause."},{"id":"semetey-1-2013:p0624:b003:l011","ordinal":124686,"en":"Maiden Saikal's wrath"},{"id":"semetey-1-2013:p0624:b003:l012","ordinal":124687,"en":"No one could endure."},{"id":"semetey-1-2013:p0624:b003:l013","ordinal":124688,"en":"They fought with spears for sixty days."},{"id":"semetey-1-2013:p0624:b003:l014","ordinal":124689,"en":"When the sixty-first day came,"},{"id":"semetey-1-2013:p0624:b003:l015","ordinal":124690,"en":"Manas the bloodthirsty one, alone—"},{"id":"semetey-1-2013:p0624:b003:l016","ordinal":124691,"en":"Karacha's Khan Saikal"},{"id":"semetey-1-2013:p0624:b003:l017","ordinal":124692,"en":"Thrust at him in her wrath."},{"id":"semetey-1-2013:p0624:b003:l018","ordinal":124693,"en":"She bent your khan father down."},{"id":"semetey-1-2013:p0624:b003:l019","ordinal":124694,"en":"When some terrible thing to Manas"},{"id":"semetey-1-2013:p0624:b003:l020","ordinal":124695,"en":"She was about to do,"},{"id":"semetey-1-2013:p0624:b003:l021","ordinal":124696,"en":"Bending the precious one from his horse,"},{"id":"semetey-1-2013:p0624:b003:l022","ordinal":124697,"en":"When she was about to seize him,"},{"id":"semetey-1-2013:p0624:b003:l023","ordinal":124698,"en":"Khan Azyz's Almambet,"},{"id":"semetey-1-2013:p0624:b003:l024","ordinal":124699,"en":"Barely surviving,"},{"id":"semetey-1-2013:p0624:b003:l025","ordinal":124700,"en":"Came to Khan Manas's aid."},{"id":"semetey-1-2013:p0624:b003:l026","ordinal":124701,"en":"Almam the Leopard fought with spears,"},{"id":"semetey-1-2013:p0624:b003:l027","ordinal":124702,"en":"And waged a fierce battle."},{"id":"semetey-1-2013:p0624:b003:l028","ordinal":124703,"en":"Your bloodthirsty father Manas"},{"id":"semetey-1-2013:p0624:b003:l029","ordinal":124704,"en":"From Khan Saikal's hands"},{"id":"semetey-1-2013:p0624:b003:l030","ordinal":124705,"en":"He rescued."},{"id":"semetey-1-2013:p0624:b003:l031","ordinal":124706,"en":"Akkula had grown fat."},{"id":"semetey-1-2013:p0624:b003:l032","ordinal":124707,"en":"Your heedless father"},{"id":"semetey-1-2013:p0624:b003:l033","ordinal":124708,"en":"That year had grown bulky,"},{"id":"semetey-1-2013:p0624:b003:l034","ordinal":124709,"en":"And become very stout."},{"id":"semetey-1-2013:p0624:b003:l035","ordinal":124710,"en":"When your father could not bend,"},{"id":"semetey-1-2013:p0624:b003:l036","ordinal":124711,"en":"Maiden Saikal found her chance,"},{"id":"semetey-1-2013:p0624:b003:l037","ordinal":124712,"en":"And thrust at him, jolting him back like this."},{"id":"semetey-1-2013:p0624:b003:l039","ordinal":124713,"en":"The valiant woman Kanykei"},{"id":"semetey-1-2013:p0624:b004:l001","ordinal":124714,"en":"Summered at Taragai."},{"id":"semetey-1-2013:p0624:b004:l002","ordinal":124715,"en":"Akkula and Manas,"},{"id":"semetey-1-2013:p0624:b004:l003","ordinal":124716,"en":"She bound the two side by side."},{"id":"semetey-1-2013:p0624:b004:l004","ordinal":124717,"en":"Bringing him to proper fighting condition,"},{"id":"semetey-1-2013:p0624:b004:l005","ordinal":124718,"en":"She released Manas."},{"id":"semetey-1-2013:p0624:b004:l006","ordinal":124719,"en":"They went down toward Saparbai,"},{"id":"semetey-1-2013:p0624:b004:l007","ordinal":124720,"en":"Along Zhaman-Suu,"},{"id":"semetey-1-2013:p0624:b004:l008","ordinal":124721,"en":"Fought in Great Turpan."},{"id":"semetey-1-2013:p0624:b004:l009","ordinal":124722,"en":"When they reached broad Ak-Suu,"},{"id":"semetey-1-2013:p0624:b004:l010","ordinal":124723,"en":"Pursuing Maiden Saikal,"},{"id":"semetey-1-2013:p0624:b004:l011","ordinal":124724,"en":"At Kum-Aryk's Kum-Darya,"},{"id":"semetey-1-2013:p0624:b004:l012","ordinal":124725,"en":"He defeated her at Kum-Darya."},{"id":"semetey-1-2013:p0624:b004:l013","ordinal":124726,"en":"Khan Manas, God's lion,"},{"id":"semetey-1-2013:p0624:b004:l014","ordinal":124727,"en":"Made the poor girl whimper,"},{"id":"semetey-1-2013:p0624:b004:l015","ordinal":124728,"en":"And swept her up as his captive."},{"id":"semetey-1-2013:p0624:b004:l016","ordinal":124729,"en":"Khwajas and mullahs were gathered."},{"id":"semetey-1-2013:p0624:b004:l017","ordinal":124730,"en":"A marriage for the next world"},{"id":"semetey-1-2013:p0624:b004:l018","ordinal":124731,"en":"Was solemnized with Khan Manas."},{"id":"semetey-1-2013:p0624:b004:l019","ordinal":124732,"en":"They made a pledged oath,"},{"id":"semetey-1-2013:p0624:b004:l020","ordinal":124733,"en":"Chewing white wheat flour,"},{"id":"semetey-1-2013:p0624:b004:l021","ordinal":124734,"en":"Clasping the holy Word,"},{"id":"semetey-1-2013:p0624:b004:l022","ordinal":124735,"en":"They stood by their promise."},{"id":"semetey-1-2013:p0624:b004:l023","ordinal":124736,"en":"A marriage for the next world"},{"id":"semetey-1-2013:p0624:b004:l024","ordinal":124737,"en":"Those men blessed by Kydyr solemnized."},{"id":"semetey-1-2013:p0624:b004:l025","ordinal":124738,"en":"The forty companions in iron armor"},{"id":"semetey-1-2013:p0624:b004:l026","ordinal":124739,"en":"She clothed in her joy."},{"id":"semetey-1-2013:p0624:b004:l027","ordinal":124740,"en":"‘Give it to your only son,’ she said."},{"id":"semetey-1-2013:p0624:b004:l028","ordinal":124741,"en":"The roan while still a colt"},{"id":"semetey-1-2013:p0624:b004:l029","ordinal":124742,"en":"She gave Khan Manas to ride,"},{"id":"semetey-1-2013:p0624:b004:l030","ordinal":124743,"en":"And stood by her promise."},{"id":"semetey-1-2013:p0624:b004:l031","ordinal":124744,"en":"‘For forty days when you are dying,"},{"id":"semetey-1-2013:p0624:b004:l032","ordinal":124745,"en":"I shall care for you myself,’ she said,"},{"id":"semetey-1-2013:p0624:b004:l033","ordinal":124746,"en":"And made that promise."},{"id":"semetey-1-2013:p0624:b004:l034","ordinal":124747,"en":"When your leopard father Manas"},{"id":"semetey-1-2013:p0624:b004:l035","ordinal":124748,"en":"Lay sick upon his pillow,"},{"id":"semetey-1-2013:p0624:b004:l036","ordinal":124749,"en":"Forty days before he died,"},{"id":"semetey-1-2013:p0624:b004:l037","ordinal":124750,"en":"Saikal came."},{"id":"semetey-1-2013:p0624:b004:l038","ordinal":124751,"en":"‘A companion for the next world,"},{"id":"semetey-1-2013:p0624:b004:l039","ordinal":124752,"en":"I shall lie in his embrace,’ she said,"},{"id":"semetey-1-2013:p0625:b003:l001","ordinal":124753,"en":"And made that promise."},{"id":"semetey-1-2013:p0625:b003:l002","ordinal":124754,"en":"When your leopard father died,"},{"id":"semetey-1-2013:p0625:b003:l003","ordinal":124755,"en":"Karacha's Saikal"},{"id":"semetey-1-2013:p0625:b003:l004","ordinal":124756,"en":"Clawed her face until it bled,"},{"id":"semetey-1-2013:p0625:b003:l005","ordinal":124757,"en":"Tore out her black hair,"},{"id":"semetey-1-2013:p0625:b003:l006","ordinal":124758,"en":"And put on loose black mourning clothes."},{"id":"semetey-1-2013:p0625:b003:l007","ordinal":124759,"en":"For Manas, the lion warrior,"},{"id":"semetey-1-2013:p0625:b003:l008","ordinal":124760,"en":"She grieved for seven days."},{"id":"semetey-1-2013:p0625:b003:l009","ordinal":124761,"en":"When the full seven days had passed,"},{"id":"semetey-1-2013:p0625:b003:l010","ordinal":124762,"en":"When the seventh-day memorial feast was given,"},{"id":"semetey-1-2013:p0625:b003:l011","ordinal":124763,"en":"Karacha's Saikal"},{"id":"semetey-1-2013:p0625:b003:l012","ordinal":124764,"en":"Departed toward her people."},{"id":"semetey-1-2013:p0625:b003:l013","ordinal":124765,"en":"Karacha's daughter Saikal,"},{"id":"semetey-1-2013:p0625:b003:l014","ordinal":124766,"en":"Ravaging both her cheeks,"},{"id":"semetey-1-2013:p0625:b003:l015","ordinal":124767,"en":"Went on clawing them, I heard."},{"id":"semetey-1-2013:p0625:b003:l016","ordinal":124768,"en":"Beyond all measure, for Manas,"},{"id":"semetey-1-2013:p0625:b003:l017","ordinal":124769,"en":"She went on grieving, I heard."},{"id":"semetey-1-2013:p0625:b003:l018","ordinal":124770,"en":"When Maiden Saikal arrived in sorrow,"},{"id":"semetey-1-2013:p0625:b003:l019","ordinal":124771,"en":"Wailing, ‘My leopard!’"},{"id":"semetey-1-2013:p0625:b003:l020","ordinal":124772,"en":"The many Oigut and Karacha"},{"id":"semetey-1-2013:p0625:b003:l021","ordinal":124773,"en":"Served her with great care,"},{"id":"semetey-1-2013:p0625:b003:l022","ordinal":124774,"en":"And showed her reverence."},{"id":"semetey-1-2013:p0625:b003:l023","ordinal":124775,"en":"On reaching home, Maiden Saikal"},{"id":"semetey-1-2013:p0625:b003:l024","ordinal":124776,"en":"Departed this world and died, they say."},{"id":"semetey-1-2013:p0625:b003:l025","ordinal":124777,"en":"At dawn her body was gone."},{"id":"semetey-1-2013:p0625:b003:l026","ordinal":124778,"en":"Her people cried out in grief;"},{"id":"semetey-1-2013:p0625:b003:l027","ordinal":124779,"en":"Her father wept and sobbed."},{"id":"semetey-1-2013:p0625:b003:l028","ordinal":124780,"en":"Throughout the face of the earth"},{"id":"semetey-1-2013:p0625:b003:l029","ordinal":124781,"en":"They spread the news fully."},{"id":"semetey-1-2013:p0625:b003:l030","ordinal":124782,"en":"Maiden Saikal's body was gone;"},{"id":"semetey-1-2013:p0625:b003:l031","ordinal":124783,"en":"She had vanished into the unseen."},{"id":"semetey-1-2013:p0625:b003:l032","ordinal":124784,"en":"God must have granted her wish."},{"id":"semetey-1-2013:p0625:b003:l033","ordinal":124785,"en":"A lawful spouse for the next world,"},{"id":"semetey-1-2013:p0625:b003:l034","ordinal":124786,"en":"Renowned Saikal must have come."},{"id":"semetey-1-2013:p0625:b003:l035","ordinal":124787,"en":"Your father was the son of a houri,"},{"id":"semetey-1-2013:p0625:b003:l036","ordinal":124788,"en":"And she a houri's daughter."},{"id":"semetey-1-2013:p0625:b003:l037","ordinal":124789,"en":"They must have entered into joy."},{"id":"semetey-1-2013:p0625:b003:l038","ordinal":124790,"en":"The two lovers joined together,"},{"id":"semetey-1-2013:p0625:b003:l039","ordinal":124791,"en":"And must be lying in one bed."},{"id":"semetey-1-2013:p0625:b005:l001","ordinal":124792,"en":"Their wish must have been granted."},{"id":"semetey-1-2013:p0625:b005:l002","ordinal":124793,"en":"Into your khan father's embrace,"},{"id":"semetey-1-2013:p0625:b005:l003","ordinal":124794,"en":"Saikal must have come from the unseen."},{"id":"semetey-1-2013:p0625:b005:l004","ordinal":124795,"en":"The one tucked close at his head—"},{"id":"semetey-1-2013:p0625:b005:l005","ordinal":124796,"en":"That dear child, twelve years old,"},{"id":"semetey-1-2013:p0625:b005:l006","ordinal":124797,"en":"Was Koenaly,"},{"id":"semetey-1-2013:p0625:b005:l007","ordinal":124798,"en":"The true son of Kokboru,"},{"id":"semetey-1-2013:p0625:b005:l008","ordinal":124799,"en":"Kokboru, son of Urumkan."},{"id":"semetey-1-2013:p0625:b005:l009","ordinal":124800,"en":"They had stirred the stars in the heavens."},{"id":"semetey-1-2013:p0625:b005:l010","ordinal":124801,"en":"Your father and Kokboru"},{"id":"semetey-1-2013:p0625:b005:l011","ordinal":124802,"en":"Swore friendship three times in one day."},{"id":"semetey-1-2013:p0625:b005:l012","ordinal":124803,"en":"When your father lay ill,"},{"id":"semetey-1-2013:p0625:b005:l013","ordinal":124804,"en":"His friend Boru came."},{"id":"semetey-1-2013:p0625:b005:l014","ordinal":124805,"en":"His dear Koenaly, aged twelve,"},{"id":"semetey-1-2013:p0625:b005:l015","ordinal":124806,"en":"The talmyz of the waters of Jeti-Özön,"},{"id":"semetey-1-2013:p0625:b005:l016","ordinal":124807,"en":"Kokboru's only child, born late in his life,"},{"id":"semetey-1-2013:p0625:b005:l018","ordinal":124808,"en":"At the age of twelve,"},{"id":"semetey-1-2013:p0625:b005:l019","ordinal":124809,"en":"He was a hero beyond all other mortals."},{"id":"semetey-1-2013:p0625:b005:l020","ordinal":124810,"en":"All was complete in him."},{"id":"semetey-1-2013:p0625:b005:l021","ordinal":124811,"en":"Your father Manas—"},{"id":"semetey-1-2013:p0625:b005:l022","ordinal":124812,"en":"He was the lion who served him."},{"id":"semetey-1-2013:p0625:b005:l023","ordinal":124813,"en":"When your father could barely endure,"},{"id":"semetey-1-2013:p0625:b005:l024","ordinal":124814,"en":"For your fierce-maned father Manas,"},{"id":"semetey-1-2013:p0625:b005:l025","ordinal":124815,"en":"Throwing the whole world into confusion,"},{"id":"semetey-1-2013:p0625:b005:l026","ordinal":124816,"en":"As he served your father,"},{"id":"semetey-1-2013:p0625:b005:l027","ordinal":124817,"en":"The khwajas in white turbans,"},{"id":"semetey-1-2013:p0625:b005:l028","ordinal":124818,"en":"‘For Manas, my father's sworn brother,"},{"id":"semetey-1-2013:p0625:b005:l029","ordinal":124819,"en":"They will not recite the Qur’an,’ he said."},{"id":"semetey-1-2013:p0625:b005:l030","ordinal":124820,"en":"He bound them with their turbans."},{"id":"semetey-1-2013:p0625:b005:l031","ordinal":124821,"en":"Some sixty khwajas"},{"id":"semetey-1-2013:p0625:b005:l032","ordinal":124822,"en":"He slaughtered and laid low."},{"id":"semetey-1-2013:p0625:b005:l033","ordinal":124823,"en":"The forty ishans of Andizhan"},{"id":"semetey-1-2013:p0625:b005:l034","ordinal":124824,"en":"He beat with a whip,"},{"id":"semetey-1-2013:p0625:b005:l035","ordinal":124825,"en":"Made them all run on foot,"},{"id":"semetey-1-2013:p0625:b005:l036","ordinal":124826,"en":"Made them say, ‘We submit, elder brother!’"},{"id":"semetey-1-2013:p0625:b005:l037","ordinal":124827,"en":"Made them taste suffering while alive,"},{"id":"semetey-1-2013:p0625:b005:l038","ordinal":124828,"en":"Inflicted mighty torment on them,"},{"id":"semetey-1-2013:p0625:b005:l039","ordinal":124829,"en":"Hung saddlebags about their necks,"},{"id":"semetey-1-2013:p0626:b003:l001","ordinal":124830,"en":"He broke whoever he met,"},{"id":"semetey-1-2013:p0626:b003:l002","ordinal":124831,"en":"Beat the forty ishans,"},{"id":"semetey-1-2013:p0626:b003:l003","ordinal":124832,"en":"And made them serve your father."},{"id":"semetey-1-2013:p0626:b003:l004","ordinal":124833,"en":"Ak Eshen in Mecca"},{"id":"semetey-1-2013:p0626:b003:l005","ordinal":124834,"en":"He had brought within five days."},{"id":"semetey-1-2013:p0626:b003:l006","ordinal":124835,"en":"Khans Koshoi and Toshtuk,"},{"id":"semetey-1-2013:p0626:b003:l007","ordinal":124836,"en":"‘At the games for Manas, my father's sworn brother,"},{"id":"semetey-1-2013:p0626:b003:l008","ordinal":124837,"en":"I shall stake them as prizes,’ he said."},{"id":"semetey-1-2013:p0626:b003:l009","ordinal":124838,"en":"Of strength and fortune."},{"id":"semetey-1-2013:p0626:b003:l010","ordinal":124839,"en":"Abyke and Kobosh, all six,"},{"id":"semetey-1-2013:p0626:b003:l011","ordinal":124840,"en":"‘As the prize for the second horse,"},{"id":"semetey-1-2013:p0626:b003:l012","ordinal":124841,"en":"I shall stake these six,’ he said,"},{"id":"semetey-1-2013:p0626:b003:l013","ordinal":124842,"en":"And left them all helpless."},{"id":"semetey-1-2013:p0626:b003:l014","ordinal":124843,"en":"When your father was gravely ill,"},{"id":"semetey-1-2013:p0626:b003:l015","ordinal":124844,"en":"He was the warrior who served him."},{"id":"semetey-1-2013:p0626:b003:l016","ordinal":124845,"en":"Felled in his flowering days,"},{"id":"semetey-1-2013:p0626:b003:l017","ordinal":124846,"en":"He was the lion who spared nothing."},{"id":"semetey-1-2013:p0626:b003:l018","ordinal":124847,"en":"‘I shall not stand idly by,’ he said."},{"id":"semetey-1-2013:p0626:b003:l019","ordinal":124848,"en":"‘For Manas, my father's sworn brother,"},{"id":"semetey-1-2013:p0626:b003:l020","ordinal":124849,"en":"I shall gather all the surrounding people."},{"id":"semetey-1-2013:p0626:b003:l021","ordinal":124850,"en":"The people who obey me"},{"id":"semetey-1-2013:p0626:b003:l022","ordinal":124851,"en":"I shall honor as guests."},{"id":"semetey-1-2013:p0626:b003:l023","ordinal":124852,"en":"If any people will not obey,"},{"id":"semetey-1-2013:p0626:b003:l024","ordinal":124853,"en":"I shall use force against them."},{"id":"semetey-1-2013:p0626:b003:l025","ordinal":124854,"en":"Those who fall into my hands,"},{"id":"semetey-1-2013:p0626:b003:l026","ordinal":124855,"en":"For Manas, my father's sworn brother,"},{"id":"semetey-1-2013:p0626:b003:l027","ordinal":124856,"en":"I shall slaughter as sacrifices,’ he said,"},{"id":"semetey-1-2013:p0626:b003:l028","ordinal":124857,"en":"And began to wreak turmoil."},{"id":"semetey-1-2013:p0626:b003:l029","ordinal":124858,"en":"When your father Manas died,"},{"id":"semetey-1-2013:p0626:b003:l030","ordinal":124859,"en":"Unable to endure his wrath,"},{"id":"semetey-1-2013:p0626:b003:l031","ordinal":124860,"en":"All the people"},{"id":"semetey-1-2013:p0626:b003:l032","ordinal":124861,"en":"Were nearly wiped out."},{"id":"semetey-1-2013:p0626:b003:l033","ordinal":124862,"en":"His fine mustache smoothed,"},{"id":"semetey-1-2013:p0626:b003:l034","ordinal":124863,"en":"Clouding my eyes blessed by Kydyr,"},{"id":"semetey-1-2013:p0626:b003:l035","ordinal":124864,"en":"My only one, my magnanimous Manas,"},{"id":"semetey-1-2013:p0626:b003:l036","ordinal":124865,"en":"Set out toward Judgment Day."},{"id":"semetey-1-2013:p0626:b003:l037","ordinal":124866,"en":"‘Alas, Manas, take me with you!’"},{"id":"semetey-1-2013:p0626:b003:l038","ordinal":124867,"en":"Lamenting with ringing cries,"},{"id":"semetey-1-2013:p0626:b003:l039","ordinal":124868,"en":"Khan Koshoi wept and wailed."},{"id":"semetey-1-2013:p0626:b004:l001","ordinal":124869,"en":"Kissing the back of his hand,"},{"id":"semetey-1-2013:p0626:b004:l002","ordinal":124870,"en":"Koshoi came to bid farewell."},{"id":"semetey-1-2013:p0626:b004:l003","ordinal":124871,"en":"Eleman's brave Toshtuk,"},{"id":"semetey-1-2013:p0626:b004:l004","ordinal":124872,"en":"Zhamgyrchy of the Eshtek,"},{"id":"semetey-1-2013:p0626:b004:l005","ordinal":124873,"en":"They too came to bid farewell."},{"id":"semetey-1-2013:p0626:b004:l006","ordinal":124874,"en":"Urumkan's Kokboru"},{"id":"semetey-1-2013:p0626:b004:l007","ordinal":124875,"en":"Then lamented with ringing cries:"},{"id":"semetey-1-2013:p0626:b004:l008","ordinal":124876,"en":"‘Matchless Manas, my warrior friend,"},{"id":"semetey-1-2013:p0626:b004:l009","ordinal":124877,"en":"Do not leave me behind you."},{"id":"semetey-1-2013:p0626:b004:l010","ordinal":124878,"en":"Take me with you, my friend!’"},{"id":"semetey-1-2013:p0626:b004:l011","ordinal":124879,"en":"All the giants said farewell."},{"id":"semetey-1-2013:p0626:b004:l012","ordinal":124880,"en":"They stood holding hands,"},{"id":"semetey-1-2013:p0626:b004:l013","ordinal":124881,"en":"Saying, ‘Farewell, farewell!’"},{"id":"semetey-1-2013:p0626:b004:l014","ordinal":124882,"en":"As they stood holding hands,"},{"id":"semetey-1-2013:p0626:b004:l015","ordinal":124883,"en":"Your khan father Manas closed his eyes."},{"id":"semetey-1-2013:p0626:b004:l016","ordinal":124884,"en":"When he set out for the next world,"},{"id":"semetey-1-2013:p0626:b004:l017","ordinal":124885,"en":"Your lion father blessed by Kydyr,"},{"id":"semetey-1-2013:p0626:b004:l018","ordinal":124886,"en":"When he departed toward Judgment Day,"},{"id":"semetey-1-2013:p0626:b004:l019","ordinal":124887,"en":"Koenaly of the young forelock,"},{"id":"semetey-1-2013:p0626:b004:l020","ordinal":124888,"en":"The boy kept struggling."},{"id":"semetey-1-2013:p0626:b004:l021","ordinal":124889,"en":"‘To Manas, my father's sworn brother,"},{"id":"semetey-1-2013:p0626:b004:l022","ordinal":124890,"en":"I shall say farewell,’ he said."},{"id":"semetey-1-2013:p0626:b004:l023","ordinal":124891,"en":"The boy would not stop wrenching free."},{"id":"semetey-1-2013:p0626:b004:l024","ordinal":124892,"en":"Poor Kanykei was in distress."},{"id":"semetey-1-2013:p0626:b004:l025","ordinal":124893,"en":"The boy Koenaly,"},{"id":"semetey-1-2013:p0626:b004:l026","ordinal":124894,"en":"Kanykei would not let him go."},{"id":"semetey-1-2013:p0626:b004:l027","ordinal":124895,"en":"When she seized him as he struggled,"},{"id":"semetey-1-2013:p0626:b004:l028","ordinal":124896,"en":"Your saintly mother, ah, Kanykei,"},{"id":"semetey-1-2013:p0626:b004:l029","ordinal":124897,"en":"Pondered and spoke:"},{"id":"semetey-1-2013:p0626:b004:l030","ordinal":124898,"en":"‘My cherished foal,"},{"id":"semetey-1-2013:p0626:b004:l031","ordinal":124899,"en":"Khan Manas, your father's sworn brother,"},{"id":"semetey-1-2013:p0626:b004:l032","ordinal":124900,"en":"Was complete in every way."},{"id":"semetey-1-2013:p0626:b004:l033","ordinal":124901,"en":"He was a warrior protected by Shai."},{"id":"semetey-1-2013:p0626:b004:l034","ordinal":124902,"en":"He was a mighty conqueror."},{"id":"semetey-1-2013:p0626:b004:l035","ordinal":124903,"en":"His eyes held deadly power."},{"id":"semetey-1-2013:p0626:b004:l036","ordinal":124904,"en":"Was not the blue-maned one the lion?"},{"id":"semetey-1-2013:p0626:b004:l037","ordinal":124905,"en":"Manas, your father's sworn brother—"},{"id":"semetey-1-2013:p0626:b004:l038","ordinal":124906,"en":"The deadly power has not left his eyes;"},{"id":"semetey-1-2013:p0626:b004:l039","ordinal":124907,"en":"The radiance of his face has not yet gone out."},{"id":"semetey-1-2013:p0627:b003:l001","ordinal":124908,"en":"Khan Manas, your father's sworn brother,"},{"id":"semetey-1-2013:p0627:b003:l002","ordinal":124909,"en":"If he fixes his gaze on you, my foal, it will go ill with you."},{"id":"semetey-1-2013:p0627:b003:l004","ordinal":124910,"en":"Even one look will bring you harm."},{"id":"semetey-1-2013:p0627:b003:l005","ordinal":124911,"en":"Ah, stop, my son, stop!’ she said."},{"id":"semetey-1-2013:p0627:b003:l006","ordinal":124912,"en":"As Kanykei held him,"},{"id":"semetey-1-2013:p0627:b003:l008","ordinal":124913,"en":"The boy said:"},{"id":"semetey-1-2013:p0627:b003:l009","ordinal":124914,"en":"‘Ah, my aunt Kanykei!"},{"id":"semetey-1-2013:p0627:b003:l010","ordinal":124915,"en":"Khan Manas, my father's sworn brother—"},{"id":"semetey-1-2013:p0627:b003:l011","ordinal":124916,"en":"Is my life worth more than Manas's?"},{"id":"semetey-1-2013:p0627:b003:l012","ordinal":124917,"en":"With most magnanimous Manas"},{"id":"semetey-1-2013:p0627:b003:l013","ordinal":124918,"en":"Let me go too."},{"id":"semetey-1-2013:p0627:b003:l014","ordinal":124919,"en":"If he will take me, here I am."},{"id":"semetey-1-2013:p0627:b003:l015","ordinal":124920,"en":"Let me remain Manas's companion.’"},{"id":"semetey-1-2013:p0627:b003:l016","ordinal":124921,"en":"So saying, the young-forelocked boy"},{"id":"semetey-1-2013:p0627:b003:l017","ordinal":124922,"en":"His motherly Kanykei"},{"id":"semetey-1-2013:p0627:b003:l018","ordinal":124923,"en":"Shook off and flung from his arm."},{"id":"semetey-1-2013:p0627:b003:l019","ordinal":124924,"en":"A hero such as Manas,"},{"id":"semetey-1-2013:p0627:b003:l020","ordinal":124925,"en":"He rushed up and took by the hand."},{"id":"semetey-1-2013:p0627:b003:l021","ordinal":124926,"en":"Then the young boy"},{"id":"semetey-1-2013:p0627:b003:l022","ordinal":124927,"en":"Gripped him tightly."},{"id":"semetey-1-2013:p0627:b003:l023","ordinal":124928,"en":"Mighty Manas regained his speech,"}]
