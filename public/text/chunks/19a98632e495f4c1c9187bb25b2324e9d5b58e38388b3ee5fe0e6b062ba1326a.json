[{"id":"semetey-2-2013:p1353:b003:l033","ordinal":290817,"en":"Quarreling and fighting."},{"id":"semetey-2-2013:p1353:b003:l034","ordinal":290818,"en":"Kanchoro had taken a wife"},{"id":"semetey-2-2013:p1353:b003:l035","ordinal":290819,"en":"From among all the Zhediger,"},{"id":"semetey-2-2013:p1353:b003:l036","ordinal":290820,"en":"From their accomplished Khan Kiyaz,"},{"id":"semetey-2-2013:p1353:b003:l037","ordinal":290821,"en":"Their lion of noble custom,"},{"id":"semetey-2-2013:p1353:b003:l038","ordinal":290822,"en":"Their truly courageous hero."},{"id":"semetey-2-2013:p1353:b003:l039","ordinal":290823,"en":"Gathering the Zhediger,"},{"id":"semetey-2-2013:p1353:b005:l001","ordinal":290824,"en":"Kanchoro gave counsel"},{"id":"semetey-2-2013:p1353:b005:l002","ordinal":290825,"en":"And roused them to fury."},{"id":"semetey-2-2013:p1353:b005:l003","ordinal":290826,"en":"He had sharpened his sword keenly;"},{"id":"semetey-2-2013:p1353:b005:l004","ordinal":290827,"en":"Trampling some men,"},{"id":"semetey-2-2013:p1353:b005:l005","ordinal":290828,"en":"Gnawing, cutting, and berating others,"},{"id":"semetey-2-2013:p1353:b005:l006","ordinal":290829,"en":"Kanchoro drove them onward."},{"id":"semetey-2-2013:p1353:b005:l007","ordinal":290830,"en":"He surrounded the gate in an uproar,"},{"id":"semetey-2-2013:p1353:b005:l008","ordinal":290831,"en":"To reach and plunder"},{"id":"semetey-2-2013:p1353:b005:l009","ordinal":290832,"en":"The widowed, orphaned woman,"},{"id":"semetey-2-2013:p1353:b005:l010","ordinal":290833,"en":"And bring calamity upon her."},{"id":"semetey-2-2013:p1353:b005:l011","ordinal":290834,"en":"With his cruel design, Kanchoro"},{"id":"semetey-2-2013:p1353:b005:l012","ordinal":290835,"en":"Drove the countless troops without respite"},{"id":"semetey-2-2013:p1353:b005:l013","ordinal":290836,"en":"And gathered them together."},{"id":"semetey-2-2013:p1353:b005:l014","ordinal":290837,"en":"He beat down many without pause"},{"id":"semetey-2-2013:p1353:b005:l015","ordinal":290838,"en":"And slaughtered them."},{"id":"semetey-2-2013:p1353:b005:l016","ordinal":290839,"en":"Kanchoro's intention"},{"id":"semetey-2-2013:p1353:b005:l017","ordinal":290840,"en":"Was to plunder the palace."},{"id":"semetey-2-2013:p1353:b005:l018","ordinal":290841,"en":"Displaying all his cunning—"},{"id":"semetey-2-2013:p1353:b005:l019","ordinal":290842,"en":"Such was the dog-taken villain,"},{"id":"semetey-2-2013:p1353:b005:l020","ordinal":290843,"en":"Hiding his claws like a snow leopard,"},{"id":"semetey-2-2013:p1353:b005:l021","ordinal":290844,"en":"Displaying his valor against the foe."},{"id":"semetey-2-2013:p1353:b005:l022","ordinal":290845,"en":"Ah, accursed one whose road will fail,"},{"id":"semetey-2-2013:p1353:b005:l023","ordinal":290846,"en":"Hiding his claws like a tiger!"},{"id":"semetey-2-2013:p1353:b005:l024","ordinal":290847,"en":"Long ago, when the leopard entered battle"},{"id":"semetey-2-2013:p1353:b005:l025","ordinal":290848,"en":"And charged straight at the enemy,"},{"id":"semetey-2-2013:p1353:b005:l026","ordinal":290849,"en":"While the valiant gray wolf still lived,"},{"id":"semetey-2-2013:p1353:b005:l027","ordinal":290850,"en":"There was the famous great war drum."},{"id":"semetey-2-2013:p1353:b005:l028","ordinal":290851,"en":"Its hide was from a wild bull;"},{"id":"semetey-2-2013:p1353:b005:l029","ordinal":290852,"en":"Such was the drum's design."},{"id":"semetey-2-2013:p1353:b005:l030","ordinal":290853,"en":"When you hear its voice, flee far away."},{"id":"semetey-2-2013:p1353:b005:l031","ordinal":290854,"en":"Facing toward the enemy,"},{"id":"semetey-2-2013:p1353:b005:l032","ordinal":290855,"en":"Raising the fortunate spear,"},{"id":"semetey-2-2013:p1353:b005:l033","ordinal":290856,"en":"The hero beat it as he entered."},{"id":"semetey-2-2013:p1353:b005:l034","ordinal":290857,"en":"Ordinary foes"},{"id":"semetey-2-2013:p1353:b005:l035","ordinal":290858,"en":"Simply lost their courage."},{"id":"semetey-2-2013:p1353:b005:l036","ordinal":290859,"en":"That drum left by the hero"},{"id":"semetey-2-2013:p1353:b005:l037","ordinal":290860,"en":"Thundered again and again,"},{"id":"semetey-2-2013:p1353:b005:l038","ordinal":290861,"en":"And the army lost its wits."},{"id":"semetey-2-2013:p1353:b005:l039","ordinal":290862,"en":"The army lost all sense."},{"id":"semetey-2-2013:p1354:b003:l001","ordinal":290863,"en":"Kanchoro drove them on without respite."},{"id":"semetey-2-2013:p1354:b003:l002","ordinal":290864,"en":"At the gate with its steel posts,"},{"id":"semetey-2-2013:p1354:b003:l003","ordinal":290865,"en":"The keeper of the gate"},{"id":"semetey-2-2013:p1354:b003:l004","ordinal":290866,"en":"Met the flood and joined battle."},{"id":"semetey-2-2013:p1354:b003:l005","ordinal":290867,"en":"The khans who guarded the gate,"},{"id":"semetey-2-2013:p1354:b003:l006","ordinal":290868,"en":"The champions expressly placed"},{"id":"semetey-2-2013:p1354:b003:l007","ordinal":290869,"en":"By the bloodthirsty hero as sentries,"},{"id":"semetey-2-2013:p1354:b003:l008","ordinal":290870,"en":"The ablest of the guards,"},{"id":"semetey-2-2013:p1354:b003:l009","ordinal":290871,"en":"The strongest of the gatekeepers—"},{"id":"semetey-2-2013:p1354:b003:l010","ordinal":290872,"en":"Have you heard of them?"},{"id":"semetey-2-2013:p1354:b003:l011","ordinal":290873,"en":"With the lion Manas the leopard,"},{"id":"semetey-2-2013:p1354:b003:l012","ordinal":290874,"en":"That hero long since departed,"},{"id":"semetey-2-2013:p1354:b003:l013","ordinal":290875,"en":"With the gray-maned accomplished lion"},{"id":"semetey-2-2013:p1354:b003:l014","ordinal":290876,"en":"Who once shook the earth with myriad troops,"},{"id":"semetey-2-2013:p1354:b003:l015","ordinal":290877,"en":"He had been a friend unto the other world."},{"id":"semetey-2-2013:p1354:b003:l016","ordinal":290878,"en":"When he ate, he chewed iron;"},{"id":"semetey-2-2013:p1354:b003:l017","ordinal":290879,"en":"He spoke with the prophet David"},{"id":"semetey-2-2013:p1354:b003:l018","ordinal":290880,"en":"And forged from precious steel."},{"id":"semetey-2-2013:p1354:b003:l019","ordinal":290881,"en":"With hero Manas the lion,"},{"id":"semetey-2-2013:p1354:b003:l020","ordinal":290882,"en":"Their sheep shared one pen,"},{"id":"semetey-2-2013:p1354:b003:l021","ordinal":290883,"en":"Their meals one fellowship."},{"id":"semetey-2-2013:p1354:b003:l022","ordinal":290884,"en":"When his craftsmanship was heard of,"},{"id":"semetey-2-2013:p1354:b003:l023","ordinal":290885,"en":"Whatever Arkesken struck fitted true."},{"id":"semetey-2-2013:p1354:b003:l024","ordinal":290886,"en":"The people of Bakburchun"},{"id":"semetey-2-2013:p1354:b003:l025","ordinal":290887,"en":"Rejoiced in Bolokbai."},{"id":"semetey-2-2013:p1354:b003:l026","ordinal":290888,"en":"Bolokbai forged steel,"},{"id":"semetey-2-2013:p1354:b003:l027","ordinal":290889,"en":"And armed your great Khan Manas."},{"id":"semetey-2-2013:p1354:b003:l028","ordinal":290890,"en":"Hearing he was a champion smith,"},{"id":"semetey-2-2013:p1354:b003:l029","ordinal":290891,"en":"The people of Beijing were"},{"id":"semetey-2-2013:p1354:b003:l030","ordinal":290892,"en":"Left astonished."},{"id":"semetey-2-2013:p1354:b003:l031","ordinal":290893,"en":"When valiant Bolokbai died,"},{"id":"semetey-2-2013:p1354:b003:l032","ordinal":290894,"en":"The steadfast, true-tempered hero"},{"id":"semetey-2-2013:p1354:b003:l033","ordinal":290895,"en":"Received as a gift was Akzholtoi."},{"id":"semetey-2-2013:p1354:b003:l034","ordinal":290896,"en":"His courage was worth countless troops."},{"id":"semetey-2-2013:p1354:b003:l035","ordinal":290897,"en":"Agile on horseback and swift on foot,"},{"id":"semetey-2-2013:p1354:b003:l036","ordinal":290898,"en":"When he fought he wrought great havoc."},{"id":"semetey-2-2013:p1354:b003:l037","ordinal":290899,"en":"His valor was extraordinary,"},{"id":"semetey-2-2013:p1354:b003:l038","ordinal":290900,"en":"His wrestling strength immense."},{"id":"semetey-2-2013:p1354:b003:l039","ordinal":290901,"en":"When he thrust with a spear,"},{"id":"semetey-2-2013:p1354:b004:l001","ordinal":290902,"en":"He was surpassingly deft and tested."},{"id":"semetey-2-2013:p1354:b004:l002","ordinal":290903,"en":"For hero Semetey,"},{"id":"semetey-2-2013:p1354:b004:l003","ordinal":290904,"en":"He was the inheritance guarding the gate—"},{"id":"semetey-2-2013:p1354:b004:l004","ordinal":290905,"en":"Both wrestler and lion."},{"id":"semetey-2-2013:p1354:b004:l005","ordinal":290906,"en":"His marksmanship was also true;"},{"id":"semetey-2-2013:p1354:b004:l006","ordinal":290907,"en":"He knew Zhydymak and wielded a practiced blade."},{"id":"semetey-2-2013:p1354:b004:l007","ordinal":290908,"en":"That he had come was also true."},{"id":"semetey-2-2013:p1354:b004:l008","ordinal":290909,"en":"He was a prime example of a capable hero,"},{"id":"semetey-2-2013:p1354:b004:l009","ordinal":290910,"en":"The son of the smith Bolokbai."},{"id":"semetey-2-2013:p1354:b004:l010","ordinal":290911,"en":"At the gate stood Akzholtoi,"},{"id":"semetey-2-2013:p1354:b004:l011","ordinal":290912,"en":"When enraged, worth countless troops."},{"id":"semetey-2-2013:p1354:b004:l012","ordinal":290913,"en":"Kanchoro and Kiyaz's vast army"},{"id":"semetey-2-2013:p1354:b004:l013","ordinal":290914,"en":"Could not make him submit."},{"id":"semetey-2-2013:p1354:b004:l014","ordinal":290915,"en":"He would not cut down and surrender"},{"id":"semetey-2-2013:p1354:b004:l015","ordinal":290916,"en":"Widows, orphans, and old women to the foe."},{"id":"semetey-2-2013:p1354:b004:l016","ordinal":290917,"en":"They stood facing one another,"},{"id":"semetey-2-2013:p1354:b004:l017","ordinal":290918,"en":"Firing guns and drawing bows,"},{"id":"semetey-2-2013:p1354:b004:l018","ordinal":290919,"en":"Fighting with a crash."},{"id":"semetey-2-2013:p1354:b004:l019","ordinal":290920,"en":"Smoke trailed into the sky;"},{"id":"semetey-2-2013:p1354:b004:l020","ordinal":290921,"en":"They stood face to face."},{"id":"semetey-2-2013:p1354:b004:l021","ordinal":290922,"en":"Akzholtoi alone against that host"},{"id":"semetey-2-2013:p1354:b004:l022","ordinal":290923,"en":"Fought them with a crash."},{"id":"semetey-2-2013:p1354:b004:l023","ordinal":290924,"en":"The Zhediger flooded in and attacked,"},{"id":"semetey-2-2013:p1354:b004:l024","ordinal":290925,"en":"Striking without sparing life."},{"id":"semetey-2-2013:p1354:b004:l025","ordinal":290926,"en":"Those who met each other laid one another low;"},{"id":"semetey-2-2013:p1354:b004:l026","ordinal":290927,"en":"The wretched souls who entered battle"},{"id":"semetey-2-2013:p1354:b004:l027","ordinal":290928,"en":"Hung by half a hair."},{"id":"semetey-2-2013:p1354:b004:l028","ordinal":290929,"en":"Those whose death had come died,"},{"id":"semetey-2-2013:p1354:b004:l029","ordinal":290930,"en":"Meeting calamity and hardship,"},{"id":"semetey-2-2013:p1354:b004:l030","ordinal":290931,"en":"Ripping lungs and taking gallbladders,"},{"id":"semetey-2-2013:p1354:b004:l031","ordinal":290932,"en":"Shedding extraordinary blood."},{"id":"semetey-2-2013:p1354:b004:l032","ordinal":290933,"en":"Bolokbai's Akzholtoi,"},{"id":"semetey-2-2013:p1354:b004:l033","ordinal":290934,"en":"Whose renown was worth mighty hosts,"},{"id":"semetey-2-2013:p1354:b004:l034","ordinal":290935,"en":"The wisest master of counsel—"},{"id":"semetey-2-2013:p1354:b004:l035","ordinal":290936,"en":"Such was his excellence."},{"id":"semetey-2-2013:p1354:b004:l036","ordinal":290937,"en":"Long ago, his father, the smith Bolokbai,"},{"id":"semetey-2-2013:p1354:b004:l037","ordinal":290938,"en":"When Akzholtoi was a playful child,"},{"id":"semetey-2-2013:p1354:b004:l038","ordinal":290939,"en":"When he was a playful child,"},{"id":"semetey-2-2013:p1354:b004:l039","ordinal":290940,"en":"While his father was still alive,"},{"id":"semetey-2-2013:p1355:b003:l001","ordinal":290941,"en":"Had cherished him as a future son."},{"id":"semetey-2-2013:p1355:b003:l002","ordinal":290942,"en":"He taught him to recognize the Zhydymak watch,"},{"id":"semetey-2-2013:p1355:b003:l003","ordinal":290943,"en":"Trained him to shoot at targets."},{"id":"semetey-2-2013:p1355:b003:l004","ordinal":290944,"en":"Long ago, mighty gray-maned Semetey"},{"id":"semetey-2-2013:p1355:b003:l005","ordinal":290945,"en":"Equipped him with every weapon"},{"id":"semetey-2-2013:p1355:b003:l006","ordinal":290946,"en":"And made him khan of the gatekeepers."},{"id":"semetey-2-2013:p1355:b003:l007","ordinal":290947,"en":"A master marksman in battle,"},{"id":"semetey-2-2013:p1355:b003:l008","ordinal":290948,"en":"A surpassingly skillful servant,"},{"id":"semetey-2-2013:p1355:b003:l009","ordinal":290949,"en":"He stood facing"},{"id":"semetey-2-2013:p1355:b003:l010","ordinal":290950,"en":"Kanchoro and Khan Kiyaz,"},{"id":"semetey-2-2013:p1355:b003:l011","ordinal":290951,"en":"Firing guns and drawing bows,"},{"id":"semetey-2-2013:p1355:b003:l012","ordinal":290952,"en":"Fighting in bloody clashes."},{"id":"semetey-2-2013:p1355:b003:l013","ordinal":290953,"en":"Akzholtoi charged in and broke their ranks."},{"id":"semetey-2-2013:p1355:b003:l014","ordinal":290954,"en":"The nobles guarding the gate,"},{"id":"semetey-2-2013:p1355:b003:l015","ordinal":290955,"en":"The sentries standing watch,"},{"id":"semetey-2-2013:p1355:b003:l016","ordinal":290956,"en":"The keepers at the gateway—"},{"id":"semetey-2-2013:p1355:b003:l017","ordinal":290957,"en":"Many champions fell to bullets;"},{"id":"semetey-2-2013:p1355:b003:l018","ordinal":290958,"en":"Hardship and uproar arose."},{"id":"semetey-2-2013:p1355:b003:l019","ordinal":290959,"en":"Akzholtoi would not consent"},{"id":"semetey-2-2013:p1355:b003:l020","ordinal":290960,"en":"To the ruin of the people and sack of the palace,"},{"id":"semetey-2-2013:p1355:b003:l021","ordinal":290961,"en":"To leaving the nation open to plunder."},{"id":"semetey-2-2013:p1355:b003:l022","ordinal":290962,"en":"He would not surrender"},{"id":"semetey-2-2013:p1355:b003:l023","ordinal":290963,"en":"The widowed sister-in-law, the mourning woman,"},{"id":"semetey-2-2013:p1355:b003:l024","ordinal":290964,"en":"As spoil to the Zhediger."},{"id":"semetey-2-2013:p1355:b003:l025","ordinal":290965,"en":"Trusting in God, they stood,"},{"id":"semetey-2-2013:p1355:b003:l026","ordinal":290966,"en":"Split the ranks in two and fought."},{"id":"semetey-2-2013:p1355:b003:l027","ordinal":290967,"en":"Akzholtoi alone against that host"},{"id":"semetey-2-2013:p1355:b003:l028","ordinal":290968,"en":"Gave battle."},{"id":"semetey-2-2013:p1355:b003:l029","ordinal":290969,"en":"At Akzholtoi's side,"},{"id":"semetey-2-2013:p1355:b003:l030","ordinal":290970,"en":"Emil Chochmor the hero died;"},{"id":"semetey-2-2013:p1355:b003:l031","ordinal":290971,"en":"Egizey and Kocher died together;"},{"id":"semetey-2-2013:p1355:b003:l032","ordinal":290972,"en":"Akbalban, who swept the gate clean,"},{"id":"semetey-2-2013:p1355:b003:l033","ordinal":290973,"en":"Died, leaving no support."},{"id":"semetey-2-2013:p1355:b003:l034","ordinal":290974,"en":"Akzholtoi remained alone."},{"id":"semetey-2-2013:p1355:b003:l035","ordinal":290975,"en":"Kanchoro with his vast army"},{"id":"semetey-2-2013:p1355:b003:l036","ordinal":290976,"en":"Had begun his sweeping attack;"},{"id":"semetey-2-2013:p1355:b003:l037","ordinal":290977,"en":"Every one of the gatekeepers,"},{"id":"semetey-2-2013:p1355:b003:l038","ordinal":290978,"en":"The accursed traitor slaughtered."},{"id":"semetey-2-2013:p1355:b003:l039","ordinal":290979,"en":"Defending the gate,"},{"id":"semetey-2-2013:p1355:b005:l001","ordinal":290980,"en":"For seven days and nights,"},{"id":"semetey-2-2013:p1355:b005:l002","ordinal":290981,"en":"Akzholtoi refused to yield it"},{"id":"semetey-2-2013:p1355:b005:l003","ordinal":290982,"en":"And fought without rest for seven days."},{"id":"semetey-2-2013:p1355:b005:l004","ordinal":290983,"en":"When seven days were complete,"},{"id":"semetey-2-2013:p1355:b005:l005","ordinal":290984,"en":"Akzholtoi's means were exhausted."},{"id":"semetey-2-2013:p1355:b005:l006","ordinal":290985,"en":"He had no strength left to fight;"},{"id":"semetey-2-2013:p1355:b005:l007","ordinal":290986,"en":"Bullets filled the space around him."},{"id":"semetey-2-2013:p1355:b005:l008","ordinal":290987,"en":"He had no strong back to rely on,"},{"id":"semetey-2-2013:p1355:b005:l009","ordinal":290988,"en":"No hero in whom to place hope."},{"id":"semetey-2-2013:p1355:b005:l010","ordinal":290989,"en":"The beloved Kulchoro,"},{"id":"semetey-2-2013:p1355:b005:l011","ordinal":290990,"en":"His liver an ember, his dearest support,"},{"id":"semetey-2-2013:p1355:b005:l012","ordinal":290991,"en":"He had no supporting friend;"},{"id":"semetey-2-2013:p1355:b005:l013","ordinal":290992,"en":"Even if Akzholtoi died now,"},{"id":"semetey-2-2013:p1355:b005:l014","ordinal":290993,"en":"His elder Khan Bakai was absent."},{"id":"semetey-2-2013:p1355:b005:l015","ordinal":290994,"en":"Gray-maned Semetey, who had protected him,"},{"id":"semetey-2-2013:p1355:b005:l016","ordinal":290995,"en":"Was absent too."},{"id":"semetey-2-2013:p1355:b005:l017","ordinal":290996,"en":"Valiant marksman Akzholtoi"},{"id":"semetey-2-2013:p1355:b005:l018","ordinal":290997,"en":"Had no charger to catch and mount,"},{"id":"semetey-2-2013:p1355:b005:l019","ordinal":290998,"en":"No bloodthirsty khan to protect him."},{"id":"semetey-2-2013:p1355:b005:l020","ordinal":290999,"en":"Mane and tail were wholly gone."},{"id":"semetey-2-2013:p1355:b005:l021","ordinal":291000,"en":"His heart burned, his liver was ember;"},{"id":"semetey-2-2013:p1355:b005:l022","ordinal":291001,"en":"His hands boiled with fury,"},{"id":"semetey-2-2013:p1355:b005:l023","ordinal":291002,"en":"Strength came to his flylike soul."},{"id":"semetey-2-2013:p1355:b005:l024","ordinal":291003,"en":"Unable to endure it, Akzholtoi"},{"id":"semetey-2-2013:p1355:b005:l025","ordinal":291004,"en":"Fought without rest for seven days,"},{"id":"semetey-2-2013:p1355:b005:l026","ordinal":291005,"en":"Receiving wounds in seven places."},{"id":"semetey-2-2013:p1355:b005:l027","ordinal":291006,"en":"His whole body was torn;"},{"id":"semetey-2-2013:p1355:b005:l028","ordinal":291007,"en":"Every bone ached and throbbed."},{"id":"semetey-2-2013:p1355:b005:l029","ordinal":291008,"en":"The two bloodthirsty khans, Kiyaz and Kanchoro,"},{"id":"semetey-2-2013:p1355:b005:l030","ordinal":291009,"en":"Flooded in with a roar."},{"id":"semetey-2-2013:p1355:b005:l031","ordinal":291010,"en":"The world narrowed in his anguish;"},{"id":"semetey-2-2013:p1355:b005:l032","ordinal":291011,"en":"Akzholtoi stood humiliated."},{"id":"semetey-2-2013:p1355:b005:l033","ordinal":291012,"en":"He longed for a single swallow"},{"id":"semetey-2-2013:p1355:b005:l034","ordinal":291013,"en":"Of saliva sweet as sugar;"},{"id":"semetey-2-2013:p1355:b005:l035","ordinal":291014,"en":"His palate dried and hardened,"},{"id":"semetey-2-2013:p1355:b005:l036","ordinal":291015,"en":"His eyes stared wide."},{"id":"semetey-2-2013:p1355:b005:l037","ordinal":291016,"en":"All the bones of his body"},{"id":"semetey-2-2013:p1355:b005:l038","ordinal":291017,"en":"Sagged as though he were dying;"},{"id":"semetey-2-2013:p1355:b005:l039","ordinal":291018,"en":"His body was crushed and bloody."},{"id":"semetey-2-2013:p1356:b003:l001","ordinal":291019,"en":"His two hands, once his greatest servants,"},{"id":"semetey-2-2013:p1356:b003:l002","ordinal":291020,"en":"Hung paralyzed and would not rise."},{"id":"semetey-2-2013:p1356:b003:l003","ordinal":291021,"en":"The Zhediger fought and quarreled,"},{"id":"semetey-2-2013:p1356:b003:l004","ordinal":291022,"en":"Inflicting humiliation,"},{"id":"semetey-2-2013:p1356:b003:l005","ordinal":291023,"en":"Bringing misery upon his poor soul,"},{"id":"semetey-2-2013:p1356:b003:l006","ordinal":291024,"en":"And committing violence."},{"id":"semetey-2-2013:p1356:b003:l007","ordinal":291025,"en":"As twilight came and the sun set,"},{"id":"semetey-2-2013:p1356:b003:l008","ordinal":291026,"en":"The Zhediger forced their way in."},{"id":"semetey-2-2013:p1356:b003:l009","ordinal":291027,"en":"The Zhediger entered and seized"},{"id":"semetey-2-2013:p1356:b003:l010","ordinal":291028,"en":"Aichurok's White Palace."},{"id":"semetey-2-2013:p1356:b003:l011","ordinal":291029,"en":"May God never show such a sight!"},{"id":"semetey-2-2013:p1356:b003:l012","ordinal":291030,"en":"They traveled in turmoil,"},{"id":"semetey-2-2013:p1356:b003:l013","ordinal":291031,"en":"The army massed thick as fog,"},{"id":"semetey-2-2013:p1356:b003:l014","ordinal":291032,"en":"And the Zhediger entered in ranks."},{"id":"semetey-2-2013:p1356:b003:l015","ordinal":291033,"en":"Gold, silver, countless coins—"},{"id":"semetey-2-2013:p1356:b003:l016","ordinal":291034,"en":"The Zhediger plundered much."},{"id":"semetey-2-2013:p1356:b003:l017","ordinal":291035,"en":"Akzholtoi, now alone,"},{"id":"semetey-2-2013:p1356:b003:l018","ordinal":291036,"en":"Grieved in sorrow,"},{"id":"semetey-2-2013:p1356:b003:l019","ordinal":291037,"en":"Having lost the gatekeepers"},{"id":"semetey-2-2013:p1356:b003:l020","ordinal":291038,"en":"Who had served as his support."},{"id":"semetey-2-2013:p1356:b003:l021","ordinal":291039,"en":"His elders were soaked in blood;"},{"id":"semetey-2-2013:p1356:b003:l022","ordinal":291040,"en":"His guards and lions,"},{"id":"semetey-2-2013:p1356:b003:l023","ordinal":291041,"en":"The heroes bound at his waist,"},{"id":"semetey-2-2013:p1356:b003:l024","ordinal":291042,"en":"Were taken by the Zhediger."},{"id":"semetey-2-2013:p1356:b003:l025","ordinal":291043,"en":"Though shot, no bullet pierced"},{"id":"semetey-2-2013:p1356:b003:l026","ordinal":291044,"en":"The accursed Kanchoro."},{"id":"semetey-2-2013:p1356:b003:l027","ordinal":291045,"en":"As though he had prospered,"},{"id":"semetey-2-2013:p1356:b003:l028","ordinal":291046,"en":"He had drawn on and worn Ak-Olpok,"},{"id":"semetey-2-2013:p1356:b003:l029","ordinal":291047,"en":"With golden collar, copper sleeves,"},{"id":"semetey-2-2013:p1356:b003:l030","ordinal":291048,"en":"Silken weave and lark-eye rings."},{"id":"semetey-2-2013:p1356:b003:l031","ordinal":291049,"en":"When merely brandished, it set things ablaze;"},{"id":"semetey-2-2013:p1356:b003:l032","ordinal":291050,"en":"When truly fired, it blasted its target."},{"id":"semetey-2-2013:p1356:b003:l033","ordinal":291051,"en":"When he slung it on, it was"},{"id":"semetey-2-2013:p1356:b003:l034","ordinal":291052,"en":"The answer to every turmoil;"},{"id":"semetey-2-2013:p1356:b003:l035","ordinal":291053,"en":"When the wretch aimed it,"},{"id":"semetey-2-2013:p1356:b003:l036","ordinal":291054,"en":"It became the companion of his flylike soul."},{"id":"semetey-2-2013:p1356:b003:l037","ordinal":291055,"en":"Akkelte, refused to any who asked,"},{"id":"semetey-2-2013:p1356:b003:l038","ordinal":291056,"en":"Was in Khan Kanchoro's hands."},{"id":"semetey-2-2013:p1356:b003:l039","ordinal":291057,"en":"Seeing this misery,"},{"id":"semetey-2-2013:p1356:b004:l001","ordinal":291058,"en":"Finding no pass to cross,"},{"id":"semetey-2-2013:p1356:b004:l002","ordinal":291059,"en":"Finding no lion to support him,"},{"id":"semetey-2-2013:p1356:b004:l003","ordinal":291060,"en":"Despairing of his precious life,"},{"id":"semetey-2-2013:p1356:b004:l004","ordinal":291061,"en":"He held the short gun Chortkelte."},{"id":"semetey-2-2013:p1356:b004:l005","ordinal":291062,"en":"Gripping Chortkelte, he ran."},{"id":"semetey-2-2013:p1356:b004:l006","ordinal":291063,"en":"As twilight came and the sun set,"},{"id":"semetey-2-2013:p1356:b004:l007","ordinal":291064,"en":"While the people lay utterly still,"},{"id":"semetey-2-2013:p1356:b004:l008","ordinal":291065,"en":"Before stars divided the sky,"},{"id":"semetey-2-2013:p1356:b004:l009","ordinal":291066,"en":"His eyes dimmed and night fell;"},{"id":"semetey-2-2013:p1356:b004:l010","ordinal":291067,"en":"Nothing at all could be seen."},{"id":"semetey-2-2013:p1356:b004:l011","ordinal":291068,"en":"Then Akzholtoi,"},{"id":"semetey-2-2013:p1356:b004:l012","ordinal":291069,"en":"Toward Kaiypchy Pass,"},{"id":"semetey-2-2013:p1356:b004:l013","ordinal":291070,"en":"Toward the ridge of Kanzhailak,"},{"id":"semetey-2-2013:p1356:b004:l014","ordinal":291071,"en":"Gathering strength in his flylike soul,"},{"id":"semetey-2-2013:p1356:b004:l015","ordinal":291072,"en":"Scattered all his worldly hopes."}]
