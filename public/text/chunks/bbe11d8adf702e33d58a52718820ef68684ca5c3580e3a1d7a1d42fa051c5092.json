[{"id":"semetey-1-2013:p0080:b003:l001","ordinal":82945,"en":"Did she remain alive without dying?"},{"id":"semetey-1-2013:p0080:b003:l002","ordinal":82946,"en":"When the thought came, did my little foal"},{"id":"semetey-1-2013:p0080:b003:l003","ordinal":82947,"en":"Hide herself away?"},{"id":"semetey-1-2013:p0080:b003:l004","ordinal":82948,"en":"Did they scatter her treasury and livestock?"},{"id":"semetey-1-2013:p0080:b003:l005","ordinal":82949,"en":"When the thought came, did Kanykei"},{"id":"semetey-1-2013:p0080:b003:l006","ordinal":82950,"en":"Flee out into the hills?"},{"id":"semetey-1-2013:p0080:b003:l007","ordinal":82951,"en":"Kara-Buura and Chatkal"},{"id":"semetey-1-2013:p0080:b003:l008","ordinal":82952,"en":"Let me search for two days."},{"id":"semetey-1-2013:p0080:b003:l009","ordinal":82953,"en":"Let me bear my anguish thus."},{"id":"semetey-1-2013:p0080:b003:l010","ordinal":82954,"en":"The hills of spacious Talas"},{"id":"semetey-1-2013:p0080:b003:l011","ordinal":82955,"en":"Let me search for three days."},{"id":"semetey-1-2013:p0080:b003:l012","ordinal":82956,"en":"Somehow, my flower calf,"},{"id":"semetey-1-2013:p0080:b003:l013","ordinal":82957,"en":"Let me find my Kanykei.'"},{"id":"semetey-1-2013:p0080:b003:l014","ordinal":82958,"en":"Khan Bakai went into the hills,"},{"id":"semetey-1-2013:p0080:b003:l015","ordinal":82959,"en":"Setting the gray winged steed in motion,"},{"id":"semetey-1-2013:p0080:b003:l016","ordinal":82960,"en":"Calling out Kanykei's name."},{"id":"semetey-1-2013:p0080:b003:l017","ordinal":82961,"en":"On the ridges Bakai shouted,"},{"id":"semetey-1-2013:p0080:b003:l018","ordinal":82962,"en":"Calling out for Kanykei."},{"id":"semetey-1-2013:p0080:b003:l019","ordinal":82963,"en":"In the hills Bakai shouted,"},{"id":"semetey-1-2013:p0080:b003:l020","ordinal":82964,"en":"Calling out for Kanykei."},{"id":"semetey-1-2013:p0080:b003:l021","ordinal":82965,"en":"Down Talas he shouted,"},{"id":"semetey-1-2013:p0080:b003:l022","ordinal":82966,"en":"Calling out for Chyiyrdy."},{"id":"semetey-1-2013:p0080:b003:l023","ordinal":82967,"en":"Üch-Koshoi's low, level foothills"},{"id":"semetey-1-2013:p0080:b003:l024","ordinal":82968,"en":"Bakai searched for three days."},{"id":"semetey-1-2013:p0080:b003:l025","ordinal":82969,"en":"In Kara-Buura and Chatkal"},{"id":"semetey-1-2013:p0080:b003:l026","ordinal":82970,"en":"He traveled for two days."},{"id":"semetey-1-2013:p0080:b003:l027","ordinal":82971,"en":"Unable to regain his composure,"},{"id":"semetey-1-2013:p0080:b003:l028","ordinal":82972,"en":"Your father, old Bakai,"},{"id":"semetey-1-2013:p0080:b003:l029","ordinal":82973,"en":"Tamarisk-covered Keng-Kol, the great valley—"},{"id":"semetey-1-2013:p0080:b003:l030","ordinal":82974,"en":"He searched through all of it."},{"id":"semetey-1-2013:p0080:b003:l031","ordinal":82975,"en":"For Manas, gone to the other world,"},{"id":"semetey-1-2013:p0080:b003:l032","ordinal":82976,"en":"Honoring the spirit of his friend,"},{"id":"semetey-1-2013:p0080:b003:l033","ordinal":82977,"en":"He bore so much anguish now."},{"id":"semetey-1-2013:p0080:b003:l034","ordinal":82978,"en":"The great hills of spacious Talas"},{"id":"semetey-1-2013:p0080:b003:l035","ordinal":82979,"en":"He searched without a word."},{"id":"semetey-1-2013:p0080:b003:l036","ordinal":82980,"en":"Kök-Zhaiyk at the head of Ürbüz"},{"id":"semetey-1-2013:p0080:b003:l037","ordinal":82981,"en":"He searched for three days."},{"id":"semetey-1-2013:p0080:b003:l038","ordinal":82982,"en":"Through hills and steep banks,"},{"id":"semetey-1-2013:p0080:b003:l039","ordinal":82983,"en":"Through caves and forests,"},{"id":"semetey-1-2013:p0080:b004:l001","ordinal":82984,"en":"Leaving nothing the size of a louse,"},{"id":"semetey-1-2013:p0080:b004:l002","ordinal":82985,"en":"He searched through everything."},{"id":"semetey-1-2013:p0080:b004:l003","ordinal":82986,"en":"Through every towering mountain,"},{"id":"semetey-1-2013:p0080:b004:l004","ordinal":82987,"en":"Through every gaping ravine,"},{"id":"semetey-1-2013:p0080:b004:l005","ordinal":82988,"en":"Leaving not a louse-sized patch,"},{"id":"semetey-1-2013:p0080:b004:l006","ordinal":82989,"en":"Mighty Bakai searched thus."},{"id":"semetey-1-2013:p0080:b004:l007","ordinal":82990,"en":"Beneath him his winged steed grew weary;"},{"id":"semetey-1-2013:p0080:b004:l008","ordinal":82991,"en":"His eyes grew strained, unable to see."},{"id":"semetey-1-2013:p0080:b004:l009","ordinal":82992,"en":"Not acknowledging his old age,"},{"id":"semetey-1-2013:p0080:b004:l010","ordinal":82993,"en":"Bakai reproached his eyes:"},{"id":"semetey-1-2013:p0080:b004:l011","ordinal":82994,"en":"'These accursed eyes"},{"id":"semetey-1-2013:p0080:b004:l012","ordinal":82995,"en":"Cannot see anything at all!"},{"id":"semetey-1-2013:p0080:b004:l013","ordinal":82996,"en":"Riding by night and drinking much water,"},{"id":"semetey-1-2013:p0080:b004:l014","ordinal":82997,"en":"Has God struck them at the root?"},{"id":"semetey-1-2013:p0080:b004:l015","ordinal":82998,"en":"These damned eyes"},{"id":"semetey-1-2013:p0080:b004:l016","ordinal":82999,"en":"Cannot see a single thing!"},{"id":"semetey-1-2013:p0080:b004:l017","ordinal":83000,"en":"Traveling in darkness,"},{"id":"semetey-1-2013:p0080:b004:l018","ordinal":83001,"en":"Has old age stood against me?"},{"id":"semetey-1-2013:p0080:b004:l019","ordinal":83002,"en":"Struck hard by snow and storms,"},{"id":"semetey-1-2013:p0080:b004:l020","ordinal":83003,"en":"Has God struck their roots?"},{"id":"semetey-1-2013:p0080:b004:l021","ordinal":83004,"en":"My eyes, open, do not close!"},{"id":"semetey-1-2013:p0080:b004:l022","ordinal":83005,"en":"My heart, be calm, do not burn!"},{"id":"semetey-1-2013:p0080:b004:l023","ordinal":83006,"en":"May what I lost be found!"},{"id":"semetey-1-2013:p0080:b004:l024","ordinal":83007,"en":"Of old tiger Bakai,"},{"id":"semetey-1-2013:p0080:b004:l025","ordinal":83008,"en":"May his honor thus be preserved!"},{"id":"semetey-1-2013:p0080:b004:l026","ordinal":83009,"en":"Now I shall truly die."},{"id":"semetey-1-2013:p0080:b004:l027","ordinal":83010,"en":"In the desert of Kum-Bulak,"},{"id":"semetey-1-2013:p0080:b004:l028","ordinal":83011,"en":"At the place where he performed ablution,"},{"id":"semetey-1-2013:p0080:b004:l029","ordinal":83012,"en":"Encountered through the unseen,"},{"id":"semetey-1-2013:p0080:b004:l030","ordinal":83013,"en":"Found through God's favor,"},{"id":"semetey-1-2013:p0080:b004:l031","ordinal":83014,"en":"Before its eyes had opened,"},{"id":"semetey-1-2013:p0080:b004:l032","ordinal":83015,"en":"He gave it milk from his mouth,"},{"id":"semetey-1-2013:p0080:b004:l033","ordinal":83016,"en":"Gave it meat with his hand,"},{"id":"semetey-1-2013:p0080:b004:l034","ordinal":83017,"en":"Had a steel collar fitted to its neck,"},{"id":"semetey-1-2013:p0080:b004:l035","ordinal":83018,"en":"Had a tiger-skin covering laid upon its back."},{"id":"semetey-1-2013:p0080:b004:l037","ordinal":83019,"en":"'A raiding hero needs it,' he said,"},{"id":"semetey-1-2013:p0080:b004:l038","ordinal":83020,"en":"And had the tiger woman Kanykei rear it."},{"id":"semetey-1-2013:p0081:b003:l001","ordinal":83021,"en":"It never drew back from a tiger,"},{"id":"semetey-1-2013:p0081:b003:l002","ordinal":83022,"en":"Never turned away from a bear."},{"id":"semetey-1-2013:p0081:b003:l003","ordinal":83023,"en":"Whatever it bit, it ravaged;"},{"id":"semetey-1-2013:p0081:b003:l004","ordinal":83024,"en":"Everyone who saw it, it made smile."},{"id":"semetey-1-2013:p0081:b003:l005","ordinal":83025,"en":"When dear Manas died,"},{"id":"semetey-1-2013:p0081:b003:l006","ordinal":83026,"en":"It laid its head upon the ground."},{"id":"semetey-1-2013:p0081:b003:l007","ordinal":83027,"en":"At the khan's burial enclosure then,"},{"id":"semetey-1-2013:p0081:b003:l008","ordinal":83028,"en":"Kumaiyk lay down howling."},{"id":"semetey-1-2013:p0081:b003:l009","ordinal":83029,"en":"Khan Manas's little enclosure—"},{"id":"semetey-1-2013:p0081:b003:l010","ordinal":83030,"en":"Kumaiyk in that enclosure"},{"id":"semetey-1-2013:p0081:b003:l011","ordinal":83031,"en":"Let me drive out upon the road."},{"id":"semetey-1-2013:p0081:b003:l012","ordinal":83032,"en":"My orphan and Kanykei—"},{"id":"semetey-1-2013:p0081:b003:l013","ordinal":83033,"en":"Let me find Kanykei."},{"id":"semetey-1-2013:p0081:b003:l014","ordinal":83034,"en":"I have searched the wilds so often."},{"id":"semetey-1-2013:p0081:b003:l015","ordinal":83035,"en":"At the place where he performed ablution,"},{"id":"semetey-1-2013:p0081:b003:l016","ordinal":83036,"en":"Encountered through the unseen,"},{"id":"semetey-1-2013:p0081:b003:l017","ordinal":83037,"en":"Found through God's favor,"},{"id":"semetey-1-2013:p0081:b003:l018","ordinal":83038,"en":"Before its eyes had opened,"},{"id":"semetey-1-2013:p0081:b003:l019","ordinal":83039,"en":"He gave it milk from his mouth,"},{"id":"semetey-1-2013:p0081:b003:l020","ordinal":83040,"en":"Gave it meat with his hand,"},{"id":"semetey-1-2013:p0081:b003:l021","ordinal":83041,"en":"Had a steel collar fitted to its neck,"},{"id":"semetey-1-2013:p0081:b003:l022","ordinal":83042,"en":"Had a tiger-skin covering laid upon its back."},{"id":"semetey-1-2013:p0081:b003:l024","ordinal":83043,"en":"'A raiding hero needs it,' he said,"},{"id":"semetey-1-2013:p0081:b003:l025","ordinal":83044,"en":"And had the tiger woman Kanykei rear it."},{"id":"semetey-1-2013:p0081:b003:l027","ordinal":83045,"en":"It never drew back from a tiger;"},{"id":"semetey-1-2013:p0081:b003:l028","ordinal":83046,"en":"Like a bear, it never turned away."},{"id":"semetey-1-2013:p0081:b003:l029","ordinal":83047,"en":"Whatever it bit, it ravaged;"},{"id":"semetey-1-2013:p0081:b003:l030","ordinal":83048,"en":"Everyone who saw it, it made smile."},{"id":"semetey-1-2013:p0081:b003:l031","ordinal":83049,"en":"When dear Manas died,"},{"id":"semetey-1-2013:p0081:b003:l032","ordinal":83050,"en":"It laid its head upon the ground."},{"id":"semetey-1-2013:p0081:b003:l033","ordinal":83051,"en":"At the khan's burial enclosure then,"},{"id":"semetey-1-2013:p0081:b003:l034","ordinal":83052,"en":"Kumaiyk lay down howling."},{"id":"semetey-1-2013:p0081:b003:l035","ordinal":83053,"en":"Khan Manas's little enclosure—"},{"id":"semetey-1-2013:p0081:b003:l036","ordinal":83054,"en":"Kumaiyk in that enclosure"},{"id":"semetey-1-2013:p0081:b003:l037","ordinal":83055,"en":"Let me drive out upon the road."},{"id":"semetey-1-2013:p0081:b003:l038","ordinal":83056,"en":"My orphan and Kanykei—"},{"id":"semetey-1-2013:p0081:b003:l039","ordinal":83057,"en":"Let me find Kanykei."},{"id":"semetey-1-2013:p0081:b005:l001","ordinal":83058,"en":"I have searched the wilds so often."},{"id":"semetey-1-2013:p0081:b005:l002","ordinal":83059,"en":"Seeking what is lost in the unseen,"},{"id":"semetey-1-2013:p0081:b005:l003","ordinal":83060,"en":"What desire could I fulfill?"},{"id":"semetey-1-2013:p0081:b005:l004","ordinal":83061,"en":"Rather than that, from this world,"},{"id":"semetey-1-2013:p0081:b005:l005","ordinal":83062,"en":"My precious Kumaiyk,"},{"id":"semetey-1-2013:p0081:b005:l006","ordinal":83063,"en":"Let me depart while driving you onward.'"},{"id":"semetey-1-2013:p0081:b005:l007","ordinal":83064,"en":"At the spur where the mountain ended,"},{"id":"semetey-1-2013:p0081:b005:l008","ordinal":83065,"en":"At the level mountain's promontory,"},{"id":"semetey-1-2013:p0081:b005:l009","ordinal":83066,"en":"Khan Manas's little enclosure—"},{"id":"semetey-1-2013:p0081:b005:l010","ordinal":83067,"en":"Galloping toward that enclosure,"},{"id":"semetey-1-2013:p0081:b005:l011","ordinal":83068,"en":"The leopard Bakai went."},{"id":"semetey-1-2013:p0081:b005:l012","ordinal":83069,"en":"Shouting toward the enclosure,"},{"id":"semetey-1-2013:p0081:b005:l013","ordinal":83070,"en":"Calling out for Kumaiyk:"},{"id":"semetey-1-2013:p0081:b005:l014","ordinal":83071,"en":"'My cherished Kumaiyk,"},{"id":"semetey-1-2013:p0081:b005:l015","ordinal":83072,"en":"My wings have been broken back."},{"id":"semetey-1-2013:p0081:b005:l016","ordinal":83073,"en":"The one I took as my companion,"},{"id":"semetey-1-2013:p0081:b005:l017","ordinal":83074,"en":"Semetey, I have lost!"},{"id":"semetey-1-2013:p0081:b005:l018","ordinal":83075,"en":"O Kumaiyk, Kumaiyk!"},{"id":"semetey-1-2013:p0081:b005:l019","ordinal":83076,"en":"I have no strength to gird myself;"},{"id":"semetey-1-2013:p0081:b005:l020","ordinal":83077,"en":"The child the warrior left me is gone!"},{"id":"semetey-1-2013:p0081:b005:l021","ordinal":83078,"en":"I have no strength to remain alive;"},{"id":"semetey-1-2013:p0081:b005:l022","ordinal":83079,"en":"I have no garden planted in Talas."},{"id":"semetey-1-2013:p0081:b005:l023","ordinal":83080,"en":"The ruler of the multitude,"},{"id":"semetey-1-2013:p0081:b005:l024","ordinal":83081,"en":"My child Kanykei is gone as well."},{"id":"semetey-1-2013:p0081:b005:l025","ordinal":83082,"en":"I have no foal tether stretched in Talas;"},{"id":"semetey-1-2013:p0081:b005:l026","ordinal":83083,"en":"My pure, venerable mother is gone."},{"id":"semetey-1-2013:p0081:b005:l027","ordinal":83084,"en":"I have no garden planted in Keng-Kol."},{"id":"semetey-1-2013:p0081:b005:l028","ordinal":83085,"en":"Parted from the orphan without seeing him,"},{"id":"semetey-1-2013:p0081:b005:l029","ordinal":83086,"en":"The hero Bakai has no good fortune."},{"id":"semetey-1-2013:p0081:b005:l030","ordinal":83087,"en":"His plucked-out beard had gathered in a heap;"},{"id":"semetey-1-2013:p0081:b005:l031","ordinal":83088,"en":"Your falcon Khan Bakai stood in anguish."},{"id":"semetey-1-2013:p0081:b005:l033","ordinal":83089,"en":"Know, Kumaiyk, I tell you, know!"},{"id":"semetey-1-2013:p0081:b005:l034","ordinal":83090,"en":"Know, and follow the trail, I tell you!"},{"id":"semetey-1-2013:p0081:b005:l035","ordinal":83091,"en":"Be sure to lower your head to the ground."},{"id":"semetey-1-2013:p0081:b005:l036","ordinal":83092,"en":"My cherished Kumaiyk,"},{"id":"semetey-1-2013:p0081:b005:l037","ordinal":83093,"en":"Be sure to find my orphan."},{"id":"semetey-1-2013:p0081:b005:l038","ordinal":83094,"en":"If you do not find my orphan,"},{"id":"semetey-1-2013:p0081:b005:l039","ordinal":83095,"en":"If you cannot recognize his trail,"},{"id":"semetey-1-2013:p0082:b003:l001","ordinal":83096,"en":"If you do not find my orphan,"},{"id":"semetey-1-2013:p0082:b003:l002","ordinal":83097,"en":"Around the world's four corners,"},{"id":"semetey-1-2013:p0082:b003:l003","ordinal":83098,"en":"If I do not chase you four times round,"},{"id":"semetey-1-2013:p0082:b003:l004","ordinal":83099,"en":"If, driving you before me,"},{"id":"semetey-1-2013:p0082:b003:l005","ordinal":83100,"en":"I do not force you into some pit,"},{"id":"semetey-1-2013:p0082:b003:l006","ordinal":83101,"en":"May I never have been born;"},{"id":"semetey-1-2013:p0082:b003:l007","ordinal":83102,"en":"May I die unworthy of the name Bakai!"},{"id":"semetey-1-2013:p0082:b003:l008","ordinal":83103,"en":"Know, Kumaiyk, I tell you, know!"},{"id":"semetey-1-2013:p0082:b003:l009","ordinal":83104,"en":"Know, and follow the trail, I tell you!"},{"id":"semetey-1-2013:p0082:b003:l010","ordinal":83105,"en":"Kumaiyk, find him for me, I tell you."},{"id":"semetey-1-2013:p0082:b003:l011","ordinal":83106,"en":"Kumaiyk, if you do not find him,"},{"id":"semetey-1-2013:p0082:b003:l012","ordinal":83107,"en":"To the earth's far end, Zhelpinish,"},{"id":"semetey-1-2013:p0082:b003:l013","ordinal":83108,"en":"If I do not drive and chase you to Zhelpinish,"},{"id":"semetey-1-2013:p0082:b003:l014","ordinal":83109,"en":"May I die unworthy of the name Bakai!"},{"id":"semetey-1-2013:p0082:b003:l015","ordinal":83110,"en":"Find him, Kumaiyk; let me see him."},{"id":"semetey-1-2013:p0082:b003:l016","ordinal":83111,"en":"Know, Kumaiyk, I tell you, know!"},{"id":"semetey-1-2013:p0082:b003:l017","ordinal":83112,"en":"Know, and follow the trail, I tell you!'"},{"id":"semetey-1-2013:p0082:b003:l018","ordinal":83113,"en":"Roaring in anger,"},{"id":"semetey-1-2013:p0082:b003:l019","ordinal":83114,"en":"He called out for Kumaiyk."},{"id":"semetey-1-2013:p0082:b003:l020","ordinal":83115,"en":"Inside the white mausoleum,"},{"id":"semetey-1-2013:p0082:b003:l021","ordinal":83116,"en":"Kumaiyk stood howling."},{"id":"semetey-1-2013:p0082:b003:l022","ordinal":83117,"en":"Though an animal, it was bewildered;"},{"id":"semetey-1-2013:p0082:b003:l023","ordinal":83118,"en":"Kumaiyk stood in misery."},{"id":"semetey-1-2013:p0082:b003:l024","ordinal":83119,"en":"Whimpering, its head to the earth"},{"id":"semetey-1-2013:p0082:b003:l025","ordinal":83120,"en":"Kumaiyk lowered."},{"id":"semetey-1-2013:p0082:b003:l026","ordinal":83121,"en":"It had no tongue to speak with;"},{"id":"semetey-1-2013:p0082:b003:l027","ordinal":83122,"en":"To what Bakai was saying,"},{"id":"semetey-1-2013:p0082:b003:l028","ordinal":83123,"en":"Kumaiyk listened."},{"id":"semetey-1-2013:p0082:b003:l029","ordinal":83124,"en":"That accursed Kumaiyk"},{"id":"semetey-1-2013:p0082:b003:l030","ordinal":83125,"en":"Bounded down into the lowlands,"},{"id":"semetey-1-2013:p0082:b003:l031","ordinal":83126,"en":"Crept along the ridges."},{"id":"semetey-1-2013:p0082:b003:l032","ordinal":83127,"en":"The rolling, mottled northern slope"},{"id":"semetey-1-2013:p0082:b003:l033","ordinal":83128,"en":"It sniffed along the forward trail."},{"id":"semetey-1-2013:p0082:b003:l034","ordinal":83129,"en":"The foothills along the bank-side road"},{"id":"semetey-1-2013:p0082:b003:l035","ordinal":83130,"en":"It sniffed seven times."},{"id":"semetey-1-2013:p0082:b003:l036","ordinal":83131,"en":"Keng-Chapchak's broad ridge,"},{"id":"semetey-1-2013:p0082:b003:l037","ordinal":83132,"en":"Kerme, the foot of Keng-Kol,"},{"id":"semetey-1-2013:p0082:b003:l038","ordinal":83133,"en":"The slope of Üyrülmö"},{"id":"semetey-1-2013:p0082:b003:l039","ordinal":83134,"en":"It sniffed three times."},{"id":"semetey-1-2013:p0082:b004:l001","ordinal":83135,"en":"Behind it Khan Bakai,"},{"id":"semetey-1-2013:p0082:b004:l002","ordinal":83136,"en":"Making it stumble in haste,"},{"id":"semetey-1-2013:p0082:b004:l003","ordinal":83137,"en":"Pressing it till its tail tucked down,"},{"id":"semetey-1-2013:p0082:b004:l004","ordinal":83138,"en":"His bellow splitting stones,"},{"id":"semetey-1-2013:p0082:b004:l005","ordinal":83139,"en":"Dear leopard Bakai,"},{"id":"semetey-1-2013:p0082:b004:l006","ordinal":83140,"en":"His shout splitting heads,"},{"id":"semetey-1-2013:p0082:b004:l007","ordinal":83141,"en":"Calling out for Kumaiyk,"},{"id":"semetey-1-2013:p0082:b004:l008","ordinal":83142,"en":"Striking now and again,"},{"id":"semetey-1-2013:p0082:b004:l009","ordinal":83143,"en":"Mighty Bakai drove it onward."},{"id":"semetey-1-2013:p0082:b004:l010","ordinal":83144,"en":"Out of its wits and stumbling,"},{"id":"semetey-1-2013:p0082:b004:l011","ordinal":83145,"en":"Kumaiyk hurried on."},{"id":"semetey-1-2013:p0082:b004:l012","ordinal":83146,"en":"Whipped now and again,"},{"id":"semetey-1-2013:p0082:b004:l013","ordinal":83147,"en":"Kumaiyk fled."},{"id":"semetey-1-2013:p0082:b004:l014","ordinal":83148,"en":"'If I do not make a spectacle for the ages,"},{"id":"semetey-1-2013:p0082:b004:l015","ordinal":83149,"en":"You damned Kumaiyk,"},{"id":"semetey-1-2013:p0082:b004:l016","ordinal":83150,"en":"If you do not find Kanykei for me,"},{"id":"semetey-1-2013:p0082:b004:l017","ordinal":83151,"en":"If I do not cut off your head!'"},{"id":"semetey-1-2013:p0082:b004:l018","ordinal":83152,"en":"His fiery eyes, unlike any others,"},{"id":"semetey-1-2013:p0082:b004:l019","ordinal":83153,"en":"Blazed as Khan Bakai went."},{"id":"semetey-1-2013:p0082:b004:l020","ordinal":83154,"en":"Roaring and beating the hound,"},{"id":"semetey-1-2013:p0082:b004:l021","ordinal":83155,"en":"Khan Bakai drove it onward."},{"id":"semetey-1-2013:p0082:b004:l022","ordinal":83156,"en":"Around Bel-Döbö of Üch-Kaikang"},{"id":"semetey-1-2013:p0082:b004:l023","ordinal":83157,"en":"He chased it three times."},{"id":"semetey-1-2013:p0082:b004:l024","ordinal":83158,"en":"At its wits' end, the white hound"},{"id":"semetey-1-2013:p0082:b004:l025","ordinal":83159,"en":"To Kaiypchy's Black Cave"},{"id":"semetey-1-2013:p0082:b004:l026","ordinal":83160,"en":"Fled and stood there."},{"id":"semetey-1-2013:p0082:b004:l027","ordinal":83161,"en":"Khan Bakai's gray winged steed"},{"id":"semetey-1-2013:p0082:b004:l028","ordinal":83162,"en":"Had lowered its head toward the earth."},{"id":"semetey-1-2013:p0082:b004:l029","ordinal":83163,"en":"The wind could not match its trot;"},{"id":"semetey-1-2013:p0082:b004:l030","ordinal":83164,"en":"No animal could match its steps."},{"id":"semetey-1-2013:p0082:b004:l031","ordinal":83165,"en":"That day the gray winged steed"},{"id":"semetey-1-2013:p0082:b004:l032","ordinal":83166,"en":"Had warmed to its running"},{"id":"semetey-1-2013:p0082:b004:l033","ordinal":83167,"en":"And lowered its head toward the earth."},{"id":"semetey-1-2013:p0082:b004:l034","ordinal":83168,"en":"Unable to regain its composure,"},{"id":"semetey-1-2013:p0082:b004:l035","ordinal":83169,"en":"To Kaiypchy's cave"},{"id":"semetey-1-2013:p0082:b004:l036","ordinal":83170,"en":"It fled and stood there."},{"id":"semetey-1-2013:p0082:b004:l037","ordinal":83171,"en":"Of that brown wether taken there,"},{"id":"semetey-1-2013:p0082:b004:l038","ordinal":83172,"en":"It found the bones."},{"id":"semetey-1-2013:p0082:b004:l039","ordinal":83173,"en":"The winding path she had walked crying out—"},{"id":"semetey-1-2013:p0083:b003:l001","ordinal":83174,"en":"Kumaiyk examined it closely"},{"id":"semetey-1-2013:p0083:b003:l002","ordinal":83175,"en":"And found the road she had taken."},{"id":"semetey-1-2013:p0083:b003:l003","ordinal":83176,"en":"When it saw Kanykei's trail,"},{"id":"semetey-1-2013:p0083:b003:l004","ordinal":83177,"en":"Unable to restrain itself, Kumaiyk"},{"id":"semetey-1-2013:p0083:b003:l005","ordinal":83178,"en":"Lowered its head to the ground."},{"id":"semetey-1-2013:p0083:b003:l006","ordinal":83179,"en":"Sniffing the black earth once,"},{"id":"semetey-1-2013:p0083:b003:l007","ordinal":83180,"en":"It howled and howled,"},{"id":"semetey-1-2013:p0083:b003:l008","ordinal":83181,"en":"Then set off at a run."},{"id":"semetey-1-2013:p0083:b003:l009","ordinal":83182,"en":"The lion Bakai, the leopard,"},{"id":"semetey-1-2013:p0083:b003:l010","ordinal":83183,"en":"Behind the hound,"},{"id":"semetey-1-2013:p0083:b003:l011","ordinal":83184,"en":"Whipping every which way,"},{"id":"semetey-1-2013:p0083:b003:l012","ordinal":83185,"en":"Spurring from either side,"},{"id":"semetey-1-2013:p0083:b003:l013","ordinal":83186,"en":"Without looking round about,"},{"id":"semetey-1-2013:p0083:b003:l014","ordinal":83187,"en":"When the hound fled onward,"},{"id":"semetey-1-2013:p0083:b003:l015","ordinal":83188,"en":"Bakai, the true holy man,"},{"id":"semetey-1-2013:p0083:b003:l016","ordinal":83189,"en":"Did not spare his life at all."},{"id":"semetey-1-2013:p0083:b003:l017","ordinal":83190,"en":"Without scanning all around,"},{"id":"semetey-1-2013:p0083:b003:l018","ordinal":83191,"en":"When the hound fled onward,"},{"id":"semetey-1-2013:p0083:b003:l019","ordinal":83192,"en":"Holy Bakai, blessed by Khizyr,"},{"id":"semetey-1-2013:p0083:b003:l020","ordinal":83193,"en":"Spared his life not even a hair's worth."},{"id":"semetey-1-2013:p0083:b003:l021","ordinal":83194,"en":"The dear lion, cocklike in bearing,"},{"id":"semetey-1-2013:p0083:b003:l022","ordinal":83195,"en":"Raised a commotion, shouting."},{"id":"semetey-1-2013:p0083:b003:l023","ordinal":83196,"en":"That he would not cease pursuing,"},{"id":"semetey-1-2013:p0083:b003:l024","ordinal":83197,"en":"When the hound realized this,"},{"id":"semetey-1-2013:p0083:b003:l025","ordinal":83198,"en":"The white hound, wiser than a human,"},{"id":"semetey-1-2013:p0083:b003:l026","ordinal":83199,"en":"Flattened its ears and lowered its head."},{"id":"semetey-1-2013:p0083:b003:l027","ordinal":83200,"en":"Sparing its wretched life no mercy,"}]
