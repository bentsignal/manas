[{"id":"manas-2010:p0927:b001:l033","ordinal":40705,"en":"Not one of our people will remain alive."},{"id":"manas-2010:p0927:b001:l034","ordinal":40706,"en":"If we fight a woman,"},{"id":"manas-2010:p0927:b001:l035","ordinal":40707,"en":"Our affairs will go awry."},{"id":"manas-2010:p0927:b001:l036","ordinal":40708,"en":"Ajybay, of Argyn Khan—"},{"id":"manas-2010:p0927:b001:l037","ordinal":40709,"en":"Kartküröng beneath him"},{"id":"manas-2010:p0927:b001:l038","ordinal":40710,"en":"Is Ajybay's wing."},{"id":"manas-2010:p0927:b001:l039","ordinal":40711,"en":"At any time, Ajybay"},{"id":"manas-2010:p0927:b001:l040","ordinal":40712,"en":"Is accustomed to carrying news."},{"id":"manas-2010:p0927:b001:l041","ordinal":40713,"en":"Your blessing will not go amiss."},{"id":"manas-2010:p0927:b001:l042","ordinal":40714,"en":"The owner of vast herds,"},{"id":"manas-2010:p0928:b001:l001","ordinal":40715,"en":"Khan Jakyp is your father."},{"id":"manas-2010:p0928:b001:l002","ordinal":40716,"en":"Send your father a letter;"},{"id":"manas-2010:p0928:b001:l003","ordinal":40717,"en":"If you send it, send it quickly."},{"id":"manas-2010:p0928:b001:l004","ordinal":40718,"en":"Let him give a thousand dark camels;"},{"id":"manas-2010:p0928:b001:l005","ordinal":40719,"en":"Let him give a thousand black, blaze-faced mares."},{"id":"manas-2010:p0928:b001:l006","ordinal":40720,"en":"All those animals,"},{"id":"manas-2010:p0928:b001:l007","ordinal":40721,"en":"With old Kyrgyl at their head,"},{"id":"manas-2010:p0928:b001:l008","ordinal":40722,"en":"Let him have the forty warriors drive."},{"id":"manas-2010:p0928:b001:l009","ordinal":40723,"en":"When you migrated here from Altay,"},{"id":"manas-2010:p0928:b001:l010","ordinal":40724,"en":"The herd's leader, the dun mare,"},{"id":"manas-2010:p0928:b001:l011","ordinal":40725,"en":"Was she not your fondest wish?"},{"id":"manas-2010:p0928:b001:l012","ordinal":40726,"en":"Upon the dun mare's head,"},{"id":"manas-2010:p0928:b001:l013","ordinal":40727,"en":"White cotton the size of a horse's head—"},{"id":"manas-2010:p0928:b001:l014","ordinal":40728,"en":"“Here is your pure wish,” let him say,"},{"id":"manas-2010:p0928:b001:l015","ordinal":40729,"en":"And tie it to the dun mare."},{"id":"manas-2010:p0928:b001:l016","ordinal":40730,"en":"The vast herds lying in their multitudes,"},{"id":"manas-2010:p0928:b001:l017","ordinal":40731,"en":"Expending them for Manas,"},{"id":"manas-2010:p0928:b001:l018","ordinal":40732,"en":"Let him drive them away for his wish."},{"id":"manas-2010:p0928:b001:l019","ordinal":40733,"en":"Yesterday, when Maymun was raided,"},{"id":"manas-2010:p0928:b001:l020","ordinal":40734,"en":"When slaughter was dealt to the Kalcha,"},{"id":"manas-2010:p0928:b001:l021","ordinal":40735,"en":"When the great body of people was gathered,"},{"id":"manas-2010:p0928:b001:l022","ordinal":40736,"en":"Ninety one-humped camels fell as spoil."},{"id":"manas-2010:p0928:b001:l023","ordinal":40737,"en":"Upon those ninety one-humped camels"},{"id":"manas-2010:p0928:b001:l024","ordinal":40738,"en":"Let him load gold coins to the full."},{"id":"manas-2010:p0928:b001:l025","ordinal":40739,"en":"Tell ill-intentioned Khan Jakyp"},{"id":"manas-2010:p0928:b001:l026","ordinal":40740,"en":"To comply with what is said."},{"id":"manas-2010:p0928:b001:l027","ordinal":40741,"en":"Of all these many animals named,"},{"id":"manas-2010:p0928:b001:l028","ordinal":40742,"en":"Tell him to give every one, withholding none!”"},{"id":"manas-2010:p0928:b001:l029","ordinal":40743,"en":"Bakay devised the marvelous plan;"},{"id":"manas-2010:p0928:b001:l030","ordinal":40744,"en":"Manas issued the command!"},{"id":"manas-2010:p0928:b001:l031","ordinal":40745,"en":"Beyond Andijan,"},{"id":"manas-2010:p0928:b001:l032","ordinal":40746,"en":"On this side of Amangen,"},{"id":"manas-2010:p0928:b001:l033","ordinal":40747,"en":"In the shelter of the khan of Kokand,"},{"id":"manas-2010:p0928:b001:l034","ordinal":40748,"en":"From the moon-pale yellow plain"},{"id":"manas-2010:p0928:b001:l035","ordinal":40749,"en":"He sent Ajybay off."},{"id":"manas-2010:p0928:b001:l036","ordinal":40750,"en":"Ajybay, of Argyn Khan—"},{"id":"manas-2010:p0928:b001:l037","ordinal":40751,"en":"Would your Ajy stand without mounting?"},{"id":"manas-2010:p0928:b001:l038","ordinal":40752,"en":"Once Bakay had found the plan,"},{"id":"manas-2010:p0928:b001:l039","ordinal":40753,"en":"Ajybay, born a hero—"},{"id":"manas-2010:p0928:b001:l040","ordinal":40754,"en":"Would God strike him with reluctance?"},{"id":"manas-2010:p0928:b001:l041","ordinal":40755,"en":"Ajybay, of Argyn Khan—"},{"id":"manas-2010:p0928:b001:l042","ordinal":40756,"en":"Kartküröng beneath him,"},{"id":"manas-2010:p0929:b001:l001","ordinal":40757,"en":"When he let its mouth go free,"},{"id":"manas-2010:p0929:b001:l002","ordinal":40758,"en":"Sped as though about to fly,"},{"id":"manas-2010:p0929:b001:l003","ordinal":40759,"en":"Thundering like Zhelkayyp."},{"id":"manas-2010:p0929:b001:l004","ordinal":40760,"en":"Where it trod, black rock"},{"id":"manas-2010:p0929:b001:l005","ordinal":40761,"en":"Shattered into powdered sand."},{"id":"manas-2010:p0929:b001:l006","ordinal":40762,"en":"Fire sprang from all four feet,"},{"id":"manas-2010:p0929:b001:l007","ordinal":40763,"en":"Striking together like flint."},{"id":"manas-2010:p0929:b001:l008","ordinal":40764,"en":"“Perhaps it will fly away,” he thought;"},{"id":"manas-2010:p0929:b001:l009","ordinal":40765,"en":"Ajybay, of Argyn Khan,"},{"id":"manas-2010:p0929:b001:l010","ordinal":40766,"en":"The peerless racer Küröng—"},{"id":"manas-2010:p0929:b001:l011","ordinal":40767,"en":"He wrestled with its mouth for control."},{"id":"manas-2010:p0929:b001:l012","ordinal":40768,"en":"In the blink of an eye,"},{"id":"manas-2010:p0929:b001:l013","ordinal":40769,"en":"He crossed Zhorgo's ridge"},{"id":"manas-2010:p0929:b001:l014","ordinal":40770,"en":"And entered great Talas."},{"id":"manas-2010:p0929:b001:l015","ordinal":40771,"en":"To the lower side of Tört-Kül"},{"id":"manas-2010:p0929:b001:l016","ordinal":40772,"en":"Ajybay now arrived,"},{"id":"manas-2010:p0929:b001:l017","ordinal":40773,"en":"At noble Manas's garden."},{"id":"manas-2010:p0929:b001:l018","ordinal":40774,"en":"Your bloodthirsty one's forty distinguished men—"},{"id":"manas-2010:p0929:b001:l019","ordinal":40775,"en":"Each of the forty had his separate way."},{"id":"manas-2010:p0929:b001:l020","ordinal":40776,"en":"Up along the Talas,"},{"id":"manas-2010:p0929:b001:l021","ordinal":40777,"en":"They had pitched their camps."},{"id":"manas-2010:p0929:b001:l022","ordinal":40778,"en":"Those who grappled with them, like lions"},{"id":"manas-2010:p0929:b001:l023","ordinal":40779,"en":"They were devouring."},{"id":"manas-2010:p0929:b001:l024","ordinal":40780,"en":"All the forty warriors,"},{"id":"manas-2010:p0929:b001:l025","ordinal":40781,"en":"The elders with Kyrgyl at their head,"},{"id":"manas-2010:p0929:b001:l026","ordinal":40782,"en":"Were carried away with excitement."},{"id":"manas-2010:p0929:b001:l027","ordinal":40783,"en":"Until their champion Manas returned,"},{"id":"manas-2010:p0929:b001:l028","ordinal":40784,"en":"All the forty warriors"},{"id":"manas-2010:p0929:b001:l029","ordinal":40785,"en":"Were excited as though gone mad,"},{"id":"manas-2010:p0929:b001:l030","ordinal":40786,"en":"Roaring out, unconcerned."},{"id":"manas-2010:p0929:b001:l031","ordinal":40787,"en":"Even if blazing fire swept over them,"},{"id":"manas-2010:p0929:b001:l032","ordinal":40788,"en":"They would not reckon it worth a trouser-leg."},{"id":"manas-2010:p0929:b001:l033","ordinal":40789,"en":"Their sultan Manas had become khan;"},{"id":"manas-2010:p0929:b001:l034","ordinal":40790,"en":"Of those who behaved improperly,"},{"id":"manas-2010:p0929:b001:l035","ordinal":40791,"en":"Quite a number had been laid low."},{"id":"manas-2010:p0929:b001:l036","ordinal":40792,"en":"No mortal could face them;"},{"id":"manas-2010:p0929:b001:l037","ordinal":40793,"en":"No enemy could strike at their waist."},{"id":"manas-2010:p0929:b001:l038","ordinal":40794,"en":"This Talas, where the champions stayed,"},{"id":"manas-2010:p0929:b001:l039","ordinal":40795,"en":"Had become secure."},{"id":"manas-2010:p0929:b001:l040","ordinal":40796,"en":"Taking spears with blue tassels,"},{"id":"manas-2010:p0929:b001:l041","ordinal":40797,"en":"Girding swords without sheaths,"},{"id":"manas-2010:p0929:b001:l042","ordinal":40798,"en":"Keeping watch and following tracks,"},{"id":"manas-2010:p0930:b001:l001","ordinal":40799,"en":"The forty warriors had remained,"},{"id":"manas-2010:p0930:b001:l002","ordinal":40800,"en":"Circling round and guarding Talas."},{"id":"manas-2010:p0930:b001:l003","ordinal":40801,"en":"As twilight fell and the sun set,"},{"id":"manas-2010:p0930:b001:l004","ordinal":40802,"en":"Ajybay's silhouette"},{"id":"manas-2010:p0930:b001:l005","ordinal":40803,"en":"A warrior saw from afar."},{"id":"manas-2010:p0930:b001:l006","ordinal":40804,"en":"Answering a cry with a shout,"},{"id":"manas-2010:p0930:b001:l007","ordinal":40805,"en":"The forty warriors, heroes all,"},{"id":"manas-2010:p0930:b001:l008","ordinal":40806,"en":"Ran with spears in hand."},{"id":"manas-2010:p0930:b001:l009","ordinal":40807,"en":"Their courage knew no bounds;"},{"id":"manas-2010:p0930:b001:l010","ordinal":40808,"en":"They leaped and sprang like roe deer."},{"id":"manas-2010:p0930:b001:l011","ordinal":40809,"en":"The forty saddled steeds—"},{"id":"manas-2010:p0930:b001:l012","ordinal":40810,"en":"All forty ran up and mounted."},{"id":"manas-2010:p0930:b001:l013","ordinal":40811,"en":"Not shrinking back from death,"},{"id":"manas-2010:p0930:b001:l014","ordinal":40812,"en":"They all moved out together."},{"id":"manas-2010:p0930:b001:l015","ordinal":40813,"en":"All the forty warriors,"},{"id":"manas-2010:p0930:b001:l016","ordinal":40814,"en":"The elders with Kyrgyl at their head,"},{"id":"manas-2010:p0930:b001:l017","ordinal":40815,"en":"Went out on lookout and gazed,"},{"id":"manas-2010:p0930:b001:l018","ordinal":40816,"en":"Wishing safety for the people."},{"id":"manas-2010:p0930:b001:l019","ordinal":40817,"en":"Bloodthirsty Manas's confidant,"},{"id":"manas-2010:p0930:b001:l020","ordinal":40818,"en":"The leopard's companion,"},{"id":"manas-2010:p0930:b001:l021","ordinal":40819,"en":"Was Khan Ajybay himself,"},{"id":"manas-2010:p0930:b001:l022","ordinal":40820,"en":"Who from the bloodthirsty lion's presence"},{"id":"manas-2010:p0930:b001:l023","ordinal":40821,"en":"Had now come bringing news."},{"id":"manas-2010:p0930:b001:l024","ordinal":40822,"en":"Standing in a row, the forty warriors"},{"id":"manas-2010:p0930:b001:l025","ordinal":40823,"en":"Shouted fiercely,"},{"id":"manas-2010:p0930:b001:l026","ordinal":40824,"en":"Calling to Ajybay:"},{"id":"manas-2010:p0930:b001:l027","ordinal":40825,"en":"“Is there a mountain to climb?"},{"id":"manas-2010:p0930:b001:l028","ordinal":40826,"en":"You have come hurrying—"},{"id":"manas-2010:p0930:b001:l029","ordinal":40827,"en":"Hey, Ajybay, is there an enemy?”"},{"id":"manas-2010:p0930:b001:l030","ordinal":40828,"en":"“Your fathers' graves, forty warriors!"},{"id":"manas-2010:p0930:b001:l031","ordinal":40829,"en":"There is no yellow, ridged mountain;"},{"id":"manas-2010:p0930:b001:l032","ordinal":40830,"en":"There is no enemy who has come to fight."},{"id":"manas-2010:p0930:b001:l033","ordinal":40831,"en":"Grazing freely, eating at leisure,"},{"id":"manas-2010:p0930:b001:l034","ordinal":40832,"en":"Eating the herd's unbred yearlings,"},{"id":"manas-2010:p0930:b001:l035","ordinal":40833,"en":"Your thick forearms have filled out."},{"id":"manas-2010:p0930:b001:l036","ordinal":40834,"en":"There is no ship on the dark water;"},{"id":"manas-2010:p0930:b001:l037","ordinal":40835,"en":"While the bloodthirsty one is alive and well,"},{"id":"manas-2010:p0930:b001:l038","ordinal":40836,"en":"There is no one to oppose him."},{"id":"manas-2010:p0930:b001:l039","ordinal":40837,"en":"When we set out from boredom,"},{"id":"manas-2010:p0930:b001:l040","ordinal":40838,"en":"We camp on the empty steppe."},{"id":"manas-2010:p0930:b001:l041","ordinal":40839,"en":"Loading eighty camels with gold coins,"},{"id":"manas-2010:p0930:b001:l042","ordinal":40840,"en":"For noble lion Manas,"},{"id":"manas-2010:p0931:b001:l001","ordinal":40841,"en":"We shall be the bridegroom's companions."},{"id":"manas-2010:p0931:b001:l002","ordinal":40842,"en":"Temirkan, the khan of Bukhara—"},{"id":"manas-2010:p0931:b001:l003","ordinal":40843,"en":"Traveling toward Temirkan,"},{"id":"manas-2010:p0931:b001:l004","ordinal":40844,"en":"Saying, “Give her to the magnanimous khan,”"},{"id":"manas-2010:p0931:b001:l005","ordinal":40845,"en":"We shall place betrothal earrings on his daughter."},{"id":"manas-2010:p0931:b001:l006","ordinal":40846,"en":"Driving a thousand dark camels,"},{"id":"manas-2010:p0931:b001:l007","ordinal":40847,"en":"Driving a thousand black, blaze-faced mares,"},{"id":"manas-2010:p0931:b001:l008","ordinal":40848,"en":"To Temir, the khan of Bukhara,"},{"id":"manas-2010:p0931:b001:l009","ordinal":40849,"en":"We shall go as prospective in-laws!"},{"id":"manas-2010:p0931:b001:l010","ordinal":40850,"en":"Driving ninety dark one-humped camels,"},{"id":"manas-2010:p0931:b001:l011","ordinal":40851,"en":"Driving abundant livestock,"},{"id":"manas-2010:p0931:b001:l012","ordinal":40852,"en":"To that poor soul Kanykey"},{"id":"manas-2010:p0931:b001:l013","ordinal":40853,"en":"We shall go and place betrothal earrings!"},{"id":"manas-2010:p0931:b001:l014","ordinal":40854,"en":"Kanykey, endowed with sacred powers—"},{"id":"manas-2010:p0931:b001:l015","ordinal":40855,"en":"Warriors, understand her decorous words."},{"id":"manas-2010:p0931:b001:l016","ordinal":40856,"en":"If you hear news of that fierce woman,"},{"id":"manas-2010:p0931:b001:l017","ordinal":40857,"en":"She is no mere Kanykey, but blessed good fortune."},{"id":"manas-2010:p0931:b001:l018","ordinal":40858,"en":"Kanykey, Karakan's daughter,"},{"id":"manas-2010:p0931:b001:l019","ordinal":40859,"en":"For Khan Manas himself,"},{"id":"manas-2010:p0931:b001:l020","ordinal":40860,"en":"Will she not come as queen?"},{"id":"manas-2010:p0931:b001:l021","ordinal":40861,"en":"Look, forty warriors:"},{"id":"manas-2010:p0931:b001:l022","ordinal":40862,"en":"At the very least, for you,"},{"id":"manas-2010:p0931:b001:l023","ordinal":40863,"en":"Will she not provide roe deer's milk?"},{"id":"manas-2010:p0931:b001:l024","ordinal":40864,"en":"The magnanimous one's wife Akylay—"},{"id":"manas-2010:p0931:b001:l025","ordinal":40865,"en":"Oh, that witless unbeliever!"},{"id":"manas-2010:p0931:b001:l026","ordinal":40866,"en":"When she speaks, her words are many,"},{"id":"manas-2010:p0931:b001:l027","ordinal":40867,"en":"A hot-tempered troublemaker, a coarse soul."},{"id":"manas-2010:p0931:b001:l028","ordinal":40868,"en":"Her malignity is great, her venom strong."},{"id":"manas-2010:p0931:b001:l029","ordinal":40869,"en":"If you live with Akylay,"},{"id":"manas-2010:p0931:b001:l030","ordinal":40870,"en":"Your fathers' graves, forty warriors,"},{"id":"manas-2010:p0931:b001:l031","ordinal":40871,"en":"You forty, forty companions from forty places,"},{"id":"manas-2010:p0931:b001:l032","ordinal":40872,"en":"Give up hope of your lives held in trust!"},{"id":"manas-2010:p0931:b001:l033","ordinal":40873,"en":"If Akylay stays in the court,"},{"id":"manas-2010:p0931:b001:l034","ordinal":40874,"en":"You will be frantic, finding no way out."},{"id":"manas-2010:p0931:b001:l035","ordinal":40875,"en":"Unwilling to stay with the noble falcon,"},{"id":"manas-2010:p0931:b001:l036","ordinal":40876,"en":"You will flee in all directions!"},{"id":"manas-2010:p0931:b001:l037","ordinal":40877,"en":"If Kanykey comes to Manas,"},{"id":"manas-2010:p0931:b001:l038","ordinal":40878,"en":"What will happen six months hence,"},{"id":"manas-2010:p0931:b001:l039","ordinal":40879,"en":"She can tell you now."},{"id":"manas-2010:p0931:b001:l040","ordinal":40880,"en":"A saint, they say, a seer, they say."},{"id":"manas-2010:p0931:b001:l041","ordinal":40881,"en":"If you settle beside her, Kanykey"},{"id":"manas-2010:p0931:b001:l042","ordinal":40882,"en":"Is a splendid ridge to camp upon."},{"id":"manas-2010:p0932:b001:l001","ordinal":40883,"en":"If you are Manas's warriors,"},{"id":"manas-2010:p0932:b001:l002","ordinal":40884,"en":"She is the one who will ease your burdens."},{"id":"manas-2010:p0932:b001:l003","ordinal":40885,"en":"I hear that fierce woman is good;"},{"id":"manas-2010:p0932:b001:l004","ordinal":40886,"en":"Her goodness is proven among the people."},{"id":"manas-2010:p0932:b001:l005","ordinal":40887,"en":"If she comes to this place,"},{"id":"manas-2010:p0932:b001:l006","ordinal":40888,"en":"She is lasting good fortune, a sustaining kinswoman."},{"id":"manas-2010:p0932:b001:l007","ordinal":40889,"en":"If Kanykey comes,"},{"id":"manas-2010:p0932:b001:l008","ordinal":40890,"en":"Every sorrow will scatter;"},{"id":"manas-2010:p0932:b001:l009","ordinal":40891,"en":"Thus your brows will clear."},{"id":"manas-2010:p0932:b001:l010","ordinal":40892,"en":"If Khan Manas is your lord,"},{"id":"manas-2010:p0932:b001:l011","ordinal":40893,"en":"If Kanykey is your elder brother's wife,"},{"id":"manas-2010:p0932:b001:l012","ordinal":40894,"en":"When bored, you will shoot roe deer;"},{"id":"manas-2010:p0932:b001:l013","ordinal":40895,"en":"When not bored, in Talas"},{"id":"manas-2010:p0932:b001:l014","ordinal":40896,"en":"You will play at ease!"},{"id":"manas-2010:p0932:b001:l015","ordinal":40897,"en":"If you turn toward the enemy,"},{"id":"manas-2010:p0932:b001:l016","ordinal":40898,"en":"Forty warriors favored by fortune,"},{"id":"manas-2010:p0932:b001:l017","ordinal":40899,"en":"Whatever equipment you lack will be found."},{"id":"manas-2010:p0932:b001:l018","ordinal":40900,"en":"If Kanykey of sacred powers"},{"id":"manas-2010:p0932:b001:l019","ordinal":40901,"en":"Keeps a court in Talas,"},{"id":"manas-2010:p0932:b001:l020","ordinal":40902,"en":"All the forty warriors,"},{"id":"manas-2010:p0932:b001:l021","ordinal":40903,"en":"The elders with Kyrgyl at their head,"},{"id":"manas-2010:p0932:b001:l022","ordinal":40904,"en":"Will encounter blessed good fortune."},{"id":"manas-2010:p0932:b001:l023","ordinal":40905,"en":"Forty wolves from forty places,"},{"id":"manas-2010:p0932:b001:l024","ordinal":40906,"en":"Your luck has turned auspiciously!"},{"id":"manas-2010:p0932:b001:l025","ordinal":40907,"en":"These are your mighty Manas's words!”"},{"id":"manas-2010:p0932:b001:l026","ordinal":40908,"en":"These words that Ajybay spoke—"},{"id":"manas-2010:p0932:b001:l027","ordinal":40909,"en":"Would the warriors who heard stand still?"},{"id":"manas-2010:p0932:b001:l028","ordinal":40910,"en":"At “Get it!” they sprang forward;"},{"id":"manas-2010:p0932:b001:l029","ordinal":40911,"en":"The forty peerless champions,"},{"id":"manas-2010:p0932:b001:l030","ordinal":40912,"en":"At “Ho!” they cried, “Go!”"},{"id":"manas-2010:p0932:b001:l031","ordinal":40913,"en":"They were heroes, they were lions,"},{"id":"manas-2010:p0932:b001:l032","ordinal":40914,"en":"Men of boundless might,"},{"id":"manas-2010:p0932:b001:l033","ordinal":40915,"en":"Their number reaching forty,"},{"id":"manas-2010:p0932:b001:l034","ordinal":40916,"en":"Of champion, wolf-maned Manas"},{"id":"manas-2010:p0932:b001:l035","ordinal":40917,"en":"The wings he drew in to fly."},{"id":"manas-2010:p0932:b001:l036","ordinal":40918,"en":"If one said “Get it!” to these men,"},{"id":"manas-2010:p0932:b001:l037","ordinal":40919,"en":"They were wont to shatter the world."},{"id":"manas-2010:p0932:b001:l038","ordinal":40920,"en":"Hearing the words from Ajybay,"},{"id":"manas-2010:p0932:b001:l039","ordinal":40921,"en":"“Kanykey—hero Manas"},{"id":"manas-2010:p0932:b001:l040","ordinal":40922,"en":"Is going to marry her,” they heard;"},{"id":"manas-2010:p0932:b001:l041","ordinal":40923,"en":"The elders with Kyrgyl at their head"},{"id":"manas-2010:p0932:b001:l042","ordinal":40924,"en":"Stirred in delighted commotion,"},{"id":"manas-2010:p0933:b001:l001","ordinal":40925,"en":"All the forty warriors."},{"id":"manas-2010:p0933:b001:l002","ordinal":40926,"en":"If one looked at the forty warriors,"},{"id":"manas-2010:p0933:b001:l003","ordinal":40927,"en":"Their figures, their forms,"},{"id":"manas-2010:p0933:b001:l004","ordinal":40928,"en":"Their appearance mounted on horses"},{"id":"manas-2010:p0933:b001:l005","ordinal":40929,"en":"Seemed like night-devouring demons."},{"id":"manas-2010:p0933:b001:l006","ordinal":40930,"en":"All were heroes, distinguished champions,"},{"id":"manas-2010:p0933:b001:l007","ordinal":40931,"en":"Whom no mortal could dare face,"},{"id":"manas-2010:p0933:b001:l008","ordinal":40932,"en":"Their aspect unlike other beings'."},{"id":"manas-2010:p0933:b001:l009","ordinal":40933,"en":"Among the forty warriors,"},{"id":"manas-2010:p0933:b001:l010","ordinal":40934,"en":"What was there, and what was lacking!"},{"id":"manas-2010:p0933:b001:l011","ordinal":40935,"en":"One who lifted a camel alone—"},{"id":"manas-2010:p0933:b001:l012","ordinal":40936,"en":"There was a mighty wrestler among them too."},{"id":"manas-2010:p0933:b001:l013","ordinal":40937,"en":"One who dealt slaughter to the world—"},{"id":"manas-2010:p0933:b001:l014","ordinal":40938,"en":"There was such a warrior too."},{"id":"manas-2010:p0933:b001:l015","ordinal":40939,"en":"Unmoving beneath the banner,"},{"id":"manas-2010:p0933:b001:l016","ordinal":40940,"en":"In dire and difficult affairs,"},{"id":"manas-2010:p0933:b001:l017","ordinal":40941,"en":"There was a warrior who stood firm too."},{"id":"manas-2010:p0933:b001:l018","ordinal":40942,"en":"Without fearing death before him,"},{"id":"manas-2010:p0933:b001:l019","ordinal":40943,"en":"A piercing shout of encouragement—"},{"id":"manas-2010:p0933:b001:l020","ordinal":40944,"en":"There was a warrior who raised it too."},{"id":"manas-2010:p0933:b001:l021","ordinal":40945,"en":"Those he encountered, like a wolf,"},{"id":"manas-2010:p0933:b001:l022","ordinal":40946,"en":"There was a warrior who tore apart too."},{"id":"manas-2010:p0933:b001:l023","ordinal":40947,"en":"When service was commanded,"},{"id":"manas-2010:p0933:b001:l024","ordinal":40948,"en":"There was a warrior who performed it too."},{"id":"manas-2010:p0933:b001:l025","ordinal":40949,"en":"Unshaken in his promise,"},{"id":"manas-2010:p0933:b001:l026","ordinal":40950,"en":"There was a warrior who stood by it too."},{"id":"manas-2010:p0933:b001:l027","ordinal":40951,"en":"Both a wrestler and a lion,"},{"id":"manas-2010:p0933:b001:l028","ordinal":40952,"en":"There was an outstanding warrior too."},{"id":"manas-2010:p0933:b001:l029","ordinal":40953,"en":"One who attacked a vast host—"},{"id":"manas-2010:p0933:b001:l030","ordinal":40954,"en":"There was a keen warrior too."},{"id":"manas-2010:p0933:b001:l031","ordinal":40955,"en":"Of Sultan, wolf-maned Manas,"},{"id":"manas-2010:p0933:b001:l032","ordinal":40956,"en":"The knots to untie correctly—"},{"id":"manas-2010:p0933:b001:l033","ordinal":40957,"en":"There was a wise warrior for that too."},{"id":"manas-2010:p0933:b001:l034","ordinal":40958,"en":"Splitting a black hair exactly in two,"},{"id":"manas-2010:p0933:b001:l035","ordinal":40959,"en":"Exceptional in his impartiality,"},{"id":"manas-2010:p0933:b001:l036","ordinal":40960,"en":"There was a learned warrior too."}]
