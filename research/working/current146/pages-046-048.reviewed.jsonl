{"id": "sayakbay-ms-current146:pdf048:l021", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 48, "folio": 431, "line_in_page": 21, "raw": "Чынысын айтып келгиле.", "text": "Чынысын айтып келгиле.", "en": "Come and tell the truth of it.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf048:l022", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 48, "folio": 431, "line_in_page": 22, "raw": "Соодагер болуп жортууга,", "text": "Соодагер болуп жортууга,", "en": "To ride out in the guise of merchants,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf048:l023", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 48, "folio": 431, "line_in_page": 23, "raw": "Эрдигин канча билгиле,", "text": "Эрдигин канча билгиле,", "en": "Learn the full measure of his valor,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The manuscript may read a different quantifier before билгиле.", "bbox": null}
