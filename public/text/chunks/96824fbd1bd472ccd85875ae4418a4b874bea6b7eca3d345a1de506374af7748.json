[{"id":"semetey-2-2013:p1210:b003:l022","ordinal":279809,"en":"Your hero Choro"},{"id":"semetey-2-2013:p1210:b003:l023","ordinal":279810,"en":"Strapped on his heavy musket"},{"id":"semetey-2-2013:p1210:b003:l024","ordinal":279811,"en":"And readied his weapons."},{"id":"semetey-2-2013:p1210:b003:l025","ordinal":279812,"en":"At that moment Kanchoro—"},{"id":"semetey-2-2013:p1210:b003:l026","ordinal":279813,"en":"Among spearmen, Choro"},{"id":"semetey-2-2013:p1210:b003:l027","ordinal":279814,"en":"Had skill and cunning;"},{"id":"semetey-2-2013:p1210:b003:l028","ordinal":279815,"en":"As an expert marksman, Choro"},{"id":"semetey-2-2013:p1210:b003:l029","ordinal":279816,"en":"Had matchless prowess;"},{"id":"semetey-2-2013:p1210:b003:l030","ordinal":279817,"en":"As a deviser of stratagems, Choro"},{"id":"semetey-2-2013:p1210:b003:l031","ordinal":279818,"en":"Had skill and cunning—"},{"id":"semetey-2-2013:p1210:b003:l032","ordinal":279819,"en":"Blocked the ridge of Talas"},{"id":"semetey-2-2013:p1210:b003:l033","ordinal":279820,"en":"As far as the eye could see,"},{"id":"semetey-2-2013:p1210:b003:l034","ordinal":279821,"en":"And lay in wait at the place"},{"id":"semetey-2-2013:p1210:b003:l035","ordinal":279822,"en":"Where Sary Khan would come over the rise."},{"id":"semetey-2-2013:p1210:b003:l036","ordinal":279823,"en":"At that moment Sary Khan,"},{"id":"semetey-2-2013:p1210:b003:l037","ordinal":279824,"en":"Before one could cry, “Look out!”"},{"id":"semetey-2-2013:p1210:b003:l038","ordinal":279825,"en":"In the blink of an eye,"},{"id":"semetey-2-2013:p1210:b003:l039","ordinal":279826,"en":"Was overwhelmed by fury;"},{"id":"semetey-2-2013:p1210:b004:l001","ordinal":279827,"en":"Your uncle the khan, distraught,"},{"id":"semetey-2-2013:p1210:b004:l002","ordinal":279828,"en":"Could not find Semetey."},{"id":"semetey-2-2013:p1210:b004:l003","ordinal":279829,"en":"At that moment Sary Khan,"},{"id":"semetey-2-2013:p1210:b004:l004","ordinal":279830,"en":"His heroic heart constricted,"},{"id":"semetey-2-2013:p1210:b004:l005","ordinal":279831,"en":"Not knowing whom he approached,"},{"id":"semetey-2-2013:p1210:b004:l006","ordinal":279832,"en":"Rode up onto the ridge."},{"id":"semetey-2-2013:p1210:b004:l007","ordinal":279833,"en":"Kanchoro lay in ambush;"},{"id":"semetey-2-2013:p1210:b004:l008","ordinal":279834,"en":"Sary Khan came onto open ground"},{"id":"semetey-2-2013:p1210:b004:l009","ordinal":279835,"en":"And drew near to the hero Kanchoro,"},{"id":"semetey-2-2013:p1210:b004:l010","ordinal":279836,"en":"That treacherous infidel."},{"id":"semetey-2-2013:p1210:b004:l011","ordinal":279837,"en":"Sary Khan came close."},{"id":"semetey-2-2013:p1210:b004:l012","ordinal":279838,"en":"As he crossed the saddle-shaped pass,"},{"id":"semetey-2-2013:p1210:b004:l013","ordinal":279839,"en":"Over the rough white rising ground,"},{"id":"semetey-2-2013:p1210:b004:l014","ordinal":279840,"en":"With a broad flat below,"},{"id":"semetey-2-2013:p1210:b004:l015","ordinal":279841,"en":"And went farther on,"},{"id":"semetey-2-2013:p1210:b004:l016","ordinal":279842,"en":"At Echoing Jar-Kyya,"},{"id":"semetey-2-2013:p1210:b004:l017","ordinal":279843,"en":"Along a track wide enough for one horse,"},{"id":"semetey-2-2013:p1210:b004:l018","ordinal":279844,"en":"In that narrow winding defile,"},{"id":"semetey-2-2013:p1210:b004:l019","ordinal":279845,"en":"Where a black rock as large as a yurt"},{"id":"semetey-2-2013:p1210:b004:l020","ordinal":279846,"en":"Forced riders to squeeze past,"},{"id":"semetey-2-2013:p1210:b004:l021","ordinal":279847,"en":"The hero Kanchoro,"},{"id":"semetey-2-2013:p1210:b004:l022","ordinal":279848,"en":"That treacherous infidel,"},{"id":"semetey-2-2013:p1210:b004:l023","ordinal":279849,"en":"Displayed the perfection of his marksmanship;"},{"id":"semetey-2-2013:p1210:b004:l024","ordinal":279850,"en":"His deadly, formidable gun"},{"id":"semetey-2-2013:p1210:b004:l025","ordinal":279851,"en":"Destroyed whatever it was aimed at."},{"id":"semetey-2-2013:p1210:b004:l026","ordinal":279852,"en":"My uncle Sary rode straight in,"},{"id":"semetey-2-2013:p1210:b004:l027","ordinal":279853,"en":"My uncle Sary, defender of the people;"},{"id":"semetey-2-2013:p1210:b004:l028","ordinal":279854,"en":"Brave Kyyaz confronted him,"},{"id":"semetey-2-2013:p1210:b004:l029","ordinal":279855,"en":"And fought with Kyyaz."},{"id":"semetey-2-2013:p1210:b004:l030","ordinal":279856,"en":"Kanchoro’s steel bullet"},{"id":"semetey-2-2013:p1210:b004:l031","ordinal":279857,"en":"Struck Sary Khan in the forehead;"},{"id":"semetey-2-2013:p1210:b004:l032","ordinal":279858,"en":"The bullet of death fastened upon him."},{"id":"semetey-2-2013:p1210:b004:l033","ordinal":279859,"en":"His white beard, like mountain wormwood,"},{"id":"semetey-2-2013:p1210:b004:l034","ordinal":279860,"en":"Spread across his chest;"},{"id":"semetey-2-2013:p1210:b004:l035","ordinal":279861,"en":"My mighty khan, Uncle Sary,"},{"id":"semetey-2-2013:p1210:b004:l036","ordinal":279862,"en":"Fell upon the pass with his head split open."},{"id":"semetey-2-2013:p1210:b004:l037","ordinal":279863,"en":"His blood gushed out,"},{"id":"semetey-2-2013:p1210:b004:l038","ordinal":279864,"en":"And from your uncle Khan Sary"},{"id":"semetey-2-2013:p1210:b004:l039","ordinal":279865,"en":"His life fled with a cry."},{"id":"semetey-2-2013:p1211:b003:l001","ordinal":279866,"en":"Sary Khan’s death,"},{"id":"semetey-2-2013:p1211:b003:l002","ordinal":279867,"en":"The unyielding underworld"},{"id":"semetey-2-2013:p1211:b003:l003","ordinal":279868,"en":"That noble man had seen."},{"id":"semetey-2-2013:p1211:b003:l004","ordinal":279869,"en":"Before they could strip off his armor,"},{"id":"semetey-2-2013:p1211:b003:l005","ordinal":279870,"en":"Before death could reach"},{"id":"semetey-2-2013:p1211:b003:l006","ordinal":279871,"en":"That hero Sary Khan,"},{"id":"semetey-2-2013:p1211:b003:l007","ordinal":279872,"en":"Külchoro, son of Almambet,"},{"id":"semetey-2-2013:p1211:b003:l008","ordinal":279873,"en":"Was overwhelmed by countless cares:"},{"id":"semetey-2-2013:p1211:b003:l009","ordinal":279874,"en":"Praying that his gray-wolf uncle would not die,"},{"id":"semetey-2-2013:p1211:b003:l010","ordinal":279875,"en":"His tears streamed in ten directions."},{"id":"semetey-2-2013:p1211:b003:l011","ordinal":279876,"en":"Oh, Sary Khan, my uncle,"},{"id":"semetey-2-2013:p1211:b003:l012","ordinal":279877,"en":"You were left dishonored on the ridge;"},{"id":"semetey-2-2013:p1211:b003:l013","ordinal":279878,"en":"Alas, uncle, avenge this!"},{"id":"semetey-2-2013:p1211:b003:l014","ordinal":279879,"en":"You were left dishonored in the hollow;"},{"id":"semetey-2-2013:p1211:b003:l015","ordinal":279880,"en":"Oh, my uncle, avenge this!"},{"id":"semetey-2-2013:p1211:b003:l016","ordinal":279881,"en":"Tugging at the matchlock,"},{"id":"semetey-2-2013:p1211:b003:l017","ordinal":279882,"en":"Saying, “My noble uncle has died,"},{"id":"semetey-2-2013:p1211:b003:l018","ordinal":279883,"en":"He suffered this disgrace"},{"id":"semetey-2-2013:p1211:b003:l019","ordinal":279884,"en":"At the hands of that infidel Kanchoro,”"},{"id":"semetey-2-2013:p1211:b003:l020","ordinal":279885,"en":"He wailed and wailed,"},{"id":"semetey-2-2013:p1211:b003:l021","ordinal":279886,"en":"Beating his own head,"},{"id":"semetey-2-2013:p1211:b003:l022","ordinal":279887,"en":"Sobbing and weeping bitterly,"},{"id":"semetey-2-2013:p1211:b003:l023","ordinal":279888,"en":"Crying, “My mighty uncle!”"},{"id":"semetey-2-2013:p1211:b003:l024","ordinal":279889,"en":"His ribs seemed torn apart,"},{"id":"semetey-2-2013:p1211:b003:l025","ordinal":279890,"en":"His whole heart burned,"},{"id":"semetey-2-2013:p1211:b003:l026","ordinal":279891,"en":"His fly-like soul nearly left him."},{"id":"semetey-2-2013:p1211:b003:l027","ordinal":279892,"en":"They were fortunate men and lions both,"},{"id":"semetey-2-2013:p1211:b003:l028","ordinal":279893,"en":"My two uncles, Sary Khan and Bakai,"},{"id":"semetey-2-2013:p1211:b003:l029","ordinal":279894,"en":"They were the banners raised in Talas."},{"id":"semetey-2-2013:p1211:b003:l030","ordinal":279895,"en":"Fallen at the banner’s foot,"},{"id":"semetey-2-2013:p1211:b003:l031","ordinal":279896,"en":"Today my uncle Sary Khan lies slain."},{"id":"semetey-2-2013:p1211:b003:l032","ordinal":279897,"en":"Before meeting the one he was destined to meet,"},{"id":"semetey-2-2013:p1211:b003:l033","ordinal":279898,"en":"My majestic khan and uncle,"},{"id":"semetey-2-2013:p1211:b003:l034","ordinal":279899,"en":"Was this how your fortune hardened?"},{"id":"semetey-2-2013:p1211:b003:l035","ordinal":279900,"en":"Before encountering the one you were to encounter,"},{"id":"semetey-2-2013:p1211:b003:l036","ordinal":279901,"en":"My fortunate kinsman, my khan and uncle,"},{"id":"semetey-2-2013:p1211:b003:l037","ordinal":279902,"en":"Was this how your road was barred?"},{"id":"semetey-2-2013:p1211:b003:l038","ordinal":279903,"en":"Like the broad gray flood"},{"id":"semetey-2-2013:p1211:b003:l039","ordinal":279904,"en":"At the confluence of Jeti-Too, my khan and uncle,"},{"id":"semetey-2-2013:p1211:b005:l001","ordinal":279905,"en":"Do you now lie embracing the earth?"},{"id":"semetey-2-2013:p1211:b005:l002","ordinal":279906,"en":"You were a pass no enemy could cross,"},{"id":"semetey-2-2013:p1211:b005:l003","ordinal":279907,"en":"A hero who stood immovable."},{"id":"semetey-2-2013:p1211:b005:l004","ordinal":279908,"en":"Though men surpass men and women bear sons,"},{"id":"semetey-2-2013:p1211:b005:l005","ordinal":279909,"en":"Uncle, another gray-wolf hero like you"},{"id":"semetey-2-2013:p1211:b005:l006","ordinal":279910,"en":"Will never come into this world.”"},{"id":"semetey-2-2013:p1211:b005:l007","ordinal":279911,"en":"Bracing himself on his right side,"},{"id":"semetey-2-2013:p1211:b005:l008","ordinal":279912,"en":"He wept, “My mighty uncle!”"},{"id":"semetey-2-2013:p1211:b005:l009","ordinal":279913,"en":"Bracing himself on his left side,"},{"id":"semetey-2-2013:p1211:b005:l010","ordinal":279914,"en":"He wept, “My sovereign uncle!”"},{"id":"semetey-2-2013:p1211:b005:l011","ordinal":279915,"en":"The world darkened beneath clouds;"},{"id":"semetey-2-2013:p1211:b005:l012","ordinal":279916,"en":"Over Külchoro’s head"},{"id":"semetey-2-2013:p1211:b005:l013","ordinal":279917,"en":"A darkened world descended."},{"id":"semetey-2-2013:p1211:b005:l014","ordinal":279918,"en":"When that noble hero grew wrathful,"},{"id":"semetey-2-2013:p1211:b005:l015","ordinal":279919,"en":"His brow fell and his heart broke."},{"id":"semetey-2-2013:p1211:b005:l016","ordinal":279920,"en":"Death comes one day out of seven—"},{"id":"semetey-2-2013:p1211:b005:l017","ordinal":279921,"en":"Damn this deceitful world!—"},{"id":"semetey-2-2013:p1211:b005:l018","ordinal":279922,"en":"And grief fell upon him."},{"id":"semetey-2-2013:p1211:b005:l019","ordinal":279923,"en":"Oh, Sary Khan, my uncle,"},{"id":"semetey-2-2013:p1211:b005:l020","ordinal":279924,"en":"Your white beard was like soft down,"},{"id":"semetey-2-2013:p1211:b005:l021","ordinal":279925,"en":"Your sturdy bones were like brass."},{"id":"semetey-2-2013:p1211:b005:l022","ordinal":279926,"en":"You were noble and lionhearted,"},{"id":"semetey-2-2013:p1211:b005:l023","ordinal":279927,"en":"My uncle, a hero born for battle."},{"id":"semetey-2-2013:p1211:b005:l024","ordinal":279928,"en":"“If you die in combat, Külchoro,"},{"id":"semetey-2-2013:p1211:b005:l025","ordinal":279929,"en":"My son will bury you,” you used to say."},{"id":"semetey-2-2013:p1211:b005:l026","ordinal":279930,"en":"Among horses, the steed Tuuchunak—"},{"id":"semetey-2-2013:p1211:b005:l027","ordinal":279931,"en":"I shall slaughter the horse Tuuchunak."},{"id":"semetey-2-2013:p1211:b005:l028","ordinal":279932,"en":"My khan, my uncle Sary Khan,"},{"id":"semetey-2-2013:p1211:b005:l029","ordinal":279933,"en":"I shall bury with my own hands."},{"id":"semetey-2-2013:p1211:b005:l030","ordinal":279934,"en":"As his blood drained, his strength departed,"},{"id":"semetey-2-2013:p1211:b005:l031","ordinal":279935,"en":"And his face had turned pale."},{"id":"semetey-2-2013:p1211:b005:l032","ordinal":279936,"en":"The renowned man of Kyrgyz and Kazakh,"},{"id":"semetey-2-2013:p1211:b005:l033","ordinal":279937,"en":"My uncle, had met his death."},{"id":"semetey-2-2013:p1211:b005:l034","ordinal":279938,"en":"If my uncle Sary remains unburied,"},{"id":"semetey-2-2013:p1211:b005:l035","ordinal":279939,"en":"His two round crimson cheeks"},{"id":"semetey-2-2013:p1211:b005:l036","ordinal":279940,"en":"Will be pecked away by blue vultures."},{"id":"semetey-2-2013:p1211:b005:l037","ordinal":279941,"en":"My dear uncle Sary Khan"},{"id":"semetey-2-2013:p1211:b005:l038","ordinal":279942,"en":"Will become carrion for beasts."},{"id":"semetey-2-2013:p1211:b005:l039","ordinal":279943,"en":"Flapping as they peck at his belly,"},{"id":"semetey-2-2013:p1212:b003:l001","ordinal":279944,"en":"The bald black vultures will fly over him."},{"id":"semetey-2-2013:p1212:b003:l002","ordinal":279945,"en":"Crushing his sturdy bones,"},{"id":"semetey-2-2013:p1212:b003:l003","ordinal":279946,"en":"Wolves will tear the gray wolf apart."},{"id":"semetey-2-2013:p1212:b003:l004","ordinal":279947,"en":"Sniffing his blood and gore and whining,"},{"id":"semetey-2-2013:p1212:b003:l005","ordinal":279948,"en":"Accursed foxes will defile him."},{"id":"semetey-2-2013:p1212:b003:l006","ordinal":279949,"en":"Summoning the beasts of prey,"},{"id":"semetey-2-2013:p1212:b003:l007","ordinal":279950,"en":"Croaking ravens will fly above him.”"},{"id":"semetey-2-2013:p1212:b003:l008","ordinal":279951,"en":"Peerless in his swiftness,"},{"id":"semetey-2-2013:p1212:b003:l009","ordinal":279952,"en":"The valiant-born Külchoro cried:"},{"id":"semetey-2-2013:p1212:b003:l010","ordinal":279953,"en":"“My doomed uncle Sary Khan,"},{"id":"semetey-2-2013:p1212:b003:l011","ordinal":279954,"en":"Your face has faded pale!"},{"id":"semetey-2-2013:p1212:b003:l012","ordinal":279955,"en":"Death has taken the kinsman"},{"id":"semetey-2-2013:p1212:b003:l013","ordinal":279956,"en":"Who carved the meat and gave me honey."},{"id":"semetey-2-2013:p1212:b003:l014","ordinal":279957,"en":"Death came from the vile infidel,"},{"id":"semetey-2-2013:p1212:b003:l015","ordinal":279958,"en":"Unworthy of salt enough for a cooking pot."},{"id":"semetey-2-2013:p1212:b003:l016","ordinal":279959,"en":"May he never put forth shoots—"},{"id":"semetey-2-2013:p1212:b003:l017","ordinal":279960,"en":"Death came from that wretch."},{"id":"semetey-2-2013:p1212:b003:l018","ordinal":279961,"en":"Not from some distant stranger, but from kin;"},{"id":"semetey-2-2013:p1212:b003:l019","ordinal":279962,"en":"Death came from one close to us.”"},{"id":"semetey-2-2013:p1212:b003:l020","ordinal":279963,"en":"Saying this, Külchoro"},{"id":"semetey-2-2013:p1212:b003:l021","ordinal":279964,"en":"Grasped him at the waist and folded him."},{"id":"semetey-2-2013:p1212:b003:l022","ordinal":279965,"en":"Tuuchunak had been taken as spoil,"},{"id":"semetey-2-2013:p1212:b003:l023","ordinal":279966,"en":"So he loaded him upon some other beast."},{"id":"semetey-2-2013:p1212:b003:l024","ordinal":279967,"en":"Unable to cease circling him and weeping,"},{"id":"semetey-2-2013:p1212:b003:l025","ordinal":279968,"en":"Külchoro, son of Almambet,"},{"id":"semetey-2-2013:p1212:b003:l026","ordinal":279969,"en":"Could find no peace."},{"id":"semetey-2-2013:p1212:b003:l027","ordinal":279970,"en":"He sobbed, unable to die,"},{"id":"semetey-2-2013:p1212:b003:l028","ordinal":279971,"en":"Unable to take his own life."},{"id":"semetey-2-2013:p1212:b003:l029","ordinal":279972,"en":"The poor man had no kinsman beside him,"},{"id":"semetey-2-2013:p1212:b003:l030","ordinal":279973,"en":"No forest into which he could flee,"},{"id":"semetey-2-2013:p1212:b003:l031","ordinal":279974,"en":"No Nogai people loyal to him,"},{"id":"semetey-2-2013:p1212:b003:l032","ordinal":279975,"en":"No companion in his grievous trial,"},{"id":"semetey-2-2013:p1212:b003:l033","ordinal":279976,"en":"None of the blessed Kyrgyz there."},{"id":"semetey-2-2013:p1212:b003:l034","ordinal":279977,"en":"He paced about, restraining himself,"},{"id":"semetey-2-2013:p1212:b003:l035","ordinal":279978,"en":"Leaning upon"},{"id":"semetey-2-2013:p1212:b003:l036","ordinal":279979,"en":"His golden-bladed battle-axe."},{"id":"semetey-2-2013:p1212:b003:l037","ordinal":279980,"en":"Unable to find any peace,"},{"id":"semetey-2-2013:p1212:b003:l038","ordinal":279981,"en":"He stood bewildered."},{"id":"semetey-2-2013:p1212:b003:l039","ordinal":279982,"en":"Then mist arose from the ravines,"},{"id":"semetey-2-2013:p1212:b004:l001","ordinal":279983,"en":"And over the mountaintops"},{"id":"semetey-2-2013:p1212:b004:l002","ordinal":279984,"en":"Great clouds gathered."},{"id":"semetey-2-2013:p1212:b004:l003","ordinal":279985,"en":"Winds blew from every side,"},{"id":"semetey-2-2013:p1212:b004:l004","ordinal":279986,"en":"The grass trembled and stirred,"},{"id":"semetey-2-2013:p1212:b004:l005","ordinal":279987,"en":"Hail swept all the foothills,"},{"id":"semetey-2-2013:p1212:b004:l006","ordinal":279988,"en":"And from the sky a sixfold hailstorm"},{"id":"semetey-2-2013:p1212:b004:l007","ordinal":279989,"en":"Poured down in driving sheets."},{"id":"semetey-2-2013:p1212:b004:l008","ordinal":279990,"en":"Külchoro, his father’s only son,"},{"id":"semetey-2-2013:p1212:b004:l009","ordinal":279991,"en":"Stood muttering as the sky convulsed"},{"id":"semetey-2-2013:p1212:b004:l010","ordinal":279992,"en":"And the earth seemed to shift."},{"id":"semetey-2-2013:p1212:b004:l011","ordinal":279993,"en":"With no Argyn or Kyrgyz people there,"},{"id":"semetey-2-2013:p1212:b004:l012","ordinal":279994,"en":"The lionlike Choro"},{"id":"semetey-2-2013:p1212:b004:l013","ordinal":279995,"en":"Stood helpless."},{"id":"semetey-2-2013:p1212:b004:l014","ordinal":279996,"en":"Then, when the man looked toward the qibla,"},{"id":"semetey-2-2013:p1212:b004:l015","ordinal":279997,"en":"There among the horses was Bozaiman,"},{"id":"semetey-2-2013:p1212:b004:l016","ordinal":279998,"en":"A creature wiser than other beasts."},{"id":"semetey-2-2013:p1212:b004:l017","ordinal":279999,"en":"Heaving deep sighs and drawing in his breath,"},{"id":"semetey-2-2013:p1212:b004:l018","ordinal":280000,"en":"He broke away from the herd,"},{"id":"semetey-2-2013:p1212:b004:l019","ordinal":280001,"en":"And from among the horses"},{"id":"semetey-2-2013:p1212:b004:l020","ordinal":280002,"en":"The creature came galloping up."},{"id":"semetey-2-2013:p1212:b004:l021","ordinal":280003,"en":"He appeared before Külchoro,"},{"id":"semetey-2-2013:p1212:b004:l022","ordinal":280004,"en":"His tail and mane streaming apart,"},{"id":"semetey-2-2013:p1212:b004:l023","ordinal":280005,"en":"Flicking his ears playfully,"},{"id":"semetey-2-2013:p1212:b004:l024","ordinal":280006,"en":"Pounding and scattering the earth,"},{"id":"semetey-2-2013:p1212:b004:l025","ordinal":280007,"en":"Twisting his neck like a wild ass,"},{"id":"semetey-2-2013:p1212:b004:l026","ordinal":280008,"en":"Neighing and pawing the ground,"},{"id":"semetey-2-2013:p1212:b004:l027","ordinal":280009,"en":"Striking and battering the earth,"},{"id":"semetey-2-2013:p1212:b004:l028","ordinal":280010,"en":"His tail and mane flowing."},{"id":"semetey-2-2013:p1212:b004:l029","ordinal":280011,"en":"In that sacred creature"},{"id":"semetey-2-2013:p1212:b004:l030","ordinal":280012,"en":"He plainly beheld"},{"id":"semetey-2-2013:p1212:b004:l031","ordinal":280013,"en":"Kambar-Ata, patron of horses."},{"id":"semetey-2-2013:p1212:b004:l032","ordinal":280014,"en":"When he saw Bozaiman,"},{"id":"semetey-2-2013:p1212:b004:l033","ordinal":280015,"en":"His heart broke once more."},{"id":"semetey-2-2013:p1212:b004:l034","ordinal":280016,"en":"In the loudly neighing Bozaiman"},{"id":"semetey-2-2013:p1212:b004:l035","ordinal":280017,"en":"He seemed to see his forefather Manas."},{"id":"semetey-2-2013:p1212:b004:l036","ordinal":280018,"en":"Neighing and whinnying,"},{"id":"semetey-2-2013:p1212:b004:l037","ordinal":280019,"en":"The stallion lowered his head to the ground,"},{"id":"semetey-2-2013:p1212:b004:l038","ordinal":280020,"en":"And circled around"},{"id":"semetey-2-2013:p1212:b004:l039","ordinal":280021,"en":"Your honored Sary Khan."},{"id":"semetey-2-2013:p1213:b003:l001","ordinal":280022,"en":"When the stallion behaved this way—"},{"id":"semetey-2-2013:p1213:b003:l002","ordinal":280023,"en":"We do not know the truth of it;"},{"id":"semetey-2-2013:p1213:b003:l003","ordinal":280024,"en":"Much is false and much is true,"},{"id":"semetey-2-2013:p1213:b003:l004","ordinal":280025,"en":"For no one who saw it has returned."},{"id":"semetey-2-2013:p1213:b003:l005","ordinal":280026,"en":"We made it a tale for diversion,"},{"id":"semetey-2-2013:p1213:b003:l006","ordinal":280027,"en":"To recount the deeds"},{"id":"semetey-2-2013:p1213:b003:l007","ordinal":280028,"en":"Of heroes long vanished."},{"id":"semetey-2-2013:p1213:b003:l008","ordinal":280029,"en":"Half is invention and half is truth;"},{"id":"semetey-2-2013:p1213:b003:l009","ordinal":280030,"en":"No soul has come back from beyond—"},{"id":"semetey-2-2013:p1213:b003:l010","ordinal":280031,"en":"Only the Creator Himself knows."},{"id":"semetey-2-2013:p1213:b003:l011","ordinal":280032,"en":"At that moment Bozaiman stood,"},{"id":"semetey-2-2013:p1213:b003:l012","ordinal":280033,"en":"His tail and mane streaming apart."},{"id":"semetey-2-2013:p1213:b003:l013","ordinal":280034,"en":"He had no tongue with which to speak,"},{"id":"semetey-2-2013:p1213:b003:l014","ordinal":280035,"en":"So the creature neighed,"},{"id":"semetey-2-2013:p1213:b003:l015","ordinal":280036,"en":"And tears poured from his eyes."},{"id":"semetey-2-2013:p1213:b003:l016","ordinal":280037,"en":"When they settled in broad Talas"},{"id":"semetey-2-2013:p1213:b003:l017","ordinal":280038,"en":"And livestock filled the valley,"},{"id":"semetey-2-2013:p1213:b003:l018","ordinal":280039,"en":"Wise Sary Khan"},{"id":"semetey-2-2013:p1213:b003:l019","ordinal":280040,"en":"Was out ranging with his herds."},{"id":"semetey-2-2013:p1213:b003:l020","ordinal":280041,"en":"Aimanboz, then an eight-year-old,"},{"id":"semetey-2-2013:p1213:b003:l021","ordinal":280042,"en":"When dawn shone clear"},{"id":"semetey-2-2013:p1213:b003:l022","ordinal":280043,"en":"And light touched the earth,"},{"id":"semetey-2-2013:p1213:b003:l023","ordinal":280044,"en":"Appeared to him from the unseen."},{"id":"semetey-2-2013:p1213:b003:l024","ordinal":280045,"en":"When he reached eight years of age,"},{"id":"semetey-2-2013:p1213:b003:l025","ordinal":280046,"en":"Sary Khan found him,"},{"id":"semetey-2-2013:p1213:b003:l026","ordinal":280047,"en":"Tied a plume upon his head,"},{"id":"semetey-2-2013:p1213:b003:l027","ordinal":280048,"en":"And kept him as a breeding stallion."},{"id":"semetey-2-2013:p1213:b003:l028","ordinal":280049,"en":"Mares covered by that stallion foaled,"},{"id":"semetey-2-2013:p1213:b003:l029","ordinal":280050,"en":"And from Bozaiman himself"},{"id":"semetey-2-2013:p1213:b003:l030","ordinal":280051,"en":"Came dark bay noble steeds,"},{"id":"semetey-2-2013:p1213:b003:l031","ordinal":280052,"en":"With broad lungs and brazen legs,"},{"id":"semetey-2-2013:p1213:b003:l032","ordinal":280053,"en":"Horses fit to ride into battle."},{"id":"semetey-2-2013:p1213:b003:l033","ordinal":280054,"en":"His tail was an armful, and full was his mane—"},{"id":"semetey-2-2013:p1213:b003:l034","ordinal":280055,"en":"Such was the creature, if you measured him."},{"id":"semetey-2-2013:p1213:b003:l035","ordinal":280056,"en":"When they saw the gray stallion,"},{"id":"semetey-2-2013:p1213:b003:l036","ordinal":280057,"en":"The birches wept and the willows wept,"},{"id":"semetey-2-2013:p1213:b003:l037","ordinal":280058,"en":"Every living witness wept,"},{"id":"semetey-2-2013:p1213:b003:l038","ordinal":280059,"en":"The earth shook and the grass wept,"},{"id":"semetey-2-2013:p1213:b003:l039","ordinal":280060,"en":"And poor Külchoro wept without end."},{"id":"semetey-2-2013:p1213:b004:l001","ordinal":280061,"en":"His uncle Sary Khan,"},{"id":"semetey-2-2013:p1213:b004:l002","ordinal":280062,"en":"His elder dearer than a father,"},{"id":"semetey-2-2013:p1213:b004:l003","ordinal":280063,"en":"Had died while fighting,"},{"id":"semetey-2-2013:p1213:b004:l004","ordinal":280064,"en":"Suffering death at the madman’s hands."}]
