[{"id":"semetey-1-2013:p1118:b004:l022","ordinal":161537,"en":"Before much time had passed,"},{"id":"semetey-1-2013:p1118:b004:l023","ordinal":161538,"en":"Before one could say this or that,"},{"id":"semetey-1-2013:p1118:b004:l024","ordinal":161539,"en":"In the blink of an eye,"},{"id":"semetey-1-2013:p1118:b004:l025","ordinal":161540,"en":"The Muslim people parted,"},{"id":"semetey-1-2013:p1118:b004:l026","ordinal":161541,"en":"Splitting straight down the center."},{"id":"semetey-1-2013:p1118:b004:l027","ordinal":161542,"en":"If you had seen Orokkyr,"},{"id":"semetey-1-2013:p1118:b004:l028","ordinal":161543,"en":"He came prepared into their midst."},{"id":"semetey-1-2013:p1118:b004:l029","ordinal":161544,"en":"A thousand wrestlers serving the feast"},{"id":"semetey-1-2013:p1118:b004:l030","ordinal":161545,"en":"Surrounded him and took his horse."},{"id":"semetey-1-2013:p1118:b004:l031","ordinal":161546,"en":"The wrestlers took his horse;"},{"id":"semetey-1-2013:p1118:b004:l032","ordinal":161547,"en":"Swelling with pride among the people,"},{"id":"semetey-1-2013:p1118:b004:l033","ordinal":161548,"en":"Orokkyr dismounted."},{"id":"semetey-1-2013:p1118:b004:l034","ordinal":161549,"en":"From Kökötöy's great store of gold,"},{"id":"semetey-1-2013:p1118:b004:l035","ordinal":161550,"en":"For a hero such as Orokkyr,"},{"id":"semetey-1-2013:p1118:b004:l036","ordinal":161551,"en":"Kökötöy's son Bokmurun"},{"id":"semetey-1-2013:p1118:b004:l037","ordinal":161552,"en":"Presented him a gift."},{"id":"semetey-1-2013:p1118:b004:l038","ordinal":161553,"en":"Orokkyr accepted his gift"},{"id":"semetey-1-2013:p1118:b004:l039","ordinal":161554,"en":"And was pleased."},{"id":"semetey-1-2013:p1119:b003:l001","ordinal":161555,"en":"They say he gave seven thousand—a thousand yearling mares—"},{"id":"semetey-1-2013:p1119:b003:l002","ordinal":161556,"en":"For slaughter."},{"id":"semetey-1-2013:p1119:b003:l003","ordinal":161557,"en":"They say he gave lumps of sugar large as lying camels and cows"},{"id":"semetey-1-2013:p1119:b003:l004","ordinal":161558,"en":"For them to crack apart."},{"id":"semetey-1-2013:p1119:b003:l005","ordinal":161559,"en":"They say he gave the wood of seven thousand camels"},{"id":"semetey-1-2013:p1119:b003:l006","ordinal":161560,"en":"For them to burn."},{"id":"semetey-1-2013:p1119:b003:l007","ordinal":161561,"en":"Saying it was Kökötöy's feast,"},{"id":"semetey-1-2013:p1119:b003:l008","ordinal":161562,"en":"If you had seen the Shibee people,"},{"id":"semetey-1-2013:p1119:b003:l009","ordinal":161563,"en":"Saying it was a feast for the great gathering,"},{"id":"semetey-1-2013:p1119:b003:l010","ordinal":161564,"en":"They say they camped against the foothills."},{"id":"semetey-1-2013:p1119:b003:l011","ordinal":161565,"en":"There was yet another spectacle:"},{"id":"semetey-1-2013:p1119:b003:l012","ordinal":161566,"en":"A famed champion who came from Beijing,"},{"id":"semetey-1-2013:p1119:b003:l013","ordinal":161567,"en":"Whose form differed from mortal men,"},{"id":"semetey-1-2013:p1119:b003:l014","ordinal":161568,"en":"The renowned Kalcha lion."},{"id":"semetey-1-2013:p1119:b003:l015","ordinal":161569,"en":"With a cotton sash and broad boots,"},{"id":"semetey-1-2013:p1119:b003:l016","ordinal":161570,"en":"Kongurbay, khan of the monks,"},{"id":"semetey-1-2013:p1119:b003:l017","ordinal":161571,"en":"Moved like a dragon;"},{"id":"semetey-1-2013:p1119:b003:l018","ordinal":161572,"en":"Sixty nobles were his younger brothers."},{"id":"semetey-1-2013:p1119:b003:l019","ordinal":161573,"en":"Of all who came from Beijing of Kakan-Chyn,"},{"id":"semetey-1-2013:p1119:b003:l020","ordinal":161574,"en":"Who among them surpassed the Kalcha?"},{"id":"semetey-1-2013:p1119:b003:l021","ordinal":161575,"en":"Six thousand Chinese and countless kalday"},{"id":"semetey-1-2013:p1119:b003:l022","ordinal":161576,"en":"Were among the great khans of Beijing."},{"id":"semetey-1-2013:p1119:b003:l023","ordinal":161577,"en":"Their renowned khan Kongurbay,"},{"id":"semetey-1-2013:p1119:b003:l024","ordinal":161578,"en":"A servant more skillful than an intriguer,"},{"id":"semetey-1-2013:p1119:b003:l025","ordinal":161579,"en":"Who openly knew the enemy's stratagems,"},{"id":"semetey-1-2013:p1119:b003:l026","ordinal":161580,"en":"Was a mighty servant."},{"id":"semetey-1-2013:p1119:b003:l027","ordinal":161581,"en":"Do not ask of Kongurbay's station:"},{"id":"semetey-1-2013:p1119:b003:l028","ordinal":161582,"en":"Upon his head was his attire,"},{"id":"semetey-1-2013:p1119:b003:l029","ordinal":161583,"en":"Coral plumes and pearl stones,"},{"id":"semetey-1-2013:p1119:b003:l030","ordinal":161584,"en":"And among his company mingled the khan of the Zungars."},{"id":"semetey-1-2013:p1119:b003:l031","ordinal":161585,"en":"His guard spread grandly;"},{"id":"semetey-1-2013:p1119:b003:l032","ordinal":161586,"en":"A thousand souls came in his host."},{"id":"semetey-1-2013:p1119:b003:l033","ordinal":161587,"en":"Wearing their mail,"},{"id":"semetey-1-2013:p1119:b003:l034","ordinal":161588,"en":"How many heroes came?"},{"id":"semetey-1-2013:p1119:b003:l035","ordinal":161589,"en":"Among them,"},{"id":"semetey-1-2013:p1119:b003:l036","ordinal":161590,"en":"The renowned one was Kongurbay,"},{"id":"semetey-1-2013:p1119:b003:l037","ordinal":161591,"en":"Kongurbay, a khan known to the people."},{"id":"semetey-1-2013:p1119:b003:l038","ordinal":161592,"en":"Upon his coral headdress,"},{"id":"semetey-1-2013:p1119:b003:l039","ordinal":161593,"en":"A parrot's tail"},{"id":"semetey-1-2013:p1119:b004:l001","ordinal":161594,"en":"Was adorned in ninety ways."},{"id":"semetey-1-2013:p1119:b004:l002","ordinal":161595,"en":"He made the racehorse Algara buck,"},{"id":"semetey-1-2013:p1119:b004:l003","ordinal":161596,"en":"Made its golden reins jerk."},{"id":"semetey-1-2013:p1119:b004:l004","ordinal":161597,"en":"Kongurbay, son of Alööke,"},{"id":"semetey-1-2013:p1119:b004:l005","ordinal":161598,"en":"Was a famed man born full of cunning."},{"id":"semetey-1-2013:p1119:b004:l006","ordinal":161599,"en":"A war banner floated in his hand;"},{"id":"semetey-1-2013:p1119:b004:l007","ordinal":161600,"en":"All manner of gear that could cut stone"},{"id":"semetey-1-2013:p1119:b004:l008","ordinal":161601,"en":"Flashed upon his wrist."},{"id":"semetey-1-2013:p1119:b004:l009","ordinal":161602,"en":"Dust rose from his passage,"},{"id":"semetey-1-2013:p1119:b004:l010","ordinal":161603,"en":"And souls fled at his sound."},{"id":"semetey-1-2013:p1119:b004:l011","ordinal":161604,"en":"Have you heard the tale"},{"id":"semetey-1-2013:p1119:b004:l012","ordinal":161605,"en":"Of glory rising from the hearth?"},{"id":"semetey-1-2013:p1119:b004:l013","ordinal":161606,"en":"From the entire Chinese people,"},{"id":"semetey-1-2013:p1119:b004:l014","ordinal":161607,"en":"A mighty one named Kongurbay arose."},{"id":"semetey-1-2013:p1119:b004:l015","ordinal":161608,"en":"His human form was dreadful to behold;"},{"id":"semetey-1-2013:p1119:b004:l016","ordinal":161609,"en":"Among Alööke's Kalcha people,"},{"id":"semetey-1-2013:p1119:b004:l017","ordinal":161610,"en":"No mortal dared face him."},{"id":"semetey-1-2013:p1119:b004:l018","ordinal":161611,"en":"Beneath him was the racehorse Algara,"},{"id":"semetey-1-2013:p1119:b004:l019","ordinal":161612,"en":"A creature surpassing other beasts."},{"id":"semetey-1-2013:p1119:b004:l020","ordinal":161613,"en":"If we aroused his wrath,"},{"id":"semetey-1-2013:p1119:b004:l021","ordinal":161614,"en":"Kongurbay, son of Alööke,"},{"id":"semetey-1-2013:p1119:b004:l022","ordinal":161615,"en":"Had the strength to slaughter alone"},{"id":"semetey-1-2013:p1119:b004:l023","ordinal":161616,"en":"All the Muslims gathered here."},{"id":"semetey-1-2013:p1119:b004:l024","ordinal":161617,"en":"The nobles beside him"},{"id":"semetey-1-2013:p1119:b004:l025","ordinal":161618,"en":"Separated into distinct groups;"},{"id":"semetey-1-2013:p1119:b004:l026","ordinal":161619,"en":"Looking at a single noble,"},{"id":"semetey-1-2013:p1119:b004:l027","ordinal":161620,"en":"He seemed like a thousand men."},{"id":"semetey-1-2013:p1119:b004:l028","ordinal":161621,"en":"The gathered people who saw them"},{"id":"semetey-1-2013:p1119:b004:l029","ordinal":161622,"en":"Felt their spirits badly shaken."},{"id":"semetey-1-2013:p1119:b004:l030","ordinal":161623,"en":"Champions of myriad forms"},{"id":"semetey-1-2013:p1119:b004:l031","ordinal":161624,"en":"Streamed behind him."},{"id":"semetey-1-2013:p1119:b004:l032","ordinal":161625,"en":"Forty princes who served"},{"id":"semetey-1-2013:p1119:b004:l033","ordinal":161626,"en":"As Kongurbay's attendants"},{"id":"semetey-1-2013:p1119:b004:l034","ordinal":161627,"en":"Had come together with him."},{"id":"semetey-1-2013:p1119:b004:l035","ordinal":161628,"en":"Koshoy, Töshtük, and the seasoned giants"},{"id":"semetey-1-2013:p1119:b004:l036","ordinal":161629,"en":"Were left utterly astonished."},{"id":"semetey-1-2013:p1119:b004:l037","ordinal":161630,"en":"Kongurbay, son of Alööke,"},{"id":"semetey-1-2013:p1119:b004:l038","ordinal":161631,"en":"Had immeasurable prowess;"},{"id":"semetey-1-2013:p1119:b004:l039","ordinal":161632,"en":"He was the finest champion of them all."},{"id":"semetey-1-2013:p1120:b003:l001","ordinal":161633,"en":"How many souls bore"},{"id":"semetey-1-2013:p1120:b003:l002","ordinal":161634,"en":"Broad-strung bows and secret arrows?"},{"id":"semetey-1-2013:p1120:b003:l003","ordinal":161635,"en":"If he found fault with the Kyrgyz,"},{"id":"semetey-1-2013:p1120:b003:l004","ordinal":161636,"en":"He would start a quarrel."},{"id":"semetey-1-2013:p1120:b003:l005","ordinal":161637,"en":"Seeing the appearance of these people,"},{"id":"semetey-1-2013:p1120:b003:l006","ordinal":161638,"en":"One would say they had come together to finish them utterly."},{"id":"semetey-1-2013:p1120:b003:l007","ordinal":161639,"en":"Look at Kongurbay, look at the mountain;"},{"id":"semetey-1-2013:p1120:b003:l008","ordinal":161640,"en":"We shuddered at the sight of his vanguard."},{"id":"semetey-1-2013:p1120:b003:l009","ordinal":161641,"en":"Look at the enemy who would fight!"},{"id":"semetey-1-2013:p1120:b003:l010","ordinal":161642,"en":"With Koshoy and Töshtük at their head,"},{"id":"semetey-1-2013:p1120:b003:l011","ordinal":161643,"en":"When they saw Kongurbay,"},{"id":"semetey-1-2013:p1120:b003:l012","ordinal":161644,"en":"They stood as though split in two."},{"id":"semetey-1-2013:p1120:b003:l013","ordinal":161645,"en":"When Kongurbay went to the feast,"},{"id":"semetey-1-2013:p1120:b003:l014","ordinal":161646,"en":"His drums were unlike any others."},{"id":"semetey-1-2013:p1120:b003:l015","ordinal":161647,"en":"Kongurbay, son of Alööke,"},{"id":"semetey-1-2013:p1120:b003:l016","ordinal":161648,"en":"Had horns and trumpets sounded."},{"id":"semetey-1-2013:p1120:b003:l017","ordinal":161649,"en":"If you saw how great his figure was,"},{"id":"semetey-1-2013:p1120:b003:l018","ordinal":161650,"en":"He loaded his baggage upon rhinoceroses;"},{"id":"semetey-1-2013:p1120:b003:l019","ordinal":161651,"en":"The souls who came were of another kind."},{"id":"semetey-1-2013:p1120:b003:l020","ordinal":161652,"en":"His champions were of every sort;"},{"id":"semetey-1-2013:p1120:b003:l021","ordinal":161653,"en":"If Kongurbay gave the order"},{"id":"semetey-1-2013:p1120:b003:l022","ordinal":161654,"en":"And his champion unexpectedly attacked,"},{"id":"semetey-1-2013:p1120:b003:l023","ordinal":161655,"en":"A man's shoulder blade would come out."},{"id":"semetey-1-2013:p1120:b003:l024","ordinal":161656,"en":"The Chinese called this dyngshoo;"},{"id":"semetey-1-2013:p1120:b003:l025","ordinal":161657,"en":"Kongurbay was such a hero"},{"id":"semetey-1-2013:p1120:b003:l026","ordinal":161658,"en":"That he made his warriors act as one."},{"id":"semetey-1-2013:p1120:b003:l027","ordinal":161659,"en":"Kongurbay, son of Alööke,"},{"id":"semetey-1-2013:p1120:b003:l028","ordinal":161660,"en":"Had reached the time"},{"id":"semetey-1-2013:p1120:b003:l029","ordinal":161661,"en":"When his rib bones bulged,"},{"id":"semetey-1-2013:p1120:b003:l030","ordinal":161662,"en":"His right shoulder rose high,"},{"id":"semetey-1-2013:p1120:b003:l031","ordinal":161663,"en":"And the earth bent when he walked."},{"id":"semetey-1-2013:p1120:b003:l032","ordinal":161664,"en":"He had reached such a time."},{"id":"semetey-1-2013:p1120:b003:l033","ordinal":161665,"en":"His courage was full, his heart stone;"},{"id":"semetey-1-2013:p1120:b003:l034","ordinal":161666,"en":"Do not ask of Kongurbay's station."},{"id":"semetey-1-2013:p1120:b003:l035","ordinal":161667,"en":"If his wrath fell upon the Kyrgyz,"},{"id":"semetey-1-2013:p1120:b003:l036","ordinal":161668,"en":"He would bring great turmoil on this road."},{"id":"semetey-1-2013:p1120:b003:l037","ordinal":161669,"en":"Vowing to gird his waist firmly,"},{"id":"semetey-1-2013:p1120:b003:l038","ordinal":161670,"en":"He had come prepared from Beijing;"},{"id":"semetey-1-2013:p1120:b003:l039","ordinal":161671,"en":"If he met renowned Manas,"},{"id":"semetey-1-2013:p1120:b004:l001","ordinal":161672,"en":"He would pursue Alööke's blood-price."},{"id":"semetey-1-2013:p1120:b004:l002","ordinal":161673,"en":"He donned an arrow-proof coat,"},{"id":"semetey-1-2013:p1120:b004:l003","ordinal":161674,"en":"Thinking his plans and words,"},{"id":"semetey-1-2013:p1120:b004:l004","ordinal":161675,"en":"Thinking the bloodthirsty Manas, that Burut,"},{"id":"semetey-1-2013:p1120:b004:l005","ordinal":161676,"en":"Would come to the feast."},{"id":"semetey-1-2013:p1120:b004:l006","ordinal":161677,"en":"Thus Kongurbay had come,"},{"id":"semetey-1-2013:p1120:b004:l007","ordinal":161678,"en":"Planning to overrun the feast,"},{"id":"semetey-1-2013:p1120:b004:l008","ordinal":161679,"en":"To fight amid the feast"},{"id":"semetey-1-2013:p1120:b004:l009","ordinal":161680,"en":"And spill human blood."},{"id":"semetey-1-2013:p1120:b004:l010","ordinal":161681,"en":"Kongurbay was bloodthirsty;"},{"id":"semetey-1-2013:p1120:b004:l011","ordinal":161682,"en":"He would be filled"},{"id":"semetey-1-2013:p1120:b004:l012","ordinal":161683,"en":"By eating a whole pig at once,"},{"id":"semetey-1-2013:p1120:b004:l013","ordinal":161684,"en":"And, receiving an order from his khan,"},{"id":"semetey-1-2013:p1120:b004:l014","ordinal":161685,"en":"Would slaughter whoever attacked."},{"id":"semetey-1-2013:p1120:b004:l015","ordinal":161686,"en":"In prowess he had brought"},{"id":"semetey-1-2013:p1120:b004:l016","ordinal":161687,"en":"Horse acrobats and runners on foot,"},{"id":"semetey-1-2013:p1120:b004:l017","ordinal":161688,"en":"And marksmen who never missed"},{"id":"semetey-1-2013:p1120:b004:l018","ordinal":161689,"en":"In the darkness of the moon."},{"id":"semetey-1-2013:p1120:b004:l019","ordinal":161690,"en":"From marksmen such as these,"},{"id":"semetey-1-2013:p1120:b004:l020","ordinal":161691,"en":"He chose one from every thousand;"},{"id":"semetey-1-2013:p1120:b004:l021","ordinal":161692,"en":"Of champions such as these,"},{"id":"semetey-1-2013:p1120:b004:l022","ordinal":161693,"en":"He brought exactly twelve thousand."},{"id":"semetey-1-2013:p1120:b004:l023","ordinal":161694,"en":"Beyond them"},{"id":"semetey-1-2013:p1120:b004:l024","ordinal":161695,"en":"Were the Kanjarkol champions;"},{"id":"semetey-1-2013:p1120:b004:l025","ordinal":161696,"en":"The shoulder blades of attacking enemies"},{"id":"semetey-1-2013:p1120:b004:l026","ordinal":161697,"en":"Would unfailingly come out."},{"id":"semetey-1-2013:p1120:b004:l027","ordinal":161698,"en":"Your gray wolf, Khan Kongurbay,"},{"id":"semetey-1-2013:p1120:b004:l028","ordinal":161699,"en":"Said, \"What will the Burut do?\""},{"id":"semetey-1-2013:p1120:b004:l029","ordinal":161700,"en":"Of the Kanjarkol champions,"},{"id":"semetey-1-2013:p1120:b004:l030","ordinal":161701,"en":"He brought exactly ten thousand,"},{"id":"semetey-1-2013:p1120:b004:l031","ordinal":161702,"en":"Who descended fully prepared."},{"id":"semetey-1-2013:p1120:b004:l032","ordinal":161703,"en":"Beyond them came"},{"id":"semetey-1-2013:p1120:b004:l033","ordinal":161704,"en":"The most skillful bowmen,"},{"id":"semetey-1-2013:p1120:b004:l034","ordinal":161705,"en":"The most skillful lasso throwers,"},{"id":"semetey-1-2013:p1120:b004:l035","ordinal":161706,"en":"Who caught men and spared no soul;"},{"id":"semetey-1-2013:p1120:b004:l036","ordinal":161707,"en":"Mingled behind them came"},{"id":"semetey-1-2013:p1120:b004:l037","ordinal":161708,"en":"The finest wielders of battle-axes."},{"id":"semetey-1-2013:p1120:b004:l038","ordinal":161709,"en":"To Kökötöy's feast"},{"id":"semetey-1-2013:p1120:b004:l039","ordinal":161710,"en":"Came the Chinese people with their army."},{"id":"semetey-1-2013:p1121:b003:l001","ordinal":161711,"en":"Saying it was Kökötöy's feast,"},{"id":"semetey-1-2013:p1121:b003:l002","ordinal":161712,"en":"The place of the great gathering,"},{"id":"semetey-1-2013:p1121:b003:l003","ordinal":161713,"en":"The mighty Khan Kongurbay came;"},{"id":"semetey-1-2013:p1121:b003:l004","ordinal":161714,"en":"When his wrath seized him,"},{"id":"semetey-1-2013:p1121:b003:l005","ordinal":161715,"en":"He became a deep-dug pit."},{"id":"semetey-1-2013:p1121:b003:l006","ordinal":161716,"en":"Before Khan Kongurbay,"},{"id":"semetey-1-2013:p1121:b003:l007","ordinal":161717,"en":"Kökötöy's Bokmurun"},{"id":"semetey-1-2013:p1121:b003:l008","ordinal":161718,"en":"Now presented"},{"id":"semetey-1-2013:p1121:b003:l009","ordinal":161719,"en":"Sixty camel-loads of gold."},{"id":"semetey-1-2013:p1121:b003:l010","ordinal":161720,"en":"Giving many gifts of gold,"},{"id":"semetey-1-2013:p1121:b003:l011","ordinal":161721,"en":"Kökötöy's Bokmurun"},{"id":"semetey-1-2013:p1121:b003:l012","ordinal":161722,"en":"Barely pacified the Kalcha."},{"id":"semetey-1-2013:p1121:b003:l013","ordinal":161723,"en":"Eight thousand wethers and five thousand mares"},{"id":"semetey-1-2013:p1121:b003:l014","ordinal":161724,"en":"He gave for slaughter;"},{"id":"semetey-1-2013:p1121:b003:l015","ordinal":161725,"en":"The wood of eight thousand camels"},{"id":"semetey-1-2013:p1121:b003:l016","ordinal":161726,"en":"He gave for burning;"},{"id":"semetey-1-2013:p1121:b003:l017","ordinal":161727,"en":"Sugar large as a kneeling camel or cow"},{"id":"semetey-1-2013:p1121:b003:l018","ordinal":161728,"en":"He gave them to crack apart."},{"id":"semetey-1-2013:p1121:b003:l019","ordinal":161729,"en":"Thus he won the favor"},{"id":"semetey-1-2013:p1121:b003:l020","ordinal":161730,"en":"Of gray-wolf Khan Kongurbay,"},{"id":"semetey-1-2013:p1121:b003:l021","ordinal":161731,"en":"Gathered the whole army,"},{"id":"semetey-1-2013:p1121:b003:l022","ordinal":161732,"en":"And camped against the foothills."},{"id":"semetey-1-2013:p1121:b003:l023","ordinal":161733,"en":"There was yet another spectacle;"},{"id":"semetey-1-2013:p1121:b003:l024","ordinal":161734,"en":"Let us leave this here"},{"id":"semetey-1-2013:p1121:b003:l025","ordinal":161735,"en":"And begin with what came nearer."},{"id":"semetey-1-2013:p1121:b003:l026","ordinal":161736,"en":"Behind him,"},{"id":"semetey-1-2013:p1121:b003:l027","ordinal":161737,"en":"Dust wheeled into the sky;"},{"id":"semetey-1-2013:p1121:b003:l028","ordinal":161738,"en":"The heavens were clear but the earth was veiled,"},{"id":"semetey-1-2013:p1121:b003:l029","ordinal":161739,"en":"And haze parted from the sky."},{"id":"semetey-1-2013:p1121:b003:l030","ordinal":161740,"en":"Their multitude seemed like a flood."},{"id":"semetey-1-2013:p1121:b003:l031","ordinal":161741,"en":"With piercing cries and shrill cheering,"},{"id":"semetey-1-2013:p1121:b003:l032","ordinal":161742,"en":"When one looked carefully,"},{"id":"semetey-1-2013:p1121:b003:l033","ordinal":161743,"en":"Ezkara's army appeared."},{"id":"semetey-1-2013:p1121:b003:l034","ordinal":161744,"en":"Ezkara, khan of the Manchus—"},{"id":"semetey-1-2013:p1121:b003:l035","ordinal":161745,"en":"His multitude was like black worms;"},{"id":"semetey-1-2013:p1121:b003:l036","ordinal":161746,"en":"If he attacked, he brought much grief,"},{"id":"semetey-1-2013:p1121:b003:l037","ordinal":161747,"en":"For he himself was ill-starred, a calamity."},{"id":"semetey-1-2013:p1121:b003:l038","ordinal":161748,"en":"At that time, every mortal"},{"id":"semetey-1-2013:p1121:b003:l039","ordinal":161749,"en":"Who saw Ezkara was afraid."},{"id":"semetey-1-2013:p1121:b005:l001","ordinal":161750,"en":"Ill-fated Ezkara"},{"id":"semetey-1-2013:p1121:b005:l002","ordinal":161751,"en":"Had studied the wondrous arts."},{"id":"semetey-1-2013:p1121:b005:l003","ordinal":161752,"en":"His knowledge was considerable;"},{"id":"semetey-1-2013:p1121:b005:l004","ordinal":161753,"en":"His sorcery was of many kinds,"},{"id":"semetey-1-2013:p1121:b005:l005","ordinal":161754,"en":"A famed man who came from Beijing."},{"id":"semetey-1-2013:p1121:b005:l006","ordinal":161755,"en":"A peerless diviner and knowing servant,"},{"id":"semetey-1-2013:p1121:b005:l007","ordinal":161756,"en":"He knew Bakburchun beyond,"},{"id":"semetey-1-2013:p1121:b005:l008","ordinal":161757,"en":"Ulandy, Kengtung, and Düngshang."},{"id":"semetey-1-2013:p1121:b005:l009","ordinal":161758,"en":"Ezkara, having seen so much,"},{"id":"semetey-1-2013:p1121:b005:l010","ordinal":161759,"en":"Knew that people's number,"},{"id":"semetey-1-2013:p1121:b005:l011","ordinal":161760,"en":"And knew this people's temper."},{"id":"semetey-1-2013:p1121:b005:l012","ordinal":161761,"en":"He knew the might of that people;"},{"id":"semetey-1-2013:p1121:b005:l013","ordinal":161762,"en":"Of this people visibly gathered"},{"id":"semetey-1-2013:p1121:b005:l014","ordinal":161763,"en":"For Kökötöy's feast,"},{"id":"semetey-1-2013:p1121:b005:l015","ordinal":161764,"en":"He knew the small number."},{"id":"semetey-1-2013:p1121:b005:l016","ordinal":161765,"en":"Ezkara of the Manchus"},{"id":"semetey-1-2013:p1121:b005:l017","ordinal":161766,"en":"Was more skillful than any intriguer,"},{"id":"semetey-1-2013:p1121:b005:l018","ordinal":161767,"en":"The finest deviser of means"},{"id":"semetey-1-2013:p1121:b005:l019","ordinal":161768,"en":"Among black Chinese and Manchus."},{"id":"semetey-1-2013:p1121:b005:l020","ordinal":161769,"en":"He was the orator among the eloquent;"},{"id":"semetey-1-2013:p1121:b005:l021","ordinal":161770,"en":"Ezkara, whose desire was fixed,"},{"id":"semetey-1-2013:p1121:b005:l022","ordinal":161771,"en":"Was the champion of the many Chinese."},{"id":"semetey-1-2013:p1121:b005:l023","ordinal":161772,"en":"Straining and exerting himself,"},{"id":"semetey-1-2013:p1121:b005:l024","ordinal":161773,"en":"The renowned hero Ezkara"},{"id":"semetey-1-2013:p1121:b005:l025","ordinal":161774,"en":"Came straight toward this feast,"},{"id":"semetey-1-2013:p1121:b005:l026","ordinal":161775,"en":"Swaying as though shoved this way."},{"id":"semetey-1-2013:p1121:b005:l027","ordinal":161776,"en":"He had many contentious words:"},{"id":"semetey-1-2013:p1121:b005:l028","ordinal":161777,"en":"At the far edge of Altay,"},{"id":"semetey-1-2013:p1121:b005:l029","ordinal":161778,"en":"He had lost plunder worth a thousand camels,"},{"id":"semetey-1-2013:p1121:b005:l030","ordinal":161779,"en":"And had a thousand champions"},{"id":"semetey-1-2013:p1121:b005:l031","ordinal":161780,"en":"Slaughtered by Manas."},{"id":"semetey-1-2013:p1121:b005:l032","ordinal":161781,"en":"The pale blue star in the sky was eclipsed;"},{"id":"semetey-1-2013:p1121:b005:l033","ordinal":161782,"en":"He openly fled and escaped"},{"id":"semetey-1-2013:p1121:b005:l034","ordinal":161783,"en":"Before Esenkan."},{"id":"semetey-1-2013:p1121:b005:l035","ordinal":161784,"en":"When he came to Esenkan,"},{"id":"semetey-1-2013:p1121:b005:l036","ordinal":161785,"en":"He stamped the ground he trod"},{"id":"semetey-1-2013:p1121:b005:l037","ordinal":161786,"en":"And reviled Khan Manas:"},{"id":"semetey-1-2013:p1121:b005:l038","ordinal":161787,"en":"\"From the forty-household Kyrgyz in Altay,"},{"id":"semetey-1-2013:p1122:b003:l001","ordinal":161788,"en":"They say bloodthirsty Manas arose."},{"id":"semetey-1-2013:p1122:b003:l002","ordinal":161789,"en":"He crushed a thousand champions,"},{"id":"semetey-1-2013:p1122:b003:l003","ordinal":161790,"en":"Killed them and thrust them into the earth."},{"id":"semetey-1-2013:p1122:b003:l004","ordinal":161791,"en":"If you do not cut down his crookedness now,"},{"id":"semetey-1-2013:p1122:b003:l005","ordinal":161792,"en":"Destroy his forty households,"}]
