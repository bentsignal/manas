[{"id":"semetey-1-2013:p1186:b003:l002","ordinal":166657,"en":"Though I am young, I shall see;"},{"id":"semetey-1-2013:p1186:b003:l003","ordinal":166658,"en":"At worst, my poor soul,"},{"id":"semetey-1-2013:p1186:b003:l004","ordinal":166659,"en":"I will come behind three horses."},{"id":"semetey-1-2013:p1186:b003:l005","ordinal":166660,"en":"If only I had reached full age,"},{"id":"semetey-1-2013:p1186:b003:l006","ordinal":166661,"en":"I would lengthen my stride"},{"id":"semetey-1-2013:p1186:b003:l007","ordinal":166662,"en":"Against the tulpars racing now"},{"id":"semetey-1-2013:p1186:b003:l008","ordinal":166663,"en":"And perform every feat.\""},{"id":"semetey-1-2013:p1186:b003:l009","ordinal":166664,"en":"His owner stood and wept greatly,"},{"id":"semetey-1-2013:p1186:b003:l010","ordinal":166665,"en":"Consumed by grief as he wept."},{"id":"semetey-1-2013:p1186:b003:l011","ordinal":166666,"en":"\"I have raced a yearling among horses;"},{"id":"semetey-1-2013:p1186:b003:l012","ordinal":166667,"en":"God above, You alone know."},{"id":"semetey-1-2013:p1186:b003:l013","ordinal":166668,"en":"Unable to run strongly enough,"},{"id":"semetey-1-2013:p1186:b003:l014","ordinal":166669,"en":"What will Kulatay endure?"},{"id":"semetey-1-2013:p1186:b003:l015","ordinal":166670,"en":"Will Kulatay suffer hardship"},{"id":"semetey-1-2013:p1186:b003:l016","ordinal":166671,"en":"And die upon the steppe?"},{"id":"semetey-1-2013:p1186:b003:l017","ordinal":166672,"en":"Unable to move legs or body,"},{"id":"semetey-1-2013:p1186:b003:l018","ordinal":166673,"en":"Will Kulatay be taken?"},{"id":"semetey-1-2013:p1186:b003:l019","ordinal":166674,"en":"Will the stallion Kulatay"},{"id":"semetey-1-2013:p1186:b003:l020","ordinal":166675,"en":"Be left upon the steppe?"},{"id":"semetey-1-2013:p1186:b003:l021","ordinal":166676,"en":"While still a yearling,"},{"id":"semetey-1-2013:p1186:b003:l022","ordinal":166677,"en":"Will Kulatay meet disaster?"},{"id":"semetey-1-2013:p1186:b003:l023","ordinal":166678,"en":"If he can go no farther, that is ill fame."},{"id":"semetey-1-2013:p1186:b003:l024","ordinal":166679,"en":"God above, what can I do?"},{"id":"semetey-1-2013:p1186:b003:l025","ordinal":166680,"en":"I entrust him to You alone.\""},{"id":"semetey-1-2013:p1186:b003:l026","ordinal":166681,"en":"Before much time had passed,"},{"id":"semetey-1-2013:p1186:b003:l027","ordinal":166682,"en":"In the blink of an eye,"},{"id":"semetey-1-2013:p1186:b003:l028","ordinal":166683,"en":"Before one could turn about,"},{"id":"semetey-1-2013:p1186:b003:l029","ordinal":166684,"en":"A shout arose from the lowland;"},{"id":"semetey-1-2013:p1186:b003:l030","ordinal":166685,"en":"Everyone on the plain"},{"id":"semetey-1-2013:p1186:b003:l031","ordinal":166686,"en":"Cried, \"Drive out the horses!\""},{"id":"semetey-1-2013:p1186:b003:l032","ordinal":166687,"en":"A shout arose from the mountain;"},{"id":"semetey-1-2013:p1186:b003:l033","ordinal":166688,"en":"Everyone on the mountain,"},{"id":"semetey-1-2013:p1186:b003:l034","ordinal":166689,"en":"All pursuing without pause,"},{"id":"semetey-1-2013:p1186:b003:l035","ordinal":166690,"en":"Cried, \"Drive out the horses!\""},{"id":"semetey-1-2013:p1186:b003:l036","ordinal":166691,"en":"Foremost of the forty companions,"},{"id":"semetey-1-2013:p1186:b003:l037","ordinal":166692,"en":"Follower of falcon Manas,"},{"id":"semetey-1-2013:p1186:b003:l038","ordinal":166693,"en":"Saintly hero Bakay,"},{"id":"semetey-1-2013:p1186:b003:l039","ordinal":166694,"en":"Jelpinig, iron of the earth,"},{"id":"semetey-1-2013:p1186:b004:l001","ordinal":166695,"en":"Your gray-maned hero who knew perfectly,"},{"id":"semetey-1-2013:p1186:b004:l002","ordinal":166696,"en":"The four corners of the world—"},{"id":"semetey-1-2013:p1186:b004:l003","ordinal":166697,"en":"The saint who knew their origins."},{"id":"semetey-1-2013:p1186:b004:l004","ordinal":166698,"en":"Wore a blue lynx cap"},{"id":"semetey-1-2013:p1186:b004:l005","ordinal":166699,"en":"And wielded his mottled blue shield."},{"id":"semetey-1-2013:p1186:b004:l006","ordinal":166700,"en":"He chose that distant place"},{"id":"semetey-1-2013:p1186:b004:l007","ordinal":166701,"en":"As Akkula's starting point."},{"id":"semetey-1-2013:p1186:b004:l008","ordinal":166702,"en":"Beyond that, among the horses,"},{"id":"semetey-1-2013:p1186:b004:l009","ordinal":166703,"en":"No lingering regret remained."},{"id":"semetey-1-2013:p1186:b004:l010","ordinal":166704,"en":"He put armor upon him"},{"id":"semetey-1-2013:p1186:b004:l011","ordinal":166705,"en":"And mounted him on Maaniker."},{"id":"semetey-1-2013:p1186:b004:l012","ordinal":166706,"en":"Young Aydar of the flowing forelock"},{"id":"semetey-1-2013:p1186:b004:l013","ordinal":166707,"en":"Struck at the horses and drove them."},{"id":"semetey-1-2013:p1186:b004:l014","ordinal":166708,"en":"Beside young Aydar"},{"id":"semetey-1-2013:p1186:b004:l015","ordinal":166709,"en":"Were exactly two hundred champions."},{"id":"semetey-1-2013:p1186:b004:l016","ordinal":166710,"en":"Old leopard Bakay"},{"id":"semetey-1-2013:p1186:b004:l017","ordinal":166711,"en":"Shouted in anger,"},{"id":"semetey-1-2013:p1186:b004:l018","ordinal":166712,"en":"Calling to young Aydar:"},{"id":"semetey-1-2013:p1186:b004:l019","ordinal":166713,"en":"\"Hey, young Aydar, drive the horses;"},{"id":"semetey-1-2013:p1186:b004:l020","ordinal":166714,"en":"Drive all the horses swiftly."},{"id":"semetey-1-2013:p1186:b004:l021","ordinal":166715,"en":"If you drive on from here,"},{"id":"semetey-1-2013:p1186:b004:l022","ordinal":166716,"en":"Ridge after ridge will come,"},{"id":"semetey-1-2013:p1186:b004:l023","ordinal":166717,"en":"Rough foothills will come,"},{"id":"semetey-1-2013:p1186:b004:l024","ordinal":166718,"en":"And a shimmering desert will come."},{"id":"semetey-1-2013:p1186:b004:l025","ordinal":166719,"en":"Where a raven goes, its ears,"},{"id":"semetey-1-2013:p1186:b004:l026","ordinal":166720,"en":"Where a kulan goes, its hooves,"},{"id":"semetey-1-2013:p1186:b004:l027","ordinal":166721,"en":"Will be scorched by the ground."},{"id":"semetey-1-2013:p1186:b004:l028","ordinal":166722,"en":"As you continue driving them,"},{"id":"semetey-1-2013:p1186:b004:l029","ordinal":166723,"en":"Among saxaul wood and black sand,"},{"id":"semetey-1-2013:p1186:b004:l030","ordinal":166724,"en":"This is where you must release them:"},{"id":"semetey-1-2013:p1186:b004:l031","ordinal":166725,"en":"At that lower black ridge."},{"id":"semetey-1-2013:p1186:b004:l032","ordinal":166726,"en":"Foal of a bay mare,"},{"id":"semetey-1-2013:p1186:b004:l033","ordinal":166727,"en":"Tulpar of the black herd—"},{"id":"semetey-1-2013:p1186:b004:l034","ordinal":166728,"en":"When you release Akkula,"},{"id":"semetey-1-2013:p1186:b004:l035","ordinal":166729,"en":"That is Akkula's country.\""},{"id":"semetey-1-2013:p1186:b004:l036","ordinal":166730,"en":"Young Aydar of the flowing forelock—"},{"id":"semetey-1-2013:p1186:b004:l037","ordinal":166731,"en":"To young Aydar himself"},{"id":"semetey-1-2013:p1186:b004:l038","ordinal":166732,"en":"He taught what he did not know."},{"id":"semetey-1-2013:p1187:b003:l001","ordinal":166733,"en":"Thus setting them upon the road,"},{"id":"semetey-1-2013:p1187:b003:l002","ordinal":166734,"en":"The racehorses streamed out in splendor."},{"id":"semetey-1-2013:p1187:b003:l003","ordinal":166735,"en":"All the chosen tulpar steeds,"},{"id":"semetey-1-2013:p1187:b003:l004","ordinal":166736,"en":"While infidel and Muslim"},{"id":"semetey-1-2013:p1187:b003:l005","ordinal":166737,"en":"Stood clashing together,"},{"id":"semetey-1-2013:p1187:b003:l006","ordinal":166738,"en":"Young Aydar of the flowing forelock"},{"id":"semetey-1-2013:p1187:b003:l007","ordinal":166739,"en":"Went out and drove them."},{"id":"semetey-1-2013:p1187:b004:l001","ordinal":166740,"en":"Two hundred youths were beside him."},{"id":"semetey-1-2013:p1187:b004:l002","ordinal":166741,"en":"After young Aydar drove them away,"},{"id":"semetey-1-2013:p1187:b004:l003","ordinal":166742,"en":"After they reached the starting place,"},{"id":"semetey-1-2013:p1187:b004:l004","ordinal":166743,"en":"Let us leave that matter there"},{"id":"semetey-1-2013:p1187:b004:l005","ordinal":166744,"en":"And begin from this side:"},{"id":"semetey-1-2013:p1187:b004:l006","ordinal":166745,"en":"Kokotoy's Bokmurun"},{"id":"semetey-1-2013:p1187:b004:l007","ordinal":166746,"en":"Sent out another announcement."},{"id":"semetey-1-2013:p1187:b006:l001","ordinal":166747,"en":"Kokotoy's Bokmurun"},{"id":"semetey-1-2013:p1187:b006:l002","ordinal":166748,"en":"Proclaimed before the multitude:"},{"id":"semetey-1-2013:p1187:b006:l003","ordinal":166749,"en":"\"Sons of Adam have gathered;"},{"id":"semetey-1-2013:p1187:b006:l004","ordinal":166750,"en":"You old men have come."},{"id":"semetey-1-2013:p1187:b006:l005","ordinal":166751,"en":"All you heroes and noble champions"},{"id":"semetey-1-2013:p1187:b006:l006","ordinal":166752,"en":"Have come."},{"id":"semetey-1-2013:p1187:b006:l007","ordinal":166753,"en":"The leopard supported by the Shah,"},{"id":"semetey-1-2013:p1187:b006:l008","ordinal":166754,"en":"Your lion, has come."},{"id":"semetey-1-2013:p1187:b006:l009","ordinal":166755,"en":"The hero who knows well the enemy's devices"},{"id":"semetey-1-2013:p1187:b006:l010","ordinal":166756,"en":"Has come."},{"id":"semetey-1-2013:p1187:b006:l011","ordinal":166757,"en":"He who says, 'I trust in God above,'"},{"id":"semetey-1-2013:p1187:b006:l012","ordinal":166758,"en":"Has come."},{"id":"semetey-1-2013:p1187:b006:l013","ordinal":166759,"en":"The tireless noble champion,"},{"id":"semetey-1-2013:p1187:b006:l014","ordinal":166760,"en":"Your valiant man, has come."},{"id":"semetey-1-2013:p1187:b006:l015","ordinal":166761,"en":"This is the foremost of great gatherings;"},{"id":"semetey-1-2013:p1187:b006:l016","ordinal":166762,"en":"This is my khan father's memorial feast."},{"id":"semetey-1-2013:p1187:b006:l017","ordinal":166763,"en":"The horses must reach their ground;"},{"id":"semetey-1-2013:p1187:b006:l018","ordinal":166764,"en":"Until the horses return,"},{"id":"semetey-1-2013:p1187:b006:l019","ordinal":166765,"en":"Will the people not grow weary?"},{"id":"semetey-1-2013:p1187:b006:l020","ordinal":166766,"en":"I stake a camel with its load,"},{"id":"semetey-1-2013:p1187:b006:l021","ordinal":166767,"en":"And exactly sixty servants."},{"id":"semetey-1-2013:p1187:b006:l022","ordinal":166768,"en":"Let one champion come from the infidels"},{"id":"semetey-1-2013:p1187:b006:l023","ordinal":166769,"en":"And one champion from the Muslims."},{"id":"semetey-1-2013:p1187:b006:l024","ordinal":166770,"en":"Let their lances bend;"},{"id":"semetey-1-2013:p1187:b006:l025","ordinal":166771,"en":"Let the heroes come out and joust."},{"id":"semetey-1-2013:p1187:b006:l026","ordinal":166772,"en":"Let those whose death has come die,"},{"id":"semetey-1-2013:p1187:b006:l027","ordinal":166773,"en":"And spill a lion's blood."},{"id":"semetey-1-2013:p1187:b006:l028","ordinal":166774,"en":"Let them charge and pierce"},{"id":"semetey-1-2013:p1187:b008:l001","ordinal":166775,"en":"The ridge of the ribs;"},{"id":"semetey-1-2013:p1187:b008:l002","ordinal":166776,"en":"Let them make a spectacle for the people"},{"id":"semetey-1-2013:p1187:b008:l003","ordinal":166777,"en":"And fight lance against lance."},{"id":"semetey-1-2013:p1187:b008:l004","ordinal":166778,"en":"Let them come out to joust;"},{"id":"semetey-1-2013:p1187:b008:l005","ordinal":166779,"en":"Let the one who strikes win the prize,"},{"id":"semetey-1-2013:p1187:b008:l006","ordinal":166780,"en":"And the one struck remain empty-handed.\""},{"id":"semetey-1-2013:p1187:b008:l007","ordinal":166781,"en":"When Bokmurun said this,"},{"id":"semetey-1-2013:p1187:b008:l008","ordinal":166782,"en":"To gain much profit as plunder—"},{"id":"semetey-1-2013:p1187:b008:l009","ordinal":166783,"en":"That was when Kongurbay had failed."},{"id":"semetey-1-2013:p1187:b008:l010","ordinal":166784,"en":"Algara beneath him,"},{"id":"semetey-1-2013:p1187:b008:l011","ordinal":166785,"en":"The prancing black horse,"},{"id":"semetey-1-2013:p1187:b008:l012","ordinal":166786,"en":"He had not been able to race."},{"id":"semetey-1-2013:p1187:b008:l013","ordinal":166787,"en":"He was destined to joust with Manas"},{"id":"semetey-1-2013:p1187:b008:l014","ordinal":166788,"en":"And cause turmoil"},{"id":"semetey-1-2013:p1187:b008:l015","ordinal":166789,"en":"At Kokotoy's feast."},{"id":"semetey-1-2013:p1187:b008:l016","ordinal":166790,"en":"That Akkula would race—"},{"id":"semetey-1-2013:p1187:b008:l017","ordinal":166791,"en":"Kongurbay knew it."},{"id":"semetey-1-2013:p1187:b008:l018","ordinal":166792,"en":"\"May he lose Akkula"},{"id":"semetey-1-2013:p1187:b008:l019","ordinal":166793,"en":"And stand gawking on foot;"},{"id":"semetey-1-2013:p1187:b008:l020","ordinal":166794,"en":"May I take revenge for my father.\""},{"id":"semetey-1-2013:p1187:b008:l021","ordinal":166795,"en":"He had long desired this."},{"id":"semetey-1-2013:p1187:b008:l022","ordinal":166796,"en":"\"Before he can pull aside,"},{"id":"semetey-1-2013:p1187:b008:l023","ordinal":166797,"en":"Stallion-like Manas—"},{"id":"semetey-1-2013:p1187:b008:l024","ordinal":166798,"en":"I will thrust a spear into his muscle;"},{"id":"semetey-1-2013:p1187:b008:l025","ordinal":166799,"en":"Raging Manas—"},{"id":"semetey-1-2013:p1187:b008:l026","ordinal":166800,"en":"I will split him before the assembled people;"},{"id":"semetey-1-2013:p1187:b008:l027","ordinal":166801,"en":"From bloodletter Manas the Burut,"},{"id":"semetey-1-2013:p1187:b008:l028","ordinal":166802,"en":"I will take my revenge alone."},{"id":"semetey-1-2013:p1188:b003:l001","ordinal":166803,"en":"If I spear his Manas and lay him low,"},{"id":"semetey-1-2013:p1188:b003:l002","ordinal":166804,"en":"I will crush and drive away"},{"id":"semetey-1-2013:p1188:b003:l003","ordinal":166805,"en":"The Buruts who came to the feast,"},{"id":"semetey-1-2013:p1188:b003:l004","ordinal":166806,"en":"Humiliate Khan Koshoy,"},{"id":"semetey-1-2013:p1188:b003:l005","ordinal":166807,"en":"Overpower Khan Bakay,"},{"id":"semetey-1-2013:p1188:b003:l006","ordinal":166808,"en":"And bind without killing"},{"id":"semetey-1-2013:p1188:b003:l007","ordinal":166809,"en":"Old Koshoy and Bakay."},{"id":"semetey-1-2013:p1188:b003:l008","ordinal":166810,"en":"I will utterly smash and slaughter"},{"id":"semetey-1-2013:p1188:b003:l009","ordinal":166811,"en":"All the Buruts."},{"id":"semetey-1-2013:p1188:b003:l010","ordinal":166812,"en":"I will not let them taste their salt;"},{"id":"semetey-1-2013:p1188:b003:l011","ordinal":166813,"en":"I will plunder their daughters,"},{"id":"semetey-1-2013:p1188:b003:l012","ordinal":166814,"en":"Bind their heroes,"},{"id":"semetey-1-2013:p1188:b003:l013","ordinal":166815,"en":"Of the accursed Buruts,"},{"id":"semetey-1-2013:p1188:b003:l014","ordinal":166816,"en":"And take their wives as booty.\""},{"id":"semetey-1-2013:p1188:b003:l015","ordinal":166817,"en":"He angrily spurred"},{"id":"semetey-1-2013:p1188:b003:l016","ordinal":166818,"en":"The horse Algara beneath him;"},{"id":"semetey-1-2013:p1188:b003:l017","ordinal":166819,"en":"Incorrigible Kongurbay"},{"id":"semetey-1-2013:p1188:b003:l018","ordinal":166820,"en":"Made it pace over rise and hollow."},{"id":"semetey-1-2013:p1188:b003:l019","ordinal":166821,"en":"Wrapped in blue armor,"},{"id":"semetey-1-2013:p1188:b003:l020","ordinal":166822,"en":"Kongurbay, if you saw him,"},{"id":"semetey-1-2013:p1188:b003:l021","ordinal":166823,"en":"Strained like a blue tiger."},{"id":"semetey-1-2013:p1188:b003:l022","ordinal":166824,"en":"His eyes were the size of a lake;"},{"id":"semetey-1-2013:p1188:b003:l023","ordinal":166825,"en":"If you saw the Chinese man,"},{"id":"semetey-1-2013:p1188:b003:l024","ordinal":166826,"en":"Kongurbay was gray-maned."},{"id":"semetey-1-2013:p1188:b003:l025","ordinal":166827,"en":"He had brows like a lying dog"},{"id":"semetey-1-2013:p1188:b003:l026","ordinal":166828,"en":"And a head like a great cauldron."},{"id":"semetey-1-2013:p1188:b003:l027","ordinal":166829,"en":"He had reached twenty-five;"},{"id":"semetey-1-2013:p1188:b003:l028","ordinal":166830,"en":"That was his age this year."},{"id":"semetey-1-2013:p1188:b003:l029","ordinal":166831,"en":"His right shoulder was broad;"},{"id":"semetey-1-2013:p1188:b003:l030","ordinal":166832,"en":"He was a lion born under favor."},{"id":"semetey-1-2013:p1188:b003:l031","ordinal":166833,"en":"All twelve limbs were perfectly matched."},{"id":"semetey-1-2013:p1188:b003:l032","ordinal":166834,"en":"For Beijing in Kakanchyn,"},{"id":"semetey-1-2013:p1188:b003:l033","ordinal":166835,"en":"God Almighty had created him"},{"id":"semetey-1-2013:p1188:b003:l034","ordinal":166836,"en":"As a defending lion."},{"id":"semetey-1-2013:p1188:b003:l035","ordinal":166837,"en":"His bearing was extraordinary:"},{"id":"semetey-1-2013:p1188:b003:l036","ordinal":166838,"en":"Kongurbay, son of Alooke,"},{"id":"semetey-1-2013:p1188:b003:l037","ordinal":166839,"en":"The noble champion who came from Beijing."},{"id":"semetey-1-2013:p1188:b003:l038","ordinal":166840,"en":"Among the Chinese in Beijing"},{"id":"semetey-1-2013:p1188:b003:l039","ordinal":166841,"en":"A khan named Alooke arose;"},{"id":"semetey-1-2013:p1188:b004:l001","ordinal":166842,"en":"Kongurbay, son of Alooke,"},{"id":"semetey-1-2013:p1188:b004:l002","ordinal":166843,"en":"Drove life out with his voice,"},{"id":"semetey-1-2013:p1188:b004:l003","ordinal":166844,"en":"And drew embers from the hearth."},{"id":"semetey-1-2013:p1188:b004:l004","ordinal":166845,"en":"For Kokotoy's joust"},{"id":"semetey-1-2013:p1188:b004:l005","ordinal":166846,"en":"The mighty Kongurbay came out."},{"id":"semetey-1-2013:p1188:b004:l006","ordinal":166847,"en":"Roaring and swaggering,"},{"id":"semetey-1-2013:p1188:b004:l007","ordinal":166848,"en":"Raging and stamping,"},{"id":"semetey-1-2013:p1188:b004:l008","ordinal":166849,"en":"Kongurbay and Algara"},{"id":"semetey-1-2013:p1188:b004:l009","ordinal":166850,"en":"Came together."},{"id":"semetey-1-2013:p1188:b004:l010","ordinal":166851,"en":"Six thousand Chinese and forty commanders"},{"id":"semetey-1-2013:p1188:b004:l011","ordinal":166852,"en":"Mingled as his followers,"},{"id":"semetey-1-2013:p1188:b004:l012","ordinal":166853,"en":"Leading Kongurbay,"},{"id":"semetey-1-2013:p1188:b004:l013","ordinal":166854,"en":"Preparing his every maneuver,"},{"id":"semetey-1-2013:p1188:b004:l014","ordinal":166855,"en":"And placing exactly sixty spears"},{"id":"semetey-1-2013:p1188:b004:l015","ordinal":166856,"en":"In the Manchus' hands."},{"id":"semetey-1-2013:p1188:b004:l016","ordinal":166857,"en":"Leather belt and twisted waist,"},{"id":"semetey-1-2013:p1188:b004:l017","ordinal":166858,"en":"The raging hero Kalcha;"},{"id":"semetey-1-2013:p1188:b004:l018","ordinal":166859,"en":"Golden crest and tasseled belt,"},{"id":"semetey-1-2013:p1188:b004:l019","ordinal":166860,"en":"The lordly great Kalcha;"},{"id":"semetey-1-2013:p1188:b004:l020","ordinal":166861,"en":"His bristling mustache"},{"id":"semetey-1-2013:p1188:b004:l021","ordinal":166862,"en":"Was like nettles grown by an outhouse,"},{"id":"semetey-1-2013:p1188:b004:l022","ordinal":166863,"en":"And the filth of his pipe"},{"id":"semetey-1-2013:p1188:b004:l023","ordinal":166864,"en":"Like grain mash eaten by sooty children."},{"id":"semetey-1-2013:p1188:b004:l024","ordinal":166865,"en":"He strained upon Algara,"},{"id":"semetey-1-2013:p1188:b004:l025","ordinal":166866,"en":"Jerking the golden reins."},{"id":"semetey-1-2013:p1188:b004:l026","ordinal":166867,"en":"The sight made one's heart waver;"},{"id":"semetey-1-2013:p1188:b004:l027","ordinal":166868,"en":"If you saw Kongurbay,"},{"id":"semetey-1-2013:p1188:b004:l028","ordinal":166869,"en":"He loomed like Ala-Too."},{"id":"semetey-1-2013:p1188:b004:l029","ordinal":166870,"en":"Bulletproof blue armor,"},{"id":"semetey-1-2013:p1188:b004:l030","ordinal":166871,"en":"Strong armor upon his chest,"},{"id":"semetey-1-2013:p1188:b004:l031","ordinal":166872,"en":"He wore it twelve layers deep."},{"id":"semetey-1-2013:p1188:b004:l032","ordinal":166873,"en":"He rejoiced at the word \"enemy.\""},{"id":"semetey-1-2013:p1188:b004:l033","ordinal":166874,"en":"With noble champion Manas—"},{"id":"semetey-1-2013:p1188:b004:l034","ordinal":166875,"en":"He knew he would fight to the death."},{"id":"semetey-1-2013:p1188:b004:l035","ordinal":166876,"en":"The bulletproof mail—"},{"id":"semetey-1-2013:p1188:b004:l036","ordinal":166877,"en":"He knew he would wear it."},{"id":"semetey-1-2013:p1188:b004:l037","ordinal":166878,"en":"Destroyer Manas and Kongurbay—"},{"id":"semetey-1-2013:p1188:b004:l038","ordinal":166879,"en":"He knew they would clash."},{"id":"semetey-1-2013:p1188:b004:l039","ordinal":166880,"en":"Sixty noblemen,"},{"id":"semetey-1-2013:p1189:b003:l001","ordinal":166881,"en":"Youngest son of Khan Alooke,"},{"id":"semetey-1-2013:p1189:b003:l002","ordinal":166882,"en":"He was a fortress set against the foe."},{"id":"semetey-1-2013:p1189:b003:l003","ordinal":166883,"en":"At that time Kongurbay"},{"id":"semetey-1-2013:p1189:b003:l004","ordinal":166884,"en":"Was the mightiest khan of the Kechils."},{"id":"semetey-1-2013:p1189:b003:l005","ordinal":166885,"en":"\"They slaughtered my father!\" he said;"},{"id":"semetey-1-2013:p1189:b003:l006","ordinal":166886,"en":"He bore a grudge."},{"id":"semetey-1-2013:p1189:b003:l007","ordinal":166887,"en":"Terrible in bearing, powerful in venom,"},{"id":"semetey-1-2013:p1189:b003:l008","ordinal":166888,"en":"Kongurbay, son of Alooke,"},{"id":"semetey-1-2013:p1189:b003:l009","ordinal":166889,"en":"Laid low whoever challenged him."},{"id":"semetey-1-2013:p1189:b003:l010","ordinal":166890,"en":"The black horse beneath him—"},{"id":"semetey-1-2013:p1189:b003:l011","ordinal":166891,"en":"That black horse"},{"id":"semetey-1-2013:p1189:b003:l012","ordinal":166892,"en":"Had wings upon its sides."},{"id":"semetey-1-2013:p1189:b003:l013","ordinal":166893,"en":"Whoever challenged him—"},{"id":"semetey-1-2013:p1189:b003:l014","ordinal":166894,"en":"Kongurbay, son of Alooke,"},{"id":"semetey-1-2013:p1189:b003:l015","ordinal":166895,"en":"Habitually threshed them like grain."},{"id":"semetey-1-2013:p1189:b003:l016","ordinal":166896,"en":"His waist was bound with cotton;"},{"id":"semetey-1-2013:p1189:b003:l017","ordinal":166897,"en":"He was born in broad Andijan."},{"id":"semetey-1-2013:p1189:b003:l018","ordinal":166898,"en":"At six years old"},{"id":"semetey-1-2013:p1189:b003:l019","ordinal":166899,"en":"He caused an uproar in Beijing."},{"id":"semetey-1-2013:p1189:b003:l020","ordinal":166900,"en":"At seven years old"},{"id":"semetey-1-2013:p1189:b003:l021","ordinal":166901,"en":"The Manchus and Chinese wearied of him."},{"id":"semetey-1-2013:p1189:b003:l022","ordinal":166902,"en":"When he reached eight,"},{"id":"semetey-1-2013:p1189:b003:l023","ordinal":166903,"en":"He scourged Beijing of Kakanchyn,"},{"id":"semetey-1-2013:p1189:b003:l024","ordinal":166904,"en":"Making its people cry out."},{"id":"semetey-1-2013:p1189:b003:l025","ordinal":166905,"en":"At nine he stopped;"},{"id":"semetey-1-2013:p1189:b003:l026","ordinal":166906,"en":"When he reached ten,"},{"id":"semetey-1-2013:p1189:b003:l027","ordinal":166907,"en":"Great walled Beijing—"},{"id":"semetey-1-2013:p1189:b003:l028","ordinal":166908,"en":"He devastated and ravaged it."},{"id":"semetey-1-2013:p1189:b003:l029","ordinal":166909,"en":"When he reached eleven,"},{"id":"semetey-1-2013:p1189:b003:l030","ordinal":166910,"en":"He besieged great Beijing."},{"id":"semetey-1-2013:p1189:b003:l031","ordinal":166911,"en":"Kongurbay ground them like grain,"},{"id":"semetey-1-2013:p1189:b003:l032","ordinal":166912,"en":"The stone-fortified Chinese—"}]
