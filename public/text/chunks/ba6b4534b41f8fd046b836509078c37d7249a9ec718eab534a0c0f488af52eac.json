[{"id":"manas-2010:p1562:b001:l009","ordinal":67329,"en":"From a lone Burut, Syrgak,"},{"id":"manas-2010:p1562:b001:l010","ordinal":67330,"en":"You all take flight!"},{"id":"manas-2010:p1562:b001:l011","ordinal":67331,"en":"Hero Manas's forty companions"},{"id":"manas-2010:p1562:b001:l012","ordinal":67332,"en":"Are all like Syrgak,"},{"id":"manas-2010:p1562:b001:l013","ordinal":67333,"en":"Every one of them a lion,"},{"id":"manas-2010:p1562:b001:l014","ordinal":67334,"en":"A fierce-maned hero equal to Manas."},{"id":"manas-2010:p1562:b001:l015","ordinal":67335,"en":"Calling the Burut battle cry,"},{"id":"manas-2010:p1562:b001:l016","ordinal":67336,"en":"Shouting out the name of Manas,"},{"id":"manas-2010:p1562:b001:l017","ordinal":67337,"en":"Roaring like lions,"},{"id":"manas-2010:p1562:b001:l018","ordinal":67338,"en":"When they break into your midst,"},{"id":"manas-2010:p1562:b001:l019","ordinal":67339,"en":"Where will you go then?!"},{"id":"manas-2010:p1562:b001:l020","ordinal":67340,"en":"When the Chinese charge,"},{"id":"manas-2010:p1562:b001:l021","ordinal":67341,"en":"And Syrgak sets about slaughter,"},{"id":"manas-2010:p1562:b001:l022","ordinal":67342,"en":"When the forty companions left by Manas"},{"id":"manas-2010:p1562:b001:l023","ordinal":67343,"en":"Come rushing in,"},{"id":"manas-2010:p1562:b001:l024","ordinal":67344,"en":"Almambet and Chubak among them,"},{"id":"manas-2010:p1562:b001:l025","ordinal":67345,"en":"When those men are together,"},{"id":"manas-2010:p1562:b001:l026","ordinal":67346,"en":"What will you do then?!"},{"id":"manas-2010:p1562:b001:l027","ordinal":67347,"en":"My dear, just people,"},{"id":"manas-2010:p1562:b001:l028","ordinal":67348,"en":"Overwhelm Syrgak!"},{"id":"manas-2010:p1562:b001:l029","ordinal":67349,"en":"Why do you keep fleeing?!”"},{"id":"manas-2010:p1562:b001:l030","ordinal":67350,"en":"Thus bellowing,"},{"id":"manas-2010:p1562:b001:l031","ordinal":67351,"en":"Algara's reins"},{"id":"manas-2010:p1562:b001:l032","ordinal":67352,"en":"Were loosed by Kongurbay."},{"id":"manas-2010:p1562:b001:l033","ordinal":67353,"en":"Separating out the spearmen,"},{"id":"manas-2010:p1562:b001:l034","ordinal":67354,"en":"Kongurbay made them ready."},{"id":"manas-2010:p1562:b001:l035","ordinal":67355,"en":"The massed Manzhuu and Chinese,"},{"id":"manas-2010:p1562:b001:l036","ordinal":67356,"en":"Beating them like cattle,"},{"id":"manas-2010:p1562:b001:l037","ordinal":67357,"en":"Kongurbay drove into battle."},{"id":"manas-2010:p1562:b001:l038","ordinal":67358,"en":"Whatever he saw fit this time,"},{"id":"manas-2010:p1562:b001:l039","ordinal":67359,"en":"Kongurbay began to do;"},{"id":"manas-2010:p1562:b001:l040","ordinal":67360,"en":"Those who wavered and turned back,"},{"id":"manas-2010:p1562:b001:l041","ordinal":67361,"en":"Smashing them outright,"},{"id":"manas-2010:p1562:b001:l042","ordinal":67362,"en":"Kongurbay began to slaughter."},{"id":"manas-2010:p1563:b001:l001","ordinal":67363,"en":"Kongurbay's many Chinese,"},{"id":"manas-2010:p1563:b001:l002","ordinal":67364,"en":"Unable to endure his wrath,"},{"id":"manas-2010:p1563:b001:l003","ordinal":67365,"en":"Their brave men all roaring,"},{"id":"manas-2010:p1563:b001:l004","ordinal":67366,"en":"Their cowards screaming,"},{"id":"manas-2010:p1563:b001:l005","ordinal":67367,"en":"Their marksmen running,"},{"id":"manas-2010:p1563:b001:l006","ordinal":67368,"en":"Their archers swarming,"},{"id":"manas-2010:p1563:b001:l007","ordinal":67369,"en":"The lasso-throwing Kalmyks"},{"id":"manas-2010:p1563:b001:l008","ordinal":67370,"en":"Making their lassos ready,"},{"id":"manas-2010:p1563:b001:l009","ordinal":67371,"en":"Swordsmen at the edge,"},{"id":"manas-2010:p1563:b001:l010","ordinal":67372,"en":"Battle-axe wielders at the front,"},{"id":"manas-2010:p1563:b001:l011","ordinal":67373,"en":"Their shouts splitting the sky,"},{"id":"manas-2010:p1563:b001:l012","ordinal":67374,"en":"Their champion, the Fierce One, behind,"},{"id":"manas-2010:p1563:b001:l013","ordinal":67375,"en":"All advanced together."},{"id":"manas-2010:p1563:b001:l014","ordinal":67376,"en":"These were the renowned Chinese themselves;"},{"id":"manas-2010:p1563:b001:l015","ordinal":67377,"en":"Among them, Syrgak"},{"id":"manas-2010:p1563:b001:l016","ordinal":67378,"en":"Was fighting all alone."},{"id":"manas-2010:p1563:b001:l017","ordinal":67379,"en":"When he faced that solitude,"},{"id":"manas-2010:p1563:b001:l018","ordinal":67380,"en":"When he truly suffered hardship,"},{"id":"manas-2010:p1563:b001:l019","ordinal":67381,"en":"From a hollow like a saddle's dip,"},{"id":"manas-2010:p1563:b001:l020","ordinal":67382,"en":"Almambet and Chubak, names paired together,"},{"id":"manas-2010:p1563:b001:l021","ordinal":67383,"en":"Whipped their horses,"},{"id":"manas-2010:p1563:b001:l022","ordinal":67384,"en":"And came thundering."},{"id":"manas-2010:p1563:b001:l023","ordinal":67385,"en":"“If I lose brave Syrgak,"},{"id":"manas-2010:p1563:b001:l024","ordinal":67386,"en":"What hope can I fulfill?” each thought."},{"id":"manas-2010:p1563:b001:l025","ordinal":67387,"en":"Looking like birds in flight,"},{"id":"manas-2010:p1563:b001:l026","ordinal":67388,"en":"Touching ground only here and there,"},{"id":"manas-2010:p1563:b001:l027","ordinal":67389,"en":"They came racing on."},{"id":"manas-2010:p1563:b001:l028","ordinal":67390,"en":"As soon as the two lions arrived,"},{"id":"manas-2010:p1563:b001:l029","ordinal":67391,"en":"They plunged among the Chinese,"},{"id":"manas-2010:p1563:b001:l030","ordinal":67392,"en":"Scattering them like straw,"},{"id":"manas-2010:p1563:b001:l031","ordinal":67393,"en":"And went about calling Syrgak."},{"id":"manas-2010:p1563:b001:l032","ordinal":67394,"en":"He could not be seen among the multitude;"},{"id":"manas-2010:p1563:b001:l033","ordinal":67395,"en":"Mist above, dust before them,"},{"id":"manas-2010:p1563:b001:l034","ordinal":67396,"en":"So many souls mingled together."},{"id":"manas-2010:p1563:b001:l035","ordinal":67397,"en":"They could not tell one from another;"},{"id":"manas-2010:p1563:b001:l036","ordinal":67398,"en":"They searched for Syrgak,"},{"id":"manas-2010:p1563:b001:l037","ordinal":67399,"en":"Scarcely noticing the Chinese."},{"id":"manas-2010:p1563:b001:l038","ordinal":67400,"en":"Swinging lance and sword alike,"},{"id":"manas-2010:p1563:b001:l039","ordinal":67401,"en":"The heroes fought their way through:"},{"id":"manas-2010:p1563:b001:l040","ordinal":67402,"en":"“Where is Syrgak, my comrade?”"},{"id":"manas-2010:p1563:b001:l041","ordinal":67403,"en":"The warriors went about searching."},{"id":"manas-2010:p1563:b001:l042","ordinal":67404,"en":"The Chinese poured in, swarming."},{"id":"manas-2010:p1564:b001:l001","ordinal":67405,"en":"Far from finding Syrgak,"},{"id":"manas-2010:p1564:b001:l002","ordinal":67406,"en":"Almambet and Chubak, the two lions,"},{"id":"manas-2010:p1564:b001:l003","ordinal":67407,"en":"Were separated to either side."},{"id":"manas-2010:p1564:b001:l004","ordinal":67408,"en":"As before, in wild confusion,"},{"id":"manas-2010:p1564:b001:l005","ordinal":67409,"en":"The Chinese took to flight."},{"id":"manas-2010:p1564:b001:l006","ordinal":67410,"en":"They swarmed and fought;"},{"id":"manas-2010:p1564:b001:l007","ordinal":67411,"en":"The lions grappled,"},{"id":"manas-2010:p1564:b001:l008","ordinal":67412,"en":"Striking with their battle-axes,"},{"id":"manas-2010:p1564:b001:l009","ordinal":67413,"en":"At times swinging lances,"},{"id":"manas-2010:p1564:b001:l010","ordinal":67414,"en":"Driving them straight into hearts."},{"id":"manas-2010:p1564:b001:l011","ordinal":67415,"en":"The face of the earth turned to dust;"},{"id":"manas-2010:p1564:b001:l012","ordinal":67416,"en":"The many Chinese lying dead"},{"id":"manas-2010:p1564:b001:l013","ordinal":67417,"en":"Were bread beneath four hooves."},{"id":"manas-2010:p1564:b001:l014","ordinal":67418,"en":"Haze in the sky, gloom on the ground,"},{"id":"manas-2010:p1564:b001:l015","ordinal":67419,"en":"Nothing could be seen upon the earth."},{"id":"manas-2010:p1564:b001:l016","ordinal":67420,"en":"Turmoil fell, and dust arose;"},{"id":"manas-2010:p1564:b001:l017","ordinal":67421,"en":"Anyone looking was bewildered,"},{"id":"manas-2010:p1564:b001:l018","ordinal":67422,"en":"Unable to tell one from another."},{"id":"manas-2010:p1564:b001:l019","ordinal":67423,"en":"Even then, brave Syrgak"},{"id":"manas-2010:p1564:b001:l020","ordinal":67424,"en":"Could not be caught by the eye."},{"id":"manas-2010:p1564:b001:l021","ordinal":67425,"en":"Dear brother Almambet,"},{"id":"manas-2010:p1564:b001:l022","ordinal":67426,"en":"Bulwark of the Burut host,"},{"id":"manas-2010:p1564:b001:l023","ordinal":67427,"en":"Worried for brave Syrgak."},{"id":"manas-2010:p1564:b001:l024","ordinal":67428,"en":"The many Chinese harried him,"},{"id":"manas-2010:p1564:b001:l025","ordinal":67429,"en":"Yet even so he persisted."},{"id":"manas-2010:p1564:b001:l026","ordinal":67430,"en":"Sarala, with cowlike lean haunches,"},{"id":"manas-2010:p1564:b001:l027","ordinal":67431,"en":"He rode at measured speed in battle;"},{"id":"manas-2010:p1564:b001:l028","ordinal":67432,"en":"Almambet held him in check."},{"id":"manas-2010:p1564:b001:l029","ordinal":67433,"en":"His very life was sorely pressed."},{"id":"manas-2010:p1564:b001:l030","ordinal":67434,"en":"Cloudy by day, clear at night,"},{"id":"manas-2010:p1564:b001:l031","ordinal":67435,"en":"Making the weather turn foul,"},{"id":"manas-2010:p1564:b001:l032","ordinal":67436,"en":"Almambet worked his weather spells."},{"id":"manas-2010:p1564:b001:l033","ordinal":67437,"en":"While the Chinese stood shivering,"},{"id":"manas-2010:p1564:b001:l034","ordinal":67438,"en":"Almambet slew them."},{"id":"manas-2010:p1564:b001:l035","ordinal":67439,"en":"When the dust had settled,"},{"id":"manas-2010:p1564:b001:l036","ordinal":67440,"en":"He stopped and looked:"},{"id":"manas-2010:p1564:b001:l037","ordinal":67441,"en":"The brim of the black felt hat,"},{"id":"manas-2010:p1564:b001:l038","ordinal":67442,"en":"Smashing the Chinese host,"},{"id":"manas-2010:p1564:b001:l039","ordinal":67443,"en":"Was busy slaughtering them—"},{"id":"manas-2010:p1564:b001:l040","ordinal":67444,"en":"Khan Manas's Syrgak."},{"id":"manas-2010:p1564:b001:l041","ordinal":67445,"en":"Planting his lance and leaning on it,"},{"id":"manas-2010:p1564:b001:l042","ordinal":67446,"en":"His mouth parched, Almambet,"},{"id":"manas-2010:p1565:b001:l001","ordinal":67447,"en":"Repeatedly licking his lips,"},{"id":"manas-2010:p1565:b001:l002","ordinal":67448,"en":"Grateful to Syrgak,"},{"id":"manas-2010:p1565:b001:l003","ordinal":67449,"en":"Stood gazing at him beseechingly."},{"id":"manas-2010:p1565:b001:l004","ordinal":67450,"en":"“With golden bowls and cheap cloth,"},{"id":"manas-2010:p1565:b001:l005","ordinal":67451,"en":"Among the cities of the Muslims"},{"id":"manas-2010:p1565:b001:l006","ordinal":67452,"en":"There is no city like Samarkand;"},{"id":"manas-2010:p1565:b001:l007","ordinal":67453,"en":"Facing the foe in a ruinous fight,"},{"id":"manas-2010:p1565:b001:l008","ordinal":67454,"en":"There is no youth like brave Syrgak."},{"id":"manas-2010:p1565:b001:l009","ordinal":67455,"en":"Except for Manas's fame,"},{"id":"manas-2010:p1565:b001:l010","ordinal":67456,"en":"There is no measure to his valor."},{"id":"manas-2010:p1565:b001:l011","ordinal":67457,"en":"My banner tied upon my lance,"},{"id":"manas-2010:p1565:b001:l012","ordinal":67458,"en":"Thinking him needed against the enemy,"},{"id":"manas-2010:p1565:b001:l013","ordinal":67459,"en":"I brought him as my gift!”"},{"id":"manas-2010:p1565:b001:l014","ordinal":67460,"en":"At the far edge of the Chinese,"},{"id":"manas-2010:p1565:b001:l015","ordinal":67461,"en":"On the side leading to Beijing,"},{"id":"manas-2010:p1565:b001:l016","ordinal":67462,"en":"Cutting them off and scattering them again,"},{"id":"manas-2010:p1565:b001:l017","ordinal":67463,"en":"Akbaltay's Chubak"},{"id":"manas-2010:p1565:b001:l018","ordinal":67464,"en":"Drove the Chinese before him,"},{"id":"manas-2010:p1565:b001:l019","ordinal":67465,"en":"Like jackdaws struck by a falcon,"},{"id":"manas-2010:p1565:b001:l020","ordinal":67466,"en":"Herding them into a huddle."},{"id":"manas-2010:p1565:b001:l021","ordinal":67467,"en":"Though they fled,"},{"id":"manas-2010:p1565:b001:l022","ordinal":67468,"en":"Upon the massed Chinese and Manzhuu"},{"id":"manas-2010:p1565:b001:l023","ordinal":67469,"en":"He brought torment."},{"id":"manas-2010:p1565:b001:l024","ordinal":67470,"en":"Alöökö's Kongurbay,"},{"id":"manas-2010:p1565:b001:l025","ordinal":67471,"en":"Joining with Ay Zhang-Zhung,"},{"id":"manas-2010:p1565:b001:l026","ordinal":67472,"en":"Taking naked swords in hand,"},{"id":"manas-2010:p1565:b001:l027","ordinal":67473,"en":"Those unable to withstand brave Syrgak,"},{"id":"manas-2010:p1565:b001:l028","ordinal":67474,"en":"The Chinese who had fled,"},{"id":"manas-2010:p1565:b001:l029","ordinal":67475,"en":"Drove back into battle."},{"id":"manas-2010:p1565:b001:l030","ordinal":67476,"en":"Sarala, with cowlike lean haunches,"},{"id":"manas-2010:p1565:b001:l031","ordinal":67477,"en":"Gathering himself and bounding,"},{"id":"manas-2010:p1565:b001:l032","ordinal":67478,"en":"Shooting to the right,"},{"id":"manas-2010:p1565:b001:l033","ordinal":67479,"en":"Striking down ten together,"},{"id":"manas-2010:p1565:b001:l034","ordinal":67480,"en":"Drawing his bow to the left,"},{"id":"manas-2010:p1565:b001:l035","ordinal":67481,"en":"Felling their Soloon warriors,"},{"id":"manas-2010:p1565:b001:l036","ordinal":67482,"en":"Almambet plunged among the countless troops."},{"id":"manas-2010:p1565:b001:l037","ordinal":67483,"en":"At the sight of Almambet,"},{"id":"manas-2010:p1565:b001:l038","ordinal":67484,"en":"Sparing not his one life,"},{"id":"manas-2010:p1565:b001:l039","ordinal":67485,"en":"For he too was a mighty hero,"},{"id":"manas-2010:p1565:b001:l040","ordinal":67486,"en":"The Chinese Ay Zhang-Zhung,"},{"id":"manas-2010:p1565:b001:l041","ordinal":67487,"en":"With many champions and giants,"},{"id":"manas-2010:p1565:b001:l042","ordinal":67488,"en":"Charged at your Alma."},{"id":"manas-2010:p1566:b001:l001","ordinal":67489,"en":"A fierce-maned leopard, a dear lion,"},{"id":"manas-2010:p1566:b001:l002","ordinal":67490,"en":"Without the slightest worry,"},{"id":"manas-2010:p1566:b001:l003","ordinal":67491,"en":"Almambet charged."},{"id":"manas-2010:p1566:b001:l004","ordinal":67492,"en":"He reached them before an arrow could;"},{"id":"manas-2010:p1566:b001:l005","ordinal":67493,"en":"Many champions, many giants,"},{"id":"manas-2010:p1566:b001:l006","ordinal":67494,"en":"With Ay Zhang-Zhung at their head,"},{"id":"manas-2010:p1566:b001:l007","ordinal":67495,"en":"He struck down with his lance,"},{"id":"manas-2010:p1566:b001:l008","ordinal":67496,"en":"Laying every one low,"},{"id":"manas-2010:p1566:b001:l009","ordinal":67497,"en":"And swept through their ranks."},{"id":"manas-2010:p1566:b001:l010","ordinal":67498,"en":"His frail life sorely pressed,"},{"id":"manas-2010:p1566:b001:l011","ordinal":67499,"en":"His body straining mightily,"},{"id":"manas-2010:p1566:b001:l012","ordinal":67500,"en":"The warrior slipped from his saddle,"},{"id":"manas-2010:p1566:b001:l013","ordinal":67501,"en":"His feet left the stirrups,"},{"id":"manas-2010:p1566:b001:l014","ordinal":67502,"en":"His mind greatly distracted,"},{"id":"manas-2010:p1566:b001:l015","ordinal":67503,"en":"Sparks flashing before his eyes,"},{"id":"manas-2010:p1566:b001:l016","ordinal":67504,"en":"Dazed and unable to rest,"},{"id":"manas-2010:p1566:b001:l017","ordinal":67505,"en":"His whole body reeling,"},{"id":"manas-2010:p1566:b001:l018","ordinal":67506,"en":"As he looked about in alarm,"},{"id":"manas-2010:p1566:b001:l019","ordinal":67507,"en":"Cotton sash and wide boots,"},{"id":"manas-2010:p1566:b001:l020","ordinal":67508,"en":"Kongurbay, khan of the monks,"},{"id":"manas-2010:p1566:b001:l021","ordinal":67509,"en":"Came surging forward,"},{"id":"manas-2010:p1566:b001:l022","ordinal":67510,"en":"Making Algara leap,"},{"id":"manas-2010:p1566:b001:l023","ordinal":67511,"en":"Like a man whose wife a dark spirit afflicted,"},{"id":"manas-2010:p1566:b001:l024","ordinal":67512,"en":"As though his foe fled close before him."},{"id":"manas-2010:p1566:b001:l025","ordinal":67513,"en":"The hair upon his face showed,"},{"id":"manas-2010:p1566:b001:l026","ordinal":67514,"en":"His look was like a snake's;"},{"id":"manas-2010:p1566:b001:l027","ordinal":67515,"en":"All his face bristled,"},{"id":"manas-2010:p1566:b001:l028","ordinal":67516,"en":"His moustaches spread,"},{"id":"manas-2010:p1566:b001:l029","ordinal":67517,"en":"Sticking up in separate tufts."},{"id":"manas-2010:p1566:b001:l030","ordinal":67518,"en":"He rumbled like a mighty mountain;"},{"id":"manas-2010:p1566:b001:l031","ordinal":67519,"en":"No one could stand beside him,"},{"id":"manas-2010:p1566:b001:l032","ordinal":67520,"en":"The earth split with the thunder."},{"id":"manas-2010:p1566:b001:l033","ordinal":67521,"en":"As the Fierce One charged,"},{"id":"manas-2010:p1566:b001:l034","ordinal":67522,"en":"Tall and broad-shouldered,"},{"id":"manas-2010:p1566:b001:l035","ordinal":67523,"en":"The great hero of the Oygut,"},{"id":"manas-2010:p1566:b001:l036","ordinal":67524,"en":"Akbaltay's Chubak,"},{"id":"manas-2010:p1566:b001:l037","ordinal":67525,"en":"At the charging Fierce One's"},{"id":"manas-2010:p1566:b001:l038","ordinal":67526,"en":"Flank he meant to strike."},{"id":"manas-2010:p1566:b001:l039","ordinal":67527,"en":"For dear falcon Almambet,"},{"id":"manas-2010:p1566:b001:l040","ordinal":67528,"en":"He would sacrifice himself;"},{"id":"manas-2010:p1566:b001:l041","ordinal":67529,"en":"Sparing not his own life,"},{"id":"manas-2010:p1566:b001:l042","ordinal":67530,"en":"Kögala beneath him—"},{"id":"manas-2010:p1567:b001:l001","ordinal":67531,"en":"Roared along like a flying bird,"},{"id":"manas-2010:p1567:b001:l002","ordinal":67532,"en":"His lacquered lance with its wolf-tongue blade"},{"id":"manas-2010:p1567:b001:l003","ordinal":67533,"en":"Flashed as though struck by moonlight."},{"id":"manas-2010:p1567:b001:l004","ordinal":67534,"en":"He arrived ahead of an arrow;"},{"id":"manas-2010:p1567:b001:l005","ordinal":67535,"en":"As soon as brave Chubak reached him,"},{"id":"manas-2010:p1567:b001:l006","ordinal":67536,"en":"He struck his flank and swept past."},{"id":"manas-2010:p1567:b001:l007","ordinal":67537,"en":"Kongurbay’s padded boots stretched out,"},{"id":"manas-2010:p1567:b001:l008","ordinal":67538,"en":"His neck craned like a rooster’s,"},{"id":"manas-2010:p1567:b001:l009","ordinal":67539,"en":"He twisted aside, bent low,"},{"id":"manas-2010:p1567:b001:l010","ordinal":67540,"en":"Both eyes staring wide,"},{"id":"manas-2010:p1567:b001:l011","ordinal":67541,"en":"His back bowed over."},{"id":"manas-2010:p1567:b001:l012","ordinal":67542,"en":"Through six thousand Chinese, a thousand governors-general,"},{"id":"manas-2010:p1567:b001:l013","ordinal":67543,"en":"Kongurbay fled."},{"id":"manas-2010:p1567:b001:l014","ordinal":67544,"en":"When Kalcha escaped,"},{"id":"manas-2010:p1567:b001:l015","ordinal":67545,"en":"Almambet saw it—"},{"id":"manas-2010:p1567:b001:l016","ordinal":67546,"en":"With brown eyes free of pale flecks,"},{"id":"manas-2010:p1567:b001:l017","ordinal":67547,"en":"A white face free of freckles,"},{"id":"manas-2010:p1567:b001:l018","ordinal":67548,"en":"A golden forelock, a tasseled sash,"},{"id":"manas-2010:p1567:b001:l019","ordinal":67549,"en":"Azizkan’s only son—"},{"id":"manas-2010:p1567:b001:l020","ordinal":67550,"en":"At the seething Chinese"},{"id":"manas-2010:p1567:b001:l021","ordinal":67551,"en":"He charged and attacked again."},{"id":"manas-2010:p1567:b001:l022","ordinal":67552,"en":"When Almambet and Chubak, the paired heroes,"},{"id":"manas-2010:p1567:b001:l023","ordinal":67553,"en":"Fought their way through them,"},{"id":"manas-2010:p1567:b001:l024","ordinal":67554,"en":"Would noble Syrgak stand still?"},{"id":"manas-2010:p1567:b001:l025","ordinal":67555,"en":"From one side of the Chinese"},{"id":"manas-2010:p1567:b001:l026","ordinal":67556,"en":"He charged in, hunched low."},{"id":"manas-2010:p1567:b001:l027","ordinal":67557,"en":"As they fought,"},{"id":"manas-2010:p1567:b001:l028","ordinal":67558,"en":"Looming dimly in jagged shapes,"},{"id":"manas-2010:p1567:b001:l029","ordinal":67559,"en":"Rising in murky ridges,"},{"id":"manas-2010:p1567:b001:l030","ordinal":67560,"en":"It was a region that yielded tea."},{"id":"manas-2010:p1567:b001:l031","ordinal":67561,"en":"When their fury rose,"},{"id":"manas-2010:p1567:b001:l032","ordinal":67562,"en":"The seething host of Chinese"},{"id":"manas-2010:p1567:b001:l033","ordinal":67563,"en":"Was a flood that would engulf them."},{"id":"manas-2010:p1567:b001:l034","ordinal":67564,"en":"How numerous the unbelievers were,"},{"id":"manas-2010:p1567:b001:l035","ordinal":67565,"en":"Almambet had seen before;"},{"id":"manas-2010:p1567:b001:l036","ordinal":67566,"en":"He himself knew it well."},{"id":"manas-2010:p1567:b001:l037","ordinal":67567,"en":"He shouted at the top of his voice,"},{"id":"manas-2010:p1567:b001:l038","ordinal":67568,"en":"Calling Chubak and Syrgak:"},{"id":"manas-2010:p1567:b001:l039","ordinal":67569,"en":"“Come here!”"},{"id":"manas-2010:p1567:b001:l040","ordinal":67570,"en":"At his call the two lions,"},{"id":"manas-2010:p1567:b001:l041","ordinal":67571,"en":"Their whole bodies covered in blood,"},{"id":"manas-2010:p1567:b001:l042","ordinal":67572,"en":"Like wolves that had attacked sheep,"},{"id":"manas-2010:p1568:b001:l001","ordinal":67573,"en":"Licking their lips and faces,"},{"id":"manas-2010:p1568:b001:l002","ordinal":67574,"en":"Came up to Almambet."},{"id":"manas-2010:p1568:b001:l003","ordinal":67575,"en":"“My champion Syrgak, brave Chubak,"},{"id":"manas-2010:p1568:b001:l004","ordinal":67576,"en":"We have met a deep-dug pit,"},{"id":"manas-2010:p1568:b001:l005","ordinal":67577,"en":"We have met seething misfortune."},{"id":"manas-2010:p1568:b001:l006","ordinal":67578,"en":"Not one of us will return alive;"},{"id":"manas-2010:p1568:b001:l007","ordinal":67579,"en":"From this Beijing before us"},{"id":"manas-2010:p1568:b001:l008","ordinal":67580,"en":"We shall not return until we die!"},{"id":"manas-2010:p1568:b001:l009","ordinal":67581,"en":"The reason we cannot return—"},{"id":"manas-2010:p1568:b001:l010","ordinal":67582,"en":"The swelling Flood never entered here;"},{"id":"manas-2010:p1568:b001:l011","ordinal":67583,"en":"These Chinese fill the land."},{"id":"manas-2010:p1568:b001:l012","ordinal":67584,"en":"For nine years I contested the khanship,"}]
