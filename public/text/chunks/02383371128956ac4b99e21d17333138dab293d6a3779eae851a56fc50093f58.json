[{"id":"manas-2010:p0713:b001:l039","ordinal":31745,"en":"Do not snatch even a moment's sleep!"},{"id":"manas-2010:p0713:b001:l040","ordinal":31746,"en":"The misfortune that comes upon our heads,"},{"id":"manas-2010:p0713:b001:l041","ordinal":31747,"en":"Let your strong men who will bear it fully step forth!"},{"id":"manas-2010:p0713:b001:l042","ordinal":31748,"en":"Against the unbeliever living in his white dwelling,"},{"id":"manas-2010:p0714:b001:l001","ordinal":31749,"en":"Against that warrior Alöökö,"},{"id":"manas-2010:p0714:b001:l002","ordinal":31750,"en":"Laying grass upon his yellow trail,"},{"id":"manas-2010:p0714:b001:l003","ordinal":31751,"en":"Let us pursue him until we grow pale."},{"id":"manas-2010:p0714:b001:l004","ordinal":31752,"en":"Laying grass upon his bare trail,"},{"id":"manas-2010:p0714:b001:l005","ordinal":31753,"en":"Let us pursue him until we blanch."},{"id":"manas-2010:p0714:b001:l006","ordinal":31754,"en":"He is the lord of the Chinese."},{"id":"manas-2010:p0714:b001:l007","ordinal":31755,"en":"That swaggering Alöökö,"},{"id":"manas-2010:p0714:b001:l008","ordinal":31756,"en":"Let us trample down upon his head."},{"id":"manas-2010:p0714:b001:l009","ordinal":31757,"en":"Let us scour the face of the earth;"},{"id":"manas-2010:p0714:b001:l010","ordinal":31758,"en":"On accomplished winged steeds,"},{"id":"manas-2010:p0714:b001:l011","ordinal":31759,"en":"Let us cut him off ahead."},{"id":"manas-2010:p0714:b001:l012","ordinal":31760,"en":"Without letting him reach Kakanchyn,"},{"id":"manas-2010:p0714:b001:l013","ordinal":31761,"en":"Upon that ill-intentioned pig"},{"id":"manas-2010:p0714:b001:l014","ordinal":31762,"en":"Let us unleash fierce wrath."},{"id":"manas-2010:p0714:b001:l015","ordinal":31763,"en":"He is the lord of the Chinese,"},{"id":"manas-2010:p0714:b001:l016","ordinal":31764,"en":"Alöökö, who struck down upon your head."},{"id":"manas-2010:p0714:b001:l017","ordinal":31765,"en":"Catching him from behind,"},{"id":"manas-2010:p0714:b001:l018","ordinal":31766,"en":"If Alöökö is superior,"},{"id":"manas-2010:p0714:b001:l019","ordinal":31767,"en":"Let us shout and fight,"},{"id":"manas-2010:p0714:b001:l020","ordinal":31768,"en":"Let us humble his great pride."},{"id":"manas-2010:p0714:b001:l021","ordinal":31769,"en":"The booty he took as booty,"},{"id":"manas-2010:p0714:b001:l022","ordinal":31770,"en":"Let us scatter it all among the people."},{"id":"manas-2010:p0714:b001:l023","ordinal":31771,"en":"Let us bring him abundant suffering;"},{"id":"manas-2010:p0714:b001:l024","ordinal":31772,"en":"Shooting and striking in battle,"},{"id":"manas-2010:p0714:b001:l025","ordinal":31773,"en":"Let us plunder his gold."},{"id":"manas-2010:p0714:b001:l026","ordinal":31774,"en":"If God grants us that fool,"},{"id":"manas-2010:p0714:b001:l027","ordinal":31775,"en":"Let us lay him out full length."},{"id":"manas-2010:p0714:b001:l028","ordinal":31776,"en":"Making that khan caper,"},{"id":"manas-2010:p0714:b001:l029","ordinal":31777,"en":"While the tiger is still alive,"},{"id":"manas-2010:p0714:b001:l030","ordinal":31778,"en":"Dragging him along the road,"},{"id":"manas-2010:p0714:b001:l031","ordinal":31779,"en":"Let us tear him up for the great dogs."},{"id":"manas-2010:p0714:b001:l032","ordinal":31780,"en":"Forty mighty companions, ride abreast!"},{"id":"manas-2010:p0714:b001:l033","ordinal":31781,"en":"Understand what I have said."},{"id":"manas-2010:p0714:b001:l034","ordinal":31782,"en":"If we overthrow Alöökö,"},{"id":"manas-2010:p0714:b001:l035","ordinal":31783,"en":"All of you, forty mighty men alike,"},{"id":"manas-2010:p0714:b001:l036","ordinal":31784,"en":"We shall win the prize and be covered in dust."},{"id":"manas-2010:p0714:b001:l037","ordinal":31785,"en":"If we lose to Alöökö,"},{"id":"manas-2010:p0714:b001:l038","ordinal":31786,"en":"We shall drag our lead ropes and be covered in blood."},{"id":"manas-2010:p0714:b001:l039","ordinal":31787,"en":"Alöökö is the one you will fight,"},{"id":"manas-2010:p0714:b001:l040","ordinal":31788,"en":"The enemy you must take now."},{"id":"manas-2010:p0714:b001:l041","ordinal":31789,"en":"You have support to face him;"},{"id":"manas-2010:p0714:b001:l042","ordinal":31790,"en":"Let us pursue him all the way to Beijing!"},{"id":"manas-2010:p0715:b001:l001","ordinal":31791,"en":"You have a warrior unlike other mortals."},{"id":"manas-2010:p0715:b001:l002","ordinal":31792,"en":"If we reach him, no regret will remain."},{"id":"manas-2010:p0715:b001:l003","ordinal":31793,"en":"Your fathers' graves, forty companions!"},{"id":"manas-2010:p0715:b001:l004","ordinal":31794,"en":"While mighty Manas is there,"},{"id":"manas-2010:p0715:b001:l005","ordinal":31795,"en":"Bring great turmoil upon the nations.”"},{"id":"manas-2010:p0715:b001:l006","ordinal":31796,"en":"The mighty one of the forty companions,"},{"id":"manas-2010:p0715:b001:l007","ordinal":31797,"en":"That is formidable warrior Bakay."},{"id":"manas-2010:p0715:b001:l008","ordinal":31798,"en":"Winged steeds worn out, warriors weary,"},{"id":"manas-2010:p0715:b001:l009","ordinal":31799,"en":"That is where they pursued Alöökö."},{"id":"manas-2010:p0715:b001:l010","ordinal":31800,"en":"Piercing cries became a clamor;"},{"id":"manas-2010:p0715:b001:l011","ordinal":31801,"en":"Their mighty shouting became a roar."},{"id":"manas-2010:p0715:b001:l012","ordinal":31802,"en":"Do not ask about Bakay:"},{"id":"manas-2010:p0715:b001:l013","ordinal":31803,"en":"Of exceptional wisdom, a great knower,"},{"id":"manas-2010:p0715:b001:l014","ordinal":31804,"en":"Who made the unknown known,"},{"id":"manas-2010:p0715:b001:l015","ordinal":31805,"en":"Who made the unperceived perceptible,"},{"id":"manas-2010:p0715:b001:l016","ordinal":31806,"en":"Who planted and made gardens,"},{"id":"manas-2010:p0715:b001:l017","ordinal":31807,"en":"Who built and made houses,"},{"id":"manas-2010:p0715:b001:l018","ordinal":31808,"en":"His presence formidable, his wrath fierce."},{"id":"manas-2010:p0715:b001:l019","ordinal":31809,"en":"If you see Bakay, companions,"},{"id":"manas-2010:p0715:b001:l020","ordinal":31810,"en":"Give up all hope for your lives now!"},{"id":"manas-2010:p0715:b001:l021","ordinal":31811,"en":"Acting the champion, preparing himself,"},{"id":"manas-2010:p0715:b001:l022","ordinal":31812,"en":"Then champion Manas"},{"id":"manas-2010:p0715:b001:l023","ordinal":31813,"en":"Moved swaying into the front."},{"id":"manas-2010:p0715:b001:l024","ordinal":31814,"en":"All the exceptional warriors were there."},{"id":"manas-2010:p0715:b001:l025","ordinal":31815,"en":"Leading the way without sparing his life,"},{"id":"manas-2010:p0715:b001:l026","ordinal":31816,"en":"Wolf Bakay the leopard"},{"id":"manas-2010:p0715:b001:l027","ordinal":31817,"en":"Advanced with his blue spear extended."},{"id":"manas-2010:p0715:b001:l028","ordinal":31818,"en":"Such was Bakay's manner:"},{"id":"manas-2010:p0715:b001:l029","ordinal":31819,"en":"He wielded his mottled blue shield."},{"id":"manas-2010:p0715:b001:l030","ordinal":31820,"en":"Your elder, wolf-man Bakay,"},{"id":"manas-2010:p0715:b001:l031","ordinal":31821,"en":"Swung his blue spear."},{"id":"manas-2010:p0715:b001:l032","ordinal":31822,"en":"His valor was renowned;"},{"id":"manas-2010:p0715:b001:l033","ordinal":31823,"en":"He spared no enemy he faced."},{"id":"manas-2010:p0715:b001:l034","ordinal":31824,"en":"Exceptionally alert, a lion too,"},{"id":"manas-2010:p0715:b001:l035","ordinal":31825,"en":"A sage of deep understanding,"},{"id":"manas-2010:p0715:b001:l036","ordinal":31826,"en":"He knew of wonders from afar,"},{"id":"manas-2010:p0715:b001:l037","ordinal":31827,"en":"Khan Manas's retainer."},{"id":"manas-2010:p0715:b001:l038","ordinal":31828,"en":"Wise leopard Manas,"},{"id":"manas-2010:p0715:b001:l039","ordinal":31829,"en":"Beyond Andijan,"},{"id":"manas-2010:p0715:b001:l040","ordinal":31830,"en":"On this side of the uneven hills,"},{"id":"manas-2010:p0715:b001:l041","ordinal":31831,"en":"Set out across the empty plain."},{"id":"manas-2010:p0715:b001:l042","ordinal":31832,"en":"If you looked there,"},{"id":"manas-2010:p0716:b001:l001","ordinal":31833,"en":"The earth had been stripped bare."},{"id":"manas-2010:p0716:b001:l002","ordinal":31834,"en":"The places they had passed"},{"id":"manas-2010:p0716:b001:l003","ordinal":31835,"en":"Were hollowed into gullies."},{"id":"manas-2010:p0716:b001:l004","ordinal":31836,"en":"The earth was stripped and turned to dust;"},{"id":"manas-2010:p0716:b001:l005","ordinal":31837,"en":"Many people had gone that way."},{"id":"manas-2010:p0716:b001:l006","ordinal":31838,"en":"“The Chinese have departed,” he said;"},{"id":"manas-2010:p0716:b001:l007","ordinal":31839,"en":"Mighty Bakay set them on the trail."},{"id":"manas-2010:p0716:b001:l008","ordinal":31840,"en":"The blue-gray winged steed beneath him,"},{"id":"manas-2010:p0716:b001:l009","ordinal":31841,"en":"He whipped on this side and that,"},{"id":"manas-2010:p0716:b001:l010","ordinal":31842,"en":"Spurring right and left."},{"id":"manas-2010:p0716:b001:l011","ordinal":31843,"en":"The painted spear in his hand"},{"id":"manas-2010:p0716:b001:l012","ordinal":31844,"en":"He waved right and left,"},{"id":"manas-2010:p0716:b001:l013","ordinal":31845,"en":"Showing his destructive might."},{"id":"manas-2010:p0716:b001:l014","ordinal":31846,"en":"Khan Manas's forty noble men"},{"id":"manas-2010:p0716:b001:l015","ordinal":31847,"en":"Had now taken up the trail."},{"id":"manas-2010:p0716:b001:l016","ordinal":31848,"en":"Laying grass upon their yellow trail,"},{"id":"manas-2010:p0716:b001:l017","ordinal":31849,"en":"They pursued until they grew pale."},{"id":"manas-2010:p0716:b001:l018","ordinal":31850,"en":"Laying grass upon their bare trail,"},{"id":"manas-2010:p0716:b001:l019","ordinal":31851,"en":"They now pursued until they blanched."},{"id":"manas-2010:p0716:b001:l020","ordinal":31852,"en":"Rejoicing at the word “enemy,”"},{"id":"manas-2010:p0716:b001:l021","ordinal":31853,"en":"Khan Manas's forty wolves,"},{"id":"manas-2010:p0716:b001:l022","ordinal":31854,"en":"All mighty, every one a warrior,"},{"id":"manas-2010:p0716:b001:l023","ordinal":31855,"en":"All alike, twin warriors,"},{"id":"manas-2010:p0716:b001:l024","ordinal":31856,"en":"Into the darkly massed turmoil"},{"id":"manas-2010:p0716:b001:l025","ordinal":31857,"en":"They enter straight, thrusting their spears."},{"id":"manas-2010:p0716:b001:l026","ordinal":31858,"en":"Even if all are slaughtered,"},{"id":"manas-2010:p0716:b001:l027","ordinal":31859,"en":"If one remains, he fights."},{"id":"manas-2010:p0716:b001:l028","ordinal":31860,"en":"If there is an enemy charging,"},{"id":"manas-2010:p0716:b001:l029","ordinal":31861,"en":"They thrust their spears without fleeing."},{"id":"manas-2010:p0716:b001:l030","ordinal":31862,"en":"If terrible hardship falls upon them,"},{"id":"manas-2010:p0716:b001:l031","ordinal":31863,"en":"Those left after the dead"},{"id":"manas-2010:p0716:b001:l032","ordinal":31864,"en":"Show fierce courage."},{"id":"manas-2010:p0716:b001:l033","ordinal":31865,"en":"Never fleeing back from fire,"},{"id":"manas-2010:p0716:b001:l034","ordinal":31866,"en":"Khan Manas's forty noble men"},{"id":"manas-2010:p0716:b001:l035","ordinal":31867,"en":"Never draw back from death."},{"id":"manas-2010:p0716:b001:l036","ordinal":31868,"en":"Giving their winged steeds their heads,"},{"id":"manas-2010:p0716:b001:l037","ordinal":31869,"en":"All the warriors rejoiced."},{"id":"manas-2010:p0716:b001:l038","ordinal":31870,"en":"“That lordly Alöökö,"},{"id":"manas-2010:p0716:b001:l039","ordinal":31871,"en":"Before he reaches his Beijing,"},{"id":"manas-2010:p0716:b001:l040","ordinal":31872,"en":"Let us trample down upon his head,” they said."},{"id":"manas-2010:p0716:b001:l041","ordinal":31873,"en":"“The yellow gold he took as tribute,"},{"id":"manas-2010:p0716:b001:l042","ordinal":31874,"en":"Let us seize it as booty in great heaps,"},{"id":"manas-2010:p0717:b001:l001","ordinal":31875,"en":"Let us cast it into the common pile,” they said."},{"id":"manas-2010:p0717:b001:l002","ordinal":31876,"en":"“Destroying many of them,"},{"id":"manas-2010:p0717:b001:l003","ordinal":31877,"en":"Let us fall upon their flank,” they said."},{"id":"manas-2010:p0717:b001:l004","ordinal":31878,"en":"“Clashing in battle and killing,"},{"id":"manas-2010:p0717:b001:l005","ordinal":31879,"en":"That damned pig's"},{"id":"manas-2010:p0717:b001:l006","ordinal":31880,"en":"Blood let us drink like water,” they said."},{"id":"manas-2010:p0717:b001:l007","ordinal":31881,"en":"“Let us catch him on the way,” they said."},{"id":"manas-2010:p0717:b001:l008","ordinal":31882,"en":"“Piercing cries and fierce shouts,"},{"id":"manas-2010:p0717:b001:l009","ordinal":31883,"en":"Let us raise them midway,” they said."},{"id":"manas-2010:p0717:b001:l010","ordinal":31884,"en":"“Making his warriors sprawl,"},{"id":"manas-2010:p0717:b001:l011","ordinal":31885,"en":"Let us plunge them into calamity,” they said."},{"id":"manas-2010:p0717:b001:l012","ordinal":31886,"en":"“His mighty tribute-takers,"},{"id":"manas-2010:p0717:b001:l013","ordinal":31887,"en":"Let us wipe them out completely,” they said."},{"id":"manas-2010:p0717:b001:l014","ordinal":31888,"en":"“Utterly slaughtering his troops,"},{"id":"manas-2010:p0717:b001:l015","ordinal":31889,"en":"Let us bind the man himself,” they said."},{"id":"manas-2010:p0717:b001:l016","ordinal":31890,"en":"All forty companions,"},{"id":"manas-2010:p0717:b001:l017","ordinal":31891,"en":"Their elders headed by old Kyrgyl,"},{"id":"manas-2010:p0717:b001:l018","ordinal":31892,"en":"Gave their winged steeds their heads."},{"id":"manas-2010:p0717:b001:l019","ordinal":31893,"en":"Without stopping, they pressed the pursuit."},{"id":"manas-2010:p0717:b001:l020","ordinal":31894,"en":"Crossing uneven land,"},{"id":"manas-2010:p0717:b001:l021","ordinal":31895,"en":"Crossing many a ridge,"},{"id":"manas-2010:p0717:b001:l022","ordinal":31896,"en":"Of the moon-yellow plain"},{"id":"manas-2010:p0717:b001:l023","ordinal":31897,"en":"They now crossed the lower edge."},{"id":"manas-2010:p0717:b001:l024","ordinal":31898,"en":"Between Andijan and Kashgar,"},{"id":"manas-2010:p0717:b001:l025","ordinal":31899,"en":"They now crossed the towering mountain."},{"id":"manas-2010:p0717:b001:l026","ordinal":31900,"en":"Looking on its farther side,"},{"id":"manas-2010:p0717:b001:l027","ordinal":31901,"en":"Haze stretched beyond the eye's reach;"},{"id":"manas-2010:p0717:b001:l028","ordinal":31902,"en":"They now descended the other side."},{"id":"manas-2010:p0717:b001:l029","ordinal":31903,"en":"Looking, nothing could be made out,"},{"id":"manas-2010:p0717:b001:l030","ordinal":31904,"en":"Hazy, forming distant corners,"},{"id":"manas-2010:p0717:b001:l031","ordinal":31905,"en":"Dim, narrowing to points,"},{"id":"manas-2010:p0717:b001:l032","ordinal":31906,"en":"None could tell what was what."},{"id":"manas-2010:p0717:b001:l033","ordinal":31907,"en":"Not mistaking the direction they had gone,"},{"id":"manas-2010:p0717:b001:l034","ordinal":31908,"en":"Their elder Bakay, bringer of good fortune,"},{"id":"manas-2010:p0717:b001:l035","ordinal":31909,"en":"Like a countless host when placed in front,"},{"id":"manas-2010:p0717:b001:l036","ordinal":31910,"en":"Not mistaking the tracks they had trodden,"},{"id":"manas-2010:p0717:b001:l037","ordinal":31911,"en":"Hurrying, rushing in haste,"},{"id":"manas-2010:p0717:b001:l038","ordinal":31912,"en":"Now pursued them relentlessly."},{"id":"manas-2010:p0717:b001:l039","ordinal":31913,"en":"To scatter his plundered livestock,"},{"id":"manas-2010:p0717:b001:l040","ordinal":31914,"en":"The one they would fight was Alöökö."},{"id":"manas-2010:p0717:b001:l041","ordinal":31915,"en":"To open the forty companions' road,"},{"id":"manas-2010:p0717:b001:l042","ordinal":31916,"en":"The land was the soil of Kakshaal,"},{"id":"manas-2010:p0718:b001:l001","ordinal":31917,"en":"When the forty companions rode away,"},{"id":"manas-2010:p0718:b001:l002","ordinal":31918,"en":"All the earth's dust"},{"id":"manas-2010:p0718:b001:l003","ordinal":31919,"en":"Flew billowing into the sky."},{"id":"manas-2010:p0718:b001:l004","ordinal":31920,"en":"They drew alongside Jaman-Suu;"},{"id":"manas-2010:p0718:b001:l005","ordinal":31921,"en":"Winged steeds and racers together"},{"id":"manas-2010:p0718:b001:l006","ordinal":31922,"en":"Were shrouded in pitch-black dust."},{"id":"manas-2010:p0718:b001:l007","ordinal":31923,"en":"Their mouths gaped like chasms,"},{"id":"manas-2010:p0718:b001:l008","ordinal":31924,"en":"Their bodies grew hot,"},{"id":"manas-2010:p0718:b001:l009","ordinal":31925,"en":"Their heads bent to the ground;"},{"id":"manas-2010:p0718:b001:l010","ordinal":31926,"en":"All those thoroughbred steeds,"},{"id":"manas-2010:p0718:b001:l011","ordinal":31927,"en":"Their bodies growing hot—"},{"id":"manas-2010:p0718:b001:l012","ordinal":31928,"en":"The forty nobles' forty steeds—"},{"id":"manas-2010:p0718:b001:l013","ordinal":31929,"en":"Their hooves thundered on the earth,"},{"id":"manas-2010:p0718:b001:l014","ordinal":31930,"en":"Their black-steel bits"},{"id":"manas-2010:p0718:b001:l015","ordinal":31931,"en":"Clashed deep in their mouths."},{"id":"manas-2010:p0718:b001:l016","ordinal":31932,"en":"Tossing their forelocks skyward,"},{"id":"manas-2010:p0718:b001:l017","ordinal":31933,"en":"As though about to fly,"},{"id":"manas-2010:p0718:b001:l018","ordinal":31934,"en":"All sped onward side by side."},{"id":"manas-2010:p0718:b001:l019","ordinal":31935,"en":"From the broad ground where trumpets sounded,"},{"id":"manas-2010:p0718:b001:l020","ordinal":31936,"en":"From the wide ravine where no bird flew,"},{"id":"manas-2010:p0718:b001:l021","ordinal":31937,"en":"They sent dust curling mountain-high."},{"id":"manas-2010:p0718:b001:l022","ordinal":31938,"en":"Those forty mountain-sized wolves"},{"id":"manas-2010:p0718:b001:l023","ordinal":31939,"en":"Galloped on without a halt,"},{"id":"manas-2010:p0718:b001:l024","ordinal":31940,"en":"Their waists firmly girded,"},{"id":"manas-2010:p0718:b001:l025","ordinal":31941,"en":"For valiant, wolf-maned Manas,"},{"id":"manas-2010:p0718:b001:l026","ordinal":31942,"en":"They were born to bring good fortune."},{"id":"manas-2010:p0718:b001:l027","ordinal":31943,"en":"Whenever foes came out to face them,"},{"id":"manas-2010:p0718:b001:l028","ordinal":31944,"en":"They raised an uproar."},{"id":"manas-2010:p0718:b001:l029","ordinal":31945,"en":"They streamed along the bank,"},{"id":"manas-2010:p0718:b001:l030","ordinal":31946,"en":"Swaying shoulder to shoulder."},{"id":"manas-2010:p0718:b001:l031","ordinal":31947,"en":"When they came to certain places,"},{"id":"manas-2010:p0718:b001:l032","ordinal":31948,"en":"Their spearheads struck together;"},{"id":"manas-2010:p0718:b001:l033","ordinal":31949,"en":"With their peerless racing steeds,"},{"id":"manas-2010:p0718:b001:l034","ordinal":31950,"en":"They wrestled at the reins."},{"id":"manas-2010:p0718:b001:l035","ordinal":31951,"en":"Banners fluttered in their hands;"},{"id":"manas-2010:p0718:b001:l036","ordinal":31952,"en":"The sweat that ran from chosen steeds"},{"id":"manas-2010:p0718:b001:l037","ordinal":31953,"en":"Splashed against the stirrups."},{"id":"manas-2010:p0718:b001:l038","ordinal":31954,"en":"Into a saddle-shaped pass"},{"id":"manas-2010:p0718:b001:l039","ordinal":31955,"en":"They bent low and rode;"},{"id":"manas-2010:p0718:b001:l040","ordinal":31956,"en":"Into Bötönchü's marsh"},{"id":"manas-2010:p0718:b001:l041","ordinal":31957,"en":"They had just made their way,"},{"id":"manas-2010:p0718:b001:l042","ordinal":31958,"en":"With wolf-like Bakai at their head."},{"id":"manas-2010:p0719:b001:l001","ordinal":31959,"en":"The champions risked their lives without stint;"},{"id":"manas-2010:p0719:b001:l002","ordinal":31960,"en":"Even an early word seemed late."},{"id":"manas-2010:p0719:b001:l003","ordinal":31961,"en":"To reach the warrior Alööke,"},{"id":"manas-2010:p0719:b001:l004","ordinal":31962,"en":"To strike him with their spears,"},{"id":"manas-2010:p0719:b001:l005","ordinal":31963,"en":"To fight it out to the end,"},{"id":"manas-2010:p0719:b001:l006","ordinal":31964,"en":"They strained their eyes with longing."},{"id":"manas-2010:p0719:b001:l007","ordinal":31965,"en":"Lion Manas upon Akkula"},{"id":"manas-2010:p0719:b001:l008","ordinal":31966,"en":"Readied himself in wrath;"},{"id":"manas-2010:p0719:b001:l009","ordinal":31967,"en":"He drew the gaze of all who saw him,"},{"id":"manas-2010:p0719:b001:l010","ordinal":31968,"en":"His wolf-maned valor plain to see."},{"id":"manas-2010:p0719:b001:l011","ordinal":31969,"en":"Along the broad river valley"},{"id":"manas-2010:p0719:b001:l012","ordinal":31970,"en":"The warriors arrived"},{"id":"manas-2010:p0719:b001:l013","ordinal":31971,"en":"At the hollow of Kum-Daryya."},{"id":"manas-2010:p0719:b001:l014","ordinal":31972,"en":"They followed hard upon his trail,"},{"id":"manas-2010:p0719:b001:l015","ordinal":31973,"en":"Pursuing with relentless longing."},{"id":"manas-2010:p0719:b001:l016","ordinal":31974,"en":"They found it was Kum-Aryk,"},{"id":"manas-2010:p0719:b001:l017","ordinal":31975,"en":"Known as the river Lob."},{"id":"manas-2010:p0719:b001:l018","ordinal":31976,"en":"They lay hemmed in there."},{"id":"manas-2010:p0719:b001:l019","ordinal":31977,"en":"The moon was dark, the day overcast;"},{"id":"manas-2010:p0719:b001:l020","ordinal":31978,"en":"Nothing could be caught by the eye."},{"id":"manas-2010:p0719:b001:l021","ordinal":31979,"en":"Thus it flowed, dark and lowering;"},{"id":"manas-2010:p0719:b001:l022","ordinal":31980,"en":"They could not tell which way it lay."},{"id":"manas-2010:p0719:b001:l023","ordinal":31981,"en":"When dawn began to swell,"},{"id":"manas-2010:p0719:b001:l024","ordinal":31982,"en":"When the first true light appeared,"},{"id":"manas-2010:p0719:b001:l025","ordinal":31983,"en":"The land grew faintly visible."},{"id":"manas-2010:p0719:b001:l026","ordinal":31984,"en":"Your discerning elder, Khan Bakai,"},{"id":"manas-2010:p0719:b001:l027","ordinal":31985,"en":"Did not lose the route they had taken."},{"id":"manas-2010:p0719:b001:l028","ordinal":31986,"en":"Dark willow shoots and many tamarisks—"},{"id":"manas-2010:p0719:b001:l029","ordinal":31987,"en":"This was the bank of Kum-Aryk."},{"id":"manas-2010:p0719:b001:l030","ordinal":31988,"en":"Along Jangyryk's Jar-Kyya,"},{"id":"manas-2010:p0719:b001:l031","ordinal":31989,"en":"A trail for horses in single file,"},{"id":"manas-2010:p0719:b001:l032","ordinal":31990,"en":"The warriors made their way."},{"id":"manas-2010:p0719:b001:l033","ordinal":31991,"en":"When they reached farther on,"},{"id":"manas-2010:p0719:b001:l034","ordinal":31992,"en":"The water divided among the shallows,"},{"id":"manas-2010:p0719:b001:l035","ordinal":31993,"en":"And the raised ford came into view:"},{"id":"manas-2010:p0719:b001:l036","ordinal":31994,"en":"Shyta-Kechüü, Tash-Kechüü,"},{"id":"manas-2010:p0719:b001:l037","ordinal":31995,"en":"The easy ford Alööke used."},{"id":"manas-2010:p0719:b001:l038","ordinal":31996,"en":"They waded in his tracks"},{"id":"manas-2010:p0719:b001:l039","ordinal":31997,"en":"And crossed Kum-Aryk now."},{"id":"manas-2010:p0719:b001:l040","ordinal":31998,"en":"Those who saw it had no cause for regret:"},{"id":"manas-2010:p0719:b001:l041","ordinal":31999,"en":"While wolf-maned Manas lived,"},{"id":"manas-2010:p0719:b001:l042","ordinal":32000,"en":"He brought great strife upon the Chinese."}]
