[{"id":"semetey-1-2013:p0222:b003:l017","ordinal":93697,"en":"And was left behind!"},{"id":"semetey-1-2013:p0222:b003:l018","ordinal":93698,"en":"For this shameless woman's sake,"},{"id":"semetey-1-2013:p0222:b003:l019","ordinal":93699,"en":"Rather than be mocked by the people,"},{"id":"semetey-1-2013:p0222:b003:l020","ordinal":93700,"en":"Unless I send Semetey in fury,"},{"id":"semetey-1-2013:p0222:b003:l021","ordinal":93701,"en":"Unless I seize her upon the road,"},{"id":"semetey-1-2013:p0222:b003:l022","ordinal":93702,"en":"Have her dragged along the road,"},{"id":"semetey-1-2013:p0222:b003:l023","ordinal":93703,"en":"That calamity-bringing bitch,"},{"id":"semetey-1-2013:p0222:b003:l024","ordinal":93704,"en":"Unless I seize and split her on the road!”"},{"id":"semetey-1-2013:p0222:b003:l025","ordinal":93705,"en":"So spoke Ismail."},{"id":"semetey-1-2013:p0222:b003:l026","ordinal":93706,"en":"Ismail's white palace—"},{"id":"semetey-1-2013:p0222:b003:l027","ordinal":93707,"en":"Its door was iron, solid tin."},{"id":"semetey-1-2013:p0222:b003:l028","ordinal":93708,"en":"His majesty far surpassed the people's;"},{"id":"semetey-1-2013:p0222:b003:l029","ordinal":93709,"en":"Was he not a khan of great standing?"},{"id":"semetey-1-2013:p0222:b003:l030","ordinal":93710,"en":"Anyone who saw Ismail's form was frightened."},{"id":"semetey-1-2013:p0222:b003:l032","ordinal":93711,"en":"He had seven guards,"},{"id":"semetey-1-2013:p0222:b003:l033","ordinal":93712,"en":"Human noses and ears"},{"id":"semetey-1-2013:p0222:b003:l034","ordinal":93713,"en":"They wore fastened as amulets."},{"id":"semetey-1-2013:p0222:b003:l035","ordinal":93714,"en":"Seventy executioners,"},{"id":"semetey-1-2013:p0222:b003:l036","ordinal":93715,"en":"Forty sword-bearing guards—"},{"id":"semetey-1-2013:p0222:b003:l037","ordinal":93716,"en":"No person approached;"},{"id":"semetey-1-2013:p0222:b003:l038","ordinal":93717,"en":"Not a mite of strength remained in them."},{"id":"semetey-1-2013:p0222:b003:l039","ordinal":93718,"en":"Was not Ismail a khan"},{"id":"semetey-1-2013:p0222:b004:l001","ordinal":93719,"en":"Of considerable majesty?"},{"id":"semetey-1-2013:p0222:b004:l002","ordinal":93720,"en":"His knees bent to the ground."},{"id":"semetey-1-2013:p0222:b004:l003","ordinal":93721,"en":"A grove of plane trees surrounded it,"},{"id":"semetey-1-2013:p0222:b004:l004","ordinal":93722,"en":"A golden throne stood in the middle."},{"id":"semetey-1-2013:p0222:b004:l005","ordinal":93723,"en":"Running up to his throne,"},{"id":"semetey-1-2013:p0222:b004:l006","ordinal":93724,"en":"Ismail sent word,"},{"id":"semetey-1-2013:p0222:b004:l007","ordinal":93725,"en":"To Semetey first,"},{"id":"semetey-1-2013:p0222:b004:l008","ordinal":93726,"en":"And then to all his executioners."},{"id":"semetey-1-2013:p0222:b004:l009","ordinal":93727,"en":"He sounded the drum."},{"id":"semetey-1-2013:p0222:b004:l010","ordinal":93728,"en":"Five times he had his shawm"},{"id":"semetey-1-2013:p0222:b004:l011","ordinal":93729,"en":"Cry out with great force."},{"id":"semetey-1-2013:p0222:b004:l012","ordinal":93730,"en":"He struck his kettledrum with a crash,"},{"id":"semetey-1-2013:p0222:b004:l013","ordinal":93731,"en":"And sounded his small drum."},{"id":"semetey-1-2013:p0222:b004:l014","ordinal":93732,"en":"When Ismail sent word,"},{"id":"semetey-1-2013:p0222:b004:l015","ordinal":93733,"en":"When they heard this news,"},{"id":"semetey-1-2013:p0222:b004:l016","ordinal":93734,"en":"Their knees bending,"},{"id":"semetey-1-2013:p0222:b004:l017","ordinal":93735,"en":"His wrestlers came running."},{"id":"semetey-1-2013:p0222:b004:l018","ordinal":93736,"en":"Their leaders of ten bobbed in their saddles,"},{"id":"semetey-1-2013:p0222:b004:l019","ordinal":93737,"en":"His commanders of fifty hurried:"},{"id":"semetey-1-2013:p0222:b004:l020","ordinal":93738,"en":"“What dispute has arisen?” they said."},{"id":"semetey-1-2013:p0222:b004:l021","ordinal":93739,"en":"“Where is an enemy abroad?” they said."},{"id":"semetey-1-2013:p0222:b004:l022","ordinal":93740,"en":"The most skillful of the spearmen,"},{"id":"semetey-1-2013:p0222:b004:l023","ordinal":93741,"en":"His marksmen who never missed,"},{"id":"semetey-1-2013:p0222:b004:l024","ordinal":93742,"en":"His orators who never faltered,"},{"id":"semetey-1-2013:p0222:b004:l025","ordinal":93743,"en":"His learned men, his elders,"},{"id":"semetey-1-2013:p0222:b004:l026","ordinal":93744,"en":"All thronging as though an enemy had come,"},{"id":"semetey-1-2013:p0222:b004:l027","ordinal":93745,"en":"All his wrestlers"},{"id":"semetey-1-2013:p0222:b004:l028","ordinal":93746,"en":"Came and stood there."},{"id":"semetey-1-2013:p0222:b004:l029","ordinal":93747,"en":"Bukhara's khan Ismail"},{"id":"semetey-1-2013:p0222:b004:l030","ordinal":93748,"en":"Roared in anger."},{"id":"semetey-1-2013:p0222:b004:l031","ordinal":93749,"en":"“Come here!” he said then,"},{"id":"semetey-1-2013:p0222:b004:l032","ordinal":93750,"en":"Calling Semetey."},{"id":"semetey-1-2013:p0222:b004:l033","ordinal":93751,"en":"When Semetey arrived,"},{"id":"semetey-1-2013:p0222:b004:l034","ordinal":93752,"en":"The bastard let loose,"},{"id":"semetey-1-2013:p0222:b004:l035","ordinal":93753,"en":"Speaking ill of his elder sister Kanykei."},{"id":"semetey-1-2013:p0222:b004:l036","ordinal":93754,"en":"At that time, Semetey"},{"id":"semetey-1-2013:p0222:b004:l037","ordinal":93755,"en":"Had not yet worn a cloak upon his shoulders;"},{"id":"semetey-1-2013:p0222:b004:l038","ordinal":93756,"en":"Manas, gone to the other world—"},{"id":"semetey-1-2013:p0222:b004:l039","ordinal":93757,"en":"He did not yet know he was his father."},{"id":"semetey-1-2013:p0223:b003:l001","ordinal":93758,"en":"Kara-Kyr stretching out—"},{"id":"semetey-1-2013:p0223:b003:l002","ordinal":93759,"en":"He did not yet know it as his horse-line."},{"id":"semetey-1-2013:p0223:b003:l003","ordinal":93760,"en":"The grieving woman Kanykei—"},{"id":"semetey-1-2013:p0223:b003:l004","ordinal":93761,"en":"He did not yet know she was his mother."},{"id":"semetey-1-2013:p0223:b003:l005","ordinal":93762,"en":"His mother Kanykei,"},{"id":"semetey-1-2013:p0223:b003:l006","ordinal":93763,"en":"Hunched like a hunting hound,"},{"id":"semetey-1-2013:p0223:b003:l007","ordinal":93764,"en":"He did not yet know how she had trotted."},{"id":"semetey-1-2013:p0223:b003:l008","ordinal":93765,"en":"Fleeing Talas, wandering on foot,"},{"id":"semetey-1-2013:p0223:b003:l009","ordinal":93766,"en":"He did not yet know how she had come."},{"id":"semetey-1-2013:p0223:b003:l010","ordinal":93767,"en":"Until the Five Wild Sheep stars set,"},{"id":"semetey-1-2013:p0223:b003:l011","ordinal":93768,"en":"Her white breast, slender as a spindle—"},{"id":"semetey-1-2013:p0223:b003:l012","ordinal":93769,"en":"He did not yet know he had suckled it."},{"id":"semetey-1-2013:p0223:b003:l013","ordinal":93770,"en":"Kanykei had once come in mourning;"},{"id":"semetey-1-2013:p0223:b003:l014","ordinal":93771,"en":"Semetey had come fleeing to Bukhara."},{"id":"semetey-1-2013:p0223:b003:l015","ordinal":93772,"en":"He prospered by plundering their valuables,"},{"id":"semetey-1-2013:p0223:b003:l016","ordinal":93773,"en":"The child entered Bukhara and grew up."},{"id":"semetey-1-2013:p0223:b003:l017","ordinal":93774,"en":"He reached manhood and became a hero,"},{"id":"semetey-1-2013:p0223:b003:l018","ordinal":93775,"en":"Became the equal of warriors' sons."},{"id":"semetey-1-2013:p0223:b003:l019","ordinal":93776,"en":"Chipped from white steel,"},{"id":"semetey-1-2013:p0223:b003:l020","ordinal":93777,"en":"Taken in and raised by Ismail,"},{"id":"semetey-1-2013:p0223:b003:l021","ordinal":93778,"en":"He came to Bukhara and matured."},{"id":"semetey-1-2013:p0223:b003:l022","ordinal":93779,"en":"His thoughts were elsewhere."},{"id":"semetey-1-2013:p0223:b003:l023","ordinal":93780,"en":"At that time, Semetey"},{"id":"semetey-1-2013:p0223:b003:l024","ordinal":93781,"en":"Was Khan Ismail's son,"},{"id":"semetey-1-2013:p0223:b003:l025","ordinal":93782,"en":"Temir Khan's camel-calf."},{"id":"semetey-1-2013:p0223:b003:l026","ordinal":93783,"en":"He had emerged a burning ember."},{"id":"semetey-1-2013:p0223:b003:l027","ordinal":93784,"en":"In mighty Bukhara's city,"},{"id":"semetey-1-2013:p0223:b003:l028","ordinal":93785,"en":"No such unruly boy had appeared."},{"id":"semetey-1-2013:p0223:b003:l029","ordinal":93786,"en":"Ismail in Bukhara"},{"id":"semetey-1-2013:p0223:b003:l030","ordinal":93787,"en":"Resolved to take hostile action."},{"id":"semetey-1-2013:p0223:b003:l031","ordinal":93788,"en":"Speaking ill of Kanykei,"},{"id":"semetey-1-2013:p0223:b003:l032","ordinal":93789,"en":"He now told a remarkable tale:"},{"id":"semetey-1-2013:p0223:b003:l033","ordinal":93790,"en":"“Oh, Semetey, my foal,"},{"id":"semetey-1-2013:p0223:b003:l034","ordinal":93791,"en":"I heard news from those who came."},{"id":"semetey-1-2013:p0223:b003:l035","ordinal":93792,"en":"Your ill-omened elder sister,"},{"id":"semetey-1-2013:p0223:b003:l036","ordinal":93793,"en":"Running wild in her widowhood,"},{"id":"semetey-1-2013:p0223:b003:l037","ordinal":93794,"en":"Carried away with the wish to race a horse,"},{"id":"semetey-1-2013:p0223:b003:l038","ordinal":93795,"en":"Has sunk into disgrace, I heard!"},{"id":"semetey-1-2013:p0223:b003:l039","ordinal":93796,"en":"Rejoicing that her husband died,"},{"id":"semetey-1-2013:p0223:b004:l001","ordinal":93797,"en":"That wretch, fierce as ever,"},{"id":"semetey-1-2013:p0223:b004:l002","ordinal":93798,"en":"Donned a man's clothes,"},{"id":"semetey-1-2013:p0223:b004:l003","ordinal":93799,"en":"Took a shortcut along a broken road,"},{"id":"semetey-1-2013:p0223:b004:l004","ordinal":93800,"en":"A horse of sixty mature years,"},{"id":"semetey-1-2013:p0223:b004:l005","ordinal":93801,"en":"She leads, saying she will race it."},{"id":"semetey-1-2013:p0223:b004:l006","ordinal":93802,"en":"Unable to manage wearing a dress,"},{"id":"semetey-1-2013:p0223:b004:l007","ordinal":93803,"en":"Unable somehow to marry a man,"},{"id":"semetey-1-2013:p0223:b004:l008","ordinal":93804,"en":"She went seeking men and stirred up trouble."},{"id":"semetey-1-2013:p0223:b004:l009","ordinal":93805,"en":"She has brought us boundless shame."},{"id":"semetey-1-2013:p0223:b004:l010","ordinal":93806,"en":"Making them say, ‘His sister is a widow,’"},{"id":"semetey-1-2013:p0223:b004:l011","ordinal":93807,"en":"My child, she has brought trouble upon us all."},{"id":"semetey-1-2013:p0223:b004:l012","ordinal":93808,"en":"How can we bear to see such conduct?"},{"id":"semetey-1-2013:p0223:b004:l013","ordinal":93809,"en":"Having her called a wandering woman,"},{"id":"semetey-1-2013:p0223:b004:l014","ordinal":93810,"en":"Rather than be a laughingstock to all,"},{"id":"semetey-1-2013:p0223:b004:l015","ordinal":93811,"en":"Let us die instead of living."},{"id":"semetey-1-2013:p0223:b004:l016","ordinal":93812,"en":"Oh, Semetey, my foal,"},{"id":"semetey-1-2013:p0223:b004:l017","ordinal":93813,"en":"My river in its valley, my spring,"},{"id":"semetey-1-2013:p0223:b004:l018","ordinal":93814,"en":"My little one, gained through mortal anguish,"},{"id":"semetey-1-2013:p0223:b004:l019","ordinal":93815,"en":"My soft, gray-speckled falcon,"},{"id":"semetey-1-2013:p0223:b004:l020","ordinal":93816,"en":"My gray goshawk, my morning star,"},{"id":"semetey-1-2013:p0223:b004:l021","ordinal":93817,"en":"Hey, Semetey, go there and return."},{"id":"semetey-1-2013:p0223:b004:l022","ordinal":93818,"en":"If Taitoru comes in front,"},{"id":"semetey-1-2013:p0223:b004:l023","ordinal":93819,"en":"Shouting ‘Manas! Manas!’"},{"id":"semetey-1-2013:p0223:b004:l024","ordinal":93820,"en":"Raising the battle cry ‘Manas!’"},{"id":"semetey-1-2013:p0223:b004:l025","ordinal":93821,"en":"Drive him here and bring him back."},{"id":"semetey-1-2013:p0223:b004:l026","ordinal":93822,"en":"If Taitoru falls behind,"},{"id":"semetey-1-2013:p0223:b004:l027","ordinal":93823,"en":"Seize the bitch"},{"id":"semetey-1-2013:p0223:b004:l028","ordinal":93824,"en":"And offer her up as a sacrifice."},{"id":"semetey-1-2013:p0223:b004:l029","ordinal":93825,"en":"Have her dragged along the road"},{"id":"semetey-1-2013:p0223:b004:l030","ordinal":93826,"en":"And split her open for the dogs."},{"id":"semetey-1-2013:p0223:b004:l031","ordinal":93827,"en":"Cut off her head and fasten it,"},{"id":"semetey-1-2013:p0223:b004:l032","ordinal":93828,"en":"Bring it to your father Ismail."},{"id":"semetey-1-2013:p0223:b004:l033","ordinal":93829,"en":"An unbeliever who runs wild like that,"},{"id":"semetey-1-2013:p0223:b004:l035","ordinal":93830,"en":"Do not let her near me, my child;"},{"id":"semetey-1-2013:p0223:b004:l036","ordinal":93831,"en":"Do not let me see her."},{"id":"semetey-1-2013:p0223:b004:l037","ordinal":93832,"en":"Let me tell you of your elder sister."},{"id":"semetey-1-2013:p0223:b004:l038","ordinal":93833,"en":"Your brother-in-law Manas was a hero,"},{"id":"semetey-1-2013:p0223:b004:l039","ordinal":93834,"en":"Born from the whole wide world,"},{"id":"semetey-1-2013:p0224:b003:l001","ordinal":93835,"en":"He was a lion who had emerged."},{"id":"semetey-1-2013:p0224:b003:l002","ordinal":93836,"en":"When he scattered the unbelievers' wealth,"},{"id":"semetey-1-2013:p0224:b003:l003","ordinal":93837,"en":"When he opened the way for Islam,"},{"id":"semetey-1-2013:p0224:b003:l004","ordinal":93838,"en":"Looming Great Beijing—"},{"id":"semetey-1-2013:p0224:b003:l005","ordinal":93839,"en":"When he entered straight and thrust his spear,"},{"id":"semetey-1-2013:p0224:b003:l006","ordinal":93840,"en":"When the grim-faced Chinese and many Manchus"},{"id":"semetey-1-2013:p0224:b003:l007","ordinal":93841,"en":"Were slaughtered without one left,"},{"id":"semetey-1-2013:p0224:b003:l008","ordinal":93842,"en":"When he campaigned against Kakancha"},{"id":"semetey-1-2013:p0224:b003:l009","ordinal":93843,"en":"And fought a mighty battle,"},{"id":"semetey-1-2013:p0224:b003:l010","ordinal":93844,"en":"Twelve khans' peoples went,"},{"id":"semetey-1-2013:p0224:b003:l011","ordinal":93845,"en":"Twelve myriad troops went,"},{"id":"semetey-1-2013:p0224:b003:l012","ordinal":93846,"en":"My father Temir Khan"},{"id":"semetey-1-2013:p0224:b003:l013","ordinal":93847,"en":"Went leading the army."},{"id":"semetey-1-2013:p0224:b003:l014","ordinal":93848,"en":"The two khans Egizey and Shooruk"},{"id":"semetey-1-2013:p0224:b003:l015","ordinal":93849,"en":"Went to wage holy war,"},{"id":"semetey-1-2013:p0224:b003:l016","ordinal":93850,"en":"My golden crown Muzburchak,"},{"id":"semetey-1-2013:p0224:b003:l017","ordinal":93851,"en":"Khan Kokcho of the Kazakhs,"},{"id":"semetey-1-2013:p0224:b003:l018","ordinal":93852,"en":"Zhamgyrchy of the Eshteks,"},{"id":"semetey-1-2013:p0224:b003:l019","ordinal":93853,"en":"The warrior Toshtuk, Eleman's son,"},{"id":"semetey-1-2013:p0224:b003:l020","ordinal":93854,"en":"Khan Koshoi of the Katagans,"},{"id":"semetey-1-2013:p0224:b003:l021","ordinal":93855,"en":"The warrior Shygai of the Zhedigers,"},{"id":"semetey-1-2013:p0224:b003:l022","ordinal":93856,"en":"The warrior Urbu, Eybit Khan's son,"},{"id":"semetey-1-2013:p0224:b003:l023","ordinal":93857,"en":"Bokmurun, Kokotoy's son,"},{"id":"semetey-1-2013:p0224:b003:l024","ordinal":93858,"en":"The fierce warriors and the old men—"},{"id":"semetey-1-2013:p0224:b003:l025","ordinal":93859,"en":"Who was left who had not seen it?"},{"id":"semetey-1-2013:p0224:b003:l026","ordinal":93860,"en":"The Sarts' four khans and their peoples"},{"id":"semetey-1-2013:p0224:b003:l027","ordinal":93861,"en":"Were all there then."},{"id":"semetey-1-2013:p0224:b003:l028","ordinal":93862,"en":"There were great men bearing maces,"},{"id":"semetey-1-2013:p0224:b003:l029","ordinal":93863,"en":"Many mighty champions together,"},{"id":"semetey-1-2013:p0224:b003:l030","ordinal":93864,"en":"The renowned elder Koshoi,"},{"id":"semetey-1-2013:p0224:b003:l031","ordinal":93865,"en":"All twelve great champions."},{"id":"semetey-1-2013:p0224:b003:l032","ordinal":93866,"en":"There were heroes and men of skill,"},{"id":"semetey-1-2013:p0224:b003:l033","ordinal":93867,"en":"Men greater than many champions."},{"id":"semetey-1-2013:p0224:b003:l034","ordinal":93868,"en":"Your brother-in-law Manas Khan"},{"id":"semetey-1-2013:p0224:b003:l035","ordinal":93869,"en":"Had settled in the land of Talas."},{"id":"semetey-1-2013:p0224:b003:l036","ordinal":93870,"en":"That handful of the Islamic faithful,"},{"id":"semetey-1-2013:p0224:b003:l037","ordinal":93871,"en":"To Kakanchyn's Beijing"},{"id":"semetey-1-2013:p0224:b003:l038","ordinal":93872,"en":"He drove them under escort."},{"id":"semetey-1-2013:p0224:b003:l039","ordinal":93873,"en":"Whoever placed him in the lead had luck:"},{"id":"semetey-1-2013:p0224:b004:l001","ordinal":93874,"en":"The resourceful elder Bakai was there."},{"id":"semetey-1-2013:p0224:b004:l002","ordinal":93875,"en":"Knowing sixty kinds of languages,"},{"id":"semetey-1-2013:p0224:b004:l003","ordinal":93876,"en":"The world's eloquent speaker,"},{"id":"semetey-1-2013:p0224:b004:l004","ordinal":93877,"en":"Azhybai, son of Argyn Khan,"},{"id":"semetey-1-2013:p0224:b004:l005","ordinal":93878,"en":"And the warrior Akzholtoi was there."},{"id":"semetey-1-2013:p0224:b004:l006","ordinal":93879,"en":"With your brother-in-law blessed by Khydyr,"},{"id":"semetey-1-2013:p0224:b004:l007","ordinal":93880,"en":"All the mighty men were gathered."},{"id":"semetey-1-2013:p0224:b004:l008","ordinal":93881,"en":"The Creator granted him honor;"},{"id":"semetey-1-2013:p0224:b004:l009","ordinal":93882,"en":"Such was your brother-in-law,"},{"id":"semetey-1-2013:p0224:b004:l010","ordinal":93883,"en":"Blessed by God with fortune."},{"id":"semetey-1-2013:p0224:b004:l011","ordinal":93884,"en":"Men skilled at swordplay were there,"},{"id":"semetey-1-2013:p0224:b004:l012","ordinal":93885,"en":"A great holy war that shattered multitudes,"},{"id":"semetey-1-2013:p0224:b004:l013","ordinal":93886,"en":"So many outstanding men were there."},{"id":"semetey-1-2013:p0224:b004:l014","ordinal":93887,"en":"There was a Buraq to ride in the rear,"},{"id":"semetey-1-2013:p0224:b004:l015","ordinal":93888,"en":"And not a hair less than Manas,"},{"id":"semetey-1-2013:p0224:b004:l016","ordinal":93889,"en":"Chubak, Akbaltai Khan's son, was there."},{"id":"semetey-1-2013:p0224:b004:l017","ordinal":93890,"en":"I carried on the ancient telling,"},{"id":"semetey-1-2013:p0224:b004:l018","ordinal":93891,"en":"I asked the knowledgeable men:"},{"id":"semetey-1-2013:p0224:b004:l019","ordinal":93892,"en":"Beyond the far side of Kashgar"},{"id":"semetey-1-2013:p0224:b004:l020","ordinal":93893,"en":"Was a land called Alai."},{"id":"semetey-1-2013:p0224:b004:l021","ordinal":93894,"en":"Settled in Alai"},{"id":"semetey-1-2013:p0224:b004:l022","ordinal":93895,"en":"Was a people named Oigut."},{"id":"semetey-1-2013:p0224:b004:l023","ordinal":93896,"en":"Of the dear Kyrgyz people of forty tribes,"},{"id":"semetey-1-2013:p0224:b004:l024","ordinal":93897,"en":"They were one of the precious branches."},{"id":"semetey-1-2013:p0224:b004:l025","ordinal":93898,"en":"Akbaltai, khan of the Oigut,"},{"id":"semetey-1-2013:p0224:b004:l026","ordinal":93899,"en":"Was a blessed khan."},{"id":"semetey-1-2013:p0224:b004:l027","ordinal":93900,"en":"In Akbaltai's household,"},{"id":"semetey-1-2013:p0224:b004:l028","ordinal":93901,"en":"For the sake of a single child,"},{"id":"semetey-1-2013:p0224:b004:l029","ordinal":93902,"en":"There were sixty wives."},{"id":"semetey-1-2013:p0224:b004:l030","ordinal":93903,"en":"His father Akbaltai"},{"id":"semetey-1-2013:p0224:b004:l031","ordinal":93904,"en":"Had taken sixty wives,"},{"id":"semetey-1-2013:p0224:b004:l032","ordinal":93905,"en":"Yet yearned for a single child,"},{"id":"semetey-1-2013:p0224:b004:l033","ordinal":93906,"en":"Left without an heir."},{"id":"semetey-1-2013:p0224:b004:l034","ordinal":93907,"en":"In his old age Akbaltai,"},{"id":"semetey-1-2013:p0224:b004:l035","ordinal":93908,"en":"For the sake of one offspring,"},{"id":"semetey-1-2013:p0224:b004:l036","ordinal":93909,"en":"Journeyed everywhere,"},{"id":"semetey-1-2013:p0224:b004:l037","ordinal":93910,"en":"Visiting every sacred tomb on earth,"},{"id":"semetey-1-2013:p0224:b004:l038","ordinal":93911,"en":"Leaving not a single one unseen,"},{"id":"semetey-1-2013:p0224:b004:l039","ordinal":93912,"en":"Giving horses to those without,"},{"id":"semetey-1-2013:p0225:b003:l001","ordinal":93913,"en":"Sparing none of his livestock,"},{"id":"semetey-1-2013:p0225:b003:l002","ordinal":93914,"en":"Akbaltai in those days"},{"id":"semetey-1-2013:p0225:b003:l003","ordinal":93915,"en":"Readily gave alms,"},{"id":"semetey-1-2013:p0225:b003:l004","ordinal":93916,"en":"Wandered in search of offspring,"},{"id":"semetey-1-2013:p0225:b003:l005","ordinal":93917,"en":"And implored the one God."},{"id":"semetey-1-2013:p0225:b003:l006","ordinal":93918,"en":"When God granted his wish,"},{"id":"semetey-1-2013:p0225:b003:l007","ordinal":93919,"en":"His father Akbaltai"},{"id":"semetey-1-2013:p0225:b003:l008","ordinal":93920,"en":"Had reached the age of seventy."},{"id":"semetey-1-2013:p0225:b003:l009","ordinal":93921,"en":"When the people moved to higher pastures,"},{"id":"semetey-1-2013:p0225:b003:l010","ordinal":93922,"en":"In summer, when horses' tongues turn black,"},{"id":"semetey-1-2013:p0225:b003:l011","ordinal":93923,"en":"Upon the ridge of Maseyil,"},{"id":"semetey-1-2013:p0225:b003:l012","ordinal":93924,"en":"On the nearer side of Bukhara,"},{"id":"semetey-1-2013:p0225:b003:l014","ordinal":93925,"en":"Wrapped in white felt,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0225:b003:l015","ordinal":93926,"en":"Chubak was the child he found."},{"id":"semetey-1-2013:p0225:b003:l016","ordinal":93927,"en":"He slaughtered ninety for the feast."},{"id":"semetey-1-2013:p0225:b003:l017","ordinal":93928,"en":"Having found him, Akbaltai"},{"id":"semetey-1-2013:p0225:b003:l018","ordinal":93929,"en":"Gave him the name of Chubak."},{"id":"semetey-1-2013:p0225:b003:l019","ordinal":93930,"en":"Saying, 'Such-and-such a wife bore him,'"},{"id":"semetey-1-2013:p0225:b003:l020","ordinal":93931,"en":"He drove all sorrow from his heart."},{"id":"semetey-1-2013:p0225:b003:l022","ordinal":93932,"en":"Before Chubak reached six,"},{"id":"semetey-1-2013:p0225:b003:l023","ordinal":93933,"en":"He spent his four kinds of livestock,"},{"id":"semetey-1-2013:p0225:b003:l024","ordinal":93934,"en":"Fervently begging Allah alone"},{"id":"semetey-1-2013:p0225:b003:l025","ordinal":93935,"en":"To make his life secure."},{"id":"semetey-1-2013:p0225:b003:l026","ordinal":93936,"en":"When he reached seven years,"},{"id":"semetey-1-2013:p0225:b003:l027","ordinal":93937,"en":"He saw he was a lion."},{"id":"semetey-1-2013:p0225:b003:l029","ordinal":93938,"en":"To Egypt and Baghdad","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0225:b003:l030","ordinal":93939,"en":"He entrusted him to a mullah."},{"id":"semetey-1-2013:p0225:b003:l031","ordinal":93940,"en":"By the time he reached eleven,"},{"id":"semetey-1-2013:p0225:b003:l032","ordinal":93941,"en":"He had studied learning with the mullah"},{"id":"semetey-1-2013:p0225:b003:l033","ordinal":93942,"en":"And received a written document from Kankozho."},{"id":"semetey-1-2013:p0225:b003:l034","ordinal":93943,"en":"When he reached twelve years,"},{"id":"semetey-1-2013:p0225:b003:l035","ordinal":93944,"en":"He took the caliph's blessing."},{"id":"semetey-1-2013:p0225:b003:l036","ordinal":93945,"en":"Thus the warrior Chubak"},{"id":"semetey-1-2013:p0225:b003:l037","ordinal":93946,"en":"Was named the mighty conquering champion."},{"id":"semetey-1-2013:p0225:b003:l038","ordinal":93947,"en":"He trotted like a lion"},{"id":"semetey-1-2013:p0225:b003:l039","ordinal":93948,"en":"And to his father Baltai's village"},{"id":"semetey-1-2013:p0225:b005:l001","ordinal":93949,"en":"He came at only twelve."},{"id":"semetey-1-2013:p0225:b005:l002","ordinal":93950,"en":"His father's countless dark herds,"},{"id":"semetey-1-2013:p0225:b005:l003","ordinal":93951,"en":"The long-tailed horses,"},{"id":"semetey-1-2013:p0225:b005:l004","ordinal":93952,"en":"He had led past in a file."}]
