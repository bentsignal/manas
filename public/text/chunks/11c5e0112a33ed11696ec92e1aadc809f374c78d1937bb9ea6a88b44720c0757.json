[{"id":"seytek-2012:p0037:b002:l004","ordinal":297985,"en":"Intent on bringing Chürök"},{"id":"seytek-2012:p0037:b002:l005","ordinal":297986,"en":"To some dreadful harm."},{"id":"seytek-2012:p0037:b002:l006","ordinal":297987,"en":"Once she knew their enmity,"},{"id":"seytek-2012:p0037:b002:l007","ordinal":297988,"en":"Moonlike Aichürök—"},{"id":"seytek-2012:p0037:b002:l008","ordinal":297989,"en":"Who could skim above a horse’s mane,"},{"id":"seytek-2012:p0037:b002:l009","ordinal":297990,"en":"Who could fly through the air,"},{"id":"seytek-2012:p0037:b002:l010","ordinal":297991,"en":"Who knew well how to fly—"},{"id":"seytek-2012:p0037:b002:l011","ordinal":297992,"en":"Would she fail to know an enemy?"},{"id":"seytek-2012:p0037:b002:l012","ordinal":297993,"en":"If she did, could she be Chürök!"},{"id":"seytek-2012:p0037:b002:l013","ordinal":297994,"en":"The keen-witted maid Karachach,"},{"id":"seytek-2012:p0037:b002:l014","ordinal":297995,"en":"The noble-born maid,"},{"id":"seytek-2012:p0037:b002:l015","ordinal":297996,"en":"When the wicked old women entered,"},{"id":"seytek-2012:p0037:b002:l016","ordinal":297997,"en":"Cast a chilling spell,"},{"id":"seytek-2012:p0037:b002:l017","ordinal":297998,"en":"And with boundless sorcery"},{"id":"seytek-2012:p0037:b002:l018","ordinal":297999,"en":"Blinded the eyes"},{"id":"seytek-2012:p0037:b002:l019","ordinal":298000,"en":"Of all seven old women."},{"id":"seytek-2012:p0037:b002:l020","ordinal":298001,"en":"The seven razors they had prepared"},{"id":"seytek-2012:p0037:b002:l021","ordinal":298002,"en":"Karachach secretly stole,"},{"id":"seytek-2012:p0037:b002:l022","ordinal":298003,"en":"And into a bottomless black well"},{"id":"seytek-2012:p0037:b002:l023","ordinal":298004,"en":"She carried and cast them:"},{"id":"seytek-2012:p0037:b002:l024","ordinal":298005,"en":"The instant the razors"},{"id":"seytek-2012:p0037:b002:l025","ordinal":298006,"en":"Struck the well,"},{"id":"seytek-2012:p0037:b002:l026","ordinal":298007,"en":"Unable to withstand their poison,"},{"id":"seytek-2012:p0037:b002:l027","ordinal":298008,"en":"The black stone beneath the water"},{"id":"seytek-2012:p0037:b002:l028","ordinal":298009,"en":"Split clean in two."},{"id":"seytek-2012:p0037:b002:l029","ordinal":298010,"en":"The old women wandered in a daze,"},{"id":"seytek-2012:p0037:b002:l030","ordinal":298011,"en":"Neither mad nor sane,"},{"id":"seytek-2012:p0037:b002:l031","ordinal":298012,"en":"And lost the razors"},{"id":"seytek-2012:p0037:b002:l032","ordinal":298013,"en":"The warrior had given them."},{"id":"seytek-2012:p0037:b002:l033","ordinal":298014,"en":"Yesterday, when they heaped humiliation upon us like sheep,"},{"id":"seytek-2012:p0037:b002:l034","ordinal":298015,"en":"When they plundered our royal camp,"},{"id":"seytek-2012:p0037:b002:l035","ordinal":298016,"en":"My valiant mother Kanykey"},{"id":"seytek-2012:p0037:b002:l036","ordinal":298017,"en":"Left this solemn charge: “Should you fail to guard him,"},{"id":"seytek-2012:p0037:b002:l037","ordinal":298018,"en":"Then to the enemy who counts us foes,"},{"id":"seytek-2012:p0037:b002:l038","ordinal":298019,"en":"When my foal is in desperate straits,"},{"id":"seytek-2012:p0037:b002:l039","ordinal":298020,"en":"Hand him over.”"},{"id":"seytek-2012:p0037:b002:l040","ordinal":298021,"en":"Yesterday, when havoc was wrought in Künjüt,"},{"id":"seytek-2012:p0037:b003:l001","ordinal":298022,"en":"Chürök proved a wise soul;"},{"id":"seytek-2012:p0037:b003:l002","ordinal":298023,"en":"She and Karachach"},{"id":"seytek-2012:p0037:b003:l003","ordinal":298024,"en":"Had made a pact."},{"id":"seytek-2012:p0037:b003:l004","ordinal":298025,"en":"How Kyyaz meant to bring disaster,"},{"id":"seytek-2012:p0037:b003:l005","ordinal":298026,"en":"And what the seven old women"},{"id":"seytek-2012:p0037:b003:l006","ordinal":298027,"en":"Had promised Kyyaz,"},{"id":"seytek-2012:p0037:b003:l007","ordinal":298028,"en":"Karachach had overheard."},{"id":"seytek-2012:p0037:b003:l008","ordinal":298029,"en":"Her knees buckling to the ground,"},{"id":"seytek-2012:p0037:b003:l009","ordinal":298030,"en":"She ran and reached Chürök,"},{"id":"seytek-2012:p0037:b003:l010","ordinal":298031,"en":"Who labored in birth,"},{"id":"seytek-2012:p0037:b003:l011","ordinal":298032,"en":"Her heart torn apart,"},{"id":"seytek-2012:p0037:b003:l012","ordinal":298033,"en":"Tears streaming from her eyes."},{"id":"seytek-2012:p0037:b003:l013","ordinal":298034,"en":"Before another word could be said,"},{"id":"seytek-2012:p0037:b003:l014","ordinal":298035,"en":"Karachach, flustered and frantic,"},{"id":"seytek-2012:p0037:b003:l015","ordinal":298036,"en":"Came to Aichürök:"},{"id":"seytek-2012:p0037:b003:l016","ordinal":298037,"en":"“My dearest elder sister,"},{"id":"seytek-2012:p0037:b003:l017","ordinal":298038,"en":"If only I see you safe, my heart will rest;"},{"id":"seytek-2012:p0037:b003:l018","ordinal":298039,"en":"I have no refuge but you."},{"id":"seytek-2012:p0037:b003:l019","ordinal":298040,"en":"Have you seen what I have seen?"},{"id":"seytek-2012:p0037:b003:l020","ordinal":298041,"en":"Do you know what I know?"},{"id":"seytek-2012:p0037:b003:l021","ordinal":298042,"en":"If you do not know what I know:"},{"id":"seytek-2012:p0037:b003:l022","ordinal":298043,"en":"Kyyaz, son of Bagysh—"},{"id":"seytek-2012:p0037:b003:l023","ordinal":298044,"en":"The Seven Valleys are no land for you,"},{"id":"seytek-2012:p0037:b003:l024","ordinal":298045,"en":"The Jediger are no people for you,"},{"id":"seytek-2012:p0037:b003:l025","ordinal":298046,"en":"And brave Kyyaz is no husband for you."},{"id":"seytek-2012:p0037:b003:l026","ordinal":298047,"en":"If you bear a son,"},{"id":"seytek-2012:p0037:b003:l027","ordinal":298048,"en":"All the old women have plotted"},{"id":"seytek-2012:p0037:b003:l028","ordinal":298049,"en":"To bewitch you, gouge out your eyes,"},{"id":"seytek-2012:p0037:b003:l029","ordinal":298050,"en":"Seize your child and slaughter him;"},{"id":"seytek-2012:p0037:b003:l030","ordinal":298051,"en":"They have sealed their pledge."},{"id":"seytek-2012:p0037:b003:l031","ordinal":298052,"en":"You were a lioness among women."},{"id":"seytek-2012:p0037:b003:l032","ordinal":298053,"en":"From wandering Almighty God,"},{"id":"seytek-2012:p0037:b003:l033","ordinal":298054,"en":"You were the one I prayed for."},{"id":"seytek-2012:p0037:b003:l034","ordinal":298055,"en":"Find a way to outwit"},{"id":"seytek-2012:p0037:b003:l035","ordinal":298056,"en":"The seven wicked old women, sister;"},{"id":"seytek-2012:p0037:b003:l036","ordinal":298057,"en":"Find the right words to answer"},{"id":"seytek-2012:p0037:b003:l037","ordinal":298058,"en":"The fierce infidel Kyyaz, sister!”"},{"id":"seytek-2012:p0037:b003:l038","ordinal":298059,"en":"Thus Karachach spoke,"},{"id":"seytek-2012:p0037:b003:l039","ordinal":298060,"en":"And before she had closed her mouth,"},{"id":"seytek-2012:p0037:b003:l040","ordinal":298061,"en":"The seven spell-casting old women—"},{"id":"seytek-2012:p0038:b002:l001","ordinal":298062,"en":"“All my flesh and bones"},{"id":"seytek-2012:p0038:b002:l002","ordinal":298063,"en":"Are about to burst apart."},{"id":"seytek-2012:p0038:b002:l003","ordinal":298064,"en":"Your hands bring healing to all they touch;"},{"id":"seytek-2012:p0038:b002:l004","ordinal":298065,"en":"You seven have come as holy women."},{"id":"seytek-2012:p0038:b002:l005","ordinal":298066,"en":"Lay hands upon the place that hurts,"},{"id":"seytek-2012:p0038:b002:l006","ordinal":298067,"en":"Mothers who master every remedy,"},{"id":"seytek-2012:p0038:b002:l007","ordinal":298068,"en":"Open my eyes, swollen like lumps of dough!”"},{"id":"seytek-2012:p0038:b002:l008","ordinal":298069,"en":"Thus Aichürök spoke"},{"id":"seytek-2012:p0038:b002:l009","ordinal":298070,"en":"And closed her mouth."},{"id":"seytek-2012:p0038:b002:l010","ordinal":298071,"en":"From the kumis mixed with poison,"},{"id":"seytek-2012:p0038:b002:l011","ordinal":298072,"en":"Seven bowls of kumis"},{"id":"seytek-2012:p0038:b002:l012","ordinal":298073,"en":"The deft and capable Karachach"},{"id":"seytek-2012:p0038:b002:l013","ordinal":298074,"en":"Poured for the old women."},{"id":"seytek-2012:p0038:b002:l014","ordinal":298075,"en":"Immeasurably nimble,"},{"id":"seytek-2012:p0038:b002:l015","ordinal":298076,"en":"The quick-moving poor girl"},{"id":"seytek-2012:p0038:b002:l016","ordinal":298077,"en":"Steeled herself like a hawk,"},{"id":"seytek-2012:p0038:b002:l017","ordinal":298078,"en":"Fawned upon the false old women,"},{"id":"seytek-2012:p0038:b002:l018","ordinal":298079,"en":"Measured poison by the ladle,"},{"id":"seytek-2012:p0038:b002:l019","ordinal":298080,"en":"And gave them water by the spoon."},{"id":"seytek-2012:p0038:b002:l020","ordinal":298081,"en":"She served all seven alike,"},{"id":"seytek-2012:p0038:b002:l021","ordinal":298082,"en":"Quickly, betraying no suspicion."},{"id":"seytek-2012:p0038:b002:l022","ordinal":298083,"en":"At dusk, as the sun went down"},{"id":"seytek-2012:p0038:b002:l023","ordinal":298084,"en":"And all the people lay sound asleep,"},{"id":"seytek-2012:p0038:b002:l024","ordinal":298085,"en":"She made every arrow ready in the quiver"},{"id":"seytek-2012:p0038:b002:l025","ordinal":298086,"en":"And sent the seven ill-fated old women"},{"id":"seytek-2012:p0038:b002:l026","ordinal":298087,"en":"Out of this world."},{"id":"seytek-2012:p0038:b002:l027","ordinal":298088,"en":"Beside the hearth"},{"id":"seytek-2012:p0038:b002:l028","ordinal":298089,"en":"She dug a pit,"},{"id":"seytek-2012:p0038:b002:l029","ordinal":298090,"en":"And the accomplished Aichürök"},{"id":"seytek-2012:p0038:b002:l030","ordinal":298091,"en":"Managed to slaughter all seven."},{"id":"seytek-2012:p0038:b002:l031","ordinal":298092,"en":"Folding them double at the waist,"},{"id":"seytek-2012:p0038:b002:l032","ordinal":298093,"en":"At the edge of the hearth"},{"id":"seytek-2012:p0038:b002:l033","ordinal":298094,"en":"She laid them in a hidden grave."},{"id":"seytek-2012:p0038:b002:l034","ordinal":298095,"en":"Without a single person knowing,"},{"id":"seytek-2012:p0038:b002:l035","ordinal":298096,"en":"Without anyone seeing,"},{"id":"seytek-2012:p0038:b002:l036","ordinal":298097,"en":"The seven witches died;"},{"id":"seytek-2012:p0038:b002:l037","ordinal":298098,"en":"The seven troublemakers went"},{"id":"seytek-2012:p0038:b002:l038","ordinal":298099,"en":"To the true abode from which none return."},{"id":"seytek-2012:p0038:b002:l039","ordinal":298100,"en":"Their seven lives were stilled,"},{"id":"seytek-2012:p0038:b002:l040","ordinal":298101,"en":"And the world was rid of all seven together."},{"id":"seytek-2012:p0038:b003:l001","ordinal":298102,"en":"When roaring leopard Manas"},{"id":"seytek-2012:p0038:b003:l002","ordinal":298103,"en":"Raided Künjüt long ago,"},{"id":"seytek-2012:p0038:b003:l003","ordinal":298104,"en":"This poison had brought merciless devastation;"},{"id":"seytek-2012:p0038:b003:l004","ordinal":298105,"en":"It was an evil that slaughtered men,"},{"id":"seytek-2012:p0038:b003:l005","ordinal":298106,"en":"A poison called “Soundless Death.”"},{"id":"seytek-2012:p0038:b003:l006","ordinal":298107,"en":"Whoever smelled it died;"},{"id":"seytek-2012:p0038:b003:l007","ordinal":298108,"en":"Whoever tasted it saw"},{"id":"seytek-2012:p0038:b003:l008","ordinal":298109,"en":"The true abode from which none return."},{"id":"seytek-2012:p0038:b003:l009","ordinal":298110,"en":"Its odor carried as far as men,"},{"id":"seytek-2012:p0038:b003:l010","ordinal":298111,"en":"And when anyone breathed it in,"},{"id":"seytek-2012:p0038:b003:l011","ordinal":298112,"en":"His gall would burst and he would die."},{"id":"seytek-2012:p0038:b003:l012","ordinal":298113,"en":"Whoever came within its scent perished;"},{"id":"seytek-2012:p0038:b003:l013","ordinal":298114,"en":"Any soul who came with evil intent"},{"id":"seytek-2012:p0038:b003:l014","ordinal":298115,"en":"Received his rightful punishment."},{"id":"seytek-2012:p0038:b003:l015","ordinal":298116,"en":"Aichürök, truly laboring in birth,"},{"id":"seytek-2012:p0038:b003:l016","ordinal":298117,"en":"Had poison ready,"},{"id":"seytek-2012:p0038:b003:l017","ordinal":298118,"en":"And meant to raise a terrible uproar"},{"id":"seytek-2012:p0038:b003:l018","ordinal":298119,"en":"Among the seven witching crones."},{"id":"seytek-2012:p0038:b003:l019","ordinal":298120,"en":"She ordered her maid:"},{"id":"seytek-2012:p0038:b003:l020","ordinal":298121,"en":"“Rise, Karachach, rise!"},{"id":"seytek-2012:p0038:b003:l021","ordinal":298122,"en":"These mothers have come thirsty;"},{"id":"seytek-2012:p0038:b003:l022","ordinal":298123,"en":"From the fresh golden kumis"},{"id":"seytek-2012:p0038:b003:l023","ordinal":298124,"en":"Pour some for your mothers."},{"id":"seytek-2012:p0038:b003:l024","ordinal":298125,"en":"Let their thirst be quenched,"},{"id":"seytek-2012:p0038:b003:l025","ordinal":298126,"en":"Let their swollen eyes open."},{"id":"seytek-2012:p0038:b003:l026","ordinal":298127,"en":"Hunger brings on illness,"},{"id":"seytek-2012:p0038:b003:l027","ordinal":298128,"en":"But a full belly restores good sense."},{"id":"seytek-2012:p0038:b003:l028","ordinal":298129,"en":"These mothers, healers of suffering,"},{"id":"seytek-2012:p0038:b003:l029","ordinal":298130,"en":"Bestow great blessings;"},{"id":"seytek-2012:p0038:b003:l030","ordinal":298131,"en":"From death and agony"},{"id":"seytek-2012:p0038:b003:l031","ordinal":298132,"en":"They wrench us free."},{"id":"seytek-2012:p0038:b003:l032","ordinal":298133,"en":"Their hands grasp the wrist and know their craft;"},{"id":"seytek-2012:p0038:b003:l033","ordinal":298134,"en":"They have two clear-seeing eyes,"},{"id":"seytek-2012:p0038:b003:l034","ordinal":298135,"en":"And speak true words when asked."},{"id":"seytek-2012:p0038:b003:l035","ordinal":298136,"en":"God creates the soul—"},{"id":"seytek-2012:p0038:b003:l036","ordinal":298137,"en":"You seven, find some remedy,"},{"id":"seytek-2012:p0038:b003:l037","ordinal":298138,"en":"For my soul is leaving me!"},{"id":"seytek-2012:p0038:b003:l038","ordinal":298139,"en":"My eyes stare dimly,"},{"id":"seytek-2012:p0038:b003:l039","ordinal":298140,"en":"My bones hang limp,"},{"id":"seytek-2012:p0038:b003:l040","ordinal":298141,"en":"And my fly-sized soul shrieks in pain.”"},{"id":"seytek-2012:p0039:b002:l001","ordinal":298142,"en":"“A falcon with talons of steel!”"},{"id":"seytek-2012:p0039:b002:l002","ordinal":298143,"en":"Overjoyed, Aichürök"},{"id":"seytek-2012:p0039:b002:l003","ordinal":298144,"en":"Throbbed with gratitude,"},{"id":"seytek-2012:p0039:b002:l004","ordinal":298145,"en":"And trembled with delight."},{"id":"seytek-2012:p0039:b002:l005","ordinal":298146,"en":"Wrapped in pure silk,"},{"id":"seytek-2012:p0039:b002:l006","ordinal":298147,"en":"Drenched entirely in blood,"},{"id":"seytek-2012:p0039:b002:l007","ordinal":298148,"en":"From the moment of birth this child"},{"id":"seytek-2012:p0039:b002:l008","ordinal":298149,"en":"Looked unlike any other:"},{"id":"seytek-2012:p0039:b002:l009","ordinal":298150,"en":"A black mane down his back"},{"id":"seytek-2012:p0039:b002:l010","ordinal":298151,"en":"Parted in two and streamed,"},{"id":"seytek-2012:p0039:b002:l011","ordinal":298152,"en":"And he looked exactly like"},{"id":"seytek-2012:p0039:b002:l012","ordinal":298153,"en":"His mighty gray-wolf lion of a father."},{"id":"seytek-2012:p0039:b002:l013","ordinal":298154,"en":"“His lashes are flame, his eyes live coals;"},{"id":"seytek-2012:p0039:b002:l014","ordinal":298155,"en":"No child like him was ever born."},{"id":"seytek-2012:p0039:b002:l015","ordinal":298156,"en":"Broad-browed and wide-shouldered,"},{"id":"seytek-2012:p0039:b002:l016","ordinal":298157,"en":"With tender lips and overhanging brows—"},{"id":"seytek-2012:p0039:b002:l017","ordinal":298158,"en":"Look closely at him from every side!"},{"id":"seytek-2012:p0039:b002:l018","ordinal":298159,"en":"His nose is so like his father’s nose,"},{"id":"seytek-2012:p0039:b002:l019","ordinal":298160,"en":"As though one had been molded from the other;"},{"id":"seytek-2012:p0039:b002:l020","ordinal":298161,"en":"His ears are like his father’s ears—"},{"id":"seytek-2012:p0039:b002:l021","ordinal":298162,"en":"The very image of that gray-wolf hero."},{"id":"seytek-2012:p0039:b002:l022","ordinal":298163,"en":"His black eyes gaze"},{"id":"seytek-2012:p0039:b002:l023","ordinal":298164,"en":"Exactly like the true prince’s own;"},{"id":"seytek-2012:p0039:b002:l024","ordinal":298165,"en":"Indeed, they are the measured black eyes"},{"id":"seytek-2012:p0039:b002:l025","ordinal":298166,"en":"Of the hero himself,"},{"id":"seytek-2012:p0039:b002:l026","ordinal":298167,"en":"The very eyes of the leopard."},{"id":"seytek-2012:p0039:b002:l027","ordinal":298168,"en":"It is as though one likeness were taken from another;"},{"id":"seytek-2012:p0039:b002:l028","ordinal":298169,"en":"Souls are born in many forms,"},{"id":"seytek-2012:p0039:b002:l029","ordinal":298170,"en":"But his stare seems to set the heart ablaze,"},{"id":"seytek-2012:p0039:b002:l030","ordinal":298171,"en":"And seeing him quenches every longing."},{"id":"seytek-2012:p0039:b002:l031","ordinal":298172,"en":"He seems to have fallen straight"},{"id":"seytek-2012:p0039:b002:l032","ordinal":298173,"en":"From the mouth of the leopard-gray-wolf hero."},{"id":"seytek-2012:p0039:b002:l033","ordinal":298174,"en":"If my daily grief should vanish,"},{"id":"seytek-2012:p0039:b002:l034","ordinal":298175,"en":"If he survives and grows,"},{"id":"seytek-2012:p0039:b002:l035","ordinal":298176,"en":"If he matures and becomes a warrior,"},{"id":"seytek-2012:p0039:b002:l036","ordinal":298177,"en":"Standing equal with warriors’ sons,"},{"id":"seytek-2012:p0039:b002:l037","ordinal":298178,"en":"If, though orphaned, he comes of age"},{"id":"seytek-2012:p0039:b002:l038","ordinal":298179,"en":"And somehow rejoins his people,"},{"id":"seytek-2012:p0039:b002:l039","ordinal":298180,"en":"Will he find his homeland—"},{"id":"seytek-2012:p0039:b002:l040","ordinal":298181,"en":"Reedy Кең-Köl and broad Talas?”"},{"id":"seytek-2012:p0039:b003:l001","ordinal":298182,"en":"Brave Kyyaz of the Jediger"},{"id":"seytek-2012:p0039:b003:l002","ordinal":298183,"en":"Lay there sunk in worry—"},{"id":"seytek-2012:p0039:b003:l003","ordinal":298184,"en":"Do you see what happened?"},{"id":"seytek-2012:p0039:b003:l004","ordinal":298185,"en":"When the constellation Taraza sank"},{"id":"seytek-2012:p0039:b003:l005","ordinal":298186,"en":"And dawn broke,"},{"id":"seytek-2012:p0039:b003:l006","ordinal":298187,"en":"The fierce woman’s labor ended;"},{"id":"seytek-2012:p0039:b003:l007","ordinal":298188,"en":"With the Morning Star overhead,"},{"id":"seytek-2012:p0039:b003:l008","ordinal":298189,"en":"She gave birth beneath a sign."},{"id":"seytek-2012:p0039:b003:l009","ordinal":298190,"en":"When her child was born,"},{"id":"seytek-2012:p0039:b003:l010","ordinal":298191,"en":"Look at the omen that appeared:"},{"id":"seytek-2012:p0039:b003:l011","ordinal":298192,"en":"The Sun rose from his right brow,"},{"id":"seytek-2012:p0039:b003:l012","ordinal":298193,"en":"The Moon rose from his left,"},{"id":"seytek-2012:p0039:b003:l013","ordinal":298194,"en":"And the two came into conjunction,"},{"id":"seytek-2012:p0039:b003:l014","ordinal":298195,"en":"Becoming his sign."},{"id":"seytek-2012:p0039:b003:l015","ordinal":298196,"en":"Moonlike Aichürök"},{"id":"seytek-2012:p0039:b003:l016","ordinal":298197,"en":"Had given birth to a son."},{"id":"seytek-2012:p0039:b003:l017","ordinal":298198,"en":"See how the child surpassed"},{"id":"seytek-2012:p0039:b003:l018","ordinal":298199,"en":"Even his father!"},{"id":"seytek-2012:p0039:b003:l019","ordinal":298200,"en":"If this child lives,"},{"id":"seytek-2012:p0039:b003:l020","ordinal":298201,"en":"They will call him God’s beloved servant,"},{"id":"seytek-2012:p0039:b003:l021","ordinal":298202,"en":"The son of the noble gray wolf,"},{"id":"seytek-2012:p0039:b003:l022","ordinal":298203,"en":"A brave youth left by the champion"},{"id":"seytek-2012:p0039:b003:l023","ordinal":298204,"en":"Of the famed mountain springs,"},{"id":"seytek-2012:p0039:b003:l024","ordinal":298205,"en":"A source of strength left by the dear departed,"},{"id":"seytek-2012:p0039:b003:l025","ordinal":298206,"en":"A talisman left by the hero,"},{"id":"seytek-2012:p0039:b003:l026","ordinal":298207,"en":"A plane tree sprung from the place"},{"id":"seytek-2012:p0039:b003:l027","ordinal":298208,"en":"Of the mighty gray-wolf warrior."},{"id":"seytek-2012:p0039:b003:l028","ordinal":298209,"en":"Souls will seek refuge beneath that plane tree,"},{"id":"seytek-2012:p0039:b003:l029","ordinal":298210,"en":"If only he lives to stand."},{"id":"seytek-2012:p0039:b003:l030","ordinal":298211,"en":"To all who behold him,"},{"id":"seytek-2012:p0039:b003:l031","ordinal":298212,"en":"He will be a banner planted before them,"},{"id":"seytek-2012:p0039:b003:l032","ordinal":298213,"en":"A gift left by the hero,"},{"id":"seytek-2012:p0039:b003:l033","ordinal":298214,"en":"The hoofprint left by a noble steed,"},{"id":"seytek-2012:p0039:b003:l034","ordinal":298215,"en":"A brave heir to the ancestral treasure,"},{"id":"seytek-2012:p0039:b003:l035","ordinal":298216,"en":"My golden palace on the uplands,"},{"id":"seytek-2012:p0039:b003:l036","ordinal":298217,"en":"A fortress left to me as a gift"},{"id":"seytek-2012:p0039:b003:l037","ordinal":298218,"en":"By the lord who died far from home,"},{"id":"seytek-2012:p0039:b003:l038","ordinal":298219,"en":"A golden-hoofed steed"},{"id":"seytek-2012:p0039:b003:l039","ordinal":298220,"en":"Who races untiring across the desert,"},{"id":"seytek-2012:p0039:b003:l040","ordinal":298221,"en":"Who plunges through the lake to seize the swan—"},{"id":"seytek-2012:p0040:b002:l001","ordinal":298222,"en":"Let me pray for glad tidings;"},{"id":"seytek-2012:p0040:b002:l002","ordinal":298223,"en":"With no brother-in-law to fight for me,"},{"id":"seytek-2012:p0040:b002:l003","ordinal":298224,"en":"I have been unable to avenge my dead."},{"id":"seytek-2012:p0040:b002:l004","ordinal":298225,"en":"If the Almighty created him with a living soul,"},{"id":"seytek-2012:p0040:b002:l005","ordinal":298226,"en":"Hear my lament well!"},{"id":"seytek-2012:p0040:b002:l006","ordinal":298227,"en":"My gift left by my companion,"},{"id":"seytek-2012:p0040:b002:l007","ordinal":298228,"en":"My treasure left by the dear departed—"},{"id":"seytek-2012:p0040:b002:l008","ordinal":298229,"en":"If he grows up safe and sound,"},{"id":"seytek-2012:p0040:b002:l009","ordinal":298230,"en":"How shall I pursue my blood-debt?"},{"id":"seytek-2012:p0040:b002:l010","ordinal":298231,"en":"When the homeland’s wing has grown strong,"},{"id":"seytek-2012:p0040:b002:l011","ordinal":298232,"en":"I shall overtake and halt my wandering caravan;"},{"id":"seytek-2012:p0040:b002:l012","ordinal":298233,"en":"May God let me take revenge"},{"id":"seytek-2012:p0040:b002:l013","ordinal":298234,"en":"Upon the witless villains!"},{"id":"seytek-2012:p0040:b002:l014","ordinal":298235,"en":"My blood-price taken as plunder—"},{"id":"seytek-2012:p0040:b002:l015","ordinal":298236,"en":"If He lets this sorrow of mine live,"},{"id":"seytek-2012:p0040:b002:l016","ordinal":298237,"en":"If the Almighty preserves"},{"id":"seytek-2012:p0040:b002:l017","ordinal":298238,"en":"My brother-in-law among the herds and my son,"},{"id":"seytek-2012:p0040:b002:l018","ordinal":298239,"en":"If those two, safe and sound,"},{"id":"seytek-2012:p0040:b002:l019","ordinal":298240,"en":"One day mingle together"}]
