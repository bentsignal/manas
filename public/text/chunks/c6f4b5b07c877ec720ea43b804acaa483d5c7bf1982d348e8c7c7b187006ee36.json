[{"id":"semetey-1-2013:p0792:b004:l016","ordinal":136961,"en":"His father, gone to the other world,"},{"id":"semetey-1-2013:p0792:b004:l017","ordinal":136962,"en":"Seemed to have risen from the dead."},{"id":"semetey-1-2013:p0792:b004:l018","ordinal":136963,"en":"His fierce elder Bakai,"},{"id":"semetey-1-2013:p0792:b004:l019","ordinal":136964,"en":"The old man who had seen much—"},{"id":"semetey-1-2013:p0792:b004:l020","ordinal":136965,"en":"See his readiness!"},{"id":"semetey-1-2013:p0792:b004:l021","ordinal":136966,"en":"Of your sage elder Bakai,"},{"id":"semetey-1-2013:p0792:b004:l022","ordinal":136967,"en":"See the resourcefulness!"},{"id":"semetey-1-2013:p0792:b004:l023","ordinal":136968,"en":"Without many words, without speaking,"},{"id":"semetey-1-2013:p0792:b004:l024","ordinal":136969,"en":"The old caravan-leader Bakai,"},{"id":"semetey-1-2013:p0792:b004:l025","ordinal":136970,"en":"The sage who had seen so much,"},{"id":"semetey-1-2013:p0792:b004:l026","ordinal":136971,"en":"From his belt-pouch"},{"id":"semetey-1-2013:p0792:b004:l027","ordinal":136972,"en":"Your elder took a cord."},{"id":"semetey-1-2013:p0792:b004:l028","ordinal":136973,"en":"It was a cord plaited of silk;"},{"id":"semetey-1-2013:p0792:b004:l029","ordinal":136974,"en":"He fastened it to Akshumkar."},{"id":"semetey-1-2013:p0792:b004:l030","ordinal":136975,"en":"While Bakai was doing this,"},{"id":"semetey-1-2013:p0792:b004:l031","ordinal":136976,"en":"That brave son of Manas said:"},{"id":"semetey-1-2013:p0792:b004:l032","ordinal":136977,"en":"‘Since God Most High has granted this,"},{"id":"semetey-1-2013:p0792:b004:l033","ordinal":136978,"en":"Since Akshumkar has come from his hidden realm,"},{"id":"semetey-1-2013:p0792:b004:l034","ordinal":136979,"en":"Bringing his young one,"},{"id":"semetey-1-2013:p0792:b004:l035","ordinal":136980,"en":"How can we hold anything back?"},{"id":"semetey-1-2013:p0792:b004:l036","ordinal":136981,"en":"My father, who went to the other world—"},{"id":"semetey-1-2013:p0792:b004:l037","ordinal":136982,"en":"Dedicating it to his spirit,"},{"id":"semetey-1-2013:p0792:b004:l038","ordinal":136983,"en":"Let us dedicate Aktulpar as a sacrifice.’"},{"id":"semetey-1-2013:p0792:b004:l039","ordinal":136984,"en":"When he mentioned Aktulpar,"},{"id":"semetey-1-2013:p0793:b003:l001","ordinal":136985,"en":"As though pierced by an awl,"},{"id":"semetey-1-2013:p0793:b003:l002","ordinal":136986,"en":"Brave Bakai sprang up:"},{"id":"semetey-1-2013:p0793:b003:l003","ordinal":136987,"en":"‘Alas, orphan, heed me!"},{"id":"semetey-1-2013:p0793:b003:l004","ordinal":136988,"en":"If you do not, it will be a disgrace."},{"id":"semetey-1-2013:p0793:b003:l005","ordinal":136989,"en":"Out of fear, your grandfather"},{"id":"semetey-1-2013:p0793:b003:l006","ordinal":136990,"en":"Entrusted Aktulpar to you."},{"id":"semetey-1-2013:p0793:b003:l007","ordinal":136991,"en":"If we slaughter the horse entrusted to us,"},{"id":"semetey-1-2013:p0793:b003:l008","ordinal":136992,"en":"If we put him to death,"},{"id":"semetey-1-2013:p0793:b003:l009","ordinal":136993,"en":"How can we prosper?"},{"id":"semetey-1-2013:p0793:b003:l010","ordinal":136994,"en":"We shall be a laughingstock to the people."},{"id":"semetey-1-2013:p0793:b003:l011","ordinal":136995,"en":"Your grandfather Temirkan"},{"id":"semetey-1-2013:p0793:b003:l012","ordinal":136996,"en":"Bears the name of father;"},{"id":"semetey-1-2013:p0793:b003:l013","ordinal":136997,"en":"Once we slaughter his horse,"},{"id":"semetey-1-2013:p0793:b003:l014","ordinal":136998,"en":"He may curse us."},{"id":"semetey-1-2013:p0793:b003:l015","ordinal":136999,"en":"Once you slaughter his horse,"},{"id":"semetey-1-2013:p0793:b003:l016","ordinal":137000,"en":"It will be a great shame.’"},{"id":"semetey-1-2013:p0793:b003:l017","ordinal":137001,"en":"Then Bakai said:"},{"id":"semetey-1-2013:p0793:b003:l018","ordinal":137002,"en":"‘Let me tell the story of this Aktulpar."},{"id":"semetey-1-2013:p0793:b003:l019","ordinal":137003,"en":"Your grandfather Temirkan,"},{"id":"semetey-1-2013:p0793:b003:l020","ordinal":137004,"en":"Who ruled Bukhara,"},{"id":"semetey-1-2013:p0793:b003:l021","ordinal":137005,"en":"Was a famous, splendid khan,"},{"id":"semetey-1-2013:p0793:b003:l022","ordinal":137006,"en":"But he was miserly with livestock."},{"id":"semetey-1-2013:p0793:b003:l023","ordinal":137007,"en":"Born to your elder,"},{"id":"semetey-1-2013:p0793:b003:l024","ordinal":137008,"en":"Beginning with your mother Kanykei,"},{"id":"semetey-1-2013:p0793:b003:l025","ordinal":137009,"en":"There were twelve daughters."},{"id":"semetey-1-2013:p0793:b003:l026","ordinal":137010,"en":"Among all the people"},{"id":"semetey-1-2013:p0793:b003:l027","ordinal":137011,"en":"He had spread his offspring."},{"id":"semetey-1-2013:p0793:b003:l028","ordinal":137012,"en":"The eldest of his daughters,"},{"id":"semetey-1-2013:p0793:b003:l030","ordinal":137013,"en":"With a waist like a sheath, a face like the moon,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0793:b003:l031","ordinal":137014,"en":"The renowned beauty Akerkech"},{"id":"semetey-1-2013:p0793:b003:l032","ordinal":137015,"en":"Was Kökchö's wife."},{"id":"semetey-1-2013:p0793:b003:l033","ordinal":137016,"en":"She was the finest of women,"},{"id":"semetey-1-2013:p0793:b003:l034","ordinal":137017,"en":"Temirkan's firstborn daughter."},{"id":"semetey-1-2013:p0793:b003:l036","ordinal":137018,"en":"Bringing eighty breeding she-camels,"},{"id":"semetey-1-2013:p0793:b003:l037","ordinal":137019,"en":"Akerkech once pleaded in distress"},{"id":"semetey-1-2013:p0793:b003:l038","ordinal":137020,"en":"And asked for Aktulpar."},{"id":"semetey-1-2013:p0793:b003:l039","ordinal":137021,"en":"He would not give Aktulpar;"},{"id":"semetey-1-2013:p0793:b005:l001","ordinal":137022,"en":"He would not consent to her request."},{"id":"semetey-1-2013:p0793:b005:l002","ordinal":137023,"en":"Because of Aktulpar,"},{"id":"semetey-1-2013:p0793:b005:l003","ordinal":137024,"en":"That daughter went away and became estranged."},{"id":"semetey-1-2013:p0793:b005:l004","ordinal":137025,"en":"Burulkan, whom Muzburchak married,"},{"id":"semetey-1-2013:p0793:b005:l005","ordinal":137026,"en":"Was also his daughter."},{"id":"semetey-1-2013:p0793:b005:l006","ordinal":137027,"en":"Because of what happened,"},{"id":"semetey-1-2013:p0793:b005:l007","ordinal":137028,"en":"Over the matter of Aktulpar,"},{"id":"semetey-1-2013:p0793:b005:l008","ordinal":137029,"en":"That daughter too went away and became estranged."},{"id":"semetey-1-2013:p0793:b005:l009","ordinal":137030,"en":"Ormonbek of Tekeche,"},{"id":"semetey-1-2013:p0793:b005:l010","ordinal":137031,"en":"And Oiumkan, whom Ormonbek married—"},{"id":"semetey-1-2013:p0793:b005:l011","ordinal":137032,"en":"Ormonbek was his son-in-law."},{"id":"semetey-1-2013:p0793:b005:l012","ordinal":137033,"en":"Temirkan had thus stood in the way;"},{"id":"semetey-1-2013:p0793:b005:l013","ordinal":137034,"en":"Because of Aktulpar,"},{"id":"semetey-1-2013:p0793:b005:l014","ordinal":137035,"en":"That son-in-law became estranged."},{"id":"semetey-1-2013:p0793:b005:l015","ordinal":137036,"en":"Stop, orphan, hear my words."},{"id":"semetey-1-2013:p0793:b005:l017","ordinal":137037,"en":"Because of Aktulpar,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0793:b005:l018","ordinal":137038,"en":"Against that very Temirkan"},{"id":"semetey-1-2013:p0793:b005:l019","ordinal":137039,"en":"Twelve sons-in-law made war."},{"id":"semetey-1-2013:p0793:b005:l020","ordinal":137040,"en":"They parted in resentment."},{"id":"semetey-1-2013:p0793:b005:l021","ordinal":137041,"en":"They died without looking upon one another."},{"id":"semetey-1-2013:p0793:b005:l022","ordinal":137042,"en":"When your khan father was alive,"},{"id":"semetey-1-2013:p0793:b005:l023","ordinal":137043,"en":"When prosperity endured,"},{"id":"semetey-1-2013:p0793:b005:l024","ordinal":137044,"en":"We heard a rumor from the people:"},{"id":"semetey-1-2013:p0793:b005:l025","ordinal":137045,"en":"The golden-forelocked, fiery-belted"},{"id":"semetey-1-2013:p0793:b005:l026","ordinal":137046,"en":"Only son of Khan Azozil,"},{"id":"semetey-1-2013:p0793:b005:l027","ordinal":137047,"en":"For the sake of his faith,"},{"id":"semetey-1-2013:p0793:b005:l028","ordinal":137048,"en":"Had fled his people and wandered;"},{"id":"semetey-1-2013:p0793:b005:l029","ordinal":137049,"en":"He had disputed the khanship in Beijing,"},{"id":"semetey-1-2013:p0793:b005:l030","ordinal":137050,"en":"They had fiercely pitted strength against strength."},{"id":"semetey-1-2013:p0793:b005:l031","ordinal":137051,"en":"Many Chinese giants had died,"},{"id":"semetey-1-2013:p0793:b005:l032","ordinal":137052,"en":"They had shed blood."},{"id":"semetey-1-2013:p0793:b005:l035","ordinal":137053,"en":"To Kakan Chin’s Beijing,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0793:b005:l036","ordinal":137054,"en":"We heard he had brought turmoil."},{"id":"semetey-1-2013:p0793:b005:l037","ordinal":137055,"en":"Having strayed thus from his people,"},{"id":"semetey-1-2013:p0793:b005:l038","ordinal":137056,"en":"We quarreled fiercely:"},{"id":"semetey-1-2013:p0793:b005:l039","ordinal":137057,"en":"“There is no one who understands this of mine,"},{"id":"semetey-1-2013:p0794:b003:l001","ordinal":137058,"en":"Why should I remain here?” he said."},{"id":"semetey-1-2013:p0794:b003:l002","ordinal":137059,"en":"“I shall go among the Burut,” he said."},{"id":"semetey-1-2013:p0794:b003:l003","ordinal":137060,"en":"He killed his own father,"},{"id":"semetey-1-2013:p0794:b003:l004","ordinal":137061,"en":"His mother passed away a martyr."},{"id":"semetey-1-2013:p0794:b003:l005","ordinal":137062,"en":"We heard that, turning away from China,"},{"id":"semetey-1-2013:p0794:b003:l006","ordinal":137063,"en":"He entered Khangai."},{"id":"semetey-1-2013:p0794:b003:l007","ordinal":137064,"en":"Unable to gain a foothold in Khangai,"},{"id":"semetey-1-2013:p0794:b003:l008","ordinal":137065,"en":"He slaughtered and destroyed its khans;"},{"id":"semetey-1-2013:p0794:b003:l009","ordinal":137066,"en":"We heard he came out again."},{"id":"semetey-1-2013:p0794:b003:l010","ordinal":137067,"en":"From there, driven onward,"},{"id":"semetey-1-2013:p0794:b003:l011","ordinal":137068,"en":"We heard he came to Altai."},{"id":"semetey-1-2013:p0794:b003:l012","ordinal":137069,"en":"Unable to find room in Altai,"},{"id":"semetey-1-2013:p0794:b003:l013","ordinal":137070,"en":"He killed Khan Artyk;"},{"id":"semetey-1-2013:p0794:b003:l014","ordinal":137071,"en":"We heard he came to Sary-Arka."},{"id":"semetey-1-2013:p0794:b003:l015","ordinal":137072,"en":"When he reached Kökchö in Sary-Arka"},{"id":"semetey-1-2013:p0794:b003:l016","ordinal":137073,"en":"And settled beside his camp,"},{"id":"semetey-1-2013:p0794:b003:l017","ordinal":137074,"en":"Because of what had happened,"},{"id":"semetey-1-2013:p0794:b003:l018","ordinal":137075,"en":"Because of Akerkech,"},{"id":"semetey-1-2013:p0794:b003:l019","ordinal":137076,"en":"Kökchö, the son of Aidarkan,"},{"id":"semetey-1-2013:p0794:b003:l020","ordinal":137077,"en":"We heard he beat him and departed."},{"id":"semetey-1-2013:p0794:b003:l021","ordinal":137078,"en":"Disappointed in Kökchö,"},{"id":"semetey-1-2013:p0794:b003:l022","ordinal":137079,"en":"He moved to Talas,"},{"id":"semetey-1-2013:p0794:b003:l023","ordinal":137080,"en":"Settled there and became a friend"},{"id":"semetey-1-2013:p0794:b003:l024","ordinal":137081,"en":"To your father, Sultan Manas."},{"id":"semetey-1-2013:p0794:b003:l025","ordinal":137082,"en":"Your lion father Manas—"},{"id":"semetey-1-2013:p0794:b003:l026","ordinal":137083,"en":"When God granted his desire,"},{"id":"semetey-1-2013:p0794:b003:l027","ordinal":137084,"en":"When Almam came from China,"},{"id":"semetey-1-2013:p0794:b003:l028","ordinal":137085,"en":"Ajybai and Khan Bakai were there,"},{"id":"semetey-1-2013:p0794:b003:l029","ordinal":137086,"en":"All the wise warriors were there."},{"id":"semetey-1-2013:p0794:b003:l030","ordinal":137087,"en":"To the lion who has come from afar,"},{"id":"semetey-1-2013:p0794:b003:l031","ordinal":137088,"en":"If we do not allot a horse,"},{"id":"semetey-1-2013:p0794:b003:l032","ordinal":137089,"en":"God will punish us severely,” we said,"},{"id":"semetey-1-2013:p0794:b003:l033","ordinal":137090,"en":"“Everyone will gossip,” we said."},{"id":"semetey-1-2013:p0794:b003:l034","ordinal":137091,"en":"We pondered and turned the matter over,"},{"id":"semetey-1-2013:p0794:b003:l035","ordinal":137092,"en":"Loaded wealth upon eighty camels,"},{"id":"semetey-1-2013:p0794:b003:l036","ordinal":137093,"en":"And said, “Go and ask for Aktulpar.”"},{"id":"semetey-1-2013:p0794:b003:l037","ordinal":137094,"en":"Your mother Kanykei"},{"id":"semetey-1-2013:p0794:b003:l038","ordinal":137095,"en":"We then sent to visit her parents."},{"id":"semetey-1-2013:p0794:b003:l039","ordinal":137096,"en":"At that time my dear child Kanykei,"},{"id":"semetey-1-2013:p0794:b004:l001","ordinal":137097,"en":"The loveliest of the dark-complexioned,"},{"id":"semetey-1-2013:p0794:b004:l002","ordinal":137098,"en":"The most radiant of the Muslims,"},{"id":"semetey-1-2013:p0794:b004:l003","ordinal":137099,"en":"Was a young wife of seventeen,"},{"id":"semetey-1-2013:p0794:b004:l004","ordinal":137100,"en":"And a servant beloved by God,"},{"id":"semetey-1-2013:p0794:b004:l005","ordinal":137101,"en":"The youngest of twelve daughters."},{"id":"semetey-1-2013:p0794:b004:l006","ordinal":137102,"en":"Her hair was braided down her back;"},{"id":"semetey-1-2013:p0794:b004:l007","ordinal":137103,"en":"More than all sixty sons"},{"id":"semetey-1-2013:p0794:b004:l008","ordinal":137104,"en":"He loved her."},{"id":"semetey-1-2013:p0794:b004:l009","ordinal":137105,"en":"Kanykei, the lord's wife,"},{"id":"semetey-1-2013:p0794:b004:l010","ordinal":137106,"en":"Went to visit her parents."},{"id":"semetey-1-2013:p0794:b004:l011","ordinal":137107,"en":"The wealth of eighty camels,"},{"id":"semetey-1-2013:p0794:b004:l012","ordinal":137108,"en":"Temirkan gathered it all"},{"id":"semetey-1-2013:p0794:b004:l013","ordinal":137109,"en":"And placed it in his treasury."},{"id":"semetey-1-2013:p0794:b004:l014","ordinal":137110,"en":"He would not agree to her request,"},{"id":"semetey-1-2013:p0794:b004:l015","ordinal":137111,"en":"Would not give Aktulpar."},{"id":"semetey-1-2013:p0794:b004:l016","ordinal":137112,"en":"Leaving her to whine like a howling dog,"},{"id":"semetey-1-2013:p0794:b004:l017","ordinal":137113,"en":"He sent your mother away empty-handed and dejected."},{"id":"semetey-1-2013:p0794:b004:l018","ordinal":137114,"en":"Your fierce father, Khan Manas, said:"},{"id":"semetey-1-2013:p0794:b004:l019","ordinal":137115,"en":"“That wretched shrew will never mend!"},{"id":"semetey-1-2013:p0794:b004:l020","ordinal":137116,"en":"When she is sent to visit her parents,"},{"id":"semetey-1-2013:p0794:b004:l021","ordinal":137117,"en":"She is not worth one of her father's yearlings!”"},{"id":"semetey-1-2013:p0794:b004:l023","ordinal":137118,"en":"Then he brought great sorrow upon her,"},{"id":"semetey-1-2013:p0794:b004:l024","ordinal":137119,"en":"He would not lie in her embrace."},{"id":"semetey-1-2013:p0794:b004:l025","ordinal":137120,"en":"She camped along the river,"},{"id":"semetey-1-2013:p0794:b004:l026","ordinal":137121,"en":"And was a neglected wife for six months."},{"id":"semetey-1-2013:p0794:b004:l027","ordinal":137122,"en":"Your mother Kanykei has her story:"},{"id":"semetey-1-2013:p0794:b004:l028","ordinal":137123,"en":"She ceased calling Temir father"},{"id":"semetey-1-2013:p0794:b004:l029","ordinal":137124,"en":"And became estranged from him."},{"id":"semetey-1-2013:p0794:b004:l030","ordinal":137125,"en":"Do not spoil what can be settled."},{"id":"semetey-1-2013:p0794:b004:l031","ordinal":137126,"en":"If you are a worthy person, my orphan,"},{"id":"semetey-1-2013:p0794:b004:l032","ordinal":137127,"en":"Do not destroy Aktulpar."},{"id":"semetey-1-2013:p0794:b004:l033","ordinal":137128,"en":"He was a khan struck by God,"},{"id":"semetey-1-2013:p0794:b004:l034","ordinal":137129,"en":"A man miserly with livestock."},{"id":"semetey-1-2013:p0794:b004:l035","ordinal":137130,"en":"Please heed what I say,"},{"id":"semetey-1-2013:p0794:b004:l036","ordinal":137131,"en":"My dear orphan;"},{"id":"semetey-1-2013:p0794:b004:l037","ordinal":137132,"en":"Take Aktulpar back"},{"id":"semetey-1-2013:p0794:b004:l038","ordinal":137133,"en":"And return him safe and sound."},{"id":"semetey-1-2013:p0794:b004:l039","ordinal":137134,"en":"Neither drawing close nor making enemies,"},{"id":"semetey-1-2013:p0795:b003:l001","ordinal":137135,"en":"Bring this joy to him."},{"id":"semetey-1-2013:p0795:b003:l002","ordinal":137136,"en":"Your grandfather’s blessing—"},{"id":"semetey-1-2013:p0795:b003:l003","ordinal":137137,"en":"Ask well and receive it."},{"id":"semetey-1-2013:p0795:b003:l004","ordinal":137138,"en":"Go safely and return soon;"},{"id":"semetey-1-2013:p0795:b003:l005","ordinal":137139,"en":"Go without delay and return happy."},{"id":"semetey-1-2013:p0795:b003:l006","ordinal":137140,"en":"The swift Narbuudan is beneath you;"},{"id":"semetey-1-2013:p0795:b003:l007","ordinal":137141,"en":"Rein him in on stony ground."},{"id":"semetey-1-2013:p0795:b003:l008","ordinal":137142,"en":"To your poor widowed mother,"},{"id":"semetey-1-2013:p0795:b003:l009","ordinal":137143,"en":"Say, “I have seen the accomplished Khan Bakai,”"},{"id":"semetey-1-2013:p0795:b003:l011","ordinal":137144,"en":"And convey my heartfelt greetings."},{"id":"semetey-1-2013:p0795:b003:l012","ordinal":137145,"en":"Your mother Kanykei bears a grievance:"},{"id":"semetey-1-2013:p0795:b003:l013","ordinal":137146,"en":"“Your grandfather's face,"},{"id":"semetey-1-2013:p0795:b003:l014","ordinal":137147,"en":"I shall not see while alive, even if I die,”"},{"id":"semetey-1-2013:p0795:b003:l015","ordinal":137148,"en":"She once made that vow."},{"id":"semetey-1-2013:p0795:b003:l016","ordinal":137149,"en":"Once, poor Kanykei,"},{"id":"semetey-1-2013:p0795:b003:l017","ordinal":137150,"en":"Showing the depths of her misery,"},{"id":"semetey-1-2013:p0795:b003:l018","ordinal":137151,"en":"Set ninety-year-old Chiyyrdy"},{"id":"semetey-1-2013:p0795:b003:l019","ordinal":137152,"en":"Upon her shoulders,"},{"id":"semetey-1-2013:p0795:b003:l020","ordinal":137153,"en":"Bound her firmly against her back."},{"id":"semetey-1-2013:p0795:b003:l021","ordinal":137154,"en":"“A gift left by the warrior,” she said,"},{"id":"semetey-1-2013:p0795:b003:l022","ordinal":137155,"en":"And in the fold of her overskirt"},{"id":"semetey-1-2013:p0795:b003:l023","ordinal":137156,"en":"Bound him securely in her care."},{"id":"semetey-1-2013:p0795:b003:l024","ordinal":137157,"en":"When her great wealth had scattered,"},{"id":"semetey-1-2013:p0795:b003:l025","ordinal":137158,"en":"When she fled Talas on foot,"},{"id":"semetey-1-2013:p0795:b003:l027","ordinal":137159,"en":"When she fled, finding no place,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0795:b003:l028","ordinal":137160,"en":"Never resting two days"},{"id":"semetey-1-2013:p0795:b003:l029","ordinal":137161,"en":"In any one place as she fled,"},{"id":"semetey-1-2013:p0795:b003:l030","ordinal":137162,"en":"Without overshoes, in felt stockings,"},{"id":"semetey-1-2013:p0795:b003:l031","ordinal":137163,"en":"The poor creature wept in sorrow."},{"id":"semetey-1-2013:p0795:b003:l032","ordinal":137164,"en":"Without boots, in felt stockings,"},{"id":"semetey-1-2013:p0795:b003:l033","ordinal":137165,"en":"The wretched creature wept aloud."},{"id":"semetey-1-2013:p0795:b003:l034","ordinal":137166,"en":"She set her face toward Bukhara,"},{"id":"semetey-1-2013:p0795:b003:l035","ordinal":137167,"en":"Carrying both of them alike."},{"id":"semetey-1-2013:p0795:b003:l036","ordinal":137168,"en":"The old woman coughed upon her back;"},{"id":"semetey-1-2013:p0795:b003:l037","ordinal":137169,"en":"Your mother carried the old woman and the child,"},{"id":"semetey-1-2013:p0795:b003:l038","ordinal":137170,"en":"Grieving as she went."},{"id":"semetey-1-2013:p0795:b003:l039","ordinal":137171,"en":"When I, Bakai, learned she had gone,"},{"id":"semetey-1-2013:p0795:b005:l001","ordinal":137172,"en":"I sent Kumaik racing after her trail."},{"id":"semetey-1-2013:p0795:b005:l002","ordinal":137173,"en":"At the reed-grown lake"},{"id":"semetey-1-2013:p0795:b005:l003","ordinal":137174,"en":"I caught up with her alone."},{"id":"semetey-1-2013:p0795:b005:l004","ordinal":137175,"en":"I gave her two fat horses,"},{"id":"semetey-1-2013:p0795:b005:l005","ordinal":137176,"en":"I gave her two leather bottles of milk."},{"id":"semetey-1-2013:p0795:b005:l006","ordinal":137177,"en":"I reached her and slaughtered for her"},{"id":"semetey-1-2013:p0795:b005:l007","ordinal":137178,"en":"A pale, white-blazed wether."},{"id":"semetey-1-2013:p0795:b005:l008","ordinal":137179,"en":"Your poor mother will never forget"},{"id":"semetey-1-2013:p0795:b005:l009","ordinal":137180,"en":"What happened then."},{"id":"semetey-1-2013:p0795:b005:l010","ordinal":137181,"en":"I clothed her in a robe of costly fabric,"},{"id":"semetey-1-2013:p0795:b005:l011","ordinal":137182,"en":"Mounted them on two cloud-like horses,"},{"id":"semetey-1-2013:p0795:b005:l012","ordinal":137183,"en":"Wept and sobbed as I made things ready,"},{"id":"semetey-1-2013:p0795:b005:l013","ordinal":137184,"en":"Told her to go to Bukhara."},{"id":"semetey-1-2013:p0795:b005:l014","ordinal":137185,"en":"My heart was torn,"},{"id":"semetey-1-2013:p0795:b005:l015","ordinal":137186,"en":"The tears poured from my eyes."},{"id":"semetey-1-2013:p0795:b005:l016","ordinal":137187,"en":"As I stood in great sorrow,"},{"id":"semetey-1-2013:p0795:b005:l017","ordinal":137188,"en":"Kanykei spoke a word,"},{"id":"semetey-1-2013:p0795:b005:l019","ordinal":137189,"en":"Then my dear child Kanykei,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0795:b005:l020","ordinal":137190,"en":"Parted from Khan Manas,"},{"id":"semetey-1-2013:p0795:b005:l021","ordinal":137191,"en":"Trembled beneath her troubles."},{"id":"semetey-1-2013:p0795:b005:l022","ordinal":137192,"en":"Her large, dark head,"},{"id":"semetey-1-2013:p0795:b005:l023","ordinal":137193,"en":"Her bloodied face scratched,"},{"id":"semetey-1-2013:p0795:b005:l024","ordinal":137194,"en":"Her dark hair loose,"},{"id":"semetey-1-2013:p0795:b005:l025","ordinal":137195,"en":"The grief within her had not eased."},{"id":"semetey-1-2013:p0795:b005:l026","ordinal":137196,"en":"It was thirty days since he died,"},{"id":"semetey-1-2013:p0795:b005:l027","ordinal":137197,"en":"Not yet time for his fortieth-day feast."},{"id":"semetey-1-2013:p0795:b005:l028","ordinal":137198,"en":"My dear child Kanykei said:"},{"id":"semetey-1-2013:p0795:b005:l030","ordinal":137199,"en":"“I shall die before my appointed death.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0795:b005:l031","ordinal":137200,"en":"With my large, dark head,"},{"id":"semetey-1-2013:p0795:b005:l032","ordinal":137201,"en":"How can I face my elder?” she said."},{"id":"semetey-1-2013:p0795:b005:l033","ordinal":137202,"en":"Her voice reached God;"},{"id":"semetey-1-2013:p0795:b005:l034","ordinal":137203,"en":"She fell face down."},{"id":"semetey-1-2013:p0795:b005:l035","ordinal":137204,"en":"My child Kanykei said this,"},{"id":"semetey-1-2013:p0795:b005:l036","ordinal":137205,"en":"Told of a horror unknown to others:"},{"id":"semetey-1-2013:p0795:b005:l037","ordinal":137206,"en":"“My dear elder!"},{"id":"semetey-1-2013:p0795:b005:l038","ordinal":137207,"en":"How shall we attain our desire?"},{"id":"semetey-1-2013:p0795:b005:l039","ordinal":137208,"en":"I left Bukhara weeping."},{"id":"semetey-1-2013:p0796:b003:l001","ordinal":137209,"en":"Because of Aktulpar"},{"id":"semetey-1-2013:p0796:b003:l002","ordinal":137210,"en":"I renounced him as a father."},{"id":"semetey-1-2013:p0796:b003:l004","ordinal":137211,"en":"I no longer called it a blessing.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0796:b003:l005","ordinal":137212,"en":"That sickle-nosed man"},{"id":"semetey-1-2013:p0796:b003:l006","ordinal":137213,"en":"I no longer called father."},{"id":"semetey-1-2013:p0796:b003:l007","ordinal":137214,"en":"How can I go to my father?"},{"id":"semetey-1-2013:p0796:b003:l008","ordinal":137215,"en":"A widow, standing so proudly,"},{"id":"semetey-1-2013:p0796:b003:l009","ordinal":137216,"en":"How can I look him in the face?”"}]
