[{"id":"manas-2010:p1269:b001:l042","ordinal":55041,"en":"“My blood-drinking Sultan Manas"},{"id":"manas-2010:p1270:b001:l001","ordinal":55042,"en":"Will mount me now,” he thought."},{"id":"manas-2010:p1270:b001:l002","ordinal":55043,"en":"Kartküröng stood looking."},{"id":"manas-2010:p1270:b001:l003","ordinal":55044,"en":"“The bulletproof coat my Azhy wears,"},{"id":"manas-2010:p1270:b001:l004","ordinal":55045,"en":"How could I wear it?” he said."},{"id":"manas-2010:p1270:b001:l005","ordinal":55046,"en":"“Kartküröng, whom my Azhy rides,"},{"id":"manas-2010:p1270:b001:l006","ordinal":55047,"en":"How could I ride you?” he said."},{"id":"manas-2010:p1270:b001:l007","ordinal":55048,"en":"“Lead the many horses,” he said."},{"id":"manas-2010:p1270:b001:l008","ordinal":55049,"en":"Striking him squarely on the jaw,"},{"id":"manas-2010:p1270:b001:l009","ordinal":55050,"en":"That courser Kartküröng,"},{"id":"manas-2010:p1270:b001:l010","ordinal":55051,"en":"He pushed him away to the other side."},{"id":"manas-2010:p1270:b001:l011","ordinal":55052,"en":"Though Kartküröng was a beast,"},{"id":"manas-2010:p1270:b001:l012","ordinal":55053,"en":"Without a tongue if he wished to speak,"},{"id":"manas-2010:p1270:b001:l013","ordinal":55054,"en":"He took terribly deep offense."},{"id":"manas-2010:p1270:b001:l014","ordinal":55055,"en":"Without leading the horses,"},{"id":"manas-2010:p1270:b001:l015","ordinal":55056,"en":"Kartküröng scattered them and went."},{"id":"manas-2010:p1270:b001:l016","ordinal":55057,"en":"Heading toward Azhybay,"},{"id":"manas-2010:p1270:b001:l017","ordinal":55058,"en":"Kartküröng fled away."},{"id":"manas-2010:p1270:b001:l018","ordinal":55059,"en":"The wind could not catch his trot;"},{"id":"manas-2010:p1270:b001:l019","ordinal":55060,"en":"Kartküröng hurried away."},{"id":"manas-2010:p1270:b001:l020","ordinal":55061,"en":"“Instead of dying once, die a thousand times!”"},{"id":"manas-2010:p1270:b001:l021","ordinal":55062,"en":"Kartküröng cursed him and went."},{"id":"manas-2010:p1270:b001:l022","ordinal":55063,"en":"Driving Kartküröng away,"},{"id":"manas-2010:p1270:b001:l023","ordinal":55064,"en":"Looming in anger,"},{"id":"manas-2010:p1270:b001:l024","ordinal":55065,"en":"The precious lion of sacred power,"},{"id":"manas-2010:p1270:b001:l025","ordinal":55066,"en":"Into the surging unbelievers'"},{"id":"manas-2010:p1270:b001:l026","ordinal":55067,"en":"Ranks the precious warrior struck."},{"id":"manas-2010:p1270:b001:l027","ordinal":55068,"en":"Chubak at his flank,"},{"id":"manas-2010:p1270:b001:l028","ordinal":55069,"en":"And champion Syrgak too,"},{"id":"manas-2010:p1270:b001:l029","ordinal":55070,"en":"Stars streaming from the sky,"},{"id":"manas-2010:p1270:b001:l030","ordinal":55071,"en":"The two who had gone before,"},{"id":"manas-2010:p1270:b001:l031","ordinal":55072,"en":"These men went and joined them."},{"id":"manas-2010:p1270:b001:l032","ordinal":55073,"en":"Into the surging unbelievers,"},{"id":"manas-2010:p1270:b001:l033","ordinal":55074,"en":"Your blue-maned one entered without pause."},{"id":"manas-2010:p1270:b001:l034","ordinal":55075,"en":"At the unbelievers who had crowded in,"},{"id":"manas-2010:p1270:b001:l035","ordinal":55076,"en":"Paying no heed to their numbers,"},{"id":"manas-2010:p1270:b001:l036","ordinal":55077,"en":"Your blue-maned one entered without fleeing."},{"id":"manas-2010:p1270:b001:l037","ordinal":55078,"en":"Making Aybanboz prance,"},{"id":"manas-2010:p1270:b001:l038","ordinal":55079,"en":"He meant to shatter and drive them away."},{"id":"manas-2010:p1270:b001:l039","ordinal":55080,"en":"Akbaltay's Chubak,"},{"id":"manas-2010:p1270:b001:l040","ordinal":55081,"en":"When he saw the grappling foe,"},{"id":"manas-2010:p1270:b001:l041","ordinal":55082,"en":"Not looking above or below,"},{"id":"manas-2010:p1270:b001:l042","ordinal":55083,"en":"Not thinking, “I shall die,”"},{"id":"manas-2010:p1271:b001:l001","ordinal":55084,"en":"He roared and entered battle."},{"id":"manas-2010:p1271:b001:l002","ordinal":55085,"en":"Chubak surged forward first;"},{"id":"manas-2010:p1271:b001:l003","ordinal":55086,"en":"The Manchu khan Ezkara"},{"id":"manas-2010:p1271:b001:l004","ordinal":55087,"en":"Came face to face with him."},{"id":"manas-2010:p1271:b001:l005","ordinal":55088,"en":"Ezkara's teeming army"},{"id":"manas-2010:p1271:b001:l006","ordinal":55089,"en":"Surged back and forth;"},{"id":"manas-2010:p1271:b001:l007","ordinal":55090,"en":"The champions, each of them,"},{"id":"manas-2010:p1271:b001:l008","ordinal":55091,"en":"Fought without sparing their lives."},{"id":"manas-2010:p1271:b001:l009","ordinal":55092,"en":"When Ezkara came confronting Chubak,"},{"id":"manas-2010:p1271:b001:l010","ordinal":55093,"en":"At that moment, Manas,"},{"id":"manas-2010:p1271:b001:l011","ordinal":55094,"en":"Kongurbay, the monks' khan,"},{"id":"manas-2010:p1271:b001:l012","ordinal":55095,"en":"When he confronted Manas,"},{"id":"manas-2010:p1271:b001:l013","ordinal":55096,"en":"Separated him from the others."},{"id":"manas-2010:p1271:b001:l014","ordinal":55097,"en":"The renowned warrior Manas's"},{"id":"manas-2010:p1271:b001:l015","ordinal":55098,"en":"Prowess he now knew."},{"id":"manas-2010:p1271:b001:l016","ordinal":55099,"en":"Your champion, warrior Manas,"},{"id":"manas-2010:p1271:b001:l017","ordinal":55100,"en":"The Chinese come from Beijing,"},{"id":"manas-2010:p1271:b001:l018","ordinal":55101,"en":"Again slaughtered and drove them back."},{"id":"manas-2010:p1271:b001:l019","ordinal":55102,"en":"Kongurbay of mighty guardian power,"},{"id":"manas-2010:p1271:b001:l020","ordinal":55103,"en":"Unable to grapple as an equal,"},{"id":"manas-2010:p1271:b001:l021","ordinal":55104,"en":"Fled away again."},{"id":"manas-2010:p1271:b001:l022","ordinal":55105,"en":"A true blue-maned one, an outstanding lion,"},{"id":"manas-2010:p1271:b001:l023","ordinal":55106,"en":"When Kongurbay had fled,"},{"id":"manas-2010:p1271:b001:l024","ordinal":55107,"en":"The Chinese behind him,"},{"id":"manas-2010:p1271:b001:l025","ordinal":55108,"en":"He drove in terror and pushed onward."},{"id":"manas-2010:p1271:b001:l026","ordinal":55109,"en":"The middle, all alone,"},{"id":"manas-2010:p1271:b001:l027","ordinal":55110,"en":"Your devastating Sultan Manas"},{"id":"manas-2010:p1271:b001:l028","ordinal":55111,"en":"Hewed through and slaughtered;"},{"id":"manas-2010:p1271:b001:l029","ordinal":55112,"en":"Around him the three champions"},{"id":"manas-2010:p1271:b001:l030","ordinal":55113,"en":"Drove and pursued them."},{"id":"manas-2010:p1271:b001:l031","ordinal":55114,"en":"In the kakan's Beijing,"},{"id":"manas-2010:p1271:b001:l032","ordinal":55115,"en":"Making the Chinese cry out,"},{"id":"manas-2010:p1271:b001:l033","ordinal":55116,"en":"Shouting, “Islam!”"},{"id":"manas-2010:p1271:b001:l034","ordinal":55117,"en":"The four champions raised a tumult."},{"id":"manas-2010:p1271:b001:l035","ordinal":55118,"en":"Like flying tumbleweed,"},{"id":"manas-2010:p1271:b001:l036","ordinal":55119,"en":"When you looked, they escaped the eye;"},{"id":"manas-2010:p1271:b001:l037","ordinal":55120,"en":"You could not tell which was which."},{"id":"manas-2010:p1271:b001:l038","ordinal":55121,"en":"Covering the face of the earth,"},{"id":"manas-2010:p1271:b001:l039","ordinal":55122,"en":"See the dust in the sky!"},{"id":"manas-2010:p1271:b001:l040","ordinal":55123,"en":"Like a flowing river,"},{"id":"manas-2010:p1271:b001:l041","ordinal":55124,"en":"See the blood turned crimson!"},{"id":"manas-2010:p1271:b001:l042","ordinal":55125,"en":"Within that blood,"},{"id":"manas-2010:p1272:b001:l001","ordinal":55126,"en":"See the rolling heads!"},{"id":"manas-2010:p1272:b001:l002","ordinal":55127,"en":"Mingled with heads, blood-soaked,"},{"id":"manas-2010:p1272:b001:l003","ordinal":55128,"en":"See the hair trailing out!"},{"id":"manas-2010:p1272:b001:l004","ordinal":55129,"en":"See the earth crimson with blood!"},{"id":"manas-2010:p1272:b001:l005","ordinal":55130,"en":"See the slaughtered Chinese people!"},{"id":"manas-2010:p1272:b001:l006","ordinal":55131,"en":"Many horses with broken legs,"},{"id":"manas-2010:p1272:b001:l007","ordinal":55132,"en":"Many more writhed here;"},{"id":"manas-2010:p1272:b001:l008","ordinal":55133,"en":"So many men scattered every way,"},{"id":"manas-2010:p1272:b001:l009","ordinal":55134,"en":"Still more were slaughtered there."},{"id":"manas-2010:p1272:b001:l010","ordinal":55135,"en":"Deprived of their dark eyes,"},{"id":"manas-2010:p1272:b001:l011","ordinal":55136,"en":"Many here had been blinded."},{"id":"manas-2010:p1272:b001:l012","ordinal":55137,"en":"Deprived of their hands and feet,"},{"id":"manas-2010:p1272:b001:l013","ordinal":55138,"en":"Many here cried out in anguish."},{"id":"manas-2010:p1272:b001:l014","ordinal":55139,"en":"When such slaughter had occurred,"},{"id":"manas-2010:p1272:b001:l015","ordinal":55140,"en":"The Kalcha of the Chinese,"},{"id":"manas-2010:p1272:b001:l016","ordinal":55141,"en":"To the great khan in Beijing,"},{"id":"manas-2010:p1272:b001:l017","ordinal":55142,"en":"“Give me a mighty army!” he said."},{"id":"manas-2010:p1272:b001:l018","ordinal":55143,"en":"Roaring in wrath,"},{"id":"manas-2010:p1272:b001:l019","ordinal":55144,"en":"He sent a man galloping on a gray horse,"},{"id":"manas-2010:p1272:b001:l020","ordinal":55145,"en":"He sent word once again."},{"id":"manas-2010:p1272:b001:l021","ordinal":55146,"en":"“Manas has come,” he said."},{"id":"manas-2010:p1272:b001:l022","ordinal":55147,"en":"“To the Chinese of twenty khandoms,"},{"id":"manas-2010:p1272:b001:l023","ordinal":55148,"en":"He has brought dreadful slaughter,” he said."},{"id":"manas-2010:p1272:b001:l024","ordinal":55149,"en":"Unable to stand his equal, Kongurbay,"},{"id":"manas-2010:p1272:b001:l025","ordinal":55150,"en":"Fleeing back, the many Chinese"},{"id":"manas-2010:p1272:b001:l026","ordinal":55151,"en":"To capture Outer Beijing,"},{"id":"manas-2010:p1272:b001:l027","ordinal":55152,"en":"He has drawn near,” he said."},{"id":"manas-2010:p1272:b001:l028","ordinal":55153,"en":"When they heard this news,"},{"id":"manas-2010:p1272:b001:l029","ordinal":55154,"en":"The people of Beijing seethed;"},{"id":"manas-2010:p1272:b001:l030","ordinal":55155,"en":"All of them cried out together."},{"id":"manas-2010:p1272:b001:l031","ordinal":55156,"en":"The news reached their khan;"},{"id":"manas-2010:p1272:b001:l032","ordinal":55157,"en":"In turmoil they stirred,"},{"id":"manas-2010:p1272:b001:l033","ordinal":55158,"en":"Toward the kakan's city."},{"id":"manas-2010:p1272:b001:l035","ordinal":55159,"en":"Karykan in Beijing,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"manas-2010:p1272:b001:l036","ordinal":55160,"en":"Had he not been casting it,"},{"id":"manas-2010:p1272:b001:l037","ordinal":55161,"en":"That accursed one, frightened of Manas,"},{"id":"manas-2010:p1272:b001:l038","ordinal":55162,"en":"The four corners of the world,"},{"id":"manas-2010:p1272:b001:l039","ordinal":55163,"en":"Had he not been traversing them?"},{"id":"manas-2010:p1272:b001:l040","ordinal":55164,"en":"“Manas will ruin the world,” he said."},{"id":"manas-2010:p1272:b001:l041","ordinal":55165,"en":"“That Burut will slaughter my people,” he said."},{"id":"manas-2010:p1272:b001:l042","ordinal":55166,"en":"“Bringing slaughter, wreaking havoc,"},{"id":"manas-2010:p1273:b001:l001","ordinal":55167,"en":"Almambet the renegade will do it,” he said."},{"id":"manas-2010:p1273:b001:l002","ordinal":55168,"en":"The khan of Beijing, long before,"},{"id":"manas-2010:p1273:b001:l003","ordinal":55169,"en":"Thinking of this within,"},{"id":"manas-2010:p1273:b001:l004","ordinal":55170,"en":"He had surely been grieving;"},{"id":"manas-2010:p1273:b001:l005","ordinal":55171,"en":"That such an event would occur,"},{"id":"manas-2010:p1273:b001:l006","ordinal":55172,"en":"He had surely known."},{"id":"manas-2010:p1273:b001:l007","ordinal":55173,"en":"Beijing's khan Karykan,"},{"id":"manas-2010:p1273:b001:l008","ordinal":55174,"en":"When he was asleep,"},{"id":"manas-2010:p1273:b001:l009","ordinal":55175,"en":"Had started from his dream, distraught."},{"id":"manas-2010:p1273:b001:l010","ordinal":55176,"en":"Looking in the morning:"},{"id":"manas-2010:p1273:b001:l011","ordinal":55177,"en":"“A man called Manas"},{"id":"manas-2010:p1273:b001:l012","ordinal":55178,"en":"Will bring the people to their end,” it said."},{"id":"manas-2010:p1273:b001:l013","ordinal":55179,"en":"“He will slaughter the Chinese,” it said."},{"id":"manas-2010:p1273:b001:l014","ordinal":55180,"en":"It was inscribed in Beijing's register."},{"id":"manas-2010:p1273:b001:l015","ordinal":55181,"en":"When he saw this inscription:"},{"id":"manas-2010:p1273:b001:l016","ordinal":55182,"en":"“A man of the Chinese will set out,"},{"id":"manas-2010:p1273:b001:l017","ordinal":55183,"en":"Emerging treacherous from within,"},{"id":"manas-2010:p1273:b001:l018","ordinal":55184,"en":"He will bring their end,” it said."},{"id":"manas-2010:p1273:b001:l019","ordinal":55185,"en":"“He will flee to Manas,” it said."},{"id":"manas-2010:p1273:b001:l020","ordinal":55186,"en":"Almambet's name was recorded."},{"id":"manas-2010:p1273:b001:l021","ordinal":55187,"en":"When the Chinese saw this,"},{"id":"manas-2010:p1273:b001:l022","ordinal":55188,"en":"All of them grieved together."},{"id":"manas-2010:p1273:b001:l023","ordinal":55189,"en":"Thus, in the unbelievers'"},{"id":"manas-2010:p1273:b001:l024","ordinal":55190,"en":"Scroll it was inscribed."},{"id":"manas-2010:p1273:b001:l025","ordinal":55191,"en":"When he heard this news,"},{"id":"manas-2010:p1273:b001:l026","ordinal":55192,"en":"The wrathful Karykan,"},{"id":"manas-2010:p1273:b001:l027","ordinal":55193,"en":"When he gave his command,"},{"id":"manas-2010:p1273:b001:l028","ordinal":55194,"en":"Earth flew, becoming dust."},{"id":"manas-2010:p1273:b001:l029","ordinal":55195,"en":"The deeply rooted Chinese, the teeming people,"},{"id":"manas-2010:p1273:b001:l030","ordinal":55196,"en":"All their multitudes stirred."},{"id":"manas-2010:p1273:b001:l031","ordinal":55197,"en":"When Karykan gave the command,"},{"id":"manas-2010:p1273:b001:l032","ordinal":55198,"en":"Of forty-gated Beijing,"},{"id":"manas-2010:p1273:b001:l033","ordinal":55199,"en":"He opened one gate."},{"id":"manas-2010:p1273:b001:l034","ordinal":55200,"en":"When his people opened the gate,"},{"id":"manas-2010:p1273:b001:l035","ordinal":55201,"en":"When the khan spread the news,"},{"id":"manas-2010:p1273:b001:l036","ordinal":55202,"en":"“Black-mustached young men,"},{"id":"manas-2010:p1273:b001:l037","ordinal":55203,"en":"Come here without exception!” he said."},{"id":"manas-2010:p1273:b001:l038","ordinal":55204,"en":"The skins of two oxen,"},{"id":"manas-2010:p1273:b001:l039","ordinal":55205,"en":"At the foot of the gate,"},{"id":"manas-2010:p1273:b001:l040","ordinal":55206,"en":"He spread out as hides."},{"id":"manas-2010:p1273:b001:l041","ordinal":55207,"en":"“Over these hides,"},{"id":"manas-2010:p1273:b001:l042","ordinal":55208,"en":"Tread and file out,” he said."},{"id":"manas-2010:p1274:b001:l001","ordinal":55209,"en":"“Of the two raw hides,"},{"id":"manas-2010:p1274:b001:l002","ordinal":55210,"en":"If not a palm-sized piece remains,"},{"id":"manas-2010:p1274:b001:l003","ordinal":55211,"en":"You will fill the world;"},{"id":"manas-2010:p1274:b001:l004","ordinal":55212,"en":"Only then will you be a match,"},{"id":"manas-2010:p1274:b001:l005","ordinal":55213,"en":"For the Burut who are so few,"},{"id":"manas-2010:p1274:b001:l006","ordinal":55214,"en":"You will be ready to fight.”"},{"id":"manas-2010:p1274:b001:l007","ordinal":55215,"en":"Saying this, Karykan"},{"id":"manas-2010:p1274:b001:l008","ordinal":55216,"en":"Issued his stern command."},{"id":"manas-2010:p1274:b001:l009","ordinal":55217,"en":"The many Chinese who had gathered"},{"id":"manas-2010:p1274:b001:l010","ordinal":55218,"en":"Trampled over the hides;"},{"id":"manas-2010:p1274:b001:l011","ordinal":55219,"en":"All of them filed out."},{"id":"manas-2010:p1274:b001:l012","ordinal":55220,"en":"You could not tell if they were sand,"},{"id":"manas-2010:p1274:b001:l013","ordinal":55221,"en":"You could not tell if they were insects;"},{"id":"manas-2010:p1274:b001:l014","ordinal":55222,"en":"The many Chinese swarmed out."},{"id":"manas-2010:p1274:b001:l015","ordinal":55223,"en":"Seething like ants,"},{"id":"manas-2010:p1274:b001:l016","ordinal":55224,"en":"The many Chinese spread out."},{"id":"manas-2010:p1274:b001:l017","ordinal":55225,"en":"When the Chinese surged onward,"},{"id":"manas-2010:p1274:b001:l018","ordinal":55226,"en":"Earth flew, becoming dust."},{"id":"manas-2010:p1274:b001:l019","ordinal":55227,"en":"The face of the sky could not be seen;"},{"id":"manas-2010:p1274:b001:l020","ordinal":55228,"en":"Because the Chinese were so numerous,"},{"id":"manas-2010:p1274:b001:l021","ordinal":55229,"en":"The face of the earth could not be seen."},{"id":"manas-2010:p1274:b001:l022","ordinal":55230,"en":"Looking through their dust,"},{"id":"manas-2010:p1274:b001:l023","ordinal":55231,"en":"You could not tell if it was the sun."},{"id":"manas-2010:p1274:b001:l024","ordinal":55232,"en":"The sun's face grew dim;"},{"id":"manas-2010:p1274:b001:l025","ordinal":55233,"en":"Like a river surging over,"},{"id":"manas-2010:p1274:b001:l026","ordinal":55234,"en":"You could not tell if it was a lake."},{"id":"manas-2010:p1274:b001:l027","ordinal":55235,"en":"This was the famed land of Beijing,"},{"id":"manas-2010:p1274:b001:l028","ordinal":55236,"en":"The lion Hazrat Ali"},{"id":"manas-2010:p1274:b001:l029","ordinal":55237,"en":"Had turned back from those people."},{"id":"manas-2010:p1274:b001:l030","ordinal":55238,"en":"No regret if the Chinese are slaughtered!"},{"id":"manas-2010:p1274:b001:l031","ordinal":55239,"en":"Of the two raw hides,"},{"id":"manas-2010:p1274:b001:l032","ordinal":55240,"en":"Trampled and destroyed,"},{"id":"manas-2010:p1274:b001:l033","ordinal":55241,"en":"Not a thimble-sized piece remained."},{"id":"manas-2010:p1274:b001:l034","ordinal":55242,"en":"“Now, Chinese, stop!” he said."},{"id":"manas-2010:p1274:b001:l035","ordinal":55243,"en":"Karykan in Beijing"},{"id":"manas-2010:p1274:b001:l036","ordinal":55244,"en":"Closed the gate."},{"id":"manas-2010:p1274:b001:l037","ordinal":55245,"en":"“The Chinese have filled the world,” he said."},{"id":"manas-2010:p1274:b001:l038","ordinal":55246,"en":"“The time to fight has come,” he said."},{"id":"manas-2010:p1274:b001:l039","ordinal":55247,"en":"“All those you encounter,"},{"id":"manas-2010:p1274:b001:l040","ordinal":55248,"en":"Trample beneath your soles,” he said."},{"id":"manas-2010:p1274:b001:l041","ordinal":55249,"en":"“The Burut who attacked us himself,"},{"id":"manas-2010:p1274:b001:l042","ordinal":55250,"en":"Smashing his very stones,"},{"id":"manas-2010:p1275:b001:l001","ordinal":55251,"en":"Overrun him all the way to Mecca,” he said."},{"id":"manas-2010:p1275:b001:l002","ordinal":55252,"en":"When they heard this decree,"},{"id":"manas-2010:p1275:b001:l003","ordinal":55253,"en":"Raising tumult, dust and uproar,"},{"id":"manas-2010:p1275:b001:l004","ordinal":55254,"en":"Taking a khan to lead the battle,"},{"id":"manas-2010:p1275:b001:l005","ordinal":55255,"en":"As the Chinese surged along,"},{"id":"manas-2010:p1275:b001:l006","ordinal":55256,"en":"Dust covered the earth."},{"id":"manas-2010:p1275:b001:l007","ordinal":55257,"en":"Men's hems were torn,"},{"id":"manas-2010:p1275:b001:l008","ordinal":55258,"en":"As they crowded one another."},{"id":"manas-2010:p1275:b001:l009","ordinal":55259,"en":"Men swarmed, with no room to fit;"},{"id":"manas-2010:p1275:b001:l010","ordinal":55260,"en":"Spears swayed, with no room to fit."},{"id":"manas-2010:p1275:b001:l011","ordinal":55261,"en":"They streamed across the earth."},{"id":"manas-2010:p1275:b001:l012","ordinal":55262,"en":"“Where is the ogre Manas?” they said."},{"id":"manas-2010:p1275:b001:l013","ordinal":55263,"en":"The mighty army arrived,"},{"id":"manas-2010:p1275:b001:l014","ordinal":55264,"en":"Joining the earlier army."},{"id":"manas-2010:p1275:b001:l015","ordinal":55265,"en":"Their ranks spread out in every direction."},{"id":"manas-2010:p1275:b001:l016","ordinal":55266,"en":"When the Chinese came pouring in,"},{"id":"manas-2010:p1275:b001:l017","ordinal":55267,"en":"The four champions who had joined together,"},{"id":"manas-2010:p1275:b001:l018","ordinal":55268,"en":"Fighting each his own way,"},{"id":"manas-2010:p1275:b001:l019","ordinal":55269,"en":"Parted in four directions."},{"id":"manas-2010:p1275:b001:l020","ordinal":55270,"en":"Slaughtering the Manchu without mercy,"},{"id":"manas-2010:p1275:b001:l021","ordinal":55271,"en":"Warrior Chubak went on fighting."},{"id":"manas-2010:p1275:b001:l022","ordinal":55272,"en":"Against the Black Kalmyk and Sibe,"},{"id":"manas-2010:p1275:b001:l023","ordinal":55273,"en":"Khan Zholoy and Ylama,"},{"id":"manas-2010:p1275:b001:l024","ordinal":55274,"en":"Facing these alone,"},{"id":"manas-2010:p1275:b001:l025","ordinal":55275,"en":"Almambet went on fighting."},{"id":"manas-2010:p1275:b001:l026","ordinal":55276,"en":"The people of the One-Eyed,"},{"id":"manas-2010:p1275:b001:l027","ordinal":55277,"en":"The defenses they had set at the edge,"},{"id":"manas-2010:p1275:b001:l028","ordinal":55278,"en":"Mangkush and the giant Kazan,"},{"id":"manas-2010:p1275:b001:l029","ordinal":55279,"en":"Syrgak confronted these,"},{"id":"manas-2010:p1275:b001:l030","ordinal":55280,"en":"He went his own separate way."},{"id":"manas-2010:p1275:b001:l031","ordinal":55281,"en":"The horse he rode was Aybanboz;"},{"id":"manas-2010:p1275:b001:l032","ordinal":55282,"en":"Alöökö's Kongurbay,"},{"id":"manas-2010:p1275:b001:l033","ordinal":55283,"en":"That Kalcha, Khan Manas charged."},{"id":"manas-2010:p1275:b001:l034","ordinal":55284,"en":"His supporter Kozhosan"},{"id":"manas-2010:p1275:b001:l035","ordinal":55285,"en":"Was supporting Manas."},{"id":"manas-2010:p1275:b001:l036","ordinal":55286,"en":"The one who gave his hand, Ak Eshen,"},{"id":"manas-2010:p1275:b001:l037","ordinal":55287,"en":"Was sustaining Manas."},{"id":"manas-2010:p1275:b001:l038","ordinal":55288,"en":"A black-spotted leopard"},{"id":"manas-2010:p1275:b001:l039","ordinal":55289,"en":"Leapt at his flank."},{"id":"manas-2010:p1275:b001:l040","ordinal":55290,"en":"Forty lions all around"},{"id":"manas-2010:p1275:b001:l041","ordinal":55291,"en":"Had encircled Manas;"},{"id":"manas-2010:p1275:b001:l042","ordinal":55292,"en":"Their support could be seen."},{"id":"manas-2010:p1276:b001:l001","ordinal":55293,"en":"Unable to bear his heat,"},{"id":"manas-2010:p1276:b001:l002","ordinal":55294,"en":"The Chinese broke away, fleeing."},{"id":"manas-2010:p1276:b001:l003","ordinal":55295,"en":"The mighty standard come from Mecca,"},{"id":"manas-2010:p1276:b001:l004","ordinal":55296,"en":"He reached the place and planted it."}]
