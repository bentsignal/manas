[{"id":"seytek-1991-continuation:p0347:b006:l015","ordinal":388353,"en":"Hearing this, Chyntengir said:"},{"id":"seytek-1991-continuation:p0347:b006:l016","ordinal":388354,"en":"“The Ala-Too is no land for us;"},{"id":"seytek-1991-continuation:p0347:b006:l017","ordinal":388355,"en":"The old enemy, the vile Burut,"},{"id":"seytek-1991-continuation:p0347:b006:l018","ordinal":388356,"en":"Will never be a people to us."},{"id":"seytek-1991-continuation:p0347:b006:l019","ordinal":388357,"en":"Inflict harsh torment;"},{"id":"seytek-1991-continuation:p0347:b006:l020","ordinal":388358,"en":"Silence his tongue without delay."},{"id":"seytek-1991-continuation:p0347:b006:l021","ordinal":388359,"en":"Bring his death upon him now,"},{"id":"seytek-1991-continuation:p0347:b006:l022","ordinal":388360,"en":"Deprive him of every recourse."},{"id":"seytek-1991-continuation:p0347:b006:l023","ordinal":388361,"en":"Cut strips of hide from his back;"},{"id":"seytek-1991-continuation:p0347:b006:l024","ordinal":388362,"en":"You blood-drinking champions,"},{"id":"seytek-1991-continuation:p0347:b006:l025","ordinal":388363,"en":"Seize him and take his life!"},{"id":"seytek-1991-continuation:p0347:b006:l026","ordinal":388364,"en":"Cut off his sheep-like head;"},{"id":"seytek-1991-continuation:p0347:b006:l027","ordinal":388365,"en":"Rip open his melon-like belly!”"},{"id":"seytek-1991-continuation:p0347:b006:l028","ordinal":388366,"en":"Thus Chyntengir spoke,"},{"id":"seytek-1991-continuation:p0347:b006:l029","ordinal":388367,"en":"Urging and dispatching"},{"id":"seytek-1991-continuation:p0347:b006:l030","ordinal":388368,"en":"His champions and giants,"},{"id":"seytek-1991-continuation:p0347:b006:l031","ordinal":388369,"en":"Rousing and dispatching"},{"id":"seytek-1991-continuation:p0347:b006:l032","ordinal":388370,"en":"His strongest heroes."},{"id":"seytek-1991-continuation:p0347:b006:l033","ordinal":388371,"en":"His champions and warriors"},{"id":"seytek-1991-continuation:p0347:b006:l034","ordinal":388372,"en":"Now began to trample and beat him,"},{"id":"seytek-1991-continuation:p0347:b006:l035","ordinal":388373,"en":"Inflicting every torture they knew."},{"id":"seytek-1991-continuation:p0347:b006:l036","ordinal":388374,"en":"They tormented and took his life,"},{"id":"seytek-1991-continuation:p0347:b006:l037","ordinal":388375,"en":"Cutting off his hands and feet."},{"id":"seytek-1991-continuation:p0347:b006:l038","ordinal":388376,"en":"The champions attacked"},{"id":"seytek-1991-continuation:p0347:b006:l039","ordinal":388377,"en":"The noble gray-maned hero"},{"id":"seytek-1991-continuation:p0347:b006:l040","ordinal":388378,"en":"And took his precious head;"},{"id":"seytek-1991-continuation:p0347:b006:l041","ordinal":388379,"en":"They finished him then and there."},{"id":"seytek-1991-continuation:p0347:b006:l042","ordinal":388380,"en":"“We slaughtered and destroyed the champion"},{"id":"seytek-1991-continuation:p0347:b006:l043","ordinal":388381,"en":"Whose stars crossed ours.”"},{"id":"seytek-1991-continuation:p0347:b006:l044","ordinal":388382,"en":"Breaking through the dead end and opening a road,"},{"id":"seytek-1991-continuation:p0347:b006:l045","ordinal":388383,"en":"The Chinese army attacked directly"},{"id":"seytek-1991-continuation:p0347:b006:l046","ordinal":388384,"en":"Against the true Black Kyrgyz."},{"id":"seytek-1991-continuation:p0348:b001:l001","ordinal":388385,"en":"Alymsaryk and hero Kulan,"},{"id":"seytek-1991-continuation:p0348:b001:l002","ordinal":388386,"en":"Defenders of all the people,"},{"id":"seytek-1991-continuation:p0348:b001:l003","ordinal":388387,"en":"Fought a vicious fight,"},{"id":"seytek-1991-continuation:p0348:b001:l004","ordinal":388388,"en":"Standing face-to-face,"},{"id":"seytek-1991-continuation:p0348:b001:l005","ordinal":388389,"en":"Fighting turn by turn,"},{"id":"seytek-1991-continuation:p0348:b001:l006","ordinal":388390,"en":"Locked in a bloody struggle."},{"id":"seytek-1991-continuation:p0348:b001:l007","ordinal":388391,"en":"Their father, gray-maned Jeljetpes,"},{"id":"seytek-1991-continuation:p0348:b001:l008","ordinal":388392,"en":"Was protecting the twin heroes,"},{"id":"seytek-1991-continuation:p0348:b001:l009","ordinal":388393,"en":"So the champion's line might endure."},{"id":"seytek-1991-continuation:p0348:b001:l010","ordinal":388394,"en":"He turned summer's day into winter,"},{"id":"seytek-1991-continuation:p0348:b001:l011","ordinal":388395,"en":"And plunged the Chinese and Kakan troops"},{"id":"seytek-1991-continuation:p0348:b001:l012","ordinal":388396,"en":"Who came against them into calamity."},{"id":"seytek-1991-continuation:p0348:b001:l013","ordinal":388397,"en":"He sent a flood and made it water."},{"id":"seytek-1991-continuation:p0348:b001:l014","ordinal":388398,"en":"The three heroes raised an uproar,"},{"id":"seytek-1991-continuation:p0348:b001:l015","ordinal":388399,"en":"Cutting through the standing Chinese host."},{"id":"seytek-1991-continuation:p0348:b001:l016","ordinal":388400,"en":"Supporting one another,"},{"id":"seytek-1991-continuation:p0348:b001:l017","ordinal":388401,"en":"They were drenched in bloody dust,"},{"id":"seytek-1991-continuation:p0348:b001:l018","ordinal":388402,"en":"And fought without turning back."},{"id":"seytek-1991-continuation:p0348:b001:l019","ordinal":388403,"en":"Jeljetpes moved through their midst;"},{"id":"seytek-1991-continuation:p0348:b001:l020","ordinal":388404,"en":"Wounded in seven places,"},{"id":"seytek-1991-continuation:p0348:b001:l021","ordinal":388405,"en":"He had a net spread before him."},{"id":"seytek-1991-continuation:p0348:b001:l022","ordinal":388406,"en":"After countless heroes"},{"id":"seytek-1991-continuation:p0348:b001:l023","ordinal":388407,"en":"From the Beijing host thrust at him,"},{"id":"seytek-1991-continuation:p0348:b001:l024","ordinal":388408,"en":"His life was truly scorched."},{"id":"seytek-1991-continuation:p0348:b002:l001","ordinal":388409,"en":"He was snatched from certain death,"},{"id":"seytek-1991-continuation:p0348:b002:l002","ordinal":388410,"en":"Caught in the fatal net,"},{"id":"seytek-1991-continuation:p0348:b002:l003","ordinal":388411,"en":"Yet Jeljetpes broke free and escaped."},{"id":"seytek-1991-continuation:p0348:b002:l004","ordinal":388412,"en":"Alymsaryk and Kulansaryk,"},{"id":"seytek-1991-continuation:p0348:b002:l005","ordinal":388413,"en":"Two fair heroes with rhyming names,"},{"id":"seytek-1991-continuation:p0348:b002:l006","ordinal":388414,"en":"Passed through the solitary foe."},{"id":"seytek-1991-continuation:p0348:b002:l007","ordinal":388415,"en":"Their muscular flesh was torn,"},{"id":"seytek-1991-continuation:p0348:b002:l008","ordinal":388416,"en":"And the flesh of their ribs ripped away;"},{"id":"seytek-1991-continuation:p0348:b002:l009","ordinal":388417,"en":"The two reached a quiet place."},{"id":"seytek-1991-continuation:p0348:b002:l010","ordinal":388418,"en":"Climbing to a mountain pass, they leaned down,"},{"id":"seytek-1991-continuation:p0348:b002:l011","ordinal":388419,"en":"And on a truly sacred hill"},{"id":"seytek-1991-continuation:p0348:b002:l012","ordinal":388420,"en":"They dozed and fell asleep."},{"id":"seytek-1991-continuation:p0348:b002:l013","ordinal":388421,"en":"Their closed eyes would not open,"},{"id":"seytek-1991-continuation:p0348:b002:l014","ordinal":388422,"en":"Their outstretched legs would not draw in,"},{"id":"seytek-1991-continuation:p0348:b002:l015","ordinal":388423,"en":"And their deep snoring did not cease."},{"id":"seytek-1991-continuation:p0348:b002:l016","ordinal":388424,"en":"They sank into a giant's sleep."},{"id":"seytek-1991-continuation:p0348:b002:l017","ordinal":388425,"en":"Jeljetpes and the twin heroes"},{"id":"seytek-1991-continuation:p0348:b002:l018","ordinal":388426,"en":"Let the horses they had ridden to war"},{"id":"seytek-1991-continuation:p0348:b002:l019","ordinal":388427,"en":"Cool fully and drink their fill."},{"id":"seytek-1991-continuation:p0348:b002:l020","ordinal":388428,"en":"They grazed them on feather grass,"},{"id":"seytek-1991-continuation:p0348:b002:l021","ordinal":388429,"en":"Led them a little while,"},{"id":"seytek-1991-continuation:p0348:b002:l022","ordinal":388430,"en":"And filled their throats with grass;"},{"id":"seytek-1991-continuation:p0348:b002:l023","ordinal":388431,"en":"Led them a long while,"},{"id":"seytek-1991-continuation:p0348:b002:l024","ordinal":388432,"en":"And filled their chests with grass."},{"id":"sayakbay-ms-current145:pdf003:l005","ordinal":388433,"en":"Coats were torn into shreds,"},{"id":"sayakbay-ms-current145:pdf003:l006","ordinal":388434,"en":"Something was completely torn apart,"},{"id":"sayakbay-ms-current145:pdf003:l009","ordinal":388435,"en":"Seething and raging utterly,"},{"id":"sayakbay-ms-current145:pdf003:l010","ordinal":388436,"en":"The heroes facing one another"},{"id":"sayakbay-ms-current145:pdf003:l011","ordinal":388437,"en":"Neither could defeat the other,"},{"id":"sayakbay-ms-current145:pdf003:l012","ordinal":388438,"en":"Each in turn saying, Come!"},{"id":"sayakbay-ms-current145:pdf003:l013","ordinal":388439,"en":"Taking turns and catching their breath,"},{"id":"sayakbay-ms-current145:pdf003:l014","ordinal":388440,"en":"Some yielding their turn,"},{"id":"sayakbay-ms-current145:pdf003:l015","ordinal":388441,"en":"Going somewhere and standing there,"},{"id":"sayakbay-ms-current145:pdf003:l016","ordinal":388442,"en":"Something of the battle-axe,"},{"id":"sayakbay-ms-current145:pdf003:l017","ordinal":388443,"en":"Thrusting spears without restraint,"},{"id":"sayakbay-ms-current145:pdf003:l018","ordinal":388444,"en":"The day waned and night passed,"},{"id":"sayakbay-ms-current145:pdf003:l019","ordinal":388445,"en":"Beginning a grievous fight,"},{"id":"sayakbay-ms-current145:pdf003:l020","ordinal":388446,"en":"Such is the way of heroism,"},{"id":"sayakbay-ms-current145:pdf003:l021","ordinal":388447,"en":"Holding golden life of no account,"},{"id":"sayakbay-ms-current145:pdf003:l028","ordinal":388448,"en":"Your vigor exhausted and strength fled,"},{"id":"sayakbay-ms-current145:pdf004:l009","ordinal":388449,"en":"Trampling the battlefield,"},{"id":"sayakbay-ms-current145:pdf006:l004","ordinal":388450,"en":"Making God's sun appear,"},{"id":"sayakbay-ms-current145:pdf006:l014","ordinal":388451,"en":"We were a chosen hundred,"},{"id":"sayakbay-ms-current145:pdf006:l015","ordinal":388452,"en":"The hundred died; I remained,"},{"id":"sayakbay-ms-current145:pdf006:l016","ordinal":388453,"en":"Look, Joltoy, toward Kakan,"},{"id":"sayakbay-ms-current145:pdf006:l017","ordinal":388454,"en":"Hero, for you, Ak Joltoy, I had slain,"},{"id":"sayakbay-ms-current145:pdf006:l018","ordinal":388455,"en":"My renown was abundant, my fame great,"},{"id":"sayakbay-ms-current145:pdf006:l019","ordinal":388456,"en":"When it came to Great Beijing,"},{"id":"sayakbay-ms-current145:pdf006:l020","ordinal":388457,"en":"I was a defensive wall of steel,"},{"id":"sayakbay-ms-current145:pdf006:l021","ordinal":388458,"en":"If the vast Chinese host broke,"},{"id":"sayakbay-ms-current145:pdf006:l022","ordinal":388459,"en":"Grappling in battle,"},{"id":"sayakbay-ms-current145:pdf006:l023","ordinal":388460,"en":"I was one who emerged alive."},{"id":"sayakbay-ms-current145:pdf006:l024","ordinal":388461,"en":"I was the root of great turmoil,"},{"id":"sayakbay-ms-current145:pdf006:l025","ordinal":388462,"en":"I was one of the great battle's fighters,"},{"id":"sayakbay-ms-current145:pdf006:l026","ordinal":388463,"en":"I was a khan sprung from Kaldai,"},{"id":"sayakbay-ms-current145:pdf006:l027","ordinal":388464,"en":"I was forty khans to the Chinese,"},{"id":"sayakbay-ms-current145:pdf006:l028","ordinal":388465,"en":"No plotting enemy could pass,"},{"id":"sayakbay-ms-current145:pdf006:l029","ordinal":388466,"en":"I was a steel fortress wall."},{"id":"sayakbay-ms-current145:pdf006:l030","ordinal":388467,"en":"Fighting beyond measure,"},{"id":"sayakbay-ms-current145:pdf006:l031","ordinal":388468,"en":"Countless troops were assembled,"},{"id":"sayakbay-ms-current145:pdf007:l001","ordinal":388469,"en":"Köyka, swooping, struck the sable."},{"id":"sayakbay-ms-current145:pdf007:l002","ordinal":388470,"en":"He lashed the motley swan with a deceiving whip."},{"id":"sayakbay-ms-current145:pdf007:l003","ordinal":388471,"en":"I did not speak of your prowess."},{"id":"sayakbay-ms-current145:pdf007:l004","ordinal":388472,"en":"Helpless, you are hot-blooded."},{"id":"sayakbay-ms-current145:pdf007:l005","ordinal":388473,"en":"You have seen true strength and courage."},{"id":"sayakbay-ms-current145:pdf007:l006","ordinal":388474,"en":"A champion upright beyond all men."},{"id":"sayakbay-ms-current145:pdf007:l007","ordinal":388475,"en":"What kind of one are you, called Engirdey?"},{"id":"sayakbay-ms-current145:pdf007:l008","ordinal":388476,"en":"Mother-forsaken wretch."},{"id":"sayakbay-ms-current145:pdf007:l009","ordinal":388477,"en":"What talk is this of being defeated?!"},{"id":"sayakbay-ms-current145:pdf007:l010","ordinal":388478,"en":"Bilgi speaks out sharply."},{"id":"sayakbay-ms-current145:pdf007:l011","ordinal":388479,"en":"Staring wide-eyed and glaring."},{"id":"sayakbay-ms-current145:pdf007:l012","ordinal":388480,"en":"Pouring down as though earth and sky converged."},{"id":"sayakbay-ms-current145:pdf007:l013","ordinal":388481,"en":"Changing into every manner of form."},{"id":"sayakbay-ms-current145:pdf007:l014","ordinal":388482,"en":"Power streamed from his five fingers."},{"id":"sayakbay-ms-current145:pdf007:l015","ordinal":388483,"en":"Flowers seemed to bloom on both cheeks."},{"id":"sayakbay-ms-current145:pdf007:l016","ordinal":388484,"en":"Joloy cried out in anger."},{"id":"sayakbay-ms-current145:pdf007:l017","ordinal":388485,"en":"Saying, “Let it come to a single fistfight.”"},{"id":"sayakbay-ms-current145:pdf007:l018","ordinal":388486,"en":"Opening his mouth cavern-wide."},{"id":"sayakbay-ms-current145:pdf007:l019","ordinal":388487,"en":"His twisted nose became like ice."},{"id":"sayakbay-ms-current145:pdf007:l020","ordinal":388488,"en":"Blood surged into his wrath."},{"id":"sayakbay-ms-current145:pdf007:l021","ordinal":388489,"en":"No soul could withstand his might."},{"id":"sayakbay-ms-current145:pdf007:l022","ordinal":388490,"en":"His eyes hollowed like fortresses."},{"id":"sayakbay-ms-current145:pdf007:l023","ordinal":388491,"en":"Fierceness issued from his being."},{"id":"sayakbay-ms-current145:pdf007:l024","ordinal":388492,"en":"Blood surged anew."},{"id":"sayakbay-ms-current145:pdf007:l025","ordinal":388493,"en":"Of dear hero Bilgi,"},{"id":"sayakbay-ms-current145:pdf007:l026","ordinal":388494,"en":"His bearing gathered itself straight."},{"id":"sayakbay-ms-current145:pdf007:l027","ordinal":388495,"en":"Bilgi stood in the narrow place."},{"id":"sayakbay-ms-current145:pdf007:l028","ordinal":388496,"en":"His glaring face lengthened."},{"id":"sayakbay-ms-current145:pdf007:l029","ordinal":388497,"en":"He changed into myriad forms."},{"id":"sayakbay-ms-current145:pdf007:l030","ordinal":388498,"en":"The staff he held swung out."},{"id":"sayakbay-ms-current145:pdf008:l001","ordinal":388499,"en":"See—without turning his horse’s head."},{"id":"sayakbay-ms-current145:pdf008:l002","ordinal":388500,"en":"Like a man filled with hope."},{"id":"sayakbay-ms-current145:pdf008:l003","ordinal":388501,"en":"Lowering his head from his bulk."},{"id":"sayakbay-ms-current145:pdf008:l004","ordinal":388502,"en":"No soul could have enough of his splendor."},{"id":"sayakbay-ms-current145:pdf008:l005","ordinal":388503,"en":"Letting no swaggering man remain."},{"id":"sayakbay-ms-current145:pdf008:l006","ordinal":388504,"en":"He drove the mound before him."},{"id":"sayakbay-ms-current145:pdf008:l007","ordinal":388505,"en":"His steel spear rose to the sky."},{"id":"sayakbay-ms-current145:pdf008:l008","ordinal":388506,"en":"It carved through the warrior’s life."},{"id":"sayakbay-ms-current145:pdf008:l009","ordinal":388507,"en":"Jaykalgan remained whole-headed."},{"id":"sayakbay-ms-current145:pdf008:l010","ordinal":388508,"en":"He spared not a single soul."},{"id":"sayakbay-ms-current145:pdf008:l011","ordinal":388509,"en":"White Joloy, against brave Seytek,"},{"id":"sayakbay-ms-current145:pdf008:l012","ordinal":388510,"en":"Filled with wrath and stiffened."},{"id":"sayakbay-ms-current145:pdf008:l013","ordinal":388511,"en":"Again his two eyes,"},{"id":"sayakbay-ms-current145:pdf008:l014","ordinal":388512,"en":"Reddend like the sun."},{"id":"sayakbay-ms-current145:pdf008:l015","ordinal":388513,"en":"Mouths gurgled with water."},{"id":"sayakbay-ms-current145:pdf008:l016","ordinal":388514,"en":"His gullet roared with fluid."},{"id":"sayakbay-ms-current145:pdf008:l017","ordinal":388515,"en":"His very being shuddered to strike."},{"id":"sayakbay-ms-current145:pdf008:l018","ordinal":388516,"en":"Water sprayed from his jaw."},{"id":"sayakbay-ms-current145:pdf008:l019","ordinal":388517,"en":"The place he met was crushed."},{"id":"sayakbay-ms-current145:pdf008:l020","ordinal":388518,"en":"If the day came to lean on his staff."},{"id":"sayakbay-ms-current145:pdf008:l021","ordinal":388519,"en":"Blood spilled from his wrath."},{"id":"sayakbay-ms-current145:pdf008:l022","ordinal":388520,"en":"The crown of Jadybay,"},{"id":"sayakbay-ms-current145:pdf008:l023","ordinal":388521,"en":"He stirred the news here."},{"id":"sayakbay-ms-current145:pdf008:l024","ordinal":388522,"en":"It was a place where the array recoiled."},{"id":"sayakbay-ms-current145:pdf008:l025","ordinal":388523,"en":"The warrior Ak Joloy’s eyes,"},{"id":"sayakbay-ms-current145:pdf008:l026","ordinal":388524,"en":"He came and struck with a mace."},{"id":"sayakbay-ms-current145:pdf008:l027","ordinal":388525,"en":"His terrible frame shook."},{"id":"sayakbay-ms-current145:pdf008:l028","ordinal":388526,"en":"Kulansur beneath him,"},{"id":"sayakbay-ms-current145:pdf008:l029","ordinal":388527,"en":"His prowess became known."},{"id":"sayakbay-ms-current145:pdf008:l030","ordinal":388528,"en":"Kulansur, whom the earth could not contain."},{"id":"sayakbay-ms-current145:pdf009:l001","ordinal":388529,"en":"He dealt a blow with the mace."},{"id":"sayakbay-ms-current145:pdf009:l002","ordinal":388530,"en":"It was iron, fit to withstand."},{"id":"sayakbay-ms-current145:pdf009:l003","ordinal":388531,"en":"For however many remained."},{"id":"sayakbay-ms-current145:pdf009:l004","ordinal":388532,"en":"He struck the warrior Joloy."},{"id":"sayakbay-ms-current145:pdf009:l005","ordinal":388533,"en":"In battle with the casting net."},{"id":"sayakbay-ms-current145:pdf009:l006","ordinal":388534,"en":"Great-souled son, hero Seytek."},{"id":"sayakbay-ms-current145:pdf009:l007","ordinal":388535,"en":"His mace was especially light in hand."},{"id":"sayakbay-ms-current145:pdf009:l008","ordinal":388536,"en":"Most skilled in keen speech."},{"id":"sayakbay-ms-current145:pdf009:l009","ordinal":388537,"en":"When Ak Joloy showed his prowess."},{"id":"sayakbay-ms-current145:pdf009:l010","ordinal":388538,"en":"When Bilgi spilled his blood."},{"id":"sayakbay-ms-current145:pdf009:l011","ordinal":388539,"en":"When offered as a sacrifice."},{"id":"sayakbay-ms-current145:pdf009:l012","ordinal":388540,"en":"The champions left bereft."},{"id":"sayakbay-ms-current145:pdf009:l013","ordinal":388541,"en":"When he himself took heed."},{"id":"sayakbay-ms-current145:pdf009:l014","ordinal":388542,"en":"To the white horde in his robe."},{"id":"sayakbay-ms-current145:pdf009:l015","ordinal":388543,"en":"With white-necked standards aloft."},{"id":"sayakbay-ms-current145:pdf009:l016","ordinal":388544,"en":"Wrathfully he surged."},{"id":"sayakbay-ms-current145:pdf009:l017","ordinal":388545,"en":"The lone heir of the bloodthirsty lion."},{"id":"sayakbay-ms-current145:pdf009:l018","ordinal":388546,"en":"He entered among the champions."},{"id":"sayakbay-ms-current145:pdf009:l019","ordinal":388547,"en":"Clinging fiercely to the horde."},{"id":"sayakbay-ms-current145:pdf009:l020","ordinal":388548,"en":"Ak Joloy with the mottled halberd."},{"id":"sayakbay-ms-current145:pdf009:l021","ordinal":388549,"en":"Because of his spear,"},{"id":"sayakbay-ms-current145:pdf009:l022","ordinal":388550,"en":"His champion was like a spear."},{"id":"sayakbay-ms-current145:pdf009:l023","ordinal":388551,"en":"His cast was exceedingly true."},{"id":"sayakbay-ms-current145:pdf009:l024","ordinal":388552,"en":"Measuring him at full length."},{"id":"sayakbay-ms-current145:pdf009:l025","ordinal":388553,"en":"When Bilgi grappled face to face."},{"id":"sayakbay-ms-current145:pdf009:l026","ordinal":388554,"en":"They hacked at one another with swords."},{"id":"sayakbay-ms-current145:pdf009:l027","ordinal":388555,"en":"Grasping his gear, he startled them."},{"id":"sayakbay-ms-current145:pdf009:l028","ordinal":388556,"en":"When they closed hand to hand."},{"id":"sayakbay-ms-current145:pdf009:l029","ordinal":388557,"en":"In a troubled place, against the brute."},{"id":"sayakbay-ms-current145:pdf009:l030","ordinal":388558,"en":"Having lost the bloodthirsty hero."},{"id":"sayakbay-ms-current145:pdf010:l001","ordinal":388559,"en":"Drenched in black blood."},{"id":"sayakbay-ms-current145:pdf010:l002","ordinal":388560,"en":"His inner passage drawn tight."},{"id":"sayakbay-ms-current145:pdf010:l003","ordinal":388561,"en":"Leading Kulansur."},{"id":"sayakbay-ms-current145:pdf010:l004","ordinal":388562,"en":"From your uncle Deep-set Joloy."},{"id":"sayakbay-ms-current145:pdf010:l005","ordinal":388563,"en":"Your mighty spirit revived."},{"id":"sayakbay-ms-current145:pdf010:l006","ordinal":388564,"en":"His figure became clearly known."},{"id":"sayakbay-ms-current145:pdf010:l007","ordinal":388565,"en":"Your soul revived again."},{"id":"sayakbay-ms-current145:pdf010:l008","ordinal":388566,"en":"Fire came from the eyes."},{"id":"sayakbay-ms-current145:pdf010:l009","ordinal":388567,"en":"He ran like a wild doe."},{"id":"sayakbay-ms-current145:pdf010:l010","ordinal":388568,"en":"He carried Joloy out."},{"id":"sayakbay-ms-current145:pdf010:l011","ordinal":388569,"en":"Then, at that moment, Ak Joloy,"},{"id":"sayakbay-ms-current145:pdf010:l012","ordinal":388570,"en":"Ak Joloy, the wounded hero."},{"id":"sayakbay-ms-current145:pdf010:l013","ordinal":388571,"en":"The earth laid bare his wound."},{"id":"sayakbay-ms-current145:pdf010:l014","ordinal":388572,"en":"No place on earth was like it."},{"id":"sayakbay-ms-current145:pdf010:l015","ordinal":388573,"en":"Thus did Joloy’s eyes appear."},{"id":"sayakbay-ms-current145:pdf010:l016","ordinal":388574,"en":"To Joloy, barely standing,"},{"id":"sayakbay-ms-current145:pdf010:l017","ordinal":388575,"en":"Your wretched soul, to Kongur."},{"id":"sayakbay-ms-current145:pdf010:l018","ordinal":388576,"en":"God restored you to your senses."},{"id":"sayakbay-ms-current145:pdf010:l019","ordinal":388577,"en":"Behold the contest between them."},{"id":"sayakbay-ms-current145:pdf010:l020","ordinal":388578,"en":"How many champions have you seen?"},{"id":"sayakbay-ms-current145:pdf010:l021","ordinal":388579,"en":"By fate, life clung to his head."},{"id":"sayakbay-ms-current145:pdf010:l022","ordinal":388580,"en":"When Kulansur came into his hand."},{"id":"sayakbay-ms-current145:pdf010:l023","ordinal":388581,"en":"Crested Bilgi,"},{"id":"sayakbay-ms-current145:pdf010:l024","ordinal":388582,"en":"The poor wretch thought and said this:"},{"id":"sayakbay-ms-current145:pdf010:l025","ordinal":388583,"en":"“Harness the beast’s colt,” he said."},{"id":"sayakbay-ms-current145:pdf010:l026","ordinal":388584,"en":"My seasons spent wandering alone."},{"id":"sayakbay-ms-current145:pdf010:l027","ordinal":388585,"en":"Emekan of forty doors."},{"id":"sayakbay-ms-current145:pdf010:l028","ordinal":388586,"en":"Driving beneath it."},{"id":"sayakbay-ms-current145:pdf010:l029","ordinal":388587,"en":"Thinking I would go and tell, then load it."},{"id":"sayakbay-ms-current145:pdf011:l001","ordinal":388588,"en":"The strength of a gray ram,"},{"id":"sayakbay-ms-current145:pdf011:l002","ordinal":388589,"en":"Thinking I would draw and pull,"},{"id":"sayakbay-ms-current145:pdf011:l003","ordinal":388590,"en":"If I should take up his arms,"},{"id":"sayakbay-ms-current145:pdf011:l004","ordinal":388591,"en":"May my forty forefathers support me,"},{"id":"sayakbay-ms-current145:pdf011:l005","ordinal":388592,"en":"Calling him my son, the hero Bilgich,"},{"id":"sayakbay-ms-current145:pdf011:l006","ordinal":388593,"en":"We shall cross the pass, forty khans,"},{"id":"sayakbay-ms-current145:pdf011:l007","ordinal":388594,"en":"When the name of great Bilgich is heard,"},{"id":"sayakbay-ms-current145:pdf011:l008","ordinal":388595,"en":"Saying, now we have defeated your warrior,"},{"id":"sayakbay-ms-current145:pdf011:l009","ordinal":388596,"en":"Like an enemy of Beijing,"},{"id":"sayakbay-ms-current145:pdf011:l010","ordinal":388597,"en":"Saying we defeated the great one in battle,"},{"id":"sayakbay-ms-current145:pdf011:l011","ordinal":388598,"en":"Bind my brave man,"},{"id":"sayakbay-ms-current145:pdf011:l012","ordinal":388599,"en":"Driving five thousand from Beijing,"},{"id":"sayakbay-ms-current145:pdf011:l013","ordinal":388600,"en":"Having the heroes bind them,"},{"id":"sayakbay-ms-current145:pdf011:l014","ordinal":388601,"en":"Thinking I would load riches for Bilgich,"},{"id":"sayakbay-ms-current145:pdf011:l015","ordinal":388602,"en":"From the massed Chinese host,"},{"id":"sayakbay-ms-current145:pdf011:l016","ordinal":388603,"en":"Thinking I would draw against its finest,"},{"id":"sayakbay-ms-current145:pdf011:l017","ordinal":388604,"en":"The swords ride on without tiring,"},{"id":"sayakbay-ms-current145:pdf011:l018","ordinal":388605,"en":"The scorched, raging brute,"},{"id":"sayakbay-ms-current145:pdf011:l019","ordinal":388606,"en":"God has struck Bilgich down."},{"id":"sayakbay-ms-current145:pdf011:l020","ordinal":388607,"en":"While my eyes still live and see,"},{"id":"sayakbay-ms-current145:pdf011:l021","ordinal":388608,"en":"All the neighboring peoples,"}]
