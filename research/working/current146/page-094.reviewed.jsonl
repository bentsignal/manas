{"id": "sayakbay-ms-current146:pdf094:l016", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 94, "folio": 477, "line_in_page": 16, "raw": "Хан Теңирге берсин де.", "text": "Хан Теңирге берсин де.", "en": "Tell him to give it to Khan Tengir.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf094:l017", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 94, "folio": 477, "line_in_page": 17, "raw": "Каруу жаңжал көрсүн де.", "text": "Каруу жаңжал көрсүн де.", "en": "Tell him he will see a mighty conflict.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
