[{"id":"semetey-1-2013:p0529:b005:l028","ordinal":117505,"en":"To greet the orphan,"},{"id":"semetey-1-2013:p0529:b005:l029","ordinal":117506,"en":"Kumaik came in reverence,"},{"id":"semetey-1-2013:p0529:b005:l030","ordinal":117507,"en":"As though its mighty master Khan Manas had returned."},{"id":"semetey-1-2013:p0529:b005:l032","ordinal":117508,"en":"Kumaik came weeping."},{"id":"semetey-1-2013:p0529:b005:l033","ordinal":117509,"en":"That mighty creature, well known to the people,"},{"id":"semetey-1-2013:p0529:b005:l034","ordinal":117510,"en":"Left by the fierce khan gone to Judgment Day,"},{"id":"semetey-1-2013:p0529:b005:l035","ordinal":117511,"en":"Was his inheritance from his father Manas."},{"id":"semetey-1-2013:p0529:b005:l036","ordinal":117512,"en":"Crouching like a quail,"},{"id":"semetey-1-2013:p0529:b005:l037","ordinal":117513,"en":"Kumaik came creeping low."},{"id":"semetey-1-2013:p0529:b005:l038","ordinal":117514,"en":"Tears welled in its eyes,"},{"id":"semetey-1-2013:p0529:b005:l039","ordinal":117515,"en":"Kumaik let them fall."},{"id":"semetey-1-2013:p0530:b003:l001","ordinal":117516,"en":"It longed to speak but had no human tongue."},{"id":"semetey-1-2013:p0530:b003:l002","ordinal":117517,"en":"Kumaik stood helpless."},{"id":"semetey-1-2013:p0530:b003:l003","ordinal":117518,"en":"Making every bone ache,"},{"id":"semetey-1-2013:p0530:b003:l004","ordinal":117519,"en":"Kumaik stood howling."},{"id":"semetey-1-2013:p0530:b003:l005","ordinal":117520,"en":"The hair on its forehead grew thin."},{"id":"semetey-1-2013:p0530:b003:l006","ordinal":117521,"en":"Though it was an animal, that dear creature's"},{"id":"semetey-1-2013:p0530:b003:l007","ordinal":117522,"en":"Tears poured from its eyes."},{"id":"semetey-1-2013:p0530:b003:l008","ordinal":117523,"en":"Along the edge of Uch-Koshoi,"},{"id":"semetey-1-2013:p0530:b003:l009","ordinal":117524,"en":"Ranging across broad Talas,"},{"id":"semetey-1-2013:p0530:b003:l010","ordinal":117525,"en":"It had gone about barking."},{"id":"semetey-1-2013:p0530:b003:l011","ordinal":117526,"en":"It longed to speak but had no human tongue."},{"id":"semetey-1-2013:p0530:b003:l012","ordinal":117527,"en":"“My Semetey is coming,”"},{"id":"semetey-1-2013:p0530:b003:l013","ordinal":117528,"en":"It had known all along."},{"id":"semetey-1-2013:p0530:b003:l014","ordinal":117529,"en":"It had eaten its fill hunting marmots."},{"id":"semetey-1-2013:p0530:b003:l015","ordinal":117530,"en":"The ibex upon the terraces"},{"id":"semetey-1-2013:p0530:b003:l016","ordinal":117531,"en":"It had destroyed by the herd."},{"id":"semetey-1-2013:p0530:b003:l017","ordinal":117532,"en":"Upon the wild sheep in the hills,"},{"id":"semetey-1-2013:p0530:b003:l018","ordinal":117533,"en":"This very year Kumaik"},{"id":"semetey-1-2013:p0530:b003:l019","ordinal":117534,"en":"Had driven a slaughter."},{"id":"semetey-1-2013:p0530:b003:l020","ordinal":117535,"en":"The deer upon the rough ground,"},{"id":"semetey-1-2013:p0530:b003:l021","ordinal":117536,"en":"At that time Kumaik"},{"id":"semetey-1-2013:p0530:b003:l022","ordinal":117537,"en":"Had stalked and slaughtered."},{"id":"semetey-1-2013:p0530:b003:l023","ordinal":117538,"en":"The kulans upon the plains"},{"id":"semetey-1-2013:p0530:b003:l024","ordinal":117539,"en":"It had chased by the herd"},{"id":"semetey-1-2013:p0530:b003:l025","ordinal":117540,"en":"And torn open along the road."},{"id":"semetey-1-2013:p0530:b003:l026","ordinal":117541,"en":"It had sensed his coming."},{"id":"semetey-1-2013:p0530:b003:l027","ordinal":117542,"en":"“My precious one left by Manas"},{"id":"semetey-1-2013:p0530:b003:l028","ordinal":117543,"en":"Will surely come this year,” it thought."},{"id":"semetey-1-2013:p0530:b003:l029","ordinal":117544,"en":"To the dark rock before it"},{"id":"semetey-1-2013:p0530:b003:l030","ordinal":117545,"en":"It went time and again, barking:"},{"id":"semetey-1-2013:p0530:b003:l031","ordinal":117546,"en":"“Twelve years have passed."},{"id":"semetey-1-2013:p0530:b003:l032","ordinal":117547,"en":"My orphan left by ruin-bringing Manas—"},{"id":"semetey-1-2013:p0530:b003:l033","ordinal":117548,"en":"The time has come for him to arrive.”"},{"id":"semetey-1-2013:p0530:b003:l034","ordinal":117549,"en":"At Ermenduu's Soku-Tash,"},{"id":"semetey-1-2013:p0530:b003:l035","ordinal":117550,"en":"Distraught, Kumaik"},{"id":"semetey-1-2013:p0530:b003:l036","ordinal":117551,"en":"Had looked out twice from there."},{"id":"semetey-1-2013:p0530:b003:l037","ordinal":117552,"en":"Ach-Maral, covered in white wormwood—"},{"id":"semetey-1-2013:p0530:b003:l038","ordinal":117553,"en":"It had looked out six times from there."},{"id":"semetey-1-2013:p0530:b003:l039","ordinal":117554,"en":"It had crossed Zhorgo Pass,"},{"id":"semetey-1-2013:p0530:b004:l001","ordinal":117555,"en":"Traversed the ridge of Kuiuk,"},{"id":"semetey-1-2013:p0530:b004:l002","ordinal":117556,"en":"Climbed up to Kum-Bulak."},{"id":"semetey-1-2013:p0530:b004:l003","ordinal":117557,"en":"Khan Manas's Kumaik"},{"id":"semetey-1-2013:p0530:b004:l004","ordinal":117558,"en":"Had watched from there for four days."},{"id":"semetey-1-2013:p0530:b004:l005","ordinal":117559,"en":"Today Kumaik"},{"id":"semetey-1-2013:p0530:b004:l006","ordinal":117560,"en":"Had seen him from Uch-Koshoi."},{"id":"semetey-1-2013:p0530:b004:l007","ordinal":117561,"en":"From the three terraces of Tash-Moinok,"},{"id":"semetey-1-2013:p0530:b004:l008","ordinal":117562,"en":"Semetey had traveled in anguish."},{"id":"semetey-1-2013:p0530:b004:l009","ordinal":117563,"en":"It wore a golden collar on its neck."},{"id":"semetey-1-2013:p0530:b004:l010","ordinal":117564,"en":"It had known he would come this year."},{"id":"semetey-1-2013:p0530:b004:l011","ordinal":117565,"en":"For the orphan left by Manas,"},{"id":"semetey-1-2013:p0530:b004:l012","ordinal":117566,"en":"It had grieved for twelve years."},{"id":"semetey-1-2013:p0530:b004:l013","ordinal":117567,"en":"From the villains Abyke and Kobosh"},{"id":"semetey-1-2013:p0530:b004:l014","ordinal":117568,"en":"It had suffered great humiliation."},{"id":"semetey-1-2013:p0530:b004:l015","ordinal":117569,"en":"When it saw Semetey,"},{"id":"semetey-1-2013:p0530:b004:l016","ordinal":117570,"en":"When Kumaik came near,"},{"id":"semetey-1-2013:p0530:b004:l017","ordinal":117571,"en":"To that only son Almighty Allah"},{"id":"semetey-1-2013:p0530:b004:l018","ordinal":117572,"en":"Had openly granted His favor."},{"id":"semetey-1-2013:p0530:b004:l019","ordinal":117573,"en":"When he looked at Kumaik,"},{"id":"semetey-1-2013:p0530:b004:l020","ordinal":117574,"en":"There was a golden collar on its neck."},{"id":"semetey-1-2013:p0530:b004:l021","ordinal":117575,"en":"“My mother Kanykei told me:"},{"id":"semetey-1-2013:p0530:b004:l022","ordinal":117576,"en":"If Kumaik comes,"},{"id":"semetey-1-2013:p0530:b004:l023","ordinal":117577,"en":"Around its neck it will wear"},{"id":"semetey-1-2013:p0530:b004:l024","ordinal":117578,"en":"A collar made of gold, she said."},{"id":"semetey-1-2013:p0530:b004:l025","ordinal":117579,"en":"My khan father's Kumaik—"},{"id":"semetey-1-2013:p0530:b004:l026","ordinal":117580,"en":"It is Kumaik itself!"},{"id":"semetey-1-2013:p0530:b004:l027","ordinal":117581,"en":"To me, born an only child,"},{"id":"semetey-1-2013:p0530:b004:l028","ordinal":117582,"en":"My inheritance from my father"},{"id":"semetey-1-2013:p0530:b004:l029","ordinal":117583,"en":"Has come to meet me."},{"id":"semetey-1-2013:p0530:b004:l030","ordinal":117584,"en":"It has appeared from the unseen world."},{"id":"semetey-1-2013:p0530:b004:l031","ordinal":117585,"en":"May I be sacrificed for you, Kumaik,"},{"id":"semetey-1-2013:p0530:b004:l032","ordinal":117586,"en":"Who was granted to my khan father, Manas the Lion!"},{"id":"semetey-1-2013:p0530:b004:l033","ordinal":117587,"en":"You never drew back from a bear,"},{"id":"semetey-1-2013:p0530:b004:l034","ordinal":117588,"en":"Never retreated from a tiger."},{"id":"semetey-1-2013:p0530:b004:l035","ordinal":117589,"en":"You destroyed whatever you bit,"},{"id":"semetey-1-2013:p0530:b004:l036","ordinal":117590,"en":"Brought joy to the master who loosed you."},{"id":"semetey-1-2013:p0530:b004:l037","ordinal":117591,"en":"Mighty one, renowned among the people,"},{"id":"semetey-1-2013:p0530:b004:l038","ordinal":117592,"en":"My precious inheritance left by my father!”"},{"id":"semetey-1-2013:p0531:b003:l001","ordinal":117593,"en":"Putting the gray pouch-belt about his neck,"},{"id":"semetey-1-2013:p0531:b003:l002","ordinal":117594,"en":"He pressed Kumaik's head to his breast."},{"id":"semetey-1-2013:p0531:b003:l004","ordinal":117595,"en":"“My mother told me:"},{"id":"semetey-1-2013:p0531:b003:l005","ordinal":117596,"en":"Unless you crush his arrogance,"},{"id":"semetey-1-2013:p0531:b003:l006","ordinal":117597,"en":"Kumaik will bear resentment, she said."},{"id":"semetey-1-2013:p0531:b003:l007","ordinal":117598,"en":"My precious one left by my father Manas,"},{"id":"semetey-1-2013:p0531:b003:l008","ordinal":117599,"en":"Kumaik, who stands as a father to me,"},{"id":"semetey-1-2013:p0531:b003:l009","ordinal":117600,"en":"My mirror who has come to meet me!"},{"id":"semetey-1-2013:p0531:b003:l010","ordinal":117601,"en":"My ocean-like father, if only you had not died,"},{"id":"semetey-1-2013:p0531:b003:l011","ordinal":117602,"en":"If only this poor life had not known wandering!"},{"id":"semetey-1-2013:p0531:b003:l012","ordinal":117603,"en":"My leopard father, if only you had not died,"},{"id":"semetey-1-2013:p0531:b003:l013","ordinal":117604,"en":"If only this poor life had not known flight!"},{"id":"semetey-1-2013:p0531:b003:l014","ordinal":117605,"en":"May I be sacrificed for you, Kumaik!"},{"id":"semetey-1-2013:p0531:b003:l015","ordinal":117606,"en":"To Temir Khan's city"},{"id":"semetey-1-2013:p0531:b003:l016","ordinal":117607,"en":"I, poor creature, wandered away."},{"id":"semetey-1-2013:p0531:b003:l017","ordinal":117608,"en":"Bereft of your companion, Manas the Lion,"},{"id":"semetey-1-2013:p0531:b003:l018","ordinal":117609,"en":"You, poor creature, wandered aimlessly."},{"id":"semetey-1-2013:p0531:b003:l019","ordinal":117610,"en":"To Kara Khan's city,"},{"id":"semetey-1-2013:p0531:b003:l020","ordinal":117611,"en":"With no kinsman to care for me,"},{"id":"semetey-1-2013:p0531:b003:l021","ordinal":117612,"en":"I, poor creature, fled."},{"id":"semetey-1-2013:p0531:b003:l022","ordinal":117613,"en":"Bereft of Khan Manas,"},{"id":"semetey-1-2013:p0531:b003:l023","ordinal":117614,"en":"Seeking wolves across the steppe,"},{"id":"semetey-1-2013:p0531:b003:l024","ordinal":117615,"en":"You, poor creature, were left wandering!"},{"id":"semetey-1-2013:p0531:b003:l025","ordinal":117616,"en":"My leopard father, if only you had not died,"},{"id":"semetey-1-2013:p0531:b003:l026","ordinal":117617,"en":"If only I had not fled to Bukhara,"},{"id":"semetey-1-2013:p0531:b003:l027","ordinal":117618,"en":"Nor returned as an orphan!"},{"id":"semetey-1-2013:p0531:b003:l028","ordinal":117619,"en":"Left on the steppe without support,"},{"id":"semetey-1-2013:p0531:b003:l029","ordinal":117620,"en":"Such humiliation as this—"},{"id":"semetey-1-2013:p0531:b003:l030","ordinal":117621,"en":"May I be sacrificed for you, Kumaik—"},{"id":"semetey-1-2013:p0531:b003:l031","ordinal":117622,"en":"May God grant it to none of His servants!"},{"id":"semetey-1-2013:p0531:b003:l032","ordinal":117623,"en":"I, the destitute one left by my father,"},{"id":"semetey-1-2013:p0531:b003:l033","ordinal":117624,"en":"And you, the destitute one roaming the steppe!”"},{"id":"semetey-1-2013:p0531:b003:l034","ordinal":117625,"en":"When he saw Kumaik,"},{"id":"semetey-1-2013:p0531:b003:l035","ordinal":117626,"en":"The orphan boy left by Manas"},{"id":"semetey-1-2013:p0531:b003:l036","ordinal":117627,"en":"Felt as though he had seen his father Manas."},{"id":"semetey-1-2013:p0531:b003:l037","ordinal":117628,"en":"His heart was torn with grief,"},{"id":"semetey-1-2013:p0531:b003:l038","ordinal":117629,"en":"His tears poured out,"},{"id":"semetey-1-2013:p0531:b003:l039","ordinal":117630,"en":"His very ribs seemed to split apart."},{"id":"semetey-1-2013:p0531:b005:l001","ordinal":117631,"en":"As though his father Manas had risen from the dead"},{"id":"semetey-1-2013:p0531:b005:l002","ordinal":117632,"en":"And come before him,"},{"id":"semetey-1-2013:p0531:b005:l003","ordinal":117633,"en":"Embracing him and wailing aloud,"},{"id":"semetey-1-2013:p0531:b005:l004","ordinal":117634,"en":"Semetey was overwhelmed."},{"id":"semetey-1-2013:p0531:b005:l005","ordinal":117635,"en":"Kumaik howled and wailed,"},{"id":"semetey-1-2013:p0531:b005:l006","ordinal":117636,"en":"Semetey wept with ringing cries."},{"id":"semetey-1-2013:p0531:b005:l007","ordinal":117637,"en":"From his dear, quail-like eyes"},{"id":"semetey-1-2013:p0531:b005:l008","ordinal":117638,"en":"Tears fell in separate streams."},{"id":"semetey-1-2013:p0531:b005:l009","ordinal":117639,"en":"From his dark, falcon-like eyes"},{"id":"semetey-1-2013:p0531:b005:l010","ordinal":117640,"en":"Tears fell with every blink."},{"id":"semetey-1-2013:p0531:b005:l011","ordinal":117641,"en":"Greeting Kumaik,"},{"id":"semetey-1-2013:p0531:b005:l012","ordinal":117642,"en":"Semetey kissed him more fondly than a person."},{"id":"semetey-1-2013:p0531:b005:l013","ordinal":117643,"en":"When he saw Kumaik,"},{"id":"semetey-1-2013:p0531:b005:l014","ordinal":117644,"en":"The boy grieved, weeping blood,"},{"id":"semetey-1-2013:p0531:b005:l015","ordinal":117645,"en":"Unable to stop his anguished weeping:"},{"id":"semetey-1-2013:p0531:b005:l016","ordinal":117646,"en":"“My inheritance left by my khan father Manas,"},{"id":"semetey-1-2013:p0531:b005:l018","ordinal":117647,"en":"Oh, may I be sacrificed for you, Kumaik!"},{"id":"semetey-1-2013:p0531:b005:l019","ordinal":117648,"en":"Let no resentment remain in your heart!”"},{"id":"semetey-1-2013:p0531:b005:l020","ordinal":117649,"en":"Leading Kumaik,"},{"id":"semetey-1-2013:p0531:b005:l021","ordinal":117650,"en":"Semetey traveled on, deeply stirred."},{"id":"semetey-1-2013:p0531:b005:l022","ordinal":117651,"en":"A short-tailed dun mare, a creature of the unseen,"},{"id":"semetey-1-2013:p0531:b005:l023","ordinal":117652,"en":"Appeared before him."},{"id":"semetey-1-2013:p0531:b005:l024","ordinal":117653,"en":"He caught the dun mare and slaughtered it."},{"id":"semetey-1-2013:p0531:b005:l025","ordinal":117654,"en":"Its belly fat was a span thick."},{"id":"semetey-1-2013:p0531:b005:l026","ordinal":117655,"en":"“Until I come back this way,"},{"id":"semetey-1-2013:p0531:b005:l027","ordinal":117656,"en":"Eat your fill of this gift and rest,” he said,"},{"id":"semetey-1-2013:p0531:b005:l028","ordinal":117657,"en":"And left Kumaik there."},{"id":"semetey-1-2013:p0531:b005:l029","ordinal":117658,"en":"Then he journeyed farther,"},{"id":"semetey-1-2013:p0531:b005:l030","ordinal":117659,"en":"Crossed ridge after rugged ridge,"},{"id":"semetey-1-2013:p0531:b005:l031","ordinal":117660,"en":"Traversed rough, ridged country,"},{"id":"semetey-1-2013:p0531:b005:l032","ordinal":117661,"en":"And entered Ken-Kol."},{"id":"semetey-1-2013:p0531:b005:l033","ordinal":117662,"en":"In Ken-Kol he saw wonders."},{"id":"semetey-1-2013:p0531:b005:l034","ordinal":117663,"en":"On the curving slopes of Imerme-Too,"},{"id":"semetey-1-2013:p0531:b005:l035","ordinal":117664,"en":"On the broad ground where saker falcons nested,"},{"id":"semetey-1-2013:p0531:b005:l036","ordinal":117665,"en":"When generous Manas was alive,"},{"id":"semetey-1-2013:p0531:b005:l037","ordinal":117666,"en":"In the nests where falcons bred,"},{"id":"semetey-1-2013:p0531:b005:l038","ordinal":117667,"en":"He went on again, deeply stirred,"},{"id":"semetey-1-2013:p0531:b005:l039","ordinal":117668,"en":"Your orphan left by Manas."},{"id":"semetey-1-2013:p0532:b003:l001","ordinal":117669,"en":"He encountered a night blessed by Kydyr."},{"id":"semetey-1-2013:p0532:b003:l002","ordinal":117670,"en":"Akshumkar, left by his father Manas,"},{"id":"semetey-1-2013:p0532:b003:l003","ordinal":117671,"en":"Appeared before him."},{"id":"semetey-1-2013:p0532:b003:l004","ordinal":117672,"en":"“The orphan will come this year,”"},{"id":"semetey-1-2013:p0532:b003:l005","ordinal":117673,"en":"Akshumkar had known"},{"id":"semetey-1-2013:p0532:b003:l006","ordinal":117674,"en":"He would truly come."},{"id":"semetey-1-2013:p0532:b003:l007","ordinal":117675,"en":"Brooding on a nest, ranging along the rocks,"},{"id":"semetey-1-2013:p0532:b003:l008","ordinal":117676,"en":"It had grieved all the while."},{"id":"semetey-1-2013:p0532:b003:l009","ordinal":117677,"en":"The orphan left by Manas"},{"id":"semetey-1-2013:p0532:b003:l010","ordinal":117678,"en":"It had been seeking to see."},{"id":"semetey-1-2013:p0532:b003:l011","ordinal":117679,"en":"Its charge to that orphan"},{"id":"semetey-1-2013:p0532:b003:l012","ordinal":117680,"en":"It had been seeking to entrust."},{"id":"semetey-1-2013:p0532:b003:l013","ordinal":117681,"en":"When Manas the Leopard died,"},{"id":"semetey-1-2013:p0532:b003:l014","ordinal":117682,"en":"It broke its golden jesses,"},{"id":"semetey-1-2013:p0532:b003:l015","ordinal":117683,"en":"Akshumkar tore them apart."},{"id":"semetey-1-2013:p0532:b003:l016","ordinal":117684,"en":"Letting no one catch it,"},{"id":"semetey-1-2013:p0532:b003:l017","ordinal":117685,"en":"Letting no one see it,"},{"id":"semetey-1-2013:p0532:b003:l018","ordinal":117686,"en":"Akshumkar had flown away."},{"id":"semetey-1-2013:p0532:b003:l019","ordinal":117687,"en":"After waiting a full six days,"},{"id":"semetey-1-2013:p0532:b003:l020","ordinal":117688,"en":"Akshumkar had vanished."},{"id":"semetey-1-2013:p0532:b003:l021","ordinal":117689,"en":"Breaking its silver jesses,"},{"id":"semetey-1-2013:p0532:b003:l022","ordinal":117690,"en":"Akshumkar had disappeared into the unseen."},{"id":"semetey-1-2013:p0532:b003:l023","ordinal":117691,"en":"It ranged across the whole world."},{"id":"semetey-1-2013:p0532:b003:l024","ordinal":117692,"en":"The shrines upon the earth,"},{"id":"semetey-1-2013:p0532:b003:l025","ordinal":117693,"en":"It visited without missing one."},{"id":"semetey-1-2013:p0532:b003:l026","ordinal":117694,"en":"Zhelpinish at the world's end,"},{"id":"semetey-1-2013:p0532:b003:l027","ordinal":117695,"en":"The place where birds make pilgrimage,"},{"id":"semetey-1-2013:p0532:b003:l028","ordinal":117696,"en":"It had sought out."},{"id":"semetey-1-2013:p0532:b003:l029","ordinal":117697,"en":"After staying seven nights there,"},{"id":"semetey-1-2013:p0532:b003:l030","ordinal":117698,"en":"It had visited Medina."},{"id":"semetey-1-2013:p0532:b003:l031","ordinal":117699,"en":"Mecca and Medina—"},{"id":"semetey-1-2013:p0532:b003:l032","ordinal":117700,"en":"His khan father's Akshumkar"},{"id":"semetey-1-2013:p0532:b003:l033","ordinal":117701,"en":"Had stayed there for five years."},{"id":"semetey-1-2013:p0532:b003:l034","ordinal":117702,"en":"In Egypt and Baghdad"},{"id":"semetey-1-2013:p0532:b003:l035","ordinal":117703,"en":"It had spent seven winters."},{"id":"semetey-1-2013:p0532:b003:l036","ordinal":117704,"en":"“Those seven and those five"},{"id":"semetey-1-2013:p0532:b003:l037","ordinal":117705,"en":"Have made twelve years."},{"id":"semetey-1-2013:p0532:b003:l038","ordinal":117706,"en":"My orphan left by the generous lord,"},{"id":"semetey-1-2013:p0532:b003:l039","ordinal":117707,"en":"To the Kyrgyz in Talas"},{"id":"semetey-1-2013:p0532:b004:l001","ordinal":117708,"en":"The time has come for him to return."},{"id":"semetey-1-2013:p0532:b004:l002","ordinal":117709,"en":"The one God—"},{"id":"semetey-1-2013:p0532:b004:l003","ordinal":117710,"en":"The time has come to grant my wish.”"},{"id":"semetey-1-2013:p0532:b004:l004","ordinal":117711,"en":"That year Akshumkar,"},{"id":"semetey-1-2013:p0532:b004:l005","ordinal":117712,"en":"Hunting swans for food along the way,"},{"id":"semetey-1-2013:p0532:b004:l006","ordinal":117713,"en":"Traveled back from Mecca,"},{"id":"semetey-1-2013:p0532:b004:l007","ordinal":117714,"en":"Flew over the dry land,"},{"id":"semetey-1-2013:p0532:b004:l008","ordinal":117715,"en":"Searched the face of the earth."},{"id":"semetey-1-2013:p0532:b004:l009","ordinal":117716,"en":"Chatyr-Kol at the head of the Naryn—"},{"id":"semetey-1-2013:p0532:b004:l010","ordinal":117717,"en":"With a pale kumpai falcon there,"},{"id":"semetey-1-2013:p0532:b004:l011","ordinal":117718,"en":"It joined its body in courtship."},{"id":"semetey-1-2013:p0532:b004:l012","ordinal":117719,"en":"They had mated,"},{"id":"semetey-1-2013:p0532:b004:l013","ordinal":117720,"en":"And it was heavy with young."},{"id":"semetey-1-2013:p0532:b004:l014","ordinal":117721,"en":"To the curving slope of Imerme-Too,"},{"id":"semetey-1-2013:p0532:b004:l015","ordinal":117722,"en":"To the broad ground where saker falcons breed,"},{"id":"semetey-1-2013:p0532:b004:l016","ordinal":117723,"en":"It came and built a nest."},{"id":"semetey-1-2013:p0532:b004:l017","ordinal":117724,"en":"“Honoring my father's spirit,"},{"id":"semetey-1-2013:p0532:b004:l018","ordinal":117725,"en":"I shall obey his words."},{"id":"semetey-1-2013:p0532:b004:l019","ordinal":117726,"en":"My child to his child"},{"id":"semetey-1-2013:p0532:b004:l020","ordinal":117727,"en":"I shall give as a sacred trust.”"},{"id":"semetey-1-2013:p0532:b004:l021","ordinal":117728,"en":"The sorrows within its heart"},{"id":"semetey-1-2013:p0532:b004:l022","ordinal":117729,"en":"It banished, leaving none."},{"id":"semetey-1-2013:p0532:b004:l023","ordinal":117730,"en":"Laying its offspring in winter,"},{"id":"semetey-1-2013:p0532:b004:l024","ordinal":117731,"en":"Counting the measure of the days,"},{"id":"semetey-1-2013:p0532:b004:l025","ordinal":117732,"en":"It left them in the frost."},{"id":"semetey-1-2013:p0532:b004:l026","ordinal":117733,"en":"The cold ended and spring arrived."},{"id":"semetey-1-2013:p0532:b004:l027","ordinal":117734,"en":"When the season drew close to spring,"},{"id":"semetey-1-2013:p0532:b004:l028","ordinal":117735,"en":"When the days grew mild,"},{"id":"semetey-1-2013:p0532:b004:l029","ordinal":117736,"en":"With a rushing sound through the ravines,"},{"id":"semetey-1-2013:p0532:b004:l030","ordinal":117737,"en":"When meltwater flowed full,"},{"id":"semetey-1-2013:p0532:b004:l031","ordinal":117738,"en":"The patchy snow disappeared."},{"id":"semetey-1-2013:p0532:b004:l032","ordinal":117739,"en":"When the days grew mild,"},{"id":"semetey-1-2013:p0532:b004:l033","ordinal":117740,"en":"It spread the feathers of its breast."},{"id":"semetey-1-2013:p0532:b004:l034","ordinal":117741,"en":"Brooding for thirty-six days,"},{"id":"semetey-1-2013:p0532:b004:l035","ordinal":117742,"en":"The falcon hatched its offspring."},{"id":"semetey-1-2013:p0532:b004:l036","ordinal":117743,"en":"From Kaiypchy Pass"},{"id":"semetey-1-2013:p0532:b004:l037","ordinal":117744,"en":"It slaughtered geese."},{"id":"semetey-1-2013:p0532:b004:l038","ordinal":117745,"en":"From the river at Kum-Aryk"},{"id":"semetey-1-2013:p0532:b004:l039","ordinal":117746,"en":"It carried swans back."},{"id":"semetey-1-2013:p0533:b003:l001","ordinal":117747,"en":"Hunting snowcocks for food,"},{"id":"semetey-1-2013:p0533:b003:l002","ordinal":117748,"en":"It caught and tore open bustards."},{"id":"semetey-1-2013:p0533:b003:l003","ordinal":117749,"en":"“Semetey will come this year,”"},{"id":"semetey-1-2013:p0533:b003:l004","ordinal":117750,"en":"Akshumkar, left by his father Manas,"},{"id":"semetey-1-2013:p0533:b003:l005","ordinal":117751,"en":"Had longed for the orphan."},{"id":"semetey-1-2013:p0533:b003:l006","ordinal":117752,"en":"Flying over the mountains,"},{"id":"semetey-1-2013:p0533:b003:l007","ordinal":117753,"en":"Attacking whatever challenged it,"},{"id":"semetey-1-2013:p0533:b003:l008","ordinal":117754,"en":"The dear creature soared,"},{"id":"semetey-1-2013:p0533:b003:l009","ordinal":117755,"en":"Ranging over the earth."},{"id":"semetey-1-2013:p0533:b003:l010","ordinal":117756,"en":"The mighty falcon grew excited."},{"id":"semetey-1-2013:p0533:b003:l011","ordinal":117757,"en":"Its talons were iron, its jess-clasp gold."},{"id":"semetey-1-2013:p0533:b003:l012","ordinal":117758,"en":"Circling, Akshumkar"},{"id":"semetey-1-2013:p0533:b003:l013","ordinal":117759,"en":"Came upon Semetey."},{"id":"semetey-1-2013:p0533:b003:l014","ordinal":117760,"en":"“Ah, my mother told me:"}]
