[{"id":"manas-2010:p0438:b001:l032","ordinal":20225,"en":"Your accomplished one reached them and thrust his spear,"},{"id":"manas-2010:p0438:b001:l033","ordinal":20226,"en":"Using abundant, surpassing skill."},{"id":"manas-2010:p0438:b001:l034","ordinal":20227,"en":"The champions his spear reached"},{"id":"manas-2010:p0438:b001:l035","ordinal":20228,"en":"Fell from their horses, sprawling."},{"id":"manas-2010:p0438:b001:l036","ordinal":20229,"en":"Their champions like camels and rocks"},{"id":"manas-2010:p0438:b001:l037","ordinal":20230,"en":"Were slaughtered, stretched out flat."},{"id":"manas-2010:p0438:b001:l038","ordinal":20231,"en":"Those who saw had no regret."},{"id":"manas-2010:p0438:b001:l039","ordinal":20232,"en":"Because of Kutubiy,"},{"id":"manas-2010:p0438:b001:l040","ordinal":20233,"en":"Facing the Chinese,"},{"id":"manas-2010:p0438:b001:l041","ordinal":20234,"en":"Illustrious Manas's"},{"id":"manas-2010:p0438:b001:l042","ordinal":20235,"en":"Strife was wrought upon the Kalmyks."},{"id":"manas-2010:p0438:b001:l043","ordinal":20236,"en":"Whirling his spear without stopping,"},{"id":"manas-2010:p0438:b001:l044","ordinal":20237,"en":"The mass of Black Manchus,"},{"id":"manas-2010:p0438:b001:l045","ordinal":20238,"en":"He broke apart their ranks."},{"id":"manas-2010:p0438:b001:l046","ordinal":20239,"en":"Those who came close to grapple,"},{"id":"manas-2010:p0438:b001:l047","ordinal":20240,"en":"He beat with his battle-axe."},{"id":"manas-2010:p0438:b001:l048","ordinal":20241,"en":"The champions skilled at riding,"},{"id":"manas-2010:p0439:b001:l001","ordinal":20242,"en":"Unable to find their wits,"},{"id":"manas-2010:p0439:b001:l002","ordinal":20243,"en":"Fled, jolting along."},{"id":"manas-2010:p0439:b001:l003","ordinal":20244,"en":"Shattering seven hundred,"},{"id":"manas-2010:p0439:b001:l004","ordinal":20245,"en":"The champions farther away,"},{"id":"manas-2010:p0439:b001:l005","ordinal":20246,"en":"He chased from behind with his spear."},{"id":"manas-2010:p0439:b001:l006","ordinal":20247,"en":"Galloping on the courser Toruchaar,"},{"id":"manas-2010:p0439:b001:l007","ordinal":20248,"en":"All their giants and monsters,"},{"id":"manas-2010:p0439:b001:l008","ordinal":20249,"en":"Your magnanimous one entered, bringing them down."},{"id":"manas-2010:p0439:b001:l009","ordinal":20250,"en":"The spur of broad Altai—"},{"id":"manas-2010:p0439:b001:l010","ordinal":20251,"en":"They fled to the spur and sought shelter."},{"id":"manas-2010:p0439:b001:l011","ordinal":20252,"en":"Those who escaped alive, not dead,"},{"id":"manas-2010:p0439:b001:l012","ordinal":20253,"en":"Were drenched in crimson blood."},{"id":"manas-2010:p0439:b001:l013","ordinal":20254,"en":"Blue haze, burning dust,"},{"id":"manas-2010:p0439:b001:l014","ordinal":20255,"en":"Their threadlike mustaches brushed smooth,"},{"id":"manas-2010:p0439:b001:l015","ordinal":20256,"en":"Many Chinese souls were slain."},{"id":"manas-2010:p0439:b001:l016","ordinal":20257,"en":"Fit to be felt throughout the world,"},{"id":"manas-2010:p0439:b001:l017","ordinal":20258,"en":"Your magnanimous one wrought strife."},{"id":"manas-2010:p0439:b001:l018","ordinal":20259,"en":"Fortunate Kutubiy,"},{"id":"manas-2010:p0439:b001:l019","ordinal":20260,"en":"Your valiant, hapless Manas"},{"id":"manas-2010:p0439:b001:l020","ordinal":20261,"en":"Rescued him."},{"id":"manas-2010:p0439:b001:l021","ordinal":20262,"en":"The unbelievers like dark willows,"},{"id":"manas-2010:p0439:b001:l022","ordinal":20263,"en":"He speared again and pursued,"},{"id":"manas-2010:p0439:b001:l023","ordinal":20264,"en":"Driving them toward the emperor."},{"id":"manas-2010:p0439:b001:l024","ordinal":20265,"en":"Through their middle, the wolf-warrior"},{"id":"manas-2010:p0439:b001:l025","ordinal":20266,"en":"Bored his way."},{"id":"manas-2010:p0439:b001:l026","ordinal":20267,"en":"Around them, Kutubiy"},{"id":"manas-2010:p0439:b001:l027","ordinal":20268,"en":"Cut his way through in slaughter."},{"id":"manas-2010:p0439:b001:l028","ordinal":20269,"en":"On the governors' side, Khan Manas"},{"id":"manas-2010:p0439:b001:l029","ordinal":20270,"en":"Closed them in."},{"id":"manas-2010:p0439:b001:l030","ordinal":20271,"en":"Right through their middle, Kutubiy"},{"id":"manas-2010:p0439:b001:l031","ordinal":20272,"en":"Beat his way."},{"id":"manas-2010:p0439:b001:l032","ordinal":20273,"en":"Through their middle, Kutubiy"},{"id":"manas-2010:p0439:b001:l033","ordinal":20274,"en":"Came reaping his path."},{"id":"manas-2010:p0439:b001:l034","ordinal":20275,"en":"From behind, the Kalmyks,"},{"id":"manas-2010:p0439:b001:l035","ordinal":20276,"en":"Lion Manas, the leopard,"},{"id":"manas-2010:p0439:b001:l036","ordinal":20277,"en":"Leaving not one alive,"},{"id":"manas-2010:p0439:b001:l037","ordinal":20278,"en":"Came sucking their lives away."},{"id":"manas-2010:p0439:b001:l038","ordinal":20279,"en":"Their governors floundered;"},{"id":"manas-2010:p0439:b001:l039","ordinal":20280,"en":"They had taken to flight."},{"id":"manas-2010:p0439:b001:l040","ordinal":20281,"en":"Not letting the fleeing enemy escape,"},{"id":"manas-2010:p0439:b001:l041","ordinal":20282,"en":"Lion Manas and Kutubiy"},{"id":"manas-2010:p0439:b001:l042","ordinal":20283,"en":"Had overtaken them."},{"id":"manas-2010:p0439:b001:l043","ordinal":20284,"en":"Whatever they chose, to the utmost,"},{"id":"manas-2010:p0439:b001:l044","ordinal":20285,"en":"They had done."},{"id":"manas-2010:p0439:b001:l045","ordinal":20286,"en":"The swarming Chinese,"},{"id":"manas-2010:p0439:b001:l046","ordinal":20287,"en":"Valiant Manas then"},{"id":"manas-2010:p0439:b001:l047","ordinal":20288,"en":"Had slaughtered them."},{"id":"manas-2010:p0439:b001:l048","ordinal":20289,"en":"His tusks jutting out,"},{"id":"manas-2010:p0440:b001:l001","ordinal":20290,"en":"Horse corpses fell in mountains."},{"id":"manas-2010:p0440:b001:l002","ordinal":20291,"en":"Their mustaches smoothed flat,"},{"id":"manas-2010:p0440:b001:l003","ordinal":20292,"en":"Men's corpses fell in bundles."},{"id":"manas-2010:p0440:b001:l004","ordinal":20293,"en":"All the level ground became dust,"},{"id":"manas-2010:p0440:b001:l005","ordinal":20294,"en":"The hollows and ravines"},{"id":"manas-2010:p0440:b001:l006","ordinal":20295,"en":"Became flowing red blood."},{"id":"manas-2010:p0440:b001:l007","ordinal":20296,"en":"Unable to collect their wits,"},{"id":"manas-2010:p0440:b001:l008","ordinal":20297,"en":"Against your lion born a champion,"},{"id":"manas-2010:p0440:b001:l009","ordinal":20298,"en":"Unable to face him and thrust a spear,"},{"id":"manas-2010:p0440:b001:l010","ordinal":20299,"en":"The Manchu people who claimed dominion"},{"id":"manas-2010:p0440:b001:l011","ordinal":20300,"en":"Scattered their own possessions."},{"id":"manas-2010:p0440:b001:l012","ordinal":20301,"en":"Despairing of their fly-like lives,"},{"id":"manas-2010:p0440:b001:l013","ordinal":20302,"en":"All their mighty giants"},{"id":"manas-2010:p0440:b001:l014","ordinal":20303,"en":"Panicked, unable to find a way."},{"id":"manas-2010:p0440:b001:l015","ordinal":20304,"en":"Of many swift tulpars,"},{"id":"manas-2010:p0440:b001:l016","ordinal":20305,"en":"The saddles slipped beneath their bellies;"},{"id":"manas-2010:p0440:b001:l017","ordinal":20306,"en":"Many more struggled to break free."},{"id":"manas-2010:p0440:b001:l018","ordinal":20307,"en":"Parted from their loved ones,"},{"id":"manas-2010:p0440:b001:l019","ordinal":20308,"en":"“The blood-drinker has slaughtered us!”"},{"id":"manas-2010:p0440:b001:l020","ordinal":20309,"en":"Still more went about wailing."},{"id":"manas-2010:p0440:b001:l021","ordinal":20310,"en":"Their cruppers snapped,"},{"id":"manas-2010:p0440:b001:l022","ordinal":20311,"en":"Unable to find any way,"},{"id":"manas-2010:p0440:b001:l023","ordinal":20312,"en":"Many more went about in panic."},{"id":"manas-2010:p0440:b001:l024","ordinal":20313,"en":"Having lost their spears,"},{"id":"manas-2010:p0440:b001:l025","ordinal":20314,"en":"Of their lives held in trust,"},{"id":"manas-2010:p0440:b001:l026","ordinal":20315,"en":"Many more utterly despaired."},{"id":"manas-2010:p0440:b001:l027","ordinal":20316,"en":"Their loads tipped, dangling loose;"},{"id":"manas-2010:p0440:b001:l028","ordinal":20317,"en":"Many more had come to a halt."},{"id":"manas-2010:p0440:b001:l029","ordinal":20318,"en":"Lost on the open plain,"},{"id":"manas-2010:p0440:b001:l030","ordinal":20319,"en":"Unable to collect their wits,"},{"id":"manas-2010:p0440:b001:l031","ordinal":20320,"en":"Many more went about wailing."},{"id":"manas-2010:p0440:b001:l032","ordinal":20321,"en":"If you would see a spectacle, see it here!"},{"id":"manas-2010:p0440:b001:l033","ordinal":20322,"en":"The falcons Manas and Kutubiy"},{"id":"manas-2010:p0440:b001:l034","ordinal":20323,"en":"Slaughtered, butchered, and scattered them."},{"id":"manas-2010:p0440:b001:l035","ordinal":20324,"en":"Those left on the open plain,"},{"id":"manas-2010:p0440:b001:l036","ordinal":20325,"en":"Unable to collect their wits,"},{"id":"manas-2010:p0440:b001:l037","ordinal":20326,"en":"Bellowed, “I have been left behind!”"},{"id":"manas-2010:p0440:b001:l038","ordinal":20327,"en":"Without looking up or down,"},{"id":"manas-2010:p0440:b001:l039","ordinal":20328,"en":"Without sparing his life at all,"},{"id":"manas-2010:p0440:b001:l040","ordinal":20329,"en":"The leopard born to rule"},{"id":"manas-2010:p0440:b001:l041","ordinal":20330,"en":"Had pursued and scattered them."},{"id":"manas-2010:p0440:b001:l042","ordinal":20331,"en":"The Manchus fled in a rush,"},{"id":"manas-2010:p0440:b001:l043","ordinal":20332,"en":"Skirting the Altay mountains."},{"id":"manas-2010:p0440:b001:l044","ordinal":20333,"en":"Behind them the hero Manas"},{"id":"manas-2010:p0440:b001:l045","ordinal":20334,"en":"Drove and slaughtered them, watching their course."},{"id":"manas-2010:p0440:b001:l046","ordinal":20335,"en":"The Manchus who claimed dominion"},{"id":"manas-2010:p0440:b001:l047","ordinal":20336,"en":"Had scattered their own possessions."},{"id":"manas-2010:p0440:b001:l048","ordinal":20337,"en":"Those who survived the dead"},{"id":"manas-2010:p0441:b001:l001","ordinal":20338,"en":"Bent low on their horses,"},{"id":"manas-2010:p0441:b001:l002","ordinal":20339,"en":"Fled away bellowing."},{"id":"manas-2010:p0441:b001:l003","ordinal":20340,"en":"The Black Kalmyks and Manchus"},{"id":"manas-2010:p0441:b001:l004","ordinal":20341,"en":"Reared back in terrible fright."},{"id":"manas-2010:p0441:b001:l005","ordinal":20342,"en":"The bells were rung fiercely;"},{"id":"manas-2010:p0441:b001:l006","ordinal":20343,"en":"The army lost its senses."},{"id":"manas-2010:p0441:b001:l007","ordinal":20344,"en":"Thus they fled in alarm,"},{"id":"manas-2010:p0441:b001:l008","ordinal":20345,"en":"Looming up and down,"},{"id":"manas-2010:p0441:b001:l009","ordinal":20346,"en":"Their governors slaughtered,"},{"id":"manas-2010:p0441:b001:l010","ordinal":20347,"en":"Their horses taken as booty."},{"id":"manas-2010:p0441:b001:l011","ordinal":20348,"en":"To pursue and slaughter them from behind,"},{"id":"manas-2010:p0441:b001:l012","ordinal":20349,"en":"Restless, Manas held nothing back,"},{"id":"manas-2010:p0441:b001:l013","ordinal":20350,"en":"Those who survived the dead,"},{"id":"manas-2010:p0441:b001:l014","ordinal":20351,"en":"At the broad Altay's crosswise ridge,"},{"id":"manas-2010:p0441:b001:l015","ordinal":20352,"en":"Took refuge at Kara-Too."},{"id":"manas-2010:p0441:b001:l016","ordinal":20353,"en":"When they fled there for refuge,"},{"id":"manas-2010:p0441:b001:l017","ordinal":20354,"en":"Offering his head to the hero Manas,"},{"id":"manas-2010:p0441:b001:l018","ordinal":20355,"en":"Ezkara came as an envoy."},{"id":"manas-2010:p0441:b003:l001","ordinal":20356,"en":"“Warrior Manas, blue-maned lion,"},{"id":"manas-2010:p0441:b003:l002","ordinal":20357,"en":"Of the mighty giants who fought you,"},{"id":"manas-2010:p0441:b003:l003","ordinal":20358,"en":"You slaughtered them all, surpassing hero!"},{"id":"manas-2010:p0441:b003:l004","ordinal":20359,"en":"Your fortune is complete;"},{"id":"manas-2010:p0441:b003:l005","ordinal":20360,"en":"Today your lionhood became known."},{"id":"manas-2010:p0441:b003:l006","ordinal":20361,"en":"Upon Beijing, beyond even the Flood's reach,"},{"id":"manas-2010:p0441:b003:l007","ordinal":20362,"en":"You unleashed a terrible hell."},{"id":"manas-2010:p0441:b003:l008","ordinal":20363,"en":"The many wrestlers gathered there,"},{"id":"manas-2010:p0441:b003:l009","ordinal":20364,"en":"You slaughtered and left them in heaps."},{"id":"manas-2010:p0441:b003:l010","ordinal":20365,"en":"Born beyond others in Altay,"},{"id":"manas-2010:p0441:b003:l011","ordinal":20366,"en":"Champion Manas, hear my words!"},{"id":"manas-2010:p0441:b003:l012","ordinal":20367,"en":"Firing shots at twelve years old,"},{"id":"manas-2010:p0441:b003:l013","ordinal":20368,"en":"You brought uproar on Beijing."},{"id":"manas-2010:p0441:b003:l014","ordinal":20369,"en":"Like a falcon to whom one binds one's hopes,"},{"id":"manas-2010:p0441:b003:l015","ordinal":20370,"en":"You have proved a support."},{"id":"manas-2010:p0441:b003:l016","ordinal":20371,"en":"Born greater than mortals,"},{"id":"manas-2010:p0441:b003:l017","ordinal":20372,"en":"You have proved a lion."},{"id":"manas-2010:p0441:b003:l018","ordinal":20373,"en":"Driven by a khan in arm guards,"},{"id":"manas-2010:p0441:b003:l019","ordinal":20374,"en":"My blood-drinker, we fell upon you."},{"id":"manas-2010:p0441:b003:l020","ordinal":20375,"en":"Our governors slaughtered all together,"},{"id":"manas-2010:p0441:b003:l021","ordinal":20376,"en":"My blood-drinker, we submit to you."},{"id":"manas-2010:p0442:b001:l001","ordinal":20377,"en":"You showed tremendous valor."},{"id":"manas-2010:p0442:b001:l002","ordinal":20378,"en":"Your ancient vengeance"},{"id":"manas-2010:p0442:b001:l003","ordinal":20379,"en":"You have now taken upon us."},{"id":"manas-2010:p0442:b001:l004","ordinal":20380,"en":"After Esenkan gave his order,"},{"id":"manas-2010:p0442:b001:l005","ordinal":20381,"en":"We many giants fell upon you."},{"id":"manas-2010:p0442:b001:l006","ordinal":20382,"en":"You slaughtered and destroyed the heroes."},{"id":"manas-2010:p0442:b001:l007","ordinal":20383,"en":"Ah, warrior, we submit to you!"},{"id":"manas-2010:p0442:b001:l008","ordinal":20384,"en":"Never ruled by Sulayman,"},{"id":"manas-2010:p0442:b001:l009","ordinal":20385,"en":"Here is the gated land of Beijing."},{"id":"manas-2010:p0442:b001:l010","ordinal":20386,"en":"Rule it without slaughter or butchery;"},{"id":"manas-2010:p0442:b001:l011","ordinal":20387,"en":"Here are the Chinese people with their courts!"},{"id":"manas-2010:p0442:b001:l012","ordinal":20388,"en":"Before you, warrior,"},{"id":"manas-2010:p0442:b001:l013","ordinal":20389,"en":"We will offer everything."},{"id":"manas-2010:p0442:b001:l014","ordinal":20390,"en":"Saying ‘We submit,’ presenting horses,"},{"id":"manas-2010:p0442:b001:l015","ordinal":20391,"en":"We offer our very heads!"},{"id":"manas-2010:p0442:b001:l016","ordinal":20392,"en":"If you are a lion of fierce wrath,"},{"id":"manas-2010:p0442:b001:l017","ordinal":20393,"en":"If you are a hero like a towering mountain,"},{"id":"manas-2010:p0442:b001:l018","ordinal":20394,"en":"Make us one promise."},{"id":"manas-2010:p0442:b001:l019","ordinal":20395,"en":"If you are growing angry,"},{"id":"manas-2010:p0442:b001:l020","ordinal":20396,"en":"Let us offer before you"},{"id":"manas-2010:p0442:b001:l021","ordinal":20397,"en":"Your lands of Altay and Khangay."},{"id":"manas-2010:p0442:b001:l022","ordinal":20398,"en":"Let us give them all together,"},{"id":"manas-2010:p0442:b001:l023","ordinal":20399,"en":"Your Kalmyk and Manchu peoples."},{"id":"manas-2010:p0442:b001:l024","ordinal":20400,"en":"Here are the Chinese people with their ruler;"},{"id":"manas-2010:p0442:b001:l025","ordinal":20401,"en":"If you would cut off my head, here I am!"},{"id":"manas-2010:p0442:b001:l026","ordinal":20402,"en":"Agree to what I say."},{"id":"manas-2010:p0442:b001:l027","ordinal":20403,"en":"If you truly are a lion,"},{"id":"manas-2010:p0442:b001:l028","ordinal":20404,"en":"Grant us three days' respite!"},{"id":"manas-2010:p0442:b001:l029","ordinal":20405,"en":"Our governors and our khan,"},{"id":"manas-2010:p0442:b001:l030","ordinal":20406,"en":"Let us hold a serious council."},{"id":"manas-2010:p0442:b001:l031","ordinal":20407,"en":"Making a promise, without stirring,"},{"id":"manas-2010:p0442:b001:l032","ordinal":20408,"en":"Let us remain in that place."},{"id":"manas-2010:p0442:b001:l033","ordinal":20409,"en":"Let us agree to what you say."},{"id":"manas-2010:p0442:b001:l034","ordinal":20410,"en":"The Manchu and Chinese khanate,"},{"id":"manas-2010:p0442:b001:l035","ordinal":20411,"en":"After conferring, let us give to you."},{"id":"manas-2010:p0442:b001:l036","ordinal":20412,"en":"Six thousand, with horses foremost,"},{"id":"manas-2010:p0442:b001:l037","ordinal":20413,"en":"Let us offer before you."},{"id":"manas-2010:p0442:b001:l038","ordinal":20414,"en":"Even if you slaughter and destroy us,"},{"id":"manas-2010:p0442:b001:l039","ordinal":20415,"en":"Manas the leopard, favored by Kydyr,"},{"id":"manas-2010:p0442:b001:l040","ordinal":20416,"en":"Let us hold out our necks."},{"id":"manas-2010:p0442:b001:l041","ordinal":20417,"en":"Like a falcon to whom one binds one's hopes,"},{"id":"manas-2010:p0442:b001:l042","ordinal":20418,"en":"You truly are a support."},{"id":"manas-2010:p0443:b001:l001","ordinal":20419,"en":"Renowned among the Burut,"},{"id":"manas-2010:p0443:b001:l002","ordinal":20420,"en":"You truly are a lion."},{"id":"manas-2010:p0443:b001:l003","ordinal":20421,"en":"We will send word to the people."},{"id":"manas-2010:p0443:b001:l004","ordinal":20422,"en":"In the city of Chin-Machin,"},{"id":"manas-2010:p0443:b001:l005","ordinal":20423,"en":"Truly you yourself, Manas,"},{"id":"manas-2010:p0443:b001:l006","ordinal":20424,"en":"We will raise as khan."},{"id":"manas-2010:p0443:b001:l007","ordinal":20425,"en":"Anger brings no benefit."},{"id":"manas-2010:p0443:b001:l008","ordinal":20426,"en":"Agree without growing angry,"},{"id":"manas-2010:p0443:b001:l009","ordinal":20427,"en":"Blood-drinking leopard Manas."},{"id":"manas-2010:p0443:b001:l010","ordinal":20428,"en":"If I stay away beyond the third day,"},{"id":"manas-2010:p0443:b001:l011","ordinal":20429,"en":"Unleash your fiercest wrath."},{"id":"manas-2010:p0443:b001:l012","ordinal":20430,"en":"After that, Khan Manas,"},{"id":"manas-2010:p0443:b001:l013","ordinal":20431,"en":"Slaughter us without leaving one!”"},{"id":"manas-2010:p0443:b001:l014","ordinal":20432,"en":"When Ezkara said this,"},{"id":"manas-2010:p0443:b001:l015","ordinal":20433,"en":"He agreed to his words, they say."},{"id":"manas-2010:p0443:b001:l016","ordinal":20434,"en":"The headlong, surpassing lion,"},{"id":"manas-2010:p0443:b001:l017","ordinal":20435,"en":"Abundant in courage, lacking in sense,"},{"id":"manas-2010:p0443:b001:l018","ordinal":20436,"en":"Granted three days' respite, they say."},{"id":"manas-2010:p0443:b001:l019","ordinal":20437,"en":"Stopping the fighting, gathering the army,"},{"id":"manas-2010:p0443:b001:l020","ordinal":20438,"en":"Ezkara now returned to the troops."},{"id":"manas-2010:p0443:b001:l021","ordinal":20439,"en":"He proclaimed the news forcefully."},{"id":"manas-2010:p0443:b001:l022","ordinal":20440,"en":"Of the Manchus in sleeveless coats,"},{"id":"manas-2010:p0443:b001:l023","ordinal":20441,"en":"He gathered the strongest."},{"id":"manas-2010:p0443:b001:l024","ordinal":20442,"en":"Of the Chinese with rank buttons on their caps,"},{"id":"manas-2010:p0443:b001:l025","ordinal":20443,"en":"He gathered the finest."},{"id":"manas-2010:p0443:b001:l026","ordinal":20444,"en":"Of the Kalmyks in arm guards,"},{"id":"manas-2010:p0443:b001:l027","ordinal":20445,"en":"He assembled all the khans."},{"id":"manas-2010:p0443:b001:l028","ordinal":20446,"en":"Ezkara, a true calamity,"},{"id":"manas-2010:p0443:b001:l029","ordinal":20447,"en":"Could not stand still; fire burned within him."},{"id":"manas-2010:p0443:b001:l030","ordinal":20448,"en":"Great Zholoy, sheer calamity,"},{"id":"manas-2010:p0443:b001:l031","ordinal":20449,"en":"Stood unable to bear it."},{"id":"manas-2010:p0443:b001:l032","ordinal":20450,"en":"The stone-badged officials despaired of life,"},{"id":"manas-2010:p0443:b001:l033","ordinal":20451,"en":"Many wrestlers grieved."},{"id":"manas-2010:p0443:b001:l034","ordinal":20452,"en":"Wrapped in a blue-flowered coat,"},{"id":"manas-2010:p0443:b001:l035","ordinal":20453,"en":"If you had seen Ezkara,"},{"id":"manas-2010:p0443:b001:l036","ordinal":20454,"en":"Rousing himself like a blue tiger,"},{"id":"manas-2010:p0443:b001:l037","ordinal":20455,"en":"Roaring in fury,"},{"id":"manas-2010:p0443:b001:l038","ordinal":20456,"en":"Calling his governors:"},{"id":"manas-2010:p0443:b001:l039","ordinal":20457,"en":"“That blood-drinker, sheer calamity—"},{"id":"manas-2010:p0443:b001:l040","ordinal":20458,"en":"‘Grant three days' respite,’ I said,"},{"id":"manas-2010:p0443:b001:l041","ordinal":20459,"en":"And came away having fooled the deceiver."},{"id":"manas-2010:p0443:b001:l042","ordinal":20460,"en":"Manas is no easy slave to deal with."},{"id":"manas-2010:p0444:b001:l001","ordinal":20461,"en":"May he be hollowed out—his nature is different!"},{"id":"manas-2010:p0444:b001:l002","ordinal":20462,"en":"He is no boy who gives one an easy way!"},{"id":"manas-2010:p0444:b001:l003","ordinal":20463,"en":"He wheeled his spear all around."},{"id":"manas-2010:p0444:b001:l004","ordinal":20464,"en":"That bastard Burut"},{"id":"manas-2010:p0444:b001:l005","ordinal":20465,"en":"Broke up the massed ranks."},{"id":"manas-2010:p0444:b001:l006","ordinal":20466,"en":"He unleashed a terrible fury."},{"id":"manas-2010:p0444:b001:l007","ordinal":20467,"en":"That fierce-wrathed Burut"},{"id":"manas-2010:p0444:b001:l008","ordinal":20468,"en":"Slaughtered the governors!"},{"id":"manas-2010:p0444:b001:l009","ordinal":20469,"en":"The humiliation this Burut brought,"},{"id":"manas-2010:p0444:b001:l010","ordinal":20470,"en":"His oppression was of another kind."},{"id":"manas-2010:p0444:b001:l011","ordinal":20471,"en":"When Khan Esen gave an order,"},{"id":"manas-2010:p0444:b001:l012","ordinal":20472,"en":"We used to wage a fierce battle."},{"id":"manas-2010:p0444:b001:l013","ordinal":20473,"en":"All the souls who provoked us,"},{"id":"manas-2010:p0444:b001:l014","ordinal":20474,"en":"We used to seize and bind."},{"id":"manas-2010:p0444:b001:l015","ordinal":20475,"en":"By the Burut, that son of a divorced mother,"},{"id":"manas-2010:p0444:b001:l016","ordinal":20476,"en":"‘We were beaten on the road,’ we must say."},{"id":"manas-2010:p0444:b001:l017","ordinal":20477,"en":"Now how can we go"},{"id":"manas-2010:p0444:b001:l018","ordinal":20478,"en":"Before Khan Esen?"},{"id":"manas-2010:p0444:b001:l019","ordinal":20479,"en":"How can we find the words?"},{"id":"manas-2010:p0444:b001:l020","ordinal":20480,"en":"Did you not see, wrestlers?"}]
