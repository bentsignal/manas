[{"id":"semetey-1-2013:p0851:b003:l001","ordinal":141313,"en":"The wise elders wept,"},{"id":"semetey-1-2013:p0851:b003:l002","ordinal":141314,"en":"Saying, “Manas's son has come,”"},{"id":"semetey-1-2013:p0851:b003:l003","ordinal":141315,"en":"The Argyn and Kyrgyz all wept."},{"id":"semetey-1-2013:p0851:b003:l004","ordinal":141316,"en":"Crying out, “Bahauddin!”"},{"id":"semetey-1-2013:p0851:b003:l005","ordinal":141317,"en":"All the people who had come"},{"id":"semetey-1-2013:p0851:b003:l006","ordinal":141318,"en":"Raised the battle cry, “Manas!”"},{"id":"semetey-1-2013:p0851:b003:l007","ordinal":141319,"en":"“To Kara Khan's city"},{"id":"semetey-1-2013:p0851:b003:l008","ordinal":141320,"en":"He fled and grew to manhood;"},{"id":"semetey-1-2013:p0851:b003:l009","ordinal":141321,"en":"The leopard orphan has come,” they said."},{"id":"semetey-1-2013:p0851:b003:l010","ordinal":141322,"en":"“To Temir Khan's city"},{"id":"semetey-1-2013:p0851:b003:l011","ordinal":141323,"en":"He wandered and grew to manhood;"},{"id":"semetey-1-2013:p0851:b003:l012","ordinal":141324,"en":"The ocean-like orphan has come,” they said."},{"id":"semetey-1-2013:p0851:b003:l013","ordinal":141325,"en":"“A refuge for each and every head,"},{"id":"semetey-1-2013:p0851:b003:l014","ordinal":141326,"en":"The orphan, a bustling marketplace, has come,” they said."},{"id":"semetey-1-2013:p0851:b003:l015","ordinal":141327,"en":"“The calamitous troubles"},{"id":"semetey-1-2013:p0851:b003:l016","ordinal":141328,"en":"The orphan who will dispel them has come,” they said."},{"id":"semetey-1-2013:p0851:b003:l017","ordinal":141329,"en":"“When Manas died,"},{"id":"semetey-1-2013:p0851:b003:l018","ordinal":141330,"en":"When he saw the face of the other world,"},{"id":"semetey-1-2013:p0851:b003:l019","ordinal":141331,"en":"We settled along the valley;"},{"id":"semetey-1-2013:p0851:b003:l020","ordinal":141332,"en":"There was no one who could rise,"},{"id":"semetey-1-2013:p0851:b003:l021","ordinal":141333,"en":"We were like an extinguished fire!”"},{"id":"semetey-1-2013:p0851:b003:l022","ordinal":141334,"en":"Then the common people and their elders,"},{"id":"semetey-1-2013:p0851:b003:l023","ordinal":141335,"en":"All that great multitude,"},{"id":"semetey-1-2013:p0851:b003:l024","ordinal":141336,"en":"Cried out, “Amen!”"},{"id":"semetey-1-2013:p0851:b003:l025","ordinal":141337,"en":"And sobbed, “Bahauddin!”"},{"id":"semetey-1-2013:p0851:b003:l026","ordinal":141338,"en":"That craftsman Bolokbay,"},{"id":"semetey-1-2013:p0851:b003:l027","ordinal":141339,"en":"With forty guards at his side—"},{"id":"semetey-1-2013:p0851:b003:l028","ordinal":141340,"en":"If you ask about Bolokbay,"},{"id":"semetey-1-2013:p0851:b003:l029","ordinal":141341,"en":"A star was stirred in the heavens;"},{"id":"semetey-1-2013:p0851:b003:l030","ordinal":141342,"en":"David and Bolokbay"},{"id":"semetey-1-2013:p0851:b003:l031","ordinal":141343,"en":"Had become friends twelve times."},{"id":"semetey-1-2013:p0851:b003:l032","ordinal":141344,"en":"Putting all his skill into his work,"},{"id":"semetey-1-2013:p0851:b003:l033","ordinal":141345,"en":"While leopard Manas lived,"},{"id":"semetey-1-2013:p0851:b003:l034","ordinal":141346,"en":"All that equipment"},{"id":"semetey-1-2013:p0851:b003:l035","ordinal":141347,"en":"He fashioned to fit perfectly."},{"id":"semetey-1-2013:p0851:b003:l036","ordinal":141348,"en":"He was a man of sacred power;"},{"id":"semetey-1-2013:p0851:b003:l037","ordinal":141349,"en":"Khan Manas's treasury"},{"id":"semetey-1-2013:p0851:b003:l038","ordinal":141350,"en":"He was the one who guarded."},{"id":"semetey-1-2013:p0851:b003:l039","ordinal":141351,"en":"Once, when Manas died,"},{"id":"semetey-1-2013:p0851:b005:l001","ordinal":141352,"en":"When his poor soul knew grief,"},{"id":"semetey-1-2013:p0851:b005:l002","ordinal":141353,"en":"When the six villains divided the livestock,"},{"id":"semetey-1-2013:p0851:b005:l003","ordinal":141354,"en":"When they plundered the valuables,"},{"id":"semetey-1-2013:p0851:b005:l004","ordinal":141355,"en":"When the six villains wrought great wickedness,"},{"id":"semetey-1-2013:p0851:b005:l005","ordinal":141356,"en":"Then the lame smith Bolokbay,"},{"id":"semetey-1-2013:p0851:b005:l006","ordinal":141357,"en":"His forty guards at his side,"},{"id":"semetey-1-2013:p0851:b005:l007","ordinal":141358,"en":"They survived, escaping death."},{"id":"semetey-1-2013:p0851:b005:l008","ordinal":141359,"en":"Supremely capable Bolokbay"},{"id":"semetey-1-2013:p0851:b005:l009","ordinal":141360,"en":"Fought against the six villains."},{"id":"semetey-1-2013:p0851:b005:l010","ordinal":141361,"en":"In turmoil they lay,"},{"id":"semetey-1-2013:p0851:b005:l011","ordinal":141362,"en":"Too far apart to reach each other,"},{"id":"semetey-1-2013:p0851:b005:l012","ordinal":141363,"en":"Firing guns at one another."},{"id":"semetey-1-2013:p0851:b005:l013","ordinal":141364,"en":"Standing opposite each other,"},{"id":"semetey-1-2013:p0851:b005:l014","ordinal":141365,"en":"Unable to reach with their lances,"},{"id":"semetey-1-2013:p0851:b005:l015","ordinal":141366,"en":"They battled with guns."},{"id":"semetey-1-2013:p0851:b005:l016","ordinal":141367,"en":"Many a khan they met died,"},{"id":"semetey-1-2013:p0851:b005:l017","ordinal":141368,"en":"Those whose hour had come died."},{"id":"semetey-1-2013:p0851:b005:l018","ordinal":141369,"en":"Clouds gathered in the sky;"},{"id":"semetey-1-2013:p0851:b005:l019","ordinal":141370,"en":"The lame smith Bolokbay,"},{"id":"semetey-1-2013:p0851:b005:l020","ordinal":141371,"en":"Robbed of his wealth,"},{"id":"semetey-1-2013:p0851:b005:l021","ordinal":141372,"en":"To the mountain of Kaiypchy,"},{"id":"semetey-1-2013:p0851:b005:l022","ordinal":141373,"en":"Leading his forty guards,"},{"id":"semetey-1-2013:p0851:b005:l023","ordinal":141374,"en":"Escaped death in flight."},{"id":"semetey-1-2013:p0851:b005:l024","ordinal":141375,"en":"For twelve years Bolokbay"},{"id":"semetey-1-2013:p0851:b005:l025","ordinal":141376,"