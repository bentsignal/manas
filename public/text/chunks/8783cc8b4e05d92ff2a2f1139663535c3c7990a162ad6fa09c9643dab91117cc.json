[{"id":"semetey-1-2013:p1142:b004:l018","ordinal":164353,"en":"Making Kartküröng prance;"},{"id":"semetey-1-2013:p1142:b004:l019","ordinal":164354,"en":"Khan Azhybay rode in front"},{"id":"semetey-1-2013:p1142:b004:l020","ordinal":164355,"en":"Of the tiger, gray-wolf lord."},{"id":"semetey-1-2013:p1142:b004:l021","ordinal":164356,"en":"Nine supported him;"},{"id":"semetey-1-2013:p1142:b004:l022","ordinal":164357,"en":"His supporters appeared."},{"id":"semetey-1-2013:p1142:b004:l023","ordinal":164358,"en":"The dark-piebald tiger"},{"id":"semetey-1-2013:p1142:b004:l024","ordinal":164359,"en":"Raged at his flank."},{"id":"semetey-1-2013:p1142:b004:l025","ordinal":164360,"en":"Zulpukor fastened at his waist,"},{"id":"semetey-1-2013:p1142:b004:l026","ordinal":164361,"en":"His wrath spread across his face;"},{"id":"semetey-1-2013:p1142:b004:l027","ordinal":164362,"en":"Those who saw him despaired,"},{"id":"semetey-1-2013:p1142:b004:l028","ordinal":164363,"en":"And his thirst for blood showed."},{"id":"semetey-1-2013:p1142:b004:l029","ordinal":164364,"en":"The horns boomed,"},{"id":"semetey-1-2013:p1142:b004:l030","ordinal":164365,"en":"The trumpets shrilled;"},{"id":"semetey-1-2013:p1142:b004:l031","ordinal":164366,"en":"All the forty companions,"},{"id":"semetey-1-2013:p1142:b004:l032","ordinal":164367,"en":"Their elder Kyrgyl at their head,"},{"id":"semetey-1-2013:p1142:b004:l033","ordinal":164368,"en":"Had a majestic bearing,"},{"id":"semetey-1-2013:p1142:b004:l034","ordinal":164369,"en":"Each a companion worth a countless army."},{"id":"semetey-1-2013:p1142:b004:l035","ordinal":164370,"en":"The horses were firmly tethered,"},{"id":"semetey-1-2013:p1142:b004:l036","ordinal":164371,"en":"And all the gray wolves filled the place."},{"id":"semetey-1-2013:p1142:b004:l037","ordinal":164372,"en":"Finding no enemy to meet in battle,"},{"id":"semetey-1-2013:p1142:b004:l038","ordinal":164373,"en":"All forty companions grew pent-up,"},{"id":"semetey-1-2013:p1142:b004:l039","ordinal":164374,"en":"Finding no ridge upon which to clash,"},{"id":"semetey-1-2013:p1142:b004:l040","ordinal":164375,"en":"Finding no born hero with whom to contend,"},{"id":"semetey-1-2013:p1143:b003:l001","ordinal":164376,"en":"Finding no place to cast their weight,"},{"id":"semetey-1-2013:p1143:b003:l002","ordinal":164377,"en":"Finding no hero to fight,"},{"id":"semetey-1-2013:p1143:b003:l003","ordinal":164378,"en":"They rode about churning with impatience."},{"id":"semetey-1-2013:p1143:b003:l004","ordinal":164379,"en":"Like lions, gray wolves, and tigers,"},{"id":"semetey-1-2013:p1143:b003:l005","ordinal":164380,"en":"They turned toward the multitude."},{"id":"semetey-1-2013:p1143:b003:l006","ordinal":164381,"en":"Hoping to reach the place of the feast,"},{"id":"semetey-1-2013:p1143:b003:l007","ordinal":164382,"en":"All forty companions"},{"id":"semetey-1-2013:p1143:b003:l008","ordinal":164383,"en":"Entered the tumult."},{"id":"semetey-1-2013:p1143:b003:l009","ordinal":164384,"en":"Like an unconquered mountain,"},{"id":"semetey-1-2013:p1143:b003:l010","ordinal":164385,"en":"They entered the contest."},{"id":"semetey-1-2013:p1143:b003:l011","ordinal":164386,"en":"If the magnanimous one gave the order,"},{"id":"semetey-1-2013:p1143:b003:l012","ordinal":164387,"en":"They would show the seething Chinese"},{"id":"semetey-1-2013:p1143:b003:l013","ordinal":164388,"en":"An astonishing sight."},{"id":"semetey-1-2013:p1143:b003:l014","ordinal":164389,"en":"They had courage."},{"id":"semetey-1-2013:p1143:b003:l015","ordinal":164390,"en":"There were companions who drew courage"},{"id":"semetey-1-2013:p1143:b003:l016","ordinal":164391,"en":"From calm words of substance."},{"id":"semetey-1-2013:p1143:b003:l017","ordinal":164392,"en":"There were companions who made ready"},{"id":"semetey-1-2013:p1143:b003:l018","ordinal":164393,"en":"Their guns and swords in hand,"},{"id":"semetey-1-2013:p1143:b003:l019","ordinal":164394,"en":"As though about to strike the enemy now."},{"id":"semetey-1-2013:p1143:b003:l020","ordinal":164395,"en":"There were companions who trampled trackless ground"},{"id":"semetey-1-2013:p1143:b003:l021","ordinal":164396,"en":"And made a road."},{"id":"semetey-1-2013:p1143:b003:l022","ordinal":164397,"en":"There were companions who attacked,"},{"id":"semetey-1-2013:p1143:b004:l001","ordinal":164398,"en":"Regarding death as less than a hair."},{"id":"semetey-1-2013:p1143:b004:l002","ordinal":164399,"en":"There were companions who, striking countless armies,"},{"id":"semetey-1-2013:p1143:b004:l003","ordinal":164400,"en":"Scattered and split them."},{"id":"semetey-1-2013:p1143:b004:l004","ordinal":164401,"en":"There were companions who spilled"},{"id":"semetey-1-2013:p1143:b004:l005","ordinal":164402,"en":"The infidels' blood bright red."},{"id":"semetey-1-2013:p1143:b004:l006","ordinal":164403,"en":"There were companions who entered battle unawares"},{"id":"semetey-1-2013:p1143:b004:l007","ordinal":164404,"en":"And died."},{"id":"semetey-1-2013:p1143:b004:l008","ordinal":164405,"en":"There were companions called spearmen,"},{"id":"semetey-1-2013:p1143:b004:l009","ordinal":164406,"en":"Skilled and cunning."},{"id":"semetey-1-2013:p1143:b004:l010","ordinal":164407,"en":"There were strong companions"},{"id":"semetey-1-2013:p1143:b004:l011","ordinal":164408,"en":"Who knew the enemy's stratagems well."},{"id":"semetey-1-2013:p1143:b004:l012","ordinal":164409,"en":"When they became mixed together,"},{"id":"semetey-1-2013:p1143:b004:l013","ordinal":164410,"en":"There were clumsy companions"},{"id":"semetey-1-2013:p1143:b004:l014","ordinal":164411,"en":"Who struck men wide of the mark."},{"id":"semetey-1-2013:p1143:b004:l015","ordinal":164412,"en":"There were cowardly companions"},{"id":"semetey-1-2013:p1143:b004:l016","ordinal":164413,"en":"Who would not part from their loaded baggage."},{"id":"semetey-1-2013:p1143:b004:l017","ordinal":164414,"en":"Who could match the man who speared heroes?"},{"id":"semetey-1-2013:p1143:b004:l018","ordinal":164415,"en":"His fame remained with Manas."},{"id":"semetey-1-2013:p1143:b004:l019","ordinal":164416,"en":"Khan Manas's forty companions—"},{"id":"semetey-1-2013:p1143:b004:l020","ordinal":164417,"en":"Forty lions who came from forty places,"},{"id":"semetey-1-2013:p1143:b004:l021","ordinal":164418,"en":"Each was a lion,"},{"id":"semetey-1-2013:p1143:b004:l022","ordinal":164419,"en":"Heroes born for slaughter."},{"id":"semetey-1-2013:p1143:b006:l001","ordinal":164420,"en":"From the Kyzyl-Kyya pass,"},{"id":"semetey-1-2013:p1143:b006:l002","ordinal":164421,"en":"Dear Manas appeared in his grandeur;"},{"id":"semetey-1-2013:p1143:b006:l003","ordinal":164422,"en":"That was when he came into view."},{"id":"semetey-1-2013:p1143:b006:l004","ordinal":164423,"en":"The Muslims, witnessing the spectacle,"},{"id":"semetey-1-2013:p1143:b006:l005","ordinal":164424,"en":"Were under great pressure"},{"id":"semetey-1-2013:p1143:b006:l006","ordinal":164425,"en":"And had split apart."},{"id":"semetey-1-2013:p1143:b006:l007","ordinal":164426,"en":"The tyranny of Kakanchyn"},{"id":"semetey-1-2013:p1143:b006:l008","ordinal":164427,"en":"Had become plain;"},{"id":"semetey-1-2013:p1143:b006:l009","ordinal":164428,"en":"It had trapped and besieged"},{"id":"semetey-1-2013:p1143:b006:l010","ordinal":164429,"en":"The mere handful of Muslims."},{"id":"semetey-1-2013:p1143:b006:l011","ordinal":164430,"en":"With Khan Koshoy at their head,"},{"id":"semetey-1-2013:p1143:b006:l012","ordinal":164431,"en":"The valiant men could not take command;"},{"id":"semetey-1-2013:p1143:b007:l001","ordinal":164432,"en":"They had allowed Kökötöy's cooking pits"},{"id":"semetey-1-2013:p1143:b007:l002","ordinal":164433,"en":"To be plundered"},{"id":"semetey-1-2013:p1143:b007:l003","ordinal":164434,"en":"By the Black Chinese and Manchus."},{"id":"semetey-1-2013:p1143:b007:l004","ordinal":164435,"en":"They hastened toward their horses"},{"id":"semetey-1-2013:p1143:b007:l005","ordinal":164436,"en":"And broke into a run."},{"id":"semetey-1-2013:p1143:b007:l006","ordinal":164437,"en":"The mere handful of Muslims"},{"id":"semetey-1-2013:p1143:b007:l007","ordinal":164438,"en":"Had then despaired"},{"id":"semetey-1-2013:p1143:b007:l008","ordinal":164439,"en":"Of their mortal lives."},{"id":"semetey-1-2013:p1143:b007:l009","ordinal":164440,"en":"Shouting, “Khan Manas!”"},{"id":"semetey-1-2013:p1143:b007:l010","ordinal":164441,"en":"When the forty companions entered,"},{"id":"semetey-1-2013:p1143:b007:l011","ordinal":164442,"en":"I saw your uncle Koshoy"},{"id":"semetey-1-2013:p1143:b007:l012","ordinal":164443,"en":"Fail to rise from his place."},{"id":"semetey-1-2013:p1144:b003:l001","ordinal":164444,"en":"The giants of the Muslims"},{"id":"semetey-1-2013:p1144:b003:l002","ordinal":164445,"en":"Could find no composure;"},{"id":"semetey-1-2013:p1144:b003:l003","ordinal":164446,"en":"When they saw Khan Manas,"},{"id":"semetey-1-2013:p1144:b003:l004","ordinal":164447,"en":"As though they had seen their father,"},{"id":"semetey-1-2013:p1144:b003:l005","ordinal":164448,"en":"I saw them weep."},{"id":"semetey-1-2013:p1144:b003:l006","ordinal":164449,"en":"“Where is Manas, where?” they cried;"},{"id":"semetey-1-2013:p1144:b003:l007","ordinal":164450,"en":"I saw them panic."},{"id":"semetey-1-2013:p1144:b003:l008","ordinal":164451,"en":"The Black Kalmyks and Manchus,"},{"id":"semetey-1-2013:p1144:b003:l009","ordinal":164452,"en":"Saying, “The bloodthirsty Burut has come,”"},{"id":"semetey-1-2013:p1144:b003:l010","ordinal":164453,"en":"Abandoned their violence;"},{"id":"semetey-1-2013:p1144:b003:l011","ordinal":164454,"en":"With Ezkara and Zholoy at their head,"},{"id":"semetey-1-2013:p1144:b003:l012","ordinal":164455,"en":"I saw where they fled."},{"id":"semetey-1-2013:p1144:b003:l013","ordinal":164456,"en":"I saw the stone-carrying Chinese"},{"id":"semetey-1-2013:p1144:b003:l014","ordinal":164457,"en":"Bow like brides"},{"id":"semetey-1-2013:p1144:b003:l015","ordinal":164458,"en":"And fall into turmoil."},{"id":"semetey-1-2013:p1144:b003:l016","ordinal":164459,"en":"Ezkara, khan of the Manchus,"},{"id":"semetey-1-2013:p1144:b003:l017","ordinal":164460,"en":"Boasted among the people;"},{"id":"semetey-1-2013:p1144:b003:l018","ordinal":164461,"en":"I saw him assess Manas:"},{"id":"semetey-1-2013:p1144:b003:l019","ordinal":164462,"en":"“He has a black hat as big as a cauldron."},{"id":"semetey-1-2013:p1144:b003:l020","ordinal":164463,"en":"If infidel and Muslim alike"},{"id":"semetey-1-2013:p1144:b003:l021","ordinal":164464,"en":"Attacked him together,"},{"id":"semetey-1-2013:p1144:b003:l022","ordinal":164465,"en":"He has the power to swallow them all,"},{"id":"semetey-1-2013:p1144:b003:l023","ordinal":164466,"en":"Counting them less than a hair."},{"id":"semetey-1-2013:p1144:b003:l024","ordinal":164467,"en":"If we show hostility to Manas,"},{"id":"semetey-1-2013:p1144:b003:l025","ordinal":164468,"en":"We will all meet our end together."},{"id":"semetey-1-2013:p1144:b003:l026","ordinal":164469,"en":"Even if all Beijing came as one,"},{"id":"semetey-1-2013:p1144:b003:l027","ordinal":164470,"en":"He would slaughter every one."},{"id":"semetey-1-2013:p1144:b003:l028","ordinal":164471,"en":"The massed Chinese gossip"},{"id":"semetey-1-2013:p1144:b003:l029","ordinal":164472,"en":"And call him ‘the bloodthirsty Burut’;"},{"id":"semetey-1-2013:p1144:b003:l030","ordinal":164473,"en":"The havoc he brought upon Altai"},{"id":"semetey-1-2013:p1144:b003:l031","ordinal":164474,"en":"Was fitting for a gray wolf."},{"id":"semetey-1-2013:p1144:b003:l032","ordinal":164475,"en":"For the Burut who dwell in mountains,"},{"id":"semetey-1-2013:p1144:b003:l033","ordinal":164476,"en":"Mountain-like Manas is a fortress."},{"id":"semetey-1-2013:p1144:b003:l034","ordinal":164477,"en":"He himself follows the faith of Islam;"},{"id":"semetey-1-2013:p1144:b003:l035","ordinal":164478,"en":"In his heart he means to bring hell"},{"id":"semetey-1-2013:p1144:b003:l036","ordinal":164479,"en":"Upon Beijing, where no flood can pass."},{"id":"semetey-1-2013:p1144:b003:l037","ordinal":164480,"en":"He is an imposing lion,"},{"id":"semetey-1-2013:p1144:b003:l038","ordinal":164481,"en":"The one lion born"},{"id":"semetey-1-2013:p1144:b003:l039","ordinal":164482,"en":"For these Burut."},{"id":"semetey-1-2013:p1144:b004:l001","ordinal":164483,"en":"His wrestling strength is of another order,"},{"id":"semetey-1-2013:p1144:b004:l002","ordinal":164484,"en":"A peerless champion born among the Burut."},{"id":"semetey-1-2013:p1144:b004:l003","ordinal":164485,"en":"His battle cry is ‘Burut!’"},{"id":"semetey-1-2013:p1144:b004:l004","ordinal":164486,"en":"You are a hero, brave Manas;"},{"id":"semetey-1-2013:p1144:b004:l005","ordinal":164487,"en":"Let the Burut destroy these people,” he said."},{"id":"semetey-1-2013:p1144:b004:l006","ordinal":164488,"en":"Speaking many words in grief,"},{"id":"semetey-1-2013:p1144:b004:l007","ordinal":164489,"en":"Ezkara drew back."},{"id":"semetey-1-2013:p1144:b004:l008","ordinal":164490,"en":"“Beyond these people lies the Kakan land;"},{"id":"semetey-1-2013:p1144:b004:l009","ordinal":164491,"en":"Opposite them lies Bakburchun."},{"id":"semetey-1-2013:p1144:b004:l010","ordinal":164492,"en":"I have seen all of these people."},{"id":"semetey-1-2013:p1144:b004:l011","ordinal":164493,"en":"Even one whom the Chinese call a hero"},{"id":"semetey-1-2013:p1144:b004:l012","ordinal":164494,"en":"Is the work of God."},{"id":"semetey-1-2013:p1144:b004:l013","ordinal":164495,"en":"If all Beijing gathered,"},{"id":"semetey-1-2013:p1144:b004:l014","ordinal":164496,"en":"He is a man who could slaughter it in one day;"},{"id":"semetey-1-2013:p1144:b004:l015","ordinal":164497,"en":"We came as guests and plundered meat—"},{"id":"semetey-1-2013:p1144:b004:l016","ordinal":164498,"en":"This too was the work of God."},{"id":"semetey-1-2013:p1144:b004:l017","ordinal":164499,"en":"If resentment enters his heart,"},{"id":"semetey-1-2013:p1144:b004:l018","ordinal":164500,"en":"He is a man who could slaughter us all"},{"id":"semetey-1-2013:p1144:b004:l019","ordinal":164501,"en":"Here at this very feast."},{"id":"semetey-1-2013:p1144:b004:l020","ordinal":164502,"en":"If Manas roars and gathers strength,"},{"id":"semetey-1-2013:p1144:b004:l021","ordinal":164503,"en":"What can we say we have done?"},{"id":"semetey-1-2013:p1144:b004:l022","ordinal":164504,"en":"We began the lawlessness"},{"id":"semetey-1-2013:p1144:b004:l023","ordinal":164505,"en":"And ate all the meat."},{"id":"semetey-1-2013:p1144:b004:l024","ordinal":164506,"en":"Does he perhaps know"},{"id":"semetey-1-2013:p1144:b004:l025","ordinal":164507,"en":"The cowardice of the seething Manchus?"},{"id":"semetey-1-2013:p1144:b004:l026","ordinal":164508,"en":"If Khan Manas grows wrathful,"},{"id":"semetey-1-2013:p1144:b004:l027","ordinal":164509,"en":"Perhaps he will drive us as far as Kakan."},{"id":"semetey-1-2013:p1144:b004:l028","ordinal":164510,"en":"Beneath him is the dun horse;"},{"id":"semetey-1-2013:p1144:b004:l029","ordinal":164511,"en":"Bloodthirsty Manas the lion"},{"id":"semetey-1-2013:p1144:b004:l030","ordinal":164512,"en":"Has strength that reaches across the world."},{"id":"semetey-1-2013:p1144:b004:l031","ordinal":164513,"en":"He has armor no bullet pierces;"},{"id":"semetey-1-2013:p1144:b004:l032","ordinal":164514,"en":"Mighty Manas has great power."},{"id":"semetey-1-2013:p1144:b004:l033","ordinal":164515,"en":"Seeing his young horse, we attacked;"},{"id":"semetey-1-2013:p1144:b004:l034","ordinal":164516,"en":"We erred in demanding Maaniker,"},{"id":"semetey-1-2013:p1144:b004:l035","ordinal":164517,"en":"And made ready to seize it."},{"id":"semetey-1-2013:p1144:b004:l036","ordinal":164518,"en":"Beside him is Almambet,"},{"id":"semetey-1-2013:p1144:b004:l037","ordinal":164519,"en":"Who made his golden throne into grease"},{"id":"semetey-1-2013:p1144:b004:l038","ordinal":164520,"en":"And laid low his father, Khan Azazil."},{"id":"semetey-1-2013:p1144:b004:l039","ordinal":164521,"en":"He follows the faith of Islam,"},{"id":"semetey-1-2013:p1145:b003:l001","ordinal":164522,"en":"In the land of our enemy."},{"id":"semetey-1-2013:p1145:b003:l002","ordinal":164523,"en":"Had you not heard?"},{"id":"semetey-1-2013:p1145:b003:l003","ordinal":164524,"en":"What he gathered remains in Kakan;"},{"id":"semetey-1-2013:p1145:b003:l004","ordinal":164525,"en":"What he desires is the faith."},{"id":"semetey-1-2013:p1145:b003:l005","ordinal":164526,"en":"What he gathered remains in Beijing;"},{"id":"semetey-1-2013:p1145:b003:l006","ordinal":164527,"en":"What he watches is the faith."},{"id":"semetey-1-2013:p1145:b003:l007","ordinal":164528,"en":"He has words of resentment;"},{"id":"semetey-1-2013:p1145:b003:l008","ordinal":164529,"en":"Have you heard"},{"id":"semetey-1-2013:p1145:b003:l009","ordinal":164530,"en":"Of his revenge for his mother's death?"},{"id":"semetey-1-2013:p1145:b003:l010","ordinal":164531,"en":"If Manas is driven into a rage,"},{"id":"semetey-1-2013:p1145:b003:l011","ordinal":164532,"en":"He has reason to clash with us."},{"id":"semetey-1-2013:p1145:b003:l012","ordinal":164533,"en":"Khan Zholoy of the Kalmyks"},{"id":"semetey-1-2013:p1145:b003:l013","ordinal":164534,"en":"And Kongurbai, khan of the monks,"},{"id":"semetey-1-2013:p1145:b003:l014","ordinal":164535,"en":"Grew wrathful and excited,"},{"id":"semetey-1-2013:p1145:b003:l015","ordinal":164536,"en":"And spoke to Ezkara:"},{"id":"semetey-1-2013:p1145:b003:l016","ordinal":164537,"en":"“If he does not agree to my demand,"},{"id":"semetey-1-2013:p1145:b003:l017","ordinal":164538,"en":"If he does not give Maaniker,"},{"id":"semetey-1-2013:p1145:b003:l018","ordinal":164539,"en":"I will gather an army from Beijing."},{"id":"semetey-1-2013:p1145:b003:l019","ordinal":164540,"en":"While my valiant soul lives,"},{"id":"semetey-1-2013:p1145:b003:l020","ordinal":164541,"en":"I will not stand idly by.”"},{"id":"semetey-1-2013:p1145:b003:l021","ordinal":164542,"en":"Brave Kongurbai said this,"},{"id":"semetey-1-2013:p1145:b003:l022","ordinal":164543,"en":"Thudding in anger."},{"id":"semetey-1-2013:p1145:b003:l023","ordinal":164544,"en":"Dear Zholoy blustered,"},{"id":"semetey-1-2013:p1145:b003:l024","ordinal":164545,"en":"Saying, “I will bring disaster upon his feast.”"},{"id":"semetey-1-2013:p1145:b003:l025","ordinal":164546,"en":"Saying Manas the leopard had come,"},{"id":"semetey-1-2013:p1145:b003:l026","ordinal":164547,"en":"The Muslim people rejoiced."},{"id":"semetey-1-2013:p1145:b003:l027","ordinal":164548,"en":"Had this Manas not come,"},{"id":"semetey-1-2013:p1145:b003:l028","ordinal":164549,"en":"They were going to intensify the wounds,"},{"id":"semetey-1-2013:p1145:b003:l029","ordinal":164550,"en":"Bring calamity upon"},{"id":"semetey-1-2013:p1145:b003:l030","ordinal":164551,"en":"The Muslim people,"},{"id":"semetey-1-2013:p1145:b003:l031","ordinal":164552,"en":"Begin their devastation,"},{"id":"semetey-1-2013:p1145:b003:l032","ordinal":164553,"en":"And make a spectacle no man should see."},{"id":"semetey-1-2013:p1145:b003:l033","ordinal":164554,"en":"A spectacle of horror."},{"id":"semetey-1-2013:p1145:b003:l034","ordinal":164555,"en":"A saint supported by the spirits,"},{"id":"semetey-1-2013:p1145:b003:l035","ordinal":164556,"en":"Your elder uncle Koshoy,"},{"id":"semetey-1-2013:p1145:b003:l036","ordinal":164557,"en":"Turned to the matter"},{"id":"semetey-1-2013:p1145:b003:l037","ordinal":164558,"en":"And spoke these words without cease:"},{"id":"semetey-1-2013:p1145:b003:l038","ordinal":164559,"en":"“Bloodthirsty lion, Manas the leopard,"},{"id":"semetey-1-2013:p1145:b003:l039","ordinal":164560,"en":"Do you see how grass grows on the slope?"},{"id":"semetey-1-2013:p1145:b005:l001","ordinal":164561,"en":"The infidel people are many."},{"id":"semetey-1-2013:p1145:b005:l002","ordinal":164562,"en":"The grass on the upland is sparse;"},{"id":"semetey-1-2013:p1145:b005:l003","ordinal":164563,"en":"The Muslim people are few."},{"id":"semetey-1-2013:p1145:b005:l004","ordinal":164564,"en":"The raging Zholoy and Kongurbai"},{"id":"semetey-1-2013:p1145:b005:l005","ordinal":164565,"en":"May seize the plunder,"},{"id":"semetey-1-2013:p1145:b005:l006","ordinal":164566,"en":"And bring devastation upon us."},{"id":"semetey-1-2013:p1145:b005:l007","ordinal":164567,"en":"Kökötöy's livestock was driven in crowds"},{"id":"semetey-1-2013:p1145:b005:l008","ordinal":164568,"en":"From Tashkent."},{"id":"semetey-1-2013:p1145:b005:l009","ordinal":164569,"en":"Coming to hold the feast,"},{"id":"semetey-1-2013:p1145:b005:l010","ordinal":164570,"en":"The renowned boy Bokmurun"},{"id":"semetey-1-2013:p1145:b005:l011","ordinal":164571,"en":"Has become badly entangled in trouble."},{"id":"semetey-1-2013:p1145:b005:l012","ordinal":164572,"en":"Making merry to hold the feast,"},{"id":"semetey-1-2013:p1145:b005:l013","ordinal":164573,"en":"Perhaps Bokmurun cast havoc"},{"id":"semetey-1-2013:p1145:b005:l014","ordinal":164574,"en":"Upon his great wealth."},{"id":"semetey-1-2013:p1145:b005:l015","ordinal":164575,"en":"Ah, my colt Khan Manas,"},{"id":"semetey-1-2013:p1145:b005:l016","ordinal":164576,"en":"There are the people of Kakanchyn,"},{"id":"semetey-1-2013:p1145:b005:l017","ordinal":164577,"en":"And the wrathful Kalcha, the formidable one,"},{"id":"semetey-1-2013:p1145:b005:l018","ordinal":164578,"en":"Whose custom is to drink the blood"},{"id":"semetey-1-2013:p1145:b005:l019","ordinal":164579,"en":"Of anyone who attacks him."},{"id":"semetey-1-2013:p1145:b005:l020","ordinal":164580,"en":"Here are the people of Chynmachyn,"},{"id":"semetey-1-2013:p1145:b005:l021","ordinal":164581,"en":"The bridle-haired Kalmyks,"},{"id":"semetey-1-2013:p1145:b005:l022","ordinal":164582,"en":"Ready to contend with us."},{"id":"semetey-1-2013:p1145:b005:l023","ordinal":164583,"en":"I know the truth of Beijing:"},{"id":"semetey-1-2013:p1145:b005:l024","ordinal":164584,"en":"Long ago, in the prophet Noah's time,"},{"id":"semetey-1-2013:p1145:b005:l025","ordinal":164585,"en":"The flood passed here."},{"id":"semetey-1-2013:p1145:b005:l026","ordinal":164586,"en":"When the floodwaters surged and overflowed,"},{"id":"semetey-1-2013:p1145:b005:l027","ordinal":164587,"en":"Their waves did not reach Beijing,"},{"id":"semetey-1-2013:p1145:b005:l028","ordinal":164588,"en":"And six hundred households remained."},{"id":"semetey-1-2013:p1145:b005:l029","ordinal":164589,"en":"Receiving a blessing from a holy elder,"},{"id":"semetey-1-2013:p1145:b005:l030","ordinal":164590,"en":"Because they survived,"},{"id":"semetey-1-2013:p1145:b005:l031","ordinal":164591,"en":"They were called Esenkhan."},{"id":"semetey-1-2013:p1145:b005:l032","ordinal":164592,"en":"Of Kakanchyn's forty gates,"},{"id":"semetey-1-2013:p1145:b005:l033","ordinal":164593,"en":"One gate was never closed"},{"id":"semetey-1-2013:p1145:b005:l034","ordinal":164594,"en":"And opened toward Mecca."},{"id":"semetey-1-2013:p1145:b005:l035","ordinal":164595,"en":"Upon that gate"},{"id":"semetey-1-2013:p1145:b005:l036","ordinal":164596,"en":"Were written the names"},{"id":"semetey-1-2013:p1145:b005:l037","ordinal":164597,"en":"Of the white prophet Mustafa and Muhammad,"},{"id":"semetey-1-2013:p1145:b005:l038","ordinal":164598,"en":"Lest a devil should strike"},{"id":"semetey-1-2013:p1145:b005:l039","ordinal":164599,"en":"The mere handful of Muslims."},{"id":"semetey-1-2013:p1146:b003:l001","ordinal":164600,"en":"Upon Beijing of Kakanchyn,"},{"id":"semetey-1-2013:p1146:b003:l002","ordinal":164601,"en":"God's seed was scattered."},{"id":"semetey-1-2013:p1146:b003:l003","ordinal":164602,"en":"Seed poured upon Beijing;"},{"id":"semetey-1-2013:p1146:b003:l004","ordinal":164603,"en":"His Holiness Ali the lion"},{"id":"semetey-1-2013:p1146:b003:l005","ordinal":164604,"en":"Turned back from great Beijing."},{"id":"semetey-1-2013:p1146:b003:l006","ordinal":164605,"en":"There is no great faith here."},{"id":"semetey-1-2013:p1146:b003:l007","ordinal":164606,"en":"Truly, God favored us;"},{"id":"semetey-1-2013:p1146:b003:l008","ordinal":164607,"en":"We have remained in their midst."},{"id":"semetey-1-2013:p1146:b003:l009","ordinal":164608,"en":"Such filth is this world;"}]
