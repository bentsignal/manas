[{"id":"manas-2010:p1514:b001:l022","ordinal":65281,"en":"Leading him out beside him,"},{"id":"manas-2010:p1514:b001:l023","ordinal":65282,"en":"Upon the Chinese people of forty khans"},{"id":"manas-2010:p1514:b001:l024","ordinal":65283,"en":"Pressure had fallen."},{"id":"manas-2010:p1514:b001:l025","ordinal":65284,"en":"Riding and prancing a rhinoceros,"},{"id":"manas-2010:p1514:b001:l026","ordinal":65285,"en":"Destroying all he met,"},{"id":"manas-2010:p1514:b001:l027","ordinal":65286,"en":"Tiken the giant had arrived."},{"id":"manas-2010:p1514:b001:l028","ordinal":65287,"en":"Joining Tiken the giant,"},{"id":"manas-2010:p1514:b001:l029","ordinal":65288,"en":"The true marksman Agayar,"},{"id":"manas-2010:p1514:b001:l030","ordinal":65289,"en":"Who had studied with Almambet,"},{"id":"manas-2010:p1514:b001:l031","ordinal":65290,"en":"He too had arrived."},{"id":"manas-2010:p1514:b001:l032","ordinal":65291,"en":"For the many Chinese driven back,"},{"id":"manas-2010:p1514:b001:l033","ordinal":65292,"en":"A day of rejoicing had dawned;"},{"id":"manas-2010:p1514:b001:l034","ordinal":65293,"en":"They had begun to beat their drums."},{"id":"manas-2010:p1514:b001:l035","ordinal":65294,"en":"A lion whose size was a mountain,"},{"id":"manas-2010:p1514:b001:l036","ordinal":65295,"en":"The arriving Tiken the giant"},{"id":"manas-2010:p1514:b001:l037","ordinal":65296,"en":"Was a lion from Beijing."},{"id":"manas-2010:p1514:b001:l038","ordinal":65297,"en":"His marksmen led by Agayar,"},{"id":"manas-2010:p1514:b001:l039","ordinal":65298,"en":"Tiken the giant arrayed them and charged."},{"id":"manas-2010:p1514:b001:l040","ordinal":65299,"en":"Angrily he said to the Kalcha,"},{"id":"manas-2010:p1514:b001:l041","ordinal":65300,"en":"“How have you ruled the people,"},{"id":"manas-2010:p1514:b001:l042","ordinal":65301,"en":"Mounted the golden throne,"},{"id":"manas-2010:p1515:b001:l001","ordinal":65302,"en":"And until now the Burut—"},{"id":"manas-2010:p1515:b001:l002","ordinal":65303,"en":"Why have you left them alive?”"},{"id":"manas-2010:p1515:b001:l003","ordinal":65304,"en":"Putting the Kalcha before him,"},{"id":"manas-2010:p1515:b001:l004","ordinal":65305,"en":"Tiken the giant drove him forward."},{"id":"manas-2010:p1515:b001:l005","ordinal":65306,"en":"Joined when they were small as lice,"},{"id":"manas-2010:p1515:b001:l006","ordinal":65307,"en":"Together when they were thumb-sized,"},{"id":"manas-2010:p1515:b001:l007","ordinal":65308,"en":"Azizkan's Almambet"},{"id":"manas-2010:p1515:b001:l008","ordinal":65309,"en":"Knew the ways of the Chinese."},{"id":"manas-2010:p1515:b001:l009","ordinal":65310,"en":"That they were Agayar and Tiken,"},{"id":"manas-2010:p1515:b001:l010","ordinal":65311,"en":"That they had now arrived,"},{"id":"manas-2010:p1515:b001:l011","ordinal":65312,"en":"Almambet knew."},{"id":"manas-2010:p1515:b001:l012","ordinal":65313,"en":"Then your Almambet said this:"},{"id":"manas-2010:p1515:b001:l013","ordinal":65314,"en":"“In the kakan's Beijing,"},{"id":"manas-2010:p1515:b001:l014","ordinal":65315,"en":"There was a champion kept and nourished."},{"id":"manas-2010:p1515:b001:l015","ordinal":65316,"en":"Karykan, khan of Beijing,"},{"id":"manas-2010:p1515:b001:l016","ordinal":65317,"en":"Torment and death"},{"id":"manas-2010:p1515:b001:l017","ordinal":65318,"en":"Could know six months beforehand;"},{"id":"manas-2010:p1515:b001:l018","ordinal":65319,"en":"He was rich in wisdom."},{"id":"manas-2010:p1515:b001:l019","ordinal":65320,"en":"‘In Beijing untouched by the Flood,"},{"id":"manas-2010:p1515:b001:l020","ordinal":65321,"en":"When a hellish battle comes,"},{"id":"manas-2010:p1515:b001:l021","ordinal":65322,"en":"When the Chinese rise,"},{"id":"manas-2010:p1515:b001:l022","ordinal":65323,"en":"He will come out without delay,’ he said,"},{"id":"manas-2010:p1515:b001:l023","ordinal":65324,"en":"And kept that man nourished."},{"id":"manas-2010:p1515:b001:l024","ordinal":65325,"en":"His champion has arrived;"},{"id":"manas-2010:p1515:b001:l025","ordinal":65326,"en":"Named Tiken the giant,"},{"id":"manas-2010:p1515:b001:l026","ordinal":65327,"en":"His fortress has arrived."},{"id":"manas-2010:p1515:b001:l027","ordinal":65328,"en":"In my childhood,"},{"id":"manas-2010:p1515:b001:l028","ordinal":65329,"en":"Before the dragon,"},{"id":"manas-2010:p1515:b001:l029","ordinal":65330,"en":"When, saying, ‘We shall study,’"},{"id":"manas-2010:p1515:b001:l030","ordinal":65331,"en":"Six thousand children went,"},{"id":"manas-2010:p1515:b001:l031","ordinal":65332,"en":"And six thousand of them perished,"},{"id":"manas-2010:p1515:b001:l032","ordinal":65333,"en":"When six children remained,"},{"id":"manas-2010:p1515:b001:l033","ordinal":65334,"en":"One of them was Agayar;"},{"id":"manas-2010:p1515:b001:l034","ordinal":65335,"en":"He too has now arrived."},{"id":"manas-2010:p1515:b001:l035","ordinal":65336,"en":"A great marksman in the treasury's service,"},{"id":"manas-2010:p1515:b001:l036","ordinal":65337,"en":"Who comes out when the Chinese rise;"},{"id":"manas-2010:p1515:b001:l037","ordinal":65338,"en":"Be ready to defend your life,"},{"id":"manas-2010:p1515:b001:l038","ordinal":65339,"en":"My darling Syrgak!"},{"id":"manas-2010:p1515:b001:l039","ordinal":65340,"en":"I shall not let them take me;"},{"id":"manas-2010:p1515:b001:l040","ordinal":65341,"en":"The reason they shall not take me—"},{"id":"manas-2010:p1515:b001:l041","ordinal":65342,"en":"I have saddled Sarala."},{"id":"manas-2010:p1515:b001:l042","ordinal":65343,"en":"When I was a headstrong child,"},{"id":"manas-2010:p1516:b001:l001","ordinal":65344,"en":"Than these two who have arrived,"},{"id":"manas-2010:p1516:b001:l002","ordinal":65345,"en":"I studied about six months earlier.”"},{"id":"manas-2010:p1516:b001:l003","ordinal":65346,"en":"Before he had closed his mouth,"},{"id":"manas-2010:p1516:b001:l004","ordinal":65347,"en":"Agayar, who lay in wait,"},{"id":"manas-2010:p1516:b001:l005","ordinal":65348,"en":"Bent his knees to the ground."},{"id":"manas-2010:p1516:b001:l006","ordinal":65349,"en":"Agayar did not move straight ahead;"},{"id":"manas-2010:p1516:b001:l007","ordinal":65350,"en":"He ran sideways."},{"id":"manas-2010:p1516:b001:l008","ordinal":65351,"en":"Changing his cap,"},{"id":"manas-2010:p1516:b001:l009","ordinal":65352,"en":"He had dressed himself in green,"},{"id":"manas-2010:p1516:b001:l010","ordinal":65353,"en":"And had gone into their midst."},{"id":"manas-2010:p1516:b001:l011","ordinal":65354,"en":"The plane tree of the mountain passes,"},{"id":"manas-2010:p1516:b001:l012","ordinal":65355,"en":"Kökötöy's shining lamp,"},{"id":"manas-2010:p1516:b001:l013","ordinal":65356,"en":"The star above his head,"},{"id":"manas-2010:p1516:b001:l014","ordinal":65357,"en":"Kökötöy's only son,"},{"id":"manas-2010:p1516:b001:l015","ordinal":65358,"en":"The spring that feeds the river—"},{"id":"manas-2010:p1516:b001:l016","ordinal":65359,"en":"When they saw Agayar,"},{"id":"manas-2010:p1516:b001:l017","ordinal":65360,"en":"The Chinese parted and dashed away."},{"id":"manas-2010:p1516:b001:l018","ordinal":65361,"en":"As he sat proudly on Maaniker,"},{"id":"manas-2010:p1516:b001:l019","ordinal":65362,"en":"Holding him crosswise,"},{"id":"manas-2010:p1516:b001:l020","ordinal":65363,"en":"That bastard marksman Agayar"},{"id":"manas-2010:p1516:b001:l021","ordinal":65364,"en":"Shot Bokmurun once."},{"id":"manas-2010:p1516:b001:l022","ordinal":65365,"en":"Kökötöy's only son,"},{"id":"manas-2010:p1516:b001:l023","ordinal":65366,"en":"His appointed death come, fell to the bullet;"},{"id":"manas-2010:p1516:b001:l024","ordinal":65367,"en":"He flew from his horse and fell with a thud."},{"id":"manas-2010:p1516:b001:l025","ordinal":65368,"en":"His half-open eyes barely showing,"},{"id":"manas-2010:p1516:b001:l026","ordinal":65369,"en":"His fine moustache lying smooth,"},{"id":"manas-2010:p1516:b001:l027","ordinal":65370,"en":"He set out for Judgment."},{"id":"manas-2010:p1516:b001:l028","ordinal":65371,"en":"Seeing this, Kongurbay"},{"id":"manas-2010:p1516:b001:l029","ordinal":65372,"en":"Stood roaring and shouting."},{"id":"manas-2010:p1516:b001:l030","ordinal":65373,"en":"Of ninety thousand Chinese and Manchu,"},{"id":"manas-2010:p1516:b001:l031","ordinal":65374,"en":"He scattered the tumult to dust,"},{"id":"manas-2010:p1516:b001:l032","ordinal":65375,"en":"Breaking up their ranks."},{"id":"manas-2010:p1516:b001:l033","ordinal":65376,"en":"“Their Syrgak, no bigger than a knucklebone—"},{"id":"manas-2010:p1516:b001:l034","ordinal":65377,"en":"Shoot him!” he roared."},{"id":"manas-2010:p1516:b001:l035","ordinal":65378,"en":"Hearing this, Agayar"},{"id":"manas-2010:p1516:b001:l036","ordinal":65379,"en":"Dashed toward Syrgak."},{"id":"manas-2010:p1516:b001:l037","ordinal":65380,"en":"At a lone ledge, a rocky cliff,"},{"id":"manas-2010:p1516:b001:l038","ordinal":65381,"en":"Just as he went to lie down,"},{"id":"manas-2010:p1516:b001:l039","ordinal":65382,"en":"At Syrgak who was nearby,"},{"id":"manas-2010:p1516:b001:l040","ordinal":65383,"en":"Just as he took aim to shoot,"},{"id":"manas-2010:p1516:b001:l041","ordinal":65384,"en":"The skilled Almambet"},{"id":"manas-2010:p1516:b001:l042","ordinal":65385,"en":"Took his lacquered musket in hand,"},{"id":"manas-2010:p1517:b001:l001","ordinal":65386,"en":"And aimed at the sorcerer."},{"id":"manas-2010:p1517:b001:l002","ordinal":65387,"en":"The expert marksman's"},{"id":"manas-2010:p1517:b001:l003","ordinal":65388,"en":"Hammer stood ready."},{"id":"manas-2010:p1517:b001:l004","ordinal":65389,"en":"“Agayar's head,” he said,"},{"id":"manas-2010:p1517:b001:l005","ordinal":65390,"en":"“His moon-like brow,” he said,"},{"id":"manas-2010:p1517:b001:l006","ordinal":65391,"en":"And pulled it once."},{"id":"manas-2010:p1517:b001:l007","ordinal":65392,"en":"His bullet reached him with a roar;"},{"id":"manas-2010:p1517:b001:l008","ordinal":65393,"en":"Of the sorcerer lying on the rock,"},{"id":"manas-2010:p1517:b001:l009","ordinal":65394,"en":"It tore off his head as it passed."},{"id":"manas-2010:p1517:b001:l010","ordinal":65395,"en":"From the farther side, Tiken the giant,"},{"id":"manas-2010:p1517:b001:l011","ordinal":65396,"en":"Whipping his rhinoceros,"},{"id":"manas-2010:p1517:b001:l012","ordinal":65397,"en":"Thundering like a storm,"},{"id":"manas-2010:p1517:b001:l013","ordinal":65398,"en":"Came toward your Almambet."},{"id":"manas-2010:p1517:b001:l014","ordinal":65399,"en":"When he drew near Almambet,"},{"id":"manas-2010:p1517:b001:l015","ordinal":65400,"en":"With his black hat's brim,"},{"id":"manas-2010:p1517:b001:l016","ordinal":65401,"en":"From where did he swoop like a falcon,"},{"id":"manas-2010:p1517:b001:l017","ordinal":65402,"en":"Khan Manas's Syrgak?"},{"id":"manas-2010:p1517:b001:l018","ordinal":65403,"en":"Before he could reach Almambet,"},{"id":"manas-2010:p1517:b001:l019","ordinal":65404,"en":"Syrgak reached him from the side;"},{"id":"manas-2010:p1517:b001:l020","ordinal":65405,"en":"As soon as he reached Tiken,"},{"id":"manas-2010:p1517:b001:l021","ordinal":65406,"en":"He struck him in the flank and rode past."},{"id":"manas-2010:p1517:b001:l022","ordinal":65407,"en":"When Syrgak had thrust and passed,"},{"id":"manas-2010:p1517:b001:l023","ordinal":65408,"en":"The mighty wolf born Almambet"},{"id":"manas-2010:p1517:b001:l024","ordinal":65409,"en":"Set himself aright;"},{"id":"manas-2010:p1517:b001:l025","ordinal":65410,"en":"To spear Tiken,"},{"id":"manas-2010:p1517:b001:l026","ordinal":65411,"en":"He moved in close."},{"id":"manas-2010:p1517:b001:l027","ordinal":65412,"en":"If you looked, Tiken was a hero,"},{"id":"manas-2010:p1517:b001:l028","ordinal":65413,"en":"A lion born of Beijing."},{"id":"manas-2010:p1517:b001:l029","ordinal":65414,"en":"He was thirty-five years old,"},{"id":"manas-2010:p1517:b001:l030","ordinal":65415,"en":"In the fullness of his prime."},{"id":"manas-2010:p1517:b001:l031","ordinal":65416,"en":"Though two lances struck at once,"},{"id":"manas-2010:p1517:b001:l032","ordinal":65417,"en":"Though both lions thrust together,"},{"id":"manas-2010:p1517:b001:l033","ordinal":65418,"en":"Even then Tiken did not stir."},{"id":"manas-2010:p1517:b001:l034","ordinal":65419,"en":"All the warriors grew excited;"},{"id":"manas-2010:p1517:b001:l035","ordinal":65420,"en":"Leaving the poor ones behind,"},{"id":"manas-2010:p1517:b001:l036","ordinal":65421,"en":"Only the foremost faced each other;"},{"id":"manas-2010:p1517:b001:l037","ordinal":65422,"en":"They joined together in battle."},{"id":"manas-2010:p1517:b001:l038","ordinal":65423,"en":"Muzburchak and Kökchö, two giants—"},{"id":"manas-2010:p1517:b001:l039","ordinal":65424,"en":"Before a word could be spoken, these two"},{"id":"manas-2010:p1517:b001:l040","ordinal":65425,"en":"Tiken the giant reached as well."},{"id":"manas-2010:p1517:b001:l041","ordinal":65426,"en":"As soon as he reached them,"},{"id":"manas-2010:p1517:b001:l042","ordinal":65427,"en":"He knocked both down and passed."},{"id":"manas-2010:p1518:b001:l001","ordinal":65428,"en":"Before the champions behind them"},{"id":"manas-2010:p1518:b001:l002","ordinal":65429,"en":"Could reach these two,"},{"id":"manas-2010:p1518:b001:l003","ordinal":65430,"en":"Azizkan's Almambet"},{"id":"manas-2010:p1518:b001:l004","ordinal":65431,"en":"Reached Muzburchak."},{"id":"manas-2010:p1518:b001:l005","ordinal":65432,"en":"As soon as he reached him, Almambet"},{"id":"manas-2010:p1518:b001:l006","ordinal":65433,"en":"Slung him behind like a feedbag,"},{"id":"manas-2010:p1518:b001:l007","ordinal":65434,"en":"And carried him swiftly away."},{"id":"manas-2010:p1518:b001:l008","ordinal":65435,"en":"Keeping him from capture, he put him on a horse"},{"id":"manas-2010:p1518:b001:l009","ordinal":65436,"en":"And took him away alive."},{"id":"manas-2010:p1518:b001:l010","ordinal":65437,"en":"To Aydarkan's Kökchö,"},{"id":"manas-2010:p1518:b001:l011","ordinal":65438,"en":"The lion Chubak came."},{"id":"manas-2010:p1518:b001:l012","ordinal":65439,"en":"As soon as he reached Kökchö,"},{"id":"manas-2010:p1518:b001:l013","ordinal":65440,"en":"He leaned down and scooped him up;"},{"id":"manas-2010:p1518:b001:l014","ordinal":65441,"en":"He mounted him on Kögala,"},{"id":"manas-2010:p1518:b001:l015","ordinal":65442,"en":"Dressed him in his blue armor,"},{"id":"manas-2010:p1518:b001:l016","ordinal":65443,"en":"And took him away alive."},{"id":"manas-2010:p1518:b001:l017","ordinal":65444,"en":"Watching at that moment,"},{"id":"manas-2010:p1518:b001:l018","ordinal":65445,"en":"Kongurbay, khan of the monks,"},{"id":"manas-2010:p1518:b001:l019","ordinal":65446,"en":"Toward Akbaltay's Chubak"},{"id":"manas-2010:p1518:b001:l020","ordinal":65447,"en":"He too came with a roar."},{"id":"manas-2010:p1518:b001:l021","ordinal":65448,"en":"From the back of Kögala,"},{"id":"manas-2010:p1518:b001:l022","ordinal":65449,"en":"Chubak, vast as a mountain,"},{"id":"manas-2010:p1518:b001:l023","ordinal":65450,"en":"He knocked down and rode past."},{"id":"manas-2010:p1518:b001:l024","ordinal":65451,"en":"Before the Kalcha turned back into position,"},{"id":"manas-2010:p1518:b001:l025","ordinal":65452,"en":"Khan Ulak's Syrgak,"},{"id":"manas-2010:p1518:b001:l026","ordinal":65453,"en":"Whipping Kökchebich,"},{"id":"manas-2010:p1518:b001:l027","ordinal":65454,"en":"Arrived before an arrow could."},{"id":"manas-2010:p1518:b001:l028","ordinal":65455,"en":"The imposing Kalcha,"},{"id":"manas-2010:p1518:b001:l029","ordinal":65456,"en":"As soon as hero Syrgak reached him,"},{"id":"manas-2010:p1518:b001:l030","ordinal":65457,"en":"From the back of Algara"},{"id":"manas-2010:p1518:b001:l031","ordinal":65458,"en":"He knocked him down and rode past."},{"id":"manas-2010:p1518:b001:l032","ordinal":65459,"en":"Whipping Sarala,"},{"id":"manas-2010:p1518:b001:l033","ordinal":65460,"en":"Spurring on this side and that,"},{"id":"manas-2010:p1518:b001:l034","ordinal":65461,"en":"“I shall cut off his head,”"},{"id":"manas-2010:p1518:b001:l035","ordinal":65462,"en":"Almambet came, crying, “Go!”"},{"id":"manas-2010:p1518:b001:l036","ordinal":65463,"en":"At that time Tiken the giant,"},{"id":"manas-2010:p1518:b001:l037","ordinal":65464,"en":"Taking a club as big as a house,"},{"id":"manas-2010:p1518:b001:l038","ordinal":65465,"en":"Was coming toward Chubak,"},{"id":"manas-2010:p1518:b001:l039","ordinal":65466,"en":"The daredevil fallen from his horse."},{"id":"manas-2010:p1518:b001:l040","ordinal":65467,"en":"His mount Kögala stood there;"},{"id":"manas-2010:p1518:b001:l041","ordinal":65468,"en":"Argynkan's Azhybay"},{"id":"manas-2010:p1518:b001:l042","ordinal":65469,"en":"Came leading him alongside."},{"id":"manas-2010:p1519:b001:l001","ordinal":65470,"en":"As soon as he reached Chubak,"},{"id":"manas-2010:p1519:b001:l002","ordinal":65471,"en":"He mounted him on Kögala"},{"id":"manas-2010:p1519:b001:l003","ordinal":65472,"en":"And took him away alive."},{"id":"manas-2010:p1519:b001:l004","ordinal":65473,"en":"Before Almambet could arrive,"},{"id":"manas-2010:p1519:b001:l005","ordinal":65474,"en":"Before he could cut off his head,"},{"id":"manas-2010:p1519:b001:l006","ordinal":65475,"en":"Forty champions of the Chinese"},{"id":"manas-2010:p1519:b001:l007","ordinal":65476,"en":"Had reached Kongurbay;"},{"id":"manas-2010:p1519:b001:l008","ordinal":65477,"en":"They mounted him on Algara"},{"id":"manas-2010:p1519:b001:l009","ordinal":65478,"en":"And took him away alive."},{"id":"manas-2010:p1519:b001:l010","ordinal":65479,"en":"Drenched in dark blood,"},{"id":"manas-2010:p1519:b001:l011","ordinal":65480,"en":"Fighting this way and that,"},{"id":"manas-2010:p1519:b001:l012","ordinal":65481,"en":"A mighty battle took place."},{"id":"manas-2010:p1519:b001:l013","ordinal":65482,"en":"Stained with red blood,"},{"id":"manas-2010:p1519:b001:l014","ordinal":65483,"en":"Not sparing their lives a hair,"},{"id":"manas-2010:p1519:b001:l015","ordinal":65484,"en":"The wolves faced one another;"},{"id":"manas-2010:p1519:b001:l016","ordinal":65485,"en":"A terrible battle took place."},{"id":"manas-2010:p1519:b001:l017","ordinal":65486,"en":"At that time hero Syrgak,"},{"id":"manas-2010:p1519:b001:l018","ordinal":65487,"en":"The many champions and mighty lions—"},{"id":"manas-2010:p1519:b001:l019","ordinal":65488,"en":"He gave them not a speck of thought;"},{"id":"manas-2010:p1519:b001:l020","ordinal":65489,"en":"Not sparing his life a hair,"},{"id":"manas-2010:p1519:b001:l021","ordinal":65490,"en":"Beside Tiken the giant,"},{"id":"manas-2010:p1519:b001:l022","ordinal":65491,"en":"His warriors gathered as one;"},{"id":"manas-2010:p1519:b001:l023","ordinal":65492,"en":"Those who spared not their own lives,"},{"id":"manas-2010:p1519:b001:l024","ordinal":65493,"en":"The outstanding ones stood apart."},{"id":"manas-2010:p1519:b001:l025","ordinal":65494,"en":"All of these,"},{"id":"manas-2010:p1519:b001:l026","ordinal":65495,"en":"With Tiken the giant at their head,"},{"id":"manas-2010:p1519:b001:l027","ordinal":65496,"en":"Like creatures struck by a lion,"},{"id":"manas-2010:p1519:b001:l028","ordinal":65497,"en":"He drove before him in pursuit."},{"id":"manas-2010:p1519:b001:l029","ordinal":65498,"en":"Shouting, “Islam!”"},{"id":"manas-2010:p1519:b001:l030","ordinal":65499,"en":"Making them start like a falcon,"},{"id":"manas-2010:p1519:b001:l031","ordinal":65500,"en":"He drove the Chinese away."},{"id":"manas-2010:p1519:b001:l032","ordinal":65501,"en":"From the kakan's Beijing,"},{"id":"manas-2010:p1519:b001:l033","ordinal":65502,"en":"The Chinese who had swept upon them"},{"id":"manas-2010:p1519:b001:l034","ordinal":65503,"en":"He drove back again."},{"id":"manas-2010:p1519:b001:l035","ordinal":65504,"en":"Through their middle, hero Syrgak"},{"id":"manas-2010:p1519:b001:l036","ordinal":65505,"en":"Went cutting and slaughtering;"},{"id":"manas-2010:p1519:b001:l037","ordinal":65506,"en":"Around their edges, Almambet"},{"id":"manas-2010:p1519:b001:l038","ordinal":65507,"en":"Went slaughtering as he rode."},{"id":"manas-2010:p1519:b001:l039","ordinal":65508,"en":"The forty companions, every one a wolf,"},{"id":"manas-2010:p1519:b001:l040","ordinal":65509,"en":"Sweeping them from forty places,"},{"id":"manas-2010:p1519:b001:l041","ordinal":65510,"en":"Drove them on, scattering them;"},{"id":"manas-2010:p1519:b001:l042","ordinal":65511,"en":"Making their heads like peas,"},{"id":"manas-2010:p1520:b001:l001","ordinal":65512,"en":"They cut them off and rode on."},{"id":"manas-2010:p1520:b001:l002","ordinal":65513,"en":"Brandishing his adze,"},{"id":"manas-2010:p1520:b001:l003","ordinal":65514,"en":"Making all he met crawl,"},{"id":"manas-2010:p1520:b001:l004","ordinal":65515,"en":"His roar splitting stones,"},{"id":"manas-2010:p1520:b001:l005","ordinal":65516,"en":"His shout splitting heads,"},{"id":"manas-2010:p1520:b001:l006","ordinal":65517,"en":"Turning back now to charge,"},{"id":"manas-2010:p1520:b001:l007","ordinal":65518,"en":"Mountain-like Tiken the giant,"},{"id":"manas-2010:p1520:b001:l008","ordinal":65519,"en":"Plunging through without stopping,"},{"id":"manas-2010:p1520:b001:l009","ordinal":65520,"en":"Spearing those he met,"},{"id":"manas-2010:p1520:b001:l010","ordinal":65521,"en":"Tiken the giant charged in."},{"id":"manas-2010:p1520:b001:l011","ordinal":65522,"en":"At once, with a roar,"},{"id":"manas-2010:p1520:b001:l012","ordinal":65523,"en":"Baychoro and Yrchy Uul,"},{"id":"manas-2010:p1520:b001:l013","ordinal":65524,"en":"Argynkan's Azhybay—"},{"id":"manas-2010:p1520:b001:l014","ordinal":65525,"en":"He reached these three."},{"id":"manas-2010:p1520:b001:l015","ordinal":65526,"en":"As soon as he reached them,"},{"id":"manas-2010:p1520:b001:l016","ordinal":65527,"en":"He sent them tumbling from their horses,"},{"id":"manas-2010:p1520:b001:l017","ordinal":65528,"en":"Knocking them down as he passed."},{"id":"manas-2010:p1520:b001:l018","ordinal":65529,"en":"When they saw Tiken the giant,"},{"id":"manas-2010:p1520:b001:l019","ordinal":65530,"en":"The great host of Burut Muslims"},{"id":"manas-2010:p1520:b001:l020","ordinal":65531,"en":"Drew back, clamoring;"},{"id":"manas-2010:p1520:b001:l021","ordinal":65532,"en":"“Now we are dead!” they wailed."},{"id":"manas-2010:p1520:b001:l022","ordinal":65533,"en":"Seeing this, the many Chinese"},{"id":"manas-2010:p1520:b001:l023","ordinal":65534,"en":"Were about to surge upon them again,"},{"id":"manas-2010:p1520:b001:l024","ordinal":65535,"en":"The three heroes fallen from their horses"},{"id":"manas-2010:p1520:b001:l025","ordinal":65536,"en":"About to bind them alive and carry them away,"}]
