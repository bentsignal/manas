[{"id":"manas-2010:p0964:b001:l004","ordinal":42241,"en":"He took her by the hand and swung her round,"},{"id":"manas-2010:p0964:b001:l005","ordinal":42242,"en":"And kicked her under the arm."},{"id":"manas-2010:p0964:b001:l006","ordinal":42243,"en":"Before enjoying their happiness,"},{"id":"manas-2010:p0964:b001:l007","ordinal":42244,"en":"Before lying in her embrace,"},{"id":"manas-2010:p0964:b001:l008","ordinal":42245,"en":"Before gathering the learned men,"},{"id":"manas-2010:p0964:b001:l009","ordinal":42246,"en":"He seized her left hand and swung her round,"},{"id":"manas-2010:p0964:b001:l010","ordinal":42247,"en":"Kicked her under the arm,"},{"id":"manas-2010:p0964:b001:l011","ordinal":42248,"en":"And two of her ribs,"},{"id":"manas-2010:p0964:b001:l012","ordinal":42249,"en":"When the warrior's foot struck,"},{"id":"manas-2010:p0964:b001:l013","ordinal":42250,"en":"Were terribly shattered."},{"id":"manas-2010:p0964:b001:l014","ordinal":42251,"en":"The twelve pairs of ribs"},{"id":"manas-2010:p0964:b001:l015","ordinal":42252,"en":"Nearly slipped out of place."},{"id":"manas-2010:p0964:b001:l016","ordinal":42253,"en":"Then Kanykey,"},{"id":"manas-2010:p0964:b001:l017","ordinal":42254,"en":"Her heart broken,"},{"id":"manas-2010:p0964:b001:l018","ordinal":42255,"en":"Without speaking in protest,"},{"id":"manas-2010:p0964:b001:l019","ordinal":42256,"en":"Her tears pouring down,"},{"id":"manas-2010:p0964:b001:l020","ordinal":42257,"en":"'The blame is mine alone;"},{"id":"manas-2010:p0964:b001:l021","ordinal":42258,"en":"My own deed has overtaken me,' she thought."},{"id":"manas-2010:p0964:b001:l022","ordinal":42259,"en":"She made no retort,"},{"id":"manas-2010:p0964:b001:l023","ordinal":42260,"en":"Nor complained of brow or eyebrow."},{"id":"manas-2010:p0964:b001:l024","ordinal":42261,"en":"Because of that wrongful deed,"},{"id":"manas-2010:p0964:b001:l025","ordinal":42262,"en":"He laid punishment upon her"},{"id":"manas-2010:p0964:b001:l026","ordinal":42263,"en":"And left without lying in her embrace."},{"id":"manas-2010:p0964:b003:l001","ordinal":42264,"en":"Kozubek, khan of Kokand,"},{"id":"manas-2010:p0964:b003:l002","ordinal":42265,"en":"Malabek of Margalan,"},{"id":"manas-2010:p0964:b003:l003","ordinal":42266,"en":"Fork-bearded Synchybek of Andijan,"},{"id":"manas-2010:p0964:b003:l004","ordinal":42267,"en":"The box-bearded Uzbek—"},{"id":"manas-2010:p0964:b003:l005","ordinal":42268,"en":"With these, the four khans' people were Sarts,"},{"id":"manas-2010:p0964:b003:l006","ordinal":42269,"en":"No strength to bind about one's waist,"},{"id":"manas-2010:p0964:b003:l007","ordinal":42270,"en":"But an affliction like an aching back."},{"id":"manas-2010:p0964:b003:l008","ordinal":42271,"en":"As though that were not enough,"},{"id":"manas-2010:p0964:b003:l009","ordinal":42272,"en":"Dust rose from between,"},{"id":"manas-2010:p0964:b003:l010","ordinal":42273,"en":"And they came from lower India too."},{"id":"manas-2010:p0964:b003:l011","ordinal":42274,"en":"Dwelling in Sary-Arka,"},{"id":"manas-2010:p0964:b003:l012","ordinal":42275,"en":"Called a weighty, formidable people,"},{"id":"manas-2010:p0964:b003:l013","ordinal":42276,"en":"With yurt lattices of wood,"},{"id":"manas-2010:p0965:b001:l001","ordinal":42277,"en":"Their forefather being Alach,"},{"id":"manas-2010:p0965:b001:l002","ordinal":42278,"en":"Hero Kökchö, Aydarkan's son,"},{"id":"manas-2010:p0965:b001:l003","ordinal":42279,"en":"Came to that feast."},{"id":"manas-2010:p0965:b001:l004","ordinal":42280,"en":"Zhamgyrchy of the Eshtek,"},{"id":"manas-2010:p0965:b001:l005","ordinal":42281,"en":"And here Ormonbek of Khan Tekeche,"},{"id":"manas-2010:p0965:b001:l006","ordinal":42282,"en":"Summering in the Two Kemins,"},{"id":"manas-2010:p0965:b001:l007","ordinal":42283,"en":"Tethering a pair of black horses,"},{"id":"manas-2010:p0965:b001:l008","ordinal":42284,"en":"Sowing autumn rice,"},{"id":"manas-2010:p0965:b001:l009","ordinal":42285,"en":"Feeding the tethered horses its weeds,"},{"id":"manas-2010:p0965:b001:l010","ordinal":42286,"en":"Sharpening his dark tongue,"},{"id":"manas-2010:p0965:b001:l011","ordinal":42287,"en":"Speaking eloquently before the khan,"},{"id":"manas-2010:p0965:b001:l012","ordinal":42288,"en":"Gathering mixed folk into a people—"},{"id":"manas-2010:p0965:b001:l013","ordinal":42289,"en":"Hero Ürbü of Khan Eybit"},{"id":"manas-2010:p0965:b001:l014","ordinal":42290,"en":"Came to that feast as well."},{"id":"manas-2010:p0965:b001:l015","ordinal":42291,"en":"From the people of lower Urum,"},{"id":"manas-2010:p0965:b001:l016","ordinal":42292,"en":"Muzburchak, Buudaykan's son,"},{"id":"manas-2010:p0965:b001:l017","ordinal":42293,"en":"He too came to the feast."},{"id":"manas-2010:p0965:b001:l018","ordinal":42294,"en":"His wide eyes like the morning star,"},{"id":"manas-2010:p0965:b001:l019","ordinal":42295,"en":"His moonlike ears like shields,"},{"id":"manas-2010:p0965:b001:l020","ordinal":42296,"en":"Whose blessing enriched the people,"},{"id":"manas-2010:p0965:b001:l021","ordinal":42297,"en":"Whose care brought them light,"},{"id":"manas-2010:p0965:b001:l022","ordinal":42298,"en":"Khan Koshoy of the Katagan"},{"id":"manas-2010:p0965:b001:l023","ordinal":42299,"en":"Was there to speak impartially."},{"id":"manas-2010:p0965:b001:l024","ordinal":42300,"en":"The twelve Muslim khans"},{"id":"manas-2010:p0965:b001:l025","ordinal":42301,"en":"At the marsh of Üyrülmö"},{"id":"manas-2010:p0965:b001:l026","ordinal":42302,"en":"Gathered round in council;"},{"id":"manas-2010:p0965:b001:l027","ordinal":42303,"en":"At the marsh of Chogulma"},{"id":"manas-2010:p0965:b001:l028","ordinal":42304,"en":"They assembled in council."},{"id":"manas-2010:p0965:b001:l029","ordinal":42305,"en":"Laying their words before each other,"},{"id":"manas-2010:p0965:b001:l030","ordinal":42306,"en":"Gathering together,"},{"id":"manas-2010:p0965:b001:l031","ordinal":42307,"en":"Seeking and finding schemes,"},{"id":"manas-2010:p0965:b001:l032","ordinal":42308,"en":"The twelve Muslim khans—"},{"id":"manas-2010:p0965:b001:l033","ordinal":42309,"en":"What would they not gather?"},{"id":"manas-2010:p0965:b001:l034","ordinal":42310,"en":"To Manas, resting there,"},{"id":"manas-2010:p0965:b001:l035","ordinal":42311,"en":"What would they not do?"},{"id":"manas-2010:p0965:b001:l036","ordinal":42312,"en":"Upon Manas from above,"},{"id":"manas-2010:p0965:b001:l037","ordinal":42313,"en":"Why should they not descend?"},{"id":"manas-2010:p0965:b001:l038","ordinal":42314,"en":"That poor man's four kinds of livestock,"},{"id":"manas-2010:p0965:b001:l039","ordinal":42315,"en":"Why should they not scatter?"},{"id":"manas-2010:p0965:b001:l040","ordinal":42316,"en":"“Let us fall upon his head,"},{"id":"manas-2010:p0965:b001:l041","ordinal":42317,"en":"Let us scatter his four kinds of livestock."},{"id":"manas-2010:p0965:b001:l042","ordinal":42318,"en":"Raiding and taking his mares,"},{"id":"manas-2010:p0966:b001:l001","ordinal":42319,"en":"Let us take revenge on him!"},{"id":"manas-2010:p0966:b001:l002","ordinal":42320,"en":"If Manas comes near,"},{"id":"manas-2010:p0966:b001:l003","ordinal":42321,"en":"Let us punch his brains out,"},{"id":"manas-2010:p0966:b001:l004","ordinal":42322,"en":"Let us take revenge on him!"},{"id":"manas-2010:p0966:b001:l005","ordinal":42323,"en":"Have you noticed Manas?"},{"id":"manas-2010:p0966:b001:l006","ordinal":42324,"en":"Have you seen his grand bearing,"},{"id":"manas-2010:p0966:b001:l007","ordinal":42325,"en":"Like a wineskin soaked in water,"},{"id":"manas-2010:p0966:b001:l008","ordinal":42326,"en":"Have you seen him swell with pride?"},{"id":"manas-2010:p0966:b001:l009","ordinal":42327,"en":"Chasing white deer,"},{"id":"manas-2010:p0966:b001:l010","ordinal":42328,"en":"Have you seen him hunt?"},{"id":"manas-2010:p0966:b001:l011","ordinal":42329,"en":"Openly among all the people,"},{"id":"manas-2010:p0966:b001:l012","ordinal":42330,"en":"Have you seen him stir up turmoil?"},{"id":"manas-2010:p0966:b001:l013","ordinal":42331,"en":"The dark forest and ravine,"},{"id":"manas-2010:p0966:b001:l014","ordinal":42332,"en":"Have you seen him make his enemy?"},{"id":"manas-2010:p0966:b001:l015","ordinal":42333,"en":"The poor man who fled to him,"},{"id":"manas-2010:p0966:b001:l016","ordinal":42334,"en":"Have you seen him make powerful?"},{"id":"manas-2010:p0966:b001:l017","ordinal":42335,"en":"Talas where he dwells,"},{"id":"manas-2010:p0966:b001:l018","ordinal":42336,"en":"Have you seen him make his homeland?"},{"id":"manas-2010:p0966:b001:l019","ordinal":42337,"en":"The companion who came from Khangay,"},{"id":"manas-2010:p0966:b001:l020","ordinal":42338,"en":"Have you seen him make a khan?"},{"id":"manas-2010:p0966:b001:l021","ordinal":42339,"en":"The troublemaker who fled to him,"},{"id":"manas-2010:p0966:b001:l022","ordinal":42340,"en":"Have you seen him make his equal?"},{"id":"manas-2010:p0966:b001:l023","ordinal":42341,"en":"Almambet and Chubak,"},{"id":"manas-2010:p0966:b001:l024","ordinal":42342,"en":"Have you seen him make them lions?"},{"id":"manas-2010:p0966:b001:l025","ordinal":42343,"en":"Twelve nations had not struck;"},{"id":"manas-2010:p0966:b001:l026","ordinal":42344,"en":"Against Manas, with all this,"},{"id":"manas-2010:p0966:b001:l027","ordinal":42345,"en":"None remains to turn a lasso pole."},{"id":"manas-2010:p0966:b001:l028","ordinal":42346,"en":"If we do not attack this Manas,"},{"id":"manas-2010:p0966:b001:l029","ordinal":42347,"en":"If we do not find a sure way to deal with him,"},{"id":"manas-2010:p0966:b001:l030","ordinal":42348,"en":"He will plunder the spoils;"},{"id":"manas-2010:p0966:b001:l031","ordinal":42349,"en":"Manas will stir up disorder!"},{"id":"manas-2010:p0966:b001:l032","ordinal":42350,"en":"Now Manas has"},{"id":"manas-2010:p0966:b001:l033","ordinal":42351,"en":"A dark fur cap as big as a cauldron."},{"id":"manas-2010:p0966:b001:l034","ordinal":42352,"en":"If we let that poor man have his way,"},{"id":"manas-2010:p0966:b001:l035","ordinal":42353,"en":"Over all the people"},{"id":"manas-2010:p0966:b001:l036","ordinal":42354,"en":"He has the will to rule.”"},{"id":"manas-2010:p0966:b001:l037","ordinal":42355,"en":"Talking this nonsense,"},{"id":"manas-2010:p0966:b001:l038","ordinal":42356,"en":"The twelve Muslim khans"},{"id":"manas-2010:p0966:b001:l039","ordinal":42357,"en":"Concluded their consultation."},{"id":"manas-2010:p0966:b001:l040","ordinal":42358,"en":"Then Koshoy spoke these words:"},{"id":"manas-2010:p0966:b001:l041","ordinal":42359,"en":"“He had fortune in full measure;"},{"id":"manas-2010:p0966:b001:l042","ordinal":42360,"en":"He was a warrior supported by the saint,"},{"id":"manas-2010:p0967:b001:l001","ordinal":42361,"en":"For all the Muslims standing here,"},{"id":"manas-2010:p0967:b001:l002","ordinal":42362,"en":"He was a warrior who could provide."},{"id":"manas-2010:p0967:b001:l003","ordinal":42363,"en":"Even now Manas's"},{"id":"manas-2010:p0967:b001:l004","ordinal":42364,"en":"Strength is formidable."},{"id":"manas-2010:p0967:b001:l005","ordinal":42365,"en":"You handful of Muslims,"},{"id":"manas-2010:p0967:b001:l006","ordinal":42366,"en":"Beware lest he deal with you all!"},{"id":"manas-2010:p0967:b001:l007","ordinal":42367,"en":"Do not remind Manas"},{"id":"manas-2010:p0967:b001:l008","ordinal":42368,"en":"And have him knock out your ancient madness."},{"id":"manas-2010:p0967:b001:l009","ordinal":42369,"en":"Beware lest all the people standing here"},{"id":"manas-2010:p0967:b001:l010","ordinal":42370,"en":"He gather together,"},{"id":"manas-2010:p0967:b001:l011","ordinal":42371,"en":"And at Kakanchyn's Beijing"},{"id":"manas-2010:p0967:b001:l012","ordinal":42372,"en":"Have them slaughtered together."},{"id":"manas-2010:p0967:b001:l013","ordinal":42373,"en":"He lives at ease in Talas;"},{"id":"manas-2010:p0967:b001:l014","ordinal":42374,"en":"If you remind him of Beijing,"},{"id":"manas-2010:p0967:b001:l015","ordinal":42375,"en":"You handful of Muslims,"},{"id":"manas-2010:p0967:b001:l016","ordinal":42376,"en":"He will drive you in under guard."},{"id":"manas-2010:p0967:b001:l017","ordinal":42377,"en":"I know the story of Beijing."},{"id":"manas-2010:p0967:b001:l018","ordinal":42378,"en":"In the time of the prophet Noah,"},{"id":"manas-2010:p0967:b001:l019","ordinal":42379,"en":"The Flood swept through here."},{"id":"manas-2010:p0967:b001:l020","ordinal":42380,"en":"When the Flood surged and flowed,"},{"id":"manas-2010:p0967:b001:l021","ordinal":42381,"en":"When it covered the whole earth,"},{"id":"manas-2010:p0967:b001:l022","ordinal":42382,"en":"After that it became a land,"},{"id":"manas-2010:p0967:b001:l023","ordinal":42383,"en":"And the firmly rooted Chinese became a people."},{"id":"manas-2010:p0967:b001:l024","ordinal":42384,"en":"When the holy prophet Muhammad"},{"id":"manas-2010:p0967:b001:l025","ordinal":42385,"en":"Came out to his palace,"},{"id":"manas-2010:p0967:b001:l026","ordinal":42386,"en":"Radiance poured upon Beijing."},{"id":"manas-2010:p0967:b001:l027","ordinal":42387,"en":"His Holiness Ali the Lion—"},{"id":"manas-2010:p0967:b001:l028","ordinal":42388,"en":"Great Beijing has come down through the ages."},{"id":"manas-2010:p0967:b001:l029","ordinal":42389,"en":"Beware of stirring Manas up,"},{"id":"manas-2010:p0967:b001:l030","ordinal":42390,"en":"Lest he gather you as a levy,"},{"id":"manas-2010:p0967:b001:l031","ordinal":42391,"en":"Drive you to Beijing,"},{"id":"manas-2010:p0967:b001:l032","ordinal":42392,"en":"And surely have you slaughtered.”"},{"id":"manas-2010:p0967:b001:l033","ordinal":42393,"en":"Though Koshoy gave counsel,"},{"id":"manas-2010:p0967:b001:l034","ordinal":42394,"en":"They did not understand his counsel."},{"id":"manas-2010:p0967:b001:l035","ordinal":42395,"en":"The Muslims of the twelve khans"},{"id":"manas-2010:p0967:b001:l036","ordinal":42396,"en":"Would not heed his words at all."},{"id":"manas-2010:p0967:b001:l037","ordinal":42397,"en":"Though Koshoy spoke,"},{"id":"manas-2010:p0967:b001:l038","ordinal":42398,"en":"Not one obeyed him."},{"id":"manas-2010:p0967:b001:l039","ordinal":42399,"en":"With that, the Muslims"},{"id":"manas-2010:p0967:b001:l040","ordinal":42400,"en":"Did not hold themselves back."},{"id":"manas-2010:p0967:b001:l041","ordinal":42401,"en":"Their finest spear fighters,"},{"id":"manas-2010:p0967:b001:l042","ordinal":42402,"en":"Did you see them lead them out?"},{"id":"manas-2010:p0968:b001:l001","ordinal":42403,"en":"Those skilled with the battle-axe,"},{"id":"manas-2010:p0968:b001:l002","ordinal":42404,"en":"Did you see them equip them?"},{"id":"manas-2010:p0968:b001:l003","ordinal":42405,"en":"Broad-jawed and broad-tongued,"},{"id":"manas-2010:p0968:b001:l004","ordinal":42406,"en":"They set their orators apart;"},{"id":"manas-2010:p0968:b001:l005","ordinal":42407,"en":"Those who shot without missing,"},{"id":"manas-2010:p0968:b001:l006","ordinal":42408,"en":"They set their marksmen apart."},{"id":"manas-2010:p0968:b001:l007","ordinal":42409,"en":"Those skilled with the sword,"},{"id":"manas-2010:p0968:b001:l008","ordinal":42410,"en":"The finest who knew the enemy's ways,"},{"id":"manas-2010:p0968:b001:l009","ordinal":42411,"en":"Gathering all of these,"},{"id":"manas-2010:p0968:b001:l010","ordinal":42412,"en":"Did you see them lead them out?"},{"id":"manas-2010:p0968:b001:l011","ordinal":42413,"en":"A red banner with a golden crescent"},{"id":"manas-2010:p0968:b001:l012","ordinal":42414,"en":"They raised and carried at the front."},{"id":"manas-2010:p0968:b001:l013","ordinal":42415,"en":"Twelve thousand marksmen"},{"id":"manas-2010:p0968:b001:l014","ordinal":42416,"en":"Set their faces toward Talas."},{"id":"manas-2010:p0968:b001:l015","ordinal":42417,"en":"Riding their horses forward,"},{"id":"manas-2010:p0968:b001:l016","ordinal":42418,"en":"Swearing an oath unto death,"},{"id":"manas-2010:p0968:b001:l017","ordinal":42419,"en":"Chewing white wheat flour,"},{"id":"manas-2010:p0968:b001:l018","ordinal":42420,"en":"'Let whoever flees be a woman!' they said,"},{"id":"manas-2010:p0968:b001:l019","ordinal":42421,"en":"Swearing upon the holy Quran."},{"id":"manas-2010:p0968:b001:l020","ordinal":42422,"en":"They headed for the bounds of broad Talas,"},{"id":"manas-2010:p0968:b001:l021","ordinal":42423,"en":"Making their promise firm."},{"id":"manas-2010:p0968:b001:l022","ordinal":42424,"en":"The skilled among spear fighters,"},{"id":"manas-2010:p0968:b001:l023","ordinal":42425,"en":"The finest of them all,"},{"id":"manas-2010:p0968:b001:l024","ordinal":42426,"en":"Displaying his ample blue overshoes,"},{"id":"manas-2010:p0968:b001:l025","ordinal":42427,"en":"Making his thoroughbred hold its head high,"},{"id":"manas-2010:p0968:b001:l026","ordinal":42428,"en":"Kozubek, khan of Kokand—"},{"id":"manas-2010:p0968:b001:l027","ordinal":42429,"en":"Did you see the khan enter?"},{"id":"manas-2010:p0968:b001:l028","ordinal":42430,"en":"Surging along behind him,"},{"id":"manas-2010:p0968:b001:l029","ordinal":42431,"en":"Did you see them all enter?"},{"id":"manas-2010:p0968:b001:l030","ordinal":42432,"en":"Some of them rode"},{"id":"manas-2010:p0968:b001:l031","ordinal":42433,"en":"Karabayyr warhorses;"},{"id":"manas-2010:p0968:b001:l032","ordinal":42434,"en":"Some of them rode"},{"id":"manas-2010:p0968:b001:l033","ordinal":42435,"en":"Sieve-lunged, copper-limbed steeds."},{"id":"manas-2010:p0968:b001:l034","ordinal":42436,"en":"The twelve Muslim khans,"},{"id":"manas-2010:p0968:b001:l035","ordinal":42437,"en":"Looking neither up nor down,"},{"id":"manas-2010:p0968:b001:l036","ordinal":42438,"en":"Not thinking they might die,"},{"id":"manas-2010:p0968:b001:l037","ordinal":42439,"en":"Their swords swaying,"},{"id":"manas-2010:p0968:b001:l038","ordinal":42440,"en":"Their spears quivering,"},{"id":"manas-2010:p0968:b001:l039","ordinal":42441,"en":"Rode down into Talas"},{"id":"manas-2010:p0968:b001:l040","ordinal":42442,"en":"To pick a fight with Manas."},{"id":"manas-2010:p0968:b001:l041","ordinal":42443,"en":"Of Khan Manas's forty companions,"},{"id":"manas-2010:p0968:b001:l042","ordinal":42444,"en":"The finest of the forty,"},{"id":"manas-2010:p0969:b001:l001","ordinal":42445,"en":"Wearing a gray lynx-fur cap,"},{"id":"manas-2010:p0969:b001:l002","ordinal":42446,"en":"Playing his blue-mottled shield,"},{"id":"manas-2010:p0969:b001:l003","ordinal":42447,"en":"Sheltering his head in abundant gold,"},{"id":"manas-2010:p0969:b001:l004","ordinal":42448,"en":"Supporting his feet with a thousand silver pieces,"},{"id":"manas-2010:p0969:b001:l005","ordinal":42449,"en":"Who found an eye in darkness,"},{"id":"manas-2010:p0969:b001:l006","ordinal":42450,"en":"Found a word at an unexpected moment,"},{"id":"manas-2010:p0969:b001:l007","ordinal":42451,"en":"If he led the way, the road was blessed;"},{"id":"manas-2010:p0969:b001:l008","ordinal":42452,"en":"If he journeyed far, he was like countless troops."},{"id":"manas-2010:p0969:b001:l009","ordinal":42453,"en":"Khan Bakay, the rich man's son,"},{"id":"manas-2010:p0969:b001:l010","ordinal":42454,"en":"Who rinsed his mouth with honey,"},{"id":"manas-2010:p0969:b001:l011","ordinal":42455,"en":"The sovereign of the companions,"},{"id":"manas-2010:p0969:b001:l012","ordinal":42456,"en":"A saint born of humankind—"},{"id":"manas-2010:p0969:b001:l013","ordinal":42457,"en":"Wolf-maned hero Bakay's"},{"id":"manas-2010:p0969:b001:l014","ordinal":42458,"en":"Wisdom was a broad river."},{"id":"manas-2010:p0969:b001:l015","ordinal":42459,"en":"Wise Bakay, the saint,"},{"id":"manas-2010:p0969:b001:l016","ordinal":42460,"en":"When he saw this conduct of the twelve khans,"},{"id":"manas-2010:p0969:b001:l017","ordinal":42461,"en":"All the companions,"},{"id":"manas-2010:p0969:b001:l018","ordinal":42462,"en":"Did you see him gather them?"},{"id":"manas-2010:p0969:b001:l019","ordinal":42463,"en":"Syrgak of Khan Ulak,"},{"id":"manas-2010:p0969:b001:l020","ordinal":42464,"en":"Did you see him restrain him?"},{"id":"manas-2010:p0969:b001:l021","ordinal":42465,"en":"Calling out for consultation,"},{"id":"manas-2010:p0969:b001:l022","ordinal":42466,"en":"Hero Bakay then"},{"id":"manas-2010:p0969:b001:l023","ordinal":42467,"en":"Ajybay, Argyn's son,"},{"id":"manas-2010:p0969:b001:l024","ordinal":42468,"en":"He summoned, his wise counselor:"},{"id":"manas-2010:p0969:b001:l025","ordinal":42469,"en":"“Your fathers' graves, forty companions!"},{"id":"manas-2010:p0969:b001:l026","ordinal":42470,"en":"We forty were warriors from forty places;"},{"id":"manas-2010:p0969:b001:l027","ordinal":42471,"en":"All of us alike were lions!"},{"id":"manas-2010:p0969:b001:l028","ordinal":42472,"en":"Some came without horses."},{"id":"manas-2010:p0969:b001:l029","ordinal":42473,"en":"To the companion who came horseless,"},{"id":"manas-2010:p0969:b001:l030","ordinal":42474,"en":"An argali-footed, copper-limbed,"},{"id":"manas-2010:p0969:b001:l031","ordinal":42475,"en":"Swift horse he gave to ride."},{"id":"manas-2010:p0969:b001:l032","ordinal":42476,"en":"To the companion who came without a coat,"},{"id":"manas-2010:p0969:b001:l033","ordinal":42477,"en":"Double mail with lark-eye rings,"},{"id":"manas-2010:p0969:b001:l034","ordinal":42478,"en":"A netted outer coat, a broad jacket,"},{"id":"manas-2010:p0969:b001:l035","ordinal":42479,"en":"Gold-collared and copper-sleeved,"},{"id":"manas-2010:p0969:b001:l036","ordinal":42480,"en":"He gave the finest coat to wear."},{"id":"manas-2010:p0969:b001:l037","ordinal":42481,"en":"To the companion who came without a wife,"},{"id":"manas-2010:p0969:b001:l038","ordinal":42482,"en":"A thimble-mouthed, camel-eyed,"},{"id":"manas-2010:p0969:b001:l039","ordinal":42483,"en":"Broad-hipped woman with jeweled braid ornaments,"},{"id":"manas-2010:p0969:b001:l040","ordinal":42484,"en":"Mighty Manas gave as a wife."},{"id":"manas-2010:p0969:b001:l041","ordinal":42485,"en":"To the companion who came without a faith,"},{"id":"manas-2010:p0969:b001:l042","ordinal":42486,"en":"Aykhojo in a mottled robe"},{"id":"manas-2010:p0970:b001:l001","ordinal":42487,"en":"Mighty Manas gave as a mullah."},{"id":"manas-2010:p0970:b001:l002","ordinal":42488,"en":"To the companion who came homeless,"},{"id":"manas-2010:p0970:b001:l003","ordinal":42489,"en":"As usual, without hesitation,"},{"id":"manas-2010:p0970:b001:l004","ordinal":42490,"en":"Mighty Manas gave a royal dwelling."},{"id":"manas-2010:p0970:b001:l005","ordinal":42491,"en":"Ajybay, son of Khan Argyn,"},{"id":"manas-2010:p0970:b001:l006","ordinal":42492,"en":"Knows sixty different tongues."},{"id":"manas-2010:p0970:b001:l007","ordinal":42493,"en":"If this is an enemy from China,"},{"id":"manas-2010:p0970:b001:l008","ordinal":42494,"en":"Lest trouble befall us,"},{"id":"manas-2010:p0970:b001:l009","ordinal":42495,"en":"Find out the news of them."},{"id":"manas-2010:p0970:b001:l010","ordinal":42496,"en":"If they are people of the Islamic faith,"}]
