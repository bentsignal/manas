[{"id":"manas-2010:p1190:b001:l024","ordinal":51713,"en":"He slashed them with his sword,"},{"id":"manas-2010:p1190:b001:l025","ordinal":51714,"en":"Slaughtered them all,"},{"id":"manas-2010:p1190:b001:l026","ordinal":51715,"en":"Brought them crashing down like a gorge."},{"id":"manas-2010:p1190:b001:l027","ordinal":51716,"en":"The Chinese, to fight,"},{"id":"manas-2010:p1190:b001:l028","ordinal":51717,"en":"Had no courage or strength at all."},{"id":"manas-2010:p1190:b001:l029","ordinal":51718,"en":"Kanzharkol and Muzkindik,"},{"id":"manas-2010:p1190:b001:l030","ordinal":51719,"en":"So many wrestlers, and Bozkertik—"},{"id":"manas-2010:p1190:b001:l031","ordinal":51720,"en":"Not one remained alive."},{"id":"manas-2010:p1190:b001:l032","ordinal":51721,"en":"Poised like a darting snake,"},{"id":"manas-2010:p1190:b001:l033","ordinal":51722,"en":"Almambet went cutting them down."},{"id":"manas-2010:p1190:b001:l034","ordinal":51723,"en":"Of the Chinese lying there,"},{"id":"manas-2010:p1190:b001:l035","ordinal":51724,"en":"He spared not one;"},{"id":"manas-2010:p1190:b001:l036","ordinal":51725,"en":"Almambet went butchering them."},{"id":"manas-2010:p1190:b001:l037","ordinal":51726,"en":"Then the huge woman"},{"id":"manas-2010:p1190:b001:l038","ordinal":51727,"en":"Roared furiously,"},{"id":"manas-2010:p1190:b001:l039","ordinal":51728,"en":"Brought down the palace above her"},{"id":"manas-2010:p1190:b001:l040","ordinal":51729,"en":"With a single hand,"},{"id":"manas-2010:p1190:b001:l041","ordinal":51730,"en":"Hurried toward the outside,"},{"id":"manas-2010:p1190:b001:l042","ordinal":51731,"en":"And the huge woman dashed out."},{"id":"manas-2010:p1191:b001:l001","ordinal":51732,"en":"All her gear was ready;"},{"id":"manas-2010:p1191:b001:l002","ordinal":51733,"en":"Her swift steed"},{"id":"manas-2010:p1191:b001:l003","ordinal":51734,"en":"Was tethered in the white stable."},{"id":"manas-2010:p1191:b001:l004","ordinal":51735,"en":"The huge woman reached it,"},{"id":"manas-2010:p1191:b001:l005","ordinal":51736,"en":"Leaped upon the horse,"},{"id":"manas-2010:p1191:b001:l006","ordinal":51737,"en":"Struck it once with her whip,"},{"id":"manas-2010:p1191:b001:l007","ordinal":51738,"en":"And rode toward Beijing."},{"id":"manas-2010:p1191:b001:l008","ordinal":51739,"en":"His courage grew"},{"id":"manas-2010:p1191:b001:l009","ordinal":51740,"en":"Ever stronger, Almambet's."},{"id":"manas-2010:p1191:b001:l010","ordinal":51741,"en":"‘The woman will reach Beijing,"},{"id":"manas-2010:p1191:b001:l011","ordinal":51742,"en":"She will escape beyond our reach!’"},{"id":"manas-2010:p1191:b001:l012","ordinal":51743,"en":"Almambet hurried."},{"id":"manas-2010:p1191:b001:l013","ordinal":51744,"en":"In his haste he roared,"},{"id":"manas-2010:p1191:b001:l014","ordinal":51745,"en":"‘Come quickly!’ he called."},{"id":"manas-2010:p1191:b001:l015","ordinal":51746,"en":"Hearing Almambet's voice,"},{"id":"manas-2010:p1191:b001:l016","ordinal":51747,"en":"Would noble Syrgak stand idle?"},{"id":"manas-2010:p1191:b001:l017","ordinal":51748,"en":"Leading Sarala,"},{"id":"manas-2010:p1191:b001:l018","ordinal":51749,"en":"His face like the shining moon,"},{"id":"manas-2010:p1191:b001:l019","ordinal":51750,"en":"He made it race along;"},{"id":"manas-2010:p1191:b001:l020","ordinal":51751,"en":"In the blink of an eye,"},{"id":"manas-2010:p1191:b001:l021","ordinal":51752,"en":"The rascal brought it to him."},{"id":"manas-2010:p1191:b001:l022","ordinal":51753,"en":"He mounted Sarala,"},{"id":"manas-2010:p1191:b001:l023","ordinal":51754,"en":"Tracked her without losing the trail,"},{"id":"manas-2010:p1191:b001:l024","ordinal":51755,"en":"And pursued the woman."},{"id":"manas-2010:p1191:b001:l025","ordinal":51756,"en":"Kökchebich and Sarala,"},{"id":"manas-2010:p1191:b001:l026","ordinal":51757,"en":"With Kartküröng led alongside,"},{"id":"manas-2010:p1191:b001:l027","ordinal":51758,"en":"Fought against their bits;"},{"id":"manas-2010:p1191:b001:l028","ordinal":51759,"en":"The heroes Almambet and Syrgak"},{"id":"manas-2010:p1191:b001:l029","ordinal":51760,"en":"Raced against the flying birds."},{"id":"manas-2010:p1191:b001:l030","ordinal":51761,"en":"At a pass through the dark mountain,"},{"id":"manas-2010:p1191:b001:l031","ordinal":51762,"en":"The fleeing woman"},{"id":"manas-2010:p1191:b001:l032","ordinal":51763,"en":"They overtook without delay."},{"id":"manas-2010:p1191:b001:l033","ordinal":51764,"en":"When they reached the woman,"},{"id":"manas-2010:p1191:b001:l034","ordinal":51765,"en":"Like a falcon, hero Syrgak"},{"id":"manas-2010:p1191:b001:l035","ordinal":51766,"en":"Knocked her down as he passed."},{"id":"manas-2010:p1191:b001:l036","ordinal":51767,"en":"Azizkan's son Almambet,"},{"id":"manas-2010:p1191:b001:l037","ordinal":51768,"en":"While the woman was recovering,"},{"id":"manas-2010:p1191:b001:l038","ordinal":51769,"en":"Cut off her head."},{"id":"manas-2010:p1191:b001:l039","ordinal":51770,"en":"Alma said to Syrgak,"},{"id":"manas-2010:p1191:b001:l040","ordinal":51771,"en":"He spoke at length:"},{"id":"manas-2010:p1191:b001:l041","ordinal":51772,"en":"‘Now my heart has no regret."},{"id":"manas-2010:p1191:b001:l042","ordinal":51773,"en":"Beyond the reach of a deluge, Beijing"},{"id":"manas-2010:p1192:b001:l001","ordinal":51774,"en":"Has no outpost left now, Syrgak!"},{"id":"manas-2010:p1192:b001:l002","ordinal":51775,"en":"Here is where I was born and grew, Syrgak!"},{"id":"manas-2010:p1192:b001:l003","ordinal":51776,"en":"When I was six years old,"},{"id":"manas-2010:p1192:b001:l004","ordinal":51777,"en":"I ran with my shirt off,"},{"id":"manas-2010:p1192:b001:l005","ordinal":51778,"en":"Chasing butterflies;"},{"id":"manas-2010:p1192:b001:l006","ordinal":51779,"en":"Here is where I grew up, Syrgak!"},{"id":"manas-2010:p1192:b001:l007","ordinal":51780,"en":"(Seeing his birthplace,"},{"id":"manas-2010:p1192:b001:l008","ordinal":51781,"en":"His heart was sorely troubled."},{"id":"manas-2010:p1192:b001:l009","ordinal":51782,"en":"His tears streamed ten ways,"},{"id":"manas-2010:p1192:b001:l010","ordinal":51783,"en":"Pouring out like a lake."},{"id":"manas-2010:p1192:b001:l011","ordinal":51784,"en":"The place of his birth and severed cord,"},{"id":"manas-2010:p1192:b001:l012","ordinal":51785,"en":"The place that washed away his grime,"},{"id":"manas-2010:p1192:b001:l013","ordinal":51786,"en":"Appeared to him like Mecca.)"},{"id":"manas-2010:p1192:b001:l014","ordinal":51787,"en":"When I was a playful child,"},{"id":"manas-2010:p1192:b001:l015","ordinal":51788,"en":"When I sat upon my golden throne,"},{"id":"manas-2010:p1192:b001:l016","ordinal":51789,"en":"That visible bank here,"},{"id":"manas-2010:p1192:b001:l017","ordinal":51790,"en":"And towering beyond it,"},{"id":"manas-2010:p1192:b001:l018","ordinal":51791,"en":"The high mountain with mottled gray crags,"},{"id":"manas-2010:p1192:b001:l019","ordinal":51792,"en":"Were my father's place called Khan-Zhaylak."},{"id":"manas-2010:p1192:b001:l020","ordinal":51793,"en":"From Beijing lying here,"},{"id":"manas-2010:p1192:b001:l021","ordinal":51794,"en":"I would have a thousand wrestlers brought,"},{"id":"manas-2010:p1192:b001:l022","ordinal":51795,"en":"Where the swift horses were tied,"},{"id":"manas-2010:p1192:b001:l023","ordinal":51796,"en":"I had a silver tethering line stretched,"},{"id":"manas-2010:p1192:b001:l024","ordinal":51797,"en":"And cauldrons loaded upon oxen."},{"id":"manas-2010:p1192:b001:l025","ordinal":51798,"en":"In cauldrons with forty handles,"},{"id":"manas-2010:p1192:b001:l026","ordinal":51799,"en":"I had their food boiled;"},{"id":"manas-2010:p1192:b001:l027","ordinal":51800,"en":"The Chinese who wished to come out,"},{"id":"manas-2010:p1192:b001:l028","ordinal":51801,"en":"I would not let out, making them miserable;"},{"id":"manas-2010:p1192:b001:l029","ordinal":51802,"en":"I was the one who barred their way."},{"id":"manas-2010:p1192:b001:l030","ordinal":51803,"en":"The truly swift Sarala"},{"id":"manas-2010:p1192:b001:l031","ordinal":51804,"en":"Used to graze here."},{"id":"manas-2010:p1192:b001:l032","ordinal":51805,"en":"My sun clouds over in the sky, Syrgak!"},{"id":"manas-2010:p1192:b001:l033","ordinal":51806,"en":"When I remember Beijing,"},{"id":"manas-2010:p1192:b001:l034","ordinal":51807,"en":"Into my head, small as a knucklebone,"},{"id":"manas-2010:p1192:b001:l035","ordinal":51808,"en":"The end of the world, Judgment Day,"},{"id":"manas-2010:p1192:b001:l036","ordinal":51809,"en":"Sixty cares come at once, Syrgak!"},{"id":"manas-2010:p1192:b001:l037","ordinal":51810,"en":"Almambet, upon Beijing,"},{"id":"manas-2010:p1192:b001:l038","ordinal":51811,"en":"Brought suffering through his reckless ways."},{"id":"manas-2010:p1192:b001:l039","ordinal":51812,"en":"In this Beijing here—"},{"id":"manas-2010:p1192:b001:l040","ordinal":51813,"en":"Ah, leave it, my Syrgak!"},{"id":"manas-2010:p1192:b001:l041","ordinal":51814,"en":"There was no Muslim faith!"},{"id":"manas-2010:p1192:b001:l042","ordinal":51815,"en":"In sprawling Beijing,"},{"id":"manas-2010:p1193:b001:l001","ordinal":51816,"en":"Had Almambet been a mighty khan,"},{"id":"manas-2010:p1193:b001:l002","ordinal":51817,"en":"Dividing the Chinese into a thousand,"},{"id":"manas-2010:p1193:b001:l003","ordinal":51818,"en":"Had there been in even one"},{"id":"manas-2010:p1193:b001:l004","ordinal":51819,"en":"A companion for me,"},{"id":"manas-2010:p1193:b001:l005","ordinal":51820,"en":"Upon populous Chinese Beijing,"},{"id":"manas-2010:p1193:b001:l006","ordinal":51821,"en":"How could I bring sorrow, Syrgak!"},{"id":"manas-2010:p1193:b001:l007","ordinal":51822,"en":"Had there been the Muslim faith,"},{"id":"manas-2010:p1193:b001:l008","ordinal":51823,"en":"How could I leave my people, Syrgak!"},{"id":"manas-2010:p1193:b001:l009","ordinal":51824,"en":"Leaving my people behind,"},{"id":"manas-2010:p1193:b001:l010","ordinal":51825,"en":"What wish would I fulfill, Syrgak!"},{"id":"manas-2010:p1193:b001:l011","ordinal":51826,"en":"My birthplace, where I first grew up—"},{"id":"manas-2010:p1193:b001:l012","ordinal":51827,"en":"Let me tell it all, Syrgak!"},{"id":"manas-2010:p1193:b001:l013","ordinal":51828,"en":"That dark ridge lying across there,"},{"id":"manas-2010:p1193:b001:l014","ordinal":51829,"en":"That is the source of the tea;"},{"id":"manas-2010:p1193:b001:l015","ordinal":51830,"en":"Those are the Chinese with their armies."},{"id":"manas-2010:p1193:b001:l016","ordinal":51831,"en":"To the Chinese peoples of forty khans,"},{"id":"manas-2010:p1193:b001:l017","ordinal":51832,"en":"I gave tea when they gave gold;"},{"id":"manas-2010:p1193:b001:l018","ordinal":51833,"en":"I was the one who ruled this Beijing."},{"id":"manas-2010:p1193:b001:l019","ordinal":51834,"en":"“Almambet's tea-producing town,”"},{"id":"manas-2010:p1193:b001:l020","ordinal":51835,"en":"They call it; to this day in Beijing,"},{"id":"manas-2010:p1193:b001:l021","ordinal":51836,"en":"My fame remains, Syrgak!"},{"id":"manas-2010:p1193:b001:l022","ordinal":51837,"en":"That mottled pass you see,"},{"id":"manas-2010:p1193:b001:l023","ordinal":51838,"en":"That is the place for digging gold."},{"id":"manas-2010:p1193:b001:l024","ordinal":51839,"en":"All its equipment was complete;"},{"id":"manas-2010:p1193:b001:l025","ordinal":51840,"en":"I alone knew how to work it all;"},{"id":"manas-2010:p1193:b001:l026","ordinal":51841,"en":"I am the one telling you, Syrgak!"},{"id":"manas-2010:p1193:b001:l027","ordinal":51842,"en":"That mottled sand, that red clay slope,"},{"id":"manas-2010:p1193:b001:l028","ordinal":51843,"en":"My unfortunate father,"},{"id":"manas-2010:p1193:b001:l029","ordinal":51844,"en":"Saying, “Almambet plays here,”"},{"id":"manas-2010:p1193:b001:l030","ordinal":51845,"en":"Had made into state land."},{"id":"manas-2010:p1193:b001:l031","ordinal":51846,"en":"My dear father's grassy slope—"},{"id":"manas-2010:p1193:b001:l032","ordinal":51847,"en":"That Kalmyk warrior is at its foot."},{"id":"manas-2010:p1193:b001:l033","ordinal":51848,"en":"Once every twelve days I came out;"},{"id":"manas-2010:p1193:b001:l034","ordinal":51849,"en":"Upon that gray sand there,"},{"id":"manas-2010:p1193:b001:l035","ordinal":51850,"en":"That is where I played."},{"id":"manas-2010:p1193:b001:l036","ordinal":51851,"en":"When I think, my insides turn to coals;"},{"id":"manas-2010:p1193:b001:l037","ordinal":51852,"en":"How can I banish my cares, Syrgak!"},{"id":"manas-2010:p1193:b001:l038","ordinal":51853,"en":"Dear land where my pleasures remain,"},{"id":"manas-2010:p1193:b001:l039","ordinal":51854,"en":"How can I fail to remember, Syrgak!"},{"id":"manas-2010:p1193:b001:l040","ordinal":51855,"en":"Stretching still before us,"},{"id":"manas-2010:p1193:b001:l041","ordinal":51856,"en":"The pale plain, smooth as glass,"},{"id":"manas-2010:p1193:b001:l042","ordinal":51857,"en":"Is Almambet's plain."},{"id":"manas-2010:p1194:b001:l001","ordinal":51858,"en":"Leave it, leopard Syrgak!"},{"id":"manas-2010:p1194:b001:l002","ordinal":51859,"en":"If I keep telling of the past,"},{"id":"manas-2010:p1194:b001:l003","ordinal":51860,"en":"A hero's thoughts are torn apart, Syrgak!"},{"id":"manas-2010:p1194:b001:l004","ordinal":51861,"en":"Let me tell of the pale plain."},{"id":"manas-2010:p1194:b001:l005","ordinal":51862,"en":"When Sarala was two years old,"},{"id":"manas-2010:p1194:b001:l006","ordinal":51863,"en":"There I rode him, playing wildly;"},{"id":"manas-2010:p1194:b001:l007","ordinal":51864,"en":"There I roamed from my youth."},{"id":"manas-2010:p1194:b001:l008","ordinal":51865,"en":"The white city, gleaming like glass,"},{"id":"manas-2010:p1194:b001:l009","ordinal":51866,"en":"Is my father's city of Tash-Köpürö."},{"id":"manas-2010:p1194:b001:l010","ordinal":51867,"en":"In the city of Tash-Köpürö,"},{"id":"manas-2010:p1194:b001:l011","ordinal":51868,"en":"There Almambet learned of campaigns;"},{"id":"manas-2010:p1194:b001:l012","ordinal":51869,"en":"In my dear father's place,"},{"id":"manas-2010:p1194:b001:l013","ordinal":51870,"en":"I was khan for six days,"},{"id":"manas-2010:p1194:b001:l014","ordinal":51871,"en":"There I mounted his golden throne."},{"id":"manas-2010:p1194:b001:l015","ordinal":51872,"en":"Let me tell of the golden throne."},{"id":"manas-2010:p1194:b001:l016","ordinal":51873,"en":"A gate of precious iron"},{"id":"manas-2010:p1194:b001:l017","ordinal":51874,"en":"Stood at the khan's entrance."},{"id":"manas-2010:p1194:b001:l018","ordinal":51875,"en":"Inside that entrance,"},{"id":"manas-2010:p1194:b001:l019","ordinal":51876,"en":"Plane trees grew all around;"},{"id":"manas-2010:p1194:b001:l020","ordinal":51877,"en":"Within stood the golden throne;"},{"id":"manas-2010:p1194:b001:l021","ordinal":51878,"en":"There was no path for a person to walk."},{"id":"manas-2010:p1194:b001:l022","ordinal":51879,"en":"This side and that side"},{"id":"manas-2010:p1194:b001:l023","ordinal":51880,"en":"Were covered with ruby stone."},{"id":"manas-2010:p1194:b001:l024","ordinal":51881,"en":"Within, every kind"},{"id":"manas-2010:p1194:b001:l025","ordinal":51882,"en":"Of design was set."},{"id":"manas-2010:p1194:b001:l026","ordinal":51883,"en":"Even soaked in water forty years,"},{"id":"manas-2010:p1194:b001:l027","ordinal":51884,"en":"Not the least edge would fade."},{"id":"manas-2010:p1194:b001:l028","ordinal":51885,"en":"Even exposed to earth and dust,"},{"id":"manas-2010:p1194:b001:l029","ordinal":51886,"en":"Its color would not fade a trace:"},{"id":"manas-2010:p1194:b001:l030","ordinal":51887,"en":"A great carpet with golden patterns,"},{"id":"manas-2010:p1194:b001:l031","ordinal":51888,"en":"Woven of pure silk."},{"id":"manas-2010:p1194:b001:l032","ordinal":51889,"en":"He had it spread beneath,"},{"id":"manas-2010:p1194:b001:l033","ordinal":51890,"en":"Set up the golden throne,"},{"id":"manas-2010:p1194:b001:l034","ordinal":51891,"en":"And had it laid upon it."},{"id":"manas-2010:p1194:b001:l035","ordinal":51892,"en":"The throng was filled with longing,"},{"id":"manas-2010:p1194:b001:l036","ordinal":51893,"en":"Eyes burning to see it."},{"id":"manas-2010:p1194:b001:l037","ordinal":51894,"en":"Whoever saw it once said, ‘Again,"},{"id":"manas-2010:p1194:b001:l038","ordinal":51895,"en":"If only I could come and see it!’"},{"id":"manas-2010:p1194:b001:l039","ordinal":51896,"en":"Rejoicing in the golden throne."},{"id":"manas-2010:p1194:b001:l040","ordinal":51897,"en":"Rubies and precious stones"},{"id":"manas-2010:p1194:b001:l041","ordinal":51898,"en":"He had set upon the threshold;"},{"id":"manas-2010:p1194:b001:l042","ordinal":51899,"en":"The tail feathers of a parrot,"},{"id":"manas-2010:p1195:b001:l001","ordinal":51900,"en":"Shimmering ninety different ways,"},{"id":"manas-2010:p1195:b001:l002","ordinal":51901,"en":"He had fixed at every corner,"},{"id":"manas-2010:p1195:b001:l003","ordinal":51902,"en":"Satisfying all who saw."},{"id":"manas-2010:p1195:b001:l004","ordinal":51903,"en":"The golden throne, surpassingly beautiful,"},{"id":"manas-2010:p1195:b001:l005","ordinal":51904,"en":"I renounced with all my worldly wealth"},{"id":"manas-2010:p1195:b001:l006","ordinal":51905,"en":"And left behind at that time."},{"id":"manas-2010:p1195:b001:l007","ordinal":51906,"en":"Because of Judgment Day,"},{"id":"manas-2010:p1195:b001:l008","ordinal":51907,"en":"Because of the terrible hell,"},{"id":"manas-2010:p1195:b001:l009","ordinal":51908,"en":"I suffered pain and hardship."},{"id":"manas-2010:p1195:b001:l010","ordinal":51909,"en":"Valuing my possessions less than a hair,"},{"id":"manas-2010:p1195:b001:l011","ordinal":51910,"en":"I fled without looking back."},{"id":"manas-2010:p1195:b001:l012","ordinal":51911,"en":"Yellow willows planted in rows—"},{"id":"manas-2010:p1195:b001:l013","ordinal":51912,"en":"That is the grove Almambet planted."},{"id":"manas-2010:p1195:b001:l014","ordinal":51913,"en":"The dark building standing black,"},{"id":"manas-2010:p1195:b001:l015","ordinal":51914,"en":"Where sixty monks would lead"},{"id":"manas-2010:p1195:b001:l016","ordinal":51915,"en":"Sarala, the horse beneath me,"},{"id":"manas-2010:p1195:b001:l017","ordinal":51916,"en":"Where they tethered Sarala,"},{"id":"manas-2010:p1195:b001:l018","ordinal":51917,"en":"That is the place of his manger."},{"id":"manas-2010:p1195:b001:l019","ordinal":51918,"en":"Withered and spreading bare,"},{"id":"manas-2010:p1195:b001:l020","ordinal":51919,"en":"The great plane tree in the middle—"},{"id":"manas-2010:p1195:b001:l021","ordinal":51920,"en":"My dear mother Altynay"},{"id":"manas-2010:p1195:b001:l022","ordinal":51921,"en":"Gave birth to me there."},{"id":"manas-2010:p1195:b001:l023","ordinal":51922,"en":"The plane tree of my birth,"},{"id":"manas-2010:p1195:b001:l024","ordinal":51923,"en":"Its roots entirely rotted,"},{"id":"manas-2010:p1195:b001:l025","ordinal":51924,"en":"Has withered completely;"},{"id":"manas-2010:p1195:b001:l026","ordinal":51925,"en":"Scattered over its crown,"},{"id":"manas-2010:p1195:b001:l027","ordinal":51926,"en":"Only the tips of buds remain."},{"id":"manas-2010:p1195:b001:l028","ordinal":51927,"en":"I shall not return safely to Talas;"},{"id":"manas-2010:p1195:b001:l029","ordinal":51928,"en":"I shall not leave Beijing unscathed."},{"id":"manas-2010:p1195:b001:l030","ordinal":51929,"en":"My unfortunate mother once said,"},{"id":"manas-2010:p1195:b001:l031","ordinal":51930,"en":"“If by chance you come to Beijing,"},{"id":"manas-2010:p1195:b001:l032","ordinal":51931,"en":"If any offspring of mine remain,"},{"id":"manas-2010:p1195:b001:l033","ordinal":51932,"en":"At the foot of my plane tree"},{"id":"manas-2010:p1195:b001:l034","ordinal":51933,"en":"A shoot will spring up,” Syrgak!"},{"id":"manas-2010:p1195:b001:l035","ordinal":51934,"en":"The shoot that sprang from its foot"},{"id":"manas-2010:p1195:b001:l036","ordinal":51935,"en":"Has nearly become a plane tree."},{"id":"manas-2010:p1195:b001:l037","ordinal":51936,"en":"I have thoughts that turn to turmoil;"},{"id":"manas-2010:p1195:b001:l038","ordinal":51937,"en":"I have a child to leave behind."},{"id":"manas-2010:p1195:b001:l039","ordinal":51938,"en":"Do you see my many possessions lying there?"},{"id":"manas-2010:p1195:b001:l040","ordinal":51939,"en":"My gray palace has fallen, Syrgak!"},{"id":"manas-2010:p1195:b001:l041","ordinal":51940,"en":"The gold I had amassed in abundance,"},{"id":"manas-2010:p1195:b001:l042","ordinal":51941,"en":"When I left Beijing,"},{"id":"manas-2010:p1196:b001:l001","ordinal":51942,"en":"The Chinese plundered it."},{"id":"manas-2010:p1196:b001:l002","ordinal":51943,"en":"My walnut tree has been halved;"},{"id":"manas-2010:p1196:b001:l003","ordinal":51944,"en":"My plane tree has lost its water."},{"id":"manas-2010:p1196:b001:l004","ordinal":51945,"en":"Sarala's manger,"},{"id":"manas-2010:p1196:b001:l005","ordinal":51946,"en":"The swarming multitude of Chinese"},{"id":"manas-2010:p1196:b001:l006","ordinal":51947,"en":"Divided by measuring with whips."},{"id":"manas-2010:p1196:b001:l007","ordinal":51948,"en":"My poor soul has died!"},{"id":"manas-2010:p1196:b001:l008","ordinal":51949,"en":"That pale stretch you see,"},{"id":"manas-2010:p1196:b001:l009","ordinal":51950,"en":"That is where I sowed my grain."},{"id":"manas-2010:p1196:b001:l010","ordinal":51951,"en":"There was no water flowing there before;"},{"id":"manas-2010:p1196:b001:l011","ordinal":51952,"en":"I made it spread over everything,"},{"id":"manas-2010:p1196:b001:l012","ordinal":51953,"en":"From the waters of Kürpüldök,"},{"id":"manas-2010:p1196:b001:l013","ordinal":51954,"en":"I dug an irrigation channel, Syrgak!"},{"id":"manas-2010:p1196:b001:l014","ordinal":51955,"en":"The peoples of six khans held a feast."},{"id":"manas-2010:p1196:b001:l015","ordinal":51956,"en":"When I was digging the channel,"},{"id":"manas-2010:p1196:b001:l016","ordinal":51957,"en":"They served me then"},{"id":"manas-2010:p1196:b001:l017","ordinal":51958,"en":"And named it Keng-Alysh."},{"id":"manas-2010:p1196:b001:l018","ordinal":51959,"en":"That channel I had dug,"},{"id":"manas-2010:p1196:b001:l019","ordinal":51960,"en":"I had its bed hollowed forty cubits deep,"},{"id":"manas-2010:p1196:b001:l020","ordinal":51961,"en":"Its upper banks leveled broadly,"},{"id":"manas-2010:p1196:b001:l021","ordinal":51962,"en":"And I fed the Chinese till they were full."},{"id":"manas-2010:p1196:b001:l022","ordinal":51963,"en":"When I lived in Beijing,"},{"id":"manas-2010:p1196:b001:l023","ordinal":51964,"en":"Almambet was a cherished soul."},{"id":"manas-2010:p1196:b001:l024","ordinal":51965,"en":"My eyes shone like Venus;"},{"id":"manas-2010:p1196:b001:l025","ordinal":51966,"en":"Sixty mothers cared for me;"},{"id":"manas-2010:p1196:b001:l026","ordinal":51967,"en":"Almambet was a pampered child, Syrgak!"},{"id":"manas-2010:p1196:b001:l027","ordinal":51968,"en":"In my days of play,"}]
