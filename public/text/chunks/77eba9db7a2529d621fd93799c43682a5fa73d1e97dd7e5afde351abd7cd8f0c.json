[{"id":"semetey-1-2013:p1259:b005:l027","ordinal":172289,"en":"At this time Semetey"},{"id":"semetey-1-2013:p1259:b005:l028","ordinal":172290,"en":"Was roused at the word “war,”"},{"id":"semetey-1-2013:p1259:b005:l029","ordinal":172291,"en":"And surged at the word “slaughter.”"},{"id":"semetey-1-2013:p1259:b005:l030","ordinal":172292,"en":"He raged at the word “spear fight”;"},{"id":"semetey-1-2013:p1259:b005:l031","ordinal":172293,"en":"When your gray wolf charged,"},{"id":"semetey-1-2013:p1259:b005:l032","ordinal":172294,"en":"He strained greedily like a wolf."},{"id":"semetey-1-2013:p1259:b005:l033","ordinal":172295,"en":"When had Khoja ever raged"},{"id":"semetey-1-2013:p1259:b005:l034","ordinal":172296,"en":"And attacked the blessed hero?”"},{"id":"semetey-1-2013:p1259:b005:l035","ordinal":172297,"en":"From Aychürök's palace,"},{"id":"semetey-1-2013:p1259:b005:l036","ordinal":172298,"en":"The doolbas was beaten firmly;"},{"id":"semetey-1-2013:p1259:b005:l037","ordinal":172299,"en":"Thirty brides and thirty maidens,"},{"id":"semetey-1-2013:p1259:b005:l038","ordinal":172300,"en":"With Aychürök at their head,"},{"id":"semetey-1-2013:p1259:b005:l039","ordinal":172301,"en":"The girls lost their senses."},{"id":"semetey-1-2013:p1260:b003:l001","ordinal":172302,"en":"Baitailak, son of Bakai Khan,"},{"id":"semetey-1-2013:p1260:b003:l002","ordinal":172303,"en":"Kalyk, son of Sary Khan,"},{"id":"semetey-1-2013:p1260:b003:l003","ordinal":172304,"en":"Shaiymbet, son of Zhamgyrchy,"},{"id":"semetey-1-2013:p1260:b003:l004","ordinal":172305,"en":"Kanchoro, son of Chubak,"},{"id":"semetey-1-2013:p1260:b003:l005","ordinal":172306,"en":"Külchoro, son of Almambet—"},{"id":"semetey-1-2013:p1260:b003:l006","ordinal":172307,"en":"All sons of khans,"},{"id":"semetey-1-2013:p1260:b003:l007","ordinal":172308,"en":"Gathered around Semetey."},{"id":"semetey-1-2013:p1260:b003:l008","ordinal":172309,"en":"His knees bending to the ground,"},{"id":"semetey-1-2013:p1260:b003:l009","ordinal":172310,"en":"To his uncle’s side"},{"id":"semetey-1-2013:p1260:b003:l010","ordinal":172311,"en":"Külchoro came running."},{"id":"semetey-1-2013:p1260:b003:l011","ordinal":172312,"en":"Looking to either side,"},{"id":"semetey-1-2013:p1260:b003:l012","ordinal":172313,"en":"Licking his lips like a hungry wolf,"},{"id":"semetey-1-2013:p1260:b003:l013","ordinal":172314,"en":"The spear bending in his hand,"},{"id":"semetey-1-2013:p1260:b003:l014","ordinal":172315,"en":"Arkeskene at his neck"},{"id":"semetey-1-2013:p1260:b003:l015","ordinal":172316,"en":"Hung a full fathom long."},{"id":"semetey-1-2013:p1260:b003:l016","ordinal":172317,"en":"All distinguished heroes,"},{"id":"semetey-1-2013:p1260:b003:l017","ordinal":172318,"en":"Gathered tight like deer,"},{"id":"semetey-1-2013:p1260:b003:l018","ordinal":172319,"en":"All tiger-like heroes,"},{"id":"semetey-1-2013:p1260:b003:l019","ordinal":172320,"en":"His attendant comrades beside him,"},{"id":"semetey-1-2013:p1260:b003:l020","ordinal":172321,"en":"They all came together"},{"id":"semetey-1-2013:p1260:b003:l021","ordinal":172322,"en":"To see Semetey."},{"id":"semetey-1-2013:p1260:b003:l022","ordinal":172323,"en":"The great Buurul—"},{"id":"semetey-1-2013:p1260:b003:l023","ordinal":172324,"en":"The radiant Aichürök,"},{"id":"semetey-1-2013:p1260:b003:l024","ordinal":172325,"en":"Her argali eyes shining,"},{"id":"semetey-1-2013:p1260:b003:l025","ordinal":172326,"en":"Had six brides and six maidens,"},{"id":"semetey-1-2013:p1260:b003:l026","ordinal":172327,"en":"Twelve in all, hold him."},{"id":"semetey-1-2013:p1260:b003:l027","ordinal":172328,"en":"Leather saddlecloth and white pad,"},{"id":"semetey-1-2013:p1260:b003:l028","ordinal":172329,"en":"A saddle fitted to Buurul."},{"id":"semetey-1-2013:p1260:b003:l029","ordinal":172330,"en":"Akkangky, made by Almambet,"},{"id":"semetey-1-2013:p1260:b003:l030","ordinal":172331,"en":"Its front bow of white gold,"},{"id":"semetey-1-2013:p1260:b003:l031","ordinal":172332,"en":"Its rear bow of pure silver,"},{"id":"semetey-1-2013:p1260:b003:l032","ordinal":172333,"en":"Both sides broad iron—"},{"id":"semetey-1-2013:p1260:b003:l033","ordinal":172334,"en":"Aichürök saddled him carefully,"},{"id":"semetey-1-2013:p1260:b003:l034","ordinal":172335,"en":"Making him strain as though his master had died."},{"id":"semetey-1-2013:p1260:b003:l035","ordinal":172336,"en":"The dear surviving Buurul"},{"id":"semetey-1-2013:p1260:b003:l036","ordinal":172337,"en":"She now stood holding."},{"id":"semetey-1-2013:p1260:b003:l037","ordinal":172338,"en":"When the khans’ sons ran"},{"id":"semetey-1-2013:p1260:b003:l038","ordinal":172339,"en":"And came before him,"},{"id":"semetey-1-2013:p1260:b003:l039","ordinal":172340,"en":"The young orphan Semetey"},{"id":"semetey-1-2013:p1260:b004:l001","ordinal":172341,"en":"Now spoke these words;"},{"id":"semetey-1-2013:p1260:b004:l002","ordinal":172342,"en":"To the companions beside him"},{"id":"semetey-1-2013:p1260:b004:l003","ordinal":172343,"en":"He said the following:"},{"id":"semetey-1-2013:p1260:b004:l004","ordinal":172344,"en":"“With Khojo, who attacked us himself,"},{"id":"semetey-1-2013:p1260:b004:l005","ordinal":172345,"en":"Let us measure ourselves."},{"id":"semetey-1-2013:p1260:b004:l006","ordinal":172346,"en":"With Khojo, craving battle,"},{"id":"semetey-1-2013:p1260:b004:l007","ordinal":172347,"en":"With that raging swine!"},{"id":"semetey-1-2013:p1260:b004:l008","ordinal":172348,"en":"Did we steal away his piebald mare?"},{"id":"semetey-1-2013:p1260:b004:l009","ordinal":172349,"en":"We were kin from the root;"},{"id":"semetey-1-2013:p1260:b004:l010","ordinal":172350,"en":"Did we scatter his white silver and sable?"},{"id":"semetey-1-2013:p1260:b004:l011","ordinal":172351,"en":"Did we chase off his dun mare?"},{"id":"semetey-1-2013:p1260:b004:l012","ordinal":172352,"en":"That Khojo has gone mad—"},{"id":"semetey-1-2013:p1260:b004:l013","ordinal":172353,"en":"Did we scatter sable from his saddlebags?"},{"id":"semetey-1-2013:p1260:b004:l014","ordinal":172354,"en":"Did we camp upon his village?"},{"id":"semetey-1-2013:p1260:b004:l015","ordinal":172355,"en":"Did we commit some offense?!"},{"id":"semetey-1-2013:p1260:b004:l016","ordinal":172356,"en":"Did we seize and slaughter his barren mare?"},{"id":"semetey-1-2013:p1260:b004:l017","ordinal":172357,"en":"Did we reconnoiter his strong city?"},{"id":"semetey-1-2013:p1260:b004:l018","ordinal":172358,"en":"Have we become guilty?"},{"id":"semetey-1-2013:p1260:b004:l019","ordinal":172359,"en":"That Khojo, rising in force—"},{"id":"semetey-1-2013:p1260:b004:l020","ordinal":172360,"en":"Did we reap his rice like hay?"},{"id":"semetey-1-2013:p1260:b004:l021","ordinal":172361,"en":"Against thundering Toltoi,"},{"id":"semetey-1-2013:p1260:b004:l022","ordinal":172362,"en":"Have we made ourselves guilty?"},{"id":"semetey-1-2013:p1260:b004:l023","ordinal":172363,"en":"That he musters his army in fury,"},{"id":"semetey-1-2013:p1260:b004:l024","ordinal":172364,"en":"That his spears quiver in readiness—"},{"id":"semetey-1-2013:p1260:b004:l025","ordinal":172365,"en":"Were we rivals for that swine’s wife?"},{"id":"semetey-1-2013:p1260:b004:l026","ordinal":172366,"en":"Did we earlier attack"},{"id":"semetey-1-2013:p1260:b004:l027","ordinal":172367,"en":"And raid his village?!"},{"id":"semetey-1-2013:p1260:b004:l028","ordinal":172368,"en":"He has longed for slaughter—"},{"id":"semetey-1-2013:p1260:b004:l029","ordinal":172369,"en":"Have we fallen into his torment?!"},{"id":"semetey-1-2013:p1260:b004:l030","ordinal":172370,"en":"Chynkojo, son of Shygai,"},{"id":"semetey-1-2013:p1260:b004:l031","ordinal":172371,"en":"Was a servant of our common root;"},{"id":"semetey-1-2013:p1260:b004:l032","ordinal":172372,"en":"Let us fight to the finish,"},{"id":"semetey-1-2013:p1260:b004:l033","ordinal":172373,"en":"For we were sons of one father."},{"id":"semetey-1-2013:p1260:b004:l034","ordinal":172374,"en":"Mustering his host with a roar,"},{"id":"semetey-1-2013:p1260:b004:l035","ordinal":172375,"en":"As though we had plundered his gold,"},{"id":"semetey-1-2013:p1260:b004:l036","ordinal":172376,"en":"As though we had raided his village—"},{"id":"semetey-1-2013:p1260:b004:l037","ordinal":172377,"en":"While my strong head remains,"},{"id":"semetey-1-2013:p1260:b004:l038","ordinal":172378,"en":"How can I give up my wife?"},{"id":"semetey-1-2013:p1260:b004:l039","ordinal":172379,"en":"The swine have risen in force;"},{"id":"semetey-1-2013:p1261:b003:l001","ordinal":172380,"en":"Let me grapple and test them!"},{"id":"semetey-1-2013:p1261:b003:l002","ordinal":172381,"en":"While my ocean-like head remains,"},{"id":"semetey-1-2013:p1261:b003:l003","ordinal":172382,"en":"How can I give up my equal companion?"},{"id":"semetey-1-2013:p1261:b003:l004","ordinal":172383,"en":"The swine are surging;"},{"id":"semetey-1-2013:p1261:b003:l005","ordinal":172384,"en":"Let me fight them alone and test myself!”"},{"id":"semetey-1-2013:p1261:b003:l006","ordinal":172385,"en":"Your prince grieved in this way,"},{"id":"semetey-1-2013:p1261:b003:l007","ordinal":172386,"en":"Put on the bulletproof armor,"},{"id":"semetey-1-2013:p1261:b003:l008","ordinal":172387,"en":"Readied himself toward the foe,"},{"id":"semetey-1-2013:p1261:b003:l009","ordinal":172388,"en":"And prepared his weapons."},{"id":"semetey-1-2013:p1261:b003:l010","ordinal":172389,"en":"The blood-drinking gray wolf’s"},{"id":"semetey-1-2013:p1261:b003:l011","ordinal":172390,"en":"Wrath spread across his face."},{"id":"semetey-1-2013:p1261:b003:l012","ordinal":172391,"en":"The gray kise he had inherited"},{"id":"semetey-1-2013:p1261:b003:l013","ordinal":172392,"en":"From his khan father, the bloodletter,"},{"id":"semetey-1-2013:p1261:b003:l014","ordinal":172393,"en":"The bloodthirsty champion buckled on—"},{"id":"semetey-1-2013:p1261:b003:l015","ordinal":172394,"en":"He who unleashed havoc,"},{"id":"semetey-1-2013:p1261:b003:l016","ordinal":172395,"en":"Who carried off women."},{"id":"semetey-1-2013:p1261:b003:l017","ordinal":172396,"en":"At doom-struck Khojo"},{"id":"semetey-1-2013:p1261:b003:l018","ordinal":172397,"en":"He glowered in wrath."},{"id":"semetey-1-2013:p1261:b003:l019","ordinal":172398,"en":"Making ready with the gray kise,"},{"id":"semetey-1-2013:p1261:b003:l020","ordinal":172399,"en":"Pleading with the Creator,"},{"id":"semetey-1-2013:p1261:b003:l021","ordinal":172400,"en":"When the wondrous thing was slung on,"},{"id":"semetey-1-2013:p1261:b003:l022","ordinal":172401,"en":"It was a mirror upon the shoulder;"},{"id":"semetey-1-2013:p1261:b003:l023","ordinal":172402,"en":"When borne into clashing battle,"},{"id":"semetey-1-2013:p1261:b003:l024","ordinal":172403,"en":"It was comfort for the entrusted life."},{"id":"semetey-1-2013:p1261:b003:l025","ordinal":172404,"en":"Its report had been measured and judged;"},{"id":"semetey-1-2013:p1261:b003:l026","ordinal":172405,"en":"Nothing measured could match its form."},{"id":"semetey-1-2013:p1261:b003:l027","ordinal":172406,"en":"In sport it was Ochogor,"},{"id":"semetey-1-2013:p1261:b003:l028","ordinal":172407,"en":"In earnest it was Koichagyr—"},{"id":"semetey-1-2013:p1261:b003:l029","ordinal":172408,"en":"This was the sharp weapon inherited"},{"id":"semetey-1-2013:p1261:b003:l030","ordinal":172409,"en":"From noble Lord Manas."},{"id":"semetey-1-2013:p1261:b003:l031","ordinal":172410,"en":"Its keenness was proven among the people,"},{"id":"semetey-1-2013:p1261:b003:l032","ordinal":172411,"en":"An inheritance remaining"},{"id":"semetey-1-2013:p1261:b003:l033","ordinal":172412,"en":"From the poor prince and sultan."},{"id":"semetey-1-2013:p1261:b003:l034","ordinal":172413,"en":"Golden collar and copper sleeves,"},{"id":"semetey-1-2013:p1261:b003:l035","ordinal":172414,"en":"Double ring mail with lark-like eyes,"},{"id":"semetey-1-2013:p1261:b003:l036","ordinal":172415,"en":"Netted outer coat and blue jacket—"},{"id":"semetey-1-2013:p1261:b003:l037","ordinal":172416,"en":"No bullet pierced it in battle."},{"id":"semetey-1-2013:p1261:b003:l038","ordinal":172417,"en":"Gray-wolf Sultan Semetey"},{"id":"semetey-1-2013:p1261:b003:l039","ordinal":172418,"en":"Now put it on over the rest."},{"id":"semetey-1-2013:p1261:b004:l001","ordinal":172419,"en":"The sight stirred the heart;"},{"id":"semetey-1-2013:p1261:b004:l002","ordinal":172420,"en":"When he put on his weapons,"},{"id":"semetey-1-2013:p1261:b004:l003","ordinal":172421,"en":"Semetey, wolf of battle,"},{"id":"semetey-1-2013:p1261:b004:l004","ordinal":172422,"en":"Loomed as large as a house."},{"id":"semetey-1-2013:p1261:b004:l005","ordinal":172423,"en":"He raised the gold-crescent banner,"},{"id":"semetey-1-2013:p1261:b004:l006","ordinal":172424,"en":"Raised the cry “Ai, Manas!”"},{"id":"semetey-1-2013:p1261:b004:l007","ordinal":172425,"en":"And your prince surged from the palace,"},{"id":"semetey-1-2013:p1261:b004:l008","ordinal":172426,"en":"Wearing the bulletproof armor,"},{"id":"semetey-1-2013:p1261:b004:l009","ordinal":172427,"en":"Gathering himself like a lion."},{"id":"semetey-1-2013:p1261:b004:l010","ordinal":172428,"en":"Like a cloud about to rain again,"},{"id":"semetey-1-2013:p1261:b004:l011","ordinal":172429,"en":"Wrath covered his face;"},{"id":"semetey-1-2013:p1261:b004:l012","ordinal":172430,"en":"His breadth was an armful,"},{"id":"semetey-1-2013:p1261:b004:l013","ordinal":172431,"en":"His arms and armor fastened on."},{"id":"semetey-1-2013:p1261:b004:l014","ordinal":172432,"en":"The sight stirred every heart;"},{"id":"semetey-1-2013:p1261:b004:l015","ordinal":172433,"en":"Venom poured from his mouth."},{"id":"semetey-1-2013:p1261:b004:l016","ordinal":172434,"en":"He readied himself like a hawk,"},{"id":"semetey-1-2013:p1261:b004:l017","ordinal":172435,"en":"And received wisdom from the unseen."},{"id":"semetey-1-2013:p1261:b004:l018","ordinal":172436,"en":"Looking to either side,"},{"id":"semetey-1-2013:p1261:b004:l019","ordinal":172437,"en":"As he prepared to enter battle,"},{"id":"semetey-1-2013:p1261:b004:l020","ordinal":172438,"en":"He licked his lips and nose."},{"id":"semetey-1-2013:p1261:b004:l021","ordinal":172439,"en":"The sight stirred the heart:"},{"id":"semetey-1-2013:p1261:b004:l022","ordinal":172440,"en":"Külchoro, son of the gray wolf,"},{"id":"semetey-1-2013:p1261:b004:l023","ordinal":172441,"en":"Appeared with Aktelki."},{"id":"semetey-1-2013:p1261:b004:l024","ordinal":172442,"en":"Külchoro came out in high spirits,"},{"id":"semetey-1-2013:p1261:b004:l025","ordinal":172443,"en":"Met Semetey,"},{"id":"semetey-1-2013:p1261:b004:l026","ordinal":172444,"en":"And stood as his support."},{"id":"semetey-1-2013:p1261:b004:l027","ordinal":172445,"en":"Beyond him came"},{"id":"semetey-1-2013:p1261:b004:l028","ordinal":172446,"en":"Kanchoro, born to surpass"},{"id":"semetey-1-2013:p1261:b004:l029","ordinal":172447,"en":"His father, lion Chubak,"},{"id":"semetey-1-2013:p1261:b004:l030","ordinal":172448,"en":"Wearing over himself a fur coat"},{"id":"semetey-1-2013:p1261:b004:l031","ordinal":172449,"en":"Of blue otter skin;"},{"id":"semetey-1-2013:p1261:b004:l032","ordinal":172450,"en":"If an army of six thousand came,"},{"id":"semetey-1-2013:p1261:b004:l033","ordinal":172451,"en":"He attacked without sparing himself."},{"id":"semetey-1-2013:p1261:b004:l034","ordinal":172452,"en":"He never turned back from gunfire,"},{"id":"semetey-1-2013:p1261:b004:l035","ordinal":172453,"en":"Never fled in fear of death."},{"id":"semetey-1-2013:p1261:b004:l036","ordinal":172454,"en":"Köktelki of Khan Köbösh,"},{"id":"semetey-1-2013:p1261:b004:l037","ordinal":172455,"en":"His stallion for holy war,"},{"id":"semetey-1-2013:p1261:b004:l038","ordinal":172456,"en":"Came as his support."},{"id":"semetey-1-2013:p1261:b004:l039","ordinal":172457,"en":"Young prince Kanchoro,"},{"id":"semetey-1-2013:p1262:b003:l001","ordinal":172458,"en":"Semetey’s kinsman;"},{"id":"semetey-1-2013:p1262:b003:l002","ordinal":172459,"en":"Baitailak, son of Bakai Khan,"},{"id":"semetey-1-2013:p1262:b003:l003","ordinal":172460,"en":"Also came as support;"},{"id":"semetey-1-2013:p1262:b003:l004","ordinal":172461,"en":"Kalyk, son of Sary Khan,"},{"id":"semetey-1-2013:p1262:b003:l005","ordinal":172462,"en":"Skilled against the foe he fought,"},{"id":"semetey-1-2013:p1262:b003:l006","ordinal":172463,"en":"His bright aid of use,"},{"id":"semetey-1-2013:p1262:b003:l007","ordinal":172464,"en":"Ready for slaughter,"},{"id":"semetey-1-2013:p1262:b003:l008","ordinal":172465,"en":"Became a companion then."},{"id":"semetey-1-2013:p1262:b003:l009","ordinal":172466,"en":"All sons of khans,"},{"id":"semetey-1-2013:p1262:b003:l010","ordinal":172467,"en":"They raised the pale-gray banner,"},{"id":"semetey-1-2013:p1262:b003:l011","ordinal":172468,"en":"Raised the cry “Khan Manas!”"},{"id":"semetey-1-2013:p1262:b003:l012","ordinal":172469,"en":"Braced themselves like lions,"},{"id":"semetey-1-2013:p1262:b003:l013","ordinal":172470,"en":"And all mounted like lions."},{"id":"semetey-1-2013:p1262:b003:l014","ordinal":172471,"en":"Receiving a letter from the caliph,"},{"id":"semetey-1-2013:p1262:b003:l015","ordinal":172472,"en":"Receiving the elders’ blessing,"},{"id":"semetey-1-2013:p1262:b003:l016","ordinal":172473,"en":"The leopard’s sons, who wrought slaughter"},{"id":"semetey-1-2013:p1262:b003:l017","ordinal":172474,"en":"When challenged,"},{"id":"semetey-1-2013:p1262:b003:l018","ordinal":172475,"en":"Now rode into"},{"id":"semetey-1-2013:p1262:b003:l019","ordinal":172476,"en":"The Jediger host."},{"id":"semetey-1-2013:p1262:b003:l020","ordinal":172477,"en":"From the Jediger city,"},{"id":"semetey-1-2013:p1262:b003:l021","ordinal":172478,"en":"Moving swiftly and gathering themselves,"},{"id":"semetey-1-2013:p1262:b003:l022","ordinal":172479,"en":"Turning like lions,"},{"id":"semetey-1-2013:p1262:b003:l023","ordinal":172480,"en":"Onto the spur of the broken mountain,"},{"id":"semetey-1-2013:p1262:b003:l024","ordinal":172481,"en":"Onto the looming promontory,"},{"id":"semetey-1-2013:p1262:b003:l025","ordinal":172482,"en":"Semetey suddenly climbed."},{"id":"semetey-1-2013:p1262:b003:l026","ordinal":172483,"en":"When the young man truly looked,"},{"id":"semetey-1-2013:p1262:b003:l027","ordinal":172484,"en":"Spears swayed like reeds,"},{"id":"semetey-1-2013:p1262:b003:l028","ordinal":172485,"en":"Weapons glittered like stars;"},{"id":"semetey-1-2013:p1262:b003:l029","ordinal":172486,"en":"Dawn broke in clouds,"},{"id":"semetey-1-2013:p1262:b003:l030","ordinal":172487,"en":"And, crying “Khojo!” as their battle call,"},{"id":"semetey-1-2013:p1262:b003:l031","ordinal":172488,"en":"The Jediger came shouting."},{"id":"semetey-1-2013:p1262:b003:l032","ordinal":172489,"en":"They raised the mottled gray banner;"},{"id":"semetey-1-2013:p1262:b003:l033","ordinal":172490,"en":"The Jediger covered the land,"},{"id":"semetey-1-2013:p1262:b003:l034","ordinal":172491,"en":"Raising the cry “Khan Toltoi!”"},{"id":"semetey-1-2013:p1262:b003:l035","ordinal":172492,"en":"Divided into many kinds,"},{"id":"semetey-1-2013:p1262:b003:l036","ordinal":172493,"en":"Each formation looked different;"},{"id":"semetey-1-2013:p1262:b003:l037","ordinal":172494,"en":"Their dust swept up like a mountain,"},{"id":"semetey-1-2013:p1262:b003:l038","ordinal":172495,"en":"And without stopping they raised their cries."},{"id":"semetey-1-2013:p1262:b003:l039","ordinal":172496,"en":"Toltoi’s host was immense,"},{"id":"semetey-1-2013:p1262:b004:l001","ordinal":172497,"en":"And had covered the land with them."},{"id":"semetey-1-2013:p1262:b004:l002","ordinal":172498,"en":"Riding Sur with silver bracelets,"},{"id":"semetey-1-2013:p1262:b004:l003","ordinal":172499,"en":"All riding stout, full-grown horses,"},{"id":"semetey-1-2013:p1262:b004:l004","ordinal":172500,"en":"Tölök, master of judgment,"},{"id":"semetey-1-2013:p1262:b004:l005","ordinal":172501,"en":"With Jediger countless as ants,"},{"id":"semetey-1-2013:p1262:b004:l006","ordinal":172502,"en":"Trampled wherever they passed"},{"id":"semetey-1-2013:p1262:b004:l007","ordinal":172503,"en":"And covered the Afghan city."},{"id":"semetey-1-2013:p1262:b004:l008","ordinal":172504,"en":"Shouting from below,"},{"id":"semetey-1-2013:p1262:b004:l009","ordinal":172505,"en":"Raising the cry “Tölök!”"},{"id":"semetey-1-2013:p1262:b004:l010","ordinal":172506,"en":"He too covered the land."},{"id":"semetey-1-2013:p1262:b004:l011","ordinal":172507,"en":"Kalcha and Kadyrbai,"},{"id":"semetey-1-2013:p1262:b004:l012","ordinal":172508,"en":"Tölök and Tölöbai,"},{"id":"semetey-1-2013:p1262:b004:l013","ordinal":172509,"en":"At the edge of the lower host,"},{"id":"semetey-1-2013:p1262:b004:l014","ordinal":172510,"en":"With their princes at the front,"},{"id":"semetey-1-2013:p1262:b004:l015","ordinal":172511,"en":"Had invoked Babedin"},{"id":"semetey-1-2013:p1262:b004:l016","ordinal":172512,"en":"And loosed the raiding host."},{"id":"semetey-1-2013:p1262:b004:l017","ordinal":172513,"en":"Those on yellow horses streamed out,"},{"id":"semetey-1-2013:p1262:b004:l018","ordinal":172514,"en":"Separated as another division,"},{"id":"semetey-1-2013:p1262:b004:l019","ordinal":172515,"en":"Appearing wholly yellow."},{"id":"semetey-1-2013:p1262:b004:l020","ordinal":172516,"en":"The gray-horse riders divided off,"},{"id":"semetey-1-2013:p1262:b004:l021","ordinal":172517,"en":"Appearing as men of substance."},{"id":"semetey-1-2013:p1262:b004:l022","ordinal":172518,"en":"Their dust rose to the sky;"},{"id":"semetey-1-2013:p1262:b004:l023","ordinal":172519,"en":"The people divided into seven,"},{"id":"semetey-1-2013:p1262:b004:l024","ordinal":172520,"en":"Appearing like monsters."},{"id":"semetey-1-2013:p1262:b004:l025","ordinal":172521,"en":"The vast, wrathful host roared,"},{"id":"semetey-1-2013:p1262:b004:l026","ordinal":172522,"en":"Raising the battle cry “Khojo!”"},{"id":"semetey-1-2013:p1262:b004:l027","ordinal":172523,"en":"Saying, “Submit now to what we demand;"},{"id":"semetey-1-2013:p1262:b004:l028","ordinal":172524,"en":"Give us the old maid,”"},{"id":"semetey-1-2013:p1262:b004:l029","ordinal":172525,"en":"They flowed along the bank,"},{"id":"semetey-1-2013:p1262:b004:l030","ordinal":172526,"en":"Making the earth split and heave;"},{"id":"semetey-1-2013:p1262:b004:l031","ordinal":172527,"en":"All the Jediger"},{"id":"semetey-1-2013:p1262:b004:l032","ordinal":172528,"en":"Had covered the land with skill."},{"id":"semetey-1-2013:p1262:b004:l033","ordinal":172529,"en":"Drawing bows like rain,"},{"id":"semetey-1-2013:p1262:b004:l034","ordinal":172530,"en":"Firing bullets like hail,"},{"id":"semetey-1-2013:p1262:b004:l035","ordinal":172531,"en":"The spearmen shouted;"},{"id":"semetey-1-2013:p1262:b004:l036","ordinal":172532,"en":"The surging, massive host"},{"id":"semetey-1-2013:p1262:b004:l037","ordinal":172533,"en":"Raised the battle cry “Toltoi!”"},{"id":"semetey-1-2013:p1262:b004:l038","ordinal":172534,"en":"The musketeers stood along one flank,"},{"id":"semetey-1-2013:p1262:b004:l039","ordinal":172535,"en":"Their finest men in front,"},{"id":"semetey-1-2013:p1263:b003:l001","ordinal":172536,"en":"The archers drew together;"},{"id":"semetey-1-2013:p1263:b003:l002","ordinal":172537,"en":"Iron-headed wrestlers"},{"id":"semetey-1-2013:p1263:b003:l003","ordinal":172538,"en":"Prepared at the front."},{"id":"semetey-1-2013:p1263:b003:l004","ordinal":172539,"en":"Their warriors of countless kinds"},{"id":"semetey-1-2013:p1263:b003:l005","ordinal":172540,"en":"Were the shield"},{"id":"semetey-1-2013:p1263:b003:l006","ordinal":172541,"en":"Of whoever they faced."},{"id":"semetey-1-2013:p1263:b003:l007","ordinal":172542,"en":"From the screaming brass horn,"},{"id":"semetey-1-2013:p1263:b003:l008","ordinal":172543,"en":"From the trumpet, ears went deaf."},{"id":"semetey-1-2013:p1263:b003:l009","ordinal":172544,"en":"Across a wide ravine where no bird flew,"}]
