[{"id":"semetey-1-2013:p0820:b004:l019","ordinal":139009,"en":"Having received the khan's command,"},{"id":"semetey-1-2013:p0820:b004:l020","ordinal":139010,"en":"Upon eighty red-tailed single-humped camels,"},{"id":"semetey-1-2013:p0820:b004:l021","ordinal":139011,"en":"Gold and rubies"},{"id":"semetey-1-2013:p0820:b004:l022","ordinal":139012,"en":"They loaded without stint."},{"id":"semetey-1-2013:p0820:b004:l023","ordinal":139013,"en":"As Semetey's inheritance,"},{"id":"semetey-1-2013:p0820:b004:l024","ordinal":139014,"en":"Saying, ‘Take these when you go,’"},{"id":"semetey-1-2013:p0820:b004:l025","ordinal":139015,"en":"They brought them to him,"},{"id":"semetey-1-2013:p0820:b004:l026","ordinal":139016,"en":"And to the orphan son of Manas"},{"id":"semetey-1-2013:p0820:b004:l027","ordinal":139017,"en":"Presented them as gifts."},{"id":"semetey-1-2013:p0820:b004:l028","ordinal":139018,"en":"They agreed to what he said."},{"id":"semetey-1-2013:p0820:b004:l029","ordinal":139019,"en":"To load the eighty camels,"},{"id":"semetey-1-2013:p0820:b004:l030","ordinal":139020,"en":"And lead them toward Talas,"},{"id":"semetey-1-2013:p0820:b004:l031","ordinal":139021,"en":"They provided eighty strongmen."},{"id":"semetey-1-2013:p0820:b004:l032","ordinal":139022,"en":"Eighty warriors became"},{"id":"semetey-1-2013:p0820:b004:l033","ordinal":139023,"en":"Semetey's companions."},{"id":"semetey-1-2013:p0820:b004:l034","ordinal":139024,"en":"When the camels were led out,"},{"id":"semetey-1-2013:p0820:b004:l035","ordinal":139025,"en":"The sight diverted one's heart;"},{"id":"semetey-1-2013:p0820:b004:l036","ordinal":139026,"en":"The red single-humped camels looked splendid."},{"id":"semetey-1-2013:p0820:b005:l001","ordinal":139027,"en":"Upon the red single-humped camels,"},{"id":"semetey-1-2013:p0820:b005:l002","ordinal":139028,"en":"Patterned carpets were folded."},{"id":"semetey-1-2013:p0820:b005:l003","ordinal":139029,"en":"Pearls, treasures and rubies"},{"id":"semetey-1-2013:p0820:b005:l004","ordinal":139030,"en":"Were loaded on the red camels."},{"id":"semetey-1-2013:p0820:b005:l005","ordinal":139031,"en":"The camels filed along in a row."},{"id":"semetey-1-2013:p0820:b005:l006","ordinal":139032,"en":"Seeing this wealth,"},{"id":"semetey-1-2013:p0820:b005:l007","ordinal":139033,"en":"The remarkable orphan rejoiced."},{"id":"semetey-1-2013:p0820:b005:l008","ordinal":139034,"en":"The red camels carrying the wealth"},{"id":"semetey-1-2013:p0820:b005:l009","ordinal":139035,"en":"Came from Temir Khan's treasury herds;"},{"id":"semetey-1-2013:p0820:b005:l010","ordinal":139036,"en":"Their appearance was most splendid."},{"id":"semetey-1-2013:p0820:b005:l011","ordinal":139037,"en":"Their fangs jutted out,"},{"id":"semetey-1-2013:p0820:b005:l012","ordinal":139038,"en":"Their lower lips drooped,"},{"id":"semetey-1-2013:p0820:b005:l013","ordinal":139039,"en":"Their swan-like necks rose proudly."},{"id":"semetey-1-2013:p0820:b005:l014","ordinal":139040,"en":"They towered as though they would devour one."},{"id":"semetey-1-2013:p0820:b005:l015","ordinal":139041,"en":"The sight diverted one's heart,"},{"id":"semetey-1-2013:p0820:b005:l016","ordinal":139042,"en":"Their throat knobs showing."},{"id":"semetey-1-2013:p0820:b005:l017","ordinal":139043,"en":"Step by stately step they walked,"},{"id":"semetey-1-2013:p0820:b005:l018","ordinal":139044,"en":"Setting all four feet evenly,"},{"id":"semetey-1-2013:p0820:b005:l019","ordinal":139045,"en":"Dust settling on their long hair,"},{"id":"semetey-1-2013:p0820:b005:l020","ordinal":139046,"en":"A booming sound arising."},{"id":"semetey-1-2013:p0820:b005:l021","ordinal":139047,"en":"God creates living souls."},{"id":"semetey-1-2013:p0820:b005:l022","ordinal":139048,"en":"Eighty strongmen serving him"},{"id":"semetey-1-2013:p0820:b005:l023","ordinal":139049,"en":"Led those camels,"},{"id":"semetey-1-2013:p0820:b005:l024","ordinal":139050,"en":"As your gray-maned hero moved to Talas."},{"id":"semetey-1-2013:p0820:b005:l025","ordinal":139051,"en":"Semetey's Sary Khan"},{"id":"semetey-1-2013:p0820:b005:l026","ordinal":139052,"en":"Held in his hands"},{"id":"semetey-1-2013:p0820:b005:l027","ordinal":139053,"en":"A red banner with a golden crescent."},{"id":"semetey-1-2013:p0820:b005:l028","ordinal":139054,"en":"If an enemy came out to shoot,"},{"id":"semetey-1-2013:p0820:b005:l029","ordinal":139055,"en":"Both strongman and lion,"},{"id":"semetey-1-2013:p0820:b005:l030","ordinal":139056,"en":"He would throw the world into tumult."},{"id":"semetey-1-2013:p0820:b005:l031","ordinal":139057,"en":"Sary Khan's Kalyk,"},{"id":"semetey-1-2013:p0820:b005:l032","ordinal":139058,"en":"When he had cast down the kaldai's banner,"},{"id":"semetey-1-2013:p0820:b005:l034","ordinal":139059,"en":"To the Muslim people too"},{"id":"semetey-1-2013:p0820:b005:l035","ordinal":139060,"en":"Had brought the benefit of his light."},{"id":"semetey-1-2013:p0820:b005:l036","ordinal":139061,"en":"God creates living souls."},{"id":"semetey-1-2013:p0821:b003:l001","ordinal":139062,"en":"Eighty-eight souls in all,"},{"id":"semetey-1-2013:p0821:b003:l002","ordinal":139063,"en":"Your orphan, the son of Manas,"},{"id":"semetey-1-2013:p0821:b003:l003","ordinal":139064,"en":"Was moving to Talas."},{"id":"semetey-1-2013:p0821:b003:l004","ordinal":139065,"en":"The saint who had borne Manas,"},{"id":"semetey-1-2013:p0821:b003:l005","ordinal":139066,"en":"Chiyyrdy, at ninety-five,"},{"id":"semetey-1-2013:p0821:b003:l006","ordinal":139067,"en":"Set her gray pacer moving,"},{"id":"semetey-1-2013:p0821:b003:l007","ordinal":139068,"en":"Turning many hearts toward her,"},{"id":"semetey-1-2013:p0821:b003:l008","ordinal":139069,"en":"Her whitening hair showing,"},{"id":"semetey-1-2013:p0821:b003:l009","ordinal":139070,"en":"Reclining like Mount Opol,"},{"id":"semetey-1-2013:p0821:b003:l010","ordinal":139071,"en":"Sitting grandly on the gray pacer,"},{"id":"semetey-1-2013:p0821:b003:l011","ordinal":139072,"en":"The elder wife took this road."},{"id":"semetey-1-2013:p0821:b003:l012","ordinal":139073,"en":"Your extraordinary mother Kanykei—"},{"id":"semetey-1-2013:p0821:b003:l013","ordinal":139074,"en":"Heroically built, an extraordinary warrior,"},{"id":"semetey-1-2013:p0821:b003:l014","ordinal":139075,"en":"Her right shoulder blade was broad,"},{"id":"semetey-1-2013:p0821:b003:l015","ordinal":139076,"en":"An unmatched lion among women."},{"id":"semetey-1-2013:p0821:b003:l016","ordinal":139077,"en":"Emboldened by her courage,"},{"id":"semetey-1-2013:p0821:b003:l017","ordinal":139078,"en":"Kanykei at fourteen"},{"id":"semetey-1-2013:p0821:b003:l018","ordinal":139079,"en":"Had met that Manas."},{"id":"semetey-1-2013:p0821:b003:l019","ordinal":139080,"en":"They had joined when thumb-small,"},{"id":"semetey-1-2013:p0821:b003:l020","ordinal":139081,"en":"United when tiny as lice."},{"id":"semetey-1-2013:p0821:b003:l021","ordinal":139082,"en":"Sultan Manas, the gray-maned hero,"},{"id":"semetey-1-2013:p0821:b003:l022","ordinal":139083,"en":"She planted and tended into a garden,"},{"id":"semetey-1-2013:p0821:b003:l023","ordinal":139084,"en":"Built and raised into a house."},{"id":"semetey-1-2013:p0821:b003:l024","ordinal":139085,"en":"She joined what had broken,"},{"id":"semetey-1-2013:p0821:b003:l025","ordinal":139086,"en":"Gathered what had scattered."},{"id":"semetey-1-2013:p0821:b003:l026","ordinal":139087,"en":"Her black hair like sedge"},{"id":"semetey-1-2013:p0821:b003:l027","ordinal":139088,"en":"She bound tightly atop her head."},{"id":"semetey-1-2013:p0821:b003:l028","ordinal":139089,"en":"If an enemy came out to shoot,"},{"id":"semetey-1-2013:p0821:b003:l029","ordinal":139090,"en":"They drove the enemy back together."},{"id":"semetey-1-2013:p0821:b003:l030","ordinal":139091,"en":"Your dear mother Kanykei—"},{"id":"semetey-1-2013:p0821:b003:l031","ordinal":139092,"en":"Which of her deeds shall we tell?"},{"id":"semetey-1-2013:p0821:b003:l032","ordinal":139093,"en":"She made her mourning head a banner,"},{"id":"semetey-1-2013:p0821:b003:l033","ordinal":139094,"en":"Made a woman's self a hero."},{"id":"semetey-1-2013:p0821:b003:l034","ordinal":139095,"en":"Heroically built, an extraordinary warrior,"},{"id":"semetey-1-2013:p0821:b003:l036","ordinal":139096,"en":"An arrow loosed in many battles.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0821:b003:l037","ordinal":139097,"en":"That precious mother of yours, Kanykei,"},{"id":"semetey-1-2013:p0821:b003:l038","ordinal":139098,"en":"Was an accomplished woman,"},{"id":"semetey-1-2013:p0821:b003:l039","ordinal":139099,"en":"The daughter of Temir Khan."},{"id":"semetey-1-2013:p0821:b004:l001","ordinal":139100,"en":"The youngest of twelve daughters,"},{"id":"semetey-1-2013:p0821:b004:l002","ordinal":139101,"en":"A servant beloved of God,"},{"id":"semetey-1-2013:p0821:b004:l003","ordinal":139102,"en":"The beauty among the dark-complexioned,"},{"id":"semetey-1-2013:p0821:b004:l004","ordinal":139103,"en":"The radiant one among Muslims,"},{"id":"semetey-1-2013:p0821:b004:l006","ordinal":139104,"en":"The finest among women,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0821:b004:l007","ordinal":139105,"en":"The best of all called wives,"},{"id":"semetey-1-2013:p0821:b004:l008","ordinal":139106,"en":"The sovereign among women."},{"id":"semetey-1-2013:p0821:b004:l009","ordinal":139107,"en":"Can an ordinary woman be like this?"},{"id":"semetey-1-2013:p0821:b004:l010","ordinal":139108,"en":"Can one who calls her merely a woman prosper?"},{"id":"semetey-1-2013:p0821:b004:l011","ordinal":139109,"en":"Whoever calls her merely a woman,"},{"id":"semetey-1-2013:p0821:b004:l012","ordinal":139110,"en":"Will he ever prosper in any year?"},{"id":"semetey-1-2013:p0821:b004:l013","ordinal":139111,"en":"By the time she left Bukhara,"},{"id":"semetey-1-2013:p0821:b004:l014","ordinal":139112,"en":"She had gathered her courage,"},{"id":"semetey-1-2013:p0821:b004:l015","ordinal":139113,"en":"Mounted a different horse,"},{"id":"semetey-1-2013:p0821:b004:l016","ordinal":139114,"en":"And donned a hero's clothing."},{"id":"semetey-1-2013:p0821:b004:l017","ordinal":139115,"en":"Wrathful and forbidding,"},{"id":"semetey-1-2013:p0821:b004:l018","ordinal":139116,"en":"As though she would slaughter Bukhara,"},{"id":"semetey-1-2013:p0821:b004:l019","ordinal":139117,"en":"She girded on an iron belt,"},{"id":"semetey-1-2013:p0821:b004:l020","ordinal":139118,"en":"Turned outward, revealing no secrets."},{"id":"semetey-1-2013:p0821:b004:l021","ordinal":139119,"en":"‘On my right are Russians;"},{"id":"semetey-1-2013:p0821:b004:l022","ordinal":139120,"en":"Before me are Franks."},{"id":"semetey-1-2013:p0821:b004:l023","ordinal":139121,"en":"Many enemies wait to contend with me."},{"id":"semetey-1-2013:p0821:b004:l024","ordinal":139122,"en":"If anyone attacks my only son,"},{"id":"semetey-1-2013:p0821:b004:l025","ordinal":139123,"en":"Let me die if my appointed death has come;"},{"id":"semetey-1-2013:p0821:b004:l026","ordinal":139124,"en":"If I have a means, let me try it."},{"id":"semetey-1-2013:p0821:b004:l027","ordinal":139125,"en":"For the poor child gained through mortal suffering,"},{"id":"semetey-1-2013:p0821:b004:l028","ordinal":139126,"en":"Let me serve as a protector."},{"id":"semetey-1-2013:p0821:b004:l029","ordinal":139127,"en":"Between Talas and Bukhara"},{"id":"semetey-1-2013:p0821:b004:l030","ordinal":139128,"en":"Lies a considerable road,"},{"id":"semetey-1-2013:p0821:b004:l031","ordinal":139129,"en":"And many enemies to contend with.’"},{"id":"semetey-1-2013:p0821:b004:l032","ordinal":139130,"en":"Preparing her equipment,"},{"id":"semetey-1-2013:p0821:b004:l033","ordinal":139131,"en":"All her weapons"},{"id":"semetey-1-2013:p0821:b004:l034","ordinal":139132,"en":"She fastened on in readiness."},{"id":"semetey-1-2013:p0821:b004:l035","ordinal":139133,"en":"Your extraordinary mother Kanykei"},{"id":"semetey-1-2013:p0821:b004:l036","ordinal":139134,"en":"Led Chachykei along."},{"id":"semetey-1-2013:p0821:b004:l037","ordinal":139135,"en":"The cherished bride Chachykei,"},{"id":"semetey-1-2013:p0821:b004:l038","ordinal":139136,"en":"In changing hues of red and many colors,"},{"id":"semetey-1-2013:p0821:b004:l039","ordinal":139137,"en":"She dressed in crimson cloth,"},{"id":"semetey-1-2013:p0822:b003:l001","ordinal":139138,"en":"The hem of the crimson cloth"},{"id":"semetey-1-2013:p0822:b003:l002","ordinal":139139,"en":"She let trail slantwise upon the ground."},{"id":"semetey-1-2013:p0822:b003:l003","ordinal":139140,"en":"Appearing mottled green,"},{"id":"semetey-1-2013:p0822:b003:l004","ordinal":139141,"en":"She dressed her in pure silk,"},{"id":"semetey-1-2013:p0822:b003:l005","ordinal":139142,"en":"And the hem of that silk"},{"id":"semetey-1-2013:p0822:b003:l006","ordinal":139143,"en":"She spread to touch the ground."},{"id":"semetey-1-2013:p0822:b003:l007","ordinal":139144,"en":"Upon your Chachy's head,"},{"id":"semetey-1-2013:p0822:b003:l008","ordinal":139145,"en":"She placed the bridal headdress."},{"id":"semetey-1-2013:p0822:b003:l009","ordinal":139146,"en":"Along the headdress's rim,"},{"id":"semetey-1-2013:p0822:b003:l010","ordinal":139147,"en":"Red gold could be seen."},{"id":"semetey-1-2013:p0822:b003:l011","ordinal":139148,"en":"Whoever caught sight of her"},{"id":"semetey-1-2013:p0822:b003:l012","ordinal":139149,"en":"Had his heart greatly diverted."},{"id":"semetey-1-2013:p0822:b003:l013","ordinal":139150,"en":"Down her back, the braid coverings"},{"id":"semetey-1-2013:p0822:b003:l014","ordinal":139151,"en":"Fell in six separate strands."},{"id":"semetey-1-2013:p0822:b003:l015","ordinal":139152,"en":"The cherished Chachykei"},{"id":"semetey-1-2013:p0822:b003:l016","ordinal":139153,"en":"She dressed in many colors."},{"id":"semetey-1-2013:p0822:b003:l017","ordinal":139154,"en":"If you would see splendor, see it here:"},{"id":"semetey-1-2013:p0822:b003:l018","ordinal":139155,"en":"When they moved away from Bukhara,"},{"id":"semetey-1-2013:p0822:b003:l019","ordinal":139156,"en":"She gave her Taitoru to ride."},{"id":"semetey-1-2013:p0822:b003:l020","ordinal":139157,"en":"Setting their faces toward Talas,"},{"id":"semetey-1-2013:p0822:b003:l021","ordinal":139158,"en":"Semetey, the son of Manas,"},{"id":"semetey-1-2013:p0822:b003:l022","ordinal":139159,"en":"Rode Buurul, making him toss,"},{"id":"semetey-1-2013:p0822:b003:l023","ordinal":139160,"en":"Making him struggle like a bereaved wife."},{"id":"semetey-1-2013:p0822:b003:l024","ordinal":139161,"en":"Akolpok and Akkelte"},{"id":"semetey-1-2013:p0822:b003:l025","ordinal":139162,"en":"Could be seen upon him."},{"id":"semetey-1-2013:p0822:b003:l026","ordinal":139163,"en":"Manas's son was a hero,"},{"id":"semetey-1-2013:p0822:b003:l027","ordinal":139164,"en":"A lion who had studied his lessons,"},{"id":"semetey-1-2013:p0822:b003:l028","ordinal":139165,"en":"His father, magnanimous Manas—"},{"id":"semetey-1-2013:p0822:b003:l029","ordinal":139166,"en":"He was a hero born surpassing him."},{"id":"semetey-1-2013:p0822:b003:l030","ordinal":139167,"en":"A leopard with a guardian spirit,"},{"id":"semetey-1-2013:p0822:b003:l031","ordinal":139168,"en":"My saint who could not be shaken—"},{"id":"semetey-1-2013:p0822:b003:l032","ordinal":139169,"en":"The company traveled toward Talas,"},{"id":"semetey-1-2013:p0822:b003:l033","ordinal":139170,"en":"Going far without tiring,"},{"id":"semetey-1-2013:p0822:b003:l034","ordinal":139171,"en":"Wearing horses down, covering ground,"},{"id":"semetey-1-2013:p0822:b003:l035","ordinal":139172,"en":"Unleashing hounds and flying birds."},{"id":"semetey-1-2013:p0822:b003:l036","ordinal":139173,"en":"The horse he rode beneath him—"},{"id":"semetey-1-2013:p0822:b003:l037","ordinal":139174,"en":"His father Manas, carried away in fury,"},{"id":"semetey-1-2013:p0822:b003:l038","ordinal":139175,"en":"Had left that peerless steed behind."},{"id":"semetey-1-2013:p0822:b003:l039","ordinal":139176,"en":"What he held in his hand,"},{"id":"semetey-1-2013:p0822:b004:l001","ordinal":139177,"en":"Encountered through the unseen,"},{"id":"semetey-1-2013:p0822:b004:l002","ordinal":139178,"en":"Found in the open wilderness,"},{"id":"semetey-1-2013:p0822:b004:l003","ordinal":139179,"en":"A kite had hatched and reared into a falcon."},{"id":"semetey-1-2013:p0822:b004:l004","ordinal":139180,"en":"By God's decree, the child"},{"id":"semetey-1-2013:p0822:b004:l005","ordinal":139181,"en":"Had met it in the empty steppe:"},{"id":"semetey-1-2013:p0822:b004:l006","ordinal":139182,"en":"It was Semetey's falcon."},{"id":"semetey-1-2013:p0822:b004:l007","ordinal":139183,"en":"Your heroic lord, the son of Manas,"},{"id":"semetey-1-2013:p0822:b004:l008","ordinal":139184,"en":"Saying, ‘Spring has come,"},{"id":"semetey-1-2013:p0822:b004:l009","ordinal":139185,"en":"The land is full of greenery,"},{"id":"semetey-1-2013:p0822:b004:l010","ordinal":139186,"en":"The migrating swans, geese and ducks"},{"id":"semetey-1-2013:p0822:b004:l012","ordinal":139187,"en":"I am setting out upon my journey,’","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0822:b004:l013","ordinal":139188,"en":"The son of Manas took no heed."},{"id":"semetey-1-2013:p0822:b004:l014","ordinal":139189,"en":"If an enemy came out firing,"},{"id":"semetey-1-2013:p0822:b004:l015","ordinal":139190,"en":"Or a shouting giant appeared,"},{"id":"semetey-1-2013:p0822:b004:l016","ordinal":139191,"en":"He did not rate them at his heel."},{"id":"semetey-1-2013:p0822:b004:l017","ordinal":139192,"en":"Courage and insolent pride"},{"id":"semetey-1-2013:p0822:b004:l018","ordinal":139193,"en":"To the orphan son of Manas,"},{"id":"semetey-1-2013:p0822:b004:l019","ordinal":139194,"en":"God Most High, the Almighty,"},{"id":"semetey-1-2013:p0822:b004:l020","ordinal":139195,"en":"Had given without measure."},{"id":"semetey-1-2013:p0822:b004:l021","ordinal":139196,"en":"Your orphan, the son of Manas,"},{"id":"semetey-1-2013:p0822:b004:l022","ordinal":139197,"en":"Unleashing hounds and flying birds,"},{"id":"semetey-1-2013:p0822:b004:l023","ordinal":139198,"en":"Went on without a care."},{"id":"semetey-1-2013:p0822:b004:l024","ordinal":139199,"en":"The white falcon in his hand,"},{"id":"semetey-1-2013:p0822:b004:l026","ordinal":139200,"en":"Half silk and half gold,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0822:b004:l027","ordinal":139201,"en":"Had golden jesses on its feet."},{"id":"semetey-1-2013:p0822:b004:l028","ordinal":139202,"en":"It wrought slaughter among swans,"},{"id":"semetey-1-2013:p0822:b004:l029","ordinal":139203,"en":"And had enemies such as cranes."},{"id":"semetey-1-2013:p0822:b004:l030","ordinal":139204,"en":"Its talons were steel, its jess fastener copper;"},{"id":"semetey-1-2013:p0822:b004:l031","ordinal":139205,"en":"Nothing it struck escaped alive."},{"id":"semetey-1-2013:p0822:b004:l032","ordinal":139206,"en":"It measured two kez around."},{"id":"semetey-1-2013:p0822:b004:l033","ordinal":139207,"en":"It did not stoop with folded wings;"},{"id":"semetey-1-2013:p0822:b004:l034","ordinal":139208,"en":"It let no goose rise from the lake."},{"id":"semetey-1-2013:p0822:b004:l035","ordinal":139209,"en":"It did not stoop with spread tail;"},{"id":"semetey-1-2013:p0822:b004:l036","ordinal":139210,"en":"It let no swan rise from the lake."},{"id":"semetey-1-2013:p0822:b004:l037","ordinal":139211,"en":"It tired the arm that held it;"},{"id":"semetey-1-2013:p0822:b004:l038","ordinal":139212,"en":"Released, it satisfied the heart."},{"id":"semetey-1-2013:p0822:b004:l039","ordinal":139213,"en":"The white falcon in his hand—"},{"id":"semetey-1-2013:p0823:b003:l001","ordinal":139214,"en":"‘It will know my worth,"},{"id":"semetey-1-2013:p0823:b003:l002","ordinal":139215,"en":"And fly about keeping me in sight,’ he thought."},{"id":"semetey-1-2013:p0823:b003:l003","ordinal":139216,"en":"He cast it out toward the open country,"},{"id":"semetey-1-2013:p0823:b003:l004","ordinal":139217,"en":"And thrust it away to the far side."},{"id":"semetey-1-2013:p0823:b003:l005","ordinal":139218,"en":"The white falcon left his hand,"},{"id":"semetey-1-2013:p0823:b003:l006","ordinal":139219,"en":"Rose and set its course,"},{"id":"semetey-1-2013:p0823:b003:l007","ordinal":139220,"en":"As though it had lost sight of him."},{"id":"semetey-1-2013:p0823:b003:l008","ordinal":139221,"en":"Circling, gliding,"},{"id":"semetey-1-2013:p0823:b003:l009","ordinal":139222,"en":"Your oceanlike hero's white falcon"},{"id":"semetey-1-2013:p0823:b003:l010","ordinal":139223,"en":"Flew away, leaning back in the air."},{"id":"semetey-1-2013:p0823:b003:l011","ordinal":139224,"en":"Manas's heroic orphan son,"},{"id":"semetey-1-2013:p0823:b003:l012","ordinal":139225,"en":"On the near side of Bukhara,"},{"id":"semetey-1-2013:p0823:b003:l013","ordinal":139226,"en":"Three days' journey this side of it,"},{"id":"semetey-1-2013:p0823:b003:l014","ordinal":139227,"en":"Where the rough hillocks"},{"id":"semetey-1-2013:p0823:b003:l015","ordinal":139228,"en":"Came to an end at a spur,"},{"id":"semetey-1-2013:p0823:b003:l016","ordinal":139229,"en":"At a jutting stand of thick chiy grass,"},{"id":"semetey-1-2013:p0823:b003:l017","ordinal":139230,"en":"The land was full of greenery."},{"id":"semetey-1-2013:p0823:b003:l018","ordinal":139231,"en":"Along that stretch of land,"},{"id":"semetey-1-2013:p0823:b003:l019","ordinal":139232,"en":"Grazing like sheep in their thousands,"},{"id":"semetey-1-2013:p0823:b003:l020","ordinal":139233,"en":"Bustards filled the place, waddling about."},{"id":"semetey-1-2013:p0823:b003:l021","ordinal":139234,"en":"Now the spectacle was complete."},{"id":"semetey-1-2013:p0823:b003:l022","ordinal":139235,"en":"At those walking bustards,"},{"id":"semetey-1-2013:p0823:b003:l023","ordinal":139236,"en":"Manas Khan's Kumaiyk"},{"id":"semetey-1-2013:p0823:b003:l024","ordinal":139237,"en":"Arrived and sent them scattering."},{"id":"semetey-1-2013:p0823:b003:l025","ordinal":139238,"en":"With a thunder that hid the ground,"},{"id":"semetey-1-2013:p0823:b003:l026","ordinal":139239,"en":"The bustards took flight."},{"id":"semetey-1-2013:p0823:b003:l027","ordinal":139240,"en":"The white falcon reached and struck them,"},{"id":"semetey-1-2013:p0823:b003:l028","ordinal":139241,"en":"Striking each one it overtook,"},{"id":"semetey-1-2013:p0823:b003:l029","ordinal":139242,"en":"While Kumaiyk went biting them."},{"id":"semetey-1-2013:p0823:b003:l030","ordinal":139243,"en":"Your orphan, the son of Manas,"},{"id":"semetey-1-2013:p0823:b003:l031","ordinal":139244,"en":"Pounded Taibuurul onward,"},{"id":"semetey-1-2013:p0823:b003:l032","ordinal":139245,"en":"Shouting, ‘Manas! Manas!’"},{"id":"semetey-1-2013:p0823:b003:l033","ordinal":139246,"en":"Raising ‘Manas!’ as his battle cry,"},{"id":"semetey-1-2013:p0823:b003:l034","ordinal":139247,"en":"Semetey went shouting his cry."},{"id":"semetey-1-2013:p0823:b003:l035","ordinal":139248,"en":"Letting no bustards or other birds escape,"},{"id":"semetey-1-2013:p0823:b003:l036","ordinal":139249,"en":"The white falcon pursued them,"},{"id":"semetey-1-2013:p0823:b003:l037","ordinal":139250,"en":"Striking this way and that."},{"id":"semetey-1-2013:p0823:b003:l038","ordinal":139251,"en":"The slaughtered bustards and other birds"},{"id":"semetey-1-2013:p0823:b003:l039","ordinal":139252,"en":"Kumaiyk went gathering up."},{"id":"semetey-1-2013:p0823:b004:l001","ordinal":139253,"en":"Your orphan, the son of Manas,"},{"id":"semetey-1-2013:p0823:b004:l002","ordinal":139254,"en":"Was filled with joy."},{"id":"semetey-1-2013:p0823:b004:l003","ordinal":139255,"en":"Kanykei in her advancing years,"},{"id":"semetey-1-2013:p0823:b004:l004","ordinal":139256,"en":"Chiyyrdy in her old age,"},{"id":"semetey-1-2013:p0823:b004:l005","ordinal":139257,"en":"Sary Khan with his bowl-like eyes,"},{"id":"semetey-1-2013:p0823:b004:l007","ordinal":139258,"en":"All four shared in the spectacle.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0823:b004:l008","ordinal":139259,"en":"On the plain smooth as a blade,"},{"id":"semetey-1-2013:p0823:b004:l009","ordinal":139260,"en":"Who had seen such a spectacle!"},{"id":"semetey-1-2013:p0823:b004:l010","ordinal":139261,"en":"Their servant lads who tended the camels"},{"id":"semetey-1-2013:p0823:b004:l011","ordinal":139262,"en":"Also came to a halt."},{"id":"semetey-1-2013:p0823:b004:l012","ordinal":139263,"en":"Marveling at the entertainment,"},{"id":"semetey-1-2013:p0823:b004:l013","ordinal":139264,"en":"They stood watching in amazement:"}]
