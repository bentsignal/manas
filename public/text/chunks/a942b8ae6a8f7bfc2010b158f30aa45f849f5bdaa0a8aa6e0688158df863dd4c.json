[{"id":"semetey-2-2013:p1121:b005:l012","ordinal":272897,"en":"Abandoned all care for life."},{"id":"semetey-2-2013:p1121:b005:l013","ordinal":272898,"en":"The people swarmed, the lake heaved;"},{"id":"semetey-2-2013:p1121:b005:l014","ordinal":272899,"en":"Their host was vast beyond counting."},{"id":"semetey-2-2013:p1121:b005:l015","ordinal":272900,"en":"They drew their bows and rained down arrows;"},{"id":"semetey-2-2013:p1121:b005:l016","ordinal":272901,"en":"Brave Kyyaz charged with them all."},{"id":"semetey-2-2013:p1121:b005:l017","ordinal":272902,"en":"Swinging his sword and thrusting his spear,"},{"id":"semetey-2-2013:p1121:b005:l018","ordinal":272903,"en":"Brave Kyyaz plunged into the battle,"},{"id":"semetey-2-2013:p1121:b005:l019","ordinal":272904,"en":"Roaring as he poured out his wrath,"},{"id":"semetey-2-2013:p1121:b005:l020","ordinal":272905,"en":"Raising the battle cry, “Kyyaz!”"},{"id":"semetey-2-2013:p1121:b005:l021","ordinal":272906,"en":"The two sides faced one another,"},{"id":"semetey-2-2013:p1121:b005:l022","ordinal":272907,"en":"Firing muskets and drawing bows,"},{"id":"semetey-2-2013:p1121:b005:l023","ordinal":272908,"en":"Fighting with utter disregard for life;"},{"id":"semetey-2-2013:p1121:b005:l024","ordinal":272909,"en":"A terrible conflict broke out."},{"id":"semetey-2-2013:p1121:b005:l025","ordinal":272910,"en":"They stood locked in battle."},{"id":"semetey-2-2013:p1121:b005:l026","ordinal":272911,"en":"Then Külchoro appeared,"},{"id":"semetey-2-2013:p1121:b005:l027","ordinal":272912,"en":"Choro the lion, upheld by the spirits,"},{"id":"semetey-2-2013:p1121:b005:l028","ordinal":272913,"en":"Agile beyond imagining,"},{"id":"semetey-2-2013:p1121:b005:l029","ordinal":272914,"en":"The fiercely clashing warrior Choro,"},{"id":"semetey-2-2013:p1121:b005:l030","ordinal":272915,"en":"Choro, perfectly formed in every limb,"},{"id":"semetey-2-2013:p1121:b005:l031","ordinal":272916,"en":"Who had slaughtered not only Kyrgyz"},{"id":"semetey-2-2013:p1121:b005:l032","ordinal":272917,"en":"But Chinese armies too."},{"id":"semetey-2-2013:p1121:b005:l033","ordinal":272918,"en":"Then Külchoro"},{"id":"semetey-2-2013:p1121:b005:l034","ordinal":272919,"en":"Made all his weapons ready"},{"id":"semetey-2-2013:p1121:b005:l035","ordinal":272920,"en":"And buckled his sword at his side."},{"id":"semetey-2-2013:p1121:b005:l036","ordinal":272921,"en":"The Jediger were ten thousand; he was alone."},{"id":"semetey-2-2013:p1121:b005:l037","ordinal":272922,"en":"All the agony of cherished life"},{"id":"semetey-2-2013:p1121:b005:l038","ordinal":272923,"en":"Külchoro endured;"},{"id":"semetey-2-2013:p1121:b005:l039","ordinal":272924,"en":"He fought having cast life aside."},{"id":"semetey-2-2013:p1122:b003:l001","ordinal":272925,"en":"Külchoro walked amid death."},{"id":"semetey-2-2013:p1122:b003:l002","ordinal":272926,"en":"His frail life cried out,"},{"id":"semetey-2-2013:p1122:b003:l003","ordinal":272927,"en":"Every bone in his body ached,"},{"id":"semetey-2-2013:p1122:b003:l004","ordinal":272928,"en":"His heart was torn into a thousand pieces,"},{"id":"semetey-2-2013:p1122:b003:l005","ordinal":272929,"en":"And tears poured from his eyes."},{"id":"semetey-2-2013:p1122:b003:l006","ordinal":272930,"en":"The Jediger’s black banner"},{"id":"semetey-2-2013:p1122:b003:l007","ordinal":272931,"en":"And their earth-shaking uproar"},{"id":"semetey-2-2013:p1122:b003:l008","ordinal":272932,"en":"Appeared before him."},{"id":"semetey-2-2013:p1122:b003:l009","ordinal":272933,"en":"Ah, your hero Külchoro thought,"},{"id":"semetey-2-2013:p1122:b003:l010","ordinal":272934,"en":"“If my destined hour has come, let me die;"},{"id":"semetey-2-2013:p1122:b003:l011","ordinal":272935,"en":"But if the falcon of the moon,"},{"id":"semetey-2-2013:p1122:b003:l012","ordinal":272936,"en":"The gray-maned hero Semetey,"},{"id":"semetey-2-2013:p1122:b003:l013","ordinal":272937,"en":"Is alive to stand over me,"},{"id":"semetey-2-2013:p1122:b003:l014","ordinal":272938,"en":"And still walks unharmed,"},{"id":"semetey-2-2013:p1122:b003:l015","ordinal":272939,"en":"What inheritance could I hope to receive"},{"id":"semetey-2-2013:p1122:b003:l016","ordinal":272940,"en":"Before my lion uncle"},{"id":"semetey-2-2013:p1122:b003:l017","ordinal":272941,"en":"If I spared this sly life"},{"id":"semetey-2-2013:p1122:b003:l018","ordinal":272942,"en":"And valued it even as a hair?”"},{"id":"semetey-2-2013:p1122:b003:l019","ordinal":272943,"en":"Your lion Choro’s cry split stone,"},{"id":"semetey-2-2013:p1122:b003:l020","ordinal":272944,"en":"His roar shattered heads."},{"id":"semetey-2-2013:p1122:b003:l021","ordinal":272945,"en":"He charged like a black lion,"},{"id":"semetey-2-2013:p1122:b003:l022","ordinal":272946,"en":"And wisdom came to him from the unseen."},{"id":"semetey-2-2013:p1122:b003:l023","ordinal":272947,"en":"Through their chiefs and champions,"},{"id":"semetey-2-2013:p1122:b003:l024","ordinal":272948,"en":"Through the warriors who entered the clash,"},{"id":"semetey-2-2013:p1122:b003:l025","ordinal":272949,"en":"Külchoro broke his way."},{"id":"semetey-2-2013:p1122:b003:l026","ordinal":272950,"en":"Among the Jediger who covered the earth,"},{"id":"semetey-2-2013:p1122:b003:l027","ordinal":272951,"en":"He attacked and cut a path alone;"},{"id":"semetey-2-2013:p1122:b003:l028","ordinal":272952,"en":"Külchoro went forth to rout them."},{"id":"semetey-2-2013:p1122:b003:l029","ordinal":272953,"en":"Their heroes and champions"},{"id":"semetey-2-2013:p1122:b003:l030","ordinal":272954,"en":"Külchoro bound as he advanced;"},{"id":"semetey-2-2013:p1122:b003:l031","ordinal":272955,"en":"The Jediger who boasted of their strength"},{"id":"semetey-2-2013:p1122:b003:l032","ordinal":272956,"en":"Külchoro drove before him."},{"id":"semetey-2-2013:p1122:b003:l033","ordinal":272957,"en":"He girded his slender waist,"},{"id":"semetey-2-2013:p1122:b003:l034","ordinal":272958,"en":"And against the Jediger covering the earth"},{"id":"semetey-2-2013:p1122:b003:l035","ordinal":272959,"en":"He charged alone,"},{"id":"semetey-2-2013:p1122:b003:l036","ordinal":272960,"en":"Raising the battle cry, “Manas!”"},{"id":"semetey-2-2013:p1122:b003:l037","ordinal":272961,"en":"When he reached the earth-filling Jediger,"},{"id":"semetey-2-2013:p1122:b003:l038","ordinal":272962,"en":"He struck and scattered their ranks."},{"id":"semetey-2-2013:p1122:b003:l039","ordinal":272963,"en":"Wherever his spear could reach,"},{"id":"semetey-2-2013:p1122:b004:l001","ordinal":272964,"en":"He crushed them with his spear;"},{"id":"semetey-2-2013:p1122:b004:l002","ordinal":272965,"en":"When anyone was caught upon its point,"},{"id":"semetey-2-2013:p1122:b004:l003","ordinal":272966,"en":"Your mighty lion Choro"},{"id":"semetey-2-2013:p1122:b004:l004","ordinal":272967,"en":"Ran him through and flung him away."},{"id":"semetey-2-2013:p1122:b004:l005","ordinal":272968,"en":"Wherever his battle-axe could reach,"},{"id":"semetey-2-2013:p1122:b004:l006","ordinal":272969,"en":"He hewed them with the axe;"},{"id":"semetey-2-2013:p1122:b004:l007","ordinal":272970,"en":"Lion Choro surged among them."},{"id":"semetey-2-2013:p1122:b004:l008","ordinal":272971,"en":"Wherever his sword could reach,"},{"id":"semetey-2-2013:p1122:b004:l009","ordinal":272972,"en":"He sliced them with the blade;"},{"id":"semetey-2-2013:p1122:b004:l010","ordinal":272973,"en":"Your Külchoro carved through them."},{"id":"semetey-2-2013:p1122:b004:l011","ordinal":272974,"en":"Roaring as he poured out his wrath,"},{"id":"semetey-2-2013:p1122:b004:l012","ordinal":272975,"en":"He scattered the Jediger,"},{"id":"semetey-2-2013:p1122:b004:l013","ordinal":272976,"en":"Spearing everyone he overtook,"},{"id":"semetey-2-2013:p1122:b004:l014","ordinal":272977,"en":"Searching, “Where is Kyyaz, the cur?”"},{"id":"semetey-2-2013:p1122:b004:l015","ordinal":272978,"en":"He speared the common soldiers,"},{"id":"semetey-2-2013:p1122:b004:l016","ordinal":272979,"en":"Searching, “Where is that villain Kyyaz?”"},{"id":"semetey-2-2013:p1122:b004:l017","ordinal":272980,"en":"He raced in pursuit behind them."},{"id":"semetey-2-2013:p1122:b004:l018","ordinal":272981,"en":"“Let those fated to die, die;"},{"id":"semetey-2-2013:p1122:b004:l019","ordinal":272982,"en":"And let those who remain alive"},{"id":"semetey-2-2013:p1122:b004:l020","ordinal":272983,"en":"Endure many calamities."},{"id":"semetey-2-2013:p1122:b004:l021","ordinal":272984,"en":"Let them lose their wits in terror;"},{"id":"semetey-2-2013:p1122:b004:l022","ordinal":272985,"en":"From this day on, let the Jediger"},{"id":"semetey-2-2013:p1122:b004:l023","ordinal":272986,"en":"Say, ‘Dear lord, we submit,’"},{"id":"semetey-2-2013:p1122:b004:l024","ordinal":272987,"en":"And crawl into a pit.”"},{"id":"semetey-2-2013:p1122:b004:l025","ordinal":272988,"en":"He raced upon his thoroughbred,"},{"id":"semetey-2-2013:p1122:b004:l026","ordinal":272989,"en":"And every giant warrior"},{"id":"semetey-2-2013:p1122:b004:l027","ordinal":272990,"en":"Who ventured near him"},{"id":"semetey-2-2013:p1122:b004:l028","ordinal":272991,"en":"He seized by the shins and hurled away."},{"id":"semetey-2-2013:p1122:b004:l029","ordinal":272992,"en":"At the sight of Külchoro,"},{"id":"semetey-2-2013:p1122:b004:l030","ordinal":272993,"en":"The Jediger crossed"},{"id":"semetey-2-2013:p1122:b004:l031","ordinal":272994,"en":"The foothills of Üch-Koshoy;"},{"id":"semetey-2-2013:p1122:b004:l032","ordinal":272995,"en":"As if a falcon had struck a bustard,"},{"id":"semetey-2-2013:p1122:b004:l033","ordinal":272996,"en":"The Jediger fled."},{"id":"semetey-2-2013:p1122:b004:l034","ordinal":272997,"en":"“Alas, prince, we submit!"},{"id":"semetey-2-2013:p1122:b004:l035","ordinal":272998,"en":"We shall not attack—we surrender!”"},{"id":"semetey-2-2013:p1122:b004:l036","ordinal":272999,"en":"“We yield!” they cried,"},{"id":"semetey-2-2013:p1122:b004:l037","ordinal":273000,"en":"“We are defeated!” and then"},{"id":"semetey-2-2013:p1122:b004:l038","ordinal":273001,"en":"They called out to Külchoro."},{"id":"semetey-2-2013:p1122:b004:l039","ordinal":273002,"en":"Despairing of their fly-like lives,"},{"id":"semetey-2-2013:p1123:b003:l001","ordinal":273003,"en":"They dismounted and ran to him."},{"id":"semetey-2-2013:p1123:b003:l002","ordinal":273004,"en":"The reins knotted into loops"},{"id":"semetey-2-2013:p1123:b003:l003","ordinal":273005,"en":"They placed around their necks;"},{"id":"semetey-2-2013:p1123:b003:l004","ordinal":273006,"en":"The great mass of black-clad Jediger"},{"id":"semetey-2-2013:p1123:b003:l005","ordinal":273007,"en":"Begged him to spare their lives."},{"id":"semetey-2-2013:p1123:b003:l006","ordinal":273008,"en":"The people clamored in uproar;"},{"id":"semetey-2-2013:p1123:b003:l007","ordinal":273009,"en":"It was a grievous conflict."},{"id":"semetey-2-2013:p1123:b003:l008","ordinal":273010,"en":"As they were destroyed, the people cried out,"},{"id":"semetey-2-2013:p1123:b003:l009","ordinal":273011,"en":"Despairing of their wretched lives:"},{"id":"semetey-2-2013:p1123:b003:l010","ordinal":273012,"en":"“This terrible calamity, this great conflict,"},{"id":"semetey-2-2013:p1123:b003:l011","ordinal":273013,"en":"Will slaughter us all!”"},{"id":"semetey-2-2013:p1123:b003:l012","ordinal":273014,"en":"Despairing of their wretched lives,"},{"id":"semetey-2-2013:p1123:b003:l013","ordinal":273015,"en":"Some would not remain still"},{"id":"semetey-2-2013:p1123:b003:l014","ordinal":273016,"en":"But rushed about in panic;"},{"id":"semetey-2-2013:p1123:b003:l015","ordinal":273017,"en":"Some wounded Jediger"},{"id":"semetey-2-2013:p1123:b003:l016","ordinal":273018,"en":"Fled toward the mountains."},{"id":"semetey-2-2013:p1123:b003:l017","ordinal":273019,"en":"Dust rose and haze covered the land;"},{"id":"semetey-2-2013:p1123:b003:l018","ordinal":273020,"en":"Calamity filled the world."},{"id":"semetey-2-2013:p1123:b003:l019","ordinal":273021,"en":"They scattered in every direction,"},{"id":"semetey-2-2013:p1123:b003:l020","ordinal":273022,"en":"And while they milled about in distress,"},{"id":"semetey-2-2013:p1123:b003:l021","ordinal":273023,"en":"Külchoro proved a true falcon,"},{"id":"semetey-2-2013:p1123:b003:l022","ordinal":273024,"en":"Waging a wondrous battle."},{"id":"semetey-2-2013:p1123:b003:l023","ordinal":273025,"en":"From among all the Jediger,"},{"id":"semetey-2-2013:p1123:b003:l024","ordinal":273026,"en":"Kadyrbay and Tölöbay—"},{"id":"semetey-2-2013:p1123:b003:l025","ordinal":273027,"en":"Elders risen from the people,"},{"id":"semetey-2-2013:p1123:b003:l026","ordinal":273028,"en":"Men of wisdom who knew the proper words,"},{"id":"semetey-2-2013:p1123:b003:l027","ordinal":273029,"en":"True sages among them—"},{"id":"semetey-2-2013:p1123:b003:l028","ordinal":273030,"en":"Kadyrbay hurried forth,"},{"id":"semetey-2-2013:p1123:b003:l029","ordinal":273031,"en":"Dismounted and composed himself,"},{"id":"semetey-2-2013:p1123:b003:l030","ordinal":273032,"en":"And there the falcon stood"},{"id":"semetey-2-2013:p1123:b003:l031","ordinal":273033,"en":"Pleading with Külchoro:"},{"id":"semetey-2-2013:p1123:b003:l032","ordinal":273034,"en":"“When we raid horses, our dust rises together;"},{"id":"semetey-2-2013:p1123:b003:l033","ordinal":273035,"en":"Our roots are one, our lives are one."},{"id":"semetey-2-2013:p1123:b003:l034","ordinal":273036,"en":"Across the breadth of Jeti-Özön"},{"id":"semetey-2-2013:p1123:b003:l035","ordinal":273037,"en":"The multitude lies dead—"},{"id":"semetey-2-2013:p1123:b003:l036","ordinal":273038,"en":"Hero, what guilt does the common nation bear?"},{"id":"semetey-2-2013:p1123:b003:l037","ordinal":273039,"en":"The whole mass of black-clad Jediger,"},{"id":"semetey-2-2013:p1123:b003:l038","ordinal":273040,"en":"Every one of us, elders and all,"},{"id":"semetey-2-2013:p1123:b003:l039","ordinal":273041,"en":"Was beaten and battered"},{"id":"semetey-2-2013:p1123:b005:l001","ordinal":273042,"en":"And driven here together."},{"id":"semetey-2-2013:p1123:b005:l002","ordinal":273043,"en":"We encountered Kembay;"},{"id":"semetey-2-2013:p1123:b005:l003","ordinal":273044,"en":"Each of us was brought here."},{"id":"semetey-2-2013:p1123:b005:l004","ordinal":273045,"en":"Forced to become an army,"},{"id":"semetey-2-2013:p1123:b005:l005","ordinal":273046,"en":"Every one of us was driven here."},{"id":"semetey-2-2013:p1123:b005:l006","ordinal":273047,"en":"Is it not our khan who is a fool?"},{"id":"semetey-2-2013:p1123:b005:l007","ordinal":273048,"en":"What guilt does the common nation bear?"},{"id":"semetey-2-2013:p1123:b005:l008","ordinal":273049,"en":"Is it not our leader who is a fool?"},{"id":"semetey-2-2013:p1123:b005:l009","ordinal":273050,"en":"What guilt do all the people bear?"},{"id":"semetey-2-2013:p1123:b005:l010","ordinal":273051,"en":"A witless khan grows rabid;"},{"id":"semetey-2-2013:p1123:b005:l011","ordinal":273052,"en":"May no khan swell with such madness."},{"id":"semetey-2-2013:p1123:b005:l012","ordinal":273053,"en":"Sowing discord among his people,"},{"id":"semetey-2-2013:p1123:b005:l013","ordinal":273054,"en":"He turns ravenously upon his subjects."},{"id":"semetey-2-2013:p1123:b005:l014","ordinal":273055,"en":"A foolish khan raves,"},{"id":"semetey-2-2013:p1123:b005:l015","ordinal":273056,"en":"Gathers the entire nation,"},{"id":"semetey-2-2013:p1123:b005:l016","ordinal":273057,"en":"Brings misery upon his people,"},{"id":"semetey-2-2013:p1123:b005:l017","ordinal":273058,"en":"And slaughters his subjects."},{"id":"semetey-2-2013:p1123:b005:l018","ordinal":273059,"en":"If you are a hero, if you are a lion,"},{"id":"semetey-2-2013:p1123:b005:l019","ordinal":273060,"en":"Slay brave Kyyaz,"},{"id":"semetey-2-2013:p1123:b005:l020","ordinal":273061,"en":"But restrain your anger."},{"id":"semetey-2-2013:p1123:b005:l021","ordinal":273062,"en":"Brave Kyyaz’s wild undertaking"},{"id":"semetey-2-2013:p1123:b005:l022","ordinal":273063,"en":"And the turmoil that has shaken the nation"},{"id":"semetey-2-2013:p1123:b005:l023","ordinal":273064,"en":"Are the villainy of Kanchoro.”"},{"id":"semetey-2-2013:p1123:b005:l024","ordinal":273065,"en":"So Kadyrbay raised an uproar"},{"id":"semetey-2-2013:p1123:b005:l025","ordinal":273066,"en":"And lamented bitterly:"},{"id":"semetey-2-2013:p1123:b005:l026","ordinal":273067,"en":"“We shall not assail your khan;"},{"id":"semetey-2-2013:p1123:b005:l027","ordinal":273068,"en":"Our seed and blood are one."},{"id":"semetey-2-2013:p1123:b005:l028","ordinal":273069,"en":"Ah, hero Külchoro,"},{"id":"semetey-2-2013:p1123:b005:l029","ordinal":273070,"en":"We all submit to you;"},{"id":"semetey-2-2013:p1123:b005:l030","ordinal":273071,"en":"Restrain your anger."},{"id":"semetey-2-2013:p1123:b005:l031","ordinal":273072,"en":"Do not destroy the innocent people."},{"id":"semetey-2-2013:p1123:b005:l032","ordinal":273073,"en":"Here are the cities and settled lands;"},{"id":"semetey-2-2013:p1123:b005:l033","ordinal":273074,"en":"If you would spill blood, here we are."},{"id":"semetey-2-2013:p1123:b005:l034","ordinal":273075,"en":"Here is the ground where heroes lie;"},{"id":"semetey-2-2013:p1123:b005:l035","ordinal":273076,"en":"If you would cut off heads, here we are."},{"id":"semetey-2-2013:p1123:b005:l036","ordinal":273077,"en":"If you will receive them, here are the people;"},{"id":"semetey-2-2013:p1123:b005:l037","ordinal":273078,"en":"Do not kill everyone who comes."},{"id":"semetey-2-2013:p1123:b005:l038","ordinal":273079,"en":"Do not unleash the fury of battle;"},{"id":"semetey-2-2013:p1123:b005:l039","ordinal":273080,"en":"Heed the words we have spoken."},{"id":"semetey-2-2013:p1124:b003:l001","ordinal":273081,"en":"These Kyrgyz will become your people;"},{"id":"semetey-2-2013:p1124:b003:l002","ordinal":273082,"en":"Spare them and do not slaughter them."},{"id":"semetey-2-2013:p1124:b003:l003","ordinal":273083,"en":"While we lived in Jeti-Özön,"},{"id":"semetey-2-2013:p1124:b003:l004","ordinal":273084,"en":"Brave Kyyaz of the Jediger"},{"id":"semetey-2-2013:p1124:b003:l005","ordinal":273085,"en":"Drove out your white-bearded elders"},{"id":"semetey-2-2013:p1124:b003:l006","ordinal":273086,"en":"And all the people with them."},{"id":"semetey-2-2013:p1124:b003:l007","ordinal":273087,"en":"Some he imprisoned;"},{"id":"semetey-2-2013:p1124:b003:l008","ordinal":273088,"en":"Others he simply"},{"id":"semetey-2-2013:p1124:b003:l009","ordinal":273089,"en":"Beat without mercy."},{"id":"semetey-2-2013:p1124:b003:l010","ordinal":273090,"en":"Some people he plundered,"},{"id":"semetey-2-2013:p1124:b003:l011","ordinal":273091,"en":"Aggrieving and humiliating them;"},{"id":"semetey-2-2013:p1124:b003:l012","ordinal":273092,"en":"He withered their fly-like lives"},{"id":"semetey-2-2013:p1124:b003:l013","ordinal":273093,"en":"And drove them here by force."},{"id":"semetey-2-2013:p1124:b003:l014","ordinal":273094,"en":"Is not Kyyaz the fool?"},{"id":"semetey-2-2013:p1124:b003:l015","ordinal":273095,"en":"What guilt do the slaughtered people bear?"},{"id":"semetey-2-2013:p1124:b003:l016","ordinal":273096,"en":"Is not your khan the fool?"},{"id":"semetey-2-2013:p1124:b003:l017","ordinal":273097,"en":"What guilt does the common nation bear?"},{"id":"semetey-2-2013:p1124:b003:l018","ordinal":273098,"en":"The people are treasure, the nation an inheritance."},{"id":"semetey-2-2013:p1124:b003:l019","ordinal":273099,"en":"My panther prince, do not slaughter your people."},{"id":"semetey-2-2013:p1124:b003:l020","ordinal":273100,"en":"When the horn is broken, strength is lost;"},{"id":"semetey-2-2013:p1124:b003:l021","ordinal":273101,"en":"When the udder is crushed and gone,"},{"id":"semetey-2-2013:p1124:b003:l022","ordinal":273102,"en":"The milk that sustains life is lost."},{"id":"semetey-2-2013:p1124:b003:l023","ordinal":273103,"en":"If you subjugate and slaughter the people,"},{"id":"semetey-2-2013:p1124:b003:l024","ordinal":273104,"en":"Your nation will surely slip from your grasp."},{"id":"semetey-2-2013:p1124:b003:l025","ordinal":273105,"en":"Hero, heed our words;"},{"id":"semetey-2-2013:p1124:b003:l026","ordinal":273106,"en":"Act with restraint."},{"id":"semetey-2-2013:p1124:b003:l027","ordinal":273107,"en":"Spare the great mass of your common subjects,"},{"id":"semetey-2-2013:p1124:b003:l028","ordinal":273108,"en":"Hero—the people are your treasure."},{"id":"semetey-2-2013:p1124:b003:l029","ordinal":273109,"en":"Brave Kyyaz of the Jediger"},{"id":"semetey-2-2013:p1124:b003:l030","ordinal":273110,"en":"Roused and gathered the Jediger of Jeti-Özön,"},{"id":"semetey-2-2013:p1124:b003:l031","ordinal":273111,"en":"Whipping them into a frenzy."},{"id":"semetey-2-2013:p1124:b003:l032","ordinal":273112,"en":"Raving, ‘I will avenge the blood-debt,’"},{"id":"semetey-2-2013:p1124:b003:l033","ordinal":273113,"en":"He drove them into madness,"},{"id":"semetey-2-2013:p1124:b003:l034","ordinal":273114,"en":"Drove them here in misery,"},{"id":"semetey-2-2013:p1124:b003:l035","ordinal":273115,"en":"Tormenting them and raising an uproar."},{"id":"semetey-2-2013:p1124:b003:l036","ordinal":273116,"en":"He drove us here in a long column;"},{"id":"semetey-2-2013:p1124:b003:l037","ordinal":273117,"en":"We gathered together only"},{"id":"semetey-2-2013:p1124:b003:l038","ordinal":273118,"en":"Because he said, ‘We shall attack the gray-maned hero.’"},{"id":"semetey-2-2013:p1124:b003:l039","ordinal":273119,"en":"We never desired, hero,"},{"id":"semetey-2-2013:p1124:b004:l001","ordinal":273120,"en":"For the people to be slaughtered."},{"id":"semetey-2-2013:p1124:b004:l002","ordinal":273121,"en":"As we set out for this place,"},{"id":"semetey-2-2013:p1124:b004:l003","ordinal":273122,"en":"The birches fell and the willows wept."},{"id":"semetey-2-2013:p1124:b004:l004","ordinal":273123,"en":"‘We shall die if we face the bloodthirsty man!’"},{"id":"semetey-2-2013:p1124:b004:l005","ordinal":273124,"en":"All the common people cried."},{"id":"semetey-2-2013:p1124:b004:l006","ordinal":273125,"en":"White-bearded old men wept,"},{"id":"semetey-2-2013:p1124:b004:l007","ordinal":273126,"en":"Saying, ‘Now we shall be left without fathers’;"},{"id":"semetey-2-2013:p1124:b004:l008","ordinal":273127,"en":"Children old enough to speak wept."},{"id":"semetey-2-2013:p1124:b004:l009","ordinal":273128,"en":"Brave Kyyaz’s oppression,"},{"id":"semetey-2-2013:p1124:b004:l010","ordinal":273129,"en":"His countless acts of violence, fell upon us."},{"id":"semetey-2-2013:p1124:b004:l011","ordinal":273130,"en":"Women wept in grief;"},{"id":"semetey-2-2013:p1124:b004:l012","ordinal":273131,"en":"We Jediger were herded here,"},{"id":"semetey-2-2013:p1124:b004:l013","ordinal":273132,"en":"Despairing of our precious lives."},{"id":"semetey-2-2013:p1124:b004:l014","ordinal":273133,"en":"My prince, look upon us and heed our words."},{"id":"semetey-2-2013:p1124:b004:l015","ordinal":273134,"en":"If you do not believe these words,"},{"id":"semetey-2-2013:p1124:b004:l016","ordinal":273135,"en":"You are the lion and we are sheep—"},{"id":"semetey-2-2013:p1124:b004:l017","ordinal":273136,"en":"Then slaughter us outright."},{"id":"semetey-2-2013:p1124:b004:l018","ordinal":273137,"en":"If you believe no traitor lives among the people,"},{"id":"semetey-2-2013:p1124:b004:l019","ordinal":273138,"en":"Then heed these words of mine:"},{"id":"semetey-2-2013:p1124:b004:l020","ordinal":273139,"en":"Against Kyyaz of the Jediger,"},{"id":"semetey-2-2013:p1124:b004:l021","ordinal":273140,"en":"Hero, wage single combat."},{"id":"semetey-2-2013:p1124:b004:l022","ordinal":273141,"en":"Tootoru, the swift horse ready for battle,"},{"id":"semetey-2-2013:p1124:b004:l023","ordinal":273142,"en":"Is a racer famed for vanquishing nations;"},{"id":"semetey-2-2013:p1124:b004:l024","ordinal":273143,"en":"Hero, take him as your prize."},{"id":"semetey-2-2013:p1124:b004:l025","ordinal":273144,"en":"Spare the innocent-hearted people;"},{"id":"semetey-2-2013:p1124:b004:l026","ordinal":273145,"en":"Your foe to fight is brave Kyyaz."},{"id":"semetey-2-2013:p1124:b004:l027","ordinal":273146,"en":"Hero, face him in combat and see."},{"id":"semetey-2-2013:p1124:b004:l028","ordinal":273147,"en":"Against Kyyaz, ablaze with deadly fury,"},{"id":"semetey-2-2013:p1124:b004:l029","ordinal":273148,"en":"Shout and level your spear."},{"id":"semetey-2-2013:p1124:b004:l030","ordinal":273149,"en":"Show your fearsome strength and valor"},{"id":"semetey-2-2013:p1124:b004:l031","ordinal":273150,"en":"Against brave Kyyaz."},{"id":"semetey-2-2013:p1124:b004:l032","ordinal":273151,"en":"Since it was Kyyaz who stirred up the conflict,"},{"id":"semetey-2-2013:p1124:b004:l033","ordinal":273152,"en":"If you attack these peaceful people,"}]
