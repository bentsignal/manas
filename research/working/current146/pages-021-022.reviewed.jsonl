{"id": "sayakbay-ms-current146:pdf022:l011", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 22, "folio": 405, "line_in_page": 11, "raw": "Ойлонуп көпкө болуптур,", "text": "Ойлонуп көпкө болуптур,", "en": "He remained deep in thought for a long time,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The word read көпкө is pale but fits the visible joins and syntax.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf022:l012", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 22, "folio": 405, "line_in_page": 12, "raw": "Даттанган көрүптүр,", "text": "Даттанган көрүптүр,", "en": "He saw one who had complained,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The opening word is a best visual reading; the line is faint.", "bbox": null}
