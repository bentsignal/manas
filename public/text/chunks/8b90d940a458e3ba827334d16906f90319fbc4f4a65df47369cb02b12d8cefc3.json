[{"id":"semetey-2-2013:p1269:b004:l017","ordinal":283393,"en":"There is no escape,"},{"id":"semetey-2-2013:p1269:b004:l018","ordinal":283394,"en":"Karalashar has no relatives,"},{"id":"semetey-2-2013:p1269:b004:l019","ordinal":283395,"en":"There is no steam for the corpse,"},{"id":"semetey-2-2013:p1269:b004:l020","ordinal":283396,"en":"With a lot of grief,"},{"id":"semetey-2-2013:p1269:b004:l021","ordinal":283397,"en":"Black air,"},{"id":"semetey-2-2013:p1269:b004:l022","ordinal":283398,"en":"Losing Semetei,"},{"id":"semetey-2-2013:p1269:b004:l023","ordinal":283399,"en":"Chama was tired and left."},{"id":"semetey-2-2013:p1269:b004:l024","ordinal":283400,"en":"The murderous murderer,"},{"id":"semetey-2-2013:p1269:b004:l025","ordinal":283401,"en":"Blood Semetey passed away,"},{"id":"semetey-2-2013:p1269:b004:l026","ordinal":283402,"en":"Bozdo rode a horse,"},{"id":"semetey-2-2013:p1269:b004:l027","ordinal":283403,"en":"Angry and sad"},{"id":"semetey-2-2013:p1269:b004:l028","ordinal":283404,"en":"Bloodthirsty lion like a black mountain"},{"id":"semetey-2-2013:p1269:b004:l029","ordinal":283405,"en":"Losing Semetei,"},{"id":"semetey-2-2013:p1269:b004:l030","ordinal":283406,"en":"That's when Kulchoro"},{"id":"semetey-2-2013:p1269:b004:l031","ordinal":283407,"en":"He stopped in the middle of nowhere."},{"id":"semetey-2-2013:p1269:b004:l032","ordinal":283408,"en":"Sometimes it becomes a ember,"},{"id":"semetey-2-2013:p1269:b004:l033","ordinal":283409,"en":"He mourned his grandfather."},{"id":"semetey-2-2013:p1269:b004:l034","ordinal":283410,"en":"Frost from white steel"},{"id":"semetey-2-2013:p1269:b004:l035","ordinal":283411,"en":"When I was wrapping,"},{"id":"semetey-2-2013:p1269:b004:l036","ordinal":283412,"en":"My generous air is in the bar"},{"id":"semetey-2-2013:p1269:b004:l037","ordinal":283413,"en":"What happened to me without dying?"},{"id":"semetey-2-2013:p1269:b004:l038","ordinal":283414,"en":"Black steel blue shield,"},{"id":"semetey-2-2013:p1269:b004:l039","ordinal":283415,"en":"When I sing,"},{"id":"semetey-2-2013:p1270:b003:l001","ordinal":283416,"en":"The bloodthirsty people are dancing,"},{"id":"semetey-2-2013:p1270:b003:l002","ordinal":283417,"en":"When I'm happy,"},{"id":"semetey-2-2013:p1270:b003:l003","ordinal":283418,"en":"Sharp steel sword"},{"id":"semetey-2-2013:p1270:b003:l004","ordinal":283419,"en":"While I was holding"},{"id":"semetey-2-2013:p1270:b003:l005","ordinal":283420,"en":"Kakanchy, my cousin"},{"id":"semetey-2-2013:p1270:b003:l006","ordinal":283421,"en":"When I'm slow,"},{"id":"semetey-2-2013:p1270:b003:l007","ordinal":283422,"en":"Caught the blood and crushed,"},{"id":"semetey-2-2013:p1270:b003:l008","ordinal":283423,"en":"In the fullness of my day,"},{"id":"semetey-2-2013:p1270:b003:l009","ordinal":283424,"en":"My blood is blue,"},{"id":"semetey-2-2013:p1270:b003:l010","ordinal":283425,"en":"What happened to me without dying?"},{"id":"semetey-2-2013:p1270:b003:l011","ordinal":283426,"en":"The mountain broke down and the stone fell,"},{"id":"semetey-2-2013:p1270:b003:l012","ordinal":283427,"en":"I would stay in the waist,"},{"id":"semetey-2-2013:p1270:b003:l013","ordinal":283428,"en":"The face of the earth is covered with water,"},{"id":"semetey-2-2013:p1270:b003:l014","ordinal":283429,"en":"Not bulging like a tom"},{"id":"semetey-2-2013:p1270:b003:l015","ordinal":283430,"en":"I would stay on the ground."},{"id":"semetey-2-2013:p1270:b003:l016","ordinal":283431,"en":"Losing a leg to walk"},{"id":"semetey-2-2013:p1270:b003:l017","ordinal":283432,"en":"I was a snake,"},{"id":"semetey-2-2013:p1270:b003:l018","ordinal":283433,"en":"Losing the tail"},{"id":"semetey-2-2013:p1270:b003:l019","ordinal":283434,"en":"It would be Kulan,"},{"id":"semetey-2-2013:p1270:b003:l020","ordinal":283435,"en":"Lost in the family,"},{"id":"semetey-2-2013:p1270:b003:l021","ordinal":283436,"en":"Sobbing and crying"},{"id":"semetey-2-2013:p1270:b003:l022","ordinal":283437,"en":"I would die badly."},{"id":"semetey-2-2013:p1270:b003:l023","ordinal":283438,"en":"My soul is buzzing like a fly,"},{"id":"semetey-2-2013:p1270:b003:l024","ordinal":283439,"en":"My bones are shaking"},{"id":"semetey-2-2013:p1270:b003:l025","ordinal":283440,"en":"I would die badly."},{"id":"semetey-2-2013:p1270:b003:l026","ordinal":283441,"en":"If I get pregnant, I can't get out again"},{"id":"semetey-2-2013:p1270:b003:l027","ordinal":283442,"en":"If I put forty ropes, it won't fit"},{"id":"semetey-2-2013:p1270:b003:l028","ordinal":283443,"en":"I'm in bed."},{"id":"semetey-2-2013:p1270:b003:l029","ordinal":283444,"en":"Nothing is left of hands and feet"},{"id":"semetey-2-2013:p1270:b003:l030","ordinal":283445,"en":"I am in custody."},{"id":"semetey-2-2013:p1270:b003:l031","ordinal":283446,"en":"My ice cream is unbreakable"},{"id":"semetey-2-2013:p1270:b003:l032","ordinal":283447,"en":"I'm trapped,"},{"id":"semetey-2-2013:p1270:b003:l033","ordinal":283448,"en":"Life is inevitable"},{"id":"semetey-2-2013:p1270:b003:l034","ordinal":283449,"en":"I'm trapped,"},{"id":"semetey-2-2013:p1270:b003:l035","ordinal":283450,"en":"Our road is dug"},{"id":"semetey-2-2013:p1270:b003:l036","ordinal":283451,"en":"It was boiled and very salty"},{"id":"semetey-2-2013:p1270:b003:l037","ordinal":283452,"en":"lion lost the lion,"},{"id":"semetey-2-2013:p1270:b003:l038","ordinal":283453,"en":"Both hands are tied."},{"id":"semetey-2-2013:p1270:b003:l039","ordinal":283454,"en":"Our word is over."},{"id":"semetey-2-2013:p1270:b004:l001","ordinal":283455,"en":"Abakemen lost"},{"id":"semetey-2-2013:p1270:b004:l002","ordinal":283456,"en":"Today, two eyes are sharp."},{"id":"semetey-2-2013:p1270:b004:l003","ordinal":283457,"en":"The day is over,"},{"id":"semetey-2-2013:p1270:b004:l004","ordinal":283458,"en":"The tongue is tied"},{"id":"semetey-2-2013:p1270:b004:l005","ordinal":283459,"en":"The tree was burned,"},{"id":"semetey-2-2013:p1270:b004:l006","ordinal":283460,"en":"It's over, you'll see!\""},{"id":"semetey-2-2013:p1270:b004:l007","ordinal":283461,"en":"That's how Kulchoro said"},{"id":"semetey-2-2013:p1270:b004:l008","ordinal":283462,"en":"The white color is diluted,"},{"id":"semetey-2-2013:p1270:b004:l009","ordinal":283463,"en":"Tears flowing from both sides"},{"id":"semetey-2-2013:p1270:b004:l010","ordinal":283464,"en":"Poured down slowly."},{"id":"semetey-2-2013:p1270:b004:l011","ordinal":283465,"en":"Weeping and crying"},{"id":"semetey-2-2013:p1270:b004:l012","ordinal":283466,"en":"Leaning on a golden-cheeked beast,"},{"id":"semetey-2-2013:p1270:b004:l013","ordinal":283467,"en":"Generation yellow water,"},{"id":"semetey-2-2013:p1270:b004:l014","ordinal":283468,"en":"The earth trembled,"},{"id":"semetey-2-2013:p1270:b004:l015","ordinal":283469,"en":"The world became night,"},{"id":"semetey-2-2013:p1270:b004:l016","ordinal":283470,"en":"It is a difficult task."},{"id":"semetey-2-2013:p1270:b004:l017","ordinal":283471,"en":"Angry, Kulchoro"},{"id":"semetey-2-2013:p1270:b004:l018","ordinal":283472,"en":"After nine days,"},{"id":"semetey-2-2013:p1270:b004:l019","ordinal":283473,"en":"Poor thing"},{"id":"semetey-2-2013:p1270:b004:l020","ordinal":283474,"en":"Eat wounds from ninety places,"},{"id":"semetey-2-2013:p1270:b004:l021","ordinal":283475,"en":"She was tired and left."},{"id":"semetey-2-2013:p1270:b004:l022","ordinal":283476,"en":"Black blood from the body"},{"id":"semetey-2-2013:p1270:b004:l023","ordinal":283477,"en":"\"It's a bad day, don't die,"},{"id":"semetey-2-2013:p1270:b004:l024","ordinal":283478,"en":"Don't be a fool to be insulted."},{"id":"semetey-2-2013:p1270:b004:l025","ordinal":283479,"en":"Yesterday when God took my father"},{"id":"semetey-2-2013:p1270:b004:l026","ordinal":283480,"en":"Losing parents"},{"id":"semetey-2-2013:p1270:b004:l027","ordinal":283481,"en":"When he was a baby"},{"id":"semetey-2-2013:p1270:b004:l028","ordinal":283482,"en":"Adopted and saved,"},{"id":"semetey-2-2013:p1270:b004:l029","ordinal":283483,"en":"My father did the same with his son,"},{"id":"semetey-2-2013:p1270:b004:l030","ordinal":283484,"en":"I told you that I am a lion,"},{"id":"semetey-2-2013:p1270:b004:l031","ordinal":283485,"en":"Mounted on his neck,"},{"id":"semetey-2-2013:p1270:b004:l032","ordinal":283486,"en":"The stomach will open - saying,"},{"id":"semetey-2-2013:p1270:b004:l033","ordinal":283487,"en":"Cut off by the judge,"},{"id":"semetey-2-2013:p1270:b004:l034","ordinal":283488,"en":"To be a true brother,"},{"id":"semetey-2-2013:p1270:b004:l035","ordinal":283489,"en":"My grandmother Kanikei's breast"},{"id":"semetey-2-2013:p1270:b004:l036","ordinal":283490,"en":"Breastfed equally"},{"id":"semetey-2-2013:p1270:b004:l037","ordinal":283491,"en":"Argyn and Kyrgyz"},{"id":"semetey-2-2013:p1270:b004:l038","ordinal":283492,"en":"When did they call us slaves?"},{"id":"semetey-2-2013:p1270:b004:l039","ordinal":283493,"en":"Cuddling children"},{"id":"semetey-2-2013:p1271:b003:l001","ordinal":283494,"en":"He had a tail fastened to the bay horse,"},{"id":"semetey-2-2013:p1271:b003:l002","ordinal":283495,"en":"Lest the summer heat strike him,"},{"id":"semetey-2-2013:p1271:b003:l003","ordinal":283496,"en":"And kept him in the shade,"},{"id":"semetey-2-2013:p1271:b003:l004","ordinal":283497,"en":"Saying, “He will be my companion,”"},{"id":"semetey-2-2013:p1271:b003:l005","ordinal":283498,"en":"Leading him about and training him,"},{"id":"semetey-2-2013:p1271:b003:l006","ordinal":283499,"en":"Saying, “He will wreak slaughter upon the foe,"},{"id":"semetey-2-2013:p1271:b003:l007","ordinal":283500,"en":"And vanquish every enemy he faces,”"},{"id":"semetey-2-2013:p1271:b003:l008","ordinal":283501,"en":"Tempering him like white steel."},{"id":"semetey-2-2013:p1271:b003:l009","ordinal":283502,"en":"Ill-fated in your bereavement,"},{"id":"semetey-2-2013:p1271:b003:l010","ordinal":283503,"en":"My dear Külchoro,"},{"id":"semetey-2-2013:p1271:b003:l011","ordinal":283504,"en":"Take me with you—do not leave me wailing."},{"id":"semetey-2-2013:p1271:b003:l012","ordinal":283505,"en":"While my heroic uncle lived,"},{"id":"semetey-2-2013:p1271:b003:l013","ordinal":283506,"en":"I ate my meals as his pampered child;"},{"id":"semetey-2-2013:p1271:b003:l014","ordinal":283507,"en":"Against the eighteen thousand worlds,"},{"id":"semetey-2-2013:p1271:b003:l015","ordinal":283508,"en":"If my devastating uncle were here,"},{"id":"semetey-2-2013:p1271:b003:l016","ordinal":283509,"en":"I used to say, “I shall wreak carnage.”"},{"id":"semetey-2-2013:p1271:b003:l017","ordinal":283510,"en":"I was a lofty white peak, but now I am laid low;"},{"id":"semetey-2-2013:p1271:b003:l018","ordinal":283511,"en":"Parted from my magnanimous lion,"},{"id":"semetey-2-2013:p1271:b003:l019","ordinal":283512,"en":"I have fallen into utter misery."},{"id":"semetey-2-2013:p1271:b003:l020","ordinal":283513,"en":"I entered battle, then turned back;"},{"id":"semetey-2-2013:p1271:b003:l021","ordinal":283514,"en":"My own kinsman became my foe,"},{"id":"semetey-2-2013:p1271:b003:l022","ordinal":283515,"en":"And I lost you, my khan and uncle."},{"id":"semetey-2-2013:p1271:b003:l023","ordinal":283516,"en":"Among the encircling hosts, I stand alone;"},{"id":"semetey-2-2013:p1271:b003:l024","ordinal":283517,"en":"A bullet struck and tore through my shoulder,"},{"id":"semetey-2-2013:p1271:b003:l025","ordinal":283518,"en":"And I cannot turn around."},{"id":"semetey-2-2013:p1271:b003:l026","ordinal":283519,"en":"Amid the thousands surrounding me, I stand alone;"},{"id":"semetey-2-2013:p1271:b003:l027","ordinal":283520,"en":"A bullet shattered my ankle,"},{"id":"semetey-2-2013:p1271:b003:l028","ordinal":283521,"en":"And I cannot move."},{"id":"semetey-2-2013:p1271:b003:l029","ordinal":283522,"en":"Helpless and growing weak,"},{"id":"semetey-2-2013:p1271:b003:l030","ordinal":283523,"en":"My strength gone as I bleed,"},{"id":"semetey-2-2013:p1271:b003:l031","ordinal":283524,"en":"My soul screaming, my vigor spent,"},{"id":"semetey-2-2013:p1271:b003:l032","ordinal":283525,"en":"All power fled, steeped in grief,"},{"id":"semetey-2-2013:p1271:b003:l033","ordinal":283526,"en":"Parted from my dear uncle,"},{"id":"semetey-2-2013:p1271:b003:l034","ordinal":283527,"en":"Here I sit in this plight."},{"id":"semetey-2-2013:p1271:b003:l035","ordinal":283528,"en":"The wings meant for flight were crooked;"},{"id":"semetey-2-2013:p1271:b003:l036","ordinal":283529,"en":"My true fortune was meager."},{"id":"semetey-2-2013:p1271:b003:l037","ordinal":283530,"en":"A deep pit was all I was destined to see;"},{"id":"semetey-2-2013:p1271:b003:l038","ordinal":283531,"en":"My own kinsman Kanchoro"},{"id":"semetey-2-2013:p1271:b003:l039","ordinal":283532,"en":"Had no trace of brotherhood in him."},{"id":"semetey-2-2013:p1271:b004:l001","ordinal":283533,"en":"My own kin became my enemy;"},{"id":"semetey-2-2013:p1271:b004:l002","ordinal":283534,"en":"Parted from my beloved lion,"},{"id":"semetey-2-2013:p1271:b004:l003","ordinal":283535,"en":"My sorrow will not leave me."},{"id":"semetey-2-2013:p1271:b004:l004","ordinal":283536,"en":"A fire burns within my core;"},{"id":"semetey-2-2013:p1271:b004:l005","ordinal":283537,"en":"My own kinsman became my foe,"},{"id":"semetey-2-2013:p1271:b004:l006","ordinal":283538,"en":"And bitter misery became my lot."},{"id":"semetey-2-2013:p1271:b004:l007","ordinal":283539,"en":"The sky is clear, yet the earth is overcast;"},{"id":"semetey-2-2013:p1271:b004:l008","ordinal":283540,"en":"This is a woeful, calamitous day."},{"id":"semetey-2-2013:p1271:b004:l009","ordinal":283541,"en":"I am left wandering, ill-fated;"},{"id":"semetey-2-2013:p1271:b004:l010","ordinal":283542,"en":"Alas, my uncle, take me with you."},{"id":"semetey-2-2013:p1271:b004:l011","ordinal":283543,"en":"My aged grandfather Bakay is gone;"},{"id":"semetey-2-2013:p1271:b004:l012","ordinal":283544,"en":"My mountain-like uncle is gone."},{"id":"semetey-2-2013:p1271:b004:l013","ordinal":283545,"en":"So this is what you are like, treacherous world—"},{"id":"semetey-2-2013:p1271:b004:l014","ordinal":283546,"en":"Damn you, worthless world!"},{"id":"semetey-2-2013:p1271:b004:l015","ordinal":283547,"en":"Wandering in grief,"},{"id":"semetey-2-2013:p1271:b004:l016","ordinal":283548,"en":"My beloved Semetey—"},{"id":"semetey-2-2013:p1271:b004:l017","ordinal":283549,"en":"Parted from Semetey,"},{"id":"semetey-2-2013:p1271:b004:l018","ordinal":283550,"en":"I am about to fall to a foe"},{"id":"semetey-2-2013:p1271:b004:l019","ordinal":283551,"en":"Who spares no life, however one pleads."},{"id":"semetey-2-2013:p1271:b004:l020","ordinal":283552,"en":"Am I to plunge into a calamity"},{"id":"semetey-2-2013:p1271:b004:l021","ordinal":283553,"en":"No man can wade through?"},{"id":"semetey-2-2013:p1271:b004:l022","ordinal":283554,"en":"Shorn of my wings,"},{"id":"semetey-2-2013:p1271:b004:l023","ordinal":283555,"en":"Am I about to be captured?"},{"id":"semetey-2-2013:p1271:b004:l024","ordinal":283556,"en":"Pleading, “Spare my blood,”"},{"id":"semetey-2-2013:p1271:b004:l025","ordinal":283557,"en":"Are we to die a wretched death?"},{"id":"semetey-2-2013:p1271:b004:l026","ordinal":283558,"en":"These pressing Jediger"},{"id":"semetey-2-2013:p1271:b004:l027","ordinal":283559,"en":"Are not the red, misty mountains;"},{"id":"semetey-2-2013:p1271:b004:l028","ordinal":283560,"en":"Those pressing in to take my life"},{"id":"semetey-2-2013:p1271:b004:l029","ordinal":283561,"en":"Are not an enemy come from China,"},{"id":"semetey-2-2013:p1271:b004:l030","ordinal":283562,"en":"Nor are they the dark, rugged mountains."},{"id":"semetey-2-2013:p1271:b004:l031","ordinal":283563,"en":"The Jediger swarming over me"},{"id":"semetey-2-2013:p1271:b004:l032","ordinal":283564,"en":"Are not an enemy sprung from the Kalmyks."},{"id":"semetey-2-2013:p1271:b004:l033","ordinal":283565,"en":"Their lungs bursting, their hearts aflame—"},{"id":"semetey-2-2013:p1271:b004:l034","ordinal":283566,"en":"These Jediger are surely mad."},{"id":"semetey-2-2013:p1271:b004:l035","ordinal":283567,"en":"Though Kyrgyz, they fired upon us"},{"id":"semetey-2-2013:p1271:b004:l036","ordinal":283568,"en":"And did worse than the Chinese."},{"id":"semetey-2-2013:p1271:b004:l037","ordinal":283569,"en":"Where no enemy dared advance,"},{"id":"semetey-2-2013:p1271:b004:l038","ordinal":283570,"en":"The Ala-Too was our land;"},{"id":"semetey-2-2013:p1271:b004:l039","ordinal":283571,"en":"Black-coated and white-capped,"},{"id":"semetey-2-2013:p1272:b003:l001","ordinal":283572,"en":"Our dear Kyrgyz were our people."},{"id":"semetey-2-2013:p1272:b003:l002","ordinal":283573,"en":"You fired your guns with thunderous cracks—"},{"id":"semetey-2-2013:p1272:b003:l003","ordinal":283574,"en":"My dear people, do as you will."},{"id":"semetey-2-2013:p1272:b003:l004","ordinal":283575,"en":"Our backs have turned against one another;"},{"id":"semetey-2-2013:p1272:b003:l005","ordinal":283576,"en":"Alas, our people have become corrupt."},{"id":"semetey-2-2013:p1272:b003:l006","ordinal":283577,"en":"Our nature has utterly changed;"},{"id":"semetey-2-2013:p1272:b003:l007","ordinal":283578,"en":"The Kyrgyz people are ruined."},{"id":"semetey-2-2013:p1272:b003:l008","ordinal":283579,"en":"They are not an enemy from the Chinese khagan,"},{"id":"semetey-2-2013:p1272:b003:l009","ordinal":283580,"en":"Yet, doing worse than the Chinese,"},{"id":"semetey-2-2013:p1272:b003:l010","ordinal":283581,"en":"Our hearts have turned against each other."},{"id":"semetey-2-2013:p1272:b003:l011","ordinal":283582,"en":"The lion died and our strength departed;"},{"id":"semetey-2-2013:p1272:b003:l012","ordinal":283583,"en":"All fortune and prosperity vanished."},{"id":"semetey-2-2013:p1272:b003:l013","ordinal":283584,"en":"From Jylgyn, Keng-Kol, and Talas,"},{"id":"semetey-2-2013:p1272:b003:l014","ordinal":283585,"en":"The yellow-ridged passes were lost."},{"id":"semetey-2-2013:p1272:b003:l015","ordinal":283586,"en":"Semetey, defender of the people—"},{"id":"semetey-2-2013:p1272:b003:l016","ordinal":283587,"en":"My lionhearted uncle departed from the Kyrgyz."},{"id":"semetey-2-2013:p1272:b003:l017","ordinal":283588,"en":"Wandering in grief,"},{"id":"semetey-2-2013:p1272:b003:l018","ordinal":283589,"en":"Parted from my khan and lion of an uncle,"},{"id":"semetey-2-2013:p1272:b003:l019","ordinal":283590,"en":"My two eyes dart about,"},{"id":"semetey-2-2013:p1272:b003:l020","ordinal":283591,"en":"My two legs hang limp."},{"id":"semetey-2-2013:p1272:b003:l021","ordinal":283592,"en":"My strength exhausted, my vigor gone,"},{"id":"semetey-2-2013:p1272:b003:l022","ordinal":283593,"en":"Dark blood drains from my body."},{"id":"semetey-2-2013:p1272:b003:l023","ordinal":283594,"en":"The face of the world has turned to snow;"},{"id":"semetey-2-2013:p1272:b003:l024","ordinal":283595,"en":"My courage fails and my heart burns."},{"id":"semetey-2-2013:p1272:b003:l025","ordinal":283596,"en":"My bones gone slack, I cannot walk;"},{"id":"semetey-2-2013:p1272:b003:l026","ordinal":283597,"en":"There is no hollow where I may hide."},{"id":"semetey-2-2013:p1272:b003:l027","ordinal":283598,"en":"My poor soul burns and feels confined;"},{"id":"semetey-2-2013:p1272:b003:l028","ordinal":283599,"en":"I find no pass by which to flee,"},{"id":"semetey-2-2013:p1272:b003:l029","ordinal":283600,"en":"No refuge where I may shelter—"},{"id":"semetey-2-2013:p1272:b003:l030","ordinal":283601,"en":"Such torment Külchoro endured."},{"id":"semetey-2-2013:p1272:b003:l031","ordinal":283602,"en":"Clouds covered the sky;"},{"id":"semetey-2-2013:p1272:b003:l032","ordinal":283603,"en":"Sixty calamities came at once."},{"id":"semetey-2-2013:p1272:b003:l033","ordinal":283604,"en":"He limped along, sparing himself,"},{"id":"semetey-2-2013:p1272:b003:l034","ordinal":283605,"en":"Leaning upon his father’s legacy,"},{"id":"semetey-2-2013:p1272:b003:l035","ordinal":283606,"en":"The long matchlock rifle."},{"id":"semetey-2-2013:p1272:b003:l036","ordinal":283607,"en":"Early prophecies had come true too late;"},{"id":"semetey-2-2013:p1272:b003:l037","ordinal":283608,"en":"Eager to end his wretched life,"},{"id":"semetey-2-2013:p1272:b003:l038","ordinal":283609,"en":"His eyes stared wide."},{"id":"semetey-2-2013:p1272:b003:l039","ordinal":283610,"en":"He sobbed, crying, “My uncle!”"},{"id":"semetey-2-2013:p1272:b004:l001","ordinal":283611,"en":"And, “My forefather Manas, long departed!”"},{"id":"semetey-2-2013:p1272:b004:l002","ordinal":283612,"en":"While your beloved one stood thus,"},{"id":"semetey-2-2013:p1272:b004:l003","ordinal":283613,"en":"If only you had mounted Buurul and made him rear,"},{"id":"semetey-2-2013:p1272:b004:l004","ordinal":283614,"en":"Spurring him into a frenzy,"},{"id":"semetey-2-2013:p1272:b004:l005","ordinal":283615,"en":"Raging like a mountain torrent,"},{"id":"semetey-2-2013:p1272:b004:l006","ordinal":283616,"en":"With the bearing of a mountain lion,"},{"id":"semetey-2-2013:p1272:b004:l007","ordinal":283617,"en":"Dark-backed and blue-flanked—"},{"id":"semetey-2-2013:p1272:b004:l008","ordinal":283618,"en":"If only my lionhearted uncle"},{"id":"semetey-2-2013:p1272:b004:l009","ordinal":283619,"en":"Had watched while the Jediger pressed me,"},{"id":"semetey-2-2013:p1272:b004:l010","ordinal":283620,"en":"While they inflicted this disgrace,"},{"id":"semetey-2-2013:p1272:b004:l011","ordinal":283621,"en":"While my dear uncle looked on,"},{"id":"semetey-2-2013:p1272:b004:l012","ordinal":283622,"en":"Then let the vast black host of Jediger"},{"id":"semetey-2-2013:p1272:b004:l013","ordinal":283623,"en":"Have tried to shame me so!"},{"id":"semetey-2-2013:p1272:b004:l014","ordinal":283624,"en":"Mounted on the horse Aisarala,"},{"id":"semetey-2-2013:p1272:b004:l015","ordinal":283625,"en":"Carrying a spear without a tassel,"},{"id":"semetey-2-2013:p1272:b004:l016","ordinal":283626,"en":"Calmly filled with fury,"},{"id":"semetey-2-2013:p1272:b004:l017","ordinal":283627,"en":"A scabbardless sword at his waist,"},{"id":"semetey-2-2013:p1272:b004:l018","ordinal":283628,"en":"Saying, “I shall stand beside the lone warrior,”"},{"id":"semetey-2-2013:p1272:b004:l019","ordinal":283629,"en":"If only my lion father Almambet, gone to eternity,"},{"id":"semetey-2-2013:p1272:b004:l020","ordinal":283630,"en":"Had stood watching!"},{"id":"semetey-2-2013:p1272:b004:l021","ordinal":283631,"en":"Then let the vast black host of Jediger"},{"id":"semetey-2-2013:p1272:b004:l022","ordinal":283632,"en":"Have aimed their hatred and fired,"},{"id":"semetey-2-2013:p1272:b004:l023","ordinal":283633,"en":"And tried their tyranny!"},{"id":"semetey-2-2013:p1272:b004:l024","ordinal":283634,"en":"He seemed as vast as the blue sky;"},{"id":"semetey-2-2013:p1272:b004:l025","ordinal":283635,"en":"Not only men, but even beasts"},{"id":"semetey-2-2013:p1272:b004:l026","ordinal":283636,"en":"Were shaken at the sight of him."},{"id":"semetey-2-2013:p1272:b004:l027","ordinal":283637,"en":"His quiver was like the back of a rhinoceros,"},{"id":"semetey-2-2013:p1272:b004:l028","ordinal":283638,"en":"Its weight enough to crush a soul."},{"id":"semetey-2-2013:p1272:b004:l029","ordinal":283639,"en":"Throwing the whole world into alarm,"},{"id":"semetey-2-2013:p1272:b004:l030","ordinal":283640,"en":"He made the Kula horse beneath him"},{"id":"semetey-2-2013:p1272:b004:l031","ordinal":283641,"en":"Stride proudly."},{"id":"semetey-2-2013:p1272:b004:l032","ordinal":283642,"en":"He leveled his Akkelte,"},{"id":"semetey-2-2013:p1272:b004:l033","ordinal":283643,"en":"And felled every enemy he met."},{"id":"semetey-2-2013:p1272:b004:l034","ordinal":283644,"en":"He loaded ammunition upon the packhorse;"},{"id":"semetey-2-2013:p1272:b004:l035","ordinal":283645,"en":"When he came in wrath,"},{"id":"semetey-2-2013:p1272:b004:l036","ordinal":283646,"en":"He swept away the Chinese khagan’s hosts."},{"id":"semetey-2-2013:p1272:b004:l037","ordinal":283647,"en":"None who faced him defeated him;"},{"id":"semetey-2-2013:p1272:b004:l038","ordinal":283648,"en":"None who fought him escaped death."}]
