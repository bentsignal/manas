[{"id":"semetey-1-2013:p1303:b003:l012","ordinal":176641,"en":"My lone life has come under strain—"},{"id":"semetey-1-2013:p1303:b003:l013","ordinal":176642,"en":"Spirits, support me now!"},{"id":"semetey-1-2013:p1303:b003:l014","ordinal":176643,"en":"His heart torn apart,"},{"id":"semetey-1-2013:p1303:b003:l015","ordinal":176644,"en":"Wondering, “What recourse have we?”"},{"id":"semetey-1-2013:p1303:b003:l016","ordinal":176645,"en":"Tears poured from his eyes."},{"id":"semetey-1-2013:p1303:b003:l017","ordinal":176646,"en":"Grieving, weeping, and distraught,"},{"id":"semetey-1-2013:p1303:b003:l018","ordinal":176647,"en":"Pleading with the one God,"},{"id":"semetey-1-2013:p1303:b003:l019","ordinal":176648,"en":"Saying, “My Creator and Lord, protect me,”"},{"id":"semetey-1-2013:p1303:b003:l020","ordinal":176649,"en":"Külchoro lay there."},{"id":"semetey-1-2013:p1303:b003:l021","ordinal":176650,"en":"Chynkojo, son of Shygai,"},{"id":"semetey-1-2013:p1303:b003:l022","ordinal":176651,"en":"Khojo, resolute in his deeds,"},{"id":"semetey-1-2013:p1303:b003:l023","ordinal":176652,"en":"Rounded Mount Kasaba,"},{"id":"semetey-1-2013:p1303:b003:l024","ordinal":176653,"en":"His arms and armor fastened on."},{"id":"semetey-1-2013:p1303:b003:l025","ordinal":176654,"en":"The earth split with his thunder,"},{"id":"semetey-1-2013:p1303:b003:l026","ordinal":176655,"en":"And monster Khojo roared;"},{"id":"semetey-1-2013:p1303:b003:l027","ordinal":176656,"en":"Looming like Mount Opol,"},{"id":"semetey-1-2013:p1303:b003:l028","ordinal":176657,"en":"He had fastened on enough powder and shot"},{"id":"semetey-1-2013:p1303:b003:l029","ordinal":176658,"en":"For six months."},{"id":"semetey-1-2013:p1303:b003:l030","ordinal":176659,"en":"His courage cruel, his strength immense,"},{"id":"semetey-1-2013:p1303:b003:l031","ordinal":176660,"en":"Leopard Khojo then"},{"id":"semetey-1-2013:p1303:b003:l032","ordinal":176661,"en":"Leveled anyone who challenged him."},{"id":"semetey-1-2013:p1303:b003:l033","ordinal":176662,"en":"Leopard Khojo, the destroyer,"},{"id":"semetey-1-2013:p1303:b003:l034","ordinal":176663,"en":"Had the custom of drinking the blood"},{"id":"semetey-1-2013:p1303:b003:l035","ordinal":176664,"en":"Of every enemy who opposed him."},{"id":"semetey-1-2013:p1303:b003:l036","ordinal":176665,"en":"When his rage came boiling,"},{"id":"semetey-1-2013:p1303:b003:l037","ordinal":176666,"en":"Dark clouds could not obscure him;"},{"id":"semetey-1-2013:p1303:b003:l038","ordinal":176667,"en":"While his black stallion remained,"},{"id":"semetey-1-2013:p1303:b003:l039","ordinal":176668,"en":"No mortal could escape alive."},{"id":"semetey-1-2013:p1303:b004:l001","ordinal":176669,"en":"Foul mist and low mist"},{"id":"semetey-1-2013:p1303:b004:l002","ordinal":176670,"en":"He spread over the earth;"},{"id":"semetey-1-2013:p1303:b004:l003","ordinal":176671,"en":"Khojo, marking Buurul,"},{"id":"semetey-1-2013:p1303:b004:l004","ordinal":176672,"en":"Came storming up."},{"id":"semetey-1-2013:p1303:b004:l005","ordinal":176673,"en":"His eyes blazed like a boar’s;"},{"id":"semetey-1-2013:p1303:b004:l006","ordinal":176674,"en":"His great teeth, broad as a gate,"},{"id":"semetey-1-2013:p1303:b004:l007","ordinal":176675,"en":"Dear Khojo then"},{"id":"semetey-1-2013:p1303:b004:l008","ordinal":176676,"en":"Gnashed row upon row."},{"id":"semetey-1-2013:p1303:b004:l009","ordinal":176677,"en":"Chynkojo took"},{"id":"semetey-1-2013:p1303:b004:l010","ordinal":176678,"en":"The wide-mouthed secret bow"},{"id":"semetey-1-2013:p1303:b004:l011","ordinal":176679,"en":"And shot a hundred arrows with it."},{"id":"semetey-1-2013:p1303:b004:l012","ordinal":176680,"en":"He had a golden bow beside him;"},{"id":"semetey-1-2013:p1303:b004:l013","ordinal":176681,"en":"And leopard Khojo"},{"id":"semetey-1-2013:p1303:b004:l014","ordinal":176682,"en":"Shot a hundred arrows with that too."},{"id":"semetey-1-2013:p1303:b004:l015","ordinal":176683,"en":"An eleven-charge ochogor—"},{"id":"semetey-1-2013:p1303:b004:l016","ordinal":176684,"en":"Chynkojo was no easy foe;"},{"id":"semetey-1-2013:p1303:b004:l017","ordinal":176685,"en":"Taking aim, he fired a hundred shots."},{"id":"semetey-1-2013:p1303:b004:l018","ordinal":176686,"en":"The white gun at his shoulder"},{"id":"semetey-1-2013:p1303:b004:l019","ordinal":176687,"en":"He took and fired a hundred shots."},{"id":"semetey-1-2013:p1303:b004:l020","ordinal":176688,"en":"That leopard Khojo"},{"id":"semetey-1-2013:p1303:b004:l021","ordinal":176689,"en":"Drew his bow like pouring rain"},{"id":"semetey-1-2013:p1303:b004:l022","ordinal":176690,"en":"And fired bullets like hail."},{"id":"semetey-1-2013:p1303:b004:l023","ordinal":176691,"en":"Khan Khojo grew furious;"},{"id":"semetey-1-2013:p1303:b004:l024","ordinal":176692,"en":"As though black doom had struck his wife,"},{"id":"semetey-1-2013:p1303:b004:l025","ordinal":176693,"en":"Khojo lashed his horse."},{"id":"semetey-1-2013:p1303:b004:l026","ordinal":176694,"en":"His bullets streamed like hail;"},{"id":"semetey-1-2013:p1303:b004:l027","ordinal":176695,"en":"Külchoro then lay"},{"id":"semetey-1-2013:p1303:b004:l028","ordinal":176696,"en":"Sheltered behind Taibuurul."},{"id":"semetey-1-2013:p1303:b004:l029","ordinal":176697,"en":"As though ready to swallow him,"},{"id":"semetey-1-2013:p1303:b004:l030","ordinal":176698,"en":"Khojo came on in distress;"},{"id":"semetey-1-2013:p1303:b004:l031","ordinal":176699,"en":"Külchoro lay there"},{"id":"semetey-1-2013:p1303:b004:l032","ordinal":176700,"en":"Pleading with the one God."},{"id":"semetey-1-2013:p1303:b004:l033","ordinal":176701,"en":"From the sky, pale clouds split apart;"},{"id":"semetey-1-2013:p1303:b004:l034","ordinal":176702,"en":"With no prince visible upon him,"},{"id":"semetey-1-2013:p1303:b004:l035","ordinal":176703,"en":"Taibuurul stood in view."},{"id":"semetey-1-2013:p1303:b004:l036","ordinal":176704,"en":"When Khojo saw Taibuurul,"},{"id":"semetey-1-2013:p1303:b004:l037","ordinal":176705,"en":"He exulted wildly,"},{"id":"semetey-1-2013:p1303:b004:l038","ordinal":176706,"en":"And now raged in frenzy."},{"id":"semetey-1-2013:p1303:b004:l039","ordinal":176707,"en":"The orphaned son of Manas—"},{"id":"semetey-1-2013:p1304:b003:l001","ordinal":176708,"en":"The wretched soul formed like a tiger—"},{"id":"semetey-1-2013:p1304:b003:l002","ordinal":176709,"en":"It seems I have overthrown him."},{"id":"semetey-1-2013:p1304:b003:l003","ordinal":176710,"en":"The dear soul formed like a boar—"},{"id":"semetey-1-2013:p1304:b003:l004","ordinal":176711,"en":"It seems I have cut him down."},{"id":"semetey-1-2013:p1304:b003:l005","ordinal":176712,"en":"Buurul, whom they would not give when asked—"},{"id":"semetey-1-2013:p1304:b003:l006","ordinal":176713,"en":"I shall cast a cold lasso over him;"},{"id":"semetey-1-2013:p1304:b003:l007","ordinal":176714,"en":"Chürök, whom I have long desired,"},{"id":"semetey-1-2013:p1304:b003:l008","ordinal":176715,"en":"I shall take for myself alone."},{"id":"semetey-1-2013:p1304:b003:l009","ordinal":176716,"en":"Bringing humiliation upon Afghanistan,"},{"id":"semetey-1-2013:p1304:b003:l010","ordinal":176717,"en":"I shall gather khojas and mullahs;"},{"id":"semetey-1-2013:p1304:b003:l011","ordinal":176718,"en":"Chürök, daughter of Akun,"},{"id":"semetey-1-2013:p1304:b003:l012","ordinal":176719,"en":"I shall take as wife for myself."},{"id":"semetey-1-2013:p1304:b003:l013","ordinal":176720,"en":"I shall not accept what they say;"},{"id":"semetey-1-2013:p1304:b003:l014","ordinal":176721,"en":"To the accursed Toltoy,"},{"id":"semetey-1-2013:p1304:b003:l015","ordinal":176722,"en":"I shall not give Aychürök."},{"id":"semetey-1-2013:p1304:b003:l016","ordinal":176723,"en":"My wrath rose and I stiffened;"},{"id":"semetey-1-2013:p1304:b003:l017","ordinal":176724,"en":"The orphan son of Manas—"},{"id":"semetey-1-2013:p1304:b003:l018","ordinal":176725,"en":"I shall seize his treasury."},{"id":"semetey-1-2013:p1304:b003:l019","ordinal":176726,"en":"Burning their goods,"},{"id":"semetey-1-2013:p1304:b003:l020","ordinal":176727,"en":"I shall seize them and gouge out their eyes;"},{"id":"semetey-1-2013:p1304:b003:l021","ordinal":176728,"en":"The slaves left from the companions—"},{"id":"semetey-1-2013:p1304:b003:l022","ordinal":176729,"en":"I shall bind and take Bakai."},{"id":"semetey-1-2013:p1304:b003:l023","ordinal":176730,"en":"Dragging him along the road,"},{"id":"semetey-1-2013:p1304:b003:l024","ordinal":176731,"en":"I shall slaughter him as a sacrifice."},{"id":"semetey-1-2013:p1304:b003:l025","ordinal":176732,"en":"The accursed Akun,"},{"id":"semetey-1-2013:p1304:b003:l026","ordinal":176733,"en":"The infidel who begrudged his daughter—"},{"id":"semetey-1-2013:p1304:b003:l027","ordinal":176734,"en":"I shall do with him as I please,"},{"id":"semetey-1-2013:p1304:b003:l028","ordinal":176735,"en":"And slaughter all his people."},{"id":"semetey-1-2013:p1304:b003:l029","ordinal":176736,"en":"I shall leave them like a deserted camp;"},{"id":"semetey-1-2013:p1304:b003:l030","ordinal":176737,"en":"Thus shall I reach their root,"},{"id":"semetey-1-2013:p1304:b003:l031","ordinal":176738,"en":"And slaughter them without leaving one."},{"id":"semetey-1-2013:p1304:b003:l032","ordinal":176739,"en":"Taylak, Bakai's wretched son,"},{"id":"semetey-1-2013:p1304:b003:l033","ordinal":176740,"en":"Taylak, the worst dog of all—"},{"id":"semetey-1-2013:p1304:b003:l034","ordinal":176741,"en":"I shall cut his hamstrings"},{"id":"semetey-1-2013:p1304:b003:l035","ordinal":176742,"en":"And make him a horse herder."},{"id":"semetey-1-2013:p1304:b003:l036","ordinal":176743,"en":"Kalyk, son of Sary Khan—"},{"id":"semetey-1-2013:p1304:b003:l037","ordinal":176744,"en":"I shall put a bridle around his neck;"},{"id":"semetey-1-2013:p1304:b003:l038","ordinal":176745,"en":"Saying, ‘He is my captured slave,’"},{"id":"semetey-1-2013:p1304:b003:l039","ordinal":176746,"en":"I shall sell him to the Kyzylbash people."},{"id":"semetey-1-2013:p1304:b004:l001","ordinal":176747,"en":"I shall destroy and seize them all;"},{"id":"semetey-1-2013:p1304:b004:l002","ordinal":176748,"en":"Now that the mighty gray wolf is dead,"},{"id":"semetey-1-2013:p1304:b004:l003","ordinal":176749,"en":"The strength has left them all."},{"id":"semetey-1-2013:p1304:b004:l004","ordinal":176750,"en":"Bloodthirsty Semetey has died;"},{"id":"semetey-1-2013:p1304:b004:l005","ordinal":176751,"en":"My own eyes behold his death."},{"id":"semetey-1-2013:p1304:b004:l006","ordinal":176752,"en":"Taybuurul came out with neck stretched,"},{"id":"semetey-1-2013:p1304:b004:l007","ordinal":176753,"en":"Distraught, dragging his reins;"},{"id":"semetey-1-2013:p1304:b004:l008","ordinal":176754,"en":"Your bloodthirsty hero's ak-olpok armor"},{"id":"semetey-1-2013:p1304:b004:l009","ordinal":176755,"en":"Hung askew from the saddle bow."},{"id":"semetey-1-2013:p1304:b004:l010","ordinal":176756,"en":"Saying, ‘My eyes have seen his death,’"},{"id":"semetey-1-2013:p1304:b004:l011","ordinal":176757,"en":"Saying, ‘His horse has fled back,’"},{"id":"semetey-1-2013:p1304:b004:l012","ordinal":176758,"en":"Saying, ‘God has granted my wish.’"},{"id":"semetey-1-2013:p1304:b004:l013","ordinal":176759,"en":"Shouting, ‘Baabedin!’"},{"id":"semetey-1-2013:p1304:b004:l014","ordinal":176760,"en":"Chynkojo flailed his arms,"},{"id":"semetey-1-2013:p1304:b004:l015","ordinal":176761,"en":"And raised the battle cry of Shygai."},{"id":"semetey-1-2013:p1304:b004:l016","ordinal":176762,"en":"Raging, he spurred ahead;"},{"id":"semetey-1-2013:p1304:b004:l017","ordinal":176763,"en":"“Ah, God has granted it!” he cried,"},{"id":"semetey-1-2013:p1304:b004:l018","ordinal":176764,"en":"And all his weapons"},{"id":"semetey-1-2013:p1304:b004:l019","ordinal":176765,"en":"He hurled toward Taybuurul."},{"id":"semetey-1-2013:p1304:b004:l020","ordinal":176766,"en":"Circling on the black horse,"},{"id":"semetey-1-2013:p1304:b004:l021","ordinal":176767,"en":"He now came within half a target's range."},{"id":"semetey-1-2013:p1304:b004:l022","ordinal":176768,"en":"Its fastenings were nine;"},{"id":"semetey-1-2013:p1304:b004:l023","ordinal":176769,"en":"He undid the fastenings."},{"id":"semetey-1-2013:p1304:b004:l024","ordinal":176770,"en":"Its buttons were nine;"},{"id":"semetey-1-2013:p1304:b004:l025","ordinal":176771,"en":"He undid the buttons."},{"id":"semetey-1-2013:p1304:b004:l026","ordinal":176772,"en":"The khoja set his mind"},{"id":"semetey-1-2013:p1304:b004:l027","ordinal":176773,"en":"On quickly dismounting,"},{"id":"semetey-1-2013:p1304:b004:l028","ordinal":176774,"en":"To seize as plunder"},{"id":"semetey-1-2013:p1304:b004:l029","ordinal":176775,"en":"The Buurul horse that had emerged frisking."},{"id":"semetey-1-2013:p1304:b004:l030","ordinal":176776,"en":"Girding on his Arkesken sword,"},{"id":"semetey-1-2013:p1304:b004:l031","ordinal":176777,"en":"Chynkojo, rejoicing,"},{"id":"semetey-1-2013:p1304:b004:l032","ordinal":176778,"en":"Came drawing near."},{"id":"semetey-1-2013:p1304:b004:l033","ordinal":176779,"en":"Circling within half a target's range,"},{"id":"semetey-1-2013:p1304:b004:l034","ordinal":176780,"en":"The clumsy khoja lurched,"},{"id":"semetey-1-2013:p1304:b004:l035","ordinal":176781,"en":"His two coat-tails flapping."},{"id":"semetey-1-2013:p1304:b004:l036","ordinal":176782,"en":"When the khoja came close,"},{"id":"semetey-1-2013:p1304:b004:l037","ordinal":176783,"en":"The companion's heart was stirred;"},{"id":"semetey-1-2013:p1304:b004:l038","ordinal":176784,"en":"The flank of his black horse,"},{"id":"semetey-1-2013:p1304:b004:l039","ordinal":176785,"en":"Its wing in flight,"},{"id":"semetey-1-2013:p1305:b003:l001","ordinal":176786,"en":"Was clearly and plainly visible."},{"id":"semetey-1-2013:p1305:b003:l002","ordinal":176787,"en":"“That is one edge of the wing;"},{"id":"semetey-1-2013:p1305:b003:l003","ordinal":176788,"en":"If Akkelte strikes farther over,"},{"id":"semetey-1-2013:p1305:b003:l004","ordinal":176789,"en":"That is the lower edge of the lung.”"},{"id":"semetey-1-2013:p1305:b003:l005","ordinal":176790,"en":"Pure in marksmanship,"},{"id":"semetey-1-2013:p1305:b003:l006","ordinal":176791,"en":"The ready gun-rest at hand,"},{"id":"semetey-1-2013:p1305:b003:l007","ordinal":176792,"en":"Külchoro flicked it into place;"},{"id":"semetey-1-2013:p1305:b003:l008","ordinal":176793,"en":"Akkelte went to work."},{"id":"semetey-1-2013:p1305:b003:l009","ordinal":176794,"en":"The Akkelte gun cracked;"},{"id":"semetey-1-2013:p1305:b003:l010","ordinal":176795,"en":"Though your supporters be countless,"},{"id":"semetey-1-2013:p1305:b003:l011","ordinal":176796,"en":"The valiant khoja dropped flat."},{"id":"semetey-1-2013:p1305:b003:l012","ordinal":176797,"en":"The bullet fired at his middle"},{"id":"semetey-1-2013:p1305:b003:l013","ordinal":176798,"en":"Grazed through his wing,"},{"id":"semetey-1-2013:p1305:b003:l014","ordinal":176799,"en":"Entered farther into him,"},{"id":"semetey-1-2013:p1305:b003:l015","ordinal":176800,"en":"And shattered his lung."},{"id":"semetey-1-2013:p1305:b003:l016","ordinal":176801,"en":"From the dear valiant khoja,"},{"id":"semetey-1-2013:p1305:b003:l017","ordinal":176802,"en":"At the root of the thigh muscle,"},{"id":"semetey-1-2013:p1305:b003:l018","ordinal":176803,"en":"It tore away a span of flesh."},{"id":"semetey-1-2013:p1305:b003:l019","ordinal":176804,"en":"Chynkojo's black horse"},{"id":"semetey-1-2013:p1305:b003:l020","ordinal":176805,"en":"Wheeled around then,"},{"id":"semetey-1-2013:p1305:b003:l021","ordinal":176806,"en":"And he fell backward from it."},{"id":"semetey-1-2013:p1305:b003:l022","ordinal":176807,"en":"The khoja came screaming,"},{"id":"semetey-1-2013:p1305:b003:l023","ordinal":176808,"en":"Unable to find his bearings,"},{"id":"semetey-1-2013:p1305:b003:l024","ordinal":176809,"en":"Raising the battle cry of Shygai."},{"id":"semetey-1-2013:p1305:b003:l025","ordinal":176810,"en":"His voice reached God;"},{"id":"semetey-1-2013:p1305:b003:l026","ordinal":176811,"en":"Upon Külchoro"},{"id":"semetey-1-2013:p1305:b003:l027","ordinal":176812,"en":"He fell in a heap."},{"id":"semetey-1-2013:p1305:b003:l028","ordinal":176813,"en":"Külchoro, who had lain concealed,"},{"id":"semetey-1-2013:p1305:b003:l029","ordinal":176814,"en":"Roared in wrath,"},{"id":"semetey-1-2013:p1305:b003:l030","ordinal":176815,"en":"And stood looming there,"},{"id":"semetey-1-2013:p1305:b003:l031","ordinal":176816,"en":"Raising the battle cry of Manas."},{"id":"semetey-1-2013:p1305:b003:l032","ordinal":176817,"en":"Your orphan born of the hero"},{"id":"semetey-1-2013:p1305:b003:l033","ordinal":176818,"en":"Now reached Chynkojo."},{"id":"semetey-1-2013:p1305:b003:l034","ordinal":176819,"en":"Chynkojo, son of Shygai,"},{"id":"semetey-1-2013:p1305:b003:l035","ordinal":176820,"en":"The khoja whose deeds were bold—"},{"id":"semetey-1-2013:p1305:b003:l036","ordinal":176821,"en":"He and the companion"},{"id":"semetey-1-2013:p1305:b003:l037","ordinal":176822,"en":"Now seized each other by the collar."},{"id":"semetey-1-2013:p1305:b003:l038","ordinal":176823,"en":"They gripped each other's wrists"},{"id":"semetey-1-2013:p1305:b003:l039","ordinal":176824,"en":"And wrestled like champions."},{"id":"semetey-1-2013:p1305:b005:l001","ordinal":176825,"en":"Seizing and twisting him by the collar,"},{"id":"semetey-1-2013:p1305:b005:l002","ordinal":176826,"en":"Outmaneuvering the bow-bearing khoja,"},{"id":"semetey-1-2013:p1305:b005:l003","ordinal":176827,"en":"He lifted and dashed him to the ground."},{"id":"semetey-1-2013:p1305:b005:l004","ordinal":176828,"en":"The reeking khoja's"},{"id":"semetey-1-2013:p1305:b005:l005","ordinal":176829,"en":"Mustache he tore out and flung away;"},{"id":"semetey-1-2013:p1305:b005:l006","ordinal":176830,"en":"His beard he ripped out and scattered."},{"id":"semetey-1-2013:p1305:b005:l007","ordinal":176831,"en":"He pummeled him again and again;"},{"id":"semetey-1-2013:p1305:b005:l008","ordinal":176832,"en":"Black blood leaving his mouth,"},{"id":"semetey-1-2013:p1305:b005:l009","ordinal":176833,"en":"Yellow bile followed behind it."},{"id":"semetey-1-2013:p1305:b005:l010","ordinal":176834,"en":"The prince burst from the cave,"},{"id":"semetey-1-2013:p1305:b005:l011","ordinal":176835,"en":"Running with long strides."},{"id":"semetey-1-2013:p1305:b005:l012","ordinal":176836,"en":"Shouting, ‘Baabedin!’"},{"id":"semetey-1-2013:p1305:b005:l013","ordinal":176837,"en":"And rushing in wrath,"},{"id":"semetey-1-2013:p1305:b005:l014","ordinal":176838,"en":"The lion came,"},{"id":"semetey-1-2013:p1305:b005:l015","ordinal":176839,"en":"Pleading with Külchoro:"},{"id":"semetey-1-2013:p1305:b005:l016","ordinal":176840,"en":"“I tended a brave man and won a brave man's fortune;"},{"id":"semetey-1-2013:p1305:b005:l017","ordinal":176841,"en":"I have now seen its benefit."},{"id":"semetey-1-2013:p1305:b005:l018","ordinal":176842,"en":"My dear Külchoro,"},{"id":"semetey-1-2013:p1305:b005:l019","ordinal":176843,"en":"Blessed am I with a kinsman like you."},{"id":"semetey-1-2013:p1305:b005:l020","ordinal":176844,"en":"I tended an argamak and won a horse's fortune;"},{"id":"semetey-1-2013:p1305:b005:l021","ordinal":176845,"en":"My dear one, blessed am I"},{"id":"semetey-1-2013:p1305:b005:l022","ordinal":176846,"en":"With a charger like Taybuurul."},{"id":"semetey-1-2013:p1305:b005:l023","ordinal":176847,"en":"For the boy who served as my support,"},{"id":"semetey-1-2013:p1305:b005:l024","ordinal":176848,"en":"My dear Külchoro,"},{"id":"semetey-1-2013:p1305:b005:l025","ordinal":176849,"en":"May your bloodthirsty lord be the sacrifice!"},{"id":"semetey-1-2013:p1305:b005:l026","ordinal":176850,"en":"You rekindled an extinguished fire;"},{"id":"semetey-1-2013:p1305:b005:l027","ordinal":176851,"en":"You revived a lifeless soul;"},{"id":"semetey-1-2013:p1305:b005:l028","ordinal":176852,"en":"You joined what had been severed;"},{"id":"semetey-1-2013:p1305:b005:l029","ordinal":176853,"en":"You gathered what had been scattered."},{"id":"semetey-1-2013:p1305:b005:l030","ordinal":176854,"en":"He does not tire when ridden for six months—"},{"id":"semetey-1-2013:p1305:b005:l031","ordinal":176855,"en":"My charger, noble Buurul."},{"id":"semetey-1-2013:p1305:b005:l032","ordinal":176856,"en":"We kicked each other like foals,"},{"id":"semetey-1-2013:p1305:b005:l033","ordinal":176857,"en":"And struggled together at the breast—"},{"id":"semetey-1-2013:p1305:b005:l034","ordinal":176858,"en":"Külchoro is my own kinsman."},{"id":"semetey-1-2013:p1305:b005:l035","ordinal":176859,"en":"My falcon granted upon my brow,"},{"id":"semetey-1-2013:p1305:b005:l036","ordinal":176860,"en":"Let me take your calamity upon myself,"},{"id":"semetey-1-2013:p1305:b005:l037","ordinal":176861,"en":"My mirror who serves as my support!"},{"id":"semetey-1-2013:p1305:b005:l038","ordinal":176862,"en":"Do not kill the vile man;"},{"id":"semetey-1-2013:p1305:b005:l039","ordinal":176863,"en":"Let no one say that elder and younger brother"},{"id":"semetey-1-2013:p1306:b003:l001","ordinal":176864,"en":"Joined two against one to kill him;"},{"id":"semetey-1-2013:p1306:b003:l002","ordinal":176865,"en":"On the day of the final reckoning,"},{"id":"semetey-1-2013:p1306:b003:l003","ordinal":176866,"en":"Let no one say elder and younger brother united"},{"id":"semetey-1-2013:p1306:b003:l004","ordinal":176867,"en":"And singled him out to kill him!"},{"id":"semetey-1-2013:p1306:b003:l005","ordinal":176868,"en":"May the punishing God not strike us;"},{"id":"semetey-1-2013:p1306:b003:l006","ordinal":176869,"en":"On Judgment Day,"},{"id":"semetey-1-2013:p1306:b003:l007","ordinal":176870,"en":"May this swine not stand demanding his blood-price!"},{"id":"semetey-1-2013:p1306:b003:l008","ordinal":176871,"en":"One day we too shall die;"},{"id":"semetey-1-2013:p1306:b003:l009","ordinal":176872,"en":"When he demands his blood-price then,"},{"id":"semetey-1-2013:p1306:b003:l010","ordinal":176873,"en":"If they say we went two against one,"},{"id":"semetey-1-2013:p1306:b003:l011","ordinal":176874,"en":"What answer shall we give?”"},{"id":"semetey-1-2013:p1306:b003:l012","ordinal":176875,"en":"Heeding the sultan's words,"},{"id":"semetey-1-2013:p1306:b003:l013","ordinal":176876,"en":"Külchoro then"},{"id":"semetey-1-2013:p1306:b003:l014","ordinal":176877,"en":"Released the khoja."},{"id":"semetey-1-2013:p1306:b003:l015","ordinal":176878,"en":"“Chynkojo, son of Shygai,"},{"id":"semetey-1-2013:p1306:b003:l016","ordinal":176879,"en":"Our road lies together through the passes;"},{"id":"semetey-1-2013:p1306:b003:l017","ordinal":176880,"en":"Our roots share one nest."},{"id":"semetey-1-2013:p1306:b003:l018","ordinal":176881,"en":"Did I steal your Ala horse,"},{"id":"semetey-1-2013:p1306:b003:l019","ordinal":176882,"en":"That you should shoot without mercy"},{"id":"semetey-1-2013:p1306:b003:l020","ordinal":176883,"en":"And take an entrusted life?"},{"id":"semetey-1-2013:p1306:b003:l021","ordinal":176884,"en":"Did I scatter your white silver in the corners?"},{"id":"semetey-1-2013:p1306:b003:l022","ordinal":176885,"en":"Did I flee while driving off your kulan?"},{"id":"semetey-1-2013:p1306:b003:l023","ordinal":176886,"en":"You raging fool, khoja,"},{"id":"semetey-1-2013:p1306:b003:l024","ordinal":176887,"en":"Did I spill your goods from the saddlebags?"},{"id":"semetey-1-2013:p1306:b003:l025","ordinal":176888,"en":"When I came to Talas,"},{"id":"semetey-1-2013:p1306:b003:l026","ordinal":176889,"en":"Did I speak any such word?"},{"id":"semetey-1-2013:p1306:b003:l027","ordinal":176890,"en":"Curse your father's grave, Chynkojo—"},{"id":"semetey-1-2013:p1306:b003:l028","ordinal":176891,"en":"Did I seize and consume what was owed you?"},{"id":"semetey-1-2013:p1306:b003:l029","ordinal":176892,"en":"If I bear black thoughts without a crime,"},{"id":"semetey-1-2013:p1306:b003:l030","ordinal":176893,"en":"May the one Creator strike me!"},{"id":"semetey-1-2013:p1306:b003:l031","ordinal":176894,"en":"You brought crisis while I went peacefully;"},{"id":"semetey-1-2013:p1306:b003:l032","ordinal":176895,"en":"May calamity strike you, accursed khoja!”"},{"id":"semetey-1-2013:p1306:b003:l033","ordinal":176896,"en":"Without swinging a hand at the khoja,"}]
