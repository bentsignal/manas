[{"id":"manas-2010:p0793:b001:l012","ordinal":35073,"en":"That a person's head grew dazed."},{"id":"manas-2010:p0793:b001:l013","ordinal":35074,"en":"Among creatures no soul had seen,"},{"id":"manas-2010:p0793:b001:l014","ordinal":35075,"en":"All the strangest were there."},{"id":"manas-2010:p0793:b001:l015","ordinal":35076,"en":"It had no wings but had legs;"},{"id":"manas-2010:p0793:b001:l016","ordinal":35077,"en":"They saw a bird as large as a camel."},{"id":"manas-2010:p0793:b001:l017","ordinal":35078,"en":"Upon the unpeopled, open plain,"},{"id":"manas-2010:p0793:b001:l018","ordinal":35079,"en":"Every living creature"},{"id":"manas-2010:p0793:b001:l019","ordinal":35080,"en":"Had grown mighty."},{"id":"manas-2010:p0793:b001:l020","ordinal":35081,"en":"Fallen walnuts filled the ravine;"},{"id":"manas-2010:p0793:b001:l021","ordinal":35082,"en":"Rotten apples had turned to manure."},{"id":"manas-2010:p0793:b001:l022","ordinal":35083,"en":"Painted spears of hard, keen steel"},{"id":"manas-2010:p0793:b001:l023","ordinal":35084,"en":"Swayed as they went."},{"id":"manas-2010:p0793:b001:l024","ordinal":35085,"en":"The forty champions who could ravage peoples,"},{"id":"manas-2010:p0793:b001:l025","ordinal":35086,"en":"Marveling at the plain,"},{"id":"manas-2010:p0793:b001:l026","ordinal":35087,"en":"Went on in delight."},{"id":"manas-2010:p0793:b001:l027","ordinal":35088,"en":"Wild bull-beasts, wild camel-beasts,"},{"id":"manas-2010:p0793:b001:l028","ordinal":35089,"en":"When they looked at its hills,"},{"id":"manas-2010:p0793:b001:l029","ordinal":35090,"en":"Upright wild creatures fled like people."},{"id":"manas-2010:p0793:b001:l030","ordinal":35091,"en":"Yraman's son Yrchy,"},{"id":"manas-2010:p0793:b001:l031","ordinal":35092,"en":"Beside lion Manas,"},{"id":"manas-2010:p0793:b001:l032","ordinal":35093,"en":"Went singing on their way."},{"id":"manas-2010:p0793:b001:l033","ordinal":35094,"en":"‘With our lion blessed by Kydyr,"},{"id":"manas-2010:p0793:b001:l034","ordinal":35095,"en":"We have seen many wonders,’ they said."},{"id":"manas-2010:p0793:b001:l035","ordinal":35096,"en":"Khan Manas's forty champions"},{"id":"manas-2010:p0793:b001:l036","ordinal":35097,"en":"Went on in delight."},{"id":"manas-2010:p0793:b001:l037","ordinal":35098,"en":"As they journeyed across the open plain,"},{"id":"manas-2010:p0793:b001:l038","ordinal":35099,"en":"The horses' brows brightened."},{"id":"manas-2010:p0793:b001:l039","ordinal":35100,"en":"Then in the empty plain,"},{"id":"manas-2010:p0793:b001:l040","ordinal":35101,"en":"The heroes' longing found release."},{"id":"manas-2010:p0793:b001:l041","ordinal":35102,"en":"Crossing scattered mountain passes,"},{"id":"manas-2010:p0793:b001:l042","ordinal":35103,"en":"Treading a strange land of plains,"},{"id":"manas-2010:p0794:b001:l001","ordinal":35104,"en":"Where the hooves struck,"},{"id":"manas-2010:p0794:b001:l002","ordinal":35105,"en":"All the empty ground"},{"id":"manas-2010:p0794:b001:l003","ordinal":35106,"en":"Was hollowed out like storage pits."},{"id":"manas-2010:p0794:b001:l004","ordinal":35107,"en":"The plains beneath the hooves"},{"id":"manas-2010:p0794:b001:l005","ordinal":35108,"en":"Were torn into a long swath."},{"id":"manas-2010:p0794:b001:l006","ordinal":35109,"en":"As the day drew toward evening,"},{"id":"manas-2010:p0794:b001:l007","ordinal":35110,"en":"In the cool of late afternoon,"},{"id":"manas-2010:p0794:b001:l008","ordinal":35111,"en":"How could the heroes hold back?"},{"id":"manas-2010:p0794:b001:l009","ordinal":35112,"en":"With no mountain the size of a knucklebone,"},{"id":"manas-2010:p0794:b001:l010","ordinal":35113,"en":"No gully the size of a saddlecloth,"},{"id":"manas-2010:p0794:b001:l011","ordinal":35114,"en":"The yellow plain like the moon,"},{"id":"manas-2010:p0794:b001:l012","ordinal":35115,"en":"They now drew near and reached."},{"id":"manas-2010:p0794:b001:l013","ordinal":35116,"en":"The level ground covered with fescue,"},{"id":"manas-2010:p0794:b001:l014","ordinal":35117,"en":"The slopes with their high ridges,"},{"id":"manas-2010:p0794:b001:l015","ordinal":35118,"en":"Where stones blackened and earth burned,"},{"id":"manas-2010:p0794:b001:l016","ordinal":35119,"en":"What mortal could endure to go there?"},{"id":"manas-2010:p0794:b001:l017","ordinal":35120,"en":"The heroes arrived in their excitement,"},{"id":"manas-2010:p0794:b001:l018","ordinal":35121,"en":"Coming upon the empty plain."},{"id":"manas-2010:p0794:b001:l019","ordinal":35122,"en":"Beyond that plain,"},{"id":"manas-2010:p0794:b001:l020","ordinal":35123,"en":"On this side of Üzgültük,"},{"id":"manas-2010:p0794:b001:l021","ordinal":35124,"en":"Uneven hills appeared."},{"id":"manas-2010:p0794:b001:l022","ordinal":35125,"en":"When he saw that rugged ground,"},{"id":"manas-2010:p0794:b001:l023","ordinal":35126,"en":"Noble Bakay then"},{"id":"manas-2010:p0794:b001:l024","ordinal":35127,"en":"Turned his attention toward it."},{"id":"manas-2010:p0794:b001:l025","ordinal":35128,"en":"Staring hard, he began to speak:"},{"id":"manas-2010:p0794:b001:l026","ordinal":35129,"en":"‘Ah, my Manas,’ he said."},{"id":"manas-2010:p0794:b001:l027","ordinal":35130,"en":"He makes known what is not known,"},{"id":"manas-2010:p0794:b001:l028","ordinal":35131,"en":"While his knowing head remains,"},{"id":"manas-2010:p0794:b001:l029","ordinal":35132,"en":"Learned Bakay the elder;"},{"id":"manas-2010:p0794:b001:l030","ordinal":35133,"en":"He makes understood what is not understood,"},{"id":"manas-2010:p0794:b001:l031","ordinal":35134,"en":"Falcon Bakay, the saint."},{"id":"manas-2010:p0794:b001:l032","ordinal":35135,"en":"His prince, wolf-maned Manas,"},{"id":"manas-2010:p0794:b001:l033","ordinal":35136,"en":"He had led along and made a hero."},{"id":"manas-2010:p0794:b001:l034","ordinal":35137,"en":"Lofty Bakay was that lion,"},{"id":"manas-2010:p0794:b001:l035","ordinal":35138,"en":"Who planted until he made a garden,"},{"id":"manas-2010:p0794:b001:l036","ordinal":35139,"en":"Who built until he made a house,"},{"id":"manas-2010:p0794:b001:l037","ordinal":35140,"en":"He was that honored hero."},{"id":"manas-2010:p0794:b001:l038","ordinal":35141,"en":"The forty champions were his followers;"},{"id":"manas-2010:p0794:b001:l039","ordinal":35142,"en":"Hero Manas was his companion."},{"id":"manas-2010:p0794:b001:l040","ordinal":35143,"en":"To Khan Shooruk's city,"},{"id":"manas-2010:p0794:b001:l041","ordinal":35144,"en":"That was where they had drawn near."},{"id":"manas-2010:p0794:b001:l042","ordinal":35145,"en":"Upon a hill like a skullcap,"},{"id":"manas-2010:p0795:b001:l001","ordinal":35146,"en":"He turned his gray wondrous steed's head,"},{"id":"manas-2010:p0795:b001:l002","ordinal":35147,"en":"And stopped to look."},{"id":"manas-2010:p0795:b001:l003","ordinal":35148,"en":"Roaring in his fury,"},{"id":"manas-2010:p0795:b001:l004","ordinal":35149,"en":"Manas and the forty champions,"},{"id":"manas-2010:p0795:b001:l005","ordinal":35150,"en":"He called them to him:"},{"id":"manas-2010:p0795:b001:l006","ordinal":35151,"en":"‘Valiant Manas, forty champions,"},{"id":"manas-2010:p0795:b001:l007","ordinal":35152,"en":"Have you seen what I have seen?"},{"id":"manas-2010:p0795:b001:l008","ordinal":35153,"en":"Have you sensed what I have sensed?’"},{"id":"manas-2010:p0795:b001:l009","ordinal":35154,"en":"All the forty champions"},{"id":"manas-2010:p0795:b001:l010","ordinal":35155,"en":"Said this to Khan Bakay:"},{"id":"manas-2010:p0795:b001:l011","ordinal":35156,"en":"‘To these wretched eyes"},{"id":"manas-2010:p0795:b001:l012","ordinal":35157,"en":"Nothing at all appears."},{"id":"manas-2010:p0795:b001:l013","ordinal":35158,"en":"We drank much water in the night;"},{"id":"manas-2010:p0795:b001:l014","ordinal":35159,"en":"Perhaps it has risen into our eyes."},{"id":"manas-2010:p0795:b001:l015","ordinal":35160,"en":"To these damned eyes"},{"id":"manas-2010:p0795:b001:l016","ordinal":35161,"en":"Nothing whatsoever appears."},{"id":"manas-2010:p0795:b001:l017","ordinal":35162,"en":"We drank water in the darkness;"},{"id":"manas-2010:p0795:b001:l018","ordinal":35163,"en":"Perhaps it has risen into our heads.’"},{"id":"manas-2010:p0795:b001:l019","ordinal":35164,"en":"The forty champions speaking thus,"},{"id":"manas-2010:p0795:b001:l020","ordinal":35165,"en":"Traveling across the open plain,"},{"id":"manas-2010:p0795:b001:l021","ordinal":35166,"en":"Traveling mostly by night,"},{"id":"manas-2010:p0795:b001:l022","ordinal":35167,"en":"Had perhaps grown dull-witted."},{"id":"manas-2010:p0795:b001:l023","ordinal":35168,"en":"‘Elder Bakay, tell us truly,"},{"id":"manas-2010:p0795:b001:l024","ordinal":35169,"en":"What have you learned?"},{"id":"manas-2010:p0795:b001:l025","ordinal":35170,"en":"What have you sensed?"},{"id":"manas-2010:p0795:b001:l026","ordinal":35171,"en":"Tell your thoughts, tell your secret;"},{"id":"manas-2010:p0795:b001:l027","ordinal":35172,"en":"Bakay blessed by Kydyr, tell us truly."},{"id":"manas-2010:p0795:b001:l028","ordinal":35173,"en":"Is there a pit dug out?"},{"id":"manas-2010:p0795:b001:l029","ordinal":35174,"en":"Is there boiling misery in store?"},{"id":"manas-2010:p0795:b001:l030","ordinal":35175,"en":"Emerging hunched from the flank,"},{"id":"manas-2010:p0795:b001:l031","ordinal":35176,"en":"Is an army surging upon us?"},{"id":"manas-2010:p0795:b001:l032","ordinal":35177,"en":"Are there gray rolling mountains?"},{"id":"manas-2010:p0795:b001:l033","ordinal":35178,"en":"Is there an immeasurably vast enemy?"},{"id":"manas-2010:p0795:b001:l034","ordinal":35179,"en":"Elder Bakay, heroic sultan,"},{"id":"manas-2010:p0795:b001:l035","ordinal":35180,"en":"This land's heat is terrible;"},{"id":"manas-2010:p0795:b001:l036","ordinal":35181,"en":"Its people are unbearable to behold."},{"id":"manas-2010:p0795:b001:l037","ordinal":35182,"en":"Horses with hair-filled tails"},{"id":"manas-2010:p0795:b001:l038","ordinal":35183,"en":"Cannot endure this land."},{"id":"manas-2010:p0795:b001:l039","ordinal":35184,"en":"If an enemy comes out to grapple,"},{"id":"manas-2010:p0795:b001:l040","ordinal":35185,"en":"Exert your mighty strength."},{"id":"manas-2010:p0795:b001:l041","ordinal":35186,"en":"If there is a grievously difficult matter,"},{"id":"manas-2010:p0795:b001:l042","ordinal":35187,"en":"Khan and elder Bakay, without delay,"},{"id":"manas-2010:p0796:b001:l001","ordinal":35188,"en":"Send word to us!"},{"id":"manas-2010:p0796:b001:l002","ordinal":35189,"en":"Let us go out to meet the clash."},{"id":"manas-2010:p0796:b001:l003","ordinal":35190,"en":"Whatever enemy it may be,"},{"id":"manas-2010:p0796:b001:l004","ordinal":35191,"en":"Khan and elder Bakay, let us hear."},{"id":"manas-2010:p0796:b001:l005","ordinal":35192,"en":"We warriors full of wrath,"},{"id":"manas-2010:p0796:b001:l006","ordinal":35193,"en":"Let us stand and show our strength,’"},{"id":"manas-2010:p0796:b001:l007","ordinal":35194,"en":"So said the forty champions,"},{"id":"manas-2010:p0796:b001:l008","ordinal":35195,"en":"And their aged leader Kyrgyl,"},{"id":"manas-2010:p0796:b001:l009","ordinal":35196,"en":"Raising an uproar now."},{"id":"manas-2010:p0796:b001:l010","ordinal":35197,"en":"All of them clamoring,"},{"id":"manas-2010:p0796:b001:l011","ordinal":35198,"en":"They raised a tumult now."},{"id":"manas-2010:p0796:b001:l012","ordinal":35199,"en":"Your elder, leopard Bakay,"},{"id":"manas-2010:p0796:b001:l013","ordinal":35200,"en":"Who could discern a distant form clearly,"},{"id":"manas-2010:p0796:b001:l014","ordinal":35201,"en":"Your saint, a falcon among mortals,"},{"id":"manas-2010:p0796:b001:l015","ordinal":35202,"en":"Your elder, leopard Bakay,"},{"id":"manas-2010:p0796:b001:l016","ordinal":35203,"en":"He was that blessed soul."},{"id":"manas-2010:p0796:b001:l017","ordinal":35204,"en":"Of six days' hardship ahead,"},{"id":"manas-2010:p0796:b001:l018","ordinal":35205,"en":"Who could know and speak at once,"},{"id":"manas-2010:p0796:b001:l019","ordinal":35206,"en":"He was that saintly soul."},{"id":"manas-2010:p0796:b001:l020","ordinal":35207,"en":"Readying himself like a goshawk,"},{"id":"manas-2010:p0796:b001:l021","ordinal":35208,"en":"To your dear elder Bakay"},{"id":"manas-2010:p0796:b001:l022","ordinal":35209,"en":"Wisdom came from the unseen."},{"id":"manas-2010:p0796:b001:l023","ordinal":35210,"en":"Crying out like a young hawk,"},{"id":"manas-2010:p0796:b001:l024","ordinal":35211,"en":"Warrior Bakay began to speak:"},{"id":"manas-2010:p0796:b001:l025","ordinal":35212,"en":"‘Damn your fathers' graves, forty champions,"},{"id":"manas-2010:p0796:b001:l026","ordinal":35213,"en":"When you had drunk spirits,"},{"id":"manas-2010:p0796:b001:l027","ordinal":35214,"en":"You used to raise a roar."},{"id":"manas-2010:p0796:b001:l028","ordinal":35215,"en":"“Where is the foe?” you cried through clenched teeth,"},{"id":"manas-2010:p0796:b001:l029","ordinal":35216,"en":"Springing up again and again."},{"id":"manas-2010:p0796:b001:l030","ordinal":35217,"en":"If they said dust had risen, you raised a dust,"},{"id":"manas-2010:p0796:b001:l031","ordinal":35218,"en":"Jolting one another,"},{"id":"manas-2010:p0796:b001:l032","ordinal":35219,"en":"And spurring one another on."},{"id":"manas-2010:p0796:b001:l033","ordinal":35220,"en":"If you do not see what I see,"},{"id":"manas-2010:p0796:b001:l034","ordinal":35221,"en":"If you do not know what I know,"},{"id":"manas-2010:p0796:b001:l035","ordinal":35222,"en":"Your enemy has camped along the road;"},{"id":"manas-2010:p0796:b001:l036","ordinal":35223,"en":"Your raiding journey has proved fortunate."},{"id":"manas-2010:p0796:b001:l037","ordinal":35224,"en":"With broad skirts and loose waists,"},{"id":"manas-2010:p0796:b001:l038","ordinal":35225,"en":"The enemy you shall measure strength against"},{"id":"manas-2010:p0796:b001:l039","ordinal":35226,"en":"Is a woman-like people."},{"id":"manas-2010:p0796:b001:l040","ordinal":35227,"en":"Felt shoes and rawhide trousers,"},{"id":"manas-2010:p0796:b001:l041","ordinal":35228,"en":"When I look at their near flank,"},{"id":"manas-2010:p0796:b001:l042","ordinal":35229,"en":"They are a beast-like people."},{"id":"manas-2010:p0797:b001:l001","ordinal":35230,"en":"They have mules and camels,"},{"id":"manas-2010:p0797:b001:l002","ordinal":35231,"en":"And foot soldiers swarming in a mass."},{"id":"manas-2010:p0797:b001:l003","ordinal":35232,"en":"You have wondrous steeds beneath you."},{"id":"manas-2010:p0797:b001:l004","ordinal":35233,"en":"If you shout and thrust your spears,"},{"id":"manas-2010:p0797:b001:l005","ordinal":35234,"en":"Your strength can match a thousand."},{"id":"manas-2010:p0797:b001:l006","ordinal":35235,"en":"Without wavering, without fear,"},{"id":"manas-2010:p0797:b001:l007","ordinal":35236,"en":"Launch a headlong charge."},{"id":"manas-2010:p0797:b001:l008","ordinal":35237,"en":"Consider them: a strange enemy,"},{"id":"manas-2010:p0797:b001:l009","ordinal":35238,"en":"Just like a dream one has seen."},{"id":"manas-2010:p0797:b001:l010","ordinal":35239,"en":"Has such a thing existed in all ages?"},{"id":"manas-2010:p0797:b001:l011","ordinal":35240,"en":"Riding camels and bearing spears,"},{"id":"manas-2010:p0797:b001:l012","ordinal":35241,"en":"May a blow strike your crowns, what creatures!"},{"id":"manas-2010:p0797:b001:l013","ordinal":35242,"en":"Let us descend upon their heads,"},{"id":"manas-2010:p0797:b001:l014","ordinal":35243,"en":"And scatter their four kinds of livestock!"},{"id":"manas-2010:p0797:b001:l015","ordinal":35244,"en":"Let us bind their warrior."},{"id":"manas-2010:p0797:b001:l016","ordinal":35245,"en":"Even if he sits the throne for seven days,"},{"id":"manas-2010:p0797:b001:l017","ordinal":35246,"en":"Leopard Sultan Manas,"},{"id":"manas-2010:p0797:b001:l018","ordinal":35247,"en":"Let us raise him as khan."},{"id":"manas-2010:p0797:b001:l019","ordinal":35248,"en":"While we have strength and might,"},{"id":"manas-2010:p0797:b001:l020","ordinal":35249,"en":"Let us win the title of khan,"},{"id":"manas-2010:p0797:b001:l021","ordinal":35250,"en":"And advance with thrusting spears."},{"id":"manas-2010:p0797:b001:l022","ordinal":35251,"en":"Let us bind their warrior;"},{"id":"manas-2010:p0797:b001:l023","ordinal":35252,"en":"To their very Khan Shooruk,"},{"id":"manas-2010:p0797:b001:l024","ordinal":35253,"en":"Let us send a firm embassy."},{"id":"manas-2010:p0797:b001:l025","ordinal":35254,"en":"Whatever we wish and desire,"},{"id":"manas-2010:p0797:b001:l026","ordinal":35255,"en":"Forty champions,"},{"id":"manas-2010:p0797:b001:l027","ordinal":35256,"en":"Let us seize without standing idle,"},{"id":"manas-2010:p0797:b001:l028","ordinal":35257,"en":"Their valiant ones, their lions."},{"id":"manas-2010:p0797:b001:l029","ordinal":35258,"en":"Your raiding journey has proved fortunate;"},{"id":"manas-2010:p0797:b001:l030","ordinal":35259,"en":"Your enemy has camped along the road."},{"id":"manas-2010:p0797:b001:l031","ordinal":35260,"en":"God has opened your fortune."},{"id":"manas-2010:p0797:b001:l032","ordinal":35261,"en":"For a hero eager to seize,"},{"id":"manas-2010:p0797:b001:l033","ordinal":35262,"en":"Abundant booty has been found."},{"id":"manas-2010:p0797:b001:l034","ordinal":35263,"en":"Having encountered generous Manas,"},{"id":"manas-2010:p0797:b001:l035","ordinal":35264,"en":"Consider, forty champions,"},{"id":"manas-2010:p0797:b001:l036","ordinal":35265,"en":"Thus your honor has been sheltered."},{"id":"manas-2010:p0797:b001:l037","ordinal":35266,"en":"The appearance of the foe you shall meet:"},{"id":"manas-2010:p0797:b001:l038","ordinal":35267,"en":"Pacing mules and red scabbards,"},{"id":"manas-2010:p0797:b001:l039","ordinal":35268,"en":"Long boots and hide trousers,"},{"id":"manas-2010:p0797:b001:l040","ordinal":35269,"en":"They are a loose-waisted people."},{"id":"manas-2010:p0797:b001:l041","ordinal":35270,"en":"To this weak people, the one God,"},{"id":"manas-2010:p0797:b001:l042","ordinal":35271,"en":"Your lion, generous Manas,"},{"id":"manas-2010:p0798:b001:l001","ordinal":35272,"en":"Has now driven here."},{"id":"manas-2010:p0798:b001:l002","ordinal":35273,"en":"Your valor from afar,"},{"id":"manas-2010:p0798:b001:l003","ordinal":35274,"en":"They are a people who will witness it."},{"id":"manas-2010:p0798:b001:l004","ordinal":35275,"en":"If one of you enters and attacks,"},{"id":"manas-2010:p0798:b001:l005","ordinal":35276,"en":"If you charge in boldly,"},{"id":"manas-2010:p0798:b001:l006","ordinal":35277,"en":"Before your very face, resistance"},{"id":"manas-2010:p0798:b001:l007","ordinal":35278,"en":"Is not what these people will offer."},{"id":"manas-2010:p0798:b001:l008","ordinal":35279,"en":"If they see a spear from afar,"},{"id":"manas-2010:p0798:b001:l009","ordinal":35280,"en":"They are not a people who will stand.’"},{"id":"manas-2010:p0798:b001:l010","ordinal":35281,"en":"So spoke Khan Bakay,"},{"id":"manas-2010:p0798:b001:l011","ordinal":35282,"en":"Saying these stirring things, you see."},{"id":"manas-2010:p0798:b001:l012","ordinal":35283,"en":"Your elder Bakay, bearer of good fortune,"},{"id":"manas-2010:p0798:b001:l013","ordinal":35284,"en":"Wearing a gray lynx-fur cap,"},{"id":"manas-2010:p0798:b001:l014","ordinal":35285,"en":"Taking a blue-mottled shield in hand,"},{"id":"manas-2010:p0798:b001:l015","ordinal":35286,"en":"Brandishing his blue spear,"},{"id":"manas-2010:p0798:b001:l016","ordinal":35287,"en":"The great black-shanked whip,"},{"id":"manas-2010:p0798:b001:l017","ordinal":35288,"en":"Your elder, leopard Bakay,"},{"id":"manas-2010:p0798:b001:l018","ordinal":35289,"en":"Seized and swung it."},{"id":"manas-2010:p0798:b001:l019","ordinal":35290,"en":"Making the gray wondrous steed ring out,"},{"id":"manas-2010:p0798:b001:l020","ordinal":35291,"en":"He struck it at his knee."},{"id":"manas-2010:p0798:b001:l021","ordinal":35292,"en":"Roaring in his fury,"},{"id":"manas-2010:p0798:b001:l022","ordinal":35293,"en":"His sultan who served as their support,"},{"id":"manas-2010:p0798:b001:l023","ordinal":35294,"en":"He called ‘Manas!’ as his battle cry."},{"id":"manas-2010:p0798:b001:l024","ordinal":35295,"en":"Bakay now launched the attack."},{"id":"manas-2010:p0798:b001:l025","ordinal":35296,"en":"Behind him the forty champions"},{"id":"manas-2010:p0798:b001:l026","ordinal":35297,"en":"Thrust their spears abreast."},{"id":"manas-2010:p0798:b001:l027","ordinal":35298,"en":"Raging, two together,"},{"id":"manas-2010:p0798:b001:l028","ordinal":35299,"en":"His formidable dun horse,"},{"id":"manas-2010:p0798:b001:l029","ordinal":35300,"en":"Letting it lumber along unmounted,"},{"id":"manas-2010:p0798:b001:l030","ordinal":35301,"en":"Twelve champions led it."},{"id":"manas-2010:p0798:b001:l031","ordinal":35302,"en":"A white pennant became their banner;"},{"id":"manas-2010:p0798:b001:l032","ordinal":35303,"en":"There was a shouting uproar,"},{"id":"manas-2010:p0798:b001:l033","ordinal":35304,"en":"There was a shrill, roaring tumult,"},{"id":"manas-2010:p0798:b001:l034","ordinal":35305,"en":"There was ever more commotion."},{"id":"manas-2010:p0798:b001:l035","ordinal":35306,"en":"The standard and pennant fluttered."},{"id":"manas-2010:p0798:b001:l036","ordinal":35307,"en":"Breaking stones and opening a road,"},{"id":"manas-2010:p0798:b001:l037","ordinal":35308,"en":"Upon some thousand camel-mounted soldiers,"},{"id":"manas-2010:p0798:b001:l038","ordinal":35309,"en":"Prince Bakay launched an attack."},{"id":"manas-2010:p0798:b001:l039","ordinal":35310,"en":"The forty champions behind him"},{"id":"manas-2010:p0798:b001:l040","ordinal":35311,"en":"Surged abreast and reached them."},{"id":"manas-2010:p0798:b001:l041","ordinal":35312,"en":"The renowned wolf-maned leopard,"},{"id":"manas-2010:p0798:b001:l042","ordinal":35313,"en":"Looming upon Akkula,"},{"id":"manas-2010:p0799:b001:l001","ordinal":35314,"en":"Your devastating prince towered high,"},{"id":"manas-2010:p0799:b001:l002","ordinal":35315,"en":"And went on sporting, sporting."},{"id":"manas-2010:p0799:b001:l003","ordinal":35316,"en":"As he sported, ten men died."},{"id":"manas-2010:p0799:b001:l004","ordinal":35317,"en":"When the forty champions surged upon them,"},{"id":"manas-2010:p0799:b001:l005","ordinal":35318,"en":"It was as though their very edges were struck."},{"id":"manas-2010:p0799:b001:l006","ordinal":35319,"en":"May God spare us the sight!"},{"id":"manas-2010:p0799:b001:l007","ordinal":35320,"en":"A massacre came, and many died."},{"id":"manas-2010:p0799:b001:l008","ordinal":35321,"en":"Those left alive after the deaths,"},{"id":"manas-2010:p0799:b001:l009","ordinal":35322,"en":"As though a devouring demon had burst among them,"},{"id":"manas-2010:p0799:b001:l010","ordinal":35323,"en":"All despaired of their lives."},{"id":"manas-2010:p0799:b001:l011","ordinal":35324,"en":"Khan Shooruk's many soldiers"},{"id":"manas-2010:p0799:b001:l012","ordinal":35325,"en":"Climbed down from their camels,"},{"id":"manas-2010:p0799:b001:l013","ordinal":35326,"en":"Folded their hands across their bellies,"},{"id":"manas-2010:p0799:b001:l014","ordinal":35327,"en":"Bobbing like brides,"},{"id":"manas-2010:p0799:b001:l015","ordinal":35328,"en":"They began to bow in homage."}]
