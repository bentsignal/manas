{"id": "sayakbay-ms-current142:pdf026:l001", "source_id": "sayakbay-ms-current142", "pdf_sha256": "2b1fd33d35b9fec662724180743e44a26bc44d8b347d5f99c373acf98cb6c73f", "page": 26, "folio": 2343, "line_in_page": 1, "raw": "Наргүлдү таажы жаптырды,", "text": "Наргүлдү таажы жаптырды,", "en": "They crowned Nargül,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "First name and final verb are slightly unclear.", "bbox": null}
