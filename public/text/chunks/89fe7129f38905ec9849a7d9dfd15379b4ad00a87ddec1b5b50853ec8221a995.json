[{"id":"semetey-1-2013:p1220:b004:l015","ordinal":170241,"en":"They planted in seven places,"},{"id":"semetey-1-2013:p1220:b004:l016","ordinal":170242,"en":"Slaughtering wherever they reached."},{"id":"semetey-1-2013:p1220:b004:l017","ordinal":170243,"en":"Among the Black Chinese and Manchus,"},{"id":"semetey-1-2013:p1220:b004:l018","ordinal":170244,"en":"Only a few common folk"},{"id":"semetey-1-2013:p1220:b004:l019","ordinal":170245,"en":"Escaped by fleeing."},{"id":"semetey-1-2013:p1220:b004:l020","ordinal":170246,"en":"Manas found the booty"},{"id":"semetey-1-2013:p1220:b004:l021","ordinal":170247,"en":"And ten thousand Kalmyk households"},{"id":"semetey-1-2013:p1220:b004:l022","ordinal":170248,"en":"He raided and devastated."},{"id":"semetey-1-2013:p1220:b004:l023","ordinal":170249,"en":"They took the gold as booty"},{"id":"semetey-1-2013:p1220:b004:l024","ordinal":170250,"en":"And drove off the livestock, fully sated."},{"id":"semetey-1-2013:p1220:b004:l025","ordinal":170251,"en":"So many camel colts, so many goods—"},{"id":"semetey-1-2013:p1220:b004:l026","ordinal":170252,"en":"They could not load them all;"},{"id":"semetey-1-2013:p1220:b004:l027","ordinal":170253,"en":"So many noble young wives and beautiful girls—"},{"id":"semetey-1-2013:p1220:b004:l028","ordinal":170254,"en":"They could not divide them all."},{"id":"semetey-1-2013:p1220:b004:l029","ordinal":170255,"en":"The Kalmyks who faced them"},{"id":"semetey-1-2013:p1220:b004:l030","ordinal":170256,"en":"Stood on opposite banks;"},{"id":"semetey-1-2013:p1220:b004:l031","ordinal":170257,"en":"Between them lay a great river."},{"id":"semetey-1-2013:p1220:b004:l032","ordinal":170258,"en":"Unable to reach with spears,"},{"id":"semetey-1-2013:p1220:b004:l033","ordinal":170259,"en":"They fought with guns."},{"id":"semetey-1-2013:p1220:b004:l034","ordinal":170260,"en":"As they exchanged battle cries,"},{"id":"semetey-1-2013:p1220:b004:l035","ordinal":170261,"en":"The expert Almambet"},{"id":"semetey-1-2013:p1220:b004:l036","ordinal":170262,"en":"Shot Joloy's Achbuudan"},{"id":"semetey-1-2013:p1220:b004:l037","ordinal":170263,"en":"On the farther bank,"},{"id":"semetey-1-2013:p1220:b004:l038","ordinal":170264,"en":"Trapping many of them,"},{"id":"semetey-1-2013:p1220:b004:l039","ordinal":170265,"en":"Some ten thousand Kalmyk households."},{"id":"semetey-1-2013:p1221:b003:l001","ordinal":170266,"en":"He had Khan Manas plunder them."},{"id":"semetey-1-2013:p1221:b003:l002","ordinal":170267,"en":"They had gone as guests"},{"id":"semetey-1-2013:p1221:b003:l003","ordinal":170268,"en":"To Kökötöy's feast and turned back,"},{"id":"semetey-1-2013:p1221:b003:l004","ordinal":170269,"en":"Intending to use force,"},{"id":"semetey-1-2013:p1221:b003:l005","ordinal":170270,"en":"Only to lose Achbuudan."},{"id":"semetey-1-2013:p1221:b003:l006","ordinal":170271,"en":"Many men fell to bullets;"},{"id":"semetey-1-2013:p1221:b003:l007","ordinal":170272,"en":"Many had their hands bound."},{"id":"semetey-1-2013:p1221:b003:l008","ordinal":170273,"en":"Many Black Kalmyks and Manchus"},{"id":"semetey-1-2013:p1221:b003:l009","ordinal":170274,"en":"Who had come against Manas"},{"id":"semetey-1-2013:p1221:b003:l010","ordinal":170275,"en":"Were captured as booty."},{"id":"semetey-1-2013:p1221:b003:l011","ordinal":170276,"en":"The bloodthirsty lion Manas the leopard"},{"id":"semetey-1-2013:p1221:b003:l012","ordinal":170277,"en":"Made a massacre there"},{"id":"semetey-1-2013:p1221:b003:l013","ordinal":170278,"en":"Of the teeming Chinese and Manchus."},{"id":"semetey-1-2013:p1221:b003:l014","ordinal":170279,"en":"While the falcon Manas lived,"},{"id":"semetey-1-2013:p1221:b003:l015","ordinal":170280,"en":"He brought great turmoil upon the Chinese;"},{"id":"semetey-1-2013:p1221:b003:l016","ordinal":170281,"en":"It was plain that he was a hero."},{"id":"semetey-1-2013:p1221:b003:l017","ordinal":170282,"en":"“Bloodthirsty Manas the leopard"},{"id":"semetey-1-2013:p1221:b003:l018","ordinal":170283,"en":"Will devour us,” they said,"},{"id":"semetey-1-2013:p1221:b003:l019","ordinal":170284,"en":"And the khan of the Black Kalmyks and Manchus"},{"id":"semetey-1-2013:p1221:b003:l020","ordinal":170285,"en":"Despaired of his life."},{"id":"semetey-1-2013:p1221:b003:l021","ordinal":170286,"en":"His turmoil became known to the people."},{"id":"semetey-1-2013:p1221:b003:l022","ordinal":170287,"en":"Had that Manas not been there,"},{"id":"semetey-1-2013:p1221:b003:l023","ordinal":170288,"en":"At Kökötöy's feast"},{"id":"semetey-1-2013:p1221:b003:l024","ordinal":170289,"en":"They would have cropped ears short,"},{"id":"semetey-1-2013:p1221:b003:l025","ordinal":170290,"en":"Dug deep pits,"},{"id":"semetey-1-2013:p1221:b003:l026","ordinal":170291,"en":"And brewed utter misery."},{"id":"semetey-1-2013:p1221:b003:l027","ordinal":170292,"en":"When they were about to dig a well in the place of honor"},{"id":"semetey-1-2013:p1221:b003:l028","ordinal":170293,"en":"And scatter the four kinds of livestock,"},{"id":"semetey-1-2013:p1221:b003:l029","ordinal":170294,"en":"Would they not have unleashed"},{"id":"semetey-1-2013:p1221:b003:l030","ordinal":170295,"en":"Unsparing turmoil?"},{"id":"semetey-1-2013:p1221:b003:l031","ordinal":170296,"en":"Did he not save the palm-sized Muslims"},{"id":"semetey-1-2013:p1221:b003:l032","ordinal":170297,"en":"And keep those Chinese"},{"id":"semetey-1-2013:p1221:b003:l033","ordinal":170298,"en":"From slaughtering them?"},{"id":"semetey-1-2013:p1221:b003:l034","ordinal":170299,"en":"The Chinese did not quell their strife;"},{"id":"semetey-1-2013:p1221:b003:l035","ordinal":170300,"en":"When they were about to slaughter everyone,"},{"id":"semetey-1-2013:p1221:b003:l036","ordinal":170301,"en":"Manas the leopard protected them."},{"id":"semetey-1-2013:p1221:b003:l037","ordinal":170302,"en":"Their cuirasses hanging loose,"},{"id":"semetey-1-2013:p1221:b003:l038","ordinal":170303,"en":"I saw all their khans"},{"id":"semetey-1-2013:p1221:b003:l039","ordinal":170304,"en":"In the place where they panicked."},{"id":"semetey-1-2013:p1221:b004:l001","ordinal":170305,"en":"I saw the place where Sultan Manas the bloodthirsty"},{"id":"semetey-1-2013:p1221:b004:l002","ordinal":170306,"en":"Suppressed"},{"id":"semetey-1-2013:p1221:b004:l003","ordinal":170307,"en":"Their murderous turmoil."},{"id":"semetey-1-2013:p1221:b004:l004","ordinal":170308,"en":"I saw the place where he brought"},{"id":"semetey-1-2013:p1221:b004:l005","ordinal":170309,"en":"Turmoil upon the whole world."},{"id":"semetey-1-2013:p1221:b004:l006","ordinal":170310,"en":"I saw the place where he separated"},{"id":"semetey-1-2013:p1221:b004:l007","ordinal":170311,"en":"The palm-sized Muslims"},{"id":"semetey-1-2013:p1221:b004:l008","ordinal":170312,"en":"From the Chinese and rescued them."},{"id":"semetey-1-2013:p1221:b004:l009","ordinal":170313,"en":"Had that Manas not been there,"},{"id":"semetey-1-2013:p1221:b004:l010","ordinal":170314,"en":"Would the Black Manchus and Chinese"},{"id":"semetey-1-2013:p1221:b004:l011","ordinal":170315,"en":"Not have drawn the line"},{"id":"semetey-1-2013:p1221:b004:l012","ordinal":170316,"en":"And made sport of them?"},{"id":"semetey-1-2013:p1221:b004:l013","ordinal":170317,"en":"They would have driven them away into slavery"},{"id":"semetey-1-2013:p1221:b004:l014","ordinal":170318,"en":"And brought them to their end."},{"id":"semetey-1-2013:p1221:b004:l015","ordinal":170319,"en":"When they were about to slaughter"},{"id":"semetey-1-2013:p1221:b004:l016","ordinal":170320,"en":"The Muslim giants,"},{"id":"semetey-1-2013:p1221:b004:l017","ordinal":170321,"en":"Khan Koshoi of the Katagan"},{"id":"semetey-1-2013:p1221:b004:l018","ordinal":170322,"en":"Fled out from among the people."},{"id":"semetey-1-2013:p1221:b004:l019","ordinal":170323,"en":"Jamgyrchy of the Eshtek"},{"id":"semetey-1-2013:p1221:b004:l020","ordinal":170324,"en":"Despaired of his own life"},{"id":"semetey-1-2013:p1221:b004:l021","ordinal":170325,"en":"And panicked helplessly."},{"id":"semetey-1-2013:p1221:b004:l022","ordinal":170326,"en":"I saw then that dear blue-maned Manas"},{"id":"semetey-1-2013:p1221:b004:l023","ordinal":170327,"en":"Was a lion."},{"id":"semetey-1-2013:p1221:b004:l024","ordinal":170328,"en":"I saw that he was a hero,"},{"id":"semetey-1-2013:p1221:b004:l025","ordinal":170329,"en":"Different and surpassing other mortals."},{"id":"semetey-1-2013:p1221:b004:l026","ordinal":170330,"en":"Blaze-headed thoroughbred among horses—"},{"id":"semetey-1-2013:p1221:b004:l027","ordinal":170331,"en":"Amid that massacre,"},{"id":"semetey-1-2013:p1221:b004:l028","ordinal":170332,"en":"Agybay, Bakai, and Almambet,"},{"id":"semetey-1-2013:p1221:b004:l029","ordinal":170333,"en":"Along with Chubak,"},{"id":"semetey-1-2013:p1221:b004:l030","ordinal":170334,"en":"Were heroes born for honor."},{"id":"semetey-1-2013:p1221:b004:l031","ordinal":170335,"en":"You keep saying, Chynkozho,"},{"id":"semetey-1-2013:p1221:b004:l032","ordinal":170336,"en":"“I will seize"},{"id":"semetey-1-2013:p1221:b004:l033","ordinal":170337,"en":"Famous blue-maned Manas's daughter-in-law.”"},{"id":"semetey-1-2013:p1221:b004:l034","ordinal":170338,"en":"“God-stricken words!"},{"id":"semetey-1-2013:p1221:b004:l035","ordinal":170339,"en":"You have acted by force, Chynkozho."},{"id":"semetey-1-2013:p1221:b004:l036","ordinal":170340,"en":"Will Semetey, born of Manas,"},{"id":"semetey-1-2013:p1221:b004:l037","ordinal":170341,"en":"Submit to your violence?"},{"id":"semetey-1-2013:p1221:b004:l038","ordinal":170342,"en":"Let it go, Chynkozho;"},{"id":"semetey-1-2013:p1221:b004:l039","ordinal":170343,"en":"Will he give us his wife?"},{"id":"semetey-1-2013:p1222:b003:l001","ordinal":170344,"en":"His dwelling place is broad Talas;"},{"id":"semetey-1-2013:p1222:b003:l002","ordinal":170345,"en":"That is no cheap land."},{"id":"semetey-1-2013:p1222:b003:l003","ordinal":170346,"en":"Would he give us his wife?"},{"id":"semetey-1-2013:p1222:b003:l004","ordinal":170347,"en":"Semetey is no easy hero."},{"id":"semetey-1-2013:p1222:b003:l005","ordinal":170348,"en":"You have courage, wretched slave;"},{"id":"semetey-1-2013:p1222:b003:l006","ordinal":170349,"en":"You are the very strongest."},{"id":"semetey-1-2013:p1222:b003:l007","ordinal":170350,"en":"Parted in your bewilderment"},{"id":"semetey-1-2013:p1222:b003:l008","ordinal":170351,"en":"From your ancient Kyrgyz people,"},{"id":"semetey-1-2013:p1222:b003:l009","ordinal":170352,"en":"What have you become, commoner?"},{"id":"semetey-1-2013:p1222:b003:l010","ordinal":170353,"en":"Manas was no ordinary khan;"},{"id":"semetey-1-2013:p1222:b003:l011","ordinal":170354,"en":"Semetey, son of Manas,"},{"id":"semetey-1-2013:p1222:b003:l012","ordinal":170355,"en":"Will not give us his wife."},{"id":"semetey-1-2013:p1222:b003:l013","ordinal":170356,"en":"Today we shall seize"},{"id":"semetey-1-2013:p1222:b003:l014","ordinal":170357,"en":"And take Aychürök by force;"},{"id":"semetey-1-2013:p1222:b003:l015","ordinal":170358,"en":"Tomorrow, watch and see,"},{"id":"semetey-1-2013:p1222:b003:l016","ordinal":170359,"en":"We shall all fall into torment."},{"id":"semetey-1-2013:p1222:b003:l017","ordinal":170360,"en":"Brave Bakai, son of a saint,"},{"id":"semetey-1-2013:p1222:b003:l018","ordinal":170361,"en":"Will not leave you unharmed if you live;"},{"id":"semetey-1-2013:p1222:b003:l019","ordinal":170362,"en":"He was a man who had seen much."},{"id":"semetey-1-2013:p1222:b003:l020","ordinal":170363,"en":"If Bakai comes, he will not leave us unharmed."},{"id":"semetey-1-2013:p1222:b003:l021","ordinal":170364,"en":"Let it go, Kozho, my dear friend;"},{"id":"semetey-1-2013:p1222:b003:l022","ordinal":170365,"en":"There is a great flaw in your words."},{"id":"semetey-1-2013:p1222:b003:l023","ordinal":170366,"en":"Will he agree to what you say?"},{"id":"semetey-1-2013:p1222:b003:l024","ordinal":170367,"en":"Will he give us his widow?"},{"id":"semetey-1-2013:p1222:b003:l025","ordinal":170368,"en":"Chynkozho, son of Shygay,"},{"id":"semetey-1-2013:p1222:b003:l026","ordinal":170369,"en":"These words of yours are not right."},{"id":"semetey-1-2013:p1222:b003:l027","ordinal":170370,"en":"Semetey, son of Manas,"},{"id":"semetey-1-2013:p1222:b003:l028","ordinal":170371,"en":"Is no slave who would give us his wife."},{"id":"semetey-1-2013:p1222:b003:l029","ordinal":170372,"en":"All the saints came together;"},{"id":"semetey-1-2013:p1222:b003:l030","ordinal":170373,"en":"He is a son formed by their sovereign."},{"id":"semetey-1-2013:p1222:b003:l031","ordinal":170374,"en":"Kanykei and Manas together"},{"id":"semetey-1-2013:p1222:b003:l032","ordinal":170375,"en":"Pieced this son together."},{"id":"semetey-1-2013:p1222:b003:l033","ordinal":170376,"en":"Before the multitude, he was a son"},{"id":"semetey-1-2013:p1222:b003:l034","ordinal":170377,"en":"They asked God to grant."},{"id":"semetey-1-2013:p1222:b003:l035","ordinal":170378,"en":"He is the spring flowing from the valley,"},{"id":"semetey-1-2013:p1222:b003:l036","ordinal":170379,"en":"The lamp that blue-maned Manas himself"},{"id":"semetey-1-2013:p1222:b003:l037","ordinal":170380,"en":"Desired and received."},{"id":"semetey-1-2013:p1222:b003:l038","ordinal":170381,"en":"If we seize and take his wife,"},{"id":"semetey-1-2013:p1222:b003:l039","ordinal":170382,"en":"Will he stand watching without a quarrel?"},{"id":"semetey-1-2013:p1222:b004:l001","ordinal":170383,"en":"Kozho, you have blustering words"},{"id":"semetey-1-2013:p1222:b004:l002","ordinal":170384,"en":"That bring you disgrace."},{"id":"semetey-1-2013:p1222:b004:l003","ordinal":170385,"en":"If we take his wife,"},{"id":"semetey-1-2013:p1222:b004:l004","ordinal":170386,"en":"Semetey, son of Manas,"},{"id":"semetey-1-2013:p1222:b004:l005","ordinal":170387,"en":"May bring a great slaughter upon us."},{"id":"semetey-1-2013:p1222:b004:l006","ordinal":170388,"en":"If we seize and take Chürök,"},{"id":"semetey-1-2013:p1222:b004:l007","ordinal":170389,"en":"When Semetey comes tomorrow,"},{"id":"semetey-1-2013:p1222:b004:l008","ordinal":170390,"en":"Will he not make"},{"id":"semetey-1-2013:p1222:b004:l009","ordinal":170391,"en":"Your great Kyrgyz settlement boil in misery?"},{"id":"semetey-1-2013:p1222:b004:l010","ordinal":170392,"en":"When Semetey sweeps down upon us,"},{"id":"semetey-1-2013:p1222:b004:l011","ordinal":170393,"en":"Will he not show us wonders?"},{"id":"semetey-1-2013:p1222:b004:l012","ordinal":170394,"en":"Let us not fall into calamity;"},{"id":"semetey-1-2013:p1222:b004:l013","ordinal":170395,"en":"Poor Kozho, heed my words,"},{"id":"semetey-1-2013:p1222:b004:l014","ordinal":170396,"en":"Let us not take Aychürök."},{"id":"semetey-1-2013:p1222:b004:l015","ordinal":170397,"en":"What shall we do with Chürök?"},{"id":"semetey-1-2013:p1222:b004:l016","ordinal":170398,"en":"While we are safe and sound,"},{"id":"semetey-1-2013:p1222:b004:l017","ordinal":170399,"en":"Come, Kozho, let us leave."},{"id":"semetey-1-2013:p1222:b004:l018","ordinal":170400,"en":"Let us not take the beautiful girl Chürök;"},{"id":"semetey-1-2013:p1222:b004:l019","ordinal":170401,"en":"Let us not fall into calamity."},{"id":"semetey-1-2013:p1222:b004:l020","ordinal":170402,"en":"You have courage, laughable man;"},{"id":"semetey-1-2013:p1222:b004:l021","ordinal":170403,"en":"You say you are Manas's equal."},{"id":"semetey-1-2013:p1222:b004:l022","ordinal":170404,"en":"Many Argyn fill Jeti-Özön;"},{"id":"semetey-1-2013:p1222:b004:l023","ordinal":170405,"en":"You are truly accomplished,"},{"id":"semetey-1-2013:p1222:b004:l024","ordinal":170406,"en":"So what have you become, commoner?"},{"id":"semetey-1-2013:p1222:b004:l025","ordinal":170407,"en":"For now, while you swagger,"},{"id":"semetey-1-2013:p1222:b004:l026","ordinal":170408,"en":"Let us not seize Aychürök."},{"id":"semetey-1-2013:p1222:b004:l027","ordinal":170409,"en":"Setting out to take Aychürök,"},{"id":"semetey-1-2013:p1222:b004:l028","ordinal":170410,"en":"We are only a small people;"},{"id":"semetey-1-2013:p1222:b004:l029","ordinal":170411,"en":"Let us not all fall into torment.”"},{"id":"semetey-1-2013:p1222:b004:l030","ordinal":170412,"en":"When Toltoy said this,"},{"id":"semetey-1-2013:p1222:b004:l031","ordinal":170413,"en":"Chynkozho, son of Shygay,"},{"id":"semetey-1-2013:p1222:b004:l032","ordinal":170414,"en":"Flared up in anger,"},{"id":"semetey-1-2013:p1222:b004:l033","ordinal":170415,"en":"Made ready like a hawk,"},{"id":"semetey-1-2013:p1222:b004:l034","ordinal":170416,"en":"And found a quarrel where none existed."},{"id":"semetey-1-2013:p1222:b004:l035","ordinal":170417,"en":"“Look at what"},{"id":"semetey-1-2013:p1222:b004:l036","ordinal":170418,"en":"That fucking Toltoy is doing!"},{"id":"semetey-1-2013:p1222:b004:l037","ordinal":170419,"en":"Thinking the Jediger of Jeti-Özön"},{"id":"semetey-1-2013:p1222:b004:l038","ordinal":170420,"en":"Were a true people, I came here;"},{"id":"semetey-1-2013:p1222:b004:l039","ordinal":170421,"en":"When you migrated from your homeland,"},{"id":"semetey-1-2013:p1223:b003:l001","ordinal":170422,"en":"You buried-in-earth Toltoi,"},{"id":"semetey-1-2013:p1223:b003:l002","ordinal":170423,"en":"I came thinking you were a lion."},{"id":"semetey-1-2013:p1223:b003:l003","ordinal":170424,"en":"If an enemy faced us,"},{"id":"semetey-1-2013:p1223:b003:l004","ordinal":170425,"en":"I came thinking you would be our support;"},{"id":"semetey-1-2013:p1223:b003:l005","ordinal":170426,"en":"But you think of impossible things—"},{"id":"semetey-1-2013:p1223:b003:l006","ordinal":170427,"en":"You are infidel Toltoi."},{"id":"semetey-1-2013:p1223:b003:l007","ordinal":170428,"en":"Fleeing from a woman in a stagger,"},{"id":"semetey-1-2013:p1223:b003:l008","ordinal":170429,"en":"You are womanly Toltoi."},{"id":"semetey-1-2013:p1223:b003:l009","ordinal":170430,"en":"Paying no heed to salt and bread,"},{"id":"semetey-1-2013:p1223:b003:l010","ordinal":170431,"en":"You are a Toltoi who has prospered."},{"id":"semetey-1-2013:p1223:b003:l011","ordinal":170432,"en":"Thinking of every kind of thing,"},{"id":"semetey-1-2013:p1223:b003:l012","ordinal":170433,"en":"You are fine Toltoi;"},{"id":"semetey-1-2013:p1223:b003:l013","ordinal":170434,"en":"Frightened today by yesterday's dream,"},{"id":"semetey-1-2013:p1223:b003:l014","ordinal":170435,"en":"You are shaman Toltoi."},{"id":"semetey-1-2013:p1223:b003:l015","ordinal":170436,"en":"At Kökötöi's feast,"},{"id":"semetey-1-2013:p1223:b003:l016","ordinal":170437,"en":"A great sage who saw much—"},{"id":"semetey-1-2013:p1223:b003:l017","ordinal":170438,"en":"You are old Toltoi;"},{"id":"semetey-1-2013:p1223:b003:l018","ordinal":170439,"en":"Knowing well that you will die,"},{"id":"semetey-1-2013:p1223:b003:l019","ordinal":170440,"en":"You are saint Toltoi."},{"id":"semetey-1-2013:p1223:b003:l020","ordinal":170441,"en":"While standing at Zheti-Özön,"},{"id":"semetey-1-2013:p1223:b003:l021","ordinal":170442,"en":"Saying you would take a wife,"},{"id":"semetey-1-2013:p1223:b003:l022","ordinal":170443,"en":"You are industrious Toltoi."},{"id":"semetey-1-2013:p1223:b003:l023","ordinal":170444,"en":"Knowing that you yourself will die,"},{"id":"semetey-1-2013:p1223:b003:l024","ordinal":170445,"en":"You are dreamer Toltoi."},{"id":"semetey-1-2013:p1223:b003:l025","ordinal":170446,"en":"Toltoi has indeed gone about"},{"id":"semetey-1-2013:p1223:b003:l026","ordinal":170447,"en":"As khan of the Zhediger."},{"id":"semetey-1-2013:p1223:b003:l027","ordinal":170448,"en":"Toltoi has indeed known"},{"id":"semetey-1-2013:p1223:b003:l028","ordinal":170449,"en":"Seven years of suffering."},{"id":"semetey-1-2013:p1223:b003:l029","ordinal":170450,"en":"As a saint, Toltoi has indeed"},{"id":"semetey-1-2013:p1223:b003:l030","ordinal":170451,"en":"Known his appointed time!"},{"id":"semetey-1-2013:p1223:b003:l031","ordinal":170452,"en":"Hero Toltoi, my friend,"},{"id":"semetey-1-2013:p1223:b003:l032","ordinal":170453,"en":"If you will go, give me your answer;"},{"id":"semetey-1-2013:p1223:b003:l033","ordinal":170454,"en":"If you will not, tell me the truth."},{"id":"semetey-1-2013:p1223:b003:l034","ordinal":170455,"en":"I had thought you were a khan;"},{"id":"semetey-1-2013:p1223:b003:l035","ordinal":170456,"en":"Why should I go on relying upon you?"},{"id":"semetey-1-2013:p1223:b003:l036","ordinal":170457,"en":"I shall turn back to the people"},{"id":"semetey-1-2013:p1223:b003:l037","ordinal":170458,"en":"And now enter among"},{"id":"semetey-1-2013:p1223:b003:l038","ordinal":170459,"en":"The Argyn and Kyrgyz."},{"id":"semetey-1-2013:p1223:b003:l039","ordinal":170460,"en":"After that, accursed Toltoi,"},{"id":"semetey-1-2013:p1223:b004:l001","ordinal":170461,"en":"Stay where you are;"},{"id":"semetey-1-2013:p1223:b004:l002","ordinal":170462,"en":"Then I shall reach your very root."},{"id":"semetey-1-2013:p1223:b004:l003","ordinal":170463,"en":"If Semetey proves too numerous,"},{"id":"semetey-1-2013:p1223:b004:l004","ordinal":170464,"en":"I shall offer my Kara At as a gift."},{"id":"semetey-1-2013:p1223:b004:l005","ordinal":170465,"en":"I shall make peace and enter my people;"},{"id":"semetey-1-2013:p1223:b004:l006","ordinal":170466,"en":"Then, Toltoi, watch closely—"},{"id":"semetey-1-2013:p1223:b004:l007","ordinal":170467,"en":"Afterward I shall reach your root."},{"id":"semetey-1-2013:p1223:b004:l008","ordinal":170468,"en":"When I go and make peace,"},{"id":"semetey-1-2013:p1223:b004:l009","ordinal":170469,"en":"I shall take Khan Bakai;"},{"id":"semetey-1-2013:p1223:b004:l010","ordinal":170470,"en":"Then I shall bring slaughter"},{"id":"semetey-1-2013:p1223:b004:l011","ordinal":170471,"en":"Upon the Zhediger of Zheti-Özön."},{"id":"semetey-1-2013:p1223:b004:l012","ordinal":170472,"en":"I shall make Kanchoro my companion,"},{"id":"semetey-1-2013:p1223:b004:l013","ordinal":170473,"en":"Engulf you from above,"},{"id":"semetey-1-2013:p1223:b004:l014","ordinal":170474,"en":"And scatter your four kinds of livestock."},{"id":"semetey-1-2013:p1223:b004:l015","ordinal":170475,"en":"If you will go, tell me the truth;"},{"id":"semetey-1-2013:p1223:b004:l016","ordinal":170476,"en":"If you will not, tell me that!\""},{"id":"semetey-1-2013:p1223:b004:l017","ordinal":170477,"en":"Kojo stood seething,"},{"id":"semetey-1-2013:p1223:b004:l018","ordinal":170478,"en":"Speaking as though he would devour"},{"id":"semetey-1-2013:p1223:b004:l019","ordinal":170479,"en":"Toltoi of the Zhediger."},{"id":"semetey-1-2013:p1223:b004:l020","ordinal":170480,"en":"At that moment hero Toltoi,"},{"id":"semetey-1-2013:p1223:b004:l021","ordinal":170481,"en":"Grumbling helplessly,"},{"id":"semetey-1-2013:p1223:b004:l022","ordinal":170482,"en":"Was about to go"},{"id":"semetey-1-2013:p1223:b004:l023","ordinal":170483,"en":"To Khan Akun's city."},{"id":"semetey-1-2013:p1223:b004:l024","ordinal":170484,"en":"Through the calamity"},{"id":"semetey-1-2013:p1223:b004:l025","ordinal":170485,"en":"Of wrathful Kojo,"},{"id":"semetey-1-2013:p1223:b004:l026","ordinal":170486,"en":"Hero Toltoi was about to remain there."},{"id":"semetey-1-2013:p1223:b004:l027","ordinal":170487,"en":"Toltoi of the Zhediger,"},{"id":"semetey-1-2013:p1223:b004:l028","ordinal":170488,"en":"With his great army that bent the earth,"},{"id":"semetey-1-2013:p1223:b004:l029","ordinal":170489,"en":"Could, when angered,"},{"id":"semetey-1-2013:p1223:b004:l030","ordinal":170490,"en":"Utterly engulf the Afghans."},{"id":"semetey-1-2013:p1223:b004:l031","ordinal":170491,"en":"Dear Toltoi could reach"},{"id":"semetey-1-2013:p1223:b004:l032","ordinal":170492,"en":"The very root of whoever challenged him."},{"id":"semetey-1-2013:p1223:b004:l033","ordinal":170493,"en":"Was hero Toltoi not"},{"id":"semetey-1-2013:p1223:b004:l034","ordinal":170494,"en":"The accomplished khan of the Zhediger?"},{"id":"semetey-1-2013:p1223:b004:l035","ordinal":170495,"en":"Did hero Toltoi not possess"},{"id":"semetey-1-2013:p1223:b004:l036","ordinal":170496,"en":"Great courage within him?"}]
