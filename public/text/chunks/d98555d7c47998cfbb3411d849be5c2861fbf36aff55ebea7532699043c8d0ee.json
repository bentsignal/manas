[{"id":"seytek-1991-continuation:p0344:b003:l006","ordinal":387073,"en":"The champion became the marksman,"},{"id":"seytek-1991-continuation:p0344:b003:l007","ordinal":387074,"en":"And came toward the hero."},{"id":"seytek-1991-continuation:p0344:b003:l008","ordinal":387075,"en":"How great was his strength and skill"},{"id":"seytek-1991-continuation:p0344:b003:l009","ordinal":387076,"en":"As he came to see Er Kenen,"},{"id":"seytek-1991-continuation:p0344:b003:l010","ordinal":387077,"en":"To fight and quarrel"},{"id":"seytek-1991-continuation:p0344:b003:l011","ordinal":387078,"en":"And deliver his punishment by hand!"},{"id":"seytek-1991-continuation:p0344:b003:l012","ordinal":387079,"en":"He covered the earth in fog;"},{"id":"seytek-1991-continuation:p0344:b003:l013","ordinal":387080,"en":"Camels passed, crushing stones,"},{"id":"seytek-1991-continuation:p0344:b003:l014","ordinal":387081,"en":"And crossed water without tiring."},{"id":"seytek-1991-continuation:p0344:b003:l015","ordinal":387082,"en":"Watching ridge after ridge,"},{"id":"seytek-1991-continuation:p0344:b003:l016","ordinal":387083,"en":"He saw Kertulpar beneath Kenen,"},{"id":"seytek-1991-continuation:p0344:b003:l017","ordinal":387084,"en":"A swift, well-equipped beast."},{"id":"seytek-1991-continuation:p0344:b003:l018","ordinal":387085,"en":"Unless his limbs were broken,"},{"id":"seytek-1991-continuation:p0344:b003:l019","ordinal":387086,"en":"Unless he died and his life grew still,"},{"id":"seytek-1991-continuation:p0344:b003:l020","ordinal":387087,"en":"Unless a thousand disasters befell him,"},{"id":"seytek-1991-continuation:p0344:b003:l021","ordinal":387088,"en":"Unless only a handful of reins remained,"},{"id":"seytek-1991-continuation:p0344:b003:l022","ordinal":387089,"en":"He would never stumble into disaster;"},{"id":"seytek-1991-continuation:p0344:b003:l023","ordinal":387090,"en":"Though crimson turmoil and great calamity raged,"},{"id":"seytek-1991-continuation:p0344:b003:l024","ordinal":387091,"en":"For however many days he rode into slaughter,"},{"id":"seytek-1991-continuation:p0344:b003:l025","ordinal":387092,"en":"He would never yield to the enemy—"},{"id":"seytek-1991-continuation:p0344:b003:l026","ordinal":387093,"en":"The formidable racer Kertulpar."},{"id":"seytek-1991-continuation:p0344:b003:l027","ordinal":387094,"en":"Jeljetpes, the blessed lion,"},{"id":"seytek-1991-continuation:p0344:b003:l028","ordinal":387095,"en":"Attacked the enemy without looking back;"},{"id":"seytek-1991-continuation:p0344:b003:l029","ordinal":387096,"en":"It was his time to make slaughter."},{"id":"seytek-1991-continuation:p0344:b003:l030","ordinal":387097,"en":"On the qibla side Er Kenen"},{"id":"seytek-1991-continuation:p0344:b003:l031","ordinal":387098,"en":"Wounded everyone he faced,"},{"id":"seytek-1991-continuation:p0344:b003:l032","ordinal":387099,"en":"Threading up and down"},{"id":"seytek-1991-continuation:p0344:b003:l033","ordinal":387100,"en":"Through the countless host."},{"id":"seytek-1991-continuation:p0344:b003:l034","ordinal":387101,"en":"He thrust his spear without turning,"},{"id":"seytek-1991-continuation:p0344:b003:l035","ordinal":387102,"en":"Drenched them in bloody gore,"},{"id":"seytek-1991-continuation:p0344:b003:l036","ordinal":387103,"en":"And fought without retreating."},{"id":"seytek-1991-continuation:p0344:b003:l037","ordinal":387104,"en":"He passed swiftly through their midst,"},{"id":"seytek-1991-continuation:p0344:b003:l038","ordinal":387105,"en":"Spearing those he reached,"},{"id":"seytek-1991-continuation:p0344:b003:l039","ordinal":387106,"en":"Searching for Chyntengir."},{"id":"seytek-1991-continuation:p0344:b003:l040","ordinal":387107,"en":"Having lost the two lions,"},{"id":"seytek-1991-continuation:p0344:b003:l041","ordinal":387108,"en":"Ebegey and Kogoy,"},{"id":"seytek-1991-continuation:p0344:b003:l042","ordinal":387109,"en":"His ribs seemed broken apart;"},{"id":"seytek-1991-continuation:p0344:b003:l043","ordinal":387110,"en":"The world appeared false."},{"id":"seytek-1991-continuation:p0344:b003:l044","ordinal":387111,"en":"Black night fell upon his head,"},{"id":"seytek-1991-continuation:p0344:b003:l045","ordinal":387112,"en":"And a merciless day came;"},{"id":"seytek-1991-continuation:p0344:b003:l046","ordinal":387113,"en":"The night was caught in cloud."},{"id":"seytek-1991-continuation:p0344:b003:l047","ordinal":387114,"en":"Er Kenen, lion against the foe,"},{"id":"seytek-1991-continuation:p0344:b003:l048","ordinal":387115,"en":"Was then surpassing all"},{"id":"seytek-1991-continuation:p0344:b003:l049","ordinal":387116,"en":"In strength and courage."},{"id":"seytek-1991-continuation:p0345:b001:l001","ordinal":387117,"en":"Your gray-maned wolf was then"},{"id":"seytek-1991-continuation:p0345:b001:l002","ordinal":387118,"en":"Withstanding every calamity."},{"id":"seytek-1991-continuation:p0345:b001:l003","ordinal":387119,"en":"He fought without circling in thought,"},{"id":"seytek-1991-continuation:p0345:b001:l004","ordinal":387120,"en":"Grappled without concern,"},{"id":"seytek-1991-continuation:p0345:b001:l005","ordinal":387121,"en":"And began a violent struggle."},{"id":"seytek-1991-continuation:p0345:b001:l006","ordinal":387122,"en":"His precious, matchless life"},{"id":"seytek-1991-continuation:p0345:b001:l007","ordinal":387123,"en":"He cast away, bound by a hair."},{"id":"seytek-1991-continuation:p0345:b002:l001","ordinal":387124,"en":"Until I save our heads"},{"id":"seytek-1991-continuation:p0345:b002:l002","ordinal":387125,"en":"From the imperial host,"},{"id":"seytek-1991-continuation:p0345:b002:l003","ordinal":387126,"en":"For honor and for the people"},{"id":"seytek-1991-continuation:p0345:b002:l004","ordinal":387127,"en":"I will sacrifice my life!"},{"id":"seytek-1991-continuation:p0345:b002:l005","ordinal":387128,"en":"How can I remain alive"},{"id":"seytek-1991-continuation:p0345:b002:l006","ordinal":387129,"en":"While the inherited Kyrgyz people,"},{"id":"seytek-1991-continuation:p0345:b002:l007","ordinal":387130,"en":"The treasure I held dear,"},{"id":"seytek-1991-continuation:p0345:b002:l008","ordinal":387131,"en":"Are taken captive alive?"},{"id":"seytek-1991-continuation:p0345:b002:l009","ordinal":387132,"en":"Thus Er Kenen spoke,"},{"id":"seytek-1991-continuation:p0345:b002:l010","ordinal":387133,"en":"Spoke softly but firmly,"},{"id":"seytek-1991-continuation:p0345:b002:l011","ordinal":387134,"en":"And began addressing Jeljetpes:"},{"id":"seytek-1991-continuation:p0345:b002:l012","ordinal":387135,"en":"“Dear Jeljetpes,"},{"id":"seytek-1991-continuation:p0345:b002:l013","ordinal":387136,"en":"Do not let the Chinese take the land;"},{"id":"seytek-1991-continuation:p0345:b002:l014","ordinal":387137,"en":"Do not let the people be left without descendants;"},{"id":"seytek-1991-continuation:p0345:b002:l015","ordinal":387138,"en":"Do not let them slaughter every living soul."},{"id":"seytek-1991-continuation:p0345:b002:l016","ordinal":387139,"en":"My first forefather had sons one by one;"},{"id":"seytek-1991-continuation:p0345:b002:l017","ordinal":387140,"en":"After long yearning, I, Kenen,"},{"id":"seytek-1991-continuation:p0345:b002:l018","ordinal":387141,"en":"Was blessed with twin boys."},{"id":"seytek-1991-continuation:p0345:b002:l019","ordinal":387142,"en":"I held a feast and slaughtered ninety beasts,"},{"id":"seytek-1991-continuation:p0345:b002:l020","ordinal":387143,"en":"And gave them rhyming names."},{"id":"seytek-1991-continuation:p0345:b002:l021","ordinal":387144,"en":"They are medicine for my breast, my solace,"},{"id":"seytek-1991-continuation:p0345:b002:l022","ordinal":387145,"en":"My two only sons, whom I begged"},{"id":"seytek-1991-continuation:p0345:b002:l023","ordinal":387146,"en":"From God in the open steppe:"},{"id":"seytek-1991-continuation:p0345:b002:l024","ordinal":387147,"en":"My Alymsaryk and Kulansaryk,"},{"id":"seytek-1991-continuation:p0345:b002:l025","ordinal":387148,"en":"The light of my rising morning star."},{"id":"seytek-1991-continuation:p0345:b002:l026","ordinal":387149,"en":"Let them not die before a hidden foe;"},{"id":"seytek-1991-continuation:p0345:b002:l027","ordinal":387150,"en":"Let them not see the place of no return."},{"id":"seytek-1991-continuation:p0345:b002:l028","ordinal":387151,"en":"I entrust my twins to you!"},{"id":"seytek-1991-continuation:p0345:b002:l029","ordinal":387152,"en":"After fighting without rest for many days,"},{"id":"seytek-1991-continuation:p0345:b002:l030","ordinal":387153,"en":"I will let them bind my hands."},{"id":"seytek-1991-continuation:p0345:b002:l031","ordinal":387154,"en":"With the twin heroes following you,"},{"id":"seytek-1991-continuation:p0345:b002:l032","ordinal":387155,"en":"Find, Jeljetpes, a place"},{"id":"seytek-1991-continuation:p0345:b002:l033","ordinal":387156,"en":"Where you can escape alive,"},{"id":"seytek-1991-continuation:p0345:b002:l034","ordinal":387157,"en":"For the sake of the resolve you have made.”"},{"id":"seytek-1991-continuation:p0345:b003:l001","ordinal":387158,"en":"Parted from them,"},{"id":"seytek-1991-continuation:p0345:b004:l001","ordinal":387159,"en":"Thus Er Kenen spoke."},{"id":"seytek-1991-continuation:p0345:b004:l002","ordinal":387160,"en":"At Ak-Kaykan of At-Otpos,"},{"id":"seytek-1991-continuation:p0345:b004:l003","ordinal":387161,"en":"In a ravine no man could tread,"},{"id":"seytek-1991-continuation:p0345:b004:l004","ordinal":387162,"en":"Your gray-maned wolf had surpassed all"},{"id":"seytek-1991-continuation:p0345:b004:l005","ordinal":387163,"en":"In courage and lion-heartedness."},{"id":"seytek-1991-continuation:p0345:b004:l006","ordinal":387164,"en":"He again held back"},{"id":"seytek-1991-continuation:p0345:b004:l007","ordinal":387165,"en":"The infidels who surged upon him."},{"id":"seytek-1991-continuation:p0345:b006:l001","ordinal":387166,"en":"They stood face-to-face,"},{"id":"seytek-1991-continuation:p0345:b006:l002","ordinal":387167,"en":"Firing guns and drawing bows,"},{"id":"seytek-1991-continuation:p0345:b006:l003","ordinal":387168,"en":"Fighting in a bloody crush."},{"id":"seytek-1991-continuation:p0345:b006:l004","ordinal":387169,"en":"Arrows whirred from the bows,"},{"id":"seytek-1991-continuation:p0345:b006:l005","ordinal":387170,"en":"And shattered wherever they struck;"},{"id":"seytek-1991-continuation:p0345:b006:l006","ordinal":387171,"en":"Blood poured with a hiss."},{"id":"seytek-1991-continuation:p0345:b006:l007","ordinal":387172,"en":"Bullets flew like hail—"},{"id":"seytek-1991-continuation:p0345:b006:l008","ordinal":387173,"en":"No trial had ever equaled this!"},{"id":"seytek-1991-continuation:p0345:b006:l009","ordinal":387174,"en":"Through hollows, hills, and valleys,"},{"id":"seytek-1991-continuation:p0345:b006:l010","ordinal":387175,"en":"Black blood flowed rumbling."},{"id":"seytek-1991-continuation:p0345:b006:l011","ordinal":387176,"en":"The battle heaved and swelled;"},{"id":"seytek-1991-continuation:p0345:b006:l012","ordinal":387177,"en":"Dead men lay in heaps,"},{"id":"seytek-1991-continuation:p0345:b006:l013","ordinal":387178,"en":"Dead horses rose like mountains."},{"id":"seytek-1991-continuation:p0345:b006:l014","ordinal":387179,"en":"Every hill was dust,"},{"id":"seytek-1991-continuation:p0345:b006:l015","ordinal":387180,"en":"Every hollow filled with blood;"},{"id":"seytek-1991-continuation:p0345:b006:l016","ordinal":387181,"en":"Now a vast battle raged."},{"id":"seytek-1991-continuation:p0345:b006:l017","ordinal":387182,"en":"Chyntengir received the news."},{"id":"seytek-1991-continuation:p0345:b006:l018","ordinal":387183,"en":"He mounted a dun horse huge as a mountain,"},{"id":"seytek-1991-continuation:p0345:b006:l019","ordinal":387184,"en":"Put on a rippling deep-blue coat,"},{"id":"seytek-1991-continuation:p0345:b006:l020","ordinal":387185,"en":"And advanced, pouring out his rage."},{"id":"seytek-1991-continuation:p0345:b006:l021","ordinal":387186,"en":"He hitched up his belted coat"},{"id":"seytek-1991-continuation:p0345:b006:l022","ordinal":387187,"en":"And bore down upon Kenen,"},{"id":"seytek-1991-continuation:p0345:b006:l023","ordinal":387188,"en":"Who rode Kertulpar."},{"id":"seytek-1991-continuation:p0345:b006:l024","ordinal":387189,"en":"He advanced fearsomely, raising dust,"},{"id":"seytek-1991-continuation:p0345:b006:l025","ordinal":387190,"en":"Intent on reaching him now,"},{"id":"seytek-1991-continuation:p0345:b006:l026","ordinal":387191,"en":"On carrying him off"},{"id":"seytek-1991-continuation:p0345:b006:l027","ordinal":387192,"en":"And riding away unhurried."},{"id":"seytek-1991-continuation:p0345:b006:l028","ordinal":387193,"en":"When he drew near and faced him,"},{"id":"seytek-1991-continuation:p0345:b006:l029","ordinal":387194,"en":"Kenen prayed, “May God aid the solitary man."},{"id":"seytek-1991-continuation:p0345:b006:l030","ordinal":387195,"en":"Darkening like the burning sun,"},{"id":"seytek-1991-continuation:p0345:b006:l031","ordinal":387196,"en":"Let my noble soul depart;"},{"id":"seytek-1991-continuation:p0345:b006:l032","ordinal":387197,"en":"Let me duel with this boastful warrior"},{"id":"seytek-1991-continuation:p0345:b006:l033","ordinal":387198,"en":"And take my pillow beside me.”"},{"id":"seytek-1991-continuation:p0345:b006:l034","ordinal":387199,"en":"Thus Er Kenen spoke"},{"id":"seytek-1991-continuation:p0345:b006:l035","ordinal":387200,"en":"Against the infidel who poured out wrath,"},{"id":"seytek-1991-continuation:p0345:b006:l036","ordinal":387201,"en":"The alien enemy among the people,"},{"id":"seytek-1991-continuation:p0345:b006:l037","ordinal":387202,"en":"The hero Khan Chyntengir."},{"id":"seytek-1991-continuation:p0345:b006:l038","ordinal":387203,"en":"He turned his stallion's head"},{"id":"seytek-1991-continuation:p0345:b006:l039","ordinal":387204,"en":"And at once leveled his spear."},{"id":"seytek-1991-continuation:p0345:b006:l040","ordinal":387205,"en":"Before he could reach Chyntengir,"},{"id":"seytek-1991-continuation:p0345:b006:l041","ordinal":387206,"en":"Before he could strike him with the spear,"},{"id":"seytek-1991-continuation:p0345:b006:l042","ordinal":387207,"en":"Before he could use his great skill"},{"id":"seytek-1991-continuation:p0345:b006:l043","ordinal":387208,"en":"And cunning against the fearsome khan—"},{"id":"seytek-1991-continuation:p0345:b006:l044","ordinal":387209,"en":"Do not ask what Chyntengir was like:"},{"id":"seytek-1991-continuation:p0345:b006:l045","ordinal":387210,"en":"He had an armor-clad body,"},{"id":"seytek-1991-continuation:p0345:b006:l046","ordinal":387211,"en":"And endless speech."},{"id":"seytek-1991-continuation:p0345:b006:l047","ordinal":387212,"en":"His stone-hearted people"},{"id":"seytek-1991-continuation:p0345:b006:l048","ordinal":387213,"en":"Had strength where one equaled a thousand."},{"id":"seytek-1991-continuation:p0345:b006:l049","ordinal":387214,"en":"He had giants whose hunger no feast could sate."},{"id":"seytek-1991-continuation:p0346:b001:l001","ordinal":387215,"en":"Even if a mountain came instead of a man,"},{"id":"seytek-1991-continuation:p0346:b001:l002","ordinal":387216,"en":"They had strength enough to crush it."},{"id":"seytek-1991-continuation:p0346:b001:l003","ordinal":387217,"en":"He had a multitude of marksmen as companions;"},{"id":"seytek-1991-continuation:p0346:b001:l004","ordinal":387218,"en":"The finest of those companions"},{"id":"seytek-1991-continuation:p0346:b001:l005","ordinal":387219,"en":"Was Yengkor of the royal treasury,"},{"id":"seytek-1991-continuation:p0346:b001:l006","ordinal":387220,"en":"The ablest of spearmen,"},{"id":"seytek-1991-continuation:p0346:b001:l007","ordinal":387221,"en":"The finest deviser of stratagems."},{"id":"seytek-1991-continuation:p0346:b001:l008","ordinal":387222,"en":"None could match his horsemanship;"},{"id":"seytek-1991-continuation:p0346:b001:l009","ordinal":387223,"en":"If he narrowed his eye and took aim,"},{"id":"seytek-1991-continuation:p0346:b001:l010","ordinal":387224,"en":"No winged creature escaped alive."},{"id":"seytek-1991-continuation:p0346:b001:l011","ordinal":387225,"en":"He was calamity incarnate,"},{"id":"seytek-1991-continuation:p0346:b001:l012","ordinal":387226,"en":"The trusted support"},{"id":"seytek-1991-continuation:p0346:b001:l013","ordinal":387227,"en":"Of murderous Chyntengir."},{"id":"seytek-1991-continuation:p0346:b001:l014","ordinal":387228,"en":"He was now advancing,"},{"id":"seytek-1991-continuation:p0346:b001:l015","ordinal":387229,"en":"Ready to cast his eye"},{"id":"seytek-1991-continuation:p0346:b001:l016","ordinal":387230,"en":"Upon the gray-maned wolf, Er Kenen."},{"id":"seytek-1991-continuation:p0346:b001:l017","ordinal":387231,"en":"Er Kenen's Kertulpar"},{"id":"seytek-1991-continuation:p0346:b001:l018","ordinal":387232,"en":"Trailed a tail like a parrot's."},{"id":"seytek-1991-continuation:p0346:b001:l019","ordinal":387233,"en":"If a ninety-day desert lay ahead,"},{"id":"seytek-1991-continuation:p0346:b001:l020","ordinal":387234,"en":"He galloped without slowing."},{"id":"seytek-1991-continuation:p0346:b001:l021","ordinal":387235,"en":"He was a beast close to a demon,"},{"id":"seytek-1991-continuation:p0346:b001:l022","ordinal":387236,"en":"Endowed with the nature of a tulpar."},{"id":"seytek-1991-continuation:p0346:b001:l023","ordinal":387237,"en":"Yengkor aimed at Kertulpar,"},{"id":"seytek-1991-continuation:p0346:b001:l024","ordinal":387238,"en":"Taking the shoulder blade as his mark,"},{"id":"seytek-1991-continuation:p0346:b001:l025","ordinal":387239,"en":"The edge of the thick neck,"},{"id":"seytek-1991-continuation:p0346:b001:l026","ordinal":387240,"en":"The place where the spine would break,"},{"id":"seytek-1991-continuation:p0346:b001:l027","ordinal":387241,"en":"The very center of his measure,"},{"id":"seytek-1991-continuation:p0346:b001:l028","ordinal":387242,"en":"The dark pupil of death."},{"id":"seytek-1991-continuation:p0346:b001:l029","ordinal":387243,"en":"He measured carefully and fired."},{"id":"seytek-1991-continuation:p0346:b001:l030","ordinal":387244,"en":"Kertulpar beneath Kenen"},{"id":"seytek-1991-continuation:p0346:b001:l031","ordinal":387245,"en":"Reared and crashed down."},{"id":"seytek-1991-continuation:p0346:b001:l032","ordinal":387246,"en":"Stricken with boundless grief,"},{"id":"seytek-1991-continuation:p0346:b001:l033","ordinal":387247,"en":"Parted from Kertulpar,"},{"id":"seytek-1991-continuation:p0346:b001:l034","ordinal":387248,"en":"Surrounded on every side by troops,"},{"id":"seytek-1991-continuation:p0346:b001:l035","ordinal":387249,"en":"With abundant misery boiling,"},{"id":"seytek-1991-continuation:p0346:b001:l036","ordinal":387250,"en":"With neither battle cry nor people,"},{"id":"seytek-1991-continuation:p0346:b001:l037","ordinal":387251,"en":"Er Kenen stood alone in the fight."},{"id":"seytek-1991-continuation:p0346:b001:l038","ordinal":387252,"en":"He had no sheltering people around him,"},{"id":"seytek-1991-continuation:p0346:b001:l039","ordinal":387253,"en":"No stallion to mount when wearied,"},{"id":"seytek-1991-continuation:p0346:b001:l040","ordinal":387254,"en":"No Ebegey or Kogoy,"},{"id":"seytek-1991-continuation:p0346:b001:l041","ordinal":387255,"en":"Those heroes who waged mighty battle"},{"id":"seytek-1991-continuation:p0346:b001:l042","ordinal":387256,"en":"And came to rescue him."},{"id":"seytek-1991-continuation:p0346:b001:l043","ordinal":387257,"en":"He despaired of his dear life."},{"id":"seytek-1991-continuation:p0346:b001:l044","ordinal":387258,"en":"“Now I will capture this shameless man"},{"id":"seytek-1991-continuation:p0346:b001:l045","ordinal":387259,"en":"Who has been left without a horse,”"},{"id":"seytek-1991-continuation:p0346:b001:l046","ordinal":387260,"en":"Thought the boastful hero Yengkor."},{"id":"seytek-1991-continuation:p0346:b001:l047","ordinal":387261,"en":"Thinking himself a lion,"},{"id":"seytek-1991-continuation:p0346:b001:l048","ordinal":387262,"en":"That madman believed himself alone"},{"id":"seytek-1991-continuation:p0346:b001:l049","ordinal":387263,"en":"Equal to the whole world,"},{"id":"seytek-1991-continuation:p0346:b003:l001","ordinal":387264,"en":"And came striding near."},{"id":"seytek-1991-continuation:p0346:b003:l002","ordinal":387265,"en":"The lion Kenen saw him."},{"id":"seytek-1991-continuation:p0346:b003:l003","ordinal":387266,"en":"His nar-kesken was in his hand;"},{"id":"seytek-1991-continuation:p0346:b003:l004","ordinal":387267,"en":"He seized it firmly by the hilt"},{"id":"seytek-1991-continuation:p0346:b003:l005","ordinal":387268,"en":"And drew the sword"},{"id":"seytek-1991-continuation:p0346:b003:l006","ordinal":387269,"en":"From its sheath."},{"id":"seytek-1991-continuation:p0346:b003:l007","ordinal":387270,"en":"The hero and lion without a steed"},{"id":"seytek-1991-continuation:p0346:b003:l008","ordinal":387271,"en":"Neither hurried nor faltered."},{"id":"seytek-1991-continuation:p0346:b003:l009","ordinal":387272,"en":"Thinking, “Here at last is death,”"},{"id":"seytek-1991-continuation:p0346:b003:l010","ordinal":387273,"en":"He valued torment and death"},{"id":"seytek-1991-continuation:p0346:b003:l011","ordinal":387274,"en":"No more than a trouser cuff,"},{"id":"seytek-1991-continuation:p0346:b003:l012","ordinal":387275,"en":"For the Lord himself"},{"id":"seytek-1991-continuation:p0346:b003:l013","ordinal":387276,"en":"Had bestowed upon him"},{"id":"seytek-1991-continuation:p0346:b003:l014","ordinal":387277,"en":"Measureless courage."},{"id":"seytek-1991-continuation:p0346:b003:l015","ordinal":387278,"en":"He gripped and whirled the sword."},{"id":"seytek-1991-continuation:p0346:b003:l016","ordinal":387279,"en":"When the boar-like swine"},{"id":"seytek-1991-continuation:p0346:b003:l017","ordinal":387280,"en":"Came within cutting distance,"},{"id":"seytek-1991-continuation:p0346:b003:l018","ordinal":387281,"en":"He struck him across the neck."},{"id":"seytek-1991-continuation:p0346:b003:l019","ordinal":387282,"en":"The sword reached him with a whistle;"},{"id":"seytek-1991-continuation:p0346:b003:l020","ordinal":387283,"en":"From artery and neck flesh"},{"id":"seytek-1991-continuation:p0346:b003:l021","ordinal":387284,"en":"Black blood hissed."},{"id":"seytek-1991-continuation:p0346:b003:l022","ordinal":387285,"en":"His head, huge as a yurt,"},{"id":"seytek-1991-continuation:p0346:b003:l023","ordinal":387286,"en":"Tumbled rattling to the ground;"},{"id":"seytek-1991-continuation:p0346:b003:l024","ordinal":387287,"en":"Yengkor fell dead."},{"id":"seytek-1991-continuation:p0346:b003:l025","ordinal":387288,"en":"Fearsome Tengir saw"},{"id":"seytek-1991-continuation:p0346:b003:l026","ordinal":387289,"en":"That Yengkor had died."},{"id":"seytek-1991-continuation:p0346:b003:l027","ordinal":387290,"en":"He threw the whole world into panic,"},{"id":"seytek-1991-continuation:p0346:b003:l028","ordinal":387291,"en":"Spurring onward Kula-ker beneath him."},{"id":"seytek-1991-continuation:p0346:b003:l029","ordinal":387292,"en":"He shouted to his mace-men,"},{"id":"seytek-1991-continuation:p0346:b003:l030","ordinal":387293,"en":"Calling his great champions:"},{"id":"seytek-1991-continuation:p0346:b003:l031","ordinal":387294,"en":"“There is one Burut and a multitude of you;"},{"id":"seytek-1991-continuation:p0346:b003:l032","ordinal":387295,"en":"What kind of people are the tribal Chinese?"},{"id":"seytek-1991-continuation:p0346:b003:l033","ordinal":387296,"en":"Surge, Manchus, surge!"},{"id":"seytek-1991-continuation:p0346:b003:l034","ordinal":387297,"en":"Knead him into the earth and trample him!”"},{"id":"seytek-1991-continuation:p0346:b003:l035","ordinal":387298,"en":"Shouting for his spear of greatest havoc,"},{"id":"seytek-1991-continuation:p0346:b003:l036","ordinal":387299,"en":"The huge spear made by Ebegey,"},{"id":"seytek-1991-continuation:p0346:b003:l037","ordinal":387300,"en":"He bellowed and cried,"},{"id":"seytek-1991-continuation:p0346:b003:l038","ordinal":387301,"en":"Bending and flattening birch and willow,"},{"id":"seytek-1991-continuation:p0346:b003:l039","ordinal":387302,"en":"And summoned his countless champions."},{"id":"seytek-1991-continuation:p0346:b003:l040","ordinal":387303,"en":"At the horseless, weakened Kenen,"},{"id":"seytek-1991-continuation:p0346:b003:l041","ordinal":387304,"en":"To deprive him of every escape,"},{"id":"seytek-1991-continuation:p0346:b003:l042","ordinal":387305,"en":"Chyntengir strained and aimed,"},{"id":"seytek-1991-continuation:p0346:b003:l043","ordinal":387306,"en":"Taking the place beneath the heart,"},{"id":"seytek-1991-continuation:p0346:b003:l044","ordinal":387307,"en":"The measured edge of the lung,"},{"id":"seytek-1991-continuation:p0346:b003:l045","ordinal":387308,"en":"The exact center of his aim:"},{"id":"seytek-1991-continuation:p0346:b003:l046","ordinal":387309,"en":"“Even if he had a hundred thousand lives,"},{"id":"seytek-1991-continuation:p0346:b003:l047","ordinal":387310,"en":"They would all fly out here.”"},{"id":"seytek-1991-continuation:p0346:b003:l048","ordinal":387311,"en":"He turned his stallion's head,"},{"id":"seytek-1991-continuation:p0346:b003:l049","ordinal":387312,"en":"And his eyes blazed like fire."},{"id":"seytek-1991-continuation:p0347:b001:l001","ordinal":387313,"en":"His raging fury boiled over."},{"id":"seytek-1991-continuation:p0347:b001:l002","ordinal":387314,"en":"As he was about to strike with his spear,"},{"id":"seytek-1991-continuation:p0347:b001:l003","ordinal":387315,"en":"The hero and lion,"},{"id":"seytek-1991-continuation:p0347:b001:l004","ordinal":387316,"en":"Swift beyond measure,"},{"id":"seytek-1991-continuation:p0347:b001:l005","ordinal":387317,"en":"The most perceptive sage,"},{"id":"seytek-1991-continuation:p0347:b001:l006","ordinal":387318,"en":"Ground his teeth like millstones."},{"id":"seytek-1991-continuation:p0347:b001:l007","ordinal":387319,"en":"His eyes flashed like a lion's;"},{"id":"seytek-1991-continuation:p0347:b001:l008","ordinal":387320,"en":"He thrust and whirled the sword."},{"id":"seytek-1991-continuation:p0347:b001:l009","ordinal":387321,"en":"Er Kenen struck the dun horse"},{"id":"seytek-1991-continuation:p0347:b001:l010","ordinal":387322,"en":"At the place the poor hero had chosen,"},{"id":"seytek-1991-continuation:p0347:b001:l011","ordinal":387323,"en":"Drawing the blade across it."},{"id":"seytek-1991-continuation:p0347:b001:l012","ordinal":387324,"en":"When Kenen performed that feat,"},{"id":"seytek-1991-continuation:p0347:b001:l013","ordinal":387325,"en":"When he brought the sword down true,"},{"id":"seytek-1991-continuation:p0347:b001:l014","ordinal":387326,"en":"The champion Chyntengir's"},{"id":"seytek-1991-continuation:p0347:b001:l015","ordinal":387327,"en":"True stallion toppled."},{"id":"seytek-1991-continuation:p0347:b001:l016","ordinal":387328,"en":"Its house-sized head fell;"}]
