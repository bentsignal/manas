[{"id":"semetey-1-2013:p1237:b003:l028","ordinal":171521,"en":"And bring good news"},{"id":"semetey-1-2013:p1237:b003:l029","ordinal":171522,"en":"To my heroic uncle and lord."},{"id":"semetey-1-2013:p1237:b003:l030","ordinal":171523,"en":"At least I might ask for"},{"id":"semetey-1-2013:p1237:b003:l031","ordinal":171524,"en":"The khanship of the Argyn,\""},{"id":"semetey-1-2013:p1237:b003:l032","ordinal":171525,"en":"He thought, aiming for the shoulder blade,"},{"id":"semetey-1-2013:p1237:b003:l033","ordinal":171526,"en":"For the lower edge of the lung."},{"id":"semetey-1-2013:p1237:b003:l034","ordinal":171527,"en":"He entered measuring his thrust."},{"id":"semetey-1-2013:p1237:b003:l035","ordinal":171528,"en":"The armor upon the shoulder blade,"},{"id":"semetey-1-2013:p1237:b003:l036","ordinal":171529,"en":"Iron no spear could pierce—"},{"id":"semetey-1-2013:p1237:b003:l037","ordinal":171530,"en":"\"If by chance I thrust astray,"},{"id":"semetey-1-2013:p1237:b003:l038","ordinal":171531,"en":"I will remain in regret.\""},{"id":"semetey-1-2013:p1237:b003:l039","ordinal":171532,"en":"He aimed for the backbone,"},{"id":"semetey-1-2013:p1237:b004:l001","ordinal":171533,"en":"For the lower edge of the heart,"},{"id":"semetey-1-2013:p1237:b004:l002","ordinal":171534,"en":"And drove in the spear."},{"id":"semetey-1-2013:p1237:b004:l003","ordinal":171535,"en":"The armor upon the backbone"},{"id":"semetey-1-2013:p1237:b004:l004","ordinal":171536,"en":"Was iron no spear could pierce."},{"id":"semetey-1-2013:p1237:b004:l005","ordinal":171537,"en":"\"If I collide by chance"},{"id":"semetey-1-2013:p1237:b004:l006","ordinal":171538,"en":"And thrust astray by accident,"},{"id":"semetey-1-2013:p1237:b004:l007","ordinal":171539,"en":"God will take me thus;"},{"id":"semetey-1-2013:p1237:b004:l008","ordinal":171540,"en":"It will become a mistake."},{"id":"semetey-1-2013:p1237:b004:l009","ordinal":171541,"en":"If by chance it happens so,"},{"id":"semetey-1-2013:p1237:b004:l010","ordinal":171542,"en":"God will take me.\""},{"id":"semetey-1-2013:p1237:b004:l011","ordinal":171543,"en":"Kulchoro lowered his aim"},{"id":"semetey-1-2013:p1237:b004:l012","ordinal":171544,"en":"Toward the lower skirt"},{"id":"semetey-1-2013:p1237:b004:l013","ordinal":171545,"en":"Of the bulletproof armor."},{"id":"semetey-1-2013:p1237:b004:l014","ordinal":171546,"en":"\"If I thrust hard there,"},{"id":"semetey-1-2013:p1237:b004:l015","ordinal":171547,"en":"At the edge of the backbone,"},{"id":"semetey-1-2013:p1237:b004:l016","ordinal":171548,"en":"If I strike true then,"},{"id":"semetey-1-2013:p1237:b004:l017","ordinal":171549,"en":"At the edge of the bladder.\""},{"id":"semetey-1-2013:p1237:b004:l018","ordinal":171550,"en":"He gripped the spear enormously"},{"id":"semetey-1-2013:p1237:b004:l019","ordinal":171551,"en":"And used exceptional cunning."},{"id":"semetey-1-2013:p1237:b004:l020","ordinal":171552,"en":"Seizing and swinging"},{"id":"semetey-1-2013:p1237:b004:l021","ordinal":171553,"en":"The leopard's patterned spear,"},{"id":"semetey-1-2013:p1237:b004:l022","ordinal":171554,"en":"Without sparing his dear life,"},{"id":"semetey-1-2013:p1237:b004:l023","ordinal":171555,"en":"He drove it firmly"},{"id":"semetey-1-2013:p1237:b004:l024","ordinal":171556,"en":"Into hero Toltoy's fat rump."},{"id":"semetey-1-2013:p1237:b004:l025","ordinal":171557,"en":"When the spear struck hero Toltoy,"},{"id":"semetey-1-2013:p1237:b004:l026","ordinal":171558,"en":"From the edge of the fat rump"},{"id":"semetey-1-2013:p1237:b004:l027","ordinal":171559,"en":"It failed to reach the bladder,"},{"id":"semetey-1-2013:p1237:b004:l028","ordinal":171560,"en":"Two fingers below its edge,"},{"id":"semetey-1-2013:p1237:b004:l029","ordinal":171561,"en":"It struck astray."},{"id":"semetey-1-2013:p1237:b004:l030","ordinal":171562,"en":"Toltoy's thick flesh"},{"id":"semetey-1-2013:p1237:b004:l031","ordinal":171563,"en":"Held it back with flesh;"},{"id":"semetey-1-2013:p1237:b004:l032","ordinal":171564,"en":"Toltoy's thick coat"},{"id":"semetey-1-2013:p1237:b004:l033","ordinal":171565,"en":"Held it back with cloth;"},{"id":"semetey-1-2013:p1237:b004:l034","ordinal":171566,"en":"The spirit of his father, hero Bagysh,"},{"id":"semetey-1-2013:p1237:b004:l035","ordinal":171567,"en":"Raised and protected him greatly."},{"id":"semetey-1-2013:p1237:b004:l036","ordinal":171568,"en":"Skirting the bone of the lower back,"},{"id":"semetey-1-2013:p1237:b004:l037","ordinal":171569,"en":"The valiant spear reached him"},{"id":"semetey-1-2013:p1237:b004:l038","ordinal":171570,"en":"And sank four fingers deep"},{"id":"semetey-1-2013:p1237:b004:l039","ordinal":171571,"en":"Into his buttock."},{"id":"semetey-1-2013:p1238:b003:l001","ordinal":171572,"en":"Hero Toltoy of the Jediger,"},{"id":"semetey-1-2013:p1238:b003:l002","ordinal":171573,"en":"When the spear struck him,"},{"id":"semetey-1-2013:p1238:b003:l003","ordinal":171574,"en":"Cried, \"Ah, alas, my back!\""},{"id":"semetey-1-2013:p1238:b003:l004","ordinal":171575,"en":"His eyes darted,"},{"id":"semetey-1-2013:p1238:b003:l005","ordinal":171576,"en":"His legs dangled loose."},{"id":"semetey-1-2013:p1238:b003:l006","ordinal":171577,"en":"Surkoen ran uncontrollably;"},{"id":"semetey-1-2013:p1238:b003:l007","ordinal":171578,"en":"Toltoy of the Jediger"},{"id":"semetey-1-2013:p1238:b003:l008","ordinal":171579,"en":"Despaired of his entrusted life."},{"id":"semetey-1-2013:p1238:b003:l009","ordinal":171580,"en":"His senses failed and he reeled,"},{"id":"semetey-1-2013:p1238:b003:l010","ordinal":171581,"en":"Despairing of his poor life."},{"id":"semetey-1-2013:p1238:b003:l011","ordinal":171582,"en":"\"I have seen the place of Judgment Day;"},{"id":"semetey-1-2013:p1238:b003:l012","ordinal":171583,"en":"My accursed wretched soul is dead."},{"id":"semetey-1-2013:p1238:b003:l013","ordinal":171584,"en":"I was a mighty man, poor soul,"},{"id":"semetey-1-2013:p1238:b003:l014","ordinal":171585,"en":"And guarded myself for so long."},{"id":"semetey-1-2013:p1238:b003:l015","ordinal":171586,"en":"I have been caught by chance"},{"id":"semetey-1-2013:p1238:b003:l016","ordinal":171587,"en":"By this mighty-born stripling."},{"id":"semetey-1-2013:p1238:b003:l017","ordinal":171588,"en":"He is a boy of twelve—"},{"id":"semetey-1-2013:p1238:b003:l018","ordinal":171589,"en":"Must I suffer at his hands?"},{"id":"semetey-1-2013:p1238:b003:l019","ordinal":171590,"en":"My devices fail me here;"},{"id":"semetey-1-2013:p1238:b003:l020","ordinal":171591,"en":"Will I die before my destined death?\""},{"id":"semetey-1-2013:p1238:b003:l021","ordinal":171592,"en":"Hero Toltoy, wracked with pain,"},{"id":"semetey-1-2013:p1238:b003:l022","ordinal":171593,"en":"His temples tightened,"},{"id":"semetey-1-2013:p1238:b003:l023","ordinal":171594,"en":"And he quarreled with Surkoen:"},{"id":"semetey-1-2013:p1238:b003:l024","ordinal":171595,"en":"\"Damn you, Surkoen!"},{"id":"semetey-1-2013:p1238:b003:l025","ordinal":171596,"en":"You were a swift stallion,"},{"id":"semetey-1-2013:p1238:b003:l026","ordinal":171597,"en":"In the prime of your flesh,"},{"id":"semetey-1-2013:p1238:b003:l027","ordinal":171598,"en":"At the height of your speed."},{"id":"semetey-1-2013:p1238:b003:l028","ordinal":171599,"en":"Did the enemy slaughter and plunder you?"},{"id":"semetey-1-2013:p1238:b003:l029","ordinal":171600,"en":"Damn you, may your road be blessed—"},{"id":"semetey-1-2013:p1238:b003:l030","ordinal":171601,"en":"Has Satan hobbled you?\""},{"id":"semetey-1-2013:p1238:b003:l031","ordinal":171602,"en":"Fortunate hero Toltoy"},{"id":"semetey-1-2013:p1238:b003:l032","ordinal":171603,"en":"Spoke of his calamity."},{"id":"semetey-1-2013:p1238:b003:l033","ordinal":171604,"en":"At twelve, Kulchoro,"},{"id":"semetey-1-2013:p1238:b003:l034","ordinal":171605,"en":"The stripling who crossed his road,"},{"id":"semetey-1-2013:p1238:b003:l035","ordinal":171606,"en":"Had devoured hero Toltoy."},{"id":"semetey-1-2013:p1238:b003:l036","ordinal":171607,"en":"His backbone throbbed with pain,"},{"id":"semetey-1-2013:p1238:b003:l037","ordinal":171608,"en":"And the fly-like soul"},{"id":"semetey-1-2013:p1238:b003:l038","ordinal":171609,"en":"Of the lord who came for a wife shrieked."},{"id":"semetey-1-2013:p1238:b003:l039","ordinal":171610,"en":"The pain became severe;"},{"id":"semetey-1-2013:p1238:b004:l001","ordinal":171611,"en":"His spine ached and tightened."},{"id":"semetey-1-2013:p1238:b004:l002","ordinal":171612,"en":"Hero Toltoy rode raging,"},{"id":"semetey-1-2013:p1238:b004:l003","ordinal":171613,"en":"Quarreling with Chynkojo:"},{"id":"semetey-1-2013:p1238:b004:l004","ordinal":171614,"en":"\"I was returning thoughtfully to the camp,"},{"id":"semetey-1-2013:p1238:b004:l005","ordinal":171615,"en":"But this exile lay in wait for me;"},{"id":"semetey-1-2013:p1238:b004:l006","ordinal":171616,"en":"This fugitive has reached me,"},{"id":"semetey-1-2013:p1238:b004:l007","ordinal":171617,"en":"Driving me to my end."},{"id":"semetey-1-2013:p1238:b004:l008","ordinal":171618,"en":"Never heeding words,"},{"id":"semetey-1-2013:p1238:b004:l009","ordinal":171619,"en":"The accursed fugitive slave"},{"id":"semetey-1-2013:p1238:b004:l010","ordinal":171620,"en":"Has dug my grave,"},{"id":"semetey-1-2013:p1238:b004:l011","ordinal":171621,"en":"Saying, 'Seize his wife,'"},{"id":"semetey-1-2013:p1238:b004:l012","ordinal":171622,"en":"And confronting me on a dark day,"},{"id":"semetey-1-2013:p1238:b004:l013","ordinal":171623,"en":"Has performed a fine deed.\""},{"id":"semetey-1-2013:p1238:b004:l014","ordinal":171624,"en":"Toltoy despaired of life."},{"id":"semetey-1-2013:p1238:b004:l015","ordinal":171625,"en":"Arbuudan flew like an arrow"},{"id":"semetey-1-2013:p1238:b004:l016","ordinal":171626,"en":"And ran past Toltoy."},{"id":"semetey-1-2013:p1238:b004:l017","ordinal":171627,"en":"When gray-maned Toltoy saw it,"},{"id":"semetey-1-2013:p1238:b004:l018","ordinal":171628,"en":"He plainly despaired of life."},{"id":"semetey-1-2013:p1238:b004:l019","ordinal":171629,"en":"\"This boy is a fool;"},{"id":"semetey-1-2013:p1238:b004:l020","ordinal":171630,"en":"If he recovers, he will not act rightly."},{"id":"semetey-1-2013:p1238:b004:l021","ordinal":171631,"en":"If he turns back recovered,"},{"id":"semetey-1-2013:p1238:b004:l022","ordinal":171632,"en":"He will not leave my poor life whole."},{"id":"semetey-1-2013:p1238:b004:l023","ordinal":171633,"en":"I will cut off with my sword"},{"id":"semetey-1-2013:p1238:b004:l024","ordinal":171634,"en":"The head of the boy who comes before me."},{"id":"semetey-1-2013:p1238:b004:l025","ordinal":171635,"en":"Before the accursed boy"},{"id":"semetey-1-2013:p1238:b004:l026","ordinal":171636,"en":"Can glance back and turn,"},{"id":"semetey-1-2013:p1238:b004:l027","ordinal":171637,"en":"I will make a spectacle of him!\""},{"id":"semetey-1-2013:p1238:b004:l028","ordinal":171638,"en":"Hero Toltoy of the Jediger"},{"id":"semetey-1-2013:p1238:b004:l029","ordinal":171639,"en":"Was one of the accomplished heroes."},{"id":"semetey-1-2013:p1238:b004:l030","ordinal":171640,"en":"Before the boy could turn back,"},{"id":"semetey-1-2013:p1238:b004:l031","ordinal":171641,"en":"He drew from its sheath"},{"id":"semetey-1-2013:p1238:b004:l032","ordinal":171642,"en":"His sword, sharp as Arkesken."},{"id":"semetey-1-2013:p1238:b004:l033","ordinal":171643,"en":"When his opportunity came,"},{"id":"semetey-1-2013:p1238:b004:l034","ordinal":171644,"en":"Dear spirited hero Toltoy"},{"id":"semetey-1-2013:p1238:b004:l035","ordinal":171645,"en":"Was set to take his head with the sword."},{"id":"semetey-1-2013:p1238:b004:l036","ordinal":171646,"en":"Before the boy could wheel around,"},{"id":"semetey-1-2013:p1238:b004:l037","ordinal":171647,"en":"When he looked at Kulchoro,"},{"id":"semetey-1-2013:p1238:b004:l038","ordinal":171648,"en":"The wretched young lord—"},{"id":"semetey-1-2013:p1238:b004:l039","ordinal":171649,"en":"At one glance he was one man,"},{"id":"semetey-1-2013:p1239:b003:l001","ordinal":171650,"en":"One glance showed a thousand men."},{"id":"semetey-1-2013:p1239:b003:l002","ordinal":171651,"en":"Toltoi, who had taken up his sword—"},{"id":"semetey-1-2013:p1239:b003:l003","ordinal":171652,"en":"The sword came out of its sheath."},{"id":"semetey-1-2013:p1239:b003:l004","ordinal":171653,"en":"When he saw the prowess"},{"id":"semetey-1-2013:p1239:b003:l005","ordinal":171654,"en":"Of the child blessed by Kydyr,"},{"id":"semetey-1-2013:p1239:b003:l006","ordinal":171655,"en":"Dear hero Toltoi’s"},{"id":"semetey-1-2013:p1239:b003:l007","ordinal":171656,"en":"Fly-like soul shriveled."},{"id":"semetey-1-2013:p1239:b003:l008","ordinal":171657,"en":"The Forty Saints and Kydyr Ilyas,"},{"id":"semetey-1-2013:p1239:b003:l009","ordinal":171658,"en":"Many mighty warriors,"},{"id":"semetey-1-2013:p1239:b003:l010","ordinal":171659,"en":"Surrounded the boy."},{"id":"semetey-1-2013:p1239:b003:l011","ordinal":171660,"en":"When he saw their support,"},{"id":"semetey-1-2013:p1239:b003:l012","ordinal":171661,"en":"God bound the hand"},{"id":"semetey-1-2013:p1239:b003:l013","ordinal":171662,"en":"Of your mountain-like Khan Toltoi."},{"id":"semetey-1-2013:p1239:b003:l014","ordinal":171663,"en":"To strike with the sword,"},{"id":"semetey-1-2013:p1239:b003:l015","ordinal":171664,"en":"His great hand had been raised;"},{"id":"semetey-1-2013:p1239:b003:l016","ordinal":171665,"en":"God struck Toltoi,"},{"id":"semetey-1-2013:p1239:b003:l017","ordinal":171666,"en":"And with the sword in his right hand,"},{"id":"semetey-1-2013:p1239:b003:l018","ordinal":171667,"en":"Fixed it above his head."},{"id":"semetey-1-2013:p1239:b003:l019","ordinal":171668,"en":"However he shook it, the dear hand would not fall—"},{"id":"semetey-1-2013:p1239:b003:l020","ordinal":171669,"en":"God had struck Toltoi."},{"id":"semetey-1-2013:p1239:b003:l021","ordinal":171670,"en":"Arbuurul, flying like an arrow,"},{"id":"semetey-1-2013:p1239:b003:l022","ordinal":171671,"en":"Ran and vanished;"},{"id":"semetey-1-2013:p1239:b003:l023","ordinal":171672,"en":"Behind hero Toltoi,"},{"id":"semetey-1-2013:p1239:b003:l024","ordinal":171673,"en":"Young prince Külchoro"},{"id":"semetey-1-2013:p1239:b003:l025","ordinal":171674,"en":"Regained his line and pursued."},{"id":"semetey-1-2013:p1239:b003:l026","ordinal":171675,"en":"Toltoi truly burned with grief;"},{"id":"semetey-1-2013:p1239:b003:l027","ordinal":171676,"en":"When he saw Choro’s form,"},{"id":"semetey-1-2013:p1239:b003:l028","ordinal":171677,"en":"Hero Toltoi started in fear"},{"id":"semetey-1-2013:p1239:b003:l029","ordinal":171678,"en":"And despaired of his fly-like life."},{"id":"semetey-1-2013:p1239:b003:l030","ordinal":171679,"en":"“His raised armpit,"},{"id":"semetey-1-2013:p1239:b003:l031","ordinal":171680,"en":"The gland at the center of the armpit—"},{"id":"semetey-1-2013:p1239:b003:l032","ordinal":171681,"en":"If I can wound that gland,"},{"id":"semetey-1-2013:p1239:b003:l033","ordinal":171682,"en":"For Toltoi standing there,"},{"id":"semetey-1-2013:p1239:b003:l034","ordinal":171683,"en":"It will be the moment his life departs.”"},{"id":"semetey-1-2013:p1239:b003:l035","ordinal":171684,"en":"He turned Buurul’s head,"},{"id":"semetey-1-2013:p1239:b003:l036","ordinal":171685,"en":"And at the wild-eyed Toltoi"},{"id":"semetey-1-2013:p1239:b003:l037","ordinal":171686,"en":"He leveled his spear once more."},{"id":"semetey-1-2013:p1239:b003:l038","ordinal":171687,"en":"Saying, “At the armpit itself,”"},{"id":"semetey-1-2013:p1239:b003:l039","ordinal":171688,"en":"The young leopard prince"},{"id":"semetey-1-2013:p1239:b004:l001","ordinal":171689,"en":"Drove his spear again."},{"id":"semetey-1-2013:p1239:b004:l002","ordinal":171690,"en":"Missing the armpit, Syrnaiza"},{"id":"semetey-1-2013:p1239:b004:l003","ordinal":171691,"en":"Glanced upward and passed;"},{"id":"semetey-1-2013:p1239:b004:l004","ordinal":171692,"en":"It grazed"},{"id":"semetey-1-2013:p1239:b004:l005","ordinal":171693,"en":"The blue flesh of his neck."},{"id":"semetey-1-2013:p1239:b004:l006","ordinal":171694,"en":"Just as he was about to spear Toltoi,"},{"id":"semetey-1-2013:p1239:b004:l007","ordinal":171695,"en":"Just as he was about to cast him into hell,"},{"id":"semetey-1-2013:p1239:b004:l008","ordinal":171696,"en":"He gripped and swung Syrnaiza;"},{"id":"semetey-1-2013:p1239:b004:l009","ordinal":171697,"en":"But the white reins soaked in dye"},{"id":"semetey-1-2013:p1239:b004:l010","ordinal":171698,"en":"He had let go free—"},{"id":"semetey-1-2013:p1239:b004:l011","ordinal":171699,"en":"His youth became apparent."},{"id":"semetey-1-2013:p1239:b004:l012","ordinal":171700,"en":"The reins soaked in dye,"},{"id":"semetey-1-2013:p1239:b004:l013","ordinal":171701,"en":"As though misfortune had struck,"},{"id":"semetey-1-2013:p1239:b004:l014","ordinal":171702,"en":"Caught around the pastern,"},{"id":"semetey-1-2013:p1239:b004:l015","ordinal":171703,"en":"As though hobbling him;"},{"id":"semetey-1-2013:p1239:b004:l016","ordinal":171704,"en":"Taibuurul stood still,"},{"id":"semetey-1-2013:p1239:b004:l017","ordinal":171705,"en":"Shaking his head, unable to move."},{"id":"semetey-1-2013:p1239:b004:l018","ordinal":171706,"en":"Taibuurul refused to step."},{"id":"semetey-1-2013:p1239:b004:l019","ordinal":171707,"en":"God had struck the boy;"},{"id":"semetey-1-2013:p1239:b004:l020","ordinal":171708,"en":"Buurul stood entangled."},{"id":"semetey-1-2013:p1239:b004:l021","ordinal":171709,"en":"Külchoro flew like an arrow,"},{"id":"semetey-1-2013:p1239:b004:l022","ordinal":171710,"en":"Turning in fury,"},{"id":"semetey-1-2013:p1239:b004:l023","ordinal":171711,"en":"But the oversized great reins"},{"id":"semetey-1-2013:p1239:b004:l024","ordinal":171712,"en":"Wrapped around the hock;"},{"id":"semetey-1-2013:p1239:b004:l025","ordinal":171713,"en":"Buurul stood unable to move."},{"id":"semetey-1-2013:p1239:b004:l026","ordinal":171714,"en":"Not knowing the enemy’s craft,"},{"id":"semetey-1-2013:p1239:b004:l027","ordinal":171715,"en":"God had struck Choro."},{"id":"semetey-1-2013:p1239:b004:l028","ordinal":171716,"en":"Külchoro was twelve;"},{"id":"semetey-1-2013:p1239:b004:l029","ordinal":171717,"en":"He had not yet known an enemy’s worth,"},{"id":"semetey-1-2013:p1239:b004:l030","ordinal":171718,"en":"Had not yet driven an enemy stumbling."},{"id":"semetey-1-2013:p1239:b004:l031","ordinal":171719,"en":"Before this, Külchoro"},{"id":"semetey-1-2013:p1239:b004:l032","ordinal":171720,"en":"Had never ridden out and struck a foe."},{"id":"semetey-1-2013:p1239:b004:l033","ordinal":171721,"en":"Külchoro struggled frantically,"},{"id":"semetey-1-2013:p1239:b004:l034","ordinal":171722,"en":"His brow tightening in strain;"},{"id":"semetey-1-2013:p1239:b004:l035","ordinal":171723,"en":"Unable to find his bearings,"},{"id":"semetey-1-2013:p1239:b004:l036","ordinal":171724,"en":"He fought with Taibuurul."},{"id":"semetey-1-2013:p1239:b004:l037","ordinal":171725,"en":"“A plane tree left without water—"},{"id":"semetey-1-2013:p1239:b004:l038","ordinal":171726,"en":"Unable to catch hero Toltoi,"},{"id":"semetey-1-2013:p1239:b004:l039","ordinal":171727,"en":"Our fortune has been bound.”"},{"id":"semetey-1-2013:p1240:b003:l001","ordinal":171728,"en":"My brow bone must be ill-shaped;"},{"id":"semetey-1-2013:p1240:b003:l002","ordinal":171729,"en":"I let a fleeing soul escape."},{"id":"semetey-1-2013:p1240:b003:l003","ordinal":171730,"en":"May this vile, false world be desolate—"},{"id":"semetey-1-2013:p1240:b003:l004","ordinal":171731,"en":"My fortune must be crooked."},{"id":"semetey-1-2013:p1240:b003:l005","ordinal":171732,"en":"As I ask the gray wolf about the Argyn,"},{"id":"semetey-1-2013:p1240:b003:l006","ordinal":171733,"en":"Just as I was about to become a sultan,"},{"id":"semetey-1-2013:p1240:b003:l007","ordinal":171734,"en":"Ah, my deep-dug pit;"},{"id":"semetey-1-2013:p1240:b003:l008","ordinal":171735,"en":"Ah, my stain no washing removes!"},{"id":"semetey-1-2013:p1240:b003:l009","ordinal":171736,"en":"On snowy ground there is no cradle;"},{"id":"semetey-1-2013:p1240:b003:l010","ordinal":171737,"en":"I let the fleeing foe escape—"},{"id":"semetey-1-2013:p1240:b003:l011","ordinal":171738,"en":"There is no blessed portion for wretched me!"},{"id":"semetey-1-2013:p1240:b003:l012","ordinal":171739,"en":"My brow bone must be ill-shaped;"},{"id":"semetey-1-2013:p1240:b003:l013","ordinal":171740,"en":"My fortune was meager from the start!"},{"id":"semetey-1-2013:p1240:b003:l014","ordinal":171741,"en":"No good name remains to me;"},{"id":"semetey-1-2013:p1240:b003:l015","ordinal":171742,"en":"Calamity pressed down upon my head:"},{"id":"semetey-1-2013:p1240:b003:l016","ordinal":171743,"en":"Looming before me,"},{"id":"semetey-1-2013:p1240:b003:l017","ordinal":171744,"en":"Mountain-like Toltoy fled."},{"id":"semetey-1-2013:p1240:b003:l018","ordinal":171745,"en":"I let the fleeing foe escape;"},{"id":"semetey-1-2013:p1240:b003:l019","ordinal":171746,"en":"Can there be a man like me?"},{"id":"semetey-1-2013:p1240:b003:l020","ordinal":171747,"en":"Is it right to call"},{"id":"semetey-1-2013:p1240:b003:l021","ordinal":171748,"en":"A wretch like me a man?"},{"id":"semetey-1-2013:p1240:b003:l022","ordinal":171749,"en":"Can there be a man like me?"},{"id":"semetey-1-2013:p1240:b003:l023","ordinal":171750,"en":"A mortal man may be made a giant;"},{"id":"semetey-1-2013:p1240:b003:l024","ordinal":171751,"en":"Rather than make a person powerless,"},{"id":"semetey-1-2013:p1240:b003:l025","ordinal":171752,"en":"Why does Almighty God"},{"id":"semetey-1-2013:p1240:b003:l026","ordinal":171753,"en":"Not leave his mortal"},{"id":"semetey-1-2013:p1240:b003:l027","ordinal":171754,"en":"Uncreated instead?"},{"id":"semetey-1-2013:p1240:b003:l028","ordinal":171755,"en":"Rather than be born feeble,"},{"id":"semetey-1-2013:p1240:b003:l029","ordinal":171756,"en":"Why did this wretched soul"},{"id":"semetey-1-2013:p1240:b003:l030","ordinal":171757,"en":"Not see through"},{"id":"semetey-1-2013:p1240:b003:l031","ordinal":171758,"en":"The decree God laid down?"},{"id":"semetey-1-2013:p1240:b003:l032","ordinal":171759,"en":"Why did this wretched soul"},{"id":"semetey-1-2013:p1240:b003:l033","ordinal":171760,"en":"Not die in youth?"},{"id":"semetey-1-2013:p1240:b003:l034","ordinal":171761,"en":"Without caring for his horse's longing,"},{"id":"semetey-1-2013:p1240:b003:l035","ordinal":171762,"en":"My noble elder Semetey"},{"id":"semetey-1-2013:p1240:b003:l036","ordinal":171763,"en":"Gave me his horse without begrudging it."},{"id":"semetey-1-2013:p1240:b003:l037","ordinal":171764,"en":"Saying, “I failed to catch Toltoy,”"},{"id":"semetey-1-2013:p1240:b003:l038","ordinal":171765,"en":"How can I return in disgrace?"},{"id":"semetey-1-2013:p1240:b003:l039","ordinal":171766,"en":"Without caring for his coat's worth,"},{"id":"semetey-1-2013:p1240:b004:l001","ordinal":171767,"en":"My mountain-like elder Semetey"},{"id":"semetey-1-2013:p1240:b004:l002","ordinal":171768,"en":"Gave me his coat without begrudging it."},{"id":"semetey-1-2013:p1240:b004:l003","ordinal":171769,"en":"To Toltoy who fled bobbing away,"},{"id":"semetey-1-2013:p1240:b004:l004","ordinal":171770,"en":"Saying, “I myself failed to catch him,”"},{"id":"semetey-1-2013:p1240:b004:l005","ordinal":171771,"en":"How can I return in disgrace?"},{"id":"semetey-1-2013:p1240:b004:l006","ordinal":171772,"en":"The humiliation of the Jediger—"},{"id":"semetey-1-2013:p1240:b004:l007","ordinal":171773,"en":"Would that I had seen it,"},{"id":"semetey-1-2013:p1240:b004:l008","ordinal":171774,"en":"Charged alone among their army,"},{"id":"semetey-1-2013:p1240:b004:l009","ordinal":171775,"en":"Fought seven days without pause,"},{"id":"semetey-1-2013:p1240:b004:l010","ordinal":171776,"en":"And died if my doom came."}]
