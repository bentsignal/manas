[{"id":"manas-2010:p0884:b001:l041","ordinal":38913,"en":"‘If its girl is like this,"},{"id":"manas-2010:p0884:b001:l042","ordinal":38914,"en":"Then damned Bukhara's"},{"id":"manas-2010:p0885:b001:l001","ordinal":38915,"en":"Strong man, if he comes, will ruin me."},{"id":"manas-2010:p0885:b001:l002","ordinal":38916,"en":"If its woman is like this,"},{"id":"manas-2010:p0885:b001:l003","ordinal":38917,"en":"Then ill-omened Bukhara's"},{"id":"manas-2010:p0885:b001:l004","ordinal":38918,"en":"Skilled fighter, if he comes, will not spare me.’"},{"id":"manas-2010:p0885:b001:l005","ordinal":38919,"en":"For Chubak, Khan Baltay's son,"},{"id":"manas-2010:p0885:b001:l006","ordinal":38920,"en":"For the reckless fellow who had gone scouting,"},{"id":"manas-2010:p0885:b001:l007","ordinal":38921,"en":"God's sun in the sky grew clouded."},{"id":"manas-2010:p0885:b001:l008","ordinal":38922,"en":"Sixty worries came upon his head at once."},{"id":"manas-2010:p0885:b001:l009","ordinal":38923,"en":"‘If she strikes again, she will ruin me;"},{"id":"manas-2010:p0885:b001:l010","ordinal":38924,"en":"That shameless piece of trash will not spare me."},{"id":"manas-2010:p0885:b001:l011","ordinal":38925,"en":"Let me go to Khan Baltay."},{"id":"manas-2010:p0885:b001:l012","ordinal":38926,"en":"From my Noygut people in Alay"},{"id":"manas-2010:p0885:b001:l013","ordinal":38927,"en":"Let me take countless troops,"},{"id":"manas-2010:p0885:b001:l014","ordinal":38928,"en":"Let me set them marching in a long line."},{"id":"manas-2010:p0885:b001:l015","ordinal":38929,"en":"From the skilled spearmen,"},{"id":"manas-2010:p0885:b001:l016","ordinal":38930,"en":"From the mighty battle-axe wielders,"},{"id":"manas-2010:p0885:b001:l017","ordinal":38931,"en":"Gathering hosts upon hosts,"},{"id":"manas-2010:p0885:b001:l018","ordinal":38932,"en":"Let me return to Bukhara"},{"id":"manas-2010:p0885:b001:l019","ordinal":38933,"en":"And raid it then."},{"id":"manas-2010:p0885:b001:l020","ordinal":38934,"en":"Let me gather the troops;"},{"id":"manas-2010:p0885:b001:l021","ordinal":38935,"en":"Then upon that bitch"},{"id":"manas-2010:p0885:b001:l022","ordinal":38936,"en":"Let me avenge my distant grievance!’"},{"id":"manas-2010:p0885:b001:l023","ordinal":38937,"en":"Warrior Chubak thought this."},{"id":"manas-2010:p0885:b001:l024","ordinal":38938,"en":"Such a spear thrust he had never seen"},{"id":"manas-2010:p0885:b001:l025","ordinal":38939,"en":"From any warrior's son, at any time."},{"id":"manas-2010:p0885:b001:l026","ordinal":38940,"en":"Then Chubak the leopard"},{"id":"manas-2010:p0885:b001:l027","ordinal":38941,"en":"Loosened Kögala's reins."},{"id":"manas-2010:p0885:b001:l028","ordinal":38942,"en":"The steed Kögala then—"},{"id":"manas-2010:p0885:b001:l029","ordinal":38943,"en":"The ground beneath its feet crumbled."},{"id":"manas-2010:p0885:b001:l030","ordinal":38944,"en":"Clods big as a cauldron"},{"id":"manas-2010:p0885:b001:l031","ordinal":38945,"en":"Whistled above its head."},{"id":"manas-2010:p0885:b001:l032","ordinal":38946,"en":"When given its head, Kögala"},{"id":"manas-2010:p0885:b001:l033","ordinal":38947,"en":"Flew rushing like a cloud."},{"id":"manas-2010:p0885:b001:l034","ordinal":38948,"en":"At an uproar it grew stronger and broke away."},{"id":"manas-2010:p0885:b001:l035","ordinal":38949,"en":"When it swept forward, the black earth"},{"id":"manas-2010:p0885:b001:l036","ordinal":38950,"en":"Parted from its crust."},{"id":"manas-2010:p0885:b001:l037","ordinal":38951,"en":"Warrior Chubak's Kögala"},{"id":"manas-2010:p0885:b001:l038","ordinal":38952,"en":"Showed the marks of a winged steed."},{"id":"manas-2010:p0885:b001:l039","ordinal":38953,"en":"When Chubak took flight,"},{"id":"manas-2010:p0885:b001:l040","ordinal":38954,"en":"Kanykey gathered her strength:"},{"id":"manas-2010:p0885:b001:l041","ordinal":38955,"en":"‘Are you a man or a girl?"},{"id":"manas-2010:p0885:b001:l042","ordinal":38956,"en":"Let me sing a taunting song,"},{"id":"manas-2010:p0886:b001:l001","ordinal":38957,"en":"Pursue him to his own land,"},{"id":"manas-2010:p0886:b001:l002","ordinal":38958,"en":"Take him as spoils and return."},{"id":"manas-2010:p0886:b001:l003","ordinal":38959,"en":"A rabbit that has come into one's hand—"},{"id":"manas-2010:p0886:b001:l004","ordinal":38960,"en":"Can letting it go bring good?"},{"id":"manas-2010:p0886:b001:l005","ordinal":38961,"en":"He is skilled, he is a lion;"},{"id":"manas-2010:p0886:b001:l006","ordinal":38962,"en":"Can he flee from a woman?"},{"id":"manas-2010:p0886:b001:l007","ordinal":38963,"en":"The four corners of the round world—"},{"id":"manas-2010:p0886:b001:l008","ordinal":38964,"en":"Let me chase him around them four times,"},{"id":"manas-2010:p0886:b001:l009","ordinal":38965,"en":"Invade the land where he is a lord."},{"id":"manas-2010:p0886:b001:l010","ordinal":38966,"en":"Chubak, may he be struck on the head,"},{"id":"manas-2010:p0886:b001:l011","ordinal":38967,"en":"The reckless fellow who acts a lord—"},{"id":"manas-2010:p0886:b001:l012","ordinal":38968,"en":"Let me trample on his head."},{"id":"manas-2010:p0886:b001:l013","ordinal":38969,"en":"Going scouting, traveling the roads,"},{"id":"manas-2010:p0886:b001:l014","ordinal":38970,"en":"Let me make him unable to trot forth."},{"id":"manas-2010:p0886:b001:l015","ordinal":38971,"en":"Taking troops once more,"},{"id":"manas-2010:p0886:b001:l016","ordinal":38972,"en":"To the royal city of Bukhara,"},{"id":"manas-2010:p0886:b001:l017","ordinal":38973,"en":"Let me make him unable to return."},{"id":"manas-2010:p0886:b001:l018","ordinal":38974,"en":"Let me appear before his eyes,"},{"id":"manas-2010:p0886:b001:l019","ordinal":38975,"en":"That foolish warrior Chubak's;"},{"id":"manas-2010:p0886:b001:l020","ordinal":38976,"en":"Let him know who I am!’"},{"id":"manas-2010:p0886:b001:l021","ordinal":38977,"en":"Thus Kanykey spoke,"},{"id":"manas-2010:p0886:b001:l022","ordinal":38978,"en":"The hapless one with a warrior's stature."},{"id":"manas-2010:p0886:b001:l023","ordinal":38979,"en":"Beneath her, the black, white-blazed thoroughbred,"},{"id":"manas-2010:p0886:b001:l024","ordinal":38980,"en":"Kanykey's wings."},{"id":"manas-2010:p0886:b001:l025","ordinal":38981,"en":"Whenever she fought, that fierce woman"},{"id":"manas-2010:p0886:b001:l026","ordinal":38982,"en":"Was accustomed to ride it into battle."},{"id":"manas-2010:p0886:b001:l027","ordinal":38983,"en":"Taking the blue spear in hand,"},{"id":"manas-2010:p0886:b001:l028","ordinal":38984,"en":"Striking the thoroughbred once,"},{"id":"manas-2010:p0886:b001:l029","ordinal":38985,"en":"She cried out, ‘Temirkan!’"},{"id":"manas-2010:p0886:b001:l030","ordinal":38986,"en":"Shouting in wrath,"},{"id":"manas-2010:p0886:b001:l031","ordinal":38987,"en":"‘If you are a man, do not flee!’"},{"id":"manas-2010:p0886:b001:l032","ordinal":38988,"en":"She called to warrior Chubak."},{"id":"manas-2010:p0886:b001:l033","ordinal":38989,"en":"‘If I do not bind my hair at the nape,"},{"id":"manas-2010:p0886:b001:l034","ordinal":38990,"en":"May I cease to be human;"},{"id":"manas-2010:p0886:b001:l035","ordinal":38991,"en":"Akbaltay's foolish boy—"},{"id":"manas-2010:p0886:b001:l036","ordinal":38992,"en":"If I do not pursue him to his land."},{"id":"manas-2010:p0886:b001:l037","ordinal":38993,"en":"To raid and take a city,"},{"id":"manas-2010:p0886:b001:l038","ordinal":38994,"en":"Warrior Chubak seems well skilled."},{"id":"manas-2010:p0886:b001:l039","ordinal":38995,"en":"If I do not bear down upon your head,"},{"id":"manas-2010:p0886:b001:l040","ordinal":38996,"en":"If I do not scatter your four kinds of livestock,"},{"id":"manas-2010:p0886:b001:l041","ordinal":38997,"en":"May I sink without bearing a child,"},{"id":"manas-2010:p0886:b001:l042","ordinal":38998,"en":"May I die instead of living!"},{"id":"manas-2010:p0887:b001:l001","ordinal":38999,"en":"Turn your horse toward me;"},{"id":"manas-2010:p0887:b001:l002","ordinal":39000,"en":"Let us fight with spears again."},{"id":"manas-2010:p0887:b001:l003","ordinal":39001,"en":"If you are a valiant man, Chubak,"},{"id":"manas-2010:p0887:b001:l004","ordinal":39002,"en":"Stand where you stood before!’"},{"id":"manas-2010:p0887:b001:l005","ordinal":39003,"en":"Would Chubak heed those words?"},{"id":"manas-2010:p0887:b001:l006","ordinal":39004,"en":"Would standing there bring him good?"},{"id":"manas-2010:p0887:b001:l007","ordinal":39005,"en":"When they entered a descent,"},{"id":"manas-2010:p0887:b001:l008","ordinal":39006,"en":"The black, white-blazed thoroughbred"},{"id":"manas-2010:p0887:b001:l009","ordinal":39007,"en":"Pressed close upon his heels."},{"id":"manas-2010:p0887:b001:l010","ordinal":39008,"en":"When they began to climb,"},{"id":"manas-2010:p0887:b001:l011","ordinal":39009,"en":"Chubak's horse Kögala"},{"id":"manas-2010:p0887:b001:l012","ordinal":39010,"en":"Sped far ahead like a mirage."},{"id":"manas-2010:p0887:b001:l013","ordinal":39011,"en":"When rough ground came,"},{"id":"manas-2010:p0887:b001:l014","ordinal":39012,"en":"Warrior Chubak's Kögala"},{"id":"manas-2010:p0887:b001:l015","ordinal":39013,"en":"Bulged its neck like a bull."},{"id":"manas-2010:p0887:b001:l016","ordinal":39014,"en":"When they reached hilly ground,"},{"id":"manas-2010:p0887:b001:l017","ordinal":39015,"en":"The black, white-blazed thoroughbred's"},{"id":"manas-2010:p0887:b001:l018","ordinal":39016,"en":"Moonlike blaze flashed."},{"id":"manas-2010:p0887:b001:l019","ordinal":39017,"en":"Thrusting a spear like a man,"},{"id":"manas-2010:p0887:b001:l020","ordinal":39018,"en":"Never was there such a person."},{"id":"manas-2010:p0887:b001:l021","ordinal":39019,"en":"No mountain the size of an ankle bone,"},{"id":"manas-2010:p0887:b001:l022","ordinal":39020,"en":"No hollow the size of a saddlecloth—"},{"id":"manas-2010:p0887:b001:l023","ordinal":39021,"en":"She drove Chubak onward,"},{"id":"manas-2010:p0887:b001:l024","ordinal":39022,"en":"Making him stumble in panic then,"},{"id":"manas-2010:p0887:b001:l025","ordinal":39023,"en":"Stripping him of every recourse,"},{"id":"manas-2010:p0887:b001:l026","ordinal":39024,"en":"Chubak, Akbaltay's son."},{"id":"manas-2010:p0887:b001:l027","ordinal":39025,"en":"Kögala beneath him—"},{"id":"manas-2010:p0887:b001:l028","ordinal":39026,"en":"He gave it its head without restraint."},{"id":"manas-2010:p0887:b001:l029","ordinal":39027,"en":"At his wits' end, warrior Chubak"},{"id":"manas-2010:p0887:b001:l030","ordinal":39028,"en":"Fled with all his might."},{"id":"manas-2010:p0887:b001:l031","ordinal":39029,"en":"When they reached the empty plain,"},{"id":"manas-2010:p0887:b001:l032","ordinal":39030,"en":"The earth split, shimmering."},{"id":"manas-2010:p0887:b001:l033","ordinal":39031,"en":"Kanykey's black, white-blazed thoroughbred"},{"id":"manas-2010:p0887:b001:l034","ordinal":39032,"en":"Toward Khan Baltay's Chubak"},{"id":"manas-2010:p0887:b001:l035","ordinal":39033,"en":"Drew near, about to catch him."},{"id":"manas-2010:p0887:b001:l036","ordinal":39034,"en":"At the jutting end of a mountain,"},{"id":"manas-2010:p0887:b001:l037","ordinal":39035,"en":"Warrior Chubak was about to come down"},{"id":"manas-2010:p0887:b001:l038","ordinal":39036,"en":"Upon a blunt promontory."},{"id":"manas-2010:p0887:b001:l039","ordinal":39037,"en":"When he passed beyond it,"},{"id":"manas-2010:p0887:b001:l040","ordinal":39038,"en":"Right before him there was"},{"id":"manas-2010:p0887:b001:l041","ordinal":39039,"en":"A gaping gorge."},{"id":"manas-2010:p0887:b001:l042","ordinal":39040,"en":"Akbaltay's Chubak"},{"id":"manas-2010:p0888:b001:l001","ordinal":39041,"en":"Uttered many laments."},{"id":"manas-2010:p0888:b001:l002","ordinal":39042,"en":"Warrior Chubak had no strength left."},{"id":"manas-2010:p0888:b001:l003","ordinal":39043,"en":"Like bride and bridegroom,"},{"id":"manas-2010:p0888:b001:l004","ordinal":39044,"en":"They pursued each other fiercely."},{"id":"manas-2010:p0888:b001:l005","ordinal":39045,"en":"Warrior Chubak was fleeing;"},{"id":"manas-2010:p0888:b001:l006","ordinal":39046,"en":"Kanykey was pursuing."},{"id":"manas-2010:p0888:b001:l007","ordinal":39047,"en":"Let us leave them thus."},{"id":"manas-2010:p0888:b001:l008","ordinal":39048,"en":"Blood-drinking Manas the leopard,"},{"id":"manas-2010:p0888:b001:l009","ordinal":39049,"en":"Old Bakay and Azhybay,"},{"id":"manas-2010:p0888:b001:l010","ordinal":39050,"en":"Their wise elder Bakay,"},{"id":"manas-2010:p0888:b001:l011","ordinal":39051,"en":"All the warriors,"},{"id":"manas-2010:p0888:b001:l012","ordinal":39052,"en":"Unable to stay idle among their people,"},{"id":"manas-2010:p0888:b001:l013","ordinal":39053,"en":"Wore out horses, explored the land,"},{"id":"manas-2010:p0888:b001:l014","ordinal":39054,"en":"Released hounds and flew hunting birds,"},{"id":"manas-2010:p0888:b001:l015","ordinal":39055,"en":"Sought tigers, hunted game,"},{"id":"manas-2010:p0888:b001:l016","ordinal":39056,"en":"Your tiger Manas among them,"},{"id":"manas-2010:p0888:b001:l017","ordinal":39057,"en":"Catching leopards alive."},{"id":"manas-2010:p0888:b001:l018","ordinal":39058,"en":"Khan Chubak had entered his dream"},{"id":"manas-2010:p0888:b001:l019","ordinal":39059,"en":"While he lay asleep."},{"id":"manas-2010:p0888:b001:l020","ordinal":39060,"en":"Manas was a lion, he too a lion;"},{"id":"manas-2010:p0888:b001:l021","ordinal":39061,"en":"They joined together one night,"},{"id":"manas-2010:p0888:b001:l022","ordinal":39062,"en":"Shot roe deer when bored,"},{"id":"manas-2010:p0888:b001:l023","ordinal":39063,"en":"Spent one night together."},{"id":"manas-2010:p0888:b001:l024","ordinal":39064,"en":"They traveled to the world's edge,"},{"id":"manas-2010:p0888:b001:l025","ordinal":39065,"en":"Where no man had seen, no people could go,"},{"id":"manas-2010:p0888:b001:l026","ordinal":39066,"en":"They burned all the land."},{"id":"manas-2010:p0888:b001:l027","ordinal":39067,"en":"Manas was a lion, he too a lion;"},{"id":"manas-2010:p0888:b001:l028","ordinal":39068,"en":"They spared none they encountered."},{"id":"manas-2010:p0888:b001:l029","ordinal":39069,"en":"The four corners of the round world,"},{"id":"manas-2010:p0888:b001:l030","ordinal":39070,"en":"The five corners of Mediyen,"},{"id":"manas-2010:p0888:b001:l031","ordinal":39071,"en":"They prowled around five times."},{"id":"manas-2010:p0888:b001:l032","ordinal":39072,"en":"Speaking back to them,"},{"id":"manas-2010:p0888:b001:l033","ordinal":39073,"en":"No one dared attack them."},{"id":"manas-2010:p0888:b001:l034","ordinal":39074,"en":"Manas awoke from sleep."},{"id":"manas-2010:p0888:b001:l035","ordinal":39075,"en":"Five sets of nine beasts, each headed by a mare,"},{"id":"manas-2010:p0888:b001:l036","ordinal":39076,"en":"He slaughtered on a ridge and held a feast."},{"id":"manas-2010:p0888:b001:l037","ordinal":39077,"en":"His learned elder Bakay,"},{"id":"manas-2010:p0888:b001:l038","ordinal":39078,"en":"To hear his dream he summoned"},{"id":"manas-2010:p0888:b001:l039","ordinal":39079,"en":"All the wise ones."},{"id":"manas-2010:p0888:b001:l040","ordinal":39080,"en":"‘My people,"},{"id":"manas-2010:p0888:b001:l041","ordinal":39081,"en":"I was immersed in great marvels."},{"id":"manas-2010:p0888:b001:l042","ordinal":39082,"en":"As two equal beings,"},{"id":"manas-2010:p0889:b001:l001","ordinal":39083,"en":"We were exploring the land."},{"id":"manas-2010:p0889:b001:l002","ordinal":39084,"en":"What could this mean?"},{"id":"manas-2010:p0889:b001:l003","ordinal":39085,"en":"Interpret this dream of mine!"},{"id":"manas-2010:p0889:b001:l004","ordinal":39086,"en":"A towering black mountain appeared;"},{"id":"manas-2010:p0889:b001:l005","ordinal":39087,"en":"I broke through the mountain and made a road."},{"id":"manas-2010:p0889:b001:l006","ordinal":39088,"en":"What could this mean?"},{"id":"manas-2010:p0889:b001:l007","ordinal":39089,"en":"Interpret this dream of mine!"},{"id":"manas-2010:p0889:b001:l008","ordinal":39090,"en":"I was a leopard, a lion,"},{"id":"manas-2010:p0889:b001:l009","ordinal":39091,"en":"Leading a lion behind me,"},{"id":"manas-2010:p0889:b001:l010","ordinal":39092,"en":"I explored the world."},{"id":"manas-2010:p0889:b001:l011","ordinal":39093,"en":"Where no traveler had gone,"},{"id":"manas-2010:p0889:b001:l012","ordinal":39094,"en":"Where no traveler survived,"},{"id":"manas-2010:p0889:b001:l013","ordinal":39095,"en":"The dense black forest"},{"id":"manas-2010:p0889:b001:l014","ordinal":39096,"en":"I burned utterly to nothing."},{"id":"manas-2010:p0889:b001:l015","ordinal":39097,"en":"What could this mean?"},{"id":"manas-2010:p0889:b001:l016","ordinal":39098,"en":"Interpret this dream of mine!"},{"id":"manas-2010:p0889:b001:l017","ordinal":39099,"en":"From my northern side,"},{"id":"manas-2010:p0889:b001:l018","ordinal":39100,"en":"I saw a shining sun in my dream."},{"id":"manas-2010:p0889:b001:l019","ordinal":39101,"en":"He was a sun, I too a sun;"},{"id":"manas-2010:p0889:b001:l020","ordinal":39102,"en":"We camped in the open wilderness."},{"id":"manas-2010:p0889:b001:l021","ordinal":39103,"en":"Without clasping hands in greeting,"},{"id":"manas-2010:p0889:b001:l022","ordinal":39104,"en":"We parted without battle."},{"id":"manas-2010:p0889:b001:l023","ordinal":39105,"en":"What could this mean?"},{"id":"manas-2010:p0889:b001:l024","ordinal":39106,"en":"Interpret this dream of mine!’"},{"id":"manas-2010:p0889:b001:l025","ordinal":39107,"en":"Earlier, in Kara-Buura and Chatkal,"},{"id":"manas-2010:p0889:b001:l026","ordinal":39108,"en":"When the Nogoy lay at ease,"},{"id":"manas-2010:p0889:b001:l027","ordinal":39109,"en":"These were your blood-drinker's words."},{"id":"manas-2010:p0889:b001:l028","ordinal":39110,"en":"Khan Bakay, the rich man's son,"},{"id":"manas-2010:p0889:b001:l029","ordinal":39111,"en":"Whose mouth was rinsed with honey,"},{"id":"manas-2010:p0889:b001:l030","ordinal":39112,"en":"The hardship of six months ahead"},{"id":"manas-2010:p0889:b001:l031","ordinal":39113,"en":"Could tell at this very moment."},{"id":"manas-2010:p0889:b001:l032","ordinal":39114,"en":"He was like a saint."},{"id":"manas-2010:p0889:b001:l033","ordinal":39115,"en":"Brightly he interpreted the dream."},{"id":"manas-2010:p0889:b001:l034","ordinal":39116,"en":"Your elder Bakay then"},{"id":"manas-2010:p0889:b001:l035","ordinal":39117,"en":"Spoke in his ringing voice:"},{"id":"manas-2010:p0889:b001:l036","ordinal":39118,"en":"‘A dream of sacred power, a wonder!"},{"id":"manas-2010:p0889:b001:l037","ordinal":39119,"en":"Let me interpret it plainly."},{"id":"manas-2010:p0889:b001:l038","ordinal":39120,"en":"Your fortune has opened;"},{"id":"manas-2010:p0889:b001:l039","ordinal":39121,"en":"May your throne be blessed!"},{"id":"manas-2010:p0889:b001:l040","ordinal":39122,"en":"The coming of the hungry lion"},{"id":"manas-2010:p0889:b001:l041","ordinal":39123,"en":"Is truly God's gift."},{"id":"manas-2010:p0889:b001:l042","ordinal":39124,"en":"Perhaps you have heard of him:"},{"id":"manas-2010:p0890:b001:l001","ordinal":39125,"en":"Born in broad Alay,"},{"id":"manas-2010:p0890:b001:l002","ordinal":39126,"en":"When he reached twelve,"},{"id":"manas-2010:p0890:b001:l003","ordinal":39127,"en":"He brought uproar to Kashgar."},{"id":"manas-2010:p0890:b001:l004","ordinal":39128,"en":"Akbaltay's lion,"},{"id":"manas-2010:p0890:b001:l005","ordinal":39129,"en":"Chubak is coming!"},{"id":"manas-2010:p0890:b001:l006","ordinal":39130,"en":"With a piercing cry, a mighty battle shout,"},{"id":"manas-2010:p0890:b001:l007","ordinal":39131,"en":"The lion warrior's companion,"},{"id":"manas-2010:p0890:b001:l008","ordinal":39132,"en":"The reckless fellow is coming!"},{"id":"manas-2010:p0890:b001:l009","ordinal":39133,"en":"If Chubak comes into your hands,"},{"id":"manas-2010:p0890:b001:l010","ordinal":39134,"en":"Could any fingered man approach?"},{"id":"manas-2010:p0890:b001:l011","ordinal":39135,"en":"Could any nail-bearing man attack?"},{"id":"manas-2010:p0890:b001:l012","ordinal":39136,"en":"If Chubak comes into your hands,"},{"id":"manas-2010:p0890:b001:l013","ordinal":39137,"en":"If you broke the black mountain to make a road,"},{"id":"manas-2010:p0890:b001:l014","ordinal":39138,"en":"You will reach and raid"},{"id":"manas-2010:p0890:b001:l015","ordinal":39139,"en":"Afghanistan's seven cities."},{"id":"manas-2010:p0890:b001:l016","ordinal":39140,"en":"When your skilled Chubak comes,"},{"id":"manas-2010:p0890:b001:l017","ordinal":39141,"en":"How could Zherken remain unharmed?"},{"id":"manas-2010:p0890:b001:l018","ordinal":39142,"en":"If you reached the black forest's edge,"},{"id":"manas-2010:p0890:b001:l019","ordinal":39143,"en":"The forest of no return,"},{"id":"manas-2010:p0890:b001:l020","ordinal":39144,"en":"If you burned it all, leaving nothing,"},{"id":"manas-2010:p0890:b001:l021","ordinal":39145,"en":"A wise one coming, a lion coming,"},{"id":"manas-2010:p0890:b001:l022","ordinal":39146,"en":"A warrior your equal coming,"},{"id":"manas-2010:p0890:b001:l023","ordinal":39147,"en":"Your blood-thirst seizing you in frenzy,"},{"id":"manas-2010:p0890:b001:l024","ordinal":39148,"en":"A mighty warrior met through the unseen,"},{"id":"manas-2010:p0890:b001:l025","ordinal":39149,"en":"If you burned the black forest,"},{"id":"manas-2010:p0890:b001:l026","ordinal":39150,"en":"Against Kakanchyn and Beijing"},{"id":"manas-2010:p0890:b001:l027","ordinal":39151,"en":"You will wage war."},{"id":"manas-2010:p0890:b001:l028","ordinal":39152,"en":"The black river, the sea,"},{"id":"manas-2010:p0890:b001:l029","ordinal":39153,"en":"If you struck it with your whip,"},{"id":"manas-2010:p0890:b001:l030","ordinal":39154,"en":"If you struck and your hand did not tire,"},{"id":"manas-2010:p0890:b001:l031","ordinal":39155,"en":"If not a drop of water remained,"},{"id":"manas-2010:p0890:b001:l032","ordinal":39156,"en":"From Beijing, untouched by Solomon,"},{"id":"manas-2010:p0890:b001:l033","ordinal":39157,"en":"A warrior your equal coming,"},{"id":"manas-2010:p0890:b001:l034","ordinal":39158,"en":"You will demand an accounting!"},{"id":"manas-2010:p0890:b001:l035","ordinal":39159,"en":"No soul left to turn a catching pole against you,"},{"id":"manas-2010:p0890:b001:l036","ordinal":39160,"en":"You will become supreme!"},{"id":"manas-2010:p0890:b001:l037","ordinal":39161,"en":"Wearing out horses, exploring the land,"},{"id":"manas-2010:p0890:b001:l038","ordinal":39162,"en":"Your camping in the open wilderness,"},{"id":"manas-2010:p0890:b001:l039","ordinal":39163,"en":"The sun rising from the north,"},{"id":"manas-2010:p0890:b001:l040","ordinal":39164,"en":"Your parting without battle—"},{"id":"manas-2010:p0890:b001:l041","ordinal":39165,"en":"I heard news from those who came."},{"id":"manas-2010:p0890:b001:l042","ordinal":39166,"en":"Twelve khans gathered,"},{"id":"manas-2010:p0891:b001:l001","ordinal":39167,"en":"The ruler of Bukhara"},{"id":"manas-2010:p0891:b001:l002","ordinal":39168,"en":"They went to besiege, I heard."}]
