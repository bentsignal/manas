[{"id":"manas-2010:p0939:b001:l041","ordinal":41217,"en":"Until the pliant stalks ripen,"},{"id":"manas-2010:p0939:b001:l042","ordinal":41218,"en":"Until the autumn flower's down flies,"},{"id":"manas-2010:p0940:b001:l001","ordinal":41219,"en":"Fighting hard for six months,"},{"id":"manas-2010:p0940:b001:l002","ordinal":41220,"en":"Let us slaughter one another!’"},{"id":"manas-2010:p0940:b001:l003","ordinal":41221,"en":"Saying this, warrior Bakay"},{"id":"manas-2010:p0940:b001:l004","ordinal":41222,"en":"Saddled his gray steed,"},{"id":"manas-2010:p0940:b001:l005","ordinal":41223,"en":"Settled himself in wrath,"},{"id":"manas-2010:p0940:b001:l006","ordinal":41224,"en":"Girded on an unsheathed sword."},{"id":"manas-2010:p0940:b001:l007","ordinal":41225,"en":"Through the whole wide world—"},{"id":"manas-2010:p0940:b001:l008","ordinal":41226,"en":"Was it not Bakay who had traveled?"},{"id":"manas-2010:p0940:b001:l009","ordinal":41227,"en":"All surpassing wisdom—"},{"id":"manas-2010:p0940:b001:l010","ordinal":41228,"en":"Was it not Bakay who knew it?"},{"id":"manas-2010:p0940:b001:l011","ordinal":41229,"en":"Where his gray steed's hoof had not trodden—"},{"id":"manas-2010:p0940:b001:l012","ordinal":41230,"en":"No place remained untouched."},{"id":"manas-2010:p0940:b001:l013","ordinal":41231,"en":"Who had not said “blue-maned Bakay”—"},{"id":"manas-2010:p0940:b001:l014","ordinal":41232,"en":"No warrior remained among them."},{"id":"manas-2010:p0940:b001:l015","ordinal":41233,"en":"Wise Bakay the saint,"},{"id":"manas-2010:p0940:b001:l016","ordinal":41234,"en":"An elder who knew much,"},{"id":"manas-2010:p0940:b001:l017","ordinal":41235,"en":"Their fortunate elder Bakay,"},{"id":"manas-2010:p0940:b001:l018","ordinal":41236,"en":"Weighty as a vast army,"},{"id":"manas-2010:p0940:b001:l019","ordinal":41237,"en":"Set off for the city of Bukhara."},{"id":"manas-2010:p0940:b001:l020","ordinal":41238,"en":"Lordly Bakay stood apart,"},{"id":"manas-2010:p0940:b001:l021","ordinal":41239,"en":"His lion's might plain to see."},{"id":"manas-2010:p0940:b001:l022","ordinal":41240,"en":"The forty companions set out behind him;"},{"id":"manas-2010:p0940:b001:l023","ordinal":41241,"en":"The leopard lord made ready,"},{"id":"manas-2010:p0940:b001:l024","ordinal":41242,"en":"For longing for Kanykey."},{"id":"manas-2010:p0940:b001:l025","ordinal":41243,"en":"Hero Bakay traveled on,"},{"id":"manas-2010:p0940:b001:l026","ordinal":41244,"en":"Went far, sparing no horse,"},{"id":"manas-2010:p0940:b001:l027","ordinal":41245,"en":"His mail coat gleaming."},{"id":"manas-2010:p0940:b001:l028","ordinal":41246,"en":"Akchybyk, which Bakay fired,"},{"id":"manas-2010:p0940:b001:l029","ordinal":41247,"en":"Flashed upon his broad shoulder."},{"id":"manas-2010:p0940:b001:l030","ordinal":41248,"en":"He loomed like a mountain to Bukhara."},{"id":"manas-2010:p0940:b001:l031","ordinal":41249,"en":"Seeing Bakay's appearance,"},{"id":"manas-2010:p0940:b001:l032","ordinal":41250,"en":"Bukhara's people fell into turmoil."},{"id":"manas-2010:p0940:b001:l033","ordinal":41251,"en":"Into gated Bukhara"},{"id":"manas-2010:p0940:b001:l034","ordinal":41252,"en":"Khan Bakay entered."},{"id":"manas-2010:p0940:b001:l035","ordinal":41253,"en":"Bukhara's teeming people"},{"id":"manas-2010:p0940:b001:l036","ordinal":41254,"en":"Were left in astonishment."},{"id":"manas-2010:p0940:b001:l037","ordinal":41255,"en":"Bakay had never entered Bukhara;"},{"id":"manas-2010:p0940:b001:l038","ordinal":41256,"en":"That Bakay was Bakay,"},{"id":"manas-2010:p0940:b001:l039","ordinal":41257,"en":"The people of Bukhara did not know."},{"id":"manas-2010:p0940:b001:l040","ordinal":41258,"en":"Within that Bukhara"},{"id":"manas-2010:p0940:b001:l041","ordinal":41259,"en":"Were holy men in white turbans,"},{"id":"manas-2010:p0940:b001:l042","ordinal":41260,"en":"Were mullahs reading lessons,"},{"id":"manas-2010:p0941:b001:l001","ordinal":41261,"en":"Were elders who had seen much,"},{"id":"manas-2010:p0941:b001:l002","ordinal":41262,"en":"Were all the learned scholars."},{"id":"manas-2010:p0941:b001:l003","ordinal":41263,"en":"As he drew near Bukhara,"},{"id":"manas-2010:p0941:b001:l004","ordinal":41264,"en":"This was Bakay's appearance:"},{"id":"manas-2010:p0941:b001:l005","ordinal":41265,"en":"A black-spotted leopard"},{"id":"manas-2010:p0941:b001:l006","ordinal":41266,"en":"Reared beside his flank;"},{"id":"manas-2010:p0941:b001:l007","ordinal":41267,"en":"A short-tailed, blue-maned lion,"},{"id":"manas-2010:p0941:b001:l008","ordinal":41268,"en":"As though to rend and swallow all,"},{"id":"manas-2010:p0941:b001:l009","ordinal":41269,"en":"Ran beside him, ready to spring."},{"id":"manas-2010:p0941:b001:l010","ordinal":41270,"en":"The onlookers' hearts were troubled."},{"id":"manas-2010:p0941:b001:l011","ordinal":41271,"en":"A thousand men on his right,"},{"id":"manas-2010:p0941:b001:l012","ordinal":41272,"en":"A thousand men on his left,"},{"id":"manas-2010:p0941:b001:l013","ordinal":41273,"en":"The gated city of Bukhara—"},{"id":"manas-2010:p0941:b001:l014","ordinal":41274,"en":"They seemed about to overwhelm it."},{"id":"manas-2010:p0941:b001:l015","ordinal":41275,"en":"The giant black Simurgh bird,"},{"id":"manas-2010:p0941:b001:l016","ordinal":41276,"en":"As though to swoop and seize at once,"},{"id":"manas-2010:p0941:b001:l017","ordinal":41277,"en":"Spread its huge claws."},{"id":"manas-2010:p0941:b001:l018","ordinal":41278,"en":"His mighty ones became forty thousand souls,"},{"id":"manas-2010:p0941:b001:l019","ordinal":41279,"en":"Encircling it in ranks."},{"id":"manas-2010:p0941:b001:l020","ordinal":41280,"en":"Seeing Bakay, the people"},{"id":"manas-2010:p0941:b001:l021","ordinal":41281,"en":"All stood crowding round."},{"id":"manas-2010:p0941:b001:l022","ordinal":41282,"en":"At your saintly elder Bakay's"},{"id":"manas-2010:p0941:b001:l023","ordinal":41283,"en":"Lion's might they marveled."},{"id":"manas-2010:p0941:b001:l024","ordinal":41284,"en":"Bukhara's teeming people"},{"id":"manas-2010:p0941:b001:l025","ordinal":41285,"en":"Parted down the middle in alarm,"},{"id":"manas-2010:p0941:b001:l026","ordinal":41286,"en":"Both hands upon their breasts,"},{"id":"manas-2010:p0941:b001:l027","ordinal":41287,"en":"Crying out their greetings."},{"id":"manas-2010:p0941:b001:l028","ordinal":41288,"en":"Seeing Bakay, they marveled:"},{"id":"manas-2010:p0941:b001:l029","ordinal":41289,"en":"‘From where has this soul come?"},{"id":"manas-2010:p0941:b001:l030","ordinal":41290,"en":"Can any mortal face him?"},{"id":"manas-2010:p0941:b001:l031","ordinal":41291,"en":"If his temper turns utterly foul,"},{"id":"manas-2010:p0941:b001:l032","ordinal":41292,"en":"Can a mortal throw and defeat him?"},{"id":"manas-2010:p0941:b001:l033","ordinal":41293,"en":"He keeps a pure faith."},{"id":"manas-2010:p0941:b001:l034","ordinal":41294,"en":"Looking at his figure,"},{"id":"manas-2010:p0941:b001:l035","ordinal":41295,"en":"He is one of Islam's people."},{"id":"manas-2010:p0941:b001:l036","ordinal":41296,"en":"If we do what this man says,"},{"id":"manas-2010:p0941:b001:l037","ordinal":41297,"en":"He will not shout and thrust his spear,"},{"id":"manas-2010:p0941:b001:l038","ordinal":41298,"en":"He will not bring turmoil to Bukhara.’"},{"id":"manas-2010:p0941:b001:l039","ordinal":41299,"en":"‘We sought it from the learned,"},{"id":"manas-2010:p0941:b001:l040","ordinal":41300,"en":"We asked the wise:"},{"id":"manas-2010:p0941:b001:l041","ordinal":41301,"en":"From where has such a soul come?"},{"id":"manas-2010:p0941:b001:l042","ordinal":41302,"en":"He is immense, he is a lion,"},{"id":"manas-2010:p0942:b001:l001","ordinal":41303,"en":"Who has thrown the world into turmoil,"},{"id":"manas-2010:p0942:b001:l002","ordinal":41304,"en":"A merciless lion."},{"id":"manas-2010:p0942:b001:l003","ordinal":41305,"en":"His staring eyes are like the morning star,"},{"id":"manas-2010:p0942:b001:l004","ordinal":41306,"en":"His great ears like shields."},{"id":"manas-2010:p0942:b001:l005","ordinal":41307,"en":"His bearing is different, his menace strong;"},{"id":"manas-2010:p0942:b001:l006","ordinal":41308,"en":"Those who fall out with him"},{"id":"manas-2010:p0942:b001:l007","ordinal":41309,"en":"He slaughters, destroys and levels."},{"id":"manas-2010:p0942:b001:l008","ordinal":41310,"en":"He is renowned, he is a lion,"},{"id":"manas-2010:p0942:b001:l009","ordinal":41311,"en":"He is a warrior strong in the loins."},{"id":"manas-2010:p0942:b001:l010","ordinal":41312,"en":"Can any man charge him?"},{"id":"manas-2010:p0942:b001:l011","ordinal":41313,"en":"Can one who attacks survive?"},{"id":"manas-2010:p0942:b001:l012","ordinal":41314,"en":"He is a champion, he is skillful,"},{"id":"manas-2010:p0942:b001:l013","ordinal":41315,"en":"He is mighty beyond other mortals."},{"id":"manas-2010:p0942:b001:l014","ordinal":41316,"en":"Throwing the whole world into turmoil,"},{"id":"manas-2010:p0942:b001:l015","ordinal":41317,"en":"He could bring slaughter single-handed;"},{"id":"manas-2010:p0942:b001:l016","ordinal":41318,"en":"If he pressed against Bukhara,"},{"id":"manas-2010:p0942:b001:l017","ordinal":41319,"en":"He could bring turmoil alone."},{"id":"manas-2010:p0942:b001:l018","ordinal":41320,"en":"He is stout and very stooped,"},{"id":"manas-2010:p0942:b001:l019","ordinal":41321,"en":"A merciless warrior."},{"id":"manas-2010:p0942:b001:l020","ordinal":41322,"en":"Finding no mountain to strike,"},{"id":"manas-2010:p0942:b001:l021","ordinal":41323,"en":"Finding no foe to fight,"},{"id":"manas-2010:p0942:b001:l022","ordinal":41324,"en":"This fine man who has come"},{"id":"manas-2010:p0942:b001:l023","ordinal":41325,"en":"Is a warrior who has arrived."},{"id":"manas-2010:p0942:b001:l024","ordinal":41326,"en":"The whole world, let alone Bukhara,"},{"id":"manas-2010:p0942:b001:l025","ordinal":41327,"en":"If his boiling rage seized him,"},{"id":"manas-2010:p0942:b001:l026","ordinal":41328,"en":"He is a warrior who would wreck it."},{"id":"manas-2010:p0942:b001:l027","ordinal":41329,"en":"Keeping treasure, gathering livestock,"},{"id":"manas-2010:p0942:b001:l028","ordinal":41330,"en":"His care for others is plain!"},{"id":"manas-2010:p0942:b001:l029","ordinal":41331,"en":"Bringing slaughter when he fights,"},{"id":"manas-2010:p0942:b001:l030","ordinal":41332,"en":"His blood-thirst is plain."},{"id":"manas-2010:p0942:b001:l031","ordinal":41333,"en":"Of what clan could he be?"},{"id":"manas-2010:p0942:b001:l032","ordinal":41334,"en":"Of what lineage could he be?"},{"id":"manas-2010:p0942:b001:l033","ordinal":41335,"en":"Whose battle cry, what renown has he?"},{"id":"manas-2010:p0942:b001:l034","ordinal":41336,"en":"What is his clan, what is his village?"},{"id":"manas-2010:p0942:b001:l035","ordinal":41337,"en":"If we raise him as our khan,"},{"id":"manas-2010:p0942:b001:l036","ordinal":41338,"en":"An iron coat no shot can pierce—"},{"id":"manas-2010:p0942:b001:l037","ordinal":41339,"en":"He looks as though he would wear it."},{"id":"manas-2010:p0942:b001:l038","ordinal":41340,"en":"Smashing those who face him,"},{"id":"manas-2010:p0942:b001:l039","ordinal":41341,"en":"He looks as though he would drive them off."},{"id":"manas-2010:p0942:b001:l040","ordinal":41342,"en":"If a foe comes to confront him,"},{"id":"manas-2010:p0942:b001:l041","ordinal":41343,"en":"Calamity upon that enemy—"},{"id":"manas-2010:p0942:b001:l042","ordinal":41344,"en":"He looks as though he would bring it."},{"id":"manas-2010:p0943:b001:l001","ordinal":41345,"en":"The handful of Muslims,"},{"id":"manas-2010:p0943:b001:l002","ordinal":41346,"en":"Keeping them safe from unbelievers—"},{"id":"manas-2010:p0943:b001:l003","ordinal":41347,"en":"He looks as though he could save them."},{"id":"manas-2010:p0943:b001:l004","ordinal":41348,"en":"What a soul has come to Bukhara!"},{"id":"manas-2010:p0943:b001:l005","ordinal":41349,"en":"His round-headed mortals,"},{"id":"manas-2010:p0943:b001:l006","ordinal":41350,"en":"God Most High, the Almighty,"},{"id":"manas-2010:p0943:b001:l007","ordinal":41351,"en":"Creates in so many forms!"},{"id":"manas-2010:p0943:b001:l008","ordinal":41352,"en":"This man who has come to the gate,"},{"id":"manas-2010:p0943:b001:l009","ordinal":41353,"en":"Holding a people, gathering warriors,"},{"id":"manas-2010:p0943:b001:l010","ordinal":41354,"en":"Has the bearing of a mighty wrestler."},{"id":"manas-2010:p0943:b001:l011","ordinal":41355,"en":"Slaughter upon those who fight him—"},{"id":"manas-2010:p0943:b001:l012","ordinal":41356,"en":"He has the look of one who brings it."},{"id":"manas-2010:p0943:b001:l013","ordinal":41357,"en":"So many lands beneath his rule—"},{"id":"manas-2010:p0943:b001:l014","ordinal":41358,"en":"He has the look of one who takes them."},{"id":"manas-2010:p0943:b001:l015","ordinal":41359,"en":"Bearing a spear like a pine,"},{"id":"manas-2010:p0943:b001:l016","ordinal":41360,"en":"A battle-axe girded at his side,"},{"id":"manas-2010:p0943:b001:l017","ordinal":41361,"en":"From where has he come roaming?"},{"id":"manas-2010:p0943:b001:l018","ordinal":41362,"en":"Deep-browed, great-nosed,"},{"id":"manas-2010:p0943:b001:l019","ordinal":41363,"en":"Like an opened pit,"},{"id":"manas-2010:p0943:b001:l020","ordinal":41364,"en":"He has a head like a traveling pot,"},{"id":"manas-2010:p0943:b001:l021","ordinal":41365,"en":"Brows like a dog lying down,"},{"id":"manas-2010:p0943:b001:l022","ordinal":41366,"en":"Eyes like the hollows of a lake,"},{"id":"manas-2010:p0943:b001:l023","ordinal":41367,"en":"As though to swallow all he sees."},{"id":"manas-2010:p0943:b001:l024","ordinal":41368,"en":"His nose is like a mountain crag;"},{"id":"manas-2010:p0943:b001:l025","ordinal":41369,"en":"If he fought Bukhara,"},{"id":"manas-2010:p0943:b001:l026","ordinal":41370,"en":"He could plainly devour it.’"},{"id":"manas-2010:p0943:b001:l027","ordinal":41371,"en":"At the sight of Khan Bakay,"},{"id":"manas-2010:p0943:b001:l028","ordinal":41372,"en":"All Bukhara surged in alarm."},{"id":"manas-2010:p0943:b001:l029","ordinal":41373,"en":"Unable to collect themselves,"},{"id":"manas-2010:p0943:b001:l030","ordinal":41374,"en":"Its mighty wrestlers bowed their heads."},{"id":"manas-2010:p0943:b001:l031","ordinal":41375,"en":"Bukhara's people marveled,"},{"id":"manas-2010:p0943:b001:l032","ordinal":41376,"en":"Crowding round to see Bakay,"},{"id":"manas-2010:p0943:b001:l033","ordinal":41377,"en":"Hurriedly clearing the way."},{"id":"manas-2010:p0943:b001:l034","ordinal":41378,"en":"Seeing Bakay, all of them"},{"id":"manas-2010:p0943:b001:l035","ordinal":41379,"en":"Cried out their greetings."},{"id":"manas-2010:p0943:b001:l036","ordinal":41380,"en":"The people crowded round in wonder,"},{"id":"manas-2010:p0943:b001:l037","ordinal":41381,"en":"Stood watching then,"},{"id":"manas-2010:p0943:b001:l038","ordinal":41382,"en":"Astonished at Khan Bakay."},{"id":"manas-2010:p0943:b001:l039","ordinal":41383,"en":"‘He is a warrior, he is a giant;"},{"id":"manas-2010:p0943:b001:l040","ordinal":41384,"en":"No one has seen the like."},{"id":"manas-2010:p0943:b001:l041","ordinal":41385,"en":"He is of a people we have never seen!"},{"id":"manas-2010:p0943:b001:l042","ordinal":41386,"en":"Black-steel Zulpukor—"},{"id":"manas-2010:p0944:b001:l001","ordinal":41387,"en":"He looks like one who would fit it to a hilt."},{"id":"manas-2010:p0944:b001:l002","ordinal":41388,"en":"If we raise this warrior as khan,"},{"id":"manas-2010:p0944:b001:l003","ordinal":41389,"en":"These teeming people of Bukhara—"},{"id":"manas-2010:p0944:b001:l004","ordinal":41390,"en":"He looks like one who would lead them."},{"id":"manas-2010:p0944:b001:l005","ordinal":41391,"en":"Arkesken, brought into battle—"},{"id":"manas-2010:p0944:b001:l006","ordinal":41392,"en":"He looks like one who would fit it to a hilt."},{"id":"manas-2010:p0944:b001:l007","ordinal":41393,"en":"Our handful of Bukhara's people—"},{"id":"manas-2010:p0944:b001:l008","ordinal":41394,"en":"He looks like one who would lead them."},{"id":"manas-2010:p0944:b001:l009","ordinal":41395,"en":"A red spear, Zulpukor—"},{"id":"manas-2010:p0944:b001:l010","ordinal":41396,"en":"He looks like one who would take them."},{"id":"manas-2010:p0944:b001:l011","ordinal":41397,"en":"All twelve limbs are complete."},{"id":"manas-2010:p0944:b001:l012","ordinal":41398,"en":"If we raise him as khan of Bukhara,"},{"id":"manas-2010:p0944:b001:l013","ordinal":41399,"en":"He is an iron wall, a fortress.’"},{"id":"manas-2010:p0944:b001:l014","ordinal":41400,"en":"Unable to recognize Bakay,"},{"id":"manas-2010:p0944:b001:l015","ordinal":41401,"en":"All Bukhara marveled."},{"id":"manas-2010:p0944:b001:l016","ordinal":41402,"en":"Its holy men in white turbans,"},{"id":"manas-2010:p0944:b001:l017","ordinal":41403,"en":"Its mullahs reading lessons,"},{"id":"manas-2010:p0944:b001:l018","ordinal":41404,"en":"Their knees bending,"},{"id":"manas-2010:p0944:b001:l019","ordinal":41405,"en":"Ran with all their might."},{"id":"manas-2010:p0944:b001:l020","ordinal":41406,"en":"The elders called venerable,"},{"id":"manas-2010:p0944:b001:l021","ordinal":41407,"en":"All the people of Bukhara,"},{"id":"manas-2010:p0944:b001:l022","ordinal":41408,"en":"Its worthy men who uplifted it,"},{"id":"manas-2010:p0944:b001:l023","ordinal":41409,"en":"Its shamans who struck with lungs,"},{"id":"manas-2010:p0944:b001:l024","ordinal":41410,"en":"Its leading men now came."},{"id":"manas-2010:p0944:b001:l025","ordinal":41411,"en":"Its champions, its warriors,"},{"id":"manas-2010:p0944:b001:l026","ordinal":41412,"en":"Their knees bending,"},{"id":"manas-2010:p0944:b001:l027","ordinal":41413,"en":"Into Karakan's presence"},{"id":"manas-2010:p0944:b001:l028","ordinal":41414,"en":"They came running hard."},{"id":"manas-2010:p0944:b001:l029","ordinal":41415,"en":"The news to Karakan"},{"id":"manas-2010:p0944:b001:l030","ordinal":41416,"en":"They told with urgency:"},{"id":"manas-2010:p0944:b001:l031","ordinal":41417,"en":"‘Warrior Karakan, my hero,"},{"id":"manas-2010:p0944:b001:l032","ordinal":41418,"en":"You were a soul of sacred power,"},{"id":"manas-2010:p0944:b001:l033","ordinal":41419,"en":"A mighty khan of Bukhara!"},{"id":"manas-2010:p0944:b001:l034","ordinal":41420,"en":"Have you seen what we have seen?"},{"id":"manas-2010:p0944:b001:l035","ordinal":41421,"en":"Have you heard what we have heard?"},{"id":"manas-2010:p0944:b001:l036","ordinal":41422,"en":"If you have not heard what we have heard:"},{"id":"manas-2010:p0944:b001:l037","ordinal":41423,"en":"Bearing a red-steel spear,"},{"id":"manas-2010:p0944:b001:l038","ordinal":41424,"en":"Girded with an unsheathed sword,"},{"id":"manas-2010:p0944:b001:l039","ordinal":41425,"en":"His movement raising dust,"},{"id":"manas-2010:p0944:b001:l040","ordinal":41426,"en":"His voice driving out the soul,"},{"id":"manas-2010:p0944:b001:l041","ordinal":41427,"en":"His strength different, his menace fierce,"},{"id":"manas-2010:p0944:b001:l042","ordinal":41428,"en":"We saw an exceedingly mighty warrior."},{"id":"manas-2010:p0945:b001:l001","ordinal":41429,"en":"We saw a lion unlike any in the world,"},{"id":"manas-2010:p0945:b001:l002","ordinal":41430,"en":"High-browed, fiercely menacing,"},{"id":"manas-2010:p0945:b001:l003","ordinal":41431,"en":"Who levels anyone who attacks him."},{"id":"manas-2010:p0945:b001:l004","ordinal":41432,"en":"The mind is left bewildered."},{"id":"manas-2010:p0945:b001:l005","ordinal":41433,"en":"His figure and majesty"},{"id":"manas-2010:p0945:b001:l006","ordinal":41434,"en":"Show the appearance of a Muslim."},{"id":"manas-2010:p0945:b001:l007","ordinal":41435,"en":"We ran in haste and confusion,"},{"id":"manas-2010:p0945:b001:l008","ordinal":41436,"en":"Despaired of our entrusted lives."},{"id":"manas-2010:p0945:b001:l009","ordinal":41437,"en":"The reason we despaired:"},{"id":"manas-2010:p0945:b001:l010","ordinal":41438,"en":"As he came near the gate,"},{"id":"manas-2010:p0945:b001:l011","ordinal":41439,"en":"At one glance he was one man,"},{"id":"manas-2010:p0945:b001:l012","ordinal":41440,"en":"At another glance, a thousand men."},{"id":"manas-2010:p0945:b001:l013","ordinal":41441,"en":"A black-spotted leopard"},{"id":"manas-2010:p0945:b001:l014","ordinal":41442,"en":"Rears beside his flank,"},{"id":"manas-2010:p0945:b001:l015","ordinal":41443,"en":"As though to charge and bring slaughter."},{"id":"manas-2010:p0945:b001:l016","ordinal":41444,"en":"If he turns and swings his spear,"},{"id":"manas-2010:p0945:b001:l017","ordinal":41445,"en":"No mountain could withstand him."},{"id":"manas-2010:p0945:b001:l018","ordinal":41446,"en":"His imposing face—"},{"id":"manas-2010:p0945:b001:l019","ordinal":41447,"en":"No mortal could bear to approach it."},{"id":"manas-2010:p0945:b001:l020","ordinal":41448,"en":"If we look in front of him,"},{"id":"manas-2010:p0945:b001:l021","ordinal":41449,"en":"He has a dragon's appearance;"},{"id":"manas-2010:p0945:b001:l022","ordinal":41450,"en":"If we look behind him,"},{"id":"manas-2010:p0945:b001:l023","ordinal":41451,"en":"He has a white tiger's terror."},{"id":"manas-2010:p0945:b001:l024","ordinal":41452,"en":"No such soul arises in the world."},{"id":"manas-2010:p0945:b001:l025","ordinal":41453,"en":"We came to give you news,"},{"id":"manas-2010:p0945:b001:l026","ordinal":41454,"en":"To a khan like you, Temirkan."},{"id":"manas-2010:p0945:b001:l027","ordinal":41455,"en":"If you only saw his wrath,"},{"id":"manas-2010:p0945:b001:l028","ordinal":41456,"en":"You would despair of your life."},{"id":"manas-2010:p0945:b001:l029","ordinal":41457,"en":"His protector is Kozhosan,"},{"id":"manas-2010:p0945:b001:l030","ordinal":41458,"en":"Rearing beneath his arm."},{"id":"manas-2010:p0945:b001:l031","ordinal":41459,"en":"His true companions, forty hidden saints,"},{"id":"manas-2010:p0945:b001:l032","ordinal":41460,"en":"Make ready on forty sides."},{"id":"manas-2010:p0945:b001:l033","ordinal":41461,"en":"Unable to bear his wrath,"},{"id":"manas-2010:p0945:b001:l034","ordinal":41462,"en":"I close my eyes rather than look."},{"id":"manas-2010:p0945:b001:l035","ordinal":41463,"en":"Not believing he is a mortal,"},{"id":"manas-2010:p0945:b001:l036","ordinal":41464,"en":"I wonder, “Is he a spirit?”"},{"id":"manas-2010:p0945:b001:l037","ordinal":41465,"en":"A soul of terrible strength has come."},{"id":"manas-2010:p0945:b001:l038","ordinal":41466,"en":"My khan, come out and see!"},{"id":"manas-2010:p0945:b001:l039","ordinal":41467,"en":"Lest he ruin your people,"},{"id":"manas-2010:p0945:b001:l040","ordinal":41468,"en":"Give him your answer yourself."},{"id":"manas-2010:p0945:b001:l041","ordinal":41469,"en":"Let us not attack this warrior;"},{"id":"manas-2010:p0945:b001:l042","ordinal":41470,"en":"Give him what he asks at once!’"},{"id":"manas-2010:p0946:b001:l001","ordinal":41471,"en":"The teeming people had lost their strength,"},{"id":"manas-2010:p0946:b001:l002","ordinal":41472,"en":"Their wrists had lost their vigor,"}]
