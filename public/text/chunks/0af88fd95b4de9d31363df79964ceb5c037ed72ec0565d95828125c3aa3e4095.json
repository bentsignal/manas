[{"id":"semetey-1-2013:p0177:b005:l009","ordinal":90369,"en":"When we reach that desert,"},{"id":"semetey-1-2013:p0177:b005:l010","ordinal":90370,"en":"My dear mother,"},{"id":"semetey-1-2013:p0177:b005:l011","ordinal":90371,"en":"Will we not all be left helpless?"},{"id":"semetey-1-2013:p0177:b005:l012","ordinal":90372,"en":"The orphan we cradle—"},{"id":"semetey-1-2013:p0177:b005:l013","ordinal":90373,"en":"May untimely death not overtake him!"},{"id":"semetey-1-2013:p0177:b005:l014","ordinal":90374,"en":"May no terrible hardship come"},{"id":"semetey-1-2013:p0177:b005:l015","ordinal":90375,"en":"And leave us helpless like this.’"},{"id":"semetey-1-2013:p0177:b005:l016","ordinal":90376,"en":"Chyiyrdy then said:"},{"id":"semetey-1-2013:p0177:b005:l017","ordinal":90377,"en":"‘For the survivor, fresh fish!"},{"id":"semetey-1-2013:p0177:b005:l018","ordinal":90378,"en":"Oh, Kanykei, my foal,"},{"id":"semetey-1-2013:p0177:b005:l019","ordinal":90379,"en":"Those whose death is due will die;"},{"id":"semetey-1-2013:p0177:b005:l020","ordinal":90380,"en":"Those who live will find a living."},{"id":"semetey-1-2013:p0177:b005:l021","ordinal":90381,"en":"To the person still alive,"},{"id":"semetey-1-2013:p0177:b005:l022","ordinal":90382,"en":"The one God will grant sustenance."},{"id":"semetey-1-2013:p0177:b005:l023","ordinal":90383,"en":"The lean horse will grow fat;"},{"id":"semetey-1-2013:p0177:b005:l024","ordinal":90384,"en":"The hungry belly will be filled!"},{"id":"semetey-1-2013:p0177:b005:l025","ordinal":90385,"en":"Since God has granted our wish,"},{"id":"semetey-1-2013:p0177:b005:l026","ordinal":90386,"en":"Since this omen has come true,"},{"id":"semetey-1-2013:p0177:b005:l027","ordinal":90387,"en":"To the withered plane tree"},{"id":"semetey-1-2013:p0177:b005:l028","ordinal":90388,"en":"The nightingale has returned;"},{"id":"semetey-1-2013:p0177:b005:l029","ordinal":90389,"en":"Your little lake, dried out,"},{"id":"semetey-1-2013:p0177:b005:l030","ordinal":90390,"en":"Has filled with water once again."},{"id":"semetey-1-2013:p0177:b005:l031","ordinal":90391,"en":"What was severed will be joined;"},{"id":"semetey-1-2013:p0177:b005:l032","ordinal":90392,"en":"Those scattered will gather;"},{"id":"semetey-1-2013:p0177:b005:l033","ordinal":90393,"en":"This grieving soul will rejoice."},{"id":"semetey-1-2013:p0177:b005:l034","ordinal":90394,"en":"Bring the provisions here;"},{"id":"semetey-1-2013:p0177:b005:l035","ordinal":90395,"en":"I shall rest here,"},{"id":"semetey-1-2013:p0177:b005:l036","ordinal":90396,"en":"And eat a thanksgiving meal!’"},{"id":"semetey-1-2013:p0177:b005:l037","ordinal":90397,"en":"As Chyiyrdy spoke thus,"},{"id":"semetey-1-2013:p0177:b005:l038","ordinal":90398,"en":"Your heroic sister-in-law Kanykei,"},{"id":"semetey-1-2013:p0177:b005:l039","ordinal":90399,"en":"Unable to say, ‘I will not give it,’"},{"id":"semetey-1-2013:p0178:b003:l001","ordinal":90400,"en":"The heroine would not disappoint her mother;"},{"id":"semetey-1-2013:p0178:b003:l002","ordinal":90401,"en":"She did not look about,"},{"id":"semetey-1-2013:p0178:b003:l003","ordinal":90402,"en":"Could not say, ‘No, Mother,’"},{"id":"semetey-1-2013:p0178:b003:l004","ordinal":90403,"en":"Did not make her repeat her words,"},{"id":"semetey-1-2013:p0178:b003:l005","ordinal":90404,"en":"Did not stand watching in distress."},{"id":"semetey-1-2013:p0178:b003:l006","ordinal":90405,"en":"When all their wealth was scattered,"},{"id":"semetey-1-2013:p0178:b003:l007","ordinal":90406,"en":"Unable to remain in burning grief,"},{"id":"semetey-1-2013:p0178:b003:l008","ordinal":90407,"en":"When the two ladies fled this way,"},{"id":"semetey-1-2013:p0178:b003:l009","ordinal":90408,"en":"Khan Bakai caught up behind them."},{"id":"semetey-1-2013:p0178:b003:l010","ordinal":90409,"en":"On the ridge like a saddle,"},{"id":"semetey-1-2013:p0178:b003:l011","ordinal":90410,"en":"When he met the orphan,"},{"id":"semetey-1-2013:p0178:b003:l012","ordinal":90411,"en":"He gave six skins of milk,"},{"id":"semetey-1-2013:p0178:b003:l013","ordinal":90412,"en":"He gave two fat horses."},{"id":"semetey-1-2013:p0178:b003:l014","ordinal":90413,"en":"The food Bakai had given—"},{"id":"semetey-1-2013:p0178:b003:l015","ordinal":90414,"en":"That wether they had slaughtered—"},{"id":"semetey-1-2013:p0178:b003:l016","ordinal":90415,"en":"Of the wether's meat,"},{"id":"semetey-1-2013:p0178:b003:l017","ordinal":90416,"en":"Half a joint of meat remained."},{"id":"semetey-1-2013:p0178:b003:l018","ordinal":90417,"en":"Of the six skins of milk,"},{"id":"semetey-1-2013:p0178:b003:l019","ordinal":90418,"en":"Half a flask of milk remained."},{"id":"semetey-1-2013:p0178:b003:l020","ordinal":90419,"en":"Your heroic sister-in-law Kanykei"},{"id":"semetey-1-2013:p0178:b003:l021","ordinal":90420,"en":"Brought them over in distress."},{"id":"semetey-1-2013:p0178:b003:l022","ordinal":90421,"en":"Snatching them from her hand,"},{"id":"semetey-1-2013:p0178:b003:l023","ordinal":90422,"en":"The venerable lady Chyiyrdy"},{"id":"semetey-1-2013:p0178:b003:l024","ordinal":90423,"en":"Prayed to the one God."},{"id":"semetey-1-2013:p0178:b003:l025","ordinal":90424,"en":"They fell upon the food and ate their fill;"},{"id":"semetey-1-2013:p0178:b003:l026","ordinal":90425,"en":"They prayed to God"},{"id":"semetey-1-2013:p0178:b003:l027","ordinal":90426,"en":"And ceased their weeping."},{"id":"semetey-1-2013:p0178:b003:l028","ordinal":90427,"en":"Its collar was gold, its sleeves were copper,"},{"id":"semetey-1-2013:p0178:b003:l029","ordinal":90428,"en":"Double mail, with lark-eye rings,"},{"id":"semetey-1-2013:p0178:b003:l030","ordinal":90429,"en":"A broad war jacket of fine cloth,"},{"id":"semetey-1-2013:p0178:b003:l031","ordinal":90430,"en":"A handsome coat of precious white cloth,"},{"id":"semetey-1-2013:p0178:b003:l032","ordinal":90431,"en":"With fine iron wire embedded,"},{"id":"semetey-1-2013:p0178:b003:l033","ordinal":90432,"en":"That defeated the short gun's bullets,"},{"id":"semetey-1-2013:p0178:b003:l034","ordinal":90433,"en":"That musket balls could not enter,"},{"id":"semetey-1-2013:p0178:b003:l035","ordinal":90434,"en":"That arrows could not penetrate."},{"id":"semetey-1-2013:p0178:b003:l036","ordinal":90435,"en":"Inside it was worked with fine cloth;"},{"id":"semetey-1-2013:p0178:b003:l037","ordinal":90436,"en":"Its outside, that dear woman Kanykei"},{"id":"semetey-1-2013:p0178:b003:l039","ordinal":90437,"en":"Had worked tirelessly with her teeth."},{"id":"semetey-1-2013:p0178:b004:l001","ordinal":90438,"en":"Staring at this coat,"},{"id":"semetey-1-2013:p0178:b004:l002","ordinal":90439,"en":"Her dear eyes had grown dim."},{"id":"semetey-1-2013:p0178:b004:l003","ordinal":90440,"en":"Working this coat with her teeth,"},{"id":"semetey-1-2013:p0178:b004:l004","ordinal":90441,"en":"Her spade-like teeth had ached."},{"id":"semetey-1-2013:p0178:b004:l005","ordinal":90442,"en":"Orenburg and Margilan—"},{"id":"semetey-1-2013:p0178:b004:l006","ordinal":90443,"en":"She had the land between them searched."},{"id":"semetey-1-2013:p0178:b004:l007","ordinal":90444,"en":"From merchants coming from there,"},{"id":"semetey-1-2013:p0178:b004:l008","ordinal":90445,"en":"She had it brought by force."},{"id":"semetey-1-2013:p0178:b004:l009","ordinal":90446,"en":"Two spans and four fingerbreadths"},{"id":"semetey-1-2013:p0178:b004:l010","ordinal":90447,"en":"Of quilted fine cloth in width"},{"id":"semetey-1-2013:p0178:b004:l011","ordinal":90448,"en":"She had placed in its middle."},{"id":"semetey-1-2013:p0178:b004:l012","ordinal":90449,"en":"The white-cloth coat left by Manas,"},{"id":"semetey-1-2013:p0178:b004:l013","ordinal":90450,"en":"The two ladies spread beneath their hips."},{"id":"semetey-1-2013:p0178:b004:l014","ordinal":90451,"en":"Its front pommel was pure gold,"},{"id":"semetey-1-2013:p0178:b004:l015","ordinal":90452,"en":"Its rear pommel solid silver,"},{"id":"semetey-1-2013:p0178:b004:l016","ordinal":90453,"en":"Its two sides broad iron—"},{"id":"semetey-1-2013:p0178:b004:l017","ordinal":90454,"en":"The broad-pommeled saddle Almambet had made,"},{"id":"semetey-1-2013:p0178:b004:l018","ordinal":90455,"en":"They laid beneath their heads."},{"id":"semetey-1-2013:p0178:b004:l019","ordinal":90456,"en":"They took a little sleep,"},{"id":"semetey-1-2013:p0178:b004:l020","ordinal":90457,"en":"Resting quietly upon their elbows,"},{"id":"semetey-1-2013:p0178:b004:l021","ordinal":90458,"en":"Sinking into true sleep."},{"id":"semetey-1-2013:p0178:b004:l022","ordinal":90459,"en":"Sounded trumpets and rested at ease."},{"id":"semetey-1-2013:p0178:b004:l023","ordinal":90460,"en":"They banished all their sorrow."},{"id":"semetey-1-2013:p0178:b004:l024","ordinal":90461,"en":"Left by Manas,"},{"id":"semetey-1-2013:p0178:b004:l025","ordinal":90462,"en":"The orphan still in his cradle,"},{"id":"semetey-1-2013:p0178:b004:l026","ordinal":90463,"en":"They placed between them"},{"id":"semetey-1-2013:p0178:b004:l027","ordinal":90464,"en":"And lay down and slept."},{"id":"semetey-1-2013:p0178:b004:l028","ordinal":90465,"en":"Let us leave them there;"},{"id":"semetey-1-2013:p0178:b004:l029","ordinal":90466,"en":"Temir Khan, the khan of Bukhara—"},{"id":"semetey-1-2013:p0178:b004:l030","ordinal":90467,"en":"Let us now begin his story."},{"id":"semetey-1-2013:p0178:b004:l031","ordinal":90468,"en":"Temir Khan, the khan of Bukhara,"},{"id":"semetey-1-2013:p0178:b004:l032","ordinal":90469,"en":"Was a khan of sacred power."},{"id":"semetey-1-2013:p0178:b004:l033","ordinal":90470,"en":"Temir Khan had"},{"id":"semetey-1-2013:p0178:b004:l034","ordinal":90471,"en":"Twelve daughters."},{"id":"semetey-1-2013:p0178:b004:l035","ordinal":90472,"en":"The thirteenth was Kanykei,"},{"id":"semetey-1-2013:p0178:b004:l036","ordinal":90473,"en":"The fourteenth, Ismayil,"},{"id":"semetey-1-2013:p0178:b004:l037","ordinal":90474,"en":"Was his only son, born after long yearning."},{"id":"semetey-1-2013:p0178:b004:l039","ordinal":90475,"en":"What he had asked of the one God"},{"id":"semetey-1-2013:p0179:b003:l001","ordinal":90476,"en":"Had now been granted to him."},{"id":"semetey-1-2013:p0179:b003:l002","ordinal":90477,"en":"He had reached twenty-five;"},{"id":"semetey-1-2013:p0179:b003:l003","ordinal":90478,"en":"That time had now arrived."},{"id":"semetey-1-2013:p0179:b003:l004","ordinal":90479,"en":"At that time Ismayil"},{"id":"semetey-1-2013:p0179:b003:l005","ordinal":90480,"en":"Wore a golden crown"},{"id":"semetey-1-2013:p0179:b003:l006","ordinal":90481,"en":"And sat upon a golden throne."},{"id":"semetey-1-2013:p0179:b003:l007","ordinal":90482,"en":"Among twelve nations, none could cast"},{"id":"semetey-1-2013:p0179:b003:l008","ordinal":90483,"en":"At a khan like Ismayil"},{"id":"semetey-1-2013:p0179:b003:l009","ordinal":90484,"en":"A catching-pole to turn him back."},{"id":"semetey-1-2013:p0179:b003:l010","ordinal":90485,"en":"Two reins and a single lead rope,"},{"id":"semetey-1-2013:p0179:b003:l011","ordinal":90486,"en":"Wound firmly about his wrist,"},{"id":"semetey-1-2013:p0179:b003:l012","ordinal":90487,"en":"He had taken hold of them."},{"id":"semetey-1-2013:p0179:b003:l013","ordinal":90488,"en":"In his father's place,"},{"id":"semetey-1-2013:p0179:b003:l014","ordinal":90489,"en":"Without letting his people stir,"},{"id":"semetey-1-2013:p0179:b003:l015","ordinal":90490,"en":"He had come to rule them."},{"id":"semetey-1-2013:p0179:b003:l016","ordinal":90491,"en":"Chasing wild sheep over the ridges,"},{"id":"semetey-1-2013:p0179:b003:l017","ordinal":90492,"en":"Chasing deer over rough terrain,"},{"id":"semetey-1-2013:p0179:b003:l018","ordinal":90493,"en":"Finding no mountain to challenge,"},{"id":"semetey-1-2013:p0179:b003:l019","ordinal":90494,"en":"Finding no enemy to fight,"},{"id":"semetey-1-2013:p0179:b003:l020","ordinal":90495,"en":"With sixty strongmen beside him,"},{"id":"semetey-1-2013:p0179:b003:l021","ordinal":90496,"en":"Ismayil, son of Temir Khan,"},{"id":"semetey-1-2013:p0179:b003:l022","ordinal":90497,"en":"Wore out his horse and scoured the land,"},{"id":"semetey-1-2013:p0179:b003:l023","ordinal":90498,"en":"Loosing hounds and flying hawks."},{"id":"semetey-1-2013:p0179:b003:l024","ordinal":90499,"en":"His strongmen strode about;"},{"id":"semetey-1-2013:p0179:b003:l025","ordinal":90500,"en":"Every one of his strongmen"},{"id":"semetey-1-2013:p0179:b003:l026","ordinal":90501,"en":"Was skilled with the spear,"},{"id":"semetey-1-2013:p0179:b003:l027","ordinal":90502,"en":"A master at striking with the battle-axe."},{"id":"semetey-1-2013:p0179:b003:l028","ordinal":90503,"en":"When a black gun thundered,"},{"id":"semetey-1-2013:p0179:b003:l029","ordinal":90504,"en":"They were champions who would not flee."},{"id":"semetey-1-2013:p0179:b003:l030","ordinal":90505,"en":"When a fierce gun cracked,"},{"id":"semetey-1-2013:p0179:b003:l031","ordinal":90506,"en":"They were skilled men who did not start."},{"id":"semetey-1-2013:p0179:b003:l032","ordinal":90507,"en":"Broad of chest and wide of breast,"},{"id":"semetey-1-2013:p0179:b003:l033","ordinal":90508,"en":"They were stately, capable men."},{"id":"semetey-1-2013:p0179:b003:l034","ordinal":90509,"en":"Tall and broad-shouldered,"},{"id":"semetey-1-2013:p0179:b003:l035","ordinal":90510,"en":"Every one of his strongmen"},{"id":"semetey-1-2013:p0179:b003:l036","ordinal":90511,"en":"Was a stately champion."},{"id":"semetey-1-2013:p0179:b003:l037","ordinal":90512,"en":"Their leader was Hero Ismayil,"},{"id":"semetey-1-2013:p0179:b003:l038","ordinal":90513,"en":"With sixty strongmen beside him."},{"id":"semetey-1-2013:p0179:b003:l039","ordinal":90514,"en":"On the slopes of It-Torpu,"},{"id":"semetey-1-2013:p0179:b005:l001","ordinal":90515,"en":"At the edge of Great Bukhara,"},{"id":"semetey-1-2013:p0179:b005:l002","ordinal":90516,"en":"On a spur where the mountains ended,"},{"id":"semetey-1-2013:p0179:b005:l003","ordinal":90517,"en":"On a blunt jutting headland,"},{"id":"semetey-1-2013:p0179:b005:l004","ordinal":90518,"en":"Ismayil came up"},{"id":"semetey-1-2013:p0179:b005:l005","ordinal":90519,"en":"And turned his great brown horse."},{"id":"semetey-1-2013:p0179:b005:l006","ordinal":90520,"en":"He shouted for his strongmen,"},{"id":"semetey-1-2013:p0179:b005:l007","ordinal":90521,"en":"Called his heroes;"},{"id":"semetey-1-2013:p0179:b005:l008","ordinal":90522,"en":"When his heroes came beside him,"},{"id":"semetey-1-2013:p0179:b005:l009","ordinal":90523,"en":"These were Ismayil's words:"},{"id":"semetey-1-2013:p0179:b005:l010","ordinal":90524,"en":"‘My dear strongmen,"},{"id":"semetey-1-2013:p0179:b005:l011","ordinal":90525,"en":"Come here, men!"},{"id":"semetey-1-2013:p0179:b005:l012","ordinal":90526,"en":"God creates the soul;"},{"id":"semetey-1-2013:p0179:b005:l013","ordinal":90527,"en":"My dear strongmen,"},{"id":"semetey-1-2013:p0179:b005:l014","ordinal":90528,"en":"My soul is leaving me."},{"id":"semetey-1-2013:p0179:b005:l015","ordinal":90529,"en":"My dear strongmen,"},{"id":"semetey-1-2013:p0179:b005:l016","ordinal":90530,"en":"A marten-fur cap upon the head—"},{"id":"semetey-1-2013:p0179:b005:l017","ordinal":90531,"en":"Who has not worn one jauntily?"},{"id":"semetey-1-2013:p0179:b005:l018","ordinal":90532,"en":"When good fortune rests upon one's head,"},{"id":"semetey-1-2013:p0179:b005:l019","ordinal":90533,"en":"Who has not gone about thundering?"},{"id":"semetey-1-2013:p0179:b005:l020","ordinal":90534,"en":"My dear strongmen,"},{"id":"semetey-1-2013:p0179:b005:l021","ordinal":90535,"en":"Let me speak my grief now."},{"id":"semetey-1-2013:p0179:b005:l022","ordinal":90536,"en":"At the sight of my brother-in-law,"},{"id":"semetey-1-2013:p0179:b005:l023","ordinal":90537,"en":"Not merely the Muslims—"},{"id":"semetey-1-2013:p0179:b005:l024","ordinal":90538,"en":"Even the Chinese khan trembled."},{"id":"semetey-1-2013:p0179:b005:l025","ordinal":90539,"en":"The Russians on his right—"},{"id":"semetey-1-2013:p0179:b005:l026","ordinal":90540,"en":"Was it not my brother-in-law who mowed them down?"},{"id":"semetey-1-2013:p0179:b005:l027","ordinal":90541,"en":"The Chinese upon the ridges—"},{"id":"semetey-1-2013:p0179:b005:l028","ordinal":90542,"en":"Was it not my brother-in-law who slaughtered them?"},{"id":"semetey-1-2013:p0179:b005:l029","ordinal":90543,"en":"He drove white deer and made them cattle;"},{"id":"semetey-1-2013:p0179:b005:l030","ordinal":90544,"en":"My brother-in-law, leopard Manas,"},{"id":"semetey-1-2013:p0179:b005:l031","ordinal":90545,"en":"Threw the whole world into turmoil!"},{"id":"semetey-1-2013:p0179:b005:l032","ordinal":90546,"en":"He drove gray deer and made them cattle;"},{"id":"semetey-1-2013:p0179:b005:l033","ordinal":90547,"en":"My brother-in-law, leopard Manas,"},{"id":"semetey-1-2013:p0179:b005:l034","ordinal":90548,"en":"Threw every land in sight into turmoil!"},{"id":"semetey-1-2013:p0179:b005:l035","ordinal":90549,"en":"With a road that Khizyr had opened,"},{"id":"semetey-1-2013:p0179:b005:l036","ordinal":90550,"en":"With four hundred twenty thousand troops,"},{"id":"semetey-1-2013:p0179:b005:l037","ordinal":90551,"en":"When he scattered the infidels' livestock,"},{"id":"semetey-1-2013:p0179:b005:l038","ordinal":90552,"en":"When he opened the way for Islam,"},{"id":"semetey-1-2013:p0179:b005:l039","ordinal":90553,"en":"Great Beijing, looming dark—"},{"id":"semetey-1-2013:p0180:b003:l001","ordinal":90554,"en":"When he entered straight in, thrusting his spear,"},{"id":"semetey-1-2013:p0180:b003:l002","ordinal":90555,"en":"From that darkened hell"},{"id":"semetey-1-2013:p0180:b003:l003","ordinal":90556,"en":"When he freed living souls,"},{"id":"semetey-1-2013:p0180:b003:l004","ordinal":90557,"en":"Into Beijing with its emperor,"},{"id":"semetey-1-2013:p0180:b003:l005","ordinal":90558,"en":"Spear in hand, he broke the ranks;"},{"id":"semetey-1-2013:p0180:b003:l006","ordinal":90559,"en":"Those whose time had come fell to bullets."},{"id":"semetey-1-2013:p0180:b003:l007","ordinal":90560,"en":"Then Muzburchak and Khan Kokcho died;"},{"id":"semetey-1-2013:p0180:b003:l008","ordinal":90561,"en":"All those who faced Beijing died."},{"id":"semetey-1-2013:p0180:b003:l010","ordinal":90562,"en":"Akkula was shot down;"},{"id":"semetey-1-2013:p0180:b003:l011","ordinal":90563,"en":"Fighting against the Chinese,"},{"id":"semetey-1-2013:p0180:b003:l012","ordinal":90564,"en":"Almambet passed away a martyr."},{"id":"semetey-1-2013:p0180:b003:l013","ordinal":90565,"en":"Deprived of his wing,"},{"id":"semetey-1-2013:p0180:b003:l014","ordinal":90566,"en":"The one he relied upon—"},{"id":"semetey-1-2013:p0180:b003:l015","ordinal":90567,"en":"Then he lost Khan Chubak."},{"id":"semetey-1-2013:p0180:b003:l016","ordinal":90568,"en":"Beijing, untouched by Khizyr,"},{"id":"semetey-1-2013:p0180:b003:l017","ordinal":90569,"en":"Had him ambushed from the ridges;"},{"id":"semetey-1-2013:p0180:b003:l018","ordinal":90570,"en":"All the mighty heroes"},{"id":"semetey-1-2013:p0180:b003:l019","ordinal":90571,"en":"Were taken by China as trophies."},{"id":"semetey-1-2013:p0180:b003:l020","ordinal":90572,"en":"He entered Beijing and turned back,"},{"id":"semetey-1-2013:p0180:b003:l021","ordinal":90573,"en":"Parted from his champions;"},{"id":"semetey-1-2013:p0180:b003:l022","ordinal":90574,"en":"Beijing, whose presence was fearsome,"},{"id":"semetey-1-2013:p0180:b003:l023","ordinal":90575,"en":"Caught him by surprise."},{"id":"semetey-1-2013:p0180:b003:l024","ordinal":90576,"en":"Konurbai, the infidels' khan,"},{"id":"semetey-1-2013:p0180:b003:l025","ordinal":90577,"en":"Stabbed him unawares."},{"id":"semetey-1-2013:p0180:b003:l026","ordinal":90578,"en":"Wounded, from that place"},{"id":"semetey-1-2013:p0180:b003:l027","ordinal":90579,"en":"He barely returned, I heard."},{"id":"semetey-1-2013:p0180:b003:l028","ordinal":90580,"en":"Struck among the ribs,"},{"id":"semetey-1-2013:p0180:b003:l029","ordinal":90581,"en":"Pierced square in the kidney,"},{"id":"semetey-1-2013:p0180:b003:l030","ordinal":90582,"en":"My blessed brother-in-law, Khan Manas,"},{"id":"semetey-1-2013:p0180:b003:l031","ordinal":90583,"en":"Came back in a terrible state, I heard."},{"id":"semetey-1-2013:p0180:b003:l032","ordinal":90584,"en":"Left all on her own,"},{"id":"semetey-1-2013:p0180:b003:l033","ordinal":90585,"en":"My sister lost her husband,"},{"id":"semetey-1-2013:p0180:b003:l034","ordinal":90586,"en":"At thirty-two years of age."},{"id":"semetey-1-2013:p0180:b003:l035","ordinal":90587,"en":"They say my brother-in-law has died."},{"id":"semetey-1-2013:p0180:b003:l036","ordinal":90588,"en":"From a traveler I heard"},{"id":"semetey-1-2013:p0180:b003:l037","ordinal":90589,"en":"That six accursed scoundrels"},{"id":"semetey-1-2013:p0180:b003:l038","ordinal":90590,"en":"The countless riches my brother-in-law left—"},{"id":"semetey-1-2013:p0180:b003:l039","ordinal":90591,"en":"They divided them, measuring shares with a whip."},{"id":"semetey-1-2013:p0180:b004:l001","ordinal":90592,"en":"Valuing that wealth at less than a penny,"},{"id":"semetey-1-2013:p0180:b004:l002","ordinal":90593,"en":"My leopard sister Kanykei,"},{"id":"semetey-1-2013:p0180:b004:l003","ordinal":90594,"en":"They say, scattered it all."},{"id":"semetey-1-2013:p0180:b004:l004","ordinal":90595,"en":"Carrying her child upon her back,"},{"id":"semetey-1-2013:p0180:b004:l005","ordinal":90596,"en":"Alas, she fled toward Bukhara, they say."},{"id":"semetey-1-2013:p0180:b004:l007","ordinal":90597,"en":"My dear strongmen,"},{"id":"semetey-1-2013:p0180:b004:l008","ordinal":90598,"en":"Let the skilled spearmen come;"},{"id":"semetey-1-2013:p0180:b004:l009","ordinal":90599,"en":"Clear of mind and true of speech,"},{"id":"semetey-1-2013:p0180:b004:l010","ordinal":90600,"en":"Let the champions who cannot stand idle come;"},{"id":"semetey-1-2013:p0180:b004:l011","ordinal":90601,"en":"Let the lions protected by Shay come;"},{"id":"semetey-1-2013:p0180:b004:l012","ordinal":90602,"en":"Let the men who can find counsel come."},{"id":"semetey-1-2013:p0180:b004:l013","ordinal":90603,"en":"Back then, when black ice lay in great sheets,"},{"id":"semetey-1-2013:p0180:b004:l014","ordinal":90604,"en":"When my leopard sister was a girl,"},{"id":"semetey-1-2013:p0180:b004:l015","ordinal":90605,"en":"My sister Kanykei"},{"id":"semetey-1-2013:p0180:b004:l016","ordinal":90606,"en":"Was still a little child;"},{"id":"semetey-1-2013:p0180:b004:l017","ordinal":90607,"en":"Her hair was not yet long enough to braid;"},{"id":"semetey-1-2013:p0180:b004:l018","ordinal":90608,"en":"She had not passed fourteen."},{"id":"semetey-1-2013:p0180:b004:l019","ordinal":90609,"en":"My dear sister Kanykei,"},{"id":"semetey-1-2013:p0180:b004:l020","ordinal":90610,"en":"The beauty of the dark-complexioned,"},{"id":"semetey-1-2013:p0180:b004:l021","ordinal":90611,"en":"The radiant one among Muslims,"},{"id":"semetey-1-2013:p0180:b004:l022","ordinal":90612,"en":"My father Temir Khan's golden throne—"},{"id":"semetey-1-2013:p0180:b004:l023","ordinal":90613,"en":"When she made her home there,"},{"id":"semetey-1-2013:p0180:b004:l024","ordinal":90614,"en":"Over all the people,"},{"id":"semetey-1-2013:p0180:b004:l025","ordinal":90615,"en":"When she was their maiden sovereign,"},{"id":"semetey-1-2013:p0180:b004:l026","ordinal":90616,"en":"Let me tell of the games she played."},{"id":"semetey-1-2013:p0180:b004:l027","ordinal":90617,"en":"At my sister Kanykei's side"},{"id":"semetey-1-2013:p0180:b004:l028","ordinal":90618,"en":"Were thirty married women, thirty girls."},{"id":"semetey-1-2013:p0180:b004:l029","ordinal":90619,"en":"Entered its throat."},{"id":"semetey-1-2013:p0180:b004:l030","ordinal":90620,"en":"All the finest entertainers,"},{"id":"semetey-1-2013:p0180:b004:l031","ordinal":90621,"en":"My sister would gather them closely."},{"id":"semetey-1-2013:p0180:b004:l032","ordinal":90622,"en":"She poured sugar out like snow,"},{"id":"semetey-1-2013:p0180:b004:l033","ordinal":90623,"en":"Heaped up clarified butter."},{"id":"semetey-1-2013:p0180:b004:l034","ordinal":90624,"en":"Even soaked in water forty years,"}]
