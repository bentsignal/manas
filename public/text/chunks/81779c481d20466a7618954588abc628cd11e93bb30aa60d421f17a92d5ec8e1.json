[{"id":"manas-2010:p1007:b001:l005","ordinal":44033,"en":"To the Chinese people's Deep Beijing"},{"id":"manas-2010:p1007:b001:l006","ordinal":44034,"en":"I shall go without tiring."},{"id":"manas-2010:p1007:b001:l007","ordinal":44035,"en":"If my strength suffices, sparing nothing,"},{"id":"manas-2010:p1007:b001:l008","ordinal":44036,"en":"I shall bring slaughter upon the foe."},{"id":"manas-2010:p1007:b001:l009","ordinal":44037,"en":"Upon the swarming Chinese,"},{"id":"manas-2010:p1007:b001:l010","ordinal":44038,"en":"Upon their heads like Judgment Day,"},{"id":"manas-2010:p1007:b001:l011","ordinal":44039,"en":"I shall bring the end of the world!"},{"id":"manas-2010:p1007:b001:l012","ordinal":44040,"en":"If my death-hour comes, I shall die."},{"id":"manas-2010:p1007:b001:l013","ordinal":44041,"en":"Scouting Beijing,"},{"id":"manas-2010:p1007:b001:l014","ordinal":44042,"en":"I shall go and return without tiring!"},{"id":"manas-2010:p1007:b001:l015","ordinal":44043,"en":"In Kakanchyn's Beijing,"},{"id":"manas-2010:p1007:b001:l016","ordinal":44044,"en":"The wailing Chinese"},{"id":"manas-2010:p1007:b001:l017","ordinal":44045,"en":"I shall scatter and divide."},{"id":"manas-2010:p1007:b001:l018","ordinal":44046,"en":"I shall wield a spear, break their ranks;"},{"id":"manas-2010:p1007:b001:l019","ordinal":44047,"en":"If my death-hour comes this year, I shall fall to a shot!"},{"id":"manas-2010:p1007:b001:l020","ordinal":44048,"en":"What is written on my forehead,"},{"id":"manas-2010:p1007:b001:l021","ordinal":44049,"en":"Wherever it may be, I shall see."},{"id":"manas-2010:p1007:b001:l022","ordinal":44050,"en":"For my people, to Beijing"},{"id":"manas-2010:p1007:b001:l023","ordinal":44051,"en":"I shall go and return without grieving."},{"id":"manas-2010:p1007:b001:l024","ordinal":44052,"en":"The journey there and back is two months;"},{"id":"manas-2010:p1007:b001:l025","ordinal":44053,"en":"In two months I shall return."},{"id":"manas-2010:p1007:b001:l026","ordinal":44054,"en":"If I stay beyond the second month,"},{"id":"manas-2010:p1007:b001:l027","ordinal":44055,"en":"Fate has come and I have died!’"},{"id":"manas-2010:p1007:b001:l028","ordinal":44056,"en":"Then Manas stood tall,"},{"id":"manas-2010:p1007:b001:l029","ordinal":44057,"en":"Poised like a falcon,"},{"id":"manas-2010:p1007:b001:l030","ordinal":44058,"en":"Watched with an intent gaze,"},{"id":"manas-2010:p1007:b001:l031","ordinal":44059,"en":"With Almambet's words"},{"id":"manas-2010:p1007:b001:l032","ordinal":44060,"en":"Pleased within himself:"},{"id":"manas-2010:p1007:b001:l033","ordinal":44061,"en":"‘My red spear, my banner,"},{"id":"manas-2010:p1007:b001:l034","ordinal":44062,"en":"Almambet, named a mighty warrior,"},{"id":"manas-2010:p1007:b001:l035","ordinal":44063,"en":"My gift who came from the Chinese,"},{"id":"manas-2010:p1007:b001:l036","ordinal":44064,"en":"My black standard, my banner,"},{"id":"manas-2010:p1007:b001:l037","ordinal":44065,"en":"From Kakanchyn's Beijing"},{"id":"manas-2010:p1007:b001:l038","ordinal":44066,"en":"My champion who came fleeing,"},{"id":"manas-2010:p1007:b001:l039","ordinal":44067,"en":"Scatter the Chinese people's livestock for me."},{"id":"manas-2010:p1007:b001:l040","ordinal":44068,"en":"While his mane is like a lead-rope,"},{"id":"manas-2010:p1007:b001:l041","ordinal":44069,"en":"He will not yield to a determined foe."},{"id":"manas-2010:p1007:b001:l042","ordinal":44070,"en":"Unless true Heaven strikes him,"},{"id":"manas-2010:p1008:b001:l001","ordinal":44071,"en":"He will not let a warrior be taken from his back."},{"id":"manas-2010:p1008:b001:l002","ordinal":44072,"en":"Ridden on a scouting journey, he does not tire."},{"id":"manas-2010:p1008:b001:l003","ordinal":44073,"en":"If you fight ten days without rest,"},{"id":"manas-2010:p1008:b001:l004","ordinal":44074,"en":"He does not weary of running."},{"id":"manas-2010:p1008:b001:l005","ordinal":44075,"en":"When his mature years were counted,"},{"id":"manas-2010:p1008:b001:l006","ordinal":44076,"en":"He had reached quite a number."},{"id":"manas-2010:p1008:b001:l007","ordinal":44077,"en":"Go riding Kartküröng."},{"id":"manas-2010:p1008:b001:l008","ordinal":44078,"en":"Lest fire pierce through by mischance,"},{"id":"manas-2010:p1008:b001:l009","ordinal":44079,"en":"Go wearing the silk coat.”"},{"id":"manas-2010:p1008:b001:l010","ordinal":44080,"en":"I shall choose from the horses for you;"},{"id":"manas-2010:p1008:b001:l011","ordinal":44081,"en":"Take my beast Kartküröng."},{"id":"manas-2010:p1008:b001:l012","ordinal":44082,"en":"If your provisions are poor,"},{"id":"manas-2010:p1008:b001:l013","ordinal":44083,"en":"Pour my blood into a leather flask and take it."},{"id":"manas-2010:p1008:b001:l014","ordinal":44084,"en":"Take dawn as your signal to rise."},{"id":"manas-2010:p1008:b001:l015","ordinal":44085,"en":"The twelve Muslim khans,"},{"id":"manas-2010:p1008:b001:l016","ordinal":44086,"en":"The forty valiant-born companions,"},{"id":"manas-2010:p1008:b001:l017","ordinal":44087,"en":"I shall set them passing in review."},{"id":"manas-2010:p1008:b001:l018","ordinal":44088,"en":"Choose a champion for your companion!’"},{"id":"manas-2010:p1008:b001:l019","ordinal":44089,"en":"When he heard these words,"},{"id":"manas-2010:p1008:b001:l020","ordinal":44090,"en":"Like a man struck by a spear,"},{"id":"manas-2010:p1008:b001:l021","ordinal":44091,"en":"Almambet sprang up."},{"id":"manas-2010:p1008:b001:l022","ordinal":44092,"en":"By wearing the silk coat,"},{"id":"manas-2010:p1008:b001:l023","ordinal":44093,"en":"What wish shall I attain?"},{"id":"manas-2010:p1008:b001:l024","ordinal":44094,"en":"To go straight toward Beijing,"},{"id":"manas-2010:p1008:b001:l025","ordinal":44095,"en":"I shall go wearing my bright dagger."},{"id":"manas-2010:p1008:b001:l026","ordinal":44096,"en":"By riding Kartküröng,"},{"id":"manas-2010:p1008:b001:l027","ordinal":44097,"en":"What wish shall I attain?!"},{"id":"manas-2010:p1008:b001:l028","ordinal":44098,"en":"If you command me, “Go!”"},{"id":"manas-2010:p1008:b001:l029","ordinal":44099,"en":"I shall go with Sarala!"},{"id":"manas-2010:p1008:b001:l030","ordinal":44100,"en":"To raid Beijing is my desire."},{"id":"manas-2010:p1008:b001:l031","ordinal":44101,"en":"I shall not part from Sarala."},{"id":"manas-2010:p1008:b001:l032","ordinal":44102,"en":"The reason I shall not part:"},{"id":"manas-2010:p1008:b001:l033","ordinal":44103,"en":"We joined when I was small as a louse;"},{"id":"manas-2010:p1008:b001:l034","ordinal":44104,"en":"Though a beast, he grew up with me."},{"id":"manas-2010:p1008:b001:l035","ordinal":44105,"en":"We came together when I was small as a thumb."},{"id":"manas-2010:p1008:b001:l036","ordinal":44106,"en":"From the beginning, steed Sarala"},{"id":"manas-2010:p1008:b001:l037","ordinal":44107,"en":"Descended from a noble steed,"},{"id":"manas-2010:p1008:b001:l038","ordinal":44108,"en":"Let me tell of his swiftness:"},{"id":"manas-2010:p1008:b001:l039","ordinal":44109,"en":"When I say “Go!” Sarala"},{"id":"manas-2010:p1008:b001:l040","ordinal":44110,"en":"Flies like a bird, changing form."},{"id":"manas-2010:p1008:b001:l041","ordinal":44111,"en":"Though a beast, he is my dear companion."},{"id":"manas-2010:p1008:b001:l042","ordinal":44112,"en":"By God's written decree,"},{"id":"manas-2010:p1009:b001:l001","ordinal":44113,"en":"He was born the same day as I."},{"id":"manas-2010:p1009:b001:l002","ordinal":44114,"en":"Riding Sarala,"},{"id":"manas-2010:p1009:b001:l003","ordinal":44115,"en":"Upon many Manchus and Chinese"},{"id":"manas-2010:p1009:b001:l004","ordinal":44116,"en":"I brought uproar."},{"id":"manas-2010:p1009:b001:l005","ordinal":44117,"en":"I shall not go settle with the governor."},{"id":"manas-2010:p1009:b001:l006","ordinal":44118,"en":"A day of bloodshed will come."},{"id":"manas-2010:p1009:b001:l007","ordinal":44119,"en":"From my trusted companion,"},{"id":"manas-2010:p1009:b001:l008","ordinal":44120,"en":"Sarala, I shall not part."},{"id":"manas-2010:p1009:b001:l009","ordinal":44121,"en":"The plain of It-Ölbös—"},{"id":"manas-2010:p1009:b001:l010","ordinal":44122,"en":"Did he not tread it for me?"},{"id":"manas-2010:p1009:b001:l011","ordinal":44123,"en":"Six thousand Chinese and Manchus,"},{"id":"manas-2010:p1009:b001:l012","ordinal":44124,"en":"Lion-born Almambet—"},{"id":"manas-2010:p1009:b001:l013","ordinal":44125,"en":"Did he not stride over them?"},{"id":"manas-2010:p1009:b001:l014","ordinal":44126,"en":"The steel of the red spear—"},{"id":"manas-2010:p1009:b001:l015","ordinal":44127,"en":"Did he not test its fit?"},{"id":"manas-2010:p1009:b001:l016","ordinal":44128,"en":"Without swallowing a single gulp of water,"},{"id":"manas-2010:p1009:b001:l017","ordinal":44129,"en":"Sarala endured."},{"id":"manas-2010:p1009:b001:l018","ordinal":44130,"en":"My banner beside me,"},{"id":"manas-2010:p1009:b001:l019","ordinal":44131,"en":"From Kakanchyn's Beijing,"},{"id":"manas-2010:p1009:b001:l020","ordinal":44132,"en":"Though a beast, I called him companion,"},{"id":"manas-2010:p1009:b001:l021","ordinal":44133,"en":"My gift that I brought along."},{"id":"manas-2010:p1009:b001:l022","ordinal":44134,"en":"When I scout on this journey,"},{"id":"manas-2010:p1009:b001:l023","ordinal":44135,"en":"If I wield a spear and break their ranks,"},{"id":"manas-2010:p1009:b001:l024","ordinal":44136,"en":"Upon Sarala's back,"},{"id":"manas-2010:p1009:b001:l025","ordinal":44137,"en":"If my death-hour comes, I shall fall to a shot."},{"id":"manas-2010:p1009:b001:l026","ordinal":44138,"en":"If my friend Manas remains in thought,"},{"id":"manas-2010:p1009:b001:l027","ordinal":44139,"en":"With saddle and gear upon him,"},{"id":"manas-2010:p1009:b001:l028","ordinal":44140,"en":"If steed Sarala is left riderless,"},{"id":"manas-2010:p1009:b001:l029","ordinal":44141,"en":"When broad Beijing comes to mind,"},{"id":"manas-2010:p1009:b001:l030","ordinal":44142,"en":"I burn with grief."},{"id":"manas-2010:p1009:b001:l031","ordinal":44143,"en":"From a courser like Sarala,"},{"id":"manas-2010:p1009:b001:l032","ordinal":44144,"en":"“May I never part,” I say,"},{"id":"manas-2010:p1009:b001:l033","ordinal":44145,"en":"Day and night truly wishing it,"},{"id":"manas-2010:p1009:b001:l034","ordinal":44146,"en":"I keep asking God."},{"id":"manas-2010:p1009:b001:l035","ordinal":44147,"en":"When the twelve Muslim armies"},{"id":"manas-2010:p1009:b001:l036","ordinal":44148,"en":"Are set passing in review,"},{"id":"manas-2010:p1009:b001:l037","ordinal":44149,"en":"When I choose a companion,"},{"id":"manas-2010:p1009:b001:l038","ordinal":44150,"en":"What wish shall I attain?"},{"id":"manas-2010:p1009:b001:l039","ordinal":44151,"en":"If you give me a dear companion at my side,"},{"id":"manas-2010:p1009:b001:l040","ordinal":44152,"en":"Give me Syrgak and I shall go."},{"id":"manas-2010:p1009:b001:l041","ordinal":44153,"en":"Its kettles gold, its tea cheap,"},{"id":"manas-2010:p1009:b001:l042","ordinal":44154,"en":"There is no city like Samarkand."},{"id":"manas-2010:p1010:b001:l001","ordinal":44155,"en":"When entering battle against the foe,"},{"id":"manas-2010:p1010:b001:l002","ordinal":44156,"en":"Never drawing back before their numbers,"},{"id":"manas-2010:p1010:b001:l003","ordinal":44157,"en":"Never resting upon an elbow,"},{"id":"manas-2010:p1010:b001:l004","ordinal":44158,"en":"Never taking a brief nap,"},{"id":"manas-2010:p1010:b001:l005","ordinal":44159,"en":"Never drawing back what he has thrust,"},{"id":"manas-2010:p1010:b001:l006","ordinal":44160,"en":"Never fleeing the foe in dejection,"},{"id":"manas-2010:p1010:b001:l007","ordinal":44161,"en":"There is no youth like Syrgak."},{"id":"manas-2010:p1010:b001:l008","ordinal":44162,"en":"“A banner for the standard,” I say;"},{"id":"manas-2010:p1010:b001:l009","ordinal":44163,"en":"For companionship to Deep Beijing,"},{"id":"manas-2010:p1010:b001:l010","ordinal":44164,"en":"Give me your kinsman Syrgak as a gift!"},{"id":"manas-2010:p1010:b001:l011","ordinal":44165,"en":"Let me scout in earnest,"},{"id":"manas-2010:p1010:b001:l012","ordinal":44166,"en":"Let me go to Deep Beijing."},{"id":"manas-2010:p1010:b001:l013","ordinal":44167,"en":"Azhybay's Kartküröng,"},{"id":"manas-2010:p1010:b001:l014","ordinal":44168,"en":"My lion lord, my blood-drinker,"},{"id":"manas-2010:p1010:b001:l015","ordinal":44169,"en":"Give as a spare mount for me to take!’"},{"id":"manas-2010:p1010:b001:l016","ordinal":44170,"en":"Riding Kökchebichin,"},{"id":"manas-2010:p1010:b001:l017","ordinal":44171,"en":"Wearing a blue iron coat,"},{"id":"manas-2010:p1010:b001:l018","ordinal":44172,"en":"The broad belt at his waist"},{"id":"manas-2010:p1010:b001:l019","ordinal":44173,"en":"He grasped, gathering himself."},{"id":"manas-2010:p1010:b001:l020","ordinal":44174,"en":"Like a man going to his wife's kin,"},{"id":"manas-2010:p1010:b001:l021","ordinal":44175,"en":"Smiling openly with joy,"},{"id":"manas-2010:p1010:b001:l022","ordinal":44176,"en":"Fastening his gray pouch-belt,"},{"id":"manas-2010:p1010:b001:l023","ordinal":44177,"en":"Almambet drew aside."},{"id":"manas-2010:p1010:b001:l024","ordinal":44178,"en":"To the falcon he said, ‘Give your blessing!’"},{"id":"manas-2010:p1010:b001:l025","ordinal":44179,"en":"Putting his sash around his neck,"},{"id":"manas-2010:p1010:b001:l026","ordinal":44180,"en":"Asking Manas's blessing,"},{"id":"manas-2010:p1010:b001:l027","ordinal":44181,"en":"He stood looking in supplication."},{"id":"manas-2010:p1010:b001:l028","ordinal":44182,"en":"Khan Koshoi at their head,"},{"id":"manas-2010:p1010:b001:l029","ordinal":44183,"en":"Royal Bakay there too,"},{"id":"manas-2010:p1010:b001:l030","ordinal":44184,"en":"Many others besides,"},{"id":"manas-2010:p1010:b001:l031","ordinal":44185,"en":"The whole great army there,"},{"id":"manas-2010:p1010:b001:l032","ordinal":44186,"en":"They raised their open palms."},{"id":"manas-2010:p1010:b001:l033","ordinal":44187,"en":"Lion Manas murmured,"},{"id":"manas-2010:p1010:b001:l034","ordinal":44188,"en":"Facing toward Mecca:"},{"id":"manas-2010:p1010:b001:l035","ordinal":44189,"en":"‘Golden forelock, tasseled sash,"},{"id":"manas-2010:p1010:b001:l036","ordinal":44190,"en":"Azizkan's only son,"},{"id":"manas-2010:p1010:b001:l037","ordinal":44191,"en":"I have added gold to your banner."},{"id":"manas-2010:p1010:b001:l038","ordinal":44192,"en":"For Beijing where the Holy One would not tread,"},{"id":"manas-2010:p1010:b001:l039","ordinal":44193,"en":"I have given Syrgak as a gift."},{"id":"manas-2010:p1010:b001:l040","ordinal":44194,"en":"When you arrive, may the Chinese road be narrow!"},{"id":"manas-2010:p1010:b001:l041","ordinal":44195,"en":"When you shout and give battle,"},{"id":"manas-2010:p1010:b001:l042","ordinal":44196,"en":"May Holy Ali be beside you!"},{"id":"manas-2010:p1011:b001:l001","ordinal":44197,"en":"May forty hidden saints join you from the heights!"},{"id":"manas-2010:p1011:b001:l002","ordinal":44198,"en":"Riding Duldul, shouting,"},{"id":"manas-2010:p1011:b001:l003","ordinal":44199,"en":"May the Holy Lion be there!"},{"id":"manas-2010:p1011:b001:l004","ordinal":44200,"en":"May God make the outcome good!"},{"id":"manas-2010:p1011:b001:l005","ordinal":44201,"en":"The teeming Chinese, a deep-rooted people,"},{"id":"manas-2010:p1011:b001:l006","ordinal":44202,"en":"May they hear your spirit and give support."},{"id":"manas-2010:p1011:b001:l007","ordinal":44203,"en":"My two blue-maned leopards,"},{"id":"manas-2010:p1011:b001:l008","ordinal":44204,"en":"Among the haughty Chinese,"},{"id":"manas-2010:p1011:b001:l009","ordinal":44205,"en":"May none turn you back!"},{"id":"manas-2010:p1011:b001:l010","ordinal":44206,"en":"Almambet and Syrgak, twin warriors,"},{"id":"manas-2010:p1011:b001:l011","ordinal":44207,"en":"Two lion-born mighty ones,"},{"id":"manas-2010:p1011:b001:l012","ordinal":44208,"en":"You have set out on a distant journey,"},{"id":"manas-2010:p1011:b001:l013","ordinal":44209,"en":"Leopard and tiger champions."},{"id":"manas-2010:p1011:b001:l014","ordinal":44210,"en":"You, Almambet and Syrgak,"},{"id":"manas-2010:p1011:b001:l015","ordinal":44211,"en":"Return safely, wolves!"},{"id":"manas-2010:p1011:b001:l016","ordinal":44212,"en":"The fortress of the Muslims,"},{"id":"manas-2010:p1011:b001:l017","ordinal":44213,"en":"Going out alone, spearing foes,"},{"id":"manas-2010:p1011:b001:l018","ordinal":44214,"en":"If an army that bends the earth comes,"},{"id":"manas-2010:p1011:b001:l019","ordinal":44215,"en":"Without flinching you will spear that army!’"},{"id":"manas-2010:p1011:b001:l020","ordinal":44216,"en":"Crying out blessings,"},{"id":"manas-2010:p1011:b001:l021","ordinal":44217,"en":"All stood and spread their palms."},{"id":"manas-2010:p1011:b001:l022","ordinal":44218,"en":"‘From Beijing of terrible renown,"},{"id":"manas-2010:p1011:b001:l023","ordinal":44219,"en":"Return safely,’ they said,"},{"id":"manas-2010:p1011:b001:l024","ordinal":44220,"en":"Tears streaming from their eyes."},{"id":"manas-2010:p1011:b001:l025","ordinal":44221,"en":"Having received the blessing, the two lions"},{"id":"manas-2010:p1011:b001:l026","ordinal":44222,"en":"Rushed onto the road."},{"id":"manas-2010:p1011:b001:l027","ordinal":44223,"en":"Through lands he had seen,"},{"id":"manas-2010:p1011:b001:l028","ordinal":44224,"en":"Through valleys, springs and deserts,"},{"id":"manas-2010:p1011:b001:l029","ordinal":44225,"en":"Over ridges where no owl flies,"},{"id":"manas-2010:p1011:b001:l030","ordinal":44226,"en":"Along roaring streams,"},{"id":"manas-2010:p1011:b001:l031","ordinal":44227,"en":"They traveled day and night."},{"id":"manas-2010:p1011:b001:l032","ordinal":44228,"en":"Sweeping across all the hills,"},{"id":"manas-2010:p1011:b001:l033","ordinal":44229,"en":"Traveling along Ak-Özön,"},{"id":"manas-2010:p1011:b001:l034","ordinal":44230,"en":"Tal-Mazar along Zongkok,"},{"id":"manas-2010:p1011:b001:l035","ordinal":44231,"en":"They reached Tal-Mazar and camped."},{"id":"manas-2010:p1011:b001:l036","ordinal":44232,"en":"The place where Almambet scouted,"},{"id":"manas-2010:p1011:b001:l037","ordinal":44233,"en":"The place he went out to scout."},{"id":"manas-2010:p1011:b003:l001","ordinal":44234,"en":"Tal-Mazar of broad Zongkok,"},{"id":"manas-2010:p1012:b001:l001","ordinal":44235,"en":"The two warriors Almambet and Syrgak"},{"id":"manas-2010:p1012:b001:l002","ordinal":44236,"en":"Lay down and slept their fill,"},{"id":"manas-2010:p1012:b001:l003","ordinal":44237,"en":"Let their steeds graze on grass."},{"id":"manas-2010:p1012:b001:l004","ordinal":44238,"en":"This was the place where they rested."},{"id":"manas-2010:p1012:b001:l005","ordinal":44239,"en":"Old Kyrgyl, who stayed with the army,"},{"id":"manas-2010:p1012:b001:l006","ordinal":44240,"en":"Had these words to say:"},{"id":"manas-2010:p1012:b001:l007","ordinal":44241,"en":"‘Oh, Khan Akbaltay's Chubak,"},{"id":"manas-2010:p1012:b001:l008","ordinal":44242,"en":"You have ceased to be a man,"},{"id":"manas-2010:p1012:b001:l009","ordinal":44243,"en":"My witless reckless fellow!"},{"id":"manas-2010:p1012:b001:l010","ordinal":44244,"en":"Rather than be Chubak, enter the earth;"},{"id":"manas-2010:p1012:b001:l011","ordinal":44245,"en":"Enter a grave before it is dug!"},{"id":"manas-2010:p1012:b001:l012","ordinal":44246,"en":"Sink straight down without being born;"},{"id":"manas-2010:p1012:b001:l013","ordinal":44247,"en":"Do not stay alive, die!"},{"id":"manas-2010:p1012:b001:l014","ordinal":44248,"en":"Instead of drinking liquor, drink stones!"},{"id":"manas-2010:p1012:b001:l015","ordinal":44249,"en":"If your liquor is too little,"},{"id":"manas-2010:p1012:b001:l016","ordinal":44250,"en":"Drink your father's blood with it!"},{"id":"manas-2010:p1012:b001:l017","ordinal":44251,"en":"Is Almambet to do the scouting?"},{"id":"manas-2010:p1012:b001:l018","ordinal":44252,"en":"Absent from council, absent from talk,"},{"id":"manas-2010:p1012:b001:l019","ordinal":44253,"en":"Will imposing warrior Chubak"},{"id":"manas-2010:p1012:b001:l020","ordinal":44254,"en":"Stay lying in camp?"},{"id":"manas-2010:p1012:b001:l021","ordinal":44255,"en":"From horses raided from the Chinese,"},{"id":"manas-2010:p1012:b001:l022","ordinal":44256,"en":"Will he beg a share of booty?"},{"id":"manas-2010:p1012:b001:l023","ordinal":44257,"en":"Is your Alma to do the scouting?"},{"id":"manas-2010:p1012:b001:l024","ordinal":44258,"en":"Is Khan Baltay's Chubak"},{"id":"manas-2010:p1012:b001:l025","ordinal":44259,"en":"To stay lying with the baggage train?"},{"id":"manas-2010:p1012:b001:l026","ordinal":44260,"en":"Earlier, in the hollow of Zhylgyndy,"},{"id":"manas-2010:p1012:b001:l027","ordinal":44261,"en":"Along broad Talas,"},{"id":"manas-2010:p1012:b001:l028","ordinal":44262,"en":"You sliced and ate rump-meat."},{"id":"manas-2010:p1012:b001:l029","ordinal":44263,"en":"When you were full of liquor,"},{"id":"manas-2010:p1012:b001:l030","ordinal":44264,"en":"My empty-chested fool,"},{"id":"manas-2010:p1012:b001:l031","ordinal":44265,"en":"You said you would wreck the world!’"},{"id":"manas-2010:p1012:b001:l032","ordinal":44266,"en":"When Chubak heard this,"},{"id":"manas-2010:p1012:b001:l033","ordinal":44267,"en":"Fire flashed from his eyes,"},{"id":"manas-2010:p1012:b001:l034","ordinal":44268,"en":"Flame came from his mouth,"},{"id":"manas-2010:p1012:b001:l035","ordinal":44269,"en":"His eyes shone like a lion's."},{"id":"manas-2010:p1012:b001:l036","ordinal":44270,"en":"His bright teeth, broad as shovels,"},{"id":"manas-2010:p1012:b001:l037","ordinal":44271,"en":"He ground until they cracked."},{"id":"manas-2010:p1012:b001:l038","ordinal":44272,"en":"Seeing Chubak's anger,"},{"id":"manas-2010:p1012:b001:l039","ordinal":44273,"en":"His companions stirred in alarm."},{"id":"manas-2010:p1012:b001:l040","ordinal":44274,"en":"‘Be patient,’ the great army said;"},{"id":"manas-2010:p1012:b001:l041","ordinal":44275,"en":"Chubak would not heed their words."},{"id":"manas-2010:p1012:b001:l042","ordinal":44276,"en":"A battle-axe with golden cheeks,"},{"id":"manas-2010:p1013:b001:l001","ordinal":44277,"en":"His blue-maned lion Chubak"},{"id":"manas-2010:p1013:b001:l002","ordinal":44278,"en":"Now slung upon his wrist."},{"id":"manas-2010:p1013:b001:l003","ordinal":44279,"en":"The specially forged diamond-steel blade"},{"id":"manas-2010:p1013:b001:l004","ordinal":44280,"en":"He girded tightly at his waist,"},{"id":"manas-2010:p1013:b001:l005","ordinal":44281,"en":"Readied all his equipment."},{"id":"manas-2010:p1013:b001:l006","ordinal":44282,"en":"The mount beneath him"},{"id":"manas-2010:p1013:b001:l007","ordinal":44283,"en":"Was the outstanding steed Kögala."},{"id":"manas-2010:p1013:b001:l008","ordinal":44284,"en":"Akbaltay's Chubak,"},{"id":"manas-2010:p1013:b001:l009","ordinal":44285,"en":"No man's strength could match him in wrestling,"},{"id":"manas-2010:p1013:b001:l010","ordinal":44286,"en":"No lion's tooth could pierce him."},{"id":"manas-2010:p1013:b001:l011","ordinal":44287,"en":"Keng-Kol is no broader than Talas;"},{"id":"manas-2010:p1013:b001:l012","ordinal":44288,"en":"If you ask about heroism,"}]
