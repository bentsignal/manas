[{"id":"semetey-1-2013:p0844:b003:l013","ordinal":140801,"en":"When they reached Oluya-Ata,"},{"id":"semetey-1-2013:p0844:b003:l014","ordinal":140802,"en":"The dark hill leaning backward"},{"id":"semetey-1-2013:p0844:b003:l015","ordinal":140803,"en":"Was the pass called Jorgo."},{"id":"semetey-1-2013:p0844:b003:l016","ordinal":140804,"en":"Your mother, grown familiar with it,"},{"id":"semetey-1-2013:p0844:b003:l017","ordinal":140805,"en":"Had crossed that place."},{"id":"semetey-1-2013:p0844:b003:l018","ordinal":140806,"en":"They crossed Jorgo Pass;"},{"id":"semetey-1-2013:p0844:b003:l019","ordinal":140807,"en":"The land they met was great Talas."},{"id":"semetey-1-2013:p0844:b003:l020","ordinal":140808,"en":"Hill after hill stood separate;"},{"id":"semetey-1-2013:p0844:b003:l021","ordinal":140809,"en":"The hilly mountain pass appeared."},{"id":"semetey-1-2013:p0844:b003:l022","ordinal":140810,"en":"The grass of the pass was sparse;"},{"id":"semetey-1-2013:p0844:b003:l023","ordinal":140811,"en":"Wild sheep poured down like sand."},{"id":"semetey-1-2013:p0844:b003:l025","ordinal":140812,"en":"The grass on the hillocks was sparse;","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0844:b003:l026","ordinal":140813,"en":"Deer poured down like sand."},{"id":"semetey-1-2013:p0844:b003:l027","ordinal":140814,"en":"Wild asses raced across the plain;"},{"id":"semetey-1-2013:p0844:b003:l028","ordinal":140815,"en":"Nightingales sang in the willows;"},{"id":"semetey-1-2013:p0844:b003:l029","ordinal":140816,"en":"Frogs croaked in the water;"},{"id":"semetey-1-2013:p0844:b003:l030","ordinal":140817,"en":"Cuckoos called from the mountains;"},{"id":"semetey-1-2013:p0844:b003:l031","ordinal":140818,"en":"Parrots spoke from the plane trees."},{"id":"semetey-1-2013:p0844:b003:l032","ordinal":140819,"en":"Looking closely at this Talas,"},{"id":"semetey-1-2013:p0844:b003:l034","ordinal":140820,"en":"Left deserted for twelve years,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0844:b003:l035","ordinal":140821,"en":"The land’s wild game was beyond counting,"},{"id":"semetey-1-2013:p0844:b003:l036","ordinal":140822,"en":"Its leaves varied in color;"},{"id":"semetey-1-2013:p0844:b003:l037","ordinal":140823,"en":"Roe deer barked from within."},{"id":"semetey-1-2013:p0844:b003:l038","ordinal":140824,"en":"Since the land had grown lush,"},{"id":"semetey-1-2013:p0844:b003:l039","ordinal":140825,"en":"Wild game had come to possess it."},{"id":"semetey-1-2013:p0844:b004:l001","ordinal":140826,"en":"The young of stags and hinds"},{"id":"semetey-1-2013:p0844:b004:l002","ordinal":140827,"en":"Chased one another."},{"id":"semetey-1-2013:p0844:b004:l003","ordinal":140828,"en":"There was no land astir with life,"},{"id":"semetey-1-2013:p0844:b004:l004","ordinal":140829,"en":"No people surging about,"},{"id":"semetey-1-2013:p0844:b004:l005","ordinal":140830,"en":"Not a crow to give a caw."},{"id":"semetey-1-2013:p0844:b004:l006","ordinal":140831,"en":"Talas lay deserted;"},{"id":"semetey-1-2013:p0844:b004:l007","ordinal":140832,"en":"Not a raven croaking there."},{"id":"semetey-1-2013:p0844:b004:l008","ordinal":140833,"en":"When she saw the deserted land,"},{"id":"semetey-1-2013:p0844:b004:l009","ordinal":140834,"en":"The yellow, hilly outline—"},{"id":"semetey-1-2013:p0844:b004:l010","ordinal":140835,"en":"Seeing the ridge, she wept;"},{"id":"semetey-1-2013:p0844:b004:l011","ordinal":140836,"en":"Broad Talas spread before her—"},{"id":"semetey-1-2013:p0844:b004:l012","ordinal":140837,"en":"Seeing the land, she wept."},{"id":"semetey-1-2013:p0844:b004:l013","ordinal":140838,"en":"Of Kara-Buura’s high grassy slopes,"},{"id":"semetey-1-2013:p0844:b004:l014","ordinal":140839,"en":"Seeing its secluded hollows, she wept."},{"id":"semetey-1-2013:p0844:b004:l015","ordinal":140840,"en":"The familiar Keng-Kol and Talas—"},{"id":"semetey-1-2013:p0844:b004:l016","ordinal":140841,"en":"Seeing their ravines, she wept."},{"id":"semetey-1-2013:p0844:b004:l017","ordinal":140842,"en":"Where they caught foals and tethered mares,"},{"id":"semetey-1-2013:p0844:b004:l018","ordinal":140843,"en":"When she saw the place where they had stayed,"},{"id":"semetey-1-2013:p0844:b004:l019","ordinal":140844,"en":"Slaughtering colts suckled by barren mares,"},{"id":"semetey-1-2013:p0844:b004:l020","ordinal":140845,"en":"When she saw the place where they had lived,"},{"id":"semetey-1-2013:p0844:b004:l021","ordinal":140846,"en":"Then your mother Kanykei—"},{"id":"semetey-1-2013:p0844:b004:l022","ordinal":140847,"en":"From her precious eyes, like a quail’s,"},{"id":"semetey-1-2013:p0844:b004:l023","ordinal":140848,"en":"Tears flowed in separate streams."},{"id":"semetey-1-2013:p0844:b004:l024","ordinal":140849,"en":"From her precious eyes, like black currants,"},{"id":"semetey-1-2013:p0844:b004:l025","ordinal":140850,"en":"Tears streamed a whip’s length."},{"id":"semetey-1-2013:p0844:b004:l026","ordinal":140851,"en":"Naming her places, she cried aloud;"},{"id":"semetey-1-2013:p0844:b004:l027","ordinal":140852,"en":"Your mother wept and sobbed."},{"id":"semetey-1-2013:p0844:b004:l029","ordinal":140853,"en":"Breathless in the green valley,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0844:b004:l030","ordinal":140854,"en":"They had been encamped."},{"id":"semetey-1-2013:p0844:b004:l031","ordinal":140855,"en":"When your father lived in happiness,"},{"id":"semetey-1-2013:p0844:b004:l032","ordinal":140856,"en":"When their happiness was intact,"},{"id":"semetey-1-2013:p0844:b004:l033","ordinal":140857,"en":"When they received whatever they wished,"},{"id":"semetey-1-2013:p0844:b004:l034","ordinal":140858,"en":"Cutting strips of otter skin,"},{"id":"semetey-1-2013:p0844:b004:l035","ordinal":140859,"en":"When they trimmed their trouser cuffs,"},{"id":"semetey-1-2013:p0844:b004:l036","ordinal":140860,"en":"The many Argyn and Kyrgyz people"},{"id":"semetey-1-2013:p0844:b004:l037","ordinal":140861,"en":"Were encamped there."},{"id":"semetey-1-2013:p0844:b004:l038","ordinal":140862,"en":"Laughter by day, play by night—"},{"id":"semetey-1-2013:p0844:b004:l039","ordinal":140863,"en":"Such were those days."},{"id":"semetey-1-2013:p0845:b003:l001","ordinal":140864,"en":"A dear land of unequaled happiness,"},{"id":"semetey-1-2013:p0845:b003:l002","ordinal":140865,"en":"Our people utterly vanished."},{"id":"semetey-1-2013:p0845:b003:l004","ordinal":140866,"en":"On that rugged promontory,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0845:b003:l005","ordinal":140867,"en":"Your leopard elder Bakai’s"},{"id":"semetey-1-2013:p0845:b003:l006","ordinal":140868,"en":"Moinok-Tash, where he stood watch—"},{"id":"semetey-1-2013:p0845:b003:l007","ordinal":140869,"en":"If you looked toward its steep bank,"},{"id":"semetey-1-2013:p0845:b003:l008","ordinal":140870,"en":"Argyn and Kyrgyz mingled there."},{"id":"semetey-1-2013:p0845:b003:l009","ordinal":140871,"en":"This very day in Talas,"},{"id":"semetey-1-2013:p0845:b003:l010","ordinal":140872,"en":"Not a Kyrgyz, not even a stump remains;"},{"id":"semetey-1-2013:p0845:b003:l011","ordinal":140873,"en":"My heart boils like embers!"},{"id":"semetey-1-2013:p0845:b003:l012","ordinal":140874,"en":"That gray round hill, that little pass—"},{"id":"semetey-1-2013:p0845:b003:l013","ordinal":140875,"en":"Your father with his forty warriors"},{"id":"semetey-1-2013:p0845:b003:l014","ordinal":140876,"en":"Gathered there."},{"id":"semetey-1-2013:p0845:b003:l015","ordinal":140877,"en":"Drawing a line forty foot-lengths around,"},{"id":"semetey-1-2013:p0845:b003:l016","ordinal":140878,"en":"They played merry ordo there."},{"id":"semetey-1-2013:p0845:b003:l017","ordinal":140879,"en":"Forty fat mares"},{"id":"semetey-1-2013:p0845:b003:l018","ordinal":140880,"en":"They tethered in the middle;"},{"id":"semetey-1-2013:p0845:b003:l019","ordinal":140881,"en":"The winners slaughtered them there."},{"id":"semetey-1-2013:p0845:b003:l020","ordinal":140882,"en":"Trampled bare, with nothing left,"},{"id":"semetey-1-2013:p0845:b003:l021","ordinal":140883,"en":"This place now lies deserted."},{"id":"semetey-1-2013:p0845:b003:l022","ordinal":140884,"en":"Argyn and Kyrgyz mingled,"},{"id":"semetey-1-2013:p0845:b003:l023","ordinal":140885,"en":"Maintaining a court, ruling the people—"},{"id":"semetey-1-2013:p0845:b003:l024","ordinal":140886,"en":"So we used to live, dear souls."},{"id":"semetey-1-2013:p0845:b003:l025","ordinal":140887,"en":"Along this Talas,"},{"id":"semetey-1-2013:p0845:b003:l026","ordinal":140888,"en":"What is there, and what is gone?"},{"id":"semetey-1-2013:p0845:b003:l027","ordinal":140889,"en":"Seeing the empty land without its people,"},{"id":"semetey-1-2013:p0845:b003:l028","ordinal":140890,"en":"My heart grieves, my breast burns."},{"id":"semetey-1-2013:p0845:b003:l029","ordinal":140891,"en":"The vain world rose before my eyes."},{"id":"semetey-1-2013:p0845:b003:l030","ordinal":140892,"en":"Your mother has seen much;"},{"id":"semetey-1-2013:p0845:b003:l031","ordinal":140893,"en":"I, wretched one, have no regrets."},{"id":"semetey-1-2013:p0845:b003:l032","ordinal":140894,"en":"When those people dwelt here,"},{"id":"semetey-1-2013:p0845:b003:l033","ordinal":140895,"en":"Old women chewed fat tails;"},{"id":"semetey-1-2013:p0845:b003:l034","ordinal":140896,"en":"Poor men drove a thousand sheep."},{"id":"semetey-1-2013:p0845:b003:l035","ordinal":140897,"en":"Not a young bride lacked happiness."},{"id":"semetey-1-2013:p0845:b003:l036","ordinal":140898,"en":"Not dying with that happiness,"},{"id":"semetey-1-2013:p0845:b003:l037","ordinal":140899,"en":"Your mother’s misery boiled over."},{"id":"semetey-1-2013:p0845:b003:l038","ordinal":140900,"en":"Within my breast, my foal,"},{"id":"semetey-1-2013:p0845:b003:l039","ordinal":140901,"en":"There is a wound that will not heal."},{"id":"semetey-1-2013:p0845:b004:l001","ordinal":140902,"en":"If I go on telling, my foal,"},{"id":"semetey-1-2013:p0845:b004:l002","ordinal":140903,"en":"There are many, many wonders."},{"id":"semetey-1-2013:p0845:b004:l003","ordinal":140904,"en":"My brow bone was curved;"},{"id":"semetey-1-2013:p0845:b004:l004","ordinal":140905,"en":"When your father died,"},{"id":"semetey-1-2013:p0845:b004:l005","ordinal":140906,"en":"My livelihood proved scant."},{"id":"semetey-1-2013:p0845:b004:l006","ordinal":140907,"en":"The hair upon my brow was grass;"},{"id":"semetey-1-2013:p0845:b004:l007","ordinal":140908,"en":"Beyond my good fortune, my suffering,"},{"id":"semetey-1-2013:p0845:b004:l008","ordinal":140909,"en":"After your leopard father died,"},{"id":"semetey-1-2013:p0845:b004:l009","ordinal":140910,"en":"Was greater by a spear’s length."},{"id":"semetey-1-2013:p0845:b004:l010","ordinal":140911,"en":"In Kara-Buura and Chatkal,"},{"id":"semetey-1-2013:p0845:b004:l011","ordinal":140912,"en":"When many people lay at ease,"},{"id":"semetey-1-2013:p0845:b004:l012","ordinal":140913,"en":"When my abundance was intact,"},{"id":"semetey-1-2013:p0845:b004:l014","ordinal":140914,"en":"Not mending the companions’ torn clothes,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0845:b004:l015","ordinal":140915,"en":"Having no regard for God,"},{"id":"semetey-1-2013:p0845:b004:l017","ordinal":140916,"en":"Never eating food left overnight,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0845:b004:l018","ordinal":140917,"en":"That wretched woman who thought herself grand—"},{"id":"semetey-1-2013:p0845:b004:l019","ordinal":140918,"en":"Her arrogance fell upon her own head."},{"id":"semetey-1-2013:p0845:b004:l020","ordinal":140919,"en":"She lost her bloodthirsty hero"},{"id":"semetey-1-2013:p0845:b004:l021","ordinal":140920,"en":"At thirty-two years of age."},{"id":"semetey-1-2013:p0845:b004:l022","ordinal":140921,"en":"Below, the steep bank and broad valley—"},{"id":"semetey-1-2013:p0845:b004:l023","ordinal":140922,"en":"That is the place called Keng-Shor."},{"id":"semetey-1-2013:p0845:b004:l024","ordinal":140923,"en":"Along this very Keng-Shor,"},{"id":"semetey-1-2013:p0845:b004:l025","ordinal":140924,"en":"I was the one who consumed your father Manas!"},{"id":"semetey-1-2013:p0845:b004:l026","ordinal":140925,"en":"When the debt fell due,"},{"id":"semetey-1-2013:p0845:b004:l027","ordinal":140926,"en":"When death lay in wait,"},{"id":"semetey-1-2013:p0845:b004:l028","ordinal":140927,"en":"His eyes barely open, their gaze wandering,"},{"id":"semetey-1-2013:p0845:b004:l029","ordinal":140928,"en":"His fine mustache lying smooth,"},{"id":"semetey-1-2013:p0845:b004:l030","ordinal":140929,"en":"When your father went to Judgment,"},{"id":"semetey-1-2013:p0845:b004:l031","ordinal":140930,"en":"My black hair untouched by a comb,"},{"id":"semetey-1-2013:p0845:b004:l032","ordinal":140931,"en":"Here in Keng-Shor itself,"},{"id":"semetey-1-2013:p0845:b004:l033","ordinal":140932,"en":"I seized and tore out strand by strand!"},{"id":"semetey-1-2013:p0845:b004:l034","ordinal":140933,"en":"Where the strands of my hair fell,"},{"id":"semetey-1-2013:p0845:b004:l035","ordinal":140934,"en":"Willows grew, a forest of willows."},{"id":"semetey-1-2013:p0845:b004:l036","ordinal":140935,"en":"The dark tears flowing from my eyes,"},{"id":"semetey-1-2013:p0845:b004:l037","ordinal":140936,"en":"Here in Keng-Shor to this day,"},{"id":"semetey-1-2013:p0845:b004:l038","ordinal":140937,"en":"Became pools of dark water."},{"id":"semetey-1-2013:p0845:b004:l039","ordinal":140938,"en":"My fierce hero had been a banner for the people."},{"id":"semetey-1-2013:p0846:b003:l001","ordinal":140939,"en":"The dark blood flowing from my face,"},{"id":"semetey-1-2013:p0846:b003:l002","ordinal":140940,"en":"Here in Keng-Shor to this day,"},{"id":"semetey-1-2013:p0846:b003:l003","ordinal":140941,"en":"Became red stone a horse’s shin high,"},{"id":"semetey-1-2013:p0846:b003:l004","ordinal":140942,"en":"Your father had been the people’s leader."},{"id":"semetey-1-2013:p0846:b003:l005","ordinal":140943,"en":"‘If I bury your father openly,"},{"id":"semetey-1-2013:p0846:b003:l006","ordinal":140944,"en":"Of those stubborn foes who fought him,"},{"id":"semetey-1-2013:p0846:b003:l007","ordinal":140945,"en":"One will dig him up,"},{"id":"semetey-1-2013:p0846:b003:l008","ordinal":140946,"en":"And give him to dogs to tear apart,’ I thought."},{"id":"semetey-1-2013:p0846:b003:l009","ordinal":140947,"en":"Without showing a single person,"},{"id":"semetey-1-2013:p0846:b003:l010","ordinal":140948,"en":"Without letting a single person know,"},{"id":"semetey-1-2013:p0846:b003:l011","ordinal":140949,"en":"I contrived an extraordinary spectacle."},{"id":"semetey-1-2013:p0846:b003:l012","ordinal":140950,"en":"I startled those who saw it."},{"id":"semetey-1-2013:p0846:b003:l013","ordinal":140951,"en":"Your father’s funeral prayer"},{"id":"semetey-1-2013:p0846:b003:l014","ordinal":140952,"en":"I had recited without showing him to the people."},{"id":"semetey-1-2013:p0846:b003:l015","ordinal":140953,"en":"Koshoi and Töshtük saw him;"},{"id":"semetey-1-2013:p0846:b003:l016","ordinal":140954,"en":"Alas, Khan Bakai saw him."},{"id":"semetey-1-2013:p0846:b003:l018","ordinal":140955,"en":"At the place where your father was washed,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0846:b003:l019","ordinal":140956,"en":"Plane trees grew like an enclosure;"},{"id":"semetey-1-2013:p0846:b003:l020","ordinal":140957,"en":"The holy khojas gave their aid."},{"id":"semetey-1-2013:p0846:b003:l021","ordinal":140958,"en":"Where he was taken for the funeral prayer,"},{"id":"semetey-1-2013:p0846:b003:l022","ordinal":140959,"en":"Abundant plane trees grew;"},{"id":"semetey-1-2013:p0846:b003:l023","ordinal":140960,"en":"The Creator Himself gave His aid."},{"id":"semetey-1-2013:p0846:b003:l024","ordinal":140961,"en":"Twisting their mustaches,"},{"id":"semetey-1-2013:p0846:b003:l025","ordinal":140962,"en":"The Mustafas gave their aid."},{"id":"semetey-1-2013:p0846:b003:l026","ordinal":140963,"en":"Twisting their beards,"},{"id":"semetey-1-2013:p0846:b003:l027","ordinal":140964,"en":"The Mustafas gave their aid."},{"id":"semetey-1-2013:p0846:b003:l028","ordinal":140965,"en":"Your father was a lion for the people."},{"id":"semetey-1-2013:p0846:b003:l029","ordinal":140966,"en":"A fierce hero like him,"},{"id":"semetey-1-2013:p0846:b003:l030","ordinal":140967,"en":"Created and brought into being,"},{"id":"semetey-1-2013:p0846:b003:l031","ordinal":140968,"en":"Will not be given again soon."},{"id":"semetey-1-2013:p0846:b003:l032","ordinal":140969,"en":"Forty champions who came from Arabia,"},{"id":"semetey-1-2013:p0846:b003:l033","ordinal":140970,"en":"Whose speech could not be understood—"},{"id":"semetey-1-2013:p0846:b003:l034","ordinal":140971,"en":"I set them to that extraordinary task;"},{"id":"semetey-1-2013:p0846:b003:l035","ordinal":140972,"en":"I had them lift and carry him."},{"id":"semetey-1-2013:p0846:b003:l036","ordinal":140973,"en":"Kökbörü and Töshtük were there;"},{"id":"semetey-1-2013:p0846:b003:l037","ordinal":140974,"en":"Khan Bakai and Koshoi were there too."},{"id":"semetey-1-2013:p0846:b003:l038","ordinal":140975,"en":"Reciting the funeral prayer and profession of faith,"},{"id":"semetey-1-2013:p0846:b003:l039","ordinal":140976,"en":"Where they carried him onward,"},{"id":"semetey-1-2013:p0846:b004:l001","ordinal":140977,"en":"Red willows grew in a ridge;"},{"id":"semetey-1-2013:p0846:b004:l002","ordinal":140978,"en":"The Creator Himself became their helper."},{"id":"semetey-1-2013:p0846:b004:l003","ordinal":140979,"en":"The holy khojas joined together;"},{"id":"semetey-1-2013:p0846:b004:l004","ordinal":140980,"en":"Where they escorted him in a circle,"},{"id":"semetey-1-2013:p0846:b004:l005","ordinal":140981,"en":"Until they brought him to his resting place,"},{"id":"semetey-1-2013:p0846:b004:l006","ordinal":140982,"en":"Abundant red willows grew;"},{"id":"semetey-1-2013:p0846:b004:l007","ordinal":140983,"en":"The Creator Himself became their helper."},{"id":"semetey-1-2013:p0846:b004:l008","ordinal":140984,"en":"This is the place called Keng-Shor;"},{"id":"semetey-1-2013:p0846:b004:l009","ordinal":140985,"en":"I am the one who consumed your father!”"},{"id":"semetey-1-2013:p0846:b004:l010","ordinal":140986,"en":"They properly saddled the horses;"},{"id":"semetey-1-2013:p0846:b004:l011","ordinal":140987,"en":"The saintly heroes"},{"id":"semetey-1-2013:p0846:b004:l012","ordinal":140988,"en":"Recited the Koran for him."},{"id":"semetey-1-2013:p0846:b004:l013","ordinal":140989,"en":"The past came into her mind;"},{"id":"semetey-1-2013:p0846:b004:l014","ordinal":140990,"en":"Kanykei wept in desolation."},{"id":"semetey-1-2013:p0846:b004:l015","ordinal":140991,"en":"Allah’s sun in heaven clouded over;"},{"id":"semetey-1-2013:p0846:b004:l016","ordinal":140992,"en":"Sixty worries fell upon her together!"},{"id":"semetey-1-2013:p0846:b004:l017","ordinal":140993,"en":"The place where she had lived appeared;"},{"id":"semetey-1-2013:p0846:b004:l018","ordinal":140994,"en":"Tears poured from her eyes."},{"id":"semetey-1-2013:p0846:b004:l019","ordinal":140995,"en":"Fierce, leopard Manas"},{"id":"semetey-1-2013:p0846:b004:l020","ordinal":140996,"en":"Seemed to have only just died!"},{"id":"semetey-1-2013:p0846:b004:l021","ordinal":140997,"en":"Below Tört-Kül,"},{"id":"semetey-1-2013:p0846:b004:l022","ordinal":140998,"en":"To the garden planted by Lord Manas,"},{"id":"semetey-1-2013:p0846:b004:l023","ordinal":140999,"en":"Kanykei now came,"},{"id":"semetey-1-2013:p0846:b004:l024","ordinal":141000,"en":"And stopped once more."},{"id":"semetey-1-2013:p0846:b004:l025","ordinal":141001,"en":"“See that great mound there—"},{"id":"semetey-1-2013:p0846:b004:l026","ordinal":141002,"en":"Your father’s great mosque."},{"id":"semetey-1-2013:p0846:b004:l027","ordinal":141003,"en":"They felled all its willows,"},{"id":"semetey-1-2013:p0846:b004:l028","ordinal":141004,"en":"Demolished all its walls,"},{"id":"semetey-1-2013:p0846:b004:l029","ordinal":141005,"en":"Pulled out its pillars."},{"id":"semetey-1-2013:p0846:b004:l030","ordinal":141006,"en":"Waging war upon a mosque,"},{"id":"semetey-1-2013:p0846:b004:l033","ordinal":141007,"en":"When your father was alive,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0846:b004:l034","ordinal":141008,"en":"This great mosque standing here—"},{"id":"semetey-1-2013:p0846:b004:l035","ordinal":141009,"en":"Within the great mosque,"},{"id":"semetey-1-2013:p0846:b004:l036","ordinal":141010,"en":"There were lords and khans,"},{"id":"semetey-1-2013:p0846:b004:l037","ordinal":141011,"en":"And many exemplary men."},{"id":"semetey-1-2013:p0846:b004:l038","ordinal":141012,"en":"Within that mosque,"},{"id":"semetey-1-2013:p0846:b004:l039","ordinal":141013,"en":"Lords had stood, khans had stood."},{"id":"semetey-1-2013:p0847:b003:l001","ordinal":141014,"en":"Abyke, Kobosh, the six scoundrels—"},{"id":"semetey-1-2013:p0847:b003:l002","ordinal":141015,"en":"These were the scoundrels' deeds:"},{"id":"semetey-1-2013:p0847:b003:l003","ordinal":141016,"en":"They cast down all the thrones;"},{"id":"semetey-1-2013:p0847:b003:l004","ordinal":141017,"en":"They demolished all the buildings."},{"id":"semetey-1-2013:p0847:b003:l005","ordinal":141018,"en":"They pulled out the pillars;"},{"id":"semetey-1-2013:p0847:b003:l006","ordinal":141019,"en":"The great mosque was destroyed"},{"id":"semetey-1-2013:p0847:b003:l007","ordinal":141020,"en":"And left level with the ground."},{"id":"semetey-1-2013:p0847:b003:l008","ordinal":141021,"en":"Its hollows filled up;"},{"id":"semetey-1-2013:p0847:b003:l009","ordinal":141022,"en":"It became the mound of Tort-Kulcho."},{"id":"semetey-1-2013:p0847:b003:l010","ordinal":141023,"en":"My warrior lord, may you not die;"},{"id":"semetey-1-2013:p0847:b003:l011","ordinal":141024,"en":"May your poor soul never see such torment!”"},{"id":"semetey-1-2013:p0847:b003:l012","ordinal":141025,"en":"Seeing her land, she grew distraught;"},{"id":"semetey-1-2013:p0847:b003:l013","ordinal":141026,"en":"Your mother wept in anguish."},{"id":"semetey-1-2013:p0847:b003:l014","ordinal":141027,"en":"Blood ran from her black eyes;"},{"id":"semetey-1-2013:p0847:b003:l015","ordinal":141028,"en":"How bitterly she sobbed!"},{"id":"semetey-1-2013:p0847:b003:l016","ordinal":141029,"en":"Those who stood watching"},{"id":"semetey-1-2013:p0847:b003:l017","ordinal":141030,"en":"Had their hearts grievously stirred."},{"id":"semetey-1-2013:p0847:b003:l018","ordinal":141031,"en":"Your mother wept and shook;"},{"id":"semetey-1-2013:p0847:b003:l019","ordinal":141032,"en":"What could poor Chiyirdi do?"},{"id":"semetey-1-2013:p0847:b003:l020","ordinal":141033,"en":"Like a twig put in water,"},{"id":"semetey-1-2013:p0847:b003:l021","ordinal":141034,"en":"She swayed, wailing and weeping."},{"id":"semetey-1-2013:p0847:b003:l022","ordinal":141035,"en":"“My orphan, whom I cherish,"},{"id":"semetey-1-2013:p0847:b003:l023","ordinal":141036,"en":"If I tell you of the old days,"},{"id":"semetey-1-2013:p0847:b003:l024","ordinal":141037,"en":"You will think I am boasting."},{"id":"semetey-1-2013:p0847:b003:l025","ordinal":141038,"en":"Sixty thousand horses in the hills,"},{"id":"semetey-1-2013:p0847:b003:l026","ordinal":141039,"en":"Fine steeds and coursers mingled."},{"id":"semetey-1-2013:p0847:b003:l027","ordinal":141040,"en":"What power have I against God?"},{"id":"semetey-1-2013:p0847:b003:l028","ordinal":141041,"en":"My support behind me, my son, was young."},{"id":"semetey-1-2013:p0847:b003:l029","ordinal":141042,"en":"Bereft of composure and support,"},{"id":"semetey-1-2013:p0847:b003:l030","ordinal":141043,"en":"Our poor heads were troubled."},{"id":"semetey-1-2013:p0847:b003:l031","ordinal":141044,"en":"Then all our elder and younger kinsmen were foes!"},{"id":"semetey-1-2013:p0847:b003:l032","ordinal":141045,"en":"From wounded honor I wished to die,"},{"id":"semetey-1-2013:p0847:b003:l033","ordinal":141046,"en":"Yet I remained alive and did not die,"},{"id":"semetey-1-2013:p0847:b003:l034","ordinal":141047,"en":"My dear child, because you were there."},{"id":"semetey-1-2013:p0847:b003:l035","ordinal":141048,"en":"From wounded honor I wished to depart,"},{"id":"semetey-1-2013:p0847:b003:l036","ordinal":141049,"en":"Yet I did not depart then,"},{"id":"semetey-1-2013:p0847:b003:l037","ordinal":141050,"en":"Because my needed orphan was there!"},{"id":"semetey-1-2013:p0847:b003:l038","ordinal":141051,"en":"If I died of anguish,"},{"id":"semetey-1-2013:p0847:b003:l039","ordinal":141052,"en":"My cherished orphan"},{"id":"semetey-1-2013:p0847:b004:l001","ordinal":141053,"en":"Would be like an extinguished fire, I thought."},{"id":"semetey-1-2013:p0847:b004:l002","ordinal":141054,"en":"So I spared my life;"},{"id":"semetey-1-2013:p0847:b004:l003","ordinal":141055,"en":"I did not spill my blood."},{"id":"semetey-1-2013:p0847:b004:l004","ordinal":141056,"en":"Here along the Talas,"}]
