[{"id":"manas-2010:p1629:b001:l017","ordinal":70145,"en":"Their saddles slipped to their horses' necks,"},{"id":"manas-2010:p1629:b001:l018","ordinal":70146,"en":"“Now we are being slaughtered!”"},{"id":"manas-2010:p1629:b001:l019","ordinal":70147,"en":"Many more fled crying."},{"id":"manas-2010:p1629:b001:l020","ordinal":70148,"en":"Many mules and steeds,"},{"id":"manas-2010:p1629:b001:l021","ordinal":70149,"en":"Their saddles and cloths beneath their bellies,"},{"id":"manas-2010:p1629:b001:l022","ordinal":70150,"en":"Many more went leaping about."},{"id":"manas-2010:p1629:b001:l023","ordinal":70151,"en":"“My precious dear brother,"},{"id":"manas-2010:p1629:b001:l024","ordinal":70152,"en":"Where shall I see you now?”"},{"id":"manas-2010:p1629:b001:l025","ordinal":70153,"en":"Many more went weeping."},{"id":"manas-2010:p1629:b001:l026","ordinal":70154,"en":"All the brave warriors"},{"id":"manas-2010:p1629:b001:l027","ordinal":70155,"en":"Spread out along the edges;"},{"id":"manas-2010:p1629:b001:l028","ordinal":70156,"en":"All the worthless ones,"},{"id":"manas-2010:p1629:b001:l029","ordinal":70157,"en":"Untaken by God, milling about,"},{"id":"manas-2010:p1629:b001:l030","ordinal":70158,"en":"Were hemmed in at the middle."},{"id":"manas-2010:p1629:b001:l031","ordinal":70159,"en":"Giving strength to the whip,"},{"id":"manas-2010:p1629:b001:l032","ordinal":70160,"en":"All the leopards"},{"id":"manas-2010:p1629:b001:l033","ordinal":70161,"en":"Separated along the edges."},{"id":"manas-2010:p1629:b001:l034","ordinal":70162,"en":"In the great clash of battle,"},{"id":"manas-2010:p1629:b001:l035","ordinal":70163,"en":"Human blood was shed."},{"id":"manas-2010:p1629:b001:l036","ordinal":70164,"en":"See the dust of flying earth,"},{"id":"manas-2010:p1629:b001:l037","ordinal":70165,"en":"See the blood flowing away,"},{"id":"manas-2010:p1629:b001:l038","ordinal":70166,"en":"Hunched among the blood,"},{"id":"manas-2010:p1629:b001:l039","ordinal":70167,"en":"See the souls lying dead!"},{"id":"manas-2010:p1629:b001:l040","ordinal":70168,"en":"The sun flickered, hidden from view."},{"id":"manas-2010:p1629:b001:l041","ordinal":70169,"en":"The sun's face was shrouded in dust,"},{"id":"manas-2010:p1629:b001:l042","ordinal":70170,"en":"Beyond the reach of the eye,"},{"id":"manas-2010:p1630:b001:l001","ordinal":70171,"en":"That accursed mass of battle—"},{"id":"manas-2010:p1630:b001:l002","ordinal":70172,"en":"No one could tell which was which!"},{"id":"manas-2010:p1630:b001:l003","ordinal":70173,"en":"As they fought their running skirmish,"},{"id":"manas-2010:p1630:b001:l004","ordinal":70174,"en":"When the Chinese fled,"},{"id":"manas-2010:p1630:b001:l005","ordinal":70175,"en":"Shouting, drawing in his horse’s reins,"},{"id":"manas-2010:p1630:b001:l006","ordinal":70176,"en":"He gathered them, did you see?"},{"id":"manas-2010:p1630:b001:l007","ordinal":70177,"en":"His six san of Black Chinese,"},{"id":"manas-2010:p1630:b001:l008","ordinal":70178,"en":"Kongurbay turned back"},{"id":"manas-2010:p1630:b001:l009","ordinal":70179,"en":"And slaughtered them, did you see?"},{"id":"manas-2010:p1630:b001:l010","ordinal":70180,"en":"Separating out his marksmen,"},{"id":"manas-2010:p1630:b001:l011","ordinal":70181,"en":"“Slaughter whatever you face!” he said,"},{"id":"manas-2010:p1630:b001:l012","ordinal":70182,"en":"And rushed in chanting, did you see?"},{"id":"manas-2010:p1630:b001:l013","ordinal":70183,"en":"Kün Jangjung and the giant Döödür,"},{"id":"manas-2010:p1630:b001:l014","ordinal":70184,"en":"Their blood surging, sparing nothing,"},{"id":"manas-2010:p1630:b001:l015","ordinal":70185,"en":"The massed Chinese entered."},{"id":"manas-2010:p1630:b001:l016","ordinal":70186,"en":"The mighty host swept over them."},{"id":"manas-2010:p1630:b001:l017","ordinal":70187,"en":"(What you see today is gone tomorrow;"},{"id":"manas-2010:p1630:b001:l018","ordinal":70188,"en":"Such is this unruly world!)"},{"id":"manas-2010:p1630:b001:l019","ordinal":70189,"en":"The massed Manchus grew frenzied;"},{"id":"manas-2010:p1630:b001:l020","ordinal":70190,"en":"Khan Kongurbay, mighty Kalcha,"},{"id":"manas-2010:p1630:b001:l021","ordinal":70191,"en":"Had become inflamed."},{"id":"manas-2010:p1630:b001:l022","ordinal":70192,"en":"The best at wielding swords"},{"id":"manas-2010:p1630:b001:l023","ordinal":70193,"en":"He separated into a band."},{"id":"manas-2010:p1630:b001:l024","ordinal":70194,"en":"The most skilled among the lancers"},{"id":"manas-2010:p1630:b001:l025","ordinal":70195,"en":"He drove to the front."},{"id":"manas-2010:p1630:b001:l026","ordinal":70196,"en":"Skilled horsemen and swift foot-runners,"},{"id":"manas-2010:p1630:b001:l027","ordinal":70197,"en":"Not sparing their lives at all,"},{"id":"manas-2010:p1630:b001:l028","ordinal":70198,"en":"They too swept forward."},{"id":"manas-2010:p1630:b001:l029","ordinal":70199,"en":"The earth turned and shook."},{"id":"manas-2010:p1630:b001:l030","ordinal":70200,"en":"At that moment Kongurbay"},{"id":"manas-2010:p1630:b001:l031","ordinal":70201,"en":"Had many ilek of troops."},{"id":"manas-2010:p1630:b001:l032","ordinal":70202,"en":"Clan after clan of people had come."},{"id":"manas-2010:p1630:b001:l033","ordinal":70203,"en":"As though Kalcha were not enough,"},{"id":"manas-2010:p1630:b001:l034","ordinal":70204,"en":"A man named Kanzharkol had come."},{"id":"manas-2010:p1630:b001:l035","ordinal":70205,"en":"His tread raised dust;"},{"id":"manas-2010:p1630:b001:l036","ordinal":70206,"en":"His voice drove out men’s souls."},{"id":"manas-2010:p1630:b001:l037","ordinal":70207,"en":"The dear Chinese people of forty tribes—"},{"id":"manas-2010:p1630:b001:l038","ordinal":70208,"en":"A mighty champion had risen among them."},{"id":"manas-2010:p1630:b001:l039","ordinal":70209,"en":"The sky was clear, the earth overcast;"},{"id":"manas-2010:p1630:b001:l040","ordinal":70210,"en":"Not a speck of ground could be seen."},{"id":"manas-2010:p1630:b001:l041","ordinal":70211,"en":"When the Chinese surged in disorder,"},{"id":"manas-2010:p1630:b001:l042","ordinal":70212,"en":"They loomed in hazy angles,"},{"id":"manas-2010:p1631:b001:l001","ordinal":70213,"en":"Rose in murky points."},{"id":"manas-2010:p1631:b001:l002","ordinal":70214,"en":"Beijing was a land beyond measure;"},{"id":"manas-2010:p1631:b001:l003","ordinal":70215,"en":"The Chinese were a people with armies."},{"id":"manas-2010:p1631:b001:l004","ordinal":70216,"en":"When their fury rose,"},{"id":"manas-2010:p1631:b001:l005","ordinal":70217,"en":"They were a flood that would engulf all."},{"id":"manas-2010:p1631:b001:l006","ordinal":70218,"en":"The Flood had never rushed into it;"},{"id":"manas-2010:p1631:b001:l007","ordinal":70219,"en":"They were the surging Chinese people."},{"id":"manas-2010:p1631:b001:l008","ordinal":70220,"en":"Alöökö’s Kongurbay"},{"id":"manas-2010:p1631:b001:l009","ordinal":70221,"en":"Chubak above all"},{"id":"manas-2010:p1631:b001:l010","ordinal":70222,"en":"Was watching at that time."},{"id":"manas-2010:p1631:b001:l011","ordinal":70223,"en":"At that moment, that man—"},{"id":"manas-2010:p1631:b001:l012","ordinal":70224,"en":"Khan Baltay’s Chubak,"},{"id":"manas-2010:p1631:b001:l013","ordinal":70225,"en":"Whipping Kögala,"},{"id":"manas-2010:p1631:b001:l014","ordinal":70226,"en":"Girding his waist securely,"},{"id":"manas-2010:p1631:b001:l015","ordinal":70227,"en":"Grim with rage,"},{"id":"manas-2010:p1631:b001:l016","ordinal":70228,"en":"Without sparing his dear life,"},{"id":"manas-2010:p1631:b001:l017","ordinal":70229,"en":"Reached Khan Kanzharkol."},{"id":"manas-2010:p1631:b001:l018","ordinal":70230,"en":"Their champion Kanzharkol,"},{"id":"manas-2010:p1631:b001:l019","ordinal":70231,"en":"Your Chubak, as soon as he reached him,"},{"id":"manas-2010:p1631:b001:l020","ordinal":70232,"en":"Knocked flat and swept past."},{"id":"manas-2010:p1631:b001:l021","ordinal":70233,"en":"Before a champion named Ayba"},{"id":"manas-2010:p1631:b001:l022","ordinal":70234,"en":"Could lift him onto his horse,"},{"id":"manas-2010:p1631:b001:l023","ordinal":70235,"en":"Argynkan’s Azhybay"},{"id":"manas-2010:p1631:b001:l024","ordinal":70236,"en":"Cut off his head and went on."},{"id":"manas-2010:p1631:b001:l025","ordinal":70237,"en":"When Kanzharkol died,"},{"id":"manas-2010:p1631:b001:l026","ordinal":70238,"en":"The commanders of ten bobbed along,"},{"id":"manas-2010:p1631:b001:l027","ordinal":70239,"en":"The commanders of fifty stood out tall,"},{"id":"manas-2010:p1631:b001:l028","ordinal":70240,"en":"Their warriors thronged,"},{"id":"manas-2010:p1631:b001:l029","ordinal":70241,"en":"Their lances swayed."},{"id":"manas-2010:p1631:b001:l030","ordinal":70242,"en":"Fire flashed from his eyes;"},{"id":"manas-2010:p1631:b001:l031","ordinal":70243,"en":"Wind came from his mouth;"},{"id":"manas-2010:p1631:b001:l032","ordinal":70244,"en":"His sword rang in its sheath;"},{"id":"manas-2010:p1631:b001:l033","ordinal":70245,"en":"His battle-axe jingled in his hand."},{"id":"manas-2010:p1631:b001:l034","ordinal":70246,"en":"With cotton sash and broad boots,"},{"id":"manas-2010:p1631:b001:l035","ordinal":70247,"en":"Kongurbay, khan of the shaven ones,"},{"id":"manas-2010:p1631:b001:l036","ordinal":70248,"en":"His roar splitting stone,"},{"id":"manas-2010:p1631:b001:l037","ordinal":70249,"en":"His shout splitting heads,"},{"id":"manas-2010:p1631:b001:l038","ordinal":70250,"en":"As though a demon had seized his wife,"},{"id":"manas-2010:p1631:b001:l039","ordinal":70251,"en":"As though his quarry had just escaped,"},{"id":"manas-2010:p1631:b001:l040","ordinal":70252,"en":"His eyes blazing wide,"},{"id":"manas-2010:p1631:b001:l041","ordinal":70253,"en":"Venom pouring from his mouth,"},{"id":"manas-2010:p1631:b001:l042","ordinal":70254,"en":"At Chubak, who had lanced Kanzhar,"},{"id":"manas-2010:p1632:b001:l001","ordinal":70255,"en":"Kongurbay charged."},{"id":"manas-2010:p1632:b001:l002","ordinal":70256,"en":"Looming like a dragon,"},{"id":"manas-2010:p1632:b001:l003","ordinal":70257,"en":"Making the earth split and rumble,"},{"id":"manas-2010:p1632:b001:l004","ordinal":70258,"en":"He took his pointed lance in hand,"},{"id":"manas-2010:p1632:b001:l005","ordinal":70259,"en":"Whipped Algara,"},{"id":"manas-2010:p1632:b001:l006","ordinal":70260,"en":"And that dog came right up thundering."},{"id":"manas-2010:p1632:b001:l007","ordinal":70261,"en":"He arrived ahead of an arrow;"},{"id":"manas-2010:p1632:b001:l008","ordinal":70262,"en":"From atop Kögala,"},{"id":"manas-2010:p1632:b001:l009","ordinal":70263,"en":"Chubak, as soon as he reached him,"},{"id":"manas-2010:p1632:b001:l010","ordinal":70264,"en":"He knocked flat and swept past."},{"id":"manas-2010:p1632:b001:l011","ordinal":70265,"en":"He did that terrible thing;"},{"id":"manas-2010:p1632:b001:l012","ordinal":70266,"en":"“Bind him alive!”"},{"id":"manas-2010:p1632:b001:l013","ordinal":70267,"en":"He commanded his people."},{"id":"manas-2010:p1632:b001:l014","ordinal":70268,"en":"When Chubak fell from his horse,"},{"id":"manas-2010:p1632:b001:l015","ordinal":70269,"en":"Six thousand governors, a san of champions,"},{"id":"manas-2010:p1632:b001:l016","ordinal":70270,"en":"Skilled against every foe—"},{"id":"manas-2010:p1632:b001:l017","ordinal":70271,"en":"Kongurbay, elder of the enemy,"},{"id":"manas-2010:p1632:b001:l018","ordinal":70272,"en":"Raised his voice in a shout."},{"id":"manas-2010:p1632:b001:l019","ordinal":70273,"en":"The massed Chinese, the many Manchus,"},{"id":"manas-2010:p1632:b001:l020","ordinal":70274,"en":"All came swarming over Chubak!"},{"id":"manas-2010:p1632:b001:l021","ordinal":70275,"en":"The Chinese ran in throngs."},{"id":"manas-2010:p1632:b001:l022","ordinal":70276,"en":"When the Chinese pressed him,"},{"id":"manas-2010:p1632:b001:l023","ordinal":70277,"en":"The poor bastard despaired of life."},{"id":"manas-2010:p1632:b001:l024","ordinal":70278,"en":"“When the moon is dark,"},{"id":"manas-2010:p1632:b001:l025","ordinal":70279,"en":"Such is the night,” he said."},{"id":"manas-2010:p1632:b001:l026","ordinal":70280,"en":"“When death is laid upon one’s head,"},{"id":"manas-2010:p1632:b001:l027","ordinal":70281,"en":"God, such is the day!” he said."},{"id":"manas-2010:p1632:b001:l028","ordinal":70282,"en":"The grudge from striking the governor swelled;"},{"id":"manas-2010:p1632:b001:l029","ordinal":70283,"en":"Your Chubak stood looking,"},{"id":"manas-2010:p1632:b001:l030","ordinal":70284,"en":"His heart burning bitterly:"},{"id":"manas-2010:p1632:b001:l031","ordinal":70285,"en":"“Will the massed Chinese and many Manchus"},{"id":"manas-2010:p1632:b001:l032","ordinal":70286,"en":"Capture me alive?"},{"id":"manas-2010:p1632:b001:l033","ordinal":70287,"en":"Khan Baltay’s Chubak—"},{"id":"manas-2010:p1632:b001:l034","ordinal":70288,"en":"Just because the Chinese wish it,"},{"id":"manas-2010:p1632:b001:l035","ordinal":70289,"en":"Will he fall into their hands?!”"},{"id":"manas-2010:p1632:b001:l036","ordinal":70290,"en":"His knees bent to the earth;"},{"id":"manas-2010:p1632:b001:l037","ordinal":70291,"en":"As your Chubak stared, he despaired of life."},{"id":"manas-2010:p1632:b001:l038","ordinal":70292,"en":"The earth turned to dust;"},{"id":"manas-2010:p1632:b001:l039","ordinal":70293,"en":"Seventy Beijings rose in motion."},{"id":"manas-2010:p1632:b001:l040","ordinal":70294,"en":"Their champions made ready"},{"id":"manas-2010:p1632:b001:l041","ordinal":70295,"en":"And ran with clubs in hand."},{"id":"manas-2010:p1632:b001:l042","ordinal":70296,"en":"Then your fierce Chubak"},{"id":"manas-2010:p1633:b001:l001","ordinal":70297,"en":"Despaired utterly of life."},{"id":"manas-2010:p1633:b001:l002","ordinal":70298,"en":"Swarming with lassos,"},{"id":"manas-2010:p1633:b001:l003","ordinal":70299,"en":"All the swift foot-runners"},{"id":"manas-2010:p1633:b001:l004","ordinal":70300,"en":"Made ready, saying, “I shall bind him!”"},{"id":"manas-2010:p1633:b001:l005","ordinal":70301,"en":"Their champions thronged"},{"id":"manas-2010:p1633:b001:l006","ordinal":70302,"en":"And now came right up."},{"id":"manas-2010:p1633:b001:l007","ordinal":70303,"en":"Your Chubak, forty-two khans"},{"id":"manas-2010:p1633:b001:l008","ordinal":70304,"en":"Again surrounded!"},{"id":"manas-2010:p1633:b001:l009","ordinal":70305,"en":"A merciless assault"},{"id":"manas-2010:p1633:b001:l010","ordinal":70306,"en":"He unleashed, did you see?"},{"id":"manas-2010:p1633:b001:l011","ordinal":70307,"en":"When the short gun cracked,"},{"id":"manas-2010:p1633:b001:l012","ordinal":70308,"en":"Without flinching, their heads one by one"},{"id":"manas-2010:p1633:b001:l013","ordinal":70309,"en":"He took, did you see?"},{"id":"manas-2010:p1633:b001:l014","ordinal":70310,"en":"Poor Chubak, outstanding one—"},{"id":"manas-2010:p1633:b001:l015","ordinal":70311,"en":"Whose prowess was beyond measure,"},{"id":"manas-2010:p1633:b001:l016","ordinal":70312,"en":"Who would face the enemy and fight,"},{"id":"manas-2010:p1633:b001:l017","ordinal":70313,"en":"Who would rescue him,"},{"id":"manas-2010:p1633:b001:l018","ordinal":70314,"en":"Your champion Almambet was not here!"},{"id":"manas-2010:p1633:b001:l019","ordinal":70315,"en":"Whose greatness was beyond measure,"},{"id":"manas-2010:p1633:b001:l020","ordinal":70316,"en":"Within this slaughter,"},{"id":"manas-2010:p1633:b001:l021","ordinal":70317,"en":"His nest-brother Manas was not here!"},{"id":"manas-2010:p1633:b001:l022","ordinal":70318,"en":"There was no support to rely on;"},{"id":"manas-2010:p1633:b001:l023","ordinal":70319,"en":"As the mighty slaughter raged,"},{"id":"manas-2010:p1633:b001:l024","ordinal":70320,"en":"Those Muslim people were not here!"},{"id":"manas-2010:p1633:b001:l025","ordinal":70321,"en":"Without looking up or down,"},{"id":"manas-2010:p1633:b001:l026","ordinal":70322,"en":"Your Chubak did not think, “I shall die.”"},{"id":"manas-2010:p1633:b001:l027","ordinal":70323,"en":"The six sharp blades descended from heaven,"},{"id":"manas-2010:p1633:b001:l028","ordinal":70324,"en":"The very finest among swords—"},{"id":"manas-2010:p1633:b001:l029","ordinal":70325,"en":"Zulpukor, which Manas took,"},{"id":"manas-2010:p1633:b001:l030","ordinal":70326,"en":"Achalbars of Azhybay,"},{"id":"manas-2010:p1633:b001:l031","ordinal":70327,"en":"Achbolot, which Bakay took,"},{"id":"manas-2010:p1633:b001:l032","ordinal":70328,"en":"Zhoykuma, which Chubak took,"},{"id":"manas-2010:p1633:b001:l033","ordinal":70329,"en":"Akalbars, which Almambet took,"},{"id":"manas-2010:p1633:b001:l034","ordinal":70330,"en":"Arkesken, which Syrgak took—"},{"id":"manas-2010:p1633:b001:l035","ordinal":70331,"en":"Those were the six sharp steels;"},{"id":"manas-2010:p1633:b001:l036","ordinal":70332,"en":"The Black Chinese before them,"},{"id":"manas-2010:p1633:b001:l037","ordinal":70333,"en":"Those were the treasures that made them scream."},{"id":"manas-2010:p1633:b001:l038","ordinal":70334,"en":"Never drawing back from iron,"},{"id":"manas-2010:p1633:b001:l039","ordinal":70335,"en":"Never returning without taking a head,"},{"id":"manas-2010:p1633:b001:l040","ordinal":70336,"en":"Never entering the sheath without drinking blood,"},{"id":"manas-2010:p1633:b001:l041","ordinal":70337,"en":"When drawn from its sheath,"},{"id":"manas-2010:p1633:b001:l042","ordinal":70338,"en":"Never going idle without drinking blood."},{"id":"manas-2010:p1634:b001:l001","ordinal":70339,"en":"Then outstanding Chubak"},{"id":"manas-2010:p1634:b001:l002","ordinal":70340,"en":"Grasped it by the hilt,"},{"id":"manas-2010:p1634:b001:l003","ordinal":70341,"en":"Drew it from its sheath then,"},{"id":"manas-2010:p1634:b001:l004","ordinal":70342,"en":"Without looking around him,"},{"id":"manas-2010:p1634:b001:l005","ordinal":70343,"en":"Without sparing his life at all."},{"id":"manas-2010:p1634:b001:l006","ordinal":70344,"en":"The Chinese who entered with lances"},{"id":"manas-2010:p1634:b001:l007","ordinal":70345,"en":"He knocked from their horses;"},{"id":"manas-2010:p1634:b001:l008","ordinal":70346,"en":"Whoever came before him,"},{"id":"manas-2010:p1634:b001:l009","ordinal":70347,"en":"Chubak toppled and laid flat."},{"id":"manas-2010:p1634:b001:l010","ordinal":70348,"en":"Not letting a lasso fall over his head,"},{"id":"manas-2010:p1634:b001:l011","ordinal":70349,"en":"Against the surging Chinese,"},{"id":"manas-2010:p1634:b001:l012","ordinal":70350,"en":"Your Chubak stood his ground,"},{"id":"manas-2010:p1634:b001:l013","ordinal":70351,"en":"Not yielding for nine days."},{"id":"manas-2010:p1634:b001:l014","ordinal":70352,"en":"When slung over him, that wondrous thing—"},{"id":"manas-2010:p1634:b001:l015","ordinal":70353,"en":"The mirror of his shoulder-blade;"},{"id":"manas-2010:p1634:b001:l016","ordinal":70354,"en":"When turned upon the grappling enemy,"},{"id":"manas-2010:p1634:b001:l017","ordinal":70355,"en":"The solace of his entrusted life;"},{"id":"manas-2010:p1634:b001:l018","ordinal":70356,"en":"A matchlock when firing at play,"},{"id":"manas-2010:p1634:b001:l019","ordinal":70357,"en":"A rank-breaker when enraged—"},{"id":"manas-2010:p1634:b001:l020","ordinal":70358,"en":"The short gray gun in his hand,"},{"id":"manas-2010:p1634:b001:l021","ordinal":70359,"en":"He leaned right and fired once,"},{"id":"manas-2010:p1634:b001:l022","ordinal":70360,"en":"Then laid their mighty warriors low."},{"id":"manas-2010:p1634:b001:l023","ordinal":70361,"en":"Not letting a lasso catch his head,"},{"id":"manas-2010:p1634:b001:l024","ordinal":70362,"en":"Akbaltay’s Chubak,"},{"id":"manas-2010:p1634:b001:l025","ordinal":70363,"en":"Not letting a net fall on his body,"},{"id":"manas-2010:p1634:b001:l026","ordinal":70364,"en":"Your Chubak, now on foot,"},{"id":"manas-2010:p1634:b001:l027","ordinal":70365,"en":"Ran up and down."},{"id":"manas-2010:p1634:b001:l028","ordinal":70366,"en":"Burning world, may you come to no good!"},{"id":"manas-2010:p1634:b001:l029","ordinal":70367,"en":"When the Chinese came crawling close,"},{"id":"manas-2010:p1634:b001:l030","ordinal":70368,"en":"He despaired of life, thinking, “I shall die.”"},{"id":"manas-2010:p1634:b001:l031","ordinal":70369,"en":"“The Chinese and Kongurbay have gathered;"},{"id":"manas-2010:p1634:b001:l032","ordinal":70370,"en":"Will they bind me alive?"},{"id":"manas-2010:p1634:b001:l033","ordinal":70371,"en":"Making this lone man shriek,"},{"id":"manas-2010:p1634:b001:l034","ordinal":70372,"en":"Will they slaughter me as a sacrifice?"},{"id":"manas-2010:p1634:b001:l035","ordinal":70373,"en":"Amid this slaughter,"},{"id":"manas-2010:p1634:b001:l036","ordinal":70374,"en":"Will my bones remain unburied?"},{"id":"manas-2010:p1634:b001:l037","ordinal":70375,"en":"My tender flesh, pure and fair,"},{"id":"manas-2010:p1634:b001:l038","ordinal":70376,"en":"Will white vultures tear and feast on it?"},{"id":"manas-2010:p1634:b001:l039","ordinal":70377,"en":"My dear head that shook the world,"},{"id":"manas-2010:p1634:b001:l040","ordinal":70378,"en":"Will the Chinese kick it about?"},{"id":"manas-2010:p1634:b001:l041","ordinal":70379,"en":"Upon my crane-like neck,"},{"id":"manas-2010:p1634:b001:l042","ordinal":70380,"en":"Will the Chinese set a pot-stand?"},{"id":"manas-2010:p1635:b001:l001","ordinal":70381,"en":"My dear head that would not submit,"},{"id":"manas-2010:p1635:b001:l002","ordinal":70382,"en":"To the Chinese with their kakan,"},{"id":"manas-2010:p1635:b001:l003","ordinal":70383,"en":"Will it go under guard to God?"},{"id":"manas-2010:p1635:b001:l004","ordinal":70384,"en":"Forty cubits high, so very deep,"},{"id":"manas-2010:p1635:b001:l005","ordinal":70385,"en":"Will they put me in a dug pit?!"},{"id":"manas-2010:p1635:b001:l006","ordinal":70386,"en":"That dog of an alien faith, that faithless dog,"},{"id":"manas-2010:p1635:b001:l007","ordinal":70387,"en":"Will he take his revenge far away?!"},{"id":"manas-2010:p1635:b001:l008","ordinal":70388,"en":"If he grows angry, Chubak,"},{"id":"manas-2010:p1635:b001:l009","ordinal":70389,"en":"Will he slaughter him midway on the road?”"},{"id":"manas-2010:p1635:b001:l010","ordinal":70390,"en":"Earth flew up and dust billowed."},{"id":"manas-2010:p1635:b001:l011","ordinal":70391,"en":"After fighting for nine days,"},{"id":"manas-2010:p1635:b001:l012","ordinal":70392,"en":"Your Chubak’s strength was gone."},{"id":"manas-2010:p1635:b001:l013","ordinal":70393,"en":"When he knew his strength was gone,"},{"id":"manas-2010:p1635:b001:l014","ordinal":70394,"en":"Alöökö’s Kongurbay"},{"id":"manas-2010:p1635:b001:l015","ordinal":70395,"en":"Shouted and thrust his lance."},{"id":"manas-2010:p1635:b001:l016","ordinal":70396,"en":"Your eagle born a lion,"},{"id":"manas-2010:p1635:b001:l017","ordinal":70397,"en":"With his coat-skirt the lance,"},{"id":"manas-2010:p1635:b001:l018","ordinal":70398,"en":"Your Chubak swept aside."},{"id":"manas-2010:p1635:b001:l019","ordinal":70399,"en":"Without looking around him,"},{"id":"manas-2010:p1635:b001:l020","ordinal":70400,"en":"Chubak did not spare his life at all."}]
