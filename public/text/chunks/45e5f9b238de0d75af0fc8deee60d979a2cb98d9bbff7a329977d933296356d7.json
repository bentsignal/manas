[{"id":"semetey-1-2013:p1199:b004:l025","ordinal":168705,"en":"The leopard born of a lion"},{"id":"semetey-1-2013:p1199:b004:l026","ordinal":168706,"en":"Did not flinch at the ringing blow."},{"id":"semetey-1-2013:p1199:b004:l027","ordinal":168707,"en":"Kongurbay's bronze spear"},{"id":"semetey-1-2013:p1199:b004:l028","ordinal":168708,"en":"Shattered and flew apart;"},{"id":"semetey-1-2013:p1199:b004:l029","ordinal":168709,"en":"He did not count it worth his trouser cuff."},{"id":"semetey-1-2013:p1199:b004:l030","ordinal":168710,"en":"“Take your turn, Burut,” he said."},{"id":"semetey-1-2013:p1199:b004:l031","ordinal":168711,"en":"Kongurbay stood stretching tall."},{"id":"semetey-1-2013:p1199:b004:l032","ordinal":168712,"en":"The Chinese warrior stood on the height;"},{"id":"semetey-1-2013:p1199:b004:l033","ordinal":168713,"en":"Hero Manas stretched and thrust."},{"id":"semetey-1-2013:p1199:b004:l034","ordinal":168714,"en":"The bronze spear broke apart completely;"},{"id":"semetey-1-2013:p1199:b004:l035","ordinal":168715,"en":"Kongurbay did not start."},{"id":"semetey-1-2013:p1199:b004:l036","ordinal":168716,"en":"Khan Agybay came"},{"id":"semetey-1-2013:p1199:b004:l037","ordinal":168717,"en":"Galloping on Kartküröng."},{"id":"semetey-1-2013:p1199:b004:l038","ordinal":168718,"en":"Into your bloodthirsty hero's hand"},{"id":"semetey-1-2013:p1199:b004:l039","ordinal":168719,"en":"He gave another spear."},{"id":"semetey-1-2013:p1200:b003:l001","ordinal":168720,"en":"Kongurbay charged and thrust;"},{"id":"semetey-1-2013:p1200:b003:l002","ordinal":168721,"en":"Khan Manas did not sway."},{"id":"semetey-1-2013:p1200:b003:l003","ordinal":168722,"en":"The leopard thrust from the side;"},{"id":"semetey-1-2013:p1200:b003:l004","ordinal":168723,"en":"Kongurbay did not sway."},{"id":"semetey-1-2013:p1200:b003:l005","ordinal":168724,"en":"They thrust in turns,"},{"id":"semetey-1-2013:p1200:b003:l006","ordinal":168725,"en":"Shouting as they leveled their spears."},{"id":"semetey-1-2013:p1200:b003:l007","ordinal":168726,"en":"Kongurbay and Manas then"},{"id":"semetey-1-2013:p1200:b003:l008","ordinal":168727,"en":"Broke sixty spears."},{"id":"semetey-1-2013:p1200:b003:l009","ordinal":168728,"en":"The teeming Chinese roared,"},{"id":"semetey-1-2013:p1200:b003:l010","ordinal":168729,"en":"Crying their Kakan battle cry."},{"id":"semetey-1-2013:p1200:b003:l011","ordinal":168730,"en":"The Muslim faithful roared,"},{"id":"semetey-1-2013:p1200:b003:l012","ordinal":168731,"en":"Crying their Islam battle cry."},{"id":"semetey-1-2013:p1200:b003:l013","ordinal":168732,"en":"May God never show us such a sight:"},{"id":"semetey-1-2013:p1200:b003:l014","ordinal":168733,"en":"Their spear points struck,"},{"id":"semetey-1-2013:p1200:b003:l015","ordinal":168734,"en":"Driving each other up and down."},{"id":"semetey-1-2013:p1200:b003:l016","ordinal":168735,"en":"When they fought with spears,"},{"id":"semetey-1-2013:p1200:b003:l017","ordinal":168736,"en":"The spears broke and splintered;"},{"id":"semetey-1-2013:p1200:b003:l018","ordinal":168737,"en":"Shafts thick as cauldron handles"},{"id":"semetey-1-2013:p1200:b003:l019","ordinal":168738,"en":"Flew about with a clatter."},{"id":"semetey-1-2013:p1200:b003:l020","ordinal":168739,"en":"Chasing and thrusting at one another,"},{"id":"semetey-1-2013:p1200:b003:l021","ordinal":168740,"en":"God had struck them."},{"id":"semetey-1-2013:p1200:b003:l022","ordinal":168741,"en":"The madman's Black Horse"},{"id":"semetey-1-2013:p1200:b003:l023","ordinal":168742,"en":"Had grown warm down to its flesh."},{"id":"semetey-1-2013:p1200:b003:l024","ordinal":168743,"en":"Thrusting three times for every single thrust,"},{"id":"semetey-1-2013:p1200:b003:l025","ordinal":168744,"en":"Kongurbay meant to prove himself."},{"id":"semetey-1-2013:p1200:b003:l026","ordinal":168745,"en":"The copper lance gave a shrill cry;"},{"id":"semetey-1-2013:p1200:b003:l027","ordinal":168746,"en":"In the broad ravine where no bird flew,"},{"id":"semetey-1-2013:p1200:b003:l028","ordinal":168747,"en":"No enemy escaped the spear,"},{"id":"semetey-1-2013:p1200:b003:l029","ordinal":168748,"en":"No person escaped death."},{"id":"semetey-1-2013:p1200:b003:l030","ordinal":168749,"en":"Alöökö's Kongurbay"},{"id":"semetey-1-2013:p1200:b003:l031","ordinal":168750,"en":"Showed the form of a lion;"},{"id":"semetey-1-2013:p1200:b003:l032","ordinal":168751,"en":"His courage was unlike another soul's,"},{"id":"semetey-1-2013:p1200:b003:l033","ordinal":168752,"en":"And it was plain he was a hero."},{"id":"semetey-1-2013:p1200:b003:l034","ordinal":168753,"en":"Shouting as he extended his spear,"},{"id":"semetey-1-2013:p1200:b003:l035","ordinal":168754,"en":"Crying the Möndü battle cry,"},{"id":"semetey-1-2013:p1200:b003:l036","ordinal":168755,"en":"Kongurbay now reached"},{"id":"semetey-1-2013:p1200:b003:l037","ordinal":168756,"en":"Blue-maned Manas himself."},{"id":"semetey-1-2013:p1200:b003:l038","ordinal":168757,"en":"When he reached him, the bronze spear"},{"id":"semetey-1-2013:p1200:b003:l039","ordinal":168758,"en":"Struck him and drove through."},{"id":"semetey-1-2013:p1200:b004:l001","ordinal":168759,"en":"Did you see that he was"},{"id":"semetey-1-2013:p1200:b004:l002","ordinal":168760,"en":"The strength of Beijing's Chinese?"},{"id":"semetey-1-2013:p1200:b004:l003","ordinal":168761,"en":"Did you see that renowned Kongurbay"},{"id":"semetey-1-2013:p1200:b004:l004","ordinal":168762,"en":"Was a lion?"},{"id":"semetey-1-2013:p1200:b004:l005","ordinal":168763,"en":"Kalkaman's Black Horse,"},{"id":"semetey-1-2013:p1200:b004:l006","ordinal":168764,"en":"Its pelvis narrow and its strength slight,"},{"id":"semetey-1-2013:p1200:b004:l007","ordinal":168765,"en":"Seemed about to fall backward."},{"id":"semetey-1-2013:p1200:b004:l008","ordinal":168766,"en":"When it rose upright"},{"id":"semetey-1-2013:p1200:b004:l009","ordinal":168767,"en":"And was about to topple over,"},{"id":"semetey-1-2013:p1200:b004:l010","ordinal":168768,"en":"As Manas neared the ground,"},{"id":"semetey-1-2013:p1200:b004:l011","ordinal":168769,"en":"Manas seized"},{"id":"semetey-1-2013:p1200:b004:l012","ordinal":168770,"en":"The Zulpukor in his hand"},{"id":"semetey-1-2013:p1200:b004:l013","ordinal":168771,"en":"And cut the infidel's bronze spear"},{"id":"semetey-1-2013:p1200:b004:l014","ordinal":168772,"en":"Clean through the middle."},{"id":"semetey-1-2013:p1200:b004:l015","ordinal":168773,"en":"His spear broke and vanished;"},{"id":"semetey-1-2013:p1200:b004:l016","ordinal":168774,"en":"Was Manas not upheld by Shai?"},{"id":"semetey-1-2013:p1200:b004:l017","ordinal":168775,"en":"The lion Manas righted himself."},{"id":"semetey-1-2013:p1200:b004:l018","ordinal":168776,"en":"Fastening his clasps,"},{"id":"semetey-1-2013:p1200:b004:l019","ordinal":168777,"en":"He put on Akolpok."},{"id":"semetey-1-2013:p1200:b004:l020","ordinal":168778,"en":"Sarala, who had accompanied him—"},{"id":"semetey-1-2013:p1200:b004:l021","ordinal":168779,"en":"He sprang bareback"},{"id":"semetey-1-2013:p1200:b004:l022","ordinal":168780,"en":"Onto the bow-like thoroughbred."},{"id":"semetey-1-2013:p1200:b004:l023","ordinal":168781,"en":"Roaring like Opol-Too,"},{"id":"semetey-1-2013:p1200:b004:l024","ordinal":168782,"en":"Noble Manas caught him."},{"id":"semetey-1-2013:p1200:b004:l025","ordinal":168783,"en":"Before the teeming Chinese host,"},{"id":"semetey-1-2013:p1200:b004:l026","ordinal":168784,"en":"Before he could dodge away,"},{"id":"semetey-1-2013:p1200:b004:l027","ordinal":168785,"en":"The mighty khan Manas"},{"id":"semetey-1-2013:p1200:b004:l028","ordinal":168786,"en":"Struck the Kamar-like Kalcha"},{"id":"semetey-1-2013:p1200:b004:l029","ordinal":168787,"en":"And passed on."},{"id":"semetey-1-2013:p1200:b004:l030","ordinal":168788,"en":"From atop Algara,"},{"id":"semetey-1-2013:p1200:b004:l031","ordinal":168789,"en":"As though a mountain had collapsed,"},{"id":"semetey-1-2013:p1200:b004:l032","ordinal":168790,"en":"Alöökö's Kongurbay"},{"id":"semetey-1-2013:p1200:b004:l033","ordinal":168791,"en":"Fell crashing down."},{"id":"semetey-1-2013:p1200:b004:l034","ordinal":168792,"en":"Khan Manas raged,"},{"id":"semetey-1-2013:p1200:b004:l035","ordinal":168793,"en":"Roaring like Opol-Too."},{"id":"semetey-1-2013:p1200:b004:l036","ordinal":168794,"en":"When noble Manas came,"},{"id":"semetey-1-2013:p1200:b004:l037","ordinal":168795,"en":"The Manchu people wailed,"},{"id":"semetey-1-2013:p1200:b004:l038","ordinal":168796,"en":"Bowing like young brides,"},{"id":"semetey-1-2013:p1202:b003:l001","ordinal":168797,"en":"They scattered and cleared the road."},{"id":"semetey-1-2013:p1202:b003:l002","ordinal":168798,"en":"The consummate, peerless Manas"},{"id":"semetey-1-2013:p1202:b003:l003","ordinal":168799,"en":"Reached him before an arrow."},{"id":"semetey-1-2013:p1202:b003:l004","ordinal":168800,"en":"Kongurbay's Algara—"},{"id":"semetey-1-2013:p1202:b003:l005","ordinal":168801,"en":"He caught it then"},{"id":"semetey-1-2013:p1202:b003:l006","ordinal":168802,"en":"And took it away as booty."},{"id":"semetey-1-2013:p1202:b003:l007","ordinal":168803,"en":"Sarala flew like an arrow,"},{"id":"semetey-1-2013:p1202:b003:l008","ordinal":168804,"en":"Taking the narrow shortcut;"},{"id":"semetey-1-2013:p1202:b003:l009","ordinal":168805,"en":"Kongurbay's Algara"},{"id":"semetey-1-2013:p1202:b003:l010","ordinal":168806,"en":"He turned toward the lowlands,"},{"id":"semetey-1-2013:p1202:b003:l011","ordinal":168807,"en":"Leading it away as booty."},{"id":"semetey-1-2013:p1202:b003:l012","ordinal":168808,"en":"As Manas was taking it away,"},{"id":"semetey-1-2013:p1202:b003:l013","ordinal":168809,"en":"His knees bending to the ground,"},{"id":"semetey-1-2013:p1202:b003:l014","ordinal":168810,"en":"Alöökö's Kongurbay"},{"id":"semetey-1-2013:p1202:b003:l015","ordinal":168811,"en":"Said, “Leave Algara with me,”"},{"id":"semetey-1-2013:p1202:b003:l016","ordinal":168812,"en":"And, turning aside toward Manas,"},{"id":"semetey-1-2013:p1202:b003:l017","ordinal":168813,"en":"Bowed like a young bride."},{"id":"semetey-1-2013:p1202:b003:l018","ordinal":168814,"en":"As Kongurbay stood this way,"},{"id":"semetey-1-2013:p1202:b003:l019","ordinal":168815,"en":"Crying, “Generous Manas, grant it as a gift!”"},{"id":"semetey-1-2013:p1202:b003:l020","ordinal":168816,"en":"Almambet came from beyond,"},{"id":"semetey-1-2013:p1202:b003:l021","ordinal":168817,"en":"Flying like an arrow, his limbs outstretched,"},{"id":"semetey-1-2013:p1202:b003:l022","ordinal":168818,"en":"Crying, “Generous Manas, grant it as a gift!”"},{"id":"semetey-1-2013:p1202:b003:l023","ordinal":168819,"en":"The two skirts of his coat flapping."},{"id":"semetey-1-2013:p1202:b003:l024","ordinal":168820,"en":"Before Almambet could reach him,"},{"id":"semetey-1-2013:p1202:b003:l025","ordinal":168821,"en":"Kongurbay's Algara—"},{"id":"semetey-1-2013:p1202:b003:l026","ordinal":168822,"en":"Before he could take it away as booty,"},{"id":"semetey-1-2013:p1202:b003:l027","ordinal":168823,"en":"Khan Manas thought wisely:"},{"id":"semetey-1-2013:p1202:b003:l028","ordinal":168824,"en":"“Another man's coat is no coat;"},{"id":"semetey-1-2013:p1202:b003:l029","ordinal":168825,"en":"Another man's horse is no horse."},{"id":"semetey-1-2013:p1202:b003:l030","ordinal":168826,"en":"Kongurbay was a hero;"},{"id":"semetey-1-2013:p1202:b003:l031","ordinal":168827,"en":"What shall I do with his horse?"},{"id":"semetey-1-2013:p1202:b003:l032","ordinal":168828,"en":"If I seize his horse,"},{"id":"semetey-1-2013:p1202:b003:l033","ordinal":168829,"en":"What inheritance will it bring me?"},{"id":"semetey-1-2013:p1202:b003:l034","ordinal":168830,"en":"Better than that, here and now,"},{"id":"semetey-1-2013:p1202:b003:l035","ordinal":168831,"en":"I will leave his horse with him.”"},{"id":"semetey-1-2013:p1202:b003:l036","ordinal":168832,"en":"To the Kalcha who stood bowing,"},{"id":"semetey-1-2013:p1202:b003:l037","ordinal":168833,"en":"Manas showed his contempt."},{"id":"semetey-1-2013:p1202:b003:l038","ordinal":168834,"en":"“Here, infidel, is your horse,” he said."},{"id":"semetey-1-2013:p1202:b003:l039","ordinal":168835,"en":"Snarling in anger,"},{"id":"semetey-1-2013:p1202:b004:l001","ordinal":168836,"en":"He hurled the reins knotted with an okoro"},{"id":"semetey-1-2013:p1202:b004:l002","ordinal":168837,"en":"Toward Kongurbay."},{"id":"semetey-1-2013:p1202:b004:l003","ordinal":168838,"en":"The many Manchus, barely standing,"},{"id":"semetey-1-2013:p1202:b004:l004","ordinal":168839,"en":"Took Algara"},{"id":"semetey-1-2013:p1202:b004:l005","ordinal":168840,"en":"And set the infidels' master horseman and footrunner,"},{"id":"semetey-1-2013:p1202:b004:l006","ordinal":168841,"en":"The lion Kongur Kalcha,"},{"id":"semetey-1-2013:p1202:b004:l007","ordinal":168842,"en":"Upon the horse."},{"id":"semetey-1-2013:p1202:b004:l008","ordinal":168843,"en":"The helpless Almambet,"},{"id":"semetey-1-2013:p1202:b004:l009","ordinal":168844,"en":"With many cares too great for his breast,"},{"id":"semetey-1-2013:p1202:b004:l010","ordinal":168845,"en":"Said, “Alas, bloodthirsty man, may you never prosper!”"},{"id":"semetey-1-2013:p1202:b004:l011","ordinal":168846,"en":"His tears streamed in ten directions."},{"id":"semetey-1-2013:p1202:b004:l012","ordinal":168847,"en":"“Alas, Manas, may you come to ruin;"},{"id":"semetey-1-2013:p1202:b004:l013","ordinal":168848,"en":"May you never have a second chance!"},{"id":"semetey-1-2013:p1202:b004:l014","ordinal":168849,"en":"Would anyone release"},{"id":"semetey-1-2013:p1202:b004:l015","ordinal":168850,"en":"A hare that had fallen into his hands?"},{"id":"semetey-1-2013:p1202:b004:l016","ordinal":168851,"en":"Could anyone be like you?!"},{"id":"semetey-1-2013:p1202:b004:l017","ordinal":168852,"en":"Lion prince, leopard,"},{"id":"semetey-1-2013:p1202:b004:l018","ordinal":168853,"en":"Could any person behave so?"},{"id":"semetey-1-2013:p1202:b004:l019","ordinal":168854,"en":"Was Kongurbay not"},{"id":"semetey-1-2013:p1202:b004:l020","ordinal":168855,"en":"The strength of steadfast Beijing?"},{"id":"semetey-1-2013:p1202:b004:l021","ordinal":168856,"en":"Had you given me Algara,"},{"id":"semetey-1-2013:p1202:b004:l022","ordinal":168857,"en":"Would I not have drawn the line?"},{"id":"semetey-1-2013:p1202:b004:l023","ordinal":168858,"en":"Would I not have made sport"},{"id":"semetey-1-2013:p1202:b004:l024","ordinal":168859,"en":"Of the dark mass of Chinese?"},{"id":"semetey-1-2013:p1202:b004:l025","ordinal":168860,"en":"If he were parted from Algara,"},{"id":"semetey-1-2013:p1202:b004:l026","ordinal":168861,"en":"Would I not have shown him the city?"},{"id":"semetey-1-2013:p1202:b004:l027","ordinal":168862,"en":"Would I not have brought upon the Chinese"},{"id":"semetey-1-2013:p1202:b004:l028","ordinal":168863,"en":"A calamity no person had seen?"},{"id":"semetey-1-2013:p1202:b004:l029","ordinal":168864,"en":"Would I not have requited my old grievance"},{"id":"semetey-1-2013:p1202:b004:l030","ordinal":168865,"en":"And exacted from the Kalcha"},{"id":"semetey-1-2013:p1202:b004:l031","ordinal":168866,"en":"My affliction from long ago?"},{"id":"semetey-1-2013:p1202:b004:l032","ordinal":168867,"en":"From Beijing itself,"},{"id":"semetey-1-2013:p1202:b004:l033","ordinal":168868,"en":"This Kongurbay will not disappear."},{"id":"semetey-1-2013:p1202:b004:l034","ordinal":168869,"en":"Unless this Kongurbay dies"},{"id":"semetey-1-2013:p1202:b004:l035","ordinal":168870,"en":"And beholds the face of Judgment Day,"},{"id":"semetey-1-2013:p1202:b004:l036","ordinal":168871,"en":"The Kyrgyz cause will not prosper."},{"id":"semetey-1-2013:p1202:b004:l037","ordinal":168872,"en":"He is that renowned, formidable stronghold;"},{"id":"semetey-1-2013:p1202:b004:l038","ordinal":168873,"en":"He is that lion unlike any mortal,"},{"id":"semetey-1-2013:p1202:b004:l039","ordinal":168874,"en":"The most skillful among spearmen—"},{"id":"semetey-1-2013:p1203:b003:l001","ordinal":168875,"en":"Did you take him and let him go,"},{"id":"semetey-1-2013:p1203:b003:l002","ordinal":168876,"en":"That mighty man who knew the enemy's devices?"},{"id":"semetey-1-2013:p1203:b003:l003","ordinal":168877,"en":"You are a woeful Manas;"},{"id":"semetey-1-2013:p1203:b003:l004","ordinal":168878,"en":"You would not heed my words."},{"id":"semetey-1-2013:p1203:b003:l005","ordinal":168879,"en":"When Algara was captured,"},{"id":"semetey-1-2013:p1203:b003:l006","ordinal":168880,"en":"I ran especially to you;"},{"id":"semetey-1-2013:p1203:b003:l007","ordinal":168881,"en":"When Algara was returned,"},{"id":"semetey-1-2013:p1203:b003:l008","ordinal":168882,"en":"My lion, I despaired of you."},{"id":"semetey-1-2013:p1203:b003:l009","ordinal":168883,"en":"Your waist girded for battle,"},{"id":"semetey-1-2013:p1203:b003:l010","ordinal":168884,"en":"Valiant gray-maned Manas,"},{"id":"semetey-1-2013:p1203:b003:l011","ordinal":168885,"en":"Did you lay claim to Beijing?"},{"id":"semetey-1-2013:p1203:b003:l012","ordinal":168886,"en":"You treated the Kalcha like a child;"},{"id":"semetey-1-2013:p1203:b003:l013","ordinal":168887,"en":"Did you leave alive, without killing,"},{"id":"semetey-1-2013:p1203:b003:l014","ordinal":168888,"en":"The calamity that befell your head?"},{"id":"semetey-1-2013:p1203:b003:l015","ordinal":168889,"en":"He will not heed your pleading;"},{"id":"semetey-1-2013:p1203:b003:l016","ordinal":168890,"en":"The Kalcha slave will find his chance."},{"id":"semetey-1-2013:p1203:b003:l017","ordinal":168891,"en":"If he does not die, Kalcha will knock"},{"id":"semetey-1-2013:p1203:b003:l018","ordinal":168892,"en":"All the wind out of you."},{"id":"semetey-1-2013:p1203:b003:l019","ordinal":168893,"en":"You gave away for nothing, Manas,"},{"id":"semetey-1-2013:p1203:b003:l020","ordinal":168894,"en":"A stallion like Algara;"},{"id":"semetey-1-2013:p1203:b003:l021","ordinal":168895,"en":"Now, my hero, you have found"},{"id":"semetey-1-2013:p1203:b003:l022","ordinal":168896,"en":"A kinsman like Kongurbay."},{"id":"semetey-1-2013:p1203:b003:l023","ordinal":168897,"en":"In the end Kongurbay will bring"},{"id":"semetey-1-2013:p1203:b003:l024","ordinal":168898,"en":"The end of days upon your head."},{"id":"semetey-1-2013:p1203:b003:l025","ordinal":168899,"en":"Had you given me Algara,"},{"id":"semetey-1-2013:p1203:b003:l026","ordinal":168900,"en":"Would I not have routed"},{"id":"semetey-1-2013:p1203:b003:l027","ordinal":168901,"en":"The teeming Chinese on foot,"},{"id":"semetey-1-2013:p1203:b003:l028","ordinal":168902,"en":"Slaughtered the Kalcha,"},{"id":"semetey-1-2013:p1203:b003:l029","ordinal":168903,"en":"And given my poor head"},{"id":"semetey-1-2013:p1203:b003:l030","ordinal":168904,"en":"Rule over the predators?"},{"id":"semetey-1-2013:p1203:b003:l031","ordinal":168905,"en":"There are the Black Chinese people;"},{"id":"semetey-1-2013:p1203:b003:l032","ordinal":168906,"en":"When enraged, they have a custom"},{"id":"semetey-1-2013:p1203:b003:l033","ordinal":168907,"en":"Of drinking human blood."},{"id":"semetey-1-2013:p1203:b003:l034","ordinal":168908,"en":"They have waists girded for battle"},{"id":"semetey-1-2013:p1203:b003:l035","ordinal":168909,"en":"And a place where they lie in wait."},{"id":"semetey-1-2013:p1203:b003:l036","ordinal":168910,"en":"They have the wise man from Beijing,"},{"id":"semetey-1-2013:p1203:b003:l037","ordinal":168911,"en":"The valiant hero Kalcha."},{"id":"semetey-1-2013:p1203:b003:l038","ordinal":168912,"en":"A slave deft with a spear,"},{"id":"semetey-1-2013:p1203:b003:l039","ordinal":168913,"en":"Kongurbay, who has long fought,"},{"id":"semetey-1-2013:p1203:b005:l001","ordinal":168914,"en":"Is a mighty slave"},{"id":"semetey-1-2013:p1203:b005:l002","ordinal":168915,"en":"Who knows the enemy's devices."},{"id":"semetey-1-2013:p1203:b005:l003","ordinal":168916,"en":"By returning the Kalcha's horse,"},{"id":"semetey-1-2013:p1203:b005:l004","ordinal":168917,"en":"You have exhausted my every means.\""},{"id":"semetey-1-2013:p1203:b005:l005","ordinal":168918,"en":"Before Almambet, who spoke these words,"},{"id":"semetey-1-2013:p1203:b005:l006","ordinal":168919,"en":"Had closed his mouth,"},{"id":"semetey-1-2013:p1203:b005:l007","ordinal":168920,"en":"Kokotoy's thousand black camels apiece,"},{"id":"semetey-1-2013:p1203:b005:l008","ordinal":168921,"en":"The great loads of gold,"},{"id":"semetey-1-2013:p1203:b005:l009","ordinal":168922,"en":"The thick-woven piebald cloth of Andijan,"},{"id":"semetey-1-2013:p1203:b005:l010","ordinal":168923,"en":"The costly black-patterned silk of Bukhara—"},{"id":"semetey-1-2013:p1203:b005:l011","ordinal":168924,"en":"The prize staked for the joust—"},{"id":"semetey-1-2013:p1203:b005:l012","ordinal":168925,"en":"The Muslim kinsmen"},{"id":"semetey-1-2013:p1203:b005:l013","ordinal":168926,"en":"Now witnessed that spectacle."},{"id":"semetey-1-2013:p1203:b005:l014","ordinal":168927,"en":"According to their clans,"},{"id":"semetey-1-2013:p1203:b005:l015","ordinal":168928,"en":"He distributed it among the khans."},{"id":"semetey-1-2013:p1203:b005:l016","ordinal":168929,"en":"Those who won the prize"},{"id":"semetey-1-2013:p1203:b005:l017","ordinal":168930,"en":"Were content at heart,"},{"id":"semetey-1-2013:p1203:b005:l018","ordinal":168931,"en":"Swaggering in their wealth,"},{"id":"semetey-1-2013:p1203:b005:l019","ordinal":168932,"en":"And enjoyed the splendid spectacle."},{"id":"semetey-1-2013:p1203:b005:l020","ordinal":168933,"en":"They measured the jousting prize by the whip"},{"id":"semetey-1-2013:p1203:b005:l021","ordinal":168934,"en":"And divided it;"},{"id":"semetey-1-2013:p1203:b005:l022","ordinal":168935,"en":"Their strongest men grappled"},{"id":"semetey-1-2013:p1203:b005:l023","ordinal":168936,"en":"And fell to whipping one another."},{"id":"semetey-1-2013:p1203:b005:l024","ordinal":168937,"en":"They made the people weary"},{"id":"semetey-1-2013:p1203:b005:l025","ordinal":168938,"en":"Of all that wealth."},{"id":"semetey-1-2013:p1203:b005:l026","ordinal":168939,"en":"From the great loaded stores,"},{"id":"semetey-1-2013:p1203:b005:l027","ordinal":168940,"en":"They let everyone who reached them"},{"id":"semetey-1-2013:p1203:b005:l028","ordinal":168941,"en":"Plunder one kerchief apiece."},{"id":"semetey-1-2013:p1203:b005:l029","ordinal":168942,"en":"They enjoyed a mighty spectacle,"},{"id":"semetey-1-2013:p1203:b005:l030","ordinal":168943,"en":"Measured Khan Manas's prize by the whip,"},{"id":"semetey-1-2013:p1203:b005:l031","ordinal":168944,"en":"And divided it."},{"id":"semetey-1-2013:p1203:b005:l032","ordinal":168945,"en":"From the gold loaded on pack animals,"},{"id":"semetey-1-2013:p1203:b005:l033","ordinal":168946,"en":"They poured heaps"},{"id":"semetey-1-2013:p1203:b005:l034","ordinal":168947,"en":"For every kinsman."},{"id":"semetey-1-2013:p1203:b005:l035","ordinal":168948,"en":"The Muslims plundered gold"},{"id":"semetey-1-2013:p1203:b005:l036","ordinal":168949,"en":"As their prize."},{"id":"semetey-1-2013:p1203:b005:l037","ordinal":168950,"en":"Let us leave this matter here;"},{"id":"semetey-1-2013:p1203:b005:l038","ordinal":168951,"en":"Jamby shooting is another contest,"},{"id":"semetey-1-2013:p1203:b005:l039","ordinal":168952,"en":"And let us begin its tale."},{"id":"semetey-1-2013:p1204:b004:l001","ordinal":168953,"en":"A pine pole"},{"id":"semetey-1-2013:p1204:b004:l002","ordinal":168954,"en":"Was raised high."},{"id":"semetey-1-2013:p1204:b004:l003","ordinal":168955,"en":"At Kokotoy's celebration"},{"id":"semetey-1-2013:p1204:b004:l004","ordinal":168956,"en":"They began an immense game."},{"id":"semetey-1-2013:p1204:b004:l005","ordinal":168957,"en":"They spread riches all around"},{"id":"semetey-1-2013:p1204:b004:l006","ordinal":168958,"en":"And tied a precious jamby"},{"id":"semetey-1-2013:p1204:b004:l007","ordinal":168959,"en":"To the tip of that pole."},{"id":"semetey-1-2013:p1204:b004:l008","ordinal":168960,"en":"Saying, “May we shoot down the jamby,”"}]
