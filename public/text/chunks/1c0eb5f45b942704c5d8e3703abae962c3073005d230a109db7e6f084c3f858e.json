[{"id":"semetey-1-2013:p0503:b003:l034","ordinal":115201,"en":"The fairest among women then,"},{"id":"semetey-1-2013:p0503:b003:l035","ordinal":115202,"en":"I, your luckless mother,"},{"id":"semetey-1-2013:p0503:b003:l036","ordinal":115203,"en":"Was a girl of fourteen."},{"id":"semetey-1-2013:p0503:b003:l037","ordinal":115204,"en":"Your grandfather, this Khan Temir,"},{"id":"semetey-1-2013:p0503:b003:l038","ordinal":115205,"en":"And my deep-dug moat—"},{"id":"semetey-1-2013:p0503:b003:l039","ordinal":115206,"en":"Into my father Khan Temir's city"},{"id":"semetey-1-2013:p0503:b004:l001","ordinal":115207,"en":"Akbaltai's Chubak"},{"id":"semetey-1-2013:p0503:b004:l002","ordinal":115208,"en":"Wrought a marvel without mercy."},{"id":"semetey-1-2013:p0503:b004:l003","ordinal":115209,"en":"Greasing his battle-axe,"},{"id":"semetey-1-2013:p0503:b004:l004","ordinal":115210,"en":"Sixty watchmen,"},{"id":"semetey-1-2013:p0503:b004:l005","ordinal":115211,"en":"Seventy spearmen,"},{"id":"semetey-1-2013:p0503:b004:l006","ordinal":115212,"en":"He seized and killed."},{"id":"semetey-1-2013:p0503:b004:l007","ordinal":115213,"en":"Unable to withstand Chubak's wrath,"},{"id":"semetey-1-2013:p0503:b004:l008","ordinal":115214,"en":"They fell into turmoil."},{"id":"semetey-1-2013:p0503:b004:l009","ordinal":115215,"en":"Bukhara with its city, Khan Temir—"},{"id":"semetey-1-2013:p0503:b004:l010","ordinal":115216,"en":"Slaughtered, they abandoned the city."},{"id":"semetey-1-2013:p0503:b004:l011","ordinal":115217,"en":"Then Chubak was not yet Chubak,"},{"id":"semetey-1-2013:p0503:b004:l012","ordinal":115218,"en":"Had not yet gone to settle in Talas,"},{"id":"semetey-1-2013:p0503:b004:l013","ordinal":115219,"en":"To befriend your father,"},{"id":"semetey-1-2013:p0503:b004:l014","ordinal":115220,"en":"Had not yet become Manas's companion."},{"id":"semetey-1-2013:p0503:b004:l015","ordinal":115221,"en":"When he reached the age of twelve,"},{"id":"semetey-1-2013:p0503:b004:l016","ordinal":115222,"en":"He besieged Kashgar and took it six times."},{"id":"semetey-1-2013:p0503:b004:l017","ordinal":115223,"en":"Alty-Shaar, Andijan,"},{"id":"semetey-1-2013:p0503:b004:l018","ordinal":115224,"en":"Beyond them Kokand and Margilan,"},{"id":"semetey-1-2013:p0503:b004:l019","ordinal":115225,"en":"At their side Samarkand—"},{"id":"semetey-1-2013:p0503:b004:l020","ordinal":115226,"en":"He attacked and took them four times."},{"id":"semetey-1-2013:p0503:b004:l021","ordinal":115227,"en":"Where his Kökala had not trodden,"},{"id":"semetey-1-2013:p0503:b004:l022","ordinal":115228,"en":"Not a single whole place remained;"},{"id":"semetey-1-2013:p0503:b004:l023","ordinal":115229,"en":"Of Akbaltai's son"},{"id":"semetey-1-2013:p0503:b004:l024","ordinal":115230,"en":"Whose battle-cry they had not heard—"},{"id":"semetey-1-2013:p0503:b004:l025","ordinal":115231,"en":"Not a single whole people remained."},{"id":"semetey-1-2013:p0503:b004:l026","ordinal":115232,"en":"Akbaltai's Chubak"},{"id":"semetey-1-2013:p0503:b004:l027","ordinal":115233,"en":"Threw the world's peoples into turmoil."},{"id":"semetey-1-2013:p0503:b004:l028","ordinal":115234,"en":"The son of Khan Baltai,"},{"id":"semetey-1-2013:p0503:b004:l029","ordinal":115235,"en":"His bristling, cropped-eared warrior,"},{"id":"semetey-1-2013:p0503:b004:l030","ordinal":115236,"en":"Shrill cries and fierce cheering,"},{"id":"semetey-1-2013:p0503:b004:l031","ordinal":115237,"en":"Mottled shirt and long trousers—"},{"id":"semetey-1-2013:p0503:b004:l032","ordinal":115238,"en":"Akbaltai's Chubak"},{"id":"semetey-1-2013:p0503:b004:l033","ordinal":115239,"en":"Inflicted such wrong upon Bukhara."},{"id":"semetey-1-2013:p0503:b004:l034","ordinal":115240,"en":"When he reached sixteen,"},{"id":"semetey-1-2013:p0503:b004:l035","ordinal":115241,"en":"Upon my father Khan Temir"},{"id":"semetey-1-2013:p0503:b004:l036","ordinal":115242,"en":"He laid oppression without mercy."},{"id":"semetey-1-2013:p0503:b004:l037","ordinal":115243,"en":"A letter came from a caravaneer;"},{"id":"semetey-1-2013:p0503:b004:l038","ordinal":115244,"en":"He promptly delivered it without hesitation."},{"id":"semetey-1-2013:p0503:b004:l039","ordinal":115245,"en":"Seeing the letter, he burst into tears,"},{"id":"semetey-1-2013:p0504:b003:l001","ordinal":115246,"en":"Not one person showed courage;"},{"id":"semetey-1-2013:p0504:b003:l002","ordinal":115247,"en":"The Sarts of Bukhara wailed."},{"id":"semetey-1-2013:p0504:b003:l003","ordinal":115248,"en":"When we read his letter,"},{"id":"semetey-1-2013:p0504:b003:l004","ordinal":115249,"en":"The command Chubak had made,"},{"id":"semetey-1-2013:p0504:b003:l005","ordinal":115250,"en":"What he inflicted on Bukhara, alas,"},{"id":"semetey-1-2013:p0504:b003:l006","ordinal":115251,"en":"Was a horror no mortal would commit."},{"id":"semetey-1-2013:p0504:b003:l007","ordinal":115252,"en":"“Let them submit to this letter of mine;"},{"id":"semetey-1-2013:p0504:b003:l008","ordinal":115253,"en":"Khan Temir's golden throne"},{"id":"semetey-1-2013:p0504:b003:l009","ordinal":115254,"en":"Let him give without a quarrel."},{"id":"semetey-1-2013:p0504:b003:l010","ordinal":115255,"en":"If he will not obey my words,"},{"id":"semetey-1-2013:p0504:b003:l011","ordinal":115256,"en":"If he will not give his golden throne,"},{"id":"semetey-1-2013:p0504:b003:l012","ordinal":115257,"en":"I shall trample his head."},{"id":"semetey-1-2013:p0504:b003:l013","ordinal":115258,"en":"Bukhara, the people with its rulers—"},{"id":"semetey-1-2013:p0504:b003:l014","ordinal":115259,"en":"I shall scatter its treasury."},{"id":"semetey-1-2013:p0504:b003:l015","ordinal":115260,"en":"I shall plunder its goods,"},{"id":"semetey-1-2013:p0504:b003:l016","ordinal":115261,"en":"Wreak utter devastation."},{"id":"semetey-1-2013:p0504:b003:l017","ordinal":115262,"en":"When springtime comes,"},{"id":"semetey-1-2013:p0504:b003:l018","ordinal":115263,"en":"I shall let none ride a maned filly."},{"id":"semetey-1-2013:p0504:b003:l019","ordinal":115264,"en":"When autumn comes,"},{"id":"semetey-1-2013:p0504:b003:l020","ordinal":115265,"en":"I shall let none eat a fat-tailed lamb."},{"id":"semetey-1-2013:p0504:b003:l021","ordinal":115266,"en":"I shall not let them yoke a pair of oxen,"},{"id":"semetey-1-2013:p0504:b003:l022","ordinal":115267,"en":"Nor let them sow a crop,"},{"id":"semetey-1-2013:p0504:b003:l023","ordinal":115268,"en":"Nor turn the face of the earth,"},{"id":"semetey-1-2013:p0504:b003:l024","ordinal":115269,"en":"Nor scatter a handful of wheat."},{"id":"semetey-1-2013:p0504:b003:l025","ordinal":115270,"en":"I shall rob their camels on the road,"},{"id":"semetey-1-2013:p0504:b003:l026","ordinal":115271,"en":"Seize and slaughter Bukhara's"},{"id":"semetey-1-2013:p0504:b003:l027","ordinal":115272,"en":"Giant who goes out scouting!”"},{"id":"semetey-1-2013:p0504:b003:l028","ordinal":115273,"en":"Such was the letter Chubak had written."},{"id":"semetey-1-2013:p0504:b003:l029","ordinal":115274,"en":"Seeing his letter, my father"},{"id":"semetey-1-2013:p0504:b003:l030","ordinal":115275,"en":"Despaired of his precious life."},{"id":"semetey-1-2013:p0504:b003:l031","ordinal":115276,"en":"Chubak had unleashed his fury;"},{"id":"semetey-1-2013:p0504:b003:l032","ordinal":115277,"en":"The news drove the soul from them."},{"id":"semetey-1-2013:p0504:b003:l033","ordinal":115278,"en":"The people of Bukhara there"},{"id":"semetey-1-2013:p0504:b003:l034","ordinal":115279,"en":"Were all but thrown into ruin."},{"id":"semetey-1-2013:p0504:b003:l035","ordinal":115280,"en":"Their khoja in a white turban,"},{"id":"semetey-1-2013:p0504:b003:l036","ordinal":115281,"en":"Their mullah in a mottled robe,"},{"id":"semetey-1-2013:p0504:b003:l037","ordinal":115282,"en":"Their eloquent elder Ulukman,"},{"id":"semetey-1-2013:p0504:b003:l038","ordinal":115283,"en":"Saw a tumultuous affair,"},{"id":"semetey-1-2013:p0504:b003:l039","ordinal":115284,"en":"All the people of Bukhara."},{"id":"semetey-1-2013:p0504:b004:l001","ordinal":115285,"en":"Their broad-jawed orator,"},{"id":"semetey-1-2013:p0504:b004:l002","ordinal":115286,"en":"Bukhara's knowing strategists,"},{"id":"semetey-1-2013:p0504:b004:l003","ordinal":115287,"en":"Many a man of cunning,"},{"id":"semetey-1-2013:p0504:b004:l004","ordinal":115288,"en":"To submit to his demand"},{"id":"semetey-1-2013:p0504:b004:l005","ordinal":115289,"en":"All agreed together."},{"id":"semetey-1-2013:p0504:b004:l006","ordinal":115290,"en":"My father Khan Temir's golden throne"},{"id":"semetey-1-2013:p0504:b004:l007","ordinal":115291,"en":"They would give to hero Chubak."},{"id":"semetey-1-2013:p0504:b004:l008","ordinal":115292,"en":"They put the date in writing,"},{"id":"semetey-1-2013:p0504:b004:l009","ordinal":115293,"en":"Reckoned the appointed day,"},{"id":"semetey-1-2013:p0504:b004:l010","ordinal":115294,"en":"And Khan Baltai's son"},{"id":"semetey-1-2013:p0504:b004:l011","ordinal":115295,"en":"They would make their sovereign."},{"id":"semetey-1-2013:p0504:b004:l012","ordinal":115296,"en":"Then they stood making promises,"},{"id":"semetey-1-2013:p0504:b004:l013","ordinal":115297,"en":"Swearing oaths on pain of death,"},{"id":"semetey-1-2013:p0504:b004:l014","ordinal":115298,"en":"Licking deadly poison."},{"id":"semetey-1-2013:p0504:b004:l015","ordinal":115299,"en":"The people cried out and bowed;"},{"id":"semetey-1-2013:p0504:b004:l016","ordinal":115300,"en":"The Bukharans, led by my father,"},{"id":"semetey-1-2013:p0504:b004:l017","ordinal":115301,"en":"Despaired of their precious lives."},{"id":"semetey-1-2013:p0504:b004:l018","ordinal":115302,"en":"While my father was in this state,"},{"id":"semetey-1-2013:p0504:b004:l019","ordinal":115303,"en":"With ninety girls in the palace"},{"id":"semetey-1-2013:p0504:b004:l020","ordinal":115304,"en":"I was playing games."},{"id":"semetey-1-2013:p0504:b004:l021","ordinal":115305,"en":"At the foot of the tower,"},{"id":"semetey-1-2013:p0504:b004:l022","ordinal":115306,"en":"Playing Manara and raising dust,"},{"id":"semetey-1-2013:p0504:b004:l023","ordinal":115307,"en":"I heard word from my watchman."},{"id":"semetey-1-2013:p0504:b004:l024","ordinal":115308,"en":"I, your mother Kanykei,"},{"id":"semetey-1-2013:p0504:b004:l025","ordinal":115309,"en":"The darling of the palace girls,"},{"id":"semetey-1-2013:p0504:b004:l026","ordinal":115310,"en":"Heard that in fifteen days,"},{"id":"semetey-1-2013:p0504:b004:l027","ordinal":115311,"en":"To Khan Baltai's son"},{"id":"semetey-1-2013:p0504:b004:l028","ordinal":115312,"en":"Khan Temir's golden throne"},{"id":"semetey-1-2013:p0504:b004:l029","ordinal":115313,"en":"Was to be given."},{"id":"semetey-1-2013:p0504:b004:l030","ordinal":115314,"en":"To his levying tribute and taxes"},{"id":"semetey-1-2013:p0504:b004:l031","ordinal":115315,"en":"Populous Bukhara had agreed;"},{"id":"semetey-1-2013:p0504:b004:l032","ordinal":115316,"en":"Khan Akbaltai's son"},{"id":"semetey-1-2013:p0504:b004:l033","ordinal":115317,"en":"Over this very Bukhara"},{"id":"semetey-1-2013:p0504:b004:l034","ordinal":115318,"en":"They would make king."},{"id":"semetey-1-2013:p0504:b004:l035","ordinal":115319,"en":"I, your mother Kanykei,"},{"id":"semetey-1-2013:p0504:b004:l036","ordinal":115320,"en":"Allah's beloved servant,"},{"id":"semetey-1-2013:p0504:b004:l037","ordinal":115321,"en":"Youngest of twelve girls,"},{"id":"semetey-1-2013:p0504:b004:l038","ordinal":115322,"en":"The beauty among the dark-complexioned,"},{"id":"semetey-1-2013:p0504:b004:l039","ordinal":115323,"en":"The radiant one among Muslims,"},{"id":"semetey-1-2013:p0505:b003:l001","ordinal":115324,"en":"My heart was sorely troubled,"},{"id":"semetey-1-2013:p0505:b003:l002","ordinal":115325,"en":"Tears poured from my eyes."},{"id":"semetey-1-2013:p0505:b003:l003","ordinal":115326,"en":"Burning with shame, seething inside,"},{"id":"semetey-1-2013:p0505:b003:l004","ordinal":115327,"en":"My eyes flashed like a lion's."},{"id":"semetey-1-2013:p0505:b003:l006","ordinal":115328,"en":"For Bukhara's ninety girls","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0505:b003:l007","ordinal":115329,"en":"I held a feast nine days without a pause."},{"id":"semetey-1-2013:p0505:b003:l009","ordinal":115330,"en":"Of this very Bukhara","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0505:b003:l010","ordinal":115331,"en":"I had another road scouted."},{"id":"semetey-1-2013:p0505:b003:l011","ordinal":115332,"en":"“My father's golden throne—"},{"id":"semetey-1-2013:p0505:b003:l012","ordinal":115333,"en":"To Akbaltai's Chubak"},{"id":"semetey-1-2013:p0505:b003:l013","ordinal":115334,"en":"Must I let it be taken by force?"},{"id":"semetey-1-2013:p0505:b003:l014","ordinal":115335,"en":"Let me sink away without bearing a child;"},{"id":"semetey-1-2013:p0505:b003:l015","ordinal":115336,"en":"Rather than bustle about alive,"},{"id":"semetey-1-2013:p0505:b003:l016","ordinal":115337,"en":"Let me behold Judgment Day."},{"id":"semetey-1-2013:p0505:b003:l017","ordinal":115338,"en":"For my father, for my people,"},{"id":"semetey-1-2013:p0505:b003:l018","ordinal":115339,"en":"For the sake of this Bukhara,"},{"id":"semetey-1-2013:p0505:b003:l019","ordinal":115340,"en":"Taking calamity upon my neck,"},{"id":"semetey-1-2013:p0505:b003:l020","ordinal":115341,"en":"I shall pledge my wretched life to this cause"},{"id":"semetey-1-2013:p0505:b003:l022","ordinal":115342,"en":"And try a bout of spears."},{"id":"semetey-1-2013:p0505:b003:l023","ordinal":115343,"en":"If my strength is enough, Chubak's"},{"id":"semetey-1-2013:p0505:b003:l024","ordinal":115344,"en":"Blood I shall pour out as from a flask."},{"id":"semetey-1-2013:p0505:b003:l025","ordinal":115345,"en":"If my strength falls short,"},{"id":"semetey-1-2013:p0505:b003:l026","ordinal":115346,"en":"At the hands of Akbaltai's son"},{"id":"semetey-1-2013:p0505:b003:l027","ordinal":115347,"en":"Let my precious life end,"},{"id":"semetey-1-2013:p0505:b003:l028","ordinal":115348,"en":"Let me behold Judgment Day."},{"id":"semetey-1-2013:p0505:b003:l029","ordinal":115349,"en":"What Allah has written,"},{"id":"semetey-1-2013:p0505:b003:l030","ordinal":115350,"en":"Whatever it is, let me see!”"},{"id":"semetey-1-2013:p0505:b003:l031","ordinal":115351,"en":"Fired with courage, unable to wait,"},{"id":"semetey-1-2013:p0505:b003:l032","ordinal":115352,"en":"My great hair, thick as a girth,"},{"id":"semetey-1-2013:p0505:b003:l033","ordinal":115353,"en":"I bound tightly upon my crown."},{"id":"semetey-1-2013:p0505:b003:l034","ordinal":115354,"en":"Soft coats that bullets could not pierce,"},{"id":"semetey-1-2013:p0505:b003:l035","ordinal":115355,"en":"Lest a bullet strike me,"},{"id":"semetey-1-2013:p0505:b003:l036","ordinal":115356,"en":"Lest death reach me in the shooting—"},{"id":"semetey-1-2013:p0505:b003:l037","ordinal":115357,"en":"Nine layers I put on."},{"id":"semetey-1-2013:p0505:b003:l038","ordinal":115358,"en":"My father Khan Temir's Ak-Kelte"},{"id":"semetey-1-2013:p0505:b003:l039","ordinal":115359,"en":"I hung upon my broad shoulder."},{"id":"semetey-1-2013:p0505:b005:l001","ordinal":115360,"en":"The golden-cheeked battle-axe"},{"id":"semetey-1-2013:p0505:b005:l002","ordinal":115361,"en":"I put upon my bare wrist."},{"id":"semetey-1-2013:p0505:b005:l003","ordinal":115362,"en":"Khan Temir's steel"},{"id":"semetey-1-2013:p0505:b005:l004","ordinal":115363,"en":"I contrived to take unseen."},{"id":"semetey-1-2013:p0505:b005:l005","ordinal":115364,"en":"In my girlhood, wretched me,"},{"id":"semetey-1-2013:p0505:b005:l006","ordinal":115365,"en":"Thinking it over in anguish,"},{"id":"semetey-1-2013:p0505:b005:l007","ordinal":115366,"en":"I put on battle-clothes,"},{"id":"semetey-1-2013:p0505:b005:l008","ordinal":115367,"en":"Apprehensive of that Chubak."},{"id":"semetey-1-2013:p0505:b005:l009","ordinal":115368,"en":"Your mother Kanykei's black, white-blazed thoroughbred—"},{"id":"semetey-1-2013:p0505:b005:l011","ordinal":115369,"en":"I saddled that thoroughbred,"},{"id":"semetey-1-2013:p0505:b005:l012","ordinal":115370,"en":"Girded on keen steel,"},{"id":"semetey-1-2013:p0505:b005:l013","ordinal":115371,"en":"All my battle gear"},{"id":"semetey-1-2013:p0505:b005:l014","ordinal":115372,"en":"I made ready in its place."},{"id":"semetey-1-2013:p0505:b005:l015","ordinal":115373,"en":"Buttoning up my full body,"},{"id":"semetey-1-2013:p0505:b005:l016","ordinal":115374,"en":"My plump red cheeks"},{"id":"semetey-1-2013:p0505:b005:l017","ordinal":115375,"en":"I covered with blue iron."},{"id":"semetey-1-2013:p0505:b005:l018","ordinal":115376,"en":"The banner fluttered in my hand;"},{"id":"semetey-1-2013:p0505:b005:l019","ordinal":115377,"en":"The great black Narkesken sword"},{"id":"semetey-1-2013:p0505:b005:l020","ordinal":115378,"en":"Gleamed at my wrist."},{"id":"semetey-1-2013:p0505:b005:l021","ordinal":115379,"en":"As I went, my heart was troubled;"},{"id":"semetey-1-2013:p0505:b005:l022","ordinal":115380,"en":"My painted spear, some forty fathoms long,"},{"id":"semetey-1-2013:p0505:b005:l023","ordinal":115381,"en":"Showed beneath my knee."},{"id":"semetey-1-2013:p0505:b005:l024","ordinal":115382,"en":"Wearing out my horse, scouting the land,"},{"id":"semetey-1-2013:p0505:b005:l025","ordinal":115383,"en":"With Khan Baltai's Chubak"},{"id":"semetey-1-2013:p0505:b005:l026","ordinal":115384,"en":"I resolved to fight to the death."},{"id":"semetey-1-2013:p0505:b005:l027","ordinal":115385,"en":"“I shall find the slave on the mountain slope,” I thought."},{"id":"semetey-1-2013:p0505:b005:l028","ordinal":115386,"en":"He alone, I alone,"},{"id":"semetey-1-2013:p0505:b005:l029","ordinal":115387,"en":"With Akbaltai's lion"},{"id":"semetey-1-2013:p0505:b005:l030","ordinal":115388,"en":"I would try a bout of spears."},{"id":"semetey-1-2013:p0505:b005:l031","ordinal":115389,"en":"“If I am speared by Chubak,"},{"id":"semetey-1-2013:p0505:b005:l032","ordinal":115390,"en":"Without letting a soul know,"},{"id":"semetey-1-2013:p0505:b005:l033","ordinal":115391,"en":"Without letting one person discover it,"},{"id":"semetey-1-2013:p0505:b005:l034","ordinal":115392,"en":"I shall submit to his demand,” I thought."},{"id":"semetey-1-2013:p0505:b005:l035","ordinal":115393,"en":"“As a gift, Bukhara's"},{"id":"semetey-1-2013:p0505:b005:l036","ordinal":115394,"en":"Golden throne I shall give,” I thought."},{"id":"semetey-1-2013:p0505:b005:l037","ordinal":115395,"en":"“If I spear Chubak,"},{"id":"semetey-1-2013:p0505:b005:l038","ordinal":115396,"en":"I shall bring disgrace upon his head,"},{"id":"semetey-1-2013:p0505:b005:l039","ordinal":115397,"en":"Drag him onto the road,"}]
