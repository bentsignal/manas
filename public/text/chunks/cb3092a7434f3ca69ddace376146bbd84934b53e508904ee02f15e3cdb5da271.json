[{"id":"manas-2010:p0417:b001:l016","ordinal":19201,"en":"“My ruler Esen sent us;"},{"id":"manas-2010:p0417:b001:l017","ordinal":19202,"en":"How can we leave without fighting?"},{"id":"manas-2010:p0417:b001:l018","ordinal":19203,"en":"If we should leave without fighting,"},{"id":"manas-2010:p0417:b001:l019","ordinal":19204,"en":"'You returned in fear of Manas,' he will say;"},{"id":"manas-2010:p0417:b001:l020","ordinal":19205,"en":"Our lord Khan Esenkan"},{"id":"manas-2010:p0417:b001:l021","ordinal":19206,"en":"May suddenly slaughter us."},{"id":"manas-2010:p0417:b001:l022","ordinal":19207,"en":"Before this, when Esenkan"},{"id":"manas-2010:p0417:b001:l023","ordinal":19208,"en":"Gave his terrible order,"},{"id":"manas-2010:p0417:b001:l024","ordinal":19209,"en":"Giant Kaman and champion Döngö were there."},{"id":"manas-2010:p0417:b001:l025","ordinal":19210,"en":"Against that Burut—may his house burn!—"},{"id":"manas-2010:p0417:b001:l026","ordinal":19211,"en":"Many of us rushed recklessly;"},{"id":"manas-2010:p0417:b001:l027","ordinal":19212,"en":"We swarmed in and fought."},{"id":"manas-2010:p0417:b001:l028","ordinal":19213,"en":"To seize and bind the Burut,"},{"id":"manas-2010:p0417:b001:l029","ordinal":19214,"en":"Fierce wrath broke out."},{"id":"manas-2010:p0417:b001:l030","ordinal":19215,"en":"Your giants Döngö and Kaman,"},{"id":"manas-2010:p0417:b001:l031","ordinal":19216,"en":"He slaughtered them utterly."},{"id":"manas-2010:p0417:b001:l032","ordinal":19217,"en":"He brought great affliction;"},{"id":"manas-2010:p0417:b001:l033","ordinal":19218,"en":"Having the Kalmyks slaughtered,"},{"id":"manas-2010:p0417:b001:l034","ordinal":19219,"en":"He did whatever he pleased."},{"id":"manas-2010:p0417:b001:l035","ordinal":19220,"en":"Against the Kalmyk who fell captive,"},{"id":"manas-2010:p0417:b001:l036","ordinal":19221,"en":"He unleashed terrible wrath;"},{"id":"manas-2010:p0417:b001:l037","ordinal":19222,"en":"Inflicting cruel humiliation,"},{"id":"manas-2010:p0417:b001:l038","ordinal":19223,"en":"He cut off his testicles."},{"id":"manas-2010:p0417:b001:l039","ordinal":19224,"en":"He brought threefold turmoil at once."},{"id":"manas-2010:p0417:b001:l040","ordinal":19225,"en":"Not merely my horses, that Burut"},{"id":"manas-2010:p0417:b001:l041","ordinal":19226,"en":"Raided and took my cattle."},{"id":"manas-2010:p0417:b001:l042","ordinal":19227,"en":"Against this bloodstained one myself,"},{"id":"manas-2010:p0417:b001:l043","ordinal":19228,"en":"I attacked and learned suffering."},{"id":"manas-2010:p0417:b001:l044","ordinal":19229,"en":"If I were my own master,"},{"id":"manas-2010:p0417:b001:l045","ordinal":19230,"en":"I would not attack the bloodstained one."},{"id":"manas-2010:p0417:b001:l046","ordinal":19231,"en":"I myself would not grapple"},{"id":"manas-2010:p0417:b001:l047","ordinal":19232,"en":"With such a deceiver.”"},{"id":"manas-2010:p0417:b001:l048","ordinal":19233,"en":"Ezkara judged him and grieved;"},{"id":"manas-2010:p0418:b001:l001","ordinal":19234,"en":"The many soldiers who had swarmed there"},{"id":"manas-2010:p0418:b001:l002","ordinal":19235,"en":"Despaired of their precious lives."},{"id":"manas-2010:p0418:b001:l003","ordinal":19236,"en":"Bells rang fiercely;"},{"id":"manas-2010:p0418:b001:l004","ordinal":19237,"en":"The army lost its senses."},{"id":"manas-2010:p0418:b001:l005","ordinal":19238,"en":"To force gray-maned Manas to crouch,"},{"id":"manas-2010:p0418:b001:l006","ordinal":19239,"en":"The many lords prepared to overwhelm him."},{"id":"manas-2010:p0418:b001:l007","ordinal":19240,"en":"Those swaggering unbelievers,"},{"id":"manas-2010:p0418:b001:l008","ordinal":19241,"en":"After Esenkan gave his order,"},{"id":"manas-2010:p0418:b001:l009","ordinal":19242,"en":"From Chynmachyn and Beejin,"},{"id":"manas-2010:p0418:b001:l010","ordinal":19243,"en":"Many heroes had arrived."},{"id":"manas-2010:p0418:b001:l011","ordinal":19244,"en":"Loading ammunition on rhinoceroses,"},{"id":"manas-2010:p0418:b001:l012","ordinal":19245,"en":"Sounding trumpets and shawms,"},{"id":"manas-2010:p0418:b001:l013","ordinal":19246,"en":"Would those who came stand watching?"},{"id":"manas-2010:p0418:b001:l014","ordinal":19247,"en":"Without beginning battle and raising strife,"},{"id":"manas-2010:p0418:b001:l015","ordinal":19248,"en":"Would God strike the Kytay down?"},{"id":"manas-2010:p0418:b001:l016","ordinal":19249,"en":"They had taken orders from their khan;"},{"id":"manas-2010:p0418:b001:l017","ordinal":19250,"en":"Esenkan was their ruler,"},{"id":"manas-2010:p0418:b001:l018","ordinal":19251,"en":"They had sworn solemn oaths."},{"id":"manas-2010:p0418:b001:l019","ordinal":19252,"en":"His blood-drinking champions,"},{"id":"manas-2010:p0418:b001:l020","ordinal":19253,"en":"Raising tumult and clamor,"},{"id":"manas-2010:p0418:b001:l021","ordinal":19254,"en":"Set off in a sweeping charge."},{"id":"manas-2010:p0418:b001:l022","ordinal":19255,"en":"As his people migrated from Altay,"},{"id":"manas-2010:p0418:b001:l023","ordinal":19256,"en":"Such was the bloodstained hero's battle."},{"id":"manas-2010:p0418:b001:l024","ordinal":19257,"en":"The Kytay intended to reach him,"},{"id":"manas-2010:p0418:b001:l025","ordinal":19258,"en":"That bloodstained one born fierce,"},{"id":"manas-2010:p0418:b001:l026","ordinal":19259,"en":"To crush him and pass on,"},{"id":"manas-2010:p0418:b001:l027","ordinal":19260,"en":"If they had the strength to fight,"},{"id":"manas-2010:p0418:b001:l028","ordinal":19261,"en":"To bind him and take him to the Kakan."},{"id":"manas-2010:p0418:b001:l029","ordinal":19262,"en":"They had foot soldiers no horse could carry,"},{"id":"manas-2010:p0418:b001:l030","ordinal":19263,"en":"They had giants and mighty men."},{"id":"manas-2010:p0418:b001:l031","ordinal":19264,"en":"Straining as though rabid,"},{"id":"manas-2010:p0418:b001:l032","ordinal":19265,"en":"Their champions held in collars,"},{"id":"manas-2010:p0418:b001:l033","ordinal":19266,"en":"Upon the gray-maned one touched by Khizir,"},{"id":"manas-2010:p0418:b001:l034","ordinal":19267,"en":"They swarmed and rushed."},{"id":"manas-2010:p0418:b001:l035","ordinal":19268,"en":"Karazhoy, the great marksman,"},{"id":"manas-2010:p0418:b001:l036","ordinal":19269,"en":"Gathered his army and drove it hard;"},{"id":"manas-2010:p0418:b001:l037","ordinal":19270,"en":"He hurried his swift foot soldiers"},{"id":"manas-2010:p0418:b001:l038","ordinal":19271,"en":"And prepared along the bluff."},{"id":"manas-2010:p0418:b001:l039","ordinal":19272,"en":"Black-maned Boroonchu,"},{"id":"manas-2010:p0418:b001:l040","ordinal":19273,"en":"The champion who struck with an iron-headed mace,"},{"id":"manas-2010:p0418:b001:l041","ordinal":19274,"en":"Took a thousand chosen troops."},{"id":"manas-2010:p0418:b001:l042","ordinal":19275,"en":"Toward your bloodstained hero"},{"id":"manas-2010:p0418:b001:l043","ordinal":19276,"en":"He advanced in a sweeping charge."},{"id":"manas-2010:p0418:b001:l044","ordinal":19277,"en":"Zholoy of the Kalmyks,"},{"id":"manas-2010:p0418:b001:l045","ordinal":19278,"en":"Deft and skilled with the spear,"},{"id":"manas-2010:p0418:b001:l046","ordinal":19279,"en":"Drove them onward without resting,"},{"id":"manas-2010:p0418:b001:l047","ordinal":19280,"en":"An excellent, expert spearman."},{"id":"manas-2010:p0418:b001:l048","ordinal":19281,"en":"Great Döödür, riding a rhinoceros,"},{"id":"manas-2010:p0419:b001:l001","ordinal":19282,"en":"Rejoiced at the word of battle."},{"id":"manas-2010:p0419:b001:l002","ordinal":19283,"en":"Such was that one accursed to be crushed:"},{"id":"manas-2010:p0419:b001:l003","ordinal":19284,"en":"Clad in deep-blue iron,"},{"id":"manas-2010:p0419:b001:l004","ordinal":19285,"en":"He rejoiced at the cry of 'Enemy!'"},{"id":"manas-2010:p0419:b001:l005","ordinal":19286,"en":"Told to drink water, he drank poison;"},{"id":"manas-2010:p0419:b001:l006","ordinal":19287,"en":"He never drew back in fear of a man,"},{"id":"manas-2010:p0419:b001:l007","ordinal":19288,"en":"He never retreated from death."},{"id":"manas-2010:p0419:b001:l008","ordinal":19289,"en":"Their champions were renowned;"},{"id":"manas-2010:p0419:b001:l009","ordinal":19290,"en":"Facing one another,"},{"id":"manas-2010:p0419:b001:l010","ordinal":19291,"en":"They prepared to meet in battle."},{"id":"manas-2010:p0419:b001:l011","ordinal":19292,"en":"Drawing bows to rain arrows,"},{"id":"manas-2010:p0419:b001:l012","ordinal":19293,"en":"They prepared to fall upon Manas,"},{"id":"manas-2010:p0419:b001:l013","ordinal":19294,"en":"Firing shot like hail."},{"id":"manas-2010:p0419:b001:l014","ordinal":19295,"en":"They had outstanding men and giants;"},{"id":"manas-2010:p0419:b001:l015","ordinal":19296,"en":"Overwhelming the enemy in battle"},{"id":"manas-2010:p0419:b001:l016","ordinal":19297,"en":"Was their custom."},{"id":"manas-2010:p0419:b001:l017","ordinal":19298,"en":"Riding rhinoceroses and elephants,"},{"id":"manas-2010:p0419:b001:l018","ordinal":19299,"en":"The mighty ones had arrived."},{"id":"manas-2010:p0419:b001:l019","ordinal":19300,"en":"Firing guns and drawing bows,"},{"id":"manas-2010:p0419:b001:l020","ordinal":19301,"en":"They were esteemed for marksmanship."},{"id":"manas-2010:p0419:b001:l021","ordinal":19302,"en":"When a black gun crashed,"},{"id":"manas-2010:p0419:b001:l022","ordinal":19303,"en":"They had warriors who would not flee;"},{"id":"manas-2010:p0419:b001:l023","ordinal":19304,"en":"When a fierce gun cracked,"},{"id":"manas-2010:p0419:b001:l024","ordinal":19305,"en":"They had warriors who would not startle."},{"id":"manas-2010:p0419:b001:l025","ordinal":19306,"en":"From their great khan's presence,"},{"id":"manas-2010:p0419:b001:l026","ordinal":19307,"en":"To bring Manas bound,"},{"id":"manas-2010:p0419:b001:l027","ordinal":19308,"en":"To present him as a gift,"},{"id":"manas-2010:p0419:b001:l028","ordinal":19309,"en":"They had made thorough preparations."},{"id":"manas-2010:p0419:b001:l029","ordinal":19310,"en":"Giants no horse could carry,"},{"id":"manas-2010:p0419:b001:l030","ordinal":19311,"en":"Esenkan had sent them,"},{"id":"manas-2010:p0419:b001:l031","ordinal":19312,"en":"Footmen swifter than horses."},{"id":"manas-2010:p0419:b001:l032","ordinal":19313,"en":"Khans who would face him,"},{"id":"manas-2010:p0419:b001:l033","ordinal":19314,"en":"Esenkan had sent them;"},{"id":"manas-2010:p0419:b001:l034","ordinal":19315,"en":"Beyond any man's strength,"},{"id":"manas-2010:p0419:b001:l035","ordinal":19316,"en":"Champions like Ala-Too."},{"id":"manas-2010:p0419:b001:l036","ordinal":19317,"en":"Like bulls fattened in summer,"},{"id":"manas-2010:p0419:b001:l037","ordinal":19318,"en":"He sent his great hulking men;"},{"id":"manas-2010:p0419:b001:l038","ordinal":19319,"en":"Half a mountain in size,"},{"id":"manas-2010:p0419:b001:l039","ordinal":19320,"en":"He sent his towering men."},{"id":"manas-2010:p0419:b001:l040","ordinal":19321,"en":"Terrible slaughter in battle,"},{"id":"manas-2010:p0419:b001:l041","ordinal":19322,"en":"He sent those who would wreak it;"},{"id":"manas-2010:p0419:b001:l042","ordinal":19323,"en":"Simply binding whomever they looked upon,"},{"id":"manas-2010:p0419:b001:l043","ordinal":19324,"en":"He sent those who would seize them."},{"id":"manas-2010:p0419:b001:l044","ordinal":19325,"en":"Facing toward Manas,"},{"id":"manas-2010:p0419:b001:l045","ordinal":19326,"en":"All raised their spears."},{"id":"manas-2010:p0419:b001:l046","ordinal":19327,"en":"Now they unleashed fierce wrath;"},{"id":"manas-2010:p0419:b001:l047","ordinal":19328,"en":"Drawing bows to rain arrows,"},{"id":"manas-2010:p0419:b001:l048","ordinal":19329,"en":"They advanced in a sweeping charge!"}]
