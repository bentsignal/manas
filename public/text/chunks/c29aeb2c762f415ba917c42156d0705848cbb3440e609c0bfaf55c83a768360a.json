[{"id":"semetey-1-2013:p1263:b004:l021","ordinal":173569,"en":"They would simply overrun the land,"},{"id":"semetey-1-2013:p1263:b004:l022","ordinal":173570,"en":"Bring turmoil upon this poor head,"},{"id":"semetey-1-2013:p1263:b004:l023","ordinal":173571,"en":"And reach the very root;"},{"id":"semetey-1-2013:p1263:b004:l024","ordinal":173572,"en":"They would overwhelm and carry off"},{"id":"semetey-1-2013:p1263:b004:l025","ordinal":173573,"en":"Chürök, daughter of Akun."},{"id":"semetey-1-2013:p1263:b004:l026","ordinal":173574,"en":"Men swarmed in rage,"},{"id":"semetey-1-2013:p1263:b004:l027","ordinal":173575,"en":"Soldiers teemed everywhere;"},{"id":"semetey-1-2013:p1263:b004:l028","ordinal":173576,"en":"A myriad host came"},{"id":"semetey-1-2013:p1263:b004:l029","ordinal":173577,"en":"To cover Khan Akun’s fortress."},{"id":"semetey-1-2013:p1263:b004:l030","ordinal":173578,"en":"Their thick-armed wrestlers,"},{"id":"semetey-1-2013:p1263:b004:l031","ordinal":173579,"en":"The snarling Jediger,"},{"id":"semetey-1-2013:p1263:b004:l032","ordinal":173580,"en":"Advanced and covered the front."},{"id":"semetey-1-2013:p1263:b004:l033","ordinal":173581,"en":"When the many Black Jediger"},{"id":"semetey-1-2013:p1263:b004:l034","ordinal":173582,"en":"Were about to overwhelm and carry them off,"},{"id":"semetey-1-2013:p1263:b004:l035","ordinal":173583,"en":"Black blood flowing in torrents,"},{"id":"semetey-1-2013:p1263:b004:l036","ordinal":173584,"en":"And the people turning back to cross,"},{"id":"semetey-1-2013:p1263:b004:l037","ordinal":173585,"en":"A coat of mail with golden collar"},{"id":"semetey-1-2013:p1263:b004:l038","ordinal":173586,"en":"Glittered upon a breast;"},{"id":"semetey-1-2013:p1263:b004:l039","ordinal":173587,"en":"The gray kise that fell from heaven,"},{"id":"semetey-1-2013:p1264:b003:l001","ordinal":173588,"en":"A kise that befriended the dear soul,"},{"id":"semetey-1-2013:p1264:b003:l002","ordinal":173589,"en":"When he shouted and buckled it at his waist,"},{"id":"semetey-1-2013:p1264:b003:l003","ordinal":173590,"en":"The Forty Saints became his companions."},{"id":"semetey-1-2013:p1264:b003:l004","ordinal":173591,"en":"When he cried aloud and buckled it on,"},{"id":"semetey-1-2013:p1264:b003:l005","ordinal":173592,"en":"Before the valiant hero"},{"id":"semetey-1-2013:p1264:b003:l006","ordinal":173593,"en":"A lion came roaming."},{"id":"semetey-1-2013:p1264:b003:l007","ordinal":173594,"en":"The gray kise that fell from heaven,"},{"id":"semetey-1-2013:p1264:b003:l008","ordinal":173595,"en":"From his father, gray-wolf Manas,"},{"id":"semetey-1-2013:p1264:b003:l009","ordinal":173596,"en":"A companion-kise left especially to him."},{"id":"semetey-1-2013:p1264:b003:l010","ordinal":173597,"en":"The gray kise that went with him"},{"id":"semetey-1-2013:p1264:b003:l011","ordinal":173598,"en":"To unleash relentless havoc."},{"id":"semetey-1-2013:p1264:b003:l012","ordinal":173599,"en":"Yesterday, when your valiant mother Kanykei"},{"id":"semetey-1-2013:p1264:b003:l013","ordinal":173600,"en":"Fled toward Bukhara,"},{"id":"semetey-1-2013:p1264:b003:l014","ordinal":173601,"en":"When her wealth was scattered,"},{"id":"semetey-1-2013:p1264:b003:l015","ordinal":173602,"en":"Saying, “May my valiant son Semetey"},{"id":"semetey-1-2013:p1264:b003:l016","ordinal":173603,"en":"Take this along as a gift,”"},{"id":"semetey-1-2013:p1264:b003:l017","ordinal":173604,"en":"Grieving and weeping in sorrow,"},{"id":"semetey-1-2013:p1264:b003:l018","ordinal":173605,"en":"She girded it against her inner flesh—"},{"id":"semetey-1-2013:p1264:b003:l019","ordinal":173606,"en":"This was the kise she took with her."},{"id":"semetey-1-2013:p1264:b003:l020","ordinal":173607,"en":"Weeping bitterly to the one God,"},{"id":"semetey-1-2013:p1264:b003:l021","ordinal":173608,"en":"Destining it for Semetey,"},{"id":"semetey-1-2013:p1264:b003:l022","ordinal":173609,"en":"She took along the gray kise."},{"id":"semetey-1-2013:p1264:b003:l023","ordinal":173610,"en":"When over Akolpok"},{"id":"semetey-1-2013:p1264:b003:l024","ordinal":173611,"en":"He buckled the gray kise,"},{"id":"semetey-1-2013:p1264:b003:l025","ordinal":173612,"en":"The sight stirred the heart;"},{"id":"semetey-1-2013:p1264:b003:l026","ordinal":173613,"en":"He looked like a lion."},{"id":"semetey-1-2013:p1264:b003:l027","ordinal":173614,"en":"A black-mottled leopard"},{"id":"semetey-1-2013:p1264:b003:l028","ordinal":173615,"en":"Raged at his flank,"},{"id":"semetey-1-2013:p1264:b003:l029","ordinal":173616,"en":"And a stunted gray-wolf lion"},{"id":"semetey-1-2013:p1264:b003:l030","ordinal":173617,"en":"Was found as his companion."},{"id":"semetey-1-2013:p1264:b003:l031","ordinal":173618,"en":"From his mouth blue flame"},{"id":"semetey-1-2013:p1264:b003:l032","ordinal":173619,"en":"Poured like a loaded gun;"},{"id":"semetey-1-2013:p1264:b003:l033","ordinal":173620,"en":"His dear teeth, broad as a gate,"},{"id":"semetey-1-2013:p1264:b003:l034","ordinal":173621,"en":"Showed apart like grains of millet."},{"id":"semetey-1-2013:p1264:b003:l035","ordinal":173622,"en":"The breath leaving his nostrils"},{"id":"semetey-1-2013:p1264:b003:l036","ordinal":173623,"en":"Was like burning red embers;"},{"id":"semetey-1-2013:p1264:b003:l037","ordinal":173624,"en":"His two eyes flamed,"},{"id":"semetey-1-2013:p1264:b003:l038","ordinal":173625,"en":"Fire that could burn all away."},{"id":"semetey-1-2013:p1264:b003:l039","ordinal":173626,"en":"Generation after generation,"},{"id":"semetey-1-2013:p1264:b004:l001","ordinal":173627,"en":"He came from a blood-drinking line,"},{"id":"semetey-1-2013:p1264:b004:l002","ordinal":173628,"en":"Setting grassy ground alight,"},{"id":"semetey-1-2013:p1264:b004:l003","ordinal":173629,"en":"Setting fire to meadowland."},{"id":"semetey-1-2013:p1264:b004:l004","ordinal":173630,"en":"From Manas, gone to the other world,"},{"id":"semetey-1-2013:p1264:b004:l005","ordinal":173631,"en":"Semetey was born to surpass him;"},{"id":"semetey-1-2013:p1264:b004:l006","ordinal":173632,"en":"When fury seized him,"},{"id":"semetey-1-2013:p1264:b004:l007","ordinal":173633,"en":"His face utterly changed."},{"id":"semetey-1-2013:p1264:b004:l008","ordinal":173634,"en":"The gray wolf’s courage overflowed,"},{"id":"semetey-1-2013:p1264:b004:l009","ordinal":173635,"en":"And his blood-drinking aspect appeared."},{"id":"semetey-1-2013:p1264:b004:l010","ordinal":173636,"en":"When hardship pressed a living soul,"},{"id":"semetey-1-2013:p1264:b004:l011","ordinal":173637,"en":"He took whatever he faced;"},{"id":"semetey-1-2013:p1264:b004:l012","ordinal":173638,"en":"When he struck in fury,"},{"id":"semetey-1-2013:p1264:b004:l013","ordinal":173639,"en":"Heads were cut away;"},{"id":"semetey-1-2013:p1264:b004:l014","ordinal":173640,"en":"For anyone who came against him,"},{"id":"semetey-1-2013:p1264:b004:l015","ordinal":173641,"en":"Death arrived needlessly."},{"id":"semetey-1-2013:p1264:b004:l016","ordinal":173642,"en":"Of the six sharp blades fallen from heaven,"},{"id":"semetey-1-2013:p1264:b004:l017","ordinal":173643,"en":"The keenest sword"},{"id":"semetey-1-2013:p1264:b004:l018","ordinal":173644,"en":"Was Zulpukor, taken by Manas."},{"id":"semetey-1-2013:p1264:b004:l019","ordinal":173645,"en":"When his father Manas died,"},{"id":"semetey-1-2013:p1264:b004:l020","ordinal":173646,"en":"When Kanykei suffered plunder,"},{"id":"semetey-1-2013:p1264:b004:l021","ordinal":173647,"en":"Into the hands of the six villains"},{"id":"semetey-1-2013:p1264:b004:l022","ordinal":173648,"en":"Zulpukor fell as spoil."},{"id":"semetey-1-2013:p1264:b004:l023","ordinal":173649,"en":"The heroic orphan of Khan Manas"},{"id":"semetey-1-2013:p1264:b004:l024","ordinal":173650,"en":"Grew to manhood while orphaned,"},{"id":"semetey-1-2013:p1264:b004:l025","ordinal":173651,"en":"Rejoined his own land,"},{"id":"semetey-1-2013:p1264:b004:l026","ordinal":173652,"en":"Grew imposing and became a hero,"},{"id":"semetey-1-2013:p1264:b004:l027","ordinal":173653,"en":"Equal to the sons of the people."},{"id":"semetey-1-2013:p1264:b004:l028","ordinal":173654,"en":"When he came and saw his people,"},{"id":"semetey-1-2013:p1264:b004:l029","ordinal":173655,"en":"When he came to Abyke,"},{"id":"semetey-1-2013:p1264:b004:l030","ordinal":173656,"en":"At Köbösh’s palace,"},{"id":"semetey-1-2013:p1264:b004:l031","ordinal":173657,"en":"Had he not unleashed"},{"id":"semetey-1-2013:p1264:b004:l032","ordinal":173658,"en":"Surpassing havoc?"},{"id":"semetey-1-2013:p1264:b004:l033","ordinal":173659,"en":"Saying, “This is the treasure left by my father,”"},{"id":"semetey-1-2013:p1264:b004:l034","ordinal":173660,"en":"Had not the valiant prince Semetey"},{"id":"semetey-1-2013:p1264:b004:l035","ordinal":173661,"en":"Seized it back?"},{"id":"semetey-1-2013:p1264:b004:l036","ordinal":173662,"en":"Zulpukor, left as a gift"},{"id":"semetey-1-2013:p1264:b004:l037","ordinal":173663,"en":"By valiant gray-wolf Manas—"},{"id":"semetey-1-2013:p1264:b004:l038","ordinal":173664,"en":"When drawn from its sheath with a cry,"},{"id":"semetey-1-2013:p1264:b004:l039","ordinal":173665,"en":"It never went idle without drinking blood."},{"id":"semetey-1-2013:p1265:b003:l001","ordinal":173666,"en":"Unless it drank its fill of blood,"},{"id":"semetey-1-2013:p1265:b003:l002","ordinal":173667,"en":"It did not return to the sheath."},{"id":"semetey-1-2013:p1265:b003:l003","ordinal":173668,"en":"When swung, it lengthened;"},{"id":"semetey-1-2013:p1265:b003:l004","ordinal":173669,"en":"Its edge reddened like an ember."},{"id":"semetey-1-2013:p1265:b003:l005","ordinal":173670,"en":"It did not recoil from stone,"},{"id":"semetey-1-2013:p1265:b003:l006","ordinal":173671,"en":"And when struck in fury,"},{"id":"semetey-1-2013:p1265:b003:l007","ordinal":173672,"en":"It did not turn back from iron."},{"id":"semetey-1-2013:p1265:b003:l008","ordinal":173673,"en":"When Manas held dominion"},{"id":"semetey-1-2013:p1265:b003:l009","ordinal":173674,"en":"Across the surface of the earth,"},{"id":"semetey-1-2013:p1265:b003:l010","ordinal":173675,"en":"Whoever stirred his anger,"},{"id":"semetey-1-2013:p1265:b003:l011","ordinal":173676,"en":"Manas did not let escape before him."},{"id":"semetey-1-2013:p1265:b003:l012","ordinal":173677,"en":"While ravenous Manas lived,"},{"id":"semetey-1-2013:p1265:b003:l013","ordinal":173678,"en":"From blessed gray-wolf Manas"},{"id":"semetey-1-2013:p1265:b003:l014","ordinal":173679,"en":"It hardened, sated with blood,"},{"id":"semetey-1-2013:p1265:b003:l015","ordinal":173680,"en":"And became renowned as Zulpukor."},{"id":"semetey-1-2013:p1265:b003:l016","ordinal":173681,"en":"Its edge was steel, its sheath keen—"},{"id":"semetey-1-2013:p1265:b003:l017","ordinal":173682,"en":"That single treasure inherited"},{"id":"semetey-1-2013:p1265:b003:l018","ordinal":173683,"en":"From his father, gray-wolf Manas,"},{"id":"semetey-1-2013:p1265:b003:l019","ordinal":173684,"en":"To draw while facing"},{"id":"semetey-1-2013:p1265:b003:l020","ordinal":173685,"en":"Khojo who challenged him;"},{"id":"semetey-1-2013:p1265:b003:l021","ordinal":173686,"en":"The lion, if strength allowed,"},{"id":"semetey-1-2013:p1265:b003:l022","ordinal":173687,"en":"Would hew down with the sword"},{"id":"semetey-1-2013:p1265:b003:l023","ordinal":173688,"en":"Khojo who came to confront him,"},{"id":"semetey-1-2013:p1265:b003:l024","ordinal":173689,"en":"Slaughter his people,"},{"id":"semetey-1-2013:p1265:b003:l025","ordinal":173690,"en":"And unleash mighty conflict,"},{"id":"semetey-1-2013:p1265:b003:l026","ordinal":173691,"en":"Taking undying vengeance"},{"id":"semetey-1-2013:p1265:b003:l027","ordinal":173692,"en":"Upon Khojo, who attacked first."},{"id":"semetey-1-2013:p1265:b003:l028","ordinal":173693,"en":"At his courage, the Afghans"},{"id":"semetey-1-2013:p1265:b003:l029","ordinal":173694,"en":"Fled in a clattering rout."},{"id":"semetey-1-2013:p1265:b003:l030","ordinal":173695,"en":"The sight stirred the heart;"},{"id":"semetey-1-2013:p1265:b003:l031","ordinal":173696,"en":"That gray wolf’s only son"},{"id":"semetey-1-2013:p1265:b003:l032","ordinal":173697,"en":"Revealed the aspect of a lion."},{"id":"semetey-1-2013:p1265:b003:l033","ordinal":173698,"en":"High-browed and stone-hearted,"},{"id":"semetey-1-2013:p1265:b003:l034","ordinal":173699,"en":"He brought the Jediger great turmoil."},{"id":"semetey-1-2013:p1265:b003:l035","ordinal":173700,"en":"Akkelte at his shoulder—"},{"id":"semetey-1-2013:p1265:b003:l036","ordinal":173701,"en":"When the blessed weapon was slung on,"},{"id":"semetey-1-2013:p1265:b003:l037","ordinal":173702,"en":"It was a mirror upon the shoulder;"},{"id":"semetey-1-2013:p1265:b003:l038","ordinal":173703,"en":"When fired into clashing battle,"},{"id":"semetey-1-2013:p1265:b003:l039","ordinal":173704,"en":"It was comfort for the entrusted life."},{"id":"semetey-1-2013:p1265:b005:l001","ordinal":173705,"en":"In sport it was Ochogor,"},{"id":"semetey-1-2013:p1265:b005:l002","ordinal":173706,"en":"In earnest it was Koichagyr;"},{"id":"semetey-1-2013:p1265:b005:l003","ordinal":173707,"en":"When he turned and fired, it broke ranks."},{"id":"semetey-1-2013:p1265:b005:l004","ordinal":173708,"en":"Akkelte had a nature all its own."},{"id":"semetey-1-2013:p1265:b005:l005","ordinal":173709,"en":"That was the joined iron weapon,"},{"id":"semetey-1-2013:p1265:b005:l006","ordinal":173710,"en":"The treasure left as a gift"},{"id":"semetey-1-2013:p1265:b005:l007","ordinal":173711,"en":"By valiant Sultan Manas."},{"id":"semetey-1-2013:p1265:b005:l008","ordinal":173712,"en":"Its voice thundered unlike any other;"},{"id":"semetey-1-2013:p1265:b005:l009","ordinal":173713,"en":"No mortal faced it and came on."},{"id":"semetey-1-2013:p1265:b005:l010","ordinal":173714,"en":"When he heard Akkelte’s voice,"},{"id":"semetey-1-2013:p1265:b005:l011","ordinal":173715,"en":"Kongurbai of Kakan scattered all his wealth"},{"id":"semetey-1-2013:p1265:b005:l012","ordinal":173716,"en":"And fled all the way"},{"id":"semetey-1-2013:p1265:b005:l013","ordinal":173717,"en":"To Beijing."},{"id":"semetey-1-2013:p1265:b005:l014","ordinal":173718,"en":"Wrapped with agyinek,"},{"id":"semetey-1-2013:p1265:b005:l015","ordinal":173719,"en":"When there was a foe to fight,"},{"id":"semetey-1-2013:p1265:b005:l016","ordinal":173720,"en":"It was fitted and destined for him."},{"id":"semetey-1-2013:p1265:b005:l017","ordinal":173721,"en":"Almabash, surpassingly keen iron,"},{"id":"semetey-1-2013:p1265:b005:l018","ordinal":173722,"en":"Made no distinction between far and near;"},{"id":"semetey-1-2013:p1265:b005:l019","ordinal":173723,"en":"In the hardest battle,"},{"id":"semetey-1-2013:p1265:b005:l020","ordinal":173724,"en":"It did not fail for sixty days."},{"id":"semetey-1-2013:p1265:b005:l021","ordinal":173725,"en":"Yesterday, while bloodthirsty Manas lived,"},{"id":"semetey-1-2013:p1265:b005:l022","ordinal":173726,"en":"Before lion Bakai,"},{"id":"semetey-1-2013:p1265:b005:l023","ordinal":173727,"en":"Your uncle Lord Bakai—"},{"id":"semetey-1-2013:p1265:b005:l024","ordinal":173728,"en":"Behold his lordly nature—"},{"id":"semetey-1-2013:p1265:b005:l025","ordinal":173729,"en":"On a plain flat as a blade, without mountains,"},{"id":"semetey-1-2013:p1265:b005:l026","ordinal":173730,"en":"At the great Russian city,"},{"id":"semetey-1-2013:p1265:b005:l027","ordinal":173731,"en":"Your uncle lion Bakai"},{"id":"semetey-1-2013:p1265:b005:l028","ordinal":173732,"en":"Was imposing his tribute."},{"id":"semetey-1-2013:p1265:b005:l029","ordinal":173733,"en":"The Russians caused immense devastation"},{"id":"semetey-1-2013:p1265:b005:l030","ordinal":173734,"en":"And stole from Bakai"},{"id":"semetey-1-2013:p1265:b005:l031","ordinal":173735,"en":"His treasury."},{"id":"semetey-1-2013:p1265:b005:l032","ordinal":173736,"en":"Hero Manas, whom he had brought,"},{"id":"semetey-1-2013:p1265:b005:l033","ordinal":173737,"en":"And dear, distinguished Bakai"},{"id":"semetey-1-2013:p1265:b005:l034","ordinal":173738,"en":"Surrounded the Russians."},{"id":"semetey-1-2013:p1265:b005:l035","ordinal":173739,"en":"Saying, “Submit to what we demand;"},{"id":"semetey-1-2013:p1265:b005:l036","ordinal":173740,"en":"You have taken the treasury."},{"id":"semetey-1-2013:p1265:b005:l037","ordinal":173741,"en":"Without conflict or quarrel,"},{"id":"semetey-1-2013:p1265:b005:l038","ordinal":173742,"en":"Give us Akkelte."},{"id":"semetey-1-2013:p1265:b005:l039","ordinal":173743,"en":"I was alone; now I am many,"},{"id":"semetey-1-2013:p1266:b003:l001","ordinal":173744,"en":"I was weak; now I am a hero."},{"id":"semetey-1-2013:p1266:b003:l002","ordinal":173745,"en":"Submit to what we demand"},{"id":"semetey-1-2013:p1266:b003:l003","ordinal":173746,"en":"And give us Akkelte!”"},{"id":"semetey-1-2013:p1266:b003:l004","ordinal":173747,"en":"Against Kerke, khan of the Russians,"},{"id":"semetey-1-2013:p1266:b003:l005","ordinal":173748,"en":"They brought overwhelming force;"},{"id":"semetey-1-2013:p1266:b003:l006","ordinal":173749,"en":"Saying, “Give us Akkelte,”"},{"id":"semetey-1-2013:p1266:b003:l007","ordinal":173750,"en":"Lion Bakai the leopard"},{"id":"semetey-1-2013:p1266:b003:l008","ordinal":173751,"en":"Pressed the siege hard."},{"id":"semetey-1-2013:p1266:b003:l009","ordinal":173752,"en":"Wise Khan Kerke"},{"id":"semetey-1-2013:p1266:b003:l010","ordinal":173753,"en":"Was struck by mighty God;"},{"id":"semetey-1-2013:p1266:b003:l011","ordinal":173754,"en":"Akkelte, which they came to ask for—"},{"id":"semetey-1-2013:p1266:b003:l012","ordinal":173755,"en":"He devised a way not to give it."},{"id":"semetey-1-2013:p1266:b003:l013","ordinal":173756,"en":"Speaking drawn-out words,"},{"id":"semetey-1-2013:p1266:b003:l014","ordinal":173757,"en":"Offering evasive excuses,"},{"id":"semetey-1-2013:p1266:b003:l015","ordinal":173758,"en":"He delayed them."},{"id":"semetey-1-2013:p1266:b003:l016","ordinal":173759,"en":"Saying, “Take it after six months,”"},{"id":"semetey-1-2013:p1266:b003:l017","ordinal":173760,"en":"He set the time far off."},{"id":"semetey-1-2013:p1266:b003:l018","ordinal":173761,"en":"Sixty Russian surveyors"},{"id":"semetey-1-2013:p1266:b003:l019","ordinal":173762,"en":"Had gone on patrol for six months."},{"id":"semetey-1-2013:p1266:b003:l020","ordinal":173763,"en":"“Count the days,"},{"id":"semetey-1-2013:p1266:b003:l021","ordinal":173764,"en":"Record the days in writing;"},{"id":"semetey-1-2013:p1266:b003:l022","ordinal":173765,"en":"Return after six months,"},{"id":"semetey-1-2013:p1266:b003:l023","ordinal":173766,"en":"And then receive your answer!”"},{"id":"semetey-1-2013:p1266:b003:l024","ordinal":173767,"en":"Hearing such words from Kerke,"},{"id":"semetey-1-2013:p1266:b003:l025","ordinal":173768,"en":"Hearing, “After six months,"},{"id":"semetey-1-2013:p1266:b003:l026","ordinal":173769,"en":"Come and take Akkelte,”"},{"id":"semetey-1-2013:p1266:b003:l027","ordinal":173770,"en":"They attacked the Russians,"},{"id":"semetey-1-2013:p1266:b003:l028","ordinal":173771,"en":"Shattered their palace city,"},{"id":"semetey-1-2013:p1266:b003:l029","ordinal":173772,"en":"And raided it there."},{"id":"semetey-1-2013:p1266:b003:l030","ordinal":173773,"en":"In fury they made ready,"},{"id":"semetey-1-2013:p1266:b003:l031","ordinal":173774,"en":"All the bloodthirsty heroes devised a plan"},{"id":"semetey-1-2013:p1266:b003:l032","ordinal":173775,"en":"To enter the original city directly"},{"id":"semetey-1-2013:p1266:b003:l033","ordinal":173776,"en":"And raid it completely."},{"id":"semetey-1-2013:p1266:b003:l034","ordinal":173777,"en":"From a jutting promontory,"},{"id":"semetey-1-2013:p1266:b003:l035","ordinal":173778,"en":"From a pine-covered spur,"},{"id":"semetey-1-2013:p1266:b003:l036","ordinal":173779,"en":"Valiant Manas and Khan Bakai"},{"id":"semetey-1-2013:p1266:b003:l037","ordinal":173780,"en":"Came up onto the pass."},{"id":"semetey-1-2013:p1266:b003:l038","ordinal":173781,"en":"Dragging their wagon,"},{"id":"semetey-1-2013:p1266:b003:l039","ordinal":173782,"en":"Sixty Russian surveyors—"},{"id":"semetey-1-2013:p1266:b004:l001","ordinal":173783,"en":"They saw and captured them on the plain."},{"id":"semetey-1-2013:p1266:b004:l002","ordinal":173784,"en":"Turning red haze into night,"},{"id":"semetey-1-2013:p1266:b004:l003","ordinal":173785,"en":"Bakai brought the sun to a halt."},{"id":"semetey-1-2013:p1266:b004:l004","ordinal":173786,"en":"Keen Bakai and Khan Manas"},{"id":"semetey-1-2013:p1266:b004:l005","ordinal":173787,"en":"Did what had to be done."},{"id":"semetey-1-2013:p1266:b004:l006","ordinal":173788,"en":"They captured the surveyors;"},{"id":"semetey-1-2013:p1266:b004:l007","ordinal":173789,"en":"With the piebald stallion at their head,"},{"id":"semetey-1-2013:p1266:b004:l008","ordinal":173790,"en":"They seized Akkelte."},{"id":"semetey-1-2013:p1266:b004:l009","ordinal":173791,"en":"When they had seized Akkelte,"},{"id":"semetey-1-2013:p1266:b004:l010","ordinal":173792,"en":"Kydyr blessed"},{"id":"semetey-1-2013:p1266:b004:l011","ordinal":173793,"en":"Keen gray-wolf Manas."},{"id":"semetey-1-2013:p1266:b004:l012","ordinal":173794,"en":"The twelve joined hands as one;"},{"id":"semetey-1-2013:p1266:b004:l013","ordinal":173795,"en":"Your keen gray-wolf Manas"},{"id":"semetey-1-2013:p1266:b004:l014","ordinal":173796,"en":"Became renowned as mighty Manas."},{"id":"semetey-1-2013:p1266:b004:l015","ordinal":173797,"en":"Akkelte, taken as spoil"},{"id":"semetey-1-2013:p1266:b004:l016","ordinal":173798,"en":"From the Russians’ palace city,"},{"id":"semetey-1-2013:p1266:b004:l017","ordinal":173799,"en":"Did not deviate when fired afar;"},{"id":"semetey-1-2013:p1266:b004:l018","ordinal":173800,"en":"Akkelte became renowned,"},{"id":"semetey-1-2013:p1266:b004:l019","ordinal":173801,"en":"The sharp weapon that struck at distance,"},{"id":"semetey-1-2013:p1266:b004:l020","ordinal":173802,"en":"The treasure inherited"},{"id":"semetey-1-2013:p1266:b004:l021","ordinal":173803,"en":"From his father, gray-wolf Manas."},{"id":"semetey-1-2013:p1266:b004:l022","ordinal":173804,"en":"Its keenness was proven among the people,"},{"id":"semetey-1-2013:p1266:b004:l023","ordinal":173805,"en":"An inheritance remaining in his hand"},{"id":"semetey-1-2013:p1266:b004:l024","ordinal":173806,"en":"From Manas of matchless fortune."},{"id":"semetey-1-2013:p1266:b004:l025","ordinal":173807,"en":"When enemies approached, he slung it on;"},{"id":"semetey-1-2013:p1266:b004:l026","ordinal":173808,"en":"The gray wolf cast it across his back."},{"id":"semetey-1-2013:p1266:b004:l027","ordinal":173809,"en":"Chynkojo, son of Shygai,"},{"id":"semetey-1-2013:p1266:b004:l028","ordinal":173810,"en":"And Semetey with a mighty host"},{"id":"semetey-1-2013:p1266:b004:l029","ordinal":173811,"en":"Were to meet in battle."},{"id":"semetey-1-2013:p1266:b004:l030","ordinal":173812,"en":"With Akkelte slung on,"},{"id":"semetey-1-2013:p1266:b004:l031","ordinal":173813,"en":"The sight stirred the heart;"},{"id":"semetey-1-2013:p1266:b004:l032","ordinal":173814,"en":"In your champion’s hand,"},{"id":"semetey-1-2013:p1266:b004:l033","ordinal":173815,"en":"The beauty of Syrnaiza appeared."},{"id":"semetey-1-2013:p1266:b004:l034","ordinal":173816,"en":"Seeing Syrnaiza,"},{"id":"semetey-1-2013:p1266:b004:l035","ordinal":173817,"en":"The Afghans’ hearts were stirred, saying,"},{"id":"semetey-1-2013:p1266:b004:l036","ordinal":173818,"en":"“Your champion will spare no foe.”"},{"id":"semetey-1-2013:p1266:b004:l037","ordinal":173819,"en":"The Syrnaiza in his hand"},{"id":"semetey-1-2013:p1266:b004:l038","ordinal":173820,"en":"Was made from birch of Orolmo-Too,"},{"id":"semetey-1-2013:p1266:b004:l039","ordinal":173821,"en":"Cut straight from the tree,"},{"id":"semetey-1-2013:p1267:b003:l001","ordinal":173822,"en":"Hardened together with its bark,"},{"id":"semetey-1-2013:p1267:b003:l002","ordinal":173823,"en":"Deliberately hammered and twisted,"},{"id":"semetey-1-2013:p1267:b003:l003","ordinal":173824,"en":"Its crooked parts shaped by filing,"}]
