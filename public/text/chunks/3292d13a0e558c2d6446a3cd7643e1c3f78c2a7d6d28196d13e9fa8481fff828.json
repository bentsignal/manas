[{"id":"semetey-1-2013:p1239:b004:l039","ordinal":170753,"en":"Our fortune has been bound.”"},{"id":"semetey-1-2013:p1240:b003:l001","ordinal":170754,"en":"My brow bone must be ill-shaped;"},{"id":"semetey-1-2013:p1240:b003:l002","ordinal":170755,"en":"I let a fleeing soul escape."},{"id":"semetey-1-2013:p1240:b003:l003","ordinal":170756,"en":"May this vile, false world be desolate—"},{"id":"semetey-1-2013:p1240:b003:l004","ordinal":170757,"en":"My fortune must be crooked."},{"id":"semetey-1-2013:p1240:b003:l005","ordinal":170758,"en":"As I ask the gray wolf about the Argyn,"},{"id":"semetey-1-2013:p1240:b003:l006","ordinal":170759,"en":"Just as I was about to become a sultan,"},{"id":"semetey-1-2013:p1240:b003:l007","ordinal":170760,"en":"Ah, my deep-dug pit;"},{"id":"semetey-1-2013:p1240:b003:l008","ordinal":170761,"en":"Ah, my stain no washing removes!"},{"id":"semetey-1-2013:p1240:b003:l009","ordinal":170762,"en":"On snowy ground there is no cradle;"},{"id":"semetey-1-2013:p1240:b003:l010","ordinal":170763,"en":"I let the fleeing foe escape—"},{"id":"semetey-1-2013:p1240:b003:l011","ordinal":170764,"en":"There is no blessed portion for wretched me!"},{"id":"semetey-1-2013:p1240:b003:l012","ordinal":170765,"en":"My brow bone must be ill-shaped;"},{"id":"semetey-1-2013:p1240:b003:l013","ordinal":170766,"en":"My fortune was meager from the start!"},{"id":"semetey-1-2013:p1240:b003:l014","ordinal":170767,"en":"No good name remains to me;"},{"id":"semetey-1-2013:p1240:b003:l015","ordinal":170768,"en":"Calamity pressed down upon my head:"},{"id":"semetey-1-2013:p1240:b003:l016","ordinal":170769,"en":"Looming before me,"},{"id":"semetey-1-2013:p1240:b003:l017","ordinal":170770,"en":"Mountain-like Toltoy fled."},{"id":"semetey-1-2013:p1240:b003:l018","ordinal":170771,"en":"I let the fleeing foe escape;"},{"id":"semetey-1-2013:p1240:b003:l019","ordinal":170772,"en":"Can there be a man like me?"},{"id":"semetey-1-2013:p1240:b003:l020","ordinal":170773,"en":"Is it right to call"},{"id":"semetey-1-2013:p1240:b003:l021","ordinal":170774,"en":"A wretch like me a man?"},{"id":"semetey-1-2013:p1240:b003:l022","ordinal":170775,"en":"Can there be a man like me?"},{"id":"semetey-1-2013:p1240:b003:l023","ordinal":170776,"en":"A mortal man may be made a giant;"},{"id":"semetey-1-2013:p1240:b003:l024","ordinal":170777,"en":"Rather than make a person powerless,"},{"id":"semetey-1-2013:p1240:b003:l025","ordinal":170778,"en":"Why does Almighty God"},{"id":"semetey-1-2013:p1240:b003:l026","ordinal":170779,"en":"Not leave his mortal"},{"id":"semetey-1-2013:p1240:b003:l027","ordinal":170780,"en":"Uncreated instead?"},{"id":"semetey-1-2013:p1240:b003:l028","ordinal":170781,"en":"Rather than be born feeble,"},{"id":"semetey-1-2013:p1240:b003:l029","ordinal":170782,"en":"Why did this wretched soul"},{"id":"semetey-1-2013:p1240:b003:l030","ordinal":170783,"en":"Not see through"},{"id":"semetey-1-2013:p1240:b003:l031","ordinal":170784,"en":"The decree God laid down?"},{"id":"semetey-1-2013:p1240:b003:l032","ordinal":170785,"en":"Why did this wretched soul"},{"id":"semetey-1-2013:p1240:b003:l033","ordinal":170786,"en":"Not die in youth?"},{"id":"semetey-1-2013:p1240:b003:l034","ordinal":170787,"en":"Without caring for his horse's longing,"},{"id":"semetey-1-2013:p1240:b003:l035","ordinal":170788,"en":"My noble elder Semetey"},{"id":"semetey-1-2013:p1240:b003:l036","ordinal":170789,"en":"Gave me his horse without begrudging it."},{"id":"semetey-1-2013:p1240:b003:l037","ordinal":170790,"en":"Saying, “I failed to catch Toltoy,”"},{"id":"semetey-1-2013:p1240:b003:l038","ordinal":170791,"en":"How can I return in disgrace?"},{"id":"semetey-1-2013:p1240:b003:l039","ordinal":170792,"en":"Without caring for his coat's worth,"},{"id":"semetey-1-2013:p1240:b004:l001","ordinal":170793,"en":"My mountain-like elder Semetey"},{"id":"semetey-1-2013:p1240:b004:l002","ordinal":170794,"en":"Gave me his coat without begrudging it."},{"id":"semetey-1-2013:p1240:b004:l003","ordinal":170795,"en":"To Toltoy who fled bobbing away,"},{"id":"semetey-1-2013:p1240:b004:l004","ordinal":170796,"en":"Saying, “I myself failed to catch him,”"},{"id":"semetey-1-2013:p1240:b004:l005","ordinal":170797,"en":"How can I return in disgrace?"},{"id":"semetey-1-2013:p1240:b004:l006","ordinal":170798,"en":"The humiliation of the Jediger—"},{"id":"semetey-1-2013:p1240:b004:l007","ordinal":170799,"en":"Would that I had seen it,"},{"id":"semetey-1-2013:p1240:b004:l008","ordinal":170800,"en":"Charged alone among their army,"},{"id":"semetey-1-2013:p1240:b004:l009","ordinal":170801,"en":"Fought seven days without pause,"},{"id":"semetey-1-2013:p1240:b004:l010","ordinal":170802,"en":"And died if my doom came."},{"id":"semetey-1-2013:p1240:b004:l011","ordinal":170803,"en":"Against hero Toltoy and Khoja,"},{"id":"semetey-1-2013:p1240:b004:l012","ordinal":170804,"en":"Girding the jekene at my waist,"},{"id":"semetey-1-2013:p1240:b004:l013","ordinal":170805,"en":"Would that I had attacked alone,"},{"id":"semetey-1-2013:p1240:b004:l014","ordinal":170806,"en":"And before reaching my maturity,"},{"id":"semetey-1-2013:p1240:b004:l015","ordinal":170807,"en":"Died without delay!"},{"id":"semetey-1-2013:p1240:b004:l016","ordinal":170808,"en":"Against accursed Toltoy,"},{"id":"semetey-1-2013:p1240:b004:l017","ordinal":170809,"en":"Would that I had waged a wondrous war"},{"id":"semetey-1-2013:p1240:b004:l018","ordinal":170810,"en":"And split his realm in two!"},{"id":"semetey-1-2013:p1240:b004:l019","ordinal":170811,"en":"I long to camp on rugged ground;"},{"id":"semetey-1-2013:p1240:b004:l020","ordinal":170812,"en":"Against accursed Toltoy,"},{"id":"semetey-1-2013:p1240:b004:l021","ordinal":170813,"en":"Against the Khoja gone astray,"},{"id":"semetey-1-2013:p1240:b004:l022","ordinal":170814,"en":"I long to wage a wondrous war"},{"id":"semetey-1-2013:p1240:b004:l023","ordinal":170815,"en":"And be drenched red with blood."},{"id":"semetey-1-2013:p1240:b004:l024","ordinal":170816,"en":"Would that I split his head and cut it off,"},{"id":"semetey-1-2013:p1240:b004:l025","ordinal":170817,"en":"And before Semetey"},{"id":"semetey-1-2013:p1240:b004:l026","ordinal":170818,"en":"Carried it deliberately as a burden."},{"id":"semetey-1-2013:p1240:b004:l027","ordinal":170819,"en":"Against mountain-like gray wolf Toltoy,"},{"id":"semetey-1-2013:p1240:b004:l028","ordinal":170820,"en":"There is no bruise upon my body,"},{"id":"semetey-1-2013:p1240:b004:l029","ordinal":170821,"en":"No wound anywhere upon me."},{"id":"semetey-1-2013:p1240:b004:l030","ordinal":170822,"en":"Trembling worse than a woman,"},{"id":"semetey-1-2013:p1240:b004:l031","ordinal":170823,"en":"Is it right that fugitive Toltoy escaped?"},{"id":"semetey-1-2013:p1240:b004:l032","ordinal":170824,"en":"Can there be a man like me,"},{"id":"semetey-1-2013:p1240:b004:l033","ordinal":170825,"en":"Who let the fleeing foe escape?!"},{"id":"semetey-1-2013:p1240:b004:l034","ordinal":170826,"en":"Is it right to call"},{"id":"semetey-1-2013:p1240:b004:l035","ordinal":170827,"en":"A wretch like me a man?"},{"id":"semetey-1-2013:p1240:b004:l036","ordinal":170828,"en":"Curse your father's grave, world;"},{"id":"semetey-1-2013:p1240:b004:l037","ordinal":170829,"en":"Accursed childishness—"},{"id":"semetey-1-2013:p1240:b004:l038","ordinal":170830,"en":"When will this cursed immaturity"},{"id":"semetey-1-2013:p1240:b004:l039","ordinal":170831,"en":"Leave my head!"},{"id":"semetey-1-2013:p1241:b003:l001","ordinal":170832,"en":"My elder's patterned spear—"},{"id":"semetey-1-2013:p1241:b003:l002","ordinal":170833,"en":"When I gripped it and turned its neck,"},{"id":"semetey-1-2013:p1241:b003:l003","ordinal":170834,"en":"Facing toward the foe,"},{"id":"semetey-1-2013:p1241:b003:l004","ordinal":170835,"en":"When I threw myself against Toltoy,"},{"id":"semetey-1-2013:p1241:b003:l005","ordinal":170836,"en":"And thrust the spear straight,"},{"id":"semetey-1-2013:p1241:b003:l006","ordinal":170837,"en":"When we fought to exhaustion,"},{"id":"semetey-1-2013:p1241:b003:l007","ordinal":170838,"en":"I had no support on whom to rely,"},{"id":"semetey-1-2013:p1241:b003:l008","ordinal":170839,"en":"No fortified place to hold."},{"id":"semetey-1-2013:p1241:b003:l009","ordinal":170840,"en":"Standing in peril by myself,"},{"id":"semetey-1-2013:p1241:b003:l010","ordinal":170841,"en":"When we faced one another."},{"id":"semetey-1-2013:p1241:b003:l011","ordinal":170842,"en":"I had no support on whom to rely,"},{"id":"semetey-1-2013:p1241:b003:l012","ordinal":170843,"en":"No fortified place to hold."},{"id":"semetey-1-2013:p1241:b003:l013","ordinal":170844,"en":"When we faced one another,"},{"id":"semetey-1-2013:p1241:b003:l014","ordinal":170845,"en":"My renowned elder lion was absent."},{"id":"semetey-1-2013:p1241:b003:l015","ordinal":170846,"en":"I had no cliff geese could not circle,"},{"id":"semetey-1-2013:p1241:b003:l016","ordinal":170847,"en":"No rugged black mountain;"},{"id":"semetey-1-2013:p1241:b003:l017","ordinal":170848,"en":"Lion Bakai, who sat as my support,"},{"id":"semetey-1-2013:p1241:b003:l018","ordinal":170849,"en":"Was not here."},{"id":"semetey-1-2013:p1241:b003:l019","ordinal":170850,"en":"Fire from one's own core is terrible;"},{"id":"semetey-1-2013:p1241:b003:l020","ordinal":170851,"en":"An enemy from one's own kin is terrible."},{"id":"semetey-1-2013:p1241:b003:l021","ordinal":170852,"en":"Chynkojo, with whom I shared secrets,"},{"id":"semetey-1-2013:p1241:b003:l022","ordinal":170853,"en":"Will he encircle me from behind,"},{"id":"semetey-1-2013:p1241:b003:l023","ordinal":170854,"en":"Turn back his great army,"},{"id":"semetey-1-2013:p1241:b003:l024","ordinal":170855,"en":"Take Buurul from beneath me,"},{"id":"semetey-1-2013:p1241:b003:l025","ordinal":170856,"en":"Leave Semetey on foot,"},{"id":"semetey-1-2013:p1241:b003:l026","ordinal":170857,"en":"And seize him as plunder!”"},{"id":"semetey-1-2013:p1241:b003:l027","ordinal":170858,"en":"Walking heavily and exhausted,"},{"id":"semetey-1-2013:p1241:b003:l028","ordinal":170859,"en":"Leaning upon the patterned spear,"},{"id":"semetey-1-2013:p1241:b003:l029","ordinal":170860,"en":"Külchoro stood there."},{"id":"semetey-1-2013:p1241:b003:l030","ordinal":170861,"en":"Let us leave his ruined state"},{"id":"semetey-1-2013:p1241:b003:l031","ordinal":170862,"en":"And now tell"},{"id":"semetey-1-2013:p1241:b003:l032","ordinal":170863,"en":"The tale of Khan Toltoy."},{"id":"semetey-1-2013:p1241:b003:l033","ordinal":170864,"en":"Dear Toltoy flailed about,"},{"id":"semetey-1-2013:p1241:b003:l034","ordinal":170865,"en":"The two fronts of his coat flapping,"},{"id":"semetey-1-2013:p1241:b003:l035","ordinal":170866,"en":"Covered in swirling dust,"},{"id":"semetey-1-2013:p1241:b003:l036","ordinal":170867,"en":"And blood by the red bucketful."},{"id":"semetey-1-2013:p1241:b003:l037","ordinal":170868,"en":"Surkoen ambled;"},{"id":"semetey-1-2013:p1241:b003:l038","ordinal":170869,"en":"The blood flowing from his rump"},{"id":"semetey-1-2013:p1241:b003:l039","ordinal":170870,"en":"Ran in streams"},{"id":"semetey-1-2013:p1241:b005:l001","ordinal":170871,"en":"Across Surkoen's fat haunches."},{"id":"semetey-1-2013:p1241:b005:l002","ordinal":170872,"en":"At times he regained consciousness;"},{"id":"semetey-1-2013:p1241:b005:l003","ordinal":170873,"en":"At times he could not."},{"id":"semetey-1-2013:p1241:b005:l004","ordinal":170874,"en":"His time had broken apart;"},{"id":"semetey-1-2013:p1241:b005:l005","ordinal":170875,"en":"Blood flowing from his wound"},{"id":"semetey-1-2013:p1241:b005:l006","ordinal":170876,"en":"Spilled upon the black earth."},{"id":"semetey-1-2013:p1241:b005:l007","ordinal":170877,"en":"Hero Toltoy appeared"},{"id":"semetey-1-2013:p1241:b005:l008","ordinal":170878,"en":"About to depart for the true world."},{"id":"semetey-1-2013:p1241:b005:l009","ordinal":170879,"en":"His eyes darted away;"},{"id":"semetey-1-2013:p1241:b005:l010","ordinal":170880,"en":"Gray wolf Toltoy then"},{"id":"semetey-1-2013:p1241:b005:l011","ordinal":170881,"en":"Let his legs hang loose."},{"id":"semetey-1-2013:p1241:b005:l012","ordinal":170882,"en":"His spirit was sorely torn;"},{"id":"semetey-1-2013:p1241:b005:l013","ordinal":170883,"en":"He bore the look of one dying."},{"id":"semetey-1-2013:p1241:b005:l014","ordinal":170884,"en":"Surkoen ambled;"},{"id":"semetey-1-2013:p1241:b005:l015","ordinal":170885,"en":"Blood flowing from his neck"},{"id":"semetey-1-2013:p1241:b005:l016","ordinal":170886,"en":"Ran down his collar."},{"id":"semetey-1-2013:p1241:b005:l017","ordinal":170887,"en":"Raging and shouting,"},{"id":"semetey-1-2013:p1241:b005:l018","ordinal":170888,"en":"Bending down the willow tops,"},{"id":"semetey-1-2013:p1241:b005:l019","ordinal":170889,"en":"When bright dawn broke,"},{"id":"semetey-1-2013:p1241:b005:l020","ordinal":170890,"en":"When light fell upon the earth,"},{"id":"semetey-1-2013:p1241:b005:l021","ordinal":170891,"en":"Toltoy went on screaming."},{"id":"semetey-1-2013:p1241:b005:l022","ordinal":170892,"en":"His face distorted then;"},{"id":"semetey-1-2013:p1241:b005:l023","ordinal":170893,"en":"Hero Toltoy retched,"},{"id":"semetey-1-2013:p1241:b005:l024","ordinal":170894,"en":"Thudding from time to time;"},{"id":"semetey-1-2013:p1241:b005:l025","ordinal":170895,"en":"Hero Toltoy vomited."},{"id":"semetey-1-2013:p1241:b005:l026","ordinal":170896,"en":"He did not recognize his own fault"},{"id":"semetey-1-2013:p1241:b005:l027","ordinal":170897,"en":"In fleeing before the boy."},{"id":"semetey-1-2013:p1241:b005:l028","ordinal":170898,"en":"Then he cursed Chynkojo,"},{"id":"semetey-1-2013:p1241:b005:l029","ordinal":170899,"en":"Making sport of"},{"id":"semetey-1-2013:p1241:b005:l030","ordinal":170900,"en":"His father and mother:"},{"id":"semetey-1-2013:p1241:b005:l031","ordinal":170901,"en":"“Accursed Chynkojo,"},{"id":"semetey-1-2013:p1241:b005:l032","ordinal":170902,"en":"Did I not tell you before?"},{"id":"semetey-1-2013:p1241:b005:l033","ordinal":170903,"en":"Did you not hear me before!"},{"id":"semetey-1-2013:p1241:b005:l034","ordinal":170904,"en":"The deeply dug pit has come;"},{"id":"semetey-1-2013:p1241:b005:l035","ordinal":170905,"en":"Manas at their head, surging,"},{"id":"semetey-1-2013:p1241:b005:l036","ordinal":170906,"en":"The engulfing black army has come."},{"id":"semetey-1-2013:p1241:b005:l037","ordinal":170907,"en":"A dark day has pressed hard upon our lives;"},{"id":"semetey-1-2013:p1241:b005:l038","ordinal":170908,"en":"Bakai at their head, a thousand men,"},{"id":"semetey-1-2013:p1241:b005:l039","ordinal":170909,"en":"Have surged out from Batkal."},{"id":"semetey-1-2013:p1242:b003:l001","ordinal":170910,"en":"His messenger has come—give an answer!"},{"id":"semetey-1-2013:p1242:b003:l002","ordinal":170911,"en":"If you are a man, Khoja, reply!"},{"id":"semetey-1-2013:p1242:b003:l003","ordinal":170912,"en":"Leveling spears and shouting,"},{"id":"semetey-1-2013:p1242:b003:l004","ordinal":170913,"en":"How many souls came out of Batkal,"},{"id":"semetey-1-2013:p1242:b003:l005","ordinal":170914,"en":"Raising the battle cry of Manas."},{"id":"semetey-1-2013:p1242:b003:l006","ordinal":170915,"en":"Riding a red-roan horse,"},{"id":"semetey-1-2013:p1242:b003:l007","ordinal":170916,"en":"Its horsehair tail tied tight,"},{"id":"semetey-1-2013:p1242:b003:l008","ordinal":170917,"en":"A ruddy young boy"},{"id":"semetey-1-2013:p1242:b003:l009","ordinal":170918,"en":"Came shouting and thrust his spear."},{"id":"semetey-1-2013:p1242:b003:l010","ordinal":170919,"en":"When he reached me and thrust,"},{"id":"semetey-1-2013:p1242:b003:l011","ordinal":170920,"en":"I pitched backward from my saddle;"},{"id":"semetey-1-2013:p1242:b003:l012","ordinal":170921,"en":"My foot slipped from the stirrup."},{"id":"semetey-1-2013:p1242:b003:l013","ordinal":170922,"en":"My eyes darted wildly;"},{"id":"semetey-1-2013:p1242:b003:l014","ordinal":170923,"en":"My legs hung loose."},{"id":"semetey-1-2013:p1242:b003:l015","ordinal":170924,"en":"The spear struck my rump;"},{"id":"semetey-1-2013:p1242:b003:l016","ordinal":170925,"en":"From the boy who speared me,"},{"id":"semetey-1-2013:p1242:b003:l017","ordinal":170926,"en":"The reins fell from his hand—"},{"id":"semetey-1-2013:p1242:b003:l018","ordinal":170927,"en":"That alone saved me."},{"id":"semetey-1-2013:p1242:b003:l019","ordinal":170928,"en":"Had his reins not fallen to the ground,"},{"id":"semetey-1-2013:p1242:b003:l020","ordinal":170929,"en":"He would have drawn the line,"},{"id":"semetey-1-2013:p1242:b003:l021","ordinal":170930,"en":"Made a spectacle,"},{"id":"semetey-1-2013:p1242:b003:l022","ordinal":170931,"en":"Spilled my blood,"},{"id":"semetey-1-2013:p1242:b003:l023","ordinal":170932,"en":"And taken my life."},{"id":"semetey-1-2013:p1242:b003:l024","ordinal":170933,"en":"Riding a black-roan horse,"},{"id":"semetey-1-2013:p1242:b003:l025","ordinal":170934,"en":"Its tail gripped and tied tight,"},{"id":"semetey-1-2013:p1242:b003:l026","ordinal":170935,"en":"A dark-complexioned young boy"},{"id":"semetey-1-2013:p1242:b003:l027","ordinal":170936,"en":"Suddenly appeared in my path"},{"id":"semetey-1-2013:p1242:b003:l028","ordinal":170937,"en":"And brought calamity upon me."},{"id":"semetey-1-2013:p1242:b003:l029","ordinal":170938,"en":"Khan Manas at their head,"},{"id":"semetey-1-2013:p1242:b003:l030","ordinal":170939,"en":"Crying, ‘Seize the slave, seize him!’"},{"id":"semetey-1-2013:p1242:b003:l031","ordinal":170940,"en":"‘Catch him and bind his hands!"},{"id":"semetey-1-2013:p1242:b003:l032","ordinal":170941,"en":"Gouge out both his eyes"},{"id":"semetey-1-2013:p1242:b003:l033","ordinal":170942,"en":"And drive him like a donkey!"},{"id":"semetey-1-2013:p1242:b003:l034","ordinal":170943,"en":"The vile man who would take a wife—"},{"id":"semetey-1-2013:p1242:b003:l035","ordinal":170944,"en":"Seize him, seize him, seize him!"},{"id":"semetey-1-2013:p1242:b003:l036","ordinal":170945,"en":"Though the swine begs, do not relent;"},{"id":"semetey-1-2013:p1242:b003:l037","ordinal":170946,"en":"Kill him wherever he is caught!’"},{"id":"semetey-1-2013:p1242:b003:l038","ordinal":170947,"en":"Bakai urged them onward."},{"id":"semetey-1-2013:p1242:b003:l039","ordinal":170948,"en":"Beyond him,"},{"id":"semetey-1-2013:p1242:b004:l001","ordinal":170949,"en":"Among the horses were blaze-faced tulpars;"},{"id":"semetey-1-2013:p1242:b004:l002","ordinal":170950,"en":"All forty companions were there,"},{"id":"semetey-1-2013:p1242:b004:l003","ordinal":170951,"en":"Almambet and Chubak among them."},{"id":"semetey-1-2013:p1242:b004:l004","ordinal":170952,"en":"The boy beneath him"},{"id":"semetey-1-2013:p1242:b004:l005","ordinal":170953,"en":"Had taken up the urging cry;"},{"id":"semetey-1-2013:p1242:b004:l006","ordinal":170954,"en":"Chubak of Akbaltai"},{"id":"semetey-1-2013:p1242:b004:l007","ordinal":170955,"en":"Raised the shout."},{"id":"semetey-1-2013:p1242:b004:l008","ordinal":170956,"en":"His brow was high, his venom strong;"},{"id":"semetey-1-2013:p1242:b004:l009","ordinal":170957,"en":"He set right whoever attacked him."},{"id":"semetey-1-2013:p1242:b004:l010","ordinal":170958,"en":"Thick-armed and stone-hearted,"},{"id":"semetey-1-2013:p1242:b004:l011","ordinal":170959,"en":"The twelve-year-old Külchoro,"},{"id":"semetey-1-2013:p1242:b004:l012","ordinal":170960,"en":"A sturdy, full-limbed stripling,"},{"id":"semetey-1-2013:p1242:b004:l013","ordinal":170961,"en":"Whose heroism was unlike another's,"},{"id":"semetey-1-2013:p1242:b004:l014","ordinal":170962,"en":"Whose strength was extraordinary."},{"id":"semetey-1-2013:p1242:b004:l015","ordinal":170963,"en":"The deep pit dug for me,"},{"id":"semetey-1-2013:p1242:b004:l016","ordinal":170964,"en":"My bitter brine thus brought to the boil—"},{"id":"semetey-1-2013:p1242:b004:l017","ordinal":170965,"en":"He showed my eyes"},{"id":"semetey-1-2013:p1242:b004:l018","ordinal":170966,"en":"A wonder no man could accomplish."},{"id":"semetey-1-2013:p1242:b004:l019","ordinal":170967,"en":"When we migrated from Talas,"},{"id":"semetey-1-2013:p1242:b004:l020","ordinal":170968,"en":"God-struck Chynkojo,"},{"id":"semetey-1-2013:p1242:b004:l021","ordinal":170969,"en":"You bore down like a heavy load then."},{"id":"semetey-1-2013:p1242:b004:l022","ordinal":170970,"en":"Your witness taken from Talas—"},{"id":"semetey-1-2013:p1242:b004:l023","ordinal":170971,"en":"Saying, ‘I shall seize his wife,’"},{"id":"semetey-1-2013:p1242:b004:l024","ordinal":170972,"en":"You nearly reached my root."},{"id":"semetey-1-2013:p1242:b004:l025","ordinal":170973,"en":"When I said I would not go, you refused;"},{"id":"semetey-1-2013:p1242:b004:l026","ordinal":170974,"en":"You left me no choice but to go."},{"id":"semetey-1-2013:p1242:b004:l027","ordinal":170975,"en":"You brought corruption upon my head"},{"id":"semetey-1-2013:p1242:b004:l028","ordinal":170976,"en":"And meant to show me a spectacle."},{"id":"semetey-1-2013:p1242:b004:l029","ordinal":170977,"en":"You caused accursed Toltoy to be slaughtered;"},{"id":"semetey-1-2013:p1242:b004:l030","ordinal":170978,"en":"Saying you would seize the bride"},{"id":"semetey-1-2013:p1242:b004:l031","ordinal":170979,"en":"Of blessed lion Manas,"},{"id":"semetey-1-2013:p1242:b004:l032","ordinal":170980,"en":"You brought anguish upon my head."},{"id":"semetey-1-2013:p1242:b004:l033","ordinal":170981,"en":"I heeded your words"},{"id":"semetey-1-2013:p1242:b004:l034","ordinal":170982,"en":"And went to behold"},{"id":"semetey-1-2013:p1242:b004:l035","ordinal":170983,"en":"Humiliation no man had seen."},{"id":"semetey-1-2013:p1242:b004:l036","ordinal":170984,"en":"Chynkojo, son of Shygai,"},{"id":"semetey-1-2013:p1242:b004:l037","ordinal":170985,"en":"Your deed was bold, Khoja."},{"id":"semetey-1-2013:p1242:b004:l038","ordinal":170986,"en":"My blustering hero,"},{"id":"semetey-1-2013:p1242:b004:l039","ordinal":170987,"en":"My infidel whose mother is forsworn,"},{"id":"semetey-1-2013:p1243:b003:l001","ordinal":170988,"en":"My eyes like blackcurrants—"},{"id":"semetey-1-2013:p1243:b003:l002","ordinal":170989,"en":"You are going about having them gouged out."},{"id":"semetey-1-2013:p1243:b003:l003","ordinal":170990,"en":"Sending me broadside"},{"id":"semetey-1-2013:p1243:b003:l004","ordinal":170991,"en":"Against the bloodthirsty hero's orphan son,"},{"id":"semetey-1-2013:p1243:b003:l005","ordinal":170992,"en":"You are going about having me slaughtered."},{"id":"semetey-1-2013:p1243:b003:l006","ordinal":170993,"en":"Saying I would tell you my grievance,"},{"id":"semetey-1-2013:p1243:b003:l007","ordinal":170994,"en":"I came to see you—do you see?"},{"id":"semetey-1-2013:p1243:b003:l008","ordinal":170995,"en":"Wounded and suffering,"},{"id":"semetey-1-2013:p1243:b003:l009","ordinal":170996,"en":"I came to die—do you see?"},{"id":"semetey-1-2013:p1243:b003:l010","ordinal":170997,"en":"Blessed gray wolf Manas—"},{"id":"semetey-1-2013:p1243:b003:l011","ordinal":170998,"en":"You provoked him;"},{"id":"semetey-1-2013:p1243:b003:l012","ordinal":170999,"en":"Refusing to go peacefully and reeling crookedly,"},{"id":"semetey-1-2013:p1243:b003:l013","ordinal":171000,"en":"Accursed Khoja,"},{"id":"semetey-1-2013:p1243:b003:l014","ordinal":171001,"en":"You made your enmity known."},{"id":"semetey-1-2013:p1243:b003:l015","ordinal":171002,"en":"For the great black Jediger,"},{"id":"semetey-1-2013:p1243:b003:l016","ordinal":171003,"en":"You have incurred their blood-guilt;"},{"id":"semetey-1-2013:p1243:b003:l017","ordinal":171004,"en":"All the people,"},{"id":"semetey-1-2013:p1243:b003:l018","ordinal":171005,"en":"Ill-starred Chynkojo,"},{"id":"semetey-1-2013:p1243:b003:l019","ordinal":171006,"en":"You truly caused to be slaughtered."},{"id":"semetey-1-2013:p1243:b003:l020","ordinal":171007,"en":"You first desired corruption,"},{"id":"semetey-1-2013:p1243:b003:l021","ordinal":171008,"en":"Accursed Chynkojo;"}]
