[{"id":"semetey-1-2013:p1025:b003:l025","ordinal":154369,"en":"And focused it upon his eye."},{"id":"semetey-1-2013:p1025:b003:l026","ordinal":154370,"en":"When he turned the wheel,"},{"id":"semetey-1-2013:p1025:b003:l027","ordinal":154371,"en":"That wondrous spyglass"},{"id":"semetey-1-2013:p1025:b003:l028","ordinal":154372,"en":"Divided its lens into six,"},{"id":"semetey-1-2013:p1025:b003:l029","ordinal":154373,"en":"And a road six days distant"},{"id":"semetey-1-2013:p1025:b003:l030","ordinal":154374,"en":"Appeared clearly, without distortion."},{"id":"semetey-1-2013:p1025:b003:l031","ordinal":154375,"en":"Its lens was made of precious stone;"},{"id":"semetey-1-2013:p1025:b003:l032","ordinal":154376,"en":"When he turned it to its full extent,"},{"id":"semetey-1-2013:p1025:b003:l033","ordinal":154377,"en":"It divided into seven parts,"},{"id":"semetey-1-2013:p1025:b003:l034","ordinal":154378,"en":"And a road seven days distant"},{"id":"semetey-1-2013:p1025:b003:l035","ordinal":154379,"en":"Appeared as close as seven rope-lengths."},{"id":"semetey-1-2013:p1025:b003:l036","ordinal":154380,"en":"The great and precious spyglass"},{"id":"semetey-1-2013:p1025:b003:l037","ordinal":154381,"en":"Was wound with gold inside;"},{"id":"semetey-1-2013:p1025:b003:l038","ordinal":154382,"en":"Master caster Bolokbai"},{"id":"semetey-1-2013:p1025:b003:l039","ordinal":154383,"en":"Had repaired every damaged place."},{"id":"semetey-1-2013:p1025:b005:l001","ordinal":154384,"en":"The lion grew furious,"},{"id":"semetey-1-2013:p1025:b005:l002","ordinal":154385,"en":"Turned its wheel,"},{"id":"semetey-1-2013:p1025:b005:l003","ordinal":154386,"en":"And set it squarely to his eye."},{"id":"semetey-1-2013:p1025:b005:l004","ordinal":154387,"en":"Beside the flowing river,"},{"id":"semetey-1-2013:p1025:b005:l005","ordinal":154388,"en":"Across the plain of Great Opol,"},{"id":"semetey-1-2013:p1025:b005:l006","ordinal":154389,"en":"The lion, the son of Manas,"},{"id":"semetey-1-2013:p1025:b005:l007","ordinal":154390,"en":"Looked through the spyglass."},{"id":"semetey-1-2013:p1025:b005:l008","ordinal":154391,"en":"Without being consumed by grief or worry,"},{"id":"semetey-1-2013:p1025:b005:l009","ordinal":154392,"en":"Without saying, \"My uncle stands"},{"id":"semetey-1-2013:p1025:b005:l010","ordinal":154393,"en":"Stranded behind me,\""},{"id":"semetey-1-2013:p1025:b005:l026","ordinal":154394,"en":"Thirty brides and thirty maidens,","gapBefore":"[Passage withheld: sexual content involving a minor]"},{"id":"semetey-1-2013:p1025:b005:l027","ordinal":154395,"en":"The immoderate Churok, and the boy—"},{"id":"semetey-1-2013:p1025:b005:l028","ordinal":154396,"en":"All of them, struck with amazement,"},{"id":"semetey-1-2013:p1025:b005:l029","ordinal":154397,"en":"Had gathered around him;"},{"id":"semetey-1-2013:p1025:b005:l030","ordinal":154398,"en":"Look at their fawning attention:"},{"id":"semetey-1-2013:p1025:b005:l031","ordinal":154399,"en":"They had encircled him."},{"id":"semetey-1-2013:p1025:b005:l032","ordinal":154400,"en":"Seeing this, Semetey thought:"},{"id":"semetey-1-2013:p1025:b005:l033","ordinal":154401,"en":"\"When he reaches his full maturity,"},{"id":"semetey-1-2013:p1025:b005:l034","ordinal":154402,"en":"He will surely conquer a mighty realm;"},{"id":"semetey-1-2013:p1025:b005:l035","ordinal":154403,"en":"When he grows into a true man,"},{"id":"semetey-1-2013:p1025:b005:l036","ordinal":154404,"en":"When he equals the sons of heroes,"},{"id":"semetey-1-2013:p1025:b005:l037","ordinal":154405,"en":"He will indeed show me"},{"id":"semetey-1-2013:p1025:b005:l038","ordinal":154406,"en":"Marvels beyond imagining!"},{"id":"semetey-1-2013:p1025:b005:l039","ordinal":154407,"en":"If this boy remains alive,"},{"id":"semetey-1-2013:p1026:b003:l001","ordinal":154408,"en":"If he carries on like this, God will strike him;"},{"id":"semetey-1-2013:p1026:b003:l002","ordinal":154409,"en":"He will unleash chaos."},{"id":"semetey-1-2013:p1026:b003:l003","ordinal":154410,"en":"The accursed wretch has gone wild"},{"id":"semetey-1-2013:p1026:b003:l004","ordinal":154411,"en":"And will take my wife away;"},{"id":"semetey-1-2013:p1026:b003:l005","ordinal":154412,"en":"Thus he will bring me to ruin."},{"id":"semetey-1-2013:p1026:b003:l006","ordinal":154413,"en":"That brazen wretch"},{"id":"semetey-1-2013:p1026:b003:l007","ordinal":154414,"en":"Will carry off my wife."},{"id":"semetey-1-2013:p1026:b003:l008","ordinal":154415,"en":"He will put an end to my laughter;"},{"id":"semetey-1-2013:p1026:b003:l009","ordinal":154416,"en":"That wretch will scatter"},{"id":"semetey-1-2013:p1026:b003:l010","ordinal":154417,"en":"All the possessions I own!"},{"id":"semetey-1-2013:p1026:b003:l011","ordinal":154418,"en":"Though only a boy, the little brat"},{"id":"semetey-1-2013:p1026:b003:l012","ordinal":154419,"en":"Has cast his chilling lasso"},{"id":"semetey-1-2013:p1026:b003:l013","ordinal":154420,"en":"Over the languishing Churok."},{"id":"semetey-1-2013:p1026:b003:l014","ordinal":154421,"en":"He tethered Buurul far away;"},{"id":"semetey-1-2013:p1026:b003:l015","ordinal":154422,"en":"Where maidens played Orompoi,"},{"id":"semetey-1-2013:p1026:b003:l016","ordinal":154423,"en":"He remained absorbed in play."},{"id":"semetey-1-2013:p1026:b003:l017","ordinal":154424,"en":"God has taken all sense from Choro;"},{"id":"semetey-1-2013:p1026:b003:l018","ordinal":154425,"en":"Where maidens played Shabyyat,"},{"id":"semetey-1-2013:p1026:b003:l019","ordinal":154426,"en":"He made merry without haste."},{"id":"semetey-1-2013:p1026:b003:l020","ordinal":154427,"en":"Without saying, 'I have my hulking uncle,'"},{"id":"semetey-1-2013:p1026:b003:l021","ordinal":154428,"en":"With maidens who had hung a swing,"},{"id":"semetey-1-2013:p1026:b003:l022","ordinal":154429,"en":"He has stayed there frolicking!\""},{"id":"semetey-1-2013:p1026:b003:l023","ordinal":154430,"en":"Seeing this, your lord could not remain still;"},{"id":"semetey-1-2013:p1026:b003:l024","ordinal":154431,"en":"Smoke billowed from his mouth,"},{"id":"semetey-1-2013:p1026:b003:l025","ordinal":154432,"en":"And flame streamed from his eyes."},{"id":"semetey-1-2013:p1026:b003:l026","ordinal":154433,"en":"His fire-like eyes blazed;"},{"id":"semetey-1-2013:p1026:b003:l027","ordinal":154434,"en":"The gray-maned lord bristled,"},{"id":"semetey-1-2013:p1026:b003:l028","ordinal":154435,"en":"And bloodlust seized him."},{"id":"semetey-1-2013:p1026:b003:l029","ordinal":154436,"en":"Semetey grew furious,"},{"id":"semetey-1-2013:p1026:b003:l030","ordinal":154437,"en":"As though Kulchoro had taken"},{"id":"semetey-1-2013:p1026:b003:l031","ordinal":154438,"en":"His beautiful wife Churok:"},{"id":"semetey-1-2013:p1026:b003:l032","ordinal":154439,"en":"\"If I do not sacrifice"},{"id":"semetey-1-2013:p1026:b003:l033","ordinal":154440,"en":"Those two across the river!"},{"id":"semetey-1-2013:p1026:b003:l034","ordinal":154441,"en":"If I do not take every vengeance"},{"id":"semetey-1-2013:p1026:b003:l035","ordinal":154442,"en":"Upon Akun on the farther side!"},{"id":"semetey-1-2013:p1026:b003:l036","ordinal":154443,"en":"If he does not return the livestock of my lordly father Manas,"},{"id":"semetey-1-2013:p1026:b003:l037","ordinal":154444,"en":"If I do not trample upon the head"},{"id":"semetey-1-2013:p1026:b003:l038","ordinal":154445,"en":"Of that self-styled lord Akun"},{"id":"semetey-1-2013:p1026:b003:l039","ordinal":154446,"en":"And scatter all four kinds of his livestock!"},{"id":"semetey-1-2013:p1026:b004:l001","ordinal":154447,"en":"If I do not drive off his mares in pursuit"},{"id":"semetey-1-2013:p1026:b004:l002","ordinal":154448,"en":"And bring out all his hidden spite;"},{"id":"semetey-1-2013:p1026:b004:l003","ordinal":154449,"en":"If he comes near, may I rain blows"},{"id":"semetey-1-2013:p1026:b004:l004","ordinal":154450,"en":"And dash out his brains!"},{"id":"semetey-1-2013:p1026:b004:l005","ordinal":154451,"en":"Now he has struck my fury;"},{"id":"semetey-1-2013:p1026:b004:l006","ordinal":154452,"en":"Let alone Akun—may I not rest"},{"id":"semetey-1-2013:p1026:b004:l007","ordinal":154453,"en":"Until I myself have slaughtered"},{"id":"semetey-1-2013:p1026:b004:l008","ordinal":154454,"en":"Both Churok and Kulchoro!\""},{"id":"semetey-1-2013:p1026:b004:l009","ordinal":154455,"en":"The lion grew furious"},{"id":"semetey-1-2013:p1026:b004:l010","ordinal":154456,"en":"And burned with jealousy for his wife."},{"id":"semetey-1-2013:p1026:b004:l011","ordinal":154457,"en":"He loosed a lion's voice"},{"id":"semetey-1-2013:p1026:b004:l012","ordinal":154458,"en":"And shouted menacingly;"},{"id":"semetey-1-2013:p1026:b004:l013","ordinal":154459,"en":"Unable to contain his anger,"},{"id":"semetey-1-2013:p1026:b004:l014","ordinal":154460,"en":"He called out for Kanchoro."},{"id":"semetey-1-2013:p1026:b004:l015","ordinal":154461,"en":"Hearing his voice, Kanchoro,"},{"id":"semetey-1-2013:p1026:b004:l016","ordinal":154462,"en":"Saying, \"What has happened to my lord?\""},{"id":"semetey-1-2013:p1026:b004:l017","ordinal":154463,"en":"Flew like an arrow"},{"id":"semetey-1-2013:p1026:b004:l018","ordinal":154464,"en":"And reached the gray-maned hero's side."},{"id":"semetey-1-2013:p1026:b004:l019","ordinal":154465,"en":"He raged and swaggered in fury;"},{"id":"semetey-1-2013:p1026:b004:l020","ordinal":154466,"en":"God had struck the bloodthirsty man."},{"id":"semetey-1-2013:p1026:b004:l021","ordinal":154467,"en":"As though his khan-father Manas had died,"},{"id":"semetey-1-2013:p1026:b004:l022","ordinal":154468,"en":"He stood there enraged:"},{"id":"semetey-1-2013:p1026:b004:l023","ordinal":154469,"en":"\"Come here, Kanchoro."},{"id":"semetey-1-2013:p1026:b004:l024","ordinal":154470,"en":"I have seen a marvel and a spectacle;"},{"id":"semetey-1-2013:p1026:b004:l025","ordinal":154471,"en":"I will spare no wretched soul,"},{"id":"semetey-1-2013:p1026:b004:l026","ordinal":154472,"en":"For I have met a grievous calamity!"},{"id":"semetey-1-2013:p1026:b004:l027","ordinal":154473,"en":"If a khan provokes my anger, let him die;"},{"id":"semetey-1-2013:p1026:b004:l028","ordinal":154474,"en":"Today, let every soul"},{"id":"semetey-1-2013:p1026:b004:l029","ordinal":154475,"en":"Who opposes me die!\""},{"id":"semetey-1-2013:p1026:b004:l030","ordinal":154476,"en":"He shouted in fury;"},{"id":"semetey-1-2013:p1026:b004:l031","ordinal":154477,"en":"Your gray-maned hero, agitated and hurried,"},{"id":"semetey-1-2013:p1026:b004:l032","ordinal":154478,"en":"Called to Kanchoro:"},{"id":"semetey-1-2013:p1026:b004:l033","ordinal":154479,"en":"\"When I climb, you are my support;"},{"id":"semetey-1-2013:p1026:b004:l034","ordinal":154480,"en":"My anger has risen and made me rigid,"},{"id":"semetey-1-2013:p1026:b004:l035","ordinal":154481,"en":"Kanchoro, my little brother!"},{"id":"semetey-1-2013:p1026:b004:l036","ordinal":154482,"en":"Drive the fourteen horses here;"},{"id":"semetey-1-2013:p1026:b004:l037","ordinal":154483,"en":"From among those fourteen horses,"},{"id":"semetey-1-2013:p1026:b004:l038","ordinal":154484,"en":"For me to ride into Afghanistan,"},{"id":"semetey-1-2013:p1026:b004:l039","ordinal":154485,"en":"To take vengeance upon the wicked,"}]
