[{"id":"manas-2010:p0042:b002:l038","ordinal":1281,"en":"And lay it squarely on his neck."},{"id":"manas-2010:p0042:b002:l039","ordinal":1282,"en":"Saying, ‘The wretched Burut did it,’"},{"id":"manas-2010:p0042:b002:l040","ordinal":1283,"en":"How can we slaughter this whole people?"},{"id":"manas-2010:p0042:b002:l041","ordinal":1284,"en":"We need land to sustain life;"},{"id":"manas-2010:p0042:b002:l042","ordinal":1285,"en":"To keep collecting tribute,"},{"id":"manas-2010:p0042:b002:l043","ordinal":1286,"en":"To gather our treasury,"},{"id":"manas-2010:p0042:b002:l044","ordinal":1287,"en":"We need a great mass of common people!"},{"id":"manas-2010:p0042:b002:l045","ordinal":1288,"en":"Let us find the guilty one,"},{"id":"manas-2010:p0042:b002:l046","ordinal":1289,"en":"These fucking Burut—"},{"id":"manas-2010:p0042:b002:l047","ordinal":1290,"en":"Let us beat their spirit far away.”"},{"id":"manas-2010:p0042:b002:l048","ordinal":1291,"en":"Then Alöökö said this:"},{"id":"manas-2010:p0043:b002:l001","ordinal":1292,"en":"“These fucking Burut!"},{"id":"manas-2010:p0043:b002:l002","ordinal":1293,"en":"The gold on ninety-five camels,"},{"id":"manas-2010:p0043:b002:l003","ordinal":1294,"en":"These very Burut squandered it."},{"id":"manas-2010:p0043:b002:l004","ordinal":1295,"en":"These eight sons of Karakan"},{"id":"manas-2010:p0043:b002:l005","ordinal":1296,"en":"Have herds amassed in Chatkal;"},{"id":"manas-2010:p0043:b002:l006","ordinal":1297,"en":"If they had the strength, these Burut"},{"id":"manas-2010:p0043:b002:l007","ordinal":1298,"en":"Have the will to fight with us."},{"id":"manas-2010:p0043:b002:l008","ordinal":1299,"en":"Something else is in their words,"},{"id":"manas-2010:p0043:b002:l009","ordinal":1300,"en":"Something different in their eyes;"},{"id":"manas-2010:p0043:b002:l010","ordinal":1301,"en":"If they had the strength, these Burut"},{"id":"manas-2010:p0043:b002:l011","ordinal":1302,"en":"Would stand to fight me myself."},{"id":"manas-2010:p0043:b002:l012","ordinal":1303,"en":"Unless we take precautions now,"},{"id":"manas-2010:p0043:b002:l013","ordinal":1304,"en":"Strike them and break up their herd,"},{"id":"manas-2010:p0043:b002:l014","ordinal":1305,"en":"They will never leave us safe,"},{"id":"manas-2010:p0043:b002:l015","ordinal":1306,"en":"Unless we scatter them in every direction!"},{"id":"manas-2010:p0043:b002:l016","ordinal":1307,"en":"Put out the fires they have lit;"},{"id":"manas-2010:p0043:b002:l017","ordinal":1308,"en":"These fucking Burut,"},{"id":"manas-2010:p0043:b002:l018","ordinal":1309,"en":"Move them all away together."},{"id":"manas-2010:p0043:b002:l019","ordinal":1310,"en":"Give them no land to settle;"},{"id":"manas-2010:p0043:b002:l020","ordinal":1311,"en":"Drive one of them to the Russians,"},{"id":"manas-2010:p0043:b002:l021","ordinal":1312,"en":"Drive one of them to Iyren,"},{"id":"manas-2010:p0043:b002:l022","ordinal":1313,"en":"Cast them down into the depths!"},{"id":"manas-2010:p0043:b002:l023","ordinal":1314,"en":"Drive one to the Kazakhs;"},{"id":"manas-2010:p0043:b002:l024","ordinal":1315,"en":"Plunge them into torment like this."},{"id":"manas-2010:p0043:b002:l025","ordinal":1316,"en":"Drive one to ridge-flanked Kanggay,"},{"id":"manas-2010:p0043:b002:l026","ordinal":1317,"en":"Drive one to the Black Kalmyks of Altay;"},{"id":"manas-2010:p0043:b002:l027","ordinal":1318,"en":"Level their ancestral stronghold,"},{"id":"manas-2010:p0043:b002:l028","ordinal":1319,"en":"Drive every one away and make them disappear!”"},{"id":"manas-2010:p0043:b002:l029","ordinal":1320,"en":"At this, Molto Khan"},{"id":"manas-2010:p0043:b002:l030","ordinal":1321,"en":"Obeyed Alöökö's word."},{"id":"manas-2010:p0043:b002:l031","ordinal":1322,"en":"His extraordinary champions"},{"id":"manas-2010:p0043:b002:l032","ordinal":1323,"en":"Descended and worked their havoc;"},{"id":"manas-2010:p0043:b002:l033","ordinal":1324,"en":"Without killing or destroying them,"},{"id":"manas-2010:p0043:b002:l034","ordinal":1325,"en":"They bound them alive."},{"id":"manas-2010:p0043:b002:l035","ordinal":1326,"en":"A khan's command is not spoken twice:"},{"id":"manas-2010:p0043:b002:l036","ordinal":1327,"en":"Dear Baltay and Jakyp,"},{"id":"manas-2010:p0043:b002:l037","ordinal":1328,"en":"At the head of forty Kyrgyz households,"},{"id":"manas-2010:p0043:b002:l038","ordinal":1329,"en":"They drove toward Altay."},{"id":"manas-2010:p0043:b002:l039","ordinal":1330,"en":"One was driven to Iyren,"},{"id":"manas-2010:p0043:b002:l040","ordinal":1331,"en":"One was cast into the depths,"},{"id":"manas-2010:p0043:b002:l041","ordinal":1332,"en":"One was driven to the Russians,"},{"id":"manas-2010:p0043:b002:l042","ordinal":1333,"en":"Finding no place to settle."},{"id":"manas-2010:p0043:b002:l043","ordinal":1334,"en":"Their former grief was roused again;"},{"id":"manas-2010:p0043:b002:l044","ordinal":1335,"en":"Their whole community was scattered to dust."},{"id":"manas-2010:p0043:b002:l045","ordinal":1336,"en":"Their hands tied behind their backs,"},{"id":"manas-2010:p0043:b002:l046","ordinal":1337,"en":"Driven away in humiliation,"},{"id":"manas-2010:p0043:b002:l047","ordinal":1338,"en":"As they were being divided,"},{"id":"manas-2010:p0043:b002:l048","ordinal":1339,"en":"The people wept, the old ones wept,"},{"id":"manas-2010:p0044:b002:l001","ordinal":1340,"en":"All the people wept:"},{"id":"manas-2010:p0044:b002:l002","ordinal":1341,"en":"“Ah, Karakan, do not die,” they said,"},{"id":"manas-2010:p0044:b002:l003","ordinal":1342,"en":"“Let this people suffer no torment,” they said,"},{"id":"manas-2010:p0044:b002:l004","ordinal":1343,"en":"“Such humiliation as this,"},{"id":"manas-2010:p0044:b002:l005","ordinal":1344,"en":"Do not visit on Your servants,” they said."},{"id":"manas-2010:p0044:b002:l006","ordinal":1345,"en":"Too many sorrows to fit within their breasts,"},{"id":"manas-2010:p0044:b002:l007","ordinal":1346,"en":"The dear people who had suffered plunder"},{"id":"manas-2010:p0044:b002:l008","ordinal":1347,"en":"Shed tears in ten streams."},{"id":"manas-2010:p0044:b002:l009","ordinal":1348,"en":"Now grievous trouble was laid on them;"},{"id":"manas-2010:p0044:b002:l010","ordinal":1349,"en":"Karakan's eight sons"},{"id":"manas-2010:p0044:b002:l011","ordinal":1350,"en":"Were bound, not one left free."},{"id":"manas-2010:p0044:b002:l012","ordinal":1351,"en":"They hung their cauldrons in the place of honor,"},{"id":"manas-2010:p0044:b002:l013","ordinal":1352,"en":"Scattered all four kinds of livestock,"},{"id":"manas-2010:p0044:b002:l014","ordinal":1353,"en":"Raided the mares on the hills;"},{"id":"manas-2010:p0044:b002:l015","ordinal":1354,"en":"If anyone came near, like this,"},{"id":"manas-2010:p0044:b002:l016","ordinal":1355,"en":"They struck and splattered his brains,"},{"id":"manas-2010:p0044:b002:l017","ordinal":1356,"en":"And brought out of these people"},{"id":"manas-2010:p0044:b002:l018","ordinal":1357,"en":"Every last hidden cry of anguish."},{"id":"manas-2010:p0044:b002:l019","ordinal":1358,"en":"They bound those without strength;"},{"id":"manas-2010:p0044:b002:l020","ordinal":1359,"en":"The strong ones who resisted,"},{"id":"manas-2010:p0044:b002:l021","ordinal":1360,"en":"They seized and killed."},{"id":"manas-2010:p0044:b002:l022","ordinal":1361,"en":"The children left behind"},{"id":"manas-2010:p0044:b002:l023","ordinal":1362,"en":"They made slaves for life,"},{"id":"manas-2010:p0044:b002:l024","ordinal":1363,"en":"To the kakan's guard khan"},{"id":"manas-2010:p0044:b002:l025","ordinal":1364,"en":"They assigned them as servants."},{"id":"manas-2010:p0044:b002:l026","ordinal":1365,"en":"They beat those who had courage;"},{"id":"manas-2010:p0044:b002:l027","ordinal":1366,"en":"The women and the children"},{"id":"manas-2010:p0044:b002:l028","ordinal":1367,"en":"They pillaged and took as spoils."},{"id":"manas-2010:p0044:b002:l029","ordinal":1368,"en":"Nine thousand horses on the mountain"},{"id":"manas-2010:p0044:b002:l030","ordinal":1369,"en":"They swept away without stopping."},{"id":"manas-2010:p0044:b002:l031","ordinal":1370,"en":"The camels on the grazing grounds,"},{"id":"manas-2010:p0044:b002:l032","ordinal":1371,"en":"Alöökö slaughtered,"},{"id":"manas-2010:p0044:b002:l033","ordinal":1372,"en":"And the giants who claimed to be heroes."},{"id":"manas-2010:p0044:b002:l034","ordinal":1373,"en":"From among the women he took the skilled;"},{"id":"manas-2010:p0044:b002:l035","ordinal":1374,"en":"Alöökö, cursed be your disposition,"},{"id":"manas-2010:p0044:b002:l036","ordinal":1375,"en":"Took the girls with five locks of hair."},{"id":"manas-2010:p0044:b002:l037","ordinal":1376,"en":"They dug deep trenches,"},{"id":"manas-2010:p0044:b002:l038","ordinal":1377,"en":"Brought every misery to the boil,"},{"id":"manas-2010:p0044:b002:l039","ordinal":1378,"en":"Bound their hands, letting no one free,"},{"id":"manas-2010:p0044:b002:l040","ordinal":1379,"en":"And slaughtered every one"},{"id":"manas-2010:p0044:b002:l041","ordinal":1380,"en":"Of the leaders who might resist them."},{"id":"manas-2010:p0044:b002:l042","ordinal":1381,"en":"They raised a mottled banner,"},{"id":"manas-2010:p0044:b002:l043","ordinal":1382,"en":"Raised a din of piercing cries."},{"id":"manas-2010:p0044:b002:l044","ordinal":1383,"en":"Low lay the downward slope;"},{"id":"manas-2010:p0044:b002:l045","ordinal":1384,"en":"The Kyrgyz army was small."},{"id":"manas-2010:p0044:b002:l046","ordinal":1385,"en":"Grass sprang upward;"},{"id":"manas-2010:p0044:b002:l047","ordinal":1386,"en":"The Chinese people were many."},{"id":"manas-2010:p0044:b002:l048","ordinal":1387,"en":"They had giants of every kind,"},{"id":"manas-2010:p0045:b002:l001","ordinal":1388,"en":"Assembled from far back in their lands,"},{"id":"manas-2010:p0045:b002:l002","ordinal":1389,"en":"The mighty ones had come."},{"id":"manas-2010:p0045:b002:l003","ordinal":1390,"en":"A person who fell into their hands"},{"id":"manas-2010:p0045:b002:l004","ordinal":1391,"en":"They beat relentlessly and smashed;"},{"id":"manas-2010:p0045:b002:l005","ordinal":1392,"en":"To tear him apart was their practice."},{"id":"manas-2010:p0045:b002:l006","ordinal":1393,"en":"When someone crossed them,"},{"id":"manas-2010:p0045:b002:l007","ordinal":1394,"en":"To hack his head off with a sword"},{"id":"manas-2010:p0045:b002:l008","ordinal":1395,"en":"Was the custom of these Chinese."},{"id":"manas-2010:p0045:b002:l009","ordinal":1396,"en":"They readied their little drums"},{"id":"manas-2010:p0045:b002:l010","ordinal":1397,"en":"And plundered everything, leaving nothing."},{"id":"manas-2010:p0045:b002:l011","ordinal":1398,"en":"They made the old women weep,"},{"id":"manas-2010:p0045:b002:l012","ordinal":1399,"en":"Tormented the old men,"},{"id":"manas-2010:p0045:b002:l013","ordinal":1400,"en":"And brought unpitying strife."},{"id":"manas-2010:p0045:b002:l014","ordinal":1401,"en":"They dug up the hearths,"},{"id":"manas-2010:p0045:b002:l015","ordinal":1402,"en":"Smashed them in humiliation,"},{"id":"manas-2010:p0045:b002:l016","ordinal":1403,"en":"And scattered the Kyrgyz people."},{"id":"manas-2010:p0045:b002:l017","ordinal":1404,"en":"Acting with tyrannical power,"},{"id":"manas-2010:p0045:b002:l018","ordinal":1405,"en":"They did whatever they pleased."},{"id":"manas-2010:p0045:b002:l019","ordinal":1406,"en":"They were the people of the kakan's realm;"},{"id":"manas-2010:p0045:b002:l020","ordinal":1407,"en":"With anyone who opposed them, these Chinese"},{"id":"manas-2010:p0045:b002:l021","ordinal":1408,"en":"Had the habit of drinking his blood."},{"id":"manas-2010:p0045:b002:l022","ordinal":1409,"en":"Molto, the great Chinese lord,"},{"id":"manas-2010:p0045:b002:l023","ordinal":1410,"en":"To slaughter the Kyrgyz,"},{"id":"manas-2010:p0045:b002:l024","ordinal":1411,"en":"That gray-maned warrior,"},{"id":"manas-2010:p0045:b002:l025","ordinal":1412,"en":"Had come prowling from Kakan."},{"id":"manas-2010:p0045:b002:l026","ordinal":1413,"en":"His champions were extraordinary;"},{"id":"manas-2010:p0045:b002:l027","ordinal":1414,"en":"The infidel full of wrath"},{"id":"manas-2010:p0045:b002:l028","ordinal":1415,"en":"Had many riders mounted on elephants."},{"id":"manas-2010:p0045:b002:l029","ordinal":1416,"en":"His giants who went horseless,"},{"id":"manas-2010:p0045:b002:l030","ordinal":1417,"en":"Swarming like ants,"},{"id":"manas-2010:p0045:b002:l031","ordinal":1418,"en":"His foot soldiers came surrounding them."},{"id":"manas-2010:p0045:b002:l032","ordinal":1419,"en":"With collars about their necks,"},{"id":"manas-2010:p0045:b002:l033","ordinal":1420,"en":"His champions were of many kinds;"},{"id":"manas-2010:p0045:b002:l034","ordinal":1421,"en":"If those champions attacked,"},{"id":"manas-2010:p0045:b002:l035","ordinal":1422,"en":"They tore a person to shreds."},{"id":"manas-2010:p0045:b002:l036","ordinal":1423,"en":"At Alöökö and Molto,"},{"id":"manas-2010:p0045:b002:l037","ordinal":1424,"en":"The mind reeled; their menace was strong."},{"id":"manas-2010:p0045:b002:l038","ordinal":1425,"en":"The raging infidels"},{"id":"manas-2010:p0045:b002:l039","ordinal":1426,"en":"Leveled anyone who opposed them."},{"id":"manas-2010:p0045:b002:l040","ordinal":1427,"en":"Their champions, terrible in their fury,"},{"id":"manas-2010:p0045:b002:l041","ordinal":1428,"en":"Smashed the stone mausoleums"},{"id":"manas-2010:p0045:b002:l042","ordinal":1429,"en":"And utterly conquered the Kyrgyz."},{"id":"manas-2010:p0045:b002:l043","ordinal":1430,"en":"The hero Alöökö and Molto Khan"},{"id":"manas-2010:p0045:b002:l044","ordinal":1431,"en":"Sent their mighty army surging;"},{"id":"manas-2010:p0045:b002:l045","ordinal":1432,"en":"As they pillaged,"},{"id":"manas-2010:p0045:b002:l046","ordinal":1433,"en":"Those whose hour had come died,"},{"id":"manas-2010:p0045:b002:l047","ordinal":1434,"en":"Many Kyrgyz children died,"},{"id":"manas-2010:p0045:b002:l048","ordinal":1435,"en":"And great Döngö, khan of the Sibe,"},{"id":"manas-2010:p0046:b002:l001","ordinal":1436,"en":"Ylama from among the Kalmyks—"},{"id":"manas-2010:p0046:b002:l002","ordinal":1437,"en":"Of the clamoring infidel,"},{"id":"manas-2010:p0046:b002:l003","ordinal":1438,"en":"The hero Khan Alöökö,"},{"id":"manas-2010:p0046:b002:l004","ordinal":1439,"en":"Do not ask about this tyranny!"},{"id":"manas-2010:p0046:b002:l005","ordinal":1440,"en":"They took the cauldrons as booty,"},{"id":"manas-2010:p0046:b002:l006","ordinal":1441,"en":"Sated themselves with plunder,"},{"id":"manas-2010:p0046:b002:l007","ordinal":1442,"en":"Seethed like black spiders,"},{"id":"manas-2010:p0046:b002:l008","ordinal":1443,"en":"Swarmed till the earth was misted over."},{"id":"manas-2010:p0046:b002:l009","ordinal":1444,"en":"The sky was clear, the earth overcast;"},{"id":"manas-2010:p0046:b002:l010","ordinal":1445,"en":"The Chinese arrived in full force."},{"id":"manas-2010:p0046:b002:l011","ordinal":1446,"en":"“Alöökö's ninety camels,"},{"id":"manas-2010:p0046:b002:l012","ordinal":1447,"en":"You fucking Burut took them!” they said,"},{"id":"manas-2010:p0046:b002:l013","ordinal":1448,"en":"And the world's Last Judgment"},{"id":"manas-2010:p0046:b002:l014","ordinal":1449,"en":"They brought down upon their heads."},{"id":"manas-2010:p0046:b002:l015","ordinal":1450,"en":"To the infidel Khan Alöökö,"},{"id":"manas-2010:p0046:b002:l016","ordinal":1451,"en":"To the great lord, the hero Molto,"},{"id":"manas-2010:p0046:b002:l017","ordinal":1452,"en":"Many Kyrgyz fell as spoils."},{"id":"manas-2010:p0046:b002:l018","ordinal":1453,"en":"With not a soul to answer back,"},{"id":"manas-2010:p0046:b002:l019","ordinal":1454,"en":"Many Kyrgyz became obedient amblers."},{"id":"manas-2010:p0046:b002:l020","ordinal":1455,"en":"They burned and smashed the yurt crowns,"},{"id":"manas-2010:p0046:b002:l021","ordinal":1456,"en":"Brought hardship and made them weep,"},{"id":"manas-2010:p0046:b002:l022","ordinal":1457,"en":"Brought death upon them for certain,"},{"id":"manas-2010:p0046:b002:l023","ordinal":1458,"en":"Drained all their strength,"},{"id":"manas-2010:p0046:b002:l024","ordinal":1459,"en":"Made slaves of the men,"},{"id":"manas-2010:p0046:b002:l025","ordinal":1460,"en":"Made widows of all the women."},{"id":"manas-2010:p0046:b002:l026","ordinal":1461,"en":"Against the infidels like black spiders,"},{"id":"manas-2010:p0046:b002:l027","ordinal":1462,"en":"Not a soul could summon courage;"},{"id":"manas-2010:p0046:b002:l028","ordinal":1463,"en":"Against the redoubtable hero Döngö,"},{"id":"manas-2010:p0046:b002:l029","ordinal":1464,"en":"There was no champion, no support."},{"id":"manas-2010:p0046:b002:l030","ordinal":1465,"en":"When they faced one another,"},{"id":"manas-2010:p0046:b002:l031","ordinal":1466,"en":"There was no hero who could stand firm."},{"id":"manas-2010:p0046:b002:l032","ordinal":1467,"en":"Seen today, gone tomorrow:"},{"id":"manas-2010:p0046:b002:l033","ordinal":1468,"en":"Damn your father's grave, treacherous world!"},{"id":"manas-2010:p0046:b002:l034","ordinal":1469,"en":"Those slaughtered here were beyond counting;"},{"id":"manas-2010:p0046:b002:l035","ordinal":1470,"en":"To rescue them,"},{"id":"manas-2010:p0046:b002:l036","ordinal":1471,"en":"That Karakan was not here!"},{"id":"manas-2010:p0046:b002:l037","ordinal":1472,"en":"“Never filled by food obtained by begging,"},{"id":"manas-2010:p0046:b002:l038","ordinal":1473,"en":"Never abandoning our fierce appetite,"},{"id":"manas-2010:p0046:b002:l039","ordinal":1474,"en":"If driven out in the dark,"},{"id":"manas-2010:p0046:b002:l040","ordinal":1475,"en":"Prowling like leopards,"},{"id":"manas-2010:p0046:b002:l041","ordinal":1476,"en":"We were the dear Kyrgyz people."},{"id":"manas-2010:p0046:b002:l042","ordinal":1477,"en":"We camped along the river;"},{"id":"manas-2010:p0046:b002:l043","ordinal":1478,"en":"When the hero Karakan died,"},{"id":"manas-2010:p0046:b002:l044","ordinal":1479,"en":"We became like an extinguished fire.”"},{"id":"manas-2010:p0046:b002:l045","ordinal":1480,"en":"First of all their khan had died;"},{"id":"manas-2010:p0046:b002:l046","ordinal":1481,"en":"No one remained to find a way,"},{"id":"manas-2010:p0046:b002:l047","ordinal":1482,"en":"And all the people were dying."},{"id":"manas-2010:p0046:b002:l048","ordinal":1483,"en":"They had camped along the river,"},{"id":"manas-2010:p0047:b002:l001","ordinal":1484,"en":"With not a soul to lift them up,"},{"id":"manas-2010:p0047:b002:l002","ordinal":1485,"en":"They were like an extinguished fire."},{"id":"manas-2010:p0047:b002:l003","ordinal":1486,"en":"The heroes lay under blows,"},{"id":"manas-2010:p0047:b002:l004","ordinal":1487,"en":"The livestock stood penned in."},{"id":"manas-2010:p0047:b002:l005","ordinal":1488,"en":"“The moon is dark, nothing can be seen;"},{"id":"manas-2010:p0047:b002:l006","ordinal":1489,"en":"Such is the night,” they said."},{"id":"manas-2010:p0047:b002:l007","ordinal":1490,"en":"“Treacherous world, be damned!"},{"id":"manas-2010:p0047:b002:l008","ordinal":1491,"en":"When the Chinese fury came,"},{"id":"manas-2010:p0047:b002:l009","ordinal":1492,"en":"Such was the day for us,” they said."},{"id":"manas-2010:p0047:b002:l010","ordinal":1493,"en":"While the throng wept in anguish"},{"id":"manas-2010:p0047:b002:l011","ordinal":1494,"en":"And spoke of their sorrow,"},{"id":"manas-2010:p0047:b002:l012","ordinal":1495,"en":"Before they could open and close their mouths,"},{"id":"manas-2010:p0047:b002:l013","ordinal":1496,"en":"Before they could say this or that,"},{"id":"manas-2010:p0047:b002:l014","ordinal":1497,"en":"Alöökö from among the Chinese,"},{"id":"manas-2010:p0047:b002:l015","ordinal":1498,"en":"Muradyl of Kyrmysha,"},{"id":"manas-2010:p0047:b002:l016","ordinal":1499,"en":"Great Molto from among the Manchus,"},{"id":"manas-2010:p0047:b002:l017","ordinal":1500,"en":"The Chinese with rank buttons on their caps,"},{"id":"manas-2010:p0047:b002:l018","ordinal":1501,"en":"Their bald heads gathered;"},{"id":"manas-2010:p0047:b002:l019","ordinal":1502,"en":"Of the jacket-wearing Kalmyks,"},{"id":"manas-2010:p0047:b002:l020","ordinal":1503,"en":"Their strongest men gathered;"},{"id":"manas-2010:p0047:b002:l021","ordinal":1504,"en":"Of the sash-wearing Chinese,"},{"id":"manas-2010:p0047:b002:l022","ordinal":1505,"en":"Their warriors gathered."},{"id":"manas-2010:p0047:b002:l023","ordinal":1506,"en":"The wise and the resourceful,"},{"id":"manas-2010:p0047:b002:l024","ordinal":1507,"en":"Alöökö and mighty Molto,"},{"id":"manas-2010:p0047:b002:l025","ordinal":1508,"en":"Their best men, who knew the enemy's stratagems,"},{"id":"manas-2010:p0047:b002:l026","ordinal":1509,"en":"Those with the sharpest spears,"},{"id":"manas-2010:p0047:b002:l027","ordinal":1510,"en":"Those with the keenest swords,"},{"id":"manas-2010:p0047:b002:l028","ordinal":1511,"en":"Champions who wielded iron-headed maces,"},{"id":"manas-2010:p0047:b002:l029","ordinal":1512,"en":"Their great wise men,"},{"id":"manas-2010:p0047:b002:l030","ordinal":1513,"en":"Sorcerers who opened written books,"},{"id":"manas-2010:p0047:b002:l031","ordinal":1514,"en":"All assembled together."},{"id":"manas-2010:p0047:b002:l032","ordinal":1515,"en":"Dust curled up into the sky,"},{"id":"manas-2010:p0047:b002:l033","ordinal":1516,"en":"The Torgut gathered to a man,"},{"id":"manas-2010:p0047:b002:l034","ordinal":1517,"en":"The swordsmen made ready,"},{"id":"manas-2010:p0047:b002:l035","ordinal":1518,"en":"Their ochogor guns and battle-axes"},{"id":"manas-2010:p0047:b002:l036","ordinal":1519,"en":"They strapped on with a threatening air."},{"id":"manas-2010:p0047:b002:l037","ordinal":1520,"en":"They called the kakan's seat Beijing;"},{"id":"manas-2010:p0047:b002:l038","ordinal":1521,"en":"When your Chinese grew enraged,"},{"id":"manas-2010:p0047:b002:l039","ordinal":1522,"en":"They were a people who swept over everything."},{"id":"manas-2010:p0047:b002:l040","ordinal":1523,"en":"When their commander proclaimed an order,"},{"id":"manas-2010:p0047:b002:l041","ordinal":1524,"en":"They were a people who came to the last man."},{"id":"manas-2010:p0047:b002:l042","ordinal":1525,"en":"The handful of Kyrgyz,"},{"id":"manas-2010:p0047:b002:l043","ordinal":1526,"en":"They had utterly harried"},{"id":"manas-2010:p0047:b002:l044","ordinal":1527,"en":"And overcome."},{"id":"manas-2010:p0047:b002:l045","ordinal":1528,"en":"Whatever they themselves pleased, the Chinese"},{"id":"manas-2010:p0047:b002:l046","ordinal":1529,"en":"Were doing now."},{"id":"manas-2010:p0047:b002:l047","ordinal":1530,"en":"Taking women and girls as booty,"},{"id":"manas-2010:p0047:b002:l048","ordinal":1531,"en":"They were sated now."},{"id":"manas-2010:p0048:b002:l001","ordinal":1532,"en":"Those who answered back,"},{"id":"manas-2010:p0048:b002:l005","ordinal":1533,"en":"They dragged back and did not spare,","gapBefore":"[Source text damaged; translation unresolved]"},{"id":"manas-2010:p0048:b002:l006","ordinal":1534,"en":"But slaughtered them then."},{"id":"manas-2010:p0048:b002:l007","ordinal":1535,"en":"The teeming Chinese, the kakan's people,"},{"id":"manas-2010:p0048:b002:l008","ordinal":1536,"en":"Were sated now;"}]
