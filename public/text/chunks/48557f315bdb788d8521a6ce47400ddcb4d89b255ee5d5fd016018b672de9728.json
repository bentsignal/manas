[{"id":"semetey-1-2013:p1058:b004:l022","ordinal":156929,"en":"Such was his wisdom:"},{"id":"semetey-1-2013:p1058:b004:l023","ordinal":156930,"en":"\"He will send the pretentious Kozho"},{"id":"semetey-1-2013:p1058:b004:l024","ordinal":156931,"en":"Over the hill,\" he thought;"},{"id":"semetey-1-2013:p1058:b004:l025","ordinal":156932,"en":"\"This pig who struck from above"},{"id":"semetey-1-2013:p1058:b004:l026","ordinal":156933,"en":"Will be left disgraced.\""},{"id":"semetey-1-2013:p1058:b004:l027","ordinal":156934,"en":"As he was about to make the tale compelling,"},{"id":"semetey-1-2013:p1058:b004:l028","ordinal":156935,"en":"Toltoy and Chynkozho,"},{"id":"semetey-1-2013:p1058:b004:l029","ordinal":156936,"en":"And the swarming Zhediger—"},{"id":"semetey-1-2013:p1058:b004:l030","ordinal":156937,"en":"As he was now about to deceive them,"},{"id":"semetey-1-2013:p1058:b004:l031","ordinal":156938,"en":"\"God has taken the fool;"},{"id":"semetey-1-2013:p1058:b004:l032","ordinal":156939,"en":"He has begun the ruin now,\" he thought."},{"id":"semetey-1-2013:p1058:b004:l033","ordinal":156940,"en":"Azhybay struggled to intervene,"},{"id":"semetey-1-2013:p1058:b004:l034","ordinal":156941,"en":"Quarreling with Tümönbay."},{"id":"semetey-1-2013:p1058:b004:l035","ordinal":156942,"en":"Raging and straining,"},{"id":"semetey-1-2013:p1058:b004:l036","ordinal":156943,"en":"From the other side Chynkozho"},{"id":"semetey-1-2013:p1058:b004:l037","ordinal":156944,"en":"Now stood surging forward,"},{"id":"semetey-1-2013:p1058:b004:l038","ordinal":156945,"en":"Beating the earth as he strained,"},{"id":"semetey-1-2013:p1058:b004:l039","ordinal":156946,"en":"And surging in anger."},{"id":"semetey-1-2013:p1059:b003:l001","ordinal":156947,"en":"Toward devil-ridden Kozho,"},{"id":"semetey-1-2013:p1059:b003:l002","ordinal":156948,"en":"He now stood surging,"},{"id":"semetey-1-2013:p1059:b003:l003","ordinal":156949,"en":"And spoke to Tümönbay:"},{"id":"semetey-1-2013:p1059:b003:l004","ordinal":156950,"en":"\"You are a hero, Tümönbay;"},{"id":"semetey-1-2013:p1059:b003:l005","ordinal":156951,"en":"Your heroism has become clear."},{"id":"semetey-1-2013:p1059:b003:l006","ordinal":156952,"en":"Like a wolf among sheep,"},{"id":"semetey-1-2013:p1059:b003:l007","ordinal":156953,"en":"Your ferocity has become clear."},{"id":"semetey-1-2013:p1059:b003:l008","ordinal":156954,"en":"Among your many devils,"},{"id":"semetey-1-2013:p1059:b003:l009","ordinal":156955,"en":"Your greatness has become clear."},{"id":"semetey-1-2013:p1059:b003:l010","ordinal":156956,"en":"Like iron placed in fire,"},{"id":"semetey-1-2013:p1059:b003:l011","ordinal":156957,"en":"Your hardness has become clear."},{"id":"semetey-1-2013:p1059:b003:l012","ordinal":156958,"en":"You have surged too far, Tümönbay;"},{"id":"semetey-1-2013:p1059:b003:l013","ordinal":156959,"en":"Have you brought on my rage?"},{"id":"semetey-1-2013:p1059:b003:l014","ordinal":156960,"en":"Accursed Afghan,"},{"id":"semetey-1-2013:p1059:b003:l015","ordinal":156961,"en":"Shall I cut one of you down!\""},{"id":"semetey-1-2013:p1059:b003:l016","ordinal":156962,"en":"Chynkozho stood surging,"},{"id":"semetey-1-2013:p1059:b003:l017","ordinal":156963,"en":"And put on armor no bullet pierced;"},{"id":"semetey-1-2013:p1059:b003:l018","ordinal":156964,"en":"If you had seen Chynkozho,"},{"id":"semetey-1-2013:p1059:b003:l019","ordinal":156965,"en":"He strained like a blue bull."},{"id":"semetey-1-2013:p1059:b003:l020","ordinal":156966,"en":"He made ready to take up"},{"id":"semetey-1-2013:p1059:b003:l021","ordinal":156967,"en":"His golden-edged battle-axe;"},{"id":"semetey-1-2013:p1059:b003:l022","ordinal":156968,"en":"He roared in anger,"},{"id":"semetey-1-2013:p1059:b003:l023","ordinal":156969,"en":"Shouting the cry, \"Alaman!\""},{"id":"semetey-1-2013:p1059:b003:l024","ordinal":156970,"en":"Tölök struggled there,"},{"id":"semetey-1-2013:p1059:b003:l025","ordinal":156971,"en":"Quarreling with Chynkozho:"},{"id":"semetey-1-2013:p1059:b003:l026","ordinal":156972,"en":"\"Fool struck from above!\""},{"id":"semetey-1-2013:p1059:b003:l027","ordinal":156973,"en":"When pure God was about to grant"},{"id":"semetey-1-2013:p1059:b003:l028","ordinal":156974,"en":"The rattling Afghans to you,"},{"id":"semetey-1-2013:p1059:b003:l029","ordinal":156975,"en":"When the Afghans, drawn by the spectacle,"},{"id":"semetey-1-2013:p1059:b003:l030","ordinal":156976,"en":"Were now about to come before you,"},{"id":"semetey-1-2013:p1059:b003:l031","ordinal":156977,"en":"Why did God strike you"},{"id":"semetey-1-2013:p1059:b003:l032","ordinal":156978,"en":"So you reel in frenzy?"},{"id":"semetey-1-2013:p1059:b003:l033","ordinal":156979,"en":"If you speak evil words again,"},{"id":"semetey-1-2013:p1059:b003:l034","ordinal":156980,"en":"Will a living soul not move in anger?"},{"id":"semetey-1-2013:p1059:b003:l035","ordinal":156981,"en":"After Aychürök is given in tribute,"},{"id":"semetey-1-2013:p1059:b003:l036","ordinal":156982,"en":"Will poor Tümönbay not burn with shame?"},{"id":"semetey-1-2013:p1059:b003:l037","ordinal":156983,"en":"When matters were about to enter agreement,"},{"id":"semetey-1-2013:p1059:b003:l038","ordinal":156984,"en":"When they were about to make an offering before you,"},{"id":"semetey-1-2013:p1059:b003:l039","ordinal":156985,"en":"When they were about to give their daughter,"},{"id":"semetey-1-2013:p1059:b005:l001","ordinal":156986,"en":"You prove a foolish man;"},{"id":"semetey-1-2013:p1059:b005:l002","ordinal":156987,"en":"Why did God strike you?\""},{"id":"semetey-1-2013:p1059:b005:l003","ordinal":156988,"en":"Speaking such words,"},{"id":"semetey-1-2013:p1059:b005:l004","ordinal":156989,"en":"He spoke many words that humbled"},{"id":"semetey-1-2013:p1059:b005:l005","ordinal":156990,"en":"Kozho, son of Shygay."},{"id":"semetey-1-2013:p1059:b005:l006","ordinal":156991,"en":"Raging and making him strain,"},{"id":"semetey-1-2013:p1059:b005:l007","ordinal":156992,"en":"What could dear Tölök do?"},{"id":"semetey-1-2013:p1059:b005:l008","ordinal":156993,"en":"He held Kozho, son of Shygay,"},{"id":"semetey-1-2013:p1059:b005:l009","ordinal":156994,"en":"And kept him struggling."},{"id":"semetey-1-2013:p1059:b005:l010","ordinal":156995,"en":"Clinging without releasing him,"},{"id":"semetey-1-2013:p1059:b005:l011","ordinal":156996,"en":"Grappling with Tümönbay,"},{"id":"semetey-1-2013:p1059:b005:l012","ordinal":156997,"en":"They stopped between the sides,"},{"id":"semetey-1-2013:p1059:b005:l013","ordinal":156998,"en":"And bristled at one another."},{"id":"semetey-1-2013:p1059:b005:l014","ordinal":156999,"en":"Stopping in the space between,"},{"id":"semetey-1-2013:p1059:b005:l015","ordinal":157000,"en":"They cursed one another aloud;"},{"id":"semetey-1-2013:p1059:b005:l016","ordinal":157001,"en":"Unable to reach each other,"},{"id":"semetey-1-2013:p1059:b005:l017","ordinal":157002,"en":"They fought with their mouths."},{"id":"semetey-1-2013:p1059:b005:l018","ordinal":157003,"en":"Displaying his superiority,"},{"id":"semetey-1-2013:p1059:b005:l019","ordinal":157004,"en":"Tölök brought Kozho, son of Shygay,"},{"id":"semetey-1-2013:p1059:b005:l020","ordinal":157005,"en":"To heed his words."},{"id":"semetey-1-2013:p1059:b005:l021","ordinal":157006,"en":"Displaying his eloquence,"},{"id":"semetey-1-2013:p1059:b005:l022","ordinal":157007,"en":"Azhybay barely brought"},{"id":"semetey-1-2013:p1059:b005:l023","ordinal":157008,"en":"Tümönbay to heed his words."},{"id":"semetey-1-2013:p1059:b005:l024","ordinal":157009,"en":"Deceiving him all the while, Azhybay"},{"id":"semetey-1-2013:p1059:b005:l025","ordinal":157010,"en":"Had Tümönbay mounted"},{"id":"semetey-1-2013:p1059:b005:l026","ordinal":157011,"en":"On his black-blazed thoroughbred."},{"id":"semetey-1-2013:p1059:b005:l027","ordinal":157012,"en":"Tümönbay came to a halt."},{"id":"semetey-1-2013:p1059:b005:l028","ordinal":157013,"en":"These two among the Zhediger"},{"id":"semetey-1-2013:p1059:b005:l029","ordinal":157014,"en":"Made an entertaining tale of it;"},{"id":"semetey-1-2013:p1059:b005:l030","ordinal":157015,"en":"Tümönbay, son of Tülkü,"},{"id":"semetey-1-2013:p1059:b005:l031","ordinal":157016,"en":"Was left with a bad name."},{"id":"semetey-1-2013:p1059:b005:l032","ordinal":157017,"en":"Trampling the ground he walked,"},{"id":"semetey-1-2013:p1059:b005:l033","ordinal":157018,"en":"They spoke ill of Tümönbay."},{"id":"semetey-1-2013:p1059:b005:l034","ordinal":157019,"en":"Azhybay, son of Azhy,"},{"id":"semetey-1-2013:p1059:b005:l035","ordinal":157020,"en":"Was a swift-tongued eloquent servant,"},{"id":"semetey-1-2013:p1059:b005:l036","ordinal":157021,"en":"A son who found sound arguments;"},{"id":"semetey-1-2013:p1059:b005:l037","ordinal":157022,"en":"When he acted with wisdom,"},{"id":"semetey-1-2013:p1059:b005:l038","ordinal":157023,"en":"For the entire world"},{"id":"semetey-1-2013:p1059:b005:l039","ordinal":157024,"en":"He was a servant beyond price."},{"id":"semetey-1-2013:p1060:b003:l001","ordinal":157025,"en":"This one was fit to govern a people,"},{"id":"semetey-1-2013:p1060:b003:l002","ordinal":157026,"en":"That one was fit to remain among them."},{"id":"semetey-1-2013:p1060:b003:l003","ordinal":157027,"en":"This one was a true man."},{"id":"semetey-1-2013:p1060:b003:l004","ordinal":157028,"en":"As the Zhediger stood so,"},{"id":"semetey-1-2013:p1060:b003:l005","ordinal":157029,"en":"Raging and straining,"},{"id":"semetey-1-2013:p1060:b003:l006","ordinal":157030,"en":"Tümönbay, son of Tülkü,"},{"id":"semetey-1-2013:p1060:b003:l007","ordinal":157031,"en":"Jerking his black-blazed thoroughbred"},{"id":"semetey-1-2013:p1060:b003:l008","ordinal":157032,"en":"As though its rider had died,"},{"id":"semetey-1-2013:p1060:b003:l009","ordinal":157033,"en":"Brandishing his spear and shouting:"},{"id":"semetey-1-2013:p1060:b003:l010","ordinal":157034,"en":"\"I will make your mother my wife!"},{"id":"semetey-1-2013:p1060:b003:l011","ordinal":157035,"en":"Come out now for single combat!\""},{"id":"semetey-1-2013:p1060:b003:l012","ordinal":157036,"en":"The black-blazed thoroughbred"},{"id":"semetey-1-2013:p1060:b003:l013","ordinal":157037,"en":"He reined in and turned;"},{"id":"semetey-1-2013:p1060:b003:l014","ordinal":157038,"en":"Tümönbay, son of Tülkü,"},{"id":"semetey-1-2013:p1060:b003:l015","ordinal":157039,"en":"Surged forward holding his spear,"},{"id":"semetey-1-2013:p1060:b003:l016","ordinal":157040,"en":"And leveled it straight before him."},{"id":"semetey-1-2013:p1060:b003:l017","ordinal":157041,"en":"Tölök and Chynkozho,"},{"id":"semetey-1-2013:p1060:b003:l018","ordinal":157042,"en":"Without letting Tümönbay hear,"},{"id":"semetey-1-2013:p1060:b003:l019","ordinal":157043,"en":"Called Azhybay and spoke:"},{"id":"semetey-1-2013:p1060:b003:l020","ordinal":157044,"en":"\"You are the guardian of human honor,"},{"id":"semetey-1-2013:p1060:b003:l021","ordinal":157045,"en":"Azhybay, son of Azhy;"},{"id":"semetey-1-2013:p1060:b003:l022","ordinal":157046,"en":"You are one of the wise!"},{"id":"semetey-1-2013:p1060:b003:l023","ordinal":157047,"en":"You are skilled in speech,"},{"id":"semetey-1-2013:p1060:b003:l024","ordinal":157048,"en":"The best at loosening knots."},{"id":"semetey-1-2013:p1060:b003:l025","ordinal":157049,"en":"Judge it yourself and know yourself:"},{"id":"semetey-1-2013:p1060:b003:l026","ordinal":157050,"en":"Tümönbay, son of Tülkü,"},{"id":"semetey-1-2013:p1060:b003:l027","ordinal":157051,"en":"That ill-tempered hero—"},{"id":"semetey-1-2013:p1060:b003:l028","ordinal":157052,"en":"From now on do not let him near,"},{"id":"semetey-1-2013:p1060:b003:l029","ordinal":157053,"en":"That infidel with a white devil!"},{"id":"semetey-1-2013:p1060:b003:l030","ordinal":157054,"en":"Azhybay, son of Azhy,"},{"id":"semetey-1-2013:p1060:b003:l031","ordinal":157055,"en":"Your honesty became clear today."},{"id":"semetey-1-2013:p1060:b003:l032","ordinal":157056,"en":"Akun's daughter Chürök—"},{"id":"semetey-1-2013:p1060:b003:l033","ordinal":157057,"en":"If you will give her, tell us your trouble;"},{"id":"semetey-1-2013:p1060:b003:l034","ordinal":157058,"en":"Toltoy may take Chürök—"},{"id":"semetey-1-2013:p1060:b003:l035","ordinal":157059,"en":"Tell us the day!"},{"id":"semetey-1-2013:p1060:b003:l036","ordinal":157060,"en":"Stand beneath the banner before you leave,"},{"id":"semetey-1-2013:p1060:b003:l037","ordinal":157061,"en":"Make your pledge before you leave;"},{"id":"semetey-1-2013:p1060:b003:l038","ordinal":157062,"en":"Say, 'I shall certainly give Chürök!'"},{"id":"semetey-1-2013:p1060:b003:l039","ordinal":157063,"en":"And put the day in writing before you leave."},{"id":"semetey-1-2013:p1060:b004:l001","ordinal":157064,"en":"Take the appointed date with you;"},{"id":"semetey-1-2013:p1060:b004:l002","ordinal":157065,"en":"Say, 'I shall certainly give Chürök,'"},{"id":"semetey-1-2013:p1060:b004:l003","ordinal":157066,"en":"And make the pledge before you leave!"},{"id":"semetey-1-2013:p1060:b004:l004","ordinal":157067,"en":"We too will make a pledge;"},{"id":"semetey-1-2013:p1060:b004:l005","ordinal":157068,"en":"Swear your dying oath before you leave!"},{"id":"semetey-1-2013:p1060:b004:l006","ordinal":157069,"en":"Chew and offer the white wheat,"},{"id":"semetey-1-2013:p1060:b004:l007","ordinal":157070,"en":"And hold out the oath-token."},{"id":"semetey-1-2013:p1060:b004:l008","ordinal":157071,"en":"Let brave Toltoy be the bridegroom."},{"id":"semetey-1-2013:p1060:b004:l009","ordinal":157072,"en":"Without letting a single person know,"},{"id":"semetey-1-2013:p1060:b004:l010","ordinal":157073,"en":"Without letting a single person learn of it,"},{"id":"semetey-1-2013:p1060:b004:l011","ordinal":157074,"en":"I shall give as her bride-price"},{"id":"semetey-1-2013:p1060:b004:l012","ordinal":157075,"en":"Eight hundred black horses like hair."},{"id":"semetey-1-2013:p1060:b004:l013","ordinal":157076,"en":"For Aychürök's bride-price,"},{"id":"semetey-1-2013:p1060:b004:l014","ordinal":157077,"en":"I am now preparing to bring"},{"id":"semetey-1-2013:p1060:b004:l015","ordinal":157078,"en":"Before Khan Akun"},{"id":"semetey-1-2013:p1060:b004:l016","ordinal":157079,"en":"One thousand piebald horses like hair."},{"id":"semetey-1-2013:p1060:b004:l017","ordinal":157080,"en":"Aychürök of Khan Akun,"},{"id":"semetey-1-2013:p1060:b004:l018","ordinal":157081,"en":"The beauty whose fame has spread,"},{"id":"semetey-1-2013:p1060:b004:l019","ordinal":157082,"en":"I shall take the girl through marriage alliance;"},{"id":"semetey-1-2013:p1060:b004:l020","ordinal":157083,"en":"I shall take a skilled beauty like her."},{"id":"semetey-1-2013:p1060:b004:l021","ordinal":157084,"en":"If it can be managed, for Chürök,"},{"id":"semetey-1-2013:p1060:b004:l022","ordinal":157085,"en":"For Khan Akun himself,"},{"id":"semetey-1-2013:p1060:b004:l023","ordinal":157086,"en":"I have prepared from the beginning"},{"id":"semetey-1-2013:p1060:b004:l024","ordinal":157087,"en":"Eighty red pack-loads;"},{"id":"semetey-1-2013:p1060:b004:l025","ordinal":157088,"en":"Loaded upon those packs"},{"id":"semetey-1-2013:p1060:b004:l026","ordinal":157089,"en":"I have red gold and silk;"},{"id":"semetey-1-2013:p1060:b004:l027","ordinal":157090,"en":"To set the loads right and tie them on,"},{"id":"semetey-1-2013:p1060:b004:l028","ordinal":157091,"en":"I have exactly sixty servants."},{"id":"semetey-1-2013:p1060:b004:l029","ordinal":157092,"en":"The price of a single load"},{"id":"semetey-1-2013:p1060:b004:l030","ordinal":157093,"en":"Is the blood-price of ninety men."},{"id":"semetey-1-2013:p1060:b004:l031","ordinal":157094,"en":"I have been preparing the bride-price;"},{"id":"semetey-1-2013:p1060:b004:l032","ordinal":157095,"en":"Listen well, dear Azhy."},{"id":"semetey-1-2013:p1060:b004:l033","ordinal":157096,"en":"I too know the worth of people."},{"id":"semetey-1-2013:p1060:b004:l034","ordinal":157097,"en":"When Akun's daughter Aychürök"},{"id":"semetey-1-2013:p1060:b004:l035","ordinal":157098,"en":"And Khan Akun, without speaking ill of us,"},{"id":"semetey-1-2013:p1060:b004:l036","ordinal":157099,"en":"Come to the summer pasture,"},{"id":"semetey-1-2013:p1060:b004:l037","ordinal":157100,"en":"I have been hoping"},{"id":"semetey-1-2013:p1060:b004:l038","ordinal":157101,"en":"To surround them and make a marriage alliance."},{"id":"semetey-1-2013:p1060:b004:l039","ordinal":157102,"en":"If you give your daughter Chürök—"},{"id":"semetey-1-2013:p1061:b003:l001","ordinal":157103,"en":"I shall agree to what you say;"},{"id":"semetey-1-2013:p1061:b003:l002","ordinal":157104,"en":"I shall weigh out the gold by the pood"},{"id":"semetey-1-2013:p1061:b003:l003","ordinal":157105,"en":"And give it as the matchmaker's gift."},{"id":"semetey-1-2013:p1061:b003:l004","ordinal":157106,"en":"By wedding Toltoy,"},{"id":"semetey-1-2013:p1061:b003:l005","ordinal":157107,"en":"I shall see your sincerity."},{"id":"semetey-1-2013:p1061:b003:l006","ordinal":157108,"en":"The peri's daughter Chürök—"},{"id":"semetey-1-2013:p1061:b003:l007","ordinal":157109,"en":"If it is truly certain you will give her,"},{"id":"semetey-1-2013:p1061:b003:l008","ordinal":157110,"en":"With a golden collar and copper sleeves,"},{"id":"semetey-1-2013:p1061:b003:l009","ordinal":157111,"en":"I shall clothe you in a coat of mail;"},{"id":"semetey-1-2013:p1061:b003:l010","ordinal":157112,"en":"The Karat horse beneath me—"},{"id":"semetey-1-2013:p1061:b003:l011","ordinal":157113,"en":"I shall have you mount it."},{"id":"semetey-1-2013:p1061:b003:l012","ordinal":157114,"en":"Brave Toltoy's Surkoen"},{"id":"semetey-1-2013:p1061:b003:l013","ordinal":157115,"en":"I shall give as a ceremonial horse;"},{"id":"semetey-1-2013:p1061:b003:l014","ordinal":157116,"en":"I shall agree to what you say."},{"id":"semetey-1-2013:p1061:b003:l015","ordinal":157117,"en":"To carry your caravan's loads,"},{"id":"semetey-1-2013:p1061:b003:l016","ordinal":157118,"en":"I shall choose and give a stud camel."},{"id":"semetey-1-2013:p1061:b003:l017","ordinal":157119,"en":"If you will give Chürök,"},{"id":"semetey-1-2013:p1061:b003:l018","ordinal":157120,"en":"I shall firmly give a great bride-price."},{"id":"semetey-1-2013:p1061:b003:l019","ordinal":157121,"en":"If it lies within my reach, unstintingly"},{"id":"semetey-1-2013:p1061:b003:l020","ordinal":157122,"en":"I shall show you honor and shelter;"},{"id":"semetey-1-2013:p1061:b003:l021","ordinal":157123,"en":"As customary bride-price,"},{"id":"semetey-1-2013:p1061:b003:l022","ordinal":157124,"en":"I shall give seventy women as servants!\""},{"id":"semetey-1-2013:p1061:b003:l023","ordinal":157125,"en":"When Kozho spoke thus,"},{"id":"semetey-1-2013:p1061:b003:l024","ordinal":157126,"en":"To Kozho, who spoke empty words,"},{"id":"semetey-1-2013:p1061:b003:l025","ordinal":157127,"en":"Your Azhy bowed low;"},{"id":"semetey-1-2013:p1061:b003:l026","ordinal":157128,"en":"Rising before Kozho,"},{"id":"semetey-1-2013:p1061:b003:l027","ordinal":157129,"en":"He made obeisance to him."},{"id":"semetey-1-2013:p1061:b003:l028","ordinal":157130,"en":"Azhybay stood before Kozho:"},{"id":"semetey-1-2013:p1061:b003:l029","ordinal":157131,"en":"\"Agreed, heroic Kozho,\" he said."},{"id":"semetey-1-2013:p1061:b003:l030","ordinal":157132,"en":"\"If I do not give Aychürök,"},{"id":"semetey-1-2013:p1061:b003:l031","ordinal":157133,"en":"May my seven forefathers be infidels;"},{"id":"semetey-1-2013:p1061:b003:l032","ordinal":157134,"en":"Let him accept what I have said,"},{"id":"semetey-1-2013:p1061:b003:l033","ordinal":157135,"en":"And let your hero, bridegroom Toltoy,"},{"id":"semetey-1-2013:p1061:b003:l034","ordinal":157136,"en":"Come in seven days.\""},{"id":"semetey-1-2013:p1061:b003:l035","ordinal":157137,"en":"He pledged it and made ready;"},{"id":"semetey-1-2013:p1061:b003:l036","ordinal":157138,"en":"Azhybay rode toward the city."},{"id":"semetey-1-2013:p1061:b003:l037","ordinal":157139,"en":"Tümönbay, son of Tülkü,"},{"id":"semetey-1-2013:p1061:b003:l038","ordinal":157140,"en":"Burst from the flank in fury,"},{"id":"semetey-1-2013:p1061:b003:l039","ordinal":157141,"en":"And spoke angrily to Azhybay:"},{"id":"semetey-1-2013:p1061:b004:l001","ordinal":157142,"en":"\"You son of a bitch, Azhybay,"},{"id":"semetey-1-2013:p1061:b004:l002","ordinal":157143,"en":"Why could you not keep your mouth shut?"},{"id":"semetey-1-2013:p1061:b004:l003","ordinal":157144,"en":"Without babbling, 'I shall give the girl,'"},{"id":"semetey-1-2013:p1061:b004:l004","ordinal":157145,"en":"Taking eight hundred matching horses,"},{"id":"semetey-1-2013:p1061:b004:l005","ordinal":157146,"en":"Will you be the one made rich?!"},{"id":"semetey-1-2013:p1061:b004:l006","ordinal":157147,"en":"Eating no meat from a knucklebone,"},{"id":"semetey-1-2013:p1061:b004:l007","ordinal":157148,"en":"Riding no dappled pacing horse,"},{"id":"semetey-1-2013:p1061:b004:l008","ordinal":157149,"en":"Am I to be left forlorn?!"},{"id":"semetey-1-2013:p1061:b004:l009","ordinal":157150,"en":"Taking a thousand black camels,"},{"id":"semetey-1-2013:p1061:b004:l010","ordinal":157151,"en":"Loading gold upon their packs,"},{"id":"semetey-1-2013:p1061:b004:l011","ordinal":157152,"en":"Putting it into your treasury,"},{"id":"semetey-1-2013:p1061:b004:l012","ordinal":157153,"en":"Lying there with your belly swollen—"},{"id":"semetey-1-2013:p1061:b004:l013","ordinal":157154,"en":"Will that be you, dear Azhy?!"},{"id":"semetey-1-2013:p1061:b004:l014","ordinal":157155,"en":"Eating no knucklebone's meat,"},{"id":"semetey-1-2013:p1061:b004:l015","ordinal":157156,"en":"Riding no dappled pacing horse,"},{"id":"semetey-1-2013:p1061:b004:l016","ordinal":157157,"en":"Am I to be left forlorn?!"},{"id":"semetey-1-2013:p1061:b004:l017","ordinal":157158,"en":"God surely exists, Azhybay,"},{"id":"semetey-1-2013:p1061:b004:l018","ordinal":157159,"en":"For your speech that boasts of eloquence,"},{"id":"semetey-1-2013:p1061:b004:l019","ordinal":157160,"en":"For this boundless deed of yours."},{"id":"semetey-1-2013:p1061:b004:l020","ordinal":157161,"en":"Who will hear your words"},{"id":"semetey-1-2013:p1061:b004:l021","ordinal":157162,"en":"After this deed you have done?"},{"id":"semetey-1-2013:p1061:b004:l022","ordinal":157163,"en":"I have seen what you have done.\""},{"id":"semetey-1-2013:p1061:b004:l023","ordinal":157164,"en":"Azhybay quarreled with Tümönbay,"},{"id":"semetey-1-2013:p1061:b004:l024","ordinal":157165,"en":"And Tümönbay quarreled with Azhybay;"},{"id":"semetey-1-2013:p1061:b004:l025","ordinal":157166,"en":"They stopped there together,"},{"id":"semetey-1-2013:p1061:b004:l026","ordinal":157167,"en":"And traded angry abuse."},{"id":"semetey-1-2013:p1061:b004:l027","ordinal":157168,"en":"Toward Khan Akun's city,"},{"id":"semetey-1-2013:p1061:b004:l028","ordinal":157169,"en":"They now arrived;"},{"id":"semetey-1-2013:p1061:b004:l029","ordinal":157170,"en":"Toward Khan Akun's fortress,"},{"id":"semetey-1-2013:p1061:b004:l030","ordinal":157171,"en":"Toward the palace where the khan dwelt,"},{"id":"semetey-1-2013:p1061:b004:l031","ordinal":157172,"en":"Aychürök now kept watch."},{"id":"semetey-1-2013:p1061:b004:l032","ordinal":157173,"en":"To seize Chürök,"},{"id":"semetey-1-2013:p1061:b004:l033","ordinal":157174,"en":"To take her as a gift"},{"id":"semetey-1-2013:p1061:b004:l034","ordinal":157175,"en":"To Toltoy of the Zhediger,"},{"id":"semetey-1-2013:p1061:b004:l035","ordinal":157176,"en":"And to preserve alive"},{"id":"semetey-1-2013:p1061:b004:l036","ordinal":157177,"en":"The vast multitude of Afghans,"},{"id":"semetey-1-2013:p1061:b004:l037","ordinal":157178,"en":"Azhybay and Tümönbay"},{"id":"semetey-1-2013:p1061:b004:l038","ordinal":157179,"en":"Stalked Aychürök,"},{"id":"semetey-1-2013:p1061:b004:l039","ordinal":157180,"en":"Skirting the place where she slept."},{"id":"semetey-1-2013:p1062:b003:l001","ordinal":157181,"en":"If they came near the palace,"},{"id":"semetey-1-2013:p1062:b003:l002","ordinal":157182,"en":"Aychürök, daughter of Akun,"},{"id":"semetey-1-2013:p1062:b003:l003","ordinal":157183,"en":"Was exceedingly prudent and wise;"},{"id":"semetey-1-2013:p1062:b003:l004","ordinal":157184,"en":"Yet wit alone could not save"}]
