[{"id":"semetey-2-2013:p0023:b004:l011","ordinal":187905,"en":"Shouted and leveled their spears;"},{"id":"semetey-2-2013:p0023:b004:l012","ordinal":187906,"en":"All the Chinese and many Manchus"},{"id":"semetey-2-2013:p0023:b004:l013","ordinal":187907,"en":"Surrounded your oceanlike gray-wolf father."},{"id":"semetey-2-2013:p0023:b004:l014","ordinal":187908,"en":"At a loss and alarmed,"},{"id":"semetey-2-2013:p0023:b004:l015","ordinal":187909,"en":"When Aimanboz turned his head,"},{"id":"semetey-2-2013:p0023:b004:l016","ordinal":187910,"en":"Saying, “What remedy can there be?”"},{"id":"semetey-2-2013:p0023:b004:l017","ordinal":187911,"en":"The gray wolf stood bereft of means."},{"id":"semetey-2-2013:p0023:b004:l018","ordinal":187912,"en":"Then gold-tressed, bright-belted"},{"id":"semetey-2-2013:p0023:b004:l019","ordinal":187913,"en":"Almambet, son of Aziz Khan,"},{"id":"semetey-2-2013:p0023:b004:l020","ordinal":187914,"en":"His companion like a star at the cairn,"},{"id":"semetey-2-2013:p0023:b004:l021","ordinal":187915,"en":"The companion of Khan Manas,"},{"id":"semetey-2-2013:p0023:b004:l022","ordinal":187916,"en":"Shared one road in reconnaissance,"},{"id":"semetey-2-2013:p0023:b004:l023","ordinal":187917,"en":"And one arm in battle;"},{"id":"semetey-2-2013:p0023:b004:l024","ordinal":187918,"en":"They shared food as comrades"},{"id":"semetey-2-2013:p0023:b004:l025","ordinal":187919,"en":"And livestock in one enclosure."},{"id":"semetey-2-2013:p0023:b004:l026","ordinal":187920,"en":"Noble Alman, gray-wolf hero,"},{"id":"semetey-2-2013:p0023:b004:l027","ordinal":187921,"en":"Mounted stake-necked Sarala,"},{"id":"semetey-2-2013:p0023:b004:l028","ordinal":187922,"en":"And made him rear in battle,"},{"id":"semetey-2-2013:p0023:b004:l029","ordinal":187923,"en":"Girded his leather belt,"},{"id":"semetey-2-2013:p0023:b004:l030","ordinal":187924,"en":"And against hero Kongurbai,"},{"id":"semetey-2-2013:p0023:b004:l031","ordinal":187925,"en":"Without making support of his kalday,"},{"id":"semetey-2-2013:p0023:b004:l032","ordinal":187926,"en":"Entered the host alone and attacked."},{"id":"semetey-2-2013:p0023:b004:l033","ordinal":187927,"en":"He arrived before the arrow;"},{"id":"semetey-2-2013:p0023:b004:l034","ordinal":187928,"en":"This Kongurbai of Alööke"},{"id":"semetey-2-2013:p0023:b004:l035","ordinal":187929,"en":"Received Almambet's spear,"},{"id":"semetey-2-2013:p0023:b004:l036","ordinal":187930,"en":"Was gravely wounded,"},{"id":"semetey-2-2013:p0023:b004:l037","ordinal":187931,"en":"And immediately fared badly:"},{"id":"semetey-2-2013:p0023:b004:l038","ordinal":187932,"en":"His backside tipped from the saddle,"},{"id":"semetey-2-2013:p0023:b004:l039","ordinal":187933,"en":"And his foot slipped from the stirrup."},{"id":"semetey-2-2013:p0024:b003:l001","ordinal":187934,"en":"As the Kalcha reeled,"},{"id":"semetey-2-2013:p0024:b003:l002","ordinal":187935,"en":"Hero Alman seized him"},{"id":"semetey-2-2013:p0024:b003:l003","ordinal":187936,"en":"From the lower skirts."},{"id":"semetey-2-2013:p0024:b003:l004","ordinal":187937,"en":"He was about to stretch him out"},{"id":"semetey-2-2013:p0024:b003:l005","ordinal":187938,"en":"And slaughter him as a sacrifice."},{"id":"semetey-2-2013:p0024:b003:l006","ordinal":187939,"en":"When the crisis came,"},{"id":"semetey-2-2013:p0024:b003:l007","ordinal":187940,"en":"This accursed Black Horse"},{"id":"semetey-2-2013:p0024:b003:l008","ordinal":187941,"en":"Turned his neck like a spirit,"},{"id":"semetey-2-2013:p0024:b003:l009","ordinal":187942,"en":"And flew like an arrow"},{"id":"semetey-2-2013:p0024:b003:l010","ordinal":187943,"en":"Across cliffs a rope-length high."},{"id":"semetey-2-2013:p0024:b003:l011","ordinal":187944,"en":"Because that Black Horse was there,"},{"id":"semetey-2-2013:p0024:b003:l012","ordinal":187945,"en":"His extinguished fire was kindled,"},{"id":"semetey-2-2013:p0024:b003:l013","ordinal":187946,"en":"And his dead soul revived."},{"id":"semetey-2-2013:p0024:b003:l014","ordinal":187947,"en":"Saying this was Kongurbai the Kalcha's horse,"},{"id":"semetey-2-2013:p0024:b003:l015","ordinal":187948,"en":"Karagul said: “My dear foal,"},{"id":"semetey-2-2013:p0024:b003:l016","ordinal":187949,"en":"Choose it and ride it."},{"id":"semetey-2-2013:p0024:b003:l017","ordinal":187950,"en":"Present it as a gift"},{"id":"semetey-2-2013:p0024:b003:l018","ordinal":187951,"en":"To your aged uncle Bakai."},{"id":"semetey-2-2013:p0024:b003:l019","ordinal":187952,"en":"That foolish hero Kongurbai"},{"id":"semetey-2-2013:p0024:b003:l020","ordinal":187953,"en":"Has no other livestock,"},{"id":"semetey-2-2013:p0024:b003:l021","ordinal":187954,"en":"No other life than this."},{"id":"semetey-2-2013:p0024:b003:l022","ordinal":187955,"en":"Once he is left horseless,"},{"id":"semetey-2-2013:p0024:b003:l023","ordinal":187956,"en":"Enter straight in and make war;"},{"id":"semetey-2-2013:p0024:b003:l024","ordinal":187957,"en":"This is what I say—afterward,"},{"id":"semetey-2-2013:p0024:b003:l025","ordinal":187958,"en":"Take that slave's head.”"},{"id":"semetey-2-2013:p0024:b003:l026","ordinal":187959,"en":"Thus Karagul then"},{"id":"semetey-2-2013:p0024:b003:l027","ordinal":187960,"en":"Set about deceiving him."},{"id":"semetey-2-2013:p0024:b003:l028","ordinal":187961,"en":"Upon the foolish son of Manas,"},{"id":"semetey-2-2013:p0024:b003:l029","ordinal":187962,"en":"Saying, “This is Kongurbai's armor,”"},{"id":"semetey-2-2013:p0024:b003:l030","ordinal":187963,"en":"He put the mail coat;"},{"id":"semetey-2-2013:p0024:b003:l031","ordinal":187964,"en":"Saying, “This is Kongurbai's horse,”"},{"id":"semetey-2-2013:p0024:b003:l032","ordinal":187965,"en":"He mounted him on great Kyyduukara."},{"id":"semetey-2-2013:p0024:b003:l033","ordinal":187966,"en":"Karagul, son of Katal,"},{"id":"semetey-2-2013:p0024:b003:l034","ordinal":187967,"en":"Revealed his monstrous nature."},{"id":"semetey-2-2013:p0024:b003:l035","ordinal":187968,"en":"The Sary-Suu of Kürpüldök—"},{"id":"semetey-2-2013:p0024:b003:l036","ordinal":187969,"en":"Here was the dark hour."},{"id":"semetey-2-2013:p0024:b003:l037","ordinal":187970,"en":"Forty ropes lowered into that water"},{"id":"semetey-2-2013:p0024:b003:l038","ordinal":187971,"en":"Would not reach its depth;"},{"id":"semetey-2-2013:p0024:b003:l039","ordinal":187972,"en":"At the ford of that water,"},{"id":"semetey-2-2013:p0024:b004:l001","ordinal":187973,"en":"Even a tulpar could not pass."},{"id":"semetey-2-2013:p0024:b004:l002","ordinal":187974,"en":"Looking toward its edge,"},{"id":"semetey-2-2013:p0024:b004:l003","ordinal":187975,"en":"There was brine rising to the knees;"},{"id":"semetey-2-2013:p0024:b004:l004","ordinal":187976,"en":"Looking toward its middle,"},{"id":"semetey-2-2013:p0024:b004:l005","ordinal":187977,"en":"There was a great excavated trench."},{"id":"semetey-2-2013:p0024:b004:l006","ordinal":187978,"en":"Your hero, brave but without sense,"},{"id":"semetey-2-2013:p0024:b004:l007","ordinal":187979,"en":"Born of a warrior,"},{"id":"semetey-2-2013:p0024:b004:l008","ordinal":187980,"en":"Entered the water like fire."},{"id":"semetey-2-2013:p0024:b004:l009","ordinal":187981,"en":"Looking behind him,"},{"id":"semetey-2-2013:p0024:b004:l010","ordinal":187982,"en":"Karagul, son of Katal—"},{"id":"semetey-2-2013:p0024:b004:l011","ordinal":187983,"en":"Here was the dark hour—"},{"id":"semetey-2-2013:p0024:b004:l012","ordinal":187984,"en":"Had remained there"},{"id":"semetey-2-2013:p0024:b004:l013","ordinal":187985,"en":"With the shaggy, sore-backed five-year-old mare."},{"id":"semetey-2-2013:p0024:b004:l014","ordinal":187986,"en":"When Semetey saw it,"},{"id":"semetey-2-2013:p0024:b004:l015","ordinal":187987,"en":"He raged in anguish,"},{"id":"semetey-2-2013:p0024:b004:l016","ordinal":187988,"en":"Pleading, “Uncle!”"},{"id":"semetey-2-2013:p0024:b004:l017","ordinal":187989,"en":"“My dear uncle,"},{"id":"semetey-2-2013:p0024:b004:l018","ordinal":187990,"en":"You dug my deep trench"},{"id":"semetey-2-2013:p0024:b004:l019","ordinal":187991,"en":"And remained on the farther bank,"},{"id":"semetey-2-2013:p0024:b004:l020","ordinal":187992,"en":"Making my misery boil."},{"id":"semetey-2-2013:p0024:b004:l021","ordinal":187993,"en":"Among that vast, desolate herd,"},{"id":"semetey-2-2013:p0024:b004:l022","ordinal":187994,"en":"Uncle, was no horse allotted to you?"},{"id":"semetey-2-2013:p0024:b004:l023","ordinal":187995,"en":"Among those many desolate possessions,"},{"id":"semetey-2-2013:p0024:b004:l024","ordinal":187996,"en":"Was no coat allotted to you?"},{"id":"semetey-2-2013:p0024:b004:l025","ordinal":187997,"en":"While there was a tulpar fit for campaigns,"},{"id":"semetey-2-2013:p0024:b004:l026","ordinal":187998,"en":"Why were you humiliated by a sore-backed nag?"},{"id":"semetey-2-2013:p0024:b004:l027","ordinal":187999,"en":"While there was a tulpar with a good gait,"},{"id":"semetey-2-2013:p0024:b004:l028","ordinal":188000,"en":"Why were you humiliated by a mare?"},{"id":"semetey-2-2013:p0024:b004:l029","ordinal":188001,"en":"When we raided"},{"id":"semetey-2-2013:p0024:b004:l030","ordinal":188002,"en":"That vast, desolate herd completely"},{"id":"semetey-2-2013:p0024:b004:l031","ordinal":188003,"en":"And set it on the right road,"},{"id":"semetey-2-2013:p0024:b004:l032","ordinal":188004,"en":"When they ask, ‘Where is your uncle,"},{"id":"semetey-2-2013:p0024:b004:l033","ordinal":188005,"en":"Your father Manas's confidant,"},{"id":"semetey-2-2013:p0024:b004:l034","ordinal":188006,"en":"His companion for the afterlife?’"},{"id":"semetey-2-2013:p0024:b004:l035","ordinal":188007,"en":"What shall I say?"},{"id":"semetey-2-2013:p0024:b004:l036","ordinal":188008,"en":"Leaving you behind and driving the herd,"},{"id":"semetey-2-2013:p0024:b004:l037","ordinal":188009,"en":"Uncle, what inheritance shall I attain?"},{"id":"semetey-2-2013:p0024:b004:l038","ordinal":188010,"en":"My dear uncle, met through providence,"},{"id":"semetey-2-2013:p0024:b004:l039","ordinal":188011,"en":"My dear, beloved uncle—"},{"id":"semetey-2-2013:p0025:b003:l001","ordinal":188012,"en":"How can I abandon him?\""},{"id":"semetey-2-2013:p0025:b003:l002","ordinal":188013,"en":"So saying, Semetey"},{"id":"semetey-2-2013:p0025:b003:l003","ordinal":188014,"en":"Pulled hard upon the reins,"},{"id":"semetey-2-2013:p0025:b003:l004","ordinal":188015,"en":"But Kyldykara, fit to be slaughtered,"},{"id":"semetey-2-2013:p0025:b003:l005","ordinal":188016,"en":"Into the roaring Sary-Suu,"},{"id":"semetey-2-2013:p0025:b003:l006","ordinal":188017,"en":"Into the heart of Sary-Suu,"},{"id":"semetey-2-2013:p0025:b003:l007","ordinal":188018,"en":"Bolted away and entered."},{"id":"semetey-2-2013:p0025:b003:l008","ordinal":188019,"en":"When he reached the water,"},{"id":"semetey-2-2013:p0025:b003:l009","ordinal":188020,"en":"He fell without staying upright."},{"id":"semetey-2-2013:p0025:b003:l010","ordinal":188021,"en":"Semetey, who had deemed himself a hero,"},{"id":"semetey-2-2013:p0025:b003:l011","ordinal":188022,"en":"Plunged headfirst into the water."},{"id":"semetey-2-2013:p0025:b003:l012","ordinal":188023,"en":"Enraged and grief-stricken,"},{"id":"semetey-2-2013:p0025:b003:l013","ordinal":188024,"en":"There amid the water, from the Black Horse,"},{"id":"semetey-2-2013:p0025:b003:l014","ordinal":188025,"en":"He was torn apart and left behind."},{"id":"semetey-2-2013:p0025:b003:l015","ordinal":188026,"en":"He bobbed along like a drifting log,"},{"id":"semetey-2-2013:p0025:b003:l016","ordinal":188027,"en":"The gray wolf's head kept dipping down."},{"id":"semetey-2-2013:p0025:b003:l017","ordinal":188028,"en":"When he wrenched his precious head up,"},{"id":"semetey-2-2013:p0025:b003:l018","ordinal":188029,"en":"At times it could be seen,"},{"id":"semetey-2-2013:p0025:b003:l019","ordinal":188030,"en":"And when it vanished, thinking, \"I am dead,\""},{"id":"semetey-2-2013:p0025:b003:l020","ordinal":188031,"en":"The gray wolf's spirit faltered."},{"id":"semetey-2-2013:p0025:b003:l021","ordinal":188032,"en":"The moonless night grew dark,"},{"id":"semetey-2-2013:p0025:b003:l022","ordinal":188033,"en":"The day when death would come had arrived."},{"id":"semetey-2-2013:p0025:b003:l023","ordinal":188034,"en":"On the farther bank stood the saddle-galled bay,"},{"id":"semetey-2-2013:p0025:b003:l024","ordinal":188035,"en":"It was Algara himself,"},{"id":"semetey-2-2013:p0025:b003:l025","ordinal":188036,"en":"For that accursed man's Black Horse"},{"id":"semetey-2-2013:p0025:b003:l026","ordinal":188037,"en":"Had taken on another form just then."},{"id":"semetey-2-2013:p0025:b003:l027","ordinal":188038,"en":"Karagul, son of Katal,"},{"id":"semetey-2-2013:p0025:b003:l028","ordinal":188039,"en":"When he saw Semetey,"},{"id":"semetey-2-2013:p0025:b003:l029","ordinal":188040,"en":"Was at that moment wearing"},{"id":"semetey-2-2013:p0025:b003:l030","ordinal":188041,"en":"A felt cloak with a golden collar."},{"id":"semetey-2-2013:p0025:b003:l031","ordinal":188042,"en":"With sparse tail and little mane,"},{"id":"semetey-2-2013:p0025:b003:l032","ordinal":188043,"en":"That accursed man's Black Horse"},{"id":"semetey-2-2013:p0025:b003:l033","ordinal":188044,"en":"Was the mount he rode just then."},{"id":"semetey-2-2013:p0025:b003:l034","ordinal":188045,"en":"Look closely at Karagul's conduct,"},{"id":"semetey-2-2013:p0025:b003:l035","ordinal":188046,"en":"Here is the black-hearted man."},{"id":"semetey-2-2013:p0025:b003:l036","ordinal":188047,"en":"He was an exceptionally cunning slave,"},{"id":"semetey-2-2013:p0025:b003:l037","ordinal":188048,"en":"A stratagem that men could know,"},{"id":"semetey-2-2013:p0025:b003:l038","ordinal":188049,"en":"He was a lad who knew still more."},{"id":"semetey-2-2013:p0025:b003:l039","ordinal":188050,"en":"From the ridge the wind broke loose, glowing red,"},{"id":"semetey-2-2013:p0025:b005:l001","ordinal":188051,"en":"In the sky a leaden cloud appeared,"},{"id":"semetey-2-2013:p0025:b005:l002","ordinal":188052,"en":"Mist covered the ravine,"},{"id":"semetey-2-2013:p0025:b005:l003","ordinal":188053,"en":"And hail struck upon the foothills."},{"id":"semetey-2-2013:p0025:b005:l004","ordinal":188054,"en":"Then Karagul"},{"id":"semetey-2-2013:p0025:b005:l005","ordinal":188055,"en":"Said, \"There is no living soul but me,\""},{"id":"semetey-2-2013:p0025:b005:l006","ordinal":188056,"en":"And prayed to himself."},{"id":"semetey-2-2013:p0025:b005:l007","ordinal":188057,"en":"Upon the Black Horse beneath him,"},{"id":"semetey-2-2013:p0025:b005:l008","ordinal":188058,"en":"He struck his whip this way and that,"},{"id":"semetey-2-2013:p0025:b005:l009","ordinal":188059,"en":"And spurred him on both sides."},{"id":"semetey-2-2013:p0025:b005:l010","ordinal":188060,"en":"Such was the mischief of the raging slave,"},{"id":"semetey-2-2013:p0025:b005:l011","ordinal":188061,"en":"Such was the sport he made of the boy."},{"id":"semetey-2-2013:p0025:b005:l012","ordinal":188062,"en":"Shyta Crossing, Tash Crossing—"},{"id":"semetey-2-2013:p0025:b005:l013","ordinal":188063,"en":"For that shrewd Karagul,"},{"id":"semetey-2-2013:p0025:b005:l014","ordinal":188064,"en":"It was a crossing perfectly familiar to him."},{"id":"semetey-2-2013:p0025:b005:l015","ordinal":188065,"en":"When Karagul cracked his whip,"},{"id":"semetey-2-2013:p0025:b005:l016","ordinal":188066,"en":"Could the Black Horse fail to run?"},{"id":"semetey-2-2013:p0025:b005:l017","ordinal":188067,"en":"Crushing the ground beneath his tread,"},{"id":"semetey-2-2013:p0025:b005:l018","ordinal":188068,"en":"He sprang through Tash Crossing,"},{"id":"semetey-2-2013:p0025:b005:l019","ordinal":188069,"en":"And Karagul came out."},{"id":"semetey-2-2013:p0025:b005:l020","ordinal":188070,"en":"When he had emerged from the water,"},{"id":"semetey-2-2013:p0025:b005:l021","ordinal":188071,"en":"That fine son of Katal thought:"},{"id":"semetey-2-2013:p0025:b005:l022","ordinal":188072,"en":"\"It was I who opened the road"},{"id":"semetey-2-2013:p0025:b005:l023","ordinal":188073,"en":"From Kakan to Bakburchun;"},{"id":"semetey-2-2013:p0025:b005:l024","ordinal":188074,"en":"His father, foolish Manas,"},{"id":"semetey-2-2013:p0025:b005:l025","ordinal":188075,"en":"Was a slave whom I deceived six times."},{"id":"semetey-2-2013:p0025:b005:l026","ordinal":188076,"en":"While my mighty head remains,"},{"id":"semetey-2-2013:p0025:b005:l027","ordinal":188077,"en":"How could I give up my swift horse?"},{"id":"semetey-2-2013:p0025:b005:l028","ordinal":188078,"en":"This orphan seems to have grown bold;"},{"id":"semetey-2-2013:p0025:b005:l029","ordinal":188079,"en":"I shall try trading blows with him!"},{"id":"semetey-2-2013:p0025:b005:l030","ordinal":188080,"en":"While my heroic head remains,"},{"id":"semetey-2-2013:p0025:b005:l031","ordinal":188081,"en":"How could I give up my livestock?"},{"id":"semetey-2-2013:p0025:b005:l032","ordinal":188082,"en":"This orphan has gone mad;"},{"id":"semetey-2-2013:p0025:b005:l033","ordinal":188083,"en":"I shall try grappling with him!"},{"id":"semetey-2-2013:p0025:b005:l034","ordinal":188084,"en":"Look how the fine son of the bloodthirsty man,"},{"id":"semetey-2-2013:p0025:b005:l035","ordinal":188085,"en":"Fixing his hostile gaze upon this place,"},{"id":"semetey-2-2013:p0025:b005:l036","ordinal":188086,"en":"Has come here!"},{"id":"semetey-2-2013:p0025:b005:l037","ordinal":188087,"en":"Now, before he can so much as speak"},{"id":"semetey-2-2013:p0025:b005:l038","ordinal":188088,"en":"Or utter a word before my hand,"},{"id":"semetey-2-2013:p0025:b005:l039","ordinal":188089,"en":"Just watch him die!\""},{"id":"semetey-2-2013:p0026:b003:l001","ordinal":188090,"en":"The one who reads the stars in the heavens—"},{"id":"semetey-2-2013:p0026:b003:l002","ordinal":188091,"en":"Could it happen that"},{"id":"semetey-2-2013:p0026:b003:l003","ordinal":188092,"en":"The old scourge Bakai is his companion?"},{"id":"semetey-2-2013:p0026:b003:l004","ordinal":188093,"en":"May they not reach the very end together,"},{"id":"semetey-2-2013:p0026:b003:l005","ordinal":188094,"en":"May they not drive away entirely"},{"id":"semetey-2-2013:p0026:b003:l006","ordinal":188095,"en":"Every last thoroughbred horse."},{"id":"semetey-2-2013:p0026:b003:l007","ordinal":188096,"en":"Since I am Karagul,"},{"id":"semetey-2-2013:p0026:b003:l008","ordinal":188097,"en":"I shall unleash my wrath fiercely."},{"id":"semetey-2-2013:p0026:b003:l009","ordinal":188098,"en":"The thoroughbreds ridden into battle—"},{"id":"semetey-2-2013:p0026:b003:l010","ordinal":188099,"en":"I shall cut them off and keep every one,"},{"id":"semetey-2-2013:p0026:b003:l011","ordinal":188100,"en":"Then I shall address my words"},{"id":"semetey-2-2013:p0026:b003:l012","ordinal":188101,"en":"To the foolish son of Manas."},{"id":"semetey-2-2013:p0026:b003:l013","ordinal":188102,"en":"There is no boat on the black water;"},{"id":"semetey-2-2013:p0026:b003:l014","ordinal":188103,"en":"While Algara stands beneath me,"},{"id":"semetey-2-2013:p0026:b003:l015","ordinal":188104,"en":"There is no creature who can oppose me."},{"id":"semetey-2-2013:p0026:b003:l016","ordinal":188105,"en":"I shall avenge myself for all the past."},{"id":"semetey-2-2013:p0026:b003:l017","ordinal":188106,"en":"Saying, \"I put an end"},{"id":"semetey-2-2013:p0026:b003:l018","ordinal":188107,"en":"To the infidel son of the bloodthirsty man,\""},{"id":"semetey-2-2013:p0026:b003:l019","ordinal":188108,"en":"To the khan of Kakan,"},{"id":"semetey-2-2013:p0026:b003:l020","ordinal":188109,"en":"Before Khan Kongurbai,"},{"id":"semetey-2-2013:p0026:b003:l021","ordinal":188110,"en":"I shall go to claim my glad tidings."},{"id":"semetey-2-2013:p0026:b003:l022","ordinal":188111,"en":"If he grants it to me,"},{"id":"semetey-2-2013:p0026:b003:l023","ordinal":188112,"en":"I myself shall take the khanship of Chet-Beijing."},{"id":"semetey-2-2013:p0026:b003:l024","ordinal":188113,"en":"Today I have no equal upon the open ridge;"},{"id":"semetey-2-2013:p0026:b003:l025","ordinal":188114,"en":"While I still have my falcon's head,"},{"id":"semetey-2-2013:p0026:b003:l026","ordinal":188115,"en":"There is no death for wretched me!\""},{"id":"semetey-2-2013:p0026:b003:l027","ordinal":188116,"en":"So saying, Karagul"},{"id":"semetey-2-2013:p0026:b003:l028","ordinal":188117,"en":"Broke away along the narrow track,"},{"id":"semetey-2-2013:p0026:b003:l029","ordinal":188118,"en":"And when he reached the narrow track,"},{"id":"semetey-2-2013:p0026:b003:l030","ordinal":188119,"en":"His aspect appeared like a tiger's."},{"id":"semetey-2-2013:p0026:b003:l031","ordinal":188120,"en":"\"If he does not consent to these words of mine,"},{"id":"semetey-2-2013:p0026:b003:l032","ordinal":188121,"en":"If this year that swine does not give me"},{"id":"semetey-2-2013:p0026:b003:l033","ordinal":188122,"en":"The khanship of Chet-Beijing,"},{"id":"semetey-2-2013:p0026:b003:l034","ordinal":188123,"en":"I have rendered much service already—"},{"id":"semetey-2-2013:p0026:b003:l035","ordinal":188124,"en":"Why should I go on living here?"},{"id":"semetey-2-2013:p0026:b003:l036","ordinal":188125,"en":"I shall start a war and stir up strife,"},{"id":"semetey-2-2013:p0026:b003:l037","ordinal":188126,"en":"And go over to the Burut."},{"id":"semetey-2-2013:p0026:b003:l038","ordinal":188127,"en":"I shall gather up the credit for my valor,"},{"id":"semetey-2-2013:p0026:b003:l039","ordinal":188128,"en":"Saying, 'This here is my valor,'"},{"id":"semetey-2-2013:p0026:b004:l001","ordinal":188129,"en":"I shall set it before the eyes"},{"id":"semetey-2-2013:p0026:b004:l002","ordinal":188130,"en":"Of the bastard Kalcha."},{"id":"semetey-2-2013:p0026:b004:l003","ordinal":188131,"en":"If the fools simply grant it,"},{"id":"semetey-2-2013:p0026:b004:l004","ordinal":188132,"en":"At the very least, I shall ask for"},{"id":"semetey-2-2013:p0026:b004:l005","ordinal":188133,"en":"The khanship of the Torgout."},{"id":"semetey-2-2013:p0026:b004:l006","ordinal":188134,"en":"While I possess this valor,"},{"id":"semetey-2-2013:p0026:b004:l007","ordinal":188135,"en":"Why should I herd horses?"},{"id":"semetey-2-2013:p0026:b004:l008","ordinal":188136,"en":"I shall clash with the Kalcha;"},{"id":"semetey-2-2013:p0026:b004:l009","ordinal":188137,"en":"If he does not recognize this service of mine,"},{"id":"semetey-2-2013:p0026:b004:l010","ordinal":188138,"en":"I shall go wherever my face is turned!\""},{"id":"semetey-2-2013:p0026:b004:l011","ordinal":188139,"en":"Karagul swelled with menace,"},{"id":"semetey-2-2013:p0026:b004:l012","ordinal":188140,"en":"And this man gave a battle cry."},{"id":"semetey-2-2013:p0026:b004:l013","ordinal":188141,"en":"His courage was strong, his venom fierce—"},{"id":"semetey-2-2013:p0026:b004:l014","ordinal":188142,"en":"Give up all hope in this infidel."},{"id":"semetey-2-2013:p0026:b004:l015","ordinal":188143,"en":"Heaping up dust as high as a mountain,"},{"id":"semetey-2-2013:p0026:b004:l016","ordinal":188144,"en":"He made Algara bound onward,"},{"id":"semetey-2-2013:p0026:b004:l017","ordinal":188145,"en":"Toward the spur of a towering mountain,"},{"id":"semetey-2-2013:p0026:b004:l018","ordinal":188146,"en":"Toward a jutting headland."},{"id":"semetey-2-2013:p0026:b004:l019","ordinal":188147,"en":"Before one could say a word,"},{"id":"semetey-2-2013:p0026:b004:l020","ordinal":188148,"en":"In the time it takes to open and close the eyes,"},{"id":"semetey-2-2013:p0026:b004:l021","ordinal":188149,"en":"He arrived swifter than an arrow."},{"id":"semetey-2-2013:p0026:b004:l022","ordinal":188150,"en":"Flying like a cloud, Algara"},{"id":"semetey-2-2013:p0026:b004:l023","ordinal":188151,"en":"Among the horses before him"},{"id":"semetey-2-2013:p0026:b004:l024","ordinal":188152,"en":"Plunged straight in."},{"id":"semetey-2-2013:p0026:b004:l025","ordinal":188153,"en":"All the stallions and geldings"},{"id":"semetey-2-2013:p0026:b004:l026","ordinal":188154,"en":"Fled into the herd in agitation,"},{"id":"semetey-2-2013:p0026:b004:l027","ordinal":188155,"en":"And every thoroughbred horse"},{"id":"semetey-2-2013:p0026:b004:l028","ordinal":188156,"en":"He took, striking them into line."},{"id":"semetey-2-2013:p0026:b004:l029","ordinal":188157,"en":"\"Where is my own excited herd,"},{"id":"semetey-2-2013:p0026:b004:l030","ordinal":188158,"en":"May it burn, going?\" he cried."},{"id":"semetey-2-2013:p0026:b004:l031","ordinal":188159,"en":"Enraged and grief-stricken,"},{"id":"semetey-2-2013:p0026:b004:l032","ordinal":188160,"en":"Karagul rode ahead,"}]
