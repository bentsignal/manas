[{"id":"semetey-1-2013:p1329:b005:l006","ordinal":178689,"en":"And, if God wills, fall to a bullet;"},{"id":"semetey-1-2013:p1329:b005:l007","ordinal":178690,"en":"If I do not oppose that swine,"},{"id":"semetey-1-2013:p1329:b005:l008","ordinal":178691,"en":"The khan of the Kechil, and make him suffer,"},{"id":"semetey-1-2013:p1329:b005:l009","ordinal":178692,"en":"Making the swaggering Black Kalmak say,"},{"id":"semetey-1-2013:p1329:b005:l010","ordinal":178693,"en":"“He is the son of the Bloodletter!”"},{"id":"semetey-1-2013:p1329:b005:l011","ordinal":178694,"en":"If I do not start conflict and raise dust,"},{"id":"semetey-1-2013:p1329:b005:l012","ordinal":178695,"en":"Enter battle and take blood,"},{"id":"semetey-1-2013:p1329:b005:l013","ordinal":178696,"en":"And heap tumult upon tumult;"},{"id":"semetey-1-2013:p1329:b005:l014","ordinal":178697,"en":"If I do not go alone to face"},{"id":"semetey-1-2013:p1329:b005:l015","ordinal":178698,"en":"Kongurbai there in Beijing,"},{"id":"semetey-1-2013:p1329:b005:l016","ordinal":178699,"en":"If I do not avenge my valiant father"},{"id":"semetey-1-2013:p1329:b005:l017","ordinal":178700,"en":"Upon the Kalcha there in Beijing!"},{"id":"semetey-1-2013:p1329:b005:l018","ordinal":178701,"en":"Against the Chinese, countless as cow hairs,"},{"id":"semetey-1-2013:p1329:b005:l019","ordinal":178702,"en":"I shall wage relentless war;"},{"id":"semetey-1-2013:p1329:b005:l020","ordinal":178703,"en":"To famed Beijing"},{"id":"semetey-1-2013:p1329:b005:l021","ordinal":178704,"en":"I myself shall reach!"},{"id":"semetey-1-2013:p1329:b005:l022","ordinal":178705,"en":"How could I shamelessly gather"},{"id":"semetey-1-2013:p1329:b005:l023","ordinal":178706,"en":"The many great men among the Muslims?"},{"id":"semetey-1-2013:p1329:b005:l024","ordinal":178707,"en":"Let them say, “He is a great man’s son,”"},{"id":"semetey-1-2013:p1329:b005:l025","ordinal":178708,"en":"While I alone pursue the blood-price."},{"id":"semetey-1-2013:p1329:b005:l026","ordinal":178709,"en":"Against the infidels, swarming like black worms,"},{"id":"semetey-1-2013:p1329:b005:l027","ordinal":178710,"en":"Against hero Khan Kongurbai,"},{"id":"semetey-1-2013:p1329:b005:l028","ordinal":178711,"en":"Into their original city, Great Beijing,"},{"id":"semetey-1-2013:p1329:b005:l029","ordinal":178712,"en":"I shall enter straight and level my spear;"},{"id":"semetey-1-2013:p1329:b005:l030","ordinal":178713,"en":"Those deep-rooted infidels,"},{"id":"semetey-1-2013:p1329:b005:l031","ordinal":178714,"en":"Hero Kongurbai himself—"},{"id":"semetey-1-2013:p1329:b005:l032","ordinal":178715,"en":"I shall slaughter them all, leaving none."},{"id":"semetey-1-2013:p1329:b005:l033","ordinal":178716,"en":"Spearing and breaking their ranks,"},{"id":"semetey-1-2013:p1329:b005:l034","ordinal":178717,"en":"And, if fate arrives, falling to a bullet."},{"id":"semetey-1-2013:p1329:b005:l035","ordinal":178718,"en":"The writing of the Creator—"},{"id":"semetey-1-2013:p1329:b005:l036","ordinal":178719,"en":"If it is written upon my brow, I shall meet it;"},{"id":"semetey-1-2013:p1329:b005:l037","ordinal":178720,"en":"Making them say, “He is the Boundless One’s son,”"},{"id":"semetey-1-2013:p1329:b005:l038","ordinal":178721,"en":"Among the boundless Black Kalmak,"},{"id":"semetey-1-2013:p1330:b003:l001","ordinal":178722,"en":"Let me test myself against them!"},{"id":"semetey-1-2013:p1330:b003:l002","ordinal":178723,"en":"One who finds words in sudden danger,"},{"id":"semetey-1-2013:p1330:b003:l003","ordinal":178724,"en":"Who finds sight in darkness;"},{"id":"semetey-1-2013:p1330:b003:l004","ordinal":178725,"en":"Auspicious when placed before me,"},{"id":"semetey-1-2013:p1330:b003:l005","ordinal":178726,"en":"Like a countless host when behind me;"},{"id":"semetey-1-2013:p1330:b003:l006","ordinal":178727,"en":"My companion gathered in life,"},{"id":"semetey-1-2013:p1330:b003:l007","ordinal":178728,"en":"My fellow believer if death comes—"},{"id":"semetey-1-2013:p1330:b003:l008","ordinal":178729,"en":"My uncle Bakai, my inheritance,"},{"id":"semetey-1-2013:p1330:b003:l009","ordinal":178730,"en":"I shall take as companion to Beijing."},{"id":"semetey-1-2013:p1330:b003:l010","ordinal":178731,"en":"Do not grieve, mother;"},{"id":"semetey-1-2013:p1330:b003:l011","ordinal":178732,"en":"Thus shall I go to Beijing!"},{"id":"semetey-1-2013:p1330:b003:l012","ordinal":178733,"en":"My support when I climb,"},{"id":"semetey-1-2013:p1330:b003:l013","ordinal":178734,"en":"My prop when I descend,"},{"id":"semetey-1-2013:p1330:b003:l014","ordinal":178735,"en":"Külchoro and Kanchoro—"},{"id":"semetey-1-2013:p1330:b004:l001","ordinal":178736,"en":"My wings for circling flight,"},{"id":"semetey-1-2013:p1330:b004:l002","ordinal":178737,"en":"My tail for coming to land;"},{"id":"semetey-1-2013:p1330:b004:l003","ordinal":178738,"en":"Külchoro and Kanchoro,"},{"id":"semetey-1-2013:p1330:b004:l004","ordinal":178739,"en":"The two are my younger brothers."},{"id":"semetey-1-2013:p1330:b004:l005","ordinal":178740,"en":"I shall take both nest-mates,"},{"id":"semetey-1-2013:p1330:b004:l006","ordinal":178741,"en":"And against Chinese as numerous as cow hairs"},{"id":"semetey-1-2013:p1330:b004:l007","ordinal":178742,"en":"Unleash such conflict!”"},{"id":"semetey-1-2013:p1330:b004:l008","ordinal":178743,"en":"The fine hero, son of Manas,"},{"id":"semetey-1-2013:p1330:b004:l009","ordinal":178744,"en":"The lion supported by the spirits,"},{"id":"semetey-1-2013:p1330:b004:l010","ordinal":178745,"en":"Had scarcely closed his mouth"},{"id":"semetey-1-2013:p1330:b004:l011","ordinal":178746,"en":"When his uncle, elder Bakai,"},{"id":"semetey-1-2013:p1330:b004:l012","ordinal":178747,"en":"A saint who had seen much,"},{"id":"semetey-1-2013:p1330:b004:l013","ordinal":178748,"en":"To the young son of Manas"},{"id":"semetey-1-2013:p1330:b004:l014","ordinal":178749,"en":"Began to speak in a ringing voice."},{"id":"semetey-1-2013:p1330:b006:l001","ordinal":178750,"en":"These were Bakai's words:"},{"id":"semetey-1-2013:p1330:b006:l002","ordinal":178751,"en":"“My foal, my son Semetey!"},{"id":"semetey-1-2013:p1330:b006:l003","ordinal":178752,"en":"God granted my wish;"},{"id":"semetey-1-2013:p1330:b006:l004","ordinal":178753,"en":"This very year your age"},{"id":"semetey-1-2013:p1330:b006:l005","ordinal":178754,"en":"Has reached twenty-five."},{"id":"semetey-1-2013:p1330:b006:l006","ordinal":178755,"en":"Yesterday, while my companion Manas lived,"},{"id":"semetey-1-2013:p1330:b006:l007","ordinal":178756,"en":"While his fortune remained whole,"},{"id":"semetey-1-2013:p1330:b006:l008","ordinal":178757,"en":"He used to heed my counsel,"},{"id":"semetey-1-2013:p1330:b006:l009","ordinal":178758,"en":"And listen to my admonition;"},{"id":"semetey-1-2013:p1330:b006:l010","ordinal":178759,"en":"He knew what I told him."},{"id":"semetey-1-2013:p1330:b006:l011","ordinal":178760,"en":"I have spoken precious words—understand;"},{"id":"semetey-1-2013:p1330:b006:l012","ordinal":178761,"en":"My blessed son, heed me!"},{"id":"semetey-1-2013:p1330:b006:l013","ordinal":178762,"en":"This year you went to Khan Akun,"},{"id":"semetey-1-2013:p1330:b006:l014","ordinal":178763,"en":"And newly took Aychürök;"},{"id":"semetey-1-2013:p1330:b006:l015","ordinal":178764,"en":"If you wish, my son, heed me—"},{"id":"semetey-1-2013:p1330:b006:l016","ordinal":178765,"en":"You have become a bloodied foot."},{"id":"semetey-1-2013:p1330:b006:l017","ordinal":178766,"en":"Remain here this year;"},{"id":"semetey-1-2013:p1330:b006:l018","ordinal":178767,"en":"Let us grow fat and refreshed,"},{"id":"semetey-1-2013:p1330:b006:l019","ordinal":178768,"en":"Hunt game and make sport,"},{"id":"semetey-1-2013:p1330:b006:l020","ordinal":178769,"en":"Tell tales and raise a clamor,"},{"id":"semetey-1-2013:p1330:b006:l021","ordinal":178770,"en":"And chase and shoot wild asses!"},{"id":"semetey-1-2013:p1330:b007:l001","ordinal":178771,"en":"Let this year pass,"},{"id":"semetey-1-2013:p1330:b007:l002","ordinal":178772,"en":"And go in the following year!"},{"id":"semetey-1-2013:p1330:b007:l003","ordinal":178773,"en":"By the road I myself have seen,"},{"id":"semetey-1-2013:p1330:b007:l004","ordinal":178774,"en":"Along valleys, springs, and streams,"},{"id":"semetey-1-2013:p1330:b007:l005","ordinal":178775,"en":"Let me lead the way myself,"},{"id":"semetey-1-2013:p1330:b007:l006","ordinal":178776,"en":"And against the Manchu khan of the Kechil"},{"id":"semetey-1-2013:p1330:b007:l007","ordinal":178777,"en":"Let us wage war at full breadth!"},{"id":"semetey-1-2013:p1330:b007:l008","ordinal":178778,"en":"My son, your strength is tired; gird your waist;"},{"id":"semetey-1-2013:p1330:b007:l009","ordinal":178779,"en":"This year let us grow fat and refreshed!"},{"id":"semetey-1-2013:p1330:b007:l010","ordinal":178780,"en":"If you heed me, my only one,"},{"id":"semetey-1-2013:p1330:b007:l011","ordinal":178781,"en":"Let us go to Beijing next year!"},{"id":"semetey-1-2013:p1330:b007:l012","ordinal":178782,"en":"My young prince's son,"},{"id":"semetey-1-2013:p1330:b007:l013","ordinal":178783,"en":"Let us wage war next year!"},{"id":"semetey-1-2013:p1330:b007:l014","ordinal":178784,"en":"Upon the soil of the earth"},{"id":"semetey-1-2013:p1330:b007:l015","ordinal":178785,"en":"There are Muslim giants;"},{"id":"semetey-1-2013:p1330:b007:l016","ordinal":178786,"en":"If you summon them, will your strength not suffice?"},{"id":"semetey-1-2013:p1330:b007:l017","ordinal":178787,"en":"Gather a select army completely!"},{"id":"semetey-1-2013:p1330:b007:l018","ordinal":178788,"en":"Gather a great army!"},{"id":"semetey-1-2013:p1330:b007:l019","ordinal":178789,"en":"The twelve Muslim tribes—"},{"id":"semetey-1-2013:p1330:b007:l020","ordinal":178790,"en":"Let us assemble them together,"},{"id":"semetey-1-2013:p1330:b007:l021","ordinal":178791,"en":"Their proud warriors,"},{"id":"semetey-1-2013:p1331:b003:l001","ordinal":178792,"en":"The heroes who enter battle,"},{"id":"semetey-1-2013:p1331:b003:l002","ordinal":178793,"en":"The most skillful spearmen,"},{"id":"semetey-1-2013:p1331:b003:l003","ordinal":178794,"en":"The finest, complete in stratagems—"},{"id":"semetey-1-2013:p1331:b003:l004","ordinal":178795,"en":"Let us summon and gather them,"},{"id":"semetey-1-2013:p1331:b003:l005","ordinal":178796,"en":"And against infidels like black worms,"},{"id":"semetey-1-2013:p1331:b003:l006","ordinal":178797,"en":"Against hero Khan Kongurbai,"},{"id":"semetey-1-2013:p1331:b003:l007","ordinal":178798,"en":"Let us wage war without fleeing!"},{"id":"semetey-1-2013:p1331:b003:l008","ordinal":178799,"en":"Understand what I have said;"},{"id":"semetey-1-2013:p1331:b003:l009","ordinal":178800,"en":"My auspicious son, heed me."},{"id":"semetey-1-2013:p1331:b003:l010","ordinal":178801,"en":"While gray wolf Manas lived,"},{"id":"semetey-1-2013:p1331:b003:l011","ordinal":178802,"en":"The whole world stirred;"},{"id":"semetey-1-2013:p1331:b003:l012","ordinal":178803,"en":"Kakan-Chyn is no easy place."},{"id":"semetey-1-2013:p1331:b003:l013","ordinal":178804,"en":"When he campaigned against Beijing,"},{"id":"semetey-1-2013:p1331:b003:l014","ordinal":178805,"en":"There were four hundred twenty thousand troops;"},{"id":"semetey-1-2013:p1331:b003:l015","ordinal":178806,"en":"Heroes went and khans went,"},{"id":"semetey-1-2013:p1331:b003:l016","ordinal":178807,"en":"And to costly Beijing"},{"id":"semetey-1-2013:p1331:b003:l017","ordinal":178808,"en":"Men came even from India."},{"id":"semetey-1-2013:p1331:b003:l018","ordinal":178809,"en":"Many a lone hero went;"},{"id":"semetey-1-2013:p1331:b003:l019","ordinal":178810,"en":"Those who went to Beijing"},{"id":"semetey-1-2013:p1331:b003:l020","ordinal":178811,"en":"Went prepared for death,"},{"id":"semetey-1-2013:p1331:b003:l021","ordinal":178812,"en":"Saying, ‘From Kakan-Chyn's Beijing"},{"id":"semetey-1-2013:p1331:b003:l022","ordinal":178813,"en":"I shall not turn back.’"},{"id":"semetey-1-2013:p1331:b003:l023","ordinal":178814,"en":"Talas filled and the land glittered;"},{"id":"semetey-1-2013:p1331:b003:l024","ordinal":178815,"en":"Your formidable lion elder"},{"id":"semetey-1-2013:p1331:b003:l025","ordinal":178816,"en":"Drove all those people onward"},{"id":"semetey-1-2013:p1331:b003:l026","ordinal":178817,"en":"In a packed multitude."},{"id":"semetey-1-2013:p1331:b003:l027","ordinal":178818,"en":"His stride reached Beijing,"},{"id":"semetey-1-2013:p1331:b003:l028","ordinal":178819,"en":"And he humbled it without regret,"},{"id":"semetey-1-2013:p1331:b003:l029","ordinal":178820,"en":"Though the Muslims seemed palm-sized."},{"id":"semetey-1-2013:p1331:b003:l030","ordinal":178821,"en":"Whoever said, ‘My horse is unmatched,’"},{"id":"semetey-1-2013:p1331:b003:l031","ordinal":178822,"en":"He said, ‘I shall slaughter and eat his horse’;"},{"id":"semetey-1-2013:p1331:b003:l032","ordinal":178823,"en":"Your father, the gray wolf lion,"},{"id":"semetey-1-2013:p1331:b003:l033","ordinal":178824,"en":"Drove them by force."},{"id":"semetey-1-2013:p1331:b003:l034","ordinal":178825,"en":"Beijing is no cheap place;"},{"id":"semetey-1-2013:p1331:b003:l035","ordinal":178826,"en":"To a man who goes alone,"},{"id":"semetey-1-2013:p1331:b003:l036","ordinal":178827,"en":"That Beijing is no people"},{"id":"semetey-1-2013:p1331:b003:l037","ordinal":178828,"en":"Who would give even a saddlebag as blood-price."},{"id":"semetey-1-2013:p1331:b003:l038","ordinal":178829,"en":"They are no people against whom one goes alone for vengeance;"},{"id":"semetey-1-2013:p1331:b003:l039","ordinal":178830,"en":"They are no bare-chested,"},{"id":"semetey-1-2013:p1331:b005:l001","ordinal":178831,"en":"Open-shirted Bukharan folk."},{"id":"semetey-1-2013:p1331:b005:l002","ordinal":178832,"en":"They are no people of Kokon Khan,"},{"id":"semetey-1-2013:p1331:b005:l003","ordinal":178833,"en":"Whom one humiliates and reduces to misery,"},{"id":"semetey-1-2013:p1331:b005:l004","ordinal":178834,"en":"Yet survives among them for a month."},{"id":"semetey-1-2013:p1331:b005:l005","ordinal":178835,"en":"In Chinmachin's Beijing,"},{"id":"semetey-1-2013:p1331:b005:l006","ordinal":178836,"en":"That people has a true army;"},{"id":"semetey-1-2013:p1331:b005:l007","ordinal":178837,"en":"They are no people who avoid contest,"},{"id":"semetey-1-2013:p1331:b005:l008","ordinal":178838,"en":"Nor a place that leaves conflict unanswered."},{"id":"semetey-1-2013:p1331:b005:l009","ordinal":178839,"en":"Your talk of shamelessly going alone"},{"id":"semetey-1-2013:p1331:b005:l010","ordinal":178840,"en":"Is no proper word."},{"id":"semetey-1-2013:p1331:b005:l011","ordinal":178841,"en":"Here are the eyes that went and saw;"},{"id":"semetey-1-2013:p1331:b005:l012","ordinal":178842,"en":"Here are the words long spoken."},{"id":"semetey-1-2013:p1331:b005:l013","ordinal":178843,"en":"This is the hand that crushed them;"},{"id":"semetey-1-2013:p1331:b005:l014","ordinal":178844,"en":"I am the one who fought them."},{"id":"semetey-1-2013:p1331:b005:l015","ordinal":178845,"en":"Wading through black blood,"},{"id":"semetey-1-2013:p1331:b005:l016","ordinal":178846,"en":"Your dear uncle, Khan Bakai,"},{"id":"semetey-1-2013:p1331:b005:l017","ordinal":178847,"en":"While his bloodthirsty lord lived,"},{"id":"semetey-1-2013:p1331:b005:l018","ordinal":178848,"en":"Fought six months without fleeing."},{"id":"semetey-1-2013:p1331:b005:l019","ordinal":178849,"en":"Yielding nothing to the lion hero,"},{"id":"semetey-1-2013:p1331:b005:l020","ordinal":178850,"en":"Neither advancing nor retreating,"},{"id":"semetey-1-2013:p1331:b005:l021","ordinal":178851,"en":"They stood midway."},{"id":"semetey-1-2013:p1331:b005:l022","ordinal":178852,"en":"Lion Syrgak and Almambet,"},{"id":"semetey-1-2013:p1331:b005:l023","ordinal":178853,"en":"Until the soft reeds ripened,"},{"id":"semetey-1-2013:p1331:b005:l024","ordinal":178854,"en":"Until the flower of the myyzam season flew,"},{"id":"semetey-1-2013:p1331:b005:l025","ordinal":178855,"en":"Fought fiercely for six months."},{"id":"semetey-1-2013:p1331:b005:l026","ordinal":178856,"en":"Spears broke with a crash,"},{"id":"semetey-1-2013:p1331:b005:l027","ordinal":178857,"en":"And slaughtered peoples cried out."},{"id":"semetey-1-2013:p1331:b005:l028","ordinal":178858,"en":"Heroes died and lions died;"},{"id":"semetey-1-2013:p1331:b005:l029","ordinal":178859,"en":"In that holy war,"},{"id":"semetey-1-2013:p1331:b005:l030","ordinal":178860,"en":"Chinese and Kyrgyz died alike."},{"id":"semetey-1-2013:p1331:b005:l031","ordinal":178861,"en":"If you face Beijing, there are wonders;"},{"id":"semetey-1-2013:p1331:b005:l032","ordinal":178862,"en":"It is a great fortified city,"},{"id":"semetey-1-2013:p1331:b005:l033","ordinal":178863,"en":"With ramparts that have endured much."},{"id":"semetey-1-2013:p1331:b005:l034","ordinal":178864,"en":"Your blessed uncle Bakai"},{"id":"semetey-1-2013:p1331:b005:l035","ordinal":178865,"en":"Has many epic tales of it."},{"id":"semetey-1-2013:p1331:b005:l036","ordinal":178866,"en":"The road to Beijing divides five ways;"},{"id":"semetey-1-2013:p1331:b005:l037","ordinal":178867,"en":"Do not say, ‘I shall send my army to Beijing,’"},{"id":"semetey-1-2013:p1331:b005:l038","ordinal":178868,"en":"And bring peril upon your own head."},{"id":"semetey-1-2013:p1331:b005:l039","ordinal":178869,"en":"The road to Beijing has five branches;"},{"id":"semetey-1-2013:p1332:b003:l001","ordinal":178870,"en":"If you do not watch carefully, my son, the affair is dire."},{"id":"semetey-1-2013:p1332:b003:l002","ordinal":178871,"en":"One road to Beijing"},{"id":"semetey-1-2013:p1332:b003:l003","ordinal":178872,"en":"Has a pit dug across it;"},{"id":"semetey-1-2013:p1332:b003:l004","ordinal":178873,"en":"Another road to Beijing"},{"id":"semetey-1-2013:p1332:b003:l005","ordinal":178874,"en":"Has brine in which one sinks."},{"id":"semetey-1-2013:p1332:b003:l006","ordinal":178875,"en":"It has a Kaldai and a khan;"},{"id":"semetey-1-2013:p1332:b003:l007","ordinal":178876,"en":"That swine doomed to burn"},{"id":"semetey-1-2013:p1332:b003:l008","ordinal":178877,"en":"Has even beasts standing guard."},{"id":"semetey-1-2013:p1332:b003:l009","ordinal":178878,"en":"It has a firmly fortified pass;"},{"id":"semetey-1-2013:p1332:b003:l010","ordinal":178879,"en":"The Chinese are no idle people,"},{"id":"semetey-1-2013:p1332:b003:l011","ordinal":178880,"en":"And have places that bring disaster."},{"id":"semetey-1-2013:p1332:b003:l012","ordinal":178881,"en":"A khan stands among its guards;"},{"id":"semetey-1-2013:p1332:b003:l013","ordinal":178882,"en":"That swine doomed to burn"},{"id":"semetey-1-2013:p1332:b003:l014","ordinal":178883,"en":"Has stationed sorcerers,"},{"id":"semetey-1-2013:p1332:b003:l015","ordinal":178884,"en":"And every kind of watchman."},{"id":"semetey-1-2013:p1332:b003:l016","ordinal":178885,"en":"Beyond the sentry post"},{"id":"semetey-1-2013:p1332:b003:l017","ordinal":178886,"en":"Is a giant who guards the road;"},{"id":"semetey-1-2013:p1332:b003:l018","ordinal":178887,"en":"It is that infidel's custom"},{"id":"semetey-1-2013:p1332:b003:l019","ordinal":178888,"en":"To cut down whoever approaches."},{"id":"semetey-1-2013:p1332:b003:l020","ordinal":178889,"en":"At the infidel's crossing"},{"id":"semetey-1-2013:p1332:b003:l021","ordinal":178890,"en":"Are Kerik and Bil;"},{"id":"semetey-1-2013:p1332:b003:l022","ordinal":178891,"en":"My contrary one, let me appeal to you—"},{"id":"semetey-1-2013:p1332:b003:l023","ordinal":178892,"en":"Listen, my only one, and heed me!"},{"id":"semetey-1-2013:p1332:b003:l024","ordinal":178893,"en":"Such is the nature of conflict;"},{"id":"semetey-1-2013:p1332:b003:l025","ordinal":178894,"en":"I tell it, my son—understand!"},{"id":"semetey-1-2013:p1332:b003:l026","ordinal":178895,"en":"One road to Beijing"},{"id":"semetey-1-2013:p1332:b003:l027","ordinal":178896,"en":"Lets no one encountered escape alive;"},{"id":"semetey-1-2013:p1332:b003:l028","ordinal":178897,"en":"One road to Beijing"},{"id":"semetey-1-2013:p1332:b003:l029","ordinal":178898,"en":"Lets no one who meets it return alive."},{"id":"semetey-1-2013:p1332:b003:l030","ordinal":178899,"en":"An army awaits from Kaldai;"},{"id":"semetey-1-2013:p1332:b003:l031","ordinal":178900,"en":"The Black Chinese of Beijing"},{"id":"semetey-1-2013:p1332:b003:l032","ordinal":178901,"en":"Have a tale without end."},{"id":"semetey-1-2013:p1332:b003:l033","ordinal":178902,"en":"One road to Beijing"},{"id":"semetey-1-2013:p1332:b003:l034","ordinal":178903,"en":"Has a desert forty days across;"},{"id":"semetey-1-2013:p1332:b003:l035","ordinal":178904,"en":"Accursed Beijing"},{"id":"semetey-1-2013:p1332:b003:l036","ordinal":178905,"en":"Has many such tales."},{"id":"semetey-1-2013:p1332:b003:l037","ordinal":178906,"en":"If you ask the nature of the desert:"},{"id":"semetey-1-2013:p1332:b003:l038","ordinal":178907,"en":"Gray haze and burning dust;"},{"id":"semetey-1-2013:p1332:b003:l039","ordinal":178908,"en":"Many a soul, mouth hanging open,"},{"id":"semetey-1-2013:p1332:b004:l001","ordinal":178909,"en":"Upon reaching that desert,"},{"id":"semetey-1-2013:p1332:b004:l002","ordinal":178910,"en":"Died there gasping."},{"id":"semetey-1-2013:p1332:b004:l003","ordinal":178911,"en":"You have rolled up your sleeves,"},{"id":"semetey-1-2013:p1332:b004:l004","ordinal":178912,"en":"Saying you will enter straight"},{"id":"semetey-1-2013:p1332:b004:l005","ordinal":178913,"en":"And fight costly Beijing!"},{"id":"semetey-1-2013:p1332:b004:l006","ordinal":178914,"en":"Your uncle Bakai has grown old—"},{"id":"semetey-1-2013:p1332:b004:l007","ordinal":178915,"en":"Would you throw him to the khagan!"},{"id":"semetey-1-2013:p1332:b004:l008","ordinal":178916,"en":"If you grapple with Beijing,"},{"id":"semetey-1-2013:p1332:b004:l009","ordinal":178917,"en":"You need provisions and coats;"},{"id":"semetey-1-2013:p1332:b004:l010","ordinal":178918,"en":"Gather them from across the world,"},{"id":"semetey-1-2013:p1332:b004:l011","ordinal":178919,"en":"And you need at least ten thousand troops."},{"id":"semetey-1-2013:p1332:b004:l012","ordinal":178920,"en":"When you reach that desert,"},{"id":"semetey-1-2013:p1332:b004:l013","ordinal":178921,"en":"You need bull camels to haul the loads;"},{"id":"semetey-1-2013:p1332:b004:l014","ordinal":178922,"en":"The one you grapple is Kakan-Chyn—"},{"id":"semetey-1-2013:p1332:b004:l015","ordinal":178923,"en":"You need many things such as these!"},{"id":"semetey-1-2013:p1332:b004:l016","ordinal":178924,"en":"When you reach that desert,"},{"id":"semetey-1-2013:p1332:b004:l017","ordinal":178925,"en":"There is no grass to pinch and eat,"},{"id":"semetey-1-2013:p1332:b004:l018","ordinal":178926,"en":"No water to sip even a mouthful."},{"id":"semetey-1-2013:p1332:b004:l019","ordinal":178927,"en":"When a sandgrouse flies it is exhausted;"},{"id":"semetey-1-2013:p1332:b004:l020","ordinal":178928,"en":"When a black vulture flies,"},{"id":"semetey-1-2013:p1332:b004:l021","ordinal":178929,"en":"Its wings burn and tire."},{"id":"semetey-1-2013:p1332:b004:l022","ordinal":178930,"en":"A hero's eyes grow dim."},{"id":"semetey-1-2013:p1332:b004:l023","ordinal":178931,"en":"When crossing that desert,"},{"id":"semetey-1-2013:p1332:b004:l024","ordinal":178932,"en":"Your horse staggers in exhaustion;"},{"id":"semetey-1-2013:p1332:b004:l025","ordinal":178933,"en":"When you are losing consciousness,"},{"id":"semetey-1-2013:p1332:b004:l026","ordinal":178934,"en":"The accursed Chinese"},{"id":"semetey-1-2013:p1332:b004:l027","ordinal":178935,"en":"Have yet another wonder:"},{"id":"semetey-1-2013:p1332:b004:l028","ordinal":178936,"en":"They have a teeming people,"},{"id":"semetey-1-2013:p1332:b004:l029","ordinal":178937,"en":"And among that people"},{"id":"semetey-1-2013:p1332:b004:l030","ordinal":178938,"en":"Are giants of many kinds."},{"id":"semetey-1-2013:p1332:b004:l031","ordinal":178939,"en":"When they see an enemy, they strain;"},{"id":"semetey-1-2013:p1332:b004:l032","ordinal":178940,"en":"One begins the war song,"},{"id":"semetey-1-2013:p1332:b004:l033","ordinal":178941,"en":"And when he charges in wrath,"},{"id":"semetey-1-2013:p1332:b004:l034","ordinal":178942,"en":"There are giants among the infidels."},{"id":"semetey-1-2013:p1332:b004:l035","ordinal":178943,"en":"There is a fleet horseman"},{"id":"semetey-1-2013:p1332:b004:l036","ordinal":178944,"en":"Who can strike a camel flat with one blow."}]
