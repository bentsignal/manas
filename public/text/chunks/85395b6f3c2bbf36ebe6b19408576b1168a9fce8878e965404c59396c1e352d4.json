[{"id":"manas-2010:p0707:b001:l035","ordinal":31489,"en":"“Now we have escaped the slave,” he said."},{"id":"manas-2010:p0707:b001:l036","ordinal":31490,"en":"On the broad plain of Kulan and Ak-Chiy,"},{"id":"manas-2010:p0707:b001:l037","ordinal":31491,"en":"He unloaded the burdens, they say;"},{"id":"manas-2010:p0707:b001:l038","ordinal":31492,"en":"He let the animals rest, they say."},{"id":"manas-2010:p0707:b001:l039","ordinal":31493,"en":"Alöökö fled away."},{"id":"manas-2010:p0707:b001:l040","ordinal":31494,"en":"Let us leave him there."},{"id":"manas-2010:p0707:b001:l041","ordinal":31495,"en":"Warrior Manas, the blood-stained lion,"},{"id":"manas-2010:p0707:b001:l042","ordinal":31496,"en":"With Ajybay following him,"},{"id":"manas-2010:p0708:b001:l001","ordinal":31497,"en":"Let us begin telling of him."},{"id":"manas-2010:p0708:b001:l002","ordinal":31498,"en":"He has his khans Ajybay and Bakay;"},{"id":"manas-2010:p0708:b001:l003","ordinal":31499,"en":"Who never draw back from fire,"},{"id":"manas-2010:p0708:b001:l004","ordinal":31500,"en":"All forty mighty men are there."},{"id":"manas-2010:p0708:b001:l005","ordinal":31501,"en":"To attack Alöökö,"},{"id":"manas-2010:p0708:b001:l006","ordinal":31502,"en":"There are eighty-four armed men;"},{"id":"manas-2010:p0708:b001:l007","ordinal":31503,"en":"Where they strike becomes red fire."},{"id":"manas-2010:p0708:b001:l008","ordinal":31504,"en":"They carry a banner with a golden crescent;"},{"id":"manas-2010:p0708:b001:l009","ordinal":31505,"en":"Their dust streams up into the sky."},{"id":"manas-2010:p0708:b001:l010","ordinal":31506,"en":"What the forty companions wear"},{"id":"manas-2010:p0708:b001:l011","ordinal":31507,"en":"Is double mail with lark-eye rings."},{"id":"manas-2010:p0708:b001:l012","ordinal":31508,"en":"All forty companions,"},{"id":"manas-2010:p0708:b001:l013","ordinal":31509,"en":"Their elders headed by Kyrgyl,"},{"id":"manas-2010:p0708:b001:l014","ordinal":31510,"en":"Turn their faces to wrath,"},{"id":"manas-2010:p0708:b001:l015","ordinal":31511,"en":"Girded with unsheathed swords."},{"id":"manas-2010:p0708:b001:l016","ordinal":31512,"en":"What the forty companions ride"},{"id":"manas-2010:p0708:b001:l017","ordinal":31513,"en":"Are Karabayyr thoroughbreds,"},{"id":"manas-2010:p0708:b001:l018","ordinal":31514,"en":"With sieve-like lungs and copper forelegs."},{"id":"manas-2010:p0708:b001:l019","ordinal":31515,"en":"Mounted fittingly upon their horses,"},{"id":"manas-2010:p0708:b001:l020","ordinal":31516,"en":"Their flowing tails knotted tight,"},{"id":"manas-2010:p0708:b001:l021","ordinal":31517,"en":"Spears swaying in their hands,"},{"id":"manas-2010:p0708:b001:l022","ordinal":31518,"en":"They all ride abreast."},{"id":"manas-2010:p0708:b001:l023","ordinal":31519,"en":"With hoe-shaped croups and stone hooves,"},{"id":"manas-2010:p0708:b001:l024","ordinal":31520,"en":"The winged steeds of the spacious land"},{"id":"manas-2010:p0708:b001:l025","ordinal":31521,"en":"They have all selected to ride."},{"id":"manas-2010:p0708:b001:l026","ordinal":31522,"en":"Helmets of blue iron"},{"id":"manas-2010:p0708:b001:l027","ordinal":31523,"en":"They fit over their heads."},{"id":"manas-2010:p0708:b001:l028","ordinal":31524,"en":"They have trumpets and shawms sounded."},{"id":"manas-2010:p0708:b001:l029","ordinal":31525,"en":"Upon some forty red camels"},{"id":"manas-2010:p0708:b001:l030","ordinal":31526,"en":"They have ammunition loaded."},{"id":"manas-2010:p0708:b001:l031","ordinal":31527,"en":"Moving onward without haste,"},{"id":"manas-2010:p0708:b001:l032","ordinal":31528,"en":"They have the great drum beaten hard,"},{"id":"manas-2010:p0708:b001:l033","ordinal":31529,"en":"Its sound deafening the ears."},{"id":"manas-2010:p0708:b001:l034","ordinal":31530,"en":"At the very front, Khan Bakay,"},{"id":"manas-2010:p0708:b001:l035","ordinal":31531,"en":"Wearing a robe of blue ribbed cloth,"},{"id":"manas-2010:p0708:b001:l036","ordinal":31532,"en":"Riding a short-tailed blue-gray winged steed,"},{"id":"manas-2010:p0708:b001:l037","ordinal":31533,"en":"Carries a banner with a golden crescent."},{"id":"manas-2010:p0708:b001:l038","ordinal":31534,"en":"Bakay rides freely at the front."},{"id":"manas-2010:p0708:b001:l039","ordinal":31535,"en":"Making the dun horse prance,"},{"id":"manas-2010:p0708:b001:l040","ordinal":31536,"en":"Twelve companions escort him loosely."},{"id":"manas-2010:p0708:b001:l041","ordinal":31537,"en":"From the skilled spearmen,"},{"id":"manas-2010:p0708:b001:l042","ordinal":31538,"en":"Ten separate into their own group,"},{"id":"manas-2010:p0709:b001:l001","ordinal":31539,"en":"Their courage mighty, their wrath fierce,"},{"id":"manas-2010:p0709:b001:l002","ordinal":31540,"en":"Showing the aspect of blood-drinkers."},{"id":"manas-2010:p0709:b001:l003","ordinal":31541,"en":"From those skilled at sword blows,"},{"id":"manas-2010:p0709:b001:l004","ordinal":31542,"en":"Ten separate into their own group,"},{"id":"manas-2010:p0709:b001:l005","ordinal":31543,"en":"(Looking ready to bring hardship on anyone they face,)"},{"id":"manas-2010:p0709:b001:l006","ordinal":31544,"en":"Everyone who comes against them"},{"id":"manas-2010:p0709:b001:l007","ordinal":31545,"en":"They look ready to conquer."},{"id":"manas-2010:p0709:b001:l008","ordinal":31546,"en":"From those skilled with battle-axes,"},{"id":"manas-2010:p0709:b001:l009","ordinal":31547,"en":"Ten separate into their own group."},{"id":"manas-2010:p0709:b001:l010","ordinal":31548,"en":"Not merely Alöökö, but the whole world,"},{"id":"manas-2010:p0709:b001:l011","ordinal":31549,"en":"They look ready to conquer."},{"id":"manas-2010:p0709:b001:l012","ordinal":31550,"en":"From those skilled at drawing bows,"},{"id":"manas-2010:p0709:b001:l013","ordinal":31551,"en":"Ten separate from this group."},{"id":"manas-2010:p0709:b001:l014","ordinal":31552,"en":"From marksmen who never miss,"},{"id":"manas-2010:p0709:b001:l015","ordinal":31553,"en":"Ten separate from that group."},{"id":"manas-2010:p0709:b001:l016","ordinal":31554,"en":"To the blood-stained warrior himself"},{"id":"manas-2010:p0709:b001:l017","ordinal":31555,"en":"They shout encouragement."},{"id":"manas-2010:p0709:b001:l018","ordinal":31556,"en":"“Alöökö, whose road is blocked!"},{"id":"manas-2010:p0709:b001:l019","ordinal":31557,"en":"Where is the enemy?” they cry."},{"id":"manas-2010:p0709:b001:l020","ordinal":31558,"en":"They have their renowned khan Manas."},{"id":"manas-2010:p0709:b001:l021","ordinal":31559,"en":"While magnanimous Manas is there,"},{"id":"manas-2010:p0709:b001:l022","ordinal":31560,"en":"These forty companions standing here,"},{"id":"manas-2010:p0709:b001:l023","ordinal":31561,"en":"The eighteen thousand worlds"},{"id":"manas-2010:p0709:b001:l024","ordinal":31562,"en":"They have the power to destroy."},{"id":"manas-2010:p0709:b001:l025","ordinal":31563,"en":"The forty companions have gone wild,"},{"id":"manas-2010:p0709:b001:l026","ordinal":31564,"en":"“Where is the enemy?” they cry in excitement."},{"id":"manas-2010:p0709:b001:l027","ordinal":31565,"en":"Desiring a raid, seeking a foe,"},{"id":"manas-2010:p0709:b001:l028","ordinal":31566,"en":"They have set out, stirred to frenzy."},{"id":"manas-2010:p0709:b001:l029","ordinal":31567,"en":"Among the forty companions"},{"id":"manas-2010:p0709:b001:l030","ordinal":31568,"en":"There are rash men too;"},{"id":"manas-2010:p0709:b001:l031","ordinal":31569,"en":"All the wise men are there."},{"id":"manas-2010:p0709:b001:l032","ordinal":31570,"en":"The rash men surge forward,"},{"id":"manas-2010:p0709:b001:l033","ordinal":31571,"en":"“Where is the enemy?” they cry, straining."},{"id":"manas-2010:p0709:b001:l034","ordinal":31572,"en":"Some rush headlong."},{"id":"manas-2010:p0709:b001:l035","ordinal":31573,"en":"“He will simply charge and try,” they say;"},{"id":"manas-2010:p0709:b001:l036","ordinal":31574,"en":"“Attacking recklessly by chance,"},{"id":"manas-2010:p0709:b001:l037","ordinal":31575,"en":"He will die before his appointed time,” they say."},{"id":"manas-2010:p0709:b001:l038","ordinal":31576,"en":"Some of them stir others,"},{"id":"manas-2010:p0709:b001:l039","ordinal":31577,"en":"Exciting them and making them surge,"},{"id":"manas-2010:p0709:b001:l040","ordinal":31578,"en":"Making them strain like a woman whose husband has died,"},{"id":"manas-2010:p0709:b001:l041","ordinal":31579,"en":"And lead them along."},{"id":"manas-2010:p0709:b001:l042","ordinal":31580,"en":"All forty noble men"},{"id":"manas-2010:p0710:b001:l001","ordinal":31581,"en":"Ride abreast, shouting."},{"id":"manas-2010:p0710:b001:l002","ordinal":31582,"en":"They sweep onward then,"},{"id":"manas-2010:p0710:b001:l003","ordinal":31583,"en":"Crying their battle cry, “Manas!”"},{"id":"manas-2010:p0710:b001:l004","ordinal":31584,"en":"The sight draws the heart;"},{"id":"manas-2010:p0710:b001:l005","ordinal":31585,"en":"Each of the forty companions"},{"id":"manas-2010:p0710:b001:l006","ordinal":31586,"en":"Appears like a thousand men."},{"id":"manas-2010:p0710:b001:l007","ordinal":31587,"en":"The mounts of the forty companions"},{"id":"manas-2010:p0710:b001:l008","ordinal":31588,"en":"Are all dun winged steeds,"},{"id":"manas-2010:p0710:b001:l009","ordinal":31589,"en":"With amulet-shaped marks on their foreheads,"},{"id":"manas-2010:p0710:b001:l010","ordinal":31590,"en":"All swift, white-blazed horses."},{"id":"manas-2010:p0710:b001:l011","ordinal":31591,"en":"The forty companions beside him,"},{"id":"manas-2010:p0710:b001:l012","ordinal":31592,"en":"Their elder, warrior Bakay,"},{"id":"manas-2010:p0710:b001:l013","ordinal":31593,"en":"All have winged steeds."},{"id":"manas-2010:p0710:b001:l014","ordinal":31594,"en":"While oceanlike Manas is there,"},{"id":"manas-2010:p0710:b001:l015","ordinal":31595,"en":"Not merely Alöökö, but the whole world,"},{"id":"manas-2010:p0710:b001:l016","ordinal":31596,"en":"They have the strength to conquer."},{"id":"manas-2010:p0710:b001:l017","ordinal":31597,"en":"In the forty companions' hands,"},{"id":"manas-2010:p0710:b001:l018","ordinal":31598,"en":"The standards flutter."},{"id":"manas-2010:p0710:b001:l019","ordinal":31599,"en":"The sight draws the heart;"},{"id":"manas-2010:p0710:b001:l020","ordinal":31600,"en":"Each one of them then"},{"id":"manas-2010:p0710:b001:l021","ordinal":31601,"en":"Appears like a countless host."},{"id":"manas-2010:p0710:b001:l022","ordinal":31602,"en":"A spiral-worked copper spear,"},{"id":"manas-2010:p0710:b001:l023","ordinal":31603,"en":"Gripping it firmly and swinging it,"},{"id":"manas-2010:p0710:b001:l024","ordinal":31604,"en":"“Scout Andijan,” he said."},{"id":"manas-2010:p0710:b001:l025","ordinal":31605,"en":"“Of a warrior such as Alöökö,"},{"id":"manas-2010:p0710:b001:l026","ordinal":31606,"en":"Learn the circumstances yourself;"},{"id":"manas-2010:p0710:b001:l027","ordinal":31607,"en":"Bring thorough intelligence,” he said."},{"id":"manas-2010:p0710:b001:l028","ordinal":31608,"en":"He sent Ajybay away."},{"id":"manas-2010:p0710:b001:l029","ordinal":31609,"en":"Its teapots golden, its tea cheap,"},{"id":"manas-2010:p0710:b001:l030","ordinal":31610,"en":"Feeding the weary traveler,"},{"id":"manas-2010:p0710:b001:l031","ordinal":31611,"en":"There is no city like Samarkand."},{"id":"manas-2010:p0710:b001:l032","ordinal":31612,"en":"Satisfying the mighty men's desires,"},{"id":"manas-2010:p0710:b001:l033","ordinal":31613,"en":"Straightening crooked affairs,"},{"id":"manas-2010:p0710:b001:l034","ordinal":31614,"en":"There is no scourge like the forty companions."},{"id":"manas-2010:p0710:b001:l035","ordinal":31615,"en":"The forty companions, scattered and impoverished,"},{"id":"manas-2010:p0710:b001:l036","ordinal":31616,"en":"Are the magnanimous warrior's comrades."},{"id":"manas-2010:p0710:b001:l037","ordinal":31617,"en":"If there is an enemy shouting for battle,"},{"id":"manas-2010:p0710:b001:l038","ordinal":31618,"en":"They enter and attack without wavering,"},{"id":"manas-2010:p0710:b001:l039","ordinal":31619,"en":"His tigers who tear a way through."},{"id":"manas-2010:p0710:b001:l040","ordinal":31620,"en":"Khan Manas's forty companions,"},{"id":"manas-2010:p0710:b001:l041","ordinal":31621,"en":"With piercing cries and fierce shouts,"},{"id":"manas-2010:p0710:b001:l042","ordinal":31622,"en":"Broad-lunged, thunder-voiced,"},{"id":"manas-2010:p0711:b001:l001","ordinal":31623,"en":"Their bearing that of spearmen,"},{"id":"manas-2010:p0711:b001:l002","ordinal":31624,"en":"Enemies of terrible might"},{"id":"manas-2010:p0711:b001:l003","ordinal":31625,"en":"They have the mettle to conquer for him."},{"id":"manas-2010:p0711:b001:l004","ordinal":31626,"en":"Never drawing back from an enemy,"},{"id":"manas-2010:p0711:b001:l005","ordinal":31627,"en":"Khan Manas's forty companions"},{"id":"manas-2010:p0711:b001:l006","ordinal":31628,"en":"Never flee from death."},{"id":"manas-2010:p0711:b001:l007","ordinal":31629,"en":"Such companions cannot be found elsewhere."},{"id":"manas-2010:p0711:b001:l008","ordinal":31630,"en":"Amid terrible slaughter and strife,"},{"id":"manas-2010:p0711:b001:l009","ordinal":31631,"en":"Unhurried, the forty mighty men"},{"id":"manas-2010:p0711:b001:l010","ordinal":31632,"en":"Stand beneath the banner."},{"id":"manas-2010:p0711:b001:l011","ordinal":31633,"en":"Khan Manas's forty companions:"},{"id":"manas-2010:p0711:b001:l012","ordinal":31634,"en":"Tell them to cross grass, they cross fire;"},{"id":"manas-2010:p0711:b001:l013","ordinal":31635,"en":"Tell them to drink water, they drink poison;"},{"id":"manas-2010:p0711:b001:l014","ordinal":31636,"en":"Tell them to take a cap, they cut off a head;"},{"id":"manas-2010:p0711:b001:l015","ordinal":31637,"en":"Tell them to make someone laugh, they make him weep."},{"id":"manas-2010:p0711:b001:l016","ordinal":31638,"en":"Beating drums, raising a clamor,"},{"id":"manas-2010:p0711:b001:l017","ordinal":31639,"en":"Looking ready to seize everything,"},{"id":"manas-2010:p0711:b001:l018","ordinal":31640,"en":"Holding their spears ready to thrust,"},{"id":"manas-2010:p0711:b001:l019","ordinal":31641,"en":"Their battle cry of “Manas!”"},{"id":"manas-2010:p0711:b001:l020","ordinal":31642,"en":"Deafens every ear."},{"id":"manas-2010:p0711:b001:l021","ordinal":31643,"en":"To scout Andijan,"},{"id":"manas-2010:p0711:b001:l022","ordinal":31644,"en":"They sent Ajybay."},{"id":"manas-2010:p0711:b001:l023","ordinal":31645,"en":"To raid Samarkand"},{"id":"manas-2010:p0711:b001:l024","ordinal":31646,"en":"And obtain news from there,"},{"id":"manas-2010:p0711:b001:l025","ordinal":31647,"en":"Küldür and Chalybay,"},{"id":"manas-2010:p0711:b001:l026","ordinal":31648,"en":"The two racing side by side,"},{"id":"manas-2010:p0711:b001:l027","ordinal":31649,"en":"Their stirrups striking together,"},{"id":"manas-2010:p0711:b001:l028","ordinal":31650,"en":"On this side of Samarkand,"},{"id":"manas-2010:p0711:b001:l029","ordinal":31651,"en":"When they reached Ak-Talaa,"},{"id":"manas-2010:p0711:b001:l030","ordinal":31652,"en":"The son of rich Aksakal,"},{"id":"manas-2010:p0711:b001:l031","ordinal":31653,"en":"Aralbay came out to meet them."},{"id":"manas-2010:p0711:b001:l032","ordinal":31654,"en":"Aralbay stood and spoke;"},{"id":"manas-2010:p0711:b001:l033","ordinal":31655,"en":"He told an astonishing tale:"},{"id":"manas-2010:p0711:b001:l034","ordinal":31656,"en":"“Khan Manas's retainers,"},{"id":"manas-2010:p0711:b001:l035","ordinal":31657,"en":"Küldür and Chalybay,"},{"id":"manas-2010:p0711:b001:l036","ordinal":31658,"en":"Turn your horses' heads aside a moment;"},{"id":"manas-2010:p0711:b001:l037","ordinal":31659,"en":"Stand a moment without rushing!"},{"id":"manas-2010:p0711:b001:l038","ordinal":31660,"en":"I heard word from those who came;"},{"id":"manas-2010:p0711:b001:l039","ordinal":31661,"en":"I heard much from the sorcerer."},{"id":"manas-2010:p0711:b001:l040","ordinal":31662,"en":"‘The dark wolf-man, the leopard,"},{"id":"manas-2010:p0711:b001:l041","ordinal":31663,"en":"With his forty noble men beside him,"},{"id":"manas-2010:p0711:b001:l042","ordinal":31664,"en":"Manas is coming,’ he heard."},{"id":"manas-2010:p0712:b001:l001","ordinal":31665,"en":"Red gold and white silver"},{"id":"manas-2010:p0712:b001:l002","ordinal":31666,"en":"He scattered in an astonishing way, they say."},{"id":"manas-2010:p0712:b001:l003","ordinal":31667,"en":"As though slaughter had struck,"},{"id":"manas-2010:p0712:b001:l004","ordinal":31668,"en":"That damned Alöökö"},{"id":"manas-2010:p0712:b001:l005","ordinal":31669,"en":"Fled toward China, they say."},{"id":"manas-2010:p0712:b001:l006","ordinal":31670,"en":"His monks and giants"},{"id":"manas-2010:p0712:b001:l007","ordinal":31671,"en":"Scattered their countless possessions."},{"id":"manas-2010:p0712:b001:l008","ordinal":31672,"en":"As though sucked dry by a snake,"},{"id":"manas-2010:p0712:b001:l009","ordinal":31673,"en":"His Torguts fled with him."},{"id":"manas-2010:p0712:b001:l010","ordinal":31674,"en":"It seems he was afraid."},{"id":"manas-2010:p0712:b001:l011","ordinal":31675,"en":"Only dogs were left howling, I heard,"},{"id":"manas-2010:p0712:b001:l012","ordinal":31676,"en":"In the city of Margalan."},{"id":"manas-2010:p0712:b001:l013","ordinal":31677,"en":"He achieved his desire,"},{"id":"manas-2010:p0712:b001:l014","ordinal":31678,"en":"That damned Alöökö,"},{"id":"manas-2010:p0712:b001:l015","ordinal":31679,"en":"As though slaughter had struck,"},{"id":"manas-2010:p0712:b001:l016","ordinal":31680,"en":"He fled stark naked.”"},{"id":"manas-2010:p0712:b001:l017","ordinal":31681,"en":"Hearing Aralbay's words,"},{"id":"manas-2010:p0712:b001:l018","ordinal":31682,"en":"The two cried “Go!” and raced."},{"id":"manas-2010:p0712:b001:l019","ordinal":31683,"en":"Their white reins knotted short,"},{"id":"manas-2010:p0712:b001:l020","ordinal":31684,"en":"They took between their teeth."},{"id":"manas-2010:p0712:b001:l021","ordinal":31685,"en":"Before a word could be spoken,"},{"id":"manas-2010:p0712:b001:l022","ordinal":31686,"en":"In the opening and closing of an eye,"},{"id":"manas-2010:p0712:b001:l023","ordinal":31687,"en":"To old warrior Bakay,"},{"id":"manas-2010:p0712:b001:l024","ordinal":31688,"en":"To everyone, beginning with Manas:"},{"id":"manas-2010:p0712:b001:l025","ordinal":31689,"en":"“What you carry, forty companions,"},{"id":"manas-2010:p0712:b001:l026","ordinal":31690,"en":"Are deadly bows and smooth arrows."},{"id":"manas-2010:p0712:b001:l027","ordinal":31691,"en":"I heard word of Alöökö;"},{"id":"manas-2010:p0712:b001:l028","ordinal":31692,"en":"Now I will tell the tale!"},{"id":"manas-2010:p0712:b001:l029","ordinal":31693,"en":"Alöökö, who heard the news,"},{"id":"manas-2010:p0712:b001:l030","ordinal":31694,"en":"Turns out to be a womanlike fellow."},{"id":"manas-2010:p0712:b001:l031","ordinal":31695,"en":"Hearing the truth, that pig"},{"id":"manas-2010:p0712:b001:l032","ordinal":31696,"en":"Is no warrior, but black earth."},{"id":"manas-2010:p0712:b001:l033","ordinal":31697,"en":"If Alöökö were a warrior,"},{"id":"manas-2010:p0712:b001:l034","ordinal":31698,"en":"Would he not begin the contest?"},{"id":"manas-2010:p0712:b001:l035","ordinal":31699,"en":"Making red blood flow everywhere,"},{"id":"manas-2010:p0712:b001:l036","ordinal":31700,"en":"Would he not make a splendid contest?"},{"id":"manas-2010:p0712:b001:l037","ordinal":31701,"en":"Standing face to face,"},{"id":"manas-2010:p0712:b001:l038","ordinal":31702,"en":"Firing guns and drawing bows,"},{"id":"manas-2010:p0712:b001:l039","ordinal":31703,"en":"Clashing and fighting,"},{"id":"manas-2010:p0712:b001:l040","ordinal":31704,"en":"Would he not satisfy our craving?"},{"id":"manas-2010:p0712:b001:l041","ordinal":31705,"en":"If Alöökö were superior,"},{"id":"manas-2010:p0712:b001:l042","ordinal":31706,"en":"Would he not conquer these men?"},{"id":"manas-2010:p0713:b001:l001","ordinal":31707,"en":"Your fathers' graves, forty companions!"},{"id":"manas-2010:p0713:b001:l002","ordinal":31708,"en":"Your fortune has come up short."},{"id":"manas-2010:p0713:b001:l003","ordinal":31709,"en":"To smash each other in battle,"},{"id":"manas-2010:p0713:b001:l004","ordinal":31710,"en":"Your enemy has fled away."},{"id":"manas-2010:p0713:b001:l005","ordinal":31711,"en":"Setting out from Talas and circling round,"},{"id":"manas-2010:p0713:b001:l006","ordinal":31712,"en":"Without standing to fight and shatter each other,"},{"id":"manas-2010:p0713:b001:l007","ordinal":31713,"en":"Your road has been utterly blocked."},{"id":"manas-2010:p0713:b001:l008","ordinal":31714,"en":"Your raid has brought you no luck."},{"id":"manas-2010:p0713:b001:l009","ordinal":31715,"en":"The formidable enemy Alöökö"},{"id":"manas-2010:p0713:b001:l010","ordinal":31716,"en":"Has fled, leaving you no luck."},{"id":"manas-2010:p0713:b001:l011","ordinal":31717,"en":"How shall we now tread"},{"id":"manas-2010:p0713:b001:l012","ordinal":31718,"en":"His freely lying plain?"},{"id":"manas-2010:p0713:b001:l013","ordinal":31719,"en":"With what face shall we raid"},{"id":"manas-2010:p0713:b001:l014","ordinal":31720,"en":"His deserted city?”"},{"id":"manas-2010:p0713:b001:l015","ordinal":31721,"en":"Küldür and Chalybay"},{"id":"manas-2010:p0713:b001:l016","ordinal":31722,"en":"Uttered sorrowful words."},{"id":"manas-2010:p0713:b001:l017","ordinal":31723,"en":"Stirred upon his blue-gray winged steed,"},{"id":"manas-2010:p0713:b001:l018","ordinal":31724,"en":"Wolf-man Bakay the leopard"},{"id":"manas-2010:p0713:b001:l019","ordinal":31725,"en":"Came out to the front."},{"id":"manas-2010:p0713:b001:l020","ordinal":31726,"en":"The mighty one among forty companions,"},{"id":"manas-2010:p0713:b001:l021","ordinal":31727,"en":"The finest among sixty,"},{"id":"manas-2010:p0713:b001:l022","ordinal":31728,"en":"Khan Bakay, Bay's son,"},{"id":"manas-2010:p0713:b001:l023","ordinal":31729,"en":"Who rinsed his mouth with honey,"},{"id":"manas-2010:p0713:b001:l024","ordinal":31730,"en":"Wearing a cap of blue-gray lynx fur,"},{"id":"manas-2010:p0713:b001:l025","ordinal":31731,"en":"Wielded his mottled blue shield."},{"id":"manas-2010:p0713:b001:l026","ordinal":31732,"en":"Who found words in sudden need,"},{"id":"manas-2010:p0713:b001:l027","ordinal":31733,"en":"Who found eyes in darkness,"},{"id":"manas-2010:p0713:b001:l028","ordinal":31734,"en":"Who would not be bound by an evil word,"},{"id":"manas-2010:p0713:b001:l029","ordinal":31735,"en":"In the darkness of the moon,"},{"id":"manas-2010:p0713:b001:l030","ordinal":31736,"en":"Set on a fox's trail, he would not go astray."},{"id":"manas-2010:p0713:b001:l031","ordinal":31737,"en":"Warrior Bakay, speaking in a deep voice,"},{"id":"manas-2010:p0713:b001:l032","ordinal":31738,"en":"To all forty companions"},{"id":"manas-2010:p0713:b001:l033","ordinal":31739,"en":"Firmly delivered striking words:"},{"id":"manas-2010:p0713:b001:l034","ordinal":31740,"en":"“Let your skilled spearmen step forth;"},{"id":"manas-2010:p0713:b001:l035","ordinal":31741,"en":"Let your mighty axe-wielders step forth!"},{"id":"manas-2010:p0713:b001:l036","ordinal":31742,"en":"If we travel day and night,"},{"id":"manas-2010:p0713:b001:l037","ordinal":31743,"en":"If we travel far, sparing no horses,"},{"id":"manas-2010:p0713:b001:l038","ordinal":31744,"en":"Do not lean on your elbows to rest;"}]
