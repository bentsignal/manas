[{"id":"semetey-2-2013:p1040:b004:l039","ordinal":265729,"en":"Jaynake, whom Jamgyrchy married;"},{"id":"semetey-2-2013:p1041:b003:l001","ordinal":265730,"en":"Ayneke, whom Teke married;"},{"id":"semetey-2-2013:p1041:b003:l002","ordinal":265731,"en":"Oyumkan, whom Ormonbek married;"},{"id":"semetey-2-2013:p1041:b003:l003","ordinal":265732,"en":"And Kanykey, whom Manas married—"},{"id":"semetey-2-2013:p1041:b003:l004","ordinal":265733,"en":"There were twelve of us girls."},{"id":"semetey-2-2013:p1041:b003:l005","ordinal":265734,"en":"We were foals of one stallion,"},{"id":"semetey-2-2013:p1041:b003:l006","ordinal":265735,"en":"Children of one father."},{"id":"semetey-2-2013:p1041:b003:l007","ordinal":265736,"en":"We were gentle souls."},{"id":"semetey-2-2013:p1041:b003:l008","ordinal":265737,"en":"The power to discern from afar"},{"id":"semetey-2-2013:p1041:b003:l009","ordinal":265738,"en":"Was Akerkech’s gift."},{"id":"semetey-2-2013:p1041:b003:l010","ordinal":265739,"en":"While his father Köksö lived,"},{"id":"semetey-2-2013:p1041:b003:l011","ordinal":265740,"en":"It was ever the Kazakh custom"},{"id":"semetey-2-2013:p1041:b003:l012","ordinal":265741,"en":"To bluster loudly."},{"id":"semetey-2-2013:p1041:b003:l013","ordinal":265742,"en":"Ah, my river’s fountainhead,"},{"id":"semetey-2-2013:p1041:b003:l014","ordinal":265743,"en":"My champion, seen only in my old age!"},{"id":"semetey-2-2013:p1041:b003:l015","ordinal":265744,"en":"I was a forlorn soul in my bridal youth,"},{"id":"semetey-2-2013:p1041:b003:l016","ordinal":265745,"en":"And late indeed to braid my hair."},{"id":"semetey-2-2013:p1041:b003:l017","ordinal":265746,"en":"From the imposing Manas,"},{"id":"semetey-2-2013:p1041:b003:l018","ordinal":265747,"en":"My foal, I bore you when I was near death."},{"id":"semetey-2-2013:p1041:b003:l019","ordinal":265748,"en":"You who stirred turmoil throughout the world—"},{"id":"semetey-2-2013:p1041:b003:l020","ordinal":265749,"en":"Semetey and Ümötöy,"},{"id":"semetey-2-2013:p1041:b003:l021","ordinal":265750,"en":"You two maternal cousins"},{"id":"semetey-2-2013:p1041:b003:l022","ordinal":265751,"en":"Were born on the same day."},{"id":"semetey-2-2013:p1041:b003:l023","ordinal":265752,"en":"Ninety beasts were slaughtered at your feasts,"},{"id":"semetey-2-2013:p1041:b003:l024","ordinal":265753,"en":"And you were given matching names."},{"id":"semetey-2-2013:p1041:b003:l025","ordinal":265754,"en":"You were maternal cousins;"},{"id":"semetey-2-2013:p1041:b003:l026","ordinal":265755,"en":"Kinship bound you."},{"id":"semetey-2-2013:p1041:b003:l027","ordinal":265756,"en":"No good comes from striking one’s kin;"},{"id":"semetey-2-2013:p1041:b003:l028","ordinal":265757,"en":"Two true men should not oppose each other."},{"id":"semetey-2-2013:p1041:b003:l029","ordinal":265758,"en":"One should never attack a close relation;"},{"id":"semetey-2-2013:p1041:b003:l030","ordinal":265759,"en":"No good comes from spilling kindred blood."},{"id":"semetey-2-2013:p1041:b003:l031","ordinal":265760,"en":"Accept what he says;"},{"id":"semetey-2-2013:p1041:b003:l032","ordinal":265761,"en":"Give him whatever he desires—"},{"id":"semetey-2-2013:p1041:b003:l033","ordinal":265762,"en":"Abundant wealth and countless herds!"},{"id":"semetey-2-2013:p1041:b003:l034","ordinal":265763,"en":"Send him peacefully on his way;"},{"id":"semetey-2-2013:p1041:b003:l035","ordinal":265764,"en":"Make peace without hostility"},{"id":"semetey-2-2013:p1041:b003:l036","ordinal":265765,"en":"And remain on friendly terms!"},{"id":"semetey-2-2013:p1041:b003:l037","ordinal":265766,"en":"The reason you must do this is that"},{"id":"semetey-2-2013:p1041:b003:l038","ordinal":265767,"en":"My elder sister Akerkech"},{"id":"semetey-2-2013:p1041:b003:l039","ordinal":265768,"en":"Was a woman revered by all,"},{"id":"semetey-2-2013:p1041:b005:l001","ordinal":265769,"en":"A blessed lady."},{"id":"semetey-2-2013:p1041:b005:l002","ordinal":265770,"en":"She was one for whom the white felt was spread,"},{"id":"semetey-2-2013:p1041:b005:l003","ordinal":265771,"en":"And among unfortunate womankind"},{"id":"semetey-2-2013:p1041:b005:l004","ordinal":265772,"en":"She possessed sacred power."},{"id":"semetey-2-2013:p1041:b005:l005","ordinal":265773,"en":"With lambent, sheep-like eyes,"},{"id":"semetey-2-2013:p1041:b005:l006","ordinal":265774,"en":"A fair face without a freckle,"},{"id":"semetey-2-2013:p1041:b005:l007","ordinal":265775,"en":"A stately neck and radiant eyes,"},{"id":"semetey-2-2013:p1041:b005:l008","ordinal":265776,"en":"Sweet in speech, with a honeyed tongue—"},{"id":"semetey-2-2013:p1041:b005:l009","ordinal":265777,"en":"No woman like her exists in all the world."},{"id":"semetey-2-2013:p1041:b005:l010","ordinal":265778,"en":"Full and radiant as the full moon,"},{"id":"semetey-2-2013:p1041:b005:l011","ordinal":265779,"en":"Plump and sleek as a white swan,"},{"id":"semetey-2-2013:p1041:b005:l012","ordinal":265780,"en":"My poor noble sister"},{"id":"semetey-2-2013:p1041:b005:l013","ordinal":265781,"en":"Possessed such great honor."},{"id":"semetey-2-2013:p1041:b005:l014","ordinal":265782,"en":"Known to every listening ear and seeing eye,"},{"id":"semetey-2-2013:p1041:b005:l015","ordinal":265783,"en":"Her fame spread across the earth;"},{"id":"semetey-2-2013:p1041:b005:l016","ordinal":265784,"en":"She was a woman of sacred power."},{"id":"semetey-2-2013:p1041:b005:l017","ordinal":265785,"en":"From her husband, gray-maned Köksö,"},{"id":"semetey-2-2013:p1041:b005:l018","ordinal":265786,"en":"She received as a gift"},{"id":"semetey-2-2013:p1041:b005:l019","ordinal":265787,"en":"That valiant son."},{"id":"semetey-2-2013:p1041:b005:l020","ordinal":265788,"en":"That woman Akerkech,"},{"id":"semetey-2-2013:p1041:b005:l021","ordinal":265789,"en":"That radiant forceful soul,"},{"id":"semetey-2-2013:p1041:b005:l022","ordinal":265790,"en":"Had a guardian spirit supporting her."},{"id":"semetey-2-2013:p1041:b005:l023","ordinal":265791,"en":"She made her son"},{"id":"semetey-2-2013:p1041:b005:l024","ordinal":265792,"en":"Her refuge in Köksö’s place."},{"id":"semetey-2-2013:p1041:b005:l025","ordinal":265793,"en":"Köksö had no many sons;"},{"id":"semetey-2-2013:p1041:b005:l026","ordinal":265794,"en":"Ümötöy was his only child."},{"id":"semetey-2-2013:p1041:b005:l027","ordinal":265795,"en":"Akerkech, who bore Ümötöy,"},{"id":"semetey-2-2013:p1041:b005:l028","ordinal":265796,"en":"Was a woman of sacred power."},{"id":"semetey-2-2013:p1041:b005:l029","ordinal":265797,"en":"My dear, formidable sister"},{"id":"semetey-2-2013:p1041:b005:l030","ordinal":265798,"en":"Had a mole upon her lip;"},{"id":"semetey-2-2013:p1041:b005:l031","ordinal":265799,"en":"Her simplest word could bring misfortune,"},{"id":"semetey-2-2013:p1041:b005:l032","ordinal":265800,"en":"For there was a seal upon her tongue."},{"id":"semetey-2-2013:p1041:b005:l033","ordinal":265801,"en":"Her curse never missed its mark,"},{"id":"semetey-2-2013:p1041:b005:l034","ordinal":265802,"en":"Her malediction never fell in vain;"},{"id":"semetey-2-2013:p1041:b005:l035","ordinal":265803,"en":"None prospered when she spoke against them,"},{"id":"semetey-2-2013:p1041:b005:l036","ordinal":265804,"en":"And her curse never failed."},{"id":"semetey-2-2013:p1041:b005:l037","ordinal":265805,"en":"Such a lady was his mother,"},{"id":"semetey-2-2013:p1041:b005:l038","ordinal":265806,"en":"And terrible indeed was her curse."},{"id":"semetey-2-2013:p1041:b005:l039","ordinal":265807,"en":"There was a beauty mark upon her lip."},{"id":"semetey-2-2013:p1042:b003:l001","ordinal":265808,"en":"No one she fixed her gaze upon remained unharmed;"},{"id":"semetey-2-2013:p1042:b003:l002","ordinal":265809,"en":"That woman of invincible wishes"},{"id":"semetey-2-2013:p1042:b003:l003","ordinal":265810,"en":"Had a seal upon her tongue."},{"id":"semetey-2-2013:p1042:b003:l004","ordinal":265811,"en":"May God take Ümötöy—"},{"id":"semetey-2-2013:p1042:b003:l005","ordinal":265812,"en":"It is his mother I fear!”"},{"id":"semetey-2-2013:p1042:b003:l006","ordinal":265813,"en":"So Kanykey"},{"id":"semetey-2-2013:p1042:b003:l007","ordinal":265814,"en":"Spoke amid the turmoil,"},{"id":"semetey-2-2013:p1042:b003:l008","ordinal":265815,"en":"Amid merciless great distress"},{"id":"semetey-2-2013:p1042:b003:l009","ordinal":265816,"en":"And clamor."},{"id":"semetey-2-2013:p1042:b003:l010","ordinal":265817,"en":"She urged stubborn Semetey"},{"id":"semetey-2-2013:p1042:b003:l011","ordinal":265818,"en":"To make peace."},{"id":"semetey-2-2013:p1042:b003:l012","ordinal":265819,"en":"She urged Ümötöy and Semetey"},{"id":"semetey-2-2013:p1042:b003:l013","ordinal":265820,"en":"To shine upon each other"},{"id":"semetey-2-2013:p1042:b003:l014","ordinal":265821,"en":"Like mist-veiled stars in heaven,"},{"id":"semetey-2-2013:p1042:b003:l015","ordinal":265822,"en":"To bind themselves for eternity"},{"id":"semetey-2-2013:p1042:b003:l016","ordinal":265823,"en":"And become friends."},{"id":"semetey-2-2013:p1042:b003:l017","ordinal":265824,"en":"But then Semetey,"},{"id":"semetey-2-2013:p1042:b003:l018","ordinal":265825,"en":"Without saying yes or no"},{"id":"semetey-2-2013:p1042:b003:l019","ordinal":265826,"en":"To Khan Bakay and Kanykey,"},{"id":"semetey-2-2013:p1042:b003:l020","ordinal":265827,"en":"Refusing to heed their words,"},{"id":"semetey-2-2013:p1042:b003:l021","ordinal":265828,"en":"Giving no open answer,"},{"id":"semetey-2-2013:p1042:b003:l022","ordinal":265829,"en":"Grew furious and scowled,"},{"id":"semetey-2-2013:p1042:b003:l023","ordinal":265830,"en":"His eyes flashing wide."},{"id":"semetey-2-2013:p1042:b003:l024","ordinal":265831,"en":"When he thought of Ümötöy,"},{"id":"semetey-2-2013:p1042:b003:l025","ordinal":265832,"en":"His thirst for blood seized him."},{"id":"semetey-2-2013:p1042:b003:l026","ordinal":265833,"en":"To the grave with this world!"},{"id":"semetey-2-2013:p1042:b003:l027","ordinal":265834,"en":"Whenever one foe is destroyed,"},{"id":"semetey-2-2013:p1042:b003:l028","ordinal":265835,"en":"Another rises from our own village,"},{"id":"semetey-2-2013:p1042:b003:l029","ordinal":265836,"en":"And our troubles multiply daily."},{"id":"semetey-2-2013:p1042:b003:l030","ordinal":265837,"en":"Ümötöy, son of Köksö,"},{"id":"semetey-2-2013:p1042:b003:l031","ordinal":265838,"en":"Now we have seen what you are."},{"id":"semetey-2-2013:p1042:b003:l032","ordinal":265839,"en":"Is quarrelsomeness what he loves most?"},{"id":"semetey-2-2013:p1042:b003:l033","ordinal":265840,"en":"How can we offer words of conciliation?"},{"id":"semetey-2-2013:p1042:b003:l034","ordinal":265841,"en":"Let us beat the madness out of him this time;"},{"id":"semetey-2-2013:p1042:b003:l035","ordinal":265842,"en":"If he rages and scowls like that,"},{"id":"semetey-2-2013:p1042:b003:l036","ordinal":265843,"en":"Let us find a way to settle"},{"id":"semetey-2-2013:p1042:b003:l037","ordinal":265844,"en":"With this ill-starred scoundrel."},{"id":"semetey-2-2013:p1042:b003:l038","ordinal":265845,"en":"If that Kazakh loves conflict so much,"},{"id":"semetey-2-2013:p1042:b003:l039","ordinal":265846,"en":"Let us strike him with every man at once."},{"id":"semetey-2-2013:p1042:b004:l001","ordinal":265847,"en":"Always, my mother,"},{"id":"semetey-2-2013:p1042:b004:l002","ordinal":265848,"en":"Ah, my dear lady,"},{"id":"semetey-2-2013:p1042:b004:l003","ordinal":265849,"en":"Wanting her kin to live without fighting,"},{"id":"semetey-2-2013:p1042:b004:l004","ordinal":265850,"en":"Will take their side."},{"id":"semetey-2-2013:p1042:b004:l005","ordinal":265851,"en":"Her blood relations and kinsmen—"},{"id":"semetey-2-2013:p1042:b004:l006","ordinal":265852,"en":"She keeps saying how worthy they are"},{"id":"semetey-2-2013:p1042:b004:l007","ordinal":265853,"en":"And praising them."},{"id":"semetey-2-2013:p1042:b004:l008","ordinal":265854,"en":"He drew back the blood-drinking Choro,"},{"id":"semetey-2-2013:p1042:b004:l009","ordinal":265855,"en":"Turned again toward him,"},{"id":"semetey-2-2013:p1042:b004:l010","ordinal":265856,"en":"Bit his lip and narrowed his eyes,"},{"id":"semetey-2-2013:p1042:b004:l011","ordinal":265857,"en":"And somehow led Choro outside."},{"id":"semetey-2-2013:p1042:b004:l012","ordinal":265858,"en":"Külchoro flew like an arrow,"},{"id":"semetey-2-2013:p1042:b004:l013","ordinal":265859,"en":"Dashing forward in haste,"},{"id":"semetey-2-2013:p1042:b004:l014","ordinal":265860,"en":"Springing and bounding like a roe deer,"},{"id":"semetey-2-2013:p1042:b004:l015","ordinal":265861,"en":"The agile, lion-hearted Choro—"},{"id":"semetey-2-2013:p1042:b004:l016","ordinal":265862,"en":"Matchless in valor,"},{"id":"semetey-2-2013:p1042:b004:l017","ordinal":265863,"en":"The swift, white-browed warrior Choro—"},{"id":"semetey-2-2013:p1042:b004:l018","ordinal":265864,"en":"Ran fleetly and reached him."},{"id":"semetey-2-2013:p1042:b004:l019","ordinal":265865,"en":"Semetey and Külchoro,"},{"id":"semetey-2-2013:p1042:b004:l020","ordinal":265866,"en":"Letting no one overhear"},{"id":"semetey-2-2013:p1042:b004:l021","ordinal":265867,"en":"And no person learn of it,"},{"id":"semetey-2-2013:p1042:b004:l022","ordinal":265868,"en":"Spoke together in whispers."},{"id":"semetey-2-2013:p1042:b004:l023","ordinal":265869,"en":"Semetey told Külchoro this,"},{"id":"semetey-2-2013:p1042:b004:l024","ordinal":265870,"en":"Standing there with a smile."},{"id":"semetey-2-2013:p1042:b004:l025","ordinal":265871,"en":"“Slaughter that Kazakh dog,”"},{"id":"semetey-2-2013:p1042:b004:l026","ordinal":265872,"en":"“Put him to death,”"},{"id":"semetey-2-2013:p1042:b004:l027","ordinal":265873,"en":"Semetey urged him on."},{"id":"semetey-2-2013:p1042:b004:l028","ordinal":265874,"en":"“Do not let him recoil even from stone,”"},{"id":"semetey-2-2013:p1042:b004:l029","ordinal":265875,"en":"Semetey incited him."},{"id":"semetey-2-2013:p1042:b004:l030","ordinal":265876,"en":"“To the grave with it, my lion Choro,"},{"id":"semetey-2-2013:p1042:b004:l031","ordinal":265877,"en":"Your strength can master the world."},{"id":"semetey-2-2013:p1042:b004:l032","ordinal":265878,"en":"If Ümötöy, son of Köksö,"},{"id":"semetey-2-2013:p1042:b004:l033","ordinal":265879,"en":"Will not listen to reason,"},{"id":"semetey-2-2013:p1042:b004:l034","ordinal":265880,"en":"Crush him and bring me his head;"},{"id":"semetey-2-2013:p1042:b004:l035","ordinal":265881,"en":"Cleave your way through his Daңгыт warriors,"},{"id":"semetey-2-2013:p1042:b004:l036","ordinal":265882,"en":"And return utterly sated with blood."},{"id":"semetey-2-2013:p1042:b004:l037","ordinal":265883,"en":"His heeled boots and leather trousers—"},{"id":"semetey-2-2013:p1042:b004:l038","ordinal":265884,"en":"Bring them back as spoils!"},{"id":"semetey-2-2013:p1042:b004:l039","ordinal":265885,"en":"But alas, my poor mother—”"},{"id":"semetey-2-2013:p1043:b003:l001","ordinal":265886,"en":"Of all the people born to me,"},{"id":"semetey-2-2013:p1043:b003:l002","ordinal":265887,"en":"My wretched mother comes out before them,"},{"id":"semetey-2-2013:p1043:b003:l003","ordinal":265888,"en":"Saying, “Her holy patron is the Messiah,”"},{"id":"semetey-2-2013:p1043:b003:l004","ordinal":265889,"en":"My wretched mother simply comes out to meet me."},{"id":"semetey-2-2013:p1043:b003:l005","ordinal":265890,"en":"A khan’s wife is his wing;"},{"id":"semetey-2-2013:p1043:b003:l006","ordinal":265891,"en":"From time to time,"},{"id":"semetey-2-2013:p1043:b003:l007","ordinal":265892,"en":"It has ever been my unfortunate noble mother’s"},{"id":"semetey-2-2013:p1043:b003:l008","ordinal":265893,"en":"Custom to perform such rites."},{"id":"semetey-2-2013:p1043:b003:l009","ordinal":265894,"en":"Father, companion, hear my words;"},{"id":"semetey-2-2013:p1043:b003:l010","ordinal":265895,"en":"Oil your bright steel."},{"id":"semetey-2-2013:p1043:b003:l011","ordinal":265896,"en":"Do not truly provoke my wrath:"},{"id":"semetey-2-2013:p1043:b003:l012","ordinal":265897,"en":"When he roused my enmity,"},{"id":"semetey-2-2013:p1043:b003:l013","ordinal":265898,"en":"Though he was my own uncle,"},{"id":"semetey-2-2013:p1043:b003:l014","ordinal":265899,"en":"I laid Abyke low."},{"id":"semetey-2-2013:p1043:b003:l015","ordinal":265900,"en":"And did I die?"},{"id":"semetey-2-2013:p1043:b003:l016","ordinal":265901,"en":"Did retribution overtake me?"},{"id":"semetey-2-2013:p1043:b003:l017","ordinal":265902,"en":"Did it strike me through the ribs,"},{"id":"semetey-2-2013:p1043:b003:l018","ordinal":265903,"en":"Or make itself felt within my lungs?"},{"id":"semetey-2-2013:p1043:b003:l019","ordinal":265904,"en":"Has Semetey died from it even now?"},{"id":"semetey-2-2013:p1043:b003:l020","ordinal":265905,"en":"Scorching everyone who crossed my path,"},{"id":"semetey-2-2013:p1043:b003:l021","ordinal":265906,"en":"Making your fierce valor known,"},{"id":"semetey-2-2013:p1043:b003:l022","ordinal":265907,"en":"When Köbösh greatly enraged me,"},{"id":"semetey-2-2013:p1043:b003:l023","ordinal":265908,"en":"I sent him to the grave."},{"id":"semetey-2-2013:p1043:b003:l024","ordinal":265909,"en":"And did retribution overtake me?"},{"id":"semetey-2-2013:p1043:b003:l025","ordinal":265910,"en":"Did I close my eyes and stretch out my legs?"},{"id":"semetey-2-2013:p1043:b003:l026","ordinal":265911,"en":"Does the fierce wolf lie dead?"},{"id":"semetey-2-2013:p1043:b003:l027","ordinal":265912,"en":"Has your fierce wolf, even now,"},{"id":"semetey-2-2013:p1043:b003:l028","ordinal":265913,"en":"Suffered the torments of the grave?"},{"id":"semetey-2-2013:p1043:b003:l029","ordinal":265914,"en":"When have I ever heeded a warning rite?"},{"id":"semetey-2-2013:p1043:b003:l030","ordinal":265915,"en":"When he stirred my enmity,"},{"id":"semetey-2-2013:p1043:b003:l031","ordinal":265916,"en":"I devoured my own father, Khan Jakyp."},{"id":"semetey-2-2013:p1043:b003:l032","ordinal":265917,"en":"And did I die?"},{"id":"semetey-2-2013:p1043:b003:l033","ordinal":265918,"en":"Has this precious head, even now,"},{"id":"semetey-2-2013:p1043:b003:l034","ordinal":265919,"en":"Beheld the face of Judgment Day?"},{"id":"semetey-2-2013:p1043:b003:l035","ordinal":265920,"en":"I made my uncle Chyybyt scream;"},{"id":"semetey-2-2013:p1043:b003:l036","ordinal":265921,"en":"I overthrew the six rich lords."},{"id":"semetey-2-2013:p1043:b003:l037","ordinal":265922,"en":"I sent Kölbay to the grave,"},{"id":"semetey-2-2013:p1043:b003:l038","ordinal":265923,"en":"And showed all the people who saw me"},{"id":"semetey-2-2013:p1043:b003:l039","ordinal":265924,"en":"The fierceness of the wolf."},{"id":"semetey-2-2013:p1043:b005:l001","ordinal":265925,"en":"I sent many men to the grave."},{"id":"semetey-2-2013:p1043:b005:l002","ordinal":265926,"en":"And did I die?"},{"id":"semetey-2-2013:p1043:b005:l003","ordinal":265927,"en":"Though retribution came upon so many,"},{"id":"semetey-2-2013:p1043:b005:l004","ordinal":265928,"en":"Where have I ever encountered it?"},{"id":"semetey-2-2013:p1043:b005:l005","ordinal":265929,"en":"When have I died from bloodguilt?"},{"id":"semetey-2-2013:p1043:b005:l006","ordinal":265930,"en":"Those who provoked my fury,"},{"id":"semetey-2-2013:p1043:b005:l007","ordinal":265931,"en":"Those who kept crossing me—"},{"id":"semetey-2-2013:p1043:b005:l008","ordinal":265932,"en":"I slaughtered the forty companions."},{"id":"semetey-2-2013:p1043:b005:l009","ordinal":265933,"en":"They loosed their bows like pouring rain;"},{"id":"semetey-2-2013:p1043:b005:l010","ordinal":265934,"en":"Though I pleaded, they would not spare my life,"},{"id":"semetey-2-2013:p1043:b005:l011","ordinal":265935,"en":"But shot their arrows like hail."},{"id":"semetey-2-2013:p1043:b005:l012","ordinal":265936,"en":"When I drew my steed Buurul forward,"},{"id":"semetey-2-2013:p1043:b005:l013","ordinal":265937,"en":"Though I folded my hands in submission, it availed nothing;"},{"id":"semetey-2-2013:p1043:b005:l014","ordinal":265938,"en":"Thus they seared my soul,"},{"id":"semetey-2-2013:p1043:b005:l015","ordinal":265939,"en":"And set my blood boiling."},{"id":"semetey-2-2013:p1043:b005:l016","ordinal":265940,"en":"Though I pleaded, my kinsmen would not relent,"},{"id":"semetey-2-2013:p1043:b005:l017","ordinal":265941,"en":"But drove my soul to desperation."},{"id":"semetey-2-2013:p1043:b005:l018","ordinal":265942,"en":"They were my father’s legacy,"},{"id":"semetey-2-2013:p1043:b005:l019","ordinal":265943,"en":"And your valor was tested before the people—"},{"id":"semetey-2-2013:p1043:b005:l020","ordinal":265944,"en":"Yet I slaughtered the forty companions."},{"id":"semetey-2-2013:p1043:b005:l021","ordinal":265945,"en":"I unleashed an impossible madness;"},{"id":"semetey-2-2013:p1043:b005:l022","ordinal":265946,"en":"I cut open their pregnant women,"},{"id":"semetey-2-2013:p1043:b005:l023","ordinal":265947,"en":"Shattered the poles of their lattice walls,"},{"id":"semetey-2-2013:p1043:b005:l024","ordinal":265948,"en":"And made their brides and daughters weep."},{"id":"semetey-2-2013:p1043:b005:l025","ordinal":265949,"en":"I smashed every roof pole,"},{"id":"semetey-2-2013:p1043:b005:l026","ordinal":265950,"en":"And made their sons and daughters weep."},{"id":"semetey-2-2013:p1043:b005:l027","ordinal":265951,"en":"I massacred their old,"},{"id":"semetey-2-2013:p1043:b005:l028","ordinal":265952,"en":"Leaving not so much as a hair:"},{"id":"semetey-2-2013:p1043:b005:l029","ordinal":265953,"en":"I destroyed them all."},{"id":"semetey-2-2013:p1043:b005:l030","ordinal":265954,"en":"I devoured my own kin;"},{"id":"semetey-2-2013:p1043:b005:l031","ordinal":265955,"en":"And did I die?"},{"id":"semetey-2-2013:p1043:b005:l032","ordinal":265956,"en":"Did retribution overtake me?"},{"id":"semetey-2-2013:p1043:b005:l033","ordinal":265957,"en":"Has your uncle, even now,"},{"id":"semetey-2-2013:p1043:b005:l034","ordinal":265958,"en":"Let his feet dangle into the grave?"},{"id":"semetey-2-2013:p1043:b005:l035","ordinal":265959,"en":"Has he departed this world?"},{"id":"semetey-2-2013:p1043:b005:l036","ordinal":265960,"en":"Ümötöy, son of Köksö—"},{"id":"semetey-2-2013:p1043:b005:l037","ordinal":265961,"en":"Go and meet Ümötöy."},{"id":"semetey-2-2013:p1043:b005:l038","ordinal":265962,"en":"If that swine will listen to reason,"},{"id":"semetey-2-2013:p1043:b005:l039","ordinal":265963,"en":"There are eight caverns of treasure;"},{"id":"semetey-2-2013:p1044:b003:l001","ordinal":265964,"en":"In the treasury is a yellow key—"},{"id":"semetey-2-2013:p1044:b003:l002","ordinal":265965,"en":"A key with its tassel hanging."},{"id":"semetey-2-2013:p1044:b003:l003","ordinal":265966,"en":"I shall unlock and open its mouth,"},{"id":"semetey-2-2013:p1044:b003:l004","ordinal":265967,"en":"Saying, “Here it is, unruly Kazakh,”"},{"id":"semetey-2-2013:p1044:b003:l005","ordinal":265968,"en":"And among all his people,"},{"id":"semetey-2-2013:p1044:b003:l006","ordinal":265969,"en":"Young and old alike,"},{"id":"semetey-2-2013:p1044:b003:l007","ordinal":265970,"en":"I shall scatter gold by the sackful."},{"id":"semetey-2-2013:p1044:b003:l008","ordinal":265971,"en":"If Ümötöy will listen to reason,"},{"id":"semetey-2-2013:p1044:b003:l009","ordinal":265972,"en":"Let us accept his terms."},{"id":"semetey-2-2013:p1044:b003:l010","ordinal":265973,"en":"On the hills are sixty thousand horses,"},{"id":"semetey-2-2013:p1044:b003:l011","ordinal":265974,"en":"Thoroughbreds mingled with three-year-olds;"},{"id":"semetey-2-2013:p1044:b003:l012","ordinal":265975,"en":"Let us drive them forth in a train,"},{"id":"semetey-2-2013:p1044:b003:l013","ordinal":265976,"en":"And accept his terms."},{"id":"semetey-2-2013:p1044:b003:l014","ordinal":265977,"en":"If he treats his cousin with honor,"},{"id":"semetey-2-2013:p1044:b003:l015","ordinal":265978,"en":"Let us give this Ümötöy"},{"id":"semetey-2-2013:p1044:b003:l016","ordinal":265979,"en":"Thoroughbreds mingled with swift racers."},{"id":"semetey-2-2013:p1044:b003:l017","ordinal":265980,"en":"Give him robes to wear;"},{"id":"semetey-2-2013:p1044:b003:l018","ordinal":265981,"en":"If Ümötöy will make peace,"},{"id":"semetey-2-2013:p1044:b003:l019","ordinal":265982,"en":"Give him whatever force he asks,"},{"id":"semetey-2-2013:p1044:b003:l020","ordinal":265983,"en":"And grant him abundant herds in great number."},{"id":"semetey-2-2013:p1044:b003:l021","ordinal":265984,"en":"Let us eat meat from a single platter,"}]
