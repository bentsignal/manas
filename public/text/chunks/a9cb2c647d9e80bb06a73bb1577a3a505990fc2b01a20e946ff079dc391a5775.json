[{"id":"semetey-2-2013:p1386:b003:l019","ordinal":293377,"en":"The graceful, ill-fated woman"},{"id":"semetey-2-2013:p1386:b003:l020","ordinal":293378,"en":"Came upon the forty wrestlers"},{"id":"semetey-2-2013:p1386:b003:l021","ordinal":293379,"en":"And saw her mother Kanykey"},{"id":"semetey-2-2013:p1386:b003:l022","ordinal":293380,"en":"Suffering humiliation."},{"id":"semetey-2-2013:p1386:b003:l023","ordinal":293381,"en":"Unable to die though she burned with anguish,"},{"id":"semetey-2-2013:p1386:b003:l024","ordinal":293382,"en":"Before the throne in the palace,"},{"id":"semetey-2-2013:p1386:b003:l025","ordinal":293383,"en":"At the pit they had dug,"},{"id":"semetey-2-2013:p1386:b003:l026","ordinal":293384,"en":"Amid the abuses devised by Kanchoro"},{"id":"semetey-2-2013:p1386:b003:l027","ordinal":293385,"en":"And the violent uproar,"},{"id":"semetey-2-2013:p1386:b003:l028","ordinal":293386,"en":"Akbala entered the fray."},{"id":"semetey-2-2013:p1386:b003:l029","ordinal":293387,"en":"Her lovely hair, thick as meadow grass,"},{"id":"semetey-2-2013:p1386:b003:l030","ordinal":293388,"en":"She gathered and bound upon her crown;"},{"id":"semetey-2-2013:p1386:b003:l031","ordinal":293389,"en":"Külchoro’s coat of mail"},{"id":"semetey-2-2013:p1386:b003:l032","ordinal":293390,"en":"She drew down over her head."},{"id":"semetey-2-2013:p1386:b003:l033","ordinal":293391,"en":"A matchlessly swift gray three-year-old,"},{"id":"semetey-2-2013:p1386:b003:l034","ordinal":293392,"en":"The foal of a young mare,"},{"id":"semetey-2-2013:p1386:b003:l035","ordinal":293393,"en":"A horse born like the whirlwind—"},{"id":"semetey-2-2013:p1386:b003:l036","ordinal":293394,"en":"Tucking up her flowing dress,"},{"id":"semetey-2-2013:p1386:b003:l037","ordinal":293395,"en":"She sprang bareback upon it."},{"id":"semetey-2-2013:p1386:b003:l038","ordinal":293396,"en":"Wheeling the gray horse about,"},{"id":"semetey-2-2013:p1386:b003:l039","ordinal":293397,"en":"She struck down seven"},{"id":"semetey-2-2013:p1386:b004:l001","ordinal":293398,"en":"Of the wrestlers and sent them sprawling;"},{"id":"semetey-2-2013:p1386:b004:l002","ordinal":293399,"en":"She made them swallow their fill of blows"},{"id":"semetey-2-2013:p1386:b004:l003","ordinal":293400,"en":"And cry, “Mercy, daughter-in-law!”"},{"id":"semetey-2-2013:p1386:b004:l004","ordinal":293401,"en":"Akbala drove them onward."},{"id":"semetey-2-2013:p1386:b004:l005","ordinal":293402,"en":"Every wrestler who came near,"},{"id":"semetey-2-2013:p1386:b004:l006","ordinal":293403,"en":"She slashed and stabbed with her dagger;"},{"id":"semetey-2-2013:p1386:b004:l007","ordinal":293404,"en":"Akbala laid them low."},{"id":"semetey-2-2013:p1386:b004:l008","ordinal":293405,"en":"Though they were mighty veteran wrestlers,"},{"id":"semetey-2-2013:p1386:b004:l009","ordinal":293406,"en":"All fled from the woman,"},{"id":"semetey-2-2013:p1386:b004:l010","ordinal":293407,"en":"As though slaughter had fallen upon them;"},{"id":"semetey-2-2013:p1386:b004:l011","ordinal":293408,"en":"They fled for their lives."},{"id":"semetey-2-2013:p1386:b004:l012","ordinal":293409,"en":"Into the gated palace,"},{"id":"semetey-2-2013:p1386:b004:l013","ordinal":293410,"en":"Into Chachykey’s stronghold,"},{"id":"semetey-2-2013:p1386:b004:l014","ordinal":293411,"en":"Into the garden pitched for royalty,"},{"id":"semetey-2-2013:p1386:b004:l015","ordinal":293412,"en":"Into the encampment of Khan Kanchoro,"},{"id":"semetey-2-2013:p1386:b004:l016","ordinal":293413,"en":"Akbala drove the wrestlers,"},{"id":"semetey-2-2013:p1386:b004:l017","ordinal":293414,"en":"Sending them staggering inside."},{"id":"semetey-2-2013:p1386:b004:l018","ordinal":293415,"en":"Dealing with each in turn,"},{"id":"semetey-2-2013:p1386:b004:l019","ordinal":293416,"en":"Akbala laid them low."},{"id":"semetey-2-2013:p1386:b004:l020","ordinal":293417,"en":"“We have been disgraced by a young wife!"},{"id":"semetey-2-2013:p1386:b004:l021","ordinal":293418,"en":"Some of us have been killed!"},{"id":"semetey-2-2013:p1386:b004:l022","ordinal":293419,"en":"We have been disgraced by a woman!"},{"id":"semetey-2-2013:p1386:b004:l023","ordinal":293420,"en":"Some of us are dead!”"},{"id":"semetey-2-2013:p1386:b004:l024","ordinal":293421,"en":"The wrestlers fled inside;"},{"id":"semetey-2-2013:p1386:b004:l025","ordinal":293422,"en":"And Kanchoro learned"},{"id":"semetey-2-2013:p1386:b004:l026","ordinal":293423,"en":"That they had come stumbling in."},{"id":"semetey-2-2013:p1386:b004:l027","ordinal":293424,"en":"Once Kanchoro understood,"},{"id":"semetey-2-2013:p1386:b004:l028","ordinal":293425,"en":"He leapt grimly from his throne"},{"id":"semetey-2-2013:p1386:b004:l029","ordinal":293426,"en":"And ran out through the gate."},{"id":"semetey-2-2013:p1386:b004:l030","ordinal":293427,"en":"Poor Akbala came charging,"},{"id":"semetey-2-2013:p1386:b004:l031","ordinal":293428,"en":"Driving the wrestlers"},{"id":"semetey-2-2013:p1386:b004:l032","ordinal":293429,"en":"And penning them against the gate,"},{"id":"semetey-2-2013:p1386:b004:l033","ordinal":293430,"en":"When from farther in, puffed with pride,"},{"id":"semetey-2-2013:p1386:b004:l034","ordinal":293431,"en":"The accursed firebrand,"},{"id":"semetey-2-2013:p1386:b004:l035","ordinal":293432,"en":"The scorched madman,"},{"id":"semetey-2-2013:p1386:b004:l036","ordinal":293433,"en":"Kanchoro suddenly appeared."},{"id":"semetey-2-2013:p1386:b004:l037","ordinal":293434,"en":"When she saw Kanchoro,"},{"id":"semetey-2-2013:p1386:b004:l038","ordinal":293435,"en":"Valiant Akbala"},{"id":"semetey-2-2013:p1386:b004:l039","ordinal":293436,"en":"Unleashed her terrible fury."},{"id":"semetey-2-2013:p1387:b003:l001","ordinal":293437,"en":"At the mouth of the gate, Kanchoro"},{"id":"semetey-2-2013:p1387:b003:l002","ordinal":293438,"en":"Struck her in the lung"},{"id":"semetey-2-2013:p1387:b003:l003","ordinal":293439,"en":"With his dagger and flung her aside."},{"id":"semetey-2-2013:p1387:b003:l004","ordinal":293440,"en":"Her battle cry split the stones"},{"id":"semetey-2-2013:p1387:b003:l005","ordinal":293441,"en":"As she bore down upon Kanchoro,"},{"id":"semetey-2-2013:p1387:b003:l006","ordinal":293442,"en":"Just as she was about to reach the warrior"},{"id":"semetey-2-2013:p1387:b003:l007","ordinal":293443,"en":"And destroy him utterly."},{"id":"semetey-2-2013:p1387:b003:l008","ordinal":293444,"en":"But Kanchoro was well prepared:"},{"id":"semetey-2-2013:p1387:b003:l009","ordinal":293445,"en":"He had fitted his weapon with black horsehair,"},{"id":"semetey-2-2013:p1387:b003:l010","ordinal":293446,"en":"Sighting and balancing it against the foe,"},{"id":"semetey-2-2013:p1387:b003:l011","ordinal":293447,"en":"Had forged grooves into its iron,"},{"id":"semetey-2-2013:p1387:b003:l012","ordinal":293448,"en":"And honed it like a wolf’s tongue."},{"id":"semetey-2-2013:p1387:b003:l013","ordinal":293449,"en":"Lest it slip from the hand in haste,"},{"id":"semetey-2-2013:p1387:b003:l014","ordinal":293450,"en":"He had wound it with yellow brass;"},{"id":"semetey-2-2013:p1387:b003:l015","ordinal":293451,"en":"When struck by a switch it rang aloud,"},{"id":"semetey-2-2013:p1387:b003:l016","ordinal":293452,"en":"Singing like a war drum."},{"id":"semetey-2-2013:p1387:b003:l017","ordinal":293453,"en":"From an irgay shrub at the foot of Opol Mountain,"},{"id":"semetey-2-2013:p1387:b003:l018","ordinal":293454,"en":"Torn out by the roots"},{"id":"semetey-2-2013:p1387:b003:l019","ordinal":293455,"en":"And twisted by wrestlers,"},{"id":"semetey-2-2013:p1387:b003:l020","ordinal":293456,"en":"He had made its sturdy shaft."},{"id":"semetey-2-2013:p1387:b003:l021","ordinal":293457,"en":"Where the grooves lay open,"},{"id":"semetey-2-2013:p1387:b003:l022","ordinal":293458,"en":"He had wrapped it with sinew,"},{"id":"semetey-2-2013:p1387:b003:l023","ordinal":293459,"en":"And to ensure a firmer grip"},{"id":"semetey-2-2013:p1387:b003:l024","ordinal":293460,"en":"Had soaked it through with glue."},{"id":"semetey-2-2013:p1387:b003:l025","ordinal":293461,"en":"He had covered it in camel-hide"},{"id":"semetey-2-2013:p1387:b003:l026","ordinal":293462,"en":"And fitted the shaft for war."},{"id":"semetey-2-2013:p1387:b003:l027","ordinal":293463,"en":"Such was Khan Kanchoro’s spear—"},{"id":"semetey-2-2013:p1387:b003:l028","ordinal":293464,"en":"So strong and cunningly fashioned."},{"id":"semetey-2-2013:p1387:b003:l029","ordinal":293465,"en":"The seasoned slave, that wolf of war,"},{"id":"semetey-2-2013:p1387:b003:l030","ordinal":293466,"en":"Had entered many battles before;"},{"id":"semetey-2-2013:p1387:b003:l031","ordinal":293467,"en":"In the days of the gray-maned leopard"},{"id":"semetey-2-2013:p1387:b003:l032","ordinal":293468,"en":"The hardened slave had seen much."},{"id":"semetey-2-2013:p1387:b003:l033","ordinal":293469,"en":"He was skilled in the handling of spears,"},{"id":"semetey-2-2013:p1387:b003:l034","ordinal":293470,"en":"And in every circumstance"},{"id":"semetey-2-2013:p1387:b003:l035","ordinal":293471,"en":"The sturdy slave found the surest stratagem."},{"id":"semetey-2-2013:p1387:b003:l036","ordinal":293472,"en":"Holding the iron-and-brass spear"},{"id":"semetey-2-2013:p1387:b003:l037","ordinal":293473,"en":"Short beneath its blade,"},{"id":"semetey-2-2013:p1387:b003:l038","ordinal":293474,"en":"Aiming this side of the ribs,"},{"id":"semetey-2-2013:p1387:b003:l039","ordinal":293475,"en":"At the edge of lung and liver,"},{"id":"semetey-2-2013:p1387:b005:l001","ordinal":293476,"en":"The raging swine struck."},{"id":"semetey-2-2013:p1387:b005:l002","ordinal":293477,"en":"When the practiced swine struck,"},{"id":"semetey-2-2013:p1387:b005:l003","ordinal":293478,"en":"The gray horse crumpled and fell,"},{"id":"semetey-2-2013:p1387:b005:l004","ordinal":293479,"en":"And poor Akbala plunged straight down."},{"id":"semetey-2-2013:p1387:b005:l005","ordinal":293480,"en":"“She is truly my enemy,”"},{"id":"semetey-2-2013:p1387:b005:l006","ordinal":293481,"en":"Thought Khan Kanchoro,"},{"id":"semetey-2-2013:p1387:b005:l007","ordinal":293482,"en":"And an incurable hatred lodged in his heart."},{"id":"semetey-2-2013:p1387:b005:l008","ordinal":293483,"en":"His dagger-bearing wrestlers"},{"id":"semetey-2-2013:p1387:b005:l009","ordinal":293484,"en":"Closed fiercely around"},{"id":"semetey-2-2013:p1387:b005:l010","ordinal":293485,"en":"That woman Akbala."},{"id":"semetey-2-2013:p1387:b005:l011","ordinal":293486,"en":"Before the white dagger in her hand"},{"id":"semetey-2-2013:p1387:b005:l012","ordinal":293487,"en":"Could rise and stab,"},{"id":"semetey-2-2013:p1387:b005:l013","ordinal":293488,"en":"Before she could settle the uproar,"},{"id":"semetey-2-2013:p1387:b005:l014","ordinal":293489,"en":"Before she could slaughter five or six,"},{"id":"semetey-2-2013:p1387:b005:l015","ordinal":293490,"en":"The ready Kanchoro"},{"id":"semetey-2-2013:p1387:b005:l016","ordinal":293491,"en":"Found yet another way:"},{"id":"semetey-2-2013:p1387:b005:l017","ordinal":293492,"en":"Taking his golden-bladed battle-axe,"},{"id":"semetey-2-2013:p1387:b005:l018","ordinal":293493,"en":"The practiced Kanchoro"},{"id":"semetey-2-2013:p1387:b005:l019","ordinal":293494,"en":"Struck from Akbala’s hand"},{"id":"semetey-2-2013:p1387:b005:l020","ordinal":293495,"en":"The white dagger."},{"id":"semetey-2-2013:p1387:b005:l021","ordinal":293496,"en":"Deprived of her white dagger,"},{"id":"semetey-2-2013:p1387:b005:l022","ordinal":293497,"en":"Akbala fell into the snare."},{"id":"semetey-2-2013:p1387:b005:l023","ordinal":293498,"en":"Her ribs felt torn apart,"},{"id":"semetey-2-2013:p1387:b005:l024","ordinal":293499,"en":"Tears poured from her eyes,"},{"id":"semetey-2-2013:p1387:b005:l025","ordinal":293500,"en":"Her nose ran like a spring,"},{"id":"semetey-2-2013:p1387:b005:l026","ordinal":293501,"en":"And all around the young woman"},{"id":"semetey-2-2013:p1387:b005:l027","ordinal":293502,"en":"A clamor rose to split the sky—"},{"id":"semetey-2-2013:p1387:b005:l028","ordinal":293503,"en":"Akbala had been captured."},{"id":"semetey-2-2013:p1387:b005:l029","ordinal":293504,"en":"Into a misery no struggling could escape,"},{"id":"semetey-2-2013:p1387:b005:l030","ordinal":293505,"en":"Akbala had fallen."},{"id":"semetey-2-2013:p1387:b005:l031","ordinal":293506,"en":"Then Akbala,"},{"id":"semetey-2-2013:p1387:b005:l032","ordinal":293507,"en":"At the gateway before Kanchoro,"},{"id":"semetey-2-2013:p1387:b005:l033","ordinal":293508,"en":"Spoke these words to him,"},{"id":"semetey-2-2013:p1387:b005:l034","ordinal":293509,"en":"Words of dreadful grief to those who understood:"},{"id":"semetey-2-2013:p1387:b005:l035","ordinal":293510,"en":"“You warrior-slave who slaughtered your lord,"},{"id":"semetey-2-2013:p1387:b005:l036","ordinal":293511,"en":"You vile slave who sets himself up as a prince!"},{"id":"semetey-2-2013:p1387:b005:l037","ordinal":293512,"en":"What has come over you, infidel slave,"},{"id":"semetey-2-2013:p1387:b005:l038","ordinal":293513,"en":"That you would massacre us all without heirs—"},{"id":"semetey-2-2013:p1387:b005:l039","ordinal":293514,"en":"Helpless women and little children—"},{"id":"semetey-2-2013:p1388:b003:l001","ordinal":293515,"en":"The feeble old and foolish young—"},{"id":"semetey-2-2013:p1388:b003:l002","ordinal":293516,"en":"And inflict such tyranny,"},{"id":"semetey-2-2013:p1388:b003:l003","ordinal":293517,"en":"Plunder and destroy us,"},{"id":"semetey-2-2013:p1388:b003:l004","ordinal":293518,"en":"And wipe us out completely,"},{"id":"semetey-2-2013:p1388:b003:l005","ordinal":293519,"en":"Shouting as you thrust your spear,"},{"id":"semetey-2-2013:p1388:b003:l006","ordinal":293520,"en":"Slaying the khans outright,"},{"id":"semetey-2-2013:p1388:b003:l007","ordinal":293521,"en":"Killing people on every side,"},{"id":"semetey-2-2013:p1388:b003:l008","ordinal":293522,"en":"And utterly erasing our line?"},{"id":"semetey-2-2013:p1388:b003:l009","ordinal":293523,"en":"Were we born on a barren black cliff,"},{"id":"semetey-2-2013:p1388:b003:l010","ordinal":293524,"en":"Or are we less than a khan’s children?"},{"id":"semetey-2-2013:p1388:b003:l011","ordinal":293525,"en":"Were you the one burdened with grief?"},{"id":"semetey-2-2013:p1388:b003:l012","ordinal":293526,"en":"Were we not the Chinese who butchered"},{"id":"semetey-2-2013:p1388:b003:l013","ordinal":293527,"en":"Your bloodthirsty father Chubak"},{"id":"semetey-2-2013:p1388:b003:l014","ordinal":293528,"en":"And left him lying dead?"},{"id":"semetey-2-2013:p1388:b003:l015","ordinal":293529,"en":"Your vaunted courage has no equal,"},{"id":"semetey-2-2013:p1388:b003:l016","ordinal":293530,"en":"But your mother’s vengeance is not upon us;"},{"id":"semetey-2-2013:p1388:b003:l017","ordinal":293531,"en":"Your swaggering has no equal,"},{"id":"semetey-2-2013:p1388:b003:l018","ordinal":293532,"en":"Yet no vengeance for your kin lies here!"},{"id":"semetey-2-2013:p1388:b003:l019","ordinal":293533,"en":"Your father was a roaring beast of a slave,"},{"id":"semetey-2-2013:p1388:b003:l020","ordinal":293534,"en":"But did we slaughter his whole village?"},{"id":"semetey-2-2013:p1388:b003:l021","ordinal":293535,"en":"Did we settle the score without measure?"},{"id":"semetey-2-2013:p1388:b003:l022","ordinal":293536,"en":"Did we carry off the world,"},{"id":"semetey-2-2013:p1388:b003:l023","ordinal":293537,"en":"Or scatter silver coins in its corners?"},{"id":"semetey-2-2013:p1388:b003:l024","ordinal":293538,"en":"Did we flee in pursuit of wild asses,"},{"id":"semetey-2-2013:p1388:b003:l025","ordinal":293539,"en":"Or scatter coins from our saddlebags?"},{"id":"semetey-2-2013:p1388:b003:l026","ordinal":293540,"en":"Did we ruin your standing grain,"},{"id":"semetey-2-2013:p1388:b003:l027","ordinal":293541,"en":"Or slaughter your forefather Akbaltay?"},{"id":"semetey-2-2013:p1388:b003:l028","ordinal":293542,"en":"Accursed madman,"},{"id":"semetey-2-2013:p1388:b003:l029","ordinal":293543,"en":"You drove my caravan from Keng-Kol;"},{"id":"semetey-2-2013:p1388:b003:l030","ordinal":293544,"en":"Alas, before this swaggering slave,"},{"id":"semetey-2-2013:p1388:b003:l031","ordinal":293545,"en":"Accursed be my womanhood—"},{"id":"semetey-2-2013:p1388:b003:l032","ordinal":293546,"en":"I cannot take my revenge!"},{"id":"semetey-2-2013:p1388:b003:l033","ordinal":293547,"en":"You slaughtered my people in Talas;"},{"id":"semetey-2-2013:p1388:b003:l034","ordinal":293548,"en":"Slave and beggar, you have cruelly"},{"id":"semetey-2-2013:p1388:b003:l035","ordinal":293549,"en":"Stripped me of all dignity!"},{"id":"semetey-2-2013:p1388:b003:l036","ordinal":293550,"en":"By heaven, I shall scatter your caravan from Chatkal!"},{"id":"semetey-2-2013:p1388:b003:l037","ordinal":293551,"en":"Allah, Allah, Creator of the open plain,"},{"id":"semetey-2-2013:p1388:b003:l038","ordinal":293552,"en":"When shall I ever take my revenge?!”"},{"id":"semetey-2-2013:p1388:b003:l039","ordinal":293553,"en":"As the woman wailed,"},{"id":"semetey-2-2013:p1388:b004:l001","ordinal":293554,"en":"Kanchoro did not look at her."},{"id":"semetey-2-2013:p1388:b004:l002","ordinal":293555,"en":"As the young wife lamented,"},{"id":"semetey-2-2013:p1388:b004:l003","ordinal":293556,"en":"He remained utterly unmoved;"},{"id":"semetey-2-2013:p1388:b004:l004","ordinal":293557,"en":"However many words a woman spoke,"},{"id":"semetey-2-2013:p1388:b004:l005","ordinal":293558,"en":"The ill-starred Kanchoro"},{"id":"semetey-2-2013:p1388:b004:l006","ordinal":293559,"en":"Did not value them a scrap."},{"id":"semetey-2-2013:p1388:b004:l007","ordinal":293560,"en":"Then Chachykey within the fortress,"},{"id":"semetey-2-2013:p1388:b004:l008","ordinal":293561,"en":"Your great sister-in-law with a rump broad as an embrace,"},{"id":"semetey-2-2013:p1388:b004:l009","ordinal":293562,"en":"Shouted down from the tower"},{"id":"semetey-2-2013:p1388:b004:l010","ordinal":293563,"en":"And summoned the forty wrestlers;"},{"id":"semetey-2-2013:p1388:b004:l011","ordinal":293564,"en":"Chachykey issued her decree."},{"id":"semetey-2-2013:p1388:b004:l012","ordinal":293565,"en":"Because Akbala had spoken,"},{"id":"semetey-2-2013:p1388:b004:l013","ordinal":293566,"en":"Chachykey dealt harshly with her:"},{"id":"semetey-2-2013:p1388:b004:l014","ordinal":293567,"en":"“That cackling infidel—"},{"id":"semetey-2-2013:p1388:b004:l015","ordinal":293568,"en":"That woman called Akbala—"},{"id":"semetey-2-2013:p1388:b004:l016","ordinal":293569,"en":"Slit her soles and rub in salt;"},{"id":"semetey-2-2013:p1388:b004:l017","ordinal":293570,"en":"Cut open her crown and put worms in it;"},{"id":"semetey-2-2013:p1388:b004:l018","ordinal":293571,"en":"Dress her in a rough homespun coat,"},{"id":"semetey-2-2013:p1388:b004:l019","ordinal":293572,"en":"Mount her on a lanky mare,"},{"id":"semetey-2-2013:p1388:b004:l020","ordinal":293573,"en":"Send her after the sheep,"},{"id":"semetey-2-2013:p1388:b004:l021","ordinal":293574,"en":"And make the wretch tend livestock."},{"id":"semetey-2-2013:p1388:b004:l022","ordinal":293575,"en":"Break the former fury"},{"id":"semetey-2-2013:p1388:b004:l023","ordinal":293576,"en":"Of that rude and reckless woman,"},{"id":"semetey-2-2013:p1388:b004:l024","ordinal":293577,"en":"That bellowing infidel."},{"id":"semetey-2-2013:p1388:b004:l025","ordinal":293578,"en":"Look upon our Khan Kanchoro,"},{"id":"semetey-2-2013:p1388:b004:l026","ordinal":293579,"en":"And look upon the insolence"},{"id":"semetey-2-2013:p1388:b004:l027","ordinal":293580,"en":"Of that bellowing woman!"},{"id":"semetey-2-2013:p1388:b004:l028","ordinal":293581,"en":"Gather all your strength against her;"},{"id":"semetey-2-2013:p1388:b004:l029","ordinal":293582,"en":"Break the swelling fury"},{"id":"semetey-2-2013:p1388:b004:l030","ordinal":293583,"en":"Of that howling infidel!"},{"id":"semetey-2-2013:p1388:b004:l031","ordinal":293584,"en":"Break the withered spirit"},{"id":"semetey-2-2013:p1388:b004:l032","ordinal":293585,"en":"Of that strutting infidel!"},{"id":"semetey-2-2013:p1388:b004:l033","ordinal":293586,"en":"Stretch her out and thrash her like a hide!"},{"id":"semetey-2-2013:p1388:b004:l034","ordinal":293587,"en":"Let her gather firewood and carry water;"},{"id":"semetey-2-2013:p1388:b004:l035","ordinal":293588,"en":"Give that worn-out harlot"},{"id":"semetey-2-2013:p1388:b004:l036","ordinal":293589,"en":"To the herdsman!”"},{"id":"semetey-2-2013:p1388:b004:l037","ordinal":293590,"en":"The many wrestlers standing there"},{"id":"semetey-2-2013:p1388:b004:l038","ordinal":293591,"en":"Cried, “Yes, sister-in-law, yes!”"},{"id":"semetey-2-2013:p1388:b004:l039","ordinal":293592,"en":"And brought great misery upon the woman."},{"id":"semetey-2-2013:p1389:b003:l001","ordinal":293593,"en":"The wrestlers who received the command—"},{"id":"semetey-2-2013:p1389:b003:l002","ordinal":293594,"en":"May God have cursed them long before—"},{"id":"semetey-2-2013:p1389:b003:l003","ordinal":293595,"en":"Did to poor Akbala"},{"id":"semetey-2-2013:p1389:b003:l004","ordinal":293596,"en":"Exactly as Chachykey"},{"id":"semetey-2-2013:p1389:b003:l005","ordinal":293597,"en":"Had ordered:"},{"id":"semetey-2-2013:p1389:b003:l006","ordinal":293598,"en":"They slit her crown and put worms in it,"},{"id":"semetey-2-2013:p1389:b003:l007","ordinal":293599,"en":"Slit her soles and rubbed in salt,"},{"id":"semetey-2-2013:p1389:b003:l008","ordinal":293600,"en":"Mounted her on a lanky mare,"},{"id":"semetey-2-2013:p1389:b003:l009","ordinal":293601,"en":"And clothed her in a coarse felt coat."},{"id":"semetey-2-2013:p1389:b003:l010","ordinal":293602,"en":"The shepherd violated her by force,"},{"id":"semetey-2-2013:p1389:b003:l011","ordinal":293603,"en":"The herdsman beat and violated her;"},{"id":"semetey-2-2013:p1389:b003:l012","ordinal":293604,"en":"Not once, but a thousand times,"},{"id":"semetey-2-2013:p1389:b003:l013","ordinal":293605,"en":"They committed horrors dreadful to know."},{"id":"semetey-2-2013:p1389:b003:l014","ordinal":293606,"en":"Upon Akbala’s head"},{"id":"semetey-2-2013:p1389:b003:l015","ordinal":293607,"en":"They heaped not one torment but a thousand,"},{"id":"semetey-2-2013:p1389:b003:l016","ordinal":293608,"en":"And brought her terrible misery;"},{"id":"semetey-2-2013:p1389:b003:l017","ordinal":293609,"en":"Her noble head was enslaved."},{"id":"semetey-2-2013:p1389:b003:l018","ordinal":293610,"en":"Though a virtuous woman, she was beaten"},{"id":"semetey-2-2013:p1389:b003:l019","ordinal":293611,"en":"And reviled by a scabby woman."},{"id":"semetey-2-2013:p1389:b003:l020","ordinal":293612,"en":"To think of it, those were dreadful days:"},{"id":"semetey-2-2013:p1389:b003:l021","ordinal":293613,"en":"Kanykey and Akbala"},{"id":"semetey-2-2013:p1389:b003:l022","ordinal":293614,"en":"Became slaves to Khan Kanchoro."},{"id":"semetey-2-2013:p1389:b003:l023","ordinal":293615,"en":"Day followed day,"},{"id":"semetey-2-2013:p1389:b003:l024","ordinal":293616,"en":"Each passing in torment;"},{"id":"semetey-2-2013:p1389:b003:l025","ordinal":293617,"en":"They sent Akbala barefoot"},{"id":"semetey-2-2013:p1389:b003:l026","ordinal":293618,"en":"To follow behind the cows."},{"id":"semetey-2-2013:p1389:b003:l027","ordinal":293619,"en":"And poor Kanykey"},{"id":"semetey-2-2013:p1389:b003:l028","ordinal":293620,"en":"They made tend the calves."},{"id":"semetey-2-2013:p1389:b003:l029","ordinal":293621,"en":"Let us leave this matter here"},{"id":"semetey-2-2013:p1389:b003:l030","ordinal":293622,"en":"And begin again from another side:"},{"id":"semetey-2-2013:p1389:b003:l031","ordinal":293623,"en":"Chürök, the moonlike woman—"},{"id":"semetey-2-2013:p1389:b003:l032","ordinal":293624,"en":"Upon Chürök they heaped turmoil."},{"id":"semetey-2-2013:p1389:b003:l033","ordinal":293625,"en":"In the havoc inflicted upon Chürök,"},{"id":"semetey-2-2013:p1389:b003:l034","ordinal":293626,"en":"Who showed regard for ancestral spirits?"},{"id":"semetey-2-2013:p1389:b003:l035","ordinal":293627,"en":"Every one of the bloodthirsty hero’s countless treasures"},{"id":"semetey-2-2013:p1389:b003:l036","ordinal":293628,"en":"They went and plundered, leaving nothing."},{"id":"semetey-2-2013:p1389:b003:l037","ordinal":293629,"en":"They seized all her silks,"},{"id":"semetey-2-2013:p1389:b003:l038","ordinal":293630,"en":"And brought grievous misery;"},{"id":"semetey-2-2013:p1389:b003:l039","ordinal":293631,"en":"They plundered all the gold"},{"id":"semetey-2-2013:p1389:b004:l001","ordinal":293632,"en":"And inflicted bitter suffering."}]
