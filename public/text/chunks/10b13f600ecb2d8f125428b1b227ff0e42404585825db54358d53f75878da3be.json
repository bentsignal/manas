[{"id":"semetey-1-2013:p0884:b004:l038","ordinal":144641,"en":"God, do not let us see their faces!"},{"id":"semetey-1-2013:p0884:b004:l039","ordinal":144642,"en":"One could not tell who was who!"},{"id":"semetey-1-2013:p0885:b003:l001","ordinal":144643,"en":"Gray-mottled banners, red standards,"},{"id":"semetey-1-2013:p0885:b003:l002","ordinal":144644,"en":"A tumult of cries and shouts!"},{"id":"semetey-1-2013:p0885:b003:l003","ordinal":144645,"en":"All around the orphan"},{"id":"semetey-1-2013:p0885:b003:l004","ordinal":144646,"en":"Arrows rattled from the bows,"},{"id":"semetey-1-2013:p0885:b003:l005","ordinal":144647,"en":"Shots fell thick as hail."},{"id":"semetey-1-2013:p0885:b003:l006","ordinal":144648,"en":"The forty companions left by Manas"},{"id":"semetey-1-2013:p0885:b003:l007","ordinal":144649,"en":"Surged shouting through the royal camp,"},{"id":"semetey-1-2013:p0885:b003:l008","ordinal":144650,"en":"The points of their spears clashing."},{"id":"semetey-1-2013:p0885:b003:l009","ordinal":144651,"en":"With wild cries they charged,"},{"id":"semetey-1-2013:p0885:b003:l010","ordinal":144652,"en":"The warriors racing one another."},{"id":"semetey-1-2013:p0885:b003:l011","ordinal":144653,"en":"The great army came sweeping on,"},{"id":"semetey-1-2013:p0885:b003:l012","ordinal":144654,"en":"Closing upon Semetey."},{"id":"semetey-1-2013:p0885:b003:l013","ordinal":144655,"en":"The young lord Semetey"},{"id":"semetey-1-2013:p0885:b003:l014","ordinal":144656,"en":"Struck his noble steed upon the flank,"},{"id":"semetey-1-2013:p0885:b003:l015","ordinal":144657,"en":"And plunged among the countless troops,"},{"id":"semetey-1-2013:p0885:b003:l016","ordinal":144658,"en":"Semetey attacking in earnest."},{"id":"semetey-1-2013:p0885:b003:l017","ordinal":144659,"en":"When Semetey struck,"},{"id":"semetey-1-2013:p0885:b003:l018","ordinal":144660,"en":"Those whose appointed time had come died."},{"id":"semetey-1-2013:p0885:b003:l019","ordinal":144661,"en":"They thrust in utter confusion,"},{"id":"semetey-1-2013:p0885:b003:l020","ordinal":144662,"en":"Fighting like dogs,"},{"id":"semetey-1-2013:p0885:b003:l021","ordinal":144663,"en":"Jostling and trampling together."},{"id":"semetey-1-2013:p0885:b003:l022","ordinal":144664,"en":"Then your dear mother Kanykei"},{"id":"semetey-1-2013:p0885:b003:l023","ordinal":144665,"en":"Saddled up and mounted in earnest."},{"id":"semetey-1-2013:p0885:b003:l024","ordinal":144666,"en":"Her black hair, thick as a girth,"},{"id":"semetey-1-2013:p0885:b003:l025","ordinal":144667,"en":"She bound tightly upon her crown."},{"id":"semetey-1-2013:p0885:b003:l026","ordinal":144668,"en":"Semetey's old fur cap"},{"id":"semetey-1-2013:p0885:b003:l027","ordinal":144669,"en":"She pulled firmly over her head."},{"id":"semetey-1-2013:p0885:b003:l028","ordinal":144670,"en":"“If my time has come, I shall die;"},{"id":"semetey-1-2013:p0885:b003:l029","ordinal":144671,"en":"If suffering awaits me, I shall endure it."},{"id":"semetey-1-2013:p0885:b003:l030","ordinal":144672,"en":"For the orphan left by the Magnanimous One"},{"id":"semetey-1-2013:p0885:b003:l031","ordinal":144673,"en":"I shall stand as a protector,” she said."},{"id":"semetey-1-2013:p0885:b003:l032","ordinal":144674,"en":"Taking her battle-axe, she swung it,"},{"id":"semetey-1-2013:p0885:b003:l033","ordinal":144675,"en":"And some of the forty companions"},{"id":"semetey-1-2013:p0885:b003:l034","ordinal":144676,"en":"She struck down and sent crawling."},{"id":"semetey-1-2013:p0885:b003:l035","ordinal":144677,"en":"Making ready upon their flank,"},{"id":"semetey-1-2013:p0885:b003:l036","ordinal":144678,"en":"Kanykei rushed into the fight."},{"id":"semetey-1-2013:p0885:b003:l037","ordinal":144679,"en":"Making Tuuchunak rear and bound,"},{"id":"semetey-1-2013:p0885:b003:l038","ordinal":144680,"en":"Shattering whoever stood before him,"},{"id":"semetey-1-2013:p0885:b003:l039","ordinal":144681,"en":"Sary Khan came in from one side."},{"id":"semetey-1-2013:p0885:b004:l001","ordinal":144682,"en":"Bakai's son Baitailak,"},{"id":"semetey-1-2013:p0885:b004:l002","ordinal":144683,"en":"Sary Khan's Kalyk,"},{"id":"semetey-1-2013:p0885:b004:l003","ordinal":144684,"en":"Zhamgyrchy's Shayymbet—"},{"id":"semetey-1-2013:p0885:b004:l004","ordinal":144685,"en":"They entered the battle,"},{"id":"semetey-1-2013:p0885:b004:l005","ordinal":144686,"en":"And now took the orphan's side."},{"id":"semetey-1-2013:p0885:b004:l006","ordinal":144687,"en":"They stood against men one by one,"},{"id":"semetey-1-2013:p0885:b004:l007","ordinal":144688,"en":"Fighting with thrusts of their spears."},{"id":"semetey-1-2013:p0885:b004:l008","ordinal":144689,"en":"The two peoples faced each other,"},{"id":"semetey-1-2013:p0885:b004:l009","ordinal":144690,"en":"Grasped their spears,"},{"id":"semetey-1-2013:p0885:b004:l010","ordinal":144691,"en":"And leveled them at one another."},{"id":"semetey-1-2013:p0885:b004:l011","ordinal":144692,"en":"Now a terrible battle raged."},{"id":"semetey-1-2013:p0885:b004:l012","ordinal":144693,"en":"Khan Semetey, the blood-shedding hero,"},{"id":"semetey-1-2013:p0885:b004:l013","ordinal":144694,"en":"Spread havoc in that place."},{"id":"semetey-1-2013:p0885:b004:l014","ordinal":144695,"en":"Through the center the hero Semen"},{"id":"semetey-1-2013:p0885:b004:l015","ordinal":144696,"en":"Carved his way forward."},{"id":"semetey-1-2013:p0885:b004:l016","ordinal":144697,"en":"Around the edges Sary Khan"},{"id":"semetey-1-2013:p0885:b004:l017","ordinal":144698,"en":"Beat his way onward."},{"id":"semetey-1-2013:p0885:b004:l018","ordinal":144699,"en":"Into their very midst Kanykei"},{"id":"semetey-1-2013:p0885:b004:l019","ordinal":144700,"en":"Drove them, hemming them in."},{"id":"semetey-1-2013:p0885:b004:l020","ordinal":144701,"en":"Unable to withstand their fury,"},{"id":"semetey-1-2013:p0885:b004:l021","ordinal":144702,"en":"The countless troops scattered apart,"},{"id":"semetey-1-2013:p0885:b004:l022","ordinal":144703,"en":"Screaming, not knowing what to do."},{"id":"semetey-1-2013:p0885:b004:l023","ordinal":144704,"en":"Semetey and Kanykei—"},{"id":"semetey-1-2013:p0885:b004:l024","ordinal":144705,"en":"When they saw these two,"},{"id":"semetey-1-2013:p0885:b004:l025","ordinal":144706,"en":"The poor people driven there,"},{"id":"semetey-1-2013:p0885:b004:l026","ordinal":144707,"en":"Argyn and Kyrgyz together,"},{"id":"semetey-1-2013:p0885:b004:l027","ordinal":144708,"en":"Broke away to the very last man."},{"id":"semetey-1-2013:p0885:b004:l028","ordinal":144709,"en":"They threw down their spears,"},{"id":"semetey-1-2013:p0885:b004:l029","ordinal":144710,"en":"Dismounted from their horses,"},{"id":"semetey-1-2013:p0885:b004:l030","ordinal":144711,"en":"And laid their sashes about their necks."},{"id":"semetey-1-2013:p0885:b004:l031","ordinal":144712,"en":"These were his people, coming before him."},{"id":"semetey-1-2013:p0885:b004:l032","ordinal":144713,"en":"To the poor young lord"},{"id":"semetey-1-2013:p0885:b004:l033","ordinal":144714,"en":"The people said these words:"},{"id":"semetey-1-2013:p0885:b004:l034","ordinal":144715,"en":"“O my gentle, gray-mottled female goshawk,"},{"id":"semetey-1-2013:p0885:b004:l035","ordinal":144716,"en":"My gray goshawk, my morning star!"},{"id":"semetey-1-2013:p0885:b004:l036","ordinal":144717,"en":"Here is the land—take sovereignty;"},{"id":"semetey-1-2013:p0885:b004:l037","ordinal":144718,"en":"Here we are, if you would cut off heads!"},{"id":"semetey-1-2013:p0885:b004:l038","ordinal":144719,"en":"Do not dig my pit deep,"},{"id":"semetey-1-2013:p0885:b004:l039","ordinal":144720,"en":"Heir left by my khan Manas."},{"id":"semetey-1-2013:p0886:b003:l001","ordinal":144721,"en":"Do not boil up my misery!"},{"id":"semetey-1-2013:p0886:b003:l002","ordinal":144722,"en":"When your father Manas died,"},{"id":"semetey-1-2013:p0886:b003:l003","ordinal":144723,"en":"When his people met with grief,"},{"id":"semetey-1-2013:p0886:b003:l004","ordinal":144724,"en":"The six villains became our khans."},{"id":"semetey-1-2013:p0886:b003:l005","ordinal":144725,"en":"Their wrath drove the life from us."},{"id":"semetey-1-2013:p0886:b003:l006","ordinal":144726,"en":"They laid on heavy dues and taxes;"},{"id":"semetey-1-2013:p0886:b003:l007","ordinal":144727,"en":"First of all, they took our livestock."},{"id":"semetey-1-2013:p0886:b003:l008","ordinal":144728,"en":"They began their devastation."},{"id":"semetey-1-2013:p0886:b003:l009","ordinal":144729,"en":"Those who answered back,"},{"id":"semetey-1-2013:p0886:b003:l010","ordinal":144730,"en":"The six villains in their fury"},{"id":"semetey-1-2013:p0886:b003:l011","ordinal":144731,"en":"Slaughtered to the last."},{"id":"semetey-1-2013:p0886:b003:l012","ordinal":144732,"en":"They levied tribute and took our yearlings."},{"id":"semetey-1-2013:p0886:b003:l013","ordinal":144733,"en":"Unable to bear their exactions,"},{"id":"semetey-1-2013:p0886:b003:l014","ordinal":144734,"en":"The poor people left by your father"},{"id":"semetey-1-2013:p0886:b003:l015","ordinal":144735,"en":"Fled and scattered far and wide."},{"id":"semetey-1-2013:p0886:b003:l016","ordinal":144736,"en":"Oceanlike orphan, hear our words!"},{"id":"semetey-1-2013:p0886:b003:l017","ordinal":144737,"en":"Here is Talas, if you would settle;"},{"id":"semetey-1-2013:p0886:b003:l018","ordinal":144738,"en":"Here are the people your father left!"},{"id":"semetey-1-2013:p0886:b003:l019","ordinal":144739,"en":"Here is blood, if you would kill and spill it;"},{"id":"semetey-1-2013:p0886:b003:l020","ordinal":144740,"en":"If you would make us shriek, my orphan,"},{"id":"semetey-1-2013:p0886:b003:l021","ordinal":144741,"en":"Here are lives, if you would cut them short!”"},{"id":"semetey-1-2013:p0886:b003:l022","ordinal":144742,"en":"So the people spoke."},{"id":"semetey-1-2013:p0886:b003:l023","ordinal":144743,"en":"Your gray-maned Khan Semetey,"},{"id":"semetey-1-2013:p0886:b003:l024","ordinal":144744,"en":"Seeing his people in such a state,"},{"id":"semetey-1-2013:p0886:b003:l025","ordinal":144745,"en":"Was overcome with sorrow,"},{"id":"semetey-1-2013:p0886:b003:l026","ordinal":144746,"en":"And tears poured from his eyes."},{"id":"semetey-1-2013:p0886:b003:l027","ordinal":144747,"en":"Argyn and Kyrgyz together"},{"id":"semetey-1-2013:p0886:b003:l028","ordinal":144748,"en":"Dismounted in great numbers,"},{"id":"semetey-1-2013:p0886:b003:l029","ordinal":144749,"en":"Submitted to Semetey,"},{"id":"semetey-1-2013:p0886:b003:l030","ordinal":144750,"en":"And broke away in tens and fives,"},{"id":"semetey-1-2013:p0886:b003:l031","ordinal":144751,"en":"Taking the orphan son of the mighty destroyer"},{"id":"semetey-1-2013:p0886:b003:l032","ordinal":144752,"en":"As their protector as they went."},{"id":"semetey-1-2013:p0886:b003:l033","ordinal":144753,"en":"Argyn and Kyrgyz broke away"},{"id":"semetey-1-2013:p0886:b003:l034","ordinal":144754,"en":"And gave themselves into his hands."},{"id":"semetey-1-2013:p0886:b003:l035","ordinal":144755,"en":"The orphan, the son of Manas—"},{"id":"semetey-1-2013:p0886:b003:l036","ordinal":144756,"en":"His uprightness became plain."},{"id":"semetey-1-2013:p0886:b003:l037","ordinal":144757,"en":"Semetey came and settled,"},{"id":"semetey-1-2013:p0886:b003:l038","ordinal":144758,"en":"And found a land like Talas."},{"id":"semetey-1-2013:p0886:b003:l039","ordinal":144759,"en":"The bold son of Manas"},{"id":"semetey-1-2013:p0886:b004:l001","ordinal":144760,"en":"Found the Argyn and Kyrgyz as his people."},{"id":"semetey-1-2013:p0886:b004:l002","ordinal":144761,"en":"Then the Kazakh of Sary-Arka,"},{"id":"semetey-1-2013:p0886:b004:l003","ordinal":144762,"en":"His mother's sister's son, Umotoy,"},{"id":"semetey-1-2013:p0886:b004:l004","ordinal":144763,"en":"Fought on without fleeing."},{"id":"semetey-1-2013:p0886:b004:l005","ordinal":144764,"en":"The Zhediger's Urbu—"},{"id":"semetey-1-2013:p0886:b004:l006","ordinal":144765,"en":"To avenge Urbu,"},{"id":"semetey-1-2013:p0886:b004:l007","ordinal":144766,"en":"They charged upon his flank."},{"id":"semetey-1-2013:p0886:b004:l008","ordinal":144767,"en":"The great mass of Zhediger"},{"id":"semetey-1-2013:p0886:b004:l009","ordinal":144768,"en":"Fought on without fleeing."},{"id":"semetey-1-2013:p0886:b004:l010","ordinal":144769,"en":"Of the Kipchaks, Muzburchak—"},{"id":"semetey-1-2013:p0886:b004:l011","ordinal":144770,"en":"Muzburchak's Buyanbek"},{"id":"semetey-1-2013:p0886:b004:l012","ordinal":144771,"en":"Was the one who raised the standard."},{"id":"semetey-1-2013:p0886:b004:l013","ordinal":144772,"en":"“My goshawk father Muzburchak"},{"id":"semetey-1-2013:p0886:b004:l014","ordinal":144773,"en":"Went to Beijing and was slaughtered;"},{"id":"semetey-1-2013:p0886:b004:l015","ordinal":144774,"en":"He died at Manas's hands."},{"id":"semetey-1-2013:p0886:b004:l016","ordinal":144775,"en":"I shall avenge my father,"},{"id":"semetey-1-2013:p0886:b004:l017","ordinal":144776,"en":"And the orphan son of Manas"},{"id":"semetey-1-2013:p0886:b004:l018","ordinal":144777,"en":"I shall offer as a sacrifice,” he said."},{"id":"semetey-1-2013:p0886:b004:l019","ordinal":144778,"en":"The massed Kipchaks hurled themselves forward."},{"id":"semetey-1-2013:p0886:b004:l020","ordinal":144779,"en":"God, do not let us see their faces!"},{"id":"semetey-1-2013:p0886:b004:l021","ordinal":144780,"en":"They attacked upon his flank."},{"id":"semetey-1-2013:p0886:b004:l022","ordinal":144781,"en":"The massed Kipchaks made ready,"},{"id":"semetey-1-2013:p0886:b004:l023","ordinal":144782,"en":"Roaring in their fury,"},{"id":"semetey-1-2013:p0886:b004:l024","ordinal":144783,"en":"Crying “Muzburchak!”"},{"id":"semetey-1-2013:p0886:b004:l025","ordinal":144784,"en":"Now the Kipchak army entered the fight."},{"id":"semetey-1-2013:p0886:b004:l026","ordinal":144785,"en":"They rumbled in anger,"},{"id":"semetey-1-2013:p0886:b004:l027","ordinal":144786,"en":"Thundering out cries of “Bastards!”"},{"id":"semetey-1-2013:p0886:b004:l028","ordinal":144787,"en":"Working themselves into a fury,"},{"id":"semetey-1-2013:p0886:b004:l029","ordinal":144788,"en":"Muttering to themselves,"},{"id":"semetey-1-2013:p0886:b004:l030","ordinal":144789,"en":"Stopping in utter disorder,"},{"id":"semetey-1-2013:p0886:b004:l031","ordinal":144790,"en":"Cursing one another,"},{"id":"semetey-1-2013:p0886:b004:l032","ordinal":144791,"en":"Blustering and rumbling,"},{"id":"semetey-1-2013:p0886:b004:l033","ordinal":144792,"en":"Thumping about in a noisy throng,"},{"id":"semetey-1-2013:p0886:b004:l034","ordinal":144793,"en":"Strutting and putting on airs,"},{"id":"semetey-1-2013:p0886:b004:l035","ordinal":144794,"en":"All of them with their clubs"},{"id":"semetey-1-2013:p0886:b004:l036","ordinal":144795,"en":"Laid across their shoulders,"},{"id":"semetey-1-2013:p0886:b004:l037","ordinal":144796,"en":"Making a spectacle with their noise,"},{"id":"semetey-1-2013:p0886:b004:l038","ordinal":144797,"en":"Talking and cursing men's daughters,"},{"id":"semetey-1-2013:p0886:b004:l039","ordinal":144798,"en":"Their mules braying,"},{"id":"semetey-1-2013:p0887:b003:l001","ordinal":144799,"en":"“Do not flee!” they called to one another,"},{"id":"semetey-1-2013:p0887:b003:l002","ordinal":144800,"en":"Roaring as they lent one another support."},{"id":"semetey-1-2013:p0887:b003:l003","ordinal":144801,"en":"Wrapping their sashes as turbans,"},{"id":"semetey-1-2013:p0887:b003:l004","ordinal":144802,"en":"Beseeching God with cries of “O God!”"},{"id":"semetey-1-2013:p0887:b003:l005","ordinal":144803,"en":"Their turbans puffed up,"},{"id":"semetey-1-2013:p0887:b003:l006","ordinal":144804,"en":"Their beards fluffed out,"},{"id":"semetey-1-2013:p0887:b003:l007","ordinal":144805,"en":"Shouting “Alabek!”"},{"id":"semetey-1-2013:p0887:b003:l008","ordinal":144806,"en":"All raised the battle cry “Möndü!”"},{"id":"semetey-1-2013:p0887:b003:l009","ordinal":144807,"en":"All of them together made ready"},{"id":"semetey-1-2013:p0887:b003:l010","ordinal":144808,"en":"And hurled themselves upon Semetey."},{"id":"semetey-1-2013:p0887:b003:l011","ordinal":144809,"en":"Their madness knew no restraint;"},{"id":"semetey-1-2013:p0887:b003:l012","ordinal":144810,"en":"If Semetey fell into their hands,"},{"id":"semetey-1-2013:p0887:b003:l013","ordinal":144811,"en":"They had no thought of sparing him."},{"id":"semetey-1-2013:p0887:b003:l014","ordinal":144812,"en":"Crying “Ai, ai!” they rushed forward."},{"id":"semetey-1-2013:p0887:b003:l015","ordinal":144813,"en":"An old Sart joined the attack."},{"id":"semetey-1-2013:p0887:b003:l016","ordinal":144814,"en":"When the orphan went to Bukhara,"},{"id":"semetey-1-2013:p0887:b003:l017","ordinal":144815,"en":"Abyke, Kobosh—the six villains—"},{"id":"semetey-1-2013:p0887:b003:l018","ordinal":144816,"en":"To each of all the enemy hosts"},{"id":"semetey-1-2013:p0887:b003:l019","ordinal":144817,"en":"Had given six swift horses"},{"id":"semetey-1-2013:p0887:b003:l020","ordinal":144818,"en":"And a letter the size of a palm."},{"id":"semetey-1-2013:p0887:b003:l021","ordinal":144819,"en":"Taking a net of tempered iron,"},{"id":"semetey-1-2013:p0887:b003:l022","ordinal":144820,"en":"Gathering armies of every kind,"},{"id":"semetey-1-2013:p0887:b003:l023","ordinal":144821,"en":"To seize the orphan"},{"id":"semetey-1-2013:p0887:b003:l024","ordinal":144822,"en":"And offer him as a sacrifice,"},{"id":"semetey-1-2013:p0887:b003:l025","ordinal":144823,"en":"And then, after that,"},{"id":"semetey-1-2013:p0887:b003:l026","ordinal":144824,"en":"To divide the Argyn and Kyrgyz"},{"id":"semetey-1-2013:p0887:b003:l027","ordinal":144825,"en":"By the measure of their whips,"},{"id":"semetey-1-2013:p0887:b003:l028","ordinal":144826,"en":"And to all the armies that came"},{"id":"semetey-1-2013:p0887:b003:l029","ordinal":144827,"en":"Give them as subjects,"},{"id":"semetey-1-2013:p0887:b003:l030","ordinal":144828,"en":"They had made a binding promise,"},{"id":"semetey-1-2013:p0887:b003:l031","ordinal":144829,"en":"Made these words binding,"},{"id":"semetey-1-2013:p0887:b003:l032","ordinal":144830,"en":"Binding, never to be broken."},{"id":"semetey-1-2013:p0887:b003:l033","ordinal":144831,"en":"Gathering the whole army,"},{"id":"semetey-1-2013:p0887:b003:l034","ordinal":144832,"en":"They cut twigs in token of their oath—"},{"id":"semetey-1-2013:p0887:b003:l035","ordinal":144833,"en":"So the six villains had done."},{"id":"semetey-1-2013:p0887:b003:l036","ordinal":144834,"en":"That great promise they had made"},{"id":"semetey-1-2013:p0887:b003:l037","ordinal":144835,"en":"Upon gray-maned Khan Semetey—"},{"id":"semetey-1-2013:p0887:b003:l038","ordinal":144836,"en":"That was why they swept down."},{"id":"semetey-1-2013:p0887:b003:l039","ordinal":144837,"en":"The bold son of Manas"},{"id":"semetey-1-2013:p0887:b004:l001","ordinal":144838,"en":"He remained utterly unconcerned."},{"id":"semetey-1-2013:p0887:b004:l002","ordinal":144839,"en":"Though so many troops swept down,"},{"id":"semetey-1-2013:p0887:b004:l003","ordinal":144840,"en":"He did not consider them worth a thing."},{"id":"semetey-1-2013:p0887:b004:l004","ordinal":144841,"en":"He did not look this way and that,"},{"id":"semetey-1-2013:p0887:b004:l005","ordinal":144842,"en":"Nor reckon that he might die."},{"id":"semetey-1-2013:p0887:b004:l006","ordinal":144843,"en":"Your mighty beast's only son"},{"id":"semetey-1-2013:p0887:b004:l007","ordinal":144844,"en":"He remained utterly unconcerned."},{"id":"semetey-1-2013:p0887:b004:l008","ordinal":144845,"en":"Though the great army rushed upon him,"},{"id":"semetey-1-2013:p0887:b004:l009","ordinal":144846,"en":"Thrusting spears and striking with axes,"},{"id":"semetey-1-2013:p0887:b004:l010","ordinal":144847,"en":"He did not consider them worth a thing."},{"id":"semetey-1-2013:p0887:b004:l011","ordinal":144848,"en":"The son of that surpassing lion"},{"id":"semetey-1-2013:p0887:b004:l012","ordinal":144849,"en":"Felt no dread of death."},{"id":"semetey-1-2013:p0887:b004:l013","ordinal":144850,"en":"All the troops that swept upon him"},{"id":"semetey-1-2013:p0887:b004:l014","ordinal":144851,"en":"He did not deem worth a blue fly."},{"id":"semetey-1-2013:p0887:b004:l015","ordinal":144852,"en":"When the great army swept down,"},{"id":"semetey-1-2013:p0887:b004:l016","ordinal":144853,"en":"When they surrounded him,"},{"id":"semetey-1-2013:p0887:b004:l017","ordinal":144854,"en":"Your orphan, the oceanlike hero's son,"},{"id":"semetey-1-2013:p0887:b004:l018","ordinal":144855,"en":"Did not waver before this enemy."},{"id":"semetey-1-2013:p0887:b004:l019","ordinal":144856,"en":"When they swept upon him from every side,"},{"id":"semetey-1-2013:p0887:b004:l020","ordinal":144857,"en":"Sary Khan, with eyes like bowls,"},{"id":"semetey-1-2013:p0887:b004:l021","ordinal":144858,"en":"Made Tuuchunak rear and bound,"},{"id":"semetey-1-2013:p0887:b004:l022","ordinal":144859,"en":"Shattering whoever he met."},{"id":"semetey-1-2013:p0887:b004:l023","ordinal":144860,"en":"From the flank Kanykei"},{"id":"semetey-1-2013:p0887:b004:l024","ordinal":144861,"en":"Charged and joined the attack,"},{"id":"semetey-1-2013:p0887:b004:l025","ordinal":144862,"en":"Standing against their heroes,"},{"id":"semetey-1-2013:p0887:b004:l026","ordinal":144863,"en":"Fighting with their champions,"},{"id":"semetey-1-2013:p0887:b004:l027","ordinal":144864,"en":"Standing against their swords,"},{"id":"semetey-1-2013:p0887:b004:l028","ordinal":144865,"en":"Fighting with their strongest men."},{"id":"semetey-1-2013:p0887:b004:l029","ordinal":144866,"en":"Girding their waists firmly,"},{"id":"semetey-1-2013:p0887:b004:l030","ordinal":144867,"en":"Kanykei and Sary Khan"},{"id":"semetey-1-2013:p0887:b004:l031","ordinal":144868,"en":"Charged separately through the host."},{"id":"semetey-1-2013:p0887:b004:l032","ordinal":144869,"en":"Those whom Sary Khan speared,"},{"id":"semetey-1-2013:p0887:b004:l033","ordinal":144870,"en":"Kanykei beheaded."},{"id":"semetey-1-2013:p0887:b004:l034","ordinal":144871,"en":"Kanykei rode on, thrusting her spear,"},{"id":"semetey-1-2013:p0887:b004:l035","ordinal":144872,"en":"And Sary Khan rode on, cutting off heads."},{"id":"semetey-1-2013:p0887:b004:l036","ordinal":144873,"en":"Taking no rest by day,"},{"id":"semetey-1-2013:p0887:b004:l037","ordinal":144874,"en":"Taking no sleep at night,"},{"id":"semetey-1-2013:p0887:b004:l038","ordinal":144875,"en":"Standing fast through days and nights,"},{"id":"semetey-1-2013:p0887:b004:l039","ordinal":144876,"en":"They plunged fiercely into battle."},{"id":"semetey-1-2013:p0888:b003:l001","ordinal":144877,"en":"Through the center Kanykei"},{"id":"semetey-1-2013:p0888:b003:l002","ordinal":144878,"en":"Carved a path and drove them onward."},{"id":"semetey-1-2013:p0888:b003:l003","ordinal":144879,"en":"Around the edges Sary Khan"},{"id":"semetey-1-2013:p0888:b003:l004","ordinal":144880,"en":"Slaughtered them and drove them onward."},{"id":"semetey-1-2013:p0888:b003:l005","ordinal":144881,"en":"Their very center Semetey"},{"id":"semetey-1-2013:p0888:b003:l006","ordinal":144882,"en":"Was hemming in as he went."},{"id":"semetey-1-2013:p0888:b003:l007","ordinal":144883,"en":"Along one edge Baitailak"},{"id":"semetey-1-2013:p0888:b003:l008","ordinal":144884,"en":"Was beating his way onward."},{"id":"semetey-1-2013:p0888:b003:l009","ordinal":144885,"en":"Kalyk spread wide on the edge"},{"id":"semetey-1-2013:p0888:b003:l010","ordinal":144886,"en":"Slaughtering them and driving them onward."},{"id":"semetey-1-2013:p0888:b003:l011","ordinal":144887,"en":"Along one flank Shayymbet"},{"id":"semetey-1-2013:p0888:b003:l012","ordinal":144888,"en":"Was sweeping them before him."},{"id":"semetey-1-2013:p0888:b003:l013","ordinal":144889,"en":"Like jackdaws struck by a falcon,"},{"id":"semetey-1-2013:p0888:b003:l014","ordinal":144890,"en":"They drove and swept them onward."},{"id":"semetey-1-2013:p0888:b003:l015","ordinal":144891,"en":"They chased them like partridges,"},{"id":"semetey-1-2013:p0888:b003:l016","ordinal":144892,"en":"Tormenting and destroying the people."},{"id":"semetey-1-2013:p0888:b003:l017","ordinal":144893,"en":"How shall we see those people again?"},{"id":"semetey-1-2013:p0888:b003:l018","ordinal":144894,"en":"Many people were slaughtered."},{"id":"semetey-1-2013:p0888:b003:l019","ordinal":144895,"en":"Because of Abyke,"},{"id":"semetey-1-2013:p0888:b003:l020","ordinal":144896,"en":"Because of Kobosh's manifold wickedness,"}]
