[{"id":"manas-2010:p1496:b001:l010","ordinal":64513,"en":"Tossing them like fur caps."},{"id":"manas-2010:p1496:b001:l011","ordinal":64514,"en":"Like jackdaws struck by a saker falcon,"},{"id":"manas-2010:p1496:b001:l012","ordinal":64515,"en":"He scattered and drove them."},{"id":"manas-2010:p1496:b001:l013","ordinal":64516,"en":"Like small birds struck by a hobby,"},{"id":"manas-2010:p1496:b001:l014","ordinal":64517,"en":"He slaughtered the Chinese multitude."},{"id":"manas-2010:p1496:b001:l015","ordinal":64518,"en":"The giant governor and Kongurbay"},{"id":"manas-2010:p1496:b001:l016","ordinal":64519,"en":"Now saw this battle."},{"id":"manas-2010:p1496:b001:l017","ordinal":64520,"en":"From the pale, mottled sandy plain,"},{"id":"manas-2010:p1496:b001:l018","ordinal":64521,"en":"Kongurbay came thundering;"},{"id":"manas-2010:p1496:b001:l019","ordinal":64522,"en":"Those who saw him shuddered."},{"id":"manas-2010:p1496:b001:l020","ordinal":64523,"en":"That fellow skilled among spearmen,"},{"id":"manas-2010:p1496:b001:l021","ordinal":64524,"en":"That capable fellow versed in enemy tricks,"},{"id":"manas-2010:p1496:b001:l022","ordinal":64525,"en":"Reached brave Chubak now."},{"id":"manas-2010:p1496:b001:l023","ordinal":64526,"en":"Chubak upon Kögala,"},{"id":"manas-2010:p1496:b001:l024","ordinal":64527,"en":"Unprepared, from the flank,"},{"id":"manas-2010:p1496:b001:l025","ordinal":64528,"en":"He struck once with his lance,"},{"id":"manas-2010:p1496:b001:l026","ordinal":64529,"en":"Drove a mighty blow and passed."},{"id":"manas-2010:p1496:b001:l027","ordinal":64530,"en":"The hero left his saddle,"},{"id":"manas-2010:p1496:b001:l028","ordinal":64531,"en":"His foot left the stirrup."},{"id":"manas-2010:p1496:b001:l029","ordinal":64532,"en":"Kögala's sacred mane"},{"id":"manas-2010:p1496:b001:l030","ordinal":64533,"en":"He could not seize in his hand;"},{"id":"manas-2010:p1496:b001:l031","ordinal":64534,"en":"Against the gold-treaded stirrup"},{"id":"manas-2010:p1496:b001:l032","ordinal":64535,"en":"He could not brace his foot."},{"id":"manas-2010:p1496:b001:l033","ordinal":64536,"en":"His two legs spread wide;"},{"id":"manas-2010:p1496:b001:l034","ordinal":64537,"en":"While Chubak swayed in a daze,"},{"id":"manas-2010:p1496:b001:l035","ordinal":64538,"en":"The capable, mighty giant governor"},{"id":"manas-2010:p1496:b001:l036","ordinal":64539,"en":"Began to charge Chubak."},{"id":"manas-2010:p1496:b001:l037","ordinal":64540,"en":"“From Kögala's back"},{"id":"manas-2010:p1496:b001:l038","ordinal":64541,"en":"I shall drive him down with a thrust!”"},{"id":"manas-2010:p1496:b001:l039","ordinal":64542,"en":"He came racing,"},{"id":"manas-2010:p1496:b001:l040","ordinal":64543,"en":"His hems and sleeves rattling;"},{"id":"manas-2010:p1496:b001:l041","ordinal":64544,"en":"The flame coming from his mouth"},{"id":"manas-2010:p1496:b001:l042","ordinal":64545,"en":"Burned and hissed like fire,"},{"id":"manas-2010:p1497:b001:l001","ordinal":64546,"en":"His broad, door-sized teeth,"},{"id":"manas-2010:p1497:b001:l002","ordinal":64547,"en":"When the governor clenched them,"},{"id":"manas-2010:p1497:b001:l003","ordinal":64548,"en":"Crumbled like millet."},{"id":"manas-2010:p1497:b001:l004","ordinal":64549,"en":"Holding his lance steady,"},{"id":"manas-2010:p1497:b001:l005","ordinal":64550,"en":"He came crying, “Come, come!”"},{"id":"manas-2010:p1497:b001:l006","ordinal":64551,"en":"His battle-cry of “Come!”"},{"id":"manas-2010:p1497:b001:l007","ordinal":64552,"en":"Came eating at ears and noses."},{"id":"manas-2010:p1497:b001:l008","ordinal":64553,"en":"Ulak Khan's Syrgak thought,"},{"id":"manas-2010:p1497:b001:l009","ordinal":64554,"en":"“The God who strikes will strike us!"},{"id":"manas-2010:p1497:b001:l010","ordinal":64555,"en":"When this governor arrives,"},{"id":"manas-2010:p1497:b001:l011","ordinal":64556,"en":"He will thrust Chubak down,"},{"id":"manas-2010:p1497:b001:l012","ordinal":64557,"en":"Quenching him like a fire."},{"id":"manas-2010:p1497:b001:l013","ordinal":64558,"en":"While I remain alive and breathing,"},{"id":"manas-2010:p1497:b001:l014","ordinal":64559,"en":"What aim could I achieve?"},{"id":"manas-2010:p1497:b001:l015","ordinal":64560,"en":"From that wretch the governor, Chubak"},{"id":"manas-2010:p1497:b001:l016","ordinal":64561,"en":"Let me rescue!”"},{"id":"manas-2010:p1497:b001:l017","ordinal":64562,"en":"Thus brave Syrgak spoke."},{"id":"manas-2010:p1497:b001:l018","ordinal":64563,"en":"Kökchebich beneath him"},{"id":"manas-2010:p1497:b001:l019","ordinal":64564,"en":"He whipped from side to side."},{"id":"manas-2010:p1497:b001:l020","ordinal":64565,"en":"“Let me arrive before the governor!”"},{"id":"manas-2010:p1497:b001:l021","ordinal":64566,"en":"His dark eyes from their sockets"},{"id":"manas-2010:p1497:b001:l022","ordinal":64567,"en":"Jutted out and flashed."},{"id":"manas-2010:p1497:b001:l023","ordinal":64568,"en":"Kökchebich beneath him"},{"id":"manas-2010:p1497:b001:l024","ordinal":64569,"en":"Lowered his head toward the ground."},{"id":"manas-2010:p1497:b001:l025","ordinal":64570,"en":"If you looked at his speed,"},{"id":"manas-2010:p1497:b001:l026","ordinal":64571,"en":"Three times more than before"},{"id":"manas-2010:p1497:b001:l027","ordinal":64572,"en":"His flesh had warmed to the race."},{"id":"manas-2010:p1497:b001:l028","ordinal":64573,"en":"Before one could say this or that,"},{"id":"manas-2010:p1497:b001:l029","ordinal":64574,"en":"In the opening and closing of an eye,"},{"id":"manas-2010:p1497:b001:l030","ordinal":64575,"en":"The wrestler called Governor,"},{"id":"manas-2010:p1497:b001:l031","ordinal":64576,"en":"Syrgak reached in his charge."},{"id":"manas-2010:p1497:b001:l032","ordinal":64577,"en":"As soon as he reached the governor,"},{"id":"manas-2010:p1497:b001:l033","ordinal":64578,"en":"From the gray mule's back"},{"id":"manas-2010:p1497:b001:l034","ordinal":64579,"en":"He drove him down with a thrust."},{"id":"manas-2010:p1497:b001:l035","ordinal":64580,"en":"Thundering like a mighty mountain,"},{"id":"manas-2010:p1497:b001:l036","ordinal":64581,"en":"The giant governor fell from his mount."},{"id":"manas-2010:p1497:b001:l037","ordinal":64582,"en":"Before a Dagger-Hand, prepared,"},{"id":"manas-2010:p1497:b001:l038","ordinal":64583,"en":"A champion on foot, could arrive,"},{"id":"manas-2010:p1497:b001:l039","ordinal":64584,"en":"Buudayyk Khan's Muzburchak,"},{"id":"manas-2010:p1497:b001:l040","ordinal":64585,"en":"That precious hero who never turned aside,"},{"id":"manas-2010:p1497:b001:l041","ordinal":64586,"en":"The champion, the giant governor,"},{"id":"manas-2010:p1497:b001:l042","ordinal":64587,"en":"He passed and cut his head off."},{"id":"manas-2010:p1498:b001:l001","ordinal":64588,"en":"Cotton sash and broad boots,"},{"id":"manas-2010:p1498:b001:l002","ordinal":64589,"en":"Kongurbay, khan of the shaven priests,"},{"id":"manas-2010:p1498:b001:l003","ordinal":64590,"en":"Amid thick battle and great dust,"},{"id":"manas-2010:p1498:b001:l004","ordinal":64591,"en":"Muzburchak, Kökchö and Bokmurun:"},{"id":"manas-2010:p1498:b001:l005","ordinal":64592,"en":"He reached these three now."},{"id":"manas-2010:p1498:b001:l006","ordinal":64593,"en":"Reaching them, he smashed them all alike,"},{"id":"manas-2010:p1498:b001:l007","ordinal":64594,"en":"Thrust them down and passed."},{"id":"manas-2010:p1498:b001:l008","ordinal":64595,"en":"Before the Fierce One could recover,"},{"id":"manas-2010:p1498:b001:l009","ordinal":64596,"en":"Golden forelock and fiery sash,"},{"id":"manas-2010:p1498:b001:l010","ordinal":64597,"en":"Azizkhan's Almambet"},{"id":"manas-2010:p1498:b001:l011","ordinal":64598,"en":"Arrived like a bullet."},{"id":"manas-2010:p1498:b001:l012","ordinal":64599,"en":"As soon as he reached the Fierce One,"},{"id":"manas-2010:p1498:b001:l013","ordinal":64600,"en":"From Algara's back"},{"id":"manas-2010:p1498:b001:l014","ordinal":64601,"en":"He thrust him down and passed."},{"id":"manas-2010:p1498:b001:l015","ordinal":64602,"en":"Kongurbay fell from his horse,"},{"id":"manas-2010:p1498:b001:l016","ordinal":64603,"en":"His spectacles gleaming,"},{"id":"manas-2010:p1498:b001:l017","ordinal":64604,"en":"The flask-sized bead-stone"},{"id":"manas-2010:p1498:b001:l018","ordinal":64605,"en":"Flashing upon his head."},{"id":"manas-2010:p1498:b001:l019","ordinal":64606,"en":"Many thoughts filled his heart:"},{"id":"manas-2010:p1498:b001:l020","ordinal":64607,"en":"“If God would grant me this one!”"},{"id":"manas-2010:p1498:b001:l021","ordinal":64608,"en":"The fierce-maned Chubak's"},{"id":"manas-2010:p1498:b001:l022","ordinal":64609,"en":"Tears flowed in ten streams."},{"id":"manas-2010:p1498:b001:l023","ordinal":64610,"en":"“As soon as I reach the Fierce One,"},{"id":"manas-2010:p1498:b001:l024","ordinal":64611,"en":"Let me cut his head off!"},{"id":"manas-2010:p1498:b001:l025","ordinal":64612,"en":"The dark blood from within him,"},{"id":"manas-2010:p1498:b001:l026","ordinal":64613,"en":"Let me scoop and swallow in handfuls!”"},{"id":"manas-2010:p1498:b001:l027","ordinal":64614,"en":"Your Chubak came charging."},{"id":"manas-2010:p1498:b001:l028","ordinal":64615,"en":"Before letting Khan Chubak reach him,"},{"id":"manas-2010:p1498:b001:l029","ordinal":64616,"en":"A thousand Dagger-Hand champions,"},{"id":"manas-2010:p1498:b001:l030","ordinal":64617,"en":"Who had him in their sights,"},{"id":"manas-2010:p1498:b001:l031","ordinal":64618,"en":"All thousand arrived together."},{"id":"manas-2010:p1498:b001:l032","ordinal":64619,"en":"As soon as they reached the Fierce One,"},{"id":"manas-2010:p1498:b001:l033","ordinal":64620,"en":"They mounted him upon Algara"},{"id":"manas-2010:p1498:b001:l034","ordinal":64621,"en":"And carried him away."},{"id":"manas-2010:p1498:b001:l035","ordinal":64622,"en":"Buudayyk Khan's Muzburchak,"},{"id":"manas-2010:p1498:b001:l036","ordinal":64623,"en":"As they were about to seize him alive,"},{"id":"manas-2010:p1498:b001:l037","ordinal":64624,"en":"The Chinese multitude gathered,"},{"id":"manas-2010:p1498:b001:l038","ordinal":64625,"en":"About to put him in their cage."},{"id":"manas-2010:p1498:b001:l039","ordinal":64626,"en":"Ulak Khan's Syrgak,"},{"id":"manas-2010:p1498:b001:l040","ordinal":64627,"en":"In such a hard battle,"},{"id":"manas-2010:p1498:b001:l041","ordinal":64628,"en":"The darling who would not turn back,"},{"id":"manas-2010:p1498:b001:l042","ordinal":64629,"en":"Struck Kökchebich with his whip."},{"id":"manas-2010:p1499:b001:l001","ordinal":64630,"en":"He arrived faster than an arrow."},{"id":"manas-2010:p1499:b001:l002","ordinal":64631,"en":"Seven thousand Shibee, a thousand governors:"},{"id":"manas-2010:p1499:b001:l003","ordinal":64632,"en":"Alone he entered among them."},{"id":"manas-2010:p1499:b001:l004","ordinal":64633,"en":"The governors across his path"},{"id":"manas-2010:p1499:b001:l005","ordinal":64634,"en":"He swept down with straight thrusts."},{"id":"manas-2010:p1499:b001:l006","ordinal":64635,"en":"The governors surrounding him"},{"id":"manas-2010:p1499:b001:l007","ordinal":64636,"en":"He drove back with a shout,"},{"id":"manas-2010:p1499:b001:l008","ordinal":64637,"en":"And reached Muzburchak."},{"id":"manas-2010:p1499:b001:l009","ordinal":64638,"en":"Upon arriving, your Syrgak"},{"id":"manas-2010:p1499:b001:l010","ordinal":64639,"en":"Grasped him once by the right shoulder,"},{"id":"manas-2010:p1499:b001:l011","ordinal":64640,"en":"Set him upon his right knee."},{"id":"manas-2010:p1499:b001:l012","ordinal":64641,"en":"That extraordinary, precious lion Syrgak,"},{"id":"manas-2010:p1499:b001:l013","ordinal":64642,"en":"Showing his lion's nature,"},{"id":"manas-2010:p1499:b001:l014","ordinal":64643,"en":"Carried Muzburchak away"},{"id":"manas-2010:p1499:b001:l015","ordinal":64644,"en":"And mounted him upon Telkyzyl."},{"id":"manas-2010:p1499:b001:l016","ordinal":64645,"en":"At that time, Muzburchak,"},{"id":"manas-2010:p1499:b001:l017","ordinal":64646,"en":"When he had fallen from his horse,"},{"id":"manas-2010:p1499:b001:l018","ordinal":64647,"en":"When they had surrounded him,"},{"id":"manas-2010:p1499:b001:l019","ordinal":64648,"en":"His head had become a bucket of blood."},{"id":"manas-2010:p1499:b001:l020","ordinal":64649,"en":"His entire body"},{"id":"manas-2010:p1499:b001:l021","ordinal":64650,"en":"Was numb and unable to move."},{"id":"manas-2010:p1499:b001:l022","ordinal":64651,"en":"With difficulty, mounting him,"},{"id":"manas-2010:p1499:b001:l023","ordinal":64652,"en":"Leading him along this way,"},{"id":"manas-2010:p1499:b001:l024","ordinal":64653,"en":"When brave Syrgak brought him out,"},{"id":"manas-2010:p1499:b001:l025","ordinal":64654,"en":"The Chinese in their joy"},{"id":"manas-2010:p1499:b001:l026","ordinal":64655,"en":"Had seen their lucky day dawn."},{"id":"manas-2010:p1499:b001:l027","ordinal":64656,"en":"Aydarkhan's Kökchö,"},{"id":"manas-2010:p1499:b001:l028","ordinal":64657,"en":"When he had fallen from his horse,"},{"id":"manas-2010:p1499:b001:l029","ordinal":64658,"en":"They put camel-hide headgear upon his head,"},{"id":"manas-2010:p1499:b001:l030","ordinal":64659,"en":"Mounted him backward upon a horse,"},{"id":"manas-2010:p1499:b001:l031","ordinal":64660,"en":"Before Karykan"},{"id":"manas-2010:p1499:b001:l032","ordinal":64661,"en":"To take him as a gift,"},{"id":"manas-2010:p1499:b001:l033","ordinal":64662,"en":"They bound him alive."},{"id":"manas-2010:p1499:b001:l034","ordinal":64663,"en":"Seeing this, brave Syrgak"},{"id":"manas-2010:p1499:b001:l035","ordinal":64664,"en":"Shouted, “The faith of Islam!”"},{"id":"manas-2010:p1499:b001:l036","ordinal":64665,"en":"Raised the battle-cry, “Manas!”"},{"id":"manas-2010:p1499:b001:l037","ordinal":64666,"en":"Upon the massed Chinese army"},{"id":"manas-2010:p1499:b001:l038","ordinal":64667,"en":"He charged, laying them low."},{"id":"manas-2010:p1499:b001:l039","ordinal":64668,"en":"Through their middle, brave Syrgak"},{"id":"manas-2010:p1499:b001:l040","ordinal":64669,"en":"Mowed and drove his way in;"},{"id":"manas-2010:p1499:b001:l041","ordinal":64670,"en":"Along their edges, brave Shuutu"},{"id":"manas-2010:p1499:b001:l042","ordinal":64671,"en":"Came slaughtering in support."},{"id":"manas-2010:p1500:b001:l001","ordinal":64672,"en":"On one flank, old Kyrgyl"},{"id":"manas-2010:p1500:b001:l002","ordinal":64673,"en":"Came tearing his way in."},{"id":"manas-2010:p1500:b001:l003","ordinal":64674,"en":"Baychoro and Agayar,"},{"id":"manas-2010:p1500:b001:l004","ordinal":64675,"en":"Making a waste of the Chinese,"},{"id":"manas-2010:p1500:b001:l005","ordinal":64676,"en":"Drove their way in."},{"id":"manas-2010:p1500:b001:l006","ordinal":64677,"en":"Girding themselves to risk all,"},{"id":"manas-2010:p1500:b001:l007","ordinal":64678,"en":"The Chinese moving in bands,"},{"id":"manas-2010:p1500:b001:l008","ordinal":64679,"en":"They broke and scattered their bands."},{"id":"manas-2010:p1500:b001:l009","ordinal":64680,"en":"Mountain-sized Kökchö's"},{"id":"manas-2010:p1500:b001:l010","ordinal":64681,"en":"Hands they untied."},{"id":"manas-2010:p1500:b001:l011","ordinal":64682,"en":"Rescuing Kökchö,"},{"id":"manas-2010:p1500:b001:l012","ordinal":64683,"en":"Brave Syrgak brought him out."},{"id":"manas-2010:p1500:b001:l013","ordinal":64684,"en":"Rekindling his extinguished fire,"},{"id":"manas-2010:p1500:b001:l014","ordinal":64685,"en":"Kökchö of the Kazakhs,"},{"id":"manas-2010:p1500:b001:l015","ordinal":64686,"en":"Reviving his deadened life,"},{"id":"manas-2010:p1500:b001:l016","ordinal":64687,"en":"Safe and sound, to his horse"},{"id":"manas-2010:p1500:b001:l017","ordinal":64688,"en":"He brought and mounted him."},{"id":"manas-2010:p1500:b001:l018","ordinal":64689,"en":"The massed Muslims,"},{"id":"manas-2010:p1500:b001:l019","ordinal":64690,"en":"Seeing Syrgak's valor,"},{"id":"manas-2010:p1500:b001:l020","ordinal":64691,"en":"All burst into tears together."},{"id":"manas-2010:p1500:b001:l021","ordinal":64692,"en":"Grateful, they spread their hands"},{"id":"manas-2010:p1500:b001:l022","ordinal":64693,"en":"And loudly gave their blessing."},{"id":"manas-2010:p1500:b001:l023","ordinal":64694,"en":"Kökötöy's Bokmurun,"},{"id":"manas-2010:p1500:b001:l024","ordinal":64695,"en":"When the fierce-maned Fierce One reached him,"},{"id":"manas-2010:p1500:b001:l025","ordinal":64696,"en":"When he fell from his horse,"},{"id":"manas-2010:p1500:b001:l026","ordinal":64697,"en":"All the Chinese thronged,"},{"id":"manas-2010:p1500:b001:l027","ordinal":64698,"en":"All their swordsmen"},{"id":"manas-2010:p1500:b001:l028","ordinal":64699,"en":"Swept upon him in a mass."},{"id":"manas-2010:p1500:b001:l029","ordinal":64700,"en":"Falling while he fought,"},{"id":"manas-2010:p1500:b001:l030","ordinal":64701,"en":"His wing bent back,"},{"id":"manas-2010:p1500:b001:l031","ordinal":64702,"en":"Parted from Maaniker,"},{"id":"manas-2010:p1500:b001:l032","ordinal":64703,"en":"The Chinese swarming upon him,"},{"id":"manas-2010:p1500:b001:l033","ordinal":64704,"en":"Despairing of his life,"},{"id":"manas-2010:p1500:b001:l034","ordinal":64705,"en":"Kökötöy's Bokmurun"},{"id":"manas-2010:p1500:b001:l035","ordinal":64706,"en":"Stood weeping with ringing sobs."},{"id":"manas-2010:p1500:b001:l036","ordinal":64707,"en":"“If I would walk, I have no feet;"},{"id":"manas-2010:p1500:b001:l037","ordinal":64708,"en":"I am like a snake."},{"id":"manas-2010:p1500:b001:l038","ordinal":64709,"en":"I have no tail to wag in fawning;"},{"id":"manas-2010:p1500:b001:l039","ordinal":64710,"en":"I am like a wild ass!"},{"id":"manas-2010:p1500:b001:l040","ordinal":64711,"en":"I knew orphanhood at the beginning;"},{"id":"manas-2010:p1500:b001:l041","ordinal":64712,"en":"I lost my dear father"},{"id":"manas-2010:p1500:b001:l042","ordinal":64713,"en":"When I was twelve years old."},{"id":"manas-2010:p1501:b001:l001","ordinal":64714,"en":"When I travelled far upon a journey,"},{"id":"manas-2010:p1501:b001:l002","ordinal":64715,"en":"I would shoot wild sheep for food,"},{"id":"manas-2010:p1501:b001:l003","ordinal":64716,"en":"And of the one I held in place of a father,"},{"id":"manas-2010:p1501:b001:l004","ordinal":64717,"en":"The generous leopard Manas,"},{"id":"manas-2010:p1501:b001:l005","ordinal":64718,"en":"I would say, ‘May he live in safety.’"},{"id":"manas-2010:p1501:b001:l006","ordinal":64719,"en":"My champion Manas, do not leave me!"},{"id":"manas-2010:p1501:b001:l007","ordinal":64720,"en":"Do not bring me to a hapless day,"},{"id":"manas-2010:p1501:b001:l008","ordinal":64721,"en":"Do not leave me plunged in misery!"},{"id":"manas-2010:p1501:b001:l009","ordinal":64722,"en":"The countless Chinese will swarm upon me,"},{"id":"manas-2010:p1501:b001:l010","ordinal":64723,"en":"Seize me and slaughter me,"},{"id":"manas-2010:p1501:b001:l011","ordinal":64724,"en":"Alas for this only child, this wretched head!"},{"id":"manas-2010:p1501:b001:l012","ordinal":64725,"en":"If my bones lie unburied,"},{"id":"manas-2010:p1501:b001:l013","ordinal":64726,"en":"Vultures will shit upon them!"},{"id":"manas-2010:p1501:b001:l014","ordinal":64727,"en":"They will surround me,"},{"id":"manas-2010:p1501:b001:l015","ordinal":64728,"en":"Alas for my precious life!"},{"id":"manas-2010:p1501:b001:l016","ordinal":64729,"en":"They will plunge a dagger in my heart;"},{"id":"manas-2010:p1501:b001:l017","ordinal":64730,"en":"The vengeful Chinese and Manchus"},{"id":"manas-2010:p1501:b001:l018","ordinal":64731,"en":"Will take their vengeance upon me!"},{"id":"manas-2010:p1501:b001:l019","ordinal":64732,"en":"If only he would turn Akkula’s head,"},{"id":"manas-2010:p1501:b001:l020","ordinal":64733,"en":"If, when the Chinese pressed upon me,"},{"id":"manas-2010:p1501:b001:l021","ordinal":64734,"en":"Manas would stand and watch!"},{"id":"manas-2010:p1501:b001:l022","ordinal":64735,"en":"Then let this only child die,"},{"id":"manas-2010:p1501:b001:l023","ordinal":64736,"en":"And let Manas see it then!"},{"id":"manas-2010:p1501:b001:l024","ordinal":64737,"en":"If only they would dig my dark grave wide,"},{"id":"manas-2010:p1501:b001:l025","ordinal":64738,"en":"And the great host of Muslims"},{"id":"manas-2010:p1501:b001:l026","ordinal":64739,"en":"Would bury my dead body!"},{"id":"manas-2010:p1501:b001:l027","ordinal":64740,"en":"If only he would turn Sarala’s head,"},{"id":"manas-2010:p1501:b001:l028","ordinal":64741,"en":"Golden-crested, with a belt like embers,"},{"id":"manas-2010:p1501:b001:l029","ordinal":64742,"en":"And, while this lone soul stood thus,"},{"id":"manas-2010:p1501:b001:l030","ordinal":64743,"en":"Almambet would stand and watch!”"},{"id":"manas-2010:p1501:b001:l031","ordinal":64744,"en":"Before he had finished speaking,"},{"id":"manas-2010:p1501:b001:l032","ordinal":64745,"en":"Azizkhan’s Almambet"},{"id":"manas-2010:p1501:b001:l033","ordinal":64746,"en":"Came galloping from the foothills,"},{"id":"manas-2010:p1501:b001:l034","ordinal":64747,"en":"The Chinese who came before him"},{"id":"manas-2010:p1501:b001:l035","ordinal":64748,"en":"He slew and slaughtered and destroyed;"},{"id":"manas-2010:p1501:b001:l036","ordinal":64749,"en":"And on the nearer side of him,"},{"id":"manas-2010:p1501:b001:l037","ordinal":64750,"en":"Ulak Khan’s Syrgak"},{"id":"manas-2010:p1501:b001:l038","ordinal":64751,"en":"Had come close now,"},{"id":"manas-2010:p1501:b001:l039","ordinal":64752,"en":"Right beside Bokmurun."},{"id":"manas-2010:p1501:b001:l040","ordinal":64753,"en":"Ulak Khan’s Syrgak"},{"id":"manas-2010:p1501:b001:l041","ordinal":64754,"en":"Speared them wherever he reached,"},{"id":"manas-2010:p1501:b001:l042","ordinal":64755,"en":"Cutting seven thousand to pieces,"},{"id":"manas-2010:p1502:b001:l001","ordinal":64756,"en":"“Where is Kokotoy’s only son,"},{"id":"manas-2010:p1502:b001:l002","ordinal":64757,"en":"The warrior Bokmurun?” he cried."},{"id":"manas-2010:p1502:b001:l003","ordinal":64758,"en":"While Syrgak was doing this,"},{"id":"manas-2010:p1502:b001:l004","ordinal":64759,"en":"Your leopard Alma arrived;"},{"id":"manas-2010:p1502:b001:l005","ordinal":64760,"en":"He swept him up from the dark earth,"},{"id":"manas-2010:p1502:b001:l006","ordinal":64761,"en":"Like a sparrowhawk taking a little bird,"},{"id":"manas-2010:p1502:b001:l007","ordinal":64762,"en":"He snatched him up and carried him away."},{"id":"manas-2010:p1502:b001:l008","ordinal":64763,"en":"Showing himself a lion,"},{"id":"manas-2010:p1502:b001:l009","ordinal":64764,"en":"He bore the champion swiftly off"},{"id":"manas-2010:p1502:b001:l010","ordinal":64765,"en":"And mounted him on Maaniker."},{"id":"manas-2010:p1502:b001:l011","ordinal":64766,"en":"Before they could set themselves to rights,"},{"id":"manas-2010:p1502:b001:l012","ordinal":64767,"en":"See the reeds, see the flood,"},{"id":"manas-2010:p1502:b001:l013","ordinal":64768,"en":"See the people surging over them!"}]
