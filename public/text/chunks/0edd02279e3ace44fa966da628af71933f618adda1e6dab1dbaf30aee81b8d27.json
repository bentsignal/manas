[{"id":"seytek-2012:p0527:b002:l002","ordinal":336129,"en":"Shall I settle hidden away,"},{"id":"seytek-2012:p0527:b002:l003","ordinal":336130,"en":"And rather than go on living thus,"},{"id":"seytek-2012:p0527:b002:l004","ordinal":336131,"en":"Become prey for the blue vulture?"},{"id":"seytek-2012:p0527:b002:l005","ordinal":336132,"en":"Without coming to my uncle’s aid,"},{"id":"seytek-2012:p0527:b002:l006","ordinal":336133,"en":"Shall I turn my tulpar’s head away"},{"id":"seytek-2012:p0527:b002:l007","ordinal":336134,"en":"And stand there drooping,"},{"id":"seytek-2012:p0527:b002:l008","ordinal":336135,"en":"Like a man struck by palsy?"},{"id":"seytek-2012:p0527:b002:l009","ordinal":336136,"en":"This raging Sarybay—"},{"id":"seytek-2012:p0527:b002:l010","ordinal":336137,"en":"I shall reach him from the flank."},{"id":"seytek-2012:p0527:b002:l011","ordinal":336138,"en":"My dear uncle,"},{"id":"seytek-2012:p0527:b002:l012","ordinal":336139,"en":"Let me become your support!”"},{"id":"seytek-2012:p0527:b002:l013","ordinal":336140,"en":"He lashed Telkyzyl,"},{"id":"seytek-2012:p0527:b002:l014","ordinal":336141,"en":"And if you ask about the state of that sea-like hero,"},{"id":"seytek-2012:p0527:b002:l015","ordinal":336142,"en":"Tears streamed from his two eyes"},{"id":"seytek-2012:p0527:b002:l016","ordinal":336143,"en":"And dripped upon his chest."},{"id":"seytek-2012:p0527:b002:l017","ordinal":336144,"en":"His waist arched firmly backward,"},{"id":"seytek-2012:p0527:b002:l018","ordinal":336145,"en":"And his boiling eyes bulged."},{"id":"seytek-2012:p0527:b002:l019","ordinal":336146,"en":"Your ready-born falcon"},{"id":"seytek-2012:p0527:b002:l020","ordinal":336147,"en":"Whipped Telkyzyl,"},{"id":"seytek-2012:p0527:b002:l021","ordinal":336148,"en":"And where the mountain vanished at the pass,"},{"id":"seytek-2012:p0527:b002:l022","ordinal":336149,"en":"He wheeled Telkyzyl’s head."},{"id":"seytek-2012:p0527:b002:l023","ordinal":336150,"en":"The sharp steel spear—"},{"id":"seytek-2012:p0527:b002:l024","ordinal":336151,"en":"Then the hero Seytek"},{"id":"seytek-2012:p0527:b002:l025","ordinal":336152,"en":"Gripped it crosswise in his hand"},{"id":"seytek-2012:p0527:b002:l026","ordinal":336153,"en":"And came on, making the earth tremble."},{"id":"seytek-2012:p0527:b002:l027","ordinal":336154,"en":"When he reached the warrior,"},{"id":"seytek-2012:p0527:b002:l028","ordinal":336155,"en":"The infidel hero Sarybay,"},{"id":"seytek-2012:p0527:b002:l029","ordinal":336156,"en":"He marked the face of the right kidney,"},{"id":"seytek-2012:p0527:b002:l030","ordinal":336157,"en":"The place beside the backbone,"},{"id":"seytek-2012:p0527:b002:l031","ordinal":336158,"en":"Thinking, “Here is the surest place to kill,”"},{"id":"seytek-2012:p0527:b002:l032","ordinal":336159,"en":"And reached the dreadful, venomous infidel,"},{"id":"seytek-2012:p0527:b002:l033","ordinal":336160,"en":"The warrior Sarybay,"},{"id":"seytek-2012:p0527:b002:l034","ordinal":336161,"en":"From the flank."},{"id":"seytek-2012:p0527:b002:l035","ordinal":336162,"en":"He thrust hard into his kidney as he passed."},{"id":"seytek-2012:p0527:b002:l036","ordinal":336163,"en":"But when his spear struck,"},{"id":"seytek-2012:p0527:b002:l037","ordinal":336164,"en":"The infidel son of the Monster"},{"id":"seytek-2012:p0527:b002:l038","ordinal":336165,"en":"Proved surpassingly cunning."},{"id":"seytek-2012:p0527:b002:l039","ordinal":336166,"en":"Fixing his eye firmly upon the mortal spot,"},{"id":"seytek-2012:p0527:b002:l040","ordinal":336167,"en":"Seytek unleashed his fiercest fury."},{"id":"seytek-2012:p0527:b003:l001","ordinal":336168,"en":"“He has a powerful arm and deadly venom;"},{"id":"seytek-2012:p0527:b003:l002","ordinal":336169,"en":"He may suddenly thrust straight through."},{"id":"seytek-2012:p0527:b003:l003","ordinal":336170,"en":"It would be shameful if I gave no aid."},{"id":"seytek-2012:p0527:b003:l004","ordinal":336171,"en":"If my uncle Külchoro closes his eyes,"},{"id":"seytek-2012:p0527:b003:l005","ordinal":336172,"en":"We shall retreat along the valley."},{"id":"seytek-2012:p0527:b003:l006","ordinal":336173,"en":"We shall become a feast for foreign foes,"},{"id":"seytek-2012:p0527:b003:l007","ordinal":336174,"en":"Then be driven about like sheep"},{"id":"seytek-2012:p0527:b003:l008","ordinal":336175,"en":"And become the enemy’s banquet."},{"id":"seytek-2012:p0527:b003:l009","ordinal":336176,"en":"If my dear uncle perishes,"},{"id":"seytek-2012:p0527:b003:l010","ordinal":336177,"en":"Who will brandish the black-edged battle-axe"},{"id":"seytek-2012:p0527:b003:l011","ordinal":336178,"en":"And wield it without faltering?"},{"id":"seytek-2012:p0527:b003:l012","ordinal":336179,"en":"Who will lead the many Kyrgyz and Argyn"},{"id":"seytek-2012:p0527:b003:l013","ordinal":336180,"en":"Without plunging them into grief?"},{"id":"seytek-2012:p0527:b003:l014","ordinal":336181,"en":"Who will whirl the hawthorn-handled battle-axe"},{"id":"seytek-2012:p0527:b003:l015","ordinal":336182,"en":"And swing it straight and true?"},{"id":"seytek-2012:p0527:b003:l016","ordinal":336183,"en":"Who will lead the teeming Kyrgyz and Nogoy"},{"id":"seytek-2012:p0527:b003:l017","ordinal":336184,"en":"Without casting them into turmoil?"},{"id":"seytek-2012:p0527:b003:l018","ordinal":336185,"en":"If we lose my lion uncle Kül,"},{"id":"seytek-2012:p0527:b003:l019","ordinal":336186,"en":"We shall retreat along the valley"},{"id":"seytek-2012:p0527:b003:l020","ordinal":336187,"en":"And be like a fire gone out."},{"id":"seytek-2012:p0527:b003:l021","ordinal":336188,"en":"We shall settle along the hillsides"},{"id":"seytek-2012:p0527:b003:l022","ordinal":336189,"en":"And be like the moon that has set."},{"id":"seytek-2012:p0527:b003:l023","ordinal":336190,"en":"If we lose our mane and tail,"},{"id":"seytek-2012:p0527:b003:l024","ordinal":336191,"en":"We shall be left maimed."},{"id":"seytek-2012:p0527:b003:l025","ordinal":336192,"en":"If the head remains but a horn is broken,"},{"id":"seytek-2012:p0527:b003:l026","ordinal":336193,"en":"We shall be left hornless."},{"id":"seytek-2012:p0527:b003:l027","ordinal":336194,"en":"If one of the horns breaks,"},{"id":"seytek-2012:p0527:b003:l028","ordinal":336195,"en":"We shall be left powerless."},{"id":"seytek-2012:p0527:b003:l029","ordinal":336196,"en":"If one breast is severed,"},{"id":"seytek-2012:p0527:b003:l030","ordinal":336197,"en":"We shall be left without milk."},{"id":"seytek-2012:p0527:b003:l031","ordinal":336198,"en":"If death has come, I shall die;"},{"id":"seytek-2012:p0527:b003:l032","ordinal":336199,"en":"But if fortune favors me, Sarybay,"},{"id":"seytek-2012:p0527:b003:l033","ordinal":336200,"en":"I shall slash you and spill your blood."},{"id":"seytek-2012:p0527:b003:l034","ordinal":336201,"en":"I shall wage a mighty struggle"},{"id":"seytek-2012:p0527:b003:l035","ordinal":336202,"en":"And rescue my resourceful uncle"},{"id":"seytek-2012:p0527:b003:l036","ordinal":336203,"en":"From the hands of the wrathful one;"},{"id":"seytek-2012:p0527:b003:l037","ordinal":336204,"en":"I shall deliver him!”"},{"id":"seytek-2012:p0527:b003:l038","ordinal":336205,"en":"From birth, the hero Seytek"},{"id":"seytek-2012:p0527:b003:l039","ordinal":336206,"en":"Was as mighty as half a mountain."},{"id":"seytek-2012:p0527:b003:l040","ordinal":336207,"en":"Without resorting to guile, for his uncle,"},{"id":"seytek-2012:p0528:b002:l001","ordinal":336208,"en":"“I am famished—grant me blood,” he cried."},{"id":"seytek-2012:p0528:b002:l002","ordinal":336209,"en":"“My true father, the lion Almambet,"},{"id":"seytek-2012:p0528:b002:l003","ordinal":336210,"en":"I am afflicted—grant me strength,” he cried."},{"id":"seytek-2012:p0528:b002:l004","ordinal":336211,"en":"Against the enraged infidel,"},{"id":"seytek-2012:p0528:b002:l005","ordinal":336212,"en":"The warrior Khan Sarybay,"},{"id":"seytek-2012:p0528:b002:l006","ordinal":336213,"en":"To keep him from reaching the hero Seytek,"},{"id":"seytek-2012:p0528:b002:l007","ordinal":336214,"en":"He readied the steel-shafted spear,"},{"id":"seytek-2012:p0528:b002:l008","ordinal":336215,"en":"Leveling it straight,"},{"id":"seytek-2012:p0528:b002:l009","ordinal":336216,"en":"Resolved to die as a sacrifice"},{"id":"seytek-2012:p0528:b002:l010","ordinal":336217,"en":"Before the hero Seytek."},{"id":"seytek-2012:p0528:b002:l011","ordinal":336218,"en":"“My true enemy is Sarybay;"},{"id":"seytek-2012:p0528:b002:l012","ordinal":336219,"en":"I shall meet him in combat."},{"id":"seytek-2012:p0528:b002:l013","ordinal":336220,"en":"To inflict grievous torment,"},{"id":"seytek-2012:p0528:b002:l014","ordinal":336221,"en":"And rescue the renowned young Seytek"},{"id":"seytek-2012:p0528:b002:l015","ordinal":336222,"en":"From the mighty demonic infidel,"},{"id":"seytek-2012:p0528:b002:l016","ordinal":336223,"en":"The warrior son of the Monster,”"},{"id":"seytek-2012:p0528:b002:l017","ordinal":336224,"en":"He came to deliver him."},{"id":"seytek-2012:p0528:b002:l018","ordinal":336225,"en":"When he lashed Kulansur,"},{"id":"seytek-2012:p0528:b002:l019","ordinal":336226,"en":"The horse revealed his pedigree as a tulpar."},{"id":"seytek-2012:p0528:b002:l020","ordinal":336227,"en":"Across sixty defiles and eighty ridges,"},{"id":"seytek-2012:p0528:b002:l021","ordinal":336228,"en":"He gathered himself into a sweeping stride,"},{"id":"seytek-2012:p0528:b002:l022","ordinal":336229,"en":"His true tulpar form revealed."},{"id":"seytek-2012:p0528:b002:l023","ordinal":336230,"en":"When his hoof struck the black earth,"},{"id":"seytek-2012:p0528:b002:l024","ordinal":336231,"en":"It split apart in every direction."},{"id":"seytek-2012:p0528:b002:l025","ordinal":336232,"en":"From before Sarybay"},{"id":"seytek-2012:p0528:b002:l026","ordinal":336233,"en":"He flew and bounded like a cloud,"},{"id":"seytek-2012:p0528:b002:l027","ordinal":336234,"en":"Making the broad common land"},{"id":"seytek-2012:p0528:b002:l028","ordinal":336235,"en":"Collapse on every side."},{"id":"seytek-2012:p0528:b002:l029","ordinal":336236,"en":"The ground he trod burst asunder,"},{"id":"seytek-2012:p0528:b002:l030","ordinal":336237,"en":"And stones a spear’s length high"},{"id":"seytek-2012:p0528:b002:l031","ordinal":336238,"en":"Whirled like tents"},{"id":"seytek-2012:p0528:b002:l032","ordinal":336239,"en":"Above the choro’s head."},{"id":"seytek-2012:p0528:b002:l033","ordinal":336240,"en":"Steam poured from his nostrils,"},{"id":"seytek-2012:p0528:b002:l034","ordinal":336241,"en":"Billowing like smoke from an army."},{"id":"seytek-2012:p0528:b002:l035","ordinal":336242,"en":"The earth seemed to end in shimmering haze"},{"id":"seytek-2012:p0528:b002:l036","ordinal":336243,"en":"As he drew near Sarybay."},{"id":"seytek-2012:p0528:b002:l037","ordinal":336244,"en":"The lion choro favored by fortune"},{"id":"seytek-2012:p0528:b002:l038","ordinal":336245,"en":"Reached the wrathful one,"},{"id":"seytek-2012:p0528:b002:l039","ordinal":336246,"en":"And thrust the infidel Sarybay"},{"id":"seytek-2012:p0528:b002:l040","ordinal":336247,"en":"Straight through the collar."},{"id":"seytek-2012:p0528:b003:l001","ordinal":336248,"en":"The hero Seytek had staked"},{"id":"seytek-2012:p0528:b003:l002","ordinal":336249,"en":"His fly-like life upon a hair."},{"id":"seytek-2012:p0528:b003:l003","ordinal":336250,"en":"He arrived swifter than an arrow"},{"id":"seytek-2012:p0528:b003:l004","ordinal":336251,"en":"And struck hard as he passed."},{"id":"seytek-2012:p0528:b003:l005","ordinal":336252,"en":"As though he had punched a stone,"},{"id":"seytek-2012:p0528:b003:l006","ordinal":336253,"en":"The steel spear bent,"},{"id":"seytek-2012:p0528:b003:l007","ordinal":336254,"en":"And the force bore heavily upon the mighty man."},{"id":"seytek-2012:p0528:b003:l008","ordinal":336255,"en":"A white cloud as broad as a house"},{"id":"seytek-2012:p0528:b003:l009","ordinal":336256,"en":"From Sarybay’s flank"},{"id":"seytek-2012:p0528:b003:l010","ordinal":336257,"en":"Burst forth, wheeling like a vulture."},{"id":"seytek-2012:p0528:b003:l011","ordinal":336258,"en":"The spear that struck so violently"},{"id":"seytek-2012:p0528:b003:l012","ordinal":336259,"en":"Shattered into eighty pieces."},{"id":"seytek-2012:p0528:b003:l013","ordinal":336260,"en":"Among warriors and lions,"},{"id":"seytek-2012:p0528:b003:l014","ordinal":336261,"en":"Among heroes of uncommon power,"},{"id":"seytek-2012:p0528:b003:l015","ordinal":336262,"en":"Mane and tail streamed free."},{"id":"seytek-2012:p0528:b003:l016","ordinal":336263,"en":"Telkyzyl, driven with all his strength,"},{"id":"seytek-2012:p0528:b003:l017","ordinal":336264,"en":"Was like a foul blow struck"},{"id":"seytek-2012:p0528:b003:l018","ordinal":336265,"en":"Against the shinbone;"},{"id":"seytek-2012:p0528:b003:l019","ordinal":336266,"en":"He plunged into the black earth,"},{"id":"seytek-2012:p0528:b003:l020","ordinal":336267,"en":"And the lion’s true prowess was revealed."},{"id":"seytek-2012:p0528:b003:l021","ordinal":336268,"en":"Before Seytek could recover,"},{"id":"seytek-2012:p0528:b003:l022","ordinal":336269,"en":"Sarybay, son of the Monster,"},{"id":"seytek-2012:p0528:b003:l023","ordinal":336270,"en":"Rushed upon the hero Seytek."},{"id":"seytek-2012:p0528:b003:l024","ordinal":336271,"en":"Seeking some means to defeat him,"},{"id":"seytek-2012:p0528:b003:l025","ordinal":336272,"en":"The accursed one found his opening"},{"id":"seytek-2012:p0528:b003:l026","ordinal":336273,"en":"And prepared to strike with his mace."},{"id":"seytek-2012:p0528:b003:l027","ordinal":336274,"en":"He braced himself and gathered strength,"},{"id":"seytek-2012:p0528:b003:l028","ordinal":336275,"en":"Swaying as though about to strike,"},{"id":"seytek-2012:p0528:b003:l029","ordinal":336276,"en":"His gorge-like mouth gaping,"},{"id":"seytek-2012:p0528:b003:l030","ordinal":336277,"en":"The gray foam pouring from his mouth"},{"id":"seytek-2012:p0528:b003:l031","ordinal":336278,"en":"And scattering across his chest."},{"id":"seytek-2012:p0528:b003:l032","ordinal":336279,"en":"Just as he reached him to swing the mace,"},{"id":"seytek-2012:p0528:b003:l033","ordinal":336280,"en":"Just as he was about to take Seytek’s head,"},{"id":"seytek-2012:p0528:b003:l034","ordinal":336281,"en":"Külchoro, favored by fortune,"},{"id":"seytek-2012:p0528:b003:l035","ordinal":336282,"en":"Shouted, “Calamity!”"},{"id":"seytek-2012:p0528:b003:l036","ordinal":336283,"en":"The gray-wolf servant, deftest of all,"},{"id":"seytek-2012:p0528:b003:l037","ordinal":336284,"en":"Raised the battle cry, “Manas!”"},{"id":"seytek-2012:p0528:b003:l038","ordinal":336285,"en":"Drew his scabbardless sword,"},{"id":"seytek-2012:p0528:b003:l039","ordinal":336286,"en":"And appealed to the spirit"},{"id":"seytek-2012:p0528:b003:l040","ordinal":336287,"en":"Of the magnanimous hero who had passed into eternity."},{"id":"seytek-2012:p0529:b002:l001","ordinal":336288,"en":"Baby, your time is gone."},{"id":"seytek-2012:p0529:b002:l002","ordinal":336289,"en":"You have not yet had a fertile bone."},{"id":"seytek-2012:p0529:b002:l003","ordinal":336290,"en":"Ten bones, eighty bones,"},{"id":"seytek-2012:p0529:b002:l004","ordinal":336291,"en":"Full of excitement."},{"id":"seytek-2012:p0529:b002:l005","ordinal":336292,"en":"Break the river, build a road,"},{"id":"seytek-2012:p0529:b002:l006","ordinal":336293,"en":"Attacking the face"},{"id":"seytek-2012:p0529:b002:l007","ordinal":336294,"en":"You will have a match,"},{"id":"seytek-2012:p0529:b002:l008","ordinal":336295,"en":"Oh boy, where are you going to go?"},{"id":"seytek-2012:p0529:b002:l009","ordinal":336296,"en":"It is not a mountain to predict."},{"id":"seytek-2012:p0529:b002:l010","ordinal":336297,"en":"The son of the monster disbelieved,"},{"id":"seytek-2012:p0529:b002:l011","ordinal":336298,"en":"They are not human."},{"id":"seytek-2012:p0529:b002:l012","ordinal":336299,"en":"Sarybay, son of a monster"},{"id":"seytek-2012:p0529:b002:l013","ordinal":336300,"en":"It's hell itself,"},{"id":"seytek-2012:p0529:b002:l014","ordinal":336301,"en":"The child has a black eye."},{"id":"seytek-2012:p0529:b002:l015","ordinal":336302,"en":"I am Kulchoro,"},{"id":"seytek-2012:p0529:b002:l016","ordinal":336303,"en":"I saw Eren, I saw"},{"id":"seytek-2012:p0529:b002:l017","ordinal":336304,"en":"I saw that it was boring."},{"id":"seytek-2012:p0529:b002:l018","ordinal":336305,"en":"I got it with the giants,"},{"id":"seytek-2012:p0529:b002:l019","ordinal":336306,"en":"I compared it with a canine."},{"id":"seytek-2012:p0529:b002:l020","ordinal":336307,"en":"I fought with the enemy,"},{"id":"seytek-2012:p0529:b002:l021","ordinal":336308,"en":"I saw Eren, I saw"},{"id":"seytek-2012:p0529:b002:l022","ordinal":336309,"en":"I saw a very troubled man."},{"id":"seytek-2012:p0529:b002:l023","ordinal":336310,"en":"I saw the land on horseback,"},{"id":"seytek-2012:p0529:b002:l024","ordinal":336311,"en":"I saw people in awe."},{"id":"seytek-2012:p0529:b002:l025","ordinal":336312,"en":"I made a cow to meet the deer,"},{"id":"seytek-2012:p0529:b002:l026","ordinal":336313,"en":"I tamed the beginning,"},{"id":"seytek-2012:p0529:b002:l027","ordinal":336314,"en":"I didn't reach my destiny."},{"id":"seytek-2012:p0529:b002:l028","ordinal":336315,"en":"Hell such a child,"},{"id":"seytek-2012:p0529:b002:l029","ordinal":336316,"en":"I didn't see it on the ground."},{"id":"seytek-2012:p0529:b002:l030","ordinal":336317,"en":"It's perfect, it's beautiful,"},{"id":"seytek-2012:p0529:b002:l031","ordinal":336318,"en":"He was a private man."},{"id":"seytek-2012:p0529:b002:l032","ordinal":336319,"en":"The weight is heavy, the urine is strong"},{"id":"seytek-2012:p0529:b002:l033","ordinal":336320,"en":"Better looking, straighter,"},{"id":"seytek-2012:p0529:b002:l034","ordinal":336321,"en":"It was a burnt ember."},{"id":"seytek-2012:p0529:b002:l035","ordinal":336322,"en":"In the giants we faced,"},{"id":"seytek-2012:p0529:b002:l036","ordinal":336323,"en":"In ethnic Albanian populations,"},{"id":"seytek-2012:p0529:b002:l037","ordinal":336324,"en":"There is no such thing."},{"id":"seytek-2012:p0529:b002:l038","ordinal":336325,"en":"Every time the hammer hits,"},{"id":"seytek-2012:p0529:b002:l039","ordinal":336326,"en":"Again from the narrow road"},{"id":"seytek-2012:p0529:b002:l040","ordinal":336327,"en":"I almost passed out."},{"id":"seytek-2012:p0529:b003:l001","ordinal":336328,"en":"When the hook hits the collar,"},{"id":"seytek-2012:p0529:b003:l002","ordinal":336329,"en":"Heroic Sarybay"},{"id":"seytek-2012:p0529:b003:l003","ordinal":336330,"en":"The market road is closed,"},{"id":"seytek-2012:p0529:b003:l004","ordinal":336331,"en":"The meat was cooked."},{"id":"seytek-2012:p0529:b003:l005","ordinal":336332,"en":"Don't sleep well,"},{"id":"seytek-2012:p0529:b003:l006","ordinal":336333,"en":"Shouting and not hitting the spear,"},{"id":"seytek-2012:p0529:b003:l007","ordinal":336334,"en":"Keep busy."},{"id":"seytek-2012:p0529:b003:l008","ordinal":336335,"en":"Heroism is humble,"},{"id":"seytek-2012:p0529:b003:l009","ordinal":336336,"en":"Without delivering to Er Seytek,"},{"id":"seytek-2012:p0529:b003:l010","ordinal":336337,"en":"Shai-supporting people"},{"id":"seytek-2012:p0529:b003:l011","ordinal":336338,"en":"Trick the disbeliever."},{"id":"seytek-2012:p0529:b003:l012","ordinal":336339,"en":"Reaching out and picking up a spear,"},{"id":"seytek-2012:p0529:b003:l013","ordinal":336340,"en":"Without delivering to Er Seytek,"},{"id":"seytek-2012:p0529:b003:l014","ordinal":336341,"en":"Sarybai tied his hands."},{"id":"seytek-2012:p0529:b003:l015","ordinal":336342,"en":"Make it perfect,"},{"id":"seytek-2012:p0529:b003:l016","ordinal":336343,"en":"Without reaching Karalid,"},{"id":"seytek-2012:p0529:b003:l017","ordinal":336344,"en":"The unbeliever tied his way."},{"id":"seytek-2012:p0529:b003:l018","ordinal":336345,"en":"Fainting, fainting,"},{"id":"seytek-2012:p0529:b003:l019","ordinal":336346,"en":"Sarybai was bleeding."},{"id":"seytek-2012: