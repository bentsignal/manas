[{"id":"manas-2010:p0462:b001:l037","ordinal":21249,"en":"All their titans and giants are there."},{"id":"manas-2010:p0462:b001:l038","ordinal":21250,"en":"Ulukman is there, and khans;"},{"id":"manas-2010:p0462:b001:l039","ordinal":21251,"en":"Among those accursed Chinese"},{"id":"manas-2010:p0462:b001:l040","ordinal":21252,"en":"Are men skilled in war."},{"id":"manas-2010:p0462:b001:l041","ordinal":21253,"en":"Thinking of it, my heart becomes a coal:"},{"id":"manas-2010:p0462:b001:l042","ordinal":21254,"en":"Among that Chinese people"},{"id":"manas-2010:p0463:b001:l001","ordinal":21255,"en":"What things are there, and what are not!"},{"id":"manas-2010:p0463:b001:l002","ordinal":21256,"en":"There are those who do not know human speech,"},{"id":"manas-2010:p0463:b001:l003","ordinal":21257,"en":"Who speak words of another kind."},{"id":"manas-2010:p0463:b001:l004","ordinal":21258,"en":"Why speak of the others?"},{"id":"manas-2010:p0463:b001:l005","ordinal":21259,"en":"There are those with a single eye in their head."},{"id":"manas-2010:p0463:b001:l006","ordinal":21260,"en":"Beejin is no ordinary place;"},{"id":"manas-2010:p0463:b001:l007","ordinal":21261,"en":"It has support to rely upon."},{"id":"manas-2010:p0463:b001:l008","ordinal":21262,"en":"Those accursed Kytay"},{"id":"manas-2010:p0463:b001:l009","ordinal":21263,"en":"Have peoples stretching from Kap-Too this way."},{"id":"manas-2010:p0463:b001:l010","ordinal":21264,"en":"They have sorcerers and weather-conjurers;"},{"id":"manas-2010:p0463:b001:l011","ordinal":21265,"en":"Their spell-workers stand nearby."},{"id":"manas-2010:p0463:b001:l012","ordinal":21266,"en":"Those Kytay—may they burn to death!—"},{"id":"manas-2010:p0463:b001:l013","ordinal":21267,"en":"Have many lords and men."},{"id":"manas-2010:p0463:b001:l014","ordinal":21268,"en":"Never retreating from battle,"},{"id":"manas-2010:p0463:b001:l015","ordinal":21269,"en":"Such relentless terrors they are."},{"id":"manas-2010:p0463:b001:l016","ordinal":21270,"en":"When we dwelt in Zheti-Özön,"},{"id":"manas-2010:p0463:b001:l017","ordinal":21271,"en":"Our land was left deserted."},{"id":"manas-2010:p0463:b001:l018","ordinal":21272,"en":"The Kytay raided it many times;"},{"id":"manas-2010:p0463:b001:l019","ordinal":21273,"en":"Our Kyrgyz people wandered in exile."},{"id":"manas-2010:p0463:b001:l020","ordinal":21274,"en":"If we continue the old traditions,"},{"id":"manas-2010:p0463:b001:l021","ordinal":21275,"en":"If we ask those who have heard them,"},{"id":"manas-2010:p0463:b001:l022","ordinal":21276,"en":"They wrought much slaughter."},{"id":"manas-2010:p0463:b001:l023","ordinal":21277,"en":"The black Kytay and Manzhuu,"},{"id":"manas-2010:p0463:b001:l024","ordinal":21278,"en":"All who were sons of the Kyrgyz,"},{"id":"manas-2010:p0463:b001:l025","ordinal":21279,"en":"They raided them forty times."},{"id":"manas-2010:p0463:b001:l026","ordinal":21280,"en":"Thus our dear people"},{"id":"manas-2010:p0463:b001:l027","ordinal":21281,"en":"Were left shattered."},{"id":"manas-2010:p0463:b001:l028","ordinal":21282,"en":"The imperial Kytay thundered,"},{"id":"manas-2010:p0463:b001:l029","ordinal":21283,"en":"Unleashing their fury as they went."},{"id":"manas-2010:p0463:b001:l030","ordinal":21284,"en":"Thus the Kyrgyz"},{"id":"manas-2010:p0463:b001:l031","ordinal":21285,"en":"They crushed and brought to ruin."},{"id":"manas-2010:p0463:b001:l032","ordinal":21286,"en":"Smashing their stone fortress,"},{"id":"manas-2010:p0463:b001:l033","ordinal":21287,"en":"They plundered everything."},{"id":"manas-2010:p0463:b001:l034","ordinal":21288,"en":"Some of us went to Eren;"},{"id":"manas-2010:p0463:b001:l035","ordinal":21289,"en":"Then we fell"},{"id":"manas-2010:p0463:b001:l036","ordinal":21290,"en":"Into a bottomless, deep pit."},{"id":"manas-2010:p0463:b001:l037","ordinal":21291,"en":"We made Zheti-Özön our homeland;"},{"id":"manas-2010:p0463:b001:l038","ordinal":21292,"en":"'May God grant fulfillment,' we said,"},{"id":"manas-2010:p0463:b001:l039","ordinal":21293,"en":"And took Khan Manas as our strength."},{"id":"manas-2010:p0463:b001:l040","ordinal":21294,"en":"From poverty we grew wealthy;"},{"id":"manas-2010:p0463:b001:l041","ordinal":21295,"en":"From solitude we grew numerous."},{"id":"manas-2010:p0463:b001:l042","ordinal":21296,"en":"Broken apart, we joined again;"},{"id":"manas-2010:p0464:b001:l001","ordinal":21297,"en":"Scattered, we gathered again;"},{"id":"manas-2010:p0464:b001:l002","ordinal":21298,"en":"Exhausted, we recovered,"},{"id":"manas-2010:p0464:b001:l003","ordinal":21299,"en":"And grappled with the black Manzhuu."},{"id":"manas-2010:p0464:b001:l004","ordinal":21300,"en":"If we remain alive and do not die,"},{"id":"manas-2010:p0464:b001:l005","ordinal":21301,"en":"What inheritance shall we gain?"},{"id":"manas-2010:p0464:b001:l006","ordinal":21302,"en":"For the lion Manas, blessed by Khizir,"},{"id":"manas-2010:p0464:b001:l007","ordinal":21303,"en":"Let us clash and fight for six months;"},{"id":"manas-2010:p0464:b001:l008","ordinal":21304,"en":"Let us perish in the slaughter.”"},{"id":"manas-2010:p0464:b001:l009","ordinal":21305,"en":"Summoning courage, Khan Koshoy"},{"id":"manas-2010:p0464:b001:l010","ordinal":21306,"en":"Now stood in readiness."},{"id":"manas-2010:p0464:b001:l011","ordinal":21307,"en":"Your wise elder Koshoy"},{"id":"manas-2010:p0464:b001:l012","ordinal":21308,"en":"Found counsel from the unseen."},{"id":"manas-2010:p0464:b001:l013","ordinal":21309,"en":"Calling like a young goose,"},{"id":"manas-2010:p0464:b001:l014","ordinal":21310,"en":"Your champion elder Koshoy,"},{"id":"manas-2010:p0464:b001:l015","ordinal":21311,"en":"His white beard shining—"},{"id":"manas-2010:p0464:b001:l016","ordinal":21312,"en":"In many places, the world"},{"id":"manas-2010:p0464:b001:l017","ordinal":21313,"en":"Had he not stirred it, this Koshoy?"},{"id":"manas-2010:p0464:b001:l018","ordinal":21314,"en":"Bringing warriors down in many lands,"},{"id":"manas-2010:p0464:b001:l019","ordinal":21315,"en":"Hearing words from the wise,"},{"id":"manas-2010:p0464:b001:l020","ordinal":21316,"en":"Had he not lived through it, this Koshoy?"},{"id":"manas-2010:p0464:b001:l021","ordinal":21317,"en":"Leading soldiers and mustering troops,"},{"id":"manas-2010:p0464:b001:l022","ordinal":21318,"en":"Was this not the practiced Koshoy?"},{"id":"manas-2010:p0464:b001:l023","ordinal":21319,"en":"Fighting without shrinking from death,"},{"id":"manas-2010:p0464:b001:l024","ordinal":21320,"en":"Was this not the practiced Koshoy?"},{"id":"manas-2010:p0464:b001:l025","ordinal":21321,"en":"Standing as support for the poor,"},{"id":"manas-2010:p0464:b001:l026","ordinal":21322,"en":"Was this not Koshoy who gave aid?"},{"id":"manas-2010:p0464:b001:l027","ordinal":21323,"en":"His knowledge surpassed a thousand men's;"},{"id":"manas-2010:p0464:b001:l028","ordinal":21324,"en":"His words were clear and public."},{"id":"manas-2010:p0464:b001:l029","ordinal":21325,"en":"Your wise elder Koshoy"},{"id":"manas-2010:p0464:b001:l030","ordinal":21326,"en":"Was an elder to many peoples,"},{"id":"manas-2010:p0464:b001:l031","ordinal":21327,"en":"Whose blessing enriched the people,"},{"id":"manas-2010:p0464:b001:l032","ordinal":21328,"en":"A saint more knowing than all."},{"id":"manas-2010:p0464:b001:l033","ordinal":21329,"en":"Your elder Koshoy addressed the people,"},{"id":"manas-2010:p0464:b001:l034","ordinal":21330,"en":"Speaking of where to strike their flank,"},{"id":"manas-2010:p0464:b001:l035","ordinal":21331,"en":"All the warriors stirred;"},{"id":"manas-2010:p0464:b001:l036","ordinal":21332,"en":"All the gray-maned heroes prepared."},{"id":"manas-2010:p0464:b001:l037","ordinal":21333,"en":"Spirited tulpars, swift horses—"},{"id":"manas-2010:p0464:b001:l038","ordinal":21334,"en":"What their heroic elder Koshoy had said,"},{"id":"manas-2010:p0464:b001:l039","ordinal":21335,"en":"The brave men quickly understood."},{"id":"manas-2010:p0464:b001:l040","ordinal":21336,"en":"Understanding, the people gathered together;"},{"id":"manas-2010:p0464:b001:l041","ordinal":21337,"en":"The warriors could not stand still,"},{"id":"manas-2010:p0464:b001:l042","ordinal":21338,"en":"Each preparing his own horse."},{"id":"manas-2010:p0465:b001:l001","ordinal":21339,"en":"They tethered tulpars, heads held high;"},{"id":"manas-2010:p0465:b001:l002","ordinal":21340,"en":"They tethered racers, necks arched."},{"id":"manas-2010:p0465:b001:l003","ordinal":21341,"en":"The Burut people had not yet moved."},{"id":"manas-2010:p0465:b001:l004","ordinal":21342,"en":"Putting their hands into water,"},{"id":"manas-2010:p0465:b001:l005","ordinal":21343,"en":"They performed ablution for their hands;"},{"id":"manas-2010:p0465:b001:l006","ordinal":21344,"en":"Putting their feet into water,"},{"id":"manas-2010:p0465:b001:l007","ordinal":21345,"en":"They performed ablution for their feet."},{"id":"manas-2010:p0465:b001:l008","ordinal":21346,"en":"They gathered horses and tulpars;"},{"id":"manas-2010:p0465:b001:l009","ordinal":21347,"en":"Hurrying in a great bustle,"},{"id":"manas-2010:p0465:b001:l010","ordinal":21348,"en":"Their imam urged them onward."},{"id":"manas-2010:p0465:b001:l011","ordinal":21349,"en":"They hastened through their prayers;"},{"id":"manas-2010:p0465:b001:l012","ordinal":21350,"en":"The great army surged,"},{"id":"manas-2010:p0465:b001:l013","ordinal":21351,"en":"Saddling chosen racers."},{"id":"manas-2010:p0465:b001:l014","ordinal":21352,"en":"For all their swift steeds,"},{"id":"manas-2010:p0465:b001:l015","ordinal":21353,"en":"They lengthened the cruppers;"},{"id":"manas-2010:p0465:b001:l016","ordinal":21354,"en":"When they entered mounted wrestling,"},{"id":"manas-2010:p0465:b001:l017","ordinal":21355,"en":"So they would not topple off,"},{"id":"manas-2010:p0465:b001:l018","ordinal":21356,"en":"They shortened the breast girths."},{"id":"manas-2010:p0465:b001:l019","ordinal":21357,"en":"Readying their weapons,"},{"id":"manas-2010:p0465:b001:l020","ordinal":21358,"en":"Preparing for deadly combat,"},{"id":"manas-2010:p0465:b001:l021","ordinal":21359,"en":"Scare the spine,"},{"id":"manas-2010:p0465:b001:l022","ordinal":21360,"en":"Their spears jutting high,"},{"id":"manas-2010:p0465:b001:l023","ordinal":21361,"en":"Their great axes held out,"},{"id":"manas-2010:p0465:b001:l024","ordinal":21362,"en":"Their bag-like noses swelling,"},{"id":"manas-2010:p0465:b001:l025","ordinal":21363,"en":"Knowing many would die,"},{"id":"manas-2010:p0465:b001:l026","ordinal":21364,"en":"Helmets of blue iron"},{"id":"manas-2010:p0465:b001:l027","ordinal":21365,"en":"They set down over their heads."},{"id":"manas-2010:p0465:b001:l028","ordinal":21366,"en":"'In God's hands!' they said, without stopping."},{"id":"manas-2010:p0465:b001:l029","ordinal":21367,"en":"The courageous men prepared;"},{"id":"manas-2010:p0465:b001:l030","ordinal":21368,"en":"Aged and long-lived,"},{"id":"manas-2010:p0465:b001:l031","ordinal":21369,"en":"Your elder Khan Koshoy led them."},{"id":"manas-2010:p0465:b001:l032","ordinal":21370,"en":"Praying to the one God,"},{"id":"manas-2010:p0465:b001:l033","ordinal":21371,"en":"On this side of Middle Beejin,"},{"id":"manas-2010:p0465:b001:l034","ordinal":21372,"en":"Along Kaspang-Too,"},{"id":"manas-2010:p0465:b001:l035","ordinal":21373,"en":"All their chosen swift steeds"},{"id":"manas-2010:p0465:b001:l036","ordinal":21374,"en":"They shod anew."},{"id":"manas-2010:p0465:b001:l037","ordinal":21375,"en":"Many holy men were with them;"},{"id":"manas-2010:p0465:b001:l038","ordinal":21376,"en":"To go to broad, lake-like Beejin,"},{"id":"manas-2010:p0465:b001:l039","ordinal":21377,"en":"Of all the Muslims,"},{"id":"manas-2010:p0465:b001:l040","ordinal":21378,"en":"Their leaders were present."},{"id":"manas-2010:p0465:b001:l041","ordinal":21379,"en":"Khan Koshoy of the Katagan"},{"id":"manas-2010:p0465:b001:l042","ordinal":21380,"en":"Was the one who held the banner."},{"id":"manas-2010:p0466:b001:l001","ordinal":21381,"en":"All the warriors made ready"},{"id":"manas-2010:p0466:b001:l002","ordinal":21382,"en":"To wage a holy campaign against the unbelievers."},{"id":"manas-2010:p0466:b001:l003","ordinal":21383,"en":"From the unbelievers' hands,"},{"id":"manas-2010:p0466:b001:l004","ordinal":21384,"en":"The bloodstained lion Manas,"},{"id":"manas-2010:p0466:b001:l005","ordinal":21385,"en":"To rescue him,"},{"id":"manas-2010:p0466:b001:l006","ordinal":21386,"en":"All the heroes prepared."},{"id":"manas-2010:p0466:b001:l007","ordinal":21387,"en":"Wearing coats no bullet could pierce,"},{"id":"manas-2010:p0466:b001:l008","ordinal":21388,"en":"Rejoicing at the cry of 'Enemy!'"},{"id":"manas-2010:p0466:b001:l009","ordinal":21389,"en":"Troop after troop,"},{"id":"manas-2010:p0466:b001:l010","ordinal":21390,"en":"They stirred, filling the world."},{"id":"manas-2010:p0466:b001:l011","ordinal":21391,"en":"Strapping on unsheathed swords,"},{"id":"manas-2010:p0466:b001:l012","ordinal":21392,"en":"All the leopards,"},{"id":"manas-2010:p0466:b001:l013","ordinal":21393,"en":"Wrath spread across their faces."},{"id":"manas-2010:p0466:b001:l014","ordinal":21394,"en":"Shrill cries sounded from brass pipes;"},{"id":"manas-2010:p0466:b001:l015","ordinal":21395,"en":"Through the broad ravine where no bird flew,"},{"id":"manas-2010:p0466:b001:l016","ordinal":21396,"en":"No enemy would escape the spear;"},{"id":"manas-2010:p0466:b001:l017","ordinal":21397,"en":"The campaigner fears no gain."},{"id":"manas-2010:p0466:b001:l018","ordinal":21398,"en":"Holding spears and snorting,"},{"id":"manas-2010:p0466:b001:l019","ordinal":21399,"en":"All the warriors"},{"id":"manas-2010:p0466:b001:l020","ordinal":21400,"en":"Spread along the flanks."},{"id":"manas-2010:p0466:b001:l021","ordinal":21401,"en":"The foolish, witless men,"},{"id":"manas-2010:p0466:b001:l022","ordinal":21402,"en":"'What will become of us?' they asked,"},{"id":"manas-2010:p0466:b001:l023","ordinal":21403,"en":"Were enclosed in the middle."},{"id":"manas-2010:p0466:b001:l024","ordinal":21404,"en":"Whip-bearers were at the front;"},{"id":"manas-2010:p0466:b001:l025","ordinal":21405,"en":"The courageous were on the flanks."},{"id":"manas-2010:p0466:b001:l026","ordinal":21406,"en":"Swordsmen were at the front;"},{"id":"manas-2010:p0466:b001:l027","ordinal":21407,"en":"The mighty were on the flanks."},{"id":"manas-2010:p0466:b001:l028","ordinal":21408,"en":"Club-bearers were on the flanks;"},{"id":"manas-2010:p0466:b001:l029","ordinal":21409,"en":"Broad-backed men were on the flanks."},{"id":"manas-2010:p0466:b001:l030","ordinal":21410,"en":"The courageous men rushed eagerly."},{"id":"manas-2010:p0466:b001:l031","ordinal":21411,"en":"'Attacking an unknown enemy,"},{"id":"manas-2010:p0466:b001:l032","ordinal":21412,"en":"They will die for nothing,' they thought;"},{"id":"manas-2010:p0466:b001:l033","ordinal":21413,"en":"Their kinsmen"},{"id":"manas-2010:p0466:b001:l034","ordinal":21414,"en":"Took them by the hand to guide them."},{"id":"manas-2010:p0466:b001:l035","ordinal":21415,"en":"When Koshoy drove them forward,"},{"id":"manas-2010:p0466:b001:l036","ordinal":21416,"en":"Stirring all the people,"},{"id":"manas-2010:p0466:b001:l037","ordinal":21417,"en":"He set them on the right road."},{"id":"manas-2010:p0466:b001:l038","ordinal":21418,"en":"Taking tufted spears in hand,"},{"id":"manas-2010:p0466:b001:l039","ordinal":21419,"en":"Many more flourished them."},{"id":"manas-2010:p0466:b001:l040","ordinal":21420,"en":"Fighting to exhaustion,"},{"id":"manas-2010:p0466:b001:l041","ordinal":21421,"en":"Rising all together,"},{"id":"manas-2010:p0466:b001:l042","ordinal":21422,"en":"'We have seen a marvel,' they said,"},{"id":"manas-2010:p0467:b001:l001","ordinal":21423,"en":"Many more rejoiced."},{"id":"manas-2010:p0467:b001:l002","ordinal":21424,"en":"'Our poor wives and young children,"},{"id":"manas-2010:p0467:b001:l003","ordinal":21425,"en":"If we happen to enter combat,"},{"id":"manas-2010:p0467:b001:l004","ordinal":21426,"en":"If we happen to die,"},{"id":"manas-2010:p0467:b001:l005","ordinal":21427,"en":"What will become of their lives?' they thought."},{"id":"manas-2010:p0467:b001:l006","ordinal":21428,"en":"Many more grieved."},{"id":"manas-2010:p0467:b001:l007","ordinal":21429,"en":"'If we quarrel and raise a fight,"},{"id":"manas-2010:p0467:b001:l008","ordinal":21430,"en":"There will be another marvel,' they said."},{"id":"manas-2010:p0467:b001:l009","ordinal":21431,"en":"Many more were glad."},{"id":"manas-2010:p0467:b001:l010","ordinal":21432,"en":"Riding tulpars, taking horses,"},{"id":"manas-2010:p0467:b001:l011","ordinal":21433,"en":"'Let us die fighting, if we must,' they said."},{"id":"manas-2010:p0467:b001:l012","ordinal":21434,"en":"Receiving Khan Koshoy's blessing,"},{"id":"manas-2010:p0467:b001:l013","ordinal":21435,"en":"Taking black-jawed axes in hand,"},{"id":"manas-2010:p0467:b001:l014","ordinal":21436,"en":"Many more flourished them."},{"id":"manas-2010:p0467:b001:l015","ordinal":21437,"en":"Their thoughts straying through many ravines,"},{"id":"manas-2010:p0467:b001:l016","ordinal":21438,"en":"'If we attack, we are dead,' they said."},{"id":"manas-2010:p0467:b001:l017","ordinal":21439,"en":"Many more languished in fear."},{"id":"manas-2010:p0467:b001:l018","ordinal":21440,"en":"Within the marching army"},{"id":"manas-2010:p0467:b001:l019","ordinal":21441,"en":"Were warriors in great numbers,"},{"id":"manas-2010:p0467:b001:l020","ordinal":21442,"en":"And many formidable men."},{"id":"manas-2010:p0467:b001:l021","ordinal":21443,"en":"Knowing no stratagem at all,"},{"id":"manas-2010:p0467:b001:l022","ordinal":21444,"en":"There were simpletons as well."},{"id":"manas-2010:p0467:b001:l023","ordinal":21445,"en":"Aykozho in a many-colored robe,"},{"id":"manas-2010:p0467:b001:l024","ordinal":21446,"en":"From the city of Anzhiyan,"},{"id":"manas-2010:p0467:b001:l025","ordinal":21447,"en":"On account of his son,"},{"id":"manas-2010:p0467:b001:l026","ordinal":21448,"en":"For the few Muslims,"},{"id":"manas-2010:p0467:b001:l027","ordinal":21449,"en":"He had become a support."},{"id":"manas-2010:p0467:b001:l028","ordinal":21450,"en":"A great mullah from Bukhara,"},{"id":"manas-2010:p0467:b001:l029","ordinal":21451,"en":"'If I enter combat, I shall die,' he said;"},{"id":"manas-2010:p0467:b001:l030","ordinal":21452,"en":"'Of the Muslims, those who die,"},{"id":"manas-2010:p0467:b001:l031","ordinal":21453,"en":"I shall see to their burial myself,' he said."},{"id":"manas-2010:p0467:b001:l032","ordinal":21454,"en":"'For those who survive the dead,"},{"id":"manas-2010:p0467:b001:l033","ordinal":21455,"en":"I shall serve as imam,' he said;"},{"id":"manas-2010:p0467:b001:l034","ordinal":21456,"en":"He had come from Bukhara."},{"id":"manas-2010:p0467:b001:l035","ordinal":21457,"en":"His black beard an armful,"},{"id":"manas-2010:p0467:b001:l036","ordinal":21458,"en":"No man could defeat him in combat,"},{"id":"manas-2010:p0467:b001:l037","ordinal":21459,"en":"No man could bring him low;"},{"id":"manas-2010:p0467:b001:l038","ordinal":21460,"en":"None who faced him survived."},{"id":"manas-2010:p0467:b001:l039","ordinal":21461,"en":"The veteran hero Buudayyk"},{"id":"manas-2010:p0467:b001:l040","ordinal":21462,"en":"Had joined this army too."},{"id":"manas-2010:p0467:b001:l041","ordinal":21463,"en":"Aydarkan of the Kazakhs,"},{"id":"manas-2010:p0467:b001:l042","ordinal":21464,"en":"Riding a dun-colored tulpar,"},{"id":"manas-2010:p0468:b001:l001","ordinal":21465,"en":"Its forehead blazed like an amulet,"},{"id":"manas-2010:p0468:b001:l002","ordinal":21466,"en":"A distinguished hero of boundless valor,"},{"id":"manas-2010:p0468:b001:l003","ordinal":21467,"en":"Hearing news of the bloodstained one,"},{"id":"manas-2010:p0468:b001:l004","ordinal":21468,"en":"To become his support,"},{"id":"manas-2010:p0468:b001:l005","ordinal":21469,"en":"Dust billowing from the valley,"},{"id":"manas-2010:p0468:b001:l006","ordinal":21470,"en":"Crying out his songs,"},{"id":"manas-2010:p0468:b001:l007","ordinal":21471,"en":"He too had joined this army."},{"id":"manas-2010:p0468:b001:l008","ordinal":21472,"en":"There were eminent men and khans,"},{"id":"manas-2010:p0468:b001:l009","ordinal":21473,"en":"Those bereaved and parted from their people;"},{"id":"manas-2010:p0468:b001:l010","ordinal":21474,"en":"When it came to these Kytay,"},{"id":"manas-2010:p0468:b001:l011","ordinal":21475,"en":"All who bore a grudge were there."},{"id":"manas-2010:p0468:b001:l012","ordinal":21476,"en":"There were warriors and giants,"},{"id":"manas-2010:p0468:b001:l013","ordinal":21477,"en":"All the most formidable mighty men."},{"id":"manas-2010:p0468:b001:l014","ordinal":21478,"en":"Teaching what was unknown,"},{"id":"manas-2010:p0468:b001:l015","ordinal":21479,"en":"Wisely setting them on their way,"},{"id":"manas-2010:p0468:b001:l016","ordinal":21480,"en":"Was the learned, valiant Koshoy."},{"id":"manas-2010:p0468:b001:l017","ordinal":21481,"en":"There were many warriors;"},{"id":"manas-2010:p0468:b001:l018","ordinal":21482,"en":"With his sash wound as a turban,"},{"id":"manas-2010:p0468:b001:l019","ordinal":21483,"en":"Praying to the Almighty,"},{"id":"manas-2010:p0468:b001:l020","ordinal":21484,"en":"My poor khoja was there too."},{"id":"manas-2010:p0468:b001:l021","ordinal":21485,"en":"There were champions skilled with spears,"},{"id":"manas-2010:p0468:b001:l022","ordinal":21486,"en":"Destined to die for nothing,"},{"id":"manas-2010:p0468:b001:l023","ordinal":21487,"en":"Rash-hearted swaggerers too."},{"id":"manas-2010:p0468:b001:l024","ordinal":21488,"en":"There were khans boasting of gray-maned valor,"},{"id":"manas-2010:p0468:b001:l025","ordinal":21489,"en":"Some poor, some excellent;"},{"id":"manas-2010:p0468:b001:l026","ordinal":21490,"en":"There were tales of every kind."},{"id":"manas-2010:p0468:b001:l027","ordinal":21491,"en":"Old gray-maned Koshoy was there;"},{"id":"manas-2010:p0468:b001:l028","ordinal":21492,"en":"Kudaynazar-Kuuchokmor,"},{"id":"manas-2010:p0468:b001:l029","ordinal":21493,"en":"That poor champion, was there too."},{"id":"manas-2010:p0468:b001:l030","ordinal":21494,"en":"Around the winding mountains,"},{"id":"manas-2010:p0468:b001:l031","ordinal":21495,"en":"Along the twisting rivers,"},{"id":"manas-2010:p0468:b001:l032","ordinal":21496,"en":"Your elder Koshoy traveled,"},{"id":"manas-2010:p0468:b001:l033","ordinal":21497,"en":"Journeying day and night,"},{"id":"manas-2010:p0468:b001:l034","ordinal":21498,"en":"Crossing the bulging mountains,"},{"id":"manas-2010:p0468:b001:l035","ordinal":21499,"en":"Treading rough and hilly ground."},{"id":"manas-2010:p0468:b001:l036","ordinal":21500,"en":"To give fearsome Manas relief,"},{"id":"manas-2010:p0468:b001:l037","ordinal":21501,"en":"Along the road where the watch had been taken,"},{"id":"manas-2010:p0468:b001:l038","ordinal":21502,"en":"Mighty Koshoy came to meet him,"},{"id":"manas-2010:p0468:b001:l039","ordinal":21503,"en":"With an army of twelve thousand."},{"id":"manas-2010:p0468:b001:l040","ordinal":21504,"en":"Your warrior elder Koshoy,"}]
