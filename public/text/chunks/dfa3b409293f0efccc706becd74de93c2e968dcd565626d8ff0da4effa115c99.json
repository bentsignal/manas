[{"id":"semetey-1-2013:p0677:b004:l010","ordinal":128769,"en":"A mortal like your father,"},{"id":"semetey-1-2013:p0677:b004:l011","ordinal":128770,"en":"Our Almighty Allah, the Creator,"},{"id":"semetey-1-2013:p0677:b004:l012","ordinal":128771,"en":"Will surely not grant another soon."},{"id":"semetey-1-2013:p0677:b004:l013","ordinal":128772,"en":"Your father Manas, the fierce-maned khan,"},{"id":"semetey-1-2013:p0677:b004:l014","ordinal":128773,"en":"Was born in Altay and rose from there."},{"id":"semetey-1-2013:p0677:b004:l015","ordinal":128774,"en":"The Forty Saints, Kyzyr and Ilyas—"},{"id":"semetey-1-2013:p0677:b004:l016","ordinal":128775,"en":"Forty-two were his companions on the road."},{"id":"semetey-1-2013:p0677:b004:l017","ordinal":128776,"en":"The Almighty Creator put his affairs right,"},{"id":"semetey-1-2013:p0677:b004:l018","ordinal":128777,"en":"Bare-bodied Kydyr gave him support."},{"id":"semetey-1-2013:p0677:b004:l019","ordinal":128778,"en":"Your fierce-maned father—"},{"id":"semetey-1-2013:p0677:b004:l020","ordinal":128779,"en":"None who faced him survived."},{"id":"semetey-1-2013:p0677:b004:l021","ordinal":128780,"en":"When your father Manas lived,"},{"id":"semetey-1-2013:p0677:b004:l022","ordinal":128781,"en":"Five spiritual masters came from Mecca,"},{"id":"semetey-1-2013:p0677:b004:l023","ordinal":128782,"en":"He ranged them through five or six summer pastures."},{"id":"semetey-1-2013:p0677:b004:l024","ordinal":128783,"en":"Your father, the renowned one,"},{"id":"semetey-1-2013:p0677:b004:l025","ordinal":128784,"en":"Made the enemies he faced crawl."},{"id":"semetey-1-2013:p0677:b004:l026","ordinal":128785,"en":"When he reached twelve,"},{"id":"semetey-1-2013:p0677:b004:l027","ordinal":128786,"en":"He raided a khan's seat and took spoils."},{"id":"semetey-1-2013:p0677:b004:l028","ordinal":128787,"en":"Throughout the whole wide world"},{"id":"semetey-1-2013:p0677:b004:l029","ordinal":128788,"en":"Your father Manas stirred up strife."},{"id":"semetey-1-2013:p0677:b004:l030","ordinal":128789,"en":"When your father mounted Akkula,"},{"id":"semetey-1-2013:p0677:b004:l031","ordinal":128790,"en":"When he donned Akolpok,"},{"id":"semetey-1-2013:p0677:b004:l032","ordinal":128791,"en":"When he charged the foe with a shout,"},{"id":"semetey-1-2013:p0677:b004:l033","ordinal":128792,"en":"A black-spotted leopard"},{"id":"semetey-1-2013:p0677:b004:l034","ordinal":128793,"en":"Sprang at his flank,"},{"id":"semetey-1-2013:p0677:b004:l035","ordinal":128794,"en":"A short-tailed, dark-maned lion"},{"id":"semetey-1-2013:p0677:b004:l036","ordinal":128795,"en":"Ran beside him, ready for action."},{"id":"semetey-1-2013:p0677:b004:l037","ordinal":128796,"en":"Your father, fierce-maned Manas—"},{"id":"semetey-1-2013:p0677:b004:l038","ordinal":128797,"en":"If one looked at his front,"},{"id":"semetey-1-2013:p0677:b004:l039","ordinal":128798,"en":"He had the fearsome presence of six thousand warriors,"},{"id":"semetey-1-2013:p0678:b003:l001","ordinal":128799,"en":"If your father turned his back,"},{"id":"semetey-1-2013:p0678:b003:l002","ordinal":128800,"en":"He had the form of a dragon."},{"id":"semetey-1-2013:p0678:b003:l003","ordinal":128801,"en":"His face was like wheat browned in oil,"},{"id":"semetey-1-2013:p0678:b003:l004","ordinal":128802,"en":"His eyes were like mist at dusk."},{"id":"semetey-1-2013:p0678:b003:l005","ordinal":128803,"en":"Your generous father Manas—"},{"id":"semetey-1-2013:p0678:b003:l006","ordinal":128804,"en":"That was how he looked."},{"id":"semetey-1-2013:p0678:b003:l007","ordinal":128805,"en":"When your father Manas lived,"},{"id":"semetey-1-2013:p0678:b003:l008","ordinal":128806,"en":"Argyn and Kyrgyz mingled—"},{"id":"semetey-1-2013:p0678:b003:l009","ordinal":128807,"en":"That was how his people were."},{"id":"semetey-1-2013:p0678:b003:l010","ordinal":128808,"en":"When your father dwelt here,"},{"id":"semetey-1-2013:p0678:b003:l011","ordinal":128809,"en":"Famous Ken-Kol, broad Talas—"},{"id":"semetey-1-2013:p0678:b003:l012","ordinal":128810,"en":"That was how his land was."},{"id":"semetey-1-2013:p0678:b003:l013","ordinal":128811,"en":"Hill after hill comes into view,"},{"id":"semetey-1-2013:p0678:b003:l014","ordinal":128812,"en":"A rolling ridge with rugged passes."},{"id":"semetey-1-2013:p0678:b003:l015","ordinal":128813,"en":"From the hills the wild sheep pour,"},{"id":"semetey-1-2013:p0678:b003:l016","ordinal":128814,"en":"The grass upon the hills grows sparse."},{"id":"semetey-1-2013:p0678:b003:l017","ordinal":128815,"en":"Rugged ridge after ridge appears,"},{"id":"semetey-1-2013:p0678:b003:l018","ordinal":128816,"en":"A place called Budurmak appears."},{"id":"semetey-1-2013:p0678:b003:l019","ordinal":128817,"en":"From the rough heights the deer pour,"},{"id":"semetey-1-2013:p0678:b003:l020","ordinal":128818,"en":"The grass upon the heights grows sparse."},{"id":"semetey-1-2013:p0678:b003:l021","ordinal":128819,"en":"Talas, our precious land,"},{"id":"semetey-1-2013:p0678:b003:l022","ordinal":128820,"en":"Its people have vanished now;"},{"id":"semetey-1-2013:p0678:b003:l023","ordinal":128821,"en":"Now it lies alone."},{"id":"semetey-1-2013:p0678:b003:l024","ordinal":128822,"en":"When its image appears before my eyes,"},{"id":"semetey-1-2013:p0678:b003:l025","ordinal":128823,"en":"My tears pour down."},{"id":"semetey-1-2013:p0678:b003:l026","ordinal":128824,"en":"Bereft of its honored people,"},{"id":"semetey-1-2013:p0678:b003:l027","ordinal":128825,"en":"My dear Talas looks deserted."},{"id":"semetey-1-2013:p0678:b003:l029","ordinal":128826,"en":"Do not ask what Talas is like:"},{"id":"semetey-1-2013:p0678:b003:l030","ordinal":128827,"en":"Its springs brim and overflow,"},{"id":"semetey-1-2013:p0678:b003:l031","ordinal":128828,"en":"The nightingale sings sorrowfully."},{"id":"semetey-1-2013:p0678:b003:l032","ordinal":128829,"en":"No grieving person would listen;"},{"id":"semetey-1-2013:p0678:b003:l033","ordinal":128830,"en":"A mortal who turned to listen"},{"id":"semetey-1-2013:p0678:b003:l034","ordinal":128831,"en":"Would not step a handspan out of it."},{"id":"semetey-1-2013:p0678:b003:l035","ordinal":128832,"en":"This is sorrowful Talas,"},{"id":"semetey-1-2013:p0678:b003:l036","ordinal":128833,"en":"I am Bakay of these accursed days."},{"id":"semetey-1-2013:p0678:b003:l037","ordinal":128834,"en":"When its cuckoo sings from a willow,"},{"id":"semetey-1-2013:p0678:b003:l038","ordinal":128835,"en":"A grieving mortal cannot bear to listen."},{"id":"semetey-1-2013:p0678:b003:l039","ordinal":128836,"en":"A mortal who turned to listen,"},{"id":"semetey-1-2013:p0678:b004:l001","ordinal":128837,"en":"At this cuckoo's voice,"},{"id":"semetey-1-2013:p0678:b004:l002","ordinal":128838,"en":"Could not turn and walk away."},{"id":"semetey-1-2013:p0678:b004:l003","ordinal":128839,"en":"Do not ask what Talas is like:"},{"id":"semetey-1-2013:p0678:b004:l004","ordinal":128840,"en":"Its mountains have snow,"},{"id":"semetey-1-2013:p0678:b004:l005","ordinal":128841,"en":"Its forests have rooks,"},{"id":"semetey-1-2013:p0678:b004:l006","ordinal":128842,"en":"Its hills have wild sheep,"},{"id":"semetey-1-2013:p0678:b004:l007","ordinal":128843,"en":"Its rugged heights have deer,"},{"id":"semetey-1-2013:p0678:b004:l008","ordinal":128844,"en":"Its terraces have ibex,"},{"id":"semetey-1-2013:p0678:b004:l009","ordinal":128845,"en":"Its plains have wild asses,"},{"id":"semetey-1-2013:p0678:b004:l010","ordinal":128846,"en":"Its hollows have hares,"},{"id":"semetey-1-2013:p0678:b004:l011","ordinal":128847,"en":"Its depressions have snakes."},{"id":"semetey-1-2013:p0678:b004:l012","ordinal":128848,"en":"It has separate little marshes,"},{"id":"semetey-1-2013:p0678:b004:l013","ordinal":128849,"en":"It has geese flying singly,"},{"id":"semetey-1-2013:p0678:b004:l014","ordinal":128850,"en":"Their slender tails swaying,"},{"id":"semetey-1-2013:p0678:b004:l015","ordinal":128851,"en":"Their red heads bobbing."},{"id":"semetey-1-2013:p0678:b004:l016","ordinal":128852,"en":"These creatures grew at liberty,"},{"id":"semetey-1-2013:p0678:b004:l017","ordinal":128853,"en":"Its snowcocks crying out."},{"id":"semetey-1-2013:p0678:b004:l018","ordinal":128854,"en":"Beside those snowcocks,"},{"id":"semetey-1-2013:p0678:b004:l019","ordinal":128855,"en":"Had they not grown freely,"},{"id":"semetey-1-2013:p0678:b004:l020","ordinal":128856,"en":"Its plane trees too broad to embrace?"},{"id":"semetey-1-2013:p0678:b004:l021","ordinal":128857,"en":"Never until death will it be quenched,"},{"id":"semetey-1-2013:p0678:b004:l022","ordinal":128858,"en":"Bakay Khan's longing."},{"id":"semetey-1-2013:p0678:b004:l023","ordinal":128859,"en":"Its apples ripened and turned to mulch,"},{"id":"semetey-1-2013:p0678:b004:l024","ordinal":128860,"en":"Its walnuts ripened and filled the ravine."},{"id":"semetey-1-2013:p0678:b004:l025","ordinal":128861,"en":"Such was your land of Talas."},{"id":"semetey-1-2013:p0678:b004:l026","ordinal":128862,"en":"Have you seen what Talas is like,"},{"id":"semetey-1-2013:p0678:b004:l027","ordinal":128863,"en":"My dear orphan?"},{"id":"semetey-1-2013:p0678:b004:l028","ordinal":128864,"en":"Its birds laid eggs in the birches,"},{"id":"semetey-1-2013:p0678:b004:l029","ordinal":128865,"en":"And stand ready to take flight."},{"id":"semetey-1-2013:p0678:b004:l030","ordinal":128866,"en":"Its birds hatch in the poplars,"},{"id":"semetey-1-2013:p0678:b004:l031","ordinal":128867,"en":"They stir, ready to take flight."},{"id":"semetey-1-2013:p0678:b004:l032","ordinal":128868,"en":"Your Manas died long ago,"},{"id":"semetey-1-2013:p0678:b004:l033","ordinal":128869,"en":"Your Talas was left deserted.\""},{"id":"semetey-1-2013:p0678:b004:l034","ordinal":128870,"en":"Meanwhile, as Bakay Khan"},{"id":"semetey-1-2013:p0678:b004:l035","ordinal":128871,"en":"Was showing him the land,"},{"id":"semetey-1-2013:p0678:b004:l036","ordinal":128872,"en":"Dusk fell and the sun set,"},{"id":"semetey-1-2013:p0678:b004:l037","ordinal":128873,"en":"Every living creature lay still."},{"id":"semetey-1-2013:p0678:b004:l038","ordinal":128874,"en":"Then Bakay Khan and Semetey,"},{"id":"semetey-1-2013:p0678:b004:l039","ordinal":128875,"en":"Taking the white saddle for a pillow,"},{"id":"semetey-1-2013:p0679:b003:l001","ordinal":128876,"en":"With their heads toward Mecca,"},{"id":"semetey-1-2013:p0679:b003:l002","ordinal":128877,"en":"The bulletproof battle-coat"},{"id":"semetey-1-2013:p0679:b003:l003","ordinal":128878,"en":"Laid against their hips,"},{"id":"semetey-1-2013:p0679:b003:l004","ordinal":128879,"en":"They prayed to the Creator."},{"id":"semetey-1-2013:p0679:b003:l005","ordinal":128880,"en":"Resting on their elbows, they slept,"},{"id":"semetey-1-2013:p0679:b003:l006","ordinal":128881,"en":"Dozing and taking their rest."},{"id":"semetey-1-2013:p0679:b003:l007","ordinal":128882,"en":"Old Bakay, the valiant one,"},{"id":"semetey-1-2013:p0679:b003:l008","ordinal":128883,"en":"And young Semetey, the leopard,"},{"id":"semetey-1-2013:p0679:b003:l009","ordinal":128884,"en":"Fell into a giant's sleep."},{"id":"semetey-1-2013:p0679:b003:l010","ordinal":128885,"en":"When he startled awake from sleep,"},{"id":"semetey-1-2013:p0679:b003:l011","ordinal":128886,"en":"And turned onto his right side,"},{"id":"semetey-1-2013:p0679:b003:l012","ordinal":128887,"en":"Stars from the sky, one by one,"},{"id":"semetey-1-2013:p0679:b003:l013","ordinal":128888,"en":"Quivered toward Mecca."},{"id":"semetey-1-2013:p0679:b003:l014","ordinal":128889,"en":"Stars broke away overhead,"},{"id":"semetey-1-2013:p0679:b003:l015","ordinal":128890,"en":"Spilling toward Mecca."},{"id":"semetey-1-2013:p0679:b003:l016","ordinal":128891,"en":"Behind the dawn a swelling rose,"},{"id":"semetey-1-2013:p0679:b003:l017","ordinal":128892,"en":"The dawn broke, rising in a mound,"},{"id":"semetey-1-2013:p0679:b003:l018","ordinal":128893,"en":"The dawn's bright splendor appeared,"},{"id":"semetey-1-2013:p0679:b003:l019","ordinal":128894,"en":"Light spilled over the earth."},{"id":"semetey-1-2013:p0679:b003:l020","ordinal":128895,"en":"The cold dawn wind whistled,"},{"id":"semetey-1-2013:p0679:b003:l021","ordinal":128896,"en":"The reed-tops rattled,"},{"id":"semetey-1-2013:p0679:b003:l022","ordinal":128897,"en":"Young larks chirped at daybreak."},{"id":"semetey-1-2013:p0679:b003:l024","ordinal":128898,"en":"When the bright dawn advanced,"},{"id":"semetey-1-2013:p0679:b003:l025","ordinal":128899,"en":"When light reached the earth,"},{"id":"semetey-1-2013:p0679:b003:l026","ordinal":128900,"en":"Semetey sprang to his feet."},{"id":"semetey-1-2013:p0679:b003:l027","ordinal":128901,"en":"It was the hollow of Zhylgynduu,"},{"id":"semetey-1-2013:p0679:b003:l028","ordinal":128902,"en":"Kanykey's Kotormo,"},{"id":"semetey-1-2013:p0679:b003:l029","ordinal":128903,"en":"It was beside Kotormo."},{"id":"semetey-1-2013:p0679:b003:l030","ordinal":128904,"en":"Your Talas was a wondrous land,"},{"id":"semetey-1-2013:p0679:b003:l031","ordinal":128905,"en":"Things without life and living creatures"},{"id":"semetey-1-2013:p0679:b003:l032","ordinal":128906,"en":"Were all left to themselves then."},{"id":"semetey-1-2013:p0679:b003:l033","ordinal":128907,"en":"We do not know for certain if it is true:"},{"id":"semetey-1-2013:p0679:b003:l034","ordinal":128908,"en":"Much is false, much is true,"},{"id":"semetey-1-2013:p0679:b003:l035","ordinal":128909,"en":"No one has been and seen it."},{"id":"semetey-1-2013:p0679:b003:l036","ordinal":128910,"en":"Half is false, half is true,"},{"id":"semetey-1-2013:p0679:b003:l037","ordinal":128911,"en":"No one has come from beside him."},{"id":"semetey-1-2013:p0679:b003:l038","ordinal":128912,"en":"Of the fierce-maned hero whose deeds were singular"},{"id":"semetey-1-2013:p0679:b003:l039","ordinal":128913,"en":"I tell a tale for entertainment,"},{"id":"semetey-1-2013:p0679:b004:l001","ordinal":128914,"en":"To recount his deeds."},{"id":"semetey-1-2013:p0679:b004:l002","ordinal":128915,"en":"At that time, your Talas—"},{"id":"semetey-1-2013:p0679:b004:l003","ordinal":128916,"en":"No people had settled there for twelve years,"},{"id":"semetey-1-2013:p0679:b004:l004","ordinal":128917,"en":"And Talas had been left deserted."},{"id":"semetey-1-2013:p0679:b004:l005","ordinal":128918,"en":"Stags, hinds and two-year-old colts—"},{"id":"semetey-1-2013:p0679:b004:l006","ordinal":128919,"en":"These had taken possession of it."},{"id":"semetey-1-2013:p0679:b004:l007","ordinal":128920,"en":"I flirted with a dragon,"},{"id":"semetey-1-2013:p0679:b004:l008","ordinal":128921,"en":"They trampled people to death,"},{"id":"semetey-1-2013:p0679:b004:l009","ordinal":128922,"en":"Its countless wild asses."},{"id":"semetey-1-2013:p0679:b004:l010","ordinal":128923,"en":"Of Talas left alone,"},{"id":"semetey-1-2013:p0679:b004:l011","ordinal":128924,"en":"What marvels shall we tell?"},{"id":"semetey-1-2013:p0679:b004:l012","ordinal":128925,"en":"Its twigs were like plane trees,"},{"id":"semetey-1-2013:p0679:b004:l013","ordinal":128926,"en":"Its plane trees were like towers,"},{"id":"semetey-1-2013:p0679:b004:l014","ordinal":128927,"en":"Its little birds were like snowcocks."},{"id":"semetey-1-2013:p0679:b004:l015","ordinal":128928,"en":"Seeing these, Semetey"},{"id":"semetey-1-2013:p0679:b004:l016","ordinal":128929,"en":"Now turned Aktulpar's head."},{"id":"semetey-1-2013:p0679:b004:l017","ordinal":128930,"en":"Manas's son, the valiant orphan,"},{"id":"semetey-1-2013:p0679:b004:l018","ordinal":128931,"en":"Now talked of what he saw."},{"id":"semetey-1-2013:p0679:b004:l019","ordinal":128932,"en":"There were plane trees like houses,"},{"id":"semetey-1-2013:p0679:b004:l020","ordinal":128933,"en":"All around the plane trees"},{"id":"semetey-1-2013:p0679:b004:l021","ordinal":128934,"en":"Hemlock grew thick as an arm."},{"id":"semetey-1-2013:p0679:b004:l022","ordinal":128935,"en":"When its hinds startled and dashed away,"},{"id":"semetey-1-2013:p0679:b004:l023","ordinal":128936,"en":"They were like dun cows with white blazes."},{"id":"semetey-1-2013:p0679:b004:l024","ordinal":128937,"en":"There was plentiful bistort,"},{"id":"semetey-1-2013:p0679:b004:l025","ordinal":128938,"en":"Its snowcocks cried in the mountains."},{"id":"semetey-1-2013:p0679:b004:l026","ordinal":128939,"en":"These were wondrous things,"},{"id":"semetey-1-2013:p0679:b004:l027","ordinal":128940,"en":"Its plane trees growing in varied forms."},{"id":"semetey-1-2013:p0679:b004:l028","ordinal":128941,"en":"Besides its plane trees, it had willows,"},{"id":"semetey-1-2013:p0679:b004:l029","ordinal":128942,"en":"It had every true delight."},{"id":"semetey-1-2013:p0679:b004:l030","ordinal":128943,"en":"It was a deserted land,"},{"id":"semetey-1-2013:p0679:b004:l031","ordinal":128944,"en":"He was the one who entered alone."},{"id":"semetey-1-2013:p0679:b004:l032","ordinal":128945,"en":"It had willows growing on the plain,"},{"id":"semetey-1-2013:p0679:b004:l033","ordinal":128946,"en":"Still more delights were there."},{"id":"semetey-1-2013:p0679:b004:l034","ordinal":128947,"en":"Its willow-tops bent down,"},{"id":"semetey-1-2013:p0679:b004:l035","ordinal":128948,"en":"Drawing lines upon its sand."},{"id":"semetey-1-2013:p0679:b004:l036","ordinal":128949,"en":"Apples and apricots ripened and fell,"},{"id":"semetey-1-2013:p0679:b004:l037","ordinal":128950,"en":"An arshin deep by measure,"},{"id":"semetey-1-2013:p0679:b004:l038","ordinal":128951,"en":"Breaking down into dark compost."},{"id":"semetey-1-2013:p0679:b004:l039","ordinal":128952,"en":"Ah, dear living Talas,"},{"id":"semetey-1-2013:p0680:b003:l001","ordinal":128953,"en":"Was it not the choicest land?"},{"id":"semetey-1-2013:p0680:b003:l002","ordinal":128954,"en":"Would not the Kyrgyz who dwelt there prosper?"},{"id":"semetey-1-2013:p0680:b003:l003","ordinal":128955,"en":"The poor young orphan,"},{"id":"semetey-1-2013:p0680:b003:l004","ordinal":128956,"en":"Seeing his land, was filled with wonder."},{"id":"semetey-1-2013:p0680:b003:l005","ordinal":128957,"en":"Clear springs, a cool breeze—"},{"id":"semetey-1-2013:p0680:b003:l006","ordinal":128958,"en":"It was a land beside paradise,"},{"id":"semetey-1-2013:p0680:b003:l007","ordinal":128959,"en":"Abundance spilling from its ridges,"},{"id":"semetey-1-2013:p0680:b003:l008","ordinal":128960,"en":"Looking like paradise itself."},{"id":"semetey-1-2013:p0680:b003:l009","ordinal":128961,"en":"\"What a land broad Talas is!"},{"id":"semetey-1-2013:p0680:b003:l010","ordinal":128962,"en":"Who made Talas his home—"},{"id":"semetey-1-2013:p0680:b003:l011","ordinal":128963,"en":"What a hero my father was!"},{"id":"semetey-1-2013:p0680:b003:l012","ordinal":128964,"en":"That I was left fatherless"},{"id":"semetey-1-2013:p0680:b003:l013","ordinal":128965,"en":"Is a disgrace to anyone who knows."},{"id":"semetey-1-2013:p0680:b003:l014","ordinal":128966,"en":"Do not leave me with the name of orphan;"},{"id":"semetey-1-2013:p0680:b003:l015","ordinal":128967,"en":"My perfect father, take me with you!\""},{"id":"semetey-1-2013:p0680:b003:l016","ordinal":128968,"en":"Gripping his painted spear, he trembled."},{"id":"semetey-1-2013:p0680:b003:l017","ordinal":128969,"en":"Your orphan, son of the mighty beast,"},{"id":"semetey-1-2013:p0680:b003:l018","ordinal":128970,"en":"Rode weeping, shaken with sobs."},{"id":"semetey-1-2013:p0680:b003:l019","ordinal":128971,"en":"Without turning back, your uncle Bakay—"},{"id":"semetey-1-2013:p0680:b003:l020","ordinal":128972,"en":"Over pass after separate pass—"},{"id":"semetey-1-2013:p0680:b003:l021","ordinal":128973,"en":"Your matchless uncle Bakay Khan"},{"id":"semetey-1-2013:p0680:b003:l022","ordinal":128974,"en":"Went on leading the way."},{"id":"semetey-1-2013:p0680:b003:l023","ordinal":128975,"en":"If you ask of Bakay,"},{"id":"semetey-1-2013:p0680:b003:l024","ordinal":128976,"en":"Bakay Khan, the son of Bay,"},{"id":"semetey-1-2013:p0680:b003:l025","ordinal":128977,"en":"The hero was of a different kind."},{"id":"semetey-1-2013:p0680:b003:l026","ordinal":128978,"en":"He rinsed his mouth with honey,"},{"id":"semetey-1-2013:p0680:b003:l027","ordinal":128979,"en":"Wore a hat of blue-gray lynx fur,"},{"id":"semetey-1-2013:p0680:b003:l028","ordinal":128980,"en":"Wielded a blue-mottled shield."},{"id":"semetey-1-2013:p0680:b003:l029","ordinal":128981,"en":"His head adorned with all of gold,"},{"id":"semetey-1-2013:p0680:b003:l030","ordinal":128982,"en":"Rested his feet on pure gold."},{"id":"semetey-1-2013:p0680:b003:l031","ordinal":128983,"en":"Found the right words when taken unawares,"},{"id":"semetey-1-2013:p0680:b003:l032","ordinal":128984,"en":"Found a guiding eye in darkness."},{"id":"semetey-1-2013:p0680:b003:l033","ordinal":128985,"en":"A surpassing lion, truly exceptional,"},{"id":"semetey-1-2013:p0680:b003:l034","ordinal":128986,"en":"He was a true holy seer, a generous hero."},{"id":"semetey-1-2013:p0680:b003:l035","ordinal":128987,"en":"No evil word could cling to him;"},{"id":"semetey-1-2013:p0680:b003:l036","ordinal":128988,"en":"In darkness, if set upon a corsac fox's"},{"id":"semetey-1-2013:p0680:b003:l037","ordinal":128989,"en":"Trail, he would not go astray."},{"id":"semetey-1-2013:p0680:b003:l038","ordinal":128990,"en":"When he spoke, all heard him."},{"id":"semetey-1-2013:p0680:b003:l039","ordinal":128991,"en":"From Manas, who had passed away,"},{"id":"semetey-1-2013:p0680:b004:l001","ordinal":128992,"en":"This old man remained as a gift."},{"id":"semetey-1-2013:p0680:b004:l002","ordinal":128993,"en":"He girded his waist firmly."},{"id":"semetey-1-2013:p0680:b004:l003","ordinal":128994,"en":"If you ask of your uncle,"},{"id":"semetey-1-2013:p0680:b004:l004","ordinal":128995,"en":"He was born in a holy place."},{"id":"semetey-1-2013:p0680:b004:l005","ordinal":128996,"en":"Your valiant uncle Bakay—"},{"id":"semetey-1-2013:p0680:b004:l006","ordinal":128997,"en":"Those who saw his majesty were awed."},{"id":"semetey-1-2013:p0680:b004:l007","ordinal":128998,"en":"When he was a five-year-old child,"},{"id":"semetey-1-2013:p0680:b004:l008","ordinal":128999,"en":"He studied in Mecca for five years."},{"id":"semetey-1-2013:p0680:b004:l009","ordinal":129000,"en":"He received a holy seer's blessing,"},{"id":"semetey-1-2013:p0680:b004:l010","ordinal":129001,"en":"And was called Bakay the Saint."},{"id":"semetey-1-2013:p0680:b004:l011","ordinal":129002,"en":"He was a man of knowledge."},{"id":"semetey-1-2013:p0680:b004:l012","ordinal":129003,"en":"Even dead, his words would remain clear;"},{"id":"semetey-1-2013:p0680:b004:l013","ordinal":129004,"en":"While alive, he was clairvoyant."},{"id":"semetey-1-2013:p0680:b004:l014","ordinal":129005,"en":"That was Bakay the lion."},{"id":"semetey-1-2013:p0680:b004:l015","ordinal":129006,"en":"Showing the land and waters,"},{"id":"semetey-1-2013:p0680:b004:l016","ordinal":129007,"en":"Manas's orphan son"},{"id":"semetey-1-2013:p0680:b004:l017","ordinal":129008,"en":"He led along this way."},{"id":"semetey-1-2013:p0680:b004:l018","ordinal":129009,"en":"A ridge like the curve of a saddle"},{"id":"semetey-1-2013:p0680:b004:l019","ordinal":129010,"en":"Bakay came across."},{"id":"semetey-1-2013:p0680:b004:l020","ordinal":129011,"en":"When he came up onto the ridge,"},{"id":"semetey-1-2013:p0680:b004:l021","ordinal":129012,"en":"If you ask of valiant Bakay,"},{"id":"semetey-1-2013:p0680:b004:l022","ordinal":129013,"en":"He now turned Kokcholok's head,"},{"id":"semetey-1-2013:p0680:b004:l023","ordinal":129014,"en":"And stood weeping profusely:"},{"id":"semetey-1-2013:p0680:b004:l024","ordinal":129015,"en":"\"Ah, my dear orphan,"},{"id":"semetey-1-2013:p0680:b004:l025","ordinal":129016,"en":"My mind is bewildered."},{"id":"semetey-1-2013:p0680:b004:l026","ordinal":129017,"en":"This world, the merchant,"},{"id":"semetey-1-2013:p0680:b004:l027","ordinal":129018,"en":"Seems to have cheated us and gone."},{"id":"semetey-1-2013:p0680:b004:l028","ordinal":129019,"en":"When Manas, the mountain-like lion, died,"},{"id":"semetey-1-2013:p0680:b004:l029","ordinal":129020,"en":"When my hapless soul saw hell,"},{"id":"semetey-1-2013:p0680:b004:l030","ordinal":129021,"en":"When Argyn and Kyrgyz together"},{"id":"semetey-1-2013:p0680:b004:l031","ordinal":129022,"en":"Fled and migrated from Talas,"},{"id":"semetey-1-2013:p0680:b004:l032","ordinal":129023,"en":"When fierce-maned Manas, the leopard—"},{"id":"semetey-1-2013:p0680:b004:l033","ordinal":129024,"en":"The fire he had kindled went out,"}]
