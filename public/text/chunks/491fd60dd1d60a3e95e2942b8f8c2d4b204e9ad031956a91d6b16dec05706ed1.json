[{"id":"semetey-1-2013:p0939:b004:l027","ordinal":148737,"en":"They assigned to the war,"},{"id":"semetey-1-2013:p0939:b004:l028","ordinal":148738,"en":"Their mangy, saddle-galled steeds"},{"id":"semetey-1-2013:p0939:b004:l029","ordinal":148739,"en":"They rejected, saying, 'Unfit.'"},{"id":"semetey-1-2013:p0939:b004:l030","ordinal":148740,"en":"They tied up the horses' tails,"},{"id":"semetey-1-2013:p0939:b004:l031","ordinal":148741,"en":"To sweep over Oogan,"},{"id":"semetey-1-2013:p0939:b004:l032","ordinal":148742,"en":"To bring it to its end together,"},{"id":"semetey-1-2013:p0939:b004:l033","ordinal":148743,"en":"To descend upon Oogan"},{"id":"semetey-1-2013:p0939:b004:l034","ordinal":148744,"en":"And bring great turmoil."},{"id":"semetey-1-2013:p0939:b006:l001","ordinal":148745,"en":"Manas's only son—"},{"id":"semetey-1-2013:p0939:b006:l002","ordinal":148746,"en":"With Chynkojo inciting them,"},{"id":"semetey-1-2013:p0939:b006:l003","ordinal":148747,"en":"They meant to seize his wife,"},{"id":"semetey-1-2013:p0939:b006:l004","ordinal":148748,"en":"To cause havoc and disorder,"},{"id":"semetey-1-2013:p0939:b006:l005","ordinal":148749,"en":"Gracefully swaying Churok—"},{"id":"semetey-1-2013:p0939:b006:l006","ordinal":148750,"en":"To rest only after taking her as spoils."},{"id":"semetey-1-2013:p0939:b006:l007","ordinal":148751,"en":"The whole great Jediger host"},{"id":"semetey-1-2013:p0939:b006:l008","ordinal":148752,"en":"Would descend upon them;"},{"id":"semetey-1-2013:p0939:b006:l009","ordinal":148753,"en":"If Akun refused to give her,"},{"id":"semetey-1-2013:p0939:b006:l010","ordinal":148754,"en":"With an army beneath which the earth bent,"},{"id":"semetey-1-2013:p0939:b006:l011","ordinal":148755,"en":"They would come and attack."},{"id":"semetey-1-2013:p0939:b006:l012","ordinal":148756,"en":"As the Jediger assembled,"},{"id":"semetey-1-2013:p0939:b006:l013","ordinal":148757,"en":"The black-bearded hero Tolok"},{"id":"semetey-1-2013:p0939:b006:l014","ordinal":148758,"en":"Asked for a pause."},{"id":"semetey-1-2013:p0939:b006:l015","ordinal":148759,"en":"'Hero Toltoi, Chynkojo,"},{"id":"semetey-1-2013:p0939:b006:l016","ordinal":148760,"en":"You are all standing here."},{"id":"semetey-1-2013:p0939:b006:l017","ordinal":148761,"en":"Many people rich in wisdom,"},{"id":"semetey-1-2013:p0939:b006:l018","ordinal":148762,"en":"You elders are standing here."},{"id":"semetey-1-2013:p0939:b006:l019","ordinal":148763,"en":"To descend upon them would be cruel,"},{"id":"semetey-1-2013:p0939:b006:l020","ordinal":148764,"en":"To attack them would be wrong."},{"id":"semetey-1-2013:p0939:b006:l021","ordinal":148765,"en":"Gathering a great army—"},{"id":"semetey-1-2013:p0939:b006:l022","ordinal":148766,"en":"They are no Kara-Kalmak enemy—"},{"id":"semetey-1-2013:p0939:b006:l023","ordinal":148767,"en":"Fighting over a woman,"},{"id":"semetey-1-2013:p0939:b006:l024","ordinal":148768,"en":"The many people needlessly slaughtered,"},{"id":"semetey-1-2013:p0939:b006:l025","ordinal":148769,"en":"It is wrong to fall into such turmoil."},{"id":"semetey-1-2013:p0939:b006:l026","ordinal":148770,"en":"Instead, to Akun,"},{"id":"semetey-1-2013:p0939:b006:l027","ordinal":148771,"en":"A broad-jawed, broad-tongued man,"},{"id":"semetey-1-2013:p0939:b006:l028","ordinal":148772,"en":"An orator who does not falter,"},{"id":"semetey-1-2013:p0939:b006:l029","ordinal":148773,"en":"Let us send as an envoy between us."},{"id":"semetey-1-2013:p0939:b006:l030","ordinal":148774,"en":"Let us make a marriage proposal,"},{"id":"semetey-1-2013:p0939:b006:l031","ordinal":148775,"en":"Without force or humiliation,"},{"id":"semetey-1-2013:p0939:b006:l032","ordinal":148776,"en":"Let us come to friendly terms."},{"id":"semetey-1-2013:p0939:b006:l033","ordinal":148777,"en":"If Akun will listen to reason,"},{"id":"semetey-1-2013:p0939:b006:l034","ordinal":148778,"en":"If he does not begin a quarrel,"},{"id":"semetey-1-2013:p0940:b003:l001","ordinal":148779,"en":"If he will give Churok,"},{"id":"semetey-1-2013:p0940:b003:l002","ordinal":148780,"en":"Let us drive seven hundred red elephants,"},{"id":"semetey-1-2013:p0940:b003:l003","ordinal":148781,"en":"Braid each of their tails,"},{"id":"semetey-1-2013:p0940:b003:l004","ordinal":148782,"en":"And give Akun the bride-price."},{"id":"semetey-1-2013:p0940:b003:l005","ordinal":148783,"en":"Arranging the marriage and driving livestock,"},{"id":"semetey-1-2013:p0940:b003:l006","ordinal":148784,"en":"Bow to one another and chew the fat,"},{"id":"semetey-1-2013:p0940:b003:l007","ordinal":148785,"en":"Let us offer proper service,"},{"id":"semetey-1-2013:p0940:b003:l008","ordinal":148786,"en":"Let us take Akun's daughter."},{"id":"semetey-1-2013:p0940:b003:l009","ordinal":148787,"en":"Akun's daughter Aichurok—"},{"id":"semetey-1-2013:p0940:b003:l010","ordinal":148788,"en":"Let us take her on equal terms."},{"id":"semetey-1-2013:p0940:b003:l011","ordinal":148789,"en":"If we surround them,"},{"id":"semetey-1-2013:p0940:b003:l012","ordinal":148790,"en":"If we act recklessly,"},{"id":"semetey-1-2013:p0940:b003:l013","ordinal":148791,"en":"If we barely escape death"},{"id":"semetey-1-2013:p0940:b003:l014","ordinal":148792,"en":"The Oogans too are no easy people."},{"id":"semetey-1-2013:p0940:b003:l015","ordinal":148793,"en":"If we cause slaughter over a girl,"},{"id":"semetey-1-2013:p0940:b003:l016","ordinal":148794,"en":"If many of them die,"},{"id":"semetey-1-2013:p0940:b003:l017","ordinal":148795,"en":"If many of us die,"},{"id":"semetey-1-2013:p0940:b003:l018","ordinal":148796,"en":"If we slaughter one another,"},{"id":"semetey-1-2013:p0940:b003:l019","ordinal":148797,"en":"Will the girl become a wife?"},{"id":"semetey-1-2013:p0940:b003:l020","ordinal":148798,"en":"When we forcefully seize her,"},{"id":"semetey-1-2013:p0940:b003:l021","ordinal":148799,"en":"Will she be a wife to us?"},{"id":"semetey-1-2013:p0940:b003:l022","ordinal":148800,"en":"Let us send an envoy between us,"},{"id":"semetey-1-2013:p0940:b003:l023","ordinal":148801,"en":"Let us learn the facts thoroughly.'"},{"id":"semetey-1-2013:p0940:b003:l024","ordinal":148802,"en":"Chynkojo, Toltoi, and their elders"},{"id":"semetey-1-2013:p0940:b003:l025","ordinal":148803,"en":"Accepted this—"},{"id":"semetey-1-2013:p0940:b003:l026","ordinal":148804,"en":"What dear Tolok had said."},{"id":"semetey-1-2013:p0940:b003:l027","ordinal":148805,"en":"All the Jediger"},{"id":"semetey-1-2013:p0940:b003:l028","ordinal":148806,"en":"Discussed the matter together,"},{"id":"semetey-1-2013:p0940:b003:l029","ordinal":148807,"en":"And to go as a marriage envoy"},{"id":"semetey-1-2013:p0940:b003:l030","ordinal":148808,"en":"They began selecting a man."},{"id":"semetey-1-2013:p0940:b003:l031","ordinal":148809,"en":"Black-bearded Tolok"},{"id":"semetey-1-2013:p0940:b003:l032","ordinal":148810,"en":"They chose to go,"},{"id":"semetey-1-2013:p0940:b003:l033","ordinal":148811,"en":"The great Jediger host,"},{"id":"semetey-1-2013:p0940:b003:l034","ordinal":148812,"en":"To obtain news from Akun."},{"id":"semetey-1-2013:p0940:b003:l035","ordinal":148813,"en":"If you ask about Tolok,"},{"id":"semetey-1-2013:p0940:b003:l036","ordinal":148814,"en":"He was skilled at mediation,"},{"id":"semetey-1-2013:p0940:b003:l037","ordinal":148815,"en":"The eloquent one among many."},{"id":"semetey-1-2013:p0940:b003:l038","ordinal":148816,"en":"For Toltoi and his Kojo,"},{"id":"semetey-1-2013:p0940:b003:l039","ordinal":148817,"en":"Dear Tolok himself"},{"id":"semetey-1-2013:p0940:b004:l001","ordinal":148818,"en":"Was their mullah who wrote documents."},{"id":"semetey-1-2013:p0940:b004:l002","ordinal":148819,"en":"Reckoning the days,"},{"id":"semetey-1-2013:p0940:b004:l003","ordinal":148820,"en":"He put the day in the letter."},{"id":"semetey-1-2013:p0940:b004:l004","ordinal":148821,"en":"Reckoning the months,"},{"id":"semetey-1-2013:p0940:b004:l005","ordinal":148822,"en":"He recorded the year."},{"id":"semetey-1-2013:p0940:b004:l006","ordinal":148823,"en":"Tolok went as intermediary;"},{"id":"semetey-1-2013:p0940:b004:l007","ordinal":148824,"en":"The great Jediger host,"},{"id":"semetey-1-2013:p0940:b004:l008","ordinal":148825,"en":"Surging along the edge,"},{"id":"semetey-1-2013:p0940:b004:l009","ordinal":148826,"en":"Swaying over the land,"},{"id":"semetey-1-2013:p0940:b004:l010","ordinal":148827,"en":"Along the edge-road of Kum-Kyya,"},{"id":"semetey-1-2013:p0940:b004:l011","ordinal":148828,"en":"The Jediger spread out."},{"id":"semetey-1-2013:p0940:b004:l012","ordinal":148829,"en":"Indistinguishable from insects,"},{"id":"semetey-1-2013:p0940:b004:l013","ordinal":148830,"en":"The Jediger swarmed."},{"id":"semetey-1-2013:p0940:b004:l014","ordinal":148831,"en":"Along the edge-road of Tash-Kyya,"},{"id":"semetey-1-2013:p0940:b004:l015","ordinal":148832,"en":"The Jediger spread out."},{"id":"semetey-1-2013:p0940:b004:l016","ordinal":148833,"en":"Bagysh of the Jediger,"},{"id":"semetey-1-2013:p0940:b004:l017","ordinal":148834,"en":"And Bagysh's hero Toltoi,"},{"id":"semetey-1-2013:p0940:b004:l018","ordinal":148835,"en":"As huge as Opol-Too,"},{"id":"semetey-1-2013:p0940:b004:l019","ordinal":148836,"en":"With his host beneath which the earth bent."},{"id":"semetey-1-2013:p0940:b004:l020","ordinal":148837,"en":"They piled up their spears,"},{"id":"semetey-1-2013:p0940:b004:l021","ordinal":148838,"en":"Heaped guns like a mountain."},{"id":"semetey-1-2013:p0940:b004:l022","ordinal":148839,"en":"The mighty lord Chynkojo"},{"id":"semetey-1-2013:p0940:b004:l023","ordinal":148840,"en":"Made these arrangements,"},{"id":"semetey-1-2013:p0940:b004:l024","ordinal":148841,"en":"They dismounted and spread out."},{"id":"semetey-1-2013:p0940:b004:l025","ordinal":148842,"en":"They tethered the noble steeds with heads drawn high,"},{"id":"semetey-1-2013:p0940:b004:l026","ordinal":148843,"en":"Dividing into groups of six,"},{"id":"semetey-1-2013:p0940:b004:l027","ordinal":148844,"en":"They boiled their small kettles."},{"id":"semetey-1-2013:p0940:b004:l028","ordinal":148845,"en":"One mare for every twenty people,"},{"id":"semetey-1-2013:p0940:b004:l029","ordinal":148846,"en":"They slaughtered for provisions."},{"id":"semetey-1-2013:p0940:b004:l030","ordinal":148847,"en":"At each corner of the host, a hundred men,"},{"id":"semetey-1-2013:p0940:b004:l031","ordinal":148848,"en":"They posted strong guards."},{"id":"semetey-1-2013:p0940:b004:l032","ordinal":148849,"en":"Gathering and ordering the army,"},{"id":"semetey-1-2013:p0940:b004:l033","ordinal":148850,"en":"Leopard Kojo was a hero;"},{"id":"semetey-1-2013:p0940:b004:l034","ordinal":148851,"en":"'I shall take his aging daughter,' he said,"},{"id":"semetey-1-2013:p0940:b004:l035","ordinal":148852,"en":"And tightly surrounding Khan Akun,"},{"id":"semetey-1-2013:p0940:b004:l036","ordinal":148853,"en":"He was laying siege to him."},{"id":"semetey-1-2013:p0940:b004:l037","ordinal":148854,"en":"Let us leave this here,"},{"id":"semetey-1-2013:p0940:b004:l038","ordinal":148855,"en":"The envoy between them—"},{"id":"semetey-1-2013:p0940:b004:l039","ordinal":148856,"en":"Let us begin the account of Tolok."},{"id":"semetey-1-2013:p0941:b003:l001","ordinal":148857,"en":"Akun Khan's great court"},{"id":"semetey-1-2013:p0941:b003:l002","ordinal":148858,"en":"Had a strongly secured gate."},{"id":"semetey-1-2013:p0941:b003:l003","ordinal":148859,"en":"Ninety fathoms high"},{"id":"semetey-1-2013:p0941:b003:l004","ordinal":148860,"en":"Was its thick outer wall."},{"id":"semetey-1-2013:p0941:b003:l005","ordinal":148861,"en":"For a mortal to approach and enter,"},{"id":"semetey-1-2013:p0941:b003:l006","ordinal":148862,"en":"That wall was so thick"},{"id":"semetey-1-2013:p0941:b003:l007","ordinal":148863,"en":"That nine camels side by side"},{"id":"semetey-1-2013:p0941:b003:l008","ordinal":148864,"en":"Could walk freely upon it."},{"id":"semetey-1-2013:p0941:b003:l009","ordinal":148865,"en":"That Akun's"},{"id":"semetey-1-2013:p0941:b003:l010","ordinal":148866,"en":"Magnificence was very great."},{"id":"semetey-1-2013:p0941:b003:l011","ordinal":148867,"en":"The royal warrior,"},{"id":"semetey-1-2013:p0941:b003:l012","ordinal":148868,"en":"For anyone who incurred his wrath,"},{"id":"semetey-1-2013:p0941:b003:l013","ordinal":148869,"en":"Had a pit dug ready."},{"id":"semetey-1-2013:p0941:b003:l014","ordinal":148870,"en":"If Akun roused his strength,"},{"id":"semetey-1-2013:p0941:b003:l015","ordinal":148871,"en":"He had misery in store for them."},{"id":"semetey-1-2013:p0941:b003:l016","ordinal":148872,"en":"At the gate stood a tower;"},{"id":"semetey-1-2013:p0941:b003:l017","ordinal":148873,"en":"Do not ask about its wonders."},{"id":"semetey-1-2013:p0941:b003:l018","ordinal":148874,"en":"On this side of it,"},{"id":"semetey-1-2013:p0941:b003:l019","ordinal":148875,"en":"Old Akun was a khan;"},{"id":"semetey-1-2013:p0941:b003:l020","ordinal":148876,"en":"For anyone who angered him,"},{"id":"semetey-1-2013:p0941:b003:l021","ordinal":148877,"en":"Was the wife he seized by force."},{"id":"semetey-1-2013:p0941:b003:l022","ordinal":148878,"en":"On this side of that,"},{"id":"semetey-1-2013:p0941:b003:l023","ordinal":148879,"en":"So that people could not pass to and fro,"},{"id":"semetey-1-2013:p0941:b003:l024","ordinal":148880,"en":"He had made a wooden channel."},{"id":"semetey-1-2013:p0941:b003:l025","ordinal":148881,"en":"'Give us your aging daughter!'"},{"id":"semetey-1-2013:p0941:b003:l026","ordinal":148882,"en":"Many giants had made that demand;"},{"id":"semetey-1-2013:p0941:b003:l027","ordinal":148883,"en":"Even then, Akun"},{"id":"semetey-1-2013:p0941:b003:l028","ordinal":148884,"en":"Had kept his own head safe."},{"id":"semetey-1-2013:p0941:b003:l029","ordinal":148885,"en":"There were guards at his gate,"},{"id":"semetey-1-2013:p0941:b003:l030","ordinal":148886,"en":"A thousand champions outside,"},{"id":"semetey-1-2013:p0941:b003:l031","ordinal":148887,"en":"Who watched over Akun."},{"id":"semetey-1-2013:p0941:b003:l032","ordinal":148888,"en":"His champions were extraordinary,"},{"id":"semetey-1-2013:p0941:b003:l033","ordinal":148889,"en":"Every one a tiger, an outstanding hero."},{"id":"semetey-1-2013:p0941:b003:l034","ordinal":148890,"en":"All had swift riding horses,"},{"id":"semetey-1-2013:p0941:b003:l035","ordinal":148891,"en":"And wise Akun was their khan."},{"id":"semetey-1-2013:p0941:b003:l036","ordinal":148892,"en":"If you looked at his champions,"},{"id":"semetey-1-2013:p0941:b003:l037","ordinal":148893,"en":"Each single champion"},{"id":"semetey-1-2013:p0941:b003:l038","ordinal":148894,"en":"Had the strength of a thousand."},{"id":"semetey-1-2013:p0941:b003:l039","ordinal":148895,"en":"At the entrance to his door,"},{"id":"semetey-1-2013:p0941:b004:l001","ordinal":148896,"en":"His keepers were exceptional."},{"id":"semetey-1-2013:p0941:b004:l002","ordinal":148897,"en":"At the threshold was a bell;"},{"id":"semetey-1-2013:p0941:b004:l003","ordinal":148898,"en":"If that bell was struck,"},{"id":"semetey-1-2013:p0941:b004:l004","ordinal":148899,"en":"They would not spare a living soul."},{"id":"semetey-1-2013:p0941:b004:l005","ordinal":148900,"en":"The guards beyond it,"},{"id":"semetey-1-2013:p0941:b004:l006","ordinal":148901,"en":"When they suddenly attacked,"},{"id":"semetey-1-2013:p0941:b004:l007","ordinal":148902,"en":"Sprang like lions."},{"id":"semetey-1-2013:p0941:b004:l008","ordinal":148903,"en":"Human noses and ears"},{"id":"semetey-1-2013:p0941:b004:l009","ordinal":148904,"en":"They wore as amulets;"},{"id":"semetey-1-2013:p0941:b004:l010","ordinal":148905,"en":"Such guards he also had."},{"id":"semetey-1-2013:p0941:b004:l011","ordinal":148906,"en":"On one side of the door"},{"id":"semetey-1-2013:p0941:b004:l012","ordinal":148907,"en":"He had a sword-trunked elephant."},{"id":"semetey-1-2013:p0941:b004:l013","ordinal":148908,"en":"Toltoi, who meant to take a wife—"},{"id":"semetey-1-2013:p0941:b004:l014","ordinal":148909,"en":"Understand what a formidable man he faced."},{"id":"semetey-1-2013:p0941:b004:l015","ordinal":148910,"en":"Beyond that"},{"id":"semetey-1-2013:p0941:b004:l016","ordinal":148911,"en":"Was his garden of great plane trees,"},{"id":"semetey-1-2013:p0941:b004:l017","ordinal":148912,"en":"And he had a talking bird."},{"id":"semetey-1-2013:p0941:b004:l018","ordinal":148913,"en":"When one passed beyond the garden,"},{"id":"semetey-1-2013:p0941:b004:l019","ordinal":148914,"en":"The dear champion Akun"},{"id":"semetey-1-2013:p0941:b004:l020","ordinal":148915,"en":"Had a throne upon which he sat."},{"id":"semetey-1-2013:p0941:b004:l021","ordinal":148916,"en":"The throne was bordered by a plane-tree garden;"},{"id":"semetey-1-2013:p0941:b004:l022","ordinal":148917,"en":"In its midst stood a golden throne."},{"id":"semetey-1-2013:p0941:b004:l023","ordinal":148918,"en":"I was not walking,"},{"id":"semetey-1-2013:p0941:b004:l024","ordinal":148919,"en":"Those who saw it were astonished."},{"id":"semetey-1-2013:p0941:b004:l025","ordinal":148920,"en":"When he saw these wonders,"},{"id":"semetey-1-2013:p0941:b004:l026","ordinal":148921,"en":"Tolok's mind was troubled."},{"id":"semetey-1-2013:p0941:b004:l027","ordinal":148922,"en":"That palace of Akun Khan"},{"id":"semetey-1-2013:p0941:b004:l028","ordinal":148923,"en":"Appeared like paradise."},{"id":"semetey-1-2013:p0941:b004:l029","ordinal":148924,"en":"Held out their swords,"},{"id":"semetey-1-2013:p0941:b004:l030","ordinal":148925,"en":"He had mighty men as well."},{"id":"semetey-1-2013:p0941:b004:l031","ordinal":148926,"en":"Leaning upon their battle-axes,"},{"id":"semetey-1-2013:p0941:b004:l032","ordinal":148927,"en":"Other people came into view."},{"id":"semetey-1-2013:p0941:b004:l033","ordinal":148928,"en":"Their necks hunched,"},{"id":"semetey-1-2013:p0941:b004:l034","ordinal":148929,"en":"His marksmen came into view."},{"id":"semetey-1-2013:p0941:b004:l035","ordinal":148930,"en":"'Anyone who faces them will not survive,'"},{"id":"semetey-1-2013:p0941:b004:l036","ordinal":148931,"en":"Tolok thought, his mind troubled."},{"id":"semetey-1-2013:p0941:b004:l037","ordinal":148932,"en":"Four or five champions surrounded Tolok,"},{"id":"semetey-1-2013:p0941:b004:l038","ordinal":148933,"en":"And toward Akun"},{"id":"semetey-1-2013:p0941:b004:l039","ordinal":148934,"en":"They seemed to drive him."},{"id":"semetey-1-2013:p0942:b003:l001","ordinal":148935,"en":"When they drove him before Akun,"},{"id":"semetey-1-2013:p0942:b003:l002","ordinal":148936,"en":"If you ask about Akun,"},{"id":"semetey-1-2013:p0942:b003:l003","ordinal":148937,"en":"His imposing form and majesty,"},{"id":"semetey-1-2013:p0942:b003:l004","ordinal":148938,"en":"His appearance seated upon the throne,"},{"id":"semetey-1-2013:p0942:b003:l005","ordinal":148939,"en":"Troubled the heart to behold;"},{"id":"semetey-1-2013:p0942:b003:l006","ordinal":148940,"en":"He looked quite extraordinary."},{"id":"semetey-1-2013:p0942:b003:l007","ordinal":148941,"en":"Do not ask about Akun:"},{"id":"semetey-1-2013:p0942:b003:l008","ordinal":148942,"en":"His white turban was an armful,"},{"id":"semetey-1-2013:p0942:b003:l009","ordinal":148943,"en":"He bore the appearance of a khoja."},{"id":"semetey-1-2013:p0942:b003:l010","ordinal":148944,"en":"Qurans as large as a horse's head,"},{"id":"semetey-1-2013:p0942:b003:l011","ordinal":148945,"en":"Sixty lay spread out."},{"id":"semetey-1-2013:p0942:b003:l012","ordinal":148946,"en":"He bore the appearance of a mullah."},{"id":"semetey-1-2013:p0942:b003:l013","ordinal":148947,"en":"With his white beard flowing,"},{"id":"semetey-1-2013:p0942:b003:l014","ordinal":148948,"en":"He bore the appearance of a learned scholar,"},{"id":"semetey-1-2013:p0942:b003:l015","ordinal":148949,"en":"Who understood the language of the Haftiyak."},{"id":"semetey-1-2013:p0942:b003:l016","ordinal":148950,"en":"In his youth, Khan Akun"},{"id":"semetey-1-2013:p0942:b003:l017","ordinal":148951,"en":"Had built a house upon the grassy heights."},{"id":"semetey-1-2013:p0942:b003:l018","ordinal":148952,"en":"That Tolok was a bearded old man;"},{"id":"semetey-1-2013:p0942:b003:l019","ordinal":148953,"en":"The elder and Akun too"},{"id":"semetey-1-2013:p0942:b003:l020","ordinal":148954,"en":"Had many stories to tell."},{"id":"semetey-1-2013:p0942:b003:l021","ordinal":148955,"en":"Black-bearded Tolok of the Jediger,"},{"id":"semetey-1-2013:p0942:b003:l022","ordinal":148956,"en":"When he came as envoy,"},{"id":"semetey-1-2013:p0942:b003:l023","ordinal":148957,"en":"With his white beard shining,"},{"id":"semetey-1-2013:p0942:b003:l024","ordinal":148958,"en":"Calling like a migrating goose,"},{"id":"semetey-1-2013:p0942:b003:l025","ordinal":148959,"en":"Akun spoke these words:"},{"id":"semetey-1-2013:p0942:b003:l026","ordinal":148960,"en":"'With your weapons readied,"},{"id":"semetey-1-2013:p0942:b003:l027","ordinal":148961,"en":"Your sword fastened close,"},{"id":"semetey-1-2013:p0942:b003:l028","ordinal":148962,"en":"Who are you, sidling forward?"},{"id":"semetey-1-2013:p0942:b003:l029","ordinal":148963,"en":"State your battle cry, state your purpose!"},{"id":"semetey-1-2013:p0942:b003:l030","ordinal":148964,"en":"Name your lineage, name your people!"},{"id":"semetey-1-2013:p0942:b003:l031","ordinal":148965,"en":"Say whether you come as friend or foe!"},{"id":"semetey-1-2013:p0942:b003:l032","ordinal":148966,"en":"Against this Akun's fortress,"},{"id":"semetey-1-2013:p0942:b003:l033","ordinal":148967,"en":"Why have you charged?"},{"id":"semetey-1-2013:p0942:b003:l034","ordinal":148968,"en":"Whom did you seek?"},{"id":"semetey-1-2013:p0942:b003:l035","ordinal":148969,"en":"Why have you charged?"},{"id":"semetey-1-2013:p0942:b003:l036","ordinal":148970,"en":"Whom did you mean to fight?"},{"id":"semetey-1-2013:p0942:b003:l037","ordinal":148971,"en":"Tell me your words, my child,'"},{"id":"semetey-1-2013:p0942:b003:l038","ordinal":148972,"en":"Akun said this."},{"id":"semetey-1-2013:p0942:b003:l039","ordinal":148973,"en":"Without speaking or uttering a word,"},{"id":"semetey-1-2013:p0942:b004:l001","ordinal":148974,"en":"He now saw his wrath."},{"id":"semetey-1-2013:p0942:b004:l002","ordinal":148975,"en":"The letter in his belt-pouch"},{"id":"semetey-1-2013:p0942:b004:l003","ordinal":148976,"en":"He snatched out in confusion,"},{"id":"semetey-1-2013:p0942:b004:l004","ordinal":148977,"en":"And handed it to Akun Khan."},{"id":"semetey-1-2013:p0942:b004:l005","ordinal":148978,"en":"'I am a guide between the sides,"},{"id":"semetey-1-2013:p0942:b004:l006","ordinal":148979,"en":"An envoy who has come between them,"},{"id":"semetey-1-2013:p0942:b004:l007","ordinal":148980,"en":"The Balance stars had set."},{"id":"semetey-1-2013:p0942:b004:l008","ordinal":148981,"en":"One of the mediators."},{"id":"semetey-1-2013:p0942:b004:l009","ordinal":148982,"en":"There are terms to what I must say;"},{"id":"semetey-1-2013:p0942:b004:l010","ordinal":148983,"en":"I have brought before you"},{"id":"semetey-1-2013:p0942:b004:l011","ordinal":148984,"en":"A letter from Chynkojo and Toltoi.'"},{"id":"semetey-1-2013:p0942:b004:l012","ordinal":148985,"en":"When he read the letter,"},{"id":"semetey-1-2013:p0942:b004:l013","ordinal":148986,"en":"Dear Kojo's name was there."},{"id":"semetey-1-2013:p0942:b004:l014","ordinal":148987,"en":"When he read the letter,"},{"id":"semetey-1-2013:p0942:b004:l015","ordinal":148988,"en":"Its words were dreadful:"},{"id":"semetey-1-2013:p0942:b004:l016","ordinal":148989,"en":"'Let him give Aichurok,' it said."},{"id":"semetey-1-2013:p0942:b004:l017","ordinal":148990,"en":"All the Oogan khans"},{"id":"semetey-1-2013:p0942:b004:l018","ordinal":148991,"en":"They had surrounded."},{"id":"semetey-1-2013:p0942:b004:l019","ordinal":148992,"en":"If you contend with them, among them"}]
