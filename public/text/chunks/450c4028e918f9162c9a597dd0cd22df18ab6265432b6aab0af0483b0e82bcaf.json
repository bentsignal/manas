[{"id":"semetey-1-2013:p0951:b004:l028","ordinal":148737,"en":"To examine his gigantic stature,"},{"id":"semetey-1-2013:p0951:b004:l029","ordinal":148738,"en":"She reached the place where he had dismounted."},{"id":"semetey-1-2013:p0951:b004:l030","ordinal":148739,"en":"The measure of his footprints,"},{"id":"semetey-1-2013:p0951:b004:l031","ordinal":148740,"en":"Formidable Churok now took."},{"id":"semetey-1-2013:p0951:b004:l032","ordinal":148741,"en":"His footprint in the sand,"},{"id":"semetey-1-2013:p0951:b004:l033","ordinal":148742,"en":"When Aichurok measured it,"},{"id":"semetey-1-2013:p0951:b004:l035","ordinal":148743,"en":"'My saintly father-in-law—","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0951:b004:l036","ordinal":148744,"en":"No wonder this man could kill him."},{"id":"semetey-1-2013:p0951:b004:l037","ordinal":148745,"en":"For the great Chinese and Manchu host,"},{"id":"semetey-1-2013:p0951:b004:l038","ordinal":148746,"en":"No wonder he became a fortress."},{"id":"semetey-1-2013:p0951:b004:l039","ordinal":148747,"en":"Now approaching ninety-five,"},{"id":"semetey-1-2013:p0952:b003:l001","ordinal":148748,"en":"That was the age he had reached."},{"id":"semetey-1-2013:p0952:b003:l002","ordinal":148749,"en":"His prowess gone, stooping,"},{"id":"semetey-1-2013:p0952:b003:l003","ordinal":148750,"en":"He had grown old."},{"id":"semetey-1-2013:p0952:b003:l004","ordinal":148751,"en":"Between twenty-five and thirty-five,"},{"id":"semetey-1-2013:p0952:b003:l005","ordinal":148752,"en":"Had I met him then,"},{"id":"semetey-1-2013:p0952:b003:l006","ordinal":148753,"en":"He would have been a man to marry."},{"id":"semetey-1-2013:p0952:b003:l007","ordinal":148754,"en":"His sharpness gone, the poor man"},{"id":"semetey-1-2013:p0952:b003:l008","ordinal":148755,"en":"Was no longer what he had been."},{"id":"semetey-1-2013:p0952:b003:l009","ordinal":148756,"en":"Much had ebbed from the Manchu;"},{"id":"semetey-1-2013:p0952:b003:l010","ordinal":148757,"en":"His beard was now gray-mottled."},{"id":"semetey-1-2013:p0952:b003:l011","ordinal":148758,"en":"High-browed, fierce of temper,"},{"id":"semetey-1-2013:p0952:b003:l012","ordinal":148759,"en":"In his youth this Kalcha"},{"id":"semetey-1-2013:p0952:b003:l013","ordinal":148760,"en":"Had possessed great valor."},{"id":"semetey-1-2013:p0952:b003:l014","ordinal":148761,"en":"High-browed, fierce of temper,"},{"id":"semetey-1-2013:p0952:b003:l015","ordinal":148762,"en":"He leveled anyone who challenged him."},{"id":"semetey-1-2013:p0952:b003:l016","ordinal":148763,"en":"Thick-armed, stone-hearted,"},{"id":"semetey-1-2013:p0952:b003:l017","ordinal":148764,"en":"An elephant-built brute."},{"id":"semetey-1-2013:p0952:b003:l018","ordinal":148765,"en":"Imposing in appearance, fierce of temper,"},{"id":"semetey-1-2013:p0952:b003:l019","ordinal":148766,"en":"Those who saw him were amazed."},{"id":"semetey-1-2013:p0952:b003:l020","ordinal":148767,"en":"In his youth, Kongurbai,"},{"id":"semetey-1-2013:p0952:b003:l022","ordinal":148768,"en":"His eyes like hollows in a lake,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0952:b003:l023","ordinal":148769,"en":"Seeming to swallow whatever he saw,"},{"id":"semetey-1-2013:p0952:b003:l024","ordinal":148770,"en":"His brow like the bed of a ravine,"},{"id":"semetey-1-2013:p0952:b003:l025","ordinal":148771,"en":"Seeming to suck in anyone who charged him."},{"id":"semetey-1-2013:p0952:b003:l026","ordinal":148772,"en":"As he rode along,"},{"id":"semetey-1-2013:p0952:b003:l027","ordinal":148773,"en":"The lower ends of his stirrup leathers flapped,"},{"id":"semetey-1-2013:p0952:b003:l028","ordinal":148774,"en":"His forelock turned behind him"},{"id":"semetey-1-2013:p0952:b003:l029","ordinal":148775,"en":"Swung on his back like a mallet."},{"id":"semetey-1-2013:p0952:b003:l030","ordinal":148776,"en":"He was a man of tremendous vigor."},{"id":"semetey-1-2013:p0952:b003:l031","ordinal":148777,"en":"However much an infidel,"},{"id":"semetey-1-2013:p0952:b003:l032","ordinal":148778,"en":"He had a protector."},{"id":"semetey-1-2013:p0952:b003:l033","ordinal":148779,"en":"His right shoulder was broad,"},{"id":"semetey-1-2013:p0952:b003:l034","ordinal":148780,"en":"He was a lion equal to the world."},{"id":"semetey-1-2013:p0952:b003:l035","ordinal":148781,"en":"All his twelve bodily parts were sound."},{"id":"semetey-1-2013:p0952:b003:l036","ordinal":148782,"en":"My father-in-law, gone to the other world—"},{"id":"semetey-1-2013:p0952:b003:l037","ordinal":148783,"en":"No wonder this man cut him down."},{"id":"semetey-1-2013:p0952:b003:l038","ordinal":148784,"en":"The Chinese red dress,"},{"id":"semetey-1-2013:p0952:b003:l039","ordinal":148785,"en":"He would be a man for whom to wear it,"},{"id":"semetey-1-2013:p0952:b004:l001","ordinal":148786,"en":"To sport joyfully with the Kalcha,"},{"id":"semetey-1-2013:p0952:b004:l002","ordinal":148787,"en":"Were it not for his being Chinese,"},{"id":"semetey-1-2013:p0952:b004:l003","ordinal":148788,"en":"He would be a man to marry.'"},{"id":"semetey-1-2013:p0952:b004:l004","ordinal":148789,"en":"Your infidel girl, seeking a hero,"},{"id":"semetey-1-2013:p0952:b004:l005","ordinal":148790,"en":"Liked the Kalcha greatly."},{"id":"semetey-1-2013:p0952:b004:l006","ordinal":148791,"en":"Having traveled among so many,"},{"id":"semetey-1-2013:p0952:b004:l007","ordinal":148792,"en":"Were it not for his unbelief,"},{"id":"semetey-1-2013:p0952:b004:l008","ordinal":148793,"en":"She liked the Kalcha very much."},{"id":"semetey-1-2013:p0952:b004:l009","ordinal":148794,"en":"'He has reached his dotage,"},{"id":"semetey-1-2013:p0952:b004:l010","ordinal":148795,"en":"He has grown old,' she thought,"},{"id":"semetey-1-2013:p0952:b004:l011","ordinal":148796,"en":"Liking the hero greatly,"},{"id":"semetey-1-2013:p0952:b004:l012","ordinal":148797,"en":"The champion Kongurbai."},{"id":"semetey-1-2013:p0952:b004:l013","ordinal":148798,"en":"Taking the form of a gray lark, she sped,"},{"id":"semetey-1-2013:p0952:b004:l014","ordinal":148799,"en":"Delighted by his lionlike prowess."},{"id":"semetey-1-2013:p0952:b004:l015","ordinal":148800,"en":"Your dear sister-in-law drew near."},{"id":"semetey-1-2013:p0952:b004:l016","ordinal":148801,"en":"When she came closer,"},{"id":"semetey-1-2013:p0952:b004:l017","ordinal":148802,"en":"With a cotton sash and broad boots,"},{"id":"semetey-1-2013:p0952:b004:l018","ordinal":148803,"en":"Kongurbai, khan of the monks,"},{"id":"semetey-1-2013:p0952:b004:l020","ordinal":148804,"en":"A surpassing judge and a warrior,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0952:b004:l021","ordinal":148805,"en":"Kongurbai was among the cunning."},{"id":"semetey-1-2013:p0952:b004:l022","ordinal":148806,"en":"Looking and staring, Kongurbai"},{"id":"semetey-1-2013:p0952:b004:l023","ordinal":148807,"en":"Recognized her supernatural nature."},{"id":"semetey-1-2013:p0952:b004:l024","ordinal":148808,"en":"She was a female human being;"},{"id":"semetey-1-2013:p0952:b004:l025","ordinal":148809,"en":"He recognized that she was a woman."},{"id":"semetey-1-2013:p0952:b004:l026","ordinal":148810,"en":"That magically skilled, dear Churok,"},{"id":"semetey-1-2013:p0952:b004:l027","ordinal":148811,"en":"Roaming the world in a long search,"},{"id":"semetey-1-2013:p0952:b004:l028","ordinal":148812,"en":"He knew she had traversed it."},{"id":"semetey-1-2013:p0952:b004:l029","ordinal":148813,"en":"A powerful sorceress, a crafty one,"},{"id":"semetey-1-2013:p0952:b004:l030","ordinal":148814,"en":"He knew she was a skilled woman."},{"id":"semetey-1-2013:p0952:b004:l031","ordinal":148815,"en":"Seeking a husband, stirred with longing,"},{"id":"semetey-1-2013:p0952:b004:l032","ordinal":148816,"en":"He knew she was a maiden."},{"id":"semetey-1-2013:p0952:b004:l033","ordinal":148817,"en":"'That one up in the sky,"},{"id":"semetey-1-2013:p0952:b004:l034","ordinal":148818,"en":"Let me bring great torment upon her,"},{"id":"semetey-1-2013:p0952:b004:l035","ordinal":148819,"en":"Shoot and take her captive,"},{"id":"semetey-1-2013:p0952:b004:l036","ordinal":148820,"en":"And make her my bride.'"},{"id":"semetey-1-2013:p0952:b004:l037","ordinal":148821,"en":"A skilled, knowledgeable fellow,"},{"id":"semetey-1-2013:p0952:b004:l038","ordinal":148822,"en":"An experienced fellow who knew the enemy's stratagems,"},{"id":"semetey-1-2013:p0953:b003:l001","ordinal":148823,"en":"Kongurbai, the cunning one,"},{"id":"semetey-1-2013:p0953:b003:l002","ordinal":148824,"en":"Churok flying above,"},{"id":"semetey-1-2013:p0953:b003:l003","ordinal":148825,"en":"Upon Churok herself,"},{"id":"semetey-1-2013:p0953:b003:l004","ordinal":148826,"en":"Kongurbai, son of Alooko,"},{"id":"semetey-1-2013:p0953:b003:l005","ordinal":148827,"en":"Now brought an onslaught."},{"id":"semetey-1-2013:p0953:b003:l006","ordinal":148828,"en":"The ochogor gun in his hand,"},{"id":"semetey-1-2013:p0953:b003:l007","ordinal":148829,"en":"Do not ask about its nature,"},{"id":"semetey-1-2013:p0953:b003:l008","ordinal":148830,"en":"His hammer gun fired swiftly,"},{"id":"semetey-1-2013:p0953:b003:l009","ordinal":148831,"en":"He now took to firing thunderously."},{"id":"semetey-1-2013:p0953:b003:l010","ordinal":148832,"en":"When she saw this ferocity,"},{"id":"semetey-1-2013:p0953:b003:l011","ordinal":148833,"en":"Her fly-like soul cried out,"},{"id":"semetey-1-2013:p0953:b003:l012","ordinal":148834,"en":"Her every bone seemed to shatter."},{"id":"semetey-1-2013:p0953:b003:l013","ordinal":148835,"en":"Khan Akun's Aichurok"},{"id":"semetey-1-2013:p0953:b003:l014","ordinal":148836,"en":"Turned back at once."},{"id":"semetey-1-2013:p0953:b003:l015","ordinal":148837,"en":"Fleeing for her life, Aichurok"},{"id":"semetey-1-2013:p0953:b003:l016","ordinal":148838,"en":"Flew away at speed."},{"id":"semetey-1-2013:p0953:b003:l017","ordinal":148839,"en":"The shot issuing from the ochogor"},{"id":"semetey-1-2013:p0953:b003:l018","ordinal":148840,"en":"Whistled, cutting at her wings."},{"id":"semetey-1-2013:p0953:b003:l019","ordinal":148841,"en":"With no thought but God,"},{"id":"semetey-1-2013:p0953:b003:l020","ordinal":148842,"en":"What could dear Churok do?"},{"id":"semetey-1-2013:p0953:b003:l021","ordinal":148843,"en":"She fled in haste."},{"id":"semetey-1-2013:p0953:b003:l022","ordinal":148844,"en":"Kongurbai, son of Alooko,"},{"id":"semetey-1-2013:p0953:b003:l023","ordinal":148845,"en":"Roused tremendous vigor."},{"id":"semetey-1-2013:p0953:b003:l024","ordinal":148846,"en":"When he saw Aichurok,"},{"id":"semetey-1-2013:p0953:b003:l025","ordinal":148847,"en":"What did dear Kalcha do?"},{"id":"semetey-1-2013:p0953:b003:l026","ordinal":148848,"en":"He became fifteen once again."},{"id":"semetey-1-2013:p0953:b003:l027","ordinal":148849,"en":"'Burku, burku, burku!'"},{"id":"semetey-1-2013:p0953:b003:l028","ordinal":148850,"en":"Kongurbai cried, 'Burku!'"},{"id":"semetey-1-2013:p0953:b003:l029","ordinal":148851,"en":"'Burku' was the name of his god."},{"id":"semetey-1-2013:p0953:b003:l030","ordinal":148852,"en":"'Mondu, mondu, mondu!'"},{"id":"semetey-1-2013:p0953:b003:l031","ordinal":148853,"en":"Kongurbai cried, 'Mondu!'"},{"id":"semetey-1-2013:p0953:b003:l032","ordinal":148854,"en":"'Mondu' was his battle cry."},{"id":"semetey-1-2013:p0953:b003:l033","ordinal":148855,"en":"How could Kalcha fail to rouse himself?"},{"id":"semetey-1-2013:p0953:b003:l034","ordinal":148856,"en":"That infidel's Algara,"},{"id":"semetey-1-2013:p0953:b003:l036","ordinal":148857,"en":"Unless it were a flying bird,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0953:b003:l037","ordinal":148858,"en":"No four-footed beast could catch him."},{"id":"semetey-1-2013:p0953:b003:l038","ordinal":148859,"en":"That madman's Algara,"},{"id":"semetey-1-2013:p0953:b003:l039","ordinal":148860,"en":"If he pursued a wild ass, would not let it escape."},{"id":"semetey-1-2013:p0953:b005:l001","ordinal":148861,"en":"Crossing a forty-day desert,"},{"id":"semetey-1-2013:p0953:b005:l002","ordinal":148862,"en":"He was practiced in running."},{"id":"semetey-1-2013:p0953:b005:l003","ordinal":148863,"en":"That madman's Algara,"},{"id":"semetey-1-2013:p0953:b005:l005","ordinal":148864,"en":"Drew near to winged creatures.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0953:b005:l006","ordinal":148865,"en":"Kongurbai's black horse,"},{"id":"semetey-1-2013:p0953:b005:l007","ordinal":148866,"en":"His black horse had"},{"id":"semetey-1-2013:p0953:b005:l008","ordinal":148867,"en":"Wings upon his flanks."},{"id":"semetey-1-2013:p0953:b005:l009","ordinal":148868,"en":"Even over a forty-day desert,"},{"id":"semetey-1-2013:p0953:b005:l010","ordinal":148869,"en":"Where living creatures panted,"},{"id":"semetey-1-2013:p0953:b005:l011","ordinal":148870,"en":"A desert where they died of thirst,"},{"id":"semetey-1-2013:p0953:b005:l012","ordinal":148871,"en":"He was accustomed to run and endure."},{"id":"semetey-1-2013:p0953:b005:l013","ordinal":148872,"en":"He never misplaced a single step."},{"id":"semetey-1-2013:p0953:b005:l014","ordinal":148873,"en":"No wild sheep could escape before him"},{"id":"semetey-1-2013:p0953:b005:l015","ordinal":148874,"en":"And flee up into the hills."},{"id":"semetey-1-2013:p0953:b005:l016","ordinal":148875,"en":"Such was his sure-footedness,"},{"id":"semetey-1-2013:p0953:b005:l017","ordinal":148876,"en":"He never slipped from a height."},{"id":"semetey-1-2013:p0953:b005:l018","ordinal":148877,"en":"If he traveled in darkness,"},{"id":"semetey-1-2013:p0953:b005:l019","ordinal":148878,"en":"The creature's skill"},{"id":"semetey-1-2013:p0953:b005:l020","ordinal":148879,"en":"Was so much greater"},{"id":"semetey-1-2013:p0953:b005:l021","ordinal":148880,"en":"Than a wild goat's upon the cliffs."},{"id":"semetey-1-2013:p0953:b005:l022","ordinal":148881,"en":"When he saw Aichurok,"},{"id":"semetey-1-2013:p0953:b005:l023","ordinal":148882,"en":"That maddened Chinese, Kongurbai,"},{"id":"semetey-1-2013:p0953:b005:l024","ordinal":148883,"en":"Slung on his jazaiyl gun,"},{"id":"semetey-1-2013:p0953:b005:l025","ordinal":148884,"en":"Struck Algara once upon the thigh,"},{"id":"semetey-1-2013:p0953:b005:l026","ordinal":148885,"en":"Your khan charged forward,"},{"id":"semetey-1-2013:p0953:b005:l027","ordinal":148886,"en":"Attacking Aichurok,"},{"id":"semetey-1-2013:p0953:b005:l028","ordinal":148887,"en":"To seize her somehow."},{"id":"semetey-1-2013:p0953:b005:l029","ordinal":148888,"en":"If Aichurok fell into his hands,"},{"id":"semetey-1-2013:p0953:b005:l030","ordinal":148889,"en":"He would make her his bride."},{"id":"semetey-1-2013:p0953:b005:l031","ordinal":148890,"en":"'Oh, mighty Tungsha and Bakburchun,"},{"id":"semetey-1-2013:p0953:b005:l032","ordinal":148891,"en":"The great city of Kakan-Chyn,"},{"id":"semetey-1-2013:p0953:b005:l033","ordinal":148892,"en":"I have traveled among these peoples."},{"id":"semetey-1-2013:p0953:b005:l034","ordinal":148893,"en":"Having visited them all,"},{"id":"semetey-1-2013:p0953:b005:l035","ordinal":148894,"en":"I have never seen such a female,"},{"id":"semetey-1-2013:p0953:b005:l037","ordinal":148895,"en":"You were a noble steed, Algara;","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0953:b005:l038","ordinal":148896,"en":"Lower your head to the ground,"},{"id":"semetey-1-2013:p0953:b005:l039","ordinal":148897,"en":"Truly lengthen your stride."},{"id":"semetey-1-2013:p0954:b003:l001","ordinal":148898,"en":"Chasing her four times around the world,"},{"id":"semetey-1-2013:p0954:b003:l002","ordinal":148899,"en":"The five corners of Medina,"},{"id":"semetey-1-2013:p0954:b003:l003","ordinal":148900,"en":"Chasing her five times around them,"},{"id":"semetey-1-2013:p0954:b003:l004","ordinal":148901,"en":"Let me capture the sorceress."},{"id":"semetey-1-2013:p0954:b003:l005","ordinal":148902,"en":"To the kakan khan of Beijing,"},{"id":"semetey-1-2013:p0954:b003:l006","ordinal":148903,"en":"'I have captured a supernatural maiden,'"},{"id":"semetey-1-2013:p0954:b003:l007","ordinal":148904,"en":"Let me go announcing the glad news.'"},{"id":"semetey-1-2013:p0954:b003:l008","ordinal":148905,"en":"Rousing his strength and whipping his horse,"},{"id":"semetey-1-2013:p0954:b003:l009","ordinal":148906,"en":"He went pursuing Churok."},{"id":"semetey-1-2013:p0954:b003:l010","ordinal":148907,"en":"Gliding above him,"},{"id":"semetey-1-2013:p0954:b003:l011","ordinal":148908,"en":"What could dear Churok do?"},{"id":"semetey-1-2013:p0954:b003:l012","ordinal":148909,"en":"She kept flying away."},{"id":"semetey-1-2013:p0954:b003:l013","ordinal":148910,"en":"Behind her came Kongurbai,"},{"id":"semetey-1-2013:p0954:b003:l014","ordinal":148911,"en":"Practiced in every kind of deed,"},{"id":"semetey-1-2013:p0954:b003:l015","ordinal":148912,"en":"Oh, that skilled swine!"},{"id":"semetey-1-2013:p0954:b003:l016","ordinal":148913,"en":"Churok soared, swift as a mirage,"},{"id":"semetey-1-2013:p0954:b003:l017","ordinal":148914,"en":"Kongurbai, whose horse was swift,"},{"id":"semetey-1-2013:p0954:b003:l018","ordinal":148915,"en":"Drew level with her."},{"id":"semetey-1-2013:p0954:b003:l019","ordinal":148916,"en":"Kongurbai's black horse,"},{"id":"semetey-1-2013:p0954:b003:l020","ordinal":148917,"en":"His black horse's wings—"},{"id":"semetey-1-2013:p0954:b003:l021","ordinal":148918,"en":"When he pursued, he let nothing escape;"},{"id":"semetey-1-2013:p0954:b003:l022","ordinal":148919,"en":"That was Algara's habit."},{"id":"semetey-1-2013:p0954:b003:l023","ordinal":148920,"en":"When he came to a descent,"},{"id":"semetey-1-2013:p0954:b003:l024","ordinal":148921,"en":"His forelegs reached out like a roe deer's."},{"id":"semetey-1-2013:p0954:b003:l025","ordinal":148922,"en":"When he began to climb,"},{"id":"semetey-1-2013:p0954:b003:l026","ordinal":148923,"en":"His mane and tail spread out."},{"id":"semetey-1-2013:p0954:b003:l027","ordinal":148924,"en":"When he came to rugged ground,"},{"id":"semetey-1-2013:p0954:b003:l028","ordinal":148925,"en":"His stride lengthened like a stag's."},{"id":"semetey-1-2013:p0954:b003:l029","ordinal":148926,"en":"When he came to a sudden turn,"},{"id":"semetey-1-2013:p0954:b003:l030","ordinal":148927,"en":"His eyes reddened like a wild ram's."},{"id":"semetey-1-2013:p0954:b003:l031","ordinal":148928,"en":"She glided, flying high in the sky;"},{"id":"semetey-1-2013:p0954:b003:l032","ordinal":148929,"en":"Kongurbai drew near upon the earth."},{"id":"semetey-1-2013:p0954:b003:l033","ordinal":148930,"en":"The skillful Kongurbai,"},{"id":"semetey-1-2013:p0954:b003:l034","ordinal":148931,"en":"When he came abreast of her,"},{"id":"semetey-1-2013:p0954:b003:l035","ordinal":148932,"en":"Seemed about to shoot and capture her."},{"id":"semetey-1-2013:p0954:b003:l036","ordinal":148933,"en":"Seeing Churok's outline,"},{"id":"semetey-1-2013:p0954:b003:l037","ordinal":148934,"en":"That troublesome creature gliding in flight,"},{"id":"semetey-1-2013:p0954:b003:l038","ordinal":148935,"en":"His cavern-mouthed ochogor"},{"id":"semetey-1-2013:p0954:b003:l039","ordinal":148936,"en":"He took up and fired three times,"},{"id":"semetey-1-2013:p0954:b004:l001","ordinal":148937,"en":"Fired six or seven more with force."},{"id":"semetey-1-2013:p0954:b004:l002","ordinal":148938,"en":"Beside that Kalcha fellow"},{"id":"semetey-1-2013:p0954:b004:l003","ordinal":148939,"en":"Were painted arrows with golden sockets."},{"id":"semetey-1-2013:p0954:b004:l004","ordinal":148940,"en":"Such was your elder's way:"},{"id":"semetey-1-2013:p0954:b004:l005","ordinal":148941,"en":"Upon Churok in the sky,"},{"id":"semetey-1-2013:p0954:b004:l006","ordinal":148942,"en":"He now brought an onslaught."},{"id":"semetey-1-2013:p0954:b004:l007","ordinal":148943,"en":"He used still greater cunning;"},{"id":"semetey-1-2013:p0954:b004:l008","ordinal":148944,"en":"Riding beneath her, Kongurbai"},{"id":"semetey-1-2013:p0954:b004:l009","ordinal":148945,"en":"Now shot with his bow."},{"id":"semetey-1-2013:p0954:b004:l010","ordinal":148946,"en":"Pressing the attack with his bow,"},{"id":"semetey-1-2013:p0954:b004:l011","ordinal":148947,"en":"His shafts flew rattling toward her."},{"id":"semetey-1-2013:p0954:b004:l012","ordinal":148948,"en":"'The Chinese will not let me escape!'"},{"id":"semetey-1-2013:p0954:b004:l013","ordinal":148949,"en":"Wretched Churok"},{"id":"semetey-1-2013:p0954:b004:l014","ordinal":148950,"en":"Was utterly at a loss."},{"id":"semetey-1-2013:p0954:b004:l015","ordinal":148951,"en":"Changing the weather by weather-magic,"},{"id":"semetey-1-2013:p0954:b004:l016","ordinal":148952,"en":"She now used sorcery."},{"id":"semetey-1-2013:p0954:b004:l017","ordinal":148953,"en":"A great weather-magician, full of cunning,"},{"id":"semetey-1-2013:p0954:b004:l018","ordinal":148954,"en":"Aichurok, one of the noble ones,"},{"id":"semetey-1-2013:p0954:b004:l019","ordinal":148955,"en":"When Kalcha was about to capture her,"},{"id":"semetey-1-2013:p0954:b004:l020","ordinal":148956,"en":"About to cast black night upon her,"},{"id":"semetey-1-2013:p0954:b004:l021","ordinal":148957,"en":"Farting with a crack and shitting with a sputter,"},{"id":"semetey-1-2013:p0954:b004:l022","ordinal":148958,"en":"She changed the weather by magic."},{"id":"semetey-1-2013:p0954:b004:l023","ordinal":148959,"en":"Raging and shouting,"},{"id":"semetey-1-2013:p0954:b004:l024","ordinal":148960,"en":"In the hot forty days of summer,"},{"id":"semetey-1-2013:p0954:b004:l025","ordinal":148961,"en":"She summoned a pair of clouds."},{"id":"semetey-1-2013:p0954:b004:l026","ordinal":148962,"en":"Clouds swept down from the sky,"},{"id":"semetey-1-2013:p0954:b004:l027","ordinal":148963,"en":"Low fog descended and enclosed the earth,"},{"id":"semetey-1-2013:p0954:b004:l029","ordinal":148964,"en":"Clouds broke apart in the sky,"},{"id":"semetey-1-2013:p0954:b004:l031","ordinal":148965,"en":"Rain fell across all the lowlands,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0954:b004:l032","ordinal":148966,"en":"A dark downpour poured down."},{"id":"semetey-1-2013:p0954:b004:l033","ordinal":148967,"en":"Hiding the surface of the earth,"},{"id":"semetey-1-2013:p0954:b004:l034","ordinal":148968,"en":"Low fog descended and swirled."},{"id":"semetey-1-2013:p0954:b004:l035","ordinal":148969,"en":"Sleet and hail rattled,"},{"id":"semetey-1-2013:p0954:b004:l036","ordinal":148970,"en":"No one could tell which way was which."},{"id":"semetey-1-2013:p0954:b004:l037","ordinal":148971,"en":"Ridge-nosed Kongurbai"},{"id":"semetey-1-2013:p0954:b004:l038","ordinal":148972,"en":"Lost his way, babbling."},{"id":"semetey-1-2013:p0954:b004:l039","ordinal":148973,"en":"The earth turned blue-gray, fog enclosed it,"},{"id":"semetey-1-2013:p0955:b003:l001","ordinal":148974,"en":"Aichurok, who judged heroes,"},{"id":"semetey-1-2013:p0955:b003:l002","ordinal":148975,"en":"From the hands of mighty Kalcha"},{"id":"semetey-1-2013:p0955:b003:l003","ordinal":148976,"en":"Escaped only with the greatest difficulty."},{"id":"semetey-1-2013:p0955:b003:l004","ordinal":148977,"en":"Finding no support in a renowned place,"},{"id":"semetey-1-2013:p0955:b003:l005","ordinal":148978,"en":"Finding no hero to cherish as husband,"},{"id":"semetey-1-2013:p0955:b003:l006","ordinal":148979,"en":"She crossed Kyzyl-Kyya."},{"id":"semetey-1-2013:p0955:b003:l007","ordinal":148980,"en":"In great haste, Aichurok"},{"id":"semetey-1-2013:p0955:b003:l008","ordinal":148981,"en":"Passed over Ala-Kol."},{"id":"semetey-1-2013:p0955:b003:l009","ordinal":148982,"en":"Unable to collect her wits, Aichurok"},{"id":"semetey-1-2013:p0955:b003:l010","ordinal":148983,"en":"Climbed Elkin-Too and lay down."},{"id":"semetey-1-2013:p0955:b003:l011","ordinal":148984,"en":"Gathering herself, she smoothed her hair,"},{"id":"semetey-1-2013:p0955:b003:l012","ordinal":148985,"en":"As though Kongurbai might catch up,"},{"id":"semetey-1-2013:p0955:b003:l013","ordinal":148986,"en":"She looked to either side."},{"id":"semetey-1-2013:p0955:b003:l014","ordinal":148987,"en":"Elkin-Too was a deserted place."},{"id":"semetey-1-2013:p0955:b003:l015","ordinal":148988,"en":"There was no crow to caw,"},{"id":"semetey-1-2013:p0955:b003:l016","ordinal":148989,"en":"No raven croaking in flight,"},{"id":"semetey-1-2013:p0955:b003:l017","ordinal":148990,"en":"No furrow cut by a plow,"},{"id":"semetey-1-2013:p0955:b003:l018","ordinal":148991,"en":"No burrow dug by a marmot."},{"id":"semetey-1-2013:p0955:b003:l019","ordinal":148992,"en":"It was a place of winding hollows,"}]
