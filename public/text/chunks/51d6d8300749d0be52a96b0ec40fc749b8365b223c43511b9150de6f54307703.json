[{"id":"semetey-1-2013:p0456:b003:l036","ordinal":111873,"en":"He had it scattered and spent."},{"id":"semetey-1-2013:p0456:b003:l037","ordinal":111874,"en":"The man kept slaughtering and eating well-fed foals;"},{"id":"semetey-1-2013:p0456:b003:l038","ordinal":111875,"en":"All about him were words of discord."},{"id":"semetey-1-2013:p0456:b003:l039","ordinal":111876,"en":"“I will be Manas's equal kinsman,” he kept saying."},{"id":"semetey-1-2013:p0456:b004:l001","ordinal":111877,"en":"Drinking his kumys, he grew excited."},{"id":"semetey-1-2013:p0456:b004:l002","ordinal":111878,"en":"Against your lion father Manas,"},{"id":"semetey-1-2013:p0456:b004:l003","ordinal":111879,"en":"Finding no opening, he raged."},{"id":"semetey-1-2013:p0456:b004:l004","ordinal":111880,"en":"Your gray-maned father Manas's"},{"id":"semetey-1-2013:p0456:b004:l005","ordinal":111881,"en":"Liquor he drank in a frenzy."},{"id":"semetey-1-2013:p0456:b004:l006","ordinal":111882,"en":"As I kept watch upon them,"},{"id":"semetey-1-2013:p0456:b004:l007","ordinal":111883,"en":"Against your gray-maned father Manas,"},{"id":"semetey-1-2013:p0456:b004:l008","ordinal":111884,"en":"Unable to find a means, they grew excited."},{"id":"semetey-1-2013:p0456:b004:l009","ordinal":111885,"en":"At the edge of another marsh"},{"id":"semetey-1-2013:p0456:b004:l010","ordinal":111886,"en":"They would draw apart and talk."},{"id":"semetey-1-2013:p0456:b004:l011","ordinal":111887,"en":"When they had drunk their fill of liquor,"},{"id":"semetey-1-2013:p0456:b004:l012","ordinal":111888,"en":"The accursed men spurred one another on."},{"id":"semetey-1-2013:p0456:b004:l014","ordinal":111889,"en":"At your mother Kanykei's Kötörmö,"},{"id":"semetey-1-2013:p0456:b004:l015","ordinal":111890,"en":"On the spur of Kötörmö,"},{"id":"semetey-1-2013:p0456:b004:l016","ordinal":111891,"en":"They dug a passage no one knew,"},{"id":"semetey-1-2013:p0456:b004:l017","ordinal":111892,"en":"“So your father may fall into it,"},{"id":"semetey-1-2013:p0456:b004:l018","ordinal":111893,"en":"So his death may come this way.”"},{"id":"semetey-1-2013:p0456:b004:l019","ordinal":111894,"en":"Into Közkaman's house"},{"id":"semetey-1-2013:p0456:b004:l020","ordinal":111895,"en":"They dug a pit forty rope-lengths long."},{"id":"semetey-1-2013:p0456:b004:l021","ordinal":111896,"en":"The decorated clothes-pole's shaft,"},{"id":"semetey-1-2013:p0456:b004:l022","ordinal":111897,"en":"Their conduct grown somewhat perverse—"},{"id":"semetey-1-2013:p0456:b004:l023","ordinal":111898,"en":"I, your mother, watched and knew:"},{"id":"semetey-1-2013:p0456:b004:l024","ordinal":111899,"en":"Their rite was in the old Kalmyk manner."},{"id":"semetey-1-2013:p0456:b004:l025","ordinal":111900,"en":"Hearing scattered scraps of talk,"},{"id":"semetey-1-2013:p0456:b004:l026","ordinal":111901,"en":"I, the unfortunate one born to suffering,"},{"id":"semetey-1-2013:p0456:b004:l027","ordinal":111902,"en":"Heard that a great bronze idol"},{"id":"semetey-1-2013:p0456:b004:l028","ordinal":111903,"en":"Was in Közkaman's house,"},{"id":"semetey-1-2013:p0456:b004:l029","ordinal":111904,"en":"That they gathered in the dark of night"},{"id":"semetey-1-2013:p0456:b004:l030","ordinal":111905,"en":"And the Kalmyks worshipped it."},{"id":"semetey-1-2013:p0456:b004:l032","ordinal":111906,"en":"Alarmed, thinking over what was said,"},{"id":"semetey-1-2013:p0456:b004:l033","ordinal":111907,"en":"I wondered whether that Kalmyk"},{"id":"semetey-1-2013:p0456:b004:l034","ordinal":111908,"en":"Would bring about my end."},{"id":"semetey-1-2013:p0456:b004:l035","ordinal":111909,"en":"I had long known what he would do."},{"id":"semetey-1-2013:p0456:b004:l036","ordinal":111910,"en":"Against your khan father, that devil—"},{"id":"semetey-1-2013:p0456:b004:l037","ordinal":111911,"en":"I feared what he would do."},{"id":"semetey-1-2013:p0456:b004:l038","ordinal":111912,"en":"Yesterday, the numerous Argyn made for the valley,"},{"id":"semetey-1-2013:p0457:b003:l001","ordinal":111913,"en":"While they were encamped,"},{"id":"semetey-1-2013:p0457:b003:l002","ordinal":111914,"en":"While Argyn and Kyrgyz mingled"},{"id":"semetey-1-2013:p0457:b003:l003","ordinal":111915,"en":"Together there,"},{"id":"semetey-1-2013:p0457:b003:l004","ordinal":111916,"en":"When bored, they shot roe deer;"},{"id":"semetey-1-2013:p0457:b003:l005","ordinal":111917,"en":"When not bored, the forty companions"},{"id":"semetey-1-2013:p0457:b003:l006","ordinal":111918,"en":"Played freely."},{"id":"semetey-1-2013:p0457:b003:l007","ordinal":111919,"en":"When they arranged their entertainment,"},{"id":"semetey-1-2013:p0457:b003:l008","ordinal":111920,"en":"A yellow enclosure, a level riverbank—"},{"id":"semetey-1-2013:p0457:b003:l009","ordinal":111921,"en":"They laid out a forty-pace ordo court."},{"id":"semetey-1-2013:p0457:b003:l010","ordinal":111922,"en":"They shot skillfully at the knucklebones,"},{"id":"semetey-1-2013:p0457:b003:l011","ordinal":111923,"en":"Plunging into their pleasures."},{"id":"semetey-1-2013:p0457:b003:l012","ordinal":111924,"en":"The forty companions split into two sides."},{"id":"semetey-1-2013:p0457:b003:l013","ordinal":111925,"en":"The game of those lion-born heroes"},{"id":"semetey-1-2013:p0457:b003:l014","ordinal":111926,"en":"Was a fine sight."},{"id":"semetey-1-2013:p0457:b003:l015","ordinal":111927,"en":"Forty mares on each side"},{"id":"semetey-1-2013:p0457:b003:l016","ordinal":111928,"en":"They brought and staked."},{"id":"semetey-1-2013:p0457:b003:l017","ordinal":111929,"en":"The foremost of the companions,"},{"id":"semetey-1-2013:p0457:b003:l018","ordinal":111930,"en":"The winners, slaughtered their winnings."},{"id":"semetey-1-2013:p0457:b003:l019","ordinal":111931,"en":"Eating unbred yearlings from the herd,"},{"id":"semetey-1-2013:p0457:b003:l020","ordinal":111932,"en":"The forty champions, like blue ticks,"},{"id":"semetey-1-2013:p0457:b003:l021","ordinal":111933,"en":"Grew plump."},{"id":"semetey-1-2013:p0457:b003:l022","ordinal":111934,"en":"Shebiet games and one-legged tag"},{"id":"semetey-1-2013:p0457:b003:l023","ordinal":111935,"en":"Were being played."},{"id":"semetey-1-2013:p0457:b003:l024","ordinal":111936,"en":"Wearing paired marten-fur caps,"},{"id":"semetey-1-2013:p0457:b003:l025","ordinal":111937,"en":"They swayed about."},{"id":"semetey-1-2013:p0457:b003:l026","ordinal":111938,"en":"Drinking kumys, playing with girls,"},{"id":"semetey-1-2013:p0457:b003:l027","ordinal":111939,"en":"They reveled."},{"id":"semetey-1-2013:p0457:b003:l028","ordinal":111940,"en":"As they held their games,"},{"id":"semetey-1-2013:p0457:b003:l029","ordinal":111941,"en":"Giving no thought to treacherous words,"},{"id":"semetey-1-2013:p0457:b003:l030","ordinal":111942,"en":"The gray-maned hero played."},{"id":"semetey-1-2013:p0457:b003:l031","ordinal":111943,"en":"Thimble mouths, camel-calf eyes,"},{"id":"semetey-1-2013:p0457:b003:l032","ordinal":111944,"en":"Dark eyes darting coquettishly,"},{"id":"semetey-1-2013:p0457:b003:l033","ordinal":111945,"en":"Scarlet dresses, slender waists—"},{"id":"semetey-1-2013:p0457:b003:l034","ordinal":111946,"en":"They gathered a hundred maidens."},{"id":"semetey-1-2013:p0457:b003:l035","ordinal":111947,"en":"Ornamented braid-tassels, broad hips—"},{"id":"semetey-1-2013:p0457:b003:l036","ordinal":111948,"en":"They gathered a hundred young wives."},{"id":"semetey-1-2013:p0457:b003:l037","ordinal":111949,"en":"Of liquor distilled from kumys"},{"id":"semetey-1-2013:p0457:b003:l038","ordinal":111950,"en":"They gathered forty leather flasks."},{"id":"semetey-1-2013:p0457:b003:l039","ordinal":111951,"en":"Women and men drew apart."},{"id":"semetey-1-2013:p0457:b005:l001","ordinal":111952,"en":"A paradise in this world—"},{"id":"semetey-1-2013:p0457:b005:l002","ordinal":111953,"en":"The entertainment was marvelous."},{"id":"semetey-1-2013:p0457:b005:l003","ordinal":111954,"en":"Their laughter brought out the sun."},{"id":"semetey-1-2013:p0457:b005:l004","ordinal":111955,"en":"All forty champions"},{"id":"semetey-1-2013:p0457:b005:l005","ordinal":111956,"en":"Laughed and played and rejoiced."},{"id":"semetey-1-2013:p0457:b005:l006","ordinal":111957,"en":"Their revels brought on dawn."},{"id":"semetey-1-2013:p0457:b005:l007","ordinal":111958,"en":"When all forty companions"},{"id":"semetey-1-2013:p0457:b005:l008","ordinal":111959,"en":"Played their splendid games,"},{"id":"semetey-1-2013:p0457:b005:l009","ordinal":111960,"en":"I, your unfortunate, ill-fated mother,"},{"id":"semetey-1-2013:p0457:b005:l010","ordinal":111961,"en":"Within the white palace,"},{"id":"semetey-1-2013:p0457:b005:l011","ordinal":111962,"en":"Was making the white padded armor."},{"id":"semetey-1-2013:p0457:b005:l012","ordinal":111963,"en":"Your guileless father"},{"id":"semetey-1-2013:p0457:b005:l013","ordinal":111964,"en":"Kökchököz and Közkaman"},{"id":"semetey-1-2013:p0457:b005:l014","ordinal":111965,"en":"Openly deceived."},{"id":"semetey-1-2013:p0457:b005:l015","ordinal":111966,"en":"That your father had gone to them—"},{"id":"semetey-1-2013:p0457:b005:l016","ordinal":111967,"en":"Of all forty champions,"},{"id":"semetey-1-2013:p0457:b005:l017","ordinal":111968,"en":"Not one had seen it."},{"id":"semetey-1-2013:p0457:b005:l018","ordinal":111969,"en":"My gray-maned hero went visiting;"},{"id":"semetey-1-2013:p0457:b005:l019","ordinal":111970,"en":"When he went to Kökchököz,"},{"id":"semetey-1-2013:p0457:b005:l020","ordinal":111971,"en":"Kökchököz and Közkaman"},{"id":"semetey-1-2013:p0457:b005:l021","ordinal":111972,"en":"Openly deceived him."},{"id":"semetey-1-2013:p0457:b005:l022","ordinal":111973,"en":"The guileless, generous lion,"},{"id":"semetey-1-2013:p0457:b005:l023","ordinal":111974,"en":"As though they were truly his kin,"},{"id":"semetey-1-2013:p0457:b005:l024","ordinal":111975,"en":"Went striding there."},{"id":"semetey-1-2013:p0457:b005:l025","ordinal":111976,"en":"Your guileless father—"},{"id":"semetey-1-2013:p0457:b005:l026","ordinal":111977,"en":"They deceived him"},{"id":"semetey-1-2013:p0457:b005:l027","ordinal":111978,"en":"And cast him openly into misery."},{"id":"semetey-1-2013:p0457:b005:l028","ordinal":111979,"en":"Your khan father knew nothing."},{"id":"semetey-1-2013:p0457:b005:l029","ordinal":111980,"en":"When he was truly deceived,"},{"id":"semetey-1-2013:p0457:b005:l030","ordinal":111981,"en":"They had drawn the line;"},{"id":"semetey-1-2013:p0457:b005:l031","ordinal":111982,"en":"For your guileless father"},{"id":"semetey-1-2013:p0457:b005:l032","ordinal":111983,"en":"They then prepared their dreadful spectacle."},{"id":"semetey-1-2013:p0457:b005:l033","ordinal":111984,"en":"They had dug my grave,"},{"id":"semetey-1-2013:p0457:b005:l034","ordinal":111985,"en":"The accursed dark Kalmyks;"},{"id":"semetey-1-2013:p0457:b005:l035","ordinal":111986,"en":"They had boiled my bitter misery."},{"id":"semetey-1-2013:p0457:b005:l036","ordinal":111987,"en":"Közkaman had stepped"},{"id":"semetey-1-2013:p0457:b005:l037","ordinal":111988,"en":"To my vat filled with liquor."},{"id":"semetey-1-2013:p0457:b005:l038","ordinal":111989,"en":"In this way he had reached"},{"id":"semetey-1-2013:p0457:b005:l039","ordinal":111990,"en":"The very depths of my ruin."},{"id":"semetey-1-2013:p0458:b003:l001","ordinal":111991,"en":"They had dug my grave deep."},{"id":"semetey-1-2013:p0458:b003:l002","ordinal":111992,"en":"Those Kalmyks had boiled my bitter misery,"},{"id":"semetey-1-2013:p0458:b003:l004","ordinal":111993,"en":"Had shown before my eyes"},{"id":"semetey-1-2013:p0458:b003:l005","ordinal":111994,"en":"Suffering no person had seen."},{"id":"semetey-1-2013:p0458:b003:l006","ordinal":111995,"en":"In a mood to visit,"},{"id":"semetey-1-2013:p0458:b003:l007","ordinal":111996,"en":"Your father went inside."},{"id":"semetey-1-2013:p0458:b003:l008","ordinal":111997,"en":"The wretches who came from China"},{"id":"semetey-1-2013:p0458:b003:l009","ordinal":111998,"en":"Told entertaining tales."},{"id":"semetey-1-2013:p0458:b003:l010","ordinal":111999,"en":"When your khan father entered,"},{"id":"semetey-1-2013:p0458:b003:l011","ordinal":112000,"en":"Acknowledging his worth, growing animated,"},{"id":"semetey-1-2013:p0458:b003:l012","ordinal":112001,"en":"The swine Közkaman spoke:"},{"id":"semetey-1-2013:p0458:b003:l013","ordinal":112002,"en":"“My Manas, since coming to you—"},{"id":"semetey-1-2013:p0458:b003:l014","ordinal":112003,"en":"We came worn thin and grew fat;"},{"id":"semetey-1-2013:p0458:b003:l015","ordinal":112004,"en":"We came hungry and ate our fill;"},{"id":"semetey-1-2013:p0458:b003:l016","ordinal":112005,"en":"We came diminished and grew complete."},{"id":"semetey-1-2013:p0458:b003:l017","ordinal":112006,"en":"We settled in Talas and made it home."},{"id":"semetey-1-2013:p0458:b003:l018","ordinal":112007,"en":"Exhausted, wandering from Beijing,"},{"id":"semetey-1-2013:p0458:b003:l019","ordinal":112008,"en":"My gray-maned hero, we made you our support!"},{"id":"semetey-1-2013:p0458:b003:l020","ordinal":112009,"en":"When we lived among the Kalmyks,"},{"id":"semetey-1-2013:p0458:b003:l021","ordinal":112010,"en":"We were dark Kalmyks, Manchu;"},{"id":"semetey-1-2013:p0458:b003:l022","ordinal":112011,"en":"We used to serve their khan."},{"id":"semetey-1-2013:p0458:b003:l023","ordinal":112012,"en":"When our service went amiss,"},{"id":"semetey-1-2013:p0458:b003:l024","ordinal":112013,"en":"We bowed like women"},{"id":"semetey-1-2013:p0458:b003:l025","ordinal":112014,"en":"And paid homage to the Chinese."},{"id":"semetey-1-2013:p0458:b003:l026","ordinal":112015,"en":"We found the Kyrgyz and eagerly reached for them;"},{"id":"semetey-1-2013:p0458:b003:l027","ordinal":112016,"en":"We escaped that bowing."},{"id":"semetey-1-2013:p0458:b003:l028","ordinal":112017,"en":"We would prosper if we went to Manas—"},{"id":"semetey-1-2013:p0458:b003:l029","ordinal":112018,"en":"So we too had thought."},{"id":"semetey-1-2013:p0458:b003:l030","ordinal":112019,"en":"When we went to Manas,"},{"id":"semetey-1-2013:p0458:b003:l031","ordinal":112020,"en":"We would all become sultans."},{"id":"semetey-1-2013:p0458:b003:l032","ordinal":112021,"en":"The one God granted our wish."},{"id":"semetey-1-2013:p0458:b003:l033","ordinal":112022,"en":"My stately lion, listen:"},{"id":"semetey-1-2013:p0458:b003:l034","ordinal":112023,"en":"Not a trace of sorrow remains with us!"},{"id":"semetey-1-2013:p0458:b003:l035","ordinal":112024,"en":"From the unbelievers of the dark faith"},{"id":"semetey-1-2013:p0458:b003:l036","ordinal":112025,"en":"Thus the one God delivered us!"},{"id":"semetey-1-2013:p0458:b003:l038","ordinal":112026,"en":"We renounced their idols."},{"id":"semetey-1-2013:p0458:b003:l039","ordinal":112027,"en":"We left behind, Khan Manas,"},{"id":"semetey-1-2013:p0458:b004:l001","ordinal":112028,"en":"The Chinese people in that distant steppe."},{"id":"semetey-1-2013:p0458:b004:l002","ordinal":112029,"en":"When we lived under the khagan,"},{"id":"semetey-1-2013:p0458:b004:l003","ordinal":112030,"en":"We ate badger meat."},{"id":"semetey-1-2013:p0458:b004:l004","ordinal":112031,"en":"If we reached Khan Manas and settled,"},{"id":"semetey-1-2013:p0458:b004:l005","ordinal":112032,"en":"Then these poor heads"},{"id":"semetey-1-2013:p0458:b004:l006","ordinal":112033,"en":"Would become sultans, we thought as we came."},{"id":"semetey-1-2013:p0458:b004:l007","ordinal":112034,"en":"All misfortunes were cut away."},{"id":"semetey-1-2013:p0458:b004:l008","ordinal":112035,"en":"This was God's gift:"},{"id":"semetey-1-2013:p0458:b004:l009","ordinal":112036,"en":"We met the mighty lion Manas."},{"id":"semetey-1-2013:p0458:b004:l010","ordinal":112037,"en":"Our severed, hapless lives were joined;"},{"id":"semetey-1-2013:p0458:b004:l011","ordinal":112038,"en":"The scattered Kalmyks were gathered."},{"id":"semetey-1-2013:p0458:b004:l012","ordinal":112039,"en":"We settled in Talas and made it home,"},{"id":"semetey-1-2013:p0458:b004:l013","ordinal":112040,"en":"Taking Khan Manas as our lion."},{"id":"semetey-1-2013:p0458:b004:l014","ordinal":112041,"en":"When we lived under the khagan,"},{"id":"semetey-1-2013:p0458:b004:l015","ordinal":112042,"en":"Our lives had shrunk to a handful."},{"id":"semetey-1-2013:p0458:b004:l016","ordinal":112043,"en":"When we came wandering, you eased our grief."},{"id":"semetey-1-2013:p0458:b004:l017","ordinal":112044,"en":"Live long, Manas, our khan!"},{"id":"semetey-1-2013:p0458:b004:l018","ordinal":112045,"en":"When we lived in Beijing,"},{"id":"semetey-1-2013:p0458:b004:l019","ordinal":112046,"en":"Prince Manas, listen,"},{"id":"semetey-1-2013:p0458:b004:l020","ordinal":112047,"en":"Our days were dark."},{"id":"semetey-1-2013:p0458:b004:l021","ordinal":112048,"en":"You freed us from the Kalmyks."},{"id":"semetey-1-2013:p0458:b004:l022","ordinal":112049,"en":"Live long, Manas, one of us!"},{"id":"semetey-1-2013:p0458:b004:l023","ordinal":112050,"en":"We came as a horseless Kalmyk."},{"id":"semetey-1-2013:p0458:b004:l024","ordinal":112051,"en":"The Kalmyk who came horseless—"},{"id":"semetey-1-2013:p0458:b004:l025","ordinal":112052,"en":"An argali-legged, bronze-limbed"},{"id":"semetey-1-2013:p0458:b004:l026","ordinal":112053,"en":"Swift steed you gave him to ride."},{"id":"semetey-1-2013:p0458:b004:l027","ordinal":112054,"en":"One of us came without a robe."},{"id":"semetey-1-2013:p0458:b004:l028","ordinal":112055,"en":"The kinsman who came without a robe—"},{"id":"semetey-1-2013:p0458:b004:l029","ordinal":112056,"en":"A golden collar, bronze sleeves,"},{"id":"semetey-1-2013:p0458:b004:l030","ordinal":112057,"en":"Double mail, lark-eyed rings,"},{"id":"semetey-1-2013:p0458:b004:l031","ordinal":112058,"en":"A gold-braided collar, a broad sleeveless coat,"},{"id":"semetey-1-2013:p0458:b004:l032","ordinal":112059,"en":"Impervious to bullets when worn in battle—"},{"id":"semetey-1-2013:p0458:b004:l033","ordinal":112060,"en":"You clothed him in a robe, Khan Manas."},{"id":"semetey-1-2013:p0458:b004:l034","ordinal":112061,"en":"The Kalmyk who came without a wife,"},{"id":"semetey-1-2013:p0458:b004:l035","ordinal":112062,"en":"Who came wandering all alone—"},{"id":"semetey-1-2013:p0458:b004:l036","ordinal":112063,"en":"Thimble mouth, camel-calf eyes,"},{"id":"semetey-1-2013:p0458:b004:l037","ordinal":112064,"en":"Dark eyes darting coquettishly,"},{"id":"semetey-1-2013:p0458:b004:l038","ordinal":112065,"en":"From the beauties of the Kyrgyz,"},{"id":"semetey-1-2013:p0458:b004:l039","ordinal":112066,"en":"Khan Manas, you gave him a wife."},{"id":"semetey-1-2013:p0459:b003:l001","ordinal":112067,"en":"Wandering here from the khagan,"},{"id":"semetey-1-2013:p0459:b003:l002","ordinal":112068,"en":"We saw no prince like you."},{"id":"semetey-1-2013:p0459:b003:l003","ordinal":112069,"en":"You held nine days of feasting without pause,"},{"id":"semetey-1-2013:p0459:b003:l004","ordinal":112070,"en":"And had cut off, my Sultan Manas,"},{"id":"semetey-1-2013:p0459:b003:l005","ordinal":112071,"en":"My hair, thick as a hand-mallet."},{"id":"semetey-1-2013:p0459:b003:l006","ordinal":112072,"en":"You freed, my generous lord,"},{"id":"semetey-1-2013:p0459:b003:l007","ordinal":112073,"en":"This head that came from the Kalmyks."},{"id":"semetey-1-2013:p0459:b003:l008","ordinal":112074,"en":"Now and then, my gray-maned hero,"},{"id":"semetey-1-2013:p0459:b003:l009","ordinal":112075,"en":"You did not come to eat my food."},{"id":"semetey-1-2013:p0459:b003:l010","ordinal":112076,"en":"You did not come to our home"},{"id":"semetey-1-2013:p0459:b003:l011","ordinal":112077,"en":"To ask, ‘How are you faring?’"},{"id":"semetey-1-2013:p0459:b003:l012","ordinal":112078,"en":"My king, you did not learn our condition."},{"id":"semetey-1-2013:p0459:b003:l013","ordinal":112079,"en":"You did not stop at our home,"},{"id":"semetey-1-2013:p0459:b003:l014","ordinal":112080,"en":"Did not take food from my hand."},{"id":"semetey-1-2013:p0459:b003:l015","ordinal":112081,"en":"Was gray-maned leopard Manas"},{"id":"semetey-1-2013:p0459:b003:l016","ordinal":112082,"en":"A khan before whom the people should hold back?"},{"id":"semetey-1-2013:p0459:b003:l017","ordinal":112083,"en":"When my khan Manas comes,"},{"id":"semetey-1-2013:p0459:b003:l018","ordinal":112084,"en":"I will not spare my life."},{"id":"semetey-1-2013:p0459:b003:l019","ordinal":112085,"en":"Is there any of that damned drink?”"},{"id":"semetey-1-2013:p0459:b003:l020","ordinal":112086,"en":"While Közkaman was speaking,"},{"id":"semetey-1-2013:p0459:b003:l021","ordinal":112087,"en":"Kökchököz rose to his feet."},{"id":"semetey-1-2013:p0459:b003:l022","ordinal":112088,"en":"One sip would bring death;"},{"id":"semetey-1-2013:p0459:b003:l023","ordinal":112089,"en":"One sniff would bring the end."},{"id":"semetey-1-2013:p0459:b003:l024","ordinal":112090,"en":"Poison of forty years had been mixed in,"},{"id":"semetey-1-2013:p0459:b003:l025","ordinal":112091,"en":"Its ferment brought to readiness,"},{"id":"semetey-1-2013:p0459:b003:l026","ordinal":112092,"en":"Killing those marked as enemies,"},{"id":"semetey-1-2013:p0459:b003:l027","ordinal":112093,"en":"Poured into a leather flask and prepared,"},{"id":"semetey-1-2013:p0459:b003:l028","ordinal":112094,"en":"For the guileless leopard,"},{"id":"semetey-1-2013:p0459:b003:l029","ordinal":112095,"en":"Kept for Khan Manas."},{"id":"semetey-1-2013:p0459:b003:l030","ordinal":112096,"en":"A dreadful poison that tormented at a touch—"},{"id":"semetey-1-2013:p0459:b003:l031","ordinal":112097,"en":"Into a gold-rimmed bowl"},{"id":"semetey-1-2013:p0459:b003:l032","ordinal":112098,"en":"Kökchököz, what else would he do,"},{"id":"semetey-1-2013:p0459:b003:l033","ordinal":112099,"en":"Poured it to the brim."},{"id":"semetey-1-2013:p0459:b003:l034","ordinal":112100,"en":"“We share one root of kinship,” he said."},{"id":"semetey-1-2013:p0459:b003:l035","ordinal":112101,"en":"To gray-maned Lord Manas"},{"id":"semetey-1-2013:p0459:b003:l036","ordinal":112102,"en":"Közkaman brought and offered it."},{"id":"semetey-1-2013:p0459:b003:l037","ordinal":112103,"en":"Did you see his foolishness?"},{"id":"semetey-1-2013:p0459:b003:l038","ordinal":112104,"en":"Taking it at once and turning it,"},{"id":"semetey-1-2013:p0459:b003:l039","ordinal":112105,"en":"The poison Közkaman offered—"},{"id":"semetey-1-2013:p0459:b005:l001","ordinal":112106,"en":"Khan Manas drank it all down."},{"id":"semetey-1-2013:p0459:b005:l002","ordinal":112107,"en":"When he drank, the gray-maned hero doubled over,"},{"id":"semetey-1-2013:p0459:b005:l003","ordinal":112108,"en":"Fell straight onto his head,"},{"id":"semetey-1-2013:p0459:b005:l004","ordinal":112109,"en":"His fine mustache flattened."},{"id":"semetey-1-2013:p0459:b005:l005","ordinal":112110,"en":"A terrible poison they had given him."},{"id":"semetey-1-2013:p0459:b005:l006","ordinal":112111,"en":"Like one departing for Judgment Day,"},{"id":"semetey-1-2013:p0459:b005:l007","ordinal":112112,"en":"His great eyes stared wide,"},{"id":"semetey-1-2013:p0459:b005:l008","ordinal":112113,"en":"Like one departing for the other world."},{"id":"semetey-1-2013:p0459:b005:l009","ordinal":112114,"en":"Do not act so, Manas, without reason."},{"id":"semetey-1-2013:p0459:b005:l010","ordinal":112115,"en":"Sharing death, sharing one life—"},{"id":"semetey-1-2013:p0459:b005:l011","ordinal":112116,"en":"Not one of those champions was there."},{"id":"semetey-1-2013:p0459:b005:l012","ordinal":112117,"en":"The pair Azhybai and Bakai were not there;"},{"id":"semetey-1-2013:p0459:b005:l013","ordinal":112118,"en":"Ocean-like Almambet and Chubak were not there;"},{"id":"semetey-1-2013:p0459:b005:l014","ordinal":112119,"en":"The heroes Syrgak and Serek were not there;"},{"id":"semetey-1-2013:p0459:b005:l015","ordinal":112120,"en":"The servant Shuutu and hero Yrchy were not there."},{"id":"semetey-1-2013:p0459:b005:l016","ordinal":112121,"en":"The cunning finder of a way,"},{"id":"semetey-1-2013:p0459:b005:l017","ordinal":112122,"en":"His lion Bakai Khan was not there."},{"id":"semetey-1-2013:p0459:b005:l018","ordinal":112123,"en":"Companions even in the hereafter,"},{"id":"semetey-1-2013:p0459:b005:l019","ordinal":112124,"en":"All those forty champions were absent."},{"id":"semetey-1-2013:p0459:b005:l020","ordinal":112125,"en":"His hapless eyes drooped shut,"},{"id":"semetey-1-2013:p0459:b005:l021","ordinal":112126,"en":"His looks faded, his belly burned,"},{"id":"semetey-1-2013:p0459:b005:l022","ordinal":112127,"en":"His strength left him as he languished."},{"id":"semetey-1-2013:p0459:b005:l023","ordinal":112128,"en":"Once Közkaman had become his enemy,"}]
