[{"id":"semetey-1-2013:p0670:b004:l036","ordinal":128257,"en":"Six swords were found."},{"id":"semetey-1-2013:p0670:b004:l037","ordinal":128258,"en":"The finest of the swords,"},{"id":"semetey-1-2013:p0670:b004:l038","ordinal":128259,"en":"The one most suited to slaughter,"},{"id":"semetey-1-2013:p0670:b004:l039","ordinal":128260,"en":"My father took Zulpukor."},{"id":"semetey-1-2013:p0671:b003:l001","ordinal":128261,"en":"Khan Bakai's Oikuma,"},{"id":"semetey-1-2013:p0671:b003:l002","ordinal":128262,"en":"Azhibai's Achalbars,"},{"id":"semetey-1-2013:p0671:b003:l003","ordinal":128263,"en":"Almambet's Kylbolot,"},{"id":"semetey-1-2013:p0671:b003:l004","ordinal":128264,"en":"Zhoibolot taken by Chubak,"},{"id":"semetey-1-2013:p0671:b003:l005","ordinal":128265,"en":"The very last of the swords,"},{"id":"semetey-1-2013:p0671:b003:l006","ordinal":128266,"en":"Warrior Syrgak's Narkesken—"},{"id":"semetey-1-2013:p0671:b003:l007","ordinal":128267,"en":"From my wolf-maned lion father,"},{"id":"semetey-1-2013:p0671:b003:l008","ordinal":128268,"en":"Six blades left in trust."},{"id":"semetey-1-2013:p0671:b003:l009","ordinal":128269,"en":"Long ago, my poor mother Kanykei,"},{"id":"semetey-1-2013:p0671:b003:l010","ordinal":128270,"en":"With spreading black mourning upon her head,"},{"id":"semetey-1-2013:p0671:b003:l011","ordinal":128271,"en":"Bereft of my father,"},{"id":"semetey-1-2013:p0671:b003:l012","ordinal":128272,"en":"The poverty that hides in front"},{"id":"semetey-1-2013:p0671:b003:l013","ordinal":128273,"en":"At thirty-two years of age,"},{"id":"semetey-1-2013:p0671:b003:l014","ordinal":128274,"en":"Set her course toward Temir Khan."},{"id":"semetey-1-2013:p0671:b003:l015","ordinal":128275,"en":"Poor me, a babe in the cradle,"},{"id":"semetey-1-2013:p0671:b003:l016","ordinal":128276,"en":"She carried as she wandered to Bukhara."},{"id":"semetey-1-2013:p0671:b003:l017","ordinal":128277,"en":"The khan's wealth, his abundant property,"},{"id":"semetey-1-2013:p0671:b003:l018","ordinal":128278,"en":"Was scattered in turmoil."},{"id":"semetey-1-2013:p0671:b003:l019","ordinal":128279,"en":"Aiming sights and firing shots,"},{"id":"semetey-1-2013:p0671:b003:l020","ordinal":128280,"en":"Your six sons came and fell upon us."},{"id":"semetey-1-2013:p0671:b003:l021","ordinal":128281,"en":"To the widow and the orphan,"},{"id":"semetey-1-2013:p0671:b003:l022","ordinal":128282,"en":"You did whatever you pleased."},{"id":"semetey-1-2013:p0671:b003:l023","ordinal":128283,"en":"All the weapons of war"},{"id":"semetey-1-2013:p0671:b003:l024","ordinal":128284,"en":"Became booty."},{"id":"semetey-1-2013:p0671:b003:l025","ordinal":128285,"en":"Among all those things,"},{"id":"semetey-1-2013:p0671:b003:l026","ordinal":128286,"en":"The six blades remained in your hands."},{"id":"semetey-1-2013:p0671:b003:l027","ordinal":128287,"en":"The gifts left by my father,"},{"id":"semetey-1-2013:p0671:b003:l028","ordinal":128288,"en":"I have come to take; hand them over."},{"id":"semetey-1-2013:p0671:b003:l029","ordinal":128289,"en":"Long ago, Kanykei departed in mourning;"},{"id":"semetey-1-2013:p0671:b003:l030","ordinal":128290,"en":"Unable to bear your wrath,"},{"id":"semetey-1-2013:p0671:b003:l031","ordinal":128291,"en":"Semetey fled."},{"id":"semetey-1-2013:p0671:b003:l032","ordinal":128292,"en":"I plundered fine cloth and recovered."},{"id":"semetey-1-2013:p0671:b003:l033","ordinal":128293,"en":"Because of your mischief,"},{"id":"semetey-1-2013:p0671:b003:l034","ordinal":128294,"en":"I went to Bukhara and grew up."},{"id":"semetey-1-2013:p0671:b003:l035","ordinal":128295,"en":"I matured and became a man,"},{"id":"semetey-1-2013:p0671:b003:l036","ordinal":128296,"en":"Became the equal of other men's sons."},{"id":"semetey-1-2013:p0671:b003:l037","ordinal":128297,"en":"I lived an orphan and matured,"},{"id":"semetey-1-2013:p0671:b003:l038","ordinal":128298,"en":"Joined the ranks myself."},{"id":"semetey-1-2013:p0671:b003:l039","ordinal":128299,"en":"Hardened by drinking blood,"},{"id":"semetey-1-2013:p0671:b004:l001","ordinal":128300,"en":"This year I became known as bloodthirsty Semen."},{"id":"semetey-1-2013:p0671:b004:l002","ordinal":128301,"en":"Khan grandfather Zhakyp, hear this:"},{"id":"semetey-1-2013:p0671:b004:l003","ordinal":128302,"en":"Where are the herds left by my father?"},{"id":"semetey-1-2013:p0671:b004:l004","ordinal":128303,"en":"Where are the people left by magnanimous Manas?"},{"id":"semetey-1-2013:p0671:b004:l005","ordinal":128304,"en":"Come, grandfather, Khan Zhakyp,"},{"id":"semetey-1-2013:p0671:b004:l006","ordinal":128305,"en":"With a golden collar and bronze sleeves,"},{"id":"semetey-1-2013:p0671:b004:l007","ordinal":128306,"en":"Double mail with links like larks' eyes,"},{"id":"semetey-1-2013:p0671:b004:l008","ordinal":128307,"en":"A broad jacket and wide collar,"},{"id":"semetey-1-2013:p0671:b004:l009","ordinal":128308,"en":"My bloodthirsty leopard father"},{"id":"semetey-1-2013:p0671:b004:l010","ordinal":128309,"en":"Wore Akolpok in battle."},{"id":"semetey-1-2013:p0671:b004:l011","ordinal":128310,"en":"No bullet could pierce it in a firefight."},{"id":"semetey-1-2013:p0671:b004:l012","ordinal":128311,"en":"Its weft was exceptionally worked;"},{"id":"semetey-1-2013:p0671:b004:l013","ordinal":128312,"en":"Wearing it gladdened a person's heart."},{"id":"semetey-1-2013:p0671:b004:l014","ordinal":128313,"en":"Both padded armor and mail,"},{"id":"semetey-1-2013:p0671:b004:l015","ordinal":128314,"en":"Akolpok left by my father Manas,"},{"id":"semetey-1-2013:p0671:b004:l016","ordinal":128315,"en":"My poor, ill-fated mother Kanykei made it."},{"id":"semetey-1-2013:p0671:b004:l018","ordinal":128316,"en":"She twisted its weft sixfold,"},{"id":"semetey-1-2013:p0671:b004:l019","ordinal":128317,"en":"For the Great Campaign at Beijing,"},{"id":"semetey-1-2013:p0671:b004:l020","ordinal":128318,"en":"Intending it for that great slaughter."},{"id":"semetey-1-2013:p0671:b004:l021","ordinal":128319,"en":"Working it firmly with precious materials,"},{"id":"semetey-1-2013:p0671:b004:l022","ordinal":128320,"en":"She barely completed it in six years."},{"id":"semetey-1-2013:p0671:b004:l023","ordinal":128321,"en":"The shepherd of an entrusted life,"},{"id":"semetey-1-2013:p0671:b004:l024","ordinal":128322,"en":"There was no object like it."},{"id":"semetey-1-2013:p0671:b004:l025","ordinal":128323,"en":"Akolpok left by my father,"},{"id":"semetey-1-2013:p0671:b004:l026","ordinal":128324,"en":"It too seems to be in your hands."},{"id":"semetey-1-2013:p0671:b004:l027","ordinal":128325,"en":"Grandfather Zhakyp, give it back."},{"id":"semetey-1-2013:p0671:b004:l028","ordinal":128326,"en":"If you will not give the property I named,"},{"id":"semetey-1-2013:p0671:b004:l029","ordinal":128327,"en":"You are a wolf ready to tear me apart,"},{"id":"semetey-1-2013:p0671:b004:l030","ordinal":128328,"en":"The very embodiment of mischief."},{"id":"semetey-1-2013:p0671:b004:l031","ordinal":128329,"en":"Khan grandfather, you will see when I grow angry."},{"id":"semetey-1-2013:p0671:b004:l032","ordinal":128330,"en":"If you anger me again,"},{"id":"semetey-1-2013:p0671:b004:l033","ordinal":128331,"en":"Khan grandfather, you will die this instant."},{"id":"semetey-1-2013:p0671:b004:l034","ordinal":128332,"en":"For twelve years I did not see my people;"},{"id":"semetey-1-2013:p0671:b004:l035","ordinal":128333,"en":"I grew up wandering."},{"id":"semetey-1-2013:p0671:b004:l036","ordinal":128334,"en":"As soon as I come, you mix poison,"},{"id":"semetey-1-2013:p0671:b004:l037","ordinal":128335,"en":"And offer it upon my arrival."},{"id":"semetey-1-2013:p0671:b004:l038","ordinal":128336,"en":"Can there be a grandfather like you?"},{"id":"semetey-1-2013:p0671:b004:l039","ordinal":128337,"en":"You brought suffering upon my soul,"},{"id":"semetey-1-2013:p0672:b003:l001","ordinal":128338,"en":"Can anyone prosper who calls you father?"},{"id":"semetey-1-2013:p0672:b003:l002","ordinal":128339,"en":"Let me burn off your remaining hair,"},{"id":"semetey-1-2013:p0672:b003:l003","ordinal":128340,"en":"Pour in poison and see what happens"},{"id":"semetey-1-2013:p0672:b003:l004","ordinal":128341,"en":"To your head, my khan-father!”"},{"id":"semetey-1-2013:p0672:b003:l005","ordinal":128342,"en":"From blood-drinking, gray-maned Manas,"},{"id":"semetey-1-2013:p0672:b003:l006","ordinal":128343,"en":"Your dear one was born a blood-drinker."},{"id":"semetey-1-2013:p0672:b003:l007","ordinal":128344,"en":"Seizing the bowl, he said:"},{"id":"semetey-1-2013:p0672:b003:l008","ordinal":128345,"en":"“Wear your bowl on your head!"},{"id":"semetey-1-2013:p0672:b003:l009","ordinal":128346,"en":"I am not grateful at all"},{"id":"semetey-1-2013:p0672:b003:l010","ordinal":128347,"en":"For this food of yours steeped in poison.”"},{"id":"semetey-1-2013:p0672:b003:l011","ordinal":128348,"en":"He overturned the bowl"},{"id":"semetey-1-2013:p0672:b003:l012","ordinal":128349,"en":"On Khan Jakyp's head."},{"id":"semetey-1-2013:p0672:b003:l013","ordinal":128350,"en":"Then Jakyp's"},{"id":"semetey-1-2013:p0672:b003:l014","ordinal":128351,"en":"Hair burned with a hiss."},{"id":"semetey-1-2013:p0672:b003:l015","ordinal":128352,"en":"Did you see how strong the poison was?"},{"id":"semetey-1-2013:p0672:b003:l016","ordinal":128353,"en":"His beard and mustache"},{"id":"semetey-1-2013:p0672:b003:l017","ordinal":128354,"en":"Burned together, crackling."},{"id":"semetey-1-2013:p0672:b003:l018","ordinal":128355,"en":"His hair was gone; he was bald,"},{"id":"semetey-1-2013:p0672:b003:l019","ordinal":128356,"en":"Without mustache or beard."},{"id":"semetey-1-2013:p0672:b003:l020","ordinal":128357,"en":"Poor Khan Jakyp was dazed."},{"id":"semetey-1-2013:p0672:b003:l021","ordinal":128358,"en":"The skin of his head split;"},{"id":"semetey-1-2013:p0672:b003:l022","ordinal":128359,"en":"His dear boy Semetey grieved."},{"id":"semetey-1-2013:p0672:b003:l023","ordinal":128360,"en":"To cut Khan Jakyp down,"},{"id":"semetey-1-2013:p0672:b003:l024","ordinal":128361,"en":"The boy could not bring himself;"},{"id":"semetey-1-2013:p0672:b003:l025","ordinal":128362,"en":"Was to take his distant vengeance."},{"id":"semetey-1-2013:p0672:b003:l026","ordinal":128363,"en":"All the assembled people,"},{"id":"semetey-1-2013:p0672:b003:l027","ordinal":128364,"en":"Khan Jakyp had livestock;"},{"id":"semetey-1-2013:p0672:b003:l028","ordinal":128365,"en":"Kulchoro to pass slowly,"},{"id":"semetey-1-2013:p0672:b003:l029","ordinal":128366,"en":"The fool bore the name of “father.”"},{"id":"semetey-1-2013:p0672:b003:l030","ordinal":128367,"en":"Unable to raise a hand against his father,"},{"id":"semetey-1-2013:p0672:b003:l031","ordinal":128368,"en":"Semetey was in turmoil."},{"id":"semetey-1-2013:p0672:b003:l032","ordinal":128369,"en":"Semetey's newly arriving—"},{"id":"semetey-1-2013:p0672:b003:l033","ordinal":128370,"en":"Jakyp's being half dead!"},{"id":"semetey-1-2013:p0672:b003:l034","ordinal":128371,"en":"Blood-drinking Bakai, the leopard,"},{"id":"semetey-1-2013:p0672:b003:l035","ordinal":128372,"en":"To Khan Jakyp's home"},{"id":"semetey-1-2013:p0672:b003:l036","ordinal":128373,"en":"Had come to see him."},{"id":"semetey-1-2013:p0672:b003:l037","ordinal":128374,"en":"While tiger Manas was alive,"},{"id":"semetey-1-2013:p0672:b003:l038","ordinal":128375,"en":"While he was Manas's companion,"},{"id":"semetey-1-2013:p0672:b003:l039","ordinal":128376,"en":"Beijing with its khakan—"},{"id":"semetey-1-2013:p0672:b003:l040","ordinal":128377,"en":"When they drove on to besiege it,"},{"id":"semetey-1-2013:p0672:b004:l001","ordinal":128378,"en":"When they spread havoc,"},{"id":"semetey-1-2013:p0672:b004:l002","ordinal":128379,"en":"Thrusting spears and breaking ranks,"},{"id":"semetey-1-2013:p0672:b004:l003","ordinal":128380,"en":"Those whose time had come fell to shots."},{"id":"semetey-1-2013:p0672:b004:l004","ordinal":128381,"en":"There were salt marshes to ford,"},{"id":"semetey-1-2013:p0672:b004:l005","ordinal":128382,"en":"There were great trenches dug,"},{"id":"semetey-1-2013:p0672:b004:l006","ordinal":128383,"en":"In swarming China, many ditches;"},{"id":"semetey-1-2013:p0672:b004:l007","ordinal":128384,"en":"Stirring it from the very roots,"},{"id":"semetey-1-2013:p0672:b004:l008","ordinal":128385,"en":"When they slaughtered its swarming people,"},{"id":"semetey-1-2013:p0672:b004:l009","ordinal":128386,"en":"Esen Khan's treasury—"},{"id":"semetey-1-2013:p0672:b004:l010","ordinal":128387,"en":"When the Kyrgyz took it as booty,"},{"id":"semetey-1-2013:p0672:b004:l011","ordinal":128388,"en":"Your dear Bakai, the gray-maned hero,"},{"id":"semetey-1-2013:p0672:b004:l012","ordinal":128389,"en":"To his friend, gray-maned Manas,"},{"id":"semetey-1-2013:p0672:b004:l013","ordinal":128390,"en":"The gray saddlebags he had offered—"},{"id":"semetey-1-2013:p0672:b004:l014","ordinal":128391,"en":"Among Khan Jakyp's stacked belongings"},{"id":"semetey-1-2013:p0672:b004:l015","ordinal":128392,"en":"They lay put away."},{"id":"semetey-1-2013:p0672:b004:l016","ordinal":128393,"en":"As soon as mighty Bakai saw them,"},{"id":"semetey-1-2013:p0672:b004:l017","ordinal":128394,"en":"The dear man grew sorrowful."},{"id":"semetey-1-2013:p0672:b004:l018","ordinal":128395,"en":"Inside those saddlebags,"},{"id":"semetey-1-2013:p0672:b004:l019","ordinal":128396,"en":"Rubies and gold were mixed."},{"id":"semetey-1-2013:p0672:b004:l020","ordinal":128397,"en":"“These saddlebags left by Manas!” he said,"},{"id":"semetey-1-2013:p0672:b004:l021","ordinal":128398,"en":"Clinging to them, refusing to let go."},{"id":"semetey-1-2013:p0672:b004:l022","ordinal":128399,"en":"“My possessions left by King Manas!” he said."},{"id":"semetey-1-2013:p0672:b004:l024","ordinal":128400,"en":"Bakai struggled with the gray saddlebags."},{"id":"semetey-1-2013:p0672:b004:l026","ordinal":128401,"en":"To take them away as booty"},{"id":"semetey-1-2013:p0672:b004:l027","ordinal":128402,"en":"Semetey set his mind."},{"id":"semetey-1-2013:p0672:b004:l028","ordinal":128403,"en":"When he saw those saddlebags,"},{"id":"semetey-1-2013:p0672:b004:l029","ordinal":128404,"en":"“My possessions left by my father!” he said."},{"id":"semetey-1-2013:p0672:b004:l030","ordinal":128405,"en":"Grabbing him by the collar to train him,"},{"id":"semetey-1-2013:p0672:b004:l031","ordinal":128406,"en":"Bakai and Semetey,"},{"id":"semetey-1-2013:p0672:b004:l032","ordinal":128407,"en":"Both taking hold of the saddlebags,"},{"id":"semetey-1-2013:p0672:b004:l033","ordinal":128408,"en":"To Kökcholok's side"},{"id":"semetey-1-2013:p0672:b004:l034","ordinal":128409,"en":"Dragged them out."},{"id":"semetey-1-2013:p0672:b004:l035","ordinal":128410,"en":"Bakai stood pleading,"},{"id":"semetey-1-2013:p0672:b004:l036","ordinal":128411,"en":"“Put them on Kökcholok!” he said,"},{"id":"semetey-1-2013:p0672:b004:l037","ordinal":128412,"en":"Begging Semetey."},{"id":"semetey-1-2013:p0672:b004:l038","ordinal":128413,"en":"Semetey, the gray-maned hero's son,"},{"id":"semetey-1-2013:p0672:b004:l039","ordinal":128414,"en":"Could not load those saddlebags;"},{"id":"semetey-1-2013:p0672:b004:l040","ordinal":128415,"en":"A curse on his childishness!"},{"id":"semetey-1-2013:p0673:b003:l001","ordinal":128416,"en":"He could not even move them."},{"id":"semetey-1-2013:p0673:b003:l002","ordinal":128417,"en":"Khan Bakai grew angry:"},{"id":"semetey-1-2013:p0673:b003:l003","ordinal":128418,"en":"“Children nowadays"},{"id":"semetey-1-2013:p0673:b003:l004","ordinal":128419,"en":"Drink butter dregs and shit grass."},{"id":"semetey-1-2013:p0673:b003:l005","ordinal":128420,"en":"When I was a boy in the old days,"},{"id":"semetey-1-2013:p0673:b003:l006","ordinal":128421,"en":"Unheeding, mad and drunk,"},{"id":"semetey-1-2013:p0673:b003:l007","ordinal":128422,"en":"I made white deer into cattle;"},{"id":"semetey-1-2013:p0673:b003:l008","ordinal":128423,"en":"I threw the whole world into turmoil."},{"id":"semetey-1-2013:p0673:b003:l009","ordinal":128424,"en":"Wearing armor no shot could pierce,"},{"id":"semetey-1-2013:p0673:b003:l010","ordinal":128425,"en":"Not saddlebags, wretched boy—"},{"id":"semetey-1-2013:p0673:b003:l011","ordinal":128426,"en":"I grappled with the whole world."},{"id":"semetey-1-2013:p0673:b003:l012","ordinal":128427,"en":"Children nowadays,"},{"id":"semetey-1-2013:p0673:b003:l013","ordinal":128428,"en":"May the damned brats perish!"},{"id":"semetey-1-2013:p0673:b003:l014","ordinal":128429,"en":"They have not the strength for saddlebags."},{"id":"semetey-1-2013:p0673:b003:l015","ordinal":128430,"en":"Barefoot and bareheaded,"},{"id":"semetey-1-2013:p0673:b003:l016","ordinal":128431,"en":"There was a time when the earth shook."},{"id":"semetey-1-2013:p0673:b003:l017","ordinal":128432,"en":"My dear youth has passed away."},{"id":"semetey-1-2013:p0673:b003:l018","ordinal":128433,"en":"When I was a boy like you,"},{"id":"semetey-1-2013:p0673:b003:l019","ordinal":128434,"en":"I would roast whoever challenged me."},{"id":"semetey-1-2013:p0673:b003:l020","ordinal":128435,"en":"Not saddlebags, wretched boy—"},{"id":"semetey-1-2013:p0673:b003:l021","ordinal":128436,"en":"A birch tree growing there,"},{"id":"semetey-1-2013:p0673:b003:l022","ordinal":128437,"en":"I would tear it out by the roots."},{"id":"semetey-1-2013:p0673:b003:l023","ordinal":128438,"en":"Until they reach twenty,"},{"id":"semetey-1-2013:p0673:b003:l024","ordinal":128439,"en":"Children nowadays"},{"id":"semetey-1-2013:p0673:b003:l025","ordinal":128440,"en":"Are still mere children, it seems."},{"id":"semetey-1-2013:p0673:b003:l026","ordinal":128441,"en":"One boiling still left within them,"},{"id":"semetey-1-2013:p0673:b003:l027","ordinal":128442,"en":"They are still half-cooked, it seems.”"},{"id":"semetey-1-2013:p0673:b003:l028","ordinal":128443,"en":"So saying these words,"},{"id":"semetey-1-2013:p0673:b003:l029","ordinal":128444,"en":"His elder Bakai worked himself up,"},{"id":"semetey-1-2013:p0673:b003:l030","ordinal":128445,"en":"And spoke at Semetey."},{"id":"semetey-1-2013:p0673:b003:l031","ordinal":128446,"en":"Seizing the saddlebags,"},{"id":"semetey-1-2013:p0673:b003:l032","ordinal":128447,"en":"Lion Bakai, the saint,"},{"id":"semetey-1-2013:p0673:b003:l033","ordinal":128448,"en":"Blessed by Khizir from his roots,"},{"id":"semetey-1-2013:p0673:b003:l034","ordinal":128449,"en":"A peerless wrestler, a saint,"},{"id":"semetey-1-2013:p0673:b003:l035","ordinal":128450,"en":"To Father Manas, the lord,"},{"id":"semetey-1-2013:p0673:b003:l036","ordinal":128451,"en":"The elder who had been a companion,"},{"id":"semetey-1-2013:p0673:b003:l037","ordinal":128452,"en":"Coughing with deep rumbles,"},{"id":"semetey-1-2013:p0673:b003:l038","ordinal":128453,"en":"The saddlebags left by Manas"},{"id":"semetey-1-2013:p0673:b003:l039","ordinal":128454,"en":"He lifted with one hand."},{"id":"semetey-1-2013:p0673:b005:l001","ordinal":128455,"en":"In anger he swung them away;"},{"id":"semetey-1-2013:p0673:b005:l002","ordinal":128456,"en":"Your unfortunate one, born capable,"},{"id":"semetey-1-2013:p0673:b005:l003","ordinal":128457,"en":"Threw them onto Kökcholok."},{"id":"semetey-1-2013:p0673:b005:l004","ordinal":128458,"en":"Pleading with the Creator,"},{"id":"semetey-1-2013:p0673:b005:l005","ordinal":128459,"en":"Those gray saddlebags there,"},{"id":"semetey-1-2013:p0673:b005:l006","ordinal":128460,"en":"Your elder Bakai put them on Kökcholok,"},{"id":"semetey-1-2013:p0673:b005:l007","ordinal":128461,"en":"And mounted himself as well."},{"id":"semetey-1-2013:p0673:b005:l008","ordinal":128462,"en":"Semetey followed him."},{"id":"semetey-1-2013:p0673:b005:l009","ordinal":128463,"en":"From malicious Jakyp,"},{"id":"semetey-1-2013:p0673:b005:l010","ordinal":128464,"en":"Khan Manas's saddlebags"},{"id":"semetey-1-2013:p0673:b005:l011","ordinal":128465,"en":"He had seized and was taking away."},{"id":"semetey-1-2013:p0673:b005:l012","ordinal":128466,"en":"Warrior Bakai's Kökcholok,"},{"id":"semetey-1-2013:p0673:b005:l013","ordinal":128467,"en":"Under the weight of the saddlebags,"},{"id":"semetey-1-2013:p0673:b005:l014","ordinal":128468,"en":"Ah, that Kökcholok—"},{"id":"semetey-1-2013:p0673:b005:l015","ordinal":128469,"en":"Its fetlocks bending,"},{"id":"semetey-1-2013:p0673:b005:l016","ordinal":128470,"en":"His pasterns bent,"},{"id":"semetey-1-2013:p0673:b005:l017","ordinal":128471,"en":"His belly hung down to the ground."},{"id":"semetey-1-2013:p0673:b005:l018","ordinal":128472,"en":"“What will become of the dog?”"},{"id":"semetey-1-2013:p0673:b005:l019","ordinal":128473,"en":"Your elder Bakai looked about in alarm."},{"id":"semetey-1-2013:p0673:b005:l020","ordinal":128474,"en":"The horse's spine curved like a sickle;"},{"id":"semetey-1-2013:p0673:b005:l021","ordinal":128475,"en":"His ribs stood out."},{"id":"semetey-1-2013:p0673:b005:l022","ordinal":128476,"en":"His back bent and sagged."},{"id":"semetey-1-2013:p0673:b005:l023","ordinal":128477,"en":"Kökcholok stepped forward,"},{"id":"semetey-1-2013:p0673:b005:l024","ordinal":128478,"en":"That worthy noble steed,"},{"id":"semetey-1-2013:p0673:b005:l025","ordinal":128479,"en":"With a supple, ambling gait."},{"id":"semetey-1-2013:p0673:b005:l026","ordinal":128480,"en":"The wind could not match his trot;"},{"id":"semetey-1-2013:p0673:b005:l027","ordinal":128481,"en":"No beast could match his walk."},{"id":"semetey-1-2013:p0673:b005:l028","ordinal":128482,"en":"Steam billowed from his nostrils."},{"id":"semetey-1-2013:p0673:b005:l029","ordinal":128483,"en":"The black stones he trod upon"},{"id":"semetey-1-2013:p0673:b005:l030","ordinal":128484,"en":"Crumbled worse than charcoal."},{"id":"semetey-1-2013:p0673:b005:l031","ordinal":128485,"en":"Lord Bakai, your warrior elder,"},{"id":"semetey-1-2013:p0673:b005:l032","ordinal":128486,"en":"(Kayipchi's dark cave,"},{"id":"semetey-1-2013:p0673:b005:l033","ordinal":128487,"en":"When leopard Manas lived,"},{"id":"semetey-1-2013:p0673:b005:l034","ordinal":128488,"en":"The very cave where he hid treasure),"},{"id":"semetey-1-2013:p0673:b005:l035","ordinal":128489,"en":"To the cave where the treasury was gathered,"},{"id":"semetey-1-2013:p0673:b005:l036","ordinal":128490,"en":"He tipped and lowered them."},{"id":"semetey-1-2013:p0673:b005:l037","ordinal":128491,"en":"To that helpless one left by Manas,"},{"id":"semetey-1-2013:p0673:b005:l038","ordinal":128492,"en":"He handed over the gray saddlebags."},{"id":"semetey-1-2013:p0673:b005:l039","ordinal":128493,"en":"“The saddlebags left by Manas,” he said,"},{"id":"semetey-1-2013:p0673:b005:l040","ordinal":128494,"en":"Entrusting them to Bölökbai,"},{"id":"semetey-1-2013:p0674:b004:l001","ordinal":128495,"en":"Teaching what was unknown,"},{"id":"semetey-1-2013:p0674:b004:l002","ordinal":128496,"en":"The learned elder Bakai,"},{"id":"semetey-1-2013:p0674:b004:l003","ordinal":128497,"en":"Making the unperceived understood,"},{"id":"semetey-1-2013:p0674:b004:l004","ordinal":128498,"en":"Falcon Bakai, the saint."},{"id":"semetey-1-2013:p0674:b004:l005","ordinal":128499,"en":"As they rode farther on,"},{"id":"semetey-1-2013:p0674:b004:l006","ordinal":128500,"en":"Yellow foothills came into view."},{"id":"semetey-1-2013:p0674:b004:l007","ordinal":128501,"en":"Seeing the ridge, he wept;"},{"id":"semetey-1-2013:p0674:b004:l008","ordinal":128502,"en":"Jilgynduu, Keng-Kol, broad Talas—"},{"id":"semetey-1-2013:p0674:b004:l009","ordinal":128503,"en":"Seeing the land, he wept."},{"id":"semetey-1-2013:p0674:b004:l010","ordinal":128504,"en":"Kara-Buura and Chong-Chatkal—"},{"id":"semetey-1-2013:p0674:b004:l011","ordinal":128505,"en":"Seeing their mountainside hollows, he wept."},{"id":"semetey-1-2013:p0674:b004:l012","ordinal":128506,"en":"The multitude of Kyrgyz, the many Argin,"},{"id":"semetey-1-2013:p0674:b004:l013","ordinal":128507,"en":"Seeing where they had dwelt, he wept."},{"id":"semetey-1-2013:p0674:b004:l014","ordinal":128508,"en":"Your elder, leopard Bakai,"},{"id":"semetey-1-2013:p0674:b004:l015","ordinal":128509,"en":"The dark ridge where he used to stand watch—"},{"id":"semetey-1-2013:p0674:b004:l016","ordinal":128510,"en":"Seeing its peak, he wept."},{"id":"semetey-1-2013:p0674:b004:l017","ordinal":128511,"en":"God's sun grew overcast in the sky;"},{"id":"semetey-1-2013:p0674:b004:l018","ordinal":128512,"en":"Upon Khan Bakai's head,"}]
