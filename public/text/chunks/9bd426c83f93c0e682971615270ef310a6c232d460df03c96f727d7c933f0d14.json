[{"id":"manas-2010:p1196:b001:l003","ordinal":51969,"en":"My plane tree has lost its water."},{"id":"manas-2010:p1196:b001:l004","ordinal":51970,"en":"Sarala's manger,"},{"id":"manas-2010:p1196:b001:l005","ordinal":51971,"en":"The swarming multitude of Chinese"},{"id":"manas-2010:p1196:b001:l006","ordinal":51972,"en":"Divided by measuring with whips."},{"id":"manas-2010:p1196:b001:l007","ordinal":51973,"en":"My poor soul has died!"},{"id":"manas-2010:p1196:b001:l008","ordinal":51974,"en":"That pale stretch you see,"},{"id":"manas-2010:p1196:b001:l009","ordinal":51975,"en":"That is where I sowed my grain."},{"id":"manas-2010:p1196:b001:l010","ordinal":51976,"en":"There was no water flowing there before;"},{"id":"manas-2010:p1196:b001:l011","ordinal":51977,"en":"I made it spread over everything,"},{"id":"manas-2010:p1196:b001:l012","ordinal":51978,"en":"From the waters of Kürpüldök,"},{"id":"manas-2010:p1196:b001:l013","ordinal":51979,"en":"I dug an irrigation channel, Syrgak!"},{"id":"manas-2010:p1196:b001:l014","ordinal":51980,"en":"The peoples of six khans held a feast."},{"id":"manas-2010:p1196:b001:l015","ordinal":51981,"en":"When I was digging the channel,"},{"id":"manas-2010:p1196:b001:l016","ordinal":51982,"en":"They served me then"},{"id":"manas-2010:p1196:b001:l017","ordinal":51983,"en":"And named it Keng-Alysh."},{"id":"manas-2010:p1196:b001:l018","ordinal":51984,"en":"That channel I had dug,"},{"id":"manas-2010:p1196:b001:l019","ordinal":51985,"en":"I had its bed hollowed forty cubits deep,"},{"id":"manas-2010:p1196:b001:l020","ordinal":51986,"en":"Its upper banks leveled broadly,"},{"id":"manas-2010:p1196:b001:l021","ordinal":51987,"en":"And I fed the Chinese till they were full."},{"id":"manas-2010:p1196:b001:l022","ordinal":51988,"en":"When I lived in Beijing,"},{"id":"manas-2010:p1196:b001:l023","ordinal":51989,"en":"Almambet was a cherished soul."},{"id":"manas-2010:p1196:b001:l024","ordinal":51990,"en":"My eyes shone like Venus;"},{"id":"manas-2010:p1196:b001:l025","ordinal":51991,"en":"Sixty mothers cared for me;"},{"id":"manas-2010:p1196:b001:l026","ordinal":51992,"en":"Almambet was a pampered child, Syrgak!"},{"id":"manas-2010:p1196:b001:l027","ordinal":51993,"en":"In my days of play,"},{"id":"manas-2010:p1196:b001:l028","ordinal":51994,"en":"Whether it grew or did not,"},{"id":"manas-2010:p1196:b001:l029","ordinal":51995,"en":"For play and amusement,"},{"id":"manas-2010:p1196:b001:l030","ordinal":51996,"en":"I planted a willow, Syrgak!"},{"id":"manas-2010:p1196:b001:l031","ordinal":51997,"en":"Its shoot became a willow large as a house;"},{"id":"manas-2010:p1196:b001:l032","ordinal":51998,"en":"My fortune grew exceedingly;"},{"id":"manas-2010:p1196:b001:l033","ordinal":51999,"en":"Your Alma became khan of Beijing."},{"id":"manas-2010:p1196:b001:l034","ordinal":52000,"en":"Of that willow I had planted,"},{"id":"manas-2010:p1196:b001:l035","ordinal":52001,"en":"The multitude of Chinese then"},{"id":"manas-2010:p1196:b001:l036","ordinal":52002,"en":"Knew the sacred power."},{"id":"manas-2010:p1196:b001:l037","ordinal":52003,"en":"“It sprang up by itself,” they said;"},{"id":"manas-2010:p1196:b001:l038","ordinal":52004,"en":"The multitude of Chinese then"},{"id":"manas-2010:p1196:b001:l039","ordinal":52005,"en":"Bowed to it as a shrine,"},{"id":"manas-2010:p1196:b001:l040","ordinal":52006,"en":"Made pilgrimage to it."},{"id":"manas-2010:p1196:b001:l041","ordinal":52007,"en":"Such was the willow, Syrgak!"},{"id":"manas-2010:p1196:b001:l042","ordinal":52008,"en":"In those times gone by,"},{"id":"manas-2010:p1197:b001:l001","ordinal":52009,"en":"When I crossed the Zhapalak desert,"},{"id":"manas-2010:p1197:b001:l002","ordinal":52010,"en":"With the teeming Chinese people"},{"id":"manas-2010:p1197:b001:l003","ordinal":52011,"en":"I fought alone,"},{"id":"manas-2010:p1197:b001:l004","ordinal":52012,"en":"Suffering great hardship,"},{"id":"manas-2010:p1197:b001:l005","ordinal":52013,"en":"When I fled toward you,"},{"id":"manas-2010:p1197:b001:l006","ordinal":52014,"en":"The Chinese forty thousand, I alone,"},{"id":"manas-2010:p1197:b001:l007","ordinal":52015,"en":"When the Chinese singled me out,"},{"id":"manas-2010:p1197:b001:l008","ordinal":52016,"en":"At the gray hill before you,"},{"id":"manas-2010:p1197:b001:l009","ordinal":52017,"en":"The Chinese Kalcha slave,"},{"id":"manas-2010:p1197:b001:l010","ordinal":52018,"en":"Kongurbay caught up with me, Syrgak!"},{"id":"manas-2010:p1197:b001:l011","ordinal":52019,"en":"Striking once with his spear,"},{"id":"manas-2010:p1197:b001:l012","ordinal":52020,"en":"When Kongurbay pursued and passed,"},{"id":"manas-2010:p1197:b001:l013","ordinal":52021,"en":"The lacquered pipe in my mouth"},{"id":"manas-2010:p1197:b001:l014","ordinal":52022,"en":"Flew from my mouth, Syrgak!"},{"id":"manas-2010:p1197:b001:l015","ordinal":52023,"en":"Without looking behind me,"},{"id":"manas-2010:p1197:b001:l016","ordinal":52024,"en":"I took the straight road."},{"id":"manas-2010:p1197:b001:l017","ordinal":52025,"en":"Unable to retrieve the pipe,"},{"id":"manas-2010:p1197:b001:l018","ordinal":52026,"en":"‘If I return to Beijing,"},{"id":"manas-2010:p1197:b001:l019","ordinal":52027,"en":"I shall take it,’ I said, leaving it in trust."},{"id":"manas-2010:p1197:b001:l020","ordinal":52028,"en":"My days became sorrow,"},{"id":"manas-2010:p1197:b001:l021","ordinal":52029,"en":"My daylight became black night."},{"id":"manas-2010:p1197:b001:l022","ordinal":52030,"en":"Scatter its earth and see;"},{"id":"manas-2010:p1197:b001:l023","ordinal":52031,"en":"If you do not believe me,"},{"id":"manas-2010:p1197:b001:l024","ordinal":52032,"en":"Open the spot I strike and see, Syrgak!”"},{"id":"manas-2010:p1197:b001:l025","ordinal":52033,"en":"Holding his spear far out,"},{"id":"manas-2010:p1197:b001:l026","ordinal":52034,"en":"At sunset, in the gathering dusk,"},{"id":"manas-2010:p1197:b001:l027","ordinal":52035,"en":"Almambet struck the ground."},{"id":"manas-2010:p1197:b001:l028","ordinal":52036,"en":"The gray hill he had shown,"},{"id":"manas-2010:p1197:b001:l029","ordinal":52037,"en":"As Almambet pointed his spear at it,"},{"id":"manas-2010:p1197:b001:l030","ordinal":52038,"en":"Then Syrgak thought this:"},{"id":"manas-2010:p1197:b001:l031","ordinal":52039,"en":"“It is night, not day;"},{"id":"manas-2010:p1197:b001:l032","ordinal":52040,"en":"Since Almambet left,"},{"id":"manas-2010:p1197:b001:l033","ordinal":52041,"en":"So many years have passed."},{"id":"manas-2010:p1197:b001:l034","ordinal":52042,"en":"‘Kongurbay caught and speared me,’ he says,"},{"id":"manas-2010:p1197:b001:l035","ordinal":52043,"en":"‘My golden pipe remained,’ he says."},{"id":"manas-2010:p1197:b001:l036","ordinal":52044,"en":"Look at the lie he tells.”"},{"id":"manas-2010:p1197:b001:l037","ordinal":52045,"en":"With this, warrior Syrgak"},{"id":"manas-2010:p1197:b001:l038","ordinal":52046,"en":"Sprang down from his horse."},{"id":"manas-2010:p1197:b001:l039","ordinal":52047,"en":"The earth at the spear's point"},{"id":"manas-2010:p1197:b001:l040","ordinal":52048,"en":"He broke with his battle-axe,"},{"id":"manas-2010:p1197:b001:l041","ordinal":52049,"en":"Scattering the soil,"},{"id":"manas-2010:p1197:b001:l042","ordinal":52050,"en":"Digging open the point,"},{"id":"manas-2010:p1198:b001:l001","ordinal":52051,"en":"When he opened it and looked,"},{"id":"manas-2010:p1198:b001:l002","ordinal":52052,"en":"The pipe he had spoken of"},{"id":"manas-2010:p1198:b001:l003","ordinal":52053,"en":"Lay there at the point."},{"id":"manas-2010:p1198:b001:l004","ordinal":52054,"en":"When he pulled it out and held it,"},{"id":"manas-2010:p1198:b001:l005","ordinal":52055,"en":"When he had been golden,"},{"id":"manas-2010:p1198:b001:l006","ordinal":52056,"en":"Ruling Beijing,"},{"id":"manas-2010:p1198:b001:l007","ordinal":52057,"en":"He had rubies split and cut,"},{"id":"manas-2010:p1198:b001:l008","ordinal":52058,"en":"Upon the pipe's nipple"},{"id":"manas-2010:p1198:b001:l009","ordinal":52059,"en":"Turning the gems face-down,"},{"id":"manas-2010:p1198:b001:l010","ordinal":52060,"en":"He had them set in eye-shaped patterns."},{"id":"manas-2010:p1198:b001:l011","ordinal":52061,"en":"It had an aged appearance;"},{"id":"manas-2010:p1198:b001:l012","ordinal":52062,"en":"At the place one sucked"},{"id":"manas-2010:p1198:b001:l013","ordinal":52063,"en":"Was grime like rust."},{"id":"manas-2010:p1198:b001:l014","ordinal":52064,"en":"“These are the people of forty khans,” he said,"},{"id":"manas-2010:p1198:b001:l015","ordinal":52065,"en":"Telling Syrgak of his people."},{"id":"manas-2010:p1198:b001:l016","ordinal":52066,"en":"“This was my own dwelling place,” he said,"},{"id":"manas-2010:p1198:b001:l017","ordinal":52067,"en":"Telling Syrgak of his land."},{"id":"manas-2010:p1198:b001:l018","ordinal":52068,"en":"“Grieving for the land left behind,"},{"id":"manas-2010:p1198:b001:l019","ordinal":52069,"en":"What desire will we fulfill?"},{"id":"manas-2010:p1198:b001:l020","ordinal":52070,"en":"There, hazy and angled,"},{"id":"manas-2010:p1198:b001:l021","ordinal":52071,"en":"Drawing to a pointed corner,"},{"id":"manas-2010:p1198:b001:l022","ordinal":52072,"en":"Esenkan's daughter Burulcha"},{"id":"manas-2010:p1198:b001:l023","ordinal":52073,"en":"Lies bored there."},{"id":"manas-2010:p1198:b001:l024","ordinal":52074,"en":"Waiting for me, the poor soul"},{"id":"manas-2010:p1198:b001:l025","ordinal":52075,"en":"Lies weary there."},{"id":"manas-2010:p1198:b001:l026","ordinal":52076,"en":"We shall greet her as we go, Syrgak!"},{"id":"manas-2010:p1198:b001:l027","ordinal":52077,"en":"If we do not reach that place,"},{"id":"manas-2010:p1198:b001:l028","ordinal":52078,"en":"If we do not greet her before leaving,"},{"id":"manas-2010:p1198:b001:l029","ordinal":52079,"en":"Will she not think us ignorant?"},{"id":"manas-2010:p1198:b001:l030","ordinal":52080,"en":"‘For so many years I burned,’ she will say,"},{"id":"manas-2010:p1198:b001:l031","ordinal":52081,"en":"‘I went bearing grief,’ she will say."},{"id":"manas-2010:p1198:b001:l032","ordinal":52082,"en":"When we reach the afterlife,"},{"id":"manas-2010:p1198:b001:l033","ordinal":52083,"en":"Will she not make me a black donkey and ride me?"},{"id":"manas-2010:p1198:b001:l034","ordinal":52084,"en":"Will it not break the oath we swore?"},{"id":"manas-2010:p1198:b001:l035","ordinal":52085,"en":"‘He left without greeting me,’ she will say."},{"id":"manas-2010:p1198:b001:l036","ordinal":52086,"en":"Burulcha, who has borne such sorrow,"},{"id":"manas-2010:p1198:b001:l037","ordinal":52087,"en":"Will she not give up all hope, Syrgak!”"},{"id":"manas-2010:p1198:b001:l038","ordinal":52088,"en":"Said Almambet then,"},{"id":"manas-2010:p1198:b001:l039","ordinal":52089,"en":"Rumbling and prancing,"},{"id":"manas-2010:p1198:b001:l040","ordinal":52090,"en":"Sarala beneath him,"},{"id":"manas-2010:p1198:b001:l041","ordinal":52091,"en":"Slithering like an arrow-snake,"},{"id":"manas-2010:p1198:b001:l042","ordinal":52092,"en":"Onto a yellow plain smooth as a blade,"},{"id":"manas-2010:p1199:b001:l001","ordinal":52093,"en":"When they reached it in an instant,"},{"id":"manas-2010:p1199:b001:l002","ordinal":52094,"en":"There was no hill as big as a knucklebone,"},{"id":"manas-2010:p1199:b001:l003","ordinal":52095,"en":"No ravine as big as a knucklebone,"},{"id":"manas-2010:p1199:b001:l004","ordinal":52096,"en":"No furrow where a plow had passed,"},{"id":"manas-2010:p1199:b001:l005","ordinal":52097,"en":"Badger, marmot and mouse"},{"id":"manas-2010:p1199:b001:l006","ordinal":52098,"en":"Had dug no burrows there."},{"id":"manas-2010:p1199:b001:l007","ordinal":52099,"en":"When they entered the plain,"},{"id":"manas-2010:p1199:b001:l008","ordinal":52100,"en":"Stake-necked Sarala,"},{"id":"manas-2010:p1199:b001:l009","ordinal":52101,"en":"Sending him flying like a winged thing,"},{"id":"manas-2010:p1199:b001:l010","ordinal":52102,"en":"Cow-rumped Sarala,"},{"id":"manas-2010:p1199:b001:l011","ordinal":52103,"en":"Springing like a flying bird,"},{"id":"manas-2010:p1199:b001:l012","ordinal":52104,"en":"Almambet sent him surging."},{"id":"manas-2010:p1199:b001:l013","ordinal":52105,"en":"Leading Kartküröng,"},{"id":"manas-2010:p1199:b001:l014","ordinal":52106,"en":"The wind could not catch his trot;"},{"id":"manas-2010:p1199:b001:l015","ordinal":52107,"en":"At a cry of “Go!” no bullet could catch him."},{"id":"manas-2010:p1199:b001:l016","ordinal":52108,"en":"Galloping along behind,"},{"id":"manas-2010:p1199:b001:l017","ordinal":52109,"en":"Coming at his rear"},{"id":"manas-2010:p1199:b001:l018","ordinal":52110,"en":"Was lion Syrgak, the lord."},{"id":"manas-2010:p1199:b001:l019","ordinal":52111,"en":"For several days they traveled, growing restless."},{"id":"manas-2010:p1199:b001:l020","ordinal":52112,"en":"Kürpüldök's Sary-Suu,"},{"id":"manas-2010:p1199:b001:l021","ordinal":52113,"en":"They came upon the river."},{"id":"manas-2010:p1199:b001:l022","ordinal":52114,"en":"Look along the banks of Sary-Suu:"},{"id":"manas-2010:p1199:b001:l023","ordinal":52115,"en":"It bends among hollow after hollow;"},{"id":"manas-2010:p1199:b001:l024","ordinal":52116,"en":"The grass in the hollows thins."},{"id":"manas-2010:p1199:b001:l025","ordinal":52117,"en":"From the broad branches of the hills"},{"id":"manas-2010:p1199:b001:l026","ordinal":52118,"en":"Wild asses pour down to the water."},{"id":"manas-2010:p1199:b001:l027","ordinal":52119,"en":"Along Sary-Suu lies a valley."},{"id":"manas-2010:p1199:b001:l028","ordinal":52120,"en":"If you look at this valley,"},{"id":"manas-2010:p1199:b001:l029","ordinal":52121,"en":"Its leaves are like hides,"},{"id":"manas-2010:p1199:b001:l030","ordinal":52122,"en":"Its black spiders thick as thumbs,"},{"id":"manas-2010:p1199:b001:l031","ordinal":52123,"en":"Its sorrel thick as wrists."},{"id":"manas-2010:p1199:b001:l032","ordinal":52124,"en":"When its hinds burst out in fright,"},{"id":"manas-2010:p1199:b001:l033","ordinal":52125,"en":"They are like cows fleeing biting flies."},{"id":"manas-2010:p1199:b001:l034","ordinal":52126,"en":"There is distant snow upon its mountains,"},{"id":"manas-2010:p1199:b001:l035","ordinal":52127,"en":"There are rooks in its forest."},{"id":"manas-2010:p1199:b001:l036","ordinal":52128,"en":"Looking through the valley,"},{"id":"manas-2010:p1199:b001:l037","ordinal":52129,"en":"Every living creature is there."},{"id":"manas-2010:p1199:b001:l038","ordinal":52130,"en":"There are stags in its hollows,"},{"id":"manas-2010:p1199:b001:l039","ordinal":52131,"en":"Otters in its sandy water,"},{"id":"manas-2010:p1199:b001:l040","ordinal":52132,"en":"Creatures moving about,"},{"id":"manas-2010:p1199:b001:l041","ordinal":52133,"en":"Meadows in every corner,"},{"id":"manas-2010:p1199:b001:l042","ordinal":52134,"en":"Where even a mouse's nose could not pass,"},{"id":"manas-2010:p1200:b001:l001","ordinal":52135,"en":"There is dense forest too."},{"id":"manas-2010:p1200:b001:l002","ordinal":52136,"en":"Within that forest,"},{"id":"manas-2010:p1200:b001:l003","ordinal":52137,"en":"Heaped in house-sized mounds,"},{"id":"manas-2010:p1200:b001:l004","ordinal":52138,"en":"Are towers of red sand."},{"id":"manas-2010:p1200:b001:l005","ordinal":52139,"en":"Along the bases of the towers"},{"id":"manas-2010:p1200:b001:l006","ordinal":52140,"en":"Stand plane trees like minarets."},{"id":"manas-2010:p1200:b001:l007","ordinal":52141,"en":"Anyone who sees the plane trees once"},{"id":"manas-2010:p1200:b001:l008","ordinal":52142,"en":"Longs to see them again."},{"id":"manas-2010:p1200:b001:l009","ordinal":52143,"en":"Its apples fall and become manure,"},{"id":"manas-2010:p1200:b001:l010","ordinal":52144,"en":"For bears and corsac foxes"},{"id":"manas-2010:p1200:b001:l011","ordinal":52145,"en":"They become food to eat."},{"id":"manas-2010:p1200:b001:l012","ordinal":52146,"en":"Its walnuts ripen and fill the gullies,"},{"id":"manas-2010:p1200:b001:l013","ordinal":52147,"en":"Its apricots ripen, filled with fat,"},{"id":"manas-2010:p1200:b001:l014","ordinal":52148,"en":"Its pistachios ripen into honey."},{"id":"manas-2010:p1200:b001:l015","ordinal":52149,"en":"A land complete in every blessing:"},{"id":"manas-2010:p1200:b001:l016","ordinal":52150,"en":"Those who see it stand astonished."},{"id":"manas-2010:p1200:b001:l017","ordinal":52151,"en":"When nightingales sing in the plane trees,"},{"id":"manas-2010:p1200:b001:l018","ordinal":52152,"en":"A person could not leave its midst."},{"id":"manas-2010:p1200:b001:l019","ordinal":52153,"en":"Amazed at their warbling,"},{"id":"manas-2010:p1200:b001:l020","ordinal":52154,"en":"A sorrowful person could not bear to hear it."},{"id":"manas-2010:p1200:b001:l021","ordinal":52155,"en":"Your Alma could not stay still, restless."},{"id":"manas-2010:p1200:b001:l022","ordinal":52156,"en":"The words your Alma spoke,"},{"id":"manas-2010:p1200:b001:l023","ordinal":52157,"en":"Syrgak stood hearing once again."},{"id":"manas-2010:p1200:b001:l024","ordinal":52158,"en":"“What you see before us"},{"id":"manas-2010:p1200:b001:l025","ordinal":52159,"en":"Is the river Kürpüldök."},{"id":"manas-2010:p1200:b001:l026","ordinal":52160,"en":"Unless a winged creature flies across,"},{"id":"manas-2010:p1200:b001:l027","ordinal":52161,"en":"No one can endure fording it,"},{"id":"manas-2010:p1200:b001:l028","ordinal":52162,"en":"No child of humankind."},{"id":"manas-2010:p1200:b001:l029","ordinal":52163,"en":"Its name is Kürpüldök,"},{"id":"manas-2010:p1200:b001:l030","ordinal":52164,"en":"A fiercely flowing river."},{"id":"manas-2010:p1200:b001:l031","ordinal":52165,"en":"Its roar is heard far away,"},{"id":"manas-2010:p1200:b001:l032","ordinal":52166,"en":"The mountains echoing, booming."},{"id":"manas-2010:p1200:b001:l033","ordinal":52167,"en":"The Chinese people of forty khans,"},{"id":"manas-2010:p1200:b001:l034","ordinal":52168,"en":"I pressed them and had them gathered."},{"id":"manas-2010:p1200:b001:l035","ordinal":52169,"en":"An iron-bound bridge"},{"id":"manas-2010:p1200:b001:l036","ordinal":52170,"en":"There is a path for a single horse."},{"id":"manas-2010:p1200:b001:l037","ordinal":52171,"en":"I did not pull away its rope as I fled,"},{"id":"manas-2010:p1200:b001:l038","ordinal":52172,"en":"Almambet has his misfortune."},{"id":"manas-2010:p1200:b001:l039","ordinal":52173,"en":"Now let me tell you my secret,"},{"id":"manas-2010:p1200:b001:l040","ordinal":52174,"en":"My precious Syrgak:"},{"id":"manas-2010:p1200:b001:l041","ordinal":52175,"en":"I have crossed this river many times."},{"id":"manas-2010:p1200:b001:l042","ordinal":52176,"en":"That is why he will not go astray,"},{"id":"manas-2010:p1201:b001:l001","ordinal":52177,"en":"Sarala beneath me,"},{"id":"manas-2010:p1201:b001:l002","ordinal":52178,"en":"From the ford he himself has crossed."},{"id":"manas-2010:p1201:b001:l003","ordinal":52179,"en":"A place crossed so many times,"},{"id":"manas-2010:p1201:b001:l004","ordinal":52180,"en":"Fighting the Chinese,"},{"id":"manas-2010:p1201:b001:l005","ordinal":52181,"en":"A place where I crossed this river."},{"id":"manas-2010:p1201:b001:l006","ordinal":52182,"en":"Where Sarala crosses,"},{"id":"manas-2010:p1201:b001:l007","ordinal":52183,"en":"Do not turn elsewhere;"},{"id":"manas-2010:p1201:b001:l008","ordinal":52184,"en":"Cross just as he crosses."},{"id":"manas-2010:p1201:b001:l009","ordinal":52185,"en":"From Sarala's trail,"},{"id":"manas-2010:p1201:b001:l010","ordinal":52186,"en":"My Syrgak, never stray."},{"id":"manas-2010:p1201:b001:l011","ordinal":52187,"en":"Such is the way through the water."},{"id":"manas-2010:p1201:b001:l012","ordinal":52188,"en":"In my saddlebag, my Syrgak,"},{"id":"manas-2010:p1201:b001:l013","ordinal":52189,"en":"My father Azizkan's,"},{"id":"manas-2010:p1201:b001:l014","ordinal":52190,"en":"The one he wore on outings,"},{"id":"manas-2010:p1201:b001:l015","ordinal":52191,"en":"There is the robe of the half-khan."},{"id":"manas-2010:p1201:b001:l016","ordinal":52192,"en":"I shall put on the robe."},{"id":"manas-2010:p1201:b001:l017","ordinal":52193,"en":"Upon the dark mass of Chinese,"},{"id":"manas-2010:p1201:b001:l018","ordinal":52194,"en":"Watch, my Syrgak,"},{"id":"manas-2010:p1201:b001:l019","ordinal":52195,"en":"I shall bring a great commotion!”"},{"id":"manas-2010:p1201:b001:l020","ordinal":52196,"en":"A white saddlebag at the saddle straps,"},{"id":"manas-2010:p1201:b001:l021","ordinal":52197,"en":"A saddlebag fitting the leopard."},{"id":"manas-2010:p1201:b001:l022","ordinal":52198,"en":"When he took the saddlebag and looked,"},{"id":"manas-2010:p1201:b001:l023","ordinal":52199,"en":"It was of shining gold."},{"id":"manas-2010:p1201:b001:l024","ordinal":52200,"en":"That Beijing would become an enemy,"},{"id":"manas-2010:p1201:b001:l025","ordinal":52201,"en":"Had he not known it when he left?"},{"id":"manas-2010:p1201:b001:l026","ordinal":52202,"en":"“If I return to raid the Chinese,"},{"id":"manas-2010:p1201:b001:l027","ordinal":52203,"en":"The robe will be of use,” he said."},{"id":"manas-2010:p1201:b001:l028","ordinal":52204,"en":"Azizkan's Almambet,"},{"id":"manas-2010:p1201:b001:l029","ordinal":52205,"en":"Thinking of this from the beginning,"},{"id":"manas-2010:p1201:b001:l030","ordinal":52206,"en":"Had he not worn it away?"},{"id":"manas-2010:p1201:b001:l031","ordinal":52207,"en":"Thus Almambet,"},{"id":"manas-2010:p1201:b001:l032","ordinal":52208,"en":"His father's robe of rank,"},{"id":"manas-2010:p1201:b001:l033","ordinal":52209,"en":"When he donned it, standing proudly,"},{"id":"manas-2010:p1201:b001:l034","ordinal":52210,"en":"Rubies had been cut,"},{"id":"manas-2010:p1201:b001:l035","ordinal":52211,"en":"Upon the robe's breast"},{"id":"manas-2010:p1201:b001:l036","ordinal":52212,"en":"Precious stones had been set."},{"id":"manas-2010:p1201:b001:l037","ordinal":52213,"en":"Written and signed in Chinese"},{"id":"manas-2010:p1201:b001:l038","ordinal":52214,"en":"By Karykan in Great Beijing:"},{"id":"manas-2010:p1201:b001:l039","ordinal":52215,"en":"“To Beijing's half-khan"},{"id":"manas-2010:p1201:b001:l040","ordinal":52216,"en":"I have given it,” he truly signed."},{"id":"manas-2010:p1201:b001:l041","ordinal":52217,"en":"The thing that would prove useful"},{"id":"manas-2010:p1201:b001:l042","ordinal":52218,"en":"He had kept without creasing it."},{"id":"manas-2010:p1202:b001:l001","ordinal":52219,"en":"On both sides, by the kidneys,"},{"id":"manas-2010:p1202:b001:l002","ordinal":52220,"en":"Pearls as large as sheep droppings"},{"id":"manas-2010:p1202:b001:l003","ordinal":52221,"en":"He had fastened in rows."},{"id":"manas-2010:p1202:b001:l004","ordinal":52222,"en":"Warrior Syrgak, looking on,"},{"id":"manas-2010:p1202:b001:l005","ordinal":52223,"en":"“He is a true Chinese,” he said,"},{"id":"manas-2010:p1202:b001:l006","ordinal":52224,"en":"Admiring Almambet."}]
