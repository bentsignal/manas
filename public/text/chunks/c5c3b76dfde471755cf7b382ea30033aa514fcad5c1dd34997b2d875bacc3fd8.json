[{"id":"seytek-2012:p0336:b003:l019","ordinal":319233,"en":"Complicated Kyrgyz, many traditions"},{"id":"seytek-2012:p0336:b003:l020","ordinal":319234,"en":"Taking people as sinners,"},{"id":"seytek-2012:p0336:b003:l021","ordinal":319235,"en":"Kan-Zhaylak is a dark place"},{"id":"seytek-2012:p0336:b003:l022","ordinal":319236,"en":"The guard made a decision,"},{"id":"seytek-2012:p0336:b003:l023","ordinal":319237,"en":"Like what you get from the enemy,"},{"id":"seytek-2012:p0336:b003:l024","ordinal":319238,"en":"This pig made a bad fight,"},{"id":"seytek-2012:p0336:b003:l025","ordinal":319239,"en":"Take a piece from the female,"},{"id":"seytek-2012:p0336:b003:l026","ordinal":319240,"en":"Proud and strong,"},{"id":"seytek-2012:p0336:b003:l027","ordinal":319241,"en":"Shamelessly took the girl,"},{"id":"seytek-2012:p0336:b003:l028","ordinal":319242,"en":"A dead fire extinguisher"},{"id":"seytek-2012:p0336:b003:l029","ordinal":319243,"en":"He didn't listen to me when I begged."},{"id":"seytek-2012:p0336:b003:l030","ordinal":319244,"en":"He slapped my back."},{"id":"seytek-2012:p0336:b003:l031","ordinal":319245,"en":"I weave my way,"},{"id":"seytek-2012:p0336:b003:l032","ordinal":319246,"en":"People, tie my hands without strings."},{"id":"seytek-2012:p0336:b003:l033","ordinal":319247,"en":"You see, the pervert Kanchoro,"},{"id":"seytek-2012:p0336:b003:l034","ordinal":319248,"en":"It was great to see a lot of people."},{"id":"seytek-2012:p0336:b003:l035","ordinal":319249,"en":"Eren took the camel slowly,"},{"id":"seytek-2012:p0336:b003:l036","ordinal":319250,"en":"A man killed a mare,"},{"id":"seytek-2012:p0336:b003:l037","ordinal":319251,"en":"Suffering and quarreling"},{"id":"seytek-2012:p0336:b003:l038","ordinal":319252,"en":"Moved to meet Kiya,"},{"id":"seytek-2012:p0336:b003:l039","ordinal":319253,"en":"Kayasayak gave it"},{"id":"seytek-2012:p0336:b003:l040","ordinal":319254,"en":"Revenge by killing"}]
