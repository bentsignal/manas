[{"id":"semetey-2-2013:p0937:b003:l019","ordinal":257793,"en":"Whose sight gladdened every beholder—"},{"id":"semetey-2-2013:p0937:b003:l020","ordinal":257794,"en":"The gray wolf Külchoro—"},{"id":"semetey-2-2013:p0937:b003:l021","ordinal":257795,"en":"A nimble and keen-edged hero,"},{"id":"semetey-2-2013:p0937:b003:l022","ordinal":257796,"en":"If you ask about that fierce man’s nature,"},{"id":"semetey-2-2013:p0937:b003:l023","ordinal":257797,"en":"Was just such a sage."},{"id":"semetey-2-2013:p0937:b003:l024","ordinal":257798,"en":"Speaking softly but with great weight,"},{"id":"semetey-2-2013:p0937:b003:l025","ordinal":257799,"en":"Külchoro began to speak:"},{"id":"semetey-2-2013:p0937:b003:l026","ordinal":257800,"en":"“Great and small are gathered here;"},{"id":"semetey-2-2013:p0937:b003:l027","ordinal":257801,"en":"Your elders stand here."},{"id":"semetey-2-2013:p0937:b003:l028","ordinal":257802,"en":"Khan Ezkara and Kongurbay,"},{"id":"semetey-2-2013:p0937:b003:l029","ordinal":257803,"en":"All of you stand here."},{"id":"semetey-2-2013:p0937:b003:l030","ordinal":257804,"en":"Your elders of forty tribes,"},{"id":"semetey-2-2013:p0937:b003:l031","ordinal":257805,"en":"Countless as ants, stand here;"},{"id":"semetey-2-2013:p0937:b003:l032","ordinal":257806,"en":"All your warriors who boast of valor"},{"id":"semetey-2-2013:p0937:b003:l033","ordinal":257807,"en":"Stand here."},{"id":"semetey-2-2013:p0937:b003:l034","ordinal":257808,"en":"Those most skilled in the stratagems of war,"},{"id":"semetey-2-2013:p0937:b003:l035","ordinal":257809,"en":"Your champions stand here."},{"id":"semetey-2-2013:p0937:b003:l036","ordinal":257810,"en":"Among the spear-wielding warriors,"},{"id":"semetey-2-2013:p0937:b003:l037","ordinal":257811,"en":"Your most capable men stand here,"},{"id":"semetey-2-2013:p0937:b003:l038","ordinal":257812,"en":"Ready now to look upon"},{"id":"semetey-2-2013:p0937:b003:l039","ordinal":257813,"en":"The ordeal of a six-month journey—"},{"id":"semetey-2-2013:p0937:b005:l001","ordinal":257814,"en":"Your mighty one stands here."},{"id":"semetey-2-2013:p0937:b005:l002","ordinal":257815,"en":"Your wise one is your khan."},{"id":"semetey-2-2013:p0937:b005:l003","ordinal":257816,"en":"All of you, great and small,"},{"id":"semetey-2-2013:p0937:b005:l004","ordinal":257817,"en":"Are wondrously capable,"},{"id":"semetey-2-2013:p0937:b005:l005","ordinal":257818,"en":"Mighty cultivators of wisdom."},{"id":"semetey-2-2013:p0937:b005:l006","ordinal":257819,"en":"My child, the valiant blood-spiller Semetey,"},{"id":"semetey-2-2013:p0937:b005:l007","ordinal":257820,"en":"Son of Manas, had said:"},{"id":"semetey-2-2013:p0937:b005:l008","ordinal":257821,"en":"“Bring me my uncle’s idol;"},{"id":"semetey-2-2013:p0937:b005:l009","ordinal":257822,"en":"Before the fair-faced Chinese"},{"id":"semetey-2-2013:p0937:b005:l010","ordinal":257823,"en":"I shall truly bow in reverence.”"},{"id":"semetey-2-2013:p0937:b005:l011","ordinal":257824,"en":"Your graybeard, old Kalcha,"},{"id":"semetey-2-2013:p0937:b005:l012","ordinal":257825,"en":"Take heed, all you people!"},{"id":"semetey-2-2013:p0937:b005:l013","ordinal":257826,"en":"What kind of idol is he going for,"},{"id":"semetey-2-2013:p0937:b005:l014","ordinal":257827,"en":"Or what kind of idol has he left behind?"},{"id":"semetey-2-2013:p0937:b005:l015","ordinal":257828,"en":"When a bronze-shafted spear strikes,"},{"id":"semetey-2-2013:p0937:b005:l016","ordinal":257829,"en":"And a grave, weighty deed is at hand,"},{"id":"semetey-2-2013:p0937:b005:l017","ordinal":257830,"en":"What use is caution?"},{"id":"semetey-2-2013:p0937:b005:l018","ordinal":257831,"en":"What kind of idol is he going for?"},{"id":"semetey-2-2013:p0937:b005:l019","ordinal":257832,"en":"Mighty Bakai and Semetey,"},{"id":"semetey-2-2013:p0937:b005:l020","ordinal":257833,"en":"The two khans, had said:"},{"id":"semetey-2-2013:p0937:b005:l021","ordinal":257834,"en":"“If he counts us as kin,"},{"id":"semetey-2-2013:p0937:b005:l022","ordinal":257835,"en":"And does not call us Buruts,"},{"id":"semetey-2-2013:p0937:b005:l023","ordinal":257836,"en":"He will heed the words we speak."},{"id":"semetey-2-2013:p0937:b005:l024","ordinal":257837,"en":"If his spoken word is true,"},{"id":"semetey-2-2013:p0937:b005:l025","ordinal":257838,"en":"If what he says is bright and pure,"},{"id":"semetey-2-2013:p0937:b005:l026","ordinal":257839,"en":"If the revered Kongurbai"},{"id":"semetey-2-2013:p0937:b005:l027","ordinal":257840,"en":"Is truly a khan,"},{"id":"semetey-2-2013:p0937:b005:l028","ordinal":257841,"en":"If there truly is"},{"id":"semetey-2-2013:p0937:b005:l029","ordinal":257842,"en":"Some sacred power within him,"},{"id":"semetey-2-2013:p0937:b005:l030","ordinal":257843,"en":"If falcon-like Kalcha"},{"id":"semetey-2-2013:p0937:b005:l031","ordinal":257844,"en":"Is truly keen and bold,"},{"id":"semetey-2-2013:p0937:b005:l032","ordinal":257845,"en":"Then he will heed these words."},{"id":"semetey-2-2013:p0937:b005:l033","ordinal":257846,"en":"Old Kalcha will surely give"},{"id":"semetey-2-2013:p0937:b005:l034","ordinal":257847,"en":"The great idol he worships.”"},{"id":"semetey-2-2013:p0937:b005:l035","ordinal":257848,"en":"If you are willing, give the idol"},{"id":"semetey-2-2013:p0937:b005:l036","ordinal":257849,"en":"To Semetey."},{"id":"semetey-2-2013:p0937:b005:l037","ordinal":257850,"en":"To the silver-eyed, sun-eyed,"},{"id":"semetey-2-2013:p0937:b005:l038","ordinal":257851,"en":"Thunderous champion,"},{"id":"semetey-2-2013:p0937:b005:l039","ordinal":257852,"en":"Say, “Here, Kalcha has given it.”"},{"id":"semetey-2-2013:p0938:b003:l001","ordinal":257853,"en":"Let me take him as a gift,"},{"id":"semetey-2-2013:p0938:b003:l002","ordinal":257854,"en":"And bring the gray wolf Semetey"},{"id":"semetey-2-2013:p0938:b003:l003","ordinal":257855,"en":"Before you."},{"id":"semetey-2-2013:p0938:b003:l004","ordinal":257856,"en":"Agree to what he says,"},{"id":"semetey-2-2013:p0938:b003:l005","ordinal":257857,"en":"And without quarrel or strife,"},{"id":"semetey-2-2013:p0938:b003:l006","ordinal":257858,"en":"Lead him safely to the Khagan."},{"id":"semetey-2-2013:p0938:b003:l007","ordinal":257859,"en":"Pay the blood-price"},{"id":"semetey-2-2013:p0938:b003:l008","ordinal":257860,"en":"For his lion father Manas, then return."},{"id":"semetey-2-2013:p0938:b003:l009","ordinal":257861,"en":"All the people have gathered;"},{"id":"semetey-2-2013:p0938:b003:l010","ordinal":257862,"en":"We have come to face our reckoning."},{"id":"semetey-2-2013:p0938:b003:l011","ordinal":257863,"en":"After so many Chinese were slaughtered,"},{"id":"semetey-2-2013:p0938:b003:l012","ordinal":257864,"en":"We have come to this pass."},{"id":"semetey-2-2013:p0938:b003:l013","ordinal":257865,"en":"Know that this is what I counsel;"},{"id":"semetey-2-2013:p0938:b003:l014","ordinal":257866,"en":"Uncle Kalcha, heed my words."},{"id":"semetey-2-2013:p0938:b003:l015","ordinal":257867,"en":"Remain here and guard Beijing;"},{"id":"semetey-2-2013:p0938:b003:l016","ordinal":257868,"en":"Make peace with the champion Semetey."},{"id":"semetey-2-2013:p0938:b003:l017","ordinal":257869,"en":"Negotiate without wrangling,"},{"id":"semetey-2-2013:p0938:b003:l018","ordinal":257870,"en":"Do not quarrel and fight;"},{"id":"semetey-2-2013:p0938:b003:l019","ordinal":257871,"en":"Return as a people reconciled."},{"id":"semetey-2-2013:p0938:b003:l020","ordinal":257872,"en":"Yesterday there was clamorous uproar,"},{"id":"semetey-2-2013:p0938:b003:l021","ordinal":257873,"en":"And we began this grievous ordeal."},{"id":"semetey-2-2013:p0938:b003:l022","ordinal":257874,"en":"What horn of plenty ever sprang"},{"id":"semetey-2-2013:p0938:b003:l023","ordinal":257875,"en":"From the hollow of Kaspan-Too,"},{"id":"semetey-2-2013:p0938:b003:l024","ordinal":257876,"en":"From the banks of the Kara-Suu,"},{"id":"semetey-2-2013:p0938:b003:l025","ordinal":257877,"en":"From the slopes of Kyr-Kayıng,"},{"id":"semetey-2-2013:p0938:b003:l026","ordinal":257878,"en":"Or from the edge of Kyl-Irtysh?"},{"id":"semetey-2-2013:p0938:b003:l027","ordinal":257879,"en":"We tore at one another’s beards and hair,"},{"id":"semetey-2-2013:p0938:b003:l028","ordinal":257880,"en":"Fired guns and loosed arrows,"},{"id":"semetey-2-2013:p0938:b003:l029","ordinal":257881,"en":"And fought in bloody struggle—"},{"id":"semetey-2-2013:p0938:b003:l030","ordinal":257882,"en":"What benefit ever came of it?"},{"id":"semetey-2-2013:p0938:b003:l031","ordinal":257883,"en":"From battle, turmoil, and war,"},{"id":"semetey-2-2013:p0938:b003:l032","ordinal":257884,"en":"From this wretched business, when you look,"},{"id":"semetey-2-2013:p0938:b003:l033","ordinal":257885,"en":"Tell me, Uncle Kongurbay,"},{"id":"semetey-2-2013:p0938:b003:l034","ordinal":257886,"en":"Was your treasury filled?"},{"id":"semetey-2-2013:p0938:b003:l035","ordinal":257887,"en":"Battle came and the people died;"},{"id":"semetey-2-2013:p0938:b003:l036","ordinal":257888,"en":"Many different nations died."},{"id":"semetey-2-2013:p0938:b003:l037","ordinal":257889,"en":"The desolate land found no peace;"},{"id":"semetey-2-2013:p0938:b003:l038","ordinal":257890,"en":"At the very word that battle was coming,"},{"id":"semetey-2-2013:p0938:b003:l039","ordinal":257891,"en":"The people wailed and cried aloud."},{"id":"semetey-2-2013:p0938:b004:l001","ordinal":257892,"en":"Without quarreling or attacking,"},{"id":"semetey-2-2013:p0938:b004:l002","ordinal":257893,"en":"Agree to these words;"},{"id":"semetey-2-2013:p0938:b004:l003","ordinal":257894,"en":"My princely elder, pay the blood-price for Manas!"},{"id":"semetey-2-2013:p0938:b004:l004","ordinal":257895,"en":"Now that your hair is gray with age,"},{"id":"semetey-2-2013:p0938:b004:l005","ordinal":257896,"en":"Go safely to the Khagan;"},{"id":"semetey-2-2013:p0938:b004:l006","ordinal":257897,"en":"My lord and uncle Kongurbay,"},{"id":"semetey-2-2013:p0938:b004:l007","ordinal":257898,"en":"Return safely to Beijing."},{"id":"semetey-2-2013:p0938:b004:l008","ordinal":257899,"en":"That bloodthirsty champion and lion"},{"id":"semetey-2-2013:p0938:b004:l009","ordinal":257900,"en":"Filled the Kara-Suu with blood,"},{"id":"semetey-2-2013:p0938:b004:l010","ordinal":257901,"en":"Set the grassy lands ablaze,"},{"id":"semetey-2-2013:p0938:b004:l011","ordinal":257902,"en":"And burned the valley."},{"id":"semetey-2-2013:p0938:b004:l012","ordinal":257903,"en":"He burned the valley and turned it to grease;"},{"id":"semetey-2-2013:p0938:b004:l013","ordinal":257904,"en":"When his wrath was roused,"},{"id":"semetey-2-2013:p0938:b004:l014","ordinal":257905,"en":"He even laid low his own father, Khan Jakyp."},{"id":"semetey-2-2013:p0938:b004:l015","ordinal":257906,"en":"That great gray wolf of violent birth,"},{"id":"semetey-2-2013:p0938:b004:l016","ordinal":257907,"en":"After turning his back on the Kyrgyz,"},{"id":"semetey-2-2013:p0938:b004:l017","ordinal":257908,"en":"After embracing the Chinese faith,"},{"id":"semetey-2-2013:p0938:b004:l018","ordinal":257909,"en":"Speak words of conciliation to him."},{"id":"semetey-2-2013:p0938:b004:l019","ordinal":257910,"en":"Stand face-to-face,"},{"id":"semetey-2-2013:p0938:b004:l020","ordinal":257911,"en":"Pour out spirits and serve food,"},{"id":"semetey-2-2013:p0938:b004:l021","ordinal":257912,"en":"And offer them to one another."},{"id":"semetey-2-2013:p0938:b004:l022","ordinal":257913,"en":"Exchange words of reconciliation;"},{"id":"semetey-2-2013:p0938:b004:l023","ordinal":257914,"en":"Meet and speak at length,"},{"id":"semetey-2-2013:p0938:b004:l024","ordinal":257915,"en":"Bring your hearts together as one,"},{"id":"semetey-2-2013:p0938:b004:l025","ordinal":257916,"en":"And return as friends."},{"id":"semetey-2-2013:p0938:b004:l026","ordinal":257917,"en":"At Karkyra, where men circle together,"},{"id":"semetey-2-2013:p0938:b004:l027","ordinal":257918,"en":"Gather round and confer;"},{"id":"semetey-2-2013:p0938:b004:l028","ordinal":257919,"en":"At Karkyra, where hosts assemble,"},{"id":"semetey-2-2013:p0938:b004:l029","ordinal":257920,"en":"Hold council together."},{"id":"semetey-2-2013:p0938:b004:l030","ordinal":257921,"en":"Lay the matter before you,"},{"id":"semetey-2-2013:p0938:b004:l031","ordinal":257922,"en":"And cast aside every grudge;"},{"id":"semetey-2-2013:p0938:b004:l032","ordinal":257923,"en":"Lay your words before you,"},{"id":"semetey-2-2013:p0938:b004:l033","ordinal":257924,"en":"And cast aside every wrong."},{"id":"semetey-2-2013:p0938:b004:l034","ordinal":257925,"en":"Make true peace and return."},{"id":"semetey-2-2013:p0938:b004:l035","ordinal":257926,"en":"Bid each other, ‘Farewell, and remain safe!’"},{"id":"semetey-2-2013:p0938:b004:l036","ordinal":257927,"en":"Make peace once and return;"},{"id":"semetey-2-2013:p0938:b004:l037","ordinal":257928,"en":"Like flour from white wheat,"},{"id":"semetey-2-2013:p0938:b004:l038","ordinal":257929,"en":"Blend together, you two lions;"},{"id":"semetey-2-2013:p0938:b004:l039","ordinal":257930,"en":"Like hairs from a white antelope,"},{"id":"semetey-2-2013:p0939:b003:l001","ordinal":257931,"en":"You two lions who have pulled apart!"},{"id":"semetey-2-2013:p0939:b003:l002","ordinal":257932,"en":"Like a great river flowing through the valley,"},{"id":"semetey-2-2013:p0939:b003:l003","ordinal":257933,"en":"Become a single spring;"},{"id":"semetey-2-2013:p0939:b003:l004","ordinal":257934,"en":"Move toward friendship"},{"id":"semetey-2-2013:p0939:b003:l005","ordinal":257935,"en":"And remain close companions."},{"id":"semetey-2-2013:p0939:b003:l006","ordinal":257936,"en":"My lion-uncle Kongurbay,"},{"id":"semetey-2-2013:p0939:b003:l007","ordinal":257937,"en":"Consent to the words I have spoken,"},{"id":"semetey-2-2013:p0939:b003:l008","ordinal":257938,"en":"And grant me the idol’s power."},{"id":"semetey-2-2013:p0939:b003:l009","ordinal":257939,"en":"I made their elders bow in reverence;"},{"id":"semetey-2-2013:p0939:b003:l010","ordinal":257940,"en":"I converted them wholly to the faith—"},{"id":"semetey-2-2013:p0939:b003:l011","ordinal":257941,"en":"All the Buruts.”"},{"id":"semetey-2-2013:p0939:b003:l012","ordinal":257942,"en":"When Külchoro had spoken thus,"},{"id":"semetey-2-2013:p0939:b003:l013","ordinal":257943,"en":"Alööke’s Kongurbay said:"},{"id":"semetey-2-2013:p0939:b003:l014","ordinal":257944,"en":"“Ah, they call you a heroic warrior,"},{"id":"semetey-2-2013:p0939:b003:l015","ordinal":257945,"en":"And what you have said is wise."},{"id":"semetey-2-2013:p0939:b003:l016","ordinal":257946,"en":"As for that great inscribed, hollow-bellied idol—"},{"id":"semetey-2-2013:p0939:b003:l017","ordinal":257947,"en":"Oh, my child, take not merely its power but its head!"},{"id":"semetey-2-2013:p0939:b003:l018","ordinal":257948,"en":"If it will bring prosperity to that bloodthirsty hero,"},{"id":"semetey-2-2013:p0939:b003:l019","ordinal":257949,"en":"Take not merely its power but its head."},{"id":"semetey-2-2013:p0939:b003:l020","ordinal":257950,"en":"To Manas’s only son,"},{"id":"semetey-2-2013:p0939:b003:l021","ordinal":257951,"en":"As the foremost of gifts,"},{"id":"semetey-2-2013:p0939:b003:l022","ordinal":257952,"en":"Present it freely."},{"id":"semetey-2-2013:p0939:b003:l023","ordinal":257953,"en":"If that idol is too small a gift,"},{"id":"semetey-2-2013:p0939:b003:l024","ordinal":257954,"en":"Let him take Ezkara’s great war drum"},{"id":"semetey-2-2013:p0939:b003:l025","ordinal":257955,"en":"As a magnificent offering!"},{"id":"semetey-2-2013:p0939:b003:l026","ordinal":257956,"en":"Let us unite and meet face-to-face,"},{"id":"semetey-2-2013:p0939:b003:l027","ordinal":257957,"en":"Eating meat from a single dish;"},{"id":"semetey-2-2013:p0939:b003:l028","ordinal":257958,"en":"Let us abandon our grudges and meet,"},{"id":"semetey-2-2013:p0939:b003:l029","ordinal":257959,"en":"Like a pale star in the heavens,"},{"id":"semetey-2-2013:p0939:b003:l030","ordinal":257960,"en":"Chest to chest as friends."},{"id":"semetey-2-2013:p0939:b003:l031","ordinal":257961,"en":"Let us begin our roaring conversation,"},{"id":"semetey-2-2013:p0939:b003:l032","ordinal":257962,"en":"And, my son, cast our thunderous valor"},{"id":"semetey-2-2013:p0939:b003:l033","ordinal":257963,"en":"Into the water and leave it there."},{"id":"semetey-2-2013:p0939:b003:l034","ordinal":257964,"en":"I shall agree to what he says."},{"id":"semetey-2-2013:p0939:b003:l035","ordinal":257965,"en":"For his father, the gray wolf Manas,"},{"id":"semetey-2-2013:p0939:b003:l036","ordinal":257966,"en":"I shall pay the blood-price a full thousandfold."},{"id":"semetey-2-2013:p0939:b003:l037","ordinal":257967,"en":"Bring me your prince,"},{"id":"semetey-2-2013:p0939:b003:l038","ordinal":257968,"en":"Your renowned bloodthirsty lord."},{"id":"semetey-2-2013:p0939:b003:l039","ordinal":257969,"en":"Lead here the infidel eager for battle—"},{"id":"semetey-2-2013:p0939:b005:l001","ordinal":257970,"en":"The blood-drinking, bloodthirsty warrior."},{"id":"semetey-2-2013:p0939:b005:l002","ordinal":257971,"en":"As blood-price for his father Manas,"},{"id":"semetey-2-2013:p0939:b005:l003","ordinal":257972,"en":"My gray horses with fetlocked legs—"},{"id":"semetey-2-2013:p0939:b005:l004","ordinal":257973,"en":"All are peerless thoroughbreds."},{"id":"semetey-2-2013:p0939:b005:l005","ordinal":257974,"en":"From the unbroken herds"},{"id":"semetey-2-2013:p0939:b005:l006","ordinal":257975,"en":"I shall drive out and give droves of every kind,"},{"id":"semetey-2-2013:p0939:b005:l007","ordinal":257976,"en":"Without even unrolling"},{"id":"semetey-2-2013:p0939:b005:l008","ordinal":257977,"en":"Such a tally, I shall give livestock."},{"id":"semetey-2-2013:p0939:b005:l009","ordinal":257978,"en":"One kind of horse is dun,"},{"id":"semetey-2-2013:p0939:b005:l010","ordinal":257979,"en":"With a white blaze like an amulet;"},{"id":"semetey-2-2013:p0939:b005:l011","ordinal":257980,"en":"All are peerless thoroughbreds."},{"id":"semetey-2-2013:p0939:b005:l012","ordinal":257981,"en":"I shall give a drove of kulans,"},{"id":"semetey-2-2013:p0939:b005:l013","ordinal":257982,"en":"All evenly matched dappled thoroughbreds;"},{"id":"semetey-2-2013:p0939:b005:l014","ordinal":257983,"en":"Of these I shall give a drove."},{"id":"semetey-2-2013:p0939:b005:l015","ordinal":257984,"en":"Black-and-white as a starling—"},{"id":"semetey-2-2013:p0939:b005:l016","ordinal":257985,"en":"Of those too I shall give a drove."},{"id":"semetey-2-2013:p0939:b005:l017","ordinal":257986,"en":"If he comes within my reach,"},{"id":"semetey-2-2013:p0939:b005:l018","ordinal":257987,"en":"I shall present him gifts made by craftsmen;"},{"id":"semetey-2-2013:p0939:b005:l019","ordinal":257988,"en":"I shall present him maidens,"},{"id":"semetey-2-2013:p0939:b005:l020","ordinal":257989,"en":"Immensely beautiful, with dainty feet."},{"id":"semetey-2-2013:p0939:b005:l021","ordinal":257990,"en":"There is no equal in Great Beijing"},{"id":"semetey-2-2013:p0939:b005:l022","ordinal":257991,"en":"To what Prince Kong"},{"id":"semetey-2-2013:p0939:b005:l023","ordinal":257992,"en":"Has in his possession."},{"id":"semetey-2-2013:p0939:b005:l024","ordinal":257993,"en":"From the splendid yellow horses"},{"id":"semetey-2-2013:p0939:b005:l025","ordinal":257994,"en":"I shall count out and drive a gift,"},{"id":"semetey-2-2013:p0939:b005:l026","ordinal":257995,"en":"And from the evenly matched black horses."},{"id":"semetey-2-2013:p0939:b005:l027","ordinal":257996,"en":"I shall send word to the Kakan:"},{"id":"semetey-2-2013:p0939:b005:l028","ordinal":257997,"en":"“I shall befriend Semetey"},{"id":"semetey-2-2013:p0939:b005:l029","ordinal":257998,"en":"And return safely to Beijing."},{"id":"semetey-2-2013:p0939:b005:l030","ordinal":257999,"en":"I shall agree to what he said"},{"id":"semetey-2-2013:p0939:b005:l031","ordinal":258000,"en":"And pay the Magnanimous One’s blood-price."},{"id":"semetey-2-2013:p0939:b005:l032","ordinal":258001,"en":"I shall say, ‘This is how matters stand,’"},{"id":"semetey-2-2013:p0939:b005:l033","ordinal":258002,"en":"And depart safely for Beijing.”"},{"id":"semetey-2-2013:p0939:b005:l034","ordinal":258003,"en":"So spoke Kongurbai;"},{"id":"semetey-2-2013:p0939:b005:l035","ordinal":258004,"en":"Kaldais and sentries closed around him,"},{"id":"semetey-2-2013:p0939:b005:l036","ordinal":258005,"en":"And to the wrathful Kalcha"},{"id":"semetey-2-2013:p0939:b005:l037","ordinal":258006,"en":"Wisdom came as if from the unseen."},{"id":"semetey-2-2013:p0939:b005:l038","ordinal":258007,"en":"As its heart pounded and it pranced,"},{"id":"semetey-2-2013:p0939:b005:l039","ordinal":258008,"en":"His matchless thoroughbred Black Horse—"},{"id":"semetey-2-2013:p0940:b003:l001","ordinal":258009,"en":"With twelve Manchus escorting him."},{"id":"semetey-2-2013:p0940:b003:l002","ordinal":258010,"en":"Beside this uncle of yours"},{"id":"semetey-2-2013:p0940:b003:l003","ordinal":258011,"en":"Stand six divisions of armed troops,"},{"id":"semetey-2-2013:p0940:b003:l004","ordinal":258012,"en":"And the peerless hero Kongurbay."},{"id":"semetey-2-2013:p0940:b003:l005","ordinal":258013,"en":"The great blue-gray-bearded Manchu,"},{"id":"semetey-2-2013:p0940:b003:l006","ordinal":258014,"en":"Whose jeweled button is as large as a fist—"},{"id":"semetey-2-2013:p0940:b003:l007","ordinal":258015,"en":"This is how your uncle planned to deceive him."},{"id":"semetey-2-2013:p0940:b003:l008","ordinal":258016,"en":"The mediator between them was a blazing fire:"},{"id":"semetey-2-2013:p0940:b003:l009","ordinal":258017,"en":"Külchoro, son of Almambet."},{"id":"semetey-2-2013:p0940:b003:l010","ordinal":258018,"en":"‘I have become Kyrgyz again after living among the Chinese;"},{"id":"semetey-2-2013:p0940:b003:l011","ordinal":258019,"en":"This swine you see with your own eyes"},{"id":"semetey-2-2013:p0940:b003:l012","ordinal":258020,"en":"I have made my kinsman,’ he said."},{"id":"semetey-2-2013:p0940:b003:l013","ordinal":258021,"en":"He spoke with Khan Kalcha,"},{"id":"semetey-2-2013:p0940:b003:l014","ordinal":258022,"en":"Binding their promise firmly;"},{"id":"semetey-2-2013:p0940:b003:l015","ordinal":258023,"en":"They swore a covenant unto death,"},{"id":"semetey-2-2013:p0940:b003:l016","ordinal":258024,"en":"Exchanged many solemn words,"},{"id":"semetey-2-2013:p0940:b003:l017","ordinal":258025,"en":"And licked the edge of the sword."},{"id":"semetey-2-2013:p0940:b003:l018","ordinal":258026,"en":"The cunning man, Almambet’s son,"},{"id":"semetey-2-2013:p0940:b003:l019","ordinal":258027,"en":"Had drawn the line"},{"id":"semetey-2-2013:p0940:b003:l020","ordinal":258028,"en":"And devised the spectacle."},{"id":"semetey-2-2013:p0940:b003:l021","ordinal":258029,"en":"The time had come for him"},{"id":"semetey-2-2013:p0940:b003:l022","ordinal":258030,"en":"To begin treachery against Prince Kong."},{"id":"semetey-2-2013:p0940:b003:l023","ordinal":258031,"en":"Boundless was the resourcefulness"},{"id":"semetey-2-2013:p0940:b003:l024","ordinal":258032,"en":"Of Külchoro, son of Almambet,"},{"id":"semetey-2-2013:p0940:b003:l025","ordinal":258033,"en":"Who subdued the whole wide world,"},{"id":"semetey-2-2013:p0940:b003:l026","ordinal":258034,"en":"A lion-warrior who took after his father."},{"id":"semetey-2-2013:p0940:b003:l027","ordinal":258035,"en":"When he was only twelve years old,"},{"id":"semetey-2-2013:p0940:b003:l028","ordinal":258036,"en":"He smashed a royal camp and carried off plunder;"},{"id":"semetey-2-2013:p0940:b003:l029","ordinal":258037,"en":"Hardened and sated with blood,"},{"id":"semetey-2-2013:p0940:b003:l030","ordinal":258038,"en":"He was hailed as a lion cub."},{"id":"semetey-2-2013:p0940:b003:l031","ordinal":258039,"en":"He proved himself a gray wolf;"},{"id":"semetey-2-2013:p0940:b003:l032","ordinal":258040,"en":"He destroyed Chynkojo"},{"id":"semetey-2-2013:p0940:b003:l033","ordinal":258041,"en":"And sent that gray wolf Toltoy"},{"id":"semetey-2-2013:p0940:b003:l034","ordinal":258042,"en":"Into the grave."},{"id":"semetey-2-2013:p0940:b003:l035","ordinal":258043,"en":"Yesterday he spread turmoil across many lands—"},{"id":"semetey-2-2013:p0940:b003:l036","ordinal":258044,"en":"Throughout Alty-Shaar and Kokon,"},{"id":"semetey-2-2013:p0940:b003:l037","ordinal":258045,"en":"As far as Margalang,"},{"id":"semetey-2-2013:p0940:b003:l038","ordinal":258046,"en":"He raided and conquered them all."},{"id":"semetey-2-2013:p0940:b003:l039","ordinal":258047,"en":"Ah, a lion-warrior upheld by the saint Shay,"},{"id":"semetey-2-2013:p0940:b004:l001","ordinal":258048,"en":"A bold and radiant hero—"}]
