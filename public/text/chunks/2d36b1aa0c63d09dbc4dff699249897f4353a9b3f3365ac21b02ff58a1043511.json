[{"id":"manas-2010:p0860:b001:l015","ordinal":37889,"en":"Let me speak words of benefit."},{"id":"manas-2010:p0860:b001:l016","ordinal":37890,"en":"A gray wondrous steed none could find,"},{"id":"manas-2010:p0860:b001:l017","ordinal":37891,"en":"I have brought before you;"},{"id":"manas-2010:p0860:b001:l018","ordinal":37892,"en":"Let me hand it over and return."},{"id":"manas-2010:p0860:b001:l019","ordinal":37893,"en":"The horse I lead is Kögala;"},{"id":"manas-2010:p0860:b001:l020","ordinal":37894,"en":"Do not question this wondrous steed's worth."},{"id":"manas-2010:p0860:b001:l021","ordinal":37895,"en":"He is the finest wondrous steed."},{"id":"manas-2010:p0860:b001:l022","ordinal":37896,"en":"Allah Most High has allotted him to you;"},{"id":"manas-2010:p0860:b001:l023","ordinal":37897,"en":"This is the time he is given."},{"id":"manas-2010:p0860:b001:l024","ordinal":37898,"en":"He has just reached five years old."},{"id":"manas-2010:p0860:b001:l025","ordinal":37899,"en":"The horse I lead, Kögala,"},{"id":"manas-2010:p0860:b001:l026","ordinal":37900,"en":"Is a true wondrous steed."},{"id":"manas-2010:p0860:b001:l027","ordinal":37901,"en":"For you, falcon Chubak,"},{"id":"manas-2010:p0860:b001:l028","ordinal":37902,"en":"He is a fitting beast."},{"id":"manas-2010:p0860:b001:l029","ordinal":37903,"en":"I am the helping elder in the flesh;"},{"id":"manas-2010:p0860:b001:l030","ordinal":37904,"en":"I am the saintly elder himself."},{"id":"manas-2010:p0860:b001:l031","ordinal":37905,"en":"“A champion Chubak shall arise,”"},{"id":"manas-2010:p0860:b001:l032","ordinal":37906,"en":"I foresaw and knew long ago."},{"id":"manas-2010:p0860:b001:l033","ordinal":37907,"en":"To give him at the proper time,"},{"id":"manas-2010:p0860:b001:l034","ordinal":37908,"en":"I have been raising Kögala."},{"id":"manas-2010:p0860:b001:l035","ordinal":37909,"en":"Where I meet you now"},{"id":"manas-2010:p0860:b001:l036","ordinal":37910,"en":"Is the plain of the Mediyen desert."},{"id":"manas-2010:p0860:b001:l037","ordinal":37911,"en":"Kögala, whom I have led here,"},{"id":"manas-2010:p0860:b001:l038","ordinal":37912,"en":"Is Zhelkayyp's child."},{"id":"manas-2010:p0860:b001:l039","ordinal":37913,"en":"Who raced with wild asses,"},{"id":"manas-2010:p0860:b001:l040","ordinal":37914,"en":"The youngest of twelve wondrous steeds,"},{"id":"manas-2010:p0860:b001:l041","ordinal":37915,"en":"Born kin to Zhelkayyp,"},{"id":"manas-2010:p0860:b001:l042","ordinal":37916,"en":"He found his feet in sand, grew up on stone,"},{"id":"manas-2010:p0861:b001:l001","ordinal":37917,"en":"Seeing no man, seeing no soul,"},{"id":"manas-2010:p0861:b001:l002","ordinal":37918,"en":"Until he reached his fifth year,"},{"id":"manas-2010:p0861:b001:l003","ordinal":37919,"en":"He grew apart upon the empty plain."},{"id":"manas-2010:p0861:b001:l004","ordinal":37920,"en":"His tail is sparse, his mane is scant;"},{"id":"manas-2010:p0861:b001:l005","ordinal":37921,"en":"If he pursues a wild ass, it cannot escape."},{"id":"manas-2010:p0861:b001:l006","ordinal":37922,"en":"His back is high, his withers low;"},{"id":"manas-2010:p0861:b001:l007","ordinal":37923,"en":"Racing over hills, he never flags."},{"id":"manas-2010:p0861:b001:l008","ordinal":37924,"en":"Hear my words with joy."},{"id":"manas-2010:p0861:b001:l009","ordinal":37925,"en":"Kögala, whom I have brought,"},{"id":"manas-2010:p0861:b001:l010","ordinal":37926,"en":"Will bring you good fortune."},{"id":"manas-2010:p0861:b001:l011","ordinal":37927,"en":"Iron-hoofed and copper-legged,"},{"id":"manas-2010:p0861:b001:l012","ordinal":37928,"en":"His sire a wondrous steed—his armament,"},{"id":"manas-2010:p0861:b001:l013","ordinal":37929,"en":"No mortal can easily find his like."},{"id":"manas-2010:p0861:b001:l014","ordinal":37930,"en":"Hear my words, my son:"},{"id":"manas-2010:p0861:b001:l015","ordinal":37931,"en":"His hooves are cast iron."},{"id":"manas-2010:p0861:b001:l016","ordinal":37932,"en":"Once he reaches his true condition,"},{"id":"manas-2010:p0861:b001:l017","ordinal":37933,"en":"Wings are upon his flanks."},{"id":"manas-2010:p0861:b001:l018","ordinal":37934,"en":"If you ride him into battle, without faltering,"},{"id":"manas-2010:p0861:b001:l019","ordinal":37935,"en":"It is his habit to fly."},{"id":"manas-2010:p0861:b001:l020","ordinal":37936,"en":"The mark of a wondrous steed:"},{"id":"manas-2010:p0861:b001:l021","ordinal":37937,"en":"His hooves have no soft frog."},{"id":"manas-2010:p0861:b001:l022","ordinal":37938,"en":"My Chubak, son of Akbaltay,"},{"id":"manas-2010:p0861:b001:l023","ordinal":37939,"en":"Heed these words of mine:"},{"id":"manas-2010:p0861:b001:l024","ordinal":37940,"en":"There is no other inheritance beyond this."},{"id":"manas-2010:p0861:b001:l025","ordinal":37941,"en":"Ridden into combat, he does not falter."},{"id":"manas-2010:p0861:b001:l026","ordinal":37942,"en":"Ride him across forty days of desert;"},{"id":"manas-2010:p0861:b001:l027","ordinal":37943,"en":"He will not stagger and tire you,"},{"id":"manas-2010:p0861:b001:l028","ordinal":37944,"en":"Nor show the least weakness."},{"id":"manas-2010:p0861:b001:l029","ordinal":37945,"en":"When that pig was born,"},{"id":"manas-2010:p0861:b001:l030","ordinal":37946,"en":"There was writing upon his flank."},{"id":"manas-2010:p0861:b001:l031","ordinal":37947,"en":"When the writing was read,"},{"id":"manas-2010:p0861:b001:l032","ordinal":37948,"en":"“Leopard Chubak shall ride him,” it said;"},{"id":"manas-2010:p0861:b001:l033","ordinal":37949,"en":"Your very name was there."},{"id":"manas-2010:p0861:b001:l034","ordinal":37950,"en":"“Where shall I find Chubak?” I said;"},{"id":"manas-2010:p0861:b001:l035","ordinal":37951,"en":"I searched long, mighty one."},{"id":"manas-2010:p0861:b001:l036","ordinal":37952,"en":"When he had reached his third year,"},{"id":"manas-2010:p0861:b001:l037","ordinal":37953,"en":"His wondrous nature had been discovered."},{"id":"manas-2010:p0861:b001:l038","ordinal":37954,"en":"With a mountain-sized mace strapped on,"},{"id":"manas-2010:p0861:b001:l039","ordinal":37955,"en":"Roaming the hellish mountains,"},{"id":"manas-2010:p0861:b001:l040","ordinal":37956,"en":"Sarybay, son of the ogress,"},{"id":"manas-2010:p0861:b001:l041","ordinal":37957,"en":"Was seeking Kögala."},{"id":"manas-2010:p0861:b001:l042","ordinal":37958,"en":"If Sary came by chance,"},{"id":"manas-2010:p0862:b001:l001","ordinal":37959,"en":"“He will bring the end of the world;"},{"id":"manas-2010:p0862:b001:l002","ordinal":37960,"en":"Striking with his mace, Sarybay"},{"id":"manas-2010:p0862:b001:l003","ordinal":37961,"en":"Will seize Kögala,”"},{"id":"manas-2010:p0862:b001:l004","ordinal":37962,"en":"Your saintly father knew."},{"id":"manas-2010:p0862:b001:l005","ordinal":37963,"en":"Making the wondrous steed go hungry,"},{"id":"manas-2010:p0862:b001:l006","ordinal":37964,"en":"Making Kögala flee,"},{"id":"manas-2010:p0862:b001:l007","ordinal":37965,"en":"For your sake, Chubak,"},{"id":"manas-2010:p0862:b001:l008","ordinal":37966,"en":"Because of what had happened,"},{"id":"manas-2010:p0862:b001:l009","ordinal":37967,"en":"No water remained I had not crossed,"},{"id":"manas-2010:p0862:b001:l010","ordinal":37968,"en":"No mountain remained I had not trodden."},{"id":"manas-2010:p0862:b001:l011","ordinal":37969,"en":"Taking no rest by day,"},{"id":"manas-2010:p0862:b001:l012","ordinal":37970,"en":"Taking no sleep by night,"},{"id":"manas-2010:p0862:b001:l013","ordinal":37971,"en":"I have tended Kögala."},{"id":"manas-2010:p0862:b001:l014","ordinal":37972,"en":"The cruelty of that dog Sarybay,"},{"id":"manas-2010:p0862:b001:l015","ordinal":37973,"en":"I endured for many years."},{"id":"manas-2010:p0862:b001:l016","ordinal":37974,"en":"“If by chance I let him be watched,"},{"id":"manas-2010:p0862:b001:l017","ordinal":37975,"en":"If I should lose him unexpectedly,"},{"id":"manas-2010:p0862:b001:l018","ordinal":37976,"en":"If I do not obey the command,"},{"id":"manas-2010:p0862:b001:l019","ordinal":37977,"en":"If I do not find Chubak and give him the horse,"},{"id":"manas-2010:p0862:b001:l020","ordinal":37978,"en":"He will know my dog-like baseness."},{"id":"manas-2010:p0862:b001:l021","ordinal":37979,"en":"On the coming Day of Gathering,"},{"id":"manas-2010:p0862:b001:l022","ordinal":37980,"en":"Akbaltay's Chubak"},{"id":"manas-2010:p0862:b001:l023","ordinal":37981,"en":"Will make a black donkey of me and ride me,” I thought."},{"id":"manas-2010:p0862:b001:l024","ordinal":37982,"en":"“Akbaltay has had a son,"},{"id":"manas-2010:p0862:b001:l025","ordinal":37983,"en":"He has named him Chubak,”"},{"id":"manas-2010:p0862:b001:l026","ordinal":37984,"en":"I pieced together from inherited lore,"},{"id":"manas-2010:p0862:b001:l027","ordinal":37985,"en":"I asked those who knew."},{"id":"manas-2010:p0862:b001:l028","ordinal":37986,"en":"When he reached six years old,"},{"id":"manas-2010:p0862:b001:l029","ordinal":37987,"en":"I heard he went to Mecca."},{"id":"manas-2010:p0862:b001:l030","ordinal":37988,"en":"Taking no companion beside him,"},{"id":"manas-2010:p0862:b001:l031","ordinal":37989,"en":"I heard he went alone."},{"id":"manas-2010:p0862:b001:l032","ordinal":37990,"en":"To twelve spiritual masters he gave his hand;"},{"id":"manas-2010:p0862:b001:l033","ordinal":37991,"en":"Ten saints showed him the way."},{"id":"manas-2010:p0862:b001:l034","ordinal":37992,"en":"He received a letter from the caliph,"},{"id":"manas-2010:p0862:b001:l035","ordinal":37993,"en":"And was named Bloodthirsty Chubak."},{"id":"manas-2010:p0862:b001:l036","ordinal":37994,"en":"Giving his hand to twelve spiritual masters,"},{"id":"manas-2010:p0862:b001:l037","ordinal":37995,"en":"He was named Illustrious Champion."},{"id":"manas-2010:p0862:b001:l038","ordinal":37996,"en":"Though we have not seen you, we know you."},{"id":"manas-2010:p0862:b001:l039","ordinal":37997,"en":"Akbaltay's only son,"},{"id":"manas-2010:p0862:b001:l040","ordinal":37998,"en":"Lion Chubak, are you well?"},{"id":"manas-2010:p0862:b001:l041","ordinal":37999,"en":"Rise from sleep and awaken;"},{"id":"manas-2010:p0862:b001:l042","ordinal":38000,"en":"Turn your eyes toward us,"},{"id":"manas-2010:p0863:b001:l001","ordinal":38001,"en":"Your entrusted Kögala,"},{"id":"manas-2010:p0863:b001:l002","ordinal":38002,"en":"I give him now; receive him."},{"id":"manas-2010:p0863:b001:l003","ordinal":38003,"en":"Father is Mecca, mother is light."},{"id":"manas-2010:p0863:b001:l004","ordinal":38004,"en":"Mount the horse, my Chubak,"},{"id":"manas-2010:p0863:b001:l005","ordinal":38005,"en":"And go to your father Akbaltay."},{"id":"manas-2010:p0863:b001:l006","ordinal":38006,"en":"When you reach Akbaltay,"},{"id":"manas-2010:p0863:b001:l007","ordinal":38007,"en":"You will find your ridge and pass."},{"id":"manas-2010:p0863:b001:l008","ordinal":38008,"en":"You yourself shall find"},{"id":"manas-2010:p0863:b001:l009","ordinal":38009,"en":"A lion equal to yourself.’"},{"id":"manas-2010:p0863:b001:l010","ordinal":38010,"en":"Saying this, the unseen elder"},{"id":"manas-2010:p0863:b001:l011","ordinal":38011,"en":"Handed over Kögala."},{"id":"manas-2010:p0863:b001:l012","ordinal":38012,"en":"Giving his blessing,"},{"id":"manas-2010:p0863:b001:l013","ordinal":38013,"en":"That man who had led the horse"},{"id":"manas-2010:p0863:b001:l014","ordinal":38014,"en":"Vanished from sight."},{"id":"manas-2010:p0863:b001:l015","ordinal":38015,"en":"Taking Kögala, hero Chubak"},{"id":"manas-2010:p0863:b001:l016","ordinal":38016,"en":"Beseeched God at length."},{"id":"manas-2010:p0863:b001:l017","ordinal":38017,"en":"From the bubbling spring,"},{"id":"manas-2010:p0863:b001:l018","ordinal":38018,"en":"He quenched his thirst."},{"id":"manas-2010:p0863:b001:l019","ordinal":38019,"en":"As he was about to mount Kögala,"},{"id":"manas-2010:p0863:b001:l020","ordinal":38020,"en":"As Chubak was about to set out,"},{"id":"manas-2010:p0863:b001:l021","ordinal":38021,"en":"Five people appeared from the ridge."},{"id":"manas-2010:p0863:b001:l022","ordinal":38022,"en":"His white turban was like a cauldron;"},{"id":"manas-2010:p0863:b001:l023","ordinal":38023,"en":"When he uttered “Ah,” his voice rang like the call to prayer."},{"id":"manas-2010:p0863:b001:l024","ordinal":38024,"en":"A living proof of great Mecca,"},{"id":"manas-2010:p0863:b001:l025","ordinal":38025,"en":"He was the chief imam himself."},{"id":"manas-2010:p0863:b001:l026","ordinal":38026,"en":"Roaming the land and viewing the waters,"},{"id":"manas-2010:p0863:b001:l027","ordinal":38027,"en":"He had come on a journey of pleasure."},{"id":"manas-2010:p0863:b001:l028","ordinal":38028,"en":"From the valuables upon his back,"},{"id":"manas-2010:p0863:b001:l029","ordinal":38029,"en":"He brought out an object,"},{"id":"manas-2010:p0863:b001:l030","ordinal":38030,"en":"The chief imam of Mecca,"},{"id":"manas-2010:p0863:b001:l031","ordinal":38031,"en":"From the bottom of a great saddlebag."},{"id":"manas-2010:p0863:b001:l032","ordinal":38032,"en":"‘When I set out from Mecca,"},{"id":"manas-2010:p0863:b001:l033","ordinal":38033,"en":"I knew that I would meet you."},{"id":"manas-2010:p0863:b001:l034","ordinal":38034,"en":"To the wolf-maned Illustrious Champion,"},{"id":"manas-2010:p0863:b001:l035","ordinal":38035,"en":"I intended to give this."},{"id":"manas-2010:p0863:b001:l036","ordinal":38036,"en":"My son, its collar gold, its sleeves copper,"},{"id":"manas-2010:p0863:b001:l037","ordinal":38037,"en":"Double-layered mail, its mesh like larks' eyes,"},{"id":"manas-2010:p0863:b001:l038","ordinal":38038,"en":"This coat that I shall give you,"},{"id":"manas-2010:p0863:b001:l039","ordinal":38039,"en":"Its full name is Bulletproof."},{"id":"manas-2010:p0863:b001:l040","ordinal":38040,"en":"“My chief imam gave it,” you shall say;"},{"id":"manas-2010:p0863:b001:l041","ordinal":38041,"en":"Put on Bulletproof."},{"id":"manas-2010:p0863:b001:l042","ordinal":38042,"en":"The reason I give this coat:"},{"id":"manas-2010:p0864:b001:l001","ordinal":38043,"en":"You are the hero, Illustrious Champion."},{"id":"manas-2010:p0864:b001:l002","ordinal":38044,"en":"There are many gray rolling mountains,"},{"id":"manas-2010:p0864:b001:l003","ordinal":38045,"en":"Many enemies to reckon with,"},{"id":"manas-2010:p0864:b001:l004","ordinal":38046,"en":"Many roads that weary horses,"},{"id":"manas-2010:p0864:b001:l005","ordinal":38047,"en":"Who will shout and exchange shots,"},{"id":"manas-2010:p0864:b001:l006","ordinal":38048,"en":"Many armies lie in wait."},{"id":"manas-2010:p0864:b001:l007","ordinal":38049,"en":"This coat entrusted to you,"},{"id":"manas-2010:p0864:b001:l008","ordinal":38050,"en":"Put it on at once."},{"id":"manas-2010:p0864:b001:l009","ordinal":38051,"en":"If an enemy comes out shooting,"},{"id":"manas-2010:p0864:b001:l010","ordinal":38052,"en":"Hurl yourself in without turning aside."},{"id":"manas-2010:p0864:b001:l011","ordinal":38053,"en":"See the measure of this world:"},{"id":"manas-2010:p0864:b001:l012","ordinal":38054,"en":"This is your horse no bullet can catch;"},{"id":"manas-2010:p0864:b001:l013","ordinal":38055,"en":"This is your coat no bullet can pierce!’"},{"id":"manas-2010:p0864:b001:l014","ordinal":38056,"en":"Akbaltay's Chubak"},{"id":"manas-2010:p0864:b001:l015","ordinal":38057,"en":"Recognized the chief imam."},{"id":"manas-2010:p0864:b001:l016","ordinal":38058,"en":"Your lion took it,"},{"id":"manas-2010:p0864:b001:l017","ordinal":38059,"en":"And put on Bulletproof."},{"id":"manas-2010:p0864:b001:l018","ordinal":38060,"en":"Its fastenings numbered nine;"},{"id":"manas-2010:p0864:b001:l019","ordinal":38061,"en":"No bullet could even strike through."},{"id":"manas-2010:p0864:b001:l020","ordinal":38062,"en":"Its buttons numbered nine;"},{"id":"manas-2010:p0864:b001:l021","ordinal":38063,"en":"No bullet could punch a hole."},{"id":"manas-2010:p0864:b001:l022","ordinal":38064,"en":"He now put on Bulletproof;"},{"id":"manas-2010:p0864:b001:l023","ordinal":38065,"en":"He now mounted the one no bullet could catch!"},{"id":"manas-2010:p0864:b001:l024","ordinal":38066,"en":"The five people standing in a row,"},{"id":"manas-2010:p0864:b001:l025","ordinal":38067,"en":"Saying ‘Amen!’ spread their hands."},{"id":"manas-2010:p0864:b001:l026","ordinal":38068,"en":"‘Amen!’ they said, ‘Amen!"},{"id":"manas-2010:p0864:b001:l027","ordinal":38069,"en":"May your journey be granted a path."},{"id":"manas-2010:p0864:b001:l028","ordinal":38070,"en":"The forty guardian saints and your Kydyr Niyaz,"},{"id":"manas-2010:p0864:b001:l029","ordinal":38071,"en":"May they lend a hand all along the way!"},{"id":"manas-2010:p0864:b001:l030","ordinal":38072,"en":"May no mortal harm you;"},{"id":"manas-2010:p0864:b001:l031","ordinal":38073,"en":"May none who faces you survive!"},{"id":"manas-2010:p0864:b001:l032","ordinal":38074,"en":"Akbaltay's lion,"},{"id":"manas-2010:p0864:b001:l033","ordinal":38075,"en":"May not a hair of yours ever break!"},{"id":"manas-2010:p0864:b001:l034","ordinal":38076,"en":"Charging against your face,"},{"id":"manas-2010:p0864:b001:l035","ordinal":38077,"en":"May no mortal harm you!"},{"id":"manas-2010:p0864:b001:l036","ordinal":38078,"en":"Of the enemies who come to face you,"},{"id":"manas-2010:p0864:b001:l037","ordinal":38079,"en":"May not one survive!"},{"id":"manas-2010:p0864:b001:l038","ordinal":38080,"en":"Amen! Chubak, join in!’ they said."},{"id":"manas-2010:p0864:b001:l039","ordinal":38081,"en":"The saints then"},{"id":"manas-2010:p0864:b001:l040","ordinal":38082,"en":"Gave him their blessing."},{"id":"manas-2010:p0864:b001:l041","ordinal":38083,"en":"Your saintly, valiant Chubak"},{"id":"manas-2010:p0864:b001:l042","ordinal":38084,"en":"Now put on Bulletproof,"},{"id":"manas-2010:p0865:b001:l001","ordinal":38085,"en":"And now mounted Kögala."},{"id":"manas-2010:p0865:b001:l002","ordinal":38086,"en":"Turning sharply, he dashed away;"},{"id":"manas-2010:p0865:b001:l003","ordinal":38087,"en":"With a shout, he headed toward his father."},{"id":"manas-2010:p0865:b001:l004","ordinal":38088,"en":"The unseen elder who gave Kögala"},{"id":"manas-2010:p0865:b001:l005","ordinal":38089,"en":"Was a saint himself."},{"id":"manas-2010:p0865:b001:l006","ordinal":38090,"en":"When he grasped the sacred mane,"},{"id":"manas-2010:p0865:b001:l007","ordinal":38091,"en":"This creature Kögala"},{"id":"manas-2010:p0865:b001:l008","ordinal":38092,"en":"Was in his finest condition."},{"id":"manas-2010:p0865:b001:l009","ordinal":38093,"en":"Now Chubak traveled on,"},{"id":"manas-2010:p0865:b001:l010","ordinal":38094,"en":"Finding the land called Alay,"},{"id":"manas-2010:p0865:b001:l011","ordinal":38095,"en":"Finding the Noygut people in Alay."},{"id":"manas-2010:p0865:b001:l012","ordinal":38096,"en":"Wisdom came from the unseen;"},{"id":"manas-2010:p0865:b001:l013","ordinal":38097,"en":"From the unseen, to Chubak,"},{"id":"manas-2010:p0865:b001:l014","ordinal":38098,"en":"A bulletproof coat, a horse no bullet could catch,"},{"id":"manas-2010:p0865:b001:l015","ordinal":38099,"en":"Such treasures had come."},{"id":"manas-2010:p0865:b001:l016","ordinal":38100,"en":"Akbaltay's Chubak's"},{"id":"manas-2010:p0865:b001:l017","ordinal":38101,"en":"Honor was sheltered thus."},{"id":"manas-2010:p0865:b001:l018","ordinal":38102,"en":"Chubak was no ordinary son;"},{"id":"manas-2010:p0865:b001:l019","ordinal":38103,"en":"Against an enemy spurring forward,"},{"id":"manas-2010:p0865:b001:l020","ordinal":38104,"en":"He was no slave who would fail to match him."},{"id":"manas-2010:p0865:b001:l021","ordinal":38105,"en":"He was the hero, he was the lion;"},{"id":"manas-2010:p0865:b001:l022","ordinal":38106,"en":"Your boundless Chubak was that warrior."},{"id":"manas-2010:p0865:b001:l023","ordinal":38107,"en":"Among the Noygut of Alay,"},{"id":"manas-2010:p0865:b001:l024","ordinal":38108,"en":"Chubak now mounted his horse."},{"id":"manas-2010:p0865:b001:l025","ordinal":38109,"en":"Who threw the world's peoples into turmoil,"},{"id":"manas-2010:p0865:b001:l026","ordinal":38110,"en":"The ruthless one now mounted his horse."},{"id":"manas-2010:p0865:b001:l027","ordinal":38111,"en":"When Chubak mounted Kögala,"},{"id":"manas-2010:p0865:b001:l028","ordinal":38112,"en":"When he put on Bulletproof,"},{"id":"manas-2010:p0865:b001:l029","ordinal":38113,"en":"Finding no mountain to strike against,"},{"id":"manas-2010:p0865:b001:l030","ordinal":38114,"en":"Finding no enemy to fight,"},{"id":"manas-2010:p0865:b001:l031","ordinal":38115,"en":"He raised many a battle cry."},{"id":"manas-2010:p0865:b001:l032","ordinal":38116,"en":"He attacked a great people;"},{"id":"manas-2010:p0865:b001:l033","ordinal":38117,"en":"Raiding the Afghans, he took ten."},{"id":"manas-2010:p0865:b001:l034","ordinal":38118,"en":"He brought strife to the world's peoples,"},{"id":"manas-2010:p0865:b001:l035","ordinal":38119,"en":"Subduing whoever faced him."},{"id":"manas-2010:p0865:b001:l036","ordinal":38120,"en":"Akbaltay's lion,"},{"id":"manas-2010:p0865:b001:l037","ordinal":38121,"en":"Breaking their court and taking spoils,"},{"id":"manas-2010:p0865:b001:l038","ordinal":38122,"en":"Invaded a great people."},{"id":"manas-2010:p0865:b001:l039","ordinal":38123,"en":"Those who knew spoke:"},{"id":"manas-2010:p0865:b001:l040","ordinal":38124,"en":"‘Akbaltay's son Chubak,’ they said,"},{"id":"manas-2010:p0865:b001:l041","ordinal":38125,"en":"‘Whoever rouses his anger,"},{"id":"manas-2010:p0865:b001:l042","ordinal":38126,"en":"He drives along and destroys,"},{"id":"manas-2010:p0866:b001:l001","ordinal":38127,"en":"An exceedingly formidable, ruthless one,’ they said."},{"id":"manas-2010:p0866:b001:l002","ordinal":38128,"en":"Renowned champion Chubak,"},{"id":"manas-2010:p0866:b001:l003","ordinal":38129,"en":"His appearance unlike other mortals',"},{"id":"manas-2010:p0866:b001:l004","ordinal":38130,"en":"Raided and scattered Andijan."},{"id":"manas-2010:p0866:b001:l005","ordinal":38131,"en":"Beyond it, Kokand,"},{"id":"manas-2010:p0866:b001:l006","ordinal":38132,"en":"He subjected and returned."},{"id":"manas-2010:p0866:b001:l007","ordinal":38133,"en":"Of Akbaltay's Chubak,"},{"id":"manas-2010:p0866:b001:l008","ordinal":38134,"en":"Dust rose from his movement;"},{"id":"manas-2010:p0866:b001:l009","ordinal":38135,"en":"Souls departed at his voice."},{"id":"manas-2010:p0866:b001:l010","ordinal":38136,"en":"No man had strength to grapple with him;"},{"id":"manas-2010:p0866:b001:l011","ordinal":38137,"en":"A lion's teeth could not pierce him."},{"id":"manas-2010:p0866:b001:l012","ordinal":38138,"en":"The enemies who faced him were ruined;"},{"id":"manas-2010:p0866:b001:l013","ordinal":38139,"en":"His prowess became known."},{"id":"manas-2010:p0866:b001:l014","ordinal":38140,"en":"He brought strife to the teeming people."},{"id":"manas-2010:p0866:b001:l015","ordinal":38141,"en":"When he mounted Kögala,"},{"id":"manas-2010:p0866:b001:l016","ordinal":38142,"en":"When he put on Bulletproof,"},{"id":"manas-2010:p0866:b001:l017","ordinal":38143,"en":"Besieging Kashgar, he took six."},{"id":"manas-2010:p0866:b001:l018","ordinal":38144,"en":"It was champion Chubak himself,"}]
