[{"id":"semetey-1-2013:p0399:b003:l039","ordinal":107265,"en":"He traveled far, sparing no horses."},{"id":"semetey-1-2013:p0399:b004:l001","ordinal":107266,"en":"Seeing lakes in many places,"},{"id":"semetey-1-2013:p0399:b004:l002","ordinal":107267,"en":"Seeing deserts in many places,"},{"id":"semetey-1-2013:p0399:b004:l003","ordinal":107268,"en":"Your father traveled without tiring."},{"id":"semetey-1-2013:p0399:b004:l004","ordinal":107269,"en":"He crossed uneven, deep ravines"},{"id":"semetey-1-2013:p0399:b004:l005","ordinal":107270,"en":"And passed many rounded mountains."},{"id":"semetey-1-2013:p0399:b004:l006","ordinal":107271,"en":"Wearing horses out, scouting the land,"},{"id":"semetey-1-2013:p0399:b004:l007","ordinal":107272,"en":"Loosing hounds and flying hunting birds,"},{"id":"semetey-1-2013:p0399:b004:l008","ordinal":107273,"en":"When bored, they shot roe deer;"},{"id":"semetey-1-2013:p0399:b004:l009","ordinal":107274,"en":"When your father was not bored,"},{"id":"semetey-1-2013:p0399:b004:l010","ordinal":107275,"en":"They unsaddled horses and lay down."},{"id":"semetey-1-2013:p0399:b004:l011","ordinal":107276,"en":"Yraman's singer"},{"id":"semetey-1-2013:p0399:b004:l012","ordinal":107277,"en":"Sang beside him;"},{"id":"semetey-1-2013:p0399:b004:l013","ordinal":107278,"en":"Torobek's diviner"},{"id":"semetey-1-2013:p0399:b004:l014","ordinal":107279,"en":"Cast his divinations at his head."},{"id":"semetey-1-2013:p0399:b004:l015","ordinal":107280,"en":"Skirting the foot of Barbar's mountain,"},{"id":"semetey-1-2013:p0399:b004:l016","ordinal":107281,"en":"The mighty Bakai, their guide,"},{"id":"semetey-1-2013:p0399:b004:l017","ordinal":107282,"en":"Led Zhelmayan."},{"id":"semetey-1-2013:p0399:b004:l018","ordinal":107283,"en":"Your leopard father Manas,"},{"id":"semetey-1-2013:p0399:b004:l019","ordinal":107284,"en":"Traveling everywhere,"},{"id":"semetey-1-2013:p0399:b004:l020","ordinal":107285,"en":"Maiden Saikal's Lop River,"},{"id":"semetey-1-2013:p0399:b004:l021","ordinal":107286,"en":"The Lop River and Chong-Tokoi:"},{"id":"semetey-1-2013:p0399:b004:l022","ordinal":107287,"en":"He visited all those places."},{"id":"semetey-1-2013:p0399:b004:l023","ordinal":107288,"en":"At a spur shaped like a saddle's ridge,"},{"id":"semetey-1-2013:p0399:b004:l024","ordinal":107289,"en":"At the headland of a crumbling mountain,"},{"id":"semetey-1-2013:p0399:b004:l025","ordinal":107290,"en":"When they had just arrived,"},{"id":"semetey-1-2013:p0399:b004:l026","ordinal":107291,"en":"Kalkaman's black horse:"},{"id":"semetey-1-2013:p0399:b004:l027","ordinal":107292,"en":"When your father sent men on patrol,"},{"id":"semetey-1-2013:p0399:b004:l028","ordinal":107293,"en":"Whichever outstanding choro it was,"},{"id":"semetey-1-2013:p0399:b004:l029","ordinal":107294,"en":"He would choose to ride that horse."},{"id":"semetey-1-2013:p0399:b004:l030","ordinal":107295,"en":"His Serek, who went on watch,"},{"id":"semetey-1-2013:p0399:b004:l031","ordinal":107296,"en":"Kalkaman's black horse,"},{"id":"semetey-1-2013:p0399:b004:l032","ordinal":107297,"en":"That warrior chose to ride."},{"id":"semetey-1-2013:p0399:b004:l033","ordinal":107298,"en":"At the crumbling mountain's spur,"},{"id":"semetey-1-2013:p0399:b004:l034","ordinal":107299,"en":"That was where he went on watch."},{"id":"semetey-1-2013:p0399:b004:l035","ordinal":107300,"en":"Khan Manas's Serek,"},{"id":"semetey-1-2013:p0399:b004:l036","ordinal":107301,"en":"Among round-headed mortals,"},{"id":"semetey-1-2013:p0399:b004:l037","ordinal":107302,"en":"Was your father's champion sent on watch."},{"id":"semetey-1-2013:p0399:b004:l038","ordinal":107303,"en":"Receiving Khan Manas's blessing,"},{"id":"semetey-1-2013:p0399:b004:l039","ordinal":107304,"en":"He rode toward the lookout,"},{"id":"semetey-1-2013:p0400:b003:l001","ordinal":107305,"en":"His banner fluttering in his hand,"},{"id":"semetey-1-2013:p0400:b003:l002","ordinal":107306,"en":"Zulpukor of dark steel"},{"id":"semetey-1-2013:p0400:b003:l003","ordinal":107307,"en":"Flashing at his bare wrist,"},{"id":"semetey-1-2013:p0400:b003:l004","ordinal":107308,"en":"A helmet of black iron"},{"id":"semetey-1-2013:p0400:b003:l005","ordinal":107309,"en":"Set upon his precious head,"},{"id":"semetey-1-2013:p0400:b003:l006","ordinal":107310,"en":"Delighting at the word of watch duty,"},{"id":"semetey-1-2013:p0400:b003:l007","ordinal":107311,"en":"Without looking about him,"},{"id":"semetey-1-2013:p0400:b003:l008","ordinal":107312,"en":"To the undulating ridge"},{"id":"semetey-1-2013:p0400:b003:l009","ordinal":107313,"en":"That warrior climbed,"},{"id":"semetey-1-2013:p0400:b003:l010","ordinal":107314,"en":"Sparing not his threadlike life."},{"id":"semetey-1-2013:p0400:b003:l011","ordinal":107315,"en":"At Zhalpak-Kyya and Zhar-Tash,"},{"id":"semetey-1-2013:p0400:b003:l012","ordinal":107316,"en":"He lay down and slept his fill,"},{"id":"semetey-1-2013:p0400:b003:l013","ordinal":107317,"en":"Took a little nap,"},{"id":"semetey-1-2013:p0400:b003:l014","ordinal":107318,"en":"Rested upon his elbow."},{"id":"semetey-1-2013:p0400:b003:l015","ordinal":107319,"en":"The stars parted in the sky;"},{"id":"semetey-1-2013:p0400:b003:l016","ordinal":107320,"en":"The earth showed bright and clear."},{"id":"semetey-1-2013:p0400:b003:l017","ordinal":107321,"en":"When the Taraza stars had set,"},{"id":"semetey-1-2013:p0400:b003:l018","ordinal":107322,"en":"When the dawn broke bright,"},{"id":"semetey-1-2013:p0400:b003:l019","ordinal":107323,"en":"The stars above parted;"},{"id":"semetey-1-2013:p0400:b003:l020","ordinal":107324,"en":"Daybreak opened into view."},{"id":"semetey-1-2013:p0400:b003:l021","ordinal":107325,"en":"As warrior Serek looked,"},{"id":"semetey-1-2013:p0400:b003:l022","ordinal":107326,"en":"At the edge of Lop's forest,"},{"id":"semetey-1-2013:p0400:b003:l023","ordinal":107327,"en":"At a jutting headland,"},{"id":"semetey-1-2013:p0400:b003:l024","ordinal":107328,"en":"Looming through a haze,"},{"id":"semetey-1-2013:p0400:b003:l025","ordinal":107329,"en":"Upon the slope of Chong-Tokoi,"},{"id":"semetey-1-2013:p0400:b003:l026","ordinal":107330,"en":"Riding a panting black horse,"},{"id":"semetey-1-2013:p0400:b003:l027","ordinal":107331,"en":"Its hairy tail tied tight,"},{"id":"semetey-1-2013:p0400:b003:l028","ordinal":107332,"en":"As huge as half a mountain,"},{"id":"semetey-1-2013:p0400:b003:l029","ordinal":107333,"en":"As though to devour all who appeared,"},{"id":"semetey-1-2013:p0400:b003:l030","ordinal":107334,"en":"Of middle height and broad shoulders,"},{"id":"semetey-1-2013:p0400:b003:l031","ordinal":107335,"en":"Seeming a hungry lion,"},{"id":"semetey-1-2013:p0400:b003:l032","ordinal":107336,"en":"With a fearsome countenance,"},{"id":"semetey-1-2013:p0400:b003:l033","ordinal":107337,"en":"Her beloved hair thick as a girth strap,"},{"id":"semetey-1-2013:p0400:b003:l034","ordinal":107338,"en":"Bound firmly upon her crown,"},{"id":"semetey-1-2013:p0400:b003:l035","ordinal":107339,"en":"All her battle equipment"},{"id":"semetey-1-2013:p0400:b003:l036","ordinal":107340,"en":"Worn to match together,"},{"id":"semetey-1-2013:p0400:b003:l037","ordinal":107341,"en":"A somewhat sullen figure"},{"id":"semetey-1-2013:p0400:b003:l038","ordinal":107342,"en":"Struck Algara on the thigh,"},{"id":"semetey-1-2013:p0400:b003:l039","ordinal":107343,"en":"Raising 'Oigut!' as her battle cry."},{"id":"semetey-1-2013:p0400:b004:l001","ordinal":107344,"en":"The hearts of those who saw were shaken;"},{"id":"semetey-1-2013:p0400:b004:l002","ordinal":107345,"en":"Syrnaiza, the spear she held out,"},{"id":"semetey-1-2013:p0400:b004:l003","ordinal":107346,"en":"Seemed forty fathoms long."},{"id":"semetey-1-2013:p0400:b004:l004","ordinal":107347,"en":"Serek, who stood watching,"},{"id":"semetey-1-2013:p0400:b004:l005","ordinal":107348,"en":"Had his heart sorely shaken."},{"id":"semetey-1-2013:p0400:b004:l006","ordinal":107349,"en":"The black horse beneath her,"},{"id":"semetey-1-2013:p0400:b004:l007","ordinal":107350,"en":"Foam poured from its mouth."},{"id":"semetey-1-2013:p0400:b004:l008","ordinal":107351,"en":"Going downhill, that black horse"},{"id":"semetey-1-2013:p0400:b004:l009","ordinal":107352,"en":"Planted its forelegs like a roe deer;"},{"id":"semetey-1-2013:p0400:b004:l010","ordinal":107353,"en":"As it climbed uphill,"},{"id":"semetey-1-2013:p0400:b004:l011","ordinal":107354,"en":"Its mane and tail streamed out."},{"id":"semetey-1-2013:p0400:b004:l012","ordinal":107355,"en":"When it reached uneven ground,"},{"id":"semetey-1-2013:p0400:b004:l013","ordinal":107356,"en":"Its bull-like neck bulged;"},{"id":"semetey-1-2013:p0400:b004:l014","ordinal":107357,"en":"When it reached the hills,"},{"id":"semetey-1-2013:p0400:b004:l015","ordinal":107358,"en":"Its eyes flashed like flint."},{"id":"semetey-1-2013:p0400:b004:l016","ordinal":107359,"en":"Striking the black horse on the thigh,"},{"id":"semetey-1-2013:p0400:b004:l017","ordinal":107360,"en":"Maiden Saikal, daughter of Khan Karacha,"},{"id":"semetey-1-2013:p0400:b004:l018","ordinal":107361,"en":"Then attacked the watchman"},{"id":"semetey-1-2013:p0400:b004:l019","ordinal":107362,"en":"And reached him sooner than an arrow."},{"id":"semetey-1-2013:p0400:b004:l020","ordinal":107363,"en":"Upon reaching him, Maiden Saikal,"},{"id":"semetey-1-2013:p0400:b004:l021","ordinal":107364,"en":"From Kalkaman's black horse,"},{"id":"semetey-1-2013:p0400:b004:l022","ordinal":107365,"en":"Thrust at Serek as she came"},{"id":"semetey-1-2013:p0400:b004:l023","ordinal":107366,"en":"And struck him down as she swept past."},{"id":"semetey-1-2013:p0400:b004:l024","ordinal":107367,"en":"Kalkaman's black horse,"},{"id":"semetey-1-2013:p0400:b004:l025","ordinal":107368,"en":"Its watchman pierced by a spear,"},{"id":"semetey-1-2013:p0400:b004:l026","ordinal":107369,"en":"To Karacha's fierce daughter"},{"id":"semetey-1-2013:p0400:b004:l027","ordinal":107370,"en":"Fell as booty."},{"id":"semetey-1-2013:p0400:b004:l028","ordinal":107371,"en":"Khan Manas's forty dignitaries,"},{"id":"semetey-1-2013:p0400:b004:l029","ordinal":107372,"en":"Whom the twelve tribes could not bring down,"},{"id":"semetey-1-2013:p0400:b004:l030","ordinal":107373,"en":"With no one left who could withstand them,"},{"id":"semetey-1-2013:p0400:b004:l031","ordinal":107374,"en":"Told to drink water, they drank poison;"},{"id":"semetey-1-2013:p0400:b004:l032","ordinal":107375,"en":"Told to take a hat, they cut off a head;"},{"id":"semetey-1-2013:p0400:b004:l033","ordinal":107376,"en":"Told to spill blood, they spilled stomach contents."},{"id":"semetey-1-2013:p0400:b004:l034","ordinal":107377,"en":"Khan Manas's mighty warrior,"},{"id":"semetey-1-2013:p0400:b004:l035","ordinal":107378,"en":"When the watchman had thus fallen,"},{"id":"semetey-1-2013:p0400:b004:l036","ordinal":107379,"en":"They all came rushing together."},{"id":"semetey-1-2013:p0400:b004:l037","ordinal":107380,"en":"They struck the drum;"},{"id":"semetey-1-2013:p0400:b004:l038","ordinal":107381,"en":"All cried out, 'Manas!'"},{"id":"semetey-1-2013:p0400:b004:l039","ordinal":107382,"en":"Shouting face to face,"},{"id":"semetey-1-2013:p0401:b003:l001","ordinal":107383,"en":"They all arrived,"},{"id":"semetey-1-2013:p0401:b003:l002","ordinal":107384,"en":"Then raising 'Manas!' as their battle cry."},{"id":"semetey-1-2013:p0401:b003:l003","ordinal":107385,"en":"Your father Khan Manas's forty dignitaries"},{"id":"semetey-1-2013:p0401:b003:l005","ordinal":107386,"en":"And Maiden Saikal's forty warriors"},{"id":"semetey-1-2013:p0401:b003:l006","ordinal":107387,"en":"Mingled in battle."},{"id":"semetey-1-2013:p0401:b003:l007","ordinal":107388,"en":"For six days and six nights,"},{"id":"semetey-1-2013:p0401:b003:l008","ordinal":107389,"en":"On the plain of Acha-Moinok,"},{"id":"semetey-1-2013:p0401:b003:l009","ordinal":107390,"en":"They fought with spears without mercy."},{"id":"semetey-1-2013:p0401:b003:l010","ordinal":107391,"en":"Neither could take the other;"},{"id":"semetey-1-2013:p0401:b003:l011","ordinal":107392,"en":"Neither side could"},{"id":"semetey-1-2013:p0401:b003:l012","ordinal":107393,"en":"Put the other to death."},{"id":"semetey-1-2013:p0401:b003:l013","ordinal":107394,"en":"Facing one another,"},{"id":"semetey-1-2013:p0401:b003:l014","ordinal":107395,"en":"Pressing in to fight,"},{"id":"semetey-1-2013:p0401:b003:l015","ordinal":107396,"en":"While neither could overcome the other,"},{"id":"semetey-1-2013:p0401:b003:l016","ordinal":107397,"en":"Karacha's Khan Saikal"},{"id":"semetey-1-2013:p0401:b003:l017","ordinal":107398,"en":"Came charging up."},{"id":"semetey-1-2013:p0401:b003:l018","ordinal":107399,"en":"Yraman's Yrchyuul,"},{"id":"semetey-1-2013:p0401:b003:l019","ordinal":107400,"en":"Warrior Shuutu, with a hat like roof felt,"},{"id":"semetey-1-2013:p0401:b003:l020","ordinal":107401,"en":"Kyrgylchal, leader of the forty,"},{"id":"semetey-1-2013:p0401:b003:l021","ordinal":107402,"en":"Baichoro of the powerful arms,"},{"id":"semetey-1-2013:p0401:b003:l022","ordinal":107403,"en":"And Bozuul, son of Bodokhan:"},{"id":"semetey-1-2013:p0401:b003:l023","ordinal":107404,"en":"Saikal bore down upon them relentlessly."},{"id":"semetey-1-2013:p0401:b003:l024","ordinal":107405,"en":"Where she struck, seven of them"},{"id":"semetey-1-2013:p0401:b003:l025","ordinal":107406,"en":"She knocked down as she passed."},{"id":"semetey-1-2013:p0401:b003:l026","ordinal":107407,"en":"Warrior Bolot, son of Khan Ermek,"},{"id":"semetey-1-2013:p0401:b003:l027","ordinal":107408,"en":"Was Maiden Saikal's champion."},{"id":"semetey-1-2013:p0401:b003:l028","ordinal":107409,"en":"Of Khan Manas's forty dignitaries,"},{"id":"semetey-1-2013:p0401:b003:l029","ordinal":107410,"en":"The horses of those who fell,"},{"id":"semetey-1-2013:p0401:b003:l030","ordinal":107411,"en":"Warrior Bolot took as booty."},{"id":"semetey-1-2013:p0401:b003:l031","ordinal":107412,"en":"Saikal wreaked devastation;"},{"id":"semetey-1-2013:p0401:b003:l032","ordinal":107413,"en":"She unhorsed those she faced,"},{"id":"semetey-1-2013:p0401:b003:l033","ordinal":107414,"en":"And renowned Saikal took them."},{"id":"semetey-1-2013:p0401:b003:l034","ordinal":107415,"en":"With a golden forelock and tasseled belt,"},{"id":"semetey-1-2013:p0401:b003:l035","ordinal":107416,"en":"Almambet, son of Khan Azyz,"},{"id":"semetey-1-2013:p0401:b003:l036","ordinal":107417,"en":"Tall and broad-shouldered,"},{"id":"semetey-1-2013:p0401:b003:l037","ordinal":107418,"en":"Both a champion and a lion,"},{"id":"semetey-1-2013:p0401:b003:l038","ordinal":107419,"en":"Against Beezhin beyond the Four Companions' reach,"},{"id":"semetey-1-2013:p0401:b003:l039","ordinal":107420,"en":"The beloved warrior whose strength sufficed:"},{"id":"semetey-1-2013:p0401:b005:l001","ordinal":107421,"en":"Almambet's Sarala,"},{"id":"semetey-1-2013:p0401:b005:l002","ordinal":107422,"en":"With hoe-like hooves and broad haunches,"},{"id":"semetey-1-2013:p0401:b005:l003","ordinal":107423,"en":"The tulpar of wide lands,"},{"id":"semetey-1-2013:p0401:b005:l004","ordinal":107424,"en":"Stood firm in battle."},{"id":"semetey-1-2013:p0401:b005:l005","ordinal":107425,"en":"Gripping his red spear,"},{"id":"semetey-1-2013:p0401:b005:l006","ordinal":107426,"en":"With all forty choros left on foot,"},{"id":"semetey-1-2013:p0401:b005:l007","ordinal":107427,"en":"Fighting with Maiden Saikal,"},{"id":"semetey-1-2013:p0401:b005:l008","ordinal":107428,"en":"For forty-seven days your Alake"},{"id":"semetey-1-2013:p0401:b005:l009","ordinal":107429,"en":"Held out all alone."},{"id":"semetey-1-2013:p0401:b005:l010","ordinal":107430,"en":"Your Alake stood upon a summit;"},{"id":"semetey-1-2013:p0401:b005:l011","ordinal":107431,"en":"Maiden Saikal stretched out and thrust;"},{"id":"semetey-1-2013:p0401:b005:l012","ordinal":107432,"en":"Your lion Almam did not flinch."},{"id":"semetey-1-2013:p0401:b005:l013","ordinal":107433,"en":"Maiden Saikal stood upon a cliff;"},{"id":"semetey-1-2013:p0401:b005:l014","ordinal":107434,"en":"Your Alake shouted and thrust;"},{"id":"semetey-1-2013:p0401:b005:l015","ordinal":107435,"en":"Maiden Saikal did not bend."},{"id":"semetey-1-2013:p0401:b005:l016","ordinal":107436,"en":"Standing, they fought with spears;"},{"id":"semetey-1-2013:p0401:b005:l017","ordinal":107437,"en":"The spear points bent."},{"id":"semetey-1-2013:p0401:b005:l018","ordinal":107438,"en":"Drenched in dark dust,"},{"id":"semetey-1-2013:p0401:b005:l019","ordinal":107439,"en":"They fought without retreat."},{"id":"semetey-1-2013:p0401:b005:l020","ordinal":107440,"en":"The spears they fought with shattered;"},{"id":"semetey-1-2013:p0401:b005:l021","ordinal":107441,"en":"Earth flew, tinder burned;"},{"id":"semetey-1-2013:p0401:b005:l022","ordinal":107442,"en":"Spears broke under the strain."},{"id":"semetey-1-2013:p0401:b005:l023","ordinal":107443,"en":"Almambet, your father's sworn brother,"},{"id":"semetey-1-2013:p0401:b005:l024","ordinal":107444,"en":"Fought with spears for sixty days"},{"id":"semetey-1-2013:p0401:b005:l025","ordinal":107445,"en":"And held out against Maiden Saikal."},{"id":"semetey-1-2013:p0401:b005:l026","ordinal":107446,"en":"Almambet, your father's sworn brother,"},{"id":"semetey-1-2013:p0401:b005:l027","ordinal":107447,"en":"Then setting his wounded pride aside,"},{"id":"semetey-1-2013:p0401:b005:l028","ordinal":107448,"en":"'Give me six days' grace,'"},{"id":"semetey-1-2013:p0401:b005:l029","ordinal":107449,"en":"He asked Maiden Saikal."},{"id":"semetey-1-2013:p0401:b005:l030","ordinal":107450,"en":"She agreed to his request;"},{"id":"semetey-1-2013:p0401:b005:l031","ordinal":107451,"en":"Khan Saikal, daughter of Khan Karacha,"},{"id":"semetey-1-2013:p0401:b005:l032","ordinal":107452,"en":"Granted six days' grace."},{"id":"semetey-1-2013:p0401:b005:l033","ordinal":107453,"en":"Then Almambet"},{"id":"semetey-1-2013:p0401:b005:l034","ordinal":107454,"en":"Came to his generous hero."},{"id":"semetey-1-2013:p0401:b005:l035","ordinal":107455,"en":"'My generous one, Manas, hear my words."},{"id":"semetey-1-2013:p0401:b005:l036","ordinal":107456,"en":"In many places I have waded through embers;"},{"id":"semetey-1-2013:p0401:b005:l037","ordinal":107457,"en":"On campaigns I have crossed thick showers of shot."},{"id":"semetey-1-2013:p0401:b005:l038","ordinal":107458,"en":"I have seen dark pits dug;"},{"id":"semetey-1-2013:p0401:b005:l039","ordinal":107459,"en":"I have seen misery set to boil."},{"id":"semetey-1-2013:p0402:b003:l001","ordinal":107460,"en":"I have faced foes in many places,"},{"id":"semetey-1-2013:p0402:b003:l002","ordinal":107461,"en":"Yet here I have come to this."},{"id":"semetey-1-2013:p0402:b003:l004","ordinal":107462,"en":"The forty mighty warriors lost their mounts;","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0402:b003:l005","ordinal":107463,"en":"I let them all be taken."},{"id":"semetey-1-2013:p0402:b003:l006","ordinal":107464,"en":"I have seen a pass of hellish hardship;"},{"id":"semetey-1-2013:p0402:b003:l007","ordinal":107465,"en":"I have seen a lion among women."},{"id":"semetey-1-2013:p0402:b003:l008","ordinal":107466,"en":"One who could throw the whole world into turmoil,"},{"id":"semetey-1-2013:p0402:b003:l009","ordinal":107467,"en":"I have seen a surpassing champion warrior.'"},{"id":"semetey-1-2013:p0402:b003:l010","ordinal":107468,"en":"After Almambet said this,"},{"id":"semetey-1-2013:p0402:b003:l011","ordinal":107469,"en":"Your father Khan Manas, the beloved lion,"},{"id":"semetey-1-2013:p0402:b003:l012","ordinal":107470,"en":"Raised a tumult."},{"id":"semetey-1-2013:p0402:b003:l013","ordinal":107471,"en":"Khan Bakai and Almambet,"},{"id":"semetey-1-2013:p0402:b003:l014","ordinal":107472,"en":"Both together, warrior Manas"},{"id":"semetey-1-2013:p0402:b003:l015","ordinal":107473,"en":"Nearly swallowed them whole."},{"id":"semetey-1-2013:p0402:b003:l016","ordinal":107474,"en":"'When I was in Talas,"},{"id":"semetey-1-2013:p0402:b003:l017","ordinal":107475,"en":"Think of it, O my Almam:"},{"id":"semetey-1-2013:p0402:b003:l018","ordinal":107476,"en":"I went about eating slices of horse rump."},{"id":"semetey-1-2013:p0402:b003:l019","ordinal":107477,"en":"Not merely a bitch, but the Kalmaks,"},{"id":"semetey-1-2013:p0402:b003:l020","ordinal":107478,"en":"I thought I would grind to powder."},{"id":"semetey-1-2013:p0402:b003:l021","ordinal":107479,"en":"I went about eating slices of horse-belly fat."},{"id":"semetey-1-2013:p0402:b003:l022","ordinal":107480,"en":"My supports, Bakai and Almambet,"},{"id":"semetey-1-2013:p0402:b003:l023","ordinal":107481,"en":"If both stood beside me,"},{"id":"semetey-1-2013:p0402:b003:l024","ordinal":107482,"en":"Not merely a woman, precious souls,"},{"id":"semetey-1-2013:p0402:b003:l025","ordinal":107483,"en":"I thought I would destroy the kaldai."},{"id":"semetey-1-2013:p0402:b003:l026","ordinal":107484,"en":"With dark spear and Zhoibolot,"},{"id":"semetey-1-2013:p0402:b003:l027","ordinal":107485,"en":"I thought I would clash in battle."},{"id":"semetey-1-2013:p0402:b003:l028","ordinal":107486,"en":"Not merely a woman, but the Chinese,"},{"id":"semetey-1-2013:p0402:b003:l029","ordinal":107487,"en":"I thought I would grapple with them."},{"id":"semetey-1-2013:p0402:b003:l030","ordinal":107488,"en":"If my precious self remained alive,"},{"id":"semetey-1-2013:p0402:b003:l031","ordinal":107489,"en":"With you two, my supports, there,"},{"id":"semetey-1-2013:p0402:b003:l032","ordinal":107490,"en":"If I bound up Ak-kula's tail,"},{"id":"semetey-1-2013:p0402:b003:l033","ordinal":107491,"en":"I used to think my horse would prevail."},{"id":"semetey-1-2013:p0402:b003:l034","ordinal":107492,"en":"Not merely a woman, but so many others,"},{"id":"semetey-1-2013:p0402:b003:l035","ordinal":107493,"en":"If my support Almambet stood beside me,"},{"id":"semetey-1-2013:p0402:b003:l036","ordinal":107494,"en":"I used to think my claim would prevail."},{"id":"semetey-1-2013:p0402:b003:l037","ordinal":107495,"en":"Pah, pah, pah, my Almam, let the night hear it;"},{"id":"semetey-1-2013:p0402:b003:l038","ordinal":107496,"en":"Who should hear those gloomy words of yours, my Almam?"},{"id":"semetey-1-2013:p0402:b004:l001","ordinal":107497,"en":"Let the deep dug pit hear them;"},{"id":"semetey-1-2013:p0402:b004:l002","ordinal":107498,"en":"Let the misery set to boil hear them, my Almam."},{"id":"semetey-1-2013:p0402:b004:l003","ordinal":107499,"en":"Let the rushing water hear them;"},{"id":"semetey-1-2013:p0402:b004:l004","ordinal":107500,"en":"Those words of yours,"},{"id":"semetey-1-2013:p0402:b004:l005","ordinal":107501,"en":"Let the cliff with its high pass hear them."},{"id":"semetey-1-2013:p0402:b004:l006","ordinal":107502,"en":"Let the dark dug grave hear them;"},{"id":"semetey-1-2013:p0402:b004:l007","ordinal":107503,"en":"Who else should hear them?"},{"id":"semetey-1-2013:p0402:b004:l008","ordinal":107504,"en":"Pah, pah, my Almam, death is certain."},{"id":"semetey-1-2013:p0402:b004:l009","ordinal":107505,"en":"Defeated by a wretched girl,"},{"id":"semetey-1-2013:p0402:b004:l010","ordinal":107506,"en":"Perhaps our fortune has broken!'"},{"id":"semetey-1-2013:p0402:b004:l011","ordinal":107507,"en":"Khan Manas grew furious,"},{"id":"semetey-1-2013:p0402:b004:l012","ordinal":107508,"en":"Girded his waist tightly,"},{"id":"semetey-1-2013:p0402:b004:l013","ordinal":107509,"en":"Cried out, praying for faith,"},{"id":"semetey-1-2013:p0402:b004:l014","ordinal":107510,"en":"Sullen with grief,"},{"id":"semetey-1-2013:p0402:b004:l015","ordinal":107511,"en":"His eyes blazed like fire."},{"id":"semetey-1-2013:p0402:b004:l016","ordinal":107512,"en":"His great teeth, broad as doors,"},{"id":"semetey-1-2013:p0402:b004:l017","ordinal":107513,"en":"He clenched and ground hard."},{"id":"semetey-1-2013:p0402:b004:l018","ordinal":107514,"en":"Bloodlust truly seized him;"},{"id":"semetey-1-2013:p0402:b004:l019","ordinal":107515,"en":"Startled, he said his prayers."},{"id":"semetey-1-2013:p0402:b004:l020","ordinal":107516,"en":"The foal of a young mare,"},{"id":"semetey-1-2013:p0402:b004:l021","ordinal":107517,"en":"The Duldul of the horse herds,"},{"id":"semetey-1-2013:p0402:b004:l022","ordinal":107518,"en":"Ak-kula, he saddled."},{"id":"semetey-1-2013:p0402:b004:l023","ordinal":107519,"en":"He strapped on Zulpukor"},{"id":"semetey-1-2013:p0402:b004:l024","ordinal":107520,"en":"And made his weapons ready."}]
