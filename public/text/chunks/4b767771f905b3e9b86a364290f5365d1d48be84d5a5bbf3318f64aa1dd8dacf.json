[{"id":"manas-2010:p0958:b001:l011","ordinal":41985,"en":"Knew long ago."},{"id":"manas-2010:p0958:b001:l012","ordinal":41986,"en":"“If he is truly a khan,"},{"id":"manas-2010:p0958:b001:l013","ordinal":41987,"en":"He will come seeking Kanykey,” I said."},{"id":"manas-2010:p0958:b001:l014","ordinal":41988,"en":"From God Most High alone"},{"id":"manas-2010:p0958:b001:l015","ordinal":41989,"en":"I have been asking this.’"},{"id":"manas-2010:p0958:b001:l016","ordinal":41990,"en":"Thus Kanykey,"},{"id":"manas-2010:p0958:b001:l017","ordinal":41991,"en":"Herself still a little girl,"},{"id":"manas-2010:p0958:b001:l018","ordinal":41992,"en":"Her hair not yet long enough to braid,"},{"id":"manas-2010:p0958:b001:l019","ordinal":41993,"en":"Quickly vowed an offering to Baabedin,"},{"id":"manas-2010:p0958:b001:l020","ordinal":41994,"en":"Vowed a sheep to Koroson."},{"id":"manas-2010:p0958:b001:l021","ordinal":41995,"en":"Watching him from outside,"},{"id":"manas-2010:p0958:b001:l022","ordinal":41996,"en":"Taking his full measure,"},{"id":"manas-2010:p0958:b001:l023","ordinal":41997,"en":"Then the blood-drinker's"},{"id":"manas-2010:p0958:b001:l024","ordinal":41998,"en":"Blood-thirst she now understood."},{"id":"manas-2010:p0958:b001:l025","ordinal":41999,"en":"Like one who had found what was missing,"},{"id":"manas-2010:p0958:b001:l026","ordinal":42000,"en":"Fortunate Kanykey"},{"id":"manas-2010:p0958:b001:l027","ordinal":42001,"en":"Now smiled with shining eyes."},{"id":"manas-2010:p0958:b001:l028","ordinal":42002,"en":"Making the unknown known,"},{"id":"manas-2010:p0958:b001:l029","ordinal":42003,"en":"The learned elder Bakay,"},{"id":"manas-2010:p0958:b001:l030","ordinal":42004,"en":"Loading eighty camels with gold coins,"},{"id":"manas-2010:p0958:b001:l031","ordinal":42005,"en":"To Temirkan's court"},{"id":"manas-2010:p0958:b001:l032","ordinal":42006,"en":"Your ocean-like Bakay now went."},{"id":"manas-2010:p0958:b001:l033","ordinal":42007,"en":"As kin by marriage, driving livestock,"},{"id":"manas-2010:p0958:b001:l034","ordinal":42008,"en":"Offering homage, feasting on fat,"},{"id":"manas-2010:p0958:b001:l035","ordinal":42009,"en":"They remained embracing."},{"id":"manas-2010:p0958:b001:l036","ordinal":42010,"en":"In this court of Bukhara,"},{"id":"manas-2010:p0958:b001:l037","ordinal":42011,"en":"When Kanykey's age"},{"id":"manas-2010:p0958:b001:l038","ordinal":42012,"en":"Reaches seventeen years,"},{"id":"manas-2010:p0958:b001:l039","ordinal":42013,"en":"“Go back now,” he said,"},{"id":"manas-2010:p0958:b001:l040","ordinal":42014,"en":"“Then take my daughter,” he said."},{"id":"manas-2010:p0958:b001:l041","ordinal":42015,"en":"Not to agree if an enemy asked,"},{"id":"manas-2010:p0958:b001:l042","ordinal":42016,"en":"Not to give her to another khan,"}]
