[{"id":"semetey-1-2013:p1011:b005:l026","ordinal":153345,"en":"Were there beginning their games."},{"id":"semetey-1-2013:p1011:b005:l027","ordinal":153346,"en":"In their midst Aychurok"},{"id":"semetey-1-2013:p1011:b005:l028","ordinal":153347,"en":"Flashed like a poppy."},{"id":"semetey-1-2013:p1011:b005:l029","ordinal":153348,"en":"The poor, formidable beauty's"},{"id":"semetey-1-2013:p1011:b005:l030","ordinal":153349,"en":"Fitted coat and fine dress"},{"id":"semetey-1-2013:p1011:b005:l031","ordinal":153350,"en":"Showed their hems billowing."},{"id":"semetey-1-2013:p1011:b005:l032","ordinal":153351,"en":"Aychurok, daughter of Akun,"},{"id":"semetey-1-2013:p1011:b005:l033","ordinal":153352,"en":"Wore a skullcap made of gold;"},{"id":"semetey-1-2013:p1011:b005:l034","ordinal":153353,"en":"She appeared worth the whole world,"},{"id":"semetey-1-2013:p1011:b005:l035","ordinal":153354,"en":"That poor daughter of Akun."},{"id":"semetey-1-2013:p1011:b005:l036","ordinal":153355,"en":"Of moon-beautiful Churok,"},{"id":"semetey-1-2013:p1011:b005:l037","ordinal":153356,"en":"Which enchantment shall we tell?"},{"id":"semetey-1-2013:p1011:b005:l038","ordinal":153357,"en":"When snow falls upon black earth,"},{"id":"semetey-1-2013:p1011:b005:l039","ordinal":153358,"en":"Look at the snow, and you see her flesh;"},{"id":"semetey-1-2013:p1012:b003:l001","ordinal":153359,"en":"When blood falls upon snow,"},{"id":"semetey-1-2013:p1012:b003:l002","ordinal":153360,"en":"Look at the blood, and you see her face;"},{"id":"semetey-1-2013:p1012:b003:l003","ordinal":153361,"en":"Look at sugar, and you hear her speech;"},{"id":"semetey-1-2013:p1012:b003:l004","ordinal":153362,"en":"Look at the morning star, and you see her eyes."},{"id":"semetey-1-2013:p1012:b003:l005","ordinal":153363,"en":"Her waist was sheath-slender, her face moon-bright,"},{"id":"semetey-1-2013:p1012:b003:l006","ordinal":153364,"en":"That renowned beauty, poor woman."},{"id":"semetey-1-2013:p1012:b003:l007","ordinal":153365,"en":"She stepped forward in radiance;"},{"id":"semetey-1-2013:p1012:b003:l008","ordinal":153366,"en":"A little gold-covered amulet"},{"id":"semetey-1-2013:p1012:b003:l009","ordinal":153367,"en":"Floated upon her breast."},{"id":"semetey-1-2013:p1012:b003:l010","ordinal":153368,"en":"Maidens and daughters-in-law stood together;"},{"id":"semetey-1-2013:p1012:b003:l011","ordinal":153369,"en":"Mighty Churok among them"},{"id":"semetey-1-2013:p1012:b003:l012","ordinal":153370,"en":"Made merry."},{"id":"semetey-1-2013:p1012:b003:l013","ordinal":153371,"en":"Her laughter made the sun set,"},{"id":"semetey-1-2013:p1012:b003:l014","ordinal":153372,"en":"And her revelry brought the dawn."},{"id":"semetey-1-2013:p1012:b003:l015","ordinal":153373,"en":"Behind the swing"},{"id":"semetey-1-2013:p1012:b003:l016","ordinal":153374,"en":"They played the game of Shabyyat;"},{"id":"semetey-1-2013:p1012:b003:l017","ordinal":153375,"en":"Maidens and daughters-in-law mingled"},{"id":"semetey-1-2013:p1012:b003:l018","ordinal":153376,"en":"And played in growing excitement."},{"id":"semetey-1-2013:p1012:b003:l019","ordinal":153377,"en":"Among the daughters-in-law was Kermekash,"},{"id":"semetey-1-2013:p1012:b003:l020","ordinal":153378,"en":"And eloquent beauty Karachach;"},{"id":"semetey-1-2013:p1012:b003:l021","ordinal":153379,"en":"At the head of the maidens was Kynymjan,"},{"id":"semetey-1-2013:p1012:b003:l022","ordinal":153380,"en":"And formidable beauty Tynymkan."},{"id":"semetey-1-2013:p1012:b003:l023","ordinal":153381,"en":"There was Sugalak of the irrigator,"},{"id":"semetey-1-2013:p1012:b003:l024","ordinal":153382,"en":"Among those maidens,"},{"id":"semetey-1-2013:p1012:b003:l025","ordinal":153383,"en":"And Birmoyun of the grain grower;"},{"id":"semetey-1-2013:p1012:b003:l026","ordinal":153384,"en":"Thimble-mouthed Oyumkan,"},{"id":"semetey-1-2013:p1012:b003:l027","ordinal":153385,"en":"And among all those maidens,"},{"id":"semetey-1-2013:p1012:b003:l028","ordinal":153386,"en":"Proudly pacing Kanymjan;"},{"id":"semetey-1-2013:p1012:b003:l029","ordinal":153387,"en":"Camel-calf-eyed Bolpokan,"},{"id":"semetey-1-2013:p1012:b003:l030","ordinal":153388,"en":"And incomparable beauty Kanymjan."},{"id":"semetey-1-2013:p1012:b003:l031","ordinal":153389,"en":"Your sister-in-law with her matched companions"},{"id":"semetey-1-2013:p1012:b003:l032","ordinal":153390,"en":"Placed her arm around Kolkunay;"},{"id":"semetey-1-2013:p1012:b003:l033","ordinal":153391,"en":"Altynay sang laments beside her,"},{"id":"semetey-1-2013:p1012:b003:l034","ordinal":153392,"en":"And Kermekash shared her counsel;"},{"id":"semetey-1-2013:p1012:b003:l035","ordinal":153393,"en":"They walked with stately bearing,"},{"id":"semetey-1-2013:p1012:b003:l036","ordinal":153394,"en":"With eloquent beauty Karakash."},{"id":"semetey-1-2013:p1012:b003:l037","ordinal":153395,"en":"She herself was still a young child,"},{"id":"semetey-1-2013:p1012:b003:l038","ordinal":153396,"en":"Her hair not yet long enough to braid,"},{"id":"semetey-1-2013:p1012:b003:l039","ordinal":153397,"en":"In a red dress with a crescent waist."},{"id":"semetey-1-2013:p1012:b004:l001","ordinal":153398,"en":"From the shimmering beauties"},{"id":"semetey-1-2013:p1012:b004:l002","ordinal":153399,"en":"She had gathered the finest."},{"id":"semetey-1-2013:p1012:b004:l003","ordinal":153400,"en":"Upon a wondrous plane tree and birch"},{"id":"semetey-1-2013:p1012:b004:l004","ordinal":153401,"en":"They had hung the swing."},{"id":"semetey-1-2013:p1012:b004:l005","ordinal":153402,"en":"She appeared like a noble maiden;"},{"id":"semetey-1-2013:p1012:b004:l006","ordinal":153403,"en":"Poor Churok stood at their head,"},{"id":"semetey-1-2013:p1012:b004:l007","ordinal":153404,"en":"And thirty daughters-in-law and thirty maidens"},{"id":"semetey-1-2013:p1012:b004:l008","ordinal":153405,"en":"Had begun their games."},{"id":"semetey-1-2013:p1012:b004:l009","ordinal":153406,"en":"In their midst, your sister-in-law"},{"id":"semetey-1-2013:p1012:b004:l010","ordinal":153407,"en":"Played and raised laughter."},{"id":"semetey-1-2013:p1012:b004:l011","ordinal":153408,"en":"With renowned Churok at their head,"},{"id":"semetey-1-2013:p1012:b004:l012","ordinal":153409,"en":"The companion watching them"},{"id":"semetey-1-2013:p1012:b004:l013","ordinal":153410,"en":"Felt his heart carried away."},{"id":"semetey-1-2013:p1012:b004:l014","ordinal":153411,"en":"Kulchoro, who had never seen a maiden,"},{"id":"semetey-1-2013:p1012:b004:l015","ordinal":153412,"en":"Saw them and grew excited;"},{"id":"semetey-1-2013:p1012:b004:l016","ordinal":153413,"en":"He began the whole commotion."},{"id":"semetey-1-2013:p1012:b004:l017","ordinal":153414,"en":"With red Buurul beneath him,"},{"id":"semetey-1-2013:p1012:b004:l018","ordinal":153415,"en":"Kulchoro turned at an angle"},{"id":"semetey-1-2013:p1012:b004:l019","ordinal":153416,"en":"And plunged straight"},{"id":"semetey-1-2013:p1012:b004:l020","ordinal":153417,"en":"Into the fearsome Urgench."},{"id":"semetey-1-2013:p1012:b004:l021","ordinal":153418,"en":"Kulchoro had seen the maidens;"},{"id":"semetey-1-2013:p1012:b004:l022","ordinal":153419,"en":"The poor man, who had never seen a maiden,"},{"id":"semetey-1-2013:p1012:b004:l023","ordinal":153420,"en":"Did not look all around him,"},{"id":"semetey-1-2013:p1012:b004:l024","ordinal":153421,"en":"And in the fearsome Urgench"},{"id":"semetey-1-2013:p1012:b004:l025","ordinal":153422,"en":"Did not spare his threadlike life."},{"id":"semetey-1-2013:p1012:b004:l033","ordinal":153423,"en":"They set aside the swing,","gapBefore":"[Passage withheld: sexual content involving a minor]"},{"id":"semetey-1-2013:p1012:b004:l034","ordinal":153424,"en":"And played the game of Shabiyet;"},{"id":"semetey-1-2013:p1012:b004:l035","ordinal":153425,"en":"Maidens and daughters-in-law mingled,"},{"id":"semetey-1-2013:p1012:b004:l036","ordinal":153426,"en":"With mighty Churok at their head,"},{"id":"semetey-1-2013:p1012:b004:l037","ordinal":153427,"en":"And played their difficult game."},{"id":"semetey-1-2013:p1012:b004:l038","ordinal":153428,"en":"Flattering Churok,"},{"id":"semetey-1-2013:p1012:b004:l039","ordinal":153429,"en":"They excitedly told their dreams,"},{"id":"semetey-1-2013:p1013:b003:l001","ordinal":153430,"en":"That lively Akylay of before"},{"id":"semetey-1-2013:p1013:b003:l002","ordinal":153431,"en":"Spoke of an auspicious sign:"},{"id":"semetey-1-2013:p1013:b003:l003","ordinal":153432,"en":"\"My dear elder sisters,"},{"id":"semetey-1-2013:p1013:b003:l004","ordinal":153433,"en":"My honored sisters-in-law,"},{"id":"semetey-1-2013:p1013:b003:l005","ordinal":153434,"en":"Last night as I slept, I dreamed;"},{"id":"semetey-1-2013:p1013:b003:l006","ordinal":153435,"en":"In my dream I saw a fortunate sign."},{"id":"semetey-1-2013:p1013:b003:l007","ordinal":153436,"en":"A black-spotted tiger"},{"id":"semetey-1-2013:p1013:b003:l008","ordinal":153437,"en":"Ranged through the city,"},{"id":"semetey-1-2013:p1013:b003:l009","ordinal":153438,"en":"And the dogs would not stop their sharp barking."},{"id":"semetey-1-2013:p1013:b003:l010","ordinal":153439,"en":"A scarred gray-wolf lion"},{"id":"semetey-1-2013:p1013:b003:l011","ordinal":153440,"en":"Came raging into Afghanistan;"},{"id":"semetey-1-2013:p1013:b003:l012","ordinal":153441,"en":"Such good fortune appeared."},{"id":"semetey-1-2013:p1013:b003:l013","ordinal":153442,"en":"Saying, 'I shall go out to meet him,'"},{"id":"semetey-1-2013:p1013:b003:l014","ordinal":153443,"en":"The enemies who opposed him were destroyed;"},{"id":"semetey-1-2013:p1013:b003:l015","ordinal":153444,"en":"Saying, 'This is that black-spotted tiger,'"},{"id":"semetey-1-2013:p1013:b003:l016","ordinal":153445,"en":"The people of Afghanistan honored him."},{"id":"semetey-1-2013:p1013:b003:l017","ordinal":153446,"en":"What can this mean?"},{"id":"semetey-1-2013:p1013:b003:l018","ordinal":153447,"en":"Younger sister and elder sister,"},{"id":"semetey-1-2013:p1013:b003:l019","ordinal":153448,"en":"Interpret this dream of mine!"},{"id":"semetey-1-2013:p1013:b003:l020","ordinal":153449,"en":"A giant black bird, the Zymyruk,"},{"id":"semetey-1-2013:p1013:b003:l021","ordinal":153450,"en":"Stretched its great feet down from the sky."},{"id":"semetey-1-2013:p1013:b003:l022","ordinal":153451,"en":"Unable to withstand its wrath,"},{"id":"semetey-1-2013:p1013:b003:l023","ordinal":153452,"en":"The besieging Jediger"},{"id":"semetey-1-2013:p1013:b003:l024","ordinal":153453,"en":"Fled away like crows."},{"id":"semetey-1-2013:p1013:b003:l025","ordinal":153454,"en":"Forty men, each worth a thousand,"},{"id":"semetey-1-2013:p1013:b003:l026","ordinal":153455,"en":"Within this city of Afghanistan"},{"id":"semetey-1-2013:p1013:b003:l027","ordinal":153456,"en":"Established their royal camp firmly;"},{"id":"semetey-1-2013:p1013:b003:l028","ordinal":153457,"en":"They took everything in the direction they faced."},{"id":"semetey-1-2013:p1013:b003:l029","ordinal":153458,"en":"What can this mean?"},{"id":"semetey-1-2013:p1013:b003:l030","ordinal":153459,"en":"Interpret this dream of mine!\""},{"id":"semetey-1-2013:p1013:b003:l031","ordinal":153460,"en":"While Akylay stood speaking thus,"},{"id":"semetey-1-2013:p1013:b003:l032","ordinal":153461,"en":"Bold Kynymjan began to speak:"},{"id":"semetey-1-2013:p1013:b003:l033","ordinal":153462,"en":"\"That black-spotted tiger"},{"id":"semetey-1-2013:p1013:b003:l034","ordinal":153463,"en":"Was my khanly brother-in-law Semetey himself."},{"id":"semetey-1-2013:p1013:b003:l035","ordinal":153464,"en":"Because of my honored elder sister,"},{"id":"semetey-1-2013:p1013:b003:l036","ordinal":153465,"en":"He will grasp his blood-drinking weapon"},{"id":"semetey-1-2013:p1013:b003:l037","ordinal":153466,"en":"And cast havoc"},{"id":"semetey-1-2013:p1013:b003:l038","ordinal":153467,"en":"Among the enemies who oppose him."},{"id":"semetey-1-2013:p1013:b003:l039","ordinal":153468,"en":"The scarred gray-wolf lion,"},{"id":"semetey-1-2013:p1013:b004:l001","ordinal":153469,"en":"Who burns everything he faces,"},{"id":"semetey-1-2013:p1013:b004:l002","ordinal":153470,"en":"Was my heroic brother-in-law himself;"},{"id":"semetey-1-2013:p1013:b004:l003","ordinal":153471,"en":"From Kojo, who brought disaster,"},{"id":"semetey-1-2013:p1013:b004:l004","ordinal":153472,"en":"He will deliver us."},{"id":"semetey-1-2013:p1013:b004:l005","ordinal":153473,"en":"The giant black bird, the Zymyruk,"},{"id":"semetey-1-2013:p1013:b004:l006","ordinal":153474,"en":"Stretching its feet down from the sky,"},{"id":"semetey-1-2013:p1013:b004:l007","ordinal":153475,"en":"Means we have heard that my sister's husband"},{"id":"semetey-1-2013:p1013:b004:l008","ordinal":153476,"en":"Was born to surpass"},{"id":"semetey-1-2013:p1013:b004:l009","ordinal":153477,"en":"His father, gray-wolf Manas."},{"id":"semetey-1-2013:p1013:b004:l010","ordinal":153478,"en":"My tiger brother-in-law, that gray wolf,"},{"id":"semetey-1-2013:p1013:b004:l011","ordinal":153479,"en":"Will come here himself;"},{"id":"semetey-1-2013:p1013:b004:l012","ordinal":153480,"en":"If an enemy comes out to fight,"},{"id":"semetey-1-2013:p1013:b004:l013","ordinal":153481,"en":"He will cast havoc among them."},{"id":"semetey-1-2013:p1013:b004:l014","ordinal":153482,"en":"A husband has come"},{"id":"semetey-1-2013:p1013:b004:l015","ordinal":153483,"en":"For my renowned, unfortunate sister!\""},{"id":"semetey-1-2013:p1013:b004:l016","ordinal":153484,"en":"Before she finished telling her dream,"},{"id":"semetey-1-2013:p1013:b004:l017","ordinal":153485,"en":"The dark-haired maiden posted as lookout,"},{"id":"semetey-1-2013:p1013:b004:l018","ordinal":153486,"en":"And the fair-haired maiden set as guard,"},{"id":"semetey-1-2013:p1013:b004:l019","ordinal":153487,"en":"Bent their knees,"},{"id":"semetey-1-2013:p1013:b004:l020","ordinal":153488,"en":"Bowed before Aychurok,"},{"id":"semetey-1-2013:p1013:b004:l021","ordinal":153489,"en":"And shouted out their good news:"},{"id":"semetey-1-2013:p1013:b004:l022","ordinal":153490,"en":"\"Thirty daughters-in-law and thirty maidens,"},{"id":"semetey-1-2013:p1013:b004:l023","ordinal":153491,"en":"Women playing your games,"},{"id":"semetey-1-2013:p1013:b004:l024","ordinal":153492,"en":"Come here!\" they called."},{"id":"semetey-1-2013:p1013:b004:l025","ordinal":153493,"en":"\"My dear elder sisters!"},{"id":"semetey-1-2013:p1013:b004:l026","ordinal":153494,"en":"Did you learn what I learned?"},{"id":"semetey-1-2013:p1013:b004:l027","ordinal":153495,"en":"Did you perceive what I perceived?"},{"id":"semetey-1-2013:p1013:b004:l028","ordinal":153496,"en":"Did you see what I saw?"},{"id":"semetey-1-2013:p1013:b004:l029","ordinal":153497,"en":"A man has come to the farther bank,"},{"id":"semetey-1-2013:p1013:b004:l030","ordinal":153498,"en":"His enormity equal to half a mountain,"},{"id":"semetey-1-2013:p1013:b004:l031","ordinal":153499,"en":"As though he would devour all he sees."},{"id":"semetey-1-2013:p1013:b004:l032","ordinal":153500,"en":"He is broad across the right shoulder;"},{"id":"semetey-1-2013:p1013:b004:l033","ordinal":153501,"en":"When I look at his bearing,"},{"id":"semetey-1-2013:p1013:b004:l034","ordinal":153502,"en":"He is a hero who could rout the Oyrat."},{"id":"semetey-1-2013:p1013:b004:l035","ordinal":153503,"en":"He rides the red horse Buurul,"},{"id":"semetey-1-2013:p1013:b004:l036","ordinal":153504,"en":"Its horsehair tail tied in a firm knot;"},{"id":"semetey-1-2013:p1013:b004:l037","ordinal":153505,"en":"He is girded with a silver belt,"},{"id":"semetey-1-2013:p1013:b004:l038","ordinal":153506,"en":"And turns a face radiant as the sun;"},{"id":"semetey-1-2013:p1013:b004:l039","ordinal":153507,"en":"He wears a bulletproof coat,"}]
