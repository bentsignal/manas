[{"id":"semetey-1-2013:p0432:b004:l033","ordinal":109825,"en":"Still more scattered away."},{"id":"semetey-1-2013:p0432:b004:l034","ordinal":109826,"en":"Parted from their companions,"},{"id":"semetey-1-2013:p0432:b004:l035","ordinal":109827,"en":"Suffering distress, one by one,"},{"id":"semetey-1-2013:p0432:b004:l036","ordinal":109828,"en":"Still more went about looking."},{"id":"semetey-1-2013:p0432:b004:l037","ordinal":109829,"en":"Struck by spears in the clash,"},{"id":"semetey-1-2013:p0432:b004:l038","ordinal":109830,"en":"Still more cried out in misery."},{"id":"semetey-1-2013:p0432:b004:l039","ordinal":109831,"en":"Struck by battle-axes in the fight,"},{"id":"semetey-1-2013:p0433:b003:l001","ordinal":109832,"en":"Still more had been blinded."},{"id":"semetey-1-2013:p0433:b003:l002","ordinal":109833,"en":"With broken legs, unable to walk,"},{"id":"semetey-1-2013:p0433:b003:l003","ordinal":109834,"en":"Still more were being helped along."},{"id":"semetey-1-2013:p0433:b003:l004","ordinal":109835,"en":"With broken arms, crying in pain,"},{"id":"semetey-1-2013:p0433:b003:l005","ordinal":109836,"en":"Still more went about wailing."},{"id":"semetey-1-2013:p0433:b003:l006","ordinal":109837,"en":"Their cruppers broken,"},{"id":"semetey-1-2013:p0433:b003:l007","ordinal":109838,"en":"Their saddles slipping to their horses' necks,"},{"id":"semetey-1-2013:p0433:b003:l008","ordinal":109839,"en":"Still more were left in distress."},{"id":"semetey-1-2013:p0433:b003:l009","ordinal":109840,"en":"Many Chinese warriors"},{"id":"semetey-1-2013:p0433:b003:l010","ordinal":109841,"en":"Had their saddle-girths break,"},{"id":"semetey-1-2013:p0433:b003:l011","ordinal":109842,"en":"Their saddles falling under their horses' bellies;"},{"id":"semetey-1-2013:p0433:b003:l012","ordinal":109843,"en":"Still more were left in distress."},{"id":"semetey-1-2013:p0433:b003:l013","ordinal":109844,"en":"The cowards fled away;"},{"id":"semetey-1-2013:p0433:b003:l014","ordinal":109845,"en":"The brave stayed and fought."},{"id":"semetey-1-2013:p0433:b003:l015","ordinal":109846,"en":"When clear dawn broke,"},{"id":"semetey-1-2013:p0433:b003:l016","ordinal":109847,"en":"When light fell on the earth,"},{"id":"semetey-1-2013:p0433:b003:l017","ordinal":109848,"en":"Dawn whitened and opened,"},{"id":"semetey-1-2013:p0433:b003:l018","ordinal":109849,"en":"And light poured over the earth."},{"id":"semetey-1-2013:p0433:b003:l019","ordinal":109850,"en":"Birds rose as dawn broke,"},{"id":"semetey-1-2013:p0433:b003:l020","ordinal":109851,"en":"And the encircling Chinese appeared."},{"id":"semetey-1-2013:p0433:b003:l021","ordinal":109852,"en":"Kongurbay, son of Alooke,"},{"id":"semetey-1-2013:p0433:b003:l022","ordinal":109853,"en":"Also came out and rushed upon him."},{"id":"semetey-1-2013:p0433:b003:l023","ordinal":109854,"en":"Ezkara, khan of the Manchus,"},{"id":"semetey-1-2013:p0433:b003:l024","ordinal":109855,"en":"Orokkyr, khan of the Shibe,"},{"id":"semetey-1-2013:p0433:b003:l025","ordinal":109856,"en":"Hero Joloy, khan of the Kalmyks,"},{"id":"semetey-1-2013:p0433:b003:l026","ordinal":109857,"en":"The mass of hulking simpletons and swift runners"},{"id":"semetey-1-2013:p0433:b003:l027","ordinal":109858,"en":"Stirred up turmoil and swarmed thickly,"},{"id":"semetey-1-2013:p0433:b003:l028","ordinal":109859,"en":"Rushing in to torment him."},{"id":"semetey-1-2013:p0433:b003:l029","ordinal":109860,"en":"All those Chinese and many Kalmyks,"},{"id":"semetey-1-2013:p0433:b003:l030","ordinal":109861,"en":"Upon your khan father—"},{"id":"semetey-1-2013:p0433:b003:l031","ordinal":109862,"en":"Red-whipped Shypshaydar,"},{"id":"semetey-1-2013:p0433:b003:l032","ordinal":109863,"en":"The vast people of forty Chinese tribes,"},{"id":"semetey-1-2013:p0433:b003:l033","ordinal":109864,"en":"Who did not squat to urinate,"},{"id":"semetey-1-2013:p0433:b003:l034","ordinal":109865,"en":"Whose sleeves did not touch the ground,"},{"id":"semetey-1-2013:p0433:b003:l035","ordinal":109866,"en":"Of Allah Most High, the One,"},{"id":"semetey-1-2013:p0433:b003:l036","ordinal":109867,"en":"They knew neither existence nor oneness—"},{"id":"semetey-1-2013:p0433:b003:l037","ordinal":109868,"en":"Black Tiken and great Malgun,"},{"id":"semetey-1-2013:p0433:b003:l038","ordinal":109869,"en":"The Chinese khans rushed upon him,"},{"id":"semetey-1-2013:p0433:b003:l039","ordinal":109870,"en":"Saying they would seize your father."},{"id":"semetey-1-2013:p0433:b005:l001","ordinal":109871,"en":"So many wrestlers made ready."},{"id":"semetey-1-2013:p0433:b005:l002","ordinal":109872,"en":"Never sparing one he grappled with,"},{"id":"semetey-1-2013:p0433:b005:l003","ordinal":109873,"en":"By the flesh of a whole pig"},{"id":"semetey-1-2013:p0433:b005:l004","ordinal":109874,"en":"Never sated at one meal,"},{"id":"semetey-1-2013:p0433:b005:l005","ordinal":109875,"en":"Makil, huge as Mount Opol,"},{"id":"semetey-1-2013:p0433:b005:l006","ordinal":109876,"en":"Made ready on his right."},{"id":"semetey-1-2013:p0433:b005:l007","ordinal":109877,"en":"Shypshaydar and mighty Tiken,"},{"id":"semetey-1-2013:p0433:b005:l008","ordinal":109878,"en":"Upon your leopard father Manas,"},{"id":"semetey-1-2013:p0433:b005:l009","ordinal":109879,"en":"Khan Kongurbay, the fierce hero—"},{"id":"semetey-1-2013:p0433:b005:l010","ordinal":109880,"en":"All of them rushed in."},{"id":"semetey-1-2013:p0433:b005:l011","ordinal":109881,"en":"I, your unfortunate, ill-fated mother,"},{"id":"semetey-1-2013:p0433:b005:l012","ordinal":109882,"en":"From my blackcurrant eyes"},{"id":"semetey-1-2013:p0433:b005:l013","ordinal":109883,"en":"Shed tears a whip's length long."},{"id":"semetey-1-2013:p0433:b005:l014","ordinal":109884,"en":"My dear quail-like eyes"},{"id":"semetey-1-2013:p0433:b005:l015","ordinal":109885,"en":"Shed tears in separate streams."},{"id":"semetey-1-2013:p0433:b005:l016","ordinal":109886,"en":"Ready to die if struck by a bullet,"},{"id":"semetey-1-2013:p0433:b005:l017","ordinal":109887,"en":"If my death had come, with my generous lord"},{"id":"semetey-1-2013:p0433:b005:l018","ordinal":109888,"en":"To go and lie entwined,"},{"id":"semetey-1-2013:p0433:b005:l019","ordinal":109889,"en":"The black, white-blazed thoroughbred"},{"id":"semetey-1-2013:p0433:b005:l020","ordinal":109890,"en":"I spurred on either side,"},{"id":"semetey-1-2013:p0433:b005:l021","ordinal":109891,"en":"Lashing left and right with my whip,"},{"id":"semetey-1-2013:p0433:b005:l022","ordinal":109892,"en":"Roaring in fury."},{"id":"semetey-1-2013:p0433:b005:l023","ordinal":109893,"en":"Before the Chinese host, the enemy people,"},{"id":"semetey-1-2013:p0433:b005:l024","ordinal":109894,"en":"Concealing that I was a woman,"},{"id":"semetey-1-2013:p0433:b005:l025","ordinal":109895,"en":"I shouted the battle cry like a man."},{"id":"semetey-1-2013:p0433:b005:l026","ordinal":109896,"en":"The black, white-blazed winged steed—"},{"id":"semetey-1-2013:p0433:b005:l027","ordinal":109897,"en":"I drew its bit and turned it."},{"id":"semetey-1-2013:p0433:b005:l028","ordinal":109898,"en":"My painted spear with steel blades"},{"id":"semetey-1-2013:p0433:b005:l029","ordinal":109899,"en":"I leveled at the enemy with a shout."},{"id":"semetey-1-2013:p0433:b005:l030","ordinal":109900,"en":"I, your unfortunate mother,"},{"id":"semetey-1-2013:p0433:b005:l031","ordinal":109901,"en":"The black, white-blazed thoroughbred"},{"id":"semetey-1-2013:p0433:b005:l032","ordinal":109902,"en":"Pressed with my right knee."},{"id":"semetey-1-2013:p0433:b005:l033","ordinal":109903,"en":"At great Makil of the Black Chinese"},{"id":"semetey-1-2013:p0433:b005:l034","ordinal":109904,"en":"I then launched my attack."},{"id":"semetey-1-2013:p0433:b005:l035","ordinal":109905,"en":"The forty guards beside him—"},{"id":"semetey-1-2013:p0433:b005:l036","ordinal":109906,"en":"I brought all forty from their horses,"},{"id":"semetey-1-2013:p0433:b005:l037","ordinal":109907,"en":"Spearing them as I passed along the line."},{"id":"semetey-1-2013:p0433:b005:l038","ordinal":109908,"en":"Makil upon his great rhinoceros—"},{"id":"semetey-1-2013:p0433:b005:l039","ordinal":109909,"en":"I reached him from the flank,"},{"id":"semetey-1-2013:p0434:b003:l001","ordinal":109910,"en":"As soon as I reached Makil,"},{"id":"semetey-1-2013:p0434:b003:l002","ordinal":109911,"en":"The unbeliever upon the great rhinoceros,"},{"id":"semetey-1-2013:p0434:b003:l003","ordinal":109912,"en":"That hero as huge as a mountain—"},{"id":"semetey-1-2013:p0434:b003:l004","ordinal":109913,"en":"'At this edge of the broad belt,' I thought,"},{"id":"semetey-1-2013:p0434:b003:l005","ordinal":109914,"en":"'Opposite the lungs,' I thought."},{"id":"semetey-1-2013:p0434:b003:l006","ordinal":109915,"en":"My back bent over behind,"},{"id":"semetey-1-2013:p0434:b003:l007","ordinal":109916,"en":"My rib bones jutting out,"},{"id":"semetey-1-2013:p0434:b003:l008","ordinal":109917,"en":"Crying aloud and beating myself,"},{"id":"semetey-1-2013:p0434:b003:l009","ordinal":109918,"en":"Pleading with the true God,"},{"id":"semetey-1-2013:p0434:b003:l010","ordinal":109919,"en":"I reached that Makil."},{"id":"semetey-1-2013:p0434:b003:l011","ordinal":109920,"en":"The wrestler riding the rhinoceros"},{"id":"semetey-1-2013:p0434:b003:l012","ordinal":109921,"en":"Stretching out, I struck as I passed."},{"id":"semetey-1-2013:p0434:b003:l013","ordinal":109922,"en":"My spear broke into fragments,"},{"id":"semetey-1-2013:p0434:b003:l014","ordinal":109923,"en":"And from the great rhinoceros,"},{"id":"semetey-1-2013:p0434:b003:l015","ordinal":109924,"en":"That Makil, huge as Mount Opol,"},{"id":"semetey-1-2013:p0434:b003:l016","ordinal":109925,"en":"Fell, tumbling down."},{"id":"semetey-1-2013:p0434:b003:l017","ordinal":109926,"en":"A woman by name, wretched me,"},{"id":"semetey-1-2013:p0434:b003:l018","ordinal":109927,"en":"My strength was utterly spent."},{"id":"semetey-1-2013:p0434:b003:l019","ordinal":109928,"en":"I slipped backward from my saddle."},{"id":"semetey-1-2013:p0434:b003:l020","ordinal":109929,"en":"The thoroughbred's white reins"},{"id":"semetey-1-2013:p0434:b003:l021","ordinal":109930,"en":"I could not grasp in both hands."},{"id":"semetey-1-2013:p0434:b003:l022","ordinal":109931,"en":"Into the steel-tread stirrup"},{"id":"semetey-1-2013:p0434:b003:l023","ordinal":109932,"en":"I could not guide my foot."},{"id":"semetey-1-2013:p0434:b003:l024","ordinal":109933,"en":"My blood drained away, my insides burned."},{"id":"semetey-1-2013:p0434:b003:l025","ordinal":109934,"en":"Sometimes I could come to my senses,"},{"id":"semetey-1-2013:p0434:b003:l026","ordinal":109935,"en":"Sometimes I could not."},{"id":"semetey-1-2013:p0434:b003:l027","ordinal":109936,"en":"Your mother stood reeling."},{"id":"semetey-1-2013:p0434:b003:l028","ordinal":109937,"en":"Orokkyr, khan of the unbelievers,"},{"id":"semetey-1-2013:p0434:b003:l029","ordinal":109938,"en":"Charged in fury,"},{"id":"semetey-1-2013:p0434:b003:l030","ordinal":109939,"en":"Attacking at my flank."},{"id":"semetey-1-2013:p0434:b003:l031","ordinal":109940,"en":"He made one great charge,"},{"id":"semetey-1-2013:p0434:b003:l032","ordinal":109941,"en":"Taking his great spear in hand,"},{"id":"semetey-1-2013:p0434:b003:l033","ordinal":109942,"en":"Roaring in fury,"},{"id":"semetey-1-2013:p0434:b003:l034","ordinal":109943,"en":"His rage frightening souls away."},{"id":"semetey-1-2013:p0434:b003:l035","ordinal":109944,"en":"Your mother's whole body shuddered."},{"id":"semetey-1-2013:p0434:b003:l036","ordinal":109945,"en":"He came to seize me;"},{"id":"semetey-1-2013:p0434:b003:l037","ordinal":109946,"en":"That cursed old man was about to reach me,"},{"id":"semetey-1-2013:p0434:b003:l038","ordinal":109947,"en":"To slaughter me as a sacrifice,"},{"id":"semetey-1-2013:p0434:b003:l039","ordinal":109948,"en":"Me, your mother Kanykey,"},{"id":"semetey-1-2013:p0434:b004:l001","ordinal":109949,"en":"To take my wretched head."},{"id":"semetey-1-2013:p0434:b004:l002","ordinal":109950,"en":"Orokkyr, khan of the Shibe,"},{"id":"semetey-1-2013:p0434:b004:l003","ordinal":109951,"en":"Drew near, roaring."},{"id":"semetey-1-2013:p0434:b004:l005","ordinal":109952,"en":"Khan Manas, now gone to the other world,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0434:b004:l006","ordinal":109953,"en":"With whom I united when tiny as a louse,"},{"id":"semetey-1-2013:p0434:b004:l007","ordinal":109954,"en":"With whom I joined when small as a thumb,"},{"id":"semetey-1-2013:p0434:b004:l008","ordinal":109955,"en":"Said, 'This woman built like a hero,"},{"id":"semetey-1-2013:p0434:b004:l009","ordinal":109956,"en":"The valiant woman Kanykey,"},{"id":"semetey-1-2013:p0434:b004:l010","ordinal":109957,"en":"They will slaughter as a sacrifice."},{"id":"semetey-1-2013:p0434:b004:l011","ordinal":109958,"en":"These Chinese, my poor one,"},{"id":"semetey-1-2013:p0434:b004:l012","ordinal":109959,"en":"Will kill her for nothing.'"},{"id":"semetey-1-2013:p0434:b004:l013","ordinal":109960,"en":"He struck Akkula upon the thigh,"},{"id":"semetey-1-2013:p0434:b004:l014","ordinal":109961,"en":"Took his painted spear in hand,"},{"id":"semetey-1-2013:p0434:b004:l015","ordinal":109962,"en":"Roared, crying 'Muslim!'"},{"id":"semetey-1-2013:p0434:b004:l016","ordinal":109963,"en":"And shouted the battle cry 'Ystan!'"},{"id":"semetey-1-2013:p0434:b004:l017","ordinal":109964,"en":"Before an eye could open and close,"},{"id":"semetey-1-2013:p0434:b004:l018","ordinal":109965,"en":"Before one could say this or that,"},{"id":"semetey-1-2013:p0434:b004:l019","ordinal":109966,"en":"Your leopard father Manas"},{"id":"semetey-1-2013:p0434:b004:l020","ordinal":109967,"en":"Reached Orokkyr."},{"id":"semetey-1-2013:p0434:b004:l021","ordinal":109968,"en":"The mighty Orokkyr,"},{"id":"semetey-1-2013:p0434:b004:l022","ordinal":109969,"en":"From atop his great mule,"},{"id":"semetey-1-2013:p0434:b004:l023","ordinal":109970,"en":"He knocked down and passed on."},{"id":"semetey-1-2013:p0434:b004:l024","ordinal":109971,"en":"Unable to survive a single spear thrust,"},{"id":"semetey-1-2013:p0434:b004:l025","ordinal":109972,"en":"Once your leopard father's hand had struck him,"},{"id":"semetey-1-2013:p0434:b004:l026","ordinal":109973,"en":"The renowned warrior Orokkyr"},{"id":"semetey-1-2013:p0434:b004:l027","ordinal":109974,"en":"Went off to hell."},{"id":"semetey-1-2013:p0434:b004:l028","ordinal":109975,"en":"Taking Zulpukor in hand,"},{"id":"semetey-1-2013:p0434:b004:l029","ordinal":109976,"en":"Beginning with Makil and Doodur,"},{"id":"semetey-1-2013:p0434:b004:l030","ordinal":109977,"en":"He cut off the heads of seven."},{"id":"semetey-1-2013:p0434:b004:l031","ordinal":109978,"en":"That Makil and Orokkyr,"},{"id":"semetey-1-2013:p0434:b004:l032","ordinal":109979,"en":"His two giants, were dead,"},{"id":"semetey-1-2013:p0434:b004:l033","ordinal":109980,"en":"The formidable warrior Kongurbay"},{"id":"semetey-1-2013:p0434:b004:l034","ordinal":109981,"en":"Saw as he stood apart."},{"id":"semetey-1-2013:p0434:b004:l035","ordinal":109982,"en":"He drew his bow, raining arrows,"},{"id":"semetey-1-2013:p0434:b004:l036","ordinal":109983,"en":"And fired bullets like hail."},{"id":"semetey-1-2013:p0434:b004:l037","ordinal":109984,"en":"Gathering courage, he roared,"},{"id":"semetey-1-2013:p0434:b004:l038","ordinal":109985,"en":"Stood defiant and shouted his battle cry,"},{"id":"semetey-1-2013:p0434:b004:l039","ordinal":109986,"en":"His battle cry was 'Kakay!'"},{"id":"semetey-1-2013:p0435:b003:l001","ordinal":109987,"en":"The massed Chinese and countless Manchus—"},{"id":"semetey-1-2013:p0435:b003:l002","ordinal":109988,"en":"Did they not swarm upon him!"},{"id":"semetey-1-2013:p0435:b003:l003","ordinal":109989,"en":"After suffering the torment of loneliness,"},{"id":"semetey-1-2013:p0435:b003:l004","ordinal":109990,"en":"Khan Bakay's lion"},{"id":"semetey-1-2013:p0435:b003:l005","ordinal":109991,"en":"Came back to his mind."},{"id":"semetey-1-2013:p0435:b003:l006","ordinal":109992,"en":"Toward the saddle-shaped pass"},{"id":"semetey-1-2013:p0435:b003:l007","ordinal":109993,"en":"Your hero father turned Akkula's head."},{"id":"semetey-1-2013:p0435:b003:l008","ordinal":109994,"en":"The forty outstanding, mighty companions,"},{"id":"semetey-1-2013:p0435:b003:l009","ordinal":109995,"en":"And Chubak, your father lamented:"},{"id":"semetey-1-2013:p0435:b003:l011","ordinal":109996,"en":"There is no hero to give me courage.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0435:b003:l012","ordinal":109997,"en":"I can only turn in anguish to God."},{"id":"semetey-1-2013:p0435:b003:l013","ordinal":109998,"en":"My blood-stained Bakay and Chubak are absent;"},{"id":"semetey-1-2013:p0435:b003:l014","ordinal":109999,"en":"Lion Almambet and Syrgak are absent."},{"id":"semetey-1-2013:p0435:b003:l015","ordinal":110000,"en":"Seen today, gone tomorrow—"},{"id":"semetey-1-2013:p0435:b003:l016","ordinal":110001,"en":"This day seemed a mere handspan."},{"id":"semetey-1-2013:p0435:b003:l017","ordinal":110002,"en":"Was this your nature, filthy world?!"},{"id":"semetey-1-2013:p0435:b003:l018","ordinal":110003,"en":"When my belly grew hungry,"},{"id":"semetey-1-2013:p0435:b003:l019","ordinal":110004,"en":"I would cut and eat horse-rump meat."},{"id":"semetey-1-2013:p0435:b003:l020","ordinal":110005,"en":"If Chubak were beside me,"},{"id":"semetey-1-2013:p0435:b003:l021","ordinal":110006,"en":"I would say, 'I shall rout the governor.'"},{"id":"semetey-1-2013:p0435:b003:l022","ordinal":110007,"en":"When my stomach grew hungry,"},{"id":"semetey-1-2013:p0435:b003:l023","ordinal":110008,"en":"I would cut and eat horse-belly fat."},{"id":"semetey-1-2013:p0435:b003:l024","ordinal":110009,"en":"While my dear Almam was there,"},{"id":"semetey-1-2013:p0435:b003:l025","ordinal":110010,"en":"I would say, 'I shall slaughter the Kalmyks.'"},{"id":"semetey-1-2013:p0435:b003:l026","ordinal":110011,"en":"With red-steel Zulpukor"},{"id":"semetey-1-2013:p0435:b003:l027","ordinal":110012,"en":"I would say, 'I shall fight.'"},{"id":"semetey-1-2013:p0435:b003:l028","ordinal":110013,"en":"While Kyzyr-blessed Bakay was there,"},{"id":"semetey-1-2013:p0435:b003:l029","ordinal":110014,"en":"With the eighteen thousand worlds"},{"id":"semetey-1-2013:p0435:b003:l030","ordinal":110015,"en":"I, wretched soul, said I would grapple!"},{"id":"semetey-1-2013:p0435:b003:l032","ordinal":110016,"en":"My distress has become beyond compare."},{"id":"semetey-1-2013:p0435:b003:l033","ordinal":110017,"en":"Ah, may loneliness perish!"},{"id":"semetey-1-2013:p0435:b003:l034","ordinal":110018,"en":"My wife has become my support."},{"id":"semetey-1-2013:p0435:b003:l035","ordinal":110019,"en":"That leopard Syrgak is not here!"},{"id":"semetey-1-2013:p0435:b003:l036","ordinal":110020,"en":"The finest of sixty,"},{"id":"semetey-1-2013:p0435:b003:l037","ordinal":110021,"en":"The strongest of forty companions,"},{"id":"semetey-1-2013:p0435:b003:l038","ordinal":110022,"en":"Light upon a horse, fit for a colt,"},{"id":"semetey-1-2013:p0435:b003:l039","ordinal":110023,"en":"Sleeping little, watchful on the road,"},{"id":"semetey-1-2013:p0435:b005:l001","ordinal":110024,"en":"My black-capped support,"},{"id":"semetey-1-2013:p0435:b005:l002","ordinal":110025,"en":"Where has he gone and vanished,"},{"id":"semetey-1-2013:p0435:b005:l003","ordinal":110026,"en":"My dear, beloved Syrgak?"},{"id":"semetey-1-2013:p0435:b005:l004","ordinal":110027,"en":"My Chubak went away offended;"},{"id":"semetey-1-2013:p0435:b005:l005","ordinal":110028,"en":"That was when my backbone broke."},{"id":"semetey-1-2013:p0435:b005:l006","ordinal":110029,"en":"Saying, 'He treated Chubak like this,'"},{"id":"semetey-1-2013:p0435:b005:l007","ordinal":110030,"en":"My friend to the next world, Almambet,"},{"id":"semetey-1-2013:p0435:b005:l008","ordinal":110031,"en":"Looked on askance."},{"id":"semetey-1-2013:p0435:b005:l009","ordinal":110032,"en":"Hero Bakay, that excellent elder,"},{"id":"semetey-1-2013:p0435:b005:l010","ordinal":110033,"en":"My dear friend until Judgment Day,"},{"id":"semetey-1-2013:p0435:b005:l011","ordinal":110034,"en":"Said, 'He maligned his serving warrior;"},{"id":"semetey-1-2013:p0435:b005:l012","ordinal":110035,"en":"His conduct was bad.'"},{"id":"semetey-1-2013:p0435:b005:l013","ordinal":110036,"en":"Bakay's heart grew indifferent."},{"id":"semetey-1-2013:p0435:b005:l014","ordinal":110037,"en":"Ajybay, son of Argyn Khan,"},{"id":"semetey-1-2013:p0435:b005:l015","ordinal":110038,"en":"Was a friend to the next world."},{"id":"semetey-1-2013:p0435:b005:l016","ordinal":110039,"en":"'Manas believed gossip;"},{"id":"semetey-1-2013:p0435:b005:l017","ordinal":110040,"en":"May this world crush him!"},{"id":"semetey-1-2013:p0435:b005:l018","ordinal":110041,"en":"Such is what Manas has become,' he said."},{"id":"semetey-1-2013:p0435:b005:l019","ordinal":110042,"en":"Ill will showed in his eyes,"},{"id":"semetey-1-2013:p0435:b005:l020","ordinal":110043,"en":"And his words took a crooked course."},{"id":"semetey-1-2013:p0435:b005:l021","ordinal":110044,"en":"'Manas believed his old man;"},{"id":"semetey-1-2013:p0435:b005:l022","ordinal":110045,"en":"The fierce hero turned obstinate,' they said."},{"id":"semetey-1-2013:p0435:b005:l023","ordinal":110046,"en":"If they could, the forty companions"},{"id":"semetey-1-2013:p0435:b005:l024","ordinal":110047,"en":"Would have struck me down.'"},{"id":"semetey-1-2013:p0435:b005:l025","ordinal":110048,"en":"Saying this in anger,"},{"id":"semetey-1-2013:p0435:b005:l026","ordinal":110049,"en":"In sorrow he gathered troops."},{"id":"semetey-1-2013:p0435:b005:l027","ordinal":110050,"en":"Your hero father mourned his forty companions,"},{"id":"semetey-1-2013:p0435:b005:l028","ordinal":110051,"en":"And muttered in distress."},{"id":"semetey-1-2013:p0435:b005:l029","ordinal":110052,"en":"Your hero father's wits"},{"id":"semetey-1-2013:p0435:b005:l030","ordinal":110053,"en":"Were thrown into confusion."},{"id":"semetey-1-2013:p0435:b005:l031","ordinal":110054,"en":"His protecting spirit"},{"id":"semetey-1-2013:p0435:b005:l032","ordinal":110055,"en":"Had fled from his body."},{"id":"semetey-1-2013:p0435:b005:l033","ordinal":110056,"en":"His forty companions were not beside him."},{"id":"semetey-1-2013:p0435:b005:l034","ordinal":110057,"en":"His wretched life was pressed hard;"},{"id":"semetey-1-2013:p0435:b005:l035","ordinal":110058,"en":"Your father, gone to Judgment,"},{"id":"semetey-1-2013:p0435:b005:l036","ordinal":110059,"en":"Was thrown into confusion."},{"id":"semetey-1-2013:p0435:b005:l037","ordinal":110060,"en":"While things stood thus,"},{"id":"semetey-1-2013:p0435:b005:l038","ordinal":110061,"en":"What you had prayed for, the one God"},{"id":"semetey-1-2013:p0435:b005:l039","ordinal":110062,"en":"Had at that time granted."},{"id":"semetey-1-2013:p0436:b003:l001","ordinal":110063,"en":"Wild shouts and shrill cheers—"},{"id":"semetey-1-2013:p0436:b003:l002","ordinal":110064,"en":"That Chubak, son of Akbaltay,"},{"id":"semetey-1-2013:p0436:b003:l003","ordinal":110065,"en":"Had crossed down into Talas"},{"id":"semetey-1-2013:p0436:b003:l004","ordinal":110066,"en":"And arrived at that moment."},{"id":"semetey-1-2013:p0436:b003:l005","ordinal":110067,"en":"To be your father's companion,"},{"id":"semetey-1-2013:p0436:b003:l006","ordinal":110068,"en":"The tiger, the fierce-maned lion,"},{"id":"semetey-1-2013:p0436:b003:l007","ordinal":110069,"en":"Upon a horse such as Kokala,"},{"id":"semetey-1-2013:p0436:b003:l008","ordinal":110070,"en":"Came trotting along."},{"id":"semetey-1-2013:p0436:b003:l009","ordinal":110071,"en":"A roar came from ahead;"},{"id":"semetey-1-2013:p0436:b003:l010","ordinal":110072,"en":"It was that familiar voice of Chubak,"},{"id":"semetey-1-2013:p0436:b003:l011","ordinal":110073,"en":"Shouting 'Manas!' as his battle cry."},{"id":"semetey-1-2013:p0436:b003:l012","ordinal":110074,"en":"Girding his waist firmly,"},{"id":"semetey-1-2013:p0436:b003:l013","ordinal":110075,"en":"Into seven vast hosts of Chinese"},{"id":"semetey-1-2013:p0436:b003:l014","ordinal":110076,"en":"Your Chubak went alone,"},{"id":"semetey-1-2013:p0436:b003:l015","ordinal":110077,"en":"Attacking the instant he reached them."},{"id":"semetey-1-2013:p0436:b003:l016","ordinal":110078,"en":"When he heard Chubak's voice,"},{"id":"semetey-1-2013:p0436:b003:l017","ordinal":110079,"en":"Wearing a blue-lynx fur cap,"},{"id":"semetey-1-2013:p0436:b003:l018","ordinal":110080,"en":"Flourishing a blue-mottled shield,"}]
