[{"id":"manas-2010:p0198:b002:l013","ordinal":8705,"en":"The rosy, beautiful girls,"},{"id":"manas-2010:p0198:b002:l014","ordinal":8706,"en":"As tribute to the Chinese,"},{"id":"manas-2010:p0198:b002:l015","ordinal":8707,"en":"Let us give them those girls."},{"id":"manas-2010:p0198:b002:l016","ordinal":8708,"en":"Let us preserve our lives."},{"id":"manas-2010:p0198:b002:l017","ordinal":8709,"en":"We were a people left in torment."},{"id":"manas-2010:p0198:b002:l018","ordinal":8710,"en":"We were not living, my little foal;"},{"id":"manas-2010:p0198:b002:l019","ordinal":8711,"en":"We were a people already slaughtered.”"},{"id":"manas-2010:p0198:b002:l020","ordinal":8712,"en":"When Jakyp said this,"},{"id":"manas-2010:p0198:b002:l021","ordinal":8713,"en":"As though pierced in a gland,"},{"id":"manas-2010:p0198:b002:l022","ordinal":8714,"en":"Warrior Manas sprang up:"},{"id":"manas-2010:p0198:b002:l023","ordinal":8715,"en":"“Alas, father, what are you saying?!"},{"id":"manas-2010:p0198:b002:l024","ordinal":8716,"en":"May I never prosper if I fear death!"},{"id":"manas-2010:p0198:b002:l025","ordinal":8717,"en":"If I fear my doom, father,"},{"id":"manas-2010:p0198:b002:l026","ordinal":8718,"en":"May I sink away before being born!"},{"id":"manas-2010:p0198:b002:l027","ordinal":8719,"en":"The infidels in Altay,"},{"id":"manas-2010:p0198:b002:l028","ordinal":8720,"en":"The infidel wrestlers who would grapple,"},{"id":"manas-2010:p0198:b002:l029","ordinal":8721,"en":"Alas, father, what are you saying?"},{"id":"manas-2010:p0198:b002:l030","ordinal":8722,"en":"Give me Toruchaar to ride."},{"id":"manas-2010:p0198:b002:l031","ordinal":8723,"en":"Shouting ‘I trust my fate!’"},{"id":"manas-2010:p0198:b002:l032","ordinal":8724,"en":"Today raising the battle cry ‘Ystan!’"},{"id":"manas-2010:p0198:b002:l033","ordinal":8725,"en":"The seething infidels,"},{"id":"manas-2010:p0198:b002:l034","ordinal":8726,"en":"Let me drive them as far as the kakan."},{"id":"manas-2010:p0198:b002:l035","ordinal":8727,"en":"The wrestlers who came from Beijing,"},{"id":"manas-2010:p0198:b002:l036","ordinal":8728,"en":"Let me drive them into Bakburchun."},{"id":"manas-2010:p0198:b002:l037","ordinal":8729,"en":"Living on without dying,"},{"id":"manas-2010:p0198:b002:l038","ordinal":8730,"en":"What legacy would I attain?"},{"id":"manas-2010:p0198:b002:l039","ordinal":8731,"en":"For the Kyrgyz people of forty households,"},{"id":"manas-2010:p0198:b002:l040","ordinal":8732,"en":"Let me die as a sacrifice!"},{"id":"manas-2010:p0198:b002:l041","ordinal":8733,"en":"Against the tyrannical Black Chinese,"},{"id":"manas-2010:p0198:b002:l042","ordinal":8734,"en":"I shall wage fierce war."},{"id":"manas-2010:p0198:b002:l043","ordinal":8735,"en":"From the sprawling Black Kalmyks,"},{"id":"manas-2010:p0198:b002:l044","ordinal":8736,"en":"This year I shall wrest my equal rights."},{"id":"manas-2010:p0198:b002:l045","ordinal":8737,"en":"Alas, father, do not grieve."},{"id":"manas-2010:p0198:b002:l046","ordinal":8738,"en":"Thrusting spears, I shall break their ranks."},{"id":"manas-2010:p0198:b002:l047","ordinal":8739,"en":"If fate arrives, I shall fall to a shot."},{"id":"manas-2010:p0198:b002:l048","ordinal":8740,"en":"While my mighty head remains,"},{"id":"manas-2010:p0199:b002:l001","ordinal":8741,"en":"How could I surrender my village?"},{"id":"manas-2010:p0199:b002:l002","ordinal":8742,"en":"These Chinese have grown strong;"},{"id":"manas-2010:p0199:b002:l003","ordinal":8743,"en":"Let me try grappling with them!"},{"id":"manas-2010:p0199:b002:l004","ordinal":8744,"en":"The infidels who have swept upon us,"},{"id":"manas-2010:p0199:b002:l005","ordinal":8745,"en":"The heroes who would grapple,"},{"id":"manas-2010:p0199:b002:l006","ordinal":8746,"en":"The Manchus of Khangay,"},{"id":"manas-2010:p0199:b002:l007","ordinal":8747,"en":"Unless I drive them toward Beijing,"},{"id":"manas-2010:p0199:b002:l008","ordinal":8748,"en":"Let me die instead of living."},{"id":"manas-2010:p0199:b002:l009","ordinal":8749,"en":"These people of yours have grown strong;"},{"id":"manas-2010:p0199:b002:l010","ordinal":8750,"en":"Let me try clashing with them!"},{"id":"manas-2010:p0199:b002:l011","ordinal":8751,"en":"Without fighting and falling to a shot,"},{"id":"manas-2010:p0199:b002:l012","ordinal":8752,"en":"How could I surrender my san of cattle?”"},{"id":"manas-2010:p0199:b002:l013","ordinal":8753,"en":"Thus spoke warrior Manas:"},{"id":"manas-2010:p0199:b002:l014","ordinal":8754,"en":"“I shall gird my sturdy waist."},{"id":"manas-2010:p0199:b002:l015","ordinal":8755,"en":"The infidels who teem over the earth,"},{"id":"manas-2010:p0199:b002:l016","ordinal":8756,"en":"I shall charge and attack them alone.”"},{"id":"manas-2010:p0199:b002:l017","ordinal":8757,"en":"Thus spoke warrior Manas,"},{"id":"manas-2010:p0199:b002:l018","ordinal":8758,"en":"His eyes blazing like fire,"},{"id":"manas-2010:p0199:b002:l019","ordinal":8759,"en":"His blood thirst seizing him fiercely."},{"id":"manas-2010:p0199:b002:l020","ordinal":8760,"en":"He stepped apart in wrath,"},{"id":"manas-2010:p0199:b002:l021","ordinal":8761,"en":"His blood-drinking aspect showing."},{"id":"manas-2010:p0199:b002:l022","ordinal":8762,"en":"Then mighty Manas"},{"id":"manas-2010:p0199:b002:l023","ordinal":8763,"en":"Readied his weapons and armor."},{"id":"manas-2010:p0199:b002:l024","ordinal":8764,"en":"Arkesken, which would wreak slaughter,"},{"id":"manas-2010:p0199:b002:l025","ordinal":8765,"en":"He girded that sword beneath his clothes."},{"id":"manas-2010:p0199:b002:l026","ordinal":8766,"en":"He stepped apart in wrath,"},{"id":"manas-2010:p0199:b002:l027","ordinal":8767,"en":"His blood-drinking aspect showing."},{"id":"manas-2010:p0199:b002:l028","ordinal":8768,"en":"Raging like a lion,"},{"id":"manas-2010:p0199:b002:l029","ordinal":8769,"en":"Magnanimous Manas, surpassing lion,"},{"id":"manas-2010:p0199:b002:l030","ordinal":8770,"en":"Set out prepared for battle."},{"id":"manas-2010:p0199:b002:l031","ordinal":8771,"en":"Startled into action, he saddled his racing steed."},{"id":"manas-2010:p0199:b002:l032","ordinal":8772,"en":"Your warrior Manas, gray-maned lion,"},{"id":"manas-2010:p0199:b002:l033","ordinal":8773,"en":"Giving not a glance to his wretched life,"},{"id":"manas-2010:p0199:b002:l034","ordinal":8774,"en":"This was where he entered slaughter."},{"id":"manas-2010:p0199:b002:l035","ordinal":8775,"en":"His ancestral spirit mighty, his name great,"},{"id":"manas-2010:p0199:b002:l036","ordinal":8776,"en":"That is magnanimous Manas the lion."},{"id":"manas-2010:p0199:b002:l037","ordinal":8777,"en":"Against Döngö and Zholoy,"},{"id":"manas-2010:p0199:b002:l038","ordinal":8778,"en":"This was where he fought."},{"id":"manas-2010:p0199:b002:l039","ordinal":8779,"en":"The place where Manas became Manas,"},{"id":"manas-2010:p0199:b002:l040","ordinal":8780,"en":"The place where he won the name Manas,"},{"id":"manas-2010:p0199:b002:l041","ordinal":8781,"en":"The place where he mounted Toruchaar,"},{"id":"manas-2010:p0199:b002:l042","ordinal":8782,"en":"Against the surging Chinese and Kalmyks,"},{"id":"manas-2010:p0199:b002:l043","ordinal":8783,"en":"Girding his sturdy waist,"},{"id":"manas-2010:p0199:b002:l044","ordinal":8784,"en":"Against the Kalmyks teeming over the earth,"},{"id":"manas-2010:p0199:b002:l045","ordinal":8785,"en":"He charged and attacked alone."},{"id":"manas-2010:p0199:b002:l046","ordinal":8786,"en":"The horse he rode, Toruchaar,"},{"id":"manas-2010:p0199:b002:l047","ordinal":8787,"en":"With a tapering tail and solid hooves,"},{"id":"manas-2010:p0199:b002:l048","ordinal":8788,"en":"A karabayyr, a battle steed,"},{"id":"manas-2010:p0200:b002:l001","ordinal":8789,"en":"With sieve-like lungs and copper wings,"},{"id":"manas-2010:p0200:b002:l002","ordinal":8790,"en":"Trailing its banner-like tail,"},{"id":"manas-2010:p0200:b002:l003","ordinal":8791,"en":"Through six months' battle clamor,"},{"id":"manas-2010:p0200:b002:l004","ordinal":8792,"en":"It endured without flustering."},{"id":"manas-2010:p0200:b002:l005","ordinal":8793,"en":"If there were forty days of desert,"},{"id":"manas-2010:p0200:b002:l006","ordinal":8794,"en":"It sagged in weariness and fared ill."},{"id":"manas-2010:p0200:b002:l007","ordinal":8795,"en":"If it traveled a six-month journey,"},{"id":"manas-2010:p0200:b002:l008","ordinal":8796,"en":"It did not grow wasted and worn."},{"id":"manas-2010:p0200:b002:l009","ordinal":8797,"en":"Manas the leopard, bloodthirsty lion,"},{"id":"manas-2010:p0200:b002:l010","ordinal":8798,"en":"Surpassing wrestler, surpassing warrior,"},{"id":"manas-2010:p0200:b002:l011","ordinal":8799,"en":"His earliest forefather was Khan Tügöl,"},{"id":"manas-2010:p0200:b002:l012","ordinal":8800,"en":"Blessed by Kydyr from the root."},{"id":"manas-2010:p0200:b002:l013","ordinal":8801,"en":"None who faced him remained unharmed;"},{"id":"manas-2010:p0200:b002:l014","ordinal":8802,"en":"He spared none who stood against him."},{"id":"manas-2010:p0200:b002:l015","ordinal":8803,"en":"He gathered the scattered,"},{"id":"manas-2010:p0200:b002:l016","ordinal":8804,"en":"What he sought was faith."},{"id":"manas-2010:p0200:b002:l017","ordinal":8805,"en":"He was the leopard himself."},{"id":"manas-2010:p0200:b002:l018","ordinal":8806,"en":"Roaring in wrath,"},{"id":"manas-2010:p0200:b002:l019","ordinal":8807,"en":"Raising the battle cry “Manas!”"},{"id":"manas-2010:p0200:b002:l020","ordinal":8808,"en":"Warrior Manas entered the clash."},{"id":"manas-2010:p0200:b002:l021","ordinal":8809,"en":"When he reached twelve,"},{"id":"manas-2010:p0200:b002:l022","ordinal":8810,"en":"This was where he wrought slaughter."},{"id":"manas-2010:p0200:b002:l023","ordinal":8811,"en":"Making Toruchaar prance,"},{"id":"manas-2010:p0200:b002:l024","ordinal":8812,"en":"The throngs of Chinese and Manchus,"},{"id":"manas-2010:p0200:b002:l025","ordinal":8813,"en":"He sent them rolling and crawling."},{"id":"manas-2010:p0200:b002:l026","ordinal":8814,"en":"Stern and wrathful,"},{"id":"manas-2010:p0200:b002:l027","ordinal":8815,"en":"Against the seething Chinese,"},{"id":"manas-2010:p0200:b002:l028","ordinal":8816,"en":"Manas the leopard attacked."},{"id":"manas-2010:p0200:b002:l029","ordinal":8817,"en":"The black-bladed Zulpukor,"},{"id":"manas-2010:p0200:b002:l030","ordinal":8818,"en":"He seized and swung it."},{"id":"manas-2010:p0200:b002:l031","ordinal":8819,"en":"Whoever came before him,"},{"id":"manas-2010:p0200:b002:l032","ordinal":8820,"en":"Such were the bloodthirsty one's deeds,"},{"id":"manas-2010:p0200:b002:l033","ordinal":8821,"en":"He sent them scattering."},{"id":"manas-2010:p0200:b002:l034","ordinal":8822,"en":"The wrestlers farther away,"},{"id":"manas-2010:p0200:b002:l035","ordinal":8823,"en":"He felled them with his spear."},{"id":"manas-2010:p0200:b002:l036","ordinal":8824,"en":"Those who drew bridle to bridle,"},{"id":"manas-2010:p0200:b002:l037","ordinal":8825,"en":"He struck down with his battle-axe."},{"id":"manas-2010:p0200:b002:l038","ordinal":8826,"en":"Those who came on his right,"},{"id":"manas-2010:p0200:b002:l039","ordinal":8827,"en":"Ravaging Manas the leopard"},{"id":"manas-2010:p0200:b002:l040","ordinal":8828,"en":"Struck down with his sword."},{"id":"manas-2010:p0200:b002:l041","ordinal":8829,"en":"The looming Black Kalmyks'"},{"id":"manas-2010:p0200:b002:l042","ordinal":8830,"en":"Hair remained streaming."},{"id":"manas-2010:p0200:b002:l043","ordinal":8831,"en":"Many wrestlers as big as mountains"},{"id":"manas-2010:p0200:b002:l044","ordinal":8832,"en":"Lay dead and sprawling."},{"id":"manas-2010:p0200:b002:l045","ordinal":8833,"en":"Champions died, khans died;"},{"id":"manas-2010:p0200:b002:l046","ordinal":8834,"en":"At the hands of Sultan Manas the leopard,"},{"id":"manas-2010:p0200:b002:l047","ordinal":8835,"en":"All who fought him died."},{"id":"manas-2010:p0200:b002:l048","ordinal":8836,"en":"The jangju, not sparing his life,"},{"id":"manas-2010:p0201:b001:l001","ordinal":8837,"en":"Drew bows and rained arrows,"},{"id":"manas-2010:p0201:b001:l002","ordinal":8838,"en":"Fired shots like hail."},{"id":"manas-2010:p0201:b001:l003","ordinal":8839,"en":"Wrestlers swarmed in throngs,"},{"id":"manas-2010:p0201:b001:l004","ordinal":8840,"en":"Attacking from every side."},{"id":"manas-2010:p0201:b001:l005","ordinal":8841,"en":"Look at the ants, look at the insects;"},{"id":"manas-2010:p0201:b001:l006","ordinal":8842,"en":"Look at the Chinese people like insects."},{"id":"manas-2010:p0201:b001:l007","ordinal":8843,"en":"Look at the rain, look at the embers;"},{"id":"manas-2010:p0201:b001:l008","ordinal":8844,"en":"Look at the shots striking all together."},{"id":"manas-2010:p0201:b001:l009","ordinal":8845,"en":"Look at the reeds, look at the flood;"},{"id":"manas-2010:p0201:b001:l010","ordinal":8846,"en":"Raising the battle cry “Kakay!”"},{"id":"manas-2010:p0201:b001:l011","ordinal":8847,"en":"Look at the army sweeping on!"},{"id":"manas-2010:p0201:b001:l012","ordinal":8848,"en":"Spears swayed like reeds,"},{"id":"manas-2010:p0201:b001:l013","ordinal":8849,"en":"Swords and guns glittered,"},{"id":"manas-2010:p0201:b001:l014","ordinal":8850,"en":"Shots from ochogor guns rang out,"},{"id":"manas-2010:p0201:b001:l015","ordinal":8851,"en":"Bow arrows poured down together."},{"id":"manas-2010:p0201:b001:l016","ordinal":8852,"en":"Look at the embers of a burning tower;"},{"id":"manas-2010:p0201:b001:l017","ordinal":8853,"en":"Look at the shots striking without pause."},{"id":"manas-2010:p0201:b001:l018","ordinal":8854,"en":"Look at the deep pit that was dug;"},{"id":"manas-2010:p0201:b001:l019","ordinal":8855,"en":"Clamoring, sweeping on and shrieking,"},{"id":"manas-2010:p0201:b001:l020","ordinal":8856,"en":"Look at the army sweeping on!"},{"id":"manas-2010:p0201:b001:l021","ordinal":8857,"en":"Gray-horse riders on the flanks,"},{"id":"manas-2010:p0201:b001:l022","ordinal":8858,"en":"Capable Döngö at the front,"},{"id":"manas-2010:p0201:b001:l023","ordinal":8859,"en":"Clattering and clamoring,"},{"id":"manas-2010:p0201:b001:l024","ordinal":8860,"en":"The swordsmen made ready,"},{"id":"manas-2010:p0201:b001:l025","ordinal":8861,"en":"The axe-bearers prepared."},{"id":"manas-2010:p0201:b001:l026","ordinal":8862,"en":"Those whose swords were very pointed,"},{"id":"manas-2010:p0201:b001:l027","ordinal":8863,"en":"Those whose spears were surpassingly sharp,"},{"id":"manas-2010:p0201:b001:l028","ordinal":8864,"en":"Their lasso-throwing wrestlers,"},{"id":"manas-2010:p0201:b001:l029","ordinal":8865,"en":"Their men of many kinds,"},{"id":"manas-2010:p0201:b001:l030","ordinal":8866,"en":"Their peoples like ants,"},{"id":"manas-2010:p0201:b001:l031","ordinal":8867,"en":"Their giants of every kind,"},{"id":"manas-2010:p0201:b001:l032","ordinal":8868,"en":"Those bearing nets of iron rope"},{"id":"manas-2010:p0201:b001:l033","ordinal":8869,"en":"Swept on and made war."},{"id":"manas-2010:p0201:b001:l034","ordinal":8870,"en":"Those with iron-dagger arms"},{"id":"manas-2010:p0201:b001:l035","ordinal":8871,"en":"Swept on and fought all together."},{"id":"manas-2010:p0201:b001:l036","ordinal":8872,"en":"Their warriors, their khans,"},{"id":"manas-2010:p0201:b001:l037","ordinal":8873,"en":"Their men of many kinds,"},{"id":"manas-2010:p0201:b001:l038","ordinal":8874,"en":"Firing upon warrior Manas,"},{"id":"manas-2010:p0201:b001:l039","ordinal":8875,"en":"Swept upon him all together."},{"id":"manas-2010:p0201:b001:l040","ordinal":8876,"en":"Their strong men in short coats,"},{"id":"manas-2010:p0201:b001:l041","ordinal":8877,"en":"Their finest officials with rank buttons on their caps,"},{"id":"manas-2010:p0201:b001:l042","ordinal":8878,"en":"Vulture-tailed giant Zhoon,"},{"id":"manas-2010:p0201:b001:l043","ordinal":8879,"en":"Scissor-eared giant Kaman,"},{"id":"manas-2010:p0201:b001:l044","ordinal":8880,"en":"Charged and made war."},{"id":"manas-2010:p0201:b001:l045","ordinal":8881,"en":"The adept, gray-maned Manas,"},{"id":"manas-2010:p0201:b001:l046","ordinal":8882,"en":"They took him into their midst."},{"id":"manas-2010:p0201:b001:l047","ordinal":8883,"en":"Gray haze, burning dust,"},{"id":"manas-2010:p0201:b001:l048","ordinal":8884,"en":"Humming unconcernedly,"},{"id":"manas-2010:p0202:b001:l001","ordinal":8885,"en":"Khan Manas stood firm."},{"id":"manas-2010:p0202:b001:l002","ordinal":8886,"en":"He did not trouble himself with “I shall die.”"},{"id":"manas-2010:p0202:b001:l003","ordinal":8887,"en":"When only giants swept upon him,"},{"id":"manas-2010:p0202:b001:l004","ordinal":8888,"en":"He valued them less than his trouser cuff."},{"id":"manas-2010:p0202:b001:l005","ordinal":8889,"en":"Looking, the eye could not catch him."},{"id":"manas-2010:p0202:b001:l006","ordinal":8890,"en":"Like flying tumbleweed,"},{"id":"manas-2010:p0202:b001:l007","ordinal":8891,"en":"One could not tell where he was."},{"id":"manas-2010:p0202:b001:l008","ordinal":8892,"en":"Red spear, burning fire,"},{"id":"manas-2010:p0202:b001:l009","ordinal":8893,"en":"Khan Manas drove them hard."},{"id":"manas-2010:p0202:b001:l010","ordinal":8894,"en":"Wreaking slaughter upon the Chinese,"},{"id":"manas-2010:p0202:b001:l011","ordinal":8895,"en":"Giving no backward glance at battle,"},{"id":"manas-2010:p0202:b001:l012","ordinal":8896,"en":"Khan Manas endured."},{"id":"manas-2010:p0202:b001:l013","ordinal":8897,"en":"When he bent, he speared a warrior."},{"id":"manas-2010:p0202:b001:l014","ordinal":8898,"en":"The boundlessly bloodthirsty lion Manas"},{"id":"manas-2010:p0202:b001:l015","ordinal":8899,"en":"Speared seven in a row with one thrust."},{"id":"manas-2010:p0202:b001:l016","ordinal":8900,"en":"Galloping on Toruchaar,"},{"id":"manas-2010:p0202:b001:l017","ordinal":8901,"en":"When he met the Kalmyks,"},{"id":"manas-2010:p0202:b001:l018","ordinal":8902,"en":"He speared and felled their monks."},{"id":"manas-2010:p0202:b001:l019","ordinal":8903,"en":"When he climbed a slope, he speared warriors;"},{"id":"manas-2010:p0202:b001:l020","ordinal":8904,"en":"Know from this that he was a lion:"},{"id":"manas-2010:p0202:b001:l021","ordinal":8905,"en":"He speared twelve with one thrust."},{"id":"manas-2010:p0202:b001:l022","ordinal":8906,"en":"When he thrust his spear head-on,"},{"id":"manas-2010:p0202:b001:l023","ordinal":8907,"en":"No mortal could stand against him."},{"id":"manas-2010:p0202:b001:l024","ordinal":8908,"en":"When he charged and drew his sword,"},{"id":"manas-2010:p0202:b001:l025","ordinal":8909,"en":"No Kalmyk could stand against him."},{"id":"manas-2010:p0202:b001:l026","ordinal":8910,"en":"When he thrust his spear head-on,"},{"id":"manas-2010:p0202:b001:l027","ordinal":8911,"en":"Dust stretched out trailing."},{"id":"manas-2010:p0202:b001:l028","ordinal":8912,"en":"The Black Chinese as big as camels"},{"id":"manas-2010:p0202:b001:l029","ordinal":8913,"en":"Fell sprawling."},{"id":"manas-2010:p0202:b001:l030","ordinal":8914,"en":"Looking at his front,"},{"id":"manas-2010:p0202:b001:l031","ordinal":8915,"en":"The bloodthirsty one of surpassing fortune"},{"id":"manas-2010:p0202:b001:l032","ordinal":8916,"en":"Had the form of six thousand warriors."},{"id":"manas-2010:p0202:b001:l033","ordinal":8917,"en":"When the hero turned his back,"},{"id":"manas-2010:p0202:b001:l034","ordinal":8918,"en":"He had the terror of a dragon."},{"id":"manas-2010:p0202:b001:l035","ordinal":8919,"en":"When he faced them, the Chinese parted."},{"id":"manas-2010:p0202:b001:l036","ordinal":8920,"en":"The bloodthirsty one of surpassing fortune"},{"id":"manas-2010:p0202:b001:l037","ordinal":8921,"en":"Appeared like a lion."},{"id":"manas-2010:p0202:b001:l038","ordinal":8922,"en":"At one glance, a thousand men;"},{"id":"manas-2010:p0202:b001:l039","ordinal":8923,"en":"At another glance, my hero"},{"id":"manas-2010:p0202:b001:l040","ordinal":8924,"en":"Was a san of men teeming over the earth."},{"id":"manas-2010:p0202:b001:l041","ordinal":8925,"en":"Such was Manas's appearance:"},{"id":"manas-2010:p0202:b001:l042","ordinal":8926,"en":"The youngest of six lions,"},{"id":"manas-2010:p0202:b001:l043","ordinal":8927,"en":"Magnanimous Manas, lion and hero,"},{"id":"manas-2010:p0202:b001:l044","ordinal":8928,"en":"God's beloved servant."},{"id":"manas-2010:p0202:b001:l045","ordinal":8929,"en":"His fortune was complete."},{"id":"manas-2010:p0202:b001:l046","ordinal":8930,"en":"Right there in Altay,"},{"id":"manas-2010:p0202:b001:l047","ordinal":8931,"en":"When he reached twelve,"},{"id":"manas-2010:p0202:b001:l048","ordinal":8932,"en":"Intrepid Manas the leopard,"},{"id":"manas-2010:p0203:b001:l001","ordinal":8933,"en":"This was where he wrought slaughter."},{"id":"manas-2010:p0203:b001:l002","ordinal":8934,"en":"“He is a bloodthirsty Burut!” they said."},{"id":"manas-2010:p0203:b001:l003","ordinal":8935,"en":"The kalday saw and grieved."},{"id":"manas-2010:p0203:b001:l004","ordinal":8936,"en":"That Manas was a lion,"},{"id":"manas-2010:p0203:b001:l005","ordinal":8937,"en":"In the seething Chinese people's"},{"id":"manas-2010:p0203:b001:l006","ordinal":8938,"en":"Record of renown it was inscribed."},{"id":"manas-2010:p0203:b001:l007","ordinal":8939,"en":"Their strong men wearing short coats,"},{"id":"manas-2010:p0203:b001:l008","ordinal":8940,"en":"When the lion entered among them,"},{"id":"manas-2010:p0203:b001:l009","ordinal":8941,"en":"Tumbled from their horses, one by one."},{"id":"manas-2010:p0203:b001:l010","ordinal":8942,"en":"Their sturdier wrestlers"},{"id":"manas-2010:p0203:b001:l011","ordinal":8943,"en":"Truly despaired of their lives."},{"id":"manas-2010:p0203:b001:l012","ordinal":8944,"en":"His armed companions numbered eighty-four."},{"id":"manas-2010:p0203:b001:l013","ordinal":8945,"en":"The fucking bloodthirsty one,"},{"id":"manas-2010:p0203:b001:l014","ordinal":8946,"en":"Wherever he swept was red fire."},{"id":"manas-2010:p0203:b001:l015","ordinal":8947,"en":"Striking those farther away, cutting them down,"},{"id":"manas-2010:p0203:b001:l016","ordinal":8948,"en":"The seething Chinese,"},{"id":"manas-2010:p0203:b001:l017","ordinal":8949,"en":"The gray-maned hero drove into submission."},{"id":"manas-2010:p0203:b001:l018","ordinal":8950,"en":"When the gray-maned hero faced them,"},{"id":"manas-2010:p0203:b001:l019","ordinal":8951,"en":"The wrestlers hurried in a jolting rush."},{"id":"manas-2010:p0203:b001:l020","ordinal":8952,"en":"Those whom your gray-maned hero faced,"},{"id":"manas-2010:p0203:b001:l021","ordinal":8953,"en":"He drove, pursued and battered."},{"id":"manas-2010:p0203:b001:l022","ordinal":8954,"en":"The Chinese wearing short coats,"},{"id":"manas-2010:p0203:b001:l023","ordinal":8955,"en":"Their strong men piled up like mountains."},{"id":"manas-2010:p0203:b001:l024","ordinal":8956,"en":"The Chinese with rank buttons on their caps,"},{"id":"manas-2010:p0203:b001:l025","ordinal":8957,"en":"Their shaven-headed ones were slaughtered."},{"id":"manas-2010:p0203:b001:l026","ordinal":8958,"en":"Mighty wrestlers and khans died."},{"id":"manas-2010:p0203:b001:l027","ordinal":8959,"en":"At the hands of the lone child Manas,"},{"id":"manas-2010:p0203:b001:l028","ordinal":8960,"en":"The Chinese with rank buttons on their caps,"}]
