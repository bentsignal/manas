{"id": "sayakbay-ms-current146:pdf239:l022", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 239, "folio": 622, "line_in_page": 22, "raw": "Алда Таала пендеси,", "text": "Алда Таала пендеси,", "en": "He was a servant of Almighty God.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
