,{"id":"seytek-2012:p0854:b003:l040","ordinal":360940,"en":"I took it as a gift,"},{"id":"seytek-2012:p0855:b002:l001","ordinal":360941,"en":"Now if I get angry,"},{"id":"seytek-2012:p0855:b002:l002","ordinal":360942,"en":"Albanian population died,"},{"id":"seytek-2012:p0855:b002:l003","ordinal":360943,"en":"A giant like India died,"},{"id":"seytek-2012:p0855:b002:l004","ordinal":360944,"en":"Can't stand my guilt"},{"id":"seytek-2012:p0855:b002:l005","ordinal":360945,"en":"The fairy in the hat is dead,"},{"id":"seytek-2012:p0855:b002:l006","ordinal":360946,"en":"His head is intact, his heart is free,"},{"id":"seytek-2012:p0855:b002:l007","ordinal":360947,"en":"Look at my speech,"},{"id":"seytek-2012:p0855:b002:l008","ordinal":360948,"en":"What kind of person is equal,"},{"id":"seytek-2012:p0855:b002:l009","ordinal":360949,"en":"He took a giant,"},{"id":"seytek-2012:p0855:b002:l010","ordinal":360950,"en":"Albanian population died,"},{"id":"seytek-2012:p0855:b002:l011","ordinal":360951,"en":"I am Sarybay,"},{"id":"seytek-2012:p0855:b002:l012","ordinal":360952,"en":"I am a troublemaker."},{"id":"seytek-2012:p0855:b002:l013","ordinal":360953,"en":"The black eye of boredom,"},{"id":"seytek-2012:p0855:b002:l014","ordinal":360954,"en":"Damn me,"},{"id":"seytek-2012:p0855:b002:l015","ordinal":360955,"en":"If the demon wants to swallow,"},{"id":"seytek-2012:p0855:b002:l016","ordinal":360956,"en":"You won't have the right one."},{"id":"seytek-2012:p0855:b002:l017","ordinal":360957,"en":"If I run away with my anger,"},{"id":"seytek-2012:p0855:b002:l018","ordinal":360958,"en":"Not one of you will return to your people."},{"id":"seytek-2012:p0855:b002:l019","ordinal":360959,"en":"If I bite into the grave"},{"id":"seytek-2012:p0855:b002:l020","ordinal":360960,"en":"You will not return alive without dying."}]
