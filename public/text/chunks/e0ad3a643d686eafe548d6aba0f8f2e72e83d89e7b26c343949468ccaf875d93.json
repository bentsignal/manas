[{"id":"manas-2010:p0374:b001:l026","ordinal":17153,"en":"From these Black Kalmyks"},{"id":"manas-2010:p0374:b001:l027","ordinal":17154,"en":"We suffered oppression long ago."},{"id":"manas-2010:p0374:b001:l028","ordinal":17155,"en":"Driven away as a spectacle,"},{"id":"manas-2010:p0374:b001:l029","ordinal":17156,"en":"We came to Altai long ago."},{"id":"manas-2010:p0374:b001:l030","ordinal":17157,"en":"At that time, we forty households"},{"id":"manas-2010:p0374:b001:l031","ordinal":17158,"en":"Were slaughtered and died!"},{"id":"manas-2010:p0374:b001:l032","ordinal":17159,"en":"Against the looming Kalmyks,"},{"id":"manas-2010:p0374:b001:l033","ordinal":17160,"en":"Let me stand and fight."},{"id":"manas-2010:p0374:b001:l034","ordinal":17161,"en":"My support, wolf-man Manas,"},{"id":"manas-2010:p0374:b001:l035","ordinal":17162,"en":"How can I give him to the Kalmyks!"},{"id":"manas-2010:p0374:b001:l036","ordinal":17163,"en":"Dear Baltay, wealthy Jakyp—"},{"id":"manas-2010:p0374:b001:l037","ordinal":17164,"en":"Spending all my countless cattle,"},{"id":"manas-2010:p0374:b001:l038","ordinal":17165,"en":"With Black Chinese and Manchus"},{"id":"manas-2010:p0374:b001:l039","ordinal":17166,"en":"Let me measure my strength!"},{"id":"manas-2010:p0374:b001:l040","ordinal":17167,"en":"They have their lord Esenkan,"},{"id":"manas-2010:p0374:b001:l041","ordinal":17168,"en":"Who has sent so vast a host."},{"id":"manas-2010:p0374:b001:l042","ordinal":17169,"en":"If we look from end to end,"},{"id":"manas-2010:p0374:b001:l043","ordinal":17170,"en":"He means to crush us utterly."},{"id":"manas-2010:p0374:b001:l044","ordinal":17171,"en":"He means to block my road;"},{"id":"manas-2010:p0374:b001:l045","ordinal":17172,"en":"If I fall into his net, this unbeliever"},{"id":"manas-2010:p0374:b001:l046","ordinal":17173,"en":"Means to bind my hands,"},{"id":"manas-2010:p0374:b001:l047","ordinal":17174,"en":"Means to show my eyes"},{"id":"manas-2010:p0374:b001:l048","ordinal":17175,"en":"Wonders no man can bear to see,"},{"id":"manas-2010:p0375:b001:l001","ordinal":17176,"en":"He has meant to dig my pit,"},{"id":"manas-2010:p0375:b001:l002","ordinal":17177,"en":"He has meant to brew my misery;"},{"id":"manas-2010:p0375:b001:l003","ordinal":17178,"en":"He has meant to bind, indeed,"},{"id":"manas-2010:p0375:b001:l004","ordinal":17179,"en":"The cherished jewel upon my brow,"},{"id":"manas-2010:p0375:b001:l005","ordinal":17180,"en":"That wondrous boy Manas."},{"id":"manas-2010:p0375:b001:l006","ordinal":17181,"en":"While Akbaltay still lives,"},{"id":"manas-2010:p0375:b001:l007","ordinal":17182,"en":"How can I give up my Manas?"},{"id":"manas-2010:p0375:b001:l008","ordinal":17183,"en":"This boar has grown mighty—"},{"id":"manas-2010:p0375:b001:l009","ordinal":17184,"en":"Let me clash with him!”"},{"id":"manas-2010:p0375:b001:l010","ordinal":17185,"en":"Saying this, Baltay could not stay still:"},{"id":"manas-2010:p0375:b001:l011","ordinal":17186,"en":"“If I die, there will be great regret;"},{"id":"manas-2010:p0375:b001:l012","ordinal":17187,"en":"Ripping lungs and cutting heads,"},{"id":"manas-2010:p0375:b001:l013","ordinal":17188,"en":"Let me wage a mighty battle!"},{"id":"manas-2010:p0375:b001:l014","ordinal":17189,"en":"My lion Manas, blessed by Kydyr,"},{"id":"manas-2010:p0375:b001:l015","ordinal":17190,"en":"Having seized and given him to the Chinese,"},{"id":"manas-2010:p0375:b001:l016","ordinal":17191,"en":"How could I face the Kyrgyz?"},{"id":"manas-2010:p0375:b001:l017","ordinal":17192,"en":"These Kalmyks are eager for it;"},{"id":"manas-2010:p0375:b001:l018","ordinal":17193,"en":"Let me fight them to the death!"},{"id":"manas-2010:p0375:b001:l019","ordinal":17194,"en":"While my beard is white as a swan,"},{"id":"manas-2010:p0375:b001:l020","ordinal":17195,"en":"While my departure is near,"},{"id":"manas-2010:p0375:b001:l021","ordinal":17196,"en":"With the countless Kalmyk people"},{"id":"manas-2010:p0375:b001:l022","ordinal":17197,"en":"Let me measure my strength!"},{"id":"manas-2010:p0375:b001:l023","ordinal":17198,"en":"For fortunate son Manas,"},{"id":"manas-2010:p0375:b001:l024","ordinal":17199,"en":"Until we are utterly slaughtered,"},{"id":"manas-2010:p0375:b001:l025","ordinal":17200,"en":"Let me keep on smashing them!"},{"id":"manas-2010:p0375:b001:l026","ordinal":17201,"en":"Manas is no ordinary son,"},{"id":"manas-2010:p0375:b001:l027","ordinal":17202,"en":"Putting us out of his mind,"},{"id":"manas-2010:p0375:b001:l028","ordinal":17203,"en":"He is no slave to wander at play!"},{"id":"manas-2010:p0375:b001:l029","ordinal":17204,"en":"Manas is no worthless son,"},{"id":"manas-2010:p0375:b001:l030","ordinal":17205,"en":"Putting us out of his heart,"},{"id":"manas-2010:p0375:b001:l031","ordinal":17206,"en":"He is no slave to wander without care!"},{"id":"manas-2010:p0375:b001:l032","ordinal":17207,"en":"Born greater than other mortals,"},{"id":"manas-2010:p0375:b001:l033","ordinal":17208,"en":"This Manas is no worthless one!"},{"id":"manas-2010:p0375:b001:l034","ordinal":17209,"en":"While that destroyer lives,"},{"id":"manas-2010:p0375:b001:l035","ordinal":17210,"en":"He is no son to forget us!"},{"id":"manas-2010:p0375:b001:l036","ordinal":17211,"en":"If mighty Manas lives,"},{"id":"manas-2010:p0375:b001:l037","ordinal":17212,"en":"He will make my noble head a khan's;"},{"id":"manas-2010:p0375:b001:l038","ordinal":17213,"en":"Of those roaring Kalmyks,"},{"id":"manas-2010:p0375:b001:l039","ordinal":17214,"en":"He will lay twelve thousand low!"},{"id":"manas-2010:p0375:b001:l040","ordinal":17215,"en":"Those haughty Chinese and Manchus,"},{"id":"manas-2010:p0375:b001:l041","ordinal":17216,"en":"How can I submit to their words?"},{"id":"manas-2010:p0375:b001:l042","ordinal":17217,"en":"To those swaggering Chinese and Manchus,"},{"id":"manas-2010:p0375:b001:l043","ordinal":17218,"en":"Without fighting them myself,"},{"id":"manas-2010:p0375:b001:l044","ordinal":17219,"en":"How can I stand and yield?"},{"id":"manas-2010:p0375:b001:l045","ordinal":17220,"en":"While I have strength and power,"},{"id":"manas-2010:p0375:b001:l046","ordinal":17221,"en":"Let me die fighting them!"},{"id":"manas-2010:p0375:b001:l047","ordinal":17222,"en":"Grasping a spear, I shall break the ranks;"},{"id":"manas-2010:p0375:b001:l048","ordinal":17223,"en":"If death comes, I shall fall to a shot!"},{"id":"manas-2010:p0376:b001:l001","ordinal":17224,"en":"What the Maker has written,"},{"id":"manas-2010:p0376:b001:l002","ordinal":17225,"en":"How can I leave without seeing it?"},{"id":"manas-2010:p0376:b001:l003","ordinal":17226,"en":"Against the swarming Black Kalmyks,"},{"id":"manas-2010:p0376:b001:l004","ordinal":17227,"en":"How can I leave without dying!”"},{"id":"manas-2010:p0376:b001:l005","ordinal":17228,"en":"Saying this, Akbaltay,"},{"id":"manas-2010:p0376:b001:l006","ordinal":17229,"en":"Having heard Kutubiy's words,"},{"id":"manas-2010:p0376:b001:l007","ordinal":17230,"en":"The Black Chinese and Manchus—"},{"id":"manas-2010:p0376:b001:l008","ordinal":17231,"en":"Having heard they would surround them,"},{"id":"manas-2010:p0376:b001:l009","ordinal":17232,"en":"Readied spear and sword,"},{"id":"manas-2010:p0376:b001:l010","ordinal":17233,"en":"Fastened his club crosswise,"},{"id":"manas-2010:p0376:b001:l011","ordinal":17234,"en":"Alarmed by the many Chinese,"},{"id":"manas-2010:p0376:b001:l012","ordinal":17235,"en":"He saddled Kulager:"},{"id":"manas-2010:p0376:b001:l013","ordinal":17236,"en":"“His father Jakyp is senseless,"},{"id":"manas-2010:p0376:b001:l014","ordinal":17237,"en":"An ill-intentioned soul,"},{"id":"manas-2010:p0376:b001:l015","ordinal":17238,"en":"A creature the One has made!"},{"id":"manas-2010:p0376:b001:l016","ordinal":17239,"en":"Much livestock, but no sense!"},{"id":"manas-2010:p0376:b001:l017","ordinal":17240,"en":"Your countless cattle that you number—"},{"id":"manas-2010:p0376:b001:l018","ordinal":17241,"en":"Let them be sacrificed for Manas alone!”"},{"id":"manas-2010:p0376:b001:l019","ordinal":17242,"en":"Thus Akbaltay spoke,"},{"id":"manas-2010:p0376:b001:l020","ordinal":17243,"en":"Raging and gathering his force,"},{"id":"manas-2010:p0376:b001:l021","ordinal":17244,"en":"Addressing Khan Jakyp:"},{"id":"manas-2010:p0376:b001:l022","ordinal":17245,"en":"“When your father Karakan died,"},{"id":"manas-2010:p0376:b001:l023","ordinal":17246,"en":"You came an exile to Altai."},{"id":"manas-2010:p0376:b001:l024","ordinal":17247,"en":"Can countless cattle become your child?"},{"id":"manas-2010:p0376:b001:l025","ordinal":17248,"en":"All forty households that move and breathe,"},{"id":"manas-2010:p0376:b001:l026","ordinal":17249,"en":"Let them be sacrificed for Manas alone!"},{"id":"manas-2010:p0376:b001:l027","ordinal":17250,"en":"If you fear the Black Kalmyks,"},{"id":"manas-2010:p0376:b001:l028","ordinal":17251,"en":"Go before them and offer your livestock."},{"id":"manas-2010:p0376:b001:l029","ordinal":17252,"en":"If pleading makes them spare your life,"},{"id":"manas-2010:p0376:b001:l030","ordinal":17253,"en":"Bind your head and offer your blood!"},{"id":"manas-2010:p0376:b001:l031","ordinal":17254,"en":"I shall die rather than remain alive;"},{"id":"manas-2010:p0376:b001:l032","ordinal":17255,"en":"While this dear head is mine,"},{"id":"manas-2010:p0376:b001:l033","ordinal":17256,"en":"I will not give up Khan Manas!”"},{"id":"manas-2010:p0376:b001:l034","ordinal":17257,"en":"Wrathful and making ready,"},{"id":"manas-2010:p0376:b001:l035","ordinal":17258,"en":"Fastening on his weapons,"},{"id":"manas-2010:p0376:b001:l036","ordinal":17259,"en":"Akbaltay sprang forth in fury,"},{"id":"manas-2010:p0376:b001:l037","ordinal":17260,"en":"Against the Black Kalmyks and Manchus"},{"id":"manas-2010:p0376:b001:l038","ordinal":17261,"en":"Preparing to grapple."},{"id":"manas-2010:p0376:b001:l039","ordinal":17262,"en":"“Living on without dying,"},{"id":"manas-2010:p0376:b001:l040","ordinal":17263,"en":"What legacy shall I attain?"},{"id":"manas-2010:p0376:b001:l041","ordinal":17264,"en":"For this boy Manas,"},{"id":"manas-2010:p0376:b001:l042","ordinal":17265,"en":"I shall give myself in sacrifice!”"},{"id":"manas-2010:p0376:b001:l043","ordinal":17266,"en":"Akbaltay said these words:"},{"id":"manas-2010:p0376:b001:l044","ordinal":17267,"en":"“Among the seething Black Kalmyks,"},{"id":"manas-2010:p0376:b001:l045","ordinal":17268,"en":"May I die raising havoc!”"},{"id":"manas-2010:p0376:b001:l046","ordinal":17269,"en":"Thus Akbaltay,"},{"id":"manas-2010:p0376:b001:l047","ordinal":17270,"en":"Without looking around him,"},{"id":"manas-2010:p0376:b001:l048","ordinal":17271,"en":"Without sparing his life at all,"},{"id":"manas-2010:p0377:b001:l001","ordinal":17272,"en":"Without looking all around,"},{"id":"manas-2010:p0377:b001:l002","ordinal":17273,"en":"Without sparing his thread-thin life,"},{"id":"manas-2010:p0377:b001:l003","ordinal":17274,"en":"While Akbaltay stood like this,"},{"id":"manas-2010:p0377:b001:l004","ordinal":17275,"en":"On this side Kutubiy"},{"id":"manas-2010:p0377:b001:l005","ordinal":17276,"en":"Readied himself with Telkyzyl,"},{"id":"manas-2010:p0377:b001:l006","ordinal":17277,"en":"Praying to the Almighty,"},{"id":"manas-2010:p0377:b001:l007","ordinal":17278,"en":"Preparing his weapons of war."},{"id":"manas-2010:p0377:b001:l008","ordinal":17279,"en":"If you ask about Kutubiy—"},{"id":"manas-2010:p0377:b001:l009","ordinal":17280,"en":"His father was Oshpur."},{"id":"manas-2010:p0377:b001:l010","ordinal":17281,"en":"When the leopard was born,"},{"id":"manas-2010:p0377:b001:l011","ordinal":17282,"en":"He was parted from his father,"},{"id":"manas-2010:p0377:b001:l012","ordinal":17283,"en":"And was still Manas's companion!"},{"id":"manas-2010:p0377:b001:l013","ordinal":17284,"en":"Purified of the dark faith,"},{"id":"manas-2010:p0377:b001:l014","ordinal":17285,"en":"He had left the Kalmyks and become a stranger!"},{"id":"manas-2010:p0377:b001:l015","ordinal":17286,"en":"His power reached throughout the world,"},{"id":"manas-2010:p0377:b001:l016","ordinal":17287,"en":"He knew God's ways well,"},{"id":"manas-2010:p0377:b001:l017","ordinal":17288,"en":"And received the Forty Chilten's blessing:"},{"id":"manas-2010:p0377:b001:l018","ordinal":17289,"en":"“May he bring good fortune to Manas!”"},{"id":"manas-2010:p0377:b001:l019","ordinal":17290,"en":"He received the saints' blessing."},{"id":"manas-2010:p0377:b001:l020","ordinal":17291,"en":"Through this your servant"},{"id":"manas-2010:p0377:b001:l021","ordinal":17292,"en":"Came to be called Kutubiy."},{"id":"manas-2010:p0377:b001:l022","ordinal":17293,"en":"He is the faithful friend, he is the khan,"},{"id":"manas-2010:p0377:b001:l023","ordinal":17294,"en":"He is the soul who is Manas's companion."},{"id":"manas-2010:p0377:b001:l024","ordinal":17295,"en":"Their villages close, their walls adjoining,"},{"id":"manas-2010:p0377:b001:l025","ordinal":17296,"en":"Their minds close, joined together."},{"id":"manas-2010:p0377:b001:l026","ordinal":17297,"en":"Partners gathering pieces when playing ordo,"},{"id":"manas-2010:p0377:b001:l027","ordinal":17298,"en":"Brothers in faith since the beginning."},{"id":"manas-2010:p0377:b001:l028","ordinal":17299,"en":"That dear Kutubiy of yours,"},{"id":"manas-2010:p0377:b001:l029","ordinal":17300,"en":"His fame precious, his name great,"},{"id":"manas-2010:p0377:b001:l030","ordinal":17301,"en":"A great lord equal to Manas!"},{"id":"manas-2010:p0377:b001:l031","ordinal":17302,"en":"A wise man among spearmen,"},{"id":"manas-2010:p0377:b001:l032","ordinal":17303,"en":"Your dear Kutubiy"},{"id":"manas-2010:p0377:b001:l033","ordinal":17304,"en":"Also possessed great skill."},{"id":"manas-2010:p0377:b001:l034","ordinal":17305,"en":"His face distinctive, his wrath fierce,"},{"id":"manas-2010:p0377:b001:l035","ordinal":17306,"en":"Rich in wisdom, a great speaker,"},{"id":"manas-2010:p0377:b001:l036","ordinal":17307,"en":"He also possessed excellence!"},{"id":"manas-2010:p0377:b001:l037","ordinal":17308,"en":"Ready for the enemy, ready for work,"},{"id":"manas-2010:p0377:b001:l038","ordinal":17309,"en":"He also possessed resourcefulness."},{"id":"manas-2010:p0377:b001:l039","ordinal":17310,"en":"Leading, he would never lose the way;"},{"id":"manas-2010:p0377:b001:l040","ordinal":17311,"en":"He also possessed clear understanding!"},{"id":"manas-2010:p0377:b001:l041","ordinal":17312,"en":"“With the Chinese who fancy themselves resourceful,"},{"id":"manas-2010:p0377:b001:l042","ordinal":17313,"en":"I will try grappling."},{"id":"manas-2010:p0377:b001:l043","ordinal":17314,"en":"Tomorrow, when the blue-maned one comes"},{"id":"manas-2010:p0377:b001:l044","ordinal":17315,"en":"And asks, ‘Where are your forty households?’—"},{"id":"manas-2010:p0377:b001:l045","ordinal":17316,"en":"If I let the Chinese slaughter them,"},{"id":"manas-2010:p0377:b001:l046","ordinal":17317,"en":"What answer will I give?"},{"id":"manas-2010:p0377:b001:l047","ordinal":17318,"en":"Against the overwhelming Black Kalmyks"},{"id":"manas-2010:p0377:b001:l048","ordinal":17319,"en":"Let me charge and level my spear."},{"id":"manas-2010:p0378:b001:l001","ordinal":17320,"en":"If mighty Allah grants a way,"},{"id":"manas-2010:p0378:b001:l002","ordinal":17321,"en":"From utterly dark hell"},{"id":"manas-2010:p0378:b001:l003","ordinal":17322,"en":"Let me set my soul free!"},{"id":"manas-2010:p0378:b001:l004","ordinal":17323,"en":"We have read the stars in heaven together,"},{"id":"manas-2010:p0378:b001:l005","ordinal":17324,"en":"We have sworn friendship twelve times;"},{"id":"manas-2010:p0378:b001:l006","ordinal":17325,"en":"Of the champion, blue-maned Manas,"},{"id":"manas-2010:p0378:b001:l007","ordinal":17326,"en":"Let me honor the wishes!”"},{"id":"manas-2010:p0378:b003:l001","ordinal":17327,"en":"If I have the strength, let me clash,"},{"id":"manas-2010:p0378:b003:l002","ordinal":17328,"en":"Let me keep blocking their way."},{"id":"manas-2010:p0378:b003:l003","ordinal":17329,"en":"Against the surging Black Chinese,"},{"id":"manas-2010:p0378:b003:l004","ordinal":17330,"en":"If my death has come, let me die!"},{"id":"manas-2010:p0378:b003:l005","ordinal":17331,"en":"The blue battle belt loosened at his waist,"},{"id":"manas-2010:p0378:b003:l006","ordinal":17332,"en":"The blue lance showed in his hand,"},{"id":"manas-2010:p0378:b003:l007","ordinal":17333,"en":"The battle-axe clattered at his side,"},{"id":"manas-2010:p0378:b003:l008","ordinal":17334,"en":"The sword shone in its sheath."},{"id":"manas-2010:p0378:b003:l009","ordinal":17335,"en":"Clad in all-blue iron,"},{"id":"manas-2010:p0378:b003:l010","ordinal":17336,"en":"The hero Kutubiy then,"},{"id":"manas-2010:p0378:b003:l011","ordinal":17337,"en":"As though going to his wife's kin,"},{"id":"manas-2010:p0378:b003:l012","ordinal":17338,"en":"Laughed openly with delight."},{"id":"manas-2010:p0378:b003:l013","ordinal":17339,"en":"He flung himself like a hungry lion,"},{"id":"manas-2010:p0378:b003:l014","ordinal":17340,"en":"He swerved like a white tiger."},{"id":"manas-2010:p0378:b003:l015","ordinal":17341,"en":"He struck Telkyzyl once on the flank,"},{"id":"manas-2010:p0378:b003:l016","ordinal":17342,"en":"And took his iron-headed spear in hand."},{"id":"manas-2010:p0378:b003:l017","ordinal":17343,"en":"At the sight, attention was drawn;"},{"id":"manas-2010:p0378:b003:l018","ordinal":17344,"en":"His blue-maned fierceness showed."},{"id":"manas-2010:p0378:b003:l019","ordinal":17345,"en":"He bound his waist tightly,"},{"id":"manas-2010:p0378:b003:l020","ordinal":17346,"en":"Biting hard across his lip,"},{"id":"manas-2010:p0378:b003:l021","ordinal":17347,"en":"Laughing loudly, eyes flashing."},{"id":"manas-2010:p0378:b003:l022","ordinal":17348,"en":"What could dear Kutu do?"},{"id":"manas-2010:p0378:b003:l023","ordinal":17349,"en":"His thirst for blood truly seized him."},{"id":"manas-2010:p0378:b003:l024","ordinal":17350,"en":"He roared with his full fury,"},{"id":"manas-2010:p0378:b003:l025","ordinal":17351,"en":"Crying “Manas!” as his battle-cry."},{"id":"manas-2010:p0378:b003:l026","ordinal":17352,"en":"Facing him was huge Zholoy,"},{"id":"manas-2010:p0378:b003:l027","ordinal":17353,"en":"The renowned giant Döödür,"},{"id":"manas-2010:p0378:b003:l028","ordinal":17354,"en":"Karazhoy who never missed a shot,"},{"id":"manas-2010:p0378:b003:l029","ordinal":17355,"en":"And Ezkara, the wicked seer."},{"id":"manas-2010:p0378:b003:l030","ordinal":17356,"en":"He faced them and attacked alone."},{"id":"manas-2010:p0378:b003:l031","ordinal":17357,"en":"Against the infidel at full strength,"},{"id":"manas-2010:p0378:b003:l032","ordinal":17358,"en":"Against a warrior like Khan Zholoy,"},{"id":"manas-2010:p0378:b003:l033","ordinal":17359,"en":"He charged and launched his assault."},{"id":"manas-2010:p0378:b003:l034","ordinal":17360,"en":"They stood face to face,"},{"id":"manas-2010:p0378:b003:l035","ordinal":17361,"en":"Fighting with spears,"},{"id":"manas-2010:p0378:b003:l036","ordinal":17362,"en":"Swords shattering, dust filling the air,"},{"id":"manas-2010:p0379:b001:l001","ordinal":17363,"en":"The shouting Chinese thronged thickly."},{"id":"manas-2010:p0379:b001:l002","ordinal":17364,"en":"Of Kutu, Oshpur's son,"},{"id":"manas-2010:p0379:b001:l003","ordinal":17365,"en":"“Ho, my people, bind him!” they cried."},{"id":"manas-2010:p0379:b001:l004","ordinal":17366,"en":"The people surged from right and left."},{"id":"manas-2010:p0379:b001:l005","ordinal":17367,"en":"Ruinous trouble, a night of doom—"},{"id":"manas-2010:p0379:b001:l006","ordinal":17368,"en":"No soul could approach his devastation;"},{"id":"manas-2010:p0379:b001:l007","ordinal":17369,"en":"That towering hero Zholoy"},{"id":"manas-2010:p0379:b001:l008","ordinal":17370,"en":"Brought a grievous day on Kutu."},{"id":"manas-2010:p0379:b001:l009","ordinal":17371,"en":"They stood facing one another,"},{"id":"manas-2010:p0379:b001:l010","ordinal":17372,"en":"Thrusting spears, drawing bows,"},{"id":"manas-2010:p0379:b001:l011","ordinal":17373,"en":"They fought with crushing blows."},{"id":"manas-2010:p0379:b001:l012","ordinal":17374,"en":"Dear Kutu was alone;"},{"id":"manas-2010:p0379:b001:l013","ordinal":17375,"en":"His protector Manas had not yet come."},{"id":"manas-2010:p0379:b001:l014","ordinal":17376,"en":"Who has seen such a plight!"},{"id":"manas-2010:p0379:b001:l015","ordinal":17377,"en":"They stood face to face."},{"id":"manas-2010:p0379:b001:l016","ordinal":17378,"en":"The Chinese of forty clans surged in,"},{"id":"manas-2010:p0379:b001:l017","ordinal":17379,"en":"Drawing bows, making rain,"},{"id":"manas-2010:p0379:b001:l018","ordinal":17380,"en":"Firing shots, making hail."},{"id":"manas-2010:p0379:b001:l019","ordinal":17381,"en":"See the flood surpassing mankind!"},{"id":"manas-2010:p0379:b001:l020","ordinal":17382,"en":"Their shouting deafened ears;"},{"id":"manas-2010:p0379:b001:l021","ordinal":17383,"en":"See the people surging over him!"},{"id":"manas-2010:p0379:b001:l022","ordinal":17384,"en":"See the embers burning on the plain,"},{"id":"manas-2010:p0379:b001:l023","ordinal":17385,"en":"Glittering like stars,"},{"id":"manas-2010:p0379:b001:l024","ordinal":17386,"en":"See the shots fired from burning matches!"},{"id":"manas-2010:p0379:b001:l025","ordinal":17387,"en":"See the net spread out in front,"},{"id":"manas-2010:p0379:b001:l026","ordinal":17388,"en":"And beyond that net,"},{"id":"manas-2010:p0379:b001:l027","ordinal":17389,"en":"To drop him in and capture him,"},{"id":"manas-2010:p0379:b001:l028","ordinal":17390,"en":"See the hidden pit!"},{"id":"manas-2010:p0379:b001:l029","ordinal":17391,"en":"The strongest of them all,"},{"id":"manas-2010:p0379:b001:l030","ordinal":17392,"en":"The most skillful of spearmen,"},{"id":"manas-2010:p0379:b001:l031","ordinal":17393,"en":"The stratagems of the foes he fought—"},{"id":"manas-2010:p0379:b001:l032","ordinal":17394,"en":"The mighty one who knew them plainly,"},{"id":"manas-2010:p0379:b001:l033","ordinal":17395,"en":"Looming on Achbuudan,"},{"id":"manas-2010:p0379:b001:l034","ordinal":17396,"en":"See the splendid hero Zholoy!"},{"id":"manas-2010:p0379:b001:l035","ordinal":17397,"en":"The fortunate companion Kutubiy"},{"id":"manas-2010:p0379:b001:l036","ordinal":17398,"en":"Speared men on the downward slope."},{"id":"manas-2010:p0379:b001:l037","ordinal":17399,"en":"Your falcon struck those he met,"},{"id":"manas-2010:p0379:b001:l038","ordinal":17400,"en":"Piercing two abreast with one thrust."},{"id":"manas-2010:p0379:b001:l039","ordinal":17401,"en":"Without looking around him,"},{"id":"manas-2010:p0379:b001:l040","ordinal":17402,"en":"Without sparing his life at all,"},{"id":"manas-2010:p0379:b001:l041","ordinal":17403,"en":"He matched them in battle."},{"id":"manas-2010:p0379:b001:l042","ordinal":17404,"en":"To overwhelm Kutubiy,"},{"id":"manas-2010:p0379:b001:l043","ordinal":17405,"en":"Bearing a banner with a mottled bay pennon,"},{"id":"manas-2010:p0379:b001:l044","ordinal":17406,"en":"The swift foot-runners surged in."},{"id":"manas-2010:p0379:b001:l045","ordinal":17407,"en":"Looking from one side,"},{"id":"manas-2010:p0379:b001:l046","ordinal":17408,"en":"Firing guns and drawing bows,"}]
