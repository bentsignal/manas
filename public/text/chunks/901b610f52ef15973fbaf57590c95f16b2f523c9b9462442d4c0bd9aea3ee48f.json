[{"id":"semetey-1-2013:p0941:b003:l026","ordinal":147969,"en":"Many giants had made that demand;"},{"id":"semetey-1-2013:p0941:b003:l027","ordinal":147970,"en":"Even then, Akun"},{"id":"semetey-1-2013:p0941:b003:l028","ordinal":147971,"en":"Had kept his own head safe."},{"id":"semetey-1-2013:p0941:b003:l029","ordinal":147972,"en":"There were guards at his gate,"},{"id":"semetey-1-2013:p0941:b003:l030","ordinal":147973,"en":"A thousand champions outside,"},{"id":"semetey-1-2013:p0941:b003:l031","ordinal":147974,"en":"Who watched over Akun."},{"id":"semetey-1-2013:p0941:b003:l032","ordinal":147975,"en":"His champions were extraordinary,"},{"id":"semetey-1-2013:p0941:b003:l033","ordinal":147976,"en":"Every one a tiger, an outstanding hero."},{"id":"semetey-1-2013:p0941:b003:l034","ordinal":147977,"en":"All had swift riding horses,"},{"id":"semetey-1-2013:p0941:b003:l035","ordinal":147978,"en":"And wise Akun was their khan."},{"id":"semetey-1-2013:p0941:b003:l036","ordinal":147979,"en":"If you looked at his champions,"},{"id":"semetey-1-2013:p0941:b003:l037","ordinal":147980,"en":"Each single champion"},{"id":"semetey-1-2013:p0941:b003:l038","ordinal":147981,"en":"Had the strength of a thousand."},{"id":"semetey-1-2013:p0941:b003:l039","ordinal":147982,"en":"At the entrance to his door,"},{"id":"semetey-1-2013:p0941:b004:l001","ordinal":147983,"en":"His keepers were exceptional."},{"id":"semetey-1-2013:p0941:b004:l002","ordinal":147984,"en":"At the threshold was a bell;"},{"id":"semetey-1-2013:p0941:b004:l003","ordinal":147985,"en":"If that bell was struck,"},{"id":"semetey-1-2013:p0941:b004:l004","ordinal":147986,"en":"They would not spare a living soul."},{"id":"semetey-1-2013:p0941:b004:l005","ordinal":147987,"en":"The guards beyond it,"},{"id":"semetey-1-2013:p0941:b004:l006","ordinal":147988,"en":"When they suddenly attacked,"},{"id":"semetey-1-2013:p0941:b004:l007","ordinal":147989,"en":"Sprang like lions."},{"id":"semetey-1-2013:p0941:b004:l008","ordinal":147990,"en":"Human noses and ears"},{"id":"semetey-1-2013:p0941:b004:l009","ordinal":147991,"en":"They wore as amulets;"},{"id":"semetey-1-2013:p0941:b004:l010","ordinal":147992,"en":"Such guards he also had."},{"id":"semetey-1-2013:p0941:b004:l011","ordinal":147993,"en":"On one side of the door"},{"id":"semetey-1-2013:p0941:b004:l012","ordinal":147994,"en":"He had a sword-trunked elephant."},{"id":"semetey-1-2013:p0941:b004:l013","ordinal":147995,"en":"Toltoi, who meant to take a wife—"},{"id":"semetey-1-2013:p0941:b004:l014","ordinal":147996,"en":"Understand what a formidable man he faced."},{"id":"semetey-1-2013:p0941:b004:l015","ordinal":147997,"en":"Beyond that"},{"id":"semetey-1-2013:p0941:b004:l016","ordinal":147998,"en":"Was his garden of great plane trees,"},{"id":"semetey-1-2013:p0941:b004:l017","ordinal":147999,"en":"And he had a talking bird."},{"id":"semetey-1-2013:p0941:b004:l018","ordinal":148000,"en":"When one passed beyond the garden,"},{"id":"semetey-1-2013:p0941:b004:l019","ordinal":148001,"en":"The dear champion Akun"},{"id":"semetey-1-2013:p0941:b004:l020","ordinal":148002,"en":"Had a throne upon which he sat."},{"id":"semetey-1-2013:p0941:b004:l021","ordinal":148003,"en":"The throne was bordered by a plane-tree garden;"},{"id":"semetey-1-2013:p0941:b004:l022","ordinal":148004,"en":"In its midst stood a golden throne."},{"id":"semetey-1-2013:p0941:b004:l024","ordinal":148005,"en":"Those who saw it were astonished.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0941:b004:l025","ordinal":148006,"en":"When he saw these wonders,"},{"id":"semetey-1-2013:p0941:b004:l026","ordinal":148007,"en":"Tolok's mind was troubled."},{"id":"semetey-1-2013:p0941:b004:l027","ordinal":148008,"en":"That palace of Akun Khan"},{"id":"semetey-1-2013:p0941:b004:l028","ordinal":148009,"en":"Appeared like paradise."},{"id":"semetey-1-2013:p0941:b004:l030","ordinal":148010,"en":"He had mighty men as well.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0941:b004:l031","ordinal":148011,"en":"Leaning upon their battle-axes,"},{"id":"semetey-1-2013:p0941:b004:l032","ordinal":148012,"en":"Other people came into view."},{"id":"semetey-1-2013:p0941:b004:l034","ordinal":148013,"en":"His marksmen came into view.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0941:b004:l035","ordinal":148014,"en":"'Anyone who faces them will not survive,'"},{"id":"semetey-1-2013:p0941:b004:l036","ordinal":148015,"en":"Tolok thought, his mind troubled."},{"id":"semetey-1-2013:p0941:b004:l037","ordinal":148016,"en":"Four or five champions surrounded Tolok,"},{"id":"semetey-1-2013:p0941:b004:l038","ordinal":148017,"en":"And toward Akun"},{"id":"semetey-1-2013:p0941:b004:l039","ordinal":148018,"en":"They seemed to drive him."},{"id":"semetey-1-2013:p0942:b003:l001","ordinal":148019,"en":"When they drove him before Akun,"},{"id":"semetey-1-2013:p0942:b003:l002","ordinal":148020,"en":"If you ask about Akun,"},{"id":"semetey-1-2013:p0942:b003:l003","ordinal":148021,"en":"His imposing form and majesty,"},{"id":"semetey-1-2013:p0942:b003:l004","ordinal":148022,"en":"His appearance seated upon the throne,"},{"id":"semetey-1-2013:p0942:b003:l005","ordinal":148023,"en":"Troubled the heart to behold;"},{"id":"semetey-1-2013:p0942:b003:l006","ordinal":148024,"en":"He looked quite extraordinary."},{"id":"semetey-1-2013:p0942:b003:l007","ordinal":148025,"en":"Do not ask about Akun:"},{"id":"semetey-1-2013:p0942:b003:l008","ordinal":148026,"en":"His white turban was an armful,"},{"id":"semetey-1-2013:p0942:b003:l009","ordinal":148027,"en":"He bore the appearance of a khoja."},{"id":"semetey-1-2013:p0942:b003:l010","ordinal":148028,"en":"Qurans as large as a horse's head,"},{"id":"semetey-1-2013:p0942:b003:l011","ordinal":148029,"en":"Sixty lay spread out."},{"id":"semetey-1-2013:p0942:b003:l012","ordinal":148030,"en":"He bore the appearance of a mullah."},{"id":"semetey-1-2013:p0942:b003:l013","ordinal":148031,"en":"With his white beard flowing,"},{"id":"semetey-1-2013:p0942:b003:l014","ordinal":148032,"en":"He bore the appearance of a learned scholar,"},{"id":"semetey-1-2013:p0942:b003:l015","ordinal":148033,"en":"Who understood the language of the Haftiyak."},{"id":"semetey-1-2013:p0942:b003:l016","ordinal":148034,"en":"In his youth, Khan Akun"},{"id":"semetey-1-2013:p0942:b003:l017","ordinal":148035,"en":"Had built a house upon the grassy heights."},{"id":"semetey-1-2013:p0942:b003:l018","ordinal":148036,"en":"That Tolok was a bearded old man;"},{"id":"semetey-1-2013:p0942:b003:l019","ordinal":148037,"en":"The elder and Akun too"},{"id":"semetey-1-2013:p0942:b003:l020","ordinal":148038,"en":"Had many stories to tell."},{"id":"semetey-1-2013:p0942:b003:l021","ordinal":148039,"en":"Black-bearded Tolok of the Jediger,"},{"id":"semetey-1-2013:p0942:b003:l022","ordinal":148040,"en":"When he came as envoy,"},{"id":"semetey-1-2013:p0942:b003:l023","ordinal":148041,"en":"With his white beard shining,"},{"id":"semetey-1-2013:p0942:b003:l024","ordinal":148042,"en":"Calling like a migrating goose,"},{"id":"semetey-1-2013:p0942:b003:l025","ordinal":148043,"en":"Akun spoke these words:"},{"id":"semetey-1-2013:p0942:b003:l026","ordinal":148044,"en":"'With your weapons readied,"},{"id":"semetey-1-2013:p0942:b003:l027","ordinal":148045,"en":"Your sword fastened close,"},{"id":"semetey-1-2013:p0942:b003:l028","ordinal":148046,"en":"Who are you, sidling forward?"},{"id":"semetey-1-2013:p0942:b003:l029","ordinal":148047,"en":"State your battle cry, state your purpose!"},{"id":"semetey-1-2013:p0942:b003:l030","ordinal":148048,"en":"Name your lineage, name your people!"},{"id":"semetey-1-2013:p0942:b003:l031","ordinal":148049,"en":"Say whether you come as friend or foe!"},{"id":"semetey-1-2013:p0942:b003:l032","ordinal":148050,"en":"Against this Akun's fortress,"},{"id":"semetey-1-2013:p0942:b003:l033","ordinal":148051,"en":"Why have you charged?"},{"id":"semetey-1-2013:p0942:b003:l034","ordinal":148052,"en":"Whom did you seek?"},{"id":"semetey-1-2013:p0942:b003:l036","ordinal":148053,"en":"Whom did you mean to fight?","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0942:b003:l037","ordinal":148054,"en":"Tell me your words, my child,'"},{"id":"semetey-1-2013:p0942:b003:l038","ordinal":148055,"en":"Akun said this."},{"id":"semetey-1-2013:p0942:b003:l039","ordinal":148056,"en":"Without speaking or uttering a word,"},{"id":"semetey-1-2013:p0942:b004:l001","ordinal":148057,"en":"He now saw his wrath."},{"id":"semetey-1-2013:p0942:b004:l002","ordinal":148058,"en":"The letter in his belt-pouch"},{"id":"semetey-1-2013:p0942:b004:l003","ordinal":148059,"en":"He snatched out in confusion,"},{"id":"semetey-1-2013:p0942:b004:l004","ordinal":148060,"en":"And handed it to Akun Khan."},{"id":"semetey-1-2013:p0942:b004:l005","ordinal":148061,"en":"'I am a guide between the sides,"},{"id":"semetey-1-2013:p0942:b004:l006","ordinal":148062,"en":"An envoy who has come between them,"},{"id":"semetey-1-2013:p0942:b004:l008","ordinal":148063,"en":"One of the mediators.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0942:b004:l009","ordinal":148064,"en":"There are terms to what I must say;"},{"id":"semetey-1-2013:p0942:b004:l010","ordinal":148065,"en":"I have brought before you"},{"id":"semetey-1-2013:p0942:b004:l011","ordinal":148066,"en":"A letter from Chynkojo and Toltoi.'"},{"id":"semetey-1-2013:p0942:b004:l012","ordinal":148067,"en":"When he read the letter,"},{"id":"semetey-1-2013:p0942:b004:l013","ordinal":148068,"en":"Dear Kojo's name was there."},{"id":"semetey-1-2013:p0942:b004:l014","ordinal":148069,"en":"When he read the letter,"},{"id":"semetey-1-2013:p0942:b004:l015","ordinal":148070,"en":"Its words were dreadful:"},{"id":"semetey-1-2013:p0942:b004:l016","ordinal":148071,"en":"'Let him give Aichurok,' it said."},{"id":"semetey-1-2013:p0942:b004:l017","ordinal":148072,"en":"All the Oogan khans"},{"id":"semetey-1-2013:p0942:b004:l018","ordinal":148073,"en":"They had surrounded."},{"id":"semetey-1-2013:p0942:b004:l019","ordinal":148074,"en":"If you contend with them, among them"},{"id":"semetey-1-2013:p0942:b004:l020","ordinal":148075,"en":"Who spare not the whole wide world—"},{"id":"semetey-1-2013:p0942:b004:l021","ordinal":148076,"en":"There are dear Kojo's people."},{"id":"semetey-1-2013:p0942:b004:l022","ordinal":148077,"en":"If you ask about Kojo,"},{"id":"semetey-1-2013:p0942:b004:l023","ordinal":148078,"en":"Thick-armed and stone-hearted,"},{"id":"semetey-1-2013:p0942:b004:l024","ordinal":148079,"en":"An elephant-built brute."},{"id":"semetey-1-2013:p0942:b004:l025","ordinal":148080,"en":"Where could he have seen Churok?"},{"id":"semetey-1-2013:p0942:b004:l026","ordinal":148081,"en":"From where could Toltoi have come?"},{"id":"semetey-1-2013:p0942:b004:l027","ordinal":148082,"en":"Akun Khan knew very well:"},{"id":"semetey-1-2013:p0942:b004:l028","ordinal":148083,"en":"Chynkojo, son of Shygai,"},{"id":"semetey-1-2013:p0942:b004:l029","ordinal":148084,"en":"Kojo, vigorous in his deeds,"},{"id":"semetey-1-2013:p0942:b004:l030","ordinal":148085,"en":"Kojo, broad in the right shoulder,"},{"id":"semetey-1-2013:p0942:b004:l032","ordinal":148086,"en":"Trained by Manas,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0942:b004:l033","ordinal":148087,"en":"Lion Kojo, who had seen much."},{"id":"semetey-1-2013:p0942:b004:l034","ordinal":148088,"en":"Once Kanykei had come in mourning,"},{"id":"semetey-1-2013:p0942:b004:l035","ordinal":148089,"en":"And Semetey had fled,"},{"id":"semetey-1-2013:p0942:b004:l037","ordinal":148090,"en":"Entered Bukhara and grown up.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0942:b004:l038","ordinal":148091,"en":"The fierce hero's son, the warrior bridegroom,"},{"id":"semetey-1-2013:p0942:b004:l039","ordinal":148092,"en":"Had moved back to Talas, it seemed,"},{"id":"semetey-1-2013:p0943:b003:l001","ordinal":148093,"en":"From the orphan son of Manas,"},{"id":"semetey-1-2013:p0943:b003:l002","ordinal":148094,"en":"He must have suffered great humiliation."},{"id":"semetey-1-2013:p0943:b003:l004","ordinal":148095,"en":"To Toltoi of the Jediger,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0943:b003:l005","ordinal":148096,"en":"He fled and settled as a subject,"},{"id":"semetey-1-2013:p0943:b003:l006","ordinal":148097,"en":"Told him of Churok,"},{"id":"semetey-1-2013:p0943:b003:l007","ordinal":148098,"en":"And must have begun this uproar."},{"id":"semetey-1-2013:p0943:b003:l008","ordinal":148099,"en":"Your dear Khan Akun"},{"id":"semetey-1-2013:p0943:b003:l009","ordinal":148100,"en":"Now stood considering,"},{"id":"semetey-1-2013:p0943:b003:l010","ordinal":148101,"en":"Prolonging the dispute greatly,"},{"id":"semetey-1-2013:p0943:b003:l011","ordinal":148102,"en":"He now fumed with rage:"},{"id":"semetey-1-2013:p0943:b003:l012","ordinal":148103,"en":"'When eighty days have passed,"},{"id":"semetey-1-2013:p0943:b003:l013","ordinal":148104,"en":"Seek word from us,"},{"id":"semetey-1-2013:p0943:b003:l014","ordinal":148105,"en":"And become our marriage kin."},{"id":"semetey-1-2013:p0943:b003:l015","ordinal":148106,"en":"My daughter Aichurok"},{"id":"semetey-1-2013:p0943:b003:l016","ordinal":148107,"en":"Is no child to be treated lightly."},{"id":"semetey-1-2013:p0943:b003:l017","ordinal":148108,"en":"This broad Opol"},{"id":"semetey-1-2013:p0943:b003:l018","ordinal":148109,"en":"Is no city to be trampled down."},{"id":"semetey-1-2013:p0943:b003:l019","ordinal":148110,"en":"Great host of Jediger,"},{"id":"semetey-1-2013:p0943:b003:l020","ordinal":148111,"en":"You have descended all together."},{"id":"semetey-1-2013:p0943:b003:l021","ordinal":148112,"en":"Against Toltoi and Kojo,"},{"id":"semetey-1-2013:p0943:b003:l022","ordinal":148113,"en":"I have not destroyed their honor,"},{"id":"semetey-1-2013:p0943:b003:l023","ordinal":148114,"en":"I have inflicted no such humiliation."},{"id":"semetey-1-2013:p0943:b003:l024","ordinal":148115,"en":"I have killed no warrior,"},{"id":"semetey-1-2013:p0943:b003:l026","ordinal":148116,"en":"Our appointed term is eighty days.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0943:b003:l027","ordinal":148117,"en":"So that they do not suddenly attack,"},{"id":"semetey-1-2013:p0943:b003:l028","ordinal":148118,"en":"So that slaughter does not suddenly occur,"},{"id":"semetey-1-2013:p0943:b003:l029","ordinal":148119,"en":"Tell them to restrain their great army."},{"id":"semetey-1-2013:p0943:b003:l030","ordinal":148120,"en":"If he truly means to take a wife,"},{"id":"semetey-1-2013:p0943:b003:l031","ordinal":148121,"en":"Will he not agree to my words?"},{"id":"semetey-1-2013:p0943:b003:l032","ordinal":148122,"en":"Chynkojo's black horse—"},{"id":"semetey-1-2013:p0943:b003:l034","ordinal":148123,"en":"Hero Toltoi's Surkoyon—","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0943:b003:l035","ordinal":148124,"en":"If he truly means to wed,"},{"id":"semetey-1-2013:p0943:b003:l036","ordinal":148125,"en":"Will he not give it as the chief gift-horse?"},{"id":"semetey-1-2013:p0943:b003:l037","ordinal":148126,"en":"Driving seven hundred red camels,"},{"id":"semetey-1-2013:p0943:b003:l038","ordinal":148127,"en":"Will he not give them as the bride-price?"},{"id":"semetey-1-2013:p0943:b004:l001","ordinal":148128,"en":"Raising dust along the road ahead,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0943:b004:l002","ordinal":148129,"en":"Will Toltoi not take his wife,"},{"id":"semetey-1-2013:p0943:b004:l003","ordinal":148130,"en":"And become a bridegroom?"},{"id":"semetey-1-2013:p0943:b004:l004","ordinal":148131,"en":"He has poured and offered no tea,"},{"id":"semetey-1-2013:p0943:b004:l005","ordinal":148132,"en":"Has brought no livestock for the marriage alliance;"},{"id":"semetey-1-2013:p0943:b004:l006","ordinal":148133,"en":"Showing off his army, swaggering,"},{"id":"semetey-1-2013:p0943:b004:l007","ordinal":148134,"en":"I shall not give Churok under humiliation."},{"id":"semetey-1-2013:p0943:b004:l008","ordinal":148135,"en":"Those two horses I have named,"},{"id":"semetey-1-2013:p0943:b004:l009","ordinal":148136,"en":"Let him give them to me as gifts."},{"id":"semetey-1-2013:p0943:b004:l010","ordinal":148137,"en":"I shall not agree to his demands!'"},{"id":"semetey-1-2013:p0943:b004:l011","ordinal":148138,"en":"Hearing Akun's terms,"},{"id":"semetey-1-2013:p0943:b004:l012","ordinal":148139,"en":"Black-bearded hero Tolok"},{"id":"semetey-1-2013:p0943:b004:l013","ordinal":148140,"en":"Hurried back to his people."},{"id":"semetey-1-2013:p0943:b004:l014","ordinal":148141,"en":"To the great Jediger host,"},{"id":"semetey-1-2013:p0943:b004:l015","ordinal":148142,"en":"Their khan Toltoi, and Chynkojo,"},{"id":"semetey-1-2013:p0943:b004:l016","ordinal":148143,"en":"He brought the news joyfully."},{"id":"semetey-1-2013:p0943:b004:l017","ordinal":148144,"en":"The term of eighty days,"},{"id":"semetey-1-2013:p0943:b004:l018","ordinal":148145,"en":"They agreed to the appointed time."},{"id":"semetey-1-2013:p0943:b004:l019","ordinal":148146,"en":"When bored, they shot roe deer."},{"id":"semetey-1-2013:p0943:b004:l020","ordinal":148147,"en":"The great Jediger host"},{"id":"semetey-1-2013:p0943:b004:l021","ordinal":148148,"en":"Lay besieging Oogan."},{"id":"semetey-1-2013:p0943:b004:l022","ordinal":148149,"en":"Chynkojo brought his wrath to bear,"},{"id":"semetey-1-2013:p0943:b004:l023","ordinal":148150,"en":"And the hero Toltoi roused his strength."},{"id":"semetey-1-2013:p0943:b004:l024","ordinal":148151,"en":"There they lay besieging it."},{"id":"semetey-1-2013:p0943:b004:l025","ordinal":148152,"en":"Now let us tell"},{"id":"semetey-1-2013:p0943:b004:l026","ordinal":148153,"en":"The story of dear Churok:"},{"id":"semetey-1-2013:p0943:b004:l028","ordinal":148154,"en":"Finding no hero to marry,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0943:b004:l029","ordinal":148155,"en":"'My father is old, and I am a girl."},{"id":"semetey-1-2013:p0943:b004:l030","ordinal":148156,"en":"If the Jediger come besieging us,"},{"id":"semetey-1-2013:p0943:b004:l031","ordinal":148157,"en":"The moon is dark, the night overcast;"},{"id":"semetey-1-2013:p0943:b004:l032","ordinal":148158,"en":"What will the night bring?' she thought."},{"id":"semetey-1-2013:p0943:b004:l033","ordinal":148159,"en":"'My father is old, and I am a girl."},{"id":"semetey-1-2013:p0943:b004:l034","ordinal":148160,"en":"What will the day bring?' she thought."},{"id":"semetey-1-2013:p0943:b004:l035","ordinal":148161,"en":"'Roaming the whole world,"},{"id":"semetey-1-2013:p0943:b004:l036","ordinal":148162,"en":"Across the entire wide world,"},{"id":"semetey-1-2013:p0943:b004:l037","ordinal":148163,"en":"Finding support on which to rely,"},{"id":"semetey-1-2013:p0943:b004:l038","ordinal":148164,"en":"I myself shall fly about,"},{"id":"semetey-1-2013:p0943:b004:l039","ordinal":148165,"en":"Finding a hero equal to me,"},{"id":"semetey-1-2013:p0944:b003:l001","ordinal":148166,"en":"Finding a lion whom my heart loves,"},{"id":"semetey-1-2013:p0944:b003:l002","ordinal":148167,"en":"Let me unleash turmoil."},{"id":"semetey-1-2013:p0944:b003:l003","ordinal":148168,"en":"Against Kojo, who is besieging us,"},{"id":"semetey-1-2013:p0944:b003:l004","ordinal":148169,"en":"And valorous Toltoi,"},{"id":"semetey-1-2013:p0944:b003:l006","ordinal":148170,"en":"Let me gird my waist,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0944:b003:l007","ordinal":148171,"en":"Let me earnestly seek my equal."},{"id":"semetey-1-2013:p0944:b003:l008","ordinal":148172,"en":"Against the frenzied Kojo and Toltoi,"},{"id":"semetey-1-2013:p0944:b003:l009","ordinal":148173,"en":"Let me take my revenge."},{"id":"semetey-1-2013:p0944:b003:l010","ordinal":148174,"en":"My precious hair, thick as a girth,"},{"id":"semetey-1-2013:p0944:b003:l011","ordinal":148175,"en":"My person has become their prize of dispute."},{"id":"semetey-1-2013:p0944:b003:l012","ordinal":148176,"en":"To Toltoi of the Jediger,"},{"id":"semetey-1-2013:p0944:b003:l013","ordinal":148177,"en":"With what face could I marry him?"},{"id":"semetey-1-2013:p0944:b003:l014","ordinal":148178,"en":"By that lusty brute who has appeared between us,"},{"id":"semetey-1-2013:p0944:b003:l015","ordinal":148179,"en":"Why should I let myself be driven away?"},{"id":"semetey-1-2013:p0944:b003:l016","ordinal":148180,"en":"The decree God has sent"},{"id":"semetey-1-2013:p0944:b003:l017","ordinal":148181,"en":"Is thus; let me face it."},{"id":"semetey-1-2013:p0944:b003:l018","ordinal":148182,"en":"Rather than bow to foolish, wretched Toltoi"},{"id":"semetey-1-2013:p0944:b003:l019","ordinal":148183,"en":"And become his wife,"},{"id":"semetey-1-2013:p0944:b003:l020","ordinal":148184,"en":"Let me die seeking a hero!"},{"id":"semetey-1-2013:p0944:b003:l021","ordinal":148185,"en":"Great Beijing, that distant city,"},{"id":"semetey-1-2013:p0944:b003:l022","ordinal":148186,"en":"Let me go to its farthest end."},{"id":"semetey-1-2013:p0944:b003:l023","ordinal":148187,"en":"With a cotton sash and broad boots,"},{"id":"semetey-1-2013:p0944:b003:l024","ordinal":148188,"en":"Kongurbai, khan of the monks—"},{"id":"semetey-1-2013:p0944:b003:l025","ordinal":148189,"en":"Traversing the face of the earth,"},{"id":"semetey-1-2013:p0944:b003:l026","ordinal":148190,"en":"The giants upon the earth,"},{"id":"semetey-1-2013:p0944:b003:l027","ordinal":148191,"en":"Let me visit every one,"},{"id":"semetey-1-2013:p0944:b003:l028","ordinal":148192,"en":"Finding support on which to rely,"},{"id":"semetey-1-2013:p0944:b003:l029","ordinal":148193,"en":"Finding a famed, mighty lion."},{"id":"semetey-1-2013:p0944:b003:l030","ordinal":148194,"en":"Upon Toltoi, who has gathered an army,"},{"id":"semetey-1-2013:p0944:b003:l031","ordinal":148195,"en":"Let me bring humiliation in this way,"},{"id":"semetey-1-2013:p0944:b003:l032","ordinal":148196,"en":"Beginning by slaughtering his Kojo,"},{"id":"semetey-1-2013:p0944:b003:l033","ordinal":148197,"en":"Let me thus take my revenge."},{"id":"semetey-1-2013:p0944:b003:l034","ordinal":148198,"en":"The four corners of the round world,"},{"id":"semetey-1-2013:p0944:b003:l035","ordinal":148199,"en":"Let me circle them four times;"},{"id":"semetey-1-2013:p0944:b003:l036","ordinal":148200,"en":"The five corners of Medina,"},{"id":"semetey-1-2013:p0944:b003:l037","ordinal":148201,"en":"Let me circle them five times,"},{"id":"semetey-1-2013:p0944:b003:l038","ordinal":148202,"en":"Seeking support in a renowned place,"},{"id":"semetey-1-2013:p0944:b003:l039","ordinal":148203,"en":"Seeking a steadfast lion."},{"id":"semetey-1-2013:p0944:b004:l001","ordinal":148204,"en":"Toltoi, who plays the lord—"},{"id":"semetey-1-2013:p0944:b004:l002","ordinal":148205,"en":"Let me have his head trampled,"},{"id":"semetey-1-2013:p0944:b004:l003","ordinal":148206,"en":"Have his four kinds of livestock scattered,"},{"id":"semetey-1-2013:p0944:b004:l004","ordinal":148207,"en":"Dig their pits deep,"},{"id":"semetey-1-2013:p0944:b004:l005","ordinal":148208,"en":"Bring utter misery upon them."},{"id":"semetey-1-2013:p0944:b004:l006","ordinal":148209,"en":"If I do not have their armies slaughtered,"},{"id":"semetey-1-2013:p0944:b004:l008","ordinal":148210,"en":"Saying this,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0944:b004:l009","ordinal":148211,"en":"Uttering terribly fearsome words,"},{"id":"semetey-1-2013:p0944:b004:l010","ordinal":148212,"en":"Aichurok, daughter of Akun,"},{"id":"semetey-1-2013:p0944:b004:l011","ordinal":148213,"en":"Made herself ready and braced herself."},{"id":"semetey-1-2013:p0944:b004:l012","ordinal":148214,"en":"The wretched girl wept aloud,"},{"id":"semetey-1-2013:p0944:b004:l013","ordinal":148215,"en":"Swaying as though struck by a peri."},{"id":"semetey-1-2013:p0944:b004:l014","ordinal":148216,"en":"Upon her head was a cap made of gold;"},{"id":"semetey-1-2013:p0944:b004:l015","ordinal":148217,"en":"Born into this world,"},{"id":"semetey-1-2013:p0944:b004:l016","ordinal":148218,"en":"Akun's daughter was a wily one."},{"id":"semetey-1-2013:p0944:b004:l017","ordinal":148219,"en":"Her waist a handspan, her face like the moon,"},{"id":"semetey-1-2013:p0944:b004:l018","ordinal":148220,"en":"That ill-fated, renowned beauty."},{"id":"semetey-1-2013:p0944:b004:l019","ordinal":148221,"en":"Dear, fierce Churok—"},{"id":"semetey-1-2013:p0944:b004:l020","ordinal":148222,"en":"Which of her deeds shall we tell?"},{"id":"semetey-1-2013:p0944:b004:l021","ordinal":148223,"en":"Look at sugar, then at her words;"},{"id":"semetey-1-2013:p0944:b004:l022","ordinal":148224,"en":"Look at Venus, then at her eyes."}]
