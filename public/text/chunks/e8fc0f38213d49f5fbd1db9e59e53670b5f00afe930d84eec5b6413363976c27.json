[{"id":"semetey-1-2013:p0135:b003:l004","ordinal":87041,"en":"From your equal, Sultan Manas."},{"id":"semetey-1-2013:p0135:b003:l005","ordinal":87042,"en":"My foal, my child Kanykei,"},{"id":"semetey-1-2013:p0135:b003:l006","ordinal":87043,"en":"You rose to rule from your youth."},{"id":"semetey-1-2013:p0135:b003:l007","ordinal":87044,"en":"A fugitive cannot stand defiant;"},{"id":"semetey-1-2013:p0135:b003:l008","ordinal":87045,"en":"My foal, put that defiance from your mind."},{"id":"semetey-1-2013:p0135:b003:l010","ordinal":87046,"en":"When you stand defiant,"},{"id":"semetey-1-2013:p0135:b003:l011","ordinal":87047,"en":"My child, your nobility is beyond reproach,"},{"id":"semetey-1-2013:p0135:b003:l012","ordinal":87048,"en":"But those who sliced horse-belly fat and served tea,"},{"id":"semetey-1-2013:p0135:b003:l013","ordinal":87049,"en":"Who freely served their food,"},{"id":"semetey-1-2013:p0135:b003:l014","ordinal":87050,"en":"Who never had their fill when asking to eat,"},{"id":"semetey-1-2013:p0135:b003:l015","ordinal":87051,"en":"Who never gave up their greed,"},{"id":"semetey-1-2013:p0135:b003:l016","ordinal":87052,"en":"Who, driven into the darkness,"},{"id":"semetey-1-2013:p0135:b003:l017","ordinal":87053,"en":"Prowled like leopards—"},{"id":"semetey-1-2013:p0135:b003:l018","ordinal":87054,"en":"Kanykei, my child, your noble Kyrgyz people are not here!"},{"id":"semetey-1-2013:p0135:b003:l020","ordinal":87055,"en":"When we reach your father Karakan,"},{"id":"semetey-1-2013:p0135:b003:l021","ordinal":87056,"en":"Let us behave as fugitives;"},{"id":"semetey-1-2013:p0135:b003:l022","ordinal":87057,"en":"Do not stand defiant without cause!"},{"id":"semetey-1-2013:p0135:b003:l023","ordinal":87058,"en":"Until Semetey reaches twelve,"},{"id":"semetey-1-2013:p0135:b003:l024","ordinal":87059,"en":"If they say, ‘Make your home with the Sarts,’"},{"id":"semetey-1-2013:p0135:b003:l025","ordinal":87060,"en":"Let us stay among them."},{"id":"semetey-1-2013:p0135:b003:l026","ordinal":87061,"en":"O Kanykei, my foal,"},{"id":"semetey-1-2013:p0135:b003:l027","ordinal":87062,"en":"Until your orphan reaches twelve,"},{"id":"semetey-1-2013:p0135:b003:l028","ordinal":87063,"en":"In that city of Bukhara"},{"id":"semetey-1-2013:p0135:b003:l029","ordinal":87064,"en":"Let us meekly bend to our lot."},{"id":"semetey-1-2013:p0135:b003:l030","ordinal":87065,"en":"Kanykei, let us leave our former ways."},{"id":"semetey-1-2013:p0135:b003:l032","ordinal":87066,"en":"My foal, until your orphan mounts a horse,"},{"id":"semetey-1-2013:p0135:b003:l033","ordinal":87067,"en":"Let us begin a different manner of life."},{"id":"semetey-1-2013:p0135:b003:l034","ordinal":87068,"en":"If you care to listen, Kanykei,"},{"id":"semetey-1-2013:p0135:b003:l035","ordinal":87069,"en":"Revered Chyiyrdy"},{"id":"semetey-1-2013:p0135:b003:l036","ordinal":87070,"en":"Has words she wishes to say."},{"id":"semetey-1-2013:p0135:b003:l037","ordinal":87071,"en":"Ahead lie Alty-Shaar, Kokand and Margalan;"},{"id":"semetey-1-2013:p0135:b003:l039","ordinal":87072,"en":"Your gray-maned hero humiliated them,"},{"id":"semetey-1-2013:p0135:b003:l040","ordinal":87073,"en":"And these people hold a grudge."},{"id":"semetey-1-2013:p0135:b004:l001","ordinal":87074,"en":"Abandon such haughty speech!"},{"id":"semetey-1-2013:p0135:b004:l003","ordinal":87075,"en":"Until your orphan matures and mounts a horse,"},{"id":"semetey-1-2013:p0135:b004:l004","ordinal":87076,"en":"O Kanykei, my foal,"},{"id":"semetey-1-2013:p0135:b004:l005","ordinal":87077,"en":"Abandon your haughty speech!"},{"id":"semetey-1-2013:p0135:b004:l006","ordinal":87078,"en":"O Kanykei, my foal,"},{"id":"semetey-1-2013:p0135:b004:l007","ordinal":87079,"en":"Begin with gentle words!"},{"id":"semetey-1-2013:p0135:b004:l008","ordinal":87080,"en":"When her husband dies, a woman"},{"id":"semetey-1-2013:p0135:b004:l009","ordinal":87081,"en":"Comes to rest in an ill-suited place."},{"id":"semetey-1-2013:p0135:b004:l010","ordinal":87082,"en":"When a wife loses her khan,"},{"id":"semetey-1-2013:p0135:b004:l011","ordinal":87083,"en":"When her husband dies, to a woman"},{"id":"semetey-1-2013:p0135:b004:l012","ordinal":87084,"en":"Her birth family is nearest."},{"id":"semetey-1-2013:p0135:b004:l013","ordinal":87085,"en":"O my cherished Kanykei,"},{"id":"semetey-1-2013:p0135:b004:l014","ordinal":87086,"en":"This is my counsel, these are my words,"},{"id":"semetey-1-2013:p0135:b004:l015","ordinal":87087,"en":"My revered foal;"},{"id":"semetey-1-2013:p0135:b004:l016","ordinal":87088,"en":"These are your mother's sorrowful words.”"},{"id":"semetey-1-2013:p0135:b004:l018","ordinal":87089,"en":"Hearing this, Kanykei"},{"id":"semetey-1-2013:p0135:b004:l019","ordinal":87090,"en":"Prayed to God."},{"id":"semetey-1-2013:p0135:b004:l020","ordinal":87091,"en":"Putting aside their former thoughts,"},{"id":"semetey-1-2013:p0135:b004:l021","ordinal":87092,"en":"“Amen!” said the two ladies."},{"id":"semetey-1-2013:p0135:b004:l022","ordinal":87093,"en":"The joint of meat left from the two-year-old wether"},{"id":"semetey-1-2013:p0135:b004:l023","ordinal":87094,"en":"They dedicated to Baabedin and ate their fill."},{"id":"semetey-1-2013:p0135:b004:l024","ordinal":87095,"en":"The two ladies gained strength,"},{"id":"semetey-1-2013:p0135:b004:l025","ordinal":87096,"en":"Coughing harshly again and again."},{"id":"semetey-1-2013:p0135:b004:l026","ordinal":87097,"en":"Was he not left by their khan?"},{"id":"semetey-1-2013:p0135:b004:l027","ordinal":87098,"en":"That cradle-infant Semetey"},{"id":"semetey-1-2013:p0135:b004:l028","ordinal":87099,"en":"They took turns carrying,"},{"id":"semetey-1-2013:p0135:b004:l029","ordinal":87100,"en":"And over the saddle of Aman-Jol"},{"id":"semetey-1-2013:p0135:b004:l030","ordinal":87101,"en":"The two ladies went."},{"id":"semetey-1-2013:p0135:b004:l031","ordinal":87102,"en":"Setting their faces toward Bukhara,"},{"id":"semetey-1-2013:p0135:b004:l032","ordinal":87103,"en":"Carrying Semetey,"},{"id":"semetey-1-2013:p0135:b004:l033","ordinal":87104,"en":"The two ladies fled."},{"id":"semetey-1-2013:p0135:b004:l034","ordinal":87105,"en":"To Temir Khan's city"},{"id":"semetey-1-2013:p0135:b004:l035","ordinal":87106,"en":"The two ladies wandered."},{"id":"semetey-1-2013:p0135:b004:l036","ordinal":87107,"en":"There was cradle-infant Semetey;"},{"id":"semetey-1-2013:p0135:b004:l037","ordinal":87108,"en":"There went Kanykei in mourning;"},{"id":"semetey-1-2013:p0135:b004:l038","ordinal":87109,"en":"There went Semetey in flight!"},{"id":"semetey-1-2013:p0135:b004:l039","ordinal":87110,"en":"In some places, for two days"},{"id":"semetey-1-2013:p0136:b003:l001","ordinal":87111,"en":"They went on without staying."},{"id":"semetey-1-2013:p0136:b003:l002","ordinal":87112,"en":"On the face of this earth, the bereft"},{"id":"semetey-1-2013:p0136:b003:l003","ordinal":87113,"en":"Went on, finding no room."},{"id":"semetey-1-2013:p0136:b003:l004","ordinal":87114,"en":"Over ridge after curving ridge"},{"id":"semetey-1-2013:p0136:b003:l005","ordinal":87115,"en":"They kept crossing;"},{"id":"semetey-1-2013:p0136:b003:l006","ordinal":87116,"en":"Toward Bukhara the two ladies"},{"id":"semetey-1-2013:p0136:b003:l007","ordinal":87117,"en":"Kept fleeing."},{"id":"semetey-1-2013:p0136:b003:l008","ordinal":87118,"en":"Many a sloping pass"},{"id":"semetey-1-2013:p0136:b003:l009","ordinal":87119,"en":"They crossed on foot."},{"id":"semetey-1-2013:p0136:b003:l010","ordinal":87120,"en":"By day they walked without rest,"},{"id":"semetey-1-2013:p0136:b003:l011","ordinal":87121,"en":"By night they fled in desperate haste;"},{"id":"semetey-1-2013:p0136:b003:l012","ordinal":87122,"en":"In the wild, spirit-haunted plain"},{"id":"semetey-1-2013:p0136:b003:l013","ordinal":87123,"en":"The two ladies fled alone."},{"id":"semetey-1-2013:p0136:b003:l015","ordinal":87124,"en":"Then your uncle Bakai,"},{"id":"semetey-1-2013:p0136:b003:l016","ordinal":87125,"en":"Your wise and mighty falcon,"},{"id":"semetey-1-2013:p0136:b003:l017","ordinal":87126,"en":"That dear one unlike other men,"},{"id":"semetey-1-2013:p0136:b003:l018","ordinal":87127,"en":"Your old Bakai, never resting,"},{"id":"semetey-1-2013:p0136:b003:l019","ordinal":87128,"en":"The torments of this world—"},{"id":"semetey-1-2013:p0136:b003:l020","ordinal":87129,"en":"Your saint knew them in full."},{"id":"semetey-1-2013:p0136:b003:l021","ordinal":87130,"en":"When his friend Manas was alive,"},{"id":"semetey-1-2013:p0136:b003:l022","ordinal":87131,"en":"Had been a well-built fortress."},{"id":"semetey-1-2013:p0136:b003:l023","ordinal":87132,"en":"That uncle Bakai"},{"id":"semetey-1-2013:p0136:b003:l024","ordinal":87133,"en":"Had been a renowned khan."},{"id":"semetey-1-2013:p0136:b003:l025","ordinal":87134,"en":"Against that uncle Bakai"},{"id":"semetey-1-2013:p0136:b003:l026","ordinal":87135,"en":"No one had dared cause trouble."},{"id":"semetey-1-2013:p0136:b003:l027","ordinal":87136,"en":"In all this vast world,"},{"id":"semetey-1-2013:p0136:b003:l028","ordinal":87137,"en":"None remained to raise a catching-pole against Bakai."},{"id":"semetey-1-2013:p0136:b003:l029","ordinal":87138,"en":"In former days, when they lived in Talas,"},{"id":"semetey-1-2013:p0136:b003:l030","ordinal":87139,"en":"Manas and Bakai had risen as khans;"},{"id":"semetey-1-2013:p0136:b003:l031","ordinal":87140,"en":"At news of them, souls fled bodies."},{"id":"semetey-1-2013:p0136:b003:l032","ordinal":87141,"en":"The heroes turned like lions."},{"id":"semetey-1-2013:p0136:b003:l033","ordinal":87142,"en":"When he heard their great and famous renown,"},{"id":"semetey-1-2013:p0136:b003:l034","ordinal":87143,"en":"Karakan, khan of the khakans,"},{"id":"semetey-1-2013:p0136:b003:l035","ordinal":87144,"en":"Heard it and his heart grew narrow."},{"id":"semetey-1-2013:p0136:b003:l036","ordinal":87145,"en":"His wrath had spread through the world,"},{"id":"semetey-1-2013:p0136:b003:l037","ordinal":87146,"en":"But when the khan of Beijing heard,"},{"id":"semetey-1-2013:p0136:b003:l038","ordinal":87147,"en":"He fell into utter turmoil."},{"id":"semetey-1-2013:p0136:b003:l039","ordinal":87148,"en":"The father of so many people,"},{"id":"semetey-1-2013:p0136:b004:l001","ordinal":87149,"en":"Your magnanimous Manas had died."},{"id":"semetey-1-2013:p0136:b004:l002","ordinal":87150,"en":"For the orphan left behind,"},{"id":"semetey-1-2013:p0136:b004:l003","ordinal":87151,"en":"The hero Bakai suffered anguish."},{"id":"semetey-1-2013:p0136:b004:l004","ordinal":87152,"en":"“A spring in the winding mountains,” he thought,"},{"id":"semetey-1-2013:p0136:b004:l005","ordinal":87153,"en":"“The little one left by my friend."},{"id":"semetey-1-2013:p0136:b004:l006","ordinal":87154,"en":"Without boots, wearing stockings,"},{"id":"semetey-1-2013:p0136:b004:l007","ordinal":87155,"en":"Has Kanykei perhaps died?"},{"id":"semetey-1-2013:p0136:b004:l008","ordinal":87156,"en":"She has no milk to drink for food,"},{"id":"semetey-1-2013:p0136:b004:l009","ordinal":87157,"en":"Nor a horse to ride to Bukhara."},{"id":"semetey-1-2013:p0136:b004:l010","ordinal":87158,"en":"Perhaps disease struck her ribs,"},{"id":"semetey-1-2013:p0136:b004:l011","ordinal":87159,"en":"Perhaps she coughed and died,” he thought."},{"id":"semetey-1-2013:p0136:b004:l012","ordinal":87160,"en":"“Or did one person, carrying two lives,"},{"id":"semetey-1-2013:p0136:b004:l013","ordinal":87161,"en":"My precious child Kanykei,"},{"id":"semetey-1-2013:p0136:b004:l014","ordinal":87162,"en":"Die from carrying them?” he thought."},{"id":"semetey-1-2013:p0136:b004:l015","ordinal":87163,"en":"“Her flanks sunken, her flesh wasted,"},{"id":"semetey-1-2013:p0136:b004:l016","ordinal":87164,"en":"Did she fall ill and die?” he thought."},{"id":"semetey-1-2013:p0136:b004:l017","ordinal":87165,"en":"“My noble child Kanykei,"},{"id":"semetey-1-2013:p0136:b004:l018","ordinal":87166,"en":"Fleeing to Bukhara,"},{"id":"semetey-1-2013:p0136:b004:l019","ordinal":87167,"en":"Did she die from sores?” he thought."},{"id":"semetey-1-2013:p0136:b004:l020","ordinal":87168,"en":"“The sun is so hot that owls do not fly;"},{"id":"semetey-1-2013:p0136:b004:l021","ordinal":87169,"en":"It is a terrible waterless desert."},{"id":"semetey-1-2013:p0136:b004:l022","ordinal":87170,"en":"Crushed by being carried along,"},{"id":"semetey-1-2013:p0136:b004:l023","ordinal":87171,"en":"Meeting many sicknesses,"},{"id":"semetey-1-2013:p0136:b004:l024","ordinal":87172,"en":"Semetey, left by the gray-maned hero—"},{"id":"semetey-1-2013:p0136:b004:l025","ordinal":87173,"en":"Has he become exhausted and breathless?” he thought."},{"id":"semetey-1-2013:p0136:b004:l026","ordinal":87174,"en":"“Ill-willed Kanykei,"},{"id":"semetey-1-2013:p0136:b004:l027","ordinal":87175,"en":"Fleeing on foot to Bukhara,"},{"id":"semetey-1-2013:p0136:b004:l028","ordinal":87176,"en":"Without sleeping upon her elbow,"},{"id":"semetey-1-2013:p0136:b004:l029","ordinal":87177,"en":"Without even a moment's rest,"},{"id":"semetey-1-2013:p0136:b004:l030","ordinal":87178,"en":"My child Kanykei, unable to go on,"},{"id":"semetey-1-2013:p0136:b004:l031","ordinal":87179,"en":"Has she worn herself out?” he thought."},{"id":"semetey-1-2013:p0136:b004:l032","ordinal":87180,"en":"“Alty-Shaar and the khan of Kokand,"},{"id":"semetey-1-2013:p0136:b004:l033","ordinal":87181,"en":"Margalan below,"},{"id":"semetey-1-2013:p0136:b004:l034","ordinal":87182,"en":"Samarkand above—"},{"id":"semetey-1-2013:p0136:b004:l035","ordinal":87183,"en":"They had many raiding warriors."},{"id":"semetey-1-2013:p0136:b004:l036","ordinal":87184,"en":"Has my child met them and died?” he thought."},{"id":"semetey-1-2013:p0136:b004:l038","ordinal":87185,"en":"“Meeting them and performing deeds of valor,"},{"id":"semetey-1-2013:p0136:b004:l039","ordinal":87186,"en":"Has my child died in a frenzy?” he thought."},{"id":"semetey-1-2013:p0137:b003:l001","ordinal":87187,"en":"Your uncle, the leopard Bakai,"},{"id":"semetey-1-2013:p0137:b003:l002","ordinal":87188,"en":"Unable to remain still for grief,"},{"id":"semetey-1-2013:p0137:b003:l003","ordinal":87189,"en":"Taking a palm-sized letter"},{"id":"semetey-1-2013:p0137:b003:l004","ordinal":87190,"en":"About the distant widow,"},{"id":"semetey-1-2013:p0137:b003:l005","ordinal":87191,"en":"About Semetey, left by his friend,"},{"id":"semetey-1-2013:p0137:b003:l007","ordinal":87192,"en":"Had taken two well-fed horses,"},{"id":"semetey-1-2013:p0137:b003:l008","ordinal":87193,"en":"Made his purpose known,"},{"id":"semetey-1-2013:p0137:b003:l009","ordinal":87194,"en":"Saying, “I shall sacrifice to Baabedin;"},{"id":"semetey-1-2013:p0137:b003:l010","ordinal":87195,"en":"I shall set my children on their road.”"},{"id":"semetey-1-2013:p0137:b003:l011","ordinal":87196,"en":"He was carrying before him on the saddle"},{"id":"semetey-1-2013:p0137:b003:l012","ordinal":87197,"en":"That two-year-old wether of Bolokbai's."},{"id":"semetey-1-2013:p0137:b003:l013","ordinal":87198,"en":"Alas, so many worries would not fit inside his breast."},{"id":"semetey-1-2013:p0137:b003:l015","ordinal":87199,"en":"“The orphan left me by the gray-maned hero"},{"id":"semetey-1-2013:p0137:b003:l016","ordinal":87200,"en":"Will vanish from sight,” he thought;"},{"id":"semetey-1-2013:p0137:b003:l017","ordinal":87201,"en":"Bakai's tears streamed in every direction."},{"id":"semetey-1-2013:p0137:b003:l018","ordinal":87202,"en":"In the sky Allah's sun grew clouded;"},{"id":"semetey-1-2013:p0137:b003:l019","ordinal":87203,"en":"Upon the hero Bakai's head,"},{"id":"semetey-1-2013:p0137:b003:l020","ordinal":87204,"en":"Alas, sixty worries came at once."},{"id":"semetey-1-2013:p0137:b003:l022","ordinal":87205,"en":"His heart was grievously torn."},{"id":"semetey-1-2013:p0137:b003:l023","ordinal":87206,"en":"“My gray-maned Manas, do not die,” he said;"},{"id":"semetey-1-2013:p0137:b003:l024","ordinal":87207,"en":"Bakai's tears poured down:"},{"id":"semetey-1-2013:p0137:b003:l025","ordinal":87208,"en":"“Alas, Manas, remain alive!"},{"id":"semetey-1-2013:p0137:b003:l026","ordinal":87209,"en":"My burden-bearing Buraq"},{"id":"semetey-1-2013:p0137:b003:l027","ordinal":87210,"en":"Is fleeing to Bukhara—"},{"id":"semetey-1-2013:p0137:b003:l028","ordinal":87211,"en":"Semetey, the lamp I gained after mortal anguish."},{"id":"semetey-1-2013:p0137:b003:l030","ordinal":87212,"en":"Kanykei, left by Manas,"},{"id":"semetey-1-2013:p0137:b003:l031","ordinal":87213,"en":"Is the shelter over my head."},{"id":"semetey-1-2013:p0137:b003:l032","ordinal":87214,"en":"Ninety-year-old Chyiyrdy—"},{"id":"semetey-1-2013:p0137:b003:l033","ordinal":87215,"en":"Seeing her sets my heart at rest;"},{"id":"semetey-1-2013:p0137:b003:l034","ordinal":87216,"en":"My mother is my good fortune."},{"id":"semetey-1-2013:p0137:b003:l035","ordinal":87217,"en":"Weeping in the desert, leading horses,"},{"id":"semetey-1-2013:p0137:b003:l036","ordinal":87218,"en":"Was I to be left like this?"},{"id":"semetey-1-2013:p0137:b003:l037","ordinal":87219,"en":"When the leopard Manas died,"},{"id":"semetey-1-2013:p0137:b003:l038","ordinal":87220,"en":"Fleeing and wandering to Bukhara,"},{"id":"semetey-1-2013:p0137:b003:l039","ordinal":87221,"en":"Was she a wretch meant to go on foot?”"},{"id":"semetey-1-2013:p0137:b005:l001","ordinal":87222,"en":"Then your uncle Bakai,"},{"id":"semetey-1-2013:p0137:b005:l002","ordinal":87223,"en":"Thinking, “She will enter Samarkand,”"},{"id":"semetey-1-2013:p0137:b005:l003","ordinal":87224,"en":"Hurrying, fretting, beside himself,"},{"id":"semetey-1-2013:p0137:b005:l004","ordinal":87225,"en":"Across the roaring Syr-Darya"},{"id":"semetey-1-2013:p0137:b005:l005","ordinal":87226,"en":"Your gray-maned hero waded."},{"id":"semetey-1-2013:p0137:b005:l006","ordinal":87227,"en":"That Kara-Ungkur where he had shot the wild sheep"},{"id":"semetey-1-2013:p0137:b005:l007","ordinal":87228,"en":"Was the very cave where Kanykei had stayed."},{"id":"semetey-1-2013:p0137:b005:l008","ordinal":87229,"en":"“For her provisions Kanykei"},{"id":"semetey-1-2013:p0137:b005:l009","ordinal":87230,"en":"Had taken the wild sheep's meat."},{"id":"semetey-1-2013:p0137:b005:l010","ordinal":87231,"en":"Saying, ‘I shall sustain myself for six days,’"},{"id":"semetey-1-2013:p0137:b005:l011","ordinal":87232,"en":"She had given her promise."},{"id":"semetey-1-2013:p0137:b005:l012","ordinal":87233,"en":"Though a woman, Kanykei"},{"id":"semetey-1-2013:p0137:b005:l013","ordinal":87234,"en":"Was a soul the equal of any warrior."},{"id":"semetey-1-2013:p0137:b005:l014","ordinal":87235,"en":"In Kanykei's care"},{"id":"semetey-1-2013:p0137:b005:l015","ordinal":87236,"en":"Was the only child Semetey."},{"id":"semetey-1-2013:p0137:b005:l016","ordinal":87237,"en":"My poor mother Chyiyrdy,"},{"id":"semetey-1-2013:p0137:b005:l017","ordinal":87238,"en":"Now that she had grown old,"},{"id":"semetey-1-2013:p0137:b005:l018","ordinal":87239,"en":"Was a soul like a prophet."},{"id":"semetey-1-2013:p0137:b005:l019","ordinal":87240,"en":"Saying, ‘I shall come in seven days,’"},{"id":"semetey-1-2013:p0137:b005:l020","ordinal":87241,"en":"Before my mother"},{"id":"semetey-1-2013:p0137:b005:l021","ordinal":87242,"en":"I had made a solemn promise."},{"id":"semetey-1-2013:p0137:b005:l022","ordinal":87243,"en":"In the cave where I left him in trust,"},{"id":"semetey-1-2013:p0137:b005:l023","ordinal":87244,"en":"Let me see my orphan."},{"id":"semetey-1-2013:p0137:b005:l024","ordinal":87245,"en":"This Taitoru and Akborchuk"},{"id":"semetey-1-2013:p0137:b005:l025","ordinal":87246,"en":"Let me entrust to the bereft.”"},{"id":"semetey-1-2013:p0137:b005:l027","ordinal":87247,"en":"When he rode up to the cave,"},{"id":"semetey-1-2013:p0137:b005:l028","ordinal":87248,"en":"The ram's meat hung inside."},{"id":"semetey-1-2013:p0137:b005:l029","ordinal":87249,"en":"Then wretched Kanykei—"},{"id":"semetey-1-2013:p0137:b005:l030","ordinal":87250,"en":"It was clear that she had fled."},{"id":"semetey-1-2013:p0137:b005:l031","ordinal":87251,"en":"In the depths of that cave,"},{"id":"semetey-1-2013:p0137:b005:l032","ordinal":87252,"en":"The wild sheep's meat was hanging;"},{"id":"semetey-1-2013:p0137:b005:l033","ordinal":87253,"en":"It was clear that the leopard Kanykei was gone."},{"id":"semetey-1-2013:p0137:b005:l035","ordinal":87254,"en":"“My magnanimous Manas, remain alive;"},{"id":"semetey-1-2013:p0137:b005:l036","ordinal":87255,"en":"Bakai, may you never see such torment!"},{"id":"semetey-1-2013:p0137:b005:l037","ordinal":87256,"en":"When I was away six days,"},{"id":"semetey-1-2013:p0137:b005:l038","ordinal":87257,"en":"Did they trample upon my orphan's head?"},{"id":"semetey-1-2013:p0137:b005:l039","ordinal":87258,"en":"The enemies with deep grudges,"},{"id":"semetey-1-2013:p0138:b003:l001","ordinal":87259,"en":"Have they taken the orphan and widow"},{"id":"semetey-1-2013:p0138:b003:l002","ordinal":87260,"en":"As booty and gone back?"},{"id":"semetey-1-2013:p0138:b003:l003","ordinal":87261,"en":"Have they brought them to their end?"},{"id":"semetey-1-2013:p0138:b003:l004","ordinal":87262,"en":"Have my mother and Semetey"},{"id":"semetey-1-2013:p0138:b003:l005","ordinal":87263,"en":"Fallen captive?"},{"id":"semetey-1-2013:p0138:b003:l006","ordinal":87264,"en":"My Buraq, saddled and ready,"},{"id":"semetey-1-2013:p0138:b003:l007","ordinal":87265,"en":"Alas upon alas, Semetey,"},{"id":"semetey-1-2013:p0138:b003:l008","ordinal":87266,"en":"My little one left forlorn!"},{"id":"semetey-1-2013:p0138:b003:l009","ordinal":87267,"en":"Has your good fortune broken now?"},{"id":"semetey-1-2013:p0138:b003:l010","ordinal":87268,"en":"Alas, has God utterly struck you down?"},{"id":"semetey-1-2013:p0138:b003:l011","ordinal":87269,"en":"My spring flowing through the valley,"},{"id":"semetey-1-2013:p0138:b003:l012","ordinal":87270,"en":"Semetey, my little one whom I cradled!"},{"id":"semetey-1-2013:p0138:b003:l013","ordinal":87271,"en":"When they call me white-bearded Bakai,"},{"id":"semetey-1-2013:p0138:b003:l014","ordinal":87272,"en":"Alas, I wish to die of shame."},{"id":"semetey-1-2013:p0138:b003:l015","ordinal":87273,"en":"That I live and do not die"},{"id":"semetey-1-2013:p0138:b003:l016","ordinal":87274,"en":"Is, alas, because Semetey exists."},{"id":"semetey-1-2013:p0138:b003:l017","ordinal":87275,"en":"My reed-like plant growing in the valley,"},{"id":"semetey-1-2013:p0138:b003:l018","ordinal":87276,"en":"Alas, where has my only one gone?"},{"id":"semetey-1-2013:p0138:b003:l019","ordinal":87277,"en":"This world is a trader;"},{"id":"semetey-1-2013:p0138:b003:l020","ordinal":87278,"en":"I knew its falsehood long ago."},{"id":"semetey-1-2013:p0138:b003:l021","ordinal":87279,"en":"Semetey, left by my friend—"},{"id":"semetey-1-2013:p0138:b003:l022","ordinal":87280,"en":"Thinking, ‘May my only one live safely,’"},{"id":"semetey-1-2013:p0138:b003:l023","ordinal":87281,"en":"I have taken him as my support."},{"id":"semetey-1-2013:p0138:b003:l024","ordinal":87282,"en":"For his life I led the horses;"},{"id":"semetey-1-2013:p0138:b003:l025","ordinal":87283,"en":"The suffering I have endured"},{"id":"semetey-1-2013:p0138:b003:l026","ordinal":87284,"en":"Is for the one child Semetey!"},{"id":"semetey-1-2013:p0138:b003:l027","ordinal":87285,"en":"Be no cave—sink into the earth!"},{"id":"semetey-1-2013:p0138:b003:l028","ordinal":87286,"en":"Why did I ever turn to the cave?"},{"id":"semetey-1-2013:p0138:b003:l029","ordinal":87287,"en":"Thinking to make the cave a refuge,"},{"id":"semetey-1-2013:p0138:b003:l030","ordinal":87288,"en":"I lost my only one."},{"id":"semetey-1-2013:p0138:b003:l031","ordinal":87289,"en":"Perish together with your mountain!"},{"id":"semetey-1-2013:p0138:b003:l032","ordinal":87290,"en":"Why did I turn to that mountain?"},{"id":"semetey-1-2013:p0138:b003:l033","ordinal":87291,"en":"Thinking to make the mountain my shelter,"},{"id":"semetey-1-2013:p0138:b003:l034","ordinal":87292,"en":"I lost my only orphan."},{"id":"semetey-1-2013:p0138:b003:l035","ordinal":87293,"en":"I was a khan; my life has become wretched."},{"id":"semetey-1-2013:p0138:b003:l036","ordinal":87294,"en":"Chyiyrdy, whom I took as my support,"},{"id":"semetey-1-2013:p0138:b003:l037","ordinal":87295,"en":"Mother, I have lost you."},{"id":"semetey-1-2013:p0138:b003:l038","ordinal":87296,"en":"Having lost you, mother,"}]
