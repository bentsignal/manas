[{"id":"seytek-2012:p0102:b002:l034","ordinal":302849,"en":"Just you wait, brave Kyyaz!"},{"id":"seytek-2012:p0102:b002:l035","ordinal":302850,"en":"Because of you, brave Kyyaz,"},{"id":"seytek-2012:p0102:b002:l036","ordinal":302851,"en":"If I do not don my white-swan plumage,"},{"id":"seytek-2012:p0102:b002:l037","ordinal":302852,"en":"If I do not soar through the sky,"},{"id":"seytek-2012:p0102:b002:l038","ordinal":302853,"en":"If I do not destroy you utterly,"},{"id":"seytek-2012:p0102:b002:l039","ordinal":302854,"en":"If I do not muster my father Akun’s army—"},{"id":"seytek-2012:p0102:b002:l040","ordinal":302855,"en":"Drawing my bow till arrows rain down—"},{"id":"seytek-2012:p0102:b003:l001","ordinal":302856,"en":"Why have I not seized and slaughtered him already?"},{"id":"seytek-2012:p0102:b003:l002","ordinal":302857,"en":"This slave’s appointed death has come;"},{"id":"seytek-2012:p0102:b003:l003","ordinal":302858,"en":"Now I shall take his head,"},{"id":"seytek-2012:p0102:b003:l004","ordinal":302859,"en":"Drag him along the road,"},{"id":"seytek-2012:p0102:b003:l005","ordinal":302860,"en":"And hand him over to the Dangyts!"},{"id":"seytek-2012:p0102:b003:l006","ordinal":302861,"en":"I shall gouge out his glaring eyes"},{"id":"seytek-2012:p0102:b003:l007","ordinal":302862,"en":"And slaughter the rabid slave!”"},{"id":"seytek-2012:p0102:b003:l008","ordinal":302863,"en":"Saying this, brave Kyyaz"},{"id":"seytek-2012:p0102:b003:l009","ordinal":302864,"en":"Seized his black-edged battle-axe"},{"id":"seytek-2012:p0102:b003:l010","ordinal":302865,"en":"And swung it around;"},{"id":"seytek-2012:p0102:b003:l011","ordinal":302866,"en":"He struck down Choro,"},{"id":"seytek-2012:p0102:b003:l012","ordinal":302867,"en":"The hero favored by fortune."},{"id":"seytek-2012:p0102:b003:l013","ordinal":302868,"en":"When mighty Kyyaz struck,"},{"id":"seytek-2012:p0102:b003:l014","ordinal":302869,"en":"His strength failed and his body weakened,"},{"id":"seytek-2012:p0102:b003:l015","ordinal":302870,"en":"And brave Choro fell."},{"id":"seytek-2012:p0102:b003:l016","ordinal":302871,"en":"Before Khan Kyyaz,"},{"id":"seytek-2012:p0102:b003:l017","ordinal":302872,"en":"The powerless Choro collapsed;"},{"id":"seytek-2012:p0102:b003:l018","ordinal":302873,"en":"All his ribs"},{"id":"seytek-2012:p0102:b003:l019","ordinal":302874,"en":"Were shattered by the blows."},{"id":"seytek-2012:p0102:b003:l020","ordinal":302875,"en":"Grunting, Kyyaz kicked him"},{"id":"seytek-2012:p0102:b003:l021","ordinal":302876,"en":"And tortured Choro."},{"id":"seytek-2012:p0102:b003:l022","ordinal":302877,"en":"As brave Kyyaz, son of Bagysh,"},{"id":"seytek-2012:p0102:b003:l023","ordinal":302878,"en":"Was about to show his might,"},{"id":"seytek-2012:p0102:b003:l024","ordinal":302879,"en":"And was about to cut off"},{"id":"seytek-2012:p0102:b003:l025","ordinal":302880,"en":"The unconscious Choro’s head,"},{"id":"seytek-2012:p0102:b003:l026","ordinal":302881,"en":"Aichürök, the lady in the palace,"},{"id":"seytek-2012:p0102:b003:l027","ordinal":302882,"en":"Heard the newcomers say"},{"id":"seytek-2012:p0102:b003:l028","ordinal":302883,"en":"That Almambet’s Choro"},{"id":"seytek-2012:p0102:b003:l029","ordinal":302884,"en":"Was being killed"},{"id":"seytek-2012:p0102:b003:l030","ordinal":302885,"en":"By Khan Kyyaz before their eyes."},{"id":"seytek-2012:p0102:b003:l031","ordinal":302886,"en":"Her heart sank and broke;"},{"id":"seytek-2012:p0102:b003:l032","ordinal":302887,"en":"Your sister-in-law’s tears poured forth."},{"id":"seytek-2012:p0102:b003:l033","ordinal":302888,"en":"From her quail-like eyes,"},{"id":"seytek-2012:p0102:b003:l034","ordinal":302889,"en":"Tears fell one after another;"},{"id":"seytek-2012:p0102:b003:l035","ordinal":302890,"en":"From her blackcurrant-dark eyes,"},{"id":"seytek-2012:p0102:b003:l036","ordinal":302891,"en":"Streams of tears fell a whip’s length."},{"id":"seytek-2012:p0102:b003:l037","ordinal":302892,"en":"Unable to stop her running nose,"},{"id":"seytek-2012:p0102:b003:l038","ordinal":302893,"en":"Unable to wipe away her tears,"},{"id":"seytek-2012:p0102:b003:l039","ordinal":302894,"en":"She burst into piercing cries"},{"id":"seytek-2012:p0102:b003:l040","ordinal":302895,"en":"And wailed in bitter anguish."},{"id":"seytek-2012:p0103:b002:l001","ordinal":302896,"en":"Brave Kyyaz laughed mockingly,"},{"id":"seytek-2012:p0103:b002:l002","ordinal":302897,"en":"And now he set aside his anger,"},{"id":"seytek-2012:p0103:b002:l003","ordinal":302898,"en":"Then Aichürök said:"},{"id":"seytek-2012:p0103:b002:l004","ordinal":302899,"en":"“Ignorant Kyyaz, hear my words!"},{"id":"seytek-2012:p0103:b002:l005","ordinal":302900,"en":"No racehorse has flawless hooves,"},{"id":"seytek-2012:p0103:b002:l006","ordinal":302901,"en":"No falcon has flawless wings."},{"id":"seytek-2012:p0103:b002:l007","ordinal":302902,"en":"If you carry on like this, Kyyaz,"},{"id":"seytek-2012:p0103:b002:l008","ordinal":302903,"en":"If I do not flood your home,"},{"id":"seytek-2012:p0103:b002:l009","ordinal":302904,"en":"Just wait, accursed Kyyaz—"},{"id":"seytek-2012:p0103:b002:l010","ordinal":302905,"en":"If I live, one day I shall bring you down!"},{"id":"seytek-2012:p0103:b002:l011","ordinal":302906,"en":"When costly crimson cloth"},{"id":"seytek-2012:p0103:b002:l012","ordinal":302907,"en":"Is torn at the hem, it does not unravel;"},{"id":"seytek-2012:p0103:b002:l013","ordinal":302908,"en":"Once you fall into Kyrgyz hands,"},{"id":"seytek-2012:p0103:b002:l014","ordinal":302909,"en":"You will not even dare look back."},{"id":"seytek-2012:p0103:b002:l015","ordinal":302910,"en":"If my father Akun has no means,"},{"id":"seytek-2012:p0103:b002:l016","ordinal":302911,"en":"If I do not pursue you and prove my words,"},{"id":"seytek-2012:p0103:b002:l017","ordinal":302912,"en":"If I do not soar thunderously, seeking warriors,"},{"id":"seytek-2012:p0103:b002:l018","ordinal":302913,"en":"If I do not range across the earth,"},{"id":"seytek-2012:p0103:b002:l019","ordinal":302914,"en":"If I do not gather men from passes"},{"id":"seytek-2012:p0103:b002:l020","ordinal":302915,"en":"High as towering cliffs,"},{"id":"seytek-2012:p0103:b002:l021","ordinal":302916,"en":"If I do not gather lions"},{"id":"seytek-2012:p0103:b002:l022","ordinal":302917,"en":"Who have subdued the whole wide world—"},{"id":"seytek-2012:p0103:b002:l023","ordinal":302918,"en":"Was your heart not content, taking captives,"},{"id":"seytek-2012:p0103:b002:l024","ordinal":302919,"en":"Humiliating them and gathering slaves?"},{"id":"seytek-2012:p0103:b002:l025","ordinal":302920,"en":"Had you no other maidservant or slave but us?"},{"id":"seytek-2012:p0103:b002:l026","ordinal":302921,"en":"Since time beyond remembering,"},{"id":"seytek-2012:p0103:b002:l027","ordinal":302922,"en":"You have barred your way with iron,"},{"id":"seytek-2012:p0103:b002:l028","ordinal":302923,"en":"Slaughtered nations in your wrath—"},{"id":"seytek-2012:p0103:b002:l029","ordinal":302924,"en":"Why have you subjected us to such disgrace?"},{"id":"seytek-2012:p0103:b002:l030","ordinal":302925,"en":"You smirk and fawn, brave Kyyaz;"},{"id":"seytek-2012:p0103:b002:l031","ordinal":302926,"en":"Can good come to one who strikes a slave?"},{"id":"seytek-2012:p0103:b002:l032","ordinal":302927,"en":"You have done the vilest of all deeds for a warrior;"},{"id":"seytek-2012:p0103:b002:l033","ordinal":302928,"en":"Can a hero truly be like you?”"},{"id":"seytek-2012:p0103:b002:l034","ordinal":302929,"en":"With a handspan waist and moonlike face,"},{"id":"seytek-2012:p0103:b002:l035","ordinal":302930,"en":"Your renowned sister-in-law Chürök"},{"id":"seytek-2012:p0103:b002:l036","ordinal":302931,"en":"Showed her heroic mettle;"},{"id":"seytek-2012:p0103:b002:l037","ordinal":302932,"en":"She separated him from Kyyaz"},{"id":"seytek-2012:p0103:b002:l038","ordinal":302933,"en":"And brought the helpless Choro"},{"id":"seytek-2012:p0103:b002:l039","ordinal":302934,"en":"Inside the white pavilion."},{"id":"seytek-2012:p0103:b002:l040","ordinal":302935,"en":"“When I enter the white pavilion,"},{"id":"seytek-2012:p0103:b003:l001","ordinal":302936,"en":"If I do not shoot arrows like hail"},{"id":"seytek-2012:p0103:b003:l002","ordinal":302937,"en":"And utterly destroy your host!"},{"id":"seytek-2012:p0103:b003:l003","ordinal":302938,"en":"If I do not cast your troops into hell,"},{"id":"seytek-2012:p0103:b003:l004","ordinal":302939,"en":"If I do not take my vengeance without pause,"},{"id":"seytek-2012:p0103:b003:l005","ordinal":302940,"en":"If I do not bring slaughter upon your borders,"},{"id":"seytek-2012:p0103:b003:l006","ordinal":302941,"en":"If I do not cut off your head with my sword!"},{"id":"seytek-2012:p0103:b003:l007","ordinal":302942,"en":"If I do not reap your green grain,"},{"id":"seytek-2012:p0103:b003:l008","ordinal":302943,"en":"If I do not ravage your entire village!"},{"id":"seytek-2012:p0103:b003:l009","ordinal":302944,"en":"If I do not rally my father Khan Akun’s army,"},{"id":"seytek-2012:p0103:b003:l010","ordinal":302945,"en":"Make bows rain like a storm,"},{"id":"seytek-2012:p0103:b003:l011","ordinal":302946,"en":"And arrows fall like hail—"},{"id":"seytek-2012:p0103:b003:l012","ordinal":302947,"en":"Should you die, brave Kyyaz,"},{"id":"seytek-2012:p0103:b003:l013","ordinal":302948,"en":"If I do not unleash open war"},{"id":"seytek-2012:p0103:b003:l014","ordinal":302949,"en":"And slaughter your settled people!"},{"id":"seytek-2012:p0103:b003:l015","ordinal":302950,"en":"If I do not bring calamity upon your head,"},{"id":"seytek-2012:p0103:b003:l016","ordinal":302951,"en":"Whatever your last wish, brave Kyyaz,"},{"id":"seytek-2012:p0103:b003:l017","ordinal":302952,"en":"If I do not exact my vengeance upon you!"},{"id":"seytek-2012:p0103:b003:l018","ordinal":302953,"en":"If I do not summon Akun’s people"},{"id":"seytek-2012:p0103:b003:l019","ordinal":302954,"en":"And have your giant bound,"},{"id":"seytek-2012:p0103:b003:l020","ordinal":302955,"en":"I shall draw out, brave Kyyaz,"},{"id":"seytek-2012:p0103:b003:l021","ordinal":302956,"en":"All your long-stored bitterness!”"},{"id":"seytek-2012:p0103:b003:l022","ordinal":302957,"en":"Chürök, daughter of Akun,"},{"id":"seytek-2012:p0103:b003:l023","ordinal":302958,"en":"The moon-faced woman of tumult,"},{"id":"seytek-2012:p0103:b003:l024","ordinal":302959,"en":"A champion among women,"},{"id":"seytek-2012:p0103:b003:l025","ordinal":302960,"en":"A heroic tigress,"},{"id":"seytek-2012:p0103:b003:l026","ordinal":302961,"en":"Your fierce and precious sister-in-law—"},{"id":"seytek-2012:p0103:b003:l027","ordinal":302962,"en":"Can any woman surpass her?"},{"id":"seytek-2012:p0103:b003:l028","ordinal":302963,"en":"Such was your fierce sister-in-law;"},{"id":"seytek-2012:p0103:b003:l029","ordinal":302964,"en":"Can any female surpass her?"},{"id":"seytek-2012:p0103:b003:l030","ordinal":302965,"en":"When brave Kyyaz heard this,"},{"id":"seytek-2012:p0103:b003:l031","ordinal":302966,"en":"His very ribs quaked."},{"id":"seytek-2012:p0103:b003:l032","ordinal":302967,"en":"“A woman will do what she threatens,” he thought,"},{"id":"seytek-2012:p0103:b003:l033","ordinal":302968,"en":"“She may do all manner of things.”"},{"id":"seytek-2012:p0103:b003:l034","ordinal":302969,"en":"Then Kyyaz said:"},{"id":"seytek-2012:p0103:b003:l035","ordinal":302970,"en":"“Incorrigible Chürök, you will never mend;"},{"id":"seytek-2012:p0103:b003:l036","ordinal":302971,"en":"Since time beyond remembering,"},{"id":"seytek-2012:p0103:b003:l037","ordinal":302972,"en":"You have never curbed your daring."},{"id":"seytek-2012:p0103:b003:l038","ordinal":302973,"en":"I would put an end to this,"},{"id":"seytek-2012:p0103:b003:l039","ordinal":302974,"en":"Were you not moonlike Chürök,"},{"id":"seytek-2012:p0103:b003:l040","ordinal":302975,"en":"And I would kill your slave!”"},{"id":"seytek-2012:p0104:b002:l001","ordinal":302976,"en":"His heart was torn apart,"},{"id":"seytek-2012:p0104:b002:l002","ordinal":302977,"en":"And tears poured from his eyes;"},{"id":"seytek-2012:p0104:b002:l003","ordinal":302978,"en":"Taken captive and disgraced,"},{"id":"seytek-2012:p0104:b002:l004","ordinal":302979,"en":"He longed desperately"},{"id":"seytek-2012:p0104:b002:l005","ordinal":302980,"en":"To see the afflicted Choro just once."},{"id":"seytek-2012:p0104:b002:l006","ordinal":302981,"en":"Serving as a bondmaid,"},{"id":"seytek-2012:p0104:b002:l007","ordinal":302982,"en":"Passing his days in slavery,"},{"id":"seytek-2012:p0104:b002:l008","ordinal":302983,"en":"His hands secured and bound,"},{"id":"seytek-2012:p0104:b002:l009","ordinal":302984,"en":"He suffered humiliation and lamented;"},{"id":"seytek-2012:p0104:b002:l010","ordinal":302985,"en":"His senses failed and all turned dark,"},{"id":"seytek-2012:p0104:b002:l011","ordinal":302986,"en":"And his days became unbearable torment."},{"id":"seytek-2012:p0104:b002:l012","ordinal":302987,"en":"Kyyaz thundered in his might,"},{"id":"seytek-2012:p0104:b002:l013","ordinal":302988,"en":"While wretched Külchoro was humiliated;"},{"id":"seytek-2012:p0104:b002:l014","ordinal":302989,"en":"He had fallen into an iron cage"},{"id":"seytek-2012:p0104:b002:l015","ordinal":302990,"en":"And endured a sea of misery."},{"id":"seytek-2012:p0104:b002:l016","ordinal":302991,"en":"Brave Kyyaz of the Jediger"},{"id":"seytek-2012:p0104:b002:l017","ordinal":302992,"en":"Had become a deep-dug pit for him;"},{"id":"seytek-2012:p0104:b002:l018","ordinal":302993,"en":"Grieving, unable to find a way out,"},{"id":"seytek-2012:p0104:b002:l019","ordinal":302994,"en":"Külchoro remained there,"},{"id":"seytek-2012:p0104:b002:l020","ordinal":302995,"en":"Deprived of all six faculties."},{"id":"seytek-2012:p0104:b002:l021","ordinal":302996,"en":"Once Choro had been mighty,"},{"id":"seytek-2012:p0104:b002:l022","ordinal":302997,"en":"But such was this calamitous horror"},{"id":"seytek-2012:p0104:b002:l023","ordinal":302998,"en":"That might gave way to his disgrace."},{"id":"seytek-2012:p0104:b002:l024","ordinal":302999,"en":"Though he said, “Let me die,” he could not;"},{"id":"seytek-2012:p0104:b002:l025","ordinal":303000,"en":"He could not take his own life."},{"id":"seytek-2012:p0104:b002:l026","ordinal":303001,"en":"He lived his days in slavery"},{"id":"seytek-2012:p0104:b002:l027","ordinal":303002,"en":"And drank the bitter water of anguish;"},{"id":"seytek-2012:p0104:b002:l028","ordinal":303003,"en":"His strength failed and left him helpless,"},{"id":"seytek-2012:p0104:b002:l029","ordinal":303004,"en":"His former thunderous fury gone,"},{"id":"seytek-2012:p0104:b002:l030","ordinal":303005,"en":"And he remained staring in supplication."},{"id":"seytek-2012:p0104:b002:l031","ordinal":303006,"en":"Had that Choro not come,"},{"id":"seytek-2012:p0104:b002:l032","ordinal":303007,"en":"The true order would never have returned."},{"id":"seytek-2012:p0104:b002:l033","ordinal":303008,"en":"The destined hour had come:"},{"id":"seytek-2012:p0104:b002:l034","ordinal":303009,"en":"Implacable death had reached Külchoro,"},{"id":"seytek-2012:p0104:b002:l035","ordinal":303010,"en":"And it was time for him to die."},{"id":"seytek-2012:p0104:b002:l036","ordinal":303011,"en":"Choro’s beauty had faded;"},{"id":"seytek-2012:p0104:b002:l037","ordinal":303012,"en":"His eyes stared wildly,"},{"id":"seytek-2012:p0104:b002:l038","ordinal":303013,"en":"His legs hung limp,"},{"id":"seytek-2012:p0104:b002:l039","ordinal":303014,"en":"And his living soul cried out."},{"id":"seytek-2012:p0104:b003:l001","ordinal":303015,"en":"His abundant, jewel-bright courage"},{"id":"seytek-2012:p0104:b003:l002","ordinal":303016,"en":"Had wholly shattered and fled;"},{"id":"seytek-2012:p0104:b003:l003","ordinal":303017,"en":"His vigor was spent and his strength gone."},{"id":"seytek-2012:p0104:b003:l004","ordinal":303018,"en":"Against Kyyaz, son of Bagysh,"},{"id":"seytek-2012:p0104:b003:l005","ordinal":303019,"en":"He had no deed left to attempt;"},{"id":"seytek-2012:p0104:b003:l006","ordinal":303020,"en":"He scarcely seemed alive."},{"id":"seytek-2012:p0104:b003:l007","ordinal":303021,"en":"Choro, champion of the world,"},{"id":"seytek-2012:p0104:b003:l008","ordinal":303022,"en":"Had no strength to act against Kyyaz."},{"id":"seytek-2012:p0104:b003:l009","ordinal":303023,"en":"Once Külchoro"},{"id":"seytek-2012:p0104:b003:l010","ordinal":303024,"en":"Had been a lion favored by fortune,"},{"id":"seytek-2012:p0104:b003:l011","ordinal":303025,"en":"Thick-armed and stone-hearted,"},{"id":"seytek-2012:p0104:b003:l012","ordinal":303026,"en":"Powerfully built and fierce of face—"},{"id":"seytek-2012:p0104:b003:l013","ordinal":303027,"en":"Such a warrior he had been."},{"id":"seytek-2012:p0104:b003:l014","ordinal":303028,"en":"Now he yellowed with wasting sickness;"},{"id":"seytek-2012:p0104:b003:l015","ordinal":303029,"en":"His destined hour had come."},{"id":"seytek-2012:p0104:b003:l016","ordinal":303030,"en":"After enduring countless torments,"},{"id":"seytek-2012:p0104:b003:l017","ordinal":303031,"en":"It was time for Külchoro to die."},{"id":"seytek-2012:p0104:b003:l018","ordinal":303032,"en":"His black-collared felt coat"},{"id":"seytek-2012:p0104:b003:l019","ordinal":303033,"en":"Had come apart layer by layer,"},{"id":"seytek-2012:p0104:b003:l020","ordinal":303034,"en":"And lice spilled from its collar."},{"id":"seytek-2012:p0104:b003:l021","ordinal":303035,"en":"The torment of accursed humiliation"},{"id":"seytek-2012:p0104:b003:l022","ordinal":303036,"en":"Was plainly visible there."},{"id":"seytek-2012:p0104:b003:l023","ordinal":303037,"en":"As for moonlike Aichürök,"},{"id":"seytek-2012:p0104:b003:l024","ordinal":303038,"en":"That tumultuous woman of a thousand devices,"},{"id":"seytek-2012:p0104:b003:l025","ordinal":303039,"en":"That headstrong woman—"},{"id":"seytek-2012:p0104:b003:l026","ordinal":303040,"en":"How could we know what scheme"},{"id":"seytek-2012:p0104:b003:l027","ordinal":303041,"en":"The nimble-witted infidel might devise?"},{"id":"seytek-2012:p0104:b003:l028","ordinal":303042,"en":"In a prominent place stood a white palace,"},{"id":"seytek-2012:p0104:b003:l029","ordinal":303043,"en":"Formidable in its strength;"},{"id":"seytek-2012:p0104:b003:l030","ordinal":303044,"en":"A vast, resounding palace,"},{"id":"seytek-2012:p0104:b003:l031","ordinal":303045,"en":"Immeasurable in its size."},{"id":"seytek-2012:p0104:b003:l032","ordinal":303046,"en":"It was encircled by ramparts,"},{"id":"seytek-2012:p0104:b003:l033","ordinal":303047,"en":"Its gates were made of iron,"},{"id":"seytek-2012:p0104:b003:l034","ordinal":303048,"en":"Its pillars were finely hewn,"},{"id":"seytek-2012:p0104:b003:l035","ordinal":303049,"en":"And all around the cavernous building"},{"id":"seytek-2012:p0104:b003:l036","ordinal":303050,"en":"Was brightly painted."},{"id":"seytek-2012:p0104:b003:l037","ordinal":303051,"en":"Its strength was plain for anyone to see;"},{"id":"seytek-2012:p0104:b003:l038","ordinal":303052,"en":"Across its roof, side by side,"},{"id":"seytek-2012:p0104:b003:l039","ordinal":303053,"en":"Three carts could have passed."},{"id":"seytek-2012:p0105:b002:l001","ordinal":303054,"en":"Into that towering palace"},{"id":"seytek-2012:p0105:b002:l002","ordinal":303055,"en":"Chürök deliberately brought Choro."},{"id":"seytek-2012:p0105:b002:l003","ordinal":303056,"en":"Once he had entered the palace,"},{"id":"seytek-2012:p0105:b002:l004","ordinal":303057,"en":"She sealed its entrance fast"},{"id":"seytek-2012:p0105:b002:l005","ordinal":303058,"en":"And took Choro under her protection."},{"id":"seytek-2012:p0105:b002:l006","ordinal":303059,"en":"Sunlike Aichürök,"},{"id":"seytek-2012:p0105:b002:l007","ordinal":303060,"en":"With her old maid who knew many things,"},{"id":"seytek-2012:p0105:b002:l008","ordinal":303061,"en":"The noble-born heroine,"},{"id":"seytek-2012:p0105:b002:l009","ordinal":303062,"en":"Her moonlike face gleaming,"},{"id":"seytek-2012:p0105:b002:l010","ordinal":303063,"en":"Sixty buttons and forty keys"},{"id":"seytek-2012:p0105:b002:l011","ordinal":303064,"en":"Jingling at her skirts—"},{"id":"seytek-2012:p0105:b002:l012","ordinal":303065,"en":"Had you seen your sister-in-law Aichürök,"},{"id":"seytek-2012:p0105:b002:l013","ordinal":303066,"en":"Her face shone like the sun"},{"id":"seytek-2012:p0105:b002:l014","ordinal":303067,"en":"And swayed supple as fine leather."},{"id":"seytek-2012:p0105:b002:l015","ordinal":303068,"en":"Seeing Choro, she cried aloud;"},{"id":"seytek-2012:p0105:b002:l016","ordinal":303069,"en":"The full-figured, luckless woman"},{"id":"seytek-2012:p0105:b002:l017","ordinal":303070,"en":"Sobbed and wailed convulsively."},{"id":"seytek-2012:p0105:b002:l018","ordinal":303071,"en":"It seemed her ribs were breaking,"},{"id":"seytek-2012:p0105:b002:l019","ordinal":303072,"en":"And tears streamed from her eyes;"},{"id":"seytek-2012:p0105:b002:l020","ordinal":303073,"en":"She cried out and beat herself."},{"id":"seytek-2012:p0105:b002:l021","ordinal":303074,"en":"Burning with grief, Aichürök"},{"id":"seytek-2012:p0105:b002:l022","ordinal":303075,"en":"Pleaded with Külchoro:"},{"id":"seytek-2012:p0105:b002:l023","ordinal":303076,"en":"“You were our protector, our lion;"},{"id":"seytek-2012:p0105:b002:l024","ordinal":303077,"en":"When this head was taken captive,"},{"id":"seytek-2012:p0105:b002:l025","ordinal":303078,"en":"You alone were our guardian."},{"id":"seytek-2012:p0105:b002:l026","ordinal":303079,"en":"Though in anguish I said, ‘Let me die,’"},{"id":"seytek-2012:p0105:b002:l027","ordinal":303080,"en":"The reason I remained alive"},{"id":"seytek-2012:p0105:b002:l028","ordinal":303081,"en":"Was that you, my son, still lived."},{"id":"seytek-2012:p0105:b002:l029","ordinal":303082,"en":"Though in anguish I said, ‘Let me depart,’"},{"id":"seytek-2012:p0105:b002:l030","ordinal":303083,"en":"The reason I stayed alive and safe"},{"id":"seytek-2012:p0105:b002:l031","ordinal":303084,"en":"When Kyyaz took me captive,"},{"id":"seytek-2012:p0105:b002:l032","ordinal":303085,"en":"When he heaped torment upon my head,"},{"id":"seytek-2012:p0105:b002:l033","ordinal":303086,"en":"When my plight became dire"},{"id":"seytek-2012:p0105:b002:l034","ordinal":303087,"en":"And he gashed my side—"},{"id":"seytek-2012:p0105:b002:l035","ordinal":303088,"en":"Your sunlike sister-in-law Aichürök,"},{"id":"seytek-2012:p0105:b002:l036","ordinal":303089,"en":"Bound as though guilty,"},{"id":"seytek-2012:p0105:b002:l037","ordinal":303090,"en":"Lamenting with no escape,"},{"id":"seytek-2012:p0105:b002:l038","ordinal":303091,"en":"Her head trapped in a narrow gorge,"},{"id":"seytek-2012:p0105:b002:l039","ordinal":303092,"en":"Her precious self disgraced,"},{"id":"seytek-2012:p0105:b004:l001","ordinal":303093,"en":"Wandered out this way,"},{"id":"seytek-2012:p0105:b004:l002","ordinal":303094,"en":"Delirious as though possessed."},{"id":"seytek-2012:p0105:b004:l003","ordinal":303095,"en":"From the one Creator, Almighty God,"},{"id":"seytek-2012:p0105:b004:l004","ordinal":303096,"en":"It was you I prayed for."},{"id":"seytek-2012:p0105:b004:l005","ordinal":303097,"en":"So I refrained from spilling my blood"},{"id":"seytek-2012:p0105:b004:l006","ordinal":303098,"en":"And could not bring myself to end my life."},{"id":"seytek-2012:p0105:b004:l007","ordinal":303099,"en":"I did not kill myself,"},{"id":"seytek-2012:p0105:b004:l008","ordinal":303100,"en":"My valiant, cherished son,"},{"id":"seytek-2012:p0105:b004:l009","ordinal":303101,"en":"And today I have seen your face."},{"id":"seytek-2012:p0105:b004:l010","ordinal":303102,"en":"You were terribly late in coming;"},{"id":"seytek-2012:p0105:b004:l011","ordinal":303103,"en":"Today I entrust to you"},{"id":"seytek-2012:p0105:b004:l012","ordinal":303104,"en":"The sole survivor left in our need."}]
