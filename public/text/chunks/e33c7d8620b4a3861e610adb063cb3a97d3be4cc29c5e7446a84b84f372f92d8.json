[{"id":"manas-2010:p0774:b001:l042","ordinal":34305,"en":"Their necks bent like pot supports,"},{"id":"manas-2010:p0775:b001:l001","ordinal":34306,"en":"Give the forty steeds their heads,"},{"id":"manas-2010:p0775:b001:l002","ordinal":34307,"en":"They fly and swoop like clouds."},{"id":"manas-2010:p0775:b001:l003","ordinal":34308,"en":"Running without letting one another draw away,"},{"id":"manas-2010:p0775:b001:l004","ordinal":34309,"en":"They follow close upon each other's heels."},{"id":"manas-2010:p0775:b001:l005","ordinal":34310,"en":"Give the forty steeds their heads,"},{"id":"manas-2010:p0775:b001:l006","ordinal":34311,"en":"They fly like clouds, flashing past."},{"id":"manas-2010:p0775:b001:l007","ordinal":34312,"en":"All forty winged steeds"},{"id":"manas-2010:p0775:b001:l008","ordinal":34313,"en":"Are Karabayyr thoroughbreds,"},{"id":"manas-2010:p0775:b001:l009","ordinal":34314,"en":"With sieve-like lungs and copper forelegs."},{"id":"manas-2010:p0775:b001:l010","ordinal":34315,"en":"Their forelocks are so alike,"},{"id":"manas-2010:p0775:b001:l011","ordinal":34316,"en":"As though tied to the measure of their eyes."},{"id":"manas-2010:p0775:b001:l012","ordinal":34317,"en":"“If only it were my horse!”"},{"id":"manas-2010:p0775:b001:l013","ordinal":34318,"en":"A beholder would marvel,"},{"id":"manas-2010:p0775:b001:l014","ordinal":34319,"en":"And fall in love with the forty steeds."},{"id":"manas-2010:p0775:b001:l015","ordinal":34320,"en":"All forty companions,"},{"id":"manas-2010:p0775:b001:l016","ordinal":34321,"en":"Turning their faces to wrath,"},{"id":"manas-2010:p0775:b001:l017","ordinal":34322,"en":"Their forward arms at the saddle straps,"},{"id":"manas-2010:p0775:b001:l018","ordinal":34323,"en":"Arm-length protective coats"},{"id":"manas-2010:p0775:b001:l019","ordinal":34324,"en":"All girded on alike,"},{"id":"manas-2010:p0775:b001:l020","ordinal":34325,"en":"The mighty men had set out,"},{"id":"manas-2010:p0775:b001:l021","ordinal":34326,"en":"Prepared for the place of conflict."},{"id":"manas-2010:p0775:b001:l022","ordinal":34327,"en":"In tamarisk-grown Keng-Kol and Talas,"},{"id":"manas-2010:p0775:b001:l023","ordinal":34328,"en":"Keeping a court and dwelling on the land,"},{"id":"manas-2010:p0775:b001:l024","ordinal":34329,"en":"Kötörmö and Chatkal"},{"id":"manas-2010:p0775:b001:l025","ordinal":34330,"en":"They made their land, grazing their livestock."},{"id":"manas-2010:p0775:b001:l026","ordinal":34331,"en":"Manas, Jakyp's son,"},{"id":"manas-2010:p0775:b001:l027","ordinal":34332,"en":"The other warriors gathered"},{"id":"manas-2010:p0775:b001:l028","ordinal":34333,"en":"And made their lion."},{"id":"manas-2010:p0775:b001:l029","ordinal":34334,"en":"Many rode abreast,"},{"id":"manas-2010:p0775:b001:l030","ordinal":34335,"en":"Helmets of blue iron"},{"id":"manas-2010:p0775:b001:l031","ordinal":34336,"en":"They fitted over their heads."},{"id":"manas-2010:p0775:b001:l032","ordinal":34337,"en":"A spear thrust could not pierce it,"},{"id":"manas-2010:p0775:b001:l033","ordinal":34338,"en":"The armor guarding their ribs;"},{"id":"manas-2010:p0775:b001:l034","ordinal":34339,"en":"A frontal thrust could not pierce it,"},{"id":"manas-2010:p0775:b001:l035","ordinal":34340,"en":"Known to the champions,"},{"id":"manas-2010:p0775:b001:l036","ordinal":34341,"en":"That iron thing called a shield."},{"id":"manas-2010:p0775:b001:l037","ordinal":34342,"en":"Making broad Talas their fortress,"},{"id":"manas-2010:p0775:b001:l038","ordinal":34343,"en":"They had settled there."},{"id":"manas-2010:p0775:b001:l039","ordinal":34344,"en":"The forty companions, like blue ticks,"},{"id":"manas-2010:p0775:b001:l040","ordinal":34345,"en":"Had now gathered in full."},{"id":"manas-2010:p0775:b001:l041","ordinal":34346,"en":"If their Manas showed his might,"},{"id":"manas-2010:p0775:b001:l042","ordinal":34347,"en":"They would all sweep forward together."},{"id":"manas-2010:p0776:b001:l001","ordinal":34348,"en":"For their lion, leopard Manas,"},{"id":"manas-2010:p0776:b001:l002","ordinal":34349,"en":"The forty warriors filled with wrath"},{"id":"manas-2010:p0776:b001:l003","ordinal":34350,"en":"Would offer themselves in sacrifice."},{"id":"manas-2010:p0776:b001:l004","ordinal":34351,"en":"The painted spear has no carved design;"},{"id":"manas-2010:p0776:b001:l005","ordinal":34352,"en":"Among the forty companions,"},{"id":"manas-2010:p0776:b001:l006","ordinal":34353,"en":"What was there, and what was not!"},{"id":"manas-2010:p0776:b001:l007","ordinal":34354,"en":"Among the forty companions,"},{"id":"manas-2010:p0776:b001:l008","ordinal":34355,"en":"Killing men and shedding blood,"},{"id":"manas-2010:p0776:b001:l009","ordinal":34356,"en":"There were bloodthirsty companions too."},{"id":"manas-2010:p0776:b001:l010","ordinal":34357,"en":"Throwing the whole world into turmoil,"},{"id":"manas-2010:p0776:b001:l011","ordinal":34358,"en":"There were deceitful companions too."},{"id":"manas-2010:p0776:b001:l012","ordinal":34359,"en":"Destroying all they faced,"},{"id":"manas-2010:p0776:b001:l013","ordinal":34360,"en":"There were resourceful companions too."},{"id":"manas-2010:p0776:b001:l014","ordinal":34361,"en":"“Trust in fate!” they cried, never stopping,"},{"id":"manas-2010:p0776:b001:l015","ordinal":34362,"en":"Attacking ninety thousand,"},{"id":"manas-2010:p0776:b001:l016","ordinal":34363,"en":"There were bold companions too."},{"id":"manas-2010:p0776:b001:l017","ordinal":34364,"en":"Among spearmen, exceptional,"},{"id":"manas-2010:p0776:b001:l018","ordinal":34365,"en":"There were skillful companions too."},{"id":"manas-2010:p0776:b001:l019","ordinal":34366,"en":"Knowing many tricks of war,"},{"id":"manas-2010:p0776:b001:l020","ordinal":34367,"en":"There were capable companions too."},{"id":"manas-2010:p0776:b001:l021","ordinal":34368,"en":"Swift-tongued, eloquent, skilled in argument,"},{"id":"manas-2010:p0776:b001:l022","ordinal":34369,"en":"There were learned companions too."},{"id":"manas-2010:p0776:b001:l023","ordinal":34370,"en":"Taking and drinking liquor,"},{"id":"manas-2010:p0776:b001:l024","ordinal":34371,"en":"There were cruel companions too."},{"id":"manas-2010:p0776:b001:l025","ordinal":34372,"en":"Holding spears and breaking ranks,"},{"id":"manas-2010:p0776:b001:l026","ordinal":34373,"en":"There were heroic companions too."},{"id":"manas-2010:p0776:b001:l027","ordinal":34374,"en":"Utterly malicious,"},{"id":"manas-2010:p0776:b001:l028","ordinal":34375,"en":"Not obeying when spoken to,"},{"id":"manas-2010:p0776:b001:l029","ordinal":34376,"en":"Not advancing against the enemy when driven,"},{"id":"manas-2010:p0776:b001:l030","ordinal":34377,"en":"Not hurrying at a battle cry,"},{"id":"manas-2010:p0776:b001:l031","ordinal":34378,"en":"Never yielding their own will,"},{"id":"manas-2010:p0776:b001:l032","ordinal":34379,"en":"Utterly malicious,"},{"id":"manas-2010:p0776:b001:l033","ordinal":34380,"en":"There were unbelieving companions too."},{"id":"manas-2010:p0776:b001:l034","ordinal":34381,"en":"Insisting on drinking grain beer,"},{"id":"manas-2010:p0776:b001:l035","ordinal":34382,"en":"Beating the holy man till he wailed,"},{"id":"manas-2010:p0776:b001:l036","ordinal":34383,"en":"There were impossible companions too."},{"id":"manas-2010:p0776:b001:l037","ordinal":34384,"en":"Fearing no sin at all,"},{"id":"manas-2010:p0776:b001:l038","ordinal":34385,"en":"There were incorrigible companions too."},{"id":"manas-2010:p0776:b001:l039","ordinal":34386,"en":"Never drawing back from death,"},{"id":"manas-2010:p0776:b001:l040","ordinal":34387,"en":"Never withdrawing their heads from doom,"},{"id":"manas-2010:p0776:b001:l041","ordinal":34388,"en":"There were foolish companions too."},{"id":"manas-2010:p0776:b001:l042","ordinal":34389,"en":"Panicking at the sight of an enemy,"},{"id":"manas-2010:p0777:b001:l001","ordinal":34390,"en":"Striking their horses' croups once,"},{"id":"manas-2010:p0777:b001:l002","ordinal":34391,"en":"And fleeing headlong back,"},{"id":"manas-2010:p0777:b001:l003","ordinal":34392,"en":"There were lazy companions too."},{"id":"manas-2010:p0777:b001:l004","ordinal":34393,"en":"The forty came from forty places,"},{"id":"manas-2010:p0777:b001:l005","ordinal":34394,"en":"Forty madmen;"},{"id":"manas-2010:p0777:b001:l006","ordinal":34395,"en":"Who could know their minds?"},{"id":"manas-2010:p0777:b001:l007","ordinal":34396,"en":"Hardship six months ahead,"},{"id":"manas-2010:p0777:b001:l008","ordinal":34397,"en":"Foreseeing it now in thought,"},{"id":"manas-2010:p0777:b001:l009","ordinal":34398,"en":"There were great companions too."},{"id":"manas-2010:p0777:b001:l010","ordinal":34399,"en":"Foul-mouthed, sharp-tongued,"},{"id":"manas-2010:p0777:b001:l011","ordinal":34400,"en":"Destroying fellowship,"},{"id":"manas-2010:p0777:b001:l012","ordinal":34401,"en":"There were disruptive companions too."},{"id":"manas-2010:p0777:b001:l013","ordinal":34402,"en":"Standing beneath the banner,"},{"id":"manas-2010:p0777:b001:l014","ordinal":34403,"en":"Performing boundless feats of valor,"},{"id":"manas-2010:p0777:b001:l015","ordinal":34404,"en":"Joining what was severed,"},{"id":"manas-2010:p0777:b001:l016","ordinal":34405,"en":"Gathering what was scattered,"},{"id":"manas-2010:p0777:b001:l017","ordinal":34406,"en":"Exceptional champions and sages,"},{"id":"manas-2010:p0777:b001:l018","ordinal":34407,"en":"There were mighty companions too."},{"id":"manas-2010:p0777:b001:l019","ordinal":34408,"en":"Told to take a cap, they cut off a head;"},{"id":"manas-2010:p0777:b001:l020","ordinal":34409,"en":"There were butcher companions too."},{"id":"manas-2010:p0777:b001:l021","ordinal":34410,"en":"Told to drink water, they drank poison,"},{"id":"manas-2010:p0777:b001:l022","ordinal":34411,"en":"Not knowing they would die;"},{"id":"manas-2010:p0777:b001:l023","ordinal":34412,"en":"There were troublesome companions too."},{"id":"manas-2010:p0777:b001:l024","ordinal":34413,"en":"Khan Manas's forty outstanding men,"},{"id":"manas-2010:p0777:b001:l025","ordinal":34414,"en":"Each of the forty had his own manner."},{"id":"manas-2010:p0777:b001:l026","ordinal":34415,"en":"Their voices raised dust;"},{"id":"manas-2010:p0777:b001:l027","ordinal":34416,"en":"If attacked, they drove life from the enemy."},{"id":"manas-2010:p0777:b001:l028","ordinal":34417,"en":"Where they swept past,"},{"id":"manas-2010:p0777:b001:l029","ordinal":34418,"en":"Blood flowed like a spring."},{"id":"manas-2010:p0777:b001:l030","ordinal":34419,"en":"Among them was their khan Manas,"},{"id":"manas-2010:p0777:b001:l031","ordinal":34420,"en":"Beneath them were winged steeds."},{"id":"manas-2010:p0777:b001:l032","ordinal":34421,"en":"All that ears had heard and eyes had seen,"},{"id":"manas-2010:p0777:b001:l033","ordinal":34422,"en":"The whole wide world,"},{"id":"manas-2010:p0777:b001:l034","ordinal":34423,"en":"While lion Manas was there,"},{"id":"manas-2010:p0777:b001:l035","ordinal":34424,"en":"They had the strength to subdue."},{"id":"manas-2010:p0777:b001:l036","ordinal":34425,"en":"All alike, side by side,"},{"id":"manas-2010:p0777:b001:l037","ordinal":34426,"en":"What the forty companions wore:"},{"id":"manas-2010:p0777:b001:l038","ordinal":34427,"en":"They had black caps big as cauldrons."},{"id":"manas-2010:p0777:b001:l039","ordinal":34428,"en":"Striking dead those they faced,"},{"id":"manas-2010:p0777:b001:l040","ordinal":34429,"en":"They had the power to conquer;"},{"id":"manas-2010:p0777:b001:l041","ordinal":34430,"en":"Upon the whole world, a great upheaval"},{"id":"manas-2010:p0777:b001:l042","ordinal":34431,"en":"They had the power to unleash."},{"id":"manas-2010:p0778:b001:l001","ordinal":34432,"en":"Making the forty companions sway,"},{"id":"manas-2010:p0778:b001:l002","ordinal":34433,"en":"On the right side then,"},{"id":"manas-2010:p0778:b001:l003","ordinal":34434,"en":"Inside the ammunition pouch,"},{"id":"manas-2010:p0778:b001:l004","ordinal":34435,"en":"They carefully stowed their bullets."},{"id":"manas-2010:p0778:b001:l005","ordinal":34436,"en":"While the lion warrior was safe,"},{"id":"manas-2010:p0778:b001:l006","ordinal":34437,"en":"Enemies who said, “I will fight,”"},{"id":"manas-2010:p0778:b001:l007","ordinal":34438,"en":"Could find no way and stood helpless."},{"id":"manas-2010:p0778:b001:l008","ordinal":34439,"en":"Of the mighty man blessed by Khizir,"},{"id":"manas-2010:p0778:b001:l009","ordinal":34440,"en":"The renown was fearsome, the wrath fierce."},{"id":"manas-2010:p0778:b001:l010","ordinal":34441,"en":"An enemy who grappled with him,"},{"id":"manas-2010:p0778:b001:l011","ordinal":34442,"en":"If he swept over him, he laid him flat."},{"id":"manas-2010:p0778:b001:l012","ordinal":34443,"en":"The swaying, blood-stained warrior"},{"id":"manas-2010:p0778:b001:l013","ordinal":34444,"en":"Pastured in middle Keng-Kol."},{"id":"manas-2010:p0778:b001:l014","ordinal":34445,"en":"His valor was exceptional;"},{"id":"manas-2010:p0778:b001:l015","ordinal":34446,"en":"To warrior Manas the champion,"},{"id":"manas-2010:p0778:b001:l016","ordinal":34447,"en":"No mortal remained unsubdued."},{"id":"manas-2010:p0778:b001:l017","ordinal":34448,"en":"When his anger was provoked,"},{"id":"manas-2010:p0778:b001:l018","ordinal":34449,"en":"He drove Alöökö away."},{"id":"manas-2010:p0778:b001:l019","ordinal":34450,"en":"Driving him, your wolf-man"},{"id":"manas-2010:p0778:b001:l020","ordinal":34451,"en":"Took him between his fangs and chewed."},{"id":"manas-2010:p0778:b001:l021","ordinal":34452,"en":"All forty companions,"},{"id":"manas-2010:p0778:b001:l022","ordinal":34453,"en":"Their elders Kyrgyl and Bakay,"},{"id":"manas-2010:p0778:b001:l023","ordinal":34454,"en":"Alike to a hair, the damned fellows,"},{"id":"manas-2010:p0778:b001:l024","ordinal":34455,"en":"Each one of those mighty men."},{"id":"manas-2010:p0778:b001:l025","ordinal":34456,"en":"Ajybay and Bakay, the two khans,"},{"id":"manas-2010:p0778:b001:l026","ordinal":34457,"en":"Were magnanimous Manas's fortress."},{"id":"manas-2010:p0778:b001:l027","ordinal":34458,"en":"They came from forty places to join him,"},{"id":"manas-2010:p0778:b001:l028","ordinal":34459,"en":"Making up the forty companions."},{"id":"manas-2010:p0778:b001:l029","ordinal":34460,"en":"Your mighty man blessed by Khizir,"},{"id":"manas-2010:p0778:b001:l030","ordinal":34461,"en":"Even in death would have no regret."},{"id":"manas-2010:p0778:b001:l031","ordinal":34462,"en":"Upon the earth, against Manas,"},{"id":"manas-2010:p0778:b001:l032","ordinal":34463,"en":"In that time and age,"},{"id":"manas-2010:p0778:b001:l033","ordinal":34464,"en":"None remained who could turn a lasso pole."},{"id":"manas-2010:p0778:b001:l034","ordinal":34465,"en":"While the champion wolf-man was there,"},{"id":"manas-2010:p0778:b001:l035","ordinal":34466,"en":"He intended to draw the line;"},{"id":"manas-2010:p0778:b001:l036","ordinal":34467,"en":"For the enemy who grappled with him,"},{"id":"manas-2010:p0778:b001:l037","ordinal":34468,"en":"He intended to make a spectacle."},{"id":"manas-2010:p0778:b001:l038","ordinal":34469,"en":"Blood-stained Manas came forth a lion,"},{"id":"manas-2010:p0778:b001:l039","ordinal":34470,"en":"With fortune full on every side."},{"id":"manas-2010:p0778:b001:l040","ordinal":34471,"en":"He intended to spread his wings;"},{"id":"manas-2010:p0778:b001:l041","ordinal":34472,"en":"To the enemy who faced him,"},{"id":"manas-2010:p0778:b001:l042","ordinal":34473,"en":"He intended to teach a lesson."},{"id":"manas-2010:p0779:b001:l001","ordinal":34474,"en":"He led the forty companions;"},{"id":"manas-2010:p0779:b001:l002","ordinal":34475,"en":"Now the leopard set out"},{"id":"manas-2010:p0779:b001:l003","ordinal":34476,"en":"To the ridges of the empty plain."},{"id":"manas-2010:p0779:b001:l004","ordinal":34477,"en":"He intended then to act"},{"id":"manas-2010:p0779:b001:l005","ordinal":34478,"en":"Against the Indian and Chinese peoples."},{"id":"manas-2010:p0779:b001:l006","ordinal":34479,"en":"Continuing from tradition,"},{"id":"manas-2010:p0779:b001:l007","ordinal":34480,"en":"Asking those who knew,"},{"id":"manas-2010:p0779:b001:l008","ordinal":34481,"en":"In former days, he raided the Noygut and took six,"},{"id":"manas-2010:p0779:b001:l009","ordinal":34482,"en":"Their khan Shooruk."},{"id":"manas-2010:p0779:b001:l010","ordinal":34483,"en":"“The Noygut, from his might,"},{"id":"manas-2010:p0779:b001:l011","ordinal":34484,"en":"Are weary,” he heard."},{"id":"manas-2010:p0779:b001:l012","ordinal":34485,"en":"“Three times in one year"},{"id":"manas-2010:p0779:b001:l013","ordinal":34486,"en":"He plunders them,” he heard."},{"id":"manas-2010:p0779:b001:l014","ordinal":34487,"en":"“Khan Shooruk's name has spread;"},{"id":"manas-2010:p0779:b001:l015","ordinal":34488,"en":"His voice drives out men's souls."},{"id":"manas-2010:p0779:b001:l016","ordinal":34489,"en":"He has brought ruin upon the Noygut,"},{"id":"manas-2010:p0779:b001:l017","ordinal":34490,"en":"Toppling all their thrones,"},{"id":"manas-2010:p0779:b001:l018","ordinal":34491,"en":"Knocking down all their houses,"},{"id":"manas-2010:p0779:b001:l019","ordinal":34492,"en":"Knocking down their stone fortress,"},{"id":"manas-2010:p0779:b001:l020","ordinal":34493,"en":"Raiding them utterly."},{"id":"manas-2010:p0779:b001:l021","ordinal":34494,"en":"He trampled down upon their heads,"},{"id":"manas-2010:p0779:b001:l022","ordinal":34495,"en":"Scattered their four kinds of livestock,"},{"id":"manas-2010:p0779:b001:l023","ordinal":34496,"en":"Plundered their goods,"},{"id":"manas-2010:p0779:b001:l024","ordinal":34497,"en":"Wrought terrible destruction."},{"id":"manas-2010:p0779:b001:l025","ordinal":34498,"en":"He opened the grain from their storage pits;"},{"id":"manas-2010:p0779:b001:l026","ordinal":34499,"en":"The Noygut people, finding no way out,"},{"id":"manas-2010:p0779:b001:l027","ordinal":34500,"en":"Fled in every direction."},{"id":"manas-2010:p0779:b001:l028","ordinal":34501,"en":"He gathered his camel-mounted host, they say;"},{"id":"manas-2010:p0779:b001:l029","ordinal":34502,"en":"The Noygut, a people with lords,"},{"id":"manas-2010:p0779:b001:l030","ordinal":34503,"en":"He trampled and slaughtered, they say."},{"id":"manas-2010:p0779:b001:l031","ordinal":34504,"en":"When summer came,"},{"id":"manas-2010:p0779:b001:l032","ordinal":34505,"en":"He let them ride no maned mares;"},{"id":"manas-2010:p0779:b001:l033","ordinal":34506,"en":"When autumn came,"},{"id":"manas-2010:p0779:b001:l034","ordinal":34507,"en":"He let them eat no fat-tailed yearling sheep."},{"id":"manas-2010:p0779:b001:l035","ordinal":34508,"en":"He let them fit no yoke pins,"},{"id":"manas-2010:p0779:b001:l036","ordinal":34509,"en":"Let them sow no crops,"},{"id":"manas-2010:p0779:b001:l037","ordinal":34510,"en":"Let them turn no soil,"},{"id":"manas-2010:p0779:b001:l038","ordinal":34511,"en":"Let them scatter no handful of seed."},{"id":"manas-2010:p0779:b001:l039","ordinal":34512,"en":"He kept them under a foul siege,” they say."},{"id":"manas-2010:p0779:b001:l040","ordinal":34513,"en":"“Letting my people in Alay be slaughtered,"},{"id":"manas-2010:p0779:b001:l041","ordinal":34514,"en":"That pig Shooruk,"},{"id":"manas-2010:p0779:b001:l042","ordinal":34515,"en":"How could I fail to watch him?"},{"id":"manas-2010:p0780:b001:l001","ordinal":34516,"en":"Letting my people with their lords be slaughtered,"},{"id":"manas-2010:p0780:b001:l002","ordinal":34517,"en":"How could I hand them to Shooruk?"},{"id":"manas-2010:p0780:b001:l003","ordinal":34518,"en":"This pig has gone mad;"},{"id":"manas-2010:p0780:b001:l004","ordinal":34519,"en":"Let me try locking horns with him!"},{"id":"manas-2010:p0780:b001:l005","ordinal":34520,"en":"We shall wage a mighty struggle,"},{"id":"manas-2010:p0780:b001:l006","ordinal":34521,"en":"Whether we lose or conquer."},{"id":"manas-2010:p0780:b001:l007","ordinal":34522,"en":"Your father's grave, Khan Shooruk,"},{"id":"manas-2010:p0780:b001:l008","ordinal":34523,"en":"His oppression has gone too far,"},{"id":"manas-2010:p0780:b001:l009","ordinal":34524,"en":"His violence has multiplied."},{"id":"manas-2010:p0780:b001:l010","ordinal":34525,"en":"Let me try attacking him;"},{"id":"manas-2010:p0780:b001:l011","ordinal":34526,"en":"If death has come, let me die!"},{"id":"manas-2010:p0780:b001:l012","ordinal":34527,"en":"If I can overcome Shooruk,"},{"id":"manas-2010:p0780:b001:l013","ordinal":34528,"en":"Showing him my lion's strength,"},{"id":"manas-2010:p0780:b001:l014","ordinal":34529,"en":"The humiliation he laid on the Noygut"},{"id":"manas-2010:p0780:b001:l015","ordinal":34530,"en":"I shall lay upon him himself."},{"id":"manas-2010:p0780:b001:l016","ordinal":34531,"en":"Let me charge and thrust my spear;"},{"id":"manas-2010:p0780:b001:l017","ordinal":34532,"en":"I hear he is resourceful."},{"id":"manas-2010:p0780:b001:l018","ordinal":34533,"en":"If mighty God permits,"},{"id":"manas-2010:p0780:b001:l019","ordinal":34534,"en":"Clashing and fighting,"},{"id":"manas-2010:p0780:b001:l020","ordinal":34535,"en":"Let me put him in a black mourning headdress."},{"id":"manas-2010:p0780:b001:l021","ordinal":34536,"en":"If Shooruk makes trouble,"},{"id":"manas-2010:p0780:b001:l022","ordinal":34537,"en":"We have turned this way; let us go."},{"id":"manas-2010:p0780:b001:l023","ordinal":34538,"en":"Let us shatter his court,"},{"id":"manas-2010:p0780:b001:l024","ordinal":34539,"en":"Bind his devastating champion alive."},{"id":"manas-2010:p0780:b001:l025","ordinal":34540,"en":"If the pig swaggers,"},{"id":"manas-2010:p0780:b001:l026","ordinal":34541,"en":"Let us slay him, leaving him no life."},{"id":"manas-2010:p0780:b001:l027","ordinal":34542,"en":"Standing on opposite sides,"},{"id":"manas-2010:p0780:b001:l028","ordinal":34543,"en":"Your fathers' graves, forty companions,"},{"id":"manas-2010:p0780:b001:l029","ordinal":34544,"en":"If we live, fighting a splendid battle,"},{"id":"manas-2010:p0780:b001:l030","ordinal":34545,"en":"Let us take our bitter vengeance."},{"id":"manas-2010:p0780:b001:l031","ordinal":34546,"en":"Upon Khan Shooruk with his court,"},{"id":"manas-2010:p0780:b001:l032","ordinal":34547,"en":"Let us inflict surpassing humiliation."},{"id":"manas-2010:p0780:b001:l033","ordinal":34548,"en":"From what I hear of Shooruk,"},{"id":"manas-2010:p0780:b001:l034","ordinal":34549,"en":"He has elephants stronger than other beasts;"},{"id":"manas-2010:p0780:b001:l035","ordinal":34550,"en":"Let us take his elephants as booty,"},{"id":"manas-2010:p0780:b001:l036","ordinal":34551,"en":"Let us slaughter his champions."},{"id":"manas-2010:p0780:b001:l037","ordinal":34552,"en":"I hear his girls are beautiful;"},{"id":"manas-2010:p0780:b001:l038","ordinal":34553,"en":"Taking his girls as booty,"},{"id":"manas-2010:p0780:b001:l039","ordinal":34554,"en":"Let us have women in abundance."},{"id":"manas-2010:p0780:b001:l040","ordinal":34555,"en":"Think, forty companions;"},{"id":"manas-2010:p0780:b001:l041","ordinal":34556,"en":"Know this worth of mine."},{"id":"manas-2010:p0780:b001:l042","ordinal":34557,"en":"Your lion will raise the battle shout;"},{"id":"manas-2010:p0781:b001:l001","ordinal":34558,"en":"Fear no death; raise the conflict!"},{"id":"manas-2010:p0781:b001:l002","ordinal":34559,"en":"The pressure of Judgment Day,"},{"id":"manas-2010:p0781:b001:l003","ordinal":34560,"en":"Your fathers' graves, forty companions,"}]
