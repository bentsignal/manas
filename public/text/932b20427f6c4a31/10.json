[{"id":"manas-2010:p0069:b002:l032","ordinal":2561,"en":"Now Karykan showered them with orders;"},{"id":"manas-2010:p0069:b002:l033","ordinal":2562,"en":"Their protective armor billowing,"},{"id":"manas-2010:p0069:b002:l034","ordinal":2563,"en":"So many champions hurried;"},{"id":"manas-2010:p0069:b002:l035","ordinal":2564,"en":"All the foolish ones"},{"id":"manas-2010:p0069:b002:l036","ordinal":2565,"en":"Fled out through the doors."},{"id":"manas-2010:p0069:b002:l037","ordinal":2566,"en":"“Scour the face of the earth,"},{"id":"manas-2010:p0069:b002:l038","ordinal":2567,"en":"The four corners of the world,"},{"id":"manas-2010:p0069:b002:l039","ordinal":2568,"en":"Visit every one without exception."},{"id":"manas-2010:p0069:b002:l040","ordinal":2569,"en":"White-bearded elders, listen!"},{"id":"manas-2010:p0069:b002:l041","ordinal":2570,"en":"All champions, listen carefully!"},{"id":"manas-2010:p0069:b002:l042","ordinal":2571,"en":"The skillful spearmen, listen!"},{"id":"manas-2010:p0069:b002:l043","ordinal":2572,"en":"You who know the enemy's methods,"},{"id":"manas-2010:p0069:b002:l044","ordinal":2573,"en":"You able men, listen!"},{"id":"manas-2010:p0069:b002:l045","ordinal":2574,"en":"Honored champions, give thought:"},{"id":"manas-2010:p0069:b002:l046","ordinal":2575,"en":"Manas who comes from the Burut,"},{"id":"manas-2010:p0069:b002:l047","ordinal":2576,"en":"Do not fail to seize and bring him!"},{"id":"manas-2010:p0069:b002:l048","ordinal":2577,"en":"I have a dungeon, I have a pit;"},{"id":"manas-2010:p0070:b002:l001","ordinal":2578,"en":"If he falls into my hands, I will put him there."},{"id":"manas-2010:p0070:b002:l002","ordinal":2579,"en":"Without leaving their Manas alive,"},{"id":"manas-2010:p0070:b002:l003","ordinal":2580,"en":"I will finish him off."},{"id":"manas-2010:p0070:b002:l004","ordinal":2581,"en":"Unless we seize and slaughter Manas,"},{"id":"manas-2010:p0070:b002:l005","ordinal":2582,"en":"From the face of this world,"},{"id":"manas-2010:p0070:b002:l006","ordinal":2583,"en":"Unless we erase him—"},{"id":"manas-2010:p0070:b002:l007","ordinal":2584,"en":"He follows the Muslim faith,"},{"id":"manas-2010:p0070:b002:l008","ordinal":2585,"en":"He is our enemy by nature."},{"id":"manas-2010:p0070:b002:l009","ordinal":2586,"en":"If Manas should happen to grow up,"},{"id":"manas-2010:p0070:b002:l010","ordinal":2587,"en":"Manas is no ordinary boy;"},{"id":"manas-2010:p0070:b002:l011","ordinal":2588,"en":"This very Beijing—"},{"id":"manas-2010:p0070:b002:l012","ordinal":2589,"en":"He is no slave who will let it prosper!”"},{"id":"manas-2010:p0070:b002:l013","ordinal":2590,"en":"Karykan spoke terrible words;"},{"id":"manas-2010:p0070:b002:l014","ordinal":2591,"en":"He and Khan Esenkan,"},{"id":"manas-2010:p0070:b002:l015","ordinal":2592,"en":"The two issued their commands."},{"id":"manas-2010:p0070:b002:l016","ordinal":2593,"en":"If troublesome Manas grows up,"},{"id":"manas-2010:p0070:b002:l017","ordinal":2594,"en":"He is no boy to sit idle."},{"id":"manas-2010:p0070:b002:l018","ordinal":2595,"en":"If that Manas grows up,"},{"id":"manas-2010:p0070:b002:l019","ordinal":2596,"en":"Comes of age and becomes a man,"},{"id":"manas-2010:p0070:b002:l020","ordinal":2597,"en":"He will shatter the city,"},{"id":"manas-2010:p0070:b002:l021","ordinal":2598,"en":"Break your fortune, Beijing,"},{"id":"manas-2010:p0070:b002:l022","ordinal":2599,"en":"Contest your golden throne."},{"id":"manas-2010:p0070:b002:l023","ordinal":2600,"en":"He will bury your banner in the earth."},{"id":"manas-2010:p0070:b002:l024","ordinal":2601,"en":"If that bastard Manas grows up,"},{"id":"manas-2010:p0070:b002:l025","ordinal":2602,"en":"He will leave you Chinese helpless."},{"id":"manas-2010:p0070:b002:l026","ordinal":2603,"en":"Beijing with its kakan,"},{"id":"manas-2010:p0070:b002:l027","ordinal":2604,"en":"He will leave the Chinese rigid with fear."},{"id":"manas-2010:p0070:b002:l028","ordinal":2605,"en":"He is no ordinary enemy born;"},{"id":"manas-2010:p0070:b002:l029","ordinal":2606,"en":"If Manas is born, he is destruction,"},{"id":"manas-2010:p0070:b002:l030","ordinal":2607,"en":"For the Beijing of Chin-Machin"},{"id":"manas-2010:p0070:b002:l031","ordinal":2608,"en":"A true calamity brought into being."},{"id":"manas-2010:p0070:b002:l032","ordinal":2609,"en":"If Manas is born, he is the hero"},{"id":"manas-2010:p0070:b002:l033","ordinal":2610,"en":"Who to the Black Chinese and Manchus"},{"id":"manas-2010:p0070:b002:l034","ordinal":2611,"en":"Will bring uproar."},{"id":"manas-2010:p0070:b002:l035","ordinal":2612,"en":"“My champions, all of you listen!"},{"id":"manas-2010:p0070:b002:l036","ordinal":2613,"en":"Do not let Manas go unfound."},{"id":"manas-2010:p0070:b002:l037","ordinal":2614,"en":"Do not come staggering back without him;"},{"id":"manas-2010:p0070:b002:l038","ordinal":2615,"en":"Champions, may God not take you!"},{"id":"manas-2010:p0070:b002:l039","ordinal":2616,"en":"If by chance"},{"id":"manas-2010:p0070:b002:l040","ordinal":2617,"en":"You return without finding Manas,"},{"id":"manas-2010:p0070:b002:l041","ordinal":2618,"en":"I will not heed your pleas."},{"id":"manas-2010:p0070:b002:l042","ordinal":2619,"en":"This is the decree I pronounce—"},{"id":"manas-2010:p0070:b002:l043","ordinal":2620,"en":"Your eyes bulging in haste,"},{"id":"manas-2010:p0070:b002:l044","ordinal":2621,"en":"You will see if you return without him!"},{"id":"manas-2010:p0070:b002:l045","ordinal":2622,"en":"Torgut, Manchus, countless Chinese,"},{"id":"manas-2010:p0070:b002:l046","ordinal":2623,"en":"Every one of you will die by my hand!"},{"id":"manas-2010:p0070:b002:l047","ordinal":2624,"en":"Horse acrobat, swift runner on foot,"},{"id":"manas-2010:p0070:b002:l048","ordinal":2625,"en":"Honored champion, great Döngö,"},{"id":"manas-2010:p0071:b002:l001","ordinal":2626,"en":"Who has studied wondrous spells,"},{"id":"manas-2010:p0071:b002:l002","ordinal":2627,"en":"Who casts lots and tells fortunes,"},{"id":"manas-2010:p0071:b002:l003","ordinal":2628,"en":"All four of you go out and search!"},{"id":"manas-2010:p0071:b002:l004","ordinal":2629,"en":"The forty magicians of Beijing,"},{"id":"manas-2010:p0071:b002:l005","ordinal":2630,"en":"His forefathers are Burut;"},{"id":"manas-2010:p0071:b002:l006","ordinal":2631,"en":"Among the people called Burut,"},{"id":"manas-2010:p0071:b002:l007","ordinal":2632,"en":"Let him not remain hidden in a corner."},{"id":"manas-2010:p0071:b002:l008","ordinal":2633,"en":"His appearance is known to you;"},{"id":"manas-2010:p0071:b002:l009","ordinal":2634,"en":"You will recognize him by his face.”"},{"id":"manas-2010:p0071:b002:l010","ordinal":2635,"en":"Esenkan and Karykan"},{"id":"manas-2010:p0071:b002:l011","ordinal":2636,"en":"Issued countless commands;"},{"id":"manas-2010:p0071:b002:l012","ordinal":2637,"en":"Their discerning men all gathered."},{"id":"manas-2010:p0071:b002:l013","ordinal":2638,"en":"God had struck the Chinese."},{"id":"manas-2010:p0071:b002:l014","ordinal":2639,"en":"Their healers who foretold fortunes,"},{"id":"manas-2010:p0071:b002:l015","ordinal":2640,"en":"Their gifted men with second sight,"},{"id":"manas-2010:p0071:b002:l016","ordinal":2641,"en":"Bad and good—"},{"id":"manas-2010:p0071:b002:l017","ordinal":2642,"en":"Their finest men who could distinguish them,"},{"id":"manas-2010:p0071:b002:l018","ordinal":2643,"en":"Those whose swords were keenly sharp,"},{"id":"manas-2010:p0071:b002:l019","ordinal":2644,"en":"Their strong men with black hearts—"},{"id":"manas-2010:p0071:b002:l020","ordinal":2645,"en":"A thousand magicians left Beijing."},{"id":"manas-2010:p0071:b002:l021","ordinal":2646,"en":"A good many of them were learned;"},{"id":"manas-2010:p0071:b002:l022","ordinal":2647,"en":"Loading shot upon their waists,"},{"id":"manas-2010:p0071:b002:l023","ordinal":2648,"en":"The Chinese were no simple people."},{"id":"manas-2010:p0071:b002:l024","ordinal":2649,"en":"Taking their learned men together,"},{"id":"manas-2010:p0071:b002:l025","ordinal":2650,"en":"The magicians set out from Beijing."},{"id":"manas-2010:p0071:b002:l026","ordinal":2651,"en":"Their champion, the hero Döngö,"},{"id":"manas-2010:p0071:b002:l027","ordinal":2652,"en":"Who knew no human speech,"},{"id":"manas-2010:p0071:b002:l028","ordinal":2653,"en":"Their unbeliever like a beast;"},{"id":"manas-2010:p0071:b002:l029","ordinal":2654,"en":"From the Sibe came Muzkindik,"},{"id":"manas-2010:p0071:b002:l030","ordinal":2655,"en":"From the Torgut came Solobo."},{"id":"manas-2010:p0071:b002:l031","ordinal":2656,"en":"Of the clamoring unbelievers,"},{"id":"manas-2010:p0071:b002:l032","ordinal":2657,"en":"Could there be discerning men like these?"},{"id":"manas-2010:p0071:b002:l033","ordinal":2658,"en":"From the Tokushker, Bozkertik;"},{"id":"manas-2010:p0071:b002:l034","ordinal":2659,"en":"From the Solon came Orokkyr."},{"id":"manas-2010:p0071:b002:l035","ordinal":2660,"en":"They set their faces toward the Kyrgyz;"},{"id":"manas-2010:p0071:b002:l036","ordinal":2661,"en":"The Chinese were seized by their devil."},{"id":"manas-2010:p0071:b002:l037","ordinal":2662,"en":"Of the clamoring unbelievers,"},{"id":"manas-2010:p0071:b002:l038","ordinal":2663,"en":"Which one shall we tell of?"},{"id":"manas-2010:p0071:b002:l039","ordinal":2664,"en":"The great Döödür of the Chinese,"},{"id":"manas-2010:p0071:b002:l040","ordinal":2665,"en":"Maamytbek on a gray mule,"},{"id":"manas-2010:p0071:b002:l041","ordinal":2666,"en":"Whose renown made those who saw him fear—"},{"id":"manas-2010:p0071:b002:l042","ordinal":2667,"en":"All those we have named"},{"id":"manas-2010:p0071:b002:l043","ordinal":2668,"en":"Had studied wondrous arts."},{"id":"manas-2010:p0071:b002:l044","ordinal":2669,"en":"Some no human strength could overcome,"},{"id":"manas-2010:p0071:b002:l045","ordinal":2670,"en":"Whom a lion's teeth could not pierce;"},{"id":"manas-2010:p0071:b002:l046","ordinal":2671,"en":"Some had speech no human knew,"},{"id":"manas-2010:p0071:b002:l047","ordinal":2672,"en":"Some had one eye in their head as large as a bucket."},{"id":"manas-2010:p0071:b002:l048","ordinal":2673,"en":"The reason for the single eye—"},{"id":"manas-2010:p0072:b002:l001","ordinal":2674,"en":"His father was a raging Chinese,"},{"id":"manas-2010:p0072:b002:l002","ordinal":2675,"en":"Knowing no human speech,"},{"id":"manas-2010:p0072:b002:l003","ordinal":2676,"en":"A swine resembling a beast."},{"id":"manas-2010:p0072:b002:l004","ordinal":2677,"en":"Orokkyr and Muzkindik,"},{"id":"manas-2010:p0072:b002:l005","ordinal":2678,"en":"The mighty champions of the Chinese,"},{"id":"manas-2010:p0072:b002:l006","ordinal":2679,"en":"Though Manas was not yet born, no trace of him,"},{"id":"manas-2010:p0072:b002:l007","ordinal":2680,"en":"Traveled toward the Burut"},{"id":"manas-2010:p0072:b002:l008","ordinal":2681,"en":"And began to seek the child."},{"id":"manas-2010:p0072:b002:l009","ordinal":2682,"en":"Their sorcerers were beyond counting;"},{"id":"manas-2010:p0072:b002:l010","ordinal":2683,"en":"Those who had studied wonders—"},{"id":"manas-2010:p0072:b002:l011","ordinal":2684,"en":"Their unbelieving magicians were more numerous still."},{"id":"manas-2010:p0072:b002:l012","ordinal":2685,"en":"Their finest judges of men"},{"id":"manas-2010:p0072:b002:l013","ordinal":2686,"en":"Received orders from their khan,"},{"id":"manas-2010:p0072:b002:l014","ordinal":2687,"en":"Gathered warriors and took troops."},{"id":"manas-2010:p0072:b002:l015","ordinal":2688,"en":"The thunderous unbelievers"},{"id":"manas-2010:p0072:b002:l016","ordinal":2689,"en":"Took abundant travel rations."},{"id":"manas-2010:p0072:b002:l017","ordinal":2690,"en":"To each magician, a thousand champions"},{"id":"manas-2010:p0072:b002:l018","ordinal":2691,"en":"Had been assigned for service."},{"id":"manas-2010:p0072:b002:l019","ordinal":2692,"en":"Through deserts forty days across,"},{"id":"manas-2010:p0072:b002:l020","ordinal":2693,"en":"They trotted as though maddened."},{"id":"manas-2010:p0072:b002:l021","ordinal":2694,"en":"To the two lands, Altai and Kanggay,"},{"id":"manas-2010:p0072:b002:l022","ordinal":2695,"en":"Döngö came."},{"id":"manas-2010:p0072:b002:l023","ordinal":2696,"en":"The children of the forty Kyrgyz households"},{"id":"manas-2010:p0072:b002:l024","ordinal":2697,"en":"He gathered, leaving none behind,"},{"id":"manas-2010:p0072:b002:l025","ordinal":2698,"en":"And made them file past."},{"id":"manas-2010:p0072:b002:l026","ordinal":2699,"en":"Younger than seventeen,"},{"id":"manas-2010:p0072:b002:l027","ordinal":2700,"en":"Older than half a year,"},{"id":"manas-2010:p0072:b002:l028","ordinal":2701,"en":"He gathered their children."},{"id":"manas-2010:p0072:b002:l029","ordinal":2702,"en":"“He will slaughter the children,” they said,"},{"id":"manas-2010:p0072:b002:l030","ordinal":2703,"en":"“He will bring us all to ruin.”"},{"id":"manas-2010:p0072:b002:l031","ordinal":2704,"en":"The poor people driven into exile,"},{"id":"manas-2010:p0072:b002:l032","ordinal":2705,"en":"With Khan Baltay at their head,"},{"id":"manas-2010:p0072:b002:l033","ordinal":2706,"en":"Wept in helplessness."},{"id":"manas-2010:p0072:b002:l034","ordinal":2707,"en":"Six magicians stood abreast;"},{"id":"manas-2010:p0072:b002:l035","ordinal":2708,"en":"Six days in succession they examined them."},{"id":"manas-2010:p0072:b002:l036","ordinal":2709,"en":"“If he is Manas, these are his marks:"},{"id":"manas-2010:p0072:b002:l037","ordinal":2710,"en":"The tips of his ears are pierced,"},{"id":"manas-2010:p0072:b002:l038","ordinal":2711,"en":"He is circumcised;"},{"id":"manas-2010:p0072:b002:l039","ordinal":2712,"en":"He has all the signs."},{"id":"manas-2010:p0072:b002:l040","ordinal":2713,"en":"Upon his right shoulder blade"},{"id":"manas-2010:p0072:b002:l041","ordinal":2714,"en":"Is a red birthmark like a platter."},{"id":"manas-2010:p0072:b002:l042","ordinal":2715,"en":"Upon the child's back"},{"id":"manas-2010:p0072:b002:l043","ordinal":2716,"en":"Is a dark blue-black mane."},{"id":"manas-2010:p0072:b002:l044","ordinal":2717,"en":"“One who has been named Manas—"},{"id":"manas-2010:p0072:b002:l045","ordinal":2718,"en":"Is there such a child in your village?”"},{"id":"manas-2010:p0072:b002:l046","ordinal":2719,"en":"They asked, proclaiming it aloud."},{"id":"manas-2010:p0072:b002:l047","ordinal":2720,"en":"This was what the champions did:"},{"id":"manas-2010:p0072:b002:l048","ordinal":2721,"en":"They searched every village."},{"id":"manas-2010:p0073:b002:l001","ordinal":2722,"en":"Unable to find the child here,"},{"id":"manas-2010:p0073:b002:l002","ordinal":2723,"en":"They traveled onward."},{"id":"manas-2010:p0073:b002:l003","ordinal":2724,"en":"The champions who had received orders,"},{"id":"manas-2010:p0073:b002:l004","ordinal":2725,"en":"Traveling far and wearing out their horses,"},{"id":"manas-2010:p0073:b002:l005","ordinal":2726,"en":"Throughout the whole world"},{"id":"manas-2010:p0073:b002:l006","ordinal":2727,"en":"They wandered in search."},{"id":"manas-2010:p0073:b002:l007","ordinal":2728,"en":"The four corners of the world"},{"id":"manas-2010:p0073:b002:l008","ordinal":2729,"en":"They circled four times;"},{"id":"manas-2010:p0073:b002:l009","ordinal":2730,"en":"Jelpinish at the end of the earth"},{"id":"manas-2010:p0073:b002:l010","ordinal":2731,"en":"They circled seven times."},{"id":"manas-2010:p0073:b002:l011","ordinal":2732,"en":"Unable to find the child there,"},{"id":"manas-2010:p0073:b002:l012","ordinal":2733,"en":"Old Turpan, wide Barbar,"},{"id":"manas-2010:p0073:b002:l013","ordinal":2734,"en":"Behind them the River Lop—"},{"id":"manas-2010:p0073:b002:l014","ordinal":2735,"en":"They traveled through all of these,"},{"id":"manas-2010:p0073:b002:l015","ordinal":2736,"en":"Through dusty deserts,"},{"id":"manas-2010:p0073:b002:l016","ordinal":2737,"en":"Over ridges of shifting sand."},{"id":"manas-2010:p0073:b002:l017","ordinal":2738,"en":"The champions endured torment,"},{"id":"manas-2010:p0073:b002:l018","ordinal":2739,"en":"Scouring the world,"},{"id":"manas-2010:p0073:b002:l019","ordinal":2740,"en":"Wandering for exactly six years."},{"id":"manas-2010:p0073:b002:l020","ordinal":2741,"en":"Unable to find the child there,"},{"id":"manas-2010:p0073:b002:l021","ordinal":2742,"en":"Alty-Shaar, the khan of Kokon,"},{"id":"manas-2010:p0073:b002:l022","ordinal":2743,"en":"Beyond it Samarkan,"},{"id":"manas-2010:p0073:b002:l023","ordinal":2744,"en":"Before it Margalang,"},{"id":"manas-2010:p0073:b002:l024","ordinal":2745,"en":"At its throat Anjyiyan,"},{"id":"manas-2010:p0073:b002:l025","ordinal":2746,"en":"Ruined Chambyl, Bukara,"},{"id":"manas-2010:p0073:b002:l026","ordinal":2747,"en":"In its sheltered reaches Sary-Arka."},{"id":"manas-2010:p0073:b002:l027","ordinal":2748,"en":"In Sary-Arka, Aydarkan"},{"id":"manas-2010:p0073:b002:l028","ordinal":2749,"en":"Was khan of the Kazakhs."},{"id":"manas-2010:p0073:b002:l029","ordinal":2750,"en":"Under the name of Kazakh"},{"id":"manas-2010:p0073:b002:l030","ordinal":2751,"en":"How many peoples he had!"},{"id":"manas-2010:p0073:b002:l031","ordinal":2752,"en":"They sought the child there;"},{"id":"manas-2010:p0073:b002:l032","ordinal":2753,"en":"Unable to find the child there,"},{"id":"manas-2010:p0073:b002:l033","ordinal":2754,"en":"At Karakan's in Bukara"},{"id":"manas-2010:p0073:b002:l034","ordinal":2755,"en":"They sought the child."},{"id":"manas-2010:p0073:b002:l035","ordinal":2756,"en":"Dwelling in Ruined Chambyl"},{"id":"manas-2010:p0073:b002:l036","ordinal":2757,"en":"Was Buuday Khan;"},{"id":"manas-2010:p0073:b002:l037","ordinal":2758,"en":"His people were so numerous."},{"id":"manas-2010:p0073:b002:l038","ordinal":2759,"en":"They gathered them all,"},{"id":"manas-2010:p0073:b002:l039","ordinal":2760,"en":"Made their young children file past."},{"id":"manas-2010:p0073:b002:l040","ordinal":2761,"en":"Unable to find the child there,"},{"id":"manas-2010:p0073:b002:l041","ordinal":2762,"en":"They turned back."},{"id":"manas-2010:p0073:b002:l042","ordinal":2763,"en":"Their destination was Samarkan;"},{"id":"manas-2010:p0073:b002:l043","ordinal":2764,"en":"Now they came to Samarkan."},{"id":"manas-2010:p0073:b002:l044","ordinal":2765,"en":"They demanded a child from each household,"},{"id":"manas-2010:p0073:b002:l045","ordinal":2766,"en":"Gathered them without leaving one."},{"id":"manas-2010:p0073:b002:l046","ordinal":2767,"en":"Their mothers raised an outcry,"},{"id":"manas-2010:p0073:b002:l047","ordinal":2768,"en":"Throwing the people into turmoil;"},{"id":"manas-2010:p0073:b002:l048","ordinal":2769,"en":"Their fathers wailed,"},{"id":"manas-2010:p0074:b002:l001","ordinal":2770,"en":"Breaking down the irrigation ditch."},{"id":"manas-2010:p0074:b002:l002","ordinal":2771,"en":"The entire people cried out;"},{"id":"manas-2010:p0074:b002:l003","ordinal":2772,"en":"For seven days the children filed past."},{"id":"manas-2010:p0074:b002:l004","ordinal":2773,"en":"Chong Eshen in Samarkan"},{"id":"manas-2010:p0074:b002:l005","ordinal":2774,"en":"Was a man of sacred gifts."},{"id":"manas-2010:p0074:b002:l006","ordinal":2775,"en":"In that Eshen's household"},{"id":"manas-2010:p0074:b002:l007","ordinal":2776,"en":"Was a boy named Manas,"},{"id":"manas-2010:p0074:b002:l008","ordinal":2777,"en":"A great strapping boy."},{"id":"manas-2010:p0074:b002:l009","ordinal":2778,"en":"“One who has been named Manas—"},{"id":"manas-2010:p0074:b002:l010","ordinal":2779,"en":"Is there such a child in your village?”"},{"id":"manas-2010:p0074:b002:l011","ordinal":2780,"en":"As they pressed the question,"},{"id":"manas-2010:p0074:b002:l012","ordinal":2781,"en":"“This is the child you seek,” they said."},{"id":"manas-2010:p0074:b002:l013","ordinal":2782,"en":"Now God had struck the people."},{"id":"manas-2010:p0074:b002:l014","ordinal":2783,"en":"“This child's name is Manas,”"},{"id":"manas-2010:p0074:b002:l015","ordinal":2784,"en":"The people began to say."},{"id":"manas-2010:p0074:b002:l016","ordinal":2785,"en":"“We gathered and put it in writing;"},{"id":"manas-2010:p0074:b002:l017","ordinal":2786,"en":"For the boy's bravery"},{"id":"manas-2010:p0074:b002:l018","ordinal":2787,"en":"We named him Jar Manas.”"},{"id":"manas-2010:p0074:b002:l019","ordinal":2788,"en":"Sharpening his wicked tongue,"},{"id":"manas-2010:p0074:b002:l020","ordinal":2789,"en":"Among the mass of Chinese"},{"id":"manas-2010:p0074:b002:l021","ordinal":2790,"en":"An old man spoke at length:"},{"id":"manas-2010:p0074:b002:l022","ordinal":2791,"en":"“This child is named Manas;"},{"id":"manas-2010:p0074:b002:l023","ordinal":2792,"en":"His strength is great,"},{"id":"manas-2010:p0074:b002:l024","ordinal":2793,"en":"His bravery is considerable."},{"id":"manas-2010:p0074:b002:l025","ordinal":2794,"en":"When he reached seven years,"},{"id":"manas-2010:p0074:b002:l026","ordinal":2795,"en":"He did whatever he pleased."},{"id":"manas-2010:p0074:b002:l027","ordinal":2796,"en":"Of the children at play,"},{"id":"manas-2010:p0074:b002:l028","ordinal":2797,"en":"He slaughtered exactly twelve."},{"id":"manas-2010:p0074:b002:l029","ordinal":2798,"en":"His father is the great Eshen;"},{"id":"manas-2010:p0074:b002:l030","ordinal":2799,"en":"You have found Manas without trouble."},{"id":"manas-2010:p0074:b002:l031","ordinal":2800,"en":"My champions, your luck truly is good!"},{"id":"manas-2010:p0074:b002:l032","ordinal":2801,"en":"This child is named Manas,"},{"id":"manas-2010:p0074:b002:l033","ordinal":2802,"en":"High-browed, fierce in menace."},{"id":"manas-2010:p0074:b002:l034","ordinal":2803,"en":"When you go to your khan, he will be pleased;"},{"id":"manas-2010:p0074:b002:l035","ordinal":2804,"en":"He lays low whoever challenges him.”"},{"id":"manas-2010:p0074:b002:l036","ordinal":2805,"en":"Heeding that old man's words,"},{"id":"manas-2010:p0074:b002:l037","ordinal":2806,"en":"The Chinese sorcerer,"},{"id":"manas-2010:p0074:b002:l038","ordinal":2807,"en":"Their diviner,"},{"id":"manas-2010:p0074:b002:l039","ordinal":2808,"en":"Their hero with second sight,"},{"id":"manas-2010:p0074:b002:l040","ordinal":2809,"en":"The great judge who had seen much,"},{"id":"manas-2010:p0074:b002:l041","ordinal":2810,"en":"Their champion named Döngö,"},{"id":"manas-2010:p0074:b002:l042","ordinal":2811,"en":"And the forty magicians of Beijing"},{"id":"manas-2010:p0074:b002:l043","ordinal":2812,"en":"Stood in a row."},{"id":"manas-2010:p0074:b002:l044","ordinal":2813,"en":"They stripped the boy naked"},{"id":"manas-2010:p0074:b002:l045","ordinal":2814,"en":"And made him file past."},{"id":"manas-2010:p0074:b002:l046","ordinal":2815,"en":"When the magician looked early,"},{"id":"manas-2010:p0074:b002:l047","ordinal":2816,"en":"When he sought the brave boy,"}]
