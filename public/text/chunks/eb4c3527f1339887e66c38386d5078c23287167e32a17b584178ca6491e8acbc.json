[{"id":"semetey-2-2013:p1216:b003:l016","ordinal":279297,"en":"When he faced them and leveled his spear,"},{"id":"semetey-2-2013:p1216:b003:l017","ordinal":279298,"en":"All mortals fell beneath it."},{"id":"semetey-2-2013:p1216:b003:l018","ordinal":279299,"en":"Of all whom ears had heard and eyes had seen,"},{"id":"semetey-2-2013:p1216:b003:l019","ordinal":279300,"en":"None was as mighty as Choro."},{"id":"semetey-2-2013:p1216:b003:l020","ordinal":279301,"en":"If you ask what Külchoro was like,"},{"id":"semetey-2-2013:p1216:b003:l021","ordinal":279302,"en":"He was the red ember of the saxaul,"},{"id":"semetey-2-2013:p1216:b003:l022","ordinal":279303,"en":"The tempered steel bullet of the firearm."},{"id":"semetey-2-2013:p1216:b003:l023","ordinal":279304,"en":"Both champion and lion,"},{"id":"semetey-2-2013:p1216:b003:l024","ordinal":279305,"en":"Among all sons born of men,"},{"id":"semetey-2-2013:p1216:b003:l025","ordinal":279306,"en":"No hero could equal him."},{"id":"semetey-2-2013:p1216:b003:l026","ordinal":279307,"en":"Armored against bullets,"},{"id":"semetey-2-2013:p1216:b003:l027","ordinal":279308,"en":"From beyond the forked pass and high ridge,"},{"id":"semetey-2-2013:p1216:b003:l028","ordinal":279309,"en":"Without letting them reach his heroic uncle,"},{"id":"semetey-2-2013:p1216:b003:l029","ordinal":279310,"en":"He met the earth-covering Jediger"},{"id":"semetey-2-2013:p1216:b003:l030","ordinal":279311,"en":"And attacked them in return."},{"id":"semetey-2-2013:p1216:b003:l031","ordinal":279312,"en":"Stooping low, he speared warriors."},{"id":"semetey-2-2013:p1216:b003:l032","ordinal":279313,"en":"The peerless champion, that gallant man,"},{"id":"semetey-2-2013:p1216:b003:l033","ordinal":279314,"en":"Impaled twenty or thirty at a thrust,"},{"id":"semetey-2-2013:p1216:b003:l034","ordinal":279315,"en":"Spearing all within his reach—"},{"id":"semetey-2-2013:p1216:b003:l035","ordinal":279316,"en":"Where now were their leaders?"},{"id":"semetey-2-2013:p1216:b003:l036","ordinal":279317,"en":"He speared all who assailed him—"},{"id":"semetey-2-2013:p1216:b003:l037","ordinal":279318,"en":"Where now were their bloodthirsty men?"},{"id":"semetey-2-2013:p1216:b003:l038","ordinal":279319,"en":"While peerless Manas lived,"},{"id":"semetey-2-2013:p1216:b003:l039","ordinal":279320,"en":"So that worthy men might receive gifts,"},{"id":"semetey-2-2013:p1216:b004:l001","ordinal":279321,"en":"Seven banners given as tribute"},{"id":"semetey-2-2013:p1216:b004:l002","ordinal":279322,"en":"Were planted in seven places."},{"id":"semetey-2-2013:p1216:b004:l003","ordinal":279323,"en":"Such was the consummate warrior,"},{"id":"semetey-2-2013:p1216:b004:l004","ordinal":279324,"en":"Making those he reached fall slain."},{"id":"semetey-2-2013:p1216:b004:l005","ordinal":279325,"en":"Six banners given by nobles"},{"id":"semetey-2-2013:p1216:b004:l006","ordinal":279326,"en":"He planted in six places,"},{"id":"semetey-2-2013:p1216:b004:l007","ordinal":279327,"en":"Driving them down and slaughtering them."},{"id":"semetey-2-2013:p1216:b004:l008","ordinal":279328,"en":"With a steel shaft and sharpened point,"},{"id":"semetey-2-2013:p1216:b004:l009","ordinal":279329,"en":"The keen-tipped ornamented spears"},{"id":"semetey-2-2013:p1216:b004:l010","ordinal":279330,"en":"Were thrust as they charged,"},{"id":"semetey-2-2013:p1216:b004:l011","ordinal":279331,"en":"Striking the measured ground,"},{"id":"semetey-2-2013:p1216:b004:l012","ordinal":279332,"en":"Clashing against one another."},{"id":"semetey-2-2013:p1216:b004:l013","ordinal":279333,"en":"He sent his spear whistling,"},{"id":"semetey-2-2013:p1216:b004:l014","ordinal":279334,"en":"And hurled the Jediger heroes"},{"id":"semetey-2-2013:p1216:b004:l015","ordinal":279335,"en":"From their saddles with his spear."},{"id":"semetey-2-2013:p1216:b004:l016","ordinal":279336,"en":"Making them cry, “Jakey, mercy!”"},{"id":"semetey-2-2013:p1216:b004:l017","ordinal":279337,"en":"He drove the Jediger"},{"id":"semetey-2-2013:p1216:b004:l018","ordinal":279338,"en":"Headlong before him."},{"id":"semetey-2-2013:p1216:b004:l019","ordinal":279339,"en":"Those places that had boasted of their strength,"},{"id":"semetey-2-2013:p1216:b004:l020","ordinal":279340,"en":"He subdued one after another."},{"id":"semetey-2-2013:p1216:b004:l021","ordinal":279341,"en":"Leaving none who fought him alive,"},{"id":"semetey-2-2013:p1216:b004:l022","ordinal":279342,"en":"He laid them low as he advanced."},{"id":"semetey-2-2013:p1216:b004:l023","ordinal":279343,"en":"Driving the Jediger headlong,"},{"id":"semetey-2-2013:p1216:b004:l024","ordinal":279344,"en":"He came onward, felling them."},{"id":"semetey-2-2013:p1216:b004:l025","ordinal":279345,"en":"The lionhood of noble-born Choro"},{"id":"semetey-2-2013:p1216:b004:l026","ordinal":279346,"en":"Was plain to see."},{"id":"semetey-2-2013:p1216:b004:l027","ordinal":279347,"en":"Spears lay scattered on the ground,"},{"id":"semetey-2-2013:p1216:b004:l028","ordinal":279348,"en":"Dead horses appeared"},{"id":"semetey-2-2013:p1216:b004:l029","ordinal":279349,"en":"With teeth bared wide."},{"id":"semetey-2-2013:p1216:b004:l030","ordinal":279350,"en":"Warriors lay stroking their mustaches,"},{"id":"semetey-2-2013:p1216:b004:l031","ordinal":279351,"en":"And heroes’ blood poured out."},{"id":"semetey-2-2013:p1216:b004:l032","ordinal":279352,"en":"Many more saw the matchlocks and commands,"},{"id":"semetey-2-2013:p1216:b004:l033","ordinal":279353,"en":"Watching from afar;"},{"id":"semetey-2-2013:p1216:b004:l034","ordinal":279354,"en":"Many more fled in panicked terror,"},{"id":"semetey-2-2013:p1216:b004:l035","ordinal":279355,"en":"While many lay dying."},{"id":"semetey-2-2013:p1216:b004:l036","ordinal":279356,"en":"Many more rushed about in deafening tumult,"},{"id":"semetey-2-2013:p1216:b004:l037","ordinal":279357,"en":"And many were struck with panic."},{"id":"semetey-2-2013:p1216:b004:l038","ordinal":279358,"en":"At the forked pass and high ridge,"},{"id":"semetey-2-2013:p1216:b004:l039","ordinal":279359,"en":"They could find no way of escape."},{"id":"semetey-2-2013:p1217:b003:l001","ordinal":279360,"en":"Many were already crossing beyond,"},{"id":"semetey-2-2013:p1217:b003:l002","ordinal":279361,"en":"Dropping their spears to the ground,"},{"id":"semetey-2-2013:p1217:b003:l003","ordinal":279362,"en":"Unable to stoop and pick them up,"},{"id":"semetey-2-2013:p1217:b003:l004","ordinal":279363,"en":"Many were fleeing onward."},{"id":"semetey-2-2013:p1217:b003:l005","ordinal":279364,"en":"Their saddle-cruppers snapped,"},{"id":"semetey-2-2013:p1217:b003:l006","ordinal":279365,"en":"And many a fleet steed"},{"id":"semetey-2-2013:p1217:b003:l007","ordinal":279366,"en":"Had its saddle slip onto its neck;"},{"id":"semetey-2-2013:p1217:b003:l008","ordinal":279367,"en":"Many a valiant warrior,"},{"id":"semetey-2-2013:p1217:b003:l009","ordinal":279368,"en":"Thinking, “Now we are doomed to die,”"},{"id":"semetey-2-2013:p1217:b003:l010","ordinal":279369,"en":"Was fleeing in terror."},{"id":"semetey-2-2013:p1217:b003:l011","ordinal":279370,"en":"In their frantic haste,"},{"id":"semetey-2-2013:p1217:b003:l012","ordinal":279371,"en":"Many trampled one another."},{"id":"semetey-2-2013:p1217:b003:l013","ordinal":279372,"en":"Many a swift racing steed"},{"id":"semetey-2-2013:p1217:b003:l014","ordinal":279373,"en":"Had its saddle slip beneath its belly"},{"id":"semetey-2-2013:p1217:b003:l015","ordinal":279374,"en":"And wandered about unharnessed."},{"id":"semetey-2-2013:p1217:b003:l016","ordinal":279375,"en":"“Father! Alas, my dear brother"},{"id":"semetey-2-2013:p1217:b003:l017","ordinal":279376,"en":"Died at such-and-such a place;"},{"id":"semetey-2-2013:p1217:b003:l018","ordinal":279377,"en":"Where shall I ever see him again?”"},{"id":"semetey-2-2013:p1217:b003:l019","ordinal":279378,"en":"Many wandered, wailing so."},{"id":"semetey-2-2013:p1217:b003:l020","ordinal":279379,"en":"Barefoot and bareheaded,"},{"id":"semetey-2-2013:p1217:b003:l021","ordinal":279380,"en":"Unable to die though wishing for death,"},{"id":"semetey-2-2013:p1217:b003:l022","ordinal":279381,"en":"Straining their wits for some escape,"},{"id":"semetey-2-2013:p1217:b003:l023","ordinal":279382,"en":"Many hid their precious lives"},{"id":"semetey-2-2013:p1217:b003:l024","ordinal":279383,"en":"In scattered places across the open steppe,"},{"id":"semetey-2-2013:p1217:b003:l025","ordinal":279384,"en":"And fled away."},{"id":"semetey-2-2013:p1217:b003:l026","ordinal":279385,"en":"When Külchoro wrought slaughter,"},{"id":"semetey-2-2013:p1217:b003:l027","ordinal":279386,"en":"There was no respite day or night;"},{"id":"semetey-2-2013:p1217:b003:l028","ordinal":279387,"en":"As the carnage raged,"},{"id":"semetey-2-2013:p1217:b003:l029","ordinal":279388,"en":"Many people fell sick with fever,"},{"id":"semetey-2-2013:p1217:b003:l030","ordinal":279389,"en":"And many were scattered before me."},{"id":"semetey-2-2013:p1217:b003:l031","ordinal":279390,"en":"Unable to find their bearings,"},{"id":"semetey-2-2013:p1217:b003:l032","ordinal":279391,"en":"Many panicked, helpless and distraught;"},{"id":"semetey-2-2013:p1217:b003:l033","ordinal":279392,"en":"Despairing of their wretched lives,"},{"id":"semetey-2-2013:p1217:b003:l034","ordinal":279393,"en":"Lamenting, “Now we are dead,”"},{"id":"semetey-2-2013:p1217:b003:l035","ordinal":279394,"en":"The warrior began the massacre."},{"id":"semetey-2-2013:p1217:b003:l036","ordinal":279395,"en":"All the common folk of Jediger,"},{"id":"semetey-2-2013:p1217:b003:l037","ordinal":279396,"en":"Suffering punishment in their very lives,"},{"id":"semetey-2-2013:p1217:b003:l038","ordinal":279397,"en":"Abandoned all hope of survival."},{"id":"semetey-2-2013:p1217:b003:l039","ordinal":279398,"en":"The dreadful battle and turmoil"},{"id":"semetey-2-2013:p1217:b005:l001","ordinal":279399,"en":"Were begun by the lone warrior;"},{"id":"semetey-2-2013:p1217:b005:l002","ordinal":279400,"en":"The Jediger, one and all,"},{"id":"semetey-2-2013:p1217:b005:l003","ordinal":279401,"en":"Found no refuge anywhere—"},{"id":"semetey-2-2013:p1217:b005:l004","ordinal":279402,"en":"Such was the fury of their clash—"},{"id":"semetey-2-2013:p1217:b005:l005","ordinal":279403,"en":"And found no place to hide."},{"id":"semetey-2-2013:p1217:b005:l006","ordinal":279404,"en":"The Jediger were seized by panic."},{"id":"semetey-2-2013:p1217:b005:l007","ordinal":279405,"en":"Their heroes Kyyaz and Kanchoro,"},{"id":"semetey-2-2013:p1217:b005:l008","ordinal":279406,"en":"Raising a tumult together,"},{"id":"semetey-2-2013:p1217:b005:l009","ordinal":279407,"en":"Fled, trampling over the people."},{"id":"semetey-2-2013:p1217:b005:l010","ordinal":279408,"en":"The terrified Jediger"},{"id":"semetey-2-2013:p1217:b005:l011","ordinal":279409,"en":"Fled, trampling even those two."},{"id":"semetey-2-2013:p1217:b005:l012","ordinal":279410,"en":"Seeing the Jediger, Kanchoro’s"},{"id":"semetey-2-2013:p1217:b005:l013","ordinal":279411,"en":"Hair bristled at the nape;"},{"id":"semetey-2-2013:p1217:b005:l014","ordinal":279412,"en":"As though ready to slaughter them,"},{"id":"semetey-2-2013:p1217:b005:l015","ordinal":279413,"en":"He twisted about, his body bristling,"},{"id":"semetey-2-2013:p1217:b005:l016","ordinal":279414,"en":"And roared in fury."},{"id":"semetey-2-2013:p1217:b005:l017","ordinal":279415,"en":"He turned the great fleeing host back"},{"id":"semetey-2-2013:p1217:b005:l018","ordinal":279416,"en":"And drove them together once more;"},{"id":"semetey-2-2013:p1217:b005:l019","ordinal":279417,"en":"Rumbling and working himself up,"},{"id":"semetey-2-2013:p1217:b005:l020","ordinal":279418,"en":"He addressed the Jediger:"},{"id":"semetey-2-2013:p1217:b005:l021","ordinal":279419,"en":"“Damn you, Jediger!"},{"id":"semetey-2-2013:p1217:b005:l022","ordinal":279420,"en":"You came saying you would fight,"},{"id":"semetey-2-2013:p1217:b005:l023","ordinal":279421,"en":"But fled and disgraced yourselves!"},{"id":"semetey-2-2013:p1217:b005:l024","ordinal":279422,"en":"After consulting two by two,"},{"id":"semetey-2-2013:p1217:b005:l025","ordinal":279423,"en":"What do you say now?"},{"id":"semetey-2-2013:p1217:b005:l026","ordinal":279424,"en":"Forgetting all your promises—"},{"id":"semetey-2-2013:p1217:b005:l027","ordinal":279425,"en":"Damn you, Jediger—"},{"id":"semetey-2-2013:p1217:b005:l028","ordinal":279426,"en":"You have proved yourselves heathens!"},{"id":"semetey-2-2013:p1217:b005:l029","ordinal":279427,"en":"Panicking in fear of Külchoro—"},{"id":"semetey-2-2013:p1217:b005:l030","ordinal":279428,"en":"Damn you, Jediger—"},{"id":"semetey-2-2013:p1217:b005:l031","ordinal":279429,"en":"You have proved yourselves faithless!"},{"id":"semetey-2-2013:p1217:b005:l032","ordinal":279430,"en":"Külchoro is one, while you are thousands;"},{"id":"semetey-2-2013:p1217:b005:l033","ordinal":279431,"en":"You Jediger are no men,"},{"id":"semetey-2-2013:p1217:b005:l034","ordinal":279432,"en":"But women, every one!"},{"id":"semetey-2-2013:p1217:b005:l035","ordinal":279433,"en":"You vast host of Jediger,"},{"id":"semetey-2-2013:p1217:b005:l036","ordinal":279434,"en":"You are no people, but heathens!"},{"id":"semetey-2-2013:p1217:b005:l037","ordinal":279435,"en":"While in the Seven Valleys you blustered,"},{"id":"semetey-2-2013:p1217:b005:l038","ordinal":279436,"en":"Posturing as though you would fight alone;"},{"id":"semetey-2-2013:p1217:b005:l039","ordinal":279437,"en":"Now you reel about, Jediger—"},{"id":"semetey-2-2013:p1218:b003:l001","ordinal":279438,"en":"Can a hero behave as you do?"},{"id":"semetey-2-2013:p1218:b003:l002","ordinal":279439,"en":"Will anyone prosper who calls you brave?"},{"id":"semetey-2-2013:p1218:b003:l003","ordinal":279440,"en":"I came to your Seven Valleys,"},{"id":"semetey-2-2013:p1218:b003:l004","ordinal":279441,"en":"Thinking yours was a worthy land;"},{"id":"semetey-2-2013:p1218:b003:l005","ordinal":279442,"en":"Oh, accursed Jediger,"},{"id":"semetey-2-2013:p1218:b003:l006","ordinal":279443,"en":"I came thinking you were a people!"},{"id":"semetey-2-2013:p1218:b003:l007","ordinal":279444,"en":"If I lose all faith in you, Jediger,"},{"id":"semetey-2-2013:p1218:b003:l008","ordinal":279445,"en":"I shall readily move back to Talas;"},{"id":"semetey-2-2013:p1218:b003:l009","ordinal":279446,"en":"Every day you have set my heart aflame."},{"id":"semetey-2-2013:p1218:b003:l010","ordinal":279447,"en":"Jediger, you have burned me within!"},{"id":"semetey-2-2013:p1218:b003:l011","ordinal":279448,"en":"You chattering Jediger,"},{"id":"semetey-2-2013:p1218:b003:l012","ordinal":279449,"en":"If you act so upon seeing his child,"},{"id":"semetey-2-2013:p1218:b003:l013","ordinal":279450,"en":"What will you do when you see his champion?"},{"id":"semetey-2-2013:p1218:b003:l014","ordinal":279451,"en":"If you act so upon seeing his warrior,"},{"id":"semetey-2-2013:p1218:b003:l015","ordinal":279452,"en":"What will you do when you see the great man himself?"},{"id":"semetey-2-2013:p1218:b003:l016","ordinal":279453,"en":"You vast host of Jediger,"},{"id":"semetey-2-2013:p1218:b003:l017","ordinal":279454,"en":"There is no boat upon the dark water;"},{"id":"semetey-2-2013:p1218:b003:l018","ordinal":279455,"en":"While your Kanchoro stands watching,"},{"id":"semetey-2-2013:p1218:b003:l019","ordinal":279456,"en":"None of you dares even raise an eyebrow!"},{"id":"semetey-2-2013:p1218:b003:l020","ordinal":279457,"en":"Make this slaughter truly glorious;"},{"id":"semetey-2-2013:p1218:b003:l021","ordinal":279458,"en":"Plunder all his possessions,"},{"id":"semetey-2-2013:p1218:b003:l022","ordinal":279459,"en":"Leaving not so much as a thread!"},{"id":"semetey-2-2013:p1218:b003:l023","ordinal":279460,"en":"You lanky, swarthy Jediger,"},{"id":"semetey-2-2013:p1218:b003:l024","ordinal":279461,"en":"Show what you can do in battle;"},{"id":"semetey-2-2013:p1218:b003:l025","ordinal":279462,"en":"Divide Semetey’s countless riches"},{"id":"semetey-2-2013:p1218:b003:l026","ordinal":279463,"en":"Precisely by the measure of the whip!"},{"id":"semetey-2-2013:p1218:b003:l027","ordinal":279464,"en":"Bring ruin upon his feast,"},{"id":"semetey-2-2013:p1218:b003:l028","ordinal":279465,"en":"Strike without wavering!"},{"id":"semetey-2-2013:p1218:b003:l029","ordinal":279466,"en":"Surround on every side"},{"id":"semetey-2-2013:p1218:b003:l030","ordinal":279467,"en":"The bloodthirsty man left horseless!"},{"id":"semetey-2-2013:p1218:b003:l031","ordinal":279468,"en":"Look how much ancestral fortune"},{"id":"semetey-2-2013:p1218:b003:l032","ordinal":279469,"en":"He inherited from his forefathers!"},{"id":"semetey-2-2013:p1218:b003:l033","ordinal":279470,"en":"Mighty on horseback but helpless in war,"},{"id":"semetey-2-2013:p1218:b003:l034","ordinal":279471,"en":"At the forked mountain pass"},{"id":"semetey-2-2013:p1218:b003:l035","ordinal":279472,"en":"The bloodthirsty man stands gaping;"},{"id":"semetey-2-2013:p1218:b003:l036","ordinal":279473,"en":"Those of you skilled with the spear,"},{"id":"semetey-2-2013:p1218:b003:l037","ordinal":279474,"en":"Charge shouting and thrust your spears!"},{"id":"semetey-2-2013:p1218:b003:l038","ordinal":279475,"en":"All your champions and elders,"},{"id":"semetey-2-2013:p1218:b003:l039","ordinal":279476,"en":"As though overtaken by slaughter,"},{"id":"semetey-2-2013:p1218:b004:l001","ordinal":279477,"en":"Go and perish together!"},{"id":"semetey-2-2013:p1218:b004:l002","ordinal":279478,"en":"All your strongmen and lions,"},{"id":"semetey-2-2013:p1218:b004:l003","ordinal":279479,"en":"Overwhelm the bloodthirsty son of Manas;"},{"id":"semetey-2-2013:p1218:b004:l004","ordinal":279480,"en":"Every one of you, swarm upon him!"},{"id":"semetey-2-2013:p1218:b004:l005","ordinal":279481,"en":"Thrusting spears and striking axes,"},{"id":"semetey-2-2013:p1218:b004:l006","ordinal":279482,"en":"All of you charge together!"},{"id":"semetey-2-2013:p1218:b004:l007","ordinal":279483,"en":"You vast host of Jediger,"},{"id":"semetey-2-2013:p1218:b004:l008","ordinal":279484,"en":"Heed these words of mine;"},{"id":"semetey-2-2013:p1218:b004:l009","ordinal":279485,"en":"You snarling, wretched people,"},{"id":"semetey-2-2013:p1218:b004:l010","ordinal":279486,"en":"Or you will be annihilated!"},{"id":"semetey-2-2013:p1218:b004:l011","ordinal":279487,"en":"If you do not heed my words,"},{"id":"semetey-2-2013:p1218:b004:l012","ordinal":279488,"en":"Along the Seven Valleys,"},{"id":"semetey-2-2013:p1218:b004:l013","ordinal":279489,"en":"In the hollow of Jerge-Tal,"},{"id":"semetey-2-2013:p1218:b004:l014","ordinal":279490,"en":"I shall plant my army’s standard."},{"id":"semetey-2-2013:p1218:b004:l015","ordinal":279491,"en":"If you stir against me, Jediger,"},{"id":"semetey-2-2013:p1218:b004:l016","ordinal":279492,"en":"I shall have every one of you slaughtered!"},{"id":"semetey-2-2013:p1218:b004:l017","ordinal":279493,"en":"In the hollow of Opol-Too,"},{"id":"semetey-2-2013:p1218:b004:l018","ordinal":279494,"en":"Down toward Andijan and Tarasha,"},{"id":"semetey-2-2013:p1218:b004:l019","ordinal":279495,"en":"Across the broad plain,"},{"id":"semetey-2-2013:p1218:b004:l020","ordinal":279496,"en":"I shall summon a mighty army"},{"id":"semetey-2-2013:p1218:b004:l021","ordinal":279497,"en":"And have it massacre your people,"},{"id":"semetey-2-2013:p1218:b004:l022","ordinal":279498,"en":"Leaving none untouched by slaughter!"},{"id":"semetey-2-2013:p1218:b004:l023","ordinal":279499,"en":"I shall bind the valiant Külchoro,"},{"id":"semetey-2-2013:p1218:b004:l024","ordinal":279500,"en":"My heroic kinsman, to my waist,"},{"id":"semetey-2-2013:p1218:b004:l025","ordinal":279501,"en":"And, setting myself against you, Jediger,"},{"id":"semetey-2-2013:p1218:b004:l026","ordinal":279502,"en":"Utterly wipe out your lineage!"},{"id":"semetey-2-2013:p1218:b004:l027","ordinal":279503,"en":"I shall level every hollow and hill;"},{"id":"semetey-2-2013:p1218:b004:l028","ordinal":279504,"en":"Do not trifle with me, Jediger!"},{"id":"semetey-2-2013:p1218:b004:l029","ordinal":279505,"en":"If I fail to bind your chiefs,"},{"id":"semetey-2-2013:p1218:b004:l030","ordinal":279506,"en":"If I fail to slaughter you all,"},{"id":"semetey-2-2013:p1218:b004:l031","ordinal":279507,"en":"May I die unworthy of the name Kanchoro,"},{"id":"semetey-2-2013:p1218:b004:l032","ordinal":279508,"en":"May I sink barren, as though never born!"},{"id":"semetey-2-2013:p1218:b004:l033","ordinal":279509,"en":"You Jediger who bar my way,"},{"id":"semetey-2-2013:p1218:b004:l034","ordinal":279510,"en":"You wretched people kindling your own deaths,"},{"id":"semetey-2-2013:p1218:b004:l035","ordinal":279511,"en":"Go on, try to flee—let me see!"},{"id":"semetey-2-2013:p1218:b004:l036","ordinal":279512,"en":"I shall raise an army from the Argyn,"},{"id":"semetey-2-2013:p1218:b004:l037","ordinal":279513,"en":"And muster a vast host of Kyrgyz;"},{"id":"semetey-2-2013:p1218:b004:l038","ordinal":279514,"en":"You sprawling Jediger,"},{"id":"semetey-2-2013:p1218:b004:l039","ordinal":279515,"en":"I shall track your yellow trail,"},{"id":"semetey-2-2013:p1219:b003:l001","ordinal":279516,"en":"Hounding and slaughtering you till you turn pale—"},{"id":"semetey-2-2013:p1219:b003:l002","ordinal":279517,"en":"Or may I and all my people die unborn!"},{"id":"semetey-2-2013:p1219:b003:l003","ordinal":279518,"en":"You cringing Jediger,"},{"id":"semetey-2-2013:p1219:b003:l004","ordinal":279519,"en":"Try to flee without leaving one behind!"},{"id":"semetey-2-2013:p1219:b003:l005","ordinal":279520,"en":"Let me see how you escape!”"},{"id":"semetey-2-2013:p1219:b003:l006","ordinal":279521,"en":"Roaring in fury,"},{"id":"semetey-2-2013:p1219:b003:l007","ordinal":279522,"en":"He drove the vast host of Jediger"},{"id":"semetey-2-2013:p1219:b003:l008","ordinal":279523,"en":"Back again in confusion."},{"id":"semetey-2-2013:p1219:b003:l009","ordinal":279524,"en":"The illustrious Kanchoro’s"},{"id":"semetey-2-2013:p1219:b003:l010","ordinal":279525,"en":"Eyes boiled like a boar’s;"},{"id":"semetey-2-2013:p1219:b003:l011","ordinal":279526,"en":"His broad, gate-like teeth"},{"id":"semetey-2-2013:p1219:b003:l012","ordinal":279527,"en":"Clashed as he ground them."},{"id":"semetey-2-2013:p1219:b003:l013","ordinal":279528,"en":"The people clamored and tumult arose;"},{"id":"semetey-2-2013:p1219:b003:l014","ordinal":279529,"en":"The warrior unleashed his wrath."},{"id":"semetey-2-2013:p1219:b003:l015","ordinal":279530,"en":"The Jediger wholly renounced"},{"id":"semetey-2-2013:p1219:b003:l016","ordinal":279531,"en":"Their fly-like lives on the spot."},{"id":"semetey-2-2013:p1219:b003:l017","ordinal":279532,"en":"How capable Kanchoro was:"},{"id":"semetey-2-2013:p1219:b003:l018","ordinal":279533,"en":"He drove the Jediger forward,"},{"id":"semetey-2-2013:p1219:b003:l019","ordinal":279534,"en":"As though he might devour them,"},{"id":"semetey-2-2013:p1219:b003:l020","ordinal":279535,"en":"And shouted at brave Kyyaz."},{"id":"semetey-2-2013:p1219:b003:l021","ordinal":279536,"en":"Making his mountain-bay horse surge,"},{"id":"semetey-2-2013:p1219:b003:l022","ordinal":279537,"en":"The mountain-like Kyyaz approached;"},{"id":"semetey-2-2013:p1219:b003:l023","ordinal":279538,"en":"And the seething Kanchoro"},{"id":"semetey-2-2013:p1219:b003:l024","ordinal":279539,"en":"Saw the fullness of his rage."},{"id":"semetey-2-2013:p1219:b003:l025","ordinal":279540,"en":"“Damn you, Jediger!"},{"id":"semetey-2-2013:p1219:b003:l026","ordinal":279541,"en":"I thought Kyyaz was a hero,"},{"id":"semetey-2-2013:p1219:b003:l027","ordinal":279542,"en":"But when the enemy appears, he flees—"},{"id":"semetey-2-2013:p1219:b003:l028","ordinal":279543,"en":"You have proved a woman, Kyyaz!"},{"id":"semetey-2-2013:p1219:b003:l029","ordinal":279544,"en":"The man you must fight is Semetey,"},{"id":"semetey-2-2013:p1219:b003:l030","ordinal":279545,"en":"Yet in your panic you are poised"},{"id":"semetey-2-2013:p1219:b003:l031","ordinal":279546,"en":"To scatter your own possessions!"},{"id":"semetey-2-2013:p1219:b003:l032","ordinal":279547,"en":"You panic-stricken Jediger,"},{"id":"semetey-2-2013:p1219:b003:l033","ordinal":279548,"en":"It is shameful beyond measure:"},{"id":"semetey-2-2013:p1219:b003:l034","ordinal":279549,"en":"You have come only to flee!"},{"id":"semetey-2-2013:p1219:b003:l035","ordinal":279550,"en":"The dream we saw has turned ill;"},{"id":"semetey-2-2013:p1219:b003:l036","ordinal":279551,"en":"Has there ever been, in all the ages,"},{"id":"semetey-2-2013:p1219:b003:l037","ordinal":279552,"en":"A people who fled from the field of battle?"}]
