[{"id":"semetey-2-2013:p1385:b005:l008","ordinal":292353,"en":"So Kanchoro spoke,"},{"id":"semetey-2-2013:p1385:b005:l009","ordinal":292354,"en":"And when he commanded, the forty wrestlers—"},{"id":"semetey-2-2013:p1385:b005:l010","ordinal":292355,"en":"Who cut off heads when told to take a cap,"},{"id":"semetey-2-2013:p1385:b005:l011","ordinal":292356,"en":"Who spilled their very souls when told to spill blood,"},{"id":"semetey-2-2013:p1385:b005:l012","ordinal":292357,"en":"Who drank poison when told to drink water—"},{"id":"semetey-2-2013:p1385:b005:l013","ordinal":292358,"en":"All forty wrestlers,"},{"id":"semetey-2-2013:p1385:b005:l014","ordinal":292359,"en":"Stronger than ordinary men,"},{"id":"semetey-2-2013:p1385:b005:l015","ordinal":292360,"en":"With their precious swords,"},{"id":"semetey-2-2013:p1385:b005:l016","ordinal":292361,"en":"Like men struck by slaughter,"},{"id":"semetey-2-2013:p1385:b005:l017","ordinal":292362,"en":"At the sound of Kanchoro’s voice"},{"id":"semetey-2-2013:p1385:b005:l018","ordinal":292363,"en":"All fell upon their task."},{"id":"semetey-2-2013:p1385:b005:l019","ordinal":292364,"en":"They never failed to do his bidding:"},{"id":"semetey-2-2013:p1385:b005:l020","ordinal":292365,"en":"To the two barren calves"},{"id":"semetey-2-2013:p1385:b005:l021","ordinal":292366,"en":"They bound her tightly by the waist."},{"id":"semetey-2-2013:p1385:b005:l022","ordinal":292367,"en":"While they abused your mother,"},{"id":"semetey-2-2013:p1385:b005:l023","ordinal":292368,"en":"While they heaped misery upon her,"},{"id":"semetey-2-2013:p1385:b005:l024","ordinal":292369,"en":"Before he had even finished speaking,"},{"id":"semetey-2-2013:p1385:b005:l025","ordinal":292370,"en":"Before anyone could say another word,"},{"id":"semetey-2-2013:p1385:b005:l026","ordinal":292371,"en":"Külchoro’s wife Akbala"},{"id":"semetey-2-2013:p1385:b005:l027","ordinal":292372,"en":"Came running in anguish,"},{"id":"semetey-2-2013:p1385:b005:l028","ordinal":292373,"en":"With the white dagger bought"},{"id":"semetey-2-2013:p1385:b005:l029","ordinal":292374,"en":"For sixty camels and forty colts"},{"id":"semetey-2-2013:p1385:b005:l030","ordinal":292375,"en":"Drawn ready from its sheath,"},{"id":"semetey-2-2013:p1385:b005:l031","ordinal":292376,"en":"Praying to the spirit"},{"id":"semetey-2-2013:p1385:b005:l032","ordinal":292377,"en":"Of her forefather who had passed into eternity."},{"id":"semetey-2-2013:p1385:b005:l033","ordinal":292378,"en":"She was the finest of women,"},{"id":"semetey-2-2013:p1385:b005:l034","ordinal":292379,"en":"The daughter of Jamgyrchy,"},{"id":"semetey-2-2013:p1385:b005:l035","ordinal":292380,"en":"One set apart from other mortals—"},{"id":"semetey-2-2013:p1385:b005:l036","ordinal":292381,"en":"That wife of Külchoro."},{"id":"semetey-2-2013:p1385:b005:l037","ordinal":292382,"en":"She had heard a tale from a gossip,"},{"id":"semetey-2-2013:p1385:b005:l038","ordinal":292383,"en":"Heard that her revered old mother"},{"id":"semetey-2-2013:p1385:b005:l039","ordinal":292384,"en":"Had been savagely mauled,"},{"id":"semetey-2-2013:p1386:b003:l001","ordinal":292385,"en":"Heard that Chürök had been taken as spoil"},{"id":"semetey-2-2013:p1386:b003:l002","ordinal":292386,"en":"And subjected to humiliation,"},{"id":"semetey-2-2013:p1386:b003:l003","ordinal":292387,"en":"Heard that in her old age Kanykey,"},{"id":"semetey-2-2013:p1386:b003:l004","ordinal":292388,"en":"Your mother, had been stripped of dignity"},{"id":"semetey-2-2013:p1386:b003:l005","ordinal":292389,"en":"And cruelly oppressed."},{"id":"semetey-2-2013:p1386:b003:l006","ordinal":292390,"en":"Wailing aloud, Akbala"},{"id":"semetey-2-2013:p1386:b003:l007","ordinal":292391,"en":"Plunged into mortal peril;"},{"id":"semetey-2-2013:p1386:b003:l008","ordinal":292392,"en":"The poor woman cast aside"},{"id":"semetey-2-2013:p1386:b003:l009","ordinal":292393,"en":"Her fragile life, believing herself already dead."},{"id":"semetey-2-2013:p1386:b003:l010","ordinal":292394,"en":"Her knees bent toward the ground,"},{"id":"semetey-2-2013:p1386:b003:l011","ordinal":292395,"en":"She ran on, wailing aloud,"},{"id":"semetey-2-2013:p1386:b003:l012","ordinal":292396,"en":"As though her ribs were breaking apart;"},{"id":"semetey-2-2013:p1386:b003:l013","ordinal":292397,"en":"Grievous torment and certain death"},{"id":"semetey-2-2013:p1386:b003:l014","ordinal":292398,"en":"Appeared before the doomed woman."},{"id":"semetey-2-2013:p1386:b003:l015","ordinal":292399,"en":"Immeasurably swift,"},{"id":"semetey-2-2013:p1386:b003:l016","ordinal":292400,"en":"The ill-fated woman sped on;"},{"id":"semetey-2-2013:p1386:b003:l017","ordinal":292401,"en":"With no care for her fragile life,"},{"id":"semetey-2-2013:p1386:b003:l018","ordinal":292402,"en":"Broad-rumped, with wide-swinging braids,"},{"id":"semetey-2-2013:p1386:b003:l019","ordinal":292403,"en":"The graceful, ill-fated woman"},{"id":"semetey-2-2013:p1386:b003:l020","ordinal":292404,"en":"Came upon the forty wrestlers"},{"id":"semetey-2-2013:p1386:b003:l021","ordinal":292405,"en":"And saw her mother Kanykey"},{"id":"semetey-2-2013:p1386:b003:l022","ordinal":292406,"en":"Suffering humiliation."},{"id":"semetey-2-2013:p1386:b003:l023","ordinal":292407,"en":"Unable to die though she burned with anguish,"},{"id":"semetey-2-2013:p1386:b003:l024","ordinal":292408,"en":"Before the throne in the palace,"},{"id":"semetey-2-2013:p1386:b003:l025","ordinal":292409,"en":"At the pit they had dug,"},{"id":"semetey-2-2013:p1386:b003:l026","ordinal":292410,"en":"Amid the abuses devised by Kanchoro"},{"id":"semetey-2-2013:p1386:b003:l027","ordinal":292411,"en":"And the violent uproar,"},{"id":"semetey-2-2013:p1386:b003:l028","ordinal":292412,"en":"Akbala entered the fray."},{"id":"semetey-2-2013:p1386:b003:l029","ordinal":292413,"en":"Her lovely hair, thick as meadow grass,"},{"id":"semetey-2-2013:p1386:b003:l030","ordinal":292414,"en":"She gathered and bound upon her crown;"},{"id":"semetey-2-2013:p1386:b003:l031","ordinal":292415,"en":"Külchoro’s coat of mail"},{"id":"semetey-2-2013:p1386:b003:l032","ordinal":292416,"en":"She drew down over her head."},{"id":"semetey-2-2013:p1386:b003:l033","ordinal":292417,"en":"A matchlessly swift gray three-year-old,"},{"id":"semetey-2-2013:p1386:b003:l034","ordinal":292418,"en":"The foal of a young mare,"},{"id":"semetey-2-2013:p1386:b003:l035","ordinal":292419,"en":"A horse born like the whirlwind—"},{"id":"semetey-2-2013:p1386:b003:l036","ordinal":292420,"en":"Tucking up her flowing dress,"},{"id":"semetey-2-2013:p1386:b003:l037","ordinal":292421,"en":"She sprang bareback upon it."},{"id":"semetey-2-2013:p1386:b003:l038","ordinal":292422,"en":"Wheeling the gray horse about,"},{"id":"semetey-2-2013:p1386:b003:l039","ordinal":292423,"en":"She struck down seven"},{"id":"semetey-2-2013:p1386:b004:l001","ordinal":292424,"en":"Of the wrestlers and sent them sprawling;"},{"id":"semetey-2-2013:p1386:b004:l002","ordinal":292425,"en":"She made them swallow their fill of blows"},{"id":"semetey-2-2013:p1386:b004:l003","ordinal":292426,"en":"And cry, “Mercy, daughter-in-law!”"},{"id":"semetey-2-2013:p1386:b004:l004","ordinal":292427,"en":"Akbala drove them onward."},{"id":"semetey-2-2013:p1386:b004:l005","ordinal":292428,"en":"Every wrestler who came near,"},{"id":"semetey-2-2013:p1386:b004:l006","ordinal":292429,"en":"She slashed and stabbed with her dagger;"},{"id":"semetey-2-2013:p1386:b004:l007","ordinal":292430,"en":"Akbala laid them low."},{"id":"semetey-2-2013:p1386:b004:l008","ordinal":292431,"en":"Though they were mighty veteran wrestlers,"},{"id":"semetey-2-2013:p1386:b004:l009","ordinal":292432,"en":"All fled from the woman,"},{"id":"semetey-2-2013:p1386:b004:l010","ordinal":292433,"en":"As though slaughter had fallen upon them;"},{"id":"semetey-2-2013:p1386:b004:l011","ordinal":292434,"en":"They fled for their lives."},{"id":"semetey-2-2013:p1386:b004:l012","ordinal":292435,"en":"Into the gated palace,"},{"id":"semetey-2-2013:p1386:b004:l013","ordinal":292436,"en":"Into Chachykey’s stronghold,"},{"id":"semetey-2-2013:p1386:b004:l014","ordinal":292437,"en":"Into the garden pitched for royalty,"},{"id":"semetey-2-2013:p1386:b004:l015","ordinal":292438,"en":"Into the encampment of Khan Kanchoro,"},{"id":"semetey-2-2013:p1386:b004:l016","ordinal":292439,"en":"Akbala drove the wrestlers,"},{"id":"semetey-2-2013:p1386:b004:l017","ordinal":292440,"en":"Sending them staggering inside."},{"id":"semetey-2-2013:p1386:b004:l018","ordinal":292441,"en":"Dealing with each in turn,"},{"id":"semetey-2-2013:p1386:b004:l019","ordinal":292442,"en":"Akbala laid them low."},{"id":"semetey-2-2013:p1386:b004:l020","ordinal":292443,"en":"“We have been disgraced by a young wife!"},{"id":"semetey-2-2013:p1386:b004:l021","ordinal":292444,"en":"Some of us have been killed!"},{"id":"semetey-2-2013:p1386:b004:l022","ordinal":292445,"en":"We have been disgraced by a woman!"},{"id":"semetey-2-2013:p1386:b004:l023","ordinal":292446,"en":"Some of us are dead!”"},{"id":"semetey-2-2013:p1386:b004:l024","ordinal":292447,"en":"The wrestlers fled inside;"},{"id":"semetey-2-2013:p1386:b004:l025","ordinal":292448,"en":"And Kanchoro learned"},{"id":"semetey-2-2013:p1386:b004:l026","ordinal":292449,"en":"That they had come stumbling in."},{"id":"semetey-2-2013:p1386:b004:l027","ordinal":292450,"en":"Once Kanchoro understood,"},{"id":"semetey-2-2013:p1386:b004:l028","ordinal":292451,"en":"He leapt grimly from his throne"},{"id":"semetey-2-2013:p1386:b004:l029","ordinal":292452,"en":"And ran out through the gate."},{"id":"semetey-2-2013:p1386:b004:l030","ordinal":292453,"en":"Poor Akbala came charging,"},{"id":"semetey-2-2013:p1386:b004:l031","ordinal":292454,"en":"Driving the wrestlers"},{"id":"semetey-2-2013:p1386:b004:l032","ordinal":292455,"en":"And penning them against the gate,"},{"id":"semetey-2-2013:p1386:b004:l033","ordinal":292456,"en":"When from farther in, puffed with pride,"},{"id":"semetey-2-2013:p1386:b004:l034","ordinal":292457,"en":"The accursed firebrand,"},{"id":"semetey-2-2013:p1386:b004:l035","ordinal":292458,"en":"The scorched madman,"},{"id":"semetey-2-2013:p1386:b004:l036","ordinal":292459,"en":"Kanchoro suddenly appeared."},{"id":"semetey-2-2013:p1386:b004:l037","ordinal":292460,"en":"When she saw Kanchoro,"},{"id":"semetey-2-2013:p1386:b004:l038","ordinal":292461,"en":"Valiant Akbala"},{"id":"semetey-2-2013:p1386:b004:l039","ordinal":292462,"en":"Unleashed her terrible fury."},{"id":"semetey-2-2013:p1387:b003:l001","ordinal":292463,"en":"At the mouth of the gate, Kanchoro"},{"id":"semetey-2-2013:p1387:b003:l002","ordinal":292464,"en":"Struck her in the lung"},{"id":"semetey-2-2013:p1387:b003:l003","ordinal":292465,"en":"With his spear and flung her aside."},{"id":"semetey-2-2013:p1387:b003:l004","ordinal":292466,"en":"Her battle cry split the stones"},{"id":"semetey-2-2013:p1387:b003:l005","ordinal":292467,"en":"As she bore down upon Kanchoro,"},{"id":"semetey-2-2013:p1387:b003:l006","ordinal":292468,"en":"Just as she was about to reach the warrior"},{"id":"semetey-2-2013:p1387:b003:l007","ordinal":292469,"en":"And destroy him utterly."},{"id":"semetey-2-2013:p1387:b003:l008","ordinal":292470,"en":"But Kanchoro was well prepared:"},{"id":"semetey-2-2013:p1387:b003:l009","ordinal":292471,"en":"He had fitted his weapon with black horsehair,"},{"id":"semetey-2-2013:p1387:b003:l010","ordinal":292472,"en":"Sighting and balancing it against the foe,"},{"id":"semetey-2-2013:p1387:b003:l011","ordinal":292473,"en":"Had forged grooves into its iron,"},{"id":"semetey-2-2013:p1387:b003:l012","ordinal":292474,"en":"And honed it like a wolf’s tongue."},{"id":"semetey-2-2013:p1387:b003:l013","ordinal":292475,"en":"Lest it slip from the hand in haste,"},{"id":"semetey-2-2013:p1387:b003:l014","ordinal":292476,"en":"He had wound it with yellow brass;"},{"id":"semetey-2-2013:p1387:b003:l015","ordinal":292477,"en":"When struck by a switch it rang aloud,"},{"id":"semetey-2-2013:p1387:b003:l016","ordinal":292478,"en":"Singing like a war drum."},{"id":"semetey-2-2013:p1387:b003:l017","ordinal":292479,"en":"From an irgay shrub at the foot of Opol Mountain,"},{"id":"semetey-2-2013:p1387:b003:l018","ordinal":292480,"en":"Torn out by the roots"},{"id":"semetey-2-2013:p1387:b003:l019","ordinal":292481,"en":"And twisted by wrestlers,"},{"id":"semetey-2-2013:p1387:b003:l020","ordinal":292482,"en":"He had made its sturdy shaft."},{"id":"semetey-2-2013:p1387:b003:l021","ordinal":292483,"en":"Where the grooves lay open,"},{"id":"semetey-2-2013:p1387:b003:l022","ordinal":292484,"en":"He had wrapped it with sinew,"},{"id":"semetey-2-2013:p1387:b003:l023","ordinal":292485,"en":"And to ensure a firmer grip"},{"id":"semetey-2-2013:p1387:b003:l024","ordinal":292486,"en":"Had soaked it through with glue."},{"id":"semetey-2-2013:p1387:b003:l025","ordinal":292487,"en":"He had covered it in camel-hide"},{"id":"semetey-2-2013:p1387:b003:l026","ordinal":292488,"en":"And fitted the shaft for war."},{"id":"semetey-2-2013:p1387:b003:l027","ordinal":292489,"en":"Such was Khan Kanchoro’s spear—"},{"id":"semetey-2-2013:p1387:b003:l028","ordinal":292490,"en":"So strong and cunningly fashioned."},{"id":"semetey-2-2013:p1387:b003:l029","ordinal":292491,"en":"The seasoned slave, that wolf of war,"},{"id":"semetey-2-2013:p1387:b003:l030","ordinal":292492,"en":"Had entered many battles before;"},{"id":"semetey-2-2013:p1387:b003:l031","ordinal":292493,"en":"In the days of the gray-maned leopard"},{"id":"semetey-2-2013:p1387:b003:l032","ordinal":292494,"en":"The hardened slave had seen much."},{"id":"semetey-2-2013:p1387:b003:l033","ordinal":292495,"en":"He was skilled in the handling of spears,"},{"id":"semetey-2-2013:p1387:b003:l034","ordinal":292496,"en":"And in every circumstance"},{"id":"semetey-2-2013:p1387:b003:l035","ordinal":292497,"en":"The sturdy slave found the surest stratagem."},{"id":"semetey-2-2013:p1387:b003:l036","ordinal":292498,"en":"Holding the iron-and-brass spear"},{"id":"semetey-2-2013:p1387:b003:l037","ordinal":292499,"en":"Short beneath its blade,"},{"id":"semetey-2-2013:p1387:b003:l038","ordinal":292500,"en":"Aiming this side of the ribs,"},{"id":"semetey-2-2013:p1387:b003:l039","ordinal":292501,"en":"At the edge of lung and liver,"},{"id":"semetey-2-2013:p1387:b005:l001","ordinal":292502,"en":"The raging swine struck."},{"id":"semetey-2-2013:p1387:b005:l002","ordinal":292503,"en":"When the practiced swine struck,"},{"id":"semetey-2-2013:p1387:b005:l003","ordinal":292504,"en":"The gray horse crumpled and fell,"},{"id":"semetey-2-2013:p1387:b005:l004","ordinal":292505,"en":"And poor Akbala plunged straight down."},{"id":"semetey-2-2013:p1387:b005:l005","ordinal":292506,"en":"“She is truly my enemy,”"},{"id":"semetey-2-2013:p1387:b005:l006","ordinal":292507,"en":"Thought Khan Kanchoro,"},{"id":"semetey-2-2013:p1387:b005:l007","ordinal":292508,"en":"And an incurable hatred lodged in his heart."},{"id":"semetey-2-2013:p1387:b005:l008","ordinal":292509,"en":"His dagger-bearing wrestlers"},{"id":"semetey-2-2013:p1387:b005:l009","ordinal":292510,"en":"Closed fiercely around"},{"id":"semetey-2-2013:p1387:b005:l010","ordinal":292511,"en":"That woman Akbala."},{"id":"semetey-2-2013:p1387:b005:l011","ordinal":292512,"en":"Before the white dagger in her hand"},{"id":"semetey-2-2013:p1387:b005:l012","ordinal":292513,"en":"Could rise and stab,"},{"id":"semetey-2-2013:p1387:b005:l013","ordinal":292514,"en":"Before she could settle the uproar,"},{"id":"semetey-2-2013:p1387:b005:l014","ordinal":292515,"en":"Before she could slaughter five or six,"},{"id":"semetey-2-2013:p1387:b005:l015","ordinal":292516,"en":"The ready Kanchoro"},{"id":"semetey-2-2013:p1387:b005:l016","ordinal":292517,"en":"Found yet another way:"},{"id":"semetey-2-2013:p1387:b005:l017","ordinal":292518,"en":"Taking his golden-bladed battle-axe,"},{"id":"semetey-2-2013:p1387:b005:l018","ordinal":292519,"en":"The practiced Kanchoro"},{"id":"semetey-2-2013:p1387:b005:l019","ordinal":292520,"en":"Struck from Akbala’s hand"},{"id":"semetey-2-2013:p1387:b005:l020","ordinal":292521,"en":"The white dagger."},{"id":"semetey-2-2013:p1387:b005:l021","ordinal":292522,"en":"Deprived of her white dagger,"},{"id":"semetey-2-2013:p1387:b005:l022","ordinal":292523,"en":"Akbala fell into the snare."},{"id":"semetey-2-2013:p1387:b005:l023","ordinal":292524,"en":"Her ribs felt torn apart,"},{"id":"semetey-2-2013:p1387:b005:l024","ordinal":292525,"en":"Tears poured from her eyes,"},{"id":"semetey-2-2013:p1387:b005:l025","ordinal":292526,"en":"Her nose ran like a spring,"},{"id":"semetey-2-2013:p1387:b005:l026","ordinal":292527,"en":"And all around the young woman"},{"id":"semetey-2-2013:p1387:b005:l027","ordinal":292528,"en":"A clamor rose to split the sky—"},{"id":"semetey-2-2013:p1387:b005:l028","ordinal":292529,"en":"Akbala had been captured."},{"id":"semetey-2-2013:p1387:b005:l029","ordinal":292530,"en":"Into a misery no struggling could escape,"},{"id":"semetey-2-2013:p1387:b005:l030","ordinal":292531,"en":"Akbala had fallen."},{"id":"semetey-2-2013:p1387:b005:l031","ordinal":292532,"en":"Then Akbala,"},{"id":"semetey-2-2013:p1387:b005:l032","ordinal":292533,"en":"At the gateway before Kanchoro,"},{"id":"semetey-2-2013:p1387:b005:l033","ordinal":292534,"en":"Spoke these words to him,"},{"id":"semetey-2-2013:p1387:b005:l034","ordinal":292535,"en":"Words of dreadful grief to those who understood:"},{"id":"semetey-2-2013:p1387:b005:l035","ordinal":292536,"en":"“You warrior-slave who slaughtered your lord,"},{"id":"semetey-2-2013:p1387:b005:l036","ordinal":292537,"en":"You vile slave who sets himself up as a prince!"},{"id":"semetey-2-2013:p1387:b005:l037","ordinal":292538,"en":"What has come over you, infidel slave,"},{"id":"semetey-2-2013:p1387:b005:l038","ordinal":292539,"en":"That you would massacre us all without heirs—"},{"id":"semetey-2-2013:p1387:b005:l039","ordinal":292540,"en":"Helpless women and little children—"},{"id":"semetey-2-2013:p1388:b003:l001","ordinal":292541,"en":"The feeble old and foolish young—"},{"id":"semetey-2-2013:p1388:b003:l002","ordinal":292542,"en":"And inflict such tyranny,"},{"id":"semetey-2-2013:p1388:b003:l003","ordinal":292543,"en":"Plunder and destroy us,"},{"id":"semetey-2-2013:p1388:b003:l004","ordinal":292544,"en":"And wipe us out completely,"},{"id":"semetey-2-2013:p1388:b003:l005","ordinal":292545,"en":"Shouting as you thrust your spear,"},{"id":"semetey-2-2013:p1388:b003:l006","ordinal":292546,"en":"Slaying the khans outright,"},{"id":"semetey-2-2013:p1388:b003:l007","ordinal":292547,"en":"Killing people on every side,"},{"id":"semetey-2-2013:p1388:b003:l008","ordinal":292548,"en":"And utterly erasing our line?"},{"id":"semetey-2-2013:p1388:b003:l009","ordinal":292549,"en":"Were we born on a barren black cliff,"},{"id":"semetey-2-2013:p1388:b003:l010","ordinal":292550,"en":"Or are we less than a khan’s children?"},{"id":"semetey-2-2013:p1388:b003:l011","ordinal":292551,"en":"Were you the one burdened with grief?"},{"id":"semetey-2-2013:p1388:b003:l012","ordinal":292552,"en":"Were we not the Chinese who butchered"},{"id":"semetey-2-2013:p1388:b003:l013","ordinal":292553,"en":"Your bloodthirsty father Chubak"},{"id":"semetey-2-2013:p1388:b003:l014","ordinal":292554,"en":"And left him lying dead?"},{"id":"semetey-2-2013:p1388:b003:l015","ordinal":292555,"en":"Your vaunted courage has no equal,"},{"id":"semetey-2-2013:p1388:b003:l016","ordinal":292556,"en":"But your mother’s vengeance is not upon us;"},{"id":"semetey-2-2013:p1388:b003:l017","ordinal":292557,"en":"Your swaggering has no equal,"},{"id":"semetey-2-2013:p1388:b003:l018","ordinal":292558,"en":"Yet no vengeance for your kin lies here!"},{"id":"semetey-2-2013:p1388:b003:l019","ordinal":292559,"en":"Your father was a roaring beast of a slave,"},{"id":"semetey-2-2013:p1388:b003:l020","ordinal":292560,"en":"But did we slaughter his whole village?"},{"id":"semetey-2-2013:p1388:b003:l021","ordinal":292561,"en":"Did we settle the score without measure?"},{"id":"semetey-2-2013:p1388:b003:l022","ordinal":292562,"en":"Did we carry off the world,"},{"id":"semetey-2-2013:p1388:b003:l023","ordinal":292563,"en":"Or scatter silver coins in its corners?"},{"id":"semetey-2-2013:p1388:b003:l024","ordinal":292564,"en":"Did we flee in pursuit of wild asses,"},{"id":"semetey-2-2013:p1388:b003:l025","ordinal":292565,"en":"Or scatter coins from our saddlebags?"},{"id":"semetey-2-2013:p1388:b003:l026","ordinal":292566,"en":"Did we ruin your standing grain,"},{"id":"semetey-2-2013:p1388:b003:l027","ordinal":292567,"en":"Or slaughter your forefather Akbaltay?"},{"id":"semetey-2-2013:p1388:b003:l028","ordinal":292568,"en":"Accursed madman,"},{"id":"semetey-2-2013:p1388:b003:l029","ordinal":292569,"en":"You drove my caravan from Keng-Kol;"},{"id":"semetey-2-2013:p1388:b003:l030","ordinal":292570,"en":"Alas, before this swaggering slave,"},{"id":"semetey-2-2013:p1388:b003:l031","ordinal":292571,"en":"Accursed be my womanhood—"},{"id":"semetey-2-2013:p1388:b003:l032","ordinal":292572,"en":"I cannot take my revenge!"},{"id":"semetey-2-2013:p1388:b003:l033","ordinal":292573,"en":"You slaughtered my people in Talas;"},{"id":"semetey-2-2013:p1388:b003:l034","ordinal":292574,"en":"Slave and beggar, you have cruelly"},{"id":"semetey-2-2013:p1388:b003:l035","ordinal":292575,"en":"Stripped me of all dignity!"},{"id":"semetey-2-2013:p1388:b003:l036","ordinal":292576,"en":"By heaven, I shall scatter your caravan from Chatkal!"},{"id":"semetey-2-2013:p1388:b003:l037","ordinal":292577,"en":"Allah, Allah, Creator of the open plain,"},{"id":"semetey-2-2013:p1388:b003:l038","ordinal":292578,"en":"When shall I ever take my revenge?!”"},{"id":"semetey-2-2013:p1388:b003:l039","ordinal":292579,"en":"As the woman wailed,"},{"id":"semetey-2-2013:p1388:b004:l001","ordinal":292580,"en":"Kanchoro did not look at her."},{"id":"semetey-2-2013:p1388:b004:l002","ordinal":292581,"en":"As the young wife lamented,"},{"id":"semetey-2-2013:p1388:b004:l003","ordinal":292582,"en":"He remained utterly unmoved;"},{"id":"semetey-2-2013:p1388:b004:l004","ordinal":292583,"en":"However many words a woman spoke,"},{"id":"semetey-2-2013:p1388:b004:l005","ordinal":292584,"en":"The ill-starred Kanchoro"},{"id":"semetey-2-2013:p1388:b004:l006","ordinal":292585,"en":"Did not value them a scrap."},{"id":"semetey-2-2013:p1388:b004:l007","ordinal":292586,"en":"Then Chachykey within the fortress,"},{"id":"semetey-2-2013:p1388:b004:l008","ordinal":292587,"en":"Your great sister-in-law with a rump broad as an embrace,"},{"id":"semetey-2-2013:p1388:b004:l009","ordinal":292588,"en":"Shouted down from the tower"},{"id":"semetey-2-2013:p1388:b004:l010","ordinal":292589,"en":"And summoned the forty wrestlers;"},{"id":"semetey-2-2013:p1388:b004:l011","ordinal":292590,"en":"Chachykey issued her decree."},{"id":"semetey-2-2013:p1388:b004:l012","ordinal":292591,"en":"Because Akbala had spoken,"},{"id":"semetey-2-2013:p1388:b004:l013","ordinal":292592,"en":"Chachykey dealt harshly with her:"},{"id":"semetey-2-2013:p1388:b004:l014","ordinal":292593,"en":"“Slit the soles of that cackling infidel,"},{"id":"semetey-2-2013:p1388:b004:l015","ordinal":292594,"en":"That woman called Akbala, and rub in salt;"},{"id":"semetey-2-2013:p1388:b004:l016","ordinal":292595,"en":"Cut open her crown and put worms in it,"},{"id":"semetey-2-2013:p1388:b004:l017","ordinal":292596,"en":"And let them fester there;"},{"id":"semetey-2-2013:p1388:b004:l018","ordinal":292597,"en":"Dress her in a rough homespun coat,"},{"id":"semetey-2-2013:p1388:b004:l019","ordinal":292598,"en":"Mount her on a lanky mare,"},{"id":"semetey-2-2013:p1388:b004:l020","ordinal":292599,"en":"Send her after the sheep,"},{"id":"semetey-2-2013:p1388:b004:l021","ordinal":292600,"en":"And make the wretch tend livestock."},{"id":"semetey-2-2013:p1388:b004:l022","ordinal":292601,"en":"Break the former fury"},{"id":"semetey-2-2013:p1388:b004:l023","ordinal":292602,"en":"Of that rude and reckless woman,"},{"id":"semetey-2-2013:p1388:b004:l024","ordinal":292603,"en":"That bellowing infidel."},{"id":"semetey-2-2013:p1388:b004:l025","ordinal":292604,"en":"Look upon our Khan Kanchoro,"},{"id":"semetey-2-2013:p1388:b004:l026","ordinal":292605,"en":"And look upon the insolence"},{"id":"semetey-2-2013:p1388:b004:l027","ordinal":292606,"en":"Of that bellowing woman!"},{"id":"semetey-2-2013:p1388:b004:l028","ordinal":292607,"en":"Gather all your strength against her;"},{"id":"semetey-2-2013:p1388:b004:l029","ordinal":292608,"en":"Break the swelling fury"}]
