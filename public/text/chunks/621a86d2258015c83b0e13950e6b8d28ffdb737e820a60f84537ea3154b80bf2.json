[{"id":"semetey-1-2013:p1125:b003:l038","ordinal":162049,"en":"What fool gave this man"},{"id":"semetey-1-2013:p1125:b003:l039","ordinal":162050,"en":"The name hero Kökchö?\""},{"id":"semetey-1-2013:p1125:b004:l001","ordinal":162051,"en":"Seeing Kökchö, Ezkara mocked him,"},{"id":"semetey-1-2013:p1125:b004:l002","ordinal":162052,"en":"Tormented him,"},{"id":"semetey-1-2013:p1125:b004:l003","ordinal":162053,"en":"And trampled the many Kazakhs."},{"id":"semetey-1-2013:p1125:b004:l004","ordinal":162054,"en":"On this nearer side"},{"id":"semetey-1-2013:p1125:b004:l005","ordinal":162055,"en":"Was elbow-sized hero Agysh,"},{"id":"semetey-1-2013:p1125:b004:l006","ordinal":162056,"en":"His whole body sinew."},{"id":"semetey-1-2013:p1125:b004:l007","ordinal":162057,"en":"He looked upon him"},{"id":"semetey-1-2013:p1125:b004:l008","ordinal":162058,"en":"And assessed him closely."},{"id":"semetey-1-2013:p1125:b004:l009","ordinal":162059,"en":"Every soul who saw him felt content;"},{"id":"semetey-1-2013:p1125:b004:l010","ordinal":162060,"en":"A champion on foot, useless on horseback,"},{"id":"semetey-1-2013:p1125:b004:l011","ordinal":162061,"en":"He set fire to those who grappled with him."},{"id":"semetey-1-2013:p1125:b004:l012","ordinal":162062,"en":"Bull-necked, with thighs like a stallion,"},{"id":"semetey-1-2013:p1125:b004:l013","ordinal":162063,"en":"His build differed from a man's;"},{"id":"semetey-1-2013:p1125:b004:l014","ordinal":162064,"en":"He ruined those who wrestled him."},{"id":"semetey-1-2013:p1125:b004:l015","ordinal":162065,"en":"When he thrust his spear and shouted,"},{"id":"semetey-1-2013:p1125:b004:l016","ordinal":162066,"en":"He possessed great skill."},{"id":"semetey-1-2013:p1125:b004:l017","ordinal":162067,"en":"When he gripped the trigger and drew the bow,"},{"id":"semetey-1-2013:p1125:b004:l018","ordinal":162068,"en":"He possessed great prowess."},{"id":"semetey-1-2013:p1125:b004:l019","ordinal":162069,"en":"With the chest of a hungry lion"},{"id":"semetey-1-2013:p1125:b004:l020","ordinal":162070,"en":"And the eyes of a hunting eagle,"},{"id":"semetey-1-2013:p1125:b004:l021","ordinal":162071,"en":"He raised high at the feast"},{"id":"semetey-1-2013:p1125:b004:l022","ordinal":162072,"en":"A fine steel-patterned spear,"},{"id":"semetey-1-2013:p1125:b004:l023","ordinal":162073,"en":"And threw down and crushed"},{"id":"semetey-1-2013:p1125:b004:l024","ordinal":162074,"en":"The champion who faced him."},{"id":"semetey-1-2013:p1125:b004:l025","ordinal":162075,"en":"Spear shafts bent at the middle"},{"id":"semetey-1-2013:p1125:b004:l026","ordinal":162076,"en":"If they unexpectedly quarreled;"},{"id":"semetey-1-2013:p1125:b004:l027","ordinal":162077,"en":"In Beijing of Kakan-Chyn,"},{"id":"semetey-1-2013:p1125:b004:l028","ordinal":162078,"en":"They would joust this way for six days.\""},{"id":"semetey-1-2013:p1125:b004:l029","ordinal":162079,"en":"He took a slight liking"},{"id":"semetey-1-2013:p1125:b004:l030","ordinal":162080,"en":"To elbow-sized Agysh."},{"id":"semetey-1-2013:p1125:b004:l031","ordinal":162081,"en":"Raging upon a pale-gray stake of a horse,"},{"id":"semetey-1-2013:p1125:b004:l032","ordinal":162082,"en":"Surging straight before him,"},{"id":"semetey-1-2013:p1125:b004:l033","ordinal":162083,"en":"Kökbörü appeared;"},{"id":"semetey-1-2013:p1125:b004:l034","ordinal":162084,"en":"He assessed him."},{"id":"semetey-1-2013:p1125:b004:l035","ordinal":162085,"en":"His fortune was complete;"},{"id":"semetey-1-2013:p1125:b004:l036","ordinal":162086,"en":"Kökbörü, son of Urumkan,"},{"id":"semetey-1-2013:p1125:b004:l037","ordinal":162087,"en":"Was a merciless hero."},{"id":"semetey-1-2013:p1125:b004:l038","ordinal":162088,"en":"Broad-chested and wide-breasted,"},{"id":"semetey-1-2013:p1125:b004:l039","ordinal":162089,"en":"Both champion and lion."},{"id":"semetey-1-2013:p1126:b003:l001","ordinal":162090,"en":"His beard was sparse, hair by hair;"},{"id":"semetey-1-2013:p1126:b003:l002","ordinal":162091,"en":"He was beardless."},{"id":"semetey-1-2013:p1126:b003:l003","ordinal":162092,"en":"He was practiced at facing the enemy;"},{"id":"semetey-1-2013:p1126:b003:l004","ordinal":162093,"en":"He possessed leadership."},{"id":"semetey-1-2013:p1126:b003:l005","ordinal":162094,"en":"With red spear and Zulpukor,"},{"id":"semetey-1-2013:p1126:b003:l006","ordinal":162095,"en":"He was a hero who struck in turn."},{"id":"semetey-1-2013:p1126:b003:l007","ordinal":162096,"en":"In our Kakan and Beijing,"},{"id":"semetey-1-2013:p1126:b003:l008","ordinal":162097,"en":"He was a hero who could endure"},{"id":"semetey-1-2013:p1126:b003:l009","ordinal":162098,"en":"Forty days of jousting."},{"id":"semetey-1-2013:p1126:b003:l010","ordinal":162099,"en":"He was skilled with the white battle-axe,"},{"id":"semetey-1-2013:p1126:b003:l011","ordinal":162100,"en":"An expert in warfare,"},{"id":"semetey-1-2013:p1126:b003:l012","ordinal":162101,"en":"A mighty one who found the enemy's stratagem,"},{"id":"semetey-1-2013:p1126:b003:l013","ordinal":162102,"en":"He was,"},{"id":"semetey-1-2013:p1126:b003:l014","ordinal":162103,"en":"Mottled-bodied and very lean,"},{"id":"semetey-1-2013:p1126:b003:l015","ordinal":162104,"en":"A servant fit for a hero."},{"id":"semetey-1-2013:p1126:b003:l016","ordinal":162105,"en":"Without fearing this man alone,"},{"id":"semetey-1-2013:p1126:b003:l017","ordinal":162106,"en":"With iron ropes and nets,"},{"id":"semetey-1-2013:p1126:b003:l018","ordinal":162107,"en":"With ranks of Kanjarkol men,"},{"id":"semetey-1-2013:p1126:b003:l019","ordinal":162108,"en":"I shall surround him"},{"id":"semetey-1-2013:p1126:b003:l020","ordinal":162109,"en":"And bring him utter torment."},{"id":"semetey-1-2013:p1126:b003:l021","ordinal":162110,"en":"With sixty sorcerers and a thousand champions,"},{"id":"semetey-1-2013:p1126:b003:l022","ordinal":162111,"en":"I, the lion, at their head,"},{"id":"semetey-1-2013:p1126:b003:l023","ordinal":162112,"en":"Shall stalk the poor man carefully"},{"id":"semetey-1-2013:p1126:b003:l024","ordinal":162113,"en":"And pierce him with one overturning thrust."},{"id":"semetey-1-2013:p1126:b003:l025","ordinal":162114,"en":"Is there a mane upon dark water?"},{"id":"semetey-1-2013:p1126:b003:l026","ordinal":162115,"en":"While Khan Kongurbay stands,"},{"id":"semetey-1-2013:p1126:b003:l027","ordinal":162116,"en":"Is there a khan a tether can reach?"},{"id":"semetey-1-2013:p1126:b003:l028","ordinal":162117,"en":"Against the ill-fated Burut,"},{"id":"semetey-1-2013:p1126:b003:l029","ordinal":162118,"en":"Will my Zholoy leave anything undone?"},{"id":"semetey-1-2013:p1126:b003:l030","ordinal":162119,"en":"If I send him with an order,"},{"id":"semetey-1-2013:p1126:b003:l031","ordinal":162120,"en":"Will hairy-soled Tükübay"},{"id":"semetey-1-2013:p1126:b003:l032","ordinal":162121,"en":"Not bind and seize"},{"id":"semetey-1-2013:p1126:b003:l033","ordinal":162122,"en":"Every one of the handful of Burut?\""},{"id":"semetey-1-2013:p1126:b003:l034","ordinal":162123,"en":"Before swaggering Ezkara"},{"id":"semetey-1-2013:p1126:b003:l035","ordinal":162124,"en":"Had withdrawn his words,"},{"id":"semetey-1-2013:p1126:b003:l036","ordinal":162125,"en":"The many Muslim khans"},{"id":"semetey-1-2013:p1126:b003:l037","ordinal":162126,"en":"Had filed past like sheep."},{"id":"semetey-1-2013:p1126:b003:l038","ordinal":162127,"en":"Ezkara of the infidels"},{"id":"semetey-1-2013:p1126:b003:l039","ordinal":162128,"en":"Had thoroughly assessed"},{"id":"semetey-1-2013:p1126:b004:l001","ordinal":162129,"en":"The Muslim heroes."},{"id":"semetey-1-2013:p1126:b004:l002","ordinal":162130,"en":"There was Kozubek of the Kokon khan;"},{"id":"semetey-1-2013:p1126:b004:l003","ordinal":162131,"en":"When he saw Kozubek,"},{"id":"semetey-1-2013:p1126:b004:l004","ordinal":162132,"en":"He called him \"the lumbering one.\""},{"id":"semetey-1-2013:p1126:b004:l005","ordinal":162133,"en":"There was Malabek of Margalang;"},{"id":"semetey-1-2013:p1126:b004:l006","ordinal":162134,"en":"When he saw Malabek,"},{"id":"semetey-1-2013:p1126:b004:l007","ordinal":162135,"en":"He called him \"one who capers"},{"id":"semetey-1-2013:p1126:b004:l008","ordinal":162136,"en":"Like a foal at the tethering line.\""},{"id":"semetey-1-2013:p1126:b004:l009","ordinal":162137,"en":"There was fork-bearded Synzhybek of Anzhiyan;"},{"id":"semetey-1-2013:p1126:b004:l010","ordinal":162138,"en":"He called him \"one who struts"},{"id":"semetey-1-2013:p1126:b004:l011","ordinal":162139,"en":"Like a male black crow.\""},{"id":"semetey-1-2013:p1126:b004:l012","ordinal":162140,"en":"He now knew that the vast black host"},{"id":"semetey-1-2013:p1126:b004:l013","ordinal":162141,"en":"Of Muslims had gathered,"},{"id":"semetey-1-2013:p1126:b004:l014","ordinal":162142,"en":"And knew that bloodthirsty Manas"},{"id":"semetey-1-2013:p1126:b004:l015","ordinal":162143,"en":"Was not there."},{"id":"semetey-1-2013:p1126:b004:l016","ordinal":162144,"en":"My courageous hero Khan Zholoy"},{"id":"semetey-1-2013:p1126:b004:l017","ordinal":162145,"en":"Was like a spur of the black mountain."},{"id":"semetey-1-2013:p1126:b004:l018","ordinal":162146,"en":"If Kongurbay truly attacked,"},{"id":"semetey-1-2013:p1126:b004:l019","ordinal":162147,"en":"Having come claiming to hold a true feast,"},{"id":"semetey-1-2013:p1126:b004:l020","ordinal":162148,"en":"Let them not say there was slaughter"},{"id":"semetey-1-2013:p1126:b004:l021","ordinal":162149,"en":"Among the people of Chynmachyn."},{"id":"semetey-1-2013:p1126:b004:l022","ordinal":162150,"en":"Heed what I say, Burut;"},{"id":"semetey-1-2013:p1126:b004:l023","ordinal":162151,"en":"Give me what I demand, Burut."},{"id":"semetey-1-2013:p1126:b004:l024","ordinal":162152,"en":"Kökötöy's Maaniker"},{"id":"semetey-1-2013:p1126:b004:l025","ordinal":162153,"en":"Is a deep-rooted black racehorse;"},{"id":"semetey-1-2013:p1126:b004:l026","ordinal":162154,"en":"This horse borders on the supernatural,"},{"id":"semetey-1-2013:p1126:b004:l027","ordinal":162155,"en":"Its tail and mane set it apart,"},{"id":"semetey-1-2013:p1126:b004:l028","ordinal":162156,"en":"And it appears suited to us."},{"id":"semetey-1-2013:p1126:b004:l029","ordinal":162157,"en":"It will not tire when ridden scouting,"},{"id":"semetey-1-2013:p1126:b004:l030","ordinal":162158,"en":"Nor grow sore when ridden with the baggage train."},{"id":"semetey-1-2013:p1126:b004:l031","ordinal":162159,"en":"It is a beast with wings,"},{"id":"semetey-1-2013:p1126:b004:l032","ordinal":162160,"en":"A creature fit for a khan."},{"id":"semetey-1-2013:p1126:b004:l033","ordinal":162161,"en":"Fastening on his mail,"},{"id":"semetey-1-2013:p1126:b004:l034","ordinal":162162,"en":"It could circle Beijing five times;"},{"id":"semetey-1-2013:p1126:b004:l035","ordinal":162163,"en":"It is a mount heroes would ride!"},{"id":"semetey-1-2013:p1126:b004:l036","ordinal":162164,"en":"It has the marks of a racehorse;"},{"id":"semetey-1-2013:p1126:b004:l037","ordinal":162165,"en":"Mounted by striving heroes,"},{"id":"semetey-1-2013:p1126:b004:l038","ordinal":162166,"en":"It is a beast that could travel Beijing."},{"id":"semetey-1-2013:p1126:b004:l039","ordinal":162167,"en":"Heed my demand, Burut;"}]
