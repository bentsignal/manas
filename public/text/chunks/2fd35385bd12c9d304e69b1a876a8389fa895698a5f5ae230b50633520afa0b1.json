[{"id":"manas-2010:p0982:b001:l031","ordinal":43009,"en":"He had now appointed as leader."},{"id":"manas-2010:p0982:b001:l032","ordinal":43010,"en":"Golden forelock, tasselled belt—"},{"id":"manas-2010:p0982:b001:l033","ordinal":43011,"en":"Azizkan's lion"},{"id":"manas-2010:p0982:b001:l034","ordinal":43012,"en":"They had now raised as khan."},{"id":"manas-2010:p0982:b001:l035","ordinal":43013,"en":"At this time, the Muslims,"},{"id":"manas-2010:p0982:b001:l036","ordinal":43014,"en":"Giving the reins of the great host"},{"id":"manas-2010:p0982:b001:l037","ordinal":43015,"en":"To Almambet himself,"},{"id":"manas-2010:p0982:b001:l038","ordinal":43016,"en":"Had now pledged their unity."},{"id":"manas-2010:p0982:b001:l039","ordinal":43017,"en":"To Kanykey's house,"},{"id":"manas-2010:p0982:b001:l040","ordinal":43018,"en":"The men who would don armor,"},{"id":"manas-2010:p0982:b001:l041","ordinal":43019,"en":"Almambet had now driven them all."},{"id":"manas-2010:p0982:b001:l042","ordinal":43020,"en":"From Kanykey's hands,"},{"id":"manas-2010:p0983:b001:l001","ordinal":43021,"en":"The Muslims who went in a gathering"},{"id":"manas-2010:p0983:b001:l002","ordinal":43022,"en":"Had now all received their equipment."},{"id":"manas-2010:p0983:b001:l003","ordinal":43023,"en":"Piebald-headed horses on the hills,"},{"id":"manas-2010:p0983:b001:l004","ordinal":43024,"en":"Fine-bred horses mixed with tireless racers—"},{"id":"manas-2010:p0983:b001:l005","ordinal":43025,"en":"To a hero fit for service,"},{"id":"manas-2010:p0983:b001:l006","ordinal":43026,"en":"To a champion who would strike the enemy,"},{"id":"manas-2010:p0983:b001:l007","ordinal":43027,"en":"She gave a famed swift horse."},{"id":"manas-2010:p0983:b001:l008","ordinal":43028,"en":"To the mighty wielder of a battle-axe,"},{"id":"manas-2010:p0983:b001:l009","ordinal":43029,"en":"To the skilled spear-thruster,"},{"id":"manas-2010:p0983:b001:l010","ordinal":43030,"en":"Every kind of equipment,"},{"id":"manas-2010:p0983:b001:l011","ordinal":43031,"en":"She gave it all without stint."},{"id":"manas-2010:p0983:b001:l012","ordinal":43032,"en":"“Their bellies may grow hungry,” she thought,"},{"id":"manas-2010:p0983:b001:l013","ordinal":43033,"en":"“How will they reach Beijing?” she thought."},{"id":"manas-2010:p0983:b001:l014","ordinal":43034,"en":"The khan's wife Kanykey"},{"id":"manas-2010:p0983:b001:l015","ordinal":43035,"en":"Through Egypt and Baghdad"},{"id":"manas-2010:p0983:b001:l016","ordinal":43036,"en":"Had sent searching everywhere."},{"id":"manas-2010:p0983:b001:l017","ordinal":43037,"en":"From all the other cities,"},{"id":"manas-2010:p0983:b001:l018","ordinal":43038,"en":"She had durable travel rations brought."},{"id":"manas-2010:p0983:b001:l019","ordinal":43039,"en":"“Except that she is a woman,"},{"id":"manas-2010:p0983:b001:l020","ordinal":43040,"en":"She is like Khan Manas,” they said."},{"id":"manas-2010:p0983:b001:l021","ordinal":43041,"en":"All the twelve khans"},{"id":"manas-2010:p0983:b001:l022","ordinal":43042,"en":"Stood watching and talking of her."},{"id":"manas-2010:p0983:b001:l023","ordinal":43043,"en":"The coats she had made and the travel rations,"},{"id":"manas-2010:p0983:b001:l024","ordinal":43044,"en":"Kanykey and Almambet,"},{"id":"manas-2010:p0983:b001:l025","ordinal":43045,"en":"To the dense and vast host,"},{"id":"manas-2010:p0983:b001:l026","ordinal":43046,"en":"Gave them all, each duly assigned."},{"id":"manas-2010:p0983:b001:l027","ordinal":43047,"en":"With Ajybay and Bakay as khans,"},{"id":"manas-2010:p0983:b001:l028","ordinal":43048,"en":"With so many souls among them,"},{"id":"manas-2010:p0983:b001:l029","ordinal":43049,"en":"They went to the magnanimous khan."},{"id":"manas-2010:p0983:b001:l030","ordinal":43050,"en":"Onto a carpet with golden patterns,"},{"id":"manas-2010:p0983:b001:l031","ordinal":43051,"en":"They took Manas and set him down."},{"id":"manas-2010:p0983:b001:l032","ordinal":43052,"en":"Placing a golden crown upon him,"},{"id":"manas-2010:p0983:b001:l033","ordinal":43053,"en":"Seating him on a golden throne,"},{"id":"manas-2010:p0983:b001:l034","ordinal":43054,"en":"They now raised him as khan."},{"id":"manas-2010:p0983:b001:l035","ordinal":43055,"en":"To scatter the Chinese people's livestock,"},{"id":"manas-2010:p0983:b001:l036","ordinal":43056,"en":"To spread the faith of Islam,"},{"id":"manas-2010:p0983:b001:l037","ordinal":43057,"en":"The twelve Muslim khans"},{"id":"manas-2010:p0983:b001:l038","ordinal":43058,"en":"Pledged their unity."},{"id":"manas-2010:p0983:b001:l039","ordinal":43059,"en":"Then Manas spoke:"},{"id":"manas-2010:p0983:b001:l040","ordinal":43060,"en":"“Oh, twelve khans,” he said,"},{"id":"manas-2010:p0983:b001:l041","ordinal":43061,"en":"“With Khan Koshoy at your head,"},{"id":"manas-2010:p0983:b001:l042","ordinal":43062,"en":"You elders stand here;"},{"id":"manas-2010:p0984:b001:l001","ordinal":43063,"en":"The armies of the twelve khans,"},{"id":"manas-2010:p0984:b001:l002","ordinal":43064,"en":"All of you stand here."},{"id":"manas-2010:p0984:b001:l003","ordinal":43065,"en":"Those who nurture and protect the people,"},{"id":"manas-2010:p0984:b001:l004","ordinal":43066,"en":"You heroes stand here."},{"id":"manas-2010:p0984:b001:l005","ordinal":43067,"en":"The wise men among the people,"},{"id":"manas-2010:p0984:b001:l006","ordinal":43068,"en":"You lords stand here."},{"id":"manas-2010:p0984:b001:l007","ordinal":43069,"en":"You who will campaign against Beijing,"},{"id":"manas-2010:p0984:b001:l008","ordinal":43070,"en":"You have outstanding spearmen;"},{"id":"manas-2010:p0984:b001:l009","ordinal":43071,"en":"You have skilled battle-axe wielders;"},{"id":"manas-2010:p0984:b001:l010","ordinal":43072,"en":"You have heroes who do not retreat;"},{"id":"manas-2010:p0984:b001:l011","ordinal":43073,"en":"Those who make blood flow like water,"},{"id":"manas-2010:p0984:b001:l012","ordinal":43074,"en":"You have black-eared lions;"},{"id":"manas-2010:p0984:b001:l013","ordinal":43075,"en":"You have healthy men, not sick ones;"},{"id":"manas-2010:p0984:b001:l014","ordinal":43076,"en":"You have champions born exceptional."},{"id":"manas-2010:p0984:b001:l015","ordinal":43077,"en":"Go scouting the road through the hills."},{"id":"manas-2010:p0984:b001:l016","ordinal":43078,"en":"Great host of the twelve khans,"},{"id":"manas-2010:p0984:b001:l017","ordinal":43079,"en":"From my horses in Talas,"},{"id":"manas-2010:p0984:b001:l018","ordinal":43080,"en":"Two mares for each man,"},{"id":"manas-2010:p0984:b001:l019","ordinal":43081,"en":"Take them as your provisions."},{"id":"manas-2010:p0984:b001:l020","ordinal":43082,"en":"To Kakan-Chin's Beijing,"},{"id":"manas-2010:p0984:b001:l021","ordinal":43083,"en":"Let your young go, not your old."},{"id":"manas-2010:p0984:b001:l022","ordinal":43084,"en":"I shall select from the horses for you;"},{"id":"manas-2010:p0984:b001:l023","ordinal":43085,"en":"Take my sturdy, swift animals."},{"id":"manas-2010:p0984:b001:l024","ordinal":43086,"en":"We shall scatter the unbelievers' livestock;"},{"id":"manas-2010:p0984:b001:l025","ordinal":43087,"en":"We shall launch a campaign against Beijing."},{"id":"manas-2010:p0984:b001:l026","ordinal":43088,"en":"Those of you who say, ‘My horse is thin,’"},{"id":"manas-2010:p0984:b001:l027","ordinal":43089,"en":"Return home now."},{"id":"manas-2010:p0984:b001:l028","ordinal":43090,"en":"Those who say, ‘I am an only son,’"},{"id":"manas-2010:p0984:b001:l029","ordinal":43091,"en":"Go home now."},{"id":"manas-2010:p0984:b001:l030","ordinal":43092,"en":"Those who say, ‘My strength is poor,’"},{"id":"manas-2010:p0984:b001:l031","ordinal":43093,"en":"Return to your own place now."},{"id":"manas-2010:p0984:b001:l032","ordinal":43094,"en":"You will go to wicked Beijing:"},{"id":"manas-2010:p0984:b001:l033","ordinal":43095,"en":"‘Spoils for the moment,’ you may think—"},{"id":"manas-2010:p0984:b001:l034","ordinal":43096,"en":"Do not covet horses and coats."},{"id":"manas-2010:p0984:b001:l035","ordinal":43097,"en":"When we throng upon the campaign,"},{"id":"manas-2010:p0984:b001:l036","ordinal":43098,"en":"‘I had only one horse,’"},{"id":"manas-2010:p0984:b001:l037","ordinal":43099,"en":"‘I was an only son’—"},{"id":"manas-2010:p0984:b001:l038","ordinal":43100,"en":"When we are halfway there,"},{"id":"manas-2010:p0984:b001:l039","ordinal":43101,"en":"Do not blubber and babble."},{"id":"manas-2010:p0984:b001:l040","ordinal":43102,"en":"When we set out on the distant road,"},{"id":"manas-2010:p0984:b001:l041","ordinal":43103,"en":"Of one who says, ‘I have only one horse,’"},{"id":"manas-2010:p0984:b001:l042","ordinal":43104,"en":"I shall slaughter and eat that horse and go on."},{"id":"manas-2010:p0985:b001:l001","ordinal":43105,"en":"Of one who says, ‘I am an only son,’"},{"id":"manas-2010:p0985:b001:l002","ordinal":43106,"en":"I shall gouge out his eyes and go on."},{"id":"manas-2010:p0985:b001:l003","ordinal":43107,"en":"Hear this from the very start:"},{"id":"manas-2010:p0985:b001:l004","ordinal":43108,"en":"Thus I shall bring about your ruin!”"},{"id":"manas-2010:p0985:b001:l005","ordinal":43109,"en":"Hearing this, the Muslims"},{"id":"manas-2010:p0985:b001:l006","ordinal":43110,"en":"Dismounted with a clamor."},{"id":"manas-2010:p0985:b001:l007","ordinal":43111,"en":"“Obedience to your word!”"},{"id":"manas-2010:p0985:b001:l008","ordinal":43112,"en":"They all cried out together."},{"id":"manas-2010:p0985:b001:l009","ordinal":43113,"en":"On hearing this command,"},{"id":"manas-2010:p0985:b001:l010","ordinal":43114,"en":"The gathered, thick host"},{"id":"manas-2010:p0985:b001:l011","ordinal":43115,"en":"All mounted their horses."},{"id":"manas-2010:p0985:b001:l012","ordinal":43116,"en":"To the grazing herds,"},{"id":"manas-2010:p0985:b001:l013","ordinal":43117,"en":"They all came together."},{"id":"manas-2010:p0985:b001:l014","ordinal":43118,"en":"Two mares for each man,"},{"id":"manas-2010:p0985:b001:l015","ordinal":43119,"en":"The whole people took."},{"id":"manas-2010:p0985:b001:l016","ordinal":43120,"en":"Even then, the great horse herds"},{"id":"manas-2010:p0985:b001:l017","ordinal":43121,"en":"Remained without a gap along their edge."},{"id":"manas-2010:p0985:b001:l018","ordinal":43122,"en":"Hearing Manas's command,"},{"id":"manas-2010:p0985:b001:l019","ordinal":43123,"en":"All heard and thundered forth."},{"id":"manas-2010:p0985:b001:l020","ordinal":43124,"en":"Turning toward Beijing,"},{"id":"manas-2010:p0985:b001:l021","ordinal":43125,"en":"Khan Manas's red banner with its golden crescent"},{"id":"manas-2010:p0985:b001:l022","ordinal":43126,"en":"They set before them and went thundering away."},{"id":"manas-2010:p0985:b001:l023","ordinal":43127,"en":"Leading the front of the host,"},{"id":"manas-2010:p0985:b001:l024","ordinal":43128,"en":"The people's father, Khan Koshoy—"},{"id":"manas-2010:p0985:b001:l025","ordinal":43129,"en":"Koshoy then cried out:"},{"id":"manas-2010:p0985:b001:l026","ordinal":43130,"en":"The child conceived through a blessing,"},{"id":"manas-2010:p0985:b001:l027","ordinal":43131,"en":"“Bring him!” he called."},{"id":"manas-2010:p0985:b001:l028","ordinal":43132,"en":"The beauty of dark complexion,"},{"id":"manas-2010:p0985:b001:l029","ordinal":43133,"en":"The radiant one among Muslims,"},{"id":"manas-2010:p0985:b001:l030","ordinal":43134,"en":"Your splendid sister-in-law Kanykey,"},{"id":"manas-2010:p0985:b001:l031","ordinal":43135,"en":"Swaying like a poppy,"},{"id":"manas-2010:p0985:b001:l032","ordinal":43136,"en":"Her finely crafted red dress,"},{"id":"manas-2010:p0985:b001:l033","ordinal":43137,"en":"Its hem flowing out in ripples—"},{"id":"manas-2010:p0985:b001:l034","ordinal":43138,"en":"“A spring flowing from the hills,” she said,"},{"id":"manas-2010:p0985:b001:l035","ordinal":43139,"en":"“At Kökötöy's funeral feast,"},{"id":"manas-2010:p0985:b001:l036","ordinal":43140,"en":"Before the great gathering,"},{"id":"manas-2010:p0985:b001:l037","ordinal":43141,"en":"This little rascal was conceived through a blessing,” she said."},{"id":"manas-2010:p0985:b001:l038","ordinal":43142,"en":"She brought the child,"},{"id":"manas-2010:p0985:b001:l039","ordinal":43143,"en":"Drawing everyone's attention away."},{"id":"manas-2010:p0985:b001:l040","ordinal":43144,"en":"Taking the child, Khan Koshoy"},{"id":"manas-2010:p0985:b001:l041","ordinal":43145,"en":"Stood treading with heavy steps."},{"id":"manas-2010:p0985:b001:l042","ordinal":43146,"en":"“The sovereign's only son,” he said,"},{"id":"manas-2010:p0986:b001:l001","ordinal":43147,"en":"Cradling him in his palms, weighing him,"},{"id":"manas-2010:p0986:b001:l002","ordinal":43148,"en":"They stood holding the child."},{"id":"manas-2010:p0986:b001:l003","ordinal":43149,"en":"Everyone crowded round to see,"},{"id":"manas-2010:p0986:b001:l004","ordinal":43150,"en":"Offering their flattery,"},{"id":"manas-2010:p0986:b001:l005","ordinal":43151,"en":"As though the newborn child's"},{"id":"manas-2010:p0986:b001:l006","ordinal":43152,"en":"Esteem were dear to them."},{"id":"manas-2010:p0986:b001:l007","ordinal":43153,"en":"Look at their flattery—"},{"id":"manas-2010:p0986:b001:l008","ordinal":43154,"en":"As though they would allot the child an inheritance!"},{"id":"manas-2010:p0986:b001:l009","ordinal":43155,"en":"Courtly holy elders in costly blue boots,"},{"id":"manas-2010:p0986:b001:l010","ordinal":43156,"en":"Who offered much flattery,"},{"id":"manas-2010:p0986:b001:l011","ordinal":43157,"en":"Great Kokand and Margalang—"},{"id":"manas-2010:p0986:b001:l012","ordinal":43158,"en":"All the twelve khans"},{"id":"manas-2010:p0986:b001:l013","ordinal":43159,"en":"Conferred in murmurs:"},{"id":"manas-2010:p0986:b001:l014","ordinal":43160,"en":"“When this child was born,"},{"id":"manas-2010:p0986:b001:l015","ordinal":43161,"en":"The Russians ate at his feast and left,"},{"id":"manas-2010:p0986:b001:l016","ordinal":43162,"en":"Saying, ‘He will overthrow the Oyrats.’"},{"id":"manas-2010:p0986:b001:l017","ordinal":43163,"en":"The Chinese ate at his feast and left,"},{"id":"manas-2010:p0986:b001:l018","ordinal":43164,"en":"Saying, ‘If this child lives safely,"},{"id":"manas-2010:p0986:b001:l019","ordinal":43165,"en":"He will overthrow Kyrym.’"},{"id":"manas-2010:p0986:b001:l020","ordinal":43166,"en":"If he grows safely without dying,"},{"id":"manas-2010:p0986:b001:l021","ordinal":43167,"en":"He will be like his father, they said."},{"id":"manas-2010:p0986:b001:l022","ordinal":43168,"en":"Whoever provokes his displeasure,"},{"id":"manas-2010:p0986:b001:l023","ordinal":43169,"en":"He will slaughter utterly, they said.”"},{"id":"manas-2010:p0986:b001:l024","ordinal":43170,"en":"The dear bird called the coot"},{"id":"manas-2010:p0986:b001:l025","ordinal":43171,"en":"Wheels in flight for the sake of the steppe."},{"id":"manas-2010:p0986:b001:l026","ordinal":43172,"en":"Who has not turned his thoughts"},{"id":"manas-2010:p0986:b001:l027","ordinal":43173,"en":"To a child born from the womb?"},{"id":"manas-2010:p0986:b001:l028","ordinal":43174,"en":"At that moment, Manas's"},{"id":"manas-2010:p0986:b001:l029","ordinal":43175,"en":"Thoughts were divided,"},{"id":"manas-2010:p0986:b001:l030","ordinal":43176,"en":"As in Talas was being left"},{"id":"manas-2010:p0986:b001:l031","ordinal":43177,"en":"His child with newborn down."},{"id":"manas-2010:p0986:b001:l032","ordinal":43178,"en":"Then the khan's wife Kanykey,"},{"id":"manas-2010:p0986:b001:l033","ordinal":43179,"en":"Bowing to Khan Koshoy,"},{"id":"manas-2010:p0986:b001:l034","ordinal":43180,"en":"Bending her knees to the earth,"},{"id":"manas-2010:p0986:b001:l035","ordinal":43181,"en":"Asking a blessing for the child,"},{"id":"manas-2010:p0986:b001:l036","ordinal":43182,"en":"Stood stooping in supplication."},{"id":"manas-2010:p0986:b001:l037","ordinal":43183,"en":"“Uncle, remember us as you go;"},{"id":"manas-2010:p0986:b001:l038","ordinal":43184,"en":"Hear my sorrowing voice as you go."},{"id":"manas-2010:p0986:b001:l039","ordinal":43185,"en":"To the only child left by the wolf-maned one,"},{"id":"manas-2010:p0986:b001:l040","ordinal":43186,"en":"Give your generous blessing before you go!"},{"id":"manas-2010:p0986:b001:l041","ordinal":43187,"en":"Golden collar, copper sleeves,"},{"id":"manas-2010:p0986:b001:l042","ordinal":43188,"en":"Double-layered mail with lark-eye rings,"},{"id":"manas-2010:p0987:b001:l001","ordinal":43189,"en":"Worn in a firefight, no bullet can pass through;"},{"id":"manas-2010:p0987:b001:l002","ordinal":43190,"en":"No arrow's point can reach it;"},{"id":"manas-2010:p0987:b001:l003","ordinal":43191,"en":"No musket ball can enter it."},{"id":"manas-2010:p0987:b001:l004","ordinal":43192,"en":"Made specially from the beginning,"},{"id":"manas-2010:p0987:b001:l005","ordinal":43193,"en":"Wear this camel-wool coat as you go.”"},{"id":"manas-2010:p0987:b001:l006","ordinal":43194,"en":"After putting on the camel-wool coat,"},{"id":"manas-2010:p0987:b001:l007","ordinal":43195,"en":"After looking into Kanykey's eyes,"},{"id":"manas-2010:p0987:b001:l008","ordinal":43196,"en":"Khan Koshoy of the Katagan,"},{"id":"manas-2010:p0987:b001:l009","ordinal":43197,"en":"Khan Koshoy, from his deepest heart,"},{"id":"manas-2010:p0987:b001:l010","ordinal":43198,"en":"Now stood giving his blessing."},{"id":"manas-2010:p0987:b001:l011","ordinal":43199,"en":"Opening his palms, Khan Koshoy"},{"id":"manas-2010:p0987:b001:l012","ordinal":43200,"en":"Gave this blessing:"},{"id":"manas-2010:p0987:b001:l013","ordinal":43201,"en":"“May Kojosan protect him always;"},{"id":"manas-2010:p0987:b001:l014","ordinal":43202,"en":"May they support him beneath the arms—"},{"id":"manas-2010:p0987:b001:l015","ordinal":43203,"en":"Kojo, Kydyr and Shaimerden!"},{"id":"manas-2010:p0987:b001:l016","ordinal":43204,"en":"May the black-spotted leopard"},{"id":"manas-2010:p0987:b001:l017","ordinal":43205,"en":"Keep watch from his flank;"},{"id":"manas-2010:p0987:b001:l018","ordinal":43206,"en":"May your father's beast, the white tiger,"},{"id":"manas-2010:p0987:b001:l019","ordinal":43207,"en":"Never leave your rear;"},{"id":"manas-2010:p0987:b001:l020","ordinal":43208,"en":"May the mighty black bird in battle"},{"id":"manas-2010:p0987:b001:l021","ordinal":43209,"en":"Circle in flight beside you!”"},{"id":"manas-2010:p0987:b001:l022","ordinal":43210,"en":"Mounting the bay, leopard-like horse,"},{"id":"manas-2010:p0987:b001:l023","ordinal":43211,"en":"In wide-legged, flowing trousers,"},{"id":"manas-2010:p0987:b001:l024","ordinal":43212,"en":"Wearing a loose coat,"},{"id":"manas-2010:p0987:b001:l025","ordinal":43213,"en":"With ammunition loaded at his waist,"},{"id":"manas-2010:p0987:b001:l026","ordinal":43214,"en":"Taking a host numbering one vast multitude,"},{"id":"manas-2010:p0987:b001:l027","ordinal":43215,"en":"Taking abundant food and supplies,"},{"id":"manas-2010:p0987:b001:l028","ordinal":43216,"en":"Khan Koshoy moved to the front."},{"id":"manas-2010:p0987:b001:l029","ordinal":43217,"en":"A man endowed with sacred powers,"},{"id":"manas-2010:p0987:b001:l030","ordinal":43218,"en":"Leading the host at its head,"},{"id":"manas-2010:p0987:b001:l031","ordinal":43219,"en":"Old Koshoy was khan."},{"id":"manas-2010:p0987:b001:l032","ordinal":43220,"en":"His army moved in dense ranks,"},{"id":"manas-2010:p0987:b001:l033","ordinal":43221,"en":"Famed throughout the world."},{"id":"manas-2010:p0987:b001:l034","ordinal":43222,"en":"Those who saw his army"},{"id":"manas-2010:p0987:b001:l035","ordinal":43223,"en":"Lost their wits in astonishment."},{"id":"manas-2010:p0987:b001:l036","ordinal":43224,"en":"Zhamgyrchy of the Eshteks"},{"id":"manas-2010:p0987:b001:l037","ordinal":43225,"en":"Followed behind along the road,"},{"id":"manas-2010:p0987:b001:l038","ordinal":43226,"en":"He too with one vast host."},{"id":"manas-2010:p0987:b001:l039","ordinal":43227,"en":"Muzburchak, Buudaykan's son,"},{"id":"manas-2010:p0987:b001:l040","ordinal":43228,"en":"He too traveled along the road,"},{"id":"manas-2010:p0987:b001:l041","ordinal":43229,"en":"With a host counted as one vast multitude."},{"id":"manas-2010:p0987:b001:l042","ordinal":43230,"en":"What all of them rode"},{"id":"manas-2010:p0988:b001:l001","ordinal":43231,"en":"Were matching dun-colored horses,"},{"id":"manas-2010:p0988:b001:l002","ordinal":43232,"en":"With amulet-shaped forehead blazes,"},{"id":"manas-2010:p0988:b001:l003","ordinal":43233,"en":"All wondrous steeds, like wild asses,"},{"id":"manas-2010:p0988:b001:l004","ordinal":43234,"en":"Unlike other animals."},{"id":"manas-2010:p0988:b001:l005","ordinal":43235,"en":"The heel of the blue boot—"},{"id":"manas-2010:p0988:b001:l006","ordinal":43236,"en":"Kökchö, Aydarkan's son,"},{"id":"manas-2010:p0988:b001:l007","ordinal":43237,"en":"He too traveled along the road."},{"id":"manas-2010:p0988:b001:l008","ordinal":43238,"en":"With a back bent like a lion's,"},{"id":"manas-2010:p0988:b001:l009","ordinal":43239,"en":"Rejoicing at the word of war,"},{"id":"manas-2010:p0988:b001:l010","ordinal":43240,"en":"The son, girded with a sword,"},{"id":"manas-2010:p0988:b001:l011","ordinal":43241,"en":"Equipped for battle from the start,"},{"id":"manas-2010:p0988:b001:l012","ordinal":43242,"en":"Ormonbek, Tekechi's son,"},{"id":"manas-2010:p0988:b001:l013","ordinal":43243,"en":"Who dwelt in Chambyl-Bel,"},{"id":"manas-2010:p0988:b001:l014","ordinal":43244,"en":"Called a hero mightier than all,"},{"id":"manas-2010:p0988:b001:l015","ordinal":43245,"en":"He too traveled along the road,"},{"id":"manas-2010:p0988:b001:l016","ordinal":43246,"en":"With a host numbering a vast multitude."},{"id":"manas-2010:p0988:b001:l017","ordinal":43247,"en":"Holding his fine-bred horse's head high,"},{"id":"manas-2010:p0988:b001:l018","ordinal":43248,"en":"Sticking out his blue overshoes,"},{"id":"manas-2010:p0988:b001:l019","ordinal":43249,"en":"Big-lunged and thunderous,"},{"id":"manas-2010:p0988:b001:l020","ordinal":43250,"en":"Fork-bearded Synchybek of Andijan,"},{"id":"manas-2010:p0988:b001:l021","ordinal":43251,"en":"He too went with his host."},{"id":"manas-2010:p0988:b001:l022","ordinal":43252,"en":"Kozubek, the khan of Kokand,"},{"id":"manas-2010:p0988:b001:l023","ordinal":43253,"en":"Had his loads put on mules,"},{"id":"manas-2010:p0988:b001:l024","ordinal":43254,"en":"Made the mass of people bear his troubles,"},{"id":"manas-2010:p0988:b001:l025","ordinal":43255,"en":"Smoothing his thin mustache,"},{"id":"manas-2010:p0988:b001:l026","ordinal":43256,"en":"He too went with his host."},{"id":"manas-2010:p0988:b001:l027","ordinal":43257,"en":"Malabek from Margalang,"},{"id":"manas-2010:p0988:b001:l028","ordinal":43258,"en":"Who dwelt in Margalang,"},{"id":"manas-2010:p0988:b001:l029","ordinal":43259,"en":"Who tied bread the size of a hoe to his waist,"},{"id":"manas-2010:p0988:b001:l030","ordinal":43260,"en":"Opening his mouth toward the sky,"},{"id":"manas-2010:p0988:b001:l031","ordinal":43261,"en":"Hummed songs from dawn till dusk."},{"id":"manas-2010:p0988:b001:l032","ordinal":43262,"en":"Riding all chestnut horses,"},{"id":"manas-2010:p0988:b001:l033","ordinal":43263,"en":"Their hairy tails tied firmly in knots,"},{"id":"manas-2010:p0988:b001:l034","ordinal":43264,"en":"He too, with one vast host,"}]
