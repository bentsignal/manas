[{"id":"seytek-2012:p0691:b002:l025","ordinal":346881,"en":"For the rugged Ala-Too,"},{"id":"seytek-2012:p0691:b002:l026","ordinal":346882,"en":"For the Kyrgyz people of the north,"},{"id":"seytek-2012:p0691:b002:l027","ordinal":346883,"en":"Who dwelt in the Ala-Too."},{"id":"seytek-2012:p0691:b002:l028","ordinal":346884,"en":"Choro, noblest of kinsmen,"},{"id":"seytek-2012:p0691:b002:l029","ordinal":346885,"en":"Choro the hero, upheld by the saints,"},{"id":"seytek-2012:p0691:b002:l030","ordinal":346886,"en":"Terrible in bearing, mighty in wrath,"},{"id":"seytek-2012:p0691:b002:l031","ordinal":346887,"en":"Choro the hero who spared no one,"},{"id":"seytek-2012:p0691:b002:l032","ordinal":346888,"en":"Choro, favored by perfect fortune,"},{"id":"seytek-2012:p0691:b002:l033","ordinal":346889,"en":"Who straightened all who challenged him—"},{"id":"seytek-2012:p0691:b002:l034","ordinal":346890,"en":"Such was Külchoro’s nature."},{"id":"seytek-2012:p0691:b002:l035","ordinal":346891,"en":"Taking his steel spear in hand,"},{"id":"seytek-2012:p0691:b002:l036","ordinal":346892,"en":"He attacked Sarybai,"},{"id":"seytek-2012:p0691:b002:l037","ordinal":346893,"en":"Power radiating from his presence,"},{"id":"seytek-2012:p0691:b002:l038","ordinal":346894,"en":"While between his two cheeks"},{"id":"seytek-2012:p0691:b002:l039","ordinal":346895,"en":"Grew whiskers five finger-widths long."},{"id":"seytek-2012:p0691:b002:l040","ordinal":346896,"en":"Sarybai confronted him,"},{"id":"seytek-2012:p0691:b003:l001","ordinal":346897,"en":"And Külchoro, a blazing ember,"},{"id":"seytek-2012:p0691:b003:l002","ordinal":346898,"en":"Prayed to the Creator:"},{"id":"seytek-2012:p0691:b003:l003","ordinal":346899,"en":"“Grant us abundance while we live,"},{"id":"seytek-2012:p0691:b003:l004","ordinal":346900,"en":"And grant us faith if we die."},{"id":"seytek-2012:p0691:b003:l005","ordinal":346901,"en":"We are not mere brushwood—do not make us a road."},{"id":"seytek-2012:p0691:b003:l006","ordinal":346902,"en":"We are sons of princes—"},{"id":"seytek-2012:p0691:b003:l007","ordinal":346903,"en":"Do not disgrace us before the dog Sarybai!”"},{"id":"seytek-2012:p0691:b003:l008","ordinal":346904,"en":"Ask no more about Külchoro:"},{"id":"seytek-2012:p0691:b003:l009","ordinal":346905,"en":"He was a glowing crimson ember,"},{"id":"seytek-2012:p0691:b003:l010","ordinal":346906,"en":"A bullet of steel against the foe."},{"id":"seytek-2012:p0691:b003:l011","ordinal":346907,"en":"When he charged in fury,"},{"id":"seytek-2012:p0691:b003:l012","ordinal":346908,"en":"There was none like him in all the world."},{"id":"seytek-2012:p0691:b003:l013","ordinal":346909,"en":"Choro, proud of his valor,"},{"id":"seytek-2012:p0691:b003:l014","ordinal":346910,"en":"Against the infidel son of a monster,"},{"id":"seytek-2012:p0691:b003:l015","ordinal":346911,"en":"Buckled his battle sash around his waist,"},{"id":"seytek-2012:p0691:b003:l016","ordinal":346912,"en":"And against that earth-smeared swine"},{"id":"seytek-2012:p0691:b003:l017","ordinal":346913,"en":"He went alone and attacked."},{"id":"seytek-2012:p0691:b003:l018","ordinal":346914,"en":"He pulled the reins"},{"id":"seytek-2012:p0691:b003:l019","ordinal":346915,"en":"And turned the mouth of his fluid-swift Surat."},{"id":"seytek-2012:p0691:b003:l020","ordinal":346916,"en":"Against the roaring infidel"},{"id":"seytek-2012:p0691:b003:l021","ordinal":346917,"en":"He leveled his spear with a roar."},{"id":"seytek-2012:p0691:b003:l022","ordinal":346918,"en":"Such was Külchoro’s way;"},{"id":"seytek-2012:p0691:b003:l023","ordinal":346919,"en":"Sarybai charged,"},{"id":"seytek-2012:p0691:b003:l024","ordinal":346920,"en":"And this was how he prepared:"},{"id":"seytek-2012:p0691:b003:l025","ordinal":346921,"en":"Tall and broad-shouldered,"},{"id":"seytek-2012:p0691:b003:l026","ordinal":346922,"en":"Both wrestler and lion,"},{"id":"seytek-2012:p0691:b003:l027","ordinal":346923,"en":"Both mighty and heroic,"},{"id":"seytek-2012:p0691:b003:l028","ordinal":346924,"en":"Thick-armed and stone-hearted,"},{"id":"seytek-2012:p0691:b003:l029","ordinal":346925,"en":"A reckless man of boundless courage,"},{"id":"seytek-2012:p0691:b003:l030","ordinal":346926,"en":"Who throughout the eighteen thousand worlds"},{"id":"seytek-2012:p0691:b003:l031","ordinal":346927,"en":"Had stirred up great turmoil."},{"id":"seytek-2012:p0691:b003:l032","ordinal":346928,"en":"His lashes were flame, his eyes embers."},{"id":"seytek-2012:p0691:b003:l033","ordinal":346929,"en":"No other man possessed such dreadfulness."},{"id":"seytek-2012:p0691:b003:l034","ordinal":346930,"en":"He brought turmoil upon his foes;"},{"id":"seytek-2012:p0691:b003:l035","ordinal":346931,"en":"If hosts came flooding against him,"},{"id":"seytek-2012:p0691:b003:l036","ordinal":346932,"en":"He never panicked or hurried."},{"id":"seytek-2012:p0691:b003:l037","ordinal":346933,"en":"If a formidable foe fell into his hands,"},{"id":"seytek-2012:p0691:b003:l038","ordinal":346934,"en":"He crushed him into a patch the size of a rabbit."},{"id":"seytek-2012:p0691:b003:l039","ordinal":346935,"en":"Though ninety armies grappled with him,"},{"id":"seytek-2012:p0691:b003:l040","ordinal":346936,"en":"He never opened his flank in fear."},{"id":"seytek-2012:p0692:b002:l001","ordinal":346937,"en":"They drew their mighty bows,"},{"id":"seytek-2012:p0692:b002:l002","ordinal":346938,"en":"And shot at one another with thudding blows,"},{"id":"seytek-2012:p0692:b002:l003","ordinal":346939,"en":"Standing amid battle cries,"},{"id":"seytek-2012:p0692:b002:l004","ordinal":346940,"en":"Fighting without sparing their lives."},{"id":"seytek-2012:p0692:b002:l005","ordinal":346941,"en":"All their spears shattered."},{"id":"seytek-2012:p0692:b002:l006","ordinal":346942,"en":"Every coat of mail was torn apart,"},{"id":"seytek-2012:p0692:b002:l007","ordinal":346943,"en":"And each lion’s valor was revealed;"},{"id":"seytek-2012:p0692:b002:l008","ordinal":346944,"en":"All their robes were ripped,"},{"id":"seytek-2012:p0692:b002:l009","ordinal":346945,"en":"All their gear burst asunder."},{"id":"seytek-2012:p0692:b002:l010","ordinal":346946,"en":"They seized each other by the collar,"},{"id":"seytek-2012:p0692:b002:l011","ordinal":346947,"en":"And sank waist-deep into the earth."},{"id":"seytek-2012:p0692:b002:l012","ordinal":346948,"en":"They took no rest by day,"},{"id":"seytek-2012:p0692:b002:l013","ordinal":346949,"en":"Nor any rest by night."},{"id":"seytek-2012:p0692:b002:l014","ordinal":346950,"en":"They fought through days and nights—"},{"id":"seytek-2012:p0692:b002:l015","ordinal":346951,"en":"Who had ever seen such a deed?"},{"id":"seytek-2012:p0692:b002:l016","ordinal":346952,"en":"Both armies stood motionless,"},{"id":"seytek-2012:p0692:b002:l017","ordinal":346953,"en":"Unable to advance, as though paralyzed."},{"id":"seytek-2012:p0692:b002:l018","ordinal":346954,"en":"Their poor heads, once full of life,"},{"id":"seytek-2012:p0692:b002:l019","ordinal":346955,"en":"Became buckets of crimson blood."},{"id":"seytek-2012:p0692:b002:l020","ordinal":346956,"en":"Axe-bearing Sarybai"},{"id":"seytek-2012:p0692:b002:l021","ordinal":346957,"en":"Came upon him in fury."},{"id":"seytek-2012:p0692:b002:l022","ordinal":346958,"en":"He swung his cast-iron mace, huge as a house,"},{"id":"seytek-2012:p0692:b002:l023","ordinal":346959,"en":"Pouring all his rage into it,"},{"id":"seytek-2012:p0692:b002:l024","ordinal":346960,"en":"Gripped it in both hands and let it fly,"},{"id":"seytek-2012:p0692:b002:l025","ordinal":346961,"en":"Turning his warhorse’s head,"},{"id":"seytek-2012:p0692:b002:l026","ordinal":346962,"en":"And struck with all his might."},{"id":"seytek-2012:p0692:b002:l027","ordinal":346963,"en":"The shield burned and became an ember;"},{"id":"seytek-2012:p0692:b002:l028","ordinal":346964,"en":"What could poor Choro do?"},{"id":"seytek-2012:p0692:b002:l029","ordinal":346965,"en":"His eyes blazed like fire."},{"id":"seytek-2012:p0692:b002:l030","ordinal":346966,"en":"The gray racer’s back was broken,"},{"id":"seytek-2012:p0692:b002:l031","ordinal":346967,"en":"All its bones cracking,"},{"id":"seytek-2012:p0692:b002:l032","ordinal":346968,"en":"Its fly-like soul shrieking."},{"id":"seytek-2012:p0692:b002:l033","ordinal":346969,"en":"Choro collapsed unconscious,"},{"id":"seytek-2012:p0692:b002:l034","ordinal":346970,"en":"His two eyes rolling,"},{"id":"seytek-2012:p0692:b002:l035","ordinal":346971,"en":"His fine mustache twisted,"},{"id":"seytek-2012:p0692:b002:l036","ordinal":346972,"en":"His flashing eyes staring wide."},{"id":"seytek-2012:p0692:b002:l037","ordinal":346973,"en":"Stricken by grievous pain,"},{"id":"seytek-2012:p0692:b002:l038","ordinal":346974,"en":"His insides seethed like embers,"},{"id":"seytek-2012:p0692:b002:l039","ordinal":346975,"en":"His two eyes became fire,"},{"id":"seytek-2012:p0692:b002:l040","ordinal":346976,"en":"And his whole body trembled."},{"id":"seytek-2012:p0692:b003:l001","ordinal":346977,"en":"When he faced forward and leveled his spear,"},{"id":"seytek-2012:p0692:b003:l002","ordinal":346978,"en":"His back had failed and he stooped,"},{"id":"seytek-2012:p0692:b003:l003","ordinal":346979,"en":"His eyes bulging and staring."},{"id":"seytek-2012:p0692:b003:l004","ordinal":346980,"en":"His eyes flashed like a lion’s,"},{"id":"seytek-2012:p0692:b003:l005","ordinal":346981,"en":"And against the infidel son of a monster,"},{"id":"seytek-2012:p0692:b003:l006","ordinal":346982,"en":"Before a word could be spoken,"},{"id":"seytek-2012:p0692:b003:l007","ordinal":346983,"en":"In the blink of an eye,"},{"id":"seytek-2012:p0692:b003:l008","ordinal":346984,"en":"He arrived faster than an arrow."},{"id":"seytek-2012:p0692:b003:l009","ordinal":346985,"en":"As he reached the infidel,"},{"id":"seytek-2012:p0692:b003:l010","ordinal":346986,"en":"Thinking, “Here is the face of the ribs,"},{"id":"seytek-2012:p0692:b003:l011","ordinal":346987,"en":"Here is the very center of the lungs,"},{"id":"seytek-2012:p0692:b003:l012","ordinal":346988,"en":"Here is where this raging swine"},{"id":"seytek-2012:p0692:b003:l013","ordinal":346989,"en":"Will fall,”"},{"id":"seytek-2012:p0692:b003:l014","ordinal":346990,"en":"Külchoro thrust his spear."},{"id":"seytek-2012:p0692:b003:l015","ordinal":346991,"en":"Such is the way of heroes:"},{"id":"seytek-2012:p0692:b003:l016","ordinal":346992,"en":"They stood facing one another."},{"id":"seytek-2012:p0692:b003:l017","ordinal":346993,"en":"Thinking, “Here is the core of the fleshly heart,"},{"id":"seytek-2012:p0692:b003:l018","ordinal":346994,"en":"The place between lung and heart,"},{"id":"seytek-2012:p0692:b003:l019","ordinal":346995,"en":"The measured eye of death,"},{"id":"seytek-2012:p0692:b003:l020","ordinal":346996,"en":"The very place where he must die,"},{"id":"seytek-2012:p0692:b003:l021","ordinal":346997,"en":"Where he will wheel like a blue vulture"},{"id":"seytek-2012:p0692:b003:l022","ordinal":346998,"en":"And his soul take flight,”"},{"id":"seytek-2012:p0692:b003:l023","ordinal":346999,"en":"Sarybai thrust his spear."},{"id":"seytek-2012:p0692:b003:l024","ordinal":347000,"en":"The four-legged chargers"},{"id":"seytek-2012:p0692:b003:l025","ordinal":347001,"en":"Collapsed side by side."},{"id":"seytek-2012:p0692:b003:l026","ordinal":347002,"en":"The spears that struck together"},{"id":"seytek-2012:p0692:b003:l027","ordinal":347003,"en":"Shattered into fragments."},{"id":"seytek-2012:p0692:b003:l028","ordinal":347004,"en":"Such is the way of warriors:"},{"id":"seytek-2012:p0692:b003:l029","ordinal":347005,"en":"They stood face-to-face."},{"id":"seytek-2012:p0692:b003:l030","ordinal":347006,"en":"Firing guns and drawing bows,"},{"id":"seytek-2012:p0692:b003:l031","ordinal":347007,"en":"They fought with crashing blows."},{"id":"seytek-2012:p0692:b003:l032","ordinal":347008,"en":"They struck with battle-axes,"},{"id":"seytek-2012:p0692:b003:l033","ordinal":347009,"en":"Until the axes shattered"},{"id":"seytek-2012:p0692:b003:l034","ordinal":347010,"en":"And only the hafts remained in their hands."},{"id":"seytek-2012:p0692:b003:l035","ordinal":347011,"en":"They fought with swords,"},{"id":"seytek-2012:p0692:b003:l036","ordinal":347012,"en":"Until every sword shattered"},{"id":"seytek-2012:p0692:b003:l037","ordinal":347013,"en":"And only the hilts remained in their hands."},{"id":"seytek-2012:p0692:b003:l038","ordinal":347014,"en":"They stood on opposing slopes,"},{"id":"seytek-2012:p0692:b003:l039","ordinal":347015,"en":"Fighting with battle-axes—"},{"id":"seytek-2012:p0692:b003:l040","ordinal":347016,"en":"Who had ever seen such a deed?"},{"id":"seytek-2012:p0693:b002:l001","ordinal":347017,"en":"He drank and gulped down blood."},{"id":"seytek-2012:p0693:b002:l002","ordinal":347018,"en":"Crushing the mighty,"},{"id":"seytek-2012:p0693:b002:l003","ordinal":347019,"en":"My child, I fear he will slaughter us to the last."},{"id":"seytek-2012:p0693:b002:l004","ordinal":347020,"en":"Leaving not a hair of the Kyrgyz,"},{"id":"seytek-2012:p0693:b002:l005","ordinal":347021,"en":"I fear he will pass through in massacre."},{"id":"seytek-2012:p0693:b002:l006","ordinal":347022,"en":"My child, will he knead us like dough,"},{"id":"seytek-2012:p0693:b002:l007","ordinal":347023,"en":"Will he tear out our roots?"},{"id":"seytek-2012:p0693:b002:l008","ordinal":347024,"en":"He will diminish our hopes,"},{"id":"seytek-2012:p0693:b002:l009","ordinal":347025,"en":"Will he destroy the mighty?"},{"id":"seytek-2012:p0693:b002:l010","ordinal":347026,"en":"He will wipe out the noble,"},{"id":"seytek-2012:p0693:b002:l011","ordinal":347027,"en":"And unleash calamity and ruin."},{"id":"seytek-2012:p0693:b002:l012","ordinal":347028,"en":"Will this poor people gathered here,"},{"id":"seytek-2012:p0693:b002:l013","ordinal":347029,"en":"Stripped of mane and tail,"},{"id":"seytek-2012:p0693:b002:l014","ordinal":347030,"en":"Be left hornless?"},{"id":"seytek-2012:p0693:b002:l015","ordinal":347031,"en":"With the horn broken from our brow,"},{"id":"seytek-2012:p0693:b002:l016","ordinal":347032,"en":"Will we be left barren?"},{"id":"seytek-2012:p0693:b002:l017","ordinal":347033,"en":"If this infidel continues so,"},{"id":"seytek-2012:p0693:b002:l018","ordinal":347034,"en":"He will unleash terrible wrath;"},{"id":"seytek-2012:p0693:b002:l019","ordinal":347035,"en":"Bride and widowed wife alike"},{"id":"seytek-2012:p0693:b002:l020","ordinal":347036,"en":"Will abandon the village’s shelter…"},{"id":"seytek-2012:p0693:b002:l021","ordinal":347037,"en":"Unable to match him in combat,"},{"id":"seytek-2012:p0693:b002:l022","ordinal":347038,"en":"Fighting on without strength enough,"},{"id":"seytek-2012:p0693:b002:l023","ordinal":347039,"en":"He will make girls and women widows,"},{"id":"seytek-2012:p0693:b002:l024","ordinal":347040,"en":"And turn the mighty into slaves;"},{"id":"seytek-2012:p0693:b002:l025","ordinal":347041,"en":"I fear he will destroy us all."},{"id":"seytek-2012:p0693:b002:l026","ordinal":347042,"en":"Sweeping away every last trace,"},{"id":"seytek-2012:p0693:b002:l027","ordinal":347043,"en":"I fear he will leave us slaughtered."},{"id":"seytek-2012:p0693:b002:l028","ordinal":347044,"en":"The people wailed in anguish,"},{"id":"seytek-2012:p0693:b002:l029","ordinal":347045,"en":"Despairing of their fly-like lives."},{"id":"seytek-2012:p0693:b002:l030","ordinal":347046,"en":"All the warriors groaned,"},{"id":"seytek-2012:p0693:b002:l031","ordinal":347047,"en":"And the people despaired of life."},{"id":"seytek-2012:p0693:b002:l032","ordinal":347048,"en":"What will become of us in the end?"},{"id":"seytek-2012:p0693:b002:l033","ordinal":347049,"en":"Not one of us will remain."},{"id":"seytek-2012:p0693:b002:l034","ordinal":347050,"en":"Our blood will flow like water,"},{"id":"seytek-2012:p0693:b002:l035","ordinal":347051,"en":"And all of us will be massacred."},{"id":"seytek-2012:p0693:b002:l036","ordinal":347052,"en":"I fear he will utterly destroy us,"},{"id":"seytek-2012:p0693:b002:l037","ordinal":347053,"en":"And now bind and carry off"},{"id":"seytek-2012:p0693:b002:l038","ordinal":347054,"en":"The people who once lived in peace."},{"id":"seytek-2012:p0693:b002:l039","ordinal":347055,"en":"I fear he will crush and kill the leaders."},{"id":"seytek-2012:p0693:b002:l040","ordinal":347056,"en":"The one God, the Lord Most High,"},{"id":"seytek-2012:p0693:b003:l001","ordinal":347057,"en":"Had grown wrathful, and Sarybai"},{"id":"seytek-2012:p0693:b003:l002","ordinal":347058,"en":"Strode about roaring."},{"id":"seytek-2012:p0693:b003:l003","ordinal":347059,"en":"Every human creature’s"},{"id":"seytek-2012:p0693:b003:l004","ordinal":347060,"en":"Whole body shuddered;"},{"id":"seytek-2012:p0693:b003:l005","ordinal":347061,"en":"In furious anguish,"},{"id":"seytek-2012:p0693:b003:l006","ordinal":347062,"en":"Every living creature"},{"id":"seytek-2012:p0693:b003:l007","ordinal":347063,"en":"Despaired of its wretched life."},{"id":"seytek-2012:p0693:b003:l008","ordinal":347064,"en":"Your infidel son of a monster"},{"id":"seytek-2012:p0693:b003:l009","ordinal":347065,"en":"Showed himself a demon;"},{"id":"seytek-2012:p0693:b003:l010","ordinal":347066,"en":"His cavernous mouth opened,"},{"id":"seytek-2012:p0693:b003:l011","ordinal":347067,"en":"And fiery, venomous breath"},{"id":"seytek-2012:p0693:b003:l012","ordinal":347068,"en":"Sprayed from his mouth."},{"id":"seytek-2012:p0693:b003:l013","ordinal":347069,"en":"Everyone who saw him"},{"id":"seytek-2012:p0693:b003:l014","ordinal":347070,"en":"Was broken in body and crushed."},{"id":"seytek-2012:p0693:b003:l015","ordinal":347071,"en":"The people wailed in anguish,"},{"id":"seytek-2012:p0693:b003:l016","ordinal":347072,"en":"And the watching multitude said,"},{"id":"seytek-2012:p0693:b003:l017","ordinal":347073,"en":"“Sarybai is a demon,”"},{"id":"seytek-2012:p0693:b003:l018","ordinal":347074,"en":"Despairing of their fly-like lives."},{"id":"seytek-2012:p0693:b003:l019","ordinal":347075,"en":"Külchoro was a lion upheld by the saints,"},{"id":"seytek-2012:p0693:b003:l020","ordinal":347076,"en":"A lion and tiger"},{"id":"seytek-2012:p0693:b003:l021","ordinal":347077,"en":"Who had subdued the whole world."},{"id":"seytek-2012:p0693:b003:l022","ordinal":347078,"en":"For these Kyrgyz, Külchoro"},{"id":"seytek-2012:p0693:b003:l023","ordinal":347079,"en":"Was an iron gate and fortress."},{"id":"seytek-2012:p0693:b003:l024","ordinal":347080,"en":"“God, preserve Choro!” they cried."},{"id":"seytek-2012:p0693:b003:l025","ordinal":347081,"en":"Hero Semetey wept blood,"},{"id":"seytek-2012:p0693:b003:l026","ordinal":347082,"en":"The white-bearded elders wept,"},{"id":"seytek-2012:p0693:b003:l027","ordinal":347083,"en":"All the common people wept;"},{"id":"seytek-2012:p0693:b003:l028","ordinal":347084,"en":"All the nation grieved,"},{"id":"seytek-2012:p0693:b003:l029","ordinal":347085,"en":"And the people despaired of life."},{"id":"seytek-2012:p0693:b003:l030","ordinal":347086,"en":"Would he slaughter the heroes and khans,"},{"id":"seytek-2012:p0693:b003:l031","ordinal":347087,"en":"And destroy so many souls?"},{"id":"seytek-2012:p0693:b003:l032","ordinal":347088,"en":"Would he exterminate them all together,"},{"id":"seytek-2012:p0693:b003:l033","ordinal":347089,"en":"Leaving not a hair of living souls,"},{"id":"seytek-2012:p0693:b003:l034","ordinal":347090,"en":"And depart after massacring them?"},{"id":"seytek-2012:p0693:b003:l035","ordinal":347091,"en":"Sarybai was no man, but venom;"},{"id":"seytek-2012:p0693:b003:l036","ordinal":347092,"en":"He was the great God’s wrath."},{"id":"seytek-2012:p0693:b003:l037","ordinal":347093,"en":"He bore a vengeance passed down from old,"},{"id":"seytek-2012:p0693:b003:l038","ordinal":347094,"en":"The vengeance of Mader."},{"id":"seytek-2012:p0693:b003:l039","ordinal":347095,"en":"He mangled all who crossed him,"},{"id":"seytek-2012:p0693:b003:l040","ordinal":347096,"en":"And devoured all whom he encountered."},{"id":"seytek-2012:p0694:b002:l001","ordinal":347097,"en":"“What dire hardship, what grievous plight!"},{"id":"seytek-2012:p0694:b002:l002","ordinal":347098,"en":"What will become of the people?”"},{"id":"seytek-2012:p0694:b002:l003","ordinal":347099,"en":"“The madman grows more violent,"},{"id":"seytek-2012:p0694:b002:l004","ordinal":347100,"en":"And will suck out every soul.”"},{"id":"seytek-2012:p0694:b002:l005","ordinal":347101,"en":"Külchoro was a lion upheld by the saints,"},{"id":"seytek-2012:p0694:b002:l006","ordinal":347102,"en":"A hero fit to face the foe,"},{"id":"seytek-2012:p0694:b002:l007","ordinal":347103,"en":"The very backbone of these Kyrgyz."},{"id":"seytek-2012:p0694:b002:l008","ordinal":347104,"en":"He was a khan like a leopard,"},{"id":"seytek-2012:p0694:b002:l009","ordinal":347105,"en":"With the courage of a lion."},{"id":"seytek-2012:p0694:b002:l010","ordinal":347106,"en":"“Trample the many foes beneath your feet;"},{"id":"seytek-2012:p0694:b002:l011","ordinal":347107,"en":"God, if you created him as a living soul,"},{"id":"seytek-2012:p0694:b002:l012","ordinal":347108,"en":"Keep Külchoro safe!"},{"id":"seytek-2012:p0694:b002:l013","ordinal":347109,"en":"If anything happens to Külchoro,"},{"id":"seytek-2012:p0694:b002:l014","ordinal":347110,"en":"Our backbone will be broken,"},{"id":"seytek-2012:p0694:b002:l015","ordinal":347111,"en":"And our people massacred."},{"id":"seytek-2012:p0694:b002:l016","ordinal":347112,"en":"Our lifeblood will burst forth—"},{"id":"seytek-2012:p0694:b002:l017","ordinal":347113,"en":"Thus will our breath leave us."},{"id":"seytek-2012:p0694:b002:l018","ordinal":347114,"en":"We stand here with purpose;"},{"id":"seytek-2012:p0694:b002:l019","ordinal":347115,"en":"Make this merely an age of trial fallen upon us."},{"id":"seytek-2012:p0694:b002:l020","ordinal":347116,"en":"God, if you created him as a living soul,"},{"id":"seytek-2012:p0694:b002:l021","ordinal":347117,"en":"God, keep Choro safe!”"},{"id":"seytek-2012:p0694:b002:l022","ordinal":347118,"en":"The nation clamored and cried out,"},{"id":"seytek-2012:p0694:b002:l023","ordinal":347119,"en":"And the people despaired of life."},{"id":"seytek-2012:p0694:b002:l024","ordinal":347120,"en":"Your infidel son of a monster"},{"id":"seytek-2012:p0694:b002:l025","ordinal":347121,"en":"Could not be reached by fired bullets;"},{"id":"seytek-2012:p0694:b002:l026","ordinal":347122,"en":"Thrust spears could not pierce him,"},{"id":"seytek-2012:p0694:b002:l027","ordinal":347123,"en":"Nor would engulfing flames burn him."},{"id":"seytek-2012:p0694:b002:l028","ordinal":347124,"en":"The madman was invulnerable;"},{"id":"seytek-2012:p0694:b002:l029","ordinal":347125,"en":"None knew where his mortal spot lay."},{"id":"seytek-2012:p0694:b002:l030","ordinal":347126,"en":"His champions were unlike other men,"},{"id":"seytek-2012:p0694:b002:l031","ordinal":347127,"en":"And brought calamity upon our poor heads."},{"id":"seytek-2012:p0694:b002:l032","ordinal":347128,"en":"He raged bewilderingly through battle,"},{"id":"seytek-2012:p0694:b002:l033","ordinal":347129,"en":"Breaking seventy spears,"},{"id":"seytek-2012:p0694:b002:l034","ordinal":347130,"en":"Exposing muscle to bullets."},{"id":"seytek-2012:p0694:b002:l035","ordinal":347131,"en":"Armor impervious to bullets was torn,"},{"id":"seytek-2012:p0694:b002:l036","ordinal":347132,"en":"And from the bullet-defying gray colt"},{"id":"seytek-2012:p0694:b002:l037","ordinal":347133,"en":"The valiant Külchoro was parted."},{"id":"seytek-2012:p0694:b002:l038","ordinal":347134,"en":"For seven days he ranged about,"},{"id":"seytek-2012:p0694:b002:l039","ordinal":347135,"en":"Wounding all he reached,"},{"id":"seytek-2012:p0694:b002:l040","ordinal":347136,"en":"Until strength and power were exhausted;"}]
