[{"id":"manas-2010:p0176:b002:l029","ordinal":7681,"en":"Their mighty, mighty champions,"},{"id":"manas-2010:p0176:b002:l030","ordinal":7682,"en":"The army began to march."},{"id":"manas-2010:p0176:b002:l031","ordinal":7683,"en":"Dust flew into the sky,"},{"id":"manas-2010:p0176:b002:l032","ordinal":7684,"en":"The army marched in a throng,"},{"id":"manas-2010:p0176:b002:l033","ordinal":7685,"en":"Dust flew into the sky,"},{"id":"manas-2010:p0176:b002:l034","ordinal":7686,"en":"The sky was clear, the earth clouded,"},{"id":"manas-2010:p0176:b002:l035","ordinal":7687,"en":"Spearheads clashed,"},{"id":"manas-2010:p0176:b002:l036","ordinal":7688,"en":"Men's heads knocked together,"},{"id":"manas-2010:p0176:b002:l037","ordinal":7689,"en":"Like a forest, like a flood,"},{"id":"manas-2010:p0176:b002:l038","ordinal":7690,"en":"The warrior champions surged,"},{"id":"manas-2010:p0176:b002:l039","ordinal":7691,"en":"Waving a mottled bay-colored banner,"},{"id":"manas-2010:p0176:b002:l040","ordinal":7692,"en":"Döngö and Great Zholoy"},{"id":"manas-2010:p0176:b002:l041","ordinal":7693,"en":"Followed behind, driving the host,"},{"id":"manas-2010:p0176:b002:l042","ordinal":7694,"en":"Gathering their host and driving it together,"},{"id":"manas-2010:p0176:b002:l043","ordinal":7695,"en":"Riding a horse like Achbuudan,"},{"id":"manas-2010:p0176:b002:l044","ordinal":7696,"en":"Of the Black Kalmyks and Manchus,"},{"id":"manas-2010:p0176:b002:l045","ordinal":7697,"en":"Khan Zholoy was their hero,"},{"id":"manas-2010:p0176:b002:l046","ordinal":7698,"en":"Clad in blue-grey armor,"},{"id":"manas-2010:p0176:b002:l047","ordinal":7699,"en":"Such was Zholoy to behold,"},{"id":"manas-2010:p0176:b002:l048","ordinal":7700,"en":"Raging like a grey tiger,"},{"id":"manas-2010:p0177:b002:l001","ordinal":7701,"en":"Jeweled buttons as large as fists,"},{"id":"manas-2010:p0177:b002:l002","ordinal":7702,"en":"Raging like a grey lion,"},{"id":"manas-2010:p0177:b002:l003","ordinal":7703,"en":"Such was Döngö to behold."},{"id":"manas-2010:p0177:b002:l004","ordinal":7704,"en":"Blue-grey armor no bullet could pierce,"},{"id":"manas-2010:p0177:b002:l005","ordinal":7705,"en":"Blue-grey armor with a spreading skirt,"},{"id":"manas-2010:p0177:b002:l006","ordinal":7706,"en":"A length of fiber a kary long,"},{"id":"manas-2010:p0177:b002:l007","ordinal":7707,"en":"Mixed with filings of steel,"},{"id":"manas-2010:p0177:b002:l008","ordinal":7708,"en":"He had placed within it,"},{"id":"manas-2010:p0177:b002:l009","ordinal":7709,"en":"If a man thrust with a spear,"},{"id":"manas-2010:p0177:b002:l010","ordinal":7710,"en":"It would weary his arm,"},{"id":"manas-2010:p0177:b002:l011","ordinal":7711,"en":"It satisfied the eye to see,"},{"id":"manas-2010:p0177:b002:l012","ordinal":7712,"en":"No thrusting spear could pierce it,"},{"id":"manas-2010:p0177:b002:l013","ordinal":7713,"en":"Wearing a green armored coat,"},{"id":"manas-2010:p0177:b002:l014","ordinal":7714,"en":"Riding mules and tulpar steeds,"},{"id":"manas-2010:p0177:b002:l015","ordinal":7715,"en":"Dust flew into the sky,"},{"id":"manas-2010:p0177:b002:l016","ordinal":7716,"en":"The army seethed and thronged,"},{"id":"manas-2010:p0177:b002:l017","ordinal":7717,"en":"The people of Beejin stirred,"},{"id":"manas-2010:p0177:b002:l018","ordinal":7718,"en":"When the host was counted,"},{"id":"manas-2010:p0177:b002:l019","ordinal":7719,"en":"It was a full ten thousand men,"},{"id":"manas-2010:p0177:b002:l020","ordinal":7720,"en":"Not a little, but a multitude,"},{"id":"manas-2010:p0177:b002:l021","ordinal":7721,"en":"The copper pipe clattered,"},{"id":"manas-2010:p0177:b002:l022","ordinal":7722,"en":"The trumpet blared,"},{"id":"manas-2010:p0177:b002:l023","ordinal":7723,"en":"Shrill instruments sounded, a clamor rose,"},{"id":"manas-2010:p0177:b002:l024","ordinal":7724,"en":"They struck the war drum with a crash,"},{"id":"manas-2010:p0177:b002:l025","ordinal":7725,"en":"The captains of ten wheeled about,"},{"id":"manas-2010:p0177:b002:l026","ordinal":7726,"en":"The spearmen in a separate body,"},{"id":"manas-2010:p0177:b002:l027","ordinal":7727,"en":"Their points projecting at the front,"},{"id":"manas-2010:p0177:b002:l028","ordinal":7728,"en":"The captains of a hundred ran,"},{"id":"manas-2010:p0177:b002:l029","ordinal":7729,"en":"Captains of fifty, captains of a hundred,"},{"id":"manas-2010:p0177:b002:l030","ordinal":7730,"en":"When one saw the captains of a thousand,"},{"id":"manas-2010:p0177:b002:l031","ordinal":7731,"en":"One despaired of precious life,"},{"id":"manas-2010:p0177:b002:l032","ordinal":7732,"en":"Dust billowed from the valley,"},{"id":"manas-2010:p0177:b002:l033","ordinal":7733,"en":"Your doomed Black Kalmyks,"},{"id":"manas-2010:p0177:b002:l034","ordinal":7734,"en":"Shouting out their songs,"},{"id":"manas-2010:p0177:b002:l035","ordinal":7735,"en":"The dense host flooded forth in a mass,"},{"id":"manas-2010:p0177:b002:l036","ordinal":7736,"en":"Whoever saw it grieved,"},{"id":"manas-2010:p0177:b002:l037","ordinal":7737,"en":"The army moved in swaying ranks,"},{"id":"manas-2010:p0177:b002:l038","ordinal":7738,"en":"Mighty bows and lacquered arrows,"},{"id":"manas-2010:p0177:b002:l039","ordinal":7739,"en":"‘Bring Manas back bound,’ he said,"},{"id":"manas-2010:p0177:b002:l040","ordinal":7740,"en":"Mighty Esenkan"},{"id":"manas-2010:p0177:b002:l041","ordinal":7741,"en":"Laid the matter before his people."},{"id":"manas-2010:p0177:b002:l042","ordinal":7742,"en":"All his champions,"},{"id":"manas-2010:p0177:b002:l043","ordinal":7743,"en":"With their elder, hero Döngö,"},{"id":"manas-2010:p0177:b002:l044","ordinal":7744,"en":"Taking an army of ten thousand men,"},{"id":"manas-2010:p0177:b002:l045","ordinal":7745,"en":"Receiving Esenkan's harsh command and leave,"},{"id":"manas-2010:p0177:b002:l046","ordinal":7746,"en":"Taking a host that covered the land,"},{"id":"manas-2010:p0177:b002:l047","ordinal":7747,"en":"Raising seven banners and a standard,"},{"id":"manas-2010:p0177:b002:l048","ordinal":7748,"en":"To every place they reached,"},{"id":"manas-2010:p0178:b002:l001","ordinal":7749,"en":"They brought piercing shouts and clamor,"},{"id":"manas-2010:p0178:b002:l002","ordinal":7750,"en":"The war drum was beaten hard,"},{"id":"manas-2010:p0178:b002:l003","ordinal":7751,"en":"The army lost its senses,"},{"id":"manas-2010:p0178:b002:l004","ordinal":7752,"en":"His many kinds of mighty champions"},{"id":"manas-2010:p0178:b002:l005","ordinal":7753,"en":"Flooded everywhere."},{"id":"manas-2010:p0178:b002:l006","ordinal":7754,"en":"Crossing ridge after ridge,"},{"id":"manas-2010:p0178:b002:l007","ordinal":7755,"en":"Treading rough and hilly ground,"},{"id":"manas-2010:p0178:b002:l008","ordinal":7756,"en":"Crossing many swelling mountains,"},{"id":"manas-2010:p0178:b002:l009","ordinal":7757,"en":"Passing through steep ravines,"},{"id":"manas-2010:p0178:b002:l010","ordinal":7758,"en":"Traveling without sparing themselves,"},{"id":"manas-2010:p0178:b002:l011","ordinal":7759,"en":"Treading winding mountain ways,"},{"id":"manas-2010:p0178:b002:l012","ordinal":7760,"en":"Fording twisting rivers,"},{"id":"manas-2010:p0178:b002:l013","ordinal":7761,"en":"How could the army spare itself,"},{"id":"manas-2010:p0178:b002:l014","ordinal":7762,"en":"The great army had arrived,"},{"id":"manas-2010:p0178:b002:l015","ordinal":7763,"en":"Drawing near the mountains of Altai,"},{"id":"manas-2010:p0178:b002:l016","ordinal":7764,"en":"If you ask who led the host,"},{"id":"manas-2010:p0178:b002:l017","ordinal":7765,"en":"Döngö and hero Zholoy."},{"id":"manas-2010:p0178:b002:l018","ordinal":7766,"en":"“Here, with the army,"},{"id":"manas-2010:p0178:b002:l019","ordinal":7767,"en":"Let us rest for three months,"},{"id":"manas-2010:p0178:b002:l020","ordinal":7768,"en":"To rich Jakyp of the forty Kyrgyz households,"},{"id":"manas-2010:p0178:b002:l021","ordinal":7769,"en":"Let us send an envoy."},{"id":"manas-2010:p0178:b002:l022","ordinal":7770,"en":"Are they warriors, are they lions,"},{"id":"manas-2010:p0178:b002:l023","ordinal":7771,"en":"Or powerless lumps of black earth?"},{"id":"manas-2010:p0178:b002:l024","ordinal":7772,"en":"Fugitives hiding in holes,"},{"id":"manas-2010:p0178:b002:l025","ordinal":7773,"en":"Are the forty Kyrgyz households a people?"},{"id":"manas-2010:p0178:b002:l026","ordinal":7774,"en":"Mighty Döngö, my champion,"},{"id":"manas-2010:p0178:b002:l027","ordinal":7775,"en":"You send out a hundred men,"},{"id":"manas-2010:p0178:b002:l028","ordinal":7776,"en":"From the Kalmyks, I, Khan Zholoy,"},{"id":"manas-2010:p0178:b002:l029","ordinal":7777,"en":"Will send out a hundred men."},{"id":"manas-2010:p0178:b002:l030","ordinal":7778,"en":"On Esenkan's forty nar camels,"},{"id":"manas-2010:p0178:b002:l031","ordinal":7779,"en":"Many jewels and yellow gold,"},{"id":"manas-2010:p0178:b002:l032","ordinal":7780,"en":"Let us pack them in bags and load them,"},{"id":"manas-2010:p0178:b002:l033","ordinal":7781,"en":"The broad, curving pipe,"},{"id":"manas-2010:p0178:b002:l034","ordinal":7782,"en":"Bending it around from a corner,"},{"id":"manas-2010:p0178:b002:l035","ordinal":7783,"en":"With six Sarts at their head,"},{"id":"manas-2010:p0178:b002:l036","ordinal":7784,"en":"Let us send them, saying, ‘Go and trade,’"},{"id":"manas-2010:p0178:b002:l037","ordinal":7785,"en":"And among those wares,"},{"id":"manas-2010:p0178:b002:l038","ordinal":7786,"en":"Have crimson cloth folded,"},{"id":"manas-2010:p0178:b002:l039","ordinal":7787,"en":"Have the champions carry it,"},{"id":"manas-2010:p0178:b002:l040","ordinal":7788,"en":"Let two hundred warrior champions go,"},{"id":"manas-2010:p0178:b002:l041","ordinal":7789,"en":"Let rough and fierce men go together."},{"id":"manas-2010:p0178:b002:l042","ordinal":7790,"en":"Into the damned Burut's camp,"},{"id":"manas-2010:p0178:b002:l043","ordinal":7791,"en":"Enter dragging your whips,"},{"id":"manas-2010:p0178:b002:l044","ordinal":7792,"en":"To the bustling Burut,"},{"id":"manas-2010:p0178:b002:l045","ordinal":7793,"en":"Sell the cloth you have brought,"},{"id":"manas-2010:p0178:b002:l046","ordinal":7794,"en":"Slaughter one nar unseen,"},{"id":"manas-2010:p0178:b002:l047","ordinal":7795,"en":"Of that damned Jakyp,"},{"id":"manas-2010:p0178:b002:l048","ordinal":7796,"en":"Hide it under his tent's eaves,"},{"id":"manas-2010:p0179:b002:l001","ordinal":7797,"en":"Gather, all two hundred of you,"},{"id":"manas-2010:p0179:b002:l002","ordinal":7798,"en":"Bring a claim against rich Jakyp."},{"id":"manas-2010:p0179:b002:l003","ordinal":7799,"en":"‘You stole and slaughtered my nar,’ say,"},{"id":"manas-2010:p0179:b002:l004","ordinal":7800,"en":"Build up a definite quarrel,"},{"id":"manas-2010:p0179:b002:l005","ordinal":7801,"en":"‘As compensation for my nar,"},{"id":"manas-2010:p0179:b002:l006","ordinal":7802,"en":"Give your son Manas,’ say,"},{"id":"manas-2010:p0179:b002:l007","ordinal":7803,"en":"Demand him as the penalty."},{"id":"manas-2010:p0179:b004:l001","ordinal":7804,"en":"As compensation, Manas,"},{"id":"manas-2010:p0179:b004:l002","ordinal":7805,"en":"If that Burut will not give him,"},{"id":"manas-2010:p0179:b004:l003","ordinal":7806,"en":"Enter dragging your whips,"},{"id":"manas-2010:p0179:b004:l004","ordinal":7807,"en":"Of that damned Burut,"},{"id":"manas-2010:p0179:b004:l005","ordinal":7808,"en":"Slit the very scalp."},{"id":"manas-2010:p0179:b004:l006","ordinal":7809,"en":"Raise a quarrel, do this,"},{"id":"manas-2010:p0179:b004:l007","ordinal":7810,"en":"Of that damned Burut,"},{"id":"manas-2010:p0179:b004:l008","ordinal":7811,"en":"Search through one of his bundles."},{"id":"manas-2010:p0179:b004:l009","ordinal":7812,"en":"Plunder his livestock,"},{"id":"manas-2010:p0179:b004:l010","ordinal":7813,"en":"Upon that Burut's head,"},{"id":"manas-2010:p0179:b004:l011","ordinal":7814,"en":"Bring a calamity."},{"id":"manas-2010:p0179:b004:l012","ordinal":7815,"en":"Break into his dwelling,"},{"id":"manas-2010:p0179:b004:l013","ordinal":7816,"en":"If he comes blustering,"},{"id":"manas-2010:p0179:b004:l014","ordinal":7817,"en":"Seize that Burut,"},{"id":"manas-2010:p0179:b004:l015","ordinal":7818,"en":"Slash his scalp this way and that."},{"id":"manas-2010:p0179:b004:l016","ordinal":7819,"en":"Trample on his head,"},{"id":"manas-2010:p0179:b004:l017","ordinal":7820,"en":"Scatter his four kinds of livestock,"},{"id":"manas-2010:p0179:b004:l018","ordinal":7821,"en":"If he will not heed your words,"},{"id":"manas-2010:p0179:b004:l019","ordinal":7822,"en":"If he will not give that Manas,"},{"id":"manas-2010:p0179:b004:l020","ordinal":7823,"en":"Roll up your sleeves and enter,"},{"id":"manas-2010:p0179:b004:l021","ordinal":7824,"en":"Beat his ashes into clouds of dust,"},{"id":"manas-2010:p0179:b004:l022","ordinal":7825,"en":"Go in and raise a turmoil."},{"id":"manas-2010:p0179:b004:l023","ordinal":7826,"en":"Raid his horses and mares,"},{"id":"manas-2010:p0179:b004:l024","ordinal":7827,"en":"If the Burut comes near,"},{"id":"manas-2010:p0179:b004:l025","ordinal":7828,"en":"Smash his brains and scatter them."},{"id":"manas-2010:p0179:b004:l026","ordinal":7829,"en":"Plunder his possessions,"},{"id":"manas-2010:p0179:b004:l027","ordinal":7830,"en":"Bring horrors upon his home."},{"id":"manas-2010:p0179:b004:l028","ordinal":7831,"en":"Plunder his livestock,"},{"id":"manas-2010:p0179:b004:l029","ordinal":7832,"en":"Bring slaughter upon him!"},{"id":"manas-2010:p0179:b004:l030","ordinal":7833,"en":"His cherished son Manas,"},{"id":"manas-2010:p0179:b004:l031","ordinal":7834,"en":"Bind him at once,"},{"id":"manas-2010:p0179:b004:l032","ordinal":7835,"en":"Find some fault of his,"},{"id":"manas-2010:p0179:b004:l033","ordinal":7836,"en":"Stir all his fury,"},{"id":"manas-2010:p0179:b004:l034","ordinal":7837,"en":"Take his countless cattle,"},{"id":"manas-2010:p0179:b004:l035","ordinal":7838,"en":"Upon that damned Burut,"},{"id":"manas-2010:p0179:b004:l036","ordinal":7839,"en":"Bring the end of the world!"},{"id":"manas-2010:p0180:b002:l001","ordinal":7840,"en":"Slaughter their bold ones,"},{"id":"manas-2010:p0180:b002:l002","ordinal":7841,"en":"Upon the damned Burut,"},{"id":"manas-2010:p0180:b002:l003","ordinal":7842,"en":"Wreak havoc."},{"id":"manas-2010:p0180:b002:l004","ordinal":7843,"en":"If he speaks blusteringly,"},{"id":"manas-2010:p0180:b002:l005","ordinal":7844,"en":"Bring calamity upon him."},{"id":"manas-2010:p0180:b002:l006","ordinal":7845,"en":"‘You have committed theft, Burut,’ say,"},{"id":"manas-2010:p0180:b002:l007","ordinal":7846,"en":"And plunder his livestock."},{"id":"manas-2010:p0180:b002:l008","ordinal":7847,"en":"‘Here, we have found our thief,’ say,"},{"id":"manas-2010:p0180:b002:l009","ordinal":7848,"en":"And bind Manas,"},{"id":"manas-2010:p0180:b002:l010","ordinal":7849,"en":"Find some fault of his,"},{"id":"manas-2010:p0180:b002:l011","ordinal":7850,"en":"Of that damned Burut,"},{"id":"manas-2010:p0180:b002:l012","ordinal":7851,"en":"Stir his fury to its depths.”"},{"id":"manas-2010:p0180:b002:l013","ordinal":7852,"en":"Thus spoke hero Zholoy,"},{"id":"manas-2010:p0180:b002:l014","ordinal":7853,"en":"With hero Döngö at the head,"},{"id":"manas-2010:p0180:b002:l015","ordinal":7854,"en":"He selected two hundred,"},{"id":"manas-2010:p0180:b002:l016","ordinal":7855,"en":"As leader of the two hundred,"},{"id":"manas-2010:p0180:b002:l017","ordinal":7856,"en":"He appointed his Great Döödür."},{"id":"manas-2010:p0180:b002:l018","ordinal":7857,"en":"On Esenkan's forty treasury nar camels,"},{"id":"manas-2010:p0180:b002:l019","ordinal":7858,"en":"They loaded gold, silver, gold coins,"},{"id":"manas-2010:p0180:b002:l020","ordinal":7859,"en":"Traveling as traders,"},{"id":"manas-2010:p0180:b002:l021","ordinal":7860,"en":"To find some crookedness somehow,"},{"id":"manas-2010:p0180:b002:l022","ordinal":7861,"en":"To raid the Kyrgyz somehow,"},{"id":"manas-2010:p0180:b002:l023","ordinal":7862,"en":"Taking the shortest road to Altai,"},{"id":"manas-2010:p0180:b002:l024","ordinal":7863,"en":"With some two hundred champions behind,"},{"id":"manas-2010:p0180:b002:l025","ordinal":7864,"en":"Six poor Sarts set out,"},{"id":"manas-2010:p0180:b002:l026","ordinal":7865,"en":"Leading the forty nar camels in train,"},{"id":"manas-2010:p0180:b002:l027","ordinal":7866,"en":"The champions behind them."},{"id":"manas-2010:p0180:b002:l028","ordinal":7867,"en":"What the champions carried—"},{"id":"manas-2010:p0180:b002:l029","ordinal":7868,"en":"Battle-axes, swords, war drums,"},{"id":"manas-2010:p0180:b002:l030","ordinal":7869,"en":"Of those champions of mighty courage,"},{"id":"manas-2010:p0180:b002:l031","ordinal":7870,"en":"If you see their form, flee far away!"},{"id":"manas-2010:p0180:b002:l032","ordinal":7871,"en":"Their champions were extraordinary,"},{"id":"manas-2010:p0180:b002:l033","ordinal":7872,"en":"All renowned, outstanding heroes,"},{"id":"manas-2010:p0180:b002:l034","ordinal":7873,"en":"They had giants as huge as elephants,"},{"id":"manas-2010:p0180:b002:l035","ordinal":7874,"en":"Leaving the tale there for now,"},{"id":"manas-2010:p0180:b002:l036","ordinal":7875,"en":"The mighty ones had arrived."},{"id":"manas-2010:p0180:b002:l037","ordinal":7876,"en":"The hero of the two hundred,"},{"id":"manas-2010:p0180:b002:l038","ordinal":7877,"en":"The boundless infidel Döödür,"},{"id":"manas-2010:p0180:b002:l039","ordinal":7878,"en":"When he glared, his eyes were like Venus,"},{"id":"manas-2010:p0180:b002:l040","ordinal":7879,"en":"His ears, if you saw them, like shields,"},{"id":"manas-2010:p0180:b002:l041","ordinal":7880,"en":"If you looked at his mustache,"},{"id":"manas-2010:p0180:b002:l042","ordinal":7881,"en":"Like nettles growing on an old camp site,"},{"id":"manas-2010:p0180:b002:l043","ordinal":7882,"en":"His bulk like a mountain ridge,"},{"id":"manas-2010:p0180:b002:l044","ordinal":7883,"en":"Against Jakyp of the forty Kyrgyz households,"},{"id":"manas-2010:p0180:b002:l045","ordinal":7884,"en":"He alone seemed ready to enter and devour them."},{"id":"manas-2010:p0180:b002:l046","ordinal":7885,"en":"At that time Khan Manas,"},{"id":"manas-2010:p0180:b002:l047","ordinal":7886,"en":"His Toruchaar stood ready,"},{"id":"manas-2010:p0180:b002:l048","ordinal":7887,"en":"At that time Manas's—"},{"id":"manas-2010:p0181:b002:l001","ordinal":7888,"en":"Many tulpar steeds were tethered at the hitching line,"},{"id":"manas-2010:p0181:b002:l002","ordinal":7889,"en":"When bored, he hunted roe deer,"},{"id":"manas-2010:p0181:b002:l003","ordinal":7890,"en":"When not bored, mighty Manas"},{"id":"manas-2010:p0181:b002:l004","ordinal":7891,"en":"Played freely at his ease."},{"id":"manas-2010:p0181:b002:l005","ordinal":7892,"en":"In wondrous games and revelry,"},{"id":"manas-2010:p0181:b002:l006","ordinal":7893,"en":"He was immersed at that time,"},{"id":"manas-2010:p0181:b002:l007","ordinal":7894,"en":"Marking out forty foot-lengths for ordo,"},{"id":"manas-2010:p0181:b002:l008","ordinal":7895,"en":"He was shooting the knucklebones."},{"id":"manas-2010:p0181:b002:l009","ordinal":7896,"en":"Fillies in lots of forty,"},{"id":"manas-2010:p0181:b002:l010","ordinal":7897,"en":"They staked as prizes,"},{"id":"manas-2010:p0181:b002:l011","ordinal":7898,"en":"The winners slaughtered what they won,"},{"id":"manas-2010:p0181:b002:l012","ordinal":7899,"en":"Slaughtering a yearling horse for midday,"},{"id":"manas-2010:p0181:b002:l013","ordinal":7900,"en":"Slaughtering a mare for the night,"},{"id":"manas-2010:p0181:b002:l014","ordinal":7901,"en":"Gnawing horse-rib fat like snow,"},{"id":"manas-2010:p0181:b002:l015","ordinal":7902,"en":"Sipping dark liquor in Kalmyk fashion,"},{"id":"manas-2010:p0181:b002:l016","ordinal":7903,"en":"Playing chatyrash and making a din,"},{"id":"manas-2010:p0181:b002:l017","ordinal":7904,"en":"In entertaining pleasures,"},{"id":"manas-2010:p0181:b002:l018","ordinal":7905,"en":"He was immersed at that time,"},{"id":"manas-2010:p0181:b002:l019","ordinal":7906,"en":"Setting up ordo, playing many games,"},{"id":"manas-2010:p0181:b002:l020","ordinal":7907,"en":"He was shooting the knucklebones."},{"id":"manas-2010:p0181:b002:l021","ordinal":7908,"en":"The leopard blessed by Khizir,"},{"id":"manas-2010:p0181:b002:l022","ordinal":7909,"en":"My holy one who would accomplish much,"},{"id":"manas-2010:p0181:b002:l023","ordinal":7910,"en":"Manas had become Manas,"},{"id":"manas-2010:p0181:b002:l024","ordinal":7911,"en":"He had won the name of Manas,"},{"id":"manas-2010:p0181:b002:l025","ordinal":7912,"en":"If you ask his noble age,"},{"id":"manas-2010:p0181:b002:l026","ordinal":7913,"en":"He had turned twelve,"},{"id":"manas-2010:p0181:b002:l027","ordinal":7914,"en":"He rode Toruchaar,"},{"id":"manas-2010:p0181:b002:l028","ordinal":7915,"en":"He wore bulletproof armor."},{"id":"manas-2010:p0181:b002:l029","ordinal":7916,"en":"At that time your Manas,"},{"id":"manas-2010:p0181:b002:l030","ordinal":7917,"en":"Finding no mountain to dash against,"},{"id":"manas-2010:p0181:b002:l031","ordinal":7918,"en":"Finding no enemy to fight,"},{"id":"manas-2010:p0181:b002:l032","ordinal":7919,"en":"Finding no shot to exchange,"},{"id":"manas-2010:p0181:b002:l033","ordinal":7920,"en":"Finding no embers to wade through,"},{"id":"manas-2010:p0181:b002:l034","ordinal":7921,"en":"Humming zing-zing, untroubled,"},{"id":"manas-2010:p0181:b002:l035","ordinal":7922,"en":"The Black Kytay and Manchus,"},{"id":"manas-2010:p0181:b002:l036","ordinal":7923,"en":"He thought of fighting them,"},{"id":"manas-2010:p0181:b002:l037","ordinal":7924,"en":"That leopard had come to regard them"},{"id":"manas-2010:p0181:b002:l038","ordinal":7925,"en":"As worth less than his trouser-leg."},{"id":"manas-2010:p0181:b002:l039","ordinal":7926,"en":"The oppression the Kytay had inflicted,"},{"id":"manas-2010:p0181:b002:l040","ordinal":7927,"en":"Their slaughter of many of his people,"},{"id":"manas-2010:p0181:b002:l041","ordinal":7928,"en":"He had long considered and understood."},{"id":"manas-2010:p0181:b002:l042","ordinal":7929,"en":"“Those seething infidels,"},{"id":"manas-2010:p0181:b002:l043","ordinal":7930,"en":"Those heroes who wage battle,"},{"id":"manas-2010:p0181:b002:l044","ordinal":7931,"en":"If only I could meet them face to face,” he said,"},{"id":"manas-2010:p0181:b002:l045","ordinal":7932,"en":"“If only I could wreak great slaughter,” he said,"},{"id":"manas-2010:p0181:b002:l046","ordinal":7933,"en":"“Those Manchus who boast of valor,"},{"id":"manas-2010:p0181:b002:l047","ordinal":7934,"en":"If only I could meet them face to face,” he said,"},{"id":"manas-2010:p0181:b002:l048","ordinal":7935,"en":"And he went about yearning for it."},{"id":"manas-2010:p0182:b002:l001","ordinal":7936,"en":"In wondrous games and revelry,"}]
