[{"id":"manas-2010:p1691:b001:l026","ordinal":72705,"en":"When I was slaughtering them,"},{"id":"manas-2010:p1691:b001:l027","ordinal":72706,"en":"Turning Beijing back without flinching,"},{"id":"manas-2010:p1691:b001:l028","ordinal":72707,"en":"Damn it, how shall I turn back now,"},{"id":"manas-2010:p1691:b001:l029","ordinal":72708,"en":"Bereft of the champions,"},{"id":"manas-2010:p1691:b001:l030","ordinal":72709,"en":"Almambet and Chubak, their names paired?"},{"id":"manas-2010:p1691:b001:l031","ordinal":72710,"en":"Against Beijing untouched even by holy Ali,"},{"id":"manas-2010:p1691:b001:l032","ordinal":72711,"en":"Did I think my strength would suffice?"},{"id":"manas-2010:p1691:b001:l033","ordinal":72712,"en":"Fighting here,"},{"id":"manas-2010:p1691:b001:l034","ordinal":72713,"en":"Bereft of the lions,"},{"id":"manas-2010:p1691:b001:l035","ordinal":72714,"en":"Did I think I would leave alive?"},{"id":"manas-2010:p1691:b001:l036","ordinal":72715,"en":"O God, you made me a lion who slaughtered unbelievers;"},{"id":"manas-2010:p1691:b001:l037","ordinal":72716,"en":"Taking dear Alma from me,"},{"id":"manas-2010:p1691:b001:l038","ordinal":72717,"en":"God, why have you diminished me so greatly?"},{"id":"manas-2010:p1691:b001:l039","ordinal":72718,"en":"Load on the burden of endurance,"},{"id":"manas-2010:p1691:b001:l040","ordinal":72719,"en":"Merciless, deceitful world;"},{"id":"manas-2010:p1691:b001:l041","ordinal":72720,"en":"Now take back the life you entrusted."},{"id":"manas-2010:p1691:b001:l042","ordinal":72721,"en":"From Beijing with its forbidding cliffs,"},{"id":"manas-2010:p1692:b001:l001","ordinal":72722,"en":"If I ride the red horse, I shall pass through;"},{"id":"manas-2010:p1692:b001:l002","ordinal":72723,"en":"Bereft of the heroes,"},{"id":"manas-2010:p1692:b001:l003","ordinal":72724,"en":"How can I leave alone now?"},{"id":"manas-2010:p1692:b001:l004","ordinal":72725,"en":"In the hills, white-headed horses,"},{"id":"manas-2010:p1692:b001:l005","ordinal":72726,"en":"Thoroughbreds and noble steeds together;"},{"id":"manas-2010:p1692:b001:l006","ordinal":72727,"en":"The one who would gather them,"},{"id":"manas-2010:p1692:b001:l007","ordinal":72728,"en":"My son left behind, is young."},{"id":"manas-2010:p1692:b001:l008","ordinal":72729,"en":"Do not leave me helpless and alone;"},{"id":"manas-2010:p1692:b001:l009","ordinal":72730,"en":"Almambet, Chubak, take me with you."},{"id":"manas-2010:p1692:b001:l010","ordinal":72731,"en":"Bereft of Akkula,"},{"id":"manas-2010:p1692:b001:l011","ordinal":72732,"en":"I stand helpless on foot."},{"id":"manas-2010:p1692:b001:l012","ordinal":72733,"en":"My brothers Almambet and Chubak are gone;"},{"id":"manas-2010:p1692:b001:l013","ordinal":72734,"en":"What can I possibly do now?!”"},{"id":"manas-2010:p1692:b001:l014","ordinal":72735,"en":"As he stood in fury,"},{"id":"manas-2010:p1692:b001:l015","ordinal":72736,"en":"What twelve ages had never brought,"},{"id":"manas-2010:p1692:b001:l016","ordinal":72737,"en":"At that moment, upon the Generous One—"},{"id":"manas-2010:p1692:b001:l017","ordinal":72738,"en":"No one remained to rein him in."},{"id":"manas-2010:p1692:b001:l018","ordinal":72739,"en":"At that moment, your Generous One"},{"id":"manas-2010:p1692:b001:l019","ordinal":72740,"en":"Came forth in fury."},{"id":"manas-2010:p1692:b001:l020","ordinal":72741,"en":"When slung, the mirror of his shoulder,"},{"id":"manas-2010:p1692:b001:l021","ordinal":72742,"en":"When fired once at a contending foe,"},{"id":"manas-2010:p1692:b001:l022","ordinal":72743,"en":"The dear support of life held in trust."},{"id":"manas-2010:p1692:b001:l023","ordinal":72744,"en":"Earlier, my prince, leopard Manas,"},{"id":"manas-2010:p1692:b001:l024","ordinal":72745,"en":"His fortune in Altay,"},{"id":"manas-2010:p1692:b001:l025","ordinal":72746,"en":"When it was setting forth,"},{"id":"manas-2010:p1692:b001:l026","ordinal":72747,"en":"His mother Chyyrdy,"},{"id":"manas-2010:p1692:b001:l027","ordinal":72748,"en":"When she was giving birth,"},{"id":"manas-2010:p1692:b001:l028","ordinal":72749,"en":"In the travail God had made,"},{"id":"manas-2010:p1692:b001:l029","ordinal":72750,"en":"Before the elder wife"},{"id":"manas-2010:p1692:b001:l030","ordinal":72751,"en":"There had come then"},{"id":"manas-2010:p1692:b001:l031","ordinal":72752,"en":"A white-bearded wandering holy man."},{"id":"manas-2010:p1692:b001:l032","ordinal":72753,"en":"“Elder wife, heed my words,” he said."},{"id":"manas-2010:p1692:b001:l033","ordinal":72754,"en":"“This child is a lion."},{"id":"manas-2010:p1692:b001:l034","ordinal":72755,"en":"When he reaches twelve years,"},{"id":"manas-2010:p1692:b001:l035","ordinal":72756,"en":"Entrust this to him,” he said,"},{"id":"manas-2010:p1692:b001:l036","ordinal":72757,"en":"And gave a steel bullet then."},{"id":"manas-2010:p1692:b001:l037","ordinal":72758,"en":"“When his dear, proudly upright back"},{"id":"manas-2010:p1692:b001:l038","ordinal":72759,"en":"Bends, let him fire it."},{"id":"manas-2010:p1692:b001:l039","ordinal":72760,"en":"When his poor head, shaped like an apple,"},{"id":"manas-2010:p1692:b001:l040","ordinal":72761,"en":"Comes under strain, let him fire it."},{"id":"manas-2010:p1692:b001:l041","ordinal":72762,"en":"Despairing of his life held in trust,"},{"id":"manas-2010:p1692:b001:l042","ordinal":72763,"en":"When he is weary, let him fire it."},{"id":"manas-2010:p1693:b001:l001","ordinal":72764,"en":"Those whose fathers are utter unbelievers,"},{"id":"manas-2010:p1693:b001:l002","ordinal":72765,"en":"When they besiege him, let him fire it.”"},{"id":"manas-2010:p1693:b001:l003","ordinal":72766,"en":"At his birth, he touched it to his mouth."},{"id":"manas-2010:p1693:b001:l004","ordinal":72767,"en":"Your formidable mother Chyyrdy"},{"id":"manas-2010:p1693:b001:l005","ordinal":72768,"en":"And Kanykey, joining together,"},{"id":"manas-2010:p1693:b001:l006","ordinal":72769,"en":"Had hidden that bullet,"},{"id":"manas-2010:p1693:b001:l007","ordinal":72770,"en":"Sewing it into Akolpok's collar."},{"id":"manas-2010:p1693:b001:l008","ordinal":72771,"en":"Clutching his collar in anguish,"},{"id":"manas-2010:p1693:b001:l009","ordinal":72772,"en":"As that fierce-maned one stood,"},{"id":"manas-2010:p1693:b001:l010","ordinal":72773,"en":"He grieved, thinking of Almambet."},{"id":"manas-2010:p1693:b001:l011","ordinal":72774,"en":"The single bullet sewn in the collar"},{"id":"manas-2010:p1693:b001:l012","ordinal":72775,"en":"Caught his hand like a button."},{"id":"manas-2010:p1693:b001:l013","ordinal":72776,"en":"When the bullet touched his hand,"},{"id":"manas-2010:p1693:b001:l014","ordinal":72777,"en":"The leopard tore the stitches open at once."},{"id":"manas-2010:p1693:b001:l015","ordinal":72778,"en":"Half a charge of fine-shooting powder,"},{"id":"manas-2010:p1693:b001:l016","ordinal":72779,"en":"Into Akkelte's mouth the leopard"},{"id":"manas-2010:p1693:b001:l017","ordinal":72780,"en":"Poured from the powder flask."},{"id":"manas-2010:p1693:b001:l018","ordinal":72781,"en":"That sacred steel bullet"},{"id":"manas-2010:p1693:b001:l019","ordinal":72782,"en":"He rammed in with a rumble."},{"id":"manas-2010:p1693:b001:l020","ordinal":72783,"en":"The finely made telescope"},{"id":"manas-2010:p1693:b001:l021","ordinal":72784,"en":"He turned seven times."},{"id":"manas-2010:p1693:b001:l022","ordinal":72785,"en":"“See where it reaches,” he said;"},{"id":"manas-2010:p1693:b001:l023","ordinal":72786,"en":"The king aimed at seven rope-lengths."},{"id":"manas-2010:p1693:b001:l024","ordinal":72787,"en":"“Trust in God!” he said, the telescope"},{"id":"manas-2010:p1693:b001:l025","ordinal":72788,"en":"Turning ten times."},{"id":"manas-2010:p1693:b001:l026","ordinal":72789,"en":"“See the place you face,” he said,"},{"id":"manas-2010:p1693:b001:l027","ordinal":72790,"en":"Aiming at ten rope-lengths."},{"id":"manas-2010:p1693:b001:l028","ordinal":72791,"en":"The dear lord, the leopard,"},{"id":"manas-2010:p1693:b001:l029","ordinal":72792,"en":"Bound it again, fitting it close."},{"id":"manas-2010:p1693:b001:l030","ordinal":72793,"en":"That great telescope,"},{"id":"manas-2010:p1693:b001:l031","ordinal":72794,"en":"On top of Akkelte,"},{"id":"manas-2010:p1693:b001:l032","ordinal":72795,"en":"He bound and fastened together."},{"id":"manas-2010:p1693:b001:l033","ordinal":72796,"en":"Your noble lord, the goshawk,"},{"id":"manas-2010:p1693:b001:l034","ordinal":72797,"en":"Took Akkelte in his hand."},{"id":"manas-2010:p1693:b001:l035","ordinal":72798,"en":"A black rock like a saddle-shaped ridge,"},{"id":"manas-2010:p1693:b001:l036","ordinal":72799,"en":"Your king patiently took hold of,"},{"id":"manas-2010:p1693:b001:l037","ordinal":72800,"en":"And rested it upon it then."},{"id":"manas-2010:p1693:b001:l038","ordinal":72801,"en":"Pointing into the haze,"},{"id":"manas-2010:p1693:b001:l039","ordinal":72802,"en":"Dim and angular,"},{"id":"manas-2010:p1693:b001:l040","ordinal":72803,"en":"Of the unblessed black unbelievers"},{"id":"manas-2010:p1693:b001:l041","ordinal":72804,"en":"He caught sight of a corner,"},{"id":"manas-2010:p1693:b001:l042","ordinal":72805,"en":"Seething like ants."},{"id":"manas-2010:p1694:b001:l001","ordinal":72806,"en":"The surrounding black unbelievers'"},{"id":"manas-2010:p1694:b001:l002","ordinal":72807,"en":"People he now saw."},{"id":"manas-2010:p1694:b001:l003","ordinal":72808,"en":"The earth had turned to dust;"},{"id":"manas-2010:p1694:b001:l004","ordinal":72809,"en":"Receiving word from their khan,"},{"id":"manas-2010:p1694:b001:l005","ordinal":72810,"en":"Ninety Beijings had risen."},{"id":"manas-2010:p1694:b001:l006","ordinal":72811,"en":"There were many remarkable men;"},{"id":"manas-2010:p1694:b001:l007","ordinal":72812,"en":"Raging and boasting,"},{"id":"manas-2010:p1694:b001:l008","ordinal":72813,"en":"The swine Kojozhash had become khan in Beijing."},{"id":"manas-2010:p1694:b001:l009","ordinal":72814,"en":"The proud black unbelievers'"},{"id":"manas-2010:p1694:b001:l010","ordinal":72815,"en":"Lords he had gathered."},{"id":"manas-2010:p1694:b001:l011","ordinal":72816,"en":"Their champions, the Fierce One and Kojozhash,"},{"id":"manas-2010:p1694:b001:l012","ordinal":72817,"en":"Nine khans in all,"},{"id":"manas-2010:p1694:b001:l013","ordinal":72818,"en":"The unbelievers lay boasting."},{"id":"manas-2010:p1694:b001:l014","ordinal":72819,"en":"Before Chynchy Khan, Kojozhash"},{"id":"manas-2010:p1694:b001:l015","ordinal":72820,"en":"Boasted mightily:"},{"id":"manas-2010:p1694:b001:l016","ordinal":72821,"en":"“There is no ship upon the dark water."},{"id":"manas-2010:p1694:b001:l017","ordinal":72822,"en":"Chinese, as long as my dear head lives,"},{"id":"manas-2010:p1694:b001:l018","ordinal":72823,"en":"No one can resist you."},{"id":"manas-2010:p1694:b001:l019","ordinal":72824,"en":"There is no lord but me."},{"id":"manas-2010:p1694:b001:l020","ordinal":72825,"en":"When battle brought slaughter,"},{"id":"manas-2010:p1694:b001:l021","ordinal":72826,"en":"I overthrew the Burut's Almambet."},{"id":"manas-2010:p1694:b001:l022","ordinal":72827,"en":"Akbaltay's Chubak,"},{"id":"manas-2010:p1694:b001:l023","ordinal":72828,"en":"That roaring reckless one,"},{"id":"manas-2010:p1694:b001:l024","ordinal":72829,"en":"I cast out from this Beijing."},{"id":"manas-2010:p1694:b001:l025","ordinal":72830,"en":"When my fury truly rose,"},{"id":"manas-2010:p1694:b001:l026","ordinal":72831,"en":"I forged steel into a bullet;"},{"id":"manas-2010:p1694:b001:l027","ordinal":72832,"en":"The brim of the black felt hat"},{"id":"manas-2010:p1694:b001:l028","ordinal":72833,"en":"I erased from this Beijing."},{"id":"manas-2010:p1694:b001:l029","ordinal":72834,"en":"The worthless ones without courage"},{"id":"manas-2010:p1694:b001:l030","ordinal":72835,"en":"I captured alive."},{"id":"manas-2010:p1694:b001:l031","ordinal":72836,"en":"When they provoked my anger,"},{"id":"manas-2010:p1694:b001:l032","ordinal":72837,"en":"Of Khan Manas's forty companions,"},{"id":"manas-2010:p1694:b001:l033","ordinal":72838,"en":"I slew twelve."},{"id":"manas-2010:p1694:b001:l034","ordinal":72839,"en":"The wishes of the living Burut"},{"id":"manas-2010:p1694:b001:l035","ordinal":72840,"en":"I have ruined like this."},{"id":"manas-2010:p1694:b001:l036","ordinal":72841,"en":"Their khan Manas himself"},{"id":"manas-2010:p1694:b001:l037","ordinal":72842,"en":"I made howl upon the ridge."},{"id":"manas-2010:p1694:b001:l038","ordinal":72843,"en":"Those who defied me"},{"id":"manas-2010:p1694:b001:l039","ordinal":72844,"en":"I simply destroyed like this."},{"id":"manas-2010:p1694:b001:l040","ordinal":72845,"en":"The shameless soul who still lives"},{"id":"manas-2010:p1694:b001:l041","ordinal":72846,"en":"Strains on, thinking he will not die."},{"id":"manas-2010:p1694:b001:l042","ordinal":72847,"en":"Wounded, fierce-maned Manas's"},{"id":"manas-2010:p1695:b001:l001","ordinal":72848,"en":"Horse I shot down."},{"id":"manas-2010:p1695:b001:l002","ordinal":72849,"en":"Now alone, where can he escape?"},{"id":"manas-2010:p1695:b001:l003","ordinal":72850,"en":"Their wounded Sultan Manas,"},{"id":"manas-2010:p1695:b001:l004","ordinal":72851,"en":"Let us swarm and seize him."},{"id":"manas-2010:p1695:b001:l005","ordinal":72852,"en":"The medicine called Üpü,"},{"id":"manas-2010:p1695:b001:l006","ordinal":72853,"en":"Let us put it upon his wound."},{"id":"manas-2010:p1695:b001:l007","ordinal":72854,"en":"By whatever means, Manas"},{"id":"manas-2010:p1695:b001:l008","ordinal":72855,"en":"Let us heal."},{"id":"manas-2010:p1695:b001:l009","ordinal":72856,"en":"Without killing or losing him,"},{"id":"manas-2010:p1695:b001:l010","ordinal":72857,"en":"Let us bind him and take him to Beijing."},{"id":"manas-2010:p1695:b001:l011","ordinal":72858,"en":"The forty wanton women in Beijing,"},{"id":"manas-2010:p1695:b001:l012","ordinal":72859,"en":"The women of the royal household,"},{"id":"manas-2010:p1695:b001:l013","ordinal":72860,"en":"Without shame, the Generous One"},{"id":"manas-2010:p1695:b001:l014","ordinal":72861,"en":"Let us take to them and keep as a stud."},{"id":"manas-2010:p1695:b001:l015","ordinal":72862,"en":"From Manas, father of his people,"},{"id":"manas-2010:p1695:b001:l016","ordinal":72863,"en":"Let us obtain the offspring we desire."},{"id":"manas-2010:p1695:b001:l017","ordinal":72864,"en":"Those seething women and girls,"},{"id":"manas-2010:p1695:b001:l018","ordinal":72865,"en":"Let us take him to them as a stud."},{"id":"manas-2010:p1695:b001:l019","ordinal":72866,"en":"From the girls and women, excelling,"},{"id":"manas-2010:p1695:b001:l020","ordinal":72867,"en":"If a son is born,"},{"id":"manas-2010:p1695:b001:l021","ordinal":72868,"en":"In the emperor's Beijing,"},{"id":"manas-2010:p1695:b001:l022","ordinal":72869,"en":"In Karykhan's place,"},{"id":"manas-2010:p1695:b001:l023","ordinal":72870,"en":"Putting a golden crown upon him,"},{"id":"manas-2010:p1695:b001:l024","ordinal":72871,"en":"Seating him upon the golden throne,"},{"id":"manas-2010:p1695:b001:l025","ordinal":72872,"en":"Of palm-sized Beijing,"},{"id":"manas-2010:p1695:b001:l026","ordinal":72873,"en":"Giving him its unity and making it known,"},{"id":"manas-2010:p1695:b001:l027","ordinal":72874,"en":"Let us send word to the people."},{"id":"manas-2010:p1695:b001:l028","ordinal":72875,"en":"Over the imperial realm itself,"},{"id":"manas-2010:p1695:b001:l029","ordinal":72876,"en":"If a son is born of him,"},{"id":"manas-2010:p1695:b001:l030","ordinal":72877,"en":"Let us raise him as khan!”"},{"id":"manas-2010:p1695:b001:l031","ordinal":72878,"en":"Thus spoke Kojozhash."},{"id":"manas-2010:p1695:b001:l032","ordinal":72879,"en":"The Kalmyks' dark spirits,"},{"id":"manas-2010:p1695:b001:l033","ordinal":72880,"en":"A flask of that strong liquor,"},{"id":"manas-2010:p1695:b001:l034","ordinal":72881,"en":"They tipped up and drank together,"},{"id":"manas-2010:p1695:b001:l035","ordinal":72882,"en":"Raised and swallowed together."},{"id":"manas-2010:p1695:b001:l036","ordinal":72883,"en":"Their Buddha image made of bronze,"},{"id":"manas-2010:p1695:b001:l037","ordinal":72884,"en":"In the windswept barren plain,"},{"id":"manas-2010:p1695:b001:l038","ordinal":72885,"en":"They had hung and tied up."},{"id":"manas-2010:p1695:b001:l039","ordinal":72886,"en":"Before the bronze-and-copper Buddha image,"},{"id":"manas-2010:p1695:b001:l040","ordinal":72887,"en":"Rising and bowing in worship,"},{"id":"manas-2010:p1695:b001:l041","ordinal":72888,"en":"The unbelievers offered penitence."},{"id":"manas-2010:p1695:b001:l042","ordinal":72889,"en":"Shouting in fury,"}]
