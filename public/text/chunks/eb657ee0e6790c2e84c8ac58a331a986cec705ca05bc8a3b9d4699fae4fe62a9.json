[{"id":"semetey-1-2013:p1152:b003:l014","ordinal":164097,"en":"Having heard word"},{"id":"semetey-1-2013:p1152:b003:l015","ordinal":164098,"en":"That it was Khan Kökötöy's feast,"},{"id":"semetey-1-2013:p1152:b003:l016","ordinal":164099,"en":"We rode here from Kakan."},{"id":"semetey-1-2013:p1152:b003:l017","ordinal":164100,"en":"We came to your feast,"},{"id":"semetey-1-2013:p1152:b003:l018","ordinal":164101,"en":"And after eating our fill,"},{"id":"semetey-1-2013:p1152:b003:l019","ordinal":164102,"en":"We grew unruly!"},{"id":"semetey-1-2013:p1152:b003:l020","ordinal":164103,"en":"Planning to unleash turmoil,"},{"id":"semetey-1-2013:p1152:b003:l021","ordinal":164104,"en":"We have fallen into hell like this!"},{"id":"semetey-1-2013:p1152:b003:l022","ordinal":164105,"en":"Coming to your feast and using force,"},{"id":"semetey-1-2013:p1152:b003:l023","ordinal":164106,"en":"We have become guilty!"},{"id":"semetey-1-2013:p1152:b003:l024","ordinal":164107,"en":"We came as guests, tiger,"},{"id":"semetey-1-2013:p1152:b003:l025","ordinal":164108,"en":"But humiliated you harshly."},{"id":"semetey-1-2013:p1152:b003:l026","ordinal":164109,"en":"Forgive this offense;"},{"id":"semetey-1-2013:p1152:b003:l027","ordinal":164110,"en":"If you will not forgive it,"},{"id":"semetey-1-2013:p1152:b003:l028","ordinal":164111,"en":"Here is the head—cut it off!\""},{"id":"semetey-1-2013:p1152:b003:l029","ordinal":164112,"en":"The bald men of the jewel-wearing Chinese"},{"id":"semetey-1-2013:p1152:b003:l030","ordinal":164113,"en":"Said this;"},{"id":"semetey-1-2013:p1152:b003:l031","ordinal":164114,"en":"The strong men of the coat-wearing Chinese"},{"id":"semetey-1-2013:p1152:b003:l032","ordinal":164115,"en":"Said this."},{"id":"semetey-1-2013:p1152:b003:l033","ordinal":164116,"en":"Their knees bent to the ground;"},{"id":"semetey-1-2013:p1152:b003:l034","ordinal":164117,"en":"As though Esenkan had come,"},{"id":"semetey-1-2013:p1152:b003:l035","ordinal":164118,"en":"They bowed before hero Manas."},{"id":"semetey-1-2013:p1152:b003:l036","ordinal":164119,"en":"Among the black Kalmyk people,"},{"id":"semetey-1-2013:p1152:b003:l037","ordinal":164120,"en":"There is the custom of bowing like women"},{"id":"semetey-1-2013:p1152:b003:l038","ordinal":164121,"en":"Before great lords;"},{"id":"semetey-1-2013:p1152:b003:l039","ordinal":164122,"en":"Such is the infidels' tradition."},{"id":"semetey-1-2013:p1152:b004:l001","ordinal":164123,"en":"\"Why should we quarrel with black Kalmyks and Manchus?"},{"id":"semetey-1-2013:p1152:b004:l002","ordinal":164124,"en":"What inheritance would we gain?"},{"id":"semetey-1-2013:p1152:b004:l003","ordinal":164125,"en":"Why should we behave roughly"},{"id":"semetey-1-2013:p1152:b004:l004","ordinal":164126,"en":"Toward infidels who came to the feast?"},{"id":"semetey-1-2013:p1152:b004:l005","ordinal":164127,"en":"By attacking amid the feast,"},{"id":"semetey-1-2013:p1152:b004:l006","ordinal":164128,"en":"What inheritance would we gain?\""},{"id":"semetey-1-2013:p1152:b004:l007","ordinal":164129,"en":"The stalwarts Koshoy and Bakay"},{"id":"semetey-1-2013:p1152:b004:l008","ordinal":164130,"en":"Stood between them."},{"id":"semetey-1-2013:p1152:b004:l009","ordinal":164131,"en":"When they were about to reach the very end"},{"id":"semetey-1-2013:p1152:b004:l010","ordinal":164132,"en":"And utterly plunder together"},{"id":"semetey-1-2013:p1152:b004:l011","ordinal":164133,"en":"The black Chinese and many Manchus,"},{"id":"semetey-1-2013:p1152:b004:l012","ordinal":164134,"en":"The tiger, bloodthirsty Manas,"},{"id":"semetey-1-2013:p1152:b004:l013","ordinal":164135,"en":"Stopped as though he had drunk poison."},{"id":"semetey-1-2013:p1152:b004:l014","ordinal":164136,"en":"Infidel and Muslim alike—"},{"id":"semetey-1-2013:p1152:b004:l015","ordinal":164137,"en":"Saying it was Khan Kökötöy's feast,"},{"id":"semetey-1-2013:p1152:b004:l016","ordinal":164138,"en":"A spectacle arose."},{"id":"semetey-1-2013:p1152:b004:l017","ordinal":164139,"en":"Saying it was the place of the great gathering,"},{"id":"semetey-1-2013:p1152:b004:l018","ordinal":164140,"en":"The feast of Khan Kökötöy,"},{"id":"semetey-1-2013:p1152:b004:l019","ordinal":164141,"en":"With bloodthirsty Manas among them,"},{"id":"semetey-1-2013:p1152:b004:l020","ordinal":164142,"en":"Infidel and Muslim alike"},{"id":"semetey-1-2013:p1152:b004:l021","ordinal":164143,"en":"Raced like the qibla wind,"},{"id":"semetey-1-2013:p1152:b004:l022","ordinal":164144,"en":"Made peace once more,"},{"id":"semetey-1-2013:p1152:b004:l023","ordinal":164145,"en":"Abandoned words of disorder,"},{"id":"semetey-1-2013:p1152:b004:l024","ordinal":164146,"en":"And began words of entertainment."},{"id":"semetey-1-2013:p1152:b004:l025","ordinal":164147,"en":"Infidel and Muslim alike"},{"id":"semetey-1-2013:p1152:b004:l026","ordinal":164148,"en":"Gathered around shared cauldrons;"},{"id":"semetey-1-2013:p1152:b004:l027","ordinal":164149,"en":"Their clashing subsided."},{"id":"semetey-1-2013:p1152:b004:l028","ordinal":164150,"en":"They gathered after their disorder,"},{"id":"semetey-1-2013:p1152:b004:l029","ordinal":164151,"en":"And all the trouble ceased."},{"id":"semetey-1-2013:p1152:b004:l030","ordinal":164152,"en":"The people reconciled and prospered,"},{"id":"semetey-1-2013:p1152:b004:l031","ordinal":164153,"en":"And merriment began again."},{"id":"semetey-1-2013:p1152:b004:l032","ordinal":164154,"en":"As the people stood thus,"},{"id":"semetey-1-2013:p1152:b004:l033","ordinal":164155,"en":"Kökötöy's Bokmurun"},{"id":"semetey-1-2013:p1152:b004:l034","ordinal":164156,"en":"Regained his spirit,"},{"id":"semetey-1-2013:p1152:b004:l035","ordinal":164157,"en":"Came back to life,"},{"id":"semetey-1-2013:p1152:b004:l036","ordinal":164158,"en":"And recovered his speech."},{"id":"semetey-1-2013:p1152:b004:l037","ordinal":164159,"en":"Maaniker seemed to run"},{"id":"semetey-1-2013:p1152:b004:l038","ordinal":164160,"en":"Over hill and mountain."},{"id":"semetey-1-2013:p1153:b003:l001","ordinal":164161,"en":"It seemed to be running."},{"id":"semetey-1-2013:p1153:b003:l002","ordinal":164162,"en":"Having died, he seemed"},{"id":"semetey-1-2013:p1153:b003:l003","ordinal":164163,"en":"To come alive again."},{"id":"semetey-1-2013:p1153:b003:l004","ordinal":164164,"en":"He opened the treasure-filled forty rooms,"},{"id":"semetey-1-2013:p1153:b003:l005","ordinal":164165,"en":"Their mouths wide as sacks,"},{"id":"semetey-1-2013:p1153:b003:l006","ordinal":164166,"en":"And squandered and scattered it"},{"id":"semetey-1-2013:p1153:b003:l007","ordinal":164167,"en":"For the sake of the spectacle."},{"id":"semetey-1-2013:p1153:b003:l008","ordinal":164168,"en":"He had horns and trumpets sounded"},{"id":"semetey-1-2013:p1153:b004:l001","ordinal":164169,"en":"And word proclaimed by the herald:"},{"id":"semetey-1-2013:p1153:b004:l002","ordinal":164170,"en":"\"Infidel and Muslim alike,"},{"id":"semetey-1-2013:p1153:b004:l003","ordinal":164171,"en":"Your peoples have come here."},{"id":"semetey-1-2013:p1153:b004:l004","ordinal":164172,"en":"Many seething great lords,"},{"id":"semetey-1-2013:p1153:b004:l005","ordinal":164173,"en":"All of you have come here."},{"id":"semetey-1-2013:p1153:b004:l006","ordinal":164174,"en":"My father Kökötöy has died;"},{"id":"semetey-1-2013:p1153:b004:l007","ordinal":164175,"en":"My khan-father has gone"},{"id":"semetey-1-2013:p1153:b004:l008","ordinal":164176,"en":"On the journey from which none return."},{"id":"semetey-1-2013:p1153:b006:l001","ordinal":164177,"en":"Let one champion from the infidels"},{"id":"semetey-1-2013:p1153:b006:l002","ordinal":164178,"en":"And one champion from the Muslims"},{"id":"semetey-1-2013:p1153:b006:l003","ordinal":164179,"en":"Wrestle in the center;"},{"id":"semetey-1-2013:p1153:b006:l004","ordinal":164180,"en":"Let them seize each other's trouser cuffs."},{"id":"semetey-1-2013:p1153:b006:l005","ordinal":164181,"en":"Let the champions step forward"},{"id":"semetey-1-2013:p1153:b006:l006","ordinal":164182,"en":"And begin the spectacle."},{"id":"semetey-1-2013:p1153:b006:l007","ordinal":164183,"en":"For these excited people,"},{"id":"semetey-1-2013:p1153:b006:l008","ordinal":164184,"en":"Let them provide a spectacle."},{"id":"semetey-1-2013:p1153:b006:l009","ordinal":164185,"en":"At Kökötöy's feast,"},{"id":"semetey-1-2013:p1153:b006:l010","ordinal":164186,"en":"Let them tell their peoples"},{"id":"semetey-1-2013:p1153:b006:l011","ordinal":164187,"en":"That such was the custom,"},{"id":"semetey-1-2013:p1153:b006:l012","ordinal":164188,"en":"Infidel and Muslim alike."},{"id":"semetey-1-2013:p1153:b006:l013","ordinal":164189,"en":"As the wrestling prize,"},{"id":"semetey-1-2013:p1153:b006:l014","ordinal":164190,"en":"I stake a thousand black camels"},{"id":"semetey-1-2013:p1153:b006:l015","ordinal":164191,"en":"And a thousand black-blazed mares."},{"id":"semetey-1-2013:p1153:b006:l016","ordinal":164192,"en":"From red gold coins,"},{"id":"semetey-1-2013:p1153:b006:l017","ordinal":164193,"en":"Filling one saddlebag,"},{"id":"semetey-1-2013:p1153:b006:l018","ordinal":164194,"en":"I stake it with all its contents;"},{"id":"semetey-1-2013:p1153:b006:l019","ordinal":164195,"en":"I stake a bondwoman with her child."},{"id":"semetey-1-2013:p1153:b006:l020","ordinal":164196,"en":"Of all that ears have heard and eyes have seen,"},{"id":"semetey-1-2013:p1153:b006:l021","ordinal":164197,"en":"Who has staked prizes like me?"},{"id":"semetey-1-2013:p1153:b006:l022","ordinal":164198,"en":"Dust flies into the sky;"},{"id":"semetey-1-2013:p1153:b006:l023","ordinal":164199,"en":"Infidel and Muslim alike,"},{"id":"semetey-1-2013:p1153:b006:l024","ordinal":164200,"en":"You have gathered in a mass."},{"id":"semetey-1-2013:p1153:b006:l025","ordinal":164201,"en":"It is Khan Kökötöy's feast,"},{"id":"semetey-1-2013:p1153:b006:l026","ordinal":164202,"en":"The place of the great gathering."},{"id":"semetey-1-2013:p1153:b006:l027","ordinal":164203,"en":"There is the swift horse Maaniker."},{"id":"semetey-1-2013:p1153:b008:l001","ordinal":164204,"en":"Do not think my wealth exhausted;"},{"id":"semetey-1-2013:p1153:b008:l002","ordinal":164205,"en":"There are six rooms full of possessions."},{"id":"semetey-1-2013:p1153:b008:l003","ordinal":164206,"en":"I migrated here from Tashken;"},{"id":"semetey-1-2013:p1153:b008:l004","ordinal":164207,"en":"There is a line already drawn."},{"id":"semetey-1-2013:p1153:b008:l005","ordinal":164208,"en":"For infidel and Muslim alike,"},{"id":"semetey-1-2013:p1153:b008:l006","ordinal":164209,"en":"There is a spectacle to display."},{"id":"semetey-1-2013:p1153:b008:l007","ordinal":164210,"en":"I have a song to sing;"},{"id":"semetey-1-2013:p1153:b008:l008","ordinal":164211,"en":"For infidel and Muslim alike,"},{"id":"semetey-1-2013:p1153:b008:l009","ordinal":164212,"en":"I have a contest to begin."},{"id":"semetey-1-2013:p1153:b008:l010","ordinal":164213,"en":"Even in forty years it would not end—"},{"id":"semetey-1-2013:p1153:b008:l011","ordinal":164214,"en":"I have livestock left by my father."},{"id":"semetey-1-2013:p1153:b008:l012","ordinal":164215,"en":"Why should I tell of the rest?"},{"id":"semetey-1-2013:p1153:b008:l013","ordinal":164216,"en":"I have a myriad red camels"},{"id":"semetey-1-2013:p1153:b008:l014","ordinal":164217,"en":"For carrying red gold,"},{"id":"semetey-1-2013:p1153:b008:l015","ordinal":164218,"en":"And livestock worth a great deal."},{"id":"semetey-1-2013:p1153:b008:l016","ordinal":164219,"en":"Infidel and Muslim alike,"},{"id":"semetey-1-2013:p1153:b008:l017","ordinal":164220,"en":"Divide Kökötöy's prizes"},{"id":"semetey-1-2013:p1153:b008:l018","ordinal":164221,"en":"Fairly among yourselves.\""},{"id":"semetey-1-2013:p1153:b008:l019","ordinal":164222,"en":"After Bokmurun issued the decree,"},{"id":"semetey-1-2013:p1153:b008:l020","ordinal":164223,"en":"The common people heard."},{"id":"semetey-1-2013:p1153:b008:l021","ordinal":164224,"en":"From the black Kalmyk people,"},{"id":"semetey-1-2013:p1153:b008:l022","ordinal":164225,"en":"Saying, \"I shall go out,\""},{"id":"semetey-1-2013:p1153:b008:l023","ordinal":164226,"en":"Khan Zholoy stepped forward."},{"id":"semetey-1-2013:p1153:b008:l024","ordinal":164227,"en":"Do not ask of Zholoy's station:"},{"id":"semetey-1-2013:p1153:b008:l025","ordinal":164228,"en":"He was as large as a mountain,"},{"id":"semetey-1-2013:p1153:b008:l026","ordinal":164229,"en":"As though he would eat whoever appeared."},{"id":"semetey-1-2013:p1153:b008:l027","ordinal":164230,"en":"Khan Zholoy of the black Kalmyks"},{"id":"semetey-1-2013:p1154:b003:l001","ordinal":164231,"en":"Never spared one who wrestled him;"},{"id":"semetey-1-2013:p1154:b003:l002","ordinal":164232,"en":"The meat of one whole pig"},{"id":"semetey-1-2013:p1154:b003:l003","ordinal":164233,"en":"Did not fill him at a sitting."},{"id":"semetey-1-2013:p1154:b003:l004","ordinal":164234,"en":"Was he not capable Zholoy,"},{"id":"semetey-1-2013:p1154:b003:l005","ordinal":164235,"en":"Whose fame spread through the world?"},{"id":"semetey-1-2013:p1154:b003:l006","ordinal":164236,"en":"Was he not Zholoy who shattered"},{"id":"semetey-1-2013:p1154:b003:l007","ordinal":164237,"en":"And took so many lands?"},{"id":"semetey-1-2013:p1154:b003:l008","ordinal":164238,"en":"The great Kalmyk who towered over you"},{"id":"semetey-1-2013:p1154:b003:l009","ordinal":164239,"en":"Could knock down a camel with one punch—"},{"id":"semetey-1-2013:p1154:b003:l010","ordinal":164240,"en":"Was he not the champion Zholoy?"},{"id":"semetey-1-2013:p1154:b003:l011","ordinal":164241,"en":"When he met a man on foot,"},{"id":"semetey-1-2013:p1154:b003:l012","ordinal":164242,"en":"His brow was like the reedy edge of a lake,"},{"id":"semetey-1-2013:p1154:b003:l013","ordinal":164243,"en":"As though he would swallow whoever appeared."},{"id":"semetey-1-2013:p1154:b003:l014","ordinal":164244,"en":"Wearing yellow leather trousers,"},{"id":"semetey-1-2013:p1154:b003:l015","ordinal":164245,"en":"Zholoy of auspicious hour prepared."},{"id":"semetey-1-2013:p1154:b003:l016","ordinal":164246,"en":"If you had seen great Zholoy,"},{"id":"semetey-1-2013:p1154:b003:l017","ordinal":164247,"en":"He raged like a blue boar:"},{"id":"semetey-1-2013:p1154:b003:l018","ordinal":164248,"en":"\"If a bastard Burut"},{"id":"semetey-1-2013:p1154:b003:l019","ordinal":164249,"en":"Comes to wrestle, I shall throw him;"},{"id":"semetey-1-2013:p1154:b003:l020","ordinal":164250,"en":"I shall seize him"},{"id":"semetey-1-2013:p1154:b003:l021","ordinal":164251,"en":"And thrust him alive into the grave."},{"id":"semetey-1-2013:p1154:b003:l022","ordinal":164252,"en":"I shall take alone"},{"id":"semetey-1-2013:p1154:b003:l023","ordinal":164253,"en":"All the Muslims' great prizes."},{"id":"semetey-1-2013:p1154:b003:l024","ordinal":164254,"en":"When the jostling turmoil begins,"},{"id":"semetey-1-2013:p1154:b003:l025","ordinal":164255,"en":"I shall unleash a single havoc.\""},{"id":"semetey-1-2013:p1154:b003:l026","ordinal":164256,"en":"The spirit of those who saw him failed;"},{"id":"semetey-1-2013:p1154:b003:l027","ordinal":164257,"en":"Zholoy came out from the Kalmyks,"},{"id":"semetey-1-2013:p1154:b003:l028","ordinal":164258,"en":"Appearing like Mount Opol."},{"id":"semetey-1-2013:p1154:b003:l029","ordinal":164259,"en":"When the handful of Muslims"},{"id":"semetey-1-2013:p1154:b003:l030","ordinal":164260,"en":"Saw Zholoy's form,"},{"id":"semetey-1-2013:p1154:b003:l031","ordinal":164261,"en":"Their courage failed badly"},{"id":"semetey-1-2013:p1154:b003:l032","ordinal":164262,"en":"And they lost their wits."},{"id":"semetey-1-2013:p1154:b003:l033","ordinal":164263,"en":"When the would-be Muslim champions"},{"id":"semetey-1-2013:p1154:b003:l034","ordinal":164264,"en":"Saw Khan Zholoy,"},{"id":"semetey-1-2013:p1154:b003:l035","ordinal":164265,"en":"They fled from among the people."},{"id":"semetey-1-2013:p1154:b003:l036","ordinal":164266,"en":"Manas too grew anxious,"},{"id":"semetey-1-2013:p1154:b003:l037","ordinal":164267,"en":"Wondering which champion would go out"},{"id":"semetey-1-2013:p1154:b003:l038","ordinal":164268,"en":"Against the enraged infidel."},{"id":"semetey-1-2013:p1154:b003:l039","ordinal":164269,"en":"Dear elder Koshoy"},{"id":"semetey-1-2013:p1154:b004:l001","ordinal":164270,"en":"And hero Töshtük, son of Eleman,"},{"id":"semetey-1-2013:p1154:b004:l002","ordinal":164271,"en":"Stood in a row then,"},{"id":"semetey-1-2013:p1154:b004:l003","ordinal":164272,"en":"As did all the Muslims."},{"id":"semetey-1-2013:p1154:b004:l004","ordinal":164273,"en":"With a black hat large as a house,"},{"id":"semetey-1-2013:p1154:b004:l005","ordinal":164274,"en":"The tiger, bloodthirsty Manas,"},{"id":"semetey-1-2013:p1154:b004:l006","ordinal":164275,"en":"Born as the black stallion of honor"},{"id":"semetey-1-2013:p1154:b004:l007","ordinal":164276,"en":"For the Muslim people, cried:"},{"id":"semetey-1-2013:p1154:b004:l008","ordinal":164277,"en":"\"Is there a giant among you"},{"id":"semetey-1-2013:p1154:b004:l009","ordinal":164278,"en":"Who will take the infidel champion?"},{"id":"semetey-1-2013:p1154:b004:l010","ordinal":164279,"en":"Who will seize his trouser cuffs,"},{"id":"semetey-1-2013:p1154:b004:l011","ordinal":164280,"en":"Wrestle like a champion,"},{"id":"semetey-1-2013:p1154:b004:l012","ordinal":164281,"en":"Tear whatever comes to hand,"},{"id":"semetey-1-2013:p1154:b004:l013","ordinal":164282,"en":"Butt like a blue bull,"},{"id":"semetey-1-2013:p1154:b004:l014","ordinal":164283,"en":"And bring merciless havoc"},{"id":"semetey-1-2013:p1154:b004:l015","ordinal":164284,"en":"Upon the foremost black Kalmyk?"},{"id":"semetey-1-2013:p1154:b004:l016","ordinal":164285,"en":"Is there such a man?"},{"id":"semetey-1-2013:p1154:b004:l017","ordinal":164286,"en":"Is there one who will win"},{"id":"semetey-1-2013:p1154:b004:l018","ordinal":164287,"en":"Honor for the Muslims?\""},{"id":"semetey-1-2013:p1154:b004:l019","ordinal":164288,"en":"Gray-wolf Manas, the tiger,"},{"id":"semetey-1-2013:p1154:b004:l020","ordinal":164289,"en":"Mounted a blue racehorse:"},{"id":"semetey-1-2013:p1154:b004:l021","ordinal":164290,"en":"\"To wrestle once,"},{"id":"semetey-1-2013:p1154:b004:l022","ordinal":164291,"en":"To provide the people a spectacle,"},{"id":"semetey-1-2013:p1154:b004:l023","ordinal":164292,"en":"To learn what sort of hero is seething there,"},{"id":"semetey-1-2013:p1154:b004:l024","ordinal":164293,"en":"And let the black Kalmyk and Manchu people"},{"id":"semetey-1-2013:p1154:b004:l025","ordinal":164294,"en":"Tell forever"},{"id":"semetey-1-2013:p1154:b004:l026","ordinal":164295,"en":"What the Burut are like—"},{"id":"semetey-1-2013:p1154:b004:l027","ordinal":164296,"en":"Hero Töshtük, son of Eleman,"},{"id":"semetey-1-2013:p1154:b004:l028","ordinal":164297,"en":"Youngest of nine sons,"},{"id":"semetey-1-2013:p1154:b004:l029","ordinal":164298,"en":"Eleman's cherished one,"},{"id":"semetey-1-2013:p1154:b004:l030","ordinal":164299,"en":"A mortal of the one God,"},{"id":"semetey-1-2013:p1154:b004:l031","ordinal":164300,"en":"How are you against the champion,"},{"id":"semetey-1-2013:p1154:b004:l032","ordinal":164301,"en":"To grapple with"},{"id":"semetey-1-2013:p1154:b004:l033","ordinal":164302,"en":"That dog who boasts of strength?\""},{"id":"semetey-1-2013:p1154:b004:l034","ordinal":164303,"en":"When Manas spoke thus,"},{"id":"semetey-1-2013:p1154:b004:l035","ordinal":164304,"en":"Töshtük stood and said:"},{"id":"semetey-1-2013:p1154:b004:l036","ordinal":164305,"en":"\"My time to wrestle"},{"id":"semetey-1-2013:p1154:b004:l037","ordinal":164306,"en":"The boasting Kalmyk has not yet come;"},{"id":"semetey-1-2013:p1154:b004:l038","ordinal":164307,"en":"My strength has not yet filled my body."},{"id":"semetey-1-2013:p1154:b004:l039","ordinal":164308,"en":"My flesh remains raw and bruised."},{"id":"semetey-1-2013:p1155:b003:l001","ordinal":164309,"en":"My blood remains one spoonful."},{"id":"semetey-1-2013:p1155:b003:l002","ordinal":164310,"en":"My joints have failed; I have no strength,"},{"id":"semetey-1-2013:p1155:b003:l003","ordinal":164311,"en":"No power to wrestle."},{"id":"semetey-1-2013:p1155:b003:l004","ordinal":164312,"en":"If I jostle with this infidel,"},{"id":"semetey-1-2013:p1155:b003:l005","ordinal":164313,"en":"My joints will come apart,"},{"id":"semetey-1-2013:p1155:b003:l006","ordinal":164314,"en":"And my body will sway."},{"id":"semetey-1-2013:p1155:b003:l007","ordinal":164315,"en":"The reason I am like this:"},{"id":"semetey-1-2013:p1155:b003:l008","ordinal":164316,"en":"I descended beneath the earth,"},{"id":"semetey-1-2013:p1155:b003:l009","ordinal":164317,"en":"And seven years were completed;"},{"id":"semetey-1-2013:p1155:b003:l010","ordinal":164318,"en":"Since I came above the earth,"},{"id":"semetey-1-2013:p1155:b003:l011","ordinal":164319,"en":"Barely seven days have passed."},{"id":"semetey-1-2013:p1155:b003:l012","ordinal":164320,"en":"What I say is true; I have no recourse."},{"id":"semetey-1-2013:p1155:b003:l013","ordinal":164321,"en":"I have no strength to wrestle"},{"id":"semetey-1-2013:p1155:b003:l014","ordinal":164322,"en":"The swaggering crow-like Kalmyk."},{"id":"semetey-1-2013:p1155:b003:l015","ordinal":164323,"en":"I have declined from my former days;"},{"id":"semetey-1-2013:p1155:b003:l016","ordinal":164324,"en":"You asked whether I was formidable,"},{"id":"semetey-1-2013:p1155:b003:l017","ordinal":164325,"en":"But today your Töshtük"},{"id":"semetey-1-2013:p1155:b003:l018","ordinal":164326,"en":"Stands in the form of doomsday."},{"id":"semetey-1-2013:p1155:b003:l019","ordinal":164327,"en":"If I unexpectedly wrestled"},{"id":"semetey-1-2013:p1155:b003:l020","ordinal":164328,"en":"The swaggering black Kalmyk,"},{"id":"semetey-1-2013:p1155:b003:l021","ordinal":164329,"en":"Would my hip not strike the earth,"},{"id":"semetey-1-2013:p1155:b003:l022","ordinal":164330,"en":"And would not the handful of Muslims"},{"id":"semetey-1-2013:p1155:b003:l023","ordinal":164331,"en":"Lose all their honor together?"},{"id":"semetey-1-2013:p1155:b003:l024","ordinal":164332,"en":"Would the black earth not swallow me?"},{"id":"semetey-1-2013:p1155:b003:l025","ordinal":164333,"en":"If I fell sprawling,"},{"id":"semetey-1-2013:p1155:b003:l026","ordinal":164334,"en":"Would that not be my deathbed?"},{"id":"semetey-1-2013:p1155:b003:l027","ordinal":164335,"en":"If I speak plainly,"},{"id":"semetey-1-2013:p1155:b003:l028","ordinal":164336,"en":"My tale is unending:"},{"id":"semetey-1-2013:p1155:b003:l029","ordinal":164337,"en":"When the giant black bird Zymyryk"},{"id":"semetey-1-2013:p1155:b003:l030","ordinal":164338,"en":"Was driven beyond all recourse,"},{"id":"semetey-1-2013:p1155:b003:l031","ordinal":164339,"en":"I cut flesh from my thick thigh"},{"id":"semetey-1-2013:p1155:b003:l032","ordinal":164340,"en":"And gave it as food."},{"id":"semetey-1-2013:p1155:b003:l033","ordinal":164341,"en":"I bear such a wound."},{"id":"semetey-1-2013:p1155:b003:l034","ordinal":164342,"en":"Will the Kalmyk not seize upon my weakness,"},{"id":"semetey-1-2013:p1155:b003:l035","ordinal":164343,"en":"Throw me down stiffly,"},{"id":"semetey-1-2013:p1155:b003:l036","ordinal":164344,"en":"Take his unspent vengeance,"},{"id":"semetey-1-2013:p1155:b003:l037","ordinal":164345,"en":"And break the back"},{"id":"semetey-1-2013:p1155:b003:l038","ordinal":164346,"en":"Of the steadfast Muslims?\""},{"id":"semetey-1-2013:p1155:b003:l039","ordinal":164347,"en":"When Töshtük spoke thus,"},{"id":"semetey-1-2013:p1155:b005:l001","ordinal":164348,"en":"Lord Manas left him."},{"id":"semetey-1-2013:p1155:b005:l002","ordinal":164349,"en":"He seized Zhamgyrchy"},{"id":"semetey-1-2013:p1155:b005:l003","ordinal":164350,"en":"Of the Eshtek people:"},{"id":"semetey-1-2013:p1155:b005:l004","ordinal":164351,"en":"\"You are a hero of the Eshtek,"},{"id":"semetey-1-2013:p1155:b005:l005","ordinal":164352,"en":"The lion of a whole clan;"}]
