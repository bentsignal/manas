[{"id":"manas-2010:p0037:b002:l021","ordinal":1025,"en":"Were on their way to Beijing."},{"id":"manas-2010:p0037:b002:l022","ordinal":1026,"en":"There on that road they met"},{"id":"manas-2010:p0037:b002:l023","ordinal":1027,"en":"Ninety Chinese champions;"},{"id":"manas-2010:p0037:b002:l024","ordinal":1028,"en":"The lions Jakyp and Akbaltay"},{"id":"manas-2010:p0037:b002:l025","ordinal":1029,"en":"Caught them in the open plain,"},{"id":"manas-2010:p0037:b002:l026","ordinal":1030,"en":"Smashed them to pieces,"},{"id":"manas-2010:p0037:b002:l027","ordinal":1031,"en":"And killed them to the last man."},{"id":"manas-2010:p0037:b002:l028","ordinal":1032,"en":"Ninety-five laden camels,"},{"id":"manas-2010:p0037:b002:l029","ordinal":1033,"en":"Black single-humped camels with red tails,"},{"id":"manas-2010:p0037:b002:l030","ordinal":1034,"en":"They took as booty."},{"id":"manas-2010:p0037:b002:l031","ordinal":1035,"en":"Seizing the camels in their raid,"},{"id":"manas-2010:p0037:b002:l032","ordinal":1036,"en":"The lads returned to the Kyrgyz;"},{"id":"manas-2010:p0037:b002:l033","ordinal":1037,"en":"Agreeing to what was said,"},{"id":"manas-2010:p0037:b002:l034","ordinal":1038,"en":"To every household, one apiece,"},{"id":"manas-2010:p0037:b002:l035","ordinal":1039,"en":"They gave a fist-sized piece of gold."},{"id":"manas-2010:p0037:b002:l036","ordinal":1040,"en":"Thoroughly sated with their spoils,"},{"id":"manas-2010:p0037:b002:l037","ordinal":1041,"en":"Having wreaked great devastation,"},{"id":"manas-2010:p0037:b002:l038","ordinal":1042,"en":"As dawn broke clear,"},{"id":"manas-2010:p0037:b002:l039","ordinal":1043,"en":"They lay there making merry."},{"id":"manas-2010:p0037:b002:l040","ordinal":1044,"en":"While the caravan drivers, on their journey,"},{"id":"manas-2010:p0037:b002:l041","ordinal":1045,"en":"Were making camp,"},{"id":"manas-2010:p0037:b002:l042","ordinal":1046,"en":"While all the champions"},{"id":"manas-2010:p0037:b002:l043","ordinal":1047,"en":"Were being slaughtered,"},{"id":"manas-2010:p0037:b002:l044","ordinal":1048,"en":"While merciless havoc"},{"id":"manas-2010:p0037:b002:l045","ordinal":1049,"en":"Was being wreaked,"},{"id":"manas-2010:p0037:b002:l046","ordinal":1050,"en":"While the champions"},{"id":"manas-2010:p0037:b002:l047","ordinal":1051,"en":"Were being offered up as sacrifice,"},{"id":"manas-2010:p0037:b002:l048","ordinal":1052,"en":"One who served Alöökö,"},{"id":"manas-2010:p0038:b002:l001","ordinal":1053,"en":"A champion called Jöö Jeldet,"},{"id":"manas-2010:p0038:b002:l002","ordinal":1054,"en":"That fool escaped,"},{"id":"manas-2010:p0038:b002:l003","ordinal":1055,"en":"And reached his khan alive."},{"id":"manas-2010:p0038:b002:l004","ordinal":1056,"en":"He went and told his khan,"},{"id":"manas-2010:p0038:b002:l005","ordinal":1057,"en":"Before Alöökö"},{"id":"manas-2010:p0038:b002:l006","ordinal":1058,"en":"Telling horrors no one knew:"},{"id":"manas-2010:p0038:b002:l007","ordinal":1059,"en":"“My khan, I have seen wonders;"},{"id":"manas-2010:p0038:b002:l008","ordinal":1060,"en":"I fled here from the rebels."},{"id":"manas-2010:p0038:b002:l009","ordinal":1061,"en":"When dawn broke clear,"},{"id":"manas-2010:p0038:b002:l010","ordinal":1062,"en":"When light fell on the earth,"},{"id":"manas-2010:p0038:b002:l011","ordinal":1063,"en":"I saw a gray, mottled banner;"},{"id":"manas-2010:p0038:b002:l012","ordinal":1064,"en":"Piercing cries, shrill battle shouts,"},{"id":"manas-2010:p0038:b002:l013","ordinal":1065,"en":"I saw a tumult of mighty yelling."},{"id":"manas-2010:p0038:b002:l014","ordinal":1066,"en":"They began the slaughter;"},{"id":"manas-2010:p0038:b002:l015","ordinal":1067,"en":"To Esenkan,"},{"id":"manas-2010:p0038:b002:l016","ordinal":1068,"en":"Bearing loads of gold,"},{"id":"manas-2010:p0038:b002:l017","ordinal":1069,"en":"All your champions,"},{"id":"manas-2010:p0038:b002:l018","ordinal":1070,"en":"They killed them all, to the last man."},{"id":"manas-2010:p0038:b002:l019","ordinal":1071,"en":"On karabayyr horses, on noble warhorses,"},{"id":"manas-2010:p0038:b002:l020","ordinal":1072,"en":"With sieve-like lungs and copper limbs,"},{"id":"manas-2010:p0038:b002:l021","ordinal":1073,"en":"They rode mounts swift as vanished spirits;"},{"id":"manas-2010:p0038:b002:l022","ordinal":1074,"en":"Though enemies rose in ilek upon ilek,"},{"id":"manas-2010:p0038:b002:l023","ordinal":1075,"en":"They charged them without flinching."},{"id":"manas-2010:p0038:b002:l024","ordinal":1076,"en":"With sashes wound as turbans,"},{"id":"manas-2010:p0038:b002:l025","ordinal":1077,"en":"As they leveled their spears in ranks,"},{"id":"manas-2010:p0038:b002:l026","ordinal":1078,"en":"They called upon the Almighty."},{"id":"manas-2010:p0038:b002:l027","ordinal":1079,"en":"It turned out they were Burut themselves,"},{"id":"manas-2010:p0038:b002:l028","ordinal":1080,"en":"And all your treasury"},{"id":"manas-2010:p0038:b002:l029","ordinal":1081,"en":"They were out to plunder!"},{"id":"manas-2010:p0038:b002:l030","ordinal":1082,"en":"They trampled over our heads;"},{"id":"manas-2010:p0038:b002:l031","ordinal":1083,"en":"The loads of coins, the heaps of gold,"},{"id":"manas-2010:p0038:b002:l032","ordinal":1084,"en":"They took as booty and scattered."},{"id":"manas-2010:p0038:b002:l033","ordinal":1085,"en":"I saw they were Burut themselves,"},{"id":"manas-2010:p0038:b002:l034","ordinal":1086,"en":"I looked: their eyes were black."},{"id":"manas-2010:p0038:b002:l035","ordinal":1087,"en":"They dug my pit,"},{"id":"manas-2010:p0038:b002:l036","ordinal":1088,"en":"They boiled my misery,"},{"id":"manas-2010:p0038:b002:l037","ordinal":1089,"en":"They scattered my possessions,"},{"id":"manas-2010:p0038:b002:l038","ordinal":1090,"en":"They slaughtered my people,"},{"id":"manas-2010:p0038:b002:l039","ordinal":1091,"en":"They broke my back,"},{"id":"manas-2010:p0038:b002:l040","ordinal":1092,"en":"They would not hear my words,"},{"id":"manas-2010:p0038:b002:l041","ordinal":1093,"en":"They took my livestock as booty,"},{"id":"manas-2010:p0038:b002:l042","ordinal":1094,"en":"They spilled my blood like water."},{"id":"manas-2010:p0038:b002:l043","ordinal":1095,"en":"So, my lord khan,"},{"id":"manas-2010:p0038:b002:l044","ordinal":1096,"en":"Gather up your army;"},{"id":"manas-2010:p0038:b002:l045","ordinal":1097,"en":"The gold that was plundered,"},{"id":"manas-2010:p0038:b002:l046","ordinal":1098,"en":"Gather every bit of it back!”"},{"id":"manas-2010:p0038:b002:l047","ordinal":1099,"en":"Once the messenger arrived,"},{"id":"manas-2010:p0038:b002:l048","ordinal":1100,"en":"A light was lit upon the tower,"},{"id":"manas-2010:p0039:b002:l001","ordinal":1101,"en":"The great war drum was beaten hard,"},{"id":"manas-2010:p0039:b002:l002","ordinal":1102,"en":"All the spears were lowered,"},{"id":"manas-2010:p0039:b002:l003","ordinal":1103,"en":"All the people gathered."},{"id":"manas-2010:p0039:b002:l004","ordinal":1104,"en":"When their khan's command arrived,"},{"id":"manas-2010:p0039:b002:l005","ordinal":1105,"en":"All the Chinese grew excited,"},{"id":"manas-2010:p0039:b002:l006","ordinal":1106,"en":"All the mighty men grew wild,"},{"id":"manas-2010:p0039:b002:l007","ordinal":1107,"en":"All the heroes flared with rage,"},{"id":"manas-2010:p0039:b002:l008","ordinal":1108,"en":"All the champions made ready:"},{"id":"manas-2010:p0039:b002:l009","ordinal":1109,"en":"“I will finish them all together,” they said,"},{"id":"manas-2010:p0039:b002:l010","ordinal":1110,"en":"“I will slaughter them, leave nothing,” they said."},{"id":"manas-2010:p0039:b002:l011","ordinal":1111,"en":"They had their armored coats prepared,"},{"id":"manas-2010:p0039:b002:l012","ordinal":1112,"en":"Had their coursers readied."},{"id":"manas-2010:p0039:b002:l013","ordinal":1113,"en":"What Alöökö wore"},{"id":"manas-2010:p0039:b002:l014","ordinal":1114,"en":"Had diamond buttons big as fists;"},{"id":"manas-2010:p0039:b002:l015","ordinal":1115,"en":"Such was the sight, if you could see him."},{"id":"manas-2010:p0039:b002:l016","ordinal":1116,"en":"Raging and blustering,"},{"id":"manas-2010:p0039:b002:l017","ordinal":1117,"en":"With the war drum pounding hard,"},{"id":"manas-2010:p0039:b002:l018","ordinal":1118,"en":"Alöökö gave his orders,"},{"id":"manas-2010:p0039:b002:l019","ordinal":1119,"en":"Upon the Black Kalmyks and Manchus"},{"id":"manas-2010:p0039:b002:l020","ordinal":1120,"en":"Again unleashing terror."},{"id":"manas-2010:p0039:b002:l021","ordinal":1121,"en":"Beside Alöökö,"},{"id":"manas-2010:p0039:b002:l022","ordinal":1122,"en":"With their jackets puffed out,"},{"id":"manas-2010:p0039:b002:l023","ordinal":1123,"en":"Were a thousand mighty khans;"},{"id":"manas-2010:p0039:b002:l024","ordinal":1124,"en":"With broad armored coats spreading wide,"},{"id":"manas-2010:p0039:b002:l025","ordinal":1125,"en":"Were a thousand kalday khans."},{"id":"manas-2010:p0039:b002:l026","ordinal":1126,"en":"His eyes blazed fierce as fire;"},{"id":"manas-2010:p0039:b002:l027","ordinal":1127,"en":"When told, “They took your gold,”"},{"id":"manas-2010:p0039:b002:l028","ordinal":1128,"en":"His thirst for blood seized him:"},{"id":"manas-2010:p0039:b002:l029","ordinal":1129,"en":"“Come, you men who cultivate wisdom,"},{"id":"manas-2010:p0039:b002:l030","ordinal":1130,"en":"Look upon this affliction!”"},{"id":"manas-2010:p0039:b002:l031","ordinal":1131,"en":"Wise was that mighty man;"},{"id":"manas-2010:p0039:b002:l032","ordinal":1132,"en":"Against the whole world"},{"id":"manas-2010:p0039:b002:l033","ordinal":1133,"en":"He had the power to stand untouched."},{"id":"manas-2010:p0039:b002:l034","ordinal":1134,"en":"At Alöökö's doorway"},{"id":"manas-2010:p0039:b002:l035","ordinal":1135,"en":"His tigress had borne fifteen cubs;"},{"id":"manas-2010:p0039:b002:l036","ordinal":1136,"en":"No human dared come near."},{"id":"manas-2010:p0039:b002:l037","ordinal":1137,"en":"Beneath him was a golden throne;"},{"id":"manas-2010:p0039:b002:l038","ordinal":1138,"en":"Who would die six months hence,"},{"id":"manas-2010:p0039:b002:l039","ordinal":1139,"en":"Who could discern that now:"},{"id":"manas-2010:p0039:b002:l040","ordinal":1140,"en":"Six diviners he had as well."},{"id":"manas-2010:p0039:b002:l041","ordinal":1141,"en":"Their very fame made hearers shudder;"},{"id":"manas-2010:p0039:b002:l042","ordinal":1142,"en":"The sixty branches of sacred learning"},{"id":"manas-2010:p0039:b002:l043","ordinal":1143,"en":"They had studied to mastery."},{"id":"manas-2010:p0039:b002:l044","ordinal":1144,"en":"Taking up their written books,"},{"id":"manas-2010:p0039:b002:l045","ordinal":1145,"en":"The diviners and sorcerers"},{"id":"manas-2010:p0039:b002:l046","ordinal":1146,"en":"Laid out their divinations."},{"id":"manas-2010:p0039:b002:l047","ordinal":1147,"en":"The six diviners of the infidel,"},{"id":"manas-2010:p0039:b002:l048","ordinal":1148,"en":"Of that hero Alöökö,"},{"id":"manas-2010:p0040:b002:l001","ordinal":1149,"en":"Addressed their khan at length;"},{"id":"manas-2010:p0040:b002:l002","ordinal":1150,"en":"All the diviners crowded round:"},{"id":"manas-2010:p0040:b002:l003","ordinal":1151,"en":"“Your gold has been found!"},{"id":"manas-2010:p0040:b002:l004","ordinal":1152,"en":"Karakan's eight sons"},{"id":"manas-2010:p0040:b002:l005","ordinal":1153,"en":"Have grown to manhood and become warriors,"},{"id":"manas-2010:p0040:b002:l006","ordinal":1154,"en":"The equals of heroic sons."},{"id":"manas-2010:p0040:b002:l007","ordinal":1155,"en":"Gathering an army of capable men,"},{"id":"manas-2010:p0040:b002:l008","ordinal":1156,"en":"Taking their warriors together,"},{"id":"manas-2010:p0040:b002:l009","ordinal":1157,"en":"They have plundered your goods;"},{"id":"manas-2010:p0040:b002:l010","ordinal":1158,"en":"Those lads have caused great trouble."},{"id":"manas-2010:p0040:b002:l011","ordinal":1159,"en":"They seized your servants;"},{"id":"manas-2010:p0040:b002:l012","ordinal":1160,"en":"Of your champions they spared none,"},{"id":"manas-2010:p0040:b002:l013","ordinal":1161,"en":"They killed every one of them."},{"id":"manas-2010:p0040:b002:l014","ordinal":1162,"en":"The gold on ninety-five camels"},{"id":"manas-2010:p0040:b002:l015","ordinal":1163,"en":"They plundered and took as booty;"},{"id":"manas-2010:p0040:b002:l016","ordinal":1164,"en":"Every one of the champions"},{"id":"manas-2010:p0040:b002:l017","ordinal":1165,"en":"They fell upon and slaughtered in the plain."},{"id":"manas-2010:p0040:b002:l018","ordinal":1166,"en":"Without anyone touching a champion,"},{"id":"manas-2010:p0040:b002:l019","ordinal":1167,"en":"The common people go about;"},{"id":"manas-2010:p0040:b002:l020","ordinal":1168,"en":"But Karakan's eight sons,"},{"id":"manas-2010:p0040:b002:l021","ordinal":1169,"en":"The Chinese who venture outside,"},{"id":"manas-2010:p0040:b002:l022","ordinal":1170,"en":"They rob and plunder and devour."},{"id":"manas-2010:p0040:b002:l023","ordinal":1171,"en":"Unless you slaughter their leaders,"},{"id":"manas-2010:p0040:b002:l024","ordinal":1172,"en":"Smash them to pieces,"},{"id":"manas-2010:p0040:b002:l025","ordinal":1173,"en":"And scatter them completely this year,"},{"id":"manas-2010:p0040:b002:l026","ordinal":1174,"en":"They will never let us prosper;"},{"id":"manas-2010:p0040:b002:l027","ordinal":1175,"en":"They will never leave us safe."},{"id":"manas-2010:p0040:b002:l028","ordinal":1176,"en":"Send champions, gather troops,"},{"id":"manas-2010:p0040:b002:l029","ordinal":1177,"en":"Gather the whole army in strength;"},{"id":"manas-2010:p0040:b002:l030","ordinal":1178,"en":"Let us descend upon their homes,"},{"id":"manas-2010:p0040:b002:l031","ordinal":1179,"en":"These Burut—may their homes burn!—"},{"id":"manas-2010:p0040:b002:l032","ordinal":1180,"en":"Let us scatter their spirit far and wide."},{"id":"manas-2010:p0040:b002:l033","ordinal":1181,"en":"Let us search their bundles,"},{"id":"manas-2010:p0040:b002:l034","ordinal":1182,"en":"Draw our line across their place of honor,"},{"id":"manas-2010:p0040:b002:l035","ordinal":1183,"en":"And give these fucking Burut"},{"id":"manas-2010:p0040:b002:l036","ordinal":1184,"en":"Something to remember!"},{"id":"manas-2010:p0040:b002:l037","ordinal":1185,"en":"Let us speak grim words;"},{"id":"manas-2010:p0040:b002:l038","ordinal":1186,"en":"If they do not give up the gold,"},{"id":"manas-2010:p0040:b002:l039","ordinal":1187,"en":"Let us seize their beautiful women.”"},{"id":"manas-2010:p0040:b002:l040","ordinal":1188,"en":"When the diviners"},{"id":"manas-2010:p0040:b002:l041","ordinal":1189,"en":"Had spoken thus and gone,"},{"id":"manas-2010:p0040:b002:l042","ordinal":1190,"en":"Concerning Alöökö's war drum,"},{"id":"manas-2010:p0040:b002:l043","ordinal":1191,"en":"When he issued his command,"},{"id":"manas-2010:p0040:b002:l044","ordinal":1192,"en":"His champion readied himself and beat it."},{"id":"manas-2010:p0040:b002:l045","ordinal":1193,"en":"When that war drum sounded,"},{"id":"manas-2010:p0040:b002:l046","ordinal":1194,"en":"It shattered the ears."},{"id":"manas-2010:p0040:b002:l047","ordinal":1195,"en":"The war drum was beaten hard;"},{"id":"manas-2010:p0040:b002:l048","ordinal":1196,"en":"When they heard the war drum's voice,"},{"id":"manas-2010:p0041:b002:l001","ordinal":1197,"en":"Every one of his champions"},{"id":"manas-2010:p0041:b002:l002","ordinal":1198,"en":"Now came crowding in."},{"id":"manas-2010:p0041:b002:l003","ordinal":1199,"en":"Of the jacket-wearing Chinese,"},{"id":"manas-2010:p0041:b002:l004","ordinal":1200,"en":"The strongest men grew frenzied;"},{"id":"manas-2010:p0041:b002:l005","ordinal":1201,"en":"Of the Chinese with rank buttons on their caps,"},{"id":"manas-2010:p0041:b002:l006","ordinal":1202,"en":"Their bald heads gathered."},{"id":"manas-2010:p0041:b002:l007","ordinal":1203,"en":"The Torgut assembled to a man,"},{"id":"manas-2010:p0041:b002:l008","ordinal":1204,"en":"Blowing their trumpets noisily,"},{"id":"manas-2010:p0041:b002:l009","ordinal":1205,"en":"Firing cannon here and there."},{"id":"manas-2010:p0041:b002:l010","ordinal":1206,"en":"Of the Black Kalmyks and Manchus,"},{"id":"manas-2010:p0041:b002:l011","ordinal":1207,"en":"The champions assembled;"},{"id":"manas-2010:p0041:b002:l012","ordinal":1208,"en":"To recover the gold,"},{"id":"manas-2010:p0041:b002:l013","ordinal":1209,"en":"Again laying a grievous claim,"},{"id":"manas-2010:p0041:b002:l014","ordinal":1210,"en":"They imposed a levy."},{"id":"manas-2010:p0041:b002:l015","ordinal":1211,"en":"Seething like ants,"},{"id":"manas-2010:p0041:b002:l016","ordinal":1212,"en":"The Chinese swarmed over everything."},{"id":"manas-2010:p0041:b002:l017","ordinal":1213,"en":"Their champions held on leashes"},{"id":"manas-2010:p0041:b002:l018","ordinal":1214,"en":"Upon the heads of the eight sons"},{"id":"manas-2010:p0041:b002:l019","ordinal":1215,"en":"Laid a terrible affliction."},{"id":"manas-2010:p0041:b002:l020","ordinal":1216,"en":"Their leader was Baltay Khan;"},{"id":"manas-2010:p0041:b002:l021","ordinal":1217,"en":"Beside Akbaltay"},{"id":"manas-2010:p0041:b002:l022","ordinal":1218,"en":"Were eight orphaned boys."},{"id":"manas-2010:p0041:b002:l023","ordinal":1219,"en":"When they came upon those boys,"},{"id":"manas-2010:p0041:b002:l024","ordinal":1220,"en":"Their valor high, their menace strong,"},{"id":"manas-2010:p0041:b002:l025","ordinal":1221,"en":"They wiped out whoever opposed them;"},{"id":"manas-2010:p0041:b002:l026","ordinal":1222,"en":"Now abandon hope of these infidels."},{"id":"manas-2010:p0041:b002:l027","ordinal":1223,"en":"Eighty-four fully armed champions,"},{"id":"manas-2010:p0041:b002:l028","ordinal":1224,"en":"Red fire wherever they fought;"},{"id":"manas-2010:p0041:b002:l029","ordinal":1225,"en":"Unable to understand human speech,"},{"id":"manas-2010:p0041:b002:l030","ordinal":1226,"en":"Their champions were a breed apart."},{"id":"manas-2010:p0041:b002:l031","ordinal":1227,"en":"All surged forward, yelling,"},{"id":"manas-2010:p0041:b002:l032","ordinal":1228,"en":"Bringing calamity upon defenseless heads."},{"id":"manas-2010:p0041:b002:l033","ordinal":1229,"en":"At the sight of those champions,"},{"id":"manas-2010:p0041:b002:l034","ordinal":1230,"en":"The people of the world gathered:"},{"id":"manas-2010:p0041:b002:l035","ordinal":1231,"en":"“They will destroy us now,” they said;"},{"id":"manas-2010:p0041:b002:l036","ordinal":1232,"en":"Unable to withstand their wrath,"},{"id":"manas-2010:p0041:b002:l037","ordinal":1233,"en":"Many Kyrgyz were slaughtered."},{"id":"manas-2010:p0041:b002:l038","ordinal":1234,"en":"Seen today, gone tomorrow:"},{"id":"manas-2010:p0041:b002:l039","ordinal":1235,"en":"Such is this shitty world!"},{"id":"manas-2010:p0041:b002:l040","ordinal":1236,"en":"“They will finish us off,” they said,"},{"id":"manas-2010:p0041:b002:l041","ordinal":1237,"en":"“If this hero grows enraged,"},{"id":"manas-2010:p0041:b002:l042","ordinal":1238,"en":"He will slaughter us and spare nothing.”"},{"id":"manas-2010:p0041:b002:l043","ordinal":1239,"en":"The people grieved;"},{"id":"manas-2010:p0041:b002:l044","ordinal":1240,"en":"All who had their senses"},{"id":"manas-2010:p0041:b002:l045","ordinal":1241,"en":"Before the hero Alöökö"},{"id":"manas-2010:p0041:b002:l046","ordinal":1242,"en":"Bowed like newly married brides."},{"id":"manas-2010:p0041:b002:l047","ordinal":1243,"en":"Wise Akbaltay"},{"id":"manas-2010:p0041:b002:l048","ordinal":1244,"en":"Dismounted and ran forward,"},{"id":"manas-2010:p0042:b002:l001","ordinal":1245,"en":"Before Alöökö,"},{"id":"manas-2010:p0042:b002:l002","ordinal":1246,"en":"Bending his knees to the earth,"},{"id":"manas-2010:p0042:b002:l003","ordinal":1247,"en":"Akbaltay stood bowing."},{"id":"manas-2010:p0042:b002:l004","ordinal":1248,"en":"Akbaltay, eloquent in speech,"},{"id":"manas-2010:p0042:b002:l005","ordinal":1249,"en":"Sharpened his plain tongue;"},{"id":"manas-2010:p0042:b002:l006","ordinal":1250,"en":"Before Khan Alöökö,"},{"id":"manas-2010:p0042:b002:l007","ordinal":1251,"en":"Dear Baltay spoke in full flow:"},{"id":"manas-2010:p0042:b002:l008","ordinal":1252,"en":"“Hero, if you truly are a khan,"},{"id":"manas-2010:p0042:b002:l009","ordinal":1253,"en":"Here is a fine land for you to rule;"},{"id":"manas-2010:p0042:b002:l010","ordinal":1254,"en":"Here are the Kyrgyz common folk, if you would slaughter them;"},{"id":"manas-2010:p0042:b002:l011","ordinal":1255,"en":"Hero, here I am, if you would kill me!"},{"id":"manas-2010:p0042:b002:l012","ordinal":1256,"en":"I have no strength to fight,"},{"id":"manas-2010:p0042:b002:l013","ordinal":1257,"en":"No means to wrestle with you,"},{"id":"manas-2010:p0042:b002:l014","ordinal":1258,"en":"No tongue with which to answer back,"},{"id":"manas-2010:p0042:b002:l015","ordinal":1259,"en":"No chance to clash in battle."},{"id":"manas-2010:p0042:b002:l016","ordinal":1260,"en":"Here are herds: take your fill;"},{"id":"manas-2010:p0042:b002:l017","ordinal":1261,"en":"Here is blood, if you would spill it;"},{"id":"manas-2010:p0042:b002:l018","ordinal":1262,"en":"If you would keep us as your subjects,"},{"id":"manas-2010:p0042:b002:l019","ordinal":1263,"en":"Here are the Argyn and Kyrgyz people."},{"id":"manas-2010:p0042:b002:l020","ordinal":1264,"en":"If you would slaughter us as ‘rebels,’"},{"id":"manas-2010:p0042:b002:l021","ordinal":1265,"en":"Here I am, Baltay, their leader!”"},{"id":"manas-2010:p0042:b002:l022","ordinal":1266,"en":"When Baltay had said this,"},{"id":"manas-2010:p0042:b002:l023","ordinal":1267,"en":"“What you say is true,”"},{"id":"manas-2010:p0042:b002:l024","ordinal":1268,"en":"Said Molto Khan, looking on;"},{"id":"manas-2010:p0042:b002:l025","ordinal":1269,"en":"To Alöökö himself"},{"id":"manas-2010:p0042:b002:l026","ordinal":1270,"en":"He issued a weighty command:"},{"id":"manas-2010:p0042:b002:l028","ordinal":1271,"en":"“The gold that was plundered,"},{"id":"manas-2010:p0042:b002:l029","ordinal":1272,"en":"There is no trace of where it went,"},{"id":"manas-2010:p0042:b002:l030","ordinal":1273,"en":"Nor have we caught the man who holds it."},{"id":"manas-2010:p0042:b002:l031","ordinal":1274,"en":"There are innocent people, peaceable people,"},{"id":"manas-2010:p0042:b002:l032","ordinal":1275,"en":"Among the many are so many good ones;"},{"id":"manas-2010:p0042:b002:l033","ordinal":1276,"en":"Can we slaughter them all?"},{"id":"manas-2010:p0042:b002:l034","ordinal":1277,"en":"Among this people are robbers and bandits,"},{"id":"manas-2010:p0042:b002:l035","ordinal":1278,"en":"But the people at large are innocent;"},{"id":"manas-2010:p0042:b002:l036","ordinal":1279,"en":"Someone in particular is doing this."},{"id":"manas-2010:p0042:b002:l037","ordinal":1280,"en":"Let us pursue him, chase him down,"}]
