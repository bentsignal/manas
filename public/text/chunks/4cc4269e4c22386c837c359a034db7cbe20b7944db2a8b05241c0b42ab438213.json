[{"id":"semetey-1-2013:p0242:b003:l008","ordinal":95233,"en":"He fought alone without fleeing."},{"id":"semetey-1-2013:p0242:b003:l009","ordinal":95234,"en":"Purified of the dark faith,"},{"id":"semetey-1-2013:p0242:b003:l010","ordinal":95235,"en":"He fled the unbelievers and became a stranger."},{"id":"semetey-1-2013:p0242:b003:l011","ordinal":95236,"en":"He came and settled in Talas,"},{"id":"semetey-1-2013:p0242:b003:l012","ordinal":95237,"en":"Became a friend till Judgment Day,"},{"id":"semetey-1-2013:p0242:b003:l013","ordinal":95238,"en":"And served as a companion to Manas."},{"id":"semetey-1-2013:p0242:b003:l014","ordinal":95239,"en":"Holding his spear, he broke through the ranks;"},{"id":"semetey-1-2013:p0242:b003:l015","ordinal":95240,"en":"He entered Kakan's land and fell to a bullet."},{"id":"semetey-1-2013:p0242:b003:l016","ordinal":95241,"en":"Upon the horse Aysarala,"},{"id":"semetey-1-2013:p0242:b003:l017","ordinal":95242,"en":"A racer like Taytoru—"},{"id":"semetey-1-2013:p0242:b003:l018","ordinal":95243,"en":"\"My dear friend's horse!\" he said."},{"id":"semetey-1-2013:p0242:b003:l019","ordinal":95244,"en":"Dear Almambet rode urging it on."},{"id":"semetey-1-2013:p0242:b003:l020","ordinal":95245,"en":"On this side of him—"},{"id":"semetey-1-2013:p0242:b003:l021","ordinal":95246,"en":"Much is false, much is true."},{"id":"semetey-1-2013:p0242:b003:l022","ordinal":95247,"en":"This lion, the renowned conqueror—"},{"id":"semetey-1-2013:p0242:b003:l023","ordinal":95248,"en":"No one has come back from seeing him."},{"id":"semetey-1-2013:p0242:b003:l024","ordinal":95249,"en":"Half is false, half is true;"},{"id":"semetey-1-2013:p0242:b003:l025","ordinal":95250,"en":"No one has returned from his side."},{"id":"semetey-1-2013:p0242:b003:l026","ordinal":95251,"en":"Tall of body, broad of shoulder,"},{"id":"semetey-1-2013:p0242:b003:l027","ordinal":95252,"en":"The most skillful of spearmen,"},{"id":"semetey-1-2013:p0242:b003:l028","ordinal":95253,"en":"The finest of the tawny-faced men,"},{"id":"semetey-1-2013:p0242:b003:l029","ordinal":95254,"en":"The noblest of heroes,"},{"id":"semetey-1-2013:p0242:b003:l030","ordinal":95255,"en":"The best of the forty companions,"},{"id":"semetey-1-2013:p0242:b003:l031","ordinal":95256,"en":"Among Manas's spearmen,"},{"id":"semetey-1-2013:p0242:b003:l032","ordinal":95257,"en":"The skillful one who shook the world:"},{"id":"semetey-1-2013:p0242:b003:l033","ordinal":95258,"en":"Chubak, son of Khan Baltay,"},{"id":"semetey-1-2013:p0242:b003:l034","ordinal":95259,"en":"With piercing cries and shrill battle shouts."},{"id":"semetey-1-2013:p0242:b003:l035","ordinal":95260,"en":"No man's strength could match him in a fight;"},{"id":"semetey-1-2013:p0242:b003:l036","ordinal":95261,"en":"A lion's teeth could not pierce him."},{"id":"semetey-1-2013:p0242:b003:l037","ordinal":95262,"en":"He wore a coat of blue rep cloth,"},{"id":"semetey-1-2013:p0242:b003:l038","ordinal":95263,"en":"Rode a horse such as Kökala."},{"id":"semetey-1-2013:p0242:b003:l039","ordinal":95264,"en":"Your Chubak, son of the unseen world,"},{"id":"semetey-1-2013:p0242:b004:l001","ordinal":95265,"en":"Your lad who knew no sorrow."},{"id":"semetey-1-2013:p0242:b004:l002","ordinal":95266,"en":"How many lands he threw into turmoil,"},{"id":"semetey-1-2013:p0242:b004:l003","ordinal":95267,"en":"That furious lad of yours!"},{"id":"semetey-1-2013:p0242:b004:l004","ordinal":95268,"en":"His bulk matched a mountain;"},{"id":"semetey-1-2013:p0242:b004:l005","ordinal":95269,"en":"He seemed ready to devour whoever appeared."},{"id":"semetey-1-2013:p0242:b004:l006","ordinal":95270,"en":"A banner could be seen in his hand;"},{"id":"semetey-1-2013:p0242:b004:l007","ordinal":95271,"en":"Venom poured from his mouth."},{"id":"semetey-1-2013:p0242:b004:l008","ordinal":95272,"en":"When he shouted and thrust his spear,"},{"id":"semetey-1-2013:p0242:b004:l009","ordinal":95273,"en":"He seemed an army of forty thousand."},{"id":"semetey-1-2013:p0242:b004:l010","ordinal":95274,"en":"When he roared and thrust his spear,"},{"id":"semetey-1-2013:p0242:b004:l011","ordinal":95275,"en":"Many men, thrown into confusion,"},{"id":"semetey-1-2013:p0242:b004:l012","ordinal":95276,"en":"Scattered in every direction."},{"id":"semetey-1-2013:p0242:b004:l013","ordinal":95277,"en":"Chubak, son of Lord Baltay,"},{"id":"semetey-1-2013:p0242:b004:l014","ordinal":95278,"en":"Your warrior, Manas's mighty champion—"},{"id":"semetey-1-2013:p0242:b004:l015","ordinal":95279,"en":"At that time, the lion Chubak"},{"id":"semetey-1-2013:p0242:b004:l016","ordinal":95280,"en":"Had died in Beijing."},{"id":"semetey-1-2013:p0242:b004:l017","ordinal":95281,"en":"The one to bind at his waist,"},{"id":"semetey-1-2013:p0242:b004:l018","ordinal":95282,"en":"Valiant Manas's mighty champion."},{"id":"semetey-1-2013:p0242:b004:l019","ordinal":95283,"en":"Almambet and Chubak were heroes,"},{"id":"semetey-1-2013:p0242:b004:l020","ordinal":95284,"en":"All twelve parts of their bodies in perfect balance,"},{"id":"semetey-1-2013:p0242:b004:l021","ordinal":95285,"en":"Heroes who shook the world."},{"id":"semetey-1-2013:p0242:b004:l022","ordinal":95286,"en":"Khan Manas's Akkula,"},{"id":"semetey-1-2013:p0242:b004:l023","ordinal":95287,"en":"Khan Chubak's Kökala,"},{"id":"semetey-1-2013:p0242:b004:l024","ordinal":95288,"en":"Almambet's Sarala,"},{"id":"semetey-1-2013:p0242:b004:l025","ordinal":95289,"en":"Khan Bakai's Köktulpar,"},{"id":"semetey-1-2013:p0242:b004:l026","ordinal":95290,"en":"Warrior Syrgak's Kökchebich—"},{"id":"semetey-1-2013:p0242:b004:l027","ordinal":95291,"en":"Untrodden by these noble steeds,"},{"id":"semetey-1-2013:p0242:b004:l028","ordinal":95292,"en":"No whole tract of land remained."},{"id":"semetey-1-2013:p0242:b004:l029","ordinal":95293,"en":"Without having heard their battle cry,"},{"id":"semetey-1-2013:p0242:b004:l030","ordinal":95294,"en":"No whole people remained."},{"id":"semetey-1-2013:p0242:b004:l031","ordinal":95295,"en":"Almambet and Chubak, the paired heroes,"},{"id":"semetey-1-2013:p0242:b004:l032","ordinal":95296,"en":"Raised their shouts."},{"id":"semetey-1-2013:p0242:b004:l033","ordinal":95297,"en":"Those champions who had died as martyrs,"},{"id":"semetey-1-2013:p0242:b004:l034","ordinal":95298,"en":"\"My dear friend's horse!\" they said,"},{"id":"semetey-1-2013:p0242:b004:l035","ordinal":95299,"en":"Urged it on all the harder."},{"id":"semetey-1-2013:p0242:b004:l036","ordinal":95300,"en":"If you look toward the front,"},{"id":"semetey-1-2013:p0242:b004:l037","ordinal":95301,"en":"His blade of dark steel—"},{"id":"semetey-1-2013:p0242:b004:l038","ordinal":95302,"en":"Have you heard of him?"},{"id":"semetey-1-2013:p0242:b004:l039","ordinal":95303,"en":"Khan Manas's Syrgak."},{"id":"semetey-1-2013:p0243:b003:l001","ordinal":95304,"en":"He never rested on his elbow,"},{"id":"semetey-1-2013:p0243:b003:l002","ordinal":95305,"en":"Never took even a wink of sleep."},{"id":"semetey-1-2013:p0243:b003:l003","ordinal":95306,"en":"Light in the saddle, watchful on the road,"},{"id":"semetey-1-2013:p0243:b003:l004","ordinal":95307,"en":"The sleepless warrior Syrgak"},{"id":"semetey-1-2013:p0243:b003:l005","ordinal":95308,"en":"Had strength to match the world."},{"id":"semetey-1-2013:p0243:b003:l006","ordinal":95309,"en":"Manas and this Syrgak"},{"id":"semetey-1-2013:p0243:b003:l007","ordinal":95310,"en":"Were the sons of brothers."},{"id":"semetey-1-2013:p0243:b003:l008","ordinal":95311,"en":"His sword rested in its sheath;"},{"id":"semetey-1-2013:p0243:b003:l009","ordinal":95312,"en":"When he attacked an eager foe,"},{"id":"semetey-1-2013:p0243:b003:l010","ordinal":95313,"en":"He too drenched him in red blood."},{"id":"semetey-1-2013:p0243:b003:l011","ordinal":95314,"en":"He never followed wicked counsel,"},{"id":"semetey-1-2013:p0243:b003:l012","ordinal":95315,"en":"Never slunk away from an enemy."},{"id":"semetey-1-2013:p0243:b003:l013","ordinal":95316,"en":"Who rode a splendid courser,"},{"id":"semetey-1-2013:p0243:b003:l014","ordinal":95317,"en":"He wore a coat of blue iron,"},{"id":"semetey-1-2013:p0243:b003:l015","ordinal":95318,"en":"The finest of the sixty,"},{"id":"semetey-1-2013:p0243:b003:l016","ordinal":95319,"en":"The precious one among forty companions,"},{"id":"semetey-1-2013:p0243:b003:l017","ordinal":95320,"en":"Worth them all."},{"id":"semetey-1-2013:p0243:b003:l018","ordinal":95321,"en":"Young Syrgak, the outstanding hero,"},{"id":"semetey-1-2013:p0243:b003:l019","ordinal":95322,"en":"With piercing cries and resounding battle shouts,"},{"id":"semetey-1-2013:p0243:b003:l020","ordinal":95323,"en":"Raised his voice without restraint."},{"id":"semetey-1-2013:p0243:b003:l021","ordinal":95324,"en":"The dear lion who died a martyr—"},{"id":"semetey-1-2013:p0243:b003:l023","ordinal":95325,"en":"Dear young Syrgak, whose death brought grief,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0243:b003:l024","ordinal":95326,"en":"Was himself urging the horse on."},{"id":"semetey-1-2013:p0243:b003:l025","ordinal":95327,"en":"The great lead rope tied in knotted loops,"},{"id":"semetey-1-2013:p0243:b003:l026","ordinal":95328,"en":"Dear Syrgak drew from his hand"},{"id":"semetey-1-2013:p0243:b003:l027","ordinal":95329,"en":"And struck the horse's flank."},{"id":"semetey-1-2013:p0243:b003:l028","ordinal":95330,"en":"Dear Syrgak urged it on."},{"id":"semetey-1-2013:p0243:b003:l029","ordinal":95331,"en":"If you look behind him,"},{"id":"semetey-1-2013:p0243:b003:l030","ordinal":95332,"en":"His face like oiled wheat,"},{"id":"semetey-1-2013:p0243:b003:l031","ordinal":95333,"en":"His eyes like twilight mist,"},{"id":"semetey-1-2013:p0243:b003:l032","ordinal":95334,"en":"A black-spotted leopard"},{"id":"semetey-1-2013:p0243:b003:l033","ordinal":95335,"en":"Charging at his side,"},{"id":"semetey-1-2013:p0243:b003:l034","ordinal":95336,"en":"A maimed, fierce lion"},{"id":"semetey-1-2013:p0243:b003:l035","ordinal":95337,"en":"Moving beside him, ready—"},{"id":"semetey-1-2013:p0243:b003:l036","ordinal":95338,"en":"The leopard of peerless fortune,"},{"id":"semetey-1-2013:p0243:b003:l037","ordinal":95339,"en":"Who brought hardship upon this poor head,"},{"id":"semetey-1-2013:p0243:b003:l038","ordinal":95340,"en":"My saint who went to the other world,"},{"id":"semetey-1-2013:p0243:b003:l039","ordinal":95341,"en":"Who made the broad world narrow,"},{"id":"semetey-1-2013:p0243:b005:l001","ordinal":95342,"en":"Who left me yearning for one glimpse."},{"id":"semetey-1-2013:p0243:b005:l002","ordinal":95343,"en":"When he launched a campaign against Kakan,"},{"id":"semetey-1-2013:p0243:b005:l003","ordinal":95344,"en":"He led the army of Islam."},{"id":"semetey-1-2013:p0243:b005:l004","ordinal":95345,"en":"At thirty-two,"},{"id":"semetey-1-2013:p0243:b005:l005","ordinal":95346,"en":"He left his unfortunate one bereft."},{"id":"semetey-1-2013:p0243:b005:l006","ordinal":95347,"en":"United when they were tiny as lice,"},{"id":"semetey-1-2013:p0243:b005:l007","ordinal":95348,"en":"Joined when they were small as thumbs,"},{"id":"semetey-1-2013:p0243:b005:l008","ordinal":95349,"en":"Her sovereign, Khan Manas,"},{"id":"semetey-1-2013:p0243:b005:l009","ordinal":95350,"en":"\"My poor dear one's horse!\" he said,"},{"id":"semetey-1-2013:p0243:b005:l010","ordinal":95351,"en":"And himself galloped after it."},{"id":"semetey-1-2013:p0243:b005:l011","ordinal":95352,"en":"The two khans, Ajybay and Bakai,"},{"id":"semetey-1-2013:p0243:b005:l012","ordinal":95353,"en":"\"Our poor dear friend's horse!\" they said,"},{"id":"semetey-1-2013:p0243:b005:l013","ordinal":95354,"en":"And galloped after it too."},{"id":"semetey-1-2013:p0243:b005:l014","ordinal":95355,"en":"Your noble mother Kanykei,"},{"id":"semetey-1-2013:p0243:b005:l015","ordinal":95356,"en":"Dividing the hair down her back in ten,"},{"id":"semetey-1-2013:p0243:b005:l016","ordinal":95357,"en":"Had left it unbraided."},{"id":"semetey-1-2013:p0243:b005:l017","ordinal":95358,"en":"Manas, her betrothed—"},{"id":"semetey-1-2013:p0243:b005:l018","ordinal":95359,"en":"Yearning to see him once,"},{"id":"semetey-1-2013:p0243:b005:l019","ordinal":95360,"en":"For twelve long years,"},{"id":"semetey-1-2013:p0243:b005:l020","ordinal":95361,"en":"Your mother had not seen him."},{"id":"semetey-1-2013:p0243:b005:l021","ordinal":95362,"en":"Crying out on the mountaintop,"},{"id":"semetey-1-2013:p0243:b005:l022","ordinal":95363,"en":"Your mother had become a snowcock."},{"id":"semetey-1-2013:p0243:b005:l023","ordinal":95364,"en":"Her mountain, the leopard Manas,"},{"id":"semetey-1-2013:p0243:b005:l024","ordinal":95365,"en":"Planted there in the world,"},{"id":"semetey-1-2013:p0243:b005:l025","ordinal":95366,"en":"Had been a plane tree."},{"id":"semetey-1-2013:p0243:b005:l026","ordinal":95367,"en":"To see her true lord,"},{"id":"semetey-1-2013:p0243:b005:l027","ordinal":95368,"en":"Your dear mother Kanykei"},{"id":"semetey-1-2013:p0243:b005:l028","ordinal":95369,"en":"Had longed so deeply."},{"id":"semetey-1-2013:p0243:b005:l029","ordinal":95370,"en":"Unable to turn Akborchuk's head,"},{"id":"semetey-1-2013:p0243:b005:l030","ordinal":95371,"en":"Your noble sister-in-law Kanykei,"},{"id":"semetey-1-2013:p0243:b005:l031","ordinal":95372,"en":"When she saw his very spirit,"},{"id":"semetey-1-2013:p0243:b005:l032","ordinal":95373,"en":"Could not stand without crying out;"},{"id":"semetey-1-2013:p0243:b005:l033","ordinal":95374,"en":"She wept and sobbed aloud:"},{"id":"semetey-1-2013:p0243:b005:l034","ordinal":95375,"en":"\"My betrothed lord, my fierce warrior,"},{"id":"semetey-1-2013:p0243:b005:l035","ordinal":95376,"en":"Take me with you!\" she shrieked."},{"id":"semetey-1-2013:p0243:b005:l036","ordinal":95377,"en":"\"My sultan, when the moon is dark,"},{"id":"semetey-1-2013:p0243:b005:l037","ordinal":95378,"en":"Is the night like this?"},{"id":"semetey-1-2013:p0243:b005:l038","ordinal":95379,"en":"When one loses one's betrothed,"},{"id":"semetey-1-2013:p0243:b005:l039","ordinal":95380,"en":"Are the days like this?"},{"id":"semetey-1-2013:p0244:b003:l001","ordinal":95381,"en":"Bloody tears flow from my eyes;"},{"id":"semetey-1-2013:p0244:b003:l002","ordinal":95382,"en":"Is a flood like this?"},{"id":"semetey-1-2013:p0244:b003:l003","ordinal":95383,"en":"Bereft of her leopard,"},{"id":"semetey-1-2013:p0244:b003:l004","ordinal":95384,"en":"When a woman wanders grieving,"},{"id":"semetey-1-2013:p0244:b003:l005","ordinal":95385,"en":"Is this how it must be?"},{"id":"semetey-1-2013:p0244:b003:l006","ordinal":95386,"en":"Misfortune fell upon my head;"},{"id":"semetey-1-2013:p0244:b003:l007","ordinal":95387,"en":"Carrying my child away,"},{"id":"semetey-1-2013:p0244:b003:l008","ordinal":95388,"en":"To my father's city,"},{"id":"semetey-1-2013:p0244:b003:l009","ordinal":95389,"en":"Has anyone fled as I have?"},{"id":"semetey-1-2013:p0244:b003:l010","ordinal":95390,"en":"Alas, my sultan, my leopard,"},{"id":"semetey-1-2013:p0244:b003:l011","ordinal":95391,"en":"My saint gone to the other world,"},{"id":"semetey-1-2013:p0244:b003:l012","ordinal":95392,"en":"Tie me to your saddle thongs and take me;"},{"id":"semetey-1-2013:p0244:b003:l013","ordinal":95393,"en":"Do not leave me grieving and wailing."},{"id":"semetey-1-2013:p0244:b003:l014","ordinal":95394,"en":"Have pity, take me with you!"},{"id":"semetey-1-2013:p0244:b003:l015","ordinal":95395,"en":"My shirts of many kinds,"},{"id":"semetey-1-2013:p0244:b003:l016","ordinal":95396,"en":"When I pull them up, do not reach my neck."},{"id":"semetey-1-2013:p0244:b003:l017","ordinal":95397,"en":"Do not wear me out, my sultan;"},{"id":"semetey-1-2013:p0244:b003:l018","ordinal":95398,"en":"Draw me into your embrace."},{"id":"semetey-1-2013:p0244:b003:l019","ordinal":95399,"en":"My shirt mingled with blue,"},{"id":"semetey-1-2013:p0244:b003:l020","ordinal":95400,"en":"Though I wear it often, does not reach my neck."},{"id":"semetey-1-2013:p0244:b003:l021","ordinal":95401,"en":"This raging woman who wanders—"},{"id":"semetey-1-2013:p0244:b003:l022","ordinal":95402,"en":"Leopard, keep her in your thoughts!"},{"id":"semetey-1-2013:p0244:b003:l023","ordinal":95403,"en":"Do not make my broad world narrow;"},{"id":"semetey-1-2013:p0244:b003:l024","ordinal":95404,"en":"This grieving, unfortunate woman—"},{"id":"semetey-1-2013:p0244:b003:l025","ordinal":95405,"en":"Do not make her scream with longing.\""},{"id":"semetey-1-2013:p0244:b003:l026","ordinal":95406,"en":"So spoke your mother."},{"id":"semetey-1-2013:p0244:b003:l027","ordinal":95407,"en":"From her dear, quail-like eyes,"},{"id":"semetey-1-2013:p0244:b003:l028","ordinal":95408,"en":"Tears flowed in separate streams."},{"id":"semetey-1-2013:p0244:b003:l029","ordinal":95409,"en":"Unable to collect herself,"},{"id":"semetey-1-2013:p0244:b003:l030","ordinal":95410,"en":"She turned about, weeping and crying,"},{"id":"semetey-1-2013:p0244:b003:l031","ordinal":95411,"en":"Wailing and sobbing aloud."},{"id":"semetey-1-2013:p0244:b003:l032","ordinal":95412,"en":"Her poor heart was torn;"},{"id":"semetey-1-2013:p0244:b003:l033","ordinal":95413,"en":"Tears poured from her eyes."},{"id":"semetey-1-2013:p0244:b003:l034","ordinal":95414,"en":"The lord she saw before her,"},{"id":"semetey-1-2013:p0244:b003:l035","ordinal":95415,"en":"Her fierce warrior, dear Manas,"},{"id":"semetey-1-2013:p0244:b003:l036","ordinal":95416,"en":"Appeared just as he had in life."},{"id":"semetey-1-2013:p0244:b003:l037","ordinal":95417,"en":"When she saw her plane-tree garden,"},{"id":"semetey-1-2013:p0244:b003:l038","ordinal":95418,"en":"The hair down her back, in six—"},{"id":"semetey-1-2013:p0244:b003:l039","ordinal":95419,"en":"Would your sister-in-law leave it unbraided?"},{"id":"semetey-1-2013:p0244:b004:l001","ordinal":95420,"en":"\"Take me with you!\" she cried."},{"id":"semetey-1-2013:p0244:b004:l002","ordinal":95421,"en":"Your noble mother Kanykei,"},{"id":"semetey-1-2013:p0244:b004:l003","ordinal":95422,"en":"Wailing and sobbing again and again,"},{"id":"semetey-1-2013:p0244:b004:l004","ordinal":95423,"en":"Now raised a piercing cry."},{"id":"semetey-1-2013:p0244:b004:l005","ordinal":95424,"en":"When she saw that plane-tree garden,"},{"id":"semetey-1-2013:p0244:b004:l006","ordinal":95425,"en":"At her white cheeks round as cups,"},{"id":"semetey-1-2013:p0244:b004:l007","ordinal":95426,"en":"\"My true lord, take me!\" she said,"},{"id":"semetey-1-2013:p0244:b004:l008","ordinal":95427,"en":"And tore at them again and again."},{"id":"semetey-1-2013:p0244:b004:l009","ordinal":95428,"en":"As she tore, dark blood flowed;"},{"id":"semetey-1-2013:p0244:b004:l010","ordinal":95429,"en":"Your mother's strength ebbed away."},{"id":"semetey-1-2013:p0244:b004:l011","ordinal":95430,"en":"Akborchuk continued pacing;"},{"id":"semetey-1-2013:p0244:b004:l012","ordinal":95431,"en":"From Akborchuk's mane—"},{"id":"semetey-1-2013:p0244:b004:l013","ordinal":95432,"en":"The poor world had turned upside down—"},{"id":"semetey-1-2013:p0244:b004:l014","ordinal":95433,"en":"Bloody tears mixed with blood"},{"id":"semetey-1-2013:p0244:b004:l015","ordinal":95434,"en":"Streamed down in rivulets."},{"id":"semetey-1-2013:p0244:b004:l016","ordinal":95435,"en":"The very spirit of Manas"},{"id":"semetey-1-2013:p0244:b004:l017","ordinal":95436,"en":"She had almost seen;"},{"id":"semetey-1-2013:p0244:b004:l018","ordinal":95437,"en":"Kanykei, shrieking and weeping,"},{"id":"semetey-1-2013:p0244:b004:l019","ordinal":95438,"en":"Almost died."},{"id":"semetey-1-2013:p0244:b004:l020","ordinal":95439,"en":"She turned Akborchuk's head,"},{"id":"semetey-1-2013:p0244:b004:l021","ordinal":95440,"en":"Tore her cheeks with both hands."},{"id":"semetey-1-2013:p0244:b004:l022","ordinal":95441,"en":"As she tore, dark blood flowed;"},{"id":"semetey-1-2013:p0244:b004:l023","ordinal":95442,"en":"Your sister-in-law's strength ebbed away."},{"id":"semetey-1-2013:p0244:b004:l024","ordinal":95443,"en":"Her dear hair, thick as a girth,"},{"id":"semetey-1-2013:p0244:b004:l025","ordinal":95444,"en":"She brought down to her breast"},{"id":"semetey-1-2013:p0244:b004:l026","ordinal":95445,"en":"And almost braided it."},{"id":"semetey-1-2013:p0244:b004:l027","ordinal":95446,"en":"Blood flowed from both cheeks;"},{"id":"semetey-1-2013:p0244:b004:l028","ordinal":95447,"en":"Your sister-in-law's strength ebbed away,"},{"id":"semetey-1-2013:p0244:b004:l029","ordinal":95448,"en":"And she almost died."},{"id":"semetey-1-2013:p0244:b004:l030","ordinal":95449,"en":"Akborchuk continued pacing;"},{"id":"semetey-1-2013:p0244:b004:l031","ordinal":95450,"en":"From Akborchuk's mane,"},{"id":"semetey-1-2013:p0244:b004:l032","ordinal":95451,"en":"Bloody tears mixed with blood"},{"id":"semetey-1-2013:p0244:b004:l033","ordinal":95452,"en":"Streamed down in rivulets."},{"id":"semetey-1-2013:p0244:b004:l034","ordinal":95453,"en":"Unable to collect herself,"},{"id":"semetey-1-2013:p0244:b004:l035","ordinal":95454,"en":"Hoarse with weeping, crying out,"},{"id":"semetey-1-2013:p0244:b004:l036","ordinal":95455,"en":"Manas, gone to the other world—"},{"id":"semetey-1-2013:p0244:b004:l037","ordinal":95456,"en":"She implored his spirit"},{"id":"semetey-1-2013:p0244:b004:l038","ordinal":95457,"en":"And stood wailing and sobbing."},{"id":"semetey-1-2013:p0244:b004:l039","ordinal":95458,"en":"From that ridge shaped like a saddle's waist,"},{"id":"semetey-1-2013:p0245:b003:l001","ordinal":95459,"en":"Unable to find any way out,"},{"id":"semetey-1-2013:p0245:b003:l002","ordinal":95460,"en":"She turned its little wheel,"},{"id":"semetey-1-2013:p0245:b003:l003","ordinal":95461,"en":"Manas's very telescope—"},{"id":"semetey-1-2013:p0245:b003:l004","ordinal":95462,"en":"And set it firmly to her eye."},{"id":"semetey-1-2013:p0245:b003:l005","ordinal":95463,"en":"Her dear eyes like blackcurrants,"},{"id":"semetey-1-2013:p0245:b003:l006","ordinal":95464,"en":"She turned and wiped them now."},{"id":"semetey-1-2013:p0245:b003:l007","ordinal":95465,"en":"There were no Kyrgyz to support her."},{"id":"semetey-1-2013:p0245:b003:l008","ordinal":95466,"en":"Then your mother Kanykei"},{"id":"semetey-1-2013:p0245:b003:l009","ordinal":95467,"en":"Summoned her courage."},{"id":"semetey-1-2013:p0245:b003:l010","ordinal":95468,"en":"Drawing the telescope back,"},{"id":"semetey-1-2013:p0245:b003:l011","ordinal":95469,"en":"She set it to her dear eye."},{"id":"semetey-1-2013:p0245:b003:l012","ordinal":95470,"en":"She turned her noble steed's head."},{"id":"semetey-1-2013:p0245:b003:l013","ordinal":95471,"en":"Your sister-in-law could not stop weeping;"},{"id":"semetey-1-2013:p0245:b003:l014","ordinal":95472,"en":"She aimed the telescope at the horses"},{"id":"semetey-1-2013:p0245:b003:l015","ordinal":95473,"en":"And looked carefully."},{"id":"semetey-1-2013:p0245:b003:l016","ordinal":95474,"en":"At the mouth of the broad, jutting mountain,"},{"id":"semetey-1-2013:p0245:b003:l017","ordinal":95475,"en":"On the ridge of the broad pass,"},{"id":"semetey-1-2013:p0245:b003:l018","ordinal":95476,"en":"Taytoru was coming,"},{"id":"semetey-1-2013:p0245:b003:l019","ordinal":95477,"en":"Behind six racers."},{"id":"semetey-1-2013:p0245:b003:l020","ordinal":95478,"en":"The wind could not match his gallop;"},{"id":"semetey-1-2013:p0245:b003:l021","ordinal":95479,"en":"He ran at full speed."},{"id":"semetey-1-2013:p0245:b003:l022","ordinal":95480,"en":"No other horse could match his stride;"},{"id":"semetey-1-2013:p0245:b003:l023","ordinal":95481,"en":"He ran as something apart."},{"id":"semetey-1-2013:p0245:b003:l024","ordinal":95482,"en":"When she saw Taytoru,"},{"id":"semetey-1-2013:p0245:b003:l025","ordinal":95483,"en":"That poor woman who had suffered hardship,"},{"id":"semetey-1-2013:p0245:b003:l026","ordinal":95484,"en":"Your mourning sister-in-law Kanykei,"},{"id":"semetey-1-2013:p0245:b003:l027","ordinal":95485,"en":"Unable to stand there grieving,"},{"id":"semetey-1-2013:p0245:b003:l028","ordinal":95486,"en":"Now took her chance."},{"id":"semetey-1-2013:p0245:b003:l029","ordinal":95487,"en":"Firmly girding herself for hell,"},{"id":"semetey-1-2013:p0245:b003:l030","ordinal":95488,"en":"She could not keep still."}]
