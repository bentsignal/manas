[{"id":"semetey-1-2013:p1115:b003:l039","ordinal":161281,"en":"That was where infidel and Muslim"},{"id":"semetey-1-2013:p1115:b005:l001","ordinal":161282,"en":"Crossed paths."},{"id":"semetey-1-2013:p1115:b005:l002","ordinal":161283,"en":"May God never show us such a sight!"},{"id":"semetey-1-2013:p1115:b005:l003","ordinal":161284,"en":"Before one could say this or that,"},{"id":"semetey-1-2013:p1115:b005:l004","ordinal":161285,"en":"In the blink of an eye,"},{"id":"semetey-1-2013:p1115:b005:l005","ordinal":161286,"en":"The people burst into alarm."},{"id":"semetey-1-2013:p1115:b005:l006","ordinal":161287,"en":"They seized their spears;"},{"id":"semetey-1-2013:p1115:b005:l007","ordinal":161288,"en":"All the Muslims"},{"id":"semetey-1-2013:p1115:b005:l008","ordinal":161289,"en":"Turned their minds to battle."},{"id":"semetey-1-2013:p1115:b005:l009","ordinal":161290,"en":"They ran to their horses,"},{"id":"semetey-1-2013:p1115:b005:l010","ordinal":161291,"en":"Despairing of their entrusted lives."},{"id":"semetey-1-2013:p1115:b005:l011","ordinal":161292,"en":"The reason they despaired was this:"},{"id":"semetey-1-2013:p1115:b005:l012","ordinal":161293,"en":"There was Khan Koshoy, leader of the elders,"},{"id":"semetey-1-2013:p1115:b005:l013","ordinal":161294,"en":"And dear Töshtük was there as well;"},{"id":"semetey-1-2013:p1115:b005:l014","ordinal":161295,"en":"Among the assembled Muslims"},{"id":"semetey-1-2013:p1115:b005:l015","ordinal":161296,"en":"There were lions besides Manas."},{"id":"semetey-1-2013:p1115:b005:l016","ordinal":161297,"en":"The Black Kalmyks and Manchus"},{"id":"semetey-1-2013:p1115:b005:l017","ordinal":161298,"en":"Had reached the appointed place;"},{"id":"semetey-1-2013:p1115:b005:l018","ordinal":161299,"en":"Kalmyks countless as hairs on a cow"},{"id":"semetey-1-2013:p1115:b005:l019","ordinal":161300,"en":"Had covered the land."},{"id":"semetey-1-2013:p1115:b005:l020","ordinal":161301,"en":"Seven standard-banners came;"},{"id":"semetey-1-2013:p1115:b005:l021","ordinal":161302,"en":"A din that split the earth came."},{"id":"semetey-1-2013:p1115:b005:l022","ordinal":161303,"en":"One flank of the Kalmyks"},{"id":"semetey-1-2013:p1115:b005:l023","ordinal":161304,"en":"Skirted Ketmen-Bel,"},{"id":"semetey-1-2013:p1115:b005:l024","ordinal":161305,"en":"While the upper part of that army"},{"id":"semetey-1-2013:p1115:b005:l025","ordinal":161306,"en":"Pressed against Aygyr-Zhal."},{"id":"semetey-1-2013:p1115:b005:l026","ordinal":161307,"en":"When they asked whose army it was,"},{"id":"semetey-1-2013:p1115:b005:l027","ordinal":161308,"en":"It was Great Zholoy's army."},{"id":"semetey-1-2013:p1115:b005:l028","ordinal":161309,"en":"Because the Kalmyks were so numerous,"},{"id":"semetey-1-2013:p1115:b005:l029","ordinal":161310,"en":"They began to cause havoc;"},{"id":"semetey-1-2013:p1115:b005:l030","ordinal":161311,"en":"The army that came from the Muslims"},{"id":"semetey-1-2013:p1115:b005:l031","ordinal":161312,"en":"Was ready to flee."},{"id":"semetey-1-2013:p1115:b005:l032","ordinal":161313,"en":"They halted in agitation,"},{"id":"semetey-1-2013:p1115:b005:l033","ordinal":161314,"en":"Cursing one another."},{"id":"semetey-1-2013:p1115:b005:l034","ordinal":161315,"en":"Saying brave Bokmurun had gathered"},{"id":"semetey-1-2013:p1115:b005:l035","ordinal":161316,"en":"A strange people no nation had seen,"},{"id":"semetey-1-2013:p1115:b005:l036","ordinal":161317,"en":"“Let them plunder if they wish;"},{"id":"semetey-1-2013:p1115:b005:l037","ordinal":161318,"en":"They are guests who have come to us,”"},{"id":"semetey-1-2013:p1115:b005:l038","ordinal":161319,"en":"They exchanged formal courtesies"},{"id":"semetey-1-2013:p1115:b005:l039","ordinal":161320,"en":"And endured the trouble,"},{"id":"semetey-1-2013:p1116:b003:l001","ordinal":161321,"en":"Saying, “They may overrun us.”"},{"id":"semetey-1-2013:p1116:b003:l002","ordinal":161322,"en":"It was an army that had come to the feast."},{"id":"semetey-1-2013:p1116:b003:l003","ordinal":161323,"en":"“If they happen to take offense,"},{"id":"semetey-1-2013:p1116:b003:l004","ordinal":161324,"en":"They will destroy and devour us;"},{"id":"semetey-1-2013:p1116:b003:l005","ordinal":161325,"en":"If they scowl and grow angry,"},{"id":"semetey-1-2013:p1116:b003:l006","ordinal":161326,"en":"Perhaps they will seize us and leave,"},{"id":"semetey-1-2013:p1116:b003:l007","ordinal":161327,"en":"Perhaps they will plunder their way"},{"id":"semetey-1-2013:p1116:b003:l008","ordinal":161328,"en":"To Beijing in Chynmachyn."},{"id":"semetey-1-2013:p1116:b003:l009","ordinal":161329,"en":"Perhaps these Kalmyks will do"},{"id":"semetey-1-2013:p1116:b003:l010","ordinal":161330,"en":"Whatever they please."},{"id":"semetey-1-2013:p1116:b003:l011","ordinal":161331,"en":"If a quarrel happens by chance,"},{"id":"semetey-1-2013:p1116:b003:l012","ordinal":161332,"en":"If they happen to leave in anger,"},{"id":"semetey-1-2013:p1116:b003:l013","ordinal":161333,"en":"Perhaps they will slaughter us."},{"id":"semetey-1-2013:p1116:b003:l014","ordinal":161334,"en":"Perhaps they will lay low"},{"id":"semetey-1-2013:p1116:b003:l015","ordinal":161335,"en":"Every hero who raises his head."},{"id":"semetey-1-2013:p1116:b003:l016","ordinal":161336,"en":"Perhaps they will bind the weak and feeble"},{"id":"semetey-1-2013:p1116:b003:l017","ordinal":161337,"en":"And take them away"},{"id":"semetey-1-2013:p1116:b003:l018","ordinal":161338,"en":"To the seething Kalmyks.”"},{"id":"semetey-1-2013:p1116:b003:l019","ordinal":161339,"en":"When the Kalmyk vanguard arrived,"},{"id":"semetey-1-2013:p1116:b003:l020","ordinal":161340,"en":"The great people ran in fear,"},{"id":"semetey-1-2013:p1116:b003:l021","ordinal":161341,"en":"All despairing of life."},{"id":"semetey-1-2013:p1116:b003:l022","ordinal":161342,"en":"What could the wretched few people do,"},{"id":"semetey-1-2013:p1116:b003:l023","ordinal":161343,"en":"Stamping the ground in agitation?"},{"id":"semetey-1-2013:p1116:b003:l024","ordinal":161344,"en":"What recourse had those people"},{"id":"semetey-1-2013:p1116:b003:l025","ordinal":161345,"en":"As they blamed Bokmurun?"},{"id":"semetey-1-2013:p1116:b003:l026","ordinal":161346,"en":"Before much time had passed—"},{"id":"semetey-1-2013:p1116:b003:l027","ordinal":161347,"en":"May God never show us such a sight!—"},{"id":"semetey-1-2013:p1116:b003:l028","ordinal":161348,"en":"A din came that split the earth;"},{"id":"semetey-1-2013:p1116:b003:l029","ordinal":161349,"en":"Seven standard-banners came;"},{"id":"semetey-1-2013:p1116:b003:l030","ordinal":161350,"en":"An army spreading across the land came."},{"id":"semetey-1-2013:p1116:b003:l031","ordinal":161351,"en":"The spear points glittered;"},{"id":"semetey-1-2013:p1116:b003:l032","ordinal":161352,"en":"The people's heads swayed."},{"id":"semetey-1-2013:p1116:b003:l033","ordinal":161353,"en":"At the sight, the Muslims'"},{"id":"semetey-1-2013:p1116:b003:l034","ordinal":161354,"en":"Hearts throbbed without cease."},{"id":"semetey-1-2013:p1116:b003:l035","ordinal":161355,"en":"As though splitting the mountains, a multitude came;"},{"id":"semetey-1-2013:p1116:b003:l036","ordinal":161356,"en":"An army like a surging sea came."},{"id":"semetey-1-2013:p1116:b003:l037","ordinal":161357,"en":"Mountain-like Manas was not there;"},{"id":"semetey-1-2013:p1116:b003:l038","ordinal":161358,"en":"Tormented souls were stricken with anguish."},{"id":"semetey-1-2013:p1116:b003:l039","ordinal":161359,"en":"When they asked whose army it was,"},{"id":"semetey-1-2013:p1116:b004:l001","ordinal":161360,"en":"It was Khan Zholoy's army."},{"id":"semetey-1-2013:p1116:b004:l002","ordinal":161361,"en":"Bokmurun's arrogance"},{"id":"semetey-1-2013:p1116:b004:l003","ordinal":161362,"en":"Was the Muslim people's misfortune."},{"id":"semetey-1-2013:p1116:b004:l004","ordinal":161363,"en":"Khan Zholoy of the Kalmyks—"},{"id":"semetey-1-2013:p1116:b004:l005","ordinal":161364,"en":"His appearance and grandeur,"},{"id":"semetey-1-2013:p1116:b004:l006","ordinal":161365,"en":"His figure mounted on his horse,"},{"id":"semetey-1-2013:p1116:b004:l007","ordinal":161366,"en":"Looked as vast as Ala-Too."},{"id":"semetey-1-2013:p1116:b004:l008","ordinal":161367,"en":"Khan Zholoy of the Kalmyks"},{"id":"semetey-1-2013:p1116:b004:l009","ordinal":161368,"en":"Put on his gauntlet,"},{"id":"semetey-1-2013:p1116:b004:l010","ordinal":161369,"en":"Raging like a boar."},{"id":"semetey-1-2013:p1116:b004:l011","ordinal":161370,"en":"If you were to see Zholoy,"},{"id":"semetey-1-2013:p1116:b004:l012","ordinal":161371,"en":"He was the summit of a snowy mountain,"},{"id":"semetey-1-2013:p1116:b004:l013","ordinal":161372,"en":"The prince of the Black Kalmyks."},{"id":"semetey-1-2013:p1116:b004:l014","ordinal":161373,"en":"When Khan Zholoy entered,"},{"id":"semetey-1-2013:p1116:b004:l015","ordinal":161374,"en":"The mere handful of Muslims"},{"id":"semetey-1-2013:p1116:b004:l016","ordinal":161375,"en":"Split apart and scattered,"},{"id":"semetey-1-2013:p1116:b004:l017","ordinal":161376,"en":"All running without saying,"},{"id":"semetey-1-2013:p1116:b004:l018","ordinal":161377,"en":"“Welcome, guest, welcome.”"},{"id":"semetey-1-2013:p1116:b004:l019","ordinal":161378,"en":"Flying like arrows as they ran,"},{"id":"semetey-1-2013:p1116:b004:l020","ordinal":161379,"en":"Kökötöy's wrestlers"},{"id":"semetey-1-2013:p1116:b004:l021","ordinal":161380,"en":"Took Zholoy's horse;"},{"id":"semetey-1-2013:p1116:b004:l022","ordinal":161381,"en":"The mountain-like giant Zholoy"},{"id":"semetey-1-2013:p1116:b004:l023","ordinal":161382,"en":"Dismounted, swelling with pride."},{"id":"semetey-1-2013:p1116:b004:l024","ordinal":161383,"en":"Behind him his Kalmyks,"},{"id":"semetey-1-2013:p1116:b004:l025","ordinal":161384,"en":"Massed like hairs on a cow,"},{"id":"semetey-1-2013:p1116:b004:l026","ordinal":161385,"en":"Also dismounted together."},{"id":"semetey-1-2013:p1116:b004:l027","ordinal":161386,"en":"Kökötöy's son Bokmurun—"},{"id":"semetey-1-2013:p1116:b004:l028","ordinal":161387,"en":"The torment he brought upon the people!"},{"id":"semetey-1-2013:p1116:b004:l029","ordinal":161388,"en":"The great hardship that now arose"},{"id":"semetey-1-2013:p1116:b004:l030","ordinal":161389,"en":"Was the punishment of the Kalmyks."},{"id":"semetey-1-2013:p1116:b004:l031","ordinal":161390,"en":"Saying, “Have you arrived, honored guest?”"},{"id":"semetey-1-2013:p1116:b004:l032","ordinal":161391,"en":"Bokmurun walked forward"},{"id":"semetey-1-2013:p1116:b004:l033","ordinal":161392,"en":"Before Great Zholoy."},{"id":"semetey-1-2013:p1116:b004:l034","ordinal":161393,"en":"Bokmurun had exactly thirty thousand"},{"id":"semetey-1-2013:p1116:b004:l035","ordinal":161394,"en":"Wrestlers serving him;"},{"id":"semetey-1-2013:p1116:b004:l036","ordinal":161395,"en":"For Zholoy of the Kalmyks,"},{"id":"semetey-1-2013:p1116:b004:l037","ordinal":161396,"en":"They prepared the food he would eat."},{"id":"semetey-1-2013:p1116:b004:l038","ordinal":161397,"en":"The mere handful of Muslims wondered,"},{"id":"semetey-1-2013:p1116:b004:l039","ordinal":161398,"en":"“Good Lord, what will he do?”"},{"id":"semetey-1-2013:p1117:b003:l001","ordinal":161399,"en":"They had scarcely any sense left."},{"id":"semetey-1-2013:p1117:b003:l002","ordinal":161400,"en":"When he learned that the people were afraid,"},{"id":"semetey-1-2013:p1117:b003:l003","ordinal":161401,"en":"Kökötöy's son Bokmurun"},{"id":"semetey-1-2013:p1117:b003:l004","ordinal":161402,"en":"From Kökötöy's ingots of red gold"},{"id":"semetey-1-2013:p1117:b003:l005","ordinal":161403,"en":"Wrapped in great sheets of hide,"},{"id":"semetey-1-2013:p1117:b003:l006","ordinal":161404,"en":"Saying, “This is your reward,”"},{"id":"semetey-1-2013:p1117:b003:l007","ordinal":161405,"en":"He brought them before him"},{"id":"semetey-1-2013:p1117:b003:l008","ordinal":161406,"en":"And weighed out six."},{"id":"semetey-1-2013:p1117:b003:l009","ordinal":161407,"en":"Khan Zholoy of the Kalmyks"},{"id":"semetey-1-2013:p1117:b003:l010","ordinal":161408,"en":"Looked at the boy"},{"id":"semetey-1-2013:p1117:b003:l011","ordinal":161409,"en":"And was pleased."},{"id":"semetey-1-2013:p1117:b003:l012","ordinal":161410,"en":"For Khan Zholoy's slaughter beasts,"},{"id":"semetey-1-2013:p1117:b003:l013","ordinal":161411,"en":"He released and drove out a herd"},{"id":"semetey-1-2013:p1117:b003:l014","ordinal":161412,"en":"From Kökötöy's countless livestock."},{"id":"semetey-1-2013:p1117:b003:l015","ordinal":161413,"en":"Into brave Zholoy's hands,"},{"id":"semetey-1-2013:p1117:b003:l016","ordinal":161414,"en":"He gave six thousand wethers and a thousand mares"},{"id":"semetey-1-2013:p1117:b003:l017","ordinal":161415,"en":"For slaughter, they say."},{"id":"semetey-1-2013:p1117:b003:l018","ordinal":161416,"en":"Sugar piled like camels and cattle"},{"id":"semetey-1-2013:p1117:b003:l019","ordinal":161417,"en":"He gave them to break up, they say."},{"id":"semetey-1-2013:p1117:b003:l020","ordinal":161418,"en":"Firewood enough for six thousand camels"},{"id":"semetey-1-2013:p1117:b003:l021","ordinal":161419,"en":"He gave them to burn, they say."},{"id":"semetey-1-2013:p1117:b003:l022","ordinal":161420,"en":"Black liquor brought in loads,"},{"id":"semetey-1-2013:p1117:b003:l023","ordinal":161421,"en":"And liquor in Kalmyk leather flasks,"},{"id":"semetey-1-2013:p1117:b003:l024","ordinal":161422,"en":"From the days when trouble first arose,"},{"id":"semetey-1-2013:p1117:b003:l025","ordinal":161423,"en":"Kökötöy's son Bokmurun"},{"id":"semetey-1-2013:p1117:b003:l026","ordinal":161424,"en":"Had prepared beforehand."},{"id":"semetey-1-2013:p1117:b003:l027","ordinal":161425,"en":"Six zhaga measures and one leather flask"},{"id":"semetey-1-2013:p1117:b003:l028","ordinal":161426,"en":"He gave them for drink, they say."},{"id":"semetey-1-2013:p1117:b003:l029","ordinal":161427,"en":"All the wealth in the world"},{"id":"semetey-1-2013:p1117:b003:l030","ordinal":161428,"en":"He cast into the very center, they say."},{"id":"semetey-1-2013:p1117:b003:l031","ordinal":161429,"en":"He put Zholoy's heart at ease"},{"id":"semetey-1-2013:p1117:b003:l032","ordinal":161430,"en":"And, with his great army, settled Zholoy"},{"id":"semetey-1-2013:p1117:b003:l033","ordinal":161431,"en":"Against the foot of the hill, they say."},{"id":"semetey-1-2013:p1117:b003:l034","ordinal":161432,"en":"Let us leave this matter here"},{"id":"semetey-1-2013:p1117:b003:l035","ordinal":161433,"en":"And begin from the other side."},{"id":"semetey-1-2013:p1117:b003:l036","ordinal":161434,"en":"There was yet another spectacle."},{"id":"semetey-1-2013:p1117:b003:l037","ordinal":161435,"en":"Then dust curled into the sky;"},{"id":"semetey-1-2013:p1117:b003:l038","ordinal":161436,"en":"The great army that came covering the land"},{"id":"semetey-1-2013:p1117:b003:l039","ordinal":161437,"en":"Collided with one another,"},{"id":"semetey-1-2013:p1117:b004:l001","ordinal":161438,"en":"Drawing back and standing fast."},{"id":"semetey-1-2013:p1117:b004:l002","ordinal":161439,"en":"The great army that came to the feast"},{"id":"semetey-1-2013:p1117:b004:l003","ordinal":161440,"en":"Knew no human language at all,"},{"id":"semetey-1-2013:p1117:b004:l004","ordinal":161441,"en":"And quarreled in Shibee speech."},{"id":"semetey-1-2013:p1117:b004:l005","ordinal":161442,"en":"Their spears held ready,"},{"id":"semetey-1-2013:p1117:b004:l006","ordinal":161443,"en":"The Shibee people were a strange sight,"},{"id":"semetey-1-2013:p1117:b004:l007","ordinal":161444,"en":"Their swords belted on without scabbards."},{"id":"semetey-1-2013:p1117:b004:l008","ordinal":161445,"en":"They walked in swaying rows,"},{"id":"semetey-1-2013:p1117:b004:l009","ordinal":161446,"en":"Tying dirty black kerchiefs"},{"id":"semetey-1-2013:p1117:b004:l010","ordinal":161447,"en":"At the napes of their necks."},{"id":"semetey-1-2013:p1117:b004:l011","ordinal":161448,"en":"They dressed in the Shibee manner,"},{"id":"semetey-1-2013:p1117:b004:l012","ordinal":161449,"en":"Fashioned spears from reeds,"},{"id":"semetey-1-2013:p1117:b004:l013","ordinal":161450,"en":"And each man tied at his side"},{"id":"semetey-1-2013:p1117:b004:l014","ordinal":161451,"en":"A club as large as a fist."},{"id":"semetey-1-2013:p1117:b004:l015","ordinal":161452,"en":"When they roared, their speech could not be understood;"},{"id":"semetey-1-2013:p1117:b004:l016","ordinal":161453,"en":"They shouted at one another in Shibee."},{"id":"semetey-1-2013:p1117:b004:l017","ordinal":161454,"en":"They caught and ate badgers,"},{"id":"semetey-1-2013:p1117:b004:l018","ordinal":161455,"en":"And ate frogs and snakes alike."},{"id":"semetey-1-2013:p1117:b004:l019","ordinal":161456,"en":"Calling it Khan Kökötöy's memorial feast,"},{"id":"semetey-1-2013:p1117:b004:l020","ordinal":161457,"en":"The great mass of Shibee grew excited"},{"id":"semetey-1-2013:p1117:b004:l021","ordinal":161458,"en":"And covered the land."},{"id":"semetey-1-2013:p1117:b004:l022","ordinal":161459,"en":"Orokkyr, khan of the Shibee,"},{"id":"semetey-1-2013:p1117:b004:l023","ordinal":161460,"en":"Raged upon Kongkulboz;"},{"id":"semetey-1-2013:p1117:b004:l024","ordinal":161461,"en":"If you had seen him then,"},{"id":"semetey-1-2013:p1117:b004:l025","ordinal":161462,"en":"He was prepared in all his gear."},{"id":"semetey-1-2013:p1117:b004:l026","ordinal":161463,"en":"The sight divided one's attention;"},{"id":"semetey-1-2013:p1117:b004:l027","ordinal":161464,"en":"If you saw the Shibee people,"},{"id":"semetey-1-2013:p1117:b004:l028","ordinal":161465,"en":"They poured forth like ants."},{"id":"semetey-1-2013:p1117:b004:l029","ordinal":161466,"en":"He made Kongkulboz buck,"},{"id":"semetey-1-2013:p1117:b004:l030","ordinal":161467,"en":"Made it rear and wrench itself free."},{"id":"semetey-1-2013:p1117:b004:l031","ordinal":161468,"en":"Twelve targets ahead,"},{"id":"semetey-1-2013:p1117:b004:l032","ordinal":161469,"en":"He separated himself from the Shibee;"},{"id":"semetey-1-2013:p1117:b004:l033","ordinal":161470,"en":"Then his figure"},{"id":"semetey-1-2013:p1117:b004:l034","ordinal":161471,"en":"Looked like a naked blade."},{"id":"semetey-1-2013:p1117:b004:l035","ordinal":161472,"en":"Seven standard-banners came;"},{"id":"semetey-1-2013:p1117:b004:l036","ordinal":161473,"en":"A din that split the earth came."},{"id":"semetey-1-2013:p1117:b004:l037","ordinal":161474,"en":"Five times worse than before,"},{"id":"semetey-1-2013:p1117:b004:l038","ordinal":161475,"en":"An army that bent the earth came;"},{"id":"semetey-1-2013:p1117:b004:l039","ordinal":161476,"en":"When they saw such a host,"},{"id":"semetey-1-2013:p1118:b003:l001","ordinal":161477,"en":"Anguish struck the Muslims."},{"id":"semetey-1-2013:p1118:b003:l002","ordinal":161478,"en":"The dear people, who had never seen such a thing,"},{"id":"semetey-1-2013:p1118:b003:l003","ordinal":161479,"en":"Their temples drawn tight,"},{"id":"semetey-1-2013:p1118:b003:l004","ordinal":161480,"en":"Could find no composure"},{"id":"semetey-1-2013:p1118:b003:l005","ordinal":161481,"en":"And quarreled with their leader."},{"id":"semetey-1-2013:p1118:b003:l006","ordinal":161482,"en":"They stamped the ground where they stood,"},{"id":"semetey-1-2013:p1118:b003:l007","ordinal":161483,"en":"Each blaming another."},{"id":"semetey-1-2013:p1118:b003:l008","ordinal":161484,"en":"“We were a people living at ease;"},{"id":"semetey-1-2013:p1118:b003:l009","ordinal":161485,"en":"Have we now met disaster?"},{"id":"semetey-1-2013:p1118:b003:l010","ordinal":161486,"en":"Coming thoughtlessly to this feast,"},{"id":"semetey-1-2013:p1118:b003:l011","ordinal":161487,"en":"Have we suffered this humiliation"},{"id":"semetey-1-2013:p1118:b003:l012","ordinal":161488,"en":"From Kökötöy's bastard Bokmurun?"},{"id":"semetey-1-2013:p1118:b003:l013","ordinal":161489,"en":"Kökötöy's son Bokmurun"},{"id":"semetey-1-2013:p1118:b003:l014","ordinal":161490,"en":"Had an extraordinary design;"},{"id":"semetey-1-2013:p1118:b003:l015","ordinal":161491,"en":"He is the son Khan Kökötöy"},{"id":"semetey-1-2013:p1118:b003:l016","ordinal":161492,"en":"Found through grief."},{"id":"semetey-1-2013:p1118:b003:l017","ordinal":161493,"en":"Gathering people like ants,"},{"id":"semetey-1-2013:p1118:b003:l018","ordinal":161494,"en":"He has cast us into turmoil."},{"id":"semetey-1-2013:p1118:b003:l019","ordinal":161495,"en":"The tale would never end"},{"id":"semetey-1-2013:p1118:b003:l020","ordinal":161496,"en":"Of the strange peoples who have come."},{"id":"semetey-1-2013:p1118:b003:l021","ordinal":161497,"en":"May God strike these Shibee!"},{"id":"semetey-1-2013:p1118:b003:l022","ordinal":161498,"en":"Perhaps they will charge with spears"},{"id":"semetey-1-2013:p1118:b003:l023","ordinal":161499,"en":"And slaughter every one of us."},{"id":"semetey-1-2013:p1118:b003:l024","ordinal":161500,"en":"We came to see"},{"id":"semetey-1-2013:p1118:b003:l025","ordinal":161501,"en":"Kökötöy's great memorial feast;"},{"id":"semetey-1-2013:p1118:b003:l026","ordinal":161502,"en":"After suffering great disaster from the Chinese,"},{"id":"semetey-1-2013:p1118:b003:l027","ordinal":161503,"en":"It seems we have come here to die!"},{"id":"semetey-1-2013:p1118:b003:l028","ordinal":161504,"en":"When nine wolves fall upon sheep,"},{"id":"semetey-1-2013:p1118:b003:l029","ordinal":161505,"en":"Will they leave even the carcasses?"},{"id":"semetey-1-2013:p1118:b003:l030","ordinal":161506,"en":"When the surging Chinese beat these people,"},{"id":"semetey-1-2013:p1118:b003:l031","ordinal":161507,"en":"Will they leave even their carcasses?"},{"id":"semetey-1-2013:p1118:b003:l032","ordinal":161508,"en":"We came to witness"},{"id":"semetey-1-2013:p1118:b003:l033","ordinal":161509,"en":"The service of Köpkölöng;"},{"id":"semetey-1-2013:p1118:b003:l034","ordinal":161510,"en":"It seems we came to die"},{"id":"semetey-1-2013:p1118:b003:l035","ordinal":161511,"en":"At the hands of Kalmyks covering the earth."},{"id":"semetey-1-2013:p1118:b003:l036","ordinal":161512,"en":"If they charge without restraint,"},{"id":"semetey-1-2013:p1118:b003:l037","ordinal":161513,"en":"We will all meet our end together;"},{"id":"semetey-1-2013:p1118:b003:l038","ordinal":161514,"en":"Will they not slaughter us to the last?"},{"id":"semetey-1-2013:p1118:b003:l039","ordinal":161515,"en":"We ate no feast but ate stones;"},{"id":"semetey-1-2013:p1118:b004:l001","ordinal":161516,"en":"We ate no celebration but ate bullets."},{"id":"semetey-1-2013:p1118:b004:l002","ordinal":161517,"en":"If these Kalmyks attack together,"},{"id":"semetey-1-2013:p1118:b004:l003","ordinal":161518,"en":"They will all draw their bows;"},{"id":"semetey-1-2013:p1118:b004:l004","ordinal":161519,"en":"After slaughtering us all,"},{"id":"semetey-1-2013:p1118:b004:l005","ordinal":161520,"en":"They will sing their victory song."},{"id":"semetey-1-2013:p1118:b004:l006","ordinal":161521,"en":"Leaving none of us unharmed,"},{"id":"semetey-1-2013:p1118:b004:l007","ordinal":161522,"en":"They will take us as plunder."},{"id":"semetey-1-2013:p1118:b004:l008","ordinal":161523,"en":"They will bring hardship upon us together;"},{"id":"semetey-1-2013:p1118:b004:l009","ordinal":161524,"en":"They will slaughter every one of us!"},{"id":"semetey-1-2013:p1118:b004:l010","ordinal":161525,"en":"This is a glassy, open plain;"},{"id":"semetey-1-2013:p1118:b004:l011","ordinal":161526,"en":"There is no ridge to flee toward."},{"id":"semetey-1-2013:p1118:b004:l012","ordinal":161527,"en":"When we suffer calamity,"},{"id":"semetey-1-2013:p1118:b004:l013","ordinal":161528,"en":"The renowned lion Manas is not here"},{"id":"semetey-1-2013:p1118:b004:l014","ordinal":161529,"en":"To separate and rescue us."},{"id":"semetey-1-2013:p1118:b004:l015","ordinal":161530,"en":"There is no Talas to flee back upon;"},{"id":"semetey-1-2013:p1118:b004:l016","ordinal":161531,"en":"If they clash and fight,"},{"id":"semetey-1-2013:p1118:b004:l017","ordinal":161532,"en":"Princely Manas the leopard is not here"},{"id":"semetey-1-2013:p1118:b004:l018","ordinal":161533,"en":"To separate and rescue us.”"},{"id":"semetey-1-2013:p1118:b004:l019","ordinal":161534,"en":"The Muslims sighed and grieved,"},{"id":"semetey-1-2013:p1118:b004:l020","ordinal":161535,"en":"Overwhelmed"},{"id":"semetey-1-2013:p1118:b004:l021","ordinal":161536,"en":"And despairing of their entrusted lives."}]
