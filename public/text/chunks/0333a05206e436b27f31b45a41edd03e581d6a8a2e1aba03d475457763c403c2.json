[{"id":"manas-2010:p1147:b001:l032","ordinal":49921,"en":"Fleeing the unbelievers, becoming a stranger to them,"},{"id":"manas-2010:p1147:b001:l033","ordinal":49922,"en":"My beloved foal,"},{"id":"manas-2010:p1147:b001:l034","ordinal":49923,"en":"When I heard your news,"},{"id":"manas-2010:p1147:b001:l035","ordinal":49924,"en":"When you fled out of Beijing,"},{"id":"manas-2010:p1147:b001:l036","ordinal":49925,"en":"‘He entered Kangay,’ I heard."},{"id":"manas-2010:p1147:b001:l037","ordinal":49926,"en":"Shattering the khan of Kangay,"},{"id":"manas-2010:p1147:b001:l038","ordinal":49927,"en":"‘He descended to Altay,’ I heard."},{"id":"manas-2010:p1147:b001:l039","ordinal":49928,"en":"Making Altay's people weep,"},{"id":"manas-2010:p1147:b001:l040","ordinal":49929,"en":"Making their daughters and wives cry out,"},{"id":"manas-2010:p1147:b001:l041","ordinal":49930,"en":"Passing on from there, my foal,"},{"id":"manas-2010:p1147:b001:l042","ordinal":49931,"en":"‘He came to Kökchö,’ I heard."},{"id":"manas-2010:p1148:b001:l001","ordinal":49932,"en":"Kökchö of the Kazakhs,"},{"id":"manas-2010:p1148:b001:l002","ordinal":49933,"en":"‘He besieged him,’ I heard."},{"id":"manas-2010:p1148:b001:l003","ordinal":49934,"en":"With blows cracking in the open country,"},{"id":"manas-2010:p1148:b001:l004","ordinal":49935,"en":"‘He beat him,’ I heard."},{"id":"manas-2010:p1148:b001:l005","ordinal":49936,"en":"Golden forelock, tasseled sash,"},{"id":"manas-2010:p1148:b001:l006","ordinal":49937,"en":"Azizkan's only son,"},{"id":"manas-2010:p1148:b001:l007","ordinal":49938,"en":"Though we have not seen or known one another,"},{"id":"manas-2010:p1148:b001:l008","ordinal":49939,"en":"Have you remained safe and sound?"},{"id":"manas-2010:p1148:b001:l009","ordinal":49940,"en":"Come, give me your hand!”"},{"id":"manas-2010:p1148:b001:l010","ordinal":49941,"en":"Saying this, Khan Bakay"},{"id":"manas-2010:p1148:b001:l011","ordinal":49942,"en":"Stood clasping my hand."},{"id":"manas-2010:p1148:b001:l012","ordinal":49943,"en":"“Stay with us today,” he said,"},{"id":"manas-2010:p1148:b001:l013","ordinal":49944,"en":"“Be our guest,” he said."},{"id":"manas-2010:p1148:b001:l014","ordinal":49945,"en":"“Until dawn breaks clear,"},{"id":"manas-2010:p1148:b001:l015","ordinal":49946,"en":"Until the Scales stars set,"},{"id":"manas-2010:p1148:b001:l016","ordinal":49947,"en":"Let us plunge into conversation,"},{"id":"manas-2010:p1148:b001:l017","ordinal":49948,"en":"Let us enjoy ourselves,”"},{"id":"manas-2010:p1148:b001:l018","ordinal":49949,"en":"Said Khan Bakay then."},{"id":"manas-2010:p1148:b001:l019","ordinal":49950,"en":"Taking the direct way,"},{"id":"manas-2010:p1148:b001:l020","ordinal":49951,"en":"Grasping firmly by the bit,"},{"id":"manas-2010:p1148:b001:l021","ordinal":49952,"en":"Leading Sarala,"},{"id":"manas-2010:p1148:b001:l022","ordinal":49953,"en":"He brought me into the mansion."},{"id":"manas-2010:p1148:b001:l023","ordinal":49954,"en":"Doors of iron and solid tin,"},{"id":"manas-2010:p1148:b001:l024","ordinal":49955,"en":"In her girlhood Kanykey"},{"id":"manas-2010:p1148:b001:l025","ordinal":49956,"en":"Had it built at great expense,"},{"id":"manas-2010:p1148:b001:l026","ordinal":49957,"en":"Astonishing many people,"},{"id":"manas-2010:p1148:b001:l027","ordinal":49958,"en":"That great mansion in Bukhara."},{"id":"manas-2010:p1148:b001:l028","ordinal":49959,"en":"When I entered that mansion,"},{"id":"manas-2010:p1148:b001:l029","ordinal":49960,"en":"Its posts were driven in place."},{"id":"manas-2010:p1148:b001:l030","ordinal":49961,"en":"When I went into the mansion,"},{"id":"manas-2010:p1148:b001:l031","ordinal":49962,"en":"All wore black caps;"},{"id":"manas-2010:p1148:b001:l032","ordinal":49963,"en":"Their valor seemed exceptional."},{"id":"manas-2010:p1148:b001:l033","ordinal":49964,"en":"All were lords, of noble stock."},{"id":"manas-2010:p1148:b001:l034","ordinal":49965,"en":"Thirty young men from among them"},{"id":"manas-2010:p1148:b001:l035","ordinal":49966,"en":"Came running up."},{"id":"manas-2010:p1148:b001:l036","ordinal":49967,"en":"From atop Sarala"},{"id":"manas-2010:p1148:b001:l037","ordinal":49968,"en":"They lifted me straight off."},{"id":"manas-2010:p1148:b001:l038","ordinal":49969,"en":"To a tethering rail wrought of iron,"},{"id":"manas-2010:p1148:b001:l039","ordinal":49970,"en":"That courser Sarala,"},{"id":"manas-2010:p1148:b001:l040","ordinal":49971,"en":"They tied him high."},{"id":"manas-2010:p1148:b001:l041","ordinal":49972,"en":"Into a house beyond,"},{"id":"manas-2010:p1148:b001:l042","ordinal":49973,"en":"Khan Bakay of sacred power"},{"id":"manas-2010:p1149:b001:l001","ordinal":49974,"en":"Brought me inside."},{"id":"manas-2010:p1149:b001:l002","ordinal":49975,"en":"The tablecloth was spread;"},{"id":"manas-2010:p1149:b001:l003","ordinal":49976,"en":"Many kinds of food"},{"id":"manas-2010:p1149:b001:l004","ordinal":49977,"en":"All stood laid out."},{"id":"manas-2010:p1149:b001:l005","ordinal":49978,"en":"Then your blue-maned Bakay"},{"id":"manas-2010:p1149:b001:l006","ordinal":49979,"en":"Began with conversation."},{"id":"manas-2010:p1149:b001:l007","ordinal":49980,"en":"The meat of fat lamb and yearling horse,"},{"id":"manas-2010:p1149:b001:l008","ordinal":49981,"en":"He had boiled sweet as honey."},{"id":"manas-2010:p1149:b001:l009","ordinal":49982,"en":"Until the cloth was cleared,"},{"id":"manas-2010:p1149:b001:l010","ordinal":49983,"en":"Until I had eaten my fill,"},{"id":"manas-2010:p1149:b001:l011","ordinal":49984,"en":"Did you see his grace?"},{"id":"manas-2010:p1149:b001:l012","ordinal":49985,"en":"Dear princely Bakay,"},{"id":"manas-2010:p1149:b001:l013","ordinal":49986,"en":"He did not ask my story."},{"id":"manas-2010:p1149:b001:l014","ordinal":49987,"en":"When they cleared the tablecloth,"},{"id":"manas-2010:p1149:b001:l015","ordinal":49988,"en":"And when they gave the blessing,"},{"id":"manas-2010:p1149:b001:l016","ordinal":49989,"en":"I saw beauties among women,"},{"id":"manas-2010:p1149:b001:l017","ordinal":49990,"en":"I saw some forty lovely girls."},{"id":"manas-2010:p1149:b001:l018","ordinal":49991,"en":"The beauty of dark complexion,"},{"id":"manas-2010:p1149:b001:l019","ordinal":49992,"en":"When I looked before the girls,"},{"id":"manas-2010:p1149:b001:l020","ordinal":49993,"en":"The radiant one among women,"},{"id":"manas-2010:p1149:b001:l021","ordinal":49994,"en":"Her face red as henna,"},{"id":"manas-2010:p1149:b001:l022","ordinal":49995,"en":"Khan Manas's Kanykey,"},{"id":"manas-2010:p1149:b001:l023","ordinal":49996,"en":"Her age having reached nineteen,"},{"id":"manas-2010:p1149:b001:l024","ordinal":49997,"en":"A young wife of beautiful bearing,"},{"id":"manas-2010:p1149:b001:l025","ordinal":49998,"en":"A yearling horse suckled by a barren mare, a young camel,"},{"id":"manas-2010:p1149:b001:l026","ordinal":49999,"en":"She had them slaughtered,"},{"id":"manas-2010:p1149:b001:l027","ordinal":50000,"en":"Delicious, sweet food,"},{"id":"manas-2010:p1149:b001:l028","ordinal":50001,"en":"She had gathered from Bukhara."},{"id":"manas-2010:p1149:b001:l029","ordinal":50002,"en":"Into a bowl made of gold,"},{"id":"manas-2010:p1149:b001:l030","ordinal":50003,"en":"Every kind of delicacy,"},{"id":"manas-2010:p1149:b001:l031","ordinal":50004,"en":"She had placed and brought covered."},{"id":"manas-2010:p1149:b001:l032","ordinal":50005,"en":"Aruuke, daughter of Agynay in Bukhara,"},{"id":"manas-2010:p1149:b001:l033","ordinal":50006,"en":"Her close younger sister,"},{"id":"manas-2010:p1149:b001:l034","ordinal":50007,"en":"She had bring the meat."},{"id":"manas-2010:p1149:b001:l035","ordinal":50008,"en":"Soft, rounded black eyes,"},{"id":"manas-2010:p1149:b001:l036","ordinal":50009,"en":"She came presenting a gift."},{"id":"manas-2010:p1149:b001:l037","ordinal":50010,"en":"“This is your lifelong mate,” she said."},{"id":"manas-2010:p1149:b001:l038","ordinal":50011,"en":"Seventeen-year-old Aruuke,"},{"id":"manas-2010:p1149:b001:l039","ordinal":50012,"en":"Bringing her before me,"},{"id":"manas-2010:p1149:b001:l040","ordinal":50013,"en":"Nobly born Kanykey"},{"id":"manas-2010:p1149:b001:l041","ordinal":50014,"en":"Came presenting her:"},{"id":"manas-2010:p1149:b001:l042","ordinal":50015,"en":"“Almambet, son of Azizkan,"},{"id":"manas-2010:p1150:b001:l001","ordinal":50016,"en":"My lion, hear my words,” she said."},{"id":"manas-2010:p1150:b001:l002","ordinal":50017,"en":"“To go arm in arm,"},{"id":"manas-2010:p1150:b001:l003","ordinal":50018,"en":"To journey together,"},{"id":"manas-2010:p1150:b001:l004","ordinal":50019,"en":"She is your equal for life,” she said."},{"id":"manas-2010:p1150:b001:l005","ordinal":50020,"en":"“Oh, son, do not let your heart turn away."},{"id":"manas-2010:p1150:b001:l006","ordinal":50021,"en":"‘Offering girls to whoever appears,"},{"id":"manas-2010:p1150:b001:l007","ordinal":50022,"en":"What remarkable people,’ do not say,"},{"id":"manas-2010:p1150:b001:l008","ordinal":50023,"en":"Do not think ill of us.”"},{"id":"manas-2010:p1150:b001:l009","ordinal":50024,"en":"After these words were spoken,"},{"id":"manas-2010:p1150:b001:l010","ordinal":50025,"en":"Agynay's daughter Aruuke,"},{"id":"manas-2010:p1150:b001:l011","ordinal":50026,"en":"What she wore upon her head"},{"id":"manas-2010:p1150:b001:l012","ordinal":50027,"en":"Was a skullcap made of gold."},{"id":"manas-2010:p1150:b001:l013","ordinal":50028,"en":"In love with me from the beginning,"},{"id":"manas-2010:p1150:b001:l014","ordinal":50029,"en":"Unable to reach me, poor girl."},{"id":"manas-2010:p1150:b001:l015","ordinal":50030,"en":"Her heart filled,"},{"id":"manas-2010:p1150:b001:l016","ordinal":50031,"en":"Her ribbon waist moving lightly,"},{"id":"manas-2010:p1150:b001:l017","ordinal":50032,"en":"Upon my right knee"},{"id":"manas-2010:p1150:b001:l018","ordinal":50033,"en":"She came and sat down."},{"id":"manas-2010:p1150:b001:l019","ordinal":50034,"en":"Entrusting her deed to God,"},{"id":"manas-2010:p1150:b001:l020","ordinal":50035,"en":"To Mazhik beside me,"},{"id":"manas-2010:p1150:b001:l021","ordinal":50036,"en":"Kölöy's daughter Köönökan,"},{"id":"manas-2010:p1150:b001:l022","ordinal":50037,"en":"She came presenting her."},{"id":"manas-2010:p1150:b001:l023","ordinal":50038,"en":"Before even that much time had passed,"},{"id":"manas-2010:p1150:b001:l024","ordinal":50039,"en":"Noble Sultan Khan Bakay"},{"id":"manas-2010:p1150:b001:l025","ordinal":50040,"en":"Six pious elders, four spiritual masters,"},{"id":"manas-2010:p1150:b001:l026","ordinal":50041,"en":"Had ready."},{"id":"manas-2010:p1150:b001:l027","ordinal":50042,"en":"Bakay gathered the pious elders,"},{"id":"manas-2010:p1150:b001:l028","ordinal":50043,"en":"Had verses recited from the Quran,"},{"id":"manas-2010:p1150:b001:l029","ordinal":50044,"en":"And at noon performed the marriage rite."},{"id":"manas-2010:p1150:b001:l030","ordinal":50045,"en":"Kanykey on my right,"},{"id":"manas-2010:p1150:b001:l031","ordinal":50046,"en":"Khan Bakay on my left,"},{"id":"manas-2010:p1150:b001:l032","ordinal":50047,"en":"Seating me between them,"},{"id":"manas-2010:p1150:b001:l033","ordinal":50048,"en":"They asked me for an account."},{"id":"manas-2010:p1150:b001:l034","ordinal":50049,"en":"The turmoil from the beginning,"},{"id":"manas-2010:p1150:b001:l035","ordinal":50050,"en":"I told them then,"},{"id":"manas-2010:p1150:b001:l036","ordinal":50051,"en":"Lion Manas, my blue-maned one,"},{"id":"manas-2010:p1150:b001:l037","ordinal":50052,"en":"The story I have told you here."},{"id":"manas-2010:p1150:b001:l038","ordinal":50053,"en":"When she heard the story,"},{"id":"manas-2010:p1150:b001:l039","ordinal":50054,"en":"My friend's fiery wife Kanykey"},{"id":"manas-2010:p1150:b001:l040","ordinal":50055,"en":"Stood wailing and sobbing."},{"id":"manas-2010:p1150:b001:l041","ordinal":50056,"en":"“Do not tell Manas,” she said,"},{"id":"manas-2010:p1150:b001:l042","ordinal":50057,"en":"Weeping and crying out,"},{"id":"manas-2010:p1151:b001:l002","ordinal":50058,"en":"Its champions beyond all counting,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"manas-2010:p1151:b001:l003","ordinal":50059,"en":"The Chinese realm's Beijing"},{"id":"manas-2010:p1151:b001:l004","ordinal":50060,"en":"Lies beyond the strength of lions."},{"id":"manas-2010:p1151:b001:l005","ordinal":50061,"en":"Let the lion, the blue-maned leopard,"},{"id":"manas-2010:p1151:b001:l006","ordinal":50062,"en":"Not gather the twelve khans;"},{"id":"manas-2010:p1151:b001:l007","ordinal":50063,"en":"Let there be no great campaign."},{"id":"manas-2010:p1151:b001:l008","ordinal":50064,"en":"From the whole Kyrgyz people,"},{"id":"manas-2010:p1151:b001:l009","ordinal":50065,"en":"Let him not have them utterly slaughtered."},{"id":"manas-2010:p1151:b001:l010","ordinal":50066,"en":"If you reveal your secret,"},{"id":"manas-2010:p1151:b001:l011","ordinal":50067,"en":"Our dear people, small as a palm,"},{"id":"manas-2010:p1151:b001:l012","ordinal":50068,"en":"Must not perish needlessly."},{"id":"manas-2010:p1151:b001:l013","ordinal":50069,"en":"Let me tell their number."},{"id":"manas-2010:p1151:b001:l014","ordinal":50070,"en":"If I count those of former times,"},{"id":"manas-2010:p1151:b001:l015","ordinal":50071,"en":"How many khans' peoples were there?"},{"id":"manas-2010:p1151:b001:l016","ordinal":50072,"en":"If you count them this very day,"},{"id":"manas-2010:p1151:b001:l017","ordinal":50073,"en":"There are the peoples of twelve khans."},{"id":"manas-2010:p1151:b001:l018","ordinal":50074,"en":"The few people of those twelve khans,"},{"id":"manas-2010:p1151:b001:l019","ordinal":50075,"en":"The noble blue-maned Khan Manas"},{"id":"manas-2010:p1151:b001:l020","ordinal":50076,"en":"Must not gather and drive away."},{"id":"manas-2010:p1151:b001:l021","ordinal":50077,"en":"Driving them to Beijing,"},{"id":"manas-2010:p1151:b001:l022","ordinal":50078,"en":"He must not have them utterly slaughtered.”"},{"id":"manas-2010:p1151:b001:l023","ordinal":50079,"en":"To Prince Bakay,"},{"id":"manas-2010:p1151:b001:l024","ordinal":50080,"en":"Holding a twig, I swore"},{"id":"manas-2010:p1151:b001:l025","ordinal":50081,"en":"Not to tell the circumstances of Beijing."},{"id":"manas-2010:p1151:b001:l026","ordinal":50082,"en":"In this fleeting, false world,"},{"id":"manas-2010:p1151:b001:l027","ordinal":50083,"en":"Khan Manas, what you said is also true."},{"id":"manas-2010:p1151:b001:l028","ordinal":50084,"en":"When we lately brought humiliation upon Kokon,"},{"id":"manas-2010:p1151:b001:l029","ordinal":50085,"en":"When Margalang and Samarkand"},{"id":"manas-2010:p1151:b001:l030","ordinal":50086,"en":"We conquered, every one,"},{"id":"manas-2010:p1151:b001:l031","ordinal":50087,"en":"We took gold coins loaded on elephants;"},{"id":"manas-2010:p1151:b001:l032","ordinal":50088,"en":"We took a thousand dark-eyed captives."},{"id":"manas-2010:p1151:b001:l033","ordinal":50089,"en":"“Tell me about Beijing,”"},{"id":"manas-2010:p1151:b001:l034","ordinal":50090,"en":"You kept pressing me."},{"id":"manas-2010:p1151:b001:l035","ordinal":50091,"en":"“I do not know Beijing,” I said,"},{"id":"manas-2010:p1151:b001:l036","ordinal":50092,"en":"And there too I swore an oath."},{"id":"manas-2010:p1151:b001:l037","ordinal":50093,"en":"That I said, “I have not seen Beijing,”"},{"id":"manas-2010:p1151:b001:l038","ordinal":50094,"en":"Is also true."},{"id":"manas-2010:p1151:b001:l039","ordinal":50095,"en":"Far from merely seeing Beijing,"},{"id":"manas-2010:p1151:b001:l040","ordinal":50096,"en":"I was born and raised there;"},{"id":"manas-2010:p1151:b001:l041","ordinal":50097,"en":"It is true that I came from there."},{"id":"manas-2010:p1151:b001:l042","ordinal":50098,"en":"Speeding on Sarala,"},{"id":"manas-2010:p1152:b001:l001","ordinal":50099,"en":"It is also true that I rode away."},{"id":"manas-2010:p1152:b001:l002","ordinal":50100,"en":"Because of the afterlife,"},{"id":"manas-2010:p1152:b001:l003","ordinal":50101,"en":"Because there is a hell of torment,"},{"id":"manas-2010:p1152:b001:l004","ordinal":50102,"en":"From my land, from my people,"},{"id":"manas-2010:p1152:b001:l005","ordinal":50103,"en":"It is also true that I wandered away."},{"id":"manas-2010:p1152:b001:l006","ordinal":50104,"en":"Now, Manas, hear my words."},{"id":"manas-2010:p1152:b001:l007","ordinal":50105,"en":"Forked passes and difficult roads—"},{"id":"manas-2010:p1152:b001:l008","ordinal":50106,"en":"Your Almambet has not feared to cross them."},{"id":"manas-2010:p1152:b001:l009","ordinal":50107,"en":"Darkly looming Beijing,"},{"id":"manas-2010:p1152:b001:l010","ordinal":50108,"en":"Tens of thousands of monks—"},{"id":"manas-2010:p1152:b001:l011","ordinal":50109,"en":"Your Almambet has not feared to attack them."},{"id":"manas-2010:p1152:b001:l012","ordinal":50110,"en":"Setting the border apart,"},{"id":"manas-2010:p1152:b001:l013","ordinal":50111,"en":"Your Almambet has not feared to divide the land."},{"id":"manas-2010:p1152:b001:l014","ordinal":50112,"en":"Not Outer Beijing, but Beijing's very heart,"},{"id":"manas-2010:p1152:b001:l015","ordinal":50113,"en":"Shattering it into pieces,"},{"id":"manas-2010:p1152:b001:l016","ordinal":50114,"en":"Your Almambet has not feared to die."},{"id":"manas-2010:p1152:b001:l017","ordinal":50115,"en":"If my strength suffices, I shall break their ranks."},{"id":"manas-2010:p1152:b001:l018","ordinal":50116,"en":"If my appointed death comes, what can I do?"},{"id":"manas-2010:p1152:b001:l019","ordinal":50117,"en":"I shall not turn back and leave;"},{"id":"manas-2010:p1152:b001:l020","ordinal":50118,"en":"I shall fall to a bullet in Beijing's heart."},{"id":"manas-2010:p1152:b001:l021","ordinal":50119,"en":"The reason I would fall to a bullet:"},{"id":"manas-2010:p1152:b001:l022","ordinal":50120,"en":"The place where I took off and washed my shirt,"},{"id":"manas-2010:p1152:b001:l023","ordinal":50121,"en":"The place where my umbilical cord was tied,"},{"id":"manas-2010:p1152:b001:l024","ordinal":50122,"en":"Not only your Almambet,"},{"id":"manas-2010:p1152:b001:l025","ordinal":50123,"en":"But sixty of my forefathers were born there."},{"id":"manas-2010:p1152:b001:l026","ordinal":50124,"en":"If I should happen to die,"},{"id":"manas-2010:p1152:b001:l027","ordinal":50125,"en":"My nine thousand horses in the mountains—"},{"id":"manas-2010:p1152:b001:l028","ordinal":50126,"en":"Gather my horses, Manas."},{"id":"manas-2010:p1152:b001:l029","ordinal":50127,"en":"My wedded wife Aruuke,"},{"id":"manas-2010:p1152:b001:l030","ordinal":50128,"en":"If my death comes and I die,"},{"id":"manas-2010:p1152:b001:l031","ordinal":50129,"en":"Give her in marriage to Mazhik."},{"id":"manas-2010:p1152:b001:l032","ordinal":50130,"en":"My horses on the hills have mottled heads,"},{"id":"manas-2010:p1152:b001:l033","ordinal":50131,"en":"Fine steeds and swift racers mingled."},{"id":"manas-2010:p1152:b001:l034","ordinal":50132,"en":"The choice steeds and runners are all well fed."},{"id":"manas-2010:p1152:b001:l035","ordinal":50133,"en":"In this faithless, false world,"},{"id":"manas-2010:p1152:b001:l036","ordinal":50134,"en":"I have no son to come after me."},{"id":"manas-2010:p1152:b001:l037","ordinal":50135,"en":"Clearly, a steed has no understanding,"},{"id":"manas-2010:p1152:b001:l038","ordinal":50136,"en":"After I have passed away,"},{"id":"manas-2010:p1152:b001:l039","ordinal":50137,"en":"Even a single hoof remaining behind me"},{"id":"manas-2010:p1152:b001:l040","ordinal":50138,"en":"Will have no master to gather it."},{"id":"manas-2010:p1152:b001:l041","ordinal":50139,"en":"This world is full of bitter regret;"},{"id":"manas-2010:p1152:b001:l042","ordinal":50140,"en":"There is no choice but to bear it."},{"id":"manas-2010:p1153:b001:l001","ordinal":50141,"en":"Not before me, but coming after me,"},{"id":"manas-2010:p1153:b001:l002","ordinal":50142,"en":"Is there anyone called my child."},{"id":"manas-2010:p1153:b001:l003","ordinal":50143,"en":"My gathered wealth, my gold and jewels—"},{"id":"manas-2010:p1153:b001:l004","ordinal":50144,"en":"If I enter Beijing and die,"},{"id":"manas-2010:p1153:b001:l005","ordinal":50145,"en":"Where might this wretched head not be left!"},{"id":"manas-2010:p1153:b001:l006","ordinal":50146,"en":"If I die without returning from Beijing,"},{"id":"manas-2010:p1153:b001:l007","ordinal":50147,"en":"Fold me firmly at the waist;"},{"id":"manas-2010:p1153:b001:l008","ordinal":50148,"en":"Do not leave my bones in Beijing."},{"id":"manas-2010:p1153:b001:l009","ordinal":50149,"en":"Load me up and bring me back this way!"},{"id":"manas-2010:p1153:b001:l010","ordinal":50150,"en":"When you reach a familiar place,"},{"id":"manas-2010:p1153:b001:l011","ordinal":50151,"en":"Dig my grave deep,"},{"id":"manas-2010:p1153:b001:l012","ordinal":50152,"en":"And bury me properly!"},{"id":"manas-2010:p1153:b001:l013","ordinal":50153,"en":"And, Manas, leopard,"},{"id":"manas-2010:p1153:b001:l014","ordinal":50154,"en":"There is something else to tell you."},{"id":"manas-2010:p1153:b001:l015","ordinal":50155,"en":"If you see Talas safely again,"},{"id":"manas-2010:p1153:b001:l016","ordinal":50156,"en":"Agynay's daughter Aruuke,"},{"id":"manas-2010:p1153:b001:l017","ordinal":50157,"en":"Unless I am mistaken, within her"},{"id":"manas-2010:p1153:b001:l018","ordinal":50158,"en":"Is a hint of pregnancy, some three months along."},{"id":"manas-2010:p1153:b001:l019","ordinal":50159,"en":"If it is a girl and not a boy,"},{"id":"manas-2010:p1153:b001:l020","ordinal":50160,"en":"Give up hope of me."},{"id":"manas-2010:p1153:b001:l021","ordinal":50161,"en":"But if it is a boy,"},{"id":"manas-2010:p1153:b001:l022","ordinal":50162,"en":"Slaughter ninety beasts for his feast;"},{"id":"manas-2010:p1153:b001:l023","ordinal":50163,"en":"Name him the champion Külchoro."},{"id":"manas-2010:p1153:b001:l024","ordinal":50164,"en":"If a boy, he will become a hero,"},{"id":"manas-2010:p1153:b001:l025","ordinal":50165,"en":"Far surpassing me;"},{"id":"manas-2010:p1153:b001:l026","ordinal":50166,"en":"He will be a lion who wields the spear."},{"id":"manas-2010:p1153:b001:l027","ordinal":50167,"en":"He will be a red-hot glowing coal."},{"id":"manas-2010:p1153:b001:l028","ordinal":50168,"en":"When he shouts and charges the foe,"},{"id":"manas-2010:p1153:b001:l029","ordinal":50169,"en":"Countless enemies will gather."},{"id":"manas-2010:p1153:b001:l030","ordinal":50170,"en":"These are my words of testament."},{"id":"manas-2010:p1153:b001:l031","ordinal":50171,"en":"Tie up the words I have spoken in your mind."},{"id":"manas-2010:p1153:b001:l032","ordinal":50172,"en":"To Beijing, whence none returns,"},{"id":"manas-2010:p1153:b001:l033","ordinal":50173,"en":"I am going on reconnaissance."},{"id":"manas-2010:p1153:b001:l034","ordinal":50174,"en":"Expect me in the third month!"},{"id":"manas-2010:p1153:b001:l035","ordinal":50175,"en":"If I am late beyond the third month,"},{"id":"manas-2010:p1153:b001:l036","ordinal":50176,"en":"Shoot wild sheep in the hills, eat, and leave."}]
