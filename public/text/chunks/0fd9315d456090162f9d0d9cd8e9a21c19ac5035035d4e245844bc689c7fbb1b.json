[{"id":"semetey-1-2013:p1230:b004:l023","ordinal":171009,"en":"Let me level my spear straight;"},{"id":"semetey-1-2013:p1230:b004:l024","ordinal":171010,"en":"Fighting in fury,"},{"id":"semetey-1-2013:p1230:b004:l025","ordinal":171011,"en":"Firing guns and drawing bows,"},{"id":"semetey-1-2013:p1230:b004:l026","ordinal":171012,"en":"Standing my ground without fleeing,"},{"id":"semetey-1-2013:p1230:b004:l027","ordinal":171013,"en":"Let me learn now the courage"},{"id":"semetey-1-2013:p1230:b004:l028","ordinal":171014,"en":"Of Toltoi, who comes to take a wife."},{"id":"semetey-1-2013:p1230:b004:l029","ordinal":171015,"en":"Seizing thundering Toltoi"},{"id":"semetey-1-2013:p1230:b004:l030","ordinal":171016,"en":"By the hem of his coat,"},{"id":"semetey-1-2013:p1230:b004:l031","ordinal":171017,"en":"Fighting each other to exhaustion,"},{"id":"semetey-1-2013:p1230:b004:l032","ordinal":171018,"en":"Fighting with courage,"},{"id":"semetey-1-2013:p1230:b004:l033","ordinal":171019,"en":"Facing Toltoi directly"},{"id":"semetey-1-2013:p1230:b004:l034","ordinal":171020,"en":"And clashing together,"},{"id":"semetey-1-2013:p1230:b004:l035","ordinal":171021,"en":"Let me make this spectacle."},{"id":"semetey-1-2013:p1230:b004:l036","ordinal":171022,"en":"Before anyone else, Toltoi—"},{"id":"semetey-1-2013:p1230:b004:l037","ordinal":171023,"en":"Akkelte, left by my father,"},{"id":"semetey-1-2013:p1230:b004:l038","ordinal":171024,"en":"Surpassingly mighty and straight,"},{"id":"semetey-1-2013:p1230:b004:l039","ordinal":171025,"en":"Let me strike him with that;"},{"id":"semetey-1-2013:p1231:b003:l001","ordinal":171026,"en":"Let me plunge into the spectacle;"},{"id":"semetey-1-2013:p1231:b003:l002","ordinal":171027,"en":"Let me strike with Akkelte."},{"id":"semetey-1-2013:p1231:b003:l003","ordinal":171028,"en":"Young marksman Kulchoro"},{"id":"semetey-1-2013:p1231:b003:l004","ordinal":171029,"en":"Poured the powder from its box"},{"id":"semetey-1-2013:p1231:b003:l005","ordinal":171030,"en":"With a rumble,"},{"id":"semetey-1-2013:p1231:b003:l006","ordinal":171031,"en":"And rammed in lead"},{"id":"semetey-1-2013:p1231:b003:l007","ordinal":171032,"en":"The size of a sheep's head."},{"id":"semetey-1-2013:p1231:b003:l008","ordinal":171033,"en":"He drove it down with the ramrod,"},{"id":"semetey-1-2013:p1231:b003:l009","ordinal":171034,"en":"Pulled back the quick-fire mechanism,"},{"id":"semetey-1-2013:p1231:b003:l010","ordinal":171035,"en":"And set the cliff-like stock"},{"id":"semetey-1-2013:p1231:b003:l011","ordinal":171036,"en":"Against the brow of Akkangky,"},{"id":"semetey-1-2013:p1231:b003:l012","ordinal":171037,"en":"Making it ring and clank."},{"id":"semetey-1-2013:p1231:b003:l013","ordinal":171038,"en":"Leaning back in the saddle,"},{"id":"semetey-1-2013:p1231:b003:l014","ordinal":171039,"en":"He scraped with his nail"},{"id":"semetey-1-2013:p1231:b003:l015","ordinal":171040,"en":"The powder spilled from the touchhole."},{"id":"semetey-1-2013:p1231:b003:l016","ordinal":171041,"en":"He struck Chinese flint against firestone,"},{"id":"semetey-1-2013:p1231:b003:l017","ordinal":171042,"en":"Set a glowing ember,"},{"id":"semetey-1-2013:p1231:b003:l018","ordinal":171043,"en":"And lit the matchcord."},{"id":"semetey-1-2013:p1231:b003:l019","ordinal":171044,"en":"Upon Surkoen with a roar,"},{"id":"semetey-1-2013:p1231:b003:l020","ordinal":171045,"en":"Toltoy of the Jediger"},{"id":"semetey-1-2013:p1231:b003:l021","ordinal":171046,"en":"Came flying toward him."},{"id":"semetey-1-2013:p1231:b003:l022","ordinal":171047,"en":"Towering like a great cauldron,"},{"id":"semetey-1-2013:p1231:b003:l023","ordinal":171048,"en":"Shrieking above him,"},{"id":"semetey-1-2013:p1231:b003:l024","ordinal":171049,"en":"Külchoro held it firm as a bullet"},{"id":"semetey-1-2013:p1231:b003:l025","ordinal":171050,"en":"And leveled Akkelte."},{"id":"semetey-1-2013:p1231:b003:l026","ordinal":171051,"en":"Toltoy came charging with a roar;"},{"id":"semetey-1-2013:p1231:b003:l027","ordinal":171052,"en":"Saying, \"He is within measured range,\""},{"id":"semetey-1-2013:p1231:b003:l028","ordinal":171053,"en":"Lion-born Kulchoro"},{"id":"semetey-1-2013:p1231:b003:l029","ordinal":171054,"en":"Fired Akkelte once."},{"id":"semetey-1-2013:p1231:b003:l030","ordinal":171055,"en":"Its bullet thundered with a crack;"},{"id":"semetey-1-2013:p1231:b003:l031","ordinal":171056,"en":"When it drew close to Toltoy,"},{"id":"semetey-1-2013:p1231:b003:l032","ordinal":171057,"en":"Your generous lord's Akkelte"},{"id":"semetey-1-2013:p1231:b003:l033","ordinal":171058,"en":"Roared like a camel with its calf."},{"id":"semetey-1-2013:p1231:b003:l034","ordinal":171059,"en":"Toltoy's whole body"},{"id":"semetey-1-2013:p1231:b003:l035","ordinal":171060,"en":"Trembled when he heard it."},{"id":"semetey-1-2013:p1231:b003:l036","ordinal":171061,"en":"Flame hissed from the muzzle;"},{"id":"semetey-1-2013:p1231:b003:l037","ordinal":171062,"en":"The leopard's Akkelte"},{"id":"semetey-1-2013:p1231:b003:l038","ordinal":171063,"en":"Nearly swept him away."},{"id":"semetey-1-2013:p1231:b003:l039","ordinal":171064,"en":"The bullet reached him shrieking,"},{"id":"semetey-1-2013:p1231:b004:l001","ordinal":171065,"en":"But Akkelte struck too high"},{"id":"semetey-1-2013:p1231:b004:l002","ordinal":171066,"en":"And its bullet flew far away."},{"id":"semetey-1-2013:p1231:b004:l003","ordinal":171067,"en":"At the gray hillock's ridge,"},{"id":"semetey-1-2013:p1231:b004:l004","ordinal":171068,"en":"Akkelte's bullet struck,"},{"id":"semetey-1-2013:p1231:b004:l005","ordinal":171069,"en":"And black turf the size of a millstone"},{"id":"semetey-1-2013:p1231:b004:l006","ordinal":171070,"en":"Turned over and flew away."},{"id":"semetey-1-2013:p1231:b004:l007","ordinal":171071,"en":"Dear Lord Toltoy's"},{"id":"semetey-1-2013:p1231:b004:l008","ordinal":171072,"en":"Ribs and heart jolted,"},{"id":"semetey-1-2013:p1231:b004:l009","ordinal":171073,"en":"And his filthy guts quivered."},{"id":"semetey-1-2013:p1231:b004:l010","ordinal":171074,"en":"Hero Toltoy stood amazed:"},{"id":"semetey-1-2013:p1231:b004:l011","ordinal":171075,"en":"Had thunder suddenly crashed?"},{"id":"semetey-1-2013:p1231:b004:l012","ordinal":171076,"en":"What strange mystery was this?"},{"id":"semetey-1-2013:p1231:b004:l013","ordinal":171077,"en":"Had the earth broken apart?"},{"id":"semetey-1-2013:p1231:b004:l014","ordinal":171078,"en":"Was there a black-ridged mountain?"},{"id":"semetey-1-2013:p1231:b004:l015","ordinal":171079,"en":"What age and what day was this?"},{"id":"semetey-1-2013:p1231:b004:l016","ordinal":171080,"en":"Had an enemy come from the Khagan?"},{"id":"semetey-1-2013:p1231:b004:l017","ordinal":171081,"en":"The earth broke and made a sound;"},{"id":"semetey-1-2013:p1231:b004:l018","ordinal":171082,"en":"Was there an enemy coming to devour him?"},{"id":"semetey-1-2013:p1231:b004:l019","ordinal":171083,"en":"Was there a bullet wrapped in haze,"},{"id":"semetey-1-2013:p1231:b004:l020","ordinal":171084,"en":"Coming in an unbroken, roaring mass"},{"id":"semetey-1-2013:p1231:b004:l021","ordinal":171085,"en":"Toward them?"},{"id":"semetey-1-2013:p1231:b004:l022","ordinal":171086,"en":"Hero Toltoy took courage."},{"id":"semetey-1-2013:p1231:b004:l023","ordinal":171087,"en":"If an eager enemy had come,"},{"id":"semetey-1-2013:p1231:b004:l024","ordinal":171088,"en":"He would slaughter them with his sword;"},{"id":"semetey-1-2013:p1231:b004:l025","ordinal":171089,"en":"Let forty thousand enemies appear,"},{"id":"semetey-1-2013:p1231:b004:l026","ordinal":171090,"en":"He would bring them all to their end."},{"id":"semetey-1-2013:p1231:b004:l027","ordinal":171091,"en":"He raged and made ready,"},{"id":"semetey-1-2013:p1231:b004:l028","ordinal":171092,"en":"And turned Surkoen's head."},{"id":"semetey-1-2013:p1231:b004:l029","ordinal":171093,"en":"Ready to grapple,"},{"id":"semetey-1-2013:p1231:b004:l030","ordinal":171094,"en":"Dear Toltoy now stood."},{"id":"semetey-1-2013:p1231:b004:l031","ordinal":171095,"en":"Good heavens—when he looked toward the pass,"},{"id":"semetey-1-2013:p1231:b004:l032","ordinal":171096,"en":"A youth mounted on a red roan,"},{"id":"semetey-1-2013:p1231:b004:l033","ordinal":171097,"en":"Its hair tail tightly knotted,"},{"id":"semetey-1-2013:p1231:b004:l034","ordinal":171098,"en":"A ruddy young boy,"},{"id":"semetey-1-2013:p1231:b004:l035","ordinal":171099,"en":"Came shouting from the pass,"},{"id":"semetey-1-2013:p1231:b004:l036","ordinal":171100,"en":"Calling the battle cry \"Manas!\""},{"id":"semetey-1-2013:p1231:b004:l037","ordinal":171101,"en":"Mounted on a black roan,"},{"id":"semetey-1-2013:p1231:b004:l038","ordinal":171102,"en":"Its hair tail tightly knotted,"},{"id":"semetey-1-2013:p1231:b004:l039","ordinal":171103,"en":"A dark, ruddy young boy,"},{"id":"semetey-1-2013:p1232:b003:l001","ordinal":171104,"en":"Had leveled his spear."},{"id":"semetey-1-2013:p1232:b003:l002","ordinal":171105,"en":"He roared in anger,"},{"id":"semetey-1-2013:p1232:b003:l003","ordinal":171106,"en":"Came blazing from the ridge,"},{"id":"semetey-1-2013:p1232:b003:l004","ordinal":171107,"en":"And called the battle cry \"Manas!\""},{"id":"semetey-1-2013:p1232:b003:l005","ordinal":171108,"en":"He was a boy of twelve."},{"id":"semetey-1-2013:p1232:b003:l006","ordinal":171109,"en":"\"I will block his road,"},{"id":"semetey-1-2013:p1232:b003:l007","ordinal":171110,"en":"Offer him as a sacrifice,"},{"id":"semetey-1-2013:p1232:b003:l008","ordinal":171111,"en":"Lead his horse away as plunder,"},{"id":"semetey-1-2013:p1232:b003:l009","ordinal":171112,"en":"And take it as booty."},{"id":"semetey-1-2013:p1232:b003:l010","ordinal":171113,"en":"Now I will find my chance"},{"id":"semetey-1-2013:p1232:b003:l011","ordinal":171114,"en":"And cut him with my sword."},{"id":"semetey-1-2013:p1232:b003:l012","ordinal":171115,"en":"I will bring the axe down"},{"id":"semetey-1-2013:p1232:b003:l013","ordinal":171116,"en":"Upon this impudent boy"},{"id":"semetey-1-2013:p1232:b003:l014","ordinal":171117,"en":"And spill his blood like an albasty.\""},{"id":"semetey-1-2013:p1232:b003:l015","ordinal":171118,"en":"He turned Surkoen's head;"},{"id":"semetey-1-2013:p1232:b003:l016","ordinal":171119,"en":"The leopard Sultan Toltoy"},{"id":"semetey-1-2013:p1232:b003:l017","ordinal":171120,"en":"Stood waiting for the boy."},{"id":"semetey-1-2013:p1232:b003:l018","ordinal":171121,"en":"Shouting, \"Manas! Manas!\""},{"id":"semetey-1-2013:p1232:b003:l019","ordinal":171122,"en":"Calling the battle cry \"Manas,\""},{"id":"semetey-1-2013:p1232:b003:l020","ordinal":171123,"en":"He came crying, \"Manas! Manas!\""},{"id":"semetey-1-2013:p1232:b003:l021","ordinal":171124,"en":"The battle cry spoken in Manas's name"},{"id":"semetey-1-2013:p1232:b003:l022","ordinal":171125,"en":"Deafened ears and noses."},{"id":"semetey-1-2013:p1232:b003:l023","ordinal":171126,"en":"When Toltoy looked again,"},{"id":"semetey-1-2013:p1232:b003:l024","ordinal":171127,"en":"Where he stood became a deep ravine;"},{"id":"semetey-1-2013:p1232:b003:l025","ordinal":171128,"en":"His own eyelashes became enemies."},{"id":"semetey-1-2013:p1232:b003:l026","ordinal":171129,"en":"Toltoy of the Jediger"},{"id":"semetey-1-2013:p1232:b003:l027","ordinal":171130,"en":"Lost heart,"},{"id":"semetey-1-2013:p1232:b003:l028","ordinal":171131,"en":"And in hero Toltoy's eyes"},{"id":"semetey-1-2013:p1232:b003:l029","ordinal":171132,"en":"Mountain-like Manas appeared."},{"id":"semetey-1-2013:p1232:b003:l030","ordinal":171133,"en":"When Toltoy looked carefully,"},{"id":"semetey-1-2013:p1232:b003:l031","ordinal":171134,"en":"As the boy cried \"Manas!\""},{"id":"semetey-1-2013:p1232:b003:l032","ordinal":171135,"en":"Hundreds led by Manas"},{"id":"semetey-1-2013:p1232:b003:l033","ordinal":171136,"en":"Streamed out of the marsh,"},{"id":"semetey-1-2013:p1232:b003:l034","ordinal":171137,"en":"And thousands led by Bakay"},{"id":"semetey-1-2013:p1232:b003:l035","ordinal":171138,"en":"Surged out behind them."},{"id":"semetey-1-2013:p1232:b003:l036","ordinal":171139,"en":"Wearing a coat of yellow gold,"},{"id":"semetey-1-2013:p1232:b003:l037","ordinal":171140,"en":"Mounted on a piebald horse,"},{"id":"semetey-1-2013:p1232:b003:l038","ordinal":171141,"en":"With a bare sword at his side,"},{"id":"semetey-1-2013:p1232:b003:l039","ordinal":171142,"en":"He circled in fury."},{"id":"semetey-1-2013:p1232:b004:l001","ordinal":171143,"en":"The sight made hearts waver;"},{"id":"semetey-1-2013:p1232:b004:l002","ordinal":171144,"en":"He showed the form of a taker of souls."},{"id":"semetey-1-2013:p1232:b004:l003","ordinal":171145,"en":"Whipping the piebald horse,"},{"id":"semetey-1-2013:p1232:b004:l004","ordinal":171146,"en":"“Seize him, seize him, seize him!”"},{"id":"semetey-1-2013:p1232:b004:l005","ordinal":171147,"en":"“If you seize him, kill him!”"},{"id":"semetey-1-2013:p1232:b004:l006","ordinal":171148,"en":"“Bind both his hands,"},{"id":"semetey-1-2013:p1232:b004:l007","ordinal":171149,"en":"Gouge out both his eyes,"},{"id":"semetey-1-2013:p1232:b004:l008","ordinal":171150,"en":"And only then kill him!”"},{"id":"semetey-1-2013:p1232:b004:l009","ordinal":171151,"en":"Almambet raised the battle cry."},{"id":"semetey-1-2013:p1232:b004:l010","ordinal":171152,"en":"With hungry shout and fierce battle cry,"},{"id":"semetey-1-2013:p1232:b004:l011","ordinal":171153,"en":"Whom no wrestler could overpower,"},{"id":"semetey-1-2013:p1232:b004:l012","ordinal":171154,"en":"And no lion's tooth could pierce,"},{"id":"semetey-1-2013:p1232:b004:l013","ordinal":171155,"en":"Wearing a blue rapys coat,"},{"id":"semetey-1-2013:p1232:b004:l014","ordinal":171156,"en":"Mounted on a mottled blue horse,"},{"id":"semetey-1-2013:p1232:b004:l015","ordinal":171157,"en":"Chubak of Akbaltay"},{"id":"semetey-1-2013:p1232:b004:l016","ordinal":171158,"en":"Raised the cry behind him"},{"id":"semetey-1-2013:p1232:b004:l017","ordinal":171159,"en":"And became his support."},{"id":"semetey-1-2013:p1232:b004:l018","ordinal":171160,"en":"Hero Toltoy of the Jediger"},{"id":"semetey-1-2013:p1232:b004:l019","ordinal":171161,"en":"Lost heart;"},{"id":"semetey-1-2013:p1232:b004:l020","ordinal":171162,"en":"It seemed as though the usual lion Khan Manas"},{"id":"semetey-1-2013:p1232:b004:l021","ordinal":171163,"en":"Had appeared alive."},{"id":"semetey-1-2013:p1232:b004:l022","ordinal":171164,"en":"\"They will bring me to my end,"},{"id":"semetey-1-2013:p1232:b004:l023","ordinal":171165,"en":"Destroy us all,"},{"id":"semetey-1-2013:p1232:b004:l024","ordinal":171166,"en":"And bind boastful Kojo"},{"id":"semetey-1-2013:p1232:b004:l025","ordinal":171167,"en":"And carry him away alive!"},{"id":"semetey-1-2013:p1232:b004:l026","ordinal":171168,"en":"It is leopard Manas himself;"},{"id":"semetey-1-2013:p1232:b004:l027","ordinal":171169,"en":"How could he spare a life?"},{"id":"semetey-1-2013:p1232:b004:l028","ordinal":171170,"en":"It is valiant Bakay himself;"},{"id":"semetey-1-2013:p1232:b004:l029","ordinal":171171,"en":"This means he will bring torment."},{"id":"semetey-1-2013:p1232:b004:l030","ordinal":171172,"en":"Can one who challenges him live?"},{"id":"semetey-1-2013:p1232:b004:l031","ordinal":171173,"en":"Can one who confronts him survive?"},{"id":"semetey-1-2013:p1232:b004:l032","ordinal":171174,"en":"Will the living leopard"},{"id":"semetey-1-2013:p1232:b004:l033","ordinal":171175,"en":"Bring us to our end like this,"},{"id":"semetey-1-2013:p1232:b004:l034","ordinal":171176,"en":"Take us alive,"},{"id":"semetey-1-2013:p1232:b004:l035","ordinal":171177,"en":"Drag us along the road,"},{"id":"semetey-1-2013:p1232:b004:l036","ordinal":171178,"en":"And offer us as sacrifices?"},{"id":"semetey-1-2013:p1232:b004:l037","ordinal":171179,"en":"Will I stand and match him,"},{"id":"semetey-1-2013:p1232:b004:l038","ordinal":171180,"en":"Let myself be sacrificed,"},{"id":"semetey-1-2013:p1232:b004:l039","ordinal":171181,"en":"And be dragged along the road?\""},{"id":"semetey-1-2013:p1233:b003:l001","ordinal":171182,"en":"Be offered as a sacrifice,"},{"id":"semetey-1-2013:p1233:b003:l002","ordinal":171183,"en":"Be crushed upon the steppe,"},{"id":"semetey-1-2013:p1233:b003:l003","ordinal":171184,"en":"And torn apart by the Dangyts?"},{"id":"semetey-1-2013:p1233:b003:l004","ordinal":171185,"en":"Rather than die on the open plain"},{"id":"semetey-1-2013:p1233:b003:l005","ordinal":171186,"en":"And endure such suffering,"},{"id":"semetey-1-2013:p1233:b003:l006","ordinal":171187,"en":"I will flee into my ranks,"},{"id":"semetey-1-2013:p1233:b003:l007","ordinal":171188,"en":"Gather my host,"},{"id":"semetey-1-2013:p1233:b003:l008","ordinal":171189,"en":"And begin a mass battle;"},{"id":"semetey-1-2013:p1233:b003:l009","ordinal":171190,"en":"Rather than die on the open plain,"},{"id":"semetey-1-2013:p1233:b003:l010","ordinal":171191,"en":"I will die without regret."},{"id":"semetey-1-2013:p1233:b003:l011","ordinal":171192,"en":"I told him before—"},{"id":"semetey-1-2013:p1233:b003:l012","ordinal":171193,"en":"Did he not heed me then?"},{"id":"semetey-1-2013:p1233:b003:l013","ordinal":171194,"en":"Ravined spring and sheer cliff,"},{"id":"semetey-1-2013:p1233:b003:l014","ordinal":171195,"en":"Fiery, cunning Churok,"},{"id":"semetey-1-2013:p1233:b003:l015","ordinal":171196,"en":"Has men girded for battle"},{"id":"semetey-1-2013:p1233:b003:l016","ordinal":171197,"en":"And heroes lying in wait."},{"id":"semetey-1-2013:p1233:b003:l017","ordinal":171198,"en":"The cunning infidel Churok"},{"id":"semetey-1-2013:p1233:b003:l018","ordinal":171199,"en":"Has a pit she dug,"},{"id":"semetey-1-2013:p1233:b003:l019","ordinal":171200,"en":"Misfortune she has set boiling,"},{"id":"semetey-1-2013:p1233:b003:l020","ordinal":171201,"en":"And a great force the wretch"},{"id":"semetey-1-2013:p1233:b003:l021","ordinal":171202,"en":"Has long prepared."},{"id":"semetey-1-2013:p1233:b003:l022","ordinal":171203,"en":"When an oppressor comes for you,"},{"id":"semetey-1-2013:p1233:b003:l023","ordinal":171204,"en":"She has made ready;"},{"id":"semetey-1-2013:p1233:b003:l024","ordinal":171205,"en":"Aychurok, daughter of Akun,"},{"id":"semetey-1-2013:p1233:b003:l025","ordinal":171206,"en":"Has prepared"},{"id":"semetey-1-2013:p1233:b003:l026","ordinal":171207,"en":"All her warriors."},{"id":"semetey-1-2013:p1233:b003:l027","ordinal":171208,"en":"This infidel's man will not prosper;"},{"id":"semetey-1-2013:p1233:b003:l028","ordinal":171209,"en":"If he challenges Manas, he will not survive."},{"id":"semetey-1-2013:p1233:b003:l029","ordinal":171210,"en":"Mighty Manas took tribute"},{"id":"semetey-1-2013:p1233:b003:l030","ordinal":171211,"en":"From Beijing untouched by Sulayman;"},{"id":"semetey-1-2013:p1233:b003:l031","ordinal":171212,"en":"Hero Manas left his mark"},{"id":"semetey-1-2013:p1233:b003:l032","ordinal":171213,"en":"On Beijing untouched by Iskender."},{"id":"semetey-1-2013:p1233:b003:l033","ordinal":171214,"en":"Mighty Manas conquered"},{"id":"semetey-1-2013:p1233:b003:l034","ordinal":171215,"en":"Beijing where no prophet had gone;"},{"id":"semetey-1-2013:p1233:b003:l035","ordinal":171216,"en":"Mighty Manas raided"},{"id":"semetey-1-2013:p1233:b003:l036","ordinal":171217,"en":"Beijing no holy man had raided."},{"id":"semetey-1-2013:p1233:b003:l037","ordinal":171218,"en":"Can one who challenges"},{"id":"semetey-1-2013:p1233:b003:l038","ordinal":171219,"en":"Bloodletter lion Manas survive?"},{"id":"semetey-1-2013:p1233:b003:l039","ordinal":171220,"en":"Toltoy, knowing his renown,"},{"id":"semetey-1-2013:p1233:b005:l001","ordinal":171221,"en":"Lost the strength in his arms"},{"id":"semetey-1-2013:p1233:b005:l002","ordinal":171222,"en":"And the courage in his heart."},{"id":"semetey-1-2013:p1233:b005:l003","ordinal":171223,"en":"Gray-maned Khan Toltoy's"},{"id":"semetey-1-2013:p1233:b005:l004","ordinal":171224,"en":"Chest began to tremble,"},{"id":"semetey-1-2013:p1233:b005:l005","ordinal":171225,"en":"And his beard bristled hair by hair."},{"id":"semetey-1-2013:p1233:b005:l006","ordinal":171226,"en":"Kulchoro was coming,"},{"id":"semetey-1-2013:p1233:b005:l007","ordinal":171227,"en":"Calling the battle cry \"Manas,\""},{"id":"semetey-1-2013:p1233:b005:l008","ordinal":171228,"en":"Like a hungry lion and tiger."},{"id":"semetey-1-2013:p1233:b005:l009","ordinal":171229,"en":"Toltoy stood bewildered;"},{"id":"semetey-1-2013:p1233:b005:l010","ordinal":171230,"en":"If they fought, he would not survive."},{"id":"semetey-1-2013:p1233:b005:l011","ordinal":171231,"en":"Khan Toltoy, who came to take a wife,"},{"id":"semetey-1-2013:p1233:b005:l012","ordinal":171232,"en":"Stretched the drum in his hand,"},{"id":"semetey-1-2013:p1233:b005:l013","ordinal":171233,"en":"Struck the drum once,"},{"id":"semetey-1-2013:p1233:b005:l014","ordinal":171234,"en":"And struck Surkoen once."},{"id":"semetey-1-2013:p1233:b005:l015","ordinal":171235,"en":"Hero Toltoy took to the road,"},{"id":"semetey-1-2013:p1233:b005:l016","ordinal":171236,"en":"Charging toward the Jediger,"},{"id":"semetey-1-2013:p1233:b005:l017","ordinal":171237,"en":"As though he would reach them."},{"id":"semetey-1-2013:p1233:b005:l018","ordinal":171238,"en":"He lashed Surkoen beneath him"},{"id":"semetey-1-2013:p1233:b005:l019","ordinal":171239,"en":"From side to side,"},{"id":"semetey-1-2013:p1233:b005:l020","ordinal":171240,"en":"Spurred both ways,"},{"id":"semetey-1-2013:p1233:b005:l021","ordinal":171241,"en":"He made extreme haste,"},{"id":"semetey-1-2013:p1233:b005:l022","ordinal":171242,"en":"And fled far away."},{"id":"semetey-1-2013:p1233:b005:l023","ordinal":171243,"en":"Surkoen flew like an arrow,"},{"id":"semetey-1-2013:p1233:b005:l024","ordinal":171244,"en":"The racehorse beneath him."},{"id":"semetey-1-2013:p1233:b005:l025","ordinal":171245,"en":"He would not have taken Churok;"},{"id":"semetey-1-2013:p1233:b005:l026","ordinal":171246,"en":"This was the commotion"},{"id":"semetey-1-2013:p1233:b005:l027","ordinal":171247,"en":"Chynkojo had pressed him into."},{"id":"semetey-1-2013:p1233:b005:l028","ordinal":171248,"en":"When Toltoy returned to his people,"},{"id":"semetey-1-2013:p1233:b005:l029","ordinal":171249,"en":"When he turned and fled,"},{"id":"semetey-1-2013:p1233:b005:l030","ordinal":171250,"en":"The ground split in shimmering haze,"},{"id":"semetey-1-2013:p1233:b005:l031","ordinal":171251,"en":"And dust billowed behind."},{"id":"semetey-1-2013:p1233:b005:l032","ordinal":171252,"en":"Hero Toltoy's Surkoen"},{"id":"semetey-1-2013:p1233:b005:l033","ordinal":171253,"en":"Came flying through the mirage."},{"id":"semetey-1-2013:p1233:b005:l034","ordinal":171254,"en":"When he reached a descent,"},{"id":"semetey-1-2013:p1233:b005:l035","ordinal":171255,"en":"Hero Toltoy's Surkoen"},{"id":"semetey-1-2013:p1233:b005:l036","ordinal":171256,"en":"Thrust his forelegs like a roe deer's;"},{"id":"semetey-1-2013:p1233:b005:l037","ordinal":171257,"en":"When he leaned into an ascent,"},{"id":"semetey-1-2013:p1233:b005:l038","ordinal":171258,"en":"Peerless racehorse Surkoen's"},{"id":"semetey-1-2013:p1233:b005:l039","ordinal":171259,"en":"Mane and tail streamed out."},{"id":"semetey-1-2013:p1234:b003:l001","ordinal":171260,"en":"His hooves thundered on the earth,"},{"id":"semetey-1-2013:p1234:b003:l002","ordinal":171261,"en":"And the black-steel bit"},{"id":"semetey-1-2013:p1234:b003:l003","ordinal":171262,"en":"Clattered in his throat."},{"id":"semetey-1-2013:p1234:b003:l004","ordinal":171263,"en":"When he ran he shrieked;"},{"id":"semetey-1-2013:p1234:b003:l005","ordinal":171264,"en":"Stones beneath his hooves"}]
