[{"id":"manas-2010:p1586:b001:l025","ordinal":68353,"en":"Seething like sand,"},{"id":"manas-2010:p1586:b001:l026","ordinal":68354,"en":"See the mighty Chinese multitude!"},{"id":"manas-2010:p1586:b001:l027","ordinal":68355,"en":"Even then Muzburchak"},{"id":"manas-2010:p1586:b001:l028","ordinal":68356,"en":"Did not stir from his horse."},{"id":"manas-2010:p1586:b001:l029","ordinal":68357,"en":"That Kökchö had been captured,"},{"id":"manas-2010:p1586:b001:l030","ordinal":68358,"en":"Muzburchak saw."},{"id":"manas-2010:p1586:b001:l031","ordinal":68359,"en":"There was no way to rescue him."},{"id":"manas-2010:p1586:b001:l032","ordinal":68360,"en":"Biting his finger until it split,"},{"id":"manas-2010:p1586:b001:l033","ordinal":68361,"en":"His two eyes blazing,"},{"id":"manas-2010:p1586:b001:l034","ordinal":68362,"en":"Muzburchak stood dying of anguish."},{"id":"manas-2010:p1586:b001:l035","ordinal":68363,"en":"Kökchö’s Kögala"},{"id":"manas-2010:p1586:b001:l036","ordinal":68364,"en":"One noble had taken in tow."},{"id":"manas-2010:p1586:b001:l037","ordinal":68365,"en":"All the Chinese rejoiced:"},{"id":"manas-2010:p1586:b001:l038","ordinal":68366,"en":"“Now we shall finish them!”"},{"id":"manas-2010:p1586:b001:l039","ordinal":68367,"en":"They beat their booming drums."},{"id":"manas-2010:p1586:b001:l040","ordinal":68368,"en":"A thousand of the swift foot-runners"},{"id":"manas-2010:p1586:b001:l041","ordinal":68369,"en":"Seized Aydarkan’s Kökchö"},{"id":"manas-2010:p1586:b001:l042","ordinal":68370,"en":"And pulled him about like a goat in the carcass game,"},{"id":"manas-2010:p1587:b001:l001","ordinal":68371,"en":"Then Syrgak grew grim,"},{"id":"manas-2010:p1587:b001:l002","ordinal":68372,"en":"And Kokchebich, like a spirit horse,"},{"id":"manas-2010:p1587:b001:l003","ordinal":68373,"en":"Stretched out like a roe deer."},{"id":"manas-2010:p1587:b001:l004","ordinal":68374,"en":"Ridden on reconnaissance, he never tired;"},{"id":"manas-2010:p1587:b001:l005","ordinal":68375,"en":"Left in the rear camp, he never sickened."},{"id":"manas-2010:p1587:b001:l006","ordinal":68376,"en":"He lowered his head to the ground,"},{"id":"manas-2010:p1587:b001:l007","ordinal":68377,"en":"And bolting away with Syrgak,"},{"id":"manas-2010:p1587:b001:l008","ordinal":68378,"en":"Gave him much trouble."},{"id":"manas-2010:p1587:b001:l009","ordinal":68379,"en":"His cry was, “Warrior Manas!”"},{"id":"manas-2010:p1587:b001:l010","ordinal":68380,"en":"Kogala, being led alongside—"},{"id":"manas-2010:p1587:b001:l011","ordinal":68381,"en":"When Syrgak caught sight of him,"},{"id":"manas-2010:p1587:b001:l012","ordinal":68382,"en":"Against the Chinese waging war"},{"id":"manas-2010:p1587:b001:l013","ordinal":68383,"en":"He plunged in, attacking without pause."},{"id":"manas-2010:p1587:b001:l014","ordinal":68384,"en":"Across the blade-smooth plain"},{"id":"manas-2010:p1587:b001:l015","ordinal":68385,"en":"He reached them without delay,"},{"id":"manas-2010:p1587:b001:l016","ordinal":68386,"en":"And many governors and swift footmen"},{"id":"manas-2010:p1587:b001:l017","ordinal":68387,"en":"He speared down as he passed."},{"id":"manas-2010:p1587:b001:l018","ordinal":68388,"en":"Kokcho’s Kogala"},{"id":"manas-2010:p1587:b001:l019","ordinal":68389,"en":"He snatched from the Chinese"},{"id":"manas-2010:p1587:b001:l020","ordinal":68390,"en":"And led safely away beside him."},{"id":"manas-2010:p1587:b001:l021","ordinal":68391,"en":"Yielding not to six thousand,"},{"id":"manas-2010:p1587:b001:l022","ordinal":68392,"en":"Akbaltay’s Chubak"},{"id":"manas-2010:p1587:b001:l023","ordinal":68393,"en":"Was wrestling with the host."},{"id":"manas-2010:p1587:b001:l024","ordinal":68394,"en":"When warrior Chubak looked,"},{"id":"manas-2010:p1587:b001:l025","ordinal":68395,"en":"Aydarkhan’s Kokcho"},{"id":"manas-2010:p1587:b001:l026","ordinal":68396,"en":"They had put to dreadful torment."},{"id":"manas-2010:p1587:b001:l027","ordinal":68397,"en":"Distraught, finding no way out,"},{"id":"manas-2010:p1587:b001:l028","ordinal":68398,"en":"He was being dragged about like a game carcass."},{"id":"manas-2010:p1587:b001:l029","ordinal":68399,"en":"His head was a bucketful of blood,"},{"id":"manas-2010:p1587:b001:l030","ordinal":68400,"en":"Not a scrap of his body was whole,"},{"id":"manas-2010:p1587:b001:l031","ordinal":68401,"en":"He was covered in dark crimson blood."},{"id":"manas-2010:p1587:b001:l032","ordinal":68402,"en":"Seeing this, warrior Chubak said,"},{"id":"manas-2010:p1587:b001:l033","ordinal":68403,"en":"“If Muzburchak and Khan Kokcho die,"},{"id":"manas-2010:p1587:b001:l034","ordinal":68404,"en":"If all who came here die,"},{"id":"manas-2010:p1587:b001:l035","ordinal":68405,"en":"How shall we return to Talas?"},{"id":"manas-2010:p1587:b001:l036","ordinal":68406,"en":"What desire shall we attain?”"},{"id":"manas-2010:p1587:b001:l037","ordinal":68407,"en":"Saying this, warrior Chubak"},{"id":"manas-2010:p1587:b001:l038","ordinal":68408,"en":"Made Kogala prance,"},{"id":"manas-2010:p1587:b001:l039","ordinal":68409,"en":"And heading for warrior Kokcho,"},{"id":"manas-2010:p1587:b001:l040","ordinal":68410,"en":"He charged among the Chinese,"},{"id":"manas-2010:p1587:b001:l041","ordinal":68411,"en":"Sending those he met crawling."},{"id":"manas-2010:p1587:b001:l042","ordinal":68412,"en":"Just as Chubak reached them,"},{"id":"manas-2010:p1588:b001:l001","ordinal":68413,"en":"The one-eyed men fled in turmoil,"},{"id":"manas-2010:p1588:b001:l002","ordinal":68414,"en":"Striving to save their lives."},{"id":"manas-2010:p1588:b001:l003","ordinal":68415,"en":"Chubak now raised an uproar."},{"id":"manas-2010:p1588:b001:l004","ordinal":68416,"en":"With life hovering between death and survival,"},{"id":"manas-2010:p1588:b001:l005","ordinal":68417,"en":"Kokcho of the Kazakhs"},{"id":"manas-2010:p1588:b001:l006","ordinal":68418,"en":"He stooped and lifted up,"},{"id":"manas-2010:p1588:b001:l007","ordinal":68419,"en":"And laid across his right knee."},{"id":"manas-2010:p1588:b001:l008","ordinal":68420,"en":"Bearing Kokcho swiftly away,"},{"id":"manas-2010:p1588:b001:l009","ordinal":68421,"en":"He freed him from their hands."},{"id":"manas-2010:p1588:b001:l010","ordinal":68422,"en":"In the opening and closing of an eye,"},{"id":"manas-2010:p1588:b001:l011","ordinal":68423,"en":"Before a word could be spoken,"},{"id":"manas-2010:p1588:b001:l012","ordinal":68424,"en":"The falcon, leopard Syrgak"},{"id":"manas-2010:p1588:b001:l013","ordinal":68425,"en":"Charged across to them,"},{"id":"manas-2010:p1588:b001:l014","ordinal":68426,"en":"And reached warrior Kokcho."},{"id":"manas-2010:p1588:b001:l015","ordinal":68427,"en":"As soon as he reached Kokcho,"},{"id":"manas-2010:p1588:b001:l016","ordinal":68428,"en":"He mounted him on Kogala"},{"id":"manas-2010:p1588:b001:l017","ordinal":68429,"en":"And took him safely away."},{"id":"manas-2010:p1588:b001:l018","ordinal":68430,"en":"As they carried Kokcho away,"},{"id":"manas-2010:p1588:b001:l019","ordinal":68431,"en":"No breath, no vapor came from his mouth;"},{"id":"manas-2010:p1588:b001:l020","ordinal":68432,"en":"Not a tick-sized patch was whole."},{"id":"manas-2010:p1588:b001:l021","ordinal":68433,"en":"From warrior Kokcho’s mouth"},{"id":"manas-2010:p1588:b001:l022","ordinal":68434,"en":"Blood came out in clots;"},{"id":"manas-2010:p1588:b001:l023","ordinal":68435,"en":"Warrior Kokcho’s strength had gone."},{"id":"manas-2010:p1588:b001:l024","ordinal":68436,"en":"Argynkhan’s son Ajybai,"},{"id":"manas-2010:p1588:b001:l025","ordinal":68437,"en":"Most skillful of men in finding remedies,"},{"id":"manas-2010:p1588:b001:l026","ordinal":68438,"en":"Had in his keeping,"},{"id":"manas-2010:p1588:b001:l027","ordinal":68439,"en":"On the swift camel’s back,"},{"id":"manas-2010:p1588:b001:l028","ordinal":68440,"en":"A medicine called Sebep,"},{"id":"manas-2010:p1588:b001:l029","ordinal":68441,"en":"A medicine called Medet."},{"id":"manas-2010:p1588:b001:l030","ordinal":68442,"en":"From inside the rawhide bag"},{"id":"manas-2010:p1588:b001:l031","ordinal":68443,"en":"He now took out a bowl."},{"id":"manas-2010:p1588:b001:l032","ordinal":68444,"en":"Scooping out the preserved travel food,"},{"id":"manas-2010:p1588:b001:l033","ordinal":68445,"en":"Six or seven bowlfuls,"},{"id":"manas-2010:p1588:b001:l034","ordinal":68446,"en":"He mixed a compound remedy and made him swallow it."},{"id":"manas-2010:p1588:b001:l035","ordinal":68447,"en":"Khan Kokcho of the Kazakhs"},{"id":"manas-2010:p1588:b001:l036","ordinal":68448,"en":"Opened his eyes wide and clear;"},{"id":"manas-2010:p1588:b001:l037","ordinal":68449,"en":"His aching wounds grew quiet."},{"id":"manas-2010:p1588:b001:l038","ordinal":68450,"en":"Buudayyk Khan’s Muzburchak—"},{"id":"manas-2010:p1588:b001:l039","ordinal":68451,"en":"Telkyzyl’s strength was failing,"},{"id":"manas-2010:p1588:b001:l040","ordinal":68452,"en":"And from Burchak’s body"},{"id":"manas-2010:p1588:b001:l041","ordinal":68453,"en":"Dark crimson blood was flowing,"},{"id":"manas-2010:p1588:b001:l042","ordinal":68454,"en":"Seventy spears having struck him at once."},{"id":"manas-2010:p1589:b001:l001","ordinal":68455,"en":"Seven thousand governors swarmed upon him,"},{"id":"manas-2010:p1589:b001:l002","ordinal":68456,"en":"Ay Jangjung gave a shout,"},{"id":"manas-2010:p1589:b001:l003","ordinal":68457,"en":"Ezkara upon his great bay,"},{"id":"manas-2010:p1589:b001:l004","ordinal":68458,"en":"And all the mighty champions"},{"id":"manas-2010:p1589:b001:l005","ordinal":68459,"en":"Had taken Buudayyk Khan’s Burchak"},{"id":"manas-2010:p1589:b001:l006","ordinal":68460,"en":"Into their midst."},{"id":"manas-2010:p1589:b001:l007","ordinal":68461,"en":"His two eyes darting wildly,"},{"id":"manas-2010:p1589:b001:l008","ordinal":68462,"en":"His two feet dangling,"},{"id":"manas-2010:p1589:b001:l009","ordinal":68463,"en":"Buudayyk Khan’s Muzburchak,"},{"id":"manas-2010:p1589:b001:l010","ordinal":68464,"en":"When the Chinese approached,"},{"id":"manas-2010:p1589:b001:l011","ordinal":68465,"en":"With sword and battle-axe,"},{"id":"manas-2010:p1589:b001:l012","ordinal":68466,"en":"When they swung their painted spears,"},{"id":"manas-2010:p1589:b001:l013","ordinal":68467,"en":"Not knowing what to do,"},{"id":"manas-2010:p1589:b001:l014","ordinal":68468,"en":"Faint and bewildered,"},{"id":"manas-2010:p1589:b001:l015","ordinal":68469,"en":"Spoke his thoughts in a daze:"},{"id":"manas-2010:p1589:b001:l016","ordinal":68470,"en":"“Now I am going to die!”"},{"id":"manas-2010:p1589:b001:l017","ordinal":68471,"en":"With no strength to utter a sound,"},{"id":"manas-2010:p1589:b001:l018","ordinal":68472,"en":"Bracing himself upon his horse,"},{"id":"manas-2010:p1589:b001:l019","ordinal":68473,"en":"Despairing of his entrusted life,"},{"id":"manas-2010:p1589:b001:l020","ordinal":68474,"en":"He stood looking on and muttering."},{"id":"manas-2010:p1589:b001:l021","ordinal":68475,"en":"Not revealing his plight to the Chinese,"},{"id":"manas-2010:p1589:b001:l022","ordinal":68476,"en":"Not letting them know his anguish,"},{"id":"manas-2010:p1589:b001:l023","ordinal":68477,"en":"Then, golden-crested, with a belt like embers,"},{"id":"manas-2010:p1589:b001:l024","ordinal":68478,"en":"Azizkhan’s Almambet,"},{"id":"manas-2010:p1589:b001:l025","ordinal":68479,"en":"Fearless, born a lion,"},{"id":"manas-2010:p1589:b001:l026","ordinal":68480,"en":"Saw Burchak from afar,"},{"id":"manas-2010:p1589:b001:l027","ordinal":68481,"en":"And against the Chinese surrounding him"},{"id":"manas-2010:p1589:b001:l028","ordinal":68482,"en":"He charged in alone."},{"id":"manas-2010:p1589:b001:l029","ordinal":68483,"en":"“Let me rekindle his extinguished fire,"},{"id":"manas-2010:p1589:b001:l030","ordinal":68484,"en":"Bring his dead soul back to life,"},{"id":"manas-2010:p1589:b001:l031","ordinal":68485,"en":"And rescue him!”"},{"id":"manas-2010:p1589:b001:l032","ordinal":68486,"en":"Saying this, your valiant champion"},{"id":"manas-2010:p1589:b001:l033","ordinal":68487,"en":"Came speeding like an arrow."},{"id":"manas-2010:p1589:b001:l034","ordinal":68488,"en":"Racing along on Sarala,"},{"id":"manas-2010:p1589:b001:l035","ordinal":68489,"en":"The Manchus who swarmed upon him"},{"id":"manas-2010:p1589:b001:l036","ordinal":68490,"en":"He flung aside like fur caps."},{"id":"manas-2010:p1589:b001:l037","ordinal":68491,"en":"He plunged through, breaking their ranks;"},{"id":"manas-2010:p1589:b001:l038","ordinal":68492,"en":"The Chinese he met fell in heaps."},{"id":"manas-2010:p1589:b001:l039","ordinal":68493,"en":"The Chinese surrounding him"},{"id":"manas-2010:p1589:b001:l040","ordinal":68494,"en":"Almambet drove away;"},{"id":"manas-2010:p1589:b001:l041","ordinal":68495,"en":"The Chinese who had encircled him"},{"id":"manas-2010:p1589:b001:l042","ordinal":68496,"en":"Almambet drove out."},{"id":"manas-2010:p1590:b001:l001","ordinal":68497,"en":"The Chinese who played the hero,"},{"id":"manas-2010:p1590:b001:l002","ordinal":68498,"en":"He slaughtered and scattered them all;"},{"id":"manas-2010:p1590:b001:l003","ordinal":68499,"en":"From around Muzburchak,"},{"id":"manas-2010:p1590:b001:l004","ordinal":68500,"en":"He drove the Chinese away."},{"id":"manas-2010:p1590:b001:l005","ordinal":68501,"en":"That hero Muzburchak,"},{"id":"manas-2010:p1590:b001:l006","ordinal":68502,"en":"Swaying upon Telkyzyl,"},{"id":"manas-2010:p1590:b001:l007","ordinal":68503,"en":"Safe and sound from the Chinese,"},{"id":"manas-2010:p1590:b001:l008","ordinal":68504,"en":"Your blue-maned one rescued"},{"id":"manas-2010:p1590:b001:l009","ordinal":68505,"en":"And brought out then."},{"id":"manas-2010:p1590:b001:l010","ordinal":68506,"en":"After Burchak escaped,"},{"id":"manas-2010:p1590:b001:l011","ordinal":68507,"en":"After he reached his own camp,"},{"id":"manas-2010:p1590:b001:l012","ordinal":68508,"en":"The multitude of Chinese bellowed;"},{"id":"manas-2010:p1590:b001:l013","ordinal":68509,"en":"The Manchus did not stand watching;"},{"id":"manas-2010:p1590:b001:l014","ordinal":68510,"en":"Khan Kongurbay shouted,"},{"id":"manas-2010:p1590:b001:l015","ordinal":68511,"en":"“Surge upon him!” he cried,"},{"id":"manas-2010:p1590:b001:l016","ordinal":68512,"en":"“Officers!” he bellowed;"},{"id":"manas-2010:p1590:b001:l017","ordinal":68513,"en":"Valiant, blue-maned Almambet,"},{"id":"manas-2010:p1590:b001:l018","ordinal":68514,"en":"The mighty army charged."},{"id":"manas-2010:p1590:b001:l019","ordinal":68515,"en":"All the Manchus roared,"},{"id":"manas-2010:p1590:b001:l020","ordinal":68516,"en":"Swept forward thundering;"},{"id":"manas-2010:p1590:b001:l021","ordinal":68517,"en":"Their monks from one side"},{"id":"manas-2010:p1590:b001:l022","ordinal":68518,"en":"Also entered with cries."},{"id":"manas-2010:p1590:b001:l023","ordinal":68519,"en":"From the flank, Kongurbay,"},{"id":"manas-2010:p1590:b001:l024","ordinal":68520,"en":"And Ay Jangjung charged out."},{"id":"manas-2010:p1590:b001:l025","ordinal":68521,"en":"Kongurbay, in wrath,"},{"id":"manas-2010:p1590:b001:l026","ordinal":68522,"en":"Struck Algara with his whip;"},{"id":"manas-2010:p1590:b001:l027","ordinal":68523,"en":"As he was about to arrive before an arrow,"},{"id":"manas-2010:p1590:b001:l028","ordinal":68524,"en":"From atop Sarala,"},{"id":"manas-2010:p1590:b001:l029","ordinal":68525,"en":"As he was about to knock him down in passing,"},{"id":"manas-2010:p1590:b001:l030","ordinal":68526,"en":"When he thrust his spear,"},{"id":"manas-2010:p1590:b001:l031","ordinal":68527,"en":"Almambet, Azizkan's son,"},{"id":"manas-2010:p1590:b001:l032","ordinal":68528,"en":"Took Zhoykuma in his hand;"},{"id":"manas-2010:p1590:b001:l033","ordinal":68529,"en":"Your tiger, fierce Alake,"},{"id":"manas-2010:p1590:b001:l034","ordinal":68530,"en":"Slashed across the grim-faced one's"},{"id":"manas-2010:p1590:b001:l035","ordinal":68531,"en":"Spear extended with a shout."},{"id":"manas-2010:p1590:b001:l036","ordinal":68532,"en":"As this was happening,"},{"id":"manas-2010:p1590:b001:l037","ordinal":68533,"en":"Swift as a flying bird,"},{"id":"manas-2010:p1590:b001:l038","ordinal":68534,"en":"No soul knew where he came from,"},{"id":"manas-2010:p1590:b001:l039","ordinal":68535,"en":"Syrgak, Ulak Khan's son,"},{"id":"manas-2010:p1590:b001:l040","ordinal":68536,"en":"Entered their midst."},{"id":"manas-2010:p1590:b001:l041","ordinal":68537,"en":"His shout split the sky;"},{"id":"manas-2010:p1590:b001:l042","ordinal":68538,"en":"He fought without mercy."},{"id":"manas-2010:p1591:b001:l001","ordinal":68539,"en":"The grim-faced one of the Chinese,"},{"id":"manas-2010:p1591:b001:l002","ordinal":68540,"en":"In wrath then,"},{"id":"manas-2010:p1591:b001:l003","ordinal":68541,"en":"Not sparing his own life,"},{"id":"manas-2010:p1591:b001:l004","ordinal":68542,"en":"Kongurbay of the Chinese"},{"id":"manas-2010:p1591:b001:l005","ordinal":68543,"en":"Charged at all three."},{"id":"manas-2010:p1591:b001:l006","ordinal":68544,"en":"From beyond him,"},{"id":"manas-2010:p1591:b001:l007","ordinal":68545,"en":"Ay Jangjung entered beside him;"},{"id":"manas-2010:p1591:b001:l008","ordinal":68546,"en":"Behind him,"},{"id":"manas-2010:p1591:b001:l009","ordinal":68547,"en":"Forty officers entered too;"},{"id":"manas-2010:p1591:b001:l010","ordinal":68548,"en":"From the rear, a thousand monks"},{"id":"manas-2010:p1591:b001:l011","ordinal":68549,"en":"Entered together shouting."},{"id":"manas-2010:p1591:b001:l012","ordinal":68550,"en":"Swift runners and the One-Eyes"},{"id":"manas-2010:p1591:b001:l013","ordinal":68551,"en":"All entered in a mass;"},{"id":"manas-2010:p1591:b001:l014","ordinal":68552,"en":"They swept into their midst;"},{"id":"manas-2010:p1591:b001:l015","ordinal":68553,"en":"Almambet, Chubak and Syrgak"},{"id":"manas-2010:p1591:b001:l016","ordinal":68554,"en":"They took among them."},{"id":"manas-2010:p1591:b001:l017","ordinal":68555,"en":"Amid the dust, Kongurbay,"},{"id":"manas-2010:p1591:b001:l018","ordinal":68556,"en":"Moving against all three alike,"},{"id":"manas-2010:p1591:b001:l019","ordinal":68557,"en":"Thrust his spear without mercy."},{"id":"manas-2010:p1591:b001:l020","ordinal":68558,"en":"However often he thrust his spear,"},{"id":"manas-2010:p1591:b001:l021","ordinal":68559,"en":"However many swords struck,"},{"id":"manas-2010:p1591:b001:l022","ordinal":68560,"en":"They neither leaned nor stirred;"},{"id":"manas-2010:p1591:b001:l023","ordinal":68561,"en":"Their buttocks upon their saddles"},{"id":"manas-2010:p1591:b001:l024","ordinal":68562,"en":"Neither tilted nor budged."},{"id":"manas-2010:p1591:b001:l025","ordinal":68563,"en":"Through their center, Almambet"},{"id":"manas-2010:p1591:b001:l026","ordinal":68564,"en":"Bored his way with repeated blows;"},{"id":"manas-2010:p1591:b001:l027","ordinal":68565,"en":"On both flanks, hero Syrgak"},{"id":"manas-2010:p1591:b001:l028","ordinal":68566,"en":"Drove them before him, slaughtering."},{"id":"manas-2010:p1591:b001:l029","ordinal":68567,"en":"With strain upon his life,"},{"id":"manas-2010:p1591:b001:l030","ordinal":68568,"en":"The leopard went on fighting."},{"id":"manas-2010:p1591:b001:l031","ordinal":68569,"en":"Where they were could not be known;"},{"id":"manas-2010:p1591:b001:l032","ordinal":68570,"en":"Not a single Kyrgyz"},{"id":"manas-2010:p1591:b001:l033","ordinal":68571,"en":"Came into their sight."},{"id":"manas-2010:p1591:b001:l034","ordinal":68572,"en":"When thought exhausted, they blazed up;"},{"id":"manas-2010:p1591:b001:l035","ordinal":68573,"en":"They grew stronger from their roots."},{"id":"manas-2010:p1591:b001:l036","ordinal":68574,"en":"The earth's surface swarmed;"},{"id":"manas-2010:p1591:b001:l037","ordinal":68575,"en":"Armies of every kind came;"},{"id":"manas-2010:p1591:b001:l038","ordinal":68576,"en":"From one flank to the other,"},{"id":"manas-2010:p1591:b001:l039","ordinal":68577,"en":"They came in numbers beyond sight."},{"id":"manas-2010:p1591:b001:l040","ordinal":68578,"en":"If one looked and watched,"},{"id":"manas-2010:p1591:b001:l041","ordinal":68579,"en":"Such was their multitude:"},{"id":"manas-2010:p1591:b001:l042","ordinal":68580,"en":"A flowing river, a lake came,"},{"id":"manas-2010:p1592:b001:l001","ordinal":68581,"en":"Seething, more than human beings,"},{"id":"manas-2010:p1592:b001:l002","ordinal":68582,"en":"A flood like ants came."},{"id":"manas-2010:p1592:b001:l003","ordinal":68583,"en":"When the Chinese swept upon them,"},{"id":"manas-2010:p1592:b001:l004","ordinal":68584,"en":"The forty companions, born fierce,"},{"id":"manas-2010:p1592:b001:l005","ordinal":68585,"en":"Shouted their battle cry,"},{"id":"manas-2010:p1592:b001:l006","ordinal":68586,"en":"Bellowing, “Khan Manas!”"},{"id":"manas-2010:p1592:b001:l007","ordinal":68587,"en":"They charged into the vast host."},{"id":"manas-2010:p1592:b001:l008","ordinal":68588,"en":"Becoming tangled in confusion,"},{"id":"manas-2010:p1592:b001:l009","ordinal":68589,"en":"Striking and thrusting,"},{"id":"manas-2010:p1592:b001:l010","ordinal":68590,"en":"They entered the melee."},{"id":"manas-2010:p1592:b001:l011","ordinal":68591,"en":"So many had their blood spilled;"},{"id":"manas-2010:p1592:b001:l012","ordinal":68592,"en":"The multitude lost its strength;"},{"id":"manas-2010:p1592:b001:l013","ordinal":68593,"en":"Dividing into two sides,"},{"id":"manas-2010:p1592:b001:l014","ordinal":68594,"en":"As the people broke into separate groups,"},{"id":"manas-2010:p1592:b001:l015","ordinal":68595,"en":"Ezkara, khan of the Manchus,"},{"id":"manas-2010:p1592:b001:l016","ordinal":68596,"en":"Ay Jangjung, khan of the Chinese,"},{"id":"manas-2010:p1592:b001:l017","ordinal":68597,"en":"Kongurbay, khan of the monks,"},{"id":"manas-2010:p1592:b001:l018","ordinal":68598,"en":"Came out apart from the people,"},{"id":"manas-2010:p1592:b001:l019","ordinal":68599,"en":"Looming like Mount Opol."},{"id":"manas-2010:p1592:b001:l020","ordinal":68600,"en":"When these men came out separately,"},{"id":"manas-2010:p1592:b001:l021","ordinal":68601,"en":"Chubak, Khan Baltay's son,"},{"id":"manas-2010:p1592:b001:l022","ordinal":68602,"en":"Reached Ay Jangjung."},{"id":"manas-2010:p1592:b001:l023","ordinal":68603,"en":"As soon as he reached him, hero Chubak"},{"id":"manas-2010:p1592:b001:l024","ordinal":68604,"en":"Knocked him down as he passed."},{"id":"manas-2010:p1592:b001:l025","ordinal":68605,"en":"Before Chubak could regain his position,"},{"id":"manas-2010:p1592:b001:l026","ordinal":68606,"en":"From his flank, Kongurbay"},{"id":"manas-2010:p1592:b001:l027","ordinal":68607,"en":"Also came charging up;"},{"id":"manas-2010:p1592:b001:l028","ordinal":68608,"en":"Upon reaching Chubak,"}]
