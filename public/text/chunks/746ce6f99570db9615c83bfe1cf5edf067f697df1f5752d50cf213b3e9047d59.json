[{"id":"semetey-1-2013:p1289:b003:l030","ordinal":174593,"en":"Many of the Zhediger's great host"},{"id":"semetey-1-2013:p1289:b003:l031","ordinal":174594,"en":"Rushed about in panic."},{"id":"semetey-1-2013:p1289:b003:l032","ordinal":174595,"en":"Many more fled,"},{"id":"semetey-1-2013:p1289:b003:l033","ordinal":174596,"en":"Trying to protect their lives."},{"id":"semetey-1-2013:p1289:b003:l034","ordinal":174597,"en":"To flee away together,"},{"id":"semetey-1-2013:p1289:b003:l035","ordinal":174598,"en":"One called to another, \"Come!\""},{"id":"semetey-1-2013:p1289:b003:l036","ordinal":174599,"en":"Many went urging one another."},{"id":"semetey-1-2013:p1289:b003:l037","ordinal":174600,"en":"Many cursed their fathers and grandfathers"},{"id":"semetey-1-2013:p1289:b003:l038","ordinal":174601,"en":"Without letting Kojo hear."},{"id":"semetey-1-2013:p1289:b003:l039","ordinal":174602,"en":"Many grieved"},{"id":"semetey-1-2013:p1289:b005:l001","ordinal":174603,"en":"Without speaking a word."},{"id":"semetey-1-2013:p1289:b005:l002","ordinal":174604,"en":"Many despaired then"},{"id":"semetey-1-2013:p1289:b005:l003","ordinal":174605,"en":"Of their lives held in trust."},{"id":"semetey-1-2013:p1289:b005:l004","ordinal":174606,"en":"Many said, \"We have suffered humiliation"},{"id":"semetey-1-2013:p1289:b005:l005","ordinal":174607,"en":"At the hands of dog Kojo\";"},{"id":"semetey-1-2013:p1289:b005:l006","ordinal":174608,"en":"Many said, \"Semetey slaughtered us;"},{"id":"semetey-1-2013:p1289:b005:l007","ordinal":174609,"en":"We are dead.\""},{"id":"semetey-1-2013:p1289:b005:l008","ordinal":174610,"en":"Many horses then"},{"id":"semetey-1-2013:p1289:b005:l009","ordinal":174611,"en":"Bucked and plunged without stopping."},{"id":"semetey-1-2013:p1289:b005:l010","ordinal":174612,"en":"Many went weeping, saying,"},{"id":"semetey-1-2013:p1289:b005:l011","ordinal":174613,"en":"\"Alas, we shall die without seeing"},{"id":"semetey-1-2013:p1289:b005:l012","ordinal":174614,"en":"Our wives and children.\""},{"id":"semetey-1-2013:p1289:b005:l013","ordinal":174615,"en":"He unleashed an upheaval;"},{"id":"semetey-1-2013:p1289:b005:l014","ordinal":174616,"en":"Dear Kojo drove them"},{"id":"semetey-1-2013:p1289:b005:l015","ordinal":174617,"en":"Before him under the whip."},{"id":"semetey-1-2013:p1289:b005:l016","ordinal":174618,"en":"Then a khan like Chynkojo"},{"id":"semetey-1-2013:p1289:b005:l017","ordinal":174619,"en":"Arose among the Zhediger;"},{"id":"semetey-1-2013:p1289:b005:l018","ordinal":174620,"en":"When they saw Chynkojo,"},{"id":"semetey-1-2013:p1289:b005:l019","ordinal":174621,"en":"Life left the Zhediger."},{"id":"semetey-1-2013:p1289:b005:l020","ordinal":174622,"en":"Among the Zhediger,"},{"id":"semetey-1-2013:p1289:b005:l021","ordinal":174623,"en":"Chynkojo, son of Shygai,"},{"id":"semetey-1-2013:p1289:b005:l022","ordinal":174624,"en":"Among the Zhediger,"},{"id":"semetey-1-2013:p1289:b005:l023","ordinal":174625,"en":"Was the most skillful of spearmen;"},{"id":"semetey-1-2013:p1289:b005:l024","ordinal":174626,"en":"He subdued the whole world—"},{"id":"semetey-1-2013:p1289:b005:l025","ordinal":174627,"en":"That mighty Chynkojo."},{"id":"semetey-1-2013:p1289:b005:l026","ordinal":174628,"en":"White sacred banner and red flag—"},{"id":"semetey-1-2013:p1289:b005:l027","ordinal":174629,"en":"The helpless Zhediger marched on"},{"id":"semetey-1-2013:p1289:b005:l028","ordinal":174630,"en":"Amid shouting and uproar;"},{"id":"semetey-1-2013:p1289:b005:l029","ordinal":174631,"en":"Blue sacred banner and red flag—"},{"id":"semetey-1-2013:p1289:b005:l030","ordinal":174632,"en":"They now saw things never seen before"},{"id":"semetey-1-2013:p1289:b005:l031","ordinal":174633,"en":"Amid the uproar."},{"id":"semetey-1-2013:p1289:b005:l032","ordinal":174634,"en":"Many could not then"},{"id":"semetey-1-2013:p1289:b005:l033","ordinal":174635,"en":"Find any recourse."},{"id":"semetey-1-2013:p1289:b005:l034","ordinal":174636,"en":"\"That fool who fled his village"},{"id":"semetey-1-2013:p1289:b005:l035","ordinal":174637,"en":"Has truly done this to us,\""},{"id":"semetey-1-2013:p1289:b005:l036","ordinal":174638,"en":"Many said, reviling him."},{"id":"semetey-1-2013:p1289:b005:l037","ordinal":174639,"en":"They had now reached and clung"},{"id":"semetey-1-2013:p1289:b005:l038","ordinal":174640,"en":"To a narrow pass like a saddle-back;"},{"id":"semetey-1-2013:p1289:b005:l039","ordinal":174641,"en":"When they reached that narrow pass,"},{"id":"semetey-1-2013:p1290:b003:l001","ordinal":174642,"en":"The people had lost all recourse."},{"id":"semetey-1-2013:p1290:b003:l002","ordinal":174643,"en":"Blue haze parted in the sky;"},{"id":"semetey-1-2013:p1290:b003:l003","ordinal":174644,"en":"With a rumble like a mountain collapsing,"},{"id":"semetey-1-2013:p1290:b003:l004","ordinal":174645,"en":"Hero Semetey appeared."},{"id":"semetey-1-2013:p1290:b003:l005","ordinal":174646,"en":"Over rugged hills and passes"},{"id":"semetey-1-2013:p1290:b003:l006","ordinal":174647,"en":"He rode out fiercely,"},{"id":"semetey-1-2013:p1290:b003:l007","ordinal":174648,"en":"His Buurul beneath him"},{"id":"semetey-1-2013:p1290:b003:l008","ordinal":174649,"en":"Covered with an abai cloth."},{"id":"semetey-1-2013:p1290:b003:l009","ordinal":174650,"en":"The sight overcame every heart;"},{"id":"semetey-1-2013:p1290:b003:l010","ordinal":174651,"en":"He loomed like Opol-Too,"},{"id":"semetey-1-2013:p1290:b003:l011","ordinal":174652,"en":"And the flame from his mouth"},{"id":"semetey-1-2013:p1290:b003:l012","ordinal":174653,"en":"Showed a spear's length."},{"id":"semetey-1-2013:p1290:b003:l013","ordinal":174654,"en":"Your gray wolf, the son of Manas,"},{"id":"semetey-1-2013:p1290:b003:l014","ordinal":174655,"en":"Had put on Akolpok;"},{"id":"semetey-1-2013:p1290:b003:l015","ordinal":174656,"en":"When they saw the gray wolf's form,"},{"id":"semetey-1-2013:p1290:b003:l016","ordinal":174657,"en":"The Zhediger stood grieving."},{"id":"semetey-1-2013:p1290:b003:l017","ordinal":174658,"en":"Your thundering sultan"},{"id":"semetey-1-2013:p1290:b003:l018","ordinal":174659,"en":"Girded on a silver belt,"},{"id":"semetey-1-2013:p1290:b003:l019","ordinal":174660,"en":"His face radiant as the sun;"},{"id":"semetey-1-2013:p1290:b003:l020","ordinal":174661,"en":"He girded on a golden belt,"},{"id":"semetey-1-2013:p1290:b003:l021","ordinal":174662,"en":"His face radiant as the moon."},{"id":"semetey-1-2013:p1290:b003:l022","ordinal":174663,"en":"The leopard supported by the spirits"},{"id":"semetey-1-2013:p1290:b003:l023","ordinal":174664,"en":"Stood erect and untroubled;"},{"id":"semetey-1-2013:p1290:b003:l024","ordinal":174665,"en":"He reckoned a kinsman like Chynkojo"},{"id":"semetey-1-2013:p1290:b003:l025","ordinal":174666,"en":"As less than the hem of his robe."},{"id":"semetey-1-2013:p1290:b003:l026","ordinal":174667,"en":"The dear hero, proud as a cock,"},{"id":"semetey-1-2013:p1290:b003:l027","ordinal":174668,"en":"Stood ringing without stirring;"},{"id":"semetey-1-2013:p1290:b003:l028","ordinal":174669,"en":"The sight arrested the heart,"},{"id":"semetey-1-2013:p1290:b003:l029","ordinal":174670,"en":"And blood dripped from the point"},{"id":"semetey-1-2013:p1290:b003:l030","ordinal":174671,"en":"Of the inlaid spear in his hand."},{"id":"semetey-1-2013:p1290:b003:l031","ordinal":174672,"en":"His ravenous nature showed;"},{"id":"semetey-1-2013:p1290:b003:l032","ordinal":174673,"en":"Buurul beneath him"},{"id":"semetey-1-2013:p1290:b003:l033","ordinal":174674,"en":"Gathered himself more fiercely than a stag."},{"id":"semetey-1-2013:p1290:b003:l034","ordinal":174675,"en":"Semetey, thoroughbred prince,"},{"id":"semetey-1-2013:p1290:b003:l035","ordinal":174676,"en":"Had put on Akolpok."},{"id":"semetey-1-2013:p1290:b003:l036","ordinal":174677,"en":"The kasaba banner floated in his hand;"},{"id":"semetey-1-2013:p1290:b003:l037","ordinal":174678,"en":"Akkelte, inherited from Manas,"},{"id":"semetey-1-2013:p1290:b003:l038","ordinal":174679,"en":"Gleamed upon his right shoulder."},{"id":"semetey-1-2013:p1290:b003:l039","ordinal":174680,"en":"Zulfiqar rang in the sheath"},{"id":"semetey-1-2013:p1290:b004:l001","ordinal":174681,"en":"Of the poor sultan-born hero;"},{"id":"semetey-1-2013:p1290:b004:l002","ordinal":174682,"en":"Semetey was a sultan,"},{"id":"semetey-1-2013:p1290:b004:l003","ordinal":174683,"en":"And came onward ringing."},{"id":"semetey-1-2013:p1290:b004:l004","ordinal":174684,"en":"The heart flinched at the sight;"},{"id":"semetey-1-2013:p1290:b004:l005","ordinal":174685,"en":"The Zhediger were overcome."},{"id":"semetey-1-2013:p1290:b004:l006","ordinal":174686,"en":"In his right hand the battle-axe"},{"id":"semetey-1-2013:p1290:b004:l007","ordinal":174687,"en":"Shone as though struck by moonlight."},{"id":"semetey-1-2013:p1290:b004:l008","ordinal":174688,"en":"When he came up onto the pass,"},{"id":"semetey-1-2013:p1290:b004:l009","ordinal":174689,"en":"The valiant hero appeared in full."},{"id":"semetey-1-2013:p1290:b004:l010","ordinal":174690,"en":"A black-mottled leopard"},{"id":"semetey-1-2013:p1290:b004:l011","ordinal":174691,"en":"Raged at his flank."},{"id":"semetey-1-2013:p1290:b004:l012","ordinal":174692,"en":"The watching Zhediger cried,"},{"id":"semetey-1-2013:p1290:b004:l013","ordinal":174693,"en":"\"Accursed day, now we are dead!\""},{"id":"semetey-1-2013:p1290:b004:l014","ordinal":174694,"en":"And prepared themselves for death."},{"id":"semetey-1-2013:p1290:b004:l015","ordinal":174695,"en":"The poor people lost heart,"},{"id":"semetey-1-2013:p1290:b004:l016","ordinal":174696,"en":"Their eyes darting wildly;"},{"id":"semetey-1-2013:p1290:b004:l017","ordinal":174697,"en":"Saying, \"No mortal can be like this,\""},{"id":"semetey-1-2013:p1290:b004:l018","ordinal":174698,"en":"Their joints went slack."},{"id":"semetey-1-2013:p1290:b004:l019","ordinal":174699,"en":"A lion with a cropped blue mane"},{"id":"semetey-1-2013:p1290:b004:l020","ordinal":174700,"en":"Made ready at his right side;"},{"id":"semetey-1-2013:p1290:b004:l021","ordinal":174701,"en":"The Forty Chiltens and Khizr Niyaz"},{"id":"semetey-1-2013:p1290:b004:l022","ordinal":174702,"en":"Became an army of forty-two thousand,"},{"id":"semetey-1-2013:p1290:b004:l023","ordinal":174703,"en":"Closing in from every side."},{"id":"semetey-1-2013:p1290:b004:l024","ordinal":174704,"en":"The giant black bird Zymyrik"},{"id":"semetey-1-2013:p1290:b004:l025","ordinal":174705,"en":"Stretched out its feet"},{"id":"semetey-1-2013:p1290:b004:l026","ordinal":174706,"en":"As though about to carry them away."},{"id":"semetey-1-2013:p1290:b004:l027","ordinal":174707,"en":"\"His spiritual support is exceedingly strong;"},{"id":"semetey-1-2013:p1290:b004:l028","ordinal":174708,"en":"If he moves, he will reach us."},{"id":"semetey-1-2013:p1290:b004:l029","ordinal":174709,"en":"We are a people without guilt;"},{"id":"semetey-1-2013:p1290:b004:l030","ordinal":174710,"en":"Will he ignore the guilty"},{"id":"semetey-1-2013:p1290:b004:l031","ordinal":174711,"en":"And destroy us instead?\" they said."},{"id":"semetey-1-2013:p1290:b004:l032","ordinal":174712,"en":"The Zhediger stood trembling,"},{"id":"semetey-1-2013:p1290:b004:l033","ordinal":174713,"en":"Suffering and grieving."},{"id":"semetey-1-2013:p1290:b004:l034","ordinal":174714,"en":"Semetey, son of Manas,"},{"id":"semetey-1-2013:p1290:b004:l035","ordinal":174715,"en":"Raised the pale-mottled banner,"},{"id":"semetey-1-2013:p1290:b004:l036","ordinal":174716,"en":"Shouted the cry of \"Khan Manas!\""},{"id":"semetey-1-2013:p1290:b004:l037","ordinal":174717,"en":"And, paying no heed to the great host,"},{"id":"semetey-1-2013:p1290:b004:l038","ordinal":174718,"en":"Had drawn aside."},{"id":"semetey-1-2013:p1290:b004:l039","ordinal":174719,"en":"Kojo, son of Shygai,"},{"id":"semetey-1-2013:p1291:b003:l001","ordinal":174720,"en":"The lion-prince then"},{"id":"semetey-1-2013:p1291:b003:l002","ordinal":174721,"en":"Had come face-to-face with him."},{"id":"semetey-1-2013:p1291:b003:l003","ordinal":174722,"en":"It was time for him to grow wrathful"},{"id":"semetey-1-2013:p1291:b003:l004","ordinal":174723,"en":"And stand firm amid upheaval."},{"id":"semetey-1-2013:p1291:b003:l005","ordinal":174724,"en":"It was time for your bloodthirsty hero"},{"id":"semetey-1-2013:p1291:b003:l006","ordinal":174725,"en":"And Khan Kojo to fight."},{"id":"semetey-1-2013:p1291:b003:l007","ordinal":174726,"en":"It was time to encounter"},{"id":"semetey-1-2013:p1291:b003:l008","ordinal":174727,"en":"The decree laid down by God."},{"id":"semetey-1-2013:p1291:b003:l009","ordinal":174728,"en":"It was time for Kojo and Semetey"},{"id":"semetey-1-2013:p1291:b003:l010","ordinal":174729,"en":"To fight to the death."},{"id":"semetey-1-2013:p1291:b003:l011","ordinal":174730,"en":"It was time to tear apart"},{"id":"semetey-1-2013:p1291:b003:l012","ordinal":174731,"en":"The folds of one another's ribs,"},{"id":"semetey-1-2013:p1291:b003:l013","ordinal":174732,"en":"And spill the dark blood"},{"id":"semetey-1-2013:p1291:b003:l014","ordinal":174733,"en":"Within their chests."},{"id":"semetey-1-2013:p1291:b003:l015","ordinal":174734,"en":"The kasaba banner floated in his hand;"},{"id":"semetey-1-2013:p1291:b003:l016","ordinal":174735,"en":"The inlaid spear leveled at the enemy"},{"id":"semetey-1-2013:p1291:b003:l017","ordinal":174736,"en":"Gleamed in his right hand."},{"id":"semetey-1-2013:p1291:b003:l018","ordinal":174737,"en":"Arbuurul flew like an arrow,"},{"id":"semetey-1-2013:p1291:b003:l019","ordinal":174738,"en":"Rearing and bounding in frenzy,"},{"id":"semetey-1-2013:p1291:b003:l020","ordinal":174739,"en":"Striding and straining forward."},{"id":"semetey-1-2013:p1291:b003:l021","ordinal":174740,"en":"Tossing his forelock to the sky,"},{"id":"semetey-1-2013:p1291:b003:l022","ordinal":174741,"en":"Driving his hooves into the earth,"},{"id":"semetey-1-2013:p1291:b003:l023","ordinal":174742,"en":"He moved in eager agitation,"},{"id":"semetey-1-2013:p1291:b003:l024","ordinal":174743,"en":"Showing the form of a roe deer."},{"id":"semetey-1-2013:p1291:b003:l025","ordinal":174744,"en":"Semetey settled into his wrath;"},{"id":"semetey-1-2013:p1291:b003:l026","ordinal":174745,"en":"Khan Manas's Zulfiqar"},{"id":"semetey-1-2013:p1291:b003:l027","ordinal":174746,"en":"Hung fitted at his side."},{"id":"semetey-1-2013:p1291:b003:l028","ordinal":174747,"en":"Coming out over a saddle-backed pass,"},{"id":"semetey-1-2013:p1291:b003:l029","ordinal":174748,"en":"Semetey stood before Kojo"},{"id":"semetey-1-2013:p1291:b003:l030","ordinal":174749,"en":"And said this:"},{"id":"semetey-1-2013:p1291:b003:l031","ordinal":174750,"en":"\"Should the prince himself"},{"id":"semetey-1-2013:p1291:b003:l032","ordinal":174751,"en":"Go about as a fugitive?"},{"id":"semetey-1-2013:p1291:b003:l033","ordinal":174752,"en":"When your khan has fled,"},{"id":"semetey-1-2013:p1291:b003:l034","ordinal":174753,"en":"Should he abandon his people?"},{"id":"semetey-1-2013:p1291:b003:l035","ordinal":174754,"en":"Should the nobleman himself,"},{"id":"semetey-1-2013:p1291:b003:l036","ordinal":174755,"en":"Parted from his renowned people,"},{"id":"semetey-1-2013:p1291:b003:l037","ordinal":174756,"en":"Go wandering in flight?"},{"id":"semetey-1-2013:p1291:b003:l038","ordinal":174757,"en":"O Chynkojo, khan-uncle,"},{"id":"semetey-1-2013:p1291:b003:l039","ordinal":174758,"en":"Do not turn your intentions elsewhere;"},{"id":"semetey-1-2013:p1291:b005:l001","ordinal":174759,"en":"Receive your Argyn people in Talas."},{"id":"semetey-1-2013:p1291:b005:l002","ordinal":174760,"en":"You have courage, braggart—"},{"id":"semetey-1-2013:p1291:b005:l003","ordinal":174761,"en":"Will you not win a name among the people?"},{"id":"semetey-1-2013:p1291:b005:l004","ordinal":174762,"en":"You commoner estranged from your folk."},{"id":"semetey-1-2013:p1291:b005:l005","ordinal":174763,"en":"Can one who wanders apart from his people"},{"id":"semetey-1-2013:p1291:b005:l006","ordinal":174764,"en":"Ever come to good?"},{"id":"semetey-1-2013:p1291:b005:l007","ordinal":174765,"en":"Is it proper conduct"},{"id":"semetey-1-2013:p1291:b005:l008","ordinal":174766,"en":"For your khan to wander?"},{"id":"semetey-1-2013:p1291:b005:l009","ordinal":174767,"en":"Can one call a wanderer like you"},{"id":"semetey-1-2013:p1291:b005:l010","ordinal":174768,"en":"A good man?"},{"id":"semetey-1-2013:p1291:b005:l011","ordinal":174769,"en":"Let me offer you livestock;"},{"id":"semetey-1-2013:p1291:b005:l012","ordinal":174770,"en":"If your grievance departs, Chynkojo,"},{"id":"semetey-1-2013:p1291:b005:l013","ordinal":174771,"en":"Take my fourteen swift horses,"},{"id":"semetey-1-2013:p1291:b005:l014","ordinal":174772,"en":"Take my sword-beaked elephant,"},{"id":"semetey-1-2013:p1291:b005:l015","ordinal":174773,"en":"My precious Kojo, heed my words!\""},{"id":"semetey-1-2013:p1291:b005:l016","ordinal":174774,"en":"Before he could turn Buurul's mouth,"},{"id":"semetey-1-2013:p1291:b005:l017","ordinal":174775,"en":"While he was still saying this,"},{"id":"semetey-1-2013:p1291:b005:l018","ordinal":174776,"en":"God now struck Kojo;"},{"id":"semetey-1-2013:p1291:b005:l019","ordinal":174777,"en":"His wrathful fury arose."},{"id":"semetey-1-2013:p1291:b005:l020","ordinal":174778,"en":"Calling him \"Manas's orphan son,\""},{"id":"semetey-1-2013:p1291:b005:l021","ordinal":174779,"en":"Chynkojo, son of Shygai,"},{"id":"semetey-1-2013:p1291:b005:l022","ordinal":174780,"en":"Raged like a blue tiger."},{"id":"semetey-1-2013:p1291:b005:l023","ordinal":174781,"en":"As though calamity had struck his wife,"},{"id":"semetey-1-2013:p1291:b005:l024","ordinal":174782,"en":"As though the pursuer were close behind,"},{"id":"semetey-1-2013:p1291:b005:l025","ordinal":174783,"en":"As though he were close upon his quarry,"},{"id":"semetey-1-2013:p1291:b005:l026","ordinal":174784,"en":"Kojo went mad then,"},{"id":"semetey-1-2013:p1291:b005:l027","ordinal":174785,"en":"As though his wife had borne a son."},{"id":"semetey-1-2013:p1291:b005:l028","ordinal":174786,"en":"Wrapping himself in his bulletproof coat,"},{"id":"semetey-1-2013:p1291:b005:l029","ordinal":174787,"en":"Ruinous Kojo prepared"},{"id":"semetey-1-2013:p1291:b005:l030","ordinal":174788,"en":"As though to overturn him."},{"id":"semetey-1-2013:p1291:b005:l031","ordinal":174789,"en":"He bit crosswise through the saddle;"},{"id":"semetey-1-2013:p1291:b005:l032","ordinal":174790,"en":"Utterly without public spirit,"},{"id":"semetey-1-2013:p1291:b005:l033","ordinal":174791,"en":"Chynkojo, son of Shygai,"},{"id":"semetey-1-2013:p1291:b005:l034","ordinal":174792,"en":"Was seized by his bloodthirsty nature:"},{"id":"semetey-1-2013:p1291:b005:l035","ordinal":174793,"en":"When roused, his venom was strong;"},{"id":"semetey-1-2013:p1291:b005:l036","ordinal":174794,"en":"This Kojo, son of Shygai,"},{"id":"semetey-1-2013:p1291:b005:l037","ordinal":174795,"en":"Laid flat whoever challenged him."},{"id":"semetey-1-2013:p1291:b005:l038","ordinal":174796,"en":"He settled a cast-iron club, house-sized,"},{"id":"semetey-1-2013:p1291:b005:l039","ordinal":174797,"en":"Across his back,"},{"id":"semetey-1-2013:p1292:b003:l001","ordinal":174798,"en":"Like a cloud about to rain again,"},{"id":"semetey-1-2013:p1292:b003:l002","ordinal":174799,"en":"His face turned wrathful."},{"id":"semetey-1-2013:p1292:b003:l003","ordinal":174800,"en":"He had no intention of making peace;"},{"id":"semetey-1-2013:p1292:b003:l004","ordinal":174801,"en":"If Kojo got him into his hands,"},{"id":"semetey-1-2013:p1292:b003:l005","ordinal":174802,"en":"He looked unlikely to leave him alive."},{"id":"semetey-1-2013:p1292:b003:l006","ordinal":174803,"en":"Look at the madman—"},{"id":"semetey-1-2013:p1292:b003:l007","ordinal":174804,"en":"Fit to be offered as a sacrifice;"},{"id":"semetey-1-2013:p1292:b003:l008","ordinal":174805,"en":"If spared because he was kin,"},{"id":"semetey-1-2013:p1292:b003:l009","ordinal":174806,"en":"He looked ready to cut off a head."},{"id":"semetey-1-2013:p1292:b003:l010","ordinal":174807,"en":"Kojo stood seething,"},{"id":"semetey-1-2013:p1292:b003:l011","ordinal":174808,"en":"Speaking to Semetey:"},{"id":"semetey-1-2013:p1292:b003:l012","ordinal":174809,"en":"\"That is a dark road from which none return,"},{"id":"semetey-1-2013:p1292:b003:l013","ordinal":174810,"en":"The road you have traveled halfway."},{"id":"semetey-1-2013:p1292:b003:l014","ordinal":174811,"en":"That was the host that deceived"},{"id":"semetey-1-2013:p1292:b003:l015","ordinal":174812,"en":"Your broad-chested father Manas six times."},{"id":"semetey-1-2013:p1292:b003:l016","ordinal":174813,"en":"Orphaned of your father,"},{"id":"semetey-1-2013:p1292:b003:l017","ordinal":174814,"en":"You are the one who wandered away"},{"id":"semetey-1-2013:p1292:b003:l018","ordinal":174815,"en":"To Temir Khan's city."},{"id":"semetey-1-2013:p1292:b003:l019","ordinal":174816,"en":"I am the one who grappled"},{"id":"semetey-1-2013:p1292:b003:l020","ordinal":174817,"en":"With your father Manas the lion."},{"id":"semetey-1-2013:p1292:b003:l021","ordinal":174818,"en":"Now my anger has risen and I stand enraged;"},{"id":"semetey-1-2013:p1292:b003:l022","ordinal":174819,"en":"I shall seize your migration from Talas,"},{"id":"semetey-1-2013:p1292:b003:l023","ordinal":174820,"en":"My orphan, son of Manas,"},{"id":"semetey-1-2013:p1292:b003:l024","ordinal":174821,"en":"And take my vengeance by crushing you."},{"id":"semetey-1-2013:p1292:b003:l025","ordinal":174822,"en":"You raided my migration from Keng-Kol;"},{"id":"semetey-1-2013:p1292:b003:l026","ordinal":174823,"en":"This year I shall avenge myself"},{"id":"semetey-1-2013:p1292:b003:l027","ordinal":174824,"en":"Upon those accursed slaves."},{"id":"semetey-1-2013:p1292:b003:l028","ordinal":174825,"en":"Into my palace like a white gull"},{"id":"semetey-1-2013:p1292:b003:l029","ordinal":174826,"en":"You brought Khan Bakai;"},{"id":"semetey-1-2013:p1292:b003:l030","ordinal":174827,"en":"The uncatchable Kara At"},{"id":"semetey-1-2013:p1292:b003:l031","ordinal":174828,"en":"You had seized, Semetey,"},{"id":"semetey-1-2013:p1292:b003:l032","ordinal":174829,"en":"And made slaves ride it bareback."},{"id":"semetey-1-2013:p1292:b003:l033","ordinal":174830,"en":"The line you drew at Keng-Kol,"},{"id":"semetey-1-2013:p1292:b003:l034","ordinal":174831,"en":"The spectacle you showed me yesterday—"},{"id":"semetey-1-2013:p1292:b003:l035","ordinal":174832,"en":"You have come to behold"},{"id":"semetey-1-2013:p1292:b003:l036","ordinal":174833,"en":"The torments of Judgment Day,"},{"id":"semetey-1-2013:p1292:b003:l037","ordinal":174834,"en":"Accursed Semetey;"},{"id":"semetey-1-2013:p1292:b003:l038","ordinal":174835,"en":"You have come to die"},{"id":"semetey-1-2013:p1292:b003:l039","ordinal":174836,"en":"At the hands of mighty me."},{"id":"semetey-1-2013:p1292:b004:l001","ordinal":174837,"en":"When I hear that you have camped at Talas,"},{"id":"semetey-1-2013:p1292:b004:l002","ordinal":174838,"en":"Accursed one, I shall seize"},{"id":"semetey-1-2013:p1292:b004:l003","ordinal":174839,"en":"Your wife Aichürök."},{"id":"semetey-1-2013:p1292:b004:l004","ordinal":174840,"en":"Upon Buurul, not yielded when asked,"},{"id":"semetey-1-2013:p1292:b004:l005","ordinal":174841,"en":"I shall cast a cold lasso;"},{"id":"semetey-1-2013:p1292:b004:l006","ordinal":174842,"en":"Taibuurul, not yielded when begged for,"},{"id":"semetey-1-2013:p1292:b004:l007","ordinal":174843,"en":"I shall take bareback as booty."},{"id":"semetey-1-2013:p1292:b004:l008","ordinal":174844,"en":"I shall bring splendid slaughter;"},{"id":"semetey-1-2013:p1292:b004:l009","ordinal":174845,"en":"You have greatly provoked my rage,"},{"id":"semetey-1-2013:p1292:b004:l010","ordinal":174846,"en":"And I shall cut off your head."},{"id":"semetey-1-2013:p1292:b004:l011","ordinal":174847,"en":"I shall drag you along the road"},{"id":"semetey-1-2013:p1292:b004:l012","ordinal":174848,"en":"And expose you to the Dangyts!"}]
