[{"id":"semetey-1-2013:p0690:b004:l029","ordinal":129281,"en":"That day, my wretched soul"},{"id":"semetey-1-2013:p0690:b004:l030","ordinal":129282,"en":"Burned and blazed in anguish."},{"id":"semetey-1-2013:p0690:b004:l031","ordinal":129283,"en":"Yesterday, when clear dawn broke,"},{"id":"semetey-1-2013:p0690:b004:l032","ordinal":129284,"en":"When light fell upon the earth,"},{"id":"semetey-1-2013:p0690:b004:l033","ordinal":129285,"en":"When the Taraza stars set,"},{"id":"semetey-1-2013:p0690:b004:l034","ordinal":129286,"en":"When clear dawn rose,"},{"id":"semetey-1-2013:p0690:b004:l035","ordinal":129287,"en":"Waking with a start from sleep,"},{"id":"semetey-1-2013:p0690:b004:l036","ordinal":129288,"en":"Turning onto my right side,"},{"id":"semetey-1-2013:p0690:b004:l037","ordinal":129289,"en":"I leaped up."},{"id":"semetey-1-2013:p0690:b004:l038","ordinal":129290,"en":"What God has done—"},{"id":"semetey-1-2013:p0690:b004:l039","ordinal":129291,"en":"There is no choice but to bear it."},{"id":"semetey-1-2013:p0691:b003:l001","ordinal":129292,"en":"When I leaped up,"},{"id":"semetey-1-2013:p0691:b003:l002","ordinal":129293,"en":"It had been a sleeping dream;"},{"id":"semetey-1-2013:p0691:b003:l003","ordinal":129294,"en":"There was no such mortal in my arms."},{"id":"semetey-1-2013:p0691:b003:l004","ordinal":129295,"en":"It was God's doing."},{"id":"semetey-1-2013:p0691:b003:l005","ordinal":129296,"en":"Wishing to embrace him and sin,"},{"id":"semetey-1-2013:p0691:b003:l006","ordinal":129297,"en":"Wishing to play in his embrace,"},{"id":"semetey-1-2013:p0691:b003:l007","ordinal":129298,"en":"When my eyes closed in sleep,"},{"id":"semetey-1-2013:p0691:b003:l008","ordinal":129299,"en":"I would join him and play."},{"id":"semetey-1-2013:p0691:b003:l009","ordinal":129300,"en":"When I woke, no such mortal was there;"},{"id":"semetey-1-2013:p0691:b003:l010","ordinal":129301,"en":"Then I would wail and burn with anguish."},{"id":"semetey-1-2013:p0691:b003:l011","ordinal":129302,"en":"For the lover I saw in my dream,"},{"id":"semetey-1-2013:p0691:b003:l012","ordinal":129303,"en":"Wishing I might see him awake,"},{"id":"semetey-1-2013:p0691:b003:l013","ordinal":129304,"en":"I was filled with longing."},{"id":"semetey-1-2013:p0691:b003:l014","ordinal":129305,"en":"For the boy called Almambet,"},{"id":"semetey-1-2013:p0691:b003:l015","ordinal":129306,"en":"To see him once while awake,"},{"id":"semetey-1-2013:p0691:b003:l016","ordinal":129307,"en":"And then to die—"},{"id":"semetey-1-2013:p0691:b003:l017","ordinal":129308,"en":"That was my prayer."},{"id":"semetey-1-2013:p0691:b003:l018","ordinal":129309,"en":"As I longed for Almambet,"},{"id":"semetey-1-2013:p0691:b003:l020","ordinal":129310,"en":"Giving out gold by the pood,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0691:b003:l021","ordinal":129311,"en":"I questioned those who knew."},{"id":"semetey-1-2013:p0691:b003:l022","ordinal":129312,"en":"Guarding the palace,"},{"id":"semetey-1-2013:p0691:b003:l023","ordinal":129313,"en":"My father the khan's champion called Lungkodu"},{"id":"semetey-1-2013:p0691:b003:l025","ordinal":129314,"en":"Told me the truth:"},{"id":"semetey-1-2013:p0691:b003:l026","ordinal":129315,"en":"“In the city of Tash-Kopuro,"},{"id":"semetey-1-2013:p0691:b003:l027","ordinal":129316,"en":"His father is a lesser khan."},{"id":"semetey-1-2013:p0691:b003:l028","ordinal":129317,"en":"Having studied sorcery,"},{"id":"semetey-1-2013:p0691:b003:l029","ordinal":129318,"en":"He startles the eyes of those who see him."},{"id":"semetey-1-2013:p0691:b003:l030","ordinal":129319,"en":"He has reached twelve years of age,"},{"id":"semetey-1-2013:p0691:b003:l031","ordinal":129320,"en":"Rides the horse Aysarala,"},{"id":"semetey-1-2013:p0691:b003:l032","ordinal":129321,"en":"And is a son called Almambet."},{"id":"semetey-1-2013:p0691:b003:l033","ordinal":129322,"en":"When you look at Almambet,"},{"id":"semetey-1-2013:p0691:b003:l034","ordinal":129323,"en":"He shines as though moonlight fell upon him—"},{"id":"semetey-1-2013:p0691:b003:l035","ordinal":129324,"en":"Such a boy is Almambet."},{"id":"semetey-1-2013:p0691:b003:l036","ordinal":129325,"en":"There is no boy so handsome;"},{"id":"semetey-1-2013:p0691:b003:l037","ordinal":129326,"en":"There is no way to capture him."},{"id":"semetey-1-2013:p0691:b003:l038","ordinal":129327,"en":"In China, the land of forty khans,"},{"id":"semetey-1-2013:p0691:b003:l039","ordinal":129328,"en":"There is no boy so wonderful."},{"id":"semetey-1-2013:p0691:b005:l001","ordinal":129329,"en":"Yesterday, when he toppled the official's banner,"},{"id":"semetey-1-2013:p0691:b005:l003","ordinal":129330,"en":"Sarala with his stake-like neck,"},{"id":"semetey-1-2013:p0691:b005:l005","ordinal":129331,"en":"I saw him here and burned with longing.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0691:b005:l006","ordinal":129332,"en":"Yesterday, Sarala with his cow-like haunches,"},{"id":"semetey-1-2013:p0691:b005:l007","ordinal":129333,"en":"When he sent him surging along,"},{"id":"semetey-1-2013:p0691:b005:l008","ordinal":129334,"en":"When he pursued Kongurbay,"},{"id":"semetey-1-2013:p0691:b005:l009","ordinal":129335,"en":"I saw him here and burned with longing."},{"id":"semetey-1-2013:p0691:b005:l010","ordinal":129336,"en":"Yesterday, matted-tailed Sarala,"},{"id":"semetey-1-2013:p0691:b005:l011","ordinal":129337,"en":"When he sent him racing,"},{"id":"semetey-1-2013:p0691:b005:l012","ordinal":129338,"en":"Of the great lord Kongurbay,"},{"id":"semetey-1-2013:p0691:b005:l013","ordinal":129339,"en":"When he chased his sentry,"},{"id":"semetey-1-2013:p0691:b005:l014","ordinal":129340,"en":"I saw the truth for myself;"},{"id":"semetey-1-2013:p0691:b005:l015","ordinal":129341,"en":"I was filled with longing.”"},{"id":"semetey-1-2013:p0691:b005:l016","ordinal":129342,"en":"As the champion spoke,"},{"id":"semetey-1-2013:p0691:b005:l017","ordinal":129343,"en":"“That is the one I saw in my dream,” I said,"},{"id":"semetey-1-2013:p0691:b005:l018","ordinal":129344,"en":"My heart melting with affection,"},{"id":"semetey-1-2013:p0691:b005:l020","ordinal":129345,"en":"My thoughts drawn away,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0691:b005:l021","ordinal":129346,"en":"Tears spilling from my eyes."},{"id":"semetey-1-2013:p0691:b005:l022","ordinal":129347,"en":"That day, my wretched soul"},{"id":"semetey-1-2013:p0691:b005:l023","ordinal":129348,"en":"Ached and throbbed with burning pain."},{"id":"semetey-1-2013:p0691:b005:l024","ordinal":129349,"en":"For the one I saw in my dream,"},{"id":"semetey-1-2013:p0691:b005:l025","ordinal":129350,"en":"To see him awake as I wished,"},{"id":"semetey-1-2013:p0691:b005:l026","ordinal":129351,"en":"And then to die—"},{"id":"semetey-1-2013:p0691:b005:l027","ordinal":129352,"en":"That was what I asked of God."},{"id":"semetey-1-2013:p0691:b005:l028","ordinal":129353,"en":"Pouring out gold by the pood,"},{"id":"semetey-1-2013:p0691:b005:l029","ordinal":129354,"en":"Wretched me, I scattered so much of my wealth."},{"id":"semetey-1-2013:p0691:b005:l030","ordinal":129355,"en":"Hoping to see him in the end,"},{"id":"semetey-1-2013:p0691:b005:l031","ordinal":129356,"en":"I spent so much of my strength."},{"id":"semetey-1-2013:p0691:b005:l032","ordinal":129357,"en":"I burned, wondering if I would see him,"},{"id":"semetey-1-2013:p0691:b005:l033","ordinal":129358,"en":"And kept asking more and more."},{"id":"semetey-1-2013:p0691:b005:l034","ordinal":129359,"en":"My heart melted with affection;"},{"id":"semetey-1-2013:p0691:b005:l035","ordinal":129360,"en":"My heart of flesh stretched with longing."},{"id":"semetey-1-2013:p0691:b005:l036","ordinal":129361,"en":"The person I had seen in my dream—"},{"id":"semetey-1-2013:p0691:b005:l037","ordinal":129362,"en":"To see him awake and die,"},{"id":"semetey-1-2013:p0691:b005:l038","ordinal":129363,"en":"I wandered, sick with longing,"},{"id":"semetey-1-2013:p0691:b005:l039","ordinal":129364,"en":"Wishing to see Almambet,"},{"id":"semetey-1-2013:p0692:b003:l002","ordinal":129365,"en":"Whether I sat or rose, it was in my thoughts;","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0692:b003:l003","ordinal":129366,"en":"I marveled at what a thing this was."},{"id":"semetey-1-2013:p0692:b003:l004","ordinal":129367,"en":"As I looked in wonder,"},{"id":"semetey-1-2013:p0692:b003:l005","ordinal":129368,"en":"I heard news of the turmoil."},{"id":"semetey-1-2013:p0692:b003:l006","ordinal":129369,"en":"That day I saw this world's"},{"id":"semetey-1-2013:p0692:b003:l007","ordinal":129370,"en":"Disorder that would never heal."},{"id":"semetey-1-2013:p0692:b003:l008","ordinal":129371,"en":"Of my Almam, whom I saw in my dream,"},{"id":"semetey-1-2013:p0692:b003:l009","ordinal":129372,"en":"Now I saw the wonder while awake."},{"id":"semetey-1-2013:p0692:b003:l010","ordinal":129373,"en":"When noon had passed,"},{"id":"semetey-1-2013:p0692:b003:l011","ordinal":129374,"en":"When the afternoon hour arrived,"},{"id":"semetey-1-2013:p0692:b003:l012","ordinal":129375,"en":"Gray-mottled pennants, red banners,"},{"id":"semetey-1-2013:p0692:b003:l013","ordinal":129376,"en":"A great uproar all along the way,"},{"id":"semetey-1-2013:p0692:b003:l014","ordinal":129377,"en":"A white-mottled field, red banners,"},{"id":"semetey-1-2013:p0692:b003:l015","ordinal":129378,"en":"Piercing cries and tumult,"},{"id":"semetey-1-2013:p0692:b003:l016","ordinal":129379,"en":"Drums booming,"},{"id":"semetey-1-2013:p0692:b003:l017","ordinal":129380,"en":"Great guns cracking,"},{"id":"semetey-1-2013:p0692:b003:l018","ordinal":129381,"en":"Bows rattling,"},{"id":"semetey-1-2013:p0692:b003:l019","ordinal":129382,"en":"Great guns clattering,"},{"id":"semetey-1-2013:p0692:b003:l020","ordinal":129383,"en":"The golden-doored gateway"},{"id":"semetey-1-2013:p0692:b003:l021","ordinal":129384,"en":"Of my father Esen Khan's palace—"},{"id":"semetey-1-2013:p0692:b003:l022","ordinal":129385,"en":"With six strong mules"},{"id":"semetey-1-2013:p0692:b003:l023","ordinal":129386,"en":"They pulled its gates,"},{"id":"semetey-1-2013:p0692:b003:l024","ordinal":129387,"en":"And sixty champion guards"},{"id":"semetey-1-2013:p0692:b003:l025","ordinal":129388,"en":"Had them opened swiftly."},{"id":"semetey-1-2013:p0692:b003:l026","ordinal":129389,"en":"When they opened them and looked,"},{"id":"semetey-1-2013:p0692:b003:l027","ordinal":129390,"en":"Sixty governors, forty officials,"},{"id":"semetey-1-2013:p0692:b003:l028","ordinal":129391,"en":"Their elder,"},{"id":"semetey-1-2013:p0692:b003:l029","ordinal":129392,"en":"With a cotton sash and broad boots,"},{"id":"semetey-1-2013:p0692:b003:l030","ordinal":129393,"en":"Was Kongurbay, khan of the Kalmyks."},{"id":"semetey-1-2013:p0692:b003:l031","ordinal":129394,"en":"If you ask about Kongurbay,"},{"id":"semetey-1-2013:p0692:b003:l032","ordinal":129395,"en":"As for these Chinese,"},{"id":"semetey-1-2013:p0692:b003:l034","ordinal":129396,"en":"He was the mighty khan of the Kalmyks.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0692:b003:l035","ordinal":129397,"en":"Of those Chinese called Kalmyks,"},{"id":"semetey-1-2013:p0692:b003:l037","ordinal":129398,"en":"Of the Chinese and Kalmyks,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0692:b003:l038","ordinal":129399,"en":"He was the formidable, mighty lord."},{"id":"semetey-1-2013:p0692:b003:l039","ordinal":129400,"en":"Know his greatness from this:"},{"id":"semetey-1-2013:p0692:b004:l001","ordinal":129401,"en":"He settled wherever the land was best,"},{"id":"semetey-1-2013:p0692:b004:l002","ordinal":129402,"en":"And answered to no one."},{"id":"semetey-1-2013:p0692:b004:l003","ordinal":129403,"en":"His ox grew old and he himself died;"},{"id":"semetey-1-2013:p0692:b004:l004","ordinal":129404,"en":"They divided the dead man's livestock equally."},{"id":"semetey-1-2013:p0692:b004:l005","ordinal":129405,"en":"He consecrated his goat as sacred;"},{"id":"semetey-1-2013:p0692:b004:l006","ordinal":129406,"en":"That was this unbeliever's custom."},{"id":"semetey-1-2013:p0692:b004:l007","ordinal":129407,"en":"He never wore underdrawers,"},{"id":"semetey-1-2013:p0692:b004:l008","ordinal":129408,"en":"Nor sat down to urinate on the ground."},{"id":"semetey-1-2013:p0692:b004:l009","ordinal":129409,"en":"Such was that unbeliever's way:"},{"id":"semetey-1-2013:p0692:b004:l010","ordinal":129410,"en":"He did not consort with women."},{"id":"semetey-1-2013:p0692:b004:l011","ordinal":129411,"en":"The horse he rode was untamed;"},{"id":"semetey-1-2013:p0692:b004:l012","ordinal":129412,"en":"If he saw a woman, he kept apart."},{"id":"semetey-1-2013:p0692:b004:l013","ordinal":129413,"en":"He caught and saddled his unruly horse."},{"id":"semetey-1-2013:p0692:b004:l014","ordinal":129414,"en":"Before a great idol the size of a house,"},{"id":"semetey-1-2013:p0692:b004:l015","ordinal":129415,"en":"Saying, “This is God,”"},{"id":"semetey-1-2013:p0692:b004:l016","ordinal":129416,"en":"He worshiped from morning until night."},{"id":"semetey-1-2013:p0692:b004:l017","ordinal":129417,"en":"Among the Chinese in Beijing,"},{"id":"semetey-1-2013:p0692:b004:l018","ordinal":129418,"en":"There arose a khan called Alooko."},{"id":"semetey-1-2013:p0692:b004:l019","ordinal":129419,"en":"Kongurbay, son of Alooko—"},{"id":"semetey-1-2013:p0692:b004:l020","ordinal":129420,"en":"The thunder of his approach took lives."},{"id":"semetey-1-2013:p0692:b004:l021","ordinal":129421,"en":"That khan of Beijing, Kongurbay,"},{"id":"semetey-1-2013:p0692:b004:l022","ordinal":129422,"en":"Was a mighty khan on watch,"},{"id":"semetey-1-2013:p0692:b004:l023","ordinal":129423,"en":"A resolute and powerful man."},{"id":"semetey-1-2013:p0692:b004:l024","ordinal":129424,"en":"Sixty Chinese and countless officials,"},{"id":"semetey-1-2013:p0692:b004:l025","ordinal":129425,"en":"With Kongurbay their elder,"},{"id":"semetey-1-2013:p0692:b004:l026","ordinal":129426,"en":"Fled together in a clattering rush."},{"id":"semetey-1-2013:p0692:b004:l027","ordinal":129427,"en":"Before Esen Khan"},{"id":"semetey-1-2013:p0692:b004:l028","ordinal":129428,"en":"He came in lamenting, to make his complaint."},{"id":"semetey-1-2013:p0692:b004:l029","ordinal":129429,"en":"When I looked at Kongurbay,"},{"id":"semetey-1-2013:p0692:b004:l030","ordinal":129430,"en":"He was a swirling mass of dust;"},{"id":"semetey-1-2013:p0692:b004:l032","ordinal":129431,"en":"Kongurbay up above","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0692:b004:l033","ordinal":129432,"en":"Was deeply troubled in spirit;"},{"id":"semetey-1-2013:p0692:b004:l034","ordinal":129433,"en":"Algara beneath him"},{"id":"semetey-1-2013:p0692:b004:l035","ordinal":129434,"en":"Looked gray with dust."},{"id":"semetey-1-2013:p0692:b004:l036","ordinal":129435,"en":"Kongurbay up above"},{"id":"semetey-1-2013:p0692:b004:l037","ordinal":129436,"en":"Was bathed in pitch-black blood;"},{"id":"semetey-1-2013:p0692:b004:l038","ordinal":129437,"en":"Algara beneath him"},{"id":"semetey-1-2013:p0692:b004:l039","ordinal":129438,"en":"Was bathed in scarlet blood."},{"id":"semetey-1-2013:p0693:b003:l001","ordinal":129439,"en":"Then Kongurbay spoke a word,"},{"id":"semetey-1-2013:p0693:b003:l002","ordinal":129440,"en":"Lodging foul words in my thoughts."},{"id":"semetey-1-2013:p0693:b003:l003","ordinal":129441,"en":"Before my father Esen Khan,"},{"id":"semetey-1-2013:p0693:b003:l004","ordinal":129442,"en":"He turned Algara's head."},{"id":"semetey-1-2013:p0693:b003:l005","ordinal":129443,"en":"Shouting his shitty words without restraint,"},{"id":"semetey-1-2013:p0693:b003:l006","ordinal":129444,"en":"Before my father the khan,"},{"id":"semetey-1-2013:p0693:b003:l007","ordinal":129445,"en":"He cursed in Kalmyk:"},{"id":"semetey-1-2013:p0693:b003:l008","ordinal":129446,"en":"“My soul is burning, Esen Khan!"},{"id":"semetey-1-2013:p0693:b003:l009","ordinal":129447,"en":"I met with trouble on the watch."},{"id":"semetey-1-2013:p0693:b003:l010","ordinal":129448,"en":"Azyz Khan's bastard fool,"},{"id":"semetey-1-2013:p0693:b003:l011","ordinal":129449,"en":"His son who resembles a Kyrgyz—"},{"id":"semetey-1-2013:p0693:b003:l012","ordinal":129450,"en":"From him I saw this spectacle."},{"id":"semetey-1-2013:p0693:b003:l013","ordinal":129451,"en":"Ever since I became Kongurbay,"},{"id":"semetey-1-2013:p0693:b003:l014","ordinal":129452,"en":"Ever since I bore the name Kongurbay,"},{"id":"semetey-1-2013:p0693:b003:l015","ordinal":129453,"en":"The black Chinese and Manchus—"},{"id":"semetey-1-2013:p0693:b003:l016","ordinal":129454,"en":"As khan, I drained their people;"},{"id":"semetey-1-2013:p0693:b003:l017","ordinal":129455,"en":"I went out and camped on watch."},{"id":"semetey-1-2013:p0693:b003:l018","ordinal":129456,"en":"The black Chinese and Manchus,"},{"id":"semetey-1-2013:p0693:b003:l019","ordinal":129457,"en":"Even if all their people gathered,"},{"id":"semetey-1-2013:p0693:b003:l020","ordinal":129458,"en":"No one brought me trouble."},{"id":"semetey-1-2013:p0693:b003:l021","ordinal":129459,"en":"Let their forty tribes gather:"},{"id":"semetey-1-2013:p0693:b003:l022","ordinal":129460,"en":"No one remained who could stand against me."},{"id":"semetey-1-2013:p0693:b003:l023","ordinal":129461,"en":"When I moved, dust rose from the ground;"},{"id":"semetey-1-2013:p0693:b003:l024","ordinal":129462,"en":"My wrath took lives."},{"id":"semetey-1-2013:p0693:b003:l025","ordinal":129463,"en":"Today I met with trouble—"},{"id":"semetey-1-2013:p0693:b003:l027","ordinal":129464,"en":"A spectacle no man would cause.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0693:b003:l028","ordinal":129465,"en":"From the place where I stood watch,"},{"id":"semetey-1-2013:p0693:b003:l030","ordinal":129466,"en":"From the bare ground for tethering horses,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0693:b003:l031","ordinal":129467,"en":"Azyz Khan's bastard pig,"},{"id":"semetey-1-2013:p0693:b003:l032","ordinal":129468,"en":"The unbeliever called Almambet—"},{"id":"semetey-1-2013:p0693:b003:l033","ordinal":129469,"en":"From him I suffered humiliation."},{"id":"semetey-1-2013:p0693:b003:l034","ordinal":129470,"en":"I came back alive, without dying."},{"id":"semetey-1-2013:p0693:b003:l035","ordinal":129471,"en":"The torments of Judgment Day—"},{"id":"semetey-1-2013:p0693:b003:l036","ordinal":129472,"en":"Without seeing them, I came back alive."},{"id":"semetey-1-2013:p0693:b003:l037","ordinal":129473,"en":"From that damned pig"},{"id":"semetey-1-2013:p0693:b003:l038","ordinal":129474,"en":"I came back alive, without dying."},{"id":"semetey-1-2013:p0693:b003:l039","ordinal":129475,"en":"The unbeliever has reached twelve years of age."},{"id":"semetey-1-2013:p0693:b004:l001","ordinal":129476,"en":"At fifteen, he will bring us to no good;"},{"id":"semetey-1-2013:p0693:b004:l002","ordinal":129477,"en":"He will leave none of us unharmed."},{"id":"semetey-1-2013:p0693:b004:l003","ordinal":129478,"en":"He will not let us turn a plow;"},{"id":"semetey-1-2013:p0693:b004:l004","ordinal":129479,"en":"He will not let us remain in Beijing."},{"id":"semetey-1-2013:p0693:b004:l005","ordinal":129480,"en":"Listen carefully to my words."},{"id":"semetey-1-2013:p0693:b004:l006","ordinal":129481,"en":"When he reaches sixteen,"},{"id":"semetey-1-2013:p0693:b004:l007","ordinal":129482,"en":"He will not let us ride a maned mare,"},{"id":"semetey-1-2013:p0693:b004:l008","ordinal":129483,"en":"Nor let us eat a fat-tailed lamb."},{"id":"semetey-1-2013:p0693:b004:l009","ordinal":129484,"en":"He will not let us keep proper watch;"},{"id":"semetey-1-2013:p0693:b004:l010","ordinal":129485,"en":"From China's people under forty khans,"},{"id":"semetey-1-2013:p0693:b004:l011","ordinal":129486,"en":"He will not let us collect a scrap of tax."},{"id":"semetey-1-2013:p0693:b004:l012","ordinal":129487,"en":"If you live, you will see:"},{"id":"semetey-1-2013:p0693:b004:l013","ordinal":129488,"en":"We will see many a spectacle;"},{"id":"semetey-1-2013:p0693:b004:l014","ordinal":129489,"en":"If we resist, we will die."},{"id":"semetey-1-2013:p0693:b004:l015","ordinal":129490,"en":"If that fool lives,"},{"id":"semetey-1-2013:p0693:b004:l016","ordinal":129491,"en":"We will suffer sore humiliation from him."},{"id":"semetey-1-2013:p0693:b004:l017","ordinal":129492,"en":"Cut down the riverside willow:"},{"id":"semetey-1-2013:p0693:b004:l018","ordinal":129493,"en":"It is spreading in flames."},{"id":"semetey-1-2013:p0693:b004:l019","ordinal":129494,"en":"My khan, restrain Almambet!"},{"id":"semetey-1-2013:p0693:b004:l020","ordinal":129495,"en":"If you do not restrain Almambet,"},{"id":"semetey-1-2013:p0693:b004:l021","ordinal":129496,"en":"If you do not find his roots and cut them,"},{"id":"semetey-1-2013:p0693:b004:l022","ordinal":129497,"en":"Either let him stay in Beijing,"},{"id":"semetey-1-2013:p0693:b004:l023","ordinal":129498,"en":"Or let me stay in Beijing.”"},{"id":"semetey-1-2013:p0693:b004:l024","ordinal":129499,"en":"So saying, Kongurbay"},{"id":"semetey-1-2013:p0693:b004:l025","ordinal":129500,"en":"Spoke to my father,"},{"id":"semetey-1-2013:p0693:b004:l026","ordinal":129501,"en":"And lodged foul words in my heart."},{"id":"semetey-1-2013:p0693:b004:l027","ordinal":129502,"en":"I stood listening to him,"},{"id":"semetey-1-2013:p0693:b004:l028","ordinal":129503,"en":"While he went on speaking."},{"id":"semetey-1-2013:p0693:b004:l029","ordinal":129504,"en":"“Agree to what I say,” he said,"},{"id":"semetey-1-2013:p0693:b004:l030","ordinal":129505,"en":"“Give me Kan-Zhaylak,” he said."},{"id":"semetey-1-2013:p0693:b004:l031","ordinal":129506,"en":"Before a word could be spoken,"},{"id":"semetey-1-2013:p0693:b004:l032","ordinal":129507,"en":"Before an eye could open and close,"},{"id":"semetey-1-2013:p0693:b004:l033","ordinal":129508,"en":"He struck Sarala once on the thigh,"},{"id":"semetey-1-2013:p0693:b004:l034","ordinal":129509,"en":"Into the countless Chinese"},{"id":"semetey-1-2013:p0693:b004:l035","ordinal":129510,"en":"He plunged and attacked."},{"id":"semetey-1-2013:p0693:b004:l036","ordinal":129511,"en":"He who would bow to no one in the world,"},{"id":"semetey-1-2013:p0693:b004:l037","ordinal":129512,"en":"The wretch who fancied himself a hero—"},{"id":"semetey-1-2013:p0693:b004:l039","ordinal":129513,"en":"I could find no way to deal with the wretch.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0694:b003:l002","ordinal":129514,"en":"My eyes rolled wildly,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0694:b003:l003","ordinal":129515,"en":"My legs dangled."},{"id":"semetey-1-2013:p0694:b003:l004","ordinal":129516,"en":"My strength fled, my power drained,"},{"id":"semetey-1-2013:p0694:b003:l005","ordinal":129517,"en":"Black blood poured from my side."},{"id":"semetey-1-2013:p0694:b003:l006","ordinal":129518,"en":"To spill my blood by the flaskful,"},{"id":"semetey-1-2013:p0694:b003:l007","ordinal":129519,"en":"That fool came close"},{"id":"semetey-1-2013:p0694:b003:l008","ordinal":129520,"en":"To tearing apart my ribs."},{"id":"semetey-1-2013:p0694:b003:l009","ordinal":129521,"en":"Sixty Chinese and countless officials"},{"id":"semetey-1-2013:p0694:b003:l010","ordinal":129522,"en":"Stepped between us,"},{"id":"semetey-1-2013:p0694:b003:l011","ordinal":129523,"en":"And safe and sound"},{"id":"semetey-1-2013:p0694:b003:l012","ordinal":129524,"en":"They pulled me free."},{"id":"semetey-1-2013:p0694:b003:l013","ordinal":129525,"en":"Seven Kalmyks on that road"},{"id":"semetey-1-2013:p0694:b003:l014","ordinal":129526,"en":"Died while helping me."},{"id":"semetey-1-2013:p0694:b003:l015","ordinal":129527,"en":"In the desert of It-Olbos"},{"id":"semetey-1-2013:p0694:b003:l016","ordinal":129528,"en":"He began the havoc."},{"id":"semetey-1-2013:p0694:b003:l017","ordinal":129529,"en":"From atop Alkara,"},{"id":"semetey-1-2013:p0694:b003:l019","ordinal":129530,"en":"He left me butchered.”","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0694:b003:l020","ordinal":129531,"en":"As Kongurbay spoke,"},{"id":"semetey-1-2013:p0694:b003:l021","ordinal":129532,"en":"Hearing the full truth,"},{"id":"semetey-1-2013:p0694:b003:l022","ordinal":129533,"en":"I wept bitterly to the one God:"},{"id":"semetey-1-2013:p0694:b003:l023","ordinal":129534,"en":"“To see his face,” I said,"},{"id":"semetey-1-2013:p0694:b003:l024","ordinal":129535,"en":"“To see him, and then to die,” I said,"},{"id":"semetey-1-2013:p0694:b003:l025","ordinal":129536,"en":"And stood weeping to God."}]
