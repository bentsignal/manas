[{"id":"semetey-1-2013:p0937:b005:l027","ordinal":147713,"en":"Let us bring turmoil upon Oogan."},{"id":"semetey-1-2013:p0937:b005:l028","ordinal":147714,"en":"Manas's son Semetey—"},{"id":"semetey-1-2013:p0937:b005:l029","ordinal":147715,"en":"Let us seize his wife."},{"id":"semetey-1-2013:p0937:b005:l030","ordinal":147716,"en":"If we contend for Aichurok,"},{"id":"semetey-1-2013:p0937:b005:l031","ordinal":147717,"en":"Let all your livestock be scattered!"},{"id":"semetey-1-2013:p0937:b005:l032","ordinal":147718,"en":"Manas's son Semetey—"},{"id":"semetey-1-2013:p0937:b005:l033","ordinal":147719,"en":"When we seize his wife,"},{"id":"semetey-1-2013:p0937:b005:l034","ordinal":147720,"en":"Will any sorrow remain in you?"},{"id":"semetey-1-2013:p0937:b005:l035","ordinal":147721,"en":"Against formidable Oogan,"},{"id":"semetey-1-2013:p0937:b005:l036","ordinal":147722,"en":"Let us wreak great havoc."},{"id":"semetey-1-2013:p0937:b005:l037","ordinal":147723,"en":"Destroyer Toltoi, hear me!"},{"id":"semetey-1-2013:p0937:b005:l038","ordinal":147724,"en":"Aichurok, swaying gracefully,"},{"id":"semetey-1-2013:p0937:b005:l039","ordinal":147725,"en":"Let us take her as a bride."},{"id":"semetey-1-2013:p0938:b003:l001","ordinal":147726,"en":"If we descend upon them and encamp,"},{"id":"semetey-1-2013:p0938:b003:l002","ordinal":147727,"en":"If they do not agree to our words,"},{"id":"semetey-1-2013:p0938:b003:l003","ordinal":147728,"en":"If he will not give his aging daughter,"},{"id":"semetey-1-2013:p0938:b003:l004","ordinal":147729,"en":"Making their willow lattice walls weep,"},{"id":"semetey-1-2013:p0938:b003:l005","ordinal":147730,"en":"Let us bring distress and turmoil;"},{"id":"semetey-1-2013:p0938:b003:l006","ordinal":147731,"en":"Let us seize her in this way."},{"id":"semetey-1-2013:p0938:b003:l007","ordinal":147732,"en":"If he will not listen to good words,"},{"id":"semetey-1-2013:p0938:b003:l008","ordinal":147733,"en":"If he will not give the girl we name,"},{"id":"semetey-1-2013:p0938:b003:l009","ordinal":147734,"en":"I have words to address to him."},{"id":"semetey-1-2013:p0938:b003:l010","ordinal":147735,"en":"The one who destroys anyone who challenges him,"},{"id":"semetey-1-2013:p0938:b003:l011","ordinal":147736,"en":"I myself, leopard Kojo, am here."},{"id":"semetey-1-2013:p0938:b003:l012","ordinal":147737,"en":"Tearing the pillars from their houses,"},{"id":"semetey-1-2013:p0938:b003:l013","ordinal":147738,"en":"Slaughtering every one of their people,"},{"id":"semetey-1-2013:p0938:b003:l014","ordinal":147739,"en":"Diverting water into their gardens,"},{"id":"semetey-1-2013:p0938:b003:l015","ordinal":147740,"en":"See how much strife I shall cause!"},{"id":"semetey-1-2013:p0938:b003:l016","ordinal":147741,"en":"I shall wage war everywhere,"},{"id":"semetey-1-2013:p0938:b003:l017","ordinal":147742,"en":"Diverting water to their poplars,"},{"id":"semetey-1-2013:p0938:b003:l018","ordinal":147743,"en":"I shall send them staggering."},{"id":"semetey-1-2013:p0938:b003:l019","ordinal":147744,"en":"Whether he gives her or not,"},{"id":"semetey-1-2013:p0938:b003:l020","ordinal":147745,"en":"I shall seize Aichurok!"},{"id":"semetey-1-2013:p0938:b003:l021","ordinal":147746,"en":"I shall bring uproar upon his settlement,"},{"id":"semetey-1-2013:p0938:b003:l022","ordinal":147747,"en":"Utterly exhausting his resources,"},{"id":"semetey-1-2013:p0938:b003:l023","ordinal":147748,"en":"In the end I shall take Churok!"},{"id":"semetey-1-2013:p0938:b003:l024","ordinal":147749,"en":"When spring draws near,"},{"id":"semetey-1-2013:p0938:b003:l025","ordinal":147750,"en":"I shall not let them ride maned fillies."},{"id":"semetey-1-2013:p0938:b003:l026","ordinal":147751,"en":"Bringing suffering and distress,"},{"id":"semetey-1-2013:p0938:b003:l027","ordinal":147752,"en":"I shall take Churok in this way."},{"id":"semetey-1-2013:p0938:b003:l028","ordinal":147753,"en":"When autumn comes,"},{"id":"semetey-1-2013:p0938:b003:l029","ordinal":147754,"en":"I shall not let them eat fat-tailed yearlings."},{"id":"semetey-1-2013:p0938:b003:l030","ordinal":147755,"en":"When spring comes,"},{"id":"semetey-1-2013:p0938:b003:l031","ordinal":147756,"en":"I shall not let them ready their yoke pins,"},{"id":"semetey-1-2013:p0938:b003:l032","ordinal":147757,"en":"Nor harness their pair of oxen,"},{"id":"semetey-1-2013:p0938:b003:l033","ordinal":147758,"en":"Nor open the face of the earth,"},{"id":"semetey-1-2013:p0938:b003:l034","ordinal":147759,"en":"Nor scatter a handful of grain."},{"id":"semetey-1-2013:p0938:b003:l035","ordinal":147760,"en":"I shall use a foul stratagem,"},{"id":"semetey-1-2013:p0938:b003:l036","ordinal":147761,"en":"I shall slaughter all their people,"},{"id":"semetey-1-2013:p0938:b003:l037","ordinal":147762,"en":"I shall make such havoc,"},{"id":"semetey-1-2013:p0938:b003:l038","ordinal":147763,"en":"And rest only when I have taken Aichurok."},{"id":"semetey-1-2013:p0938:b004:l001","ordinal":147764,"en":"Stand firm, Jediger!"},{"id":"semetey-1-2013:p0938:b004:l002","ordinal":147765,"en":"In the pleasures of this world,"},{"id":"semetey-1-2013:p0938:b004:l003","ordinal":147766,"en":"How would you like to be immersed, hero Toltoi?"},{"id":"semetey-1-2013:p0938:b004:l004","ordinal":147767,"en":"Embracing Aichurok,"},{"id":"semetey-1-2013:p0938:b004:l005","ordinal":147768,"en":"How would you like to lie, hero Toltoi?"},{"id":"semetey-1-2013:p0938:b004:l007","ordinal":147769,"en":"I have come to you from the Argyn;","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0938:b004:l008","ordinal":147770,"en":"I am the good fortune upon your brow."},{"id":"semetey-1-2013:p0938:b004:l009","ordinal":147771,"en":"When I exert myself, I, Chynkojo,"},{"id":"semetey-1-2013:p0938:b004:l010","ordinal":147772,"en":"Am tempered red iron."},{"id":"semetey-1-2013:p0938:b004:l011","ordinal":147773,"en":"If hardship truly falls upon your head,"},{"id":"semetey-1-2013:p0938:b004:l012","ordinal":147774,"en":"I am a dark hill's ridge."},{"id":"semetey-1-2013:p0938:b004:l013","ordinal":147775,"en":"If you send me forward,"},{"id":"semetey-1-2013:p0938:b004:l014","ordinal":147776,"en":"I shall bring disorder upon the world."},{"id":"semetey-1-2013:p0938:b004:l015","ordinal":147777,"en":"If you heed my words,"},{"id":"semetey-1-2013:p0938:b004:l016","ordinal":147778,"en":"Over the eighteen thousand worlds"},{"id":"semetey-1-2013:p0938:b004:l017","ordinal":147779,"en":"I shall raise you as khan.\""},{"id":"semetey-1-2013:p0938:b004:l018","ordinal":147780,"en":"When he heard about Churok,"},{"id":"semetey-1-2013:p0938:b004:l019","ordinal":147781,"en":"What could dear Toltoi do?"},{"id":"semetey-1-2013:p0938:b004:l020","ordinal":147782,"en":"His fly-like soul cried out,"},{"id":"semetey-1-2013:p0938:b004:l021","ordinal":147783,"en":"His every bone seemed to shatter."},{"id":"semetey-1-2013:p0938:b004:l022","ordinal":147784,"en":"He shouted, 'Baabedin!'"},{"id":"semetey-1-2013:p0938:b004:l023","ordinal":147785,"en":"'All of you, come here!' he said,"},{"id":"semetey-1-2013:p0938:b004:l024","ordinal":147786,"en":"Calling the Jediger."},{"id":"semetey-1-2013:p0938:b004:l025","ordinal":147787,"en":"Swiftly invoking Baabedin,"},{"id":"semetey-1-2013:p0938:b004:l026","ordinal":147788,"en":"Vowing a sheep to Koroson,"},{"id":"semetey-1-2013:p0938:b004:l027","ordinal":147789,"en":"Dear Toltoi roared,"},{"id":"semetey-1-2013:p0938:b004:l028","ordinal":147790,"en":"Bellowing like a lusty stallion."},{"id":"semetey-1-2013:p0938:b004:l029","ordinal":147791,"en":"Hearing Kojo, he grew excited;"},{"id":"semetey-1-2013:p0938:b004:l030","ordinal":147792,"en":"Could poor Toltoi stand still?"},{"id":"semetey-1-2013:p0938:b004:l031","ordinal":147793,"en":"With Chynkojo urging him on,"},{"id":"semetey-1-2013:p0938:b004:l032","ordinal":147794,"en":"Would God strike Toltoi down?"},{"id":"semetey-1-2013:p0938:b004:l033","ordinal":147795,"en":"He gathered an army against the Oogans,"},{"id":"semetey-1-2013:p0938:b004:l034","ordinal":147796,"en":"An immense multitude,"},{"id":"semetey-1-2013:p0938:b004:l035","ordinal":147797,"en":"At Jeti-Ozon, the Jediger"},{"id":"semetey-1-2013:p0938:b004:l036","ordinal":147798,"en":"He gathered in full."},{"id":"semetey-1-2013:p0938:b004:l037","ordinal":147799,"en":"His complete army assembled,"},{"id":"semetey-1-2013:p0938:b004:l038","ordinal":147800,"en":"And the earth bent beneath them."},{"id":"semetey-1-2013:p0939:b004:l001","ordinal":147801,"en":"Taking up a gray-mottled banner,"},{"id":"semetey-1-2013:p0939:b004:l002","ordinal":147802,"en":"Raising cries of 'Boi-boi!'"},{"id":"semetey-1-2013:p0939:b004:l003","ordinal":147803,"en":"Jeti-Ozon stirred,"},{"id":"semetey-1-2013:p0939:b004:l004","ordinal":147804,"en":"An army beneath which the earth bent."},{"id":"semetey-1-2013:p0939:b004:l005","ordinal":147805,"en":"Tolobai, son of Tolok,"},{"id":"semetey-1-2013:p0939:b004:l006","ordinal":147806,"en":"Was commander of the lower army;"},{"id":"semetey-1-2013:p0939:b004:l007","ordinal":147807,"en":"Kalcha and Kadyrbai"},{"id":"semetey-1-2013:p0939:b004:l008","ordinal":147808,"en":"Were the finest of that great host."},{"id":"semetey-1-2013:p0939:b004:l009","ordinal":147809,"en":"When Chynkojo exerted himself,"},{"id":"semetey-1-2013:p0939:b004:l010","ordinal":147810,"en":"He was like tempered red iron."},{"id":"semetey-1-2013:p0939:b004:l011","ordinal":147811,"en":"The valorous Khan Toltoi"},{"id":"semetey-1-2013:p0939:b004:l012","ordinal":147812,"en":"Was as great as a mountain ridge."},{"id":"semetey-1-2013:p0939:b004:l013","ordinal":147813,"en":"When the two stood there, roused,"},{"id":"semetey-1-2013:p0939:b004:l014","ordinal":147814,"en":"When they thundered their commands,"},{"id":"semetey-1-2013:p0939:b004:l015","ordinal":147815,"en":"Was this a time for the great Jediger host"},{"id":"semetey-1-2013:p0939:b004:l016","ordinal":147816,"en":"To answer back?"},{"id":"semetey-1-2013:p0939:b004:l017","ordinal":147817,"en":"They swarmed like ants,"},{"id":"semetey-1-2013:p0939:b004:l018","ordinal":147818,"en":"A gray haze settled, wavering."},{"id":"semetey-1-2013:p0939:b004:l019","ordinal":147819,"en":"They had provisions prepared,"},{"id":"semetey-1-2013:p0939:b004:l020","ordinal":147820,"en":"And upon all the noble steeds"},{"id":"semetey-1-2013:p0939:b004:l021","ordinal":147821,"en":"Had yellow saddlecloths fastened."},{"id":"semetey-1-2013:p0939:b004:l022","ordinal":147822,"en":"Feeding them millet from the rice fields,"},{"id":"semetey-1-2013:p0939:b004:l023","ordinal":147823,"en":"They had them sweated daily,"},{"id":"semetey-1-2013:p0939:b004:l024","ordinal":147824,"en":"Had their spears readied,"},{"id":"semetey-1-2013:p0939:b004:l025","ordinal":147825,"en":"Had battle-axes of sharp steel prepared."},{"id":"semetey-1-2013:p0939:b004:l026","ordinal":147826,"en":"Their noble steeds with sound backs"},{"id":"semetey-1-2013:p0939:b004:l027","ordinal":147827,"en":"They assigned to the war,"},{"id":"semetey-1-2013:p0939:b004:l028","ordinal":147828,"en":"Their mangy, saddle-galled steeds"},{"id":"semetey-1-2013:p0939:b004:l029","ordinal":147829,"en":"They rejected, saying, 'Unfit.'"},{"id":"semetey-1-2013:p0939:b004:l030","ordinal":147830,"en":"They tied up the horses' tails,"},{"id":"semetey-1-2013:p0939:b004:l031","ordinal":147831,"en":"To sweep over Oogan,"},{"id":"semetey-1-2013:p0939:b004:l032","ordinal":147832,"en":"To bring it to its end together,"},{"id":"semetey-1-2013:p0939:b004:l033","ordinal":147833,"en":"To descend upon Oogan"},{"id":"semetey-1-2013:p0939:b004:l034","ordinal":147834,"en":"And bring great turmoil."},{"id":"semetey-1-2013:p0939:b006:l001","ordinal":147835,"en":"Manas's only son—"},{"id":"semetey-1-2013:p0939:b006:l002","ordinal":147836,"en":"With Chynkojo inciting them,"},{"id":"semetey-1-2013:p0939:b006:l003","ordinal":147837,"en":"They meant to seize his wife,"},{"id":"semetey-1-2013:p0939:b006:l004","ordinal":147838,"en":"To cause havoc and disorder,"},{"id":"semetey-1-2013:p0939:b006:l005","ordinal":147839,"en":"Gracefully swaying Churok—"},{"id":"semetey-1-2013:p0939:b006:l006","ordinal":147840,"en":"To rest only after taking her as spoils."},{"id":"semetey-1-2013:p0939:b006:l007","ordinal":147841,"en":"The whole great Jediger host"},{"id":"semetey-1-2013:p0939:b006:l008","ordinal":147842,"en":"Would descend upon them;"},{"id":"semetey-1-2013:p0939:b006:l009","ordinal":147843,"en":"If Akun refused to give her,"},{"id":"semetey-1-2013:p0939:b006:l010","ordinal":147844,"en":"With an army beneath which the earth bent,"},{"id":"semetey-1-2013:p0939:b006:l011","ordinal":147845,"en":"They would come and attack."},{"id":"semetey-1-2013:p0939:b006:l012","ordinal":147846,"en":"As the Jediger assembled,"},{"id":"semetey-1-2013:p0939:b006:l013","ordinal":147847,"en":"The black-bearded hero Tolok"},{"id":"semetey-1-2013:p0939:b006:l014","ordinal":147848,"en":"Asked for a pause."},{"id":"semetey-1-2013:p0939:b006:l015","ordinal":147849,"en":"'Hero Toltoi, Chynkojo,"},{"id":"semetey-1-2013:p0939:b006:l016","ordinal":147850,"en":"You are all standing here."},{"id":"semetey-1-2013:p0939:b006:l017","ordinal":147851,"en":"Many people rich in wisdom,"},{"id":"semetey-1-2013:p0939:b006:l018","ordinal":147852,"en":"You elders are standing here."},{"id":"semetey-1-2013:p0939:b006:l019","ordinal":147853,"en":"To descend upon them would be cruel,"},{"id":"semetey-1-2013:p0939:b006:l020","ordinal":147854,"en":"To attack them would be wrong."},{"id":"semetey-1-2013:p0939:b006:l021","ordinal":147855,"en":"Gathering a great army—"},{"id":"semetey-1-2013:p0939:b006:l022","ordinal":147856,"en":"They are no Kara-Kalmak enemy—"},{"id":"semetey-1-2013:p0939:b006:l023","ordinal":147857,"en":"Fighting over a woman,"},{"id":"semetey-1-2013:p0939:b006:l024","ordinal":147858,"en":"The many people needlessly slaughtered,"},{"id":"semetey-1-2013:p0939:b006:l025","ordinal":147859,"en":"It is wrong to fall into such turmoil."},{"id":"semetey-1-2013:p0939:b006:l026","ordinal":147860,"en":"Instead, to Akun,"},{"id":"semetey-1-2013:p0939:b006:l027","ordinal":147861,"en":"A broad-jawed, broad-tongued man,"},{"id":"semetey-1-2013:p0939:b006:l028","ordinal":147862,"en":"An orator who does not falter,"},{"id":"semetey-1-2013:p0939:b006:l029","ordinal":147863,"en":"Let us send as an envoy between us."},{"id":"semetey-1-2013:p0939:b006:l030","ordinal":147864,"en":"Let us make a marriage proposal,"},{"id":"semetey-1-2013:p0939:b006:l031","ordinal":147865,"en":"Without force or humiliation,"},{"id":"semetey-1-2013:p0939:b006:l032","ordinal":147866,"en":"Let us come to friendly terms."},{"id":"semetey-1-2013:p0939:b006:l033","ordinal":147867,"en":"If Akun will listen to reason,"},{"id":"semetey-1-2013:p0939:b006:l034","ordinal":147868,"en":"If he does not begin a quarrel,"},{"id":"semetey-1-2013:p0940:b003:l001","ordinal":147869,"en":"If he will give Churok,"},{"id":"semetey-1-2013:p0940:b003:l002","ordinal":147870,"en":"Let us drive seven hundred red elephants,"},{"id":"semetey-1-2013:p0940:b003:l003","ordinal":147871,"en":"Braid each of their tails,"},{"id":"semetey-1-2013:p0940:b003:l004","ordinal":147872,"en":"And give Akun the bride-price."},{"id":"semetey-1-2013:p0940:b003:l005","ordinal":147873,"en":"Arranging the marriage and driving livestock,"},{"id":"semetey-1-2013:p0940:b003:l007","ordinal":147874,"en":"Let us offer proper service,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0940:b003:l008","ordinal":147875,"en":"Let us take Akun's daughter."},{"id":"semetey-1-2013:p0940:b003:l009","ordinal":147876,"en":"Akun's daughter Aichurok—"},{"id":"semetey-1-2013:p0940:b003:l010","ordinal":147877,"en":"Let us take her on equal terms."},{"id":"semetey-1-2013:p0940:b003:l011","ordinal":147878,"en":"If we surround them,"},{"id":"semetey-1-2013:p0940:b003:l012","ordinal":147879,"en":"If we act recklessly,"},{"id":"semetey-1-2013:p0940:b003:l014","ordinal":147880,"en":"The Oogans too are no easy people.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0940:b003:l015","ordinal":147881,"en":"If we cause slaughter over a girl,"},{"id":"semetey-1-2013:p0940:b003:l016","ordinal":147882,"en":"If many of them die,"},{"id":"semetey-1-2013:p0940:b003:l017","ordinal":147883,"en":"If many of us die,"},{"id":"semetey-1-2013:p0940:b003:l018","ordinal":147884,"en":"If we slaughter one another,"},{"id":"semetey-1-2013:p0940:b003:l019","ordinal":147885,"en":"Will the girl become a wife?"},{"id":"semetey-1-2013:p0940:b003:l020","ordinal":147886,"en":"When we forcefully seize her,"},{"id":"semetey-1-2013:p0940:b003:l021","ordinal":147887,"en":"Will she be a wife to us?"},{"id":"semetey-1-2013:p0940:b003:l022","ordinal":147888,"en":"Let us send an envoy between us,"},{"id":"semetey-1-2013:p0940:b003:l023","ordinal":147889,"en":"Let us learn the facts thoroughly.'"},{"id":"semetey-1-2013:p0940:b003:l024","ordinal":147890,"en":"Chynkojo, Toltoi, and their elders"},{"id":"semetey-1-2013:p0940:b003:l025","ordinal":147891,"en":"Accepted this—"},{"id":"semetey-1-2013:p0940:b003:l026","ordinal":147892,"en":"What dear Tolok had said."},{"id":"semetey-1-2013:p0940:b003:l027","ordinal":147893,"en":"All the Jediger"},{"id":"semetey-1-2013:p0940:b003:l028","ordinal":147894,"en":"Discussed the matter together,"},{"id":"semetey-1-2013:p0940:b003:l029","ordinal":147895,"en":"And to go as a marriage envoy"},{"id":"semetey-1-2013:p0940:b003:l030","ordinal":147896,"en":"They began selecting a man."},{"id":"semetey-1-2013:p0940:b003:l031","ordinal":147897,"en":"Black-bearded Tolok"},{"id":"semetey-1-2013:p0940:b003:l032","ordinal":147898,"en":"They chose to go,"},{"id":"semetey-1-2013:p0940:b003:l033","ordinal":147899,"en":"The great Jediger host,"},{"id":"semetey-1-2013:p0940:b003:l034","ordinal":147900,"en":"To obtain news from Akun."},{"id":"semetey-1-2013:p0940:b003:l035","ordinal":147901,"en":"If you ask about Tolok,"},{"id":"semetey-1-2013:p0940:b003:l036","ordinal":147902,"en":"He was skilled at mediation,"},{"id":"semetey-1-2013:p0940:b003:l037","ordinal":147903,"en":"The eloquent one among many."},{"id":"semetey-1-2013:p0940:b003:l038","ordinal":147904,"en":"For Toltoi and his Kojo,"},{"id":"semetey-1-2013:p0940:b003:l039","ordinal":147905,"en":"Dear Tolok himself"},{"id":"semetey-1-2013:p0940:b004:l001","ordinal":147906,"en":"Was their mullah who wrote documents."},{"id":"semetey-1-2013:p0940:b004:l002","ordinal":147907,"en":"Reckoning the days,"},{"id":"semetey-1-2013:p0940:b004:l003","ordinal":147908,"en":"He put the day in the letter."},{"id":"semetey-1-2013:p0940:b004:l004","ordinal":147909,"en":"Reckoning the months,"},{"id":"semetey-1-2013:p0940:b004:l005","ordinal":147910,"en":"He recorded the year."},{"id":"semetey-1-2013:p0940:b004:l006","ordinal":147911,"en":"Tolok went as intermediary;"},{"id":"semetey-1-2013:p0940:b004:l007","ordinal":147912,"en":"The great Jediger host,"},{"id":"semetey-1-2013:p0940:b004:l008","ordinal":147913,"en":"Surging along the edge,"},{"id":"semetey-1-2013:p0940:b004:l009","ordinal":147914,"en":"Swaying over the land,"},{"id":"semetey-1-2013:p0940:b004:l010","ordinal":147915,"en":"Along the edge-road of Kum-Kyya,"},{"id":"semetey-1-2013:p0940:b004:l011","ordinal":147916,"en":"The Jediger spread out."},{"id":"semetey-1-2013:p0940:b004:l012","ordinal":147917,"en":"Indistinguishable from insects,"},{"id":"semetey-1-2013:p0940:b004:l013","ordinal":147918,"en":"The Jediger swarmed."},{"id":"semetey-1-2013:p0940:b004:l014","ordinal":147919,"en":"Along the edge-road of Tash-Kyya,"},{"id":"semetey-1-2013:p0940:b004:l015","ordinal":147920,"en":"The Jediger spread out."},{"id":"semetey-1-2013:p0940:b004:l016","ordinal":147921,"en":"Bagysh of the Jediger,"},{"id":"semetey-1-2013:p0940:b004:l017","ordinal":147922,"en":"And Bagysh's hero Toltoi,"},{"id":"semetey-1-2013:p0940:b004:l018","ordinal":147923,"en":"As huge as Opol-Too,"},{"id":"semetey-1-2013:p0940:b004:l019","ordinal":147924,"en":"With his host beneath which the earth bent."},{"id":"semetey-1-2013:p0940:b004:l020","ordinal":147925,"en":"They piled up their spears,"},{"id":"semetey-1-2013:p0940:b004:l021","ordinal":147926,"en":"Heaped guns like a mountain."},{"id":"semetey-1-2013:p0940:b004:l022","ordinal":147927,"en":"The mighty lord Chynkojo"},{"id":"semetey-1-2013:p0940:b004:l023","ordinal":147928,"en":"Made these arrangements,"},{"id":"semetey-1-2013:p0940:b004:l024","ordinal":147929,"en":"They dismounted and spread out."},{"id":"semetey-1-2013:p0940:b004:l025","ordinal":147930,"en":"They tethered the noble steeds with heads drawn high,"},{"id":"semetey-1-2013:p0940:b004:l026","ordinal":147931,"en":"Dividing into groups of six,"},{"id":"semetey-1-2013:p0940:b004:l027","ordinal":147932,"en":"They boiled their small kettles."},{"id":"semetey-1-2013:p0940:b004:l028","ordinal":147933,"en":"One mare for every twenty people,"},{"id":"semetey-1-2013:p0940:b004:l029","ordinal":147934,"en":"They slaughtered for provisions."},{"id":"semetey-1-2013:p0940:b004:l030","ordinal":147935,"en":"At each corner of the host, a hundred men,"},{"id":"semetey-1-2013:p0940:b004:l031","ordinal":147936,"en":"They posted strong guards."},{"id":"semetey-1-2013:p0940:b004:l032","ordinal":147937,"en":"Gathering and ordering the army,"},{"id":"semetey-1-2013:p0940:b004:l033","ordinal":147938,"en":"Leopard Kojo was a hero;"},{"id":"semetey-1-2013:p0940:b004:l034","ordinal":147939,"en":"'I shall take his aging daughter,' he said,"},{"id":"semetey-1-2013:p0940:b004:l035","ordinal":147940,"en":"And tightly surrounding Khan Akun,"},{"id":"semetey-1-2013:p0940:b004:l036","ordinal":147941,"en":"He was laying siege to him."},{"id":"semetey-1-2013:p0940:b004:l037","ordinal":147942,"en":"Let us leave this here,"},{"id":"semetey-1-2013:p0940:b004:l038","ordinal":147943,"en":"The envoy between them—"},{"id":"semetey-1-2013:p0940:b004:l039","ordinal":147944,"en":"Let us begin the account of Tolok."},{"id":"semetey-1-2013:p0941:b003:l001","ordinal":147945,"en":"Akun Khan's great court"},{"id":"semetey-1-2013:p0941:b003:l002","ordinal":147946,"en":"Had a strongly secured gate."},{"id":"semetey-1-2013:p0941:b003:l003","ordinal":147947,"en":"Ninety fathoms high"},{"id":"semetey-1-2013:p0941:b003:l004","ordinal":147948,"en":"Was its thick outer wall."},{"id":"semetey-1-2013:p0941:b003:l005","ordinal":147949,"en":"For a mortal to approach and enter,"},{"id":"semetey-1-2013:p0941:b003:l006","ordinal":147950,"en":"That wall was so thick"},{"id":"semetey-1-2013:p0941:b003:l007","ordinal":147951,"en":"That nine camels side by side"},{"id":"semetey-1-2013:p0941:b003:l008","ordinal":147952,"en":"Could walk freely upon it."},{"id":"semetey-1-2013:p0941:b003:l009","ordinal":147953,"en":"That Akun's"},{"id":"semetey-1-2013:p0941:b003:l010","ordinal":147954,"en":"Magnificence was very great."},{"id":"semetey-1-2013:p0941:b003:l011","ordinal":147955,"en":"The royal warrior,"},{"id":"semetey-1-2013:p0941:b003:l012","ordinal":147956,"en":"For anyone who incurred his wrath,"},{"id":"semetey-1-2013:p0941:b003:l013","ordinal":147957,"en":"Had a pit dug ready."},{"id":"semetey-1-2013:p0941:b003:l014","ordinal":147958,"en":"If Akun roused his strength,"},{"id":"semetey-1-2013:p0941:b003:l015","ordinal":147959,"en":"He had misery in store for them."},{"id":"semetey-1-2013:p0941:b003:l016","ordinal":147960,"en":"At the gate stood a tower;"},{"id":"semetey-1-2013:p0941:b003:l017","ordinal":147961,"en":"Do not ask about its wonders."},{"id":"semetey-1-2013:p0941:b003:l018","ordinal":147962,"en":"On this side of it,"},{"id":"semetey-1-2013:p0941:b003:l019","ordinal":147963,"en":"Old Akun was a khan;"},{"id":"semetey-1-2013:p0941:b003:l020","ordinal":147964,"en":"For anyone who angered him,"},{"id":"semetey-1-2013:p0941:b003:l022","ordinal":147965,"en":"On this side of that,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0941:b003:l023","ordinal":147966,"en":"So that people could not pass to and fro,"},{"id":"semetey-1-2013:p0941:b003:l024","ordinal":147967,"en":"He had made a wooden channel."},{"id":"semetey-1-2013:p0941:b003:l025","ordinal":147968,"en":"'Give us your aging daughter!'"}]
