[{"id":"semetey-1-2013:p1038:b004:l021","ordinal":155393,"en":"When driven to true fury,"},{"id":"semetey-1-2013:p1038:b004:l022","ordinal":155394,"en":"They say, the madman slaughters his father;"},{"id":"semetey-1-2013:p1038:b004:l023","ordinal":155395,"en":"However excellent you may be,"},{"id":"semetey-1-2013:p1038:b004:l024","ordinal":155396,"en":"Among the six Kyrgyz tribes"},{"id":"semetey-1-2013:p1038:b004:l025","ordinal":155397,"en":"They say there is no fool like you!"},{"id":"semetey-1-2013:p1038:b004:l026","ordinal":155398,"en":"To a husband born unruly,"},{"id":"semetey-1-2013:p1038:b004:l027","ordinal":155399,"en":"Let me stand yearning and speak:"},{"id":"semetey-1-2013:p1038:b004:l028","ordinal":155400,"en":"If you will not take me, do not, my murderer;"},{"id":"semetey-1-2013:p1038:b004:l029","ordinal":155401,"en":"I too shall find my equal and leave!\""},{"id":"semetey-1-2013:p1038:b004:l030","ordinal":155402,"en":"Saying this and tormenting him, Aychürök"},{"id":"semetey-1-2013:p1038:b004:l031","ordinal":155403,"en":"Was deeply hurt by the hero,"},{"id":"semetey-1-2013:p1038:b004:l032","ordinal":155404,"en":"And sobbed and wept bitterly."},{"id":"semetey-1-2013:p1038:b004:l033","ordinal":155405,"en":"Unable to draw back the mucus from her nose,"},{"id":"semetey-1-2013:p1038:b004:l034","ordinal":155406,"en":"Unable to wipe the tears from her eyes—"},{"id":"semetey-1-2013:p1038:b004:l035","ordinal":155407,"en":"Whose first ancestor was Tügöl Khan,"},{"id":"semetey-1-2013:p1038:b004:l036","ordinal":155408,"en":"Whose root was blessed by Khydyr,"},{"id":"semetey-1-2013:p1038:b004:l037","ordinal":155409,"en":"Descendant of the deathless one,"},{"id":"semetey-1-2013:p1038:b004:l038","ordinal":155410,"en":"Growing stronger whenever one died,"},{"id":"semetey-1-2013:p1038:b004:l039","ordinal":155411,"en":"Descendant of a sovereign hero:"},{"id":"semetey-1-2013:p1039:b003:l001","ordinal":155412,"en":"\"I know you, wretch;"},{"id":"semetey-1-2013:p1039:b003:l002","ordinal":155413,"en":"I know the waist you girded,"},{"id":"semetey-1-2013:p1039:b003:l003","ordinal":155414,"en":"I know, Aychürök,"},{"id":"semetey-1-2013:p1039:b003:l004","ordinal":155415,"en":"Your Chinese husband in Beijing!"},{"id":"semetey-1-2013:p1039:b003:l005","ordinal":155416,"en":"I shall break your back,"},{"id":"semetey-1-2013:p1039:b003:l006","ordinal":155417,"en":"I shall cool your breath,"},{"id":"semetey-1-2013:p1039:b003:l007","ordinal":155418,"en":"I shall drive out of you"},{"id":"semetey-1-2013:p1039:b003:l008","ordinal":155419,"en":"All your far-flung bluster—"},{"id":"semetey-1-2013:p1039:b003:l009","ordinal":155420,"en":"The husbands you sought and chose,"},{"id":"semetey-1-2013:p1039:b003:l010","ordinal":155421,"en":"Chynkozho and Toltoy!"},{"id":"semetey-1-2013:p1039:b003:l011","ordinal":155422,"en":"I shall show the strength of my arm,"},{"id":"semetey-1-2013:p1039:b003:l012","ordinal":155423,"en":"And begin many a tumult!"},{"id":"semetey-1-2013:p1039:b003:l013","ordinal":155424,"en":"I shall bring the end of the age,"},{"id":"semetey-1-2013:p1039:b003:l014","ordinal":155425,"en":"And take warrior Toltoy!"},{"id":"semetey-1-2013:p1039:b003:l015","ordinal":155426,"en":"Luckless woman who went seeking men,"},{"id":"semetey-1-2013:p1039:b003:l016","ordinal":155427,"en":"I shall take you and make you pay."},{"id":"semetey-1-2013:p1039:b003:l017","ordinal":155428,"en":"Come here without delay;"},{"id":"semetey-1-2013:p1039:b003:l018","ordinal":155429,"en":"Give me the falcon and I shall leave!\""},{"id":"semetey-1-2013:p1039:b003:l019","ordinal":155430,"en":"Your murderer grew furious"},{"id":"semetey-1-2013:p1039:b003:l020","ordinal":155431,"en":"And now stood hunched over."},{"id":"semetey-1-2013:p1039:b003:l021","ordinal":155432,"en":"From father back to forefather,"},{"id":"semetey-1-2013:p1039:b003:l022","ordinal":155433,"en":"Descendant of black-hearted men—"},{"id":"semetey-1-2013:p1039:b003:l023","ordinal":155434,"en":"\"He will leave without taking me,\" she thought,"},{"id":"semetey-1-2013:p1039:b003:l024","ordinal":155435,"en":"And God now struck Chürök."},{"id":"semetey-1-2013:p1039:b003:l025","ordinal":155436,"en":"Your dear sister-in-law wailed,"},{"id":"semetey-1-2013:p1039:b003:l026","ordinal":155437,"en":"Offended by her murderer."},{"id":"semetey-1-2013:p1039:b003:l027","ordinal":155438,"en":"Weeping hard and sobbing,"},{"id":"semetey-1-2013:p1039:b003:l028","ordinal":155439,"en":"She reeled, her knees giving way,"},{"id":"semetey-1-2013:p1039:b003:l029","ordinal":155440,"en":"Despairing of her destroyer."},{"id":"semetey-1-2013:p1039:b003:l030","ordinal":155441,"en":"In crimson gown, with a moonlike waist,"},{"id":"semetey-1-2013:p1039:b003:l031","ordinal":155442,"en":"Your graceful sister-in-law,"},{"id":"semetey-1-2013:p1039:b003:l032","ordinal":155443,"en":"Her white breast laid bare,"},{"id":"semetey-1-2013:p1039:b003:l033","ordinal":155444,"en":"Her white throat exposed,"},{"id":"semetey-1-2013:p1039:b003:l034","ordinal":155445,"en":"Reeled toward the tent,"},{"id":"semetey-1-2013:p1039:b003:l035","ordinal":155446,"en":"And her breath now went cold."},{"id":"semetey-1-2013:p1039:b003:l036","ordinal":155447,"en":"Kanchoro flew like an arrow"},{"id":"semetey-1-2013:p1039:b003:l037","ordinal":155448,"en":"And went to Külchoro."},{"id":"semetey-1-2013:p1039:b003:l038","ordinal":155449,"en":"The two companions met,"},{"id":"semetey-1-2013:p1039:b003:l039","ordinal":155450,"en":"And after endless counsel,"},{"id":"semetey-1-2013:p1039:b004:l001","ordinal":155451,"en":"They began with these words:"},{"id":"semetey-1-2013:p1039:b004:l002","ordinal":155452,"en":"\"Has our hunched-over elder brother"},{"id":"semetey-1-2013:p1039:b004:l003","ordinal":155453,"en":"Now come to grief?"},{"id":"semetey-1-2013:p1039:b004:l004","ordinal":155454,"en":"Quarreling before he has even seen her,"},{"id":"semetey-1-2013:p1039:b004:l005","ordinal":155455,"en":"Has God taken away"},{"id":"semetey-1-2013:p1039:b004:l006","ordinal":155456,"en":"Our rather arrogant prince like this?!"},{"id":"semetey-1-2013:p1039:b004:l007","ordinal":155457,"en":"If he leaves without taking Chürök,"},{"id":"semetey-1-2013:p1039:b004:l008","ordinal":155458,"en":"And we set out for Afghanistan,"},{"id":"semetey-1-2013:p1039:b004:l009","ordinal":155459,"en":"We shall face merciless turmoil,"},{"id":"semetey-1-2013:p1039:b004:l010","ordinal":155460,"en":"We shall see the end of the age."},{"id":"semetey-1-2013:p1039:b004:l011","ordinal":155461,"en":"How could we bow and plead"},{"id":"semetey-1-2013:p1039:b004:l012","ordinal":155462,"en":"With that ass-embracing woman,"},{"id":"semetey-1-2013:p1039:b004:l013","ordinal":155463,"en":"That infidel of furious temper?"},{"id":"semetey-1-2013:p1039:b004:l014","ordinal":155464,"en":"Would she not taunt and devour us:"},{"id":"semetey-1-2013:p1039:b004:l015","ordinal":155465,"en":"'The wife who went willingly"},{"id":"semetey-1-2013:p1039:b004:l016","ordinal":155466,"en":"He returned without taking,'"},{"id":"semetey-1-2013:p1039:b004:l017","ordinal":155467,"en":"Would she not devour us like this!"},{"id":"semetey-1-2013:p1039:b004:l018","ordinal":155468,"en":"My dear Külchoro,"},{"id":"semetey-1-2013:p1039:b004:l019","ordinal":155469,"en":"You were the more resourceful one,"},{"id":"semetey-1-2013:p1039:b004:l020","ordinal":155470,"en":"A ruddy, handsome-faced"},{"id":"semetey-1-2013:p1039:b004:l021","ordinal":155471,"en":"Lad skilled with maidens."},{"id":"semetey-1-2013:p1039:b004:l022","ordinal":155472,"en":"Find a way, Külchoro;"},{"id":"semetey-1-2013:p1039:b004:l023","ordinal":155473,"en":"Go to your sister-in-law,"},{"id":"semetey-1-2013:p1039:b004:l024","ordinal":155474,"en":"Speak to her with tactful words,"},{"id":"semetey-1-2013:p1039:b004:l025","ordinal":155475,"en":"And bring your sister-in-law back!\""},{"id":"semetey-1-2013:p1039:b004:l026","ordinal":155476,"en":"Külchoro flew like an arrow"},{"id":"semetey-1-2013:p1039:b004:l027","ordinal":155477,"en":"And ran to his sister-in-law;"},{"id":"semetey-1-2013:p1039:b004:l028","ordinal":155478,"en":"Kanchoro, sparing no strength,"},{"id":"semetey-1-2013:p1039:b004:l029","ordinal":155479,"en":"Ran to his elder brother."},{"id":"semetey-1-2013:p1039:b004:l030","ordinal":155480,"en":"When he reached the prince,"},{"id":"semetey-1-2013:p1039:b004:l031","ordinal":155481,"en":"Kanchoro stood and said this:"},{"id":"semetey-1-2013:p1039:b004:l032","ordinal":155482,"en":"\"Father, my dear elder brother,"},{"id":"semetey-1-2013:p1039:b004:l033","ordinal":155483,"en":"Where is your good sense?!"},{"id":"semetey-1-2013:p1039:b004:l034","ordinal":155484,"en":"When we were in Talas,"},{"id":"semetey-1-2013:p1039:b004:l035","ordinal":155485,"en":"We used to carve and eat the horse's haunch;"},{"id":"semetey-1-2013:p1039:b004:l036","ordinal":155486,"en":"We said we would subdue the governor"},{"id":"semetey-1-2013:p1039:b004:l037","ordinal":155487,"en":"Without brawling with a woman."},{"id":"semetey-1-2013:p1039:b004:l038","ordinal":155488,"en":"If we turn and go back,"},{"id":"semetey-1-2013:p1039:b004:l039","ordinal":155489,"en":"What shall we say when we arrive"},{"id":"semetey-1-2013:p1040:b003:l001","ordinal":155490,"en":"To your Kyrgyz village in Talas,"},{"id":"semetey-1-2013:p1040:b003:l002","ordinal":155491,"en":"Like men whose days are spent,"},{"id":"semetey-1-2013:p1040:b003:l003","ordinal":155492,"en":"What shall we say when we go"},{"id":"semetey-1-2013:p1040:b003:l004","ordinal":155493,"en":"To your ass-embracing wife?"},{"id":"semetey-1-2013:p1040:b003:l005","ordinal":155494,"en":"Father, silver-eyed and sun-faced,"},{"id":"semetey-1-2013:p1040:b003:l006","ordinal":155495,"en":"Thundering elder brother,"},{"id":"semetey-1-2013:p1040:b003:l007","ordinal":155496,"en":"Could you not bear it"},{"id":"semetey-1-2013:p1040:b003:l008","ordinal":155497,"en":"As a fault upon your neck?"},{"id":"semetey-1-2013:p1040:b003:l009","ordinal":155498,"en":"You hunched over and quarreled"},{"id":"semetey-1-2013:p1040:b003:l010","ordinal":155499,"en":"With the wife you have yet to take."},{"id":"semetey-1-2013:p1040:b003:l011","ordinal":155500,"en":"You swagger, alas for the day;"},{"id":"semetey-1-2013:p1040:b003:l012","ordinal":155501,"en":"Can a husband behave like you?"},{"id":"semetey-1-2013:p1040:b003:l013","ordinal":155502,"en":"By the custom of old,"},{"id":"semetey-1-2013:p1040:b003:l014","ordinal":155503,"en":"While in her father's place,"},{"id":"semetey-1-2013:p1040:b003:l015","ordinal":155504,"en":"A woman holds great power."},{"id":"semetey-1-2013:p1040:b003:l016","ordinal":155505,"en":"You quarreled before taking her—"},{"id":"semetey-1-2013:p1040:b003:l017","ordinal":155506,"en":"Hero, how can your star be fortunate?!"},{"id":"semetey-1-2013:p1040:b003:l018","ordinal":155507,"en":"Put aside your anger,"},{"id":"semetey-1-2013:p1040:b003:l019","ordinal":155508,"en":"Adopt another manner,"},{"id":"semetey-1-2013:p1040:b003:l020","ordinal":155509,"en":"Speak words of reconciliation,"},{"id":"semetey-1-2013:p1040:b003:l021","ordinal":155510,"en":"Take your wife."},{"id":"semetey-1-2013:p1040:b003:l022","ordinal":155511,"en":"If you quarrel with such swagger,"},{"id":"semetey-1-2013:p1040:b003:l023","ordinal":155512,"en":"This conduct of yours is rude."},{"id":"semetey-1-2013:p1040:b003:l024","ordinal":155513,"en":"Oh, my murderous leopard,"},{"id":"semetey-1-2013:p1040:b003:l025","ordinal":155514,"en":"Restrain your anger!\""},{"id":"semetey-1-2013:p1040:b003:l026","ordinal":155515,"en":"Your great-hearted man, scarcely contained,"},{"id":"semetey-1-2013:p1040:b003:l027","ordinal":155516,"en":"Turned aside toward Chürök"},{"id":"semetey-1-2013:p1040:b003:l028","ordinal":155517,"en":"And set his Buudan pacing;"},{"id":"semetey-1-2013:p1040:b003:l029","ordinal":155518,"en":"Külchoro brought back Chürök,"},{"id":"semetey-1-2013:p1040:b003:l030","ordinal":155519,"en":"Daughter of Akun."},{"id":"semetey-1-2013:p1040:b003:l031","ordinal":155520,"en":"Külchoro, son of Almambet,"},{"id":"semetey-1-2013:p1040:b003:l032","ordinal":155521,"en":"Was a tactful kinsman's son,"},{"id":"semetey-1-2013:p1040:b003:l033","ordinal":155522,"en":"A servant beyond reckoning,"},{"id":"semetey-1-2013:p1040:b003:l034","ordinal":155523,"en":"His appearance unlike other men's,"},{"id":"semetey-1-2013:p1040:b003:l035","ordinal":155524,"en":"A fortunate-born champion."},{"id":"semetey-1-2013:p1040:b003:l036","ordinal":155525,"en":"He said this to Aychürök,"},{"id":"semetey-1-2013:p1040:b003:l037","ordinal":155526,"en":"And spoke a scheme no one knew:"},{"id":"semetey-1-2013:p1040:b003:l038","ordinal":155527,"en":"\"There are gossips and old women here;"},{"id":"semetey-1-2013:p1040:b003:l039","ordinal":155528,"en":"All these people are here."},{"id":"semetey-1-2013:p1040:b004:l001","ordinal":155529,"en":"Of the husband she had not yet met,"},{"id":"semetey-1-2013:p1040:b004:l002","ordinal":155530,"en":"Will they not say Aychürök,"},{"id":"semetey-1-2013:p1040:b004:l003","ordinal":155531,"en":"Daughter of Akun, became a bully?"},{"id":"semetey-1-2013:p1040:b004:l004","ordinal":155532,"en":"With the husband she had not yet met,"},{"id":"semetey-1-2013:p1040:b004:l005","ordinal":155533,"en":"Quarreling out on the steppe,"},{"id":"semetey-1-2013:p1040:b004:l006","ordinal":155534,"en":"Will they not say Aychürök,"},{"id":"semetey-1-2013:p1040:b004:l007","ordinal":155535,"en":"In her distress, became loose-tongued?"},{"id":"semetey-1-2013:p1040:b004:l008","ordinal":155536,"en":"Begin with gracious conduct,"},{"id":"semetey-1-2013:p1040:b004:l009","ordinal":155537,"en":"Put aside this anger,"},{"id":"semetey-1-2013:p1040:b004:l010","ordinal":155538,"en":"Go to your gray-maned wolf,"},{"id":"semetey-1-2013:p1040:b004:l011","ordinal":155539,"en":"Take him about the neck,"},{"id":"semetey-1-2013:p1040:b004:l012","ordinal":155540,"en":"And indulge in a little affection."},{"id":"semetey-1-2013:p1040:b004:l013","ordinal":155541,"en":"Can a woman who quarreled as a maiden"},{"id":"semetey-1-2013:p1040:b004:l014","ordinal":155542,"en":"Be like you?"},{"id":"semetey-1-2013:p1040:b004:l015","ordinal":155543,"en":"If you keep matching yourself"},{"id":"semetey-1-2013:p1040:b004:l016","ordinal":155544,"en":"Against the proud gray wolf, sister-in-law,"},{"id":"semetey-1-2013:p1040:b004:l017","ordinal":155545,"en":"Will your affairs ever prosper?"},{"id":"semetey-1-2013:p1040:b004:l018","ordinal":155546,"en":"Are there people like you two,"},{"id":"semetey-1-2013:p1040:b004:l019","ordinal":155547,"en":"Who quarrel before even seeing each other?!\""},{"id":"semetey-1-2013:p1040:b004:l020","ordinal":155548,"en":"Kanchoro and Külchoro"},{"id":"semetey-1-2013:p1040:b004:l021","ordinal":155549,"en":"Had remained there together;"},{"id":"semetey-1-2013:p1040:b004:l022","ordinal":155550,"en":"Each leading one of the pair,"},{"id":"semetey-1-2013:p1040:b004:l023","ordinal":155551,"en":"Kanchoro now escorted"},{"id":"semetey-1-2013:p1040:b004:l024","ordinal":155552,"en":"The swaggering prince back,"},{"id":"semetey-1-2013:p1040:b004:l025","ordinal":155553,"en":"And Külchoro now escorted"},{"id":"semetey-1-2013:p1040:b004:l026","ordinal":155554,"en":"The silent Chürök back."},{"id":"semetey-1-2013:p1040:b004:l027","ordinal":155555,"en":"Clouds drifted together in the sky;"},{"id":"semetey-1-2013:p1040:b004:l028","ordinal":155556,"en":"The two wild rams made peace."},{"id":"semetey-1-2013:p1040:b004:l029","ordinal":155557,"en":"They met and clasped hands,"},{"id":"semetey-1-2013:p1040:b004:l030","ordinal":155558,"en":"And these two, swaggering,"},{"id":"semetey-1-2013:p1040:b004:l031","ordinal":155559,"en":"Kissed each other upon the throat."},{"id":"semetey-1-2013:p1040:b004:l032","ordinal":155560,"en":"They put aside angry words"},{"id":"semetey-1-2013:p1040:b004:l033","ordinal":155561,"en":"And began words of play."},{"id":"semetey-1-2013:p1040:b004:l034","ordinal":155562,"en":"Like the Pleiades in the sky,"},{"id":"semetey-1-2013:p1040:b004:l035","ordinal":155563,"en":"They were joined together now;"},{"id":"semetey-1-2013:p1040:b004:l036","ordinal":155564,"en":"Aychürök and Semetey"},{"id":"semetey-1-2013:p1040:b004:l037","ordinal":155565,"en":"Were united now."},{"id":"semetey-1-2013:p1040:b004:l038","ordinal":155566,"en":"The luckless daughter of Akun,"},{"id":"semetey-1-2013:p1041:b003:l001","ordinal":155567,"en":"Showing her distinction,"},{"id":"semetey-1-2013:p1041:b003:l002","ordinal":155568,"en":"Led the great-hearted hero"},{"id":"semetey-1-2013:p1041:b003:l003","ordinal":155569,"en":"Into the gilded tent."},{"id":"semetey-1-2013:p1041:b003:l004","ordinal":155570,"en":"They spoke in whispers,"},{"id":"semetey-1-2013:p1041:b003:l005","ordinal":155571,"en":"And laughed with ringing voices;"},{"id":"semetey-1-2013:p1041:b003:l006","ordinal":155572,"en":"They offered arak for thirst,"},{"id":"semetey-1-2013:p1041:b003:l007","ordinal":155573,"en":"And gave a handsome feast."},{"id":"semetey-1-2013:p1041:b003:l008","ordinal":155574,"en":"They quenched his thirst with kumis,"},{"id":"semetey-1-2013:p1041:b003:l009","ordinal":155575,"en":"And slaughtered in a row forty"},{"id":"semetey-1-2013:p1041:b003:l010","ordinal":155576,"en":"Unbred colts brought in the train;"},{"id":"semetey-1-2013:p1041:b004:l001","ordinal":155577,"en":"They had fat lambs and unbred colts"},{"id":"semetey-1-2013:p1041:b004:l002","ordinal":155578,"en":"Slaughtered together,"},{"id":"semetey-1-2013:p1041:b004:l003","ordinal":155579,"en":"And had sweet food and choice meat"},{"id":"semetey-1-2013:p1041:b004:l004","ordinal":155580,"en":"Boiled until tender;"},{"id":"semetey-1-2013:p1041:b004:l005","ordinal":155581,"en":"They had them gnaw sugar like snow"},{"id":"semetey-1-2013:p1041:b004:l006","ordinal":155582,"en":"And sip black tea."},{"id":"semetey-1-2013:p1041:b004:l007","ordinal":155583,"en":"\"Let our sultan, who arrived exhausted,"},{"id":"semetey-1-2013:p1041:b004:l008","ordinal":155584,"en":"Recover his strength,\" they said;"},{"id":"semetey-1-2013:p1041:b004:l009","ordinal":155585,"en":"Each applied himself eagerly"},{"id":"semetey-1-2013:p1041:b004:l010","ordinal":155586,"en":"And set out food of countless kinds."},{"id":"semetey-1-2013:p1041:b006:l001","ordinal":155587,"en":"Glen with springs and sheer cliff—"},{"id":"semetey-1-2013:p1041:b006:l002","ordinal":155588,"en":"Herself wise, the luckless one,"},{"id":"semetey-1-2013:p1041:b006:l003","ordinal":155589,"en":"Akun's daughter, the bold woman,"},{"id":"semetey-1-2013:p1041:b006:l004","ordinal":155590,"en":"Beside the great Ürgönch,"},{"id":"semetey-1-2013:p1041:b006:l005","ordinal":155591,"en":"As dusk fell and the sun set,"},{"id":"semetey-1-2013:p1041:b006:l006","ordinal":155592,"en":"Had the tents folded"},{"id":"semetey-1-2013:p1041:b006:l007","ordinal":155593,"en":"And loaded on every camel."},{"id":"semetey-1-2013:p1041:b006:l008","ordinal":155594,"en":"\"Let my king, my princely leopard,"},{"id":"semetey-1-2013:p1041:b006:l009","ordinal":155595,"en":"Enter and travel through Afghanistan,"},{"id":"semetey-1-2013:p1041:b006:l010","ordinal":155596,"en":"And be immersed in every delight;"},{"id":"semetey-1-2013:p1041:b006:l011","ordinal":155597,"en":"The white palace prepared for him—"},{"id":"semetey-1-2013:p1041:b006:l012","ordinal":155598,"en":"Let him lie in that white palace;"},{"id":"semetey-1-2013:p1041:b006:l013","ordinal":155599,"en":"Let my hero take his fill of affection"},{"id":"semetey-1-2013:p1041:b006:l014","ordinal":155600,"en":"And be immersed in great delight,\" she said."},{"id":"semetey-1-2013:p1041:b006:l015","ordinal":155601,"en":"Fourteen horses bred in Ogoy,"},{"id":"semetey-1-2013:p1041:b006:l016","ordinal":155602,"en":"And at the head of the fourteen horses,"},{"id":"semetey-1-2013:p1041:b006:l017","ordinal":155603,"en":"A white shaft tied in a ring,"},{"id":"semetey-1-2013:p1041:b006:l018","ordinal":155604,"en":"A shaft fit for fourteen horses—"},{"id":"semetey-1-2013:p1041:b006:l019","ordinal":155605,"en":"Your formidable sister-in-law Chürök,"},{"id":"semetey-1-2013:p1041:b006:l020","ordinal":155606,"en":"Showing her extravagance,"},{"id":"semetey-1-2013:p1041:b006:l021","ordinal":155607,"en":"Had swaggering Buurul"},{"id":"semetey-1-2013:p1041:b006:l022","ordinal":155608,"en":"Mounted by her attendant."},{"id":"semetey-1-2013:p1041:b006:l023","ordinal":155609,"en":"Your accomplished sister-in-law Chürök"},{"id":"semetey-1-2013:p1041:b006:l024","ordinal":155610,"en":"Wore a loose silk robe,"},{"id":"semetey-1-2013:p1041:b008:l001","ordinal":155611,"en":"And rode a pacing ambler."},{"id":"semetey-1-2013:p1041:b008:l002","ordinal":155612,"en":"Unnoticed by a single person,"},{"id":"semetey-1-2013:p1041:b008:l003","ordinal":155613,"en":"Unseen by anyone,"},{"id":"semetey-1-2013:p1041:b008:l004","ordinal":155614,"en":"As dusk fell and the sun set,"},{"id":"semetey-1-2013:p1041:b008:l005","ordinal":155615,"en":"When the people were first settling to sleep,"},{"id":"semetey-1-2013:p1041:b008:l006","ordinal":155616,"en":"She set out toward Afghanistan."},{"id":"semetey-1-2013:p1041:b008:l007","ordinal":155617,"en":"She arranged a splendid spectacle,"},{"id":"semetey-1-2013:p1041:b008:l008","ordinal":155618,"en":"And had fourteen swaggering horses"},{"id":"semetey-1-2013:p1041:b008:l009","ordinal":155619,"en":"Led along riderless;"},{"id":"semetey-1-2013:p1041:b008:l010","ordinal":155620,"en":"Ahead of the fourteen horses"},{"id":"semetey-1-2013:p1041:b008:l011","ordinal":155621,"en":"She arrayed all the maidens,"},{"id":"semetey-1-2013:p1041:b008:l012","ordinal":155622,"en":"And to make the bride and young man"},{"id":"semetey-1-2013:p1041:b008:l013","ordinal":155623,"en":"Disappear without leaving a trail,"},{"id":"semetey-1-2013:p1041:b008:l014","ordinal":155624,"en":"Behind the fourteen horses"},{"id":"semetey-1-2013:p1041:b008:l015","ordinal":155625,"en":"She strung them out in a festive procession."},{"id":"semetey-1-2013:p1041:b008:l016","ordinal":155626,"en":"The luckless daughter of Akun"},{"id":"semetey-1-2013:p1041:b008:l017","ordinal":155627,"en":"Set her affairs in order like this,"},{"id":"semetey-1-2013:p1041:b008:l018","ordinal":155628,"en":"And erased every trace."},{"id":"semetey-1-2013:p1041:b008:l019","ordinal":155629,"en":"The reason she erased the tracks was this:"},{"id":"semetey-1-2013:p1041:b008:l020","ordinal":155630,"en":"The fourteen horses were known as racers,"},{"id":"semetey-1-2013:p1041:b008:l021","ordinal":155631,"en":"And their tracks might be recognized;"},{"id":"semetey-1-2013:p1041:b008:l022","ordinal":155632,"en":"If Chynkozho, son of Shygay,"},{"id":"semetey-1-2013:p1041:b008:l023","ordinal":155633,"en":"Should learn of it by chance,"},{"id":"semetey-1-2013:p1041:b008:l024","ordinal":155634,"en":"He would begin a fierce shoot-out, she thought,"},{"id":"semetey-1-2013:p1042:b003:l001","ordinal":155635,"en":"\"My dear princely leopard,"},{"id":"semetey-1-2013:p1042:b003:l002","ordinal":155636,"en":"Before he has had time to rest,"},{"id":"semetey-1-2013:p1042:b003:l003","ordinal":155637,"en":"Will be left with regret,\" she thought."},{"id":"semetey-1-2013:p1042:b003:l004","ordinal":155638,"en":"Aychürök stood thinking this,"},{"id":"semetey-1-2013:p1042:b003:l005","ordinal":155639,"en":"Conceiving a scheme no one knew,"},{"id":"semetey-1-2013:p1042:b003:l006","ordinal":155640,"en":"Displaying her great wisdom,"},{"id":"semetey-1-2013:p1042:b003:l007","ordinal":155641,"en":"And guided the heroic prince and sultan"},{"id":"semetey-1-2013:p1042:b003:l008","ordinal":155642,"en":"Toward Afghanistan."},{"id":"semetey-1-2013:p1042:b003:l009","ordinal":155643,"en":"They entered Kara-Shaar;"},{"id":"semetey-1-2013:p1042:b003:l010","ordinal":155644,"en":"It was Khan Akun's city,"},{"id":"semetey-1-2013:p1042:b003:l011","ordinal":155645,"en":"A settlement of the populous Afghans."},{"id":"semetey-1-2013:p1042:b003:l012","ordinal":155646,"en":"Aychürök, who led them,"},{"id":"semetey-1-2013:p1042:b003:l013","ordinal":155647,"en":"Was the master among women,"},{"id":"semetey-1-2013:p1042:b003:l014","ordinal":155648,"en":"And the daughter of Khan Akun."}]
