[{"id":"semetey-1-2013:p0751:b003:l035","ordinal":133889,"en":"'Give ninety thousand camel-loads of tea,' they said,"},{"id":"semetey-1-2013:p0751:b003:l036","ordinal":133890,"en":"And imposed tribute on the Kyrgyz."},{"id":"semetey-1-2013:p0751:b003:l037","ordinal":133891,"en":"'When the moon is dark,"},{"id":"semetey-1-2013:p0751:b003:l038","ordinal":133892,"en":"The night is like this,' they said."},{"id":"semetey-1-2013:p0751:b003:l039","ordinal":133893,"en":"'When the magnanimous one passes away,"},{"id":"semetey-1-2013:p0751:b004:l001","ordinal":133894,"en":"The day is like this,' they said."},{"id":"semetey-1-2013:p0751:b004:l002","ordinal":133895,"en":"Unable to find what they demanded,"},{"id":"semetey-1-2013:p0751:b004:l003","ordinal":133896,"en":"The Kyrgyz moved away to one place."},{"id":"semetey-1-2013:p0751:b004:l004","ordinal":133897,"en":"Unable to find six thousand yearlings of barren mares,"},{"id":"semetey-1-2013:p0751:b004:l005","ordinal":133898,"en":"Unable to find sixty camel-loads of tea,"},{"id":"semetey-1-2013:p0751:b004:l006","ordinal":133899,"en":"The Argyn moved away to another place."},{"id":"semetey-1-2013:p0751:b004:l007","ordinal":133900,"en":"The Kyrgyz people left by bloodthirsty Manas"},{"id":"semetey-1-2013:p0751:b004:l009","ordinal":133901,"en":"Abyke and Kobosh scattered."},{"id":"semetey-1-2013:p0751:b004:l010","ordinal":133902,"en":"Unable to bear their tribute,"},{"id":"semetey-1-2013:p0751:b004:l011","ordinal":133903,"en":"All the numerous people"},{"id":"semetey-1-2013:p0751:b004:l012","ordinal":133904,"en":"Fled in every direction."},{"id":"semetey-1-2013:p0751:b004:l013","ordinal":133905,"en":"Unable to find their bearings,"},{"id":"semetey-1-2013:p0751:b004:l014","ordinal":133906,"en":"The Argyn people moved away to one place."},{"id":"semetey-1-2013:p0751:b004:l015","ordinal":133907,"en":"Hard-pressed and greatly humiliated,"},{"id":"semetey-1-2013:p0751:b004:l016","ordinal":133908,"en":"The Kyrgyz went away to another place."},{"id":"semetey-1-2013:p0751:b004:l017","ordinal":133909,"en":"After the lord passed away,"},{"id":"semetey-1-2013:p0751:b004:l018","ordinal":133910,"en":"The Kyrgyz people were left behind."},{"id":"semetey-1-2013:p0751:b004:l019","ordinal":133911,"en":"The scoundrels Abyke and Kobosh—"},{"id":"semetey-1-2013:p0751:b004:l020","ordinal":133912,"en":"God had struck them thus."},{"id":"semetey-1-2013:p0751:b004:l021","ordinal":133913,"en":"They plundered the people's goods"},{"id":"semetey-1-2013:p0751:b004:l022","ordinal":133914,"en":"And stirred up great strife."},{"id":"semetey-1-2013:p0751:b004:l023","ordinal":133915,"en":"Unable to find a way out,"},{"id":"semetey-1-2013:p0751:b004:l024","ordinal":133916,"en":"The Argyn people went away."},{"id":"semetey-1-2013:p0751:b004:l025","ordinal":133917,"en":"And so this dear land"},{"id":"semetey-1-2013:p0751:b004:l026","ordinal":133918,"en":"Lay gaping and empty."},{"id":"semetey-1-2013:p0751:b004:l027","ordinal":133919,"en":"When Manas lived,"},{"id":"semetey-1-2013:p0751:b004:l028","ordinal":133920,"en":"Here, among these dear people,"},{"id":"semetey-1-2013:p0751:b004:l029","ordinal":133921,"en":"The young wives drove lambs,"},{"id":"semetey-1-2013:p0751:b004:l030","ordinal":133922,"en":"The old women chewed fat tails."},{"id":"semetey-1-2013:p0751:b004:l031","ordinal":133923,"en":"After the lord passed away,"},{"id":"semetey-1-2013:p0751:b004:l032","ordinal":133924,"en":"Here, among these dear people,"},{"id":"semetey-1-2013:p0751:b004:l033","ordinal":133925,"en":"Not a tiny soul remained."},{"id":"semetey-1-2013:p0751:b004:l034","ordinal":133926,"en":"They plundered the people's goods"},{"id":"semetey-1-2013:p0751:b004:l035","ordinal":133927,"en":"And stirred up great strife."},{"id":"semetey-1-2013:p0751:b004:l036","ordinal":133928,"en":"This great court of Manas—"},{"id":"semetey-1-2013:p0751:b004:l037","ordinal":133929,"en":"All those foolish dogs"},{"id":"semetey-1-2013:p0751:b004:l038","ordinal":133930,"en":"Had taken possession of it."},{"id":"semetey-1-2013:p0751:b004:l039","ordinal":133931,"en":"Dog Kobosh mounted the throne,"},{"id":"semetey-1-2013:p0752:b003:l001","ordinal":133932,"en":"And became a sultan."},{"id":"semetey-1-2013:p0752:b003:l002","ordinal":133933,"en":"He plunged into pleasure."},{"id":"semetey-1-2013:p0752:b003:l003","ordinal":133934,"en":"When lord Manas lived,"},{"id":"semetey-1-2013:p0752:b003:l004","ordinal":133935,"en":"The throne he occupied, as big as a camel—"},{"id":"semetey-1-2013:p0752:b003:l005","ordinal":133936,"en":"Kobosh took Akylai,"},{"id":"semetey-1-2013:p0752:b003:l006","ordinal":133937,"en":"And lay there without rising."},{"id":"semetey-1-2013:p0752:b003:l007","ordinal":133938,"en":"Ill-intentioned Khan Kobosh"},{"id":"semetey-1-2013:p0752:b003:l008","ordinal":133939,"en":"Brought sorrow in this way."},{"id":"semetey-1-2013:p0752:b003:l009","ordinal":133940,"en":"What can be seen on this side—"},{"id":"semetey-1-2013:p0752:b003:l010","ordinal":133941,"en":"When he saw that sight,"},{"id":"semetey-1-2013:p0752:b003:l011","ordinal":133942,"en":"Your gray-maned elder Bakai's"},{"id":"semetey-1-2013:p0752:b003:l012","ordinal":133943,"en":"Heart was deeply troubled;"},{"id":"semetey-1-2013:p0752:b003:l013","ordinal":133944,"en":"Tears streamed from his eyes."},{"id":"semetey-1-2013:p0752:b003:l014","ordinal":133945,"en":"What is seen today is gone tomorrow."},{"id":"semetey-1-2013:p0752:b003:l015","ordinal":133946,"en":"Such is this shitty world."},{"id":"semetey-1-2013:p0752:b003:l016","ordinal":133947,"en":"What can be seen nearer than that"},{"id":"semetey-1-2013:p0752:b003:l017","ordinal":133948,"en":"Is Kanykei's white palace,"},{"id":"semetey-1-2013:p0752:b003:l018","ordinal":133949,"en":"Its gate of iron and solid tin."},{"id":"semetey-1-2013:p0752:b003:l019","ordinal":133950,"en":"Though a woman, Kanykei"},{"id":"semetey-1-2013:p0752:b003:l020","ordinal":133951,"en":"Surpassed many in majesty."},{"id":"semetey-1-2013:p0752:b003:l021","ordinal":133952,"en":"No one dared approach."},{"id":"semetey-1-2013:p0752:b003:l022","ordinal":133953,"en":"The white palace's doorway"},{"id":"semetey-1-2013:p0752:b003:l023","ordinal":133954,"en":"No man without courage had seen;"},{"id":"semetey-1-2013:p0752:b003:l024","ordinal":133955,"en":"No mortal could bear to come."},{"id":"semetey-1-2013:p0752:b003:l025","ordinal":133956,"en":"Kanykei's gleaming white palace—"},{"id":"semetey-1-2013:p0752:b003:l026","ordinal":133957,"en":"Its threshold is yellow gold,"},{"id":"semetey-1-2013:p0752:b003:l027","ordinal":133958,"en":"Its crown is gold, its roof poles copper."},{"id":"semetey-1-2013:p0752:b003:l028","ordinal":133959,"en":"When Manas was struck down and gone,"},{"id":"semetey-1-2013:p0752:b003:l029","ordinal":133960,"en":"It became booty at that very time."},{"id":"semetey-1-2013:p0752:b003:l030","ordinal":133961,"en":"Thinking much of the old days,"},{"id":"semetey-1-2013:p0752:b003:l031","ordinal":133962,"en":"Son, our minds are thrown into turmoil."},{"id":"semetey-1-2013:p0752:b003:l032","ordinal":133963,"en":"When falcon Manas lived,"},{"id":"semetey-1-2013:p0752:b003:l033","ordinal":133964,"en":"Our livestock filled the whole expanse."},{"id":"semetey-1-2013:p0752:b003:l034","ordinal":133965,"en":"When I think of today,"},{"id":"semetey-1-2013:p0752:b003:l035","ordinal":133966,"en":"Our life does not amount to a handful."},{"id":"semetey-1-2013:p0752:b003:l037","ordinal":133967,"en":"Thinking over it deeply,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0752:b003:l038","ordinal":133968,"en":"Tears stream from my eyes."},{"id":"semetey-1-2013:p0752:b003:l039","ordinal":133969,"en":"Khan Manas's treasury"},{"id":"semetey-1-2013:p0752:b004:l001","ordinal":133970,"en":"Seems to belong to Kobosh today.\""},{"id":"semetey-1-2013:p0752:b004:l002","ordinal":133971,"en":"So spoke great Bakai,"},{"id":"semetey-1-2013:p0752:b004:l003","ordinal":133972,"en":"Heading toward the court,"},{"id":"semetey-1-2013:p0752:b004:l004","ordinal":133973,"en":"Devastating Bakai shook with sobs."},{"id":"semetey-1-2013:p0752:b004:l005","ordinal":133974,"en":"This treasury standing here—"},{"id":"semetey-1-2013:p0752:b004:l006","ordinal":133975,"en":"If you ask what it was before,"},{"id":"semetey-1-2013:p0752:b004:l007","ordinal":133976,"en":"It was Khan Manas's white court."},{"id":"semetey-1-2013:p0752:b004:l008","ordinal":133977,"en":"If you ask what it is now,"},{"id":"semetey-1-2013:p0752:b004:l009","ordinal":133978,"en":"Your father's grave, this world!"},{"id":"semetey-1-2013:p0752:b004:l010","ordinal":133979,"en":"It is Abyke's white court."},{"id":"semetey-1-2013:p0752:b004:l011","ordinal":133980,"en":"Looming darkly there,"},{"id":"semetey-1-2013:p0752:b004:l012","ordinal":133981,"en":"Where he used to go for recreation,"},{"id":"semetey-1-2013:p0752:b004:l013","ordinal":133982,"en":"Was Khan Manas's garden."},{"id":"semetey-1-2013:p0752:b004:l014","ordinal":133983,"en":"What can be seen nearer than that"},{"id":"semetey-1-2013:p0752:b004:l015","ordinal":133984,"en":"Was my gray-maned one's throne."},{"id":"semetey-1-2013:p0752:b004:l016","ordinal":133985,"en":"If you ask about it now,"},{"id":"semetey-1-2013:p0752:b004:l017","ordinal":133986,"en":"That is Abyke's garden."},{"id":"semetey-1-2013:p0752:b004:l018","ordinal":133987,"en":"What appears in the gray haze"},{"id":"semetey-1-2013:p0752:b004:l019","ordinal":133988,"en":"Is Khan Kobosh's throne."},{"id":"semetey-1-2013:p0752:b004:l020","ordinal":133989,"en":"\"My darling orphan,"},{"id":"semetey-1-2013:p0752:b004:l021","ordinal":133990,"en":"My flowing river, my spring,"},{"id":"semetey-1-2013:p0752:b004:l022","ordinal":133991,"en":"My lamp found when I was dying,"},{"id":"semetey-1-2013:p0752:b004:l023","ordinal":133992,"en":"Remember these words of mine."},{"id":"semetey-1-2013:p0752:b004:l024","ordinal":133993,"en":"Do not act imperiously; heed me."},{"id":"semetey-1-2013:p0752:b004:l025","ordinal":133994,"en":"At your six uncles' homes"},{"id":"semetey-1-2013:p0752:b004:l026","ordinal":133995,"en":"There are pits they have dug,"},{"id":"semetey-1-2013:p0752:b004:l027","ordinal":133996,"en":"There is brine they have boiled,"},{"id":"semetey-1-2013:p0752:b004:l028","ordinal":133997,"en":"They have girded their loins,"},{"id":"semetey-1-2013:p0752:b004:l029","ordinal":133998,"en":"They have fortified their positions."},{"id":"semetey-1-2013:p0752:b004:l030","ordinal":133999,"en":"Enemies since your valiant father's time,"},{"id":"semetey-1-2013:p0752:b004:l031","ordinal":134000,"en":"The six scoundrels bear a grudge."},{"id":"semetey-1-2013:p0752:b004:l032","ordinal":134001,"en":"Your aged elder Bakai"},{"id":"semetey-1-2013:p0752:b004:l033","ordinal":134002,"en":"Will show you your six uncles today.\""},{"id":"semetey-1-2013:p0752:b004:l035","ordinal":134003,"en":"So spoke gray-maned Bakai,"},{"id":"semetey-1-2013:p0752:b004:l036","ordinal":134004,"en":"Heading toward Abyke,"},{"id":"semetey-1-2013:p0752:b004:l037","ordinal":134005,"en":"Taking a short path inward,"},{"id":"semetey-1-2013:p0752:b004:l038","ordinal":134006,"en":"Manas's only son"},{"id":"semetey-1-2013:p0752:b004:l039","ordinal":134007,"en":"He led along as his support."},{"id":"semetey-1-2013:p0753:b003:l001","ordinal":134008,"en":"\"My flowing river, my spring,"},{"id":"semetey-1-2013:p0753:b003:l002","ordinal":134009,"en":"The rascal left by Manas,"},{"id":"semetey-1-2013:p0753:b003:l003","ordinal":134010,"en":"My lamp that gives me shelter.\""},{"id":"semetey-1-2013:p0753:b003:l004","ordinal":134011,"en":"When Manas's son arrived,"},{"id":"semetey-1-2013:p0753:b003:l005","ordinal":134012,"en":"The scoundrels Abyke and Kobosh,"},{"id":"semetey-1-2013:p0753:b003:l006","ordinal":134013,"en":"Those wretches born rotten of their father,"},{"id":"semetey-1-2013:p0753:b003:l007","ordinal":134014,"en":"Had no one keeping watch."},{"id":"semetey-1-2013:p0753:b003:l008","ordinal":134015,"en":"Of the countless Chinese and Manchu,"},{"id":"semetey-1-2013:p0753:b003:l009","ordinal":134016,"en":"Being there in their midst,"},{"id":"semetey-1-2013:p0753:b003:l010","ordinal":134017,"en":"They gave no thought that they might die."},{"id":"semetey-1-2013:p0753:b003:l011","ordinal":134018,"en":"There were no greater fools than they."},{"id":"semetey-1-2013:p0753:b003:l012","ordinal":134019,"en":"Abyke and Kobosh's"},{"id":"semetey-1-2013:p0753:b003:l013","ordinal":134020,"en":"Court, where they made their dwelling—"},{"id":"semetey-1-2013:p0753:b003:l014","ordinal":134021,"en":"Bakai and Semetey"},{"id":"semetey-1-2013:p0753:b003:l015","ordinal":134022,"en":"Now dismounted there."},{"id":"semetey-1-2013:p0753:b003:l016","ordinal":134023,"en":"Bronze at the base, copper at the tip,"},{"id":"semetey-1-2013:p0753:b003:l017","ordinal":134024,"en":"Some four cubits high,"},{"id":"semetey-1-2013:p0753:b003:l018","ordinal":134025,"en":"To the ornate bronze tethering post"},{"id":"semetey-1-2013:p0753:b003:l019","ordinal":134026,"en":"They walked with heavy steps."},{"id":"semetey-1-2013:p0753:b003:l020","ordinal":134027,"en":"With white lead ropes plaited in knots,"},{"id":"semetey-1-2013:p0753:b003:l021","ordinal":134028,"en":"Kokcholok and Aktulpar"},{"id":"semetey-1-2013:p0753:b003:l022","ordinal":134029,"en":"They tied to the post with slipknots,"},{"id":"semetey-1-2013:p0753:b003:l023","ordinal":134030,"en":"Fastening them securely."},{"id":"semetey-1-2013:p0753:b003:l024","ordinal":134031,"en":"Into Abyke and Kobosh's court,"},{"id":"semetey-1-2013:p0753:b003:l025","ordinal":134032,"en":"Semetey and Khan Bakai"},{"id":"semetey-1-2013:p0753:b003:l026","ordinal":134033,"en":"Then entered."},{"id":"semetey-1-2013:p0753:b003:l027","ordinal":134034,"en":"Standing and pleading with them both,"},{"id":"semetey-1-2013:p0753:b003:l028","ordinal":134035,"en":"Abyke spoke these words:"},{"id":"semetey-1-2013:p0753:b003:l029","ordinal":134036,"en":"\"Peace, peace be upon you!"},{"id":"semetey-1-2013:p0753:b003:l030","ordinal":134037,"en":"My lion Bakai, are you well?"},{"id":"semetey-1-2013:p0753:b003:l031","ordinal":134038,"en":"We made a little trouble among kin—"},{"id":"semetey-1-2013:p0753:b003:l033","ordinal":134039,"en":"The firmly blocked road—","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0753:b003:l034","ordinal":134040,"en":"My Bakai who opened it, are you well?"},{"id":"semetey-1-2013:p0753:b003:l035","ordinal":134041,"en":"The great treasury, when you turned toward it—"},{"id":"semetey-1-2013:p0753:b003:l036","ordinal":134042,"en":"My Bakai who opened it, are you well?"},{"id":"semetey-1-2013:p0753:b003:l037","ordinal":134043,"en":"Bringing torment upon Beijing,"},{"id":"semetey-1-2013:p0753:b003:l038","ordinal":134044,"en":"My Bakai who conquered it, are you well?"},{"id":"semetey-1-2013:p0753:b003:l039","ordinal":134045,"en":"You who destroyed the enemy that faced you,"},{"id":"semetey-1-2013:p0753:b005:l001","ordinal":134046,"en":"My lion Bakai, are you well?"},{"id":"semetey-1-2013:p0753:b005:l002","ordinal":134047,"en":"The feeble soul leaning for support—"},{"id":"semetey-1-2013:p0753:b005:l003","ordinal":134048,"en":"Its support, Bakai, are you well?"},{"id":"semetey-1-2013:p0753:b005:l004","ordinal":134049,"en":"The wretched soul about to die—"},{"id":"semetey-1-2013:p0753:b005:l005","ordinal":134050,"en":"Its means of survival, Bakai, are you well?"},{"id":"semetey-1-2013:p0753:b005:l006","ordinal":134051,"en":"When angered, his enemy"},{"id":"semetey-1-2013:p0753:b005:l007","ordinal":134052,"en":"He erased from this world."},{"id":"semetey-1-2013:p0753:b005:l008","ordinal":134053,"en":"Bakai who drove them out, are you well?"},{"id":"semetey-1-2013:p0753:b005:l009","ordinal":134054,"en":"You who rekindled extinguished fires,"},{"id":"semetey-1-2013:p0753:b005:l010","ordinal":134055,"en":"Who brought dead souls back to life,"},{"id":"semetey-1-2013:p0753:b005:l011","ordinal":134056,"en":"Commanding Bakai, are you well?"},{"id":"semetey-1-2013:p0753:b005:l012","ordinal":134057,"en":"When hands are spread, saying Amen,"},{"id":"semetey-1-2013:p0753:b005:l013","ordinal":134058,"en":"My blessing, Bakai, are you well?"},{"id":"semetey-1-2013:p0753:b005:l014","ordinal":134059,"en":"My support left by Manas,"},{"id":"semetey-1-2013:p0753:b005:l015","ordinal":134060,"en":"My father Bakai, are you well?"},{"id":"semetey-1-2013:p0753:b005:l016","ordinal":134061,"en":"These descendants of Zhakyp,"},{"id":"semetey-1-2013:p0753:b005:l017","ordinal":134062,"en":"Mighty Manas, the falcon—"},{"id":"semetey-1-2013:p0753:b005:l018","ordinal":134063,"en":"You planted them into a garden,"},{"id":"semetey-1-2013:p0753:b005:l019","ordinal":134064,"en":"Kneaded them into a house,"},{"id":"semetey-1-2013:p0753:b005:l020","ordinal":134065,"en":"Joined what had broken,"},{"id":"semetey-1-2013:p0753:b005:l021","ordinal":134066,"en":"Gathered what had scattered,"},{"id":"semetey-1-2013:p0753:b005:l022","ordinal":134067,"en":"Rekindled extinguished fires,"},{"id":"semetey-1-2013:p0753:b005:l023","ordinal":134068,"en":"Brought dead souls back to life."},{"id":"semetey-1-2013:p0753:b005:l024","ordinal":134069,"en":"Set in front, you bring good fortune;"},{"id":"semetey-1-2013:p0753:b005:l025","ordinal":134070,"en":"Driven forward, you are like a mighty army."},{"id":"semetey-1-2013:p0753:b005:l026","ordinal":134071,"en":"A saint favored by the unseen protector,"},{"id":"semetey-1-2013:p0753:b005:l027","ordinal":134072,"en":"My elder Bakai, old man,"},{"id":"semetey-1-2013:p0753:b005:l028","ordinal":134073,"en":"You who wore a blue-gray lynx-fur cap,"},{"id":"semetey-1-2013:p0753:b005:l029","ordinal":134074,"en":"Who wielded a mottled blue shield,"},{"id":"semetey-1-2013:p0753:b005:l031","ordinal":134075,"en":"My steadfast old Bakai.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0753:b005:l032","ordinal":134076,"en":"While you watch over me, my belly is full;"},{"id":"semetey-1-2013:p0753:b005:l033","ordinal":134077,"en":"While I see you, my heart is content."},{"id":"semetey-1-2013:p0753:b005:l034","ordinal":134078,"en":"Elder, there is no greater legacy than you."},{"id":"semetey-1-2013:p0753:b005:l035","ordinal":134079,"en":"For twelve years,"},{"id":"semetey-1-2013:p0753:b005:l036","ordinal":134080,"en":"We have not seen one another."},{"id":"semetey-1-2013:p0753:b005:l037","ordinal":134081,"en":"Was this shitty world like this?"},{"id":"semetey-1-2013:p0753:b005:l038","ordinal":134082,"en":"Khan Bakai, elder, hear my words!"},{"id":"semetey-1-2013:p0753:b005:l039","ordinal":134083,"en":"When leopard Manas died,"},{"id":"semetey-1-2013:p0754:b003:l001","ordinal":134084,"en":"When the people suffered hardship,"},{"id":"semetey-1-2013:p0754:b003:l002","ordinal":134085,"en":"When good Khan Manas died,"},{"id":"semetey-1-2013:p0754:b003:l003","ordinal":134086,"en":"And all the people died with him,"},{"id":"semetey-1-2013:p0754:b003:l004","ordinal":134087,"en":"When we settled along the river,"},{"id":"semetey-1-2013:p0754:b003:l005","ordinal":134088,"en":"Bereft of the leopard,"},{"id":"semetey-1-2013:p0754:b003:l006","ordinal":134089,"en":"We wretches left behind"},{"id":"semetey-1-2013:p0754:b003:l007","ordinal":134090,"en":"Were like an extinguished fire."},{"id":"semetey-1-2013:p0754:b003:l008","ordinal":134091,"en":"Kanykei went away in mourning;"},{"id":"semetey-1-2013:p0754:b003:l009","ordinal":134092,"en":"Semetey fled away."},{"id":"semetey-1-2013:p0754:b003:l010","ordinal":134093,"en":"Kanykei went away a widow;"},{"id":"semetey-1-2013:p0754:b003:l011","ordinal":134094,"en":"Semetey went wandering."},{"id":"semetey-1-2013:p0754:b003:l012","ordinal":134095,"en":"Elder Bakai, whenever I think of it, I burn."},{"id":"semetey-1-2013:p0754:b003:l014","ordinal":134096,"en":"Manas's only son"},{"id":"semetey-1-2013:p0754:b003:l015","ordinal":134097,"en":"I keep asking God for."},{"id":"semetey-1-2013:p0754:b003:l016","ordinal":134098,"en":"I inquired of knowledgeable men,"},{"id":"semetey-1-2013:p0754:b003:l017","ordinal":134099,"en":"I asked those who knew."},{"id":"semetey-1-2013:p0754:b003:l018","ordinal":134100,"en":"Unable to find a trace of the orphan,"},{"id":"semetey-1-2013:p0754:b003:l019","ordinal":134101,"en":"I withered away like this."},{"id":"semetey-1-2013:p0754:b003:l020","ordinal":134102,"en":"The dear bird called the wild duck"},{"id":"semetey-1-2013:p0754:b003:l021","ordinal":134103,"en":"Flies straight on for the open plain."},{"id":"semetey-1-2013:p0754:b003:l022","ordinal":134104,"en":"Elder, I grieve for the orphan boy."},{"id":"semetey-1-2013:p0754:b003:l023","ordinal":134105,"en":"The dear bird called the little bustard"},{"id":"semetey-1-2013:p0754:b003:l024","ordinal":134106,"en":"Flies swiftly for the open plain."},{"id":"semetey-1-2013:p0754:b003:l025","ordinal":134107,"en":"I become deeply sorrowful"},{"id":"semetey-1-2013:p0754:b003:l026","ordinal":134108,"en":"For the child left by the hero."},{"id":"semetey-1-2013:p0754:b003:l027","ordinal":134109,"en":"The wretched bird called the kite"},{"id":"semetey-1-2013:p0754:b003:l028","ordinal":134110,"en":"Swoops down for food."},{"id":"semetey-1-2013:p0754:b003:l029","ordinal":134111,"en":"The only son Manas had in his troubled days"},{"id":"semetey-1-2013:p0754:b003:l031","ordinal":134112,"en":"Went away in distress because of me."},{"id":"semetey-1-2013:p0754:b003:l032","ordinal":134113,"en":"The dear bird called the goshawk"},{"id":"semetey-1-2013:p0754:b003:l033","ordinal":134114,"en":"Flies straight on for food."},{"id":"semetey-1-2013:p0754:b003:l034","ordinal":134115,"en":"My dear sister-in-law Kanykei"},{"id":"semetey-1-2013:p0754:b003:l035","ordinal":134116,"en":"Took her support and fled,"},{"id":"semetey-1-2013:p0754:b003:l036","ordinal":134117,"en":"Went away offended because of me."},{"id":"semetey-1-2013:p0754:b003:l037","ordinal":134118,"en":"When leopard Manas died,"},{"id":"semetey-1-2013:p0754:b003:l038","ordinal":134119,"en":"Leopard elder, listen!"},{"id":"semetey-1-2013:p0754:b003:l039","ordinal":134120,"en":"They turned the heart of Talas into desert:"},{"id":"semetey-1-2013:p0754:b004:l001","ordinal":134121,"en":"Khan Tekechi, Khan Shygai,"},{"id":"semetey-1-2013:p0754:b004:l002","ordinal":134122,"en":"And Zhamgyrchy close by,"},{"id":"semetey-1-2013:p0754:b004:l003","ordinal":134123,"en":"Spreading slander between us,"},{"id":"semetey-1-2013:p0754:b004:l004","ordinal":134124,"en":"Made the two of us enemies."},{"id":"semetey-1-2013:p0754:b004:l005","ordinal":134125,"en":"'Six thousand ingots and a thousand otter pelts"},{"id":"semetey-1-2013:p0754:b004:l006","ordinal":134126,"en":"Bakai took as a bribe,' they said."},{"id":"semetey-1-2013:p0754:b004:l007","ordinal":134127,"en":"'Tekechi's Ormonbek"},{"id":"semetey-1-2013:p0754:b004:l008","ordinal":134128,"en":"He agreed to let escape,' they said."},{"id":"semetey-1-2013:p0754:b004:l009","ordinal":134129,"en":"We formed opposing factions;"},{"id":"semetey-1-2013:p0754:b004:l010","ordinal":134130,"en":"Malicious, careless talk arose,"},{"id":"semetey-1-2013:p0754:b004:l011","ordinal":134131,"en":"And for twelve years we fought."},{"id":"semetey-1-2013:p0754:b004:l012","ordinal":134132,"en":"Elder Bakai, hear my words."},{"id":"semetey-1-2013:p0754:b004:l013","ordinal":134133,"en":"Since lion Manas's death,"},{"id":"semetey-1-2013:p0754:b004:l014","ordinal":134134,"en":"Not thirty days had passed,"},{"id":"semetey-1-2013:p0754:b004:l015","ordinal":134135,"en":"When, hearing evil rumors,"},{"id":"semetey-1-2013:p0754:b004:l016","ordinal":134136,"en":"Afghanistan and India—"},{"id":"semetey-1-2013:p0754:b004:l017","ordinal":134137,"en":"The peoples of three khans clashed."},{"id":"semetey-1-2013:p0754:b004:l018","ordinal":134138,"en":"They mounted stallions from the tethering line,"},{"id":"semetey-1-2013:p0754:b004:l019","ordinal":134139,"en":"Picked up poles from the ground,"},{"id":"semetey-1-2013:p0754:b004:l020","ordinal":134140,"en":"And fought a terrible battle."},{"id":"semetey-1-2013:p0754:b004:l021","ordinal":134141,"en":"Men died and horses were taken;"},{"id":"semetey-1-2013:p0754:b004:l022","ordinal":134142,"en":"There was endless strife."},{"id":"semetey-1-2013:p0754:b004:l023","ordinal":134143,"en":"Six swift horses arrived,"},{"id":"semetey-1-2013:p0754:b004:l024","ordinal":134144,"en":"And from those people came a palm-sized letter:"}]
