[{"id":"semetey-1-2013:p0619:b003:l006","ordinal":123905,"en":"Rushed toward Beijing,"},{"id":"semetey-1-2013:p0619:b003:l007","ordinal":123906,"en":"All fleeing and crying out."},{"id":"semetey-1-2013:p0619:b003:l008","ordinal":123907,"en":"The infidels, thick as black willows,"},{"id":"semetey-1-2013:p0619:b003:l009","ordinal":123908,"en":"He swept toward Beijing."},{"id":"semetey-1-2013:p0619:b003:l010","ordinal":123909,"en":"The fleeing Chinese—"},{"id":"semetey-1-2013:p0619:b003:l011","ordinal":123910,"en":"When Almambet brought this about,"},{"id":"semetey-1-2013:p0619:b003:l012","ordinal":123911,"en":"Your outstanding leopard father"},{"id":"semetey-1-2013:p0619:b003:l013","ordinal":123912,"en":"Pursued them from behind and slaughtered them."},{"id":"semetey-1-2013:p0619:b003:l014","ordinal":123913,"en":"The whole Beijing army died;"},{"id":"semetey-1-2013:p0619:b003:l015","ordinal":123914,"en":"Many Chinese giants died."},{"id":"semetey-1-2013:p0619:b003:l016","ordinal":123915,"en":"When the Chinese fled to Beijing,"},{"id":"semetey-1-2013:p0619:b003:l017","ordinal":123916,"en":"Clamoring, “The banner is fleeing!”"},{"id":"semetey-1-2013:p0619:b003:l018","ordinal":123917,"en":"The Chinese stood crying out."},{"id":"semetey-1-2013:p0619:b003:l019","ordinal":123918,"en":"When the fierce-maned warrior"},{"id":"semetey-1-2013:p0619:b003:l020","ordinal":123919,"en":"Cut through their middle,"},{"id":"semetey-1-2013:p0619:b003:l021","ordinal":123920,"en":"When around them the forty champions"},{"id":"semetey-1-2013:p0619:b003:l022","ordinal":123921,"en":"Came slaughtering,"},{"id":"semetey-1-2013:p0619:b003:l023","ordinal":123922,"en":"When Khan Manas, in their very midst,"},{"id":"semetey-1-2013:p0619:b003:l024","ordinal":123923,"en":"Hemmed them in and unleashed slaughter,"},{"id":"semetey-1-2013:p0619:b003:l025","ordinal":123924,"en":"When the forty champions around them"},{"id":"semetey-1-2013:p0619:b003:l026","ordinal":123925,"en":"Cut them down and slew them,"},{"id":"semetey-1-2013:p0619:b003:l027","ordinal":123926,"en":"Into Beijing where the Prophet never trod,"},{"id":"semetey-1-2013:p0619:b003:l028","ordinal":123927,"en":"Your father came in his glory."},{"id":"semetey-1-2013:p0619:b003:l029","ordinal":123928,"en":"When he advanced, driving them before him,"},{"id":"semetey-1-2013:p0619:b003:l030","ordinal":123929,"en":"The Four Companions came to your lion father."},{"id":"semetey-1-2013:p0619:b003:l031","ordinal":123930,"en":"When your father took Beijing,"},{"id":"semetey-1-2013:p0619:b003:l032","ordinal":123931,"en":"Their hearts were at ease."},{"id":"semetey-1-2013:p0619:b003:l033","ordinal":123932,"en":"The Muslim people became rich."},{"id":"semetey-1-2013:p0619:b003:l034","ordinal":123933,"en":"The most excellent warriors"},{"id":"semetey-1-2013:p0619:b003:l035","ordinal":123934,"en":"Took six thousand horses apiece."},{"id":"semetey-1-2013:p0619:b003:l036","ordinal":123935,"en":"The least successful among them"},{"id":"semetey-1-2013:p0619:b003:l037","ordinal":123936,"en":"Took six hundred horses apiece."},{"id":"semetey-1-2013:p0619:b003:l038","ordinal":123937,"en":"The accomplished champions"},{"id":"semetey-1-2013:p0619:b003:l039","ordinal":123938,"en":"Took seven thousand horses apiece."},{"id":"semetey-1-2013:p0619:b005:l001","ordinal":123939,"en":"The lesser men who could not match them"},{"id":"semetey-1-2013:p0619:b005:l002","ordinal":123940,"en":"Took seven hundred horses apiece."},{"id":"semetey-1-2013:p0619:b005:l003","ordinal":123941,"en":"The most excellent warriors"},{"id":"semetey-1-2013:p0619:b005:l004","ordinal":123942,"en":"Took six girls apiece."},{"id":"semetey-1-2013:p0619:b005:l005","ordinal":123943,"en":"All the people were filled to abundance."},{"id":"semetey-1-2013:p0619:b005:l007","ordinal":123944,"en":"Taking many excellent craftswomen,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0619:b005:l008","ordinal":123945,"en":"Esenkan's Burulcha,"},{"id":"semetey-1-2013:p0619:b005:l009","ordinal":123946,"en":"And Zhang-zhung's Birmyskal—"},{"id":"semetey-1-2013:p0619:b005:l010","ordinal":123947,"en":"Taking such girls as these,"},{"id":"semetey-1-2013:p0619:b005:l011","ordinal":123948,"en":"They offered them as tribute."},{"id":"semetey-1-2013:p0619:b005:l012","ordinal":123949,"en":"They dressed him in a Chinese coat."},{"id":"semetey-1-2013:p0619:b005:l013","ordinal":123950,"en":"The golden throne in Beijing—"},{"id":"semetey-1-2013:p0619:b005:l014","ordinal":123951,"en":"They made your father ruler,"},{"id":"semetey-1-2013:p0619:b005:l015","ordinal":123952,"en":"And seated him upon that golden throne."},{"id":"semetey-1-2013:p0619:b005:l016","ordinal":123953,"en":"Your father ruled as khan for six months."},{"id":"semetey-1-2013:p0619:b005:l017","ordinal":123954,"en":"Beijing with its Khagan rose."},{"id":"semetey-1-2013:p0619:b005:l018","ordinal":123955,"en":"Their chief was mighty Kalcha."},{"id":"semetey-1-2013:p0619:b005:l019","ordinal":123956,"en":"Seventy executioners"},{"id":"semetey-1-2013:p0619:b005:l020","ordinal":123957,"en":"Were set to beating their drums."},{"id":"semetey-1-2013:p0619:b005:l021","ordinal":123958,"en":"Caught unaware, by Kalcha"},{"id":"semetey-1-2013:p0619:b005:l022","ordinal":123959,"en":"He was struck at the back of the head."},{"id":"semetey-1-2013:p0619:b005:l023","ordinal":123960,"en":"Manas was wounded."},{"id":"semetey-1-2013:p0619:b005:l024","ordinal":123961,"en":"When he turned back this way,"},{"id":"semetey-1-2013:p0619:b005:l025","ordinal":123962,"en":"Those Muslims who survived the dead,"},{"id":"semetey-1-2013:p0619:b005:l026","ordinal":123963,"en":"When they returned this way,"},{"id":"semetey-1-2013:p0619:b005:l027","ordinal":123964,"en":"The earth was rent and turned to dust."},{"id":"semetey-1-2013:p0619:b005:l028","ordinal":123965,"en":"Ninety Beijings rose."},{"id":"semetey-1-2013:p0619:b005:l029","ordinal":123966,"en":"Many warriors broke through the ranks;"},{"id":"semetey-1-2013:p0619:b005:l030","ordinal":123967,"en":"Many men fell to bullets."},{"id":"semetey-1-2013:p0619:b005:l031","ordinal":123968,"en":"Many mighty men died."},{"id":"semetey-1-2013:p0619:b005:l032","ordinal":123969,"en":"Ezhigei and Sheiren died as well."},{"id":"semetey-1-2013:p0619:b005:l033","ordinal":123970,"en":"Countless lives were lost."},{"id":"semetey-1-2013:p0619:b005:l034","ordinal":123971,"en":"Muzburchak and Kokcho died."},{"id":"semetey-1-2013:p0619:b005:l035","ordinal":123972,"en":"Kokotoy's Bokmurun died as well."},{"id":"semetey-1-2013:p0619:b005:l036","ordinal":123973,"en":"Many renowned supporters died."},{"id":"semetey-1-2013:p0619:b005:l037","ordinal":123974,"en":"Many died in the fighting."},{"id":"semetey-1-2013:p0619:b005:l038","ordinal":123975,"en":"Your father Manas, the magnanimous lion,"},{"id":"semetey-1-2013:p0619:b005:l039","ordinal":123976,"en":"That was where he suffered,"},{"id":"semetey-1-2013:p0620:b003:l001","ordinal":123977,"en":"Many places where they were shattered and fell—"},{"id":"semetey-1-2013:p0620:b003:l002","ordinal":123978,"en":"That was where they fought to the death."},{"id":"semetey-1-2013:p0620:b003:l003","ordinal":123979,"en":"Returning from the Khagan's realm,"},{"id":"semetey-1-2013:p0620:b003:l004","ordinal":123980,"en":"He had lost the one he relied upon,"},{"id":"semetey-1-2013:p0620:b003:l005","ordinal":123981,"en":"Khan Chubak."},{"id":"semetey-1-2013:p0620:b003:l006","ordinal":123982,"en":"Taking much wealth from Beijing,"},{"id":"semetey-1-2013:p0620:b003:l007","ordinal":123983,"en":"Those who had been a band about his waist—"},{"id":"semetey-1-2013:p0620:b003:l008","ordinal":123984,"en":"Your valiant father had consumed his champions."},{"id":"semetey-1-2013:p0620:b003:l009","ordinal":123985,"en":"Returning from Great Beijing,"},{"id":"semetey-1-2013:p0620:b003:l010","ordinal":123986,"en":"Bereft of his fierce-maned warriors,"},{"id":"semetey-1-2013:p0620:b003:l011","ordinal":123987,"en":"With Akkula fallen to a bullet,"},{"id":"semetey-1-2013:p0620:b003:l012","ordinal":123988,"en":"With Almambet dead a martyr,"},{"id":"semetey-1-2013:p0620:b003:l013","ordinal":123989,"en":"Syrgak and Serek, the two lions—"},{"id":"semetey-1-2013:p0620:b003:l014","ordinal":123990,"en":"Bereft of both of them,"},{"id":"semetey-1-2013:p0620:b003:l015","ordinal":123991,"en":"Your saintly father grieved."},{"id":"semetey-1-2013:p0620:b003:l016","ordinal":123992,"en":"Then I, Bakai, at that moment,"},{"id":"semetey-1-2013:p0620:b003:l017","ordinal":123993,"en":"Showed my lion-like courage."},{"id":"semetey-1-2013:p0620:b003:l018","ordinal":123994,"en":"When your father stood wailing, on foot,"},{"id":"semetey-1-2013:p0620:b003:l019","ordinal":123995,"en":"When forty-two Chinese surrounded him,"},{"id":"semetey-1-2013:p0620:b003:l020","ordinal":123996,"en":"Furious, I went straight through."},{"id":"semetey-1-2013:p0620:b003:l021","ordinal":123997,"en":"To my bloodthirsty one, dear soul,"},{"id":"semetey-1-2013:p0620:b003:l022","ordinal":123998,"en":"(It was a horse set apart for you),"},{"id":"semetey-1-2013:p0620:b003:l023","ordinal":123999,"en":"I led the roan horse."},{"id":"semetey-1-2013:p0620:b003:l024","ordinal":124000,"en":"Showing my resourcefulness,"},{"id":"semetey-1-2013:p0620:b003:l025","ordinal":124001,"en":"I contrived to reach him, poor soul,"},{"id":"semetey-1-2013:p0620:b003:l026","ordinal":124002,"en":"And mounted him on Taibuurul."},{"id":"semetey-1-2013:p0620:b003:l027","ordinal":124003,"en":"When we thrust back against the Chinese,"},{"id":"semetey-1-2013:p0620:b003:l028","ordinal":124004,"en":"Konurbai survived,"},{"id":"semetey-1-2013:p0620:b003:l029","ordinal":124005,"en":"While we slaughtered the rest."},{"id":"semetey-1-2013:p0620:b003:l030","ordinal":124006,"en":"Turning back toward the Kyrgyz,"},{"id":"semetey-1-2013:p0620:b003:l031","ordinal":124007,"en":"When we left them unable to pursue,"},{"id":"semetey-1-2013:p0620:b003:l032","ordinal":124008,"en":"That fierce-maned Alake"},{"id":"semetey-1-2013:p0620:b003:l033","ordinal":124009,"en":"We recovered from the Chinese."},{"id":"semetey-1-2013:p0620:b003:l034","ordinal":124010,"en":"Your leopard father held him across his saddle."},{"id":"semetey-1-2013:p0620:b003:l035","ordinal":124011,"en":"When he plunged into a night of grief,"},{"id":"semetey-1-2013:p0620:b003:l036","ordinal":124012,"en":"Pressing his cheek against his cheek,"},{"id":"semetey-1-2013:p0620:b003:l037","ordinal":124013,"en":"And lay there wailing:"},{"id":"semetey-1-2013:p0620:b003:l038","ordinal":124014,"en":"“My companion, my twin lamb,"},{"id":"semetey-1-2013:p0620:b003:l039","ordinal":124015,"en":"Alake, bereft of you,"},{"id":"semetey-1-2013:p0620:b004:l001","ordinal":124016,"en":"How can I go on without dying?"},{"id":"semetey-1-2013:p0620:b004:l002","ordinal":124017,"en":"My support when I climbed upward,"},{"id":"semetey-1-2013:p0620:b004:l003","ordinal":124018,"en":"My prop when I descended,"},{"id":"semetey-1-2013:p0620:b004:l004","ordinal":124019,"en":"My good fortune when he went scouting,"},{"id":"semetey-1-2013:p0620:b004:l005","ordinal":124020,"en":"My countless host when he entered slaughter,"},{"id":"semetey-1-2013:p0620:b004:l006","ordinal":124021,"en":"I have lost him, to my disgrace,"},{"id":"semetey-1-2013:p0620:b004:l007","ordinal":124022,"en":"My soul-companion in the next world."},{"id":"semetey-1-2013:p0620:b004:l009","ordinal":124023,"en":"Your father wailed and cried aloud.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0620:b004:l010","ordinal":124024,"en":"When he suffered in this way,"},{"id":"semetey-1-2013:p0620:b004:l011","ordinal":124025,"en":"The valiant, fierce-maned Almam"},{"id":"semetey-1-2013:p0620:b004:l012","ordinal":124026,"en":"We took by the waist and bent over,"},{"id":"semetey-1-2013:p0620:b004:l013","ordinal":124027,"en":"And loaded onto Sarala as a sacred trust."},{"id":"semetey-1-2013:p0620:b004:l014","ordinal":124028,"en":"The beautiful man on his right,"},{"id":"semetey-1-2013:p0620:b004:l015","ordinal":124029,"en":"The only son of Khan Azyz,"},{"id":"semetey-1-2013:p0620:b004:l016","ordinal":124030,"en":"Almambet, must have come."},{"id":"semetey-1-2013:p0620:b004:l017","ordinal":124031,"en":"Embracing the Magnanimous One,"},{"id":"semetey-1-2013:p0620:b004:l018","ordinal":124032,"en":"He too must be lying with him."},{"id":"semetey-1-2013:p0620:b004:l019","ordinal":124033,"en":"The mighty man on his left—"},{"id":"semetey-1-2013:p0620:b004:l020","ordinal":124034,"en":"Stars stirred in the heavens."},{"id":"semetey-1-2013:p0620:b004:l021","ordinal":124035,"en":"To your formidable sultan father"},{"id":"semetey-1-2013:p0620:b004:l022","ordinal":124036,"en":"He had been a friend twelve times."},{"id":"semetey-1-2013:p0620:b004:l023","ordinal":124037,"en":"Akbaltai's Chubak,"},{"id":"semetey-1-2013:p0620:b004:l024","ordinal":124038,"en":"For your fierce-maned lion father,"},{"id":"semetey-1-2013:p0620:b004:l025","ordinal":124039,"en":"Was that dear, resourceful one."},{"id":"semetey-1-2013:p0620:b004:l026","ordinal":124040,"en":"Because he found a way,"},{"id":"semetey-1-2013:p0620:b004:l027","ordinal":124041,"en":"He was your magnanimous father's support."},{"id":"semetey-1-2013:p0620:b004:l028","ordinal":124042,"en":"Long ago, against the Manchu and Black Chinese,"},{"id":"semetey-1-2013:p0620:b004:l029","ordinal":124043,"en":"When they unleashed great slaughter,"},{"id":"semetey-1-2013:p0620:b004:l030","ordinal":124044,"en":"Chubak, all alone,"},{"id":"semetey-1-2013:p0620:b004:l031","ordinal":124045,"en":"The Manchu khan Ezkara"},{"id":"semetey-1-2013:p0620:b004:l032","ordinal":124046,"en":"And the forty nobles beside him,"},{"id":"semetey-1-2013:p0620:b004:l033","ordinal":124047,"en":"When he brought them bound by himself—"},{"id":"semetey-1-2013:p0620:b004:l034","ordinal":124048,"en":"Such courage as Chubak's"},{"id":"semetey-1-2013:p0620:b004:l035","ordinal":124049,"en":"Could be found in no other mortal,"},{"id":"semetey-1-2013:p0620:b004:l036","ordinal":124050,"en":"That dark, fierce-maned dear one."},{"id":"semetey-1-2013:p0620:b004:l037","ordinal":124051,"en":"Without killing or losing them,"},{"id":"semetey-1-2013:p0620:b004:l038","ordinal":124052,"en":"He bent them over in pairs,"},{"id":"semetey-1-2013:p0620:b004:l039","ordinal":124053,"en":"Bound and brought them alive,"},{"id":"semetey-1-2013:p0621:b003:l001","ordinal":124054,"en":"And loaded each onto a horse."},{"id":"semetey-1-2013:p0621:b003:l002","ordinal":124055,"en":"His reach extended to Talas."},{"id":"semetey-1-2013:p0621:b003:l003","ordinal":124056,"en":"With Ezkara at their head,"},{"id":"semetey-1-2013:p0621:b003:l004","ordinal":124057,"en":"The forty Chinese nobles"},{"id":"semetey-1-2013:p0621:b003:l005","ordinal":124058,"en":"He presented to your father Sultan Manas."},{"id":"semetey-1-2013:p0621:b003:l006","ordinal":124059,"en":"He broke the Chinese backbone,"},{"id":"semetey-1-2013:p0621:b003:l007","ordinal":124060,"en":"And gave your fierce-maned father peace."},{"id":"semetey-1-2013:p0621:b003:l009","ordinal":124061,"en":"He was a most important khan.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0621:b003:l010","ordinal":124062,"en":"On Ezkara's account,"},{"id":"semetey-1-2013:p0621:b003:l011","ordinal":124063,"en":"They put a golden crown upon him."},{"id":"semetey-1-2013:p0621:b003:l012","ordinal":124064,"en":"The people of Beijing offered their throne,"},{"id":"semetey-1-2013:p0621:b003:l013","ordinal":124065,"en":"And seated your father upon it."},{"id":"semetey-1-2013:p0621:b003:l014","ordinal":124066,"en":"Otherwise the Chinese swarmed like grass."},{"id":"semetey-1-2013:p0621:b003:l015","ordinal":124067,"en":"The forty giants headed by Ezkara—"},{"id":"semetey-1-2013:p0621:b003:l016","ordinal":124068,"en":"Chubak alone bound them, they said."},{"id":"semetey-1-2013:p0621:b003:l017","ordinal":124069,"en":"“For my sake the Chinese submitted"},{"id":"semetey-1-2013:p0621:b003:l018","ordinal":124070,"en":"In that campaign of turmoil.”"},{"id":"semetey-1-2013:p0621:b003:l019","ordinal":124071,"en":"Your valiant father returned."},{"id":"semetey-1-2013:p0621:b003:l020","ordinal":124072,"en":"In the slaughter of the Great Campaign"},{"id":"semetey-1-2013:p0621:b003:l021","ordinal":124073,"en":"He lost his Chubak."},{"id":"semetey-1-2013:p0621:b003:l022","ordinal":124074,"en":"To your lion father's side,"},{"id":"semetey-1-2013:p0621:b003:l023","ordinal":124075,"en":"His companion for the next world,"},{"id":"semetey-1-2013:p0621:b003:l024","ordinal":124076,"en":"That man Chubak must have come."},{"id":"semetey-1-2013:p0621:b003:l025","ordinal":124077,"en":"Suffering and torment"},{"id":"semetey-1-2013:p0621:b003:l026","ordinal":124078,"en":"They had endured together."},{"id":"semetey-1-2013:p0621:b003:l027","ordinal":124079,"en":"Embracing your father,"},{"id":"semetey-1-2013:p0621:b003:l028","ordinal":124080,"en":"Chubak, the lion-like warrior,"},{"id":"semetey-1-2013:p0621:b003:l029","ordinal":124081,"en":"Must be lying with him."},{"id":"semetey-1-2013:p0621:b003:l030","ordinal":124082,"en":"Like mist in the heavens,"},{"id":"semetey-1-2013:p0621:b003:l031","ordinal":124083,"en":"They must have streamed together."},{"id":"semetey-1-2013:p0621:b003:l032","ordinal":124084,"en":"Companions for the next world,"},{"id":"semetey-1-2013:p0621:b003:l033","ordinal":124085,"en":"They must have joined together."},{"id":"semetey-1-2013:p0621:b003:l034","ordinal":124086,"en":"The man lying at his feet—"},{"id":"semetey-1-2013:p0621:b003:l035","ordinal":124087,"en":"His strength matched the world."},{"id":"semetey-1-2013:p0621:b003:l036","ordinal":124088,"en":"Your father and that fierce-maned warrior"},{"id":"semetey-1-2013:p0621:b003:l037","ordinal":124089,"en":"Were sons of two brothers."},{"id":"semetey-1-2013:p0621:b003:l038","ordinal":124090,"en":"Light on a horse, fit even for a colt,"},{"id":"semetey-1-2013:p0621:b003:l039","ordinal":124091,"en":"Sleepless, watchful on the road,"},{"id":"semetey-1-2013:p0621:b004:l001","ordinal":124092,"en":"He never rested upon his elbow,"},{"id":"semetey-1-2013:p0621:b004:l002","ordinal":124093,"en":"Never took even a moment's nap,"},{"id":"semetey-1-2013:p0621:b004:l003","ordinal":124094,"en":"Peerless among sixty,"},{"id":"semetey-1-2013:p0621:b004:l004","ordinal":124095,"en":"The mightiest of the forty companions."},{"id":"semetey-1-2013:p0621:b004:l005","ordinal":124096,"en":"All their giants,"},{"id":"semetey-1-2013:p0621:b004:l006","ordinal":124097,"en":"When Syrgak shattered and slew them,"},{"id":"semetey-1-2013:p0621:b004:l007","ordinal":124098,"en":"The supreme marksman of the Chinese,"},{"id":"semetey-1-2013:p0621:b004:l008","ordinal":124099,"en":"A skilled horseman and swift runner,"},{"id":"semetey-1-2013:p0621:b004:l009","ordinal":124100,"en":"The great royal marksman himself,"},{"id":"semetey-1-2013:p0621:b004:l010","ordinal":124101,"en":"Having his dutar played,"},{"id":"semetey-1-2013:p0621:b004:l011","ordinal":124102,"en":"From the gate of Outer Beijing,"},{"id":"semetey-1-2013:p0621:b004:l012","ordinal":124103,"en":"Kojozhash was made to shoot him."},{"id":"semetey-1-2013:p0621:b004:l013","ordinal":124104,"en":"Felled in the prime of his days,"},{"id":"semetey-1-2013:p0621:b004:l014","ordinal":124105,"en":"Struck down while young,"},{"id":"semetey-1-2013:p0621:b004:l015","ordinal":124106,"en":"He died a martyr on campaign."},{"id":"semetey-1-2013:p0621:b004:l016","ordinal":124107,"en":"At the shrine called Shyiykoo"},{"id":"semetey-1-2013:p0621:b004:l017","ordinal":124108,"en":"They laid Syrgak to rest."},{"id":"semetey-1-2013:p0621:b004:l018","ordinal":124109,"en":"From that day to this,"},{"id":"semetey-1-2013:p0621:b004:l019","ordinal":124110,"en":"Through this, Shyiykoo"},{"id":"semetey-1-2013:p0621:b004:l020","ordinal":124111,"en":"Became a great shrine."},{"id":"semetey-1-2013:p0621:b004:l021","ordinal":124112,"en":"The one lying at his feet,"},{"id":"semetey-1-2013:p0621:b004:l022","ordinal":124113,"en":"The noble lion, the mighty conqueror,"},{"id":"semetey-1-2013:p0621:b004:l023","ordinal":124114,"en":"Syrgak must have come."},{"id":"semetey-1-2013:p0621:b004:l024","ordinal":124115,"en":"Who threw the whole world into confusion,"},{"id":"semetey-1-2013:p0621:b004:l025","ordinal":124116,"en":"That dear one must have come."},{"id":"semetey-1-2013:p0621:b004:l026","ordinal":124117,"en":"Beside his uncle, magnanimous Manas,"},{"id":"semetey-1-2013:p0621:b004:l027","ordinal":124118,"en":"He must be lying too."},{"id":"semetey-1-2013:p0621:b004:l028","ordinal":124119,"en":"The beautiful girl in his embrace—"},{"id":"semetey-1-2013:p0621:b004:l029","ordinal":124120,"en":"Let me tell you about her."},{"id":"semetey-1-2013:p0621:b004:l030","ordinal":124121,"en":"Toward Old Turpan,"},{"id":"semetey-1-2013:p0621:b004:l031","ordinal":124122,"en":"On this side of Barbar,"},{"id":"semetey-1-2013:p0621:b004:l032","ordinal":124123,"en":"In the Mediyan desert itself,"},{"id":"semetey-1-2013:p0621:b004:l033","ordinal":124124,"en":"Along the bank of the Lop River,"},{"id":"semetey-1-2013:p0621:b004:l034","ordinal":124125,"en":"Of a Kyrgyz lineage too,"},{"id":"semetey-1-2013:p0621:b004:l035","ordinal":124126,"en":"Also a son of saintly wisdom,"},{"id":"semetey-1-2013:p0621:b004:l036","ordinal":124127,"en":"Among the Oigut people"},{"id":"semetey-1-2013:p0621:b004:l037","ordinal":124128,"en":"A khan named Karacha arose."},{"id":"semetey-1-2013:p0621:b004:l038","ordinal":124129,"en":"Karacha's Khan Saikal—"},{"id":"semetey-1-2013:p0621:b004:l039","ordinal":124130,"en":"Lives were lost through her wrath."},{"id":"semetey-1-2013:p0622:b003:l001","ordinal":124131,"en":"Her watchmen listened across the land."},{"id":"semetey-1-2013:p0622:b003:l002","ordinal":124132,"en":"No one went there willingly."},{"id":"semetey-1-2013:p0622:b003:l003","ordinal":124133,"en":"Those who ventured there did not live."},{"id":"semetey-1-2013:p0622:b003:l004","ordinal":124134,"en":"No one dared approach."},{"id":"semetey-1-2013:p0622:b003:l005","ordinal":124135,"en":"Those who encountered her did not survive."},{"id":"semetey-1-2013:p0622:b003:l006","ordinal":124136,"en":"In his playful childhood,"},{"id":"semetey-1-2013:p0622:b003:l007","ordinal":124137,"en":"Alooke's Konurbai"},{"id":"semetey-1-2013:p0622:b003:l008","ordinal":124138,"en":"Had encountered Saikal."},{"id":"semetey-1-2013:p0622:b003:l009","ordinal":124139,"en":"Barely escaping death,"},{"id":"semetey-1-2013:p0622:b003:l010","ordinal":124140,"en":"For many days and many nights"},{"id":"semetey-1-2013:p0622:b003:l011","ordinal":124141,"en":"She fought Konurbai with spears."},{"id":"semetey-1-2013:p0622:b003:l012","ordinal":124142,"en":"The Oigut people mounted their horses,"},{"id":"semetey-1-2013:p0622:b003:l013","ordinal":124143,"en":"And crushed and slaughtered the Chinese."},{"id":"semetey-1-2013:p0622:b003:l014","ordinal":124144,"en":"Though a girl, her good deeds,"},{"id":"semetey-1-2013:p0622:b003:l015","ordinal":124145,"en":"Her light reached all the peoples."},{"id":"semetey-1-2013:p0622:b003:l017","ordinal":124146,"en":"Its steeds were born from kulans.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0622:b003:l018","ordinal":124147,"en":"Khan Manas's Akkula,"},{"id":"semetey-1-2013:p0622:b003:l019","ordinal":124148,"en":"The foal of a young mare,"},{"id":"semetey-1-2013:p0622:b003:l020","ordinal":124149,"en":"The Duldul among ordinary horses,"},{"id":"semetey-1-2013:p0622:b003:l021","ordinal":124150,"en":"Was a foal from there too."},{"id":"semetey-1-2013:p0622:b003:l022","ordinal":124151,"en":"Konurbai's black horse—"},{"id":"semetey-1-2013:p0622:b003:l023","ordinal":124152,"en":"That black horse had"},{"id":"semetey-1-2013:p0622:b003:l024","ordinal":124153,"en":"Wings upon its flanks."},{"id":"semetey-1-2013:p0622:b003:l025","ordinal":124154,"en":"If they gave poods of gold and jewels,"},{"id":"semetey-1-2013:p0622:b003:l026","ordinal":124155,"en":"Her father Karacha"},{"id":"semetey-1-2013:p0622:b003:l027","ordinal":124156,"en":"Without choosing among his steeds"},{"id":"semetey-1-2013:p0622:b003:l028","ordinal":124157,"en":"Had the custom of selling them."},{"id":"semetey-1-2013:p0622:b003:l029","ordinal":124158,"en":"Konurbai's Algara"},{"id":"semetey-1-2013:p0622:b003:l030","ordinal":124159,"en":"Was a foal from there too."},{"id":"semetey-1-2013:p0622:b003:l031","ordinal":124160,"en":"Warrior Toshtuk's Chalkuiruk"}]
