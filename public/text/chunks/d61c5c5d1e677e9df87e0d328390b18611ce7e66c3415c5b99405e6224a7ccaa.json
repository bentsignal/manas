[{"id":"seytek-2012:p0871:b002:l021","ordinal":362241,"en":"Come, my hero, resolve it now,"},{"id":"seytek-2012:p0871:b002:l022","ordinal":362242,"en":"This is my word—behold:"},{"id":"seytek-2012:p0871:b002:l023","ordinal":362243,"en":"For God's sake and for mine,"},{"id":"seytek-2012:p0871:b002:l024","ordinal":362244,"en":"I shall gladly meet them in combat,"},{"id":"seytek-2012:p0871:b002:l025","ordinal":362245,"en":"Though the people wail and heroes die,"},{"id":"seytek-2012:p0871:b002:l026","ordinal":362246,"en":"Though all are utterly spent,"},{"id":"seytek-2012:p0871:b002:l027","ordinal":362247,"en":"Stand behind me as my support,"},{"id":"seytek-2012:p0871:b002:l028","ordinal":362248,"en":"I shall attack Külchoro,"},{"id":"seytek-2012:p0871:b002:l029","ordinal":362249,"en":"I shall unleash my wrath on Seytek,"},{"id":"seytek-2012:p0871:b002:l030","ordinal":362250,"en":"I shall bring slaughter upon the Kyrgyz,"},{"id":"seytek-2012:p0871:b002:l031","ordinal":362251,"en":"I shall summon strength into my arms,"},{"id":"seytek-2012:p0871:b002:l032","ordinal":362252,"en":"If she falls into my hands, I shall humiliate her,"},{"id":"seytek-2012:p0871:b002:l033","ordinal":362253,"en":"I shall violate Chürök,"},{"id":"seytek-2012:p0871:b002:l034","ordinal":362254,"en":"Brave men, old and young,"},{"id":"seytek-2012:p0871:b002:l035","ordinal":362255,"en":"Say, “Sarybay has given the command,”"},{"id":"seytek-2012:p0871:b002:l036","ordinal":362256,"en":"Do not grieve; satisfy your desire,"},{"id":"seytek-2012:p0871:b002:l037","ordinal":362257,"en":"Let one of the seven days bring death,"},{"id":"seytek-2012:p0871:b002:l038","ordinal":362258,"en":"Why should I live on in vain?"},{"id":"seytek-2012:p0871:b002:l039","ordinal":362259,"en":"Let me gladly meet them, thrusting spears,"},{"id":"seytek-2012:p0871:b002:l040","ordinal":362260,"en":"Let us grapple violently,"},{"id":"seytek-2012:p0871:b003:l001","ordinal":362261,"en":"Let me perish fighting to the end,"},{"id":"seytek-2012:p0871:b003:l002","ordinal":362262,"en":"Aichürök is the one I desire,"},{"id":"seytek-2012:p0871:b003:l003","ordinal":362263,"en":"Kuyaly, on whom my enemies have set their sights,"},{"id":"seytek-2012:p0871:b003:l004","ordinal":362264,"en":"That radiant beauty—"},{"id":"seytek-2012:p0871:b003:l005","ordinal":362265,"en":"I shall ride straight at her and seize her,"},{"id":"seytek-2012:p0871:b003:l006","ordinal":362266,"en":"If turmoil and strife erupt on every side,"},{"id":"seytek-2012:p0871:b003:l007","ordinal":362267,"en":"Drawing bows like pouring rain,"},{"id":"seytek-2012:p0871:b003:l008","ordinal":362268,"en":"Shooting arrows like hail,"},{"id":"seytek-2012:p0871:b003:l009","ordinal":362269,"en":"When the lion's eyes blaze,"},{"id":"seytek-2012:p0871:b003:l010","ordinal":362270,"en":"When his blood-drinking frenzy seizes him,"},{"id":"seytek-2012:p0871:b003:l011","ordinal":362271,"en":"I shall settle the score in full,"},{"id":"seytek-2012:p0871:b003:l012","ordinal":362272,"en":"Making the Kyrgyz shriek,"},{"id":"seytek-2012:p0871:b003:l013","ordinal":362273,"en":"I shall drive them away and plunder them,"},{"id":"seytek-2012:p0871:b003:l014","ordinal":362274,"en":"If Külchoro struts,"},{"id":"seytek-2012:p0871:b003:l015","ordinal":362275,"en":"I shall beat the old madness from him,"},{"id":"seytek-2012:p0871:b003:l016","ordinal":362276,"en":"If the Kyrgyz roar,"},{"id":"seytek-2012:p0871:b003:l017","ordinal":362277,"en":"I shall divert the water from their riverbed,"},{"id":"seytek-2012:p0871:b003:l018","ordinal":362278,"en":"If they boast of their young hero,"},{"id":"seytek-2012:p0871:b003:l019","ordinal":362279,"en":"I shall snuff him out like a fire,"},{"id":"seytek-2012:p0871:b003:l020","ordinal":362280,"en":"Thus spoke Sarybay,"},{"id":"seytek-2012:p0871:b003:l021","ordinal":362281,"en":"Making the wide world narrow as a grain,"},{"id":"seytek-2012:p0871:b003:l022","ordinal":362282,"en":"Such was his furious state,"},{"id":"seytek-2012:p0871:b003:l023","ordinal":362283,"en":"Unable to withstand his wrath,"},{"id":"seytek-2012:p0871:b003:l024","ordinal":362284,"en":"The whole vast army marched out,"},{"id":"seytek-2012:p0871:b003:l025","ordinal":362285,"en":"From the dreadful rage of that swine,"},{"id":"seytek-2012:p0871:b003:l026","ordinal":362286,"en":"His very flesh bristled,"},{"id":"seytek-2012:p0871:b003:l027","ordinal":362287,"en":"His eyes sank deep as pits,"},{"id":"seytek-2012:p0871:b003:l028","ordinal":362288,"en":"When that swine flew into a frenzy,"},{"id":"seytek-2012:p0871:b003:l029","ordinal":362289,"en":"Unable to withstand his wrath,"},{"id":"seytek-2012:p0871:b003:l030","ordinal":362290,"en":"Of the scouts standing watch,"},{"id":"seytek-2012:p0871:b003:l031","ordinal":362291,"en":"Several were slaughtered,"},{"id":"seytek-2012:p0871:b003:l032","ordinal":362292,"en":"Whatever he faced became flame,"},{"id":"seytek-2012:p0871:b003:l033","ordinal":362293,"en":"Whatever he attacked ceased to exist,"},{"id":"seytek-2012:p0871:b003:l034","ordinal":362294,"en":"Nothing remained for him to behold,"},{"id":"seytek-2012:p0871:b003:l035","ordinal":362295,"en":"Those he routed came to a halt,"},{"id":"seytek-2012:p0871:b003:l036","ordinal":362296,"en":"Such was Sarybay's state,"},{"id":"seytek-2012:p0871:b003:l037","ordinal":362297,"en":"Rushing about in frantic haste,"},{"id":"seytek-2012:p0871:b003:l038","ordinal":362298,"en":"When grief made his eyes blaze,"},{"id":"seytek-2012:p0871:b003:l039","ordinal":362299,"en":"Whenever the wretch grew angry,"},{"id":"seytek-2012:p0871:b003:l040","ordinal":362300,"en":"The vast army roared and misery seethed,"},{"id":"seytek-2012:p0872:b002:l001","ordinal":362301,"en":"Despairing of their fly-like lives,"},{"id":"seytek-2012:p0872:b002:l002","ordinal":362302,"en":"He saddled Tookyzyld,"},{"id":"seytek-2012:p0872:b002:l003","ordinal":362303,"en":"His spirit estranged and divided,"},{"id":"seytek-2012:p0872:b002:l004","ordinal":362304,"en":"When he glowered in fury,"},{"id":"seytek-2012:p0872:b002:l005","ordinal":362305,"en":"He looked ready to suck them dry,"},{"id":"seytek-2012:p0872:b002:l006","ordinal":362306,"en":"Such was Sarybay's state:"},{"id":"seytek-2012:p0872:b002:l007","ordinal":362307,"en":"Sixty wrestlers and forty warriors"},{"id":"seytek-2012:p0872:b002:l008","ordinal":362308,"en":"Fell one by one in their places,"},{"id":"seytek-2012:p0872:b002:l009","ordinal":362309,"en":"Upon Tookyzyld,"},{"id":"seytek-2012:p0872:b002:l010","ordinal":362310,"en":"Into the steel-soled stirrups,"},{"id":"seytek-2012:p0872:b002:l011","ordinal":362311,"en":"He leapt without even setting foot,"},{"id":"seytek-2012:p0872:b002:l012","ordinal":362312,"en":"Alone from the massed army,"},{"id":"seytek-2012:p0872:b002:l013","ordinal":362313,"en":"He rode visibly forth to single combat,"},{"id":"seytek-2012:p0872:b002:l014","ordinal":362314,"en":"He appeared ready to drain"},{"id":"seytek-2012:p0872:b002:l015","ordinal":362315,"en":"Every mortal human being,"},{"id":"seytek-2012:p0872:b002:l016","ordinal":362316,"en":"A savage frenzy seized him,"},{"id":"seytek-2012:p0872:b002:l017","ordinal":362317,"en":"Against that dread man's wrath,"},{"id":"seytek-2012:p0872:b002:l018","ordinal":362318,"en":"No one could stand,"},{"id":"seytek-2012:p0872:b002:l019","ordinal":362319,"en":"His appearance utterly transformed,"},{"id":"seytek-2012:p0872:b002:l020","ordinal":362320,"en":"Chasing the whole wide world,"},{"id":"seytek-2012:p0872:b002:l021","ordinal":362321,"en":"Drawing breath like a dragon,"},{"id":"seytek-2012:p0872:b002:l022","ordinal":362322,"en":"He looked ready to suck all life away,"},{"id":"seytek-2012:p0872:b002:l023","ordinal":362323,"en":"His eyes distorted and blazed,"},{"id":"seytek-2012:p0872:b002:l024","ordinal":362324,"en":"Tookyzyld's reins"},{"id":"seytek-2012:p0872:b002:l025","ordinal":362325,"en":"He gripped now right, now left,"},{"id":"seytek-2012:p0872:b002:l026","ordinal":362326,"en":"No soul could endure his fury,"},{"id":"seytek-2012:p0872:b002:l027","ordinal":362327,"en":"The storm never left his brow,"},{"id":"seytek-2012:p0872:b002:l028","ordinal":362328,"en":"The army gathered with a clamor,"},{"id":"seytek-2012:p0872:b002:l029","ordinal":362329,"en":"Unable to withstand his wrath,"},{"id":"seytek-2012:p0872:b002:l030","ordinal":362330,"en":"All whom he looked upon were slain,"},{"id":"seytek-2012:p0872:b002:l031","ordinal":362331,"en":"Every living creature"},{"id":"seytek-2012:p0872:b002:l032","ordinal":362332,"en":"Bowed and bent its head,"},{"id":"seytek-2012:p0872:b002:l033","ordinal":362333,"en":"Whoever stared wide-eyed at him"},{"id":"seytek-2012:p0872:b002:l034","ordinal":362334,"en":"Despaired at once of life,"},{"id":"seytek-2012:p0872:b002:l035","ordinal":362335,"en":"Those skilled at thrusting spears,"},{"id":"seytek-2012:p0872:b002:l036","ordinal":362336,"en":"The stalwarts who struck with battle-axes,"},{"id":"seytek-2012:p0872:b002:l037","ordinal":362337,"en":"Those who faced fearsome foes"},{"id":"seytek-2012:p0872:b002:l038","ordinal":362338,"en":"And were drenched in black blood,"},{"id":"seytek-2012:p0872:b002:l039","ordinal":362339,"en":"Those who guarded the people,"},{"id":"seytek-2012:p0872:b002:l040","ordinal":362340,"en":"Eloquent men who never faltered,"},{"id":"seytek-2012:p0872:b003:l001","ordinal":362341,"en":"Marksmen trained in stealth,"},{"id":"seytek-2012:p0872:b003:l002","ordinal":362342,"en":"Who never shrank when facing the foe,"},{"id":"seytek-2012:p0872:b003:l003","ordinal":362343,"en":"Men born but once"},{"id":"seytek-2012:p0872:b003:l004","ordinal":362344,"en":"Into the hands of fortunate mankind,"},{"id":"seytek-2012:p0872:b003:l005","ordinal":362345,"en":"Who never withdrew what they extended,"},{"id":"seytek-2012:p0872:b003:l006","ordinal":362346,"en":"Whose grim aim never failed,"},{"id":"seytek-2012:p0872:b003:l007","ordinal":362347,"en":"True, sure-shot marksmen—"},{"id":"seytek-2012:p0872:b003:l008","ordinal":362348,"en":"When Sarybay poured out his wrath,"},{"id":"seytek-2012:p0872:b003:l009","ordinal":362349,"en":"All the heroes gathered,"},{"id":"seytek-2012:p0872:b003:l010","ordinal":362350,"en":"And wise men were slaughtered,"},{"id":"seytek-2012:p0872:b003:l011","ordinal":362351,"en":"Their hands struck against one another,"},{"id":"seytek-2012:p0872:b003:l012","ordinal":362352,"en":"When Sarybay poured out his wrath,"},{"id":"seytek-2012:p0872:b003:l013","ordinal":362353,"en":"Many among the people lost their wits,"},{"id":"seytek-2012:p0872:b003:l014","ordinal":362354,"en":"Rushing about in panic,"},{"id":"seytek-2012:p0872:b003:l015","ordinal":362355,"en":"Many mortals fled,"},{"id":"seytek-2012:p0872:b003:l016","ordinal":362356,"en":"Their faces yellow as straw,"},{"id":"seytek-2012:p0872:b003:l017","ordinal":362357,"en":"Finding no earth to enter,"},{"id":"seytek-2012:p0872:b003:l018","ordinal":362358,"en":"Finding nowhere to take shelter,"},{"id":"seytek-2012:p0872:b003:l019","ordinal":362359,"en":"Finding no flattering words to speak,"},{"id":"seytek-2012:p0872:b003:l020","ordinal":362360,"en":"Their hearts corrupted, their faces bitter,"},{"id":"seytek-2012:p0872:b003:l021","ordinal":362361,"en":"Behind the infidel slave,"},{"id":"seytek-2012:p0872:b003:l022","ordinal":362362,"en":"They found no refuge from death,"},{"id":"seytek-2012:p0872:b003:l023","ordinal":362363,"en":"The people lost their senses,"},{"id":"seytek-2012:p0872:b003:l024","ordinal":362364,"en":"And this was why they faltered:"},{"id":"seytek-2012:p0872:b003:l025","ordinal":362365,"en":"Rebuking the whole army,"},{"id":"seytek-2012:p0872:b003:l026","ordinal":362366,"en":"Sarybay stood thundering,"},{"id":"seytek-2012:p0872:b003:l027","ordinal":362367,"en":"“All our stratagems are exhausted,” they said,"},{"id":"seytek-2012:p0872:b003:l028","ordinal":362368,"en":"“In two months he has reached us,” they said,"},{"id":"seytek-2012:p0872:b003:l029","ordinal":362369,"en":"That swine Sarybay's"},{"id":"seytek-2012:p0872:b003:l030","ordinal":362370,"en":"Fierce venom became apparent,"},{"id":"seytek-2012:p0872:b003:l031","ordinal":362371,"en":"All who heard with ears and saw with eyes,"},{"id":"seytek-2012:p0872:b003:l032","ordinal":362372,"en":"The people despaired of life,"},{"id":"seytek-2012:p0872:b003:l033","ordinal":362373,"en":"Beginning their laments, crying “alas,”"},{"id":"seytek-2012:p0872:b003:l034","ordinal":362374,"en":"Every person brooded, crying “woe,”"},{"id":"seytek-2012:p0872:b003:l035","ordinal":362375,"en":"“If Sarybay flies into a rage,"},{"id":"seytek-2012:p0872:b003:l036","ordinal":362376,"en":"He will pursue us to the bitter end,” they said,"},{"id":"seytek-2012:p0872:b003:l037","ordinal":362377,"en":"“He will boastfully drive his army,"},{"id":"seytek-2012:p0872:b003:l038","ordinal":362378,"en":"Not sparing even one,"},{"id":"seytek-2012:p0872:b003:l039","ordinal":362379,"en":"And pass through in slaughter,” they said,"},{"id":"seytek-2012:p0872:b003:l040","ordinal":362380,"en":"Whether hero or lion,"},{"id":"seytek-2012:p0873:b002:l001","ordinal":362381,"en":"Whether wrestler or warrior,"},{"id":"seytek-2012:p0873:b002:l002","ordinal":362382,"en":"To the whole wide world Sarybay"},{"id":"seytek-2012:p0873:b002:l003","ordinal":362383,"en":"Seemed like a towering mountain,"},{"id":"seytek-2012:p0873:b002:l004","ordinal":362384,"en":"“The whole of that small army"},{"id":"seytek-2012:p0873:b002:l005","ordinal":362385,"en":"He drove before him and devoured,” they said,"},{"id":"seytek-2012:p0873:b002:l006","ordinal":362386,"en":"Those with sense pondered this,"},{"id":"seytek-2012:p0873:b002:l007","ordinal":362387,"en":"Unable to gather their wits,"},{"id":"seytek-2012:p0873:b002:l008","ordinal":362388,"en":"Burning without smoke,"},{"id":"seytek-2012:p0873:b002:l009","ordinal":362389,"en":"The people despaired of life,"},{"id":"seytek-2012:p0873:b002:l010","ordinal":362390,"en":"Thus the people stood,"},{"id":"seytek-2012:p0873:b002:l011","ordinal":362391,"en":"When Sarybay grew furious—"},{"id":"seytek-2012:p0873:b002:l012","ordinal":362392,"en":"Such was his valor,"},{"id":"seytek-2012:p0873:b002:l013","ordinal":362393,"en":"Hearing the wrestlers' report,"},{"id":"seytek-2012:p0873:b002:l014","ordinal":362394,"en":"Hearing that brave Seytek and valiant Choro"},{"id":"seytek-2012:p0873:b002:l015","ordinal":362395,"en":"Had slaughtered the army,"},{"id":"seytek-2012:p0873:b002:l016","ordinal":362396,"en":"He bound his soul to death,"},{"id":"seytek-2012:p0873:b002:l017","ordinal":362397,"en":"As for remaining alive and not dying,"},{"id":"seytek-2012:p0873:b002:l018","ordinal":362398,"en":"The guest-soul granted by the Creator—"},{"id":"seytek-2012:p0873:b002:l019","ordinal":362399,"en":"How could his savage fury spare it?"},{"id":"seytek-2012:p0873:b002:l020","ordinal":362400,"en":"Sarybay, son of the ogre—"},{"id":"seytek-2012:p0873:b002:l021","ordinal":362401,"en":"Such was his boldness,"},{"id":"seytek-2012:p0873:b002:l022","ordinal":362402,"en":"Tugging his coat of mail straight,"},{"id":"seytek-2012:p0873:b002:l023","ordinal":362403,"en":"Shaking out his cuirass,"},{"id":"seytek-2012:p0873:b002:l024","ordinal":362404,"en":"“I am a hero against those with skill,"},{"id":"seytek-2012:p0873:b002:l025","ordinal":362405,"en":"And against a foe whose skill has failed,"},{"id":"seytek-2012:p0873:b002:l026","ordinal":362406,"en":"I am the dreadful end of time,"},{"id":"seytek-2012:p0873:b002:l027","ordinal":362407,"en":"I am the walnut ember itself,"},{"id":"seytek-2012:p0873:b002:l028","ordinal":362408,"en":"Burning like a river and slaughtering nations,"},{"id":"seytek-2012:p0873:b002:l029","ordinal":362409,"en":"When my frenzy seizes me again,"},{"id":"seytek-2012:p0873:b002:l030","ordinal":362410,"en":"I am the black eye of the scourge,"},{"id":"seytek-2012:p0873:b002:l031","ordinal":362411,"en":"I am calamity incarnate,"},{"id":"seytek-2012:p0873:b002:l032","ordinal":362412,"en":"I am the source of every slayer,"},{"id":"seytek-2012:p0873:b002:l033","ordinal":362413,"en":"I am savagery itself,"},{"id":"seytek-2012:p0873:b002:l034","ordinal":362414,"en":"Gnawing whoever I encounter,"},{"id":"seytek-2012:p0873:b002:l035","ordinal":362415,"en":"Devouring whoever I find,"},{"id":"seytek-2012:p0873:b002:l036","ordinal":362416,"en":"Mangling whoever crosses me,"},{"id":"seytek-2012:p0873:b002:l037","ordinal":362417,"en":"I am the black scourge itself,"},{"id":"seytek-2012:p0873:b002:l038","ordinal":362418,"en":"I shall be a bleak ridge"},{"id":"seytek-2012:p0873:b002:l039","ordinal":362419,"en":"That weary men cannot cross,"},{"id":"seytek-2012:p0873:b002:l040","ordinal":362420,"en":"I am the black scourge"},{"id":"seytek-2012:p0873:b004:l001","ordinal":362421,"en":"That mangles any soul it meets,"},{"id":"seytek-2012:p0873:b004:l002","ordinal":362422,"en":"While you still have mighty strength,"},{"id":"seytek-2012:p0873:b004:l003","ordinal":362423,"en":"How could I yield my assembled army?"},{"id":"seytek-2012:p0873:b004:l004","ordinal":362424,"en":"Külchoro has run mad—"},{"id":"seytek-2012:p0873:b004:l005","ordinal":362425,"en":"I shall give him his full punishment,"},{"id":"seytek-2012:p0873:b004:l006","ordinal":362426,"en":"If Khan Seytek crosses my path,"},{"id":"seytek-2012:p0873:b004:l007","ordinal":362427,"en":"I shall seize him and spill his blood,"},{"id":"seytek-2012:p0873:b004:l008","ordinal":362428,"en":"If Semetey crosses my path,"},{"id":"seytek-2012:p0873:b004:l009","ordinal":362429,"en":"I shall tear apart his ribs,"},{"id":"seytek-2012:p0873:b004:l010","ordinal":362430,"en":"If Bakai confronts me,"},{"id":"seytek-2012:p0873:b004:l011","ordinal":362431,"en":"I shall beat the old man's fury from him,"},{"id":"seytek-2012:p0873:b004:l012","ordinal":362432,"en":"If Kuyaly grapples with me,"},{"id":"seytek-2012:p0873:b004:l013","ordinal":362433,"en":"I shall settle her account.”"},{"id":"seytek-2012:p0873:b004:l014","ordinal":362434,"en":"Saying this, he thundered,"},{"id":"seytek-2012:p0873:b004:l015","ordinal":362435,"en":"Every mortal human's"},{"id":"seytek-2012:p0873:b004:l016","ordinal":362436,"en":"Whole free body shuddered,"},{"id":"seytek-2012:p0873:b004:l017","ordinal":362437,"en":"Sarybay, son of the ogre,"},{"id":"seytek-2012:p0873:b004:l018","ordinal":362438,"en":"Pressed the wretched people sorely,"},{"id":"seytek-2012:p0873:b004:l019","ordinal":362439,"en":"His shout splitting heads,"},{"id":"seytek-2012:p0873:b004:l020","ordinal":362440,"en":"The doomed man's bellowing,"},{"id":"seytek-2012:p0873:b004:l021","ordinal":362441,"en":"His roar splitting stones,"},{"id":"seytek-2012:p0873:b004:l022","ordinal":362442,"en":"Against that dread man's wrath,"},{"id":"seytek-2012:p0873:b004:l023","ordinal":362443,"en":"No one could stand and look,"},{"id":"seytek-2012:p0873:b004:l024","ordinal":362444,"en":"When the infidel gathered force,"},{"id":"seytek-2012:p0873:b004:l025","ordinal":362445,"en":"No person could withstand him,"},{"id":"seytek-2012:p0873:b004:l026","ordinal":362446,"en":"Such was the true might"},{"id":"seytek-2012:p0873:b004:l027","ordinal":362447,"en":"Of the infidel, the ogre's son,"},{"id":"seytek-2012:p0873:b004:l028","ordinal":362448,"en":"Then Sarybay"},{"id":"seytek-2012:p0873:b004:l029","ordinal":362449,"en":"Was seized by his blood-drinking frenzy,"},{"id":"seytek-2012:p0873:b004:l030","ordinal":362450,"en":"All who looked on were astonished,"},{"id":"seytek-2012:p0873:b004:l031","ordinal":362451,"en":"No one remained unhurried,"},{"id":"seytek-2012:p0873:b004:l032","ordinal":362452,"en":"His wrath became a grievous force,"},{"id":"seytek-2012:p0873:b004:l033","ordinal":362453,"en":"Then Sarybay,"},{"id":"seytek-2012:p0873:b004:l034","ordinal":362454,"en":"His eyes reddening like fire,"},{"id":"seytek-2012:p0873:b004:l035","ordinal":362455,"en":"Swelled with menace and strained for battle,"},{"id":"seytek-2012:p0873:b004:l036","ordinal":362456,"en":"Taking up his slaughtering steel spear,"},{"id":"seytek-2012:p0873:b004:l037","ordinal":362457,"en":"The raging madman,"},{"id":"seytek-2012:p0873:b004:l038","ordinal":362458,"en":"With a steel mace as large as a house,"},{"id":"seytek-2012:p0873:b004:l039","ordinal":362459,"en":"His bloodthirsty eyes rolling,"},{"id":"seytek-2012:p0873:b004:l040","ordinal":362460,"en":"Glowering, his hair bristling,"},{"id":"seytek-2012:p0874:b002:l001","ordinal":362461,"en":"He began the quarrel with a deep growl,"},{"id":"seytek-2012:p0874:b002:l002","ordinal":362462,"en":"Such again was Sarybay,"},{"id":"seytek-2012:p0874:b002:l003","ordinal":362463,"en":"A man fully prepared for battle,"},{"id":"seytek-2012:p0874:b002:l004","ordinal":362464,"en":"Those who heard with ears and saw with eyes"},{"id":"seytek-2012:p0874:b002:l005","ordinal":362465,"en":"Called him Sarybay the Devourer,"},{"id":"seytek-2012:p0874:b002:l006","ordinal":362466,"en":"Toward the poor and powerless,"},{"id":"seytek-2012:p0874:b002:l007","ordinal":362467,"en":"He seemed never to look back,"},{"id":"seytek-2012:p0874:b002:l008","ordinal":362468,"en":"Ready now, in his madness,"},{"id":"seytek-2012:p0874:b002:l009","ordinal":362469,"en":"To consume the entire world,"},{"id":"seytek-2012:p0874:b002:l010","ordinal":362470,"en":"His aspect strange, his venom strong,"},{"id":"seytek-2012:p0874:b002:l011","ordinal":362471,"en":"“If you see his wrath, I am dead,” they said,"},{"id":"seytek-2012:p0874:b002:l012","ordinal":362472,"en":"“Abandon hope for your precious life,”"},{"id":"seytek-2012:p0874:b002:l013","ordinal":362473,"en":"His thoroughbred horse was Tookyzyld,"},{"id":"seytek-2012:p0874:b002:l014","ordinal":362474,"en":"He saddled Tookyzyld,"},{"id":"seytek-2012:p0874:b002:l015","ordinal":362475,"en":"Arranged his arms and armor,"},{"id":"seytek-2012:p0874:b002:l016","ordinal":362476,"en":"And buckled on his flashing sword,"},{"id":"seytek-2012:p0874:b002:l017","ordinal":362477,"en":"When the bloodthirsty man reared for battle,"},{"id":"seytek-2012:p0874:b002:l018","ordinal":362478,"en":"His appearance utterly transformed,"},{"id":"seytek-2012:p0874:b002:l019","ordinal":362479,"en":"He seemed ready to drive the whole world"},{"id":"seytek-2012:p0874:b002:l020","ordinal":362480,"en":"Before him and slaughter it,"},{"id":"seytek-2012:p0874:b002:l021","ordinal":362481,"en":"His shaggy hair stood bristling,"},{"id":"seytek-2012:p0874:b002:l022","ordinal":362482,"en":"Then its wild rising subsided,"},{"id":"seytek-2012:p0874:b002:l023","ordinal":362483,"en":"A hazy crimson fire"},{"id":"seytek-2012:p0874:b002:l024","ordinal":362484,"en":"Scattered all around,"},{"id":"seytek-2012:p0874:b002:l025","ordinal":362485,"en":"He screamed, pouring out his wrath,"},{"id":"seytek-2012:p0874:b002:l026","ordinal":362486,"en":"Making the wrestlers flatten their ears,"},{"id":"seytek-2012:p0874:b002:l027","ordinal":362487,"en":"And now committed a dreadful deed:"},{"id":"seytek-2012:p0874:b002:l028","ordinal":362488,"en":"“My name is Sarybay,"},{"id":"seytek-2012:p0874:b002:l029","ordinal":362489,"en":"Let harsh affliction be revealed,"},{"id":"seytek-2012:p0874:b002:l030","ordinal":362490,"en":"Let blood and gore pour from combat,"},{"id":"seytek-2012:p0874:b002:l031","ordinal":362491,"en":"Do not go on living—pass away,"},{"id":"seytek-2012:p0874:b002:l032","ordinal":362492,"en":"Without leaving a single one,"},{"id":"seytek-2012:p0874:b002:l033","ordinal":362493,"en":"Go and slaughter one another!"},{"id":"seytek-2012:p0874:b002:l034","ordinal":362494,"en":"My mighty men, my warriors,"},{"id":"seytek-2012:p0874:b002:l035","ordinal":362495,"en":"My lions who stand beside me,"},{"id":"seytek-2012:p0874:b002:l036","ordinal":362496,"en":"Bold men girded for war,"}]
