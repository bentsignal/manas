{"id": "sayakbay-ms-current146:pdf225:l014", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 225, "folio": 608, "line_in_page": 14, "raw": "Журт кыргыздан озонун,", "text": "Журт кыргыздан озонун,", "en": "The finest one among the Kyrgyz people,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf225:l015", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 225, "folio": 608, "line_in_page": 15, "raw": "Жоктон кетип баратат,", "text": "Жоктон кетип баратат,", "en": "He was departing into nothingness.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf225:l016", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 225, "folio": 608, "line_in_page": 16, "raw": "Аркайган тоо бийик,", "text": "Аркайган тоо бийик,", "en": "The looming mountain was high.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
