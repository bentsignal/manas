[{"id":"semetey-1-2013:p0747:b005:l006","ordinal":134145,"en":"They bow like Kalmyks."},{"id":"semetey-1-2013:p0747:b005:l007","ordinal":134146,"en":"If you ask how Kobosh fares:"},{"id":"semetey-1-2013:p0747:b005:l008","ordinal":134147,"en":"Eating yearlings of barren mares,"},{"id":"semetey-1-2013:p0747:b005:l009","ordinal":134148,"en":"Eating frozen goat fat,"},{"id":"semetey-1-2013:p0747:b005:l010","ordinal":134149,"en":"The six scoundrels revel in arrogance."},{"id":"semetey-1-2013:p0747:b005:l011","ordinal":134150,"en":"Akolpok, left by Manas—"},{"id":"semetey-1-2013:p0747:b005:l012","ordinal":134151,"en":"If you ask about that coat,"},{"id":"semetey-1-2013:p0747:b005:l013","ordinal":134152,"en":"When leopard Manas lived,"},{"id":"semetey-1-2013:p0747:b005:l014","ordinal":134153,"en":"Double mail with rings like larks' eyes,"},{"id":"semetey-1-2013:p0747:b005:l015","ordinal":134154,"en":"Worn in battle, no bullet could pierce it;"},{"id":"semetey-1-2013:p0747:b005:l016","ordinal":134155,"en":"When thrust at, no spear could pierce it."},{"id":"semetey-1-2013:p0747:b005:l017","ordinal":134156,"en":"That dear woman Kanykei"},{"id":"semetey-1-2013:p0747:b005:l018","ordinal":134157,"en":"With skeins of golden steel"},{"id":"semetey-1-2013:p0747:b005:l019","ordinal":134158,"en":"Had it tightly wound,"},{"id":"semetey-1-2013:p0747:b005:l020","ordinal":134159,"en":"Dazzling the eyes when one gazed."},{"id":"semetey-1-2013:p0747:b005:l021","ordinal":134160,"en":"Poor lord Manas's"},{"id":"semetey-1-2013:p0747:b005:l022","ordinal":134161,"en":"Joy she satisfied in this way."},{"id":"semetey-1-2013:p0747:b005:l023","ordinal":134162,"en":"Kelte's bullet could not cut through it."},{"id":"semetey-1-2013:p0747:b005:l024","ordinal":134163,"en":"Alas, this world!"},{"id":"semetey-1-2013:p0747:b005:l025","ordinal":134164,"en":"Even if six thousand Chinese attacked from behind,"},{"id":"semetey-1-2013:p0747:b005:l027","ordinal":134165,"en":"No cutting blade could slash through it;"},{"id":"semetey-1-2013:p0747:b005:l028","ordinal":134166,"en":"No thrusting spear could pierce it."},{"id":"semetey-1-2013:p0747:b005:l029","ordinal":134167,"en":"A precious fabric of esteemed worth,"},{"id":"semetey-1-2013:p0747:b005:l030","ordinal":134168,"en":"Khan Manas's Akolpok—"},{"id":"semetey-1-2013:p0747:b005:l031","ordinal":134169,"en":"They have taken it as booty."},{"id":"semetey-1-2013:p0747:b005:l032","ordinal":134170,"en":"The six scoundrels, raised as commoners,"},{"id":"semetey-1-2013:p0747:b005:l033","ordinal":134171,"en":"They have put it on carelessly."},{"id":"semetey-1-2013:p0747:b005:l034","ordinal":134172,"en":"This Akolpok of Manas—"},{"id":"semetey-1-2013:p0747:b005:l035","ordinal":134173,"en":"They have taken it as booty."},{"id":"semetey-1-2013:p0747:b005:l036","ordinal":134174,"en":"For the orphan, the Bloodthirsty One's son,"},{"id":"semetey-1-2013:p0747:b005:l037","ordinal":134175,"en":"Ask for it and obtain it."},{"id":"semetey-1-2013:p0747:b005:l038","ordinal":134176,"en":"If they refuse when you ask,"},{"id":"semetey-1-2013:p0747:b005:l039","ordinal":134177,"en":"Then unleash an upheaval."},{"id":"semetey-1-2013:p0748:b003:l001","ordinal":134178,"en":"I will not die burning with grief."},{"id":"semetey-1-2013:p0748:b003:l002","ordinal":134179,"en":"The magnanimous khan's Akolpok—"},{"id":"semetey-1-2013:p0748:b003:l003","ordinal":134180,"en":"I cannot bear to see those dogs have it."},{"id":"semetey-1-2013:p0748:b003:l004","ordinal":134181,"en":"Ask for it as a gift and take it away."},{"id":"semetey-1-2013:p0748:b003:l005","ordinal":134182,"en":"Listen, elder, there is more."},{"id":"semetey-1-2013:p0748:b003:l006","ordinal":134183,"en":"Once, from the pass of Kum-Bulak,"},{"id":"semetey-1-2013:p0748:b003:l007","ordinal":134184,"en":"Leopard Manas, the bloodthirsty lion,"},{"id":"semetey-1-2013:p0748:b003:l008","ordinal":134185,"en":"While out on a raid,"},{"id":"semetey-1-2013:p0748:b003:l009","ordinal":134186,"en":"In the desert of an empty plain,"},{"id":"semetey-1-2013:p0748:b003:l010","ordinal":134187,"en":"Encountered by unseen providence,"},{"id":"semetey-1-2013:p0748:b003:l011","ordinal":134188,"en":"Six sharp blades in the empty plain"},{"id":"semetey-1-2013:p0748:b003:l012","ordinal":134189,"en":"Were found by leopard Khan Manas."},{"id":"semetey-1-2013:p0748:b003:l013","ordinal":134190,"en":"The very finest of swords:"},{"id":"semetey-1-2013:p0748:b003:l014","ordinal":134191,"en":"Zulpukor, taken by Manas,"},{"id":"semetey-1-2013:p0748:b003:l015","ordinal":134192,"en":"Khan Bakai's Oikuma,"},{"id":"semetey-1-2013:p0748:b003:l016","ordinal":134193,"en":"Azhybai's Achalbars,"},{"id":"semetey-1-2013:p0748:b003:l017","ordinal":134194,"en":"Zhoikuma, taken by Almambet,"},{"id":"semetey-1-2013:p0748:b003:l018","ordinal":134195,"en":"Kylbolot, taken by Chubak,"},{"id":"semetey-1-2013:p0748:b003:l019","ordinal":134196,"en":"Narkesken, taken by Syrgak."},{"id":"semetey-1-2013:p0748:b003:l020","ordinal":134197,"en":"Those were the six sharp steel blades."},{"id":"semetey-1-2013:p0748:b003:l021","ordinal":134198,"en":"To every enemy they fought,"},{"id":"semetey-1-2013:p0748:b003:l022","ordinal":134199,"en":"Those treasures brought torment."},{"id":"semetey-1-2013:p0748:b003:l023","ordinal":134200,"en":"Upon any enemy who turned against them,"},{"id":"semetey-1-2013:p0748:b003:l024","ordinal":134201,"en":"Those blades brought slaughter."},{"id":"semetey-1-2013:p0748:b003:l025","ordinal":134202,"en":"When eagerly drawn from their sheaths,"},{"id":"semetey-1-2013:p0748:b003:l026","ordinal":134203,"en":"They never went idle without drinking blood."},{"id":"semetey-1-2013:p0748:b003:l027","ordinal":134204,"en":"Unless thoroughly sated with blood,"},{"id":"semetey-1-2013:p0748:b003:l028","ordinal":134205,"en":"They would not go back into their sheaths."},{"id":"semetey-1-2013:p0748:b003:l029","ordinal":134206,"en":"When hardship beset the heroes,"},{"id":"semetey-1-2013:p0748:b003:l030","ordinal":134207,"en":"When an enemy came against them,"},{"id":"semetey-1-2013:p0748:b003:l031","ordinal":134208,"en":"Valiant Manas and the six lions,"},{"id":"semetey-1-2013:p0748:b003:l032","ordinal":134209,"en":"The heroes drew them from their sheaths."},{"id":"semetey-1-2013:p0748:b003:l033","ordinal":134210,"en":"With every swing they lengthened."},{"id":"semetey-1-2013:p0748:b003:l034","ordinal":134211,"en":"When all those noble men had died,"},{"id":"semetey-1-2013:p0748:b003:l035","ordinal":134212,"en":"The six blades were left as spoils,"},{"id":"semetey-1-2013:p0748:b003:l036","ordinal":134213,"en":"In the hands of the six scoundrels."},{"id":"semetey-1-2013:p0748:b003:l037","ordinal":134214,"en":"Elder Bakai, remember:"},{"id":"semetey-1-2013:p0748:b003:l038","ordinal":134215,"en":"Akkelte, left by leopard Manas,"},{"id":"semetey-1-2013:p0748:b003:l039","ordinal":134216,"en":"In play, an ochogor gun,"},{"id":"semetey-1-2013:p0748:b004:l001","ordinal":134217,"en":"When fired in earnest, a koichagyr gun."},{"id":"semetey-1-2013:p0748:b004:l002","ordinal":134218,"en":"When slung on his back, the noble thing"},{"id":"semetey-1-2013:p0748:b004:l003","ordinal":134219,"en":"Was a mirror for his shoulder blades."},{"id":"semetey-1-2013:p0748:b004:l004","ordinal":134220,"en":"When aimed at an enemy in battle,"},{"id":"semetey-1-2013:p0748:b004:l005","ordinal":134221,"en":"It was solace for his mortal soul."},{"id":"semetey-1-2013:p0748:b004:l006","ordinal":134222,"en":"Almabash, of surpassingly keen iron,"},{"id":"semetey-1-2013:p0748:b004:l007","ordinal":134223,"en":"Made no distinction between far and near."},{"id":"semetey-1-2013:p0748:b004:l008","ordinal":134224,"en":"It would not fail for sixty days."},{"id":"semetey-1-2013:p0748:b004:l009","ordinal":134225,"en":"Akkelte, the living gun,"},{"id":"semetey-1-2013:p0748:b004:l010","ordinal":134226,"en":"That blessed thing has become booty."},{"id":"semetey-1-2013:p0748:b004:l011","ordinal":134227,"en":"It is in Kobosh's hands."},{"id":"semetey-1-2013:p0748:b004:l012","ordinal":134228,"en":"Ask for it and take it away."},{"id":"semetey-1-2013:p0748:b004:l013","ordinal":134229,"en":"Elder Bakai, hear my words."},{"id":"semetey-1-2013:p0748:b004:l014","ordinal":134230,"en":"The forty warriors left by Manas"},{"id":"semetey-1-2013:p0748:b004:l015","ordinal":134231,"en":"Were forty dogs from forty places."},{"id":"semetey-1-2013:p0748:b004:l016","ordinal":134232,"en":"Since old Kyrgyl became their chief,"},{"id":"semetey-1-2013:p0748:b004:l017","ordinal":134233,"en":"What were they but dogs?"},{"id":"semetey-1-2013:p0748:b004:l018","ordinal":134234,"en":"Full of liquor, running wild—"},{"id":"semetey-1-2013:p0748:b004:l019","ordinal":134235,"en":"Elder Bakai, take thought,"},{"id":"semetey-1-2013:p0748:b004:l020","ordinal":134236,"en":"Lest they rush to attack."},{"id":"semetey-1-2013:p0748:b004:l021","ordinal":134237,"en":"That warrior Tazbaimat"},{"id":"semetey-1-2013:p0748:b004:l022","ordinal":134238,"en":"Was an exceptionally cunning bald man."},{"id":"semetey-1-2013:p0748:b004:l023","ordinal":134239,"en":"He had little skill as an envoy;"},{"id":"semetey-1-2013:p0748:b004:l024","ordinal":134240,"en":"He was Kanykei's enemy."},{"id":"semetey-1-2013:p0748:b004:l025","ordinal":134241,"en":"Abyke, Kobosh, the six scoundrels,"},{"id":"semetey-1-2013:p0748:b004:l026","ordinal":134242,"en":"Were puffed up, drunk on wealth."},{"id":"semetey-1-2013:p0748:b004:l027","ordinal":134243,"en":"Men had died and blood was shed;"},{"id":"semetey-1-2013:p0748:b004:l028","ordinal":134244,"en":"Elder, they were your enemies."},{"id":"semetey-1-2013:p0748:b004:l029","ordinal":134245,"en":"The scoundrels Abyke and Kobosh—"},{"id":"semetey-1-2013:p0748:b004:l030","ordinal":134246,"en":"His conduct gave the body no comfort,"},{"id":"semetey-1-2013:p0748:b004:l031","ordinal":134247,"en":"Their deeds bring no joy to the soul."},{"id":"semetey-1-2013:p0748:b004:l032","ordinal":134248,"en":"Valiant elder, hear my words."},{"id":"semetey-1-2013:p0748:b004:l033","ordinal":134249,"en":"I shall fashion a speech,"},{"id":"semetey-1-2013:p0748:b004:l034","ordinal":134250,"en":"And those dogs full of millet beer"},{"id":"semetey-1-2013:p0748:b004:l035","ordinal":134251,"en":"I shall send along the wrong road."},{"id":"semetey-1-2013:p0748:b004:l036","ordinal":134252,"en":"I shall go in cautiously,"},{"id":"semetey-1-2013:p0748:b004:l037","ordinal":134253,"en":"And those dogs full of liquor"},{"id":"semetey-1-2013:p0748:b004:l038","ordinal":134254,"en":"I shall send along a distant road."},{"id":"semetey-1-2013:p0748:b004:l039","ordinal":134255,"en":"For the orphan left by the magnanimous one,"},{"id":"semetey-1-2013:p0749:b003:l001","ordinal":134256,"en":"I shall clear his land.\""},{"id":"semetey-1-2013:p0749:b003:l002","ordinal":134257,"en":"Khan Bakai remained on watch."},{"id":"semetey-1-2013:p0749:b003:l003","ordinal":134258,"en":"Shuutu the servant went back."},{"id":"semetey-1-2013:p0749:b003:l004","ordinal":134259,"en":"Having seen so many lands,"},{"id":"semetey-1-2013:p0749:b003:l005","ordinal":134260,"en":"Experienced Shuutu went along."},{"id":"semetey-1-2013:p0749:b003:l006","ordinal":134261,"en":"With mature wisdom and a broad mind,"},{"id":"semetey-1-2013:p0749:b003:l007","ordinal":134262,"en":"Resourceful Shuutu went along."},{"id":"semetey-1-2013:p0749:b003:l008","ordinal":134263,"en":"When Khan Manas lived,"},{"id":"semetey-1-2013:p0749:b003:l009","ordinal":134264,"en":"He had often traveled as an envoy."},{"id":"semetey-1-2013:p0749:b003:l010","ordinal":134265,"en":"Experienced Shuutu went along."},{"id":"semetey-1-2013:p0749:b003:l011","ordinal":134266,"en":"Do not ask about Shuutu:"},{"id":"semetey-1-2013:p0749:b003:l012","ordinal":134267,"en":"When lion Manas lived,"},{"id":"semetey-1-2013:p0749:b003:l013","ordinal":134268,"en":"He had him ride a swift camel,"},{"id":"semetey-1-2013:p0749:b003:l014","ordinal":134269,"en":"Sent him roaming the face of the earth,"},{"id":"semetey-1-2013:p0749:b003:l015","ordinal":134270,"en":"Had him learn of everything."},{"id":"semetey-1-2013:p0749:b003:l016","ordinal":134271,"en":"Taking six swift horses,"},{"id":"semetey-1-2013:p0749:b003:l017","ordinal":134272,"en":"What could lion Shuutu do?"},{"id":"semetey-1-2013:p0749:b003:l018","ordinal":134273,"en":"Making a letter the size of a palm,"},{"id":"semetey-1-2013:p0749:b003:l019","ordinal":134274,"en":"He had roamed the earth."},{"id":"semetey-1-2013:p0749:b003:l020","ordinal":134275,"en":"From every scholar he had received a letter."},{"id":"semetey-1-2013:p0749:b003:l021","ordinal":134276,"en":"He was called lion Shuutu."},{"id":"semetey-1-2013:p0749:b003:l022","ordinal":134277,"en":"Deep in wisdom, greatly eloquent,"},{"id":"semetey-1-2013:p0749:b003:l023","ordinal":134278,"en":"Hero Shuutu never wavered."},{"id":"semetey-1-2013:p0749:b003:l024","ordinal":134279,"en":"He honed his dark tongue,"},{"id":"semetey-1-2013:p0749:b003:l025","ordinal":134280,"en":"Spoke eloquently before the people."},{"id":"semetey-1-2013:p0749:b003:l026","ordinal":134281,"en":"Swift in speech, with a nimble tongue,"},{"id":"semetey-1-2013:p0749:b003:l027","ordinal":134282,"en":"He was the hero who could find an argument."},{"id":"semetey-1-2013:p0749:b003:l028","ordinal":134283,"en":"For the forty warriors,"},{"id":"semetey-1-2013:p0749:b003:l029","ordinal":134284,"en":"Now he would put on a spectacle."},{"id":"semetey-1-2013:p0749:b003:l030","ordinal":134285,"en":"To Khan Kobosh's court,"},{"id":"semetey-1-2013:p0749:b003:l031","ordinal":134286,"en":"To Abyke's wide valley,"},{"id":"semetey-1-2013:p0749:b003:l032","ordinal":134287,"en":"To the place where they held council,"},{"id":"semetey-1-2013:p0749:b003:l033","ordinal":134288,"en":"Roaring in anger,"},{"id":"semetey-1-2013:p0749:b003:l034","ordinal":134289,"en":"Calling out, \"Forty warriors!\""},{"id":"semetey-1-2013:p0749:b003:l035","ordinal":134290,"en":"Shuutu the servant made a scene."},{"id":"semetey-1-2013:p0749:b003:l036","ordinal":134291,"en":"For the elders led by Kyrgyl,"},{"id":"semetey-1-2013:p0749:b003:l037","ordinal":134292,"en":"As though slaughter had struck,"},{"id":"semetey-1-2013:p0749:b003:l038","ordinal":134293,"en":"He made a spectacle for them all."},{"id":"semetey-1-2013:p0749:b003:l039","ordinal":134294,"en":"These were Shuutu's words;"},{"id":"semetey-1-2013:p0749:b004:l001","ordinal":134295,"en":"Here was the uproar he unleashed:"},{"id":"semetey-1-2013:p0749:b004:l002","ordinal":134296,"en":"\"Collapse, instead of being forty warriors!"},{"id":"semetey-1-2013:p0749:b004:l003","ordinal":134297,"en":"You have no sentry posted on the ridge."},{"id":"semetey-1-2013:p0749:b004:l004","ordinal":134298,"en":"You are all ruined!"},{"id":"semetey-1-2013:p0749:b004:l005","ordinal":134299,"en":"Your father's grave, forty warriors!"},{"id":"semetey-1-2013:p0749:b004:l006","ordinal":134300,"en":"When precious Khan Manas died,"},{"id":"semetey-1-2013:p0749:b004:l007","ordinal":134301,"en":"When all died with Manas,"},{"id":"semetey-1-2013:p0749:b004:l008","ordinal":134302,"en":"You forty warriors were left."},{"id":"semetey-1-2013:p0749:b004:l009","ordinal":134303,"en":"After the lord passed away,"},{"id":"semetey-1-2013:p0749:b004:l010","ordinal":134304,"en":"You settled along the river."},{"id":"semetey-1-2013:p0749:b004:l011","ordinal":134305,"en":"After gray-maned Manas died,"},{"id":"semetey-1-2013:p0749:b004:l012","ordinal":134306,"en":"You became like an extinguished fire."},{"id":"semetey-1-2013:p0749:b004:l013","ordinal":134307,"en":"Your father's grave, forty warriors!"},{"id":"semetey-1-2013:p0749:b004:l014","ordinal":134308,"en":"Drink stones, not liquor!"},{"id":"semetey-1-2013:p0749:b004:l015","ordinal":134309,"en":"If that is too little, forty warriors,"},{"id":"semetey-1-2013:p0749:b004:l016","ordinal":134310,"en":"Drink your father's blood as well!"},{"id":"semetey-1-2013:p0749:b004:l017","ordinal":134311,"en":"You have no garden planted in Talas."},{"id":"semetey-1-2013:p0749:b004:l018","ordinal":134312,"en":"Your father's grave, forty warriors!"},{"id":"semetey-1-2013:p0749:b004:l019","ordinal":134313,"en":"This is no time to lie with legs spread."},{"id":"semetey-1-2013:p0749:b004:l020","ordinal":134314,"en":"You have no garden planted in the broad valley."},{"id":"semetey-1-2013:p0749:b004:l021","ordinal":134315,"en":"Your father's grave, forty pigs!"},{"id":"semetey-1-2013:p0749:b004:l022","ordinal":134316,"en":"This is no time to stretch out idly."},{"id":"semetey-1-2013:p0749:b004:l023","ordinal":134317,"en":"When whatever you wished for came,"},{"id":"semetey-1-2013:p0749:b004:l024","ordinal":134318,"en":"Is there a night like the Night of Power?"},{"id":"semetey-1-2013:p0749:b004:l025","ordinal":134319,"en":"Whole otter pelts"},{"id":"semetey-1-2013:p0749:b004:l026","ordinal":134320,"en":"You divided in halves"},{"id":"semetey-1-2013:p0749:b004:l027","ordinal":134321,"en":"And made into trouser legs—"},{"id":"semetey-1-2013:p0749:b004:l028","ordinal":134322,"en":"Are those former days still here?"},{"id":"semetey-1-2013:p0749:b004:l029","ordinal":134323,"en":"You don't have to worry about it."},{"id":"semetey-1-2013:p0749:b004:l030","ordinal":134324,"en":"This is no time to sprawl about."},{"id":"semetey-1-2013:p0749:b004:l031","ordinal":134325,"en":"You have lands you made desolate;"},{"id":"semetey-1-2013:p0749:b004:l032","ordinal":134326,"en":"Many peoples bear you a grudge."},{"id":"semetey-1-2013:p0749:b004:l033","ordinal":134327,"en":"The Six Cities, the khan of Kokand,"},{"id":"semetey-1-2013:p0749:b004:l034","ordinal":134328,"en":"Andijan and broad Bukhara,"},{"id":"semetey-1-2013:p0749:b004:l035","ordinal":134329,"en":"Farther away, Afghanistan and India—"},{"id":"semetey-1-2013:p0749:b004:l036","ordinal":134330,"en":"You have these enemies to fight."},{"id":"semetey-1-2013:p0749:b004:l037","ordinal":134331,"en":"On your right are the Russians;"},{"id":"semetey-1-2013:p0749:b004:l038","ordinal":134332,"en":"On the hills are the Chinese."},{"id":"semetey-1-2013:p0749:b004:l039","ordinal":134333,"en":"You have many enemies to clash with."},{"id":"semetey-1-2013:p0750:b003:l001","ordinal":134334,"en":"Kobosh and Abyke, who became khans—"},{"id":"semetey-1-2013:p0750:b003:l002","ordinal":134335,"en":"You have elders such as these,"},{"id":"semetey-1-2013:p0750:b003:l003","ordinal":134336,"en":"And every sort of enemy to fight."},{"id":"semetey-1-2013:p0750:b003:l004","ordinal":134337,"en":"Farther away there are also the Chinese."},{"id":"semetey-1-2013:p0750:b003:l005","ordinal":134338,"en":"His fame resounding among the people,"},{"id":"semetey-1-2013:p0750:b003:l006","ordinal":134339,"en":"There is their khan, Khan Kongurbai;"},{"id":"semetey-1-2013:p0750:b003:l007","ordinal":134340,"en":"You have another enemy to fight."},{"id":"semetey-1-2013:p0750:b003:l008","ordinal":134341,"en":"While you drink liquor, panting,"},{"id":"semetey-1-2013:p0750:b003:l009","ordinal":134342,"en":"And revel, unaware,"},{"id":"semetey-1-2013:p0750:b003:l010","ordinal":134343,"en":"There are those who will give you all a spectacle,"},{"id":"semetey-1-2013:p0750:b003:l011","ordinal":134344,"en":"Those who will slaughter you all without looking back."},{"id":"semetey-1-2013:p0750:b003:l012","ordinal":134345,"en":"If the countless Chinese swarm upon you,"},{"id":"semetey-1-2013:p0750:b003:l013","ordinal":134346,"en":"There is no forest to flee into."},{"id":"semetey-1-2013:p0750:b003:l014","ordinal":134347,"en":"To unleash an upheaval,"},{"id":"semetey-1-2013:p0750:b003:l015","ordinal":134348,"en":"To rescue you,"},{"id":"semetey-1-2013:p0750:b003:l016","ordinal":134349,"en":"Bloodthirsty Manas is not here."},{"id":"semetey-1-2013:p0750:b003:l017","ordinal":134350,"en":"Drink your shit, not mare's milk!"},{"id":"semetey-1-2013:p0750:b003:l018","ordinal":134351,"en":"Instead of drinking liquor, forty warriors,"},{"id":"semetey-1-2013:p0750:b003:l019","ordinal":134352,"en":"Drink your ancestor's blood."},{"id":"semetey-1-2013:p0750:b003:l020","ordinal":134353,"en":"When I kept watch and scouted the land,"},{"id":"semetey-1-2013:p0750:b003:l021","ordinal":134354,"en":"When I received alarming news,"},{"id":"semetey-1-2013:p0750:b003:l022","ordinal":134355,"en":"From Kara-Buura and Chatkal"},{"id":"semetey-1-2013:p0750:b003:l023","ordinal":134356,"en":"Dust rose in surging clouds."},{"id":"semetey-1-2013:p0750:b003:l024","ordinal":134357,"en":"When I looked at that surging dust,"},{"id":"semetey-1-2013:p0750:b003:l025","ordinal":134358,"en":"I, hero Shuutu, was scared to death."},{"id":"semetey-1-2013:p0750:b003:l026","ordinal":134359,"en":"The Black Chinese and countless Manchu,"},{"id":"semetey-1-2013:p0750:b003:l027","ordinal":134360,"en":"With Khan Kongurbai at their head,"},{"id":"semetey-1-2013:p0750:b003:l028","ordinal":134361,"en":"Seem to be swarming upon us."},{"id":"semetey-1-2013:p0750:b003:l029","ordinal":134362,"en":"When Manas died, all died."},{"id":"semetey-1-2013:p0750:b003:l030","ordinal":134363,"en":"Your father's grave, forty warriors!"},{"id":"semetey-1-2013:p0750:b003:l031","ordinal":134364,"en":"Your day of ruin has come!\""},{"id":"semetey-1-2013:p0750:b003:l032","ordinal":134365,"en":"As Shuutu spoke thus,"},{"id":"semetey-1-2013:p0750:b003:l033","ordinal":134366,"en":"Khan Manas's forty warriors,"},{"id":"semetey-1-2013:p0750:b003:l034","ordinal":134367,"en":"As though slaughter had struck,"},{"id":"semetey-1-2013:p0750:b003:l035","ordinal":134368,"en":"Rushed about in a spectacle,"},{"id":"semetey-1-2013:p0750:b003:l036","ordinal":134369,"en":"Trampling and tearing their hems,"},{"id":"semetey-1-2013:p0750:b003:l037","ordinal":134370,"en":"Running in a flurry,"},{"id":"semetey-1-2013:p0750:b003:l038","ordinal":134371,"en":"Blowing their trumpets."},{"id":"semetey-1-2013:p0750:b003:l039","ordinal":134372,"en":"The red one-humped camels left by Manas"},{"id":"semetey-1-2013:p0750:b004:l001","ordinal":134373,"en":"They loaded heavily with provisions."},{"id":"semetey-1-2013:p0750:b004:l002","ordinal":134374,"en":"They made ready their weapons,"},{"id":"semetey-1-2013:p0750:b004:l003","ordinal":134375,"en":"Strapped on their small cooking pots,"},{"id":"semetey-1-2013:p0750:b004:l004","ordinal":134376,"en":"Beat their drums,"},{"id":"semetey-1-2013:p0750:b004:l005","ordinal":134377,"en":"And toward Kara-Buura and Chatkal"},{"id":"semetey-1-2013:p0750:b004:l006","ordinal":134378,"en":"All rushed off together."},{"id":"semetey-1-2013:p0750:b004:l007","ordinal":134379,"en":"Among the forty warriors,"},{"id":"semetey-1-2013:p0750:b004:l008","ordinal":134380,"en":"Adybai and Kolbai, two scoundrels,"},{"id":"semetey-1-2013:p0750:b004:l009","ordinal":134381,"en":"Chyibyt and Kochkor, making four scoundrels,"},{"id":"semetey-1-2013:p0750:b004:l010","ordinal":134382,"en":"Now went away with them."},{"id":"semetey-1-2013:p0750:b004:l011","ordinal":134383,"en":"Great Bakai saw them leave."},{"id":"semetey-1-2013:p0750:b004:l012","ordinal":134384,"en":"On that day Kokcholok"},{"id":"semetey-1-2013:p0750:b004:l013","ordinal":134385,"en":"Sped like an arrow in flight."},{"id":"semetey-1-2013:p0750:b004:l014","ordinal":134386,"en":"On that day Kokcholok—"},{"id":"semetey-1-2013:p0750:b004:l015","ordinal":134387,"en":"The black stones he passed over"},{"id":"semetey-1-2013:p0750:b004:l016","ordinal":134388,"en":"Crumbled like charcoal."},{"id":"semetey-1-2013:p0750:b004:l017","ordinal":134389,"en":"The wind could not match his trot;"},{"id":"semetey-1-2013:p0750:b004:l018","ordinal":134390,"en":"No beast could match his walk."},{"id":"semetey-1-2013:p0750:b004:l019","ordinal":134391,"en":"He thundered like a cloud."},{"id":"semetey-1-2013:p0750:b004:l020","ordinal":134392,"en":"When Kokcholok went along,"},{"id":"semetey-1-2013:p0750:b004:l021","ordinal":134393,"en":"The tips of the grass trembled."},{"id":"semetey-1-2013:p0750:b004:l022","ordinal":134394,"en":"When he ran with stretching strides,"},{"id":"semetey-1-2013:p0750:b004:l023","ordinal":134395,"en":"He looked like a wild mountain sheep."},{"id":"semetey-1-2013:p0750:b004:l024","ordinal":134396,"en":"\"Though an animal, he has a soul;"},{"id":"semetey-1-2013:p0750:b004:l025","ordinal":134397,"en":"He is making a wish,\" he thought."},{"id":"semetey-1-2013:p0750:b004:l026","ordinal":134398,"en":"Bakai, whom you have seen,"},{"id":"semetey-1-2013:p0750:b004:l027","ordinal":134399,"en":"Was deeply moved."},{"id":"semetey-1-2013:p0750:b004:l028","ordinal":134400,"en":"Eagerly heading toward his orphan,"}]
