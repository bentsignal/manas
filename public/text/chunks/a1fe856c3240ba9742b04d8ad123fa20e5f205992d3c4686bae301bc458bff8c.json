[{"id":"semetey-1-2013:p0439:b004:l025","ordinal":110593,"en":"His chosen faith and belief,"},{"id":"semetey-1-2013:p0439:b004:l026","ordinal":110594,"en":"The yellow willows he had had planted—"},{"id":"semetey-1-2013:p0439:b004:l027","ordinal":110595,"en":"His willows remained in Beijing."},{"id":"semetey-1-2013:p0439:b004:l028","ordinal":110596,"en":"Made of pure gold,"},{"id":"semetey-1-2013:p0439:b004:l029","ordinal":110597,"en":"His throne remained in Beijing."},{"id":"semetey-1-2013:p0439:b004:l030","ordinal":110598,"en":"The prophet, the sultan, his faith pure—"},{"id":"semetey-1-2013:p0439:b004:l031","ordinal":110599,"en":"The golden throne remained in Beijing."},{"id":"semetey-1-2013:p0439:b004:l032","ordinal":110600,"en":"When he held the emperor in his grasp,"},{"id":"semetey-1-2013:p0439:b004:l033","ordinal":110601,"en":"When our Alake ruled Beijing as khan,"},{"id":"semetey-1-2013:p0439:b004:l034","ordinal":110602,"en":"Coral, jeweled cap ornaments, precious stones—"},{"id":"semetey-1-2013:p0439:b004:l035","ordinal":110603,"en":"When Khan Almam wore them,"},{"id":"semetey-1-2013:p0439:b004:l036","ordinal":110604,"en":"When his authority reached Beijing,"},{"id":"semetey-1-2013:p0439:b004:l037","ordinal":110605,"en":"And our Alake held it in his sway,"},{"id":"semetey-1-2013:p0439:b004:l038","ordinal":110606,"en":"When his envoy to the golden throne"},{"id":"semetey-1-2013:p0439:b004:l039","ordinal":110607,"en":"Would go,"},{"id":"semetey-1-2013:p0440:b003:l001","ordinal":110608,"en":"When upon Beijing an uproar"},{"id":"semetey-1-2013:p0440:b003:l002","ordinal":110609,"en":"He was bringing,"},{"id":"semetey-1-2013:p0440:b003:l003","ordinal":110610,"en":"As he lay asleep, there appeared"},{"id":"semetey-1-2013:p0440:b003:l004","ordinal":110611,"en":"A white-bearded holy man."},{"id":"semetey-1-2013:p0440:b003:l005","ordinal":110612,"en":"He endured distress in his sleep;"},{"id":"semetey-1-2013:p0440:b003:l006","ordinal":110613,"en":"Whenever Alake fell asleep,"},{"id":"semetey-1-2013:p0440:b003:l007","ordinal":110614,"en":"He dreamed of paradise and hell."},{"id":"semetey-1-2013:p0440:b003:l008","ordinal":110615,"en":"Because of Judgment Day,"},{"id":"semetey-1-2013:p0440:b003:l009","ordinal":110616,"en":"Because of hell, that bastard Almam"},{"id":"semetey-1-2013:p0440:b003:l010","ordinal":110617,"en":"Said, 'Among my unbelieving people,"},{"id":"semetey-1-2013:p0440:b003:l011","ordinal":110618,"en":"How can I remain?"},{"id":"semetey-1-2013:p0440:b003:l012","ordinal":110619,"en":"Among Muslims of the true faith"},{"id":"semetey-1-2013:p0440:b003:l013","ordinal":110620,"en":"I shall go and join them"},{"id":"semetey-1-2013:p0440:b003:l014","ordinal":110621,"en":"And render faithful service."},{"id":"semetey-1-2013:p0440:b003:l015","ordinal":110622,"en":"That hoarse-voiced idol of theirs,"},{"id":"semetey-1-2013:p0440:b003:l016","ordinal":110623,"en":"How can I call it God?"},{"id":"semetey-1-2013:p0440:b003:l017","ordinal":110624,"en":"I shall flee to the Muslims"},{"id":"semetey-1-2013:p0440:b003:l018","ordinal":110625,"en":"And take thought for the world beyond."},{"id":"semetey-1-2013:p0440:b003:l019","ordinal":110626,"en":"A great idol made of bronze,"},{"id":"semetey-1-2013:p0440:b003:l020","ordinal":110627,"en":"How can I call it God?"},{"id":"semetey-1-2013:p0440:b003:l021","ordinal":110628,"en":"My extraordinary tulpar Sarala—"},{"id":"semetey-1-2013:p0440:b003:l022","ordinal":110629,"en":"How can I saddle him, dividing the gear into ten?"},{"id":"semetey-1-2013:p0440:b003:l023","ordinal":110630,"en":"Before that reckless idol,"},{"id":"semetey-1-2013:p0440:b003:l024","ordinal":110631,"en":"Wretched soul that I am, how can I bear to bow?'"},{"id":"semetey-1-2013:p0440:b003:l026","ordinal":110632,"en":"He fled and came to Talas,"},{"id":"semetey-1-2013:p0440:b003:l027","ordinal":110633,"en":"Becoming a friend into the world beyond"},{"id":"semetey-1-2013:p0440:b003:l028","ordinal":110634,"en":"To your father Manas."},{"id":"semetey-1-2013:p0440:b003:l029","ordinal":110635,"en":"When Alake lived in Beijing,"},{"id":"semetey-1-2013:p0440:b003:l030","ordinal":110636,"en":"Those who saw his authority trembled."},{"id":"semetey-1-2013:p0440:b003:l031","ordinal":110637,"en":"Alake learned wondrous spells"},{"id":"semetey-1-2013:p0440:b003:l032","ordinal":110638,"en":"At the lake of Abergen,"},{"id":"semetey-1-2013:p0440:b003:l033","ordinal":110639,"en":"In the depths of Suuk-Tör,"},{"id":"semetey-1-2013:p0440:b003:l034","ordinal":110640,"en":"In the land of the One-Eyed One."},{"id":"semetey-1-2013:p0440:b003:l035","ordinal":110641,"en":"He saddled Sarala properly;"},{"id":"semetey-1-2013:p0440:b003:l036","ordinal":110642,"en":"The great lore from which no traveler returns"},{"id":"semetey-1-2013:p0440:b003:l037","ordinal":110643,"en":"He learned from a dragon."},{"id":"semetey-1-2013:p0440:b003:l038","ordinal":110644,"en":"Those who witnessed his renown trembled."},{"id":"semetey-1-2013:p0440:b003:l039","ordinal":110645,"en":"Tall in stature, broad in shoulder,"},{"id":"semetey-1-2013:p0440:b004:l001","ordinal":110646,"en":"Both champion and lion,"},{"id":"semetey-1-2013:p0440:b004:l002","ordinal":110647,"en":"The little son of Azyz Khan of Beijing,"},{"id":"semetey-1-2013:p0440:b004:l003","ordinal":110648,"en":"The seething Chinese host—"},{"id":"semetey-1-2013:p0440:b004:l004","ordinal":110649,"en":"The leopard Alake beheld them then."},{"id":"semetey-1-2013:p0440:b004:l005","ordinal":110650,"en":"Brown eyes without a speck,"},{"id":"semetey-1-2013:p0440:b004:l006","ordinal":110651,"en":"A fair face without a freckle,"},{"id":"semetey-1-2013:p0440:b004:l007","ordinal":110652,"en":"Great as a mountain in size,"},{"id":"semetey-1-2013:p0440:b004:l008","ordinal":110653,"en":"At that moment Alake,"},{"id":"semetey-1-2013:p0440:b004:l009","ordinal":110654,"en":"Kongurbai, khan of the monks,"},{"id":"semetey-1-2013:p0440:b004:l010","ordinal":110655,"en":"He would have seized and devoured him, had they met."},{"id":"semetey-1-2013:p0440:b004:l011","ordinal":110656,"en":"Against the thick multitudes, the great army,"},{"id":"semetey-1-2013:p0440:b004:l012","ordinal":110657,"en":"The leopard Almam, a hero alone,"},{"id":"semetey-1-2013:p0440:b004:l013","ordinal":110658,"en":"Roared in wrath,"},{"id":"semetey-1-2013:p0440:b004:l014","ordinal":110659,"en":"Calling 'Manas!' as his battle-cry."},{"id":"semetey-1-2013:p0440:b004:l015","ordinal":110660,"en":"Firmly girding his waist,"},{"id":"semetey-1-2013:p0440:b004:l016","ordinal":110661,"en":"Against seventy thousand Chinese"},{"id":"semetey-1-2013:p0440:b004:l017","ordinal":110662,"en":"Almam charged and attacked."},{"id":"semetey-1-2013:p0440:b004:l018","ordinal":110663,"en":"Sarala, with lean, cow-like haunches,"},{"id":"semetey-1-2013:p0440:b004:l019","ordinal":110664,"en":"He made his courser prance."},{"id":"semetey-1-2013:p0440:b004:l020","ordinal":110665,"en":"Whomever he encountered, that dear lion"},{"id":"semetey-1-2013:p0440:b004:l021","ordinal":110666,"en":"Speared deep and sent sprawling."},{"id":"semetey-1-2013:p0440:b004:l022","ordinal":110667,"en":"Syrgak, son of Ulakkan,"},{"id":"semetey-1-2013:p0440:b004:l023","ordinal":110668,"en":"Made Kökchebich prance as well."},{"id":"semetey-1-2013:p0440:b004:l024","ordinal":110669,"en":"Whomever he met, that dear lion"},{"id":"semetey-1-2013:p0440:b004:l025","ordinal":110670,"en":"Struck this way and that."},{"id":"semetey-1-2013:p0440:b004:l026","ordinal":110671,"en":"His mount was a splendid tulpar."},{"id":"semetey-1-2013:p0440:b004:l027","ordinal":110672,"en":"When the massed Chinese, the khakan's people,"},{"id":"semetey-1-2013:p0440:b004:l028","ordinal":110673,"en":"Were besieging Talas,"},{"id":"semetey-1-2013:p0440:b004:l029","ordinal":110674,"en":"Almambet and Syrgak together,"},{"id":"semetey-1-2013:p0440:b004:l030","ordinal":110675,"en":"Ajybai and Bakai, the two khans,"},{"id":"semetey-1-2013:p0440:b004:l031","ordinal":110676,"en":"Almambet and Chubak, the paired heroes,"},{"id":"semetey-1-2013:p0440:b004:l032","ordinal":110677,"en":"Syrgak and Serek, heroes equally matched,"},{"id":"semetey-1-2013:p0440:b004:l033","ordinal":110678,"en":"Akjoltoi, son of Adyk Khan,"},{"id":"semetey-1-2013:p0440:b004:l034","ordinal":110679,"en":"The Magnanimous One's companions,"},{"id":"semetey-1-2013:p0440:b004:l035","ordinal":110680,"en":"Each like an army ten thousand strong,"},{"id":"semetey-1-2013:p0440:b004:l036","ordinal":110681,"en":"When they all charged into their midst,"},{"id":"semetey-1-2013:p0440:b004:l037","ordinal":110682,"en":"With your magnanimous father among them,"},{"id":"semetey-1-2013:p0440:b004:l038","ordinal":110683,"en":"Against sixty thousand Black Chinese"},{"id":"semetey-1-2013:p0440:b004:l039","ordinal":110684,"en":"They struck like falcons,"},{"id":"semetey-1-2013:p0441:b003:l001","ordinal":110685,"en":"The unbelievers, thick as black willows,"},{"id":"semetey-1-2013:p0441:b003:l002","ordinal":110686,"en":"They encircled, drove, and slaughtered,"},{"id":"semetey-1-2013:p0441:b003:l003","ordinal":110687,"en":"Scattering them toward Beijing."},{"id":"semetey-1-2013:p0441:b003:l004","ordinal":110688,"en":"Their very center, hero Manas"},{"id":"semetey-1-2013:p0441:b003:l005","ordinal":110689,"en":"Carved open as he came."},{"id":"semetey-1-2013:p0441:b003:l006","ordinal":110690,"en":"Their two flanks, the heroes"},{"id":"semetey-1-2013:p0441:b003:l007","ordinal":110691,"en":"Slaughtered as they came."},{"id":"semetey-1-2013:p0441:b003:l008","ordinal":110692,"en":"One side, hero Bakai"},{"id":"semetey-1-2013:p0441:b003:l009","ordinal":110693,"en":"Closed in upon as he came."},{"id":"semetey-1-2013:p0441:b003:l010","ordinal":110694,"en":"Their very middle, the falcons of men"},{"id":"semetey-1-2013:p0441:b003:l011","ordinal":110695,"en":"Battered as they came."},{"id":"semetey-1-2013:p0441:b003:l012","ordinal":110696,"en":"Their outermost edge, Khan Chubak"},{"id":"semetey-1-2013:p0441:b003:l013","ordinal":110697,"en":"Drove forward as he came."},{"id":"semetey-1-2013:p0441:b003:l014","ordinal":110698,"en":"Their very rear, Khan Syrgak"},{"id":"semetey-1-2013:p0441:b003:l015","ordinal":110699,"en":"Laid low as he came."},{"id":"semetey-1-2013:p0441:b003:l016","ordinal":110700,"en":"Drenching them in red blood,"},{"id":"semetey-1-2013:p0441:b003:l017","ordinal":110701,"en":"My dear Almam, that precious lion,"},{"id":"semetey-1-2013:p0441:b003:l018","ordinal":110702,"en":"Drove them onward as he came."},{"id":"semetey-1-2013:p0441:b003:l019","ordinal":110703,"en":"Leaving none they met alive,"},{"id":"semetey-1-2013:p0441:b003:l020","ordinal":110704,"en":"All the falcons of men"},{"id":"semetey-1-2013:p0441:b003:l021","ordinal":110705,"en":"Laid them low as they came."},{"id":"semetey-1-2013:p0441:b003:l022","ordinal":110706,"en":"Unable to withstand their wrath,"},{"id":"semetey-1-2013:p0441:b003:l023","ordinal":110707,"en":"The Chinese broke apart in flight."},{"id":"semetey-1-2013:p0441:b003:l024","ordinal":110708,"en":"Unable to withstand their valor,"},{"id":"semetey-1-2013:p0441:b003:l025","ordinal":110709,"en":"They scattered in every direction."},{"id":"semetey-1-2013:p0441:b003:l026","ordinal":110710,"en":"Many warriors were slaughtered;"},{"id":"semetey-1-2013:p0441:b003:l027","ordinal":110711,"en":"Still more were caught in the net."},{"id":"semetey-1-2013:p0441:b003:l028","ordinal":110712,"en":"Unable to gather their wits,"},{"id":"semetey-1-2013:p0441:b003:l029","ordinal":110713,"en":"Many of the khakan's people died;"},{"id":"semetey-1-2013:p0441:b003:l030","ordinal":110714,"en":"Still more were taken captive."},{"id":"semetey-1-2013:p0441:b003:l031","ordinal":110715,"en":"The distinguished warriors led by Kongurbai,"},{"id":"semetey-1-2013:p0441:b003:l032","ordinal":110716,"en":"All those heroes,"},{"id":"semetey-1-2013:p0441:b003:l033","ordinal":110717,"en":"Were seen fleeing in the foremost ranks."},{"id":"semetey-1-2013:p0441:b003:l034","ordinal":110718,"en":"The feeble men without courage"},{"id":"semetey-1-2013:p0441:b003:l035","ordinal":110719,"en":"Could not escape; their blood was spilled."},{"id":"semetey-1-2013:p0441:b003:l036","ordinal":110720,"en":"When the many Chinese, fleeing in haste,"},{"id":"semetey-1-2013:p0441:b003:l037","ordinal":110721,"en":"Crossed broad Talas,"},{"id":"semetey-1-2013:p0441:b003:l038","ordinal":110722,"en":"They took the road along the Ili,"},{"id":"semetey-1-2013:p0441:b003:l039","ordinal":110723,"en":"Traveling by night, not by day."},{"id":"semetey-1-2013:p0441:b005:l001","ordinal":110724,"en":"The forty companions led by Manas"},{"id":"semetey-1-2013:p0441:b005:l002","ordinal":110725,"en":"Stayed relentlessly upon their trail,"},{"id":"semetey-1-2013:p0441:b005:l003","ordinal":110726,"en":"Pursuing them to exhaustion."},{"id":"semetey-1-2013:p0441:b005:l004","ordinal":110727,"en":"Hero Bakai, son of Oluyat,"},{"id":"semetey-1-2013:p0441:b005:l005","ordinal":110728,"en":"Scouted their road day and night."},{"id":"semetey-1-2013:p0441:b005:l006","ordinal":110729,"en":"When to the green willows beside the Ili"},{"id":"semetey-1-2013:p0441:b005:l007","ordinal":110730,"en":"They drew near,"},{"id":"semetey-1-2013:p0441:b005:l008","ordinal":110731,"en":"Weighing counsel, thinking deeply,"},{"id":"semetey-1-2013:p0441:b005:l009","ordinal":110732,"en":"Kongurbai, son of Alööke,"},{"id":"semetey-1-2013:p0441:b005:l010","ordinal":110733,"en":"Thought, 'If we keep fleeing, our khakan's land,"},{"id":"semetey-1-2013:p0441:b005:l011","ordinal":110734,"en":"If we continue thus, to Manas"},{"id":"semetey-1-2013:p0441:b005:l012","ordinal":110735,"en":"We shall lose it.'"},{"id":"semetey-1-2013:p0441:b005:l013","ordinal":110736,"en":"The Burut and Chinese did not come together;"},{"id":"semetey-1-2013:p0441:b005:l014","ordinal":110737,"en":"From the far bank and the near bank"},{"id":"semetey-1-2013:p0441:b005:l015","ordinal":110738,"en":"They fired their guns at one another,"},{"id":"semetey-1-2013:p0441:b005:l016","ordinal":110739,"en":"Fighting without mercy."},{"id":"semetey-1-2013:p0441:b005:l017","ordinal":110740,"en":"Unable to reach with their spears,"},{"id":"semetey-1-2013:p0441:b005:l018","ordinal":110741,"en":"They clashed with drawn bows."},{"id":"semetey-1-2013:p0441:b005:l019","ordinal":110742,"en":"They stood confronting each other,"},{"id":"semetey-1-2013:p0441:b005:l020","ordinal":110743,"en":"Never idle, fighting thus."},{"id":"semetey-1-2013:p0441:b005:l021","ordinal":110744,"en":"Ways that would bring death"},{"id":"semetey-1-2013:p0441:b005:l022","ordinal":110745,"en":"The heroes contrived as best they could."},{"id":"semetey-1-2013:p0441:b005:l023","ordinal":110746,"en":"With golden forelock and tasseled belt,"},{"id":"semetey-1-2013:p0441:b005:l024","ordinal":110747,"en":"Almambet, son of Azyz Khan,"},{"id":"semetey-1-2013:p0441:b005:l025","ordinal":110748,"en":"The weather-stone obtained from the unseen,"},{"id":"semetey-1-2013:p0441:b005:l026","ordinal":110749,"en":"Reciting its true spell,"},{"id":"semetey-1-2013:p0441:b005:l027","ordinal":110750,"en":"Took and struck into the water."},{"id":"semetey-1-2013:p0441:b005:l028","ordinal":110751,"en":"The cloud's name was Buurakan;"},{"id":"semetey-1-2013:p0441:b005:l029","ordinal":110752,"en":"Calling out that name,"},{"id":"semetey-1-2013:p0441:b005:l030","ordinal":110753,"en":"The weather-stone obtained from a snake,"},{"id":"semetey-1-2013:p0441:b005:l031","ordinal":110754,"en":"In a bowl of plain water"},{"id":"semetey-1-2013:p0441:b005:l032","ordinal":110755,"en":"He made it barely touch the surface."},{"id":"semetey-1-2013:p0441:b005:l033","ordinal":110756,"en":"Clouded by day, clear at night—"},{"id":"semetey-1-2013:p0441:b005:l034","ordinal":110757,"en":"Almambet cast his weather-spell."},{"id":"semetey-1-2013:p0441:b005:l035","ordinal":110758,"en":"Windblown drizzle turning to snow,"},{"id":"semetey-1-2013:p0441:b005:l036","ordinal":110759,"en":"Gusty winds and abundant hail,"},{"id":"semetey-1-2013:p0441:b005:l037","ordinal":110760,"en":"Hiding the face of the earth,"},{"id":"semetey-1-2013:p0441:b005:l038","ordinal":110761,"en":"A ground-hugging fog descended."},{"id":"semetey-1-2013:p0441:b005:l039","ordinal":110762,"en":"When they saw this weather,"},{"id":"semetey-1-2013:p0442:b003:l001","ordinal":110763,"en":"They lost their wits,"},{"id":"semetey-1-2013:p0442:b003:l002","ordinal":110764,"en":"Hurrying and hastening along the road,"},{"id":"semetey-1-2013:p0442:b003:l003","ordinal":110765,"en":"Fleeing toward Beijing."},{"id":"semetey-1-2013:p0442:b003:l004","ordinal":110766,"en":"Crossing deep ravines athwart their path,"},{"id":"semetey-1-2013:p0442:b003:l005","ordinal":110767,"en":"Passing distant, towering peaks,"},{"id":"semetey-1-2013:p0442:b003:l006","ordinal":110768,"en":"Not lying down to sleep their fill,"},{"id":"semetey-1-2013:p0442:b003:l007","ordinal":110769,"en":"Not letting their tulpars graze,"},{"id":"semetey-1-2013:p0442:b003:l008","ordinal":110770,"en":"Not resting upon an elbow,"},{"id":"semetey-1-2013:p0442:b003:l009","ordinal":110771,"en":"Not taking even a brief nap,"},{"id":"semetey-1-2013:p0442:b003:l010","ordinal":110772,"en":"Kongurbai fled in earnest."},{"id":"semetey-1-2013:p0442:b003:l011","ordinal":110773,"en":"How could your hero hold back?"},{"id":"semetey-1-2013:p0442:b003:l012","ordinal":110774,"en":"Keeping by the mountains of Lower Khangai,"},{"id":"semetey-1-2013:p0442:b003:l013","ordinal":110775,"en":"Turning his trail and journeying on,"},{"id":"semetey-1-2013:p0442:b003:l014","ordinal":110776,"en":"Sparing no horse, covering great distances,"},{"id":"semetey-1-2013:p0442:b003:l015","ordinal":110777,"en":"Kongurbai, son of Alööke,"},{"id":"semetey-1-2013:p0442:b003:l016","ordinal":110778,"en":"Crossed many rounded mountains,"},{"id":"semetey-1-2013:p0442:b003:l017","ordinal":110779,"en":"Lurching through the ravines."},{"id":"semetey-1-2013:p0442:b003:l018","ordinal":110780,"en":"Having entered Talas and turned back,"},{"id":"semetey-1-2013:p0442:b003:l019","ordinal":110781,"en":"He had lost his countless army."},{"id":"semetey-1-2013:p0442:b003:l020","ordinal":110782,"en":"Having gone to the Kyrgyz and turned back,"},{"id":"semetey-1-2013:p0442:b003:l021","ordinal":110783,"en":"Makil and Orokkyr,"},{"id":"semetey-1-2013:p0442:b003:l022","ordinal":110784,"en":"He had lost those two."},{"id":"semetey-1-2013:p0442:b003:l023","ordinal":110785,"en":"Midday was darkened in heaven."},{"id":"semetey-1-2013:p0442:b003:l024","ordinal":110786,"en":"Kongurbai, son of Alööke,"},{"id":"semetey-1-2013:p0442:b003:l025","ordinal":110787,"en":"That pig who knew the land well,"},{"id":"semetey-1-2013:p0442:b003:l026","ordinal":110788,"en":"Made good his escape."},{"id":"semetey-1-2013:p0442:b003:l027","ordinal":110789,"en":"Then Almambet"},{"id":"semetey-1-2013:p0442:b003:l028","ordinal":110790,"en":"And the lion Bakai, those four,"},{"id":"semetey-1-2013:p0442:b003:l029","ordinal":110791,"en":"The giants and champions left between them,"},{"id":"semetey-1-2013:p0442:b003:l030","ordinal":110792,"en":"Eight of their monks,"},{"id":"semetey-1-2013:p0442:b003:l031","ordinal":110793,"en":"Alake caught up with and shot."},{"id":"semetey-1-2013:p0442:b003:l032","ordinal":110794,"en":"With Alake and Bakai at their head,"},{"id":"semetey-1-2013:p0442:b003:l033","ordinal":110795,"en":"They crossed along Talkuu."},{"id":"semetey-1-2013:p0442:b003:l034","ordinal":110796,"en":"On moon-like Sary-Talaa,"},{"id":"semetey-1-2013:p0442:b003:l035","ordinal":110797,"en":"Of the Black Kalmyks and Manchus,"},{"id":"semetey-1-2013:p0442:b003:l036","ordinal":110798,"en":"They overran the distant herdsmen."},{"id":"semetey-1-2013:p0442:b003:l037","ordinal":110799,"en":"Taking some twelve thousand horses,"},{"id":"semetey-1-2013:p0442:b003:l038","ordinal":110800,"en":"Your devastating heroes turned back."},{"id":"semetey-1-2013:p0442:b003:l039","ordinal":110801,"en":"Of the people left after the deaths,"},{"id":"semetey-1-2013:p0442:b004:l001","ordinal":110802,"en":"They scattered monks and captured clerics."},{"id":"semetey-1-2013:p0442:b004:l002","ordinal":110803,"en":"Without dispute the Kyrgyz took booty."},{"id":"semetey-1-2013:p0442:b004:l003","ordinal":110804,"en":"The most skillful men"},{"id":"semetey-1-2013:p0442:b004:l004","ordinal":110805,"en":"Took sixty horses apiece."},{"id":"semetey-1-2013:p0442:b004:l005","ordinal":110806,"en":"The weak-jointed who could not keep up"},{"id":"semetey-1-2013:p0442:b004:l006","ordinal":110807,"en":"Drove off seven horses apiece."},{"id":"semetey-1-2013:p0442:b004:l007","ordinal":110808,"en":"The finest falcons of men"},{"id":"semetey-1-2013:p0442:b004:l008","ordinal":110809,"en":"Took seventy as booty apiece."},{"id":"semetey-1-2013:p0442:b004:l009","ordinal":110810,"en":"The feeble who could not keep up"},{"id":"semetey-1-2013:p0442:b004:l010","ordinal":110811,"en":"Took seven horses as booty apiece."},{"id":"semetey-1-2013:p0442:b004:l011","ordinal":110812,"en":"The Kyrgyz and Argyn in Talas"},{"id":"semetey-1-2013:p0442:b004:l012","ordinal":110813,"en":"They satisfied in all their wishes,"},{"id":"semetey-1-2013:p0442:b004:l013","ordinal":110814,"en":"All their chests"},{"id":"semetey-1-2013:p0442:b004:l014","ordinal":110815,"en":"Filling with yellow gold and treasure."},{"id":"semetey-1-2013:p0442:b004:l015","ordinal":110816,"en":"Those Argyn and Kyrgyz people"},{"id":"semetey-1-2013:p0442:b004:l016","ordinal":110817,"en":"They satisfied in their wishes,"},{"id":"semetey-1-2013:p0442:b004:l017","ordinal":110818,"en":"They satisfied in their hearts."},{"id":"semetey-1-2013:p0442:b004:l018","ordinal":110819,"en":"Of the Kyrgyz and Argyn in Talas,"},{"id":"semetey-1-2013:p0442:b004:l019","ordinal":110820,"en":"Every storage chest"},{"id":"semetey-1-2013:p0442:b004:l020","ordinal":110821,"en":"They filled with abundant gold."},{"id":"semetey-1-2013:p0442:b004:l021","ordinal":110822,"en":"They hid the livestock pens in dust,"},{"id":"semetey-1-2013:p0442:b004:l022","ordinal":110823,"en":"And the Argyn and Kyrgyz"},{"id":"semetey-1-2013:p0442:b004:l023","ordinal":110824,"en":"They made more prosperous than other peoples."},{"id":"semetey-1-2013:p0442:b004:l024","ordinal":110825,"en":"They pursued the Chinese and took booty,"},{"id":"semetey-1-2013:p0442:b004:l025","ordinal":110826,"en":"Bringing the army back united and undivided."},{"id":"semetey-1-2013:p0442:b004:l026","ordinal":110827,"en":"At that time, against your father"},{"id":"semetey-1-2013:p0442:b004:l027","ordinal":110828,"en":"The twelve peoples made no attack."},{"id":"semetey-1-2013:p0442:b004:l028","ordinal":110829,"en":"Against that dauntless man of surpassing fortune,"},{"id":"semetey-1-2013:p0442:b004:l029","ordinal":110830,"en":"None remained to raise a herding-pole."},{"id":"semetey-1-2013:p0442:b004:l030","ordinal":110831,"en":"Dwelling in great Talas,"},{"id":"semetey-1-2013:p0442:b004:l031","ordinal":110832,"en":"Your blood-shedding father, the sultan,"},{"id":"semetey-1-2013:p0442:b004:l032","ordinal":110833,"en":"No one dared approach."},{"id":"semetey-1-2013:p0442:b004:l033","ordinal":110834,"en":"He drove white deer and made them cattle;"},{"id":"semetey-1-2013:p0442:b004:l034","ordinal":110835,"en":"Your lion father, the leopard,"},{"id":"semetey-1-2013:p0442:b004:l035","ordinal":110836,"en":"Threw the lands he fought into confusion."},{"id":"semetey-1-2013:p0442:b004:l036","ordinal":110837,"en":"He drove blue-gray deer and made them cattle;"},{"id":"semetey-1-2013:p0442:b004:l037","ordinal":110838,"en":"Your father threw his chosen lands into confusion."},{"id":"semetey-1-2013:p0442:b004:l038","ordinal":110839,"en":"He summered in great Keng-Kol."},{"id":"semetey-1-2013:p0442:b004:l039","ordinal":110840,"en":"If an enemy came forth to fight,"},{"id":"semetey-1-2013:p0443:b003:l001","ordinal":110841,"en":"He drove them before him."},{"id":"semetey-1-2013:p0443:b003:l002","ordinal":110842,"en":"Whoever provoked his anger,"},{"id":"semetey-1-2013:p0443:b003:l003","ordinal":110843,"en":"He chewed without putting them to his molars."},{"id":"semetey-1-2013:p0443:b003:l004","ordinal":110844,"en":"He drained the ammunition-pouch of its shot;"},{"id":"semetey-1-2013:p0443:b003:l005","ordinal":110845,"en":"Your saintly father, that dear lion,"},{"id":"semetey-1-2013:p0443:b003:l006","ordinal":110846,"en":"Terrified those who faced him."},{"id":"semetey-1-2013:p0443:b003:l007","ordinal":110847,"en":"He moved like a lion."},{"id":"semetey-1-2013:p0443:b003:l008","ordinal":110848,"en":"Unable to withstand your father's wrath,"}]
