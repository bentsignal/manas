[{"id":"manas-2010:p1545:b001:l001","ordinal":66561,"en":"Then your Alma caught up;"},{"id":"manas-2010:p1545:b001:l002","ordinal":66562,"en":"At the edge of the hemp belt,"},{"id":"manas-2010:p1545:b001:l003","ordinal":66563,"en":"He struck as he passed."},{"id":"manas-2010:p1545:b001:l004","ordinal":66564,"en":"As the grim-faced one toppled,"},{"id":"manas-2010:p1545:b001:l005","ordinal":66565,"en":"The forty lords beside him"},{"id":"manas-2010:p1545:b001:l006","ordinal":66566,"en":"Supported him and fled."},{"id":"manas-2010:p1545:b001:l007","ordinal":66567,"en":"With a shout, Ay Jangjung"},{"id":"manas-2010:p1545:b001:l008","ordinal":66568,"en":"Reached Almambet."},{"id":"manas-2010:p1545:b001:l009","ordinal":66569,"en":"“At the edge of the gray belt,” he said,"},{"id":"manas-2010:p1545:b001:l010","ordinal":66570,"en":"“Below the lungs,” he said,"},{"id":"manas-2010:p1545:b001:l011","ordinal":66571,"en":"And struck as he passed."},{"id":"manas-2010:p1545:b001:l012","ordinal":66572,"en":"Not letting your Alma fall from his horse,"},{"id":"manas-2010:p1545:b001:l013","ordinal":66573,"en":"Chubak, Akbaltay's son,"},{"id":"manas-2010:p1545:b001:l014","ordinal":66574,"en":"Supported him from horseback as he passed."},{"id":"manas-2010:p1545:b001:l015","ordinal":66575,"en":"The support of the black-capped people,"},{"id":"manas-2010:p1545:b001:l016","ordinal":66576,"en":"Khan Manas's Syrgak,"},{"id":"manas-2010:p1545:b001:l017","ordinal":66577,"en":"Smashing seven thousand of them,"},{"id":"manas-2010:p1545:b001:l018","ordinal":66578,"en":"Spearing those he met,"},{"id":"manas-2010:p1545:b001:l019","ordinal":66579,"en":"After Ay Jangjung had speared your Alma,"},{"id":"manas-2010:p1545:b001:l020","ordinal":66580,"en":"Before he could recover his position and ride on,"},{"id":"manas-2010:p1545:b001:l021","ordinal":66581,"en":"That hero Ay Jangjung,"},{"id":"manas-2010:p1545:b001:l022","ordinal":66582,"en":"From atop his gray rhinoceros,"},{"id":"manas-2010:p1545:b001:l023","ordinal":66583,"en":"He knocked down as he passed."},{"id":"manas-2010:p1545:b001:l024","ordinal":66584,"en":"Falling from his mount, limbs dangling,"},{"id":"manas-2010:p1545:b001:l025","ordinal":66585,"en":"His two eyes darting,"},{"id":"manas-2010:p1545:b001:l026","ordinal":66586,"en":"As he was losing consciousness,"},{"id":"manas-2010:p1545:b001:l027","ordinal":66587,"en":"Hero Almambet saw him."},{"id":"manas-2010:p1545:b001:l028","ordinal":66588,"en":"Taking his hungry steel in hand,"},{"id":"manas-2010:p1545:b001:l029","ordinal":66589,"en":"Before your Alma could charge up,"},{"id":"manas-2010:p1545:b001:l030","ordinal":66590,"en":"And that mountain-sized Jangjung’s"},{"id":"manas-2010:p1545:b001:l031","ordinal":66591,"en":"Head could be struck off in passing,"},{"id":"manas-2010:p1545:b001:l032","ordinal":66592,"en":"Kongurbay, Alöökö's son,"},{"id":"manas-2010:p1545:b001:l033","ordinal":66593,"en":"Had reached Ay Jangjung."},{"id":"manas-2010:p1545:b001:l034","ordinal":66594,"en":"Reaching him and mounting him,"},{"id":"manas-2010:p1545:b001:l035","ordinal":66595,"en":"Not letting even the wind touch Jangjung,"},{"id":"manas-2010:p1545:b001:l036","ordinal":66596,"en":"He took him away safely."},{"id":"manas-2010:p1545:b001:l037","ordinal":66597,"en":"Drenched in bloody blood,"},{"id":"manas-2010:p1545:b001:l038","ordinal":66598,"en":"Standing and fighting without fleeing,"},{"id":"manas-2010:p1545:b001:l039","ordinal":66599,"en":"Many, many warriors died;"},{"id":"manas-2010:p1545:b001:l040","ordinal":66600,"en":"Those who remained alive,"},{"id":"manas-2010:p1545:b001:l041","ordinal":66601,"en":"Covered in red blood,"},{"id":"manas-2010:p1545:b001:l042","ordinal":66602,"en":"With dust engulfing their chests,"},{"id":"manas-2010:p1546:b001:l001","ordinal":66603,"en":"Mostly parched with thirst, their strength gone,"},{"id":"manas-2010:p1546:b001:l002","ordinal":66604,"en":"Their steeds exhausted and worn out,"},{"id":"manas-2010:p1546:b001:l003","ordinal":66605,"en":"The warriors' eyes grown dim,"},{"id":"manas-2010:p1546:b001:l004","ordinal":66606,"en":"The Chinese people—may their land be deserted!—"},{"id":"manas-2010:p1546:b001:l005","ordinal":66607,"en":"Came surging in with growing force."},{"id":"manas-2010:p1546:b001:l006","ordinal":66608,"en":"If you saw how they grew stronger,"},{"id":"manas-2010:p1546:b001:l007","ordinal":66609,"en":"A dark ridge rising in steep banks,"},{"id":"manas-2010:p1546:b001:l008","ordinal":66610,"en":"What seemed a dark ridge was a flood."},{"id":"manas-2010:p1546:b001:l009","ordinal":66611,"en":"How many more than before,"},{"id":"manas-2010:p1546:b001:l010","ordinal":66612,"en":"The Chinese people swept upon them."},{"id":"manas-2010:p1546:b001:l011","ordinal":66613,"en":"Not even a winged crow could escape;"},{"id":"manas-2010:p1546:b001:l012","ordinal":66614,"en":"It was their hour of wrath."},{"id":"manas-2010:p1546:b001:l013","ordinal":66615,"en":"Falling into inescapable misery,"},{"id":"manas-2010:p1546:b001:l014","ordinal":66616,"en":"It was the Muslims' hour to grieve."},{"id":"manas-2010:p1546:b001:l015","ordinal":66617,"en":"What is seen today is gone tomorrow;"},{"id":"manas-2010:p1546:b001:l016","ordinal":66618,"en":"Such is this wayward world."},{"id":"manas-2010:p1546:b001:l017","ordinal":66619,"en":"Syrgak remained to bar the way;"},{"id":"manas-2010:p1546:b001:l018","ordinal":66620,"en":"Despairing of their dear lives,"},{"id":"manas-2010:p1546:b001:l019","ordinal":66621,"en":"With Khan Almambet at their head,"},{"id":"manas-2010:p1546:b001:l020","ordinal":66622,"en":"The forty companions fled at a gallop."},{"id":"manas-2010:p1546:b001:l021","ordinal":66623,"en":"Not wearying from exchanging shots,"},{"id":"manas-2010:p1546:b001:l022","ordinal":66624,"en":"Not tiring from striking blows,"},{"id":"manas-2010:p1546:b001:l023","ordinal":66625,"en":"Not sleeping upon an elbow,"},{"id":"manas-2010:p1546:b001:l024","ordinal":66626,"en":"Not resting even for a moment,"},{"id":"manas-2010:p1546:b001:l025","ordinal":66627,"en":"Not letting them cross It-Ölbös,"},{"id":"manas-2010:p1546:b001:l026","ordinal":66628,"en":"Not letting them take a step this way,"},{"id":"manas-2010:p1546:b001:l027","ordinal":66629,"en":"Not reckoning, “I shall die,”"},{"id":"manas-2010:p1546:b001:l028","ordinal":66630,"en":"Thoroughly barring the Chinese,"},{"id":"manas-2010:p1546:b001:l029","ordinal":66631,"en":"He stood for about seven days."},{"id":"manas-2010:p1546:b001:l030","ordinal":66632,"en":"When the sun sank slowly,"},{"id":"manas-2010:p1546:b001:l031","ordinal":66633,"en":"Turning back at a dash,"},{"id":"manas-2010:p1546:b001:l032","ordinal":66634,"en":"Galloping unseen,"},{"id":"manas-2010:p1546:b001:l033","ordinal":66635,"en":"Hero Syrgak drew back."},{"id":"manas-2010:p1546:b001:l034","ordinal":66636,"en":"Kökchebich beneath him,"},{"id":"manas-2010:p1546:b001:l035","ordinal":66637,"en":"At the first “Go!” as he set off,"},{"id":"manas-2010:p1546:b001:l036","ordinal":66638,"en":"Shattered the stones he trod;"},{"id":"manas-2010:p1546:b001:l037","ordinal":66639,"en":"Clods as large as great cauldrons"},{"id":"manas-2010:p1546:b001:l038","ordinal":66640,"en":"Whistled above Syrgak's head."},{"id":"manas-2010:p1546:b001:l039","ordinal":66641,"en":"His bit clattered;"},{"id":"manas-2010:p1546:b001:l040","ordinal":66642,"en":"Kökchebich's flesh grew hot;"},{"id":"manas-2010:p1546:b001:l041","ordinal":66643,"en":"His tail like strands of silk"},{"id":"manas-2010:p1546:b001:l042","ordinal":66644,"en":"Lashed between his hind legs,"}]
