[{"id":"semetey-1-2013:p1136:b003:l013","ordinal":163841,"en":"And his thirst for blood seized him."},{"id":"semetey-1-2013:p1136:b003:l014","ordinal":163842,"en":"Flame hissed from his mouth;"},{"id":"semetey-1-2013:p1136:b003:l015","ordinal":163843,"en":"With white teeth like a gate,"},{"id":"semetey-1-2013:p1136:b003:l016","ordinal":163844,"en":"Your tiger, bloodthirsty Manas,"},{"id":"semetey-1-2013:p1136:b003:l017","ordinal":163845,"en":"Gnashed them section by section."},{"id":"semetey-1-2013:p1136:b003:l018","ordinal":163846,"en":"He drew Zulpukor from its sheath;"},{"id":"semetey-1-2013:p1136:b003:l019","ordinal":163847,"en":"Young Aydar's face paled and changed,"},{"id":"semetey-1-2013:p1136:b003:l020","ordinal":163848,"en":"His forelock spread wide,"},{"id":"semetey-1-2013:p1136:b003:l021","ordinal":163849,"en":"And he fell beneath the boy."},{"id":"semetey-1-2013:p1136:b003:l022","ordinal":163850,"en":"As he brought the sword into line,"},{"id":"semetey-1-2013:p1136:b003:l023","ordinal":163851,"en":"As he was about to slaughter"},{"id":"semetey-1-2013:p1136:b003:l024","ordinal":163852,"en":"Young Aydar with the spreading forelock,"},{"id":"semetey-1-2013:p1136:b003:l025","ordinal":163853,"en":"Dear lady Kanykey,"},{"id":"semetey-1-2013:p1136:b003:l026","ordinal":163854,"en":"The beauty of the dark-gray people,"},{"id":"semetey-1-2013:p1136:b003:l027","ordinal":163855,"en":"The glory of the Muslims—"},{"id":"semetey-1-2013:p1136:b003:l028","ordinal":163856,"en":"If you had seen your sister-in-law,"},{"id":"semetey-1-2013:p1136:b003:l029","ordinal":163857,"en":"Your mother of surpassing wisdom!"},{"id":"semetey-1-2013:p1136:b003:l030","ordinal":163858,"en":"Her white throat trembled,"},{"id":"semetey-1-2013:p1136:b003:l031","ordinal":163859,"en":"Her white breast gleamed;"},{"id":"semetey-1-2013:p1136:b003:l032","ordinal":163860,"en":"Forty keys in a row"},{"id":"semetey-1-2013:p1136:b003:l033","ordinal":163861,"en":"Rang in the pouch at her waist,"},{"id":"semetey-1-2013:p1136:b003:l034","ordinal":163862,"en":"And your sister-in-law shone."},{"id":"semetey-1-2013:p1136:b003:l035","ordinal":163863,"en":"Her dawn paled like an argali's,"},{"id":"semetey-1-2013:p1136:b003:l036","ordinal":163864,"en":"Her white breast showed;"},{"id":"semetey-1-2013:p1136:b003:l037","ordinal":163865,"en":"Before the magnanimous lord,"},{"id":"semetey-1-2013:p1136:b003:l038","ordinal":163866,"en":"She spoke softly in sorrow."},{"id":"semetey-1-2013:p1136:b003:l039","ordinal":163867,"en":"Sweet-worded and sharp-eyed,"},{"id":"semetey-1-2013:p1136:b004:l001","ordinal":163868,"en":"Fragrant perfume rising, twisting her brass ornaments,"},{"id":"semetey-1-2013:p1136:b004:l002","ordinal":163869,"en":"She interceded and begged for his blood."},{"id":"semetey-1-2013:p1136:b004:l003","ordinal":163870,"en":"Her dear quail-like eyes"},{"id":"semetey-1-2013:p1136:b004:l004","ordinal":163871,"en":"Shed separate streams of tears;"},{"id":"semetey-1-2013:p1136:b004:l005","ordinal":163872,"en":"Her dear currant-black eyes"},{"id":"semetey-1-2013:p1136:b004:l006","ordinal":163873,"en":"Shed tears a whip-length long."},{"id":"semetey-1-2013:p1136:b004:l007","ordinal":163874,"en":"Moving gracefully in grief,"},{"id":"semetey-1-2013:p1136:b004:l008","ordinal":163875,"en":"Holding him dear,"},{"id":"semetey-1-2013:p1136:b004:l009","ordinal":163876,"en":"She pleaded with her lord:"},{"id":"semetey-1-2013:p1136:b004:l010","ordinal":163877,"en":"\"Can one who is alone strike another alone?"},{"id":"semetey-1-2013:p1136:b004:l011","ordinal":163878,"en":"Can striking a lone man prosper?"},{"id":"semetey-1-2013:p1136:b004:l012","ordinal":163879,"en":"He is no dark, rugged mountain"},{"id":"semetey-1-2013:p1136:b004:l013","ordinal":163880,"en":"That you cannot cross,"},{"id":"semetey-1-2013:p1136:b004:l014","ordinal":163881,"en":"No enemy come from the Kalmyks,"},{"id":"semetey-1-2013:p1136:b004:l015","ordinal":163882,"en":"No costly crag of a mountain,"},{"id":"semetey-1-2013:p1136:b004:l016","ordinal":163883,"en":"No enemy come from China."},{"id":"semetey-1-2013:p1136:b004:l017","ordinal":163884,"en":"What you do is not right;"},{"id":"semetey-1-2013:p1136:b004:l018","ordinal":163885,"en":"Please stand without striking him."},{"id":"semetey-1-2013:p1136:b004:l019","ordinal":163886,"en":"If your sword struck the whole age, would it be sated?"},{"id":"semetey-1-2013:p1136:b004:l020","ordinal":163887,"en":"If you rend him because he is alone,"},{"id":"semetey-1-2013:p1136:b004:l021","ordinal":163888,"en":"Will every hollow in you be filled?"},{"id":"semetey-1-2013:p1136:b004:l022","ordinal":163889,"en":"He too is one father's only son;"},{"id":"semetey-1-2013:p1136:b004:l023","ordinal":163890,"en":"Can you make him a wretched captive?"},{"id":"semetey-1-2013:p1136:b004:l024","ordinal":163891,"en":"Good heavens, can killing a messenger prosper?"},{"id":"semetey-1-2013:p1136:b004:l025","ordinal":163892,"en":"If you rend the lone man,"},{"id":"semetey-1-2013:p1136:b004:l026","ordinal":163893,"en":"Will your sack be filled by this?\""},{"id":"semetey-1-2013:p1136:b004:l027","ordinal":163894,"en":"She poured out many words;"},{"id":"semetey-1-2013:p1136:b004:l028","ordinal":163895,"en":"Kanykey grasped the sword,"},{"id":"semetey-1-2013:p1136:b004:l029","ordinal":163896,"en":"Her tears spilling."},{"id":"semetey-1-2013:p1136:b004:l030","ordinal":163897,"en":"\"Will they not call you witless,"},{"id":"semetey-1-2013:p1136:b004:l031","ordinal":163898,"en":"Saying you killed an intercessor?"},{"id":"semetey-1-2013:p1136:b004:l032","ordinal":163899,"en":"If the saying is true"},{"id":"semetey-1-2013:p1136:b004:l033","ordinal":163900,"en":"That one of seven days is death,"},{"id":"semetey-1-2013:p1136:b004:l034","ordinal":163901,"en":"At dawn on the day of Mahshar,"},{"id":"semetey-1-2013:p1136:b004:l035","ordinal":163902,"en":"Will they not ride you as a black donkey?"},{"id":"semetey-1-2013:p1136:b004:l036","ordinal":163903,"en":"From a gorge with a divided ravine—"},{"id":"semetey-1-2013:p1136:b004:l037","ordinal":163904,"en":"My lord, you were the nest's only one."},{"id":"semetey-1-2013:p1136:b004:l038","ordinal":163905,"en":"Were there no racehorse Akkula,"},{"id":"semetey-1-2013:p1136:b004:l039","ordinal":163906,"en":"There is no steed to bear and carry you;"},{"id":"semetey-1-2013:p1137:b003:l001","ordinal":163907,"en":"Killing an only son is a great shame;"},{"id":"semetey-1-2013:p1137:b003:l002","ordinal":163908,"en":"You have no brother to stand shoulder to shoulder with you."},{"id":"semetey-1-2013:p1137:b003:l003","ordinal":163909,"en":"If you do not take the lone man's life,"},{"id":"semetey-1-2013:p1137:b003:l004","ordinal":163910,"en":"If you do not extinguish his hearth,"},{"id":"semetey-1-2013:p1137:b003:l005","ordinal":163911,"en":"We shall stand watching in sorrow;"},{"id":"semetey-1-2013:p1137:b003:l006","ordinal":163912,"en":"Though I am a woman, I ask this.\""},{"id":"semetey-1-2013:p1137:b003:l007","ordinal":163913,"en":"Kanykey spoke these words,"},{"id":"semetey-1-2013:p1137:b003:l008","ordinal":163914,"en":"Standing as an intercessor."},{"id":"semetey-1-2013:p1137:b003:l009","ordinal":163915,"en":"Then, wearing a blue lynx-fur cap,"},{"id":"semetey-1-2013:p1137:b003:l010","ordinal":163916,"en":"Wielding a blue-mottled shield,"},{"id":"semetey-1-2013:p1137:b003:l011","ordinal":163917,"en":"Foreseeing today"},{"id":"semetey-1-2013:p1137:b003:l012","ordinal":163918,"en":"The torment that would come in six months,"},{"id":"semetey-1-2013:p1137:b003:l013","ordinal":163919,"en":"His words plain when he spoke,"},{"id":"semetey-1-2013:p1137:b003:l014","ordinal":163920,"en":"Saintly Bakay, whose eyes were open,"},{"id":"semetey-1-2013:p1137:b003:l015","ordinal":163921,"en":"Who found words in sudden danger"},{"id":"semetey-1-2013:p1137:b003:l016","ordinal":163922,"en":"And found sight in darkness,"},{"id":"semetey-1-2013:p1137:b003:l017","ordinal":163923,"en":"Good-fortuned when sent ahead,"},{"id":"semetey-1-2013:p1137:b003:l018","ordinal":163924,"en":"Like a countless host when sent behind—"},{"id":"semetey-1-2013:p1137:b003:l019","ordinal":163925,"en":"The elder stepped between them,"},{"id":"semetey-1-2013:p1137:b003:l020","ordinal":163926,"en":"His uncle, saintly Bakay."},{"id":"semetey-1-2013:p1137:b003:l021","ordinal":163927,"en":"Then Bakay said:"},{"id":"semetey-1-2013:p1137:b003:l022","ordinal":163928,"en":"\"Understand my precious words;"},{"id":"semetey-1-2013:p1137:b003:l023","ordinal":163929,"en":"My falcon Manas, heed my tongue."},{"id":"semetey-1-2013:p1137:b003:l024","ordinal":163930,"en":"He is an only son, and so are you;"},{"id":"semetey-1-2013:p1137:b003:l025","ordinal":163931,"en":"Do not take the lone man's life,"},{"id":"semetey-1-2013:p1137:b003:l026","ordinal":163932,"en":"Do not extinguish his hearth!"},{"id":"semetey-1-2013:p1137:b003:l027","ordinal":163933,"en":"Bloodthirsty Manas, my soul's friend,"},{"id":"semetey-1-2013:p1137:b003:l028","ordinal":163934,"en":"If you truly are a khan,"},{"id":"semetey-1-2013:p1137:b003:l029","ordinal":163935,"en":"Heed what I say"},{"id":"semetey-1-2013:p1137:b003:l030","ordinal":163936,"en":"And grant his spoonful of blood!"},{"id":"semetey-1-2013:p1137:b003:l031","ordinal":163937,"en":"If you maul the boy,"},{"id":"semetey-1-2013:p1137:b003:l032","ordinal":163938,"en":"What you do will be shameful."},{"id":"semetey-1-2013:p1137:b003:l033","ordinal":163939,"en":"Until you go to the great feast,"},{"id":"semetey-1-2013:p1137:b003:l034","ordinal":163940,"en":"Until you receive the people's news,"},{"id":"semetey-1-2013:p1137:b003:l035","ordinal":163941,"en":"Remain patient."},{"id":"semetey-1-2013:p1137:b003:l036","ordinal":163942,"en":"If you kill one of your own people,"},{"id":"semetey-1-2013:p1137:b003:l037","ordinal":163943,"en":"What you do will be tyranny."},{"id":"semetey-1-2013:p1137:b003:l038","ordinal":163944,"en":"In reedy broad Keng-Kol and broad Talas,"},{"id":"semetey-1-2013:p1137:b003:l039","ordinal":163945,"en":"You watered the horse Akkula;"},{"id":"semetey-1-2013:p1137:b005:l001","ordinal":163946,"en":"Bokmurun acted foolishly,"},{"id":"semetey-1-2013:p1137:b005:l002","ordinal":163947,"en":"And you vented your anger here."},{"id":"semetey-1-2013:p1137:b005:l003","ordinal":163948,"en":"You have seen the toll of many lands;"},{"id":"semetey-1-2013:p1137:b005:l004","ordinal":163949,"en":"Do not inflict upon the boy"},{"id":"semetey-1-2013:p1137:b005:l005","ordinal":163950,"en":"Bokmurun's torment.\""},{"id":"semetey-1-2013:p1137:b005:l006","ordinal":163951,"en":"Speaking words of many kinds,"},{"id":"semetey-1-2013:p1137:b005:l007","ordinal":163952,"en":"His uncle, elder Bakay,"},{"id":"semetey-1-2013:p1137:b005:l008","ordinal":163953,"en":"Stepped between them."},{"id":"semetey-1-2013:p1137:b005:l009","ordinal":163954,"en":"Dear lady Kanykey"},{"id":"semetey-1-2013:p1137:b005:l010","ordinal":163955,"en":"Pulled the boy out"},{"id":"semetey-1-2013:p1137:b005:l011","ordinal":163956,"en":"From beneath the tiger."},{"id":"semetey-1-2013:p1137:b005:l012","ordinal":163957,"en":"The lions Bakay and Kanykey"},{"id":"semetey-1-2013:p1137:b005:l013","ordinal":163958,"en":"Saved him from death"},{"id":"semetey-1-2013:p1137:b005:l014","ordinal":163959,"en":"And parted them safely."},{"id":"semetey-1-2013:p1137:b005:l015","ordinal":163960,"en":"Tiger Manas roared,"},{"id":"semetey-1-2013:p1137:b005:l016","ordinal":163961,"en":"Thundering in wrath:"},{"id":"semetey-1-2013:p1137:b005:l017","ordinal":163962,"en":"\"The six-edged blade fallen from heaven,"},{"id":"semetey-1-2013:p1137:b005:l018","ordinal":163963,"en":"The finest-tempered sword,"},{"id":"semetey-1-2013:p1137:b005:l019","ordinal":163964,"en":"Zulpukor, which I myself obtained,"},{"id":"semetey-1-2013:p1137:b005:l020","ordinal":163965,"en":"Came to me through the unseen"},{"id":"semetey-1-2013:p1137:b005:l021","ordinal":163966,"en":"In the desert of Mediyan."},{"id":"semetey-1-2013:p1137:b005:l022","ordinal":163967,"en":"When facing the enemy"},{"id":"semetey-1-2013:p1137:b005:l023","ordinal":163968,"en":"And standing in combat,"},{"id":"semetey-1-2013:p1137:b005:l024","ordinal":163969,"en":"It came precisely to me."},{"id":"semetey-1-2013:p1137:b005:l025","ordinal":163970,"en":"When drawn screaming from its sheath,"},{"id":"semetey-1-2013:p1137:b005:l026","ordinal":163971,"en":"It never went without drinking blood;"},{"id":"semetey-1-2013:p1137:b005:l027","ordinal":163972,"en":"If it did not drink its fill of blood,"},{"id":"semetey-1-2013:p1137:b005:l028","ordinal":163973,"en":"It would not return to the sheath."},{"id":"semetey-1-2013:p1137:b005:l029","ordinal":163974,"en":"When Zulpukor came from its sheath,"},{"id":"semetey-1-2013:p1137:b005:l030","ordinal":163975,"en":"It had the custom of drinking blood;"},{"id":"semetey-1-2013:p1137:b005:l031","ordinal":163976,"en":"When swung, it passed through Karkybar."},{"id":"semetey-1-2013:p1137:b005:l032","ordinal":163977,"en":"The honored sword Zulpukor"},{"id":"semetey-1-2013:p1137:b005:l033","ordinal":163978,"en":"Had the worth of a thousand yearling mares."},{"id":"semetey-1-2013:p1137:b005:l034","ordinal":163979,"en":"When drawn roaring from the sheath,"},{"id":"semetey-1-2013:p1137:b005:l035","ordinal":163980,"en":"Does your holy man know?"},{"id":"semetey-1-2013:p1137:b005:l036","ordinal":163981,"en":"Will Zulpukor, drawn from the sheath,"},{"id":"semetey-1-2013:p1137:b005:l037","ordinal":163982,"en":"Go without drinking blood?"},{"id":"semetey-1-2013:p1137:b005:l038","ordinal":163983,"en":"When your lord stood swollen in wrath,"},{"id":"semetey-1-2013:p1137:b005:l039","ordinal":163984,"en":"The lions Almambet and Chubak,"},{"id":"semetey-1-2013:p1138:b003:l001","ordinal":163985,"en":"The forty companions of Khan Manas,"},{"id":"semetey-1-2013:p1138:b003:l002","ordinal":163986,"en":"Biting their lips and narrowing their eyes,"},{"id":"semetey-1-2013:p1138:b003:l003","ordinal":163987,"en":"Spoke a wondrous word."},{"id":"semetey-1-2013:p1138:b003:l004","ordinal":163988,"en":"Hero Syrgak and servant Shuutu"},{"id":"semetey-1-2013:p1138:b003:l005","ordinal":163989,"en":"Flew away like arrows."},{"id":"semetey-1-2013:p1138:b003:l006","ordinal":163990,"en":"Among the Afghan spoil"},{"id":"semetey-1-2013:p1138:b003:l007","ordinal":163991,"en":"Were thirty red elephants."},{"id":"semetey-1-2013:p1138:b003:l008","ordinal":163992,"en":"The two heroes Shuutu and Syrgak"},{"id":"semetey-1-2013:p1138:b003:l009","ordinal":163993,"en":"Went among the elephants."},{"id":"semetey-1-2013:p1138:b003:l010","ordinal":163994,"en":"Before one could say this or that,"},{"id":"semetey-1-2013:p1138:b003:l011","ordinal":163995,"en":"In the blink of an eye,"},{"id":"semetey-1-2013:p1138:b003:l012","ordinal":163996,"en":"Khan Manas's red elephants"},{"id":"semetey-1-2013:p1138:b003:l013","ordinal":163997,"en":"Had been driven there in a group."},{"id":"semetey-1-2013:p1138:b003:l014","ordinal":163998,"en":"His true thirst for blood seized him;"},{"id":"semetey-1-2013:p1138:b003:l015","ordinal":163999,"en":"God struck the bloodthirsty man."},{"id":"semetey-1-2013:p1138:b003:l016","ordinal":164000,"en":"Kanykey and Bakay—"},{"id":"semetey-1-2013:p1138:b003:l017","ordinal":164001,"en":"As though he would slaughter them,"},{"id":"semetey-1-2013:p1138:b003:l018","ordinal":164002,"en":"He stood avidly."},{"id":"semetey-1-2013:p1138:b003:l019","ordinal":164003,"en":"Bakay sheltered by the khan;"},{"id":"semetey-1-2013:p1138:b003:l020","ordinal":164004,"en":"God struck"},{"id":"semetey-1-2013:p1138:b003:l021","ordinal":164005,"en":"Young Aydar with the spreading forelock."},{"id":"semetey-1-2013:p1138:b003:l022","ordinal":164006,"en":"When they went among the elephants,"},{"id":"semetey-1-2013:p1138:b003:l023","ordinal":164007,"en":"Gray-wolf Manas, the tiger,"},{"id":"semetey-1-2013:p1138:b003:l024","ordinal":164008,"en":"Raised Zulpukor in his hand"},{"id":"semetey-1-2013:p1138:b003:l025","ordinal":164009,"en":"And struck;"},{"id":"semetey-1-2013:p1138:b003:l026","ordinal":164010,"en":"The red elephants before him"},{"id":"semetey-1-2013:p1138:b003:l027","ordinal":164011,"en":"Were cut into separate pieces."},{"id":"semetey-1-2013:p1138:b003:l028","ordinal":164012,"en":"Sultan Manas, the tiger,"},{"id":"semetey-1-2013:p1138:b003:l029","ordinal":164013,"en":"Watered Zulpukor with blood"},{"id":"semetey-1-2013:p1138:b003:l030","ordinal":164014,"en":"And returned it to its sheath."},{"id":"semetey-1-2013:p1138:b003:l031","ordinal":164015,"en":"Making the laugher laugh,"},{"id":"semetey-1-2013:p1138:b003:l032","ordinal":164016,"en":"He struck the great war drum,"},{"id":"semetey-1-2013:p1138:b003:l033","ordinal":164017,"en":"Announcing that the enemy was coming;"},{"id":"semetey-1-2013:p1138:b003:l034","ordinal":164018,"en":"They took the war drum in hand,"},{"id":"semetey-1-2013:p1138:b003:l035","ordinal":164019,"en":"Raised the brass mace,"},{"id":"semetey-1-2013:p1138:b003:l036","ordinal":164020,"en":"And its champion struck the center."},{"id":"semetey-1-2013:p1138:b003:l037","ordinal":164021,"en":"Ears deafened at its booming,"},{"id":"semetey-1-2013:p1138:b003:l038","ordinal":164022,"en":"As though the enemy had come."},{"id":"semetey-1-2013:p1138:b003:l039","ordinal":164023,"en":"Khan Manas's forty nobles—"},{"id":"semetey-1-2013:p1138:b004:l001","ordinal":164024,"en":"Each of the forty had a different name,"},{"id":"semetey-1-2013:p1138:b004:l002","ordinal":164025,"en":"Famed men who could shatter the age."},{"id":"semetey-1-2013:p1138:b004:l003","ordinal":164026,"en":"The forty wolves entered together"},{"id":"semetey-1-2013:p1138:b004:l004","ordinal":164027,"en":"The bloodthirsty hero's treasury."},{"id":"semetey-1-2013:p1138:b004:l005","ordinal":164028,"en":"Your formidable sister-in-law Kanykey"},{"id":"semetey-1-2013:p1138:b004:l006","ordinal":164029,"en":"Had prepared"},{"id":"semetey-1-2013:p1138:b004:l007","ordinal":164030,"en":"Mighty arrow-proof coats."},{"id":"semetey-1-2013:p1138:b004:l008","ordinal":164031,"en":"All forty companions wrapped themselves in them;"},{"id":"semetey-1-2013:p1138:b004:l009","ordinal":164032,"en":"Each of the forty coats was different."},{"id":"semetey-1-2013:p1138:b004:l010","ordinal":164033,"en":"Among those coats"},{"id":"semetey-1-2013:p1138:b004:l011","ordinal":164034,"en":"Was the sarinji Almambet would wear;"},{"id":"semetey-1-2013:p1138:b004:l012","ordinal":164035,"en":"It bore a letter on its collar"},{"id":"semetey-1-2013:p1138:b004:l013","ordinal":164036,"en":"And Almambet's name."},{"id":"semetey-1-2013:p1138:b004:l014","ordinal":164037,"en":"Your sister-in-law Kanykey, the stalwart,"},{"id":"semetey-1-2013:p1138:b004:l015","ordinal":164038,"en":"Had made this coat."},{"id":"semetey-1-2013:p1138:b004:l016","ordinal":164039,"en":"Considering her labor,"},{"id":"semetey-1-2013:p1138:b004:l017","ordinal":164040,"en":"Its worth equaled an age."},{"id":"semetey-1-2013:p1138:b004:l018","ordinal":164041,"en":"She had its inside tightly lined"},{"id":"semetey-1-2013:p1138:b004:l019","ordinal":164042,"en":"And its outside covered at the corners."},{"id":"semetey-1-2013:p1138:b004:l020","ordinal":164043,"en":"She had precious iron riveted to its back;"},{"id":"semetey-1-2013:p1138:b004:l021","ordinal":164044,"en":"When spears met, they did not reach flesh,"},{"id":"semetey-1-2013:p1138:b004:l022","ordinal":164045,"en":"And it exhausted whoever grappled with its wearer."},{"id":"semetey-1-2013:p1138:b004:l023","ordinal":164046,"en":"She had that coat fitted perfectly"},{"id":"semetey-1-2013:p1138:b004:l024","ordinal":164047,"en":"And made to the measure of all forty."},{"id":"semetey-1-2013:p1138:b004:l025","ordinal":164048,"en":"If there were an enemy before them,"},{"id":"semetey-1-2013:p1138:b004:l026","ordinal":164049,"en":"If he struck hard,"},{"id":"semetey-1-2013:p1138:b004:l027","ordinal":164050,"en":"Untimely death might come;"},{"id":"semetey-1-2013:p1138:b004:l028","ordinal":164051,"en":"Leaving them unprepared would be futile."},{"id":"semetey-1-2013:p1138:b004:l029","ordinal":164052,"en":"The forty armors she made for your forty"},{"id":"semetey-1-2013:p1138:b004:l030","ordinal":164053,"en":"Revealed their costliness."},{"id":"semetey-1-2013:p1138:b004:l031","ordinal":164054,"en":"She brought forty armors from the treasury"},{"id":"semetey-1-2013:p1138:b004:l032","ordinal":164055,"en":"And dressed the forty companions,"},{"id":"semetey-1-2013:p1138:b004:l033","ordinal":164056,"en":"Your formidable sister-in-law Kanykey"},{"id":"semetey-1-2013:p1138:b004:l034","ordinal":164057,"en":"Making their costliness known."},{"id":"semetey-1-2013:p1138:b004:l035","ordinal":164058,"en":"She had nine clasps apiece"},{"id":"semetey-1-2013:p1138:b004:l036","ordinal":164059,"en":"Fastened across the chest;"},{"id":"semetey-1-2013:p1138:b004:l037","ordinal":164060,"en":"Your mighty sister-in-law Kanykey"},{"id":"semetey-1-2013:p1138:b004:l038","ordinal":164061,"en":"Then dressed the forty companions"},{"id":"semetey-1-2013:p1138:b004:l039","ordinal":164062,"en":"In armor no arrow could pierce."},{"id":"semetey-1-2013:p1139:b003:l001","ordinal":164063,"en":"Helmets of blue iron—"},{"id":"semetey-1-2013:p1139:b003:l002","ordinal":164064,"en":"So the heroic youths would not stand idle"},{"id":"semetey-1-2013:p1139:b003:l003","ordinal":164065,"en":"If an enemy came from a known place,"},{"id":"semetey-1-2013:p1139:b003:l004","ordinal":164066,"en":"But would go to face him;"},{"id":"semetey-1-2013:p1139:b003:l005","ordinal":164067,"en":"If they stood brow to brow,"},{"id":"semetey-1-2013:p1139:b003:l006","ordinal":164068,"en":"Struck with battle-axes,"},{"id":"semetey-1-2013:p1139:b003:l007","ordinal":164069,"en":"And fought with cries,"},{"id":"semetey-1-2013:p1139:b003:l008","ordinal":164070,"en":"A battle-axe might strike them"},{"id":"semetey-1-2013:p1139:b003:l009","ordinal":164071,"en":"And death come needlessly."},{"id":"semetey-1-2013:p1139:b003:l010","ordinal":164072,"en":"The forty helmets she made for the forty"},{"id":"semetey-1-2013:p1139:b003:l011","ordinal":164073,"en":"Made their strength known;"},{"id":"semetey-1-2013:p1139:b003:l012","ordinal":164074,"en":"She overturned them onto their heads."},{"id":"semetey-1-2013:p1139:b003:l013","ordinal":164075,"en":"The kandagay she made for the forty"},{"id":"semetey-1-2013:p1139:b003:l014","ordinal":164076,"en":"Was of Ashagan-Mashagan hide,"},{"id":"semetey-1-2013:p1139:b003:l015","ordinal":164077,"en":"Fashioned by your cunning sister-in-law."},{"id":"semetey-1-2013:p1139:b003:l016","ordinal":164078,"en":"She had it steeped in dressing,"},{"id":"semetey-1-2013:p1139:b003:l017","ordinal":164079,"en":"And saturated with measured dye,"},{"id":"semetey-1-2013:p1139:b003:l018","ordinal":164080,"en":"Immersed in many preparations,"},{"id":"semetey-1-2013:p1139:b003:l019","ordinal":164081,"en":"And laid in the shade."},{"id":"semetey-1-2013:p1139:b003:l020","ordinal":164082,"en":"She gave a horse for each month,"},{"id":"semetey-1-2013:p1139:b003:l021","ordinal":164083,"en":"And gold and jewels by the measure each day."},{"id":"semetey-1-2013:p1139:b003:l022","ordinal":164084,"en":"From men who came without peer,"},{"id":"semetey-1-2013:p1139:b003:l023","ordinal":164085,"en":"Marksmen of evident perfect skill"},{"id":"semetey-1-2013:p1139:b003:l024","ordinal":164086,"en":"Who could shoot an eye,"},{"id":"semetey-1-2013:p1139:b003:l025","ordinal":164087,"en":"She had provisions loaded upon bil"},{"id":"semetey-1-2013:p1139:b003:l026","ordinal":164088,"en":"And sent them to survey the earth."},{"id":"semetey-1-2013:p1139:b003:l027","ordinal":164089,"en":"Hearing from many people"},{"id":"semetey-1-2013:p1139:b003:l028","ordinal":164090,"en":"That the hide of the ibex of Too-Kuygak"},{"id":"semetey-1-2013:p1139:b003:l029","ordinal":164091,"en":"Was thick,"},{"id":"semetey-1-2013:p1139:b003:l030","ordinal":164092,"en":"She placed the sewing of the kandagay"},{"id":"semetey-1-2013:p1139:b003:l031","ordinal":164093,"en":"Under Aruuke's direction;"},{"id":"semetey-1-2013:p1139:b003:l032","ordinal":164094,"en":"Exactly ninety-five champions"},{"id":"semetey-1-2013:p1139:b003:l033","ordinal":164095,"en":"Worked the hide for ninety days."},{"id":"semetey-1-2013:p1139:b003:l034","ordinal":164096,"en":"She had its inside lined with silk"}]
