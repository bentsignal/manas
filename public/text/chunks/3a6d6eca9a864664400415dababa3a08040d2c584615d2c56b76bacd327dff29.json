[{"id":"semetey-1-2013:p0949:b003:l036","ordinal":149505,"en":"His cowardice showed."},{"id":"semetey-1-2013:p0949:b003:l037","ordinal":149506,"en":"An oaf who understood no reason,"},{"id":"semetey-1-2013:p0949:b003:l038","ordinal":149507,"en":"His ineptness showed."},{"id":"semetey-1-2013:p0949:b003:l039","ordinal":149508,"en":"They were no people simply to trust,"},{"id":"semetey-1-2013:p0949:b004:l001","ordinal":149509,"en":"He was no hero to marry."},{"id":"semetey-1-2013:p0949:b004:l002","ordinal":149510,"en":"Toltoi of the Jediger"},{"id":"semetey-1-2013:p0949:b004:l003","ordinal":149511,"en":"Was no less brave than this one."},{"id":"semetey-1-2013:p0949:b004:l004","ordinal":149512,"en":"Kokcho's son Umotoi"},{"id":"semetey-1-2013:p0949:b004:l005","ordinal":149513,"en":"Was no hero a mortal could trust."},{"id":"semetey-1-2013:p0949:b004:l006","ordinal":149514,"en":"Aichurok flew across,"},{"id":"semetey-1-2013:p0949:b004:l007","ordinal":149515,"en":"Seeking a hero without stopping or resting,"},{"id":"semetey-1-2013:p0949:b004:l008","ordinal":149516,"en":"Passed through Talaa-Chelek,"},{"id":"semetey-1-2013:p0949:b004:l009","ordinal":149517,"en":"Crossed Too-Chelek,"},{"id":"semetey-1-2013:p0949:b004:l010","ordinal":149518,"en":"Wandered about Issyk-Kol,"},{"id":"semetey-1-2013:p0949:b004:l011","ordinal":149519,"en":"Went to Kyzyl-Kyya."},{"id":"semetey-1-2013:p0949:b004:l012","ordinal":149520,"en":"Dwelling in Kyzyl-Kyya,"},{"id":"semetey-1-2013:p0949:b004:l013","ordinal":149521,"en":"Myradyl, son of Kyrym,"},{"id":"semetey-1-2013:p0949:b004:l014","ordinal":149522,"en":"Said to be a strong-backed hero—"},{"id":"semetey-1-2013:p0949:b004:l015","ordinal":149523,"en":"She saw Myradyl."},{"id":"semetey-1-2013:p0949:b004:l016","ordinal":149524,"en":"He himself was a weather-magician,"},{"id":"semetey-1-2013:p0949:b004:l017","ordinal":149525,"en":"Who did not squat to urinate,"},{"id":"semetey-1-2013:p0949:b004:l018","ordinal":149526,"en":"Whose garment's hem did not touch the ground,"},{"id":"semetey-1-2013:p0949:b004:l019","ordinal":149527,"en":"Who did not know the sole Creator"},{"id":"semetey-1-2013:p0949:b004:l020","ordinal":149528,"en":"To be the One."},{"id":"semetey-1-2013:p0949:b004:l021","ordinal":149529,"en":"As a guard upon the people's frontier,"},{"id":"semetey-1-2013:p0949:b004:l022","ordinal":149530,"en":"He had bravery."},{"id":"semetey-1-2013:p0949:b004:l023","ordinal":149531,"en":"His garment's hem did not touch the ground,"},{"id":"semetey-1-2013:p0949:b004:l024","ordinal":149532,"en":"They knew neither existence nor oneness—"},{"id":"semetey-1-2013:p0949:b004:l025","ordinal":149533,"en":"He had his unbelief."},{"id":"semetey-1-2013:p0949:b004:l026","ordinal":149534,"en":"Six Soloons and four Manchus"},{"id":"semetey-1-2013:p0949:b004:l027","ordinal":149535,"en":"Had taken him as their companion."},{"id":"semetey-1-2013:p0949:b004:l028","ordinal":149536,"en":"At the familiar Sandal-Bulak,"},{"id":"semetey-1-2013:p0949:b004:l029","ordinal":149537,"en":"He had placed upon his flanks."},{"id":"semetey-1-2013:p0949:b004:l030","ordinal":149538,"en":"He had gone out hunting."},{"id":"semetey-1-2013:p0949:b004:l031","ordinal":149539,"en":"Six swine and four boars,"},{"id":"semetey-1-2013:p0949:b004:l032","ordinal":149540,"en":"Myradyl had shot,"},{"id":"semetey-1-2013:p0949:b004:l033","ordinal":149541,"en":"And was strutting about."},{"id":"semetey-1-2013:p0949:b004:l034","ordinal":149542,"en":"In red rawhide shoes and blue robes,"},{"id":"semetey-1-2013:p0949:b004:l035","ordinal":149543,"en":"With what face could I wear it?"},{"id":"semetey-1-2013:p0949:b004:l036","ordinal":149544,"en":"To a red-naveled Chinese,"},{"id":"semetey-1-2013:p0949:b004:l037","ordinal":149545,"en":"A faithless, utterly faithless man,"},{"id":"semetey-1-2013:p0949:b004:l038","ordinal":149546,"en":"The uncircumcised who know no faith,"},{"id":"semetey-1-2013:p0949:b004:l039","ordinal":149547,"en":"With what face could I marry?"},{"id":"semetey-1-2013:p0950:b003:l001","ordinal":149548,"en":"Passing farther onward,"},{"id":"semetey-1-2013:p0950:b003:l002","ordinal":149549,"en":"To Beijing of Kakan-Chyn,"},{"id":"semetey-1-2013:p0950:b003:l003","ordinal":149550,"en":"To the infidels swarming like black spiders,"},{"id":"semetey-1-2013:p0950:b003:l004","ordinal":149551,"en":"To the warrior Khan Kongurbai,"},{"id":"semetey-1-2013:p0950:b003:l005","ordinal":149552,"en":"Whose name was heard throughout the world—"},{"id":"semetey-1-2013:p0950:b003:l006","ordinal":149553,"en":"Going there to wage a campaign,"},{"id":"semetey-1-2013:p0950:b003:l007","ordinal":149554,"en":"Many giants of the Muslims had perished."},{"id":"semetey-1-2013:p0950:b003:l008","ordinal":149555,"en":"Dust issued from his heart,"},{"id":"semetey-1-2013:p0950:b003:l009","ordinal":149556,"en":"The news of him drove out souls."},{"id":"semetey-1-2013:p0950:b003:l010","ordinal":149557,"en":"A mighty khan had arisen in Beijing."},{"id":"semetey-1-2013:p0950:b003:l011","ordinal":149558,"en":"With a cotton sash and broad boots,"},{"id":"semetey-1-2013:p0950:b003:l012","ordinal":149559,"en":"Kongurbai, khan of the monks,"},{"id":"semetey-1-2013:p0950:b003:l013","ordinal":149560,"en":"That stately swine—"},{"id":"semetey-1-2013:p0950:b003:l014","ordinal":149561,"en":"From white-bearded elders"},{"id":"semetey-1-2013:p0950:b003:l015","ordinal":149562,"en":"She was asking about him then."},{"id":"semetey-1-2013:p0950:b003:l016","ordinal":149563,"en":"From all the people,"},{"id":"semetey-1-2013:p0950:b003:l017","ordinal":149564,"en":"'Let me put Kongurbai to the test,"},{"id":"semetey-1-2013:p0950:b003:l018","ordinal":149565,"en":"That swine, khan of the monks,"},{"id":"semetey-1-2013:p0950:b003:l019","ordinal":149566,"en":"Let me see his appearance.'"},{"id":"semetey-1-2013:p0950:b003:l020","ordinal":149567,"en":"Saying this, Aichurok"},{"id":"semetey-1-2013:p0950:b003:l021","ordinal":149568,"en":"To the marsh of Kurpuldok"},{"id":"semetey-1-2013:p0950:b003:l022","ordinal":149569,"en":"Drew near and entered."},{"id":"semetey-1-2013:p0950:b003:l023","ordinal":149570,"en":"If you would see Kongurbai, see him now!"},{"id":"semetey-1-2013:p0950:b003:l024","ordinal":149571,"en":"Countless great livestock gathered as tribute,"},{"id":"semetey-1-2013:p0950:b003:l025","ordinal":149572,"en":"The myriad animals of Beijing,"},{"id":"semetey-1-2013:p0950:b003:l026","ordinal":149573,"en":"Kongurbai's countless horses"},{"id":"semetey-1-2013:p0950:b003:l027","ordinal":149574,"en":"Were there in teeming herds,"},{"id":"semetey-1-2013:p0950:b003:l028","ordinal":149575,"en":"Swarming like ants."},{"id":"semetey-1-2013:p0950:b003:l029","ordinal":149576,"en":"The eye could not encompass them."},{"id":"semetey-1-2013:p0950:b003:l030","ordinal":149577,"en":"That infidel's horses,"},{"id":"semetey-1-2013:p0950:b003:l031","ordinal":149578,"en":"Its touch is scarcely felt,"},{"id":"semetey-1-2013:p0950:b003:l032","ordinal":149579,"en":"Kongurbai's countless horses"},{"id":"semetey-1-2013:p0950:b003:l033","ordinal":149580,"en":"Were animals of many kinds,"},{"id":"semetey-1-2013:p0950:b003:l034","ordinal":149581,"en":"Animals gathered in great masses."},{"id":"semetey-1-2013:p0950:b003:l035","ordinal":149582,"en":"Yellow-mottled like starlings,"},{"id":"semetey-1-2013:p0950:b003:l036","ordinal":149583,"en":"One variety of the horses;"},{"id":"semetey-1-2013:p0950:b003:l037","ordinal":149584,"en":"Among the horses with matted tails,"},{"id":"semetey-1-2013:p0950:b003:l038","ordinal":149585,"en":"Gray horses with bracelet markings,"},{"id":"semetey-1-2013:p0950:b003:l039","ordinal":149586,"en":"Strong, unridden horses."},{"id":"semetey-1-2013:p0950:b004:l001","ordinal":149587,"en":"His black-maned dun horses—"},{"id":"semetey-1-2013:p0950:b004:l002","ordinal":149588,"en":"That blustering Kalcha,"},{"id":"semetey-1-2013:p0950:b004:l003","ordinal":149589,"en":"Which of his deeds shall we tell?"},{"id":"semetey-1-2013:p0950:b004:l004","ordinal":149590,"en":"Strong, unridden horses."},{"id":"semetey-1-2013:p0950:b004:l005","ordinal":149591,"en":"His hood-marked bays,"},{"id":"semetey-1-2013:p0950:b004:l006","ordinal":149592,"en":"His chestnuts like ezhigei curds,"},{"id":"semetey-1-2013:p0950:b004:l007","ordinal":149593,"en":"His blacks without a speck of white."},{"id":"semetey-1-2013:p0950:b004:l008","ordinal":149594,"en":"Known across the face of the earth"},{"id":"semetey-1-2013:p0950:b004:l009","ordinal":149595,"en":"Was Kongurbai's renown."},{"id":"semetey-1-2013:p0950:b004:l010","ordinal":149596,"en":"Delighted at the sight of his horses,"},{"id":"semetey-1-2013:p0950:b004:l011","ordinal":149597,"en":"Aichurok stood rejoicing."},{"id":"semetey-1-2013:p0950:b004:l012","ordinal":149598,"en":"His foals and yearlings broke away,"},{"id":"semetey-1-2013:p0950:b004:l013","ordinal":149599,"en":"Neighing across the flat ground,"},{"id":"semetey-1-2013:p0950:b004:l014","ordinal":149600,"en":"Racing like wild asses."},{"id":"semetey-1-2013:p0950:b004:l015","ordinal":149601,"en":"The northern side of the horse herd"},{"id":"semetey-1-2013:p0950:b004:l016","ordinal":149602,"en":"Was on the slopes of Kyr-Kaiyng;"},{"id":"semetey-1-2013:p0950:b004:l017","ordinal":149603,"en":"The lower side of the horse herd"},{"id":"semetey-1-2013:p0950:b004:l018","ordinal":149604,"en":"Was at the edge of Kurpuldok."},{"id":"semetey-1-2013:p0950:b004:l019","ordinal":149605,"en":"Those wretched Chinese,"},{"id":"semetey-1-2013:p0950:b004:l020","ordinal":149606,"en":"Their horses had become countless;"},{"id":"semetey-1-2013:p0950:b004:l021","ordinal":149607,"en":"They had grown immensely rich."},{"id":"semetey-1-2013:p0950:b004:l022","ordinal":149608,"en":"The reason he had grown rich:"},{"id":"semetey-1-2013:p0950:b004:l023","ordinal":149609,"en":"He was the powerful khan of the monks."},{"id":"semetey-1-2013:p0950:b004:l024","ordinal":149610,"en":"His monks had different customs;"},{"id":"semetey-1-2013:p0950:b004:l025","ordinal":149611,"en":"His ox grew old and he himself died;"},{"id":"semetey-1-2013:p0950:b004:l026","ordinal":149612,"en":"When someone died, their custom"},{"id":"semetey-1-2013:p0950:b004:l027","ordinal":149613,"en":"Was to divide the dead man's livestock equally."},{"id":"semetey-1-2013:p0950:b004:l028","ordinal":149614,"en":"He set his he-goat apart as sacred,"},{"id":"semetey-1-2013:p0950:b004:l029","ordinal":149615,"en":"The horse he rode was sacred,"},{"id":"semetey-1-2013:p0950:b004:l030","ordinal":149616,"en":"And he kept apart from women."},{"id":"semetey-1-2013:p0950:b004:l031","ordinal":149617,"en":"He saddled his unbroken horse."},{"id":"semetey-1-2013:p0950:b004:l032","ordinal":149618,"en":"A great idol the size of a house,"},{"id":"semetey-1-2013:p0950:b004:l033","ordinal":149619,"en":"Calling it 'God,'"},{"id":"semetey-1-2013:p0950:b004:l034","ordinal":149620,"en":"He bowed and worshiped."},{"id":"semetey-1-2013:p0950:b004:l035","ordinal":149621,"en":"With a cotton sash and broad boots,"},{"id":"semetey-1-2013:p0950:b004:l036","ordinal":149622,"en":"Kongurbai, khan of the monks,"},{"id":"semetey-1-2013:p0950:b004:l037","ordinal":149623,"en":"Emerged from the ford, massive,"},{"id":"semetey-1-2013:p0950:b004:l038","ordinal":149624,"en":"Making the swift Algara lunge,"},{"id":"semetey-1-2013:p0950:b004:l039","ordinal":149625,"en":"Tugging at his golden lead rope,"},{"id":"semetey-1-2013:p0951:b003:l001","ordinal":149626,"en":"He was a handsome man,"},{"id":"semetey-1-2013:p0951:b003:l002","ordinal":149627,"en":"A powerful khan of the monks."},{"id":"semetey-1-2013:p0951:b003:l003","ordinal":149628,"en":"Great boots stood proudly on his feet,"},{"id":"semetey-1-2013:p0951:b003:l004","ordinal":149629,"en":"His neck held high like a rooster's,"},{"id":"semetey-1-2013:p0951:b003:l005","ordinal":149630,"en":"His spectacles gleamed."},{"id":"semetey-1-2013:p0951:b003:l006","ordinal":149631,"en":"A coral stone as large as a flask"},{"id":"semetey-1-2013:p0951:b003:l007","ordinal":149632,"en":"Shone upon his head."},{"id":"semetey-1-2013:p0951:b003:l008","ordinal":149633,"en":"The sight troubled the heart."},{"id":"semetey-1-2013:p0951:b003:l009","ordinal":149634,"en":"Gray-mottled of beard, the huge Manchu"},{"id":"semetey-1-2013:p0951:b003:l010","ordinal":149635,"en":"Appeared like Opol-Too."},{"id":"semetey-1-2013:p0951:b003:l011","ordinal":149636,"en":"His graying mustache"},{"id":"semetey-1-2013:p0951:b003:l012","ordinal":149637,"en":"Was like a greasy axe handle;"},{"id":"semetey-1-2013:p0951:b003:l013","ordinal":149638,"en":"The size of his nose"},{"id":"semetey-1-2013:p0951:b003:l014","ordinal":149639,"en":"Was like a saber sheath."},{"id":"semetey-1-2013:p0951:b003:l015","ordinal":149640,"en":"The corners of his two eyes"},{"id":"semetey-1-2013:p0951:b003:l016","ordinal":149641,"en":"Were like open graves."},{"id":"semetey-1-2013:p0951:b003:l017","ordinal":149642,"en":"If one looked at his moon-like brow,"},{"id":"semetey-1-2013:p0951:b003:l018","ordinal":149643,"en":"It was like an upland where a rich man summered."},{"id":"semetey-1-2013:p0951:b003:l019","ordinal":149644,"en":"His bravery was extraordinary,"},{"id":"semetey-1-2013:p0951:b003:l020","ordinal":149645,"en":"His strength was immense."},{"id":"semetey-1-2013:p0951:b003:l021","ordinal":149646,"en":"A painted pipe with a golden stem,"},{"id":"semetey-1-2013:p0951:b003:l022","ordinal":149647,"en":"The great Kalcha as big as a hut,"},{"id":"semetey-1-2013:p0951:b003:l023","ordinal":149648,"en":"Sixty Chinese and forty kaldais—"},{"id":"semetey-1-2013:p0951:b003:l024","ordinal":149649,"en":"To inspect those horses,"},{"id":"semetey-1-2013:p0951:b003:l025","ordinal":149650,"en":"The exceedingly mighty Kongurbai,"},{"id":"semetey-1-2013:p0951:b003:l026","ordinal":149651,"en":"His pipe with its golden stem"},{"id":"semetey-1-2013:p0951:b003:l027","ordinal":149652,"en":"He displayed with ceremony."},{"id":"semetey-1-2013:p0951:b003:l028","ordinal":149653,"en":"Tobacco from a dungurchok box,"},{"id":"semetey-1-2013:p0951:b003:l029","ordinal":149654,"en":"Taking it in handfuls, Kongurbai"},{"id":"semetey-1-2013:p0951:b003:l030","ordinal":149655,"en":"Put it in four times."},{"id":"semetey-1-2013:p0951:b003:l031","ordinal":149656,"en":"Know from this that he was a giant."},{"id":"semetey-1-2013:p0951:b003:l032","ordinal":149657,"en":"That painted pipe—"},{"id":"semetey-1-2013:p0951:b003:l033","ordinal":149658,"en":"With Chinese flint and firesteel,"},{"id":"semetey-1-2013:p0951:b003:l034","ordinal":149659,"en":"Kongurbai struck sparks."},{"id":"semetey-1-2013:p0951:b003:l035","ordinal":149660,"en":"And blood-red embers mixed with gore"},{"id":"semetey-1-2013:p0951:b003:l036","ordinal":149661,"en":"Putting fire in his pipe,"},{"id":"semetey-1-2013:p0951:b003:l037","ordinal":149662,"en":"Your wretch, his craving roused,"},{"id":"semetey-1-2013:p0951:b003:l038","ordinal":149663,"en":"Drew upon it with a gurgling sound."},{"id":"semetey-1-2013:p0951:b003:l039","ordinal":149664,"en":"When he opened his cavernous mouth,"},{"id":"semetey-1-2013:p0951:b004:l001","ordinal":149665,"en":"The smoke in his cheeks,"},{"id":"semetey-1-2013:p0951:b004:l002","ordinal":149666,"en":"When he expelled every bit of it,"},{"id":"semetey-1-2013:p0951:b004:l003","ordinal":149667,"en":"Letting it out with a rumble,"},{"id":"semetey-1-2013:p0951:b004:l004","ordinal":149668,"en":"Billowing like smoke from an earth-pit smokehouse,"},{"id":"semetey-1-2013:p0951:b004:l005","ordinal":149669,"en":"A low fog descended, rolling."},{"id":"semetey-1-2013:p0951:b004:l006","ordinal":149670,"en":"Sixty Chinese and forty kaldais"},{"id":"semetey-1-2013:p0951:b004:l007","ordinal":149671,"en":"Lost their way, crying out,"},{"id":"semetey-1-2013:p0951:b004:l008","ordinal":149672,"en":"Unable to find one another."},{"id":"semetey-1-2013:p0951:b004:l009","ordinal":149673,"en":"Confused and lost,"},{"id":"semetey-1-2013:p0951:b004:l010","ordinal":149674,"en":"While the kaldais stood thus,"},{"id":"semetey-1-2013:p0951:b004:l011","ordinal":149675,"en":"Bending his knees toward the ground,"},{"id":"semetey-1-2013:p0951:b004:l012","ordinal":149676,"en":"That one whose wish should never be granted,"},{"id":"semetey-1-2013:p0951:b004:l013","ordinal":149677,"en":"From Algara's back"},{"id":"semetey-1-2013:p0951:b004:l014","ordinal":149678,"en":"Sprang down in haste."},{"id":"semetey-1-2013:p0951:b004:l015","ordinal":149679,"en":"His life had reached"},{"id":"semetey-1-2013:p0951:b004:l016","ordinal":149680,"en":"A full ninety-five years."},{"id":"semetey-1-2013:p0951:b004:l017","ordinal":149681,"en":"The Chinese stretched out and thrust;"},{"id":"semetey-1-2013:p0951:b004:l018","ordinal":149682,"en":"That was the state he had reached."},{"id":"semetey-1-2013:p0951:b004:l019","ordinal":149683,"en":"Facing west,"},{"id":"semetey-1-2013:p0951:b004:l020","ordinal":149684,"en":"He lifted onto his shoulder."},{"id":"semetey-1-2013:p0951:b004:l021","ordinal":149685,"en":"He did not squat upon the ground to urinate,"},{"id":"semetey-1-2013:p0951:b004:l022","ordinal":149686,"en":"His garment's hem did not touch the earth."},{"id":"semetey-1-2013:p0951:b004:l023","ordinal":149687,"en":"When he had finished urinating,"},{"id":"semetey-1-2013:p0951:b004:l024","ordinal":149688,"en":"He turned and mounted again,"},{"id":"semetey-1-2013:p0951:b004:l025","ordinal":149689,"en":"Hastily mounted at once,"},{"id":"semetey-1-2013:p0951:b004:l026","ordinal":149690,"en":"Headed toward the horses,"},{"id":"semetey-1-2013:p0951:b004:l027","ordinal":149691,"en":"And that wretch rode away."},{"id":"semetey-1-2013:p0951:b004:l028","ordinal":149692,"en":"To examine his gigantic stature,"},{"id":"semetey-1-2013:p0951:b004:l029","ordinal":149693,"en":"She reached the place where he had dismounted."},{"id":"semetey-1-2013:p0951:b004:l030","ordinal":149694,"en":"The measure of his footprints,"},{"id":"semetey-1-2013:p0951:b004:l031","ordinal":149695,"en":"Formidable Churok now took."},{"id":"semetey-1-2013:p0951:b004:l032","ordinal":149696,"en":"His footprint in the sand,"},{"id":"semetey-1-2013:p0951:b004:l033","ordinal":149697,"en":"When Aichurok measured it,"},{"id":"semetey-1-2013:p0951:b004:l034","ordinal":149698,"en":"It was twelve soum sere."},{"id":"semetey-1-2013:p0951:b004:l035","ordinal":149699,"en":"'My saintly father-in-law—"},{"id":"semetey-1-2013:p0951:b004:l036","ordinal":149700,"en":"No wonder this man could kill him."},{"id":"semetey-1-2013:p0951:b004:l037","ordinal":149701,"en":"For the great Chinese and Manchu host,"},{"id":"semetey-1-2013:p0951:b004:l038","ordinal":149702,"en":"No wonder he became a fortress."},{"id":"semetey-1-2013:p0951:b004:l039","ordinal":149703,"en":"Now approaching ninety-five,"},{"id":"semetey-1-2013:p0952:b003:l001","ordinal":149704,"en":"That was the age he had reached."},{"id":"semetey-1-2013:p0952:b003:l002","ordinal":149705,"en":"His prowess gone, stooping,"},{"id":"semetey-1-2013:p0952:b003:l003","ordinal":149706,"en":"He had grown old."},{"id":"semetey-1-2013:p0952:b003:l004","ordinal":149707,"en":"Between twenty-five and thirty-five,"},{"id":"semetey-1-2013:p0952:b003:l005","ordinal":149708,"en":"Had I met him then,"},{"id":"semetey-1-2013:p0952:b003:l006","ordinal":149709,"en":"He would have been a man to marry."},{"id":"semetey-1-2013:p0952:b003:l007","ordinal":149710,"en":"His sharpness gone, the poor man"},{"id":"semetey-1-2013:p0952:b003:l008","ordinal":149711,"en":"Was no longer what he had been."},{"id":"semetey-1-2013:p0952:b003:l009","ordinal":149712,"en":"Much had ebbed from the Manchu;"},{"id":"semetey-1-2013:p0952:b003:l010","ordinal":149713,"en":"His beard was now gray-mottled."},{"id":"semetey-1-2013:p0952:b003:l011","ordinal":149714,"en":"High-browed, fierce of temper,"},{"id":"semetey-1-2013:p0952:b003:l012","ordinal":149715,"en":"In his youth this Kalcha"},{"id":"semetey-1-2013:p0952:b003:l013","ordinal":149716,"en":"Had possessed great valor."},{"id":"semetey-1-2013:p0952:b003:l014","ordinal":149717,"en":"High-browed, fierce of temper,"},{"id":"semetey-1-2013:p0952:b003:l015","ordinal":149718,"en":"He leveled anyone who challenged him."},{"id":"semetey-1-2013:p0952:b003:l016","ordinal":149719,"en":"Thick-armed, stone-hearted,"},{"id":"semetey-1-2013:p0952:b003:l017","ordinal":149720,"en":"An elephant-built brute."},{"id":"semetey-1-2013:p0952:b003:l018","ordinal":149721,"en":"Imposing in appearance, fierce of temper,"},{"id":"semetey-1-2013:p0952:b003:l019","ordinal":149722,"en":"Those who saw him were amazed."},{"id":"semetey-1-2013:p0952:b003:l020","ordinal":149723,"en":"In his youth, Kongurbai,"},{"id":"semetey-1-2013:p0952:b003:l021","ordinal":149724,"en":"Such was the sight of his power."},{"id":"semetey-1-2013:p0952:b003:l022","ordinal":149725,"en":"His eyes like hollows in a lake,"},{"id":"semetey-1-2013:p0952:b003:l023","ordinal":149726,"en":"Seeming to swallow whatever he saw,"},{"id":"semetey-1-2013:p0952:b003:l024","ordinal":149727,"en":"His brow like the bed of a ravine,"},{"id":"semetey-1-2013:p0952:b003:l025","ordinal":149728,"en":"Seeming to suck in anyone who charged him."},{"id":"semetey-1-2013:p0952:b003:l026","ordinal":149729,"en":"As he rode along,"},{"id":"semetey-1-2013:p0952:b003:l027","ordinal":149730,"en":"The lower ends of his stirrup leathers flapped,"},{"id":"semetey-1-2013:p0952:b003:l028","ordinal":149731,"en":"His forelock turned behind him"},{"id":"semetey-1-2013:p0952:b003:l029","ordinal":149732,"en":"Swung on his back like a mallet."},{"id":"semetey-1-2013:p0952:b003:l030","ordinal":149733,"en":"He was a man of tremendous vigor."},{"id":"semetey-1-2013:p0952:b003:l031","ordinal":149734,"en":"However much an infidel,"},{"id":"semetey-1-2013:p0952:b003:l032","ordinal":149735,"en":"He had a protector."},{"id":"semetey-1-2013:p0952:b003:l033","ordinal":149736,"en":"His right shoulder was broad,"},{"id":"semetey-1-2013:p0952:b003:l034","ordinal":149737,"en":"He was a lion equal to the world."},{"id":"semetey-1-2013:p0952:b003:l035","ordinal":149738,"en":"All his twelve bodily parts were sound."},{"id":"semetey-1-2013:p0952:b003:l036","ordinal":149739,"en":"My father-in-law, gone to the other world—"},{"id":"semetey-1-2013:p0952:b003:l037","ordinal":149740,"en":"No wonder this man cut him down."},{"id":"semetey-1-2013:p0952:b003:l038","ordinal":149741,"en":"The Chinese red dress,"},{"id":"semetey-1-2013:p0952:b003:l039","ordinal":149742,"en":"He would be a man for whom to wear it,"},{"id":"semetey-1-2013:p0952:b004:l001","ordinal":149743,"en":"To sport joyfully with the Kalcha,"},{"id":"semetey-1-2013:p0952:b004:l002","ordinal":149744,"en":"Were it not for his being Chinese,"},{"id":"semetey-1-2013:p0952:b004:l003","ordinal":149745,"en":"He would be a man to marry.'"},{"id":"semetey-1-2013:p0952:b004:l004","ordinal":149746,"en":"Your infidel girl, seeking a hero,"},{"id":"semetey-1-2013:p0952:b004:l005","ordinal":149747,"en":"Liked the Kalcha greatly."},{"id":"semetey-1-2013:p0952:b004:l006","ordinal":149748,"en":"Having traveled among so many,"},{"id":"semetey-1-2013:p0952:b004:l007","ordinal":149749,"en":"Were it not for his unbelief,"},{"id":"semetey-1-2013:p0952:b004:l008","ordinal":149750,"en":"She liked the Kalcha very much."},{"id":"semetey-1-2013:p0952:b004:l009","ordinal":149751,"en":"'He has reached his dotage,"},{"id":"semetey-1-2013:p0952:b004:l010","ordinal":149752,"en":"He has grown old,' she thought,"},{"id":"semetey-1-2013:p0952:b004:l011","ordinal":149753,"en":"Liking the hero greatly,"},{"id":"semetey-1-2013:p0952:b004:l012","ordinal":149754,"en":"The champion Kongurbai."},{"id":"semetey-1-2013:p0952:b004:l013","ordinal":149755,"en":"Taking the form of a gray lark, she sped,"},{"id":"semetey-1-2013:p0952:b004:l014","ordinal":149756,"en":"Delighted by his lionlike prowess."},{"id":"semetey-1-2013:p0952:b004:l015","ordinal":149757,"en":"Your dear sister-in-law drew near."},{"id":"semetey-1-2013:p0952:b004:l016","ordinal":149758,"en":"When she came closer,"},{"id":"semetey-1-2013:p0952:b004:l017","ordinal":149759,"en":"With a cotton sash and broad boots,"},{"id":"semetey-1-2013:p0952:b004:l018","ordinal":149760,"en":"Kongurbai, khan of the monks,"}]
