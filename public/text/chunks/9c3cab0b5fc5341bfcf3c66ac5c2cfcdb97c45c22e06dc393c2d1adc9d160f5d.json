[{"id":"manas-2010:p0664:b001:l038","ordinal":29697,"en":"He brought out five objects;"},{"id":"manas-2010:p0664:b001:l039","ordinal":29698,"en":"When your champion lord drew them forth,"},{"id":"manas-2010:p0664:b001:l040","ordinal":29699,"en":"Those who saw them marveled."},{"id":"manas-2010:p0664:b001:l041","ordinal":29700,"en":"The six blades fallen from heaven,"},{"id":"manas-2010:p0664:b001:l042","ordinal":29701,"en":"The exceptional blades my Allah gave—"},{"id":"manas-2010:p0665:b001:l001","ordinal":29702,"en":"The very finest of swords,"},{"id":"manas-2010:p0665:b001:l002","ordinal":29703,"en":"Zulpukor, which Manas took;"},{"id":"manas-2010:p0665:b001:l003","ordinal":29704,"en":"To Bakay he gave Oykuma,"},{"id":"manas-2010:p0665:b001:l004","ordinal":29705,"en":"Binding it back and fastening it."},{"id":"manas-2010:p0665:b001:l005","ordinal":29706,"en":"To the champion Khan Azhybay"},{"id":"manas-2010:p0665:b001:l006","ordinal":29707,"en":"He entrusted Achalbars."},{"id":"manas-2010:p0665:b001:l007","ordinal":29708,"en":"“Let champions Bakay and Azhybay"},{"id":"manas-2010:p0665:b001:l008","ordinal":29709,"en":"Receive them as entrusted gifts,” he said."},{"id":"manas-2010:p0665:b001:l009","ordinal":29710,"en":"“When they enter clashing enemies,"},{"id":"manas-2010:p0665:b001:l010","ordinal":29711,"en":"Let them bring a red slaughter,” he said."},{"id":"manas-2010:p0665:b001:l011","ordinal":29712,"en":"“Azhybay, Bakay, the two of you,"},{"id":"manas-2010:p0665:b001:l012","ordinal":29713,"en":"‘When they come, I shall give what is entrusted,’ I said;"},{"id":"manas-2010:p0665:b001:l013","ordinal":29714,"en":"I have been waiting for you."},{"id":"manas-2010:p0665:b001:l014","ordinal":29715,"en":"Let me heed what you say,"},{"id":"manas-2010:p0665:b001:l015","ordinal":29716,"en":"Azhybay and Bakay, the two khans;"},{"id":"manas-2010:p0665:b001:l016","ordinal":29717,"en":"Let me give you what is entrusted."},{"id":"manas-2010:p0665:b001:l017","ordinal":29718,"en":"When drawn from the sheath with a shout,"},{"id":"manas-2010:p0665:b001:l018","ordinal":29719,"en":"It has the terror of forty men."},{"id":"manas-2010:p0665:b001:l019","ordinal":29720,"en":"When swung in fierce excitement,"},{"id":"manas-2010:p0665:b001:l020","ordinal":29721,"en":"Blood springs out at its swing."},{"id":"manas-2010:p0665:b001:l021","ordinal":29722,"en":"The enemy standing and watching,"},{"id":"manas-2010:p0665:b001:l022","ordinal":29723,"en":"Staring at it, loses his life."},{"id":"manas-2010:p0665:b001:l023","ordinal":29724,"en":"Unless it has feasted its fill on blood,"},{"id":"manas-2010:p0665:b001:l024","ordinal":29725,"en":"It will never go back into its sheath."},{"id":"manas-2010:p0665:b001:l025","ordinal":29726,"en":"When drawn from the sheath with a shout,"},{"id":"manas-2010:p0665:b001:l026","ordinal":29727,"en":"It never remains idle without drinking blood."},{"id":"manas-2010:p0665:b001:l027","ordinal":29728,"en":"Azhybay and Bakay, the two khans,"},{"id":"manas-2010:p0665:b001:l028","ordinal":29729,"en":"I have given the swords expressly to you."},{"id":"manas-2010:p0665:b001:l029","ordinal":29730,"en":"Take them as companions;"},{"id":"manas-2010:p0665:b001:l030","ordinal":29731,"en":"They are needed most against battling foes."},{"id":"manas-2010:p0665:b001:l031","ordinal":29732,"en":"Take them as your own lives."},{"id":"manas-2010:p0665:b001:l032","ordinal":29733,"en":"If you draw and swing them slantwise,"},{"id":"manas-2010:p0665:b001:l033","ordinal":29734,"en":"You will see the joy they bring."},{"id":"manas-2010:p0665:b001:l034","ordinal":29735,"en":"When you shout and pull one from its sheath,"},{"id":"manas-2010:p0665:b001:l035","ordinal":29736,"en":"It is a companion to your entrusted life."},{"id":"manas-2010:p0665:b001:l036","ordinal":29737,"en":"Its sharpness is known to souls."},{"id":"manas-2010:p0665:b001:l037","ordinal":29738,"en":"‘Their leaders, Manas and Bakay’—"},{"id":"manas-2010:p0665:b001:l038","ordinal":29739,"en":"Upon the face of this sword"},{"id":"manas-2010:p0665:b001:l039","ordinal":29740,"en":"The names of all six are inscribed."},{"id":"manas-2010:p0665:b001:l040","ordinal":29741,"en":"When your equipment fails and strength departs,"},{"id":"manas-2010:p0665:b001:l041","ordinal":29742,"en":"Draw it forth when hard pressed."},{"id":"manas-2010:p0665:b001:l042","ordinal":29743,"en":"If carelessly you lose it,"},{"id":"manas-2010:p0666:b001:l001","ordinal":29744,"en":"Khan Azhybay, disgrace will be yours."},{"id":"manas-2010:p0666:b001:l002","ordinal":29745,"en":"Of the six blades fallen from heaven,"},{"id":"manas-2010:p0666:b001:l003","ordinal":29746,"en":"I have entrusted one to you!"},{"id":"manas-2010:p0666:b001:l004","ordinal":29747,"en":"Exert your strength mightily."},{"id":"manas-2010:p0666:b001:l005","ordinal":29748,"en":"‘My blood-drinker chose to give it,’ say,"},{"id":"manas-2010:p0666:b001:l006","ordinal":29749,"en":"And receive it as a trust."},{"id":"manas-2010:p0666:b001:l007","ordinal":29750,"en":"When you meet a battling enemy,"},{"id":"manas-2010:p0666:b001:l008","ordinal":29751,"en":"Exert your strength fiercely."},{"id":"manas-2010:p0666:b001:l009","ordinal":29752,"en":"‘Leopard Manas gave it,’ say;"},{"id":"manas-2010:p0666:b001:l010","ordinal":29753,"en":"The Achalbars in your hand,"},{"id":"manas-2010:p0666:b001:l011","ordinal":29754,"en":"Receive it as a blessing."},{"id":"manas-2010:p0666:b001:l012","ordinal":29755,"en":"Say, ‘Give us Akkelte.’"},{"id":"manas-2010:p0666:b001:l013","ordinal":29756,"en":"My precious Azhy, my blue-maned one,"},{"id":"manas-2010:p0666:b001:l014","ordinal":29757,"en":"Return safe and sound!”"},{"id":"manas-2010:p0666:b001:l015","ordinal":29758,"en":"On the pine-covered headland,"},{"id":"manas-2010:p0666:b001:l016","ordinal":29759,"en":"Khan Bakay and Manas stayed now."},{"id":"manas-2010:p0666:b001:l017","ordinal":29760,"en":"Hero Azhybay pressed forward;"},{"id":"manas-2010:p0666:b001:l018","ordinal":29761,"en":"He now left as an envoy."},{"id":"manas-2010:p0666:b001:l019","ordinal":29762,"en":"Kartküröng, a tulpar among horses,"},{"id":"manas-2010:p0666:b001:l020","ordinal":29763,"en":"Racing on Kartküröng,"},{"id":"manas-2010:p0666:b001:l021","ordinal":29764,"en":"Sending dust twisting mountain-high,"},{"id":"manas-2010:p0666:b001:l022","ordinal":29765,"en":"Hooves clattering on the level steppe,"},{"id":"manas-2010:p0666:b001:l023","ordinal":29766,"en":"When he slackened the horse's mouth,"},{"id":"manas-2010:p0666:b001:l024","ordinal":29767,"en":"Speeding like a cloud,"},{"id":"manas-2010:p0666:b001:l025","ordinal":29768,"en":"To the city of dark mist,"},{"id":"manas-2010:p0666:b001:l026","ordinal":29769,"en":"Azhybay arrived,"},{"id":"manas-2010:p0666:b001:l027","ordinal":29770,"en":"To the city of Khan Kerke."},{"id":"manas-2010:p0666:b001:l028","ordinal":29771,"en":"Broad-jawed, wide-tongued,"},{"id":"manas-2010:p0666:b001:l029","ordinal":29772,"en":"A great orator who never stumbled,"},{"id":"manas-2010:p0666:b001:l030","ordinal":29773,"en":"Azhybay arrived"},{"id":"manas-2010:p0666:b001:l031","ordinal":29774,"en":"At the throne of the royal fortress."},{"id":"manas-2010:p0666:b001:l032","ordinal":29775,"en":"Beside that Kerke,"},{"id":"manas-2010:p0666:b001:l033","ordinal":29776,"en":"The champions were extraordinary;"},{"id":"manas-2010:p0666:b001:l034","ordinal":29777,"en":"Holding maces as big as houses and mountains,"},{"id":"manas-2010:p0666:b001:l035","ordinal":29778,"en":"There were many warriors."},{"id":"manas-2010:p0666:b001:l036","ordinal":29779,"en":"At his door, his guards;"},{"id":"manas-2010:p0666:b001:l037","ordinal":29780,"en":"Before the khan, his gardeners;"},{"id":"manas-2010:p0666:b001:l038","ordinal":29781,"en":"His nobles and champions—"},{"id":"manas-2010:p0666:b001:l039","ordinal":29782,"en":"Such were his mighty men."},{"id":"manas-2010:p0666:b001:l040","ordinal":29783,"en":"Their prowess was extraordinary;"},{"id":"manas-2010:p0666:b001:l041","ordinal":29784,"en":"There were many warriors."},{"id":"manas-2010:p0666:b001:l042","ordinal":29785,"en":"His title of khan was empty—"},{"id":"manas-2010:p0667:b001:l001","ordinal":29786,"en":"Eighty retainers were beside him."},{"id":"manas-2010:p0667:b001:l002","ordinal":29787,"en":"His luck and his fortune"},{"id":"manas-2010:p0667:b001:l003","ordinal":29788,"en":"Were prospering at that time."},{"id":"manas-2010:p0667:b001:l004","ordinal":29789,"en":"Forty retainers on his right,"},{"id":"manas-2010:p0667:b001:l005","ordinal":29790,"en":"Forty retainers on his left,"},{"id":"manas-2010:p0667:b001:l006","ordinal":29791,"en":"As though he were lying sick,"},{"id":"manas-2010:p0667:b001:l007","ordinal":29792,"en":"They pampered Kerke,"},{"id":"manas-2010:p0667:b001:l008","ordinal":29793,"en":"Propping him up at that time."},{"id":"manas-2010:p0667:b001:l009","ordinal":29794,"en":"The axemen were extraordinary;"},{"id":"manas-2010:p0667:b001:l010","ordinal":29795,"en":"There were many swordsmen."},{"id":"manas-2010:p0667:b001:l011","ordinal":29796,"en":"Speaking softly, laying words down firmly,"},{"id":"manas-2010:p0667:b001:l012","ordinal":29797,"en":"Before that Kerke,"},{"id":"manas-2010:p0667:b001:l013","ordinal":29798,"en":"Khan Azhybay began:"},{"id":"manas-2010:p0667:b001:l014","ordinal":29799,"en":"“We are envoys come before you."},{"id":"manas-2010:p0667:b001:l015","ordinal":29800,"en":"If you ask our name and circumstances,"},{"id":"manas-2010:p0667:b001:l016","ordinal":29801,"en":"We are guides who have scouted the world."},{"id":"manas-2010:p0667:b001:l017","ordinal":29802,"en":"Traversing the whole earth,"},{"id":"manas-2010:p0667:b001:l018","ordinal":29803,"en":"The world's four corners,"},{"id":"manas-2010:p0667:b001:l019","ordinal":29804,"en":"Roaming on all four sides,"},{"id":"manas-2010:p0667:b001:l020","ordinal":29805,"en":"Finding no mountain to crash against,"},{"id":"manas-2010:p0667:b001:l021","ordinal":29806,"en":"We are among the heroes who wander."},{"id":"manas-2010:p0667:b001:l022","ordinal":29807,"en":"Wearing coats no shot can pierce,"},{"id":"manas-2010:p0667:b001:l023","ordinal":29808,"en":"Riding horses no shot can reach,"},{"id":"manas-2010:p0667:b001:l024","ordinal":29809,"en":"Traversing the land thoroughly,"},{"id":"manas-2010:p0667:b001:l025","ordinal":29810,"en":"Roaming all the world—"},{"id":"manas-2010:p0667:b001:l026","ordinal":29811,"en":"There are wonders, if I tell them."},{"id":"manas-2010:p0667:b001:l027","ordinal":29812,"en":"To plunder your sprawling city,"},{"id":"manas-2010:p0667:b001:l028","ordinal":29813,"en":"Prepared and waiting behind me,"},{"id":"manas-2010:p0667:b001:l029","ordinal":29814,"en":"I have eight san of dark troops."},{"id":"manas-2010:p0667:b001:l030","ordinal":29815,"en":"The army's leader, mighty Manas,"},{"id":"manas-2010:p0667:b001:l031","ordinal":29816,"en":"Was born wandering in Altay;"},{"id":"manas-2010:p0667:b001:l032","ordinal":29817,"en":"In Kakan-Chin's Chin-Machin,"},{"id":"manas-2010:p0667:b001:l033","ordinal":29818,"en":"He truly raised an uproar."},{"id":"manas-2010:p0667:b001:l034","ordinal":29819,"en":"Sparing none who faced him,"},{"id":"manas-2010:p0667:b001:l035","ordinal":29820,"en":"Never sated with drinking blood,"},{"id":"manas-2010:p0667:b001:l036","ordinal":29821,"en":"Khan Manas and Bakay themselves are there."},{"id":"manas-2010:p0667:b001:l037","ordinal":29822,"en":"Azhybay, come as envoy,"},{"id":"manas-2010:p0667:b001:l038","ordinal":29823,"en":"Has words to say to you."},{"id":"manas-2010:p0667:b001:l039","ordinal":29824,"en":"From the envoy who roams the land,"},{"id":"manas-2010:p0667:b001:l040","ordinal":29825,"en":"From pines, the steppe, the grassy slope,"},{"id":"manas-2010:p0667:b001:l041","ordinal":29826,"en":"Hero, from the place where he cached it,"},{"id":"manas-2010:p0667:b001:l042","ordinal":29827,"en":"You have caused much havoc;"},{"id":"manas-2010:p0668:b001:l001","ordinal":29828,"en":"You have stolen Akkelte;"},{"id":"manas-2010:p0668:b001:l002","ordinal":29829,"en":"You have brought much trouble upon yourself!"},{"id":"manas-2010:p0668:b001:l003","ordinal":29830,"en":"Your champion who roams the land—"},{"id":"manas-2010:p0668:b001:l004","ordinal":29831,"en":"Khan Bakay saw it,"},{"id":"manas-2010:p0668:b001:l005","ordinal":29832,"en":"How your champion opened the cache and took it."},{"id":"manas-2010:p0668:b001:l006","ordinal":29833,"en":"Without quarrelling or bickering,"},{"id":"manas-2010:p0668:b001:l007","ordinal":29834,"en":"Give us Akkelte."},{"id":"manas-2010:p0668:b001:l008","ordinal":29835,"en":"If you do not heed my words,"},{"id":"manas-2010:p0668:b001:l009","ordinal":29836,"en":"If you do not give Akkelte,"},{"id":"manas-2010:p0668:b001:l010","ordinal":29837,"en":"The one who sent me as envoy"},{"id":"manas-2010:p0668:b001:l011","ordinal":29838,"en":"Bears the name blood-drinking Manas."},{"id":"manas-2010:p0668:b001:l012","ordinal":29839,"en":"It is worth the whole world,"},{"id":"manas-2010:p0668:b001:l013","ordinal":29840,"en":"This trouble over Akkelte!"},{"id":"manas-2010:p0668:b001:l014","ordinal":29841,"en":"I am an envoy come between you;"},{"id":"manas-2010:p0668:b001:l015","ordinal":29842,"en":"I shall sing you my song."},{"id":"manas-2010:p0668:b001:l016","ordinal":29843,"en":"Let me tell you without concealment"},{"id":"manas-2010:p0668:b001:l017","ordinal":29844,"en":"The quarrel I shall bring upon you."},{"id":"manas-2010:p0668:b001:l018","ordinal":29845,"en":"These are my words—heed them."},{"id":"manas-2010:p0668:b001:l019","ordinal":29846,"en":"If you truly are a khan,"},{"id":"manas-2010:p0668:b001:l020","ordinal":29847,"en":"Give us Akkelte."},{"id":"manas-2010:p0668:b001:l021","ordinal":29848,"en":"Heed the words we speak;"},{"id":"manas-2010:p0668:b001:l022","ordinal":29849,"en":"Give us Akkelte."},{"id":"manas-2010:p0668:b001:l023","ordinal":29850,"en":"Without quarrelling or bickering,"},{"id":"manas-2010:p0668:b001:l024","ordinal":29851,"en":"Give us Akkelte."},{"id":"manas-2010:p0668:b001:l025","ordinal":29852,"en":"The short gun that was lost"},{"id":"manas-2010:p0668:b001:l026","ordinal":29853,"en":"Has one twisted as thick as a forearm,"},{"id":"manas-2010:p0668:b001:l027","ordinal":29854,"en":"A strap attached, made of gold."},{"id":"manas-2010:p0668:b001:l028","ordinal":29855,"en":"If that short gun is lost,"},{"id":"manas-2010:p0668:b001:l029","ordinal":29856,"en":"Listen, you Kerke:"},{"id":"manas-2010:p0668:b001:l030","ordinal":29857,"en":"There is an unending, grievous claim."},{"id":"manas-2010:p0668:b001:l031","ordinal":29858,"en":"After Akkelte,"},{"id":"manas-2010:p0668:b001:l032","ordinal":29859,"en":"Manas drove an army forward."},{"id":"manas-2010:p0668:b001:l033","ordinal":29860,"en":"Today that Manas,"},{"id":"manas-2010:p0668:b001:l034","ordinal":29861,"en":"Now to drain you dry,"},{"id":"manas-2010:p0668:b001:l035","ordinal":29862,"en":"Has gathered many exceptional champions."},{"id":"manas-2010:p0668:b001:l036","ordinal":29863,"en":"If you do not heed our words,"},{"id":"manas-2010:p0668:b001:l037","ordinal":29864,"en":"If you do not give Akkelte,"},{"id":"manas-2010:p0668:b001:l038","ordinal":29865,"en":"The road for the army's march is ready."},{"id":"manas-2010:p0668:b001:l039","ordinal":29866,"en":"Each worth a thousand,"},{"id":"manas-2010:p0668:b001:l040","ordinal":29867,"en":"Mighty men stand ready to bind you."},{"id":"manas-2010:p0668:b001:l041","ordinal":29868,"en":"They will stand on either side;"},{"id":"manas-2010:p0668:b001:l042","ordinal":29869,"en":"For the sake of Akkelte,"},{"id":"manas-2010:p0669:b001:l001","ordinal":29870,"en":"Firing guns and drawing bows,"},{"id":"manas-2010:p0669:b001:l002","ordinal":29871,"en":"They will clash and fight."},{"id":"manas-2010:p0669:b001:l003","ordinal":29872,"en":"Only those who do not die will remain."},{"id":"manas-2010:p0669:b001:l004","ordinal":29873,"en":"If you do not give Akkelte,"},{"id":"manas-2010:p0669:b001:l005","ordinal":29874,"en":"If you do not heed our words,"},{"id":"manas-2010:p0669:b001:l006","ordinal":29875,"en":"Until the pliant dry stalks ripen,"},{"id":"manas-2010:p0669:b001:l007","ordinal":29876,"en":"Until the autumn gossamer flies,"},{"id":"manas-2010:p0669:b001:l008","ordinal":29877,"en":"They will fight a full six months."},{"id":"manas-2010:p0669:b001:l009","ordinal":29878,"en":"Their champions are extraordinary;"},{"id":"manas-2010:p0669:b001:l010","ordinal":29879,"en":"Manas is no ordinary hero."},{"id":"manas-2010:p0669:b001:l011","ordinal":29880,"en":"His warriors are many;"},{"id":"manas-2010:p0669:b001:l012","ordinal":29881,"en":"There are those whose speech no human knows."},{"id":"manas-2010:p0669:b001:l013","ordinal":29882,"en":"In that Manas's army,"},{"id":"manas-2010:p0669:b001:l014","ordinal":29883,"en":"There are those with one eye in their forehead;"},{"id":"manas-2010:p0669:b001:l015","ordinal":29884,"en":"He has rhinoceroses and elephants."},{"id":"manas-2010:p0669:b001:l016","ordinal":29885,"en":"If you resist, he will slaughter you utterly."},{"id":"manas-2010:p0669:b001:l017","ordinal":29886,"en":"Know these words of mine:"},{"id":"manas-2010:p0669:b001:l018","ordinal":29887,"en":"Khan Manas is sheer calamity;"},{"id":"manas-2010:p0669:b001:l019","ordinal":29888,"en":"No human can endure and fight him!"},{"id":"manas-2010:p0669:b001:l020","ordinal":29889,"en":"Let him not destroy you utterly."},{"id":"manas-2010:p0669:b001:l021","ordinal":29890,"en":"If you will not heed his words,"},{"id":"manas-2010:p0669:b001:l022","ordinal":29891,"en":"If you will not give back his Akkelte,"},{"id":"manas-2010:p0669:b001:l023","ordinal":29892,"en":"Let him not level and slaughter you!"},{"id":"manas-2010:p0669:b001:l024","ordinal":29893,"en":"Such is Manas's nature:"},{"id":"manas-2010:p0669:b001:l025","ordinal":29894,"en":"Told to drink water, he drank poison;"},{"id":"manas-2010:p0669:b001:l026","ordinal":29895,"en":"Told to take a cap, he cut off a head."},{"id":"manas-2010:p0669:b001:l027","ordinal":29896,"en":"He has that foolishness as well."},{"id":"manas-2010:p0669:b001:l028","ordinal":29897,"en":"Burning those who cause a quarrel,"},{"id":"manas-2010:p0669:b001:l029","ordinal":29898,"en":"He has that violent recklessness as well."},{"id":"manas-2010:p0669:b001:l030","ordinal":29899,"en":"Sparing no soul that begs,"},{"id":"manas-2010:p0669:b001:l031","ordinal":29900,"en":"He has that godlessness as well."},{"id":"manas-2010:p0669:b001:l032","ordinal":29901,"en":"Never sated with drinking blood,"},{"id":"manas-2010:p0669:b001:l033","ordinal":29902,"en":"He has that heroism as well."},{"id":"manas-2010:p0669:b001:l034","ordinal":29903,"en":"Among spearmen, to an extreme,"},{"id":"manas-2010:p0669:b001:l035","ordinal":29904,"en":"He has that deceitfulness as well."},{"id":"manas-2010:p0669:b001:l036","ordinal":29905,"en":"Never sated with drinking blood,"},{"id":"manas-2010:p0669:b001:l037","ordinal":29906,"en":"He has that bloodthirst as well."},{"id":"manas-2010:p0669:b001:l038","ordinal":29907,"en":"If you fight, he will bend your back;"},{"id":"manas-2010:p0669:b001:l039","ordinal":29908,"en":"He will slaughter your people;"},{"id":"manas-2010:p0669:b001:l040","ordinal":29909,"en":"He will pulverize your land."},{"id":"manas-2010:p0669:b001:l041","ordinal":29910,"en":"Heed these words;"},{"id":"manas-2010:p0669:b001:l042","ordinal":29911,"en":"Give us Akkelte!"},{"id":"manas-2010:p0670:b001:l001","ordinal":29912,"en":"If by chance you delay,"},{"id":"manas-2010:p0670:b001:l002","ordinal":29913,"en":"Strange in manner, fierce in wrath,"},{"id":"manas-2010:p0670:b001:l003","ordinal":29914,"en":"The mighty predator Manas, the leopard,"},{"id":"manas-2010:p0670:b001:l004","ordinal":29915,"en":"May suddenly start a quarrel!"},{"id":"manas-2010:p0670:b001:l005","ordinal":29916,"en":"When Lord Manas roars,"},{"id":"manas-2010:p0670:b001:l006","ordinal":29917,"en":"Let him not trample your head;"},{"id":"manas-2010:p0670:b001:l007","ordinal":29918,"en":"Let him not scatter your four kinds of livestock."},{"id":"manas-2010:p0670:b001:l008","ordinal":29919,"en":"Let him not break into your treasury;"},{"id":"manas-2010:p0670:b001:l009","ordinal":29920,"en":"‘Where is my short gun?’ he will say—"},{"id":"manas-2010:p0670:b001:l010","ordinal":29921,"en":"Let him not seize and slit your scalp!"},{"id":"manas-2010:p0670:b001:l011","ordinal":29922,"en":"If you will not heed our words,"},{"id":"manas-2010:p0670:b001:l012","ordinal":29923,"en":"If you will not give Akkelte,"},{"id":"manas-2010:p0670:b001:l013","ordinal":29924,"en":"Say plainly, ‘I will not give it.’"},{"id":"manas-2010:p0670:b001:l014","ordinal":29925,"en":"Name the place where you will face us!"},{"id":"manas-2010:p0670:b001:l015","ordinal":29926,"en":"If you have no strength to grapple,"},{"id":"manas-2010:p0670:b001:l016","ordinal":29927,"en":"Heed the words we speak;"},{"id":"manas-2010:p0670:b001:l017","ordinal":29928,"en":"Simply, without quarrelling,"},{"id":"manas-2010:p0670:b001:l018","ordinal":29929,"en":"Give us Akkelte!”"},{"id":"manas-2010:p0670:b001:l019","ordinal":29930,"en":"When they heard this news,"},{"id":"manas-2010:p0670:b001:l020","ordinal":29931,"en":"They spoke in whispers;"},{"id":"manas-2010:p0670:b001:l021","ordinal":29932,"en":"Their fur caps spun about."},{"id":"manas-2010:p0670:b001:l022","ordinal":29933,"en":"When they called to one another,"},{"id":"manas-2010:p0670:b001:l023","ordinal":29934,"en":"Their nimble servants flew about."},{"id":"manas-2010:p0670:b001:l024","ordinal":29935,"en":"Whispering together,"},{"id":"manas-2010:p0670:b001:l025","ordinal":29936,"en":"Beyond any person's discernment,"},{"id":"manas-2010:p0670:b001:l026","ordinal":29937,"en":"They entered into secret counsel."},{"id":"manas-2010:p0670:b001:l027","ordinal":29938,"en":"Taking ten executioners along,"},{"id":"manas-2010:p0670:b001:l028","ordinal":29939,"en":"Bustling in confusion,"},{"id":"manas-2010:p0670:b001:l029","ordinal":29940,"en":"Looming as though ready to fight,"},{"id":"manas-2010:p0670:b001:l030","ordinal":29941,"en":"They readied their weapons;"},{"id":"manas-2010:p0670:b001:l031","ordinal":29942,"en":"Long-maned, thick-legged,"},{"id":"manas-2010:p0670:b001:l032","ordinal":29943,"en":"They prepared mighty horses."},{"id":"manas-2010:p0670:b001:l033","ordinal":29944,"en":"Finding no way out, bewildered,"},{"id":"manas-2010:p0670:b001:l034","ordinal":29945,"en":"He babbled to his soldiers."},{"id":"manas-2010:p0670:b001:l035","ordinal":29946,"en":"Working his mind, thinking thoughts,"},{"id":"manas-2010:p0670:b001:l036","ordinal":29947,"en":"As though giving away his own gun,"},{"id":"manas-2010:p0670:b001:l037","ordinal":29948,"en":"He cried, ‘Oh, oh!’ over Akkelte."},{"id":"manas-2010:p0670:b001:l038","ordinal":29949,"en":"Astonished and flustered,"},{"id":"manas-2010:p0670:b001:l039","ordinal":29950,"en":"Working his mind, thinking thoughts,"},{"id":"manas-2010:p0670:b001:l040","ordinal":29951,"en":"Before Azhybay,"},{"id":"manas-2010:p0670:b001:l041","ordinal":29952,"en":"Readying himself like a goshawk,"}]
