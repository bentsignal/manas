[{"id":"semetey-1-2013:p0727:b004:l030","ordinal":132097,"en":"Beyond you are Chinese."},{"id":"semetey-1-2013:p0727:b004:l031","ordinal":132098,"en":"There are many enemies to destroy."},{"id":"semetey-1-2013:p0727:b004:l032","ordinal":132099,"en":"On the upper side are Barangs;"},{"id":"semetey-1-2013:p0727:b004:l033","ordinal":132100,"en":"There are many enemies to contend with.”"},{"id":"semetey-1-2013:p0727:b004:l034","ordinal":132101,"en":"So spoke warrior Chubak."},{"id":"semetey-1-2013:p0727:b004:l035","ordinal":132102,"en":"Akbaltai's horses,"},{"id":"semetey-1-2013:p0727:b004:l036","ordinal":132103,"en":"He gathered them all."},{"id":"semetey-1-2013:p0727:b004:l037","ordinal":132104,"en":"For eighty days, day and night,"},{"id":"semetey-1-2013:p0727:b004:l038","ordinal":132105,"en":"He had them led past in a long file."},{"id":"semetey-1-2013:p0727:b004:l039","ordinal":132106,"en":"He had the horse judges examine them,"},{"id":"semetey-1-2013:p0728:b003:l001","ordinal":132107,"en":"As your mighty Chubak stood there,"},{"id":"semetey-1-2013:p0728:b003:l002","ordinal":132108,"en":"Finding no horse to ride in battle,"},{"id":"semetey-1-2013:p0728:b003:l003","ordinal":132109,"en":"Finding no mount to ride in combat,"},{"id":"semetey-1-2013:p0728:b003:l004","ordinal":132110,"en":"Grieving and worn with distress,"},{"id":"semetey-1-2013:p0728:b003:l005","ordinal":132111,"en":"What could precious Chubak do?"},{"id":"semetey-1-2013:p0728:b003:l006","ordinal":132112,"en":"He took offense at Akbaltai."},{"id":"semetey-1-2013:p0728:b003:l007","ordinal":132113,"en":"“Father, my beloved khan father,"},{"id":"semetey-1-2013:p0728:b003:l008","ordinal":132114,"en":"More than the many Kyrgyz,"},{"id":"semetey-1-2013:p0728:b003:l009","ordinal":132115,"en":"You have tended your horses."},{"id":"semetey-1-2013:p0728:b003:l010","ordinal":132116,"en":"Yet there is not one horse to ride on patrol!"},{"id":"semetey-1-2013:p0728:b003:l011","ordinal":132117,"en":"These wretched horses,"},{"id":"semetey-1-2013:p0728:b003:l012","ordinal":132118,"en":"You have reared them in vain."},{"id":"semetey-1-2013:p0728:b003:l013","ordinal":132119,"en":"With pasterns a handbreadth long—"},{"id":"semetey-1-2013:p0728:b003:l014","ordinal":132120,"en":"Warrior father, hear my words!"},{"id":"semetey-1-2013:p0728:b003:l015","ordinal":132121,"en":"You have reared frogs!"},{"id":"semetey-1-2013:p0728:b003:l016","ordinal":132122,"en":"With heels a handbreadth long,"},{"id":"semetey-1-2013:p0728:b003:l017","ordinal":132123,"en":"Father, you have reared nags!"},{"id":"semetey-1-2013:p0728:b003:l018","ordinal":132124,"en":"Where are horses like these lacking?"},{"id":"semetey-1-2013:p0728:b003:l019","ordinal":132125,"en":"There is no use in these horses of yours.”"},{"id":"semetey-1-2013:p0728:b003:l020","ordinal":132126,"en":"Chubak spoke, working himself into a frenzy."},{"id":"semetey-1-2013:p0728:b003:l021","ordinal":132127,"en":"In the wilderness of Mediyan,"},{"id":"semetey-1-2013:p0728:b003:l022","ordinal":132128,"en":"He went wandering in agitation,"},{"id":"semetey-1-2013:p0728:b003:l023","ordinal":132129,"en":"Grieving and worn with distress,"},{"id":"semetey-1-2013:p0728:b003:l024","ordinal":132130,"en":"Offended at Khan Baltai."},{"id":"semetey-1-2013:p0728:b003:l025","ordinal":132131,"en":"There was no crow flying and cawing,"},{"id":"semetey-1-2013:p0728:b003:l026","ordinal":132132,"en":"No raven croaking,"},{"id":"semetey-1-2013:p0728:b003:l027","ordinal":132133,"en":"No blade of grass to nibble,"},{"id":"semetey-1-2013:p0728:b003:l028","ordinal":132134,"en":"No drop of water anywhere."},{"id":"semetey-1-2013:p0728:b003:l029","ordinal":132135,"en":"In the wilderness of Mediyan,"},{"id":"semetey-1-2013:p0728:b003:l030","ordinal":132136,"en":"No living shape was beside him."},{"id":"semetey-1-2013:p0728:b003:l031","ordinal":132137,"en":"There was no warrior like Chubak."},{"id":"semetey-1-2013:p0728:b003:l032","ordinal":132138,"en":"As he entered in his frenzy,"},{"id":"semetey-1-2013:p0728:b003:l033","ordinal":132139,"en":"At the edge of that wilderness,"},{"id":"semetey-1-2013:p0728:b003:l034","ordinal":132140,"en":"On its northern side,"},{"id":"semetey-1-2013:p0728:b003:l035","ordinal":132141,"en":"Racing with wild asses,"},{"id":"semetey-1-2013:p0728:b003:l036","ordinal":132142,"en":"Born of Jelkaiyp,"},{"id":"semetey-1-2013:p0728:b003:l037","ordinal":132143,"en":"High-backed, yet low in stature,"},{"id":"semetey-1-2013:p0728:b003:l038","ordinal":132144,"en":"Never faltering when sent over hills,"},{"id":"semetey-1-2013:p0728:b003:l039","ordinal":132145,"en":"Never tiring when ridden on raids,"},{"id":"semetey-1-2013:p0728:b004:l001","ordinal":132146,"en":"Never ailing when ridden with the baggage train,"},{"id":"semetey-1-2013:p0728:b004:l002","ordinal":132147,"en":"With a lovely forelock and scant mane,"},{"id":"semetey-1-2013:p0728:b004:l003","ordinal":132148,"en":"A true noble steed of peerless form,"},{"id":"semetey-1-2013:p0728:b004:l004","ordinal":132149,"en":"To Khan Baltai's Chubak"},{"id":"semetey-1-2013:p0728:b004:l005","ordinal":132150,"en":"It came while he raged."},{"id":"semetey-1-2013:p0728:b004:l006","ordinal":132151,"en":"To God's beloved servant,"},{"id":"semetey-1-2013:p0728:b004:l007","ordinal":132152,"en":"To poor Baltai's son,"},{"id":"semetey-1-2013:p0728:b004:l008","ordinal":132153,"en":"It came from an unknown place."},{"id":"semetey-1-2013:p0728:b004:l009","ordinal":132154,"en":"In his fifth year, Kökala"},{"id":"semetey-1-2013:p0728:b004:l010","ordinal":132155,"en":"Was found by that Chubak."},{"id":"semetey-1-2013:p0728:b004:l011","ordinal":132156,"en":"Akbaltai's Chubak"},{"id":"semetey-1-2013:p0728:b004:l012","ordinal":132157,"en":"Put on a bridle and rejoiced."},{"id":"semetey-1-2013:p0728:b004:l013","ordinal":132158,"en":"He examined Kökala."},{"id":"semetey-1-2013:p0728:b004:l014","ordinal":132159,"en":"“No overgrown frog within your hoof,"},{"id":"semetey-1-2013:p0728:b004:l015","ordinal":132160,"en":"My dear creature Kökala,"},{"id":"semetey-1-2013:p0728:b004:l016","ordinal":132161,"en":"You are a true noble steed!"},{"id":"semetey-1-2013:p0728:b004:l018","ordinal":132162,"en":"You are indeed a noble steed!”","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0728:b004:l019","ordinal":132163,"en":"Chubak put on a blue padded coat."},{"id":"semetey-1-2013:p0728:b004:l020","ordinal":132164,"en":"He mounted Kökala,"},{"id":"semetey-1-2013:p0728:b004:l021","ordinal":132165,"en":"Received Khan Baltai's blessing,"},{"id":"semetey-1-2013:p0728:b004:l022","ordinal":132166,"en":"And Chubak rode off to battle."},{"id":"semetey-1-2013:p0728:b004:l023","ordinal":132167,"en":"Finding no mountain to hurl himself against,"},{"id":"semetey-1-2013:p0728:b004:l024","ordinal":132168,"en":"Finding no enemy to fight,"},{"id":"semetey-1-2013:p0728:b004:l025","ordinal":132169,"en":"Thus Chubak trained himself."},{"id":"semetey-1-2013:p0728:b004:l026","ordinal":132170,"en":"When he reached twelve,"},{"id":"semetey-1-2013:p0728:b004:l027","ordinal":132171,"en":"He matured and became a warrior,"},{"id":"semetey-1-2013:p0728:b004:l028","ordinal":132172,"en":"The equal of grown warriors."},{"id":"semetey-1-2013:p0728:b004:l029","ordinal":132173,"en":"He besieged Kashgar and took it six times."},{"id":"semetey-1-2013:p0728:b004:l030","ordinal":132174,"en":"When Kashgar submitted,"},{"id":"semetey-1-2013:p0728:b004:l031","ordinal":132175,"en":"He ravaged Hindustan and took it four times."},{"id":"semetey-1-2013:p0728:b004:l032","ordinal":132176,"en":"He besieged Afghanistan and took it ten times."},{"id":"semetey-1-2013:p0728:b004:l033","ordinal":132177,"en":"That son of Akbaltai"},{"id":"semetey-1-2013:p0728:b004:l034","ordinal":132178,"en":"Raised strife wherever he played."},{"id":"semetey-1-2013:p0728:b004:l035","ordinal":132179,"en":"Causing great uproar,"},{"id":"semetey-1-2013:p0728:b004:l036","ordinal":132180,"en":"He was given the name Chubak."},{"id":"semetey-1-2013:p0728:b004:l037","ordinal":132181,"en":"Wrathful, a spiller of blood,"},{"id":"semetey-1-2013:p0728:b004:l038","ordinal":132182,"en":"He was given the name Chunak."},{"id":"semetey-1-2013:p0728:b004:l039","ordinal":132183,"en":"He advanced on Kökala."},{"id":"semetey-1-2013:p0729:b003:l001","ordinal":132184,"en":"He wielded blue-steel axe and sword;"},{"id":"semetey-1-2013:p0729:b003:l002","ordinal":132185,"en":"Those who challenged Chubak crawled away."},{"id":"semetey-1-2013:p0729:b003:l003","ordinal":132186,"en":"Akbaltai's Chubak,"},{"id":"semetey-1-2013:p0729:b003:l004","ordinal":132187,"en":"That wretch—your father's grave!—"},{"id":"semetey-1-2013:p0729:b003:l005","ordinal":132188,"en":"Besieged Andijan."},{"id":"semetey-1-2013:p0729:b003:l006","ordinal":132189,"en":"“Pay the tribute in full!” he said,"},{"id":"semetey-1-2013:p0729:b003:l007","ordinal":132190,"en":"And struck the people of Kokand."},{"id":"semetey-1-2013:p0729:b003:l008","ordinal":132191,"en":"Unable to endure his wrath,"},{"id":"semetey-1-2013:p0729:b003:l009","ordinal":132192,"en":"The city of Samarkand was worn down."},{"id":"semetey-1-2013:p0729:b003:l010","ordinal":132193,"en":"He turned Bukhara upside down,"},{"id":"semetey-1-2013:p0729:b003:l011","ordinal":132194,"en":"Wrought such mischief,"},{"id":"semetey-1-2013:p0729:b003:l012","ordinal":132195,"en":"And plundered its wealth."},{"id":"semetey-1-2013:p0729:b003:l013","ordinal":132196,"en":"Akbaltai's Chubak"},{"id":"semetey-1-2013:p0729:b003:l014","ordinal":132197,"en":"Was creating turmoil."},{"id":"semetey-1-2013:p0729:b003:l015","ordinal":132198,"en":"Unable to endure his turmoil,"},{"id":"semetey-1-2013:p0729:b003:l016","ordinal":132199,"en":"Then Kanykei, Temir Khan's daughter,"},{"id":"semetey-1-2013:p0729:b003:l017","ordinal":132200,"en":"That skilled woman,"},{"id":"semetey-1-2013:p0729:b003:l018","ordinal":132201,"en":"Had reached fourteen years"},{"id":"semetey-1-2013:p0729:b003:l019","ordinal":132202,"en":"And now came forth."},{"id":"semetey-1-2013:p0729:b003:l020","ordinal":132203,"en":"Her precious hair, like meadow grass,"},{"id":"semetey-1-2013:p0729:b003:l021","ordinal":132204,"en":"She bound tightly upon her crown."},{"id":"semetey-1-2013:p0729:b003:l022","ordinal":132205,"en":"She put on a shot-proof coat."},{"id":"semetey-1-2013:p0729:b003:l023","ordinal":132206,"en":"Her black, blaze-faced thoroughbred"},{"id":"semetey-1-2013:p0729:b003:l024","ordinal":132207,"en":"She covered, saddled and mounted."},{"id":"semetey-1-2013:p0729:b003:l025","ordinal":132208,"en":"On the great field of broad Bukhara,"},{"id":"semetey-1-2013:p0729:b003:l026","ordinal":132209,"en":"Coming proudly from a great ravine,"},{"id":"semetey-1-2013:p0729:b003:l027","ordinal":132210,"en":"They fought a spear duel."},{"id":"semetey-1-2013:p0729:b003:l028","ordinal":132211,"en":"Chubak and Kanykei,"},{"id":"semetey-1-2013:p0729:b003:l029","ordinal":132212,"en":"Against one another, those two"},{"id":"semetey-1-2013:p0729:b003:l030","ordinal":132213,"en":"Shouted and thrust their spears."},{"id":"semetey-1-2013:p0729:b003:l031","ordinal":132214,"en":"For six days, those two"},{"id":"semetey-1-2013:p0729:b003:l032","ordinal":132215,"en":"Could not overcome one another."},{"id":"semetey-1-2013:p0729:b003:l033","ordinal":132216,"en":"At broad Ak-Chiy of broad Bukhara,"},{"id":"semetey-1-2013:p0729:b003:l034","ordinal":132217,"en":"Shouting, they thrust their spears,"},{"id":"semetey-1-2013:p0729:b003:l035","ordinal":132218,"en":"Thrust in turn,"},{"id":"semetey-1-2013:p0729:b003:l036","ordinal":132219,"en":"Broke sixty spears,"},{"id":"semetey-1-2013:p0729:b003:l037","ordinal":132220,"en":"And fought their duel."},{"id":"semetey-1-2013:p0729:b003:l038","ordinal":132221,"en":"When six days had passed,"},{"id":"semetey-1-2013:p0729:b003:l039","ordinal":132222,"en":"Kanykei was about"},{"id":"semetey-1-2013:p0729:b005:l001","ordinal":132223,"en":"To perform a mighty deed."},{"id":"semetey-1-2013:p0729:b005:l002","ordinal":132224,"en":"For one thrust, she made four,"},{"id":"semetey-1-2013:p0729:b005:l003","ordinal":132225,"en":"And was about to overcome him."},{"id":"semetey-1-2013:p0729:b005:l004","ordinal":132226,"en":"Warrior Chubak, who thought himself a hero,"},{"id":"semetey-1-2013:p0729:b005:l005","ordinal":132227,"en":"Was thrown into confusion."},{"id":"semetey-1-2013:p0729:b005:l006","ordinal":132228,"en":"Turning his mount, he urged it on,"},{"id":"semetey-1-2013:p0729:b005:l007","ordinal":132229,"en":"Dashing toward his father Akbaltai,"},{"id":"semetey-1-2013:p0729:b005:l008","ordinal":132230,"en":"His wits scattered."},{"id":"semetey-1-2013:p0729:b005:l009","ordinal":132231,"en":"Warrior Chubak, in headlong panic,"},{"id":"semetey-1-2013:p0729:b005:l010","ordinal":132232,"en":"Fled toward the Oigut."},{"id":"semetey-1-2013:p0729:b005:l011","ordinal":132233,"en":"Around the jutting mountain's spurs,"},{"id":"semetey-1-2013:p0729:b005:l012","ordinal":132234,"en":"Around its looming promontories,"},{"id":"semetey-1-2013:p0729:b005:l013","ordinal":132235,"en":"Kanykei pursued him."},{"id":"semetey-1-2013:p0729:b005:l014","ordinal":132236,"en":"When they began to climb,"},{"id":"semetey-1-2013:p0729:b005:l015","ordinal":132237,"en":"Warrior Chubak's Kökala"},{"id":"semetey-1-2013:p0729:b005:l016","ordinal":132238,"en":"Spread his mane and tail."},{"id":"semetey-1-2013:p0729:b005:l017","ordinal":132239,"en":"When they reached descending ground,"},{"id":"semetey-1-2013:p0729:b005:l018","ordinal":132240,"en":"Kanykei's black, blaze-faced thoroughbred"},{"id":"semetey-1-2013:p0729:b005:l019","ordinal":132241,"en":"Planted its forelegs like a roe deer."},{"id":"semetey-1-2013:p0729:b005:l020","ordinal":132242,"en":"The earth wheeled and blurred."},{"id":"semetey-1-2013:p0729:b005:l021","ordinal":132243,"en":"Kanykei's thoroughbred,"},{"id":"semetey-1-2013:p0729:b005:l022","ordinal":132244,"en":"Warrior Chubak's Kökala—"},{"id":"semetey-1-2013:p0729:b005:l023","ordinal":132245,"en":"She pressed close, about to catch him."},{"id":"semetey-1-2013:p0729:b005:l024","ordinal":132246,"en":"They became like bride and groom,"},{"id":"semetey-1-2013:p0729:b005:l025","ordinal":132247,"en":"Performing such a spectacle."},{"id":"semetey-1-2013:p0729:b005:l026","ordinal":132248,"en":"Then warrior Chubak's Kökala,"},{"id":"semetey-1-2013:p0729:b005:l027","ordinal":132249,"en":"Steam billowing beneath his forelegs,"},{"id":"semetey-1-2013:p0729:b005:l028","ordinal":132250,"en":"Smoke billowing from his nostrils,"},{"id":"semetey-1-2013:p0729:b005:l029","ordinal":132251,"en":"When he trod upon black stones,"},{"id":"semetey-1-2013:p0729:b005:l030","ordinal":132252,"en":"They crumbled like millet."},{"id":"semetey-1-2013:p0729:b005:l031","ordinal":132253,"en":"His hooves thundered on the ground."},{"id":"semetey-1-2013:p0729:b005:l032","ordinal":132254,"en":"The black-steel bit"},{"id":"semetey-1-2013:p0729:b005:l033","ordinal":132255,"en":"Clattered deep in his mouth."},{"id":"semetey-1-2013:p0729:b005:l034","ordinal":132256,"en":"Kökala beneath him"},{"id":"semetey-1-2013:p0729:b005:l035","ordinal":132257,"en":"Raced with flying birds."},{"id":"semetey-1-2013:p0729:b005:l036","ordinal":132258,"en":"When his body warmed,"},{"id":"semetey-1-2013:p0729:b005:l037","ordinal":132259,"en":"Warrior Chubak upon him"},{"id":"semetey-1-2013:p0729:b005:l038","ordinal":132260,"en":"Struggled to rein him in,"},{"id":"semetey-1-2013:p0729:b005:l039","ordinal":132261,"en":"Kökala, swift as an arrow,"},{"id":"semetey-1-2013:p0730:b003:l001","ordinal":132262,"en":"Flew billowing like a cloud."},{"id":"semetey-1-2013:p0730:b003:l002","ordinal":132263,"en":"Great clods as big as small tents"},{"id":"semetey-1-2013:p0730:b003:l003","ordinal":132264,"en":"Whistled above Chubak's head."},{"id":"semetey-1-2013:p0730:b003:l004","ordinal":132265,"en":"Beyond Andijan,"},{"id":"semetey-1-2013:p0730:b003:l005","ordinal":132266,"en":"Under the arm of Kokand's khan,"},{"id":"semetey-1-2013:p0730:b003:l006","ordinal":132267,"en":"Into the moon-yellow plain,"},{"id":"semetey-1-2013:p0730:b003:l007","ordinal":132268,"en":"When he drove his mount,"},{"id":"semetey-1-2013:p0730:b003:l008","ordinal":132269,"en":"Kanykei was about"},{"id":"semetey-1-2013:p0730:b003:l009","ordinal":132270,"en":"To perform a mighty deed."},{"id":"semetey-1-2013:p0730:b003:l010","ordinal":132271,"en":"Akbalta's Chubak,"},{"id":"semetey-1-2013:p0730:b003:l011","ordinal":132272,"en":"Pursuing him as far as the Oigut,"},{"id":"semetey-1-2013:p0730:b003:l012","ordinal":132273,"en":"She was about to overcome him."},{"id":"semetey-1-2013:p0730:b003:l013","ordinal":132274,"en":"Then Manas, blessed by Khizir, the precious lion,"},{"id":"semetey-1-2013:p0730:b003:l015","ordinal":132275,"en":"And mighty Bakai, those two,"},{"id":"semetey-1-2013:p0730:b003:l016","ordinal":132276,"en":"Chubak, who came fleeing,"},{"id":"semetey-1-2013:p0730:b003:l017","ordinal":132277,"en":"Caught him on the plain."},{"id":"semetey-1-2013:p0730:b003:l018","ordinal":132278,"en":"When Khan Manas caught Chubak,"},{"id":"semetey-1-2013:p0730:b003:l020","ordinal":132279,"en":"Kanykei, who had heard of him,"},{"id":"semetey-1-2013:p0730:b003:l022","ordinal":132280,"en":"Knowing that he had come to Manas,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0730:b003:l023","ordinal":132281,"en":"Turned back and darted away."},{"id":"semetey-1-2013:p0730:b003:l024","ordinal":132282,"en":"Wise, unfortunate Kanykei"},{"id":"semetey-1-2013:p0730:b003:l025","ordinal":132283,"en":"Darted toward Bukhara."},{"id":"semetey-1-2013:p0730:b003:l027","ordinal":132284,"en":"Kanykei openly fled and escaped.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0730:b003:l028","ordinal":132285,"en":"Bakai and warrior Manas"},{"id":"semetey-1-2013:p0730:b003:l029","ordinal":132286,"en":"Had caught Chubak."},{"id":"semetey-1-2013:p0730:b003:l030","ordinal":132287,"en":"They chewed white wheat flour,"},{"id":"semetey-1-2013:p0730:b003:l031","ordinal":132288,"en":"Held to the sacred profession of faith,"},{"id":"semetey-1-2013:p0730:b003:l032","ordinal":132289,"en":"Made an oath binding unto death,"},{"id":"semetey-1-2013:p0730:b003:l033","ordinal":132290,"en":"Confirmed their pledge."},{"id":"semetey-1-2013:p0730:b003:l034","ordinal":132291,"en":"They dismounted upon the plain,"},{"id":"semetey-1-2013:p0730:b003:l035","ordinal":132292,"en":"A flask of liquor between them,"},{"id":"semetey-1-2013:p0730:b003:l036","ordinal":132293,"en":"Swore an oath and drank."},{"id":"semetey-1-2013:p0730:b003:l037","ordinal":132294,"en":"He came and settled in Talas,"},{"id":"semetey-1-2013:p0730:b003:l038","ordinal":132295,"en":"Became Manas's companion."},{"id":"semetey-1-2013:p0730:b003:l039","ordinal":132296,"en":"Your sheep together in one fold,"},{"id":"semetey-1-2013:p0730:b004:l001","ordinal":132297,"en":"Your food shared in fellowship—"},{"id":"semetey-1-2013:p0730:b004:l002","ordinal":132298,"en":"Is my lion Chubak safe?!"},{"id":"semetey-1-2013:p0730:b004:l003","ordinal":132299,"en":"All forty companions,"},{"id":"semetey-1-2013:p0730:b004:l004","ordinal":132300,"en":"With old Kyrgyl at their head,"},{"id":"semetey-1-2013:p0730:b004:l005","ordinal":132301,"en":"Argin Khan's Ajybai,"},{"id":"semetey-1-2013:p0730:b004:l006","ordinal":132302,"en":"Warrior Shuutu, with a cap like a yurt covering,"},{"id":"semetey-1-2013:p0730:b004:l007","ordinal":132303,"en":"Yraman's singer son,"},{"id":"semetey-1-2013:p0730:b004:l008","ordinal":132304,"en":"Strong-armed Baichoro—"},{"id":"semetey-1-2013:p0730:b004:l009","ordinal":132305,"en":"Alas, is Bozuul safe?"},{"id":"semetey-1-2013:p0730:b004:l010","ordinal":132306,"en":"The ones to whom I turned fond thoughts,"},{"id":"semetey-1-2013:p0730:b004:l011","ordinal":132307,"en":"Whom I loved more than Manas,"},{"id":"semetey-1-2013:p0730:b004:l012","ordinal":132308,"en":"Warrior elder, hear my words!"},{"id":"semetey-1-2013:p0730:b004:l013","ordinal":132309,"en":"Are all forty champions safe?!"},{"id":"semetey-1-2013:p0730:b004:l014","ordinal":132310,"en":"So many days since I went,"},{"id":"semetey-1-2013:p0730:b004:l015","ordinal":132311,"en":"So many years since I left!"},{"id":"semetey-1-2013:p0730:b004:l016","ordinal":132312,"en":"Jarmanas, to whom you gave me,"},{"id":"semetey-1-2013:p0730:b004:l017","ordinal":132313,"en":"Was the giant of that wicked people."},{"id":"semetey-1-2013:p0730:b004:l018","ordinal":132314,"en":"Your younger sister Kardygach"},{"id":"semetey-1-2013:p0730:b004:l019","ordinal":132315,"en":"Became ruler of the multitude."},{"id":"semetey-1-2013:p0730:b004:l020","ordinal":132316,"en":"Gathering harriers, making them hawks,"},{"id":"semetey-1-2013:p0730:b004:l021","ordinal":132317,"en":"Gathering scattered folk, making them a people,"},{"id":"semetey-1-2013:p0730:b004:l022","ordinal":132318,"en":"Rearing fostered birds, making them hawks,"},{"id":"semetey-1-2013:p0730:b004:l023","ordinal":132319,"en":"Gathering wanderers, making them a people,"},{"id":"semetey-1-2013:p0730:b004:l024","ordinal":132320,"en":"Keeping a court, becoming a khan,"},{"id":"semetey-1-2013:p0730:b004:l025","ordinal":132321,"en":"Becoming like a saint,"},{"id":"semetey-1-2013:p0730:b004:l026","ordinal":132322,"en":"Gathering people from every place,"},{"id":"semetey-1-2013:p0730:b004:l027","ordinal":132323,"en":"While I was worn with toil,"},{"id":"semetey-1-2013:p0730:b004:l028","ordinal":132324,"en":"The giants Kökdöö and Akdöö appeared."},{"id":"semetey-1-2013:p0730:b004:l029","ordinal":132325,"en":"No horse could bear them; they came on foot."},{"id":"semetey-1-2013:p0730:b004:l030","ordinal":132326,"en":"Dust rose from their walking;"},{"id":"semetey-1-2013:p0730:b004:l031","ordinal":132327,"en":"Their voices made souls depart."},{"id":"semetey-1-2013:p0730:b004:l032","ordinal":132328,"en":"With pinewood spears bound together,"},{"id":"semetey-1-2013:p0730:b004:l033","ordinal":132329,"en":"In the lowlands of Jelpinish,"},{"id":"semetey-1-2013:p0730:b004:l034","ordinal":132330,"en":"For seven years we waged unceasing war."},{"id":"semetey-1-2013:p0730:b004:l035","ordinal":132331,"en":"In conflict I could not overcome them;"},{"id":"semetey-1-2013:p0730:b004:l036","ordinal":132332,"en":"In struggle my strength did not suffice."},{"id":"semetey-1-2013:p0730:b004:l037","ordinal":132333,"en":"For six months I traveled without rest,"},{"id":"semetey-1-2013:p0730:b004:l038","ordinal":132334,"en":"Sparing no horse, traveling far."},{"id":"semetey-1-2013:p0730:b004:l039","ordinal":132335,"en":"My preserved provisions ran out,"},{"id":"semetey-1-2013:p0731:b003:l001","ordinal":132336,"en":"I came eating my saddle straps."},{"id":"semetey-1-2013:p0731:b003:l002","ordinal":132337,"en":"My nest-mate, Khan Manas,"},{"id":"semetey-1-2013:p0731:b003:l003","ordinal":132338,"en":"I came hoping he would give me an army."},{"id":"semetey-1-2013:p0731:b003:l004","ordinal":132339,"en":"With Almambet and Chubak at its head,"},{"id":"semetey-1-2013:p0731:b003:l005","ordinal":132340,"en":"I came hoping he would give generously."},{"id":"semetey-1-2013:p0731:b003:l006","ordinal":132341,"en":"Ajybai and Bakai, the paired warriors,"},{"id":"semetey-1-2013:p0731:b003:l007","ordinal":132342,"en":"I came hoping he would give me both."},{"id":"semetey-1-2013:p0731:b003:l008","ordinal":132343,"en":"Syrgak and Sergek, ocean-like warriors,"},{"id":"semetey-1-2013:p0731:b003:l009","ordinal":132344,"en":"I came hoping he would give them all."},{"id":"semetey-1-2013:p0731:b003:l010","ordinal":132345,"en":"Wearing out my horse, to the courser,"},{"id":"semetey-1-2013:p0731:b003:l011","ordinal":132346,"en":"I came hoping for help."},{"id":"semetey-1-2013:p0731:b003:l012","ordinal":132347,"en":"To my auspicious kinsman Manas,"},{"id":"semetey-1-2013:p0731:b003:l013","ordinal":132348,"en":"Who kindles an extinguished fire,"},{"id":"semetey-1-2013:p0731:b003:l014","ordinal":132349,"en":"Who restores a dead soul to life—"},{"id":"semetey-1-2013:p0731:b003:l015","ordinal":132350,"en":"I am bending beneath my burden;"},{"id":"semetey-1-2013:p0731:b003:l016","ordinal":132351,"en":"I came hoping he would support me."},{"id":"semetey-1-2013:p0731:b003:l017","ordinal":132352,"en":"Restoring a dead soul to life,"}]
