[{"id":"semetey-1-2013:p1025:b003:l025","ordinal":154369,"en":"And focused it upon his eye."},{"id":"semetey-1-2013:p1025:b003:l026","ordinal":154370,"en":"When he turned the wheel,"},{"id":"semetey-1-2013:p1025:b003:l027","ordinal":154371,"en":"That wondrous spyglass"},{"id":"semetey-1-2013:p1025:b003:l028","ordinal":154372,"en":"Divided its lens into six,"},{"id":"semetey-1-2013:p1025:b003:l029","ordinal":154373,"en":"And a road six days distant"},{"id":"semetey-1-2013:p1025:b003:l030","ordinal":154374,"en":"Appeared clearly, without distortion."},{"id":"semetey-1-2013:p1025:b003:l031","ordinal":154375,"en":"Its lens was made of precious stone;"},{"id":"semetey-1-2013:p1025:b003:l032","ordinal":154376,"en":"When he turned it to its full extent,"},{"id":"semetey-1-2013:p1025:b003:l033","ordinal":154377,"en":"It divided into seven parts,"},{"id":"semetey-1-2013:p1025:b003:l034","ordinal":154378,"en":"And a road seven days distant"},{"id":"semetey-1-2013:p1025:b003:l035","ordinal":154379,"en":"Appeared as close as seven rope-lengths."},{"id":"semetey-1-2013:p1025:b003:l036","ordinal":154380,"en":"The great and precious spyglass"},{"id":"semetey-1-2013:p1025:b003:l037","ordinal":154381,"en":"Was wound with gold inside;"},{"id":"semetey-1-2013:p1025:b003:l038","ordinal":154382,"en":"Master caster Bolokbai"},{"id":"semetey-1-2013:p1025:b003:l039","ordinal":154383,"en":"Had repaired every damaged place."},{"id":"semetey-1-2013:p1025:b005:l001","ordinal":154384,"en":"The lion grew furious,"},{"id":"semetey-1-2013:p1025:b005:l002","ordinal":154385,"en":"Turned its wheel,"},{"id":"semetey-1-2013:p1025:b005:l003","ordinal":154386,"en":"And set it squarely to his eye."},{"id":"semetey-1-2013:p1025:b005:l004","ordinal":154387,"en":"Beside the flowing river,"},{"id":"semetey-1-2013:p1025:b005:l005","ordinal":154388,"en":"Across the plain of Great Opol,"},{"id":"semetey-1-2013:p1025:b005:l006","ordinal":154389,"en":"The lion, the son of Manas,"},{"id":"semetey-1-2013:p1025:b005:l007","ordinal":154390,"en":"Looked through the spyglass."},{"id":"semetey-1-2013:p1025:b005:l008","ordinal":154391,"en":"Without being consumed by grief or worry,"},{"id":"semetey-1-2013:p1025:b005:l009","ordinal":154392,"en":"Without saying, \"My uncle stands"},{"id":"semetey-1-2013:p1025:b005:l010","ordinal":154393,"en":"Stranded behind me,\""},{"id":"semetey-1-2013:p1025:b005:l026","ordinal":154394,"en":"Thirty brides and thirty maidens,","gapBefore":"[Passage withheld: sexual content involving a minor]"},{"id":"semetey-1-2013:p1025:b005:l027","ordinal":154395,"en":"The immoderate Churok, and the boy—"},{"id":"semetey-1-2013:p1025:b005:l028","ordinal":154396,"en":"All of them, struck with amazement,"},{"id":"semetey-1-2013:p1025:b005:l029","ordinal":154397,"en":"Had gathered around him;"},{"id":"semetey-1-2013:p1025:b005:l030","ordinal":154398,"en":"Look at their fawning attention:"},{"id":"semetey-1-2013:p1025:b005:l031","ordinal":154399,"en":"They had encircled him."},{"id":"semetey-1-2013:p1025:b005:l032","ordinal":154400,"en":"Seeing this, Semetey thought:"},{"id":"semetey-1-2013:p1025:b005:l033","ordinal":154401,"en":"\"When he reaches his full maturity,"},{"id":"semetey-1-2013:p1025:b005:l034","ordinal":154402,"en":"He will surely conquer a mighty realm;"},{"id":"semetey-1-2013:p1025:b005:l035","ordinal":154403,"en":"When he grows into a true man,"},{"id":"semetey-1-2013:p1025:b005:l036","ordinal":154404,"en":"When he equals the sons of heroes,"},{"id":"semetey-1-2013:p1025:b005:l037","ordinal":154405,"en":"He will indeed show me"},{"id":"semetey-1-2013:p1025:b005:l038","ordinal":154406,"en":"Marvels beyond imagining!"},{"id":"semetey-1-2013:p1025:b005:l039","ordinal":154407,"en":"If this boy remains alive,"}]
