[{"id":"seytek-2012:p0144:b002:l039","ordinal":304897,"en":"Ulukman lost the lion,"},{"id":"seytek-2012:p0144:b002:l040","ordinal":304898,"en":"We are crazy,"},{"id":"seytek-2012:p0144:b003:l001","ordinal":304899,"en":"Choro without a beak"},{"id":"seytek-2012:p0144:b003:l002","ordinal":304900,"en":"The pain does not go away,"},{"id":"seytek-2012:p0144:b003:l003","ordinal":304901,"en":"Eyes wide open,"},{"id":"seytek-2012:p0144:b003:l004","ordinal":304902,"en":"If you think about it, don't write it down,"},{"id":"seytek-2012:p0144:b003:l005","ordinal":304903,"en":"It was when he was sick."},{"id":"seytek-2012:p0144:b003:l006","ordinal":304904,"en":"When Choro is sick"},{"id":"seytek-2012:p0144:b003:l007","ordinal":304905,"en":"The Black Giant went to the news:"},{"id":"seytek-2012:p0144:b003:l008","ordinal":304906,"en":"\"Greetings from Salao"},{"id":"seytek-2012:p0144:b003:l009","ordinal":304907,"en":"I'm crazy"},{"id":"seytek-2012:p0144:b003:l010","ordinal":304908,"en":"Humanity is a slave"},{"id":"seytek-2012:p0144:b003:l011","ordinal":304909,"en":"My husband, who cannot be found,"},{"id":"seytek-2012:p0144:b003:l012","ordinal":304910,"en":"To cure the disease"},{"id":"seytek-2012:p0144:b003:l013","ordinal":304911,"en":"I brought a reason - said,"},{"id":"seytek-2012:p0144:b003:l014","ordinal":304912,"en":"Blood father's confidant,"},{"id":"seytek-2012:p0144:b003:l015","ordinal":304913,"en":"Your uncle's friend"},{"id":"seytek-2012:p0144:b003:l016","ordinal":304914,"en":"Standing at the base of the flag,"},{"id":"seytek-2012:p0144:b003:l017","ordinal":304915,"en":"Healer of disease,"},{"id":"seytek-2012:p0144:b003:l018","ordinal":304916,"en":"Ayash, your father is Kyzylsart"},{"id":"seytek-2012:p0144:b003:l019","ordinal":304917,"en":"I brought it now,"},{"id":"seytek-2012:p0144:b003:l020","ordinal":304918,"en":"The blue of your wish,"},{"id":"seytek-2012:p0144:b003:l021","ordinal":304919,"en":"I gave it to you,"},{"id":"seytek-2012:p0144:b003:l022","ordinal":304920,"en":"The black giant was coming,"},{"id":"seytek-2012:p0144:b003:l023","ordinal":304921,"en":"Sixty wrestlers, Kyzylsart,"},{"id":"seytek-2012:p0144:b003:l024","ordinal":304922,"en":"Unable to dismount"},{"id":"seytek-2012:p0144:b003:l025","ordinal":304923,"en":"Fight like a lion"},{"id":"seytek-2012:p0144:b003:l026","ordinal":304924,"en":"Some six thousand red camels,"},{"id":"seytek-2012:p0144:b003:l027","ordinal":304925,"en":"He multiplies the red camels."},{"id":"seytek-2012:p0144:b003:l028","ordinal":304926,"en":"It has red gold undertones,"},{"id":"seytek-2012:p0144:b003:l029","ordinal":304927,"en":"Doomsday has gone blue"},{"id":"seytek-2012:p0144:b003:l030","ordinal":304928,"en":"There is a decreasing rate."},{"id":"seytek-2012:p0144:b003:l031","ordinal":304929,"en":"There are about sixty souls,"},{"id":"seytek-2012:p0144:b003:l032","ordinal":304930,"en":"All from a wrestler."},{"id":"seytek-2012:p0144:b003:l033","ordinal":304931,"en":"Unable to dismount"},{"id":"seytek-2012:p0144:b003:l034","ordinal":304932,"en":"It's a dark place"},{"id":"seytek-2012:p0144:b003:l035","ordinal":304933,"en":"All of them got into the dirt."},{"id":"seytek-2012:p0144:b003:l036","ordinal":304934,"en":"When you see Külchoro"},{"id":"seytek-2012:p0144:b003:l037","ordinal":304935,"en":"Bending the joint loosely,"},{"id":"seytek-2012:p0144:b003:l038","ordinal":304936,"en":"Kyzylsart is made of steam."},{"id":"seytek-2012:p0144:b003:l039","ordinal":304937,"en":"Screaming and running."},{"id":"seytek-2012:p0144:b003:l040","ordinal":304938,"en":"Kyzylsart was crying"},{"id":"seytek-2012:p0145:b002:l001","ordinal":304939,"en":"He alone was the healer,"},{"id":"seytek-2012:p0145:b002:l002","ordinal":304940,"en":"He had keen black eyes,"},{"id":"seytek-2012:p0145:b002:l003","ordinal":304941,"en":"In Kyzylsart’s own keeping"},{"id":"seytek-2012:p0145:b002:l004","ordinal":304942,"en":"There was a compound red medicine,"},{"id":"seytek-2012:p0145:b002:l005","ordinal":304943,"en":"He had every kind of remedy."},{"id":"seytek-2012:p0145:b002:l006","ordinal":304944,"en":"He had searched great Baghdad,"},{"id":"seytek-2012:p0145:b002:l007","ordinal":304945,"en":"And from a deserted place obtained"},{"id":"seytek-2012:p0145:b002:l008","ordinal":304946,"en":"A medicine called matchless."},{"id":"seytek-2012:p0145:b002:l009","ordinal":304947,"en":"He had searched great Egypt,"},{"id":"seytek-2012:p0145:b002:l010","ordinal":304948,"en":"And the potent medicine"},{"id":"seytek-2012:p0145:b002:l011","ordinal":304949,"en":"He had obtained from there."},{"id":"seytek-2012:p0145:b002:l012","ordinal":304950,"en":"With one dose of his medicine,"},{"id":"seytek-2012:p0145:b002:l013","ordinal":304951,"en":"The pain subsided."},{"id":"seytek-2012:p0145:b002:l014","ordinal":304952,"en":"With one dose of the remedy,"},{"id":"seytek-2012:p0145:b002:l015","ordinal":304953,"en":"The eyes opened wide."},{"id":"seytek-2012:p0145:b002:l016","ordinal":304954,"en":"Of those potent medicines,"},{"id":"seytek-2012:p0145:b002:l017","ordinal":304955,"en":"Of all his remedies,"},{"id":"seytek-2012:p0145:b002:l018","ordinal":304956,"en":"Even one that could stave off death,"},{"id":"seytek-2012:p0145:b002:l019","ordinal":304957,"en":"From the black heart of medicine,"},{"id":"seytek-2012:p0145:b002:l020","ordinal":304958,"en":"Kyzylsart spared no effort"},{"id":"seytek-2012:p0145:b002:l021","ordinal":304959,"en":"And carefully applied the cure,"},{"id":"seytek-2012:p0145:b002:l022","ordinal":304960,"en":"But here the medicine did no good,"},{"id":"seytek-2012:p0145:b002:l023","ordinal":304961,"en":"And Choro did not recover."},{"id":"seytek-2012:p0145:b002:l024","ordinal":304962,"en":"Grieving in all sincerity,"},{"id":"seytek-2012:p0145:b002:l025","ordinal":304963,"en":"Despairing of his fly-like life,"},{"id":"seytek-2012:p0145:b002:l026","ordinal":304964,"en":"Choro burned with humiliation,"},{"id":"seytek-2012:p0145:b002:l027","ordinal":304965,"en":"And despaired of his entrusted life."},{"id":"seytek-2012:p0145:b002:l028","ordinal":304966,"en":"As Choro stood there thus,"},{"id":"seytek-2012:p0145:b002:l029","ordinal":304967,"en":"Your foster-father Kyzylsart"},{"id":"seytek-2012:p0145:b002:l030","ordinal":304968,"en":"Was himself the healer,"},{"id":"seytek-2012:p0145:b002:l031","ordinal":304969,"en":"A keen and careful eye,"},{"id":"seytek-2012:p0145:b002:l032","ordinal":304970,"en":"Weighing thoughts and shaping words,"},{"id":"seytek-2012:p0145:b002:l033","ordinal":304971,"en":"He also had discernment,"},{"id":"seytek-2012:p0145:b002:l034","ordinal":304972,"en":"A remedy for every illness,"},{"id":"seytek-2012:p0145:b002:l035","ordinal":304973,"en":"And he also had resourcefulness."},{"id":"seytek-2012:p0145:b002:l036","ordinal":304974,"en":"When the sun sank shimmering,"},{"id":"seytek-2012:p0145:b002:l037","ordinal":304975,"en":"When the foremost of the people lay down,"},{"id":"seytek-2012:p0145:b002:l038","ordinal":304976,"en":"A blue mastiff with a leather-capped head,"},{"id":"seytek-2012:p0145:b002:l039","ordinal":304977,"en":"A dog left behind by the gray wolf,"},{"id":"seytek-2012:p0145:b002:l040","ordinal":304978,"en":"Howled and whimpered in grief."},{"id":"seytek-2012:p0145:b003:l001","ordinal":304979,"en":"Parted from the magnanimous lion,"},{"id":"seytek-2012:p0145:b003:l002","ordinal":304980,"en":"We stand here powerless."},{"id":"seytek-2012:p0145:b003:l003","ordinal":304981,"en":"While my lion-hearted uncle lived,"},{"id":"seytek-2012:p0145:b003:l004","ordinal":304982,"en":"We grew to manhood as lions."},{"id":"seytek-2012:p0145:b003:l005","ordinal":304983,"en":"After my uncle Semetey passed away,"},{"id":"seytek-2012:p0145:b003:l006","ordinal":304984,"en":"We who were white steel became notched,"},{"id":"seytek-2012:p0145:b003:l007","ordinal":304985,"en":"We who were heroes fell into sorrow,"},{"id":"seytek-2012:p0145:b003:l008","ordinal":304986,"en":"We were parted from the renowned lion."},{"id":"seytek-2012:p0145:b003:l009","ordinal":304987,"en":"Foster-father Kyzylsart,"},{"id":"seytek-2012:p0145:b003:l010","ordinal":304988,"en":"Our backs made sore, to Kyyaz"},{"id":"seytek-2012:p0145:b003:l011","ordinal":304989,"en":"We came as docile pacers."},{"id":"seytek-2012:p0145:b003:l012","ordinal":304990,"en":"Parted from our good fortune,"},{"id":"seytek-2012:p0145:b003:l013","ordinal":304991,"en":"In Jeti-Özön, among the Jediger,"},{"id":"seytek-2012:p0145:b003:l014","ordinal":304992,"en":"To Kyyaz, son of Bagysh,"},{"id":"seytek-2012:p0145:b003:l015","ordinal":304993,"en":"We came as spoils of war."},{"id":"seytek-2012:p0145:b003:l016","ordinal":304994,"en":"Our herds were plundered,"},{"id":"seytek-2012:p0145:b003:l017","ordinal":304995,"en":"Our blood was utterly drained,"},{"id":"seytek-2012:p0145:b003:l018","ordinal":304996,"en":"Separated from the six divisions,"},{"id":"seytek-2012:p0145:b003:l019","ordinal":304997,"en":"Our strength departed long ago."},{"id":"seytek-2012:p0145:b003:l020","ordinal":304998,"en":"I bear a deep-dug wound,"},{"id":"seytek-2012:p0145:b003:l021","ordinal":304999,"en":"I bear a vast, seething misery."},{"id":"seytek-2012:p0145:b003:l022","ordinal":305000,"en":"Longing to die, I cannot die,"},{"id":"seytek-2012:p0145:b003:l023","ordinal":305001,"en":"Yet cannot take my own life."},{"id":"seytek-2012:p0145:b003:l024","ordinal":305002,"en":"Our herds were given over to plunder,"},{"id":"seytek-2012:p0145:b003:l025","ordinal":305003,"en":"Barely a spoonful of blood remains."},{"id":"seytek-2012:p0145:b003:l026","ordinal":305004,"en":"I am fading away."},{"id":"seytek-2012:p0145:b003:l027","ordinal":305005,"en":"Foster-father Kyzylsart,"},{"id":"seytek-2012:p0145:b003:l028","ordinal":305006,"en":"Please take us as your companions."},{"id":"seytek-2012:p0145:b003:l029","ordinal":305007,"en":"The stars in heaven have turned pale,"},{"id":"seytek-2012:p0145:b003:l030","ordinal":305008,"en":"My father was your old friend."},{"id":"seytek-2012:p0145:b003:l031","ordinal":305009,"en":"I am frozen by the cold—give me your coat;"},{"id":"seytek-2012:p0145:b003:l032","ordinal":305010,"en":"I beg you with both hands outstretched."},{"id":"seytek-2012:p0145:b003:l033","ordinal":305011,"en":"My strength is gone—give me your medicine,"},{"id":"seytek-2012:p0145:b003:l034","ordinal":305012,"en":"O noble, khanly father,"},{"id":"seytek-2012:p0145:b003:l035","ordinal":305013,"en":"Give me all your remedies."},{"id":"seytek-2012:p0145:b003:l036","ordinal":305014,"en":"I beg you, father, grant me your best;"},{"id":"seytek-2012:p0145:b003:l037","ordinal":305015,"en":"Give me your hand and do not abandon me.”"},{"id":"seytek-2012:p0145:b003:l038","ordinal":305016,"en":"Thus did Külchoro"},{"id":"seytek-2012:p0145:b003:l039","ordinal":305017,"en":"Speak in his wretchedness, and then"},{"id":"seytek-2012:p0145:b003:l040","ordinal":305018,"en":"His foster-father Kyzylsart—"},{"id":"seytek-2012:p0146:b002:l001","ordinal":305019,"en":"Finding no head he could tear off,"},{"id":"seytek-2012:p0146:b002:l002","ordinal":305020,"en":"His courage like a sheer mountain ridge,"},{"id":"seytek-2012:p0146:b002:l003","ordinal":305021,"en":"The formidable Külchoro"},{"id":"seytek-2012:p0146:b002:l004","ordinal":305022,"en":"Seemed able to devour any man he grappled."},{"id":"seytek-2012:p0146:b002:l005","ordinal":305023,"en":"At Choro’s terrible bearing,"},{"id":"seytek-2012:p0146:b002:l006","ordinal":305024,"en":"All the Jediger might flee."},{"id":"seytek-2012:p0146:b002:l007","ordinal":305025,"en":"If seven hosts of alien foes came,"},{"id":"seytek-2012:p0146:b002:l008","ordinal":305026,"en":"He alone could crush them."},{"id":"seytek-2012:p0146:b002:l009","ordinal":305027,"en":"The hot breath from his mouth"},{"id":"seytek-2012:p0146:b002:l010","ordinal":305028,"en":"Seemed able to set the valley aflame."},{"id":"seytek-2012:p0146:b002:l011","ordinal":305029,"en":"If he merely stirred,"},{"id":"seytek-2012:p0146:b002:l012","ordinal":305030,"en":"He seemed able to ravage the world."},{"id":"seytek-2012:p0146:b002:l013","ordinal":305031,"en":"Broad-hearted as a valley,"},{"id":"seytek-2012:p0146:b002:l014","ordinal":305032,"en":"His handsome front teeth"},{"id":"seytek-2012:p0146:b002:l015","ordinal":305033,"en":"Were like tempered steel."},{"id":"seytek-2012:p0146:b002:l016","ordinal":305034,"en":"When you looked at his aquiline nose,"},{"id":"seytek-2012:p0146:b002:l017","ordinal":305035,"en":"It was like the sheath of a saber."},{"id":"seytek-2012:p0146:b002:l018","ordinal":305036,"en":"His upturned mustache"},{"id":"seytek-2012:p0146:b002:l019","ordinal":305037,"en":"Was like a Bukharan blade."},{"id":"seytek-2012:p0146:b002:l020","ordinal":305038,"en":"The heat of his two eyes"},{"id":"seytek-2012:p0146:b002:l021","ordinal":305039,"en":"Was like flame rising through a valley."},{"id":"seytek-2012:p0146:b002:l022","ordinal":305040,"en":"When you looked into their corners,"},{"id":"seytek-2012:p0146:b002:l023","ordinal":305041,"en":"They were like the hollows of dried-up wells."},{"id":"seytek-2012:p0146:b002:l024","ordinal":305042,"en":"When that formidable man moved,"},{"id":"seytek-2012:p0146:b002:l025","ordinal":305043,"en":"He seemed able to swallow the world."},{"id":"seytek-2012:p0146:b002:l026","ordinal":305044,"en":"Recovering from his broken state,"},{"id":"seytek-2012:p0146:b002:l027","ordinal":305045,"en":"Choro became a bloodthirsty warrior again."},{"id":"seytek-2012:p0146:b002:l028","ordinal":305046,"en":"His former vigor"},{"id":"seytek-2012:p0146:b002:l029","ordinal":305047,"en":"Filled him like a bloated blue tick,"},{"id":"seytek-2012:p0146:b002:l030","ordinal":305048,"en":"And his wolfish valor and heroism"},{"id":"seytek-2012:p0146:b002:l031","ordinal":305049,"en":"Were as they had been before."},{"id":"seytek-2012:p0146:b002:l032","ordinal":305050,"en":"The awe-inspiring poor falcon’s"},{"id":"seytek-2012:p0146:b002:l033","ordinal":305051,"en":"Hollows filled with milk,"},{"id":"seytek-2012:p0146:b002:l034","ordinal":305052,"en":"His gaunt frame filled with flesh,"},{"id":"seytek-2012:p0146:b002:l035","ordinal":305053,"en":"And the time came for him to fight."},{"id":"seytek-2012:p0146:b002:l036","ordinal":305054,"en":"With Kyyaz, son of Bagysh,"},{"id":"seytek-2012:p0146:b002:l037","ordinal":305055,"en":"The time came for him to meet face-to-face."},{"id":"seytek-2012:p0146:b002:l038","ordinal":305056,"en":"His figure was like half a mountain,"},{"id":"seytek-2012:p0146:b002:l039","ordinal":305057,"en":"Ready to devour any soul he met."},{"id":"seytek-2012:p0146:b002:l040","ordinal":305058,"en":"Külchoro, upheld by the divine,"},{"id":"seytek-2012:p0146:b003:l001","ordinal":305059,"en":"Used Choro as his pretext,"},{"id":"seytek-2012:p0146:b003:l002","ordinal":305060,"en":"And the poor fellow followed him about."},{"id":"seytek-2012:p0146:b003:l003","ordinal":305061,"en":"The blue mastiff left by the hero—"},{"id":"seytek-2012:p0146:b003:l004","ordinal":305062,"en":"Kyzylsart suddenly seized it"},{"id":"seytek-2012:p0146:b003:l005","ordinal":305063,"en":"And slaughtered the blue mastiff."},{"id":"seytek-2012:p0146:b003:l006","ordinal":305064,"en":"Cutting out its diaphragm,"},{"id":"seytek-2012:p0146:b003:l007","ordinal":305065,"en":"He laid it upon Külchoro."},{"id":"seytek-2012:p0146:b003:l008","ordinal":305066,"en":"Kyzylsart was meticulous,"},{"id":"seytek-2012:p0146:b003:l009","ordinal":305067,"en":"Skillful in devising strange measures."},{"id":"seytek-2012:p0146:b003:l010","ordinal":305068,"en":"Upon Külchoro’s back"},{"id":"seytek-2012:p0146:b003:l011","ordinal":305069,"en":"He fitted the dog’s diaphragm,"},{"id":"seytek-2012:p0146:b003:l012","ordinal":305070,"en":"And the powdered red medicine"},{"id":"seytek-2012:p0146:b003:l013","ordinal":305071,"en":"He rubbed on forty times."},{"id":"seytek-2012:p0146:b003:l014","ordinal":305072,"en":"The boiled black medicine"},{"id":"seytek-2012:p0146:b003:l015","ordinal":305073,"en":"He rubbed on time after time."},{"id":"seytek-2012:p0146:b003:l016","ordinal":305074,"en":"Then the poor father Choro’s"},{"id":"seytek-2012:p0146:b003:l017","ordinal":305075,"en":"Painful places subsided,"},{"id":"seytek-2012:p0146:b003:l018","ordinal":305076,"en":"His eyes opened wide,"},{"id":"seytek-2012:p0146:b003:l019","ordinal":305077,"en":"Blood coursed through his body,"},{"id":"seytek-2012:p0146:b003:l020","ordinal":305078,"en":"And the day came when his courage swelled."},{"id":"seytek-2012:p0146:b003:l021","ordinal":305079,"en":"The moon waned and the nights passed,"},{"id":"seytek-2012:p0146:b003:l022","ordinal":305080,"en":"And many days went by."},{"id":"seytek-2012:p0146:b003:l023","ordinal":305081,"en":"Vigor seethed and strength filled him,"},{"id":"seytek-2012:p0146:b003:l024","ordinal":305082,"en":"Power welled up within him."},{"id":"seytek-2012:p0146:b003:l025","ordinal":305083,"en":"The days passed as though he lay in comfort,"},{"id":"seytek-2012:p0146:b003:l026","ordinal":305084,"en":"And all he saw was like the Night of Glory."},{"id":"seytek-2012:p0146:b003:l027","ordinal":305085,"en":"His loosened joints were restored,"},{"id":"seytek-2012:p0146:b003:l028","ordinal":305086,"en":"And all his sorrow disappeared."},{"id":"seytek-2012:p0146:b003:l029","ordinal":305087,"en":"His thoughts became a night of blessed destiny,"},{"id":"seytek-2012:p0146:b003:l030","ordinal":305088,"en":"And the spirited youth and swift horse"},{"id":"seytek-2012:p0146:b003:l031","ordinal":305089,"en":"Came to the day their worth was fulfilled."},{"id":"seytek-2012:p0146:b003:l032","ordinal":305090,"en":"It was then that Külchoro"},{"id":"seytek-2012:p0146:b003:l033","ordinal":305091,"en":"Returned to himself and recovered."},{"id":"seytek-2012:p0146:b003:l034","ordinal":305092,"en":"Kyzylsart had been his healer,"},{"id":"seytek-2012:p0146:b003:l035","ordinal":305093,"en":"And all his affliction disappeared."},{"id":"seytek-2012:p0146:b003:l036","ordinal":305094,"en":"His courage rose and strength filled him."},{"id":"seytek-2012:p0146:b003:l037","ordinal":305095,"en":"Think of Choro now:"},{"id":"seytek-2012:p0146:b003:l038","ordinal":305096,"en":"He could find no mountain to strike,"},{"id":"seytek-2012:p0146:b003:l039","ordinal":305097,"en":"No enemy to fight,"},{"id":"seytek-2012:p0146:b003:l040","ordinal":305098,"en":"No stone to chew."},{"id":"seytek-2012:p0147:b002:l001","ordinal":305099,"en":"You girded your appointed belt,"},{"id":"seytek-2012:p0147:b002:l002","ordinal":305100,"en":"And raised turmoil against all who faced you."},{"id":"seytek-2012:p0147:b002:l003","ordinal":305101,"en":"You besieged the Khagan and took his lands,"},{"id":"seytek-2012:p0147:b002:l004","ordinal":305102,"en":"And conquered the populous Chinese realm"},{"id":"seytek-2012:p0147:b002:l005","ordinal":305103,"en":"That even the Prophet could not have entered."},{"id":"seytek-2012:p0147:b002:l006","ordinal":305104,"en":"You reached it, broke it, and took the land;"},{"id":"seytek-2012:p0147:b002:l007","ordinal":305105,"en":"O hero, you shattered Jerken and attacked it."},{"id":"seytek-2012:p0147:b002:l008","ordinal":305106,"en":"While you were in your prime,"},{"id":"seytek-2012:p0147:b002:l009","ordinal":305107,"en":"You raided Jet-Kait and took booty."},{"id":"seytek-2012:p0147:b002:l010","ordinal":305108,"en":"You routed the myriad host and leveled it."},{"id":"seytek-2012:p0147:b002:l011","ordinal":305109,"en":"Kara-Shaar and Kambyl"},{"id":"seytek-2012:p0147:b002:l012","ordinal":305110,"en":"You besieged, subdued, and opened as a road."},{"id":"seytek-2012:p0147:b002:l013","ordinal":305111,"en":"Solon, Shive, and Manchu"},{"id":"seytek-2012:p0147:b002:l014","ordinal":305112,"en":"You beat like wool and brought low."},{"id":"seytek-2012:p0147:b002:l015","ordinal":305113,"en":"You leveled them with your inlaid spear,"},{"id":"seytek-2012:p0147:b002:l016","ordinal":305114,"en":"And while your lion lived,"},{"id":"seytek-2012:p0147:b002:l017","ordinal":305115,"en":"You made the people suffer and ruled them."},{"id":"seytek-2012:p0147:b002:l018","ordinal":305116,"en":"Your might became known."},{"id":"seytek-2012:p0147:b002:l019","ordinal":305117,"en":"One of your names was inscribed"},{"id":"seytek-2012:p0147:b002:l020","ordinal":305118,"en":"In the records of Beijing."},{"id":"seytek-2012:p0147:b002:l021","ordinal":305119,"en":"While your noble prince lived,"},{"id":"seytek-2012:p0147:b002:l022","ordinal":305120,"en":"You drove white deer and made them cattle."},{"id":"seytek-2012:p0147:b002:l023","ordinal":305121,"en":"You stirred turmoil throughout the world,"},{"id":"seytek-2012:p0147:b002:l024","ordinal":305122,"en":"And made bullets rain from your cartridge pouch."},{"id":"seytek-2012:p0147:b002:l025","ordinal":305123,"en":"While your hero lived,"},{"id":"seytek-2012:p0147:b002:l026","ordinal":305124,"en":"You crushed every foe you faced."},{"id":"seytek-2012:p0147:b002:l027","ordinal":305125,"en":"The six keen blades fallen from heaven,"},{"id":"seytek-2012:p0147:b002:l028","ordinal":305126,"en":"Calling them your paternal inheritance,"},{"id":"seytek-2012:p0147:b002:l029","ordinal":305127,"en":"You bound them at your slender waist"},{"id":"seytek-2012:p0147:b002:l030","ordinal":305128,"en":"And subdued the world alone."},{"id":"seytek-2012:p0147:b002:l031","ordinal":305129,"en":"You were a lion, but became a wanderer;"},{"id":"seytek-2012:p0147:b002:l032","ordinal":305130,"en":"You were parted from your valiant one."},{"id":"seytek-2012:p0147:b002:l033","ordinal":305131,"en":"You burned and grieved until you became thus."},{"id":"seytek-2012:p0147:b002:l034","ordinal":305132,"en":"Parted from the noble hero,"},{"id":"seytek-2012:p0147:b002:l035","ordinal":305133,"en":"You became a herdsman’s slave."},{"id":"seytek-2012:p0147:b002:l036","ordinal":305134,"en":"You were a mountain pass, but became a road;"},{"id":"seytek-2012:p0147:b002:l037","ordinal":305135,"en":"Parted from the renowned lion,"},{"id":"seytek-2012:p0147:b002:l038","ordinal":305136,"en":"You fell into abject disgrace."},{"id":"seytek-2012:p0147:b002:l039","ordinal":305137,"en":"Today speak your truth without wavering."},{"id":"seytek-2012:p0147:b002:l040","ordinal":305138,"en":"Will the divinely favored lion"},{"id":"seytek-2012:p0147:b003:l001","ordinal":305139,"en":"Stand by without raising battle?"},{"id":"seytek-2012:p0147:b003:l002","ordinal":305140,"en":"Will God strike Choro down"},{"id":"seytek-2012:p0147:b003:l003","ordinal":305141,"en":"Before he fights and takes revenge?"},{"id":"seytek-2012:p0147:b003:l004","ordinal":305142,"en":"The gold-jawed, cast-iron-headed mace—"},{"id":"seytek-2012:p0147:b003:l005","ordinal":305143,"en":"When you see its venom, flee far away."},{"id":"seytek-2012:p0147:b003:l006","ordinal":305144,"en":"Gripping it and swinging it in his hand,"},{"id":"seytek-2012:p0147:b003:l007","ordinal":305145,"en":"He raised a black stone as large as a house"},{"id":"seytek-2012:p0147:b003:l008","ordinal":305146,"en":"And hurled it with both hands."},{"id":"seytek-2012:p0147:b003:l009","ordinal":305147,"en":"Sparks flew from his mace,"},{"id":"seytek-2012:p0147:b003:l010","ordinal":305148,"en":"Flames blazed and crackled,"},{"id":"seytek-2012:p0147:b003:l011","ordinal":305149,"en":"And fire sprang from the black stone."},{"id":"seytek-2012:p0147:b003:l012","ordinal":305150,"en":"Dust rose from his blow,"},{"id":"seytek-2012:p0147:b003:l013","ordinal":305151,"en":"And those who saw it nearly died."},{"id":"seytek-2012:p0147:b003:l014","ordinal":305152,"en":"Choro began to show his strength,"}]
