[{"id":"seytek-2012:p0285:b003:l019","ordinal":316161,"en":"His dear mother stood grieving."},{"id":"seytek-2012:p0285:b003:l020","ordinal":316162,"en":"As his mother stood thus,"},{"id":"seytek-2012:p0285:b003:l021","ordinal":316163,"en":"The hero Seytek grew fierce,"},{"id":"seytek-2012:p0285:b003:l022","ordinal":316164,"en":"Angrily making ready."},{"id":"seytek-2012:p0285:b003:l023","ordinal":316165,"en":"Wisdom came to him from the unseen;"},{"id":"seytek-2012:p0285:b003:l024","ordinal":316166,"en":"Murmuring with gathering resolve,"},{"id":"seytek-2012:p0285:b003:l025","ordinal":316167,"en":"This poor heroic son"},{"id":"seytek-2012:p0285:b003:l026","ordinal":316168,"en":"Spoke to his mother:"},{"id":"seytek-2012:p0285:b003:l027","ordinal":316169,"en":"‘Alas, Mother, what are you saying?"},{"id":"seytek-2012:p0285:b003:l028","ordinal":316170,"en":"Does a mortal man not die?"},{"id":"seytek-2012:p0285:b003:l029","ordinal":316171,"en":"Whatever command God ordains,"},{"id":"seytek-2012:p0285:b003:l030","ordinal":316172,"en":"Must not a mortal servant endure it?"},{"id":"seytek-2012:p0285:b003:l031","ordinal":316173,"en":"Does one whose time has come not die?"},{"id":"seytek-2012:p0285:b003:l032","ordinal":316174,"en":"When the angel reaches out five fingers,"},{"id":"seytek-2012:p0285:b003:l033","ordinal":316175,"en":"Saying, “We have need of this mortal,”"},{"id":"seytek-2012:p0285:b003:l034","ordinal":316176,"en":"And the command has been given,"},{"id":"seytek-2012:p0285:b003:l035","ordinal":316177,"en":"The nimble tongue is stilled from speaking."},{"id":"seytek-2012:p0285:b003:l036","ordinal":316178,"en":"When the naked blade of Gabriel"},{"id":"seytek-2012:p0285:b003:l037","ordinal":316179,"en":"Comes rushing straight against him,"},{"id":"seytek-2012:p0285:b003:l038","ordinal":316180,"en":"When five fingers reach out,"},{"id":"seytek-2012:p0285:b003:l039","ordinal":316181,"en":"When the soul departs and a person dies,"},{"id":"seytek-2012:p0285:b003:l040","ordinal":316182,"en":"Will the dug grave not receive him?"},{"id":"seytek-2012:p0286:b002:l001","ordinal":316183,"en":"Almighty God creates living souls"},{"id":"seytek-2012:p0286:b002:l002","ordinal":316184,"en":"In every different form."},{"id":"seytek-2012:p0286:b002:l003","ordinal":316185,"en":"The valleys stretch broad and level,"},{"id":"seytek-2012:p0286:b002:l004","ordinal":316186,"en":"The wooded mountains rise in grandeur;"},{"id":"seytek-2012:p0286:b002:l005","ordinal":316187,"en":"Our wondrous Talas"},{"id":"seytek-2012:p0286:b002:l006","ordinal":316188,"en":"Has snow upon its encircling peaks,"},{"id":"seytek-2012:p0286:b002:l007","ordinal":316189,"en":"And every kind of living creature."},{"id":"seytek-2012:p0286:b002:l008","ordinal":316190,"en":"All creatures endowed with life"},{"id":"seytek-2012:p0286:b002:l009","ordinal":316191,"en":"Are gathered here in abundance."},{"id":"seytek-2012:p0286:b002:l010","ordinal":316192,"en":"Cuckoos sing upon the hills,"},{"id":"seytek-2012:p0286:b002:l011","ordinal":316193,"en":"And nightingales in the woods"},{"id":"seytek-2012:p0286:b002:l012","ordinal":316194,"en":"Pour forth their many plaintive songs."},{"id":"seytek-2012:p0286:b002:l013","ordinal":316195,"en":"When the mournful nightingale sings,"},{"id":"seytek-2012:p0286:b002:l014","ordinal":316196,"en":"Those who bear sorrow long to listen;"},{"id":"seytek-2012:p0286:b002:l015","ordinal":316197,"en":"Many a melancholy soul"},{"id":"seytek-2012:p0286:b002:l016","ordinal":316198,"en":"Yearns to enter its delight."},{"id":"seytek-2012:p0286:b002:l017","ordinal":316199,"en":"Willows bend low,"},{"id":"seytek-2012:p0286:b002:l018","ordinal":316200,"en":"Argali cluster on the hills."},{"id":"seytek-2012:p0286:b002:l019","ordinal":316201,"en":"Deer shelter among the knolls,"},{"id":"seytek-2012:p0286:b002:l020","ordinal":316202,"en":"And there, upon the terraces, wild goats"},{"id":"seytek-2012:p0286:b002:l021","ordinal":316203,"en":"Pour across in every direction."},{"id":"seytek-2012:p0286:b002:l022","ordinal":316204,"en":"Their ears held sharply upright,"},{"id":"seytek-2012:p0286:b002:l023","ordinal":316205,"en":"Wolves prowl along the lower slopes."},{"id":"seytek-2012:p0286:b002:l024","ordinal":316206,"en":"Their tails trailing behind them,"},{"id":"seytek-2012:p0286:b002:l025","ordinal":316207,"en":"Foxes frolic on the plain."},{"id":"seytek-2012:p0286:b002:l026","ordinal":316208,"en":"Swift bustards and great bustards"},{"id":"seytek-2012:p0286:b002:l027","ordinal":316209,"en":"Scatter to graze upon the hills;"},{"id":"seytek-2012:p0286:b002:l028","ordinal":316210,"en":"Every blessing is true delight,"},{"id":"seytek-2012:p0286:b002:l029","ordinal":316211,"en":"And white waters pour from the uplands."},{"id":"seytek-2012:p0286:b002:l030","ordinal":316212,"en":"Our wondrous, spacious Talas,"},{"id":"seytek-2012:p0286:b002:l031","ordinal":316213,"en":"Its apples are as large as horses’ heads,"},{"id":"seytek-2012:p0286:b002:l032","ordinal":316214,"en":"Its walnuts like stones in a stream;"},{"id":"seytek-2012:p0286:b002:l033","ordinal":316215,"en":"Feather grass sways waist-high,"},{"id":"seytek-2012:p0286:b002:l034","ordinal":316216,"en":"Tulips and sorrel"},{"id":"seytek-2012:p0286:b002:l035","ordinal":316217,"en":"Twist and trail about the waist."},{"id":"seytek-2012:p0286:b002:l036","ordinal":316218,"en":"From the broad, branching valleys"},{"id":"seytek-2012:p0286:b002:l037","ordinal":316219,"en":"Springs divide and flow."},{"id":"seytek-2012:p0286:b002:l038","ordinal":316220,"en":"Perhaps in wonder at Talas,"},{"id":"seytek-2012:p0286:b002:l039","ordinal":316221,"en":"The boy’s thoughts wandered away."},{"id":"seytek-2012:p0286:b002:l040","ordinal":316222,"en":"When he looked closely upon broad Talas,"},{"id":"seytek-2012:p0286:b003:l001","ordinal":316223,"en":"He rode on without sparing his horse,"},{"id":"seytek-2012:p0286:b003:l002","ordinal":316224,"en":"Never halting to rest his steed,"},{"id":"seytek-2012:p0286:b003:l003","ordinal":316225,"en":"Never lying down to satisfy his sleep,"},{"id":"seytek-2012:p0286:b003:l004","ordinal":316226,"en":"Never leaning on an elbow to rest,"},{"id":"seytek-2012:p0286:b003:l005","ordinal":316227,"en":"Never dozing even for a moment;"},{"id":"seytek-2012:p0286:b003:l006","ordinal":316228,"en":"He hurried on in high excitement,"},{"id":"seytek-2012:p0286:b003:l007","ordinal":316229,"en":"Roused like a lion,"},{"id":"seytek-2012:p0286:b003:l008","ordinal":316230,"en":"Travelling without pause,"},{"id":"seytek-2012:p0286:b003:l009","ordinal":316231,"en":"Riding onward without restraint."},{"id":"seytek-2012:p0286:b003:l010","ordinal":316232,"en":"How could the hero have foreseen"},{"id":"seytek-2012:p0286:b003:l011","ordinal":316233,"en":"The mist lying like the back of a saddle?"},{"id":"seytek-2012:p0286:b003:l012","ordinal":316234,"en":"He made his way toward the haze."},{"id":"seytek-2012:p0286:b003:l013","ordinal":316235,"en":"On this side of the mist"},{"id":"seytek-2012:p0286:b003:l014","ordinal":316236,"en":"Was a valley of surpassing cliffs."},{"id":"seytek-2012:p0286:b003:l015","ordinal":316237,"en":"Kara-Buura and great Chatkal"},{"id":"seytek-2012:p0286:b003:l016","ordinal":316238,"en":"Form a mountain range adjoining Talas;"},{"id":"seytek-2012:p0286:b003:l017","ordinal":316239,"en":"Its rocky passes are perilously narrow,"},{"id":"seytek-2012:p0286:b003:l018","ordinal":316240,"en":"Its ridges are sheer precipices,"},{"id":"seytek-2012:p0286:b003:l019","ordinal":316241,"en":"Its mountains girdle the valley like a rim."},{"id":"seytek-2012:p0286:b003:l020","ordinal":316242,"en":"It is called the broad Chatkal range."},{"id":"seytek-2012:p0286:b003:l021","ordinal":316243,"en":"He crossed over Chatkal,"},{"id":"seytek-2012:p0286:b003:l022","ordinal":316244,"en":"And before him lay broad Talas—"},{"id":"seytek-2012:p0286:b003:l023","ordinal":316245,"en":"He entered spacious Talas."},{"id":"seytek-2012:p0286:b003:l024","ordinal":316246,"en":"Our wondrous, spacious Talas"},{"id":"seytek-2012:p0286:b003:l025","ordinal":316247,"en":"Lay spread out wide,"},{"id":"seytek-2012:p0286:b003:l026","ordinal":316248,"en":"Its lofty mountains rising grandly."},{"id":"seytek-2012:p0286:b003:l027","ordinal":316249,"en":"Its springs surged and overflowed,"},{"id":"seytek-2012:p0286:b003:l028","ordinal":316250,"en":"Its nightingales sang and trilled,"},{"id":"seytek-2012:p0286:b003:l029","ordinal":316251,"en":"And sorrowing hearts melted into tears."},{"id":"seytek-2012:p0286:b003:l030","ordinal":316252,"en":"Its leaves are broad as hides,"},{"id":"seytek-2012:p0286:b003:l031","ordinal":316253,"en":"Its beetles large as thumbs,"},{"id":"seytek-2012:p0286:b003:l032","ordinal":316254,"en":"Its hogweed stalks thick as wrists;"},{"id":"seytek-2012:p0286:b003:l033","ordinal":316255,"en":"When its maral deer bolt away,"},{"id":"seytek-2012:p0286:b003:l034","ordinal":316256,"en":"They resemble pale-faced cows."},{"id":"seytek-2012:p0286:b003:l035","ordinal":316257,"en":"Its saplings are like plane trees,"},{"id":"seytek-2012:p0286:b003:l036","ordinal":316258,"en":"Its little birds like snowcocks,"},{"id":"seytek-2012:p0286:b003:l037","ordinal":316259,"en":"Its lizards like snakes."},{"id":"seytek-2012:p0286:b003:l038","ordinal":316260,"en":"Its wild asses are like three-year-old colts,"},{"id":"seytek-2012:p0286:b003:l039","ordinal":316261,"en":"And its gliding snakes"},{"id":"seytek-2012:p0286:b003:l040","ordinal":316262,"en":"Are like coiled ropes."},{"id":"seytek-2012:p0287:b002:l001","ordinal":316263,"en":"The people knew the worth of the land;"},{"id":"seytek-2012:p0287:b002:l002","ordinal":316264,"en":"Was it a place where anyone could remain idle?"},{"id":"seytek-2012:p0287:b002:l003","ordinal":316265,"en":"Was it a place where men would not compete"},{"id":"seytek-2012:p0287:b002:l004","ordinal":316266,"en":"In mass games of kökbörü,"},{"id":"seytek-2012:p0287:b002:l005","ordinal":316267,"en":"Where young men would not immerse themselves"},{"id":"seytek-2012:p0287:b002:l006","ordinal":316268,"en":"In every kind of pleasure,"},{"id":"seytek-2012:p0287:b002:l007","ordinal":316269,"en":"Roaming the hills and finding gold,"},{"id":"seytek-2012:p0287:b002:l008","ordinal":316270,"en":"Knotting their horses’ banner-like tails and racing them,"},{"id":"seytek-2012:p0287:b002:l009","ordinal":316271,"en":"The honored champion surging ahead,"},{"id":"seytek-2012:p0287:b002:l010","ordinal":316272,"en":"Taking up white steel and barring the road,"},{"id":"seytek-2012:p0287:b002:l011","ordinal":316273,"en":"Wearying horses while ranging the land,"},{"id":"seytek-2012:p0287:b002:l012","ordinal":316274,"en":"Setting loose hounds and flying hawks,"},{"id":"seytek-2012:p0287:b002:l013","ordinal":316275,"en":"And riding proudly prancing steeds?"},{"id":"seytek-2012:p0287:b002:l014","ordinal":316276,"en":"Could anyone fail to ride there?"},{"id":"seytek-2012:p0287:b002:l015","ordinal":316277,"en":"Girding their slender waists,"},{"id":"seytek-2012:p0287:b002:l016","ordinal":316278,"en":"Born as defenders of the Kyrgyz,"},{"id":"seytek-2012:p0287:b002:l017","ordinal":316279,"en":"Fastening belts around their trim waists,"},{"id":"seytek-2012:p0287:b002:l018","ordinal":316280,"en":"And attacking the enemy in battle—"},{"id":"seytek-2012:p0287:b002:l019","ordinal":316281,"en":"Could they fail to strike there?"},{"id":"seytek-2012:p0287:b002:l020","ordinal":316282,"en":"Drinking their fill of kumiss and courting girls,"},{"id":"seytek-2012:p0287:b002:l021","ordinal":316283,"en":"Men reveling amid delights—"},{"id":"seytek-2012:p0287:b002:l022","ordinal":316284,"en":"Could they fail to enjoy themselves there?"},{"id":"seytek-2012:p0287:b002:l023","ordinal":316285,"en":"With black hats like cauldrons,"},{"id":"seytek-2012:p0287:b002:l024","ordinal":316286,"en":"Raising the people’s fortress as their banner,"},{"id":"seytek-2012:p0287:b002:l025","ordinal":316287,"en":"Could they fail to sway in dance there?"},{"id":"seytek-2012:p0287:b002:l026","ordinal":316288,"en":"Laughing together in chorus,"},{"id":"seytek-2012:p0287:b002:l027","ordinal":316289,"en":"Could they fail to rejoice there?"},{"id":"seytek-2012:p0287:b002:l028","ordinal":316290,"en":"Our wondrous Talas"},{"id":"seytek-2012:p0287:b002:l029","ordinal":316291,"en":"Has hills and mountain passes,"},{"id":"seytek-2012:p0287:b002:l030","ordinal":316292,"en":"With countless kinds of grasses;"},{"id":"seytek-2012:p0287:b002:l031","ordinal":316293,"en":"It has most things people need."},{"id":"seytek-2012:p0287:b002:l032","ordinal":316294,"en":"Feather grass and other grasses grow,"},{"id":"seytek-2012:p0287:b002:l033","ordinal":316295,"en":"And from every mighty broad slope"},{"id":"seytek-2012:p0287:b002:l034","ordinal":316296,"en":"Springs pour forth like gold."},{"id":"seytek-2012:p0287:b002:l035","ordinal":316297,"en":"It is a land where men laugh with delight"},{"id":"seytek-2012:p0287:b002:l036","ordinal":316298,"en":"And young warriors may repose."},{"id":"seytek-2012:p0287:b002:l037","ordinal":316299,"en":"There livestock foal, bear young, and multiply;"},{"id":"seytek-2012:p0287:b002:l038","ordinal":316300,"en":"It is a land where people live in joy."},{"id":"seytek-2012:p0287:b002:l039","ordinal":316301,"en":"Our wondrous, spacious Talas"},{"id":"seytek-2012:p0287:b002:l040","ordinal":316302,"en":"Has forests and dense woodland,"},{"id":"seytek-2012:p0287:b003:l001","ordinal":316303,"en":"Appearing equal to paradise."},{"id":"seytek-2012:p0287:b003:l002","ordinal":316304,"en":"Snow blocks its mountain passes;"},{"id":"seytek-2012:p0287:b003:l003","ordinal":316305,"en":"Look carefully, and it possesses"},{"id":"seytek-2012:p0287:b003:l004","ordinal":316306,"en":"Every earthly delight mankind desires."},{"id":"seytek-2012:p0287:b003:l005","ordinal":316307,"en":"Fox-tail grass and woodruff,"},{"id":"seytek-2012:p0287:b003:l006","ordinal":316308,"en":"Blue wildflowers and white blossoms—"},{"id":"seytek-2012:p0287:b003:l007","ordinal":316309,"en":"Every kind of herb is there."},{"id":"seytek-2012:p0287:b003:l008","ordinal":316310,"en":"Anyone who sees it is fully satisfied,"},{"id":"seytek-2012:p0287:b003:l009","ordinal":316311,"en":"When beholding such a Talas."},{"id":"seytek-2012:p0287:b003:l010","ordinal":316312,"en":"It is as though a richly patterned carpet"},{"id":"seytek-2012:p0287:b003:l011","ordinal":316313,"en":"Had been spread across Talas."},{"id":"seytek-2012:p0287:b003:l012","ordinal":316314,"en":"Every beholder’s heart is content;"},{"id":"seytek-2012:p0287:b003:l013","ordinal":316315,"en":"Talas is wondrously beautiful."},{"id":"seytek-2012:p0287:b003:l014","ordinal":316316,"en":"It is a land where swift horses are stretched at the tether"},{"id":"seytek-2012:p0287:b003:l015","ordinal":316317,"en":"And kept tied there,"},{"id":"seytek-2012:p0287:b003:l016","ordinal":316318,"en":"A land of merriment by day and games by night,"},{"id":"seytek-2012:p0287:b003:l017","ordinal":316319,"en":"Where people spend the summer,"},{"id":"seytek-2012:p0287:b003:l018","ordinal":316320,"en":"Wearing paired sable hats"},{"id":"seytek-2012:p0287:b003:l019","ordinal":316321,"en":"And swaying in dance,"},{"id":"seytek-2012:p0287:b003:l020","ordinal":316322,"en":"Riding three-year-old colts and flying hawks,"},{"id":"seytek-2012:p0287:b003:l021","ordinal":316323,"en":"Living there in happiness."},{"id":"seytek-2012:p0287:b003:l022","ordinal":316324,"en":"When bored, they shoot roe deer,"},{"id":"seytek-2012:p0287:b003:l023","ordinal":316325,"en":"And play without weariness"},{"id":"seytek-2012:p0287:b003:l024","ordinal":316326,"en":"At countless delightful games,"},{"id":"seytek-2012:p0287:b003:l025","ordinal":316327,"en":"Taking keen, baying greyhounds"},{"id":"seytek-2012:p0287:b003:l026","ordinal":316328,"en":"And dark goshawks—"},{"id":"seytek-2012:p0287:b003:l027","ordinal":316329,"en":"Could they fail to hunt there?"},{"id":"seytek-2012:p0287:b003:l028","ordinal":316330,"en":"Could they fail to immerse themselves"},{"id":"seytek-2012:p0287:b003:l029","ordinal":316331,"en":"In rare games and pleasures?"},{"id":"seytek-2012:p0287:b003:l030","ordinal":316332,"en":"Could they ever have their fill"},{"id":"seytek-2012:p0287:b003:l031","ordinal":316333,"en":"Of its many entertainments and games?"},{"id":"seytek-2012:p0287:b003:l032","ordinal":316334,"en":"Would they not seek tracks on rugged ground"},{"id":"seytek-2012:p0287:b003:l033","ordinal":316335,"en":"And range across it?"},{"id":"seytek-2012:p0287:b003:l034","ordinal":316336,"en":"Could they fail to immerse themselves"},{"id":"seytek-2012:p0287:b003:l035","ordinal":316337,"en":"In rare games and pleasures?"},{"id":"seytek-2012:p0287:b003:l036","ordinal":316338,"en":"Competing for the true prize between them,"},{"id":"seytek-2012:p0287:b003:l037","ordinal":316339,"en":"Could they fail to shoot?"},{"id":"seytek-2012:p0287:b003:l038","ordinal":316340,"en":"Playing freely amid delights,"},{"id":"seytek-2012:p0287:b003:l039","ordinal":316341,"en":"Could they fail to revel?"},{"id":"seytek-2012:p0287:b003:l040","ordinal":316342,"en":"The people played freely, and all laughed,"},{"id":"seytek-2012:p0288:b002:l001","ordinal":316343,"en":"In Talas, the choicest of lands,"},{"id":"seytek-2012:p0288:b002:l002","ordinal":316344,"en":"All these delights abound."},{"id":"seytek-2012:p0288:b002:l003","ordinal":316345,"en":"When one looks upon a plane tree,"},{"id":"seytek-2012:p0288:b002:l004","ordinal":316346,"en":"Seeking out the creatures there,"},{"id":"seytek-2012:p0288:b002:l005","ordinal":316347,"en":"And examines one branch,"},{"id":"seytek-2012:p0288:b002:l006","ordinal":316348,"en":"A long-tailed shrike"},{"id":"seytek-2012:p0288:b002:l007","ordinal":316349,"en":"Appears upon one branch;"},{"id":"seytek-2012:p0288:b002:l008","ordinal":316350,"en":"Looking at another, one finds a hooded crow,"},{"id":"seytek-2012:p0288:b002:l009","ordinal":316351,"en":"And looking upon another—"},{"id":"seytek-2012:p0288:b002:l010","ordinal":316352,"en":"A ring-necked jackdaw."},{"id":"seytek-2012:p0288:b002:l011","ordinal":316353,"en":"When one looks at one branch,"},{"id":"seytek-2012:p0288:b002:l012","ordinal":316354,"en":"A great shaggy owl is perched there;"},{"id":"seytek-2012:p0288:b002:l013","ordinal":316355,"en":"Looking upon another,"},{"id":"seytek-2012:p0288:b002:l014","ordinal":316356,"en":"A compact sparrowhawk appears."},{"id":"seytek-2012:p0288:b002:l015","ordinal":316357,"en":"Upon a single plane tree"},{"id":"seytek-2012:p0288:b002:l016","ordinal":316358,"en":"Countless kinds of creatures have gathered."},{"id":"seytek-2012:p0288:b002:l017","ordinal":316359,"en":"Our wondrous, spacious Talas"},{"id":"seytek-2012:p0288:b002:l018","ordinal":316360,"en":"Is surely the richest of lands,"},{"id":"seytek-2012:p0288:b002:l019","ordinal":316361,"en":"And the Kyrgyz and the few Argyn who inhabit it"},{"id":"seytek-2012:p0288:b002:l020","ordinal":316362,"en":"Are surely the flower of all peoples."},{"id":"seytek-2012:p0288:b002:l021","ordinal":316363,"en":"Was it a land where the great Kyrgyz would not"},{"id":"seytek-2012:p0288:b002:l022","ordinal":316364,"en":"Camp for months on end,"},{"id":"seytek-2012:p0288:b002:l023","ordinal":316365,"en":"With revelry by day and games by night?"},{"id":"seytek-2012:p0288:b002:l024","ordinal":316366,"en":"Could such pleasures fail to flourish there?"},{"id":"seytek-2012:p0288:b002:l025","ordinal":316367,"en":"Wearing costly hats of blue lynx,"},{"id":"seytek-2012:p0288:b002:l026","ordinal":316368,"en":"Could they fail to sway in dance there?"},{"id":"seytek-2012:p0288:b002:l027","ordinal":316369,"en":"Playing many games together,"},{"id":"seytek-2012:p0288:b002:l028","ordinal":316370,"en":"Could they fail to rejoice there?"},{"id":"seytek-2012:p0288:b002:l029","ordinal":316371,"en":"“This is what life is for,”"},{"id":"seytek-2012:p0288:b002:l030","ordinal":316372,"en":"Could they fail to think there?"},{"id":"seytek-2012:p0288:b002:l031","ordinal":316373,"en":"With budlike mouths and camel-calf eyes,"},{"id":"seytek-2012:p0288:b002:l032","ordinal":316374,"en":"With teasing, alluring eyes,"},{"id":"seytek-2012:p0288:b002:l033","ordinal":316375,"en":"In crimson dresses, slender-waisted as the crescent moon—"},{"id":"seytek-2012:p0288:b002:l034","ordinal":316376,"en":"With such graceful beauties,"},{"id":"seytek-2012:p0288:b002:l035","ordinal":316377,"en":"Could men fail to lie there?"},{"id":"seytek-2012:p0288:b002:l036","ordinal":316378,"en":"Could they fail to lose themselves"},{"id":"seytek-2012:p0288:b002:l037","ordinal":316379,"en":"In splendid games and laughter?"},{"id":"seytek-2012:p0288:b002:l038","ordinal":316380,"en":"Upon the wide, level mountain plains,"},{"id":"seytek-2012:p0288:b002:l039","ordinal":316381,"en":"Could they fail to make camp?"},{"id":"seytek-2012:p0288:b002:l040","ordinal":316382,"en":"By day young wives, by night maidens—"},{"id":"seytek-2012:p0288:b003:l001","ordinal":316383,"en":"It has many a surging stronghold."},{"id":"seytek-2012:p0288:b003:l002","ordinal":316384,"en":"There is entertainment in abundance"},{"id":"seytek-2012:p0288:b003:l003","ordinal":316385,"en":"And every kind of pleasure."},{"id":"seytek-2012:p0288:b003:l004","ordinal":316386,"en":"It has oleaster, birch, and willow;"},{"id":"seytek-2012:p0288:b003:l005","ordinal":316387,"en":"Pines and birches reach toward the sky,"},{"id":"seytek-2012:p0288:b003:l006","ordinal":316388,"en":"And every kind of beauty is there."},{"id":"seytek-2012:p0288:b003:l007","ordinal":316389,"en":"Within those dense woods"},{"id":"seytek-2012:p0288:b003:l008","ordinal":316390,"en":"There are tawny lions,"},{"id":"seytek-2012:p0288:b003:l009","ordinal":316391,"en":"And striped-backed, ring-tailed"},{"id":"seytek-2012:p0288:b003:l010","ordinal":316392,"en":"Tigers as well."},{"id":"seytek-2012:p0288:b003:l011","ordinal":316393,"en":"Every creature endowed with life,"},{"id":"seytek-2012:p0288:b003:l012","ordinal":316394,"en":"Everything the ear has heard and the eye has seen,"},{"id":"seytek-2012:p0288:b003:l013","ordinal":316395,"en":"Everything people have spoken of, is there."},{"id":"seytek-2012:p0288:b003:l014","ordinal":316396,"en":"The world seethes, filled to overflowing;"},{"id":"seytek-2012:p0288:b003:l015","ordinal":316397,"en":"In our wondrous Talas"},{"id":"seytek-2012:p0288:b003:l016","ordinal":316398,"en":"All things have come into being in abundance."},{"id":"seytek-2012:p0288:b003:l017","ordinal":316399,"en":"Is it not the choicest of lands?"},{"id":"seytek-2012:p0288:b003:l018","ordinal":316400,"en":"Do not the Kyrgyz who dwell there prosper!"},{"id":"seytek-2012:p0288:b003:l019","ordinal":316401,"en":"Spacious Talas, our ancestral homeland—"},{"id":"seytek-2012:p0288:b003:l020","ordinal":316402,"en":"Was it not won by our forefathers!"},{"id":"seytek-2012:p0288:b003:l021","ordinal":316403,"en":"Ah, what a world this is—"},{"id":"seytek-2012:p0288:b003:l022","ordinal":316404,"en":"Would any man living here not prosper?"},{"id":"seytek-2012:p0288:b003:l023","ordinal":316405,"en":"Upon its terraced hills"},{"id":"seytek-2012:p0288:b003:l024","ordinal":316406,"en":"Wild goats and argali stand;"},{"id":"seytek-2012:p0288:b003:l025","ordinal":316407,"en":"Within its level forests"},{"id":"seytek-2012:p0288:b003:l026","ordinal":316408,"en":"Piglets and wild boars graze."},{"id":"seytek-2012:p0288:b003:l027","ordinal":316409,"en":"Every creature possessing life,"},{"id":"seytek-2012:p0288:b003:l028","ordinal":316410,"en":"In our wondrous Talas—"},{"id":"seytek-2012:p0288:b003:l029","ordinal":316411,"en":"Every living thing is there."},{"id":"seytek-2012:p0288:b003:l030","ordinal":316412,"en":"When you look toward the mountains,"},{"id":"seytek-2012:p0288:b003:l031","ordinal":316413,"en":"There is snow that never departs;"},{"id":"seytek-2012:p0288:b003:l032","ordinal":316414,"en":"When you look within the forest,"},{"id":"seytek-2012:p0288:b003:l033","ordinal":316415,"en":"There are goitered gazelles with high throats."},{"id":"seytek-2012:p0288:b003:l034","ordinal":316416,"en":"Every creature ever created—"}]
