[{"id":"manas-2010:p0890:b001:l035","ordinal":39169,"en":"No soul left to turn a catching pole against you,"},{"id":"manas-2010:p0890:b001:l036","ordinal":39170,"en":"You will become supreme!"},{"id":"manas-2010:p0890:b001:l037","ordinal":39171,"en":"Wearing out horses, exploring the land,"},{"id":"manas-2010:p0890:b001:l038","ordinal":39172,"en":"Your camping in the open wilderness,"},{"id":"manas-2010:p0890:b001:l039","ordinal":39173,"en":"The sun rising from the north,"},{"id":"manas-2010:p0890:b001:l040","ordinal":39174,"en":"Your parting without battle—"},{"id":"manas-2010:p0890:b001:l041","ordinal":39175,"en":"I heard news from those who came."},{"id":"manas-2010:p0890:b001:l042","ordinal":39176,"en":"Twelve khans gathered,"},{"id":"manas-2010:p0891:b001:l001","ordinal":39177,"en":"The ruler of Bukhara"},{"id":"manas-2010:p0891:b001:l002","ordinal":39178,"en":"They went to besiege, I heard."},{"id":"manas-2010:p0891:b001:l003","ordinal":39179,"en":"The greatest marvel upon them"},{"id":"manas-2010:p0891:b001:l004","ordinal":39180,"en":"Was worked, I heard."},{"id":"manas-2010:p0891:b001:l005","ordinal":39181,"en":"With battle-axes and clubs,"},{"id":"manas-2010:p0891:b001:l006","ordinal":39182,"en":"The twelve khans' favorites"},{"id":"manas-2010:p0891:b001:l007","ordinal":39183,"en":"Were slaughtered, I heard!"},{"id":"manas-2010:p0891:b001:l008","ordinal":39184,"en":"Their own wealth was scattered, they say."},{"id":"manas-2010:p0891:b001:l009","ordinal":39185,"en":"Going to take Bukhara,"},{"id":"manas-2010:p0891:b001:l010","ordinal":39186,"en":"All twelve khans"},{"id":"manas-2010:p0891:b001:l011","ordinal":39187,"en":"Fled in every direction, they say."},{"id":"manas-2010:p0891:b001:l012","ordinal":39188,"en":"In that city of Bukhara,"},{"id":"manas-2010:p0891:b001:l013","ordinal":39189,"en":"While disorder reigned,"},{"id":"manas-2010:p0891:b001:l014","ordinal":39190,"en":"Living in Anzhyian,"},{"id":"manas-2010:p0891:b001:l015","ordinal":39191,"en":"Aykhozho of the striped robe,"},{"id":"manas-2010:p0891:b001:l016","ordinal":39192,"en":"A truly wise saint,"},{"id":"manas-2010:p0891:b001:l017","ordinal":39193,"en":"From a doorway in Bukhara,"},{"id":"manas-2010:p0891:b001:l018","ordinal":39194,"en":"While battle was being fought,"},{"id":"manas-2010:p0891:b001:l019","ordinal":39195,"en":"Had watched then"},{"id":"manas-2010:p0891:b001:l020","ordinal":39196,"en":"Through a hole in the gateway."},{"id":"manas-2010:p0891:b001:l021","ordinal":39197,"en":"She was dressed in a boy's clothes;"},{"id":"manas-2010:p0891:b001:l022","ordinal":39198,"en":"The people shouted in confusion."},{"id":"manas-2010:p0891:b001:l023","ordinal":39199,"en":"Killing warriors, shattering peoples,"},{"id":"manas-2010:p0891:b001:l024","ordinal":39200,"en":"The hapless warrior Kanykey"},{"id":"manas-2010:p0891:b001:l025","ordinal":39201,"en":"Aykhozho now examined."},{"id":"manas-2010:p0891:b001:l026","ordinal":39202,"en":"Watching her from outside,"},{"id":"manas-2010:p0891:b001:l027","ordinal":39203,"en":"Taking the full measure of her,"},{"id":"manas-2010:p0891:b001:l028","ordinal":39204,"en":"“She is a lion among women,"},{"id":"manas-2010:p0891:b001:l029","ordinal":39205,"en":"All twelve of her limbs are complete."},{"id":"manas-2010:p0891:b001:l030","ordinal":39206,"en":"If she were a man,"},{"id":"manas-2010:p0891:b001:l031","ordinal":39207,"en":"For the eighteen thousand worlds"},{"id":"manas-2010:p0891:b001:l032","ordinal":39208,"en":"She would be a mainstay."},{"id":"manas-2010:p0891:b001:l033","ordinal":39209,"en":"Her pelvic bones are rather narrow;"},{"id":"manas-2010:p0891:b001:l034","ordinal":39210,"en":"In this she has a shortcoming."},{"id":"manas-2010:p0891:b001:l035","ordinal":39211,"en":"Alas, the hapless one"},{"id":"manas-2010:p0891:b001:l036","ordinal":39212,"en":"Has a sign of being unable to bear children."},{"id":"manas-2010:p0891:b001:l037","ordinal":39213,"en":"Apart from that,"},{"id":"manas-2010:p0891:b001:l038","ordinal":39214,"en":"Where does she have a fault?"},{"id":"manas-2010:p0891:b001:l039","ordinal":39215,"en":"She is a soul with sacred power,"},{"id":"manas-2010:p0891:b001:l040","ordinal":39216,"en":"The hardship of six months ahead"},{"id":"manas-2010:p0891:b001:l041","ordinal":39217,"en":"She can tell at this very moment."},{"id":"manas-2010:p0891:b001:l042","ordinal":39218,"en":"On the fierce woman's right shoulder,"},{"id":"manas-2010:p0892:b001:l001","ordinal":39219,"en":"There is a naked child."},{"id":"manas-2010:p0892:b001:l002","ordinal":39220,"en":"When she speaks and acts,"},{"id":"manas-2010:p0892:b001:l003","ordinal":39221,"en":"Her deeds depend upon God."},{"id":"manas-2010:p0892:b001:l004","ordinal":39222,"en":"Ah, in that fierce woman"},{"id":"manas-2010:p0892:b001:l005","ordinal":39223,"en":"There is true sacred power!"},{"id":"manas-2010:p0892:b001:l006","ordinal":39224,"en":"Kanykey is no mere woman;"},{"id":"manas-2010:p0892:b001:l007","ordinal":39225,"en":"To the son of man who meets her,"},{"id":"manas-2010:p0892:b001:l008","ordinal":39226,"en":"She is a mountain-high Night of Power."},{"id":"manas-2010:p0892:b001:l009","ordinal":39227,"en":"If that hapless one comes into your hands,"},{"id":"manas-2010:p0892:b001:l010","ordinal":39228,"en":"She is a source of blessing."},{"id":"manas-2010:p0892:b001:l011","ordinal":39229,"en":"Removing misfortune, opening the heart,"},{"id":"manas-2010:p0892:b001:l012","ordinal":39230,"en":"She is a precious soul, he says."},{"id":"manas-2010:p0892:b001:l013","ordinal":39231,"en":"To exactly fourteen"},{"id":"manas-2010:p0892:b001:l014","ordinal":39232,"en":"She has now grown, he says."},{"id":"manas-2010:p0892:b001:l015","ordinal":39233,"en":"Looking at her stature,"},{"id":"manas-2010:p0892:b001:l016","ordinal":39234,"en":"A beauty of dusky complexion,"},{"id":"manas-2010:p0892:b001:l017","ordinal":39235,"en":"A radiant one among Muslims."},{"id":"manas-2010:p0892:b001:l018","ordinal":39236,"en":"The youngest of twelve daughters,"},{"id":"manas-2010:p0892:b001:l019","ordinal":39237,"en":"A servant beloved of God."},{"id":"manas-2010:p0892:b001:l020","ordinal":39238,"en":"Her disposition is good, I hear."},{"id":"manas-2010:p0892:b001:l021","ordinal":39239,"en":"Precious scarlet silk,"},{"id":"manas-2010:p0892:b001:l022","ordinal":39240,"en":"Spoken of in books,"},{"id":"manas-2010:p0892:b001:l023","ordinal":39241,"en":"A radiant maiden of paradise."},{"id":"manas-2010:p0892:b001:l024","ordinal":39242,"en":"One fault of the hapless girl:"},{"id":"manas-2010:p0892:b001:l025","ordinal":39243,"en":"Her forehead bone slopes back, he says."},{"id":"manas-2010:p0892:b001:l026","ordinal":39244,"en":"After the warrior passes away,"},{"id":"manas-2010:p0892:b001:l027","ordinal":39245,"en":"Her livelihood will be meager, he says."},{"id":"manas-2010:p0892:b001:l028","ordinal":39246,"en":"The hair at her nape is grass, he said."},{"id":"manas-2010:p0892:b001:l029","ordinal":39247,"en":"When the precious one's eyes close,"},{"id":"manas-2010:p0892:b001:l030","ordinal":39248,"en":"That hapless one's troubles will be many, he said."},{"id":"manas-2010:p0892:b001:l031","ordinal":39249,"en":"The hardship of six months ahead"},{"id":"manas-2010:p0892:b001:l032","ordinal":39250,"en":"She can tell at this very moment."},{"id":"manas-2010:p0892:b001:l033","ordinal":39251,"en":"A true seer, he called her;"},{"id":"manas-2010:p0892:b001:l034","ordinal":39252,"en":"These were Aykhozho's words."},{"id":"manas-2010:p0892:b001:l035","ordinal":39253,"en":"For you yourself, my magnanimous one,"},{"id":"manas-2010:p0892:b001:l036","ordinal":39254,"en":"He said she was worthy!"},{"id":"manas-2010:p0892:b001:l037","ordinal":39255,"en":"We shall camp in the open wilderness;"},{"id":"manas-2010:p0892:b001:l038","ordinal":39256,"en":"If my sultan remains safe,"},{"id":"manas-2010:p0892:b001:l039","ordinal":39257,"en":"With that hapless Kanykey"},{"id":"manas-2010:p0892:b001:l040","ordinal":39258,"en":"We shall part without battle!"},{"id":"manas-2010:p0892:b001:l041","ordinal":39259,"en":"Judge what sort of person she is."},{"id":"manas-2010:p0892:b001:l042","ordinal":39260,"en":"Magnanimous Manas, if you heed me,"},{"id":"manas-2010:p0893:b001:l001","ordinal":39261,"en":"Take Kanykey as your wife,"},{"id":"manas-2010:p0893:b001:l002","ordinal":39262,"en":"And go through life with her!"},{"id":"manas-2010:p0893:b001:l003","ordinal":39263,"en":"If Kanykey meets you,"},{"id":"manas-2010:p0893:b001:l004","ordinal":39264,"en":"She will restore what you have lost."},{"id":"manas-2010:p0893:b001:l005","ordinal":39265,"en":"Do not belittle such a fierce woman;"},{"id":"manas-2010:p0893:b001:l006","ordinal":39266,"en":"She will make good your shortcomings."},{"id":"manas-2010:p0893:b001:l007","ordinal":39267,"en":"She will understand a twitch of your brow."},{"id":"manas-2010:p0893:b001:l008","ordinal":39268,"en":"Kanykey will not cause you grief,"},{"id":"manas-2010:p0893:b001:l009","ordinal":39269,"en":"Will not make your head ache!"},{"id":"manas-2010:p0893:b001:l010","ordinal":39270,"en":"What your khan elder Bakay has said,"},{"id":"manas-2010:p0893:b001:l011","ordinal":39271,"en":"Consider, Manas, and judge for yourself."},{"id":"manas-2010:p0893:b001:l012","ordinal":39272,"en":"If you should take Kanykey,"},{"id":"manas-2010:p0893:b001:l013","ordinal":39273,"en":"She is not Kanykey but the Night of Power."},{"id":"manas-2010:p0893:b001:l014","ordinal":39274,"en":"If you take Kanykey, my blue-maned one,"},{"id":"manas-2010:p0893:b001:l015","ordinal":39275,"en":"All yearning will cease,"},{"id":"manas-2010:p0893:b001:l016","ordinal":39276,"en":"All misfortune will be undone!"},{"id":"manas-2010:p0893:b001:l017","ordinal":39277,"en":"That hapless Kanykey"},{"id":"manas-2010:p0893:b001:l018","ordinal":39278,"en":"Will hear your words unwaveringly."},{"id":"manas-2010:p0893:b001:l019","ordinal":39279,"en":"If fate grants you safely to take her,"},{"id":"manas-2010:p0893:b001:l020","ordinal":39280,"en":"She will make you a king!"},{"id":"manas-2010:p0893:b001:l021","ordinal":39281,"en":"If you take Kanykey,"},{"id":"manas-2010:p0893:b001:l022","ordinal":39282,"en":"Bulletproof armor will settle on your back."},{"id":"manas-2010:p0893:b001:l023","ordinal":39283,"en":"The strongest of every people,"},{"id":"manas-2010:p0893:b001:l024","ordinal":39284,"en":"Mighty warriors will come into your hands!"},{"id":"manas-2010:p0893:b001:l025","ordinal":39285,"en":"There will be benefit for your blood;"},{"id":"manas-2010:p0893:b001:l026","ordinal":39286,"en":"Kanykey will be a companion"},{"id":"manas-2010:p0893:b001:l027","ordinal":39287,"en":"To you, your father's only son."},{"id":"manas-2010:p0893:b001:l028","ordinal":39288,"en":"She will reduce your enemies to one;"},{"id":"manas-2010:p0893:b001:l029","ordinal":39289,"en":"If you encounter Kanykey,"},{"id":"manas-2010:p0893:b001:l030","ordinal":39290,"en":"She will make your kin a thousand!"},{"id":"manas-2010:p0893:b001:l031","ordinal":39291,"en":"This unbeliever Kanykey,"},{"id":"manas-2010:p0893:b001:l032","ordinal":39292,"en":"If you meet her, will be your wisdom."},{"id":"manas-2010:p0893:b001:l033","ordinal":39293,"en":"Thrown into fire, she will not become ash;"},{"id":"manas-2010:p0893:b001:l034","ordinal":39294,"en":"Fallen among enemies, she will not become a slave."},{"id":"manas-2010:p0893:b001:l035","ordinal":39295,"en":"She is the cherished one, she is the wife;"},{"id":"manas-2010:p0893:b001:l036","ordinal":39296,"en":"She makes her woman's self a warrior,"},{"id":"manas-2010:p0893:b001:l037","ordinal":39297,"en":"Makes her own head a banner."},{"id":"manas-2010:p0893:b001:l038","ordinal":39298,"en":"The wife you have taken,"},{"id":"manas-2010:p0893:b001:l039","ordinal":39299,"en":"Shooruk's daughter Akylay—"},{"id":"manas-2010:p0893:b001:l040","ordinal":39300,"en":"How she rustles, wondrous girl!"},{"id":"manas-2010:p0893:b001:l041","ordinal":39301,"en":"When spoken to, she will not listen;"},{"id":"manas-2010:p0893:b001:l042","ordinal":39302,"en":"There is a gift."},{"id":"manas-2010:p0894:b001:l001","ordinal":39303,"en":"Coarse in disposition, cold in speech,"},{"id":"manas-2010:p0894:b001:l002","ordinal":39304,"en":"She is an utterly wretched soul!"},{"id":"manas-2010:p0894:b001:l003","ordinal":39305,"en":"Stingy toward her husband, utterly fierce!"},{"id":"manas-2010:p0894:b001:l004","ordinal":39306,"en":"That battered fierce woman"},{"id":"manas-2010:p0894:b001:l005","ordinal":39307,"en":"Has so much quarrelsomeness!"},{"id":"manas-2010:p0894:b001:l006","ordinal":39308,"en":"Warrior, your wife is haughty,"},{"id":"manas-2010:p0894:b001:l007","ordinal":39309,"en":"Your arrogant unbeliever!"},{"id":"manas-2010:p0894:b001:l008","ordinal":39310,"en":"If you live with Akylay,"},{"id":"manas-2010:p0894:b001:l009","ordinal":39311,"en":"I have told you; know it yourself."},{"id":"manas-2010:p0894:b001:l010","ordinal":39312,"en":"If you truly are a khan,"},{"id":"manas-2010:p0894:b001:l011","ordinal":39313,"en":"My magnanimous Manas, heed me!"},{"id":"manas-2010:p0894:b001:l012","ordinal":39314,"en":"If you live with Akylay,"},{"id":"manas-2010:p0894:b001:l013","ordinal":39315,"en":"Not one garment will leave your back."},{"id":"manas-2010:p0894:b001:l014","ordinal":39316,"en":"If she lets her cold words flow,"},{"id":"manas-2010:p0894:b001:l015","ordinal":39317,"en":"Mighty warriors will leave your hands!"},{"id":"manas-2010:p0894:b001:l016","ordinal":39318,"en":"Fond of men, insolent of mouth,"},{"id":"manas-2010:p0894:b001:l017","ordinal":39319,"en":"She can devise no counsel."},{"id":"manas-2010:p0894:b001:l018","ordinal":39320,"en":"There is no calamity like Akylay!"},{"id":"manas-2010:p0894:b001:l019","ordinal":39321,"en":"If you live with Akylay,"},{"id":"manas-2010:p0894:b001:l020","ordinal":39322,"en":"Know that this is what I say:"},{"id":"manas-2010:p0894:b001:l021","ordinal":39323,"en":"Your affairs will never prosper;"},{"id":"manas-2010:p0894:b001:l022","ordinal":39324,"en":"She will never bear a child."},{"id":"manas-2010:p0894:b001:l023","ordinal":39325,"en":"If you live with Akylay,"},{"id":"manas-2010:p0894:b001:l024","ordinal":39326,"en":"No one will come as your guest."},{"id":"manas-2010:p0894:b001:l025","ordinal":39327,"en":"Those who come will leave for the wilderness;"},{"id":"manas-2010:p0894:b001:l026","ordinal":39328,"en":"Your affairs will fall apart!"},{"id":"manas-2010:p0894:b001:l027","ordinal":39329,"en":"If you take Kanykey,"},{"id":"manas-2010:p0894:b001:l028","ordinal":39330,"en":"She is a soul with sacred power,"},{"id":"manas-2010:p0894:b001:l029","ordinal":39331,"en":"She is the source of blessing."},{"id":"manas-2010:p0894:b001:l030","ordinal":39332,"en":"If you are to take Kanykey,"},{"id":"manas-2010:p0894:b001:l031","ordinal":39333,"en":"She is the very Night of Power!"},{"id":"manas-2010:p0894:b001:l032","ordinal":39334,"en":"This year, Manas, if you heed me,"},{"id":"manas-2010:p0894:b001:l033","ordinal":39335,"en":"Let us scout thoroughly."},{"id":"manas-2010:p0894:b001:l034","ordinal":39336,"en":"When this year passes,"},{"id":"manas-2010:p0894:b001:l035","ordinal":39337,"en":"When the coming year arrives,"},{"id":"manas-2010:p0894:b001:l036","ordinal":39338,"en":"To Temirkan, khan of Bukhara,"},{"id":"manas-2010:p0894:b001:l037","ordinal":39339,"en":"Saying, “Give us Kanykey,”"},{"id":"manas-2010:p0894:b001:l038","ordinal":39340,"en":"Let us go to form a marriage alliance!"},{"id":"manas-2010:p0894:b001:l039","ordinal":39341,"en":"Bowing humbly, driving livestock,"},{"id":"manas-2010:p0894:b001:l040","ordinal":39342,"en":"Making the alliance, feasting on fat,"},{"id":"manas-2010:p0894:b001:l041","ordinal":39343,"en":"If we give countless treasures and livestock,"},{"id":"manas-2010:p0894:b001:l042","ordinal":39344,"en":"However many myriad beasts we give,"},{"id":"manas-2010:p0895:b001:l001","ordinal":39345,"en":"This will bring you blessing."},{"id":"manas-2010:p0895:b001:l002","ordinal":39346,"en":"Listen well to these words!"},{"id":"manas-2010:p0895:b001:l003","ordinal":39347,"en":"If you do not heed what is said,"},{"id":"manas-2010:p0895:b001:l004","ordinal":39348,"en":"Your fame will never spread."},{"id":"manas-2010:p0895:b001:l005","ordinal":39349,"en":"She will never let you reach your aim,"},{"id":"manas-2010:p0895:b001:l006","ordinal":39350,"en":"Your whore of a wife, Akylay!’"},{"id":"manas-2010:p0895:b001:l007","ordinal":39351,"en":"When Bakay said this,"},{"id":"manas-2010:p0895:b001:l008","ordinal":39352,"en":"Your royal lord obeyed."},{"id":"manas-2010:p0895:b001:l009","ordinal":39353,"en":"Taking many kinds of people,"},{"id":"manas-2010:p0895:b001:l010","ordinal":39354,"en":"Taking the khans Azhybay and Bakay,"},{"id":"manas-2010:p0895:b001:l011","ordinal":39355,"en":"Wearing out horses, exploring the land,"},{"id":"manas-2010:p0895:b001:l012","ordinal":39356,"en":"Releasing hounds, flying hunting birds,"},{"id":"manas-2010:p0895:b001:l013","ordinal":39357,"en":"Unhurried, the blue-maned warriors,"},{"id":"manas-2010:p0895:b001:l014","ordinal":39358,"en":"Wearing their horses to exhaustion,"},{"id":"manas-2010:p0895:b001:l015","ordinal":39359,"en":"Through the whole wide world"},{"id":"manas-2010:p0895:b001:l016","ordinal":39360,"en":"Traveled on hunting expeditions."},{"id":"manas-2010:p0895:b001:l017","ordinal":39361,"en":"When bored, they shot roe deer;"},{"id":"manas-2010:p0895:b001:l018","ordinal":39362,"en":"When not bored, in the wilderness"},{"id":"manas-2010:p0895:b001:l019","ordinal":39363,"en":"They played at ease."},{"id":"manas-2010:p0895:b001:l020","ordinal":39364,"en":"Seeking wild asses, searching for game,"},{"id":"manas-2010:p0895:b001:l021","ordinal":39365,"en":"They swept down Zheek-Moynok."},{"id":"manas-2010:p0895:b001:l022","ordinal":39366,"en":"On this side of Samarkand,"},{"id":"manas-2010:p0895:b001:l023","ordinal":39367,"en":"They traveled along the broad open plain."},{"id":"manas-2010:p0895:b001:l024","ordinal":39368,"en":"To the broad yellow plain,"},{"id":"manas-2010:p0895:b001:l025","ordinal":39369,"en":"When they went scouting,"},{"id":"manas-2010:p0895:b001:l026","ordinal":39370,"en":"There was Lord Khan Manas,"},{"id":"manas-2010:p0895:b001:l027","ordinal":39371,"en":"Azhybay and Bakay were there too."},{"id":"manas-2010:p0895:b001:l028","ordinal":39372,"en":"Making the unknown known,"},{"id":"manas-2010:p0895:b001:l029","ordinal":39373,"en":"Bakay was exceedingly learned."},{"id":"manas-2010:p0895:b001:l030","ordinal":39374,"en":"That elder Bakay,"},{"id":"manas-2010:p0895:b001:l031","ordinal":39375,"en":"Up a ridge shaped like a saddle back,"},{"id":"manas-2010:p0895:b001:l032","ordinal":39376,"en":"Rode to the top."},{"id":"manas-2010:p0895:b001:l033","ordinal":39377,"en":"He turned his steed."},{"id":"manas-2010:p0895:b001:l034","ordinal":39378,"en":"Your falcon elder Bakay"},{"id":"manas-2010:p0895:b001:l035","ordinal":39379,"en":"Looked out to the side."},{"id":"manas-2010:p0895:b001:l036","ordinal":39380,"en":"The well-known elder,"},{"id":"manas-2010:p0895:b001:l037","ordinal":39381,"en":"Champion Manas's dear friend,"},{"id":"manas-2010:p0895:b001:l038","ordinal":39382,"en":"Champion Bakay the saint,"},{"id":"manas-2010:p0895:b001:l039","ordinal":39383,"en":"Climbed a hill and shouted."},{"id":"manas-2010:p0895:b001:l040","ordinal":39384,"en":"To Azhybay and Manas,"},{"id":"manas-2010:p0895:b001:l041","ordinal":39385,"en":"“Come here!” he called."},{"id":"manas-2010:p0895:b001:l042","ordinal":39386,"en":"All the warriors raced,"},{"id":"manas-2010:p0896:b001:l001","ordinal":39387,"en":"Before a word could be spoken,"},{"id":"manas-2010:p0896:b001:l002","ordinal":39388,"en":"In the opening and closing of an eye,"},{"id":"manas-2010:p0896:b001:l003","ordinal":39389,"en":"To the side of hero Bakay"},{"id":"manas-2010:p0896:b001:l004","ordinal":39390,"en":"They all arrived."},{"id":"manas-2010:p0896:b001:l005","ordinal":39391,"en":"“Oh, my child, youngest of the six lions,"},{"id":"manas-2010:p0896:b001:l006","ordinal":39392,"en":"My lion, here you stand;"},{"id":"manas-2010:p0896:b001:l007","ordinal":39393,"en":"Ajybay, son of Khan Argyn,"},{"id":"manas-2010:p0896:b001:l008","ordinal":39394,"en":"My warrior, here you stand."},{"id":"manas-2010:p0896:b001:l009","ordinal":39395,"en":"My child, you have no house built in Talas;"},{"id":"manas-2010:p0896:b001:l010","ordinal":39396,"en":"This is no time to lie sprawling!"},{"id":"manas-2010:p0896:b001:l011","ordinal":39397,"en":"You have no orchard planted in Keng-Kol;"},{"id":"manas-2010:p0896:b001:l012","ordinal":39398,"en":"This is no time to lie stretched out!"},{"id":"manas-2010:p0896:b001:l013","ordinal":39399,"en":"A whole otter pelt"},{"id":"manas-2010:p0896:b001:l014","ordinal":39400,"en":"You would slit apart,"},{"id":"manas-2010:p0896:b001:l015","ordinal":39401,"en":"Use it to trim your trouser cuffs,"},{"id":"manas-2010:p0896:b001:l016","ordinal":39402,"en":"And play chess with a great commotion—"},{"id":"manas-2010:p0896:b001:l017","ordinal":39403,"en":"This is not your time of leisure in Talas."},{"id":"manas-2010:p0896:b001:l018","ordinal":39404,"en":"Did you see what I saw?"},{"id":"manas-2010:p0896:b001:l019","ordinal":39405,"en":"Did you know what I knew?"},{"id":"manas-2010:p0896:b001:l020","ordinal":39406,"en":"If you did not see what I saw,"},{"id":"manas-2010:p0896:b001:l021","ordinal":39407,"en":"The man you have been seeking"},{"id":"manas-2010:p0896:b001:l022","ordinal":39408,"en":"Will be found on the open plain;"},{"id":"manas-2010:p0896:b001:l023","ordinal":39409,"en":"Your expedition may prosper."},{"id":"manas-2010:p0896:b001:l024","ordinal":39410,"en":"Your tiger may come into your hands;"},{"id":"manas-2010:p0896:b001:l025","ordinal":39411,"en":"God himself may grant him!"},{"id":"manas-2010:p0896:b001:l026","ordinal":39412,"en":"Chubak, son of Khan Baltay,"},{"id":"manas-2010:p0896:b001:l027","ordinal":39413,"en":"Akbaltay's dear son,"},{"id":"manas-2010:p0896:b001:l028","ordinal":39414,"en":"Was a warrior equal to yourself;"},{"id":"manas-2010:p0896:b001:l029","ordinal":39415,"en":"It seems the hero Chubak is coming!"},{"id":"manas-2010:p0896:b001:l030","ordinal":39416,"en":"There, in the haze beyond sight,"},{"id":"manas-2010:p0896:b001:l031","ordinal":39417,"en":"On this side of the haze,"},{"id":"manas-2010:p0896:b001:l032","ordinal":39418,"en":"Upon the moon-bright yellow plain,"},{"id":"manas-2010:p0896:b001:l033","ordinal":39419,"en":"Dust wells up again and again."},{"id":"manas-2010:p0896:b001:l034","ordinal":39420,"en":"When I look at that rising dust,"},{"id":"manas-2010:p0896:b001:l035","ordinal":39421,"en":"The mount beneath him"},{"id":"manas-2010:p0896:b001:l036","ordinal":39422,"en":"Is an exceptional winged steed;"},{"id":"manas-2010:p0896:b001:l037","ordinal":39423,"en":"The man upon it"},{"id":"manas-2010:p0896:b001:l038","ordinal":39424,"en":"As huge as a mountain,"}]
