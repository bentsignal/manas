[{"id":"semetey-1-2013:p0998:b004:l005","ordinal":152321,"en":"Taking eighty wrestlers as attendants,"},{"id":"semetey-1-2013:p0998:b004:l006","ordinal":152322,"en":"While he was out hunting,"},{"id":"semetey-1-2013:p0998:b004:l007","ordinal":152323,"en":"Found Churok there."},{"id":"semetey-1-2013:p0998:b004:l008","ordinal":152324,"en":"Her miraculous power was unlike all others,"},{"id":"semetey-1-2013:p0998:b004:l009","ordinal":152325,"en":"Proud-standing Churok, the noble champion."},{"id":"semetey-1-2013:p0998:b004:l010","ordinal":152326,"en":"That discerning sister-in-law of yours had learned,"},{"id":"semetey-1-2013:p0998:b004:l011","ordinal":152327,"en":"\"My tiger lord, my Bloodthirsty One,"},{"id":"semetey-1-2013:p0998:b004:l012","ordinal":152328,"en":"Must be coming,\" she had thought."},{"id":"semetey-1-2013:p0998:b004:l013","ordinal":152329,"en":"\"Driving his train behind him,"},{"id":"semetey-1-2013:p0998:b004:l014","ordinal":152330,"en":"Because of his longing for Akshunkar,"},{"id":"semetey-1-2013:p0998:b004:l015","ordinal":152331,"en":"If the tiger's ardor rises,"},{"id":"semetey-1-2013:p0998:b004:l016","ordinal":152332,"en":"He will reach Opol;"},{"id":"semetey-1-2013:p0998:b004:l017","ordinal":152333,"en":"If the tiger's ardor rises,"},{"id":"semetey-1-2013:p0998:b004:l018","ordinal":152334,"en":"He will pursue the matter to its very end.\""},{"id":"semetey-1-2013:p0998:b004:l019","ordinal":152335,"en":"From the beginning, everything she had done"},{"id":"semetey-1-2013:p0998:b004:l020","ordinal":152336,"en":"Had been done in preparation;"},{"id":"semetey-1-2013:p0998:b004:l021","ordinal":152337,"en":"Devastating Aychurok"},{"id":"semetey-1-2013:p0998:b004:l022","ordinal":152338,"en":"Had gone out to await"},{"id":"semetey-1-2013:p0998:b004:l023","ordinal":152339,"en":"Her rough lord and husband."},{"id":"semetey-1-2013:p0998:b004:l024","ordinal":152340,"en":"She heard reports from those who came,"},{"id":"semetey-1-2013:p0998:b004:l025","ordinal":152341,"en":"And listened closely to knowledgeable people;"},{"id":"semetey-1-2013:p0998:b004:l026","ordinal":152342,"en":"She heard them say, \"Semetey,"},{"id":"semetey-1-2013:p0998:b004:l027","ordinal":152343,"en":"Son of the Magnanimous Manas,"},{"id":"semetey-1-2013:p0998:b004:l028","ordinal":152344,"en":"Would die for liquor and women.\""},{"id":"semetey-1-2013:p0998:b004:l029","ordinal":152345,"en":"When Aychurok heard this,"},{"id":"semetey-1-2013:p0998:b004:l030","ordinal":152346,"en":"She gathered women and skilled craftswomen,"},{"id":"semetey-1-2013:p0998:b004:l031","ordinal":152347,"en":"And exceptionally beautiful maidens"},{"id":"semetey-1-2013:p0998:b004:l032","ordinal":152348,"en":"Who had brushed themselves with powder and rouge."},{"id":"semetey-1-2013:p0998:b004:l033","ordinal":152349,"en":"Within the city of Akun Khan,"},{"id":"semetey-1-2013:p0998:b004:l034","ordinal":152350,"en":"Without letting a single person know,"},{"id":"semetey-1-2013:p0998:b004:l035","ordinal":152351,"en":"Without letting a single person perceive it,"},{"id":"semetey-1-2013:p0998:b004:l036","ordinal":152352,"en":"She chose maidens from among the Afghans."},{"id":"semetey-1-2013:p0998:b004:l037","ordinal":152353,"en":"Aychurok did not hold back"},{"id":"semetey-1-2013:p0998:b004:l038","ordinal":152354,"en":"From the radiant, red-cheeked beauties,"},{"id":"semetey-1-2013:p0998:b004:l039","ordinal":152355,"en":"In crimson dresses with ribboned waists,"}]
