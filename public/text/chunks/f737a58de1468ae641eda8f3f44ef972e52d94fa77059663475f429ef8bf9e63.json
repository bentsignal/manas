[{"id":"semetey-1-2013:p1162:b003:l037","ordinal":164865,"en":"And our honored sister-in-law Kanykei—"},{"id":"semetey-1-2013:p1162:b003:l038","ordinal":164866,"en":"The bloodthirsty man will cut off her head."},{"id":"semetey-1-2013:p1162:b003:l039","ordinal":164867,"en":"He will put to death"},{"id":"semetey-1-2013:p1162:b004:l001","ordinal":164868,"en":"Our resourceful treasure,"},{"id":"semetey-1-2013:p1162:b004:l002","ordinal":164869,"en":"Our lionhearted, fierce sister-in-law.”"},{"id":"semetey-1-2013:p1162:b004:l003","ordinal":164870,"en":"Agybay, son of Argyn Khan,"},{"id":"semetey-1-2013:p1162:b004:l004","ordinal":164871,"en":"Stepped between them."},{"id":"semetey-1-2013:p1162:b004:l005","ordinal":164872,"en":"Brave Bakai, son of Oloyat,"},{"id":"semetey-1-2013:p1162:b004:l006","ordinal":164873,"en":"Seized the bloodthirsty man"},{"id":"semetey-1-2013:p1162:b004:l007","ordinal":164874,"en":"And held him back as he thrashed in fury."},{"id":"semetey-1-2013:p1162:b004:l008","ordinal":164875,"en":"Almambet, son of Khan Azozül,"},{"id":"semetey-1-2013:p1162:b004:l009","ordinal":164876,"en":"Saying, “Hero, restrain your anger,”"},{"id":"semetey-1-2013:p1162:b004:l010","ordinal":164877,"en":"Intervened and stopped him."},{"id":"semetey-1-2013:p1162:b004:l011","ordinal":164878,"en":"When Manas lunged at their sister-in-law,"},{"id":"semetey-1-2013:p1162:b004:l012","ordinal":164879,"en":"All forty companions,"},{"id":"semetey-1-2013:p1162:b004:l013","ordinal":164880,"en":"As if disaster had struck them,"},{"id":"semetey-1-2013:p1162:b004:l014","ordinal":164881,"en":"The old and gray-haired among them"},{"id":"semetey-1-2013:p1162:b004:l015","ordinal":164882,"en":"Staggered, understanding what had happened."},{"id":"semetey-1-2013:p1162:b004:l016","ordinal":164883,"en":"All forty companions said,"},{"id":"semetey-1-2013:p1162:b004:l017","ordinal":164884,"en":"“Why should we look to"},{"id":"semetey-1-2013:p1162:b004:l018","ordinal":164885,"en":"A bloodthirsty man who slaughters his wife?"},{"id":"semetey-1-2013:p1162:b004:l019","ordinal":164886,"en":"All forty of us are sons of forty khans;"},{"id":"semetey-1-2013:p1162:b004:l020","ordinal":164887,"en":"Let us all disperse"},{"id":"semetey-1-2013:p1162:b004:l021","ordinal":164888,"en":"And return to our own lands.”"},{"id":"semetey-1-2013:p1162:b004:l022","ordinal":164889,"en":"The forty companions bristled"},{"id":"semetey-1-2013:p1162:b004:l023","ordinal":164890,"en":"And glowered at Manas:"},{"id":"semetey-1-2013:p1162:b004:l024","ordinal":164891,"en":"“He obeyed at once"},{"id":"semetey-1-2013:p1162:b004:l025","ordinal":164892,"en":"The fool whose trousers would not fit;"},{"id":"semetey-1-2013:p1162:b004:l026","ordinal":164893,"en":"Preparing to kill"},{"id":"semetey-1-2013:p1162:b004:l027","ordinal":164894,"en":"Kanykei, our true treasure,"},{"id":"semetey-1-2013:p1162:b004:l028","ordinal":164895,"en":"God has taken leave of the bloodthirsty man."},{"id":"semetey-1-2013:p1162:b004:l029","ordinal":164896,"en":"We became Manas's companions;"},{"id":"semetey-1-2013:p1162:b004:l030","ordinal":164897,"en":"Why should we stand here for nothing?"},{"id":"semetey-1-2013:p1162:b004:l031","ordinal":164898,"en":"If he attacks Kanykei,"},{"id":"semetey-1-2013:p1162:b004:l032","ordinal":164899,"en":"Let us grapple"},{"id":"semetey-1-2013:p1162:b004:l033","ordinal":164900,"en":"With the bloodthirsty man, mighty as Kambar."},{"id":"semetey-1-2013:p1162:b004:l034","ordinal":164901,"en":"We forty companions came from many lands;"},{"id":"semetey-1-2013:p1162:b004:l035","ordinal":164902,"en":"Kanykei became our refuge."},{"id":"semetey-1-2013:p1162:b004:l036","ordinal":164903,"en":"She joined what was severed"},{"id":"semetey-1-2013:p1162:b004:l037","ordinal":164904,"en":"And gathered what was scattered."},{"id":"semetey-1-2013:p1162:b004:l038","ordinal":164905,"en":"By laying course upon course, she made a house;"},{"id":"semetey-1-2013:p1162:b004:l039","ordinal":164906,"en":"By planting shoot upon shoot, she made a garden."}]
