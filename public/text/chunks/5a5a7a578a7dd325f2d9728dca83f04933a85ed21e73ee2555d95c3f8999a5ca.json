[{"id":"semetey-1-2013:p1042:b004:l026","ordinal":156673,"en":"She had known plainly beforehand"},{"id":"semetey-1-2013:p1042:b004:l027","ordinal":156674,"en":"That the heroic princely conqueror would come."},{"id":"semetey-1-2013:p1042:b004:l028","ordinal":156675,"en":"\"The descendant of the formidable lion"},{"id":"semetey-1-2013:p1042:b004:l029","ordinal":156676,"en":"Will surely come,\" she had thought,"},{"id":"semetey-1-2013:p1042:b004:l030","ordinal":156677,"en":"And your sister-in-law stood preparing."},{"id":"semetey-1-2013:p1042:b004:l031","ordinal":156678,"en":"For the fourteen horses she made coverings"},{"id":"semetey-1-2013:p1042:b004:l032","ordinal":156679,"en":"Fashioned in the likeness of tigers."},{"id":"semetey-1-2013:p1042:b004:l033","ordinal":156680,"en":"She had their insides lined with fine velvet,"},{"id":"semetey-1-2013:p1042:b004:l034","ordinal":156681,"en":"And maidens and young women bite down the seams;"},{"id":"semetey-1-2013:p1042:b004:l035","ordinal":156682,"en":"She had golden beads set along their edges,"},{"id":"semetey-1-2013:p1042:b004:l036","ordinal":156683,"en":"And their faces embroidered wholly in silk,"},{"id":"semetey-1-2013:p1042:b004:l037","ordinal":156684,"en":"Had the pile twisted thick and shaggy,"},{"id":"semetey-1-2013:p1042:b004:l038","ordinal":156685,"en":"So that to anyone who saw their color"},{"id":"semetey-1-2013:p1042:b004:l039","ordinal":156686,"en":"They bore the very likeness of a tiger,"},{"id":"semetey-1-2013:p1043:b003:l001","ordinal":156687,"en":"And had them draped over the fourteen horses,"},{"id":"semetey-1-2013:p1043:b003:l002","ordinal":156688,"en":"Each tethered separately."},{"id":"semetey-1-2013:p1043:b003:l003","ordinal":156689,"en":"All fourteen horses"},{"id":"semetey-1-2013:p1043:b003:l004","ordinal":156690,"en":"She had strain beyond measure;"},{"id":"semetey-1-2013:p1043:b003:l005","ordinal":156691,"en":"At the edge of the fourteen horses,"},{"id":"semetey-1-2013:p1043:b003:l006","ordinal":156692,"en":"She had the towering Buurul"},{"id":"semetey-1-2013:p1043:b003:l007","ordinal":156693,"en":"Toss like one whose master had died."},{"id":"semetey-1-2013:p1043:b003:l008","ordinal":156694,"en":"The coverings of the fourteen horses—"},{"id":"semetey-1-2013:p1043:b003:l009","ordinal":156695,"en":"Hoof matched to hoof,"},{"id":"semetey-1-2013:p1043:b003:l010","ordinal":156696,"en":"Made exactly like a tiger;"},{"id":"semetey-1-2013:p1043:b003:l011","ordinal":156697,"en":"Ear matched to ear,"},{"id":"semetey-1-2013:p1043:b003:l012","ordinal":156698,"en":"Made wholly like a tiger."},{"id":"semetey-1-2013:p1043:b003:l013","ordinal":156699,"en":"On this side of the horses,"},{"id":"semetey-1-2013:p1043:b003:l014","ordinal":156700,"en":"\"Let no person see,\" she said,"},{"id":"semetey-1-2013:p1043:b003:l015","ordinal":156701,"en":"And had a splendid screen erected,"},{"id":"semetey-1-2013:p1043:b003:l016","ordinal":156702,"en":"With a white curtain drawn."},{"id":"semetey-1-2013:p1043:b003:l017","ordinal":156703,"en":"The luckless daughter of Akun,"},{"id":"semetey-1-2013:p1043:b003:l018","ordinal":156704,"en":"Displaying her distinction,"},{"id":"semetey-1-2013:p1043:b003:l019","ordinal":156705,"en":"Presented surpassing games and revelry"},{"id":"semetey-1-2013:p1043:b003:l020","ordinal":156706,"en":"To the gray-maned hero."},{"id":"semetey-1-2013:p1043:b003:l021","ordinal":156707,"en":"\"My precious prince has come,"},{"id":"semetey-1-2013:p1043:b003:l022","ordinal":156708,"en":"And God has granted my wish,\" she said."},{"id":"semetey-1-2013:p1043:b003:l023","ordinal":156709,"en":"Some sixty unbred mares"},{"id":"semetey-1-2013:p1043:b003:l024","ordinal":156710,"en":"She had slaughtered for his food,"},{"id":"semetey-1-2013:p1043:b003:l025","ordinal":156711,"en":"And upon gilded platters"},{"id":"semetey-1-2013:p1043:b003:l026","ordinal":156712,"en":"Had carved meat set out."},{"id":"semetey-1-2013:p1043:b003:l027","ordinal":156713,"en":"Your dear sister-in-law Chürök"},{"id":"semetey-1-2013:p1043:b003:l028","ordinal":156714,"en":"Had a curtain made from pure silk,"},{"id":"semetey-1-2013:p1043:b003:l029","ordinal":156715,"en":"Held and stretched from its sides,"},{"id":"semetey-1-2013:p1043:b003:l030","ordinal":156716,"en":"Raising her honor above the people"},{"id":"semetey-1-2013:p1043:b003:l031","ordinal":156717,"en":"And satisfying the affection of all who saw."},{"id":"semetey-1-2013:p1043:b003:l032","ordinal":156718,"en":"From silk quilts of every kind,"},{"id":"semetey-1-2013:p1043:b003:l033","ordinal":156719,"en":"Thirty young women and thirty maidens"},{"id":"semetey-1-2013:p1043:b003:l034","ordinal":156720,"en":"Had luxurious bedding spread."},{"id":"semetey-1-2013:p1043:b003:l035","ordinal":156721,"en":"Thirty young women and thirty maidens"},{"id":"semetey-1-2013:p1043:b003:l036","ordinal":156722,"en":"She had open their saddlebags,"},{"id":"semetey-1-2013:p1043:b003:l037","ordinal":156723,"en":"And for the custom called zhengetay,"},{"id":"semetey-1-2013:p1043:b003:l038","ordinal":156724,"en":"From pounds of golden embroidery thread,"},{"id":"semetey-1-2013:p1043:b003:l039","ordinal":156725,"en":"She had gifts scattered to them all,"},{"id":"semetey-1-2013:p1043:b005:l001","ordinal":156726,"en":"Winning their agreement with her wishes"},{"id":"semetey-1-2013:p1043:b005:l002","ordinal":156727,"en":"And duly giving the customary gift."},{"id":"semetey-1-2013:p1043:b005:l003","ordinal":156728,"en":"If you look upon these games,"},{"id":"semetey-1-2013:p1043:b005:l004","ordinal":156729,"en":"Aychürök, whom you have seen,"},{"id":"semetey-1-2013:p1043:b005:l005","ordinal":156730,"en":"Now staged the revelry."},{"id":"semetey-1-2013:p1043:b005:l006","ordinal":156731,"en":"Her dear head beheld joy,"},{"id":"semetey-1-2013:p1043:b005:l007","ordinal":156732,"en":"With maidens and young men mingled together."},{"id":"semetey-1-2013:p1043:b005:l008","ordinal":156733,"en":"Yesterday, your honored sister-in-law Aychürök,"},{"id":"semetey-1-2013:p1043:b005:l009","ordinal":156734,"en":"Hearing words from those who had come,"},{"id":"semetey-1-2013:p1043:b005:l010","ordinal":156735,"en":"Heard that, \"If he sees kumis and a maiden,"},{"id":"semetey-1-2013:p1043:b005:l011","ordinal":156736,"en":"The princely leopard and falcon"},{"id":"semetey-1-2013:p1043:b005:l012","ordinal":156737,"en":"Will die of delight.\""},{"id":"semetey-1-2013:p1043:b005:l013","ordinal":156738,"en":"She prepared things in every fashion;"},{"id":"semetey-1-2013:p1043:b005:l014","ordinal":156739,"en":"Of all that could be prepared,"},{"id":"semetey-1-2013:p1043:b005:l015","ordinal":156740,"en":"Nothing at all was lacking with Chürök."},{"id":"semetey-1-2013:p1043:b005:l016","ordinal":156741,"en":"Eighty young women and eighty maidens,"},{"id":"semetey-1-2013:p1043:b005:l017","ordinal":156742,"en":"Eighty young men and eighty lads"},{"id":"semetey-1-2013:p1043:b005:l018","ordinal":156743,"en":"Sprang about and held their games."},{"id":"semetey-1-2013:p1043:b005:l019","ordinal":156744,"en":"They twisted their kerchiefs"},{"id":"semetey-1-2013:p1043:b005:l020","ordinal":156745,"en":"Into clubs,"},{"id":"semetey-1-2013:p1043:b005:l021","ordinal":156746,"en":"Women and men mingled,"},{"id":"semetey-1-2013:p1043:b005:l022","ordinal":156747,"en":"Striking one another"},{"id":"semetey-1-2013:p1043:b005:l023","ordinal":156748,"en":"As they stood like this."},{"id":"semetey-1-2013:p1043:b005:l024","ordinal":156749,"en":"Women and men mingled,"},{"id":"semetey-1-2013:p1043:b005:l025","ordinal":156750,"en":"Taking turns with the kerchief-club,"},{"id":"semetey-1-2013:p1043:b005:l026","ordinal":156751,"en":"Striking the one each loved,"},{"id":"semetey-1-2013:p1043:b005:l027","ordinal":156752,"en":"And satisfying their desire in this way."},{"id":"semetey-1-2013:p1043:b005:l028","ordinal":156753,"en":"\"These are Aychürök's games,"},{"id":"semetey-1-2013:p1043:b005:l029","ordinal":156754,"en":"The wedding feast of Semetey,\" they said."},{"id":"semetey-1-2013:p1043:b005:l030","ordinal":156755,"en":"One woman and one man,"},{"id":"semetey-1-2013:p1043:b005:l031","ordinal":156756,"en":"Embracing, met as lovers,"},{"id":"semetey-1-2013:p1043:b005:l032","ordinal":156757,"en":"And kissed to ease their longing."},{"id":"semetey-1-2013:p1043:b005:l033","ordinal":156758,"en":"The men sang,"},{"id":"semetey-1-2013:p1043:b005:l034","ordinal":156759,"en":"The women listened,"},{"id":"semetey-1-2013:p1043:b005:l035","ordinal":156760,"en":"And played without tiring."},{"id":"semetey-1-2013:p1043:b005:l036","ordinal":156761,"en":"They went to those they loved,"},{"id":"semetey-1-2013:p1043:b005:l037","ordinal":156762,"en":"Drank kumis and grew merry,"},{"id":"semetey-1-2013:p1043:b005:l038","ordinal":156763,"en":"Their very bones growing warm;"},{"id":"semetey-1-2013:p1043:b005:l039","ordinal":156764,"en":"When one looked upon the edge of their bliss,"},{"id":"semetey-1-2013:p1044:b003:l001","ordinal":156765,"en":"Your dear sister-in-law Aychürök"},{"id":"semetey-1-2013:p1044:b003:l002","ordinal":156766,"en":"Staged revelry of this kind:"},{"id":"semetey-1-2013:p1044:b003:l003","ordinal":156767,"en":"\"Let my precious one enjoy himself;"},{"id":"semetey-1-2013:p1044:b003:l004","ordinal":156768,"en":"Without wondering, 'Where is my elder sister?'"},{"id":"semetey-1-2013:p1044:b003:l005","ordinal":156769,"en":"Or bringing us to mind,"},{"id":"semetey-1-2013:p1044:b003:l006","ordinal":156770,"en":"Let men and women"},{"id":"semetey-1-2013:p1044:b003:l007","ordinal":156771,"en":"Play delightful games,\" she said."},{"id":"semetey-1-2013:p1044:b003:l008","ordinal":156772,"en":"Wise Chürök devised this."},{"id":"semetey-1-2013:p1044:b003:l009","ordinal":156773,"en":"Earlier Chürök had provisions prepared:"},{"id":"semetey-1-2013:p1044:b003:l010","ordinal":156774,"en":"\"If there are games, let them drink.\""},{"id":"semetey-1-2013:p1044:b003:l011","ordinal":156775,"en":"There was black arak at the side,"},{"id":"semetey-1-2013:p1044:b003:l012","ordinal":156776,"en":"And arak in a Kalmyk-style flask."},{"id":"semetey-1-2013:p1044:b003:l013","ordinal":156777,"en":"Receiving Chürök's command,"},{"id":"semetey-1-2013:p1044:b003:l014","ordinal":156778,"en":"They all ran for the arak;"},{"id":"semetey-1-2013:p1044:b003:l015","ordinal":156779,"en":"A young man pulled the stopper and a maiden poured,"},{"id":"semetey-1-2013:p1044:b003:l016","ordinal":156780,"en":"And among the young women, poor Kermekash"},{"id":"semetey-1-2013:p1044:b003:l017","ordinal":156781,"en":"Held it out."},{"id":"semetey-1-2013:p1044:b003:l018","ordinal":156782,"en":"They poured it into wooden bowls,"},{"id":"semetey-1-2013:p1044:b003:l019","ordinal":156783,"en":"And all gathered round."},{"id":"semetey-1-2013:p1044:b003:l020","ordinal":156784,"en":"They found delight in the games,"},{"id":"semetey-1-2013:p1044:b003:l021","ordinal":156785,"en":"Leaving not one person empty-handed,"},{"id":"semetey-1-2013:p1044:b003:l022","ordinal":156786,"en":"And exchanged sarymerden verses."},{"id":"semetey-1-2013:p1044:b003:l023","ordinal":156787,"en":"Drinking arak and raising a din,"},{"id":"semetey-1-2013:p1044:b003:l024","ordinal":156788,"en":"Women and men mingled"},{"id":"semetey-1-2013:p1044:b003:l025","ordinal":156789,"en":"And entered into the clamor;"},{"id":"semetey-1-2013:p1044:b003:l026","ordinal":156790,"en":"An irrepressible merriment"},{"id":"semetey-1-2013:p1044:b003:l027","ordinal":156791,"en":"Had entered the festive throng."},{"id":"semetey-1-2013:p1044:b003:l028","ordinal":156792,"en":"They played in pairs,"},{"id":"semetey-1-2013:p1044:b003:l029","ordinal":156793,"en":"One woman and one man—"},{"id":"semetey-1-2013:p1044:b003:l030","ordinal":156794,"en":"If you would see games, see them here."},{"id":"semetey-1-2013:p1044:b003:l031","ordinal":156795,"en":"They led one another away,"},{"id":"semetey-1-2013:p1044:b003:l032","ordinal":156796,"en":"Coupling two by two;"},{"id":"semetey-1-2013:p1044:b003:l033","ordinal":156797,"en":"Many there were behaving badly."},{"id":"semetey-1-2013:p1044:b003:l034","ordinal":156798,"en":"\"Come now, what kind of person are you?"},{"id":"semetey-1-2013:p1044:b003:l035","ordinal":156799,"en":"You will tell someone,"},{"id":"semetey-1-2013:p1044:b003:l036","ordinal":156800,"en":"And mock me with the tale,\" they said;"},{"id":"semetey-1-2013:p1044:b003:l037","ordinal":156801,"en":"Many quarreled with young men,"},{"id":"semetey-1-2013:p1044:b003:l038","ordinal":156802,"en":"And would not consent."},{"id":"semetey-1-2013:p1044:b003:l039","ordinal":156803,"en":"\"Oh heavens, here is gold,\" they said;"},{"id":"semetey-1-2013:p1044:b004:l001","ordinal":156804,"en":"Many more pleaded."},{"id":"semetey-1-2013:p1044:b004:l002","ordinal":156805,"en":"\"You have ruined what was mine,\" they said,"},{"id":"semetey-1-2013:p1044:b004:l003","ordinal":156806,"en":"Scowling at one another;"},{"id":"semetey-1-2013:p1044:b004:l004","ordinal":156807,"en":"Many took offense."},{"id":"semetey-1-2013:p1044:b004:l005","ordinal":156808,"en":"Their anger flared beyond words,"},{"id":"semetey-1-2013:p1044:b004:l006","ordinal":156809,"en":"And many grappled together;"},{"id":"semetey-1-2013:p1044:b004:l007","ordinal":156810,"en":"Out on the steppe, scowling,"},{"id":"semetey-1-2013:p1044:b004:l008","ordinal":156811,"en":"Many came to blows."},{"id":"semetey-1-2013:p1044:b004:l009","ordinal":156812,"en":"Gripping one another's waistbands,"},{"id":"semetey-1-2013:p1044:b004:l010","ordinal":156813,"en":"\"My love, please consent,\" they said;"},{"id":"semetey-1-2013:p1044:b004:l011","ordinal":156814,"en":"Many hurried about."},{"id":"semetey-1-2013:p1044:b004:l012","ordinal":156815,"en":"\"Someone will see us"},{"id":"semetey-1-2013:p1044:b004:l013","ordinal":156816,"en":"While we are doing it,\" they said;"},{"id":"semetey-1-2013:p1044:b004:l014","ordinal":156817,"en":"And many ran away."},{"id":"semetey-1-2013:p1044:b004:l019","ordinal":156818,"en":"Akylay, daughter of Shooruk,","gapBefore":"[Passage withheld: sexual content involving a minor]"},{"id":"semetey-1-2013:p1044:b004:l020","ordinal":156819,"en":"That lively poor girl,"},{"id":"semetey-1-2013:p1044:b004:l021","ordinal":156820,"en":"Was seized by Külchoro;"},{"id":"semetey-1-2013:p1044:b004:l022","ordinal":156821,"en":"They went to a dark place,"},{"id":"semetey-1-2013:p1044:b004:l023","ordinal":156822,"en":"And remained there embracing,"},{"id":"semetey-1-2013:p1044:b004:l024","ordinal":156823,"en":"Taking a shortcut by a narrow path."},{"id":"semetey-1-2013:p1044:b004:l025","ordinal":156824,"en":"Baytaylak, son of Bakay,"},{"id":"semetey-1-2013:p1044:b004:l026","ordinal":156825,"en":"Led Kermekash,"},{"id":"semetey-1-2013:p1044:b004:l027","ordinal":156826,"en":"The foremost of the young women;"},{"id":"semetey-1-2013:p1044:b004:l028","ordinal":156827,"en":"Kalyk of Sarykan"},{"id":"semetey-1-2013:p1044:b004:l029","ordinal":156828,"en":"Had taken hold of Umsunay;"},{"id":"semetey-1-2013:p1044:b004:l030","ordinal":156829,"en":"And Shayymbet, son of Zhamgyrchy,"},{"id":"semetey-1-2013:p1044:b004:l031","ordinal":156830,"en":"Mounted the beauty"},{"id":"semetey-1-2013:p1044:b004:l032","ordinal":156831,"en":"Named Ayymkan."},{"id":"semetey-1-2013:p1044:b004:l033","ordinal":156832,"en":"Women and men mingled,"},{"id":"semetey-1-2013:p1044:b004:l034","ordinal":156833,"en":"Played until they were spent;"},{"id":"semetey-1-2013:p1044:b004:l035","ordinal":156834,"en":"A great revel appeared."},{"id":"semetey-1-2013:p1044:b004:l036","ordinal":156835,"en":"They divided two by two,"},{"id":"semetey-1-2013:p1044:b004:l037","ordinal":156836,"en":"Finding the games delightful,"},{"id":"semetey-1-2013:p1044:b004:l038","ordinal":156837,"en":"And raced three-year-old horses against each other;"},{"id":"semetey-1-2013:p1044:b004:l039","ordinal":156838,"en":"Maidens and young men side by side,"},{"id":"semetey-1-2013:p1045:b003:l001","ordinal":156839,"en":"Such was the revelry she staged."},{"id":"semetey-1-2013:p1045:b003:l002","ordinal":156840,"en":"The games of maidens and young men—"},{"id":"semetey-1-2013:p1045:b003:l003","ordinal":156841,"en":"Let us leave them here like this."},{"id":"semetey-1-2013:p1045:b003:l004","ordinal":156842,"en":"Of your dear Chürök and Semetey,"},{"id":"semetey-1-2013:p1045:b003:l005","ordinal":156843,"en":"Let us now begin the tale."},{"id":"semetey-1-2013:p1045:b003:l006","ordinal":156844,"en":"Sixty pillows and forty quilts,"},{"id":"semetey-1-2013:p1045:b003:l007","ordinal":156845,"en":"She had lavishly spread as bedding;"},{"id":"semetey-1-2013:p1045:b003:l008","ordinal":156846,"en":"It was a wondrous spectacle,"},{"id":"semetey-1-2013:p1045:b003:l009","ordinal":156847,"en":"Filling the human heart with affection."},{"id":"semetey-1-2013:p1045:b003:l010","ordinal":156848,"en":"She had a curtain made of pure silk"},{"id":"semetey-1-2013:p1045:b003:l011","ordinal":156849,"en":"Stretched broadly across the wall;"},{"id":"semetey-1-2013:p1045:b003:l012","ordinal":156850,"en":"Aychürök, daughter of Akun,"},{"id":"semetey-1-2013:p1045:b003:l013","ordinal":156851,"en":"Increased her splendor in this way."},{"id":"semetey-1-2013:p1045:b003:l014","ordinal":156852,"en":"Her incomparable conqueror,"},{"id":"semetey-1-2013:p1045:b003:l015","ordinal":156853,"en":"Her princely leopard and sultan—"},{"id":"semetey-1-2013:p1045:b003:l016","ordinal":156854,"en":"Swiftly she removed his boots,"},{"id":"semetey-1-2013:p1045:b003:l017","ordinal":156855,"en":"And nimbly removed his clothes;"},{"id":"semetey-1-2013:p1045:b003:l018","ordinal":156856,"en":"She laid the prince and sultan down"},{"id":"semetey-1-2013:p1045:b003:l019","ordinal":156857,"en":"Upon the great bed for delight."},{"id":"semetey-1-2013:p1045:b003:l020","ordinal":156858,"en":"After the sultan had lain down,"},{"id":"semetey-1-2013:p1045:b003:l021","ordinal":156859,"en":"Aychürök, daughter of Akun—"},{"id":"semetey-1-2013:p1045:b003:l022","ordinal":156860,"en":"Know her purity from this—"},{"id":"semetey-1-2013:p1045:b003:l023","ordinal":156861,"en":"Now put her hands into water"},{"id":"semetey-1-2013:p1045:b003:l024","ordinal":156862,"en":"And performed the hand ablution;"},{"id":"semetey-1-2013:p1045:b003:l025","ordinal":156863,"en":"She poured the water of ghusl over herself,"},{"id":"semetey-1-2013:p1045:b003:l026","ordinal":156864,"en":"Purified herself and prepared,"},{"id":"semetey-1-2013:p1045:b003:l027","ordinal":156865,"en":"And prayed to the Almighty."},{"id":"semetey-1-2013:p1045:b003:l028","ordinal":156866,"en":"Preparing to lie in the embrace"},{"id":"semetey-1-2013:p1045:b003:l029","ordinal":156867,"en":"Of the poor sultan,"},{"id":"semetey-1-2013:p1045:b003:l030","ordinal":156868,"en":"\"If only I reach my gray-maned wolf,\" she thought;"},{"id":"semetey-1-2013:p1045:b003:l031","ordinal":156869,"en":"Had she not endured in longing,"},{"id":"semetey-1-2013:p1045:b003:l032","ordinal":156870,"en":"Never approaching any person,"},{"id":"semetey-1-2013:p1045:b003:l033","ordinal":156871,"en":"And lived unharmed?"},{"id":"semetey-1-2013:p1045:b003:l034","ordinal":156872,"en":"The gray wolf lay huddled,"},{"id":"semetey-1-2013:p1045:b003:l035","ordinal":156873,"en":"His thoughts sorely distracted;"},{"id":"semetey-1-2013:p1045:b003:l036","ordinal":156874,"en":"Aychürök, daughter of Akun,"},{"id":"semetey-1-2013:p1045:b003:l037","ordinal":156875,"en":"Appeared like the whole world to him."},{"id":"semetey-1-2013:p1045:b003:l038","ordinal":156876,"en":"Fragrant as musk, gleaming like copper,"},{"id":"semetey-1-2013:p1045:b003:l039","ordinal":156877,"en":"She appeared like a fairy maiden."},{"id":"semetey-1-2013:p1045:b004:l001","ordinal":156878,"en":"Your prince's thoughts were swept away;"},{"id":"semetey-1-2013:p1045:b004:l002","ordinal":156879,"en":"Until Aychürök came near,"},{"id":"semetey-1-2013:p1045:b004:l003","ordinal":156880,"en":"The great-hearted princely leopard"},{"id":"semetey-1-2013:p1045:b004:l004","ordinal":156881,"en":"Went limp and nearly fainted."},{"id":"semetey-1-2013:p1045:b004:l005","ordinal":156882,"en":"Until Chürök came beside him,"},{"id":"semetey-1-2013:p1045:b004:l006","ordinal":156883,"en":"His tiny soul cried out;"},{"id":"semetey-1-2013:p1045:b004:l007","ordinal":156884,"en":"He waited in frightened haste,"},{"id":"semetey-1-2013:p1045:b004:l008","ordinal":156885,"en":"Every bone in his body trembling."},{"id":"semetey-1-2013:p1045:b004:l009","ordinal":156886,"en":"Early time became late;"},{"id":"semetey-1-2013:p1045:b004:l010","ordinal":156887,"en":"\"When will Chürök come?\" he thought."},{"id":"semetey-1-2013:p1045:b004:l011","ordinal":156888,"en":"Your gray-maned wolf waited impatiently,"},{"id":"semetey-1-2013:p1045:b004:l012","ordinal":156889,"en":"His two eyes becoming four."},{"id":"semetey-1-2013:p1045:b004:l013","ordinal":156890,"en":"Aychürök, daughter of Akun,"},{"id":"semetey-1-2013:p1045:b004:l014","ordinal":156891,"en":"Pulled off and removed"},{"id":"semetey-1-2013:p1045:b004:l015","ordinal":156892,"en":"Her gown made of fine broadcloth."},{"id":"semetey-1-2013:p1045:b004:l016","ordinal":156893,"en":"Swaying softly like dressed leather,"},{"id":"semetey-1-2013:p1045:b004:l017","ordinal":156894,"en":"Whimpering like a puppy,"},{"id":"semetey-1-2013:p1045:b004:l018","ordinal":156895,"en":"Her face shining like the sun,"},{"id":"semetey-1-2013:p1045:b004:l019","ordinal":156896,"en":"She lay down embracing"},{"id":"semetey-1-2013:p1045:b004:l020","ordinal":156897,"en":"Her sultan's breast."},{"id":"semetey-1-2013:p1045:b004:l021","ordinal":156898,"en":"They immersed themselves in delight,"},{"id":"semetey-1-2013:p1045:b004:l022","ordinal":156899,"en":"And lay upon one bed;"},{"id":"semetey-1-2013:p1045:b004:l023","ordinal":156900,"en":"Like two graceful wild ducks,"},{"id":"semetey-1-2013:p1045:b004:l024","ordinal":156901,"en":"They now came together."},{"id":"semetey-1-2013:p1045:b004:l025","ordinal":156902,"en":"Like an argali ewe and ram,"},{"id":"semetey-1-2013:p1045:b004:l026","ordinal":156903,"en":"They now entwined."},{"id":"semetey-1-2013:p1045:b004:l027","ordinal":156904,"en":"They lay upon one bed,"},{"id":"semetey-1-2013:p1045:b004:l028","ordinal":156905,"en":"Immersed in pleasure like this,"},{"id":"semetey-1-2013:p1045:b004:l029","ordinal":156906,"en":"And mingled like"},{"id":"semetey-1-2013:p1045:b004:l030","ordinal":156907,"en":"Flour made from white wheat;"},{"id":"semetey-1-2013:p1045:b004:l031","ordinal":156908,"en":"They slid against one another"},{"id":"semetey-1-2013:p1045:b004:l032","ordinal":156909,"en":"Like the hair of a white gazelle."},{"id":"semetey-1-2013:p1045:b004:l033","ordinal":156910,"en":"They joined by their own will,"},{"id":"semetey-1-2013:p1045:b004:l034","ordinal":156911,"en":"Embracing and kissing,"},{"id":"semetey-1-2013:p1045:b004:l035","ordinal":156912,"en":"Speaking in whispers,"},{"id":"semetey-1-2013:p1045:b004:l036","ordinal":156913,"en":"And laughing with ringing voices."},{"id":"semetey-1-2013:p1045:b004:l037","ordinal":156914,"en":"As the lovers lay embraced,"},{"id":"semetey-1-2013:p1045:b004:l038","ordinal":156915,"en":"When the fierce conqueror stirred,"},{"id":"semetey-1-2013:p1045:b004:l039","ordinal":156916,"en":"Chürök sprang up with a whimper."},{"id":"semetey-1-2013:p1046:b003:l001","ordinal":156917,"en":"Rolling her eyes like a pheasant,"},{"id":"semetey-1-2013:p1046:b003:l002","ordinal":156918,"en":"The bold woman of singular nature"},{"id":"semetey-1-2013:p1046:b003:l003","ordinal":156919,"en":"Lay whimpering as he made her submit."},{"id":"semetey-1-2013:p1046:b003:l004","ordinal":156920,"en":"The luckless woman with her companion,"},{"id":"semetey-1-2013:p1046:b003:l005","ordinal":156921,"en":"Rolling her eyes like a rooster,"},{"id":"semetey-1-2013:p1046:b003:l006","ordinal":156922,"en":"Lay crying, \"Koykoy,\" as he made her submit."},{"id":"semetey-1-2013:p1046:b003:l007","ordinal":156923,"en":"His swaggering member, twelve handspans long—"},{"id":"semetey-1-2013:p1046:b003:l008","ordinal":156924,"en":"Without judging its mouth or root,"},{"id":"semetey-1-2013:p1046:b003:l009","ordinal":156925,"en":"When he thrust, it knotted within her;"},{"id":"semetey-1-2013:p1046:b003:l010","ordinal":156926,"en":"The luckless woman, who had never seen such a thing,"},{"id":"semetey-1-2013:p1046:b003:l011","ordinal":156927,"en":"Bent double like a trivet."},{"id":"semetey-1-2013:p1046:b003:l012","ordinal":156928,"en":"\"Oh, alas, my back!\" she cried;"}]
