[{"id":"semetey-1-2013:p0255:b003:l022","ordinal":96257,"en":"The countless riches he left,"},{"id":"semetey-1-2013:p0255:b003:l023","ordinal":96258,"en":"All those foolish dogs"},{"id":"semetey-1-2013:p0255:b003:l024","ordinal":96259,"en":"Divided, measuring shares with a whip."},{"id":"semetey-1-2013:p0255:b003:l025","ordinal":96260,"en":"Horses with pied heads on the hills,"},{"id":"semetey-1-2013:p0255:b003:l026","ordinal":96261,"en":"Thoroughbreds and racers mingled—"},{"id":"semetey-1-2013:p0255:b003:l027","ordinal":96262,"en":"When my brother-in-law passed away,"},{"id":"semetey-1-2013:p0255:b003:l028","ordinal":96263,"en":"There was no way to catch and ride one."},{"id":"semetey-1-2013:p0255:b003:l029","ordinal":96264,"en":"When my leopard brother-in-law passed away,"},{"id":"semetey-1-2013:p0255:b003:l030","ordinal":96265,"en":"No son remained behind."},{"id":"semetey-1-2013:p0255:b003:l031","ordinal":96266,"en":"She trotted like a hunting hound;"},{"id":"semetey-1-2013:p0255:b003:l032","ordinal":96267,"en":"Hardship fell upon her head."},{"id":"semetey-1-2013:p0255:b003:l033","ordinal":96268,"en":"Wandering from Talas, my elder sister"},{"id":"semetey-1-2013:p0255:b003:l034","ordinal":96269,"en":"Came to broad Bukhara."},{"id":"semetey-1-2013:p0255:b003:l035","ordinal":96270,"en":"When my leopard brother-in-law died,"},{"id":"semetey-1-2013:p0255:b003:l036","ordinal":96271,"en":"My dear elder sister Kanykei,"},{"id":"semetey-1-2013:p0255:b003:l037","ordinal":96272,"en":"How much humiliation she suffered!"},{"id":"semetey-1-2013:p0255:b003:l038","ordinal":96273,"en":"When my valiant brother-in-law died,"},{"id":"semetey-1-2013:p0255:b003:l039","ordinal":96274,"en":"The countless riches left by the warrior,"},{"id":"semetey-1-2013:p0255:b004:l001","ordinal":96275,"en":"Those base, wicked-hearted dogs"},{"id":"semetey-1-2013:p0255:b004:l002","ordinal":96276,"en":"Divided, measuring shares with a whip."},{"id":"semetey-1-2013:p0255:b004:l003","ordinal":96277,"en":"She came wandering to settle in Bukhara;"},{"id":"semetey-1-2013:p0255:b004:l004","ordinal":96278,"en":"This elder sister of mine was slandered."},{"id":"semetey-1-2013:p0255:b004:l005","ordinal":96279,"en":"What God lays upon one's head,"},{"id":"semetey-1-2013:p0255:b004:l006","ordinal":96280,"en":"There is no choice but to bear."},{"id":"semetey-1-2013:p0255:b004:l007","ordinal":96281,"en":"When my fierce brother-in-law died,"},{"id":"semetey-1-2013:p0255:b004:l008","ordinal":96282,"en":"When my elder sister came wandering,"},{"id":"semetey-1-2013:p0255:b004:l009","ordinal":96283,"en":"No son remained behind."},{"id":"semetey-1-2013:p0255:b004:l010","ordinal":96284,"en":"The broad valley among rolling hills,"},{"id":"semetey-1-2013:p0255:b004:l011","ordinal":96285,"en":"Let us not leave it without a spring."},{"id":"semetey-1-2013:p0255:b004:l012","ordinal":96286,"en":"My unlucky elder sister,"},{"id":"semetey-1-2013:p0255:b004:l013","ordinal":96287,"en":"Let us not leave her as though without offspring."},{"id":"semetey-1-2013:p0255:b004:l014","ordinal":96288,"en":"My fierce, valiant elder sister"},{"id":"semetey-1-2013:p0255:b004:l015","ordinal":96289,"en":"Has no waist to gird herself with,"},{"id":"semetey-1-2013:p0255:b004:l016","ordinal":96290,"en":"She has no support left by her khan,"},{"id":"semetey-1-2013:p0255:b004:l017","ordinal":96291,"en":"No renowned Kyrgyz people."},{"id":"semetey-1-2013:p0255:b004:l018","ordinal":96292,"en":"Once the Creator lays it upon one's head,"},{"id":"semetey-1-2013:p0255:b004:l019","ordinal":96293,"en":"There is no choice but to bear."},{"id":"semetey-1-2013:p0255:b004:l020","ordinal":96294,"en":"To cherish, left by the fierce warrior,"},{"id":"semetey-1-2013:p0255:b004:l021","ordinal":96295,"en":"There is no child remaining behind."},{"id":"semetey-1-2013:p0255:b004:l022","ordinal":96296,"en":"This wretched world, so scant of fidelity—"},{"id":"semetey-1-2013:p0255:b004:l023","ordinal":96297,"en":"Listen without shame, strongmen:"},{"id":"semetey-1-2013:p0255:b004:l024","ordinal":96298,"en":"Such is this wretched world."},{"id":"semetey-1-2013:p0255:b004:l025","ordinal":96299,"en":"I heard news from those who came."},{"id":"semetey-1-2013:p0255:b004:l026","ordinal":96300,"en":"My dear elder sister Kanykei,"},{"id":"semetey-1-2013:p0255:b004:l027","ordinal":96301,"en":"As a test of fate in Bukhara,"},{"id":"semetey-1-2013:p0255:b004:l028","ordinal":96302,"en":"Has entered Taytoru in the race, I heard."},{"id":"semetey-1-2013:p0255:b004:l029","ordinal":96303,"en":"If Taytoru comes to the front,"},{"id":"semetey-1-2013:p0255:b004:l030","ordinal":96304,"en":"Let us urge him onward without reserve."},{"id":"semetey-1-2013:p0255:b004:l031","ordinal":96305,"en":"Let us raise the battle cry, 'Manas!'"},{"id":"semetey-1-2013:p0255:b004:l032","ordinal":96306,"en":"Wherever Taytoru may be,"},{"id":"semetey-1-2013:p0255:b004:l033","ordinal":96307,"en":"Let us urge only him onward."},{"id":"semetey-1-2013:p0255:b004:l034","ordinal":96308,"en":"My father's Aktulpar,"},{"id":"semetey-1-2013:p0255:b004:l035","ordinal":96309,"en":"If he comes to the front, let us slaughter him."},{"id":"semetey-1-2013:p0255:b004:l036","ordinal":96310,"en":"Without sparing Bukhara's four noble steeds,"},{"id":"semetey-1-2013:p0255:b004:l037","ordinal":96311,"en":"Let us slaughter them all."},{"id":"semetey-1-2013:p0255:b004:l038","ordinal":96312,"en":"All the horses that have owners,"},{"id":"semetey-1-2013:p0255:b004:l039","ordinal":96313,"en":"Let us slaughter every one."},{"id":"semetey-1-2013:p0256:b003:l001","ordinal":96314,"en":"If my elder sister's horse is there,"},{"id":"semetey-1-2013:p0256:b003:l002","ordinal":96315,"en":"Let us leave that one alive."},{"id":"semetey-1-2013:p0256:b003:l003","ordinal":96316,"en":"Today let us cry our battle cry, 'Manas!'"},{"id":"semetey-1-2013:p0256:b003:l004","ordinal":96317,"en":"Let us cheer Taytoru on."},{"id":"semetey-1-2013:p0256:b003:l005","ordinal":96318,"en":"If I start such a quarrel,"},{"id":"semetey-1-2013:p0256:b003:l006","ordinal":96319,"en":"If I kill their horses,"},{"id":"semetey-1-2013:p0256:b003:l007","ordinal":96320,"en":"Lasting torment and great quarrel—"},{"id":"semetey-1-2013:p0256:b003:l008","ordinal":96321,"en":"Swear on the Quran that I shall not bear them."},{"id":"semetey-1-2013:p0256:b003:l009","ordinal":96322,"en":"A single word such as this—"},{"id":"semetey-1-2013:p0256:b003:l010","ordinal":96323,"en":"Swear on the Quran that you shall not tell it!'"},{"id":"semetey-1-2013:p0256:b003:l011","ordinal":96324,"en":"Then Semetey spoke thus"},{"id":"semetey-1-2013:p0256:b003:l012","ordinal":96325,"en":"And turned his courser's head."},{"id":"semetey-1-2013:p0256:b003:l013","ordinal":96326,"en":"Unable to stand still, from the champions"},{"id":"semetey-1-2013:p0256:b003:l014","ordinal":96327,"en":"He demanded an oath."},{"id":"semetey-1-2013:p0256:b003:l015","ordinal":96328,"en":"All the champions—"},{"id":"semetey-1-2013:p0256:b003:l016","ordinal":96329,"en":"With the boy standing thus,"},{"id":"semetey-1-2013:p0256:b003:l017","ordinal":96330,"en":"How could they refuse assent?"},{"id":"semetey-1-2013:p0256:b003:l018","ordinal":96331,"en":"The champions dismounted,"},{"id":"semetey-1-2013:p0256:b003:l019","ordinal":96332,"en":"Chewed grains of white wheat,"},{"id":"semetey-1-2013:p0256:b003:l020","ordinal":96333,"en":"Saying, 'We shall not tell,'"},{"id":"semetey-1-2013:p0256:b003:l021","ordinal":96334,"en":"And swore by the holy creed."},{"id":"semetey-1-2013:p0256:b003:l022","ordinal":96335,"en":"Licking deadly poison,"},{"id":"semetey-1-2013:p0256:b003:l023","ordinal":96336,"en":"They swore a deathly oath:"},{"id":"semetey-1-2013:p0256:b003:l024","ordinal":96337,"en":"'Let it be as you say, hero!"},{"id":"semetey-1-2013:p0256:b003:l025","ordinal":96338,"en":"If we let this matter out,"},{"id":"semetey-1-2013:p0256:b003:l026","ordinal":96339,"en":"May seven generations of our fathers be infidels!'"},{"id":"semetey-1-2013:p0256:b003:l027","ordinal":96340,"en":"Semetey, at twelve,"},{"id":"semetey-1-2013:p0256:b003:l028","ordinal":96341,"en":"Revealed his terrible might,"},{"id":"semetey-1-2013:p0256:b003:l029","ordinal":96342,"en":"And made the formidable champions"},{"id":"semetey-1-2013:p0256:b003:l030","ordinal":96343,"en":"Obey him in this fashion."},{"id":"semetey-1-2013:p0256:b003:l031","ordinal":96344,"en":"His blue robe of light baran cloth"},{"id":"semetey-1-2013:p0256:b003:l032","ordinal":96345,"en":"He took off again and folded."},{"id":"semetey-1-2013:p0256:b003:l033","ordinal":96346,"en":"Ill-omened Semetey,"},{"id":"semetey-1-2013:p0256:b003:l034","ordinal":96347,"en":"In his haste, secured the robe"},{"id":"semetey-1-2013:p0256:b003:l035","ordinal":96348,"en":"To his saddle straps."},{"id":"semetey-1-2013:p0256:b003:l036","ordinal":96349,"en":"He arrayed his arms for war,"},{"id":"semetey-1-2013:p0256:b003:l037","ordinal":96350,"en":"With a broad banner and painted spear,"},{"id":"semetey-1-2013:p0256:b003:l038","ordinal":96351,"en":"Arming himself as of old."},{"id":"semetey-1-2013:p0256:b003:l039","ordinal":96352,"en":"His mighty, gate-sized teeth"},{"id":"semetey-1-2013:p0256:b004:l001","ordinal":96353,"en":"Broke into pieces like grains of millet."},{"id":"semetey-1-2013:p0256:b004:l002","ordinal":96354,"en":"Of his father, Sultan Manas,"},{"id":"semetey-1-2013:p0256:b004:l003","ordinal":96355,"en":"He looked the very image."},{"id":"semetey-1-2013:p0256:b004:l004","ordinal":96356,"en":"Surpassing his father, fierce Manas,"},{"id":"semetey-1-2013:p0256:b004:l005","ordinal":96357,"en":"Was this marvel of a son."},{"id":"semetey-1-2013:p0256:b004:l006","ordinal":96358,"en":"Semetey was in haste"},{"id":"semetey-1-2013:p0256:b004:l007","ordinal":96359,"en":"To cheer Taytoru on;"},{"id":"semetey-1-2013:p0256:b004:l008","ordinal":96360,"en":"If another horse were ahead,"},{"id":"semetey-1-2013:p0256:b004:l009","ordinal":96361,"en":"His frenzy would seize him hard:"},{"id":"semetey-1-2013:p0256:b004:l010","ordinal":96362,"en":"He would kill them all."},{"id":"semetey-1-2013:p0256:b004:l011","ordinal":96363,"en":"Drawn by his blood, unable to stop,"},{"id":"semetey-1-2013:p0256:b004:l012","ordinal":96364,"en":"The dear boy could not keep still."},{"id":"semetey-1-2013:p0256:b004:l013","ordinal":96365,"en":"The mount beneath him"},{"id":"semetey-1-2013:p0256:b004:l014","ordinal":96366,"en":"Was Temir Khan's courser;"},{"id":"semetey-1-2013:p0256:b004:l015","ordinal":96367,"en":"What he held in his hand"},{"id":"semetey-1-2013:p0256:b004:l016","ordinal":96368,"en":"Was Ysmayyl's steel."},{"id":"semetey-1-2013:p0256:b004:l017","ordinal":96369,"en":"Settling himself, he stood upon his honor,"},{"id":"semetey-1-2013:p0256:b004:l018","ordinal":96370,"en":"With Arkesken girt at his side."},{"id":"semetey-1-2013:p0256:b004:l019","ordinal":96371,"en":"Stretching like a lion,"},{"id":"semetey-1-2013:p0256:b004:l020","ordinal":96372,"en":"Unable to restrain his excitement,"},{"id":"semetey-1-2013:p0256:b004:l021","ordinal":96373,"en":"He was ready to draw a line,"},{"id":"semetey-1-2013:p0256:b004:l022","ordinal":96374,"en":"Slaughtering and smashing the horses:"},{"id":"semetey-1-2013:p0256:b004:l023","ordinal":96375,"en":"The boy was ready to make a spectacle."},{"id":"semetey-1-2013:p0256:b004:l024","ordinal":96376,"en":"If Taytoru were left behind,"},{"id":"semetey-1-2013:p0256:b004:l025","ordinal":96377,"en":"He would plunder their possessions."},{"id":"semetey-1-2013:p0256:b004:l026","ordinal":96378,"en":"The boy raged, unable to stop,"},{"id":"semetey-1-2013:p0256:b004:l027","ordinal":96379,"en":"Ready to wreak utter havoc."},{"id":"semetey-1-2013:p0256:b004:l028","ordinal":96380,"en":"For the courser beneath him,"},{"id":"semetey-1-2013:p0256:b004:l029","ordinal":96381,"en":"He took the white whip with dark handle,"},{"id":"semetey-1-2013:p0256:b004:l030","ordinal":96382,"en":"Grasped it and swung it round."},{"id":"semetey-1-2013:p0256:b004:l031","ordinal":96383,"en":"The courser, great as a mountain,"},{"id":"semetey-1-2013:p0256:b004:l032","ordinal":96384,"en":"He struck upon the hock."},{"id":"semetey-1-2013:p0256:b004:l033","ordinal":96385,"en":"Tearing up the ground he trod,"},{"id":"semetey-1-2013:p0256:b004:l034","ordinal":96386,"en":"The marvelous leopard of a boy"},{"id":"semetey-1-2013:p0256:b004:l035","ordinal":96387,"en":"Galloped upon his courser,"},{"id":"semetey-1-2013:p0256:b004:l036","ordinal":96388,"en":"Across countless stones and sands,"},{"id":"semetey-1-2013:p0256:b004:l037","ordinal":96389,"en":"By Echo's steep Jar-Kyya cliff,"},{"id":"semetey-1-2013:p0256:b004:l038","ordinal":96390,"en":"The narrow track for a single beast,"},{"id":"semetey-1-2013:p0256:b004:l039","ordinal":96391,"en":"Along the slope of Urchuk Mountain,"},{"id":"semetey-1-2013:p0257:b003:l001","ordinal":96392,"en":"When restless, Semetey"},{"id":"semetey-1-2013:p0257:b003:l002","ordinal":96393,"en":"Would go up to his lookout place;"},{"id":"semetey-1-2013:p0257:b003:l003","ordinal":96394,"en":"Toward the pass of Chong-Karool"},{"id":"semetey-1-2013:p0257:b003:l004","ordinal":96395,"en":"He turned his courser's head."},{"id":"semetey-1-2013:p0257:b003:l005","ordinal":96396,"en":"Then Semetey"},{"id":"semetey-1-2013:p0257:b003:l006","ordinal":96397,"en":"Looked toward the tumult."},{"id":"semetey-1-2013:p0257:b003:l007","ordinal":96398,"en":"He listened to the tumult now,"},{"id":"semetey-1-2013:p0257:b003:l008","ordinal":96399,"en":"And learned what the commotion meant."},{"id":"semetey-1-2013:p0257:b003:l009","ordinal":96400,"en":"When he had heard that uproar:"},{"id":"semetey-1-2013:p0257:b003:l010","ordinal":96401,"en":"'O Almighty, Baabedin!"},{"id":"semetey-1-2013:p0257:b003:l011","ordinal":96402,"en":"Ah, Almighty, Baabedin!"},{"id":"semetey-1-2013:p0257:b003:l012","ordinal":96403,"en":"God creates the soul,"},{"id":"semetey-1-2013:p0257:b003:l013","ordinal":96404,"en":"And my soul is leaving me."},{"id":"semetey-1-2013:p0257:b003:l014","ordinal":96405,"en":"Champions, ride here all together!"},{"id":"semetey-1-2013:p0257:b003:l015","ordinal":96406,"en":"You white-bearded elders, ride!"},{"id":"semetey-1-2013:p0257:b003:l016","ordinal":96407,"en":"All you finest men, come here!"},{"id":"semetey-1-2013:p0257:b003:l017","ordinal":96408,"en":"Listen to the commotion,"},{"id":"semetey-1-2013:p0257:b003:l018","ordinal":96409,"en":"Learn what the tumult means."},{"id":"semetey-1-2013:p0257:b003:l019","ordinal":96410,"en":"If my sister's horse appears,"},{"id":"semetey-1-2013:p0257:b003:l020","ordinal":96411,"en":"Cheer that one onward."},{"id":"semetey-1-2013:p0257:b003:l021","ordinal":96412,"en":"My dear champions,"},{"id":"semetey-1-2013:p0257:b003:l022","ordinal":96413,"en":"Come here, you men!"},{"id":"semetey-1-2013:p0257:b003:l023","ordinal":96414,"en":"Have you learned what I have learned?"},{"id":"semetey-1-2013:p0257:b003:l024","ordinal":96415,"en":"Have you heard what I have heard?"},{"id":"semetey-1-2013:p0257:b003:l025","ordinal":96416,"en":"A shrill, shrill, shrill sound rises;"},{"id":"semetey-1-2013:p0257:b003:l026","ordinal":96417,"en":"The voice screams piercingly."},{"id":"semetey-1-2013:p0257:b003:l027","ordinal":96418,"en":"Across the broad hill pasture,"},{"id":"semetey-1-2013:p0257:b003:l028","ordinal":96419,"en":"It is the voice of one who shares our slope."},{"id":"semetey-1-2013:p0257:b003:l029","ordinal":96420,"en":"Her heart is filled with grief."},{"id":"semetey-1-2013:p0257:b003:l030","ordinal":96421,"en":"Is it not a woman's voice?"},{"id":"semetey-1-2013:p0257:b003:l031","ordinal":96422,"en":"My dear elder sister Kanykei—"},{"id":"semetey-1-2013:p0257:b003:l032","ordinal":96423,"en":"Did she not come here wandering?"},{"id":"semetey-1-2013:p0257:b003:l033","ordinal":96424,"en":"It is the voice of my own nestmate."},{"id":"semetey-1-2013:p0257:b003:l034","ordinal":96425,"en":"With neither mane nor tail at all,"},{"id":"semetey-1-2013:p0257:b003:l036","ordinal":96426,"en":"Bereft of her magnanimous lord,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0257:b003:l037","ordinal":96427,"en":"She fled and came here:"},{"id":"semetey-1-2013:p0257:b003:l038","ordinal":96428,"en":"It is my poor unfortunate's voice!"},{"id":"semetey-1-2013:p0257:b003:l039","ordinal":96429,"en":"Fleeing Talas, wandering on foot,"},{"id":"semetey-1-2013:p0257:b005:l001","ordinal":96430,"en":"My sister trudged along: it is her voice."},{"id":"semetey-1-2013:p0257:b005:l002","ordinal":96431,"en":"To Temir Khan's city"},{"id":"semetey-1-2013:p0257:b005:l003","ordinal":96432,"en":"She came wandering and made her life:"},{"id":"semetey-1-2013:p0257:b005:l004","ordinal":96433,"en":"It is that poor wretch's voice."},{"id":"semetey-1-2013:p0257:b005:l005","ordinal":96434,"en":"Her forehead bone is formed otherwise:"},{"id":"semetey-1-2013:p0257:b005:l006","ordinal":96435,"en":"It is my ill-fated sister's voice."},{"id":"semetey-1-2013:p0257:b005:l007","ordinal":96436,"en":"Bereft of her sovereign,"},{"id":"semetey-1-2013:p0257:b005:l008","ordinal":96437,"en":"She fled to Bukhara:"},{"id":"semetey-1-2013:p0257:b005:l009","ordinal":96438,"en":"It is my poor sister's voice."},{"id":"semetey-1-2013:p0257:b005:l010","ordinal":96439,"en":"Heaped treasure, countless possessions—"},{"id":"semetey-1-2013:p0257:b005:l011","ordinal":96440,"en":"My sister scattered them: it is her voice."},{"id":"semetey-1-2013:p0257:b005:l012","ordinal":96441,"en":"She suffered a terrible hell,"},{"id":"semetey-1-2013:p0257:b005:l013","ordinal":96442,"en":"Saying, 'When a woman's husband dies,"},{"id":"semetey-1-2013:p0257:b005:l014","ordinal":96443,"en":"Her birth family is her refuge,'"},{"id":"semetey-1-2013:p0257:b005:l015","ordinal":96444,"en":"To the great city of Bukhara"},{"id":"semetey-1-2013:p0257:b005:l016","ordinal":96445,"en":"My sister fled: it is her voice."},{"id":"semetey-1-2013:p0257:b005:l017","ordinal":96446,"en":"With no one to look after her,"},{"id":"semetey-1-2013:p0257:b005:l018","ordinal":96447,"en":"Grieving in Bukhara"},{"id":"semetey-1-2013:p0257:b005:l019","ordinal":96448,"en":"My sister dwells: it is her voice."},{"id":"semetey-1-2013:p0257:b005:l020","ordinal":96449,"en":"Hardship fell upon her lonely head;"},{"id":"semetey-1-2013:p0257:b005:l021","ordinal":96450,"en":"My sister came: it is her voice."},{"id":"semetey-1-2013:p0257:b005:l022","ordinal":96451,"en":"Bereft of her good fortune,"},{"id":"semetey-1-2013:p0257:b005:l023","ordinal":96452,"en":"Wandering tirelessly to Bukhara"},{"id":"semetey-1-2013:p0257:b005:l024","ordinal":96453,"en":"My sister came: it is her voice."},{"id":"semetey-1-2013:p0257:b005:l025","ordinal":96454,"en":"To Temir Khan's city,"},{"id":"semetey-1-2013:p0257:b005:l026","ordinal":96455,"en":"Wandering from Talas,"},{"id":"semetey-1-2013:p0257:b005:l027","ordinal":96456,"en":"My sister settled: it is her voice."},{"id":"semetey-1-2013:p0257:b005:l028","ordinal":96457,"en":"Disgraced before the whole world,"},{"id":"semetey-1-2013:p0257:b005:l029","ordinal":96458,"en":"That poor unfortunate: it is her voice."},{"id":"semetey-1-2013:p0257:b005:l030","ordinal":96459,"en":"Kara-Kyya, Kezeng-Tash!"},{"id":"semetey-1-2013:p0257:b005:l031","ordinal":96460,"en":"When I hear my sister's voice,"},{"id":"semetey-1-2013:p0257:b005:l032","ordinal":96461,"en":"Alas, day and world, may you never prosper!"},{"id":"semetey-1-2013:p0257:b005:l033","ordinal":96462,"en":"How many tears flow from my eyes!"},{"id":"semetey-1-2013:p0257:b005:l034","ordinal":96463,"en":"Champions, just think:"},{"id":"semetey-1-2013:p0257:b005:l035","ordinal":96464,"en":"Though she have a thousand white palaces,"},{"id":"semetey-1-2013:p0257:b005:l036","ordinal":96465,"en":"Cursed is the lack of food!"},{"id":"semetey-1-2013:p0257:b005:l037","ordinal":96466,"en":"Bereft of her magnanimous lord,"},{"id":"semetey-1-2013:p0257:b005:l038","ordinal":96467,"en":"She came destitute to Bukhara:"},{"id":"semetey-1-2013:p0257:b005:l039","ordinal":96468,"en":"Cursed is the lack of a head to guide her!"},{"id":"semetey-1-2013:p0258:b003:l001","ordinal":96469,"en":"If no water lies upon its face,"},{"id":"semetey-1-2013:p0258:b003:l002","ordinal":96470,"en":"Cursed be the barren plain!"},{"id":"semetey-1-2013:p0258:b003:l003","ordinal":96471,"en":"When a woman's khan has died,"},{"id":"semetey-1-2013:p0258:b003:l004","ordinal":96472,"en":"Cursed is her childlessness!"},{"id":"semetey-1-2013:p0258:b003:l005","ordinal":96473,"en":"While my brother-in-law Manas lived,"},{"id":"semetey-1-2013:p0258:b003:l006","ordinal":96474,"en":"My sister Kanykei was a fierce sovereign;"},{"id":"semetey-1-2013:p0258:b003:l007","ordinal":96475,"en":"Her prudent management and service"},{"id":"semetey-1-2013:p0258:b003:l008","ordinal":96476,"en":"Were equal to a monarch's."},{"id":"semetey-1-2013:p0258:b003:l009","ordinal":96477,"en":"When my heroic brother-in-law died,"},{"id":"semetey-1-2013:p0258:b003:l010","ordinal":96478,"en":"Cursed was her childlessness!"},{"id":"semetey-1-2013:p0258:b003:l011","ordinal":96479,"en":"To this city of Bukhara"},{"id":"semetey-1-2013:p0258:b003:l012","ordinal":96480,"en":"She came, a wandering soul."},{"id":"semetey-1-2013:p0258:b003:l013","ordinal":96481,"en":"The ravine crumbled and became a road;"},{"id":"semetey-1-2013:p0258:b003:l014","ordinal":96482,"en":"The prince's wife,"},{"id":"semetey-1-2013:p0258:b003:l015","ordinal":96483,"en":"My dear sister Kanykei,"},{"id":"semetey-1-2013:p0258:b003:l016","ordinal":96484,"en":"Wandered to Bukhara in humiliation."},{"id":"semetey-1-2013:p0258:b003:l017","ordinal":96485,"en":"No spring flowed before her;"},{"id":"semetey-1-2013:p0258:b003:l018","ordinal":96486,"en":"My poor, fierce sister"},{"id":"semetey-1-2013:p0258:b003:l019","ordinal":96487,"en":"Had no offspring left by her hero."},{"id":"semetey-1-2013:p0258:b003:l020","ordinal":96488,"en":"Once God lays this upon one's head,"},{"id":"semetey-1-2013:p0258:b003:l021","ordinal":96489,"en":"Men, there is no choice but to bear it."},{"id":"semetey-1-2013:p0258:b003:l022","ordinal":96490,"en":"My fierce brother-in-law passed away,"},{"id":"semetey-1-2013:p0258:b003:l023","ordinal":96491,"en":"Leaving no male child behind!"},{"id":"semetey-1-2013:p0258:b003:l024","ordinal":96492,"en":"My unfortunate sister Kanykei"},{"id":"semetey-1-2013:p0258:b003:l025","ordinal":96493,"en":"Wandered to Bukhara and settled,"},{"id":"semetey-1-2013:p0258:b003:l027","ordinal":96494,"en":"Hearing, 'She is a wandering woman.'","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0258:b003:l028","ordinal":96495,"en":"Alas, my poor sister"},{"id":"semetey-1-2013:p0258:b003:l029","ordinal":96496,"en":"Had acquired a bad name."},{"id":"semetey-1-2013:p0258:b003:l030","ordinal":96497,"en":"My dear champions,"},{"id":"semetey-1-2013:p0258:b003:l031","ordinal":96498,"en":"I heard from those who came:"},{"id":"semetey-1-2013:p0258:b003:l032","ordinal":96499,"en":"As a test of fate in Bukhara,"},{"id":"semetey-1-2013:p0258:b003:l033","ordinal":96500,"en":"I heard, she raced Taytoru."},{"id":"semetey-1-2013:p0258:b003:l034","ordinal":96501,"en":"My dear sister Kanykei"},{"id":"semetey-1-2013:p0258:b003:l035","ordinal":96502,"en":"Clothed herself in men's attire,"},{"id":"semetey-1-2013:p0258:b003:l036","ordinal":96503,"en":"Grieving for her husband's death,"},{"id":"semetey-1-2013:p0258:b003:l037","ordinal":96504,"en":"Making her wandering self a lion,"},{"id":"semetey-1-2013:p0258:b003:l038","ordinal":96505,"en":"Making her woman's self a warrior,"},{"id":"semetey-1-2013:p0258:b003:l039","ordinal":96506,"en":"Bringing every limb into accord."},{"id":"semetey-1-2013:p0258:b004:l001","ordinal":96507,"en":"Buried treasure, may you never prosper!"},{"id":"semetey-1-2013:p0258:b004:l002","ordinal":96508,"en":"She made a lake of her tears."},{"id":"semetey-1-2013:p0258:b004:l003","ordinal":96509,"en":"The Boz Kise left by Manas"},{"id":"semetey-1-2013:p0258:b004:l004","ordinal":96510,"en":"She hung snugly round her neck,"},{"id":"semetey-1-2013:p0258:b004:l005","ordinal":96511,"en":"To the lord who had gone to the other world,"},{"id":"semetey-1-2013:p0258:b004:l006","ordinal":96512,"en":"To his spirit she prayed."}]
