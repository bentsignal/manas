p"},{"id":"semetey-2-2013:p0432:b004:l024","ordinal":219641,"en":"Wrestlers, men,"},{"id":"semetey-2-2013:p0432:b004:l025","ordinal":219642,"en":"Ezkara was singing."},{"id":"semetey-2-2013:p0432:b004:l026","ordinal":219643,"en":"Ezkara, khan of the Manchu"},{"id":"semetey-2-2013:p0432:b004:l027","ordinal":219644,"en":"Before he shuts his mouth,"},{"id":"semetey-2-2013:p0432:b004:l028","ordinal":219645,"en":"Bloodthirsty men,"},{"id":"semetey-2-2013:p0432:b004:l029","ordinal":219646,"en":"Insatiable songs."},{"id":"semetey-2-2013:p0432:b004:l030","ordinal":219647,"en":"Until you can gather without care,"},{"id":"semetey-2-2013:p0432:b004:l031","ordinal":219648,"en":"As long as the stick is tight,"}]
