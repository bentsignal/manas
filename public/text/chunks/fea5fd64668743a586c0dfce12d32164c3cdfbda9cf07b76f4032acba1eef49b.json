[{"id":"semetey-1-2013:p0632:b004:l010","ordinal":124929,"en":"Had their wretched parts exposed."},{"id":"semetey-1-2013:p0632:b004:l011","ordinal":124930,"en":"Before dying, to be as dead—"},{"id":"semetey-1-2013:p0632:b004:l012","ordinal":124931,"en":"The forty guards were close to that,"},{"id":"semetey-1-2013:p0632:b004:l013","ordinal":124932,"en":"Close to facing the Last Judgment."},{"id":"semetey-1-2013:p0632:b004:l014","ordinal":124933,"en":"All the forty guards had gained"},{"id":"semetey-1-2013:p0632:b004:l015","ordinal":124934,"en":"Was the wild game they found."},{"id":"semetey-1-2013:p0632:b004:l016","ordinal":124935,"en":"The hides of that game"},{"id":"semetey-1-2013:p0632:b004:l017","ordinal":124936,"en":"They laid over their fleshy buttocks."},{"id":"semetey-1-2013:p0632:b004:l018","ordinal":124937,"en":"The forty guards, wearing no mail,"},{"id":"semetey-1-2013:p0632:b004:l019","ordinal":124938,"en":"Were humiliated worse than all."},{"id":"semetey-1-2013:p0632:b004:l020","ordinal":124939,"en":"The trousers they wore split apart;"},{"id":"semetey-1-2013:p0632:b004:l021","ordinal":124940,"en":"The forty guards could find no remedy."},{"id":"semetey-1-2013:p0632:b004:l022","ordinal":124941,"en":"Their private parts were exposed;"},{"id":"semetey-1-2013:p0632:b004:l023","ordinal":124942,"en":"Their flesh had wasted, their strength was gone,"},{"id":"semetey-1-2013:p0632:b004:l024","ordinal":124943,"en":"Their livestock gone from the forty guards."},{"id":"semetey-1-2013:p0632:b004:l025","ordinal":124944,"en":"When they heard Bölökbai's voice,"},{"id":"semetey-1-2013:p0632:b004:l026","ordinal":124945,"en":"Leading their gray two-year-old wether,"},{"id":"semetey-1-2013:p0632:b004:l027","ordinal":124946,"en":"They all came running together."},{"id":"semetey-1-2013:p0632:b004:l028","ordinal":124947,"en":"“My dear Bölökbai,"},{"id":"semetey-1-2013:p0632:b004:l029","ordinal":124948,"en":"Your shout rings out so strongly."},{"id":"semetey-1-2013:p0632:b004:l030","ordinal":124949,"en":"Has God granted us our honor?"},{"id":"semetey-1-2013:p0632:b004:l031","ordinal":124950,"en":"Has the suffering orphan come?"},{"id":"semetey-1-2013:p0632:b004:l032","ordinal":124951,"en":"My dear Bölökbai,"},{"id":"semetey-1-2013:p0632:b004:l033","ordinal":124952,"en":"Blue steam rises from your exposed flesh."},{"id":"semetey-1-2013:p0632:b004:l035","ordinal":124953,"en":"Is there news, Bölökö,"},{"id":"semetey-1-2013:p0632:b004:l036","ordinal":124954,"en":"Of that orphan, Manas's son?"},{"id":"semetey-1-2013:p0632:b004:l037","ordinal":124955,"en":"Has Semetey come, Bölökö,"},{"id":"semetey-1-2013:p0632:b004:l038","ordinal":124956,"en":"With exposed flesh covered,"},{"id":"semetey-1-2013:p0632:b004:l039","ordinal":124957,"en":"And all our honor restored,"},{"id":"semetey-1-2013:p0633:b003:l001","ordinal":124958,"en":"Oh God, will you grant such a day?"},{"id":"semetey-1-2013:p0633:b003:l002","ordinal":124959,"en":"Shodding our feet in rawhide shoes,"},{"id":"semetey-1-2013:p0633:b003:l003","ordinal":124960,"en":"Skirting Kara-Too,"},{"id":"semetey-1-2013:p0633:b003:l004","ordinal":124961,"en":"We have suffered much sorrow."},{"id":"semetey-1-2013:p0633:b003:l005","ordinal":124962,"en":"My dear Bölökbai,"},{"id":"semetey-1-2013:p0633:b003:l006","ordinal":124963,"en":"Will a day come when this sorrow leaves?"},{"id":"semetey-1-2013:p0633:b003:l007","ordinal":124964,"en":"We carved arrows, uttering spells,"},{"id":"semetey-1-2013:p0633:b003:l008","ordinal":124965,"en":"Roamed tirelessly to keep ourselves alive,"},{"id":"semetey-1-2013:p0633:b003:l009","ordinal":124966,"en":"Chasing what God had lost."},{"id":"semetey-1-2013:p0633:b003:l010","ordinal":124967,"en":"Will a day come when this is forgotten?”"},{"id":"semetey-1-2013:p0633:b003:l011","ordinal":124968,"en":"The forty guards wept and sobbed;"},{"id":"semetey-1-2013:p0633:b003:l012","ordinal":124969,"en":"Among them Bölökbai wept with cries."},{"id":"semetey-1-2013:p0633:b003:l014","ordinal":124970,"en":"Along the foot of the lower mountains"},{"id":"semetey-1-2013:p0633:b003:l015","ordinal":124971,"en":"The forty guards were coming,"},{"id":"semetey-1-2013:p0633:b003:l016","ordinal":124972,"en":"Leading the gray two-year-old wether."},{"id":"semetey-1-2013:p0633:b003:l017","ordinal":124973,"en":"When terrible madness raged,"},{"id":"semetey-1-2013:p0633:b003:l018","ordinal":124974,"en":"When the six vile ones came and raided the treasury,"},{"id":"semetey-1-2013:p0633:b003:l020","ordinal":124975,"en":"This gray wether standing here"},{"id":"semetey-1-2013:p0633:b003:l021","ordinal":124976,"en":"Was the animal that gave them support."},{"id":"semetey-1-2013:p0633:b003:l022","ordinal":124977,"en":"“When the orphan comes, grown up,"},{"id":"semetey-1-2013:p0633:b003:l023","ordinal":124978,"en":"I will slaughter it for Baabedin,” he said;"},{"id":"semetey-1-2013:p0633:b003:l024","ordinal":124979,"en":"It was the beast set apart for that."},{"id":"semetey-1-2013:p0633:b003:l025","ordinal":124980,"en":"The forty guards came walking,"},{"id":"semetey-1-2013:p0633:b003:l026","ordinal":124981,"en":"Their tears pouring down,"},{"id":"semetey-1-2013:p0633:b003:l027","ordinal":124982,"en":"With no way to cover themselves,"},{"id":"semetey-1-2013:p0633:b003:l028","ordinal":124983,"en":"Their bare flesh showing."},{"id":"semetey-1-2013:p0633:b003:l029","ordinal":124984,"en":"While Bölökbai stood weeping,"},{"id":"semetey-1-2013:p0633:b003:l030","ordinal":124985,"en":"Your orphan, Manas's son,"},{"id":"semetey-1-2013:p0633:b003:l031","ordinal":124986,"en":"Waiting patiently till the meat was cooked—"},{"id":"semetey-1-2013:p0633:b003:l032","ordinal":124987,"en":"For many days and many nights,"},{"id":"semetey-1-2013:p0633:b003:l033","ordinal":124988,"en":"Your orphan had gone without sleep."},{"id":"semetey-1-2013:p0633:b003:l034","ordinal":124989,"en":"Pillowing his head upon Ak-Kangky,"},{"id":"semetey-1-2013:p0633:b003:l035","ordinal":124990,"en":"Turning his head toward the qibla,"},{"id":"semetey-1-2013:p0633:b003:l036","ordinal":124991,"en":"He had fallen asleep;"},{"id":"semetey-1-2013:p0633:b003:l037","ordinal":124992,"en":"It was Semetey himself."},{"id":"semetey-1-2013:p0633:b003:l038","ordinal":124993,"en":"The forty guards came all together,"},{"id":"semetey-1-2013:p0633:b003:l039","ordinal":124994,"en":"Beseeching Khan Bakai."},{"id":"semetey-1-2013:p0633:b005:l001","ordinal":124995,"en":"The forty guards stood and said:"},{"id":"semetey-1-2013:p0633:b005:l002","ordinal":124996,"en":"“You who find words when taken by surprise,"},{"id":"semetey-1-2013:p0633:b005:l003","ordinal":124997,"en":"You who find sight in darkness,"},{"id":"semetey-1-2013:p0633:b005:l004","ordinal":124998,"en":"Is my dear uncle well?"},{"id":"semetey-1-2013:p0633:b005:l005","ordinal":124999,"en":"The painted pinewood spear—"},{"id":"semetey-1-2013:p0633:b005:l006","ordinal":125000,"en":"Is my uncle who bound it well?"},{"id":"semetey-1-2013:p0633:b005:l007","ordinal":125001,"en":"Who slaughtered and trampled unbelievers,"},{"id":"semetey-1-2013:p0633:b005:l008","ordinal":125002,"en":"Is my warring uncle well?"},{"id":"semetey-1-2013:p0633:b005:l009","ordinal":125003,"en":"Through east and west,"},{"id":"semetey-1-2013:p0633:b005:l010","ordinal":125004,"en":"Is my uncle who traveled well?"},{"id":"semetey-1-2013:p0633:b005:l011","ordinal":125005,"en":"Who fired shots at unbelievers,"},{"id":"semetey-1-2013:p0633:b005:l012","ordinal":125006,"en":"Is my lion uncle well?"},{"id":"semetey-1-2013:p0633:b005:l013","ordinal":125007,"en":"The mail no shot could pierce—"},{"id":"semetey-1-2013:p0633:b005:l014","ordinal":125008,"en":"Is my uncle who wore it well?"},{"id":"semetey-1-2013:p0633:b005:l015","ordinal":125009,"en":"Beijing with its twelve gates—"},{"id":"semetey-1-2013:p0633:b005:l016","ordinal":125010,"en":"Is my uncle who raided it well?"},{"id":"semetey-1-2013:p0633:b005:l017","ordinal":125011,"en":"Making Talas his homeland,"},{"id":"semetey-1-2013:p0633:b005:l018","ordinal":125012,"en":"Is my uncle who settled there well?"},{"id":"semetey-1-2013:p0633:b005:l019","ordinal":125013,"en":"An iron fort for Muslims,"},{"id":"semetey-1-2013:p0633:b005:l020","ordinal":125014,"en":"Is my uncle, their stronghold, well?"},{"id":"semetey-1-2013:p0633:b005:l021","ordinal":125015,"en":"Who made his deeds pure before Allah,"},{"id":"semetey-1-2013:p0633:b005:l022","ordinal":125016,"en":"Is my uncle who pleased him well?"},{"id":"semetey-1-2013:p0633:b005:l023","ordinal":125017,"en":"His orphaned camels, through great hardship—"},{"id":"semetey-1-2013:p0633:b005:l024","ordinal":125018,"en":"Is my uncle who tended them well?"},{"id":"semetey-1-2013:p0633:b005:l025","ordinal":125019,"en":"Living long through many years,"},{"id":"semetey-1-2013:p0633:b005:l026","ordinal":125020,"en":"Is my uncle who has not died well?"},{"id":"semetey-1-2013:p0633:b005:l027","ordinal":125021,"en":"For twelve years I have not seen his face—"},{"id":"semetey-1-2013:p0633:b005:l028","ordinal":125022,"en":"Is my uncle whom I have not seen well?"},{"id":"semetey-1-2013:p0633:b005:l029","ordinal":125023,"en":"Bek-Jailoo above Besh-Tash—"},{"id":"semetey-1-2013:p0633:b005:l030","ordinal":125024,"en":"Is my uncle who stayed there well?"},{"id":"semetey-1-2013:p0633:b005:l031","ordinal":125025,"en":"Destroying those he faced,"},{"id":"semetey-1-2013:p0633:b005:l032","ordinal":125026,"en":"Is my uncle who fired upon them well?"},{"id":"semetey-1-2013:p0633:b005:l034","ordinal":125027,"en":"Uncle Bakai, have you seen your orphan?”","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0633:b005:l036","ordinal":125028,"en":"Then Bakai said:"},{"id":"semetey-1-2013:p0633:b005:l037","ordinal":125029,"en":"“Oh Bölökbai, forty guards,"},{"id":"semetey-1-2013:p0633:b005:l038","ordinal":125030,"en":"What you lost has been found;"},{"id":"semetey-1-2013:p0633:b005:l039","ordinal":125031,"en":"Your exposed flesh has been covered."},{"id":"semetey-1-2013:p0634:b003:l001","ordinal":125032,"en":"Your orphan has come; you are whole again."},{"id":"semetey-1-2013:p0634:b003:l002","ordinal":125033,"en":"What was broken has been joined,"},{"id":"semetey-1-2013:p0634:b003:l003","ordinal":125034,"en":"What was scattered has been gathered."},{"id":"semetey-1-2013:p0634:b003:l004","ordinal":125035,"en":"God has granted your wish."},{"id":"semetey-1-2013:p0634:b003:l005","ordinal":125036,"en":"Your only one left by Manas,"},{"id":"semetey-1-2013:p0634:b003:l006","ordinal":125037,"en":"That orphan has arrived."},{"id":"semetey-1-2013:p0634:b003:l007","ordinal":125038,"en":"Forty guards, all your pent-up anguish has eased;"},{"id":"semetey-1-2013:p0634:b003:l009","ordinal":125039,"en":"Forty guards, your grief has now subsided."},{"id":"semetey-1-2013:p0634:b003:l010","ordinal":125040,"en":"Your stag has run from the hills."},{"id":"semetey-1-2013:p0634:b003:l011","ordinal":125041,"en":"Do not mourn, forty guards:"},{"id":"semetey-1-2013:p0634:b003:l012","ordinal":125042,"en":"Your generous one has come alive today."},{"id":"semetey-1-2013:p0634:b003:l013","ordinal":125043,"en":"Your missing part has come today."},{"id":"semetey-1-2013:p0634:b003:l014","ordinal":125044,"en":"Do not grieve, forty guards:"},{"id":"semetey-1-2013:p0634:b003:l015","ordinal":125045,"en":"God has given you abundance."},{"id":"semetey-1-2013:p0634:b003:l016","ordinal":125046,"en":"Sorrow has vanished from your hearts."},{"id":"semetey-1-2013:p0634:b003:l017","ordinal":125047,"en":"Your orphan has come, forty guards;"},{"id":"semetey-1-2013:p0634:b003:l018","ordinal":125048,"en":"All your affairs have been set right!”"},{"id":"semetey-1-2013:p0634:b003:l019","ordinal":125049,"en":"When he heard this from Bakai,"},{"id":"semetey-1-2013:p0634:b003:l020","ordinal":125050,"en":"His thoughts broke loose."},{"id":"semetey-1-2013:p0634:b003:l021","ordinal":125051,"en":"He fell upon and clasped him—"},{"id":"semetey-1-2013:p0634:b003:l022","ordinal":125052,"en":"Bölökbai clasped the boy left by Manas."},{"id":"semetey-1-2013:p0634:b003:l023","ordinal":125053,"en":"While Bölökbai stood weeping,"},{"id":"semetey-1-2013:p0634:b003:l024","ordinal":125054,"en":"Mighty Khan Bakai wept."},{"id":"semetey-1-2013:p0634:b003:l025","ordinal":125055,"en":"The sight was hard to bear;"},{"id":"semetey-1-2013:p0634:b003:l026","ordinal":125056,"en":"All forty guards were weeping."},{"id":"semetey-1-2013:p0634:b003:l027","ordinal":125057,"en":"Since the treasury was scattered,"},{"id":"semetey-1-2013:p0634:b003:l028","ordinal":125058,"en":"Since they vanished and fled,"},{"id":"semetey-1-2013:p0634:b003:l029","ordinal":125059,"en":"The torment of this world—"},{"id":"semetey-1-2013:p0634:b003:l030","ordinal":125060,"en":"Since they suffered it without respite,"},{"id":"semetey-1-2013:p0634:b003:l031","ordinal":125061,"en":"Twelve years had passed."},{"id":"semetey-1-2013:p0634:b003:l032","ordinal":125062,"en":"At the time they reached the boy,"},{"id":"semetey-1-2013:p0634:b003:l033","ordinal":125063,"en":"The forty guards and Bölökbai,"},{"id":"semetey-1-2013:p0634:b003:l034","ordinal":125064,"en":"As they stood weeping—"},{"id":"semetey-1-2013:p0634:b003:l035","ordinal":125065,"en":"If the boy had not come that year,"},{"id":"semetey-1-2013:p0634:b003:l036","ordinal":125066,"en":"The guards were at the point of (being) wiped out."},{"id":"semetey-1-2013:p0634:b003:l038","ordinal":125067,"en":"The forty guards and Bölökbai—"},{"id":"semetey-1-2013:p0634:b003:l039","ordinal":125068,"en":"When the boy stood and looked at them,"},{"id":"semetey-1-2013:p0634:b004:l001","ordinal":125069,"en":"Not one whole garment clothed them."},{"id":"semetey-1-2013:p0634:b004:l002","ordinal":125070,"en":"“Faithful friends left by my father Manas,"},{"id":"semetey-1-2013:p0634:b004:l003","ordinal":125071,"en":"If God brings it upon a mortal,"},{"id":"semetey-1-2013:p0634:b004:l004","ordinal":125072,"en":"Anything can come to pass."},{"id":"semetey-1-2013:p0634:b004:l005","ordinal":125073,"en":"May my fierce father never die;"},{"id":"semetey-1-2013:p0634:b004:l006","ordinal":125074,"en":"The humiliation left after that fierce one—"},{"id":"semetey-1-2013:p0634:b004:l007","ordinal":125075,"en":"May God not give it to his servants."},{"id":"semetey-1-2013:p0634:b004:l008","ordinal":125076,"en":"Bölökbai, left by my father Manas,"},{"id":"semetey-1-2013:p0634:b004:l009","ordinal":125077,"en":"Was the khan of the treasury,"},{"id":"semetey-1-2013:p0634:b004:l010","ordinal":125078,"en":"A man endowed with sacred power."},{"id":"semetey-1-2013:p0634:b004:l011","ordinal":125079,"en":"While my fierce father lived,"},{"id":"semetey-1-2013:p0634:b004:l012","ordinal":125080,"en":"He skillfully fashioned every precious thing,"},{"id":"semetey-1-2013:p0634:b004:l013","ordinal":125081,"en":"Making each object peerless:"},{"id":"semetey-1-2013:p0634:b004:l014","ordinal":125082,"en":"Swords, guns, and valuables,"},{"id":"semetey-1-2013:p0634:b004:l015","ordinal":125083,"en":"He made them wonderfully."},{"id":"semetey-1-2013:p0634:b004:l016","ordinal":125084,"en":"For my lion father, above all,"},{"id":"semetey-1-2013:p0634:b004:l017","ordinal":125085,"en":"He supplied what was lacking,"},{"id":"semetey-1-2013:p0634:b004:l018","ordinal":125086,"en":"Brought into being what was absent."},{"id":"semetey-1-2013:p0634:b004:l019","ordinal":125087,"en":"The black gun and Arkesken"},{"id":"semetey-1-2013:p0634:b004:l020","ordinal":125088,"en":"He fashioned as they ought to be."},{"id":"semetey-1-2013:p0634:b004:l021","ordinal":125089,"en":"Clouds stirred in the sky;"},{"id":"semetey-1-2013:p0634:b004:l022","ordinal":125090,"en":"Döötü and Bölökbai"},{"id":"semetey-1-2013:p0634:b004:l023","ordinal":125091,"en":"Were friends for the next world."},{"id":"semetey-1-2013:p0634:b004:l024","ordinal":125092,"en":"At the bellows, he contended;"},{"id":"semetey-1-2013:p0634:b004:l025","ordinal":125093,"en":"When your Bölökö struck with his hammer,"},{"id":"semetey-1-2013:p0634:b004:l026","ordinal":125094,"en":"He consulted with Döötü."},{"id":"semetey-1-2013:p0634:b004:l027","ordinal":125095,"en":"Parted from his companion—"},{"id":"semetey-1-2013:p0634:b004:l028","ordinal":125096,"en":"To tell this world's tale briefly—"},{"id":"semetey-1-2013:p0634:b004:l029","ordinal":125097,"en":"His fame reached all the world,"},{"id":"semetey-1-2013:p0634:b004:l030","ordinal":125098,"en":"That dear smith Bölökbai,"},{"id":"semetey-1-2013:p0634:b004:l031","ordinal":125099,"en":"Of my leopard father, Khan Manas,"},{"id":"semetey-1-2013:p0634:b004:l032","ordinal":125100,"en":"The smith of Manas Khan."},{"id":"semetey-1-2013:p0634:b004:l033","ordinal":125101,"en":"My father's countless gold coins,"},{"id":"semetey-1-2013:p0634:b004:l034","ordinal":125102,"en":"My six elder kinsmen came and scattered."},{"id":"semetey-1-2013:p0634:b004:l035","ordinal":125103,"en":"Suffering harsh humiliation there,"},{"id":"semetey-1-2013:p0634:b004:l036","ordinal":125104,"en":"On that day, oh God,"},{"id":"semetey-1-2013:p0634:b004:l037","ordinal":125105,"en":"My Bölökö had arrived."},{"id":"semetey-1-2013:p0634:b004:l038","ordinal":125106,"en":"Bölökbai's forty young men"},{"id":"semetey-1-2013:p0634:b004:l039","ordinal":125107,"en":"Had been given the name ‘forty guards,’"},{"id":"semetey-1-2013:p0635:b003:l001","ordinal":125108,"en":"Bringing them into disgrace,"},{"id":"semetey-1-2013:p0635:b003:l002","ordinal":125109,"en":"When leopard Manas died,"},{"id":"semetey-1-2013:p0635:b003:l003","ordinal":125110,"en":"Their kindled fire was quenched,"},{"id":"semetey-1-2013:p0635:b003:l004","ordinal":125111,"en":"They were all driven from their homes."},{"id":"semetey-1-2013:p0635:b003:l005","ordinal":125112,"en":"Screaming under humiliation,"},{"id":"semetey-1-2013:p0635:b003:l006","ordinal":125113,"en":"Crying, ‘Alas, Manas, do not die!’"},{"id":"semetey-1-2013:p0635:b003:l007","ordinal":125114,"en":"They went away in tears."},{"id":"semetey-1-2013:p0635:b003:l008","ordinal":125115,"en":"Vanishing from sight, they lived;"},{"id":"semetey-1-2013:p0635:b003:l009","ordinal":125116,"en":"Fleeing, they kept themselves alive."},{"id":"semetey-1-2013:p0635:b003:l010","ordinal":125117,"en":"They cried from the mountaintops,"},{"id":"semetey-1-2013:p0635:b003:l011","ordinal":125118,"en":"‘Will Semetey ever come?’"},{"id":"semetey-1-2013:p0635:b003:l012","ordinal":125119,"en":"Calling to everyone they saw."},{"id":"semetey-1-2013:p0635:b003:l013","ordinal":125120,"en":"Twelve years had passed."},{"id":"semetey-1-2013:p0635:b003:l014","ordinal":125121,"en":"They had suffered such misery"},{"id":"semetey-1-2013:p0635:b003:l015","ordinal":125122,"en":"That they were at the point of death."},{"id":"semetey-1-2013:p0635:b003:l016","ordinal":125123,"en":"The reason they were dying—"},{"id":"semetey-1-2013:p0635:b003:l017","ordinal":125124,"en":"When they came there wailing,"},{"id":"semetey-1-2013:p0635:b003:l018","ordinal":125125,"en":"Manas's son saw the extent of it:"},{"id":"semetey-1-2013:p0635:b003:l019","ordinal":125126,"en":"Barefoot and bareheaded,"},{"id":"semetey-1-2013:p0635:b003:l020","ordinal":125127,"en":"Their wretched heads grown piebald,"},{"id":"semetey-1-2013:p0635:b003:l021","ordinal":125128,"en":"Their torn coats split apart,"},{"id":"semetey-1-2013:p0635:b003:l022","ordinal":125129,"en":"With Khan Bölökbai at their head,"},{"id":"semetey-1-2013:p0635:b003:l023","ordinal":125130,"en":"Bowl-sized patches of flesh exposed."},{"id":"semetey-1-2013:p0635:b003:l024","ordinal":125131,"en":"From all his suffering, my Bölökö"},{"id":"semetey-1-2013:p0635:b003:l025","ordinal":125132,"en":"Was at the point of death."},{"id":"semetey-1-2013:p0635:b003:l026","ordinal":125133,"en":"Terrible hardship, calamity—"},{"id":"semetey-1-2013:p0635:b003:l027","ordinal":125134,"en":"Had the boy not come then,"},{"id":"semetey-1-2013:p0635:b003:l028","ordinal":125135,"en":"That was what awaited them."},{"id":"semetey-1-2013:p0635:b003:l029","ordinal":125136,"en":"His trousers of yellow hide"},{"id":"semetey-1-2013:p0635:b003:l030","ordinal":125137,"en":"Had split into countless pieces."},{"id":"semetey-1-2013:p0635:b003:l031","ordinal":125138,"en":"He scarcely looked human;"},{"id":"semetey-1-2013:p0635:b003:l032","ordinal":125139,"en":"Oh, dear Bölökbai,"},{"id":"semetey-1-2013:p0635:b003:l033","ordinal":125140,"en":"He looked like a scarecrow."},{"id":"semetey-1-2013:p0635:b003:l034","ordinal":125141,"en":"When dear Manas was alive,"},{"id":"semetey-1-2013:p0635:b003:l035","ordinal":125142,"en":"Bölökbai was a giant of a smith,"},{"id":"semetey-1-2013:p0635:b003:l036","ordinal":125143,"en":"Master of the treasury."},{"id":"semetey-1-2013:p0635:b003:l037","ordinal":125144,"en":"In blue-gray lynx and marten caps,"},{"id":"semetey-1-2013:p0635:b003:l038","ordinal":125145,"en":"He was a khan who tossed his head,"},{"id":"semetey-1-2013:p0635:b003:l039","ordinal":125146,"en":"Possessing great wealth,"},{"id":"semetey-1-2013:p0635:b005:l001","ordinal":125147,"en":"He had lived in delight."},{"id":"semetey-1-2013:p0635:b005:l002","ordinal":125148,"en":"The multitude of Kyrgyz made for the lowlands;"},{"id":"semetey-1-2013:p0635:b005:l003","ordinal":125149,"en":"Those were the days when they camped there."},{"id":"semetey-1-2013:p0635:b005:l004","ordinal":125150,"en":"By day, kumis; by night, girls—"},{"id":"semetey-1-2013:p0635:b005:l005","ordinal":125151,"en":"Such had been his life."},{"id":"semetey-1-2013:p0635:b005:l006","ordinal":125152,"en":"When the leopard was alive,"},{"id":"semetey-1-2013:p0635:b005:l007","ordinal":125153,"en":"This Bölökbai standing here"},{"id":"semetey-1-2013:p0635:b005:l008","ordinal":125154,"en":"Would take a whole beaver skin,"},{"id":"semetey-1-2013:p0635:b005:l009","ordinal":125155,"en":"Split it in two,"},{"id":"semetey-1-2013:p0635:b005:l010","ordinal":125156,"en":"And put it on his trouser cuffs."},{"id":"semetey-1-2013:p0635:b005:l011","ordinal":125157,"en":"Bölökbai, master of the treasury,"},{"id":"semetey-1-2013:p0635:b005:l012","ordinal":125158,"en":"Shot roe deer when he was bored."},{"id":"semetey-1-2013:p0635:b005:l013","ordinal":125159,"en":"Racing two-year colts, flying hawks,"},{"id":"semetey-1-2013:p0635:b005:l014","ordinal":125160,"en":"When his companion Manas lived,"},{"id":"semetey-1-2013:p0635:b005:l015","ordinal":125161,"en":"He reveled wildly."},{"id":"semetey-1-2013:p0635:b005:l016","ordinal":125162,"en":"When that Manas died,"},{"id":"semetey-1-2013:p0635:b005:l017","ordinal":125163,"en":"Your Khan Bölö fled and wandered,"},{"id":"semetey-1-2013:p0635:b005:l018","ordinal":125164,"en":"A wretched coat across his shoulders—"},{"id":"semetey-1-2013:p0635:b005:l020","ordinal":125165,"en":"Life is sweet; one will not enter the earth.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0635:b005:l021","ordinal":125166,"en":"Thus he had suffered humiliation."},{"id":"semetey-1-2013:p0635:b005:l022","ordinal":125167,"en":"Seen today, gone tomorrow—"},{"id":"semetey-1-2013:p0635:b005:l023","ordinal":125168,"en":"The misery Bölökbai had suffered!"},{"id":"semetey-1-2013:p0635:b005:l024","ordinal":125169,"en":"Damn it, the world is shit!"},{"id":"semetey-1-2013:p0635:b005:l025","ordinal":125170,"en":"Mountain-like Manas had died."},{"id":"semetey-1-2013:p0635:b005:l026","ordinal":125171,"en":"Living along the mountain slopes,"},{"id":"semetey-1-2013:p0635:b005:l027","ordinal":125172,"en":"Bölökbai had kept himself alive."},{"id":"semetey-1-2013:p0635:b005:l028","ordinal":125173,"en":"Barefoot and bareheaded,"},{"id":"semetey-1-2013:p0635:b005:l029","ordinal":125174,"en":"Bölökbai had wandered,"},{"id":"semetey-1-2013:p0635:b005:l031","ordinal":125175,"en":"For Khan Manas's son,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0635:b005:l032","ordinal":125176,"en":"Bölökbai's heart had burned."},{"id":"semetey-1-2013:p0635:b005:l033","ordinal":125177,"en":"Once Bölökbai saw the boy,"},{"id":"semetey-1-2013:p0635:b005:l034","ordinal":125178,"en":"A honeysuckle staff in his hand,"},{"id":"semetey-1-2013:p0635:b005:l035","ordinal":125179,"en":"A wretched coat upon his back,"},{"id":"semetey-1-2013:p0635:b005:l036","ordinal":125180,"en":"He hurried toward the boy,"},{"id":"semetey-1-2013:p0635:b005:l037","ordinal":125181,"en":"To the orphan, Manas's son,"},{"id":"semetey-1-2013:p0635:b005:l038","ordinal":125182,"en":"He came with pleas."},{"id":"semetey-1-2013:p0635:b005:l039","ordinal":125183,"en":"While Bölökbai stood weeping,"},{"id":"semetey-1-2013:p0636:b003:l001","ordinal":125184,"en":"Semetey was in his arms."}]
