[{"id":"semetey-1-2013:p0266:b004:l016","ordinal":97281,"en":"“At Semetey's feast,"},{"id":"semetey-1-2013:p0266:b004:l017","ordinal":97282,"en":"There was so much wonder,”"},{"id":"semetey-1-2013:p0266:b004:l018","ordinal":97283,"en":"To the old men by the fire,"},{"id":"semetey-1-2013:p0266:b004:l019","ordinal":97284,"en":"To the children at play,"},{"id":"semetey-1-2013:p0266:b004:l020","ordinal":97285,"en":"To the learned khans,"},{"id":"semetey-1-2013:p0266:b004:l021","ordinal":97286,"en":"To those who act the great lord,"},{"id":"semetey-1-2013:p0266:b004:l022","ordinal":97287,"en":"Go tell it without shame."},{"id":"semetey-1-2013:p0266:b004:l023","ordinal":97288,"en":"Let these games be an example."},{"id":"semetey-1-2013:p0266:b004:l024","ordinal":97289,"en":"Put on a true spectacle."},{"id":"semetey-1-2013:p0266:b004:l025","ordinal":97290,"en":"Let one wrestler step out there,"},{"id":"semetey-1-2013:p0266:b004:l026","ordinal":97291,"en":"And one wrestler step out here."},{"id":"semetey-1-2013:p0266:b004:l027","ordinal":97292,"en":"Wrestle fairly,"},{"id":"semetey-1-2013:p0266:b004:l028","ordinal":97293,"en":"Put on a mighty spectacle."},{"id":"semetey-1-2013:p0266:b004:l029","ordinal":97294,"en":"I offer a thousand dark camels,"},{"id":"semetey-1-2013:p0266:b004:l030","ordinal":97295,"en":"A thousand black mares with white blazes."},{"id":"semetey-1-2013:p0266:b004:l031","ordinal":97296,"en":"You who fall, go empty-handed;"},{"id":"semetey-1-2013:p0266:b004:l032","ordinal":97297,"en":"You who throw them, take the prize!”"},{"id":"semetey-1-2013:p0266:b004:l033","ordinal":97298,"en":"On the plain this side of Bukhara,"},{"id":"semetey-1-2013:p0266:b004:l034","ordinal":97299,"en":"The people spoke,"},{"id":"semetey-1-2013:p0266:b004:l035","ordinal":97300,"en":"Putting their words before the gathering,"},{"id":"semetey-1-2013:p0266:b004:l036","ordinal":97301,"en":"Competing in finding answers."},{"id":"semetey-1-2013:p0266:b004:l037","ordinal":97302,"en":"In bustling Bukhara,"},{"id":"semetey-1-2013:p0266:b004:l038","ordinal":97303,"en":"They held an assembly for three days."},{"id":"semetey-1-2013:p0266:b004:l039","ordinal":97304,"en":"Some wrangled and quarreled,"},{"id":"semetey-1-2013:p0267:b003:l001","ordinal":97305,"en":"Standing in council,"},{"id":"semetey-1-2013:p0267:b003:l002","ordinal":97306,"en":"On that plain of broad Bukhara,"},{"id":"semetey-1-2013:p0267:b003:l003","ordinal":97307,"en":"Without a furrow touched by a plow,"},{"id":"semetey-1-2013:p0267:b003:l004","ordinal":97308,"en":"Without a burrow dug by a marmot,"},{"id":"semetey-1-2013:p0267:b003:l005","ordinal":97309,"en":"They prepared a suitable spot."},{"id":"semetey-1-2013:p0267:b003:l006","ordinal":97310,"en":"The wrestlers grappled without holding back."},{"id":"semetey-1-2013:p0267:b003:l007","ordinal":97311,"en":"They went to the wrestling ground."},{"id":"semetey-1-2013:p0267:b003:l008","ordinal":97312,"en":"The Six Cities, the khan of Kokand,"},{"id":"semetey-1-2013:p0267:b003:l009","ordinal":97313,"en":"Andijan above, Margalang,"},{"id":"semetey-1-2013:p0267:b003:l010","ordinal":97314,"en":"Samarkand where stakes were set,"},{"id":"semetey-1-2013:p0267:b003:l011","ordinal":97315,"en":"All the Sarts gathered."},{"id":"semetey-1-2013:p0267:b003:l012","ordinal":97316,"en":"Toobalban came out from Kokand,"},{"id":"semetey-1-2013:p0267:b003:l013","ordinal":97317,"en":"Akbalban came out from Bukhara."},{"id":"semetey-1-2013:p0267:b003:l014","ordinal":97318,"en":"The two wrestlers grappled,"},{"id":"semetey-1-2013:p0267:b003:l015","ordinal":97319,"en":"Standing braced against each other."},{"id":"semetey-1-2013:p0267:b003:l016","ordinal":97320,"en":"The eight khans who came to Bukhara"},{"id":"semetey-1-2013:p0267:b003:l017","ordinal":97321,"en":"Were immersed in the spectacle."},{"id":"semetey-1-2013:p0267:b003:l018","ordinal":97322,"en":"Akbalban and Toobalban"},{"id":"semetey-1-2013:p0267:b003:l019","ordinal":97323,"en":"Knew each other,"},{"id":"semetey-1-2013:p0267:b003:l020","ordinal":97324,"en":"But without a feast on a grand scale,"},{"id":"semetey-1-2013:p0267:b003:l021","ordinal":97325,"en":"They had not managed to meet."},{"id":"semetey-1-2013:p0267:b003:l022","ordinal":97326,"en":"Gnashing like hungry bull camels,"},{"id":"semetey-1-2013:p0267:b003:l023","ordinal":97327,"en":"Grappling without rest for six days,"},{"id":"semetey-1-2013:p0267:b003:l024","ordinal":97328,"en":"Gripping each other's trouser legs,"},{"id":"semetey-1-2013:p0267:b003:l025","ordinal":97329,"en":"Attempting trips here and there,"},{"id":"semetey-1-2013:p0267:b003:l026","ordinal":97330,"en":"Butting like gray bulls,"},{"id":"semetey-1-2013:p0267:b003:l027","ordinal":97331,"en":"Tearing at whatever they could reach,"},{"id":"semetey-1-2013:p0267:b003:l028","ordinal":97332,"en":"When the wrestlers' struggle"},{"id":"semetey-1-2013:p0267:b003:l029","ordinal":97333,"en":"Had lasted six days,"},{"id":"semetey-1-2013:p0267:b003:l030","ordinal":97334,"en":"Bukhara's Akbalban"},{"id":"semetey-1-2013:p0267:b003:l031","ordinal":97335,"en":"Was left without strength."},{"id":"semetey-1-2013:p0267:b003:l032","ordinal":97336,"en":"Kokand's Toobalban"},{"id":"semetey-1-2013:p0267:b003:l033","ordinal":97337,"en":"Lifted and hurled him down."},{"id":"semetey-1-2013:p0267:b003:l034","ordinal":97338,"en":"All the many prizes,"},{"id":"semetey-1-2013:p0267:b003:l035","ordinal":97339,"en":"The Six Cities and the khan of Kokand"},{"id":"semetey-1-2013:p0267:b003:l036","ordinal":97340,"en":"Began scrambling to seize."},{"id":"semetey-1-2013:p0267:b003:l037","ordinal":97341,"en":"Seeing this, Semetey"},{"id":"semetey-1-2013:p0267:b003:l038","ordinal":97342,"en":"Burned inside."},{"id":"semetey-1-2013:p0267:b003:l039","ordinal":97343,"en":"Beyond his gray-maned father Manas,"},{"id":"semetey-1-2013:p0267:b005:l001","ordinal":97344,"en":"He was a hero born to surpass him,"},{"id":"semetey-1-2013:p0267:b005:l002","ordinal":97345,"en":"A lion born a panther,"},{"id":"semetey-1-2013:p0267:b005:l003","ordinal":97346,"en":"Who poured blood into clear water,"},{"id":"semetey-1-2013:p0267:b005:l004","ordinal":97347,"en":"Offspring of the heedless one,"},{"id":"semetey-1-2013:p0267:b005:l005","ordinal":97348,"en":"Who set the grassy earth smoking,"},{"id":"semetey-1-2013:p0267:b005:l006","ordinal":97349,"en":"Descendant of Dumbok*."},{"id":"semetey-1-2013:p0267:b005:l007","ordinal":97350,"en":"Driving and chasing white deer,"},{"id":"semetey-1-2013:p0267:b005:l008","ordinal":97351,"en":"Offspring of one who turned them into cattle,"},{"id":"semetey-1-2013:p0267:b005:l009","ordinal":97352,"en":"All the whole world,"},{"id":"semetey-1-2013:p0267:b005:l010","ordinal":97353,"en":"Offspring of one who threw it into turmoil,"},{"id":"semetey-1-2013:p0267:b005:l011","ordinal":97354,"en":"Driving gray deer and making them cattle,"},{"id":"semetey-1-2013:p0267:b005:l012","ordinal":97355,"en":"Throwing every place he saw into turmoil,"},{"id":"semetey-1-2013:p0267:b005:l013","ordinal":97356,"en":"Taking it as a matter of honor, eyes blazing,"},{"id":"semetey-1-2013:p0267:b005:l014","ordinal":97357,"en":"His dear teeth broad as gates,"},{"id":"semetey-1-2013:p0267:b005:l015","ordinal":97358,"en":"Clenching them hard till they cracked,"},{"id":"semetey-1-2013:p0267:b005:l016","ordinal":97359,"en":"His eyes blazing like a lion's,"},{"id":"semetey-1-2013:p0267:b005:l017","ordinal":97360,"en":"Flame hissing from his mouth,"},{"id":"semetey-1-2013:p0267:b005:l018","ordinal":97361,"en":"His teeth cracking when he clenched them,"},{"id":"semetey-1-2013:p0267:b005:l019","ordinal":97362,"en":"Semetey felt deeply ashamed,"},{"id":"semetey-1-2013:p0267:b005:l020","ordinal":97363,"en":"As though his honor had been lost:"},{"id":"semetey-1-2013:p0267:b005:l021","ordinal":97364,"en":"“Bukhara's wrestler,"},{"id":"semetey-1-2013:p0267:b005:l022","ordinal":97365,"en":"Kokand's Toobalban—"},{"id":"semetey-1-2013:p0267:b005:l023","ordinal":97366,"en":"What is this, that he should throw him?"},{"id":"semetey-1-2013:p0267:b005:l024","ordinal":97367,"en":"Bukhara's burning tree,"},{"id":"semetey-1-2013:p0267:b005:l025","ordinal":97368,"en":"What is this, that it should break?"},{"id":"semetey-1-2013:p0267:b005:l026","ordinal":97369,"en":"All the many prizes—the Six Cities,"},{"id":"semetey-1-2013:p0267:b005:l027","ordinal":97370,"en":"What is this, that they should take them?"},{"id":"semetey-1-2013:p0267:b005:l028","ordinal":97371,"en":"Their spirit broken, distraught,"},{"id":"semetey-1-2013:p0267:b005:l029","ordinal":97372,"en":"All the people of Bukhara,"},{"id":"semetey-1-2013:p0267:b005:l030","ordinal":97373,"en":"What is this, that they should be left so?"},{"id":"semetey-1-2013:p0267:b005:l031","ordinal":97374,"en":"Good heavens, how could I make Toobalban a giant,"},{"id":"semetey-1-2013:p0267:b005:l033","ordinal":97375,"en":"When my father has grown old,"},{"id":"semetey-1-2013:p0267:b005:l034","ordinal":97376,"en":"Letting his golden throne be taken,"},{"id":"semetey-1-2013:p0267:b005:l035","ordinal":97377,"en":"How could I make him master of Bukhara?"},{"id":"semetey-1-2013:p0267:b005:l036","ordinal":97378,"en":"Like Temir, the khan I rely upon,"},{"id":"semetey-1-2013:p0267:b005:l037","ordinal":97379,"en":"Bukhara's golden throne,"},{"id":"semetey-1-2013:p0267:b005:l038","ordinal":97380,"en":"Having thrown its wrestler,"},{"id":"semetey-1-2013:p0267:b005:l039","ordinal":97381,"en":"Without letting him say, ‘I seized it,’—"},{"id":"semetey-1-2013:p0268:b003:l001","ordinal":97382,"en":"Whose honor has been broken?"},{"id":"semetey-1-2013:p0268:b003:l002","ordinal":97383,"en":"Whose bones are aching?"},{"id":"semetey-1-2013:p0268:b003:l003","ordinal":97384,"en":"Let me die before I see this!"},{"id":"semetey-1-2013:p0268:b003:l004","ordinal":97385,"en":"Rather than live like this,"},{"id":"semetey-1-2013:p0268:b003:l005","ordinal":97386,"en":"Let me sink away as though never born!"},{"id":"semetey-1-2013:p0268:b003:l006","ordinal":97387,"en":"What has been written on my forehead,"},{"id":"semetey-1-2013:p0268:b003:l007","ordinal":97388,"en":"Let me bear it upon my neck."},{"id":"semetey-1-2013:p0268:b003:l008","ordinal":97389,"en":"Seven houses filled with much gold,"},{"id":"semetey-1-2013:p0268:b003:l009","ordinal":97390,"en":"To those there in Margalang,"},{"id":"semetey-1-2013:p0268:b003:l010","ordinal":97391,"en":"How could I give it to the Sarts?"},{"id":"semetey-1-2013:p0268:b003:l011","ordinal":97392,"en":"The wealth I hold,"},{"id":"semetey-1-2013:p0268:b003:l012","ordinal":97393,"en":"Offering it all as a stake,"},{"id":"semetey-1-2013:p0268:b003:l013","ordinal":97394,"en":"With this Toobalban here,"},{"id":"semetey-1-2013:p0268:b003:l014","ordinal":97395,"en":"Let me try wrestling once."},{"id":"semetey-1-2013:p0268:b003:l015","ordinal":97396,"en":"If the Almighty has written my death,"},{"id":"semetey-1-2013:p0268:b003:l016","ordinal":97397,"en":"Let me die at Toobalban's hands."},{"id":"semetey-1-2013:p0268:b003:l017","ordinal":97398,"en":"Otherwise, with this Toobalban here,"},{"id":"semetey-1-2013:p0268:b003:l018","ordinal":97399,"en":"Let me have a wrestling bout."},{"id":"semetey-1-2013:p0268:b003:l019","ordinal":97400,"en":"If I throw Toobalban,"},{"id":"semetey-1-2013:p0268:b003:l020","ordinal":97401,"en":"Let me tear out his arm!”"},{"id":"semetey-1-2013:p0268:b003:l021","ordinal":97402,"en":"So saying then,"},{"id":"semetey-1-2013:p0268:b003:l022","ordinal":97403,"en":"Semetey came down shouting,"},{"id":"semetey-1-2013:p0268:b003:l023","ordinal":97404,"en":"Calling, “Toobalban!”"},{"id":"semetey-1-2013:p0268:b003:l024","ordinal":97405,"en":"“By your father's grave, Toobalban,"},{"id":"semetey-1-2013:p0268:b003:l025","ordinal":97406,"en":"Turn your neck this way a moment."},{"id":"semetey-1-2013:p0268:b003:l026","ordinal":97407,"en":"I shall wrestle; wait a moment!"},{"id":"semetey-1-2013:p0268:b003:l027","ordinal":97408,"en":"Throw me too before you leave,"},{"id":"semetey-1-2013:p0268:b003:l028","ordinal":97409,"en":"Sate yourself with abundant booty!”"},{"id":"semetey-1-2013:p0268:b003:l029","ordinal":97410,"en":"Saying this in anger,"},{"id":"semetey-1-2013:p0268:b003:l030","ordinal":97411,"en":"His knees bending as he stepped,"},{"id":"semetey-1-2013:p0268:b003:l031","ordinal":97412,"en":"He ran toward Toobalban."},{"id":"semetey-1-2013:p0268:b003:l032","ordinal":97413,"en":"He meant to draw the line."},{"id":"semetey-1-2013:p0268:b003:l033","ordinal":97414,"en":"He meant to start a disturbance."},{"id":"semetey-1-2013:p0268:b003:l034","ordinal":97415,"en":"The brave orphan left by Manas"},{"id":"semetey-1-2013:p0268:b003:l035","ordinal":97416,"en":"Meant to make a spectacle."},{"id":"semetey-1-2013:p0268:b003:l036","ordinal":97417,"en":"Seeing the boy,"},{"id":"semetey-1-2013:p0268:b003:l037","ordinal":97418,"en":"Ismayyl, whom he called father,"},{"id":"semetey-1-2013:p0268:b003:l038","ordinal":97419,"en":"Was troubled in his thoughts too."},{"id":"semetey-1-2013:p0268:b003:l039","ordinal":97420,"en":"He ran up and seized"},{"id":"semetey-1-2013:p0268:b004:l001","ordinal":97421,"en":"The boy, brave Semetey."},{"id":"semetey-1-2013:p0268:b004:l002","ordinal":97422,"en":"Startled, he spoke:"},{"id":"semetey-1-2013:p0268:b004:l003","ordinal":97423,"en":"“Alas, my only one!” he said."},{"id":"semetey-1-2013:p0268:b004:l004","ordinal":97424,"en":"“A khan does not wrestle a wrestler."},{"id":"semetey-1-2013:p0268:b004:l005","ordinal":97425,"en":"What are you doing, my son?” he said."},{"id":"semetey-1-2013:p0268:b004:l006","ordinal":97426,"en":"“Your calves have not filled out."},{"id":"semetey-1-2013:p0268:b004:l007","ordinal":97427,"en":"Let me take your misfortune upon myself."},{"id":"semetey-1-2013:p0268:b004:l008","ordinal":97428,"en":"Your time to challenge has not yet come."},{"id":"semetey-1-2013:p0268:b004:l009","ordinal":97429,"en":"Your flanks have not filled out."},{"id":"semetey-1-2013:p0268:b004:l010","ordinal":97430,"en":"Your time to grapple has not yet come."},{"id":"semetey-1-2013:p0268:b004:l011","ordinal":97431,"en":"You are unformed as an egg."},{"id":"semetey-1-2013:p0268:b004:l012","ordinal":97432,"en":"You yourself are a boy of twelve."},{"id":"semetey-1-2013:p0268:b004:l013","ordinal":97433,"en":"Wrestling Toobalban,"},{"id":"semetey-1-2013:p0268:b004:l014","ordinal":97434,"en":"My foal, you will be shamed!"},{"id":"semetey-1-2013:p0268:b004:l015","ordinal":97435,"en":"You have not yet turned seventeen."},{"id":"semetey-1-2013:p0268:b004:l016","ordinal":97436,"en":"My foal, your time to clash has not yet come."},{"id":"semetey-1-2013:p0268:b004:l017","ordinal":97437,"en":"At twelve years old,"},{"id":"semetey-1-2013:p0268:b004:l018","ordinal":97438,"en":"Do not declare you will wrestle."},{"id":"semetey-1-2013:p0268:b004:l019","ordinal":97439,"en":"Do not bring shame upon yourself.”"},{"id":"semetey-1-2013:p0268:b004:l020","ordinal":97440,"en":"While his father stood saying this,"},{"id":"semetey-1-2013:p0268:b004:l021","ordinal":97441,"en":"The young goshawk Semetey,"},{"id":"semetey-1-2013:p0268:b004:l022","ordinal":97442,"en":"His eyes blazed like a lion's."},{"id":"semetey-1-2013:p0268:b004:l023","ordinal":97443,"en":"Your goshawk born of noble stock,"},{"id":"semetey-1-2013:p0268:b004:l024","ordinal":97444,"en":"His thirst for blood seized him."},{"id":"semetey-1-2013:p0268:b004:l025","ordinal":97445,"en":"He summoned fierce resolve."},{"id":"semetey-1-2013:p0268:b004:l026","ordinal":97446,"en":"His father who held him—"},{"id":"semetey-1-2013:p0268:b004:l027","ordinal":97447,"en":"As though he would swallow them whole."},{"id":"semetey-1-2013:p0268:b004:l028","ordinal":97448,"en":"“Alas, Father, what are you saying?"},{"id":"semetey-1-2013:p0268:b004:l029","ordinal":97449,"en":"You are a wretched man."},{"id":"semetey-1-2013:p0268:b004:l030","ordinal":97450,"en":"You do not even look like a hare."},{"id":"semetey-1-2013:p0268:b004:l031","ordinal":97451,"en":"You are a worthless man!"},{"id":"semetey-1-2013:p0268:b004:l032","ordinal":97452,"en":"Like a black young ram,"},{"id":"semetey-1-2013:p0268:b004:l033","ordinal":97453,"en":"You bob about."},{"id":"semetey-1-2013:p0268:b004:l034","ordinal":97454,"en":"Like a male black crow,"},{"id":"semetey-1-2013:p0268:b004:l035","ordinal":97455,"en":"Foolish as you are,"},{"id":"semetey-1-2013:p0268:b004:l036","ordinal":97456,"en":"You hop about."},{"id":"semetey-1-2013:p0268:b004:l037","ordinal":97457,"en":"Making an omen of a single word,"},{"id":"semetey-1-2013:p0268:b004:l038","ordinal":97458,"en":"Do you take fright?"},{"id":"semetey-1-2013:p0268:b004:l039","ordinal":97459,"en":"Speaking words that would not tire a horse,"},{"id":"semetey-1-2013:p0269:b003:l001","ordinal":97460,"en":"You block my way!"},{"id":"semetey-1-2013:p0269:b003:l002","ordinal":97461,"en":"Think of these words, Father."},{"id":"semetey-1-2013:p0269:b003:l003","ordinal":97462,"en":"Whose honor has been lost?"},{"id":"semetey-1-2013:p0269:b003:l004","ordinal":97463,"en":"Do not babble, Father."},{"id":"semetey-1-2013:p0269:b003:l005","ordinal":97464,"en":"Whose honor has been won?"},{"id":"semetey-1-2013:p0269:b003:l006","ordinal":97465,"en":"Whose horn has been broken?"},{"id":"semetey-1-2013:p0269:b003:l007","ordinal":97466,"en":"Whose bones are aching?"},{"id":"semetey-1-2013:p0269:b003:l008","ordinal":97467,"en":"‘Bukhara has lost its livestock,"},{"id":"semetey-1-2013:p0269:b003:l009","ordinal":97468,"en":"It is utterly bare,’ will they not say?"},{"id":"semetey-1-2013:p0269:b003:l010","ordinal":97469,"en":"‘Not one young man defended his honor."},{"id":"semetey-1-2013:p0269:b003:l011","ordinal":97470,"en":"All the people of Bukhara"},{"id":"semetey-1-2013:p0269:b003:l012","ordinal":97471,"en":"Are women,’ will they not say?"},{"id":"semetey-1-2013:p0269:b003:l013","ordinal":97472,"en":"Over nothing, without cause,"},{"id":"semetey-1-2013:p0269:b003:l014","ordinal":97473,"en":"You take fright."},{"id":"semetey-1-2013:p0269:b003:l015","ordinal":97474,"en":"Speaking such very bad words,"},{"id":"semetey-1-2013:p0269:b003:l016","ordinal":97475,"en":"You block a man's way."},{"id":"semetey-1-2013:p0269:b003:l017","ordinal":97476,"en":"Does not a mortal creature die?"},{"id":"semetey-1-2013:p0269:b003:l018","ordinal":97477,"en":"What has been written for the life held in trust,"},{"id":"semetey-1-2013:p0269:b003:l019","ordinal":97478,"en":"Must not this poor entrusted soul experience?"},{"id":"semetey-1-2013:p0269:b003:l020","ordinal":97479,"en":"When Almighty Allah"},{"id":"semetey-1-2013:p0269:b003:l021","ordinal":97480,"en":"Gives His mighty command,"},{"id":"semetey-1-2013:p0269:b003:l022","ordinal":97481,"en":"The soul-taking angel Azrael,"},{"id":"semetey-1-2013:p0269:b003:l023","ordinal":97482,"en":"Stretching out his five fingers,"},{"id":"semetey-1-2013:p0269:b003:l024","ordinal":97483,"en":"Stands close to a mortal,"},{"id":"semetey-1-2013:p0269:b003:l025","ordinal":97484,"en":"The poor tongue is tied, unable to speak."},{"id":"semetey-1-2013:p0269:b003:l026","ordinal":97485,"en":"From this faithless world,"},{"id":"semetey-1-2013:p0269:b003:l027","ordinal":97486,"en":"Father, who can flee and escape?"},{"id":"semetey-1-2013:p0269:b003:l028","ordinal":97487,"en":"Speaking useless words without cause,"},{"id":"semetey-1-2013:p0269:b003:l029","ordinal":97488,"en":"You take fright."},{"id":"semetey-1-2013:p0269:b003:l030","ordinal":97489,"en":"Letting great honor be lost,"},{"id":"semetey-1-2013:p0269:b003:l031","ordinal":97490,"en":"You block my way.”"},{"id":"semetey-1-2013:p0269:b003:l032","ordinal":97491,"en":"Your gray-maned hero stood brooding:"},{"id":"semetey-1-2013:p0269:b003:l033","ordinal":97492,"en":"“Alas, my father Ismayyl,"},{"id":"semetey-1-2013:p0269:b003:l034","ordinal":97493,"en":"If I do not wrestle at twelve,"},{"id":"semetey-1-2013:p0269:b003:l035","ordinal":97494,"en":"When I reach thirty-five,"},{"id":"semetey-1-2013:p0269:b003:l036","ordinal":97495,"en":"Will I catch a tethered dog?"},{"id":"semetey-1-2013:p0269:b003:l037","ordinal":97496,"en":"If I do not wrestle at eleven,"},{"id":"semetey-1-2013:p0269:b003:l038","ordinal":97497,"en":"When I reach nineteen,"},{"id":"semetey-1-2013:p0269:b003:l039","ordinal":97498,"en":"Will my blow go through dung?"},{"id":"semetey-1-2013:p0269:b004:l001","ordinal":97499,"en":"Do not block my way, Father."},{"id":"semetey-1-2013:p0269:b004:l002","ordinal":97500,"en":"Let go of my hand, Father!”"},{"id":"semetey-1-2013:p0269:b004:l003","ordinal":97501,"en":"However much he spoke, he would not listen."},{"id":"semetey-1-2013:p0269:b004:l004","ordinal":97502,"en":"He humiliated the boy."},{"id":"semetey-1-2013:p0269:b004:l005","ordinal":97503,"en":"‘Do not wrestle,’ he kept blocking him,"},{"id":"semetey-1-2013:p0269:b004:l006","ordinal":97504,"en":"Using force against the boy."},{"id":"semetey-1-2013:p0269:b004:l007","ordinal":97505,"en":"Would he submit to that force?"},{"id":"semetey-1-2013:p0269:b004:l008","ordinal":97506,"en":"Would the boy surrender his equal standing?"},{"id":"semetey-1-2013:p0269:b004:l009","ordinal":97507,"en":"His father Ismayyl,"},{"id":"semetey-1-2013:p0269:b004:l010","ordinal":97508,"en":"He struck him squarely on the cheek,"},{"id":"semetey-1-2013:p0269:b004:l011","ordinal":97509,"en":"And shoved him away."},{"id":"semetey-1-2013:p0269:b004:l012","ordinal":97510,"en":"Like a felled log,"},{"id":"semetey-1-2013:p0269:b004:l013","ordinal":97511,"en":"Ismayyl fell sprawling."},{"id":"semetey-1-2013:p0269:b004:l014","ordinal":97512,"en":"Like a feedbag, jolting,"},{"id":"semetey-1-2013:p0269:b004:l015","ordinal":97513,"en":"Ismayyl fell down."},{"id":"semetey-1-2013:p0269:b004:l016","ordinal":97514,"en":"Breaking free from Ismayyl,"},{"id":"semetey-1-2013:p0269:b004:l017","ordinal":97515,"en":"Then the boy Semetey"},{"id":"semetey-1-2013:p0269:b004:l018","ordinal":97516,"en":"Shouted in anger,"},{"id":"semetey-1-2013:p0269:b004:l019","ordinal":97517,"en":"Calling Toobalban:"},{"id":"semetey-1-2013:p0269:b004:l020","ordinal":97518,"en":"“Turn your horse's head a moment."},{"id":"semetey-1-2013:p0269:b004:l021","ordinal":97519,"en":"By your father's grave, Toobalban,"},{"id":"semetey-1-2013:p0269:b004:l022","ordinal":97520,"en":"Stand out in front a moment!"},{"id":"semetey-1-2013:p0269:b004:l023","ordinal":97521,"en":"Throw me too before you leave."},{"id":"semetey-1-2013:p0269:b004:l024","ordinal":97522,"en":"If you are a mighty wrestler,"},{"id":"semetey-1-2013:p0269:b004:l025","ordinal":97523,"en":"Lay me out full length and go."},{"id":"semetey-1-2013:p0269:b004:l026","ordinal":97524,"en":"My treasury of vast wealth,"},{"id":"semetey-1-2013:p0269:b004:l027","ordinal":97525,"en":"I shall stake it all, leaving nothing out."},{"id":"semetey-1-2013:p0269:b004:l028","ordinal":97526,"en":"Take this along with you too!"},{"id":"semetey-1-2013:p0269:b004:l029","ordinal":97527,"en":"Sate yourself fully with prizes."},{"id":"semetey-1-2013:p0269:b004:l030","ordinal":97528,"en":"If it is too little, O wrestler,"},{"id":"semetey-1-2013:p0269:b004:l031","ordinal":97529,"en":"Let me stake my sovereignty."},{"id":"semetey-1-2013:p0269:b004:l032","ordinal":97530,"en":"Take this along with you too!"},{"id":"semetey-1-2013:p0269:b004:l033","ordinal":97531,"en":"Turn your neck a little."},{"id":"semetey-1-2013:p0269:b004:l034","ordinal":97532,"en":"I shall grapple, wrestler; wait!”"},{"id":"semetey-1-2013:p0269:b004:l035","ordinal":97533,"en":"When Semetey said this,"},{"id":"semetey-1-2013:p0269:b004:l036","ordinal":97534,"en":"Puffed up by having thrown his opponent,"},{"id":"semetey-1-2013:p0269:b004:l037","ordinal":97535,"en":"He stood to face the boy,"},{"id":"semetey-1-2013:p0269:b004:l038","ordinal":97536,"en":"That thoughtless Toobalban."}]
