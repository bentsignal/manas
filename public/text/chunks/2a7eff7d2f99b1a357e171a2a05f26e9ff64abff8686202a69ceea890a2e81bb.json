[{"id":"manas-2010:p0671:b001:l005","ordinal":29953,"en":"The exceptional gun Akkelte,"},{"id":"manas-2010:p0671:b001:l006","ordinal":29954,"en":"Let us give it to you now!"},{"id":"manas-2010:p0671:b001:l007","ordinal":29955,"en":"All that you say is true;"},{"id":"manas-2010:p0671:b001:l008","ordinal":29956,"en":"What I say is also true."},{"id":"manas-2010:p0671:b001:l009","ordinal":29957,"en":"Sixty lords, scouts of the land,"},{"id":"manas-2010:p0671:b001:l010","ordinal":29958,"en":"It is true that they went there;"},{"id":"manas-2010:p0671:b001:l011","ordinal":29959,"en":"Finding Akkelte in the cache,"},{"id":"manas-2010:p0671:b001:l012","ordinal":29960,"en":"It is true that they took it;"},{"id":"manas-2010:p0671:b001:l013","ordinal":29961,"en":"Into a great, unhealing dispute,"},{"id":"manas-2010:p0671:b001:l014","ordinal":29962,"en":"It is true that they fell."},{"id":"manas-2010:p0671:b001:l015","ordinal":29963,"en":"Fit to fire, keen when striking,"},{"id":"manas-2010:p0671:b001:l016","ordinal":29964,"en":"Akkelte is exceptional."},{"id":"manas-2010:p0671:b001:l017","ordinal":29965,"en":"Heed what I say;"},{"id":"manas-2010:p0671:b001:l018","ordinal":29966,"en":"Let us give Akkelte,"},{"id":"manas-2010:p0671:b001:l019","ordinal":29967,"en":"But grant us six months' delay."},{"id":"manas-2010:p0671:b001:l020","ordinal":29968,"en":"Accept the words I speak;"},{"id":"manas-2010:p0671:b001:l021","ordinal":29969,"en":"The exceptional champion, the lion,"},{"id":"manas-2010:p0671:b001:l022","ordinal":29970,"en":"‘A binding pledge was made,’"},{"id":"manas-2010:p0671:b001:l023","ordinal":29971,"en":"Tell that to Manas."},{"id":"manas-2010:p0671:b001:l024","ordinal":29972,"en":"The pledged time is exactly six months;"},{"id":"manas-2010:p0671:b001:l025","ordinal":29973,"en":"Returning after six months,"},{"id":"manas-2010:p0671:b001:l026","ordinal":29974,"en":"Take Akkelte."},{"id":"manas-2010:p0671:b001:l027","ordinal":29975,"en":"If it is delayed beyond those six months,"},{"id":"manas-2010:p0671:b001:l028","ordinal":29976,"en":"With noble Manas as your hero,"},{"id":"manas-2010:p0671:b001:l029","ordinal":29977,"en":"Charge in proudly and raid us;"},{"id":"manas-2010:p0671:b001:l030","ordinal":29978,"en":"Lay us waste."},{"id":"manas-2010:p0671:b001:l031","ordinal":29979,"en":"The appointed time is six months;"},{"id":"manas-2010:p0671:b001:l032","ordinal":29980,"en":"Come after six months."},{"id":"manas-2010:p0671:b001:l033","ordinal":29981,"en":"If we do not give it after six months,"},{"id":"manas-2010:p0671:b001:l034","ordinal":29982,"en":"If we do not keep the pledge,"},{"id":"manas-2010:p0671:b001:l035","ordinal":29983,"en":"Then drain us dry."},{"id":"manas-2010:p0671:b001:l036","ordinal":29984,"en":"To heed what you say,"},{"id":"manas-2010:p0671:b001:l037","ordinal":29985,"en":"Akkelte, another's possession,"},{"id":"manas-2010:p0671:b001:l038","ordinal":29986,"en":"To give it to you now,"},{"id":"manas-2010:p0671:b001:l039","ordinal":29987,"en":"The time has already passed."},{"id":"manas-2010:p0671:b001:l040","ordinal":29988,"en":"Roaming the land, seeking peoples,"},{"id":"manas-2010:p0671:b001:l041","ordinal":29989,"en":"A roaming raider took it away,"},{"id":"manas-2010:p0671:b001:l042","ordinal":29990,"en":"Taking ample provisions for six months."},{"id":"manas-2010:p0672:b001:l001","ordinal":29991,"en":"He has utterly ruined me;"},{"id":"manas-2010:p0672:b001:l002","ordinal":29992,"en":"The scout took it away."},{"id":"manas-2010:p0672:b001:l003","ordinal":29993,"en":"He will return in six months."},{"id":"manas-2010:p0672:b001:l004","ordinal":29994,"en":"Let us heed what he says;"},{"id":"manas-2010:p0672:b001:l005","ordinal":29995,"en":"Let us give Akkelte."},{"id":"manas-2010:p0672:b001:l006","ordinal":29996,"en":"We have pledged it; wait."},{"id":"manas-2010:p0672:b001:l007","ordinal":29997,"en":"You are an envoy come between us;"},{"id":"manas-2010:p0672:b001:l008","ordinal":29998,"en":"Give the news to Manas."},{"id":"manas-2010:p0672:b001:l009","ordinal":29999,"en":"Come after six months"},{"id":"manas-2010:p0672:b001:l010","ordinal":30000,"en":"And take Akkelte."},{"id":"manas-2010:p0672:b001:l011","ordinal":30001,"en":"If it is delayed beyond the sixth month,"},{"id":"manas-2010:p0672:b001:l012","ordinal":30002,"en":"Beating drums, gathering an army,"},{"id":"manas-2010:p0672:b001:l013","ordinal":30003,"en":"Come leading Manas."},{"id":"manas-2010:p0672:b001:l014","ordinal":30004,"en":"Throwing the world into turmoil,"},{"id":"manas-2010:p0672:b001:l015","ordinal":30005,"en":"Then slaughter us and go."},{"id":"manas-2010:p0672:b001:l016","ordinal":30006,"en":"It would shame us to fight;"},{"id":"manas-2010:p0672:b001:l017","ordinal":30007,"en":"Wait six months."},{"id":"manas-2010:p0672:b001:l018","ordinal":30008,"en":"This is the pledge, these are the words!”"},{"id":"manas-2010:p0672:b001:l019","ordinal":30009,"en":"From Khan Kerke's city,"},{"id":"manas-2010:p0672:b001:l020","ordinal":30010,"en":"Azhybay mounted and left."},{"id":"manas-2010:p0672:b001:l021","ordinal":30011,"en":"The chestnut beneath him—"},{"id":"manas-2010:p0672:b001:l022","ordinal":30012,"en":"Kerke did not give the short gun;"},{"id":"manas-2010:p0672:b001:l023","ordinal":30013,"en":"This time it fell short,"},{"id":"manas-2010:p0672:b001:l024","ordinal":30014,"en":"Azhybay's desire."},{"id":"manas-2010:p0672:b001:l025","ordinal":30015,"en":"The exceptional tulpar Kartküröng,"},{"id":"manas-2010:p0672:b001:l026","ordinal":30016,"en":"No wind could match his trot;"},{"id":"manas-2010:p0672:b001:l027","ordinal":30017,"en":"No animal could match his walk."},{"id":"manas-2010:p0672:b001:l028","ordinal":30018,"en":"The ground he trod burst apart."},{"id":"manas-2010:p0672:b001:l029","ordinal":30019,"en":"He rattled as though about to fly."},{"id":"manas-2010:p0672:b001:l030","ordinal":30020,"en":"Never slipping on the heights,"},{"id":"manas-2010:p0672:b001:l031","ordinal":30021,"en":"The dear creature had wings;"},{"id":"manas-2010:p0672:b001:l032","ordinal":30022,"en":"He ran faster than swift wild game."},{"id":"manas-2010:p0672:b001:l033","ordinal":30023,"en":"Before one could utter a word,"},{"id":"manas-2010:p0672:b001:l034","ordinal":30024,"en":"In the opening and closing of an eye,"},{"id":"manas-2010:p0672:b001:l035","ordinal":30025,"en":"Still excited, Azhybay,"},{"id":"manas-2010:p0672:b001:l036","ordinal":30026,"en":"To his khans Manas and Bakay,"},{"id":"manas-2010:p0672:b001:l037","ordinal":30027,"en":"Now came trotting back."},{"id":"manas-2010:p0672:b001:l038","ordinal":30028,"en":"What he had seen and heard,"},{"id":"manas-2010:p0672:b001:l039","ordinal":30029,"en":"What he had sensed and learned,"},{"id":"manas-2010:p0672:b001:l040","ordinal":30030,"en":"How he had entered as envoy,"},{"id":"manas-2010:p0672:b001:l041","ordinal":30031,"en":"Azhybay told them."},{"id":"manas-2010:p0672:b001:l042","ordinal":30032,"en":"Azhybay's account,"},{"id":"manas-2010:p0673:b001:l001","ordinal":30033,"en":"His visit to Kerke and return,"},{"id":"manas-2010:p0673:b001:l002","ordinal":30034,"en":"Bakay examined and judged."},{"id":"manas-2010:p0673:b001:l003","ordinal":30035,"en":"“Not placing the short gun in your hands,"},{"id":"manas-2010:p0673:b001:l004","ordinal":30036,"en":"Not hearing your words when you spoke,"},{"id":"manas-2010:p0673:b001:l005","ordinal":30037,"en":"Making a fool of you,"},{"id":"manas-2010:p0673:b001:l006","ordinal":30038,"en":"He sent you on your way."},{"id":"manas-2010:p0673:b001:l007","ordinal":30039,"en":"Upturned nose, sunken eyes,"},{"id":"manas-2010:p0673:b001:l008","ordinal":30040,"en":"He is a wretch indeed."},{"id":"manas-2010:p0673:b001:l009","ordinal":30041,"en":"Deceiving and cajoling Azhy,"},{"id":"manas-2010:p0673:b001:l010","ordinal":30042,"en":"He sent him on his road."},{"id":"manas-2010:p0673:b001:l011","ordinal":30043,"en":"To avoid giving Akkelte,"},{"id":"manas-2010:p0673:b001:l012","ordinal":30044,"en":"Turning the matter's end into a quarrel,"},{"id":"manas-2010:p0673:b001:l013","ordinal":30045,"en":"He has made us chew our reins in fury."},{"id":"manas-2010:p0673:b001:l014","ordinal":30046,"en":"Dragging out his words,"},{"id":"manas-2010:p0673:b001:l015","ordinal":30047,"en":"That pig fed you empty promises,"},{"id":"manas-2010:p0673:b001:l016","ordinal":30048,"en":"Saying, ‘Come in six months,’"},{"id":"manas-2010:p0673:b001:l017","ordinal":30049,"en":"Speaking so the claim would grow stale,"},{"id":"manas-2010:p0673:b001:l018","ordinal":30050,"en":"Devising ways not to give it,"},{"id":"manas-2010:p0673:b001:l019","ordinal":30051,"en":"Setting a distant time, fixing a day—"},{"id":"manas-2010:p0673:b001:l020","ordinal":30052,"en":"God has struck Kerke down."},{"id":"manas-2010:p0673:b001:l021","ordinal":30053,"en":"That pig has gone mad;"},{"id":"manas-2010:p0673:b001:l022","ordinal":30054,"en":"He has contrived his escape."},{"id":"manas-2010:p0673:b001:l023","ordinal":30055,"en":"‘The time is six months,’ he said,"},{"id":"manas-2010:p0673:b001:l024","ordinal":30056,"en":"Speaking words to get himself free."},{"id":"manas-2010:p0673:b001:l025","ordinal":30057,"en":"Preparing fully for six months,"},{"id":"manas-2010:p0673:b001:l026","ordinal":30058,"en":"He has settled down in his madness."},{"id":"manas-2010:p0673:b001:l027","ordinal":30059,"en":"Unwilling to give the short gun,"},{"id":"manas-2010:p0673:b001:l028","ordinal":30060,"en":"He has drawn us into grievous trouble."},{"id":"manas-2010:p0673:b001:l029","ordinal":30061,"en":"Blood-drinking Manas, Azhybay,"},{"id":"manas-2010:p0673:b001:l030","ordinal":30062,"en":"Prepare yourselves, my children!"},{"id":"manas-2010:p0673:b001:l031","ordinal":30063,"en":"Holding spears, breaking the ranks,"},{"id":"manas-2010:p0673:b001:l032","ordinal":30064,"en":"Let us fire many volleys;"},{"id":"manas-2010:p0673:b001:l033","ordinal":30065,"en":"Let us overwhelm them!"},{"id":"manas-2010:p0673:b001:l034","ordinal":30066,"en":"Standing face to face,"},{"id":"manas-2010:p0673:b001:l035","ordinal":30067,"en":"Firing guns and drawing bows,"},{"id":"manas-2010:p0673:b001:l036","ordinal":30068,"en":"Clashing in battle,"},{"id":"manas-2010:p0673:b001:l037","ordinal":30069,"en":"Slaughtering their lord, breaking the ranks,"},{"id":"manas-2010:p0673:b001:l038","ordinal":30070,"en":"Facing them, falling to their shots,"},{"id":"manas-2010:p0673:b001:l039","ordinal":30071,"en":"Let us see him refuse to give it;"},{"id":"manas-2010:p0673:b001:l040","ordinal":30072,"en":"Let us face them and die."},{"id":"manas-2010:p0673:b001:l041","ordinal":30073,"en":"Let us bring a spectacular slaughter;"},{"id":"manas-2010:p0673:b001:l042","ordinal":30074,"en":"From that damned pig,"},{"id":"manas-2010:p0674:b001:l001","ordinal":30075,"en":"Let us seize Akkelte."},{"id":"manas-2010:p0674:b001:l002","ordinal":30076,"en":"After this, let us make his ears"},{"id":"manas-2010:p0674:b001:l003","ordinal":30077,"en":"Unable to hear."},{"id":"manas-2010:p0674:b001:l004","ordinal":30078,"en":"Roaming the land and measuring waters,"},{"id":"manas-2010:p0674:b001:l005","ordinal":30079,"en":"Let us make him unable to go out."},{"id":"manas-2010:p0674:b001:l006","ordinal":30080,"en":"Making our tulpars prance on his land,"},{"id":"manas-2010:p0674:b001:l007","ordinal":30081,"en":"Making those we reach crawl,"},{"id":"manas-2010:p0674:b001:l008","ordinal":30082,"en":"Let us imprison his lords;"},{"id":"manas-2010:p0674:b001:l009","ordinal":30083,"en":"Confine them in their places of honor and beat them!”"},{"id":"manas-2010:p0674:b001:l010","ordinal":30084,"en":"When they heard Bakay's words,"},{"id":"manas-2010:p0674:b001:l011","ordinal":30085,"en":"Azhybay and Bakay made ready,"},{"id":"manas-2010:p0674:b001:l012","ordinal":30086,"en":"Girding on unsheathed swords."},{"id":"manas-2010:p0674:b001:l013","ordinal":30087,"en":"Hearing Bakay's words,"},{"id":"manas-2010:p0674:b001:l014","ordinal":30088,"en":"The two champions sprang up running;"},{"id":"manas-2010:p0674:b001:l015","ordinal":30089,"en":"Hurrying, the two champions"},{"id":"manas-2010:p0674:b001:l016","ordinal":30090,"en":"Put on armor no shot could pierce."},{"id":"manas-2010:p0674:b001:l017","ordinal":30091,"en":"The indispensable elder Bakay,"},{"id":"manas-2010:p0674:b001:l018","ordinal":30092,"en":"“Let the bright dawn break,” he said,"},{"id":"manas-2010:p0674:b001:l019","ordinal":30093,"en":"“Let light fall upon the earth,” he said."},{"id":"manas-2010:p0674:b001:l020","ordinal":30094,"en":"Saying this to hero Manas,"},{"id":"manas-2010:p0674:b001:l021","ordinal":30095,"en":"Warrior Bakay stood there."},{"id":"manas-2010:p0674:b001:l022","ordinal":30096,"en":"Of the pine-covered steppe,"},{"id":"manas-2010:p0674:b001:l023","ordinal":30097,"en":"Across its spreading farther face,"},{"id":"manas-2010:p0674:b001:l024","ordinal":30098,"en":"There was no hill the size of an ankle bone,"},{"id":"manas-2010:p0674:b001:l025","ordinal":30099,"en":"No hollow the size of a saddlecloth,"},{"id":"manas-2010:p0674:b001:l026","ordinal":30100,"en":"No furrow touched by a plow,"},{"id":"manas-2010:p0674:b001:l027","ordinal":30101,"en":"No burrow dug by a marmot."},{"id":"manas-2010:p0674:b001:l028","ordinal":30102,"en":"Of the moon-bright yellow plain,"},{"id":"manas-2010:p0674:b001:l029","ordinal":30103,"en":"At its far edge,"},{"id":"manas-2010:p0674:b001:l030","ordinal":30104,"en":"A bulky shape appeared."},{"id":"manas-2010:p0674:b001:l031","ordinal":30105,"en":"When he saw that shape,"},{"id":"manas-2010:p0674:b001:l032","ordinal":30106,"en":"Your elder, lion Bakay's"},{"id":"manas-2010:p0674:b001:l033","ordinal":30107,"en":"Thoughts were deeply stirred."},{"id":"manas-2010:p0674:b001:l034","ordinal":30108,"en":"To a ridge like a saddle's back,"},{"id":"manas-2010:p0674:b001:l035","ordinal":30109,"en":"Your champion elder Bakay"},{"id":"manas-2010:p0674:b001:l036","ordinal":30110,"en":"Rode up swiftly."},{"id":"manas-2010:p0674:b001:l037","ordinal":30111,"en":"Looking on both sides,"},{"id":"manas-2010:p0674:b001:l038","ordinal":30112,"en":"Wishing his people safe—"},{"id":"manas-2010:p0674:b001:l039","ordinal":30113,"en":"When Azhybay went as envoy,"},{"id":"manas-2010:p0674:b001:l040","ordinal":30114,"en":"Girding his waist in earnest,"},{"id":"manas-2010:p0674:b001:l041","ordinal":30115,"en":"Fire burning through his whole belly,"},{"id":"manas-2010:p0674:b001:l042","ordinal":30116,"en":"That pig, that true calamity,"},{"id":"manas-2010:p0675:b001:l001","ordinal":30117,"en":"Had found his cunning plan."},{"id":"manas-2010:p0675:b001:l002","ordinal":30118,"en":"“My child, if blood-drinking lion Manas comes,"},{"id":"manas-2010:p0675:b001:l003","ordinal":30119,"en":"If the famed giant Bakay comes,"},{"id":"manas-2010:p0675:b001:l004","ordinal":30120,"en":"With a single eye in their heads,"},{"id":"manas-2010:p0675:b001:l005","ordinal":30121,"en":"If all his mighty men and giants come,"},{"id":"manas-2010:p0675:b001:l006","ordinal":30122,"en":"Will they break through my treasury?"},{"id":"manas-2010:p0675:b001:l007","ordinal":30123,"en":"If we happen to clash,"},{"id":"manas-2010:p0675:b001:l008","ordinal":30124,"en":"Will they utterly destroy us?”"},{"id":"manas-2010:p0675:b001:l009","ordinal":30125,"en":"So said Khan Kerke,"},{"id":"manas-2010:p0675:b001:l010","ordinal":30126,"en":"Roaring in fury,"},{"id":"manas-2010:p0675:b001:l011","ordinal":30127,"en":"Calling his scouts of the land."},{"id":"manas-2010:p0675:b001:l012","ordinal":30128,"en":"That they would take it by force,"},{"id":"manas-2010:p0675:b001:l013","ordinal":30129,"en":"That they would utterly destroy him,"},{"id":"manas-2010:p0675:b001:l014","ordinal":30130,"en":"He knew like a seer."},{"id":"manas-2010:p0675:b001:l015","ordinal":30131,"en":"Formidable in cunning, fierce in wrath,"},{"id":"manas-2010:p0675:b001:l016","ordinal":30132,"en":"That Bakay would bring calamity,"},{"id":"manas-2010:p0675:b001:l017","ordinal":30133,"en":"He had known from the outset."},{"id":"manas-2010:p0675:b001:l018","ordinal":30134,"en":"At first he had agreed;"},{"id":"manas-2010:p0675:b001:l019","ordinal":30135,"en":"To sixty scouts and forty lords,"},{"id":"manas-2010:p0675:b001:l020","ordinal":30136,"en":"“Take it away for six months,” he said,"},{"id":"manas-2010:p0675:b001:l021","ordinal":30137,"en":"“Achieve your desire,” he said,"},{"id":"manas-2010:p0675:b001:l022","ordinal":30138,"en":"And gave Akkelte."},{"id":"manas-2010:p0675:b001:l023","ordinal":30139,"en":"Receiving orders from their khan,"},{"id":"manas-2010:p0675:b001:l024","ordinal":30140,"en":"Hearing them, the forty lords"},{"id":"manas-2010:p0675:b001:l025","ordinal":30141,"en":"Had left their city."},{"id":"manas-2010:p0675:b001:l026","ordinal":30142,"en":"If you observed their manner:"},{"id":"manas-2010:p0675:b001:l027","ordinal":30143,"en":"Riding mares with foals,"},{"id":"manas-2010:p0675:b001:l028","ordinal":30144,"en":"Putting on their yellow coats,"},{"id":"manas-2010:p0675:b001:l029","ordinal":30145,"en":"All swaying heavily,"},{"id":"manas-2010:p0675:b001:l030","ordinal":30146,"en":"They all rode bareback,"},{"id":"manas-2010:p0675:b001:l031","ordinal":30147,"en":"Beating their animals,"},{"id":"manas-2010:p0675:b001:l032","ordinal":30148,"en":"Teaching them unfamiliar things,"},{"id":"manas-2010:p0675:b001:l033","ordinal":30149,"en":"By their horses' necks"},{"id":"manas-2010:p0675:b001:l034","ordinal":30150,"en":"Making them draw their carts."},{"id":"manas-2010:p0675:b001:l035","ordinal":30151,"en":"Seeing their shapes,"},{"id":"manas-2010:p0675:b001:l036","ordinal":30152,"en":"Your falcon, leopard Bakay,"},{"id":"manas-2010:p0675:b001:l037","ordinal":30153,"en":"Recited in the Arabic tongue"},{"id":"manas-2010:p0675:b001:l038","ordinal":30154,"en":"And bound the sun's eye."},{"id":"manas-2010:p0675:b001:l039","ordinal":30155,"en":"(He himself commanded weather, a keen lion;"},{"id":"manas-2010:p0675:b001:l040","ordinal":30156,"en":"If you appraise him, such a hero is Bakay.)"},{"id":"manas-2010:p0675:b001:l041","ordinal":30157,"en":"Cloudy by day, clear by night,"},{"id":"manas-2010:p0675:b001:l042","ordinal":30158,"en":"Whirling the day's weather into turmoil,"},{"id":"manas-2010:p0676:b001:l001","ordinal":30159,"en":"Above the pines,"},{"id":"manas-2010:p0676:b001:l002","ordinal":30160,"en":"Making dark clouds settle,"},{"id":"manas-2010:p0676:b001:l003","ordinal":30161,"en":"Upon the scouts of the land,"},{"id":"manas-2010:p0676:b001:l004","ordinal":30162,"en":"Making six-sided hail pour down,"},{"id":"manas-2010:p0676:b001:l005","ordinal":30163,"en":"Mist appeared from the hollows;"},{"id":"manas-2010:p0676:b001:l006","ordinal":30164,"en":"Clouds covered the sky."},{"id":"manas-2010:p0676:b001:l007","ordinal":30165,"en":"Dark clouds from the heavens"},{"id":"manas-2010:p0676:b001:l008","ordinal":30166,"en":"Now rose with a roar;"},{"id":"manas-2010:p0676:b001:l009","ordinal":30167,"en":"Seven-sided hail rumbled over their heads."},{"id":"manas-2010:p0676:b001:l010","ordinal":30168,"en":"Grass tore apart and quivered;"},{"id":"manas-2010:p0676:b001:l011","ordinal":30169,"en":"Wind-driven sleet came from every side."},{"id":"manas-2010:p0676:b001:l012","ordinal":30170,"en":"Hollows became deep pits;"},{"id":"manas-2010:p0676:b001:l013","ordinal":30171,"en":"Sixty scouts and forty lords"},{"id":"manas-2010:p0676:b001:l014","ordinal":30172,"en":"Longed for a single clear look."},{"id":"manas-2010:p0676:b001:l015","ordinal":30173,"en":"All the clouds broke apart;"},{"id":"manas-2010:p0676:b001:l016","ordinal":30174,"en":"Cold winds howled from every side;"},{"id":"manas-2010:p0676:b001:l017","ordinal":30175,"en":"Dark vapor billowed from the earth."},{"id":"manas-2010:p0676:b001:l018","ordinal":30176,"en":"When seven days had passed,"},{"id":"manas-2010:p0676:b001:l019","ordinal":30177,"en":"Clouds scattered from the sky;"},{"id":"manas-2010:p0676:b001:l020","ordinal":30178,"en":"God's sun shone clear and bright."},{"id":"manas-2010:p0676:b001:l021","ordinal":30179,"en":"As they stood gathered together,"},{"id":"manas-2010:p0676:b001:l022","ordinal":30180,"en":"Striking the gray tulpar once on the thigh,"},{"id":"manas-2010:p0676:b001:l023","ordinal":30181,"en":"Taking the blue spear in his hand,"},{"id":"manas-2010:p0676:b001:l024","ordinal":30182,"en":"Before one could say this or that,"},{"id":"manas-2010:p0676:b001:l025","ordinal":30183,"en":"In the opening and closing of an eye,"},{"id":"manas-2010:p0676:b001:l026","ordinal":30184,"en":"He began a spectacular slaughter."},{"id":"manas-2010:p0676:b001:l027","ordinal":30185,"en":"Leaving not one in sight unharmed,"},{"id":"manas-2010:p0676:b001:l028","ordinal":30186,"en":"He cut them down with his sword."},{"id":"manas-2010:p0676:b001:l029","ordinal":30187,"en":"The indispensable saint Bakay"},{"id":"manas-2010:p0676:b001:l030","ordinal":30188,"en":"Now had his wish fulfilled."},{"id":"manas-2010:p0676:b001:l031","ordinal":30189,"en":"At play, a warrior's gun,"},{"id":"manas-2010:p0676:b001:l032","ordinal":30190,"en":"In earnest, a matchlock—"},{"id":"manas-2010:p0676:b001:l033","ordinal":30191,"en":"Fashioned with the utmost skill,"},{"id":"manas-2010:p0676:b001:l034","ordinal":30192,"en":"For generous Manas himself"},{"id":"manas-2010:p0676:b001:l035","ordinal":30193,"en":"It had been made to fit."},{"id":"manas-2010:p0676:b001:l036","ordinal":30194,"en":"Destroying their falcon heroes,"},{"id":"manas-2010:p0676:b001:l037","ordinal":30195,"en":"Your falcon, blue-maned Bakay,"},{"id":"manas-2010:p0676:b001:l038","ordinal":30196,"en":"Now seized it from the scouts and brought it."},{"id":"manas-2010:p0676:b001:l039","ordinal":30197,"en":"Akkelte, to the blood-drinking lion,"},{"id":"manas-2010:p0676:b001:l040","ordinal":30198,"en":"He now presented as a gift."},{"id":"manas-2010:p0676:b001:l041","ordinal":30199,"en":"“Upon your head visited by Kydyr,"},{"id":"manas-2010:p0676:b001:l042","ordinal":30200,"en":"All the mighty will be found."},{"id":"manas-2010:p0677:b001:l001","ordinal":30201,"en":"You are a warrior, you are a lion;"},{"id":"manas-2010:p0677:b001:l002","ordinal":30202,"en":"Created with surpassing fortune,"},{"id":"manas-2010:p0677:b001:l003","ordinal":30203,"en":"You are a hero of surpassing luck."},{"id":"manas-2010:p0677:b001:l004","ordinal":30204,"en":"Again I speak, again a word;"},{"id":"manas-2010:p0677:b001:l005","ordinal":30205,"en":"Again, through your good fortune,"},{"id":"manas-2010:p0677:b001:l006","ordinal":30206,"en":"Again falcon heroes will come your way!"},{"id":"manas-2010:p0677:b001:l007","ordinal":30207,"en":"Yesterday, when many shots were fired,"},{"id":"manas-2010:p0677:b001:l008","ordinal":30208,"en":"When Akkelte was seized,"}]
