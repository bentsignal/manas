[{"id":"manas-2010:p1667:b001:l008","ordinal":71681,"en":"Bokmurun and hero Shygay,"},{"id":"manas-2010:p1667:b001:l009","ordinal":71682,"en":"When those two fell to bullets,"},{"id":"manas-2010:p1667:b001:l010","ordinal":71683,"en":"The seven khans remaining,"},{"id":"manas-2010:p1667:b001:l011","ordinal":71684,"en":"All gathering their courage,"},{"id":"manas-2010:p1667:b001:l012","ordinal":71685,"en":"Old Koshoy among them,"},{"id":"manas-2010:p1667:b001:l013","ordinal":71686,"en":"Fell upon Kojozhash."},{"id":"manas-2010:p1667:b001:l014","ordinal":71687,"en":"Falling upon Kojozhash,"},{"id":"manas-2010:p1667:b001:l015","ordinal":71688,"en":"When they fought in tumult,"},{"id":"manas-2010:p1667:b001:l016","ordinal":71689,"en":"Kojozhash, Karazhoy's son,"},{"id":"manas-2010:p1667:b001:l017","ordinal":71690,"en":"Could not be caught by the eye."},{"id":"manas-2010:p1667:b001:l018","ordinal":71691,"en":"That exceptional dog, master of every trick,"},{"id":"manas-2010:p1667:b001:l019","ordinal":71692,"en":"His whereabouts could not be known."},{"id":"manas-2010:p1667:b001:l020","ordinal":71693,"en":"Escaping up into the hills,"},{"id":"manas-2010:p1667:b001:l021","ordinal":71694,"en":"At the swarming Buruts,"},{"id":"manas-2010:p1667:b001:l022","ordinal":71695,"en":"He loosed arrows like rain."},{"id":"manas-2010:p1667:b001:l023","ordinal":71696,"en":"That formidable, practiced dog"},{"id":"manas-2010:p1667:b001:l024","ordinal":71697,"en":"Fired bullets like hail."},{"id":"manas-2010:p1667:b001:l025","ordinal":71698,"en":"The painted short gun with steel bullets,"},{"id":"manas-2010:p1667:b001:l026","ordinal":71699,"en":"Adding its report to report,"},{"id":"manas-2010:p1667:b001:l027","ordinal":71700,"en":"He fired a thousand times with it;"},{"id":"manas-2010:p1667:b001:l028","ordinal":71701,"en":"Before its bullets reached them,"},{"id":"manas-2010:p1667:b001:l029","ordinal":71702,"en":"The painted arrow in his hand,"},{"id":"manas-2010:p1667:b001:l030","ordinal":71703,"en":"With it he shot a hundred times."},{"id":"manas-2010:p1667:b001:l031","ordinal":71704,"en":"The white arrow with a ravenous mouth,"},{"id":"manas-2010:p1667:b001:l032","ordinal":71705,"en":"With it he shot fifty times."},{"id":"manas-2010:p1667:b001:l033","ordinal":71706,"en":"The painted short gun beneath him,"},{"id":"manas-2010:p1667:b001:l034","ordinal":71707,"en":"With it he shot forty times."},{"id":"manas-2010:p1667:b001:l035","ordinal":71708,"en":"When his countless bullets struck,"},{"id":"manas-2010:p1667:b001:l036","ordinal":71709,"en":"Then Serek, the leopard hero, died;"},{"id":"manas-2010:p1667:b001:l037","ordinal":71710,"en":"A wolf like the diviner died;"},{"id":"manas-2010:p1667:b001:l038","ordinal":71711,"en":"Blue-maned heroes died, a multitude died."},{"id":"manas-2010:p1667:b001:l039","ordinal":71712,"en":"Akayar, who lifted camels,"},{"id":"manas-2010:p1667:b001:l040","ordinal":71713,"en":"Their champions died as well."},{"id":"manas-2010:p1667:b001:l041","ordinal":71714,"en":"Akzholtoy, Archa Khan's son,"},{"id":"manas-2010:p1667:b001:l042","ordinal":71715,"en":"Struck by a bullet, he died too,"},{"id":"manas-2010:p1668:b001:l001","ordinal":71716,"en":"To the four corners of the world,"},{"id":"manas-2010:p1668:b001:l002","ordinal":71717,"en":"He used to carry full and faithful news;"},{"id":"manas-2010:p1668:b001:l003","ordinal":71718,"en":"Lord Shuutu died as well."},{"id":"manas-2010:p1668:b001:l004","ordinal":71719,"en":"Akzholtoy, who could snap a rope,"},{"id":"manas-2010:p1668:b001:l005","ordinal":71720,"en":"The young man close to Manas, died;"},{"id":"manas-2010:p1668:b001:l006","ordinal":71721,"en":"Baychoro, Baabedin Khan's son,"},{"id":"manas-2010:p1668:b001:l007","ordinal":71722,"en":"Then young Baychoro died as well."},{"id":"manas-2010:p1668:b001:l008","ordinal":71723,"en":"Then your renowned Alma alone,"},{"id":"manas-2010:p1668:b001:l009","ordinal":71724,"en":"Turning back into Beijing,"},{"id":"manas-2010:p1668:b001:l010","ordinal":71725,"en":"Your Alake was left alone,"},{"id":"manas-2010:p1668:b001:l011","ordinal":71726,"en":"Parted from his champions."},{"id":"manas-2010:p1668:b001:l012","ordinal":71727,"en":"His many sorrows would not fit in his breast;"},{"id":"manas-2010:p1668:b001:l013","ordinal":71728,"en":"Your blue-maned hero Alma, alone,"},{"id":"manas-2010:p1668:b001:l014","ordinal":71729,"en":"His tears streamed in ten channels!"},{"id":"manas-2010:p1668:b001:l015","ordinal":71730,"en":"Clashing in fury,"},{"id":"manas-2010:p1668:b001:l016","ordinal":71731,"en":"Against the countless black Kalmyks before him,"},{"id":"manas-2010:p1668:b001:l017","ordinal":71732,"en":"Standing his ground and fighting,"},{"id":"manas-2010:p1668:b001:l018","ordinal":71733,"en":"Shouting, “Sovereign!”"},{"id":"manas-2010:p1668:b001:l019","ordinal":71734,"en":"Crying the battle cry, “Manas!”"},{"id":"manas-2010:p1668:b001:l020","ordinal":71735,"en":"At the black infidels before him,"},{"id":"manas-2010:p1668:b001:l021","ordinal":71736,"en":"Your Alake kept driving and scattering them."},{"id":"manas-2010:p1668:b001:l022","ordinal":71737,"en":"Beijing of Kakan-Chin,"},{"id":"manas-2010:p1668:b001:l023","ordinal":71738,"en":"Your Alake made the Chinese bellow,"},{"id":"manas-2010:p1668:b001:l024","ordinal":71739,"en":"Kept hemming them in and driving them."},{"id":"manas-2010:p1668:b001:l025","ordinal":71740,"en":"Beyond the desert of It-Ölbös,"},{"id":"manas-2010:p1668:b001:l026","ordinal":71741,"en":"Your Khan Alma drove them across,"},{"id":"manas-2010:p1668:b001:l027","ordinal":71742,"en":"Drove them onward."},{"id":"manas-2010:p1668:b001:l028","ordinal":71743,"en":"Shouting now and then,"},{"id":"manas-2010:p1668:b001:l029","ordinal":71744,"en":"The infidels like black willows,"},{"id":"manas-2010:p1668:b001:l030","ordinal":71745,"en":"He drove back and scattered."},{"id":"manas-2010:p1668:b001:l031","ordinal":71746,"en":"Behind him, the forty companions"},{"id":"manas-2010:p1668:b001:l032","ordinal":71747,"en":"Had become his support."},{"id":"manas-2010:p1668:b001:l033","ordinal":71748,"en":"Upon the plundered Chinese,"},{"id":"manas-2010:p1668:b001:l034","ordinal":71749,"en":"Your Alake avenged Chubak."},{"id":"manas-2010:p1668:b001:l035","ordinal":71750,"en":"When he reached the rough sands,"},{"id":"manas-2010:p1668:b001:l036","ordinal":71751,"en":"He slaughtered those on gray horses;"},{"id":"manas-2010:p1668:b001:l037","ordinal":71752,"en":"When he entered the mountain cleft,"},{"id":"manas-2010:p1668:b001:l038","ordinal":71753,"en":"Their khan fell into his hands;"},{"id":"manas-2010:p1668:b001:l039","ordinal":71754,"en":"Then he slaughtered those on black horses."},{"id":"manas-2010:p1668:b001:l040","ordinal":71755,"en":"Your Alake sped upon Sarala;"},{"id":"manas-2010:p1668:b001:l041","ordinal":71756,"en":"The khans who faced him,"},{"id":"manas-2010:p1668:b001:l042","ordinal":71757,"en":"Almambet struck in the waist,"},{"id":"manas-2010:p1669:b001:l001","ordinal":71758,"en":"Then flung them like feedbags."},{"id":"manas-2010:p1669:b001:l002","ordinal":71759,"en":"Through their center, your lion Alma"},{"id":"manas-2010:p1669:b001:l003","ordinal":71760,"en":"Was boring his way;"},{"id":"manas-2010:p1669:b001:l004","ordinal":71761,"en":"Then upon one flank, Khan Töshtük"},{"id":"manas-2010:p1669:b001:l005","ordinal":71762,"en":"Was slaughtering them."},{"id":"manas-2010:p1669:b001:l006","ordinal":71763,"en":"Their very center, the forty champions"},{"id":"manas-2010:p1669:b001:l007","ordinal":71764,"en":"Had surrounded."},{"id":"manas-2010:p1669:b001:l008","ordinal":71765,"en":"The Muslims gathered their horses,"},{"id":"manas-2010:p1669:b001:l009","ordinal":71766,"en":"Were plundering them."},{"id":"manas-2010:p1669:b001:l010","ordinal":71767,"en":"The gullies filled with bodies face down,"},{"id":"manas-2010:p1669:b001:l011","ordinal":71768,"en":"Were filled to the brim."},{"id":"manas-2010:p1669:b001:l012","ordinal":71769,"en":"Taking red gold and jewels,"},{"id":"manas-2010:p1669:b001:l013","ordinal":71770,"en":"Those who survived the dead,"},{"id":"manas-2010:p1669:b001:l014","ordinal":71771,"en":"Good heavens, were prospering."},{"id":"manas-2010:p1669:b001:l015","ordinal":71772,"en":"When your noble Alma entered,"},{"id":"manas-2010:p1669:b001:l016","ordinal":71773,"en":"When he struck toward Beijing,"},{"id":"manas-2010:p1669:b001:l017","ordinal":71774,"en":"The many Chinese, the countless Manchus,"},{"id":"manas-2010:p1669:b001:l018","ordinal":71775,"en":"Distraught and staggering,"},{"id":"manas-2010:p1669:b001:l019","ordinal":71776,"en":"Were thrown into panic."},{"id":"manas-2010:p1669:b001:l020","ordinal":71777,"en":"Their cruppers snapped,"},{"id":"manas-2010:p1669:b001:l021","ordinal":71778,"en":"Their saddles slipped onto their horses' necks;"},{"id":"manas-2010:p1669:b001:l022","ordinal":71779,"en":"Oh hero, still more rushed about."},{"id":"manas-2010:p1669:b001:l023","ordinal":71780,"en":"Their saddle-girths snapped;"},{"id":"manas-2010:p1669:b001:l024","ordinal":71781,"en":"Unable to gather their wits, panting,"},{"id":"manas-2010:p1669:b001:l025","ordinal":71782,"en":"Still more were fleeing."},{"id":"manas-2010:p1669:b001:l026","ordinal":71783,"en":"Of the Chinese with red tassels,"},{"id":"manas-2010:p1669:b001:l027","ordinal":71784,"en":"This was where their mighty ones were slaughtered;"},{"id":"manas-2010:p1669:b001:l028","ordinal":71785,"en":"Of the Chinese with rank buttons,"},{"id":"manas-2010:p1669:b001:l029","ordinal":71786,"en":"This was where so many were slaughtered."},{"id":"manas-2010:p1669:b001:l030","ordinal":71787,"en":"Then their khans, Jangjung foremost, died;"},{"id":"manas-2010:p1669:b001:l031","ordinal":71788,"en":"The infidels' hero Kara, the champion, died as well."},{"id":"manas-2010:p1669:b001:l032","ordinal":71789,"en":"Kongurbay remained alone."},{"id":"manas-2010:p1669:b001:l033","ordinal":71790,"en":"Suffering and shouting,"},{"id":"manas-2010:p1669:b001:l034","ordinal":71791,"en":"The swine was in a sorry state."},{"id":"manas-2010:p1669:b001:l035","ordinal":71792,"en":"Algara's head,"},{"id":"manas-2010:p1669:b001:l036","ordinal":71793,"en":"Kongurbay kept turning."},{"id":"manas-2010:p1669:b001:l037","ordinal":71794,"en":"Then his club-like forelock,"},{"id":"manas-2010:p1669:b001:l038","ordinal":71795,"en":"Shouting beyond restraint,"},{"id":"manas-2010:p1669:b001:l039","ordinal":71796,"en":"Kongurbay kept tearing out."},{"id":"manas-2010:p1669:b001:l040","ordinal":71797,"en":"A wretch skilled among spearmen,"},{"id":"manas-2010:p1669:b001:l041","ordinal":71798,"en":"A formidable wretch who knew the enemy's tricks,"},{"id":"manas-2010:p1669:b001:l042","ordinal":71799,"en":"He raged and struggled,"},{"id":"manas-2010:p1670:b001:l001","ordinal":71800,"en":"Then pleaded with Kojozhash:"},{"id":"manas-2010:p1670:b001:l002","ordinal":71801,"en":"“Why should I speak of the others?"},{"id":"manas-2010:p1670:b001:l003","ordinal":71802,"en":"Hero, a fire burning in meadow grass is dreadful;"},{"id":"manas-2010:p1670:b001:l004","ordinal":71803,"en":"Worse still, an enemy from one's own people."},{"id":"manas-2010:p1670:b001:l005","ordinal":71804,"en":"A confidant is dangerous; a secret is dangerous."},{"id":"manas-2010:p1670:b001:l006","ordinal":71805,"en":"He learned your secrets and left;"},{"id":"manas-2010:p1670:b001:l007","ordinal":71806,"en":"That champion of yours, the dog Alma, is dreadful!"},{"id":"manas-2010:p1670:b001:l008","ordinal":71807,"en":"Again he meant to rob me of sleep,"},{"id":"manas-2010:p1670:b001:l009","ordinal":71808,"en":"Again he raided my horses on the Irtysh;"},{"id":"manas-2010:p1670:b001:l010","ordinal":71809,"en":"For six months Beijing was blood,"},{"id":"manas-2010:p1670:b001:l011","ordinal":71810,"en":"He scattered my wealth like charcoal."},{"id":"manas-2010:p1670:b001:l012","ordinal":71811,"en":"He slaughtered so many of my people,"},{"id":"manas-2010:p1670:b001:l013","ordinal":71812,"en":"My support in whom I trusted;"},{"id":"manas-2010:p1670:b001:l014","ordinal":71813,"en":"That fugitive burned"},{"id":"manas-2010:p1670:b001:l015","ordinal":71814,"en":"My well-defended land."},{"id":"manas-2010:p1670:b001:l016","ordinal":71815,"en":"He killed all the sentries;"},{"id":"manas-2010:p1670:b001:l017","ordinal":71816,"en":"His renowned lord Manas,"},{"id":"manas-2010:p1670:b001:l018","ordinal":71817,"en":"He thus made khan of Beijing."},{"id":"manas-2010:p1670:b001:l019","ordinal":71818,"en":"I had fed him my salt so often,"},{"id":"manas-2010:p1670:b001:l020","ordinal":71819,"en":"He plundered and carried off my daughter."},{"id":"manas-2010:p1670:b001:l021","ordinal":71820,"en":"He robbed me of sleep."},{"id":"manas-2010:p1670:b001:l022","ordinal":71821,"en":"At first we were the people of forty khans;"},{"id":"manas-2010:p1670:b001:l023","ordinal":71822,"en":"Hero, he slaughtered my people."},{"id":"manas-2010:p1670:b001:l024","ordinal":71823,"en":"Consent to what I say, hero;"},{"id":"manas-2010:p1670:b001:l025","ordinal":71824,"en":"Why should I speak of the others?"},{"id":"manas-2010:p1670:b001:l026","ordinal":71825,"en":"Just shoot Almambet for me!"},{"id":"manas-2010:p1670:b001:l027","ordinal":71826,"en":"If you shoot Almambet dead,"},{"id":"manas-2010:p1670:b001:l028","ordinal":71827,"en":"The worthy khan, Sultan Manas,"},{"id":"manas-2010:p1670:b001:l029","ordinal":71828,"en":"Oh hero, we shall capture alive."},{"id":"manas-2010:p1670:b001:l030","ordinal":71829,"en":"To the eighty girls in Beijing,"},{"id":"manas-2010:p1670:b001:l031","ordinal":71830,"en":"Hero, we shall take him and put him to stud."},{"id":"manas-2010:p1670:b001:l032","ordinal":71831,"en":"Then, if a boy is born,"},{"id":"manas-2010:p1670:b001:l033","ordinal":71832,"en":"Over Beijing of Kakan-Chin,"},{"id":"manas-2010:p1670:b001:l034","ordinal":71833,"en":"We shall raise him as khan!”"},{"id":"manas-2010:p1670:b001:l035","ordinal":71834,"en":"Before the grim-faced one could finish his plan,"},{"id":"manas-2010:p1670:b001:l036","ordinal":71835,"en":"Almambet, who had been watching,"},{"id":"manas-2010:p1670:b001:l037","ordinal":71836,"en":"His sword ringing in his hand,"},{"id":"manas-2010:p1670:b001:l038","ordinal":71837,"en":"His battle-axe chiming at his waist,"},{"id":"manas-2010:p1670:b001:l039","ordinal":71838,"en":"His painted spear sweeping in his hand,"},{"id":"manas-2010:p1670:b001:l040","ordinal":71839,"en":"Then, with his waist bound tight,"},{"id":"manas-2010:p1670:b001:l041","ordinal":71840,"en":"Looking like dusk and mist,"},{"id":"manas-2010:p1670:b001:l042","ordinal":71841,"en":"Taking the form of a night death-spirit,"},{"id":"manas-2010:p1671:b001:l001","ordinal":71842,"en":"Then rumbling and gathering speed,"},{"id":"manas-2010:p1671:b001:l002","ordinal":71843,"en":"Had reached them."},{"id":"manas-2010:p1671:b001:l003","ordinal":71844,"en":"With the aspect of a hungry lion,"},{"id":"manas-2010:p1671:b001:l004","ordinal":71845,"en":"If you looked at him from the front,"},{"id":"manas-2010:p1671:b001:l005","ordinal":71846,"en":"He had the dread presence of six thousand warriors;"},{"id":"manas-2010:p1671:b001:l006","ordinal":71847,"en":"If you looked at him from behind,"},{"id":"manas-2010:p1671:b001:l007","ordinal":71848,"en":"He had the form of a dragon."},{"id":"manas-2010:p1671:b001:l008","ordinal":71849,"en":"Readying his keen steel,"},{"id":"manas-2010:p1671:b001:l009","ordinal":71850,"en":"Venom pouring from his mouth,"},{"id":"manas-2010:p1671:b001:l010","ordinal":71851,"en":"He rose towering over the ridge,"},{"id":"manas-2010:p1671:b001:l011","ordinal":71852,"en":"Looking like a dragon."},{"id":"manas-2010:p1671:b001:l012","ordinal":71853,"en":"When he saw Almambet's appearance,"},{"id":"manas-2010:p1671:b001:l013","ordinal":71854,"en":"The grim-faced wretch began to think:"},{"id":"manas-2010:p1671:b001:l014","ordinal":71855,"en":"“Sarala beneath him,"},{"id":"manas-2010:p1671:b001:l015","ordinal":71856,"en":"No beast can match him in a race;"},{"id":"manas-2010:p1671:b001:l016","ordinal":71857,"en":"Against this raging fugitive,"},{"id":"manas-2010:p1671:b001:l017","ordinal":71858,"en":"No strength can suffice in battle."},{"id":"manas-2010:p1671:b001:l018","ordinal":71859,"en":"Let me merely pretend to flee;"},{"id":"manas-2010:p1671:b001:l019","ordinal":71860,"en":"Let me plunge him into deep misery."},{"id":"manas-2010:p1671:b001:l020","ordinal":71861,"en":"If he falls alive into my hands,"},{"id":"manas-2010:p1671:b001:l021","ordinal":71862,"en":"Let me take boundless vengeance on the dog."},{"id":"manas-2010:p1671:b001:l022","ordinal":71863,"en":"Torturing him once every seven steps,"},{"id":"manas-2010:p1671:b001:l023","ordinal":71864,"en":"Let me thus cast him into fire!”"},{"id":"manas-2010:p1671:b001:l024","ordinal":71865,"en":"Then Almambet came out upon the ridge,"},{"id":"manas-2010:p1671:b001:l025","ordinal":71866,"en":"Fired once with his painted gun;"},{"id":"manas-2010:p1671:b001:l026","ordinal":71867,"en":"Unable to withstand his fury,"},{"id":"manas-2010:p1671:b001:l027","ordinal":71868,"en":"The Manchus fled with a rush."},{"id":"manas-2010:p1671:b001:l028","ordinal":71869,"en":"Over a saddle-shaped ridge,"},{"id":"manas-2010:p1671:b001:l029","ordinal":71870,"en":"Kongurbay passed."},{"id":"manas-2010:p1671:b001:l030","ordinal":71871,"en":"Algara beneath him,"},{"id":"manas-2010:p1671:b001:l031","ordinal":71872,"en":"He whipped on either side;"},{"id":"manas-2010:p1671:b001:l032","ordinal":71873,"en":"Kongurbay fled."},{"id":"manas-2010:p1671:b001:l033","ordinal":71874,"en":"“God, deliver the Manchu to me!” he said."},{"id":"manas-2010:p1671:b001:l034","ordinal":71875,"en":"Without looking around,"},{"id":"manas-2010:p1671:b001:l035","ordinal":71876,"en":"Almambet pursued in earnest,"},{"id":"manas-2010:p1671:b001:l036","ordinal":71877,"en":"Not sparing his life at all."},{"id":"manas-2010:p1671:b001:l037","ordinal":71878,"en":"Your Alma struggled, unable to catch him,"},{"id":"manas-2010:p1671:b001:l038","ordinal":71879,"en":"Pleading with Sarala:"},{"id":"manas-2010:p1671:b001:l039","ordinal":71880,"en":"“Today, my companion in suffering, Sarala,"},{"id":"manas-2010:p1671:b001:l040","ordinal":71881,"en":"Lower your head to the ground;"},{"id":"manas-2010:p1671:b001:l041","ordinal":71882,"en":"Take strides like a wild sheep.”"},{"id":"manas-2010:p1671:b001:l042","ordinal":71883,"en":"Sarala beneath him,"},{"id":"manas-2010:p1672:b001:l001","ordinal":71884,"en":"Your Alake struck Sarala on the thigh;"},{"id":"manas-2010:p1672:b001:l002","ordinal":71885,"en":"Then a long trail of dust stretched out."},{"id":"manas-2010:p1672:b001:l003","ordinal":71886,"en":"Oh dog, when they reached the descent,"},{"id":"manas-2010:p1672:b001:l004","ordinal":71887,"en":"The grim-faced hero's Algara"},{"id":"manas-2010:p1672:b001:l005","ordinal":71888,"en":"Planted his forelegs like a roe deer."},{"id":"manas-2010:p1672:b001:l006","ordinal":71889,"en":"When they started climbing,"},{"id":"manas-2010:p1672:b001:l007","ordinal":71890,"en":"Your Alake's Sarala"},{"id":"manas-2010:p1672:b001:l008","ordinal":71891,"en":"Had mane and tail streaming."},{"id":"manas-2010:p1672:b001:l009","ordinal":71892,"en":"When they entered a steep descent,"},{"id":"manas-2010:p1672:b001:l010","ordinal":71893,"en":"Kongurbay's Algara"},{"id":"manas-2010:p1672:b001:l011","ordinal":71894,"en":"Had his bull-like neck bulging;"},{"id":"manas-2010:p1672:b001:l012","ordinal":71895,"en":"When they started climbing,"},{"id":"manas-2010:p1672:b001:l013","ordinal":71896,"en":"Your Alake's Sarala"},{"id":"manas-2010:p1672:b001:l014","ordinal":71897,"en":"Had eyes flashing like flint."},{"id":"manas-2010:p1672:b001:l015","ordinal":71898,"en":"Your infidel's Algara,"},{"id":"manas-2010:p1672:b001:l016","ordinal":71899,"en":"When he entered a descent,"},{"id":"manas-2010:p1672:b001:l017","ordinal":71900,"en":"Sped away into the distance;"},{"id":"manas-2010:p1672:b001:l018","ordinal":71901,"en":"When they started climbing,"},{"id":"manas-2010:p1672:b001:l019","ordinal":71902,"en":"Your Alake's Sarala"},{"id":"manas-2010:p1672:b001:l020","ordinal":71903,"en":"Drew close upon his heels."},{"id":"manas-2010:p1672:b001:l021","ordinal":71904,"en":"Oh hero, down Kürpüldök's curved ridge,"},{"id":"manas-2010:p1672:b001:l022","ordinal":71905,"en":"He drove him downhill in pursuit."},{"id":"manas-2010:p1672:b001:l023","ordinal":71906,"en":"The barren plain where they pursued each other,"},{"id":"manas-2010:p1672:b001:l024","ordinal":71907,"en":"Upon that barren plain,"},{"id":"manas-2010:p1672:b001:l025","ordinal":71908,"en":"There was no burrow dug by a marmot,"},{"id":"manas-2010:p1672:b001:l026","ordinal":71909,"en":"No furrow cut by a wooden plow,"},{"id":"manas-2010:p1672:b001:l027","ordinal":71910,"en":"No stone to crack a marrowbone,"},{"id":"manas-2010:p1672:b001:l028","ordinal":71911,"en":"No pit, hollow or ditch."},{"id":"manas-2010:p1672:b001:l029","ordinal":71912,"en":"When they reached the level plain,"},{"id":"manas-2010:p1672:b001:l030","ordinal":71913,"en":"Unable to gather his wits,"},{"id":"manas-2010:p1672:b001:l031","ordinal":71914,"en":"Your noble grim-faced warrior—"},{"id":"manas-2010:p1672:b001:l032","ordinal":71915,"en":"He drew near, about to reach him."},{"id":"manas-2010:p1672:b001:l033","ordinal":71916,"en":"Urging Sarala on with a shout,"},{"id":"manas-2010:p1672:b001:l034","ordinal":71917,"en":"Your noble lion reached him."},{"id":"manas-2010:p1672:b001:l035","ordinal":71918,"en":"Reaching the grim-faced one,"},{"id":"manas-2010:p1672:b001:l036","ordinal":71919,"en":"At the thin part of his right shoulder blade,"},{"id":"manas-2010:p1672:b001:l037","ordinal":71920,"en":"Your Alake aimed and struck as he passed."},{"id":"manas-2010:p1672:b001:l038","ordinal":71921,"en":"Then Sarala beneath him,"},{"id":"manas-2010:p1672:b001:l039","ordinal":71922,"en":"As he struck the grim-faced one,"},{"id":"manas-2010:p1672:b001:l040","ordinal":71923,"en":"Leaped and leaped, gathering himself."},{"id":"manas-2010:p1672:b001:l041","ordinal":71924,"en":"Then the painted spear did not break;"},{"id":"manas-2010:p1672:b001:l042","ordinal":71925,"en":"It bent like a round pot-stand."},{"id":"manas-2010:p1673:b001:l001","ordinal":71926,"en":"The grim-faced one lost consciousness;"},{"id":"manas-2010:p1673:b001:l002","ordinal":71927,"en":"The warrior left his saddle,"},{"id":"manas-2010:p1673:b001:l003","ordinal":71928,"en":"His feet left the stirrups,"},{"id":"manas-2010:p1673:b001:l004","ordinal":71929,"en":"His eyes darted wildly,"},{"id":"manas-2010:p1673:b001:l005","ordinal":71930,"en":"His feet dangled."},{"id":"manas-2010:p1673:b001:l006","ordinal":71931,"en":"“Where are the Manchu hosts, the troops?” he cried."},{"id":"manas-2010:p1673:b001:l007","ordinal":71932,"en":"Kongurbay ran out of recourse;"},{"id":"manas-2010:p1673:b001:l008","ordinal":71933,"en":"He groped for the crupper,"},{"id":"manas-2010:p1673:b001:l009","ordinal":71934,"en":"Crying out in ever greater distress,"},{"id":"manas-2010:p1673:b001:l010","ordinal":71935,"en":"Calling the battle cry, “Come on!”"},{"id":"manas-2010:p1673:b001:l011","ordinal":71936,"en":"When he thought of words, they came too late."}]
