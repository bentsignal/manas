{"id": "sayakbay-ms-current146:pdf023:l001", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 23, "folio": 406, "line_in_page": 1, "raw": "Хан Теңиринен Суурган,", "text": "Хан Теңиринен Суурган,", "en": "Suurgan, from Khan Tengir,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The proper-name phrase is a provisional visual reading; the final name may instead be Суурулган.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf023:l002", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 23, "folio": 406, "line_in_page": 2, "raw": "Хан эжесин билбейт,", "text": "Хан эжесин билбейт,", "en": "The khan does not know his elder sister,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The last word is faint and may be a past-tense form rather than билбейт.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf023:l003", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 23, "folio": 406, "line_in_page": 3, "raw": "Карачы турган канча жан,", "text": "Карачы турган канча жан,", "en": "How many souls stood watching,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Карачы турган is the closest visual reading; the first phrase is contextually uncertain.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf023:l004", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 23, "folio": 406, "line_in_page": 4, "raw": "Калбай жандан түңүлүп,", "text": "Калбай жандан түңүлүп,", "en": "All of them despairing of life,", "classification": "narrative", "transcription_status": "visually_transcribed", "bbox": null}
