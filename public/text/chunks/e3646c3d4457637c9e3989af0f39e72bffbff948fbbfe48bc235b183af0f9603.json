[{"id":"manas-2010:p1525:b001:l027","ordinal":65793,"en":"Baabedin’s son,"},{"id":"manas-2010:p1525:b001:l028","ordinal":65794,"en":"Baychoro, born a warrior,"},{"id":"manas-2010:p1525:b001:l029","ordinal":65795,"en":"Making Aksur prance,"},{"id":"manas-2010:p1525:b001:l030","ordinal":65796,"en":"Sending every man crawling,"},{"id":"manas-2010:p1525:b001:l031","ordinal":65797,"en":"Plunged among the Chinese."},{"id":"manas-2010:p1525:b001:l032","ordinal":65798,"en":"He met no fitting opponent,"},{"id":"manas-2010:p1525:b001:l033","ordinal":65799,"en":"But encountered the foot soldiers."},{"id":"manas-2010:p1525:b001:l034","ordinal":65800,"en":"For six days he fought,"},{"id":"manas-2010:p1525:b001:l035","ordinal":65801,"en":"Battling without sparing himself;"},{"id":"manas-2010:p1525:b001:l036","ordinal":65802,"en":"Aksur fell and collapsed,"},{"id":"manas-2010:p1525:b001:l037","ordinal":65803,"en":"And upon Baychoro the foot soldiers"},{"id":"manas-2010:p1525:b001:l038","ordinal":65804,"en":"All swarmed together."},{"id":"manas-2010:p1525:b001:l039","ordinal":65805,"en":"Separated from his horse,"},{"id":"manas-2010:p1525:b001:l040","ordinal":65806,"en":"He fell into their hands."},{"id":"manas-2010:p1525:b001:l041","ordinal":65807,"en":"Seeing this, that same"},{"id":"manas-2010:p1525:b001:l042","ordinal":65808,"en":"Lean-haunched Sarala"},{"id":"manas-2010:p1526:b001:l001","ordinal":65809,"en":"Almambet sent wheeling;"},{"id":"manas-2010:p1526:b001:l002","ordinal":65810,"en":"One of the foot soldiers"},{"id":"manas-2010:p1526:b001:l003","ordinal":65811,"en":"He struck down as soon as he reached him."},{"id":"manas-2010:p1526:b001:l004","ordinal":65812,"en":"Reaching him, Almambet took alongside"},{"id":"manas-2010:p1526:b001:l005","ordinal":65813,"en":"Aksur, the horse beneath him,"},{"id":"manas-2010:p1526:b001:l006","ordinal":65814,"en":"And brought him out at a gallop."},{"id":"manas-2010:p1526:b001:l007","ordinal":65815,"en":"On the plain shrouded in haze,"},{"id":"manas-2010:p1526:b001:l008","ordinal":65816,"en":"Amid the army countless as ants,"},{"id":"manas-2010:p1526:b001:l009","ordinal":65817,"en":"Shouting, “Baychoro!”"},{"id":"manas-2010:p1526:b001:l010","ordinal":65818,"en":"Almambet kept halting."},{"id":"manas-2010:p1526:b001:l011","ordinal":65819,"en":"Among the countless Chinese and Manchus,"},{"id":"manas-2010:p1526:b001:l012","ordinal":65820,"en":"Ulak Khan’s Syrgak"},{"id":"manas-2010:p1526:b001:l013","ordinal":65821,"en":"Had wrought a terrible slaughter."},{"id":"manas-2010:p1526:b001:l014","ordinal":65822,"en":"Scooping him up like a little bird,"},{"id":"manas-2010:p1526:b001:l015","ordinal":65823,"en":"Warrior Syrgak took Baychoro,"},{"id":"manas-2010:p1526:b001:l016","ordinal":65824,"en":"Snatched him from the Chinese,"},{"id":"manas-2010:p1526:b001:l017","ordinal":65825,"en":"And bore him swiftly away."},{"id":"manas-2010:p1526:b001:l018","ordinal":65826,"en":"Azizkhan’s Almambet"},{"id":"manas-2010:p1526:b001:l019","ordinal":65827,"en":"Brought Aksur, whom he was leading,"},{"id":"manas-2010:p1526:b001:l020","ordinal":65828,"en":"Round broadside to him;"},{"id":"manas-2010:p1526:b001:l021","ordinal":65829,"en":"Your champion, warrior Syrgak,"},{"id":"manas-2010:p1526:b001:l022","ordinal":65830,"en":"Mounted him safely on Aksur"},{"id":"manas-2010:p1526:b001:l023","ordinal":65831,"en":"And led him on his way."},{"id":"manas-2010:p1526:b001:l024","ordinal":65832,"en":"Syrgak and Almambet, their names in accord,"},{"id":"manas-2010:p1526:b001:l025","ordinal":65833,"en":"Fearless men, born lions,"},{"id":"manas-2010:p1526:b001:l026","ordinal":65834,"en":"Unwearied in their struggles,"},{"id":"manas-2010:p1526:b001:l027","ordinal":65835,"en":"Untiring in their blows,"},{"id":"manas-2010:p1526:b001:l028","ordinal":65836,"en":"Would not let the swarming Chinese and many Manchus"},{"id":"manas-2010:p1526:b001:l029","ordinal":65837,"en":"Draw near them,"},{"id":"manas-2010:p1526:b001:l030","ordinal":65838,"en":"Would not let them reach the Muslims."},{"id":"manas-2010:p1526:b001:l031","ordinal":65839,"en":"Shouting, “Islam!”"},{"id":"manas-2010:p1526:b001:l032","ordinal":65840,"en":"Slaughtering, destroying and scattering them,"},{"id":"manas-2010:p1526:b001:l033","ordinal":65841,"en":"They held the Chinese off."},{"id":"manas-2010:p1526:b001:l034","ordinal":65842,"en":"When the Chinese pressed in harder,"},{"id":"manas-2010:p1526:b001:l035","ordinal":65843,"en":"Azizkhan’s Almambet"},{"id":"manas-2010:p1526:b001:l036","ordinal":65844,"en":"Roared in wrath,"},{"id":"manas-2010:p1526:b001:l037","ordinal":65845,"en":"Calling, “Come, Syrgak!"},{"id":"manas-2010:p1526:b001:l038","ordinal":65846,"en":"Great Beijing, which even holy Ali could not touch—"},{"id":"manas-2010:p1526:b001:l039","ordinal":65847,"en":"Saying we would fight it,"},{"id":"manas-2010:p1526:b001:l040","ordinal":65848,"en":"Having suffered so many wounds,"},{"id":"manas-2010:p1526:b001:l041","ordinal":65849,"en":"Unable to exchange shots with the enemy,"},{"id":"manas-2010:p1526:b001:l042","ordinal":65850,"en":"Shall we bleed away our lives?"},{"id":"manas-2010:p1527:b001:l001","ordinal":65851,"en":"Turning back toward Beijing,"},{"id":"manas-2010:p1527:b001:l002","ordinal":65852,"en":"Parted from our champions,"},{"id":"manas-2010:p1527:b001:l003","ordinal":65853,"en":"My Syrgak, shall we fall into misery?"},{"id":"manas-2010:p1527:b001:l004","ordinal":65854,"en":"The multitude of Chinese has risen;"},{"id":"manas-2010:p1527:b001:l005","ordinal":65855,"en":"The Chinese have brought torment."},{"id":"manas-2010:p1527:b001:l006","ordinal":65856,"en":"The idol made of bronze"},{"id":"manas-2010:p1527:b001:l007","ordinal":65857,"en":"They have fastened high;"},{"id":"manas-2010:p1527:b001:l008","ordinal":65858,"en":"Not to turn back and leave,"},{"id":"manas-2010:p1527:b001:l009","ordinal":65859,"en":"The multitude of Chinese has sworn an oath"},{"id":"manas-2010:p1527:b001:l010","ordinal":65860,"en":"And grown stubbornly resolved."},{"id":"manas-2010:p1527:b001:l011","ordinal":65861,"en":"The Chinese who fled back,"},{"id":"manas-2010:p1527:b001:l012","ordinal":65862,"en":"‘Turn and fight!’ he said,"},{"id":"manas-2010:p1527:b001:l013","ordinal":65863,"en":"That doomed grim-faced Kongurbay"},{"id":"manas-2010:p1527:b001:l014","ordinal":65864,"en":"Has hemmed in and driven forward."},{"id":"manas-2010:p1527:b001:l015","ordinal":65865,"en":"Pitch-dark night is coming;"},{"id":"manas-2010:p1527:b001:l016","ordinal":65866,"en":"An army to shed blood is coming;"},{"id":"manas-2010:p1527:b001:l017","ordinal":65867,"en":"A force to crush our lives is coming, Syrgak!"},{"id":"manas-2010:p1527:b001:l018","ordinal":65868,"en":"The great force raised in Beijing is coming;"},{"id":"manas-2010:p1527:b001:l019","ordinal":65869,"en":"An uncountable multitude of troops is coming;"},{"id":"manas-2010:p1527:b001:l020","ordinal":65870,"en":"Peoples of every kind are coming;"},{"id":"manas-2010:p1527:b001:l021","ordinal":65871,"en":"A flood to engulf everything is coming!"},{"id":"manas-2010:p1527:b001:l022","ordinal":65872,"en":"What an age, what a day!"},{"id":"manas-2010:p1527:b001:l023","ordinal":65873,"en":"Renouncing my idol,"},{"id":"manas-2010:p1527:b001:l024","ordinal":65874,"en":"Leaving my throne and people,"},{"id":"manas-2010:p1527:b001:l025","ordinal":65875,"en":"When I fled toward the Burut,"},{"id":"manas-2010:p1527:b001:l026","ordinal":65876,"en":"I saw many a hero,"},{"id":"manas-2010:p1527:b001:l027","ordinal":65877,"en":"The seething Chinese infidels."},{"id":"manas-2010:p1527:b001:l028","ordinal":65878,"en":"When they came surging in,"},{"id":"manas-2010:p1527:b001:l029","ordinal":65879,"en":"I drove the Chinese back and crushed them;"},{"id":"manas-2010:p1527:b001:l030","ordinal":65880,"en":"Fighting in their multitude,"},{"id":"manas-2010:p1527:b001:l031","ordinal":65881,"en":"The countless Manchus and Chinese"},{"id":"manas-2010:p1527:b001:l032","ordinal":65882,"en":"Had brought upon my head"},{"id":"manas-2010:p1527:b001:l033","ordinal":65883,"en":"A dark day, the end of the world."},{"id":"manas-2010:p1527:b001:l034","ordinal":65884,"en":"These are those Chinese people;"},{"id":"manas-2010:p1527:b001:l035","ordinal":65885,"en":"This is the grief in my heart!"},{"id":"manas-2010:p1527:b001:l036","ordinal":65886,"en":"Stained with red blood,"},{"id":"manas-2010:p1527:b001:l037","ordinal":65887,"en":"Without looking back behind me,"},{"id":"manas-2010:p1527:b001:l038","ordinal":65888,"en":"I am the one who went away!”"},{"id":"manas-2010:p1527:b001:l039","ordinal":65889,"en":"Then Syrgak said this:"},{"id":"manas-2010:p1527:b001:l040","ordinal":65890,"en":"“Do not block my road, Almam;"},{"id":"manas-2010:p1527:b001:l041","ordinal":65891,"en":"Let go of my hand, Alma!"},{"id":"manas-2010:p1527:b001:l042","ordinal":65892,"en":"At the Chinese surging upon us,"},{"id":"manas-2010:p1528:b001:l001","ordinal":65893,"en":"Let me charge and thrust my spear;"},{"id":"manas-2010:p1528:b001:l002","ordinal":65894,"en":"From the fiercely wrathful hell"},{"id":"manas-2010:p1528:b001:l003","ordinal":65895,"en":"I shall free my soul."},{"id":"manas-2010:p1528:b001:l004","ordinal":65896,"en":"If my death comes from the Chinese,"},{"id":"manas-2010:p1528:b001:l005","ordinal":65897,"en":"I shall die fighting."},{"id":"manas-2010:p1528:b001:l006","ordinal":65898,"en":"While my frail life remains,"},{"id":"manas-2010:p1528:b001:l007","ordinal":65899,"en":"The Chinese in Chin-Beijing,"},{"id":"manas-2010:p1528:b001:l008","ordinal":65900,"en":"Making their children shriek,"},{"id":"manas-2010:p1528:b001:l009","ordinal":65901,"en":"I shall tear to pieces;"},{"id":"manas-2010:p1528:b001:l010","ordinal":65902,"en":"Without smashing the Chinese,"},{"id":"manas-2010:p1528:b001:l011","ordinal":65903,"en":"How can I see Talas!"},{"id":"manas-2010:p1528:b001:l012","ordinal":65904,"en":"With Alöökö's son Kongurbay,"},{"id":"manas-2010:p1528:b001:l013","ordinal":65905,"en":"Fighting without sparing one another,"},{"id":"manas-2010:p1528:b001:l014","ordinal":65906,"en":"Finding my chance, the grim-faced one"},{"id":"manas-2010:p1528:b001:l015","ordinal":65907,"en":"I shall seize by the nape;"},{"id":"manas-2010:p1528:b001:l016","ordinal":65908,"en":"If I get the grim-faced one in my hands,"},{"id":"manas-2010:p1528:b001:l017","ordinal":65909,"en":"I shall slaughter him as a sacrifice!"},{"id":"manas-2010:p1528:b001:l018","ordinal":65910,"en":"Without spilling Kongurbay's blood,"},{"id":"manas-2010:p1528:b001:l019","ordinal":65911,"en":"How can I return to the Burut!”"},{"id":"manas-2010:p1528:b001:l020","ordinal":65912,"en":"As Syrgak stood refusing to yield,"},{"id":"manas-2010:p1528:b001:l021","ordinal":65913,"en":"The bulletproof garments Kanykey gave—"},{"id":"manas-2010:p1528:b001:l022","ordinal":65914,"en":"Separate clothing for battle;"},{"id":"manas-2010:p1528:b001:l023","ordinal":65915,"en":"‘Lest they become infested with lice,’"},{"id":"manas-2010:p1528:b001:l024","ordinal":65916,"en":"Separate clothing for dirt;"},{"id":"manas-2010:p1528:b001:l025","ordinal":65917,"en":"Separate clothing for dust;"},{"id":"manas-2010:p1528:b001:l026","ordinal":65918,"en":"While resting, in peace,"},{"id":"manas-2010:p1528:b001:l027","ordinal":65919,"en":"Separate clothing for the khan."},{"id":"manas-2010:p1528:b001:l028","ordinal":65920,"en":"The black pack camel with a cap-like hump,"},{"id":"manas-2010:p1528:b001:l029","ordinal":65921,"en":"Khan Manas's Zhelmayaan,"},{"id":"manas-2010:p1528:b001:l030","ordinal":65922,"en":"Had brought the coat of armor as a load—"},{"id":"manas-2010:p1528:b001:l031","ordinal":65923,"en":"Its collar gold, its sleeves bronze,"},{"id":"manas-2010:p1528:b001:l032","ordinal":65924,"en":"Double mail, its meshes like larks' eyes,"},{"id":"manas-2010:p1528:b001:l033","ordinal":65925,"en":"A suede jacket with a broad collar."},{"id":"manas-2010:p1528:b001:l034","ordinal":65926,"en":"She had the whole city searched,"},{"id":"manas-2010:p1528:b001:l035","ordinal":65927,"en":"Had it worked into the coat of armor."},{"id":"manas-2010:p1528:b001:l036","ordinal":65928,"en":"Biting and pulling it tight, Kanykey"},{"id":"manas-2010:p1528:b001:l037","ordinal":65929,"en":"Had worn her front teeth raw;"},{"id":"manas-2010:p1528:b001:l038","ordinal":65930,"en":"Staring without taking her eyes away,"},{"id":"manas-2010:p1528:b001:l039","ordinal":65931,"en":"‘Where has it become loose?’ she asked,"},{"id":"manas-2010:p1528:b001:l040","ordinal":65932,"en":"Her dark eyes heavy with exhaustion."},{"id":"manas-2010:p1528:b001:l041","ordinal":65933,"en":"That the Chinese would bring slaughter,"},{"id":"manas-2010:p1528:b001:l042","ordinal":65934,"en":"The companions knew as they came,"},{"id":"manas-2010:p1529:b001:l001","ordinal":65935,"en":"Girding on steel swords,"},{"id":"manas-2010:p1529:b001:l002","ordinal":65936,"en":"Preparing their arms."},{"id":"manas-2010:p1529:b001:l003","ordinal":65937,"en":"While the companions stood thus,"},{"id":"manas-2010:p1529:b001:l004","ordinal":65938,"en":"The grim-faced one had mustered courage;"},{"id":"manas-2010:p1529:b001:l005","ordinal":65939,"en":"The countless Chinese and Manchus,"},{"id":"manas-2010:p1529:b001:l006","ordinal":65940,"en":"‘Sweep upon them!’ he said, striking with his sword,"},{"id":"manas-2010:p1529:b001:l007","ordinal":65941,"en":"And drove them before him."},{"id":"manas-2010:p1529:b001:l008","ordinal":65942,"en":"Look at the grass upon the earth;"},{"id":"manas-2010:p1529:b001:l009","ordinal":65943,"en":"The Chinese were thicker than the grass,"},{"id":"manas-2010:p1529:b001:l010","ordinal":65944,"en":"Swarming like ants;"},{"id":"manas-2010:p1529:b001:l011","ordinal":65945,"en":"Look at the uncountable multitude, like sand!"},{"id":"manas-2010:p1529:b001:l012","ordinal":65946,"en":"Of the Chinese wearing rank buttons,"},{"id":"manas-2010:p1529:b001:l013","ordinal":65947,"en":"The finest stood apart;"},{"id":"manas-2010:p1529:b001:l014","ordinal":65948,"en":"Of the jacketed Manchus,"},{"id":"manas-2010:p1529:b001:l015","ordinal":65949,"en":"The stalwarts appeared,"},{"id":"manas-2010:p1529:b001:l016","ordinal":65950,"en":"Calling the battle cry, ‘Come on!’"},{"id":"manas-2010:p1529:b001:l017","ordinal":65951,"en":"Shouting to split the earth."},{"id":"manas-2010:p1529:b001:l018","ordinal":65952,"en":"When the Chinese spread out,"},{"id":"manas-2010:p1529:b001:l019","ordinal":65953,"en":"A thousand times more than before,"},{"id":"manas-2010:p1529:b001:l020","ordinal":65954,"en":"They surged forward in greater numbers."},{"id":"manas-2010:p1529:b001:l021","ordinal":65955,"en":"Seeing such an army,"},{"id":"manas-2010:p1529:b001:l022","ordinal":65956,"en":"The few Muslims"},{"id":"manas-2010:p1529:b001:l023","ordinal":65957,"en":"Despaired of their lives."},{"id":"manas-2010:p1529:b001:l024","ordinal":65958,"en":"The Burut took counsel,"},{"id":"manas-2010:p1529:b001:l025","ordinal":65959,"en":"Exchanging words and advice:"},{"id":"manas-2010:p1529:b001:l026","ordinal":65960,"en":"“You who are your father's only son,"},{"id":"manas-2010:p1529:b001:l027","ordinal":65961,"en":"If you have no kinsmen behind you,"},{"id":"manas-2010:p1529:b001:l028","ordinal":65962,"en":"Go to your homeland now."},{"id":"manas-2010:p1529:b001:l029","ordinal":65963,"en":"You who say, ‘My strength is poor,’"},{"id":"manas-2010:p1529:b001:l030","ordinal":65964,"en":"Do not die needlessly, saying, ‘I shall fight’;"},{"id":"manas-2010:p1529:b001:l031","ordinal":65965,"en":"Return to your own place now!"},{"id":"manas-2010:p1529:b001:l032","ordinal":65966,"en":"Where Alexander never set foot,"},{"id":"manas-2010:p1529:b001:l033","ordinal":65967,"en":"Where Solomon never ruled,"},{"id":"manas-2010:p1529:b001:l034","ordinal":65968,"en":"Where no one ever ruled,"},{"id":"manas-2010:p1529:b001:l035","ordinal":65969,"en":"When thought finished, they blazed up,"},{"id":"manas-2010:p1529:b001:l036","ordinal":65970,"en":"Growing stronger from their roots;"},{"id":"manas-2010:p1529:b001:l037","ordinal":65971,"en":"They are an inexhaustible Chinese people,"},{"id":"manas-2010:p1529:b001:l038","ordinal":65972,"en":"Growing with every death,"},{"id":"manas-2010:p1529:b001:l039","ordinal":65973,"en":"A flood that will engulf all."},{"id":"manas-2010:p1529:b001:l040","ordinal":65974,"en":"Gathering uselessly like this,"},{"id":"manas-2010:p1529:b001:l041","ordinal":65975,"en":"Being slaughtered without taking care,"},{"id":"manas-2010:p1529:b001:l042","ordinal":65976,"en":"Do not die before your appointed death."},{"id":"manas-2010:p1530:b001:l001","ordinal":65977,"en":"You who survive those who die,"},{"id":"manas-2010:p1530:b001:l002","ordinal":65978,"en":"Make your way to Talas;"},{"id":"manas-2010:p1530:b001:l003","ordinal":65979,"en":"‘We have suffered humiliation,’"},{"id":"manas-2010:p1530:b001:l004","ordinal":65980,"en":"Tell Manas!”"},{"id":"manas-2010:p1530:b001:l005","ordinal":65981,"en":"The Muslims barely holding on"},{"id":"manas-2010:p1530:b001:l006","ordinal":65982,"en":"Turned back with cries;"},{"id":"manas-2010:p1530:b001:l007","ordinal":65983,"en":"The timid Burut without courage,"},{"id":"manas-2010:p1530:b001:l008","ordinal":65984,"en":"‘What times will come?’ they said,"},{"id":"manas-2010:p1530:b001:l009","ordinal":65985,"en":"And went away sobbing."},{"id":"manas-2010:p1530:b001:l010","ordinal":65986,"en":"As the Burut left thus,"},{"id":"manas-2010:p1530:b001:l011","ordinal":65987,"en":"Golden-forelocked, tasseled-belted,"},{"id":"manas-2010:p1530:b001:l012","ordinal":65988,"en":"Azizkan's only son,"},{"id":"manas-2010:p1530:b001:l013","ordinal":65989,"en":"Lion-born Almambet,"},{"id":"manas-2010:p1530:b001:l014","ordinal":65990,"en":"When he worked his weather magic,"},{"id":"manas-2010:p1530:b001:l015","ordinal":65991,"en":"Sleet swirled in a blizzard;"},{"id":"manas-2010:p1530:b001:l016","ordinal":65992,"en":"Cloudy by day, clear by night,"},{"id":"manas-2010:p1530:b001:l017","ordinal":65993,"en":"Rain fell throughout the lowlands,"},{"id":"manas-2010:p1530:b001:l018","ordinal":65994,"en":"Hail fell across all the foothills;"},{"id":"manas-2010:p1530:b001:l019","ordinal":65995,"en":"It descended like ground mist;"},{"id":"manas-2010:p1530:b001:l020","ordinal":65996,"en":"The sun unseen, all grew dim;"},{"id":"manas-2010:p1530:b001:l021","ordinal":65997,"en":"The moon unseen, a faint glimmer remained;"},{"id":"manas-2010:p1530:b001:l022","ordinal":65998,"en":"Clouds swept down from the sky,"},{"id":"manas-2010:p1530:b001:l023","ordinal":65999,"en":"Pressed against the face of the earth;"},{"id":"manas-2010:p1530:b001:l024","ordinal":66000,"en":"The sun unseen, night fell;"},{"id":"manas-2010:p1530:b001:l025","ordinal":66001,"en":"No one could see around them;"},{"id":"manas-2010:p1530:b001:l026","ordinal":66002,"en":"Shouts could not carry,"},{"id":"manas-2010:p1530:b001:l027","ordinal":66003,"en":"And even where sound reached, sight could not."},{"id":"manas-2010:p1530:b001:l028","ordinal":66004,"en":"Summer's day became winter;"},{"id":"manas-2010:p1530:b001:l029","ordinal":66005,"en":"The spread-out waters became ice;"},{"id":"manas-2010:p1530:b001:l030","ordinal":66006,"en":"The thinly clothed Chinese"},{"id":"manas-2010:p1530:b001:l031","ordinal":66007,"en":"Became whimpering girls."},{"id":"manas-2010:p1530:b001:l032","ordinal":66008,"en":"Working his weather magic thus,"},{"id":"manas-2010:p1530:b001:l033","ordinal":66009,"en":"From the Chinese surging upon them,"},{"id":"manas-2010:p1530:b001:l034","ordinal":66010,"en":"The Burut who had fled"},{"id":"manas-2010:p1530:b001:l035","ordinal":66011,"en":"Almambet kept hidden from sight,"},{"id":"manas-2010:p1530:b001:l036","ordinal":66012,"en":"Standing across the road to bar them."},{"id":"manas-2010:p1530:b001:l037","ordinal":66013,"en":"While your Alma stood barring them,"},{"id":"manas-2010:p1530:b001:l038","ordinal":66014,"en":"The Chinese surged on without stopping,"},{"id":"manas-2010:p1530:b001:l039","ordinal":66015,"en":"Raging and crushing forward."},{"id":"manas-2010:p1530:b001:l040","ordinal":66016,"en":"To all the multitude,"},{"id":"manas-2010:p1530:b001:l041","ordinal":66017,"en":"‘Sweep upon them!’ Kongurbay"},{"id":"manas-2010:p1530:b001:l042","ordinal":66018,"en":"Sent word, calling out,"},{"id":"manas-2010:p1531:b001:l001","ordinal":66019,"en":"Upon the Chinese, the people of forty khans,"},{"id":"manas-2010:p1531:b001:l002","ordinal":66020,"en":"Kongurbay put pressure."},{"id":"manas-2010:p1531:b001:l003","ordinal":66021,"en":"“Slaughter without looking back, my people;"},{"id":"manas-2010:p1531:b001:l004","ordinal":66022,"en":"The Burut who attacked us first—"},{"id":"manas-2010:p1531:b001:l005","ordinal":66023,"en":"Give them such a spectacle!” he said."},{"id":"manas-2010:p1531:b001:l006","ordinal":66024,"en":"When Kongurbay said this,"},{"id":"manas-2010:p1531:b001:l007","ordinal":66025,"en":"Their swords swayed in a mass,"},{"id":"manas-2010:p1531:b001:l008","ordinal":66026,"en":"Their spearheads bobbed;"},{"id":"manas-2010:p1531:b001:l009","ordinal":66027,"en":"Troop after troop of Chinese"},{"id":"manas-2010:p1531:b001:l010","ordinal":66028,"en":"Divided into their troops;"},{"id":"manas-2010:p1531:b001:l011","ordinal":66029,"en":"Their marksmen surged forward;"},{"id":"manas-2010:p1531:b001:l012","ordinal":66030,"en":"All their giants"},{"id":"manas-2010:p1531:b001:l013","ordinal":66031,"en":"Prepared along the flanks."},{"id":"manas-2010:p1531:b001:l014","ordinal":66032,"en":"When the Chinese swept upon them,"},{"id":"manas-2010:p1531:b001:l015","ordinal":66033,"en":"Dust covered the earth."},{"id":"manas-2010:p1531:b001:l016","ordinal":66034,"en":"“What times will come?” they said;"},{"id":"manas-2010:p1531:b001:l017","ordinal":66035,"en":"All the warriors were stunned."},{"id":"manas-2010:p1531:b001:l018","ordinal":66036,"en":"The marksmen who came in a swarm,"},{"id":"manas-2010:p1531:b001:l019","ordinal":66037,"en":"Drawing their bows to rain arrows,"},{"id":"manas-2010:p1531:b001:l020","ordinal":66038,"en":"Resolved to fall upon the Burut."},{"id":"manas-2010:p1531:b001:l021","ordinal":66039,"en":"Great Beijing, untouched by the Deluge,"},{"id":"manas-2010:p1531:b001:l022","ordinal":66040,"en":"Divided into group after group,"},{"id":"manas-2010:p1531:b001:l023","ordinal":66041,"en":"Now made war without stopping."},{"id":"manas-2010:p1531:b001:l024","ordinal":66042,"en":"Khan Manas's forty companions,"},{"id":"manas-2010:p1531:b001:l025","ordinal":66043,"en":"Not letting them pursue the fleeing people,"},{"id":"manas-2010:p1531:b001:l026","ordinal":66044,"en":"Stood in front to bar them."},{"id":"manas-2010:p1531:b001:l027","ordinal":66045,"en":"Fighting in ordered turns,"},{"id":"manas-2010:p1531:b001:l028","ordinal":66046,"en":"Then drawing back,"},{"id":"manas-2010:p1531:b001:l029","ordinal":66047,"en":"With dear Alma facing the foe,"},{"id":"manas-2010:p1531:b001:l030","ordinal":66048,"en":"They fought without fleeing."}]
