[{"id":"semetey-1-2013:p0770:b004:l017","ordinal":135937,"en":"Even then, Kobosh's"},{"id":"semetey-1-2013:p0770:b004:l018","ordinal":135938,"en":"Had kept his own head safe."},{"id":"semetey-1-2013:p0770:b004:l019","ordinal":135939,"en":"Storming and rushing on,"},{"id":"semetey-1-2013:p0770:b004:l020","ordinal":135940,"en":"Clattering out words of nonsense,"},{"id":"semetey-1-2013:p0770:b004:l021","ordinal":135941,"en":"Your uncle Kobosh would not stop."},{"id":"semetey-1-2013:p0770:b004:l022","ordinal":135942,"en":"He truly began to thunder;"},{"id":"semetey-1-2013:p0770:b004:l023","ordinal":135943,"en":"The cold words Kobosh spoke"},{"id":"semetey-1-2013:p0770:b004:l024","ordinal":135944,"en":"Through the orphan son of Manas"},{"id":"semetey-1-2013:p0770:b004:l025","ordinal":135945,"en":"Pierced to the marrow."},{"id":"semetey-1-2013:p0770:b004:l026","ordinal":135946,"en":"When Kobosh spurred on and shouted,"},{"id":"semetey-1-2013:p0770:b004:l027","ordinal":135947,"en":"They pierced through his bones."},{"id":"semetey-1-2013:p0770:b004:l028","ordinal":135948,"en":"Raging more and more,"},{"id":"semetey-1-2013:p0770:b004:l029","ordinal":135949,"en":"Kobosh's eyes became bullets;"},{"id":"semetey-1-2013:p0770:b004:l030","ordinal":135950,"en":"The poor soul, scarcely a handspan,"},{"id":"semetey-1-2013:p0770:b004:l031","ordinal":135951,"en":"The child's heart became burning embers."},{"id":"semetey-1-2013:p0770:b004:l032","ordinal":135952,"en":"How he had wandered far away,"},{"id":"semetey-1-2013:p0770:b004:l033","ordinal":135953,"en":"That rootless fool Kobosh"},{"id":"semetey-1-2013:p0770:b004:l034","ordinal":135954,"en":"Now recounted in full."},{"id":"semetey-1-2013:p0770:b004:l035","ordinal":135955,"en":"“To Kara Khan's city"},{"id":"semetey-1-2013:p0770:b004:l036","ordinal":135956,"en":"You fled, you orphan slave;"},{"id":"semetey-1-2013:p0770:b004:l037","ordinal":135957,"en":"To Temir Khan's city"},{"id":"semetey-1-2013:p0770:b004:l038","ordinal":135958,"en":"You wandered, you orphan slave;"},{"id":"semetey-1-2013:p0770:b004:l039","ordinal":135959,"en":"This slave whom Manas left—"},{"id":"semetey-1-2013:p0771:b003:l001","ordinal":135960,"en":"Look at what he is saying."},{"id":"semetey-1-2013:p0771:b003:l002","ordinal":135961,"en":"His mother is a mare, a great bitch;"},{"id":"semetey-1-2013:p0771:b003:l003","ordinal":135962,"en":"As a wife she ruined a people,"},{"id":"semetey-1-2013:p0771:b003:l004","ordinal":135963,"en":"And when his mother was a maiden,"},{"id":"semetey-1-2013:p0771:b003:l005","ordinal":135964,"en":"She shook nations and wrecked a land."},{"id":"semetey-1-2013:p0771:b003:l006","ordinal":135965,"en":"His mother fled away;"},{"id":"semetey-1-2013:p0771:b003:l007","ordinal":135966,"en":"She grew among foolish, witless people,"},{"id":"semetey-1-2013:p0771:b003:l008","ordinal":135967,"en":"Grew in a land of donkey-riders,"},{"id":"semetey-1-2013:p0771:b003:l009","ordinal":135968,"en":"Grew in a grave without a door."},{"id":"semetey-1-2013:p0771:b003:l010","ordinal":135969,"en":"Of that fool Manas,"},{"id":"semetey-1-2013:p0771:b003:l011","ordinal":135970,"en":"The orphan who wandered in flight,"},{"id":"semetey-1-2013:p0771:b003:l012","ordinal":135971,"en":"The damned mad slave,"},{"id":"semetey-1-2013:p0771:b003:l013","ordinal":135972,"en":"Fled and grew up in another land,"},{"id":"semetey-1-2013:p0771:b003:l014","ordinal":135973,"en":"Grew among people ignorant of custom."},{"id":"semetey-1-2013:p0771:b003:l015","ordinal":135974,"en":"Saying, ‘Much gold was left to me,’"},{"id":"semetey-1-2013:p0771:b003:l016","ordinal":135975,"en":"This damned orphan—"},{"id":"semetey-1-2013:p0771:b003:l017","ordinal":135976,"en":"Look at what he is doing!"},{"id":"semetey-1-2013:p0771:b003:l018","ordinal":135977,"en":"This orphan who has come raging,"},{"id":"semetey-1-2013:p0771:b003:l019","ordinal":135978,"en":"I shall offer as a sacrifice;"},{"id":"semetey-1-2013:p0771:b003:l020","ordinal":135979,"en":"This mad offspring of Manas,"},{"id":"semetey-1-2013:p0771:b003:l021","ordinal":135980,"en":"I shall offer as a sacrifice."},{"id":"semetey-1-2013:p0771:b003:l022","ordinal":135981,"en":"Having him buried while still unripe,"},{"id":"semetey-1-2013:p0771:b003:l023","ordinal":135982,"en":"I shall bury him now!”"},{"id":"semetey-1-2013:p0771:b003:l024","ordinal":135983,"en":"Roaring, Kobosh worked himself up,"},{"id":"semetey-1-2013:p0771:b003:l025","ordinal":135984,"en":"Speaking like this,"},{"id":"semetey-1-2013:p0771:b003:l026","ordinal":135985,"en":"Almambet's Zhoykuma"},{"id":"semetey-1-2013:p0771:b003:l027","ordinal":135986,"en":"He took into his hand."},{"id":"semetey-1-2013:p0771:b003:l028","ordinal":135987,"en":"Now God had struck Kobosh,"},{"id":"semetey-1-2013:p0771:b003:l029","ordinal":135988,"en":"Now God had struck him hard!"},{"id":"semetey-1-2013:p0771:b003:l030","ordinal":135989,"en":"Taking the sword and shouting,"},{"id":"semetey-1-2013:p0771:b003:l031","ordinal":135990,"en":"Raising the battle cry, “Kobosh!”"},{"id":"semetey-1-2013:p0771:b003:l032","ordinal":135991,"en":"He lumbered down from his throne;"},{"id":"semetey-1-2013:p0771:b003:l033","ordinal":135992,"en":"That wretch Kobosh came shambling."},{"id":"semetey-1-2013:p0771:b003:l034","ordinal":135993,"en":"When Kobosh came near,"},{"id":"semetey-1-2013:p0771:b003:l035","ordinal":135994,"en":"These were the child's words:"},{"id":"semetey-1-2013:p0771:b003:l036","ordinal":135995,"en":"“Wicked Kobosh, hear my words!"},{"id":"semetey-1-2013:p0771:b003:l037","ordinal":135996,"en":"Did I flee in pursuit of your kulan?"},{"id":"semetey-1-2013:p0771:b003:l038","ordinal":135997,"en":"Did I scatter your goods in the saddlebag?"},{"id":"semetey-1-2013:p0771:b003:l039","ordinal":135998,"en":"Did I steal away your piebald horse?"},{"id":"semetey-1-2013:p0771:b005:l001","ordinal":135999,"en":"You run about bellowing—"},{"id":"semetey-1-2013:p0771:b005:l002","ordinal":136000,"en":"Did I scatter your gold?"},{"id":"semetey-1-2013:p0771:b005:l003","ordinal":136001,"en":"The great wealth you will not give when asked,"},{"id":"semetey-1-2013:p0771:b005:l004","ordinal":136002,"en":"Now I shall seize by force;"},{"id":"semetey-1-2013:p0771:b005:l005","ordinal":136003,"en":"The treasury you refuse when asked,"},{"id":"semetey-1-2013:p0771:b005:l006","ordinal":136004,"en":"I shall take from you."},{"id":"semetey-1-2013:p0771:b005:l007","ordinal":136005,"en":"Is a quarrel what you want?"},{"id":"semetey-1-2013:p0771:b005:l008","ordinal":136006,"en":"Now I shall wreak slaughter."},{"id":"semetey-1-2013:p0771:b005:l009","ordinal":136007,"en":"My mother Kanykey went away in grief;"},{"id":"semetey-1-2013:p0771:b005:l010","ordinal":136008,"en":"This is how I shall take revenge on you!”"},{"id":"semetey-1-2013:p0771:b005:l011","ordinal":136009,"en":"When Kobosh came near,"},{"id":"semetey-1-2013:p0771:b005:l012","ordinal":136010,"en":"Manas's son, that splendid hero,"},{"id":"semetey-1-2013:p0771:b005:l013","ordinal":136011,"en":"Struck him square upon the jaw,"},{"id":"semetey-1-2013:p0771:b005:l014","ordinal":136012,"en":"Punched him on the other cheek."},{"id":"semetey-1-2013:p0771:b005:l015","ordinal":136013,"en":"Than his father, wolf-maned Manas,"},{"id":"semetey-1-2013:p0771:b005:l016","ordinal":136014,"en":"Your orphan had been born greater."},{"id":"semetey-1-2013:p0771:b005:l017","ordinal":136015,"en":"What could poor Kobosh do?"},{"id":"semetey-1-2013:p0771:b005:l018","ordinal":136016,"en":"When the fist struck his cheek,"},{"id":"semetey-1-2013:p0771:b005:l019","ordinal":136017,"en":"His eyes went darting wildly,"},{"id":"semetey-1-2013:p0771:b005:l020","ordinal":136018,"en":"His senses reeled away."},{"id":"semetey-1-2013:p0771:b005:l021","ordinal":136019,"en":"What could your wretched uncle do?"},{"id":"semetey-1-2013:p0771:b005:l022","ordinal":136020,"en":"His cry reached God;"},{"id":"semetey-1-2013:p0771:b005:l023","ordinal":136021,"en":"He fell, embracing the earth."},{"id":"semetey-1-2013:p0771:b005:l024","ordinal":136022,"en":"Into an opening in the yurt's lattice"},{"id":"semetey-1-2013:p0771:b005:l025","ordinal":136023,"en":"Kobosh's head was thrust."},{"id":"semetey-1-2013:p0771:b005:l026","ordinal":136024,"en":"Before he could pull his head free,"},{"id":"semetey-1-2013:p0771:b005:l027","ordinal":136025,"en":"Before he could regain his senses,"},{"id":"semetey-1-2013:p0771:b005:l028","ordinal":136026,"en":"He struck him in the side with a kick;"},{"id":"semetey-1-2013:p0771:b005:l029","ordinal":136027,"en":"Black blood flowed from his mouth,"},{"id":"semetey-1-2013:p0771:b005:l030","ordinal":136028,"en":"Yellow bile flowed from his rear."},{"id":"semetey-1-2013:p0771:b005:l031","ordinal":136029,"en":"Then his uncle, Abyke—"},{"id":"semetey-1-2013:p0771:b005:l032","ordinal":136030,"en":"Look at their wickedness!"},{"id":"semetey-1-2013:p0771:b005:l033","ordinal":136031,"en":"Muttering and working himself up,"},{"id":"semetey-1-2013:p0771:b005:l034","ordinal":136032,"en":"Speaking where Semetey could not hear,"},{"id":"semetey-1-2013:p0771:b005:l035","ordinal":136033,"en":"To foolish Kobosh"},{"id":"semetey-1-2013:p0771:b005:l036","ordinal":136034,"en":"He looked ready to lend support;"},{"id":"semetey-1-2013:p0771:b005:l037","ordinal":136035,"en":"His wineskin-like face grew red,"},{"id":"semetey-1-2013:p0771:b005:l038","ordinal":136036,"en":"Her apple-round neck stretched,"},{"id":"semetey-1-2013:p0771:b005:l039","ordinal":136037,"en":"Rising, rising again,"},{"id":"semetey-1-2013:p0772:b003:l001","ordinal":136038,"en":"As he was about to rise,"},{"id":"semetey-1-2013:p0772:b003:l002","ordinal":136039,"en":"About to lay hands on the child,"},{"id":"semetey-1-2013:p0772:b003:l003","ordinal":136040,"en":"That fearsome madman Kobosh"},{"id":"semetey-1-2013:p0772:b003:l004","ordinal":136041,"en":"Had not a glimmer of sense left."},{"id":"semetey-1-2013:p0772:b003:l005","ordinal":136042,"en":"Your champion Bakai held fast,"},{"id":"semetey-1-2013:p0772:b003:l006","ordinal":136043,"en":"Not letting Abyke stand,"},{"id":"semetey-1-2013:p0772:b003:l007","ordinal":136044,"en":"And spoke these precious words:"},{"id":"semetey-1-2013:p0772:b003:l008","ordinal":136045,"en":"“Ah, dear Abyke, ah, dear one,"},{"id":"semetey-1-2013:p0772:b003:l009","ordinal":136046,"en":"These fighting kinsmen will make peace."},{"id":"semetey-1-2013:p0772:b003:l010","ordinal":136047,"en":"If your orphan takes offense,"},{"id":"semetey-1-2013:p0772:b003:l011","ordinal":136048,"en":"What will they say tomorrow?"},{"id":"semetey-1-2013:p0772:b003:l012","ordinal":136049,"en":"Dear Abyke, be patient;"},{"id":"semetey-1-2013:p0772:b003:l013","ordinal":136050,"en":"At patience's end lies yellow gold."},{"id":"semetey-1-2013:p0772:b003:l014","ordinal":136051,"en":"If you are patient, you will prosper;"},{"id":"semetey-1-2013:p0772:b003:l015","ordinal":136052,"en":"If you are impatient, you will come to ruin!"},{"id":"semetey-1-2013:p0772:b003:l016","ordinal":136053,"en":"Take care, Abyke:"},{"id":"semetey-1-2013:p0772:b003:l017","ordinal":136054,"en":"If you side with Kobosh,"},{"id":"semetey-1-2013:p0772:b003:l018","ordinal":136055,"en":"And I side with the child,"},{"id":"semetey-1-2013:p0772:b003:l019","ordinal":136056,"en":"How can regret be dispelled,"},{"id":"semetey-1-2013:p0772:b003:l020","ordinal":136057,"en":"How could our shame be covered?"},{"id":"semetey-1-2013:p0772:b003:l021","ordinal":136058,"en":"If we fail to restrain ourselves,"},{"id":"semetey-1-2013:p0772:b003:l022","ordinal":136059,"en":"If we set to beating one another,"},{"id":"semetey-1-2013:p0772:b003:l023","ordinal":136060,"en":"If we come to see hell,"},{"id":"semetey-1-2013:p0772:b003:l024","ordinal":136061,"en":"Dust surges from a whirlwind,"},{"id":"semetey-1-2013:p0772:b003:l025","ordinal":136062,"en":"Black blood flows from a quarrel,"},{"id":"semetey-1-2013:p0772:b003:l026","ordinal":136063,"en":"And where blood goes, life goes."},{"id":"semetey-1-2013:p0772:b003:l027","ordinal":136064,"en":"If we commit such wickedness,"},{"id":"semetey-1-2013:p0772:b003:l028","ordinal":136065,"en":"Dear Abyke, what happens afterward?"},{"id":"semetey-1-2013:p0772:b003:l029","ordinal":136066,"en":"How can regret be dispelled,"},{"id":"semetey-1-2013:p0772:b003:l030","ordinal":136067,"en":"Where can kinsmen be found?"},{"id":"semetey-1-2013:p0772:b003:l031","ordinal":136068,"en":"Our ruddy faces will be soot,"},{"id":"semetey-1-2013:p0772:b003:l032","ordinal":136069,"en":"These damned buttocks will be bared."},{"id":"semetey-1-2013:p0772:b003:l033","ordinal":136070,"en":"Kokcholok, whom I ride on patrol—"},{"id":"semetey-1-2013:p0772:b003:l034","ordinal":136071,"en":"Though old, I still have my mount."},{"id":"semetey-1-2013:p0772:b003:l035","ordinal":136072,"en":"However far gone I may be,"},{"id":"semetey-1-2013:p0772:b003:l036","ordinal":136073,"en":"I still have strength to match yours."},{"id":"semetey-1-2013:p0772:b003:l037","ordinal":136074,"en":"Dear Abyke, take care:"},{"id":"semetey-1-2013:p0772:b003:l038","ordinal":136075,"en":"If drawn forth with a sideways pull,"},{"id":"semetey-1-2013:p0772:b003:l039","ordinal":136076,"en":"The sword will blaze with heat"},{"id":"semetey-1-2013:p0772:b004:l001","ordinal":136077,"en":"If we fight, splattered red,"},{"id":"semetey-1-2013:p0772:b004:l002","ordinal":136078,"en":"Terrible is the harm of battle.”"},{"id":"semetey-1-2013:p0772:b004:l003","ordinal":136079,"en":"Pleading with Abyke,"},{"id":"semetey-1-2013:p0772:b004:l004","ordinal":136080,"en":"Bakai Khan held him back;"},{"id":"semetey-1-2013:p0772:b004:l005","ordinal":136081,"en":"His eyes reddened like fire,"},{"id":"semetey-1-2013:p0772:b004:l006","ordinal":136082,"en":"Bakai Khan stood blazing."},{"id":"semetey-1-2013:p0772:b004:l007","ordinal":136083,"en":"If you ask about Kobosh,"},{"id":"semetey-1-2013:p0772:b004:l008","ordinal":136084,"en":"He lost consciousness and sprawled,"},{"id":"semetey-1-2013:p0772:b004:l009","ordinal":136085,"en":"Lay limp like a dead man."},{"id":"semetey-1-2013:p0772:b004:l010","ordinal":136086,"en":"Like one gone to Judgment Day,"},{"id":"semetey-1-2013:p0772:b004:l011","ordinal":136087,"en":"If you saw the damned wretch's face,"},{"id":"semetey-1-2013:p0772:b004:l012","ordinal":136088,"en":"The weapon's handle had left his hand,"},{"id":"semetey-1-2013:p0772:b004:l013","ordinal":136089,"en":"The covering had left his heart."},{"id":"semetey-1-2013:p0772:b004:l014","ordinal":136090,"en":"His vigor fled, his strength was gone;"},{"id":"semetey-1-2013:p0772:b004:l015","ordinal":136091,"en":"Black blood flowed from his chest."},{"id":"semetey-1-2013:p0772:b004:l016","ordinal":136092,"en":"His closed eyes would not open,"},{"id":"semetey-1-2013:p0772:b004:l017","ordinal":136093,"en":"His outstretched leg would not draw back,"},{"id":"semetey-1-2013:p0772:b004:l018","ordinal":136094,"en":"The blood from his chest would not stop."},{"id":"semetey-1-2013:p0772:b004:l019","ordinal":136095,"en":"Kobosh lay sprawled there,"},{"id":"semetey-1-2013:p0772:b004:l020","ordinal":136096,"en":"For a meat-boiling's time, without recovering."},{"id":"semetey-1-2013:p0772:b004:l021","ordinal":136097,"en":"A grievous affliction had struck Kobosh;"},{"id":"semetey-1-2013:p0772:b004:l022","ordinal":136098,"en":"Like one about to meet Judgment Day,"},{"id":"semetey-1-2013:p0772:b004:l023","ordinal":136099,"en":"His wispy mustache drooped."},{"id":"semetey-1-2013:p0772:b004:l024","ordinal":136100,"en":"When mighty Manas died,"},{"id":"semetey-1-2013:p0772:b004:l025","ordinal":136101,"en":"When the dogs divided the spoils,"},{"id":"semetey-1-2013:p0772:b004:l026","ordinal":136102,"en":"Akkelte was taken as plunder;"},{"id":"semetey-1-2013:p0772:b004:l027","ordinal":136103,"en":"Its defect was known."},{"id":"semetey-1-2013:p0772:b004:l028","ordinal":136104,"en":"Of your mountain-like uncle Kobosh,"},{"id":"semetey-1-2013:p0772:b004:l029","ordinal":136105,"en":"Hanging on the moon."},{"id":"semetey-1-2013:p0772:b004:l030","ordinal":136106,"en":"Khan Manas's Akkelte—"},{"id":"semetey-1-2013:p0772:b004:l031","ordinal":136107,"en":"When the child unleashed his wrath,"},{"id":"semetey-1-2013:p0772:b004:l032","ordinal":136108,"en":"When Kobosh and this child"},{"id":"semetey-1-2013:p0772:b004:l033","ordinal":136109,"en":"Set to pummeling one another,"},{"id":"semetey-1-2013:p0772:b004:l034","ordinal":136110,"en":"And made a spectacle before the crowd,"},{"id":"semetey-1-2013:p0772:b004:l035","ordinal":136111,"en":"The keen Kelte left by Manas,"},{"id":"semetey-1-2013:p0772:b004:l036","ordinal":136112,"en":"Whose keenness the people had tested,"},{"id":"semetey-1-2013:p0772:b004:l037","ordinal":136113,"en":"The support Manas had left,"},{"id":"semetey-1-2013:p0772:b004:l038","ordinal":136114,"en":"Kicked against the yurt's lattice,"},{"id":"semetey-1-2013:p0772:b004:l039","ordinal":136115,"en":"And banged away all by itself,"},{"id":"semetey-1-2013:p0773:b003:l001","ordinal":136116,"en":"It boomed all by itself."},{"id":"semetey-1-2013:p0773:b003:l002","ordinal":136117,"en":"If an evil day comes and blood flows,"},{"id":"semetey-1-2013:p0773:b003:l003","ordinal":136118,"en":"It roared all by itself,"},{"id":"semetey-1-2013:p0773:b003:l004","ordinal":136119,"en":"It thundered all by itself."},{"id":"semetey-1-2013:p0773:b003:l005","ordinal":136120,"en":"If you ask of Akkelte's state,"},{"id":"semetey-1-2013:p0773:b003:l006","ordinal":136121,"en":"It worked itself up,"},{"id":"semetey-1-2013:p0773:b003:l007","ordinal":136122,"en":"It changed its aspect by itself."},{"id":"semetey-1-2013:p0773:b003:l008","ordinal":136123,"en":"Now he saw Akkelte;"},{"id":"semetey-1-2013:p0773:b003:l009","ordinal":136124,"en":"Your orphan left by Manas,"},{"id":"semetey-1-2013:p0773:b003:l010","ordinal":136125,"en":"Recognizing Kelte,"},{"id":"semetey-1-2013:p0773:b003:l011","ordinal":136126,"en":"Hung it over his shoulder-blade."},{"id":"semetey-1-2013:p0773:b003:l012","ordinal":136127,"en":"Into the wealth denied when asked for"},{"id":"semetey-1-2013:p0773:b003:l013","ordinal":136128,"en":"He now entered by force."},{"id":"semetey-1-2013:p0773:b003:l014","ordinal":136129,"en":"Looking toward the yurt's side,"},{"id":"semetey-1-2013:p0773:b003:l015","ordinal":136130,"en":"Khan Manas's Syrnayza,"},{"id":"semetey-1-2013:p0773:b003:l016","ordinal":136131,"en":"Drenched in black blood,"},{"id":"semetey-1-2013:p0773:b003:l017","ordinal":136132,"en":"Its grip of golden gemstone—"},{"id":"semetey-1-2013:p0773:b003:l018","ordinal":136133,"en":"He had diverse woods turned,"},{"id":"semetey-1-2013:p0773:b003:l019","ordinal":136134,"en":"Had them glued with copper mixed in,"},{"id":"semetey-1-2013:p0773:b003:l020","ordinal":136135,"en":"Made so they could not come apart."},{"id":"semetey-1-2013:p0773:b003:l021","ordinal":136136,"en":"He had it fashioned joint by joint;"},{"id":"semetey-1-2013:p0773:b003:l022","ordinal":136137,"en":"Lest it slip from the hand,"},{"id":"semetey-1-2013:p0773:b003:l023","ordinal":136138,"en":"He had it covered in elephant hide."},{"id":"semetey-1-2013:p0773:b003:l024","ordinal":136139,"en":"A handspan he had painted,"},{"id":"semetey-1-2013:p0773:b003:l025","ordinal":136140,"en":"A handspan he had pared."},{"id":"semetey-1-2013:p0773:b003:l026","ordinal":136141,"en":"Its steel point, a wolf's tongue,"},{"id":"semetey-1-2013:p0773:b003:l027","ordinal":136142,"en":"Would not turn back from stone;"},{"id":"semetey-1-2013:p0773:b003:l028","ordinal":136143,"en":"He had it fitted from white steel,"},{"id":"semetey-1-2013:p0773:b003:l029","ordinal":136144,"en":"Felling the enemy it fought."},{"id":"semetey-1-2013:p0773:b003:l030","ordinal":136145,"en":"The lame smith Bolokbay"},{"id":"semetey-1-2013:p0773:b003:l031","ordinal":136146,"en":"Was a friend of David:"},{"id":"semetey-1-2013:p0773:b003:l032","ordinal":136147,"en":"“May all whom it strikes"},{"id":"semetey-1-2013:p0773:b003:l033","ordinal":136148,"en":"Sicken grievously and die,” he said,"},{"id":"semetey-1-2013:p0773:b003:l034","ordinal":136149,"en":"And quenched it with human tears."},{"id":"semetey-1-2013:p0773:b003:l036","ordinal":136150,"en":"The mighty smith Bolokbay"},{"id":"semetey-1-2013:p0773:b003:l037","ordinal":136151,"en":"Drew out all its iron,"},{"id":"semetey-1-2013:p0773:b003:l038","ordinal":136152,"en":"Pounding it with his sledgehammer."},{"id":"semetey-1-2013:p0773:b003:l039","ordinal":136153,"en":"Unable to meet its need for charcoal,"},{"id":"semetey-1-2013:p0773:b004:l001","ordinal":136154,"en":"The edge of the forest was hollowed away."},{"id":"semetey-1-2013:p0773:b004:l002","ordinal":136155,"en":"Unable to meet its need for bellows,"},{"id":"semetey-1-2013:p0773:b004:l003","ordinal":136156,"en":"Many young bulls were slaughtered."},{"id":"semetey-1-2013:p0773:b004:l004","ordinal":136157,"en":"“A gift my father left,” he said,"},{"id":"semetey-1-2013:p0773:b004:l005","ordinal":136158,"en":"And Semetey took that too."},{"id":"semetey-1-2013:p0773:b004:l006","ordinal":136159,"en":"“If I live and do not die,"},{"id":"semetey-1-2013:p0773:b004:l007","ordinal":136160,"en":"I shall shout and thrust my lance,” he said."},{"id":"semetey-1-2013:p0773:b004:l008","ordinal":136161,"en":"“I shall give many a spectacle,” he said."},{"id":"semetey-1-2013:p0773:b004:l009","ordinal":136162,"en":"“I shall smash them and take revenge,” he said."},{"id":"semetey-1-2013:p0773:b004:l010","ordinal":136163,"en":"Semetey took Syrnayza;"},{"id":"semetey-1-2013:p0773:b004:l011","ordinal":136164,"en":"And he had more to say:"},{"id":"semetey-1-2013:p0773:b004:l012","ordinal":136165,"en":"“The six keen blades fallen from heaven,"},{"id":"semetey-1-2013:p0773:b004:l013","ordinal":136166,"en":"The perfect treasure given by Allah,"},{"id":"semetey-1-2013:p0773:b004:l014","ordinal":136167,"en":"Which devastated the land of the Chinese—"},{"id":"semetey-1-2013:p0773:b004:l015","ordinal":136168,"en":"If an eager enemy had come,"},{"id":"semetey-1-2013:p0773:b004:l016","ordinal":136169,"en":"Born in the hot desert."},{"id":"semetey-1-2013:p0773:b004:l017","ordinal":136170,"en":"Never catching as they were swung,"},{"id":"semetey-1-2013:p0773:b004:l018","ordinal":136171,"en":"When swung against the foe,"},{"id":"semetey-1-2013:p0773:b004:l019","ordinal":136172,"en":"Their keenness killed."},{"id":"semetey-1-2013:p0773:b004:l020","ordinal":136173,"en":"Unless they had drunk their fill of blood,"},{"id":"semetey-1-2013:p0773:b004:l021","ordinal":136174,"en":"They would not enter their sheaths when put away."},{"id":"semetey-1-2013:p0773:b004:l022","ordinal":136175,"en":"Unless they had seen a mighty slaughter,"},{"id":"semetey-1-2013:p0773:b004:l023","ordinal":136176,"en":"They would not look back and go idle."},{"id":"semetey-1-2013:p0773:b004:l024","ordinal":136177,"en":"Those six heavenly blades,"},{"id":"semetey-1-2013:p0773:b004:l025","ordinal":136178,"en":"This witless dog Kobosh"},{"id":"semetey-1-2013:p0773:b004:l026","ordinal":136179,"en":"Has taken as plunder."},{"id":"semetey-1-2013:p0773:b004:l027","ordinal":136180,"en":"Without living by fighting enemies,"},{"id":"semetey-1-2013:p0773:b004:l028","ordinal":136181,"en":"This swine of wicked ways,"},{"id":"semetey-1-2013:p0773:b004:l029","ordinal":136182,"en":"Without dividing them among the companions,"},{"id":"semetey-1-2013:p0773:b004:l030","ordinal":136183,"en":"Has gathered and taken them all."},{"id":"semetey-1-2013:p0773:b004:l031","ordinal":136184,"en":"Boz Kise and Akolpok—"},{"id":"semetey-1-2013:p0773:b004:l032","ordinal":136185,"en":"Gathering everything together,"},{"id":"semetey-1-2013:p0773:b004:l033","ordinal":136186,"en":"He tied them in Akolpok."},{"id":"semetey-1-2013:p0773:b004:l034","ordinal":136187,"en":"At the bottom of a great saddlebag,"},{"id":"semetey-1-2013:p0773:b004:l035","ordinal":136188,"en":"About to finish him off,"},{"id":"semetey-1-2013:p0773:b004:l036","ordinal":136189,"en":"He gathered and put them all."},{"id":"semetey-1-2013:p0773:b004:l037","ordinal":136190,"en":"Your stepmother Akylay—"},{"id":"semetey-1-2013:p0773:b004:l038","ordinal":136191,"en":"Had already been slaughtered"},{"id":"semetey-1-2013:p0773:b004:l039","ordinal":136192,"en":"Gathering up the great saddlebag,"}]
