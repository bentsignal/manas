[{"id":"seytek-2012:p0407:b002:l010","ordinal":324609,"en":"Who knew custom and governed the people,"},{"id":"seytek-2012:p0407:b002:l011","ordinal":324610,"en":"When in the palace built at Talas"},{"id":"seytek-2012:p0407:b002:l012","ordinal":324611,"en":"She became mother to the whole world,"},{"id":"seytek-2012:p0407:b002:l013","ordinal":324612,"en":"There was no person as mighty as she."},{"id":"seytek-2012:p0407:b002:l014","ordinal":324613,"en":"Your precious, fierce mother"},{"id":"seytek-2012:p0407:b002:l015","ordinal":324614,"en":"Would leave no necessary deed undone."},{"id":"seytek-2012:p0407:b002:l016","ordinal":324615,"en":"Her dear kinsman Bölökbay—"},{"id":"seytek-2012:p0407:b002:l017","ordinal":324616,"en":"For the master smith Bölökbay himself,"},{"id":"seytek-2012:p0407:b002:l018","ordinal":324617,"en":"For the black eyes of the smith David,"},{"id":"seytek-2012:p0407:b002:l019","ordinal":324618,"en":"She poured spirits and offered butter,"},{"id":"seytek-2012:p0407:b002:l020","ordinal":324619,"en":"Serving him and submitting,"},{"id":"seytek-2012:p0407:b002:l021","ordinal":324620,"en":"Pleading with the smith David."},{"id":"seytek-2012:p0407:b002:l022","ordinal":324621,"en":"She had racehorses tethered to the line,"},{"id":"seytek-2012:p0407:b002:l023","ordinal":324622,"en":"Six thousand gelded camels and eighty breeding camels—"},{"id":"seytek-2012:p0407:b002:l024","ordinal":324623,"en":"All these she had given"},{"id":"seytek-2012:p0407:b002:l025","ordinal":324624,"en":"As payment to master Bölökbay."},{"id":"seytek-2012:p0407:b002:l026","ordinal":324625,"en":"“Make it like Jangkol’s,” she said,"},{"id":"seytek-2012:p0407:b002:l027","ordinal":324626,"en":"Pouring out her wealth in supplication;"},{"id":"seytek-2012:p0407:b002:l028","ordinal":324627,"en":"“My dear kinsman,” she cried, wringing her hands,"},{"id":"seytek-2012:p0407:b002:l029","ordinal":324628,"en":"And pleaded with Bölökbay."},{"id":"seytek-2012:p0407:b002:l030","ordinal":324629,"en":"He understood her service;"},{"id":"seytek-2012:p0407:b002:l031","ordinal":324630,"en":"The noble master smith Bölökbay"},{"id":"seytek-2012:p0407:b002:l032","ordinal":324631,"en":"Obeyed Kanykey."},{"id":"seytek-2012:p0407:b002:l033","ordinal":324632,"en":"“My child, dear kinswoman, I shall agree;"},{"id":"seytek-2012:p0407:b002:l034","ordinal":324633,"en":"From generation to generation,"},{"id":"seytek-2012:p0407:b002:l035","ordinal":324634,"en":"Your descendants shall carry it as a gift,"},{"id":"seytek-2012:p0407:b002:l036","ordinal":324635,"en":"And smile whenever they behold it."},{"id":"seytek-2012:p0407:b002:l037","ordinal":324636,"en":"They shall value and understand"},{"id":"seytek-2012:p0407:b002:l038","ordinal":324637,"en":"The worth of the object made by David;"},{"id":"seytek-2012:p0407:b002:l039","ordinal":324638,"en":"When it strikes a grief-stricken, aching heart,"},{"id":"seytek-2012:p0407:b002:l040","ordinal":324639,"en":"It shall split it into two."},{"id":"seytek-2012:p0407:b003:l001","ordinal":324640,"en":"Can this wrathful pig of old"},{"id":"seytek-2012:p0407:b003:l002","ordinal":324641,"en":"Become your brother if you shelter him?"},{"id":"seytek-2012:p0407:b003:l003","ordinal":324642,"en":"Is it right to call the roaring wretch"},{"id":"seytek-2012:p0407:b003:l004","ordinal":324643,"en":"Your brother?"},{"id":"seytek-2012:p0407:b003:l005","ordinal":324644,"en":"He made us slaves with blood-red backsides,"},{"id":"seytek-2012:p0407:b003:l006","ordinal":324645,"en":"Burned multitudes and made them booty,"},{"id":"seytek-2012:p0407:b003:l007","ordinal":324646,"en":"Showing his enmity openly;"},{"id":"seytek-2012:p0407:b003:l008","ordinal":324647,"en":"You burned us outright and set us aflame."},{"id":"seytek-2012:p0407:b003:l009","ordinal":324648,"en":"He made us claw our faces bloody,"},{"id":"seytek-2012:p0407:b003:l010","ordinal":324649,"en":"And let down our black hair in mourning;"},{"id":"seytek-2012:p0407:b003:l011","ordinal":324650,"en":"He let the Jediger ride"},{"id":"seytek-2012:p0407:b003:l012","ordinal":324651,"en":"Kambar-Ata’s gray stallion,"},{"id":"seytek-2012:p0407:b003:l013","ordinal":324652,"en":"And placed the khan’s treasury and palace"},{"id":"seytek-2012:p0407:b003:l014","ordinal":324653,"en":"Under Kanchoro’s command."},{"id":"seytek-2012:p0407:b003:l015","ordinal":324654,"en":"Rather than stand watching without revenge,"},{"id":"seytek-2012:p0407:b003:l016","ordinal":324655,"en":"Rather than commit this deed,"},{"id":"seytek-2012:p0407:b003:l017","ordinal":324656,"en":"Let us sink down, never having been born;"},{"id":"seytek-2012:p0407:b003:l018","ordinal":324657,"en":"Death is better than life—"},{"id":"seytek-2012:p0407:b003:l019","ordinal":324658,"en":"Better that we die!"},{"id":"seytek-2012:p0407:b003:l020","ordinal":324659,"en":"Having blunted our blades,"},{"id":"seytek-2012:p0407:b003:l021","ordinal":324660,"en":"And destroyed our worthy heroes,"},{"id":"seytek-2012:p0407:b003:l022","ordinal":324661,"en":"What shall we gain by making"},{"id":"seytek-2012:p0407:b003:l023","ordinal":324662,"en":"That brazen pig our brother?"},{"id":"seytek-2012:p0407:b003:l024","ordinal":324663,"en":"Let us cut off this mane by the handful"},{"id":"seytek-2012:p0407:b003:l025","ordinal":324664,"en":"And perish in the slaughter!”"},{"id":"seytek-2012:p0407:b003:l026","ordinal":324665,"en":"So saying, Aichürök"},{"id":"seytek-2012:p0407:b003:l027","ordinal":324666,"en":"Stiffened in fury;"},{"id":"seytek-2012:p0407:b003:l028","ordinal":324667,"en":"Her eyes blazed with fire,"},{"id":"seytek-2012:p0407:b003:l029","ordinal":324668,"en":"And her white teeth, gleaming like crystal,"},{"id":"seytek-2012:p0407:b003:l030","ordinal":324669,"en":"She ground one against another."},{"id":"seytek-2012:p0407:b003:l031","ordinal":324670,"en":"When she hissed like a dragon,"},{"id":"seytek-2012:p0407:b003:l032","ordinal":324671,"en":"What living soul could restrain her?"},{"id":"seytek-2012:p0407:b003:l033","ordinal":324672,"en":"Kanchoro upon the throne"},{"id":"seytek-2012:p0407:b003:l034","ordinal":324673,"en":"Leapt like a hunting eagle."},{"id":"seytek-2012:p0407:b003:l035","ordinal":324674,"en":"You should have seen your wife Chürök,"},{"id":"seytek-2012:p0407:b003:l036","ordinal":324675,"en":"That flashing, fierce woman—"},{"id":"seytek-2012:p0407:b003:l037","ordinal":324676,"en":"She lunged like a blue tiger."},{"id":"seytek-2012:p0407:b003:l038","ordinal":324677,"en":"From the hell and calamity he had inflicted,"},{"id":"seytek-2012:p0407:b003:l039","ordinal":324678,"en":"From the cup he himself had filled,"},{"id":"seytek-2012:p0407:b003:l040","ordinal":324679,"en":"How could Kanchoro escape?"},{"id":"seytek-2012:p0408:b002:l001","ordinal":324680,"en":"As I prepare to leave this mortal world,"},{"id":"seytek-2012:p0408:b002:l002","ordinal":324681,"en":"I have drawn forth my true blade."},{"id":"seytek-2012:p0408:b002:l003","ordinal":324682,"en":"I tested it by pinching every part,"},{"id":"seytek-2012:p0408:b002:l004","ordinal":324683,"en":"And finding not a flaw as small as a fly,"},{"id":"seytek-2012:p0408:b002:l005","ordinal":324684,"en":"I myself tempered it in earnest."},{"id":"seytek-2012:p0408:b002:l006","ordinal":324685,"en":"All my skill and remaining strength—"},{"id":"seytek-2012:p0408:b002:l007","ordinal":324686,"en":"My child, I spent upon it."},{"id":"seytek-2012:p0408:b002:l008","ordinal":324687,"en":"Then he went away, weeping bitterly."},{"id":"seytek-2012:p0408:b002:l009","ordinal":324688,"en":"From the old man’s eyes"},{"id":"seytek-2012:p0408:b002:l010","ordinal":324689,"en":"Dark blood poured like hail;"},{"id":"seytek-2012:p0408:b002:l011","ordinal":324690,"en":"He screamed and wept aloud,"},{"id":"seytek-2012:p0408:b002:l012","ordinal":324691,"en":"Kissing the hilt and sobbing."},{"id":"seytek-2012:p0408:b002:l013","ordinal":324692,"en":"Long ago, Bölökbay left"},{"id":"seytek-2012:p0408:b002:l014","ordinal":324693,"en":"As an inheritance the white Tintay,"},{"id":"seytek-2012:p0408:b002:l015","ordinal":324694,"en":"With a jeweled pommel and golden hilt,"},{"id":"seytek-2012:p0408:b002:l016","ordinal":324695,"en":"And a golden sheath to hold it."},{"id":"seytek-2012:p0408:b002:l017","ordinal":324696,"en":"He twisted and tested its hilt,"},{"id":"seytek-2012:p0408:b002:l018","ordinal":324697,"en":"Never ceasing to fear"},{"id":"seytek-2012:p0408:b002:l019","ordinal":324698,"en":"That it might slip from the hand."},{"id":"seytek-2012:p0408:b002:l020","ordinal":324699,"en":"He often spoke of its noble form:"},{"id":"seytek-2012:p0408:b002:l021","ordinal":324700,"en":"“I shall draw it against the foe I meet”—"},{"id":"seytek-2012:p0408:b002:l022","ordinal":324701,"en":"Kanykey herself had made this vow."},{"id":"seytek-2012:p0408:b002:l023","ordinal":324702,"en":"When your mother escaped from slavery"},{"id":"seytek-2012:p0408:b002:l024","ordinal":324703,"en":"And God granted her desire,"},{"id":"seytek-2012:p0408:b002:l025","ordinal":324704,"en":"Aichürök, daughter of the peri,"},{"id":"seytek-2012:p0408:b002:l026","ordinal":324705,"en":"Prepared to present Seytek"},{"id":"seytek-2012:p0408:b002:l027","ordinal":324706,"en":"At the rock of Kayypchy,"},{"id":"seytek-2012:p0408:b002:l028","ordinal":324707,"en":"As she had planned from the beginning."},{"id":"seytek-2012:p0408:b002:l029","ordinal":324708,"en":"The white Tintay, willingly bestowed—"},{"id":"seytek-2012:p0408:b002:l030","ordinal":324709,"en":"“Let the children receive it as a gift,"},{"id":"seytek-2012:p0408:b002:l031","ordinal":324710,"en":"So that upon the black-faced enemy"},{"id":"seytek-2012:p0408:b002:l032","ordinal":324711,"en":"They may bring sudden ruin.”"},{"id":"seytek-2012:p0408:b002:l033","ordinal":324712,"en":"The white Tintay given as a gift,"},{"id":"seytek-2012:p0408:b002:l034","ordinal":324713,"en":"For Aichürök, champion among women,"},{"id":"seytek-2012:p0408:b002:l035","ordinal":324714,"en":"To prepare against the wrathful khan,"},{"id":"seytek-2012:p0408:b002:l036","ordinal":324715,"en":"Ready to spill blood;"},{"id":"seytek-2012:p0408:b002:l037","ordinal":324716,"en":"With matchless agility,"},{"id":"seytek-2012:p0408:b002:l038","ordinal":324717,"en":"She ran beyond all reckoning,"},{"id":"seytek-2012:p0408:b002:l039","ordinal":324718,"en":"Bounding and gathering herself like a doe."},{"id":"seytek-2012:p0408:b002:l040","ordinal":324719,"en":"The white Tintay received as a gift—"},{"id":"seytek-2012:p0408:b003:l001","ordinal":324720,"en":"May your enemy behold its fame;"},{"id":"seytek-2012:p0408:b003:l002","ordinal":324721,"en":"May this wondrous blade become"},{"id":"seytek-2012:p0408:b003:l003","ordinal":324722,"en":"A guardian of a precious life."},{"id":"seytek-2012:p0408:b003:l004","ordinal":324723,"en":"If swung with all one’s strength,"},{"id":"seytek-2012:p0408:b003:l005","ordinal":324724,"en":"The foe it truly strikes will surely die..."},{"id":"seytek-2012:p0408:b003:l006","ordinal":324725,"en":"Whoever feels the breath"},{"id":"seytek-2012:p0408:b003:l007","ordinal":324726,"en":"Of its unyielding true temper will know it."},{"id":"seytek-2012:p0408:b003:l008","ordinal":324727,"en":"My precious kinswoman, I shall agree,"},{"id":"seytek-2012:p0408:b003:l009","ordinal":324728,"en":"To take the son of your eldest son,"},{"id":"seytek-2012:p0408:b003:l010","ordinal":324729,"en":"And preserve your battle cry."},{"id":"seytek-2012:p0408:b003:l011","ordinal":324730,"en":"When cataracts veil my darkening eyes,"},{"id":"seytek-2012:p0408:b003:l012","ordinal":324731,"en":"When I have grown old,"},{"id":"seytek-2012:p0408:b003:l013","ordinal":324732,"en":"My swan-white beard turned pale,"},{"id":"seytek-2012:p0408:b003:l014","ordinal":324733,"en":"My raven eyes turned red,"},{"id":"seytek-2012:p0408:b003:l015","ordinal":324734,"en":"My able body worn away,"},{"id":"seytek-2012:p0408:b003:l016","ordinal":324735,"en":"My steel blunted and spent,"},{"id":"seytek-2012:p0408:b003:l017","ordinal":324736,"en":"When I am no longer capable;"},{"id":"seytek-2012:p0408:b003:l018","ordinal":324737,"en":"When I have eaten and drunk my fill,"},{"id":"seytek-2012:p0408:b003:l019","ordinal":324738,"en":"And my kinswoman has given me my shroud,"},{"id":"seytek-2012:p0408:b003:l020","ordinal":324739,"en":"When my time has come to depart;"},{"id":"seytek-2012:p0408:b003:l021","ordinal":324740,"en":"When my breast grows cold and my eyes close,"},{"id":"seytek-2012:p0408:b003:l022","ordinal":324741,"en":"When my time has come to depart;"},{"id":"seytek-2012:p0408:b003:l023","ordinal":324742,"en":"When my fleeting soul leaves"},{"id":"seytek-2012:p0408:b003:l024","ordinal":324743,"en":"This mortal world, my child;"},{"id":"seytek-2012:p0408:b003:l025","ordinal":324744,"en":"When, without looking back on its pleasures,"},{"id":"seytek-2012:p0408:b003:l026","ordinal":324745,"en":"My time has come to depart;"},{"id":"seytek-2012:p0408:b003:l027","ordinal":324746,"en":"I shall obey your request"},{"id":"seytek-2012:p0408:b003:l028","ordinal":324747,"en":"And prepare my final bequest."},{"id":"seytek-2012:p0408:b003:l029","ordinal":324748,"en":"Accept these words entrusted to you,"},{"id":"seytek-2012:p0408:b003:l030","ordinal":324749,"en":"And to Semetey’s gray-maned-wolf son"},{"id":"seytek-2012:p0408:b003:l031","ordinal":324750,"en":"Give it as a gift."},{"id":"seytek-2012:p0408:b003:l032","ordinal":324751,"en":"I honed its edge like a falcon’s claw;"},{"id":"seytek-2012:p0408:b003:l033","ordinal":324752,"en":"So that whoever it touches will not remain unharmed,"},{"id":"seytek-2012:p0408:b003:l034","ordinal":324753,"en":"But be struck down and die,"},{"id":"seytek-2012:p0408:b003:l035","ordinal":324754,"en":"I watered it with the tears"},{"id":"seytek-2012:p0408:b003:l036","ordinal":324755,"en":"Of mortal humankind,"},{"id":"seytek-2012:p0408:b003:l037","ordinal":324756,"en":"And bound it with a ravenous demon’s spell."},{"id":"seytek-2012:p0408:b003:l038","ordinal":324757,"en":"I poisoned its other edge as well."},{"id":"seytek-2012:p0408:b003:l039","ordinal":324758,"en":"For the orphan left behind,"},{"id":"seytek-2012:p0408:b003:l040","ordinal":324759,"en":"I have kept it, that he may receive it."},{"id":"seytek-2012:p0409:b002:l001","ordinal":324760,"en":"This is the place of death."},{"id":"seytek-2012:p0409:b002:l002","ordinal":324761,"en":"Fill it with white ink,"},{"id":"seytek-2012:p0409:b002:l003","ordinal":324762,"en":"A cruel born bloodmaid"},{"id":"seytek-2012:p0409:b002:l004","ordinal":324763,"en":"The one who was kicked,"},{"id":"seytek-2012:p0409:b002:l005","ordinal":324764,"en":"Kanchoro's enemy"},{"id":"seytek-2012:p0409:b002:l006","ordinal":324765,"en":"He was like a sheep."},{"id":"seytek-2012:p0409:b002:l007","ordinal":324766,"en":"He cut off his head like a melon."},{"id":"seytek-2012:p0409:b002:l008","ordinal":324767,"en":"That's when Aichüruk"},{"id":"seytek-2012:p0409:b002:l009","ordinal":324768,"en":"Holding on to the white cloth,"},{"id":"seytek-2012:p0409:b002:l010","ordinal":324769,"en":"Wounded,"},{"id":"seytek-2012:p0409:b002:l011","ordinal":324770,"en":"Black blood from inside"},{"id":"seytek-2012:p0409:b002:l012","ordinal":324771,"en":"These two are Kanykey, Churek,"},{"id":"seytek-2012:p0409:b002:l013","ordinal":324772,"en":"He sipped and sipped."},{"id":"seytek-2012:p0409:b002:l014","ordinal":324773,"en":"He was thirsty"},{"id":"seytek-2012:p0409:b002:l015","ordinal":324774,"en":"Now the eye socket is full,"},{"id":"seytek-2012:p0409:b002:l016","ordinal":324775,"en":"The extinguished fire is burning now,"},{"id":"seytek-2012:p0409:b002:l017","ordinal":324776,"en":"The soul of the dead comes back to life,"},{"id":"seytek-2012:p0409:b002:l018","ordinal":324777,"en":"Continued to be interrupted,"},{"id":"seytek-2012:p0409:b002:l019","ordinal":324778,"en":"Scattered is collected,"},{"id":"seytek-2012:p0409:b002:l020","ordinal":324779,"en":"The burning pain subsided,"},{"id":"seytek-2