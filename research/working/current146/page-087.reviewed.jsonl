{"id": "sayakbay-ms-current146:pdf087:l021", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 87, "folio": 470, "line_in_page": 21, "raw": "Жер ортосу Боздөңгүл,", "text": "Жер ортосу Боздөңгүл,", "en": "At the center of the land was Bozdöngül,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
