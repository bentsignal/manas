[{"id":"seytek-2012:p0981:b002:l013","ordinal":372225,"en":"And grind it to dust."},{"id":"seytek-2012:p0981:b002:l014","ordinal":372226,"en":"Sarybay raged;"},{"id":"seytek-2012:p0981:b002:l015","ordinal":372227,"en":"Such was the course of the fight."},{"id":"seytek-2012:p0981:b002:l016","ordinal":372228,"en":"The eighteen thousand worlds"},{"id":"seytek-2012:p0981:b002:l017","ordinal":372229,"en":"He seemed able to lay waste,"},{"id":"seytek-2012:p0981:b002:l018","ordinal":372230,"en":"The whole wide universe"},{"id":"seytek-2012:p0981:b002:l019","ordinal":372231,"en":"He seemed ready to destroy."},{"id":"seytek-2012:p0981:b002:l020","ordinal":372232,"en":"Refusing to heed what she said,"},{"id":"seytek-2012:p0981:b002:l021","ordinal":372233,"en":"Without granting the warrior's turn,"},{"id":"seytek-2012:p0981:b002:l022","ordinal":372234,"en":"The black-socketed battleaxe"},{"id":"seytek-2012:p0981:b002:l023","ordinal":372235,"en":"He seized and swung around."},{"id":"seytek-2012:p0981:b002:l024","ordinal":372236,"en":"Before the champion could ready herself,"},{"id":"seytek-2012:p0981:b002:l025","ordinal":372237,"en":"He brought it down with a crash."},{"id":"seytek-2012:p0981:b002:l026","ordinal":372238,"en":"Sarybay's contentious ways"},{"id":"seytek-2012:p0981:b002:l027","ordinal":372239,"en":"She had known for a long time;"},{"id":"seytek-2012:p0981:b002:l028","ordinal":372240,"en":"A deep-blue iron helmet"},{"id":"seytek-2012:p0981:b002:l029","ordinal":372241,"en":"That lion-hearted champion"},{"id":"seytek-2012:p0981:b002:l030","ordinal":372242,"en":"Wore pulled down over her head;"},{"id":"seytek-2012:p0981:b002:l031","ordinal":372243,"en":"Kuyaly was well prepared;"},{"id":"seytek-2012:p0981:b002:l032","ordinal":372244,"en":"Armor along her ribs"},{"id":"seytek-2012:p0981:b002:l033","ordinal":372245,"en":"Her shoulders and heart"},{"id":"seytek-2012:p0981:b002:l034","ordinal":372246,"en":"She had covered as she came;"},{"id":"seytek-2012:p0981:b002:l035","ordinal":372247,"en":"Kuyaly was a mighty champion;"},{"id":"seytek-2012:p0981:b002:l036","ordinal":372248,"en":"For a spear thrust to enter,"},{"id":"seytek-2012:p0981:b002:l037","ordinal":372249,"en":"There was no opening anywhere."},{"id":"seytek-2012:p0981:b002:l038","ordinal":372250,"en":"In taking on Kuyaly,"},{"id":"seytek-2012:p0981:b002:l039","ordinal":372251,"en":"Sarybay had no luck."},{"id":"seytek-2012:p0981:b002:l040","ordinal":372252,"en":"Refusing to heed those words,"},{"id":"seytek-2012:p0981:b003:l001","ordinal":372253,"en":"Without yielding the warrior’s turn,"},{"id":"seytek-2012:p0981:b003:l002","ordinal":372254,"en":"When Sarybay pressed the fight,"},{"id":"seytek-2012:p0981:b003:l003","ordinal":372255,"en":"The renowned lionhearted wrestler girl"},{"id":"seytek-2012:p0981:b003:l004","ordinal":372256,"en":"Kuyaly would not stand by and watch."},{"id":"seytek-2012:p0981:b003:l005","ordinal":372257,"en":"Sarybay, who had grappled with her,"},{"id":"seytek-2012:p0981:b003:l006","ordinal":372258,"en":"Would God look on and smite?"},{"id":"seytek-2012:p0981:b003:l007","ordinal":372259,"en":"God forbid such a sight!"},{"id":"seytek-2012:p0981:b003:l008","ordinal":372260,"en":"He had begun an ugly fight."},{"id":"seytek-2012:p0981:b003:l009","ordinal":372261,"en":"Your hero Kuyaly"},{"id":"seytek-2012:p0981:b003:l010","ordinal":372262,"en":"Cast her life aside."},{"id":"seytek-2012:p0981:b003:l011","ordinal":372263,"en":"They stood face to face,"},{"id":"seytek-2012:p0981:b003:l012","ordinal":372264,"en":"Fighting with heavy blows,"},{"id":"seytek-2012:p0981:b003:l013","ordinal":372265,"en":"Charging and thrusting their spears,"},{"id":"seytek-2012:p0981:b003:l014","ordinal":372266,"en":"Jabbing wherever they could,"},{"id":"seytek-2012:p0981:b003:l015","ordinal":372267,"en":"Grabbing each other by the hems,"},{"id":"seytek-2012:p0981:b003:l016","ordinal":372268,"en":"Struggling to exhaustion,"},{"id":"seytek-2012:p0981:b003:l017","ordinal":372269,"en":"The earth torn into gullies,"},{"id":"seytek-2012:p0981:b003:l018","ordinal":372270,"en":"And human minds reeling."},{"id":"seytek-2012:p0981:b003:l019","ordinal":372271,"en":"The field filled with fluttering banners,"},{"id":"seytek-2012:p0981:b003:l020","ordinal":372272,"en":"A din that split the sky,"},{"id":"seytek-2012:p0981:b003:l021","ordinal":372273,"en":"They faced each other head-on,"},{"id":"seytek-2012:p0981:b003:l022","ordinal":372274,"en":"Firing guns and drawing bows,"},{"id":"seytek-2012:p0981:b003:l023","ordinal":372275,"en":"Clashing in a fierce fight,"},{"id":"seytek-2012:p0981:b003:l024","ordinal":372276,"en":"A mighty battle, plain to see,"},{"id":"seytek-2012:p0981:b003:l025","ordinal":372277,"en":"As its roar went up,"},{"id":"seytek-2012:p0981:b003:l026","ordinal":372278,"en":"The brave souls clashed with a crack,"},{"id":"seytek-2012:p0981:b003:l027","ordinal":372279,"en":"As they fought on,"},{"id":"seytek-2012:p0981:b003:l028","ordinal":372280,"en":"The earth was torn into gullies,"},{"id":"seytek-2012:p0981:b003:l029","ordinal":372281,"en":"And human minds were reeling,"},{"id":"seytek-2012:p0981:b003:l030","ordinal":372282,"en":"Heavy guns thundered and shook the mountains,"},{"id":"seytek-2012:p0981:b003:l031","ordinal":372283,"en":"Men fell, struck by bullets,"},{"id":"seytek-2012:p0981:b003:l032","ordinal":372284,"en":"As the ranks collapsed,"},{"id":"seytek-2012:p0981:b003:l033","ordinal":372285,"en":"What a fierce struggle this had become!"},{"id":"seytek-2012:p0981:b003:l034","ordinal":372286,"en":"They waged a hard battle,"},{"id":"seytek-2012:p0981:b003:l035","ordinal":372287,"en":"Gripping heavy guns and drawing bows,"},{"id":"seytek-2012:p0981:b003:l036","ordinal":372288,"en":"And how many sank beneath the sky,"},{"id":"seytek-2012:p0981:b003:l037","ordinal":372289,"en":"Waging a savage fight,"},{"id":"seytek-2012:p0981:b003:l038","ordinal":372290,"en":"Both were champions, both were lions—"},{"id":"seytek-2012:p0981:b003:l039","ordinal":372291,"en":"Hero Sarybay and Kuyaly,"},{"id":"seytek-2012:p0981:b003:l040","ordinal":372292,"en":"Heroes extraordinary among mortals."},{"id":"seytek-2012:p0982:b002:l001","ordinal":372293,"en":"Heedless of one another,"},{"id":"seytek-2012:p0982:b002:l002","ordinal":372294,"en":"Sparing not their hair-thin lives,"},{"id":"seytek-2012:p0982:b002:l003","ordinal":372295,"en":"They began a calamitous fight,"},{"id":"seytek-2012:p0982:b002:l004","ordinal":372296,"en":"Both of them, their dear lives"},{"id":"seytek-2012:p0982:b002:l005","ordinal":372297,"en":"Staked on a single hair,"},{"id":"seytek-2012:p0982:b002:l006","ordinal":372298,"en":"Their fierce battle roared,"},{"id":"seytek-2012:p0982:b002:l007","ordinal":372299,"en":"Swallowing blood to the full,"},{"id":"seytek-2012:p0982:b002:l008","ordinal":372300,"en":"Tearing all their coats to shreds."},{"id":"seytek-2012:p0982:b002:l009","ordinal":372301,"en":"When they struck with clubs, neither flinched;"},{"id":"seytek-2012:p0982:b002:l010","ordinal":372302,"en":"When they hacked with axes, neither stirred;"},{"id":"seytek-2012:p0982:b002:l011","ordinal":372303,"en":"When they lashed with whips, neither cried out;"},{"id":"seytek-2012:p0982:b002:l012","ordinal":372304,"en":"When they crossed swords, neither uttered a groan;"},{"id":"seytek-2012:p0982:b002:l013","ordinal":372305,"en":"They fought a desperate battle,"},{"id":"seytek-2012:p0982:b002:l014","ordinal":372306,"en":"A strange life, a soul amid a throng,"},{"id":"seytek-2012:p0982:b002:l015","ordinal":372307,"en":"They staked it on a single hair;"},{"id":"seytek-2012:p0982:b002:l016","ordinal":372308,"en":"A precious life, a dear soul,"},{"id":"seytek-2012:p0982:b002:l017","ordinal":372309,"en":"They staked it on a single hair."},{"id":"seytek-2012:p0982:b002:l018","ordinal":372310,"en":"A bloody slaughter, a relentless pursuit,"},{"id":"seytek-2012:p0982:b002:l019","ordinal":372311,"en":"They led their champions into it."},{"id":"seytek-2012:p0982:b002:l020","ordinal":372312,"en":"Seizing each other by the collars,"},{"id":"seytek-2012:p0982:b002:l021","ordinal":372313,"en":"Whoever came near"},{"id":"seytek-2012:p0982:b002:l022","ordinal":372314,"en":"They struck with an axe;"},{"id":"seytek-2012:p0982:b002:l023","ordinal":372315,"en":"For two days and nights"},{"id":"seytek-2012:p0982:b002:l024","ordinal":372316,"en":"They never ceased their thunderous clash."},{"id":"seytek-2012:p0982:b002:l025","ordinal":372317,"en":"They gathered force and charged,"},{"id":"seytek-2012:p0982:b002:l026","ordinal":372318,"en":"And crashed against each other,"},{"id":"seytek-2012:p0982:b002:l027","ordinal":372319,"en":"The standards swarmed, banners everywhere,"},{"id":"seytek-2012:p0982:b002:l028","ordinal":372320,"en":"Battle cries rose in a tumult;"},{"id":"seytek-2012:p0982:b002:l029","ordinal":372321,"en":"Look, the uproar swelled,"},{"id":"seytek-2012:p0982:b002:l030","ordinal":372322,"en":"And a vast battle raged."},{"id":"seytek-2012:p0982:b002:l031","ordinal":372323,"en":"They tore at one another without regret,"},{"id":"seytek-2012:p0982:b002:l032","ordinal":372324,"en":"Swallowing blood as if it were water,"},{"id":"seytek-2012:p0982:b002:l033","ordinal":372325,"en":"They thrust their spears at one another,"},{"id":"seytek-2012:p0982:b002:l034","ordinal":372326,"en":"Sparing not their precious lives,"},{"id":"seytek-2012:p0982:b002:l035","ordinal":372327,"en":"They battered one another."},{"id":"seytek-2012:p0982:b002:l036","ordinal":372328,"en":"There was no way out of it,"},{"id":"seytek-2012:p0982:b002:l037","ordinal":372329,"en":"They were enveloped in pitch-black dust,"},{"id":"seytek-2012:p0982:b002:l038","ordinal":372330,"en":"A strange hardship rose like a ridge,"},{"id":"seytek-2012:p0982:b002:l039","ordinal":372331,"en":"A fierce tumult and strife arose,"},{"id":"seytek-2012:p0982:b002:l040","ordinal":372332,"en":"A clamor seemed to split the sky,"},{"id":"seytek-2012:p0982:b003:l001","ordinal":372333,"en":"The cries rose in a roar,"},{"id":"seytek-2012:p0982:b003:l002","ordinal":372334,"en":"Each faced a grievous struggle,"},{"id":"seytek-2012:p0982:b003:l003","ordinal":372335,"en":"Neither could prevail in combat."},{"id":"seytek-2012:p0982:b003:l004","ordinal":372336,"en":"Neither could discover"},{"id":"seytek-2012:p0982:b003:l005","ordinal":372337,"en":"The other's true measure."},{"id":"seytek-2012:p0982:b003:l006","ordinal":372338,"en":"Each was a formidable trial to the other,"},{"id":"seytek-2012:p0982:b003:l007","ordinal":372339,"en":"And neither could defeat the other."},{"id":"seytek-2012:p0982:b003:l008","ordinal":372340,"en":"They battered one another,"},{"id":"seytek-2012:p0982:b003:l009","ordinal":372341,"en":"Yet neither could bring the other down."},{"id":"seytek-2012:p0982:b003:l010","ordinal":372342,"en":"The earth broke and shook,"},{"id":"seytek-2012:p0982:b003:l011","ordinal":372343,"en":"Their strength matched,"},{"id":"seytek-2012:p0982:b003:l012","ordinal":372344,"en":"They struck without gaining the upper hand,"},{"id":"seytek-2012:p0982:b003:l013","ordinal":372345,"en":"They grappled and fought,"},{"id":"seytek-2012:p0982:b003:l014","ordinal":372346,"en":"Yet neither could prevail against the other."},{"id":"seytek-2012:p0982:b003:l015","ordinal":372347,"en":"A mighty clash, a great din,"},{"id":"seytek-2012:p0982:b003:l016","ordinal":372348,"en":"Such was the uproar,"},{"id":"seytek-2012:p0982:b003:l017","ordinal":372349,"en":"All the men were spent,"},{"id":"seytek-2012:p0982:b003:l018","ordinal":372350,"en":"Their spears shattered and were used up."},{"id":"seytek-2012:p0982:b003:l019","ordinal":372351,"en":"An extraordinary battle broke out,"},{"id":"seytek-2012:p0982:b003:l020","ordinal":372352,"en":"The strong drove the weak before them,"},{"id":"seytek-2012:p0982:b003:l021","ordinal":372353,"en":"And slaughtered them as they went,"},{"id":"seytek-2012:p0982:b003:l022","ordinal":372354,"en":"A great clash and mighty roar,"},{"id":"seytek-2012:p0982:b003:l023","ordinal":372355,"en":"A throng of cries and clamor."},{"id":"seytek-2012:p0982:b003:l024","ordinal":372356,"en":"Now the ordeal grew harsh,"},{"id":"seytek-2012:p0982:b003:l025","ordinal":372357,"en":"Renowned khans fell dead,"},{"id":"seytek-2012:p0982:b003:l026","ordinal":372358,"en":"And warriors meeting face to face died,"},{"id":"seytek-2012:p0982:b003:l027","ordinal":372359,"en":"They fought a grievous battle."},{"id":"seytek-2012:p0982:b003:l028","ordinal":372360,"en":"As if these lives were not living,"},{"id":"seytek-2012:p0982:b003:l029","ordinal":372361,"en":"They simply cast them away."},{"id":"seytek-2012:p0982:b003:l030","ordinal":372362,"en":"Khans died in the fighting,"},{"id":"seytek-2012:p0982:b003:l031","ordinal":372363,"en":"As the fierce battle raged,"},{"id":"seytek-2012:p0982:b003:l032","ordinal":372364,"en":"The champions held nothing back,"},{"id":"seytek-2012:p0982:b003:l033","ordinal":372365,"en":"Clashing with a crash,"},{"id":"seytek-2012:p0982:b003:l034","ordinal":372366,"en":"Into death, doom and calamity"},{"id":"seytek-2012:p0982:b003:l035","ordinal":372367,"en":"They went against the foe."},{"id":"seytek-2012:p0982:b003:l036","ordinal":372368,"en":"Their strength failed from weariness,"},{"id":"seytek-2012:p0982:b003:l037","ordinal":372369,"en":"Hero Sarybay, the mighty champion,"},{"id":"seytek-2012:p0982:b003:l038","ordinal":372370,"en":"A man the people had never known the like of,"},{"id":"seytek-2012:p0982:b003:l039","ordinal":372371,"en":"Now kept the battle raging."},{"id":"seytek-2012:p0982:b003:l040","ordinal":372372,"en":"This clash rang with cries,"},{"id":"seytek-2012:p0983:b002:l001","ordinal":372373,"en":"He had kept the tumult raging."},{"id":"seytek-2012:p0983:b002:l002","ordinal":372374,"en":"Strength spent, exhausted,"},{"id":"seytek-2012:p0983:b002:l003","ordinal":372375,"en":"Blood flowed from our bodies,"},{"id":"seytek-2012:p0983:b002:l004","ordinal":372376,"en":"The wide world became narrow,"},{"id":"seytek-2012:p0983:b002:l005","ordinal":372377,"en":"For saliva sweeter than sugar,"},{"id":"seytek-2012:p0983:b002:l006","ordinal":372378,"en":"We longed for a single swallow."},{"id":"seytek-2012:p0983:b002:l007","ordinal":372379,"en":"Bravo, Kuyaly!"},{"id":"seytek-2012:p0983:b002:l008","ordinal":372380,"en":"How could I fail to say, 'Well done'?"},{"id":"seytek-2012:p0983:b002:l009","ordinal":372381,"en":"Your valor is mighty, your wrath fierce;"},{"id":"seytek-2012:p0983:b002:l010","ordinal":372382,"en":"I set Sarybay straight."},{"id":"seytek-2012:p0983:b002:l011","ordinal":372383,"en":"My poor head was sorely tried,"},{"id":"seytek-2012:p0983:b002:l012","ordinal":372384,"en":"The final ordeal came upon me."},{"id":"seytek-2012:p0983:b002:l013","ordinal":372385,"en":"I was Sarybay the khan,"},{"id":"seytek-2012:p0983:b002:l014","ordinal":372386,"en":"From time immemorial,"},{"id":"seytek-2012:p0983:b002:l015","ordinal":372387,"en":"At every turn,"},{"id":"seytek-2012:p0983:b002:l016","ordinal":372388,"en":"Fighting had been my custom."},{"id":"seytek-2012:p0983:b002:l017","ordinal":372389,"en":"Countless armies"},{"id":"seytek-2012:p0983:b002:l018","ordinal":372390,"en":"I fought and crushed,"},{"id":"seytek-2012:p0983:b002:l019","ordinal":372391,"en":"And cast them all into misery."},{"id":"seytek-2012:p0983:b002:l020","ordinal":372392,"en":"I used to fell the middling ones;"},{"id":"seytek-2012:p0983:b002:l021","ordinal":372393,"en":"When a fierce fighting foe came,"},{"id":"seytek-2012:p0983:b002:l022","ordinal":372394,"en":"I used to lay him flat on his back."},{"id":"seytek-2012:p0983:b002:l023","ordinal":372395,"en":"I used to destroy even the formidable ones,"},{"id":"seytek-2012:p0983:b002:l024","ordinal":372396,"en":"And those who crept close,"},{"id":"seytek-2012:p0983:b002:l025","ordinal":372397,"en":"I used to gouge out their glaring eyes."},{"id":"seytek-2012:p0983:b002:l026","ordinal":372398,"en":"When they came swaggering,"},{"id":"seytek-2012:p0983:b002:l027","ordinal":372399,"en":"I left them at their wits' end,"},{"id":"seytek-2012:p0983:b002:l028","ordinal":372400,"en":"And laid them flat on their backs."},{"id":"seytek-2012:p0983:b002:l029","ordinal":372401,"en":"Yet my appointed end had not come."},{"id":"seytek-2012:p0983:b002:l030","ordinal":372402,"en":"Swift to flee, fierce in wrath,"},{"id":"seytek-2012:p0983:b002:l031","ordinal":372403,"en":"My dear, I had never seen your like."},{"id":"seytek-2012:p0983:b002:l032","ordinal":372404,"en":"Yesterday I heard word from a messenger,"},{"id":"seytek-2012:p0983:b002:l033","ordinal":372405,"en":"Hearing that Kuyaly has arrived,"},{"id":"seytek-2012:p0983:b002:l034","ordinal":372406,"en":"My tiny life trembled,"},{"id":"seytek-2012:p0983:b002:l035","ordinal":372407,"en":"The bones of my thighs shuddered,"},{"id":"seytek-2012:p0983:b002:l036","ordinal":372408,"en":"My ribs throbbed,"},{"id":"seytek-2012:p0983:b002:l037","ordinal":372409,"en":"My insides heaved without cease,"},{"id":"seytek-2012:p0983:b002:l038","ordinal":372410,"en":"The news spread among the people:"},{"id":"seytek-2012:p0983:b002:l039","ordinal":372411,"en":"'A fearsome fiend has come,' they said."},{"id":"seytek-2012:p0983:b002:l040","ordinal":372412,"en":"Poor champion Sarybay,"},{"id":"seytek-2012:p0983:b003:l001","ordinal":372413,"en":"He despaired of his precious life."},{"id":"seytek-2012:p0983:b003:l002","ordinal":372414,"en":"The wretched man writhed in anguish,"},{"id":"seytek-2012:p0983:b003:l003","ordinal":372415,"en":"Time after time,"},{"id":"seytek-2012:p0983:b003:l004","ordinal":372416,"en":"He had suffered in this way."},{"id":"seytek-2012:p0983:b003:l005","ordinal":372417,"en":"The silk settled close without parting,"},{"id":"seytek-2012:p0983:b003:l006","ordinal":372418,"en":"You did wrong by stirring up strife,"},{"id":"seytek-2012:p0983:b003:l007","ordinal":372419,"en":"You show no sign of sparing a life."},{"id":"seytek-2012:p0983:b003:l008","ordinal":372420,"en":"Like the silken waist of an argali,"},{"id":"seytek-2012:p0983:b003:l009","ordinal":372421,"en":"When I look at your fierce bearing,"},{"id":"seytek-2012:p0983:b003:l010","ordinal":372422,"en":"It is like the cold wind of a mountain pass."},{"id":"seytek-2012:p0983:b003:l011","ordinal":372423,"en":"With a low, swelling hum,"},{"id":"seytek-2012:p0983:b003:l012","ordinal":372424,"en":"Muttering deep in his throat,"},{"id":"seytek-2012:p0983:b003:l013","ordinal":372425,"en":"Sarybay thundered:"},{"id":"seytek-2012:p0983:b003:l014","ordinal":372426,"en":"\"Since I became Sarybay,"},{"id":"seytek-2012:p0983:b003:l015","ordinal":372427,"en":"Since I mounted a horse as Sarybay,"},{"id":"seytek-2012:p0983:b003:l016","ordinal":372428,"en":"Since I came of age and became a warrior,"},{"id":"seytek-2012:p0983:b003:l017","ordinal":372429,"en":"A match for the sons of warriors,"},{"id":"seytek-2012:p0983:b003:l018","ordinal":372430,"en":"Since I put on a golden crown,"},{"id":"seytek-2012:p0983:b003:l019","ordinal":372431,"en":"Since I ascended a golden throne,"},{"id":"seytek-2012:p0983:b003:l020","ordinal":372432,"en":"I ruled the people and cared for the land,"},{"id":"seytek-2012:p0983:b003:l021","ordinal":372433,"en":"I have lived as Sarybay."},{"id":"seytek-2012:p0983:b003:l022","ordinal":372434,"en":"I held court and became a khan,"},{"id":"seytek-2012:p0983:b003:l023","ordinal":372435,"en":"A chief seated in authority,"},{"id":"seytek-2012:p0983:b003:l024","ordinal":372436,"en":"I gathered the people and held the realm,"},{"id":"seytek-2012:p0983:b003:l025","ordinal":372437,"en":"Riding the clouds and scattering ice,"},{"id":"seytek-2012:p0983:b003:l026","ordinal":372438,"en":"In those days when I roared,"},{"id":"seytek-2012:p0983:b003:l027","ordinal":372439,"en":"Leaving neither a horse-catching pole nor a living soul,"},{"id":"seytek-2012:p0983:b003:l028","ordinal":372440,"en":"I scattered their very core,"},{"id":"seytek-2012:p0983:b003:l029","ordinal":372441,"en":"No herd escaped my raids,"},{"id":"seytek-2012:p0983:b003:l030","ordinal":372442,"en":"My Zulpukor sword and my steel spear,"},{"id":"seytek-2012:p0983:b003:l031","ordinal":372443,"en":"When I brandished them,"},{"id":"seytek-2012:p0983:b003:l032","ordinal":372444,"en":"All the vast heavens"},{"id":"seytek-2012:p0983:b003:l033","ordinal":372445,"en":"I held in my power in those days,"},{"id":"seytek-2012:p0983:b003:l034","ordinal":372446,"en":"I sliced and ate the choicest horse haunch,"},{"id":"seytek-2012:p0983:b003:l035","ordinal":372447,"en":"And asked, 'Where is the death-bringer?'"},{"id":"seytek-2012:p0983:b003:l036","ordinal":372448,"en":"I sliced and ate horse-rib fat,"},{"id":"seytek-2012:p0983:b003:l037","ordinal":372449,"en":"And asked, 'Where is calamity?'"},{"id":"seytek-2012:p0983:b003:l038","ordinal":372450,"en":"Oh, wretched Kuyaly,"},{"id":"seytek-2012:p0983:b003:l039","ordinal":372451,"en":"I have suffered greatly because of you."},{"id":"seytek-2012:p0983:b003:l040","ordinal":372452,"en":"In the end, to this warrior,"},{"id":"seytek-2012:p0984:b002:l001","ordinal":372453,"en":"To that strong-armed infidel,"},{"id":"seytek-2012:p0984:b002:l002","ordinal":372454,"en":"Fire rose from my very core,"},{"id":"seytek-2012:p0984:b002:l003","ordinal":372455,"en":"An enemy arose from within me,"},{"id":"seytek-2012:p0984:b002:l004","ordinal":372456,"en":"The child truly struck down"},{"id":"seytek-2012:p0984:b002:l005","ordinal":372457,"en":"I see I am about to behold,"},{"id":"seytek-2012:p0984:b002:l006","ordinal":372458,"en":"True death has come for my poor soul,"},{"id":"seytek-2012:p0984:b002:l007","ordinal":372459,"en":"It seems I have come to die."},{"id":"seytek-2012:p0984:b002:l008","ordinal":372460,"en":"O trader in this fleeting world,"},{"id":"seytek-2012:p0984:b002:l009","ordinal":372461,"en":"Enamored of this world,"},{"id":"seytek-2012:p0984:b002:l010","ordinal":372462,"en":"What did I think I would gain?"},{"id":"seytek-2012:p0984:b002:l011","ordinal":372463,"en":"Kuyaly, the one I clashed with,"},{"id":"seytek-2012:p0984:b002:l012","ordinal":372464,"en":"Was one who came from my own land,"},{"id":"seytek-2012:p0984:b002:l013","ordinal":372465,"en":"We jousted seven times,"},{"id":"seytek-2012:p0984:b002:l014","ordinal":372466,"en":"And she said, 'I will do this to you.'"},{"id":"seytek-2012:p0984:b002:l015","ordinal":372467,"en":"That renowned champion girl"},{"id":"seytek-2012:p0984:b002:l016","ordinal":372468,"en":"Has come into her inheritance,"},{"id":"seytek-2012:p0984:b002:l017","ordinal":372469,"en":"Whoever she set her sights on died,"},{"id":"seytek-2012:p0984:b002:l018","ordinal":372470,"en":"What she wished for was granted,"},{"id":"seytek-2012:p0984:b002:l019","ordinal":372471,"en":"Whoever grappled with her died,"},{"id":"seytek-2012:p0984:b002:l020","ordinal":372472,"en":"And her challenger has come."},{"id":"seytek-2012:p0984:b002:l021","ordinal":372473,"en":"Kayipchal's champion daughter,"},{"id":"seytek-2012:p0984:b002:l022","ordinal":372474,"en":"You dark-hearted, swaggering girl,"},{"id":"seytek-2012:p0984:b002:l023","ordinal":372475,"en":"A girl cast off by the people,"},{"id":"seytek-2012:p0984:b002:l024","ordinal":372476,"en":"At your village's edge stands a white cliff,"},{"id":"seytek-2012:p0984:b002:l025","ordinal":372477,"en":"You shameless, reckless woman!"},{"id":"seytek-2012:p0984:b002:l026","ordinal":372478,"en":"No waist for a hand to pass around,"},{"id":"seytek-2012:p0984:b002:l027","ordinal":372479,"en":"No man who has not bowed to you,"},{"id":"seytek-2012:p0984:b002:l028","ordinal":372480,"en":"A noble-born champion girl,"}]
