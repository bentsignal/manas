[{"id":"semetey-2-2013:p1293:b003:l026","ordinal":286209,"en":"Seven mighty rivers cannot divide you;"},{"id":"semetey-2-2013:p1293:b003:l027","ordinal":286210,"en":"Let armies cover the earth,"},{"id":"semetey-2-2013:p1293:b003:l028","ordinal":286211,"en":"Let their multitudes flatten the land—"},{"id":"semetey-2-2013:p1293:b003:l029","ordinal":286212,"en":"There is no fortress where I will turn back."},{"id":"semetey-2-2013:p1293:b003:l030","ordinal":286213,"en":"Kanchoro is your swift stallion;"},{"id":"semetey-2-2013:p1293:b003:l031","ordinal":286214,"en":"For you Jediger there will be no calamity."},{"id":"semetey-2-2013:p1293:b003:l032","ordinal":286215,"en":"We broke down the gate"},{"id":"semetey-2-2013:p1293:b003:l033","ordinal":286216,"en":"Of that fool, the son of Manas, and drenched it in blood;"},{"id":"semetey-2-2013:p1293:b003:l034","ordinal":286217,"en":"We turned his black road to dust."},{"id":"semetey-2-2013:p1293:b003:l035","ordinal":286218,"en":"We made the livestock on his pastures fat spoils,"},{"id":"semetey-2-2013:p1293:b003:l036","ordinal":286219,"en":"And struck down his imperious lions,"},{"id":"semetey-2-2013:p1293:b003:l037","ordinal":286220,"en":"His rash and sullen-minded,"},{"id":"semetey-2-2013:p1293:b003:l038","ordinal":286221,"en":"Thunderously boasting warriors."},{"id":"semetey-2-2013:p1293:b003:l039","ordinal":286222,"en":"Across Jylgyn, Keң-Kol, and Talas"},{"id":"semetey-2-2013:p1293:b004:l001","ordinal":286223,"en":"We made our long spears dance;"},{"id":"semetey-2-2013:p1293:b004:l002","ordinal":286224,"en":"We cut down their great champions."},{"id":"semetey-2-2013:p1293:b004:l003","ordinal":286225,"en":"We made our warhorses prance on the passes"},{"id":"semetey-2-2013:p1293:b004:l004","ordinal":286226,"en":"And destroyed every one of their beks."},{"id":"semetey-2-2013:p1293:b004:l005","ordinal":286227,"en":"When Kanchoro grows enraged,"},{"id":"semetey-2-2013:p1293:b004:l006","ordinal":286228,"en":"He will make snow fall upon your passes;"},{"id":"semetey-2-2013:p1293:b004:l007","ordinal":286229,"en":"No—if you befriend him, Jediger,"},{"id":"semetey-2-2013:p1293:b004:l008","ordinal":286230,"en":"He will make bounty rain upon your people."},{"id":"semetey-2-2013:p1293:b004:l009","ordinal":286231,"en":"When my murderous fury seizes me,"},{"id":"semetey-2-2013:p1293:b004:l010","ordinal":286232,"en":"Not one of you will survive, Jediger!"},{"id":"semetey-2-2013:p1293:b004:l011","ordinal":286233,"en":"I am a deep-blue, rugged mountain pass"},{"id":"semetey-2-2013:p1293:b004:l012","ordinal":286234,"en":"No multitude can cross;"},{"id":"semetey-2-2013:p1293:b004:l013","ordinal":286235,"en":"I am a black wolf-lion"},{"id":"semetey-2-2013:p1293:b004:l014","ordinal":286236,"en":"No enemy can approach head-on."},{"id":"semetey-2-2013:p1293:b004:l015","ordinal":286237,"en":"I broke through the pass and opened a road;"},{"id":"semetey-2-2013:p1293:b004:l016","ordinal":286238,"en":"Laboring against the gray wolf,"},{"id":"semetey-2-2013:p1293:b004:l017","ordinal":286239,"en":"I attacked the whole earth."},{"id":"semetey-2-2013:p1293:b004:l018","ordinal":286240,"en":"When my heart turned toward one deed,"},{"id":"semetey-2-2013:p1293:b004:l019","ordinal":286241,"en":"I laid hands upon my own elder brother."},{"id":"semetey-2-2013:p1293:b004:l020","ordinal":286242,"en":"Damn you, Jediger—"},{"id":"semetey-2-2013:p1293:b004:l021","ordinal":286243,"en":"Look at the prize I have taken!"},{"id":"semetey-2-2013:p1293:b004:l022","ordinal":286244,"en":"If this is not a prize, what is?"},{"id":"semetey-2-2013:p1293:b004:l023","ordinal":286245,"en":"Formidable in weight and fierce in venom,"},{"id":"semetey-2-2013:p1293:b004:l024","ordinal":286246,"en":"I have spilled his yellow blood:"},{"id":"semetey-2-2013:p1293:b004:l025","ordinal":286247,"en":"He who would yield to no one in the world,"},{"id":"semetey-2-2013:p1293:b004:l026","ordinal":286248,"en":"Who would not yield even to the Flood,"},{"id":"semetey-2-2013:p1293:b004:l027","ordinal":286249,"en":"The most skillful of spearmen,"},{"id":"semetey-2-2013:p1293:b004:l028","ordinal":286250,"en":"The mightiest of brave men,"},{"id":"semetey-2-2013:p1293:b004:l029","ordinal":286251,"en":"The most precious of many lions,"},{"id":"semetey-2-2013:p1293:b004:l030","ordinal":286252,"en":"The champion of all gray wolves,"},{"id":"semetey-2-2013:p1293:b004:l031","ordinal":286253,"en":"A man excelling sixty others,"},{"id":"semetey-2-2013:p1293:b004:l032","ordinal":286254,"en":"The most skillful of spearmen—"},{"id":"semetey-2-2013:p1293:b004:l033","ordinal":286255,"en":"Külchoro, now taken captive,"},{"id":"semetey-2-2013:p1293:b004:l034","ordinal":286256,"en":"The mightiest among the multitude."},{"id":"semetey-2-2013:p1293:b004:l035","ordinal":286257,"en":"My relentless fury seized me;"},{"id":"semetey-2-2013:p1293:b004:l036","ordinal":286258,"en":"I greased my white-steel blade with blood."},{"id":"semetey-2-2013:p1293:b004:l037","ordinal":286259,"en":"My anger struck just now,"},{"id":"semetey-2-2013:p1293:b004:l038","ordinal":286260,"en":"And I brought down the heedless hero"},{"id":"semetey-2-2013:p1293:b004:l039","ordinal":286261,"en":"Whom they had raised with such care;"},{"id":"semetey-2-2013:p1294:b003:l001","ordinal":286262,"en":"I broke through the gorge and opened a road."},{"id":"semetey-2-2013:p1294:b003:l002","ordinal":286263,"en":"My domineering frenzy seized me;"},{"id":"semetey-2-2013:p1294:b003:l003","ordinal":286264,"en":"The man who shared my mother’s breast and grew beside me,"},{"id":"semetey-2-2013:p1294:b003:l004","ordinal":286265,"en":"My twin hero whose name rhymed with mine—"},{"id":"semetey-2-2013:p1294:b003:l005","ordinal":286266,"en":"I bound Külchoro."},{"id":"semetey-2-2013:p1294:b003:l006","ordinal":286267,"en":"When someone provokes my vengeance,"},{"id":"semetey-2-2013:p1294:b003:l007","ordinal":286268,"en":"I never retreat even before my own kin;"},{"id":"semetey-2-2013:p1294:b003:l008","ordinal":286269,"en":"When murderous rage seizes me,"},{"id":"semetey-2-2013:p1294:b003:l009","ordinal":286270,"en":"I will not give an inch to anyone nearby."},{"id":"semetey-2-2013:p1294:b003:l010","ordinal":286271,"en":"Close in, Jediger!"},{"id":"semetey-2-2013:p1294:b003:l011","ordinal":286272,"en":"If you are sons capable of taking revenge,"},{"id":"semetey-2-2013:p1294:b003:l012","ordinal":286273,"en":"Make ready, Jediger!"},{"id":"semetey-2-2013:p1294:b003:l013","ordinal":286274,"en":"With a cast-iron socket"},{"id":"semetey-2-2013:p1294:b003:l014","ordinal":286275,"en":"Fitted wide and deep,"},{"id":"semetey-2-2013:p1294:b003:l015","ordinal":286276,"en":"Yesterday, when he came out to fight"},{"id":"semetey-2-2013:p1294:b003:l016","ordinal":286277,"en":"The teeming black-clad Jediger,"},{"id":"semetey-2-2013:p1294:b003:l017","ordinal":286278,"en":"When he faced them head-on"},{"id":"semetey-2-2013:p1294:b003:l018","ordinal":286279,"en":"And thrust his spear with a roar,"},{"id":"semetey-2-2013:p1294:b003:l019","ordinal":286280,"en":"The spears were drenched in blood"},{"id":"semetey-2-2013:p1294:b003:l020","ordinal":286281,"en":"And lions fell dead upon the ground."},{"id":"semetey-2-2013:p1294:b003:l021","ordinal":286282,"en":"Külchoro charged in with a cry"},{"id":"semetey-2-2013:p1294:b003:l022","ordinal":286283,"en":"And unleashed terrible wrath;"},{"id":"semetey-2-2013:p1294:b003:l023","ordinal":286284,"en":"Your forefather, the gray wolf Toltoy,"},{"id":"semetey-2-2013:p1294:b003:l024","ordinal":286285,"en":"Külchoro slaughtered and left for dead."},{"id":"semetey-2-2013:p1294:b003:l025","ordinal":286286,"en":"Having lost their men, the Jediger"},{"id":"semetey-2-2013:p1294:b003:l026","ordinal":286287,"en":"Led home their ownerless horses."},{"id":"semetey-2-2013:p1294:b003:l027","ordinal":286288,"en":"‘Alas, my dear kinsman"},{"id":"semetey-2-2013:p1294:b003:l028","ordinal":286289,"en":"Died in such-and-such a place!’"},{"id":"semetey-2-2013:p1294:b003:l029","ordinal":286290,"en":"Thus the Jediger wailed."},{"id":"semetey-2-2013:p1294:b003:l030","ordinal":286291,"en":"He destroyed their young men in their prime,"},{"id":"semetey-2-2013:p1294:b003:l031","ordinal":286292,"en":"And felled their mightiest;"},{"id":"semetey-2-2013:p1294:b003:l032","ordinal":286293,"en":"He drove his wrathful spear deep,"},{"id":"semetey-2-2013:p1294:b003:l033","ordinal":286294,"en":"And slaughtered mighty Toltoy and Chynkojo,"},{"id":"semetey-2-2013:p1294:b003:l034","ordinal":286295,"en":"Leaving not one alive."},{"id":"semetey-2-2013:p1294:b003:l035","ordinal":286296,"en":"This Talas is no land for you;"},{"id":"semetey-2-2013:p1294:b003:l036","ordinal":286297,"en":"Külchoro’s people are not yours."},{"id":"semetey-2-2013:p1294:b003:l037","ordinal":286298,"en":"This blustering false slave—"},{"id":"semetey-2-2013:p1294:b003:l038","ordinal":286299,"en":"Gouge out his right shoulder,"},{"id":"semetey-2-2013:p1294:b003:l039","ordinal":286300,"en":"Flay his right flank,"},{"id":"semetey-2-2013:p1294:b004:l001","ordinal":286301,"en":"Gouge out his left shoulder."},{"id":"semetey-2-2013:p1294:b004:l002","ordinal":286302,"en":"Neither dead nor alive,"},{"id":"semetey-2-2013:p1294:b004:l003","ordinal":286303,"en":"Leave this evil-minded slave"},{"id":"semetey-2-2013:p1294:b004:l004","ordinal":286304,"en":"Stranded between the two states."},{"id":"semetey-2-2013:p1294:b004:l005","ordinal":286305,"en":"Hack him smooth and make him helpless;"},{"id":"semetey-2-2013:p1294:b004:l006","ordinal":286306,"en":"Make him a slave to the herdsmen."},{"id":"semetey-2-2013:p1294:b004:l007","ordinal":286307,"en":"Inflict your fiercest wrath;"},{"id":"semetey-2-2013:p1294:b004:l008","ordinal":286308,"en":"Upon this villain who played the hero,"},{"id":"semetey-2-2013:p1294:b004:l009","ordinal":286309,"en":"This boar who caused such turmoil,"},{"id":"semetey-2-2013:p1294:b004:l010","ordinal":286310,"en":"Take revenge from every quarter."},{"id":"semetey-2-2013:p1294:b004:l011","ordinal":286311,"en":"Though he was once a man apart,"},{"id":"semetey-2-2013:p1294:b004:l012","ordinal":286312,"en":"At heart he is our enemy."},{"id":"semetey-2-2013:p1294:b004:l013","ordinal":286313,"en":"When both his arms are gone,"},{"id":"semetey-2-2013:p1294:b004:l014","ordinal":286314,"en":"And only the hero’s shadow remains,"},{"id":"semetey-2-2013:p1294:b004:l015","ordinal":286315,"en":"Whip him, beat him, and flay him."},{"id":"semetey-2-2013:p1294:b004:l016","ordinal":286316,"en":"Gouge out his eyes and blind him;"},{"id":"semetey-2-2013:p1294:b004:l017","ordinal":286317,"en":"If he defies you again,"},{"id":"semetey-2-2013:p1294:b004:l018","ordinal":286318,"en":"Hack into the nape of his neck."},{"id":"semetey-2-2013:p1294:b004:l019","ordinal":286319,"en":"For beasts, ravens, and crows"},{"id":"semetey-2-2013:p1294:b004:l020","ordinal":286320,"en":"Make of him a proper feast."},{"id":"semetey-2-2013:p1294:b004:l021","ordinal":286321,"en":"Upon the enemy fallen into your hands,"},{"id":"semetey-2-2013:p1294:b004:l022","ordinal":286322,"en":"Inflict torment without restraint;"},{"id":"semetey-2-2013:p1294:b004:l023","ordinal":286323,"en":"Take the vengeance you have long harbored."},{"id":"semetey-2-2013:p1294:b004:l024","ordinal":286324,"en":"Drive this crippled wretch away."},{"id":"semetey-2-2013:p1294:b004:l025","ordinal":286325,"en":"Make him the slave of slaves;"},{"id":"semetey-2-2013:p1294:b004:l026","ordinal":286326,"en":"Torment him and take his life."},{"id":"semetey-2-2013:p1294:b004:l027","ordinal":286327,"en":"Beat him sick and stretch him on the rack;"},{"id":"semetey-2-2013:p1294:b004:l028","ordinal":286328,"en":"Deliver his punishment into our hands."},{"id":"semetey-2-2013:p1294:b004:l029","ordinal":286329,"en":"Devise exquisite tortures;"},{"id":"semetey-2-2013:p1294:b004:l030","ordinal":286330,"en":"Make him labor, beat him, club him,"},{"id":"semetey-2-2013:p1294:b004:l031","ordinal":286331,"en":"And subject him to a dog’s humiliation."},{"id":"semetey-2-2013:p1294:b004:l032","ordinal":286332,"en":"Break his spirit and fill him with pain;"},{"id":"semetey-2-2013:p1294:b004:l033","ordinal":286333,"en":"Dig into his sides until they become sores."},{"id":"semetey-2-2013:p1294:b004:l034","ordinal":286334,"en":"Beat him flat and stretch him like a hide;"},{"id":"semetey-2-2013:p1294:b004:l035","ordinal":286335,"en":"Thus deliver his punishment."},{"id":"semetey-2-2013:p1294:b004:l036","ordinal":286336,"en":"Take your boundless revenge."},{"id":"semetey-2-2013:p1294:b004:l037","ordinal":286337,"en":"Make him serve forty herdsmen and eighty slaves,"},{"id":"semetey-2-2013:p1294:b004:l038","ordinal":286338,"en":"Fetching their firewood and water;"},{"id":"semetey-2-2013:p1294:b004:l039","ordinal":286339,"en":"Make his soul smolder, and take his life."},{"id":"semetey-2-2013:p1295:b003:l001","ordinal":286340,"en":"Keep your anger in check,"},{"id":"semetey-2-2013:p1295:b003:l002","ordinal":286341,"en":"Show the living hell"},{"id":"semetey-2-2013:p1295:b003:l003","ordinal":286342,"en":"Take your life like this."},{"id":"semetey-2-2013:p1295:b003:l004","ordinal":286343,"en":"If you are a person, if you are a people,"},{"id":"semetey-2-2013:p1295:b003:l005","ordinal":286344,"en":"Listen, my dear,"},{"id":"semetey-2-2013:p1295:b003:l006","ordinal":286345,"en":"From this slave who sighs"},{"id":"semetey-2-2013:p1295:b003:l007","ordinal":286346,"en":"So take your revenge."},{"id":"semetey-2-2013:p1295:b003:l008","ordinal":286347,"en":"Do not read carefully."},{"id":"semetey-2-2013:p1295:b003:l009","ordinal":286348,"en":"By accident,"},{"id":"semetey-2-2013:p1295:b003:l010","ordinal":286349,"en":"Sleep on your elbows,"},{"id":"semetey-2-2013:p1295:b003:l011","ordinal":286350,"en":"Take it easy,"},{"id":"semetey-2-2013:p1295:b003:l012","ordinal":286351,"en":"Resting the soul on the hips,"},{"id":"semetey-2-2013:p1295:b003:l013","ordinal":286352,"en":"Lying down to sleep,"},{"id":"semetey-2-2013:p1295:b003:l014","ordinal":286353,"en":"Filled with milk,"},{"id":"semetey-2-2013:p1295:b003:l015","ordinal":286354,"en":"The curve is fleshy,"},{"id":"semetey-2-2013:p1295:b003:l016","ordinal":286355,"en":"Don't climb the slope awkwardly,"},{"id":"semetey-2-2013:p1295:b003:l017","ordinal":286356,"en":"Don't rest again,"},{"id":"semetey-2-2013:p1295:b003:l018","ordinal":286357,"en":"It's not good to say bad things."},{"id":"semetey-2-2013:p1295:b003:l019","ordinal":286358,"en":"There is no witch who does not suffer from evil spirits,"},{"id":"semetey-2-2013:p1295:b003:l020","ordinal":286359,"en":"If he rests, it's time"},{"id":"semetey-2-2013:p1295:b003:l021","ordinal":286360,"en":"There is no cure,"},{"id":"semetey-2-2013:p1295:b003:l022","ordinal":286361,"en":"Do not rest"},{"id":"semetey-2-2013:p1295:b003:l023","ordinal":286362,"en":"Put embers in the hearth,"},{"id":"semetey-2-2013:p1295:b003:l024","ordinal":286363,"en":"An iron bullet to the heart of this."},{"id":"semetey-2-2013:p1295:b003:l025","ordinal":286364,"en":"Hard work Kulchoro"},{"id":"semetey-2-2013:p1295:b003:l026","ordinal":286365,"en":"There is no such child in the nation"},{"id":"semetey-2-2013:p1295:b003:l027","ordinal":286366,"en":"If you are obese, this is the season."},{"id":"semetey-2-2013:p1295:b003:l028","ordinal":286367,"en":"Kulchoro is the cooler,"},{"id":"semetey-2-2013:p1295:b003:l029","ordinal":286368,"en":"Makes Akmaral a cow,"},{"id":"semetey-2-2013:p1295:b003:l030","ordinal":286369,"en":"He makes the land rich,"},{"id":"semetey-2-2013:p1295:b003:l031","ordinal":286370,"en":"The blue deer chases cows,"},{"id":"semetey-2-2013:p1295:b003:l032","ordinal":286371,"en":"This is a visible fire extinguisher"},{"id":"semetey-2-2013:p1295:b003:l033","ordinal":286372,"en":"He enriches the visible land,"},{"id":"semetey-2-2013:p1295:b003:l034","ordinal":286373,"en":"To the sly slave,"},{"id":"semetey-2-2013:p1295:b003:l035","ordinal":286374,"en":"To this mad slave,"},{"id":"semet