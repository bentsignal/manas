[{"id":"semetey-1-2013:p1039:b003:l032","ordinal":156417,"en":"Her white breast laid bare,"},{"id":"semetey-1-2013:p1039:b003:l033","ordinal":156418,"en":"Her white throat exposed,"},{"id":"semetey-1-2013:p1039:b003:l034","ordinal":156419,"en":"Reeled toward the tent,"},{"id":"semetey-1-2013:p1039:b003:l035","ordinal":156420,"en":"And her breath now went cold."},{"id":"semetey-1-2013:p1039:b003:l036","ordinal":156421,"en":"Kanchoro flew like an arrow"},{"id":"semetey-1-2013:p1039:b003:l037","ordinal":156422,"en":"And went to Külchoro."},{"id":"semetey-1-2013:p1039:b003:l038","ordinal":156423,"en":"The two companions met,"},{"id":"semetey-1-2013:p1039:b003:l039","ordinal":156424,"en":"And after endless counsel,"},{"id":"semetey-1-2013:p1039:b004:l001","ordinal":156425,"en":"They began with these words:"},{"id":"semetey-1-2013:p1039:b004:l002","ordinal":156426,"en":"\"Has our hunched-over elder brother"},{"id":"semetey-1-2013:p1039:b004:l003","ordinal":156427,"en":"Now come to grief?"},{"id":"semetey-1-2013:p1039:b004:l004","ordinal":156428,"en":"Quarreling before he has even seen her,"},{"id":"semetey-1-2013:p1039:b004:l005","ordinal":156429,"en":"Has God taken away"},{"id":"semetey-1-2013:p1039:b004:l006","ordinal":156430,"en":"Our rather arrogant prince like this?!"},{"id":"semetey-1-2013:p1039:b004:l007","ordinal":156431,"en":"If he leaves without taking Chürök,"},{"id":"semetey-1-2013:p1039:b004:l008","ordinal":156432,"en":"And we set out for Afghanistan,"},{"id":"semetey-1-2013:p1039:b004:l009","ordinal":156433,"en":"We shall face merciless turmoil,"},{"id":"semetey-1-2013:p1039:b004:l010","ordinal":156434,"en":"We shall see the end of the age."},{"id":"semetey-1-2013:p1039:b004:l011","ordinal":156435,"en":"How could we bow and plead"},{"id":"semetey-1-2013:p1039:b004:l012","ordinal":156436,"en":"With that ass-embracing woman,"},{"id":"semetey-1-2013:p1039:b004:l013","ordinal":156437,"en":"That infidel of furious temper?"},{"id":"semetey-1-2013:p1039:b004:l014","ordinal":156438,"en":"Would she not taunt and devour us:"},{"id":"semetey-1-2013:p1039:b004:l015","ordinal":156439,"en":"'The wife who went willingly"},{"id":"semetey-1-2013:p1039:b004:l016","ordinal":156440,"en":"He returned without taking,'"},{"id":"semetey-1-2013:p1039:b004:l017","ordinal":156441,"en":"Would she not devour us like this!"},{"id":"semetey-1-2013:p1039:b004:l018","ordinal":156442,"en":"My dear Külchoro,"},{"id":"semetey-1-2013:p1039:b004:l019","ordinal":156443,"en":"You were the more resourceful one,"},{"id":"semetey-1-2013:p1039:b004:l020","ordinal":156444,"en":"A ruddy, handsome-faced"},{"id":"semetey-1-2013:p1039:b004:l021","ordinal":156445,"en":"Lad skilled with maidens."},{"id":"semetey-1-2013:p1039:b004:l022","ordinal":156446,"en":"Find a way, Külchoro;"},{"id":"semetey-1-2013:p1039:b004:l023","ordinal":156447,"en":"Go to your sister-in-law,"},{"id":"semetey-1-2013:p1039:b004:l024","ordinal":156448,"en":"Speak to her with tactful words,"},{"id":"semetey-1-2013:p1039:b004:l025","ordinal":156449,"en":"And bring your sister-in-law back!\""},{"id":"semetey-1-2013:p1039:b004:l026","ordinal":156450,"en":"Külchoro flew like an arrow"},{"id":"semetey-1-2013:p1039:b004:l027","ordinal":156451,"en":"And ran to his sister-in-law;"},{"id":"semetey-1-2013:p1039:b004:l028","ordinal":156452,"en":"Kanchoro, sparing no strength,"},{"id":"semetey-1-2013:p1039:b004:l029","ordinal":156453,"en":"Ran to his elder brother."},{"id":"semetey-1-2013:p1039:b004:l030","ordinal":156454,"en":"When he reached the prince,"},{"id":"semetey-1-2013:p1039:b004:l031","ordinal":156455,"en":"Kanchoro stood and said this:"},{"id":"semetey-1-2013:p1039:b004:l032","ordinal":156456,"en":"\"Father, my dear elder brother,"},{"id":"semetey-1-2013:p1039:b004:l033","ordinal":156457,"en":"Where is your good sense?!"},{"id":"semetey-1-2013:p1039:b004:l034","ordinal":156458,"en":"When we were in Talas,"},{"id":"semetey-1-2013:p1039:b004:l035","ordinal":156459,"en":"We used to carve and eat the horse's haunch;"},{"id":"semetey-1-2013:p1039:b004:l036","ordinal":156460,"en":"We said we would subdue the governor"},{"id":"semetey-1-2013:p1039:b004:l037","ordinal":156461,"en":"Without brawling with a woman."},{"id":"semetey-1-2013:p1039:b004:l038","ordinal":156462,"en":"If we turn and go back,"},{"id":"semetey-1-2013:p1039:b004:l039","ordinal":156463,"en":"What shall we say when we arrive"},{"id":"semetey-1-2013:p1040:b003:l001","ordinal":156464,"en":"To your Kyrgyz village in Talas,"},{"id":"semetey-1-2013:p1040:b003:l002","ordinal":156465,"en":"Like men whose days are spent,"},{"id":"semetey-1-2013:p1040:b003:l003","ordinal":156466,"en":"What shall we say when we go"},{"id":"semetey-1-2013:p1040:b003:l004","ordinal":156467,"en":"To your ass-embracing wife?"},{"id":"semetey-1-2013:p1040:b003:l005","ordinal":156468,"en":"Father, silver-eyed and sun-faced,"},{"id":"semetey-1-2013:p1040:b003:l006","ordinal":156469,"en":"Thundering elder brother,"},{"id":"semetey-1-2013:p1040:b003:l007","ordinal":156470,"en":"Could you not bear it"},{"id":"semetey-1-2013:p1040:b003:l008","ordinal":156471,"en":"As a fault upon your neck?"},{"id":"semetey-1-2013:p1040:b003:l009","ordinal":156472,"en":"You hunched over and quarreled"},{"id":"semetey-1-2013:p1040:b003:l010","ordinal":156473,"en":"With the wife you have yet to take."},{"id":"semetey-1-2013:p1040:b003:l011","ordinal":156474,"en":"You swagger, alas for the day;"},{"id":"semetey-1-2013:p1040:b003:l012","ordinal":156475,"en":"Can a husband behave like you?"},{"id":"semetey-1-2013:p1040:b003:l013","ordinal":156476,"en":"By the custom of old,"},{"id":"semetey-1-2013:p1040:b003:l014","ordinal":156477,"en":"While in her father's place,"},{"id":"semetey-1-2013:p1040:b003:l015","ordinal":156478,"en":"A woman holds great power."},{"id":"semetey-1-2013:p1040:b003:l016","ordinal":156479,"en":"You quarreled before taking her—"},{"id":"semetey-1-2013:p1040:b003:l017","ordinal":156480,"en":"Hero, how can your star be fortunate?!"},{"id":"semetey-1-2013:p1040:b003:l018","ordinal":156481,"en":"Put aside your anger,"},{"id":"semetey-1-2013:p1040:b003:l019","ordinal":156482,"en":"Adopt another manner,"},{"id":"semetey-1-2013:p1040:b003:l020","ordinal":156483,"en":"Speak words of reconciliation,"},{"id":"semetey-1-2013:p1040:b003:l021","ordinal":156484,"en":"Take your wife."},{"id":"semetey-1-2013:p1040:b003:l022","ordinal":156485,"en":"If you quarrel with such swagger,"},{"id":"semetey-1-2013:p1040:b003:l023","ordinal":156486,"en":"This conduct of yours is rude."},{"id":"semetey-1-2013:p1040:b003:l024","ordinal":156487,"en":"Oh, my murderous leopard,"},{"id":"semetey-1-2013:p1040:b003:l025","ordinal":156488,"en":"Restrain your anger!\""},{"id":"semetey-1-2013:p1040:b003:l026","ordinal":156489,"en":"Your great-hearted man, scarcely contained,"},{"id":"semetey-1-2013:p1040:b003:l027","ordinal":156490,"en":"Turned aside toward Chürök"},{"id":"semetey-1-2013:p1040:b003:l028","ordinal":156491,"en":"And set his Buudan pacing;"},{"id":"semetey-1-2013:p1040:b003:l029","ordinal":156492,"en":"Külchoro brought back Chürök,"},{"id":"semetey-1-2013:p1040:b003:l030","ordinal":156493,"en":"Daughter of Akun."},{"id":"semetey-1-2013:p1040:b003:l031","ordinal":156494,"en":"Külchoro, son of Almambet,"},{"id":"semetey-1-2013:p1040:b003:l032","ordinal":156495,"en":"Was a tactful kinsman's son,"},{"id":"semetey-1-2013:p1040:b003:l033","ordinal":156496,"en":"A servant beyond reckoning,"},{"id":"semetey-1-2013:p1040:b003:l034","ordinal":156497,"en":"His appearance unlike other men's,"},{"id":"semetey-1-2013:p1040:b003:l035","ordinal":156498,"en":"A fortunate-born champion."},{"id":"semetey-1-2013:p1040:b003:l036","ordinal":156499,"en":"He said this to Aychürök,"},{"id":"semetey-1-2013:p1040:b003:l037","ordinal":156500,"en":"And spoke a scheme no one knew:"},{"id":"semetey-1-2013:p1040:b003:l038","ordinal":156501,"en":"\"There are gossips and old women here;"},{"id":"semetey-1-2013:p1040:b003:l039","ordinal":156502,"en":"All these people are here."},{"id":"semetey-1-2013:p1040:b004:l001","ordinal":156503,"en":"Of the husband she had not yet met,"},{"id":"semetey-1-2013:p1040:b004:l002","ordinal":156504,"en":"Will they not say Aychürök,"},{"id":"semetey-1-2013:p1040:b004:l003","ordinal":156505,"en":"Daughter of Akun, became a bully?"},{"id":"semetey-1-2013:p1040:b004:l004","ordinal":156506,"en":"With the husband she had not yet met,"},{"id":"semetey-1-2013:p1040:b004:l005","ordinal":156507,"en":"Quarreling out on the steppe,"},{"id":"semetey-1-2013:p1040:b004:l006","ordinal":156508,"en":"Will they not say Aychürök,"},{"id":"semetey-1-2013:p1040:b004:l007","ordinal":156509,"en":"In her distress, became loose-tongued?"},{"id":"semetey-1-2013:p1040:b004:l008","ordinal":156510,"en":"Begin with gracious conduct,"},{"id":"semetey-1-2013:p1040:b004:l009","ordinal":156511,"en":"Put aside this anger,"},{"id":"semetey-1-2013:p1040:b004:l010","ordinal":156512,"en":"Go to your gray-maned wolf,"},{"id":"semetey-1-2013:p1040:b004:l011","ordinal":156513,"en":"Take him about the neck,"},{"id":"semetey-1-2013:p1040:b004:l012","ordinal":156514,"en":"And indulge in a little affection."},{"id":"semetey-1-2013:p1040:b004:l013","ordinal":156515,"en":"Can a woman who quarreled as a maiden"},{"id":"semetey-1-2013:p1040:b004:l014","ordinal":156516,"en":"Be like you?"},{"id":"semetey-1-2013:p1040:b004:l015","ordinal":156517,"en":"If you keep matching yourself"},{"id":"semetey-1-2013:p1040:b004:l016","ordinal":156518,"en":"Against the proud gray wolf, sister-in-law,"},{"id":"semetey-1-2013:p1040:b004:l017","ordinal":156519,"en":"Will your affairs ever prosper?"},{"id":"semetey-1-2013:p1040:b004:l018","ordinal":156520,"en":"Are there people like you two,"},{"id":"semetey-1-2013:p1040:b004:l019","ordinal":156521,"en":"Who quarrel before even seeing each other?!\""},{"id":"semetey-1-2013:p1040:b004:l020","ordinal":156522,"en":"Kanchoro and Külchoro"},{"id":"semetey-1-2013:p1040:b004:l021","ordinal":156523,"en":"Had remained there together;"},{"id":"semetey-1-2013:p1040:b004:l022","ordinal":156524,"en":"Each leading one of the pair,"},{"id":"semetey-1-2013:p1040:b004:l023","ordinal":156525,"en":"Kanchoro now escorted"},{"id":"semetey-1-2013:p1040:b004:l024","ordinal":156526,"en":"The swaggering prince back,"},{"id":"semetey-1-2013:p1040:b004:l025","ordinal":156527,"en":"And Külchoro now escorted"},{"id":"semetey-1-2013:p1040:b004:l026","ordinal":156528,"en":"The silent Chürök back."},{"id":"semetey-1-2013:p1040:b004:l027","ordinal":156529,"en":"Clouds drifted together in the sky;"},{"id":"semetey-1-2013:p1040:b004:l028","ordinal":156530,"en":"The two wild rams made peace."},{"id":"semetey-1-2013:p1040:b004:l029","ordinal":156531,"en":"They met and clasped hands,"},{"id":"semetey-1-2013:p1040:b004:l030","ordinal":156532,"en":"And these two, swaggering,"},{"id":"semetey-1-2013:p1040:b004:l031","ordinal":156533,"en":"Kissed each other upon the throat."},{"id":"semetey-1-2013:p1040:b004:l032","ordinal":156534,"en":"They put aside angry words"},{"id":"semetey-1-2013:p1040:b004:l033","ordinal":156535,"en":"And began words of play."},{"id":"semetey-1-2013:p1040:b004:l034","ordinal":156536,"en":"Like the Pleiades in the sky,"},{"id":"semetey-1-2013:p1040:b004:l035","ordinal":156537,"en":"They were joined together now;"},{"id":"semetey-1-2013:p1040:b004:l036","ordinal":156538,"en":"Aychürök and Semetey"},{"id":"semetey-1-2013:p1040:b004:l037","ordinal":156539,"en":"Were united now."},{"id":"semetey-1-2013:p1040:b004:l038","ordinal":156540,"en":"The luckless daughter of Akun,"},{"id":"semetey-1-2013:p1041:b003:l001","ordinal":156541,"en":"Showing her distinction,"},{"id":"semetey-1-2013:p1041:b003:l002","ordinal":156542,"en":"Led the great-hearted hero"},{"id":"semetey-1-2013:p1041:b003:l003","ordinal":156543,"en":"Into the gilded tent."},{"id":"semetey-1-2013:p1041:b003:l004","ordinal":156544,"en":"They spoke in whispers,"},{"id":"semetey-1-2013:p1041:b003:l005","ordinal":156545,"en":"And laughed with ringing voices;"},{"id":"semetey-1-2013:p1041:b003:l006","ordinal":156546,"en":"They offered arak for thirst,"},{"id":"semetey-1-2013:p1041:b003:l007","ordinal":156547,"en":"And gave a handsome feast."},{"id":"semetey-1-2013:p1041:b003:l008","ordinal":156548,"en":"They quenched his thirst with kumis,"},{"id":"semetey-1-2013:p1041:b003:l009","ordinal":156549,"en":"Unbred colts brought in the train,"},{"id":"semetey-1-2013:p1041:b003:l010","ordinal":156550,"en":"Forty slaughtered in a row;"},{"id":"semetey-1-2013:p1041:b004:l001","ordinal":156551,"en":"They had fat lambs and unbred colts"},{"id":"semetey-1-2013:p1041:b004:l002","ordinal":156552,"en":"Slaughtered together,"},{"id":"semetey-1-2013:p1041:b004:l003","ordinal":156553,"en":"And had sweet food and choice meat"},{"id":"semetey-1-2013:p1041:b004:l004","ordinal":156554,"en":"Boiled until tender;"},{"id":"semetey-1-2013:p1041:b004:l005","ordinal":156555,"en":"They had them gnaw sugar like snow"},{"id":"semetey-1-2013:p1041:b004:l006","ordinal":156556,"en":"And sip black tea."},{"id":"semetey-1-2013:p1041:b004:l007","ordinal":156557,"en":"\"Let our sultan, who arrived exhausted,"},{"id":"semetey-1-2013:p1041:b004:l008","ordinal":156558,"en":"Recover his strength,\" they said;"},{"id":"semetey-1-2013:p1041:b004:l009","ordinal":156559,"en":"Each applied himself eagerly"},{"id":"semetey-1-2013:p1041:b004:l010","ordinal":156560,"en":"And set out food of countless kinds."},{"id":"semetey-1-2013:p1041:b006:l001","ordinal":156561,"en":"Glen with springs and sheer cliff—"},{"id":"semetey-1-2013:p1041:b006:l002","ordinal":156562,"en":"Herself wise, the luckless one,"},{"id":"semetey-1-2013:p1041:b006:l003","ordinal":156563,"en":"Akun's daughter, the bold woman,"},{"id":"semetey-1-2013:p1041:b006:l004","ordinal":156564,"en":"Beside the great Ürgönch,"},{"id":"semetey-1-2013:p1041:b006:l005","ordinal":156565,"en":"As dusk fell and the sun set,"},{"id":"semetey-1-2013:p1041:b006:l006","ordinal":156566,"en":"Had the tents folded"},{"id":"semetey-1-2013:p1041:b006:l007","ordinal":156567,"en":"And loaded on every camel."},{"id":"semetey-1-2013:p1041:b006:l008","ordinal":156568,"en":"\"Let my king, my princely leopard,"},{"id":"semetey-1-2013:p1041:b006:l009","ordinal":156569,"en":"Enter and travel through Afghanistan,"},{"id":"semetey-1-2013:p1041:b006:l010","ordinal":156570,"en":"And be immersed in every delight;"},{"id":"semetey-1-2013:p1041:b006:l011","ordinal":156571,"en":"The white palace prepared for him—"},{"id":"semetey-1-2013:p1041:b006:l012","ordinal":156572,"en":"Let him lie in that white palace;"},{"id":"semetey-1-2013:p1041:b006:l013","ordinal":156573,"en":"Let my hero take his fill of affection"},{"id":"semetey-1-2013:p1041:b006:l014","ordinal":156574,"en":"And be immersed in great delight,\" she said."},{"id":"semetey-1-2013:p1041:b006:l015","ordinal":156575,"en":"Fourteen horses bred in Ogoy,"},{"id":"semetey-1-2013:p1041:b006:l016","ordinal":156576,"en":"And at the head of the fourteen horses,"},{"id":"semetey-1-2013:p1041:b006:l017","ordinal":156577,"en":"A white shaft tied in a ring,"},{"id":"semetey-1-2013:p1041:b006:l018","ordinal":156578,"en":"A shaft fit for fourteen horses—"},{"id":"semetey-1-2013:p1041:b006:l019","ordinal":156579,"en":"Your formidable sister-in-law Chürök,"},{"id":"semetey-1-2013:p1041:b006:l020","ordinal":156580,"en":"Showing her extravagance,"},{"id":"semetey-1-2013:p1041:b006:l021","ordinal":156581,"en":"Had swaggering Buurul"},{"id":"semetey-1-2013:p1041:b006:l022","ordinal":156582,"en":"Mounted by her attendant."},{"id":"semetey-1-2013:p1041:b006:l023","ordinal":156583,"en":"Your accomplished sister-in-law Chürök"},{"id":"semetey-1-2013:p1041:b006:l024","ordinal":156584,"en":"Wore a loose silk robe,"},{"id":"semetey-1-2013:p1041:b008:l001","ordinal":156585,"en":"And rode a pacing ambler."},{"id":"semetey-1-2013:p1041:b008:l002","ordinal":156586,"en":"Unnoticed by a single person,"},{"id":"semetey-1-2013:p1041:b008:l003","ordinal":156587,"en":"Unseen by anyone,"},{"id":"semetey-1-2013:p1041:b008:l004","ordinal":156588,"en":"As dusk fell and the sun set,"},{"id":"semetey-1-2013:p1041:b008:l005","ordinal":156589,"en":"When the people were first settling to sleep,"},{"id":"semetey-1-2013:p1041:b008:l006","ordinal":156590,"en":"She set out toward Afghanistan."},{"id":"semetey-1-2013:p1041:b008:l007","ordinal":156591,"en":"She arranged a splendid spectacle,"},{"id":"semetey-1-2013:p1041:b008:l008","ordinal":156592,"en":"And had fourteen swaggering horses"},{"id":"semetey-1-2013:p1041:b008:l009","ordinal":156593,"en":"Led along riderless;"},{"id":"semetey-1-2013:p1041:b008:l010","ordinal":156594,"en":"Ahead of the fourteen horses"},{"id":"semetey-1-2013:p1041:b008:l011","ordinal":156595,"en":"She arrayed all the maidens,"},{"id":"semetey-1-2013:p1041:b008:l012","ordinal":156596,"en":"And to make the bride and young man"},{"id":"semetey-1-2013:p1041:b008:l013","ordinal":156597,"en":"Disappear without leaving a trail,"},{"id":"semetey-1-2013:p1041:b008:l014","ordinal":156598,"en":"Behind the fourteen horses"},{"id":"semetey-1-2013:p1041:b008:l015","ordinal":156599,"en":"She strung them out in a festive procession."},{"id":"semetey-1-2013:p1041:b008:l016","ordinal":156600,"en":"The luckless daughter of Akun"},{"id":"semetey-1-2013:p1041:b008:l017","ordinal":156601,"en":"Set her affairs in order like this,"},{"id":"semetey-1-2013:p1041:b008:l018","ordinal":156602,"en":"And erased every trace."},{"id":"semetey-1-2013:p1041:b008:l019","ordinal":156603,"en":"The reason she erased the tracks was this:"},{"id":"semetey-1-2013:p1041:b008:l020","ordinal":156604,"en":"The fourteen horses were known as racers,"},{"id":"semetey-1-2013:p1041:b008:l021","ordinal":156605,"en":"And their tracks might be recognized;"},{"id":"semetey-1-2013:p1041:b008:l022","ordinal":156606,"en":"If Chynkozho, son of Shygay,"},{"id":"semetey-1-2013:p1041:b008:l023","ordinal":156607,"en":"Should learn of it by chance,"},{"id":"semetey-1-2013:p1041:b008:l024","ordinal":156608,"en":"He would begin a fierce shoot-out, she thought,"},{"id":"semetey-1-2013:p1042:b003:l001","ordinal":156609,"en":"\"My dear princely leopard,"},{"id":"semetey-1-2013:p1042:b003:l002","ordinal":156610,"en":"Before he has had time to rest,"},{"id":"semetey-1-2013:p1042:b003:l003","ordinal":156611,"en":"Will be left with regret,\" she thought."},{"id":"semetey-1-2013:p1042:b003:l004","ordinal":156612,"en":"Aychürök stood thinking this,"},{"id":"semetey-1-2013:p1042:b003:l005","ordinal":156613,"en":"Conceiving a scheme no one knew,"},{"id":"semetey-1-2013:p1042:b003:l006","ordinal":156614,"en":"Displaying her great wisdom,"},{"id":"semetey-1-2013:p1042:b003:l007","ordinal":156615,"en":"And guided the heroic prince and sultan"},{"id":"semetey-1-2013:p1042:b003:l008","ordinal":156616,"en":"Toward Afghanistan."},{"id":"semetey-1-2013:p1042:b003:l009","ordinal":156617,"en":"They entered Kara-Shaar;"},{"id":"semetey-1-2013:p1042:b003:l010","ordinal":156618,"en":"It was Khan Akun's city,"},{"id":"semetey-1-2013:p1042:b003:l011","ordinal":156619,"en":"A settlement of the populous Afghans."},{"id":"semetey-1-2013:p1042:b003:l012","ordinal":156620,"en":"Aychürök, who led them,"},{"id":"semetey-1-2013:p1042:b003:l013","ordinal":156621,"en":"Was the master among women,"},{"id":"semetey-1-2013:p1042:b003:l014","ordinal":156622,"en":"And the daughter of Khan Akun."},{"id":"semetey-1-2013:p1042:b003:l015","ordinal":156623,"en":"When they reached great Afghanistan,"},{"id":"semetey-1-2013:p1042:b003:l016","ordinal":156624,"en":"Its mastiffs barked thunderously,"},{"id":"semetey-1-2013:p1042:b003:l017","ordinal":156625,"en":"Its bitches yelped and barked,"},{"id":"semetey-1-2013:p1042:b003:l018","ordinal":156626,"en":"Its donkeys brayed on the rooftops,"},{"id":"semetey-1-2013:p1042:b003:l019","ordinal":156627,"en":"And roosters crowed from the city."},{"id":"semetey-1-2013:p1042:b003:l020","ordinal":156628,"en":"Broad Afghanistan lay there,"},{"id":"semetey-1-2013:p1042:b003:l021","ordinal":156629,"en":"Divided into guarded quarters,"},{"id":"semetey-1-2013:p1042:b003:l022","ordinal":156630,"en":"With dark smoke visible."},{"id":"semetey-1-2013:p1042:b003:l023","ordinal":156631,"en":"Broad Afghanistan lay there;"},{"id":"semetey-1-2013:p1042:b003:l024","ordinal":156632,"en":"Having traveled far upon the road,"},{"id":"semetey-1-2013:p1042:b003:l025","ordinal":156633,"en":"The lions filed into"},{"id":"semetey-1-2013:p1042:b003:l026","ordinal":156634,"en":"The palace prepared for them."},{"id":"semetey-1-2013:p1042:b003:l027","ordinal":156635,"en":"Aychürök's white palace"},{"id":"semetey-1-2013:p1042:b003:l028","ordinal":156636,"en":"Had iron gates and solid tin;"},{"id":"semetey-1-2013:p1042:b003:l029","ordinal":156637,"en":"Though the poor woman was only a maiden,"},{"id":"semetey-1-2013:p1042:b003:l030","ordinal":156638,"en":"Her retinue was exceedingly great."},{"id":"semetey-1-2013:p1042:b003:l031","ordinal":156639,"en":"At the mouth of the doorway,"},{"id":"semetey-1-2013:p1042:b003:l032","ordinal":156640,"en":"The champions posted as guards,"},{"id":"semetey-1-2013:p1042:b003:l033","ordinal":156641,"en":"Holding clubs as large as houses,"},{"id":"semetey-1-2013:p1042:b003:l034","ordinal":156642,"en":"All eighty rose to their feet."},{"id":"semetey-1-2013:p1042:b003:l035","ordinal":156643,"en":"Passing among those eighty,"},{"id":"semetey-1-2013:p1042:b003:l036","ordinal":156644,"en":"Your sister-in-law went on."},{"id":"semetey-1-2013:p1042:b003:l037","ordinal":156645,"en":"She murmured to some,"},{"id":"semetey-1-2013:p1042:b003:l038","ordinal":156646,"en":"And whispered to others;"},{"id":"semetey-1-2013:p1042:b003:l039","ordinal":156647,"en":"When they heard this news,"},{"id":"semetey-1-2013:p1042:b004:l001","ordinal":156648,"en":"The guards flew like arrows"},{"id":"semetey-1-2013:p1042:b004:l002","ordinal":156649,"en":"And took the prince's horse."},{"id":"semetey-1-2013:p1042:b004:l003","ordinal":156650,"en":"At a pillar whose post was gold,"},{"id":"semetey-1-2013:p1042:b004:l004","ordinal":156651,"en":"They tethered the exhausted Buurul"},{"id":"semetey-1-2013:p1042:b004:l005","ordinal":156652,"en":"High and secure."},{"id":"semetey-1-2013:p1042:b004:l006","ordinal":156653,"en":"Aychürök's forty young women"},{"id":"semetey-1-2013:p1042:b004:l007","ordinal":156654,"en":"Tied up horses in a bustle;"},{"id":"semetey-1-2013:p1042:b004:l008","ordinal":156655,"en":"Their quickness was beyond measure,"},{"id":"semetey-1-2013:p1042:b004:l009","ordinal":156656,"en":"As they tied them fast in a flash."},{"id":"semetey-1-2013:p1042:b004:l010","ordinal":156657,"en":"Within the white palace,"},{"id":"semetey-1-2013:p1042:b004:l011","ordinal":156658,"en":"In the great ceremonial pavilion,"},{"id":"semetey-1-2013:p1042:b004:l012","ordinal":156659,"en":"Akylay flew like an arrow,"},{"id":"semetey-1-2013:p1042:b004:l013","ordinal":156660,"en":"And his sister-in-law opened the door."},{"id":"semetey-1-2013:p1042:b004:l014","ordinal":156661,"en":"Led by the prince who had brought them,"},{"id":"semetey-1-2013:p1042:b004:l015","ordinal":156662,"en":"Twenty-five people entered now."},{"id":"semetey-1-2013:p1042:b004:l016","ordinal":156663,"en":"The prince now mounted the place of honor,"},{"id":"semetey-1-2013:p1042:b004:l017","ordinal":156664,"en":"An enormous golden throne like a camel."},{"id":"semetey-1-2013:p1042:b004:l018","ordinal":156665,"en":"Around it stood a grove of plane trees,"},{"id":"semetey-1-2013:p1042:b004:l019","ordinal":156666,"en":"And in its center a golden throne;"},{"id":"semetey-1-2013:p1042:b004:l020","ordinal":156667,"en":"This was a garden granted by the Creator."},{"id":"semetey-1-2013:p1042:b004:l021","ordinal":156668,"en":"The princely leopard Semetey"},{"id":"semetey-1-2013:p1042:b004:l022","ordinal":156669,"en":"At this time had gone as a bridegroom"},{"id":"semetey-1-2013:p1042:b004:l023","ordinal":156670,"en":"To Khan Akun's city."},{"id":"semetey-1-2013:p1042:b004:l024","ordinal":156671,"en":"Your renowned sister-in-law Aychürök—"},{"id":"semetey-1-2013:p1042:b004:l025","ordinal":156672,"en":"Ask not about the hero's estate;"}]
