[{"id":"manas-2010:p1397:b001:l027","ordinal":60417,"en":"Let me go to Inner Beijing!"},{"id":"manas-2010:p1397:b001:l028","ordinal":60418,"en":"Karykan, who knows my worth—"},{"id":"manas-2010:p1397:b001:l029","ordinal":60419,"en":"Let me reach Karykan!"},{"id":"manas-2010:p1397:b001:l030","ordinal":60420,"en":"From Khan-Too of the jinn and spirits,"},{"id":"manas-2010:p1397:b001:l031","ordinal":60421,"en":"All the Chinese on this side"},{"id":"manas-2010:p1397:b001:l032","ordinal":60422,"en":"Let me gather utterly;"},{"id":"manas-2010:p1397:b001:l033","ordinal":60423,"en":"Let me reach their very roots,"},{"id":"manas-2010:p1397:b001:l034","ordinal":60424,"en":"And the Burut, from their roots up,"},{"id":"manas-2010:p1397:b001:l035","ordinal":60425,"en":"Let me slaughter every one!”"},{"id":"manas-2010:p1397:b001:l036","ordinal":60426,"en":"Raging, Kongurbay,"},{"id":"manas-2010:p1397:b001:l037","ordinal":60427,"en":"Renouncing Outer Beijing,"},{"id":"manas-2010:p1397:b001:l038","ordinal":60428,"en":"Went beyond all bounds, did you see?"},{"id":"manas-2010:p1397:b001:l039","ordinal":60429,"en":"Upon the great khan, greatest of forty khans,"},{"id":"manas-2010:p1397:b001:l040","ordinal":60430,"en":"Pressure fell, and the grim-faced wretch"},{"id":"manas-2010:p1397:b001:l041","ordinal":60431,"en":"Fled away, did you see!"},{"id":"manas-2010:p1397:b001:l042","ordinal":60432,"en":"To Esenkan in Outer Beijing,"},{"id":"manas-2010:p1398:b001:l001","ordinal":60433,"en":"To Esenkan’s gate—"},{"id":"manas-2010:p1398:b001:l002","ordinal":60434,"en":"The two envoys then,"},{"id":"manas-2010:p1398:b001:l003","ordinal":60435,"en":"They arrived, did you see?"},{"id":"manas-2010:p1398:b001:l004","ordinal":60436,"en":"Esenkan’s gate—"},{"id":"manas-2010:p1398:b001:l005","ordinal":60437,"en":"Its doorway was exceedingly narrow."},{"id":"manas-2010:p1398:b001:l006","ordinal":60438,"en":"To keep strangers from entering,"},{"id":"manas-2010:p1398:b001:l007","ordinal":60439,"en":"It had a sorcerer."},{"id":"manas-2010:p1398:b001:l008","ordinal":60440,"en":"Looking to one side—"},{"id":"manas-2010:p1398:b001:l009","ordinal":60441,"en":"A dragon stood ready to suck them in;"},{"id":"manas-2010:p1398:b001:l010","ordinal":60442,"en":"Looking toward one edge—"},{"id":"manas-2010:p1398:b001:l011","ordinal":60443,"en":"A marksman stood ready to shoot."},{"id":"manas-2010:p1398:b001:l012","ordinal":60444,"en":"Looking to one side—"},{"id":"manas-2010:p1398:b001:l013","ordinal":60445,"en":"A boar stood ready to strike;"},{"id":"manas-2010:p1398:b001:l014","ordinal":60446,"en":"Looking to one side—"},{"id":"manas-2010:p1398:b001:l015","ordinal":60447,"en":"A tiger stood ready to tear them apart."},{"id":"manas-2010:p1398:b001:l016","ordinal":60448,"en":"Such sorcery as this"},{"id":"manas-2010:p1398:b001:l017","ordinal":60449,"en":"Ajybay and Ürbü beheld."},{"id":"manas-2010:p1398:b001:l018","ordinal":60450,"en":"Ajybay’s Kartküröng,"},{"id":"manas-2010:p1398:b001:l019","ordinal":60451,"en":"Though he lacked a tongue to speak,"},{"id":"manas-2010:p1398:b001:l020","ordinal":60452,"en":"Was a beast wiser than other creatures."},{"id":"manas-2010:p1398:b001:l021","ordinal":60453,"en":"Counting his years of maturity,"},{"id":"manas-2010:p1398:b001:l022","ordinal":60454,"en":"His count of mature years was sixty."},{"id":"manas-2010:p1398:b001:l023","ordinal":60455,"en":"Coming forward at an amble,"},{"id":"manas-2010:p1398:b001:l024","ordinal":60456,"en":"Hero Ürbü lost his wits,"},{"id":"manas-2010:p1398:b001:l025","ordinal":60457,"en":"Cowering toward Ajybay."},{"id":"manas-2010:p1398:b001:l026","ordinal":60458,"en":"That Ürbü had grown afraid,"},{"id":"manas-2010:p1398:b001:l027","ordinal":60459,"en":"Hero Ajybay now understood."},{"id":"manas-2010:p1398:b001:l028","ordinal":60460,"en":"“To stand here frightened like this—"},{"id":"manas-2010:p1398:b001:l029","ordinal":60461,"en":"Our home, Keng-Kol and Talas, is not here;"},{"id":"manas-2010:p1398:b001:l030","ordinal":60462,"en":"Majestic Manas is not here!"},{"id":"manas-2010:p1398:b001:l031","ordinal":60463,"en":"You are a witless man."},{"id":"manas-2010:p1398:b001:l032","ordinal":60464,"en":"When the command comes from Allah,"},{"id":"manas-2010:p1398:b001:l033","ordinal":60465,"en":"When Gabriel, the angel of death,"},{"id":"manas-2010:p1398:b001:l034","ordinal":60466,"en":"Stretches out his five hands,"},{"id":"manas-2010:p1398:b001:l035","ordinal":60467,"en":"Must not a poor mortal die?"},{"id":"manas-2010:p1398:b001:l036","ordinal":60468,"en":"Whatever deed is laid upon him,"},{"id":"manas-2010:p1398:b001:l037","ordinal":60469,"en":"Must not a poor mortal endure it!"},{"id":"manas-2010:p1398:b001:l038","ordinal":60470,"en":"Strange is this treacherous world;"},{"id":"manas-2010:p1398:b001:l039","ordinal":60471,"en":"We have seen its wonders."},{"id":"manas-2010:p1398:b001:l040","ordinal":60472,"en":"Our multitude of Burut,"},{"id":"manas-2010:p1398:b001:l041","ordinal":60473,"en":"When our people chose us,"},{"id":"manas-2010:p1398:b001:l042","ordinal":60474,"en":"Receiving Khan Koshoy’s blessing,"},{"id":"manas-2010:p1399:b001:l001","ordinal":60475,"en":"We have come as envoys."},{"id":"manas-2010:p1399:b001:l002","ordinal":60476,"en":"When we mounted and set out this way—"},{"id":"manas-2010:p1399:b001:l003","ordinal":60477,"en":"Consider what I am telling you—"},{"id":"manas-2010:p1399:b001:l004","ordinal":60478,"en":"We died already then!"},{"id":"manas-2010:p1399:b001:l005","ordinal":60479,"en":"To shelter those who cower,"},{"id":"manas-2010:p1399:b001:l006","ordinal":60480,"en":"Khans Muzburchak and Kökchö are not here;"},{"id":"manas-2010:p1399:b001:l007","ordinal":60481,"en":"If a day of torment comes from the Chinese,"},{"id":"manas-2010:p1399:b001:l008","ordinal":60482,"en":"To rescue us,"},{"id":"manas-2010:p1399:b001:l009","ordinal":60483,"en":"Almambet and Chubak are not here either!"},{"id":"manas-2010:p1399:b001:l010","ordinal":60484,"en":"We are dead, not alive;"},{"id":"manas-2010:p1399:b001:l011","ordinal":60485,"en":"We are among the dead."},{"id":"manas-2010:p1399:b001:l012","ordinal":60486,"en":"Let us take the sword Zhoybolot;"},{"id":"manas-2010:p1399:b001:l013","ordinal":60487,"en":"If their conduct looks evil,"},{"id":"manas-2010:p1399:b001:l014","ordinal":60488,"en":"Rather than simply die,"},{"id":"manas-2010:p1399:b001:l015","ordinal":60489,"en":"Let us take an enemy down as our pillow!”"},{"id":"manas-2010:p1399:b001:l016","ordinal":60490,"en":"Though Ajybay spoke this way,"},{"id":"manas-2010:p1399:b001:l017","ordinal":60491,"en":"Ürbü did not cease to fear."},{"id":"manas-2010:p1399:b001:l018","ordinal":60492,"en":"When courage left Ürbü,"},{"id":"manas-2010:p1399:b001:l019","ordinal":60493,"en":"Making his eyes blaze like a lion’s,"},{"id":"manas-2010:p1399:b001:l020","ordinal":60494,"en":"Kartküröng, his mount,"},{"id":"manas-2010:p1399:b001:l021","ordinal":60495,"en":"He had Ürbü hold firmly."},{"id":"manas-2010:p1399:b001:l022","ordinal":60496,"en":"The renowned companion Ajybay,"},{"id":"manas-2010:p1399:b001:l023","ordinal":60497,"en":"Broad of jaw and broad of tongue,"},{"id":"manas-2010:p1399:b001:l024","ordinal":60498,"en":"Was a man who made no mistake,"},{"id":"manas-2010:p1399:b001:l025","ordinal":60499,"en":"A surpassingly eloquent soul,"},{"id":"manas-2010:p1399:b001:l026","ordinal":60500,"en":"Who knew seventy kinds of language,"},{"id":"manas-2010:p1399:b001:l027","ordinal":60501,"en":"A hero who cultivated wisdom."},{"id":"manas-2010:p1399:b001:l028","ordinal":60502,"en":"Girding on his Zhoybolot,"},{"id":"manas-2010:p1399:b001:l029","ordinal":60503,"en":"Before Esenkan"},{"id":"manas-2010:p1399:b001:l030","ordinal":60504,"en":"He was the one who entered alone."},{"id":"manas-2010:p1399:b001:l031","ordinal":60505,"en":"As was the custom of envoys,"},{"id":"manas-2010:p1399:b001:l032","ordinal":60506,"en":"When he entered the door,"},{"id":"manas-2010:p1399:b001:l033","ordinal":60507,"en":"Bowing like a young bride,"},{"id":"manas-2010:p1399:b001:l034","ordinal":60508,"en":"Bending his knees to the ground,"},{"id":"manas-2010:p1399:b001:l035","ordinal":60509,"en":"He bowed his head to Esenkan."},{"id":"manas-2010:p1399:b001:l036","ordinal":60510,"en":"Before Esenkan,"},{"id":"manas-2010:p1399:b001:l037","ordinal":60511,"en":"A golden throne gleaming with gold;"},{"id":"manas-2010:p1399:b001:l038","ordinal":60512,"en":"Around his throne,"},{"id":"manas-2010:p1399:b001:l039","ordinal":60513,"en":"Dark trees planted in a surrounding ring."},{"id":"manas-2010:p1399:b001:l040","ordinal":60514,"en":"Before his doorway,"},{"id":"manas-2010:p1399:b001:l041","ordinal":60515,"en":"Many wrestlers stood ready;"},{"id":"manas-2010:p1399:b001:l042","ordinal":60516,"en":"Without shrinking from the wrestlers,"},{"id":"manas-2010:p1400:b001:l001","ordinal":60517,"en":"Ajybay walked past."},{"id":"manas-2010:p1400:b001:l002","ordinal":60518,"en":"Beside Esenkan,"},{"id":"manas-2010:p1400:b001:l003","ordinal":60519,"en":"Ay Jangjung and Kün Jangjung"},{"id":"manas-2010:p1400:b001:l004","ordinal":60520,"en":"Were sitting together then."},{"id":"manas-2010:p1400:b001:l005","ordinal":60521,"en":"Before them, these were"},{"id":"manas-2010:p1400:b001:l006","ordinal":60522,"en":"The words Ajybay spoke:"},{"id":"manas-2010:p1400:b001:l007","ordinal":60523,"en":"“Renowned hero Manas has come,"},{"id":"manas-2010:p1400:b001:l008","ordinal":60524,"en":"Who broke the Oirat and took spoils,"},{"id":"manas-2010:p1400:b001:l009","ordinal":60525,"en":"Who broke through their midst and made a road;"},{"id":"manas-2010:p1400:b001:l010","ordinal":60526,"en":"Champion Manas, the lion, has come."},{"id":"manas-2010:p1400:b001:l011","ordinal":60527,"en":"Before hero Manas,"},{"id":"manas-2010:p1400:b001:l012","ordinal":60528,"en":"Told to drink water, they drank poison;"},{"id":"manas-2010:p1400:b001:l013","ordinal":60529,"en":"Told to take a cap, they cut off a head;"},{"id":"manas-2010:p1400:b001:l014","ordinal":60530,"en":"Told to spill blood, they spilled guts;"},{"id":"manas-2010:p1400:b001:l015","ordinal":60531,"en":"At talk of turmoil, they grew eager;"},{"id":"manas-2010:p1400:b001:l016","ordinal":60532,"en":"At talk of strife, they rejoiced;"},{"id":"manas-2010:p1400:b001:l017","ordinal":60533,"en":"Who never turned back from the enemy,"},{"id":"manas-2010:p1400:b001:l018","ordinal":60534,"en":"Who never fled in fear of death,"},{"id":"manas-2010:p1400:b001:l019","ordinal":60535,"en":"Who never drew back an outstretched spear,"},{"id":"manas-2010:p1400:b001:l020","ordinal":60536,"en":"Who never returned downcast from battle—"},{"id":"manas-2010:p1400:b001:l021","ordinal":60537,"en":"The earth split and trembled—"},{"id":"manas-2010:p1400:b001:l022","ordinal":60538,"en":"Khan Manas’s forty companions,"},{"id":"manas-2010:p1400:b001:l023","ordinal":60539,"en":"Before hero Manas,"},{"id":"manas-2010:p1400:b001:l024","ordinal":60540,"en":"All forty have come together."},{"id":"manas-2010:p1400:b001:l025","ordinal":60541,"en":"Of whoever said, ‘I have only one horse,’"},{"id":"manas-2010:p1400:b001:l026","ordinal":60542,"en":"They slaughtered and ate the horse as they came."},{"id":"manas-2010:p1400:b001:l027","ordinal":60543,"en":"With Beijing, which other mighty men cannot reach,"},{"id":"manas-2010:p1400:b001:l028","ordinal":60544,"en":"‘I shall do battle,’ he has come saying."},{"id":"manas-2010:p1400:b001:l029","ordinal":60545,"en":"Among horses, the steed is piebald-headed;"},{"id":"manas-2010:p1400:b001:l030","ordinal":60546,"en":"If you ask of his outstanding champions,"},{"id":"manas-2010:p1400:b001:l031","ordinal":60547,"en":"Almambet and Chubak, their names rhyme."},{"id":"manas-2010:p1400:b001:l032","ordinal":60548,"en":"Understand his reckoning, Esenkan;"},{"id":"manas-2010:p1400:b001:l033","ordinal":60549,"en":"Sending me as envoy,"},{"id":"manas-2010:p1400:b001:l034","ordinal":60550,"en":"‘What shall I do?’ he has come asking."},{"id":"manas-2010:p1400:b001:l035","ordinal":60551,"en":"Ay Jangjung’s daughter Birmyskal,"},{"id":"manas-2010:p1400:b001:l036","ordinal":60552,"en":"Esenkan’s daughter Burulcha—"},{"id":"manas-2010:p1400:b001:l037","ordinal":60553,"en":"‘If my strength suffices, the two"},{"id":"manas-2010:p1400:b001:l038","ordinal":60554,"en":"I shall take as tribute,’ he has come saying."},{"id":"manas-2010:p1400:b001:l039","ordinal":60555,"en":"I have more words to speak:"},{"id":"manas-2010:p1400:b001:l040","ordinal":60556,"en":"The mighty one among the forty companions,"},{"id":"manas-2010:p1400:b001:l041","ordinal":60557,"en":"Their fierce Khan Bakay is there,"},{"id":"manas-2010:p1400:b001:l042","ordinal":60558,"en":"Who never rests upon an elbow,"},{"id":"manas-2010:p1401:b001:l001","ordinal":60559,"en":"Who never takes even a moment’s sleep;"},{"id":"manas-2010:p1401:b001:l002","ordinal":60560,"en":"His strength can match the world."},{"id":"manas-2010:p1401:b001:l003","ordinal":60561,"en":"He and Manas, the two,"},{"id":"manas-2010:p1401:b001:l004","ordinal":60562,"en":"Are sons of brothers."},{"id":"manas-2010:p1401:b001:l005","ordinal":60563,"en":"Renowned Syrgak is there too."},{"id":"manas-2010:p1401:b001:l006","ordinal":60564,"en":"Behind that Syrgak,"},{"id":"manas-2010:p1401:b001:l007","ordinal":60565,"en":"Wearing coats no bullet can pierce,"},{"id":"manas-2010:p1401:b001:l008","ordinal":60566,"en":"Riding extraordinary steeds,"},{"id":"manas-2010:p1401:b001:l009","ordinal":60567,"en":"All twelve khans are there."},{"id":"manas-2010:p1401:b001:l010","ordinal":60568,"en":"Among the twelve khans,"},{"id":"manas-2010:p1401:b001:l011","ordinal":60569,"en":"Muzburchak and Kökchö are there,"},{"id":"manas-2010:p1401:b001:l012","ordinal":60570,"en":"Koshoy and Töshtük are there too."},{"id":"manas-2010:p1401:b001:l013","ordinal":60571,"en":"There are peoples of twelve lineages."},{"id":"manas-2010:p1401:b001:l014","ordinal":60572,"en":"To serve as prayer leader,"},{"id":"manas-2010:p1401:b001:l015","ordinal":60573,"en":"Aykozho has come from Mecca;"},{"id":"manas-2010:p1401:b001:l016","ordinal":60574,"en":"Among the mighty army,"},{"id":"manas-2010:p1401:b001:l017","ordinal":60575,"en":"That man is there too."},{"id":"manas-2010:p1401:b001:l018","ordinal":60576,"en":"Left fatherless,"},{"id":"manas-2010:p1401:b001:l019","ordinal":60577,"en":"Ruling a settled people,"},{"id":"manas-2010:p1401:b001:l020","ordinal":60578,"en":"Tethering Maaniker,"},{"id":"manas-2010:p1401:b001:l021","ordinal":60579,"en":"Summoning the whole world,"},{"id":"manas-2010:p1401:b001:l022","ordinal":60580,"en":"Giving his father a memorial feast,"},{"id":"manas-2010:p1401:b001:l023","ordinal":60581,"en":"Making his ancestral spirit renowned as well,"},{"id":"manas-2010:p1401:b001:l024","ordinal":60582,"en":"Kökötöy’s Bokmurun—"},{"id":"manas-2010:p1401:b001:l025","ordinal":60583,"en":"He too is among the army."},{"id":"manas-2010:p1401:b001:l026","ordinal":60584,"en":"Zhamgyrchy of the Eshtek"},{"id":"manas-2010:p1401:b001:l027","ordinal":60585,"en":"Is not a man to sit idle;"},{"id":"manas-2010:p1401:b001:l028","ordinal":60586,"en":"Kozubek, khan of Kokand,"},{"id":"manas-2010:p1401:b001:l029","ordinal":60587,"en":"And fork-bearded Synchybek of Andijan"},{"id":"manas-2010:p1401:b001:l030","ordinal":60588,"en":"Are no khans who hold back;"},{"id":"manas-2010:p1401:b001:l031","ordinal":60589,"en":"He too is among the army.”"},{"id":"manas-2010:p1401:b001:l032","ordinal":60590,"en":"When he heard Ajybay’s words,"},{"id":"manas-2010:p1401:b001:l033","ordinal":60591,"en":"Esenkan grew angry,"},{"id":"manas-2010:p1401:b001:l034","ordinal":60592,"en":"Thinking so many thoughts:"},{"id":"manas-2010:p1401:b001:l035","ordinal":60593,"en":"“This envoy who has come,"},{"id":"manas-2010:p1401:b001:l036","ordinal":60594,"en":"Shall I cut off his head,"},{"id":"manas-2010:p1401:b001:l037","ordinal":60595,"en":"And against the enemy who has swarmed here"},{"id":"manas-2010:p1401:b001:l038","ordinal":60596,"en":"Fight to destruction?” he thought."},{"id":"manas-2010:p1401:b001:l039","ordinal":60597,"en":"“Those Burut—may their daughters be divorced!"},{"id":"manas-2010:p1401:b001:l040","ordinal":60598,"en":"Shall I submit to their coercion?"},{"id":"manas-2010:p1401:b001:l041","ordinal":60599,"en":"Burulcha, my shining mirror,"},{"id":"manas-2010:p1401:b001:l042","ordinal":60600,"en":"How can I give her as tribute?”"},{"id":"manas-2010:p1402:b001:l001","ordinal":60601,"en":"Thinking this, Esenkan,"},{"id":"manas-2010:p1402:b001:l002","ordinal":60602,"en":"While he stood raging,"},{"id":"manas-2010:p1402:b001:l003","ordinal":60603,"en":"Ajybay, who had come as envoy,"},{"id":"manas-2010:p1402:b001:l004","ordinal":60604,"en":"The steel girded beneath his clothes,"},{"id":"manas-2010:p1402:b001:l005","ordinal":60605,"en":"Without Esenkan knowing,"},{"id":"manas-2010:p1402:b001:l006","ordinal":60606,"en":"Gripped properly and made ready."},{"id":"manas-2010:p1402:b001:l007","ordinal":60607,"en":"“Taking this khan’s head,"},{"id":"manas-2010:p1402:b001:l008","ordinal":60608,"en":"I shall take my pillow down with me,” he thought,"},{"id":"manas-2010:p1402:b001:l009","ordinal":60609,"en":"Preparing without revealing himself."},{"id":"manas-2010:p1402:b001:l010","ordinal":60610,"en":"While he stood thus,"},{"id":"manas-2010:p1402:b001:l011","ordinal":60611,"en":"From before Ezkara,"},{"id":"manas-2010:p1402:b001:l012","ordinal":60612,"en":"The forty lords who had lain bound"},{"id":"manas-2010:p1402:b001:l013","ordinal":60613,"en":"Came back released."},{"id":"manas-2010:p1402:b001:l014","ordinal":60614,"en":"Then one lord,"},{"id":"manas-2010:p1402:b001:l015","ordinal":60615,"en":"Bending his knees to the ground,"},{"id":"manas-2010:p1402:b001:l016","ordinal":60616,"en":"Before Esenkan,"},{"id":"manas-2010:p1402:b001:l017","ordinal":60617,"en":"Bowing in the Chinese manner,"},{"id":"manas-2010:p1402:b001:l018","ordinal":60618,"en":"Shuykuchu stood watching;"},{"id":"manas-2010:p1402:b001:l019","ordinal":60619,"en":"His eloquent tongue, to the utmost,"},{"id":"manas-2010:p1402:b001:l020","ordinal":60620,"en":"Shuykuchu stood sharpening."},{"id":"manas-2010:p1402:b001:l021","ordinal":60621,"en":"Before the khan, rattling away,"},{"id":"manas-2010:p1402:b001:l022","ordinal":60622,"en":"Shuykuchu stood pouring out words:"},{"id":"manas-2010:p1402:b001:l023","ordinal":60623,"en":"“Among the Burut, renowned Khan Manas has arisen;"},{"id":"manas-2010:p1402:b001:l024","ordinal":60624,"en":"At his voice, souls fled their bodies."},{"id":"manas-2010:p1402:b001:l025","ordinal":60625,"en":"His fortune is complete;"},{"id":"manas-2010:p1402:b001:l026","ordinal":60626,"en":"His right shoulder is broad."},{"id":"manas-2010:p1402:b001:l027","ordinal":60627,"en":"Not merely us, the Chinese people,"},{"id":"manas-2010:p1402:b001:l028","ordinal":60628,"en":"But the eighteen thousand worlds,"},{"id":"manas-2010:p1402:b001:l029","ordinal":60629,"en":"He is a lion who could slaughter them all."},{"id":"manas-2010:p1402:b001:l030","ordinal":60630,"en":"Shedding blood upon the campaign,"},{"id":"manas-2010:p1402:b001:l031","ordinal":60631,"en":"A hero like Khan Zholoy died;"},{"id":"manas-2010:p1402:b001:l032","ordinal":60632,"en":"Why should I speak of others?"},{"id":"manas-2010:p1402:b001:l033","ordinal":60633,"en":"Hero Madykan died too;"},{"id":"manas-2010:p1402:b001:l034","ordinal":60634,"en":"So many mighty khans died;"},{"id":"manas-2010:p1402:b001:l035","ordinal":60635,"en":"All whom he encountered died;"},{"id":"manas-2010:p1402:b001:l036","ordinal":60636,"en":"So many kinds of great men died."},{"id":"manas-2010:p1402:b001:l037","ordinal":60637,"en":"When the great battle was fought,"},{"id":"manas-2010:p1402:b001:l038","ordinal":60638,"en":"With Ezkara at their head,"},{"id":"manas-2010:p1402:b001:l039","ordinal":60639,"en":"His companion Chubak alone"},{"id":"manas-2010:p1402:b001:l040","ordinal":60640,"en":"Bound them, O world—"},{"id":"manas-2010:p1402:b001:l041","ordinal":60641,"en":"All forty of the lords!”"},{"id":"manas-2010:p1402:b001:l042","ordinal":60642,"en":"Bellowing these words,"},{"id":"manas-2010:p1403:b001:l001","ordinal":60643,"en":"Shouting between repeated sobs,"},{"id":"manas-2010:p1403:b001:l002","ordinal":60644,"en":"Shuykuchu stood pouring out words."},{"id":"manas-2010:p1403:b001:l003","ordinal":60645,"en":"While Shuykuchu stood thus,"},{"id":"manas-2010:p1403:b001:l004","ordinal":60646,"en":"Ajybay began to speak:"},{"id":"manas-2010:p1403:b001:l005","ordinal":60647,"en":"“Name the ridge you rely upon;"},{"id":"manas-2010:p1403:b001:l006","ordinal":60648,"en":"Name the place where you are fortified;"},{"id":"manas-2010:p1403:b001:l007","ordinal":60649,"en":"If you will give, speak truly!"},{"id":"manas-2010:p1403:b001:l008","ordinal":60650,"en":"If you say, ‘I will not give,’"},{"id":"manas-2010:p1403:b001:l009","ordinal":60651,"en":"Until the swaying stalks ripen,"},{"id":"manas-2010:p1403:b001:l010","ordinal":60652,"en":"Until the autumn gossamer flies,"},{"id":"manas-2010:p1403:b001:l011","ordinal":60653,"en":"I shall fight six months without rest!"},{"id":"manas-2010:p1403:b001:l012","ordinal":60654,"en":"Take off your robe and give it;"},{"id":"manas-2010:p1403:b001:l013","ordinal":60655,"en":"Step down and give your throne!"},{"id":"manas-2010:p1403:b001:l014","ordinal":60656,"en":"If you survive in Beijing,"},{"id":"manas-2010:p1403:b001:l015","ordinal":60657,"en":"For six months of rule,"},{"id":"manas-2010:p1403:b001:l016","ordinal":60658,"en":"Give your city of Outer Beijing!”"},{"id":"manas-2010:p1403:b001:l017","ordinal":60659,"en":"While your Ajy spoke breathlessly,"},{"id":"manas-2010:p1403:b001:l018","ordinal":60660,"en":"Esenkan’s resources failed him."},{"id":"manas-2010:p1403:b001:l019","ordinal":60661,"en":"Ay Jangjung and Kün Jangjung,"},{"id":"manas-2010:p1403:b001:l020","ordinal":60662,"en":"Esenkan, the three together,"},{"id":"manas-2010:p1403:b001:l021","ordinal":60663,"en":"Now devised this plan:"},{"id":"manas-2010:p1403:b001:l022","ordinal":60664,"en":"“What is this talk of the Burut gathering"},{"id":"manas-2010:p1403:b001:l023","ordinal":60665,"en":"And making such a spectacle?"},{"id":"manas-2010:p1403:b001:l024","ordinal":60666,"en":"The forty lords of the Chinese,"},{"id":"manas-2010:p1403:b001:l025","ordinal":60667,"en":"That Chubak alone, the wretch,"},{"id":"manas-2010:p1403:b001:l026","ordinal":60668,"en":"Bound and took them—what does this mean?"},{"id":"manas-2010:p1403:b001:l027","ordinal":60669,"en":"That the Chinese into this slaughter"},{"id":"manas-2010:p1403:b001:l028","ordinal":60670,"en":"Were cast—what does this mean?"},{"id":"manas-2010:p1403:b001:l029","ordinal":60671,"en":"Let us make ready for the tower"},{"id":"manas-2010:p1403:b001:l030","ordinal":60672,"en":"And see the Burut’s condition.”"}]
