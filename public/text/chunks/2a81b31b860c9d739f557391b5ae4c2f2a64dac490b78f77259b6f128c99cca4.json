[{"id":"semetey-1-2013:p0885:b003:l021","ordinal":143873,"en":"Jostling and trampling together."},{"id":"semetey-1-2013:p0885:b003:l022","ordinal":143874,"en":"Then your dear mother Kanykei"},{"id":"semetey-1-2013:p0885:b003:l023","ordinal":143875,"en":"Saddled up and mounted in earnest."},{"id":"semetey-1-2013:p0885:b003:l024","ordinal":143876,"en":"Her black hair, thick as a girth,"},{"id":"semetey-1-2013:p0885:b003:l025","ordinal":143877,"en":"She bound tightly upon her crown."},{"id":"semetey-1-2013:p0885:b003:l026","ordinal":143878,"en":"Semetey's old fur cap"},{"id":"semetey-1-2013:p0885:b003:l027","ordinal":143879,"en":"She pulled firmly over her head."},{"id":"semetey-1-2013:p0885:b003:l028","ordinal":143880,"en":"“If my time has come, I shall die;"},{"id":"semetey-1-2013:p0885:b003:l029","ordinal":143881,"en":"If suffering awaits me, I shall endure it."},{"id":"semetey-1-2013:p0885:b003:l030","ordinal":143882,"en":"For the orphan left by the Magnanimous One"},{"id":"semetey-1-2013:p0885:b003:l031","ordinal":143883,"en":"I shall stand as a protector,” she said."},{"id":"semetey-1-2013:p0885:b003:l032","ordinal":143884,"en":"Taking her battle-axe, she swung it,"},{"id":"semetey-1-2013:p0885:b003:l033","ordinal":143885,"en":"And some of the forty companions"},{"id":"semetey-1-2013:p0885:b003:l034","ordinal":143886,"en":"She struck down and sent crawling."},{"id":"semetey-1-2013:p0885:b003:l035","ordinal":143887,"en":"Making ready upon their flank,"},{"id":"semetey-1-2013:p0885:b003:l036","ordinal":143888,"en":"Kanykei rushed into the fight."},{"id":"semetey-1-2013:p0885:b003:l037","ordinal":143889,"en":"Making Tuuchunak rear and bound,"},{"id":"semetey-1-2013:p0885:b003:l038","ordinal":143890,"en":"Shattering whoever stood before him,"},{"id":"semetey-1-2013:p0885:b003:l039","ordinal":143891,"en":"Sary Khan came in from one side."},{"id":"semetey-1-2013:p0885:b004:l001","ordinal":143892,"en":"Bakai's son Baitailak,"},{"id":"semetey-1-2013:p0885:b004:l002","ordinal":143893,"en":"Sary Khan's Kalyk,"},{"id":"semetey-1-2013:p0885:b004:l003","ordinal":143894,"en":"Zhamgyrchy's Shayymbet—"},{"id":"semetey-1-2013:p0885:b004:l004","ordinal":143895,"en":"They entered the battle,"},{"id":"semetey-1-2013:p0885:b004:l005","ordinal":143896,"en":"And now took the orphan's side."},{"id":"semetey-1-2013:p0885:b004:l006","ordinal":143897,"en":"They stood against men one by one,"},{"id":"semetey-1-2013:p0885:b004:l007","ordinal":143898,"en":"Fighting with thrusts of their spears."},{"id":"semetey-1-2013:p0885:b004:l008","ordinal":143899,"en":"The two peoples faced each other,"},{"id":"semetey-1-2013:p0885:b004:l009","ordinal":143900,"en":"Grasped their spears,"},{"id":"semetey-1-2013:p0885:b004:l010","ordinal":143901,"en":"And leveled them at one another."},{"id":"semetey-1-2013:p0885:b004:l011","ordinal":143902,"en":"Now a terrible battle raged."},{"id":"semetey-1-2013:p0885:b004:l012","ordinal":143903,"en":"Khan Semetey, the blood-shedding hero,"},{"id":"semetey-1-2013:p0885:b004:l013","ordinal":143904,"en":"Spread havoc in that place."},{"id":"semetey-1-2013:p0885:b004:l014","ordinal":143905,"en":"Through the center the hero Semen"},{"id":"semetey-1-2013:p0885:b004:l015","ordinal":143906,"en":"Carved his way forward."},{"id":"semetey-1-2013:p0885:b004:l016","ordinal":143907,"en":"Around the edges Sary Khan"},{"id":"semetey-1-2013:p0885:b004:l017","ordinal":143908,"en":"Beat his way onward."},{"id":"semetey-1-2013:p0885:b004:l018","ordinal":143909,"en":"Into their very midst Kanykei"},{"id":"semetey-1-2013:p0885:b004:l019","ordinal":143910,"en":"Drove them, hemming them in."},{"id":"semetey-1-2013:p0885:b004:l020","ordinal":143911,"en":"Unable to withstand their fury,"},{"id":"semetey-1-2013:p0885:b004:l021","ordinal":143912,"en":"The countless troops scattered apart,"},{"id":"semetey-1-2013:p0885:b004:l022","ordinal":143913,"en":"Screaming, not knowing what to do."},{"id":"semetey-1-2013:p0885:b004:l023","ordinal":143914,"en":"Semetey and Kanykei—"},{"id":"semetey-1-2013:p0885:b004:l024","ordinal":143915,"en":"When they saw these two,"},{"id":"semetey-1-2013:p0885:b004:l025","ordinal":143916,"en":"The poor people driven there,"},{"id":"semetey-1-2013:p0885:b004:l026","ordinal":143917,"en":"Argyn and Kyrgyz together,"},{"id":"semetey-1-2013:p0885:b004:l027","ordinal":143918,"en":"Broke away to the very last man."},{"id":"semetey-1-2013:p0885:b004:l028","ordinal":143919,"en":"They threw down their spears,"},{"id":"semetey-1-2013:p0885:b004:l029","ordinal":143920,"en":"Dismounted from their horses,"},{"id":"semetey-1-2013:p0885:b004:l030","ordinal":143921,"en":"And laid their sashes about their necks."},{"id":"semetey-1-2013:p0885:b004:l031","ordinal":143922,"en":"These were his people, coming before him."},{"id":"semetey-1-2013:p0885:b004:l032","ordinal":143923,"en":"To the poor young lord"},{"id":"semetey-1-2013:p0885:b004:l033","ordinal":143924,"en":"The people said these words:"},{"id":"semetey-1-2013:p0885:b004:l034","ordinal":143925,"en":"“O my gentle, gray-mottled female goshawk,"},{"id":"semetey-1-2013:p0885:b004:l035","ordinal":143926,"en":"My gray goshawk, my morning star!"},{"id":"semetey-1-2013:p0885:b004:l036","ordinal":143927,"en":"Here is the land—take sovereignty;"},{"id":"semetey-1-2013:p0885:b004:l037","ordinal":143928,"en":"Here we are, if you would cut off heads!"},{"id":"semetey-1-2013:p0885:b004:l038","ordinal":143929,"en":"Do not dig my pit deep,"},{"id":"semetey-1-2013:p0885:b004:l039","ordinal":143930,"en":"Heir left by my khan Manas."},{"id":"semetey-1-2013:p0886:b003:l001","ordinal":143931,"en":"Do not boil up my misery!"},{"id":"semetey-1-2013:p0886:b003:l002","ordinal":143932,"en":"When your father Manas died,"},{"id":"semetey-1-2013:p0886:b003:l003","ordinal":143933,"en":"When his people met with grief,"},{"id":"semetey-1-2013:p0886:b003:l004","ordinal":143934,"en":"The six villains became our khans."},{"id":"semetey-1-2013:p0886:b003:l005","ordinal":143935,"en":"Their wrath drove the life from us."},{"id":"semetey-1-2013:p0886:b003:l006","ordinal":143936,"en":"They laid on heavy dues and taxes;"},{"id":"semetey-1-2013:p0886:b003:l007","ordinal":143937,"en":"First of all, they took our livestock."},{"id":"semetey-1-2013:p0886:b003:l008","ordinal":143938,"en":"They began their devastation."},{"id":"semetey-1-2013:p0886:b003:l009","ordinal":143939,"en":"Those who answered back,"},{"id":"semetey-1-2013:p0886:b003:l010","ordinal":143940,"en":"The six villains in their fury"},{"id":"semetey-1-2013:p0886:b003:l011","ordinal":143941,"en":"Slaughtered to the last."},{"id":"semetey-1-2013:p0886:b003:l012","ordinal":143942,"en":"They levied tribute and took our yearlings."},{"id":"semetey-1-2013:p0886:b003:l013","ordinal":143943,"en":"Unable to bear their exactions,"},{"id":"semetey-1-2013:p0886:b003:l014","ordinal":143944,"en":"The poor people left by your father"},{"id":"semetey-1-2013:p0886:b003:l015","ordinal":143945,"en":"Fled and scattered far and wide."},{"id":"semetey-1-2013:p0886:b003:l016","ordinal":143946,"en":"Oceanlike orphan, hear our words!"},{"id":"semetey-1-2013:p0886:b003:l017","ordinal":143947,"en":"Here is Talas, if you would settle;"},{"id":"semetey-1-2013:p0886:b003:l018","ordinal":143948,"en":"Here are the people your father left!"},{"id":"semetey-1-2013:p0886:b003:l019","ordinal":143949,"en":"Here is blood, if you would kill and spill it;"},{"id":"semetey-1-2013:p0886:b003:l020","ordinal":143950,"en":"If you would make us shriek, my orphan,"},{"id":"semetey-1-2013:p0886:b003:l021","ordinal":143951,"en":"Here are lives, if you would cut them short!”"},{"id":"semetey-1-2013:p0886:b003:l022","ordinal":143952,"en":"So the people spoke."},{"id":"semetey-1-2013:p0886:b003:l023","ordinal":143953,"en":"Your gray-maned Khan Semetey,"},{"id":"semetey-1-2013:p0886:b003:l024","ordinal":143954,"en":"Seeing his people in such a state,"},{"id":"semetey-1-2013:p0886:b003:l025","ordinal":143955,"en":"Was overcome with sorrow,"},{"id":"semetey-1-2013:p0886:b003:l026","ordinal":143956,"en":"And tears poured from his eyes."},{"id":"semetey-1-2013:p0886:b003:l027","ordinal":143957,"en":"Argyn and Kyrgyz together"},{"id":"semetey-1-2013:p0886:b003:l028","ordinal":143958,"en":"Dismounted in great numbers,"},{"id":"semetey-1-2013:p0886:b003:l029","ordinal":143959,"en":"Submitted to Semetey,"},{"id":"semetey-1-2013:p0886:b003:l030","ordinal":143960,"en":"And broke away in tens and fives,"},{"id":"semetey-1-2013:p0886:b003:l031","ordinal":143961,"en":"Taking the orphan son of the mighty destroyer"},{"id":"semetey-1-2013:p0886:b003:l032","ordinal":143962,"en":"As their protector as they went."},{"id":"semetey-1-2013:p0886:b003:l033","ordinal":143963,"en":"Argyn and Kyrgyz broke away"},{"id":"semetey-1-2013:p0886:b003:l034","ordinal":143964,"en":"And gave themselves into his hands."},{"id":"semetey-1-2013:p0886:b003:l035","ordinal":143965,"en":"The orphan, the son of Manas—"},{"id":"semetey-1-2013:p0886:b003:l036","ordinal":143966,"en":"His uprightness became plain."},{"id":"semetey-1-2013:p0886:b003:l037","ordinal":143967,"en":"Semetey came and settled,"},{"id":"semetey-1-2013:p0886:b003:l038","ordinal":143968,"en":"And found a land like Talas."},{"id":"semetey-1-2013:p0886:b003:l039","ordinal":143969,"en":"The bold son of Manas"},{"id":"semetey-1-2013:p0886:b004:l001","ordinal":143970,"en":"Found the Argyn and Kyrgyz as his people."},{"id":"semetey-1-2013:p0886:b004:l002","ordinal":143971,"en":"Then the Kazakh of Sary-Arka,"},{"id":"semetey-1-2013:p0886:b004:l003","ordinal":143972,"en":"His mother's sister's son, Umotoy,"},{"id":"semetey-1-2013:p0886:b004:l004","ordinal":143973,"en":"Fought on without fleeing."},{"id":"semetey-1-2013:p0886:b004:l005","ordinal":143974,"en":"The Zhediger's Urbu—"},{"id":"semetey-1-2013:p0886:b004:l006","ordinal":143975,"en":"To avenge Urbu,"},{"id":"semetey-1-2013:p0886:b004:l007","ordinal":143976,"en":"They charged upon his flank."},{"id":"semetey-1-2013:p0886:b004:l008","ordinal":143977,"en":"The great mass of Zhediger"},{"id":"semetey-1-2013:p0886:b004:l009","ordinal":143978,"en":"Fought on without fleeing."},{"id":"semetey-1-2013:p0886:b004:l010","ordinal":143979,"en":"Of the Kipchaks, Muzburchak—"},{"id":"semetey-1-2013:p0886:b004:l011","ordinal":143980,"en":"Muzburchak's Buyanbek"},{"id":"semetey-1-2013:p0886:b004:l012","ordinal":143981,"en":"Was the one who raised the standard."},{"id":"semetey-1-2013:p0886:b004:l013","ordinal":143982,"en":"“My goshawk father Muzburchak"},{"id":"semetey-1-2013:p0886:b004:l014","ordinal":143983,"en":"Went to Beijing and was slaughtered;"},{"id":"semetey-1-2013:p0886:b004:l015","ordinal":143984,"en":"He died at Manas's hands."},{"id":"semetey-1-2013:p0886:b004:l016","ordinal":143985,"en":"I shall avenge my father,"},{"id":"semetey-1-2013:p0886:b004:l017","ordinal":143986,"en":"And the orphan son of Manas"},{"id":"semetey-1-2013:p0886:b004:l018","ordinal":143987,"en":"I shall offer as a sacrifice,” he said."},{"id":"semetey-1-2013:p0886:b004:l019","ordinal":143988,"en":"The massed Kipchaks hurled themselves forward."},{"id":"semetey-1-2013:p0886:b004:l020","ordinal":143989,"en":"God, do not let us see their faces!"},{"id":"semetey-1-2013:p0886:b004:l021","ordinal":143990,"en":"They attacked upon his flank."},{"id":"semetey-1-2013:p0886:b004:l022","ordinal":143991,"en":"The massed Kipchaks made ready,"},{"id":"semetey-1-2013:p0886:b004:l023","ordinal":143992,"en":"Roaring in their fury,"},{"id":"semetey-1-2013:p0886:b004:l024","ordinal":143993,"en":"Crying “Muzburchak!”"},{"id":"semetey-1-2013:p0886:b004:l025","ordinal":143994,"en":"Now the Kipchak army entered the fight."},{"id":"semetey-1-2013:p0886:b004:l026","ordinal":143995,"en":"They rumbled in anger,"},{"id":"semetey-1-2013:p0886:b004:l027","ordinal":143996,"en":"Thundering out cries of “Bastards!”"},{"id":"semetey-1-2013:p0886:b004:l028","ordinal":143997,"en":"Working themselves into a fury,"},{"id":"semetey-1-2013:p0886:b004:l029","ordinal":143998,"en":"Muttering to themselves,"},{"id":"semetey-1-2013:p0886:b004:l030","ordinal":143999,"en":"Stopping in utter disorder,"},{"id":"semetey-1-2013:p0886:b004:l031","ordinal":144000,"en":"Cursing one another,"},{"id":"semetey-1-2013:p0886:b004:l032","ordinal":144001,"en":"Blustering and rumbling,"},{"id":"semetey-1-2013:p0886:b004:l033","ordinal":144002,"en":"Thumping about in a noisy throng,"},{"id":"semetey-1-2013:p0886:b004:l034","ordinal":144003,"en":"Strutting and putting on airs,"},{"id":"semetey-1-2013:p0886:b004:l035","ordinal":144004,"en":"All of them with their clubs"},{"id":"semetey-1-2013:p0886:b004:l036","ordinal":144005,"en":"Laid across their shoulders,"},{"id":"semetey-1-2013:p0886:b004:l037","ordinal":144006,"en":"Making a spectacle with their noise,"},{"id":"semetey-1-2013:p0886:b004:l038","ordinal":144007,"en":"Talking and cursing men's daughters,"},{"id":"semetey-1-2013:p0886:b004:l039","ordinal":144008,"en":"Their mules braying,"},{"id":"semetey-1-2013:p0887:b003:l001","ordinal":144009,"en":"“Do not flee!” they called to one another,"},{"id":"semetey-1-2013:p0887:b003:l002","ordinal":144010,"en":"Roaring as they lent one another support."},{"id":"semetey-1-2013:p0887:b003:l003","ordinal":144011,"en":"Wrapping their sashes as turbans,"},{"id":"semetey-1-2013:p0887:b003:l004","ordinal":144012,"en":"Beseeching God with cries of “O God!”"},{"id":"semetey-1-2013:p0887:b003:l005","ordinal":144013,"en":"Their turbans puffed up,"},{"id":"semetey-1-2013:p0887:b003:l006","ordinal":144014,"en":"Their beards fluffed out,"},{"id":"semetey-1-2013:p0887:b003:l007","ordinal":144015,"en":"Shouting “Alabek!”"},{"id":"semetey-1-2013:p0887:b003:l009","ordinal":144016,"en":"All of them together made ready","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0887:b003:l010","ordinal":144017,"en":"And hurled themselves upon Semetey."},{"id":"semetey-1-2013:p0887:b003:l011","ordinal":144018,"en":"Their madness knew no restraint;"},{"id":"semetey-1-2013:p0887:b003:l012","ordinal":144019,"en":"If Semetey fell into their hands,"},{"id":"semetey-1-2013:p0887:b003:l013","ordinal":144020,"en":"They had no thought of sparing him."},{"id":"semetey-1-2013:p0887:b003:l014","ordinal":144021,"en":"Crying “Ai, ai!” they rushed forward."},{"id":"semetey-1-2013:p0887:b003:l015","ordinal":144022,"en":"An old Sart joined the attack."},{"id":"semetey-1-2013:p0887:b003:l016","ordinal":144023,"en":"When the orphan went to Bukhara,"},{"id":"semetey-1-2013:p0887:b003:l017","ordinal":144024,"en":"Abyke, Kobosh—the six villains—"},{"id":"semetey-1-2013:p0887:b003:l018","ordinal":144025,"en":"To each of all the enemy hosts"},{"id":"semetey-1-2013:p0887:b003:l019","ordinal":144026,"en":"Had given six swift horses"},{"id":"semetey-1-2013:p0887:b003:l020","ordinal":144027,"en":"And a letter the size of a palm."},{"id":"semetey-1-2013:p0887:b003:l022","ordinal":144028,"en":"Gathering armies of every kind,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0887:b003:l023","ordinal":144029,"en":"To seize the orphan"},{"id":"semetey-1-2013:p0887:b003:l024","ordinal":144030,"en":"And offer him as a sacrifice,"},{"id":"semetey-1-2013:p0887:b003:l025","ordinal":144031,"en":"And then, after that,"},{"id":"semetey-1-2013:p0887:b003:l026","ordinal":144032,"en":"To divide the Argyn and Kyrgyz"},{"id":"semetey-1-2013:p0887:b003:l027","ordinal":144033,"en":"By the measure of their whips,"},{"id":"semetey-1-2013:p0887:b003:l028","ordinal":144034,"en":"And to all the armies that came"},{"id":"semetey-1-2013:p0887:b003:l029","ordinal":144035,"en":"Give them as subjects,"},{"id":"semetey-1-2013:p0887:b003:l030","ordinal":144036,"en":"They had made a binding promise,"},{"id":"semetey-1-2013:p0887:b003:l031","ordinal":144037,"en":"Made these words binding,"},{"id":"semetey-1-2013:p0887:b003:l032","ordinal":144038,"en":"Binding, never to be broken."},{"id":"semetey-1-2013:p0887:b003:l033","ordinal":144039,"en":"Gathering the whole army,"},{"id":"semetey-1-2013:p0887:b003:l034","ordinal":144040,"en":"They cut twigs in token of their oath—"},{"id":"semetey-1-2013:p0887:b003:l035","ordinal":144041,"en":"So the six villains had done."},{"id":"semetey-1-2013:p0887:b003:l036","ordinal":144042,"en":"That great promise they had made"},{"id":"semetey-1-2013:p0887:b003:l037","ordinal":144043,"en":"Upon gray-maned Khan Semetey—"},{"id":"semetey-1-2013:p0887:b003:l038","ordinal":144044,"en":"That was why they swept down."},{"id":"semetey-1-2013:p0887:b003:l039","ordinal":144045,"en":"The bold son of Manas"},{"id":"semetey-1-2013:p0887:b004:l001","ordinal":144046,"en":"He remained utterly unconcerned."},{"id":"semetey-1-2013:p0887:b004:l002","ordinal":144047,"en":"Though so many troops swept down,"},{"id":"semetey-1-2013:p0887:b004:l003","ordinal":144048,"en":"He did not consider them worth a thing."},{"id":"semetey-1-2013:p0887:b004:l004","ordinal":144049,"en":"He did not look this way and that,"},{"id":"semetey-1-2013:p0887:b004:l005","ordinal":144050,"en":"Nor reckon that he might die."},{"id":"semetey-1-2013:p0887:b004:l006","ordinal":144051,"en":"Your mighty beast's only son"},{"id":"semetey-1-2013:p0887:b004:l007","ordinal":144052,"en":"He remained utterly unconcerned."},{"id":"semetey-1-2013:p0887:b004:l008","ordinal":144053,"en":"Though the great army rushed upon him,"},{"id":"semetey-1-2013:p0887:b004:l009","ordinal":144054,"en":"Thrusting spears and striking with axes,"},{"id":"semetey-1-2013:p0887:b004:l010","ordinal":144055,"en":"He did not consider them worth a thing."},{"id":"semetey-1-2013:p0887:b004:l011","ordinal":144056,"en":"The son of that surpassing lion"},{"id":"semetey-1-2013:p0887:b004:l012","ordinal":144057,"en":"Felt no dread of death."},{"id":"semetey-1-2013:p0887:b004:l013","ordinal":144058,"en":"All the troops that swept upon him"},{"id":"semetey-1-2013:p0887:b004:l014","ordinal":144059,"en":"He did not deem worth a blue fly."},{"id":"semetey-1-2013:p0887:b004:l015","ordinal":144060,"en":"When the great army swept down,"},{"id":"semetey-1-2013:p0887:b004:l016","ordinal":144061,"en":"When they surrounded him,"},{"id":"semetey-1-2013:p0887:b004:l017","ordinal":144062,"en":"Your orphan, the oceanlike hero's son,"},{"id":"semetey-1-2013:p0887:b004:l018","ordinal":144063,"en":"Did not waver before this enemy."},{"id":"semetey-1-2013:p0887:b004:l019","ordinal":144064,"en":"When they swept upon him from every side,"},{"id":"semetey-1-2013:p0887:b004:l020","ordinal":144065,"en":"Sary Khan, with eyes like bowls,"},{"id":"semetey-1-2013:p0887:b004:l021","ordinal":144066,"en":"Made Tuuchunak rear and bound,"},{"id":"semetey-1-2013:p0887:b004:l022","ordinal":144067,"en":"Shattering whoever he met."},{"id":"semetey-1-2013:p0887:b004:l023","ordinal":144068,"en":"From the flank Kanykei"},{"id":"semetey-1-2013:p0887:b004:l024","ordinal":144069,"en":"Charged and joined the attack,"},{"id":"semetey-1-2013:p0887:b004:l025","ordinal":144070,"en":"Standing against their heroes,"},{"id":"semetey-1-2013:p0887:b004:l026","ordinal":144071,"en":"Fighting with their champions,"},{"id":"semetey-1-2013:p0887:b004:l027","ordinal":144072,"en":"Standing against their swords,"},{"id":"semetey-1-2013:p0887:b004:l028","ordinal":144073,"en":"Fighting with their strongest men."},{"id":"semetey-1-2013:p0887:b004:l029","ordinal":144074,"en":"Girding their waists firmly,"},{"id":"semetey-1-2013:p0887:b004:l030","ordinal":144075,"en":"Kanykei and Sary Khan"},{"id":"semetey-1-2013:p0887:b004:l031","ordinal":144076,"en":"Charged separately through the host."},{"id":"semetey-1-2013:p0887:b004:l032","ordinal":144077,"en":"Those whom Sary Khan speared,"},{"id":"semetey-1-2013:p0887:b004:l033","ordinal":144078,"en":"Kanykei beheaded."},{"id":"semetey-1-2013:p0887:b004:l034","ordinal":144079,"en":"Kanykei rode on, thrusting her spear,"},{"id":"semetey-1-2013:p0887:b004:l035","ordinal":144080,"en":"And Sary Khan rode on, cutting off heads."},{"id":"semetey-1-2013:p0887:b004:l036","ordinal":144081,"en":"Taking no rest by day,"},{"id":"semetey-1-2013:p0887:b004:l037","ordinal":144082,"en":"Taking no sleep at night,"},{"id":"semetey-1-2013:p0887:b004:l038","ordinal":144083,"en":"Standing fast through days and nights,"},{"id":"semetey-1-2013:p0887:b004:l039","ordinal":144084,"en":"They plunged fiercely into battle."},{"id":"semetey-1-2013:p0888:b003:l001","ordinal":144085,"en":"Through the center Kanykei"},{"id":"semetey-1-2013:p0888:b003:l002","ordinal":144086,"en":"Carved a path and drove them onward."},{"id":"semetey-1-2013:p0888:b003:l003","ordinal":144087,"en":"Around the edges Sary Khan"},{"id":"semetey-1-2013:p0888:b003:l004","ordinal":144088,"en":"Slaughtered them and drove them onward."},{"id":"semetey-1-2013:p0888:b003:l005","ordinal":144089,"en":"Their very center Semetey"},{"id":"semetey-1-2013:p0888:b003:l006","ordinal":144090,"en":"Was hemming in as he went."},{"id":"semetey-1-2013:p0888:b003:l007","ordinal":144091,"en":"Along one edge Baitailak"},{"id":"semetey-1-2013:p0888:b003:l008","ordinal":144092,"en":"Was beating his way onward."},{"id":"semetey-1-2013:p0888:b003:l010","ordinal":144093,"en":"Slaughtering them and driving them onward.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0888:b003:l011","ordinal":144094,"en":"Along one flank Shayymbet"},{"id":"semetey-1-2013:p0888:b003:l012","ordinal":144095,"en":"Was sweeping them before him."},{"id":"semetey-1-2013:p0888:b003:l013","ordinal":144096,"en":"Like jackdaws struck by a falcon,"},{"id":"semetey-1-2013:p0888:b003:l014","ordinal":144097,"en":"They drove and swept them onward."},{"id":"semetey-1-2013:p0888:b003:l015","ordinal":144098,"en":"They chased them like partridges,"},{"id":"semetey-1-2013:p0888:b003:l016","ordinal":144099,"en":"Tormenting and destroying the people."},{"id":"semetey-1-2013:p0888:b003:l018","ordinal":144100,"en":"Many people were slaughtered.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0888:b003:l019","ordinal":144101,"en":"Because of Abyke,"},{"id":"semetey-1-2013:p0888:b003:l020","ordinal":144102,"en":"Because of Kobosh's manifold wickedness,"},{"id":"semetey-1-2013:p0888:b003:l021","ordinal":144103,"en":"They had gathered an army without cause."},{"id":"semetey-1-2013:p0888:b003:l022","ordinal":144104,"en":"Have you seen the fools?"},{"id":"semetey-1-2013:p0888:b003:l023","ordinal":144105,"en":"They plunged unsparingly into battle."},{"id":"semetey-1-2013:p0888:b003:l024","ordinal":144106,"en":"Mounted khans died;"},{"id":"semetey-1-2013:p0888:b003:l025","ordinal":144107,"en":"Amid the shouting strife and great disorder,"},{"id":"semetey-1-2013:p0888:b003:l026","ordinal":144108,"en":"Those whose appointed time had come died."},{"id":"semetey-1-2013:p0888:b003:l027","ordinal":144109,"en":"Where their spears could reach,"},{"id":"semetey-1-2013:p0888:b003:l028","ordinal":144110,"en":"They overturned men with their spears;"},{"id":"semetey-1-2013:p0888:b003:l029","ordinal":144111,"en":"Where their swords could reach,"},{"id":"semetey-1-2013:p0888:b003:l030","ordinal":144112,"en":"They overturned men with their swords."},{"id":"semetey-1-2013:p0888:b003:l031","ordinal":144113,"en":"A star was eclipsed in the sky."},{"id":"semetey-1-2013:p0888:b003:l032","ordinal":144114,"en":"Kokcho's son Umotoy"},{"id":"semetey-1-2013:p0888:b003:l033","ordinal":144115,"en":"Fled openly and escaped."},{"id":"semetey-1-2013:p0888:b003:l034","ordinal":144116,"en":"Their teeth jutting out,"},{"id":"semetey-1-2013:p0888:b003:l035","ordinal":144117,"en":"Dead horses lay in mountains."},{"id":"semetey-1-2013:p0888:b003:l036","ordinal":144118,"en":"Many a swift horse's"},{"id":"semetey-1-2013:p0888:b003:l037","ordinal":144119,"en":"Saddle had slipped beneath its belly."},{"id":"semetey-1-2013:p0888:b003:l038","ordinal":144120,"en":"Kicking at its empty saddle,"},{"id":"semetey-1-2013:p0888:b003:l039","ordinal":144121,"en":"Many a horse went bucking about."},{"id":"semetey-1-2013:p0888:b004:l001","ordinal":144122,"en":"Leading fine swift horses"},{"id":"semetey-1-2013:p0888:b004:l002","ordinal":144123,"en":"Whose owners were gone,"},{"id":"semetey-1-2013:p0888:b004:l003","ordinal":144124,"en":"Many went taking them along."},{"id":"semetey-1-2013:p0888:b004:l004","ordinal":144125,"en":"“My dear, precious kinsman"},{"id":"semetey-1-2013:p0888:b004:l005","ordinal":144126,"en":"Died in such-and-such a place,”"},{"id":"semetey-1-2013:p0888:b004:l006","ordinal":144127,"en":"Many went wailing."},{"id":"semetey-1-2013:p0888:b004:l007","ordinal":144128,"en":"“My dear, precious kinsman,"}]
