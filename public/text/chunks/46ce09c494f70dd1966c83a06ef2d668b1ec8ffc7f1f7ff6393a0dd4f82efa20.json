[{"id":"semetey-1-2013:p1042:b003:l015","ordinal":155649,"en":"When they reached great Afghanistan,"},{"id":"semetey-1-2013:p1042:b003:l016","ordinal":155650,"en":"Its mastiffs barked thunderously,"},{"id":"semetey-1-2013:p1042:b003:l017","ordinal":155651,"en":"Its bitches yelped and barked,"},{"id":"semetey-1-2013:p1042:b003:l018","ordinal":155652,"en":"Its donkeys brayed on the rooftops,"},{"id":"semetey-1-2013:p1042:b003:l019","ordinal":155653,"en":"And roosters crowed from the city."},{"id":"semetey-1-2013:p1042:b003:l020","ordinal":155654,"en":"Broad Afghanistan lay there,"},{"id":"semetey-1-2013:p1042:b003:l021","ordinal":155655,"en":"Divided into guarded quarters,"},{"id":"semetey-1-2013:p1042:b003:l022","ordinal":155656,"en":"With dark smoke visible."},{"id":"semetey-1-2013:p1042:b003:l023","ordinal":155657,"en":"Broad Afghanistan lay there;"},{"id":"semetey-1-2013:p1042:b003:l024","ordinal":155658,"en":"Having traveled far upon the road,"},{"id":"semetey-1-2013:p1042:b003:l025","ordinal":155659,"en":"The lions filed into"},{"id":"semetey-1-2013:p1042:b003:l026","ordinal":155660,"en":"The palace prepared for them."},{"id":"semetey-1-2013:p1042:b003:l027","ordinal":155661,"en":"Aychürök's white palace"},{"id":"semetey-1-2013:p1042:b003:l028","ordinal":155662,"en":"Had iron gates and solid tin;"},{"id":"semetey-1-2013:p1042:b003:l029","ordinal":155663,"en":"Though the poor woman was only a maiden,"},{"id":"semetey-1-2013:p1042:b003:l030","ordinal":155664,"en":"Her retinue was exceedingly great."},{"id":"semetey-1-2013:p1042:b003:l031","ordinal":155665,"en":"At the mouth of the doorway,"},{"id":"semetey-1-2013:p1042:b003:l032","ordinal":155666,"en":"The champions posted as guards,"},{"id":"semetey-1-2013:p1042:b003:l033","ordinal":155667,"en":"Holding clubs as large as houses,"},{"id":"semetey-1-2013:p1042:b003:l034","ordinal":155668,"en":"All eighty rose to their feet."},{"id":"semetey-1-2013:p1042:b003:l035","ordinal":155669,"en":"Passing among those eighty,"},{"id":"semetey-1-2013:p1042:b003:l036","ordinal":155670,"en":"Your sister-in-law went on."},{"id":"semetey-1-2013:p1042:b003:l037","ordinal":155671,"en":"She murmured to some,"},{"id":"semetey-1-2013:p1042:b003:l038","ordinal":155672,"en":"And whispered to others;"},{"id":"semetey-1-2013:p1042:b003:l039","ordinal":155673,"en":"When they heard this news,"},{"id":"semetey-1-2013:p1042:b004:l001","ordinal":155674,"en":"The guards flew like arrows"},{"id":"semetey-1-2013:p1042:b004:l002","ordinal":155675,"en":"And took the prince's horse."},{"id":"semetey-1-2013:p1042:b004:l003","ordinal":155676,"en":"At a pillar whose post was gold,"},{"id":"semetey-1-2013:p1042:b004:l004","ordinal":155677,"en":"They tethered the exhausted Buurul"},{"id":"semetey-1-2013:p1042:b004:l005","ordinal":155678,"en":"High and secure."},{"id":"semetey-1-2013:p1042:b004:l006","ordinal":155679,"en":"Aychürök's forty young women"},{"id":"semetey-1-2013:p1042:b004:l007","ordinal":155680,"en":"Tied up horses in a bustle;"},{"id":"semetey-1-2013:p1042:b004:l008","ordinal":155681,"en":"Their quickness was beyond measure,"},{"id":"semetey-1-2013:p1042:b004:l009","ordinal":155682,"en":"As they tied them fast in a flash."},{"id":"semetey-1-2013:p1042:b004:l010","ordinal":155683,"en":"Within the white palace,"},{"id":"semetey-1-2013:p1042:b004:l011","ordinal":155684,"en":"In the great ceremonial pavilion,"},{"id":"semetey-1-2013:p1042:b004:l012","ordinal":155685,"en":"Akylay flew like an arrow,"},{"id":"semetey-1-2013:p1042:b004:l013","ordinal":155686,"en":"And his sister-in-law opened the door."},{"id":"semetey-1-2013:p1042:b004:l014","ordinal":155687,"en":"Led by the prince who had brought them,"},{"id":"semetey-1-2013:p1042:b004:l015","ordinal":155688,"en":"Twenty-five people entered now."},{"id":"semetey-1-2013:p1042:b004:l016","ordinal":155689,"en":"The prince now mounted the place of honor,"},{"id":"semetey-1-2013:p1042:b004:l017","ordinal":155690,"en":"An enormous golden throne like a camel."},{"id":"semetey-1-2013:p1042:b004:l018","ordinal":155691,"en":"Around it stood a grove of plane trees,"},{"id":"semetey-1-2013:p1042:b004:l019","ordinal":155692,"en":"And in its center a golden throne;"},{"id":"semetey-1-2013:p1042:b004:l020","ordinal":155693,"en":"This was a garden granted by the Creator."},{"id":"semetey-1-2013:p1042:b004:l021","ordinal":155694,"en":"The princely leopard Semetey"},{"id":"semetey-1-2013:p1042:b004:l022","ordinal":155695,"en":"At this time had gone as a bridegroom"},{"id":"semetey-1-2013:p1042:b004:l023","ordinal":155696,"en":"To Khan Akun's city."},{"id":"semetey-1-2013:p1042:b004:l024","ordinal":155697,"en":"Your renowned sister-in-law Aychürök—"},{"id":"semetey-1-2013:p1042:b004:l025","ordinal":155698,"en":"Ask not about the hero's estate;"},{"id":"semetey-1-2013:p1042:b004:l026","ordinal":155699,"en":"She had known plainly beforehand"},{"id":"semetey-1-2013:p1042:b004:l027","ordinal":155700,"en":"That the heroic princely conqueror would come."},{"id":"semetey-1-2013:p1042:b004:l028","ordinal":155701,"en":"\"The descendant of the formidable lion"},{"id":"semetey-1-2013:p1042:b004:l029","ordinal":155702,"en":"Will surely come,\" she had thought,"},{"id":"semetey-1-2013:p1042:b004:l030","ordinal":155703,"en":"And your sister-in-law stood preparing."},{"id":"semetey-1-2013:p1042:b004:l031","ordinal":155704,"en":"For the fourteen horses she made coverings"},{"id":"semetey-1-2013:p1042:b004:l032","ordinal":155705,"en":"Fashioned in the likeness of tigers."},{"id":"semetey-1-2013:p1042:b004:l033","ordinal":155706,"en":"She had their insides lined with fine velvet,"},{"id":"semetey-1-2013:p1042:b004:l034","ordinal":155707,"en":"And maidens and young women bite down the seams;"},{"id":"semetey-1-2013:p1042:b004:l035","ordinal":155708,"en":"She had golden beads set along their edges,"},{"id":"semetey-1-2013:p1042:b004:l036","ordinal":155709,"en":"And their faces embroidered wholly in silk,"},{"id":"semetey-1-2013:p1042:b004:l037","ordinal":155710,"en":"Had the pile twisted thick and shaggy,"},{"id":"semetey-1-2013:p1042:b004:l038","ordinal":155711,"en":"So that to anyone who saw their color"},{"id":"semetey-1-2013:p1042:b004:l039","ordinal":155712,"en":"They bore the very likeness of a tiger,"}]
