[{"id":"semetey-1-2013:p0646:b003:l006","ordinal":125953,"en":"They patrolled and scouted the road,"},{"id":"semetey-1-2013:p0646:b003:l007","ordinal":125954,"en":"And whole otter pelts"},{"id":"semetey-1-2013:p0646:b003:l008","ordinal":125955,"en":"They put upon their trouser cuffs."},{"id":"semetey-1-2013:p0646:b003:l009","ordinal":125956,"en":"Eating yearlings suckled by barren mares,"},{"id":"semetey-1-2013:p0646:b003:l010","ordinal":125957,"en":"Eating rich fat from wethers,"},{"id":"semetey-1-2013:p0646:b003:l011","ordinal":125958,"en":"The lame smith and forty guards,"},{"id":"semetey-1-2013:p0646:b003:l012","ordinal":125959,"en":"Until the lord's son returned,"},{"id":"semetey-1-2013:p0646:b003:l013","ordinal":125960,"en":"Kayipchi's dark ridge—"},{"id":"semetey-1-2013:p0646:b003:l014","ordinal":125961,"en":"There they chose to stand guard."},{"id":"semetey-1-2013:p0646:b003:l015","ordinal":125962,"en":"Their brows thus cleared;"},{"id":"semetey-1-2013:p0646:b003:l016","ordinal":125963,"en":"There they became as sultans."},{"id":"semetey-1-2013:p0646:b003:l017","ordinal":125964,"en":"Let us leave them thus,"},{"id":"semetey-1-2013:p0646:b003:l018","ordinal":125965,"en":"And of leopard Bakai and Semetey,"},{"id":"semetey-1-2013:p0646:b003:l019","ordinal":125966,"en":"Let us begin the tale from here."},{"id":"semetey-1-2013:p0646:b003:l020","ordinal":125967,"en":"He taught what was unknown,"},{"id":"semetey-1-2013:p0646:b003:l021","ordinal":125968,"en":"That learned elder Bakai."},{"id":"semetey-1-2013:p0646:b003:l022","ordinal":125969,"en":"He made the unperceived understood,"},{"id":"semetey-1-2013:p0646:b003:l023","ordinal":125970,"en":"Falcon Bakai, the saint."},{"id":"semetey-1-2013:p0646:b003:l024","ordinal":125971,"en":"His knowledge was proven among the people,"},{"id":"semetey-1-2013:p0646:b003:l025","ordinal":125972,"en":"My falcon, the support left by Manas."},{"id":"semetey-1-2013:p0646:b003:l027","ordinal":125973,"en":"His deeds were bright, his worth proven,"},{"id":"semetey-1-2013:p0646:b003:l028","ordinal":125974,"en":"Support of the ancient sovereign,"},{"id":"semetey-1-2013:p0646:b003:l029","ordinal":125975,"en":"A guiding star from the sky,"},{"id":"semetey-1-2013:p0646:b003:l030","ordinal":125976,"en":"For Manas, gone to the other world,"},{"id":"semetey-1-2013:p0646:b003:l031","ordinal":125977,"en":"He would think and find the counsel—"},{"id":"semetey-1-2013:p0646:b003:l032","ordinal":125978,"en":"Renowned Bakai, his companion."},{"id":"semetey-1-2013:p0646:b003:l033","ordinal":125979,"en":"That fierce Bakai of yours"},{"id":"semetey-1-2013:p0646:b003:l034","ordinal":125980,"en":"Drew the gaze when seen."},{"id":"semetey-1-2013:p0646:b003:l035","ordinal":125981,"en":"As one looked, Khan Bakai"},{"id":"semetey-1-2013:p0646:b003:l036","ordinal":125982,"en":"Appeared like Opol Mountain."},{"id":"semetey-1-2013:p0646:b003:l037","ordinal":125983,"en":"Placed at the front, he brought good fortune;"},{"id":"semetey-1-2013:p0646:b003:l038","ordinal":125984,"en":"My elder Bakai was like countless hosts."},{"id":"semetey-1-2013:p0646:b003:l039","ordinal":125985,"en":"Once he put on battle dress,"},{"id":"semetey-1-2013:p0646:b004:l001","ordinal":125986,"en":"His supporter was Khojosan,"},{"id":"semetey-1-2013:p0646:b004:l002","ordinal":125987,"en":"His guides, the forty hidden saints."},{"id":"semetey-1-2013:p0646:b004:l003","ordinal":125988,"en":"He appeared in his true form."},{"id":"semetey-1-2013:p0646:b004:l004","ordinal":125989,"en":"“My elder's protectors"},{"id":"semetey-1-2013:p0646:b004:l005","ordinal":125990,"en":"Are equal to my father Manas's,” he thought."},{"id":"semetey-1-2013:p0646:b004:l006","ordinal":125991,"en":"Thus the boy's attention was drawn."},{"id":"semetey-1-2013:p0646:b004:l007","ordinal":125992,"en":"Good heavens, Kökcholok beneath him—"},{"id":"semetey-1-2013:p0646:b004:l008","ordinal":125993,"en":"The wind could not match his trot."},{"id":"semetey-1-2013:p0646:b004:l009","ordinal":125994,"en":"That day, Kökcholok,"},{"id":"semetey-1-2013:p0646:b004:l010","ordinal":125995,"en":"No beast could match his walk."},{"id":"semetey-1-2013:p0646:b004:l011","ordinal":125996,"en":"When he came to stony ground,"},{"id":"semetey-1-2013:p0646:b004:l012","ordinal":125997,"en":"Stones crumbled like charcoal."},{"id":"semetey-1-2013:p0646:b004:l013","ordinal":125998,"en":"Here and there, clods from his hooves"},{"id":"semetey-1-2013:p0646:b004:l014","ordinal":125999,"en":"Whistled above his head."},{"id":"semetey-1-2013:p0646:b004:l015","ordinal":126000,"en":"When he came to a hollow,"},{"id":"semetey-1-2013:p0646:b004:l016","ordinal":126001,"en":"The heads of fescue rattled."},{"id":"semetey-1-2013:p0646:b004:l017","ordinal":126002,"en":"Seeing this, Semetey,"},{"id":"semetey-1-2013:p0646:b004:l018","ordinal":126003,"en":"The warrior, stood grieving."},{"id":"semetey-1-2013:p0646:b004:l019","ordinal":126004,"en":"“This is God's decree."},{"id":"semetey-1-2013:p0646:b004:l020","ordinal":126005,"en":"This horse of my elder"},{"id":"semetey-1-2013:p0646:b004:l021","ordinal":126006,"en":"Was a winged steed from the first."},{"id":"semetey-1-2013:p0646:b004:l022","ordinal":126007,"en":"What must he have been in his youth?"},{"id":"semetey-1-2013:p0646:b004:l023","ordinal":126008,"en":"Herding camels amid shouts,"},{"id":"semetey-1-2013:p0646:b004:l024","ordinal":126009,"en":"His back grew sore, his color faded."},{"id":"semetey-1-2013:p0646:b004:l025","ordinal":126010,"en":"Losing his mane and tail,"},{"id":"semetey-1-2013:p0646:b004:l026","ordinal":126011,"en":"This year he was named Kökcholok."},{"id":"semetey-1-2013:p0646:b004:l027","ordinal":126012,"en":"Has the fine beast fallen into disgrace?”"},{"id":"semetey-1-2013:p0646:b004:l028","ordinal":126013,"en":"Grieving at the sight of Kökcholok,"},{"id":"semetey-1-2013:p0646:b004:l029","ordinal":126014,"en":"The orphan stood thus now."},{"id":"semetey-1-2013:p0646:b004:l030","ordinal":126015,"en":"Accomplished Khan Bakai"},{"id":"semetey-1-2013:p0646:b004:l031","ordinal":126016,"en":"Now began to speak:"},{"id":"semetey-1-2013:p0646:b004:l032","ordinal":126017,"en":"“Abyke and Köbösh, my kinsmen,"},{"id":"semetey-1-2013:p0646:b004:l033","ordinal":126018,"en":"I knew their every deed."},{"id":"semetey-1-2013:p0646:b004:l034","ordinal":126019,"en":"Your father, gone to the other world,"},{"id":"semetey-1-2013:p0646:b004:l035","ordinal":126020,"en":"My friend for the hereafter—"},{"id":"semetey-1-2013:p0646:b004:l036","ordinal":126021,"en":"I have honored his spirit."},{"id":"semetey-1-2013:p0646:b004:l037","ordinal":126022,"en":"Their harshness I knew long ago;"},{"id":"semetey-1-2013:p0646:b004:l038","ordinal":126023,"en":"The fierce one gone to the other world,"},{"id":"semetey-1-2013:p0646:b004:l039","ordinal":126024,"en":"I have honored his spirit."},{"id":"semetey-1-2013:p0647:b003:l001","ordinal":126025,"en":"‘When he reaches twelve,"},{"id":"semetey-1-2013:p0647:b003:l002","ordinal":126026,"en":"Will my orphan come?’ I wondered,"},{"id":"semetey-1-2013:p0647:b003:l003","ordinal":126027,"en":"My heart burning for you."},{"id":"semetey-1-2013:p0647:b003:l004","ordinal":126028,"en":"I speak at length, orphan; listen."},{"id":"semetey-1-2013:p0647:b003:l005","ordinal":126029,"en":"I still have more to tell."},{"id":"semetey-1-2013:p0647:b003:l006","ordinal":126030,"en":"When Abyke and Köbösh opened my treasury,"},{"id":"semetey-1-2013:p0647:b003:l007","ordinal":126031,"en":"Kanykei, on whom I relied,"},{"id":"semetey-1-2013:p0647:b003:l008","ordinal":126032,"en":"Fled wandering to Bukhara."},{"id":"semetey-1-2013:p0647:b003:l009","ordinal":126033,"en":"When the Almighty brought it upon us,"},{"id":"semetey-1-2013:p0647:b003:l010","ordinal":126034,"en":"Damn it, such is the world!"},{"id":"semetey-1-2013:p0647:b003:l011","ordinal":126035,"en":"When your Bakai was left herding camels,"},{"id":"semetey-1-2013:p0647:b003:l012","ordinal":126036,"en":"To seize the camels as booty,"},{"id":"semetey-1-2013:p0647:b003:l013","ordinal":126037,"en":"Your old elder Bakai"},{"id":"semetey-1-2013:p0647:b003:l014","ordinal":126038,"en":"To capture, then live at ease,"},{"id":"semetey-1-2013:p0647:b003:l015","ordinal":126039,"en":"To perform this exploit,"},{"id":"semetey-1-2013:p0647:b003:l016","ordinal":126040,"en":"To kill me thus,"},{"id":"semetey-1-2013:p0647:b003:l017","ordinal":126041,"en":"Those dogs together drew their bows,"},{"id":"semetey-1-2013:p0647:b003:l018","ordinal":126042,"en":"When they came together and besieged me,"},{"id":"semetey-1-2013:p0647:b003:l019","ordinal":126043,"en":"We exchanged shots without sparing our lives,"},{"id":"semetey-1-2013:p0647:b003:l020","ordinal":126044,"en":"And suffered hardship."},{"id":"semetey-1-2013:p0647:b003:l021","ordinal":126045,"en":"Without rest by day or night,"},{"id":"semetey-1-2013:p0647:b003:l022","ordinal":126046,"en":"We fought without a pause."},{"id":"semetey-1-2013:p0647:b003:l023","ordinal":126047,"en":"They came within reach; I shot."},{"id":"semetey-1-2013:p0647:b003:l024","ordinal":126048,"en":"I shot all sixty of them."},{"id":"semetey-1-2013:p0647:b003:l025","ordinal":126049,"en":"I still have more to tell:"},{"id":"semetey-1-2013:p0647:b003:l026","ordinal":126050,"en":"On the coming Day of Judgment,"},{"id":"semetey-1-2013:p0647:b003:l027","ordinal":126051,"en":"Your poor elder Bakai"},{"id":"semetey-1-2013:p0647:b003:l028","ordinal":126052,"en":"Has the blood of sixty warriors upon him."},{"id":"semetey-1-2013:p0647:b003:l029","ordinal":126053,"en":"Your elder in his old age"},{"id":"semetey-1-2013:p0647:b003:l030","ordinal":126054,"en":"Has had his share of bloodthirstiness."},{"id":"semetey-1-2013:p0647:b003:l031","ordinal":126055,"en":"Your elder who has sheltered them"},{"id":"semetey-1-2013:p0647:b003:l032","ordinal":126056,"en":"Has a people of five hundred households."},{"id":"semetey-1-2013:p0647:b003:l033","ordinal":126057,"en":"‘Your extinguished light has truly returned,’"},{"id":"semetey-1-2013:p0647:b003:l034","ordinal":126058,"en":"To my people here,"},{"id":"semetey-1-2013:p0647:b003:l035","ordinal":126059,"en":"I have glad news to announce.”"},{"id":"semetey-1-2013:p0647:b003:l036","ordinal":126060,"en":"So saying, mighty Bakai"},{"id":"semetey-1-2013:p0647:b003:l037","ordinal":126061,"en":"Led the way toward the cliff,"},{"id":"semetey-1-2013:p0647:b003:l038","ordinal":126062,"en":"And began to trace the path."},{"id":"semetey-1-2013:p0647:b004:l001","ordinal":126063,"en":"‘My warrior boy has come,’","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0647:b004:l002","ordinal":126064,"en":"Bakai meant to make rejoicing."},{"id":"semetey-1-2013:p0647:b004:l003","ordinal":126065,"en":"Semetey was behind him;"},{"id":"semetey-1-2013:p0647:b004:l004","ordinal":126066,"en":"Mighty Bakai was in front."},{"id":"semetey-1-2013:p0647:b004:l005","ordinal":126067,"en":"Ah, that Kökcholok of his!"},{"id":"semetey-1-2013:p0647:b004:l006","ordinal":126068,"en":"The ground he trod crumbled."},{"id":"semetey-1-2013:p0647:b004:l007","ordinal":126069,"en":"Clods as big as great cauldrons"},{"id":"semetey-1-2013:p0647:b004:l008","ordinal":126070,"en":"Whistled above Bakai's head."},{"id":"semetey-1-2013:p0647:b004:l009","ordinal":126071,"en":"His Kökcholok strained,"},{"id":"semetey-1-2013:p0647:b004:l010","ordinal":126072,"en":"Plunging as though his rider had died."},{"id":"semetey-1-2013:p0647:b004:l011","ordinal":126073,"en":"The reins knotted with braided thongs"},{"id":"semetey-1-2013:p0647:b004:l012","ordinal":126074,"en":"Pulled taut in his palm."},{"id":"semetey-1-2013:p0647:b004:l013","ordinal":126075,"en":"Five hundred households under his hand,"},{"id":"semetey-1-2013:p0647:b004:l014","ordinal":126076,"en":"They passed among the people."},{"id":"semetey-1-2013:p0647:b004:l015","ordinal":126077,"en":"To Baimirza, elder of the people,"},{"id":"semetey-1-2013:p0647:b004:l016","ordinal":126078,"en":"They announced the glad news:"},{"id":"semetey-1-2013:p0647:b004:l017","ordinal":126079,"en":"“Oh, Baimirza, elder khan,"},{"id":"semetey-1-2013:p0647:b004:l018","ordinal":126080,"en":"God has granted your wish."},{"id":"semetey-1-2013:p0647:b004:l019","ordinal":126081,"en":"The only son of King Manas Khan,"},{"id":"semetey-1-2013:p0647:b004:l020","ordinal":126082,"en":"That dear one you longed for has come!"},{"id":"semetey-1-2013:p0647:b004:l021","ordinal":126083,"en":"What broke has been joined;"},{"id":"semetey-1-2013:p0647:b004:l022","ordinal":126084,"en":"What scattered has been gathered."},{"id":"semetey-1-2013:p0647:b004:l023","ordinal":126085,"en":"God has granted your wish;"},{"id":"semetey-1-2013:p0647:b004:l024","ordinal":126086,"en":"The orphan you watched for has come."},{"id":"semetey-1-2013:p0647:b004:l026","ordinal":126087,"en":"All your flesh has been covered.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0647:b004:l027","ordinal":126088,"en":"The fierce one's son has come."},{"id":"semetey-1-2013:p0647:b004:l028","ordinal":126089,"en":"My dear Baimirza,"},{"id":"semetey-1-2013:p0647:b004:l029","ordinal":126090,"en":"Those who slaughter camels, slaughter camels;"},{"id":"semetey-1-2013:p0647:b004:l030","ordinal":126091,"en":"Those who slaughter sheep, slaughter sheep."},{"id":"semetey-1-2013:p0647:b004:l031","ordinal":126092,"en":"Your plump, gray-mottled falcon—"},{"id":"semetey-1-2013:p0647:b004:l032","ordinal":126093,"en":"Look at his form, attend and know him,"},{"id":"semetey-1-2013:p0647:b004:l033","ordinal":126094,"en":"The gray hawk, the morning star left by Manas."},{"id":"semetey-1-2013:p0647:b004:l036","ordinal":126095,"en":"What you watched for has appeared;","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0647:b004:l037","ordinal":126096,"en":"Your blessing has thus been found."},{"id":"semetey-1-2013:p0647:b004:l038","ordinal":126097,"en":"To your elder who suffered anguish,"},{"id":"semetey-1-2013:p0647:b004:l039","ordinal":126098,"en":"Here has come the warrior's son!”"},{"id":"semetey-1-2013:p0648:b003:l001","ordinal":126099,"en":"When Baimirza heard this,"},{"id":"semetey-1-2013:p0648:b003:l002","ordinal":126100,"en":"It was the hour God granted his wish."},{"id":"semetey-1-2013:p0648:b003:l003","ordinal":126101,"en":"He had reached ninety-five years."},{"id":"semetey-1-2013:p0648:b003:l004","ordinal":126102,"en":"He too was an elder, a father to the people,"},{"id":"semetey-1-2013:p0648:b003:l005","ordinal":126103,"en":"A saint who had seen much."},{"id":"semetey-1-2013:p0648:b003:l006","ordinal":126104,"en":"Raising his hands, he cried aloud,"},{"id":"semetey-1-2013:p0648:b003:l007","ordinal":126105,"en":"He too cried the battle cry, ‘Manas!’"},{"id":"semetey-1-2013:p0648:b003:l008","ordinal":126106,"en":"Taking the short way along the narrow cliff,"},{"id":"semetey-1-2013:p0648:b003:l009","ordinal":126107,"en":"Leading his gray young camel for Baabedin:"},{"id":"semetey-1-2013:p0648:b003:l010","ordinal":126108,"en":"“Oh, my dear Khan Bakai,"},{"id":"semetey-1-2013:p0648:b003:l011","ordinal":126109,"en":"Turn your horse's head a moment;"},{"id":"semetey-1-2013:p0648:b003:l012","ordinal":126110,"en":"Stand there ahead a moment."},{"id":"semetey-1-2013:p0648:b003:l013","ordinal":126111,"en":"Let me speak my sorrowful words;"},{"id":"semetey-1-2013:p0648:b003:l014","ordinal":126112,"en":"My precious Bakai, listen!"},{"id":"semetey-1-2013:p0648:b003:l015","ordinal":126113,"en":"Semetey, son of Manas—"},{"id":"semetey-1-2013:p0648:b003:l016","ordinal":126114,"en":"Where is the day when he will come?"},{"id":"semetey-1-2013:p0648:b003:l017","ordinal":126115,"en":"Semetey, for wretched me—"},{"id":"semetey-1-2013:p0648:b003:l018","ordinal":126116,"en":"Where is the day when I shall see him?"},{"id":"semetey-1-2013:p0648:b003:l019","ordinal":126117,"en":"If Semetey comes, will Baimirza"},{"id":"semetey-1-2013:p0648:b003:l020","ordinal":126118,"en":"Have a day when he himself may die?"},{"id":"semetey-1-2013:p0648:b003:l021","ordinal":126119,"en":"And Semetey, for Baimirza,"},{"id":"semetey-1-2013:p0648:b003:l022","ordinal":126120,"en":"Wailing, ‘Father!’—"},{"id":"semetey-1-2013:p0648:b003:l023","ordinal":126121,"en":"Will there be a day when he buries me?"},{"id":"semetey-1-2013:p0648:b003:l024","ordinal":126122,"en":"Kanykei went away in mourning."},{"id":"semetey-1-2013:p0648:b003:l025","ordinal":126123,"en":"Semetey fled in those days."},{"id":"semetey-1-2013:p0648:b003:l026","ordinal":126124,"en":"Kanykei went away a widow;"},{"id":"semetey-1-2013:p0648:b003:l027","ordinal":126125,"en":"Semetey went to Bukhara."},{"id":"semetey-1-2013:p0648:b003:l028","ordinal":126126,"en":"It is the hour God granted our wish,"},{"id":"semetey-1-2013:p0648:b003:l029","ordinal":126127,"en":"The hour he has reached twelve years."},{"id":"semetey-1-2013:p0648:b003:l031","ordinal":126128,"en":"Where is a night like the Night of Power?","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0648:b003:l032","ordinal":126129,"en":"The orphan, son of Manas—"},{"id":"semetey-1-2013:p0648:b003:l033","ordinal":126130,"en":"Where is the day I see him again?”"},{"id":"semetey-1-2013:p0648:b003:l034","ordinal":126131,"en":"So saying, groaning,"},{"id":"semetey-1-2013:p0648:b003:l035","ordinal":126132,"en":"Baimirza slaughtered his gray young camel."},{"id":"semetey-1-2013:p0648:b003:l036","ordinal":126133,"en":"While Baimirza did this,"},{"id":"semetey-1-2013:p0648:b003:l037","ordinal":126134,"en":"Birches wept, willows wept,"},{"id":"semetey-1-2013:p0648:b003:l038","ordinal":126135,"en":"Everyone who looked on wept."},{"id":"semetey-1-2013:p0648:b003:l039","ordinal":126136,"en":"The venerable elder wept;"},{"id":"semetey-1-2013:p0648:b004:l001","ordinal":126137,"en":"All those people wept."},{"id":"semetey-1-2013:p0648:b004:l002","ordinal":126138,"en":"The lion supported by the patron wept;"},{"id":"semetey-1-2013:p0648:b004:l003","ordinal":126139,"en":"The people of five hundred households wept."},{"id":"semetey-1-2013:p0648:b004:l004","ordinal":126140,"en":"For the longing in his heart,"},{"id":"semetey-1-2013:p0648:b004:l005","ordinal":126141,"en":"Nine black bulls"},{"id":"semetey-1-2013:p0648:b004:l006","ordinal":126142,"en":"He had slaughtered for the boy then."},{"id":"semetey-1-2013:p0648:b004:l007","ordinal":126143,"en":"Poor Baimirza cried aloud."},{"id":"semetey-1-2013:p0648:b004:l008","ordinal":126144,"en":"At ninety-five, the elder,"},{"id":"semetey-1-2013:p0648:b004:l009","ordinal":126145,"en":"Tossing as he wept,"},{"id":"semetey-1-2013:p0648:b004:l010","ordinal":126146,"en":"Pleaded with his orphan Semetey."},{"id":"semetey-1-2013:p0648:b004:l011","ordinal":126147,"en":"Left by mountain-like, fierce Manas,"},{"id":"semetey-1-2013:p0648:b004:l012","ordinal":126148,"en":"Semetey, left to fall into ruin;"},{"id":"semetey-1-2013:p0648:b004:l013","ordinal":126149,"en":"Left by ridge-like, fierce Manas,"},{"id":"semetey-1-2013:p0648:b004:l014","ordinal":126150,"en":"Semetey, left as a gift."},{"id":"semetey-1-2013:p0648:b004:l015","ordinal":126151,"en":"“My plump gray-mottled falcon,"},{"id":"semetey-1-2013:p0648:b004:l016","ordinal":126152,"en":"Semetey, my morning star, who has come and made me weep,"},{"id":"semetey-1-2013:p0648:b004:l017","ordinal":126153,"en":"My marketplace left by my khan,"},{"id":"semetey-1-2013:p0648:b004:l018","ordinal":126154,"en":"Who brightens my brow,"},{"id":"semetey-1-2013:p0648:b004:l019","ordinal":126155,"en":"Who calms my lamenting heart,"},{"id":"semetey-1-2013:p0648:b004:l020","ordinal":126156,"en":"Who lifts my lowered brow,"},{"id":"semetey-1-2013:p0648:b004:l021","ordinal":126157,"en":"My delight left by my King Manas,"},{"id":"semetey-1-2013:p0648:b004:l022","ordinal":126158,"en":"When I look upon you, my belly is full,"},{"id":"semetey-1-2013:p0648:b004:l023","ordinal":126159,"en":"My mirror left by King Manas,”"},{"id":"semetey-1-2013:p0648:b004:l024","ordinal":126160,"en":"So spoke Baimirza."},{"id":"semetey-1-2013:p0648:b004:l025","ordinal":126161,"en":"With Baimirza first, the elders wept;"},{"id":"semetey-1-2013:p0648:b004:l026","ordinal":126162,"en":"All the people who had come wept."},{"id":"semetey-1-2013:p0648:b004:l027","ordinal":126163,"en":"The wandering orphan was found;"},{"id":"semetey-1-2013:p0648:b004:l028","ordinal":126164,"en":"Thus their shame was covered."},{"id":"semetey-1-2013:p0648:b004:l029","ordinal":126165,"en":"Many of the people slaughtered mares;"},{"id":"semetey-1-2013:p0648:b004:l030","ordinal":126166,"en":"Many of the people slaughtered camels."},{"id":"semetey-1-2013:p0648:b004:l031","ordinal":126167,"en":"There the people beheld him with joy;"},{"id":"semetey-1-2013:p0648:b004:l032","ordinal":126168,"en":"There dear Semetey had come."},{"id":"semetey-1-2013:p0648:b004:l033","ordinal":126169,"en":"Then Bakai dashed away."},{"id":"semetey-1-2013:p0648:b004:l034","ordinal":126170,"en":"His senior wife Körpöyan,"},{"id":"semetey-1-2013:p0648:b004:l035","ordinal":126171,"en":"His only son Baitailak—"},{"id":"semetey-1-2013:p0648:b004:l036","ordinal":126172,"en":"Hastening, Bakai, warrior sultan,"},{"id":"semetey-1-2013:p0648:b004:l037","ordinal":126173,"en":"Spurred toward them."},{"id":"semetey-1-2013:p0648:b004:l038","ordinal":126174,"en":"Again Bakai cried aloud,"},{"id":"semetey-1-2013:p0648:b004:l039","ordinal":126175,"en":"Calling out the glad news,"},{"id":"semetey-1-2013:p0649:b003:l001","ordinal":126176,"en":"Hastening, crying, “Baabedin!” he spurred on."},{"id":"semetey-1-2013:p0649:b003:l003","ordinal":126177,"en":"“My father is hurrying out toward us!”"},{"id":"semetey-1-2013:p0649:b003:l004","ordinal":126178,"en":"Bakai's wretched son Baitailak—"},{"id":"semetey-1-2013:p0649:b003:l005","ordinal":126179,"en":"God struck him now."},{"id":"semetey-1-2013:p0649:b003:l006","ordinal":126180,"en":"Standing on a hill, Baitailak"},{"id":"semetey-1-2013:p0649:b003:l007","ordinal":126181,"en":"Thought an unthought-of thought:"},{"id":"semetey-1-2013:p0649:b003:l008","ordinal":126182,"en":"“There must be a deep pit dug for us,"},{"id":"semetey-1-2013:p0649:b003:l009","ordinal":126183,"en":"There must be misery set to boil."},{"id":"semetey-1-2013:p0649:b003:l010","ordinal":126184,"en":"Up Jar-Kiya of Jangirik,"},{"id":"semetey-1-2013:p0649:b003:l011","ordinal":126185,"en":"Climbing toward us,"},{"id":"semetey-1-2013:p0649:b003:l012","ordinal":126186,"en":"There must be a mighty host of ten thousand."},{"id":"semetey-1-2013:p0649:b003:l013","ordinal":126187,"en":"The Chinese have risen from Kakan;"},{"id":"semetey-1-2013:p0649:b003:l014","ordinal":126188,"en":"The God who strikes has struck us, it seems."},{"id":"semetey-1-2013:p0649:b003:l015","ordinal":126189,"en":"They have beaten my father,"},{"id":"semetey-1-2013:p0649:b003:l016","ordinal":126190,"en":"And slaughtered the people along the road!"},{"id":"semetey-1-2013:p0649:b003:l017","ordinal":126191,"en":"My father, poor Bakai—"},{"id":"semetey-1-2013:p0649:b003:l018","ordinal":126192,"en":"To turn water into his orchards,"},{"id":"semetey-1-2013:p0649:b003:l019","ordinal":126193,"en":"To make them into gardens,"},{"id":"semetey-1-2013:p0649:b003:l020","ordinal":126194,"en":"To drag him along the road,"},{"id":"semetey-1-2013:p0649:b003:l021","ordinal":126195,"en":"To have the dogs tear him apart,"},{"id":"semetey-1-2013:p0649:b003:l022","ordinal":126196,"en":"The enemy must have pursued him,"},{"id":"semetey-1-2013:p0649:b003:l023","ordinal":126197,"en":"God must have struck us thus!"},{"id":"semetey-1-2013:p0649:b003:l024","ordinal":126198,"en":"Helpless, crying out,"},{"id":"semetey-1-2013:p0649:b003:l025","ordinal":126199,"en":"Calling, ‘Baitailak!’"},{"id":"semetey-1-2013:p0649:b003:l026","ordinal":126200,"en":"Hurrying, stumbling in alarm,"},{"id":"semetey-1-2013:p0649:b003:l027","ordinal":126201,"en":"Has my father fled?"},{"id":"semetey-1-2013:p0649:b003:l028","ordinal":126202,"en":"Relentlessly upon his trail,"},{"id":"semetey-1-2013:p0649:b003:l029","ordinal":126203,"en":"Have they pursued him to exhaustion?"},{"id":"semetey-1-2013:p0649:b003:l030","ordinal":126204,"en":"They must have fallen upon us,"},{"id":"semetey-1-2013:p0649:b003:l031","ordinal":126205,"en":"Scattered all four kinds of livestock."},{"id":"semetey-1-2013:p0649:b003:l032","ordinal":126206,"en":"To seize my father,"},{"id":"semetey-1-2013:p0649:b003:l033","ordinal":126207,"en":"Have they come close behind him?"},{"id":"semetey-1-2013:p0649:b003:l034","ordinal":126208,"en":"As though to slaughter him as a sacrifice,"}]
