,{"id":"semetey-2-2013:p1189:b004:l029","ordinal":278217,"en":"Kairan letter Aichüruk"},{"id":"semetey-2-2013:p1189:b004:l030","ordinal":278218,"en":"The murderer said that"},{"id":"semetey-2-2013:p1189:b004:l031","ordinal":278219,"en":"Don't let the moon tear your face."},{"id":"semetey-2-2013:p1189:b004:l032","ordinal":278220,"en":"If he is sad, he will be insulted"},{"id":"semetey-2-2013:p1189:b004:l033","ordinal":278221,"en":"My word is a deposit,"},{"id":"semetey-2-2013:p1189:b004:l034","ordinal":278222,"en":"Cross the required letter"},{"id":"semetey-2-2013:p1189:b004:l035","ordinal":278223,"en":"Let him give birth to his head,"},{"id":"semetey-2-2013:p1189:b004:l036","ordinal":278224,"en":"Let the letter be brave."},{"id":"semetey-2-2013:p1189:b004:l037","ordinal":278225,"en":"Let the heroes be tamed,"},{"id":"semetey-2-2013:p1189:b004:l038","ordinal":278226,"en":"The rest of the Kyrgyz are of low ethnic origin"},{"id":"semetey-2-2013:p1189:b004:l039","ordinal":278227,"en":"Keep it as an excuse,"},{"id":"semetey-2-2013:p1190:b003:l001","ordinal":278228,"en":"Talas, Ken-Koldu"},{"id":"semetey-2-2013:p1190:b003:l002","ordinal":278229,"en":"Let him live with his mother,"},{"id":"semetey-2-2013:p1190:b003:l003","ordinal":278230,"en":"Bere, Argyn, Kyrgyz brave people"},{"id":"semetey-2-2013:p1190:b003:l004","ordinal":278231,"en":"Let people do it with Ebi."},{"id":"semetey-2-2013:p1190:b003:l005","ordinal":278232,"en":"I salute you,"},{"id":"semetey-2-2013:p1190:b003:l006","ordinal":278233,"en":"News from the grandson!"},{"id":"semetey-2-2013:p1190:b003:l007","ordinal":278234,"en":"A word to the cross -"},{"id":"semetey-2-2013:p1190:b003:l008","ordinal":278235,"en":"When death comes and the day ends,"},{"id":"semetey-2-2013:p1190:b003:l009","ordinal":278236,"en":"Dear Kulchorom,"},{"id":"semetey-2-2013:p1190:b003:l010","ordinal":278237,"en":"This is the time to say."},{"id":"semetey-2-2013:p1190:b003:l011","ordinal":278238,"en":"Probably no bastard"},{"id":"semetey-2-2013:p1190:b003:l012","ordinal":278239,"en":"A rich treasure."},{"id":"semetey-2-2013:p1190:b003:l013","ordinal":278240,"en":"Let the treasure open its mouth,"},{"id":"semetey-2-2013:p1190:b003:l014","ordinal":278241,"en":"Miskin, copper, dubana,"},{"id":"semetey-2-2013:p1190:b003:l015","ordinal":278242,"en":"To orphans and widows,"},{"id":"semetey-2-2013:p1190:b003:l016","ordinal":278243,"en":"To the blind that leads,"},{"id":"semetey-2-2013:p1190:b003:l017","ordinal":278244,"en":"To the munju who smokes beans,"},{"id":"semetey-2-2013:p1190:b003:l018","ordinal":278245,"en":"Weak and poor,"},{"id":"semetey-2-2013:p1190:b003:l019","ordinal":278246,"en":"He is a hoard of treasure"},{"id":"semetey-2-2013:p1190:b003:l020","ordinal":278247,"en":"Let it dry and sprinkle it!"},{"id":"semetey-2-2013:p1190:b003:l021","ordinal":278248,"en":"The horse on the mountain is nine numbers"},{"id":"semetey-2-2013:p1190:b003:l022","ordinal":278249,"en":"Bean-steam mixture."},{"id":"semetey-2-2013:p1190:b003:l023","ordinal":278250,"en":"Let him agree with what he said,"},{"id":"semetey-2-2013:p1190:b003:l024","ordinal":278251,"en":"Argyn, to the humble Kyrgyz,"},{"id":"semetey-2-2013:p1190:b003:l025","ordinal":278252,"en":"A large number of people,"},{"id":"semetey-2-2013:p1190:b003:l026","ordinal":278253,"en":"Old and young,"},{"id":"semetey-2-2013:p1190:b003:l027","ordinal":278254,"en":"Man, next to the letter,"},{"id":"semetey-2-2013:p1190:b003:l028","ordinal":278255,"en":"Let the horse move,"},{"id":"semetey-2-2013:p1190:b003:l029","ordinal":278256,"en":"As a legacy from a murderer,"},{"id":"semetey-2-2013:p1190:b003:l030","ordinal":278257,"en":"Distribute to the masses"},{"id":"semetey-2-2013:p1190:b003:l031","ordinal":278258,"en":"And give many horses,"},{"id":"semetey-2-2013:p1190:b003:l032","ordinal":278259,"en":"I have an idea that transcends the universe"},{"id":"semetey-2-2013:p1190:b003:l033","ordinal":278260,"en":"A along Talas"},{"id":"semetey-2-2013:p1190:b003:l034","ordinal":278261,"en":"There are grazing cows, camels, bet,"},{"id":"semetey-2-2013:p1190:b003:l035","ordinal":278262,"en":"The top is nine numbers,"},{"id":"semetey-2-2013:p1190:b003:l036","ordinal":278263,"en":"My blood was a glory to the people."},{"id":"semetey-2-2013:p1190:b003:l037","ordinal":278264,"en":"Whatever you say,"},{"id":"semetey-2-2013:p1190:b003:l038","ordinal":278265,"en":"All of you are worthless"},{"id":"semetey-2-2013:p1190:b003:l039","ordinal":278266,"en":"Make a noise,"},{"id":"semetey-2-2013:p1190:b004:l001","ordinal":278267,"en":"Making noise in the crowd"},{"id":"semetey-2-2013:p1190:b004:l002","ordinal":278268,"en":"Back to the Kyrgyz people"},{"id":"semetey-2-2013:p1190:b004:l003","ordinal":278269,"en":"Give it without delay"},{"id":"semetey-2-2013:p1190:b004:l004","ordinal":278270,"en":"Bearded, young and old"},{"id":"semetey-2-2013:p1190:b004:l005","ordinal":278271,"en":"Kadyrman is a bloodthirsty people."},{"id":"semetey-2-2013:p1190:b004:l006","ordinal":278272,"en":"Have a great week"}]
