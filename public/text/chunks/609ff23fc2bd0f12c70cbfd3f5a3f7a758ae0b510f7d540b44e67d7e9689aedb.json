[{"id":"semetey-1-2013:p0178:b004:l035","ordinal":90369,"en":"The thirteenth was Kanykei,"},{"id":"semetey-1-2013:p0178:b004:l036","ordinal":90370,"en":"The fourteenth, Ismayil,"},{"id":"semetey-1-2013:p0178:b004:l037","ordinal":90371,"en":"Was his only son, born after long yearning."},{"id":"semetey-1-2013:p0178:b004:l039","ordinal":90372,"en":"What he had asked of the one God"},{"id":"semetey-1-2013:p0179:b003:l001","ordinal":90373,"en":"Had now been granted to him."},{"id":"semetey-1-2013:p0179:b003:l002","ordinal":90374,"en":"He had reached twenty-five;"},{"id":"semetey-1-2013:p0179:b003:l003","ordinal":90375,"en":"That time had now arrived."},{"id":"semetey-1-2013:p0179:b003:l004","ordinal":90376,"en":"At that time Ismayil"},{"id":"semetey-1-2013:p0179:b003:l005","ordinal":90377,"en":"Wore a golden crown"},{"id":"semetey-1-2013:p0179:b003:l006","ordinal":90378,"en":"And sat upon a golden throne."},{"id":"semetey-1-2013:p0179:b003:l007","ordinal":90379,"en":"Among twelve nations, none could cast"},{"id":"semetey-1-2013:p0179:b003:l008","ordinal":90380,"en":"At a khan like Ismayil"},{"id":"semetey-1-2013:p0179:b003:l009","ordinal":90381,"en":"A catching-pole to turn him back."},{"id":"semetey-1-2013:p0179:b003:l010","ordinal":90382,"en":"Two reins and a single lead rope,"},{"id":"semetey-1-2013:p0179:b003:l011","ordinal":90383,"en":"Wound firmly about his wrist,"},{"id":"semetey-1-2013:p0179:b003:l012","ordinal":90384,"en":"He had taken hold of them."},{"id":"semetey-1-2013:p0179:b003:l013","ordinal":90385,"en":"In his father's place,"},{"id":"semetey-1-2013:p0179:b003:l014","ordinal":90386,"en":"Without letting his people stir,"},{"id":"semetey-1-2013:p0179:b003:l015","ordinal":90387,"en":"He had come to rule them."},{"id":"semetey-1-2013:p0179:b003:l016","ordinal":90388,"en":"Chasing wild sheep over the ridges,"},{"id":"semetey-1-2013:p0179:b003:l017","ordinal":90389,"en":"Chasing deer over rough terrain,"},{"id":"semetey-1-2013:p0179:b003:l018","ordinal":90390,"en":"Finding no mountain to challenge,"},{"id":"semetey-1-2013:p0179:b003:l019","ordinal":90391,"en":"Finding no enemy to fight,"},{"id":"semetey-1-2013:p0179:b003:l020","ordinal":90392,"en":"With sixty strongmen beside him,"},{"id":"semetey-1-2013:p0179:b003:l021","ordinal":90393,"en":"Ismayil, son of Temir Khan,"},{"id":"semetey-1-2013:p0179:b003:l022","ordinal":90394,"en":"Wore out his horse and scoured the land,"},{"id":"semetey-1-2013:p0179:b003:l023","ordinal":90395,"en":"Loosing hounds and flying hawks."},{"id":"semetey-1-2013:p0179:b003:l024","ordinal":90396,"en":"His strongmen strode about;"},{"id":"semetey-1-2013:p0179:b003:l025","ordinal":90397,"en":"Every one of his strongmen"},{"id":"semetey-1-2013:p0179:b003:l026","ordinal":90398,"en":"Was skilled with the spear,"},{"id":"semetey-1-2013:p0179:b003:l027","ordinal":90399,"en":"A master at striking with the battle-axe."},{"id":"semetey-1-2013:p0179:b003:l028","ordinal":90400,"en":"When a black gun thundered,"},{"id":"semetey-1-2013:p0179:b003:l029","ordinal":90401,"en":"They were champions who would not flee."},{"id":"semetey-1-2013:p0179:b003:l030","ordinal":90402,"en":"When a fierce gun cracked,"},{"id":"semetey-1-2013:p0179:b003:l031","ordinal":90403,"en":"They were skilled men who did not start."},{"id":"semetey-1-2013:p0179:b003:l032","ordinal":90404,"en":"Broad of chest and wide of breast,"},{"id":"semetey-1-2013:p0179:b003:l033","ordinal":90405,"en":"They were stately, capable men."},{"id":"semetey-1-2013:p0179:b003:l034","ordinal":90406,"en":"Tall and broad-shouldered,"},{"id":"semetey-1-2013:p0179:b003:l035","ordinal":90407,"en":"Every one of his strongmen"},{"id":"semetey-1-2013:p0179:b003:l036","ordinal":90408,"en":"Was a stately champion."},{"id":"semetey-1-2013:p0179:b003:l037","ordinal":90409,"en":"Their leader was Hero Ismayil,"},{"id":"semetey-1-2013:p0179:b003:l038","ordinal":90410,"en":"With sixty strongmen beside him."},{"id":"semetey-1-2013:p0179:b003:l039","ordinal":90411,"en":"On the slopes of It-Torpu,"},{"id":"semetey-1-2013:p0179:b005:l001","ordinal":90412,"en":"At the edge of Great Bukhara,"},{"id":"semetey-1-2013:p0179:b005:l002","ordinal":90413,"en":"On a spur where the mountains ended,"},{"id":"semetey-1-2013:p0179:b005:l003","ordinal":90414,"en":"On a blunt jutting headland,"},{"id":"semetey-1-2013:p0179:b005:l004","ordinal":90415,"en":"Ismayil came up"},{"id":"semetey-1-2013:p0179:b005:l005","ordinal":90416,"en":"And turned his great brown horse."},{"id":"semetey-1-2013:p0179:b005:l006","ordinal":90417,"en":"He shouted for his strongmen,"},{"id":"semetey-1-2013:p0179:b005:l007","ordinal":90418,"en":"Called his heroes;"},{"id":"semetey-1-2013:p0179:b005:l008","ordinal":90419,"en":"When his heroes came beside him,"},{"id":"semetey-1-2013:p0179:b005:l009","ordinal":90420,"en":"These were Ismayil's words:"},{"id":"semetey-1-2013:p0179:b005:l010","ordinal":90421,"en":"‘My dear strongmen,"},{"id":"semetey-1-2013:p0179:b005:l011","ordinal":90422,"en":"Come here, men!"},{"id":"semetey-1-2013:p0179:b005:l012","ordinal":90423,"en":"God creates the soul;"},{"id":"semetey-1-2013:p0179:b005:l013","ordinal":90424,"en":"My dear strongmen,"},{"id":"semetey-1-2013:p0179:b005:l014","ordinal":90425,"en":"My soul is leaving me."},{"id":"semetey-1-2013:p0179:b005:l015","ordinal":90426,"en":"My dear strongmen,"},{"id":"semetey-1-2013:p0179:b005:l016","ordinal":90427,"en":"A marten-fur cap upon the head—"},{"id":"semetey-1-2013:p0179:b005:l017","ordinal":90428,"en":"Who has not worn one jauntily?"},{"id":"semetey-1-2013:p0179:b005:l018","ordinal":90429,"en":"When good fortune rests upon one's head,"},{"id":"semetey-1-2013:p0179:b005:l019","ordinal":90430,"en":"Who has not gone about thundering?"},{"id":"semetey-1-2013:p0179:b005:l020","ordinal":90431,"en":"My dear strongmen,"},{"id":"semetey-1-2013:p0179:b005:l021","ordinal":90432,"en":"Let me speak my grief now."},{"id":"semetey-1-2013:p0179:b005:l022","ordinal":90433,"en":"At the sight of my brother-in-law,"},{"id":"semetey-1-2013:p0179:b005:l023","ordinal":90434,"en":"Not merely the Muslims—"},{"id":"semetey-1-2013:p0179:b005:l024","ordinal":90435,"en":"Even the Chinese khan trembled."},{"id":"semetey-1-2013:p0179:b005:l025","ordinal":90436,"en":"The Russians on his right—"},{"id":"semetey-1-2013:p0179:b005:l026","ordinal":90437,"en":"Was it not my brother-in-law who mowed them down?"},{"id":"semetey-1-2013:p0179:b005:l027","ordinal":90438,"en":"The Chinese upon the ridges—"},{"id":"semetey-1-2013:p0179:b005:l028","ordinal":90439,"en":"Was it not my brother-in-law who slaughtered them?"},{"id":"semetey-1-2013:p0179:b005:l029","ordinal":90440,"en":"He drove white deer and made them cattle;"},{"id":"semetey-1-2013:p0179:b005:l030","ordinal":90441,"en":"My brother-in-law, leopard Manas,"},{"id":"semetey-1-2013:p0179:b005:l031","ordinal":90442,"en":"Threw the whole world into turmoil!"},{"id":"semetey-1-2013:p0179:b005:l032","ordinal":90443,"en":"He drove gray deer and made them cattle;"},{"id":"semetey-1-2013:p0179:b005:l033","ordinal":90444,"en":"My brother-in-law, leopard Manas,"},{"id":"semetey-1-2013:p0179:b005:l034","ordinal":90445,"en":"Threw every land in sight into turmoil!"},{"id":"semetey-1-2013:p0179:b005:l035","ordinal":90446,"en":"With a road that Khizyr had opened,"},{"id":"semetey-1-2013:p0179:b005:l036","ordinal":90447,"en":"With four hundred twenty thousand troops,"},{"id":"semetey-1-2013:p0179:b005:l037","ordinal":90448,"en":"When he scattered the infidels' livestock,"},{"id":"semetey-1-2013:p0179:b005:l038","ordinal":90449,"en":"When he opened the way for Islam,"},{"id":"semetey-1-2013:p0179:b005:l039","ordinal":90450,"en":"Great Beijing, looming dark—"},{"id":"semetey-1-2013:p0180:b003:l001","ordinal":90451,"en":"When he entered straight in, thrusting his spear,"},{"id":"semetey-1-2013:p0180:b003:l002","ordinal":90452,"en":"From that darkened hell"},{"id":"semetey-1-2013:p0180:b003:l003","ordinal":90453,"en":"When he freed living souls,"},{"id":"semetey-1-2013:p0180:b003:l004","ordinal":90454,"en":"Into Beijing with its emperor,"},{"id":"semetey-1-2013:p0180:b003:l005","ordinal":90455,"en":"Spear in hand, he broke the ranks;"},{"id":"semetey-1-2013:p0180:b003:l006","ordinal":90456,"en":"Those whose time had come fell to bullets."},{"id":"semetey-1-2013:p0180:b003:l007","ordinal":90457,"en":"Then Muzburchak and Khan Kokcho died;"},{"id":"semetey-1-2013:p0180:b003:l008","ordinal":90458,"en":"All those who faced Beijing died."},{"id":"semetey-1-2013:p0180:b003:l010","ordinal":90459,"en":"Akkula was shot down;"},{"id":"semetey-1-2013:p0180:b003:l011","ordinal":90460,"en":"Fighting against the Chinese,"},{"id":"semetey-1-2013:p0180:b003:l012","ordinal":90461,"en":"Almambet passed away a martyr."},{"id":"semetey-1-2013:p0180:b003:l013","ordinal":90462,"en":"Deprived of his wing,"},{"id":"semetey-1-2013:p0180:b003:l014","ordinal":90463,"en":"The one he relied upon—"},{"id":"semetey-1-2013:p0180:b003:l015","ordinal":90464,"en":"Then he lost Khan Chubak."},{"id":"semetey-1-2013:p0180:b003:l016","ordinal":90465,"en":"Beijing, untouched by Khizyr,"},{"id":"semetey-1-2013:p0180:b003:l017","ordinal":90466,"en":"Had him ambushed from the ridges;"},{"id":"semetey-1-2013:p0180:b003:l018","ordinal":90467,"en":"All the mighty heroes"},{"id":"semetey-1-2013:p0180:b003:l019","ordinal":90468,"en":"Were taken by China as trophies."},{"id":"semetey-1-2013:p0180:b003:l020","ordinal":90469,"en":"He entered Beijing and turned back,"},{"id":"semetey-1-2013:p0180:b003:l021","ordinal":90470,"en":"Parted from his champions;"},{"id":"semetey-1-2013:p0180:b003:l022","ordinal":90471,"en":"Beijing, whose presence was fearsome,"},{"id":"semetey-1-2013:p0180:b003:l023","ordinal":90472,"en":"Caught him by surprise."},{"id":"semetey-1-2013:p0180:b003:l024","ordinal":90473,"en":"Konurbai, the infidels' khan,"},{"id":"semetey-1-2013:p0180:b003:l025","ordinal":90474,"en":"Stabbed him unawares."},{"id":"semetey-1-2013:p0180:b003:l026","ordinal":90475,"en":"Wounded, from that place"},{"id":"semetey-1-2013:p0180:b003:l027","ordinal":90476,"en":"He barely returned, I heard."},{"id":"semetey-1-2013:p0180:b003:l028","ordinal":90477,"en":"Struck among the ribs,"},{"id":"semetey-1-2013:p0180:b003:l029","ordinal":90478,"en":"Pierced square in the kidney,"},{"id":"semetey-1-2013:p0180:b003:l030","ordinal":90479,"en":"My blessed brother-in-law, Khan Manas,"},{"id":"semetey-1-2013:p0180:b003:l031","ordinal":90480,"en":"Came back in a terrible state, I heard."},{"id":"semetey-1-2013:p0180:b003:l032","ordinal":90481,"en":"Left all on her own,"},{"id":"semetey-1-2013:p0180:b003:l033","ordinal":90482,"en":"My sister lost her husband,"},{"id":"semetey-1-2013:p0180:b003:l034","ordinal":90483,"en":"At thirty-two years of age."},{"id":"semetey-1-2013:p0180:b003:l035","ordinal":90484,"en":"They say my brother-in-law has died."},{"id":"semetey-1-2013:p0180:b003:l036","ordinal":90485,"en":"From a traveler I heard"},{"id":"semetey-1-2013:p0180:b003:l037","ordinal":90486,"en":"That six accursed scoundrels"},{"id":"semetey-1-2013:p0180:b003:l038","ordinal":90487,"en":"The countless riches my brother-in-law left—"},{"id":"semetey-1-2013:p0180:b003:l039","ordinal":90488,"en":"They divided them, measuring shares with a whip."},{"id":"semetey-1-2013:p0180:b004:l001","ordinal":90489,"en":"Valuing that wealth at less than a penny,"},{"id":"semetey-1-2013:p0180:b004:l002","ordinal":90490,"en":"My leopard sister Kanykei,"},{"id":"semetey-1-2013:p0180:b004:l003","ordinal":90491,"en":"They say, scattered it all."},{"id":"semetey-1-2013:p0180:b004:l004","ordinal":90492,"en":"Carrying her child upon her back,"},{"id":"semetey-1-2013:p0180:b004:l005","ordinal":90493,"en":"Alas, she fled toward Bukhara, they say."},{"id":"semetey-1-2013:p0180:b004:l007","ordinal":90494,"en":"My dear strongmen,"},{"id":"semetey-1-2013:p0180:b004:l008","ordinal":90495,"en":"Let the skilled spearmen come;"},{"id":"semetey-1-2013:p0180:b004:l009","ordinal":90496,"en":"Clear of mind and true of speech,"},{"id":"semetey-1-2013:p0180:b004:l010","ordinal":90497,"en":"Let the champions who cannot stand idle come;"},{"id":"semetey-1-2013:p0180:b004:l011","ordinal":90498,"en":"Let the lions protected by Shay come;"},{"id":"semetey-1-2013:p0180:b004:l012","ordinal":90499,"en":"Let the men who can find counsel come."},{"id":"semetey-1-2013:p0180:b004:l014","ordinal":90500,"en":"When my leopard sister was a girl,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0180:b004:l015","ordinal":90501,"en":"My sister Kanykei"},{"id":"semetey-1-2013:p0180:b004:l016","ordinal":90502,"en":"Was still a little child;"},{"id":"semetey-1-2013:p0180:b004:l017","ordinal":90503,"en":"Her hair was not yet long enough to braid;"},{"id":"semetey-1-2013:p0180:b004:l018","ordinal":90504,"en":"She had not passed fourteen."},{"id":"semetey-1-2013:p0180:b004:l019","ordinal":90505,"en":"My dear sister Kanykei,"},{"id":"semetey-1-2013:p0180:b004:l020","ordinal":90506,"en":"The beauty of the dark-complexioned,"},{"id":"semetey-1-2013:p0180:b004:l021","ordinal":90507,"en":"The radiant one among Muslims,"},{"id":"semetey-1-2013:p0180:b004:l022","ordinal":90508,"en":"My father Temir Khan's golden throne—"},{"id":"semetey-1-2013:p0180:b004:l023","ordinal":90509,"en":"When she made her home there,"},{"id":"semetey-1-2013:p0180:b004:l024","ordinal":90510,"en":"Over all the people,"},{"id":"semetey-1-2013:p0180:b004:l025","ordinal":90511,"en":"When she was their maiden sovereign,"},{"id":"semetey-1-2013:p0180:b004:l026","ordinal":90512,"en":"Let me tell of the games she played."},{"id":"semetey-1-2013:p0180:b004:l027","ordinal":90513,"en":"At my sister Kanykei's side"},{"id":"semetey-1-2013:p0180:b004:l028","ordinal":90514,"en":"Were thirty married women, thirty girls."},{"id":"semetey-1-2013:p0180:b004:l030","ordinal":90515,"en":"All the finest entertainers,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0180:b004:l031","ordinal":90516,"en":"My sister would gather them closely."},{"id":"semetey-1-2013:p0180:b004:l032","ordinal":90517,"en":"She poured sugar out like snow,"},{"id":"semetey-1-2013:p0180:b004:l033","ordinal":90518,"en":"Heaped up clarified butter."},{"id":"semetey-1-2013:p0180:b004:l034","ordinal":90519,"en":"Even soaked in water forty years,"},{"id":"semetey-1-2013:p0180:b004:l035","ordinal":90520,"en":"Not the slightest edge would fade,"},{"id":"semetey-1-2013:p0180:b004:l036","ordinal":90521,"en":"Not the slightest edge would curl:"},{"id":"semetey-1-2013:p0180:b004:l037","ordinal":90522,"en":"Carpets patterned in gold,"},{"id":"semetey-1-2013:p0180:b004:l038","ordinal":90523,"en":"Sixty of them, my sister"},{"id":"semetey-1-2013:p0180:b004:l039","ordinal":90524,"en":"Would spread upon the green plain."},{"id":"semetey-1-2013:p0181:b003:l001","ordinal":90525,"en":"Ninety married women, ninety girls,"},{"id":"semetey-1-2013:p0181:b003:l002","ordinal":90526,"en":"Beside my sister,"},{"id":"semetey-1-2013:p0181:b003:l003","ordinal":90527,"en":"Would sway and play in their fullness."},{"id":"semetey-1-2013:p0181:b003:l004","ordinal":90528,"en":"My noble sister Kanykei,"},{"id":"semetey-1-2013:p0181:b003:l005","ordinal":90529,"en":"When she was ruler,"},{"id":"semetey-1-2013:p0181:b003:l006","ordinal":90530,"en":"The people gathered and set an inscription:"},{"id":"semetey-1-2013:p0181:b003:l007","ordinal":90531,"en":"Kanykei's Ken-Kolchuk—"},{"id":"semetey-1-2013:p0181:b003:l008","ordinal":90532,"en":"They named it Ken-Kolchuk."},{"id":"semetey-1-2013:p0181:b003:l009","ordinal":90533,"en":"A shining lake, with a plane tree in its midst;"},{"id":"semetey-1-2013:p0181:b003:l010","ordinal":90534,"en":"Allah Most High granted what she wished."},{"id":"semetey-1-2013:p0181:b003:l011","ordinal":90535,"en":"My poor sister Kanykei"},{"id":"semetey-1-2013:p0181:b003:l012","ordinal":90536,"en":"Would come there for pleasure."},{"id":"semetey-1-2013:p0181:b003:l013","ordinal":90537,"en":"That Ken-Kolchuk of my sister's,"},{"id":"semetey-1-2013:p0181:b003:l014","ordinal":90538,"en":"In the hottest days of summer,"},{"id":"semetey-1-2013:p0181:b003:l015","ordinal":90539,"en":"She would visit for recreation."},{"id":"semetey-1-2013:p0181:b003:l016","ordinal":90540,"en":"When my sister suffered,"},{"id":"semetey-1-2013:p0181:b003:l017","ordinal":90541,"en":"When my brother-in-law Manas died,"},{"id":"semetey-1-2013:p0181:b003:l018","ordinal":90542,"en":"Her little lake dried up."},{"id":"semetey-1-2013:p0181:b003:l019","ordinal":90543,"en":"Her plane tree withered;"},{"id":"semetey-1-2013:p0181:b003:l020","ordinal":90544,"en":"No trail of rising dust remained,"},{"id":"semetey-1-2013:p0181:b003:l021","ordinal":90545,"en":"No animal stirred;"},{"id":"semetey-1-2013:p0181:b003:l022","ordinal":90546,"en":"It became a deserted wilderness."},{"id":"semetey-1-2013:p0181:b003:l023","ordinal":90547,"en":"This year her lake has filled;"},{"id":"semetey-1-2013:p0181:b003:l024","ordinal":90548,"en":"Its grove has grown green."},{"id":"semetey-1-2013:p0181:b003:l025","ordinal":90549,"en":"The mist parts in the sky;"},{"id":"semetey-1-2013:p0181:b003:l026","ordinal":90550,"en":"A blue-gray cloud appears."},{"id":"semetey-1-2013:p0181:b003:l027","ordinal":90551,"en":"One bay, one gray,"},{"id":"semetey-1-2013:p0181:b003:l028","ordinal":90552,"en":"Their girths secured,"},{"id":"semetey-1-2013:p0181:b003:l029","ordinal":90553,"en":"Their saddle pads drawn tight,"},{"id":"semetey-1-2013:p0181:b003:l030","ordinal":90554,"en":"Two winged steeds can be seen."},{"id":"semetey-1-2013:p0181:b003:l031","ordinal":90555,"en":"That written letter given yesterday—"},{"id":"semetey-1-2013:p0181:b003:l032","ordinal":90556,"en":"Could it be my sister's letter?"},{"id":"semetey-1-2013:p0181:b003:l033","ordinal":90557,"en":"Those winged horses standing there—"},{"id":"semetey-1-2013:p0181:b003:l034","ordinal":90558,"en":"Could they be my sister's horses?"},{"id":"semetey-1-2013:p0181:b003:l035","ordinal":90559,"en":"Come, men, let us go!"},{"id":"semetey-1-2013:p0181:b003:l036","ordinal":90560,"en":"If that is my sister there,"},{"id":"semetey-1-2013:p0181:b003:l037","ordinal":90561,"en":"Over this Bukhara"},{"id":"semetey-1-2013:p0181:b003:l038","ordinal":90562,"en":"Let us raise her as khan!"},{"id":"semetey-1-2013:p0181:b003:l039","ordinal":90563,"en":"If an enemy has come upon us,"},{"id":"semetey-1-2013:p0181:b004:l001","ordinal":90564,"en":"If they bring a ruinous claim,"},{"id":"semetey-1-2013:p0181:b004:l002","ordinal":90565,"en":"Let us crush them from above,"},{"id":"semetey-1-2013:p0181:b004:l003","ordinal":90566,"en":"Scatter their four kinds of livestock!"},{"id":"semetey-1-2013:p0181:b004:l004","ordinal":90567,"en":"Let us seize their beasts in sight"},{"id":"semetey-1-2013:p0181:b004:l005","ordinal":90568,"en":"And strip them of their strength."},{"id":"semetey-1-2013:p0181:b004:l006","ordinal":90569,"en":"If a warrior is riding there,"},{"id":"semetey-1-2013:p0181:b004:l007","ordinal":90570,"en":"Let us seize him on the road"},{"id":"semetey-1-2013:p0181:b004:l008","ordinal":90571,"en":"And offer him in sacrifice!"},{"id":"semetey-1-2013:p0181:b004:l009","ordinal":90572,"en":"Whether they are good or bad,"},{"id":"semetey-1-2013:p0181:b004:l010","ordinal":90573,"en":"Come, men, let us go!’"},{"id":"semetey-1-2013:p0181:b004:l011","ordinal":90574,"en":"When Ismayil gave the order,"},{"id":"semetey-1-2013:p0181:b004:l012","ordinal":90575,"en":"His sixty or so strongmen,"},{"id":"semetey-1-2013:p0181:b004:l013","ordinal":90576,"en":"Their swords swaying,"},{"id":"semetey-1-2013:p0181:b004:l014","ordinal":90577,"en":"Their battle-axes flashing,"},{"id":"semetey-1-2013:p0181:b004:l015","ordinal":90578,"en":"Their spears quivering,"},{"id":"semetey-1-2013:p0181:b004:l016","ordinal":90579,"en":"Looked unlike ordinary men,"},{"id":"semetey-1-2013:p0181:b004:l017","ordinal":90580,"en":"Each with a different fearsome bearing."},{"id":"semetey-1-2013:p0181:b004:l018","ordinal":90581,"en":"Every one of them rode"},{"id":"semetey-1-2013:p0181:b004:l019","ordinal":90582,"en":"A Karabair battle steed,"},{"id":"semetey-1-2013:p0181:b004:l020","ordinal":90583,"en":"With sieve-like lungs and copper forelegs."},{"id":"semetey-1-2013:p0181:b004:l021","ordinal":90584,"en":"Every one of them wore"},{"id":"semetey-1-2013:p0181:b004:l022","ordinal":90585,"en":"Armor that no bullet could pierce."},{"id":"semetey-1-2013:p0181:b004:l023","ordinal":90586,"en":"Riding horses unlike ordinary beasts,"},{"id":"semetey-1-2013:p0181:b004:l024","ordinal":90587,"en":"Each man unlike the rest,"},{"id":"semetey-1-2013:p0181:b004:l025","ordinal":90588,"en":"Tying the horsehair tails tightly,"},{"id":"semetey-1-2013:p0181:b004:l026","ordinal":90589,"en":"Flames rushing from their mouths,"},{"id":"semetey-1-2013:p0181:b004:l027","ordinal":90590,"en":"The strongmen who had received the order—"},{"id":"semetey-1-2013:p0181:b004:l028","ordinal":90591,"en":"The fine teeth in their mouths"},{"id":"semetey-1-2013:p0181:b004:l029","ordinal":90592,"en":"Crumbled like millet grains."},{"id":"semetey-1-2013:p0181:b004:l030","ordinal":90593,"en":"Ismayil, son of Temir Khan,"},{"id":"semetey-1-2013:p0181:b004:l031","ordinal":90594,"en":"Shouted in a strange fashion,"},{"id":"semetey-1-2013:p0181:b004:l032","ordinal":90595,"en":"Crying the battle cry, ‘Bukhara!’"},{"id":"semetey-1-2013:p0181:b004:l033","ordinal":90596,"en":"When his sixty or so strongmen"},{"id":"semetey-1-2013:p0181:b004:l034","ordinal":90597,"en":"Raised their shout,"},{"id":"semetey-1-2013:p0181:b004:l035","ordinal":90598,"en":"The two ladies lying asleep"},{"id":"semetey-1-2013:p0181:b004:l036","ordinal":90599,"en":"Woke with a start,"},{"id":"semetey-1-2013:p0181:b004:l037","ordinal":90600,"en":"Turned toward their right,"},{"id":"semetey-1-2013:p0181:b004:l038","ordinal":90601,"en":"Hastily recited their prayers,"},{"id":"semetey-1-2013:p0181:b004:l039","ordinal":90602,"en":"Frightened for their little lives,"},{"id":"semetey-1-2013:p0182:b003:l001","ordinal":90603,"en":"Unable to lie upon the earth,"},{"id":"semetey-1-2013:p0182:b003:l002","ordinal":90604,"en":"Her precious child, born after long yearning,"},{"id":"semetey-1-2013:p0182:b003:l003","ordinal":90605,"en":"Unable to hide him anywhere,"},{"id":"semetey-1-2013:p0182:b003:l004","ordinal":90606,"en":"Unable to die and enter the ground,"},{"id":"semetey-1-2013:p0182:b003:l005","ordinal":90607,"en":"Unable to tell whether they were foes,"},{"id":"semetey-1-2013:p0182:b003:l006","ordinal":90608,"en":"Strength left her arms,"},{"id":"semetey-1-2013:p0182:b003:l007","ordinal":90609,"en":"Her heart lurched in fear,"},{"id":"semetey-1-2013:p0182:b003:l008","ordinal":90610,"en":"The red blood drained from her face."},{"id":"semetey-1-2013:p0182:b003:l009","ordinal":90611,"en":"She wailed and wept, her strength gone;"},{"id":"semetey-1-2013:p0182:b003:l010","ordinal":90612,"en":"From her dear blackcurrant eyes,"},{"id":"semetey-1-2013:p0182:b003:l011","ordinal":90613,"en":"Tears streamed a whip's length;"},{"id":"semetey-1-2013:p0182:b003:l012","ordinal":90614,"en":"From her wretched quail-like eyes,"},{"id":"semetey-1-2013:p0182:b003:l013","ordinal":90615,"en":"Tears fell drop by separate drop."},{"id":"semetey-1-2013:p0182:b003:l014","ordinal":90616,"en":"Kanykei was overcome with sorrow,"},{"id":"semetey-1-2013:p0182:b003:l015","ordinal":90617,"en":"Distraught and grieving,"},{"id":"semetey-1-2013:p0182:b003:l016","ordinal":90618,"en":"To the one she relied upon,"},{"id":"semetey-1-2013:p0182:b003:l017","ordinal":90619,"en":"Her mother Chyiyrdy, she pleaded:"},{"id":"semetey-1-2013:p0182:b003:l018","ordinal":90620,"en":"‘My dear mother,"},{"id":"semetey-1-2013:p0182:b003:l019","ordinal":90621,"en":"A terrible claim has come upon us;"},{"id":"semetey-1-2013:p0182:b003:l020","ordinal":90622,"en":"To torment our suffering souls,"},{"id":"semetey-1-2013:p0182:b003:l021","ordinal":90623,"en":"An enemy burning against us has come."},{"id":"semetey-1-2013:p0182:b003:l022","ordinal":90624,"en":"They will crush us from above,"}]
