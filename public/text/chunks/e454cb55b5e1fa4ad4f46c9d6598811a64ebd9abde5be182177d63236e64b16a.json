[{"id":"manas-2010:p1366:b001:l042","ordinal":59137,"en":"Making his bull prance,"},{"id":"manas-2010:p1367:b001:l001","ordinal":59138,"en":"Felling everyone he encountered,"},{"id":"manas-2010:p1367:b001:l002","ordinal":59139,"en":"Making them mottled red with blood,"},{"id":"manas-2010:p1367:b001:l003","ordinal":59140,"en":"He went on slaughtering and smashing."},{"id":"manas-2010:p1367:b001:l004","ordinal":59141,"en":"Blood sprang forth wherever he went;"},{"id":"manas-2010:p1367:b001:l005","ordinal":59142,"en":"Lives departed at his very voice."},{"id":"manas-2010:p1367:b001:l006","ordinal":59143,"en":"Mule-riding Koyonboz,"},{"id":"manas-2010:p1367:b001:l007","ordinal":59144,"en":"The endless multitude of Chinese,"},{"id":"manas-2010:p1367:b001:l008","ordinal":59145,"en":"All had joined him as companions."},{"id":"manas-2010:p1367:b001:l009","ordinal":59146,"en":"Madykan of the Chinese,"},{"id":"manas-2010:p1367:b001:l010","ordinal":59147,"en":"Laying low everyone he encountered,"},{"id":"manas-2010:p1367:b001:l011","ordinal":59148,"en":"Without looking back, surging forward,"},{"id":"manas-2010:p1367:b001:l012","ordinal":59149,"en":"Eleman's youngest son,"},{"id":"manas-2010:p1367:b001:l013","ordinal":59150,"en":"Hero Töshtük, he reached."},{"id":"manas-2010:p1367:b001:l014","ordinal":59151,"en":"From the back of Chalkuyruk"},{"id":"manas-2010:p1367:b001:l015","ordinal":59152,"en":"He hurled him down as he passed."},{"id":"manas-2010:p1367:b001:l016","ordinal":59153,"en":"Mule-riding Koyonboz"},{"id":"manas-2010:p1367:b001:l017","ordinal":59154,"en":"Charged in, that daughter-seller,"},{"id":"manas-2010:p1367:b001:l018","ordinal":59155,"en":"To cut off Töshtük's head."},{"id":"manas-2010:p1367:b001:l019","ordinal":59156,"en":"Before Koyonboz could reach him,"},{"id":"manas-2010:p1367:b001:l020","ordinal":59157,"en":"Your leopard, hero Manas,"},{"id":"manas-2010:p1367:b001:l021","ordinal":59158,"en":"From the back of his mule,"},{"id":"manas-2010:p1367:b001:l022","ordinal":59159,"en":"That champion Koyonboz"},{"id":"manas-2010:p1367:b001:l023","ordinal":59160,"en":"Thrust down as he passed."},{"id":"manas-2010:p1367:b001:l024","ordinal":59161,"en":"Then your mighty Bakay,"},{"id":"manas-2010:p1367:b001:l025","ordinal":59162,"en":"Of that champion Koyonboz,"},{"id":"manas-2010:p1367:b001:l026","ordinal":59163,"en":"(Before other Chinese could reach him)"},{"id":"manas-2010:p1367:b001:l027","ordinal":59164,"en":"Cut off the head as he passed."},{"id":"manas-2010:p1367:b001:l028","ordinal":59165,"en":"The mighty khan of the Chinese"},{"id":"manas-2010:p1367:b001:l029","ordinal":59166,"en":"At the hands of Manas and Bakay"},{"id":"manas-2010:p1367:b001:l030","ordinal":59167,"en":"Met his death."},{"id":"manas-2010:p1367:b001:l031","ordinal":59168,"en":"To Töshtük, left on foot,"},{"id":"manas-2010:p1367:b001:l032","ordinal":59169,"en":"Akbaltay's keen warrior,"},{"id":"manas-2010:p1367:b001:l033","ordinal":59170,"en":"Lion Chubak, arrived."},{"id":"manas-2010:p1367:b001:l034","ordinal":59171,"en":"Reaching him, he set him on a horse"},{"id":"manas-2010:p1367:b001:l035","ordinal":59172,"en":"And led him safely away."},{"id":"manas-2010:p1367:b001:l036","ordinal":59173,"en":"The whole Chinese army,"},{"id":"manas-2010:p1367:b001:l037","ordinal":59174,"en":"Unable to endure his slaughter,"},{"id":"manas-2010:p1367:b001:l038","ordinal":59175,"en":"Unable to stand his battle-cry,"},{"id":"manas-2010:p1367:b001:l039","ordinal":59176,"en":"Fled together from Manas."},{"id":"manas-2010:p1367:b001:l040","ordinal":59177,"en":"Even then, without fleeing,"},{"id":"manas-2010:p1367:b001:l041","ordinal":59178,"en":"Though the Chinese had fled,"},{"id":"manas-2010:p1367:b001:l042","ordinal":59179,"en":"Without panicking at being alone,"},{"id":"manas-2010:p1368:b001:l001","ordinal":59180,"en":"Madykan remained alone."},{"id":"manas-2010:p1368:b001:l002","ordinal":59181,"en":"That Chinese warrior, left alone,"},{"id":"manas-2010:p1368:b001:l003","ordinal":59182,"en":"With warrior Manas at their head,"},{"id":"manas-2010:p1368:b001:l004","ordinal":59183,"en":"They took within their ring."},{"id":"manas-2010:p1368:b001:l005","ordinal":59184,"en":"All forty companions, to the last,"},{"id":"manas-2010:p1368:b001:l006","ordinal":59185,"en":"Pounded him with blow upon blow."},{"id":"manas-2010:p1368:b001:l007","ordinal":59186,"en":"Almambet arrived, clenching his teeth;"},{"id":"manas-2010:p1368:b001:l008","ordinal":59187,"en":"He too came and thrust once."},{"id":"manas-2010:p1368:b001:l009","ordinal":59188,"en":"Azhybay and Syrgak,"},{"id":"manas-2010:p1368:b001:l010","ordinal":59189,"en":"And Chubak, son of Akbaltay,"},{"id":"manas-2010:p1368:b001:l011","ordinal":59190,"en":"The three thrust side by side."},{"id":"manas-2010:p1368:b001:l012","ordinal":59191,"en":"The famed warrior, hero Bakay,"},{"id":"manas-2010:p1368:b001:l013","ordinal":59192,"en":"He too came and thrust."},{"id":"manas-2010:p1368:b001:l014","ordinal":59193,"en":"Fighting Madykan,"},{"id":"manas-2010:p1368:b001:l015","ordinal":59194,"en":"Shoving this way and that,"},{"id":"manas-2010:p1368:b001:l016","ordinal":59195,"en":"With warrior Manas at their head,"},{"id":"manas-2010:p1368:b001:l017","ordinal":59196,"en":"Hero Manas's forty companions,"},{"id":"manas-2010:p1368:b001:l018","ordinal":59197,"en":"While they all were fighting,"},{"id":"manas-2010:p1368:b001:l019","ordinal":59198,"en":"The many remaining troops,"},{"id":"manas-2010:p1368:b001:l020","ordinal":59199,"en":"After the fleeing Chinese,"},{"id":"manas-2010:p1368:b001:l021","ordinal":59200,"en":"Making the Chinese reel back,"},{"id":"manas-2010:p1368:b001:l022","ordinal":59201,"en":"All went in pursuit."},{"id":"manas-2010:p1368:b001:l023","ordinal":59202,"en":"Behind the pursuing Buruts,"},{"id":"manas-2010:p1368:b001:l024","ordinal":59203,"en":"That same leopard Syrgak"},{"id":"manas-2010:p1368:b001:l025","ordinal":59204,"en":"Also cried “On!” and rode away."},{"id":"manas-2010:p1368:b001:l026","ordinal":59205,"en":"Young Syrgak, surpassing in valor,"},{"id":"manas-2010:p1368:b001:l027","ordinal":59206,"en":"From that great encirclement,"},{"id":"manas-2010:p1368:b001:l028","ordinal":59207,"en":"Hero Syrgak rode ahead."},{"id":"manas-2010:p1368:b001:l029","ordinal":59208,"en":"The Chinese who rallied their courage,"},{"id":"manas-2010:p1368:b001:l030","ordinal":59209,"en":"Before they could sweep upon the Buruts,"},{"id":"manas-2010:p1368:b001:l031","ordinal":59210,"en":"Not letting them reach the great armies,"},{"id":"manas-2010:p1368:b001:l032","ordinal":59211,"en":"Slaughtering and destroying the Chinese,"},{"id":"manas-2010:p1368:b001:l033","ordinal":59212,"en":"Hero Syrgak held them back."},{"id":"manas-2010:p1368:b001:l034","ordinal":59213,"en":"Serving as a shield for the Buruts,"},{"id":"manas-2010:p1368:b001:l035","ordinal":59214,"en":"Leopard Syrgak rode on."},{"id":"manas-2010:p1368:b001:l036","ordinal":59215,"en":"The forty companions gathered courage;"},{"id":"manas-2010:p1368:b001:l037","ordinal":59216,"en":"With Manas, lord of battles, at their head,"},{"id":"manas-2010:p1368:b001:l038","ordinal":59217,"en":"In earnest against Madykan,"},{"id":"manas-2010:p1368:b001:l039","ordinal":59218,"en":"They all entered together."},{"id":"manas-2010:p1368:b001:l040","ordinal":59219,"en":"Almambet and hero Chubak,"},{"id":"manas-2010:p1368:b001:l041","ordinal":59220,"en":"Lion-born and fearless,"},{"id":"manas-2010:p1368:b001:l042","ordinal":59221,"en":"Joined together, stirrup to stirrup,"},{"id":"manas-2010:p1369:b001:l001","ordinal":59222,"en":"Straining and clenching their teeth,"},{"id":"manas-2010:p1369:b001:l002","ordinal":59223,"en":"Fire issuing from their eyes,"},{"id":"manas-2010:p1369:b001:l003","ordinal":59224,"en":"Hair bristling upon their faces,"},{"id":"manas-2010:p1369:b001:l004","ordinal":59225,"en":"They charged at Madykan."},{"id":"manas-2010:p1369:b001:l005","ordinal":59226,"en":"Thrusting with their spears,"},{"id":"manas-2010:p1369:b001:l006","ordinal":59227,"en":"Fighting with their battle-axes,"},{"id":"manas-2010:p1369:b001:l007","ordinal":59228,"en":"They could not overcome him."},{"id":"manas-2010:p1369:b001:l008","ordinal":59229,"en":"Then your champion Manas"},{"id":"manas-2010:p1369:b001:l009","ordinal":59230,"en":"Flew into a rage."},{"id":"manas-2010:p1369:b001:l010","ordinal":59231,"en":"“From the very beginning I"},{"id":"manas-2010:p1369:b001:l011","ordinal":59232,"en":"Have been a lion who slew his enemies."},{"id":"manas-2010:p1369:b001:l012","ordinal":59233,"en":"I cannot master a single Chinese—"},{"id":"manas-2010:p1369:b001:l013","ordinal":59234,"en":"Why have I become so weak?"},{"id":"manas-2010:p1369:b001:l014","ordinal":59235,"en":"I became the renowned warrior Manas,"},{"id":"manas-2010:p1369:b001:l015","ordinal":59236,"en":"Who made the palm-sized Burut people"},{"id":"manas-2010:p1369:b001:l016","ordinal":59237,"en":"An equal of the whole wide world."},{"id":"manas-2010:p1369:b001:l017","ordinal":59238,"en":"Many and many a lion,"},{"id":"manas-2010:p1369:b001:l018","ordinal":59239,"en":"Whenever he fought me,"},{"id":"manas-2010:p1369:b001:l019","ordinal":59240,"en":"I shattered in the end"},{"id":"manas-2010:p1369:b001:l020","ordinal":59241,"en":"And leveled with the dark earth."},{"id":"manas-2010:p1369:b001:l021","ordinal":59242,"en":"Unable to overcome one man,"},{"id":"manas-2010:p1369:b001:l022","ordinal":59243,"en":"I have become a dug, dark grave!”"},{"id":"manas-2010:p1369:b001:l023","ordinal":59244,"en":"Thus spoke the warrior Manas,"},{"id":"manas-2010:p1369:b001:l024","ordinal":59245,"en":"Biting his lip till it bled,"},{"id":"manas-2010:p1369:b001:l025","ordinal":59246,"en":"His eyes like glowing red embers,"},{"id":"manas-2010:p1369:b001:l026","ordinal":59247,"en":"Wind pouring from his mouth,"},{"id":"manas-2010:p1369:b001:l027","ordinal":59248,"en":"Flame issuing from his eyes."},{"id":"manas-2010:p1369:b001:l028","ordinal":59249,"en":"Your champion raged;"},{"id":"manas-2010:p1369:b001:l029","ordinal":59250,"en":"Your leopard, champion Manas,"},{"id":"manas-2010:p1369:b001:l030","ordinal":59251,"en":"Took his lacquered spear in hand."},{"id":"manas-2010:p1369:b001:l031","ordinal":59252,"en":"Speeding like a falling stone,"},{"id":"manas-2010:p1369:b001:l032","ordinal":59253,"en":"Thundering like a fired shot,"},{"id":"manas-2010:p1369:b001:l033","ordinal":59254,"en":"The blood draining from his flesh,"},{"id":"manas-2010:p1369:b001:l034","ordinal":59255,"en":"He charged at Mady."},{"id":"manas-2010:p1369:b001:l035","ordinal":59256,"en":"Who would never shrink from fire,"},{"id":"manas-2010:p1369:b001:l036","ordinal":59257,"en":"Nor flee in fear before a foe,"},{"id":"manas-2010:p1369:b001:l037","ordinal":59258,"en":"The Chinese giant Madykan,"},{"id":"manas-2010:p1369:b001:l038","ordinal":59259,"en":"Thundering like the sky,"},{"id":"manas-2010:p1369:b001:l039","ordinal":59260,"en":"Making all who heard him tremble,"},{"id":"manas-2010:p1369:b001:l040","ordinal":59261,"en":"His whole body bristling,"},{"id":"manas-2010:p1369:b001:l041","ordinal":59262,"en":"Charged at Manas."},{"id":"manas-2010:p1369:b001:l042","ordinal":59263,"en":"Seeing him charge,"},{"id":"manas-2010:p1370:b001:l001","ordinal":59264,"en":"Your precious warrior Bakai"},{"id":"manas-2010:p1370:b001:l002","ordinal":59265,"en":"Reached him from the flank."},{"id":"manas-2010:p1370:b001:l003","ordinal":59266,"en":"That champion Madykan—"},{"id":"manas-2010:p1370:b001:l004","ordinal":59267,"en":"He reached him before Manas"},{"id":"manas-2010:p1370:b001:l005","ordinal":59268,"en":"And thrust at him as he passed."},{"id":"manas-2010:p1370:b001:l006","ordinal":59269,"en":"Behind Khan Bakai,"},{"id":"manas-2010:p1370:b001:l007","ordinal":59270,"en":"Azizkhan’s Almambet"},{"id":"manas-2010:p1370:b001:l008","ordinal":59271,"en":"Also speared him as he passed."},{"id":"manas-2010:p1370:b001:l009","ordinal":59272,"en":"Almambet and Bakai, the two warriors—"},{"id":"manas-2010:p1370:b001:l010","ordinal":59273,"en":"When both had speared him in passing,"},{"id":"manas-2010:p1370:b001:l011","ordinal":59274,"en":"His hand slipped from the reins."},{"id":"manas-2010:p1370:b001:l012","ordinal":59275,"en":"Chubak and the warrior Shuutu,"},{"id":"manas-2010:p1370:b001:l013","ordinal":59276,"en":"The two reached him side by side"},{"id":"manas-2010:p1370:b001:l014","ordinal":59277,"en":"And thrust together as they passed."},{"id":"manas-2010:p1370:b001:l015","ordinal":59278,"en":"When those two had struck and passed,"},{"id":"manas-2010:p1370:b001:l016","ordinal":59279,"en":"Madykan, giant of the Chinese,"},{"id":"manas-2010:p1370:b001:l017","ordinal":59280,"en":"Lost his footing in the stirrups."},{"id":"manas-2010:p1370:b001:l018","ordinal":59281,"en":"Your bloodthirsty leopard Manas,"},{"id":"manas-2010:p1370:b001:l019","ordinal":59282,"en":"Racing upon Akkula,"},{"id":"manas-2010:p1370:b001:l020","ordinal":59283,"en":"Reached Madykan"},{"id":"manas-2010:p1370:b001:l021","ordinal":59284,"en":"From the gray bull’s back"},{"id":"manas-2010:p1370:b001:l022","ordinal":59285,"en":"He struck him down as he passed."},{"id":"manas-2010:p1370:b001:l023","ordinal":59286,"en":"The warrior Chubak, standing ready,"},{"id":"manas-2010:p1370:b001:l024","ordinal":59287,"en":"The bull beneath him—"},{"id":"manas-2010:p1370:b001:l025","ordinal":59288,"en":"He cut off its head as he passed."},{"id":"manas-2010:p1370:b001:l026","ordinal":59289,"en":"When Madykan fell from his horse,"},{"id":"manas-2010:p1370:b001:l027","ordinal":59290,"en":"Without looking about him,"},{"id":"manas-2010:p1370:b001:l028","ordinal":59291,"en":"Alooke’s Kongurbay,"},{"id":"manas-2010:p1370:b001:l029","ordinal":59292,"en":"Sparing not his fragile life, said:"},{"id":"manas-2010:p1370:b001:l030","ordinal":59293,"en":"“If Beijing’s khan dies,"},{"id":"manas-2010:p1370:b001:l031","ordinal":59294,"en":"What will become of me?"},{"id":"manas-2010:p1370:b001:l032","ordinal":59295,"en":"Better that I spare no effort"},{"id":"manas-2010:p1370:b001:l033","ordinal":59296,"en":"And reach Madykan,"},{"id":"manas-2010:p1370:b001:l034","ordinal":59297,"en":"From among the massed Burut"},{"id":"manas-2010:p1370:b001:l035","ordinal":59298,"en":"Rescuing him and taking him away.”"},{"id":"manas-2010:p1370:b001:l036","ordinal":59299,"en":"Thus spoke Kongurbay,"},{"id":"manas-2010:p1370:b001:l037","ordinal":59300,"en":"Crying out with all his life."},{"id":"manas-2010:p1370:b001:l038","ordinal":59301,"en":"This was the Chinese battle cry:"},{"id":"manas-2010:p1370:b001:l039","ordinal":59302,"en":"“Come, come, come!” he shouted,"},{"id":"manas-2010:p1370:b001:l040","ordinal":59303,"en":"Calling the battle cry, “Come!”"},{"id":"manas-2010:p1370:b001:l041","ordinal":59304,"en":"As he was about to reach Madykan,"},{"id":"manas-2010:p1370:b001:l042","ordinal":59305,"en":"As he was about to rescue him,"},{"id":"manas-2010:p1371:b001:l001","ordinal":59306,"en":"The warrior Syrgak blocked him again."},{"id":"manas-2010:p1371:b001:l002","ordinal":59307,"en":"At that moment the warrior Bakai"},{"id":"manas-2010:p1371:b001:l003","ordinal":59308,"en":"Took his ravenous steel in hand,"},{"id":"manas-2010:p1371:b001:l004","ordinal":59309,"en":"Reached him first with a shout,"},{"id":"manas-2010:p1371:b001:l005","ordinal":59310,"en":"And as soon as he reached Mady,"},{"id":"manas-2010:p1371:b001:l006","ordinal":59311,"en":"Cut off his head as he passed."},{"id":"manas-2010:p1371:b001:l007","ordinal":59312,"en":"When the warrior Madykan died,"},{"id":"manas-2010:p1371:b001:l008","ordinal":59313,"en":"A thousand times greater than before"},{"id":"manas-2010:p1371:b001:l009","ordinal":59314,"en":"Was the force that came."},{"id":"manas-2010:p1371:b001:l010","ordinal":59315,"en":"Shouting their battle cries,"},{"id":"manas-2010:p1371:b001:l011","ordinal":59316,"en":"All the Chinese multitude"},{"id":"manas-2010:p1371:b001:l012","ordinal":59317,"en":"Had come together."},{"id":"manas-2010:p1371:b001:l013","ordinal":59318,"en":"Skilled on horseback, swift on foot,"},{"id":"manas-2010:p1371:b001:l014","ordinal":59319,"en":"Who came forth when the Chinese faltered,"},{"id":"manas-2010:p1371:b001:l015","ordinal":59320,"en":"The great marksman of the treasury,"},{"id":"manas-2010:p1371:b001:l016","ordinal":59321,"en":"Their sorcerer had arrived."},{"id":"manas-2010:p1371:b001:l017","ordinal":59322,"en":"In the Chinese emperor’s realm,"},{"id":"manas-2010:p1371:b001:l018","ordinal":59323,"en":"He was the one they relied upon;"},{"id":"manas-2010:p1371:b001:l019","ordinal":59324,"en":"When they fought an enemy,"},{"id":"manas-2010:p1371:b001:l020","ordinal":59325,"en":"He was the one who gave them strength."},{"id":"manas-2010:p1371:b001:l021","ordinal":59326,"en":"His marksmanship was most formidable:"},{"id":"manas-2010:p1371:b001:l022","ordinal":59327,"en":"In a dark and moonless night,"},{"id":"manas-2010:p1371:b001:l023","ordinal":59328,"en":"The tip of an outstretched spear"},{"id":"manas-2010:p1371:b001:l024","ordinal":59329,"en":"He could shoot without missing."},{"id":"manas-2010:p1371:b001:l025","ordinal":59330,"en":"They called him the Great Sorcerer Marksman."},{"id":"manas-2010:p1371:b001:l026","ordinal":59331,"en":"When the Chinese of forty khans"},{"id":"manas-2010:p1371:b001:l027","ordinal":59332,"en":"Had found themselves in straits,"},{"id":"manas-2010:p1371:b001:l028","ordinal":59333,"en":"When Karykan had given orders,"},{"id":"manas-2010:p1371:b001:l029","ordinal":59334,"en":"When the children had been gathered,"},{"id":"manas-2010:p1371:b001:l030","ordinal":59335,"en":"With Almambet at their head,"},{"id":"manas-2010:p1371:b001:l031","ordinal":59336,"en":"When six thousand children went,"},{"id":"manas-2010:p1371:b001:l032","ordinal":59337,"en":"When the six thousand perished"},{"id":"manas-2010:p1371:b001:l033","ordinal":59338,"en":"And six children remained,"},{"id":"manas-2010:p1371:b001:l034","ordinal":59339,"en":"He was one of those six."},{"id":"manas-2010:p1371:b001:l035","ordinal":59340,"en":"Of Almambet’s skill,"},{"id":"manas-2010:p1371:b001:l036","ordinal":59341,"en":"He fell short by three months:"},{"id":"manas-2010:p1371:b001:l037","ordinal":59342,"en":"That was his deficiency."},{"id":"manas-2010:p1371:b001:l038","ordinal":59343,"en":"Had he studied three months to complete it,"},{"id":"manas-2010:p1371:b001:l039","ordinal":59344,"en":"The knowledge that he possessed"},{"id":"manas-2010:p1371:b001:l040","ordinal":59345,"en":"Would have equaled Almambet’s."},{"id":"manas-2010:p1371:b001:l041","ordinal":59346,"en":"That the great marksman had arrived,"},{"id":"manas-2010:p1371:b001:l042","ordinal":59347,"en":"The warrior Almambet now saw."},{"id":"manas-2010:p1372:b001:l001","ordinal":59348,"en":"Seeing him, Almambet,"},{"id":"manas-2010:p1372:b001:l002","ordinal":59349,"en":"Since he knew the marksman's secrets,"},{"id":"manas-2010:p1372:b001:l003","ordinal":59350,"en":"Began conjuring the weather."},{"id":"manas-2010:p1372:b001:l004","ordinal":59351,"en":"Not letting his conjured weather rain,"},{"id":"manas-2010:p1372:b001:l005","ordinal":59352,"en":"God had struck that marksman;"},{"id":"manas-2010:p1372:b001:l006","ordinal":59353,"en":"On a plain no little bustard flew over,"},{"id":"manas-2010:p1372:b001:l007","ordinal":59354,"en":"He fought a mighty battle."},{"id":"manas-2010:p1372:b001:l008","ordinal":59355,"en":"As he drew his bow to shoot,"},{"id":"manas-2010:p1372:b001:l009","ordinal":59356,"en":"Stately Chubak,"},{"id":"manas-2010:p1372:b001:l010","ordinal":59357,"en":"When the Great Marksman came to shoot him,"},{"id":"manas-2010:p1372:b001:l011","ordinal":59358,"en":"Bringing his white gun to his face,"},{"id":"manas-2010:p1372:b001:l012","ordinal":59359,"en":"Just as he was about to pull the trigger,"},{"id":"manas-2010:p1372:b001:l013","ordinal":59360,"en":"The brim of a black hat,"},{"id":"manas-2010:p1372:b001:l014","ordinal":59361,"en":"(How did he reach there then?),"},{"id":"manas-2010:p1372:b001:l015","ordinal":59362,"en":"Khan Manas's Syrgak"},{"id":"manas-2010:p1372:b001:l016","ordinal":59363,"en":"Arrived like a fired bullet."},{"id":"manas-2010:p1372:b001:l017","ordinal":59364,"en":"A warrior like the Great Marksman,"},{"id":"manas-2010:p1372:b001:l018","ordinal":59365,"en":"From atop the courser Kerchunak,"},{"id":"manas-2010:p1372:b001:l019","ordinal":59366,"en":"He thrust down as he passed."},{"id":"manas-2010:p1372:b001:l020","ordinal":59367,"en":"Before a thousand marksmen behind him"},{"id":"manas-2010:p1372:b001:l021","ordinal":59368,"en":"Could break him free,"},{"id":"manas-2010:p1372:b001:l022","ordinal":59369,"en":"Almambet, who was watching,"},{"id":"manas-2010:p1372:b001:l023","ordinal":59370,"en":"Swung Zhoybolot once,"},{"id":"manas-2010:p1372:b001:l024","ordinal":59371,"en":"Destroyed him, cut off his head."},{"id":"manas-2010:p1372:b001:l025","ordinal":59372,"en":"Warrior Almambet, the leopard,"},{"id":"manas-2010:p1372:b001:l026","ordinal":59373,"en":"The face of the earth became a flood;"},{"id":"manas-2010:p1372:b001:l027","ordinal":59374,"en":"Dark blood flowed, becoming a lake."},{"id":"manas-2010:p1372:b001:l028","ordinal":59375,"en":"You could not tell which was which;"},{"id":"manas-2010:p1372:b001:l029","ordinal":59376,"en":"A fierce battle raged."},{"id":"manas-2010:p1372:b001:l030","ordinal":59377,"en":"Earth flew, dust covered all,"},{"id":"manas-2010:p1372:b001:l031","ordinal":59378,"en":"It stopped up people's eyes."},{"id":"manas-2010:p1372:b001:l032","ordinal":59379,"en":"If one died, a thousand swarmed in;"},{"id":"manas-2010:p1372:b001:l033","ordinal":59380,"en":"The Chinese grew stronger again."},{"id":"manas-2010:p1372:b001:l034","ordinal":59381,"en":"The Kalmyk, the Great Lama,"},{"id":"manas-2010:p1372:b001:l035","ordinal":59382,"en":"The Chinese red standard,"},{"id":"manas-2010:p1372:b001:l036","ordinal":59383,"en":"Held it without letting it tilt."},{"id":"manas-2010:p1372:b001:l037","ordinal":59384,"en":"When Azhybay had fallen,"},{"id":"manas-2010:p1372:b001:l038","ordinal":59385,"en":"The brown horse beneath him,"},{"id":"manas-2010:p1372:b001:l039","ordinal":59386,"en":"When it fell into Chinese hands,"},{"id":"manas-2010:p1372:b001:l040","ordinal":59387,"en":"The lama took it as spoils"},{"id":"manas-2010:p1372:b001:l041","ordinal":59388,"en":"And mounted it."},{"id":"manas-2010:p1372:b001:l042","ordinal":59389,"en":"When he saw the lama,"},{"id":"manas-2010:p1373:b001:l001","ordinal":59390,"en":"Azizkan's Almambet,"},{"id":"manas-2010:p1373:b001:l002","ordinal":59391,"en":"Of the red-tasselled Chinese,"},{"id":"manas-2010:p1373:b001:l003","ordinal":59392,"en":"Dressed like one of their champions,"}]
