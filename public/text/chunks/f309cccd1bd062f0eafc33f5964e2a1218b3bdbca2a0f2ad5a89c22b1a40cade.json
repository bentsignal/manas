[{"id":"semetey-2-2013:p1359:b004:l038","ordinal":291329,"en":"Meeting face to face as allies,"},{"id":"semetey-2-2013:p1359:b004:l039","ordinal":291330,"en":"Eating meat from a single cauldron,"},{"id":"semetey-2-2013:p1360:b003:l001","ordinal":291331,"en":"Settling freely along the place of honor,"},{"id":"semetey-2-2013:p1360:b003:l002","ordinal":291332,"en":"Living together as husband and wife,"},{"id":"semetey-2-2013:p1360:b003:l003","ordinal":291333,"en":"She was Chürök whose every manner"},{"id":"semetey-2-2013:p1360:b003:l004","ordinal":291334,"en":"Surpassed all others in the world;"},{"id":"semetey-2-2013:p1360:b003:l005","ordinal":291335,"en":"Chürök whom a man would love"},{"id":"semetey-2-2013:p1360:b003:l006","ordinal":291336,"en":"And draw against his breast;"},{"id":"semetey-2-2013:p1360:b003:l007","ordinal":291337,"en":"Chürök who would enter"},{"id":"semetey-2-2013:p1360:b003:l008","ordinal":291338,"en":"Countless delightful games;"},{"id":"semetey-2-2013:p1360:b003:l009","ordinal":291339,"en":"Chürök who could cure"},{"id":"semetey-2-2013:p1360:b003:l010","ordinal":291340,"en":"Ancient grief and great affliction;"},{"id":"semetey-2-2013:p1360:b003:l011","ordinal":291341,"en":"Chürök who should not go as spoil"},{"id":"semetey-2-2013:p1360:b003:l012","ordinal":291342,"en":"Into a broad foreign palace;"},{"id":"semetey-2-2013:p1360:b003:l013","ordinal":291343,"en":"Chürök who should not be placed"},{"id":"semetey-2-2013:p1360:b003:l014","ordinal":291344,"en":"At anyone’s unrestricted disposal;"},{"id":"semetey-2-2013:p1360:b003:l015","ordinal":291345,"en":"Meeting face to face through one gate,"},{"id":"semetey-2-2013:p1360:b003:l016","ordinal":291346,"en":"Eating meat from one platter,"},{"id":"semetey-2-2013:p1360:b003:l017","ordinal":291347,"en":"She was Chürök who could enter"},{"id":"semetey-2-2013:p1360:b003:l018","ordinal":291348,"en":"The deepest pleasures and games;"},{"id":"semetey-2-2013:p1360:b003:l019","ordinal":291349,"en":"Would Chürök not lie with"},{"id":"semetey-2-2013:p1360:b003:l020","ordinal":291350,"en":"The poor man who swayed toward her,"},{"id":"semetey-2-2013:p1360:b003:l021","ordinal":291351,"en":"And satisfy his first longing?"},{"id":"semetey-2-2013:p1360:b003:l022","ordinal":291352,"en":"To that sidelong-glancing beauty,"},{"id":"semetey-2-2013:p1360:b003:l023","ordinal":291353,"en":"Ah, to that quivering creature,"},{"id":"semetey-2-2013:p1360:b003:l024","ordinal":291354,"en":"Would Chürök not place into his hands"},{"id":"semetey-2-2013:p1360:b003:l025","ordinal":291355,"en":"Everything he asked of her?"},{"id":"semetey-2-2013:p1360:b003:l026","ordinal":291356,"en":"Would Chürök refuse to consent"},{"id":"semetey-2-2013:p1360:b003:l027","ordinal":291357,"en":"And submit to what he said?"},{"id":"semetey-2-2013:p1360:b003:l028","ordinal":291358,"en":"If I do not spend my strength"},{"id":"semetey-2-2013:p1360:b003:l029","ordinal":291359,"en":"For matchless Chürök,"},{"id":"semetey-2-2013:p1360:b003:l030","ordinal":291360,"en":"If I do not scatter my gathered herds,"},{"id":"semetey-2-2013:p1360:b003:l031","ordinal":291361,"en":"If I do not spend beyond livestock,"},{"id":"semetey-2-2013:p1360:b003:l032","ordinal":291362,"en":"Sending men through many cities,"},{"id":"semetey-2-2013:p1360:b003:l033","ordinal":291363,"en":"If I do not open the treasury,"},{"id":"semetey-2-2013:p1360:b003:l034","ordinal":291364,"en":"And lavish upon Chürök"},{"id":"semetey-2-2013:p1360:b003:l035","ordinal":291365,"en":"All the wealth I have found and amassed,"},{"id":"semetey-2-2013:p1360:b003:l036","ordinal":291366,"en":"Scattering countless riches!"},{"id":"semetey-2-2013:p1360:b003:l037","ordinal":291367,"en":"For beautiful Chürök to enter,"},{"id":"semetey-2-2013:p1360:b003:l038","ordinal":291368,"en":"If I do not commission a palace,"},{"id":"semetey-2-2013:p1360:b003:l039","ordinal":291369,"en":"Commissioned with a golden roof-ring and copper ropes;"},{"id":"semetey-2-2013:p1360:b004:l001","ordinal":291370,"en":"If, upon that roof-ring,"},{"id":"semetey-2-2013:p1360:b004:l002","ordinal":291371,"en":"I do not have gold richly plated,"},{"id":"semetey-2-2013:p1360:b004:l003","ordinal":291372,"en":"Spending freely from"},{"id":"semetey-2-2013:p1360:b004:l004","ordinal":291373,"en":"The Jediger treasury;"},{"id":"semetey-2-2013:p1360:b004:l005","ordinal":291374,"en":"If I do not gladden the people with celebration,"},{"id":"semetey-2-2013:p1360:b004:l006","ordinal":291375,"en":"Making all the world proclaim,"},{"id":"semetey-2-2013:p1360:b004:l007","ordinal":291376,"en":"“Kyyaz has won Chürök,”"},{"id":"semetey-2-2013:p1360:b004:l008","ordinal":291377,"en":"And gather every living soul,"},{"id":"semetey-2-2013:p1360:b004:l009","ordinal":291378,"en":"Holding a feast for multitudes;"},{"id":"semetey-2-2013:p1360:b004:l010","ordinal":291379,"en":"If I do not make a wonder for the ages,"},{"id":"semetey-2-2013:p1360:b004:l011","ordinal":291380,"en":"As though taking a maiden in marriage;"},{"id":"semetey-2-2013:p1360:b004:l012","ordinal":291381,"en":"If I do not attend her like a chief wife,"},{"id":"semetey-2-2013:p1360:b004:l013","ordinal":291382,"en":"Begging her no fewer than forty times,"},{"id":"semetey-2-2013:p1360:b004:l014","ordinal":291383,"en":"Preparing to serve her"},{"id":"semetey-2-2013:p1360:b004:l015","ordinal":291384,"en":"And standing before her!"},{"id":"semetey-2-2013:p1360:b004:l016","ordinal":291385,"en":"Moonlike Aichürök,"},{"id":"semetey-2-2013:p1360:b004:l017","ordinal":291386,"en":"If I do not obey your words,"},{"id":"semetey-2-2013:p1360:b004:l018","ordinal":291387,"en":"Go wherever you direct me,"},{"id":"semetey-2-2013:p1360:b004:l019","ordinal":291388,"en":"Consent to what you say,"},{"id":"semetey-2-2013:p1360:b004:l020","ordinal":291389,"en":"And carry out your commands,"},{"id":"semetey-2-2013:p1360:b004:l021","ordinal":291390,"en":"May the hairy-breasted Earth strike me,"},{"id":"semetey-2-2013:p1360:b004:l022","ordinal":291391,"en":"May the overarching Sky strike me,"},{"id":"semetey-2-2013:p1360:b004:l023","ordinal":291392,"en":"May holy Ak strike me in disaster,"},{"id":"semetey-2-2013:p1360:b004:l024","ordinal":291393,"en":"May the spark of the white matchlock strike me,"},{"id":"semetey-2-2013:p1360:b004:l025","ordinal":291394,"en":"May the bullet of the white-barreled gun strike me!”"},{"id":"semetey-2-2013:p1360:b004:l026","ordinal":291395,"en":"Brave Kyyaz of the Jediger"},{"id":"semetey-2-2013:p1360:b004:l027","ordinal":291396,"en":"Stood there in distress."},{"id":"semetey-2-2013:p1360:b004:l028","ordinal":291397,"en":"Without approaching her, brave Kyyaz"},{"id":"semetey-2-2013:p1360:b004:l029","ordinal":291398,"en":"Stood pleading with Chürök."},{"id":"semetey-2-2013:p1360:b004:l030","ordinal":291399,"en":"Your mother, moonlike lady,"},{"id":"semetey-2-2013:p1360:b004:l031","ordinal":291400,"en":"See every outrage she commits:"},{"id":"semetey-2-2013:p1360:b004:l032","ordinal":291401,"en":"Her heart burning to embers,"},{"id":"semetey-2-2013:p1360:b004:l033","ordinal":291402,"en":"Her eyes staring without dying,"},{"id":"semetey-2-2013:p1360:b004:l034","ordinal":291403,"en":"Parted from the bloodthirsty lion,"},{"id":"semetey-2-2013:p1360:b004:l035","ordinal":291404,"en":"Her dear hair like willow silk,"},{"id":"semetey-2-2013:p1360:b004:l036","ordinal":291405,"en":"Her dear head cast onto the plain,"},{"id":"semetey-2-2013:p1360:b004:l037","ordinal":291406,"en":"Rather than suffer such disgrace,"},{"id":"semetey-2-2013:p1360:b004:l038","ordinal":291407,"en":"She wished to die before her appointed death,"},{"id":"semetey-2-2013:p1360:b004:l039","ordinal":291408,"en":"And see the true abode from which none return."},{"id":"semetey-2-2013:p1361:b003:l001","ordinal":291409,"en":"She wished to see her dear head there."},{"id":"semetey-2-2013:p1361:b003:l002","ordinal":291410,"en":"Her heart burning, her eyes blazing,"},{"id":"semetey-2-2013:p1361:b003:l003","ordinal":291411,"en":"The enraged Chürök"},{"id":"semetey-2-2013:p1361:b003:l004","ordinal":291412,"en":"Was truly seized by bloodlust."},{"id":"semetey-2-2013:p1361:b003:l005","ordinal":291413,"en":"She grieved, saying, “I shall die;"},{"id":"semetey-2-2013:p1361:b003:l006","ordinal":291414,"en":"Rather than become Kyyaz’s spoil,"},{"id":"semetey-2-2013:p1361:b003:l007","ordinal":291415,"en":"May I see my dear head"},{"id":"semetey-2-2013:p1361:b003:l008","ordinal":291416,"en":"In the true abode from which none return.”"},{"id":"semetey-2-2013:p1361:b003:l009","ordinal":291417,"en":"Aichürök’s heart was divided;"},{"id":"semetey-2-2013:p1361:b003:l010","ordinal":291418,"en":"Brave Kyyaz of the Jediger"},{"id":"semetey-2-2013:p1361:b003:l011","ordinal":291419,"en":"Appeared before Aichürök’s eyes"},{"id":"semetey-2-2013:p1361:b003:l012","ordinal":291420,"en":"Like a dragon."},{"id":"semetey-2-2013:p1361:b003:l013","ordinal":291421,"en":"“If slave Kyyaz comes near,"},{"id":"semetey-2-2013:p1361:b003:l014","ordinal":291422,"en":"I will draw my sword from its sheath"},{"id":"semetey-2-2013:p1361:b003:l015","ordinal":291423,"en":"And bring utter calamity"},{"id":"semetey-2-2013:p1361:b003:l016","ordinal":291424,"en":"Upon brave Kyyaz;"},{"id":"semetey-2-2013:p1361:b003:l017","ordinal":291425,"en":"I will cut short his age."},{"id":"semetey-2-2013:p1361:b003:l018","ordinal":291426,"en":"I will find a way to deal"},{"id":"semetey-2-2013:p1361:b003:l019","ordinal":291427,"en":"With this would-be hero Kyyaz;"},{"id":"semetey-2-2013:p1361:b003:l020","ordinal":291428,"en":"I will strike him with Zulpukor."},{"id":"semetey-2-2013:p1361:b003:l021","ordinal":291429,"en":"The sun of God darkened in heaven,"},{"id":"semetey-2-2013:p1361:b003:l022","ordinal":291430,"en":"And sixty cares at once"},{"id":"semetey-2-2013:p1361:b003:l023","ordinal":291431,"en":"Descended upon Aichürök’s head."},{"id":"semetey-2-2013:p1361:b003:l024","ordinal":291432,"en":"If Kyyaz draws near,"},{"id":"semetey-2-2013:p1361:b003:l025","ordinal":291433,"en":"If Kanchoro comes beside me,"},{"id":"semetey-2-2013:p1361:b003:l026","ordinal":291434,"en":"I will heap trouble upon them;"},{"id":"semetey-2-2013:p1361:b003:l027","ordinal":291435,"en":"Whichever one approaches,"},{"id":"semetey-2-2013:p1361:b003:l028","ordinal":291436,"en":"I will take his apple-like head"},{"id":"semetey-2-2013:p1361:b003:l029","ordinal":291437,"en":"And bring utter destruction"},{"id":"semetey-2-2013:p1361:b003:l030","ordinal":291438,"en":"Upon the two villains.”"},{"id":"semetey-2-2013:p1361:b003:l031","ordinal":291439,"en":"Aichürök stood thinking this:"},{"id":"semetey-2-2013:p1361:b003:l032","ordinal":291440,"en":"“Let me take delight in slaughter,"},{"id":"semetey-2-2013:p1361:b003:l033","ordinal":291441,"en":"Sparing no accursed soul;"},{"id":"semetey-2-2013:p1361:b003:l034","ordinal":291442,"en":"Let me sever someone’s head.”"},{"id":"semetey-2-2013:p1361:b003:l035","ordinal":291443,"en":"A capable maid with a man’s bearing,"},{"id":"semetey-2-2013:p1361:b003:l036","ordinal":291444,"en":"A maid who knew the enemy’s devices,"},{"id":"semetey-2-2013:p1361:b003:l037","ordinal":291445,"en":"A mighty maid,"},{"id":"semetey-2-2013:p1361:b003:l038","ordinal":291446,"en":"Who skimmed over the horse’s back,"},{"id":"semetey-2-2013:p1361:b003:l039","ordinal":291447,"en":"Who had flown and journeyed"},{"id":"semetey-2-2013:p1361:b005:l001","ordinal":291448,"en":"Across the whole wide world."},{"id":"semetey-2-2013:p1361:b005:l002","ordinal":291449,"en":"The mist dispersed from the sky;"},{"id":"semetey-2-2013:p1361:b005:l003","ordinal":291450,"en":"Taking the form of a man,"},{"id":"semetey-2-2013:p1361:b005:l004","ordinal":291451,"en":"She had observed all the giants,"},{"id":"semetey-2-2013:p1361:b005:l005","ordinal":291452,"en":"Young and old,"},{"id":"semetey-2-2013:p1361:b005:l006","ordinal":291453,"en":"Their warriors and lions,"},{"id":"semetey-2-2013:p1361:b005:l007","ordinal":291454,"en":"Their many kinds of men,"},{"id":"semetey-2-2013:p1361:b005:l008","ordinal":291455,"en":"Their rivers and lakes,"},{"id":"semetey-2-2013:p1361:b005:l009","ordinal":291456,"en":"And those whose fortunes were complete;"},{"id":"semetey-2-2013:p1361:b005:l010","ordinal":291457,"en":"Your sister-in-law had judged"},{"id":"semetey-2-2013:p1361:b005:l011","ordinal":291458,"en":"The black-hearted wretches"},{"id":"semetey-2-2013:p1361:b005:l012","ordinal":291459,"en":"Who fought women over the cauldron."},{"id":"semetey-2-2013:p1361:b005:l013","ordinal":291460,"en":"The accustomed fierce Aichürök,"},{"id":"semetey-2-2013:p1361:b005:l014","ordinal":291461,"en":"With a man’s bearing and fiery eyes—"},{"id":"semetey-2-2013:p1361:b005:l015","ordinal":291462,"en":"Keep far away if you see her form!"},{"id":"semetey-2-2013:p1361:b005:l016","ordinal":291463,"en":"Bloodlust seized her firmly;"},{"id":"semetey-2-2013:p1361:b005:l017","ordinal":291464,"en":"Her even teeth, like ruby stones,"},{"id":"semetey-2-2013:p1361:b005:l018","ordinal":291465,"en":"Teeth unlike those of other women,"},{"id":"semetey-2-2013:p1361:b005:l019","ordinal":291466,"en":"She ground with a loud crunch."},{"id":"semetey-2-2013:p1361:b005:l020","ordinal":291467,"en":"Her eyes blazed in torment;"},{"id":"semetey-2-2013:p1361:b005:l021","ordinal":291468,"en":"She writhed like a white snake"},{"id":"semetey-2-2013:p1361:b005:l022","ordinal":291469,"en":"And gathered herself like a lion."},{"id":"semetey-2-2013:p1361:b005:l023","ordinal":291470,"en":"The blood left her face pale;"},{"id":"semetey-2-2013:p1361:b005:l024","ordinal":291471,"en":"Her eyes reddened like a wolf’s."},{"id":"semetey-2-2013:p1361:b005:l025","ordinal":291472,"en":"Her dear hair, thick as a hillock,"},{"id":"semetey-2-2013:p1361:b005:l026","ordinal":291473,"en":"Streamed down across her breast."},{"id":"semetey-2-2013:p1361:b005:l027","ordinal":291474,"en":"The Jediger were a host, she was alone,"},{"id":"semetey-2-2013:p1361:b005:l028","ordinal":291475,"en":"Yet she did not look around,"},{"id":"semetey-2-2013:p1361:b005:l029","ordinal":291476,"en":"And spared no living soul."},{"id":"semetey-2-2013:p1361:b005:l030","ordinal":291477,"en":"Though the Jediger ringed her,"},{"id":"semetey-2-2013:p1361:b005:l031","ordinal":291478,"en":"She did not reckon that she would die;"},{"id":"semetey-2-2013:p1361:b005:l032","ordinal":291479,"en":"She did not look about her,"},{"id":"semetey-2-2013:p1361:b005:l033","ordinal":291480,"en":"Nor spare her thread-thin life,"},{"id":"semetey-2-2013:p1361:b005:l034","ordinal":291481,"en":"And counted the shouting Jediger"},{"id":"semetey-2-2013:p1361:b005:l035","ordinal":291482,"en":"As less than a settled people."},{"id":"semetey-2-2013:p1361:b005:l036","ordinal":291483,"en":"Her heart burned to embers;"},{"id":"semetey-2-2013:p1361:b005:l037","ordinal":291484,"en":"She flamed and blazed fiercely."},{"id":"semetey-2-2013:p1361:b005:l038","ordinal":291485,"en":"The guards who kept watch,"},{"id":"semetey-2-2013:p1361:b005:l039","ordinal":291486,"en":"The keepers at the gate-mouth,"},{"id":"semetey-2-2013:p1362:b003:l001","ordinal":291487,"en":"Those who stood beneath the banner—"},{"id":"semetey-2-2013:p1362:b003:l002","ordinal":291488,"en":"That luckless rabble"},{"id":"semetey-2-2013:p1362:b003:l003","ordinal":291489,"en":"Would be ground to powder."},{"id":"semetey-2-2013:p1362:b003:l004","ordinal":291490,"en":"Her heart burned, her breast was embers;"},{"id":"semetey-2-2013:p1362:b003:l005","ordinal":291491,"en":"Her apple-like head was in torment—"},{"id":"semetey-2-2013:p1362:b003:l006","ordinal":291492,"en":"No woman was ever so afflicted."},{"id":"semetey-2-2013:p1362:b003:l007","ordinal":291493,"en":"Grieving in sorrow,"},{"id":"semetey-2-2013:p1362:b003:l008","ordinal":291494,"en":"Parted together with her hero"},{"id":"semetey-2-2013:p1362:b003:l009","ordinal":291495,"en":"From Akjoltoy, who had been her support,"},{"id":"semetey-2-2013:p1362:b003:l010","ordinal":291496,"en":"Aichürök now remembered"},{"id":"semetey-2-2013:p1362:b003:l011","ordinal":291497,"en":"That God might strike her,"},{"id":"semetey-2-2013:p1362:b003:l012","ordinal":291498,"en":"That the Jediger would take her as spoil,"},{"id":"semetey-2-2013:p1362:b003:l013","ordinal":291499,"en":"And, if enraged, the Jediger"},{"id":"semetey-2-2013:p1362:b003:l014","ordinal":291500,"en":"Would cruelly take her life;"},{"id":"semetey-2-2013:p1362:b003:l015","ordinal":291501,"en":"Only then would your pale one rest,"},{"id":"semetey-2-2013:p1362:b003:l016","ordinal":291502,"en":"For they would show no mercy."},{"id":"semetey-2-2013:p1362:b003:l017","ordinal":291503,"en":"She bent her mind and formed a plan,"},{"id":"semetey-2-2013:p1362:b003:l018","ordinal":291504,"en":"Thinking Kyyaz and Kanchoro"},{"id":"semetey-2-2013:p1362:b003:l019","ordinal":291505,"en":"Might come within her reach."},{"id":"semetey-2-2013:p1362:b003:l020","ordinal":291506,"en":"The raging woman could not stand still."},{"id":"semetey-2-2013:p1362:b003:l021","ordinal":291507,"en":"When the enemy surrounded her,"},{"id":"semetey-2-2013:p1362:b003:l022","ordinal":291508,"en":"Her ribs seemed torn apart;"},{"id":"semetey-2-2013:p1362:b003:l023","ordinal":291509,"en":"Her mind broke loose from grief."},{"id":"semetey-2-2013:p1362:b003:l024","ordinal":291510,"en":"In anguish she could not stand,"},{"id":"semetey-2-2013:p1362:b003:l025","ordinal":291511,"en":"Yet could not take an innocent life."},{"id":"semetey-2-2013:p1362:b003:l026","ordinal":291512,"en":"Inside that palace"},{"id":"semetey-2-2013:p1362:b003:l027","ordinal":291513,"en":"Stood a grove of plane trees,"},{"id":"semetey-2-2013:p1362:b003:l028","ordinal":291514,"en":"And towering at its center,"},{"id":"semetey-2-2013:p1362:b003:l029","ordinal":291515,"en":"Plain as a camel ridden by a prince,"},{"id":"semetey-2-2013:p1362:b003:l030","ordinal":291516,"en":"Was a golden throne."},{"id":"semetey-2-2013:p1362:b003:l031","ordinal":291517,"en":"Beneath that throne hung"},{"id":"semetey-2-2013:p1362:b003:l032","ordinal":291518,"en":"Tassels made of jewels,"},{"id":"semetey-2-2013:p1362:b003:l033","ordinal":291519,"en":"Installed in splendor"},{"id":"semetey-2-2013:p1362:b003:l034","ordinal":291520,"en":"For the bloodthirsty lion."},{"id":"semetey-2-2013:p1362:b003:l035","ordinal":291521,"en":"Before the throne lay a great carpet,"},{"id":"semetey-2-2013:p1362:b003:l036","ordinal":291522,"en":"Its border like a camel-load."},{"id":"semetey-2-2013:p1362:b003:l037","ordinal":291523,"en":"If you sat and studied its meaning,"},{"id":"semetey-2-2013:p1362:b003:l038","ordinal":291524,"en":"It seemed the very image of fortune;"},{"id":"semetey-2-2013:p1362:b003:l039","ordinal":291525,"en":"Its warp was yellow gold,"},{"id":"semetey-2-2013:p1362:b004:l001","ordinal":291526,"en":"Its patterns countless as the palate’s fancies."},{"id":"semetey-2-2013:p1362:b004:l002","ordinal":291527,"en":"So much beaten gold was poured"},{"id":"semetey-2-2013:p1362:b004:l003","ordinal":291528,"en":"Into the making of that carpet"},{"id":"semetey-2-2013:p1362:b004:l004","ordinal":291529,"en":"That the bloodthirsty hero’s treasury"},{"id":"semetey-2-2013:p1362:b004:l005","ordinal":291530,"en":"Was greatly diminished."},{"id":"semetey-2-2013:p1362:b004:l006","ordinal":291531,"en":"For many years it did not stir;"},{"id":"semetey-2-2013:p1362:b004:l007","ordinal":291532,"en":"Its edges neither rotted nor softened,"},{"id":"semetey-2-2013:p1362:b004:l008","ordinal":291533,"en":"For it was meant to lie before the throne."},{"id":"semetey-2-2013:p1362:b004:l009","ordinal":291534,"en":"Silk-edged, with golden ties,"},{"id":"semetey-2-2013:p1362:b004:l010","ordinal":291535,"en":"It was a precious and magnificent carpet,"},{"id":"semetey-2-2013:p1362:b004:l011","ordinal":291536,"en":"Too fine to spread for a slave;"},{"id":"semetey-2-2013:p1362:b004:l012","ordinal":291537,"en":"Soaked in water for eighty years,"},{"id":"semetey-2-2013:p1362:b004:l013","ordinal":291538,"en":"It still would neither fray nor rot—"},{"id":"semetey-2-2013:p1362:b004:l014","ordinal":291539,"en":"The great carpet of the leopard."},{"id":"semetey-2-2013:p1362:b004:l015","ordinal":291540,"en":"The Jediger, greedy for a carpet"},{"id":"semetey-2-2013:p1362:b004:l016","ordinal":291541,"en":"That no one would surrender on request,"},{"id":"semetey-2-2013:p1362:b004:l017","ordinal":291542,"en":"Stretched out plundering hands to it."},{"id":"semetey-2-2013:p1362:b004:l018","ordinal":291543,"en":"They attacked the treasuries on either side,"},{"id":"semetey-2-2013:p1362:b004:l019","ordinal":291544,"en":"Plundering their stores;"},{"id":"semetey-2-2013:p1362:b004:l020","ordinal":291545,"en":"They split whole sable pelts in half,"},{"id":"semetey-2-2013:p1362:b004:l021","ordinal":291546,"en":"Wrapped them around their calves,"},{"id":"semetey-2-2013:p1362:b004:l022","ordinal":291547,"en":"And lay there plundering"},{"id":"semetey-2-2013:p1362:b004:l023","ordinal":291548,"en":"Red gold and white coin."},{"id":"semetey-2-2013:p1362:b004:l024","ordinal":291549,"en":"They cut down the plane trees"},{"id":"semetey-2-2013:p1362:b004:l025","ordinal":291550,"en":"Before the throne and laid them flat."},{"id":"semetey-2-2013:p1362:b004:l026","ordinal":291551,"en":"The Jediger shouldered aside"},{"id":"semetey-2-2013:p1362:b004:l027","ordinal":291552,"en":"The girls and young women in the palace,"},{"id":"semetey-2-2013:p1362:b004:l028","ordinal":291553,"en":"Boasting loudly of their might."},{"id":"semetey-2-2013:p1362:b004:l029","ordinal":291554,"en":"The palace’s eighty maidens,"},{"id":"semetey-2-2013:p1362:b004:l030","ordinal":291555,"en":"Sixty ladies and forty brides,"},{"id":"semetey-2-2013:p1362:b004:l031","ordinal":291556,"en":"Young and old alike,"},{"id":"semetey-2-2013:p1362:b004:l032","ordinal":291557,"en":"They dragged off in ragged disarray"},{"id":"semetey-2-2013:p1362:b004:l033","ordinal":291558,"en":"And made spoil of them all."},{"id":"semetey-2-2013:p1362:b004:l034","ordinal":291559,"en":"The red-robed, slender-waisted,"},{"id":"semetey-2-2013:p1362:b004:l035","ordinal":291560,"en":"Quivering beauties"},{"id":"semetey-2-2013:p1362:b004:l036","ordinal":291561,"en":"They drove all together in lamentation."},{"id":"semetey-2-2013:p1362:b004:l037","ordinal":291562,"en":"The captured girls had long thought,"},{"id":"semetey-2-2013:p1362:b004:l038","ordinal":291563,"en":"“This day was bound to come”;"},{"id":"semetey-2-2013:p1362:b004:l039","ordinal":291564,"en":"The strong among them seized the weak,"},{"id":"semetey-2-2013:p1363:b003:l001","ordinal":291565,"en":"And dragged them off stumbling."},{"id":"semetey-2-2013:p1363:b003:l002","ordinal":291566,"en":"With repeated surges the Jediger"},{"id":"semetey-2-2013:p1363:b003:l003","ordinal":291567,"en":"Lay plundering everything;"},{"id":"semetey-2-2013:p1363:b003:l004","ordinal":291568,"en":"They smashed whoever resisted"},{"id":"semetey-2-2013:p1363:b003:l005","ordinal":291569,"en":"And stripped the place utterly bare."},{"id":"semetey-2-2013:p1363:b003:l006","ordinal":291570,"en":"The heaps of gold filling the vault"},{"id":"semetey-2-2013:p1363:b003:l007","ordinal":291571,"en":"They divided up and carried away."},{"id":"semetey-2-2013:p1363:b003:l008","ordinal":291572,"en":"They attacked every part of the gate;"},{"id":"semetey-2-2013:p1363:b003:l009","ordinal":291573,"en":"Whatever remained,"},{"id":"semetey-2-2013:p1363:b003:l010","ordinal":291574,"en":"The Jediger plundered and burned."},{"id":"semetey-2-2013:p1363:b003:l011","ordinal":291575,"en":"The young women who had been out strolling"},{"id":"semetey-2-2013:p1363:b003:l012","ordinal":291576,"en":"Lost their dowries and were lined up;"},{"id":"semetey-2-2013:p1363:b003:l013","ordinal":291577,"en":"The red-robed, slender-waisted,"},{"id":"semetey-2-2013:p1363:b003:l014","ordinal":291578,"en":"Quivering beauties"},{"id":"semetey-2-2013:p1363:b003:l015","ordinal":291579,"en":"Were plundered by the Jediger."},{"id":"semetey-2-2013:p1363:b003:l016","ordinal":291580,"en":"Countless goods and myriad possessions"},{"id":"semetey-2-2013:p1363:b003:l017","ordinal":291581,"en":"Were scattered, and a feast began."},{"id":"semetey-2-2013:p1363:b003:l018","ordinal":291582,"en":"Into your wretched sister-in-law’s mind"},{"id":"semetey-2-2013:p1363:b003:l019","ordinal":291583,"en":"Came a merciless design"},{"id":"semetey-2-2013:p1363:b003:l020","ordinal":291584,"en":"That no person could unravel or nation know."}]
