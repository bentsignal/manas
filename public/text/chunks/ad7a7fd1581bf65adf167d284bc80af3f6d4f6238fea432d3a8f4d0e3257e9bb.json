[{"id":"semetey-1-2013:p0711:b003:l009","ordinal":131329,"en":"Truly a spirit steed, Telkurong,"},{"id":"semetey-1-2013:p0711:b003:l010","ordinal":131330,"en":"Ridden into combat, it never faltered;"},{"id":"semetey-1-2013:p0711:b003:l011","ordinal":131331,"en":"Ridden with the baggage train, it never ailed;"},{"id":"semetey-1-2013:p0711:b003:l012","ordinal":131332,"en":"Ridden on reconnaissance, it never tired."},{"id":"semetey-1-2013:p0711:b003:l013","ordinal":131333,"en":"No wind could match its trot;"},{"id":"semetey-1-2013:p0711:b003:l014","ordinal":131334,"en":"No beast could match its walk."},{"id":"semetey-1-2013:p0711:b003:l015","ordinal":131335,"en":"Karacha's daughter Saikal,"},{"id":"semetey-1-2013:p0711:b003:l016","ordinal":131336,"en":"Khan Zhakyp's Kardygach—"},{"id":"semetey-1-2013:p0711:b003:l017","ordinal":131337,"en":"When the countless Chinese of Kakan"},{"id":"semetey-1-2013:p0711:b003:l018","ordinal":131338,"en":"Came sweeping over all,"},{"id":"semetey-1-2013:p0711:b003:l019","ordinal":131339,"en":"The Kalmyk giants,"},{"id":"semetey-1-2013:p0711:b003:l020","ordinal":131340,"en":"Mighty Zholoi and Boroonchu,"},{"id":"semetey-1-2013:p0711:b003:l021","ordinal":131341,"en":"The Kalmyks' Bozkertik,"},{"id":"semetey-1-2013:p0711:b003:l022","ordinal":131342,"en":"All the many giants were there,"},{"id":"semetey-1-2013:p0711:b003:l023","ordinal":131343,"en":"Ezkara, khan of the Manchus—"},{"id":"semetey-1-2013:p0711:b003:l024","ordinal":131344,"en":"When they all thrust their spears,"},{"id":"semetey-1-2013:p0711:b003:l025","ordinal":131345,"en":"The red steel Zulpukor,"},{"id":"semetey-1-2013:p0711:b003:l026","ordinal":131346,"en":"Don't you appreciate it?"},{"id":"semetey-1-2013:p0711:b003:l027","ordinal":131347,"en":"Against the giants of forty Chinese tribes,"},{"id":"semetey-1-2013:p0711:b003:l028","ordinal":131348,"en":"Jousting for forty-one days,"},{"id":"semetey-1-2013:p0711:b003:l029","ordinal":131349,"en":"Had she not stood firm?"},{"id":"semetey-1-2013:p0711:b003:l030","ordinal":131350,"en":"She was the lion among women."},{"id":"semetey-1-2013:p0711:b003:l031","ordinal":131351,"en":"If you ask about that accursed one,"},{"id":"semetey-1-2013:p0711:b003:l032","ordinal":131352,"en":"She was a hero who could shatter the world."},{"id":"semetey-1-2013:p0711:b003:l033","ordinal":131353,"en":"Pursuing Semetey,"},{"id":"semetey-1-2013:p0711:b003:l034","ordinal":131354,"en":"She drove him onward there."},{"id":"semetey-1-2013:p0711:b003:l035","ordinal":131355,"en":"His wits deserted him;"},{"id":"semetey-1-2013:p0711:b003:l036","ordinal":131356,"en":"Semetey, in a panic,"},{"id":"semetey-1-2013:p0711:b003:l037","ordinal":131357,"en":"Despairing of his entrusted life,"},{"id":"semetey-1-2013:p0711:b003:l038","ordinal":131358,"en":"Fled toward Bakai."},{"id":"semetey-1-2013:p0711:b003:l039","ordinal":131359,"en":"Darting off in haste,"},{"id":"semetey-1-2013:p0711:b004:l001","ordinal":131360,"en":"He spurred toward his uncle."},{"id":"semetey-1-2013:p0711:b004:l002","ordinal":131361,"en":"“If my resourceful uncle Bakai"},{"id":"semetey-1-2013:p0711:b004:l003","ordinal":131362,"en":"Does not rescue me,"},{"id":"semetey-1-2013:p0711:b004:l004","ordinal":131363,"en":"Here my resources are at an end.”"},{"id":"semetey-1-2013:p0711:b004:l005","ordinal":131364,"en":"Then the boy Semetey"},{"id":"semetey-1-2013:p0711:b004:l006","ordinal":131365,"en":"Grieved in distress."},{"id":"semetey-1-2013:p0711:b004:l007","ordinal":131366,"en":"The Aktulpar beneath him"},{"id":"semetey-1-2013:p0711:b004:l008","ordinal":131367,"en":"Bounded over uneven ground."},{"id":"semetey-1-2013:p0711:b004:l009","ordinal":131368,"en":"Semetey upon him"},{"id":"semetey-1-2013:p0711:b004:l010","ordinal":131369,"en":"Despaired of his fly-small soul."},{"id":"semetey-1-2013:p0711:b004:l011","ordinal":131370,"en":"Hurrying, flustered and panicked,"},{"id":"semetey-1-2013:p0711:b004:l012","ordinal":131371,"en":"The handle slipped from his wrist;"},{"id":"semetey-1-2013:p0711:b004:l013","ordinal":131372,"en":"His heart lost its covering."},{"id":"semetey-1-2013:p0711:b004:l014","ordinal":131373,"en":"The reason he was so alarmed:"},{"id":"semetey-1-2013:p0711:b004:l015","ordinal":131374,"en":"The hero he had met was a true hero,"},{"id":"semetey-1-2013:p0711:b004:l016","ordinal":131375,"en":"A lion without a flaw,"},{"id":"semetey-1-2013:p0711:b004:l017","ordinal":131376,"en":"Mighty, with surpassing fortune."},{"id":"semetey-1-2013:p0711:b004:l018","ordinal":131377,"en":"My hoof left behind by a winged steed,"},{"id":"semetey-1-2013:p0711:b004:l019","ordinal":131378,"en":"“There is none like this among mortals."},{"id":"semetey-1-2013:p0711:b004:l020","ordinal":131379,"en":"The spear thrust in earnest"},{"id":"semetey-1-2013:p0711:b004:l021","ordinal":131380,"en":"Is like tempered red iron."},{"id":"semetey-1-2013:p0711:b004:l022","ordinal":131381,"en":"Looking at that great size,"},{"id":"semetey-1-2013:p0711:b004:l023","ordinal":131382,"en":"It is like a crag on a jutting mountain!”"},{"id":"semetey-1-2013:p0711:b004:l024","ordinal":131383,"en":"Saying this, Semetey,"},{"id":"semetey-1-2013:p0711:b004:l025","ordinal":131384,"en":"His strength gone, distressed,"},{"id":"semetey-1-2013:p0711:b004:l026","ordinal":131385,"en":"Turned in despair toward Bakai."},{"id":"semetey-1-2013:p0711:b004:l027","ordinal":131386,"en":"It was his hour of panic;"},{"id":"semetey-1-2013:p0711:b004:l028","ordinal":131387,"en":"Manas's heroic orphan son,"},{"id":"semetey-1-2013:p0711:b004:l029","ordinal":131388,"en":"Heading toward Bakai,"},{"id":"semetey-1-2013:p0711:b004:l030","ordinal":131389,"en":"Had taken to flight."},{"id":"semetey-1-2013:p0711:b004:l031","ordinal":131390,"en":"Aktulpar came bounding;"},{"id":"semetey-1-2013:p0711:b004:l032","ordinal":131391,"en":"Semetey despaired of his entrusted life."},{"id":"semetey-1-2013:p0711:b004:l033","ordinal":131392,"en":"Through the tamarisk thickets,"},{"id":"semetey-1-2013:p0711:b004:l034","ordinal":131393,"en":"Semetey fled, seeking shelter with Khan Bakai."},{"id":"semetey-1-2013:p0711:b004:l036","ordinal":131394,"en":"Hurrying, flustered and panicked,"},{"id":"semetey-1-2013:p0711:b004:l037","ordinal":131395,"en":"That orphan of Manas"},{"id":"semetey-1-2013:p0711:b004:l038","ordinal":131396,"en":"Was terribly alarmed."},{"id":"semetey-1-2013:p0711:b004:l039","ordinal":131397,"en":"Around your oceanlike uncle Bakai,"},{"id":"semetey-1-2013:p0712:b003:l001","ordinal":131398,"en":"He fled in circles."},{"id":"semetey-1-2013:p0712:b003:l002","ordinal":131399,"en":"Your lionlike uncle, heroic Bakai,"},{"id":"semetey-1-2013:p0712:b003:l003","ordinal":131400,"en":"Stood astonished there."},{"id":"semetey-1-2013:p0712:b003:l004","ordinal":131401,"en":"Seeing the figure, troubled,"},{"id":"semetey-1-2013:p0712:b003:l005","ordinal":131402,"en":"Khan Bakai spoke out,"},{"id":"semetey-1-2013:p0712:b003:l006","ordinal":131403,"en":"Pleading with Semetey:"},{"id":"semetey-1-2013:p0712:b003:l007","ordinal":131404,"en":"“O my precious ornament left by Manas,"},{"id":"semetey-1-2013:p0712:b003:l008","ordinal":131405,"en":"My mirror left by the hero,"},{"id":"semetey-1-2013:p0712:b003:l009","ordinal":131406,"en":"My hoof left by the winged steed,"},{"id":"semetey-1-2013:p0712:b003:l010","ordinal":131407,"en":"My light left by the hawk,"},{"id":"semetey-1-2013:p0712:b003:l011","ordinal":131408,"en":"You are flustered and alarmed;"},{"id":"semetey-1-2013:p0712:b003:l012","ordinal":131409,"en":"Son, you have fled in great fear."},{"id":"semetey-1-2013:p0712:b003:l013","ordinal":131410,"en":"Is there a deep trench dug?"},{"id":"semetey-1-2013:p0712:b003:l014","ordinal":131411,"en":"Is there an iron net to catch you?"},{"id":"semetey-1-2013:p0712:b003:l015","ordinal":131412,"en":"Is there boiling brine?"},{"id":"semetey-1-2013:p0712:b003:l016","ordinal":131413,"en":"You flee so badly, cringing."},{"id":"semetey-1-2013:p0712:b003:l017","ordinal":131414,"en":"From Kakan's Beijing,"},{"id":"semetey-1-2013:p0712:b003:l018","ordinal":131415,"en":"Son, has a countless army swept down?"},{"id":"semetey-1-2013:p0712:b003:l019","ordinal":131416,"en":"If a countless army has swept down,"},{"id":"semetey-1-2013:p0712:b003:l020","ordinal":131417,"en":"My shelter, my orphan, tell the truth."},{"id":"semetey-1-2013:p0712:b003:l021","ordinal":131418,"en":"Let me mount Kokcholok,"},{"id":"semetey-1-2013:p0712:b003:l022","ordinal":131419,"en":"Against the surging multitude of Kalmyks,"},{"id":"semetey-1-2013:p0712:b003:l023","ordinal":131420,"en":"At the point of death, take one last meal:"},{"id":"semetey-1-2013:p0712:b003:l024","ordinal":131421,"en":"Unless the Creator himself knew it,"},{"id":"semetey-1-2013:p0712:b003:l025","ordinal":131422,"en":"The Prophet exists in truth, my faith is true."},{"id":"semetey-1-2013:p0712:b003:l026","ordinal":131423,"en":"This year, in my white-bearded age,"},{"id":"semetey-1-2013:p0712:b003:l027","ordinal":131424,"en":"When my final journey is near,"},{"id":"semetey-1-2013:p0712:b003:l028","ordinal":131425,"en":"Let me enter battle with you."},{"id":"semetey-1-2013:p0712:b003:l029","ordinal":131426,"en":"The countless Chinese and many Shibee,"},{"id":"semetey-1-2013:p0712:b003:l030","ordinal":131427,"en":"Let me drive them clear to Beijing."},{"id":"semetey-1-2013:p0712:b003:l031","ordinal":131428,"en":"At my life's end, I, Bakai,"},{"id":"semetey-1-2013:p0712:b003:l032","ordinal":131429,"en":"Let me drive them into Kakan."},{"id":"semetey-1-2013:p0712:b003:l033","ordinal":131430,"en":"Great Beijing is a great country,"},{"id":"semetey-1-2013:p0712:b003:l034","ordinal":131431,"en":"Let me drive them to its farthest edge."},{"id":"semetey-1-2013:p0712:b003:l035","ordinal":131432,"en":"Is there a claim where no wrong was done?"},{"id":"semetey-1-2013:p0712:b003:l036","ordinal":131433,"en":"Is there an enemy you have met?”"},{"id":"semetey-1-2013:p0712:b003:l037","ordinal":131434,"en":"Before Bakai finished speaking,"},{"id":"semetey-1-2013:p0712:b003:l038","ordinal":131435,"en":"Before orphan Semetey could answer,"},{"id":"semetey-1-2013:p0712:b003:l039","ordinal":131436,"en":"In the blink of an eye,"},{"id":"semetey-1-2013:p0712:b004:l001","ordinal":131437,"en":"Before this or that could be said,"},{"id":"semetey-1-2013:p0712:b004:l002","ordinal":131438,"en":"Riding a dark chestnut horse,"},{"id":"semetey-1-2013:p0712:b004:l003","ordinal":131439,"en":"Its long tail tightly knotted,"},{"id":"semetey-1-2013:p0712:b004:l004","ordinal":131440,"en":"Massive as half a mountain,"},{"id":"semetey-1-2013:p0712:b004:l005","ordinal":131441,"en":"In strength and wrath,"},{"id":"semetey-1-2013:p0712:b004:l006","ordinal":131442,"en":"In the venom of the leveled spear,"},{"id":"semetey-1-2013:p0712:b004:l007","ordinal":131443,"en":"No mortal could come against her;"},{"id":"semetey-1-2013:p0712:b004:l008","ordinal":131444,"en":"No mortal could look upon her face."},{"id":"semetey-1-2013:p0712:b004:l009","ordinal":131445,"en":"The sight troubled the heart."},{"id":"semetey-1-2013:p0712:b004:l010","ordinal":131446,"en":"Her strength and bearing"},{"id":"semetey-1-2013:p0712:b004:l011","ordinal":131447,"en":"Appeared unlike any mortal's."},{"id":"semetey-1-2013:p0712:b004:l012","ordinal":131448,"en":"Her mount, the winged steed Telkurong,"},{"id":"semetey-1-2013:p0712:b004:l013","ordinal":131449,"en":"She turned without drawing back."},{"id":"semetey-1-2013:p0712:b004:l014","ordinal":131450,"en":"A painted spear twelve fathoms long"},{"id":"semetey-1-2013:p0712:b004:l015","ordinal":131451,"en":"She leveled with a roar."},{"id":"semetey-1-2013:p0712:b004:l016","ordinal":131452,"en":"Blood suffused her dark eyes;"},{"id":"semetey-1-2013:p0712:b004:l017","ordinal":131453,"en":"Her bloody face grew grim."},{"id":"semetey-1-2013:p0712:b004:l018","ordinal":131454,"en":"Her eyes blazed fiercely like fire;"},{"id":"semetey-1-2013:p0712:b004:l019","ordinal":131455,"en":"Her thirst for blood seized her in earnest."},{"id":"semetey-1-2013:p0712:b004:l020","ordinal":131456,"en":"Looking at her bared front teeth,"},{"id":"semetey-1-2013:p0712:b004:l021","ordinal":131457,"en":"They rattled like millet grains."},{"id":"semetey-1-2013:p0712:b004:l022","ordinal":131458,"en":"The blue flame in her mouth"},{"id":"semetey-1-2013:p0712:b004:l023","ordinal":131459,"en":"Burned and hissed like fire."},{"id":"semetey-1-2013:p0712:b004:l024","ordinal":131460,"en":"Raging and seething,"},{"id":"semetey-1-2013:p0712:b004:l025","ordinal":131461,"en":"She had cast off a woman's appearance,"},{"id":"semetey-1-2013:p0712:b004:l026","ordinal":131462,"en":"And dressed in men's clothing."},{"id":"semetey-1-2013:p0712:b004:l027","ordinal":131463,"en":"Her splendid hair, like sedge,"},{"id":"semetey-1-2013:p0712:b004:l028","ordinal":131464,"en":"She bound tightly upon her crown."},{"id":"semetey-1-2013:p0712:b004:l029","ordinal":131465,"en":"A helmet of blue iron"},{"id":"semetey-1-2013:p0712:b004:l030","ordinal":131466,"en":"She set over her head."},{"id":"semetey-1-2013:p0712:b004:l031","ordinal":131467,"en":"Heroic Bakai stood astonished,"},{"id":"semetey-1-2013:p0712:b004:l032","ordinal":131468,"en":"And looked carefully."},{"id":"semetey-1-2013:p0712:b004:l033","ordinal":131469,"en":"The sight troubled his heart."},{"id":"semetey-1-2013:p0712:b004:l034","ordinal":131470,"en":"Poor sovereign Bakai's"},{"id":"semetey-1-2013:p0712:b004:l035","ordinal":131471,"en":"Tears streamed from his eyes."},{"id":"semetey-1-2013:p0712:b004:l036","ordinal":131472,"en":"His thoughts went in many directions;"},{"id":"semetey-1-2013:p0712:b004:l037","ordinal":131473,"en":"He sank into dejection."},{"id":"semetey-1-2013:p0712:b004:l038","ordinal":131474,"en":"Her form and figure,"},{"id":"semetey-1-2013:p0712:b004:l039","ordinal":131475,"en":"Her bearing on horseback,"},{"id":"semetey-1-2013:p0713:b003:l001","ordinal":131476,"en":"Like wolf-maned Manas the Leopard,"},{"id":"semetey-1-2013:p0713:b003:l002","ordinal":131477,"en":"She appeared his very likeness."},{"id":"semetey-1-2013:p0713:b003:l003","ordinal":131478,"en":"All the hills and valleys,"},{"id":"semetey-1-2013:p0713:b003:l004","ordinal":131479,"en":"Oh, wonder, seemed to be running."},{"id":"semetey-1-2013:p0713:b003:l005","ordinal":131480,"en":"To his eyes, departed Manas"},{"id":"semetey-1-2013:p0713:b003:l006","ordinal":131481,"en":"Seemed to have come alive."},{"id":"semetey-1-2013:p0713:b003:l007","ordinal":131482,"en":"His heart stirred and throbbed;"},{"id":"semetey-1-2013:p0713:b003:l008","ordinal":131483,"en":"Seeing this figure,"},{"id":"semetey-1-2013:p0713:b003:l009","ordinal":131484,"en":"Alas, Bakai sobbed."},{"id":"semetey-1-2013:p0713:b003:l010","ordinal":131485,"en":"Rabbit took a stick in hand,"},{"id":"semetey-1-2013:p0713:b003:l011","ordinal":131486,"en":"He wiped both eyes."},{"id":"semetey-1-2013:p0713:b003:l012","ordinal":131487,"en":"Unable to catch his breath, he sobbed,"},{"id":"semetey-1-2013:p0713:b003:l013","ordinal":131488,"en":"Heroic Bakai the Leopard,"},{"id":"semetey-1-2013:p0713:b003:l014","ordinal":131489,"en":"Your saint who had seen everything."},{"id":"semetey-1-2013:p0713:b003:l015","ordinal":131490,"en":"This person approaching,"},{"id":"semetey-1-2013:p0713:b003:l016","ordinal":131491,"en":"A haze parts from the sky,"},{"id":"semetey-1-2013:p0713:b003:l017","ordinal":131492,"en":"Was of the same nest as Manas,"},{"id":"semetey-1-2013:p0713:b003:l018","ordinal":131493,"en":"Not merely of one nest, but born one after another."},{"id":"semetey-1-2013:p0713:b003:l019","ordinal":131494,"en":"From Zhakyp, who was like Kambar,"},{"id":"semetey-1-2013:p0713:b003:l020","ordinal":131495,"en":"They had sprung from his very loins."},{"id":"semetey-1-2013:p0713:b003:l021","ordinal":131496,"en":"Your noble mother Chyiyrdy's"},{"id":"semetey-1-2013:p0713:b003:l022","ordinal":131497,"en":"Womb they had kicked their way out of."},{"id":"semetey-1-2013:p0713:b003:l023","ordinal":131498,"en":"Your incomparable mother Chyiyrdy"},{"id":"semetey-1-2013:p0713:b003:l024","ordinal":131499,"en":"Had borne one lion of a son,"},{"id":"semetey-1-2013:p0713:b003:l025","ordinal":131500,"en":"And one lion of a daughter."},{"id":"semetey-1-2013:p0713:b003:l026","ordinal":131501,"en":"The son she bore, heroic Manas,"},{"id":"semetey-1-2013:p0713:b003:l027","ordinal":131502,"en":"Became khan of a people dwelling together."},{"id":"semetey-1-2013:p0713:b003:l028","ordinal":131503,"en":"The daughter she bore, Kardygach,"},{"id":"semetey-1-2013:p0713:b003:l029","ordinal":131504,"en":"In her maiden days, the luckless one,"},{"id":"semetey-1-2013:p0713:b003:l030","ordinal":131505,"en":"Shook the ages and shattered peoples."},{"id":"semetey-1-2013:p0713:b003:l031","ordinal":131506,"en":"When she reached seventeen,"},{"id":"semetey-1-2013:p0713:b003:l032","ordinal":131507,"en":"She leveled her spear and broke the ranks."},{"id":"semetey-1-2013:p0713:b003:l033","ordinal":131508,"en":"The Kara Kalmyks she encountered,"},{"id":"semetey-1-2013:p0713:b003:l034","ordinal":131509,"en":"She shed their blood and laid them low."},{"id":"semetey-1-2013:p0713:b003:l035","ordinal":131510,"en":"On the downward slope she speared heroes,"},{"id":"semetey-1-2013:p0713:b003:l036","ordinal":131511,"en":"With heroic Zholoi at their head;"},{"id":"semetey-1-2013:p0713:b003:l037","ordinal":131512,"en":"Of the Kara Kalmyks and Manchus,"},{"id":"semetey-1-2013:p0713:b003:l038","ordinal":131513,"en":"She reached and speared seven at one stroke."},{"id":"semetey-1-2013:p0713:b003:l039","ordinal":131514,"en":"Before this girl's wrath,"},{"id":"semetey-1-2013:p0713:b005:l001","ordinal":131515,"en":"The people could not stand."},{"id":"semetey-1-2013:p0713:b005:l002","ordinal":131516,"en":"With Khan Kongurbai at their head,"},{"id":"semetey-1-2013:p0713:b005:l003","ordinal":131517,"en":"Of Chynmachyn and Beijing,"},{"id":"semetey-1-2013:p0713:b005:l004","ordinal":131518,"en":"The true khans wept."},{"id":"semetey-1-2013:p0713:b005:l005","ordinal":131519,"en":"Wrath poured from her brow;"},{"id":"semetey-1-2013:p0713:b005:l006","ordinal":131520,"en":"Those who faced her were split in two."},{"id":"semetey-1-2013:p0713:b005:l007","ordinal":131521,"en":"For Beijing's Chynchy Khan,"},{"id":"semetey-1-2013:p0713:b005:l008","ordinal":131522,"en":"And for the city of Kakan,"},{"id":"semetey-1-2013:p0713:b005:l009","ordinal":131523,"en":"She was inscribed in their records."},{"id":"semetey-1-2013:p0713:b005:l010","ordinal":131524,"en":"The Ile River, a great stream,"},{"id":"semetey-1-2013:p0713:b005:l011","ordinal":131525,"en":"They lay on either bank."},{"id":"semetey-1-2013:p0713:b005:l012","ordinal":131526,"en":"Six thousand Chinese and countless kaldai,"},{"id":"semetey-1-2013:p0713:b005:l013","ordinal":131527,"en":"Their elder Kongurbai,"},{"id":"semetey-1-2013:p0713:b005:l014","ordinal":131528,"en":"Heroic Toltoi riding Achbuudan,"},{"id":"semetey-1-2013:p0713:b005:l015","ordinal":131529,"en":"Ezkara with his great chestnut,"},{"id":"semetey-1-2013:p0713:b005:l016","ordinal":131530,"en":"Boroonchu riding Bozbuudan,"},{"id":"semetey-1-2013:p0713:b005:l017","ordinal":131531,"en":"The great giant on a gray mule,"},{"id":"semetey-1-2013:p0713:b005:l018","ordinal":131532,"en":"Ylama and their elder Shyikoo—"},{"id":"semetey-1-2013:p0713:b005:l019","ordinal":131533,"en":"Of the unbelievers of another faith,"},{"id":"semetey-1-2013:p0713:b005:l020","ordinal":131534,"en":"All their giants were there."},{"id":"semetey-1-2013:p0713:b005:l021","ordinal":131535,"en":"Skilled in drawing the bow,"},{"id":"semetey-1-2013:p0713:b005:l022","ordinal":131536,"en":"Karaboz riding a mule,"},{"id":"semetey-1-2013:p0713:b005:l023","ordinal":131537,"en":"He too the finest of the Shibee people,"},{"id":"semetey-1-2013:p0713:b005:l024","ordinal":131538,"en":"Bozkertik of the Solon,"},{"id":"semetey-1-2013:p0713:b005:l025","ordinal":131539,"en":"Shypshaidar of Sooronduk,"},{"id":"semetey-1-2013:p0713:b005:l026","ordinal":131540,"en":"All the Chinese massed together."},{"id":"semetey-1-2013:p0713:b005:l027","ordinal":131541,"en":"Of the Chinese spearmen,"},{"id":"semetey-1-2013:p0713:b005:l028","ordinal":131542,"en":"The finest massed together."},{"id":"semetey-1-2013:p0713:b005:l029","ordinal":131543,"en":"Standing on either bank,"},{"id":"semetey-1-2013:p0713:b005:l030","ordinal":131544,"en":"Unable to reach with their spears,"},{"id":"semetey-1-2013:p0713:b005:l031","ordinal":131545,"en":"They fought with muskets."},{"id":"semetey-1-2013:p0713:b005:l032","ordinal":131546,"en":"Blocking one another,"},{"id":"semetey-1-2013:p0713:b005:l033","ordinal":131547,"en":"They fired for nine days without cease."},{"id":"semetey-1-2013:p0713:b005:l034","ordinal":131548,"en":"While the warriors could not"},{"id":"semetey-1-2013:p0713:b005:l035","ordinal":131549,"en":"Gain upon one another,"},{"id":"semetey-1-2013:p0713:b005:l036","ordinal":131550,"en":"When Khan Zholoi's Achbuudan"},{"id":"semetey-1-2013:p0713:b005:l037","ordinal":131551,"en":"Leaped to the farther bank,"},{"id":"semetey-1-2013:p0713:b005:l038","ordinal":131552,"en":"The Chinese army shuddered:"},{"id":"semetey-1-2013:p0713:b005:l039","ordinal":131553,"en":"“This bitch is formidable,” they said."},{"id":"semetey-1-2013:p0714:b003:l001","ordinal":131554,"en":"The Kalmyk khan cried out,"},{"id":"semetey-1-2013:p0714:b003:l002","ordinal":131555,"en":"“She will not spare our lives, whatever happens;"},{"id":"semetey-1-2013:p0714:b003:l003","ordinal":131556,"en":"Alas, the girl will not spare our lives!”"},{"id":"semetey-1-2013:p0714:b003:l004","ordinal":131557,"en":"Girding a leather belt about her waist,"},{"id":"semetey-1-2013:p0714:b003:l005","ordinal":131558,"en":"Into the myriad Chinese,"},{"id":"semetey-1-2013:p0714:b003:l006","ordinal":131559,"en":"The fully accomplished, hapless Kardygach"},{"id":"semetey-1-2013:p0714:b003:l007","ordinal":131560,"en":"Rode upon Telkyzyl."},{"id":"semetey-1-2013:p0714:b003:l008","ordinal":131561,"en":"The Kara Kalmyks and Manchu people"},{"id":"semetey-1-2013:p0714:b003:l009","ordinal":131562,"en":"Could not withstand her wrath."},{"id":"semetey-1-2013:p0714:b003:l010","ordinal":131563,"en":"When Kardygach leveled her spear,"},{"id":"semetey-1-2013:p0714:b003:l011","ordinal":131564,"en":"Of the Chinese officials with hat buttons,"},{"id":"semetey-1-2013:p0714:b003:l012","ordinal":131565,"en":"The best of them fell."},{"id":"semetey-1-2013:p0714:b003:l013","ordinal":131566,"en":"Toppling the kaldai's banner,"},{"id":"semetey-1-2013:p0714:b003:l014","ordinal":131567,"en":"Spearing their khan and laying him low,"},{"id":"semetey-1-2013:p0714:b003:l015","ordinal":131568,"en":"Remaining steadfast,"},{"id":"semetey-1-2013:p0714:b003:l016","ordinal":131569,"en":"Fighting with guns for sixty days,"},{"id":"semetey-1-2013:p0714:b003:l017","ordinal":131570,"en":"She tormented the Chinese."},{"id":"semetey-1-2013:p0714:b003:l018","ordinal":131571,"en":"Then Chongtaman and the giant Dongkoi died."},{"id":"semetey-1-2013:p0714:b003:l019","ordinal":131572,"en":"Within that great battle,"},{"id":"semetey-1-2013:p0714:b003:l020","ordinal":131573,"en":"Pressing onward with courage,"},{"id":"semetey-1-2013:p0714:b003:l021","ordinal":131574,"en":"Kardygach's painted spear"},{"id":"semetey-1-2013:p0714:b003:l022","ordinal":131575,"en":"Was bathed in pitch-black blood."},{"id":"semetey-1-2013:p0714:b003:l023","ordinal":131576,"en":"When the Chinese wrought slaughter,"},{"id":"semetey-1-2013:p0714:b003:l024","ordinal":131577,"en":"“Of Manas, khan of the Kyrgyz,"},{"id":"semetey-1-2013:p0714:b003:l025","ordinal":131578,"en":"I shall seize the girls,” he said."},{"id":"semetey-1-2013:p0714:b003:l026","ordinal":131579,"en":"“I shall trample them from above,” he said."},{"id":"semetey-1-2013:p0714:b003:l027","ordinal":131580,"en":"“I shall scatter their four kinds of livestock,” he said."},{"id":"semetey-1-2013:p0714:b003:l028","ordinal":131581,"en":"“Of the babbling Burut,"},{"id":"semetey-1-2013:p0714:b003:l029","ordinal":131582,"en":"Raiding and taking their mares,"},{"id":"semetey-1-2013:p0714:b003:l030","ordinal":131583,"en":"If the Burut come near,"},{"id":"semetey-1-2013:p0714:b003:l031","ordinal":131584,"en":"I shall smash their brains asunder,” he said."}]
