[{"id":"semetey-1-2013:p0422:b004:l026","ordinal":109057,"en":"Riding far, sparing no horses."},{"id":"semetey-1-2013:p0422:b004:l027","ordinal":109058,"en":"Raising a white-and-dappled banner,"},{"id":"semetey-1-2013:p0422:b004:l028","ordinal":109059,"en":"Heading toward great Talas,"},{"id":"semetey-1-2013:p0422:b004:l029","ordinal":109060,"en":"Keeping watch and scouting the land,"},{"id":"semetey-1-2013:p0422:b004:l030","ordinal":109061,"en":"Taking forty-one men at his side,"},{"id":"semetey-1-2013:p0422:b004:l031","ordinal":109062,"en":"He troubled the hearts of those who saw him."},{"id":"semetey-1-2013:p0422:b004:l032","ordinal":109063,"en":"That dear man, shaped like a lion,"},{"id":"semetey-1-2013:p0422:b004:l033","ordinal":109064,"en":"Appeared like Ala-Too."},{"id":"semetey-1-2013:p0422:b004:l035","ordinal":109065,"en":"That dear man, born of boundless might,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0422:b004:l036","ordinal":109066,"en":"Licking his lips and nose,"},{"id":"semetey-1-2013:p0422:b004:l037","ordinal":109067,"en":"Wearing a blue rep-cloth coat,"},{"id":"semetey-1-2013:p0422:b004:l038","ordinal":109068,"en":"Riding a horse like Kökala,"},{"id":"semetey-1-2013:p0422:b004:l039","ordinal":109069,"en":"Taking on many fearsome forms,"},{"id":"semetey-1-2013:p0423:b003:l001","ordinal":109070,"en":"Gathering force like a lion,"},{"id":"semetey-1-2013:p0423:b003:l002","ordinal":109071,"en":"Troubling the hearts of those who saw him,"},{"id":"semetey-1-2013:p0423:b003:l003","ordinal":109072,"en":"His splendid teeth like doors,"},{"id":"semetey-1-2013:p0423:b003:l005","ordinal":109073,"en":"Talas is no equal to Ken-Kol.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0423:b003:l006","ordinal":109074,"en":"Khan Baltay's Chubak,"},{"id":"semetey-1-2013:p0423:b003:l007","ordinal":109075,"en":"If you look, is no less than Khan Manas."},{"id":"semetey-1-2013:p0423:b003:l008","ordinal":109076,"en":"Chubak, a son of humankind,"},{"id":"semetey-1-2013:p0423:b003:l009","ordinal":109077,"en":"Was no warrior to be belittled."},{"id":"semetey-1-2013:p0423:b003:l010","ordinal":109078,"en":"His protector was Kojosan;"},{"id":"semetey-1-2013:p0423:b003:l011","ordinal":109079,"en":"The teacher Chubak followed was Ak eshen."},{"id":"semetey-1-2013:p0423:b003:l012","ordinal":109080,"en":"Brave Chubak, like Ala-Too,"},{"id":"semetey-1-2013:p0423:b003:l013","ordinal":109081,"en":"Was coming on his way there."},{"id":"semetey-1-2013:p0423:b003:l014","ordinal":109082,"en":"Even if a flood covered the world,"},{"id":"semetey-1-2013:p0423:b003:l015","ordinal":109083,"en":"Your Chubak was a lion who would not stir."},{"id":"semetey-1-2013:p0423:b003:l016","ordinal":109084,"en":"“Who struck the enemy with a spear?"},{"id":"semetey-1-2013:p0423:b003:l017","ordinal":109085,"en":"The fame was left to Manas."},{"id":"semetey-1-2013:p0423:b003:l018","ordinal":109086,"en":"If there is a foe to come out fighting,"},{"id":"semetey-1-2013:p0423:b003:l019","ordinal":109087,"en":"Let me bring him grievous suffering."},{"id":"semetey-1-2013:p0423:b003:l020","ordinal":109088,"en":"Beside my generous sultan Manas,"},{"id":"semetey-1-2013:p0423:b003:l021","ordinal":109089,"en":"Let me make my camp."},{"id":"semetey-1-2013:p0423:b003:l022","ordinal":109090,"en":"My regret is bitter; my heart burns."},{"id":"semetey-1-2013:p0423:b003:l023","ordinal":109091,"en":"Who knows if it is false or true?"},{"id":"semetey-1-2013:p0423:b003:l024","ordinal":109092,"en":"Let me go to that great Keng-Kol.”"},{"id":"semetey-1-2013:p0423:b003:l025","ordinal":109093,"en":"Chubak journeyed without stopping."},{"id":"semetey-1-2013:p0423:b003:l026","ordinal":109094,"en":"Do not ask about the tiger's state—"},{"id":"semetey-1-2013:p0423:b003:l027","ordinal":109095,"en":"Akbaltay's wayward warrior,"},{"id":"semetey-1-2013:p0423:b003:l028","ordinal":109096,"en":"On account of his father,"},{"id":"semetey-1-2013:p0423:b003:l029","ordinal":109097,"en":"Decided to come to Talas,"},{"id":"semetey-1-2013:p0423:b003:l030","ordinal":109098,"en":"That valiant Chubak of yours."},{"id":"semetey-1-2013:p0423:b003:l031","ordinal":109099,"en":"Let me leave him thus for now,"},{"id":"semetey-1-2013:p0423:b003:l032","ordinal":109100,"en":"And your mother, unfortunate Kanykey's tale—"},{"id":"semetey-1-2013:p0423:b003:l034","ordinal":109101,"en":"Let me begin, leaving nothing out:"},{"id":"semetey-1-2013:p0423:b003:l035","ordinal":109102,"en":"When Kanykey was in her fortress,"},{"id":"semetey-1-2013:p0423:b003:l036","ordinal":109103,"en":"When your mother was neglected six months,"},{"id":"semetey-1-2013:p0423:b003:l037","ordinal":109104,"en":"When Alooke's Kongurbay"},{"id":"semetey-1-2013:p0423:b003:l038","ordinal":109105,"en":"And the six Chinese tribes would come,"},{"id":"semetey-1-2013:p0423:b003:l039","ordinal":109106,"en":"When your wretched mother learned of it,"},{"id":"semetey-1-2013:p0423:b004:l001","ordinal":109107,"en":"I moved apart to summer pasture."},{"id":"semetey-1-2013:p0423:b004:l002","ordinal":109108,"en":"Let me tell the other part:"},{"id":"semetey-1-2013:p0423:b004:l003","ordinal":109109,"en":"Your father's Akkula"},{"id":"semetey-1-2013:p0423:b004:l004","ordinal":109110,"en":"I tethered with my own hands."},{"id":"semetey-1-2013:p0423:b004:l005","ordinal":109111,"en":"Bringing him to perfect condition,"},{"id":"semetey-1-2013:p0423:b004:l006","ordinal":109112,"en":"I readied him for a true campaign."},{"id":"semetey-1-2013:p0423:b004:l007","ordinal":109113,"en":"I grieved and often wept."},{"id":"semetey-1-2013:p0423:b004:l008","ordinal":109114,"en":"Though he neglected me sixty times,"},{"id":"semetey-1-2013:p0423:b004:l009","ordinal":109115,"en":"My generous lord mounting Akkula,"},{"id":"semetey-1-2013:p0423:b004:l010","ordinal":109116,"en":"And entering battle—that was my wish."},{"id":"semetey-1-2013:p0423:b004:l011","ordinal":109117,"en":"I did not stand there idly then."},{"id":"semetey-1-2013:p0423:b004:l012","ordinal":109118,"en":"Your father's weapons—"},{"id":"semetey-1-2013:p0423:b004:l013","ordinal":109119,"en":"Gathering everything he had and lacked,"},{"id":"semetey-1-2013:p0423:b004:l014","ordinal":109120,"en":"I made them ready in the palace."},{"id":"semetey-1-2013:p0423:b004:l015","ordinal":109121,"en":"While your mother was doing this,"},{"id":"semetey-1-2013:p0423:b004:l016","ordinal":109122,"en":"With a cotton belt and broad boots,"},{"id":"semetey-1-2013:p0423:b004:l017","ordinal":109123,"en":"Kongurbay, khan of the tonsured ones,"},{"id":"semetey-1-2013:p0423:b004:l018","ordinal":109124,"en":"Brought twelve divisions of troops,"},{"id":"semetey-1-2013:p0423:b004:l019","ordinal":109125,"en":"Brought an iron-rope net."},{"id":"semetey-1-2013:p0423:b004:l020","ordinal":109126,"en":"His captains of ten bobbed along;"},{"id":"semetey-1-2013:p0423:b004:l021","ordinal":109127,"en":"The spearheads jutted up;"},{"id":"semetey-1-2013:p0423:b004:l022","ordinal":109128,"en":"Men's heads knocked together;"},{"id":"semetey-1-2013:p0423:b004:l023","ordinal":109129,"en":"The spearheads clashed."},{"id":"semetey-1-2013:p0423:b004:l024","ordinal":109130,"en":"“That lord of yours, childish Manas—"},{"id":"semetey-1-2013:p0423:b004:l025","ordinal":109131,"en":"I will trample on his head,"},{"id":"semetey-1-2013:p0423:b004:l026","ordinal":109132,"en":"I will scatter his four kinds of livestock."},{"id":"semetey-1-2013:p0423:b004:l027","ordinal":109133,"en":"Seizing his mares,"},{"id":"semetey-1-2013:p0423:b004:l028","ordinal":109134,"en":"If any of them come near,"},{"id":"semetey-1-2013:p0423:b004:l029","ordinal":109135,"en":"I'll smash their brains, laying them low."},{"id":"semetey-1-2013:p0423:b004:l030","ordinal":109136,"en":"I shall make the Kyrgyz pay"},{"id":"semetey-1-2013:p0423:b004:l031","ordinal":109137,"en":"For things from long ago."},{"id":"semetey-1-2013:p0423:b004:l032","ordinal":109138,"en":"I shall seize and bring him bound,"},{"id":"semetey-1-2013:p0423:b004:l033","ordinal":109139,"en":"That giant Manas, like Kambar."},{"id":"semetey-1-2013:p0423:b004:l034","ordinal":109140,"en":"If Manas acts stubbornly,"},{"id":"semetey-1-2013:p0423:b004:l035","ordinal":109141,"en":"I shall seize him without delay."},{"id":"semetey-1-2013:p0423:b004:l036","ordinal":109142,"en":"Into a dungeon forty rope-lengths deep"},{"id":"semetey-1-2013:p0423:b004:l037","ordinal":109143,"en":"I shall drive and cast him."},{"id":"semetey-1-2013:p0423:b004:l038","ordinal":109144,"en":"After that, the Kyrgyz—"},{"id":"semetey-1-2013:p0423:b004:l039","ordinal":109145,"en":"I shall raid their village and slaughter them."},{"id":"semetey-1-2013:p0424:b003:l001","ordinal":109146,"en":"With seven standards for banners,"},{"id":"semetey-1-2013:p0424:b003:l002","ordinal":109147,"en":"Alakoo's Kongurbay,"},{"id":"semetey-1-2013:p0424:b003:l003","ordinal":109148,"en":"With seventy thousand troops—"},{"id":"semetey-1-2013:p0424:b003:l004","ordinal":109149,"en":"Of the red-tufted Chinese,"},{"id":"semetey-1-2013:p0424:b003:l005","ordinal":109150,"en":"Then their mighty ones, ah, set out."},{"id":"semetey-1-2013:p0424:b003:l006","ordinal":109151,"en":"Of the jewel-wearing Chinese,"},{"id":"semetey-1-2013:p0424:b003:l007","ordinal":109152,"en":"The shaven-headed ones set out."},{"id":"semetey-1-2013:p0424:b003:l008","ordinal":109153,"en":"Of the jacket-wearing Kalmyks,"},{"id":"semetey-1-2013:p0424:b003:l009","ordinal":109154,"en":"The strong ones formed their ranks."},{"id":"semetey-1-2013:p0424:b003:l010","ordinal":109155,"en":"Of the armguard-wearing Manchus,"},{"id":"semetey-1-2013:p0424:b003:l011","ordinal":109156,"en":"Their officers formed their ranks."},{"id":"semetey-1-2013:p0424:b003:l012","ordinal":109157,"en":"Hearing the grave news,"},{"id":"semetey-1-2013:p0424:b003:l013","ordinal":109158,"en":"That Khan Baltay's Chubak"},{"id":"semetey-1-2013:p0424:b003:l014","ordinal":109159,"en":"Had fled, they heard;"},{"id":"semetey-1-2013:p0424:b003:l015","ordinal":109160,"en":"The treasury and gold coins"},{"id":"semetey-1-2013:p0424:b003:l016","ordinal":109161,"en":"He had scattered, they heard."},{"id":"semetey-1-2013:p0424:b003:l017","ordinal":109162,"en":"Ez kara, khan of the Manchus,"},{"id":"semetey-1-2013:p0424:b003:l018","ordinal":109163,"en":"They dressed in an unyielding coat,"},{"id":"semetey-1-2013:p0424:b003:l019","ordinal":109164,"en":"Mounted on the great brown horse,"},{"id":"semetey-1-2013:p0424:b003:l020","ordinal":109165,"en":"Gave ten thousand Manchu troops,"},{"id":"semetey-1-2013:p0424:b003:l021","ordinal":109166,"en":"And sent Ez kara forth."},{"id":"semetey-1-2013:p0424:b003:l022","ordinal":109167,"en":"Ah, a beaded cap-button, a coral stone,"},{"id":"semetey-1-2013:p0424:b003:l023","ordinal":109168,"en":"With their governor-khans among them,"},{"id":"semetey-1-2013:p0424:b003:l024","ordinal":109169,"en":"Who had gone on foot six years,"},{"id":"semetey-1-2013:p0424:b003:l025","ordinal":109170,"en":"Greased sixty spears,"},{"id":"semetey-1-2013:p0424:b003:l026","ordinal":109171,"en":"Slaughtered six thousand people—"},{"id":"semetey-1-2013:p0424:b003:l027","ordinal":109172,"en":"Khan Joloy, khan of the Kalmyks,"},{"id":"semetey-1-2013:p0424:b003:l028","ordinal":109173,"en":"They clothed in bulletproof armor,"},{"id":"semetey-1-2013:p0424:b003:l029","ordinal":109174,"en":"Mounted on Achbuudan,"},{"id":"semetey-1-2013:p0424:b003:l030","ordinal":109175,"en":"With a black cap and broad boots,"},{"id":"semetey-1-2013:p0424:b003:l031","ordinal":109176,"en":"Gave ten thousand Kalmyk troops,"},{"id":"semetey-1-2013:p0424:b003:l032","ordinal":109177,"en":"And sent Khan Joloy forth."},{"id":"semetey-1-2013:p0424:b003:l033","ordinal":109178,"en":"Much of his due remained with the people;"},{"id":"semetey-1-2013:p0424:b003:l034","ordinal":109179,"en":"If dusk caught him in the steppe,"},{"id":"semetey-1-2013:p0424:b003:l036","ordinal":109180,"en":"Orokkyr, khan of the Shibee,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0424:b003:l037","ordinal":109181,"en":"They dressed in a great black coat,"},{"id":"semetey-1-2013:p0424:b003:l038","ordinal":109182,"en":"Mounted on a great rhinoceros,"},{"id":"semetey-1-2013:p0424:b003:l039","ordinal":109183,"en":"Gave ten thousand Shibee troops,"},{"id":"semetey-1-2013:p0424:b004:l001","ordinal":109184,"en":"And sent Orokkyr forth."},{"id":"semetey-1-2013:p0424:b004:l002","ordinal":109185,"en":"Karykan, khan of Beijing,"},{"id":"semetey-1-2013:p0424:b004:l003","ordinal":109186,"en":"Whose temper had grown fiercely bitter,"},{"id":"semetey-1-2013:p0424:b004:l004","ordinal":109187,"en":"Issued stern commands to Beijing,"},{"id":"semetey-1-2013:p0424:b004:l005","ordinal":109188,"en":"Brought great terror upon his people,"},{"id":"semetey-1-2013:p0424:b004:l006","ordinal":109189,"en":"And red-whip Shypshaydar,"},{"id":"semetey-1-2013:p0424:b004:l007","ordinal":109190,"en":"The giant, he sent with them."},{"id":"semetey-1-2013:p0424:b004:l008","ordinal":109191,"en":"Tiken the mighty, Muzkindik's son—"},{"id":"semetey-1-2013:p0424:b004:l009","ordinal":109192,"en":"Then he sent the man on foot with them."},{"id":"semetey-1-2013:p0424:b004:l010","ordinal":109193,"en":"A flood, denser than the reeds,"},{"id":"semetey-1-2013:p0424:b004:l011","ordinal":109194,"en":"The seething Chinese thronged everywhere,"},{"id":"semetey-1-2013:p0424:b004:l012","ordinal":109195,"en":"Swarming like ants,"},{"id":"semetey-1-2013:p0424:b004:l013","ordinal":109196,"en":"Teeming more thickly than gnats."},{"id":"semetey-1-2013:p0424:b004:l014","ordinal":109197,"en":"See the reeds, see the flood!"},{"id":"semetey-1-2013:p0424:b004:l015","ordinal":109198,"en":"After lying down one night, behold—"},{"id":"semetey-1-2013:p0424:b004:l016","ordinal":109199,"en":"See the Chinese people swarming over us!"},{"id":"semetey-1-2013:p0424:b004:l017","ordinal":109200,"en":"Circling over our heads,"},{"id":"semetey-1-2013:p0424:b004:l018","ordinal":109201,"en":"When the Chinese in four great hosts descended,"},{"id":"semetey-1-2013:p0424:b004:l019","ordinal":109202,"en":"The Kyrgyz people lay asleep."},{"id":"semetey-1-2013:p0424:b004:l020","ordinal":109203,"en":"There were no lookouts or guards then."},{"id":"semetey-1-2013:p0424:b004:l021","ordinal":109204,"en":"When dark night falls upon one's hapless head,"},{"id":"semetey-1-2013:p0424:b004:l022","ordinal":109205,"en":"My colt, this is how it is—this shitty world!"},{"id":"semetey-1-2013:p0424:b004:l023","ordinal":109206,"en":"When Argyn and Kyrgyz sought the lowlands,"},{"id":"semetey-1-2013:p0424:b004:l024","ordinal":109207,"en":"And lay encamped,"},{"id":"semetey-1-2013:p0424:b004:l025","ordinal":109208,"en":"With kumys by day and girls by night,"},{"id":"semetey-1-2013:p0424:b004:l026","ordinal":109209,"en":"While this was going on,"},{"id":"semetey-1-2013:p0424:b004:l027","ordinal":109210,"en":"Wearing double marten-fur caps,"},{"id":"semetey-1-2013:p0424:b004:l028","ordinal":109211,"en":"Swaying at their ease,"},{"id":"semetey-1-2013:p0424:b004:l029","ordinal":109212,"en":"With no thought such a foe would come,"},{"id":"semetey-1-2013:p0424:b004:l030","ordinal":109213,"en":"While they enjoyed themselves,"},{"id":"semetey-1-2013:p0424:b004:l031","ordinal":109214,"en":"Whole otter skins"},{"id":"semetey-1-2013:p0424:b004:l032","ordinal":109215,"en":"They divided into halves,"},{"id":"semetey-1-2013:p0424:b004:l033","ordinal":109216,"en":"They used to trim their trouser legs."},{"id":"semetey-1-2013:p0424:b004:l034","ordinal":109217,"en":"When bored, they shot roe deer;"},{"id":"semetey-1-2013:p0424:b004:l035","ordinal":109218,"en":"If not bored, they lay in broad Talas."},{"id":"semetey-1-2013:p0424:b004:l036","ordinal":109219,"en":"There were no scouts, no lookouts."},{"id":"semetey-1-2013:p0424:b004:l037","ordinal":109220,"en":"The massed Chinese set out,"},{"id":"semetey-1-2013:p0424:b004:l038","ordinal":109221,"en":"Traveled along the Ili,"},{"id":"semetey-1-2013:p0424:b004:l039","ordinal":109222,"en":"And when they overran Ach-Maral,"},{"id":"semetey-1-2013:p0425:b003:l001","ordinal":109223,"en":"When they overran Ak-Ermen,"},{"id":"semetey-1-2013:p0425:b003:l002","ordinal":109224,"en":"When they scattered the four kinds of livestock,"},{"id":"semetey-1-2013:p0425:b003:l003","ordinal":109225,"en":"The Kyrgyz in Talas—"},{"id":"semetey-1-2013:p0425:b003:l004","ordinal":109226,"en":"Kongurbay of Beijing,"},{"id":"semetey-1-2013:p0425:b003:l005","ordinal":109227,"en":"In the middle of the night,"},{"id":"semetey-1-2013:p0425:b003:l006","ordinal":109228,"en":"Came upon them unprepared."},{"id":"semetey-1-2013:p0425:b003:l007","ordinal":109229,"en":"When they plundered the booty,"},{"id":"semetey-1-2013:p0425:b003:l008","ordinal":109230,"en":"When the Chinese wreaked havoc,"},{"id":"semetey-1-2013:p0425:b003:l009","ordinal":109231,"en":"When Argyn and Kyrgyz in Talas"},{"id":"semetey-1-2013:p0425:b003:l010","ordinal":109232,"en":"Suffered their bitter ordeal,"},{"id":"semetey-1-2013:p0425:b003:l012","ordinal":109233,"en":"When Khan Ormombek died,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0425:b003:l013","ordinal":109234,"en":"A gray-dappled pennon, a red banner—"},{"id":"semetey-1-2013:p0425:b003:l014","ordinal":109235,"en":"May God never turn such a sight upon you!"},{"id":"semetey-1-2013:p0425:b003:l015","ordinal":109236,"en":"Cries of “Woe!” and uproar,"},{"id":"semetey-1-2013:p0425:b003:l016","ordinal":109237,"en":"A white-dappled pennon, a red banner,"},{"id":"semetey-1-2013:p0425:b003:l017","ordinal":109238,"en":"Shrill cries and uproar,"},{"id":"semetey-1-2013:p0425:b003:l018","ordinal":109239,"en":"Unable to find their bearings,"},{"id":"semetey-1-2013:p0425:b003:l019","ordinal":109240,"en":"The Kyrgyz fled in confusion."},{"id":"semetey-1-2013:p0425:b003:l020","ordinal":109241,"en":"“Take us with our faith intact,” they prayed,"},{"id":"semetey-1-2013:p0425:b003:l021","ordinal":109242,"en":"Preparing themselves for death."},{"id":"semetey-1-2013:p0425:b003:l022","ordinal":109243,"en":"Aziz Khan's Almambet,"},{"id":"semetey-1-2013:p0425:b003:l023","ordinal":109244,"en":"Brave Bakay of wise counsel,"},{"id":"semetey-1-2013:p0425:b003:l024","ordinal":109245,"en":"Argyn Khan's Ajybay,"},{"id":"semetey-1-2013:p0425:b003:l025","ordinal":109246,"en":"Ulakhan's Syrgak—"},{"id":"semetey-1-2013:p0425:b003:l026","ordinal":109247,"en":"Whom no mortal could withstand—"},{"id":"semetey-1-2013:p0425:b003:l027","ordinal":109248,"en":"Entering the battle then,"},{"id":"semetey-1-2013:p0425:b003:l028","ordinal":109249,"en":"The Four Lions stood firm."},{"id":"semetey-1-2013:p0425:b003:l029","ordinal":109250,"en":"The spear's point bent;"},{"id":"semetey-1-2013:p0425:b003:l030","ordinal":109251,"en":"Your uncle Bakay fought with his spear."},{"id":"semetey-1-2013:p0425:b003:l031","ordinal":109252,"en":"Aziz Khan's Almambet,"},{"id":"semetey-1-2013:p0425:b003:l032","ordinal":109253,"en":"Who had studied sorcery,"},{"id":"semetey-1-2013:p0425:b003:l033","ordinal":109254,"en":"Turned a summer's day to winter."},{"id":"semetey-1-2013:p0425:b003:l034","ordinal":109255,"en":"The thinly clad Chinese"},{"id":"semetey-1-2013:p0425:b003:l035","ordinal":109256,"en":"He made whimper like girls."},{"id":"semetey-1-2013:p0425:b003:l036","ordinal":109257,"en":"Defending the Kyrgyz at death's door,"},{"id":"semetey-1-2013:p0425:b003:l037","ordinal":109258,"en":"My precious Almam stood firm."},{"id":"semetey-1-2013:p0425:b003:l038","ordinal":109259,"en":"Girding his battle belt about his waist,"},{"id":"semetey-1-2013:p0425:b003:l039","ordinal":109260,"en":"Ulakhan's Syrgak,"},{"id":"semetey-1-2013:p0425:b005:l001","ordinal":109261,"en":"Against seventy thousand Kalmyks,"},{"id":"semetey-1-2013:p0425:b005:l002","ordinal":109262,"en":"Attacked, plunging in alone."},{"id":"semetey-1-2013:p0425:b005:l003","ordinal":109263,"en":"The Chinese were a multitude; he was alone."},{"id":"semetey-1-2013:p0425:b005:l004","ordinal":109264,"en":"What could he do against God's will?"},{"id":"semetey-1-2013:p0425:b005:l005","ordinal":109265,"en":"Look at the ants, look at the worms!"},{"id":"semetey-1-2013:p0425:b005:l006","ordinal":109266,"en":"Look at the Chinese, as numerous as worms!"},{"id":"semetey-1-2013:p0425:b005:l007","ordinal":109267,"en":"Forty Chinese tribes, countless warriors,"},{"id":"semetey-1-2013:p0425:b005:l008","ordinal":109268,"en":"Descended in the night."},{"id":"semetey-1-2013:p0425:b005:l009","ordinal":109269,"en":"Much sorrow remained for your father Manas."},{"id":"semetey-1-2013:p0425:b005:l010","ordinal":109270,"en":"Their fangs jutting out,"},{"id":"semetey-1-2013:p0425:b005:l011","ordinal":109271,"en":"Horse carcasses fell in mountains."},{"id":"semetey-1-2013:p0425:b005:l012","ordinal":109272,"en":"Their mustaches bristling,"},{"id":"semetey-1-2013:p0425:b005:l013","ordinal":109273,"en":"Warriors' corpses fell in bundles."},{"id":"semetey-1-2013:p0425:b005:l014","ordinal":109274,"en":"The Kyrgyz fled in confusion."},{"id":"semetey-1-2013:p0425:b005:l015","ordinal":109275,"en":"Your father lay asleep."},{"id":"semetey-1-2013:p0425:b005:l016","ordinal":109276,"en":"They begged Khan Manas:"},{"id":"semetey-1-2013:p0425:b005:l017","ordinal":109277,"en":"“Alas, fierce one, what will you do?"},{"id":"semetey-1-2013:p0425:b005:l018","ordinal":109278,"en":"Four Chinese tribes made ready,"},{"id":"semetey-1-2013:p0425:b005:l019","ordinal":109279,"en":"And fell upon our heads;"},{"id":"semetey-1-2013:p0425:b005:l020","ordinal":109280,"en":"They scattered the four kinds of livestock."},{"id":"semetey-1-2013:p0425:b005:l021","ordinal":109281,"en":"Show them something extraordinary!"},{"id":"semetey-1-2013:p0425:b005:l022","ordinal":109282,"en":"These dear people standing here—"},{"id":"semetey-1-2013:p0425:b005:l023","ordinal":109283,"en":"If you truly are our khan,"},{"id":"semetey-1-2013:p0425:b005:l024","ordinal":109284,"en":"Rescue us!” they cried."},{"id":"semetey-1-2013:p0425:b005:l025","ordinal":109285,"en":"The Kyrgyz wept and sobbed,"},{"id":"semetey-1-2013:p0425:b005:l026","ordinal":109286,"en":"Their girls and women screamed,"},{"id":"semetey-1-2013:p0425:b005:l027","ordinal":109287,"en":"When they came to your father, the childlike lion."},{"id":"semetey-1-2013:p0425:b005:l028","ordinal":109288,"en":"Your father, Manas the panther,"},{"id":"semetey-1-2013:p0425:b005:l029","ordinal":109289,"en":"Ran in just his shirt, with great strides,"},{"id":"semetey-1-2013:p0425:b005:l030","ordinal":109290,"en":"Barefoot, bareheaded,"},{"id":"semetey-1-2013:p0425:b005:l031","ordinal":109291,"en":"Bare, without his bulletproof armor,"},{"id":"semetey-1-2013:p0425:b005:l032","ordinal":109292,"en":"Taking a yurt-propping pole in his hand."},{"id":"semetey-1-2013:p0425:b005:l033","ordinal":109293,"en":"“My suffering has come; let me bear it."},{"id":"semetey-1-2013:p0425:b005:l034","ordinal":109294,"en":"At least let me take an enemy down with me!”"},{"id":"semetey-1-2013:p0425:b005:l035","ordinal":109295,"en":"Your father grieved and muttered,"},{"id":"semetey-1-2013:p0425:b005:l036","ordinal":109296,"en":"Wailing as he spoke his last wishes,"},{"id":"semetey-1-2013:p0425:b005:l037","ordinal":109297,"en":"Running on foot, without a horse,"},{"id":"semetey-1-2013:p0425:b005:l038","ordinal":109298,"en":"Giving up hope of his life held in trust."},{"id":"semetey-1-2013:p0425:b005:l039","ordinal":109299,"en":"“Ah, alas, this treacherous, false world,"},{"id":"semetey-1-2013:p0426:b003:l001","ordinal":109300,"en":"My foolishness is flawless."},{"id":"semetey-1-2013:p0426:b003:l002","ordinal":109301,"en":"The foal of a young mare,"},{"id":"semetey-1-2013:p0426:b003:l003","ordinal":109302,"en":"The tireless steed among horses,"},{"id":"semetey-1-2013:p0426:b003:l004","ordinal":109303,"en":"Akkula the courser is not here."},{"id":"semetey-1-2013:p0426:b003:l005","ordinal":109304,"en":"Was this your nature, shitty world?!"},{"id":"semetey-1-2013:p0426:b003:l006","ordinal":109305,"en":"Alakoo's Kongurbay"},{"id":"semetey-1-2013:p0426:b003:l007","ordinal":109306,"en":"Will roar and strike with his spear."},{"id":"semetey-1-2013:p0426:b003:l008","ordinal":109307,"en":"Red-whip Shypshaydar"},{"id":"semetey-1-2013:p0426:b003:l009","ordinal":109308,"en":"Was a mighty giant;"},{"id":"semetey-1-2013:p0426:b003:l010","ordinal":109309,"en":"He will seize me now."},{"id":"semetey-1-2013:p0426:b003:l011","ordinal":109310,"en":"Ez kara, khan of the Manchus,"},{"id":"semetey-1-2013:p0426:b003:l012","ordinal":109311,"en":"Will have me dragged along the road,"},{"id":"semetey-1-2013:p0426:b003:l013","ordinal":109312,"en":"And torn apart for the great dogs!"}]
