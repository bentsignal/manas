[{"id":"semetey-1-2013:p1011:b005:l026","ordinal":153345,"en":"Were there beginning their games."},{"id":"semetey-1-2013:p1011:b005:l027","ordinal":153346,"en":"In their midst Aychurok"},{"id":"semetey-1-2013:p1011:b005:l028","ordinal":153347,"en":"Flashed like a poppy."},{"id":"semetey-1-2013:p1011:b005:l029","ordinal":153348,"en":"The poor, formidable beauty's"},{"id":"semetey-1-2013:p1011:b005:l030","ordinal":153349,"en":"Fitted coat and fine dress"},{"id":"semetey-1-2013:p1011:b005:l031","ordinal":153350,"en":"Showed their hems billowing."},{"id":"semetey-1-2013:p1011:b005:l032","ordinal":153351,"en":"Aychurok, daughter of Akun,"},{"id":"semetey-1-2013:p1011:b005:l033","ordinal":153352,"en":"Wore a skullcap made of gold;"},{"id":"semetey-1-2013:p1011:b005:l034","ordinal":153353,"en":"She appeared worth the whole world,"},{"id":"semetey-1-2013:p1011:b005:l035","ordinal":153354,"en":"That poor daughter of Akun."},{"id":"semetey-1-2013:p1011:b005:l036","ordinal":153355,"en":"Of moon-beautiful Churok,"},{"id":"semetey-1-2013:p1011:b005:l037","ordinal":153356,"en":"Which enchantment shall we tell?"},{"id":"semetey-1-2013:p1011:b005:l038","ordinal":153357,"en":"When snow falls upon black earth,"},{"id":"semetey-1-2013:p1011:b005:l039","ordinal":153358,"en":"Look at the snow, and you see her flesh;"}]
