[{"id":"semetey-1-2013:p0988:b003:l030","ordinal":151553,"en":"She was the one who began the tumult."},{"id":"semetey-1-2013:p0988:b003:l031","ordinal":151554,"en":"Last night, on the holy night of Friday,"},{"id":"semetey-1-2013:p0988:b003:l032","ordinal":151555,"en":"On the Thursday evening,"},{"id":"semetey-1-2013:p0988:b003:l033","ordinal":151556,"en":"We stood casting stones at one another"},{"id":"semetey-1-2013:p0988:b003:l034","ordinal":151557,"en":"And fought without yielding."},{"id":"semetey-1-2013:p0988:b003:l035","ordinal":151558,"en":"Aychurok flew out over the land,"},{"id":"semetey-1-2013:p0988:b003:l036","ordinal":151559,"en":"Surely to test the thoroughbred,"},{"id":"semetey-1-2013:p0988:b003:l037","ordinal":151560,"en":"And has carried away"},{"id":"semetey-1-2013:p0988:b003:l038","ordinal":151561,"en":"Semetey's falcon.\""},{"id":"semetey-1-2013:p0988:b003:l039","ordinal":151562,"en":"I shall drive seven hundred red camels,"},{"id":"semetey-1-2013:p0988:b004:l001","ordinal":151563,"en":"And livestock enough to cover the earth."},{"id":"semetey-1-2013:p0988:b004:l002","ordinal":151564,"en":"If I do not braid every tail,"},{"id":"semetey-1-2013:p0988:b004:l003","ordinal":151565,"en":"If this year I do not behold"},{"id":"semetey-1-2013:p0988:b004:l004","ordinal":151566,"en":"The face of Akun, to whom I am betrothed;"},{"id":"semetey-1-2013:p0988:b004:l005","ordinal":151567,"en":"If I do not drive seven thousand"},{"id":"semetey-1-2013:p0988:b004:l006","ordinal":151568,"en":"Bay horses as the sister-in-law's gift,"},{"id":"semetey-1-2013:p0988:b004:l007","ordinal":151569,"en":"And well-fed gray camels"},{"id":"semetey-1-2013:p0988:b004:l008","ordinal":151570,"en":"Whose trailing breast hair sweeps the ground;"},{"id":"semetey-1-2013:p0988:b004:l009","ordinal":151571,"en":"He had a hand strong enough to take her,"},{"id":"semetey-1-2013:p0988:b004:l010","ordinal":151572,"en":"And he was himself the khan of Afghanistan."},{"id":"semetey-1-2013:p0988:b004:l011","ordinal":151573,"en":"If I do not give them as her bride-price,"},{"id":"semetey-1-2013:p0988:b004:l012","ordinal":151574,"en":"If this year I do not behold"},{"id":"semetey-1-2013:p0988:b004:l013","ordinal":151575,"en":"The face of blessed Akun;"},{"id":"semetey-1-2013:p0988:b004:l014","ordinal":151576,"en":"If I do not win for my hero Semetey"},{"id":"semetey-1-2013:p0988:b004:l015","ordinal":151577,"en":"The noble-born Churok,"},{"id":"semetey-1-2013:p0988:b004:l016","ordinal":151578,"en":"That serene beauty—"},{"id":"semetey-1-2013:p0988:b004:l017","ordinal":151579,"en":"The knowing speak at length,"},{"id":"semetey-1-2013:p0988:b004:l018","ordinal":151580,"en":"Saying, \"Churok is the fairy's daughter\";"},{"id":"semetey-1-2013:p0988:b004:l019","ordinal":151581,"en":"The ignorant repeat tales,"},{"id":"semetey-1-2013:p0988:b004:l020","ordinal":151582,"en":"Saying she has stirred turmoil"},{"id":"semetey-1-2013:p0988:b004:l021","ordinal":151583,"en":"Throughout the whole wide world."},{"id":"semetey-1-2013:p0988:b004:l022","ordinal":151584,"en":"Those who beheld her beauty"},{"id":"semetey-1-2013:p0988:b004:l023","ordinal":151585,"en":"Made claims upon Khan Akun"},{"id":"semetey-1-2013:p0988:b004:l024","ordinal":151586,"en":"For Churok from every foreign land."},{"id":"semetey-1-2013:p0988:b004:l025","ordinal":151587,"en":"\"Give us your grown daughter,\" they said;"},{"id":"semetey-1-2013:p0988:b004:l026","ordinal":151588,"en":"None who heard the report let the matter rest,"},{"id":"semetey-1-2013:p0988:b004:l027","ordinal":151589,"en":"And countless giants pressed their claims."},{"id":"semetey-1-2013:p0988:b004:l028","ordinal":151590,"en":"Even then, it was she"},{"id":"semetey-1-2013:p0988:b004:l029","ordinal":151591,"en":"Who kept poor Akun's head unharmed."},{"id":"semetey-1-2013:p0988:b004:l030","ordinal":151592,"en":"Many times we conquered Afghanistan,"},{"id":"semetey-1-2013:p0988:b004:l031","ordinal":151593,"en":"That sprawling black-walled city;"},{"id":"semetey-1-2013:p0988:b004:l032","ordinal":151594,"en":"The great khan who gave his word"},{"id":"semetey-1-2013:p0988:b004:l033","ordinal":151595,"en":"Possessed sacred authority."},{"id":"semetey-1-2013:p0988:b004:l034","ordinal":151596,"en":"Send my greetings to Semetey."},{"id":"semetey-1-2013:p0988:b004:l035","ordinal":151597,"en":"Tell him plainly, without reserve,"},{"id":"semetey-1-2013:p0988:b004:l036","ordinal":151598,"en":"That his hero's Akshunkar"},{"id":"semetey-1-2013:p0988:b004:l037","ordinal":151599,"en":"Was carried away"},{"id":"semetey-1-2013:p0988:b004:l038","ordinal":151600,"en":"To the city of Akyn Khan."},{"id":"semetey-1-2013:p0988:b004:l039","ordinal":151601,"en":"That was Churok herself."}]
