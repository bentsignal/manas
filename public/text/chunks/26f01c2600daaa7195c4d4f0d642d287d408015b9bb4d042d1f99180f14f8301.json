[{"id":"semetey-1-2013:p0991:b004:l026","ordinal":151809,"en":"Poor lord, listen to us—"},{"id":"semetey-1-2013:p0991:b004:l027","ordinal":151810,"en":"If you would destroy us, here we stand!"},{"id":"semetey-1-2013:p0991:b004:l028","ordinal":151811,"en":"If you send us, the road of the journey is here;"},{"id":"semetey-1-2013:p0991:b004:l029","ordinal":151812,"en":"If you pour out your fury, lord, here we stand!\""},{"id":"semetey-1-2013:p0991:b004:l030","ordinal":151813,"en":"The young lord was a tiger,"},{"id":"semetey-1-2013:p0991:b004:l031","ordinal":151814,"en":"A saint born greater still"},{"id":"semetey-1-2013:p0991:b004:l032","ordinal":151815,"en":"Than his father, gray-maned Manas."},{"id":"semetey-1-2013:p0991:b004:l033","ordinal":151816,"en":"He hung close around his neck"},{"id":"semetey-1-2013:p0991:b004:l034","ordinal":151817,"en":"The gray purse left by Manas."},{"id":"semetey-1-2013:p0991:b004:l035","ordinal":151818,"en":"That poor lion, speaking timidly,"},{"id":"semetey-1-2013:p0991:b004:l036","ordinal":151819,"en":"Appealed to his young men;"},{"id":"semetey-1-2013:p0991:b004:l037","ordinal":151820,"en":"Showing that he was their lord,"},{"id":"semetey-1-2013:p0991:b004:l038","ordinal":151821,"en":"He placed Kulchoro on his right,"},{"id":"semetey-1-2013:p0991:b004:l039","ordinal":151822,"en":"And Kanchoro on his left,"}]
