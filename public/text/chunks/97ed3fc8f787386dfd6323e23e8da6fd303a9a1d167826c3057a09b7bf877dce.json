[{"id":"semetey-1-2013:p1312:b003:l028","ordinal":176385,"en":"And took him away as spoil."},{"id":"semetey-1-2013:p1312:b003:l029","ordinal":176386,"en":"He pursued and caught him;"},{"id":"semetey-1-2013:p1312:b003:l030","ordinal":176387,"en":"His anger flared greatly."},{"id":"semetey-1-2013:p1312:b003:l031","ordinal":176388,"en":"The lion-prince, that brave man,"},{"id":"semetey-1-2013:p1312:b003:l032","ordinal":176389,"en":"Thinking of nothing else,"},{"id":"semetey-1-2013:p1312:b003:l033","ordinal":176390,"en":"Put on the splendid Kyrgyz saddle."},{"id":"semetey-1-2013:p1312:b003:l034","ordinal":176391,"en":"Because of this, Surkoyon"},{"id":"semetey-1-2013:p1312:b003:l035","ordinal":176392,"en":"Kept vengeance in his heart, saying,"},{"id":"semetey-1-2013:p1312:b003:l036","ordinal":176393,"en":"“I will meet you in a place of hardship.”"},{"id":"semetey-1-2013:p1312:b003:l037","ordinal":176394,"en":"Taking the narrow road as a shortcut,"},{"id":"semetey-1-2013:p1312:b003:l038","ordinal":176395,"en":"Leading Arbuurul,"},{"id":"semetey-1-2013:p1312:b003:l039","ordinal":176396,"en":"Their elder brother came escorting them."},{"id":"semetey-1-2013:p1312:b004:l001","ordinal":176397,"en":"When the two choros saw him,"},{"id":"semetey-1-2013:p1312:b004:l002","ordinal":176398,"en":"The two choros begged for a gift,"},{"id":"semetey-1-2013:p1312:b004:l003","ordinal":176399,"en":"Their knees bending toward the ground,"},{"id":"semetey-1-2013:p1312:b004:l004","ordinal":176400,"en":"And both ran side by side."},{"id":"semetey-1-2013:p1312:b004:l005","ordinal":176401,"en":"Their stirrups struck together."},{"id":"semetey-1-2013:p1312:b004:l006","ordinal":176402,"en":"“Uncle whom I hold in a father's place,"},{"id":"semetey-1-2013:p1312:b004:l007","ordinal":176403,"en":"My uncle like a father, give him to me,” they said."},{"id":"semetey-1-2013:p1312:b004:l008","ordinal":176404,"en":"“Placed before me, he would be good fortune;"},{"id":"semetey-1-2013:p1312:b004:l009","ordinal":176405,"en":"Placed behind me, he would be like a vast army."},{"id":"semetey-1-2013:p1312:b004:l010","ordinal":176406,"en":"Uncle, give him to me as a gift,” they said."},{"id":"semetey-1-2013:p1312:b004:l011","ordinal":176407,"en":"Both ran side by side,"},{"id":"semetey-1-2013:p1312:b004:l012","ordinal":176408,"en":"Bounding like roe deer,"},{"id":"semetey-1-2013:p1312:b004:l013","ordinal":176409,"en":"And the two raced up."},{"id":"semetey-1-2013:p1312:b004:l014","ordinal":176410,"en":"He swung the knotted reins"},{"id":"semetey-1-2013:p1312:b004:l015","ordinal":176411,"en":"Back toward Külchoro"},{"id":"semetey-1-2013:p1312:b004:l016","ordinal":176412,"en":"And tossed them."},{"id":"semetey-1-2013:p1312:b004:l017","ordinal":176413,"en":"Before Kanchoro, Külchoro"},{"id":"semetey-1-2013:p1312:b004:l018","ordinal":176414,"en":"Was the first to take the reins."},{"id":"semetey-1-2013:p1312:b004:l019","ordinal":176415,"en":"At this, Kanchoro"},{"id":"semetey-1-2013:p1312:b004:l020","ordinal":176416,"en":"Thought, “Father, curse you,”"},{"id":"semetey-1-2013:p1312:b004:l021","ordinal":176417,"en":"And resentment remained in his heart."},{"id":"semetey-1-2013:p1312:b004:l022","ordinal":176418,"en":"“He does not regard me as he does Külchoro,” he thought;"},{"id":"semetey-1-2013:p1312:b004:l023","ordinal":176419,"en":"“Father, empty-headed butcher, curse you,”"},{"id":"semetey-1-2013:p1312:b004:l024","ordinal":176420,"en":"He muttered without saying it openly,"},{"id":"semetey-1-2013:p1312:b004:l025","ordinal":176421,"en":"Seething behind them."},{"id":"semetey-1-2013:p1312:b004:l026","ordinal":176422,"en":"I will find the waist you have girded,"},{"id":"semetey-1-2013:p1312:b004:l027","ordinal":176423,"en":"Find the place where you lie entrenched,"},{"id":"semetey-1-2013:p1312:b004:l028","ordinal":176424,"en":"And destroy what you had before;"},{"id":"semetey-1-2013:p1312:b004:l029","ordinal":176425,"en":"I will unleash calamity upon you!"},{"id":"semetey-1-2013:p1312:b004:l030","ordinal":176426,"en":"I will set fire to your home;"},{"id":"semetey-1-2013:p1312:b004:l031","ordinal":176427,"en":"Brooding and waiting,"},{"id":"semetey-1-2013:p1312:b004:l032","ordinal":176428,"en":"My butcher, one day I will reach your end!"},{"id":"semetey-1-2013:p1312:b004:l033","ordinal":176429,"en":"I will break open your treasury;"},{"id":"semetey-1-2013:p1312:b004:l034","ordinal":176430,"en":"Upon Buurul whom you deny when asked,"},{"id":"semetey-1-2013:p1312:b004:l035","ordinal":176431,"en":"I will cast a cold lasso."},{"id":"semetey-1-2013:p1312:b004:l036","ordinal":176432,"en":"I will tighten your tether,"},{"id":"semetey-1-2013:p1312:b004:l037","ordinal":176433,"en":"And tirelessly load your burdens."},{"id":"semetey-1-2013:p1312:b004:l038","ordinal":176434,"en":"I will abandon you and get away,"},{"id":"semetey-1-2013:p1312:b004:l039","ordinal":176435,"en":"And rummage through one of your bags."},{"id":"semetey-1-2013:p1312:b004:l040","ordinal":176436,"en":"I will strike your caravan from Keng-Kol,"},{"id":"semetey-1-2013:p1313:b003:l001","ordinal":176437,"en":"From the swaggering villain,"},{"id":"semetey-1-2013:p1313:b003:l002","ordinal":176438,"en":"I will take my revenge!”"},{"id":"semetey-1-2013:p1313:b003:l003","ordinal":176439,"en":"His mind turned elsewhere,"},{"id":"semetey-1-2013:p1313:b003:l004","ordinal":176440,"en":"And the treachery of the swaggering butcher"},{"id":"semetey-1-2013:p1313:b003:l005","ordinal":176441,"en":"Became apparent."},{"id":"semetey-1-2013:p1313:b003:l006","ordinal":176442,"en":"Their quarrel was over a horse,"},{"id":"semetey-1-2013:p1313:b003:l007","ordinal":176443,"en":"And Kanchoro became estranged."},{"id":"semetey-1-2013:p1313:b003:l008","ordinal":176444,"en":"With his eyes clouded,"},{"id":"semetey-1-2013:p1313:b003:l009","ordinal":176445,"en":"Kanchoro came to seek a fight."},{"id":"semetey-1-2013:p1313:b003:l010","ordinal":176446,"en":"He grieved over Surkoyon,"},{"id":"semetey-1-2013:p1313:b003:l011","ordinal":176447,"en":"And in the end became an enemy."},{"id":"semetey-1-2013:p1313:b003:l012","ordinal":176448,"en":"All the Jediger"},{"id":"semetey-1-2013:p1313:b003:l013","ordinal":176449,"en":"Were slaughtered by the blue-maned wolf,"},{"id":"semetey-1-2013:p1313:b003:l014","ordinal":176450,"en":"Both Chynkojo and old Toltoy."},{"id":"semetey-1-2013:p1313:b003:l015","ordinal":176451,"en":"They had quarreled precisely"},{"id":"semetey-1-2013:p1313:b003:l016","ordinal":176452,"en":"Over Akun's daughter Ayçürök,"},{"id":"semetey-1-2013:p1313:b003:l017","ordinal":176453,"en":"And all were slaughtered."},{"id":"semetey-1-2013:p1313:b003:l018","ordinal":176454,"en":"Among the great Afghan people,"},{"id":"semetey-1-2013:p1313:b003:l019","ordinal":176455,"en":"The best at taking spoil"},{"id":"semetey-1-2013:p1313:b003:l020","ordinal":176456,"en":"Took six hundred horses each;"},{"id":"semetey-1-2013:p1313:b003:l021","ordinal":176457,"en":"The lesser men who could not seize as much"},{"id":"semetey-1-2013:p1313:b003:l022","ordinal":176458,"en":"Took sixty horses each."},{"id":"semetey-1-2013:p1313:b003:l023","ordinal":176459,"en":"The accomplished blue-maned wolves"},{"id":"semetey-1-2013:p1313:b004:l001","ordinal":176460,"en":"Took seven hundred spoils each."},{"id":"semetey-1-2013:p1313:b004:l002","ordinal":176461,"en":"The lesser men who could not reach them"},{"id":"semetey-1-2013:p1313:b004:l003","ordinal":176462,"en":"Took seventy spoils each."},{"id":"semetey-1-2013:p1313:b004:l004","ordinal":176463,"en":"They struck the Jediger and took cloth,"},{"id":"semetey-1-2013:p1313:b004:l005","ordinal":176464,"en":"Loaded cloth and took gold coins."},{"id":"semetey-1-2013:p1313:b004:l006","ordinal":176465,"en":"As spoil from that people,"},{"id":"semetey-1-2013:p1313:b004:l007","ordinal":176466,"en":"They took five girls with braided forelocks."},{"id":"semetey-1-2013:p1313:b004:l008","ordinal":176467,"en":"There was honor among all who knew;"},{"id":"semetey-1-2013:p1313:b004:l009","ordinal":176468,"en":"Khan Akun's Afghanistan,"},{"id":"semetey-1-2013:p1313:b004:l010","ordinal":176469,"en":"Saying, “Our hostile enemy is dead,”"},{"id":"semetey-1-2013:p1313:b004:l011","ordinal":176470,"en":"Set its heart at ease and was fulfilled."},{"id":"semetey-1-2013:p1313:b004:l012","ordinal":176471,"en":"They slaughtered a mare for Babadin,"},{"id":"semetey-1-2013:p1313:b004:l013","ordinal":176472,"en":"And in their joy scattered"},{"id":"semetey-1-2013:p1313:b004:l014","ordinal":176473,"en":"Yellow gold from the treasury."},{"id":"semetey-1-2013:p1313:b004:l015","ordinal":176474,"en":"Old Akun of Afghanistan"},{"id":"semetey-1-2013:p1313:b004:l016","ordinal":176475,"en":"Climbed atop the tower"},{"id":"semetey-1-2013:p1313:b004:l017","ordinal":176476,"en":"And made a proclamation."},{"id":"semetey-1-2013:p1313:b004:l018","ordinal":176477,"en":"After God had truly bestowed his favor,"},{"id":"semetey-1-2013:p1313:b004:l019","ordinal":176478,"en":"After he had seen Semetey,"},{"id":"semetey-1-2013:p1313:b004:l020","ordinal":176479,"en":"“My dear, great people,"},{"id":"semetey-1-2013:p1313:b004:l021","ordinal":176480,"en":"Now that my extinguished fire has kindled,"},{"id":"semetey-1-2013:p1313:b004:l022","ordinal":176481,"en":"I have resolved in joy:"},{"id":"semetey-1-2013:p1313:b004:l023","ordinal":176482,"en":"I will hold Chürök's wedding feast."},{"id":"semetey-1-2013:p1313:b006:l001","ordinal":176483,"en":"“I will slaughter ninety sheep for the feast,"},{"id":"semetey-1-2013:p1313:b006:l002","ordinal":176484,"en":"And slaughter all fitting animals as offerings."},{"id":"semetey-1-2013:p1313:b006:l003","ordinal":176485,"en":"I will gather the multitude,"},{"id":"semetey-1-2013:p1313:b006:l004","ordinal":176486,"en":"And make merry to gladden the people;"},{"id":"semetey-1-2013:p1313:b006:l005","ordinal":176487,"en":"For Ayçürök and Semetey,"},{"id":"semetey-1-2013:p1313:b006:l006","ordinal":176488,"en":"For these two I will hold a wedding feast."},{"id":"semetey-1-2013:p1313:b006:l007","ordinal":176489,"en":"My child Ayçürök,"},{"id":"semetey-1-2013:p1313:b006:l008","ordinal":176490,"en":"Yesterday, when my beard was already white,"},{"id":"semetey-1-2013:p1313:b006:l009","ordinal":176491,"en":"While I was on a journey,"},{"id":"semetey-1-2013:p1313:b006:l010","ordinal":176492,"en":"In the desert of Mediyan,"},{"id":"semetey-1-2013:p1313:b006:l011","ordinal":176493,"en":"At the shrine of Babadin,"},{"id":"semetey-1-2013:p1313:b006:l012","ordinal":176494,"en":"On the pass of the direct road,"},{"id":"semetey-1-2013:p1313:b008:l001","ordinal":176495,"en":"I found my Chürök."},{"id":"semetey-1-2013:p1313:b008:l002","ordinal":176496,"en":"There are two fateful sayings;"},{"id":"semetey-1-2013:p1313:b008:l003","ordinal":176497,"en":"Some people say"},{"id":"semetey-1-2013:p1313:b008:l004","ordinal":176498,"en":"Chürök is a peri's daughter."},{"id":"semetey-1-2013:p1313:b008:l005","ordinal":176499,"en":"Could I fail to give my noble child"},{"id":"semetey-1-2013:p1313:b008:l006","ordinal":176500,"en":"To her rightful master?”"},{"id":"semetey-1-2013:p1313:b008:l007","ordinal":176501,"en":"Driving seventy red camels,"},{"id":"semetey-1-2013:p1313:b008:l008","ordinal":176502,"en":"To bear loads when they migrated,"},{"id":"semetey-1-2013:p1313:b008:l009","ordinal":176503,"en":"He fully prepared the pack animals;"},{"id":"semetey-1-2013:p1313:b008:l010","ordinal":176504,"en":"Khan Akun made his testament."},{"id":"semetey-1-2013:p1313:b008:l011","ordinal":176505,"en":"Having overcome the great enemy,"},{"id":"semetey-1-2013:p1313:b008:l012","ordinal":176506,"en":"Semetey received great honor."},{"id":"semetey-1-2013:p1314:b003:l001","ordinal":176507,"en":"He gave Ayçürök,"},{"id":"semetey-1-2013:p1314:b003:l002","ordinal":176508,"en":"And his people witnessed the giving."},{"id":"semetey-1-2013:p1314:b003:l003","ordinal":176509,"en":"He gathered exactly ninety"},{"id":"semetey-1-2013:p1314:b003:l004","ordinal":176510,"en":"Khojas and mullahs."},{"id":"semetey-1-2013:p1314:b003:l005","ordinal":176511,"en":"They held the feast for twelve days,"},{"id":"semetey-1-2013:p1314:b003:l006","ordinal":176512,"en":"The peoples gathering at the celebration,"},{"id":"semetey-1-2013:p1314:b003:l007","ordinal":176513,"en":"And had the marriage contract solemnized as proof."},{"id":"semetey-1-2013:p1314:b003:l008","ordinal":176514,"en":"He gathered in the treasury"},{"id":"semetey-1-2013:p1314:b003:l009","ordinal":176515,"en":"The many goods to be given to Chürök."},{"id":"semetey-1-2013:p1314:b003:l010","ordinal":176516,"en":"Driving sixty red pack-camels,"},{"id":"semetey-1-2013:p1314:b003:l011","ordinal":176517,"en":"“Let my child Chürök live on these"},{"id":"semetey-1-2013:p1314:b003:l012","ordinal":176518,"en":"Until Judgment Day,” he said."},{"id":"semetey-1-2013:p1314:b003:l013","ordinal":176519,"en":"Loading ornaments of red gold,"},{"id":"semetey-1-2013:p1314:b003:l014","ordinal":176520,"en":"Driving seventy red camels,"},{"id":"semetey-1-2013:p1314:b003:l015","ordinal":176521,"en":"Loading seven bales of cloth,"},{"id":"semetey-1-2013:p1314:b003:l016","ordinal":176522,"en":"And in Ajybay's charge,"},{"id":"semetey-1-2013:p1314:b003:l017","ordinal":176523,"en":"Exactly twenty-one red camels"},{"id":"semetey-1-2013:p1314:b003:l018","ordinal":176524,"en":"He had kneel by the treasury."},{"id":"semetey-1-2013:p1314:b003:l019","ordinal":176525,"en":"For pitching at encampments,"},{"id":"semetey-1-2013:p1314:b003:l020","ordinal":176526,"en":"He loaded a Kyrgyz felt yurt."},{"id":"semetey-1-2013:p1314:b003:l021","ordinal":176527,"en":"The wonder of that dwelling was this:"},{"id":"semetey-1-2013:p1314:b003:l022","ordinal":176528,"en":"Its crown was gold, its ropes were copper;"},{"id":"semetey-1-2013:p1314:b003:l023","ordinal":176529,"en":"The roof-cover of that dwelling"},{"id":"semetey-1-2013:p1314:b003:l024","ordinal":176530,"en":"Was silk satin outside."},{"id":"semetey-1-2013:p1314:b003:l025","ordinal":176531,"en":"He let Chürök, Akun's daughter,"},{"id":"semetey-1-2013:p1314:b003:l026","ordinal":176532,"en":"Make merry for thirty days,"},{"id":"semetey-1-2013:p1314:b003:l027","ordinal":176533,"en":"And sing plaintively for forty-one days."},{"id":"semetey-1-2013:p1314:b003:l028","ordinal":176534,"en":"For Akun's daughter, his only girl,"},{"id":"semetey-1-2013:p1314:b003:l029","ordinal":176535,"en":"With a waist like the moon in a red dress,"},{"id":"semetey-1-2013:p1314:b003:l030","ordinal":176536,"en":"From among the dazzling beauties"},{"id":"semetey-1-2013:p1314:b003:l031","ordinal":176537,"en":"He gave maiden attendants."},{"id":"semetey-1-2013:p1314:b003:l032","ordinal":176538,"en":"With broad rumps and wide hair ornaments,"},{"id":"semetey-1-2013:p1314:b003:l033","ordinal":176539,"en":"Graceful and camel-eyed,"},{"id":"semetey-1-2013:p1314:b003:l034","ordinal":176540,"en":"He gave married-woman attendants."},{"id":"semetey-1-2013:p1314:b003:l035","ordinal":176541,"en":"Extinguishing the fire she had kindled,"},{"id":"semetey-1-2013:p1314:b003:l036","ordinal":176542,"en":"They moved fortunate Chürök"},{"id":"semetey-1-2013:p1314:b003:l037","ordinal":176543,"en":"Toward Talas."},{"id":"semetey-1-2013:p1314:b003:l038","ordinal":176544,"en":"Upon Chürök, like the full moon,"},{"id":"semetey-1-2013:p1314:b004:l001","ordinal":176545,"en":"They put garments flowered with silk,"},{"id":"semetey-1-2013:p1314:b004:l002","ordinal":176546,"en":"And mounted her on a bay piebald pacer."},{"id":"semetey-1-2013:p1314:b004:l003","ordinal":176547,"en":"Mounted on a pale bay pacer, swaying,"},{"id":"semetey-1-2013:p1314:b004:l004","ordinal":176548,"en":"She migrated out of Afghanistan,"},{"id":"semetey-1-2013:p1314:b004:l005","ordinal":176549,"en":"Shining in a long robe."},{"id":"semetey-1-2013:p1314:b004:l006","ordinal":176550,"en":"Mounted on a gray pacer, swaying,"},{"id":"semetey-1-2013:p1314:b004:l007","ordinal":176551,"en":"She migrated out of Afghanistan,"},{"id":"semetey-1-2013:p1314:b004:l008","ordinal":176552,"en":"Shining in a sumptuous robe."},{"id":"semetey-1-2013:p1314:b004:l009","ordinal":176553,"en":"Like flowers growing in a mirror,"},{"id":"semetey-1-2013:p1314:b004:l010","ordinal":176554,"en":"She migrated out of Afghanistan,"},{"id":"semetey-1-2013:p1314:b004:l011","ordinal":176555,"en":"Like demons departing at dusk."},{"id":"semetey-1-2013:p1314:b004:l012","ordinal":176556,"en":"Arrayed like a noblewoman,"},{"id":"semetey-1-2013:p1314:b004:l013","ordinal":176557,"en":"Swaying as though struck by a peri,"},{"id":"semetey-1-2013:p1314:b004:l014","ordinal":176558,"en":"She left Afghanistan and traveled on."},{"id":"semetey-1-2013:p1314:b004:l015","ordinal":176559,"en":"They rode far without sparing the horses;"},{"id":"semetey-1-2013:p1314:b004:l016","ordinal":176560,"en":"Whenever she looked to the joyful side,"},{"id":"semetey-1-2013:p1314:b004:l017","ordinal":176561,"en":"There was entertainment all along the road."},{"id":"semetey-1-2013:p1314:b004:l018","ordinal":176562,"en":"“It is the land left by my father,” she said,"},{"id":"semetey-1-2013:p1314:b004:l019","ordinal":176563,"en":"And came to settle in Talas,"},{"id":"semetey-1-2013:p1314:b004:l020","ordinal":176564,"en":"In the land won by her father,"},{"id":"semetey-1-2013:p1314:b004:l021","ordinal":176565,"en":"Among the people left by her father."},{"id":"semetey-1-2013:p1314:b004:l022","ordinal":176566,"en":"Ayçürök, daughter of Akun,"},{"id":"semetey-1-2013:p1314:b004:l023","ordinal":176567,"en":"Whom their fathers had betrothed,"},{"id":"semetey-1-2013:p1314:b004:l024","ordinal":176568,"en":"Found a homeland like broad Talas"},{"id":"semetey-1-2013:p1314:b004:l025","ordinal":176569,"en":"And found a husband like Semetey."},{"id":"semetey-1-2013:p1314:b004:l026","ordinal":176570,"en":"After blood-red slaughter and empty clamor,"},{"id":"semetey-1-2013:p1314:b004:l027","ordinal":176571,"en":"The time came when Semetey"},{"id":"semetey-1-2013:p1314:b004:l028","ordinal":176572,"en":"Took Ayçürök,"},{"id":"semetey-1-2013:p1314:b004:l029","ordinal":176573,"en":"And his soul found peace."},{"id":"semetey-1-2013:p1314:b004:l030","ordinal":176574,"en":"Semetey, son of Manas,"},{"id":"semetey-1-2013:p1314:b004:l031","ordinal":176575,"en":"Could die without regret."},{"id":"semetey-1-2013:p1314:b004:l032","ordinal":176576,"en":"Like a dark, rugged mountain,"},{"id":"semetey-1-2013:p1314:b004:l033","ordinal":176577,"en":"On that day no one remained"},{"id":"semetey-1-2013:p1314:b004:l034","ordinal":176578,"en":"Who could cast a lasso upon the prince."},{"id":"semetey-1-2013:p1314:b004:l035","ordinal":176579,"en":"His fortune came fully into balance,"},{"id":"semetey-1-2013:p1314:b004:l036","ordinal":176580,"en":"A lion supported by the spirit emerged,"},{"id":"semetey-1-2013:p1314:b004:l037","ordinal":176581,"en":"And from his father, blue-maned Manas,"},{"id":"semetey-1-2013:p1314:b004:l038","ordinal":176582,"en":"An even greater hero emerged."}]
