[{"id":"semetey-1-2013:p0898:b004:l028","ordinal":144897,"en":"My cause is more righteous than all;","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0898:b004:l029","ordinal":144898,"en":"The forty companions are my mirror!"},{"id":"semetey-1-2013:p0898:b004:l030","ordinal":144899,"en":"If the forty companions are beside me,"},{"id":"semetey-1-2013:p0898:b004:l031","ordinal":144900,"en":"Into darkening Beijing"},{"id":"semetey-1-2013:p0898:b004:l032","ordinal":144901,"en":"I shall go straight and level my spear."},{"id":"semetey-1-2013:p0898:b004:l033","ordinal":144902,"en":"The grim-faced Chinese—"},{"id":"semetey-1-2013:p0898:b004:l034","ordinal":144903,"en":"I shall slaughter them all, leaving none!"},{"id":"semetey-1-2013:p0898:b004:l035","ordinal":144904,"en":"Against Kakan Chin’s Beijing"},{"id":"semetey-1-2013:p0898:b004:l036","ordinal":144905,"en":"I shall wage a mighty campaign."},{"id":"semetey-1-2013:p0898:b004:l037","ordinal":144906,"en":"I shall wreak havoc upon Beijing."},{"id":"semetey-1-2013:p0898:b004:l038","ordinal":144907,"en":"If you are my support, forty companions,"},{"id":"semetey-1-2013:p0898:b004:l039","ordinal":144908,"en":"I shall avenge the blood of my khan father Manas!"},{"id":"semetey-1-2013:p0899:b003:l001","ordinal":144909,"en":"When horses grow fat and strong,"},{"id":"semetey-1-2013:p0899:b003:l002","ordinal":144910,"en":"When men grow fat and restless,"},{"id":"semetey-1-2013:p0899:b003:l003","ordinal":144911,"en":"Beijing, land of Kakan-Chyn—"},{"id":"semetey-1-2013:p0899:b003:l004","ordinal":144912,"en":"That is the people I must fight."},{"id":"semetey-1-2013:p0899:b003:l005","ordinal":144913,"en":"Against the darkly looming Manchus,"},{"id":"semetey-1-2013:p0899:b003:l006","ordinal":144914,"en":"If we march straight in and wreak slaughter,"},{"id":"semetey-1-2013:p0899:b003:l007","ordinal":144915,"en":"From that hell of grievous hardship,"},{"id":"semetey-1-2013:p0899:b003:l008","ordinal":144916,"en":"If we free our poor souls!"},{"id":"semetey-1-2013:p0899:b003:l009","ordinal":144917,"en":"Against Beijing, untouched by the Four Companions,"},{"id":"semetey-1-2013:p0899:b003:l010","ordinal":144918,"en":"If I do not clash in battle,"},{"id":"semetey-1-2013:p0899:b003:l011","ordinal":144919,"en":"That place where my forefather died,"},{"id":"semetey-1-2013:p0899:b003:l012","ordinal":144920,"en":"If I do not pursue his blood-price to the end!"},{"id":"semetey-1-2013:p0899:b003:l013","ordinal":144921,"en":"Breaking their ranks with spears,"},{"id":"semetey-1-2013:p0899:b003:l014","ordinal":144922,"en":"If death comes by God's will,"},{"id":"semetey-1-2013:p0899:b003:l015","ordinal":144923,"en":"Struck by a bullet in mighty Beijing."},{"id":"semetey-1-2013:p0899:b003:l017","ordinal":144924,"en":"If we do not charge and wage war,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0899:b003:l018","ordinal":144925,"en":"Against the Kara-Khitai and Manchus"},{"id":"semetey-1-2013:p0899:b003:l020","ordinal":144926,"en":"Against Beijing of Chyn-Machyn,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0899:b003:l021","ordinal":144927,"en":"Against the people of true China,"},{"id":"semetey-1-2013:p0899:b003:l022","ordinal":144928,"en":"Against those infidels swarming like black spiders,"},{"id":"semetey-1-2013:p0899:b003:l023","ordinal":144929,"en":"How many heroes have vengeance to take"},{"id":"semetey-1-2013:p0899:b003:l024","ordinal":144930,"en":"Against the warrior Khan Kongurbai!"},{"id":"semetey-1-2013:p0899:b003:l025","ordinal":144931,"en":"He is our grievance when we come to dispute,"},{"id":"semetey-1-2013:p0899:b003:l026","ordinal":144932,"en":"He is our enemy when we come to fight."},{"id":"semetey-1-2013:p0899:b003:l027","ordinal":144933,"en":"There are the people of Kakan-Chyn;"},{"id":"semetey-1-2013:p0899:b003:l028","ordinal":144934,"en":"Against that people whom we must face,"},{"id":"semetey-1-2013:p0899:b003:l029","ordinal":144935,"en":"I, the orphan, have a grievance."},{"id":"semetey-1-2013:p0899:b003:l030","ordinal":144936,"en":"Khan Bakai and Khan Sary—"},{"id":"semetey-1-2013:p0899:b003:l031","ordinal":144937,"en":"If I do not have them take up the banner,"},{"id":"semetey-1-2013:p0899:b003:l032","ordinal":144938,"en":"Against the Manchus and Chinese from the flank,"},{"id":"semetey-1-2013:p0899:b003:l033","ordinal":144939,"en":"If I do not bring slaughter upon them,"},{"id":"semetey-1-2013:p0899:b003:l034","ordinal":144940,"en":"My falcon father Manas—"},{"id":"semetey-1-2013:p0899:b003:l035","ordinal":144941,"en":"If I do not thus avenge him!"},{"id":"semetey-1-2013:p0899:b003:l036","ordinal":144942,"en":"My dear forty uncles!"},{"id":"semetey-1-2013:p0899:b003:l037","ordinal":144943,"en":"Along the road you yourselves have known,"},{"id":"semetey-1-2013:p0899:b003:l038","ordinal":144944,"en":"Along the valleys' springs and streams,"},{"id":"semetey-1-2013:p0899:b003:l039","ordinal":144945,"en":"There are the Kalmak and Shibee peoples,"},{"id":"semetey-1-2013:p0899:b005:l001","ordinal":144946,"en":"And that fine fellow, Khan Kongurbai."},{"id":"semetey-1-2013:p0899:b005:l002","ordinal":144947,"en":"The Kyrgyz and Kalmaks joined together,"},{"id":"semetey-1-2013:p0899:b005:l003","ordinal":144948,"en":"With their custom of fighting."},{"id":"semetey-1-2013:p0899:b005:l004","ordinal":144949,"en":"My dear forty uncles,"},{"id":"semetey-1-2013:p0899:b005:l005","ordinal":144950,"en":"Listen carefully:"},{"id":"semetey-1-2013:p0899:b005:l006","ordinal":144951,"en":"My words carry this much weight."},{"id":"semetey-1-2013:p0899:b005:l007","ordinal":144952,"en":"Consider it, forty uncles:"},{"id":"semetey-1-2013:p0899:b005:l008","ordinal":144953,"en":"Does not a mortal person die?"},{"id":"semetey-1-2013:p0899:b005:l009","ordinal":144954,"en":"The Creator's command—"},{"id":"semetey-1-2013:p0899:b005:l010","ordinal":144955,"en":"Does not His poor servant meet it?"},{"id":"semetey-1-2013:p0899:b005:l011","ordinal":144956,"en":"Breaking their ranks with spears,"},{"id":"semetey-1-2013:p0899:b005:l012","ordinal":144957,"en":"Struck by a bullet when death comes,"},{"id":"semetey-1-2013:p0899:b005:l013","ordinal":144958,"en":"Dying when our appointed end arrives,"},{"id":"semetey-1-2013:p0899:b005:l014","ordinal":144959,"en":"Let us meet them in battle;"},{"id":"semetey-1-2013:p0899:b005:l015","ordinal":144960,"en":"Against the Chinese of Kapsang-Too,"},{"id":"semetey-1-2013:p0899:b005:l016","ordinal":144961,"en":"Let us fight and bring upheaval."},{"id":"semetey-1-2013:p0899:b005:l017","ordinal":144962,"en":"If you will stand by me, forty uncles,"},{"id":"semetey-1-2013:p0899:b005:l018","ordinal":144963,"en":"Against the seething Chinese,"},{"id":"semetey-1-2013:p0899:b005:l019","ordinal":144964,"en":"Let us unleash turmoil!"},{"id":"semetey-1-2013:p0899:b005:l020","ordinal":144965,"en":"There are the mines of Altyn-Too;"},{"id":"semetey-1-2013:p0899:b005:l021","ordinal":144966,"en":"If we clash with the Kara-Khitai,"},{"id":"semetey-1-2013:p0899:b005:l022","ordinal":144967,"en":"They have a strong support behind them:"},{"id":"semetey-1-2013:p0899:b005:l023","ordinal":144968,"en":"Their great lion on whom they rely,"},{"id":"semetey-1-2013:p0899:b005:l024","ordinal":144969,"en":"Their champion, Bek Kongurbai."},{"id":"semetey-1-2013:p0899:b005:l025","ordinal":144970,"en":"If we advance and make war,"},{"id":"semetey-1-2013:p0899:b005:l026","ordinal":144971,"en":"We have seven forefathers to avenge."},{"id":"semetey-1-2013:p0899:b005:l027","ordinal":144972,"en":"In Beijing, beyond the reach of the Flood,"},{"id":"semetey-1-2013:p0899:b005:l028","ordinal":144973,"en":"There are ravines no one has seen,"},{"id":"semetey-1-2013:p0899:b005:l029","ordinal":144974,"en":"There are mountains where tea is gathered."},{"id":"semetey-1-2013:p0899:b005:l030","ordinal":144975,"en":"All their famous men, every one,"},{"id":"semetey-1-2013:p0899:b005:l031","ordinal":144976,"en":"My father cut down;"},{"id":"semetey-1-2013:p0899:b005:l032","ordinal":144977,"en":"Only Kongurbai remains his foe."},{"id":"semetey-1-2013:p0899:b005:l033","ordinal":144978,"en":"In the war of former days,"},{"id":"semetey-1-2013:p0899:b005:l034","ordinal":144979,"en":"In those events,"},{"id":"semetey-1-2013:p0899:b005:l035","ordinal":144980,"en":"When my father took the Kakan,"},{"id":"semetey-1-2013:p0899:b005:l036","ordinal":144981,"en":"Among the seething Chinese,"},{"id":"semetey-1-2013:p0899:b005:l037","ordinal":144982,"en":"When he unleashed turmoil,"},{"id":"semetey-1-2013:p0899:b005:l038","ordinal":144983,"en":"When my khan father became sultan"},{"id":"semetey-1-2013:p0899:b005:l039","ordinal":144984,"en":"And ruled for six months,"},{"id":"semetey-1-2013:p0901:b003:l001","ordinal":144985,"en":"Many sorrows remain in the heart;"},{"id":"semetey-1-2013:p0901:b003:l002","ordinal":144986,"en":"Such is this treacherous world."},{"id":"semetey-1-2013:p0901:b003:l003","ordinal":144987,"en":"Taking wives in that place,"},{"id":"semetey-1-2013:p0901:b003:l004","ordinal":144988,"en":"Of the Muslim people"},{"id":"semetey-1-2013:p0901:b003:l005","ordinal":144989,"en":"A people called Targana remained."},{"id":"semetey-1-2013:p0901:b003:l006","ordinal":144990,"en":"'We will campaign against the Kakan!'"},{"id":"semetey-1-2013:p0901:b003:l008","ordinal":144991,"en":"A people remained who said, 'Let us attack!'","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0901:b003:l009","ordinal":144992,"en":"Forty companions left by my father,"},{"id":"semetey-1-2013:p0901:b003:l010","ordinal":144993,"en":"Let us reckon the days,"},{"id":"semetey-1-2013:p0901:b003:l011","ordinal":144994,"en":"Let us put the month in writing."},{"id":"semetey-1-2013:p0901:b003:l012","ordinal":144995,"en":"Regaining flesh and strength, let us act,"},{"id":"semetey-1-2013:p0901:b003:l013","ordinal":144996,"en":"Gathering our handful of Muslims,"},{"id":"semetey-1-2013:p0901:b003:l014","ordinal":144997,"en":"Mustering them into a force."},{"id":"semetey-1-2013:p0901:b003:l015","ordinal":144998,"en":"Gathering all the Muslim people,"},{"id":"semetey-1-2013:p0901:b003:l016","ordinal":144999,"en":"Against grim-faced Beijing,"},{"id":"semetey-1-2013:p0901:b003:l017","ordinal":145000,"en":"If we do not fight to the last,"},{"id":"semetey-1-2013:p0901:b003:l018","ordinal":145001,"en":"Upon the Chinese, numerous as a cow's hairs,"},{"id":"semetey-1-2013:p0901:b003:l019","ordinal":145002,"en":"If we do not bring great hardship,"},{"id":"semetey-1-2013:p0901:b003:l020","ordinal":145003,"en":"On the seething Kara-Khitai,"},{"id":"semetey-1-2013:p0901:b003:l021","ordinal":145004,"en":"If we do not charge and avenge ourselves,"},{"id":"semetey-1-2013:p0901:b003:l022","ordinal":145005,"en":"Let us die rather than live!"},{"id":"semetey-1-2013:p0901:b003:l023","ordinal":145006,"en":"There is an enemy we must engage;"},{"id":"semetey-1-2013:p0901:b003:l024","ordinal":145007,"en":"Let us try facing them."},{"id":"semetey-1-2013:p0901:b003:l025","ordinal":145008,"en":"I have drawn upon tradition,"},{"id":"semetey-1-2013:p0901:b003:l026","ordinal":145009,"en":"I have asked the knowledgeable."},{"id":"semetey-1-2013:p0901:b003:l027","ordinal":145010,"en":"There are your white-bearded elders,"},{"id":"semetey-1-2013:p0901:b003:l028","ordinal":145011,"en":"My uncle Bakai and all the rest,"},{"id":"semetey-1-2013:p0901:b003:l029","ordinal":145012,"en":"There are giants among the Muslim people,"},{"id":"semetey-1-2013:p0901:b003:l030","ordinal":145013,"en":"Many lions, all together."},{"id":"semetey-1-2013:p0901:b003:l031","ordinal":145014,"en":"Once, the infidels and Muslims"},{"id":"semetey-1-2013:p0901:b003:l032","ordinal":145015,"en":"Came into conflict over this,"},{"id":"semetey-1-2013:p0901:b003:l033","ordinal":145016,"en":"Standing opposite one another,"},{"id":"semetey-1-2013:p0901:b003:l034","ordinal":145017,"en":"Thrusting and grappling with spears,"},{"id":"semetey-1-2013:p0901:b003:l035","ordinal":145018,"en":"Fighting at the cost of their lives."},{"id":"semetey-1-2013:p0901:b003:l036","ordinal":145019,"en":"My father, Khan Manas,"},{"id":"semetey-1-2013:p0901:b003:l037","ordinal":145020,"en":"Beijing, untouched by the Four Companions—"},{"id":"semetey-1-2013:p0901:b003:l038","ordinal":145021,"en":"When he fiercely attacked it,"},{"id":"semetey-1-2013:p0901:b003:l039","ordinal":145022,"en":"When he went against the famed Kakan's Beijing,"},{"id":"semetey-1-2013:p0901:b004:l001","ordinal":145023,"en":"When he went there to fight,"},{"id":"semetey-1-2013:p0901:b004:l003","ordinal":145024,"en":"All the mighty men","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0901:b004:l005","ordinal":145025,"en":"The khan who went with news died;","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0901:b004:l006","ordinal":145026,"en":"Against Beijing of Kakan-Chyn,"},{"id":"semetey-1-2013:p0901:b004:l007","ordinal":145027,"en":"Everyone who challenged it died."},{"id":"semetey-1-2013:p0901:b004:l008","ordinal":145028,"en":"Elebei and Khan Jeeren died,"},{"id":"semetey-1-2013:p0901:b004:l009","ordinal":145029,"en":"The hero Bokmurun died too,"},{"id":"semetey-1-2013:p0901:b004:l010","ordinal":145030,"en":"Muzburchak and Khan Kokcho died;"},{"id":"semetey-1-2013:p0901:b004:l011","ordinal":145031,"en":"Of the Chinese of Chyn-Machyn,"},{"id":"semetey-1-2013:p0901:b004:l012","ordinal":145032,"en":"Everyone they encountered died."},{"id":"semetey-1-2013:p0901:b004:l013","ordinal":145033,"en":"Going to the Kakan and returning,"},{"id":"semetey-1-2013:p0901:b004:l014","ordinal":145034,"en":"My leopard father died too,"},{"id":"semetey-1-2013:p0901:b004:l015","ordinal":145035,"en":"Bereft of those dear men;"},{"id":"semetey-1-2013:p0901:b004:l016","ordinal":145036,"en":"Ak-Kula was shot down,"},{"id":"semetey-1-2013:p0901:b004:l017","ordinal":145037,"en":"Almambet became a martyr,"},{"id":"semetey-1-2013:p0901:b004:l018","ordinal":145038,"en":"The lions Syrgak and Serek died,"},{"id":"semetey-1-2013:p0901:b004:l019","ordinal":145039,"en":"Baichoro, Bozuul, Agayar—"},{"id":"semetey-1-2013:p0901:b004:l020","ordinal":145040,"en":"Their champions died alike."},{"id":"semetey-1-2013:p0901:b004:l021","ordinal":145041,"en":"Akbaltai's hero Chubak,"},{"id":"semetey-1-2013:p0901:b004:l022","ordinal":145042,"en":"Amid the true slaughter,"},{"id":"semetey-1-2013:p0901:b004:l023","ordinal":145043,"en":"Fought for six whole months,"},{"id":"semetey-1-2013:p0901:b004:l024","ordinal":145044,"en":"Against the grim Kara-Khitai,"},{"id":"semetey-1-2013:p0901:b004:l025","ordinal":145045,"en":"Until they were spent."},{"id":"semetey-1-2013:p0901:b004:l026","ordinal":145046,"en":"Until the pliant dry stalks ripened,"},{"id":"semetey-1-2013:p0901:b004:l027","ordinal":145047,"en":"Until the autumn gossamer flew,"},{"id":"semetey-1-2013:p0901:b004:l028","ordinal":145048,"en":"Until more than six months had passed,"},{"id":"semetey-1-2013:p0901:b004:l029","ordinal":145049,"en":"He fought tirelessly for six months,"},{"id":"semetey-1-2013:p0901:b004:l030","ordinal":145050,"en":"Lashing out like a lion."},{"id":"semetey-1-2013:p0901:b004:l031","ordinal":145051,"en":"Lion Chubak, the dauntless hero,"},{"id":"semetey-1-2013:p0901:b004:l032","ordinal":145052,"en":"In the desert of It-Olbos,"},{"id":"semetey-1-2013:p0901:b004:l033","ordinal":145053,"en":"The Chinese drums"},{"id":"semetey-1-2013:p0901:b004:l035","ordinal":145054,"en":"When the battle raged in turmoil,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0901:b004:l036","ordinal":145055,"en":"Was shot by Kojojash."},{"id":"semetey-1-2013:p0901:b004:l037","ordinal":145056,"en":"The sky was covered with cloud;"},{"id":"semetey-1-2013:p0901:b004:l038","ordinal":145057,"en":"Struck by a bullet, Khan Chubak"},{"id":"semetey-1-2013:p0901:b004:l039","ordinal":145058,"en":"Escaped like a coward,"},{"id":"semetey-1-2013:p0902:b003:l001","ordinal":145059,"en":"Laying the whip on Kogala,"},{"id":"semetey-1-2013:p0902:b003:l002","ordinal":145060,"en":"What could dauntless Chubak do?"},{"id":"semetey-1-2013:p0902:b003:l003","ordinal":145061,"en":"He fled without stopping, galloping on,"},{"id":"semetey-1-2013:p0902:b003:l004","ordinal":145062,"en":"His wound grew inflamed,"},{"id":"semetey-1-2013:p0902:b003:l005","ordinal":145063,"en":"His flesh wasted away, leaving bone,"},{"id":"semetey-1-2013:p0902:b003:l006","ordinal":145064,"en":"His blood drained away, leaving flesh,"},{"id":"semetey-1-2013:p0902:b003:l007","ordinal":145065,"en":"His fine mustache lay smooth,"},{"id":"semetey-1-2013:p0902:b003:l008","ordinal":145066,"en":"He was stricken with a terrible affliction,"},{"id":"semetey-1-2013:p0902:b003:l009","ordinal":145067,"en":"His half-open eyes wandered wildly."},{"id":"semetey-1-2013:p0902:b003:l010","ordinal":145068,"en":"Sometimes he could speak,"},{"id":"semetey-1-2013:p0902:b003:l011","ordinal":145069,"en":"Sometimes he could not speak,"},{"id":"semetey-1-2013:p0902:b003:l012","ordinal":145070,"en":"Distressed, his eyes darted about."},{"id":"semetey-1-2013:p0902:b003:l013","ordinal":145071,"en":"Unable to find the road to Talas,"},{"id":"semetey-1-2013:p0902:b003:l014","ordinal":145072,"en":"Unable to judge his way across the land,"},{"id":"semetey-1-2013:p0902:b003:l015","ordinal":145073,"en":"That accomplished, dear hero Chubak,"},{"id":"semetey-1-2013:p0902:b003:l016","ordinal":145074,"en":"I heard, lost his way."},{"id":"semetey-1-2013:p0902:b003:l017","ordinal":145075,"en":"Roaming the whole world,"},{"id":"semetey-1-2013:p0902:b003:l018","ordinal":145076,"en":"He visited the shrines upon the earth,"},{"id":"semetey-1-2013:p0902:b003:l019","ordinal":145077,"en":"Not leaving a single one out."},{"id":"semetey-1-2013:p0902:b003:l020","ordinal":145078,"en":"His consciousness was dim and dazed,"},{"id":"semetey-1-2013:p0902:b003:l021","ordinal":145079,"en":"Sometimes lucid, sometimes mad,"},{"id":"semetey-1-2013:p0902:b003:l022","ordinal":145080,"en":"That was how he lived."},{"id":"semetey-1-2013:p0902:b003:l023","ordinal":145081,"en":"What could dear Chubak do?"},{"id":"semetey-1-2013:p0902:b003:l024","ordinal":145082,"en":"Like a fool, mad in the head,"},{"id":"semetey-1-2013:p0902:b003:l025","ordinal":145083,"en":"Turning away then,"},{"id":"semetey-1-2013:p0902:b003:l026","ordinal":145084,"en":"Finding no land like this Talas—"},{"id":"semetey-1-2013:p0902:b003:l027","ordinal":145085,"en":"Look at God's decree!—"},{"id":"semetey-1-2013:p0902:b003:l028","ordinal":145086,"en":"Finding no people like these Kyrgyz,"},{"id":"semetey-1-2013:p0902:b003:l029","ordinal":145087,"en":"Roaming the whole world,"},{"id":"semetey-1-2013:p0902:b003:l030","ordinal":145088,"en":"Wandering through Andijan."},{"id":"semetey-1-2013:p0902:b003:l031","ordinal":145089,"en":"Some people say"},{"id":"semetey-1-2013:p0902:b003:l032","ordinal":145090,"en":"He went to Arslanbap;"},{"id":"semetey-1-2013:p0902:b003:l033","ordinal":145091,"en":"Some people say"},{"id":"semetey-1-2013:p0902:b003:l034","ordinal":145092,"en":"Synchybek of Andijan"},{"id":"semetey-1-2013:p0902:b003:l035","ordinal":145093,"en":"Gave him a burning poison,"},{"id":"semetey-1-2013:p0902:b003:l036","ordinal":145094,"en":"And put an end to him."},{"id":"semetey-1-2013:p0902:b003:l037","ordinal":145095,"en":"Some people tell this tale;"},{"id":"semetey-1-2013:p0902:b003:l038","ordinal":145096,"en":"Who knows whether it is false or true?"},{"id":"semetey-1-2013:p0902:b003:l039","ordinal":145097,"en":"They tell the horror convincingly."},{"id":"semetey-1-2013:p0902:b004:l001","ordinal":145098,"en":"If you support me, forty companions,"},{"id":"semetey-1-2013:p0902:b004:l002","ordinal":145099,"en":"I shall attack Andijan,"},{"id":"semetey-1-2013:p0902:b004:l003","ordinal":145100,"en":"I shall raise an uproar,"},{"id":"semetey-1-2013:p0902:b004:l004","ordinal":145101,"en":"I shall avenge Chubak's blood!"},{"id":"semetey-1-2013:p0902:b004:l005","ordinal":145102,"en":"If what is told is true,"},{"id":"semetey-1-2013:p0902:b004:l006","ordinal":145103,"en":"There is a tale of his wandering away,"},{"id":"semetey-1-2013:p0902:b004:l007","ordinal":145104,"en":"My dauntless lion Chubak"},{"id":"semetey-1-2013:p0902:b004:l008","ordinal":145105,"en":"Saw many things in those places."},{"id":"semetey-1-2013:p0902:b004:l009","ordinal":145106,"en":"Who knows whether this is false or true?"},{"id":"semetey-1-2013:p0902:b004:l010","ordinal":145107,"en":"Only the Creator knows!"},{"id":"semetey-1-2013:p0902:b004:l011","ordinal":145108,"en":"I have drawn upon tradition,"},{"id":"semetey-1-2013:p0902:b004:l012","ordinal":145109,"en":"Weighing out and giving gold,"},{"id":"semetey-1-2013:p0902:b004:l013","ordinal":145110,"en":"I asked about this Chubak's fate"},{"id":"semetey-1-2013:p0902:b004:l014","ordinal":145111,"en":"From the caravan travelers."},{"id":"semetey-1-2013:p0902:b004:l015","ordinal":145112,"en":"Some of the travelers tell this:"},{"id":"semetey-1-2013:p0902:b004:l016","ordinal":145113,"en":"They tell horrors that torment the soul."},{"id":"semetey-1-2013:p0902:b004:l017","ordinal":145114,"en":"Running wild with Kogala,"},{"id":"semetey-1-2013:p0902:b004:l018","ordinal":145115,"en":"And your dauntless Chubak grew frenzied."},{"id":"semetey-1-2013:p0902:b004:l019","ordinal":145116,"en":"His strength failed, his power ebbed,"},{"id":"semetey-1-2013:p0902:b004:l020","ordinal":145117,"en":"Blood flowed streaming from his wound,"},{"id":"semetey-1-2013:p0902:b004:l022","ordinal":145118,"en":"His joint bones shuddered.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0902:b004:l023","ordinal":145119,"en":"There was no forest to shelter him,"},{"id":"semetey-1-2013:p0902:b004:l024","ordinal":145120,"en":"There was no companion to stand by him."},{"id":"semetey-1-2013:p0902:b004:l025","ordinal":145121,"en":"His strength failed, his power ebbed;"},{"id":"semetey-1-2013:p0902:b004:l026","ordinal":145122,"en":"What could dear Chubak do?"},{"id":"semetey-1-2013:p0902:b004:l027","ordinal":145123,"en":"I heard he entered Margalan."},{"id":"semetey-1-2013:p0902:b004:l028","ordinal":145124,"en":"In Margalan, Malabek"},{"id":"semetey-1-2013:p0902:b004:l029","ordinal":145125,"en":"Had a grudge against him from the first."},{"id":"semetey-1-2013:p0902:b004:l030","ordinal":145126,"en":"That man who had fallen ill,"},{"id":"semetey-1-2013:p0902:b004:l031","ordinal":145127,"en":"Malabek seized him, they say,"},{"id":"semetey-1-2013:p0902:b004:l032","ordinal":145128,"en":"Gave him much burning poison,"},{"id":"semetey-1-2013:p0902:b004:l033","ordinal":145129,"en":"And put an end to him, they say."},{"id":"semetey-1-2013:p0902:b004:l034","ordinal":145130,"en":"His traces lead in every direction;"},{"id":"semetey-1-2013:p0902:b004:l035","ordinal":145131,"en":"My father's companion Chubak—"},{"id":"semetey-1-2013:p0902:b004:l036","ordinal":145132,"en":"If we pursue his story further,"},{"id":"semetey-1-2013:p0902:b004:l037","ordinal":145133,"en":"His affairs have no end."},{"id":"semetey-1-2013:p0902:b004:l038","ordinal":145134,"en":"Who knows whether it is false or a lie?"},{"id":"semetey-1-2013:p0902:b004:l039","ordinal":145135,"en":"Only the Creator knows."},{"id":"semetey-1-2013:p0903:b003:l001","ordinal":145136,"en":"His trail led to Margalan;"},{"id":"semetey-1-2013:p0903:b003:l002","ordinal":145137,"en":"I shall attack Margalan,"},{"id":"semetey-1-2013:p0903:b003:l003","ordinal":145138,"en":"I shall avenge Chubak."},{"id":"semetey-1-2013:p0903:b003:l004","ordinal":145139,"en":"Some people say:"},{"id":"semetey-1-2013:p0903:b003:l005","ordinal":145140,"en":"On the moon-pale yellow plain,"},{"id":"semetey-1-2013:p0903:b003:l006","ordinal":145141,"en":"Chubak staggered, bent over,"},{"id":"semetey-1-2013:p0903:b003:l007","ordinal":145142,"en":"And came upon Samarkan."},{"id":"semetey-1-2013:p0903:b003:l008","ordinal":145143,"en":"On the moon-pale yellow plain,"},{"id":"semetey-1-2013:p0903:b003:l009","ordinal":145144,"en":"Samarkan seized him, they say,"},{"id":"semetey-1-2013:p0903:b003:l010","ordinal":145145,"en":"Had him dragged onto the road,"},{"id":"semetey-1-2013:p0903:b003:l011","ordinal":145146,"en":"And torn apart by the Dangyts, they say."},{"id":"semetey-1-2013:p0903:b003:l012","ordinal":145147,"en":"Some people tell this,"},{"id":"semetey-1-2013:p0903:b003:l013","ordinal":145148,"en":"They tell horrors beyond belief."},{"id":"semetey-1-2013:p0903:b003:l014","ordinal":145149,"en":"Upon the city of Samarkand"},{"id":"semetey-1-2013:p0903:b003:l015","ordinal":145150,"en":"I shall bring the end of the world."},{"id":"semetey-1-2013:p0903:b003:l016","ordinal":145151,"en":"If you support me, forty companions,"},{"id":"semetey-1-2013:p0903:b003:l017","ordinal":145152,"en":"I shall avenge Chubak!"}]
