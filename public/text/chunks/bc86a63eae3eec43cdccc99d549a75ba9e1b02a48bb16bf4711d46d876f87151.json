[{"id":"seytek-1991-continuation:p0342:b001:l044","ordinal":387841,"en":"The ground became a pit that trapped feet."},{"id":"seytek-1991-continuation:p0342:b001:l045","ordinal":387842,"en":"The vast army surged in,"},{"id":"seytek-1991-continuation:p0342:b001:l046","ordinal":387843,"en":"And boundless misery boiled over."},{"id":"seytek-1991-continuation:p0342:b001:l047","ordinal":387844,"en":"As the Chinese closed around them,"},{"id":"seytek-1991-continuation:p0342:b001:l048","ordinal":387845,"en":"When oppression and violent calamity"},{"id":"seytek-1991-continuation:p0342:b001:l049","ordinal":387846,"en":"Were about to descend upon their heads,"},{"id":"seytek-1991-continuation:p0342:b003:l001","ordinal":387847,"en":"Calling them fugitives from China,"},{"id":"seytek-1991-continuation:p0342:b003:l002","ordinal":387848,"en":"When they were about to hang them by the elbows,"},{"id":"seytek-1991-continuation:p0342:b003:l003","ordinal":387849,"en":"Cut reins from their backs,"},{"id":"seytek-1991-continuation:p0342:b003:l004","ordinal":387850,"en":"Pierce them through from the saddle,"},{"id":"seytek-1991-continuation:p0342:b003:l005","ordinal":387851,"en":"And hang them dangling"},{"id":"seytek-1991-continuation:p0342:b003:l006","ordinal":387852,"en":"From the end of a tree,"},{"id":"seytek-1991-continuation:p0342:b003:l007","ordinal":387853,"en":"Truly tormenting their souls,"},{"id":"seytek-1991-continuation:p0342:b003:l008","ordinal":387854,"en":"The exceedingly resourceful Ebegey"},{"id":"seytek-1991-continuation:p0342:b003:l009","ordinal":387855,"en":"Mounted Jeljetpes"},{"id":"seytek-1991-continuation:p0342:b003:l010","ordinal":387856,"en":"On the rhinoceros he had drawn near,"},{"id":"seytek-1991-continuation:p0342:b003:l011","ordinal":387857,"en":"Reviving the life that was about to die."},{"id":"seytek-1991-continuation:p0342:b003:l012","ordinal":387858,"en":"He showed the loyalty"},{"id":"seytek-1991-continuation:p0342:b003:l013","ordinal":387859,"en":"Of a wise peer and comrade."},{"id":"seytek-1991-continuation:p0342:b003:l014","ordinal":387860,"en":"Though caught by the woeful army,"},{"id":"seytek-1991-continuation:p0342:b003:l015","ordinal":387861,"en":"Er Jeljetpes escaped."},{"id":"seytek-1991-continuation:p0342:b003:l016","ordinal":387862,"en":"He turned the rhinoceros's head,"},{"id":"seytek-1991-continuation:p0342:b003:l017","ordinal":387863,"en":"Called up the Cloud Horse,"},{"id":"seytek-1991-continuation:p0342:b003:l018","ordinal":387864,"en":"And conjured weather in midsummer."},{"id":"seytek-1991-continuation:p0342:b003:l019","ordinal":387865,"en":"Gorges flew and cliffs collapsed;"},{"id":"seytek-1991-continuation:p0342:b003:l020","ordinal":387866,"en":"He devastated the broad land"},{"id":"seytek-1991-continuation:p0342:b003:l021","ordinal":387867,"en":"And revealed his sorcery."},{"id":"seytek-1991-continuation:p0342:b004:l001","ordinal":387868,"en":"Fog rose from the hollows;"},{"id":"seytek-1991-continuation:p0342:b005:l001","ordinal":387869,"en":"Clouds covered the mountains."},{"id":"seytek-1991-continuation:p0342:b005:l002","ordinal":387870,"en":"Over foothill, slope, and plain,"},{"id":"seytek-1991-continuation:p0342:b005:l003","ordinal":387871,"en":"Black banks of mist divided."},{"id":"seytek-1991-continuation:p0342:b005:l004","ordinal":387872,"en":"Looking toward the sky,"},{"id":"seytek-1991-continuation:p0342:b005:l005","ordinal":387873,"en":"One saw hail pour down in six streams."},{"id":"seytek-1991-continuation:p0342:b005:l006","ordinal":387874,"en":"Across hills, knolls, and ravines,"},{"id":"seytek-1991-continuation:p0342:b005:l007","ordinal":387875,"en":"It smashed and swept away all traces,"},{"id":"seytek-1991-continuation:p0342:b005:l008","ordinal":387876,"en":"And choked the level uplands."},{"id":"seytek-1991-continuation:p0342:b005:l009","ordinal":387877,"en":"Beasts and living creatures"},{"id":"seytek-1991-continuation:p0342:b005:l010","ordinal":387878,"en":"Were disturbed and destroyed."},{"id":"seytek-1991-continuation:p0342:b005:l011","ordinal":387879,"en":"The army gathered with frantic cries;"},{"id":"seytek-1991-continuation:p0342:b005:l012","ordinal":387880,"en":"Ravens croaked and perished."},{"id":"seytek-1991-continuation:p0342:b005:l013","ordinal":387881,"en":"Wild asses fled and escaped;"},{"id":"seytek-1991-continuation:p0342:b005:l014","ordinal":387882,"en":"Creatures that entered their dens"},{"id":"seytek-1991-continuation:p0342:b005:l015","ordinal":387883,"en":"Survived without dying,"},{"id":"seytek-1991-continuation:p0342:b005:l016","ordinal":387884,"en":"While animals above the earth"},{"id":"seytek-1991-continuation:p0342:b005:l017","ordinal":387885,"en":"Were all seized by death."},{"id":"seytek-1991-continuation:p0342:b005:l018","ordinal":387886,"en":"He loosed a storm of extraordinary force."},{"id":"seytek-1991-continuation:p0342:b005:l019","ordinal":387887,"en":"Along slopes, gullies, and cliffs,"},{"id":"seytek-1991-continuation:p0342:b005:l020","ordinal":387888,"en":"Bare rocks fell and streamed down,"},{"id":"seytek-1991-continuation:p0342:b005:l021","ordinal":387889,"en":"Carrying away at their edge"},{"id":"seytek-1991-continuation:p0342:b005:l022","ordinal":387890,"en":"The seething Chinese host."},{"id":"seytek-1991-continuation:p0342:b005:l023","ordinal":387891,"en":"He unleashed the weather without measure,"},{"id":"seytek-1991-continuation:p0342:b005:l024","ordinal":387892,"en":"Blinding eyes and binding hands,"},{"id":"seytek-1991-continuation:p0342:b005:l025","ordinal":387893,"en":"Plainly barring the road."},{"id":"seytek-1991-continuation:p0342:b005:l026","ordinal":387894,"en":"Jeljetpes, who had seen much,"},{"id":"seytek-1991-continuation:p0342:b005:l027","ordinal":387895,"en":"Was an invincible sorcerer."},{"id":"seytek-1991-continuation:p0343:b001:l001","ordinal":387896,"en":"Thus he cast his spell,"},{"id":"seytek-1991-continuation:p0343:b001:l002","ordinal":387897,"en":"Blocking the road"},{"id":"seytek-1991-continuation:p0343:b001:l003","ordinal":387898,"en":"Of the surging infidels,"},{"id":"seytek-1991-continuation:p0343:b001:l004","ordinal":387899,"en":"Turning aside the arrow"},{"id":"seytek-1991-continuation:p0343:b001:l005","ordinal":387900,"en":"Of the overwhelming, fatal calamity,"},{"id":"seytek-1991-continuation:p0343:b001:l006","ordinal":387901,"en":"And barring the very heart"},{"id":"seytek-1991-continuation:p0343:b001:l007","ordinal":387902,"en":"Of the fiercely raging disaster."},{"id":"seytek-1991-continuation:p0343:b001:l008","ordinal":387903,"en":"Looking through the mingled dust,"},{"id":"seytek-1991-continuation:p0343:b001:l009","ordinal":387904,"en":"Longing for his people to be safe,"},{"id":"seytek-1991-continuation:p0343:b001:l010","ordinal":387905,"en":"His fly-like life cried out;"},{"id":"seytek-1991-continuation:p0343:b001:l011","ordinal":387906,"en":"Every bone cracked."},{"id":"seytek-1991-continuation:p0343:b001:l012","ordinal":387907,"en":"His whole body was covered in blood;"},{"id":"seytek-1991-continuation:p0343:b001:l013","ordinal":387908,"en":"The two hands that had served him"},{"id":"seytek-1991-continuation:p0343:b001:l014","ordinal":387909,"en":"Would not rise and were paralyzed."},{"id":"seytek-1991-continuation:p0343:b001:l015","ordinal":387910,"en":"His precious head, dear in life,"},{"id":"seytek-1991-continuation:p0343:b001:l016","ordinal":387911,"en":"Was a red bucket of blood."},{"id":"seytek-1991-continuation:p0343:b001:l017","ordinal":387912,"en":"The broad world narrowed;"},{"id":"seytek-1991-continuation:p0343:b001:l018","ordinal":387913,"en":"Even saliva, life's sustenance,"},{"id":"seytek-1991-continuation:p0343:b001:l019","ordinal":387914,"en":"Was too hard for him to swallow."},{"id":"seytek-1991-continuation:p0343:b001:l020","ordinal":387915,"en":"His unbending back bent,"},{"id":"seytek-1991-continuation:p0343:b001:l021","ordinal":387916,"en":"And he despaired of his precious life."},{"id":"seytek-1991-continuation:p0343:b001:l022","ordinal":387917,"en":"The cold lasso, death's bullet,"},{"id":"seytek-1991-continuation:p0343:b001:l023","ordinal":387918,"en":"Was loaded and poised above his head."},{"id":"seytek-1991-continuation:p0343:b001:l024","ordinal":387919,"en":"His fly-like soul cried out;"},{"id":"seytek-1991-continuation:p0343:b001:l025","ordinal":387920,"en":"All his flesh and bones"},{"id":"seytek-1991-continuation:p0343:b001:l026","ordinal":387921,"en":"Cracked and crumbled to powder."},{"id":"seytek-1991-continuation:p0343:b001:l027","ordinal":387922,"en":"Ebegey fought on,"},{"id":"seytek-1991-continuation:p0343:b001:l028","ordinal":387923,"en":"For many days and many nights,"},{"id":"seytek-1991-continuation:p0343:b001:l029","ordinal":387924,"en":"Standing there in fury."},{"id":"seytek-1991-continuation:p0343:b001:l030","ordinal":387925,"en":"In Yengkor's sight,"},{"id":"seytek-1991-continuation:p0343:b001:l031","ordinal":387926,"en":"Ebegey's ribs"},{"id":"seytek-1991-continuation:p0343:b001:l032","ordinal":387927,"en":"Appeared faintly through the haze."},{"id":"seytek-1991-continuation:p0343:b001:l033","ordinal":387928,"en":"An ember as large as a yurt glowed at the match;"},{"id":"seytek-1991-continuation:p0343:b001:l034","ordinal":387929,"en":"There was no other infidel like him in the world."},{"id":"seytek-1991-continuation:p0343:b001:l035","ordinal":387930,"en":"He brought the gold-trimmed sight"},{"id":"seytek-1991-continuation:p0343:b001:l036","ordinal":387931,"en":"Up to his glass-like eye,"},{"id":"seytek-1991-continuation:p0343:b001:l037","ordinal":387932,"en":"Then pulled and fired."},{"id":"seytek-1991-continuation:p0343:b001:l038","ordinal":387933,"en":"The gun boomed and cracked;"},{"id":"seytek-1991-continuation:p0343:b001:l039","ordinal":387934,"en":"“Lie there, wretched Burut!” he said."},{"id":"seytek-1991-continuation:p0343:b001:l040","ordinal":387935,"en":"From the edge of the ribs,"},{"id":"seytek-1991-continuation:p0343:b001:l041","ordinal":387936,"en":"From the very front of the lung,"},{"id":"seytek-1991-continuation:p0343:b001:l042","ordinal":387937,"en":"Blood gushed and gushed."},{"id":"seytek-1991-continuation:p0343:b001:l043","ordinal":387938,"en":"His fine mustache drooped,"},{"id":"seytek-1991-continuation:p0343:b001:l044","ordinal":387939,"en":"And his ruddy face grew pale;"},{"id":"seytek-1991-continuation:p0343:b001:l045","ordinal":387940,"en":"His breast filled with blood."},{"id":"seytek-1991-continuation:p0343:b001:l046","ordinal":387941,"en":"Ebegey, father of the people,"},{"id":"seytek-1991-continuation:p0343:b001:l047","ordinal":387942,"en":"Was sacrificed for his nation."},{"id":"seytek-1991-continuation:p0343:b001:l048","ordinal":387943,"en":"Blood-handed Yengkor declared,"},{"id":"seytek-1991-continuation:p0343:b001:l049","ordinal":387944,"en":"“I have shattered the mountain ridge"},{"id":"seytek-1991-continuation:p0343:b003:l001","ordinal":387945,"en":"Of the steadfast Burut,"},{"id":"seytek-1991-continuation:p0343:b003:l002","ordinal":387946,"en":"And taken control of the road;"},{"id":"seytek-1991-continuation:p0343:b003:l003","ordinal":387947,"en":"I have brought down a peak like Kap-Too"},{"id":"seytek-1991-continuation:p0343:b003:l004","ordinal":387948,"en":"And cast the world into black night.”"},{"id":"seytek-1991-continuation:p0343:b003:l005","ordinal":387949,"en":"He went to bear glad tidings"},{"id":"seytek-1991-continuation:p0343:b003:l006","ordinal":387950,"en":"To crowned Chyntengir,"},{"id":"seytek-1991-continuation:p0343:b003:l007","ordinal":387951,"en":"Great khan of the Kakan."},{"id":"seytek-1991-continuation:p0343:b004:l001","ordinal":387952,"en":"Now he saw that hero Yengkor"},{"id":"seytek-1991-continuation:p0343:b004:l002","ordinal":387953,"en":"Was truly a man,"},{"id":"seytek-1991-continuation:p0343:b004:l003","ordinal":387954,"en":"And recognized his marksmanship."},{"id":"seytek-1991-continuation:p0343:b004:l004","ordinal":387955,"en":"Without openly rejoicing, he smiled,"},{"id":"seytek-1991-continuation:p0343:b004:l005","ordinal":387956,"en":"His mustache barely twitching,"},{"id":"seytek-1991-continuation:p0343:b004:l006","ordinal":387957,"en":"And laughed almost imperceptibly:"},{"id":"seytek-1991-continuation:p0343:b004:l007","ordinal":387958,"en":"“He was a khan named Ebegey;"},{"id":"seytek-1991-continuation:p0343:b004:l008","ordinal":387959,"en":"You have taken blood for blood."},{"id":"seytek-1991-continuation:p0343:b004:l009","ordinal":387960,"en":"He was a match for our Er Odu."},{"id":"seytek-1991-continuation:p0343:b004:l010","ordinal":387961,"en":"You have broken the enemy's back"},{"id":"seytek-1991-continuation:p0343:b004:l011","ordinal":387962,"en":"And set Chyntengir's heart at rest!"},{"id":"seytek-1991-continuation:p0343:b005:l001","ordinal":387963,"en":"I have heard news from those who came:"},{"id":"seytek-1991-continuation:p0343:b005:l002","ordinal":387964,"en":"They say Er Kenen on Kertulpar"},{"id":"seytek-1991-continuation:p0343:b005:l003","ordinal":387965,"en":"Still stands fighting."},{"id":"seytek-1991-continuation:p0343:b005:l004","ordinal":387966,"en":"Strong men in coats,"},{"id":"seytek-1991-continuation:p0343:b005:l005","ordinal":387967,"en":"Shaven warriors girded with stones,"},{"id":"seytek-1991-continuation:p0343:b005:l006","ordinal":387968,"en":"Thick-armed heroes,"},{"id":"seytek-1991-continuation:p0343:b005:l007","ordinal":387969,"en":"Men deft and skilled with the spear,"},{"id":"seytek-1991-continuation:p0343:b005:l008","ordinal":387970,"en":"Fully armed Kaldays,"},{"id":"seytek-1991-continuation:p0343:b005:l009","ordinal":387971,"en":"Strong men swift in wrestling—"},{"id":"seytek-1991-continuation:p0343:b005:l010","ordinal":387972,"en":"They say these fell in turmoil."},{"id":"seytek-1991-continuation:p0343:b005:l011","ordinal":387973,"en":"They say he destroys without pause,"},{"id":"seytek-1991-continuation:p0343:b005:l012","ordinal":387974,"en":"And keeps inflicting hell."},{"id":"seytek-1991-continuation:p0343:b005:l013","ordinal":387975,"en":"They say he crushes the strong"},{"id":"seytek-1991-continuation:p0343:b005:l014","ordinal":387976,"en":"And beats the rage"},{"id":"seytek-1991-continuation:p0343:b005:l015","ordinal":387977,"en":"Out of courageous Kaldays."},{"id":"seytek-1991-continuation:p0343:b005:l016","ordinal":387978,"en":"May fire burst from your bones!"},{"id":"seytek-1991-continuation:p0343:b005:l017","ordinal":387979,"en":"An enemy has risen from among you:"},{"id":"seytek-1991-continuation:p0343:b005:l018","ordinal":387980,"en":"Jeljetpes has gone over to the Kyrgyz"},{"id":"seytek-1991-continuation:p0343:b005:l019","ordinal":387981,"en":"And become a rebel."},{"id":"seytek-1991-continuation:p0343:b005:l020","ordinal":387982,"en":"He has brought a day of dire disaster"},{"id":"seytek-1991-continuation:p0343:b005:l021","ordinal":387983,"en":"Upon the people of China's forty khans,"},{"id":"seytek-1991-continuation:p0343:b005:l022","ordinal":387984,"en":"And reached their very foundations."},{"id":"seytek-1991-continuation:p0343:b005:l023","ordinal":387985,"en":"Thus that black demon"},{"id":"seytek-1991-continuation:p0343:b005:l024","ordinal":387986,"en":"Has become an enemy."},{"id":"seytek-1991-continuation:p0343:b005:l025","ordinal":387987,"en":"That accursed Jeljetpes"},{"id":"seytek-1991-continuation:p0343:b005:l026","ordinal":387988,"en":"Has ruined my undertaking."},{"id":"seytek-1991-continuation:p0343:b005:l027","ordinal":387989,"en":"He has broken my back,"},{"id":"seytek-1991-continuation:p0343:b005:l028","ordinal":387990,"en":"And openly destroyed"},{"id":"seytek-1991-continuation:p0343:b005:l029","ordinal":387991,"en":"Er Odukan and Choyun Alp,"},{"id":"seytek-1991-continuation:p0343:b005:l030","ordinal":387992,"en":"Heroes such as these.”"},{"id":"seytek-1991-continuation:p0344:b001:l001","ordinal":387993,"en":"“You are the support on whom I rely,"},{"id":"seytek-1991-continuation:p0344:b001:l002","ordinal":387994,"en":"The marksman who is a shield"},{"id":"seytek-1991-continuation:p0344:b001:l003","ordinal":387995,"en":"For the Kakan of Chin-Machin."},{"id":"seytek-1991-continuation:p0344:b001:l004","ordinal":387996,"en":"Even if Jeljetpes descends underground,"},{"id":"seytek-1991-continuation:p0344:b001:l005","ordinal":387997,"en":"Capture him and bring him here."},{"id":"seytek-1991-continuation:p0344:b001:l006","ordinal":387998,"en":"Bind both his hands;"},{"id":"seytek-1991-continuation:p0344:b001:l007","ordinal":387999,"en":"Gouge out both his eyes."},{"id":"seytek-1991-continuation:p0344:b001:l008","ordinal":388000,"en":"Cut out his tongue so he cannot speak,"},{"id":"seytek-1991-continuation:p0344:b001:l009","ordinal":388001,"en":"And pierce him through the nape."},{"id":"seytek-1991-continuation:p0344:b001:l010","ordinal":388002,"en":"Put a billowing robe on him,"},{"id":"seytek-1991-continuation:p0344:b001:l011","ordinal":388003,"en":"Seat him backward on a mule,"},{"id":"seytek-1991-continuation:p0344:b001:l012","ordinal":388004,"en":"Letting him sway helplessly,"},{"id":"seytek-1991-continuation:p0344:b001:l013","ordinal":388005,"en":"And drive him here to me!"},{"id":"seytek-1991-continuation:p0344:b001:l014","ordinal":388006,"en":"He too is a champion and a lion."},{"id":"seytek-1991-continuation:p0344:b001:l015","ordinal":388007,"en":"As for Kenen, chief of the Buruts,"},{"id":"seytek-1991-continuation:p0344:b001:l016","ordinal":388008,"en":"Pure as sparkling water,"},{"id":"seytek-1991-continuation:p0344:b001:l017","ordinal":388009,"en":"The precious bringer of good fortune,"},{"id":"seytek-1991-continuation:p0344:b001:l018","ordinal":388010,"en":"Huge as the Ala-Too,"},{"id":"seytek-1991-continuation:p0344:b001:l019","ordinal":388011,"en":"A fortress like Mount Kap,"},{"id":"seytek-1991-continuation:p0344:b001:l020","ordinal":388012,"en":"Who consumes those he fights,"},{"id":"seytek-1991-continuation:p0344:b001:l021","ordinal":388013,"en":"Thick-armed and stone-hearted,"},{"id":"seytek-1991-continuation:p0344:b001:l022","ordinal":388014,"en":"A massive, well-built terror,"},{"id":"seytek-1991-continuation:p0344:b001:l023","ordinal":388015,"en":"Formidable as Alaskar,"},{"id":"seytek-1991-continuation:p0344:b001:l024","ordinal":388016,"en":"The finest of the white-capped people—"},{"id":"seytek-1991-continuation:p0344:b001:l025","ordinal":388017,"en":"Go and destroy Er Kenen;"},{"id":"seytek-1991-continuation:p0344:b001:l026","ordinal":388018,"en":"Find a way and capture him!"},{"id":"seytek-1991-continuation:p0344:b001:l027","ordinal":388019,"en":"No bullet pierces what he wears;"},{"id":"seytek-1991-continuation:p0344:b001:l028","ordinal":388020,"en":"No arrow catches what he rides."},{"id":"seytek-1991-continuation:p0344:b001:l029","ordinal":388021,"en":"Kertulpar flew like a cloud,"},{"id":"seytek-1991-continuation:p0344:b001:l030","ordinal":388022,"en":"While the champion wore his armor,"},{"id":"seytek-1991-continuation:p0344:b001:l031","ordinal":388023,"en":"And circled all Five Beijings."},{"id":"seytek-1991-continuation:p0344:b001:l032","ordinal":388024,"en":"He is a beast fit for"},{"id":"seytek-1991-continuation:p0344:b001:l033","ordinal":388025,"en":"Your champion khan Chyntengir to ride;"},{"id":"seytek-1991-continuation:p0344:b001:l034","ordinal":388026,"en":"Winged Kertulpar"},{"id":"seytek-1991-continuation:p0344:b001:l035","ordinal":388027,"en":"Is a creature worth taking as plunder.”"},{"id":"seytek-1991-continuation:p0344:b001:l036","ordinal":388028,"en":"Saying, “Remember these words,”"},{"id":"seytek-1991-continuation:p0344:b001:l037","ordinal":388029,"en":"He spoke thus to his marksman,"},{"id":"seytek-1991-continuation:p0344:b001:l038","ordinal":388030,"en":"Gave him this terrible sign,"},{"id":"seytek-1991-continuation:p0344:b001:l039","ordinal":388031,"en":"And firmly sent him against Kenen,"},{"id":"seytek-1991-continuation:p0344:b001:l040","ordinal":388032,"en":"To bring distress upon the champion,"},{"id":"seytek-1991-continuation:p0344:b001:l041","ordinal":388033,"en":"The khan of the Ala-Too."},{"id":"seytek-1991-continuation:p0344:b001:l042","ordinal":388034,"en":"Chyntengir took pride"},{"id":"seytek-1991-continuation:p0344:b001:l043","ordinal":388035,"en":"In having champion Yengkor."},{"id":"seytek-1991-continuation:p0344:b001:l044","ordinal":388036,"en":"When Yengkor chose his shot"},{"id":"seytek-1991-continuation:p0344:b001:l045","ordinal":388037,"en":"And watched for his mark,"},{"id":"seytek-1991-continuation:p0344:b001:l046","ordinal":388038,"en":"He ordered the host to surge past without stooping,"},{"id":"seytek-1991-continuation:p0344:b001:l047","ordinal":388039,"en":"To encircle him,"},{"id":"seytek-1991-continuation:p0344:b001:l048","ordinal":388040,"en":"To reach his very foundation,"},{"id":"seytek-1991-continuation:p0344:b001:l049","ordinal":388041,"en":"And spill his blood by the spoonful."},{"id":"seytek-1991-continuation:p0344:b003:l001","ordinal":388042,"en":"He ordered them to press down from the crown,"},{"id":"seytek-1991-continuation:p0344:b003:l002","ordinal":388043,"en":"And gave him a countless army"},{"id":"seytek-1991-continuation:p0344:b003:l003","ordinal":388044,"en":"Of iron lariats and nets,"},{"id":"seytek-1991-continuation:p0344:b003:l004","ordinal":388045,"en":"And men armed throughout with daggers—"},{"id":"seytek-1991-continuation:p0344:b003:l005","ordinal":388046,"en":"Gave lavishly, holding no troops back."},{"id":"seytek-1991-continuation:p0344:b003:l006","ordinal":388047,"en":"The champion became the marksman,"},{"id":"seytek-1991-continuation:p0344:b003:l007","ordinal":388048,"en":"And came toward the hero."},{"id":"seytek-1991-continuation:p0344:b003:l008","ordinal":388049,"en":"How great was his strength and skill"},{"id":"seytek-1991-continuation:p0344:b003:l009","ordinal":388050,"en":"As he came to see Er Kenen,"},{"id":"seytek-1991-continuation:p0344:b003:l010","ordinal":388051,"en":"To fight and quarrel"},{"id":"seytek-1991-continuation:p0344:b003:l011","ordinal":388052,"en":"And deliver his punishment by hand!"},{"id":"seytek-1991-continuation:p0344:b003:l012","ordinal":388053,"en":"He covered the earth in fog;"},{"id":"seytek-1991-continuation:p0344:b003:l013","ordinal":388054,"en":"Camels passed, crushing stones,"},{"id":"seytek-1991-continuation:p0344:b003:l014","ordinal":388055,"en":"And crossed water without tiring."},{"id":"seytek-1991-continuation:p0344:b003:l015","ordinal":388056,"en":"Watching ridge after ridge,"},{"id":"seytek-1991-continuation:p0344:b003:l016","ordinal":388057,"en":"He saw Kertulpar beneath Kenen,"},{"id":"seytek-1991-continuation:p0344:b003:l017","ordinal":388058,"en":"A swift, well-equipped beast."},{"id":"seytek-1991-continuation:p0344:b003:l018","ordinal":388059,"en":"Unless his limbs were broken,"},{"id":"seytek-1991-continuation:p0344:b003:l019","ordinal":388060,"en":"Unless he died and his life grew still,"},{"id":"seytek-1991-continuation:p0344:b003:l020","ordinal":388061,"en":"Unless a thousand disasters befell him,"},{"id":"seytek-1991-continuation:p0344:b003:l021","ordinal":388062,"en":"Unless only a handful of reins remained,"},{"id":"seytek-1991-continuation:p0344:b003:l022","ordinal":388063,"en":"He would never stumble into disaster;"},{"id":"seytek-1991-continuation:p0344:b003:l023","ordinal":388064,"en":"Though crimson turmoil and great calamity raged,"},{"id":"seytek-1991-continuation:p0344:b003:l024","ordinal":388065,"en":"For however many days he rode into slaughter,"},{"id":"seytek-1991-continuation:p0344:b003:l025","ordinal":388066,"en":"He would never yield to the enemy—"},{"id":"seytek-1991-continuation:p0344:b003:l026","ordinal":388067,"en":"The formidable racer Kertulpar."},{"id":"seytek-1991-continuation:p0344:b003:l027","ordinal":388068,"en":"Jeljetpes, the blessed lion,"},{"id":"seytek-1991-continuation:p0344:b003:l028","ordinal":388069,"en":"Attacked the enemy without looking back;"},{"id":"seytek-1991-continuation:p0344:b003:l029","ordinal":388070,"en":"It was his time to make slaughter."},{"id":"seytek-1991-continuation:p0344:b003:l030","ordinal":388071,"en":"On the qibla side Er Kenen"},{"id":"seytek-1991-continuation:p0344:b003:l031","ordinal":388072,"en":"Wounded everyone he faced,"},{"id":"seytek-1991-continuation:p0344:b003:l032","ordinal":388073,"en":"Threading up and down"},{"id":"seytek-1991-continuation:p0344:b003:l033","ordinal":388074,"en":"Through the countless host."},{"id":"seytek-1991-continuation:p0344:b003:l034","ordinal":388075,"en":"He thrust his spear without turning,"},{"id":"seytek-1991-continuation:p0344:b003:l035","ordinal":388076,"en":"Drenched them in bloody gore,"},{"id":"seytek-1991-continuation:p0344:b003:l036","ordinal":388077,"en":"And fought without retreating."},{"id":"seytek-1991-continuation:p0344:b003:l037","ordinal":388078,"en":"He passed swiftly through their midst,"},{"id":"seytek-1991-continuation:p0344:b003:l038","ordinal":388079,"en":"Spearing those he reached,"},{"id":"seytek-1991-continuation:p0344:b003:l039","ordinal":388080,"en":"Searching for Chyntengir."},{"id":"seytek-1991-continuation:p0344:b003:l040","ordinal":388081,"en":"Having lost the two lions,"},{"id":"seytek-1991-continuation:p0344:b003:l041","ordinal":388082,"en":"Ebegey and Kogoy,"},{"id":"seytek-1991-continuation:p0344:b003:l042","ordinal":388083,"en":"His ribs seemed broken apart;"},{"id":"seytek-1991-continuation:p0344:b003:l043","ordinal":388084,"en":"The world appeared false."},{"id":"seytek-1991-continuation:p0344:b003:l044","ordinal":388085,"en":"Black night fell upon his head,"},{"id":"seytek-1991-continuation:p0344:b003:l045","ordinal":388086,"en":"And a merciless day came;"},{"id":"seytek-1991-continuation:p0344:b003:l046","ordinal":388087,"en":"The night was caught in cloud."},{"id":"seytek-1991-continuation:p0344:b003:l047","ordinal":388088,"en":"Er Kenen, lion against the foe,"},{"id":"seytek-1991-continuation:p0344:b003:l048","ordinal":388089,"en":"Was then surpassing all"},{"id":"seytek-1991-continuation:p0344:b003:l049","ordinal":388090,"en":"In strength and courage."},{"id":"seytek-1991-continuation:p0345:b001:l001","ordinal":388091,"en":"Your gray-maned wolf was then"},{"id":"seytek-1991-continuation:p0345:b001:l002","ordinal":388092,"en":"Withstanding every calamity."},{"id":"seytek-1991-continuation:p0345:b001:l003","ordinal":388093,"en":"He fought without circling in thought,"},{"id":"seytek-1991-continuation:p0345:b001:l004","ordinal":388094,"en":"Grappled without concern,"},{"id":"seytek-1991-continuation:p0345:b001:l005","ordinal":388095,"en":"And began a violent struggle."},{"id":"seytek-1991-continuation:p0345:b001:l006","ordinal":388096,"en":"His precious, matchless life"}]
