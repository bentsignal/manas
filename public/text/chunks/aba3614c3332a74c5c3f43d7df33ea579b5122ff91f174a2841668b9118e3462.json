[{"id":"semetey-1-2013:p1048:b004:l034","ordinal":156161,"en":"They appeared like ravenous devourers."},{"id":"semetey-1-2013:p1048:b004:l035","ordinal":156162,"en":"The dense black Zhediger"},{"id":"semetey-1-2013:p1048:b004:l036","ordinal":156163,"en":"Separated into division after division,"},{"id":"semetey-1-2013:p1048:b004:l037","ordinal":156164,"en":"And split into distinct groups."},{"id":"semetey-1-2013:p1048:b004:l038","ordinal":156165,"en":"Upon the face of Bolbogur,"},{"id":"semetey-1-2013:p1048:b004:l039","ordinal":156166,"en":"At the edge rode one upon a gray horse,"},{"id":"semetey-1-2013:p1049:b003:l001","ordinal":156167,"en":"The bravest was at the front,"},{"id":"semetey-1-2013:p1049:b003:l002","ordinal":156168,"en":"And the black-horse rider at the edge."},{"id":"semetey-1-2013:p1049:b003:l003","ordinal":156169,"en":"All those bearing spears"},{"id":"semetey-1-2013:p1049:b003:l004","ordinal":156170,"en":"Rode ahead and separated;"},{"id":"semetey-1-2013:p1049:b003:l005","ordinal":156171,"en":"Champions who struck with battle-axes"},{"id":"semetey-1-2013:p1049:b003:l006","ordinal":156172,"en":"Appeared along either flank."},{"id":"semetey-1-2013:p1049:b003:l007","ordinal":156173,"en":"Those skilled at drawing bows,"},{"id":"semetey-1-2013:p1049:b003:l008","ordinal":156174,"en":"The finest marksmen with guns,"},{"id":"semetey-1-2013:p1049:b003:l009","ordinal":156175,"en":"Spread out and inflicted hardship."},{"id":"semetey-1-2013:p1049:b003:l010","ordinal":156176,"en":"Those who would not bend beneath a whip"},{"id":"semetey-1-2013:p1049:b003:l011","ordinal":156177,"en":"He separated as champions;"},{"id":"semetey-1-2013:p1049:b003:l012","ordinal":156178,"en":"Those who would not flinch beneath a sword"},{"id":"semetey-1-2013:p1049:b003:l013","ordinal":156179,"en":"He separated as formidable men;"},{"id":"semetey-1-2013:p1049:b003:l014","ordinal":156180,"en":"Those who would not flee"},{"id":"semetey-1-2013:p1049:b003:l015","ordinal":156181,"en":"When a black musket cracked,"},{"id":"semetey-1-2013:p1049:b003:l016","ordinal":156182,"en":"Those who would not start"},{"id":"semetey-1-2013:p1049:b003:l017","ordinal":156183,"en":"When a fierce gun snapped,"},{"id":"semetey-1-2013:p1049:b003:l018","ordinal":156184,"en":"He gathered and drove together."},{"id":"semetey-1-2013:p1049:b003:l019","ordinal":156185,"en":"Chynkozho, son of Shygay,"},{"id":"semetey-1-2013:p1049:b003:l020","ordinal":156186,"en":"Kozho, resolute in his deeds,"},{"id":"semetey-1-2013:p1049:b003:l021","ordinal":156187,"en":"Had begun a great upheaval."},{"id":"semetey-1-2013:p1049:b003:l022","ordinal":156188,"en":"If we do not give Chürök in tribute,"},{"id":"semetey-1-2013:p1049:b003:l023","ordinal":156189,"en":"An army comes that will overrun us;"},{"id":"semetey-1-2013:p1049:b003:l024","ordinal":156190,"en":"When he rages and attacks,"},{"id":"semetey-1-2013:p1049:b003:l025","ordinal":156191,"en":"Mighty Toltoy comes,"},{"id":"semetey-1-2013:p1049:b003:l026","ordinal":156192,"en":"One who will begin the great tumult."},{"id":"semetey-1-2013:p1049:b003:l027","ordinal":156193,"en":"All the Zhediger,"},{"id":"semetey-1-2013:p1049:b003:l028","ordinal":156194,"en":"With the accomplished elder Tölök,"},{"id":"semetey-1-2013:p1049:b003:l029","ordinal":156195,"en":"Brandishing their spears,"},{"id":"semetey-1-2013:p1049:b003:l030","ordinal":156196,"en":"Had made themselves ready."},{"id":"semetey-1-2013:p1049:b003:l031","ordinal":156197,"en":"The Zhediger had gathered"},{"id":"semetey-1-2013:p1049:b003:l032","ordinal":156198,"en":"Around Buloo Khan."},{"id":"semetey-1-2013:p1049:b003:l033","ordinal":156199,"en":"If we do not accept his demand,"},{"id":"semetey-1-2013:p1049:b003:l034","ordinal":156200,"en":"If we do not give Aychürök,"},{"id":"semetey-1-2013:p1049:b003:l035","ordinal":156201,"en":"They will overrun us utterly and attack,"},{"id":"semetey-1-2013:p1049:b003:l036","ordinal":156202,"en":"Turn water into their orchards,"},{"id":"semetey-1-2013:p1049:b003:l037","ordinal":156203,"en":"And make gardens of our land;"},{"id":"semetey-1-2013:p1049:b003:l038","ordinal":156204,"en":"They will channel water all around,"},{"id":"semetey-1-2013:p1049:b003:l039","ordinal":156205,"en":"And every one of them will spur in,"},{"id":"semetey-1-2013:p1049:b005:l001","ordinal":156206,"en":"And emerge everywhere alike."},{"id":"semetey-1-2013:p1049:b005:l002","ordinal":156207,"en":"If we do not give Aychürök,"},{"id":"semetey-1-2013:p1049:b005:l003","ordinal":156208,"en":"If we do not accept his words,"},{"id":"semetey-1-2013:p1049:b005:l004","ordinal":156209,"en":"They will demolish every house,"},{"id":"semetey-1-2013:p1049:b005:l005","ordinal":156210,"en":"Cut down and topple the willows,"},{"id":"semetey-1-2013:p1049:b005:l006","ordinal":156211,"en":"And raze it all smooth."},{"id":"semetey-1-2013:p1049:b005:l007","ordinal":156212,"en":"In Akun's old age,"},{"id":"semetey-1-2013:p1049:b005:l008","ordinal":156213,"en":"Saying, \"He will not give his old maid daughter,\""},{"id":"semetey-1-2013:p1049:b005:l009","ordinal":156214,"en":"They will humiliate him!"},{"id":"semetey-1-2013:p1049:b005:l010","ordinal":156215,"en":"Azhybay and Tümönbay—"},{"id":"semetey-1-2013:p1049:b005:l011","ordinal":156216,"en":"They will enslave us both"},{"id":"semetey-1-2013:p1049:b005:l012","ordinal":156217,"en":"And send us to tend their horses!\""},{"id":"semetey-1-2013:p1049:b005:l013","ordinal":156218,"en":"So saying and tormenting himself, Azhybay,"},{"id":"semetey-1-2013:p1049:b005:l014","ordinal":156219,"en":"After he had seen this,"},{"id":"semetey-1-2013:p1049:b005:l015","ordinal":156220,"en":"Lost the strength of his arms,"},{"id":"semetey-1-2013:p1049:b005:l016","ordinal":156221,"en":"And the courage left his heart."},{"id":"semetey-1-2013:p1049:b005:l017","ordinal":156222,"en":"The Zhediger had begun their affliction;"},{"id":"semetey-1-2013:p1049:b005:l018","ordinal":156223,"en":"When he saw this display,"},{"id":"semetey-1-2013:p1049:b005:l019","ordinal":156224,"en":"Azhybay proved a coward"},{"id":"semetey-1-2013:p1049:b005:l020","ordinal":156225,"en":"And nearly fell"},{"id":"semetey-1-2013:p1049:b005:l021","ordinal":156226,"en":"From the top of the tower."},{"id":"semetey-1-2013:p1049:b005:l022","ordinal":156227,"en":"Taking the shortcut down the tower,"},{"id":"semetey-1-2013:p1049:b005:l023","ordinal":156228,"en":"Tümönbay led Azhybay down,"},{"id":"semetey-1-2013:p1049:b005:l024","ordinal":156229,"en":"With the greatest struggle,"},{"id":"semetey-1-2013:p1049:b005:l025","ordinal":156230,"en":"Until he had brought him below."},{"id":"semetey-1-2013:p1049:b005:l026","ordinal":156231,"en":"Azhybay, terrified and distraught,"},{"id":"semetey-1-2013:p1049:b005:l027","ordinal":156232,"en":"Pleaded with Tümönbay:"},{"id":"semetey-1-2013:p1049:b005:l028","ordinal":156233,"en":"\"My dear Tümönbay!"},{"id":"semetey-1-2013:p1049:b005:l029","ordinal":156234,"en":"Because of Aychürök,"},{"id":"semetey-1-2013:p1049:b005:l030","ordinal":156235,"en":"Mortal danger has come upon us;"},{"id":"semetey-1-2013:p1049:b005:l031","ordinal":156236,"en":"With mighty Kozho at their head,"},{"id":"semetey-1-2013:p1049:b005:l032","ordinal":156237,"en":"An army comes that will overrun us."},{"id":"semetey-1-2013:p1049:b005:l033","ordinal":156238,"en":"If we do not go out to meet them,"},{"id":"semetey-1-2013:p1049:b005:l034","ordinal":156239,"en":"Driving eighty fat barren mares,"},{"id":"semetey-1-2013:p1049:b005:l035","ordinal":156240,"en":"All of them matching gray beasts,"},{"id":"semetey-1-2013:p1049:b005:l036","ordinal":156241,"en":"And carry them as tribute,"},{"id":"semetey-1-2013:p1049:b005:l037","ordinal":156242,"en":"Halt their great army,"},{"id":"semetey-1-2013:p1049:b005:l038","ordinal":156243,"en":"And gain a seven-day reprieve,"},{"id":"semetey-1-2013:p1049:b005:l039","ordinal":156244,"en":"The dense black Zhediger"}]
