[{"id":"semetey-1-2013:p0851:b003:l032","ordinal":142081,"en":"Putting all his skill into his work,"},{"id":"semetey-1-2013:p0851:b003:l033","ordinal":142082,"en":"While leopard Manas lived,"},{"id":"semetey-1-2013:p0851:b003:l034","ordinal":142083,"en":"All that equipment"},{"id":"semetey-1-2013:p0851:b003:l035","ordinal":142084,"en":"He fashioned to fit perfectly."},{"id":"semetey-1-2013:p0851:b003:l036","ordinal":142085,"en":"He was a man of sacred power;"},{"id":"semetey-1-2013:p0851:b003:l037","ordinal":142086,"en":"Khan Manas's treasury"},{"id":"semetey-1-2013:p0851:b003:l038","ordinal":142087,"en":"He was the one who guarded."},{"id":"semetey-1-2013:p0851:b003:l039","ordinal":142088,"en":"Once, when Manas died,"},{"id":"semetey-1-2013:p0851:b005:l001","ordinal":142089,"en":"When his poor soul knew grief,"},{"id":"semetey-1-2013:p0851:b005:l002","ordinal":142090,"en":"When the six villains divided the livestock,"},{"id":"semetey-1-2013:p0851:b005:l003","ordinal":142091,"en":"When they plundered the valuables,"},{"id":"semetey-1-2013:p0851:b005:l004","ordinal":142092,"en":"When the six villains wrought great wickedness,"},{"id":"semetey-1-2013:p0851:b005:l005","ordinal":142093,"en":"Then the lame smith Bolokbay,"},{"id":"semetey-1-2013:p0851:b005:l006","ordinal":142094,"en":"His forty guards at his side,"},{"id":"semetey-1-2013:p0851:b005:l007","ordinal":142095,"en":"They survived, escaping death."},{"id":"semetey-1-2013:p0851:b005:l008","ordinal":142096,"en":"Supremely capable Bolokbay"},{"id":"semetey-1-2013:p0851:b005:l009","ordinal":142097,"en":"Fought against the six villains."},{"id":"semetey-1-2013:p0851:b005:l010","ordinal":142098,"en":"In turmoil they lay,"},{"id":"semetey-1-2013:p0851:b005:l011","ordinal":142099,"en":"Too far apart to reach each other,"},{"id":"semetey-1-2013:p0851:b005:l012","ordinal":142100,"en":"Firing guns at one another."},{"id":"semetey-1-2013:p0851:b005:l013","ordinal":142101,"en":"Standing opposite each other,"},{"id":"semetey-1-2013:p0851:b005:l014","ordinal":142102,"en":"Unable to reach with their lances,"},{"id":"semetey-1-2013:p0851:b005:l015","ordinal":142103,"en":"They battled with guns."},{"id":"semetey-1-2013:p0851:b005:l016","ordinal":142104,"en":"Many a khan they met died,"},{"id":"semetey-1-2013:p0851:b005:l017","ordinal":142105,"en":"Those whose hour had come died."},{"id":"semetey-1-2013:p0851:b005:l018","ordinal":142106,"en":"Clouds gathered in the sky;"},{"id":"semetey-1-2013:p0851:b005:l019","ordinal":142107,"en":"The lame smith Bolokbay,"},{"id":"semetey-1-2013:p0851:b005:l020","ordinal":142108,"en":"Robbed of his wealth,"},{"id":"semetey-1-2013:p0851:b005:l021","ordinal":142109,"en":"To the mountain of Kaiypchy,"},{"id":"semetey-1-2013:p0851:b005:l022","ordinal":142110,"en":"Leading his forty guards,"},{"id":"semetey-1-2013:p0851:b005:l023","ordinal":142111,"en":"Escaped death in flight."},{"id":"semetey-1-2013:p0851:b005:l024","ordinal":142112,"en":"For twelve years Bolokbay"},{"id":"semetey-1-2013:p0851:b005:l025","ordinal":142113,"en":"Saw night instead of day."},{"id":"semetey-1-2013:p0851:b005:l026","ordinal":142114,"en":"If called dead, he was not in the grave;"},{"id":"semetey-1-2013:p0851:b005:l027","ordinal":142115,"en":"If called alive, he was not counted."},{"id":"semetey-1-2013:p0851:b005:l028","ordinal":142116,"en":"He lived in such a way."},{"id":"semetey-1-2013:p0851:b005:l029","ordinal":142117,"en":"A goatskin coat upon his body,"},{"id":"semetey-1-2013:p0851:b005:l030","ordinal":142118,"en":"Hide trousers upon his buttocks,"},{"id":"semetey-1-2013:p0851:b005:l031","ordinal":142119,"en":"Bolokbay and the forty guards,"},{"id":"semetey-1-2013:p0851:b005:l032","ordinal":142120,"en":"When the leopard orphan came,"},{"id":"semetey-1-2013:p0851:b005:l033","ordinal":142121,"en":"Cast off all their grief."},{"id":"semetey-1-2013:p0851:b005:l034","ordinal":142122,"en":"The gray ram they led"},{"id":"semetey-1-2013:p0851:b005:l035","ordinal":142123,"en":"They slaughtered for Bahauddin."},{"id":"semetey-1-2013:p0851:b005:l036","ordinal":142124,"en":"They wore robes from the treasury,"},{"id":"semetey-1-2013:p0851:b005:l037","ordinal":142125,"en":"Ate their food without sorrow,"},{"id":"semetey-1-2013:p0851:b005:l038","ordinal":142126,"en":"Their extinguished fire rekindled,"},{"id":"semetey-1-2013:p0851:b005:l039","ordinal":142127,"en":"Their dead souls came to life,"},{"id":"semetey-1-2013:p0852:b003:l001","ordinal":142128,"en":"What was severed joined again,"},{"id":"semetey-1-2013:p0852:b003:l002","ordinal":142129,"en":"What was scattered gathered,"},{"id":"semetey-1-2013:p0852:b003:l003","ordinal":142130,"en":"His knees bent to the earth,"},{"id":"semetey-1-2013:p0852:b003:l004","ordinal":142131,"en":"Tears streaming in ten directions,"},{"id":"semetey-1-2013:p0852:b003:l005","ordinal":142132,"en":"Bolokbay with the forty guards"},{"id":"semetey-1-2013:p0852:b003:l006","ordinal":142133,"en":"Ran toward Kanykey."},{"id":"semetey-1-2013:p0852:b003:l007","ordinal":142134,"en":"What could the poor lame man do?"},{"id":"semetey-1-2013:p0852:b003:l008","ordinal":142135,"en":"His white beard had thinned;"},{"id":"semetey-1-2013:p0852:b003:l009","ordinal":142136,"en":"Tears flowing from both eyes"},{"id":"semetey-1-2013:p0852:b003:l010","ordinal":142137,"en":"Poured down past his collarbones."},{"id":"semetey-1-2013:p0852:b003:l011","ordinal":142138,"en":"Bolokbay came to greet her:"},{"id":"semetey-1-2013:p0852:b003:l012","ordinal":142139,"en":"“My dear Kanykey,"},{"id":"semetey-1-2013:p0852:b003:l013","ordinal":142140,"en":"Queen of the khan, my foal!"},{"id":"semetey-1-2013:p0852:b003:l014","ordinal":142141,"en":"To Temir Khan's city,"},{"id":"semetey-1-2013:p0852:b003:l015","ordinal":142142,"en":"Were you the one who would wander away?"},{"id":"semetey-1-2013:p0852:b003:l016","ordinal":142143,"en":"To the mountain of Kaiypchy,"},{"id":"semetey-1-2013:p0852:b003:l017","ordinal":142144,"en":"Distracted, finding no support,"},{"id":"semetey-1-2013:p0852:b003:l018","ordinal":142145,"en":"Was I the one who would flee?"},{"id":"semetey-1-2013:p0852:b003:l019","ordinal":142146,"en":"Is this God's Night of Power,"},{"id":"semetey-1-2013:p0852:b003:l020","ordinal":142147,"en":"Bringing joy to this ill-fated soul?"},{"id":"semetey-1-2013:p0852:b003:l021","ordinal":142148,"en":"Is this the day the queen arrives?"},{"id":"semetey-1-2013:p0852:b003:l022","ordinal":142149,"en":"While I lived in Kaiypchy,"},{"id":"semetey-1-2013:p0852:b003:l023","ordinal":142150,"en":"Long I lived in desolation."},{"id":"semetey-1-2013:p0852:b003:l024","ordinal":142151,"en":"Royal queen, unfortunate one,"},{"id":"semetey-1-2013:p0852:b003:l025","ordinal":142152,"en":"I thought I would see you only in death!"},{"id":"semetey-1-2013:p0852:b003:l026","ordinal":142153,"en":"Is it Kanykey herself?"},{"id":"semetey-1-2013:p0852:b003:l027","ordinal":142154,"en":"Has she come here alive?”"},{"id":"semetey-1-2013:p0852:b003:l028","ordinal":142155,"en":"Bolokbay and the forty guards"},{"id":"semetey-1-2013:p0852:b003:l029","ordinal":142156,"en":"Came weeping, saying this."},{"id":"semetey-1-2013:p0852:b003:l030","ordinal":142157,"en":"Before much time had passed,"},{"id":"semetey-1-2013:p0852:b003:l031","ordinal":142158,"en":"Let us leave that aside,"},{"id":"semetey-1-2013:p0852:b003:l032","ordinal":142159,"en":"And begin with this other part."},{"id":"semetey-1-2013:p0852:b003:l033","ordinal":142160,"en":"To Sultan Manas, the warrior,"},{"id":"semetey-1-2013:p0852:b003:l034","ordinal":142161,"en":"Surging with valor,"},{"id":"semetey-1-2013:p0852:b003:l035","ordinal":142162,"en":"He met him at thirty-four years of age."},{"id":"semetey-1-2013:p0852:b003:l036","ordinal":142163,"en":"A star was stirred in the heavens;"},{"id":"semetey-1-2013:p0852:b003:l037","ordinal":142164,"en":"With Manas, becoming friends twelve times,"},{"id":"semetey-1-2013:p0852:b003:l038","ordinal":142165,"en":"They fought the enemy together,"},{"id":"semetey-1-2013:p0852:b003:l039","ordinal":142166,"en":"Wrought slaughter together,"},{"id":"semetey-1-2013:p0852:b004:l001","ordinal":142167,"en":"Stood together in times of excitement."},{"id":"semetey-1-2013:p0852:b004:l002","ordinal":142168,"en":"They scouted together,"},{"id":"semetey-1-2013:p0852:b004:l003","ordinal":142169,"en":"Raised strife together,"},{"id":"semetey-1-2013:p0852:b004:l004","ordinal":142170,"en":"Who seized horses from foreign speakers with me,"},{"id":"semetey-1-2013:p0852:b004:l005","ordinal":142171,"en":"Went to face death together,"},{"id":"semetey-1-2013:p0852:b004:l006","ordinal":142172,"en":"Known as Manas and Bakai,"},{"id":"semetey-1-2013:p0852:b004:l007","ordinal":142173,"en":"The two astonished the world."},{"id":"semetey-1-2013:p0852:b004:l008","ordinal":142174,"en":"The rulers of so many people"},{"id":"semetey-1-2013:p0852:b004:l009","ordinal":142175,"en":"Wrought slaughter among the Chinese."},{"id":"semetey-1-2013:p0852:b004:l010","ordinal":142176,"en":"With leopard Manas, the lion,"},{"id":"semetey-1-2013:p0852:b004:l011","ordinal":142177,"en":"Sharing their gains in life,"},{"id":"semetey-1-2013:p0852:b004:l012","ordinal":142178,"en":"Sharing their faith in death."},{"id":"semetey-1-2013:p0852:b004:l013","ordinal":142179,"en":"His boundless valor surging,"},{"id":"semetey-1-2013:p0852:b004:l014","ordinal":142180,"en":"To King Manas, the sultan,"},{"id":"semetey-1-2013:p0852:b004:l015","ordinal":142181,"en":"He came as a protector."},{"id":"semetey-1-2013:p0852:b004:l016","ordinal":142182,"en":"Renowned Manas,"},{"id":"semetey-1-2013:p0852:b004:l017","ordinal":142183,"en":"He built up into a house,"},{"id":"semetey-1-2013:p0852:b004:l018","ordinal":142184,"en":"He planted into a garden."},{"id":"semetey-1-2013:p0852:b004:l019","ordinal":142185,"en":"Renowned Manas"},{"id":"semetey-1-2013:p0852:b004:l020","ordinal":142186,"en":"He made a formidable khan of weight."},{"id":"semetey-1-2013:p0852:b004:l021","ordinal":142187,"en":"His uncle, old Bakai,"},{"id":"semetey-1-2013:p0852:b004:l022","ordinal":142188,"en":"Was a sage of surpassing knowledge."},{"id":"semetey-1-2013:p0852:b004:l023","ordinal":142189,"en":"His uncle Bakai, a boundless hero,"},{"id":"semetey-1-2013:p0852:b004:l024","ordinal":142190,"en":"Than Manas, gone to the other world,"},{"id":"semetey-1-2013:p0852:b004:l025","ordinal":142191,"en":"Was a lion greater in knowledge."},{"id":"semetey-1-2013:p0852:b004:l026","ordinal":142192,"en":"Finding solutions beyond all others,"},{"id":"semetey-1-2013:p0852:b004:l027","ordinal":142193,"en":"Lion Bakai, the wise man."},{"id":"semetey-1-2013:p0852:b004:l028","ordinal":142194,"en":"If you ask of the wolf-maned one's state,"},{"id":"semetey-1-2013:p0852:b004:l029","ordinal":142195,"en":"He wore a blue lynx-fur cap,"},{"id":"semetey-1-2013:p0852:b004:l030","ordinal":142196,"en":"Brandished a blue-mottled shield,"},{"id":"semetey-1-2013:p0852:b004:l031","ordinal":142197,"en":"Who wrapped his head in gold,"},{"id":"semetey-1-2013:p0852:b004:l032","ordinal":142198,"en":"Ended up in gold,"},{"id":"semetey-1-2013:p0852:b004:l033","ordinal":142199,"en":"Bakai Khan, the son of Bai,"},{"id":"semetey-1-2013:p0852:b004:l034","ordinal":142200,"en":"Rinsed his mouth with honey."},{"id":"semetey-1-2013:p0852:b004:l035","ordinal":142201,"en":"He found words at an unexpected moment,"},{"id":"semetey-1-2013:p0852:b004:l036","ordinal":142202,"en":"Found eyes in the dark."},{"id":"semetey-1-2013:p0852:b004:l037","ordinal":142203,"en":"He would not be entangled in wicked words;"},{"id":"semetey-1-2013:p0852:b004:l038","ordinal":142204,"en":"In the dark, upon a corsac fox's"},{"id":"semetey-1-2013:p0852:b004:l039","ordinal":142205,"en":"Trail, he would never lose his way."},{"id":"semetey-1-2013:p0853:b003:l001","ordinal":142206,"en":"Set at the head, he brought good fortune,"},{"id":"semetey-1-2013:p0853:b003:l002","ordinal":142207,"en":"Watch him: he was worth a countless army."},{"id":"semetey-1-2013:p0853:b003:l003","ordinal":142208,"en":"The lion, elder Bakai—"},{"id":"semetey-1-2013:p0853:b003:l004","ordinal":142209,"en":"In this world the one God"},{"id":"semetey-1-2013:p0853:b003:l005","ordinal":142210,"en":"Had made him a true holy sage."},{"id":"semetey-1-2013:p0853:b003:l006","ordinal":142211,"en":"When dear Manas died,"},{"id":"semetey-1-2013:p0853:b003:l007","ordinal":142212,"en":"After he had passed away,"},{"id":"semetey-1-2013:p0853:b003:l008","ordinal":142213,"en":"For Semetey and Kanykei,"},{"id":"semetey-1-2013:p0853:b003:l009","ordinal":142214,"en":"For the sake of those two,"},{"id":"semetey-1-2013:p0853:b003:l010","ordinal":142215,"en":"At Bek-Zhayloo, at the head of Besh-Tash,"},{"id":"semetey-1-2013:p0853:b003:l011","ordinal":142216,"en":"With five hundred households under him,"},{"id":"semetey-1-2013:p0853:b003:l012","ordinal":142217,"en":"He settled in hiding;"},{"id":"semetey-1-2013:p0853:b003:l013","ordinal":142218,"en":"Against the six villains, Bakai"},{"id":"semetey-1-2013:p0853:b003:l014","ordinal":142219,"en":"Fought for twelve years."},{"id":"semetey-1-2013:p0853:b003:l015","ordinal":142220,"en":"When Manas died,"},{"id":"semetey-1-2013:p0853:b003:l016","ordinal":142221,"en":"He gave up his lordship,"},{"id":"semetey-1-2013:p0853:b003:l017","ordinal":142222,"en":"Herding camels, tending livestock,"},{"id":"semetey-1-2013:p0853:b003:l018","ordinal":142223,"en":"He took up this way of life;"},{"id":"semetey-1-2013:p0853:b003:l019","ordinal":142224,"en":"When his lord Manas died,"},{"id":"semetey-1-2013:p0853:b003:l020","ordinal":142225,"en":"He turned toward a life of hardship."},{"id":"semetey-1-2013:p0853:b003:l021","ordinal":142226,"en":"Stirred by the sight of the royal camp,"},{"id":"semetey-1-2013:p0853:b003:l022","ordinal":142227,"en":"With five hundred households under him,"},{"id":"semetey-1-2013:p0853:b003:l023","ordinal":142228,"en":"Argyn and Kyrgyz together,"},{"id":"semetey-1-2013:p0853:b003:l024","ordinal":142229,"en":"He too came with them all."},{"id":"semetey-1-2013:p0853:b003:l025","ordinal":142230,"en":"Meeting Kanykei,"},{"id":"semetey-1-2013:p0853:b003:l026","ordinal":142231,"en":"Your dear uncle Bakai's"},{"id":"semetey-1-2013:p0853:b003:l027","ordinal":142232,"en":"Stature and dignity,"},{"id":"semetey-1-2013:p0853:b003:l028","ordinal":142233,"en":"His bearing on horseback,"},{"id":"semetey-1-2013:p0853:b003:l029","ordinal":142234,"en":"Seemed all the finer."},{"id":"semetey-1-2013:p0853:b003:l030","ordinal":142235,"en":"Shining at the head of the migration,"},{"id":"semetey-1-2013:p0853:b003:l031","ordinal":142236,"en":"Calling like a migrating goose,"},{"id":"semetey-1-2013:p0853:b003:l032","ordinal":142237,"en":"Making ready with Kokcholok,"},{"id":"semetey-1-2013:p0853:b003:l033","ordinal":142238,"en":"Springing like a blue tiger,"},{"id":"semetey-1-2013:p0853:b003:l034","ordinal":142239,"en":"Had you seen him then,"},{"id":"semetey-1-2013:p0853:b003:l035","ordinal":142240,"en":"Praying to the one God,"},{"id":"semetey-1-2013:p0853:b003:l036","ordinal":142241,"en":"Lord Bakai was coming."},{"id":"semetey-1-2013:p0853:b003:l037","ordinal":142242,"en":"Kanykei, whose child had returned,"},{"id":"semetey-1-2013:p0853:b003:l038","ordinal":142243,"en":"When she saw Khan Bakai,"},{"id":"semetey-1-2013:p0853:b003:l039","ordinal":142244,"en":"Spoke no word, said nothing."},{"id":"semetey-1-2013:p0853:b004:l001","ordinal":142245,"en":"Poor Kanykei—"},{"id":"semetey-1-2013:p0853:b004:l002","ordinal":142246,"en":"Did you see how modest she was?"},{"id":"semetey-1-2013:p0853:b004:l003","ordinal":142247,"en":"Her voice had reached God;"},{"id":"semetey-1-2013:p0853:b004:l004","ordinal":142248,"en":"Unable to look Bakai in the face,"},{"id":"semetey-1-2013:p0853:b004:l005","ordinal":142249,"en":"She covered her eyes and fell."},{"id":"semetey-1-2013:p0853:b004:l006","ordinal":142250,"en":"While Kanykei was like this,"},{"id":"semetey-1-2013:p0853:b004:l007","ordinal":142251,"en":"Grandmother Chyiyrdy"},{"id":"semetey-1-2013:p0853:b004:l008","ordinal":142252,"en":"Came out to welcome Bakai."},{"id":"semetey-1-2013:p0853:b004:l009","ordinal":142253,"en":"When he saw Chyiyrdy,"},{"id":"semetey-1-2013:p0853:b004:l010","ordinal":142254,"en":"The hero, elder Bakai,"},{"id":"semetey-1-2013:p0853:b004:l011","ordinal":142255,"en":"Wept and wept in anguish,"},{"id":"semetey-1-2013:p0853:b004:l012","ordinal":142256,"en":"Pleading with Chyiyrdy."},{"id":"semetey-1-2013:p0853:b004:l013","ordinal":142257,"en":"When he saw Chyiyrdy,"},{"id":"semetey-1-2013:p0853:b004:l014","ordinal":142258,"en":"His heart was sorely troubled;"},{"id":"semetey-1-2013:p0853:b004:l015","ordinal":142259,"en":"Your uncle, elder Bakai,"},{"id":"semetey-1-2013:p0853:b004:l016","ordinal":142260,"en":"With tears pouring from his eyes:"},{"id":"semetey-1-2013:p0853:b004:l017","ordinal":142261,"en":"“Elder of ninety-five,"},{"id":"semetey-1-2013:p0853:b004:l018","ordinal":142262,"en":"Holy sage as great as a mountain!"},{"id":"semetey-1-2013:p0853:b004:l019","ordinal":142263,"en":"You bore a lion among sons,"},{"id":"semetey-1-2013:p0853:b004:l020","ordinal":142264,"en":"You bore a lion among daughters,"},{"id":"semetey-1-2013:p0853:b004:l021","ordinal":142265,"en":"My noble, venerable mother,"},{"id":"semetey-1-2013:p0853:b004:l022","ordinal":142266,"en":"My holy sage with a golden womb!"},{"id":"semetey-1-2013:p0853:b004:l023","ordinal":142267,"en":"Until he reached twelve years of age,"},{"id":"semetey-1-2013:p0853:b004:l024","ordinal":142268,"en":"I lived by herding camels—"},{"id":"semetey-1-2013:p0853:b004:l025","ordinal":142269,"en":"Was this conduct of mine bad?"},{"id":"semetey-1-2013:p0853:b004:l026","ordinal":142270,"en":"To Temir Khan's city"},{"id":"semetey-1-2013:p0853:b004:l027","ordinal":142271,"en":"You wandered, then returned;"},{"id":"semetey-1-2013:p0853:b004:l028","ordinal":142272,"en":"My mother, my ocean, are you well?"},{"id":"semetey-1-2013:p0853:b004:l029","ordinal":142273,"en":"A member of a royal household,"},{"id":"semetey-1-2013:p0853:b004:l030","ordinal":142274,"en":"Mother, should you have to live in flight?!"},{"id":"semetey-1-2013:p0853:b004:l031","ordinal":142275,"en":"You turned your heart toward righteousness,"},{"id":"semetey-1-2013:p0853:b004:l032","ordinal":142276,"en":"You have found your way back"},{"id":"semetey-1-2013:p0853:b004:l033","ordinal":142277,"en":"To your own land of Talas!"},{"id":"semetey-1-2013:p0853:b004:l034","ordinal":142278,"en":"Zhylgyndy, Keng-Kol, broad Talas—"},{"id":"semetey-1-2013:p0853:b004:l035","ordinal":142279,"en":"You have seen your plain, mother!"},{"id":"semetey-1-2013:p0853:b004:l036","ordinal":142280,"en":"The great pauper who herded camels—"},{"id":"semetey-1-2013:p0853:b004:l037","ordinal":142281,"en":"You have seen your child, mother!"},{"id":"semetey-1-2013:p0853:b004:l038","ordinal":142282,"en":"The broad royal camp left by your child Manas—"},{"id":"semetey-1-2013:p0853:b004:l039","ordinal":142283,"en":"You have seen your town, mother!”"},{"id":"semetey-1-2013:p0854:b003:l001","ordinal":142284,"en":"Poor elder Bakai,"},{"id":"semetey-1-2013:p0854:b003:l002","ordinal":142285,"en":"His voice reaching God,"},{"id":"semetey-1-2013:p0854:b003:l003","ordinal":142286,"en":"From Kokcholok's back"},{"id":"semetey-1-2013:p0854:b003:l004","ordinal":142287,"en":"Bakai swayed and fell."},{"id":"semetey-1-2013:p0854:b003:l005","ordinal":142288,"en":"Khan Bakai laid his head"},{"id":"semetey-1-2013:p0854:b003:l006","ordinal":142289,"en":"Upon Chyiyrdy's breast,"},{"id":"semetey-1-2013:p0854:b003:l007","ordinal":142290,"en":"Taking in the scent of her breast,"},{"id":"semetey-1-2013:p0854:b003:l008","ordinal":142291,"en":"Saying, “Oh, my mother,” as he did so."},{"id":"semetey-1-2013:p0854:b003:l009","ordinal":142292,"en":"Like clouds in the sky,"},{"id":"semetey-1-2013:p0854:b003:l010","ordinal":142293,"en":"Here they caressed one another;"},{"id":"semetey-1-2013:p0854:b003:l011","ordinal":142294,"en":"The poor souls who had wandered"},{"id":"semetey-1-2013:p0854:b003:l012","ordinal":142295,"en":"Were reunited here!"},{"id":"semetey-1-2013:p0854:b003:l013","ordinal":142296,"en":"The orphan and the widow—"},{"id":"semetey-1-2013:p0854:b003:l014","ordinal":142297,"en":"When Bakai arrived and saw them,"},{"id":"semetey-1-2013:p0854:b003:l015","ordinal":142298,"en":"Your old uncle Bakai wept,"},{"id":"semetey-1-2013:p0854:b003:l016","ordinal":142299,"en":"All the Argyn and Kyrgyz wept."},{"id":"semetey-1-2013:p0854:b003:l017","ordinal":142300,"en":"Burulcha, Esen Khan's daughter,"},{"id":"semetey-1-2013:p0854:b003:l018","ordinal":142301,"en":"Birmyskal, Ay Zhang-Zhung's daughter,"},{"id":"semetey-1-2013:p0854:b003:l019","ordinal":142302,"en":"Both widows wept together,"},{"id":"semetey-1-2013:p0854:b003:l020","ordinal":142303,"en":"Looking at them as they sat,"},{"id":"semetey-1-2013:p0854:b003:l021","ordinal":142304,"en":"Weeping bitterly in their sorrow."},{"id":"semetey-1-2013:p0854:b003:l022","ordinal":142305,"en":"The orphans left by the heroes—"},{"id":"semetey-1-2013:p0854:b003:l023","ordinal":142306,"en":"One was Almambet's Kulchoro,"},{"id":"semetey-1-2013:p0854:b003:l024","ordinal":142307,"en":"The other, Khan Chubak's Kanchoro—"},{"id":"semetey-1-2013:p0854:b003:l025","ordinal":142308,"en":"The two came into view;"},{"id":"semetey-1-2013:p0854:b003:l026","ordinal":142309,"en":"When they saw Kanykei,"},{"id":"semetey-1-2013:p0854:b003:l027","ordinal":142310,"en":"Tears poured from their eyes."},{"id":"semetey-1-2013:p0854:b003:l028","ordinal":142311,"en":"When she saw these orphans,"},{"id":"semetey-1-2013:p0854:b003:l029","ordinal":142312,"en":"Your dear mother Kanykei,"},{"id":"semetey-1-2013:p0854:b003:l030","ordinal":142313,"en":"Her heart torn apart,"},{"id":"semetey-1-2013:p0854:b003:l031","ordinal":142314,"en":"Tears pouring from her eyes,"},{"id":"semetey-1-2013:p0854:b003:l032","ordinal":142315,"en":"Her ribs coming apart,"},{"id":"semetey-1-2013:p0854:b003:l033","ordinal":142316,"en":"Tears pouring from her eyes,"},{"id":"semetey-1-2013:p0854:b003:l034","ordinal":142317,"en":"Unable to sniff back her running nose,"},{"id":"semetey-1-2013:p0854:b003:l035","ordinal":142318,"en":"Unable to wipe away her tears,"},{"id":"semetey-1-2013:p0854:b003:l036","ordinal":142319,"en":"Cried out at the sight of the orphans."},{"id":"semetey-1-2013:p0854:b003:l037","ordinal":142320,"en":"From her dear quail-like eyes,"},{"id":"semetey-1-2013:p0854:b003:l038","ordinal":142321,"en":"Tears fell in separate streams."},{"id":"semetey-1-2013:p0854:b003:l039","ordinal":142322,"en":"“A spring wailing from the valley,” she said,"},{"id":"semetey-1-2013:p0854:b004:l001","ordinal":142323,"en":"“A long-awaited orphan,” she said,"},{"id":"semetey-1-2013:p0854:b004:l002","ordinal":142324,"en":"“Hooves left by swift steeds,"},{"id":"semetey-1-2013:p0854:b004:l003","ordinal":142325,"en":"Lights left by hawks,"},{"id":"semetey-1-2013:p0854:b004:l004","ordinal":142326,"en":"For twelve years I kept myself alive,"},{"id":"semetey-1-2013:p0854:b004:l005","ordinal":142327,"en":"Bearing worry and sorrow for you."},{"id":"semetey-1-2013:p0854:b004:l006","ordinal":142328,"en":"Of you two orphans together,"},{"id":"semetey-1-2013:p0854:b004:l007","ordinal":142329,"en":"I kept asking, ‘When shall I care for them?’”"},{"id":"semetey-1-2013:p0854:b004:l008","ordinal":142330,"en":"So said Kanykei."},{"id":"semetey-1-2013:p0854:b004:l009","ordinal":142331,"en":"Of sixty thousand horses in the foothills,"},{"id":"semetey-1-2013:p0854:b004:l010","ordinal":142332,"en":"She had them driven in by nineties;"},{"id":"semetey-1-2013:p0854:b004:l011","ordinal":142333,"en":"Six hundred white-gray mares"},{"id":"semetey-1-2013:p0854:b004:l012","ordinal":142334,"en":"She had offered in sacrifice."},{"id":"semetey-1-2013:p0854:b004:l013","ordinal":142335,"en":"Devising what no one else could imagine,"},{"id":"semetey-1-2013:p0854:b004:l014","ordinal":142336,"en":"For Kulchoro and Kanchoro,"}]
