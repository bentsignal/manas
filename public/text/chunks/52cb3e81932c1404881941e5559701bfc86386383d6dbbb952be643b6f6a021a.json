[{"id":"semetey-1-2013:p1086:b003:l004","ordinal":160001,"en":"Where Manas's hand had not reached,"},{"id":"semetey-1-2013:p1086:b003:l005","ordinal":160002,"en":"No people remained whole."},{"id":"semetey-1-2013:p1086:b003:l006","ordinal":160003,"en":"Was it not Manas whose every deed"},{"id":"semetey-1-2013:p1086:b003:l007","ordinal":160004,"en":"Pleased mortal men?"},{"id":"semetey-1-2013:p1086:b003:l008","ordinal":160005,"en":"Did Manas not raise"},{"id":"semetey-1-2013:p1086:b003:l009","ordinal":160006,"en":"The tiny band of Muslims"},{"id":"semetey-1-2013:p1086:b003:l010","ordinal":160007,"en":"Among infidels of another father?"},{"id":"semetey-1-2013:p1086:b003:l011","ordinal":160008,"en":"The one he pinched was Bakburchun;"},{"id":"semetey-1-2013:p1086:b004:l001","ordinal":160009,"en":"The foe he fought in earnest was Kakan-Chyn."},{"id":"semetey-1-2013:p1086:b004:l002","ordinal":160010,"en":"When many saints spread their hands in prayer,"},{"id":"semetey-1-2013:p1086:b004:l003","ordinal":160011,"en":"Hero Manas was their blessing."},{"id":"semetey-1-2013:p1086:b004:l004","ordinal":160012,"en":"When the Chinese swept over the land,"},{"id":"semetey-1-2013:p1086:b004:l005","ordinal":160013,"en":"To the Muslim people"},{"id":"semetey-1-2013:p1086:b004:l006","ordinal":160014,"en":"Hero Manas was a father."},{"id":"semetey-1-2013:p1086:b004:l007","ordinal":160015,"en":"He was called the hero Manas;"},{"id":"semetey-1-2013:p1086:b004:l008","ordinal":160016,"en":"I have seen what he was"},{"id":"semetey-1-2013:p1086:b004:l009","ordinal":160017,"en":"Upon the face of the world."},{"id":"semetey-1-2013:p1086:b004:l010","ordinal":160018,"en":"I have seen that he was a fortress"},{"id":"semetey-1-2013:p1086:b004:l011","ordinal":160019,"en":"Through which no wind reached the Muslims."},{"id":"semetey-1-2013:p1086:b006:l001","ordinal":160020,"en":"Yesterday—was there such a deed in your tidings?"},{"id":"semetey-1-2013:p1086:b006:l002","ordinal":160021,"en":"Dear Kozho, listen!"},{"id":"semetey-1-2013:p1086:b006:l003","ordinal":160022,"en":"Yesterday, at Kökötöy's funeral feast,"},{"id":"semetey-1-2013:p1086:b006:l004","ordinal":160023,"en":"Before the great gathering,"},{"id":"semetey-1-2013:p1086:b006:l005","ordinal":160024,"en":"Koshoy went, and I went."},{"id":"semetey-1-2013:p1086:b006:l006","ordinal":160025,"en":"Chynkozho, son of Shygay,"},{"id":"semetey-1-2013:p1086:b006:l007","ordinal":160026,"en":"When did you go with them?"},{"id":"semetey-1-2013:p1086:b006:l008","ordinal":160027,"en":"Yesterday, when Khan Kökötöy passed away,"},{"id":"semetey-1-2013:p1086:b006:l009","ordinal":160028,"en":"When he went without turning back"},{"id":"semetey-1-2013:p1086:b006:l010","ordinal":160029,"en":"To the land from which none return,"},{"id":"semetey-1-2013:p1086:b006:l011","ordinal":160030,"en":"There was a man named Kökötöy;"},{"id":"semetey-1-2013:p1086:b006:l012","ordinal":160031,"en":"In the world, Kökötöy"},{"id":"semetey-1-2013:p1086:b006:l013","ordinal":160032,"en":"Had been a wealthy pillar."},{"id":"semetey-1-2013:p1086:b006:l014","ordinal":160033,"en":"In old Tashken and Chyyrchyk"},{"id":"semetey-1-2013:p1086:b006:l015","ordinal":160034,"en":"He dwelt as a wealthy man."},{"id":"semetey-1-2013:p1086:b006:l016","ordinal":160035,"en":"Of all the peoples of the age"},{"id":"semetey-1-2013:p1086:b006:l017","ordinal":160036,"en":"That ears had heard and eyes had seen,"},{"id":"semetey-1-2013:p1086:b006:l018","ordinal":160037,"en":"Kökötöy was the wealthiest."},{"id":"semetey-1-2013:p1086:b006:l019","ordinal":160038,"en":"He was a khan with forty rooms"},{"id":"semetey-1-2013:p1086:b006:l020","ordinal":160039,"en":"Filled with red coins and yellow gold."},{"id":"semetey-1-2013:p1086:b006:l021","ordinal":160040,"en":"So there was one named Kökötöy."},{"id":"semetey-1-2013:p1086:b006:l022","ordinal":160041,"en":"To all four quarters,"},{"id":"semetey-1-2013:p1086:b007:l001","ordinal":160042,"en":"Kökötöy's wealth"},{"id":"semetey-1-2013:p1086:b007:l002","ordinal":160043,"en":"Spread and brimmed like a lake."},{"id":"semetey-1-2013:p1086:b007:l003","ordinal":160044,"en":"He tended all four kinds of livestock;"},{"id":"semetey-1-2013:p1086:b007:l004","ordinal":160045,"en":"Upon the hairy-breasted black earth,"},{"id":"semetey-1-2013:p1086:b007:l005","ordinal":160046,"en":"Kökötöy's worldly herds"},{"id":"semetey-1-2013:p1086:b007:l006","ordinal":160047,"en":"Had sprung from the strongest stock."},{"id":"semetey-1-2013:p1086:b007:l007","ordinal":160048,"en":"Kökötöy, father of the people,"},{"id":"semetey-1-2013:p1086:b007:l008","ordinal":160049,"en":"Had grown very old;"},{"id":"semetey-1-2013:p1086:b007:l009","ordinal":160050,"en":"His wealth was complete,"},{"id":"semetey-1-2013:p1086:b007:l010","ordinal":160051,"en":"Yet Kökötöy, father of the people,"},{"id":"semetey-1-2013:p1086:b007:l011","ordinal":160052,"en":"Had remained childless."},{"id":"semetey-1-2013:p1086:b007:l012","ordinal":160053,"en":"Trusting in his wealth, Kökötöy"},{"id":"semetey-1-2013:p1086:b007:l013","ordinal":160054,"en":"Had taken seven wives;"},{"id":"semetey-1-2013:p1086:b007:l014","ordinal":160055,"en":"Until he reached seventy-five,"},{"id":"semetey-1-2013:p1086:b007:l015","ordinal":160056,"en":"He had remained without seeing a child."},{"id":"semetey-1-2013:p1086:b007:l016","ordinal":160057,"en":"When he reached seventy-five,"},{"id":"semetey-1-2013:p1086:b007:l017","ordinal":160058,"en":"He took seventy young men as attendants,"},{"id":"semetey-1-2013:p1086:b007:l018","ordinal":160059,"en":"Hunting wild asses and pursuing gazelles,"},{"id":"semetey-1-2013:p1086:b007:l019","ordinal":160060,"en":"And went on a great hunt."},{"id":"semetey-1-2013:p1086:b007:l020","ordinal":160061,"en":"As he journeyed on his travels,"},{"id":"semetey-1-2013:p1086:b007:l021","ordinal":160062,"en":"From Kayypchy's ridge,"},{"id":"semetey-1-2013:p1086:b007:l022","ordinal":160063,"en":"From the desert of Mediyan,"},{"id":"semetey-1-2013:p1087:b003:l001","ordinal":160064,"en":"Bokmurun, who gave the feast,"},{"id":"semetey-1-2013:p1087:b003:l002","ordinal":160065,"en":"Was found out on the steppe."},{"id":"semetey-1-2013:p1087:b003:l003","ordinal":160066,"en":"For the child he had found,"},{"id":"semetey-1-2013:p1087:b003:l004","ordinal":160067,"en":"He slaughtered nine thousand mares."},{"id":"semetey-1-2013:p1087:b003:l005","ordinal":160068,"en":"The four corners of the world,"},{"id":"semetey-1-2013:p1087:b003:l006","ordinal":160069,"en":"The forty corners of the qibla,"},{"id":"semetey-1-2013:p1087:b003:l007","ordinal":160070,"en":"Kökötöy gathered together;"},{"id":"semetey-1-2013:p1087:b003:l008","ordinal":160071,"en":"At Kökötöy's feast,"},{"id":"semetey-1-2013:p1087:b003:l009","ordinal":160072,"en":"Everyone who came ate his fill."},{"id":"semetey-1-2013:p1087:b003:l010","ordinal":160073,"en":"The great multitude that came to the feast"},{"id":"semetey-1-2013:p1087:b003:l011","ordinal":160074,"en":"Came to the feast and ate its fill."},{"id":"semetey-1-2013:p1087:b003:l012","ordinal":160075,"en":"After he had eaten his fill,"},{"id":"semetey-1-2013:p1087:b003:l013","ordinal":160076,"en":"They named him Bokmurun."},{"id":"semetey-1-2013:p1087:b003:l014","ordinal":160077,"en":"Thus Bokmurun"},{"id":"semetey-1-2013:p1087:b003:l015","ordinal":160078,"en":"Became Kökötöy's son."},{"id":"semetey-1-2013:p1087:b003:l016","ordinal":160079,"en":"Until he reached six years of age,"},{"id":"semetey-1-2013:p1087:b003:l017","ordinal":160080,"en":"What did wealthy Kökötöy do?"},{"id":"semetey-1-2013:p1087:b003:l018","ordinal":160081,"en":"Upon the child's head"},{"id":"semetey-1-2013:p1087:b003:l019","ordinal":160082,"en":"He fastened a waving owl-feather plume."},{"id":"semetey-1-2013:p1087:b003:l020","ordinal":160083,"en":"Kökötöy's seven wives"},{"id":"semetey-1-2013:p1087:b003:l021","ordinal":160084,"en":"Led the child about and raised him."},{"id":"semetey-1-2013:p1087:b003:l022","ordinal":160085,"en":"For Bokmurun, Kökötöy's"},{"id":"semetey-1-2013:p1087:b003:l023","ordinal":160086,"en":"Heart melted with affection;"},{"id":"semetey-1-2013:p1087:b003:l024","ordinal":160087,"en":"But in truth this Bokmurun"},{"id":"semetey-1-2013:p1087:b003:l025","ordinal":160088,"en":"Was the son of Er Töshtük."},{"id":"semetey-1-2013:p1087:b003:l026","ordinal":160089,"en":"His spoiling was extreme."},{"id":"semetey-1-2013:p1087:b003:l027","ordinal":160090,"en":"While Bokmurun slept,"},{"id":"semetey-1-2013:p1087:b003:l028","ordinal":160091,"en":"Each morning Kökötöy"},{"id":"semetey-1-2013:p1087:b003:l029","ordinal":160092,"en":"Would open the treasury,"},{"id":"semetey-1-2013:p1087:b003:l030","ordinal":160093,"en":"And as a sacrifice for him,"},{"id":"semetey-1-2013:p1087:b003:l031","ordinal":160094,"en":"Would bring out red gold and white silver"},{"id":"semetey-1-2013:p1087:b003:l032","ordinal":160095,"en":"And scatter it like seed"},{"id":"semetey-1-2013:p1087:b003:l033","ordinal":160096,"en":"Across whole provinces."},{"id":"semetey-1-2013:p1087:b003:l034","ordinal":160097,"en":"On every side, Kökötöy,"},{"id":"semetey-1-2013:p1087:b003:l035","ordinal":160098,"en":"Saying, \"Someone may do him harm,\""},{"id":"semetey-1-2013:p1087:b003:l036","ordinal":160099,"en":"Would set a strong guard."},{"id":"semetey-1-2013:p1087:b003:l037","ordinal":160100,"en":"For every day he passed the night unharmed,"},{"id":"semetey-1-2013:p1087:b003:l038","ordinal":160101,"en":"Six wethers and four kids"},{"id":"semetey-1-2013:p1087:b003:l039","ordinal":160102,"en":"Would be slaughtered as a sacrifice."},{"id":"semetey-1-2013:p1087:b004:l001","ordinal":160103,"en":"So great was the care with which he raised him;"},{"id":"semetey-1-2013:p1087:b004:l002","ordinal":160104,"en":"At twelve, Bokmurun"},{"id":"semetey-1-2013:p1087:b004:l003","ordinal":160105,"en":"Was Kökötöy's son."},{"id":"semetey-1-2013:p1087:b004:l004","ordinal":160106,"en":"Growing up this way and that,"},{"id":"semetey-1-2013:p1087:b004:l005","ordinal":160107,"en":"His daily affairs prospered."},{"id":"semetey-1-2013:p1087:b004:l006","ordinal":160108,"en":"When Kökötöy's Bokmurun"},{"id":"semetey-1-2013:p1087:b004:l007","ordinal":160109,"en":"Reached twelve years of age,"},{"id":"semetey-1-2013:p1087:b004:l008","ordinal":160110,"en":"He became a blazing ember,"},{"id":"semetey-1-2013:p1087:b004:l009","ordinal":160111,"en":"And wealthy Kökötöy's son"},{"id":"semetey-1-2013:p1087:b004:l010","ordinal":160112,"en":"Became a mischief-maker unmatched in the world."},{"id":"semetey-1-2013:p1087:b004:l011","ordinal":160113,"en":"Kökötöy's Bokmurun"},{"id":"semetey-1-2013:p1087:b004:l012","ordinal":160114,"en":"Found no mountain to strike,"},{"id":"semetey-1-2013:p1087:b004:l013","ordinal":160115,"en":"Found no enemy to fight;"},{"id":"semetey-1-2013:p1087:b004:l014","ordinal":160116,"en":"He had merchants beaten,"},{"id":"semetey-1-2013:p1087:b004:l015","ordinal":160117,"en":"And caravan men imprisoned."},{"id":"semetey-1-2013:p1087:b004:l016","ordinal":160118,"en":"Wherever his hand could reach,"},{"id":"semetey-1-2013:p1087:b004:l017","ordinal":160119,"en":"He had plunder seized,"},{"id":"semetey-1-2013:p1087:b004:l018","ordinal":160120,"en":"And caused much disorder."},{"id":"semetey-1-2013:p1087:b004:l019","ordinal":160121,"en":"He ate barren yearling mares,"},{"id":"semetey-1-2013:p1087:b004:l020","ordinal":160122,"en":"And ate frozen goat fat;"},{"id":"semetey-1-2013:p1087:b004:l021","ordinal":160123,"en":"Bokmurun had grown wanton."},{"id":"semetey-1-2013:p1087:b004:l022","ordinal":160124,"en":"\"They say my father Kökötöy's"},{"id":"semetey-1-2013:p1087:b004:l023","ordinal":160125,"en":"Wealth has been seen by the whole age;"},{"id":"semetey-1-2013:p1087:b004:l024","ordinal":160126,"en":"They say Kökötöy's vast riches"},{"id":"semetey-1-2013:p1087:b004:l025","ordinal":160127,"en":"Will die like grass in spring."},{"id":"semetey-1-2013:p1087:b004:l026","ordinal":160128,"en":"They say this world is worthless;"},{"id":"semetey-1-2013:p1087:b004:l027","ordinal":160129,"en":"Why should I keep tending"},{"id":"semetey-1-2013:p1087:b004:l028","ordinal":160130,"en":"Great herds that bring no benefit?"},{"id":"semetey-1-2013:p1087:b004:l029","ordinal":160131,"en":"Even if I lose a great deal of livestock,"},{"id":"semetey-1-2013:p1087:b004:l030","ordinal":160132,"en":"My dear father's vast riches"},{"id":"semetey-1-2013:p1087:b004:l031","ordinal":160133,"en":"Will last me until I die,\" he said."},{"id":"semetey-1-2013:p1087:b004:l032","ordinal":160134,"en":"Such were Bokmurun's deeds:"},{"id":"semetey-1-2013:p1087:b004:l033","ordinal":160135,"en":"Making their fangs protrude,"},{"id":"semetey-1-2013:p1087:b004:l034","ordinal":160136,"en":"Making their lower lips hang,"},{"id":"semetey-1-2013:p1087:b004:l035","ordinal":160137,"en":"Making their humps stand high,"},{"id":"semetey-1-2013:p1087:b004:l036","ordinal":160138,"en":"He had a thousand male camels saddled,"},{"id":"semetey-1-2013:p1087:b004:l037","ordinal":160139,"en":"Had all their coverings put in order,"},{"id":"semetey-1-2013:p1087:b004:l038","ordinal":160140,"en":"Had them drawn along with ropes,"},{"id":"semetey-1-2013:p1087:b004:l039","ordinal":160141,"en":"And loaded with riches of red gold."},{"id":"semetey-1-2013:p1088:b003:l001","ordinal":160142,"en":"He had them splendidly loaded,"},{"id":"semetey-1-2013:p1088:b003:l002","ordinal":160143,"en":"Had their necks rubbed raw,"},{"id":"semetey-1-2013:p1088:b003:l003","ordinal":160144,"en":"And sent them roaming over the whole world;"},{"id":"semetey-1-2013:p1088:b003:l004","ordinal":160145,"en":"He would survey the face of the earth."},{"id":"semetey-1-2013:p1088:b003:l005","ordinal":160146,"en":"Growing tyrannical, Bokmurun"},{"id":"semetey-1-2013:p1088:b003:l006","ordinal":160147,"en":"Would have maidens sought for him."},{"id":"semetey-1-2013:p1088:b003:l007","ordinal":160148,"en":"Traveling among the common people,"},{"id":"semetey-1-2013:p1088:b003:l008","ordinal":160149,"en":"He would look upon dark-eyed maidens."},{"id":"semetey-1-2013:p1088:b003:l009","ordinal":160150,"en":"Whether or not he liked the girl,"},{"id":"semetey-1-2013:p1088:b003:l010","ordinal":160151,"en":"He would give her father"},{"id":"semetey-1-2013:p1088:b003:l011","ordinal":160152,"en":"A camel-load of gold."},{"id":"semetey-1-2013:p1088:b003:l012","ordinal":160153,"en":"Of all that ears had heard and eyes had seen,"},{"id":"semetey-1-2013:p1088:b003:l013","ordinal":160154,"en":"His fame thundered abroad,"},{"id":"semetey-1-2013:p1088:b003:l014","ordinal":160155,"en":"And they called Bokmurun a manap."},{"id":"semetey-1-2013:p1088:b003:l015","ordinal":160156,"en":"Though still a child, Bokmurun"},{"id":"semetey-1-2013:p1088:b003:l016","ordinal":160157,"en":"Had livestock led wherever he went;"},{"id":"semetey-1-2013:p1088:b003:l017","ordinal":160158,"en":"Roaming through many cities,"},{"id":"semetey-1-2013:p1088:b003:l018","ordinal":160159,"en":"He overran many peoples,"},{"id":"semetey-1-2013:p1088:b003:l019","ordinal":160160,"en":"And squandered and scattered"},{"id":"semetey-1-2013:p1088:b003:l020","ordinal":160161,"en":"All his great wealth."},{"id":"semetey-1-2013:p1088:b003:l021","ordinal":160162,"en":"When Kökötöy's Bokmurun"},{"id":"semetey-1-2013:p1088:b003:l022","ordinal":160163,"en":"Mounted Maaniker,"},{"id":"semetey-1-2013:p1088:b003:l023","ordinal":160164,"en":"He traveled four circuits"},{"id":"semetey-1-2013:p1088:b003:l024","ordinal":160165,"en":"Around the world's four corners."},{"id":"semetey-1-2013:p1088:b003:l025","ordinal":160166,"en":"When he went seeking a wife,"},{"id":"semetey-1-2013:p1088:b003:l026","ordinal":160167,"en":"When he traversed many lands,"},{"id":"semetey-1-2013:p1088:b003:l027","ordinal":160168,"en":"When he squandered and scattered"},{"id":"semetey-1-2013:p1088:b003:l028","ordinal":160169,"en":"Great wealth and countless herds,"},{"id":"semetey-1-2013:p1088:b003:l029","ordinal":160170,"en":"When he mounted the wind-surpassing horse"},{"id":"semetey-1-2013:p1088:b003:l030","ordinal":160171,"en":"And went seeking a wife,"},{"id":"semetey-1-2013:p1088:b003:l031","ordinal":160172,"en":"Khan Kökötöy died."},{"id":"semetey-1-2013:p1088:b003:l032","ordinal":160173,"en":"As Kökötöy lay dead,"},{"id":"semetey-1-2013:p1088:b003:l033","ordinal":160174,"en":"Bokmurun returned."},{"id":"semetey-1-2013:p1088:b003:l034","ordinal":160175,"en":"\"My khan-father has died,\" he said,"},{"id":"semetey-1-2013:p1088:b003:l035","ordinal":160176,"en":"And summoned the great men,"},{"id":"semetey-1-2013:p1088:b003:l036","ordinal":160177,"en":"The troublemakers among the people."},{"id":"semetey-1-2013:p1088:b003:l037","ordinal":160178,"en":"\"My dear father has died,\" he cried,"},{"id":"semetey-1-2013:p1088:b003:l038","ordinal":160179,"en":"Wailing in grief,"},{"id":"semetey-1-2013:p1088:b003:l039","ordinal":160180,"en":"And summoned all the people"},{"id":"semetey-1-2013:p1088:b004:l001","ordinal":160181,"en":"To his mourning feast."},{"id":"semetey-1-2013:p1088:b004:l002","ordinal":160182,"en":"He had the finest racehorses tethered,"},{"id":"semetey-1-2013:p1088:b004:l003","ordinal":160183,"en":"And had countless khojas and ishans"},{"id":"semetey-1-2013:p1088:b004:l004","ordinal":160184,"en":"Driven there by force,"},{"id":"semetey-1-2013:p1088:b004:l005","ordinal":160185,"en":"Saying, \"Let them come receive their share.\""},{"id":"semetey-1-2013:p1088:b004:l006","ordinal":160186,"en":"He made their camel calves cry out;"},{"id":"semetey-1-2013:p1088:b004:l007","ordinal":160187,"en":"Saying, \"The mourning feast of Khan Kökötöy,\""},{"id":"semetey-1-2013:p1088:b004:l008","ordinal":160188,"en":"He had gray cattle slaughtered,"},{"id":"semetey-1-2013:p1088:b004:l009","ordinal":160189,"en":"Had foals left orphaned,"},{"id":"semetey-1-2013:p1088:b004:l010","ordinal":160190,"en":"And had the mares slaughtered wholesale."},{"id":"semetey-1-2013:p1088:b004:l011","ordinal":160191,"en":"He slaughtered sheep and male camels,"},{"id":"semetey-1-2013:p1088:b004:l012","ordinal":160192,"en":"Saying, \"This is merit for my khan-father,\""},{"id":"semetey-1-2013:p1088:b004:l013","ordinal":160193,"en":"And slaughtered many cattle and horses."},{"id":"semetey-1-2013:p1088:b004:l014","ordinal":160194,"en":"He had all the giants brought,"},{"id":"semetey-1-2013:p1088:b004:l015","ordinal":160195,"en":"And placed his father's remains"},{"id":"semetey-1-2013:p1088:b004:l016","ordinal":160196,"en":"In the hands of sixty giants."},{"id":"semetey-1-2013:p1088:b004:l017","ordinal":160197,"en":"He tethered ninety gray horses for the funeral gifts,"},{"id":"semetey-1-2013:p1088:b004:l018","ordinal":160198,"en":"And tethered all the rest in groups of a thousand,"},{"id":"semetey-1-2013:p1088:b004:l019","ordinal":160199,"en":"Had bells fastened to them,"},{"id":"semetey-1-2013:p1088:b004:l020","ordinal":160200,"en":"And costly carpets spread over them."},{"id":"semetey-1-2013:p1088:b004:l021","ordinal":160201,"en":"He tethered six thousand pack camels and male camels;"},{"id":"semetey-1-2013:p1088:b004:l022","ordinal":160202,"en":"His champions shouted,"},{"id":"semetey-1-2013:p1088:b004:l023","ordinal":160203,"en":"\"Qalandars, paupers, dervishes,"},{"id":"semetey-1-2013:p1088:b004:l024","ordinal":160204,"en":"Let not one of you stay behind!\""},{"id":"semetey-1-2013:p1088:b004:l025","ordinal":160205,"en":"He summoned the people"},{"id":"semetey-1-2013:p1088:b004:l026","ordinal":160206,"en":"And had the funeral prayer recited."},{"id":"semetey-1-2013:p1088:b004:l027","ordinal":160207,"en":"Saying, \"My dear father will ride it,\""},{"id":"semetey-1-2013:p1088:b004:l028","ordinal":160208,"en":"He saddled exactly one thousand coal-black horses"},{"id":"semetey-1-2013:p1088:b004:l029","ordinal":160209,"en":"As Buraq mounts."},{"id":"semetey-1-2013:p1088:b004:l030","ordinal":160210,"en":"In this way, Kökötöy's Bokmurun"},{"id":"semetey-1-2013:p1088:b004:l031","ordinal":160211,"en":"Struck fear into the hearts"},{"id":"semetey-1-2013:p1088:b004:l032","ordinal":160212,"en":"Of all the common people,"},{"id":"semetey-1-2013:p1088:b004:l033","ordinal":160213,"en":"And began these doings"},{"id":"semetey-1-2013:p1088:b004:l034","ordinal":160214,"en":"For his father's mourning feast."},{"id":"semetey-1-2013:p1088:b004:l035","ordinal":160215,"en":"Unable to endure his demands,"},{"id":"semetey-1-2013:p1088:b004:l036","ordinal":160216,"en":"The Kyrgyz of broad Tashken"},{"id":"semetey-1-2013:p1088:b004:l037","ordinal":160217,"en":"Began to perish."},{"id":"semetey-1-2013:p1088:b004:l038","ordinal":160218,"en":"Hearing that Khan Kökötöy had died,"},{"id":"semetey-1-2013:p1088:b004:l039","ordinal":160219,"en":"The people heard and the nation came."},{"id":"semetey-1-2013:p1089:b003:l001","ordinal":160220,"en":"Of all that ears had heard and eyes had seen,"},{"id":"semetey-1-2013:p1089:b003:l002","ordinal":160221,"en":"Every soul who heard came."},{"id":"semetey-1-2013:p1089:b003:l003","ordinal":160222,"en":"His white turban was large as a cauldron;"},{"id":"semetey-1-2013:p1089:b003:l004","ordinal":160223,"en":"When he cried out, his voice was like the call to prayer."},{"id":"semetey-1-2013:p1089:b003:l005","ordinal":160224,"en":"The khoja's heart found contentment;"},{"id":"semetey-1-2013:p1089:b003:l006","ordinal":160225,"en":"Every pauper and dervish who had lacked means"},{"id":"semetey-1-2013:p1089:b003:l007","ordinal":160226,"en":"Received seven head of livestock,"},{"id":"semetey-1-2013:p1089:b003:l008","ordinal":160227,"en":"And his satisfied heart rejoiced."},{"id":"semetey-1-2013:p1089:b003:l009","ordinal":160228,"en":"At Kökötöy's death,"},{"id":"semetey-1-2013:p1089:b003:l010","ordinal":160229,"en":"Even the utterly poor became rich."},{"id":"semetey-1-2013:p1089:b003:l011","ordinal":160230,"en":"Kökötöy's Bokmurun"},{"id":"semetey-1-2013:p1089:b003:l012","ordinal":160231,"en":"Took instruction from the learned"},{"id":"semetey-1-2013:p1089:b003:l013","ordinal":160232,"en":"And questioned the wise."},{"id":"semetey-1-2013:p1089:b003:l014","ordinal":160233,"en":"Hearing counsel from the wise,"},{"id":"semetey-1-2013:p1089:b003:l015","ordinal":160234,"en":"He had a shroud made of fine cloth;"},{"id":"semetey-1-2013:p1089:b003:l016","ordinal":160235,"en":"Hearing that it would be splendid,"},{"id":"semetey-1-2013:p1089:b003:l017","ordinal":160236,"en":"He dressed him in a loose silk robe,"},{"id":"semetey-1-2013:p1089:b003:l018","ordinal":160237,"en":"Mounted him upon Zhelmayan,"},{"id":"semetey-1-2013:p1089:b003:l019","ordinal":160238,"en":"Gave a letter inscribed with a verse,"},{"id":"semetey-1-2013:p1089:b003:l020","ordinal":160239,"en":"And gave provisions to the scholars."},{"id":"semetey-1-2013:p1089:b003:l021","ordinal":160240,"en":"He had Egypt and Baghdad"},{"id":"semetey-1-2013:p1089:b003:l022","ordinal":160241,"en":"Called upon side by side,"},{"id":"semetey-1-2013:p1089:b003:l023","ordinal":160242,"en":"And had Kökötöy's shroud"},{"id":"semetey-1-2013:p1089:b003:l024","ordinal":160243,"en":"Brought from great Egypt."},{"id":"semetey-1-2013:p1089:b003:l025","ordinal":160244,"en":"He wrapped him in the shroud,"},{"id":"semetey-1-2013:p1089:b003:l026","ordinal":160245,"en":"And in this way consumed"},{"id":"semetey-1-2013:p1089:b003:l027","ordinal":160246,"en":"Kökötöy's countless riches."},{"id":"semetey-1-2013:p1089:b003:l028","ordinal":160247,"en":"He had him washed with Zamzam water,"},{"id":"semetey-1-2013:p1089:b003:l029","ordinal":160248,"en":"Performed the rites from head to foot,"},{"id":"semetey-1-2013:p1089:b003:l030","ordinal":160249,"en":"And had him bound in a robe of honor."},{"id":"semetey-1-2013:p1089:b003:l031","ordinal":160250,"en":"He had the mourning standard drawn straight,"},{"id":"semetey-1-2013:p1089:b003:l032","ordinal":160251,"en":"And had Külaiym voice"},{"id":"semetey-1-2013:p1089:b003:l033","ordinal":160252,"en":"Kökötöy's lament."},{"id":"semetey-1-2013:p1089:b003:l034","ordinal":160253,"en":"He had all the riches"},{"id":"semetey-1-2013:p1089:b003:l035","ordinal":160254,"en":"Prepared and counted,"},{"id":"semetey-1-2013:p1089:b003:l036","ordinal":160255,"en":"And to give to those who washed the body,"},{"id":"semetey-1-2013:p1089:b003:l037","ordinal":160256,"en":"Of the armored robes,"}]
