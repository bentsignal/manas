[{"id":"semetey-1-2013:p1183:b003:l027","ordinal":167425,"en":"Now hear the condition"},{"id":"semetey-1-2013:p1183:b003:l028","ordinal":167426,"en":"Of that boy Bokmurun."},{"id":"semetey-1-2013:p1183:b003:l029","ordinal":167427,"en":"He enjoyed honor among the people."},{"id":"semetey-1-2013:p1183:b003:l030","ordinal":167428,"en":"All this wealth and delight—"},{"id":"semetey-1-2013:p1183:b003:l031","ordinal":167429,"en":"Dear noble Kokotoy"},{"id":"semetey-1-2013:p1183:b003:l032","ordinal":167430,"en":"Had gathered it all together."},{"id":"semetey-1-2013:p1183:b003:l033","ordinal":167431,"en":"If Bokmurun left it untouched,"},{"id":"semetey-1-2013:p1183:b003:l034","ordinal":167432,"en":"It could have lasted until Judgment Day."},{"id":"semetey-1-2013:p1183:b003:l035","ordinal":167433,"en":"Bokmurun, whose father had died,"},{"id":"semetey-1-2013:p1183:b003:l036","ordinal":167434,"en":"Did not rein in his horse;"},{"id":"semetey-1-2013:p1183:b003:l037","ordinal":167435,"en":"Infidel and Muslim alike,"},{"id":"semetey-1-2013:p1183:b003:l038","ordinal":167436,"en":"He gathered every last one."},{"id":"semetey-1-2013:p1183:b003:l039","ordinal":167437,"en":"He opened the treasury"},{"id":"semetey-1-2013:p1183:b003:l040","ordinal":167438,"en":"The mass of wealth and livestock"},{"id":"semetey-1-2013:p1183:b004:l001","ordinal":167439,"en":"Before the assembled people,"},{"id":"semetey-1-2013:p1183:b004:l002","ordinal":167440,"en":"He scattered lavishly."},{"id":"semetey-1-2013:p1183:b004:l003","ordinal":167441,"en":"Overseeing the feast"},{"id":"semetey-1-2013:p1183:b004:l004","ordinal":167442,"en":"Was gray-maned lion Manas."},{"id":"semetey-1-2013:p1183:b004:l005","ordinal":167443,"en":"All whom ears had heard of and eyes had seen,"},{"id":"semetey-1-2013:p1183:b004:l006","ordinal":167444,"en":"Every one among the people,"},{"id":"semetey-1-2013:p1183:b004:l007","ordinal":167445,"en":"Attended Kokotoy's feast."},{"id":"semetey-1-2013:p1183:b004:l008","ordinal":167446,"en":"The thick-woven piebald cloth of Andijan,"},{"id":"semetey-1-2013:p1183:b004:l009","ordinal":167447,"en":"Was staked as the grand prize,"},{"id":"semetey-1-2013:p1183:b004:l010","ordinal":167448,"en":"Gathered like Ala-Too,"},{"id":"semetey-1-2013:p1183:b004:l011","ordinal":167449,"en":"Made the hearts of onlookers waver."},{"id":"semetey-1-2013:p1183:b004:l012","ordinal":167450,"en":"The costly piebald silk of Bukhara"},{"id":"semetey-1-2013:p1183:b004:l013","ordinal":167451,"en":"At Kokotoy's feast"},{"id":"semetey-1-2013:p1183:b004:l014","ordinal":167452,"en":"Loomed like a misty mountain."},{"id":"semetey-1-2013:p1183:b004:l015","ordinal":167453,"en":"Gold and precious stones,"},{"id":"semetey-1-2013:p1183:b004:l016","ordinal":167454,"en":"With rubies mixed among them—"},{"id":"semetey-1-2013:p1183:b004:l017","ordinal":167455,"en":"Kokotoy's many prizes"},{"id":"semetey-1-2013:p1183:b004:l018","ordinal":167456,"en":"Overwhelmed the multitude,"},{"id":"semetey-1-2013:p1183:b004:l019","ordinal":167457,"en":"And troubled their poor heads."},{"id":"semetey-1-2013:p1183:b004:l020","ordinal":167458,"en":"Kokotoy's red banner with golden finial"},{"id":"semetey-1-2013:p1183:b004:l021","ordinal":167459,"en":"Was raised sky-high above the feast."},{"id":"semetey-1-2013:p1183:b004:l022","ordinal":167460,"en":"Your gray-maned lion Manas"},{"id":"semetey-1-2013:p1183:b004:l023","ordinal":167461,"en":"Had proclamations announced to the people,"},{"id":"semetey-1-2013:p1183:b004:l024","ordinal":167462,"en":"Yrchyuul, son of Yraman—"},{"id":"semetey-1-2013:p1183:b004:l025","ordinal":167463,"en":"He had Yrchyuul begin them."},{"id":"semetey-1-2013:p1183:b004:l026","ordinal":167464,"en":"When they heard his proclamation,"},{"id":"semetey-1-2013:p1183:b004:l027","ordinal":167465,"en":"Willow cudgels were cut,"},{"id":"semetey-1-2013:p1183:b004:l028","ordinal":167466,"en":"And every horse racer"},{"id":"semetey-1-2013:p1183:b004:l029","ordinal":167467,"en":"Gathered without exception."},{"id":"semetey-1-2013:p1183:b004:l030","ordinal":167468,"en":"Karatai was made the starter;"},{"id":"semetey-1-2013:p1183:b004:l031","ordinal":167469,"en":"When the time came to drive out the horses,"},{"id":"semetey-1-2013:p1183:b004:l032","ordinal":167470,"en":"Infidel and Muslim"},{"id":"semetey-1-2013:p1183:b004:l033","ordinal":167471,"en":"All assembled without exception."},{"id":"semetey-1-2013:p1183:b004:l034","ordinal":167472,"en":"All the heroes grew excited;"},{"id":"semetey-1-2013:p1183:b004:l035","ordinal":167473,"en":"The simpletons surged forward."},{"id":"semetey-1-2013:p1183:b004:l036","ordinal":167474,"en":"The people gathered in a dense mass,"},{"id":"semetey-1-2013:p1183:b004:l037","ordinal":167475,"en":"Dust flying into the sky;"},{"id":"semetey-1-2013:p1183:b004:l038","ordinal":167476,"en":"They divided clan by clan,"},{"id":"semetey-1-2013:p1183:b004:l039","ordinal":167477,"en":"And when they advanced, looked like a flood."},{"id":"semetey-1-2013:p1184:b004:l001","ordinal":167478,"en":"Dust flew and haze burned;"},{"id":"semetey-1-2013:p1184:b004:l002","ordinal":167479,"en":"A long cloud of dust billowed."},{"id":"semetey-1-2013:p1184:b004:l003","ordinal":167480,"en":"Clan after clan covered the ground;"},{"id":"semetey-1-2013:p1184:b004:l004","ordinal":167481,"en":"The great host come to the feast"},{"id":"semetey-1-2013:p1184:b004:l005","ordinal":167482,"en":"Surged forward, crying out."},{"id":"semetey-1-2013:p1184:b004:l006","ordinal":167483,"en":"The drum was beaten firmly;"},{"id":"semetey-1-2013:p1184:b004:l007","ordinal":167484,"en":"All who wished to race horses"},{"id":"semetey-1-2013:p1184:b004:l008","ordinal":167485,"en":"Closed in without exception."},{"id":"semetey-1-2013:p1184:b004:l009","ordinal":167486,"en":"They dressed the forelocks"},{"id":"semetey-1-2013:p1184:b004:l010","ordinal":167487,"en":"Of the horses meant to win prizes,"},{"id":"semetey-1-2013:p1184:b004:l011","ordinal":167488,"en":"Knotted their tails,"},{"id":"semetey-1-2013:p1184:b004:l012","ordinal":167489,"en":"Took the shortcut along the narrow road,"},{"id":"semetey-1-2013:p1184:b004:l013","ordinal":167490,"en":"And hurried, leading their horses."},{"id":"semetey-1-2013:p1184:b004:l014","ordinal":167491,"en":"They formed nation after nation,"},{"id":"semetey-1-2013:p1184:b004:l015","ordinal":167492,"en":"Their numbers like a flooding river,"},{"id":"semetey-1-2013:p1184:b004:l016","ordinal":167493,"en":"Murmuring like a vast people,"},{"id":"semetey-1-2013:p1184:b004:l017","ordinal":167494,"en":"The multitude swarming thickly."},{"id":"semetey-1-2013:p1184:b004:l018","ordinal":167495,"en":"Turning as they led their horses,"},{"id":"semetey-1-2013:p1184:b004:l019","ordinal":167496,"en":"They separated from one another."},{"id":"semetey-1-2013:p1184:b004:l020","ordinal":167497,"en":"The earth split and shifted;"},{"id":"semetey-1-2013:p1184:b004:l021","ordinal":167498,"en":"Peoples of many ages filled it."},{"id":"semetey-1-2013:p1184:b004:l022","ordinal":167499,"en":"Because that host was so immense,"},{"id":"semetey-1-2013:p1184:b004:l023","ordinal":167500,"en":"The center of the crowd hollowed out."},{"id":"semetey-1-2013:p1184:b004:l024","ordinal":167501,"en":"Kokotoy's countless black livestock"},{"id":"semetey-1-2013:p1184:b004:l025","ordinal":167502,"en":"Were slaughtered and spent lavishly."},{"id":"semetey-1-2013:p1184:b004:l026","ordinal":167503,"en":"At Khan Kokotoy's feast,"},{"id":"semetey-1-2013:p1184:b004:l027","ordinal":167504,"en":"Before the great gathering,"},{"id":"semetey-1-2013:p1184:b004:l028","ordinal":167505,"en":"The people of the khagan ate their fill."},{"id":"semetey-1-2013:p1184:b004:l029","ordinal":167506,"en":"Trenches were dug in great numbers,"},{"id":"semetey-1-2013:p1184:b004:l030","ordinal":167507,"en":"And above the trenches"},{"id":"semetey-1-2013:p1184:b004:l031","ordinal":167508,"en":"Cauldrons were hung by the ten-thousand."},{"id":"semetey-1-2013:p1184:b004:l032","ordinal":167509,"en":"Broth spilled like a lake,"},{"id":"semetey-1-2013:p1184:b004:l033","ordinal":167510,"en":"And meat loomed like a mountain."},{"id":"semetey-1-2013:p1184:b004:l034","ordinal":167511,"en":"When they heard news of the prize,"},{"id":"semetey-1-2013:p1184:b004:l035","ordinal":167512,"en":"All the people, every one,"},{"id":"semetey-1-2013:p1184:b004:l036","ordinal":167513,"en":"Swarmed like ants"},{"id":"semetey-1-2013:p1184:b004:l037","ordinal":167514,"en":"And now came out in groups."},{"id":"semetey-1-2013:p1184:b005:l001","ordinal":167515,"en":"Among the Chinese was Orongu;"},{"id":"semetey-1-2013:p1184:b005:l002","ordinal":167516,"en":"This was Orongu's desire:"},{"id":"semetey-1-2013:p1184:b005:l003","ordinal":167517,"en":"\"Of the accursed Burut,"},{"id":"semetey-1-2013:p1184:b005:l004","ordinal":167518,"en":"I will take the prize as well,\" he said."},{"id":"semetey-1-2013:p1184:b005:l005","ordinal":167519,"en":"He prepared a rough-gaited bay mare,"},{"id":"semetey-1-2013:p1184:b005:l006","ordinal":167520,"en":"That bay mare,"},{"id":"semetey-1-2013:p1184:b005:l007","ordinal":167521,"en":"Dressing and setting its tail."},{"id":"semetey-1-2013:p1184:b005:l008","ordinal":167522,"en":"Behind the bay mare"},{"id":"semetey-1-2013:p1184:b005:l009","ordinal":167523,"en":"He rolled up and stuffed"},{"id":"semetey-1-2013:p1184:b005:l010","ordinal":167524,"en":"A saddle-sized piece of black felt."},{"id":"semetey-1-2013:p1184:b005:l011","ordinal":167525,"en":"Khan Joloy of the Kalmyks"},{"id":"semetey-1-2013:p1184:b005:l012","ordinal":167526,"en":"Tied Achbuudan's forelock"},{"id":"semetey-1-2013:p1184:b005:l013","ordinal":167527,"en":"This way and that,"},{"id":"semetey-1-2013:p1184:b005:l014","ordinal":167528,"en":"And entered Achbuudan,"},{"id":"semetey-1-2013:p1184:b005:l015","ordinal":167529,"en":"Saying, \"I will win the grand prize.\""},{"id":"semetey-1-2013:p1184:b005:l016","ordinal":167530,"en":"Manas had Akkula;"},{"id":"semetey-1-2013:p1184:b005:l017","ordinal":167531,"en":"Joloy had Surkula."},{"id":"semetey-1-2013:p1184:b005:l018","ordinal":167532,"en":"Akkula and Achbuudan"},{"id":"semetey-1-2013:p1184:b005:l019","ordinal":167533,"en":"Were exceptional tulpar steeds;"},{"id":"semetey-1-2013:p1184:b005:l020","ordinal":167534,"en":"When one looked at the two,"},{"id":"semetey-1-2013:p1184:b005:l021","ordinal":167535,"en":"They resembled hares."},{"id":"semetey-1-2013:p1184:b005:l022","ordinal":167536,"en":"Manas entered Akkula;"},{"id":"semetey-1-2013:p1184:b005:l023","ordinal":167537,"en":"Joloy entered Surkula."},{"id":"semetey-1-2013:p1184:b005:l024","ordinal":167538,"en":"With cotton sash and broad boots,"},{"id":"semetey-1-2013:p1184:b005:l025","ordinal":167539,"en":"Kongurbay, khan of the Kechils,"},{"id":"semetey-1-2013:p1184:b005:l026","ordinal":167540,"en":"Was a swine who knew"},{"id":"semetey-1-2013:p1184:b005:l027","ordinal":167541,"en":"The enemy's devices perfectly:"},{"id":"semetey-1-2013:p1184:b005:l028","ordinal":167542,"en":"\"Broad-chested Manas—"},{"id":"semetey-1-2013:p1184:b005:l029","ordinal":167543,"en":"Let him race Akkula and I shall see;"},{"id":"semetey-1-2013:p1184:b005:l030","ordinal":167544,"en":"A Burut such as he—"},{"id":"semetey-1-2013:p1184:b005:l031","ordinal":167545,"en":"I will joust with him and spill his blood."},{"id":"semetey-1-2013:p1184:b005:l032","ordinal":167546,"en":"At the feast for my dead father Alooke,"},{"id":"semetey-1-2013:p1184:b005:l033","ordinal":167547,"en":"I will take my revenge;"},{"id":"semetey-1-2013:p1184:b005:l034","ordinal":167548,"en":"I will offer the accursed Manas"},{"id":"semetey-1-2013:p1184:b005:l035","ordinal":167549,"en":"As a sacrifice,\" he said."},{"id":"semetey-1-2013:p1184:b005:l036","ordinal":167550,"en":"Kongurbay, son of Alooke,"},{"id":"semetey-1-2013:p1184:b005:l037","ordinal":167551,"en":"Gathered his Chinese kinsmen"},{"id":"semetey-1-2013:p1185:b003:l001","ordinal":167552,"en":"By cunning he entered"},{"id":"semetey-1-2013:p1185:b003:l002","ordinal":167553,"en":"His swift black stallion."},{"id":"semetey-1-2013:p1185:b003:l003","ordinal":167554,"en":"\"Mighty Kalcha Khan Kongurbay"},{"id":"semetey-1-2013:p1185:b003:l004","ordinal":167555,"en":"Has entered his Algara,\" they said;"},{"id":"semetey-1-2013:p1185:b003:l005","ordinal":167556,"en":"The Muslim faithful did not recognize it"},{"id":"semetey-1-2013:p1185:b003:l006","ordinal":167557,"en":"And were struck by God."},{"id":"semetey-1-2013:p1185:b003:l007","ordinal":167558,"en":"Ezkara, khan of the Manchus,"},{"id":"semetey-1-2013:p1185:b003:l008","ordinal":167559,"en":"Came out surging too,"},{"id":"semetey-1-2013:p1185:b003:l009","ordinal":167560,"en":"Eagerly saying, \"I will race a horse.\""},{"id":"semetey-1-2013:p1185:b003:l010","ordinal":167561,"en":"They dressed the horses' tails,"},{"id":"semetey-1-2013:p1185:b003:l011","ordinal":167562,"en":"Paraded them back and forth,"},{"id":"semetey-1-2013:p1185:b003:l012","ordinal":167563,"en":"And did so for exactly three days."},{"id":"semetey-1-2013:p1185:b003:l013","ordinal":167564,"en":"At farthest Jelpinig,"},{"id":"semetey-1-2013:p1185:b003:l014","ordinal":167565,"en":"Peoples of seven ages came;"},{"id":"semetey-1-2013:p1185:b003:l015","ordinal":167566,"en":"Not a living soul remained behind."},{"id":"semetey-1-2013:p1185:b003:l016","ordinal":167567,"en":"For Khan Kokotoy's feast"},{"id":"semetey-1-2013:p1185:b003:l017","ordinal":167568,"en":"Every kind of people assembled."},{"id":"semetey-1-2013:p1185:b003:l018","ordinal":167569,"en":"Kokotoy's golden finial—"},{"id":"semetey-1-2013:p1185:b003:l019","ordinal":167570,"en":"The red banner"},{"id":"semetey-1-2013:p1185:b003:l020","ordinal":167571,"en":"Was raised and fluttered."},{"id":"semetey-1-2013:p1185:b003:l021","ordinal":167572,"en":"\"Drive out the horses!\" they cried then;"},{"id":"semetey-1-2013:p1185:b003:l022","ordinal":167573,"en":"The zurnay blared,"},{"id":"semetey-1-2013:p1185:b003:l023","ordinal":167574,"en":"Dust curled toward the sky,"},{"id":"semetey-1-2013:p1185:b003:l024","ordinal":167575,"en":"And people collided with people."},{"id":"semetey-1-2013:p1185:b003:l025","ordinal":167576,"en":"Hero Toshtuk, son of Eleman,"},{"id":"semetey-1-2013:p1185:b003:l026","ordinal":167577,"en":"Chose and entered Chalkuyruk."},{"id":"semetey-1-2013:p1185:b003:l027","ordinal":167578,"en":"Jamgyrchy of the Esheks"},{"id":"semetey-1-2013:p1185:b003:l028","ordinal":167579,"en":"Thought carefully and entered Akkokul."},{"id":"semetey-1-2013:p1185:b003:l029","ordinal":167580,"en":"Khan Koshoy of Katagan"},{"id":"semetey-1-2013:p1185:b003:l030","ordinal":167581,"en":"Chose and entered Kabylan."},{"id":"semetey-1-2013:p1185:b003:l031","ordinal":167582,"en":"Kokboru of Urum Khan"},{"id":"semetey-1-2013:p1185:b003:l032","ordinal":167583,"en":"Entered Kuu Kazyk as well."},{"id":"semetey-1-2013:p1185:b003:l033","ordinal":167584,"en":"Khan Kokcho of the Kazakhs"},{"id":"semetey-1-2013:p1185:b003:l034","ordinal":167585,"en":"Chose and entered Kokala."},{"id":"semetey-1-2013:p1185:b003:l035","ordinal":167586,"en":"The black gray-maned leopard"},{"id":"semetey-1-2013:p1185:b003:l036","ordinal":167587,"en":"Chose and entered Akkula."},{"id":"semetey-1-2013:p1185:b003:l037","ordinal":167588,"en":"With an armful of tack,"},{"id":"semetey-1-2013:p1185:b003:l038","ordinal":167589,"en":"Muzburchak of Buudayyk"},{"id":"semetey-1-2013:p1185:b003:l039","ordinal":167590,"en":"Began the commotion;"},{"id":"semetey-1-2013:p1185:b005:l001","ordinal":167591,"en":"He too then entered"},{"id":"semetey-1-2013:p1185:b005:l002","ordinal":167592,"en":"The racehorse Telkyzyl."},{"id":"semetey-1-2013:p1185:b005:l003","ordinal":167593,"en":"Hero Bagysh of the Jediger"},{"id":"semetey-1-2013:p1185:b005:l004","ordinal":167594,"en":"Took the narrow shortcut,"},{"id":"semetey-1-2013:p1185:b005:l005","ordinal":167595,"en":"Carefully leading and entering"},{"id":"semetey-1-2013:p1185:b005:l006","ordinal":167596,"en":"Surkiyik, swiftest of livestock."},{"id":"semetey-1-2013:p1185:b005:l007","ordinal":167597,"en":"Not a single shod colt remained;"},{"id":"semetey-1-2013:p1185:b005:l008","ordinal":167598,"en":"Every one entered the race."},{"id":"semetey-1-2013:p1185:b005:l009","ordinal":167599,"en":"The renowned tulpar steeds"},{"id":"semetey-1-2013:p1185:b005:l010","ordinal":167600,"en":"At Khan Kokotoy's celebration"},{"id":"semetey-1-2013:p1185:b005:l011","ordinal":167601,"en":"Now came out to compete."},{"id":"semetey-1-2013:p1185:b005:l012","ordinal":167602,"en":"They entered the horses on a list"},{"id":"semetey-1-2013:p1185:b005:l013","ordinal":167603,"en":"And counted them;"},{"id":"semetey-1-2013:p1185:b005:l014","ordinal":167604,"en":"The white paper filled with writing."},{"id":"semetey-1-2013:p1185:b005:l015","ordinal":167605,"en":"The racehorses at the feast"},{"id":"semetey-1-2013:p1185:b005:l016","ordinal":167606,"en":"Numbered seven thousand forty-three."},{"id":"semetey-1-2013:p1185:b005:l017","ordinal":167607,"en":"Among those horses,"},{"id":"semetey-1-2013:p1185:b005:l018","ordinal":167608,"en":"Young, tick-sized Kulatay"},{"id":"semetey-1-2013:p1185:b005:l019","ordinal":167609,"en":"Was going away in sorrow."},{"id":"semetey-1-2013:p1185:b005:l020","ordinal":167610,"en":"He was neither a three-year-old nor a yearling,"},{"id":"semetey-1-2013:p1185:b005:l021","ordinal":167611,"en":"Nor had his time to race arrived."},{"id":"semetey-1-2013:p1185:b005:l022","ordinal":167612,"en":"If only he raced at full age,"},{"id":"semetey-1-2013:p1185:b005:l023","ordinal":167613,"en":"Then he might win a prize."},{"id":"semetey-1-2013:p1185:b005:l024","ordinal":167614,"en":"Or if only he raced at three,"},{"id":"semetey-1-2013:p1185:b005:l025","ordinal":167615,"en":"Then he might win a prize."},{"id":"semetey-1-2013:p1185:b005:l026","ordinal":167616,"en":"When he reached his fifth year,"},{"id":"semetey-1-2013:p1185:b005:l027","ordinal":167617,"en":"Would he not begin the commotion"},{"id":"semetey-1-2013:p1185:b005:l028","ordinal":167618,"en":"And leave the racehorses behind?"},{"id":"semetey-1-2013:p1185:b005:l029","ordinal":167619,"en":"Would he not earn renown"},{"id":"semetey-1-2013:p1185:b005:l030","ordinal":167620,"en":"And spread his wings?"},{"id":"semetey-1-2013:p1185:b005:l031","ordinal":167621,"en":"The flesh of his calves was not yet full;"},{"id":"semetey-1-2013:p1185:b005:l032","ordinal":167622,"en":"His time to race had not yet come."},{"id":"semetey-1-2013:p1185:b005:l033","ordinal":167623,"en":"He was too young to know the land,"},{"id":"semetey-1-2013:p1185:b005:l034","ordinal":167624,"en":"Still a child at present."},{"id":"semetey-1-2013:p1185:b005:l035","ordinal":167625,"en":"If his shoulders filled out,"},{"id":"semetey-1-2013:p1185:b005:l036","ordinal":167626,"en":"And he grew fully among"},{"id":"semetey-1-2013:p1185:b005:l037","ordinal":167627,"en":"Those tulpar horses—"},{"id":"semetey-1-2013:p1185:b005:l038","ordinal":167628,"en":"There would be no overcoming Akkula,"},{"id":"semetey-1-2013:p1185:b005:l039","ordinal":167629,"en":"And no questioning Surkula,"},{"id":"semetey-1-2013:p1186:b003:l001","ordinal":167630,"en":"No remedy against Chalkuyruk."},{"id":"semetey-1-2013:p1186:b003:l002","ordinal":167631,"en":"Though I am young, I shall see;"},{"id":"semetey-1-2013:p1186:b003:l003","ordinal":167632,"en":"At worst, my poor soul,"},{"id":"semetey-1-2013:p1186:b003:l004","ordinal":167633,"en":"I will come behind three horses."},{"id":"semetey-1-2013:p1186:b003:l005","ordinal":167634,"en":"If only I had reached full age,"},{"id":"semetey-1-2013:p1186:b003:l006","ordinal":167635,"en":"I would lengthen my stride"},{"id":"semetey-1-2013:p1186:b003:l007","ordinal":167636,"en":"Against the tulpars racing now"},{"id":"semetey-1-2013:p1186:b003:l008","ordinal":167637,"en":"And perform every feat.\""},{"id":"semetey-1-2013:p1186:b003:l009","ordinal":167638,"en":"His owner stood and wept greatly,"},{"id":"semetey-1-2013:p1186:b003:l010","ordinal":167639,"en":"Consumed by grief as he wept."},{"id":"semetey-1-2013:p1186:b003:l011","ordinal":167640,"en":"\"I have raced a yearling among horses;"},{"id":"semetey-1-2013:p1186:b003:l012","ordinal":167641,"en":"God above, You alone know."},{"id":"semetey-1-2013:p1186:b003:l013","ordinal":167642,"en":"Unable to run strongly enough,"},{"id":"semetey-1-2013:p1186:b003:l014","ordinal":167643,"en":"What will Kulatay endure?"},{"id":"semetey-1-2013:p1186:b003:l015","ordinal":167644,"en":"Will Kulatay suffer hardship"},{"id":"semetey-1-2013:p1186:b003:l016","ordinal":167645,"en":"And die upon the steppe?"},{"id":"semetey-1-2013:p1186:b003:l017","ordinal":167646,"en":"Unable to move legs or body,"},{"id":"semetey-1-2013:p1186:b003:l018","ordinal":167647,"en":"Will Kulatay be taken?"},{"id":"semetey-1-2013:p1186:b003:l019","ordinal":167648,"en":"Will the stallion Kulatay"},{"id":"semetey-1-2013:p1186:b003:l020","ordinal":167649,"en":"Be left upon the steppe?"},{"id":"semetey-1-2013:p1186:b003:l021","ordinal":167650,"en":"While still a yearling,"},{"id":"semetey-1-2013:p1186:b003:l022","ordinal":167651,"en":"Will Kulatay meet disaster?"},{"id":"semetey-1-2013:p1186:b003:l023","ordinal":167652,"en":"If he can go no farther, that is ill fame."},{"id":"semetey-1-2013:p1186:b003:l024","ordinal":167653,"en":"God above, what can I do?"},{"id":"semetey-1-2013:p1186:b003:l025","ordinal":167654,"en":"I entrust him to You alone.\""},{"id":"semetey-1-2013:p1186:b003:l026","ordinal":167655,"en":"Before much time had passed,"},{"id":"semetey-1-2013:p1186:b003:l027","ordinal":167656,"en":"In the blink of an eye,"},{"id":"semetey-1-2013:p1186:b003:l028","ordinal":167657,"en":"Before one could turn about,"},{"id":"semetey-1-2013:p1186:b003:l029","ordinal":167658,"en":"A shout arose from the lowland;"},{"id":"semetey-1-2013:p1186:b003:l030","ordinal":167659,"en":"Everyone on the plain"},{"id":"semetey-1-2013:p1186:b003:l031","ordinal":167660,"en":"Cried, \"Drive out the horses!\""},{"id":"semetey-1-2013:p1186:b003:l032","ordinal":167661,"en":"A shout arose from the mountain;"},{"id":"semetey-1-2013:p1186:b003:l033","ordinal":167662,"en":"Everyone on the mountain,"},{"id":"semetey-1-2013:p1186:b003:l034","ordinal":167663,"en":"All pursuing without pause,"},{"id":"semetey-1-2013:p1186:b003:l035","ordinal":167664,"en":"Cried, \"Drive out the horses!\""},{"id":"semetey-1-2013:p1186:b003:l036","ordinal":167665,"en":"Foremost of the forty companions,"},{"id":"semetey-1-2013:p1186:b003:l037","ordinal":167666,"en":"Follower of falcon Manas,"},{"id":"semetey-1-2013:p1186:b003:l038","ordinal":167667,"en":"Saintly hero Bakay,"},{"id":"semetey-1-2013:p1186:b003:l039","ordinal":167668,"en":"Jelpinig, iron of the earth,"},{"id":"semetey-1-2013:p1186:b004:l001","ordinal":167669,"en":"Your gray-maned hero who knew perfectly,"},{"id":"semetey-1-2013:p1186:b004:l002","ordinal":167670,"en":"The four corners of the world—"},{"id":"semetey-1-2013:p1186:b004:l003","ordinal":167671,"en":"The saint who knew their origins."},{"id":"semetey-1-2013:p1186:b004:l004","ordinal":167672,"en":"Wore a blue lynx cap"},{"id":"semetey-1-2013:p1186:b004:l005","ordinal":167673,"en":"And wielded his mottled blue shield."},{"id":"semetey-1-2013:p1186:b004:l006","ordinal":167674,"en":"He chose that distant place"},{"id":"semetey-1-2013:p1186:b004:l007","ordinal":167675,"en":"As Akkula's starting point."},{"id":"semetey-1-2013:p1186:b004:l008","ordinal":167676,"en":"Beyond that, among the horses,"},{"id":"semetey-1-2013:p1186:b004:l009","ordinal":167677,"en":"No lingering regret remained."},{"id":"semetey-1-2013:p1186:b004:l010","ordinal":167678,"en":"He put armor upon him"},{"id":"semetey-1-2013:p1186:b004:l011","ordinal":167679,"en":"And mounted him on Maaniker."},{"id":"semetey-1-2013:p1186:b004:l012","ordinal":167680,"en":"Young Aydar of the flowing forelock"}]
