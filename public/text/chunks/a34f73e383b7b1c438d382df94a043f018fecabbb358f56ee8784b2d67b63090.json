[{"id":"semetey-1-2013:p0714:b003:l032","ordinal":131585,"en":"Khan Kongurbai and mighty Zholoi"},{"id":"semetey-1-2013:p0714:b003:l033","ordinal":131586,"en":"Had stirred and made ready."},{"id":"semetey-1-2013:p0714:b003:l034","ordinal":131587,"en":"The Kara Kalmyks and Torguts'"},{"id":"semetey-1-2013:p0714:b003:l035","ordinal":131588,"en":"Kindled fires they extinguished,"},{"id":"semetey-1-2013:p0714:b003:l036","ordinal":131589,"en":"And made them all move out together."},{"id":"semetey-1-2013:p0714:b003:l037","ordinal":131590,"en":"They gelded their stallions into riding horses,"},{"id":"semetey-1-2013:p0714:b003:l038","ordinal":131591,"en":"Placed their idols upon their heads,"},{"id":"semetey-1-2013:p0714:b003:l039","ordinal":131592,"en":"And made their pledge swiftly."},{"id":"semetey-1-2013:p0714:b004:l001","ordinal":131593,"en":"To raid the Burut,"},{"id":"semetey-1-2013:p0714:b004:l002","ordinal":131594,"en":"To wreak some terrible deed,"},{"id":"semetey-1-2013:p0714:b004:l003","ordinal":131595,"en":"They gelded their male camels,"},{"id":"semetey-1-2013:p0714:b004:l004","ordinal":131596,"en":"And made much of the army go on foot."},{"id":"semetey-1-2013:p0714:b004:l005","ordinal":131597,"en":"So their army would not flee to Beijing,"},{"id":"semetey-1-2013:p0714:b004:l006","ordinal":131598,"en":"Would not scatter and disperse,"},{"id":"semetey-1-2013:p0714:b004:l007","ordinal":131599,"en":"Red-whipped Shypshaidar,"},{"id":"semetey-1-2013:p0714:b004:l008","ordinal":131600,"en":"They put Shypshaidar in charge."},{"id":"semetey-1-2013:p0714:b004:l009","ordinal":131601,"en":"Driving their great army onward,"},{"id":"semetey-1-2013:p0714:b004:l010","ordinal":131602,"en":"They spread them like ants."},{"id":"semetey-1-2013:p0714:b004:l011","ordinal":131603,"en":"Blood in Beijing"},{"id":"semetey-1-2013:p0714:b004:l012","ordinal":131604,"en":"Myriad livestock collected as tax,"},{"id":"semetey-1-2013:p0714:b004:l013","ordinal":131605,"en":"They had driven along for provisions."},{"id":"semetey-1-2013:p0714:b004:l014","ordinal":131606,"en":"The red banner with its golden crescent,"},{"id":"semetey-1-2013:p0714:b004:l015","ordinal":131607,"en":"Shouts and tumult resounded."},{"id":"semetey-1-2013:p0714:b004:l016","ordinal":131608,"en":"“Against the dark-hearted Burut,"},{"id":"semetey-1-2013:p0714:b004:l017","ordinal":131609,"en":"I shall march and wage war,” he said."},{"id":"semetey-1-2013:p0714:b004:l018","ordinal":131610,"en":"“The great strife that will not heal,"},{"id":"semetey-1-2013:p0714:b004:l019","ordinal":131611,"en":"The heavy blood-price for Alooke,"},{"id":"semetey-1-2013:p0714:b004:l020","ordinal":131612,"en":"I shall go and take from the Burut,” he said."},{"id":"semetey-1-2013:p0714:b004:l021","ordinal":131613,"en":"“A red sash made in Beijing,"},{"id":"semetey-1-2013:p0714:b004:l022","ordinal":131614,"en":"I shall bind firmly round my waist,” he said."},{"id":"semetey-1-2013:p0714:b004:l023","ordinal":131615,"en":"“I shall seek the blood-price for my father Alooke,” he said."},{"id":"semetey-1-2013:p0714:b004:l024","ordinal":131616,"en":"The forty Chinese tribes, a formidable people,"},{"id":"semetey-1-2013:p0714:b004:l025","ordinal":131617,"en":"They drove onward at the fitting moment."},{"id":"semetey-1-2013:p0714:b004:l026","ordinal":131618,"en":"The Chinese wearing jackets,"},{"id":"semetey-1-2013:p0714:b004:l027","ordinal":131619,"en":"Their strongest they drove along together."},{"id":"semetey-1-2013:p0714:b004:l028","ordinal":131620,"en":"When the Kara Chinese and Manchu people"},{"id":"semetey-1-2013:p0714:b004:l029","ordinal":131621,"en":"Swept down upon us,"},{"id":"semetey-1-2013:p0714:b004:l030","ordinal":131622,"en":"When they wrought devastation,"},{"id":"semetey-1-2013:p0714:b004:l031","ordinal":131623,"en":"Kardygach, standing lookout,"},{"id":"semetey-1-2013:p0714:b004:l032","ordinal":131624,"en":"Alone caught sight of them."},{"id":"semetey-1-2013:p0714:b004:l033","ordinal":131625,"en":"Taking the sword Zulpukor in hand,"},{"id":"semetey-1-2013:p0714:b004:l034","ordinal":131626,"en":"Striking Telkyzyl once,"},{"id":"semetey-1-2013:p0714:b004:l035","ordinal":131627,"en":"Into the Chinese covering the earth"},{"id":"semetey-1-2013:p0714:b004:l036","ordinal":131628,"en":"She entered alone and attacked their army."},{"id":"semetey-1-2013:p0714:b004:l037","ordinal":131629,"en":"When Kardygach endured that hell,"},{"id":"semetey-1-2013:p0714:b004:l038","ordinal":131630,"en":"Here, telling of it,"},{"id":"semetey-1-2013:p0714:b004:l039","ordinal":131631,"en":"Khan Bakai had these words."},{"id":"semetey-1-2013:p0715:b003:l001","ordinal":131632,"en":"Kyrgylchal, head of the forty,"},{"id":"semetey-1-2013:p0715:b003:l002","ordinal":131633,"en":"The mad old man, swollen with pride among the forty,"},{"id":"semetey-1-2013:p0715:b003:l003","ordinal":131634,"en":"The bald old man with a scanty beard,"},{"id":"semetey-1-2013:p0715:b003:l004","ordinal":131635,"en":"The infidel old man born for mischief,"},{"id":"semetey-1-2013:p0715:b003:l005","ordinal":131636,"en":"Who devised a thousand wicked schemes—"},{"id":"semetey-1-2013:p0715:b003:l006","ordinal":131637,"en":"Though he was ruining everything,"},{"id":"semetey-1-2013:p0715:b003:l007","ordinal":131638,"en":"Courser Manas, the leopard,"},{"id":"semetey-1-2013:p0715:b003:l008","ordinal":131639,"en":"Never said, ‘He has wrought mischief.’"},{"id":"semetey-1-2013:p0715:b003:l009","ordinal":131640,"en":"Following in his footsteps,"},{"id":"semetey-1-2013:p0715:b003:l010","ordinal":131641,"en":"Slandering him with hellish malice,"},{"id":"semetey-1-2013:p0715:b003:l011","ordinal":131642,"en":"He had words that men would believe,"},{"id":"semetey-1-2013:p0715:b003:l012","ordinal":131643,"en":"He had ways fit for hell."},{"id":"semetey-1-2013:p0715:b003:l013","ordinal":131644,"en":"Your mountain-like father, Khan Manas,"},{"id":"semetey-1-2013:p0715:b003:l014","ordinal":131645,"en":"Had been led astray by him."},{"id":"semetey-1-2013:p0715:b003:l015","ordinal":131646,"en":"Kyrgyl said this to your father,"},{"id":"semetey-1-2013:p0715:b003:l016","ordinal":131647,"en":"Spoke of horrors no man knew."},{"id":"semetey-1-2013:p0715:b003:l017","ordinal":131648,"en":"These were Kyrgyl's words;"},{"id":"semetey-1-2013:p0715:b003:l018","ordinal":131649,"en":"Your father, gone to the next world,"},{"id":"semetey-1-2013:p0715:b003:l019","ordinal":131650,"en":"Was led astray in this way:"},{"id":"semetey-1-2013:p0715:b003:l020","ordinal":131651,"en":"‘Manas, blessed by Khizir, hear my words!"},{"id":"semetey-1-2013:p0715:b003:l021","ordinal":131652,"en":"Your countless beasts upon the hills"},{"id":"semetey-1-2013:p0715:b003:l022","ordinal":131653,"en":"Are no coursers, after all."},{"id":"semetey-1-2013:p0715:b003:l023","ordinal":131654,"en":"You became friends for the next world—"},{"id":"semetey-1-2013:p0715:b003:l024","ordinal":131655,"en":"Akbaltai's Chubak,"},{"id":"semetey-1-2013:p0715:b003:l025","ordinal":131656,"en":"That malicious wretch,"},{"id":"semetey-1-2013:p0715:b003:l026","ordinal":131657,"en":"Is no kinsman, after all."},{"id":"semetey-1-2013:p0715:b003:l027","ordinal":131658,"en":"Cherish an ass for nine years,"},{"id":"semetey-1-2013:p0715:b003:l028","ordinal":131659,"en":"It will never become a courser."},{"id":"semetey-1-2013:p0715:b003:l029","ordinal":131660,"en":"Akbaltai's bastard Chubak,"},{"id":"semetey-1-2013:p0715:b003:l030","ordinal":131661,"en":"That wretch born of a daughter,"},{"id":"semetey-1-2013:p0715:b003:l031","ordinal":131662,"en":"Will never become your kinsman."},{"id":"semetey-1-2013:p0715:b003:l032","ordinal":131663,"en":"White wheat sown on a ridge"},{"id":"semetey-1-2013:p0715:b003:l033","ordinal":131664,"en":"Is no crop, after all."},{"id":"semetey-1-2013:p0715:b003:l034","ordinal":131665,"en":"Kanykei and your Chubak"},{"id":"semetey-1-2013:p0715:b003:l035","ordinal":131666,"en":"Are not innocent, after all."},{"id":"semetey-1-2013:p0715:b003:l036","ordinal":131667,"en":"The valleys of this Talas"},{"id":"semetey-1-2013:p0715:b003:l037","ordinal":131668,"en":"Will never become ravines, after all."},{"id":"semetey-1-2013:p0715:b003:l038","ordinal":131669,"en":"Kanykei and this Chubak"},{"id":"semetey-1-2013:p0715:b003:l039","ordinal":131670,"en":"Are not innocent, after all."},{"id":"semetey-1-2013:p0715:b005:l001","ordinal":131671,"en":"When the people move toward Kan-Jailoo,"},{"id":"semetey-1-2013:p0715:b005:l002","ordinal":131672,"en":"They dismount without a care."},{"id":"semetey-1-2013:p0715:b005:l003","ordinal":131673,"en":"On the migration they drink liquor,"},{"id":"semetey-1-2013:p0715:b005:l004","ordinal":131674,"en":"Drinking it openly."},{"id":"semetey-1-2013:p0715:b005:l005","ordinal":131675,"en":"Lord Manas the sultan—"},{"id":"semetey-1-2013:p0715:b005:l006","ordinal":131676,"en":"Can one who treads his bed prosper?"},{"id":"semetey-1-2013:p0715:b005:l007","ordinal":131677,"en":"If sickness truly strikes his head,"},{"id":"semetey-1-2013:p0715:b005:l008","ordinal":131678,"en":"Will raving Chubak rise again?"},{"id":"semetey-1-2013:p0715:b005:l009","ordinal":131679,"en":"Blessed Manas, the fierce one—"},{"id":"semetey-1-2013:p0715:b005:l010","ordinal":131680,"en":"Can one who treads his pillow prosper?"},{"id":"semetey-1-2013:p0715:b005:l011","ordinal":131681,"en":"False-swearing Chubak, that half-Sart—"},{"id":"semetey-1-2013:p0715:b005:l012","ordinal":131682,"en":"Will he rise when it strikes his soul?’"},{"id":"semetey-1-2013:p0715:b005:l013","ordinal":131683,"en":"Speaking such words,"},{"id":"semetey-1-2013:p0715:b005:l014","ordinal":131684,"en":"He turned truthful words into a curse."},{"id":"semetey-1-2013:p0715:b005:l015","ordinal":131685,"en":"The words Kyrgyl spoke—"},{"id":"semetey-1-2013:p0715:b005:l016","ordinal":131686,"en":"Your khan father, gone to the next world,"},{"id":"semetey-1-2013:p0715:b005:l017","ordinal":131687,"en":"Believed them wholly."},{"id":"semetey-1-2013:p0715:b005:l018","ordinal":131688,"en":"Leopard Chubak was shamed;"},{"id":"semetey-1-2013:p0715:b005:l019","ordinal":131689,"en":"Hearing them, he was distressed."},{"id":"semetey-1-2013:p0715:b005:l020","ordinal":131690,"en":"‘Kanykei was my mother!"},{"id":"semetey-1-2013:p0715:b005:l021","ordinal":131691,"en":"Could I prosper if I took advantage of her?"},{"id":"semetey-1-2013:p0715:b005:l022","ordinal":131692,"en":"With the noble khan, wretched me,"},{"id":"semetey-1-2013:p0715:b005:l023","ordinal":131693,"en":"I was a friend for the next world."},{"id":"semetey-1-2013:p0715:b005:l024","ordinal":131694,"en":"Could I prosper if I pissed upon that oath?’"},{"id":"semetey-1-2013:p0715:b005:l025","ordinal":131695,"en":"So saying, he blazed with anger."},{"id":"semetey-1-2013:p0715:b005:l026","ordinal":131696,"en":"Chubak took offense and felt aggrieved."},{"id":"semetey-1-2013:p0715:b005:l027","ordinal":131697,"en":"Countless treasures, gold and riches—"},{"id":"semetey-1-2013:p0715:b005:l028","ordinal":131698,"en":"Chubak scattered them all abroad."},{"id":"semetey-1-2013:p0715:b005:l029","ordinal":131699,"en":"To Chong-Alai of broad Kashgar,"},{"id":"semetey-1-2013:p0715:b005:l030","ordinal":131700,"en":"Chubak fled in proud defiance."},{"id":"semetey-1-2013:p0715:b005:l031","ordinal":131701,"en":"With cotton sash and roomy boots—"},{"id":"semetey-1-2013:p0715:b005:l032","ordinal":131702,"en":"To the Kalcha, the monks' khan,"},{"id":"semetey-1-2013:p0715:b005:l033","ordinal":131703,"en":"Khan Akbaltai's warrior Chubak"},{"id":"semetey-1-2013:p0715:b005:l034","ordinal":131704,"en":"Gave six swift horses,"},{"id":"semetey-1-2013:p0715:b005:l035","ordinal":131705,"en":"Gave a letter the size of a palm:"},{"id":"semetey-1-2013:p0715:b005:l036","ordinal":131706,"en":"‘Fortunate Lord Manas"},{"id":"semetey-1-2013:p0715:b005:l037","ordinal":131707,"en":"God has taken, leaving him stretched out;"},{"id":"semetey-1-2013:p0715:b005:l038","ordinal":131708,"en":"The companions who supported him"},{"id":"semetey-1-2013:p0715:b005:l039","ordinal":131709,"en":"Have left his side,’ he said."},{"id":"semetey-1-2013:p0716:b003:l001","ordinal":131710,"en":"The heart of Talas had become a ravine;"},{"id":"semetey-1-2013:p0716:b003:l002","ordinal":131711,"en":"Trusted Chubak had become an enemy."},{"id":"semetey-1-2013:p0716:b003:l003","ordinal":131712,"en":"To Beijing of the khakan khan,"},{"id":"semetey-1-2013:p0716:b003:l004","ordinal":131713,"en":"Chubak's letter had arrived."},{"id":"semetey-1-2013:p0716:b003:l005","ordinal":131714,"en":"To avenge Alooke,"},{"id":"semetey-1-2013:p0716:b003:l006","ordinal":131715,"en":"With Khan Kongurbai at their head,"},{"id":"semetey-1-2013:p0716:b003:l007","ordinal":131716,"en":"The forty Chinese tribes set out."},{"id":"semetey-1-2013:p0716:b003:l008","ordinal":131717,"en":"Kyrgyl, head of the forty—"},{"id":"semetey-1-2013:p0716:b003:l009","ordinal":131718,"en":"When God Almighty took him,"},{"id":"semetey-1-2013:p0716:b003:l010","ordinal":131719,"en":"Your precious mother Kanykei"},{"id":"semetey-1-2013:p0716:b003:l011","ordinal":131720,"en":"Had been neglected for six months."},{"id":"semetey-1-2013:p0716:b003:l012","ordinal":131721,"en":"In a mountainside hollow of great Talas,"},{"id":"semetey-1-2013:p0716:b003:l013","ordinal":131722,"en":"Your great lord father, warrior Khan Manas,"},{"id":"semetey-1-2013:p0716:b003:l014","ordinal":131723,"en":"Was sleeping with Akylai."},{"id":"semetey-1-2013:p0716:b003:l015","ordinal":131724,"en":"Feeling shame, saying nothing,"},{"id":"semetey-1-2013:p0716:b003:l016","ordinal":131725,"en":"Unfortunate Kanykei suffered torment."},{"id":"semetey-1-2013:p0716:b003:l017","ordinal":131726,"en":"Neglected Kanykei"},{"id":"semetey-1-2013:p0716:b003:l018","ordinal":131727,"en":"Summered at Jilgynduu."},{"id":"semetey-1-2013:p0716:b003:l019","ordinal":131728,"en":"Akkula and Akolpok,"},{"id":"semetey-1-2013:p0716:b003:l020","ordinal":131729,"en":"She made them both ready together."},{"id":"semetey-1-2013:p0716:b003:l021","ordinal":131730,"en":"In those days, in Kara-Buura and Chatkal,"},{"id":"semetey-1-2013:p0716:b003:l022","ordinal":131731,"en":"Lying at ease without sorrow,"},{"id":"semetey-1-2013:p0716:b003:l023","ordinal":131732,"en":"The multitude of Kyrgyz lay encamped."},{"id":"semetey-1-2013:p0716:b003:l024","ordinal":131733,"en":"Dusk fell, the sun set;"},{"id":"semetey-1-2013:p0716:b003:l025","ordinal":131734,"en":"The earliest sleepers had all lain down."},{"id":"semetey-1-2013:p0716:b003:l026","ordinal":131735,"en":"Gray-mottled pennants, a red banner,"},{"id":"semetey-1-2013:p0716:b003:l027","ordinal":131736,"en":"Cries of ‘Alas!’ and great uproar;"},{"id":"semetey-1-2013:p0716:b003:l028","ordinal":131737,"en":"White standards, a black banner,"},{"id":"semetey-1-2013:p0716:b003:l029","ordinal":131738,"en":"Battle cries and great uproar."},{"id":"semetey-1-2013:p0716:b003:l030","ordinal":131739,"en":"Stars slanted down, breaking from the sky."},{"id":"semetey-1-2013:p0716:b003:l031","ordinal":131740,"en":"All manner of shouts—"},{"id":"semetey-1-2013:p0716:b003:l032","ordinal":131741,"en":"They seemed to be Chinese voices."},{"id":"semetey-1-2013:p0716:b003:l033","ordinal":131742,"en":"Swarming like black worms,"},{"id":"semetey-1-2013:p0716:b003:l034","ordinal":131743,"en":"The Kalmyk army surged;"},{"id":"semetey-1-2013:p0716:b003:l035","ordinal":131744,"en":"The jangjung's army closed in."},{"id":"semetey-1-2013:p0716:b003:l036","ordinal":131745,"en":"Kongurbai, the monks' khan,"},{"id":"semetey-1-2013:p0716:b003:l037","ordinal":131746,"en":"Had prepared ahead of them."},{"id":"semetey-1-2013:p0716:b003:l038","ordinal":131747,"en":"Upon the Kyrgyz of four tribes"},{"id":"semetey-1-2013:p0716:b003:l039","ordinal":131748,"en":"He descended from above."},{"id":"semetey-1-2013:p0716:b004:l001","ordinal":131749,"en":"Barefoot and bareheaded,"},{"id":"semetey-1-2013:p0716:b004:l002","ordinal":131750,"en":"Taking a tent pole in his hand,"},{"id":"semetey-1-2013:p0716:b004:l003","ordinal":131751,"en":"Your lord father Manas was in haste."},{"id":"semetey-1-2013:p0716:b004:l004","ordinal":131752,"en":"Then the lord's wife Kanykei,"},{"id":"semetey-1-2013:p0716:b004:l005","ordinal":131753,"en":"That tormented, fiery, luckless woman,"},{"id":"semetey-1-2013:p0716:b004:l006","ordinal":131754,"en":"Showed her valor."},{"id":"semetey-1-2013:p0716:b004:l007","ordinal":131755,"en":"Akkula and Akolpok—"},{"id":"semetey-1-2013:p0716:b004:l008","ordinal":131756,"en":"She mounted your father,"},{"id":"semetey-1-2013:p0716:b004:l009","ordinal":131757,"en":"And all his weapons"},{"id":"semetey-1-2013:p0716:b004:l010","ordinal":131758,"en":"She gave into your father's keeping,"},{"id":"semetey-1-2013:p0716:b004:l011","ordinal":131759,"en":"Sending him thus against the Chinese."},{"id":"semetey-1-2013:p0716:b004:l012","ordinal":131760,"en":"Blue haze broke from the sky;"},{"id":"semetey-1-2013:p0716:b004:l013","ordinal":131761,"en":"Sweeping forward on Kökala,"},{"id":"semetey-1-2013:p0716:b004:l014","ordinal":131762,"en":"Your fierce Chubak appeared."},{"id":"semetey-1-2013:p0716:b004:l015","ordinal":131763,"en":"Khan Bakai, the rich man's son,"},{"id":"semetey-1-2013:p0716:b004:l016","ordinal":131764,"en":"Your warrior elder was there too,"},{"id":"semetey-1-2013:p0716:b004:l017","ordinal":131765,"en":"And Ulak Khan's Syrgak,"},{"id":"semetey-1-2013:p0716:b004:l018","ordinal":131766,"en":"And your father, leopard Manas."},{"id":"semetey-1-2013:p0716:b004:l019","ordinal":131767,"en":"When these men wrought their deeds,"},{"id":"semetey-1-2013:p0716:b004:l020","ordinal":131768,"en":"The red banner of the Chinese—"},{"id":"semetey-1-2013:p0716:b004:l021","ordinal":131769,"en":"When my dear Chubak struck it,"},{"id":"semetey-1-2013:p0716:b004:l022","ordinal":131770,"en":"The infidels of another faith"},{"id":"semetey-1-2013:p0716:b004:l023","ordinal":131771,"en":"Hastened to draw back."},{"id":"semetey-1-2013:p0716:b004:l024","ordinal":131772,"en":"Your exceedingly fortunate father's"},{"id":"semetey-1-2013:p0716:b004:l025","ordinal":131773,"en":"Heat they could not endure;"},{"id":"semetey-1-2013:p0716:b004:l026","ordinal":131774,"en":"His strength they could not withstand."},{"id":"semetey-1-2013:p0716:b004:l027","ordinal":131775,"en":"The black Manchus, the many Sibe,"},{"id":"semetey-1-2013:p0716:b004:l028","ordinal":131776,"en":"Fled in headlong haste."},{"id":"semetey-1-2013:p0716:b004:l029","ordinal":131777,"en":"The Chinese banner fell;"},{"id":"semetey-1-2013:p0716:b004:l030","ordinal":131778,"en":"They fled toward Beijing."},{"id":"semetey-1-2013:p0716:b004:l031","ordinal":131779,"en":"The infidels, thick as black willows,"},{"id":"semetey-1-2013:p0716:b004:l032","ordinal":131780,"en":"They scattered toward Beijing."},{"id":"semetey-1-2013:p0716:b004:l033","ordinal":131781,"en":"With their teeth jutting out,"},{"id":"semetey-1-2013:p0716:b004:l034","ordinal":131782,"en":"Dead horses fell in mountains."},{"id":"semetey-1-2013:p0716:b004:l035","ordinal":131783,"en":"With their fine mustaches smoothed down,"},{"id":"semetey-1-2013:p0716:b004:l036","ordinal":131784,"en":"Dead warriors fell in heaps."},{"id":"semetey-1-2013:p0716:b004:l037","ordinal":131785,"en":"The black Chinese and Manchus—"},{"id":"semetey-1-2013:p0716:b004:l038","ordinal":131786,"en":"Their cries reached God."},{"id":"semetey-1-2013:p0716:b004:l039","ordinal":131787,"en":"All their spears"},{"id":"semetey-1-2013:p0717:b003:l001","ordinal":131788,"en":"Fell crisscross to the ground."},{"id":"semetey-1-2013:p0717:b003:l002","ordinal":131789,"en":"Against the forty Chinese tribes of Beijing,"},{"id":"semetey-1-2013:p0717:b003:l003","ordinal":131790,"en":"They wrought such deeds,"},{"id":"semetey-1-2013:p0717:b003:l004","ordinal":131791,"en":"And the handful of Muslims"},{"id":"semetey-1-2013:p0717:b003:l005","ordinal":131792,"en":"They rescued and set free."},{"id":"semetey-1-2013:p0717:b003:l006","ordinal":131793,"en":"The jacket-wearing Chinese—"},{"id":"semetey-1-2013:p0717:b003:l007","ordinal":131794,"en":"Their strongest they drove off and slew."},{"id":"semetey-1-2013:p0717:b003:l008","ordinal":131795,"en":"The stone-worshipping Chinese—"},{"id":"semetey-1-2013:p0717:b003:l009","ordinal":131796,"en":"Their bald ones they pursued."},{"id":"semetey-1-2013:p0717:b003:l010","ordinal":131797,"en":"Let us leave that aside,"},{"id":"semetey-1-2013:p0717:b003:l011","ordinal":131798,"en":"And lonely Kardygach in sorrow—"},{"id":"semetey-1-2013:p0717:b003:l012","ordinal":131799,"en":"Let us begin to tell of her."},{"id":"semetey-1-2013:p0717:b003:l013","ordinal":131800,"en":"Kardygach, born a leopard,"},{"id":"semetey-1-2013:p0717:b003:l014","ordinal":131801,"en":"Faced Kongurbai, the monks' khan,"},{"id":"semetey-1-2013:p0717:b003:l015","ordinal":131802,"en":"Standing against him."},{"id":"semetey-1-2013:p0717:b003:l016","ordinal":131803,"en":"Sparing not her precious life,"},{"id":"semetey-1-2013:p0717:b003:l017","ordinal":131804,"en":"At Alooke's Kongurbai,"},{"id":"semetey-1-2013:p0717:b003:l018","ordinal":131805,"en":"Kardygach standing there"},{"id":"semetey-1-2013:p0717:b003:l019","ordinal":131806,"en":"Charged and thrust her spear."},{"id":"semetey-1-2013:p0717:b003:l020","ordinal":131807,"en":"Alooke's Kongurbai"},{"id":"semetey-1-2013:p0717:b003:l021","ordinal":131808,"en":"Found himself at his wits' end."},{"id":"semetey-1-2013:p0717:b003:l022","ordinal":131809,"en":"Kongurbai's forty lords,"},{"id":"semetey-1-2013:p0717:b003:l023","ordinal":131810,"en":"The swaggering Kalcha,"},{"id":"semetey-1-2013:p0717:b003:l024","ordinal":131811,"en":"She had weakened them."},{"id":"semetey-1-2013:p0717:b003:l025","ordinal":131812,"en":"The giants of the Chinese,"},{"id":"semetey-1-2013:p0717:b003:l026","ordinal":131813,"en":"Warriors as numerous as ants,"},{"id":"semetey-1-2013:p0717:b003:l027","ordinal":131814,"en":"The infidels surrounded her."},{"id":"semetey-1-2013:p0717:b003:l028","ordinal":131815,"en":"May solitude perish!"},{"id":"semetey-1-2013:p0717:b003:l029","ordinal":131816,"en":"The infidels' treasury marksman,"},{"id":"semetey-1-2013:p0717:b003:l030","ordinal":131817,"en":"Karajoy, drew near."},{"id":"semetey-1-2013:p0717:b003:l031","ordinal":131818,"en":"Black-maned Boroonchu—"},{"id":"semetey-1-2013:p0717:b003:l032","ordinal":131819,"en":"When she speared Boroonchu,"},{"id":"semetey-1-2013:p0717:b003:l033","ordinal":131820,"en":"The girl met with misfortune."},{"id":"semetey-1-2013:p0717:b003:l034","ordinal":131821,"en":"Karajoy, standing close,"},{"id":"semetey-1-2013:p0717:b003:l035","ordinal":131822,"en":"Shot the horse Telkyzyl."},{"id":"semetey-1-2013:p0717:b003:l036","ordinal":131823,"en":"Shaking his head, Telkyzyl"},{"id":"semetey-1-2013:p0717:b003:l037","ordinal":131824,"en":"Collapsed and lay upon the ground."},{"id":"semetey-1-2013:p0717:b003:l038","ordinal":131825,"en":"Then Ylama, the Kalmyk wrestler—"},{"id":"semetey-1-2013:p0717:b003:l039","ordinal":131826,"en":"Ask not about that infidel!"},{"id":"semetey-1-2013:p0717:b004:l001","ordinal":131827,"en":"The girl caught in their hands"},{"id":"semetey-1-2013:p0717:b004:l002","ordinal":131828,"en":"They had surrounded."},{"id":"semetey-1-2013:p0717:b004:l003","ordinal":131829,"en":"Upon your unfortunate elder sister Kardygach"},{"id":"semetey-1-2013:p0717:b004:l004","ordinal":131830,"en":"They brought calamity."},{"id":"semetey-1-2013:p0717:b004:l005","ordinal":131831,"en":"Then those clad in iron-cord mail,"},{"id":"semetey-1-2013:p0717:b004:l006","ordinal":131832,"en":"All those with dagger-hands,"},{"id":"semetey-1-2013:p0717:b004:l007","ordinal":131833,"en":"Those skilled in casting lassos,"},{"id":"semetey-1-2013:p0717:b004:l008","ordinal":131834,"en":"The seething champions of the unbelievers—"},{"id":"semetey-1-2013:p0717:b004:l010","ordinal":131835,"en":"When the great army swept upon her,"},{"id":"semetey-1-2013:p0717:b004:l011","ordinal":131836,"en":"A jangjung who came near—"},{"id":"semetey-1-2013:p0717:b004:l012","ordinal":131837,"en":"She tore out his intestines."},{"id":"semetey-1-2013:p0717:b004:l013","ordinal":131838,"en":"Wherever her spear could reach,"},{"id":"semetey-1-2013:p0717:b004:l014","ordinal":131839,"en":"She sent them crawling with her spear."},{"id":"semetey-1-2013:p0717:b004:l015","ordinal":131840,"en":"Those who ventured close in eagerness,"}]
