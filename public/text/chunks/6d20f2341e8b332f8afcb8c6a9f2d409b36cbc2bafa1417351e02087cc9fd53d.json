[{"id":"manas-2010:p1299:b001:l033","ordinal":56321,"en":"Dear Syrgak relaxed."},{"id":"manas-2010:p1299:b001:l034","ordinal":56322,"en":"His eyes closed for a brief moment;"},{"id":"manas-2010:p1299:b001:l035","ordinal":56323,"en":"Dear Syrgak fell asleep."},{"id":"manas-2010:p1299:b001:l036","ordinal":56324,"en":"Once Syrgak had fallen asleep,"},{"id":"manas-2010:p1299:b001:l037","ordinal":56325,"en":"Cotton belt and broad boots—"},{"id":"manas-2010:p1299:b001:l038","ordinal":56326,"en":"Kongurbay, khan of the shaven-headed ones,"},{"id":"manas-2010:p1299:b001:l039","ordinal":56327,"en":"To sleeping Syrgak"},{"id":"manas-2010:p1299:b001:l040","ordinal":56328,"en":"Came up at that moment."},{"id":"manas-2010:p1299:b001:l041","ordinal":56329,"en":"The battle-axe with its golden handle,"},{"id":"manas-2010:p1299:b001:l042","ordinal":56330,"en":"He seized and swung,"},{"id":"manas-2010:p1300:b001:l001","ordinal":56331,"en":"Taking careful aim at Syrgak,"},{"id":"manas-2010:p1300:b001:l002","ordinal":56332,"en":"He struck his temple as he passed."},{"id":"manas-2010:p1300:b001:l003","ordinal":56333,"en":"When he struck with the battle-axe,"},{"id":"manas-2010:p1300:b001:l004","ordinal":56334,"en":"The horse wheeled and darted aside;"},{"id":"manas-2010:p1300:b001:l005","ordinal":56335,"en":"Kökchebich, a true swift steed,"},{"id":"manas-2010:p1300:b001:l006","ordinal":56336,"en":"Made the blow at Syrgak go astray,"},{"id":"manas-2010:p1300:b001:l007","ordinal":56337,"en":"Wheeling and flashing aside."},{"id":"manas-2010:p1300:b001:l008","ordinal":56338,"en":"The Fierce One who had come prepared"},{"id":"manas-2010:p1300:b001:l009","ordinal":56339,"en":"Had struck off his mark."},{"id":"manas-2010:p1300:b001:l010","ordinal":56340,"en":"Kökchebich beneath him,"},{"id":"manas-2010:p1300:b001:l011","ordinal":56341,"en":"Through armies beyond all counting,"},{"id":"manas-2010:p1300:b001:l012","ordinal":56342,"en":"Not letting Syrgak be captured,"},{"id":"manas-2010:p1300:b001:l013","ordinal":56343,"en":"Galloped through their midst."},{"id":"manas-2010:p1300:b001:l014","ordinal":56344,"en":"From hero Syrgak's temple"},{"id":"manas-2010:p1300:b001:l015","ordinal":56345,"en":"Dark crimson blood poured."},{"id":"manas-2010:p1300:b001:l016","ordinal":56346,"en":"Fainting and growing weak,"},{"id":"manas-2010:p1300:b001:l017","ordinal":56347,"en":"Hero Syrgak lost his strength."},{"id":"manas-2010:p1300:b001:l018","ordinal":56348,"en":"Hero Syrgak's Kökchebich,"},{"id":"manas-2010:p1300:b001:l019","ordinal":56349,"en":"Shattering the ground wherever he trod,"},{"id":"manas-2010:p1300:b001:l020","ordinal":56350,"en":"Clods as big as great cauldrons"},{"id":"manas-2010:p1300:b001:l021","ordinal":56351,"en":"Flying and whistling above his head,"},{"id":"manas-2010:p1300:b001:l022","ordinal":56352,"en":"Carried Syrgak away,"},{"id":"manas-2010:p1300:b001:l023","ordinal":56353,"en":"Speeding like a flying bird."},{"id":"manas-2010:p1300:b001:l024","ordinal":56354,"en":"His hooves clattered on the ground;"},{"id":"manas-2010:p1300:b001:l025","ordinal":56355,"en":"The black steel bit"},{"id":"manas-2010:p1300:b001:l026","ordinal":56356,"en":"Clanked at his throat."},{"id":"manas-2010:p1300:b001:l027","ordinal":56357,"en":"His tail like strands of silk"},{"id":"manas-2010:p1300:b001:l028","ordinal":56358,"en":"Lashed between his hind legs."},{"id":"manas-2010:p1300:b001:l029","ordinal":56359,"en":"White foam mixed with blood"},{"id":"manas-2010:p1300:b001:l030","ordinal":56360,"en":"Clung to his chest."},{"id":"manas-2010:p1300:b001:l031","ordinal":56361,"en":"Wild-sheep feet, copper forelegs—"},{"id":"manas-2010:p1300:b001:l032","ordinal":56362,"en":"He was a true winged steed."},{"id":"manas-2010:p1300:b001:l033","ordinal":56363,"en":"Despairing of his entrusted life,"},{"id":"manas-2010:p1300:b001:l034","ordinal":56364,"en":"Syrgak upon his back"},{"id":"manas-2010:p1300:b001:l035","ordinal":56365,"en":"Was in a terrible state."},{"id":"manas-2010:p1300:b001:l036","ordinal":56366,"en":"Kongurbay, son of Alöökö,"},{"id":"manas-2010:p1300:b001:l037","ordinal":56367,"en":"As though an evil spirit had seized his wife,"},{"id":"manas-2010:p1300:b001:l038","ordinal":56368,"en":"Pursued him, shouting,"},{"id":"manas-2010:p1300:b001:l039","ordinal":56369,"en":"Calling, “Oh, Syrgak!”"},{"id":"manas-2010:p1300:b001:l040","ordinal":56370,"en":"Chasing and chasing but unable to catch him,"},{"id":"manas-2010:p1300:b001:l041","ordinal":56371,"en":"Kongurbay was left in a ravine."},{"id":"manas-2010:p1300:b001:l042","ordinal":56372,"en":"Not letting the pursuer catch up,"},{"id":"manas-2010:p1301:b001:l001","ordinal":56373,"en":"Hero Syrgak reached another place."},{"id":"manas-2010:p1301:b001:l002","ordinal":56374,"en":"In desperate straits,"},{"id":"manas-2010:p1301:b001:l003","ordinal":56375,"en":"Escaping from the countless armies,"},{"id":"manas-2010:p1301:b001:l004","ordinal":56376,"en":"With the battle-axe wound in his temple,"},{"id":"manas-2010:p1301:b001:l005","ordinal":56377,"en":"He fled straight toward Mecca."},{"id":"manas-2010:p1301:b001:l006","ordinal":56378,"en":"Over It-Torpu's Kyya-Bel"},{"id":"manas-2010:p1301:b001:l007","ordinal":56379,"en":"He went, crossing the pass."},{"id":"manas-2010:p1301:b001:l008","ordinal":56380,"en":"His head drenched in blood,"},{"id":"manas-2010:p1301:b001:l009","ordinal":56381,"en":"Young Syrgak, your formidable warrior,"},{"id":"manas-2010:p1301:b001:l010","ordinal":56382,"en":"Was fleeing away."},{"id":"manas-2010:p1301:b001:l011","ordinal":56383,"en":"Blood flowed from his temple."},{"id":"manas-2010:p1301:b001:l012","ordinal":56384,"en":"He had been a hero who knew no restraint;"},{"id":"manas-2010:p1301:b001:l013","ordinal":56385,"en":"Hero Syrgak's strength was gone."},{"id":"manas-2010:p1301:b001:l014","ordinal":56386,"en":"To the three at Tal-Choku,"},{"id":"manas-2010:p1301:b001:l015","ordinal":56387,"en":"He had no strength to turn back,"},{"id":"manas-2010:p1301:b001:l016","ordinal":56388,"en":"No means to halt."},{"id":"manas-2010:p1301:b001:l017","ordinal":56389,"en":"When he saw dear Syrgak,"},{"id":"manas-2010:p1301:b001:l018","ordinal":56390,"en":"Unable to turn matters over and find a plan,"},{"id":"manas-2010:p1301:b001:l019","ordinal":56391,"en":"Azizkhan's only son,"},{"id":"manas-2010:p1301:b001:l020","ordinal":56392,"en":"Unable to ride in pursuit,"},{"id":"manas-2010:p1301:b001:l021","ordinal":56393,"en":"Wind coming from his mouth,"},{"id":"manas-2010:p1301:b001:l022","ordinal":56394,"en":"Fire pouring from his eyes, cried:"},{"id":"manas-2010:p1301:b001:l023","ordinal":56395,"en":"“What is seen today is gone tomorrow."},{"id":"manas-2010:p1301:b001:l024","ordinal":56396,"en":"Alas, Syrgak, my leopard,"},{"id":"manas-2010:p1301:b001:l025","ordinal":56397,"en":"Such is this mischievous world!"},{"id":"manas-2010:p1301:b001:l026","ordinal":56398,"en":"What have you led us into?"},{"id":"manas-2010:p1301:b001:l027","ordinal":56399,"en":"When the Chinese are massed against us,"},{"id":"manas-2010:p1301:b001:l028","ordinal":56400,"en":"Where have you left me alone?"},{"id":"manas-2010:p1301:b001:l029","ordinal":56401,"en":"My hollow filled with meadowsweet,"},{"id":"manas-2010:p1301:b001:l030","ordinal":56402,"en":"Alas, Syrgak, my leopard,"},{"id":"manas-2010:p1301:b001:l031","ordinal":56403,"en":"My tempered steel,"},{"id":"manas-2010:p1301:b001:l032","ordinal":56404,"en":"My valley full of fescue,"},{"id":"manas-2010:p1301:b001:l033","ordinal":56405,"en":"Champion Syrgak, my magnificent one,"},{"id":"manas-2010:p1301:b001:l034","ordinal":56406,"en":"You have dug my pit!"},{"id":"manas-2010:p1301:b001:l035","ordinal":56407,"en":"Though I kept telling you, you did not listen;"},{"id":"manas-2010:p1301:b001:l036","ordinal":56408,"en":"You have made my misery boil!”"},{"id":"manas-2010:p1301:b001:l037","ordinal":56409,"en":"Leaning on his battle-axe,"},{"id":"manas-2010:p1301:b001:l038","ordinal":56410,"en":"Precious, fierce-maned Almambet,"},{"id":"manas-2010:p1301:b001:l039","ordinal":56411,"en":"Gazing angrily at the sky,"},{"id":"manas-2010:p1301:b001:l040","ordinal":56412,"en":"His heart burning with grief,"},{"id":"manas-2010:p1301:b001:l041","ordinal":56413,"en":"His ribs torn apart with sorrow,"},{"id":"manas-2010:p1301:b001:l042","ordinal":56414,"en":"For his cherished Syrgak"},{"id":"manas-2010:p1302:b001:l001","ordinal":56415,"en":"Tears poured from his eyes."},{"id":"manas-2010:p1302:b001:l002","ordinal":56416,"en":"Without looking back, the Muslim,"},{"id":"manas-2010:p1302:b001:l003","ordinal":56417,"en":"As though he had gone without looking back—"},{"id":"manas-2010:p1302:b001:l004","ordinal":56418,"en":"Chubak, son of Akbaltay,"},{"id":"manas-2010:p1302:b001:l005","ordinal":56419,"en":"Struck his palms together,"},{"id":"manas-2010:p1302:b001:l006","ordinal":56420,"en":"Lamenting and weeping greatly."},{"id":"manas-2010:p1302:b001:l007","ordinal":56421,"en":"“My precious Syrgak!” he wept."},{"id":"manas-2010:p1302:b001:l008","ordinal":56422,"en":"“That daughter-selling deceiver!"},{"id":"manas-2010:p1302:b001:l009","ordinal":56423,"en":"My dear Syrgak, my leopard,"},{"id":"manas-2010:p1302:b001:l010","ordinal":56424,"en":"He was drunk without drinking liquor,"},{"id":"manas-2010:p1302:b001:l011","ordinal":56425,"en":"Plainly never sparing his life;"},{"id":"manas-2010:p1302:b001:l012","ordinal":56426,"en":"He was still young."},{"id":"manas-2010:p1302:b001:l013","ordinal":56427,"en":"This year, luckless Syrgak"},{"id":"manas-2010:p1302:b001:l014","ordinal":56428,"en":"Was twenty years old."},{"id":"manas-2010:p1302:b001:l015","ordinal":56429,"en":"Thus God has struck him down!"},{"id":"manas-2010:p1302:b001:l016","ordinal":56430,"en":"Carelessly letting himself be struck,"},{"id":"manas-2010:p1302:b001:l017","ordinal":56431,"en":"He has left us like an extinguished fire!"},{"id":"manas-2010:p1302:b001:l018","ordinal":56432,"en":"My leopard, Khan Syrgak,"},{"id":"manas-2010:p1302:b001:l019","ordinal":56433,"en":"My untroubled young hero,"},{"id":"manas-2010:p1302:b001:l020","ordinal":56434,"en":"Everything had been in his favor."},{"id":"manas-2010:p1302:b001:l021","ordinal":56435,"en":"Not merely for us three here,"},{"id":"manas-2010:p1302:b001:l022","ordinal":56436,"en":"But for the multitude of Muslim people,"},{"id":"manas-2010:p1302:b001:l023","ordinal":56437,"en":"He was the Muslims' fortress."},{"id":"manas-2010:p1302:b001:l024","ordinal":56438,"en":"Not just this present land of Beijing,"},{"id":"manas-2010:p1302:b001:l025","ordinal":56439,"en":"Not just the Chinese people,"},{"id":"manas-2010:p1302:b001:l026","ordinal":56440,"en":"Against a fortified, secure place,"},{"id":"manas-2010:p1302:b001:l027","ordinal":56441,"en":"My Syrgak was a gift."},{"id":"manas-2010:p1302:b001:l028","ordinal":56442,"en":"For a poor soul fallen into trouble,"},{"id":"manas-2010:p1302:b001:l029","ordinal":56443,"en":"My Syrgak was needed!”"},{"id":"manas-2010:p1302:b001:l030","ordinal":56444,"en":"Heroes Almambet and Chubak wept."},{"id":"manas-2010:p1302:b001:l031","ordinal":56445,"en":"Leaning on the gray short musket,"},{"id":"manas-2010:p1302:b001:l032","ordinal":56446,"en":"Khan Manas, scarcely able to stand,"},{"id":"manas-2010:p1302:b001:l033","ordinal":56447,"en":"Also stood wailing and weeping."},{"id":"manas-2010:p1302:b001:l034","ordinal":56448,"en":"When he came close to the three,"},{"id":"manas-2010:p1302:b001:l035","ordinal":56449,"en":"These were Syrgak's words:"},{"id":"manas-2010:p1302:b001:l036","ordinal":56450,"en":"“I was your hope; give it up!"},{"id":"manas-2010:p1302:b001:l037","ordinal":56451,"en":"My cherished ones, three lions,"},{"id":"manas-2010:p1302:b001:l038","ordinal":56452,"en":"Sever your hopes of me!"},{"id":"manas-2010:p1302:b001:l039","ordinal":56453,"en":"A battle-axe struck my temple."},{"id":"manas-2010:p1302:b001:l040","ordinal":56454,"en":"If I do not die, let me make my way"},{"id":"manas-2010:p1302:b001:l041","ordinal":56455,"en":"Into distant Mecca!"},{"id":"manas-2010:p1302:b001:l042","ordinal":56456,"en":"Cotton belt and broad boots—"},{"id":"manas-2010:p1303:b001:l001","ordinal":56457,"en":"Kongurbay, khan of the Kalmyks—"},{"id":"manas-2010:p1303:b001:l002","ordinal":56458,"en":"I showed my childishness."},{"id":"manas-2010:p1303:b001:l003","ordinal":56459,"en":"Not keeping watch upon that pig,"},{"id":"manas-2010:p1303:b001:l004","ordinal":56460,"en":"I let his axe strike my head!"},{"id":"manas-2010:p1303:b001:l005","ordinal":56461,"en":"The battle-axe struck my forehead."},{"id":"manas-2010:p1303:b001:l006","ordinal":56462,"en":"May you live safely, my lions."},{"id":"manas-2010:p1303:b001:l007","ordinal":56463,"en":"Without returning to the people on the way,"},{"id":"manas-2010:p1303:b001:l008","ordinal":56464,"en":"Without even turning toward broad Talas,"},{"id":"manas-2010:p1303:b001:l009","ordinal":56465,"en":"I shall go alone to Mecca."},{"id":"manas-2010:p1303:b001:l010","ordinal":56466,"en":"Dark blood streamed from my forehead;"},{"id":"manas-2010:p1303:b001:l011","ordinal":56467,"en":"Strength left my wretched life."},{"id":"manas-2010:p1303:b001:l012","ordinal":56468,"en":"My whole outside became fire,"},{"id":"manas-2010:p1303:b001:l013","ordinal":56469,"en":"My inside filled with burning coals."},{"id":"manas-2010:p1303:b001:l014","ordinal":56470,"en":"I have no strength to move,"},{"id":"manas-2010:p1303:b001:l015","ordinal":56471,"en":"No power to turn my head."},{"id":"manas-2010:p1303:b001:l016","ordinal":56472,"en":"My spear fell from my hand;"},{"id":"manas-2010:p1303:b001:l017","ordinal":56473,"en":"The stirrup slipped from my foot."},{"id":"manas-2010:p1303:b001:l018","ordinal":56474,"en":"At times I can speak,"},{"id":"manas-2010:p1303:b001:l019","ordinal":56475,"en":"At times I cannot gather my senses."},{"id":"manas-2010:p1303:b001:l020","ordinal":56476,"en":"Breaking your wing,"},{"id":"manas-2010:p1303:b001:l021","ordinal":56477,"en":"Putting my wretched life to rest,"},{"id":"manas-2010:p1303:b001:l022","ordinal":56478,"en":"I flee away—do you see?”"},{"id":"manas-2010:p1303:b001:l023","ordinal":56479,"en":"After he had said this,"},{"id":"manas-2010:p1303:b001:l024","ordinal":56480,"en":"Great Manas upon the summit"},{"id":"manas-2010:p1303:b001:l025","ordinal":56481,"en":"Utterly despaired of life."},{"id":"manas-2010:p1303:b001:l026","ordinal":56482,"en":"“Struck from the vulnerable flank,"},{"id":"manas-2010:p1303:b001:l027","ordinal":56483,"en":"“Pressed hard and trapped,"},{"id":"manas-2010:p1303:b001:l028","ordinal":56484,"en":"My champion, the young Syrgak,"},{"id":"manas-2010:p1303:b001:l029","ordinal":56485,"en":"Lost by mishap to the Chinese—"},{"id":"manas-2010:p1303:b001:l030","ordinal":56486,"en":"Is this the time for such a thing?"},{"id":"manas-2010:p1303:b001:l031","ordinal":56487,"en":"Turn your horse’s head awhile."},{"id":"manas-2010:p1303:b001:l032","ordinal":56488,"en":"My darling, bound to my soul,"},{"id":"manas-2010:p1303:b001:l033","ordinal":56489,"en":"Slow down a little!"},{"id":"manas-2010:p1303:b001:l034","ordinal":56490,"en":"If you reach Talas, tell them;"},{"id":"manas-2010:p1303:b001:l035","ordinal":56491,"en":"Tell all my worthy people!"},{"id":"manas-2010:p1303:b001:l036","ordinal":56492,"en":"Say that Manas remains in bonds."},{"id":"manas-2010:p1303:b001:l037","ordinal":56493,"en":"The people of forty khans have risen;"},{"id":"manas-2010:p1303:b001:l038","ordinal":56494,"en":"Say they encircled Manas twelvefold."},{"id":"manas-2010:p1303:b001:l039","ordinal":56495,"en":"Say Aibanboz can no longer move."},{"id":"manas-2010:p1303:b001:l040","ordinal":56496,"en":"Let us arrive at once!"},{"id":"manas-2010:p1303:b001:l041","ordinal":56497,"en":"Unless you rescue him,"},{"id":"manas-2010:p1303:b001:l042","ordinal":56498,"en":"They will seize Manas,"},{"id":"manas-2010:p1304:b001:l001","ordinal":56499,"en":"Forcing him into their religion;"},{"id":"manas-2010:p1304:b001:l002","ordinal":56500,"en":"The forty wanton women of Beijing,"},{"id":"manas-2010:p1304:b001:l003","ordinal":56501,"en":"Say, took him away and kept him as a stud."},{"id":"manas-2010:p1304:b001:l004","ordinal":56502,"en":"Tell my khan like Muzburchak;"},{"id":"manas-2010:p1304:b001:l005","ordinal":56503,"en":"Tell all twelve khans along the road!"},{"id":"manas-2010:p1304:b001:l006","ordinal":56504,"en":"Tell the champions Koshoy and Toshtuk,"},{"id":"manas-2010:p1304:b001:l007","ordinal":56505,"en":"The warrior Urbu of Eibit Khan,"},{"id":"manas-2010:p1304:b001:l008","ordinal":56506,"en":"Zhamgyrchy of the Eshteks."},{"id":"manas-2010:p1304:b001:l009","ordinal":56507,"en":"I shall say it briefly, my Syrgak:"},{"id":"manas-2010:p1304:b001:l010","ordinal":56508,"en":"Tell Ajybai and my khan Bakai,"},{"id":"manas-2010:p1304:b001:l011","ordinal":56509,"en":"Tell all the peoples of the world,"},{"id":"manas-2010:p1304:b001:l012","ordinal":56510,"en":"Tell the khans who can devise a plan,"},{"id":"manas-2010:p1304:b001:l013","ordinal":56511,"en":"Who thrust their spears without wavering,"},{"id":"manas-2010:p1304:b001:l014","ordinal":56512,"en":"Tell all the resolute men,"},{"id":"manas-2010:p1304:b001:l015","ordinal":56513,"en":"Tell those skilled in swinging swords!"},{"id":"manas-2010:p1304:b001:l016","ordinal":56514,"en":"The forty were warriors from forty places;"},{"id":"manas-2010:p1304:b001:l017","ordinal":56515,"en":"Old Kyrgyl and the slave Shuutu—"},{"id":"manas-2010:p1304:b001:l018","ordinal":56516,"en":"Tell such fine men as these!"},{"id":"manas-2010:p1304:b001:l019","ordinal":56517,"en":"I have not slaughtered the unbelievers;"},{"id":"manas-2010:p1304:b001:l020","ordinal":56518,"en":"Aibanboz beneath me will not move."},{"id":"manas-2010:p1304:b001:l021","ordinal":56519,"en":"Go tell my sorrow, Syrgak!"},{"id":"manas-2010:p1304:b001:l022","ordinal":56520,"en":"What is seen today is gone tomorrow:"},{"id":"manas-2010:p1304:b001:l023","ordinal":56521,"en":"Such is this shitty world!”"},{"id":"manas-2010:p1304:b001:l024","ordinal":56522,"en":"Saying this, he wept aloud,"},{"id":"manas-2010:p1304:b001:l025","ordinal":56523,"en":"That precious lion, born exceptional,"},{"id":"manas-2010:p1304:b001:l026","ordinal":56524,"en":"Parted from his Syrgak,"},{"id":"manas-2010:p1304:b001:l027","ordinal":56525,"en":"Deprived of his wing."},{"id":"manas-2010:p1304:b001:l028","ordinal":56526,"en":"Black night fell over him,"},{"id":"manas-2010:p1304:b001:l029","ordinal":56527,"en":"Who had never gone on foot,"},{"id":"manas-2010:p1304:b001:l030","ordinal":56528,"en":"Never lost his presence of mind,"},{"id":"manas-2010:p1304:b001:l031","ordinal":56529,"en":"And when dense enemy hosts poured in,"},{"id":"manas-2010:p1304:b001:l032","ordinal":56530,"en":"Had never drawn back."},{"id":"manas-2010:p1304:b001:l033","ordinal":56531,"en":"Before Syrgak, closing his mouth,"},{"id":"manas-2010:p1304:b001:l034","ordinal":56532,"en":"Had passed across the ridge,"},{"id":"manas-2010:p1304:b001:l035","ordinal":56533,"en":"Dust flew without ceasing."},{"id":"manas-2010:p1304:b001:l036","ordinal":56534,"en":"Not mourning how many had died,"},{"id":"manas-2010:p1304:b001:l037","ordinal":56535,"en":"With earth trembling and mountains falling,"},{"id":"manas-2010:p1304:b001:l038","ordinal":56536,"en":"That accomplished khan Kongurbay,"},{"id":"manas-2010:p1304:b001:l039","ordinal":56537,"en":"The Chinese emperor came up."},{"id":"manas-2010:p1304:b001:l040","ordinal":56538,"en":"The Chinese surged, racing each other;"},{"id":"manas-2010:p1304:b001:l041","ordinal":56539,"en":"The dense people of forty khans"},{"id":"manas-2010:p1304:b001:l042","ordinal":56540,"en":"Came sweeping over them."},{"id":"manas-2010:p1305:b001:l001","ordinal":56541,"en":"Struggling for their lives,"},{"id":"manas-2010:p1305:b001:l002","ordinal":56542,"en":"Almambet and Chubak, the two lions,"},{"id":"manas-2010:p1305:b001:l003","ordinal":56543,"en":"Now held the mountain slope."},{"id":"manas-2010:p1305:b001:l004","ordinal":56544,"en":"The Chinese swarmed and shouted,"},{"id":"manas-2010:p1305:b001:l005","ordinal":56545,"en":"Pressing hard upon Manas."},{"id":"manas-2010:p1305:b001:l006","ordinal":56546,"en":"Tal-Choku, where he stood,"},{"id":"manas-2010:p1305:b001:l007","ordinal":56547,"en":"They encircled forty-twofold."},{"id":"manas-2010:p1305:b001:l008","ordinal":56548,"en":"News reached Beijing;"},{"id":"manas-2010:p1305:b001:l009","ordinal":56549,"en":"Karykan himself"},{"id":"manas-2010:p1305:b001:l010","ordinal":56550,"en":"Sent swift foot soldiers charging,"},{"id":"manas-2010:p1305:b001:l011","ordinal":56551,"en":"And supplied his vast host."},{"id":"manas-2010:p1305:b001:l012","ordinal":56552,"en":"At that time, the many Chinese"},{"id":"manas-2010:p1305:b001:l013","ordinal":56553,"en":"Could find no plan at all."},{"id":"manas-2010:p1305:b001:l014","ordinal":56554,"en":"Alooko’s Kongurbay—"},{"id":"manas-2010:p1305:b001:l015","ordinal":56555,"en":"That boar who knew the enemy’s stratagems!—"},{"id":"manas-2010:p1305:b001:l016","ordinal":56556,"en":"Trotted to and fro."},{"id":"manas-2010:p1305:b001:l017","ordinal":56557,"en":"Thinking out a plan and framing his words,"},{"id":"manas-2010:p1305:b001:l018","ordinal":56558,"en":"He arrived at this device:"},{"id":"manas-2010:p1305:b001:l019","ordinal":56559,"en":"Into every warrior’s hand"},{"id":"manas-2010:p1305:b001:l020","ordinal":56560,"en":"He gave a single brick."},{"id":"manas-2010:p1305:b001:l021","ordinal":56561,"en":"“Let the wall be forty cubits high,"},{"id":"manas-2010:p1305:b001:l022","ordinal":56562,"en":"Let the ditch be forty cubits deep."},{"id":"manas-2010:p1305:b001:l023","ordinal":56563,"en":"Build a fortress all around!"},{"id":"manas-2010:p1305:b001:l024","ordinal":56564,"en":"If God grants us Manas,"},{"id":"manas-2010:p1305:b001:l025","ordinal":56565,"en":"Take him alive."},{"id":"manas-2010:p1305:b001:l026","ordinal":56566,"en":"Upon the Kyrgyz who attacked us first,"},{"id":"manas-2010:p1305:b001:l027","ordinal":56567,"en":"If Manas falls into your hands,"},{"id":"manas-2010:p1305:b001:l028","ordinal":56568,"en":"Inflict a mighty slaughter!"},{"id":"manas-2010:p1305:b001:l029","ordinal":56569,"en":"Mecca is what they rely upon;"},{"id":"manas-2010:p1305:b001:l030","ordinal":56570,"en":"Drive them all the way there."},{"id":"manas-2010:p1305:b001:l031","ordinal":56571,"en":"Bear down upon their heads:"},{"id":"manas-2010:p1305:b001:l032","ordinal":56572,"en":"Prince Almambet and his Chubak."},{"id":"manas-2010:p1305:b001:l033","ordinal":56573,"en":"I have killed his Syrgak."},{"id":"manas-2010:p1305:b001:l034","ordinal":56574,"en":"Leave his Manas alive;"},{"id":"manas-2010:p1305:b001:l035","ordinal":56575,"en":"If Almambet falls into your hands,"},{"id":"manas-2010:p1305:b001:l036","ordinal":56576,"en":"And fearless Chubak,"}]
