[{"id":"semetey-1-2013:p1233:b003:l034","ordinal":170241,"en":"Beijing where no prophet had gone;"},{"id":"semetey-1-2013:p1233:b003:l035","ordinal":170242,"en":"Mighty Manas raided"},{"id":"semetey-1-2013:p1233:b003:l036","ordinal":170243,"en":"Beijing no holy man had raided."},{"id":"semetey-1-2013:p1233:b003:l037","ordinal":170244,"en":"Can one who challenges"},{"id":"semetey-1-2013:p1233:b003:l038","ordinal":170245,"en":"Bloodletter lion Manas survive?"},{"id":"semetey-1-2013:p1233:b003:l039","ordinal":170246,"en":"Toltoy, knowing his renown,"},{"id":"semetey-1-2013:p1233:b005:l001","ordinal":170247,"en":"Lost the strength in his arms"},{"id":"semetey-1-2013:p1233:b005:l002","ordinal":170248,"en":"And the courage in his heart."},{"id":"semetey-1-2013:p1233:b005:l003","ordinal":170249,"en":"Gray-maned Khan Toltoy's"},{"id":"semetey-1-2013:p1233:b005:l004","ordinal":170250,"en":"Chest began to tremble,"},{"id":"semetey-1-2013:p1233:b005:l005","ordinal":170251,"en":"And his beard bristled hair by hair."},{"id":"semetey-1-2013:p1233:b005:l006","ordinal":170252,"en":"Kulchoro was coming,"},{"id":"semetey-1-2013:p1233:b005:l007","ordinal":170253,"en":"Calling the battle cry \"Manas,\""},{"id":"semetey-1-2013:p1233:b005:l008","ordinal":170254,"en":"Like a hungry lion and tiger."},{"id":"semetey-1-2013:p1233:b005:l009","ordinal":170255,"en":"Toltoy stood bewildered;"},{"id":"semetey-1-2013:p1233:b005:l010","ordinal":170256,"en":"If they fought, he would not survive."},{"id":"semetey-1-2013:p1233:b005:l011","ordinal":170257,"en":"Khan Toltoy, who came to take a wife,"},{"id":"semetey-1-2013:p1233:b005:l012","ordinal":170258,"en":"Stretched the drum in his hand,"},{"id":"semetey-1-2013:p1233:b005:l013","ordinal":170259,"en":"Struck the drum once,"},{"id":"semetey-1-2013:p1233:b005:l014","ordinal":170260,"en":"And struck Surkoen once."},{"id":"semetey-1-2013:p1233:b005:l015","ordinal":170261,"en":"Hero Toltoy took to the road,"},{"id":"semetey-1-2013:p1233:b005:l016","ordinal":170262,"en":"Charging toward the Jediger,"},{"id":"semetey-1-2013:p1233:b005:l017","ordinal":170263,"en":"As though he would reach them."},{"id":"semetey-1-2013:p1233:b005:l018","ordinal":170264,"en":"He lashed Surkoen beneath him"},{"id":"semetey-1-2013:p1233:b005:l019","ordinal":170265,"en":"From side to side,"},{"id":"semetey-1-2013:p1233:b005:l020","ordinal":170266,"en":"Spurred both ways,"},{"id":"semetey-1-2013:p1233:b005:l021","ordinal":170267,"en":"He made extreme haste,"},{"id":"semetey-1-2013:p1233:b005:l022","ordinal":170268,"en":"And fled far away."},{"id":"semetey-1-2013:p1233:b005:l023","ordinal":170269,"en":"Surkoen flew like an arrow,"},{"id":"semetey-1-2013:p1233:b005:l024","ordinal":170270,"en":"The racehorse beneath him."},{"id":"semetey-1-2013:p1233:b005:l025","ordinal":170271,"en":"He would not have taken Churok;"},{"id":"semetey-1-2013:p1233:b005:l026","ordinal":170272,"en":"This was the commotion"},{"id":"semetey-1-2013:p1233:b005:l027","ordinal":170273,"en":"Chynkojo had pressed him into."},{"id":"semetey-1-2013:p1233:b005:l028","ordinal":170274,"en":"When Toltoy returned to his people,"},{"id":"semetey-1-2013:p1233:b005:l029","ordinal":170275,"en":"When he turned and fled,"},{"id":"semetey-1-2013:p1233:b005:l030","ordinal":170276,"en":"The ground split in shimmering haze,"},{"id":"semetey-1-2013:p1233:b005:l031","ordinal":170277,"en":"And dust billowed behind."},{"id":"semetey-1-2013:p1233:b005:l032","ordinal":170278,"en":"Hero Toltoy's Surkoen"},{"id":"semetey-1-2013:p1233:b005:l033","ordinal":170279,"en":"Came flying through the mirage."},{"id":"semetey-1-2013:p1233:b005:l034","ordinal":170280,"en":"When he reached a descent,"},{"id":"semetey-1-2013:p1233:b005:l035","ordinal":170281,"en":"Hero Toltoy's Surkoen"},{"id":"semetey-1-2013:p1233:b005:l036","ordinal":170282,"en":"Thrust his forelegs like a roe deer's;"},{"id":"semetey-1-2013:p1233:b005:l037","ordinal":170283,"en":"When he leaned into an ascent,"},{"id":"semetey-1-2013:p1233:b005:l038","ordinal":170284,"en":"Peerless racehorse Surkoen's"},{"id":"semetey-1-2013:p1233:b005:l039","ordinal":170285,"en":"Mane and tail streamed out."},{"id":"semetey-1-2013:p1234:b003:l001","ordinal":170286,"en":"His hooves thundered on the earth,"},{"id":"semetey-1-2013:p1234:b003:l002","ordinal":170287,"en":"And the black-steel bit"},{"id":"semetey-1-2013:p1234:b003:l003","ordinal":170288,"en":"Clattered in his throat."},{"id":"semetey-1-2013:p1234:b003:l004","ordinal":170289,"en":"When he ran he shrieked;"},{"id":"semetey-1-2013:p1234:b003:l005","ordinal":170290,"en":"Stones beneath his hooves"},{"id":"semetey-1-2013:p1234:b003:l006","ordinal":170291,"en":"Scattered like millet."},{"id":"semetey-1-2013:p1234:b003:l007","ordinal":170292,"en":"When visible, he appeared;"},{"id":"semetey-1-2013:p1234:b003:l008","ordinal":170293,"en":"When Surkoen was unseen,"},{"id":"semetey-1-2013:p1234:b003:l009","ordinal":170294,"en":"He became a bank of blue smoke."},{"id":"semetey-1-2013:p1234:b003:l010","ordinal":170295,"en":"The earth split in a rushing wake;"},{"id":"semetey-1-2013:p1234:b003:l011","ordinal":170296,"en":"Then the Jediger man"},{"id":"semetey-1-2013:p1234:b003:l012","ordinal":170297,"en":"Fled back toward his people."},{"id":"semetey-1-2013:p1234:b003:l013","ordinal":170298,"en":"Almambet's Kulchoro"},{"id":"semetey-1-2013:p1234:b003:l014","ordinal":170299,"en":"Grieved in distress:"},{"id":"semetey-1-2013:p1234:b003:l015","ordinal":170300,"en":"\"By not drawing close at the end,"},{"id":"semetey-1-2013:p1234:b003:l016","ordinal":170301,"en":"I have acted foolishly."},{"id":"semetey-1-2013:p1234:b003:l017","ordinal":170302,"en":"By pursuing Toltoy from afar,"},{"id":"semetey-1-2013:p1234:b003:l018","ordinal":170303,"en":"I have acted like a child."},{"id":"semetey-1-2013:p1234:b003:l019","ordinal":170304,"en":"Will he escape beyond my reach"},{"id":"semetey-1-2013:p1234:b003:l020","ordinal":170305,"en":"And reach his people now?"},{"id":"semetey-1-2013:p1234:b003:l021","ordinal":170306,"en":"Failing to catch him like this,"},{"id":"semetey-1-2013:p1234:b003:l022","ordinal":170307,"en":"Will God take the Roan from me?"},{"id":"semetey-1-2013:p1234:b003:l023","ordinal":170308,"en":"My uncle deliberately sent"},{"id":"semetey-1-2013:p1234:b003:l024","ordinal":170309,"en":"Me, young Kulchoro."},{"id":"semetey-1-2013:p1234:b003:l025","ordinal":170310,"en":"Hero Toltoy was mountain-like,"},{"id":"semetey-1-2013:p1234:b003:l026","ordinal":170311,"en":"Yet he fled bobbing away."},{"id":"semetey-1-2013:p1234:b003:l027","ordinal":170312,"en":"God has struck down"},{"id":"semetey-1-2013:p1234:b003:l028","ordinal":170313,"en":"The calamity who came to take a wife,"},{"id":"semetey-1-2013:p1234:b003:l029","ordinal":170314,"en":"The infidel of perfect courage.\""},{"id":"semetey-1-2013:p1234:b003:l030","ordinal":170315,"en":"Hero Toltoy looked behind"},{"id":"semetey-1-2013:p1234:b003:l031","ordinal":170316,"en":"As he fled."},{"id":"semetey-1-2013:p1234:b003:l032","ordinal":170317,"en":"Kulchoro seized the black-jawed whip,"},{"id":"semetey-1-2013:p1234:b003:l033","ordinal":170318,"en":"Swung it around,"},{"id":"semetey-1-2013:p1234:b003:l034","ordinal":170319,"en":"And lashed the doomed Roan"},{"id":"semetey-1-2013:p1234:b003:l035","ordinal":170320,"en":"Across the belly,"},{"id":"semetey-1-2013:p1234:b003:l036","ordinal":170321,"en":"Pursuing him."},{"id":"semetey-1-2013:p1234:b003:l037","ordinal":170322,"en":"Straining as though unable to catch him,"},{"id":"semetey-1-2013:p1234:b003:l038","ordinal":170323,"en":"Kulchoro came then,"},{"id":"semetey-1-2013:p1234:b003:l039","ordinal":170324,"en":"Quarreling with Taybuurul."},{"id":"semetey-1-2013:p1234:b004:l001","ordinal":170325,"en":"\"You were a racehorse, damn you!"},{"id":"semetey-1-2013:p1234:b004:l002","ordinal":170326,"en":"Roan, what has happened to you?"},{"id":"semetey-1-2013:p1234:b004:l003","ordinal":170327,"en":"Will Toltoy truly get away,"},{"id":"semetey-1-2013:p1234:b004:l004","ordinal":170328,"en":"Fleeing beyond my reach?\""},{"id":"semetey-1-2013:p1234:b004:l005","ordinal":170329,"en":"The mountain-like Taybuurul"},{"id":"semetey-1-2013:p1234:b004:l006","ordinal":170330,"en":"Had failed to catch him at a run."},{"id":"semetey-1-2013:p1234:b004:l007","ordinal":170331,"en":"Aychurok, daughter of Akun,"},{"id":"semetey-1-2013:p1234:b004:l008","ordinal":170332,"en":"Had pampered and fed him,"},{"id":"semetey-1-2013:p1234:b004:l009","ordinal":170333,"en":"And he had grown too fat."},{"id":"semetey-1-2013:p1234:b004:l010","ordinal":170334,"en":"Unable to lower his head,"},{"id":"semetey-1-2013:p1234:b004:l011","ordinal":170335,"en":"Unable to stride like an argali,"},{"id":"semetey-1-2013:p1234:b004:l012","ordinal":170336,"en":"The doomed beast"},{"id":"semetey-1-2013:p1234:b004:l013","ordinal":170337,"en":"Was covered in foaming sweat."},{"id":"semetey-1-2013:p1234:b004:l014","ordinal":170338,"en":"Clean sweat broke out and restored him;"},{"id":"semetey-1-2013:p1234:b004:l015","ordinal":170339,"en":"He bent his neck like a stag."},{"id":"semetey-1-2013:p1234:b004:l016","ordinal":170340,"en":"When a ravine a spear's length wide appeared,"},{"id":"semetey-1-2013:p1234:b004:l017","ordinal":170341,"en":"He leapt without hesitation."},{"id":"semetey-1-2013:p1234:b004:l018","ordinal":170342,"en":"His mind was truly a tulpar's;"},{"id":"semetey-1-2013:p1234:b004:l019","ordinal":170343,"en":"Was he not a mountain-like tulpar?"},{"id":"semetey-1-2013:p1234:b004:l020","ordinal":170344,"en":"The wind could not match his gallop;"},{"id":"semetey-1-2013:p1234:b004:l021","ordinal":170345,"en":"The wind-spirit beast"},{"id":"semetey-1-2013:p1234:b004:l022","ordinal":170346,"en":"Lowered his head to the earth"},{"id":"semetey-1-2013:p1234:b004:l023","ordinal":170347,"en":"And took an argali's stride."},{"id":"semetey-1-2013:p1234:b004:l024","ordinal":170348,"en":"The wind could not match his gallop;"},{"id":"semetey-1-2013:p1234:b004:l025","ordinal":170349,"en":"He ran with perfect speed."},{"id":"semetey-1-2013:p1234:b004:l026","ordinal":170350,"en":"No livestock could match his pace;"},{"id":"semetey-1-2013:p1234:b004:l027","ordinal":170351,"en":"He ran in an extraordinary way."},{"id":"semetey-1-2013:p1234:b004:l028","ordinal":170352,"en":"Shimmering like a spirit,"},{"id":"semetey-1-2013:p1234:b004:l029","ordinal":170353,"en":"The doomed Taybuurul"},{"id":"semetey-1-2013:p1234:b004:l030","ordinal":170354,"en":"Drew close enough"},{"id":"semetey-1-2013:p1234:b004:l031","ordinal":170355,"en":"To catch Toltoy of the Jediger."},{"id":"semetey-1-2013:p1234:b004:l032","ordinal":170356,"en":"From the feather-grass ridge,"},{"id":"semetey-1-2013:p1234:b004:l033","ordinal":170357,"en":"From the high-shouldered rise,"},{"id":"semetey-1-2013:p1234:b004:l034","ordinal":170358,"en":"He rode alongside."},{"id":"semetey-1-2013:p1234:b004:l035","ordinal":170359,"en":"Clever Kulchoro"},{"id":"semetey-1-2013:p1234:b004:l036","ordinal":170360,"en":"Was deceiving Toltoy of the Jediger"},{"id":"semetey-1-2013:p1234:b004:l037","ordinal":170361,"en":"As they went."},{"id":"semetey-1-2013:p1234:b004:l038","ordinal":170362,"en":"\"Bridegroom Toltoy, wait!"},{"id":"semetey-1-2013:p1234:b004:l039","ordinal":170363,"en":"Turn your horse's head!\""},{"id":"semetey-1-2013:p1235:b003:l001","ordinal":170364,"en":"These were my elder sister's words:"},{"id":"semetey-1-2013:p1235:b003:l002","ordinal":170365,"en":"\"Go out and meet"},{"id":"semetey-1-2013:p1235:b003:l003","ordinal":170366,"en":"Your valiant brother-in-law Toltoy.\""},{"id":"semetey-1-2013:p1235:b003:l004","ordinal":170367,"en":"Do not swagger away, poor man;"},{"id":"semetey-1-2013:p1235:b003:l005","ordinal":170368,"en":"Stand there where you are!"},{"id":"semetey-1-2013:p1235:b003:l006","ordinal":170369,"en":"You have come as a bridegroom—"},{"id":"semetey-1-2013:p1235:b003:l007","ordinal":170370,"en":"Is a bridegroom like you?"},{"id":"semetey-1-2013:p1235:b003:l008","ordinal":170371,"en":"Does a bridegroom cross"},{"id":"semetey-1-2013:p1235:b003:l009","ordinal":170372,"en":"A saddle-backed ridge?"},{"id":"semetey-1-2013:p1235:b003:l010","ordinal":170373,"en":"Does one come courting"},{"id":"semetey-1-2013:p1235:b003:l011","ordinal":170374,"en":"And then flee again?"},{"id":"semetey-1-2013:p1235:b003:l012","ordinal":170375,"en":"Can a bridegroom who runs away"},{"id":"semetey-1-2013:p1235:b003:l013","ordinal":170376,"en":"Be called a proper bridegroom?"},{"id":"semetey-1-2013:p1235:b003:l014","ordinal":170377,"en":"These were Churok's words:"},{"id":"semetey-1-2013:p1235:b003:l015","ordinal":170378,"en":"\"Go out and meet"},{"id":"semetey-1-2013:p1235:b003:l016","ordinal":170379,"en":"Your mountain-like brother-in-law.\""},{"id":"semetey-1-2013:p1235:b003:l017","ordinal":170380,"en":"Turn your horse's head;"},{"id":"semetey-1-2013:p1235:b003:l018","ordinal":170381,"en":"Noble brother-in-law, wait!"},{"id":"semetey-1-2013:p1235:b003:l019","ordinal":170382,"en":"Thirty brides and thirty girls"},{"id":"semetey-1-2013:p1235:b003:l020","ordinal":170383,"en":"Have begun their games in a stream;"},{"id":"semetey-1-2013:p1235:b003:l021","ordinal":170384,"en":"Among them your wife"},{"id":"semetey-1-2013:p1235:b003:l022","ordinal":170385,"en":"Sways like a fairy."},{"id":"semetey-1-2013:p1235:b003:l023","ordinal":170386,"en":"Appearing like a whole world,"},{"id":"semetey-1-2013:p1235:b003:l024","ordinal":170387,"en":"They came out separately to meet you,"},{"id":"semetey-1-2013:p1235:b003:l025","ordinal":170388,"en":"Saying, \"The gray-maned bridegroom comes.\""},{"id":"semetey-1-2013:p1235:b003:l026","ordinal":170389,"en":"If you play, there are games and laughter;"},{"id":"semetey-1-2013:p1235:b003:l027","ordinal":170390,"en":"There are riches for the entertainment!"},{"id":"semetey-1-2013:p1235:b003:l028","ordinal":170391,"en":"Do not flee the pursuer;"},{"id":"semetey-1-2013:p1235:b003:l029","ordinal":170392,"en":"My dear brother-in-law,"},{"id":"semetey-1-2013:p1235:b003:l030","ordinal":170393,"en":"Swollen with pride before his in-laws,"},{"id":"semetey-1-2013:p1235:b003:l031","ordinal":170394,"en":"Can a bridegroom flee?"},{"id":"semetey-1-2013:p1235:b003:l032","ordinal":170395,"en":"If we flee trembling,"},{"id":"semetey-1-2013:p1235:b003:l033","ordinal":170396,"en":"Can we be called a bridegroom?"},{"id":"semetey-1-2013:p1235:b003:l034","ordinal":170397,"en":"Hey, brother-in-law, wait;"},{"id":"semetey-1-2013:p1235:b003:l035","ordinal":170398,"en":"Turn your horse's head."},{"id":"semetey-1-2013:p1235:b003:l036","ordinal":170399,"en":"Does a man come courting in a swagger"},{"id":"semetey-1-2013:p1235:b003:l037","ordinal":170400,"en":"And then flee?"},{"id":"semetey-1-2013:p1235:b003:l038","ordinal":170401,"en":"Can a bridegroom who loses his wits"},{"id":"semetey-1-2013:p1235:b003:l039","ordinal":170402,"en":"And panics be called a bridegroom?"},{"id":"semetey-1-2013:p1235:b005:l001","ordinal":170403,"en":"As though he had seen his captor,"},{"id":"semetey-1-2013:p1235:b005:l002","ordinal":170404,"en":"Can a bridegroom bolt toward his village"},{"id":"semetey-1-2013:p1235:b005:l003","ordinal":170405,"en":"And flee?"},{"id":"semetey-1-2013:p1235:b005:l004","ordinal":170406,"en":"Kulchoro kept deceiving him."},{"id":"semetey-1-2013:p1235:b005:l005","ordinal":170407,"en":"Would hero Toltoy, who had seen spirits,"},{"id":"semetey-1-2013:p1235:b005:l006","ordinal":170408,"en":"Stop for deception?"},{"id":"semetey-1-2013:p1235:b005:l007","ordinal":170409,"en":"Would he turn his horse's head?"},{"id":"semetey-1-2013:p1235:b005:l008","ordinal":170410,"en":"Would God strike Toltoy"},{"id":"semetey-1-2013:p1235:b005:l009","ordinal":170411,"en":"By making him stop for a boy?"},{"id":"semetey-1-2013:p1235:b005:l010","ordinal":170412,"en":"Unless his head were severed,"},{"id":"semetey-1-2013:p1235:b005:l011","ordinal":170413,"en":"Would your hero Toltoy stop?"},{"id":"semetey-1-2013:p1235:b005:l012","ordinal":170414,"en":"\"His voice has drawn near,\" he said."},{"id":"semetey-1-2013:p1235:b005:l013","ordinal":170415,"en":"Hero Toltoy truly fled,"},{"id":"semetey-1-2013:p1235:b005:l014","ordinal":170416,"en":"Whipping Surkoen;"},{"id":"semetey-1-2013:p1235:b005:l015","ordinal":170417,"en":"Hero Toltoy truly fled."},{"id":"semetey-1-2013:p1235:b005:l016","ordinal":170418,"en":"Dear Toltoy floundered,"},{"id":"semetey-1-2013:p1235:b005:l017","ordinal":170419,"en":"Both coat skirts flapping;"},{"id":"semetey-1-2013:p1235:b005:l018","ordinal":170420,"en":"Hero Toltoy fled clumsily."},{"id":"semetey-1-2013:p1235:b005:l019","ordinal":170421,"en":"After Toltoy fled without stopping,"},{"id":"semetey-1-2013:p1235:b005:l020","ordinal":170422,"en":"Kulchoro spoke the truth,"},{"id":"semetey-1-2013:p1235:b005:l021","ordinal":170423,"en":"Telling every secret"},{"id":"semetey-1-2013:p1235:b005:l022","ordinal":170424,"en":"Within him:"},{"id":"semetey-1-2013:p1235:b005:l023","ordinal":170425,"en":"\"Turn your horse's head;"},{"id":"semetey-1-2013:p1235:b005:l024","ordinal":170426,"en":"Hero Toltoy, wait!"},{"id":"semetey-1-2013:p1235:b005:l025","ordinal":170427,"en":"If you ask who I am,"},{"id":"semetey-1-2013:p1235:b005:l026","ordinal":170428,"en":"I am God's beloved servant,"},{"id":"semetey-1-2013:p1235:b005:l027","ordinal":170429,"en":"A companion of Khan Manas,"},{"id":"semetey-1-2013:p1235:b005:l028","ordinal":170430,"en":"The Chinese Almambet's son."},{"id":"semetey-1-2013:p1235:b005:l029","ordinal":170431,"en":"When he was dead,"},{"id":"semetey-1-2013:p1235:b005:l030","ordinal":170432,"en":"I was a slave in a dog's hide;"},{"id":"semetey-1-2013:p1235:b005:l031","ordinal":170433,"en":"While he lived,"},{"id":"semetey-1-2013:p1235:b005:l032","ordinal":170434,"en":"I was a slave in a sheep's hide."},{"id":"semetey-1-2013:p1235:b005:l033","ordinal":170435,"en":"If you ask my lineage,"},{"id":"semetey-1-2013:p1235:b005:l034","ordinal":170436,"en":"I was Semetey's servant."},{"id":"semetey-1-2013:p1235:b005:l035","ordinal":170437,"en":"Turn back and stand;"},{"id":"semetey-1-2013:p1235:b005:l036","ordinal":170438,"en":"Come unleash a great tumult."},{"id":"semetey-1-2013:p1235:b005:l037","ordinal":170439,"en":"Take my horse and me"},{"id":"semetey-1-2013:p1235:b005:l038","ordinal":170440,"en":"Away as plunder!"},{"id":"semetey-1-2013:p1235:b005:l039","ordinal":170441,"en":"If you are mighty, Toltoy,"},{"id":"semetey-1-2013:p1236:b003:l001","ordinal":170442,"en":"Sate yourself with this one spoil!"},{"id":"semetey-1-2013:p1236:b003:l002","ordinal":170443,"en":"I am a boy of twelve,"},{"id":"semetey-1-2013:p1236:b003:l003","ordinal":170444,"en":"I am a youth lacking wisdom."},{"id":"semetey-1-2013:p1236:b003:l004","ordinal":170445,"en":"If you are a man, Toltoy,"},{"id":"semetey-1-2013:p1236:b003:l005","ordinal":170446,"en":"Turn your stallion's head;"},{"id":"semetey-1-2013:p1236:b003:l006","ordinal":170447,"en":"If you are a hero, hero Toltoy,"},{"id":"semetey-1-2013:p1236:b003:l007","ordinal":170448,"en":"Turn and stand nearby!"},{"id":"semetey-1-2013:p1236:b003:l008","ordinal":170449,"en":"Give us one spectacle;"},{"id":"semetey-1-2013:p1236:b003:l009","ordinal":170450,"en":"Take this twelve-year-old boy"},{"id":"semetey-1-2013:p1236:b003:l010","ordinal":170451,"en":"Away as plunder!"},{"id":"semetey-1-2013:p1236:b003:l011","ordinal":170452,"en":"Does a heroic man flee?"},{"id":"semetey-1-2013:p1236:b003:l012","ordinal":170453,"en":"Does a hero panic and hurry?"},{"id":"semetey-1-2013:p1236:b003:l013","ordinal":170454,"en":"If you are a hero, Toltoy,"},{"id":"semetey-1-2013:p1236:b003:l014","ordinal":170455,"en":"Does a hero flee from a boy?"},{"id":"semetey-1-2013:p1236:b003:l015","ordinal":170456,"en":"Arbuurul beneath me"},{"id":"semetey-1-2013:p1236:b003:l016","ordinal":170457,"en":"Was Semetey's horse."},{"id":"semetey-1-2013:p1236:b003:l017","ordinal":170458,"en":"Do not flee sprawling, hero Toltoy;"},{"id":"semetey-1-2013:p1236:b003:l018","ordinal":170459,"en":"If you take it as plunder, you will be enriched."},{"id":"semetey-1-2013:p1236:b003:l019","ordinal":170460,"en":"You were a hero, hero Toltoy;"},{"id":"semetey-1-2013:p1236:b003:l020","ordinal":170461,"en":"Are you a mare, that you flee?"},{"id":"semetey-1-2013:p1236:b003:l021","ordinal":170462,"en":"If your courage is true,"},{"id":"semetey-1-2013:p1236:b003:l022","ordinal":170463,"en":"Sate yourself with bloody blood;"},{"id":"semetey-1-2013:p1236:b003:l023","ordinal":170464,"en":"Stand without fleeing and fight."},{"id":"semetey-1-2013:p1236:b003:l024","ordinal":170465,"en":"Hold straight and thrust spears,"},{"id":"semetey-1-2013:p1236:b003:l025","ordinal":170466,"en":"Fight until one is finished;"},{"id":"semetey-1-2013:p1236:b003:l026","ordinal":170467,"en":"Joust with spear in hand,"},{"id":"semetey-1-2013:p1236:b003:l027","ordinal":170468,"en":"And if you have the means, take me."},{"id":"semetey-1-2013:p1236:b003:l028","ordinal":170469,"en":"If you are mighty, hero Toltoy,"},{"id":"semetey-1-2013:p1236:b003:l029","ordinal":170470,"en":"Bring calamity upon my head!"},{"id":"semetey-1-2013:p1236:b003:l030","ordinal":170471,"en":"Does a hero spare a boy?"},{"id":"semetey-1-2013:p1236:b003:l031","ordinal":170472,"en":"Is it proper to flee from a boy?\""},{"id":"semetey-1-2013:p1236:b003:l032","ordinal":170473,"en":"When the boy spoke thus,"},{"id":"semetey-1-2013:p1236:b003:l033","ordinal":170474,"en":"Fleeing hero Toltoy"},{"id":"semetey-1-2013:p1236:b003:l034","ordinal":170475,"en":"Stretched the drum,"},{"id":"semetey-1-2013:p1236:b003:l035","ordinal":170476,"en":"Struck Surkoen,"},{"id":"semetey-1-2013:p1236:b003:l036","ordinal":170477,"en":"And leopard Toltoy then"},{"id":"semetey-1-2013:p1236:b003:l037","ordinal":170478,"en":"Whipped from side to side,"},{"id":"semetey-1-2013:p1236:b003:l038","ordinal":170479,"en":"Spurred both ways,"},{"id":"semetey-1-2013:p1236:b003:l039","ordinal":170480,"en":"And fled enormously."},{"id":"semetey-1-2013:p1236:b004:l001","ordinal":170481,"en":"Dear gray-maned Toltoy's"},{"id":"semetey-1-2013:p1236:b004:l002","ordinal":170482,"en":"Eyes darted wildly,"},{"id":"semetey-1-2013:p1236:b004:l003","ordinal":170483,"en":"And his legs dangled loose."},{"id":"semetey-1-2013:p1236:b004:l004","ordinal":170484,"en":"Without turning aside, hero Toltoy"},{"id":"semetey-1-2013:p1236:b004:l005","ordinal":170485,"en":"Fled with a roar."},{"id":"semetey-1-2013:p1236:b004:l006","ordinal":170486,"en":"Without looking around"},{"id":"semetey-1-2013:p1236:b004:l007","ordinal":170487,"en":"Or sparing his own life,"},{"id":"semetey-1-2013:p1236:b004:l008","ordinal":170488,"en":"Kulchoro pursued him."},{"id":"semetey-1-2013:p1236:b004:l009","ordinal":170489,"en":"Black-bay thoroughbred,"},{"id":"semetey-1-2013:p1236:b004:l010","ordinal":170490,"en":"Sieve-lunged and copper-winged,"},{"id":"semetey-1-2013:p1236:b004:l011","ordinal":170491,"en":"Spirit-like Roan horse"},{"id":"semetey-1-2013:p1236:b004:l012","ordinal":170492,"en":"Lowered his head to the earth"},{"id":"semetey-1-2013:p1236:b004:l013","ordinal":170493,"en":"And took an argali's stride."},{"id":"semetey-1-2013:p1236:b004:l014","ordinal":170494,"en":"He lowered his neck to the earth"},{"id":"semetey-1-2013:p1236:b004:l015","ordinal":170495,"en":"And ran beyond all measure."},{"id":"semetey-1-2013:p1236:b004:l016","ordinal":170496,"en":"His eyes reddened like a wild ram's;"}]
