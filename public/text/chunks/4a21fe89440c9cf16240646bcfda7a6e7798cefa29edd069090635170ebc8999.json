[{"id":"manas-2010:p0299:b001:l036","ordinal":13569,"en":"The hair on his head bristling."},{"id":"manas-2010:p0299:b001:l037","ordinal":13570,"en":"He unleashed a terrible fury;"},{"id":"manas-2010:p0299:b001:l038","ordinal":13571,"en":"The troops, Esenkan"},{"id":"manas-2010:p0299:b001:l039","ordinal":13572,"en":"Cut them down outright."},{"id":"manas-2010:p0299:b001:l040","ordinal":13573,"en":"The mighty lord Esenkan's"},{"id":"manas-2010:p0299:b001:l041","ordinal":13574,"en":"Five palaces, built strong,"},{"id":"manas-2010:p0299:b001:l042","ordinal":13575,"en":"Were exceedingly secure."},{"id":"manas-2010:p0299:b001:l043","ordinal":13576,"en":"No mortal dared approach them,"},{"id":"manas-2010:p0299:b001:l044","ordinal":13577,"en":"No man overcame them face to face."},{"id":"manas-2010:p0299:b001:l045","ordinal":13578,"en":"His guards were beyond counting,"},{"id":"manas-2010:p0299:b001:l046","ordinal":13579,"en":"His lookouts were more than those."},{"id":"manas-2010:p0299:b001:l047","ordinal":13580,"en":"He had champions massed together;"},{"id":"manas-2010:p0299:b001:l048","ordinal":13581,"en":"Esenkan was a great lord,"},{"id":"manas-2010:p0300:b001:l001","ordinal":13582,"en":"Prepared from the very first day."},{"id":"manas-2010:p0300:b001:l002","ordinal":13583,"en":"Beyond him were his guards,"},{"id":"manas-2010:p0300:b001:l003","ordinal":13584,"en":"Human noses and ears"},{"id":"manas-2010:p0300:b001:l004","ordinal":13585,"en":"They wore as amulets."},{"id":"manas-2010:p0300:b001:l005","ordinal":13586,"en":"Before one could cry this or that,"},{"id":"manas-2010:p0300:b001:l006","ordinal":13587,"en":"If Esenkan gave an order,"},{"id":"manas-2010:p0300:b001:l007","ordinal":13588,"en":"His many troops swarmed forth."},{"id":"manas-2010:p0300:b001:l008","ordinal":13589,"en":"Esenkan's golden throne,"},{"id":"manas-2010:p0300:b001:l009","ordinal":13590,"en":"Around it was a grove of plane trees."},{"id":"manas-2010:p0300:b001:l010","ordinal":13591,"en":"Outside that throne of his"},{"id":"manas-2010:p0300:b001:l011","ordinal":13592,"en":"There was a ready-dug pit."},{"id":"manas-2010:p0300:b001:l012","ordinal":13593,"en":"If one looked beyond it,"},{"id":"manas-2010:p0300:b001:l013","ordinal":13594,"en":"Trussed and bound,"},{"id":"manas-2010:p0300:b001:l014","ordinal":13595,"en":"There were his giants who slaughtered challengers."},{"id":"manas-2010:p0300:b001:l015","ordinal":13596,"en":"One saw such majesty there;"},{"id":"manas-2010:p0300:b001:l016","ordinal":13597,"en":"To preserve his life, countless troops"},{"id":"manas-2010:p0300:b001:l017","ordinal":13598,"en":"Had gathered, those valiant men."},{"id":"manas-2010:p0300:b001:l018","ordinal":13599,"en":"Ezkara, khan of the Manchus,"},{"id":"manas-2010:p0300:b001:l019","ordinal":13600,"en":"And great Zholoy, khan of the Kalmyks—"},{"id":"manas-2010:p0300:b001:l020","ordinal":13601,"en":"A terrible fury broke forth;"},{"id":"manas-2010:p0300:b001:l021","ordinal":13602,"en":"Esenkan, chief of the people,"},{"id":"manas-2010:p0300:b001:l022","ordinal":13603,"en":"Swallowed them outright."},{"id":"manas-2010:p0300:b001:l023","ordinal":13604,"en":"The elders of the Black Kalmyks,"},{"id":"manas-2010:p0300:b001:l024","ordinal":13605,"en":"All the Sibe and Manchus,"},{"id":"manas-2010:p0300:b001:l025","ordinal":13606,"en":"As if struck by slaughter,"},{"id":"manas-2010:p0300:b001:l026","ordinal":13607,"en":"When Esenkan poured out his wrath,"},{"id":"manas-2010:p0300:b001:l027","ordinal":13608,"en":"They all collapsed."},{"id":"manas-2010:p0300:b001:l028","ordinal":13609,"en":"Whatever he wished with the countless troops,"},{"id":"manas-2010:p0300:b001:l029","ordinal":13610,"en":"He was about to do it."},{"id":"manas-2010:p0300:b001:l030","ordinal":13611,"en":"Without stopping, those countless troops"},{"id":"manas-2010:p0300:b001:l031","ordinal":13612,"en":"He was about to slaughter."},{"id":"manas-2010:p0300:b001:l032","ordinal":13613,"en":"Upon them all together,"},{"id":"manas-2010:p0300:b001:l033","ordinal":13614,"en":"A torment no man had seen"},{"id":"manas-2010:p0300:b001:l034","ordinal":13615,"en":"He was about to inflict."},{"id":"manas-2010:p0300:b001:l035","ordinal":13616,"en":"Ezkara, the khan of the Manchus,"},{"id":"manas-2010:p0300:b001:l036","ordinal":13617,"en":"Parted from his countless troops."},{"id":"manas-2010:p0300:b001:l037","ordinal":13618,"en":"In Esenkan's eyes"},{"id":"manas-2010:p0300:b001:l038","ordinal":13619,"en":"His valor appeared measureless."},{"id":"manas-2010:p0300:b001:l039","ordinal":13620,"en":"Bending his knees to the ground,"},{"id":"manas-2010:p0300:b001:l040","ordinal":13621,"en":"Of so many cities"},{"id":"manas-2010:p0300:b001:l041","ordinal":13622,"en":"Ezkara was the lord;"},{"id":"manas-2010:p0300:b001:l042","ordinal":13623,"en":"When he came right before him,"},{"id":"manas-2010:p0300:b001:l043","ordinal":13624,"en":"He bowed like a young bride."},{"id":"manas-2010:p0300:b001:l044","ordinal":13625,"en":"Ezkara began to speak now,"},{"id":"manas-2010:p0300:b001:l045","ordinal":13626,"en":"Before the khan he said:"},{"id":"manas-2010:p0300:b001:l046","ordinal":13627,"en":"“Brave Esen, my lord!"},{"id":"manas-2010:p0300:b001:l047","ordinal":13628,"en":"Traveling far upon my horse,"},{"id":"manas-2010:p0300:b001:l048","ordinal":13629,"en":"Roaming the face of the earth,"},{"id":"manas-2010:p0301:b001:l001","ordinal":13630,"en":"Scouting and surveying the land,"},{"id":"manas-2010:p0301:b001:l002","ordinal":13631,"en":"For whom is my valor?"},{"id":"manas-2010:p0301:b001:l003","ordinal":13632,"en":"Hero Esenkan, for you!"},{"id":"manas-2010:p0301:b001:l004","ordinal":13633,"en":"When I wear down my horse,"},{"id":"manas-2010:p0301:b001:l005","ordinal":13634,"en":"Through all the world,"},{"id":"manas-2010:p0301:b001:l006","ordinal":13635,"en":"When I wander everywhere,"},{"id":"manas-2010:p0301:b001:l007","ordinal":13636,"en":"When I scatter my livestock,"},{"id":"manas-2010:p0301:b001:l008","ordinal":13637,"en":"When I sacrifice my life,"},{"id":"manas-2010:p0301:b001:l009","ordinal":13638,"en":"Binding a hero and bringing good news,"},{"id":"manas-2010:p0301:b001:l010","ordinal":13639,"en":"When I came before you, you roared;"},{"id":"manas-2010:p0301:b001:l011","ordinal":13640,"en":"You took on the look of a headsman!"},{"id":"manas-2010:p0301:b001:l012","ordinal":13641,"en":"You began many dreadful things;"},{"id":"manas-2010:p0301:b001:l013","ordinal":13642,"en":"If I failed to look back toward you,"},{"id":"manas-2010:p0301:b001:l014","ordinal":13643,"en":"You slaughtered me outright!"},{"id":"manas-2010:p0301:b001:l015","ordinal":13644,"en":"If you are merely a khan, you are worthless;"},{"id":"manas-2010:p0301:b001:l016","ordinal":13645,"en":"If you truly are a khan,"},{"id":"manas-2010:p0301:b001:l017","ordinal":13646,"en":"You will cut off this worthy head!"},{"id":"manas-2010:p0301:b001:l018","ordinal":13647,"en":"My khan, you gave the order;"},{"id":"manas-2010:p0301:b001:l019","ordinal":13648,"en":"I stood by what you said."},{"id":"manas-2010:p0301:b001:l020","ordinal":13649,"en":"Since you yourself gave the order,"},{"id":"manas-2010:p0301:b001:l021","ordinal":13650,"en":"I broke through the crags and took the road,"},{"id":"manas-2010:p0301:b001:l022","ordinal":13651,"en":"I gathered an army from the kakan."},{"id":"manas-2010:p0301:b001:l023","ordinal":13652,"en":"I wore down my horse,"},{"id":"manas-2010:p0301:b001:l024","ordinal":13653,"en":"Through all the world"},{"id":"manas-2010:p0301:b001:l025","ordinal":13654,"en":"I roamed on campaign."},{"id":"manas-2010:p0301:b001:l026","ordinal":13655,"en":"That Ezkara had not ridden across,"},{"id":"manas-2010:p0301:b001:l027","ordinal":13656,"en":"No rolling, rugged ridge remained;"},{"id":"manas-2010:p0301:b001:l028","ordinal":13657,"en":"No people remained whom I had not seen."},{"id":"manas-2010:p0301:b001:l029","ordinal":13658,"en":"Making my tulpar saddle-sore,"},{"id":"manas-2010:p0301:b001:l030","ordinal":13659,"en":"With ever greater hurt at heart,"},{"id":"manas-2010:p0301:b001:l031","ordinal":13660,"en":"From the settlement of the tea-bearing mountain,"},{"id":"manas-2010:p0301:b001:l032","ordinal":13661,"en":"Of Chay-Too, where gold is mined,"},{"id":"manas-2010:p0301:b001:l033","ordinal":13662,"en":"From its farthest ending edge,"},{"id":"manas-2010:p0301:b001:l034","ordinal":13663,"en":"From the spur of a broken mountain,"},{"id":"manas-2010:p0301:b001:l035","ordinal":13664,"en":"From a long-descending promontory,"},{"id":"manas-2010:p0301:b001:l036","ordinal":13665,"en":"With their belts wound as turbans,"},{"id":"manas-2010:p0301:b001:l037","ordinal":13666,"en":"Beseeching the Almighty,"},{"id":"manas-2010:p0301:b001:l038","ordinal":13667,"en":"Driving argali and chasing wild asses,"},{"id":"manas-2010:p0301:b001:l039","ordinal":13668,"en":"A group of men emerged before me."},{"id":"manas-2010:p0301:b001:l040","ordinal":13669,"en":"They had come violating my boundary;"},{"id":"manas-2010:p0301:b001:l041","ordinal":13670,"en":"My own eyes saw their coming."},{"id":"manas-2010:p0301:b001:l042","ordinal":13671,"en":"When I followed the handed-down accounts,"},{"id":"manas-2010:p0301:b001:l043","ordinal":13672,"en":"When I asked their origin and their end,"},{"id":"manas-2010:p0301:b001:l044","ordinal":13673,"en":"It turned out they were Buruts themselves."},{"id":"manas-2010:p0301:b001:l045","ordinal":13674,"en":"Some devilry upon Beijing,"},{"id":"manas-2010:p0301:b001:l046","ordinal":13675,"en":"Those daughter-damned Buruts"},{"id":"manas-2010:p0301:b001:l047","ordinal":13676,"en":"Were on their way to bring it."},{"id":"manas-2010:p0301:b001:l048","ordinal":13677,"en":"Keeping watch and scouting the land,"},{"id":"manas-2010:p0302:b001:l001","ordinal":13678,"en":"They were there as enemies."},{"id":"manas-2010:p0302:b001:l002","ordinal":13679,"en":"Some great torment upon Beijing,"},{"id":"manas-2010:p0302:b001:l003","ordinal":13680,"en":"They were on their way to bring it."},{"id":"manas-2010:p0302:b001:l004","ordinal":13681,"en":"The tümen livestock gathered in dues,"},{"id":"manas-2010:p0302:b001:l005","ordinal":13682,"en":"The treasury's tümen livestock—"},{"id":"manas-2010:p0302:b001:l006","ordinal":13683,"en":"Those Buruts, in their hostility,"},{"id":"manas-2010:p0302:b001:l007","ordinal":13684,"en":"Were on their way to seize them."},{"id":"manas-2010:p0302:b001:l008","ordinal":13685,"en":"Some monstrous deed upon the kakan,"},{"id":"manas-2010:p0302:b001:l009","ordinal":13686,"en":"They were on their way to inflict it!"},{"id":"manas-2010:p0302:b001:l010","ordinal":13687,"en":"They follow the religion of Islam;"},{"id":"manas-2010:p0302:b001:l011","ordinal":13688,"en":"Those flame-cursed Buruts"},{"id":"manas-2010:p0302:b001:l012","ordinal":13689,"en":"Are our enemies to the root."},{"id":"manas-2010:p0302:b001:l013","ordinal":13690,"en":"Watching the patrols, those Buruts"},{"id":"manas-2010:p0302:b001:l014","ordinal":13691,"en":"Were on their way to seize them;"},{"id":"manas-2010:p0302:b001:l015","ordinal":13692,"en":"Turmoil upon the kakan,"},{"id":"manas-2010:p0302:b001:l016","ordinal":13693,"en":"They were on their way to inflict it."},{"id":"manas-2010:p0302:b001:l017","ordinal":13694,"en":"Not an ankle-bone-sized mountain on the land,"},{"id":"manas-2010:p0302:b001:l018","ordinal":13695,"en":"Not a saddlecloth-sized gully,"},{"id":"manas-2010:p0302:b001:l019","ordinal":13696,"en":"At the edge of Chong-Tungsha,"},{"id":"manas-2010:p0302:b001:l020","ordinal":13697,"en":"On the face of Kulan-Talaa,"},{"id":"manas-2010:p0302:b001:l021","ordinal":13698,"en":"Against those maddened Buruts,"},{"id":"manas-2010:p0302:b001:l022","ordinal":13699,"en":"I girded my waist with a jekene belt;"},{"id":"manas-2010:p0302:b001:l023","ordinal":13700,"en":"I went alone into their midst and attacked."},{"id":"manas-2010:p0302:b001:l024","ordinal":13701,"en":"He was madness itself;"},{"id":"manas-2010:p0302:b001:l025","ordinal":13702,"en":"His bulk was equal to a mountain,"},{"id":"manas-2010:p0302:b001:l026","ordinal":13703,"en":"A handful of men"},{"id":"manas-2010:p0302:b001:l027","ordinal":13704,"en":"He could chase, slaughter and devour."},{"id":"manas-2010:p0302:b001:l028","ordinal":13705,"en":"On the yellow plain, smooth as a blade,"},{"id":"manas-2010:p0302:b001:l029","ordinal":13706,"en":"I stood upon this side and that,"},{"id":"manas-2010:p0302:b001:l030","ordinal":13707,"en":"Firing guns and drawing bows,"},{"id":"manas-2010:p0302:b001:l031","ordinal":13708,"en":"I fought forty-one days without a pause."},{"id":"manas-2010:p0302:b001:l032","ordinal":13709,"en":"Riding forth to contest on horseback,"},{"id":"manas-2010:p0302:b001:l033","ordinal":13710,"en":"Raising piercing cries,"},{"id":"manas-2010:p0302:b001:l034","ordinal":13711,"en":"When the spears were shattered,"},{"id":"manas-2010:p0302:b001:l035","ordinal":13712,"en":"We fought with battle-axes."},{"id":"manas-2010:p0302:b001:l036","ordinal":13713,"en":"My own eyes saw his valor:"},{"id":"manas-2010:p0302:b001:l037","ordinal":13714,"en":"For forty-one days he would not yield."},{"id":"manas-2010:p0302:b001:l038","ordinal":13715,"en":"Of the Chinese with rank buttons on their caps,"},{"id":"manas-2010:p0302:b001:l039","ordinal":13716,"en":"Their finest men died."},{"id":"manas-2010:p0302:b001:l040","ordinal":13717,"en":"Contending on horseback,"},{"id":"manas-2010:p0302:b001:l041","ordinal":13718,"en":"Fighting with battle cries,"},{"id":"manas-2010:p0302:b001:l042","ordinal":13719,"en":"Khan Kalday of the Sibe died;"},{"id":"manas-2010:p0302:b001:l043","ordinal":13720,"en":"When we went into the clash,"},{"id":"manas-2010:p0302:b001:l044","ordinal":13721,"en":"The Kalmyk Zhonduk died as well."},{"id":"manas-2010:p0302:b001:l045","ordinal":13722,"en":"Clashing, in grievous turmoil,"},{"id":"manas-2010:p0302:b001:l046","ordinal":13723,"en":"We unleashed a terrible fury."},{"id":"manas-2010:p0302:b001:l047","ordinal":13724,"en":"Sending in the dagger-handed troops,"},{"id":"manas-2010:p0302:b001:l048","ordinal":13725,"en":"Their weak ones without courage,"},{"id":"manas-2010:p0303:b001:l001","ordinal":13726,"en":"We slaughtered to the last."},{"id":"manas-2010:p0303:b001:l002","ordinal":13727,"en":"We laid low their renowned ones;"},{"id":"manas-2010:p0303:b001:l003","ordinal":13728,"en":"‘He will be needed by the khan,’ we said,"},{"id":"manas-2010:p0303:b001:l004","ordinal":13729,"en":"And seized their honored one."},{"id":"manas-2010:p0303:b001:l005","ordinal":13730,"en":"Hear my words precisely;"},{"id":"manas-2010:p0303:b001:l006","ordinal":13731,"en":"Be angry if you wish,"},{"id":"manas-2010:p0303:b001:l007","ordinal":13732,"en":"I have brought him as tribute to you!"},{"id":"manas-2010:p0303:b001:l008","ordinal":13733,"en":"This Burut whom we captured,"},{"id":"manas-2010:p0303:b001:l009","ordinal":13734,"en":"Thick-armed and stone-hearted,"},{"id":"manas-2010:p0303:b001:l010","ordinal":13735,"en":"A prodigious warrior with an elephant's build."},{"id":"manas-2010:p0303:b001:l011","ordinal":13736,"en":"His strength as a champion is great,"},{"id":"manas-2010:p0303:b001:l012","ordinal":13737,"en":"His bravery is unlike others'."},{"id":"manas-2010:p0303:b001:l013","ordinal":13738,"en":"Wide-mouthed and cliff-browed,"},{"id":"manas-2010:p0303:b001:l014","ordinal":13739,"en":"His majesty surpasses others', his wrath is mighty;"},{"id":"manas-2010:p0303:b001:l015","ordinal":13740,"en":"The men who come to fight him,"},{"id":"manas-2010:p0303:b001:l016","ordinal":13741,"en":"He slaughters, butchers and levels flat!"},{"id":"manas-2010:p0303:b001:l017","ordinal":13742,"en":"His chest is like a hungry lion's;"},{"id":"manas-2010:p0303:b001:l018","ordinal":13743,"en":"This flame-cursed Burut"},{"id":"manas-2010:p0303:b001:l019","ordinal":13744,"en":"Has eyes like a hunting eagle's."},{"id":"manas-2010:p0303:b001:l020","ordinal":13745,"en":"That life-cursed Burut"},{"id":"manas-2010:p0303:b001:l021","ordinal":13746,"en":"Has a head like a great cauldron,"},{"id":"manas-2010:p0303:b001:l022","ordinal":13747,"en":"Brows like a dog lying down,"},{"id":"manas-2010:p0303:b001:l023","ordinal":13748,"en":"Eyes deep as storage pits."},{"id":"manas-2010:p0303:b001:l024","ordinal":13749,"en":"Never turning back from death,"},{"id":"manas-2010:p0303:b001:l025","ordinal":13750,"en":"He speaks roughly and wildly."},{"id":"manas-2010:p0303:b001:l026","ordinal":13751,"en":"Thinking wisely, governing a people,"},{"id":"manas-2010:p0303:b001:l027","ordinal":13752,"en":"He shows the bearing of a commander."},{"id":"manas-2010:p0303:b001:l028","ordinal":13753,"en":"Leading countless troops alone,"},{"id":"manas-2010:p0303:b001:l029","ordinal":13754,"en":"He shows the look of a champion."},{"id":"manas-2010:p0303:b001:l030","ordinal":13755,"en":"He is no youth without lineage,"},{"id":"manas-2010:p0303:b001:l031","ordinal":13756,"en":"He is no ordinary wandering slave."},{"id":"manas-2010:p0303:b001:l032","ordinal":13757,"en":"He seems the very flame-cursed one"},{"id":"manas-2010:p0303:b001:l033","ordinal":13758,"en":"Who will bring disorder upon Beijing,"},{"id":"manas-2010:p0303:b001:l034","ordinal":13759,"en":"Who will take whatever he attacks;"},{"id":"manas-2010:p0303:b001:l035","ordinal":13760,"en":"He seems that restless slave himself."},{"id":"manas-2010:p0303:b001:l036","ordinal":13761,"en":"He held his spear and wheeled it;"},{"id":"manas-2010:p0303:b001:l037","ordinal":13762,"en":"The Manchus, all champions,"},{"id":"manas-2010:p0303:b001:l038","ordinal":13763,"en":"This flame-cursed Burut"},{"id":"manas-2010:p0303:b001:l039","ordinal":13764,"en":"Slaughtered through and through."},{"id":"manas-2010:p0303:b001:l040","ordinal":13765,"en":"He gripped his sword and swung it;"},{"id":"manas-2010:p0303:b001:l041","ordinal":13766,"en":"That daughter-damned Burut was no good."},{"id":"manas-2010:p0303:b001:l042","ordinal":13767,"en":"He began an extraordinary slaughter;"},{"id":"manas-2010:p0303:b001:l043","ordinal":13768,"en":"All those who challenged him"},{"id":"manas-2010:p0303:b001:l044","ordinal":13769,"en":"He cut down and slaughtered with his sword."},{"id":"manas-2010:p0303:b001:l045","ordinal":13770,"en":"Since I have been Ezkara,"},{"id":"manas-2010:p0303:b001:l046","ordinal":13771,"en":"Since I have borne the name Ezkara,"},{"id":"manas-2010:p0303:b001:l047","ordinal":13772,"en":"I have never seen such a hero,"},{"id":"manas-2010:p0303:b001:l048","ordinal":13773,"en":"I have never heard of such a hero."},{"id":"manas-2010:p0304:b001:l001","ordinal":13774,"en":"He faced them in fives and fours;"},{"id":"manas-2010:p0304:b001:l002","ordinal":13775,"en":"That daughter-damned Burut,"},{"id":"manas-2010:p0304:b001:l003","ordinal":13776,"en":"The side he headed toward was red fire."},{"id":"manas-2010:p0304:b001:l004","ordinal":13777,"en":"As if to strike down whoever challenged him,"},{"id":"manas-2010:p0304:b001:l005","ordinal":13778,"en":"He had the aspect of a boar;"},{"id":"manas-2010:p0304:b001:l006","ordinal":13779,"en":"As if to overcome those who shot at him,"},{"id":"manas-2010:p0304:b001:l007","ordinal":13780,"en":"He had the aspect of a lion."},{"id":"manas-2010:p0304:b001:l008","ordinal":13781,"en":"Dark, mottled Boroonchu,"},{"id":"manas-2010:p0304:b001:l009","ordinal":13782,"en":"We rushed out and fought."},{"id":"manas-2010:p0304:b001:l010","ordinal":13783,"en":"Great Zholoy of the Kalmyks,"},{"id":"manas-2010:p0304:b001:l011","ordinal":13784,"en":"We came out to bar him and fought."},{"id":"manas-2010:p0304:b001:l012","ordinal":13785,"en":"Ezkara on the great brown horse,"},{"id":"manas-2010:p0304:b001:l013","ordinal":13786,"en":"We came out together and fought."},{"id":"manas-2010:p0304:b001:l014","ordinal":13787,"en":"Giant Delping and giant Döödür,"},{"id":"manas-2010:p0304:b001:l015","ordinal":13788,"en":"We stood facing him."},{"id":"manas-2010:p0304:b001:l016","ordinal":13789,"en":"We took him between us and hemmed him in;"},{"id":"manas-2010:p0304:b001:l017","ordinal":13790,"en":"All of us giants,"},{"id":"manas-2010:p0304:b001:l018","ordinal":13791,"en":"We faced Bilerik."},{"id":"manas-2010:p0304:b001:l019","ordinal":13792,"en":"If, using force against the youth,"},{"id":"manas-2010:p0304:b001:l020","ordinal":13793,"en":"We had not managed to seize him,"},{"id":"manas-2010:p0304:b001:l021","ordinal":13794,"en":"Would he leave Beijing whole?"},{"id":"manas-2010:p0304:b001:l022","ordinal":13795,"en":"Would those who challenged him survive?"},{"id":"manas-2010:p0304:b001:l023","ordinal":13796,"en":"A wretched Burut such as this,"},{"id":"manas-2010:p0304:b001:l024","ordinal":13797,"en":"Would he lie idle in his own land?"},{"id":"manas-2010:p0304:b001:l025","ordinal":13798,"en":"If we had not seized him thus,"},{"id":"manas-2010:p0304:b001:l026","ordinal":13799,"en":"Would he leave Beijing unharmed?"},{"id":"manas-2010:p0304:b001:l027","ordinal":13800,"en":"This house-burned Burut"},{"id":"manas-2010:p0304:b001:l028","ordinal":13801,"en":"Was born greater than other men."},{"id":"manas-2010:p0304:b001:l029","ordinal":13802,"en":"Had we not seized him like this,"},{"id":"manas-2010:p0304:b001:l030","ordinal":13803,"en":"He would have brought tumult."},{"id":"manas-2010:p0304:b001:l031","ordinal":13804,"en":"Crushing their mighty ones,"},{"id":"manas-2010:p0304:b001:l032","ordinal":13805,"en":"We entered, unleashing fury;"},{"id":"manas-2010:p0304:b001:l033","ordinal":13806,"en":"Seizing one of them,"},{"id":"manas-2010:p0304:b001:l034","ordinal":13807,"en":"Before your face, my champion,"},{"id":"manas-2010:p0304:b001:l035","ordinal":13808,"en":"We have brought him as tribute!"},{"id":"manas-2010:p0304:b001:l036","ordinal":13809,"en":"Have your judge of men examine him;"},{"id":"manas-2010:p0304:b001:l037","ordinal":13810,"en":"Test him and take him."},{"id":"manas-2010:p0304:b001:l038","ordinal":13811,"en":"If the Burut meets your appraisal,"},{"id":"manas-2010:p0304:b001:l039","ordinal":13812,"en":"Put him in your dungeon!”"},{"id":"manas-2010:p0304:b001:l040","ordinal":13813,"en":"When Ezkara said this,"},{"id":"manas-2010:p0304:b001:l041","ordinal":13814,"en":"Esenkan's great war drum,"},{"id":"manas-2010:p0304:b001:l042","ordinal":13815,"en":"His emblem before the khan,"},{"id":"manas-2010:p0304:b001:l043","ordinal":13816,"en":"Was made from an elephant's hide,"},{"id":"manas-2010:p0304:b001:l044","ordinal":13817,"en":"Stretched and fitted over copper."},{"id":"manas-2010:p0304:b001:l045","ordinal":13818,"en":"At the foot of the golden throne"},{"id":"manas-2010:p0304:b001:l046","ordinal":13819,"en":"He had stationed a guard to keep it."},{"id":"manas-2010:p0304:b001:l047","ordinal":13820,"en":"With a base three armfuls broad,"},{"id":"manas-2010:p0304:b001:l048","ordinal":13821,"en":"Taking a club as big as a house,"},{"id":"manas-2010:p0305:b001:l001","ordinal":13822,"en":"His champion readied himself and struck it."},{"id":"manas-2010:p0305:b001:l002","ordinal":13823,"en":"It thundered beyond hearing,"},{"id":"manas-2010:p0305:b001:l003","ordinal":13824,"en":"It tore the ears to pieces."}]
