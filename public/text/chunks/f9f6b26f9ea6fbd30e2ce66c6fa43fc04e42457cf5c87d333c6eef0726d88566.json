[{"id":"manas-2010:p0240:b001:l044","ordinal":10753,"en":"At the mouth of Suuk-Kapchygay,"},{"id":"manas-2010:p0240:b001:l045","ordinal":10754,"en":"In the upland called Suuk-Tör,"},{"id":"manas-2010:p0240:b001:l046","ordinal":10755,"en":"Among the people called the One-Eyed,"},{"id":"manas-2010:p0240:b001:l047","ordinal":10756,"en":"Among the damned Kytay's"},{"id":"manas-2010:p0240:b001:l048","ordinal":10757,"en":"Many tribes and peoples,"},{"id":"manas-2010:p0241:b001:l001","ordinal":10758,"en":"On the nearer side of that,"},{"id":"manas-2010:p0241:b001:l002","ordinal":10759,"en":"There was a people called Shibe."},{"id":"manas-2010:p0241:b001:l003","ordinal":10760,"en":"Their land was open and deserted."},{"id":"manas-2010:p0241:b001:l004","ordinal":10761,"en":"They lived far apart from other people."},{"id":"manas-2010:p0241:b001:l005","ordinal":10762,"en":"When a woman gave birth, their custom was"},{"id":"manas-2010:p0241:b001:l006","ordinal":10763,"en":"To make a razor from a reed"},{"id":"manas-2010:p0241:b001:l007","ordinal":10764,"en":"And cut the cord as a ritual."},{"id":"manas-2010:p0241:b001:l008","ordinal":10765,"en":"Their descendants were called Shibe."},{"id":"manas-2010:p0241:b001:l009","ordinal":10766,"en":"If a wolf saw one alone,"},{"id":"manas-2010:p0241:b001:l010","ordinal":10767,"en":"It ate him like a sheep out in the distance."},{"id":"manas-2010:p0241:b001:l011","ordinal":10768,"en":"The giant Kaman with scissor ears"},{"id":"manas-2010:p0241:b001:l012","ordinal":10769,"en":"Came from that Shibe people."},{"id":"manas-2010:p0241:b001:l013","ordinal":10770,"en":"Born among the Shibe,"},{"id":"manas-2010:p0241:b001:l014","ordinal":10771,"en":"Kaman the giant became a champion."},{"id":"manas-2010:p0241:b001:l015","ordinal":10772,"en":"When his collarbones had fully grown,"},{"id":"manas-2010:p0241:b001:l016","ordinal":10773,"en":"When he won the name of champion,"},{"id":"manas-2010:p0241:b001:l017","ordinal":10774,"en":"They took him into royal service."},{"id":"manas-2010:p0241:b001:l018","ordinal":10775,"en":"For his feast they slaughtered ninety mules;"},{"id":"manas-2010:p0241:b001:l019","ordinal":10776,"en":"With this he earned the name of great champion."},{"id":"manas-2010:p0241:b001:l020","ordinal":10777,"en":"There in the land of Suuk-Tör,"},{"id":"manas-2010:p0241:b001:l021","ordinal":10778,"en":"Among the One-Eyed people,"},{"id":"manas-2010:p0241:b001:l022","ordinal":10779,"en":"In Sazangshang itself,"},{"id":"manas-2010:p0241:b001:l023","ordinal":10780,"en":"The seven Beejins rose up"},{"id":"manas-2010:p0241:b001:l024","ordinal":10781,"en":"And waged war for seven years."},{"id":"manas-2010:p0241:b001:l025","ordinal":10782,"en":"Against the dog-eating, louse-eating people,"},{"id":"manas-2010:p0241:b001:l026","ordinal":10783,"en":"They went to wage war."},{"id":"manas-2010:p0241:b001:l027","ordinal":10784,"en":"All the Kytay assembled;"},{"id":"manas-2010:p0241:b001:l028","ordinal":10785,"en":"Against the One-Eyed people,"},{"id":"manas-2010:p0241:b001:l029","ordinal":10786,"en":"When they went to wage war,"},{"id":"manas-2010:p0241:b001:l030","ordinal":10787,"en":"They were all slaughtered."},{"id":"manas-2010:p0241:b001:l031","ordinal":10788,"en":"His fame spread to Beejin;"},{"id":"manas-2010:p0241:b001:l032","ordinal":10789,"en":"Upon the One-Eyed people,"},{"id":"manas-2010:p0241:b001:l033","ordinal":10790,"en":"He alone inflicted suffering."},{"id":"manas-2010:p0241:b001:l034","ordinal":10791,"en":"Joloy of the Kalmyks"},{"id":"manas-2010:p0241:b001:l035","ordinal":10792,"en":"Made him a support at his waist."},{"id":"manas-2010:p0241:b001:l036","ordinal":10793,"en":"Kaman the giant, the One-Eyed people,"},{"id":"manas-2010:p0241:b001:l037","ordinal":10794,"en":"Slaughtered them all by himself."},{"id":"manas-2010:p0241:b001:l038","ordinal":10795,"en":"He killed their bold men;"},{"id":"manas-2010:p0241:b001:l039","ordinal":10796,"en":"He enslaved many"},{"id":"manas-2010:p0241:b001:l040","ordinal":10797,"en":"And bound them alive for Beejin."},{"id":"manas-2010:p0241:b001:l041","ordinal":10798,"en":"He thoroughly laid them waste;"},{"id":"manas-2010:p0241:b001:l042","ordinal":10799,"en":"He made them face him and submit,"},{"id":"manas-2010:p0241:b001:l043","ordinal":10800,"en":"And conquered the One-Eyed people."},{"id":"manas-2010:p0241:b001:l044","ordinal":10801,"en":"The giant Kaman with scissor ears,"},{"id":"manas-2010:p0241:b001:l045","ordinal":10802,"en":"Who struck down anyone who attacked him,"},{"id":"manas-2010:p0241:b001:l046","ordinal":10803,"en":"Was another famous, fearsome giant."},{"id":"manas-2010:p0241:b001:l047","ordinal":10804,"en":"Never sated with blood in combat,"},{"id":"manas-2010:p0241:b001:l048","ordinal":10805,"en":"That pig—may his house burn!—"},{"id":"manas-2010:p0242:b001:l001","ordinal":10806,"en":"Spared no one he encountered."},{"id":"manas-2010:p0242:b001:l002","ordinal":10807,"en":"His prowess was exceptional;"},{"id":"manas-2010:p0242:b001:l003","ordinal":10808,"en":"His heroism was considerable."},{"id":"manas-2010:p0242:b001:l004","ordinal":10809,"en":"Dust rose from his heart;"},{"id":"manas-2010:p0242:b001:l005","ordinal":10810,"en":"His voice drove souls out."},{"id":"manas-2010:p0242:b001:l006","ordinal":10811,"en":"He had occupied many uplands;"},{"id":"manas-2010:p0242:b001:l007","ordinal":10812,"en":"For the hero, brave Esenkan,"},{"id":"manas-2010:p0242:b001:l008","ordinal":10813,"en":"He had bound many giants as tribute."},{"id":"manas-2010:p0242:b001:l009","ordinal":10814,"en":"His prowess was known;"},{"id":"manas-2010:p0242:b001:l010","ordinal":10815,"en":"He was singled out in the great khan's"},{"id":"manas-2010:p0242:b001:l011","ordinal":10816,"en":"Written register."},{"id":"manas-2010:p0242:b001:l012","ordinal":10817,"en":"The giant Kaman with scissor ears,"},{"id":"manas-2010:p0242:b001:l013","ordinal":10818,"en":"When he saw Manas's appearance,"},{"id":"manas-2010:p0242:b001:l014","ordinal":10819,"en":"Roared in fury,"},{"id":"manas-2010:p0242:b001:l015","ordinal":10820,"en":"Shouting the battle cry “Kakay!”"},{"id":"manas-2010:p0242:b001:l016","ordinal":10821,"en":"He glared about in anger,"},{"id":"manas-2010:p0242:b001:l017","ordinal":10822,"en":"Made ready his weapons,"},{"id":"manas-2010:p0242:b001:l018","ordinal":10823,"en":"And resolved to fight."},{"id":"manas-2010:p0242:b001:l019","ordinal":10824,"en":"He struck his rhinoceros on the flank;"},{"id":"manas-2010:p0242:b001:l020","ordinal":10825,"en":"His face paled and his eyes blazed."},{"id":"manas-2010:p0242:b001:l021","ordinal":10826,"en":"“I will finish you, Burut!” he said."},{"id":"manas-2010:p0242:b001:l022","ordinal":10827,"en":"He leveled his spear and gripped it tight;"},{"id":"manas-2010:p0242:b001:l023","ordinal":10828,"en":"His shouting deafened the ears."},{"id":"manas-2010:p0242:b001:l024","ordinal":10829,"en":"The spear in his hand"},{"id":"manas-2010:p0242:b001:l025","ordinal":10830,"en":"He extended toward Manas."},{"id":"manas-2010:p0242:b001:l026","ordinal":10831,"en":"They met faster than an arrow;"},{"id":"manas-2010:p0242:b001:l027","ordinal":10832,"en":"As soon as they met, they struck each other."},{"id":"manas-2010:p0242:b001:l028","ordinal":10833,"en":"They passed each other thrusting spears."},{"id":"manas-2010:p0242:b001:l029","ordinal":10834,"en":"When the spears broke,"},{"id":"manas-2010:p0242:b001:l030","ordinal":10835,"en":"They clashed with battle-axes."},{"id":"manas-2010:p0242:b001:l031","ordinal":10836,"en":"When those proved of no avail,"},{"id":"manas-2010:p0242:b001:l032","ordinal":10837,"en":"They slashed with swords."},{"id":"manas-2010:p0242:b001:l033","ordinal":10838,"en":"When those proved of no avail,"},{"id":"manas-2010:p0242:b001:l034","ordinal":10839,"en":"They clashed with maces."},{"id":"manas-2010:p0242:b001:l035","ordinal":10840,"en":"They stood poised to strike;"},{"id":"manas-2010:p0242:b001:l036","ordinal":10841,"en":"They fought face to face."},{"id":"manas-2010:p0242:b001:l037","ordinal":10842,"en":"Whatever came within reach,"},{"id":"manas-2010:p0242:b001:l038","ordinal":10843,"en":"They tore apart like wolves."},{"id":"manas-2010:p0242:b001:l039","ordinal":10844,"en":"They fought with crashing blows,"},{"id":"manas-2010:p0242:b001:l040","ordinal":10845,"en":"Stirring strife in great Altay."},{"id":"manas-2010:p0242:b001:l041","ordinal":10846,"en":"Such was your bloodstained hero's work."},{"id":"manas-2010:p0242:b001:l042","ordinal":10847,"en":"They stood facing each other;"},{"id":"manas-2010:p0242:b001:l043","ordinal":10848,"en":"Grasping their spears,"},{"id":"manas-2010:p0242:b001:l044","ordinal":10849,"en":"They plunged them wherever they could."},{"id":"manas-2010:p0242:b001:l045","ordinal":10850,"en":"Swords flashed above their heads;"},{"id":"manas-2010:p0242:b001:l046","ordinal":10851,"en":"Battle-axes clacked against their heads."},{"id":"manas-2010:p0242:b001:l047","ordinal":10852,"en":"They stood without sparing their lives,"},{"id":"manas-2010:p0242:b001:l048","ordinal":10853,"en":"Fighting a furious battle."},{"id":"manas-2010:p0243:b001:l001","ordinal":10854,"en":"Gray-maned lion Manas"},{"id":"manas-2010:p0243:b001:l002","ordinal":10855,"en":"Was protected by the forty chiltens;"},{"id":"manas-2010:p0243:b001:l003","ordinal":10856,"en":"It was known that he was a lion."},{"id":"manas-2010:p0243:b001:l004","ordinal":10857,"en":"Then Manas the leopard"},{"id":"manas-2010:p0243:b001:l005","ordinal":10858,"en":"Strained and braced himself."},{"id":"manas-2010:p0243:b001:l006","ordinal":10859,"en":"All the strength he had"},{"id":"manas-2010:p0243:b001:l007","ordinal":10860,"en":"He gathered into his hands and grew strong."},{"id":"manas-2010:p0243:b001:l008","ordinal":10861,"en":"Summoning courage, exerting himself,"},{"id":"manas-2010:p0243:b001:l009","ordinal":10862,"en":"He received counsel from the unseen."},{"id":"manas-2010:p0243:b001:l010","ordinal":10863,"en":"Khan Manas grew wrathful,"},{"id":"manas-2010:p0243:b001:l011","ordinal":10864,"en":"Imploring the Divine Power:"},{"id":"manas-2010:p0243:b001:l012","ordinal":10865,"en":"“You made me a lion who slaughters enemies;"},{"id":"manas-2010:p0243:b001:l013","ordinal":10866,"en":"You made all twelve parts of my body sound."},{"id":"manas-2010:p0243:b001:l014","ordinal":10867,"en":"Unable to overcome a single unbeliever,"},{"id":"manas-2010:p0243:b001:l015","ordinal":10868,"en":"Why have you made me so deficient?”"},{"id":"manas-2010:p0243:b001:l016","ordinal":10869,"en":"Having said these words,"},{"id":"manas-2010:p0243:b001:l017","ordinal":10870,"en":"His eyes blazed like a lion's."},{"id":"manas-2010:p0243:b001:l018","ordinal":10871,"en":"Your lion, bloodstained Manas,"},{"id":"manas-2010:p0243:b001:l019","ordinal":10872,"en":"Was seized by his thirst for blood."},{"id":"manas-2010:p0243:b001:l020","ordinal":10873,"en":"He fought in fury;"},{"id":"manas-2010:p0243:b001:l021","ordinal":10874,"en":"They stood against each other."},{"id":"manas-2010:p0243:b001:l022","ordinal":10875,"en":"Valiant Manas, the noble lion,"},{"id":"manas-2010:p0243:b001:l023","ordinal":10876,"en":"Bent down and performed a daring feat."},{"id":"manas-2010:p0243:b001:l024","ordinal":10877,"en":"The giant Kaman's"},{"id":"manas-2010:p0243:b001:l025","ordinal":10878,"en":"Black hair, thick as a hand mallet,"},{"id":"manas-2010:p0243:b001:l026","ordinal":10879,"en":"Came into his hand."},{"id":"manas-2010:p0243:b001:l027","ordinal":10880,"en":"With immeasurable speed,"},{"id":"manas-2010:p0243:b001:l028","ordinal":10881,"en":"He seized it in a flash."},{"id":"manas-2010:p0243:b001:l029","ordinal":10882,"en":"Around the stirrup strap,"},{"id":"manas-2010:p0243:b001:l030","ordinal":10883,"en":"He wound it three times."},{"id":"manas-2010:p0243:b001:l031","ordinal":10884,"en":"Toruchaar, a tulpar among horses,"},{"id":"manas-2010:p0243:b001:l032","ordinal":10885,"en":"He lashed on either side;"},{"id":"manas-2010:p0243:b001:l033","ordinal":10886,"en":"He spurred to right and left,"},{"id":"manas-2010:p0243:b001:l034","ordinal":10887,"en":"Cried “Chü!” and set off."},{"id":"manas-2010:p0243:b001:l035","ordinal":10888,"en":"Toruchaar was trained for battle;"},{"id":"manas-2010:p0243:b001:l036","ordinal":10889,"en":"The mountain-sized Shibe"},{"id":"manas-2010:p0243:b001:l037","ordinal":10890,"en":"He had dragged along with a rattling roar."},{"id":"manas-2010:p0243:b001:l038","ordinal":10891,"en":"Wealthy Jakyp's great sword"},{"id":"manas-2010:p0243:b001:l039","ordinal":10892,"en":"He drew from his side."},{"id":"manas-2010:p0243:b001:l040","ordinal":10893,"en":"The giant Kaman with scissor ears,"},{"id":"manas-2010:p0243:b001:l041","ordinal":10894,"en":"His head cut off like a sheep's,"},{"id":"manas-2010:p0243:b001:l042","ordinal":10895,"en":"His belly split like a melon,"},{"id":"manas-2010:p0243:b001:l043","ordinal":10896,"en":"At the hands of Khan Manas"},{"id":"manas-2010:p0243:b001:l044","ordinal":10897,"en":"Met his death."},{"id":"manas-2010:p0243:b001:l045","ordinal":10898,"en":"Greasing the hollow with fat,"},{"id":"manas-2010:p0243:b001:l046","ordinal":10899,"en":"Having slain the giant Kaman,"},{"id":"manas-2010:p0243:b001:l047","ordinal":10900,"en":"Having slaughtered the Kytay,"},{"id":"manas-2010:p0243:b001:l048","ordinal":10901,"en":"Sated and hardened with blood,"},{"id":"manas-2010:p0244:b001:l001","ordinal":10902,"en":"He won the name of bloodstained Manas."},{"id":"manas-2010:p0244:b001:l002","ordinal":10903,"en":"No one who attacked him survived."},{"id":"manas-2010:p0244:b001:l003","ordinal":10904,"en":"That noble lion, beloved of God,"},{"id":"manas-2010:p0244:b001:l004","ordinal":10905,"en":"Would have no regrets even in death."},{"id":"manas-2010:p0244:b001:l005","ordinal":10906,"en":"He destroyed those who faced him;"},{"id":"manas-2010:p0244:b001:l006","ordinal":10907,"en":"He seized whoever he met."},{"id":"manas-2010:p0244:b001:l007","ordinal":10908,"en":"Of the champions who came to face him,"},{"id":"manas-2010:p0244:b001:l008","ordinal":10909,"en":"Not one remained alive."},{"id":"manas-2010:p0244:b001:l009","ordinal":10910,"en":"All those who faced him,"},{"id":"manas-2010:p0244:b001:l010","ordinal":10911,"en":"Valiant Manas devoured."},{"id":"manas-2010:p0244:b001:l011","ordinal":10912,"en":"Of the strong men who set out against him,"},{"id":"manas-2010:p0244:b001:l012","ordinal":10913,"en":"From the hands of valiant Manas,"},{"id":"manas-2010:p0244:b001:l013","ordinal":10914,"en":"Not one remained alive."},{"id":"manas-2010:p0244:b001:l014","ordinal":10915,"en":"Having worked Toruchaar hard,"},{"id":"manas-2010:p0244:b001:l015","ordinal":10916,"en":"Having had his host of champions slaughtered,"},{"id":"manas-2010:p0244:b001:l016","ordinal":10917,"en":"From the ridge of Topurak-Tiken,"},{"id":"manas-2010:p0244:b001:l017","ordinal":10918,"en":"That hellish champion Joloy"},{"id":"manas-2010:p0244:b001:l018","ordinal":10919,"en":"He drove fleeing toward Beejin."},{"id":"manas-2010:p0244:b001:l019","ordinal":10920,"en":"A merciless onslaught—"},{"id":"manas-2010:p0244:b001:l020","ordinal":10921,"en":"This was where the lion unleashed it."},{"id":"manas-2010:p0244:b001:l021","ordinal":10922,"en":"Sixty swift tulpar steeds"},{"id":"manas-2010:p0244:b001:l022","ordinal":10923,"en":"Manas came driving back."},{"id":"manas-2010:p0244:b001:l023","ordinal":10924,"en":"The forty boys beside him"},{"id":"manas-2010:p0244:b001:l024","ordinal":10925,"en":"Took them as booty."},{"id":"manas-2010:p0244:b001:l025","ordinal":10926,"en":"The leader of the forty boys,"},{"id":"manas-2010:p0244:b001:l026","ordinal":10927,"en":"Better than many of them,"},{"id":"manas-2010:p0244:b001:l027","ordinal":10928,"en":"Deft and skilled with the spear,"},{"id":"manas-2010:p0244:b001:l028","ordinal":10929,"en":"A mighty wolf of war—"},{"id":"manas-2010:p0244:b001:l029","ordinal":10930,"en":"Idle words are useless—"},{"id":"manas-2010:p0244:b001:l030","ordinal":10931,"en":"That unfortunate Kutubiy"},{"id":"manas-2010:p0244:b001:l031","ordinal":10932,"en":"Was gray-maned Manas's companion."},{"id":"manas-2010:p0244:b001:l032","ordinal":10933,"en":"Those who reckoned by stars in the sky,"},{"id":"manas-2010:p0244:b001:l033","ordinal":10934,"en":"Baychoro and Chalybay,"},{"id":"manas-2010:p0244:b001:l034","ordinal":10935,"en":"Were your hero's companions."},{"id":"manas-2010:p0244:b001:l035","ordinal":10936,"en":"The forty boys he had gathered"},{"id":"manas-2010:p0244:b001:l036","ordinal":10937,"en":"Were your bloodstained hero's companions."},{"id":"manas-2010:p0244:b001:l037","ordinal":10938,"en":"Manas wrought slaughter"},{"id":"manas-2010:p0244:b001:l038","ordinal":10939,"en":"And greased their yurt coverings with plenty."},{"id":"manas-2010:p0244:b001:l039","ordinal":10940,"en":"The Kyrgyz whom he met,"},{"id":"manas-2010:p0244:b001:l040","ordinal":10941,"en":"He made wealthy everywhere."},{"id":"manas-2010:p0244:b001:l041","ordinal":10942,"en":"He greased their lattice walls with plenty;"},{"id":"manas-2010:p0244:b001:l042","ordinal":10943,"en":"The Kyrgyz whom he encountered,"},{"id":"manas-2010:p0244:b001:l043","ordinal":10944,"en":"He made prosperous and rich."},{"id":"manas-2010:p0244:b001:l044","ordinal":10945,"en":"He fulfilled their wishes;"},{"id":"manas-2010:p0244:b001:l045","ordinal":10946,"en":"All their chests"},{"id":"manas-2010:p0244:b001:l046","ordinal":10947,"en":"He filled with yellow gold and treasure."},{"id":"manas-2010:p0244:b001:l047","ordinal":10948,"en":"He fulfilled their hearts' desires;"},{"id":"manas-2010:p0244:b001:l048","ordinal":10949,"en":"All their coffers"},{"id":"manas-2010:p0245:b001:l001","ordinal":10950,"en":"He filled with abundant gold."},{"id":"manas-2010:p0245:b001:l002","ordinal":10951,"en":"Destroying courts and taking booty,"},{"id":"manas-2010:p0245:b001:l003","ordinal":10952,"en":"He enriched the whole great people."},{"id":"manas-2010:p0245:b001:l004","ordinal":10953,"en":"He made their world abundant;"},{"id":"manas-2010:p0245:b001:l005","ordinal":10954,"en":"He slaughtered all who attacked."},{"id":"manas-2010:p0245:b001:l006","ordinal":10955,"en":"With the black Kalmyks and Manchus,"},{"id":"manas-2010:p0245:b001:l007","ordinal":10956,"en":"The poor Kyrgyz of forty households,"},{"id":"manas-2010:p0245:b001:l008","ordinal":10957,"en":"He made them equal to those peoples."},{"id":"manas-2010:p0245:b001:l009","ordinal":10958,"en":"He cut the arrogant down to size."},{"id":"manas-2010:p0245:b001:l010","ordinal":10959,"en":"Those who oppressed others,"},{"id":"manas-2010:p0245:b001:l011","ordinal":10960,"en":"With battle-axe blows and pounding,"},{"id":"manas-2010:p0245:b001:l012","ordinal":10961,"en":"Lion Manas set straight."},{"id":"manas-2010:p0245:b001:l013","ordinal":10962,"en":"If they chanced to come,"},{"id":"manas-2010:p0245:b001:l014","ordinal":10963,"en":"Not one remained alive."},{"id":"manas-2010:p0245:b001:l015","ordinal":10964,"en":"Dust rose from his advance;"},{"id":"manas-2010:p0245:b001:l016","ordinal":10965,"en":"His voice drove souls out."},{"id":"manas-2010:p0245:b001:l017","ordinal":10966,"en":"Among the Kyrgyz of forty households,"},{"id":"manas-2010:p0245:b001:l018","ordinal":10967,"en":"Manas the leopard was born."},{"id":"manas-2010:p0245:b001:l019","ordinal":10968,"en":"Ears heard and eyes saw;"},{"id":"manas-2010:p0245:b001:l020","ordinal":10969,"en":"Among the Manchus who heard his name,"},{"id":"manas-2010:p0245:b001:l021","ordinal":10970,"en":"Your generous hero caused an uproar."},{"id":"manas-2010:p0245:b001:l022","ordinal":10971,"en":"No one dared approach."},{"id":"manas-2010:p0245:b001:l023","ordinal":10972,"en":"Before your tiger,"},{"id":"manas-2010:p0245:b001:l024","ordinal":10973,"en":"No one who met him survived."},{"id":"manas-2010:p0245:b001:l025","ordinal":10974,"en":"No one dared come calling."},{"id":"manas-2010:p0245:b001:l026","ordinal":10975,"en":"Your bloodstained hero himself—"},{"id":"manas-2010:p0245:b001:l027","ordinal":10976,"en":"No one who attacked him survived."},{"id":"manas-2010:p0245:b001:l028","ordinal":10977,"en":"The poor Kyrgyz of forty households said:"},{"id":"manas-2010:p0245:b001:l029","ordinal":10978,"en":"“Manas has mounted his horse!"},{"id":"manas-2010:p0245:b001:l030","ordinal":10979,"en":"For the forty households who have suffered,"},{"id":"manas-2010:p0245:b001:l031","ordinal":10980,"en":"He has become a lord and protector."},{"id":"manas-2010:p0245:b001:l032","ordinal":10981,"en":"What God once inscribed upon our brows"},{"id":"manas-2010:p0245:b001:l033","ordinal":10982,"en":"Has become a giant blessing for us.”"},{"id":"manas-2010:p0245:b001:l034","ordinal":10983,"en":"They pledged offerings to Baabedin;"},{"id":"manas-2010:p0245:b001:l035","ordinal":10984,"en":"In the path of Allah the Most High,"},{"id":"manas-2010:p0245:b001:l036","ordinal":10985,"en":"They pledged a horse with moon-shaped hooves."},{"id":"manas-2010:p0245:b001:l037","ordinal":10986,"en":"Remembering how they had faced death,"},{"id":"manas-2010:p0245:b001:l038","ordinal":10987,"en":"“From the black Kalmyks and Manchus"},{"id":"manas-2010:p0245:b001:l039","ordinal":10988,"en":"We have gained deliverance,” they said."},{"id":"manas-2010:p0245:b001:l040","ordinal":10989,"en":"The wretched Kyrgyz held a feast,"},{"id":"manas-2010:p0245:b001:l041","ordinal":10990,"en":"Pledging their offerings to Baabedin,"},{"id":"manas-2010:p0245:b001:l042","ordinal":10991,"en":"Making sacrifice with fervent cries."},{"id":"manas-2010:p0245:b001:l043","ordinal":10992,"en":"All the Kyrgyz cried out;"},{"id":"manas-2010:p0245:b001:l044","ordinal":10993,"en":"They hung tether ropes around their necks,"},{"id":"manas-2010:p0245:b001:l045","ordinal":10994,"en":"Raising their voices in a clamor,"},{"id":"manas-2010:p0245:b001:l046","ordinal":10995,"en":"Imploring the Creator."},{"id":"manas-2010:p0245:b001:l047","ordinal":10996,"en":"All their grief was released;"},{"id":"manas-2010:p0245:b001:l048","ordinal":10997,"en":"All their inward anguish eased."},{"id":"manas-2010:p0246:b001:l001","ordinal":10998,"en":"Their exposed backsides were covered;"},{"id":"manas-2010:p0246:b001:l002","ordinal":10999,"en":"All their honor was restored."},{"id":"manas-2010:p0246:b001:l003","ordinal":11000,"en":"What had broken was joined again."},{"id":"manas-2010:p0246:b001:l004","ordinal":11001,"en":"Thus the Kyrgyz rejoiced:"},{"id":"manas-2010:p0246:b001:l005","ordinal":11002,"en":"“Our extinguished fires have kindled,” they said."},{"id":"manas-2010:p0246:b001:l006","ordinal":11003,"en":"“God has granted us Manas as our destiny."},{"id":"manas-2010:p0246:b001:l007","ordinal":11004,"en":"A gray shelter, a secluded thicket—"},{"id":"manas-2010:p0246:b001:l008","ordinal":11005,"en":"Warmth untouched by wind—"},{"id":"manas-2010:p0246:b001:l009","ordinal":11006,"en":"God has given us,” they said."},{"id":"manas-2010:p0246:b001:l010","ordinal":11007,"en":"“Parted from our homeland with its court,"},{"id":"manas-2010:p0246:b001:l011","ordinal":11008,"en":"We were a people who came wandering."}]
