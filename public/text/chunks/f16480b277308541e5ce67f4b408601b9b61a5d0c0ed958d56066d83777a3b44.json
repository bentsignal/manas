[{"id":"semetey-1-2013:p0439:b004:l007","ordinal":110337,"en":"Many horses among the beasts died,"},{"id":"semetey-1-2013:p0439:b004:l008","ordinal":110338,"en":"Many humans died swiftly."},{"id":"semetey-1-2013:p0439:b004:l009","ordinal":110339,"en":"They stood through days and nights,"},{"id":"semetey-1-2013:p0439:b004:l010","ordinal":110340,"en":"Fighting seven days without pause."},{"id":"semetey-1-2013:p0439:b004:l011","ordinal":110341,"en":"Ill-natured Kongurbay—"},{"id":"semetey-1-2013:p0439:b004:l012","ordinal":110342,"en":"The cruelty he had inflicted on Talas,"},{"id":"semetey-1-2013:p0439:b004:l013","ordinal":110343,"en":"Saying, 'I shall raid and seize the Kyrgyz,'"},{"id":"semetey-1-2013:p0439:b004:l014","ordinal":110344,"en":"The violence he had inflicted on many."},{"id":"semetey-1-2013:p0439:b004:l015","ordinal":110345,"en":"Eighty thousand warriors, countless officers,"},{"id":"semetey-1-2013:p0439:b004:l016","ordinal":110346,"en":"Kongurbay, the enemy's foremost hero—"},{"id":"semetey-1-2013:p0439:b004:l017","ordinal":110347,"en":"They turned their rhinoceroses' heads,"},{"id":"semetey-1-2013:p0439:b004:l018","ordinal":110348,"en":"And fought, aiming at one another."},{"id":"semetey-1-2013:p0439:b004:l019","ordinal":110349,"en":"Within that battle,"},{"id":"semetey-1-2013:p0439:b004:l020","ordinal":110350,"en":"He who had fled the dark and become estranged,"},{"id":"semetey-1-2013:p0439:b004:l021","ordinal":110351,"en":"Who had become pure from the dark faith,"},{"id":"semetey-1-2013:p0439:b004:l022","ordinal":110352,"en":"Whose amassed wealth remained in Beijing,"},{"id":"semetey-1-2013:p0439:b004:l023","ordinal":110353,"en":"His faith and belief that held sway,"},{"id":"semetey-1-2013:p0439:b004:l024","ordinal":110354,"en":"Whose amassed wealth remained with the emperor,"},{"id":"semetey-1-2013:p0439:b004:l025","ordinal":110355,"en":"His chosen faith and belief,"},{"id":"semetey-1-2013:p0439:b004:l026","ordinal":110356,"en":"The yellow willows he had had planted—"},{"id":"semetey-1-2013:p0439:b004:l027","ordinal":110357,"en":"His willows remained in Beijing."},{"id":"semetey-1-2013:p0439:b004:l028","ordinal":110358,"en":"Made of pure gold,"},{"id":"semetey-1-2013:p0439:b004:l029","ordinal":110359,"en":"His throne remained in Beijing."},{"id":"semetey-1-2013:p0439:b004:l030","ordinal":110360,"en":"The prophet, the sultan, his faith pure—"},{"id":"semetey-1-2013:p0439:b004:l031","ordinal":110361,"en":"The golden throne remained in Beijing."},{"id":"semetey-1-2013:p0439:b004:l032","ordinal":110362,"en":"When he held the emperor in his grasp,"},{"id":"semetey-1-2013:p0439:b004:l033","ordinal":110363,"en":"When our Alake ruled Beijing as khan,"},{"id":"semetey-1-2013:p0439:b004:l034","ordinal":110364,"en":"Coral, jeweled cap ornaments, precious stones—"},{"id":"semetey-1-2013:p0439:b004:l035","ordinal":110365,"en":"When Khan Almam wore them,"},{"id":"semetey-1-2013:p0439:b004:l036","ordinal":110366,"en":"When his authority reached Beijing,"},{"id":"semetey-1-2013:p0439:b004:l037","ordinal":110367,"en":"And our Alake held it in his sway,"},{"id":"semetey-1-2013:p0439:b004:l038","ordinal":110368,"en":"When his envoy to the golden throne"},{"id":"semetey-1-2013:p0439:b004:l039","ordinal":110369,"en":"Would go,"},{"id":"semetey-1-2013:p0440:b003:l001","ordinal":110370,"en":"When upon Beijing an uproar"},{"id":"semetey-1-2013:p0440:b003:l002","ordinal":110371,"en":"He was bringing,"},{"id":"semetey-1-2013:p0440:b003:l003","ordinal":110372,"en":"As he lay asleep, there appeared"},{"id":"semetey-1-2013:p0440:b003:l004","ordinal":110373,"en":"A white-bearded holy man."},{"id":"semetey-1-2013:p0440:b003:l005","ordinal":110374,"en":"He endured distress in his sleep;"},{"id":"semetey-1-2013:p0440:b003:l006","ordinal":110375,"en":"Whenever Alake fell asleep,"},{"id":"semetey-1-2013:p0440:b003:l007","ordinal":110376,"en":"He dreamed of paradise and hell."},{"id":"semetey-1-2013:p0440:b003:l008","ordinal":110377,"en":"Because of Judgment Day,"},{"id":"semetey-1-2013:p0440:b003:l009","ordinal":110378,"en":"Because of hell, that bastard Almam"},{"id":"semetey-1-2013:p0440:b003:l010","ordinal":110379,"en":"Said, 'Among my unbelieving people,"},{"id":"semetey-1-2013:p0440:b003:l011","ordinal":110380,"en":"How can I remain?"},{"id":"semetey-1-2013:p0440:b003:l012","ordinal":110381,"en":"Among Muslims of the true faith"},{"id":"semetey-1-2013:p0440:b003:l013","ordinal":110382,"en":"I shall go and join them"},{"id":"semetey-1-2013:p0440:b003:l014","ordinal":110383,"en":"And render faithful service."},{"id":"semetey-1-2013:p0440:b003:l015","ordinal":110384,"en":"That hoarse-voiced idol of theirs,"},{"id":"semetey-1-2013:p0440:b003:l016","ordinal":110385,"en":"How can I call it God?"},{"id":"semetey-1-2013:p0440:b003:l017","ordinal":110386,"en":"I shall flee to the Muslims"},{"id":"semetey-1-2013:p0440:b003:l018","ordinal":110387,"en":"And take thought for the world beyond."},{"id":"semetey-1-2013:p0440:b003:l019","ordinal":110388,"en":"A great idol made of bronze,"},{"id":"semetey-1-2013:p0440:b003:l020","ordinal":110389,"en":"How can I call it God?"},{"id":"semetey-1-2013:p0440:b003:l021","ordinal":110390,"en":"My extraordinary tulpar Sarala—"},{"id":"semetey-1-2013:p0440:b003:l023","ordinal":110391,"en":"Before that reckless idol,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0440:b003:l024","ordinal":110392,"en":"Wretched soul that I am, how can I bear to bow?'"},{"id":"semetey-1-2013:p0440:b003:l026","ordinal":110393,"en":"He fled and came to Talas,"},{"id":"semetey-1-2013:p0440:b003:l027","ordinal":110394,"en":"Becoming a friend into the world beyond"},{"id":"semetey-1-2013:p0440:b003:l028","ordinal":110395,"en":"To your father Manas."},{"id":"semetey-1-2013:p0440:b003:l029","ordinal":110396,"en":"When Alake lived in Beijing,"},{"id":"semetey-1-2013:p0440:b003:l030","ordinal":110397,"en":"Those who saw his authority trembled."},{"id":"semetey-1-2013:p0440:b003:l031","ordinal":110398,"en":"Alake learned wondrous spells"},{"id":"semetey-1-2013:p0440:b003:l032","ordinal":110399,"en":"At the lake of Abergen,"},{"id":"semetey-1-2013:p0440:b003:l033","ordinal":110400,"en":"In the depths of Suuk-Tör,"},{"id":"semetey-1-2013:p0440:b003:l034","ordinal":110401,"en":"In the land of the One-Eyed One."},{"id":"semetey-1-2013:p0440:b003:l035","ordinal":110402,"en":"He saddled Sarala properly;"},{"id":"semetey-1-2013:p0440:b003:l036","ordinal":110403,"en":"The great lore from which no traveler returns"},{"id":"semetey-1-2013:p0440:b003:l037","ordinal":110404,"en":"He learned from a dragon."},{"id":"semetey-1-2013:p0440:b003:l038","ordinal":110405,"en":"Those who witnessed his renown trembled."},{"id":"semetey-1-2013:p0440:b003:l039","ordinal":110406,"en":"Tall in stature, broad in shoulder,"},{"id":"semetey-1-2013:p0440:b004:l001","ordinal":110407,"en":"Both champion and lion,"},{"id":"semetey-1-2013:p0440:b004:l002","ordinal":110408,"en":"The little son of Azyz Khan of Beijing,"},{"id":"semetey-1-2013:p0440:b004:l003","ordinal":110409,"en":"The seething Chinese host—"},{"id":"semetey-1-2013:p0440:b004:l004","ordinal":110410,"en":"The leopard Alake beheld them then."},{"id":"semetey-1-2013:p0440:b004:l005","ordinal":110411,"en":"Brown eyes without a speck,"},{"id":"semetey-1-2013:p0440:b004:l006","ordinal":110412,"en":"A fair face without a freckle,"},{"id":"semetey-1-2013:p0440:b004:l007","ordinal":110413,"en":"Great as a mountain in size,"},{"id":"semetey-1-2013:p0440:b004:l008","ordinal":110414,"en":"At that moment Alake,"},{"id":"semetey-1-2013:p0440:b004:l009","ordinal":110415,"en":"Kongurbai, khan of the monks,"},{"id":"semetey-1-2013:p0440:b004:l010","ordinal":110416,"en":"He would have seized and devoured him, had they met."},{"id":"semetey-1-2013:p0440:b004:l011","ordinal":110417,"en":"Against the thick multitudes, the great army,"},{"id":"semetey-1-2013:p0440:b004:l012","ordinal":110418,"en":"The leopard Almam, a hero alone,"},{"id":"semetey-1-2013:p0440:b004:l013","ordinal":110419,"en":"Roared in wrath,"},{"id":"semetey-1-2013:p0440:b004:l014","ordinal":110420,"en":"Calling 'Manas!' as his battle-cry."},{"id":"semetey-1-2013:p0440:b004:l015","ordinal":110421,"en":"Firmly girding his waist,"},{"id":"semetey-1-2013:p0440:b004:l016","ordinal":110422,"en":"Against seventy thousand Chinese"},{"id":"semetey-1-2013:p0440:b004:l017","ordinal":110423,"en":"Almam charged and attacked."},{"id":"semetey-1-2013:p0440:b004:l018","ordinal":110424,"en":"Sarala, with lean, cow-like haunches,"},{"id":"semetey-1-2013:p0440:b004:l019","ordinal":110425,"en":"He made his courser prance."},{"id":"semetey-1-2013:p0440:b004:l020","ordinal":110426,"en":"Whomever he encountered, that dear lion"},{"id":"semetey-1-2013:p0440:b004:l021","ordinal":110427,"en":"Speared deep and sent sprawling."},{"id":"semetey-1-2013:p0440:b004:l022","ordinal":110428,"en":"Syrgak, son of Ulakkan,"},{"id":"semetey-1-2013:p0440:b004:l023","ordinal":110429,"en":"Made Kökchebich prance as well."},{"id":"semetey-1-2013:p0440:b004:l024","ordinal":110430,"en":"Whomever he met, that dear lion"},{"id":"semetey-1-2013:p0440:b004:l025","ordinal":110431,"en":"Struck this way and that."},{"id":"semetey-1-2013:p0440:b004:l026","ordinal":110432,"en":"His mount was a splendid tulpar."},{"id":"semetey-1-2013:p0440:b004:l027","ordinal":110433,"en":"When the massed Chinese, the khakan's people,"},{"id":"semetey-1-2013:p0440:b004:l028","ordinal":110434,"en":"Were besieging Talas,"},{"id":"semetey-1-2013:p0440:b004:l029","ordinal":110435,"en":"Almambet and Syrgak together,"},{"id":"semetey-1-2013:p0440:b004:l030","ordinal":110436,"en":"Ajybai and Bakai, the two khans,"},{"id":"semetey-1-2013:p0440:b004:l031","ordinal":110437,"en":"Almambet and Chubak, the paired heroes,"},{"id":"semetey-1-2013:p0440:b004:l032","ordinal":110438,"en":"Syrgak and Serek, heroes equally matched,"},{"id":"semetey-1-2013:p0440:b004:l033","ordinal":110439,"en":"Akjoltoi, son of Adyk Khan,"},{"id":"semetey-1-2013:p0440:b004:l034","ordinal":110440,"en":"The Magnanimous One's companions,"},{"id":"semetey-1-2013:p0440:b004:l035","ordinal":110441,"en":"Each like an army ten thousand strong,"},{"id":"semetey-1-2013:p0440:b004:l036","ordinal":110442,"en":"When they all charged into their midst,"},{"id":"semetey-1-2013:p0440:b004:l037","ordinal":110443,"en":"With your magnanimous father among them,"},{"id":"semetey-1-2013:p0440:b004:l038","ordinal":110444,"en":"Against sixty thousand Black Chinese"},{"id":"semetey-1-2013:p0440:b004:l039","ordinal":110445,"en":"They struck like falcons,"},{"id":"semetey-1-2013:p0441:b003:l001","ordinal":110446,"en":"The unbelievers, thick as black willows,"},{"id":"semetey-1-2013:p0441:b003:l002","ordinal":110447,"en":"They encircled, drove, and slaughtered,"},{"id":"semetey-1-2013:p0441:b003:l003","ordinal":110448,"en":"Scattering them toward Beijing."},{"id":"semetey-1-2013:p0441:b003:l004","ordinal":110449,"en":"Their very center, hero Manas"},{"id":"semetey-1-2013:p0441:b003:l005","ordinal":110450,"en":"Carved open as he came."},{"id":"semetey-1-2013:p0441:b003:l006","ordinal":110451,"en":"Their two flanks, the heroes"},{"id":"semetey-1-2013:p0441:b003:l007","ordinal":110452,"en":"Slaughtered as they came."},{"id":"semetey-1-2013:p0441:b003:l008","ordinal":110453,"en":"One side, hero Bakai"},{"id":"semetey-1-2013:p0441:b003:l009","ordinal":110454,"en":"Closed in upon as he came."},{"id":"semetey-1-2013:p0441:b003:l010","ordinal":110455,"en":"Their very middle, the falcons of men"},{"id":"semetey-1-2013:p0441:b003:l011","ordinal":110456,"en":"Battered as they came."},{"id":"semetey-1-2013:p0441:b003:l012","ordinal":110457,"en":"Their outermost edge, Khan Chubak"},{"id":"semetey-1-2013:p0441:b003:l013","ordinal":110458,"en":"Drove forward as he came."},{"id":"semetey-1-2013:p0441:b003:l014","ordinal":110459,"en":"Their very rear, Khan Syrgak"},{"id":"semetey-1-2013:p0441:b003:l015","ordinal":110460,"en":"Laid low as he came."},{"id":"semetey-1-2013:p0441:b003:l016","ordinal":110461,"en":"Drenching them in red blood,"},{"id":"semetey-1-2013:p0441:b003:l017","ordinal":110462,"en":"My dear Almam, that precious lion,"},{"id":"semetey-1-2013:p0441:b003:l018","ordinal":110463,"en":"Drove them onward as he came."},{"id":"semetey-1-2013:p0441:b003:l019","ordinal":110464,"en":"Leaving none they met alive,"},{"id":"semetey-1-2013:p0441:b003:l020","ordinal":110465,"en":"All the falcons of men"},{"id":"semetey-1-2013:p0441:b003:l021","ordinal":110466,"en":"Laid them low as they came."},{"id":"semetey-1-2013:p0441:b003:l022","ordinal":110467,"en":"Unable to withstand their wrath,"},{"id":"semetey-1-2013:p0441:b003:l023","ordinal":110468,"en":"The Chinese broke apart in flight."},{"id":"semetey-1-2013:p0441:b003:l024","ordinal":110469,"en":"Unable to withstand their valor,"},{"id":"semetey-1-2013:p0441:b003:l025","ordinal":110470,"en":"They scattered in every direction."},{"id":"semetey-1-2013:p0441:b003:l026","ordinal":110471,"en":"Many warriors were slaughtered;"},{"id":"semetey-1-2013:p0441:b003:l027","ordinal":110472,"en":"Still more were caught in the net."},{"id":"semetey-1-2013:p0441:b003:l028","ordinal":110473,"en":"Unable to gather their wits,"},{"id":"semetey-1-2013:p0441:b003:l029","ordinal":110474,"en":"Many of the khakan's people died;"},{"id":"semetey-1-2013:p0441:b003:l030","ordinal":110475,"en":"Still more were taken captive."},{"id":"semetey-1-2013:p0441:b003:l031","ordinal":110476,"en":"The distinguished warriors led by Kongurbai,"},{"id":"semetey-1-2013:p0441:b003:l032","ordinal":110477,"en":"All those heroes,"},{"id":"semetey-1-2013:p0441:b003:l033","ordinal":110478,"en":"Were seen fleeing in the foremost ranks."},{"id":"semetey-1-2013:p0441:b003:l034","ordinal":110479,"en":"The feeble men without courage"},{"id":"semetey-1-2013:p0441:b003:l035","ordinal":110480,"en":"Could not escape; their blood was spilled."},{"id":"semetey-1-2013:p0441:b003:l036","ordinal":110481,"en":"When the many Chinese, fleeing in haste,"},{"id":"semetey-1-2013:p0441:b003:l037","ordinal":110482,"en":"Crossed broad Talas,"},{"id":"semetey-1-2013:p0441:b003:l038","ordinal":110483,"en":"They took the road along the Ili,"},{"id":"semetey-1-2013:p0441:b003:l039","ordinal":110484,"en":"Traveling by night, not by day."},{"id":"semetey-1-2013:p0441:b005:l001","ordinal":110485,"en":"The forty companions led by Manas"},{"id":"semetey-1-2013:p0441:b005:l002","ordinal":110486,"en":"Stayed relentlessly upon their trail,"},{"id":"semetey-1-2013:p0441:b005:l003","ordinal":110487,"en":"Pursuing them to exhaustion."},{"id":"semetey-1-2013:p0441:b005:l004","ordinal":110488,"en":"Hero Bakai, son of Oluyat,"},{"id":"semetey-1-2013:p0441:b005:l005","ordinal":110489,"en":"Scouted their road day and night."},{"id":"semetey-1-2013:p0441:b005:l006","ordinal":110490,"en":"When to the green willows beside the Ili"},{"id":"semetey-1-2013:p0441:b005:l007","ordinal":110491,"en":"They drew near,"},{"id":"semetey-1-2013:p0441:b005:l008","ordinal":110492,"en":"Weighing counsel, thinking deeply,"},{"id":"semetey-1-2013:p0441:b005:l009","ordinal":110493,"en":"Kongurbai, son of Alööke,"},{"id":"semetey-1-2013:p0441:b005:l010","ordinal":110494,"en":"Thought, 'If we keep fleeing, our khakan's land,"},{"id":"semetey-1-2013:p0441:b005:l011","ordinal":110495,"en":"If we continue thus, to Manas"},{"id":"semetey-1-2013:p0441:b005:l012","ordinal":110496,"en":"We shall lose it.'"},{"id":"semetey-1-2013:p0441:b005:l013","ordinal":110497,"en":"The Burut and Chinese did not come together;"},{"id":"semetey-1-2013:p0441:b005:l014","ordinal":110498,"en":"From the far bank and the near bank"},{"id":"semetey-1-2013:p0441:b005:l015","ordinal":110499,"en":"They fired their guns at one another,"},{"id":"semetey-1-2013:p0441:b005:l016","ordinal":110500,"en":"Fighting without mercy."},{"id":"semetey-1-2013:p0441:b005:l017","ordinal":110501,"en":"Unable to reach with their spears,"},{"id":"semetey-1-2013:p0441:b005:l018","ordinal":110502,"en":"They clashed with drawn bows."},{"id":"semetey-1-2013:p0441:b005:l019","ordinal":110503,"en":"They stood confronting each other,"},{"id":"semetey-1-2013:p0441:b005:l020","ordinal":110504,"en":"Never idle, fighting thus."},{"id":"semetey-1-2013:p0441:b005:l021","ordinal":110505,"en":"Ways that would bring death"},{"id":"semetey-1-2013:p0441:b005:l022","ordinal":110506,"en":"The heroes contrived as best they could."},{"id":"semetey-1-2013:p0441:b005:l023","ordinal":110507,"en":"With golden forelock and tasseled belt,"},{"id":"semetey-1-2013:p0441:b005:l024","ordinal":110508,"en":"Almambet, son of Azyz Khan,"},{"id":"semetey-1-2013:p0441:b005:l025","ordinal":110509,"en":"The weather-stone obtained from the unseen,"},{"id":"semetey-1-2013:p0441:b005:l026","ordinal":110510,"en":"Reciting its true spell,"},{"id":"semetey-1-2013:p0441:b005:l027","ordinal":110511,"en":"Took and struck into the water."},{"id":"semetey-1-2013:p0441:b005:l028","ordinal":110512,"en":"The cloud's name was Buurakan;"},{"id":"semetey-1-2013:p0441:b005:l029","ordinal":110513,"en":"Calling out that name,"},{"id":"semetey-1-2013:p0441:b005:l030","ordinal":110514,"en":"The weather-stone obtained from a snake,"},{"id":"semetey-1-2013:p0441:b005:l031","ordinal":110515,"en":"In a bowl of plain water"},{"id":"semetey-1-2013:p0441:b005:l032","ordinal":110516,"en":"He made it barely touch the surface."},{"id":"semetey-1-2013:p0441:b005:l033","ordinal":110517,"en":"Clouded by day, clear at night—"},{"id":"semetey-1-2013:p0441:b005:l034","ordinal":110518,"en":"Almambet cast his weather-spell."},{"id":"semetey-1-2013:p0441:b005:l035","ordinal":110519,"en":"Windblown drizzle turning to snow,"},{"id":"semetey-1-2013:p0441:b005:l036","ordinal":110520,"en":"Gusty winds and abundant hail,"},{"id":"semetey-1-2013:p0441:b005:l037","ordinal":110521,"en":"Hiding the face of the earth,"},{"id":"semetey-1-2013:p0441:b005:l038","ordinal":110522,"en":"A ground-hugging fog descended."},{"id":"semetey-1-2013:p0441:b005:l039","ordinal":110523,"en":"When they saw this weather,"},{"id":"semetey-1-2013:p0442:b003:l001","ordinal":110524,"en":"They lost their wits,"},{"id":"semetey-1-2013:p0442:b003:l002","ordinal":110525,"en":"Hurrying and hastening along the road,"},{"id":"semetey-1-2013:p0442:b003:l003","ordinal":110526,"en":"Fleeing toward Beijing."},{"id":"semetey-1-2013:p0442:b003:l004","ordinal":110527,"en":"Crossing deep ravines athwart their path,"},{"id":"semetey-1-2013:p0442:b003:l005","ordinal":110528,"en":"Passing distant, towering peaks,"},{"id":"semetey-1-2013:p0442:b003:l006","ordinal":110529,"en":"Not lying down to sleep their fill,"},{"id":"semetey-1-2013:p0442:b003:l007","ordinal":110530,"en":"Not letting their tulpars graze,"},{"id":"semetey-1-2013:p0442:b003:l008","ordinal":110531,"en":"Not resting upon an elbow,"},{"id":"semetey-1-2013:p0442:b003:l009","ordinal":110532,"en":"Not taking even a brief nap,"},{"id":"semetey-1-2013:p0442:b003:l010","ordinal":110533,"en":"Kongurbai fled in earnest."},{"id":"semetey-1-2013:p0442:b003:l011","ordinal":110534,"en":"How could your hero hold back?"},{"id":"semetey-1-2013:p0442:b003:l012","ordinal":110535,"en":"Keeping by the mountains of Lower Khangai,"},{"id":"semetey-1-2013:p0442:b003:l013","ordinal":110536,"en":"Turning his trail and journeying on,"},{"id":"semetey-1-2013:p0442:b003:l014","ordinal":110537,"en":"Sparing no horse, covering great distances,"},{"id":"semetey-1-2013:p0442:b003:l015","ordinal":110538,"en":"Kongurbai, son of Alööke,"},{"id":"semetey-1-2013:p0442:b003:l016","ordinal":110539,"en":"Crossed many rounded mountains,"},{"id":"semetey-1-2013:p0442:b003:l017","ordinal":110540,"en":"Lurching through the ravines."},{"id":"semetey-1-2013:p0442:b003:l018","ordinal":110541,"en":"Having entered Talas and turned back,"},{"id":"semetey-1-2013:p0442:b003:l019","ordinal":110542,"en":"He had lost his countless army."},{"id":"semetey-1-2013:p0442:b003:l020","ordinal":110543,"en":"Having gone to the Kyrgyz and turned back,"},{"id":"semetey-1-2013:p0442:b003:l021","ordinal":110544,"en":"Makil and Orokkyr,"},{"id":"semetey-1-2013:p0442:b003:l022","ordinal":110545,"en":"He had lost those two."},{"id":"semetey-1-2013:p0442:b003:l023","ordinal":110546,"en":"Midday was darkened in heaven."},{"id":"semetey-1-2013:p0442:b003:l024","ordinal":110547,"en":"Kongurbai, son of Alööke,"},{"id":"semetey-1-2013:p0442:b003:l025","ordinal":110548,"en":"That pig who knew the land well,"},{"id":"semetey-1-2013:p0442:b003:l026","ordinal":110549,"en":"Made good his escape."},{"id":"semetey-1-2013:p0442:b003:l027","ordinal":110550,"en":"Then Almambet"},{"id":"semetey-1-2013:p0442:b003:l028","ordinal":110551,"en":"And the lion Bakai, those four,"},{"id":"semetey-1-2013:p0442:b003:l029","ordinal":110552,"en":"The giants and champions left between them,"},{"id":"semetey-1-2013:p0442:b003:l030","ordinal":110553,"en":"Eight of their monks,"},{"id":"semetey-1-2013:p0442:b003:l031","ordinal":110554,"en":"Alake caught up with and shot."},{"id":"semetey-1-2013:p0442:b003:l032","ordinal":110555,"en":"With Alake and Bakai at their head,"},{"id":"semetey-1-2013:p0442:b003:l033","ordinal":110556,"en":"They crossed along Talkuu."},{"id":"semetey-1-2013:p0442:b003:l034","ordinal":110557,"en":"On moon-like Sary-Talaa,"},{"id":"semetey-1-2013:p0442:b003:l035","ordinal":110558,"en":"Of the Black Kalmyks and Manchus,"},{"id":"semetey-1-2013:p0442:b003:l036","ordinal":110559,"en":"They overran the distant herdsmen."},{"id":"semetey-1-2013:p0442:b003:l037","ordinal":110560,"en":"Taking some twelve thousand horses,"},{"id":"semetey-1-2013:p0442:b003:l038","ordinal":110561,"en":"Your devastating heroes turned back."},{"id":"semetey-1-2013:p0442:b003:l039","ordinal":110562,"en":"Of the people left after the deaths,"},{"id":"semetey-1-2013:p0442:b004:l001","ordinal":110563,"en":"They scattered monks and captured clerics."},{"id":"semetey-1-2013:p0442:b004:l002","ordinal":110564,"en":"Without dispute the Kyrgyz took booty."},{"id":"semetey-1-2013:p0442:b004:l003","ordinal":110565,"en":"The most skillful men"},{"id":"semetey-1-2013:p0442:b004:l004","ordinal":110566,"en":"Took sixty horses apiece."},{"id":"semetey-1-2013:p0442:b004:l005","ordinal":110567,"en":"The weak-jointed who could not keep up"},{"id":"semetey-1-2013:p0442:b004:l006","ordinal":110568,"en":"Drove off seven horses apiece."},{"id":"semetey-1-2013:p0442:b004:l007","ordinal":110569,"en":"The finest falcons of men"},{"id":"semetey-1-2013:p0442:b004:l008","ordinal":110570,"en":"Took seventy as booty apiece."},{"id":"semetey-1-2013:p0442:b004:l009","ordinal":110571,"en":"The feeble who could not keep up"},{"id":"semetey-1-2013:p0442:b004:l010","ordinal":110572,"en":"Took seven horses as booty apiece."},{"id":"semetey-1-2013:p0442:b004:l011","ordinal":110573,"en":"The Kyrgyz and Argyn in Talas"},{"id":"semetey-1-2013:p0442:b004:l012","ordinal":110574,"en":"They satisfied in all their wishes,"},{"id":"semetey-1-2013:p0442:b004:l013","ordinal":110575,"en":"All their chests"},{"id":"semetey-1-2013:p0442:b004:l014","ordinal":110576,"en":"Filling with yellow gold and treasure."},{"id":"semetey-1-2013:p0442:b004:l015","ordinal":110577,"en":"Those Argyn and Kyrgyz people"},{"id":"semetey-1-2013:p0442:b004:l016","ordinal":110578,"en":"They satisfied in their wishes,"},{"id":"semetey-1-2013:p0442:b004:l017","ordinal":110579,"en":"They satisfied in their hearts."},{"id":"semetey-1-2013:p0442:b004:l018","ordinal":110580,"en":"Of the Kyrgyz and Argyn in Talas,"},{"id":"semetey-1-2013:p0442:b004:l019","ordinal":110581,"en":"Every storage chest"},{"id":"semetey-1-2013:p0442:b004:l020","ordinal":110582,"en":"They filled with abundant gold."},{"id":"semetey-1-2013:p0442:b004:l021","ordinal":110583,"en":"They hid the livestock pens in dust,"},{"id":"semetey-1-2013:p0442:b004:l022","ordinal":110584,"en":"And the Argyn and Kyrgyz"},{"id":"semetey-1-2013:p0442:b004:l023","ordinal":110585,"en":"They made more prosperous than other peoples."},{"id":"semetey-1-2013:p0442:b004:l024","ordinal":110586,"en":"They pursued the Chinese and took booty,"},{"id":"semetey-1-2013:p0442:b004:l025","ordinal":110587,"en":"Bringing the army back united and undivided."},{"id":"semetey-1-2013:p0442:b004:l026","ordinal":110588,"en":"At that time, against your father"},{"id":"semetey-1-2013:p0442:b004:l027","ordinal":110589,"en":"The twelve peoples made no attack."},{"id":"semetey-1-2013:p0442:b004:l028","ordinal":110590,"en":"Against that dauntless man of surpassing fortune,"},{"id":"semetey-1-2013:p0442:b004:l029","ordinal":110591,"en":"None remained to raise a herding-pole."},{"id":"semetey-1-2013:p0442:b004:l030","ordinal":110592,"en":"Dwelling in great Talas,"}]
