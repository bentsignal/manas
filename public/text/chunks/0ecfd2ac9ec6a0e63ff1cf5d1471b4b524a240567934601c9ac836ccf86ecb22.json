[{"id":"manas-2010:p0385:b001:l015","ordinal":17665,"en":"When he pulled Baltay along,"},{"id":"manas-2010:p0385:b001:l016","ordinal":17666,"en":"He dragged him like a fur cap."},{"id":"manas-2010:p0385:b001:l017","ordinal":17667,"en":"Driving him down the slope,"},{"id":"manas-2010:p0385:b001:l018","ordinal":17668,"en":"Where they fled, he dragged Baltay"},{"id":"manas-2010:p0385:b001:l019","ordinal":17669,"en":"Along like a tumbleweed."},{"id":"manas-2010:p0385:b001:l020","ordinal":17670,"en":"Telkyzyl beneath him"},{"id":"manas-2010:p0385:b001:l021","ordinal":17671,"en":"Was born a tulpar of a different kind."},{"id":"manas-2010:p0385:b001:l022","ordinal":17672,"en":"That swiftest of the hair-tailed horses"},{"id":"manas-2010:p0385:b001:l023","ordinal":17673,"en":"Surpassed the ages, a different kind."},{"id":"manas-2010:p0385:b001:l024","ordinal":17674,"en":"His tail sparse, his mane scant,"},{"id":"manas-2010:p0385:b001:l025","ordinal":17675,"en":"Seeing a kulan, he would not let it escape."},{"id":"manas-2010:p0385:b001:l026","ordinal":17676,"en":"At the cry “Go!” he streaked away,"},{"id":"manas-2010:p0385:b001:l027","ordinal":17677,"en":"Vanishing out of sight."},{"id":"manas-2010:p0385:b001:l028","ordinal":17678,"en":"When he carried Akbaltay away,"},{"id":"manas-2010:p0385:b001:l029","ordinal":17679,"en":"His tulpar qualities showed."},{"id":"manas-2010:p0385:b001:l030","ordinal":17680,"en":"As he ran, the dark earth"},{"id":"manas-2010:p0385:b001:l031","ordinal":17681,"en":"Split apart layer by layer."},{"id":"manas-2010:p0385:b001:l032","ordinal":17682,"en":"Crossing rough and rugged passes,"},{"id":"manas-2010:p0385:b001:l033","ordinal":17683,"en":"Treading bumpy, stony ground,"},{"id":"manas-2010:p0385:b001:l034","ordinal":17684,"en":"Passing the towering mountain,"},{"id":"manas-2010:p0385:b001:l035","ordinal":17685,"en":"Crossing deep, uneven gullies—"},{"id":"manas-2010:p0385:b001:l036","ordinal":17686,"en":"How could the champions hold back?"},{"id":"manas-2010:p0385:b001:l037","ordinal":17687,"en":"At the spur of the Altay mountain,"},{"id":"manas-2010:p0385:b001:l038","ordinal":17688,"en":"Keeping by the great river,"},{"id":"manas-2010:p0385:b001:l039","ordinal":17689,"en":"At the meeting of nine roads,"},{"id":"manas-2010:p0385:b001:l040","ordinal":17690,"en":"In the region of Börü-Koy,"},{"id":"manas-2010:p0385:b001:l041","ordinal":17691,"en":"On the ridge of It-Ölbös,"},{"id":"manas-2010:p0385:b001:l042","ordinal":17692,"en":"The champions gained a foothold."},{"id":"manas-2010:p0385:b001:l043","ordinal":17693,"en":"The two tulpars left free to run"},{"id":"manas-2010:p0385:b001:l044","ordinal":17694,"en":"Revealed their speed."},{"id":"manas-2010:p0385:b001:l045","ordinal":17695,"en":"When uneven ground appeared,"},{"id":"manas-2010:p0385:b001:l046","ordinal":17696,"en":"As though about to fly away,"},{"id":"manas-2010:p0385:b001:l047","ordinal":17697,"en":"They raced with flying birds."},{"id":"manas-2010:p0385:b001:l048","ordinal":17698,"en":"The pale reins softened in tanning liquor"},{"id":"manas-2010:p0386:b001:l001","ordinal":17699,"en":"Stretched taut against the hand."},{"id":"manas-2010:p0386:b001:l002","ordinal":17700,"en":"He lowered his head to the ground,"},{"id":"manas-2010:p0386:b001:l003","ordinal":17701,"en":"And ran in an extraordinary way."},{"id":"manas-2010:p0386:b001:l004","ordinal":17702,"en":"His flesh divided like a sheep's,"},{"id":"manas-2010:p0386:b001:l005","ordinal":17703,"en":"His back stretched straight like a hare's."},{"id":"manas-2010:p0386:b001:l006","ordinal":17704,"en":"His flesh divided like a colt's,"},{"id":"manas-2010:p0386:b001:l007","ordinal":17705,"en":"His back stretched straight like a hound's."},{"id":"manas-2010:p0386:b001:l008","ordinal":17706,"en":"His mouth opened like a cavern."},{"id":"manas-2010:p0386:b001:l009","ordinal":17707,"en":"His contracted steel hooves"},{"id":"manas-2010:p0386:b001:l010","ordinal":17708,"en":"Spread as wide as a small shelter."},{"id":"manas-2010:p0386:b001:l011","ordinal":17709,"en":"Steam issued from his nostrils,"},{"id":"manas-2010:p0386:b001:l012","ordinal":17710,"en":"Clear water flowed from his armpits."},{"id":"manas-2010:p0386:b001:l013","ordinal":17711,"en":"They reached Kara-Kyr,"},{"id":"manas-2010:p0386:b001:l014","ordinal":17712,"en":"And their tulpar nature showed."},{"id":"manas-2010:p0386:b001:l015","ordinal":17713,"en":"To the joining dark steep path,"},{"id":"manas-2010:p0386:b001:l016","ordinal":17714,"en":"The forty households of Kyrgyz, that dear people,"},{"id":"manas-2010:p0386:b001:l017","ordinal":17715,"en":"Had reached in their migration."},{"id":"manas-2010:p0386:b001:l018","ordinal":17716,"en":"How could the champions hold back?"},{"id":"manas-2010:p0386:b001:l019","ordinal":17717,"en":"At Tal-Mazar of Kara-Kyr,"},{"id":"manas-2010:p0386:b001:l020","ordinal":17718,"en":"Kutubiy and Jakyp took refuge."},{"id":"manas-2010:p0386:b001:l021","ordinal":17719,"en":"Turning back behind him,"},{"id":"manas-2010:p0386:b001:l022","ordinal":17720,"en":"When he looked intently,"},{"id":"manas-2010:p0386:b001:l023","ordinal":17721,"en":"The Black Kalmyks and Manchus"},{"id":"manas-2010:p0386:b001:l024","ordinal":17722,"en":"Were nowhere to be seen."},{"id":"manas-2010:p0386:b001:l025","ordinal":17723,"en":"The greatest enemy, mighty Zholoy,"},{"id":"manas-2010:p0386:b001:l026","ordinal":17724,"en":"And the vast army he led—"},{"id":"manas-2010:p0386:b001:l027","ordinal":17725,"en":"Their whereabouts were unknown."},{"id":"manas-2010:p0386:b001:l028","ordinal":17726,"en":"Your uncle Akbaltay lamented,"},{"id":"manas-2010:p0386:b001:l029","ordinal":17727,"en":"Pleading with Kutubiy:"},{"id":"manas-2010:p0386:b001:l030","ordinal":17728,"en":"“My darling Kutubiy,"},{"id":"manas-2010:p0386:b001:l031","ordinal":17729,"en":"You kindled my extinguished fire,"},{"id":"manas-2010:p0386:b001:l032","ordinal":17730,"en":"You revived my dead soul,"},{"id":"manas-2010:p0386:b001:l033","ordinal":17731,"en":"You joined what had snapped,"},{"id":"manas-2010:p0386:b001:l034","ordinal":17732,"en":"You gathered what had scattered."},{"id":"manas-2010:p0386:b001:l035","ordinal":17733,"en":"To a boy like you, Kutubiy—"},{"id":"manas-2010:p0386:b001:l036","ordinal":17734,"en":"Your gift of good fortune is true—"},{"id":"manas-2010:p0386:b001:l037","ordinal":17735,"en":"Let ruined Akbaltay"},{"id":"manas-2010:p0386:b001:l038","ordinal":17736,"en":"Be a sacrifice this very moment!"},{"id":"manas-2010:p0386:b001:l039","ordinal":17737,"en":"You are my young warrior, my support."},{"id":"manas-2010:p0386:b001:l040","ordinal":17738,"en":"Created by this very God,"},{"id":"manas-2010:p0386:b001:l041","ordinal":17739,"en":"You and Manas are my lions!"},{"id":"manas-2010:p0386:b001:l042","ordinal":17740,"en":"If my dear life does not end,"},{"id":"manas-2010:p0386:b001:l043","ordinal":17741,"en":"I will send word to my people."},{"id":"manas-2010:p0386:b001:l044","ordinal":17742,"en":"Among my ancient Noygut people,"},{"id":"manas-2010:p0386:b001:l045","ordinal":17743,"en":"As their bringer of good fortune,"},{"id":"manas-2010:p0386:b001:l046","ordinal":17744,"en":"I will raise you as khan!"},{"id":"manas-2010:p0386:b001:l047","ordinal":17745,"en":"At this moment I, Baltay,"},{"id":"manas-2010:p0386:b001:l048","ordinal":17746,"en":"Surge forward as though I cannot die."},{"id":"manas-2010:p0387:b001:l001","ordinal":17747,"en":"Tomorrow, on the Day of Resurrection,"},{"id":"manas-2010:p0387:b001:l002","ordinal":17748,"en":"Kutubiy, who gave me shelter,"},{"id":"manas-2010:p0387:b001:l003","ordinal":17749,"en":"How will I repay my debt to you?"},{"id":"manas-2010:p0387:b001:l004","ordinal":17750,"en":"You are my champion, my support,"},{"id":"manas-2010:p0387:b001:l005","ordinal":17751,"en":"You are my distinguished hero!”"},{"id":"manas-2010:p0387:b001:l006","ordinal":17752,"en":"So saying, Akbaltay"},{"id":"manas-2010:p0387:b001:l007","ordinal":17753,"en":"Rested on his elbow,"},{"id":"manas-2010:p0387:b001:l008","ordinal":17754,"en":"Snatched a little sleep,"},{"id":"manas-2010:p0387:b001:l009","ordinal":17755,"en":"Lay and slept his fill."},{"id":"manas-2010:p0387:b001:l010","ordinal":17756,"en":"When dawn grew bright,"},{"id":"manas-2010:p0387:b001:l011","ordinal":17757,"en":"They let the tulpars graze,"},{"id":"manas-2010:p0387:b001:l012","ordinal":17758,"en":"Leading them about a little,"},{"id":"manas-2010:p0387:b001:l013","ordinal":17759,"en":"Filling their bellies with grass."},{"id":"manas-2010:p0387:b001:l014","ordinal":17760,"en":"When true dawn appeared,"},{"id":"manas-2010:p0387:b001:l015","ordinal":17761,"en":"When daybreak opened,"},{"id":"manas-2010:p0387:b001:l016","ordinal":17762,"en":"Spears swayed like reeds;"},{"id":"manas-2010:p0387:b001:l017","ordinal":17763,"en":"Surging fiercely in undulating masses,"},{"id":"manas-2010:p0387:b001:l018","ordinal":17764,"en":"Making Achbuudan strain forward,"},{"id":"manas-2010:p0387:b001:l019","ordinal":17765,"en":"The raging great Kalmyk Zholoy,"},{"id":"manas-2010:p0387:b001:l020","ordinal":17766,"en":"Laying grass along their bare tracks,"},{"id":"manas-2010:p0387:b001:l021","ordinal":17767,"en":"Had pursued them in a fury."},{"id":"manas-2010:p0387:b001:l022","ordinal":17768,"en":"Laying grass along their yellow tracks,"},{"id":"manas-2010:p0387:b001:l023","ordinal":17769,"en":"He had pursued them doggedly."},{"id":"manas-2010:p0387:b001:l024","ordinal":17770,"en":"Ezkara held the banner."},{"id":"manas-2010:p0387:b001:l025","ordinal":17771,"en":"The earth split, an uproar rose;"},{"id":"manas-2010:p0387:b001:l026","ordinal":17772,"en":"They had fully overtaken them."},{"id":"manas-2010:p0387:b001:l027","ordinal":17773,"en":"Akbaltay saw that army"},{"id":"manas-2010:p0387:b001:l028","ordinal":17774,"en":"And ran to Kutubiy,"},{"id":"manas-2010:p0387:b001:l029","ordinal":17775,"en":"Despairing of his wretched life."},{"id":"manas-2010:p0387:b001:l030","ordinal":17776,"en":"Poor Baltay bellowed,"},{"id":"manas-2010:p0387:b001:l031","ordinal":17777,"en":"Calling Kutubiy:"},{"id":"manas-2010:p0387:b001:l032","ordinal":17778,"en":"“Have you seen what I have seen?"},{"id":"manas-2010:p0387:b001:l033","ordinal":17779,"en":"Have you learned what I have learned?"},{"id":"manas-2010:p0387:b001:l034","ordinal":17780,"en":"A vast dug pit is coming,"},{"id":"manas-2010:p0387:b001:l035","ordinal":17781,"en":"To sacrifice us without escape;"},{"id":"manas-2010:p0387:b001:l036","ordinal":17782,"en":"Boiling brine is coming."},{"id":"manas-2010:p0387:b001:l037","ordinal":17783,"en":"His courage strong, his wrath fierce,"},{"id":"manas-2010:p0387:b001:l038","ordinal":17784,"en":"If provoked he slaughters and levels all."},{"id":"manas-2010:p0387:b001:l039","ordinal":17785,"en":"The Kalmyks' great Zholoy,"},{"id":"manas-2010:p0387:b001:l040","ordinal":17786,"en":"That mighty Zholoy is coming!"},{"id":"manas-2010:p0387:b001:l041","ordinal":17787,"en":"We have suffered Chinese oppression."},{"id":"manas-2010:p0387:b001:l042","ordinal":17788,"en":"Are we about to be slaughtered?"},{"id":"manas-2010:p0387:b001:l043","ordinal":17789,"en":"Humiliation no person should see"},{"id":"manas-2010:p0387:b001:l044","ordinal":17790,"en":"We are going to see today."},{"id":"manas-2010:p0387:b001:l045","ordinal":17791,"en":"Slaughtered, none left alive,"},{"id":"manas-2010:p0387:b001:l046","ordinal":17792,"en":"We are going to die today!”"},{"id":"manas-2010:p0387:b001:l047","ordinal":17793,"en":"Before Akbaltay had finished speaking,"},{"id":"manas-2010:p0387:b001:l048","ordinal":17794,"en":"Before he closed his open mouth,"},{"id":"manas-2010:p0388:b001:l001","ordinal":17795,"en":"Before one could say this or that,"},{"id":"manas-2010:p0388:b001:l002","ordinal":17796,"en":"Before an open eye could close,"},{"id":"manas-2010:p0388:b001:l003","ordinal":17797,"en":"At the shoulder of a gray mountain,"},{"id":"manas-2010:p0388:b001:l004","ordinal":17798,"en":"At the spur of a gray rolling hill,"},{"id":"manas-2010:p0388:b001:l005","ordinal":17799,"en":"The blue-maned leopard Manas"},{"id":"manas-2010:p0388:b001:l006","ordinal":17800,"en":"Met the migrating caravan."},{"id":"manas-2010:p0388:b001:l007","ordinal":17801,"en":"When he looked before him—"},{"id":"manas-2010:p0388:b001:l008","ordinal":17802,"en":"They had quenched the fire they lit,"},{"id":"manas-2010:p0388:b001:l009","ordinal":17803,"en":"Driven the forty households from Altay,"},{"id":"manas-2010:p0388:b001:l010","ordinal":17804,"en":"And moved every one of them away."},{"id":"manas-2010:p0388:b001:l011","ordinal":17805,"en":"When blue-maned Manas looked,"},{"id":"manas-2010:p0388:b001:l012","ordinal":17806,"en":"Wishing that the many were safe,"},{"id":"manas-2010:p0388:b001:l013","ordinal":17807,"en":"All forty households were safe."},{"id":"manas-2010:p0388:b001:l014","ordinal":17808,"en":"His father Jakyp was safe too,"},{"id":"manas-2010:p0388:b001:l015","ordinal":17809,"en":"His countless livestock were safe."},{"id":"manas-2010:p0388:b001:l016","ordinal":17810,"en":"Would they leave without a fight?"},{"id":"manas-2010:p0388:b001:l017","ordinal":17811,"en":"The forty boys he had gathered,"},{"id":"manas-2010:p0388:b001:l018","ordinal":17812,"en":"The best of the forty boys—"},{"id":"manas-2010:p0388:b001:l019","ordinal":17813,"en":"Kutubiy and Kökbörü,"},{"id":"manas-2010:p0388:b001:l020","ordinal":17814,"en":"Atoynok and Alymsok,"},{"id":"manas-2010:p0388:b001:l021","ordinal":17815,"en":"The lion hero's companions."},{"id":"manas-2010:p0388:b001:l022","ordinal":17816,"en":"When he counted the forty boys,"},{"id":"manas-2010:p0388:b001:l023","ordinal":17817,"en":"One did not appear to his eyes."},{"id":"manas-2010:p0388:b001:l024","ordinal":17818,"en":"All those boys were safe,"},{"id":"manas-2010:p0388:b001:l025","ordinal":17819,"en":"But Kutubiy could not be seen."},{"id":"manas-2010:p0388:b001:l026","ordinal":17820,"en":"When he looked over the elders,"},{"id":"manas-2010:p0388:b001:l027","ordinal":17821,"en":"Akbaltay did not appear."},{"id":"manas-2010:p0388:b001:l028","ordinal":17822,"en":"“Akbaltay and Kutu, my intimates,"},{"id":"manas-2010:p0388:b001:l029","ordinal":17823,"en":"Where have these dear ones gone?”"},{"id":"manas-2010:p0388:b001:l030","ordinal":17824,"en":"Manas stood looking."},{"id":"manas-2010:p0388:b001:l031","ordinal":17825,"en":"Making Bozayban sway,"},{"id":"manas-2010:p0388:b001:l032","ordinal":17826,"en":"Before your blood-drinker"},{"id":"manas-2010:p0388:b001:l033","ordinal":17827,"en":"Khan Jakyp came out."},{"id":"manas-2010:p0388:b001:l034","ordinal":17828,"en":"Readying himself like a hawk,"},{"id":"manas-2010:p0388:b001:l035","ordinal":17829,"en":"Rousing himself like a leopard,"},{"id":"manas-2010:p0388:b001:l036","ordinal":17830,"en":"Finding wisdom from the unseen,"},{"id":"manas-2010:p0388:b001:l037","ordinal":17831,"en":"His white beard shining,"},{"id":"manas-2010:p0388:b001:l038","ordinal":17832,"en":"His father Jakyp spoke loudly:"},{"id":"manas-2010:p0388:b001:l039","ordinal":17833,"en":"“Oh, my young one, my river-valley's spring!"},{"id":"manas-2010:p0388:b001:l040","ordinal":17834,"en":"My livestock were many, I had no child."},{"id":"manas-2010:p0388:b001:l041","ordinal":17835,"en":"My dear one, born when I was nearly dead!"},{"id":"manas-2010:p0388:b001:l042","ordinal":17836,"en":"Oh, my young one, Altay was our land too."},{"id":"manas-2010:p0388:b001:l043","ordinal":17837,"en":"In Altay the Black Kalmyks and many Manchus"},{"id":"manas-2010:p0388:b001:l044","ordinal":17838,"en":"Were people living beside us."},{"id":"manas-2010:p0388:b001:l045","ordinal":17839,"en":"In Altay my son was born."},{"id":"manas-2010:p0388:b001:l046","ordinal":17840,"en":"You raised a merciless uproar,"},{"id":"manas-2010:p0388:b001:l047","ordinal":17841,"en":"You thrust your spear and attacked"},{"id":"manas-2010:p0388:b001:l048","ordinal":17842,"en":"My Black Kalmyk people."},{"id":"manas-2010:p0389:b001:l001","ordinal":17843,"en":"When we could rest without fleeing,"},{"id":"manas-2010:p0389:b001:l002","ordinal":17844,"en":"You brought havoc on my people!"},{"id":"manas-2010:p0389:b001:l003","ordinal":17845,"en":"When my livestock would fill the valley,"},{"id":"manas-2010:p0389:b001:l004","ordinal":17846,"en":"When we would settle along Altay,"},{"id":"manas-2010:p0389:b001:l005","ordinal":17847,"en":"You leveled your spear at the Kalmyks!"},{"id":"manas-2010:p0389:b001:l006","ordinal":17848,"en":"You left us as though our fire were quenched!"},{"id":"manas-2010:p0389:b001:l007","ordinal":17849,"en":"Your adversary is Kakan-Chin."},{"id":"manas-2010:p0389:b001:l008","ordinal":17850,"en":"Attacking, you struck at their khan."},{"id":"manas-2010:p0389:b001:l009","ordinal":17851,"en":"What doom have you brought on our heads,"},{"id":"manas-2010:p0389:b001:l010","ordinal":17852,"en":"Entangling us in so much grief!"},{"id":"manas-2010:p0389:b001:l011","ordinal":17853,"en":"I tell you and tell you, you will not yield;"},{"id":"manas-2010:p0389:b001:l012","ordinal":17854,"en":"You will not heed what you are told!"},{"id":"manas-2010:p0389:b001:l013","ordinal":17855,"en":"The Black Chinese and these Manchus"},{"id":"manas-2010:p0389:b001:l014","ordinal":17856,"en":"Unleashed a terrible fury."},{"id":"manas-2010:p0389:b001:l015","ordinal":17857,"en":"When your blue-maned khan forefather died,"},{"id":"manas-2010:p0389:b001:l016","ordinal":17858,"en":"They slaughtered all of you."},{"id":"manas-2010:p0389:b001:l017","ordinal":17859,"en":"They imprisoned the courageous."},{"id":"manas-2010:p0389:b001:l018","ordinal":17860,"en":"When your mighty grandfather died,"},{"id":"manas-2010:p0389:b001:l019","ordinal":17861,"en":"Not a soul remained unslaughtered."},{"id":"manas-2010:p0389:b001:l020","ordinal":17862,"en":"Our heads were carried off to Bapang."},{"id":"manas-2010:p0389:b001:l021","ordinal":17863,"en":"My son Manas, what can you say?"},{"id":"manas-2010:p0389:b001:l022","ordinal":17864,"en":"I burn up in my sorrow!"},{"id":"manas-2010:p0389:b001:l023","ordinal":17865,"en":"One of us went to distant unknown lands,"},{"id":"manas-2010:p0389:b001:l024","ordinal":17866,"en":"One of us fell"},{"id":"manas-2010:p0389:b001:l025","ordinal":17867,"en":"Into a depth from which none returns."},{"id":"manas-2010:p0389:b001:l026","ordinal":17868,"en":"We wandered, straying to Altay."},{"id":"manas-2010:p0389:b001:l027","ordinal":17869,"en":"From those who cared and worried for us"},{"id":"manas-2010:p0389:b001:l028","ordinal":17870,"en":"We all fell away and were parted."},{"id":"manas-2010:p0389:b001:l029","ordinal":17871,"en":"Hands bound behind our backs,"},{"id":"manas-2010:p0389:b001:l030","ordinal":17872,"en":"We wandered, suffering humiliation,"},{"id":"manas-2010:p0389:b001:l031","ordinal":17873,"en":"Driven toward Altay."},{"id":"manas-2010:p0389:b001:l032","ordinal":17874,"en":"We tended Altay and made it our land."},{"id":"manas-2010:p0389:b001:l033","ordinal":17875,"en":"The Black Kalmyks and Manchus"},{"id":"manas-2010:p0389:b001:l034","ordinal":17876,"en":"We made our honored kindred people."},{"id":"manas-2010:p0389:b001:l035","ordinal":17877,"en":"Among the horses I reared, my foal,"},{"id":"manas-2010:p0389:b001:l036","ordinal":17878,"en":"A steed that would not tire."},{"id":"manas-2010:p0389:b001:l037","ordinal":17879,"en":"To many places, messages—"},{"id":"manas-2010:p0389:b001:l038","ordinal":17880,"en":"Though I send them, no news is found"},{"id":"manas-2010:p0389:b001:l039","ordinal":17881,"en":"Of the close kin once together."},{"id":"manas-2010:p0389:b001:l040","ordinal":17882,"en":"‘Your father has settled in Altay,’ I say,"},{"id":"manas-2010:p0389:b001:l041","ordinal":17883,"en":"And pour out my sorrow to God."},{"id":"manas-2010:p0389:b001:l042","ordinal":17884,"en":"‘The kinsmen driven away"},{"id":"manas-2010:p0389:b001:l043","ordinal":17885,"en":"Have been wiped out, root and branch.’"},{"id":"manas-2010:p0389:b001:l044","ordinal":17886,"en":"Yesterday, when you went to your people,"},{"id":"manas-2010:p0389:b001:l045","ordinal":17887,"en":"May God never show that face!"},{"id":"manas-2010:p0389:b001:l046","ordinal":17888,"en":"See the reeds, see the flood,"},{"id":"manas-2010:p0389:b001:l047","ordinal":17889,"en":"See the people surging over us!"},{"id":"manas-2010:p0389:b001:l048","ordinal":17890,"en":"A vast dug pit came,"},{"id":"manas-2010:p0390:b001:l001","ordinal":17891,"en":"Firing guns, drawing bows."},{"id":"manas-2010:p0390:b001:l002","ordinal":17892,"en":"After Esenkan gave his order,"},{"id":"manas-2010:p0390:b001:l003","ordinal":17893,"en":"An overwhelming, countless army came."},{"id":"manas-2010:p0390:b001:l004","ordinal":17894,"en":"God knows who will die;"},{"id":"manas-2010:p0390:b001:l005","ordinal":17895,"en":"God knows who from this place"},{"id":"manas-2010:p0390:b001:l006","ordinal":17896,"en":"Will withdraw alive and safe!"},{"id":"manas-2010:p0390:b001:l007","ordinal":17897,"en":"Seven standard-bearing banners came,"},{"id":"manas-2010:p0390:b001:l008","ordinal":17898,"en":"An earth-splitting uproar came!"},{"id":"manas-2010:p0390:b001:l009","ordinal":17899,"en":"Earth flew into the sky."},{"id":"manas-2010:p0390:b001:l010","ordinal":17900,"en":"May God never show that face!"},{"id":"manas-2010:p0390:b001:l011","ordinal":17901,"en":"The soldiers moved in throngs."},{"id":"manas-2010:p0390:b001:l012","ordinal":17902,"en":"When we saw the vast army,"},{"id":"manas-2010:p0390:b001:l013","ordinal":17903,"en":"We fled and moved, scattered in ruin;"},{"id":"manas-2010:p0390:b001:l014","ordinal":17904,"en":"We despaired of our dear lives!"},{"id":"manas-2010:p0390:b001:l015","ordinal":17905,"en":"The Chinese unleashed their fury."},{"id":"manas-2010:p0390:b001:l016","ordinal":17906,"en":"When they saw the Chinese appearance,"},{"id":"manas-2010:p0390:b001:l017","ordinal":17907,"en":"The forty households gave up not livestock,"},{"id":"manas-2010:p0390:b001:l018","ordinal":17908,"en":"But hope of life itself!"},{"id":"manas-2010:p0390:b001:l019","ordinal":17909,"en":"A flood like black spiders came."},{"id":"manas-2010:p0390:b001:l020","ordinal":17910,"en":"They were no enemy one could provoke;"},{"id":"manas-2010:p0390:b001:l021","ordinal":17911,"en":"An overwhelming people came."},{"id":"manas-2010:p0390:b001:l022","ordinal":17912,"en":"‘They will destroy us all together,’ I thought,"},{"id":"manas-2010:p0390:b001:l023","ordinal":17913,"en":"And despaired of my spent life."},{"id":"manas-2010:p0390:b001:l024","ordinal":17914,"en":"Have we the strength to clash?"},{"id":"manas-2010:p0390:b001:l025","ordinal":17915,"en":"Infidels as numerous as hairs on a cow—"},{"id":"manas-2010:p0390:b001:l026","ordinal":17916,"en":"Can a human confront and defeat them?"},{"id":"manas-2010:p0390:b001:l027","ordinal":17917,"en":"Can one who fights them prevail?"},{"id":"manas-2010:p0390:b001:l028","ordinal":17918,"en":"Against infidels like black spiders,"},{"id":"manas-2010:p0390:b001:l029","ordinal":17919,"en":"Can anyone who provokes them survive?"},{"id":"manas-2010:p0390:b001:l030","ordinal":17920,"en":"Your father's sworn brother Akbaltay,"}]
