{"id":"seytek-2012:p0418:b002:l009","ordinal":327655,"en":"People are waiting,"},{"id":"seytek-2012:p0418:b002:l010","ordinal":327656,"en":"Make a man look like a man,"},{"id":"seytek-2012:p0418:b002:l011","ordinal":327657,"en":"He looked like a mirror,"},{"id":"seytek-2012:p0418:b002:l012","ordinal":327658,"en":"I'm very disappointed with the bastard"},{"id":"seytek-2012:p0418:b002:l013","ordinal":327659,"en":"He gave up on us."},{"id":"seytek-2012:p0418:b002:l014","ordinal":327660,"en":"He opened his mouth to say,"},{"id":"seytek-2012:p0418:b002:l015","ordinal":327661,"en":"He has given up hope on us."},{"id":"seytek-2012:p0418:b002:l016","ordinal":327662,"en":"My heart is burning,"},{"id":"seytek-2012:p0418:b002:l017","ordinal":327663,"en":"I am disappointed with the difference."},{"id":"seytek-2012:p0418:b002:l018","ordinal":327664,"en":"I see a lot, Bakay"},{"id":"seytek-2012:p0418:b002:l019","ordinal":327665,"en":"I will be my husband,"},{"id":"seytek-2012:p0418:b002:l020","ordinal":327666,"en":"I am waiting for the children,\""},{"id":"seytek-2012:p0418:b002:l021","ordinal":327667,"en":"Saying so,"},{"id":"seytek-2012:p0418:b002:l022","ordinal":327668,"en":"When Bakay was speaking"},{"id":"seytek-2012:p0418:b002:l023","ordinal":327669,"en":"He showed his superiority,"},{"id":"seytek-2012:p0418:b002:l024","ordinal":327670,"en":"Black giant wanted to know"},{"id":"seytek-2012:p0418:b002:l025","ordinal":327671,"en":"As pale as death,"},{"id":"seytek-2012:p0418:b002:l026","ordinal":327672,"en":"I cried a lot when I saw Bakay,"},{"id":"seytek-2012:p0418:b002:l027","ordinal":327673,"en":"God's voice was heard:"},{"id":"seytek-2012:p0418:b002:l028","ordinal":327674,"en":"\"Hey, my grandfather is an old man"},{"id":"seytek-2012:p0418:b002:l029","ordinal":327675,"en":"A cruel slave,"},{"id":"seytek-2012:p0418:b002:l030","ordinal":327676,"en":"Hell is found in your life,"},{"id":"seytek-2012:p0418:b002:l031","ordinal":327677,"en":"More than suffering,"},{"id":"seytek-2012:p0418:b002:l032","ordinal":327678,"en":"Soaked in inexorable salt,"},{"id":"seytek-2012:p0418:b002:l033","ordinal":327679,"en":"Bound like a mountain in hell,"},{"id":"seytek-2012:p0418:b002:l034","ordinal":327680,"en":"Excited and sad,"}]
