[{"id":"semetey-1-2013:p0486:b003:l032","ordinal":113921,"en":"The forty Chinese tribes, that dear people—"},{"id":"semetey-1-2013:p0486:b003:l033","ordinal":113922,"en":"He abandoned them all and made them strangers."},{"id":"semetey-1-2013:p0486:b003:l034","ordinal":113923,"en":"Those who witnessed his renown were frightened."},{"id":"semetey-1-2013:p0486:b003:l035","ordinal":113924,"en":"Alas, this world!"},{"id":"semetey-1-2013:p0486:b003:l036","ordinal":113925,"en":"He had studied wondrous spells."},{"id":"semetey-1-2013:p0486:b003:l037","ordinal":113926,"en":"Mist parts before him."},{"id":"semetey-1-2013:p0486:b003:l038","ordinal":113927,"en":"Behind that Bakai"},{"id":"semetey-1-2013:p0486:b003:l039","ordinal":113928,"en":"Dear Almambet can be seen coming."},{"id":"semetey-1-2013:p0486:b004:l001","ordinal":113929,"en":"When I look behind him—"},{"id":"semetey-1-2013:p0486:b004:l002","ordinal":113930,"en":"Piercing cries, shrill battle shouts,"},{"id":"semetey-1-2013:p0486:b004:l003","ordinal":113931,"en":"Mottled clouds, blue storm,"},{"id":"semetey-1-2013:p0486:b004:l004","ordinal":113932,"en":"Rain beneath them,"},{"id":"semetey-1-2013:p0486:b004:l005","ordinal":113933,"en":"Low mist at their farthest edge—"},{"id":"semetey-1-2013:p0486:b004:l006","ordinal":113934,"en":"It is Almambet's weather magic."},{"id":"semetey-1-2013:p0486:b004:l007","ordinal":113935,"en":"Look carefully, Közkaman:"},{"id":"semetey-1-2013:p0486:b004:l008","ordinal":113936,"en":"Among these pursuers"},{"id":"semetey-1-2013:p0486:b004:l009","ordinal":113937,"en":"There is leopard Chubak."},{"id":"semetey-1-2013:p0486:b004:l010","ordinal":113938,"en":"God who strikes will surely strike us."},{"id":"semetey-1-2013:p0486:b004:l011","ordinal":113939,"en":"If Khan Manas grows wrathful,"},{"id":"semetey-1-2013:p0486:b004:l012","ordinal":113940,"en":"Syrgak, son of Ulakan,"},{"id":"semetey-1-2013:p0486:b004:l013","ordinal":113941,"en":"Will batter, crush and slaughter us."},{"id":"semetey-1-2013:p0486:b004:l014","ordinal":113942,"en":"If Bakai reaches us, he will bind us."},{"id":"semetey-1-2013:p0486:b004:l015","ordinal":113943,"en":"Khan Manas's forty zaisans—"},{"id":"semetey-1-2013:p0486:b004:l016","ordinal":113944,"en":"Let the wrestlers gather from Beijing;"},{"id":"semetey-1-2013:p0486:b004:l017","ordinal":113945,"en":"He will drive them off in one sweep!"},{"id":"semetey-1-2013:p0486:b004:l018","ordinal":113946,"en":"He will seize their girls,"},{"id":"semetey-1-2013:p0486:b004:l019","ordinal":113947,"en":"Will bring such a spectacle upon them!"},{"id":"semetey-1-2013:p0486:b004:l020","ordinal":113948,"en":"Cloudy by day, clear by night,"},{"id":"semetey-1-2013:p0486:b004:l021","ordinal":113949,"en":"The weather's temper has been disturbed."},{"id":"semetey-1-2013:p0486:b004:l023","ordinal":113950,"en":"Could an idol strike like this?","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0486:b004:l024","ordinal":113951,"en":"These Kyrgyz will not rest without slaughter;"},{"id":"semetey-1-2013:p0486:b004:l025","ordinal":113952,"en":"They will not stand without doing something."},{"id":"semetey-1-2013:p0486:b004:l026","ordinal":113953,"en":"A pale, mottled flag rises."},{"id":"semetey-1-2013:p0486:b004:l028","ordinal":113954,"en":"A tumult of ‘Woe, woe!’ rises.”","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0486:b004:l029","ordinal":113955,"en":"When Zheldeiboz had spoken,"},{"id":"semetey-1-2013:p0486:b004:l030","ordinal":113956,"en":"When he reached Kökchököz and Közkaman"},{"id":"semetey-1-2013:p0486:b004:l031","ordinal":113957,"en":"And delivered the news,"},{"id":"semetey-1-2013:p0486:b004:l032","ordinal":113958,"en":"Hurrying in excited haste,"},{"id":"semetey-1-2013:p0486:b004:l033","ordinal":113959,"en":"They readied their battle gear."},{"id":"semetey-1-2013:p0486:b004:l034","ordinal":113960,"en":"The swords that came from Beijing"},{"id":"semetey-1-2013:p0486:b004:l035","ordinal":113961,"en":"They drew from their sheaths, preparing."},{"id":"semetey-1-2013:p0486:b004:l036","ordinal":113962,"en":"With battle-axe and firearm,"},{"id":"semetey-1-2013:p0486:b004:l037","ordinal":113963,"en":"Those gray-maned heroes, skilled in their use,"},{"id":"semetey-1-2013:p0486:b004:l038","ordinal":113964,"en":"Made ready all their equipment."},{"id":"semetey-1-2013:p0486:b004:l039","ordinal":113965,"en":"Do not ask about Közkaman,"},{"id":"semetey-1-2013:p0487:b003:l001","ordinal":113966,"en":"A servant skilled among spearmen,"},{"id":"semetey-1-2013:p0487:b003:l002","ordinal":113967,"en":"Who had fought many enemies,"},{"id":"semetey-1-2013:p0487:b003:l003","ordinal":113968,"en":"A mighty servant made expert."},{"id":"semetey-1-2013:p0487:b003:l004","ordinal":113969,"en":"Walking on foot for six years,"},{"id":"semetey-1-2013:p0487:b003:l005","ordinal":113970,"en":"He had greased sixty swords"},{"id":"semetey-1-2013:p0487:b003:l006","ordinal":113971,"en":"And slain those who grappled with him."},{"id":"semetey-1-2013:p0487:b003:l007","ordinal":113972,"en":"Killing sixty giants,"},{"id":"semetey-1-2013:p0487:b003:l008","ordinal":113973,"en":"He had become a renowned master."},{"id":"semetey-1-2013:p0487:b003:l009","ordinal":113974,"en":"Walking without rest for seven years,"},{"id":"semetey-1-2013:p0487:b003:l010","ordinal":113975,"en":"He had readied seventy swords,"},{"id":"semetey-1-2013:p0487:b003:l011","ordinal":113976,"en":"Had slain seventy giants,"},{"id":"semetey-1-2013:p0487:b003:l012","ordinal":113977,"en":"An utterly accomplished sorcerer,"},{"id":"semetey-1-2013:p0487:b003:l013","ordinal":113978,"en":"Fighting wherever he arrived."},{"id":"semetey-1-2013:p0487:b003:l015","ordinal":113979,"en":"Közkaman was unlike other men.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0487:b003:l016","ordinal":113980,"en":"After hearing this news,"},{"id":"semetey-1-2013:p0487:b003:l017","ordinal":113981,"en":"He raged and bellowed,"},{"id":"semetey-1-2013:p0487:b003:l018","ordinal":113982,"en":"Calling to the troops beside him,"},{"id":"semetey-1-2013:p0487:b003:l019","ordinal":113983,"en":"“Make ready!”"},{"id":"semetey-1-2013:p0487:b003:l020","ordinal":113984,"en":"His marksmen who never missed"},{"id":"semetey-1-2013:p0487:b003:l021","ordinal":113985,"en":"He readied all together."},{"id":"semetey-1-2013:p0487:b003:l022","ordinal":113986,"en":"To die in battle,"},{"id":"semetey-1-2013:p0487:b003:l023","ordinal":113987,"en":"He did not stand idly without preparing."},{"id":"semetey-1-2013:p0487:b003:l024","ordinal":113988,"en":"The skilled wielders of battle-axes,"},{"id":"semetey-1-2013:p0487:b003:l025","ordinal":113989,"en":"Those who struck unerringly with swords,"},{"id":"semetey-1-2013:p0487:b003:l026","ordinal":113990,"en":"The ruthless champions—"},{"id":"semetey-1-2013:p0487:b003:l027","ordinal":113991,"en":"One leader for ten men,"},{"id":"semetey-1-2013:p0487:b003:l028","ordinal":113992,"en":"One worthy man for thirty,"},{"id":"semetey-1-2013:p0487:b003:l029","ordinal":113993,"en":"One skilled man for sixty,"},{"id":"semetey-1-2013:p0487:b003:l030","ordinal":113994,"en":"One champion over a hundred—"},{"id":"semetey-1-2013:p0487:b003:l031","ordinal":113995,"en":"He appointed their leaders."},{"id":"semetey-1-2013:p0487:b003:l032","ordinal":113996,"en":"That wrestler Kökchököz"},{"id":"semetey-1-2013:p0487:b003:l033","ordinal":113997,"en":"Did not stand idle for nothing."},{"id":"semetey-1-2013:p0487:b003:l034","ordinal":113998,"en":"When Kökchököz and Közkaman"},{"id":"semetey-1-2013:p0487:b003:l035","ordinal":113999,"en":"Gave their orders in turn,"},{"id":"semetey-1-2013:p0487:b003:l036","ordinal":114000,"en":"The leaders of ten bobbed along,"},{"id":"semetey-1-2013:p0487:b003:l037","ordinal":114001,"en":"Their spears jutting upward."},{"id":"semetey-1-2013:p0487:b003:l038","ordinal":114002,"en":"The leaders of fifty and a hundred"},{"id":"semetey-1-2013:p0487:b003:l039","ordinal":114003,"en":"Fought with their troops."},{"id":"semetey-1-2013:p0487:b004:l001","ordinal":114004,"en":"The spear-points clashed."},{"id":"semetey-1-2013:p0487:b004:l002","ordinal":114005,"en":"Thoroughly prepared and armed,"},{"id":"semetey-1-2013:p0487:b004:l003","ordinal":114006,"en":"Making firm preparations for battle,"},{"id":"semetey-1-2013:p0487:b004:l004","ordinal":114007,"en":"The heroes faced each other."},{"id":"semetey-1-2013:p0487:b004:l005","ordinal":114008,"en":"Renowned Manas and Bakai Khan,"},{"id":"semetey-1-2013:p0487:b004:l006","ordinal":114009,"en":"Over the summit of Kara-Kyr,"},{"id":"semetey-1-2013:p0487:b004:l007","ordinal":114010,"en":"Crossed Kara-Kyr."},{"id":"semetey-1-2013:p0487:b004:l008","ordinal":114011,"en":"That fugitive Közkaman"},{"id":"semetey-1-2013:p0487:b004:l009","ordinal":114012,"en":"Moved into their midst."},{"id":"semetey-1-2013:p0487:b004:l010","ordinal":114013,"en":"See the mist, see the dust;"},{"id":"semetey-1-2013:p0487:b004:l011","ordinal":114014,"en":"See the souls dying face to face."},{"id":"semetey-1-2013:p0487:b004:l012","ordinal":114015,"en":"See the embers burning through the haze;"},{"id":"semetey-1-2013:p0487:b004:l013","ordinal":114016,"en":"See the bullets striking without deflection."},{"id":"semetey-1-2013:p0487:b004:l014","ordinal":114017,"en":"See the rain, see the embers;"},{"id":"semetey-1-2013:p0487:b004:l015","ordinal":114018,"en":"See the bullets striking without a miss."},{"id":"semetey-1-2013:p0487:b004:l016","ordinal":114019,"en":"Khan Manas's forty champions:"},{"id":"semetey-1-2013:p0487:b004:l017","ordinal":114020,"en":"The foremost, Azhybai and Bakai,"},{"id":"semetey-1-2013:p0487:b004:l018","ordinal":114021,"en":"The gray-maned heroes Almambet and Chubak,"},{"id":"semetey-1-2013:p0487:b004:l019","ordinal":114022,"en":"The paired heroes Syrgak and Serek,"},{"id":"semetey-1-2013:p0487:b004:l020","ordinal":114023,"en":"The ocean-like Shuutu the servant and Yrchy."},{"id":"semetey-1-2013:p0487:b004:l021","ordinal":114024,"en":"Kökchököz and Közkaman,"},{"id":"semetey-1-2013:p0487:b004:l022","ordinal":114025,"en":"Skilled wherever they appeared,"},{"id":"semetey-1-2013:p0487:b004:l023","ordinal":114026,"en":"Champions who knew the craft of many enemies,"},{"id":"semetey-1-2013:p0487:b004:l025","ordinal":114027,"en":"Shouted to the wrestlers,"},{"id":"semetey-1-2013:p0487:b004:l026","ordinal":114028,"en":"Called their archers,"},{"id":"semetey-1-2013:p0487:b004:l027","ordinal":114029,"en":"And sent word to their executioners."},{"id":"semetey-1-2013:p0487:b004:l028","ordinal":114030,"en":"Bakai Khan and mighty Manas"},{"id":"semetey-1-2013:p0487:b004:l029","ordinal":114031,"en":"Advanced side by side."},{"id":"semetey-1-2013:p0487:b004:l030","ordinal":114032,"en":"Hear what befell the Chinese!"},{"id":"semetey-1-2013:p0487:b004:l031","ordinal":114033,"en":"Kökchököz and Közkaman,"},{"id":"semetey-1-2013:p0487:b004:l032","ordinal":114034,"en":"Hacking toward those men,"},{"id":"semetey-1-2013:p0487:b004:l033","ordinal":114035,"en":"Without looking about them,"},{"id":"semetey-1-2013:p0487:b004:l034","ordinal":114036,"en":"All entered battle,"},{"id":"semetey-1-2013:p0487:b004:l035","ordinal":114037,"en":"Not sparing their coin-sized lives."},{"id":"semetey-1-2013:p0487:b004:l036","ordinal":114038,"en":"Without looking around,"},{"id":"semetey-1-2013:p0487:b004:l037","ordinal":114039,"en":"The mighty men entered battle,"},{"id":"semetey-1-2013:p0487:b004:l038","ordinal":114040,"en":"Not sparing their hair-thin lives."},{"id":"semetey-1-2013:p0487:b004:l039","ordinal":114041,"en":"Making rain, drawing their bows,"},{"id":"semetey-1-2013:p0488:b003:l001","ordinal":114042,"en":"The Kalmyks, all mighty wrestlers,"},{"id":"semetey-1-2013:p0488:b003:l002","ordinal":114043,"en":"Shot bullets like hail."},{"id":"semetey-1-2013:p0488:b003:l003","ordinal":114044,"en":"Roaring in wrath,"},{"id":"semetey-1-2013:p0488:b003:l004","ordinal":114045,"en":"Shouting ‘Khagan!’ as their battle cry,"},{"id":"semetey-1-2013:p0488:b003:l005","ordinal":114046,"en":"The valiant Közkaman"},{"id":"semetey-1-2013:p0488:b003:l006","ordinal":114047,"en":"Cried out and joined the struggle."},{"id":"semetey-1-2013:p0488:b003:l007","ordinal":114048,"en":"Those Kalmyks in the open steppe"},{"id":"semetey-1-2013:p0488:b003:l008","ordinal":114049,"en":"Fired without cease for six days."},{"id":"semetey-1-2013:p0488:b003:l009","ordinal":114050,"en":"All were renowned champions,"},{"id":"semetey-1-2013:p0488:b003:l010","ordinal":114051,"en":"Chosen men who came from Beijing."},{"id":"semetey-1-2013:p0488:b003:l011","ordinal":114052,"en":"Their appearance unlike other mortals,"},{"id":"semetey-1-2013:p0488:b003:l012","ordinal":114053,"en":"They pressed in, striking at heads,"},{"id":"semetey-1-2013:p0488:b003:l013","ordinal":114054,"en":"Firing without sparing themselves."},{"id":"semetey-1-2013:p0488:b003:l014","ordinal":114055,"en":"The roaring guns,"},{"id":"semetey-1-2013:p0488:b003:l015","ordinal":114056,"en":"Gray haze, red embers,"},{"id":"semetey-1-2013:p0488:b003:l016","ordinal":114057,"en":"Pale-burning, blazing bullets."},{"id":"semetey-1-2013:p0488:b003:l017","ordinal":114058,"en":"They fought without cease for seven days."},{"id":"semetey-1-2013:p0488:b003:l018","ordinal":114059,"en":"Against one another, Muslims"},{"id":"semetey-1-2013:p0488:b003:l019","ordinal":114060,"en":"And unbelievers mingled,"},{"id":"semetey-1-2013:p0488:b003:l020","ordinal":114061,"en":"Stood unable to press through."},{"id":"semetey-1-2013:p0488:b003:l021","ordinal":114062,"en":"Death could not quite reach them."},{"id":"semetey-1-2013:p0488:b003:l022","ordinal":114063,"en":"They fought with battle-axes,"},{"id":"semetey-1-2013:p0488:b003:l023","ordinal":114064,"en":"Unable to mingle in close combat."},{"id":"semetey-1-2013:p0488:b003:l024","ordinal":114065,"en":"Facing each other on opposite sides,"},{"id":"semetey-1-2013:p0488:b003:l025","ordinal":114066,"en":"Unable to reach with spears,"},{"id":"semetey-1-2013:p0488:b003:l026","ordinal":114067,"en":"They fired their guns."},{"id":"semetey-1-2013:p0488:b003:l027","ordinal":114068,"en":"Golden forelock, tasseled belt,"},{"id":"semetey-1-2013:p0488:b003:l028","ordinal":114069,"en":"The only son of Azyz Khan,"},{"id":"semetey-1-2013:p0488:b003:l029","ordinal":114070,"en":"A lion hero made expert,"},{"id":"semetey-1-2013:p0488:b003:l030","ordinal":114071,"en":"Dear Almambet entered without holding back"},{"id":"semetey-1-2013:p0488:b003:l031","ordinal":114072,"en":"And fought with gunfire there."},{"id":"semetey-1-2013:p0488:b003:l032","ordinal":114073,"en":"Battling with the Chinese,"},{"id":"semetey-1-2013:p0488:b003:l033","ordinal":114074,"en":"Had not your Almambet grown up?"},{"id":"semetey-1-2013:p0488:b003:l034","ordinal":114075,"en":"Exchanging fire with the khagan,"},{"id":"semetey-1-2013:p0488:b003:l035","ordinal":114076,"en":"Had not your Almambet grown accustomed?"},{"id":"semetey-1-2013:p0488:b003:l036","ordinal":114077,"en":"Many terrors and disasters—"},{"id":"semetey-1-2013:p0488:b003:l037","ordinal":114078,"en":"Had not your Almambet seen them?"},{"id":"semetey-1-2013:p0488:b003:l038","ordinal":114079,"en":"Syrbarang upon his shoulder,"},{"id":"semetey-1-2013:p0488:b003:l039","ordinal":114080,"en":"Dear Almambet took it up."},{"id":"semetey-1-2013:p0488:b004:l001","ordinal":114081,"en":"Dear Kanykei, your sister-in-law,"},{"id":"semetey-1-2013:p0488:b004:l002","ordinal":114082,"en":"Had carefully and firmly made"},{"id":"semetey-1-2013:p0488:b004:l003","ordinal":114083,"en":"The white saddlebag upon the saddle,"},{"id":"semetey-1-2013:p0488:b004:l004","ordinal":114084,"en":"Its inside full of steel bullets,"},{"id":"semetey-1-2013:p0488:b004:l005","ordinal":114085,"en":"A saddlebag fitted to Sarala."},{"id":"semetey-1-2013:p0488:b004:l006","ordinal":114086,"en":"From Sarala's back"},{"id":"semetey-1-2013:p0488:b004:l007","ordinal":114087,"en":"He took the white saddlebag."},{"id":"semetey-1-2013:p0488:b004:l008","ordinal":114088,"en":"Calling to God in supplication,"},{"id":"semetey-1-2013:p0488:b004:l009","ordinal":114089,"en":"It had nine buttons;"},{"id":"semetey-1-2013:p0488:b004:l010","ordinal":114090,"en":"He undid its buttons."},{"id":"semetey-1-2013:p0488:b004:l011","ordinal":114091,"en":"It had nine clasps;"},{"id":"semetey-1-2013:p0488:b004:l012","ordinal":114092,"en":"He undid its clasps."},{"id":"semetey-1-2013:p0488:b004:l013","ordinal":114093,"en":"The mighty gun Syrbarang"},{"id":"semetey-1-2013:p0488:b004:l014","ordinal":114094,"en":"He scraped with its scraper,"},{"id":"semetey-1-2013:p0488:b004:l015","ordinal":114095,"en":"Striking the end of its stock"},{"id":"semetey-1-2013:p0488:b004:l016","ordinal":114096,"en":"Against a black stone."},{"id":"semetey-1-2013:p0488:b004:l017","ordinal":114097,"en":"He set an ember to its match,"},{"id":"semetey-1-2013:p0488:b004:l018","ordinal":114098,"en":"Two at each loading"},{"id":"semetey-1-2013:p0488:b004:l019","ordinal":114099,"en":"Into Syrbarang,"},{"id":"semetey-1-2013:p0488:b004:l020","ordinal":114100,"en":"Putting in rattling bullets."},{"id":"semetey-1-2013:p0488:b004:l021","ordinal":114101,"en":"They stared hard at each other and fired,"},{"id":"semetey-1-2013:p0488:b004:l022","ordinal":114102,"en":"Enduring hardship in earnest."},{"id":"semetey-1-2013:p0488:b004:l023","ordinal":114103,"en":"A quantity of steel bullets"},{"id":"semetey-1-2013:p0488:b004:l024","ordinal":114104,"en":"Your stalwart Almambet took."},{"id":"semetey-1-2013:p0488:b004:l025","ordinal":114105,"en":"Kökchököz and Közkaman,"},{"id":"semetey-1-2013:p0488:b004:l026","ordinal":114106,"en":"Open executioners, fleet-footed runners—"},{"id":"semetey-1-2013:p0488:b004:l027","ordinal":114107,"en":"Wherever Almambet saw them,"},{"id":"semetey-1-2013:p0488:b004:l028","ordinal":114108,"en":"Joining one report to the next,"},{"id":"semetey-1-2013:p0488:b004:l029","ordinal":114109,"en":"Reddening its mouth like fire,"},{"id":"semetey-1-2013:p0488:b004:l030","ordinal":114110,"en":"Your leopard Almambet"},{"id":"semetey-1-2013:p0488:b004:l031","ordinal":114111,"en":"Brought them under thundering gunfire."},{"id":"semetey-1-2013:p0488:b004:l032","ordinal":114112,"en":"Mist thickened, dust covered everything;"},{"id":"semetey-1-2013:p0488:b004:l033","ordinal":114113,"en":"The earth could no longer be seen."},{"id":"semetey-1-2013:p0488:b004:l034","ordinal":114114,"en":"The Chinese rang out, undaunted."},{"id":"semetey-1-2013:p0488:b004:l035","ordinal":114115,"en":"The shots fired by your mighty Almambet—"},{"id":"semetey-1-2013:p0488:b004:l036","ordinal":114116,"en":"Kökchököz and mighty Közkaman"},{"id":"semetey-1-2013:p0488:b004:l037","ordinal":114117,"en":"Lay down, untroubled."},{"id":"semetey-1-2013:p0488:b004:l038","ordinal":114118,"en":"When bullets struck, all blazing together,"},{"id":"semetey-1-2013:p0488:b004:l039","ordinal":114119,"en":"Only Chinese heroes,"},{"id":"semetey-1-2013:p0489:b003:l001","ordinal":114120,"en":"Taking no account of their circumstances."},{"id":"semetey-1-2013:p0489:b003:l002","ordinal":114121,"en":"Közkaman, a surpassing weather-sorcerer,"},{"id":"semetey-1-2013:p0489:b003:l003","ordinal":114122,"en":"Was raising the wind."},{"id":"semetey-1-2013:p0489:b003:l004","ordinal":114123,"en":"The exceedingly nimble Kökchököz"},{"id":"semetey-1-2013:p0489:b003:l005","ordinal":114124,"en":"Was working his devices."},{"id":"semetey-1-2013:p0489:b003:l006","ordinal":114125,"en":"Their bullets poured like rain."},{"id":"semetey-1-2013:p0489:b003:l007","ordinal":114126,"en":"Among the gray-maned warriors, all wrestlers,"},{"id":"semetey-1-2013:p0489:b003:l008","ordinal":114127,"en":"The weather-magician stood apart."},{"id":"semetey-1-2013:p0489:b003:l009","ordinal":114128,"en":"They aimed at one another,"},{"id":"semetey-1-2013:p0489:b003:l010","ordinal":114129,"en":"Unable to strike exactly."},{"id":"semetey-1-2013:p0489:b003:l011","ordinal":114130,"en":"All were mighty wrestlers and heroes,"},{"id":"semetey-1-2013:p0489:b003:l012","ordinal":114131,"en":"Unable to overcome one another."},{"id":"semetey-1-2013:p0489:b003:l013","ordinal":114132,"en":"Do not ask about Közkaman's nature:"},{"id":"semetey-1-2013:p0489:b003:l014","ordinal":114133,"en":"A foal of Islam,"},{"id":"semetey-1-2013:p0489:b003:l015","ordinal":114134,"en":"That swine of the dark faith"},{"id":"semetey-1-2013:p0489:b003:l016","ordinal":114135,"en":"Was truly a son of the Kyrgyz."},{"id":"semetey-1-2013:p0489:b003:l017","ordinal":114136,"en":"Descended from a mighty house,"},{"id":"semetey-1-2013:p0489:b003:l018","ordinal":114137,"en":"Do not belittle him as an unbeliever;"},{"id":"semetey-1-2013:p0489:b003:l019","ordinal":114138,"en":"He too was of princely stock."},{"id":"semetey-1-2013:p0489:b003:l020","ordinal":114139,"en":"Hero Manas's grandfather,"},{"id":"semetey-1-2013:p0489:b003:l021","ordinal":114140,"en":"Zhakyp Khan's father,"},{"id":"semetey-1-2013:p0489:b003:l022","ordinal":114141,"en":"When the warrior Karakan died,"},{"id":"semetey-1-2013:p0489:b003:l023","ordinal":114142,"en":"Karakan's eight sons—"},{"id":"semetey-1-2013:p0489:b003:l024","ordinal":114143,"en":"Some single-born, some twins."},{"id":"semetey-1-2013:p0489:b003:l025","ordinal":114144,"en":"When their mighty father Karakan died,"},{"id":"semetey-1-2013:p0489:b003:l026","ordinal":114145,"en":"The black khan's eight sons"},{"id":"semetey-1-2013:p0489:b003:l027","ordinal":114146,"en":"Were left young, still crawling,"},{"id":"semetey-1-2013:p0489:b003:l028","ordinal":114147,"en":"All unable to lift their bellies,"},{"id":"semetey-1-2013:p0489:b003:l029","ordinal":114148,"en":"All left dazed and helpless."},{"id":"semetey-1-2013:p0489:b003:l030","ordinal":114149,"en":"Karakan's children"},{"id":"semetey-1-2013:p0489:b003:l031","ordinal":114150,"en":"Were themselves tiny children."},{"id":"semetey-1-2013:p0489:b003:l032","ordinal":114151,"en":"As they struggled to stay alive,"},{"id":"semetey-1-2013:p0489:b003:l033","ordinal":114152,"en":"They led one another by the hand."},{"id":"semetey-1-2013:p0489:b003:l034","ordinal":114153,"en":"Karakan's eight sons,"},{"id":"semetey-1-2013:p0489:b003:l035","ordinal":114154,"en":"When they suffered great sorrow,"},{"id":"semetey-1-2013:p0489:b003:l036","ordinal":114155,"en":"When their khan father died,"},{"id":"semetey-1-2013:p0489:b003:l037","ordinal":114156,"en":"The unbelieving people raged."},{"id":"semetey-1-2013:p0489:b003:l038","ordinal":114157,"en":"Plundering a dead khan's estate—a terrible thing,"},{"id":"semetey-1-2013:p0489:b003:l039","ordinal":114158,"en":"Among the dark Kalmyks and Manchu,"},{"id":"semetey-1-2013:p0489:b005:l002","ordinal":114159,"en":"“This is what happens when a khan dies,” they said,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0489:b005:l003","ordinal":114160,"en":"Robbing the people whose khan had died,"},{"id":"semetey-1-2013:p0489:b005:l004","ordinal":114161,"en":"Making plunder their custom."},{"id":"semetey-1-2013:p0489:b005:l005","ordinal":114162,"en":"The eight sons were driven off in eight directions;"},{"id":"semetey-1-2013:p0489:b005:l006","ordinal":114163,"en":"Where they went, no one knew,"},{"id":"semetey-1-2013:p0489:b005:l007","ordinal":114164,"en":"Their hands bound behind them."},{"id":"semetey-1-2013:p0489:b005:l008","ordinal":114165,"en":"Közkaman who stood exchanging fire—"},{"id":"semetey-1-2013:p0489:b005:l009","ordinal":114166,"en":"His father was Kyrgyz in this way,"},{"id":"semetey-1-2013:p0489:b005:l010","ordinal":114167,"en":"Though his thoughts had turned away."},{"id":"semetey-1-2013:p0489:b005:l011","ordinal":114168,"en":"Karakan and this swine"},{"id":"semetey-1-2013:p0489:b005:l012","ordinal":114169,"en":"Were sons of brothers."},{"id":"semetey-1-2013:p0489:b005:l013","ordinal":114170,"en":"Zhakyp went to the Chinese"},{"id":"semetey-1-2013:p0489:b005:l014","ordinal":114171,"en":"And fathered the lion, leopard Manas."},{"id":"semetey-1-2013:p0489:b005:l015","ordinal":114172,"en":"Orozoi wandered to Beijing."},{"id":"semetey-1-2013:p0489:b005:l016","ordinal":114173,"en":"Orozoi's ten sons,"},{"id":"semetey-1-2013:p0489:b005:l017","ordinal":114174,"en":"Among the dark Kalmyks and Manchu,"},{"id":"semetey-1-2013:p0489:b005:l018","ordinal":114175,"en":"Saying the idol was God,"},{"id":"semetey-1-2013:p0489:b005:l019","ordinal":114176,"en":"Thus found a faith in darkness."}]
