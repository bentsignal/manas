[{"id":"manas-2010:p0337:b001:l003","ordinal":15361,"en":"I searched to their farthest depths,' they said."},{"id":"manas-2010:p0337:b001:l004","ordinal":15362,"en":"Those sorcerers, so seemingly upright—"},{"id":"manas-2010:p0337:b001:l005","ordinal":15363,"en":"Their lies burn me!"},{"id":"manas-2010:p0337:b001:l006","ordinal":15364,"en":"Born here in Altay,"},{"id":"manas-2010:p0337:b001:l007","ordinal":15365,"en":"The son of Jakyp with his countless livestock,"},{"id":"manas-2010:p0337:b001:l008","ordinal":15366,"en":"They failed to see him."},{"id":"manas-2010:p0337:b001:l009","ordinal":15367,"en":"Take note of this:"},{"id":"manas-2010:p0337:b001:l010","ordinal":15368,"en":"They have plunged us into calamity!"},{"id":"manas-2010:p0337:b001:l011","ordinal":15369,"en":"'This one is named Manas,' they said;"},{"id":"manas-2010:p0337:b001:l012","ordinal":15370,"en":"Someone from Samarkand"},{"id":"manas-2010:p0337:b001:l013","ordinal":15371,"en":"The sorcerers drove here."},{"id":"manas-2010:p0337:b001:l014","ordinal":15372,"en":"'This is the true enemy,' they said;"},{"id":"manas-2010:p0337:b001:l015","ordinal":15373,"en":"To the khan of Chynmachyn,"},{"id":"manas-2010:p0337:b001:l016","ordinal":15374,"en":"They drove him and delivered him."},{"id":"manas-2010:p0337:b001:l017","ordinal":15375,"en":"That Burut Jakyp over there,"},{"id":"manas-2010:p0337:b001:l018","ordinal":15376,"en":"They had merely passed beside him!"},{"id":"manas-2010:p0337:b001:l019","ordinal":15377,"en":"'We found Manas among the Burut,' they said;"},{"id":"manas-2010:p0337:b001:l020","ordinal":15378,"en":"They came deceiving us!"},{"id":"manas-2010:p0337:b001:l021","ordinal":15379,"en":"Incapable of any feat,"},{"id":"manas-2010:p0337:b001:l022","ordinal":15380,"en":"They brought a coward here."},{"id":"manas-2010:p0337:b001:l023","ordinal":15381,"en":"Knowing nothing of combat,"},{"id":"manas-2010:p0337:b001:l024","ordinal":15382,"en":"They brought a calf here!"},{"id":"manas-2010:p0337:b001:l025","ordinal":15383,"en":"Able only to drink and empty bowls,"},{"id":"manas-2010:p0337:b001:l026","ordinal":15384,"en":"They brought that wretch here!"},{"id":"manas-2010:p0337:b001:l027","ordinal":15385,"en":"Incapable of doing anything,"},{"id":"manas-2010:p0337:b001:l028","ordinal":15386,"en":"They brought a miserable creature here."},{"id":"manas-2010:p0337:b001:l029","ordinal":15387,"en":"Bulging like a sack stuffed full,"},{"id":"manas-2010:p0337:b001:l030","ordinal":15388,"en":"They brought their straw here!"},{"id":"manas-2010:p0337:b001:l031","ordinal":15389,"en":"With feet like an animal's,"},{"id":"manas-2010:p0337:b001:l032","ordinal":15390,"en":"They brought a worthless creature here!"},{"id":"manas-2010:p0337:b001:l033","ordinal":15391,"en":"The sorcerers' words,"},{"id":"manas-2010:p0337:b001:l034","ordinal":15392,"en":"I truly trusted without taking control;"},{"id":"manas-2010:p0337:b001:l035","ordinal":15393,"en":"My eyes were blinded and did not see."},{"id":"manas-2010:p0337:b001:l036","ordinal":15394,"en":"I had been caught unawares!"},{"id":"manas-2010:p0337:b001:l037","ordinal":15395,"en":"Drinking a brew more bitter than liquor,"},{"id":"manas-2010:p0337:b001:l038","ordinal":15396,"en":"Drinking away my wits along with it,"},{"id":"manas-2010:p0337:b001:l039","ordinal":15397,"en":"I had been caught unawares!"},{"id":"manas-2010:p0337:b001:l040","ordinal":15398,"en":"Manas arose from Beejin,"},{"id":"manas-2010:p0337:b001:l041","ordinal":15399,"en":"My own seers failed to see him,"},{"id":"manas-2010:p0337:b001:l042","ordinal":15400,"en":"And I lie here in distress!"},{"id":"manas-2010:p0337:b001:l043","ordinal":15401,"en":"Trusting the sorcerers too much,"},{"id":"manas-2010:p0337:b001:l044","ordinal":15402,"en":"I, the damned Esenkan,"},{"id":"manas-2010:p0337:b001:l045","ordinal":15403,"en":"Have had my beard shorn!"},{"id":"manas-2010:p0337:b001:l046","ordinal":15404,"en":"He is the hero Manas of the Burut;"},{"id":"manas-2010:p0337:b001:l047","ordinal":15405,"en":"Not only the Kytay, but all peoples,"},{"id":"manas-2010:p0337:b001:l048","ordinal":15406,"en":"He is the lion who will slaughter them!"},{"id":"manas-2010:p0338:b001:l001","ordinal":15407,"en":"Our strength cannot match him in combat;"},{"id":"manas-2010:p0338:b001:l002","ordinal":15408,"en":"That damned bloodstained one,"},{"id":"manas-2010:p0338:b001:l003","ordinal":15409,"en":"Even a lion's teeth cannot pierce him!"},{"id":"manas-2010:p0338:b001:l004","ordinal":15410,"en":"He was born in Altay and grew great."},{"id":"manas-2010:p0338:b001:l005","ordinal":15411,"en":"No one who exchanges shots with him fares well;"},{"id":"manas-2010:p0338:b001:l006","ordinal":15412,"en":"No one who grapples with him remains unharmed!"},{"id":"manas-2010:p0338:b001:l007","ordinal":15413,"en":"His valor was known;"},{"id":"manas-2010:p0338:b001:l008","ordinal":15414,"en":"Of Beejin, where no cold-hearted one comes,"},{"id":"manas-2010:p0338:b001:l009","ordinal":15415,"en":"'He will seize its authority,' it said."},{"id":"manas-2010:p0338:b001:l010","ordinal":15416,"en":"Before that bloodstained one was born,"},{"id":"manas-2010:p0338:b001:l011","ordinal":15417,"en":"In this very Beejin's"},{"id":"manas-2010:p0338:b001:l012","ordinal":15418,"en":"Register it was inscribed!"},{"id":"manas-2010:p0338:b001:l013","ordinal":15419,"en":"He will turn white deer into cattle;"},{"id":"manas-2010:p0338:b001:l014","ordinal":15420,"en":"Those who fight him, that bloodstained one"},{"id":"manas-2010:p0338:b001:l015","ordinal":15421,"en":"Will drive before him in terror."},{"id":"manas-2010:p0338:b001:l016","ordinal":15422,"en":"He will take Ala-Too as his homeland;"},{"id":"manas-2010:p0338:b001:l017","ordinal":15423,"en":"The scattered, impoverished Kyrgyz"},{"id":"manas-2010:p0338:b001:l018","ordinal":15424,"en":"He will gather and make a people!"},{"id":"manas-2010:p0338:b001:l019","ordinal":15425,"en":"He will gather forty companions and become khan."},{"id":"manas-2010:p0338:b001:l020","ordinal":15426,"en":"If that Burut escapes alive,"},{"id":"manas-2010:p0338:b001:l021","ordinal":15427,"en":"The mortals he crushes will become his bread;"},{"id":"manas-2010:p0338:b001:l022","ordinal":15428,"en":"Whoever grapples with him will be slain!"},{"id":"manas-2010:p0338:b001:l023","ordinal":15429,"en":"This very Beejin,"},{"id":"manas-2010:p0338:b001:l024","ordinal":15430,"en":"He will trample into loose wool."},{"id":"manas-2010:p0338:b001:l025","ordinal":15431,"en":"He will unleash fierce, unrelenting wrath;"},{"id":"manas-2010:p0338:b001:l026","ordinal":15432,"en":"The Kytay will fail to defeat him in combat."},{"id":"manas-2010:p0338:b001:l027","ordinal":15433,"en":"Of Kakanchyn, of Beejin,"},{"id":"manas-2010:p0338:b001:l028","ordinal":15434,"en":"He will seize the khanship!"},{"id":"manas-2010:p0338:b001:l029","ordinal":15435,"en":"No mortal can face him and win."},{"id":"manas-2010:p0338:b001:l030","ordinal":15436,"en":"Not only the Kytay people of Beejin—"},{"id":"manas-2010:p0338:b001:l031","ordinal":15437,"en":"Against that damned bloodstained one,"},{"id":"manas-2010:p0338:b001:l032","ordinal":15438,"en":"All peoples' strength will not suffice!"},{"id":"manas-2010:p0338:b001:l033","ordinal":15439,"en":"If he escapes safely to his people,"},{"id":"manas-2010:p0338:b001:l034","ordinal":15440,"en":"Say farewell to your livestock;"},{"id":"manas-2010:p0338:b001:l035","ordinal":15441,"en":"Despair of your life!"},{"id":"manas-2010:p0338:b001:l036","ordinal":15442,"en":"He who will wreak terrible slaughter—"},{"id":"manas-2010:p0338:b001:l037","ordinal":15443,"en":"Watch that Burut!"},{"id":"manas-2010:p0338:b001:l038","ordinal":15444,"en":"He will seize your khanship!"},{"id":"manas-2010:p0338:b001:l039","ordinal":15445,"en":"If the hero Manas escapes today,"},{"id":"manas-2010:p0338:b001:l040","ordinal":15446,"en":"He will return to raid your livestock."},{"id":"manas-2010:p0338:b001:l041","ordinal":15447,"en":"Do not dismiss my words:"},{"id":"manas-2010:p0338:b001:l042","ordinal":15448,"en":"He will spill your blood like water!"},{"id":"manas-2010:p0338:b001:l043","ordinal":15449,"en":"Punishing and pounding you,"},{"id":"manas-2010:p0338:b001:l044","ordinal":15450,"en":"He will thus make you taste your salt."},{"id":"manas-2010:p0338:b001:l045","ordinal":15451,"en":"He will take as booty—just watch—"},{"id":"manas-2010:p0338:b001:l046","ordinal":15452,"en":"Your thimble-mouthed, camel-eyed,"},{"id":"manas-2010:p0338:b001:l047","ordinal":15453,"en":"Swaying daughter!"},{"id":"manas-2010:p0338:b001:l048","ordinal":15454,"en":"He will lay Beejin waste,"},{"id":"manas-2010:p0339:b001:l001","ordinal":15455,"en":"He will slaughter your people all the more!"},{"id":"manas-2010:p0339:b001:l002","ordinal":15456,"en":"He will turn the black road to dust;"},{"id":"manas-2010:p0339:b001:l003","ordinal":15457,"en":"He will bloody the gate's mouth!"},{"id":"manas-2010:p0339:b001:l004","ordinal":15458,"en":"All who attack him,"},{"id":"manas-2010:p0339:b001:l005","ordinal":15459,"en":"He will drink their blood and make them bread!"},{"id":"manas-2010:p0339:b001:l006","ordinal":15460,"en":"Heed what I say."},{"id":"manas-2010:p0339:b001:l007","ordinal":15461,"en":"If that Burut escapes alive,"},{"id":"manas-2010:p0339:b001:l008","ordinal":15462,"en":"He will cast aside your idol;"},{"id":"manas-2010:p0339:b001:l009","ordinal":15463,"en":"He will smash your people to powder."},{"id":"manas-2010:p0339:b001:l010","ordinal":15464,"en":"You will see it in this Beejin!"},{"id":"manas-2010:p0339:b001:l011","ordinal":15465,"en":"Your father's grave, deceitful world!"},{"id":"manas-2010:p0339:b001:l012","ordinal":15466,"en":"Rejoicing, 'I am khan,'"},{"id":"manas-2010:p0339:b001:l013","ordinal":15467,"en":"I have brought disaster upon myself."},{"id":"manas-2010:p0339:b001:l014","ordinal":15468,"en":"When the sign came, I took no control;"},{"id":"manas-2010:p0339:b001:l015","ordinal":15469,"en":"I had been blind!"},{"id":"manas-2010:p0339:b001:l016","ordinal":15470,"en":"Drinking sour, mind-clouding brew,"},{"id":"manas-2010:p0339:b001:l017","ordinal":15471,"en":"Drinking away my wits along with it,"},{"id":"manas-2010:p0339:b001:l018","ordinal":15472,"en":"I have brought disaster upon myself!"},{"id":"manas-2010:p0339:b001:l019","ordinal":15473,"en":"That damned Burut's"},{"id":"manas-2010:p0339:b001:l020","ordinal":15474,"en":"Birth I knew about."},{"id":"manas-2010:p0339:b001:l021","ordinal":15475,"en":"'Upon upper Kakan-Chynmachyn"},{"id":"manas-2010:p0339:b001:l022","ordinal":15476,"en":"He will bring fire,' I kept saying!"},{"id":"manas-2010:p0339:b001:l023","ordinal":15477,"en":"A dragon entered my dream;"},{"id":"manas-2010:p0339:b001:l024","ordinal":15478,"en":"It swept up and devoured"},{"id":"manas-2010:p0339:b001:l025","ordinal":15479,"en":"Chynmachyn and Bakburchun;"},{"id":"manas-2010:p0339:b001:l026","ordinal":15480,"en":"Kakan-Kakanchyn itself,"},{"id":"manas-2010:p0339:b001:l027","ordinal":15481,"en":"It sucked in with its breath."},{"id":"manas-2010:p0339:b001:l028","ordinal":15482,"en":"Beating with its tail,"},{"id":"manas-2010:p0339:b001:l029","ordinal":15483,"en":"It slaughtered the people!"},{"id":"manas-2010:p0339:b001:l030","ordinal":15484,"en":"I saw this dream;"},{"id":"manas-2010:p0339:b001:l031","ordinal":15485,"en":"Utterly despairing of my life,"},{"id":"manas-2010:p0339:b001:l032","ordinal":15486,"en":"At the sight, I died of fright!"},{"id":"manas-2010:p0339:b001:l033","ordinal":15487,"en":"While I was seeing the dream,"},{"id":"manas-2010:p0339:b001:l034","ordinal":15488,"en":"I woke startled from sleep;"},{"id":"manas-2010:p0339:b001:l035","ordinal":15489,"en":"I turned onto my right side!"},{"id":"manas-2010:p0339:b001:l036","ordinal":15490,"en":"My collarbones throbbed;"},{"id":"manas-2010:p0339:b001:l037","ordinal":15491,"en":"My bowels would not stop,"},{"id":"manas-2010:p0339:b001:l038","ordinal":15492,"en":"They kept on shaking!"},{"id":"manas-2010:p0339:b001:l039","ordinal":15493,"en":"My ribs were utterly shattered;"},{"id":"manas-2010:p0339:b001:l040","ordinal":15494,"en":"As though about to burst through my body,"},{"id":"manas-2010:p0339:b001:l041","ordinal":15495,"en":"My heart bucked like a horse!"},{"id":"manas-2010:p0339:b001:l042","ordinal":15496,"en":"I leaped from sleep and ran."},{"id":"manas-2010:p0339:b001:l043","ordinal":15497,"en":"When I went outside and looked,"},{"id":"manas-2010:p0339:b001:l044","ordinal":15498,"en":"Wishing my people to be safe,"},{"id":"manas-2010:p0339:b001:l045","ordinal":15499,"en":"The clouds broke in the sky;"},{"id":"manas-2010:p0339:b001:l046","ordinal":15500,"en":"Six-grooved hail poured down;"},{"id":"manas-2010:p0339:b001:l047","ordinal":15501,"en":"Wind roared from mountain to mountain,"},{"id":"manas-2010:p0339:b001:l048","ordinal":15502,"en":"Scattering across the sky,"},{"id":"manas-2010:p0340:b001:l001","ordinal":15503,"en":"Dark rain thundered down."},{"id":"manas-2010:p0340:b001:l002","ordinal":15504,"en":"Day and night for eighty days,"},{"id":"manas-2010:p0340:b001:l003","ordinal":15505,"en":"The rain kept falling."},{"id":"manas-2010:p0340:b001:l004","ordinal":15506,"en":"Among the people of Kakanchyn,"},{"id":"manas-2010:p0340:b001:l005","ordinal":15507,"en":"An earthquake swept through."},{"id":"manas-2010:p0340:b001:l006","ordinal":15508,"en":"It proved to be that very portent:"},{"id":"manas-2010:p0340:b001:l007","ordinal":15509,"en":"Born upon the earth,"},{"id":"manas-2010:p0340:b001:l008","ordinal":15510,"en":"That monster-like Burut"},{"id":"manas-2010:p0340:b001:l009","ordinal":15511,"en":"Was then coming into the world."},{"id":"manas-2010:p0340:b001:l010","ordinal":15512,"en":"It was that one accursed to burn!"},{"id":"manas-2010:p0340:b001:l011","ordinal":15513,"en":"The earthquake that shook Beejin"},{"id":"manas-2010:p0340:b001:l012","ordinal":15514,"en":"Said, 'Manas, the bringer of trouble, is born!'"},{"id":"manas-2010:p0340:b001:l013","ordinal":15515,"en":"It was giving me a sign!"},{"id":"manas-2010:p0340:b001:l014","ordinal":15516,"en":"The next day, early in the morning,"},{"id":"manas-2010:p0340:b001:l015","ordinal":15517,"en":"When true dawn broke,"},{"id":"manas-2010:p0340:b001:l016","ordinal":15518,"en":"When daybreak shone clear,"},{"id":"manas-2010:p0340:b001:l017","ordinal":15519,"en":"The steel-doored gate"},{"id":"manas-2010:p0340:b001:l018","ordinal":15520,"en":"Was drawn open with a roar."},{"id":"manas-2010:p0340:b001:l019","ordinal":15521,"en":"The governors fired cannon;"},{"id":"manas-2010:p0340:b001:l020","ordinal":15522,"en":"Living creatures stirred"},{"id":"manas-2010:p0340:b001:l021","ordinal":15523,"en":"And rose from their lairs."},{"id":"manas-2010:p0340:b001:l022","ordinal":15524,"en":"When I leaped up and looked,"},{"id":"manas-2010:p0340:b001:l023","ordinal":15525,"en":"The great register of wonders,"},{"id":"manas-2010:p0340:b001:l024","ordinal":15526,"en":"The great book of sixty leaves,"},{"id":"manas-2010:p0340:b001:l025","ordinal":15527,"en":"I took it up and examined it."},{"id":"manas-2010:p0340:b001:l026","ordinal":15528,"en":"Known at his birth,"},{"id":"manas-2010:p0340:b001:l027","ordinal":15529,"en":"That very bloodstained Manas's"},{"id":"manas-2010:p0340:b001:l028","ordinal":15530,"en":"Enmity had been inscribed!"},{"id":"manas-2010:p0340:b001:l029","ordinal":15531,"en":"His ear tips pierced,"},{"id":"manas-2010:p0340:b001:l030","ordinal":15532,"en":"His foreskin cut:"},{"id":"manas-2010:p0340:b001:l031","ordinal":15533,"en":"'The mad one was born in Beejin;"},{"id":"manas-2010:p0340:b001:l032","ordinal":15534,"en":"He will slaughter your people."},{"id":"manas-2010:p0340:b001:l033","ordinal":15535,"en":"His name is Manas—a lion, a mighty lion,"},{"id":"manas-2010:p0340:b001:l034","ordinal":15536,"en":"Youngest of the six lions,"},{"id":"manas-2010:p0340:b001:l035","ordinal":15537,"en":"God's beloved servant."},{"id":"manas-2010:p0340:b001:l036","ordinal":15538,"en":"No strength can match him in combat;"},{"id":"manas-2010:p0340:b001:l037","ordinal":15539,"en":"No mortal can defeat him in struggle."},{"id":"manas-2010:p0340:b001:l038","ordinal":15540,"en":"His opponent will be Kakanchyn;"},{"id":"manas-2010:p0340:b001:l039","ordinal":15541,"en":"Will he refrain from battle?'"},{"id":"manas-2010:p0340:b001:l040","ordinal":15542,"en":"I began with terrible wrath."},{"id":"manas-2010:p0340:b001:l041","ordinal":15543,"en":"His forefather was Khan Tügöl;"},{"id":"manas-2010:p0340:b001:l042","ordinal":15544,"en":"I slaughtered them without exception."},{"id":"manas-2010:p0340:b001:l043","ordinal":15545,"en":"I went among the Burut and fired upon them;"},{"id":"manas-2010:p0340:b001:l044","ordinal":15546,"en":"I destroyed his seven forefathers,"},{"id":"manas-2010:p0340:b001:l045","ordinal":15547,"en":"Drove off the living and wiped them out."},{"id":"manas-2010:p0340:b001:l046","ordinal":15548,"en":"Of the Burut who came wandering,"},{"id":"manas-2010:p0340:b001:l047","ordinal":15549,"en":"His distant forefather had been slain."},{"id":"manas-2010:p0340:b001:l048","ordinal":15550,"en":"Then, sowing grain,"},{"id":"manas-2010:p0341:b001:l001","ordinal":15551,"en":"His father Jakyp, that Burut,"},{"id":"manas-2010:p0341:b001:l002","ordinal":15552,"en":"Raised countless livestock and grew wealthy."},{"id":"manas-2010:p0341:b001:l003","ordinal":15553,"en":"He had abundant livestock but no child;"},{"id":"manas-2010:p0341:b001:l004","ordinal":15554,"en":"Lamenting, 'I have no child,'"},{"id":"manas-2010:p0341:b001:l005","ordinal":15555,"en":"He suffered such torment."},{"id":"manas-2010:p0341:b001:l006","ordinal":15556,"en":"At exactly fifty-five years of age,"},{"id":"manas-2010:p0341:b001:l007","ordinal":15557,"en":"He saw Khan Manas born."},{"id":"manas-2010:p0341:b001:l008","ordinal":15558,"en":"From a gray sheep with yellow temples,"},{"id":"manas-2010:p0341:b001:l009","ordinal":15559,"en":"A yellow ram, a mighty wether, was born."},{"id":"manas-2010:p0341:b001:l010","ordinal":15560,"en":"The dark, gray-maned leopard,"},{"id":"manas-2010:p0341:b001:l011","ordinal":15561,"en":"Bloodstained Manas himself,"},{"id":"manas-2010:p0341:b001:l012","ordinal":15562,"en":"Was born upright on his feet."},{"id":"manas-2010:p0341:b001:l013","ordinal":15563,"en":"The flame that stood apart,"},{"id":"manas-2010:p0341:b001:l014","ordinal":15564,"en":"Twelve old women saw it."},{"id":"manas-2010:p0341:b001:l015","ordinal":15565,"en":"At the sight, their strength failed;"},{"id":"manas-2010:p0341:b001:l016","ordinal":15566,"en":"Their hearts sank and they died."},{"id":"manas-2010:p0341:b001:l017","ordinal":15567,"en":"The black Kalmyks and Manchus'"},{"id":"manas-2010:p0341:b001:l018","ordinal":15568,"en":"Possessions were scattered."},{"id":"manas-2010:p0341:b001:l019","ordinal":15569,"en":"'A monster child is born,' they said,"},{"id":"manas-2010:p0341:b001:l020","ordinal":15570,"en":"And fled in every direction."},{"id":"manas-2010:p0341:b001:l021","ordinal":15571,"en":"Roaring at his birth,"},{"id":"manas-2010:p0341:b001:l022","ordinal":15572,"en":"He came into this world."},{"id":"manas-2010:p0341:b001:l023","ordinal":15573,"en":"Shouting the battle cry 'Islam!'"},{"id":"manas-2010:p0341:b001:l024","ordinal":15574,"en":"All those who saw him"},{"id":"manas-2010:p0341:b001:l025","ordinal":15575,"en":"Were filled with dismay."},{"id":"manas-2010:p0341:b001:l026","ordinal":15576,"en":"Looking at each part of his body,"},{"id":"manas-2010:p0341:b001:l027","ordinal":15577,"en":"His signs were like a prophet's."},{"id":"manas-2010:p0341:b001:l028","ordinal":15578,"en":"Dark blood in his right hand,"},{"id":"manas-2010:p0341:b001:l029","ordinal":15579,"en":"He grasped it and scattered it."},{"id":"manas-2010:p0341:b001:l030","ordinal":15580,"en":"Water covered the earth;"},{"id":"manas-2010:p0341:b001:l031","ordinal":15581,"en":"As though the Deluge had come,"},{"id":"manas-2010:p0341:b001:l032","ordinal":15582,"en":"An earthquake overwhelmed it."},{"id":"manas-2010:p0341:b001:l033","ordinal":15583,"en":"Abundant livestock, but no child—"},{"id":"manas-2010:p0341:b001:l034","ordinal":15584,"en":"That Jakyp was pitiful."},{"id":"manas-2010:p0341:b001:l035","ordinal":15585,"en":"At exactly fifty-five,"},{"id":"manas-2010:p0341:b001:l036","ordinal":15586,"en":"He had finally had a child."},{"id":"manas-2010:p0341:b001:l037","ordinal":15587,"en":"That Jakyp, that cunning Burut,"},{"id":"manas-2010:p0341:b001:l038","ordinal":15588,"en":"The countless livestock he had raised,"},{"id":"manas-2010:p0341:b001:l039","ordinal":15589,"en":"He spent and scattered."},{"id":"manas-2010:p0341:b001:l040","ordinal":15590,"en":"From twelve thousand barren mares,"},{"id":"manas-2010:p0341:b001:l041","ordinal":15591,"en":"He caught horses and slaughtered them."},{"id":"manas-2010:p0341:b001:l042","ordinal":15592,"en":"That wandering, wretched Burut"},{"id":"manas-2010:p0341:b001:l043","ordinal":15593,"en":"Had ceased his grieving."},{"id":"manas-2010:p0341:b001:l044","ordinal":15594,"en":"For everyone who came,"},{"id":"manas-2010:p0341:b001:l045","ordinal":15595,"en":"He slaughtered livestock like an emperor."},{"id":"manas-2010:p0341:b001:l046","ordinal":15596,"en":"Every soul who went there,"},{"id":"manas-2010:p0341:b001:l047","ordinal":15597,"en":"Without exception, ate their fill."},{"id":"manas-2010:p0341:b001:l048","ordinal":15598,"en":"Cunning Jakyp had acted craftily;"},{"id":"manas-2010:p0342:b001:l001","ordinal":15599,"en":"This Jakyp had gone wild."},{"id":"manas-2010:p0342:b001:l002","ordinal":15600,"en":"The many Manchus who attended his feast"},{"id":"manas-2010:p0342:b001:l003","ordinal":15601,"en":"Were all fed to the full at last."},{"id":"manas-2010:p0342:b001:l004","ordinal":15602,"en":"'My son's name is Madman,' he said,"},{"id":"manas-2010:p0342:b001:l005","ordinal":15603,"en":"And deceived the Kytay people."},{"id":"manas-2010:p0342:b001:l006","ordinal":15604,"en":"He slaughtered livestock like an emperor,"},{"id":"manas-2010:p0342:b001:l007","ordinal":15605,"en":"That reckless Jakyp, that Burut."},{"id":"manas-2010:p0342:b001:l008","ordinal":15606,"en":"His son's name was Great Madman;"},{"id":"manas-2010:p0342:b001:l009","ordinal":15607,"en":"That Burut—may his house burn!—"},{"id":"manas-2010:p0342:b001:l010","ordinal":15608,"en":"Who knew of this trouble of his?"},{"id":"manas-2010:p0342:b001:l011","ordinal":15609,"en":"'My child is forty days old,' he said;"},{"id":"manas-2010:p0342:b001:l012","ordinal":15610,"en":"He slaughtered eight thousand barren mares,"},{"id":"manas-2010:p0342:b001:l013","ordinal":15611,"en":"Let his possessions be plundered,"},{"id":"manas-2010:p0342:b001:l014","ordinal":15612,"en":"Left his great wealth open to all,"},{"id":"manas-2010:p0342:b001:l015","ordinal":15613,"en":"And slaughtered livestock on Beejin's scale."},{"id":"manas-2010:p0342:b001:l016","ordinal":15614,"en":"Cunning Jakyp, black of intent,"},{"id":"manas-2010:p0342:b001:l017","ordinal":15615,"en":"Had broad cooking trenches dug."},{"id":"manas-2010:p0342:b001:l018","ordinal":15616,"en":"Everyone who came,"}]
