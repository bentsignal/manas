[{"id":"semetey-1-2013:p0557:b003:l026","ordinal":119297,"en":"Finding no enemy to fight,"},{"id":"semetey-1-2013:p0557:b003:l027","ordinal":119298,"en":"Finding no stone to bite,"},{"id":"semetey-1-2013:p0557:b003:l029","ordinal":119299,"en":"Finding no embers burning in a tower,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0557:b003:l030","ordinal":119300,"en":"Finding no shot that would strike unbroken,"},{"id":"semetey-1-2013:p0557:b003:l031","ordinal":119301,"en":"Sarala opened his mouth."},{"id":"semetey-1-2013:p0557:b003:l032","ordinal":119302,"en":"May I be his sacrifice!"},{"id":"semetey-1-2013:p0557:b003:l033","ordinal":119303,"en":"To Alööke's Konurbai"},{"id":"semetey-1-2013:p0557:b003:l034","ordinal":119304,"en":"He went to pick a quarrel."},{"id":"semetey-1-2013:p0557:b003:l035","ordinal":119305,"en":"When his age reached twelve,"},{"id":"semetey-1-2013:p0557:b003:l036","ordinal":119306,"en":"He brought havoc."},{"id":"semetey-1-2013:p0557:b003:l037","ordinal":119307,"en":"Alake's banner fluttering in his hand,"},{"id":"semetey-1-2013:p0557:b003:l038","ordinal":119308,"en":"Zulpukor the sword, and all his arms,"},{"id":"semetey-1-2013:p0557:b003:l039","ordinal":119309,"en":"Gleaming each in its place,"},{"id":"semetey-1-2013:p0557:b004:l001","ordinal":119310,"en":"At the sight, thoughts were stirred."},{"id":"semetey-1-2013:p0557:b004:l002","ordinal":119311,"en":"When Alake reached twelve,"},{"id":"semetey-1-2013:p0557:b004:l003","ordinal":119312,"en":"Looming like Mount Opol,"},{"id":"semetey-1-2013:p0557:b004:l004","ordinal":119313,"en":"Alööke's Konurbai,"},{"id":"semetey-1-2013:p0557:b004:l005","ordinal":119314,"en":"Sixty Chinese, countless kaldai officials,"},{"id":"semetey-1-2013:p0557:b004:l006","ordinal":119315,"en":"Konurbai, elder of the enemy,"},{"id":"semetey-1-2013:p0557:b004:l007","ordinal":119316,"en":"Coral plumes and precious coral stones,"},{"id":"semetey-1-2013:p0557:b004:l008","ordinal":119317,"en":"Among the unbelievers' wrestlers."},{"id":"semetey-1-2013:p0557:b004:l009","ordinal":119318,"en":"Raging, changing his expression,"},{"id":"semetey-1-2013:p0557:b004:l010","ordinal":119319,"en":"Speaking to the Manchus beside him,"},{"id":"semetey-1-2013:p0557:b004:l011","ordinal":119320,"en":"In the dark forest, the great thicket,"},{"id":"semetey-1-2013:p0557:b004:l012","ordinal":119321,"en":"He had organized a mighty hunt."},{"id":"semetey-1-2013:p0557:b004:l013","ordinal":119322,"en":"Sixty bears and a hundred boars"},{"id":"semetey-1-2013:p0557:b004:l014","ordinal":119323,"en":"He had shot and loaded up."},{"id":"semetey-1-2013:p0557:b004:l015","ordinal":119324,"en":"His spirits were utterly at ease;"},{"id":"semetey-1-2013:p0557:b004:l016","ordinal":119325,"en":"Kalcha felt rich in his heart,"},{"id":"semetey-1-2013:p0557:b004:l017","ordinal":119326,"en":"His great boots sticking out,"},{"id":"semetey-1-2013:p0557:b004:l018","ordinal":119327,"en":"Towering like Mount Opol."},{"id":"semetey-1-2013:p0557:b004:l019","ordinal":119328,"en":"As Konurbai stood looking,"},{"id":"semetey-1-2013:p0557:b004:l020","ordinal":119329,"en":"My Alake arrived."},{"id":"semetey-1-2013:p0557:b004:l021","ordinal":119330,"en":"“Konurbai, you too are a khan's son;"},{"id":"semetey-1-2013:p0557:b004:l022","ordinal":119331,"en":"I too am a khan's son."},{"id":"semetey-1-2013:p0557:b004:l023","ordinal":119332,"en":"Our standing is equal, kinsman;"},{"id":"semetey-1-2013:p0557:b004:l024","ordinal":119333,"en":"Our ancestry is one, we are kin!"},{"id":"semetey-1-2013:p0557:b004:l025","ordinal":119334,"en":"To the words I say,"},{"id":"semetey-1-2013:p0557:b004:l026","ordinal":119335,"en":"Will you agree, Konurbai?"},{"id":"semetey-1-2013:p0557:b004:l027","ordinal":119336,"en":"You have seized from my father"},{"id":"semetey-1-2013:p0557:b004:l028","ordinal":119337,"en":"The tea-producing land he held;"},{"id":"semetey-1-2013:p0557:b004:l029","ordinal":119338,"en":"Come, will you give it back, Konurbai?"},{"id":"semetey-1-2013:p0557:b004:l030","ordinal":119339,"en":"You petty degenerate,"},{"id":"semetey-1-2013:p0557:b004:l031","ordinal":119340,"en":"My father is half a khan;"},{"id":"semetey-1-2013:p0557:b004:l032","ordinal":119341,"en":"You insulted him, calling him childless."},{"id":"semetey-1-2013:p0557:b004:l033","ordinal":119342,"en":"And you have caused much mischief."},{"id":"semetey-1-2013:p0557:b004:l034","ordinal":119343,"en":"My father's Kan-Jailak"},{"id":"semetey-1-2013:p0557:b004:l035","ordinal":119344,"en":"You have seized by force."},{"id":"semetey-1-2013:p0557:b004:l036","ordinal":119345,"en":"A pale, hazy star from heaven—"},{"id":"semetey-1-2013:p0557:b004:l037","ordinal":119346,"en":"Let us set out, Konurbai."},{"id":"semetey-1-2013:p0557:b004:l038","ordinal":119347,"en":"We are sons of elder and younger brothers;"},{"id":"semetey-1-2013:p0557:b004:l039","ordinal":119348,"en":"Let us be friends, Konurbai."},{"id":"semetey-1-2013:p0558:b003:l001","ordinal":119349,"en":"At Beijing's dark valley, Kaiky-Tash,"},{"id":"semetey-1-2013:p0558:b003:l002","ordinal":119350,"en":"If I camp there on watch,"},{"id":"semetey-1-2013:p0558:b003:l003","ordinal":119351,"en":"At Kyrka-Tash in deep Beijing,"},{"id":"semetey-1-2013:p0558:b003:l004","ordinal":119352,"en":"If you camp guarding its ridge,"},{"id":"semetey-1-2013:p0558:b003:l005","ordinal":119353,"en":"Could any fingered man dare challenge us?"},{"id":"semetey-1-2013:p0558:b003:l006","ordinal":119354,"en":"Could he come with a cold heart?"},{"id":"semetey-1-2013:p0558:b003:l007","ordinal":119355,"en":"Could anyone face our eyes?”"},{"id":"semetey-1-2013:p0558:b003:l008","ordinal":119356,"en":"Though he spoke, Kalcha did not agree."},{"id":"semetey-1-2013:p0558:b003:l009","ordinal":119357,"en":"Let alone Kan-Jailak, Konurbai"},{"id":"semetey-1-2013:p0558:b003:l010","ordinal":119358,"en":"Would not give him a kindly word."},{"id":"semetey-1-2013:p0558:b003:l011","ordinal":119359,"en":"Humming disdainfully, paying no heed,"},{"id":"semetey-1-2013:p0558:b003:l012","ordinal":119360,"en":"These words of Almambet"},{"id":"semetey-1-2013:p0558:b003:l013","ordinal":119361,"en":"Konurbai stood there"},{"id":"semetey-1-2013:p0558:b003:l014","ordinal":119362,"en":"Valuing less than a scrap of hide."},{"id":"semetey-1-2013:p0558:b003:l015","ordinal":119363,"en":"At that moment Almambet,"},{"id":"semetey-1-2013:p0558:b003:l016","ordinal":119364,"en":"His heart burning, turned to embers,"},{"id":"semetey-1-2013:p0558:b003:l017","ordinal":119365,"en":"His eyes boiling, turned to fire."},{"id":"semetey-1-2013:p0558:b003:l018","ordinal":119366,"en":"The sixty Chinese, the countless kaldai officials—"},{"id":"semetey-1-2013:p0558:b003:l019","ordinal":119367,"en":"Without looking squarely at a single one,"},{"id":"semetey-1-2013:p0558:b003:l020","ordinal":119368,"en":"When he saw Konurbai,"},{"id":"semetey-1-2013:p0558:b003:l021","ordinal":119369,"en":"He spared not a hair's breadth of his life."},{"id":"semetey-1-2013:p0558:b003:l022","ordinal":119370,"en":"“If my death has come, let me die;"},{"id":"semetey-1-2013:p0558:b003:l023","ordinal":119371,"en":"If I have the skill, let me test it."},{"id":"semetey-1-2013:p0558:b003:l024","ordinal":119372,"en":"With this dog, the khan of monks,"},{"id":"semetey-1-2013:p0558:b003:l025","ordinal":119373,"en":"Let me try a bout of jousting."},{"id":"semetey-1-2013:p0558:b003:l026","ordinal":119374,"en":"Let me rage without mercy;"},{"id":"semetey-1-2013:p0558:b003:l027","ordinal":119375,"en":"If he falls, let me take his head."},{"id":"semetey-1-2013:p0558:b003:l028","ordinal":119376,"en":"My father's tea-producing land,"},{"id":"semetey-1-2013:p0558:b003:l029","ordinal":119377,"en":"Without resting, fighting nine battles,"},{"id":"semetey-1-2013:p0558:b003:l030","ordinal":119378,"en":"Let me seize it back."},{"id":"semetey-1-2013:p0558:b003:l031","ordinal":119379,"en":"Pursuing them as far as Kakan,"},{"id":"semetey-1-2013:p0558:b003:l032","ordinal":119380,"en":"Let me bring havoc."},{"id":"semetey-1-2013:p0558:b003:l033","ordinal":119381,"en":"Let me take vengeance far and wide."},{"id":"semetey-1-2013:p0558:b003:l034","ordinal":119382,"en":"Until the pliant reed ripens,"},{"id":"semetey-1-2013:p0558:b003:l035","ordinal":119383,"en":"Until autumn gossamer flies,"},{"id":"semetey-1-2013:p0558:b003:l036","ordinal":119384,"en":"If I press hard, fighting for six months,"},{"id":"semetey-1-2013:p0558:b003:l037","ordinal":119385,"en":"Let me reach Beijing!”"},{"id":"semetey-1-2013:p0558:b003:l038","ordinal":119386,"en":"Thinking this at that time,"},{"id":"semetey-1-2013:p0558:b003:l039","ordinal":119387,"en":"Almambet at twelve"},{"id":"semetey-1-2013:p0558:b004:l001","ordinal":119388,"en":"Struck Sarala upon the flank,"},{"id":"semetey-1-2013:p0558:b004:l002","ordinal":119389,"en":"Took the lacquered spear in hand,"},{"id":"semetey-1-2013:p0558:b004:l003","ordinal":119390,"en":"His back hunched behind him,"},{"id":"semetey-1-2013:p0558:b004:l004","ordinal":119391,"en":"His fierce eyes bulging,"},{"id":"semetey-1-2013:p0558:b004:l005","ordinal":119392,"en":"Flames hissing from his mouth,"},{"id":"semetey-1-2013:p0558:b004:l006","ordinal":119393,"en":"His mighty teeth like gates"},{"id":"semetey-1-2013:p0558:b004:l007","ordinal":119394,"en":"Clattering like grains of millet,"},{"id":"semetey-1-2013:p0558:b004:l008","ordinal":119395,"en":"And arrived ahead of an arrow."},{"id":"semetey-1-2013:p0558:b004:l009","ordinal":119396,"en":"When he reached Kalcha,"},{"id":"semetey-1-2013:p0558:b004:l010","ordinal":119397,"en":"“The pommel of the Kalmyk saddle,"},{"id":"semetey-1-2013:p0558:b004:l011","ordinal":119398,"en":"The very tip of the heart,"},{"id":"semetey-1-2013:p0558:b004:l012","ordinal":119399,"en":"The middle of the lungs—"},{"id":"semetey-1-2013:p0558:b004:l013","ordinal":119400,"en":"That is the exact measure."},{"id":"semetey-1-2013:p0558:b004:l014","ordinal":119401,"en":"This Konurbai standing here,"},{"id":"semetey-1-2013:p0558:b004:l015","ordinal":119402,"en":"If I aim my thrust at Konurbai,"},{"id":"semetey-1-2013:p0558:b004:l016","ordinal":119403,"en":"This will be the moment he dies!”"},{"id":"semetey-1-2013:p0558:b004:l017","ordinal":119404,"en":"He arrived ahead of an arrow."},{"id":"semetey-1-2013:p0558:b004:l018","ordinal":119405,"en":"When he reached Kalcha,"},{"id":"semetey-1-2013:p0558:b004:l019","ordinal":119406,"en":"Upon Alkara's back,"},{"id":"semetey-1-2013:p0558:b004:l020","ordinal":119407,"en":"He struck him full on as he passed."},{"id":"semetey-1-2013:p0558:b004:l021","ordinal":119408,"en":"Alööke's Konurbai"},{"id":"semetey-1-2013:p0558:b004:l022","ordinal":119409,"en":"Slipped backward from his saddle,"},{"id":"semetey-1-2013:p0558:b004:l023","ordinal":119410,"en":"His feet slipped from the stirrups,"},{"id":"semetey-1-2013:p0558:b004:l024","ordinal":119411,"en":"His eyes darted wildly,"},{"id":"semetey-1-2013:p0558:b004:l025","ordinal":119412,"en":"His legs dangled,"},{"id":"semetey-1-2013:p0558:b004:l026","ordinal":119413,"en":"He bent far down out of sight."},{"id":"semetey-1-2013:p0558:b004:l027","ordinal":119414,"en":"At Alkara's sacred mane,"},{"id":"semetey-1-2013:p0558:b004:l028","ordinal":119415,"en":"The skillful Konurbai"},{"id":"semetey-1-2013:p0558:b004:l029","ordinal":119416,"en":"Climbed back up and righted himself."},{"id":"semetey-1-2013:p0558:b004:l030","ordinal":119417,"en":"Sixty Chinese, countless kaldai officials,"},{"id":"semetey-1-2013:p0558:b004:l031","ordinal":119418,"en":"All of them came to his aid."},{"id":"semetey-1-2013:p0558:b004:l033","ordinal":119419,"en":"Cursed be solitude!","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0558:b004:l034","ordinal":119420,"en":"A lonely person as a living soul—"},{"id":"semetey-1-2013:p0558:b004:l035","ordinal":119421,"en":"Why could God not have left him uncreated!"},{"id":"semetey-1-2013:p0558:b004:l036","ordinal":119422,"en":"Alööke's Konurbai,"},{"id":"semetey-1-2013:p0558:b004:l037","ordinal":119423,"en":"The warrior Kalcha, at his wits' end,"},{"id":"semetey-1-2013:p0558:b004:l038","ordinal":119424,"en":"Struck Algara upon the flank,"},{"id":"semetey-1-2013:p0558:b004:l039","ordinal":119425,"en":"The great Kalcha, big as a hut,"},{"id":"semetey-1-2013:p0559:b003:l001","ordinal":119426,"en":"Dashed toward Beijing,"},{"id":"semetey-1-2013:p0559:b003:l002","ordinal":119427,"en":"Shouting to his horse without sparing his life."},{"id":"semetey-1-2013:p0559:b003:l003","ordinal":119428,"en":"As Kalcha fled,"},{"id":"semetey-1-2013:p0559:b003:l004","ordinal":119429,"en":"Behind him the lion Almam"},{"id":"semetey-1-2013:p0559:b003:l005","ordinal":119430,"en":"Pursued with stubborn fury."},{"id":"semetey-1-2013:p0559:b003:l006","ordinal":119431,"en":"Upon the open plain he wrought"},{"id":"semetey-1-2013:p0559:b003:l007","ordinal":119432,"en":"Havoc that no other man could make."},{"id":"semetey-1-2013:p0559:b003:l008","ordinal":119433,"en":"Driving him toward Kakan,"},{"id":"semetey-1-2013:p0559:b003:l009","ordinal":119434,"en":"Khan Alman, taking courage,"},{"id":"semetey-1-2013:p0559:b003:l010","ordinal":119435,"en":"Waged a fierce fight."},{"id":"semetey-1-2013:p0559:b003:l011","ordinal":119436,"en":"In the great desert shrouded in haze,"},{"id":"semetey-1-2013:p0559:b003:l012","ordinal":119437,"en":"Alööke's Kalcha,"},{"id":"semetey-1-2013:p0559:b003:l013","ordinal":119438,"en":"When he himself was twelve,"},{"id":"semetey-1-2013:p0559:b003:l014","ordinal":119439,"en":"From Alkara's back"},{"id":"semetey-1-2013:p0559:b003:l015","ordinal":119440,"en":"He thrust down six times."},{"id":"semetey-1-2013:p0559:b003:l016","ordinal":119441,"en":"The wrestlers Eibi and Sheibi,"},{"id":"semetey-1-2013:p0559:b003:l017","ordinal":119442,"en":"Onto Alkara's back,"},{"id":"semetey-1-2013:p0559:b003:l018","ordinal":119443,"en":"Reached him and mounted him,"},{"id":"semetey-1-2013:p0559:b003:l019","ordinal":119444,"en":"Saving him alive."},{"id":"semetey-1-2013:p0559:b003:l021","ordinal":119445,"en":"He drove into Beijing","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0559:b003:l022","ordinal":119446,"en":"The swine, the khan of monks,"},{"id":"semetey-1-2013:p0559:b003:l023","ordinal":119447,"en":"Drenched in bright red blood."},{"id":"semetey-1-2013:p0559:b003:l024","ordinal":119448,"en":"His star was eclipsed in heaven."},{"id":"semetey-1-2013:p0559:b003:l025","ordinal":119449,"en":"Into Outer Beijing, where Esen Khan dwelt,"},{"id":"semetey-1-2013:p0559:b003:l026","ordinal":119450,"en":"Konurbai, whose horse was swift,"},{"id":"semetey-1-2013:p0559:b003:l027","ordinal":119451,"en":"Fled inside and escaped."},{"id":"semetey-1-2013:p0559:b003:l028","ordinal":119452,"en":"Covering the ground beneath his feet,"},{"id":"semetey-1-2013:p0559:b003:l029","ordinal":119453,"en":"To Esen Khan himself"},{"id":"semetey-1-2013:p0559:b003:l030","ordinal":119454,"en":"Konurbai arrived first,"},{"id":"semetey-1-2013:p0559:b003:l031","ordinal":119455,"en":"And spoke ill of Almambet:"},{"id":"semetey-1-2013:p0559:b003:l032","ordinal":119456,"en":"“From my hearth I have suffered burning coals;"},{"id":"semetey-1-2013:p0559:b003:l033","ordinal":119457,"en":"From my own kinsman I have suffered tyranny."},{"id":"semetey-1-2013:p0559:b003:l034","ordinal":119458,"en":"My precious eyes like blackcurrants"},{"id":"semetey-1-2013:p0559:b003:l035","ordinal":119459,"en":"He almost gouged out."},{"id":"semetey-1-2013:p0559:b003:l036","ordinal":119460,"en":"In the desert of Mediyan,"},{"id":"semetey-1-2013:p0559:b003:l037","ordinal":119461,"en":"On this side of Beijing,"},{"id":"semetey-1-2013:p0559:b003:l038","ordinal":119462,"en":"From Alkara's back"},{"id":"semetey-1-2013:p0559:b003:l039","ordinal":119463,"en":"He thrust me down six times."},{"id":"semetey-1-2013:p0559:b004:l001","ordinal":119464,"en":"Had my forty nobles not been near,"},{"id":"semetey-1-2013:p0559:b004:l002","ordinal":119465,"en":"He almost slaughtered your Kalcha."},{"id":"semetey-1-2013:p0559:b004:l003","ordinal":119466,"en":"Mounting my rump as though I were an ox,"},{"id":"semetey-1-2013:p0559:b004:l004","ordinal":119467,"en":"As he was about to cut off my head,"},{"id":"semetey-1-2013:p0559:b004:l005","ordinal":119468,"en":"Algara's swiftness proved my salvation."},{"id":"semetey-1-2013:p0559:b004:l006","ordinal":119469,"en":"Aziz Khan's son,"},{"id":"semetey-1-2013:p0559:b004:l007","ordinal":119470,"en":"That bastard Almambet,"},{"id":"semetey-1-2013:p0559:b004:l008","ordinal":119471,"en":"Will not let us turn the plow."},{"id":"semetey-1-2013:p0559:b004:l009","ordinal":119472,"en":"May I be denied my portion if I lie!"},{"id":"semetey-1-2013:p0559:b004:l010","ordinal":119473,"en":"He will not let us dwell in this Beijing."},{"id":"semetey-1-2013:p0559:b004:l011","ordinal":119474,"en":"If we do not slaughter him now,"},{"id":"semetey-1-2013:p0559:b004:l012","ordinal":119475,"en":"He will grind your idols to dust,"},{"id":"semetey-1-2013:p0559:b004:l013","ordinal":119476,"en":"He will destroy this people of yours!"},{"id":"semetey-1-2013:p0559:b004:l014","ordinal":119477,"en":"Now he is only twelve;"},{"id":"semetey-1-2013:p0559:b004:l015","ordinal":119478,"en":"He is still a child at play."},{"id":"semetey-1-2013:p0559:b004:l016","ordinal":119479,"en":"At fifteen he will leave us no peace;"},{"id":"semetey-1-2013:p0559:b004:l017","ordinal":119480,"en":"When his age reaches eighteen,"},{"id":"semetey-1-2013:p0559:b004:l018","ordinal":119481,"en":"My lord, he will leave none of us unharmed."},{"id":"semetey-1-2013:p0559:b004:l020","ordinal":119482,"en":"He will not let us turn the plow in the earth."},{"id":"semetey-1-2013:p0559:b004:l021","ordinal":119483,"en":"May I be denied my portion if I lie!"},{"id":"semetey-1-2013:p0559:b004:l022","ordinal":119484,"en":"He will not let us dwell in this Beijing."},{"id":"semetey-1-2013:p0559:b004:l023","ordinal":119485,"en":"So long as Almambet is alive,"},{"id":"semetey-1-2013:p0559:b004:l024","ordinal":119486,"en":"I will not stay in this Beijing;"},{"id":"semetey-1-2013:p0559:b004:l025","ordinal":119487,"en":"I will not rule the monks as khan."},{"id":"semetey-1-2013:p0559:b004:l026","ordinal":119488,"en":"If Almambet remains here,"},{"id":"semetey-1-2013:p0559:b004:l027","ordinal":119489,"en":"I will not remain alive without dying."},{"id":"semetey-1-2013:p0559:b004:l028","ordinal":119490,"en":"Concerning Almambet,"},{"id":"semetey-1-2013:p0559:b004:l029","ordinal":119491,"en":"I hear bits and pieces of talk."},{"id":"semetey-1-2013:p0559:b004:l030","ordinal":119492,"en":"When his mother gave birth,"},{"id":"semetey-1-2013:p0559:b004:l031","ordinal":119493,"en":"There were words that he would not live in peace;"},{"id":"semetey-1-2013:p0559:b004:l032","ordinal":119494,"en":"Upon Kakancha, havoc—"},{"id":"semetey-1-2013:p0559:b004:l033","ordinal":119495,"en":"That unbeliever has eyes that will bring it."},{"id":"semetey-1-2013:p0559:b004:l034","ordinal":119496,"en":"In his right hand, dark blood"},{"id":"semetey-1-2013:p0559:b004:l035","ordinal":119497,"en":"He clutched as he fell, crying out;"},{"id":"semetey-1-2013:p0559:b004:l036","ordinal":119498,"en":"He landed upright upon his feet."},{"id":"semetey-1-2013:p0559:b004:l038","ordinal":119499,"en":"In his left hand, black poison","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0559:b004:l039","ordinal":119500,"en":"He clutched as he fell, so I hear."},{"id":"semetey-1-2013:p0560:b003:l001","ordinal":119501,"en":"Dark blood in his right hand—"},{"id":"semetey-1-2013:p0560:b003:l002","ordinal":119502,"en":"The reason he clutched it at birth"},{"id":"semetey-1-2013:p0560:b003:l003","ordinal":119503,"en":"Was that in Beijing with its Kakancha,"},{"id":"semetey-1-2013:p0560:b003:l004","ordinal":119504,"en":"Shedding blood and slaughtering people,"},{"id":"semetey-1-2013:p0560:b003:l005","ordinal":119505,"en":"He meant to bring havoc."},{"id":"semetey-1-2013:p0560:b003:l006","ordinal":119506,"en":"Black poison in his left hand—"},{"id":"semetey-1-2013:p0560:b003:l007","ordinal":119507,"en":"The reason he clutched it at birth"},{"id":"semetey-1-2013:p0560:b003:l008","ordinal":119508,"en":"Was that until his dark head entered the dark earth,"},{"id":"semetey-1-2013:p0560:b003:l009","ordinal":119509,"en":"The great men of Kakan Khan,"},{"id":"semetey-1-2013:p0560:b003:l011","ordinal":119510,"en":"He meant to cut them down.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0560:b003:l012","ordinal":119511,"en":"Cut down the willows of the valley;"},{"id":"semetey-1-2013:p0560:b003:l013","ordinal":119512,"en":"They are going up in flames."},{"id":"semetey-1-2013:p0560:b003:l014","ordinal":119513,"en":"Aziz Khan's bastard fool,"},{"id":"semetey-1-2013:p0560:b003:l015","ordinal":119514,"en":"My lord, restrain him now!"},{"id":"semetey-1-2013:p0560:b003:l016","ordinal":119515,"en":"Either let me dwell in Beijing,"},{"id":"semetey-1-2013:p0560:b003:l017","ordinal":119516,"en":"Or let him dwell in Beijing!”"},{"id":"semetey-1-2013:p0560:b003:l018","ordinal":119517,"en":"Covering the ground beneath his feet,"},{"id":"semetey-1-2013:p0560:b003:l019","ordinal":119518,"en":"Before Esen Khan"},{"id":"semetey-1-2013:p0560:b003:l020","ordinal":119519,"en":"He had already spoken ill of him."},{"id":"semetey-1-2013:p0560:b003:l021","ordinal":119520,"en":"The unbelievers' khan, Khan Esen,"},{"id":"semetey-1-2013:p0560:b003:l022","ordinal":119521,"en":"Flared up in anger;"},{"id":"semetey-1-2013:p0560:b003:l023","ordinal":119522,"en":"That swine remained"},{"id":"semetey-1-2013:p0560:b003:l024","ordinal":119523,"en":"Grumbling, unwilling to see him."},{"id":"semetey-1-2013:p0560:b003:l025","ordinal":119524,"en":"He turned Sarala's head."},{"id":"semetey-1-2013:p0560:b003:l026","ordinal":119525,"en":"“Alööke and Aziz are brothers;"},{"id":"semetey-1-2013:p0560:b003:l027","ordinal":119526,"en":"He will judge the matter fairly.”"},{"id":"semetey-1-2013:p0560:b003:l028","ordinal":119527,"en":"“Of the forty Chinese tribes, the people of Beijing,"},{"id":"semetey-1-2013:p0560:b003:l029","ordinal":119528,"en":"Give me one khanship,” he said,"},{"id":"semetey-1-2013:p0560:b003:l030","ordinal":119529,"en":"And stood requesting a khanship."},{"id":"semetey-1-2013:p0560:b003:l031","ordinal":119530,"en":"When he asked for the Shibe khanship,"},{"id":"semetey-1-2013:p0560:b003:l032","ordinal":119531,"en":"“I gave it to Orokkyr,” he said,"},{"id":"semetey-1-2013:p0560:b003:l033","ordinal":119532,"en":"And disappointed him there."},{"id":"semetey-1-2013:p0560:b003:l034","ordinal":119533,"en":"When he asked for the Manchu khanship,"},{"id":"semetey-1-2013:p0560:b003:l035","ordinal":119534,"en":"“I gave it to Ezkara,” he said,"},{"id":"semetey-1-2013:p0560:b003:l036","ordinal":119535,"en":"And disappointed him again."},{"id":"semetey-1-2013:p0560:b003:l037","ordinal":119536,"en":"When he asked for the Solon khanship,"},{"id":"semetey-1-2013:p0560:b003:l038","ordinal":119537,"en":"“I gave it to Muzkindik,” he said,"},{"id":"semetey-1-2013:p0560:b003:l039","ordinal":119538,"en":"Disappointing him in this way."},{"id":"semetey-1-2013:p0560:b004:l001","ordinal":119539,"en":"When he asked for the monks' khanship,"},{"id":"semetey-1-2013:p0560:b004:l002","ordinal":119540,"en":"“I gave it to Konurbai,” he said,"},{"id":"semetey-1-2013:p0560:b004:l003","ordinal":119541,"en":"And disappointed him there."},{"id":"semetey-1-2013:p0560:b004:l004","ordinal":119542,"en":"When he asked for the Torgut khanship,"},{"id":"semetey-1-2013:p0560:b004:l005","ordinal":119543,"en":"“Kanyshai, with the armful-sized arse,"},{"id":"semetey-1-2013:p0560:b004:l006","ordinal":119544,"en":"I gave it to that great woman,” he said,"},{"id":"semetey-1-2013:p0560:b004:l007","ordinal":119545,"en":"And thus disappointed him."},{"id":"semetey-1-2013:p0560:b004:l008","ordinal":119546,"en":"Offended over the khanship,"},{"id":"semetey-1-2013:p0560:b004:l009","ordinal":119547,"en":"He was left almost dead with grief."},{"id":"semetey-1-2013:p0560:b004:l010","ordinal":119548,"en":"And Esen Khan made him burn,"},{"id":"semetey-1-2013:p0560:b004:l011","ordinal":119549,"en":"Reviling Almam;"},{"id":"semetey-1-2013:p0560:b004:l012","ordinal":119550,"en":"He berated in this way"},{"id":"semetey-1-2013:p0560:b004:l013","ordinal":119551,"en":"A wrestler like my Alake."},{"id":"semetey-1-2013:p0560:b004:l014","ordinal":119552,"en":"“Almambet, may you never reach maturity!"}]
