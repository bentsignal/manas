[{"id":"semetey-2-2013:p1326:b004:l001","ordinal":287745,"en":"And all the weeping people"},{"id":"semetey-2-2013:p1326:b004:l002","ordinal":287746,"en":"Fled and scattered."},{"id":"semetey-2-2013:p1326:b004:l003","ordinal":287747,"en":"Taking a spear with a steel socket"},{"id":"semetey-2-2013:p1326:b004:l004","ordinal":287748,"en":"And a keen, gaping point,"},{"id":"semetey-2-2013:p1326:b004:l005","ordinal":287749,"en":"Girding on an unsheathed sword"},{"id":"semetey-2-2013:p1326:b004:l006","ordinal":287750,"en":"As though ready to strike,"},{"id":"semetey-2-2013:p1326:b004:l007","ordinal":287751,"en":"He arrayed all his weapons:"},{"id":"semetey-2-2013:p1326:b004:l008","ordinal":287752,"en":"The jezail, the club, the iron-headed mace—"},{"id":"semetey-2-2013:p1326:b004:l009","ordinal":287753,"en":"He made all of them ready."},{"id":"semetey-2-2013:p1326:b004:l010","ordinal":287754,"en":"At Semetey's treasury,"},{"id":"semetey-2-2013:p1326:b004:l011","ordinal":287755,"en":"He seized the keeper"},{"id":"semetey-2-2013:p1326:b004:l012","ordinal":287756,"en":"Who guarded the gate,"},{"id":"semetey-2-2013:p1326:b004:l013","ordinal":287757,"en":"And forced open the treasury door."},{"id":"semetey-2-2013:p1326:b004:l014","ordinal":287758,"en":"Beginning with Bolokbai, the forty Kalmyks—"},{"id":"semetey-2-2013:p1326:b004:l015","ordinal":287759,"en":"He slaughtered all forty Kalmyks."},{"id":"semetey-2-2013:p1326:b004:l016","ordinal":287760,"en":"In that treasury Kanchoro,"},{"id":"semetey-2-2013:p1326:b004:l017","ordinal":287761,"en":"The accursed traitor, gorged himself."},{"id":"semetey-2-2013:p1326:b004:l018","ordinal":287762,"en":"He plundered the fine cloth,"},{"id":"semetey-2-2013:p1326:b004:l019","ordinal":287763,"en":"And unleashed wickedness like a dog."},{"id":"semetey-2-2013:p1326:b004:l020","ordinal":287764,"en":"He ripped an entire sable skin"},{"id":"semetey-2-2013:p1326:b004:l021","ordinal":287765,"en":"Lengthwise,"},{"id":"semetey-2-2013:p1326:b004:l022","ordinal":287766,"en":"And wrapped it around his leggings."},{"id":"semetey-2-2013:p1326:b004:l023","ordinal":287767,"en":"Swaggering like a hero,"},{"id":"semetey-2-2013:p1326:b004:l024","ordinal":287768,"en":"Strutting as though mighty,"},{"id":"semetey-2-2013:p1326:b004:l025","ordinal":287769,"en":"He climbed a hill and shouted,"},{"id":"semetey-2-2013:p1326:b004:l026","ordinal":287770,"en":"Calling to Kyiaz of the Jediger:"},{"id":"semetey-2-2013:p1326:b004:l027","ordinal":287771,"en":"“Come, every one of you!”"},{"id":"semetey-2-2013:p1326:b004:l028","ordinal":287772,"en":"Standing upon the hill, Kanchoro—"},{"id":"semetey-2-2013:p1326:b004:l029","ordinal":287773,"en":"That pale retainer struck by ancestral wrath—"},{"id":"semetey-2-2013:p1326:b004:l030","ordinal":287774,"en":"Cried, “Know a khan's might!"},{"id":"semetey-2-2013:p1326:b004:l031","ordinal":287775,"en":"Make booty of the Argyn and Nogai,"},{"id":"semetey-2-2013:p1326:b004:l032","ordinal":287776,"en":"You damned Jediger!"},{"id":"semetey-2-2013:p1326:b004:l033","ordinal":287777,"en":"Go in and take them as spoil."},{"id":"semetey-2-2013:p1326:b004:l034","ordinal":287778,"en":"See which among them has courage."},{"id":"semetey-2-2013:p1326:b004:l035","ordinal":287779,"en":"Their remaining livestock, girls, and women"},{"id":"semetey-2-2013:p1326:b004:l036","ordinal":287780,"en":"Are the khan's spoils;"},{"id":"semetey-2-2013:p1326:b004:l037","ordinal":287781,"en":"Measure and divide them by the whip."},{"id":"semetey-2-2013:p1326:b004:l038","ordinal":287782,"en":"There is so much costly gold and silver"},{"id":"semetey-2-2013:p1326:b004:l039","ordinal":287783,"en":"You will fail to load it all;"},{"id":"semetey-2-2013:p1327:b003:l001","ordinal":287784,"en":"There are noble brides and beautiful girls"},{"id":"semetey-2-2013:p1327:b003:l002","ordinal":287785,"en":"Beyond your power to carry off."},{"id":"semetey-2-2013:p1327:b003:l003","ordinal":287786,"en":"Drive seven thousand red camels,"},{"id":"semetey-2-2013:p1327:b003:l004","ordinal":287787,"en":"And braid the camels' tails."},{"id":"semetey-2-2013:p1327:b003:l005","ordinal":287788,"en":"See this fine spectacle"},{"id":"semetey-2-2013:p1327:b003:l006","ordinal":287789,"en":"Provided by Chubak's son Choro!"},{"id":"semetey-2-2013:p1327:b003:l007","ordinal":287790,"en":"Six hundred thousand horses graze the hills,"},{"id":"semetey-2-2013:p1327:b003:l008","ordinal":287791,"en":"Fine piebald steeds,"},{"id":"semetey-2-2013:p1327:b003:l009","ordinal":287792,"en":"Thoroughbreds and racers mingled together."},{"id":"semetey-2-2013:p1327:b003:l010","ordinal":287793,"en":"There are countless swift ponies;"},{"id":"semetey-2-2013:p1327:b003:l011","ordinal":287794,"en":"In Talas there is no owner"},{"id":"semetey-2-2013:p1327:b003:l012","ordinal":287795,"en":"Besides me to receive them."},{"id":"semetey-2-2013:p1327:b003:l013","ordinal":287796,"en":"Leaders of tens and hundreds,"},{"id":"semetey-2-2013:p1327:b003:l014","ordinal":287797,"en":"Leaders of fifties and thousands,"},{"id":"semetey-2-2013:p1327:b003:l015","ordinal":287798,"en":"Divide them and return home;"},{"id":"semetey-2-2013:p1327:b003:l016","ordinal":287799,"en":"Say, ‘My khan gave us aid,’"},{"id":"semetey-2-2013:p1327:b003:l017","ordinal":287800,"en":"And offer thanks to me."},{"id":"semetey-2-2013:p1327:b003:l018","ordinal":287801,"en":"Divide among yourselves as booty"},{"id":"semetey-2-2013:p1327:b003:l019","ordinal":287802,"en":"The countless scattered gold coins;"},{"id":"semetey-2-2013:p1327:b003:l020","ordinal":287803,"en":"Go tell your homeland,"},{"id":"semetey-2-2013:p1327:b003:l021","ordinal":287804,"en":"‘Kanchoro performed a heroic deed.’"},{"id":"semetey-2-2013:p1327:b003:l022","ordinal":287805,"en":"Without quarreling or struggling,"},{"id":"semetey-2-2013:p1327:b003:l023","ordinal":287806,"en":"Find a way to divide"},{"id":"semetey-2-2013:p1327:b003:l024","ordinal":287807,"en":"The hero-khan's vast wealth."},{"id":"semetey-2-2013:p1327:b003:l025","ordinal":287808,"en":"Call me your hero and your lion;"},{"id":"semetey-2-2013:p1327:b003:l026","ordinal":287809,"en":"O Jediger, understand this!"},{"id":"semetey-2-2013:p1327:b003:l027","ordinal":287810,"en":"Observe the hero's leonine courage"},{"id":"semetey-2-2013:p1327:b003:l028","ordinal":287811,"en":"And always remember it!"},{"id":"semetey-2-2013:p1327:b003:l029","ordinal":287812,"en":"Snorting in excitement,"},{"id":"semetey-2-2013:p1327:b003:l030","ordinal":287813,"en":"Suddenly raising a battle cry,"},{"id":"semetey-2-2013:p1327:b003:l031","ordinal":287814,"en":"No people can withstand me,"},{"id":"semetey-2-2013:p1327:b003:l032","ordinal":287815,"en":"No charging foe can come near,"},{"id":"semetey-2-2013:p1327:b003:l033","ordinal":287816,"en":"No enemy can defeat me in battle."},{"id":"semetey-2-2013:p1327:b003:l034","ordinal":287817,"en":"When a hero stands at the front,"},{"id":"semetey-2-2013:p1327:b003:l035","ordinal":287818,"en":"Can any man with a thumb attack?"},{"id":"semetey-2-2013:p1327:b003:l036","ordinal":287819,"en":"Can any clawed enemy touch you?"},{"id":"semetey-2-2013:p1327:b003:l037","ordinal":287820,"en":"Can a cold-blooded foe advance?"},{"id":"semetey-2-2013:p1327:b003:l038","ordinal":287821,"en":"While your valiant Choro lives,"},{"id":"semetey-2-2013:p1327:b003:l039","ordinal":287822,"en":"My forearm is thick, my heart is stone,"},{"id":"semetey-2-2013:p1327:b004:l001","ordinal":287823,"en":"My body broad and powerful."},{"id":"semetey-2-2013:p1327:b004:l002","ordinal":287824,"en":"While your Choro stands watch,"},{"id":"semetey-2-2013:p1327:b004:l003","ordinal":287825,"en":"No one is swept away in the flood;"},{"id":"semetey-2-2013:p1327:b004:l004","ordinal":287826,"en":"Jediger, death cannot touch you."},{"id":"semetey-2-2013:p1327:b004:l005","ordinal":287827,"en":"There is no boat upon black water,"},{"id":"semetey-2-2013:p1327:b004:l006","ordinal":287828,"en":"But while your Khan Kanchoro lives,"},{"id":"semetey-2-2013:p1327:b004:l007","ordinal":287829,"en":"Jediger, death cannot touch you!"},{"id":"semetey-2-2013:p1327:b004:l008","ordinal":287830,"en":"In Talas, slaughter the livestock"},{"id":"semetey-2-2013:p1327:b004:l009","ordinal":287831,"en":"Of the Kyrgyz and Argyn and hold a feast;"},{"id":"semetey-2-2013:p1327:b004:l010","ordinal":287832,"en":"Slaughter their heroes and wreak havoc."},{"id":"semetey-2-2013:p1327:b004:l011","ordinal":287833,"en":"Make the gateway run with blood,"},{"id":"semetey-2-2013:p1327:b004:l012","ordinal":287834,"en":"And turn the black road to dust."},{"id":"semetey-2-2013:p1327:b004:l013","ordinal":287835,"en":"Make widows of their beauties,"},{"id":"semetey-2-2013:p1327:b004:l014","ordinal":287836,"en":"And slaves of their princes;"},{"id":"semetey-2-2013:p1327:b004:l015","ordinal":287837,"en":"Their wise old men—"},{"id":"semetey-2-2013:p1327:b004:l016","ordinal":287838,"en":"Smash and kill them all!"},{"id":"semetey-2-2013:p1327:b004:l017","ordinal":287839,"en":"Break apart their yurt frames and poles,"},{"id":"semetey-2-2013:p1327:b004:l018","ordinal":287840,"en":"And make their brides and daughters weep."},{"id":"semetey-2-2013:p1327:b004:l019","ordinal":287841,"en":"Take their old folk as plunder;"},{"id":"semetey-2-2013:p1327:b004:l020","ordinal":287842,"en":"Lay waste to them all."},{"id":"semetey-2-2013:p1327:b004:l021","ordinal":287843,"en":"Make their rulers and lions suffer,"},{"id":"semetey-2-2013:p1327:b004:l022","ordinal":287844,"en":"And crush the people of the steppe."},{"id":"semetey-2-2013:p1327:b004:l023","ordinal":287845,"en":"Cast cold lassos"},{"id":"semetey-2-2013:p1327:b004:l024","ordinal":287846,"en":"Over the steeds they would never surrender;"},{"id":"semetey-2-2013:p1327:b004:l025","ordinal":287847,"en":"Inflict open humiliation"},{"id":"semetey-2-2013:p1327:b004:l026","ordinal":287848,"en":"Upon flourishing Talas."},{"id":"semetey-2-2013:p1327:b004:l027","ordinal":287849,"en":"Bring misery upon its beks;"},{"id":"semetey-2-2013:p1327:b004:l028","ordinal":287850,"en":"Advance upon these black-hearted people"},{"id":"semetey-2-2013:p1327:b004:l029","ordinal":287851,"en":"And plunder them."},{"id":"semetey-2-2013:p1327:b004:l030","ordinal":287852,"en":"My great people, consider this:"},{"id":"semetey-2-2013:p1327:b004:l031","ordinal":287853,"en":"A khan's threshold is the Day of Judgment,"},{"id":"semetey-2-2013:p1327:b004:l032","ordinal":287854,"en":"And one must speak with care;"},{"id":"semetey-2-2013:p1327:b004:l033","ordinal":287855,"en":"A hero's threshold is solid iron,"},{"id":"semetey-2-2013:p1327:b004:l034","ordinal":287856,"en":"And one needs skill to melt it."},{"id":"semetey-2-2013:p1327:b004:l035","ordinal":287857,"en":"I have given the order—understand it,"},{"id":"semetey-2-2013:p1327:b004:l036","ordinal":287858,"en":"You many Black Jediger;"},{"id":"semetey-2-2013:p1327:b004:l037","ordinal":287859,"en":"Obey my word and do not anger me!”"},{"id":"semetey-2-2013:p1327:b004:l038","ordinal":287860,"en":"Thus Kanchoro spoke,"},{"id":"semetey-2-2013:p1327:b004:l039","ordinal":287861,"en":"That retainer faithless to the salt he had eaten,"},{"id":"semetey-2-2013:p1328:b003:l001","ordinal":287862,"en":"That retainer who was calamity itself,"},{"id":"semetey-2-2013:p1328:b003:l002","ordinal":287863,"en":"The pale retainer who slew his own kin;"},{"id":"semetey-2-2013:p1328:b003:l003","ordinal":287864,"en":"Greasing his bowels with fat,"},{"id":"semetey-2-2013:p1328:b003:l004","ordinal":287865,"en":"When his stubborn rage seized him,"},{"id":"semetey-2-2013:p1328:b003:l005","ordinal":287866,"en":"He destroyed his own elder brother."},{"id":"semetey-2-2013:p1328:b003:l006","ordinal":287867,"en":"No goodness or manly honor"},{"id":"semetey-2-2013:p1328:b003:l007","ordinal":287868,"en":"Remained in Kanchoro."},{"id":"semetey-2-2013:p1328:b003:l008","ordinal":287869,"en":"Kanchoro himself was a lofty slave,"},{"id":"semetey-2-2013:p1328:b003:l009","ordinal":287870,"en":"With a treacherous heart and sullen nature—"},{"id":"semetey-2-2013:p1328:b003:l010","ordinal":287871,"en":"Such a son had come among mankind."},{"id":"semetey-2-2013:p1328:b003:l011","ordinal":287872,"en":"When frenzy overcame him,"},{"id":"semetey-2-2013:p1328:b003:l012","ordinal":287873,"en":"He destroyed his own close kin"},{"id":"semetey-2-2013:p1328:b003:l013","ordinal":287874,"en":"And made a bondwoman of the mother"},{"id":"semetey-2-2013:p1328:b003:l014","ordinal":287875,"en":"Of his heroic kinsman who faced death."},{"id":"semetey-2-2013:p1328:b003:l015","ordinal":287876,"en":"The wretched son of a dog—"},{"id":"semetey-2-2013:p1328:b003:l016","ordinal":287877,"en":"A truly corrupted nightmare;"},{"id":"semetey-2-2013:p1328:b003:l017","ordinal":287878,"en":"Such a deed had never happened in an age."},{"id":"semetey-2-2013:p1328:b003:l018","ordinal":287879,"en":"To subject surpassingly beautiful Aichurok"},{"id":"semetey-2-2013:p1328:b003:l019","ordinal":287880,"en":"To still greater torment,"},{"id":"semetey-2-2013:p1328:b003:l020","ordinal":287881,"en":"And take that radiant beauty"},{"id":"semetey-2-2013:p1328:b003:l021","ordinal":287882,"en":"As plunder for himself,"},{"id":"semetey-2-2013:p1328:b003:l022","ordinal":287883,"en":"He urged the Jediger onward."},{"id":"semetey-2-2013:p1328:b003:l023","ordinal":287884,"en":"When the bloodstained warrior vanished,"},{"id":"semetey-2-2013:p1328:b003:l024","ordinal":287885,"en":"The Jediger people laughed"},{"id":"semetey-2-2013:p1328:b003:l025","ordinal":287886,"en":"At the frenzied swine."},{"id":"semetey-2-2013:p1328:b003:l026","ordinal":287887,"en":"The deep black earth beneath them"},{"id":"semetey-2-2013:p1328:b003:l027","ordinal":287888,"en":"Endured the great weight"},{"id":"semetey-2-2013:p1328:b003:l028","ordinal":287889,"en":"When Choro roared."},{"id":"semetey-2-2013:p1328:b003:l029","ordinal":287890,"en":"When that Choro strutted,"},{"id":"semetey-2-2013:p1328:b003:l030","ordinal":287891,"en":"He seemed lord of earth and water;"},{"id":"semetey-2-2013:p1328:b003:l031","ordinal":287892,"en":"When the broad brute barked,"},{"id":"semetey-2-2013:p1328:b003:l032","ordinal":287893,"en":"He seemed master of the land and streams."},{"id":"semetey-2-2013:p1328:b003:l033","ordinal":287894,"en":"The doomed man's fury"},{"id":"semetey-2-2013:p1328:b003:l034","ordinal":287895,"en":"Was like a giant in his swaggering;"},{"id":"semetey-2-2013:p1328:b003:l035","ordinal":287896,"en":"When the madman barked,"},{"id":"semetey-2-2013:p1328:b003:l036","ordinal":287897,"en":"He seemed a wrestler greater than the world."},{"id":"semetey-2-2013:p1328:b003:l037","ordinal":287898,"en":"His appearance and bearing"},{"id":"semetey-2-2013:p1328:b003:l038","ordinal":287899,"en":"Were like a tyrant ruling a nation;"},{"id":"semetey-2-2013:p1328:b003:l039","ordinal":287900,"en":"When the madman lurched about,"},{"id":"semetey-2-2013:p1328:b004:l001","ordinal":287901,"en":"He seemed a man bent on ruining a people."},{"id":"semetey-2-2013:p1328:b004:l002","ordinal":287902,"en":"See how he strutted—"},{"id":"semetey-2-2013:p1328:b004:l003","ordinal":287903,"en":"Like Kozkaman of old."},{"id":"semetey-2-2013:p1328:b004:l004","ordinal":287904,"en":"He roared in wrath"},{"id":"semetey-2-2013:p1328:b004:l005","ordinal":287905,"en":"At the great host of people;"},{"id":"semetey-2-2013:p1328:b004:l006","ordinal":287906,"en":"Taking the bloodstained lion as his model,"},{"id":"semetey-2-2013:p1328:b004:l007","ordinal":287907,"en":"The madman had grown savage."},{"id":"semetey-2-2013:p1328:b004:l008","ordinal":287908,"en":"He summoned the whole multitude,"},{"id":"semetey-2-2013:p1328:b004:l009","ordinal":287909,"en":"Crying, “Come, every one of you!”"},{"id":"semetey-2-2013:p1328:b004:l010","ordinal":287910,"en":"Looking at him made the heart recoil."},{"id":"semetey-2-2013:p1328:b004:l011","ordinal":287911,"en":"The madman, possessed by a spirit,"},{"id":"semetey-2-2013:p1328:b004:l012","ordinal":287912,"en":"Loomed like a towering mountain;"},{"id":"semetey-2-2013:p1328:b004:l013","ordinal":287913,"en":"The blue flame issuing from his mouth"},{"id":"semetey-2-2013:p1328:b004:l014","ordinal":287914,"en":"Poured out in gusts."},{"id":"semetey-2-2013:p1328:b004:l015","ordinal":287915,"en":"He meant to plunder the nation,"},{"id":"semetey-2-2013:p1328:b004:l016","ordinal":287916,"en":"To subject his people to misery,"},{"id":"semetey-2-2013:p1328:b004:l017","ordinal":287917,"en":"To erase the name of Semetey"},{"id":"semetey-2-2013:p1328:b004:l018","ordinal":287918,"en":"And remain as sultan himself,"},{"id":"semetey-2-2013:p1328:b004:l019","ordinal":287919,"en":"Taking both reins and the single bridle"},{"id":"semetey-2-2013:p1328:b004:l020","ordinal":287920,"en":"Somehow into his own hands."},{"id":"semetey-2-2013:p1328:b004:l021","ordinal":287921,"en":"Kanchoro, brother to corruption,"},{"id":"semetey-2-2013:p1328:b004:l022","ordinal":287922,"en":"When every other scheme failed,"},{"id":"semetey-2-2013:p1328:b004:l023","ordinal":287923,"en":"Meant to remain sultan in Talas."},{"id":"semetey-2-2013:p1328:b004:l024","ordinal":287924,"en":"Fluent-tongued Kanchoro—"},{"id":"semetey-2-2013:p1328:b004:l025","ordinal":287925,"en":"It is true he was conspicuous;"},{"id":"semetey-2-2013:p1328:b004:l026","ordinal":287926,"en":"The most insinuating smooth-talker,"},{"id":"semetey-2-2013:p1328:b004:l027","ordinal":287927,"en":"It is also true that Choro's conduct"},{"id":"semetey-2-2013:p1328:b004:l028","ordinal":287928,"en":"Was unlike any other person's."},{"id":"semetey-2-2013:p1328:b004:l029","ordinal":287929,"en":"That Choro of treacherous intent,"},{"id":"semetey-2-2013:p1328:b004:l030","ordinal":287930,"en":"Kanchoro, raising a battle cry, said:"},{"id":"semetey-2-2013:p1328:b004:l031","ordinal":287931,"en":"“You many Black Jediger,"},{"id":"semetey-2-2013:p1328:b004:l032","ordinal":287932,"en":"If you will not heed wise counsel,"},{"id":"semetey-2-2013:p1328:b004:l033","ordinal":287933,"en":"If you do not know your place,"},{"id":"semetey-2-2013:p1328:b004:l034","ordinal":287934,"en":"Then you have eaten filth!"},{"id":"semetey-2-2013:p1328:b004:l035","ordinal":287935,"en":"Babbling two at a time,"},{"id":"semetey-2-2013:p1328:b004:l036","ordinal":287936,"en":"What else did you say?"},{"id":"semetey-2-2013:p1328:b004:l037","ordinal":287937,"en":"As for Churok, Akun's daughter,"},{"id":"semetey-2-2013:p1328:b004:l038","ordinal":287938,"en":"That surpassingly beautiful wonder,"},{"id":"semetey-2-2013:p1328:b004:l039","ordinal":287939,"en":"That marvelous woman—"},{"id":"semetey-2-2013:p1329:b003:l001","ordinal":287940,"en":"This comely infidel woman—"},{"id":"semetey-2-2013:p1329:b003:l002","ordinal":287941,"en":"If blood should drip upon this black earth,"},{"id":"semetey-2-2013:p1329:b003:l003","ordinal":287942,"en":"This infidel, white as snow,"},{"id":"semetey-2-2013:p1329:b003:l004","ordinal":287943,"en":"Is surpassingly beautiful and bold;"},{"id":"semetey-2-2013:p1329:b003:l005","ordinal":287944,"en":"There is no such marvel in the village."},{"id":"semetey-2-2013:p1329:b003:l006","ordinal":287945,"en":"With a handspan waist and moonlike face,"},{"id":"semetey-2-2013:p1329:b003:l007","ordinal":287946,"en":"That celebrated beauty, that wanton woman,"},{"id":"semetey-2-2013:p1329:b003:l008","ordinal":287947,"en":"Is full of guile and fierce with venom—"},{"id":"semetey-2-2013:p1329:b003:l009","ordinal":287948,"en":"Aychörök, fertile in cunning,"},{"id":"semetey-2-2013:p1329:b003:l010","ordinal":287949,"en":"This mischief-maker, fertile in cunning."},{"id":"semetey-2-2013:p1329:b003:l011","ordinal":287950,"en":"Friday alone knew when she walked;"},{"id":"semetey-2-2013:p1329:b003:l012","ordinal":287951,"en":"The twilight night knew when she flew."},{"id":"semetey-2-2013:p1329:b003:l013","ordinal":287952,"en":"She swept across every quarter,"},{"id":"semetey-2-2013:p1329:b003:l014","ordinal":287953,"en":"The whole wide world,"},{"id":"semetey-2-2013:p1329:b003:l015","ordinal":287954,"en":"Flying as she roamed."},{"id":"semetey-2-2013:p1329:b003:l016","ordinal":287955,"en":"No mountain pass remained uncrossed,"},{"id":"semetey-2-2013:p1329:b003:l017","ordinal":287956,"en":"No man remained whom she had not visited;"},{"id":"semetey-2-2013:p1329:b003:l018","ordinal":287957,"en":"Chörök has seen a great deal."},{"id":"semetey-2-2013:p1329:b003:l019","ordinal":287958,"en":"She is no Chörök, but simply"},{"id":"semetey-2-2013:p1329:b003:l020","ordinal":287959,"en":"A scourge who brings nations to ruin."},{"id":"semetey-2-2013:p1329:b003:l021","ordinal":287960,"en":"Take that unruly-minded woman,"},{"id":"semetey-2-2013:p1329:b003:l022","ordinal":287961,"en":"That glittering infidel woman"},{"id":"semetey-2-2013:p1329:b003:l023","ordinal":287962,"en":"Who learned the whole world in flight."},{"id":"semetey-2-2013:p1329:b003:l024","ordinal":287963,"en":"There is no ridge she has not flown beyond;"},{"id":"semetey-2-2013:p1329:b003:l025","ordinal":287964,"en":"There is no man who does not recognize"},{"id":"semetey-2-2013:p1329:b003:l026","ordinal":287965,"en":"The outward face of that black-hearted wretch."},{"id":"semetey-2-2013:p1329:b003:l027","ordinal":287966,"en":"Damn you, valiant Kiyaz!"},{"id":"semetey-2-2013:p1329:b003:l028","ordinal":287967,"en":"Kiyaz, you witless fool!"},{"id":"semetey-2-2013:p1329:b003:l029","ordinal":287968,"en":"Aychörök, the accomplished one among women,"},{"id":"semetey-2-2013:p1329:b003:l030","ordinal":287969,"en":"That tumultuous woman,"},{"id":"semetey-2-2013:p1329:b003:l031","ordinal":287970,"en":"Was Khan Akun's daughter."},{"id":"semetey-2-2013:p1329:b003:l032","ordinal":287971,"en":"She was the subject of my words,"},{"id":"semetey-2-2013:p1329:b003:l033","ordinal":287972,"en":"And she was your sister-in-law;"},{"id":"semetey-2-2013:p1329:b003:l034","ordinal":287973,"en":"You truly are shameless, Kiyaz."},{"id":"semetey-2-2013:p1329:b003:l035","ordinal":287974,"en":"You have courage but no sense;"},{"id":"semetey-2-2013:p1329:b003:l036","ordinal":287975,"en":"You are a blundering Kiyaz."},{"id":"semetey-2-2013:p1329:b003:l037","ordinal":287976,"en":"Why do you not unleash"},{"id":"semetey-2-2013:p1329:b003:l038","ordinal":287977,"en":"Utter slaughter, Kiyaz?"},{"id":"semetey-2-2013:p1329:b003:l039","ordinal":287978,"en":"Why do you not take Aychörök"},{"id":"semetey-2-2013:p1329:b005:l001","ordinal":287979,"en":"As plunder, Kiyaz?"},{"id":"semetey-2-2013:p1329:b005:l002","ordinal":287980,"en":"Look there: the peerless woman Aychörök"},{"id":"semetey-2-2013:p1329:b005:l003","ordinal":287981,"en":"Is, after all, your wife;"},{"id":"semetey-2-2013:p1329:b005:l004","ordinal":287982,"en":"If you truly contest her, she is your widow,"},{"id":"semetey-2-2013:p1329:b005:l005","ordinal":287983,"en":"And if you exert yourself, your own spouse."},{"id":"semetey-2-2013:p1329:b005:l006","ordinal":287984,"en":"You destroyed that swaggering ruin-bringer,"},{"id":"semetey-2-2013:p1329:b005:l007","ordinal":287985,"en":"You demolished the Grey Wolf's fortress."},{"id":"semetey-2-2013:p1329:b005:l008","ordinal":287986,"en":"You are a hero, you are a lion;"},{"id":"semetey-2-2013:p1329:b005:l009","ordinal":287987,"en":"Yet you are a foolish Kiyaz."},{"id":"semetey-2-2013:p1329:b005:l010","ordinal":287988,"en":"You are the man to take the beauty."},{"id":"semetey-2-2013:p1329:b005:l011","ordinal":287989,"en":"Think it through and raise the tumult;"},{"id":"semetey-2-2013:p1329:b005:l012","ordinal":287990,"en":"Show Talas the strength of your arm."},{"id":"semetey-2-2013:p1329:b005:l013","ordinal":287991,"en":"Take the woman as a prize,"},{"id":"semetey-2-2013:p1329:b005:l014","ordinal":287992,"en":"This beautiful woman Chörök,"},{"id":"semetey-2-2013:p1329:b005:l015","ordinal":287993,"en":"This strange-minded infidel,"},{"id":"semetey-2-2013:p1329:b005:l016","ordinal":287994,"en":"This graceful, shimmering woman,"},{"id":"semetey-2-2013:p1329:b005:l017","ordinal":287995,"en":"With thimble mouth and camel-calf eyes,"},{"id":"semetey-2-2013:p1329:b005:l018","ordinal":287996,"en":"With rolling black eyes."},{"id":"semetey-2-2013:p1329:b005:l019","ordinal":287997,"en":"There is no need to ponder such words."},{"id":"semetey-2-2013:p1329:b005:l020","ordinal":287998,"en":"Ah, God-forsaken valiant Kiyaz,"},{"id":"semetey-2-2013:p1329:b005:l021","ordinal":287999,"en":"Now is the time to take Aychörök."},{"id":"semetey-2-2013:p1329:b005:l022","ordinal":288000,"en":"Take Aychörök as your spoil"}]
