[{"id":"seytek-2012:p1110:b002:l038","ordinal":382209,"en":"Burned in helplessness"},{"id":"seytek-2012:p1110:b002:l039","ordinal":382210,"en":"And fled into the gorges."},{"id":"seytek-2012:p1110:b002:l040","ordinal":382211,"en":"Through the four corners of the world"},{"id":"seytek-2012:p1110:b003:l001","ordinal":382212,"en":"He made four complete circuits,"},{"id":"seytek-2012:p1110:b003:l002","ordinal":382213,"en":"Hunting game with hawk and hound,"},{"id":"seytek-2012:p1110:b003:l003","ordinal":382214,"en":"And reveled in this great delight."},{"id":"seytek-2012:p1110:b003:l004","ordinal":382215,"en":"Through the five quarters of Medina"},{"id":"seytek-2012:p1110:b003:l005","ordinal":382216,"en":"He made five complete circuits,"},{"id":"seytek-2012:p1110:b003:l006","ordinal":382217,"en":"And in every known place"},{"id":"seytek-2012:p1110:b003:l007","ordinal":382218,"en":"He brought all things to completion."},{"id":"seytek-2012:p1110:b003:l008","ordinal":382219,"en":"“The warrior is Seytek,” they said,"},{"id":"seytek-2012:p1110:b003:l009","ordinal":382220,"en":"And the whole wide world learned his name."},{"id":"seytek-2012:p1110:b003:l010","ordinal":382221,"en":"He challenged the panther"},{"id":"seytek-2012:p1110:b003:l011","ordinal":382222,"en":"And grappled with the tiger."},{"id":"seytek-2012:p1110:b003:l012","ordinal":382223,"en":"Whatever he encountered he bent beneath him,"},{"id":"seytek-2012:p1110:b003:l013","ordinal":382224,"en":"And that eagle carried it off."},{"id":"seytek-2012:p1110:b003:l014","ordinal":382225,"en":"Rejoicing in the deeds"},{"id":"seytek-2012:p1110:b003:l015","ordinal":382226,"en":"And pleasures of his hunt,"},{"id":"seytek-2012:p1110:b003:l016","ordinal":382227,"en":"He wearied his horse and surveyed the land,"},{"id":"seytek-2012:p1110:b003:l017","ordinal":382228,"en":"Hooding and then flying his bird,"},{"id":"seytek-2012:p1110:b003:l018","ordinal":382229,"en":"Yet never reached his intended destination."},{"id":"seytek-2012:p1110:b003:l019","ordinal":382230,"en":"Before this Seytek"},{"id":"seytek-2012:p1110:b003:l020","ordinal":382231,"en":"No one remained who dared object."},{"id":"seytek-2012:p1110:b003:l021","ordinal":382232,"en":"Then, as she slept, she dreamed again:"},{"id":"seytek-2012:p1110:b003:l022","ordinal":382233,"en":"The valiant panther Seytek"},{"id":"seytek-2012:p1110:b003:l023","ordinal":382234,"en":"Found two blades of steel."},{"id":"seytek-2012:p1110:b003:l024","ordinal":382235,"en":"The sign of those blades was this:"},{"id":"seytek-2012:p1110:b003:l025","ordinal":382236,"en":"When swung, they never recoiled from stone,"},{"id":"seytek-2012:p1110:b003:l026","ordinal":382237,"en":"And from any place struck against an enemy"},{"id":"seytek-2012:p1110:b003:l027","ordinal":382238,"en":"They never returned without shedding blood."},{"id":"seytek-2012:p1110:b003:l028","ordinal":382239,"en":"Their sheaths were beautifully fashioned;"},{"id":"seytek-2012:p1110:b003:l029","ordinal":382240,"en":"Seeing how keen the steel was,"},{"id":"seytek-2012:p1110:b003:l030","ordinal":382241,"en":"The great smith and forefather David"},{"id":"seytek-2012:p1110:b003:l031","ordinal":382242,"en":"Looked upon it and praised it."},{"id":"seytek-2012:p1110:b003:l032","ordinal":382243,"en":"Roving on reconnaissance in high spirits,"},{"id":"seytek-2012:p1110:b003:l033","ordinal":382244,"en":"He encountered a dragon"},{"id":"seytek-2012:p1110:b003:l034","ordinal":382245,"en":"As huge as Mount Kap-Too."},{"id":"seytek-2012:p1110:b003:l035","ordinal":382246,"en":"The matched pair of keen swords"},{"id":"seytek-2012:p1110:b003:l036","ordinal":382247,"en":"Could not prevail against the dragon,"},{"id":"seytek-2012:p1110:b003:l037","ordinal":382248,"en":"And fire could not pierce its breath;"},{"id":"seytek-2012:p1110:b003:l038","ordinal":382249,"en":"They fought but could not overcome it."},{"id":"seytek-2012:p1110:b003:l039","ordinal":382250,"en":"With a roar it swept from the east"},{"id":"seytek-2012:p1110:b003:l040","ordinal":382251,"en":"And came to rest in the east."},{"id":"seytek-2012:p1112:b002:l001","ordinal":382252,"en":"Scorching the face of the earth,"},{"id":"seytek-2012:p1112:b002:l002","ordinal":382253,"en":"That dragon charged."},{"id":"seytek-2012:p1112:b002:l003","ordinal":382254,"en":"Grappling with it, leopard Seytek"},{"id":"seytek-2012:p1112:b002:l004","ordinal":382255,"en":"Vanished from this world."},{"id":"seytek-2012:p1112:b002:l005","ordinal":382256,"en":"Unable to overcome the fierce one,"},{"id":"seytek-2012:p1112:b002:l006","ordinal":382257,"en":"Only a spoonful of blood remained,"},{"id":"seytek-2012:p1112:b002:l007","ordinal":382258,"en":"Only a bruised scrap of flesh remained."},{"id":"seytek-2012:p1112:b002:l008","ordinal":382259,"en":"The sword shattered at the hilt,"},{"id":"seytek-2012:p1112:b002:l009","ordinal":382260,"en":"The heart burst from its sheath,"},{"id":"seytek-2012:p1112:b002:l010","ordinal":382261,"en":"The fiery heart was stirred,"},{"id":"seytek-2012:p1112:b002:l011","ordinal":382262,"en":"The Ala-Too where the people dwelt"},{"id":"seytek-2012:p1112:b002:l012","ordinal":382263,"en":"Was reduced to dust and turmoil."},{"id":"seytek-2012:p1112:b002:l013","ordinal":382264,"en":"The fire they kindled was extinguished,"},{"id":"seytek-2012:p1112:b002:l014","ordinal":382265,"en":"The countless Kyrgyz, vast as a cliff,"},{"id":"seytek-2012:p1112:b002:l015","ordinal":382266,"en":"The ravenous brute sucked them dry"},{"id":"seytek-2012:p1112:b002:l016","ordinal":382267,"en":"And drove them all away."},{"id":"seytek-2012:p1112:b002:l017","ordinal":382268,"en":"It mauled whoever it encountered,"},{"id":"seytek-2012:p1112:b002:l018","ordinal":382269,"en":"And devoured whoever crossed its path,"},{"id":"seytek-2012:p1112:b002:l019","ordinal":382270,"en":"Leaving this land ownerless,"},{"id":"seytek-2012:p1112:b002:l020","ordinal":382271,"en":"Leaving many women widowed,"},{"id":"seytek-2012:p1112:b002:l021","ordinal":382272,"en":"While its hostile people settled there."},{"id":"seytek-2012:p1112:b002:l022","ordinal":382273,"en":"Plunged into calamitous misery,"},{"id":"seytek-2012:p1112:b002:l023","ordinal":382274,"en":"The ancient nation was massacred;"},{"id":"seytek-2012:p1112:b002:l024","ordinal":382275,"en":"Everything that so much as stirred"},{"id":"seytek-2012:p1112:b002:l025","ordinal":382276,"en":"Was swallowed from the east."},{"id":"seytek-2012:p1112:b002:l026","ordinal":382277,"en":"The crops they had sown"},{"id":"seytek-2012:p1112:b002:l027","ordinal":382278,"en":"Were reaped raw before they ripened."},{"id":"seytek-2012:p1112:b002:l028","ordinal":382279,"en":"Whoever dared resist"},{"id":"seytek-2012:p1112:b002:l029","ordinal":382280,"en":"Was swallowed like tribute and sucked dry."},{"id":"seytek-2012:p1112:b002:l030","ordinal":382281,"en":"The sword broke in the middle,"},{"id":"seytek-2012:p1112:b002:l031","ordinal":382282,"en":"And vanished from sight;"},{"id":"seytek-2012:p1112:b002:l032","ordinal":382283,"en":"Of that ill-fated disaster,"},{"id":"seytek-2012:p1112:b002:l033","ordinal":382284,"en":"No one knew where it had gone,"},{"id":"seytek-2012:p1112:b002:l034","ordinal":382285,"en":"It plunged daylight into night,"},{"id":"seytek-2012:p1112:b002:l035","ordinal":382286,"en":"And whoever dared resist"},{"id":"seytek-2012:p1112:b002:l036","ordinal":382287,"en":"Was cast into a pit with no return."},{"id":"seytek-2012:p1112:b002:l037","ordinal":382288,"en":"The Kyrgyz of this Ala-Too"},{"id":"seytek-2012:p1112:b002:l038","ordinal":382289,"en":"Were trapped in a precious net"},{"id":"seytek-2012:p1112:b002:l039","ordinal":382290,"en":"From which no struggle could free them."},{"id":"seytek-2012:p1112:b002:l040","ordinal":382291,"en":"“What could this mean?”"},{"id":"seytek-2012:p1112:b003:l001","ordinal":382292,"en":"So then that"},{"id":"seytek-2012:p1112:b003:l002","ordinal":382293,"en":"Ill-fated Perizada,"},{"id":"seytek-2012:p1112:b003:l003","ordinal":382294,"en":"A peerless mistress of wisdom,"},{"id":"seytek-2012:p1112:b003:l004","ordinal":382295,"en":"Recounted her many-colored dream,"},{"id":"seytek-2012:p1112:b003:l005","ordinal":382296,"en":"Telling all its wonders;"},{"id":"seytek-2012:p1112:b003:l006","ordinal":382297,"en":"Lady Perizada’s"},{"id":"seytek-2012:p1112:b003:l007","ordinal":382298,"en":"Clear account was thus."},{"id":"seytek-2012:p1112:b003:l008","ordinal":382299,"en":"Sobbing bitterly, she began to speak,"},{"id":"seytek-2012:p1112:b003:l009","ordinal":382300,"en":"And spoke in anguish:"},{"id":"seytek-2012:p1112:b003:l010","ordinal":382301,"en":"Some parts were blissful, others grievous,"},{"id":"seytek-2012:p1112:b003:l011","ordinal":382302,"en":"One was hell and one was paradise;"},{"id":"seytek-2012:p1112:b003:l012","ordinal":382303,"en":"She told the whole dream she had seen."},{"id":"seytek-2012:p1112:b003:l013","ordinal":382304,"en":"When he had heard this dream,"},{"id":"seytek-2012:p1112:b003:l014","ordinal":382305,"en":"Valiant leopard Seytek"},{"id":"seytek-2012:p1112:b003:l015","ordinal":382306,"en":"Rose and stirred from sleep,"},{"id":"seytek-2012:p1112:b003:l016","ordinal":382307,"en":"Alarmed for his beloved people,"},{"id":"seytek-2012:p1112:b003:l017","ordinal":382308,"en":"Wondering what would follow,"},{"id":"seytek-2012:p1112:b003:l018","ordinal":382309,"en":"And saddled Kulansur."},{"id":"seytek-2012:p1112:b003:l019","ordinal":382310,"en":"“For one whose mount prances proudly,"},{"id":"seytek-2012:p1112:b003:l020","ordinal":382311,"en":"May his road be fortunate when he rides;"},{"id":"seytek-2012:p1112:b003:l021","ordinal":382312,"en":"If it rears and strains against the rein,"},{"id":"seytek-2012:p1112:b003:l022","ordinal":382313,"en":"May it not chafe his hands.”"},{"id":"seytek-2012:p1112:b003:l023","ordinal":382314,"en":"A finely knotted, perfect halter,"},{"id":"seytek-2012:p1112:b003:l024","ordinal":382315,"en":"Fitted superbly just so,"},{"id":"seytek-2012:p1112:b003:l025","ordinal":382316,"en":"A halter made exactly for Kulansur."},{"id":"seytek-2012:p1112:b003:l026","ordinal":382317,"en":"A leather saddlecloth and blue saddle blanket,"},{"id":"seytek-2012:p1112:b003:l027","ordinal":382318,"en":"A white bearskin saddle pad,"},{"id":"seytek-2012:p1112:b003:l028","ordinal":382319,"en":"A fitting pad for a hero’s mount,"},{"id":"seytek-2012:p1112:b003:l029","ordinal":382320,"en":"Its pommel of pure gold,"},{"id":"seytek-2012:p1112:b003:l030","ordinal":382321,"en":"Its rear entirely of silver,"},{"id":"seytek-2012:p1112:b003:l031","ordinal":382322,"en":"Iron plates along both sides,"},{"id":"seytek-2012:p1112:b003:l032","ordinal":382323,"en":"Crafted with consummate skill;"},{"id":"seytek-2012:p1112:b003:l033","ordinal":382324,"en":"While his princely father still lived,"},{"id":"seytek-2012:p1112:b003:l034","ordinal":382325,"en":"Bölökbay, master of the forge,"},{"id":"seytek-2012:p1112:b003:l035","ordinal":382326,"en":"Had made it as a final bequest."},{"id":"seytek-2012:p1112:b003:l036","ordinal":382327,"en":"Can one who fears death ever prosper?"},{"id":"seytek-2012:p1112:b003:l037","ordinal":382328,"en":"In this fleeting mortal world,"},{"id":"seytek-2012:p1112:b003:l038","ordinal":382329,"en":"Can anyone possess an iron soul?"},{"id":"seytek-2012:p1112:b003:l039","ordinal":382330,"en":"Thinking this, brave Seytek"},{"id":"seytek-2012:p1112:b003:l040","ordinal":382331,"en":"Took the inherited white saddle, saying,"},{"id":"seytek-2012:p1113:b002:l001","ordinal":382332,"en":"“Let the hero saddle up and ride;"},{"id":"seytek-2012:p1113:b002:l002","ordinal":382333,"en":"If a mighty challenger comes,"},{"id":"seytek-2012:p1113:b002:l003","ordinal":382334,"en":"If a foe comes who can uproot mountains,"},{"id":"seytek-2012:p1113:b002:l004","ordinal":382335,"en":"Let him enter battle without retreating;"},{"id":"seytek-2012:p1113:b002:l005","ordinal":382336,"en":"Let him drive out his enemy’s soul"},{"id":"seytek-2012:p1113:b002:l006","ordinal":382337,"en":"And rout them all together;"},{"id":"seytek-2012:p1113:b002:l007","ordinal":382338,"en":"May it never chafe his back,"},{"id":"seytek-2012:p1113:b002:l008","ordinal":382339,"en":"Nor trouble the heart of its rider;"},{"id":"seytek-2012:p1113:b002:l009","ordinal":382340,"en":"Though he journey for six months,"},{"id":"seytek-2012:p1113:b002:l010","ordinal":382341,"en":"Though he ride the horse hard and long,"},{"id":"seytek-2012:p1113:b002:l011","ordinal":382342,"en":"Though he travel day and night,"},{"id":"seytek-2012:p1113:b002:l012","ordinal":382343,"en":"Let him not falter when battle begins;"},{"id":"seytek-2012:p1113:b002:l013","ordinal":382344,"en":"This white saddle was specially made"},{"id":"seytek-2012:p1113:b002:l014","ordinal":382345,"en":"So it would not press the horse’s flanks."},{"id":"seytek-2012:p1113:b002:l015","ordinal":382346,"en":"May those who come after Bölökbay"},{"id":"seytek-2012:p1113:b002:l016","ordinal":382347,"en":"Know his meticulous skill;"},{"id":"seytek-2012:p1113:b002:l017","ordinal":382348,"en":"When they remember him in desperate straits,"},{"id":"seytek-2012:p1113:b002:l018","ordinal":382349,"en":"May they think of us.”"},{"id":"seytek-2012:p1113:b002:l019","ordinal":382350,"en":"The White Saddle, fashioned with such care,"},{"id":"seytek-2012:p1113:b002:l020","ordinal":382351,"en":"Was set upon Kulansur,"},{"id":"seytek-2012:p1113:b002:l021","ordinal":382352,"en":"But the dear lion, proud as a cock,"},{"id":"seytek-2012:p1113:b002:l022","ordinal":382353,"en":"The valiant hero, did not stir."},{"id":"seytek-2012:p1113:b002:l023","ordinal":382354,"en":"The lady took his hand and embraced him,"},{"id":"seytek-2012:p1113:b002:l024","ordinal":382355,"en":"And softly spoke:"},{"id":"seytek-2012:p1113:b002:l025","ordinal":382356,"en":"“What fate awaits him?”"},{"id":"seytek-2012:p1113:b002:l026","ordinal":382357,"en":"He lay back without stirring,"},{"id":"seytek-2012:p1113:b002:l027","ordinal":382358,"en":"Revealing himself a lion among lions;"},{"id":"seytek-2012:p1113:b002:l028","ordinal":382359,"en":"The dark-blue warrior took no heed,"},{"id":"seytek-2012:p1113:b002:l029","ordinal":382360,"en":"But rejoiced at the thought of death."},{"id":"seytek-2012:p1113:b002:l030","ordinal":382361,"en":"Akjoltoy, son of Kutubiy,"},{"id":"seytek-2012:p1113:b002:l031","ordinal":382362,"en":"Whose valor equaled countless troops,"},{"id":"seytek-2012:p1113:b002:l032","ordinal":382363,"en":"Whose figure led the vanguard,"},{"id":"seytek-2012:p1113:b002:l033","ordinal":382364,"en":"Whose presence loomed in peril,"},{"id":"seytek-2012:p1113:b002:l034","ordinal":382365,"en":"Whose path was blessed when he went ahead,"},{"id":"seytek-2012:p1113:b002:l035","ordinal":382366,"en":"Who, when an implacable foe came"},{"id":"seytek-2012:p1113:b002:l036","ordinal":382367,"en":"And threatened his entrusted life,"},{"id":"seytek-2012:p1113:b002:l037","ordinal":382368,"en":"Alone was equal to countless troops,"},{"id":"seytek-2012:p1113:b002:l038","ordinal":382369,"en":"Mounted a horse like Kulansur,"},{"id":"seytek-2012:p1113:b002:l039","ordinal":382370,"en":"Put on his coat of tempered iron,"},{"id":"seytek-2012:p1113:b002:l040","ordinal":382371,"en":"Prepared his arms and took his spear,"},{"id":"seytek-2012:p1113:b004:l001","ordinal":382372,"en":"And girded on his naked sword."},{"id":"seytek-2012:p1113:b004:l002","ordinal":382373,"en":"Tall and broad-shouldered,"},{"id":"seytek-2012:p1113:b004:l003","ordinal":382374,"en":"He took a spear without a tassel,"},{"id":"seytek-2012:p1113:b004:l004","ordinal":382375,"en":"Turned its point and hastened"},{"id":"seytek-2012:p1113:b004:l005","ordinal":382376,"en":"To brave Seytek’s palace,"},{"id":"seytek-2012:p1113:b004:l006","ordinal":382377,"en":"To Perizada’s fortress;"},{"id":"seytek-2012:p1113:b004:l007","ordinal":382378,"en":"Gray-maned Joltoy now arrived."},{"id":"seytek-2012:p1113:b004:l008","ordinal":382379,"en":"At Akbermet’s palace,"},{"id":"seytek-2012:p1113:b004:l009","ordinal":382380,"en":"Before it stood a painted hitching post,"},{"id":"seytek-2012:p1113:b004:l010","ordinal":382381,"en":"And ten champions guarded the court;"},{"id":"seytek-2012:p1113:b004:l011","ordinal":382382,"en":"What a wondrous host to behold!"},{"id":"seytek-2012:p1113:b004:l012","ordinal":382383,"en":"Dark-eyed and radiant,"},{"id":"seytek-2012:p1113:b004:l013","ordinal":382384,"en":"With sable fringe and broad hair ornaments,"},{"id":"seytek-2012:p1113:b004:l014","ordinal":382385,"en":"Graceful beauties,"},{"id":"seytek-2012:p1113:b004:l015","ordinal":382386,"en":"With shining camel-calf eyes,"},{"id":"seytek-2012:p1113:b004:l016","ordinal":382387,"en":"With words sweeter than sugar,"},{"id":"seytek-2012:p1113:b004:l017","ordinal":382388,"en":"Waists like sheaths and faces like the moon,"},{"id":"seytek-2012:p1113:b004:l018","ordinal":382389,"en":"Serene beauties,"},{"id":"seytek-2012:p1113:b004:l019","ordinal":382390,"en":"Whose sight gladdened the heart,"},{"id":"seytek-2012:p1113:b004:l020","ordinal":382391,"en":"Serene and radiant women,"},{"id":"seytek-2012:p1113:b004:l021","ordinal":382392,"en":"Who entered the house with stately grace,"},{"id":"seytek-2012:p1113:b004:l022","ordinal":382393,"en":"True companions to heroes,"},{"id":"seytek-2012:p1113:b004:l023","ordinal":382394,"en":"Who understood their inmost secrets:"},{"id":"seytek-2012:p1113:b004:l024","ordinal":382395,"en":"The forty brides appointed for ceremony"},{"id":"seytek-2012:p1113:b004:l025","ordinal":382396,"en":"Saw Akjoltoy"},{"id":"seytek-2012:p1113:b004:l026","ordinal":382397,"en":"And darted forward like does,"},{"id":"seytek-2012:p1113:b004:l027","ordinal":382398,"en":"Showing all the skill"},{"id":"seytek-2012:p1113:b004:l028","ordinal":382399,"en":"Of those precious, luckless women;"},{"id":"seytek-2012:p1113:b004:l029","ordinal":382400,"en":"They streamed forth like arrows,"},{"id":"seytek-2012:p1113:b004:l030","ordinal":382401,"en":"And now took Joltoy’s horse,"},{"id":"seytek-2012:p1113:b004:l031","ordinal":382402,"en":"Helping the fortunate champion"},{"id":"seytek-2012:p1113:b004:l032","ordinal":382403,"en":"Down from his tall mount."},{"id":"seytek-2012:p1113:b004:l033","ordinal":382404,"en":"The white reins braided by forty companions"},{"id":"seytek-2012:p1113:b004:l034","ordinal":382405,"en":"Were drawn from Joltoy’s hand,"},{"id":"seytek-2012:p1113:b004:l035","ordinal":382406,"en":"And tied to the five-sided painted post,"},{"id":"seytek-2012:p1113:b004:l036","ordinal":382407,"en":"Inlaid with precious stones,"},{"id":"seytek-2012:p1113:b004:l037","ordinal":382408,"en":"Its every side"},{"id":"seytek-2012:p1113:b004:l038","ordinal":382409,"en":"Encrusted with pure gold,"},{"id":"seytek-2012:p1113:b004:l039","ordinal":382410,"en":"While its lower part"},{"id":"seytek-2012:p1113:b004:l040","ordinal":382411,"en":"Was sheathed entirely in silver."},{"id":"seytek-2012:p1114:b002:l001","ordinal":382412,"en":"When this post was planted,"},{"id":"seytek-2012:p1114:b002:l002","ordinal":382413,"en":"An immense part of the hero’s treasury"},{"id":"seytek-2012:p1114:b002:l003","ordinal":382414,"en":"Was spent upon it."},{"id":"seytek-2012:p1114:b002:l004","ordinal":382415,"en":"Akbermet’s forty brides"},{"id":"seytek-2012:p1114:b002:l005","ordinal":382416,"en":"Tied the horse with jingling ornaments,"},{"id":"seytek-2012:p1114:b002:l006","ordinal":382417,"en":"Their nimbleness beyond compare,"},{"id":"seytek-2012:p1114:b002:l007","ordinal":382418,"en":"Swiftly fastening it with a clatter."},{"id":"seytek-2012:p1114:b002:l008","ordinal":382419,"en":"Their splendor surpassed all others;"},{"id":"seytek-2012:p1114:b002:l009","ordinal":382420,"en":"Fragrant perfume billowed from them,"},{"id":"seytek-2012:p1114:b002:l010","ordinal":382421,"en":"They spoke serenely without laughter,"},{"id":"seytek-2012:p1114:b002:l011","ordinal":382422,"en":"And the brides smiled;"},{"id":"seytek-2012:p1114:b002:l012","ordinal":382423,"en":"The mortal soul of anyone"},{"id":"seytek-2012:p1114:b002:l013","ordinal":382424,"en":"Who beheld them trembled."},{"id":"seytek-2012:p1114:b002:l014","ordinal":382425,"en":"With matchless agility,"},{"id":"seytek-2012:p1114:b002:l015","ordinal":382426,"en":"They now drew open the door."},{"id":"seytek-2012:p1114:b002:l016","ordinal":382427,"en":"After Akjoltoy entered,"},{"id":"seytek-2012:p1114:b002:l017","ordinal":382428,"en":"The forty nimble brides"},{"id":"seytek-2012:p1114:b002:l018","ordinal":382429,"en":"Bustled about observing every custom,"},{"id":"seytek-2012:p1114:b002:l019","ordinal":382430,"en":"Set down slabs of rich mutton,"},{"id":"seytek-2012:p1114:b002:l020","ordinal":382431,"en":"And from potent black liquor"},{"id":"seytek-2012:p1114:b002:l021","ordinal":382432,"en":"Poured a brimming ox-head bowl"},{"id":"seytek-2012:p1114:b002:l022","ordinal":382433,"en":"Until its surface stood still."},{"id":"seytek-2012:p1114:b002:l023","ordinal":382434,"en":"The forty brides laughed in a row"},{"id":"seytek-2012:p1114:b002:l024","ordinal":382435,"en":"And, approaching dear Uncle Joltoy"},{"id":"seytek-2012:p1114:b002:l025","ordinal":382436,"en":"With graceful steps, offered it to him."},{"id":"seytek-2012:p1114:b002:l026","ordinal":382437,"en":"They also offered him"},{"id":"seytek-2012:p1114:b002:l027","ordinal":382438,"en":"Fresh yellow foaming kumis."},{"id":"seytek-2012:p1114:b002:l028","ordinal":382439,"en":"When brave Joltoy drank it,"},{"id":"seytek-2012:p1114:b002:l029","ordinal":382440,"en":"He readied himself like a hawk,"},{"id":"seytek-2012:p1114:b002:l030","ordinal":382441,"en":"And from dear Joltoy’s lips"},{"id":"seytek-2012:p1114:b002:l031","ordinal":382442,"en":"Came wisdom as if from the unseen."},{"id":"seytek-2012:p1114:b002:l032","ordinal":382443,"en":"His eyes could see afar;"},{"id":"seytek-2012:p1114:b002:l033","ordinal":382444,"en":"Wise gray-maned Joltoy"},{"id":"seytek-2012:p1114:b002:l034","ordinal":382445,"en":"Spoke slowly and with gravity:"},{"id":"seytek-2012:p1114:b002:l035","ordinal":382446,"en":"“Oh, my child Akbermet,"},{"id":"seytek-2012:p1114:b002:l036","ordinal":382447,"en":"If the famous rumor is true,"},{"id":"seytek-2012:p1114:b002:l037","ordinal":382448,"en":"If it is sound and not a lie,"},{"id":"seytek-2012:p1114:b002:l038","ordinal":382449,"en":"I have heard word from those who came"},{"id":"seytek-2012:p1114:b002:l039","ordinal":382450,"en":"That your proud gray-maned champion"},{"id":"seytek-2012:p1114:b002:l040","ordinal":382451,"en":"Has had a dream."},{"id":"seytek-2012:p1114:b003:l001","ordinal":382452,"en":"I have come and seen how you fare;"},{"id":"seytek-2012:p1114:b003:l002","ordinal":382453,"en":"My child, let us interpret the dream you told."},{"id":"seytek-2012:p1114:b003:l003","ordinal":382454,"en":"My child, if a black golden eagle takes prey,"},{"id":"seytek-2012:p1114:b003:l004","ordinal":382455,"en":"If a collared greyhound takes prey,"},{"id":"seytek-2012:p1114:b003:l005","ordinal":382456,"en":"If it tracks across the black earth,"},{"id":"seytek-2012:p1114:b003:l006","ordinal":382457,"en":"Then for the numberless Kyrgyz"},{"id":"seytek-2012:p1114:b003:l007","ordinal":382458,"en":"Your noble gray-maned Seytek"},{"id":"seytek-2012:p1114:b003:l008","ordinal":382459,"en":"Has become a stout house with walls"},{"id":"seytek-2012:p1114:b003:l009","ordinal":382460,"en":"Through which no storm or wind can pass;"},{"id":"seytek-2012:p1114:b003:l010","ordinal":382461,"en":"My child, he has become the ruin of the enemy he marked."},{"id":"seytek-2012:p1114:b003:l011","ordinal":382462,"en":"For the sons of the white-capped Kyrgyz,"},{"id":"seytek-2012:p1114:b003:l012","ordinal":382463,"en":"My child, your prince Seytek has become khan."},{"id":"seytek-2012:p1114:b003:l013","ordinal":382464,"en":"Guarding the court and ruling the people,"}]
