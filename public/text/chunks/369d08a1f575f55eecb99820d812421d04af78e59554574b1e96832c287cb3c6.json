[{"id":"manas-2010:p1508:b001:l018","ordinal":65025,"en":"Sarala with his stake-like neck"},{"id":"manas-2010:p1508:b001:l019","ordinal":65026,"en":"Almambet struck with his whip;"},{"id":"manas-2010:p1508:b001:l020","ordinal":65027,"en":"Sarala with his matted tail"},{"id":"manas-2010:p1508:b001:l021","ordinal":65028,"en":"Almambet roused to a quiver."},{"id":"manas-2010:p1508:b001:l022","ordinal":65029,"en":"Across the misty plain,"},{"id":"manas-2010:p1508:b001:l023","ordinal":65030,"en":"Without turning, he attacked"},{"id":"manas-2010:p1508:b001:l024","ordinal":65031,"en":"Kongurbay's army."},{"id":"manas-2010:p1508:b001:l025","ordinal":65032,"en":"Cutting through six thousand,"},{"id":"manas-2010:p1508:b001:l026","ordinal":65033,"en":"“Where is the vile Kalcha?” he cried,"},{"id":"manas-2010:p1508:b001:l027","ordinal":65034,"en":"Spearing all he reached."},{"id":"manas-2010:p1508:b001:l028","ordinal":65035,"en":"“Where is the ogre Kalcha?”"},{"id":"manas-2010:p1508:b001:l029","ordinal":65036,"en":"Without fearing death,"},{"id":"manas-2010:p1508:b001:l030","ordinal":65037,"en":"So the wolf-maned lion went,"},{"id":"manas-2010:p1508:b001:l031","ordinal":65038,"en":"Never saying, “I shall die in battle.”"},{"id":"manas-2010:p1508:b001:l032","ordinal":65039,"en":"The lion rang out, unconcerned;"},{"id":"manas-2010:p1508:b001:l033","ordinal":65040,"en":"Apart from Kongurbay,"},{"id":"manas-2010:p1508:b001:l034","ordinal":65041,"en":"He reckoned none worth his trouser hem."},{"id":"manas-2010:p1508:b001:l035","ordinal":65042,"en":"Through the seething multitude of Chinese"},{"id":"manas-2010:p1508:b001:l036","ordinal":65043,"en":"Almambet burst, splitting them in two."},{"id":"manas-2010:p1508:b001:l037","ordinal":65044,"en":"With corners looming in the haze,"},{"id":"manas-2010:p1508:b001:l038","ordinal":65045,"en":"With points rising dim and dark,"},{"id":"manas-2010:p1508:b001:l039","ordinal":65046,"en":"If you looked closely,"},{"id":"manas-2010:p1508:b001:l040","ordinal":65047,"en":"It was Kongurbay's fortress."},{"id":"manas-2010:p1508:b001:l041","ordinal":65048,"en":"Around the outside of that fortress,"},{"id":"manas-2010:p1508:b001:l042","ordinal":65049,"en":"Sparing none who grappled with them,"},{"id":"manas-2010:p1509:b001:l001","ordinal":65050,"en":"Killing those who fought them,"},{"id":"manas-2010:p1509:b001:l002","ordinal":65051,"en":"Were the renowned people of the monks."},{"id":"manas-2010:p1509:b001:l003","ordinal":65052,"en":"Finding a plan for the Chinese,"},{"id":"manas-2010:p1509:b001:l004","ordinal":65053,"en":"Sending them surging to bring distress,"},{"id":"manas-2010:p1509:b001:l005","ordinal":65054,"en":"The Kalcha was a wise warrior,"},{"id":"manas-2010:p1509:b001:l006","ordinal":65055,"en":"For all the people of Beijing"},{"id":"manas-2010:p1509:b001:l007","ordinal":65056,"en":"A fortress firmly planted."},{"id":"manas-2010:p1509:b001:l008","ordinal":65057,"en":"Who threw the whole world into turmoil,"},{"id":"manas-2010:p1509:b001:l009","ordinal":65058,"en":"Alöökö's Kongurbay,"},{"id":"manas-2010:p1509:b001:l010","ordinal":65059,"en":"Among round-headed humankind"},{"id":"manas-2010:p1509:b001:l011","ordinal":65060,"en":"Was born an outstanding hero."},{"id":"manas-2010:p1509:b001:l012","ordinal":65061,"en":"Not yielding to his prowess,"},{"id":"manas-2010:p1509:b001:l013","ordinal":65062,"en":"Azizkan's Almambet"},{"id":"manas-2010:p1509:b001:l014","ordinal":65063,"en":"Was sweeping his way inside."},{"id":"manas-2010:p1509:b001:l015","ordinal":65064,"en":"The many monks and Manchu,"},{"id":"manas-2010:p1509:b001:l016","ordinal":65065,"en":"Shattering all he met,"},{"id":"manas-2010:p1509:b001:l017","ordinal":65066,"en":"He was cutting his way through."},{"id":"manas-2010:p1509:b001:l018","ordinal":65067,"en":"Manas was born in Altai;"},{"id":"manas-2010:p1509:b001:l019","ordinal":65068,"en":"When he reached twelve,"},{"id":"manas-2010:p1509:b001:l020","ordinal":65069,"en":"He destroyed courts and took spoils."},{"id":"manas-2010:p1509:b001:l021","ordinal":65070,"en":"The leopard shattered the Oyrat,"},{"id":"manas-2010:p1509:b001:l022","ordinal":65071,"en":"Cutting a path through their midst,"},{"id":"manas-2010:p1509:b001:l023","ordinal":65072,"en":"Making Kokand cry in distress,"},{"id":"manas-2010:p1509:b001:l024","ordinal":65073,"en":"Making Talas his court,"},{"id":"manas-2010:p1509:b001:l025","ordinal":65074,"en":"Destroying every person,"},{"id":"manas-2010:p1509:b001:l026","ordinal":65075,"en":"Manas went cutting them down;"},{"id":"manas-2010:p1509:b001:l027","ordinal":65076,"en":"Shattering right and left,"},{"id":"manas-2010:p1509:b001:l028","ordinal":65077,"en":"Manas went slaughtering them."},{"id":"manas-2010:p1509:b001:l029","ordinal":65078,"en":"Pouring blood into dark water,"},{"id":"manas-2010:p1509:b001:l030","ordinal":65079,"en":"Receiving the holy khan's blessing,"},{"id":"manas-2010:p1509:b001:l031","ordinal":65080,"en":"He was named leopard Manas."},{"id":"manas-2010:p1509:b001:l032","ordinal":65081,"en":"While he acted thus,"},{"id":"manas-2010:p1509:b001:l033","ordinal":65082,"en":"When he ruled the people,"},{"id":"manas-2010:p1509:b001:l034","ordinal":65083,"en":"Found from the unseen world,"},{"id":"manas-2010:p1509:b001:l035","ordinal":65084,"en":"The Tashkeser Manas received"},{"id":"manas-2010:p1509:b001:l036","ordinal":65085,"en":"Was the mightiest of swords."},{"id":"manas-2010:p1509:b001:l037","ordinal":65086,"en":"Khan Bakay's Oykuma,"},{"id":"manas-2010:p1509:b001:l038","ordinal":65087,"en":"The Achalbars Azhybay received,"},{"id":"manas-2010:p1509:b001:l039","ordinal":65088,"en":"Almambet's Zhoybolot,"},{"id":"manas-2010:p1509:b001:l040","ordinal":65089,"en":"The Kolbolot Chubak received,"},{"id":"manas-2010:p1509:b001:l041","ordinal":65090,"en":"The Arkesken Syrgak received—"},{"id":"manas-2010:p1509:b001:l042","ordinal":65091,"en":"Those were the six keen steel blades."},{"id":"manas-2010:p1510:b001:l001","ordinal":65092,"en":"They brought joy to the precious soul;"},{"id":"manas-2010:p1510:b001:l002","ordinal":65093,"en":"They never shrank from a sweep."},{"id":"manas-2010:p1510:b001:l003","ordinal":65094,"en":"If swung in wrath,"},{"id":"manas-2010:p1510:b001:l004","ordinal":65095,"en":"They never returned without drinking blood."},{"id":"manas-2010:p1510:b001:l005","ordinal":65096,"en":"Six thousand Chinese, countless governors,"},{"id":"manas-2010:p1510:b001:l006","ordinal":65097,"en":"Kongurbay among them—"},{"id":"manas-2010:p1510:b001:l007","ordinal":65098,"en":"Zhoybolot in his hand,"},{"id":"manas-2010:p1510:b001:l008","ordinal":65099,"en":"Drawing it from the sheath and shouting,"},{"id":"manas-2010:p1510:b001:l009","ordinal":65100,"en":"Roaring like a dragon,"},{"id":"manas-2010:p1510:b001:l010","ordinal":65101,"en":"Among the Chinese before him"},{"id":"manas-2010:p1510:b001:l011","ordinal":65102,"en":"Almambet plunged."},{"id":"manas-2010:p1510:b001:l012","ordinal":65103,"en":"Those fleeing to the right,"},{"id":"manas-2010:p1510:b001:l013","ordinal":65104,"en":"Shattering them toward the hollow,"},{"id":"manas-2010:p1510:b001:l014","ordinal":65105,"en":"Almambet cut them down."},{"id":"manas-2010:p1510:b001:l015","ordinal":65106,"en":"Those fleeing to the left,"},{"id":"manas-2010:p1510:b001:l016","ordinal":65107,"en":"Striking left-handed, shooting right,"},{"id":"manas-2010:p1510:b001:l017","ordinal":65108,"en":"Almambet slaughtered them."},{"id":"manas-2010:p1510:b001:l018","ordinal":65109,"en":"Khan Baltay's Chubak"},{"id":"manas-2010:p1510:b001:l019","ordinal":65110,"en":"Charged in from one side."},{"id":"manas-2010:p1510:b001:l020","ordinal":65111,"en":"Heroes Almambet, Chubak and Syrgak,"},{"id":"manas-2010:p1510:b001:l021","ordinal":65112,"en":"Plunging among the Chinese,"},{"id":"manas-2010:p1510:b001:l022","ordinal":65113,"en":"Those daredevils brought them torment."},{"id":"manas-2010:p1510:b001:l023","ordinal":65114,"en":"Almambet drove a thousand"},{"id":"manas-2010:p1510:b001:l024","ordinal":65115,"en":"Toward the foothills;"},{"id":"manas-2010:p1510:b001:l025","ordinal":65116,"en":"About six thousand governors"},{"id":"manas-2010:p1510:b001:l026","ordinal":65117,"en":"Syrgak pursued."},{"id":"manas-2010:p1510:b001:l027","ordinal":65118,"en":"Among the champions in their very midst,"},{"id":"manas-2010:p1510:b001:l028","ordinal":65119,"en":"Chubak wrought slaughter."},{"id":"manas-2010:p1510:b001:l029","ordinal":65120,"en":"Among six thousand governors,"},{"id":"manas-2010:p1510:b001:l030","ordinal":65121,"en":"The foremost was Kongurbay."},{"id":"manas-2010:p1510:b001:l031","ordinal":65122,"en":"The black earth was drenched in blood;"},{"id":"manas-2010:p1510:b001:l032","ordinal":65123,"en":"Blood running down his flanks,"},{"id":"manas-2010:p1510:b001:l033","ordinal":65124,"en":"Hero Syrgak kept slaughtering."},{"id":"manas-2010:p1510:b001:l034","ordinal":65125,"en":"“What stratagem can I use?”"},{"id":"manas-2010:p1510:b001:l035","ordinal":65126,"en":"Watching from outside,"},{"id":"manas-2010:p1510:b001:l036","ordinal":65127,"en":"That damned Kalcha Kongurbay wondered."},{"id":"manas-2010:p1510:b001:l037","ordinal":65128,"en":"“As long as Syrgak lives,"},{"id":"manas-2010:p1510:b001:l038","ordinal":65129,"en":"For these Chinese here"},{"id":"manas-2010:p1510:b001:l039","ordinal":65130,"en":"The wide world is narrow."},{"id":"manas-2010:p1510:b001:l040","ordinal":65131,"en":"Among the Muslims,"},{"id":"manas-2010:p1510:b001:l041","ordinal":65132,"en":"He is worth their Manas."},{"id":"manas-2010:p1510:b001:l042","ordinal":65133,"en":"Multitude of Chinese, many Manchu,"},{"id":"manas-2010:p1511:b001:l001","ordinal":65134,"en":"Hear the words I say!"},{"id":"manas-2010:p1511:b001:l002","ordinal":65135,"en":"If we capture Syrgak,"},{"id":"manas-2010:p1511:b001:l003","ordinal":65136,"en":"Heaven has granted him to us!"},{"id":"manas-2010:p1511:b001:l004","ordinal":65137,"en":"If we do not capture Syrgak,"},{"id":"manas-2010:p1511:b001:l005","ordinal":65138,"en":"The Chinese will all die alike!"},{"id":"manas-2010:p1511:b001:l006","ordinal":65139,"en":"Syrgak's thrusting lance"},{"id":"manas-2010:p1511:b001:l007","ordinal":65140,"en":"I have watched three times."},{"id":"manas-2010:p1511:b001:l008","ordinal":65141,"en":"His skill is beyond the rest;"},{"id":"manas-2010:p1511:b001:l009","ordinal":65142,"en":"Even now it has not left"},{"id":"manas-2010:p1511:b001:l010","ordinal":65143,"en":"My deepest thoughts, that lance of his."},{"id":"manas-2010:p1511:b001:l011","ordinal":65144,"en":"His right shoulder is broad;"},{"id":"manas-2010:p1511:b001:l012","ordinal":65145,"en":"Outstanding Syrgak, that champion wretch,"},{"id":"manas-2010:p1511:b001:l013","ordinal":65146,"en":"Is a hero born among the Burut."},{"id":"manas-2010:p1511:b001:l014","ordinal":65147,"en":"His eyes are dimmed and misted;"},{"id":"manas-2010:p1511:b001:l015","ordinal":65148,"en":"He is swollen with pride now."},{"id":"manas-2010:p1511:b001:l016","ordinal":65149,"en":"Without feeling shame before Syrgak,"},{"id":"manas-2010:p1511:b001:l017","ordinal":65150,"en":"Let us pretend to flee;"},{"id":"manas-2010:p1511:b001:l018","ordinal":65151,"en":"Let us turn our horses' rumps to him!"},{"id":"manas-2010:p1511:b001:l019","ordinal":65152,"en":"Deceiving and coaxing Syrgak,"},{"id":"manas-2010:p1511:b001:l020","ordinal":65153,"en":"With a great army from the rear,"},{"id":"manas-2010:p1511:b001:l021","ordinal":65154,"en":"Let us hem him in with Chinese"},{"id":"manas-2010:p1511:b001:l022","ordinal":65155,"en":"And throw him into the dug pit!”"},{"id":"manas-2010:p1511:b001:l023","ordinal":65156,"en":"Before he had closed his mouth,"},{"id":"manas-2010:p1511:b001:l024","ordinal":65157,"en":"Your Syrgak wrought havoc."},{"id":"manas-2010:p1511:b001:l025","ordinal":65158,"en":"On the sloping ground he speared men;"},{"id":"manas-2010:p1511:b001:l026","ordinal":65159,"en":"He pierced seven together with one thrust."},{"id":"manas-2010:p1511:b001:l027","ordinal":65160,"en":"Marvels no other man could perform,"},{"id":"manas-2010:p1511:b001:l028","ordinal":65161,"en":"He performed as he came through."},{"id":"manas-2010:p1511:b001:l029","ordinal":65162,"en":"Behind him, Baychoro,"},{"id":"manas-2010:p1511:b001:l030","ordinal":65163,"en":"The Chinese fallen from their horses,"},{"id":"manas-2010:p1511:b001:l031","ordinal":65164,"en":"Leaving not a single one alive,"},{"id":"manas-2010:p1511:b001:l032","ordinal":65165,"en":"Came through slaughtering them."},{"id":"manas-2010:p1511:b001:l033","ordinal":65166,"en":"Seeing this, the countless governors"},{"id":"manas-2010:p1511:b001:l034","ordinal":65167,"en":"Lost the shafts from their hands;"},{"id":"manas-2010:p1511:b001:l035","ordinal":65168,"en":"The coverings slipped from their hearts."},{"id":"manas-2010:p1511:b001:l036","ordinal":65169,"en":"In their fear, the countless governors"},{"id":"manas-2010:p1511:b001:l037","ordinal":65170,"en":"Struck their battle drums once;"},{"id":"manas-2010:p1511:b001:l038","ordinal":65171,"en":"All of them fled together,"},{"id":"manas-2010:p1511:b001:l039","ordinal":65172,"en":"Charging toward Beijing."},{"id":"manas-2010:p1511:b001:l040","ordinal":65173,"en":"The Manchu stayed without fleeing."},{"id":"manas-2010:p1511:b001:l041","ordinal":65174,"en":"Amid the many Manchu,"},{"id":"manas-2010:p1511:b001:l042","ordinal":65175,"en":"Kongurbay lay concealed, watching Syrgak,"},{"id":"manas-2010:p1512:b001:l001","ordinal":65176,"en":"Keeping watch in ambush."},{"id":"manas-2010:p1512:b001:l002","ordinal":65177,"en":"When Syrgak came near,"},{"id":"manas-2010:p1512:b001:l003","ordinal":65178,"en":"Kongurbay, khan of Beijing,"},{"id":"manas-2010:p1512:b001:l004","ordinal":65179,"en":"Charged out with a roar."},{"id":"manas-2010:p1512:b001:l005","ordinal":65180,"en":"The Kalcha reached him from the side;"},{"id":"manas-2010:p1512:b001:l006","ordinal":65181,"en":"As soon as he reached Syrgak,"},{"id":"manas-2010:p1512:b001:l007","ordinal":65182,"en":"He struck hard and rode past."},{"id":"manas-2010:p1512:b001:l008","ordinal":65183,"en":"The lance flew into splinters,"},{"id":"manas-2010:p1512:b001:l009","ordinal":65184,"en":"Cracking into separate pieces."},{"id":"manas-2010:p1512:b001:l010","ordinal":65185,"en":"The Kalcha's thrust as he passed,"},{"id":"manas-2010:p1512:b001:l011","ordinal":65186,"en":"Your leopard warrior Syrgak"},{"id":"manas-2010:p1512:b001:l012","ordinal":65187,"en":"Met with a ringing, heedless ease;"},{"id":"manas-2010:p1512:b001:l013","ordinal":65188,"en":"The Kalcha wretch Kongurbay"},{"id":"manas-2010:p1512:b001:l014","ordinal":65189,"en":"He reckoned not worth his shin."},{"id":"manas-2010:p1512:b001:l015","ordinal":65190,"en":"When Kongurbay had thrust and passed,"},{"id":"manas-2010:p1512:b001:l016","ordinal":65191,"en":"All the Manchu reached him;"},{"id":"manas-2010:p1512:b001:l017","ordinal":65192,"en":"Circling round in many layers,"},{"id":"manas-2010:p1512:b001:l018","ordinal":65193,"en":"They surrounded him."},{"id":"manas-2010:p1512:b001:l019","ordinal":65194,"en":"As they stood surrounding him,"},{"id":"manas-2010:p1512:b001:l020","ordinal":65195,"en":"As he was left alone in their midst,"},{"id":"manas-2010:p1512:b001:l021","ordinal":65196,"en":"Syrgak thought this:"},{"id":"manas-2010:p1512:b001:l022","ordinal":65197,"en":"“When will my dear Almambet see me"},{"id":"manas-2010:p1512:b001:l023","ordinal":65198,"en":"And, while the Manchu surround me,"},{"id":"manas-2010:p1512:b001:l024","ordinal":65199,"en":"Come to give me support?”"},{"id":"manas-2010:p1512:b001:l025","ordinal":65200,"en":"His insides burned like embers;"},{"id":"manas-2010:p1512:b001:l026","ordinal":65201,"en":"Unable to put up even a dog's fight,"},{"id":"manas-2010:p1512:b001:l027","ordinal":65202,"en":"For as long as meat takes to cook,"},{"id":"manas-2010:p1512:b001:l028","ordinal":65203,"en":"Hero Syrgak stood dazed and frantic,"},{"id":"manas-2010:p1512:b001:l029","ordinal":65204,"en":"Unable to gather his senses."},{"id":"manas-2010:p1512:b001:l030","ordinal":65205,"en":"“For me to stand here dazed,"},{"id":"manas-2010:p1512:b001:l031","ordinal":65206,"en":"This is no tamarisk-covered plain,"},{"id":"manas-2010:p1512:b001:l032","ordinal":65207,"en":"No banks of ancestral Keng-Kol!"},{"id":"manas-2010:p1512:b001:l033","ordinal":65208,"en":"There is no Talas where we dwell;"},{"id":"manas-2010:p1512:b001:l034","ordinal":65209,"en":"Leaping along on Akkula,"},{"id":"manas-2010:p1512:b001:l035","ordinal":65210,"en":"Coming with a roar to strike,"},{"id":"manas-2010:p1512:b001:l036","ordinal":65211,"en":"My wolf-maned lion Manas is not here!”"},{"id":"manas-2010:p1512:b001:l037","ordinal":65212,"en":"So saying, hero Syrgak"},{"id":"manas-2010:p1512:b001:l038","ordinal":65213,"en":"Summoned courage, gritting his teeth;"},{"id":"manas-2010:p1512:b001:l039","ordinal":65214,"en":"He struck Kökchebich once,"},{"id":"manas-2010:p1512:b001:l040","ordinal":65215,"en":"And among the Manchu enclosing him"},{"id":"manas-2010:p1512:b001:l041","ordinal":65216,"en":"He plunged in attack."},{"id":"manas-2010:p1512:b001:l042","ordinal":65217,"en":"His eyes blazing like a lion's,"},{"id":"manas-2010:p1513:b001:l001","ordinal":65218,"en":"Giving them more of the same,"},{"id":"manas-2010:p1513:b001:l002","ordinal":65219,"en":"Hacking all he met to pieces,"},{"id":"manas-2010:p1513:b001:l003","ordinal":65220,"en":"Hero Syrgak went shouting,"},{"id":"manas-2010:p1513:b001:l004","ordinal":65221,"en":"“Where is that Kalcha? Where?”"},{"id":"manas-2010:p1513:b001:l005","ordinal":65222,"en":"Mountain-like Kongurbay"},{"id":"manas-2010:p1513:b001:l006","ordinal":65223,"en":"Stepped apart from his ranks;"},{"id":"manas-2010:p1513:b001:l007","ordinal":65224,"en":"He stood waiting for Syrgak,"},{"id":"manas-2010:p1513:b001:l008","ordinal":65225,"en":"Appearing straight before him."},{"id":"manas-2010:p1513:b001:l009","ordinal":65226,"en":"“Come to single combat, Syrgak wretch!"},{"id":"manas-2010:p1513:b001:l010","ordinal":65227,"en":"Let me spear you and split your gall!"},{"id":"manas-2010:p1513:b001:l011","ordinal":65228,"en":"That thing of yours marked by ritual,"},{"id":"manas-2010:p1513:b001:l012","ordinal":65229,"en":"Let me cut it off again!"},{"id":"manas-2010:p1513:b001:l013","ordinal":65230,"en":"Death-seeking Burut, Syrgak wretch,"},{"id":"manas-2010:p1513:b001:l014","ordinal":65231,"en":"Let me thrust my wolf-tongued lance;"},{"id":"manas-2010:p1513:b001:l015","ordinal":65232,"en":"Joining you with Manas,"},{"id":"manas-2010:p1513:b001:l016","ordinal":65233,"en":"Let me make you like an extinguished fire!”"},{"id":"manas-2010:p1513:b001:l017","ordinal":65234,"en":"Hearing this, hero Syrgak,"},{"id":"manas-2010:p1513:b001:l018","ordinal":65235,"en":"Smoke coming from his mouth,"},{"id":"manas-2010:p1513:b001:l019","ordinal":65236,"en":"Flame coming from his eyes,"},{"id":"manas-2010:p1513:b001:l020","ordinal":65237,"en":"Rumbled like a falling stone."},{"id":"manas-2010:p1513:b001:l021","ordinal":65238,"en":"As he gritted his white teeth,"},{"id":"manas-2010:p1513:b001:l022","ordinal":65239,"en":"They crumbled like millet."},{"id":"manas-2010:p1513:b001:l023","ordinal":65240,"en":"He charged at the Kalcha,"},{"id":"manas-2010:p1513:b001:l024","ordinal":65241,"en":"Roaring like a lion."},{"id":"manas-2010:p1513:b001:l025","ordinal":65242,"en":"Before hero Syrgak"},{"id":"manas-2010:p1513:b001:l026","ordinal":65243,"en":"Was a path for just one horse;"},{"id":"manas-2010:p1513:b001:l027","ordinal":65244,"en":"Prepared beforehand,"},{"id":"manas-2010:p1513:b001:l028","ordinal":65245,"en":"There was a deep pit dug."},{"id":"manas-2010:p1513:b001:l029","ordinal":65246,"en":"When Syrgak began his charge,"},{"id":"manas-2010:p1513:b001:l030","ordinal":65247,"en":"Almambet saw him from afar."},{"id":"manas-2010:p1513:b001:l031","ordinal":65248,"en":"“Now Syrgak is dead!” he cried,"},{"id":"manas-2010:p1513:b001:l032","ordinal":65249,"en":"Spurring right and left,"},{"id":"manas-2010:p1513:b001:l033","ordinal":65250,"en":"Lashing with his whip every which way."},{"id":"manas-2010:p1513:b001:l034","ordinal":65251,"en":"From afar he shouted, “Go!”"},{"id":"manas-2010:p1513:b001:l035","ordinal":65252,"en":"“O Syrgak!” he yelled."},{"id":"manas-2010:p1513:b001:l036","ordinal":65253,"en":"His many worries would not fit his chest;"},{"id":"manas-2010:p1513:b001:l037","ordinal":65254,"en":"Tears streamed in ten directions."},{"id":"manas-2010:p1513:b001:l038","ordinal":65255,"en":"He arrived before an arrow could;"},{"id":"manas-2010:p1513:b001:l039","ordinal":65256,"en":"Reaching Syrgak,"},{"id":"manas-2010:p1513:b001:l040","ordinal":65257,"en":"He caught hold of the reins,"},{"id":"manas-2010:p1513:b001:l041","ordinal":65258,"en":"Keeping him from reaching Kongurbay,"},{"id":"manas-2010:p1513:b001:l042","ordinal":65259,"en":"Making him rage and struggle,"},{"id":"manas-2010:p1514:b001:l001","ordinal":65260,"en":"Like a woman whose husband had died,"},{"id":"manas-2010:p1514:b001:l002","ordinal":65261,"en":"Making the leopard struggle,"},{"id":"manas-2010:p1514:b001:l003","ordinal":65262,"en":"He led him out and away."},{"id":"manas-2010:p1514:b001:l004","ordinal":65263,"en":"Then Almambet said this:"},{"id":"manas-2010:p1514:b001:l005","ordinal":65264,"en":"“That dark ridge shaped like a saddle"},{"id":"manas-2010:p1514:b001:l006","ordinal":65265,"en":"Is no ridge to cross without counsel;"},{"id":"manas-2010:p1514:b001:l007","ordinal":65266,"en":"Kongurbay, khan of the monks,"},{"id":"manas-2010:p1514:b001:l008","ordinal":65267,"en":"Is no warrior to slaughter without caution!"},{"id":"manas-2010:p1514:b001:l009","ordinal":65268,"en":"Whatever place it may be,"},{"id":"manas-2010:p1514:b001:l010","ordinal":65269,"en":"The land of Beijing is no place"},{"id":"manas-2010:p1514:b001:l011","ordinal":65270,"en":"To enter blindly!"},{"id":"manas-2010:p1514:b001:l012","ordinal":65271,"en":"To reach him now,"},{"id":"manas-2010:p1514:b001:l013","ordinal":65272,"en":"A rope's length in front of him"},{"id":"manas-2010:p1514:b001:l014","ordinal":65273,"en":"There is a pit he has dug;"},{"id":"manas-2010:p1514:b001:l015","ordinal":65274,"en":"Beyond the edge of the pit"},{"id":"manas-2010:p1514:b001:l016","ordinal":65275,"en":"Is a salt marsh where a horse will sink."},{"id":"manas-2010:p1514:b001:l017","ordinal":65276,"en":"Either when you fall into the pit"},{"id":"manas-2010:p1514:b001:l018","ordinal":65277,"en":"Or when your horse is bogged down,"},{"id":"manas-2010:p1514:b001:l019","ordinal":65278,"en":"To cut off your head,"},{"id":"manas-2010:p1514:b001:l020","ordinal":65279,"en":"There stands that mighty Kalcha.”"},{"id":"manas-2010:p1514:b001:l021","ordinal":65280,"en":"When your Almambet reached and rescued him,"}]
