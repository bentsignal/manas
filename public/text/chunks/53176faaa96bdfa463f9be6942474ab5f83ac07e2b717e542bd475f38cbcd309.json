[{"id":"semetey-2-2013:p1292:b004:l015","ordinal":285185,"en":"Shouting in frenzy,"},{"id":"semetey-2-2013:p1292:b004:l016","ordinal":285186,"en":"They summoned their warriors."},{"id":"semetey-2-2013:p1292:b004:l017","ordinal":285187,"en":"Enraged, Kanchoro"},{"id":"semetey-2-2013:p1292:b004:l018","ordinal":285188,"en":"Now issued his command to the multitude."},{"id":"semetey-2-2013:p1292:b004:l019","ordinal":285189,"en":"Jerking with every violent movement,"},{"id":"semetey-2-2013:p1292:b004:l020","ordinal":285190,"en":"This warrior Kanchoro,"},{"id":"semetey-2-2013:p1292:b004:l021","ordinal":285191,"en":"This black-hearted wretch,"},{"id":"semetey-2-2013:p1292:b004:l022","ordinal":285192,"en":"Drove the teeming black-clad Jediger"},{"id":"semetey-2-2013:p1292:b004:l023","ordinal":285193,"en":"Forward without leaving one behind."},{"id":"semetey-2-2013:p1292:b004:l024","ordinal":285194,"en":"As they surged upon the hero,"},{"id":"semetey-2-2013:p1292:b004:l025","ordinal":285195,"en":"The earth split with a roar."},{"id":"semetey-2-2013:p1292:b004:l026","ordinal":285196,"en":"Kanchoro swelled in menace,"},{"id":"semetey-2-2013:p1292:b004:l027","ordinal":285197,"en":"Roaring in a hundred ways;"},{"id":"semetey-2-2013:p1292:b004:l028","ordinal":285198,"en":"He raged like a ravenous stallion,"},{"id":"semetey-2-2013:p1292:b004:l029","ordinal":285199,"en":"Ready to seize"},{"id":"semetey-2-2013:p1292:b004:l030","ordinal":285200,"en":"An extravagant prize."},{"id":"semetey-2-2013:p1292:b004:l031","ordinal":285201,"en":"He stamped about in frenzy,"},{"id":"semetey-2-2013:p1292:b004:l032","ordinal":285202,"en":"Roaring like a demon,"},{"id":"semetey-2-2013:p1292:b004:l033","ordinal":285203,"en":"Wearing an unsheathed sword,"},{"id":"semetey-2-2013:p1292:b004:l034","ordinal":285204,"en":"Strutting and keeping watch."},{"id":"semetey-2-2013:p1292:b004:l035","ordinal":285205,"en":"The savage stood there,"},{"id":"semetey-2-2013:p1292:b004:l036","ordinal":285206,"en":"Boasting before the Jediger:"},{"id":"semetey-2-2013:p1292:b004:l037","ordinal":285207,"en":"“Teeming black-clad Jediger,"},{"id":"semetey-2-2013:p1292:b004:l038","ordinal":285208,"en":"If you flee, you have eaten filth!"},{"id":"semetey-2-2013:p1292:b004:l039","ordinal":285209,"en":"Your khan and beks are wailing—"},{"id":"semetey-2-2013:p1293:b003:l001","ordinal":285210,"en":"What else did you say?"},{"id":"semetey-2-2013:p1293:b003:l002","ordinal":285211,"en":"With your hero Kyyaz at your head,"},{"id":"semetey-2-2013:p1293:b003:l003","ordinal":285212,"en":"You flustered Jediger"},{"id":"semetey-2-2013:p1293:b003:l004","ordinal":285213,"en":"Stand there trembling,"},{"id":"semetey-2-2013:p1293:b003:l005","ordinal":285214,"en":"Thinking foolish thoughts."},{"id":"semetey-2-2013:p1293:b003:l006","ordinal":285215,"en":"All of you clamor together,"},{"id":"semetey-2-2013:p1293:b003:l007","ordinal":285216,"en":"Looking ready to flee;"},{"id":"semetey-2-2013:p1293:b003:l008","ordinal":285217,"en":"Your khan and beks assembled"},{"id":"semetey-2-2013:p1293:b003:l009","ordinal":285218,"en":"And said they would run away."},{"id":"semetey-2-2013:p1293:b003:l010","ordinal":285219,"en":"Damn you, Jediger!"},{"id":"semetey-2-2013:p1293:b003:l011","ordinal":285220,"en":"You have taken Kanchoro as your protector."},{"id":"semetey-2-2013:p1293:b003:l012","ordinal":285221,"en":"Jediger, for you this valiant hero"},{"id":"semetey-2-2013:p1293:b003:l013","ordinal":285222,"en":"Is one of the true gray wolves,"},{"id":"semetey-2-2013:p1293:b003:l014","ordinal":285223,"en":"The bright night granted by Providence,"},{"id":"semetey-2-2013:p1293:b003:l015","ordinal":285224,"en":"A hero not found even in a month’s search."},{"id":"semetey-2-2013:p1293:b003:l016","ordinal":285225,"en":"You boast and bluster, Jediger—"},{"id":"semetey-2-2013:p1293:b003:l017","ordinal":285226,"en":"Here is your champion who will devise a plan."},{"id":"semetey-2-2013:p1293:b003:l018","ordinal":285227,"en":"If Kanchoro finds the way,"},{"id":"semetey-2-2013:p1293:b003:l019","ordinal":285228,"en":"What complaint can you Jediger have?"},{"id":"semetey-2-2013:p1293:b003:l020","ordinal":285229,"en":"Keep it in mind, Jediger:"},{"id":"semetey-2-2013:p1293:b003:l021","ordinal":285230,"en":"Kanchoro is your champion."},{"id":"semetey-2-2013:p1293:b003:l022","ordinal":285231,"en":"While Kanchoro remains alive,"},{"id":"semetey-2-2013:p1293:b003:l023","ordinal":285232,"en":"Six mighty rivers cannot divide you."},{"id":"semetey-2-2013:p1293:b003:l024","ordinal":285233,"en":"Let all the world attack in force—"},{"id":"semetey-2-2013:p1293:b003:l025","ordinal":285234,"en":"For you Jediger there will be no death."},{"id":"semetey-2-2013:p1293:b003:l026","ordinal":285235,"en":"Seven mighty rivers cannot divide you;"},{"id":"semetey-2-2013:p1293:b003:l027","ordinal":285236,"en":"Let armies cover the earth,"},{"id":"semetey-2-2013:p1293:b003:l028","ordinal":285237,"en":"Let their multitudes flatten the land—"},{"id":"semetey-2-2013:p1293:b003:l029","ordinal":285238,"en":"There is no fortress where I will turn back."},{"id":"semetey-2-2013:p1293:b003:l030","ordinal":285239,"en":"Kanchoro is your swift stallion;"},{"id":"semetey-2-2013:p1293:b003:l031","ordinal":285240,"en":"For you Jediger there will be no calamity."},{"id":"semetey-2-2013:p1293:b003:l032","ordinal":285241,"en":"We broke down the gate"},{"id":"semetey-2-2013:p1293:b003:l033","ordinal":285242,"en":"Of that fool, the son of Manas, and drenched it in blood;"},{"id":"semetey-2-2013:p1293:b003:l034","ordinal":285243,"en":"We turned his black road to dust."},{"id":"semetey-2-2013:p1293:b003:l035","ordinal":285244,"en":"We made the livestock on his pastures fat spoils,"},{"id":"semetey-2-2013:p1293:b003:l036","ordinal":285245,"en":"And struck down his imperious lions,"},{"id":"semetey-2-2013:p1293:b003:l037","ordinal":285246,"en":"His rash and sullen-minded,"},{"id":"semetey-2-2013:p1293:b003:l038","ordinal":285247,"en":"Thunderously boasting warriors."},{"id":"semetey-2-2013:p1293:b003:l039","ordinal":285248,"en":"Across Jylgyn, Keң-Kol, and Talas"},{"id":"semetey-2-2013:p1293:b004:l001","ordinal":285249,"en":"We made our long spears dance;"},{"id":"semetey-2-2013:p1293:b004:l002","ordinal":285250,"en":"We cut down their great champions."},{"id":"semetey-2-2013:p1293:b004:l003","ordinal":285251,"en":"We made our warhorses prance on the passes"},{"id":"semetey-2-2013:p1293:b004:l004","ordinal":285252,"en":"And destroyed every one of their beks."},{"id":"semetey-2-2013:p1293:b004:l005","ordinal":285253,"en":"When Kanchoro grows enraged,"},{"id":"semetey-2-2013:p1293:b004:l006","ordinal":285254,"en":"He will make snow fall upon your passes;"},{"id":"semetey-2-2013:p1293:b004:l007","ordinal":285255,"en":"No—if you befriend him, Jediger,"},{"id":"semetey-2-2013:p1293:b004:l008","ordinal":285256,"en":"He will make bounty rain upon your people."},{"id":"semetey-2-2013:p1293:b004:l009","ordinal":285257,"en":"When my murderous fury seizes me,"},{"id":"semetey-2-2013:p1293:b004:l010","ordinal":285258,"en":"Not one of you will survive, Jediger!"},{"id":"semetey-2-2013:p1293:b004:l011","ordinal":285259,"en":"I am a deep-blue, rugged mountain pass"},{"id":"semetey-2-2013:p1293:b004:l012","ordinal":285260,"en":"No multitude can cross;"},{"id":"semetey-2-2013:p1293:b004:l013","ordinal":285261,"en":"I am a black wolf-lion"},{"id":"semetey-2-2013:p1293:b004:l014","ordinal":285262,"en":"No enemy can approach head-on."},{"id":"semetey-2-2013:p1293:b004:l015","ordinal":285263,"en":"I broke through the pass and opened a road;"},{"id":"semetey-2-2013:p1293:b004:l016","ordinal":285264,"en":"Laboring against the gray wolf,"},{"id":"semetey-2-2013:p1293:b004:l017","ordinal":285265,"en":"I attacked the whole earth."},{"id":"semetey-2-2013:p1293:b004:l018","ordinal":285266,"en":"When my heart turned toward one deed,"},{"id":"semetey-2-2013:p1293:b004:l019","ordinal":285267,"en":"I laid hands upon my own elder brother."},{"id":"semetey-2-2013:p1293:b004:l020","ordinal":285268,"en":"Damn you, Jediger—"},{"id":"semetey-2-2013:p1293:b004:l021","ordinal":285269,"en":"Look at the prize I have taken!"},{"id":"semetey-2-2013:p1293:b004:l022","ordinal":285270,"en":"If this is not a prize, what is?"},{"id":"semetey-2-2013:p1293:b004:l023","ordinal":285271,"en":"Formidable in weight and fierce in venom,"},{"id":"semetey-2-2013:p1293:b004:l024","ordinal":285272,"en":"I have spilled his yellow blood:"},{"id":"semetey-2-2013:p1293:b004:l025","ordinal":285273,"en":"He who would yield to no one in the world,"},{"id":"semetey-2-2013:p1293:b004:l026","ordinal":285274,"en":"Who would not yield even to the Flood,"},{"id":"semetey-2-2013:p1293:b004:l027","ordinal":285275,"en":"The most skillful of spearmen,"},{"id":"semetey-2-2013:p1293:b004:l028","ordinal":285276,"en":"The mightiest of brave men,"},{"id":"semetey-2-2013:p1293:b004:l029","ordinal":285277,"en":"The most precious of many lions,"},{"id":"semetey-2-2013:p1293:b004:l030","ordinal":285278,"en":"The champion of all gray wolves,"},{"id":"semetey-2-2013:p1293:b004:l031","ordinal":285279,"en":"A man excelling sixty others,"},{"id":"semetey-2-2013:p1293:b004:l032","ordinal":285280,"en":"The most skillful of spearmen—"},{"id":"semetey-2-2013:p1293:b004:l033","ordinal":285281,"en":"Külchoro, now taken captive,"},{"id":"semetey-2-2013:p1293:b004:l034","ordinal":285282,"en":"The mightiest among the multitude."},{"id":"semetey-2-2013:p1293:b004:l035","ordinal":285283,"en":"My relentless fury seized me;"},{"id":"semetey-2-2013:p1293:b004:l036","ordinal":285284,"en":"I greased my white-steel blade with blood."},{"id":"semetey-2-2013:p1293:b004:l037","ordinal":285285,"en":"My anger struck just now,"},{"id":"semetey-2-2013:p1293:b004:l038","ordinal":285286,"en":"And I brought down the heedless hero"},{"id":"semetey-2-2013:p1293:b004:l039","ordinal":285287,"en":"Whom they had raised with such care;"},{"id":"semetey-2-2013:p1294:b003:l001","ordinal":285288,"en":"I broke through the gorge and opened a road."},{"id":"semetey-2-2013:p1294:b003:l002","ordinal":285289,"en":"My domineering frenzy seized me;"},{"id":"semetey-2-2013:p1294:b003:l003","ordinal":285290,"en":"The man who shared my mother’s breast and grew beside me,"},{"id":"semetey-2-2013:p1294:b003:l004","ordinal":285291,"en":"My twin hero whose name rhymed with mine—"},{"id":"semetey-2-2013:p1294:b003:l005","ordinal":285292,"en":"I bound Külchoro."},{"id":"semetey-2-2013:p1294:b003:l006","ordinal":285293,"en":"When someone provokes my vengeance,"},{"id":"semetey-2-2013:p1294:b003:l007","ordinal":285294,"en":"I never retreat even before my own kin;"},{"id":"semetey-2-2013:p1294:b003:l008","ordinal":285295,"en":"When murderous rage seizes me,"},{"id":"semetey-2-2013:p1294:b003:l009","ordinal":285296,"en":"I will not give an inch to anyone nearby."},{"id":"semetey-2-2013:p1294:b003:l010","ordinal":285297,"en":"Close in, Jediger!"},{"id":"semetey-2-2013:p1294:b003:l011","ordinal":285298,"en":"If you are sons capable of taking revenge,"},{"id":"semetey-2-2013:p1294:b003:l012","ordinal":285299,"en":"Make ready, Jediger!"},{"id":"semetey-2-2013:p1294:b003:l013","ordinal":285300,"en":"With a cast-iron socket"},{"id":"semetey-2-2013:p1294:b003:l014","ordinal":285301,"en":"Fitted wide and deep,"},{"id":"semetey-2-2013:p1294:b003:l015","ordinal":285302,"en":"Yesterday, when he came out to fight"},{"id":"semetey-2-2013:p1294:b003:l016","ordinal":285303,"en":"The teeming black-clad Jediger,"},{"id":"semetey-2-2013:p1294:b003:l017","ordinal":285304,"en":"When he faced them head-on"},{"id":"semetey-2-2013:p1294:b003:l018","ordinal":285305,"en":"And thrust his spear with a roar,"},{"id":"semetey-2-2013:p1294:b003:l019","ordinal":285306,"en":"The spears were drenched in blood"},{"id":"semetey-2-2013:p1294:b003:l020","ordinal":285307,"en":"And lions fell dead upon the ground."},{"id":"semetey-2-2013:p1294:b003:l021","ordinal":285308,"en":"Külchoro charged in with a cry"},{"id":"semetey-2-2013:p1294:b003:l022","ordinal":285309,"en":"And unleashed terrible wrath;"},{"id":"semetey-2-2013:p1294:b003:l023","ordinal":285310,"en":"Your forefather, the gray wolf Toltoy,"},{"id":"semetey-2-2013:p1294:b003:l024","ordinal":285311,"en":"Külchoro slaughtered and left for dead."},{"id":"semetey-2-2013:p1294:b003:l025","ordinal":285312,"en":"Having lost their men, the Jediger"},{"id":"semetey-2-2013:p1294:b003:l026","ordinal":285313,"en":"Led home their ownerless horses."},{"id":"semetey-2-2013:p1294:b003:l027","ordinal":285314,"en":"‘Alas, my dear kinsman"},{"id":"semetey-2-2013:p1294:b003:l028","ordinal":285315,"en":"Died in such-and-such a place!’"},{"id":"semetey-2-2013:p1294:b003:l029","ordinal":285316,"en":"Thus the Jediger wailed."},{"id":"semetey-2-2013:p1294:b003:l030","ordinal":285317,"en":"He destroyed their young men in their prime,"},{"id":"semetey-2-2013:p1294:b003:l031","ordinal":285318,"en":"And felled their mightiest;"},{"id":"semetey-2-2013:p1294:b003:l032","ordinal":285319,"en":"He drove his wrathful spear deep,"},{"id":"semetey-2-2013:p1294:b003:l033","ordinal":285320,"en":"And slaughtered mighty Toltoy and Chynkojo,"},{"id":"semetey-2-2013:p1294:b003:l034","ordinal":285321,"en":"Leaving not one alive."},{"id":"semetey-2-2013:p1294:b003:l035","ordinal":285322,"en":"This Talas is no land for you;"},{"id":"semetey-2-2013:p1294:b003:l036","ordinal":285323,"en":"Külchoro’s people are not yours."},{"id":"semetey-2-2013:p1294:b003:l037","ordinal":285324,"en":"This blustering false slave—"},{"id":"semetey-2-2013:p1294:b003:l038","ordinal":285325,"en":"Gouge out his right shoulder,"},{"id":"semetey-2-2013:p1294:b003:l039","ordinal":285326,"en":"Flay his right flank,"},{"id":"semetey-2-2013:p1294:b004:l001","ordinal":285327,"en":"Gouge out his left shoulder."},{"id":"semetey-2-2013:p1294:b004:l002","ordinal":285328,"en":"Neither dead nor alive,"},{"id":"semetey-2-2013:p1294:b004:l003","ordinal":285329,"en":"Leave this evil-minded slave"},{"id":"semetey-2-2013:p1294:b004:l004","ordinal":285330,"en":"Stranded between the two states."},{"id":"semetey-2-2013:p1294:b004:l005","ordinal":285331,"en":"Hack him smooth and make him helpless;"},{"id":"semetey-2-2013:p1294:b004:l006","ordinal":285332,"en":"Make him a slave to the herdsmen."},{"id":"semetey-2-2013:p1294:b004:l007","ordinal":285333,"en":"Inflict your fiercest wrath;"},{"id":"semetey-2-2013:p1294:b004:l008","ordinal":285334,"en":"Upon this villain who played the hero,"},{"id":"semetey-2-2013:p1294:b004:l009","ordinal":285335,"en":"This boar who caused such turmoil,"},{"id":"semetey-2-2013:p1294:b004:l010","ordinal":285336,"en":"Take revenge from every quarter."},{"id":"semetey-2-2013:p1294:b004:l011","ordinal":285337,"en":"Though he was once a man apart,"},{"id":"semetey-2-2013:p1294:b004:l012","ordinal":285338,"en":"At heart he is our enemy."},{"id":"semetey-2-2013:p1294:b004:l013","ordinal":285339,"en":"When both his arms are gone,"},{"id":"semetey-2-2013:p1294:b004:l014","ordinal":285340,"en":"And only the hero’s shadow remains,"},{"id":"semetey-2-2013:p1294:b004:l015","ordinal":285341,"en":"Whip him, beat him, and flay him."},{"id":"semetey-2-2013:p1294:b004:l016","ordinal":285342,"en":"Gouge out his eyes and blind him;"},{"id":"semetey-2-2013:p1294:b004:l017","ordinal":285343,"en":"If he defies you again,"},{"id":"semetey-2-2013:p1294:b004:l018","ordinal":285344,"en":"Hack into the nape of his neck."},{"id":"semetey-2-2013:p1294:b004:l019","ordinal":285345,"en":"For beasts, ravens, and crows"},{"id":"semetey-2-2013:p1294:b004:l020","ordinal":285346,"en":"Make of him a proper feast."},{"id":"semetey-2-2013:p1294:b004:l021","ordinal":285347,"en":"Upon the enemy fallen into your hands,"},{"id":"semetey-2-2013:p1294:b004:l022","ordinal":285348,"en":"Inflict torment without restraint;"},{"id":"semetey-2-2013:p1294:b004:l023","ordinal":285349,"en":"Take the vengeance you have long harbored."},{"id":"semetey-2-2013:p1294:b004:l024","ordinal":285350,"en":"Drive this crippled wretch away."},{"id":"semetey-2-2013:p1294:b004:l025","ordinal":285351,"en":"Make him the slave of slaves;"},{"id":"semetey-2-2013:p1294:b004:l026","ordinal":285352,"en":"Torment him and take his life."},{"id":"semetey-2-2013:p1294:b004:l027","ordinal":285353,"en":"Beat him sick and stretch him on the rack;"},{"id":"semetey-2-2013:p1294:b004:l028","ordinal":285354,"en":"Deliver his punishment into our hands."},{"id":"semetey-2-2013:p1294:b004:l029","ordinal":285355,"en":"Devise exquisite tortures;"},{"id":"semetey-2-2013:p1294:b004:l030","ordinal":285356,"en":"Make him labor, beat him, club him,"},{"id":"semetey-2-2013:p1294:b004:l031","ordinal":285357,"en":"And subject him to a dog’s humiliation."},{"id":"semetey-2-2013:p1294:b004:l032","ordinal":285358,"en":"Break his spirit and fill him with pain;"},{"id":"semetey-2-2013:p1294:b004:l033","ordinal":285359,"en":"Dig into his sides until they become sores."},{"id":"semetey-2-2013:p1294:b004:l034","ordinal":285360,"en":"Beat him flat and stretch him like a hide;"},{"id":"semetey-2-2013:p1294:b004:l035","ordinal":285361,"en":"Thus deliver his punishment."},{"id":"semetey-2-2013:p1294:b004:l036","ordinal":285362,"en":"Take your boundless revenge."},{"id":"semetey-2-2013:p1294:b004:l037","ordinal":285363,"en":"Make him serve forty herdsmen and eighty slaves,"},{"id":"semetey-2-2013:p1294:b004:l038","ordinal":285364,"en":"Fetching their firewood and water;"},{"id":"semetey-2-2013:p1294:b004:l039","ordinal":285365,"en":"Make his soul smolder, and take his life."},{"id":"semetey-2-2013:p1295:b003:l001","ordinal":285366,"en":"Keep your anger in check,"},{"id":"semetey-2-2013:p1295:b003:l002","ordinal":285367,"en":"Show the living hell"},{"id":"semetey-2-2013:p1295:b003:l003","ordinal":285368,"en":"Take your life like this."},{"id":"semetey-2-2013:p1295:b003:l004","ordinal":285369,"en":"If you are a person, if you are a people,"},{"id":"semetey-2-2013:p1295:b003:l005","ordinal":285370,"en":"Listen, my dear,"},{"id":"semetey-2-2013:p1295:b003:l006","ordinal":285371,"en":"From this slave who sighs"},{"id":"semetey-2-2013:p1295:b003:l007","ordinal":285372,"en":"So take your revenge."},{"id":"semetey-2-2013:p1295:b003:l008","ordinal":285373,"en":"Do not read carefully."},{"id":"semetey-2-2013:p1295:b003:l009","ordinal":285374,"en":"By accident,"},{"id":"semetey-2-2013:p1295:b003:l010","ordinal":285375,"en":"Sleep on your elbows,"},{"id":"semetey-2-2013:p1295:b003:l011","ordinal":285376,"en":"Take it easy,"},{"id":"semetey-2-2013:p1295:b003:l012","ordinal":285377,"en":"Resting the soul on the hips,"},{"id":"semetey-2-2013:p1295:b003:l013","ordinal":285378,"en":"Lying down to sleep,"},{"id":"semetey-2-2013:p1295:b003:l014","ordinal":285379,"en":"Filled with milk,"},{"id":"semetey-2-2013:p1295:b003:l015","ordinal":285380,"en":"The curve is fleshy,"},{"id":"semetey-2-2013:p1295:b003:l016","ordinal":285381,"en":"Don't climb the slope awkwardly,"},{"id":"semetey-2-2013:p1295:b003:l017","ordinal":285382,"en":"Don't rest again,"},{"id":"semetey-2-2013:p1295:b003:l018","ordinal":285383,"en":"It's not good to say bad things."},{"id":"semetey-2-2013:p1295:b003:l019","ordinal":285384,"en":"There is no witch who does not suffer from evil spirits,"},{"id":"semetey-2-2013:p1295:b003:l020","ordinal":285385,"en":"If he rests, it's time"},{"id":"semetey-2-2013:p1295:b003:l021","ordinal":285386,"en":"There is no cure,"},{"id":"semetey-2-2013:p1295:b003:l022","ordinal":285387,"en":"Do not rest"},{"id":"semetey-2-2013:p1295:b003:l023","ordinal":285388,"en":"Put embers in the hearth,"},{"id":"semetey-2-2013:p1295:b003:l024","ordinal":285389,"en":"An iron bullet to the heart of this."},{"id":"semetey-2-2013:p1295:b003:l025","ordinal":285390,"en":"Hard work Kulchoro"},{"id":"semetey-2-2013:p1295:b003:l026","ordinal":285391,"en":"There is no such child in the nation"},{"id":"semetey-2-2013:p1295:b003:l027","ordinal":285392,"en":"If you are obese, this is the season."},{"id":"semetey-2-2013: