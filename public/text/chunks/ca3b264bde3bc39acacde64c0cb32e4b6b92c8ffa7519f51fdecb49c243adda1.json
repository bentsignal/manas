[{"id":"semetey-1-2013:p0466:b003:l033","ordinal":112641,"en":"Fierce Kanykei is not here."},{"id":"semetey-1-2013:p0466:b003:l034","ordinal":112642,"en":"The youngest of twelve daughters,"},{"id":"semetey-1-2013:p0466:b003:l035","ordinal":112643,"en":"God's beloved servant,"},{"id":"semetey-1-2013:p0466:b003:l036","ordinal":112644,"en":"If only Kanykei stood watching,"},{"id":"semetey-1-2013:p0466:b003:l037","ordinal":112645,"en":"Then let that fool Kokchokoz and Kozkaman"},{"id":"semetey-1-2013:p0466:b003:l038","ordinal":112646,"en":"Try to inflict their humiliation!"},{"id":"semetey-1-2013:p0466:b003:l039","ordinal":112647,"en":"When he grew enraged,"},{"id":"semetey-1-2013:p0466:b004:l001","ordinal":112648,"en":"He unleashed a tumult."},{"id":"semetey-1-2013:p0466:b004:l002","ordinal":112649,"en":"When his anger truly rose,"},{"id":"semetey-1-2013:p0466:b004:l003","ordinal":112650,"en":"He struck a camel flat:"},{"id":"semetey-1-2013:p0466:b004:l004","ordinal":112651,"en":"Akayar, the camel-lifter."},{"id":"semetey-1-2013:p0466:b004:l005","ordinal":112652,"en":"When I slaughtered a people with its lord,"},{"id":"semetey-1-2013:p0466:b004:l006","ordinal":112653,"en":"I captured him at four years old"},{"id":"semetey-1-2013:p0466:b004:l007","ordinal":112654,"en":"And brought him home, my champion."},{"id":"semetey-1-2013:p0466:b004:l008","ordinal":112655,"en":"Parted from my champion,"},{"id":"semetey-1-2013:p0466:b004:l009","ordinal":112656,"en":"I am left upon the open plain!”"},{"id":"semetey-1-2013:p0466:b004:l010","ordinal":112657,"en":"While King Manas, the dear lion,"},{"id":"semetey-1-2013:p0466:b004:l011","ordinal":112658,"en":"Was longing for them all,"},{"id":"semetey-1-2013:p0466:b004:l012","ordinal":112659,"en":"Your mighty lion Akayar"},{"id":"semetey-1-2013:p0466:b004:l013","ordinal":112660,"en":"Was standing watching,"},{"id":"semetey-1-2013:p0466:b004:l014","ordinal":112661,"en":"Holding his sword at the ready,"},{"id":"semetey-1-2013:p0466:b004:l015","ordinal":112662,"en":"Thinking this within himself:"},{"id":"semetey-1-2013:p0466:b004:l016","ordinal":112663,"en":"“If my precious Manas remembers me,"},{"id":"semetey-1-2013:p0466:b004:l017","ordinal":112664,"en":"I shall charge in shouting"},{"id":"semetey-1-2013:p0466:b004:l018","ordinal":112665,"en":"And rescue him from the Chinese.”"},{"id":"semetey-1-2013:p0466:b004:l019","ordinal":112666,"en":"At that time Akayar"},{"id":"semetey-1-2013:p0466:b004:l020","ordinal":112667,"en":"Was standing watching."},{"id":"semetey-1-2013:p0466:b004:l021","ordinal":112668,"en":"Akayar gave his full attention,"},{"id":"semetey-1-2013:p0466:b004:l022","ordinal":112669,"en":"And stood looking on,"},{"id":"semetey-1-2013:p0466:b004:l023","ordinal":112670,"en":"Not valuing his life so much as a hair."},{"id":"semetey-1-2013:p0466:b004:l024","ordinal":112671,"en":"For his precious, wolf-like Manas,"},{"id":"semetey-1-2013:p0466:b004:l025","ordinal":112672,"en":"To sacrifice himself,"},{"id":"semetey-1-2013:p0466:b004:l026","ordinal":112673,"en":"He was burning with desire."},{"id":"semetey-1-2013:p0466:b004:l027","ordinal":112674,"en":"When he heard the words that counted him,"},{"id":"semetey-1-2013:p0466:b004:l028","ordinal":112675,"en":"When generous Manas, the leopard,"},{"id":"semetey-1-2013:p0466:b004:l029","ordinal":112676,"en":"Cried out, ‘Akayar!’"},{"id":"semetey-1-2013:p0466:b004:l030","ordinal":112677,"en":"Without looking about him,"},{"id":"semetey-1-2013:p0466:b004:l031","ordinal":112678,"en":"Without sparing his threadlike life,"},{"id":"semetey-1-2013:p0466:b004:l032","ordinal":112679,"en":"Without looking all around,"},{"id":"semetey-1-2013:p0466:b004:l033","ordinal":112680,"en":"Without sparing his life at all,"},{"id":"semetey-1-2013:p0466:b004:l034","ordinal":112681,"en":"His eyes blazed like fire."},{"id":"semetey-1-2013:p0466:b004:l035","ordinal":112682,"en":"He all but died with rage."},{"id":"semetey-1-2013:p0466:b004:l036","ordinal":112683,"en":"His great teeth, broad as doors,"},{"id":"semetey-1-2013:p0466:b004:l037","ordinal":112684,"en":"He ground as though crushing millet."},{"id":"semetey-1-2013:p0466:b004:l038","ordinal":112685,"en":"His eyes blazed like a lion's."},{"id":"semetey-1-2013:p0466:b004:l039","ordinal":112686,"en":"Without stopping, raising his cry,"},{"id":"semetey-1-2013:p0467:b003:l001","ordinal":112687,"en":"A champion such as Akayar"},{"id":"semetey-1-2013:p0467:b003:l002","ordinal":112688,"en":"Was seized by bloodlust."},{"id":"semetey-1-2013:p0467:b003:l003","ordinal":112689,"en":"Told to take a hat, he cut off a head:"},{"id":"semetey-1-2013:p0467:b003:l004","ordinal":112690,"en":"Such an exceptional champion was he."},{"id":"semetey-1-2013:p0467:b003:l005","ordinal":112691,"en":"Told to spill blood, he spilled stomach contents:"},{"id":"semetey-1-2013:p0467:b003:l006","ordinal":112692,"en":"Such was the force he possessed."},{"id":"semetey-1-2013:p0467:b003:l007","ordinal":112693,"en":"Told to drink water, he drank poison:"},{"id":"semetey-1-2013:p0467:b003:l008","ordinal":112694,"en":"Such a rough, rugged hero was he."},{"id":"semetey-1-2013:p0467:b003:l009","ordinal":112695,"en":"Entering to help at the risk of death,"},{"id":"semetey-1-2013:p0467:b003:l010","ordinal":112696,"en":"Fighting men bent on killing,"},{"id":"semetey-1-2013:p0467:b003:l011","ordinal":112697,"en":"To your dear mother Kanykei,"},{"id":"semetey-1-2013:p0467:b003:l012","ordinal":112698,"en":"That sacred, fierce woman,"},{"id":"semetey-1-2013:p0467:b003:l013","ordinal":112699,"en":"That was when he sent word."},{"id":"semetey-1-2013:p0467:b003:l014","ordinal":112700,"en":"When they were about to finish him,"},{"id":"semetey-1-2013:p0467:b003:l015","ordinal":112701,"en":"Refusing to yield to Akayar,"},{"id":"semetey-1-2013:p0467:b003:l016","ordinal":112702,"en":"Your doomed, bloodthirsty father—"},{"id":"semetey-1-2013:p0467:b003:l017","ordinal":112703,"en":"When they were about to cut off his head,"},{"id":"semetey-1-2013:p0467:b003:l018","ordinal":112704,"en":"To plunder his valuables,"},{"id":"semetey-1-2013:p0467:b003:l019","ordinal":112705,"en":"To wreak such destruction,"},{"id":"semetey-1-2013:p0467:b003:l020","ordinal":112706,"en":"When the Chinese pressed in without turning,"},{"id":"semetey-1-2013:p0467:b003:l021","ordinal":112707,"en":"Your peerless father Manas—"},{"id":"semetey-1-2013:p0467:b003:l022","ordinal":112708,"en":"When they were about to take his head thus,"},{"id":"semetey-1-2013:p0467:b003:l023","ordinal":112709,"en":"To erase him from this world,"},{"id":"semetey-1-2013:p0467:b003:l024","ordinal":112710,"en":"To do away with him,"},{"id":"semetey-1-2013:p0467:b003:l025","ordinal":112711,"en":"When Kokchokoz and Kozkaman"},{"id":"semetey-1-2013:p0467:b003:l026","ordinal":112712,"en":"Were about to go to the khan of Chyn Kakan,"},{"id":"semetey-1-2013:p0467:b003:l027","ordinal":112713,"en":"His severed head fastened to them,"},{"id":"semetey-1-2013:p0467:b003:l028","ordinal":112714,"en":"Bearing their glad tidings,"},{"id":"semetey-1-2013:p0467:b003:l029","ordinal":112715,"en":"That Akayar there"},{"id":"semetey-1-2013:p0467:b003:l030","ordinal":112716,"en":"Rekindled his extinguished fire,"},{"id":"semetey-1-2013:p0467:b003:l031","ordinal":112717,"en":"Revived his dead soul,"},{"id":"semetey-1-2013:p0467:b003:l032","ordinal":112718,"en":"Joined what had broken in his life."},{"id":"semetey-1-2013:p0467:b003:l033","ordinal":112719,"en":"He did not stand watching without fighting."},{"id":"semetey-1-2013:p0467:b003:l034","ordinal":112720,"en":"With a furious shout,"},{"id":"semetey-1-2013:p0467:b003:l035","ordinal":112721,"en":"That Akayar charged in,"},{"id":"semetey-1-2013:p0467:b003:l036","ordinal":112722,"en":"The poor man raising ‘Manas!’ as his battle cry."},{"id":"semetey-1-2013:p0467:b003:l037","ordinal":112723,"en":"I, your bereaved, unfortunate mother,"},{"id":"semetey-1-2013:p0467:b003:l038","ordinal":112724,"en":"Have told you the tale; listen."},{"id":"semetey-1-2013:p0467:b003:l039","ordinal":112725,"en":"Let me tell you what happened."},{"id":"semetey-1-2013:p0467:b005:l001","ordinal":112726,"en":"Do not grieve, orphan; listen!"},{"id":"semetey-1-2013:p0467:b005:l002","ordinal":112727,"en":"As I speak these words,"},{"id":"semetey-1-2013:p0467:b005:l003","ordinal":112728,"en":"It was truly a lament to Allah."},{"id":"semetey-1-2013:p0467:b005:l004","ordinal":112729,"en":"His voice was heard, he was unseen:"},{"id":"semetey-1-2013:p0467:b005:l005","ordinal":112730,"en":"Upon your mother's shoulder,"},{"id":"semetey-1-2013:p0467:b005:l006","ordinal":112731,"en":"The suffering of six months ahead"},{"id":"semetey-1-2013:p0467:b005:l007","ordinal":112732,"en":"He could make known at once."},{"id":"semetey-1-2013:p0467:b005:l008","ordinal":112733,"en":"There was a naked child."},{"id":"semetey-1-2013:p0467:b005:l009","ordinal":112734,"en":"Your dear mother Kanykei"},{"id":"semetey-1-2013:p0467:b005:l010","ordinal":112735,"en":"Was a soul descended from saints."},{"id":"semetey-1-2013:p0467:b005:l011","ordinal":112736,"en":"‘God, who strikes men,"},{"id":"semetey-1-2013:p0467:b005:l012","ordinal":112737,"en":"Will surely strike,’ I feared."},{"id":"semetey-1-2013:p0467:b005:l013","ordinal":112738,"en":"‘Such tribulation, such dark deeds,"},{"id":"semetey-1-2013:p0467:b005:l014","ordinal":112739,"en":"These Kalmyks here"},{"id":"semetey-1-2013:p0467:b005:l015","ordinal":112740,"en":"Will commit,’ I feared."},{"id":"semetey-1-2013:p0467:b005:l016","ordinal":112741,"en":"My tears poured down,"},{"id":"semetey-1-2013:p0467:b005:l017","ordinal":112742,"en":"My heart was sorely shaken,"},{"id":"semetey-1-2013:p0467:b005:l018","ordinal":112743,"en":"My eyes were burning fire,"},{"id":"semetey-1-2013:p0467:b005:l019","ordinal":112744,"en":"My heart was burning coals."},{"id":"semetey-1-2013:p0467:b005:l020","ordinal":112745,"en":"Unable to be still, I grew agitated."},{"id":"semetey-1-2013:p0467:b005:l021","ordinal":112746,"en":"Your mother, built like a warrior,"},{"id":"semetey-1-2013:p0467:b005:l022","ordinal":112747,"en":"Was stirred that day."},{"id":"semetey-1-2013:p0467:b005:l023","ordinal":112748,"en":"My palms twitched, my eyes fluttered;"},{"id":"semetey-1-2013:p0467:b005:l024","ordinal":112749,"en":"I saw signs of suffering."},{"id":"semetey-1-2013:p0467:b005:l025","ordinal":112750,"en":"‘If they find the means, the Chinese"},{"id":"semetey-1-2013:p0467:b005:l026","ordinal":112751,"en":"Today upon my bloodthirsty lord"},{"id":"semetey-1-2013:p0467:b005:l027","ordinal":112752,"en":"Will bring some torment"},{"id":"semetey-1-2013:p0467:b005:l028","ordinal":112753,"en":"In this way,’ I feared."},{"id":"semetey-1-2013:p0467:b005:l029","ordinal":112754,"en":"My dear hair, thick as a girth strap,"},{"id":"semetey-1-2013:p0467:b005:l030","ordinal":112755,"en":"I bound tightly upon my crown."},{"id":"semetey-1-2013:p0467:b005:l031","ordinal":112756,"en":"Mail that no shot could pierce,"},{"id":"semetey-1-2013:p0467:b005:l032","ordinal":112757,"en":"I put on four layers."},{"id":"semetey-1-2013:p0467:b005:l033","ordinal":112758,"en":"‘Some devilry the Chinese"},{"id":"semetey-1-2013:p0467:b005:l034","ordinal":112759,"en":"Will devise,’ I feared."},{"id":"semetey-1-2013:p0467:b005:l035","ordinal":112760,"en":"He would not tire if ridden six months,"},{"id":"semetey-1-2013:p0467:b005:l036","ordinal":112761,"en":"Your father's Ak-kula,"},{"id":"semetey-1-2013:p0467:b005:l037","ordinal":112762,"en":"Foal of a young mare,"},{"id":"semetey-1-2013:p0467:b005:l038","ordinal":112763,"en":"The Duldul of the horse herds."},{"id":"semetey-1-2013:p0467:b005:l039","ordinal":112764,"en":"Feeding him millet from the rice fields,"},{"id":"semetey-1-2013:p0468:b003:l001","ordinal":112765,"en":"I trained him to a sweat each day."},{"id":"semetey-1-2013:p0468:b003:l002","ordinal":112766,"en":"Giving him barley from a hanging feedbag,"},{"id":"semetey-1-2013:p0468:b003:l003","ordinal":112767,"en":"I trained him to a sweat each month."},{"id":"semetey-1-2013:p0468:b003:l004","ordinal":112768,"en":"On that day when they would harm your father,"},{"id":"semetey-1-2013:p0468:b003:l005","ordinal":112769,"en":"I awoke with a start from sleep,"},{"id":"semetey-1-2013:p0468:b003:l006","ordinal":112770,"en":"Turned onto my right side,"},{"id":"semetey-1-2013:p0468:b003:l007","ordinal":112771,"en":"As dawn broke clear,"},{"id":"semetey-1-2013:p0468:b003:l008","ordinal":112772,"en":"Hurriedly said my prayers,"},{"id":"semetey-1-2013:p0468:b003:l009","ordinal":112773,"en":"And saddled Ak-kula."},{"id":"semetey-1-2013:p0468:b003:l010","ordinal":112774,"en":"From my currant-dark eyes,"},{"id":"semetey-1-2013:p0468:b003:l011","ordinal":112775,"en":"Tears streamed a whip's length."},{"id":"semetey-1-2013:p0468:b003:l012","ordinal":112776,"en":"From my quail-like eyes,"},{"id":"semetey-1-2013:p0468:b003:l013","ordinal":112777,"en":"Tears fell in separate streams."},{"id":"semetey-1-2013:p0468:b003:l014","ordinal":112778,"en":"The bones of my ribs seemed torn apart,"},{"id":"semetey-1-2013:p0468:b003:l015","ordinal":112779,"en":"The tears poured from my eyes."},{"id":"semetey-1-2013:p0468:b003:l016","ordinal":112780,"en":"‘What condition is my bloodthirsty lord in?’"},{"id":"semetey-1-2013:p0468:b003:l017","ordinal":112781,"en":"The thought tore my mind apart."},{"id":"semetey-1-2013:p0468:b003:l018","ordinal":112782,"en":"In the lowlands of broad Talas,"},{"id":"semetey-1-2013:p0468:b003:l019","ordinal":112783,"en":"The mullah who had come from Mecca—"},{"id":"semetey-1-2013:p0468:b003:l020","ordinal":112784,"en":"Without turning aside to call upon him,"},{"id":"semetey-1-2013:p0468:b003:l021","ordinal":112785,"en":"I, poor soul, entered"},{"id":"semetey-1-2013:p0468:b003:l022","ordinal":112786,"en":"Kazkaman's great yurt."},{"id":"semetey-1-2013:p0468:b003:l023","ordinal":112787,"en":"When I came near the great yurt,"},{"id":"semetey-1-2013:p0468:b003:l024","ordinal":112788,"en":"As dawn broke clear,"},{"id":"semetey-1-2013:p0468:b003:l025","ordinal":112789,"en":"When light touched the earth,"},{"id":"semetey-1-2013:p0468:b003:l026","ordinal":112790,"en":"Kozkaman's champions"},{"id":"semetey-1-2013:p0468:b003:l027","ordinal":112791,"en":"Were rushing about in a flurry."},{"id":"semetey-1-2013:p0468:b003:l028","ordinal":112792,"en":"I saw their faces changed,"},{"id":"semetey-1-2013:p0468:b003:l029","ordinal":112793,"en":"Caught in a calamity."},{"id":"semetey-1-2013:p0468:b003:l030","ordinal":112794,"en":"When I looked at some champions,"},{"id":"semetey-1-2013:p0468:b003:l031","ordinal":112795,"en":"They seemed like men whose wives were spirit-stricken,"},{"id":"semetey-1-2013:p0468:b003:l032","ordinal":112796,"en":"Like fugitives with pursuers close behind."},{"id":"semetey-1-2013:p0468:b003:l033","ordinal":112797,"en":"When I looked at other champions,"},{"id":"semetey-1-2013:p0468:b003:l034","ordinal":112798,"en":"They seemed to be pursuing their quarry,"},{"id":"semetey-1-2013:p0468:b003:l035","ordinal":112799,"en":"As though their wives had borne sons."},{"id":"semetey-1-2013:p0468:b003:l036","ordinal":112800,"en":"Taking their swords, they hurried about;"},{"id":"semetey-1-2013:p0468:b003:l037","ordinal":112801,"en":"Their leaders of ten bobbed in their saddles."},{"id":"semetey-1-2013:p0468:b003:l038","ordinal":112802,"en":"From Kokchokoz's great yurt,"},{"id":"semetey-1-2013:p0468:b003:l039","ordinal":112803,"en":"Spears and swords jutted up."},{"id":"semetey-1-2013:p0468:b004:l001","ordinal":112804,"en":"Pale mottled pennants and red banners,"},{"id":"semetey-1-2013:p0468:b004:l002","ordinal":112805,"en":"Within Kozkaman's house,"},{"id":"semetey-1-2013:p0468:b004:l003","ordinal":112806,"en":"A tumult of ‘Woe!’ and shouting."},{"id":"semetey-1-2013:p0468:b004:l004","ordinal":112807,"en":"Crescent standards and red banners,"},{"id":"semetey-1-2013:p0468:b004:l005","ordinal":112808,"en":"Within that Kalmyk's house,"},{"id":"semetey-1-2013:p0468:b004:l006","ordinal":112809,"en":"Piercing cries and turmoil."},{"id":"semetey-1-2013:p0468:b004:l007","ordinal":112810,"en":"When I looked carefully,"},{"id":"semetey-1-2013:p0468:b004:l008","ordinal":112811,"en":"A faint voice thudded out."},{"id":"semetey-1-2013:p0468:b004:l009","ordinal":112812,"en":"As I attended here and there,"},{"id":"semetey-1-2013:p0468:b004:l010","ordinal":112813,"en":"Raising ‘Manas!’ as the battle cry,"},{"id":"semetey-1-2013:p0468:b004:l011","ordinal":112814,"en":"It was Akayar's voice,"},{"id":"semetey-1-2013:p0468:b004:l012","ordinal":112815,"en":"Booming out now and then."},{"id":"semetey-1-2013:p0468:b004:l013","ordinal":112816,"en":"God, who strikes men,"},{"id":"semetey-1-2013:p0468:b004:l014","ordinal":112817,"en":"Had struck him utterly."},{"id":"semetey-1-2013:p0468:b004:l015","ordinal":112818,"en":"Your leopard father, the bloodthirsty lion,"},{"id":"semetey-1-2013:p0468:b004:l016","ordinal":112819,"en":"Had drunk much poison from the Kalmyks."},{"id":"semetey-1-2013:p0468:b004:l017","ordinal":112820,"en":"Between life and death,"},{"id":"semetey-1-2013:p0468:b004:l018","ordinal":112821,"en":"His thin moustache drooping,"},{"id":"semetey-1-2013:p0468:b004:l019","ordinal":112822,"en":"As though about to depart for Judgment,"},{"id":"semetey-1-2013:p0468:b004:l020","ordinal":112823,"en":"Your father was utterly undone."},{"id":"semetey-1-2013:p0468:b004:l021","ordinal":112824,"en":"Akayar grew furious."},{"id":"semetey-1-2013:p0468:b004:l022","ordinal":112825,"en":"May I be sacrificed to God!"},{"id":"semetey-1-2013:p0468:b004:l023","ordinal":112826,"en":"Without concern for his own safety,"},{"id":"semetey-1-2013:p0468:b004:l024","ordinal":112827,"en":"He counted all the Chinese champions"},{"id":"semetey-1-2013:p0468:b004:l025","ordinal":112828,"en":"As nothing beside him."},{"id":"semetey-1-2013:p0468:b004:l026","ordinal":112829,"en":"Valor and a champion's strength,"},{"id":"semetey-1-2013:p0468:b004:l027","ordinal":112830,"en":"Allah Almighty, the one God,"},{"id":"semetey-1-2013:p0468:b004:l028","ordinal":112831,"en":"Had given him beyond measure."},{"id":"semetey-1-2013:p0468:b004:l029","ordinal":112832,"en":"Coughing in fury,"},{"id":"semetey-1-2013:p0468:b004:l030","ordinal":112833,"en":"Your father, vast as Ala-Too,"},{"id":"semetey-1-2013:p0468:b004:l031","ordinal":112834,"en":"The exceptional champion Akayar"},{"id":"semetey-1-2013:p0468:b004:l032","ordinal":112835,"en":"Lifted like a young child."},{"id":"semetey-1-2013:p0468:b004:l033","ordinal":112836,"en":"Your father, heavy as lead,"},{"id":"semetey-1-2013:p0468:b004:l034","ordinal":112837,"en":"He carried running, without stopping."},{"id":"semetey-1-2013:p0468:b004:l035","ordinal":112838,"en":"In Kozkaman's great yurt,"},{"id":"semetey-1-2013:p0468:b004:l036","ordinal":112839,"en":"He showed himself a hero."},{"id":"semetey-1-2013:p0468:b004:l037","ordinal":112840,"en":"Your mountain-like leopard father"},{"id":"semetey-1-2013:p0468:b004:l038","ordinal":112841,"en":"In Kozkaman's doorway,"},{"id":"semetey-1-2013:p0468:b004:l039","ordinal":112842,"en":"Caught crosswise."},{"id":"semetey-1-2013:p0469:b003:l001","ordinal":112843,"en":"Akayar did not stop."},{"id":"semetey-1-2013:p0469:b003:l002","ordinal":112844,"en":"Dying and disappearing,"},{"id":"semetey-1-2013:p0469:b003:l003","ordinal":112845,"en":"Your ocean-like father lay upon his back."},{"id":"semetey-1-2013:p0469:b003:l004","ordinal":112846,"en":"Quivering like a fur cap,"},{"id":"semetey-1-2013:p0469:b003:l005","ordinal":112847,"en":"Kozkaman's great yurt,"},{"id":"semetey-1-2013:p0469:b003:l006","ordinal":112848,"en":"Its lattice walls shattered."},{"id":"semetey-1-2013:p0469:b003:l007","ordinal":112849,"en":"Such was Akayar's valor,"},{"id":"semetey-1-2013:p0469:b003:l008","ordinal":112850,"en":"For your wolf-like father Manas,"},{"id":"semetey-1-2013:p0469:b003:l009","ordinal":112851,"en":"Such was the lion's service he performed."},{"id":"semetey-1-2013:p0469:b003:l010","ordinal":112852,"en":"Your father's body"},{"id":"semetey-1-2013:p0469:b003:l011","ordinal":112853,"en":"In Akayar's arms"},{"id":"semetey-1-2013:p0469:b003:l012","ordinal":112854,"en":"Looked like that of a dead man."},{"id":"semetey-1-2013:p0469:b003:l013","ordinal":112855,"en":"I, your unfortunate mother,"},{"id":"semetey-1-2013:p0469:b003:l014","ordinal":112856,"en":"Shed tears from my eyes."},{"id":"semetey-1-2013:p0469:b003:l015","ordinal":112857,"en":"Striking Ak-kula on the thigh,"},{"id":"semetey-1-2013:p0469:b003:l016","ordinal":112858,"en":"Into the foremost group of Kalmyks"},{"id":"semetey-1-2013:p0469:b003:l017","ordinal":112859,"en":"I plunged and attacked."},{"id":"semetey-1-2013:p0469:b003:l018","ordinal":112860,"en":"Those who came face to face,"},{"id":"semetey-1-2013:p0469:b003:l019","ordinal":112861,"en":"I sent sprawling with my axe."},{"id":"semetey-1-2013:p0469:b003:l020","ordinal":112862,"en":"Those who came upon my flank,"},{"id":"semetey-1-2013:p0469:b003:l021","ordinal":112863,"en":"I made dance with my sword."},{"id":"semetey-1-2013:p0469:b003:l022","ordinal":112864,"en":"Their champions standing farther off,"},{"id":"semetey-1-2013:p0469:b003:l023","ordinal":112865,"en":"I sent sprawling with my spear."},{"id":"semetey-1-2013:p0469:b003:l024","ordinal":112866,"en":"Fighting in distress,"},{"id":"semetey-1-2013:p0469:b003:l025","ordinal":112867,"en":"Caught in a tumult,"},{"id":"semetey-1-2013:p0469:b003:l026","ordinal":112868,"en":"As I struck and struggled,"},{"id":"semetey-1-2013:p0469:b003:l027","ordinal":112869,"en":"Azhybai and Khan Bakai were absent,"},{"id":"semetey-1-2013:p0469:b003:l028","ordinal":112870,"en":"All forty choros were absent,"},{"id":"semetey-1-2013:p0469:b003:l029","ordinal":112871,"en":"Almambet and Chubak, the pair, were absent,"},{"id":"semetey-1-2013:p0469:b003:l030","ordinal":112872,"en":"Serek and Syrgak were both absent."},{"id":"semetey-1-2013:p0469:b003:l031","ordinal":112873,"en":"Such is this filthy world!"},{"id":"semetey-1-2013:p0469:b003:l032","ordinal":112874,"en":"Thick embers fell upon my head:"},{"id":"semetey-1-2013:p0469:b003:l033","ordinal":112875,"en":"Kozkaman and Kokchokoz"},{"id":"semetey-1-2013:p0469:b003:l034","ordinal":112876,"en":"Fired thick volleys of shot!"},{"id":"semetey-1-2013:p0469:b003:l035","ordinal":112877,"en":"Upon me, your unfortunate mother,"},{"id":"semetey-1-2013:p0469:b003:l036","ordinal":112878,"en":"The blows of many bullets struck."},{"id":"semetey-1-2013:p0469:b003:l037","ordinal":112879,"en":"My head was covered in blood."},{"id":"semetey-1-2013:p0469:b003:l038","ordinal":112880,"en":"My two flailing arms"},{"id":"semetey-1-2013:p0469:b003:l039","ordinal":112881,"en":"Could no longer rise, limp and powerless."},{"id":"semetey-1-2013:p0469:b004:l001","ordinal":112882,"en":"My whole body"},{"id":"semetey-1-2013:p0469:b004:l002","ordinal":112883,"en":"Was covered in dark, clotted blood."},{"id":"semetey-1-2013:p0469:b004:l003","ordinal":112884,"en":"My fly-like life cried out."},{"id":"semetey-1-2013:p0469:b004:l004","ordinal":112885,"en":"All my weapons"},{"id":"semetey-1-2013:p0469:b004:l005","ordinal":112886,"en":"Shattered under battle-axe blows."},{"id":"semetey-1-2013:p0469:b004:l006","ordinal":112887,"en":"Because of your bloodthirsty father,"},{"id":"semetey-1-2013:p0469:b004:l007","ordinal":112888,"en":"I, a woman, was left to face it."},{"id":"semetey-1-2013:p0469:b004:l008","ordinal":112889,"en":"Your bloodthirsty father was drunk;"},{"id":"semetey-1-2013:p0469:b004:l009","ordinal":112890,"en":"Your wretched mother Kanykei"},{"id":"semetey-1-2013:p0469:b004:l010","ordinal":112891,"en":"Fought with the Kalmyks."},{"id":"semetey-1-2013:p0469:b004:l011","ordinal":112892,"en":"That Kalmyk's intention—"},{"id":"semetey-1-2013:p0469:b004:l012","ordinal":112893,"en":"Evil intent showed in his eyes,"},{"id":"semetey-1-2013:p0469:b004:l013","ordinal":112894,"en":"Evasion lay in his words."},{"id":"semetey-1-2013:p0469:b004:l014","ordinal":112895,"en":"He meant to strike me down if he could."},{"id":"semetey-1-2013:p0469:b004:l015","ordinal":112896,"en":"Malice showed in his eyes;"}]
