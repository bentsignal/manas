[{"id":"semetey-1-2013:p0479:b004:l012","ordinal":113665,"en":"You have no time to lie about in such grandeur."},{"id":"semetey-1-2013:p0479:b004:l013","ordinal":113666,"en":"He who made you masters of treasure,"},{"id":"semetey-1-2013:p0479:b004:l014","ordinal":113667,"en":"Alas, your khan Manas is gone."},{"id":"semetey-1-2013:p0479:b004:l015","ordinal":113668,"en":"Bereft of Khan Manas,"},{"id":"semetey-1-2013:p0479:b004:l016","ordinal":113669,"en":"Think, forty companions:"},{"id":"semetey-1-2013:p0479:b004:l017","ordinal":113670,"en":"You have no time for games."},{"id":"semetey-1-2013:p0479:b004:l018","ordinal":113671,"en":"When the merry dawn broke,"},{"id":"semetey-1-2013:p0479:b004:l019","ordinal":113672,"en":"You forty companions made merry,"},{"id":"semetey-1-2013:p0479:b004:l020","ordinal":113673,"en":"Kymyz by day and girls by night,"},{"id":"semetey-1-2013:p0479:b004:l021","ordinal":113674,"en":"Laughing and playing all the while."},{"id":"semetey-1-2013:p0479:b004:l022","ordinal":113675,"en":"Those warriors who came from Beijing,"},{"id":"semetey-1-2013:p0479:b004:l023","ordinal":113676,"en":"With valiant, gray-maned Manas—"},{"id":"semetey-1-2013:p0479:b004:l024","ordinal":113677,"en":"Those men who claimed kinship—"},{"id":"semetey-1-2013:p0479:b004:l025","ordinal":113678,"en":"Have eaten his well-nourished foal."},{"id":"semetey-1-2013:p0479:b004:l026","ordinal":113679,"en":"Spurring on and fighting,"},{"id":"semetey-1-2013:p0479:b004:l027","ordinal":113680,"en":"They claimed to be his brothers of equal birth!"},{"id":"semetey-1-2013:p0479:b004:l028","ordinal":113681,"en":"Unsuspecting, gray-maned Manas"},{"id":"semetey-1-2013:p0479:b004:l029","ordinal":113682,"en":"They repeatedly invited to feast"},{"id":"semetey-1-2013:p0479:b004:l030","ordinal":113683,"en":"And gave a poison that silenced him."},{"id":"semetey-1-2013:p0479:b004:l031","ordinal":113684,"en":"Noble Kanykei,"},{"id":"semetey-1-2013:p0479:b004:l032","ordinal":113685,"en":"Standing by the sultan,"},{"id":"semetey-1-2013:p0479:b004:l033","ordinal":113686,"en":"While they scattered his treasure,"},{"id":"semetey-1-2013:p0479:b004:l034","ordinal":113687,"en":"Carried the generous lord away"},{"id":"semetey-1-2013:p0479:b004:l035","ordinal":113688,"en":"And fled toward Mecca—"},{"id":"semetey-1-2013:p0479:b004:l036","ordinal":113689,"en":"Such scattered rumors reach me."},{"id":"semetey-1-2013:p0479:b004:l037","ordinal":113690,"en":"With life barely in him,"},{"id":"semetey-1-2013:p0479:b004:l038","ordinal":113691,"en":"Akayar began to speak."},{"id":"semetey-1-2013:p0479:b004:l039","ordinal":113692,"en":"Manas the Lion, that noble hero—"},{"id":"semetey-1-2013:p0480:b003:l001","ordinal":113693,"en":"With his life hanging between death and life,"},{"id":"semetey-1-2013:p0480:b003:l002","ordinal":113694,"en":"Kanykei carried him away,"},{"id":"semetey-1-2013:p0480:b003:l003","ordinal":113695,"en":"And went to Mecca, I hear."},{"id":"semetey-1-2013:p0480:b003:l004","ordinal":113696,"en":"God knows whether King Manas"},{"id":"semetey-1-2013:p0480:b003:l005","ordinal":113697,"en":"Met his death and died;"},{"id":"semetey-1-2013:p0480:b003:l006","ordinal":113698,"en":"God knows whether Manas"},{"id":"semetey-1-2013:p0480:b003:l007","ordinal":113699,"en":"Has seen the face of Judgment,"},{"id":"semetey-1-2013:p0480:b003:l008","ordinal":113700,"en":"Or God knows whether Kanykei,"},{"id":"semetey-1-2013:p0480:b003:l009","ordinal":113701,"en":"Healing her Magnanimous One,"},{"id":"semetey-1-2013:p0480:b003:l010","ordinal":113702,"en":"Will bring him back alive!"},{"id":"semetey-1-2013:p0480:b003:l011","ordinal":113703,"en":"Indeed, Manas the wolf-man's"},{"id":"semetey-1-2013:p0480:b003:l012","ordinal":113704,"en":"Own kinsman became his enemy;"},{"id":"semetey-1-2013:p0480:b003:l013","ordinal":113705,"en":"He would not heed Kanykei's words,"},{"id":"semetey-1-2013:p0480:b003:l014","ordinal":113706,"en":"And your fierce leopard Manas"},{"id":"semetey-1-2013:p0480:b003:l015","ordinal":113707,"en":"Was left with grief within."},{"id":"semetey-1-2013:p0480:b003:l016","ordinal":113708,"en":"Their gold was worth less than iron;"},{"id":"semetey-1-2013:p0480:b003:l017","ordinal":113709,"en":"Fattened, they knew not what they had received."},{"id":"semetey-1-2013:p0480:b003:l018","ordinal":113710,"en":"They plundered his wealth,"},{"id":"semetey-1-2013:p0480:b003:l019","ordinal":113711,"en":"They truly wrought havoc."},{"id":"semetey-1-2013:p0480:b003:l020","ordinal":113712,"en":"The warrior in Talas,"},{"id":"semetey-1-2013:p0480:b003:l021","ordinal":113713,"en":"They broke into his treasury,"},{"id":"semetey-1-2013:p0480:b003:l022","ordinal":113714,"en":"Cut down his plane-tree and felled it,"},{"id":"semetey-1-2013:p0480:b003:l023","ordinal":113715,"en":"Struck down the watchman,"},{"id":"semetey-1-2013:p0480:b003:l024","ordinal":113716,"en":"The treasury's riches to Beijing,"},{"id":"semetey-1-2013:p0480:b003:l025","ordinal":113717,"en":"They loaded them as booty."},{"id":"semetey-1-2013:p0480:b003:l026","ordinal":113718,"en":"The God who strikes has struck them;"},{"id":"semetey-1-2013:p0480:b003:l027","ordinal":113719,"en":"Kokchokoz and Kozkaman"},{"id":"semetey-1-2013:p0480:b003:l028","ordinal":113720,"en":"Have made such a spectacle."},{"id":"semetey-1-2013:p0480:b003:l029","ordinal":113721,"en":"My Talas, left deserted,"},{"id":"semetey-1-2013:p0480:b003:l030","ordinal":113722,"en":"May my Manas be safe!"},{"id":"semetey-1-2013:p0480:b003:l031","ordinal":113723,"en":"Was Kanykei struck"},{"id":"semetey-1-2013:p0480:b003:l032","ordinal":113724,"en":"By Kozkaman's spear?"},{"id":"semetey-1-2013:p0480:b003:l033","ordinal":113725,"en":"Bereft of the mighty lion,"},{"id":"semetey-1-2013:p0480:b003:l034","ordinal":113726,"en":"What will they do here,"},{"id":"semetey-1-2013:p0480:b003:l035","ordinal":113727,"en":"The forty companions, what recourse have they?"},{"id":"semetey-1-2013:p0480:b003:l036","ordinal":113728,"en":"Calling the fugitive our kinsman,"},{"id":"semetey-1-2013:p0480:b003:l037","ordinal":113729,"en":"Have we seen the benefit of this Chinese man?"},{"id":"semetey-1-2013:p0480:b003:l038","ordinal":113730,"en":"Finding words in sudden danger,"},{"id":"semetey-1-2013:p0480:b003:l039","ordinal":113731,"en":"Finding sight in darkness,"},{"id":"semetey-1-2013:p0480:b004:l001","ordinal":113732,"en":"Unrestrainable when angered,"},{"id":"semetey-1-2013:p0480:b004:l002","ordinal":113733,"en":"Traveling a road in darkness,"},{"id":"semetey-1-2013:p0480:b004:l003","ordinal":113734,"en":"Set upon a corsac fox's track, never straying,"},{"id":"semetey-1-2013:p0480:b004:l004","ordinal":113735,"en":"The benefit of your sainthood,"},{"id":"semetey-1-2013:p0480:b004:l005","ordinal":113736,"en":"Pledged to twelve spiritual guides,"},{"id":"semetey-1-2013:p0480:b004:l006","ordinal":113737,"en":"My destroyer Bakai, where are you?"},{"id":"semetey-1-2013:p0480:b004:l007","ordinal":113738,"en":"My Sereg, bearer of the banner,"},{"id":"semetey-1-2013:p0480:b004:l008","ordinal":113739,"en":"The one my very soul needs,"},{"id":"semetey-1-2013:p0480:b004:l009","ordinal":113740,"en":"My noble falcon has met calamity;"},{"id":"semetey-1-2013:p0480:b004:l010","ordinal":113741,"en":"Have you seen Kozkaman's gift?"},{"id":"semetey-1-2013:p0480:b004:l011","ordinal":113742,"en":"My Chubak, Akbaltai's son,"},{"id":"semetey-1-2013:p0480:b004:l012","ordinal":113743,"en":"My broad-chested, unfortunate one,"},{"id":"semetey-1-2013:p0480:b004:l013","ordinal":113744,"en":"Against the Kara-Kalmyks who have come,"},{"id":"semetey-1-2013:p0480:b004:l014","ordinal":113745,"en":"It is time for you to strike at full stretch."},{"id":"semetey-1-2013:p0480:b004:l015","ordinal":113746,"en":"Riding a horse like Sarala,"},{"id":"semetey-1-2013:p0480:b004:l016","ordinal":113747,"en":"Wearing trousers of yellow hide,"},{"id":"semetey-1-2013:p0480:b004:l017","ordinal":113748,"en":"Carrying a spear without a tassel,"},{"id":"semetey-1-2013:p0480:b004:l018","ordinal":113749,"en":"Girding a bare sword at your side,"},{"id":"semetey-1-2013:p0480:b004:l019","ordinal":113750,"en":"Pure in the Prophet-sultan's faith,"},{"id":"semetey-1-2013:p0480:b004:l020","ordinal":113751,"en":"A golden throne left in Beijing,"},{"id":"semetey-1-2013:p0480:b004:l021","ordinal":113752,"en":"Never looking back on a campaign,"},{"id":"semetey-1-2013:p0480:b004:l022","ordinal":113753,"en":"You were a lion who never grieved;"},{"id":"semetey-1-2013:p0480:b004:l023","ordinal":113754,"en":"The Kara-Kalmyks with their distant roads,"},{"id":"semetey-1-2013:p0480:b004:l024","ordinal":113755,"en":"You were the warrior who knew their way."},{"id":"semetey-1-2013:p0480:b004:l025","ordinal":113756,"en":"Girding your mighty waist,"},{"id":"semetey-1-2013:p0480:b004:l026","ordinal":113757,"en":"Stern, without a smile,"},{"id":"semetey-1-2013:p0480:b004:l027","ordinal":113758,"en":"If seven vast multitudes of enemies came,"},{"id":"semetey-1-2013:p0480:b004:l028","ordinal":113759,"en":"With your coat thrown on, you charged and struck."},{"id":"semetey-1-2013:p0480:b004:l029","ordinal":113760,"en":"Valiant Almam, my fierce one,"},{"id":"semetey-1-2013:p0480:b004:l030","ordinal":113761,"en":"A damned day has fallen upon us;"},{"id":"semetey-1-2013:p0480:b004:l031","ordinal":113762,"en":"Upon Manas, blessed by Kydyr,"},{"id":"semetey-1-2013:p0480:b004:l032","ordinal":113763,"en":"A pitiless night of hell has fallen."},{"id":"semetey-1-2013:p0480:b004:l033","ordinal":113764,"en":"Without sending out scouts, we came to grief;"},{"id":"semetey-1-2013:p0480:b004:l034","ordinal":113765,"en":"We have lost your leopard-lion, King Manas."},{"id":"semetey-1-2013:p0480:b004:l036","ordinal":113766,"en":"The help of my valiant one,"},{"id":"semetey-1-2013:p0480:b004:l037","ordinal":113767,"en":"When will I see, O leopard,"},{"id":"semetey-1-2013:p0480:b004:l038","ordinal":113768,"en":"My Alake's resourcefulness?"},{"id":"semetey-1-2013:p0480:b004:l039","ordinal":113769,"en":"The time to confront them has come,"},{"id":"semetey-1-2013:p0481:b003:l001","ordinal":113770,"en":"When will I see you, Alake?"},{"id":"semetey-1-2013:p0481:b003:l002","ordinal":113771,"en":"The time to go has come."},{"id":"semetey-1-2013:p0481:b003:l003","ordinal":113772,"en":"My Almam, blessed by Kydyr, listen;"},{"id":"semetey-1-2013:p0481:b003:l004","ordinal":113773,"en":"The time for mortal combat has come."},{"id":"semetey-1-2013:p0481:b003:l005","ordinal":113774,"en":"Yesterday, the finest of sixty,"},{"id":"semetey-1-2013:p0481:b003:l006","ordinal":113775,"en":"The mightiest of forty companions,"},{"id":"semetey-1-2013:p0481:b003:l007","ordinal":113776,"en":"The worth of them all,"},{"id":"semetey-1-2013:p0481:b003:l008","ordinal":113777,"en":"The heart of the Islamic faith,"},{"id":"semetey-1-2013:p0481:b003:l009","ordinal":113778,"en":"The binding ring of sharp steel;"},{"id":"semetey-1-2013:p0481:b003:l010","ordinal":113779,"en":"Never withdrawing what he thrust forward,"},{"id":"semetey-1-2013:p0481:b003:l011","ordinal":113780,"en":"Never fleeing the glowering enemy,"},{"id":"semetey-1-2013:p0481:b003:l012","ordinal":113781,"en":"My edge of black steel,"},{"id":"semetey-1-2013:p0481:b003:l013","ordinal":113782,"en":"We have lost the bloodstained lion!"},{"id":"semetey-1-2013:p0481:b003:l014","ordinal":113783,"en":"Dead or alive, who knows?"},{"id":"semetey-1-2013:p0481:b003:l015","ordinal":113784,"en":"The one Creator alone knows!"},{"id":"semetey-1-2013:p0481:b003:l016","ordinal":113785,"en":"Syrgak, you were the leopard,"},{"id":"semetey-1-2013:p0481:b003:l017","ordinal":113786,"en":"You were the lion who never grieved."},{"id":"semetey-1-2013:p0481:b003:l018","ordinal":113787,"en":"If the bloodstained leopard's eyes closed,"},{"id":"semetey-1-2013:p0481:b003:l019","ordinal":113788,"en":"You were the one to take his place."},{"id":"semetey-1-2013:p0481:b003:l020","ordinal":113789,"en":"He prepared to flee to Beijing."},{"id":"semetey-1-2013:p0481:b003:l021","ordinal":113790,"en":"Girding yourself to fight alone,"},{"id":"semetey-1-2013:p0481:b003:l022","ordinal":113791,"en":"My Syrgak, take vengeance on the five Kalmyks!”"},{"id":"semetey-1-2013:p0481:b003:l024","ordinal":113792,"en":"Breaking up and trampling their games,"},{"id":"semetey-1-2013:p0481:b003:l025","ordinal":113793,"en":"Kyrgylchal stirred them up,"},{"id":"semetey-1-2013:p0481:b003:l026","ordinal":113794,"en":"Reproaching the forty companions."},{"id":"semetey-1-2013:p0481:b003:l027","ordinal":113795,"en":"Hearing Kyrgylchal's words,"},{"id":"semetey-1-2013:p0481:b003:l028","ordinal":113796,"en":"That forty Kalmyks had brought his downfall,"},{"id":"semetey-1-2013:p0481:b003:l029","ordinal":113797,"en":"And had fled to Beijing, so they heard."},{"id":"semetey-1-2013:p0481:b003:l030","ordinal":113798,"en":"At that time the forty companions,"},{"id":"semetey-1-2013:p0481:b003:l031","ordinal":113799,"en":"Making Talas their homeland,"},{"id":"semetey-1-2013:p0481:b003:l032","ordinal":113800,"en":"Had settled there."},{"id":"semetey-1-2013:p0481:b003:l033","ordinal":113801,"en":"Swollen like blue ticks,"},{"id":"semetey-1-2013:p0481:b003:l034","ordinal":113802,"en":"They had grown plump."},{"id":"semetey-1-2013:p0481:b003:l035","ordinal":113803,"en":"Each of them was as a countless army,"},{"id":"semetey-1-2013:p0481:b003:l036","ordinal":113804,"en":"Such had they become."},{"id":"semetey-1-2013:p0481:b003:l037","ordinal":113805,"en":"Finding no mountain to charge,"},{"id":"semetey-1-2013:p0481:b003:l038","ordinal":113806,"en":"At that time the forty companions,"},{"id":"semetey-1-2013:p0481:b003:l039","ordinal":113807,"en":"Finding no enemy to fight,"},{"id":"semetey-1-2013:p0481:b005:l001","ordinal":113808,"en":"Finding no embers to wade through,"},{"id":"semetey-1-2013:p0481:b005:l002","ordinal":113809,"en":"Finding no bullets to exchange,"},{"id":"semetey-1-2013:p0481:b005:l003","ordinal":113810,"en":"Finding no mountain to strike and die upon,"},{"id":"semetey-1-2013:p0481:b005:l004","ordinal":113811,"en":"Finding no enemy to clash with,"},{"id":"semetey-1-2013:p0481:b005:l005","ordinal":113812,"en":"King Manas's nobles of the hills,"},{"id":"semetey-1-2013:p0481:b005:l006","ordinal":113813,"en":"Had entered the caliph's presence and received a letter,"},{"id":"semetey-1-2013:p0481:b005:l007","ordinal":113814,"en":"Received a blessing from the prince,"},{"id":"semetey-1-2013:p0481:b005:l008","ordinal":113815,"en":"Pledged themselves to twelve spiritual guides,"},{"id":"semetey-1-2013:p0481:b005:l009","ordinal":113816,"en":"And been named illustrious champions."},{"id":"semetey-1-2013:p0481:b005:l010","ordinal":113817,"en":"Raging, unable to sleep,"},{"id":"semetey-1-2013:p0481:b005:l011","ordinal":113818,"en":"Their two eyes aflame,"},{"id":"semetey-1-2013:p0481:b005:l012","ordinal":113819,"en":"They shone fiercely."},{"id":"semetey-1-2013:p0481:b005:l013","ordinal":113820,"en":"Spear and sword, six times,"},{"id":"semetey-1-2013:p0481:b005:l014","ordinal":113821,"en":"They were sharpening them."},{"id":"semetey-1-2013:p0481:b005:l015","ordinal":113822,"en":"Not thinning after six months' riding,"},{"id":"semetey-1-2013:p0481:b005:l016","ordinal":113823,"en":"Each had a swift steed"},{"id":"semetey-1-2013:p0481:b005:l017","ordinal":113824,"en":"Tethered and ready."},{"id":"semetey-1-2013:p0481:b005:l018","ordinal":113825,"en":"The armor Kanykei made, impenetrable to bullets,"},{"id":"semetey-1-2013:p0481:b005:l019","ordinal":113826,"en":"Each of them, without exception,"},{"id":"semetey-1-2013:p0481:b005:l020","ordinal":113827,"en":"Was ready to wear."},{"id":"semetey-1-2013:p0481:b005:l021","ordinal":113828,"en":"Let alone the five, Beijing itself"},{"id":"semetey-1-2013:p0481:b005:l022","ordinal":113829,"en":"They were ready to attack;"},{"id":"semetey-1-2013:p0481:b005:l023","ordinal":113830,"en":"It was time to wade through bullets,"},{"id":"semetey-1-2013:p0481:b005:l024","ordinal":113831,"en":"Seems ready to die."},{"id":"semetey-1-2013:p0481:b005:l025","ordinal":113832,"en":"Toward the tethered steeds,"},{"id":"semetey-1-2013:p0481:b005:l026","ordinal":113833,"en":"Grieving at the news of Manas,"},{"id":"semetey-1-2013:p0481:b005:l027","ordinal":113834,"en":"All the valiant, fierce ones"},{"id":"semetey-1-2013:p0481:b005:l028","ordinal":113835,"en":"Ran in haste."},{"id":"semetey-1-2013:p0481:b005:l029","ordinal":113836,"en":"Hurriedly they said their prayers,"},{"id":"semetey-1-2013:p0481:b005:l030","ordinal":113837,"en":"Saddled their swift steeds,"},{"id":"semetey-1-2013:p0481:b005:l031","ordinal":113838,"en":"Made their battle gear ready,"},{"id":"semetey-1-2013:p0481:b005:l032","ordinal":113839,"en":"Their spears, guns and swords"},{"id":"semetey-1-2013:p0481:b005:l033","ordinal":113840,"en":"They fastened in their proper places."},{"id":"semetey-1-2013:p0481:b005:l034","ordinal":113841,"en":"Banners fluttered in their hands,"},{"id":"semetey-1-2013:p0481:b005:l035","ordinal":113842,"en":"Zulpukor of sharp steel"},{"id":"semetey-1-2013:p0481:b005:l036","ordinal":113843,"en":"Flashed in every hand."},{"id":"semetey-1-2013:p0481:b005:l037","ordinal":113844,"en":"Their belts with cartridge pouches"},{"id":"semetey-1-2013:p0481:b005:l038","ordinal":113845,"en":"They fastened across the outside,"},{"id":"semetey-1-2013:p0481:b005:l039","ordinal":113846,"en":"Their eyes shining like fire,"},{"id":"semetey-1-2013:p0482:b003:l001","ordinal":113847,"en":"They beat the drums,"},{"id":"semetey-1-2013:p0482:b003:l002","ordinal":113848,"en":"All alike toward the enemy"},{"id":"semetey-1-2013:p0482:b003:l003","ordinal":113849,"en":"They stood making ready."},{"id":"semetey-1-2013:p0482:b003:l004","ordinal":113850,"en":"The forty companions, Manas's wings,"},{"id":"semetey-1-2013:p0482:b003:l005","ordinal":113851,"en":"Their number some sixty,"},{"id":"semetey-1-2013:p0482:b003:l006","ordinal":113852,"en":"Crushing the enemy they faced,"},{"id":"semetey-1-2013:p0482:b003:l007","ordinal":113853,"en":"Those blood-shedders were accustomed to bring torment."},{"id":"semetey-1-2013:p0482:b003:l009","ordinal":113854,"en":"They streamed along in ordered ranks;"},{"id":"semetey-1-2013:p0482:b003:l010","ordinal":113855,"en":"The two khans, Azhybai and Bakai,"},{"id":"semetey-1-2013:p0482:b003:l011","ordinal":113856,"en":"These two bore the banners."},{"id":"semetey-1-2013:p0482:b003:l012","ordinal":113857,"en":"Almambet and Chubak, the twin warriors,"},{"id":"semetey-1-2013:p0482:b003:l013","ordinal":113858,"en":"These alone went scouting."},{"id":"semetey-1-2013:p0482:b003:l014","ordinal":113859,"en":"Syrgak and Sergek, the pair,"},{"id":"semetey-1-2013:p0482:b003:l015","ordinal":113860,"en":"Shuutu the slave and the Singer together,"},{"id":"semetey-1-2013:p0482:b003:l016","ordinal":113861,"en":"Baichoro and the Diviner,"},{"id":"semetey-1-2013:p0482:b003:l017","ordinal":113862,"en":"Ormombek, Odukan's son,"},{"id":"semetey-1-2013:p0482:b003:l018","ordinal":113863,"en":"The youngest, headed by Bozuulu,"},{"id":"semetey-1-2013:p0482:b003:l019","ordinal":113864,"en":"Kyrgylchal, head of the forty,"},{"id":"semetey-1-2013:p0482:b003:l020","ordinal":113865,"en":"The mighty wrestler Tazbaimat,"},{"id":"semetey-1-2013:p0482:b003:l021","ordinal":113866,"en":"Akzholtoi, Adykan's son,"},{"id":"semetey-1-2013:p0482:b003:l022","ordinal":113867,"en":"Mingled together, hastening on their way,"},{"id":"semetey-1-2013:p0482:b003:l023","ordinal":113868,"en":"Each like an immeasurable army."},{"id":"semetey-1-2013:p0482:b003:l024","ordinal":113869,"en":"One of the forty companions"},{"id":"semetey-1-2013:p0482:b003:l025","ordinal":113870,"en":"Was a lion skilled among spearmen."},{"id":"semetey-1-2013:p0482:b003:l026","ordinal":113871,"en":"One of the forty companions"},{"id":"semetey-1-2013:p0482:b003:l027","ordinal":113872,"en":"Was a mighty lion who struck with a battle-axe."},{"id":"semetey-1-2013:p0482:b003:l028","ordinal":113873,"en":"Do not ask about the forty companions;"},{"id":"semetey-1-2013:p0482:b003:l029","ordinal":113874,"en":"They drank their fill of dark blood."},{"id":"semetey-1-2013:p0482:b003:l030","ordinal":113875,"en":"If the raging battle was great,"},{"id":"semetey-1-2013:p0482:b003:l031","ordinal":113876,"en":"They fought six months without fleeing."},{"id":"semetey-1-2013:p0482:b003:l032","ordinal":113877,"en":"They did not shrink from death,"},{"id":"semetey-1-2013:p0482:b003:l033","ordinal":113878,"en":"They did not flee the enemy they faced."},{"id":"semetey-1-2013:p0482:b003:l034","ordinal":113879,"en":"King Manas's forty nobles,"},{"id":"semetey-1-2013:p0482:b003:l035","ordinal":113880,"en":"Wearing marten fur and black caps,"},{"id":"semetey-1-2013:p0482:b003:l036","ordinal":113881,"en":"Tall in stature, broad of shoulder,"},{"id":"semetey-1-2013:p0482:b003:l037","ordinal":113882,"en":"Wrestlers and lions alike,"},{"id":"semetey-1-2013:p0482:b003:l038","ordinal":113883,"en":"All fearless champions."},{"id":"semetey-1-2013:p0482:b003:l039","ordinal":113884,"en":"All the forty companions"},{"id":"semetey-1-2013:p0482:b004:l001","ordinal":113885,"en":"Traveled up the Talas,"},{"id":"semetey-1-2013:p0482:b004:l002","ordinal":113886,"en":"Sparing no horses, covering much ground,"},{"id":"semetey-1-2013:p0482:b004:l003","ordinal":113887,"en":"The lions hurried on."},{"id":"semetey-1-2013:p0482:b004:l004","ordinal":113888,"en":"“This is the road they will take,” they said,"},{"id":"semetey-1-2013:p0482:b004:l005","ordinal":113889,"en":"And crossed Kotormo,"},{"id":"semetey-1-2013:p0482:b004:l006","ordinal":113890,"en":"And traversed Suusamyr."},{"id":"semetey-1-2013:p0482:b004:l007","ordinal":113891,"en":"They journeyed as far as Urchuk,"},{"id":"semetey-1-2013:p0482:b004:l008","ordinal":113892,"en":"Sparing no horses, hey, covering much ground,"},{"id":"semetey-1-2013:p0482:b004:l009","ordinal":113893,"en":"Without looking far ahead for scouts, hey,"},{"id":"semetey-1-2013:p0482:b004:l010","ordinal":113894,"en":"Without sparing their swift steeds, hey."},{"id":"semetey-1-2013:p0482:b004:l011","ordinal":113895,"en":"In some places, hey, the forty companions"},{"id":"semetey-1-2013:p0482:b004:l012","ordinal":113896,"en":"Clashed stirrups as they raced."},{"id":"semetey-1-2013:p0482:b004:l013","ordinal":113897,"en":"In some places, the forty companions,"},{"id":"semetey-1-2013:p0482:b004:l014","ordinal":113898,"en":"All on renowned swift steeds,"},{"id":"semetey-1-2013:p0482:b004:l015","ordinal":113899,"en":"Struggled against their horses' mouths."},{"id":"semetey-1-2013:p0482:b004:l016","ordinal":113900,"en":"All the swift, noble-bred horses"},{"id":"semetey-1-2013:p0482:b004:l017","ordinal":113901,"en":"Shattered the ground they trod;"},{"id":"semetey-1-2013:p0482:b004:l018","ordinal":113902,"en":"Clods as big as great cauldrons"},{"id":"semetey-1-2013:p0482:b004:l019","ordinal":113903,"en":"Over the forty companions' heads"},{"id":"semetey-1-2013:p0482:b004:l020","ordinal":113904,"en":"Were tossed like jacks, rattling."},{"id":"semetey-1-2013:p0482:b004:l021","ordinal":113905,"en":"Making for the foothills, they traveled,"},{"id":"semetey-1-2013:p0482:b004:l022","ordinal":113906,"en":"Sparing no horses, hey, covering much ground."},{"id":"semetey-1-2013:p0482:b004:l023","ordinal":113907,"en":"They crossed bulging hollows and deep ravines,"},{"id":"semetey-1-2013:p0482:b004:l024","ordinal":113908,"en":"They crossed the looming high mountain."},{"id":"semetey-1-2013:p0482:b004:l025","ordinal":113909,"en":"With the horse Aisarala,"},{"id":"semetey-1-2013:p0482:b004:l026","ordinal":113910,"en":"A broad plain covered in fescue,"},{"id":"semetey-1-2013:p0482:b004:l027","ordinal":113911,"en":"Then they crossed that broad plain."},{"id":"semetey-1-2013:p0482:b004:l028","ordinal":113912,"en":"Traveling through the great mountains,"},{"id":"semetey-1-2013:p0482:b004:l029","ordinal":113913,"en":"Resourceful Bakai, your khan uncle,"},{"id":"semetey-1-2013:p0482:b004:l030","ordinal":113914,"en":"Sparing no horses, hey, covering much ground,"},{"id":"semetey-1-2013:p0482:b004:l031","ordinal":113915,"en":"To Eki-Chat of Echki-Olbos, hey,"},{"id":"semetey-1-2013:p0482:b004:l032","ordinal":113916,"en":"They crossed over and lay down, hey."},{"id":"semetey-1-2013:p0482:b004:l034","ordinal":113917,"en":"Turning toward the forty companions,"},{"id":"semetey-1-2013:p0482:b004:l035","ordinal":113918,"en":"Kydyr-blessed Bakai, the noble lion,"},{"id":"semetey-1-2013:p0482:b004:l036","ordinal":113919,"en":"Spoke his precious words:"},{"id":"semetey-1-2013:p0482:b004:l037","ordinal":113920,"en":"“Have the fugitives made camp without delay?"}]
