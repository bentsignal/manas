[{"id":"semetey-1-2013:p0212:b003:l019","ordinal":92929,"en":"Have entered four steeds; choose among them."},{"id":"semetey-1-2013:p0212:b003:l020","ordinal":92930,"en":"I myself entered Aktulpar."},{"id":"semetey-1-2013:p0212:b003:l021","ordinal":92931,"en":"Should Aktulpar come first,"},{"id":"semetey-1-2013:p0212:b003:l022","ordinal":92932,"en":"Take the first prize yourself,"},{"id":"semetey-1-2013:p0212:b003:l023","ordinal":92933,"en":"And take the horse along with it."},{"id":"semetey-1-2013:p0212:b003:l024","ordinal":92934,"en":"Shaatemir entered Chongkurong,"},{"id":"semetey-1-2013:p0212:b003:l025","ordinal":92935,"en":"Ismayyl his Chongkashka,"},{"id":"semetey-1-2013:p0212:b003:l026","ordinal":92936,"en":"Koloykan his Karakashka argamak."},{"id":"semetey-1-2013:p0212:b003:l027","ordinal":92937,"en":"Leave two and take one."},{"id":"semetey-1-2013:p0212:b003:l028","ordinal":92938,"en":"Whichever comes in first,"},{"id":"semetey-1-2013:p0212:b003:l029","ordinal":92939,"en":"Take the horse and all the first prize."},{"id":"semetey-1-2013:p0212:b003:l030","ordinal":92940,"en":"May I come to no good if I dispute a horse with you!"},{"id":"semetey-1-2013:p0212:b003:l031","ordinal":92941,"en":"If I dispute a prize with you,"},{"id":"semetey-1-2013:p0212:b003:l032","ordinal":92942,"en":"O Kanykey, my foal,"},{"id":"semetey-1-2013:p0212:b003:l033","ordinal":92943,"en":"May I no longer be a Muslim!"},{"id":"semetey-1-2013:p0212:b003:l034","ordinal":92944,"en":"Like a post for tying horses,"},{"id":"semetey-1-2013:p0212:b003:l035","ordinal":92945,"en":"May I be stripped bare!"},{"id":"semetey-1-2013:p0212:b003:l036","ordinal":92946,"en":"Failing to know God's oneness,"},{"id":"semetey-1-2013:p0212:b003:l037","ordinal":92947,"en":"My child, may I become an unbeliever!”"},{"id":"semetey-1-2013:p0212:b003:l038","ordinal":92948,"en":"When her father called her a widow,"},{"id":"semetey-1-2013:p0212:b003:l039","ordinal":92949,"en":"Your proud sister-in-law Kanykey—"},{"id":"semetey-1-2013:p0212:b004:l001","ordinal":92950,"en":"How could she fail to feel shame?"},{"id":"semetey-1-2013:p0212:b004:l003","ordinal":92951,"en":"Parted from her Magnanimous One,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0212:b004:l004","ordinal":92952,"en":"Your poor woman who lived in shame,"},{"id":"semetey-1-2013:p0212:b004:l005","ordinal":92953,"en":"When her father called her a widow,"},{"id":"semetey-1-2013:p0212:b004:l006","ordinal":92954,"en":"Unable to sniff back her running nose,"},{"id":"semetey-1-2013:p0212:b004:l007","ordinal":92955,"en":"Unable to wipe her eyes,"},{"id":"semetey-1-2013:p0212:b004:l008","ordinal":92956,"en":"With her very bones seeming to part,"},{"id":"semetey-1-2013:p0212:b004:l009","ordinal":92957,"en":"Her tears streaming down,"},{"id":"semetey-1-2013:p0212:b004:l010","ordinal":92958,"en":"Kanykey stood and said:"},{"id":"semetey-1-2013:p0212:b004:l011","ordinal":92959,"en":"“The dear bird called the crane"},{"id":"semetey-1-2013:p0212:b004:l012","ordinal":92960,"en":"You let the goshawk devour."},{"id":"semetey-1-2013:p0212:b004:l013","ordinal":92961,"en":"My dear soul steeped in grief,"},{"id":"semetey-1-2013:p0212:b004:l014","ordinal":92962,"en":"When I fled to Bukhara,"},{"id":"semetey-1-2013:p0212:b004:l015","ordinal":92963,"en":"You made my father call me a widow."},{"id":"semetey-1-2013:p0212:b004:l016","ordinal":92964,"en":"You let the hunting bird devour the swan."},{"id":"semetey-1-2013:p0212:b004:l017","ordinal":92965,"en":"My life falling into ruin,"},{"id":"semetey-1-2013:p0212:b004:l018","ordinal":92966,"en":"You made my father call me a widow."},{"id":"semetey-1-2013:p0212:b004:l019","ordinal":92967,"en":"Wretched father, you have done no good!"},{"id":"semetey-1-2013:p0212:b004:l020","ordinal":92968,"en":"You too insulted me as a widow."},{"id":"semetey-1-2013:p0212:b004:l021","ordinal":92969,"en":"My dear father,"},{"id":"semetey-1-2013:p0212:b004:l022","ordinal":92970,"en":"Was this a gathering of multitudes?"},{"id":"semetey-1-2013:p0212:b004:l023","ordinal":92971,"en":"In these cities, Samarkand and Bukhara,"},{"id":"semetey-1-2013:p0212:b004:l024","ordinal":92972,"en":"Parted from all her people at once—"},{"id":"semetey-1-2013:p0212:b004:l025","ordinal":92973,"en":"Was there no other widow like me?"},{"id":"semetey-1-2013:p0212:b004:l026","ordinal":92974,"en":"Father, my dear father,"},{"id":"semetey-1-2013:p0212:b004:l027","ordinal":92975,"en":"If you race Aktulpar and he wins,"},{"id":"semetey-1-2013:p0212:b004:l028","ordinal":92976,"en":"When I, a bitch dying for wealth,"},{"id":"semetey-1-2013:p0212:b004:l029","ordinal":92977,"en":"Take his first prize,"},{"id":"semetey-1-2013:p0212:b004:l030","ordinal":92978,"en":"What wish would I fulfill?"},{"id":"semetey-1-2013:p0212:b004:l031","ordinal":92979,"en":"Do not block my way, Father."},{"id":"semetey-1-2013:p0212:b004:l032","ordinal":92980,"en":"Let go of my hand, Father."},{"id":"semetey-1-2013:p0212:b004:l033","ordinal":92981,"en":"He was a horse granted by fortune."},{"id":"semetey-1-2013:p0212:b004:l034","ordinal":92982,"en":"Here in this Bukhara,"},{"id":"semetey-1-2013:p0212:b004:l035","ordinal":92983,"en":"Let me race my Taytoru."},{"id":"semetey-1-2013:p0212:b004:l036","ordinal":92984,"en":"Who would love"},{"id":"semetey-1-2013:p0212:b004:l037","ordinal":92985,"en":"A widow like me?"},{"id":"semetey-1-2013:p0212:b004:l038","ordinal":92986,"en":"I shall try as an omen"},{"id":"semetey-1-2013:p0212:b004:l039","ordinal":92987,"en":"My fleet horse Taytoru!"},{"id":"semetey-1-2013:p0213:b003:l001","ordinal":92988,"en":"Taytoru, entered for the prize,"},{"id":"semetey-1-2013:p0213:b003:l002","ordinal":92989,"en":"Was a renowned swift horse."},{"id":"semetey-1-2013:p0213:b003:l003","ordinal":92990,"en":"When my heroic lord died,"},{"id":"semetey-1-2013:p0213:b003:l004","ordinal":92991,"en":"When this head met with suffering,"},{"id":"semetey-1-2013:p0213:b003:l005","ordinal":92992,"en":"When Abyke, Kobosh, the six villains,"},{"id":"semetey-1-2013:p0213:b003:l006","ordinal":92993,"en":"The vast wealth left by the Magnanimous One,"},{"id":"semetey-1-2013:p0213:b003:l007","ordinal":92994,"en":"They shared it, measuring it out with whips."},{"id":"semetey-1-2013:p0213:b003:l008","ordinal":92995,"en":"When this head met with calamity,"},{"id":"semetey-1-2013:p0213:b003:l009","ordinal":92996,"en":"He was a revered man,"},{"id":"semetey-1-2013:p0213:b003:l010","ordinal":92997,"en":"Khan Koshoy of the Katagan:"},{"id":"semetey-1-2013:p0213:b003:l011","ordinal":92998,"en":"He gave me this Taytoru as a mourning gift."},{"id":"semetey-1-2013:p0213:b003:l012","ordinal":92999,"en":"Counting his grown years,"},{"id":"semetey-1-2013:p0213:b003:l013","ordinal":93000,"en":"He had reached sixty."},{"id":"semetey-1-2013:p0213:b003:l014","ordinal":93001,"en":"This very year, my Taytoru"},{"id":"semetey-1-2013:p0213:b003:l015","ordinal":93002,"en":"Had reached sixty grown years."},{"id":"semetey-1-2013:p0213:b003:l016","ordinal":93003,"en":"If my bay comes in first,"},{"id":"semetey-1-2013:p0213:b003:l017","ordinal":93004,"en":"I shall share his first prize."},{"id":"semetey-1-2013:p0213:b003:l018","ordinal":93005,"en":"If Taytoru falls behind,"},{"id":"semetey-1-2013:p0213:b003:l019","ordinal":93006,"en":"Without letting you call me a widow,"},{"id":"semetey-1-2013:p0213:b003:l020","ordinal":93007,"en":"I shall die before my appointed death!"},{"id":"semetey-1-2013:p0213:b003:l021","ordinal":93008,"en":"While I have my argamak horse,"},{"id":"semetey-1-2013:p0213:b003:l022","ordinal":93009,"en":"Father, I shall put no bridle on honor."},{"id":"semetey-1-2013:p0213:b003:l023","ordinal":93010,"en":"While my Magnanimous One and our Kyrgyz people's"},{"id":"semetey-1-2013:p0213:b003:l024","ordinal":93011,"en":"Spirits watch over me,"},{"id":"semetey-1-2013:p0213:b003:l025","ordinal":93012,"en":"I shall not sell my ancestral honor to the Sarts."},{"id":"semetey-1-2013:p0213:b003:l026","ordinal":93013,"en":"I shall not sit without racing my horse."},{"id":"semetey-1-2013:p0213:b003:l027","ordinal":93014,"en":"Gather your people of eight khans."},{"id":"semetey-1-2013:p0213:b003:l028","ordinal":93015,"en":"Restrain your foolish people."},{"id":"semetey-1-2013:p0213:b003:l029","ordinal":93016,"en":"If some wretch acts wickedly,"},{"id":"semetey-1-2013:p0213:b003:l030","ordinal":93017,"en":"If he blocks my horse's way,"},{"id":"semetey-1-2013:p0213:b003:l031","ordinal":93018,"en":"I shall not spare my life;"},{"id":"semetey-1-2013:p0213:b003:l032","ordinal":93019,"en":"Today I shall spill my blood!"},{"id":"semetey-1-2013:p0213:b003:l033","ordinal":93020,"en":"If anyone interferes with my horse,"},{"id":"semetey-1-2013:p0213:b003:l034","ordinal":93021,"en":"I shall seize him on the road,"},{"id":"semetey-1-2013:p0213:b003:l035","ordinal":93022,"en":"Drag him along the road,"},{"id":"semetey-1-2013:p0213:b003:l036","ordinal":93023,"en":"And offer him as a sacrifice."},{"id":"semetey-1-2013:p0213:b003:l037","ordinal":93024,"en":"Whoever goes too far in villainy,"},{"id":"semetey-1-2013:p0213:b003:l038","ordinal":93025,"en":"I shall cut off his head."},{"id":"semetey-1-2013:p0213:b003:l039","ordinal":93026,"en":"If my anger grows fierce,"},{"id":"semetey-1-2013:p0213:b004:l001","ordinal":93027,"en":"I shall cut him up for the dogs!”"},{"id":"semetey-1-2013:p0213:b004:l002","ordinal":93028,"en":"So saying then,"},{"id":"semetey-1-2013:p0213:b004:l003","ordinal":93029,"en":"Her white whip with its black handle,"},{"id":"semetey-1-2013:p0213:b004:l004","ordinal":93030,"en":"She grasped and swung it,"},{"id":"semetey-1-2013:p0213:b004:l005","ordinal":93031,"en":"Making her bay cry out,"},{"id":"semetey-1-2013:p0213:b004:l006","ordinal":93032,"en":"She drew it back against her thigh."},{"id":"semetey-1-2013:p0213:b004:l007","ordinal":93033,"en":"Making the face of the earth collapse,"},{"id":"semetey-1-2013:p0213:b004:l008","ordinal":93034,"en":"Shouting, “Drive the horses!”"},{"id":"semetey-1-2013:p0213:b004:l009","ordinal":93035,"en":"She galloped into Bukhara."},{"id":"semetey-1-2013:p0213:b004:l010","ordinal":93036,"en":"She shouted toward the lowlands;"},{"id":"semetey-1-2013:p0213:b004:l011","ordinal":93037,"en":"Not one soul remained there."},{"id":"semetey-1-2013:p0213:b004:l012","ordinal":93038,"en":"When she shouted toward the mountains,"},{"id":"semetey-1-2013:p0213:b004:l013","ordinal":93039,"en":"Not one soul remained there."},{"id":"semetey-1-2013:p0213:b004:l014","ordinal":93040,"en":"Shouting in anger,"},{"id":"semetey-1-2013:p0213:b004:l015","ordinal":93041,"en":"All the multitude,"},{"id":"semetey-1-2013:p0213:b004:l016","ordinal":93042,"en":"Your dear mother Kanykey"},{"id":"semetey-1-2013:p0213:b004:l017","ordinal":93043,"en":"Drove in, scattering them before her."},{"id":"semetey-1-2013:p0213:b004:l018","ordinal":93044,"en":"The reason she drove them before her—"},{"id":"semetey-1-2013:p0213:b004:l019","ordinal":93045,"en":"Dividing her back hair into ten,"},{"id":"semetey-1-2013:p0213:b004:l020","ordinal":93046,"en":"Was she not your sister-in-law who braided it?"},{"id":"semetey-1-2013:p0213:b004:l021","ordinal":93047,"en":"Greatness and sovereignty,"},{"id":"semetey-1-2013:p0213:b004:l022","ordinal":93048,"en":"While your great lord lived—"},{"id":"semetey-1-2013:p0213:b004:l023","ordinal":93049,"en":"Was she not your sister-in-law who knew them?"},{"id":"semetey-1-2013:p0213:b004:l024","ordinal":93050,"en":"Manas Khan was her sovereign;"},{"id":"semetey-1-2013:p0213:b004:l025","ordinal":93051,"en":"Had he not been a ruler?"},{"id":"semetey-1-2013:p0213:b004:l026","ordinal":93052,"en":"To all the people, Kanykey,"},{"id":"semetey-1-2013:p0213:b004:l027","ordinal":93053,"en":"While her sovereign lived—"},{"id":"semetey-1-2013:p0213:b004:l028","ordinal":93054,"en":"Had she not been a mother?"},{"id":"semetey-1-2013:p0213:b004:l029","ordinal":93055,"en":"At Khan Kokotoy's memorial feast,"},{"id":"semetey-1-2013:p0213:b004:l030","ordinal":93056,"en":"At the head of the great assembly,"},{"id":"semetey-1-2013:p0213:b004:l031","ordinal":93057,"en":"Of the hairy-mouthed Russians,"},{"id":"semetey-1-2013:p0213:b004:l032","ordinal":93058,"en":"When their ten tribes came,"},{"id":"semetey-1-2013:p0213:b004:l033","ordinal":93059,"en":"Of the red-tasseled Chinese,"},{"id":"semetey-1-2013:p0213:b004:l034","ordinal":93060,"en":"When their forty tribes came,"},{"id":"semetey-1-2013:p0213:b004:l035","ordinal":93061,"en":"When the people gathered,"},{"id":"semetey-1-2013:p0213:b004:l036","ordinal":93062,"en":"When unbelievers and Muslims"},{"id":"semetey-1-2013:p0213:b004:l037","ordinal":93063,"en":"Stood confronting each other,"},{"id":"semetey-1-2013:p0213:b004:l038","ordinal":93064,"en":"She made all forty dignitaries"},{"id":"semetey-1-2013:p0213:b004:l039","ordinal":93065,"en":"Walk behind her,"},{"id":"semetey-1-2013:p0214:b003:l001","ordinal":93066,"en":"To all the world's people,"},{"id":"semetey-1-2013:p0214:b003:l002","ordinal":93067,"en":"That woman Kanykey then"},{"id":"semetey-1-2013:p0214:b003:l003","ordinal":93068,"en":"Had shown her lion's courage."},{"id":"semetey-1-2013:p0214:b003:l004","ordinal":93069,"en":"The red-tasseled Chinese,"},{"id":"semetey-1-2013:p0214:b003:l005","ordinal":93070,"en":"Dividing their forty tribes into five,"},{"id":"semetey-1-2013:p0214:b003:l006","ordinal":93071,"en":"Had she not welcomed them as guests?"},{"id":"semetey-1-2013:p0214:b003:l007","ordinal":93072,"en":"Handling the people with skill,"},{"id":"semetey-1-2013:p0214:b003:l008","ordinal":93073,"en":"Managing to gain the land,"},{"id":"semetey-1-2013:p0214:b003:l009","ordinal":93074,"en":"Directing the memorial feast and the people—"},{"id":"semetey-1-2013:p0214:b003:l010","ordinal":93075,"en":"Was she not your sister-in-law who had known it?"},{"id":"semetey-1-2013:p0214:b003:l011","ordinal":93076,"en":"Though sixty thousand people came at once,"},{"id":"semetey-1-2013:p0214:b003:l012","ordinal":93077,"en":"Their food, as though for one person,"},{"id":"semetey-1-2013:p0214:b003:l013","ordinal":93078,"en":"Was she not your sister-in-law who served it?"},{"id":"semetey-1-2013:p0214:b003:l014","ordinal":93079,"en":"All the whole world,"},{"id":"semetey-1-2013:p0214:b003:l015","ordinal":93080,"en":"Was she not your sister-in-law who knew it?"},{"id":"semetey-1-2013:p0214:b003:l016","ordinal":93081,"en":"While her Magnanimous Manas lived,"},{"id":"semetey-1-2013:p0214:b003:l017","ordinal":93082,"en":"Directing khans and governing people—"},{"id":"semetey-1-2013:p0214:b003:l018","ordinal":93083,"en":"Was she not your sister-in-law who knew it?"},{"id":"semetey-1-2013:p0214:b003:l019","ordinal":93084,"en":"Learning from Manas,"},{"id":"semetey-1-2013:p0214:b003:l020","ordinal":93085,"en":"Your sister-in-law had seen much."},{"id":"semetey-1-2013:p0214:b003:l021","ordinal":93086,"en":"When she shouted toward the lowlands,"},{"id":"semetey-1-2013:p0214:b003:l022","ordinal":93087,"en":"When she called, “Drive the horses!”"},{"id":"semetey-1-2013:p0214:b003:l023","ordinal":93088,"en":"Not one soul remained in the lowlands."},{"id":"semetey-1-2013:p0214:b003:l024","ordinal":93089,"en":"When she shouted toward the mountains,"},{"id":"semetey-1-2013:p0214:b003:l025","ordinal":93090,"en":"When she called, “Drive the horses!”"},{"id":"semetey-1-2013:p0214:b003:l026","ordinal":93091,"en":"Not one soul remained in the mountains."},{"id":"semetey-1-2013:p0214:b003:l027","ordinal":93092,"en":"Then your fiery sister-in-law"},{"id":"semetey-1-2013:p0214:b003:l028","ordinal":93093,"en":"Would have no regrets even in death."},{"id":"semetey-1-2013:p0214:b003:l029","ordinal":93094,"en":"The contestants who raced horses,"},{"id":"semetey-1-2013:p0214:b003:l030","ordinal":93095,"en":"The trainers who tethered horses,"},{"id":"semetey-1-2013:p0214:b003:l031","ordinal":93096,"en":"Taking shortcuts along the roads,"},{"id":"semetey-1-2013:p0214:b003:l032","ordinal":93097,"en":"The eight khans—may their journey prosper—"},{"id":"semetey-1-2013:p0214:b003:l033","ordinal":93098,"en":"Leading their horses,"},{"id":"semetey-1-2013:p0214:b003:l034","ordinal":93099,"en":"Going to and fro,"},{"id":"semetey-1-2013:p0214:b003:l035","ordinal":93100,"en":"Calling “Aha! Aha!” in haste,"},{"id":"semetey-1-2013:p0214:b003:l036","ordinal":93101,"en":"The leaders of ten bobbing along,"},{"id":"semetey-1-2013:p0214:b003:l037","ordinal":93102,"en":"The leaders of fifty shouting rough commands,"},{"id":"semetey-1-2013:p0214:b003:l038","ordinal":93103,"en":"The great holy city of sheikhs,"},{"id":"semetey-1-2013:p0214:b003:l039","ordinal":93104,"en":"The multitudes of Kokand and Margalang,"},{"id":"semetey-1-2013:p0214:b004:l001","ordinal":93105,"en":"Synchybek of Andijan,"},{"id":"semetey-1-2013:p0214:b004:l002","ordinal":93106,"en":"Kokand's Kushbegi,"},{"id":"semetey-1-2013:p0214:b004:l003","ordinal":93107,"en":"Their mounts were stallions."},{"id":"semetey-1-2013:p0214:b004:l004","ordinal":93108,"en":"Bukhara was filled with Sarts."},{"id":"semetey-1-2013:p0214:b004:l005","ordinal":93109,"en":"All their mounts were stallions;"},{"id":"semetey-1-2013:p0214:b004:l006","ordinal":93110,"en":"Those on the ridges were more numerous still."},{"id":"semetey-1-2013:p0214:b004:l007","ordinal":93111,"en":"Many had no saddles,"},{"id":"semetey-1-2013:p0214:b004:l008","ordinal":93112,"en":"With rope cruppers and rope girths;"},{"id":"semetey-1-2013:p0214:b004:l009","ordinal":93113,"en":"Those on pack pads were more numerous still."},{"id":"semetey-1-2013:p0214:b004:l010","ordinal":93114,"en":"Those who came had no sense."},{"id":"semetey-1-2013:p0214:b004:l011","ordinal":93115,"en":"All their horses were stallions,"},{"id":"semetey-1-2013:p0214:b004:l012","ordinal":93116,"en":"With no cruppers at all."},{"id":"semetey-1-2013:p0214:b004:l014","ordinal":93117,"en":"Sticking out their little blue overshoes,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0214:b004:l015","ordinal":93118,"en":"Hurrying till their strength gave out,"},{"id":"semetey-1-2013:p0214:b004:l016","ordinal":93119,"en":"They went to parade the horses."},{"id":"semetey-1-2013:p0214:b004:l017","ordinal":93120,"en":"They were the people of eight khans."},{"id":"semetey-1-2013:p0214:b004:l018","ordinal":93121,"en":"Many people had gathered."},{"id":"semetey-1-2013:p0214:b004:l019","ordinal":93122,"en":"Spearheads clashed together,"},{"id":"semetey-1-2013:p0214:b004:l020","ordinal":93123,"en":"People's heads knocked together."},{"id":"semetey-1-2013:p0214:b004:l021","ordinal":93124,"en":"Drawing along the edge, swaying,"},{"id":"semetey-1-2013:p0214:b004:l022","ordinal":93125,"en":"Moving in rows, rocking,"},{"id":"semetey-1-2013:p0214:b004:l023","ordinal":93126,"en":"All Bukhara heaving,"},{"id":"semetey-1-2013:p0214:b004:l024","ordinal":93127,"en":"Seething with people,"},{"id":"semetey-1-2013:p0214:b004:l025","ordinal":93128,"en":"All Bukhara filled with dust,"},{"id":"semetey-1-2013:p0214:b004:l026","ordinal":93129,"en":"Earth flying, dust spreading,"},{"id":"semetey-1-2013:p0214:b004:l027","ordinal":93130,"en":"The people covered Bukhara."},{"id":"semetey-1-2013:p0214:b004:l028","ordinal":93131,"en":"Looking, one could not make things out;"},{"id":"semetey-1-2013:p0214:b004:l029","ordinal":93132,"en":"Where things were could not be known."},{"id":"semetey-1-2013:p0214:b004:l030","ordinal":93133,"en":"People filled it in dense masses;"},{"id":"semetey-1-2013:p0214:b004:l031","ordinal":93134,"en":"Their people came in full throngs."},{"id":"semetey-1-2013:p0214:b004:l032","ordinal":93135,"en":"Though a woman, such as this,"},{"id":"semetey-1-2013:p0214:b004:l033","ordinal":93136,"en":"Was Kanykey not a khan?"},{"id":"semetey-1-2013:p0214:b004:l034","ordinal":93137,"en":"Among the multitude,"},{"id":"semetey-1-2013:p0214:b004:l035","ordinal":93138,"en":"She began issuing orders:"},{"id":"semetey-1-2013:p0214:b004:l036","ordinal":93139,"en":"“Enter the horses in writing."},{"id":"semetey-1-2013:p0214:b004:l037","ordinal":93140,"en":"Take a count of the horses."},{"id":"semetey-1-2013:p0214:b004:l038","ordinal":93141,"en":"Show your skill in this way."},{"id":"semetey-1-2013:p0214:b004:l039","ordinal":93142,"en":"Once you have registered the horses,"},{"id":"semetey-1-2013:p0215:b003:l001","ordinal":93143,"en":"Then race them."},{"id":"semetey-1-2013:p0215:b003:l002","ordinal":93144,"en":"If you do not heed this counsel,"},{"id":"semetey-1-2013:p0215:b003:l003","ordinal":93145,"en":"If you do not race the horses thus,"},{"id":"semetey-1-2013:p0215:b003:l004","ordinal":93146,"en":"Horses among the argamaks may die,"},{"id":"semetey-1-2013:p0215:b003:l005","ordinal":93147,"en":"Men among the brave may die."},{"id":"semetey-1-2013:p0215:b003:l006","ordinal":93148,"en":"Let the blame not be grievous!”"},{"id":"semetey-1-2013:p0215:b003:l007","ordinal":93149,"en":"She gave this order."},{"id":"semetey-1-2013:p0215:b003:l008","ordinal":93150,"en":"Your noble sister-in-law Kanykey,"},{"id":"semetey-1-2013:p0215:b003:l009","ordinal":93151,"en":"The skilled riders,"},{"id":"semetey-1-2013:p0215:b003:l010","ordinal":93152,"en":"The finest among the brave,"},{"id":"semetey-1-2013:p0215:b003:l011","ordinal":93153,"en":"Gathered them all in rows."},{"id":"semetey-1-2013:p0215:b003:l012","ordinal":93154,"en":"Without regarding her as a woman,"},{"id":"semetey-1-2013:p0215:b003:l013","ordinal":93155,"en":"The people obeyed her word:"},{"id":"semetey-1-2013:p0215:b003:l014","ordinal":93156,"en":"“She is the khan of khans,” they said."},{"id":"semetey-1-2013:p0215:b003:l015","ordinal":93157,"en":"That whole multitude,"},{"id":"semetey-1-2013:p0215:b003:l016","ordinal":93158,"en":"At a fiery woman like your sister-in-law,"},{"id":"semetey-1-2013:p0215:b003:l017","ordinal":93159,"en":"Was left astonished."},{"id":"semetey-1-2013:p0215:b003:l018","ordinal":93160,"en":"People were moving everywhere;"},{"id":"semetey-1-2013:p0215:b003:l019","ordinal":93161,"en":"All Bukhara was filled with dust."},{"id":"semetey-1-2013:p0215:b003:l020","ordinal":93162,"en":"Moldosan of Bukhara"},{"id":"semetey-1-2013:p0215:b003:l021","ordinal":93163,"en":"Was an exceptionally skilled young scribe."},{"id":"semetey-1-2013:p0215:b003:l022","ordinal":93164,"en":"He registered the horses."},{"id":"semetey-1-2013:p0215:b003:l023","ordinal":93165,"en":"When they looked after a while,"},{"id":"semetey-1-2013:p0215:b003:l024","ordinal":93166,"en":"White paper was filled with writing."},{"id":"semetey-1-2013:p0215:b003:l025","ordinal":93167,"en":"When the woman read and looked,"},{"id":"semetey-1-2013:p0215:b003:l026","ordinal":93168,"en":"The swift horses to race in Bukhara"},{"id":"semetey-1-2013:p0215:b003:l027","ordinal":93169,"en":"Were six hundred forty-three."},{"id":"semetey-1-2013:p0215:b003:l028","ordinal":93170,"en":"Then your noble sister-in-law Kanykey:"},{"id":"semetey-1-2013:p0215:b003:l029","ordinal":93171,"en":"“When the moon grows dark,"},{"id":"semetey-1-2013:p0215:b003:l030","ordinal":93172,"en":"What will my night be like?” she said."},{"id":"semetey-1-2013:p0215:b003:l031","ordinal":93173,"en":"“If Taytoru falls behind,"},{"id":"semetey-1-2013:p0215:b003:l032","ordinal":93174,"en":"What will my days be like?” she said."},{"id":"semetey-1-2013:p0215:b003:l033","ordinal":93175,"en":"“I have no support to rely upon."},{"id":"semetey-1-2013:p0215:b003:l034","ordinal":93176,"en":"My Kyrgyz people are not here."},{"id":"semetey-1-2013:p0215:b003:l035","ordinal":93177,"en":"Were you like this, you shitty world?”"},{"id":"semetey-1-2013:p0215:b003:l036","ordinal":93178,"en":"In this world her words were plain;"},{"id":"semetey-1-2013:p0215:b003:l037","ordinal":93179,"en":"Until she died, your sister-in-law"},{"id":"semetey-1-2013:p0215:b003:l038","ordinal":93180,"en":"Was an outstanding judge with seeing eyes."},{"id":"semetey-1-2013:p0215:b003:l039","ordinal":93181,"en":"“With bits made of iron,"},{"id":"semetey-1-2013:p0215:b004:l001","ordinal":93182,"en":"Are there swift horses to champ them?"},{"id":"semetey-1-2013:p0215:b004:l002","ordinal":93183,"en":"On the uphill slopes, wrenching out their lungs,"},{"id":"semetey-1-2013:p0215:b004:l003","ordinal":93184,"en":"God, are there swift horses to contend?"}]
