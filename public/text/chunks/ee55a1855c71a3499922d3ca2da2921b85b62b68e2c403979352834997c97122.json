[{"id":"semetey-1-2013:p0486:b003:l024","ordinal":114177,"en":"The gleaming golden throne"},{"id":"semetey-1-2013:p0486:b003:l025","ordinal":114178,"en":"He repudiated and abandoned."},{"id":"semetey-1-2013:p0486:b003:l026","ordinal":114179,"en":"Upon this very Beijing"},{"id":"semetey-1-2013:p0486:b003:l027","ordinal":114180,"en":"He brought great torment."},{"id":"semetey-1-2013:p0486:b003:l028","ordinal":114181,"en":"Without saddling Sarala,"},{"id":"semetey-1-2013:p0486:b003:l029","ordinal":114182,"en":"The great house-sized idol"},{"id":"semetey-1-2013:p0486:b003:l030","ordinal":114183,"en":"He rejected, refusing to bow."},{"id":"semetey-1-2013:p0486:b003:l031","ordinal":114184,"en":"He raised Sarala into a steed."},{"id":"semetey-1-2013:p0486:b003:l032","ordinal":114185,"en":"The forty Chinese tribes, that dear people—"},{"id":"semetey-1-2013:p0486:b003:l033","ordinal":114186,"en":"He abandoned them all and made them strangers."},{"id":"semetey-1-2013:p0486:b003:l034","ordinal":114187,"en":"Those who witnessed his renown were frightened."},{"id":"semetey-1-2013:p0486:b003:l035","ordinal":114188,"en":"Alas, this world!"},{"id":"semetey-1-2013:p0486:b003:l036","ordinal":114189,"en":"He had studied wondrous spells."},{"id":"semetey-1-2013:p0486:b003:l037","ordinal":114190,"en":"Mist parts before him."},{"id":"semetey-1-2013:p0486:b003:l038","ordinal":114191,"en":"Behind that Bakai"},{"id":"semetey-1-2013:p0486:b003:l039","ordinal":114192,"en":"Dear Almambet can be seen coming."},{"id":"semetey-1-2013:p0486:b004:l001","ordinal":114193,"en":"When I look behind him—"},{"id":"semetey-1-2013:p0486:b004:l002","ordinal":114194,"en":"Piercing cries, shrill battle shouts,"},{"id":"semetey-1-2013:p0486:b004:l003","ordinal":114195,"en":"Mottled clouds, blue storm,"},{"id":"semetey-1-2013:p0486:b004:l004","ordinal":114196,"en":"Rain beneath them,"},{"id":"semetey-1-2013:p0486:b004:l005","ordinal":114197,"en":"Low mist at their farthest edge—"},{"id":"semetey-1-2013:p0486:b004:l006","ordinal":114198,"en":"It is Almambet's weather magic."},{"id":"semetey-1-2013:p0486:b004:l007","ordinal":114199,"en":"Look carefully, Közkaman:"},{"id":"semetey-1-2013:p0486:b004:l008","ordinal":114200,"en":"Among these pursuers"},{"id":"semetey-1-2013:p0486:b004:l009","ordinal":114201,"en":"There is leopard Chubak."},{"id":"semetey-1-2013:p0486:b004:l010","ordinal":114202,"en":"God who strikes will surely strike us."},{"id":"semetey-1-2013:p0486:b004:l011","ordinal":114203,"en":"If Khan Manas grows wrathful,"},{"id":"semetey-1-2013:p0486:b004:l012","ordinal":114204,"en":"Syrgak, son of Ulakan,"},{"id":"semetey-1-2013:p0486:b004:l013","ordinal":114205,"en":"Will batter, crush and slaughter us."},{"id":"semetey-1-2013:p0486:b004:l014","ordinal":114206,"en":"If Bakai reaches us, he will bind us."},{"id":"semetey-1-2013:p0486:b004:l015","ordinal":114207,"en":"Khan Manas's forty zaisans—"},{"id":"semetey-1-2013:p0486:b004:l016","ordinal":114208,"en":"Let the wrestlers gather from Beijing;"},{"id":"semetey-1-2013:p0486:b004:l017","ordinal":114209,"en":"He will drive them off in one sweep!"},{"id":"semetey-1-2013:p0486:b004:l018","ordinal":114210,"en":"He will seize their girls,"},{"id":"semetey-1-2013:p0486:b004:l019","ordinal":114211,"en":"Will bring such a spectacle upon them!"},{"id":"semetey-1-2013:p0486:b004:l020","ordinal":114212,"en":"Cloudy by day, clear by night,"},{"id":"semetey-1-2013:p0486:b004:l021","ordinal":114213,"en":"The weather's temper has been disturbed."},{"id":"semetey-1-2013:p0486:b004:l022","ordinal":114214,"en":"Hide and seek"},{"id":"semetey-1-2013:p0486:b004:l023","ordinal":114215,"en":"Could an idol strike like this?"},{"id":"semetey-1-2013:p0486:b004:l024","ordinal":114216,"en":"These Kyrgyz will not rest without slaughter;"},{"id":"semetey-1-2013:p0486:b004:l025","ordinal":114217,"en":"They will not stand without doing something."},{"id":"semetey-1-2013:p0486:b004:l026","ordinal":114218,"en":"A pale, mottled flag rises."},{"id":"semetey-1-2013:p0486:b004:l027","ordinal":114219,"en":"Sounding the battle cry, “Ystan!”"},{"id":"semetey-1-2013:p0486:b004:l028","ordinal":114220,"en":"A tumult of ‘Woe, woe!’ rises.”"},{"id":"semetey-1-2013:p0486:b004:l029","ordinal":114221,"en":"When Zheldeiboz had spoken,"},{"id":"semetey-1-2013:p0486:b004:l030","ordinal":114222,"en":"When he reached Kökchököz and Közkaman"},{"id":"semetey-1-2013:p0486:b004:l031","ordinal":114223,"en":"And delivered the news,"},{"id":"semetey-1-2013:p0486:b004:l032","ordinal":114224,"en":"Hurrying in excited haste,"},{"id":"semetey-1-2013:p0486:b004:l033","ordinal":114225,"en":"They readied their battle gear."},{"id":"semetey-1-2013:p0486:b004:l034","ordinal":114226,"en":"The swords that came from Beijing"},{"id":"semetey-1-2013:p0486:b004:l035","ordinal":114227,"en":"They drew from their sheaths, preparing."},{"id":"semetey-1-2013:p0486:b004:l036","ordinal":114228,"en":"With battle-axe and firearm,"},{"id":"semetey-1-2013:p0486:b004:l037","ordinal":114229,"en":"Those gray-maned heroes, skilled in their use,"},{"id":"semetey-1-2013:p0486:b004:l038","ordinal":114230,"en":"Made ready all their equipment."},{"id":"semetey-1-2013:p0486:b004:l039","ordinal":114231,"en":"Do not ask about Közkaman,"},{"id":"semetey-1-2013:p0487:b003:l001","ordinal":114232,"en":"A servant skilled among spearmen,"},{"id":"semetey-1-2013:p0487:b003:l002","ordinal":114233,"en":"Who had fought many enemies,"},{"id":"semetey-1-2013:p0487:b003:l003","ordinal":114234,"en":"A mighty servant made expert."},{"id":"semetey-1-2013:p0487:b003:l004","ordinal":114235,"en":"Walking on foot for six years,"},{"id":"semetey-1-2013:p0487:b003:l005","ordinal":114236,"en":"He had greased sixty swords"},{"id":"semetey-1-2013:p0487:b003:l006","ordinal":114237,"en":"And slain those who grappled with him."},{"id":"semetey-1-2013:p0487:b003:l007","ordinal":114238,"en":"Killing sixty giants,"},{"id":"semetey-1-2013:p0487:b003:l008","ordinal":114239,"en":"He had become a renowned master."},{"id":"semetey-1-2013:p0487:b003:l009","ordinal":114240,"en":"Walking without rest for seven years,"},{"id":"semetey-1-2013:p0487:b003:l010","ordinal":114241,"en":"He had readied seventy swords,"},{"id":"semetey-1-2013:p0487:b003:l011","ordinal":114242,"en":"Had slain seventy giants,"},{"id":"semetey-1-2013:p0487:b003:l012","ordinal":114243,"en":"An utterly accomplished sorcerer,"},{"id":"semetey-1-2013:p0487:b003:l013","ordinal":114244,"en":"Fighting wherever he arrived."},{"id":"semetey-1-2013:p0487:b003:l014","ordinal":114245,"en":"The girl who opened the garden,"},{"id":"semetey-1-2013:p0487:b003:l015","ordinal":114246,"en":"Közkaman was unlike other men."},{"id":"semetey-1-2013:p0487:b003:l016","ordinal":114247,"en":"After hearing this news,"},{"id":"semetey-1-2013:p0487:b003:l017","ordinal":114248,"en":"He raged and bellowed,"},{"id":"semetey-1-2013:p0487:b003:l018","ordinal":114249,"en":"Calling to the troops beside him,"},{"id":"semetey-1-2013:p0487:b003:l019","ordinal":114250,"en":"“Make ready!”"},{"id":"semetey-1-2013:p0487:b003:l020","ordinal":114251,"en":"His marksmen who never missed"},{"id":"semetey-1-2013:p0487:b003:l021","ordinal":114252,"en":"He readied all together."},{"id":"semetey-1-2013:p0487:b003:l022","ordinal":114253,"en":"To die in battle,"},{"id":"semetey-1-2013:p0487:b003:l023","ordinal":114254,"en":"He did not stand idly without preparing."},{"id":"semetey-1-2013:p0487:b003:l024","ordinal":114255,"en":"The skilled wielders of battle-axes,"},{"id":"semetey-1-2013:p0487:b003:l025","ordinal":114256,"en":"Those who struck unerringly with swords,"},{"id":"semetey-1-2013:p0487:b003:l026","ordinal":114257,"en":"The ruthless champions—"},{"id":"semetey-1-2013:p0487:b003:l027","ordinal":114258,"en":"One leader for ten men,"},{"id":"semetey-1-2013:p0487:b003:l028","ordinal":114259,"en":"One worthy man for thirty,"},{"id":"semetey-1-2013:p0487:b003:l029","ordinal":114260,"en":"One skilled man for sixty,"},{"id":"semetey-1-2013:p0487:b003:l030","ordinal":114261,"en":"One champion over a hundred—"},{"id":"semetey-1-2013:p0487:b003:l031","ordinal":114262,"en":"He appointed their leaders."},{"id":"semetey-1-2013:p0487:b003:l032","ordinal":114263,"en":"That wrestler Kökchököz"},{"id":"semetey-1-2013:p0487:b003:l033","ordinal":114264,"en":"Did not stand idle for nothing."},{"id":"semetey-1-2013:p0487:b003:l034","ordinal":114265,"en":"When Kökchököz and Közkaman"},{"id":"semetey-1-2013:p0487:b003:l035","ordinal":114266,"en":"Gave their orders in turn,"},{"id":"semetey-1-2013:p0487:b003:l036","ordinal":114267,"en":"The leaders of ten bobbed along,"},{"id":"semetey-1-2013:p0487:b003:l037","ordinal":114268,"en":"Their spears jutting upward."},{"id":"semetey-1-2013:p0487:b003:l038","ordinal":114269,"en":"The leaders of fifty and a hundred"},{"id":"semetey-1-2013:p0487:b003:l039","ordinal":114270,"en":"Advanced with their troops."},{"id":"semetey-1-2013:p0487:b004:l001","ordinal":114271,"en":"The spear-points clashed."},{"id":"semetey-1-2013:p0487:b004:l002","ordinal":114272,"en":"Thoroughly prepared and armed,"},{"id":"semetey-1-2013:p0487:b004:l003","ordinal":114273,"en":"Making firm preparations for battle,"},{"id":"semetey-1-2013:p0487:b004:l004","ordinal":114274,"en":"The heroes faced each other."},{"id":"semetey-1-2013:p0487:b004:l005","ordinal":114275,"en":"Renowned Manas and Bakai Khan,"},{"id":"semetey-1-2013:p0487:b004:l006","ordinal":114276,"en":"Over the summit of Kara-Kyr,"},{"id":"semetey-1-2013:p0487:b004:l007","ordinal":114277,"en":"Crossed Kara-Kyr."},{"id":"semetey-1-2013:p0487:b004:l008","ordinal":114278,"en":"That fugitive Közkaman"},{"id":"semetey-1-2013:p0487:b004:l009","ordinal":114279,"en":"Moved into their midst."},{"id":"semetey-1-2013:p0487:b004:l010","ordinal":114280,"en":"See the mist, see the dust;"},{"id":"semetey-1-2013:p0487:b004:l011","ordinal":114281,"en":"See the souls dying face to face."},{"id":"semetey-1-2013:p0487:b004:l012","ordinal":114282,"en":"See the embers burning through the haze;"},{"id":"semetey-1-2013:p0487:b004:l013","ordinal":114283,"en":"See the bullets striking without deflection."},{"id":"semetey-1-2013:p0487:b004:l014","ordinal":114284,"en":"See the rain, see the embers;"},{"id":"semetey-1-2013:p0487:b004:l015","ordinal":114285,"en":"See the bullets striking without a miss."},{"id":"semetey-1-2013:p0487:b004:l016","ordinal":114286,"en":"Khan Manas's forty champions:"},{"id":"semetey-1-2013:p0487:b004:l017","ordinal":114287,"en":"The foremost, Azhybai and Bakai,"},{"id":"semetey-1-2013:p0487:b004:l018","ordinal":114288,"en":"The gray-maned heroes Almambet and Chubak,"},{"id":"semetey-1-2013:p0487:b004:l019","ordinal":114289,"en":"The paired heroes Syrgak and Serek,"},{"id":"semetey-1-2013:p0487:b004:l020","ordinal":114290,"en":"The ocean-like Shuutu the servant and Yrchy."},{"id":"semetey-1-2013:p0487:b004:l021","ordinal":114291,"en":"Kökchököz and Közkaman,"},{"id":"semetey-1-2013:p0487:b004:l022","ordinal":114292,"en":"Skilled wherever they appeared,"},{"id":"semetey-1-2013:p0487:b004:l023","ordinal":114293,"en":"Champions who knew the craft of many enemies,"},{"id":"semetey-1-2013:p0487:b004:l025","ordinal":114294,"en":"Shouted to the wrestlers,"},{"id":"semetey-1-2013:p0487:b004:l026","ordinal":114295,"en":"Called their archers,"},{"id":"semetey-1-2013:p0487:b004:l027","ordinal":114296,"en":"And sent word to their executioners."},{"id":"semetey-1-2013:p0487:b004:l028","ordinal":114297,"en":"Bakai Khan and mighty Manas"},{"id":"semetey-1-2013:p0487:b004:l029","ordinal":114298,"en":"Advanced side by side."},{"id":"semetey-1-2013:p0487:b004:l030","ordinal":114299,"en":"Hear what befell the Chinese!"},{"id":"semetey-1-2013:p0487:b004:l031","ordinal":114300,"en":"Kökchököz and Közkaman,"},{"id":"semetey-1-2013:p0487:b004:l032","ordinal":114301,"en":"Hacking toward those men,"},{"id":"semetey-1-2013:p0487:b004:l033","ordinal":114302,"en":"Without looking about them,"},{"id":"semetey-1-2013:p0487:b004:l034","ordinal":114303,"en":"All entered battle,"},{"id":"semetey-1-2013:p0487:b004:l035","ordinal":114304,"en":"Not sparing their coin-sized lives."},{"id":"semetey-1-2013:p0487:b004:l036","ordinal":114305,"en":"Without looking around,"},{"id":"semetey-1-2013:p0487:b004:l037","ordinal":114306,"en":"The mighty men entered battle,"},{"id":"semetey-1-2013:p0487:b004:l038","ordinal":114307,"en":"Not sparing their hair-thin lives."},{"id":"semetey-1-2013:p0487:b004:l039","ordinal":114308,"en":"Making rain, drawing their bows,"},{"id":"semetey-1-2013:p0488:b003:l001","ordinal":114309,"en":"The Kalmyks, all mighty wrestlers,"},{"id":"semetey-1-2013:p0488:b003:l002","ordinal":114310,"en":"Shot bullets like hail."},{"id":"semetey-1-2013:p0488:b003:l003","ordinal":114311,"en":"Roaring in wrath,"},{"id":"semetey-1-2013:p0488:b003:l004","ordinal":114312,"en":"Shouting ‘Khagan!’ as their battle cry,"},{"id":"semetey-1-2013:p0488:b003:l005","ordinal":114313,"en":"The valiant Közkaman"},{"id":"semetey-1-2013:p0488:b003:l006","ordinal":114314,"en":"Cried out and joined the struggle."},{"id":"semetey-1-2013:p0488:b003:l007","ordinal":114315,"en":"Those Kalmyks in the open steppe"},{"id":"semetey-1-2013:p0488:b003:l008","ordinal":114316,"en":"Fired without cease for six days."},{"id":"semetey-1-2013:p0488:b003:l009","ordinal":114317,"en":"All were renowned champions,"},{"id":"semetey-1-2013:p0488:b003:l010","ordinal":114318,"en":"Chosen men who came from Beijing."},{"id":"semetey-1-2013:p0488:b003:l011","ordinal":114319,"en":"Their appearance unlike other mortals,"},{"id":"semetey-1-2013:p0488:b003:l012","ordinal":114320,"en":"They pressed in, striking at heads,"},{"id":"semetey-1-2013:p0488:b003:l013","ordinal":114321,"en":"Firing without sparing themselves."},{"id":"semetey-1-2013:p0488:b003:l014","ordinal":114322,"en":"The roaring guns,"},{"id":"semetey-1-2013:p0488:b003:l015","ordinal":114323,"en":"Gray haze, red embers,"},{"id":"semetey-1-2013:p0488:b003:l016","ordinal":114324,"en":"Pale-burning, blazing bullets."},{"id":"semetey-1-2013:p0488:b003:l017","ordinal":114325,"en":"They fought without cease for seven days."},{"id":"semetey-1-2013:p0488:b003:l018","ordinal":114326,"en":"Against one another, Muslims"},{"id":"semetey-1-2013:p0488:b003:l019","ordinal":114327,"en":"And unbelievers mingled,"},{"id":"semetey-1-2013:p0488:b003:l020","ordinal":114328,"en":"Stood unable to press through."},{"id":"semetey-1-2013:p0488:b003:l021","ordinal":114329,"en":"Death could not quite reach them."},{"id":"semetey-1-2013:p0488:b003:l022","ordinal":114330,"en":"They fought with battle-axes,"},{"id":"semetey-1-2013:p0488:b003:l023","ordinal":114331,"en":"Unable to mingle in close combat."},{"id":"semetey-1-2013:p0488:b003:l024","ordinal":114332,"en":"Facing each other on opposite sides,"},{"id":"semetey-1-2013:p0488:b003:l025","ordinal":114333,"en":"Unable to reach with spears,"},{"id":"semetey-1-2013:p0488:b003:l026","ordinal":114334,"en":"They fired their guns."},{"id":"semetey-1-2013:p0488:b003:l027","ordinal":114335,"en":"Golden forelock, tasseled belt,"},{"id":"semetey-1-2013:p0488:b003:l028","ordinal":114336,"en":"The only son of Azyz Khan,"},{"id":"semetey-1-2013:p0488:b003:l029","ordinal":114337,"en":"A lion hero made expert,"},{"id":"semetey-1-2013:p0488:b003:l030","ordinal":114338,"en":"Dear Almambet entered without holding back"},{"id":"semetey-1-2013:p0488:b003:l031","ordinal":114339,"en":"And fought with gunfire there."},{"id":"semetey-1-2013:p0488:b003:l032","ordinal":114340,"en":"Battling with the Chinese,"},{"id":"semetey-1-2013:p0488:b003:l033","ordinal":114341,"en":"Had not your Almambet grown up?"},{"id":"semetey-1-2013:p0488:b003:l034","ordinal":114342,"en":"Exchanging fire with the khagan,"},{"id":"semetey-1-2013:p0488:b003:l035","ordinal":114343,"en":"Had not your Almambet grown accustomed?"},{"id":"semetey-1-2013:p0488:b003:l036","ordinal":114344,"en":"Many terrors and disasters—"},{"id":"semetey-1-2013:p0488:b003:l037","ordinal":114345,"en":"Had not your Almambet seen them?"},{"id":"semetey-1-2013:p0488:b003:l038","ordinal":114346,"en":"Syrbarang upon his shoulder,"},{"id":"semetey-1-2013:p0488:b003:l039","ordinal":114347,"en":"Dear Almambet took it up."},{"id":"semetey-1-2013:p0488:b004:l001","ordinal":114348,"en":"Dear Kanykei, your sister-in-law,"},{"id":"semetey-1-2013:p0488:b004:l002","ordinal":114349,"en":"Had carefully and firmly made"},{"id":"semetey-1-2013:p0488:b004:l003","ordinal":114350,"en":"The white saddlebag upon the saddle,"},{"id":"semetey-1-2013:p0488:b004:l004","ordinal":114351,"en":"Its inside full of steel bullets,"},{"id":"semetey-1-2013:p0488:b004:l005","ordinal":114352,"en":"A saddlebag fitted to Sarala."},{"id":"semetey-1-2013:p0488:b004:l006","ordinal":114353,"en":"From Sarala's back"},{"id":"semetey-1-2013:p0488:b004:l007","ordinal":114354,"en":"He took the white saddlebag."},{"id":"semetey-1-2013:p0488:b004:l008","ordinal":114355,"en":"Calling to God in supplication,"},{"id":"semetey-1-2013:p0488:b004:l009","ordinal":114356,"en":"It had nine buttons;"},{"id":"semetey-1-2013:p0488:b004:l010","ordinal":114357,"en":"He undid its buttons."},{"id":"semetey-1-2013:p0488:b004:l011","ordinal":114358,"en":"It had nine clasps;"},{"id":"semetey-1-2013:p0488:b004:l012","ordinal":114359,"en":"He undid its clasps."},{"id":"semetey-1-2013:p0488:b004:l013","ordinal":114360,"en":"The mighty gun Syrbarang"},{"id":"semetey-1-2013:p0488:b004:l014","ordinal":114361,"en":"He scraped with its scraper,"},{"id":"semetey-1-2013:p0488:b004:l015","ordinal":114362,"en":"Striking the end of its stock"},{"id":"semetey-1-2013:p0488:b004:l016","ordinal":114363,"en":"Against a black stone."},{"id":"semetey-1-2013:p0488:b004:l017","ordinal":114364,"en":"He set an ember to its match,"},{"id":"semetey-1-2013:p0488:b004:l018","ordinal":114365,"en":"Two at each loading"},{"id":"semetey-1-2013:p0488:b004:l019","ordinal":114366,"en":"Into Syrbarang,"},{"id":"semetey-1-2013:p0488:b004:l020","ordinal":114367,"en":"Putting in rattling bullets."},{"id":"semetey-1-2013:p0488:b004:l021","ordinal":114368,"en":"They stared hard at each other and fired,"},{"id":"semetey-1-2013:p0488:b004:l022","ordinal":114369,"en":"Enduring hardship in earnest."},{"id":"semetey-1-2013:p0488:b004:l023","ordinal":114370,"en":"A quantity of steel bullets"},{"id":"semetey-1-2013:p0488:b004:l024","ordinal":114371,"en":"Your stalwart Almambet took."},{"id":"semetey-1-2013:p0488:b004:l025","ordinal":114372,"en":"Kökchököz and Közkaman,"},{"id":"semetey-1-2013:p0488:b004:l026","ordinal":114373,"en":"Open executioners, fleet-footed runners—"},{"id":"semetey-1-2013:p0488:b004:l027","ordinal":114374,"en":"Wherever Almambet saw them,"},{"id":"semetey-1-2013:p0488:b004:l028","ordinal":114375,"en":"Joining one report to the next,"},{"id":"semetey-1-2013:p0488:b004:l029","ordinal":114376,"en":"Reddening its mouth like fire,"},{"id":"semetey-1-2013:p0488:b004:l030","ordinal":114377,"en":"Your leopard Almambet"},{"id":"semetey-1-2013:p0488:b004:l031","ordinal":114378,"en":"Brought them under thundering gunfire."},{"id":"semetey-1-2013:p0488:b004:l032","ordinal":114379,"en":"Mist thickened, dust covered everything;"},{"id":"semetey-1-2013:p0488:b004:l033","ordinal":114380,"en":"The earth could no longer be seen."},{"id":"semetey-1-2013:p0488:b004:l034","ordinal":114381,"en":"The Chinese rang out, undaunted."},{"id":"semetey-1-2013:p0488:b004:l035","ordinal":114382,"en":"The shots fired by your mighty Almambet—"},{"id":"semetey-1-2013:p0488:b004:l036","ordinal":114383,"en":"Kökchököz and mighty Közkaman"},{"id":"semetey-1-2013:p0488:b004:l037","ordinal":114384,"en":"Lay down, untroubled."},{"id":"semetey-1-2013:p0488:b004:l038","ordinal":114385,"en":"When bullets struck, all blazing together,"},{"id":"semetey-1-2013:p0488:b004:l039","ordinal":114386,"en":"Only Chinese heroes,"},{"id":"semetey-1-2013:p0489:b003:l001","ordinal":114387,"en":"Taking no account of their circumstances."},{"id":"semetey-1-2013:p0489:b003:l002","ordinal":114388,"en":"Közkaman, a surpassing weather-sorcerer,"},{"id":"semetey-1-2013:p0489:b003:l003","ordinal":114389,"en":"Was raising the wind."},{"id":"semetey-1-2013:p0489:b003:l004","ordinal":114390,"en":"The exceedingly nimble Kökchököz"},{"id":"semetey-1-2013:p0489:b003:l005","ordinal":114391,"en":"Was working his devices."},{"id":"semetey-1-2013:p0489:b003:l006","ordinal":114392,"en":"Their bullets poured like rain."},{"id":"semetey-1-2013:p0489:b003:l007","ordinal":114393,"en":"Among the gray-maned warriors, all wrestlers,"},{"id":"semetey-1-2013:p0489:b003:l008","ordinal":114394,"en":"The weather-magician stood apart."},{"id":"semetey-1-2013:p0489:b003:l009","ordinal":114395,"en":"They aimed at one another,"},{"id":"semetey-1-2013:p0489:b003:l010","ordinal":114396,"en":"Unable to strike exactly."},{"id":"semetey-1-2013:p0489:b003:l011","ordinal":114397,"en":"All were mighty wrestlers and heroes,"},{"id":"semetey-1-2013:p0489:b003:l012","ordinal":114398,"en":"Unable to overcome one another."},{"id":"semetey-1-2013:p0489:b003:l013","ordinal":114399,"en":"Do not ask about Közkaman's nature:"},{"id":"semetey-1-2013:p0489:b003:l014","ordinal":114400,"en":"A foal of Islam,"},{"id":"semetey-1-2013:p0489:b003:l015","ordinal":114401,"en":"That swine of the dark faith"},{"id":"semetey-1-2013:p0489:b003:l016","ordinal":114402,"en":"Was truly a son of the Kyrgyz."},{"id":"semetey-1-2013:p0489:b003:l017","ordinal":114403,"en":"Descended from a mighty house,"},{"id":"semetey-1-2013:p0489:b003:l018","ordinal":114404,"en":"Do not belittle him as an unbeliever;"},{"id":"semetey-1-2013:p0489:b003:l019","ordinal":114405,"en":"He too was of princely stock."},{"id":"semetey-1-2013:p0489:b003:l020","ordinal":114406,"en":"Hero Manas's grandfather,"},{"id":"semetey-1-2013:p0489:b003:l021","ordinal":114407,"en":"Zhakyp Khan's father,"},{"id":"semetey-1-2013:p0489:b003:l022","ordinal":114408,"en":"When the warrior Karakan died,"},{"id":"semetey-1-2013:p0489:b003:l023","ordinal":114409,"en":"Karakan's eight sons—"},{"id":"semetey-1-2013:p0489:b003:l024","ordinal":114410,"en":"Some single-born, some twins."},{"id":"semetey-1-2013:p0489:b003:l025","ordinal":114411,"en":"When their mighty father Karakan died,"},{"id":"semetey-1-2013:p0489:b003:l026","ordinal":114412,"en":"The black khan's eight sons"},{"id":"semetey-1-2013:p0489:b003:l027","ordinal":114413,"en":"Were left young, still crawling,"},{"id":"semetey-1-2013:p0489:b003:l028","ordinal":114414,"en":"All unable to lift their bellies,"},{"id":"semetey-1-2013:p0489:b003:l029","ordinal":114415,"en":"All left dazed and helpless."},{"id":"semetey-1-2013:p0489:b003:l030","ordinal":114416,"en":"Karakan's children"},{"id":"semetey-1-2013:p0489:b003:l031","ordinal":114417,"en":"Were themselves tiny children."},{"id":"semetey-1-2013:p0489:b003:l032","ordinal":114418,"en":"As they struggled to stay alive,"},{"id":"semetey-1-2013:p0489:b003:l033","ordinal":114419,"en":"They led one another by the hand."},{"id":"semetey-1-2013:p0489:b003:l034","ordinal":114420,"en":"Karakan's eight sons,"},{"id":"semetey-1-2013:p0489:b003:l035","ordinal":114421,"en":"When they suffered great sorrow,"},{"id":"semetey-1-2013:p0489:b003:l036","ordinal":114422,"en":"When their khan father died,"},{"id":"semetey-1-2013:p0489:b003:l037","ordinal":114423,"en":"The unbelieving people raged."},{"id":"semetey-1-2013:p0489:b003:l038","ordinal":114424,"en":"Plundering a dead khan's estate—a terrible thing,"},{"id":"semetey-1-2013:p0489:b003:l039","ordinal":114425,"en":"Among the dark Kalmyks and Manchu,"},{"id":"semetey-1-2013:p0489:b005:l001","ordinal":114426,"en":"The days were twenty."},{"id":"semetey-1-2013:p0489:b005:l002","ordinal":114427,"en":"“This is what happens when a khan dies,” they said,"},{"id":"semetey-1-2013:p0489:b005:l003","ordinal":114428,"en":"Robbing the people whose khan had died,"},{"id":"semetey-1-2013:p0489:b005:l004","ordinal":114429,"en":"Making plunder their custom."},{"id":"semetey-1-2013:p0489:b005:l005","ordinal":114430,"en":"The eight sons were driven off in eight directions;"},{"id":"semetey-1-2013:p0489:b005:l006","ordinal":114431,"en":"Where they went, no one knew,"},{"id":"semetey-1-2013:p0489:b005:l007","ordinal":114432,"en":"Their hands bound behind them."}]
