[{"id":"semetey-1-2013:p0707:b005:l027","ordinal":130561,"en":"Would kill you for nothing,"},{"id":"semetey-1-2013:p0707:b005:l028","ordinal":130562,"en":"Your twig was cut,"},{"id":"semetey-1-2013:p0707:b005:l029","ordinal":130563,"en":"Your ritual was performed."},{"id":"semetey-1-2013:p0707:b005:l030","ordinal":130564,"en":"You were passed through a dog's bowl,"},{"id":"semetey-1-2013:p0707:b005:l031","ordinal":130565,"en":"Made to step over a sword's edge;"},{"id":"semetey-1-2013:p0707:b005:l032","ordinal":130566,"en":"An amulet was hung about your neck."},{"id":"semetey-1-2013:p0707:b005:l033","ordinal":130567,"en":"Because of accursed Kobosh,"},{"id":"semetey-1-2013:p0707:b005:l034","ordinal":130568,"en":"In Temirkan's city"},{"id":"semetey-1-2013:p0707:b005:l035","ordinal":130569,"en":"You wandered away and were raised."},{"id":"semetey-1-2013:p0707:b005:l036","ordinal":130570,"en":"Let me circle round you in devotion;"},{"id":"semetey-1-2013:p0707:b005:l037","ordinal":130571,"en":"I have much to tell."},{"id":"semetey-1-2013:p0707:b005:l038","ordinal":130572,"en":"In swine Kobosh's hands"},{"id":"semetey-1-2013:p0707:b005:l039","ordinal":130573,"en":"Are the forty warriors left by your father."},{"id":"semetey-1-2013:p0708:b003:l001","ordinal":130574,"en":"The forty were dogs from forty different places;"},{"id":"semetey-1-2013:p0708:b003:l002","ordinal":130575,"en":"What men were they, if not dogs?"},{"id":"semetey-1-2013:p0708:b003:l003","ordinal":130576,"en":"One warrior came without a horse."},{"id":"semetey-1-2013:p0708:b003:l004","ordinal":130577,"en":"To the warrior who came horseless,"},{"id":"semetey-1-2013:p0708:b003:l005","ordinal":130578,"en":"Wild-sheep-footed, brazen-legged,"},{"id":"semetey-1-2013:p0708:b003:l006","ordinal":130579,"en":"He gave a winged steed to ride."},{"id":"semetey-1-2013:p0708:b003:l007","ordinal":130580,"en":"One warrior came without a coat."},{"id":"semetey-1-2013:p0708:b003:l008","ordinal":130581,"en":"To the warrior who came coatless,"},{"id":"semetey-1-2013:p0708:b003:l009","ordinal":130582,"en":"Golden-collared, brazen-sleeved,"},{"id":"semetey-1-2013:p0708:b003:l010","ordinal":130583,"en":"Double-mailed, bulletproof,"},{"id":"semetey-1-2013:p0708:b003:l011","ordinal":130584,"en":"Your father gave a coat to wear."},{"id":"semetey-1-2013:p0708:b003:l012","ordinal":130585,"en":"One warrior came without livestock."},{"id":"semetey-1-2013:p0708:b003:l013","ordinal":130586,"en":"To the warrior who came stockless,"},{"id":"semetey-1-2013:p0708:b003:l014","ordinal":130587,"en":"Six vast herds of horses on the hills,"},{"id":"semetey-1-2013:p0708:b003:l015","ordinal":130588,"en":"Thoroughbreds and swift steeds mixed,"},{"id":"semetey-1-2013:p0708:b003:l016","ordinal":130589,"en":"Mighty Manas gave as his share."},{"id":"semetey-1-2013:p0708:b003:l017","ordinal":130590,"en":"One warrior came without a wife."},{"id":"semetey-1-2013:p0708:b003:l018","ordinal":130591,"en":"For the warrior who came wifeless,"},{"id":"semetey-1-2013:p0708:b003:l019","ordinal":130592,"en":"In crimson dresses, slender-waisted,"},{"id":"semetey-1-2013:p0708:b003:l020","ordinal":130593,"en":"With thimble-small mouths and camel-calf eyes,"},{"id":"semetey-1-2013:p0708:b003:l021","ordinal":130594,"en":"With dark eyes glancing coyly,"},{"id":"semetey-1-2013:p0708:b003:l022","ordinal":130595,"en":"Waists like scabbards, faces like the moon,"},{"id":"semetey-1-2013:p0708:b003:l023","ordinal":130596,"en":"From renowned beautiful girls,"},{"id":"semetey-1-2013:p0708:b003:l024","ordinal":130597,"en":"Heroic Manas obtained a bride."},{"id":"semetey-1-2013:p0708:b003:l025","ordinal":130598,"en":"When your father died,"},{"id":"semetey-1-2013:p0708:b003:l026","ordinal":130599,"en":"Those beasts turned to plotting."},{"id":"semetey-1-2013:p0708:b003:l027","ordinal":130600,"en":"Without looking back at your father Manas,"},{"id":"semetey-1-2013:p0708:b003:l028","ordinal":130601,"en":"The forty warriors went out to the wilds."},{"id":"semetey-1-2013:p0708:b003:l029","ordinal":130602,"en":"Now those forty warriors"},{"id":"semetey-1-2013:p0708:b003:l030","ordinal":130603,"en":"Settled Urbus and made it their territory;"},{"id":"semetey-1-2013:p0708:b003:l031","ordinal":130604,"en":"They made the six villains their lords."},{"id":"semetey-1-2013:p0708:b003:l032","ordinal":130605,"en":"The strongest of the forty warriors now,"},{"id":"semetey-1-2013:p0708:b003:l033","ordinal":130606,"en":"Kyrgylchal at their head, and Tazbaimat—"},{"id":"semetey-1-2013:p0708:b003:l034","ordinal":130607,"en":"The leader of the forty, Kyrgylchal,"},{"id":"semetey-1-2013:p0708:b003:l035","ordinal":130608,"en":"That mad old man, swollen with pride among the forty,"},{"id":"semetey-1-2013:p0708:b003:l036","ordinal":130609,"en":"Always thought up wicked words."},{"id":"semetey-1-2013:p0708:b003:l037","ordinal":130610,"en":"Even if he ruined everything,"},{"id":"semetey-1-2013:p0708:b004:l001","ordinal":130611,"en":"Your swift-steed, leopard father"},{"id":"semetey-1-2013:p0708:b004:l002","ordinal":130612,"en":"Never said, ‘He has ruined it.’"},{"id":"semetey-1-2013:p0708:b004:l003","ordinal":130613,"en":"Turning away, the forty warriors,"},{"id":"semetey-1-2013:p0708:b004:l004","ordinal":130614,"en":"Most forgetting Talas,"},{"id":"semetey-1-2013:p0708:b004:l005","ordinal":130615,"en":"Abandoned—do you see?—"},{"id":"semetey-1-2013:p0708:b004:l006","ordinal":130616,"en":"Your father, Sultan Manas."},{"id":"semetey-1-2013:p0708:b004:l007","ordinal":130617,"en":"Damn them, the forty warriors!"},{"id":"semetey-1-2013:p0708:b004:l008","ordinal":130618,"en":"The forty were dogs from forty different places;"},{"id":"semetey-1-2013:p0708:b004:l009","ordinal":130619,"en":"What men were they, if not dogs?"},{"id":"semetey-1-2013:p0708:b004:l010","ordinal":130620,"en":"While your father Manas lived,"},{"id":"semetey-1-2013:p0708:b004:l011","ordinal":130621,"en":"They cried, ‘Baabedin!’"},{"id":"semetey-1-2013:p0708:b004:l012","ordinal":130622,"en":"They raised the war cry, ‘Manas!’"},{"id":"semetey-1-2013:p0708:b004:l013","ordinal":130623,"en":"Now those forty warriors"},{"id":"semetey-1-2013:p0708:b004:l014","ordinal":130624,"en":"Bend down the willow tops;"},{"id":"semetey-1-2013:p0708:b004:l015","ordinal":130625,"en":"They raise the war cry, ‘Kobosh!’"},{"id":"semetey-1-2013:p0708:b004:l016","ordinal":130626,"en":"If they get the chance, they will clash with us."},{"id":"semetey-1-2013:p0708:b004:l017","ordinal":130627,"en":"The forty warriors cursed by Khidr—"},{"id":"semetey-1-2013:p0708:b004:l018","ordinal":130628,"en":"When will they ever honor us?"},{"id":"semetey-1-2013:p0708:b004:l019","ordinal":130629,"en":"Pouring out his account,"},{"id":"semetey-1-2013:p0708:b004:l020","ordinal":130630,"en":"Your khan uncle Bakai had these words."},{"id":"semetey-1-2013:p0708:b004:l021","ordinal":130631,"en":"Keep watch over this:"},{"id":"semetey-1-2013:p0708:b004:l022","ordinal":130632,"en":"Those forty swine bear a grudge against you;"},{"id":"semetey-1-2013:p0708:b004:l023","ordinal":130633,"en":"Their intentions are wicked."},{"id":"semetey-1-2013:p0708:b004:l024","ordinal":130634,"en":"My beloved orphan,"},{"id":"semetey-1-2013:p0708:b004:l025","ordinal":130635,"en":"Let us scout thoroughly;"},{"id":"semetey-1-2013:p0708:b004:l026","ordinal":130636,"en":"Let us gather sound news.”"},{"id":"semetey-1-2013:p0708:b004:l027","ordinal":130637,"en":"So said Khan Bakai,"},{"id":"semetey-1-2013:p0708:b004:l028","ordinal":130638,"en":"Your resourceful uncle Khan Bakai."},{"id":"semetey-1-2013:p0708:b004:l029","ordinal":130639,"en":"To the spur where the mountain ends,"},{"id":"semetey-1-2013:p0708:b004:l030","ordinal":130640,"en":"To the looming promontory,"},{"id":"semetey-1-2013:p0708:b004:l031","ordinal":130641,"en":"Wearing out his horse, surveying the land,"},{"id":"semetey-1-2013:p0708:b004:l032","ordinal":130642,"en":"Watching shapes, scouting the road,"},{"id":"semetey-1-2013:p0708:b004:l033","ordinal":130643,"en":"The Kokcholok beneath him"},{"id":"semetey-1-2013:p0708:b004:l034","ordinal":130644,"en":"He spurred on either side."},{"id":"semetey-1-2013:p0708:b004:l035","ordinal":130645,"en":"Searching tracks this way and that,"},{"id":"semetey-1-2013:p0708:b004:l036","ordinal":130646,"en":"Valiant Bakai the Leopard"},{"id":"semetey-1-2013:p0708:b004:l037","ordinal":130647,"en":"Reached the ridge at last."},{"id":"semetey-1-2013:p0709:b004:l001","ordinal":130648,"en":"Before much time had passed,"},{"id":"semetey-1-2013:p0709:b004:l002","ordinal":130649,"en":"Before this or that could be said,"},{"id":"semetey-1-2013:p0709:b004:l003","ordinal":130650,"en":"In the blink of an eye,"},{"id":"semetey-1-2013:p0709:b004:l004","ordinal":130651,"en":"Massive as half a mountain,"},{"id":"semetey-1-2013:p0709:b004:l005","ordinal":130652,"en":"As though to devour whoever was met,"},{"id":"semetey-1-2013:p0709:b004:l006","ordinal":130653,"en":"With a high brow and a stern face,"},{"id":"semetey-1-2013:p0709:b004:l007","ordinal":130654,"en":"Broad-chested, with an ample breast,"},{"id":"semetey-1-2013:p0709:b004:l008","ordinal":130655,"en":"A majestic person appeared,"},{"id":"semetey-1-2013:p0709:b004:l009","ordinal":130656,"en":"Riding a dark chestnut horse,"},{"id":"semetey-1-2013:p0709:b004:l010","ordinal":130657,"en":"Its long tail tightly knotted,"},{"id":"semetey-1-2013:p0709:b004:l011","ordinal":130658,"en":"Looking like a night-devouring monster,"},{"id":"semetey-1-2013:p0709:b004:l012","ordinal":130659,"en":"With eyes like twilight mist,"},{"id":"semetey-1-2013:p0709:b004:l013","ordinal":130660,"en":"A banner floating,"},{"id":"semetey-1-2013:p0709:b004:l014","ordinal":130661,"en":"A helmet of blue iron"},{"id":"semetey-1-2013:p0709:b004:l015","ordinal":130662,"en":"Gleaming upon the head,"},{"id":"semetey-1-2013:p0709:b004:l016","ordinal":130663,"en":"A sight that troubled the heart."},{"id":"semetey-1-2013:p0709:b004:l017","ordinal":130664,"en":"A bulletproof steel shield"},{"id":"semetey-1-2013:p0709:b004:l018","ordinal":130665,"en":"Showed upon the broad shoulder blades."},{"id":"semetey-1-2013:p0709:b004:l019","ordinal":130666,"en":"A golden-cheeked battle-axe"},{"id":"semetey-1-2013:p0709:b004:l020","ordinal":130667,"en":"Was firmly looped upon the wrist."},{"id":"semetey-1-2013:p0709:b004:l021","ordinal":130668,"en":"A hungry blade never sated with blood,"},{"id":"semetey-1-2013:p0709:b004:l022","ordinal":130669,"en":"A steel sword, was girded on."},{"id":"semetey-1-2013:p0709:b004:l023","ordinal":130670,"en":"There was a form unlike other men,"},{"id":"semetey-1-2013:p0709:b004:l024","ordinal":130671,"en":"A dread presence like a dragon."},{"id":"semetey-1-2013:p0709:b004:l025","ordinal":130672,"en":"There was a dark chestnut winged steed,"},{"id":"semetey-1-2013:p0709:b004:l026","ordinal":130673,"en":"The four corners of the round world—"},{"id":"semetey-1-2013:p0709:b004:l027","ordinal":130674,"en":"There was strength to suck them away."},{"id":"semetey-1-2013:p0709:b004:l028","ordinal":130675,"en":"This powerfully built person"},{"id":"semetey-1-2013:p0709:b004:l029","ordinal":130676,"en":"Came right up beside them."},{"id":"semetey-1-2013:p0709:b004:l030","ordinal":130677,"en":"The wondrous hero born of Manas,"},{"id":"semetey-1-2013:p0709:b004:l031","ordinal":130678,"en":"To the person who had just arrived,"},{"id":"semetey-1-2013:p0709:b004:l032","ordinal":130679,"en":"Spoke these words:"},{"id":"semetey-1-2013:p0709:b004:l033","ordinal":130680,"en":"“Grim in form, strange of face,"},{"id":"semetey-1-2013:p0709:b004:l034","ordinal":130681,"en":"From where have you come, warrior?!"},{"id":"semetey-1-2013:p0709:b004:l035","ordinal":130682,"en":"Your horse's neck swings proudly;"},{"id":"semetey-1-2013:p0709:b004:l036","ordinal":130683,"en":"You ride a beast unlike the rest."},{"id":"semetey-1-2013:p0709:b005:l001","ordinal":130684,"en":"Your spear's butt is an armful;"},{"id":"semetey-1-2013:p0709:b005:l002","ordinal":130685,"en":"You carry wood unlike the rest."},{"id":"semetey-1-2013:p0709:b005:l003","ordinal":130686,"en":"Wearing out horses, scouting the land,"},{"id":"semetey-1-2013:p0709:b005:l004","ordinal":130687,"en":"Unleashing hounds and flying hawks,"},{"id":"semetey-1-2013:p0709:b005:l005","ordinal":130688,"en":"Circling Orolmo-Too,"},{"id":"semetey-1-2013:p0709:b005:l006","ordinal":130689,"en":"Girded with weapons of war,"},{"id":"semetey-1-2013:p0709:b005:l007","ordinal":130690,"en":"You are one of the raiders."},{"id":"semetey-1-2013:p0709:b005:l008","ordinal":130691,"en":"Your deeds show plainly;"},{"id":"semetey-1-2013:p0709:b005:l009","ordinal":130692,"en":"May your road prosper—tell the truth,"},{"id":"semetey-1-2013:p0709:b005:l010","ordinal":130693,"en":"Or your blood will be shed now."},{"id":"semetey-1-2013:p0709:b005:l011","ordinal":130694,"en":"If you wish to trade shots,"},{"id":"semetey-1-2013:p0709:b005:l012","ordinal":130695,"en":"Make your musket ready;"},{"id":"semetey-1-2013:p0709:b005:l013","ordinal":130696,"en":"If you wish to fight,"},{"id":"semetey-1-2013:p0709:b005:l014","ordinal":130697,"en":"Make your axe and sword ready;"},{"id":"semetey-1-2013:p0709:b005:l015","ordinal":130698,"en":"If you wish to joust,"},{"id":"semetey-1-2013:p0709:b005:l016","ordinal":130699,"en":"Make your spear ready here."},{"id":"semetey-1-2013:p0709:b005:l017","ordinal":130700,"en":"Today certain death will enter your thoughts;"},{"id":"semetey-1-2013:p0709:b005:l018","ordinal":130701,"en":"Guard yourself very carefully."},{"id":"semetey-1-2013:p0709:b005:l019","ordinal":130702,"en":"If you are a raider,"},{"id":"semetey-1-2013:p0709:b005:l020","ordinal":130703,"en":"And I am the boy you have met,"},{"id":"semetey-1-2013:p0709:b005:l021","ordinal":130704,"en":"I shall gouge out your eyes;"},{"id":"semetey-1-2013:p0709:b005:l022","ordinal":130705,"en":"I am enraged—I shall slaughter you."},{"id":"semetey-1-2013:p0709:b005:l023","ordinal":130706,"en":"Fire has kindled and your eyes blaze;"},{"id":"semetey-1-2013:p0709:b005:l024","ordinal":130707,"en":"I will not spare your life otherwise."},{"id":"semetey-1-2013:p0709:b005:l025","ordinal":130708,"en":"My thirst for blood has seized me today."},{"id":"semetey-1-2013:p0709:b005:l026","ordinal":130709,"en":"If you ask about me,"},{"id":"semetey-1-2013:p0709:b005:l027","ordinal":130710,"en":"Having roamed all the world,"},{"id":"semetey-1-2013:p0709:b005:l028","ordinal":130711,"en":"Finding no hero like you to joust with,"},{"id":"semetey-1-2013:p0709:b005:l029","ordinal":130712,"en":"Finding no ground on which to measure strength,"},{"id":"semetey-1-2013:p0709:b005:l030","ordinal":130713,"en":"To fight and satisfy my longing,"},{"id":"semetey-1-2013:p0709:b005:l031","ordinal":130714,"en":"Finding no soul like you,"},{"id":"semetey-1-2013:p0709:b005:l032","ordinal":130715,"en":"Finding no mountain to dash against,"},{"id":"semetey-1-2013:p0709:b005:l033","ordinal":130716,"en":"Finding no enemy to battle,"},{"id":"semetey-1-2013:p0709:b005:l034","ordinal":130717,"en":"I have stood here in distress.”"},{"id":"semetey-1-2013:p0709:b005:l035","ordinal":130718,"en":"Saying this, Semetey,"},{"id":"semetey-1-2013:p0709:b005:l036","ordinal":130719,"en":"Unceasing in his fury,"},{"id":"semetey-1-2013:p0710:b003:l001","ordinal":130720,"en":"His black-cheeked white whip"},{"id":"semetey-1-2013:p0710:b003:l002","ordinal":130721,"en":"Seized and swung round,"},{"id":"semetey-1-2013:p0710:b003:l003","ordinal":130722,"en":"And the renowned swift Aktulpar"},{"id":"semetey-1-2013:p0710:b003:l004","ordinal":130723,"en":"He struck across the belly."},{"id":"semetey-1-2013:p0710:b003:l005","ordinal":130724,"en":"His painted spear with a steel edge"},{"id":"semetey-1-2013:p0710:b003:l006","ordinal":130725,"en":"He seized and swung relentlessly."},{"id":"semetey-1-2013:p0710:b003:l007","ordinal":130726,"en":"He turned Aktulpar's head,"},{"id":"semetey-1-2013:p0710:b003:l008","ordinal":130727,"en":"And toward the bulky giant"},{"id":"semetey-1-2013:p0710:b003:l009","ordinal":130728,"en":"Thundering, he leveled his spear."},{"id":"semetey-1-2013:p0710:b003:l010","ordinal":130729,"en":"Semetey charged."},{"id":"semetey-1-2013:p0710:b003:l011","ordinal":130730,"en":"When Semetey came near,"},{"id":"semetey-1-2013:p0710:b003:l012","ordinal":130731,"en":"Humming, utterly unconcerned,"},{"id":"semetey-1-2013:p0710:b003:l013","ordinal":130732,"en":"The boy's leveled spear"},{"id":"semetey-1-2013:p0710:b003:l014","ordinal":130733,"en":"The rider valued less than a trouser cuff."},{"id":"semetey-1-2013:p0710:b003:l015","ordinal":130734,"en":"The dark chestnut winged steed's"},{"id":"semetey-1-2013:p0710:b003:l016","ordinal":130735,"en":"Head the rider pulled round,"},{"id":"semetey-1-2013:p0710:b003:l017","ordinal":130736,"en":"And held firm without tiring."},{"id":"semetey-1-2013:p0710:b003:l018","ordinal":130737,"en":"“This boy has spirit;"},{"id":"semetey-1-2013:p0710:b003:l019","ordinal":130738,"en":"Let him strike firmly with his spear,"},{"id":"semetey-1-2013:p0710:b003:l020","ordinal":130739,"en":"Let him have no regrets,” thinking thus,"},{"id":"semetey-1-2013:p0710:b003:l021","ordinal":130740,"en":"The rider turned Kartkurong's head."},{"id":"semetey-1-2013:p0710:b003:l022","ordinal":130741,"en":"Semetey arrived at speed,"},{"id":"semetey-1-2013:p0710:b003:l023","ordinal":130742,"en":"Gripped his spear and struck hard."},{"id":"semetey-1-2013:p0710:b003:l024","ordinal":130743,"en":"At the spear the boy thrust,"},{"id":"semetey-1-2013:p0710:b003:l025","ordinal":130744,"en":"The rider stared, unruffled."},{"id":"semetey-1-2013:p0710:b003:l026","ordinal":130745,"en":"“This side of the belt,” he aimed,"},{"id":"semetey-1-2013:p0710:b003:l027","ordinal":130746,"en":"“Below the edge of the lungs,” he aimed."},{"id":"semetey-1-2013:p0710:b003:l028","ordinal":130747,"en":"When the boy charged and struck,"},{"id":"semetey-1-2013:p0710:b003:l029","ordinal":130748,"en":"The steel spear in his hand"},{"id":"semetey-1-2013:p0710:b003:l030","ordinal":130749,"en":"Burst and shattered."},{"id":"semetey-1-2013:p0710:b003:l031","ordinal":130750,"en":"He doubled at knees and waist;"},{"id":"semetey-1-2013:p0710:b003:l032","ordinal":130751,"en":"His precious life was sorely strained."},{"id":"semetey-1-2013:p0710:b003:l033","ordinal":130752,"en":"When your Seme sprang and thrust,"},{"id":"semetey-1-2013:p0710:b003:l034","ordinal":130753,"en":"The rider did not recoil at all."},{"id":"semetey-1-2013:p0710:b003:l035","ordinal":130754,"en":"Before Semetey could pull back,"},{"id":"semetey-1-2013:p0710:b003:l036","ordinal":130755,"en":"The golden-cheeked battle-axe"},{"id":"semetey-1-2013:p0710:b003:l037","ordinal":130756,"en":"The rider seized and struck four times."},{"id":"semetey-1-2013:p0710:b003:l038","ordinal":130757,"en":"After that,"},{"id":"semetey-1-2013:p0710:b003:l039","ordinal":130758,"en":"Drawing hungry steel from the side,"},{"id":"semetey-1-2013:p0710:b004:l001","ordinal":130759,"en":"The rider struck three times with it."},{"id":"semetey-1-2013:p0710:b004:l002","ordinal":130760,"en":"A ready spear was in the rider's hand;"},{"id":"semetey-1-2013:p0710:b004:l003","ordinal":130761,"en":"The rider's skill was greater."},{"id":"semetey-1-2013:p0710:b004:l004","ordinal":130762,"en":"The rider reached your orphan,"},{"id":"semetey-1-2013:p0710:b004:l005","ordinal":130763,"en":"Reached him and struck him passing."},{"id":"semetey-1-2013:p0710:b004:l006","ordinal":130764,"en":"The orphan who fancied himself a champion"},{"id":"semetey-1-2013:p0710:b004:l007","ordinal":130765,"en":"Bent double at the waist;"},{"id":"semetey-1-2013:p0710:b004:l008","ordinal":130766,"en":"His eyes bulged."},{"id":"semetey-1-2013:p0710:b004:l009","ordinal":130767,"en":"His backside left the saddle;"},{"id":"semetey-1-2013:p0710:b004:l010","ordinal":130768,"en":"His feet left the stirrups."},{"id":"semetey-1-2013:p0710:b004:l011","ordinal":130769,"en":"The tightly knotted white reins,"},{"id":"semetey-1-2013:p0710:b004:l012","ordinal":130770,"en":"Reins just right for Aktulpar,"},{"id":"semetey-1-2013:p0710:b004:l013","ordinal":130771,"en":"The reckless, unruly orphan child"},{"id":"semetey-1-2013:p0710:b004:l014","ordinal":130772,"en":"Managed to grasp properly."},{"id":"semetey-1-2013:p0710:b004:l015","ordinal":130773,"en":"The Aktulpar beneath him"},{"id":"semetey-1-2013:p0710:b004:l016","ordinal":130774,"en":"He whipped on right and left,"},{"id":"semetey-1-2013:p0710:b004:l017","ordinal":130775,"en":"And put the whip beneath his right thigh."},{"id":"semetey-1-2013:p0710:b004:l018","ordinal":130776,"en":"Your dear child, son of the mighty one,"},{"id":"semetey-1-2013:p0710:b004:l019","ordinal":130777,"en":"Fell into tremendous panic."},{"id":"semetey-1-2013:p0710:b004:l020","ordinal":130778,"en":"“I attacked an enemy not to be attacked;"},{"id":"semetey-1-2013:p0710:b004:l021","ordinal":130779,"en":"I have fallen into misfortune."},{"id":"semetey-1-2013:p0710:b004:l022","ordinal":130780,"en":"I challenged an enemy not to be touched;"},{"id":"semetey-1-2013:p0710:b004:l023","ordinal":130781,"en":"My insolent tongue has undone me."},{"id":"semetey-1-2013:p0710:b004:l024","ordinal":130782,"en":"To see the humiliation of this world,"},{"id":"semetey-1-2013:p0710:b004:l025","ordinal":130783,"en":"It seems I challenged this foe."},{"id":"semetey-1-2013:p0710:b004:l026","ordinal":130784,"en":"Before my appointed death, before my days were done,"},{"id":"semetey-1-2013:p0710:b004:l027","ordinal":130785,"en":"It seems I challenged this foe to die."},{"id":"semetey-1-2013:p0710:b004:l028","ordinal":130786,"en":"This was a khan of sacred power!”"},{"id":"semetey-1-2013:p0710:b004:l029","ordinal":130787,"en":"Saying this then,"},{"id":"semetey-1-2013:p0710:b004:l030","ordinal":130788,"en":"The noble boy Semetey"},{"id":"semetey-1-2013:p0710:b004:l031","ordinal":130789,"en":"Darted off in haste;"},{"id":"semetey-1-2013:p0710:b004:l032","ordinal":130790,"en":"Toward his uncle Bakai"},{"id":"semetey-1-2013:p0710:b004:l033","ordinal":130791,"en":"The orphan fled, urging his horse."},{"id":"semetey-1-2013:p0710:b004:l034","ordinal":130792,"en":"Kardygach came pursuing."},{"id":"semetey-1-2013:p0710:b004:l035","ordinal":130793,"en":"As he fled downhill,"},{"id":"semetey-1-2013:p0710:b004:l036","ordinal":130794,"en":"Semetey's Aktulpar"},{"id":"semetey-1-2013:p0710:b004:l037","ordinal":130795,"en":"Planted its forelegs like a roe deer."},{"id":"semetey-1-2013:p0710:b004:l038","ordinal":130796,"en":"As they began to climb,"},{"id":"semetey-1-2013:p0710:b004:l039","ordinal":130797,"en":"Kardygach's winged steed"},{"id":"semetey-1-2013:p0711:b003:l001","ordinal":130798,"en":"Spread its mane and tail."},{"id":"semetey-1-2013:p0711:b003:l002","ordinal":130799,"en":"With a sparse mane and scant tail,"},{"id":"semetey-1-2013:p0711:b003:l003","ordinal":130800,"en":"Telkurong was a devouring marvel."},{"id":"semetey-1-2013:p0711:b003:l004","ordinal":130801,"en":"It had been Khan Zhakyp's horse,"},{"id":"semetey-1-2013:p0711:b003:l005","ordinal":130802,"en":"Born on sand, raised on stone,"},{"id":"semetey-1-2013:p0711:b003:l006","ordinal":130803,"en":"Raised apart, unlike other horses."},{"id":"semetey-1-2013:p0711:b003:l007","ordinal":130804,"en":"A Karabair, with a trap-strong back,"},{"id":"semetey-1-2013:p0711:b003:l008","ordinal":130805,"en":"Its running was the wind itself."},{"id":"semetey-1-2013:p0711:b003:l009","ordinal":130806,"en":"Truly a spirit steed, Telkurong,"},{"id":"semetey-1-2013:p0711:b003:l010","ordinal":130807,"en":"Ridden into combat, it never faltered;"},{"id":"semetey-1-2013:p0711:b003:l011","ordinal":130808,"en":"Ridden with the baggage train, it never ailed;"},{"id":"semetey-1-2013:p0711:b003:l012","ordinal":130809,"en":"Ridden on reconnaissance, it never tired."},{"id":"semetey-1-2013:p0711:b003:l013","ordinal":130810,"en":"No wind could match its trot;"},{"id":"semetey-1-2013:p0711:b003:l014","ordinal":130811,"en":"No beast could match its walk."},{"id":"semetey-1-2013:p0711:b003:l015","ordinal":130812,"en":"Karacha's daughter Saikal,"},{"id":"semetey-1-2013:p0711:b003:l016","ordinal":130813,"en":"Khan Zhakyp's Kardygach—"},{"id":"semetey-1-2013:p0711:b003:l017","ordinal":130814,"en":"When the countless Chinese of Kakan"},{"id":"semetey-1-2013:p0711:b003:l018","ordinal":130815,"en":"Came sweeping over all,"},{"id":"semetey-1-2013:p0711:b003:l019","ordinal":130816,"en":"The Kalmyk giants,"}]
