[{"id":"semetey-1-2013:p0443:b003:l009","ordinal":110849,"en":"The khan of the khakan's realm awoke."},{"id":"semetey-1-2013:p0443:b003:l010","ordinal":110850,"en":"His lion-like courage was known to the people."},{"id":"semetey-1-2013:p0443:b003:l011","ordinal":110851,"en":"'Manas will destroy Beijing,' they said."},{"id":"semetey-1-2013:p0443:b003:l012","ordinal":110852,"en":"Your father's nobility,"},{"id":"semetey-1-2013:p0443:b003:l013","ordinal":110853,"en":"His surpassing courage,"},{"id":"semetey-1-2013:p0443:b003:l014","ordinal":110854,"en":"In Beijing's Chyngchuu Khan's"},{"id":"semetey-1-2013:p0443:b003:l015","ordinal":110855,"en":"Register they were inscribed."},{"id":"semetey-1-2013:p0443:b003:l016","ordinal":110856,"en":"When they heard that news,"},{"id":"semetey-1-2013:p0443:b003:l017","ordinal":110857,"en":"Great Beijing fell into turmoil;"},{"id":"semetey-1-2013:p0443:b003:l018","ordinal":110858,"en":"The khan of the khakan's realm grieved."},{"id":"semetey-1-2013:p0443:b003:l019","ordinal":110859,"en":"Your fortunate father rose as khan."},{"id":"semetey-1-2013:p0443:b003:l020","ordinal":110860,"en":"From your departed father's"},{"id":"semetey-1-2013:p0443:b003:l021","ordinal":110861,"en":"Very voice, souls fled their bodies."},{"id":"semetey-1-2013:p0443:b003:l022","ordinal":110862,"en":"Your father Manas, the lion,"},{"id":"semetey-1-2013:p0443:b003:l023","ordinal":110863,"en":"Conquered many, many peoples,"},{"id":"semetey-1-2013:p0443:b003:l024","ordinal":110864,"en":"Conquered many, many lands."},{"id":"semetey-1-2013:p0443:b003:l025","ordinal":110865,"en":"Drew their swords and made them bloody;"},{"id":"semetey-1-2013:p0443:b003:l026","ordinal":110866,"en":"He raised strife in many lands."},{"id":"semetey-1-2013:p0443:b003:l027","ordinal":110867,"en":"Fierce and hardened in wrath,"},{"id":"semetey-1-2013:p0443:b003:l028","ordinal":110868,"en":"Among the Chinese in the khakan's realm"},{"id":"semetey-1-2013:p0443:b003:l029","ordinal":110869,"en":"He was named Manas the Blood-Drinker."},{"id":"semetey-1-2013:p0443:b003:l030","ordinal":110870,"en":"He was a lion of surpassing fortune."},{"id":"semetey-1-2013:p0443:b003:l031","ordinal":110871,"en":"Upon the face of the earth, your father"},{"id":"semetey-1-2013:p0443:b003:l032","ordinal":110872,"en":"Was a hero who came and went but once."},{"id":"semetey-1-2013:p0443:b003:l033","ordinal":110873,"en":"A mortal like your father,"},{"id":"semetey-1-2013:p0443:b003:l034","ordinal":110874,"en":"Allah Most High, the one God,"},{"id":"semetey-1-2013:p0443:b003:l035","ordinal":110875,"en":"Will never create again."},{"id":"semetey-1-2013:p0443:b003:l036","ordinal":110876,"en":"I began telling a tale;"},{"id":"semetey-1-2013:p0443:b003:l037","ordinal":110877,"en":"Of your father's deeds"},{"id":"semetey-1-2013:p0443:b003:l038","ordinal":110878,"en":"I have told a little."},{"id":"semetey-1-2013:p0443:b003:l039","ordinal":110879,"en":"My lament is a white palace;"},{"id":"semetey-1-2013:p0443:b005:l001","ordinal":110880,"en":"If I told my sorrow, it would be long."},{"id":"semetey-1-2013:p0443:b005:l002","ordinal":110881,"en":"As I sit and tell at length,"},{"id":"semetey-1-2013:p0443:b005:l003","ordinal":110882,"en":"The mightiest of saints,"},{"id":"semetey-1-2013:p0443:b005:l004","ordinal":110883,"en":"Ponder and listen, orphan,"},{"id":"semetey-1-2013:p0443:b005:l005","ordinal":110884,"en":"To the tale of me, your luckless mother!"},{"id":"semetey-1-2013:p0443:b005:l006","ordinal":110885,"en":"Allah Most High, the Almighty,"},{"id":"semetey-1-2013:p0443:b005:l007","ordinal":110886,"en":"Will He leave His mortal creatures untaken?"},{"id":"semetey-1-2013:p0443:b005:l008","ordinal":110887,"en":"What I keep asking of God"},{"id":"semetey-1-2013:p0443:b005:l009","ordinal":110888,"en":"Is my one child Semetey."},{"id":"semetey-1-2013:p0443:b005:l010","ordinal":110889,"en":"My plump, gray-speckled white hawk,"},{"id":"semetey-1-2013:p0443:b005:l011","ordinal":110890,"en":"God, let us see him without his growing pale,"},{"id":"semetey-1-2013:p0443:b005:l012","ordinal":110891,"en":"That one morning star, Semetey."},{"id":"semetey-1-2013:p0443:b005:l013","ordinal":110892,"en":"My spring, my river in its valley,"},{"id":"semetey-1-2013:p0443:b005:l014","ordinal":110893,"en":"My little orphan, gained after such hardship,"},{"id":"semetey-1-2013:p0443:b005:l015","ordinal":110894,"en":"My banner fastened to a spear,"},{"id":"semetey-1-2013:p0443:b005:l016","ordinal":110895,"en":"My gift left by the Magnanimous One,"},{"id":"semetey-1-2013:p0443:b005:l017","ordinal":110896,"en":"For whom I rose and braided my hair,"},{"id":"semetey-1-2013:p0443:b005:l018","ordinal":110897,"en":"My child gained when I was near death."},{"id":"semetey-1-2013:p0443:b005:l019","ordinal":110898,"en":"My lament is a white palace;"},{"id":"semetey-1-2013:p0443:b005:l020","ordinal":110899,"en":"Turn, orphan, and listen!"},{"id":"semetey-1-2013:p0443:b005:l021","ordinal":110900,"en":"I shall tell much of my sorrow."},{"id":"semetey-1-2013:p0443:b005:l022","ordinal":110901,"en":"There are further words I have to tell;"},{"id":"semetey-1-2013:p0443:b005:l023","ordinal":110902,"en":"Again, orphan, listen!"},{"id":"semetey-1-2013:p0443:b005:l024","ordinal":110903,"en":"Let me leave this here"},{"id":"semetey-1-2013:p0443:b005:l025","ordinal":110904,"en":"And begin with what lies nearer:"},{"id":"semetey-1-2013:p0443:b005:l026","ordinal":110905,"en":"Those left after the deaths"},{"id":"semetey-1-2013:p0443:b005:l027","ordinal":110906,"en":"Fled to Beijing."},{"id":"semetey-1-2013:p0443:b005:l028","ordinal":110907,"en":"Their leopard hero Kongurbai"},{"id":"semetey-1-2013:p0443:b005:l029","ordinal":110908,"en":"To Karykan of Beijing"},{"id":"semetey-1-2013:p0443:b005:l030","ordinal":110909,"en":"Went and brought the news."},{"id":"semetey-1-2013:p0443:b005:l031","ordinal":110910,"en":"Hearing its import, Karykan"},{"id":"semetey-1-2013:p0443:b005:l032","ordinal":110911,"en":"Raised a great uproar."},{"id":"semetey-1-2013:p0443:b005:l033","ordinal":110912,"en":"The great people of True Beijing,"},{"id":"semetey-1-2013:p0443:b005:l034","ordinal":110913,"en":"Unable to withstand his terrible wrath,"},{"id":"semetey-1-2013:p0443:b005:l035","ordinal":110914,"en":"Were nearly wiped out."},{"id":"semetey-1-2013:p0443:b005:l036","ordinal":110915,"en":"Surrounded by a grove of plane trees,"},{"id":"semetey-1-2013:p0443:b005:l037","ordinal":110916,"en":"The golden throne in Beijing."},{"id":"semetey-1-2013:p0443:b005:l038","ordinal":110917,"en":"The tower the khan ascended,"},{"id":"semetey-1-2013:p0443:b005:l039","ordinal":110918,"en":"To the top of that tower,"},{"id":"semetey-1-2013:p0444:b003:l001","ordinal":110919,"en":"He beat his drum."},{"id":"semetey-1-2013:p0444:b003:l002","ordinal":110920,"en":"Striking the booming drum,"},{"id":"semetey-1-2013:p0444:b003:l003","ordinal":110921,"en":"He gathered his people."},{"id":"semetey-1-2013:p0444:b003:l004","ordinal":110922,"en":"Their khan raised an uproar."},{"id":"semetey-1-2013:p0444:b003:l005","ordinal":110923,"en":"The great people of Khakanchyn,"},{"id":"semetey-1-2013:p0444:b003:l006","ordinal":110924,"en":"Unable to withstand his wrath,"},{"id":"semetey-1-2013:p0444:b003:l007","ordinal":110925,"en":"Nearly fell into disorder."},{"id":"semetey-1-2013:p0444:b003:l008","ordinal":110926,"en":"There were champions, there were elders;"},{"id":"semetey-1-2013:p0444:b003:l009","ordinal":110927,"en":"Of Beijing's forty Chinese tribes,"},{"id":"semetey-1-2013:p0444:b003:l010","ordinal":110928,"en":"All were present then."},{"id":"semetey-1-2013:p0444:b003:l011","ordinal":110929,"en":"'I have faced a terrible ordeal;"},{"id":"semetey-1-2013:p0444:b003:l012","ordinal":110930,"en":"My people, listen!"},{"id":"semetey-1-2013:p0444:b003:l013","ordinal":110931,"en":"I am the renowned Karykan;"},{"id":"semetey-1-2013:p0444:b003:l014","ordinal":110932,"en":"Now, my people, heed me!"},{"id":"semetey-1-2013:p0444:b003:l015","ordinal":110933,"en":"Let your ablest spear-bearers come;"},{"id":"semetey-1-2013:p0444:b003:l016","ordinal":110934,"en":"Now to my side"},{"id":"semetey-1-2013:p0444:b003:l017","ordinal":110935,"en":"Let your finest, wisest speakers come."},{"id":"semetey-1-2013:p0444:b003:l018","ordinal":110936,"en":"Let your champion lions come."},{"id":"semetey-1-2013:p0444:b003:l019","ordinal":110937,"en":"Karykan has a word to say;"},{"id":"semetey-1-2013:p0444:b003:l020","ordinal":110938,"en":"Consider it carefully!"},{"id":"semetey-1-2013:p0444:b003:l021","ordinal":110939,"en":"Kongurbai, son of Alööke,"},{"id":"semetey-1-2013:p0444:b003:l022","ordinal":110940,"en":"Had the Talas country scouted."},{"id":"semetey-1-2013:p0444:b003:l023","ordinal":110941,"en":"When Chubak sent a deceitful letter,"},{"id":"semetey-1-2013:p0444:b003:l024","ordinal":110942,"en":"He drove my people there"},{"id":"semetey-1-2013:p0444:b003:l025","ordinal":110943,"en":"And had them slaughtered by the Kyrgyz."},{"id":"semetey-1-2013:p0444:b003:l026","ordinal":110944,"en":"Manas is no easy khan to face,"},{"id":"semetey-1-2013:p0444:b003:l027","ordinal":110945,"en":"No man to approach without thought."},{"id":"semetey-1-2013:p0444:b003:l028","ordinal":110946,"en":"He is the support they rely upon,"},{"id":"semetey-1-2013:p0444:b003:l029","ordinal":110947,"en":"The hero who came from Mecca."},{"id":"semetey-1-2013:p0444:b003:l030","ordinal":110948,"en":"Unless we trick and slaughter Manas,"},{"id":"semetey-1-2013:p0444:b003:l031","ordinal":110949,"en":"Unless we put him to death,"},{"id":"semetey-1-2013:p0444:b003:l032","ordinal":110950,"en":"He will not let us turn our plows."},{"id":"semetey-1-2013:p0444:b003:l033","ordinal":110951,"en":"He is a giant sprung from the Muslims;"},{"id":"semetey-1-2013:p0444:b003:l034","ordinal":110952,"en":"He will not let us remain in Beijing."},{"id":"semetey-1-2013:p0444:b003:l035","ordinal":110953,"en":"He will teach you a bitter lesson, wretches."},{"id":"semetey-1-2013:p0444:b003:l036","ordinal":110954,"en":"Doing many things, that Manas"},{"id":"semetey-1-2013:p0444:b003:l037","ordinal":110955,"en":"Will have your beautiful daughters carried off."},{"id":"semetey-1-2013:p0444:b003:l038","ordinal":110956,"en":"Raiding and driving off your horses,"},{"id":"semetey-1-2013:p0444:b003:l039","ordinal":110957,"en":"If that Manas remains alive,"},{"id":"semetey-1-2013:p0444:b004:l001","ordinal":110958,"en":"He will rouse you wide awake."},{"id":"semetey-1-2013:p0444:b004:l002","ordinal":110959,"en":"He will bring suffering upon Beijing,"},{"id":"semetey-1-2013:p0444:b004:l003","ordinal":110960,"en":"Break many of your backs,"},{"id":"semetey-1-2013:p0444:b004:l004","ordinal":110961,"en":"Kill many of your heroes."},{"id":"semetey-1-2013:p0444:b004:l005","ordinal":110962,"en":"Braid your coursers' manes;"},{"id":"semetey-1-2013:p0444:b004:l006","ordinal":110963,"en":"Within five or six years,"},{"id":"semetey-1-2013:p0444:b004:l007","ordinal":110964,"en":"If you live, my people, Manas"},{"id":"semetey-1-2013:p0444:b004:l008","ordinal":110965,"en":"You will see here in Beijing!"},{"id":"semetey-1-2013:p0444:b004:l009","ordinal":110966,"en":"I became khan of Beijing."},{"id":"semetey-1-2013:p0444:b004:l010","ordinal":110967,"en":"Gold and precious stones"},{"id":"semetey-1-2013:p0444:b004:l011","ordinal":110968,"en":"I have mines to dig together;"},{"id":"semetey-1-2013:p0444:b004:l012","ordinal":110969,"en":"I have forty Chinese tribes."},{"id":"semetey-1-2013:p0444:b004:l013","ordinal":110970,"en":"Jakyp's only son Manas,"},{"id":"semetey-1-2013:p0444:b004:l014","ordinal":110971,"en":"I fear he will destroy Beijing."},{"id":"semetey-1-2013:p0444:b004:l015","ordinal":110972,"en":"My back has bent like cotton;"},{"id":"semetey-1-2013:p0444:b004:l016","ordinal":110973,"en":"The wondrous seer grieved."},{"id":"semetey-1-2013:p0444:b004:l017","ordinal":110974,"en":"“Manas will take Beijing,”"},{"id":"semetey-1-2013:p0444:b004:l018","ordinal":110975,"en":"It was inscribed in my book."},{"id":"semetey-1-2013:p0444:b004:l019","ordinal":110976,"en":"An earthquake shook Beijing."},{"id":"semetey-1-2013:p0444:b004:l020","ordinal":110977,"en":"Unless we somehow slaughter Manas,"},{"id":"semetey-1-2013:p0444:b004:l021","ordinal":110978,"en":"Unless we put him to death,"},{"id":"semetey-1-2013:p0444:b004:l022","ordinal":110979,"en":"Stony hail will rain upon my land."},{"id":"semetey-1-2013:p0444:b004:l023","ordinal":110980,"en":"Fighting six months without tiring,"},{"id":"semetey-1-2013:p0444:b004:l024","ordinal":110981,"en":"He will wreak havoc upon my people."},{"id":"semetey-1-2013:p0444:b004:l025","ordinal":110982,"en":"The great champion Orokkyr has died;"},{"id":"semetey-1-2013:p0444:b004:l026","ordinal":110983,"en":"Khan Makil, the lookout, has died."},{"id":"semetey-1-2013:p0444:b004:l027","ordinal":110984,"en":"All the Chinese who met Manas have died."},{"id":"semetey-1-2013:p0444:b004:l029","ordinal":110985,"en":"I make a firm promise;"},{"id":"semetey-1-2013:p0444:b004:l030","ordinal":110986,"en":"Hear this, people:"},{"id":"semetey-1-2013:p0444:b004:l031","ordinal":110987,"en":"I swear an oath on pain of death."},{"id":"semetey-1-2013:p0444:b004:l032","ordinal":110988,"en":"Whoever seizes ill-omened Manas"},{"id":"semetey-1-2013:p0444:b004:l033","ordinal":110989,"en":"And slaughters him and returns,"},{"id":"semetey-1-2013:p0444:b004:l034","ordinal":110990,"en":"I will crown with my golden crown,"},{"id":"semetey-1-2013:p0444:b004:l035","ordinal":110991,"en":"I will seat upon my golden throne."},{"id":"semetey-1-2013:p0444:b004:l036","ordinal":110992,"en":"Over this Great Beijing before us,"},{"id":"semetey-1-2013:p0444:b004:l037","ordinal":110993,"en":"I will give him supreme khanly rule!'"},{"id":"semetey-1-2013:p0444:b004:l038","ordinal":110994,"en":"Karykan proclaimed aloud;"},{"id":"semetey-1-2013:p0444:b004:l039","ordinal":110995,"en":"The unbeliever's heart had narrowed."},{"id":"semetey-1-2013:p0445:b003:l001","ordinal":110996,"en":"The Manchu and Chinese champions"},{"id":"semetey-1-2013:p0445:b003:l002","ordinal":110997,"en":"He had gathered in full."},{"id":"semetey-1-2013:p0445:b003:l003","ordinal":110998,"en":"While he stood just so,"},{"id":"semetey-1-2013:p0445:b003:l004","ordinal":110999,"en":"While he put forward this plan,"},{"id":"semetey-1-2013:p0445:b003:l005","ordinal":111000,"en":"Among the coat-wearing Chinese,"},{"id":"semetey-1-2013:p0445:b003:l006","ordinal":111001,"en":"The strongest fled and would not approach."},{"id":"semetey-1-2013:p0445:b003:l007","ordinal":111002,"en":"Among the jewel-wearing Manchus,"},{"id":"semetey-1-2013:p0445:b003:l008","ordinal":111003,"en":"The finest fled and would not approach."},{"id":"semetey-1-2013:p0445:b003:l009","ordinal":111004,"en":"Their champions scattered one by one."},{"id":"semetey-1-2013:p0445:b003:l010","ordinal":111005,"en":"When their great khan spoke thus,"},{"id":"semetey-1-2013:p0445:b003:l011","ordinal":111006,"en":"Kongurbai, son of Alööke,"},{"id":"semetey-1-2013:p0445:b003:l012","ordinal":111007,"en":"Trembled, unable to find a way."},{"id":"semetey-1-2013:p0445:b003:l013","ordinal":111008,"en":"When the khan gave his command,"},{"id":"semetey-1-2013:p0445:b003:l014","ordinal":111009,"en":"His Kalmyk Great Lama,"},{"id":"semetey-1-2013:p0445:b003:l015","ordinal":111010,"en":"His champions such as Khan Joloi,"},{"id":"semetey-1-2013:p0445:b003:l016","ordinal":111011,"en":"Ezkara, khan of the Manchus—"},{"id":"semetey-1-2013:p0445:b003:l017","ordinal":111012,"en":"Unable to withstand his wrath,"},{"id":"semetey-1-2013:p0445:b003:l018","ordinal":111013,"en":"When the khan stood thus,"},{"id":"semetey-1-2013:p0445:b003:l019","ordinal":111014,"en":"The great people were filled with fear."},{"id":"semetey-1-2013:p0445:b003:l020","ordinal":111015,"en":"Their heroes trembled;"},{"id":"semetey-1-2013:p0445:b003:l021","ordinal":111016,"en":"All the foolish ones"},{"id":"semetey-1-2013:p0445:b003:l022","ordinal":111017,"en":"Lost their wits one by one."},{"id":"semetey-1-2013:p0445:b003:l023","ordinal":111018,"en":"Raising a fearful uproar,"},{"id":"semetey-1-2013:p0445:b003:l024","ordinal":111019,"en":"Karykan stood roaring."},{"id":"semetey-1-2013:p0445:b003:l025","ordinal":111020,"en":"In Beijing with its forty gates,"},{"id":"semetey-1-2013:p0445:b003:l026","ordinal":111021,"en":"At forty gates stood forty judges of prowess."},{"id":"semetey-1-2013:p0445:b003:l027","ordinal":111022,"en":"Rousing the peoples of forty khans,"},{"id":"semetey-1-2013:p0445:b003:l028","ordinal":111023,"en":"'Manas, khan of the Kyrgyz—"},{"id":"semetey-1-2013:p0445:b003:l029","ordinal":111024,"en":"Is there a hero who can spear him?' he asked."},{"id":"semetey-1-2013:p0445:b003:l030","ordinal":111025,"en":"The champions of Beijing"},{"id":"semetey-1-2013:p0445:b003:l031","ordinal":111026,"en":"He sent streaming through the forty gates."},{"id":"semetey-1-2013:p0445:b003:l032","ordinal":111027,"en":"All the people,"},{"id":"semetey-1-2013:p0445:b003:l033","ordinal":111028,"en":"Karykan in his wrath"},{"id":"semetey-1-2013:p0445:b003:l034","ordinal":111029,"en":"Tormented, raising a clamor."},{"id":"semetey-1-2013:p0445:b003:l035","ordinal":111030,"en":"His great people said this:"},{"id":"semetey-1-2013:p0445:b003:l036","ordinal":111031,"en":"'Whoever encounters leopard-like Manas"},{"id":"semetey-1-2013:p0445:b003:l037","ordinal":111032,"en":"Will not remain alive."},{"id":"semetey-1-2013:p0445:b003:l038","ordinal":111033,"en":"That blood-drinking, dauntless hero,"},{"id":"semetey-1-2013:p0445:b003:l039","ordinal":111034,"en":"Whoever meets him will not return."},{"id":"semetey-1-2013:p0445:b004:l001","ordinal":111035,"en":"No soul who goes will turn back;"},{"id":"semetey-1-2013:p0445:b004:l002","ordinal":111036,"en":"Whoever attacks Manas will not return!'"},{"id":"semetey-1-2013:p0445:b004:l004","ordinal":111037,"en":"The khakan's people said this"},{"id":"semetey-1-2013:p0445:b004:l005","ordinal":111038,"en":"And stood in sorrow now."},{"id":"semetey-1-2013:p0445:b004:l006","ordinal":111039,"en":"He was the son of a Muslim;"},{"id":"semetey-1-2013:p0445:b004:l007","ordinal":111040,"en":"To the Black Kalmyk khakan,"},{"id":"semetey-1-2013:p0445:b004:l008","ordinal":111041,"en":"When the Manchus slaughtered the Kyrgyz,"},{"id":"semetey-1-2013:p0445:b004:l009","ordinal":111042,"en":"He had once been taken captive as a slave."},{"id":"semetey-1-2013:p0445:b004:l010","ordinal":111043,"en":"Kökchököz and Közkaman,"},{"id":"semetey-1-2013:p0445:b004:l011","ordinal":111044,"en":"Zheltiibes and Changdyayak,"},{"id":"semetey-1-2013:p0445:b004:l012","ordinal":111045,"en":"With Orozon at their head, these five"},{"id":"semetey-1-2013:p0445:b004:l013","ordinal":111046,"en":"Were originally sons of Muslims,"},{"id":"semetey-1-2013:p0445:b004:l014","ordinal":111047,"en":"Slaves of the Black Chinese."},{"id":"semetey-1-2013:p0445:b004:l015","ordinal":111048,"en":"Közkaman's Kongkulboz"},{"id":"semetey-1-2013:p0445:b004:l016","ordinal":111049,"en":"Was a horse resembling a tulpar."},{"id":"semetey-1-2013:p0445:b004:l017","ordinal":111050,"en":"Recorded in the register,"},{"id":"semetey-1-2013:p0445:b004:l018","ordinal":111051,"en":"These five were named"},{"id":"semetey-1-2013:p0445:b004:l019","ordinal":111052,"en":"To go against blessed, dauntless Manas,"},{"id":"semetey-1-2013:p0445:b004:l020","ordinal":111053,"en":"To go to Manas and slaughter him,"},{"id":"semetey-1-2013:p0445:b004:l021","ordinal":111054,"en":"To sate themselves thoroughly with his blood,"},{"id":"semetey-1-2013:p0445:b004:l022","ordinal":111055,"en":"To cut off his head and bring it"},{"id":"semetey-1-2013:p0445:b004:l023","ordinal":111056,"en":"To Karykan's golden throne,"},{"id":"semetey-1-2013:p0445:b004:l024","ordinal":111057,"en":"To lay it there as a gift."},{"id":"semetey-1-2013:p0445:b004:l025","ordinal":111058,"en":"Before the Lama,"},{"id":"semetey-1-2013:p0445:b004:l026","ordinal":111059,"en":"At the foot of the great idol,"},{"id":"semetey-1-2013:p0445:b004:l027","ordinal":111060,"en":"They swore an oath on pain of death,"},{"id":"semetey-1-2013:p0445:b004:l028","ordinal":111061,"en":"Licked deadly poison,"},{"id":"semetey-1-2013:p0445:b004:l029","ordinal":111062,"en":"Slaughtered four pigs apiece,"},{"id":"semetey-1-2013:p0445:b004:l030","ordinal":111063,"en":"And laid the book against their breasts."},{"id":"semetey-1-2013:p0445:b004:l031","ordinal":111064,"en":"Their henchmen were fully assembled."},{"id":"semetey-1-2013:p0445:b004:l032","ordinal":111065,"en":"From before Karykan"},{"id":"semetey-1-2013:p0445:b004:l033","ordinal":111066,"en":"They received poison deadly at a touch."},{"id":"semetey-1-2013:p0445:b004:l034","ordinal":111067,"en":"Speaking without wavering,"},{"id":"semetey-1-2013:p0445:b004:l035","ordinal":111068,"en":"Promising to slaughter courser-like Manas,"},{"id":"semetey-1-2013:p0445:b004:l036","ordinal":111069,"en":"The idol made of bronze"},{"id":"semetey-1-2013:p0445:b004:l037","ordinal":111070,"en":"They clasped again and again."},{"id":"semetey-1-2013:p0445:b004:l038","ordinal":111071,"en":"Közkaman and Kökchököz,"},{"id":"semetey-1-2013:p0445:b004:l039","ordinal":111072,"en":"Speaking in the Kalmyk tongue,"},{"id":"semetey-1-2013:p0446:b003:l001","ordinal":111073,"en":"They swore a pledge on pain of death,"},{"id":"semetey-1-2013:p0446:b003:l002","ordinal":111074,"en":"Made their promise firm,"},{"id":"semetey-1-2013:p0446:b003:l003","ordinal":111075,"en":"Set down the month in writing,"},{"id":"semetey-1-2013:p0446:b003:l004","ordinal":111076,"en":"And tied the days in knots."},{"id":"semetey-1-2013:p0446:b003:l005","ordinal":111077,"en":"To the Chinese sacred well in the khakan's realm"},{"id":"semetey-1-2013:p0446:b003:l006","ordinal":111078,"en":"They went to worship."},{"id":"semetey-1-2013:p0446:b003:l007","ordinal":111079,"en":"The Black Kalmyks and Manchus"},{"id":"semetey-1-2013:p0446:b003:l008","ordinal":111080,"en":"Put their hands and feet into the water."},{"id":"semetey-1-2013:p0446:b003:l009","ordinal":111081,"en":"They had their equipment prepared;"},{"id":"semetey-1-2013:p0446:b003:l010","ordinal":111082,"en":"Of mules for crossing the desert,"},{"id":"semetey-1-2013:p0446:b003:l011","ordinal":111083,"en":"Some forty were assigned for transport."},{"id":"semetey-1-2013:p0446:b003:l012","ordinal":111084,"en":"The great gold-edged book,"},{"id":"semetey-1-2013:p0446:b003:l013","ordinal":111085,"en":"Its law they read over and over."},{"id":"semetey-1-2013:p0446:b003:l014","ordinal":111086,"en":"To cut off Manas's head,"},{"id":"semetey-1-2013:p0446:b003:l015","ordinal":111087,"en":"Közkaman and Kökchököz,"},{"id":"semetey-1-2013:p0446:b003:l016","ordinal":111088,"en":"All five were sent together."},{"id":"semetey-1-2013:p0446:b003:l017","ordinal":111089,"en":"Leaving Beijing, they traveled,"},{"id":"semetey-1-2013:p0446:b003:l018","ordinal":111090,"en":"Sparing no horse, covering great distances,"},{"id":"semetey-1-2013:p0446:b003:l019","ordinal":111091,"en":"Crossing a desert forty days wide,"},{"id":"semetey-1-2013:p0446:b003:l020","ordinal":111092,"en":"Seeing lakes requiring long detours,"},{"id":"semetey-1-2013:p0446:b003:l021","ordinal":111093,"en":"Passing many rounded mountains,"},{"id":"semetey-1-2013:p0446:b003:l022","ordinal":111094,"en":"Passing forbidding ravines,"},{"id":"semetey-1-2013:p0446:b003:l023","ordinal":111095,"en":"Traveling many roads without weariness,"},{"id":"semetey-1-2013:p0446:b003:l024","ordinal":111096,"en":"Sparing no horse, covering great distances."},{"id":"semetey-1-2013:p0446:b003:l025","ordinal":111097,"en":"The five champions traveled on."},{"id":"semetey-1-2013:p0446:b003:l026","ordinal":111098,"en":"As they traveled,"},{"id":"semetey-1-2013:p0446:b003:l027","ordinal":111099,"en":"'If outsiders go there,"},{"id":"semetey-1-2013:p0446:b003:l028","ordinal":111100,"en":"An informer may emerge from among them"},{"id":"semetey-1-2013:p0446:b003:l029","ordinal":111101,"en":"And bring about our ruin together."},{"id":"semetey-1-2013:p0446:b003:l030","ordinal":111102,"en":"All five champions,"},{"id":"semetey-1-2013:p0446:b003:l031","ordinal":111103,"en":"Manas Khan would slaughter,' they thought."},{"id":"semetey-1-2013:p0446:b003:l032","ordinal":111104,"en":"They bound their agreement together,"}]
