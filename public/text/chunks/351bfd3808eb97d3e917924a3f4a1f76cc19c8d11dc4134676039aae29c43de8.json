[{"id":"manas-2010:p1507:b001:l015","ordinal":65025,"en":"The forty companions led by old Kyrgyl"},{"id":"manas-2010:p1507:b001:l016","ordinal":65026,"en":"Were fighting to the death;"},{"id":"manas-2010:p1507:b001:l017","ordinal":65027,"en":"All the warriors were fierce,"},{"id":"manas-2010:p1507:b001:l018","ordinal":65028,"en":"Not turning back to flee,"},{"id":"manas-2010:p1507:b001:l019","ordinal":65029,"en":"Steadfast in their pledge."},{"id":"manas-2010:p1507:b001:l020","ordinal":65030,"en":"In the clamorous great campaign,"},{"id":"manas-2010:p1507:b001:l021","ordinal":65031,"en":"Against the Chinese they fought,"},{"id":"manas-2010:p1507:b001:l022","ordinal":65032,"en":"In front of the Muslims,"},{"id":"manas-2010:p1507:b001:l023","ordinal":65033,"en":"Almambet, Chubak and hero Syrgak"},{"id":"manas-2010:p1507:b001:l024","ordinal":65034,"en":"Were an iron fortress and rampart."},{"id":"manas-2010:p1507:b001:l025","ordinal":65035,"en":"To defend the Muslims"},{"id":"manas-2010:p1507:b001:l026","ordinal":65036,"en":"Was the oath of these three."},{"id":"manas-2010:p1507:b001:l027","ordinal":65037,"en":"“If we abandon the Muslims and leave,"},{"id":"manas-2010:p1507:b001:l028","ordinal":65038,"en":"Will they not know us for dogs?"},{"id":"manas-2010:p1507:b001:l029","ordinal":65039,"en":"‘To Beijing the Holy One never touched,"},{"id":"manas-2010:p1507:b001:l030","ordinal":65040,"en":"We drove and took them,"},{"id":"manas-2010:p1507:b001:l031","ordinal":65041,"en":"We brought torment and slaughter,’ we would say."},{"id":"manas-2010:p1507:b001:l032","ordinal":65042,"en":"If what is told is true,"},{"id":"manas-2010:p1507:b001:l033","ordinal":65043,"en":"On the day of the afterlife,"},{"id":"manas-2010:p1507:b001:l034","ordinal":65044,"en":"Will the Muslims who died"},{"id":"manas-2010:p1507:b001:l035","ordinal":65045,"en":"Not make black donkeys of us and ride us?"},{"id":"manas-2010:p1507:b001:l036","ordinal":65046,"en":"No such battle can be found;"},{"id":"manas-2010:p1507:b001:l037","ordinal":65047,"en":"No such excitement will come again."},{"id":"manas-2010:p1507:b001:l038","ordinal":65048,"en":"From the swarming unbelievers,"},{"id":"manas-2010:p1507:b001:l039","ordinal":65049,"en":"Can one who retreats prosper?"},{"id":"manas-2010:p1507:b001:l040","ordinal":65050,"en":"Leopard Manas is not here;"},{"id":"manas-2010:p1507:b001:l041","ordinal":65051,"en":"My dear Muslims,"},{"id":"manas-2010:p1507:b001:l042","ordinal":65052,"en":"Can fleeing turn out well?"},{"id":"manas-2010:p1508:b001:l001","ordinal":65053,"en":"Grip your lance firmly,"},{"id":"manas-2010:p1508:b001:l002","ordinal":65054,"en":"Truly use your wits."},{"id":"manas-2010:p1508:b001:l003","ordinal":65055,"en":"Moving from morning until evening,"},{"id":"manas-2010:p1508:b001:l004","ordinal":65056,"en":"Fighting until night,"},{"id":"manas-2010:p1508:b001:l005","ordinal":65057,"en":"If death comes, let us perish,"},{"id":"manas-2010:p1508:b001:l006","ordinal":65058,"en":"Not one of us left alive,"},{"id":"manas-2010:p1508:b001:l007","ordinal":65059,"en":"Fighting against them."},{"id":"manas-2010:p1508:b001:l008","ordinal":65060,"en":"Let us show courage, my people;"},{"id":"manas-2010:p1508:b001:l009","ordinal":65061,"en":"Against the many Chinese and Manchu"},{"id":"manas-2010:p1508:b001:l010","ordinal":65062,"en":"Let us charge and thrust our lances."},{"id":"manas-2010:p1508:b001:l011","ordinal":65063,"en":"The Chinese who stand so stiffly,"},{"id":"manas-2010:p1508:b001:l012","ordinal":65064,"en":"Let us spill their blood and slaughter them."},{"id":"manas-2010:p1508:b001:l013","ordinal":65065,"en":"At the dark mass of Chinese"},{"id":"manas-2010:p1508:b001:l014","ordinal":65066,"en":"Let us level our swords;"},{"id":"manas-2010:p1508:b001:l015","ordinal":65067,"en":"The dreadful one-eyed ones,"},{"id":"manas-2010:p1508:b001:l016","ordinal":65068,"en":"Let us slaughter, leaving none alive!”"},{"id":"manas-2010:p1508:b001:l017","ordinal":65069,"en":"Shouting these words,"},{"id":"manas-2010:p1508:b001:l018","ordinal":65070,"en":"Sarala with his stake-like neck"},{"id":"manas-2010:p1508:b001:l019","ordinal":65071,"en":"Almambet struck with his whip;"},{"id":"manas-2010:p1508:b001:l020","ordinal":65072,"en":"Sarala with his matted tail"},{"id":"manas-2010:p1508:b001:l021","ordinal":65073,"en":"Almambet roused to a quiver."},{"id":"manas-2010:p1508:b001:l022","ordinal":65074,"en":"Across the misty plain,"},{"id":"manas-2010:p1508:b001:l023","ordinal":65075,"en":"Without turning, he attacked"},{"id":"manas-2010:p1508:b001:l024","ordinal":65076,"en":"Kongurbay's army."},{"id":"manas-2010:p1508:b001:l025","ordinal":65077,"en":"Cutting through six thousand,"},{"id":"manas-2010:p1508:b001:l026","ordinal":65078,"en":"“Where is the vile Kalcha?” he cried,"},{"id":"manas-2010:p1508:b001:l027","ordinal":65079,"en":"Spearing all he reached."},{"id":"manas-2010:p1508:b001:l028","ordinal":65080,"en":"“Where is the ogre Kalcha?”"},{"id":"manas-2010:p1508:b001:l029","ordinal":65081,"en":"Without fearing death,"},{"id":"manas-2010:p1508:b001:l030","ordinal":65082,"en":"So the wolf-maned lion went,"},{"id":"manas-2010:p1508:b001:l031","ordinal":65083,"en":"Never saying, “I shall die in battle.”"},{"id":"manas-2010:p1508:b001:l032","ordinal":65084,"en":"The lion rang out, unconcerned;"},{"id":"manas-2010:p1508:b001:l033","ordinal":65085,"en":"Apart from Kongurbay,"},{"id":"manas-2010:p1508:b001:l034","ordinal":65086,"en":"He reckoned none worth his trouser hem."},{"id":"manas-2010:p1508:b001:l035","ordinal":65087,"en":"Through the seething multitude of Chinese"},{"id":"manas-2010:p1508:b001:l036","ordinal":65088,"en":"Almambet burst, splitting them in two."},{"id":"manas-2010:p1508:b001:l037","ordinal":65089,"en":"With corners looming in the haze,"},{"id":"manas-2010:p1508:b001:l038","ordinal":65090,"en":"With points rising dim and dark,"},{"id":"manas-2010:p1508:b001:l039","ordinal":65091,"en":"If you looked closely,"},{"id":"manas-2010:p1508:b001:l040","ordinal":65092,"en":"It was Kongurbay's fortress."},{"id":"manas-2010:p1508:b001:l041","ordinal":65093,"en":"Around the outside of that fortress,"},{"id":"manas-2010:p1508:b001:l042","ordinal":65094,"en":"Sparing none who grappled with them,"},{"id":"manas-2010:p1509:b001:l001","ordinal":65095,"en":"Killing those who fought them,"},{"id":"manas-2010:p1509:b001:l002","ordinal":65096,"en":"Were the renowned people of the monks."},{"id":"manas-2010:p1509:b001:l003","ordinal":65097,"en":"Finding a plan for the Chinese,"},{"id":"manas-2010:p1509:b001:l004","ordinal":65098,"en":"Sending them surging to bring distress,"},{"id":"manas-2010:p1509:b001:l005","ordinal":65099,"en":"The Kalcha was a wise warrior,"},{"id":"manas-2010:p1509:b001:l006","ordinal":65100,"en":"For all the people of Beijing"},{"id":"manas-2010:p1509:b001:l007","ordinal":65101,"en":"A fortress firmly planted."},{"id":"manas-2010:p1509:b001:l008","ordinal":65102,"en":"Who threw the whole world into turmoil,"},{"id":"manas-2010:p1509:b001:l009","ordinal":65103,"en":"Alöökö's Kongurbay,"},{"id":"manas-2010:p1509:b001:l010","ordinal":65104,"en":"Among round-headed humankind"},{"id":"manas-2010:p1509:b001:l011","ordinal":65105,"en":"Was born an outstanding hero."},{"id":"manas-2010:p1509:b001:l012","ordinal":65106,"en":"Not yielding to his prowess,"},{"id":"manas-2010:p1509:b001:l013","ordinal":65107,"en":"Azizkan's Almambet"},{"id":"manas-2010:p1509:b001:l014","ordinal":65108,"en":"Was sweeping his way inside."},{"id":"manas-2010:p1509:b001:l015","ordinal":65109,"en":"The many monks and Manchu,"},{"id":"manas-2010:p1509:b001:l016","ordinal":65110,"en":"Shattering all he met,"},{"id":"manas-2010:p1509:b001:l017","ordinal":65111,"en":"He was cutting his way through."},{"id":"manas-2010:p1509:b001:l018","ordinal":65112,"en":"Manas was born in Altai;"},{"id":"manas-2010:p1509:b001:l019","ordinal":65113,"en":"When he reached twelve,"},{"id":"manas-2010:p1509:b001:l020","ordinal":65114,"en":"He destroyed courts and took spoils."},{"id":"manas-2010:p1509:b001:l021","ordinal":65115,"en":"The leopard shattered the Oyrat,"},{"id":"manas-2010:p1509:b001:l022","ordinal":65116,"en":"Cutting a path through their midst,"},{"id":"manas-2010:p1509:b001:l023","ordinal":65117,"en":"Making Kokand cry in distress,"},{"id":"manas-2010:p1509:b001:l024","ordinal":65118,"en":"Making Talas his court,"},{"id":"manas-2010:p1509:b001:l025","ordinal":65119,"en":"Destroying every person,"},{"id":"manas-2010:p1509:b001:l026","ordinal":65120,"en":"Manas went cutting them down;"},{"id":"manas-2010:p1509:b001:l027","ordinal":65121,"en":"Shattering right and left,"},{"id":"manas-2010:p1509:b001:l028","ordinal":65122,"en":"Manas went slaughtering them."},{"id":"manas-2010:p1509:b001:l029","ordinal":65123,"en":"Pouring blood into dark water,"},{"id":"manas-2010:p1509:b001:l030","ordinal":65124,"en":"Receiving the holy khan's blessing,"},{"id":"manas-2010:p1509:b001:l031","ordinal":65125,"en":"He was named leopard Manas."},{"id":"manas-2010:p1509:b001:l032","ordinal":65126,"en":"While he acted thus,"},{"id":"manas-2010:p1509:b001:l033","ordinal":65127,"en":"When he ruled the people,"},{"id":"manas-2010:p1509:b001:l034","ordinal":65128,"en":"Found from the unseen world,"},{"id":"manas-2010:p1509:b001:l035","ordinal":65129,"en":"The Tashkeser Manas received"},{"id":"manas-2010:p1509:b001:l036","ordinal":65130,"en":"Was the mightiest of swords."},{"id":"manas-2010:p1509:b001:l037","ordinal":65131,"en":"Khan Bakay's Oykuma,"},{"id":"manas-2010:p1509:b001:l038","ordinal":65132,"en":"The Achalbars Azhybay received,"},{"id":"manas-2010:p1509:b001:l039","ordinal":65133,"en":"Almambet's Zhoybolot,"},{"id":"manas-2010:p1509:b001:l040","ordinal":65134,"en":"The Kolbolot Chubak received,"},{"id":"manas-2010:p1509:b001:l041","ordinal":65135,"en":"The Arkesken Syrgak received—"},{"id":"manas-2010:p1509:b001:l042","ordinal":65136,"en":"Those were the six keen steel blades."},{"id":"manas-2010:p1510:b001:l001","ordinal":65137,"en":"They brought joy to the precious soul;"},{"id":"manas-2010:p1510:b001:l002","ordinal":65138,"en":"They never shrank from a sweep."},{"id":"manas-2010:p1510:b001:l003","ordinal":65139,"en":"If swung in wrath,"},{"id":"manas-2010:p1510:b001:l004","ordinal":65140,"en":"They never returned without drinking blood."},{"id":"manas-2010:p1510:b001:l005","ordinal":65141,"en":"Six thousand Chinese, countless governors,"},{"id":"manas-2010:p1510:b001:l006","ordinal":65142,"en":"Kongurbay among them—"},{"id":"manas-2010:p1510:b001:l007","ordinal":65143,"en":"Zhoybolot in his hand,"},{"id":"manas-2010:p1510:b001:l008","ordinal":65144,"en":"Drawing it from the sheath and shouting,"},{"id":"manas-2010:p1510:b001:l009","ordinal":65145,"en":"Roaring like a dragon,"},{"id":"manas-2010:p1510:b001:l010","ordinal":65146,"en":"Among the Chinese before him"},{"id":"manas-2010:p1510:b001:l011","ordinal":65147,"en":"Almambet plunged."},{"id":"manas-2010:p1510:b001:l012","ordinal":65148,"en":"Those fleeing to the right,"},{"id":"manas-2010:p1510:b001:l013","ordinal":65149,"en":"Shattering them toward the hollow,"},{"id":"manas-2010:p1510:b001:l014","ordinal":65150,"en":"Almambet cut them down."},{"id":"manas-2010:p1510:b001:l015","ordinal":65151,"en":"Those fleeing to the left,"},{"id":"manas-2010:p1510:b001:l016","ordinal":65152,"en":"Striking left-handed, shooting right,"},{"id":"manas-2010:p1510:b001:l017","ordinal":65153,"en":"Almambet slaughtered them."},{"id":"manas-2010:p1510:b001:l018","ordinal":65154,"en":"Khan Baltay's Chubak"},{"id":"manas-2010:p1510:b001:l019","ordinal":65155,"en":"Charged in from one side."},{"id":"manas-2010:p1510:b001:l020","ordinal":65156,"en":"Heroes Almambet, Chubak and Syrgak,"},{"id":"manas-2010:p1510:b001:l021","ordinal":65157,"en":"Plunging among the Chinese,"},{"id":"manas-2010:p1510:b001:l022","ordinal":65158,"en":"Those daredevils brought them torment."},{"id":"manas-2010:p1510:b001:l023","ordinal":65159,"en":"Almambet drove a thousand"},{"id":"manas-2010:p1510:b001:l024","ordinal":65160,"en":"Toward the foothills;"},{"id":"manas-2010:p1510:b001:l025","ordinal":65161,"en":"About six thousand governors"},{"id":"manas-2010:p1510:b001:l026","ordinal":65162,"en":"Syrgak pursued."},{"id":"manas-2010:p1510:b001:l027","ordinal":65163,"en":"Among the champions in their very midst,"},{"id":"manas-2010:p1510:b001:l028","ordinal":65164,"en":"Chubak wrought slaughter."},{"id":"manas-2010:p1510:b001:l029","ordinal":65165,"en":"Among six thousand governors,"},{"id":"manas-2010:p1510:b001:l030","ordinal":65166,"en":"The foremost was Kongurbay."},{"id":"manas-2010:p1510:b001:l031","ordinal":65167,"en":"The black earth was drenched in blood;"},{"id":"manas-2010:p1510:b001:l032","ordinal":65168,"en":"Blood running down his flanks,"},{"id":"manas-2010:p1510:b001:l033","ordinal":65169,"en":"Hero Syrgak kept slaughtering."},{"id":"manas-2010:p1510:b001:l034","ordinal":65170,"en":"“What stratagem can I use?”"},{"id":"manas-2010:p1510:b001:l035","ordinal":65171,"en":"Watching from outside,"},{"id":"manas-2010:p1510:b001:l036","ordinal":65172,"en":"That damned Kalcha Kongurbay wondered."},{"id":"manas-2010:p1510:b001:l037","ordinal":65173,"en":"“As long as Syrgak lives,"},{"id":"manas-2010:p1510:b001:l038","ordinal":65174,"en":"For these Chinese here"},{"id":"manas-2010:p1510:b001:l039","ordinal":65175,"en":"The wide world is narrow."},{"id":"manas-2010:p1510:b001:l040","ordinal":65176,"en":"Among the Muslims,"},{"id":"manas-2010:p1510:b001:l041","ordinal":65177,"en":"He is worth their Manas."},{"id":"manas-2010:p1510:b001:l042","ordinal":65178,"en":"Multitude of Chinese, many Manchu,"},{"id":"manas-2010:p1511:b001:l001","ordinal":65179,"en":"Hear the words I say!"},{"id":"manas-2010:p1511:b001:l002","ordinal":65180,"en":"If we capture Syrgak,"},{"id":"manas-2010:p1511:b001:l003","ordinal":65181,"en":"Heaven has granted him to us!"},{"id":"manas-2010:p1511:b001:l004","ordinal":65182,"en":"If we do not capture Syrgak,"},{"id":"manas-2010:p1511:b001:l005","ordinal":65183,"en":"The Chinese will all die alike!"},{"id":"manas-2010:p1511:b001:l006","ordinal":65184,"en":"Syrgak's thrusting lance"},{"id":"manas-2010:p1511:b001:l007","ordinal":65185,"en":"I have watched three times."},{"id":"manas-2010:p1511:b001:l008","ordinal":65186,"en":"His skill is beyond the rest;"},{"id":"manas-2010:p1511:b001:l009","ordinal":65187,"en":"Even now it has not left"},{"id":"manas-2010:p1511:b001:l010","ordinal":65188,"en":"My deepest thoughts, that lance of his."},{"id":"manas-2010:p1511:b001:l011","ordinal":65189,"en":"His right shoulder is broad;"},{"id":"manas-2010:p1511:b001:l012","ordinal":65190,"en":"Outstanding Syrgak, that champion wretch,"},{"id":"manas-2010:p1511:b001:l013","ordinal":65191,"en":"Is a hero born among the Burut."},{"id":"manas-2010:p1511:b001:l014","ordinal":65192,"en":"His eyes are dimmed and misted;"},{"id":"manas-2010:p1511:b001:l015","ordinal":65193,"en":"He is swollen with pride now."},{"id":"manas-2010:p1511:b001:l016","ordinal":65194,"en":"Without feeling shame before Syrgak,"},{"id":"manas-2010:p1511:b001:l017","ordinal":65195,"en":"Let us pretend to flee;"},{"id":"manas-2010:p1511:b001:l018","ordinal":65196,"en":"Let us turn our horses' rumps to him!"},{"id":"manas-2010:p1511:b001:l019","ordinal":65197,"en":"Deceiving and coaxing Syrgak,"},{"id":"manas-2010:p1511:b001:l020","ordinal":65198,"en":"With a great army from the rear,"},{"id":"manas-2010:p1511:b001:l021","ordinal":65199,"en":"Let us hem him in with Chinese"},{"id":"manas-2010:p1511:b001:l022","ordinal":65200,"en":"And throw him into the dug pit!”"},{"id":"manas-2010:p1511:b001:l023","ordinal":65201,"en":"Before he had closed his mouth,"},{"id":"manas-2010:p1511:b001:l024","ordinal":65202,"en":"Your Syrgak wrought havoc."},{"id":"manas-2010:p1511:b001:l025","ordinal":65203,"en":"On the sloping ground he speared men;"},{"id":"manas-2010:p1511:b001:l026","ordinal":65204,"en":"He pierced seven together with one thrust."},{"id":"manas-2010:p1511:b001:l027","ordinal":65205,"en":"Marvels no other man could perform,"},{"id":"manas-2010:p1511:b001:l028","ordinal":65206,"en":"He performed as he came through."},{"id":"manas-2010:p1511:b001:l029","ordinal":65207,"en":"Behind him, Baychoro,"},{"id":"manas-2010:p1511:b001:l030","ordinal":65208,"en":"The Chinese fallen from their horses,"},{"id":"manas-2010:p1511:b001:l031","ordinal":65209,"en":"Leaving not a single one alive,"},{"id":"manas-2010:p1511:b001:l032","ordinal":65210,"en":"Came through slaughtering them."},{"id":"manas-2010:p1511:b001:l033","ordinal":65211,"en":"Seeing this, the countless governors"},{"id":"manas-2010:p1511:b001:l034","ordinal":65212,"en":"Lost the shafts from their hands;"},{"id":"manas-2010:p1511:b001:l035","ordinal":65213,"en":"The coverings slipped from their hearts."},{"id":"manas-2010:p1511:b001:l036","ordinal":65214,"en":"In their fear, the countless governors"},{"id":"manas-2010:p1511:b001:l037","ordinal":65215,"en":"Struck their battle drums once;"},{"id":"manas-2010:p1511:b001:l038","ordinal":65216,"en":"All of them fled together,"},{"id":"manas-2010:p1511:b001:l039","ordinal":65217,"en":"Charging toward Beijing."},{"id":"manas-2010:p1511:b001:l040","ordinal":65218,"en":"The Manchu stayed without fleeing."},{"id":"manas-2010:p1511:b001:l041","ordinal":65219,"en":"Amid the many Manchu,"},{"id":"manas-2010:p1511:b001:l042","ordinal":65220,"en":"Kongurbay lay concealed, watching Syrgak,"},{"id":"manas-2010:p1512:b001:l001","ordinal":65221,"en":"Keeping watch in ambush."},{"id":"manas-2010:p1512:b001:l002","ordinal":65222,"en":"When Syrgak came near,"},{"id":"manas-2010:p1512:b001:l003","ordinal":65223,"en":"Kongurbay, khan of Beijing,"},{"id":"manas-2010:p1512:b001:l004","ordinal":65224,"en":"Charged out with a roar."},{"id":"manas-2010:p1512:b001:l005","ordinal":65225,"en":"The Kalcha reached him from the side;"},{"id":"manas-2010:p1512:b001:l006","ordinal":65226,"en":"As soon as he reached Syrgak,"},{"id":"manas-2010:p1512:b001:l007","ordinal":65227,"en":"He struck hard and rode past."},{"id":"manas-2010:p1512:b001:l008","ordinal":65228,"en":"The lance flew into splinters,"},{"id":"manas-2010:p1512:b001:l009","ordinal":65229,"en":"Cracking into separate pieces."},{"id":"manas-2010:p1512:b001:l010","ordinal":65230,"en":"The Kalcha's thrust as he passed,"},{"id":"manas-2010:p1512:b001:l011","ordinal":65231,"en":"Your leopard warrior Syrgak"},{"id":"manas-2010:p1512:b001:l012","ordinal":65232,"en":"Met with a ringing, heedless ease;"},{"id":"manas-2010:p1512:b001:l013","ordinal":65233,"en":"The Kalcha wretch Kongurbay"},{"id":"manas-2010:p1512:b001:l014","ordinal":65234,"en":"He reckoned not worth his shin."},{"id":"manas-2010:p1512:b001:l015","ordinal":65235,"en":"When Kongurbay had thrust and passed,"},{"id":"manas-2010:p1512:b001:l016","ordinal":65236,"en":"All the Manchu reached him;"},{"id":"manas-2010:p1512:b001:l017","ordinal":65237,"en":"Circling round in many layers,"},{"id":"manas-2010:p1512:b001:l018","ordinal":65238,"en":"They surrounded him."},{"id":"manas-2010:p1512:b001:l019","ordinal":65239,"en":"As they stood surrounding him,"},{"id":"manas-2010:p1512:b001:l020","ordinal":65240,"en":"As he was left alone in their midst,"},{"id":"manas-2010:p1512:b001:l021","ordinal":65241,"en":"Syrgak thought this:"},{"id":"manas-2010:p1512:b001:l022","ordinal":65242,"en":"“When will my dear Almambet see me"},{"id":"manas-2010:p1512:b001:l023","ordinal":65243,"en":"And, while the Manchu surround me,"},{"id":"manas-2010:p1512:b001:l024","ordinal":65244,"en":"Come to give me support?”"},{"id":"manas-2010:p1512:b001:l025","ordinal":65245,"en":"His insides burned like embers;"},{"id":"manas-2010:p1512:b001:l026","ordinal":65246,"en":"Unable to put up even a dog's fight,"},{"id":"manas-2010:p1512:b001:l027","ordinal":65247,"en":"For as long as meat takes to cook,"},{"id":"manas-2010:p1512:b001:l028","ordinal":65248,"en":"Hero Syrgak stood dazed and frantic,"},{"id":"manas-2010:p1512:b001:l029","ordinal":65249,"en":"Unable to gather his senses."},{"id":"manas-2010:p1512:b001:l030","ordinal":65250,"en":"“For me to stand here dazed,"},{"id":"manas-2010:p1512:b001:l031","ordinal":65251,"en":"This is no tamarisk-covered plain,"},{"id":"manas-2010:p1512:b001:l032","ordinal":65252,"en":"No banks of ancestral Keng-Kol!"},{"id":"manas-2010:p1512:b001:l033","ordinal":65253,"en":"There is no Talas where we dwell;"},{"id":"manas-2010:p1512:b001:l034","ordinal":65254,"en":"Leaping along on Akkula,"},{"id":"manas-2010:p1512:b001:l035","ordinal":65255,"en":"Coming with a roar to strike,"},{"id":"manas-2010:p1512:b001:l036","ordinal":65256,"en":"My wolf-maned lion Manas is not here!”"},{"id":"manas-2010:p1512:b001:l037","ordinal":65257,"en":"So saying, hero Syrgak"},{"id":"manas-2010:p1512:b001:l038","ordinal":65258,"en":"Summoned courage, gritting his teeth;"},{"id":"manas-2010:p1512:b001:l039","ordinal":65259,"en":"He struck Kökchebich once,"},{"id":"manas-2010:p1512:b001:l040","ordinal":65260,"en":"And among the Manchu enclosing him"},{"id":"manas-2010:p1512:b001:l041","ordinal":65261,"en":"He plunged in attack."},{"id":"manas-2010:p1512:b001:l042","ordinal":65262,"en":"His eyes blazing like a lion's,"},{"id":"manas-2010:p1513:b001:l001","ordinal":65263,"en":"Giving them more of the same,"},{"id":"manas-2010:p1513:b001:l002","ordinal":65264,"en":"Hacking all he met to pieces,"},{"id":"manas-2010:p1513:b001:l003","ordinal":65265,"en":"Hero Syrgak went shouting,"},{"id":"manas-2010:p1513:b001:l004","ordinal":65266,"en":"“Where is that Kalcha? Where?”"},{"id":"manas-2010:p1513:b001:l005","ordinal":65267,"en":"Mountain-like Kongurbay"},{"id":"manas-2010:p1513:b001:l006","ordinal":65268,"en":"Stepped apart from his ranks;"},{"id":"manas-2010:p1513:b001:l007","ordinal":65269,"en":"He stood waiting for Syrgak,"},{"id":"manas-2010:p1513:b001:l008","ordinal":65270,"en":"Appearing straight before him."},{"id":"manas-2010:p1513:b001:l009","ordinal":65271,"en":"“Come to single combat, Syrgak wretch!"},{"id":"manas-2010:p1513:b001:l010","ordinal":65272,"en":"Let me spear you and split your gall!"},{"id":"manas-2010:p1513:b001:l011","ordinal":65273,"en":"That thing of yours marked by ritual,"},{"id":"manas-2010:p1513:b001:l012","ordinal":65274,"en":"Let me cut it off again!"},{"id":"manas-2010:p1513:b001:l013","ordinal":65275,"en":"Death-seeking Burut, Syrgak wretch,"},{"id":"manas-2010:p1513:b001:l014","ordinal":65276,"en":"Let me thrust my wolf-tongued lance;"},{"id":"manas-2010:p1513:b001:l015","ordinal":65277,"en":"Joining you with Manas,"},{"id":"manas-2010:p1513:b001:l016","ordinal":65278,"en":"Let me make you like an extinguished fire!”"},{"id":"manas-2010:p1513:b001:l017","ordinal":65279,"en":"Hearing this, hero Syrgak,"},{"id":"manas-2010:p1513:b001:l018","ordinal":65280,"en":"Smoke coming from his mouth,"}]
