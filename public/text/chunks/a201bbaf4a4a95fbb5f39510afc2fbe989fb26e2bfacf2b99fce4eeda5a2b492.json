[{"id":"seytek-2012:p0518:b003:l036","ordinal":333313,"en":"And Karjygach behind the host."},{"id":"seytek-2012:p0518:b003:l037","ordinal":333314,"en":"Plumed standards rose and banners thronged,"},{"id":"seytek-2012:p0518:b003:l038","ordinal":333315,"en":"A dark and dreadful tumult arose,"},{"id":"seytek-2012:p0518:b003:l039","ordinal":333316,"en":"Throwing the whole world into panic."},{"id":"seytek-2012:p0518:b003:l040","ordinal":333317,"en":"Beneath him, the great horse Kula"},{"id":"seytek-2012:p0519:b002:l001","ordinal":333318,"en":"Made the earth thunder and mountains shift,"},{"id":"seytek-2012:p0519:b002:l002","ordinal":333319,"en":"Tormenting every soul who heard,"},{"id":"seytek-2012:p0519:b002:l003","ordinal":333320,"en":"As Sarybai sat astride it."},{"id":"seytek-2012:p0519:b002:l004","ordinal":333321,"en":"That infidel Sarybai"},{"id":"seytek-2012:p0519:b002:l005","ordinal":333322,"en":"Charged like a wild boar."},{"id":"seytek-2012:p0519:b002:l006","ordinal":333323,"en":"The fierce courage of that swine"},{"id":"seytek-2012:p0519:b002:l007","ordinal":333324,"en":"Was like a wind that shattered mountains and rocks."},{"id":"seytek-2012:p0519:b002:l008","ordinal":333325,"en":"His ferocity was like a quagmire;"},{"id":"seytek-2012:p0519:b002:l009","ordinal":333326,"en":"All but the hero Külchoro"},{"id":"seytek-2012:p0519:b002:l010","ordinal":333327,"en":"Seemed to collapse and fall."},{"id":"seytek-2012:p0519:b002:l011","ordinal":333328,"en":"Such was the warrior’s state,"},{"id":"seytek-2012:p0519:b002:l012","ordinal":333329,"en":"The ruthless devourer Sarybai."},{"id":"seytek-2012:p0519:b002:l013","ordinal":333330,"en":"The infidel’s fury overflowed;"},{"id":"seytek-2012:p0519:b002:l014","ordinal":333331,"en":"His roaring shook the valley."},{"id":"seytek-2012:p0519:b002:l015","ordinal":333332,"en":"Despairing of life and thinking themselves dead,"},{"id":"seytek-2012:p0519:b002:l016","ordinal":333333,"en":"The teeming Argyn and Kyrgyz people,"},{"id":"seytek-2012:p0519:b002:l017","ordinal":333334,"en":"Unable to collect their wits,"},{"id":"seytek-2012:p0519:b002:l018","ordinal":333335,"en":"Fled amid the thunder."},{"id":"seytek-2012:p0519:b002:l019","ordinal":333336,"en":"Sarybai, son of the Ogre,"},{"id":"seytek-2012:p0519:b002:l020","ordinal":333337,"en":"Seemed ready to reap destruction;"},{"id":"seytek-2012:p0519:b002:l021","ordinal":333338,"en":"If the scoundrel had his way,"},{"id":"seytek-2012:p0519:b002:l022","ordinal":333339,"en":"He would stuff the entire world"},{"id":"seytek-2012:p0519:b002:l023","ordinal":333340,"en":"Into a single saddlebag."},{"id":"seytek-2012:p0519:b002:l024","ordinal":333341,"en":"His savage fury seemed all-consuming,"},{"id":"seytek-2012:p0519:b002:l025","ordinal":333342,"en":"His strength ready to swallow lives."},{"id":"seytek-2012:p0519:b002:l026","ordinal":333343,"en":"Each hair upon his face"},{"id":"seytek-2012:p0519:b002:l027","ordinal":333344,"en":"Was like the haft of a battle-ax."},{"id":"seytek-2012:p0519:b002:l028","ordinal":333345,"en":"The fierce courage of that swine"},{"id":"seytek-2012:p0519:b002:l029","ordinal":333346,"en":"Was like flame burning across the uplands."},{"id":"seytek-2012:p0519:b002:l030","ordinal":333347,"en":"Such was Sarybai,"},{"id":"seytek-2012:p0519:b002:l031","ordinal":333348,"en":"That blazing boar."},{"id":"seytek-2012:p0519:b002:l032","ordinal":333349,"en":"The earth split with a crash,"},{"id":"seytek-2012:p0519:b002:l033","ordinal":333350,"en":"As he roared as though to devour them."},{"id":"seytek-2012:p0519:b002:l034","ordinal":333351,"en":"Like a crumbling mountain ledge,"},{"id":"seytek-2012:p0519:b002:l035","ordinal":333352,"en":"Like a flood pouring down a slope,"},{"id":"seytek-2012:p0519:b002:l036","ordinal":333353,"en":"Like a deep-dug grave,"},{"id":"seytek-2012:p0519:b002:l037","ordinal":333354,"en":"The madman came upon them."},{"id":"seytek-2012:p0519:b002:l038","ordinal":333355,"en":"Firing his musket and drawing his bow,"},{"id":"seytek-2012:p0519:b002:l039","ordinal":333356,"en":"Sarybai spared not his life;"},{"id":"seytek-2012:p0519:b002:l040","ordinal":333357,"en":"He cursed again and showered arrows,"},{"id":"seytek-2012:p0519:b003:l001","ordinal":333358,"en":"Never sated though he drank blood."},{"id":"seytek-2012:p0519:b003:l002","ordinal":333359,"en":"My resting place beneath the earth"},{"id":"seytek-2012:p0519:b003:l003","ordinal":333360,"en":"Was there beside Zhelpinish."},{"id":"seytek-2012:p0519:b003:l004","ordinal":333361,"en":"“To unleash a terrible slaughter,"},{"id":"seytek-2012:p0519:b003:l005","ordinal":333362,"en":"To avenge my father—"},{"id":"seytek-2012:p0519:b003:l006","ordinal":333363,"en":"This alone was my desire."},{"id":"seytek-2012:p0519:b003:l007","ordinal":333364,"en":"My prowess is unlike any other,"},{"id":"seytek-2012:p0519:b003:l008","ordinal":333365,"en":"My valor is beyond measure."},{"id":"seytek-2012:p0519:b003:l009","ordinal":333366,"en":"I shall make good the words I spoke;"},{"id":"seytek-2012:p0519:b003:l010","ordinal":333367,"en":"How could I fail to avenge"},{"id":"seytek-2012:p0519:b003:l011","ordinal":333368,"en":"The grievance famed among the people!"},{"id":"seytek-2012:p0519:b003:l012","ordinal":333369,"en":"Ever since I became Sarybai,"},{"id":"seytek-2012:p0519:b003:l013","ordinal":333370,"en":"I have defeated all who confronted me,"},{"id":"seytek-2012:p0519:b003:l014","ordinal":333371,"en":"And swallowed all who charged me."},{"id":"seytek-2012:p0519:b003:l015","ordinal":333372,"en":"I have hewn down everyone I met,"},{"id":"seytek-2012:p0519:b003:l016","ordinal":333373,"en":"And massacred and despoiled"},{"id":"seytek-2012:p0519:b003:l017","ordinal":333374,"en":"Many champions and mighty giants who opposed me!"},{"id":"seytek-2012:p0519:b003:l018","ordinal":333375,"en":"I speak to shatter your courage;"},{"id":"seytek-2012:p0519:b003:l019","ordinal":333376,"en":"I shall slaughter many of you and take revenge!"},{"id":"seytek-2012:p0519:b003:l020","ordinal":333377,"en":"I am the black eye of disaster,"},{"id":"seytek-2012:p0519:b003:l021","ordinal":333378,"en":"Calamity itself."},{"id":"seytek-2012:p0519:b003:l022","ordinal":333379,"en":"No winged creature can escape me;"},{"id":"seytek-2012:p0519:b003:l023","ordinal":333380,"en":"I am an impassable black precipice."},{"id":"seytek-2012:p0519:b003:l024","ordinal":333381,"en":"I am a dense forest of snares,"},{"id":"seytek-2012:p0519:b003:l025","ordinal":333382,"en":"I swallow all who grapple with me."},{"id":"seytek-2012:p0519:b003:l026","ordinal":333383,"en":"I shall strike terror like a dragon,"},{"id":"seytek-2012:p0519:b003:l027","ordinal":333384,"en":"And take my vengeance everywhere!"},{"id":"seytek-2012:p0519:b003:l028","ordinal":333385,"en":"I am the very eye of calamity,"},{"id":"seytek-2012:p0519:b003:l029","ordinal":333386,"en":"The black scourge itself."},{"id":"seytek-2012:p0519:b003:l030","ordinal":333387,"en":"I am a vast black valley"},{"id":"seytek-2012:p0519:b003:l031","ordinal":333388,"en":"That cannot be exhausted even when shoveled away.”"},{"id":"seytek-2012:p0519:b003:l032","ordinal":333389,"en":"So saying, Sarybai,"},{"id":"seytek-2012:p0519:b003:l033","ordinal":333390,"en":"With fiery flame burning from his mouth,"},{"id":"seytek-2012:p0519:b003:l034","ordinal":333391,"en":"Took a mountain-like mace in hand,"},{"id":"seytek-2012:p0519:b003:l035","ordinal":333392,"en":"Struck Zhelmaian on the flank,"},{"id":"seytek-2012:p0519:b003:l036","ordinal":333393,"en":"Broke through the narrows and opened a path,"},{"id":"seytek-2012:p0519:b003:l037","ordinal":333394,"en":"And attacked Külchoro,"},{"id":"seytek-2012:p0519:b003:l038","ordinal":333395,"en":"Standing there in wrath."},{"id":"seytek-2012:p0519:b003:l039","ordinal":333396,"en":"With his battle-ax he struck"},{"id":"seytek-2012:p0519:b003:l040","ordinal":333397,"en":"The shrill-voiced brass spear."},{"id":"seytek-2012:p0520:b002:l001","ordinal":333398,"en":"Marking out the place of death,"},{"id":"seytek-2012:p0520:b002:l002","ordinal":333399,"en":"The wonderfully vigilant hero"},{"id":"seytek-2012:p0520:b002:l003","ordinal":333400,"en":"Külchoro stood waiting,"},{"id":"seytek-2012:p0520:b002:l004","ordinal":333401,"en":"And against the infidel Ogre’s son"},{"id":"seytek-2012:p0520:b002:l005","ordinal":333402,"en":"Thrust his spear upon reaching him."},{"id":"seytek-2012:p0520:b002:l006","ordinal":333403,"en":"As though he had punched a stone,"},{"id":"seytek-2012:p0520:b002:l007","ordinal":333404,"en":"The noble man brought all his strength;"},{"id":"seytek-2012:p0520:b002:l008","ordinal":333405,"en":"Its steel nature became evident:"},{"id":"seytek-2012:p0520:b002:l009","ordinal":333406,"en":"The ornamented spear did not break,"},{"id":"seytek-2012:p0520:b002:l010","ordinal":333407,"en":"But bent like a tent prop."},{"id":"seytek-2012:p0520:b002:l011","ordinal":333408,"en":"The wretched son of Almambet"},{"id":"seytek-2012:p0520:b002:l012","ordinal":333409,"en":"Revealed himself a true hero,"},{"id":"seytek-2012:p0520:b002:l013","ordinal":333410,"en":"Supremely vigilant and blessed with fortune,"},{"id":"seytek-2012:p0520:b002:l014","ordinal":333411,"en":"His courage like a fortress of steel;"},{"id":"seytek-2012:p0520:b002:l015","ordinal":333412,"en":"None who clashed with him could survive."},{"id":"seytek-2012:p0520:b002:l016","ordinal":333413,"en":"The ornamented spear had a steel core;"},{"id":"seytek-2012:p0520:b002:l017","ordinal":333414,"en":"Thus he kept thrusting it."},{"id":"seytek-2012:p0520:b002:l018","ordinal":333415,"en":"If you ask about that ornamented spear,"},{"id":"seytek-2012:p0520:b002:l019","ordinal":333416,"en":"It was designed and tempered for war."},{"id":"seytek-2012:p0520:b002:l020","ordinal":333417,"en":"Bölökbai, planning for battle,"},{"id":"seytek-2012:p0520:b002:l021","ordinal":333418,"en":"Had fashioned it, poor man."},{"id":"seytek-2012:p0520:b002:l022","ordinal":333419,"en":"He hardened and twisted its shaft;"},{"id":"seytek-2012:p0520:b002:l023","ordinal":333420,"en":"The master craftsman Bölökbai"},{"id":"seytek-2012:p0520:b002:l024","ordinal":333421,"en":"Fitted and finished it beautifully."},{"id":"seytek-2012:p0520:b002:l025","ordinal":333422,"en":"He had iron drawn through its core,"},{"id":"seytek-2012:p0520:b002:l026","ordinal":333423,"en":"And firmly increased its measure."},{"id":"seytek-2012:p0520:b002:l027","ordinal":333424,"en":"He edged it like a wolf’s tongue,"},{"id":"seytek-2012:p0520:b002:l028","ordinal":333425,"en":"Lest by some chance in close combat"},{"id":"seytek-2012:p0520:b002:l029","ordinal":333426,"en":"It slip from the hand,"},{"id":"seytek-2012:p0520:b002:l030","ordinal":333427,"en":"And adorned it with lacquer."},{"id":"seytek-2012:p0520:b002:l031","ordinal":333428,"en":"Every bard sang of it,"},{"id":"seytek-2012:p0520:b002:l032","ordinal":333429,"en":"And every discerning man listened."},{"id":"seytek-2012:p0520:b002:l033","ordinal":333430,"en":"If you ask about that ornamented spear,"},{"id":"seytek-2012:p0520:b002:l034","ordinal":333431,"en":"When its charcoal was prepared,"},{"id":"seytek-2012:p0520:b002:l035","ordinal":333432,"en":"A whole forest on the green plain was felled."},{"id":"seytek-2012:p0520:b002:l036","ordinal":333433,"en":"When its forge was fired,"},{"id":"seytek-2012:p0520:b002:l037","ordinal":333434,"en":"A tribute bull of the Kyrgyz,"},{"id":"seytek-2012:p0520:b002:l038","ordinal":333435,"en":"A blue young bull, was slaughtered."},{"id":"seytek-2012:p0520:b002:l039","ordinal":333436,"en":"He tempered its steel core,"},{"id":"seytek-2012:p0520:b002:l040","ordinal":333437,"en":"Fashioning it expressly for battle,"},{"id":"seytek-2012:p0520:b003:l001","ordinal":333438,"en":"And Külchoro drove it with tremendous force."},{"id":"seytek-2012:p0520:b003:l002","ordinal":333439,"en":"Raging and straining,"},{"id":"seytek-2012:p0520:b003:l003","ordinal":333440,"en":"He again took in hand"},{"id":"seytek-2012:p0520:b003:l004","ordinal":333441,"en":"The cast-iron head as large as a house,"},{"id":"seytek-2012:p0520:b003:l005","ordinal":333442,"en":"And struck with that iron head."},{"id":"seytek-2012:p0520:b003:l006","ordinal":333443,"en":"Seizing the ornamented broad-mouthed arrow,"},{"id":"seytek-2012:p0520:b003:l007","ordinal":333444,"en":"Sarybai shot a hundred shafts,"},{"id":"seytek-2012:p0520:b003:l008","ordinal":333445,"en":"Summoning all his courage."},{"id":"seytek-2012:p0520:b003:l009","ordinal":333446,"en":"He made the age itself constrict,"},{"id":"seytek-2012:p0520:b003:l010","ordinal":333447,"en":"As the madman stood thus."},{"id":"seytek-2012:p0520:b003:l011","ordinal":333448,"en":"Whipping the dun kulan-horse,"},{"id":"seytek-2012:p0520:b003:l012","ordinal":333449,"en":"That capable servant, fitted for war,"},{"id":"seytek-2012:p0520:b003:l013","ordinal":333450,"en":"That powerful servant who knew"},{"id":"seytek-2012:p0520:b003:l014","ordinal":333451,"en":"All the stratagems of the foe,"},{"id":"seytek-2012:p0520:b003:l015","ordinal":333452,"en":"Fortunate Külchoro—"},{"id":"seytek-2012:p0520:b003:l016","ordinal":333453,"en":"Was he not the warrior who had struck down"},{"id":"seytek-2012:p0520:b003:l017","ordinal":333454,"en":"Not only Sarybai, but the world?"},{"id":"seytek-2012:p0520:b003:l018","ordinal":333455,"en":"Had he not subdued"},{"id":"seytek-2012:p0520:b003:l019","ordinal":333456,"en":"And conquered the whole world!"},{"id":"seytek-2012:p0520:b003:l020","ordinal":333457,"en":"His eyes saw from afar;"},{"id":"seytek-2012:p0520:b003:l021","ordinal":333458,"en":"He was wiser than multitudes,"},{"id":"seytek-2012:p0520:b003:l022","ordinal":333459,"en":"And stood unmatched in a solitary race."},{"id":"seytek-2012:p0520:b003:l023","ordinal":333460,"en":"A supreme hero, master of the spear,"},{"id":"seytek-2012:p0520:b003:l024","ordinal":333461,"en":"The tiger-warrior and sage"},{"id":"seytek-2012:p0520:b003:l025","ordinal":333462,"en":"Who truly knew the enemy’s stratagems."},{"id":"seytek-2012:p0520:b003:l026","ordinal":333463,"en":"He was a champion apart;"},{"id":"seytek-2012:p0520:b003:l027","ordinal":333464,"en":"Behold, the gray wolf Choro bore"},{"id":"seytek-2012:p0520:b003:l028","ordinal":333465,"en":"The weight of Mount Kap."},{"id":"seytek-2012:p0520:b003:l029","ordinal":333466,"en":"Sarybai faced him"},{"id":"seytek-2012:p0520:b003:l030","ordinal":333467,"en":"And struck with wild abandon."},{"id":"seytek-2012:p0520:b003:l031","ordinal":333468,"en":"When Zhelmaian’s head was turned,"},{"id":"seytek-2012:p0520:b003:l032","ordinal":333469,"en":"And Sarybai swung his mace,"},{"id":"seytek-2012:p0520:b003:l033","ordinal":333470,"en":"Külüstön, upheld by the ancestral spirits,"},{"id":"seytek-2012:p0520:b003:l034","ordinal":333471,"en":"Did not flinch at its ringing blows;"},{"id":"seytek-2012:p0520:b003:l035","ordinal":333472,"en":"He valued Sarybai’s attack"},{"id":"seytek-2012:p0520:b003:l036","ordinal":333473,"en":"No more than the hem of his robe."},{"id":"seytek-2012:p0520:b003:l037","ordinal":333474,"en":"He neither swayed nor stirred;"},{"id":"seytek-2012:p0520:b003:l038","ordinal":333475,"en":"The poor hero upheld by the ancestral spirits"},{"id":"seytek-2012:p0520:b003:l039","ordinal":333476,"en":"Did not move even when his gear was spent."},{"id":"seytek-2012:p0520:b003:l040","ordinal":333477,"en":"He turned his courser’s head,"},{"id":"seytek-2012:p0521:b002:l001","ordinal":333478,"en":"He was a lone-born wolf indeed."},{"id":"seytek-2012:p0521:b002:l002","ordinal":333479,"en":"He was an ocean, a worthy equal,"},{"id":"seytek-2012:p0521:b002:l003","ordinal":333480,"en":"A true gray-wolf hero."},{"id":"seytek-2012:p0521:b002:l004","ordinal":333481,"en":"“Ever since I became Sarybai,"},{"id":"seytek-2012:p0521:b002:l005","ordinal":333482,"en":"Ever since Sarybai mounted a horse,"},{"id":"seytek-2012:p0521:b002:l006","ordinal":333483,"en":"No desert has remained untrodden by me,"},{"id":"seytek-2012:p0521:b002:l007","ordinal":333484,"en":"No people unseen by me."},{"id":"seytek-2012:p0521:b002:l008","ordinal":333485,"en":"I wandered through many lands,"},{"id":"seytek-2012:p0521:b002:l009","ordinal":333486,"en":"Conquering this multitude,"},{"id":"seytek-2012:p0521:b002:l010","ordinal":333487,"en":"Making people scream."},{"id":"seytek-2012:p0521:b002:l011","ordinal":333488,"en":"Those who claimed to be warriors and giants,"},{"id":"seytek-2012:p0521:b002:l012","ordinal":333489,"en":"Who called themselves masters of the earth—"},{"id":"seytek-2012:p0521:b002:l013","ordinal":333490,"en":"I slaughtered many such champions."},{"id":"seytek-2012:p0521:b002:l014","ordinal":333491,"en":"Never among all those have I seen his like;"},{"id":"seytek-2012:p0521:b002:l015","ordinal":333492,"en":"He is truly mighty, truly a hero!”"},{"id":"seytek-2012:p0521:b002:l016","ordinal":333493,"en":"So saying, Sarybai"},{"id":"seytek-2012:p0521:b002:l017","ordinal":333494,"en":"Tested his valor"},{"id":"seytek-2012:p0521:b002:l018","ordinal":333495,"en":"And brought down a mountain’s weight."},{"id":"seytek-2012:p0521:b002:l019","ordinal":333496,"en":"The spear blazed and became an ember;"},{"id":"seytek-2012:p0521:b002:l020","ordinal":333497,"en":"When Külchoro thrust his spear,"},{"id":"seytek-2012:p0521:b002:l021","ordinal":333498,"en":"Sarybai stood fast and endured it."},{"id":"seytek-2012:p0521:b002:l022","ordinal":333499,"en":"Then Külchoro said:"},{"id":"seytek-2012:p0521:b002:l023","ordinal":333500,"en":"“If God delivers the slave to me,”"},{"id":"seytek-2012:p0521:b002:l024","ordinal":333501,"en":"And, holding this thought,"},{"id":"seytek-2012:p0521:b002:l025","ordinal":333502,"en":"Külchoro aimed without withdrawing his spear,"},{"id":"seytek-2012:p0521:b002:l026","ordinal":333503,"en":"And at that infidel Sarybai"},{"id":"seytek-2012:p0521:b002:l027","ordinal":333504,"en":"He thrust sixty times."},{"id":"seytek-2012:p0521:b002:l028","ordinal":333505,"en":"Sarybai rang but paid no heed,"},{"id":"seytek-2012:p0521:b002:l029","ordinal":333506,"en":"Valuing sixty spear thrusts"},{"id":"seytek-2012:p0521:b002:l030","ordinal":333507,"en":"No more than the hem of his robe,"},{"id":"seytek-2012:p0521:b002:l031","ordinal":333508,"en":"Then found a desperate stratagem."},{"id":"seytek-2012:p0521:b002:l032","ordinal":333509,"en":"He struck Külchoro’s spear"},{"id":"seytek-2012:p0521:b002:l033","ordinal":333510,"en":"Across the middle of its shaft."},{"id":"seytek-2012:p0521:b002:l034","ordinal":333511,"en":"The spear broke and was rendered useless;"},{"id":"seytek-2012:p0521:b002:l035","ordinal":333512,"en":"Splintering across the middle,"},{"id":"seytek-2012:p0521:b002:l036","ordinal":333513,"en":"Külchoro’s ornamented spear"},{"id":"seytek-2012:p0521:b002:l037","ordinal":333514,"en":"Whirled shrieking into the sky."},{"id":"seytek-2012:p0521:b002:l038","ordinal":333515,"en":"That gray wolf Külchoro"},{"id":"seytek-2012:p0521:b002:l039","ordinal":333516,"en":"Had his weapon and his beloved;"},{"id":"seytek-2012:p0521:b002:l040","ordinal":333517,"en":"Such strength did the gray wolf possess."},{"id":"seytek-2012:p0521:b003:l001","ordinal":333518,"en":"Its point had been forged in steel"},{"id":"seytek-2012:p0521:b003:l002","ordinal":333519,"en":"That it might pierce wherever it struck,"},{"id":"seytek-2012:p0521:b003:l003","ordinal":333520,"en":"And rip apart wherever it was thrust;"},{"id":"seytek-2012:p0521:b003:l004","ordinal":333521,"en":"Should it chance to hit its mark,"},{"id":"seytek-2012:p0521:b003:l005","ordinal":333522,"en":"It would cut through to the far side."},{"id":"seytek-2012:p0521:b003:l006","ordinal":333523,"en":"Thus had it been fashioned."},{"id":"seytek-2012:p0521:b003:l007","ordinal":333524,"en":"Its point had been forged in steel,"},{"id":"seytek-2012:p0521:b003:l008","ordinal":333525,"en":"And tempered sixty times"},{"id":"seytek-2012:p0521:b003:l009","ordinal":333526,"en":"In a dragon’s venom."},{"id":"seytek-2012:p0521:b003:l010","ordinal":333527,"en":"Death is common to all—this was its fire;"},{"id":"seytek-2012:p0521:b003:l011","ordinal":333528,"en":"Such was the nature of the spear."},{"id":"seytek-2012:p0521:b003:l012","ordinal":333529,"en":"He aimed at the measured spot,"},{"id":"seytek-2012:p0521:b003:l013","ordinal":333530,"en":"And valiant hero Külchoro"},{"id":"seytek-2012:p0521:b003:l014","ordinal":333531,"en":"Thrust and stabbed Sarybai."},{"id":"seytek-2012:p0521:b003:l015","ordinal":333532,"en":"Choro began his furious assault;"},{"id":"seytek-2012:p0521:b003:l016","ordinal":333533,"en":"With both coat fronts flapping,"},{"id":"seytek-2012:p0521:b003:l017","ordinal":333534,"en":"Sarybai nearly tumbled"},{"id":"seytek-2012:p0521:b003:l018","ordinal":333535,"en":"From Zhelmaian."},{"id":"seytek-2012:p0521:b003:l019","ordinal":333536,"en":"Zhelmaian staggered,"},{"id":"seytek-2012:p0521:b003:l020","ordinal":333537,"en":"And Sarybai stood pale,"},{"id":"seytek-2012:p0521:b003:l021","ordinal":333538,"en":"Marvelling at Külchoro:"},{"id":"seytek-2012:p0521:b003:l022","ordinal":333539,"en":"“He is renowned, a mountain indeed,"},{"id":"seytek-2012:p0521:b003:l023","ordinal":333540,"en":"A renowned gray-wolf hero."},{"id":"seytek-2012:p0521:b003:l024","ordinal":333541,"en":"Thick-armed and stone-hearted,"},{"id":"seytek-2012:p0521:b003:l025","ordinal":333542,"en":"A broad fellow with an elephant’s frame."},{"id":"seytek-2012:p0521:b003:l026","ordinal":333543,"en":"Against any rival or enemy"},{"id":"seytek-2012:p0521:b003:l027","ordinal":333544,"en":"He can unleash great havoc."},{"id":"seytek-2012:p0521:b003:l028","ordinal":333545,"en":"He is a warrior and a hero,"},{"id":"seytek-2012:p0521:b003:l029","ordinal":333546,"en":"A singularly born champion."},{"id":"seytek-2012:p0521:b003:l030","ordinal":333547,"en":"His weight is heavy and his venom strong;"},{"id":"seytek-2012:p0521:b003:l031","ordinal":333548,"en":"He surpasses the whole world.”"},{"id":"seytek-2012:p0521:b003:l032","ordinal":333549,"en":"He began a fierce assault,"},{"id":"seytek-2012:p0521:b003:l033","ordinal":333550,"en":"But when Sarybai struck mightily,"},{"id":"seytek-2012:p0521:b003:l034","ordinal":333551,"en":"He nearly fell away."},{"id":"seytek-2012:p0521:b003:l035","ordinal":333552,"en":"“What thick-muscled creature is this?"},{"id":"seytek-2012:p0521:b003:l036","ordinal":333553,"en":"No such man appears in an age."},{"id":"seytek-2012:p0521:b003:l037","ordinal":333554,"en":"I barely stopped myself with a cry;"},{"id":"seytek-2012:p0521:b003:l038","ordinal":333555,"en":"My soul nearly leapt from my breast."},{"id":"seytek-2012:p0521:b003:l039","ordinal":333556,"en":"He is hard as blue iron,"},{"id":"seytek-2012:p0521:b003:l040","ordinal":333557,"en":"One who has destroyed many men,"},{"id":"seytek-2012:p0522:b002:l001","ordinal":333558,"en":"Yet he had no thought of dying."},{"id":"seytek-2012:p0522:b002:l002","ordinal":333559,"en":"The steel shield upon his head"},{"id":"seytek-2012:p0522:b002:l003","ordinal":333560,"en":"Shattered and burst into sparks."},{"id":"seytek-2012:p0522:b002:l004","ordinal":333561,"en":"That infidel son of the Ogre"},{"id":"seytek-2012:p0522:b002:l005","ordinal":333562,"en":"Survived even this and stood fast."},{"id":"seytek-2012:p0522:b002:l006","ordinal":333563,"en":"Sarybai grew fearsome"},{"id":"seytek-2012:p0522:b002:l007","ordinal":333564,"en":"And began his true scourging."},{"id":"seytek-2012:p0522:b002:l008","ordinal":333565,"en":"Overturning mountains and draining lakes,"},{"id":"seytek-2012:p0522:b002:l009","ordinal":333566,"en":"He wrought fierce deeds without pause."},{"id":"seytek-2012:p0522:b002:l010","ordinal":333567,"en":"He consumed all who crossed him;"},{"id":"seytek-2012:p0522:b002:l011","ordinal":333568,"en":"Only the unbroken black earth"}]
