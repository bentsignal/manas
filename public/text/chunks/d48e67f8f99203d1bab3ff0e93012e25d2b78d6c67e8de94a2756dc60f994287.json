[{"id":"manas-2010:p1031:b001:l013","ordinal":45057,"en":"He intervened and separated them."},{"id":"manas-2010:p1031:b001:l014","ordinal":45058,"en":"While Manas held them,"},{"id":"manas-2010:p1031:b001:l015","ordinal":45059,"en":"Struggling in fury,"},{"id":"manas-2010:p1031:b001:l016","ordinal":45060,"en":"Hero Chubak grew bolder:"},{"id":"manas-2010:p1031:b001:l017","ordinal":45061,"en":"“Chinese from Khangay!” he shouted,"},{"id":"manas-2010:p1031:b001:l018","ordinal":45062,"en":"Working himself up and struggling."},{"id":"manas-2010:p1031:b001:l019","ordinal":45063,"en":"Then Azizkan's Almambet said:"},{"id":"manas-2010:p1031:b001:l020","ordinal":45064,"en":"“Let me spill the villain's blood,"},{"id":"manas-2010:p1031:b001:l021","ordinal":45065,"en":"Let me open his stubbornly shut eyes!"},{"id":"manas-2010:p1031:b001:l022","ordinal":45066,"en":"Let go your hand!”"},{"id":"manas-2010:p1031:b001:l023","ordinal":45067,"en":"On the right, Almambet stood thundering."},{"id":"manas-2010:p1031:b001:l024","ordinal":45068,"en":"Blue-maned Khan Manas, lord of battle,"},{"id":"manas-2010:p1031:b001:l025","ordinal":45069,"en":"Held them and rebuked them:"},{"id":"manas-2010:p1031:b001:l026","ordinal":45070,"en":"“The two lions who will raid the governor"},{"id":"manas-2010:p1031:b001:l027","ordinal":45071,"en":"May suddenly be killed!”"},{"id":"manas-2010:p1031:b001:l028","ordinal":45072,"en":"His heart burned with grief:"},{"id":"manas-2010:p1031:b001:l029","ordinal":45073,"en":"“A lone man is left on foot;"},{"id":"manas-2010:p1031:b001:l030","ordinal":45074,"en":"Why does God create a lone man?"},{"id":"manas-2010:p1031:b001:l031","ordinal":45075,"en":"What if He had not made him at all?!"},{"id":"manas-2010:p1031:b001:l032","ordinal":45076,"en":"See the decree of God,"},{"id":"manas-2010:p1031:b001:l033","ordinal":45077,"en":"Who lets a hawk devour a swan!"},{"id":"manas-2010:p1031:b001:l034","ordinal":45078,"en":"They are not children of one womb,"},{"id":"manas-2010:p1031:b001:l035","ordinal":45079,"en":"Yet Almambet and Chubak"},{"id":"manas-2010:p1031:b001:l036","ordinal":45080,"en":"He has made men call brothers."},{"id":"manas-2010:p1031:b001:l037","ordinal":45081,"en":"Two senseless villains,"},{"id":"manas-2010:p1031:b001:l038","ordinal":45082,"en":"Fighting till they turn deathly pale—"},{"id":"manas-2010:p1031:b001:l039","ordinal":45083,"en":"Do you see how impossible they are?!"},{"id":"manas-2010:p1031:b001:l040","ordinal":45084,"en":"Magnifying worthless words,"},{"id":"manas-2010:p1031:b001:l041","ordinal":45085,"en":"Do you see how wretchedly they act?!"},{"id":"manas-2010:p1031:b001:l042","ordinal":45086,"en":"My openhearted soul"},{"id":"manas-2010:p1032:b001:l001","ordinal":45087,"en":"You have understood from the start."},{"id":"manas-2010:p1032:b001:l002","ordinal":45088,"en":"Stirring up a quarrel between you,"},{"id":"manas-2010:p1032:b001:l003","ordinal":45089,"en":"Upsetting my heart, you two villains,"},{"id":"manas-2010:p1032:b001:l004","ordinal":45090,"en":"Back to your land of Talas"},{"id":"manas-2010:p1032:b001:l005","ordinal":45091,"en":"You are planning to go."},{"id":"manas-2010:p1032:b001:l006","ordinal":45092,"en":"Pretending to clash along the road,"},{"id":"manas-2010:p1032:b001:l007","ordinal":45093,"en":"You mean to slip away."},{"id":"manas-2010:p1032:b001:l008","ordinal":45094,"en":"Using trifling words as a pretext,"},{"id":"manas-2010:p1032:b001:l009","ordinal":45095,"en":"You two witless, reckless villains,"},{"id":"manas-2010:p1032:b001:l010","ordinal":45096,"en":"You mean to leave!"},{"id":"manas-2010:p1032:b001:l011","ordinal":45097,"en":"My assembled army"},{"id":"manas-2010:p1032:b001:l012","ordinal":45098,"en":"You mean to scatter;"},{"id":"manas-2010:p1032:b001:l013","ordinal":45099,"en":"Chasing each other as a pretext,"},{"id":"manas-2010:p1032:b001:l014","ordinal":45100,"en":"You two ruined lions,"},{"id":"manas-2010:p1032:b001:l015","ordinal":45101,"en":"You mean to flee!"},{"id":"manas-2010:p1032:b001:l016","ordinal":45102,"en":"Turning back toward Talas,"},{"id":"manas-2010:p1032:b001:l017","ordinal":45103,"en":"Your horses' heads, you two lions,"},{"id":"manas-2010:p1032:b001:l018","ordinal":45104,"en":"You mean to turn."},{"id":"manas-2010:p1032:b001:l019","ordinal":45105,"en":"To this Manas, lord of battle,"},{"id":"manas-2010:p1032:b001:l020","ordinal":45106,"en":"You mean to do this!"},{"id":"manas-2010:p1032:b001:l021","ordinal":45107,"en":"The gold coins in my treasury"},{"id":"manas-2010:p1032:b001:l022","ordinal":45108,"en":"You mean to squander!"},{"id":"manas-2010:p1032:b001:l023","ordinal":45109,"en":"Turning back toward Talas,"},{"id":"manas-2010:p1032:b001:l024","ordinal":45110,"en":"You two black-hearted villains,"},{"id":"manas-2010:p1032:b001:l025","ordinal":45111,"en":"You mean to flee!"},{"id":"manas-2010:p1032:b001:l026","ordinal":45112,"en":"To launch an attack on Beijing"},{"id":"manas-2010:p1032:b001:l027","ordinal":45113,"en":"Was the purpose in my heart."},{"id":"manas-2010:p1032:b001:l028","ordinal":45114,"en":"Forty companions, fierce wolves,"},{"id":"manas-2010:p1032:b001:l029","ordinal":45115,"en":"Forty dogs from forty different places were you!"},{"id":"manas-2010:p1032:b001:l030","ordinal":45116,"en":"Wandering, destitute, from afar,"},{"id":"manas-2010:p1032:b001:l031","ordinal":45117,"en":"Some of you came without horses."},{"id":"manas-2010:p1032:b001:l032","ordinal":45118,"en":"For the companion who came horseless,"},{"id":"manas-2010:p1032:b001:l033","ordinal":45119,"en":"With wild-sheep legs and copper forelegs,"},{"id":"manas-2010:p1032:b001:l034","ordinal":45120,"en":"I provided a steed among horses."},{"id":"manas-2010:p1032:b001:l035","ordinal":45121,"en":"Worn out from afar,"},{"id":"manas-2010:p1032:b001:l036","ordinal":45122,"en":"A companion came from the crowd."},{"id":"manas-2010:p1032:b001:l037","ordinal":45123,"en":"The companion who came in rags"},{"id":"manas-2010:p1032:b001:l038","ordinal":45124,"en":"I clothed in the finest robe."},{"id":"manas-2010:p1032:b001:l039","ordinal":45125,"en":"Argyn, Nogay and Kyrgyz"},{"id":"manas-2010:p1032:b001:l040","ordinal":45126,"en":"I made acknowledge your authority."},{"id":"manas-2010:p1032:b001:l041","ordinal":45127,"en":"Quarreling over the road between you,"},{"id":"manas-2010:p1032:b001:l042","ordinal":45128,"en":"Almambet, Chubak, you have burned me beyond measure!"},{"id":"manas-2010:p1033:b001:l001","ordinal":45129,"en":"Formerly, beside broad Talas,"},{"id":"manas-2010:p1033:b001:l002","ordinal":45130,"en":"I would slice and eat horse-rump meat."},{"id":"manas-2010:p1033:b001:l003","ordinal":45131,"en":"‘If Almambet is beside me,"},{"id":"manas-2010:p1033:b001:l004","ordinal":45132,"en":"I can shatter the world,’ I would say."},{"id":"manas-2010:p1033:b001:l005","ordinal":45133,"en":"Brandishing my smooth spear,"},{"id":"manas-2010:p1033:b001:l006","ordinal":45134,"en":"‘I shall fight,’ I would say."},{"id":"manas-2010:p1033:b001:l007","ordinal":45135,"en":"‘With the governor and Kongurbay"},{"id":"manas-2010:p1033:b001:l008","ordinal":45136,"en":"I shall clash,’ I would say."},{"id":"manas-2010:p1033:b001:l009","ordinal":45137,"en":"‘Armor no shot can pierce"},{"id":"manas-2010:p1033:b001:l010","ordinal":45138,"en":"I shall put on,’ I would say."},{"id":"manas-2010:p1033:b001:l011","ordinal":45139,"en":"‘While my great Almambet is here,"},{"id":"manas-2010:p1033:b001:l012","ordinal":45140,"en":"Against all eighteen thousand worlds"},{"id":"manas-2010:p1033:b001:l013","ordinal":45141,"en":"I shall march,’ I would say."},{"id":"manas-2010:p1033:b001:l014","ordinal":45142,"en":"Almambet, Chubak, because of you,"},{"id":"manas-2010:p1033:b001:l015","ordinal":45143,"en":"Because you two villains were there,"},{"id":"manas-2010:p1033:b001:l016","ordinal":45144,"en":"I settled the land at Keng-Kol."},{"id":"manas-2010:p1033:b001:l017","ordinal":45145,"en":"Because you two villains were there,"},{"id":"manas-2010:p1033:b001:l018","ordinal":45146,"en":"Twelve khans and many peoples"},{"id":"manas-2010:p1033:b001:l019","ordinal":45147,"en":"I drove here under guard."},{"id":"manas-2010:p1033:b001:l020","ordinal":45148,"en":"To Beijing, where the Prophet would not go,"},{"id":"manas-2010:p1033:b001:l021","ordinal":45149,"en":"To survey and cross its road,"},{"id":"manas-2010:p1033:b001:l022","ordinal":45150,"en":"Almambet, Chubak, two warriors,"},{"id":"manas-2010:p1033:b001:l023","ordinal":45151,"en":"To relieve your age-old anguish,"},{"id":"manas-2010:p1033:b001:l024","ordinal":45152,"en":"I brought you from afar."},{"id":"manas-2010:p1033:b001:l025","ordinal":45153,"en":"Now you grapple halfway there,"},{"id":"manas-2010:p1033:b001:l026","ordinal":45154,"en":"You two senseless villains!"},{"id":"manas-2010:p1033:b001:l027","ordinal":45155,"en":"Could there be other men like you?"},{"id":"manas-2010:p1033:b001:l028","ordinal":45156,"en":"You have destroyed my composure now,"},{"id":"manas-2010:p1033:b001:l029","ordinal":45157,"en":"Bringing harm upon my people."},{"id":"manas-2010:p1033:b001:l030","ordinal":45158,"en":"To the great host of Muslims"},{"id":"manas-2010:p1033:b001:l031","ordinal":45159,"en":"If I do not send word in return,"},{"id":"manas-2010:p1033:b001:l032","ordinal":45160,"en":"Commanding my people,"},{"id":"manas-2010:p1033:b001:l033","ordinal":45161,"en":"If I do not go to Beijing without you,"},{"id":"manas-2010:p1033:b001:l034","ordinal":45162,"en":"If I do not gather my reins,"},{"id":"manas-2010:p1033:b001:l035","ordinal":45163,"en":"To Beijing, where Chalyar would not go,"},{"id":"manas-2010:p1033:b001:l036","ordinal":45164,"en":"Until the swaying dry stalks ripen,"},{"id":"manas-2010:p1033:b001:l037","ordinal":45165,"en":"Until the autumn gossamer flies,"},{"id":"manas-2010:p1033:b001:l038","ordinal":45166,"en":"Fighting hard for six months,"},{"id":"manas-2010:p1033:b001:l039","ordinal":45167,"en":"If I do not attack Beijing—"},{"id":"manas-2010:p1033:b001:l040","ordinal":45168,"en":"To this Beijing before us"},{"id":"manas-2010:p1033:b001:l041","ordinal":45169,"en":"Let me go alone!"},{"id":"manas-2010:p1033:b001:l042","ordinal":45170,"en":"You two unthinking villains,"},{"id":"manas-2010:p1034:b001:l001","ordinal":45171,"en":"Let me truly bring about your ruin!"},{"id":"manas-2010:p1034:b001:l002","ordinal":45172,"en":"If my appointed death is among the Chinese,"},{"id":"manas-2010:p1034:b001:l003","ordinal":45173,"en":"Let me go alone and die!"},{"id":"manas-2010:p1034:b001:l004","ordinal":45174,"en":"You two howling slaves,"},{"id":"manas-2010:p1034:b001:l005","ordinal":45175,"en":"Kill each other, then, let me see!”"},{"id":"manas-2010:p1034:b001:l006","ordinal":45176,"en":"Almambet at his right"},{"id":"manas-2010:p1034:b001:l007","ordinal":45177,"en":"He thrust away to the right;"},{"id":"manas-2010:p1034:b001:l008","ordinal":45178,"en":"Chubak at his left"},{"id":"manas-2010:p1034:b001:l009","ordinal":45179,"en":"He thrust away to the left."},{"id":"manas-2010:p1034:b001:l010","ordinal":45180,"en":"The hair bristled upon his face."},{"id":"manas-2010:p1034:b001:l011","ordinal":45181,"en":"Against the Chinese in deepest Beijing,"},{"id":"manas-2010:p1034:b001:l012","ordinal":45182,"en":"Your blue-maned falcon Manas"},{"id":"manas-2010:p1034:b001:l013","ordinal":45183,"en":"Seemed ready to strike alone,"},{"id":"manas-2010:p1034:b001:l014","ordinal":45184,"en":"The Chinese multitudes"},{"id":"manas-2010:p1034:b001:l015","ordinal":45185,"en":"He seemed set to drive, stiff with terror."},{"id":"manas-2010:p1034:b001:l016","ordinal":45186,"en":"That Manas, your lord of battle,"},{"id":"manas-2010:p1034:b001:l017","ordinal":45187,"en":"Seemed ready to go in alone,"},{"id":"manas-2010:p1034:b001:l018","ordinal":45188,"en":"And the world's countless Chinese"},{"id":"manas-2010:p1034:b001:l019","ordinal":45189,"en":"Drive back in scattered throngs."},{"id":"manas-2010:p1034:b001:l020","ordinal":45190,"en":"Never shrinking from hardship,"},{"id":"manas-2010:p1034:b001:l021","ordinal":45191,"en":"Firing shots at eleven,"},{"id":"manas-2010:p1034:b001:l022","ordinal":45192,"en":"When he reached twelve,"},{"id":"manas-2010:p1034:b001:l023","ordinal":45193,"en":"Named the mighty Manas,"},{"id":"manas-2010:p1034:b001:l024","ordinal":45194,"en":"When he reached thirteen,"},{"id":"manas-2010:p1034:b001:l025","ordinal":45195,"en":"Raiding settled peoples and their courts,"},{"id":"manas-2010:p1034:b001:l026","ordinal":45196,"en":"When he reached fifteen,"},{"id":"manas-2010:p1034:b001:l027","ordinal":45197,"en":"Guarding his people from even the wind,"},{"id":"manas-2010:p1034:b001:l028","ordinal":45198,"en":"He filled himself with terrible wrath."},{"id":"manas-2010:p1034:b001:l029","ordinal":45199,"en":"Grieved by these two,"},{"id":"manas-2010:p1034:b001:l030","ordinal":45200,"en":"Onto a dark ridge's rise"},{"id":"manas-2010:p1034:b001:l031","ordinal":45201,"en":"Your blue-maned leopard Manas"},{"id":"manas-2010:p1034:b001:l032","ordinal":45202,"en":"Went alone and sat."},{"id":"manas-2010:p1034:b001:l033","ordinal":45203,"en":"Akbaltay's Chubak,"},{"id":"manas-2010:p1034:b001:l034","ordinal":45204,"en":"As though guilt had fallen on his neck,"},{"id":"manas-2010:p1034:b001:l035","ordinal":45205,"en":"Seemed to have drawn back."},{"id":"manas-2010:p1034:b001:l036","ordinal":45206,"en":"The devil left his temper;"},{"id":"manas-2010:p1034:b001:l037","ordinal":45207,"en":"He seemed to have softened."},{"id":"manas-2010:p1034:b001:l038","ordinal":45208,"en":"Akbaltay's Chubak"},{"id":"manas-2010:p1034:b001:l039","ordinal":45209,"en":"Now turned his face, subdued."},{"id":"manas-2010:p1034:b001:l040","ordinal":45210,"en":"Before the great warrior Almambet"},{"id":"manas-2010:p1034:b001:l041","ordinal":45211,"en":"He now stood ashamed."},{"id":"manas-2010:p1034:b001:l042","ordinal":45212,"en":"What else but shame could it be?"},{"id":"manas-2010:p1035:b001:l001","ordinal":45213,"en":"He now spoke these words:"},{"id":"manas-2010:p1035:b001:l002","ordinal":45214,"en":"“Sovereign Almambet, the champion,"},{"id":"manas-2010:p1035:b001:l003","ordinal":45215,"en":"I shouted at, calling him Chinese;"},{"id":"manas-2010:p1035:b001:l004","ordinal":45216,"en":"I rode after him in pursuit."},{"id":"manas-2010:p1035:b001:l005","ordinal":45217,"en":"When I consider it, mine is a great disgrace!"},{"id":"manas-2010:p1035:b001:l006","ordinal":45218,"en":"If you scout, here is the road;"},{"id":"manas-2010:p1035:b001:l007","ordinal":45219,"en":"If you bind me, here are my hands;"},{"id":"manas-2010:p1035:b001:l008","ordinal":45220,"en":"If you cast me in, here is the pit;"},{"id":"manas-2010:p1035:b001:l009","ordinal":45221,"en":"Here is brine in which to boil me!"},{"id":"manas-2010:p1035:b001:l010","ordinal":45222,"en":"If you cut off my head, here I am;"},{"id":"manas-2010:p1035:b001:l011","ordinal":45223,"en":"If you spill my blood, here is the earth!"},{"id":"manas-2010:p1035:b001:l012","ordinal":45224,"en":"Joined while still within the womb."},{"id":"manas-2010:p1035:b001:l013","ordinal":45225,"en":"Supported each other on sorrowful days,"},{"id":"manas-2010:p1035:b001:l014","ordinal":45226,"en":"Lived together and grew together,"},{"id":"manas-2010:p1035:b001:l015","ordinal":45227,"en":"Met amid the enemy facing us."},{"id":"manas-2010:p1035:b001:l016","ordinal":45228,"en":"If you will kill me, here is your slave!"},{"id":"manas-2010:p1035:b001:l017","ordinal":45229,"en":"My transgression is greater than a mountain;"},{"id":"manas-2010:p1035:b001:l018","ordinal":45230,"en":"My mighty Almambet, forgive it!"},{"id":"manas-2010:p1035:b001:l019","ordinal":45231,"en":"My dark eyes are yours to dispose of;"},{"id":"manas-2010:p1035:b001:l020","ordinal":45232,"en":"Not merely Kögala, Almambet,"},{"id":"manas-2010:p1035:b001:l021","ordinal":45233,"en":"My own head is an offering to you!”"},{"id":"manas-2010:p1035:b001:l022","ordinal":45234,"en":"Turning back in distress,"},{"id":"manas-2010:p1035:b001:l023","ordinal":45235,"en":"The deerskin lead-rope"},{"id":"manas-2010:p1035:b001:l024","ordinal":45236,"en":"He placed about his neck."},{"id":"manas-2010:p1035:b001:l025","ordinal":45237,"en":"Hero Chubak dismounted,"},{"id":"manas-2010:p1035:b001:l026","ordinal":45238,"en":"And ran toward Almambet:"},{"id":"manas-2010:p1035:b001:l027","ordinal":45239,"en":"“Forgive my sin, champion!” he said,"},{"id":"manas-2010:p1035:b001:l028","ordinal":45240,"en":"His knees bending to the earth,"},{"id":"manas-2010:p1035:b001:l029","ordinal":45241,"en":"His two hands against his breast,"},{"id":"manas-2010:p1035:b001:l030","ordinal":45242,"en":"His warrior's equipment at his side,"},{"id":"manas-2010:p1035:b001:l031","ordinal":45243,"en":"Leading Kögala,"},{"id":"manas-2010:p1035:b001:l032","ordinal":45244,"en":"Pleading, “Forgive my sin,”"},{"id":"manas-2010:p1035:b001:l033","ordinal":45245,"en":"He now came to Almambet."},{"id":"manas-2010:p1035:b001:l034","ordinal":45246,"en":"Almambet was satisfied;"},{"id":"manas-2010:p1035:b001:l035","ordinal":45247,"en":"No rancor remained inside him."},{"id":"manas-2010:p1035:b001:l036","ordinal":45248,"en":"Your great, blue-maned Almambet"},{"id":"manas-2010:p1035:b001:l037","ordinal":45249,"en":"Then spoke these words:"},{"id":"manas-2010:p1035:b001:l038","ordinal":45250,"en":"“Hero Chubak, the khan's son,"},{"id":"manas-2010:p1035:b001:l039","ordinal":45251,"en":"Was a man of sacred worth."},{"id":"manas-2010:p1035:b001:l040","ordinal":45252,"en":"‘To Beijing in the Chinese realm,"},{"id":"manas-2010:p1035:b001:l041","ordinal":45253,"en":"Take me along as your companion,"},{"id":"manas-2010:p1035:b001:l042","ordinal":45254,"en":"He had said to me."},{"id":"manas-2010:p1036:b001:l001","ordinal":45255,"en":"My going scouting alone,"},{"id":"manas-2010:p1036:b001:l002","ordinal":45256,"en":"Leaving Chubak uninformed—"},{"id":"manas-2010:p1036:b001:l003","ordinal":45257,"en":"When I consider it, my conduct is shameful.”"},{"id":"manas-2010:p1036:b001:l004","ordinal":45258,"en":"Leading Sarala,"},{"id":"manas-2010:p1036:b001:l005","ordinal":45259,"en":"He ran toward Chubak,"},{"id":"manas-2010:p1036:b001:l006","ordinal":45260,"en":"Placing his whip about his neck."},{"id":"manas-2010:p1036:b001:l007","ordinal":45261,"en":"“Forgive my sin!” he said;"},{"id":"manas-2010:p1036:b001:l008","ordinal":45262,"en":"Almambet stood bowing before Chubak."},{"id":"manas-2010:p1036:b001:l009","ordinal":45263,"en":"“Never recoiling from fire,"},{"id":"manas-2010:p1036:b001:l010","ordinal":45264,"en":"Never fleeing from death,"},{"id":"manas-2010:p1036:b001:l011","ordinal":45265,"en":"Those two villains born witless—"},{"id":"manas-2010:p1036:b001:l012","ordinal":45266,"en":"Are they killing each other?” he wondered."},{"id":"manas-2010:p1036:b001:l013","ordinal":45267,"en":"“Have the two villains grappled"},{"id":"manas-2010:p1036:b001:l014","ordinal":45268,"en":"And brought disaster upon us?"},{"id":"manas-2010:p1036:b001:l015","ordinal":45269,"en":"Have they fought with all their fury,"},{"id":"manas-2010:p1036:b001:l016","ordinal":45270,"en":"Drenched their heads in blood,"},{"id":"manas-2010:p1036:b001:l017","ordinal":45271,"en":"And torn each other to pieces?”"},{"id":"manas-2010:p1036:b001:l018","ordinal":45272,"en":"Hero Manas, your sovereign,"},{"id":"manas-2010:p1036:b001:l019","ordinal":45273,"en":"Held himself tall, not looking straight at them,"},{"id":"manas-2010:p1036:b001:l020","ordinal":45274,"en":"But cast a sidelong glance, sitting grandly."},{"id":"manas-2010:p1036:b001:l021","ordinal":45275,"en":"Like the stars in heaven"},{"id":"manas-2010:p1036:b001:l022","ordinal":45276,"en":"They were stirring together now."},{"id":"manas-2010:p1036:b001:l023","ordinal":45277,"en":"Almambet and Chubak, the two warriors,"},{"id":"manas-2010:p1036:b001:l024","ordinal":45278,"en":"Unstinting into the afterlife,"},{"id":"manas-2010:p1036:b001:l025","ordinal":45279,"en":"Had become friends."},{"id":"manas-2010:p1036:b001:l026","ordinal":45280,"en":"Like a white antelope's hairs,"},{"id":"manas-2010:p1036:b001:l027","ordinal":45281,"en":"They had drawn together;"},{"id":"manas-2010:p1036:b001:l028","ordinal":45282,"en":"Like white wheat flour,"},{"id":"manas-2010:p1036:b001:l029","ordinal":45283,"en":"They had been kneaded together;"},{"id":"manas-2010:p1036:b001:l030","ordinal":45284,"en":"Like springs upon the hills,"},{"id":"manas-2010:p1036:b001:l031","ordinal":45285,"en":"They had flowed together."},{"id":"manas-2010:p1036:b001:l032","ordinal":45286,"en":"Offering horses, the two lions,"},{"id":"manas-2010:p1036:b001:l033","ordinal":45287,"en":"Making peace without reserve,"},{"id":"manas-2010:p1036:b001:l034","ordinal":45288,"en":"Had joined together."},{"id":"manas-2010:p1036:b001:l035","ordinal":45289,"en":"Almambet and Chubak conferred;"},{"id":"manas-2010:p1036:b001:l036","ordinal":45290,"en":"The two warriors stood troubled:"},{"id":"manas-2010:p1036:b001:l037","ordinal":45291,"en":"“To the watching lord of battle,"},{"id":"manas-2010:p1036:b001:l038","ordinal":45292,"en":"No one answers back and prospers."},{"id":"manas-2010:p1036:b001:l039","ordinal":45293,"en":"A man who falls under his wrath"},{"id":"manas-2010:p1036:b001:l040","ordinal":45294,"en":"Will never become two."},{"id":"manas-2010:p1036:b001:l041","ordinal":45295,"en":"The vast peoples of the earth,"},{"id":"manas-2010:p1036:b001:l042","ordinal":45296,"en":"Even if we gathered them all,"},{"id":"manas-2010:p1037:b001:l001","ordinal":45297,"en":"Would not equal one Manas."},{"id":"manas-2010:p1037:b001:l002","ordinal":45298,"en":"When forty leopards trotted from the cliffs,"},{"id":"manas-2010:p1037:b001:l003","ordinal":45299,"en":"When forty companions wandered from forty places,"},{"id":"manas-2010:p1037:b001:l004","ordinal":45300,"en":"He gave us Talas for our land."},{"id":"manas-2010:p1037:b001:l005","ordinal":45301,"en":"Seasoning us against shouting foes,"},{"id":"manas-2010:p1037:b001:l006","ordinal":45302,"en":"Drenching us in red blood,"},{"id":"manas-2010:p1037:b001:l007","ordinal":45303,"en":"He made us all warriors."},{"id":"manas-2010:p1037:b001:l008","ordinal":45304,"en":"To the enemies lying on every side,"},{"id":"manas-2010:p1037:b001:l009","ordinal":45305,"en":"Your blue-maned falcon Manas"},{"id":"manas-2010:p1037:b001:l010","ordinal":45306,"en":"Made us all equal."},{"id":"manas-2010:p1037:b001:l011","ordinal":45307,"en":"Mare's milk by day, girls by night,"},{"id":"manas-2010:p1037:b001:l012","ordinal":45308,"en":"Even the dog-bowls were pure silver."},{"id":"manas-2010:p1037:b001:l013","ordinal":45309,"en":"When bored, we hunted roe deer;"},{"id":"manas-2010:p1037:b001:l014","ordinal":45310,"en":"When not bored, morning and evening,"},{"id":"manas-2010:p1037:b001:l015","ordinal":45311,"en":"We made merry in Talas."},{"id":"manas-2010:p1037:b001:l016","ordinal":45312,"en":"To whom did he leave us inferior?"}]
