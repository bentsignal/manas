[{"id":"seytek-1991-continuation:p0340:b003:l020","ordinal":388865,"en":"Their spears shattered against each other;"},{"id":"seytek-1991-continuation:p0340:b003:l021","ordinal":388866,"en":"They wearied through many days."},{"id":"seytek-1991-continuation:p0340:b003:l022","ordinal":388867,"en":"All the blood was swallowed up;"},{"id":"seytek-1991-continuation:p0340:b003:l023","ordinal":388868,"en":"Their impenetrable armor, impossible to seize,"},{"id":"seytek-1991-continuation:p0340:b003:l024","ordinal":388869,"en":"Was torn into shreds."},{"id":"seytek-1991-continuation:p0340:b003:l025","ordinal":388870,"en":"They waged a fierce battle."},{"id":"seytek-1991-continuation:p0340:b003:l026","ordinal":388871,"en":"The two giants struck each other"},{"id":"seytek-1991-continuation:p0340:b003:l027","ordinal":388872,"en":"With iron-headed maces."},{"id":"seytek-1991-continuation:p0340:b003:l028","ordinal":388873,"en":"They covered the hilltop in blood"},{"id":"seytek-1991-continuation:p0340:b003:l029","ordinal":388874,"en":"And every eyelash in dust."},{"id":"seytek-1991-continuation:p0340:b003:l030","ordinal":388875,"en":"Unable to overcome each other,"},{"id":"seytek-1991-continuation:p0340:b003:l031","ordinal":388876,"en":"Their strength only increased."},{"id":"seytek-1991-continuation:p0340:b003:l032","ordinal":388877,"en":"They seized each other's collars,"},{"id":"seytek-1991-continuation:p0340:b003:l033","ordinal":388878,"en":"Wrestled and grappled,"},{"id":"seytek-1991-continuation:p0340:b003:l034","ordinal":388879,"en":"And made an astounding spectacle."},{"id":"seytek-1991-continuation:p0340:b003:l035","ordinal":388880,"en":"Choyun Alp, worth ten Odukans,"},{"id":"seytek-1991-continuation:p0340:b003:l036","ordinal":388881,"en":"A devastating giant,"},{"id":"seytek-1991-continuation:p0340:b003:l037","ordinal":388882,"en":"A champion of the royal treasury,"},{"id":"seytek-1991-continuation:p0340:b003:l038","ordinal":388883,"en":"With muscles like a bull's back,"},{"id":"seytek-1991-continuation:p0340:b003:l039","ordinal":388884,"en":"Able to devour those who resisted,"},{"id":"seytek-1991-continuation:p0340:b003:l040","ordinal":388885,"en":"Arrived and joined the attack."},{"id":"seytek-1991-continuation:p0340:b003:l041","ordinal":388886,"en":"He swung his axe wildly"},{"id":"seytek-1991-continuation:p0340:b003:l042","ordinal":388887,"en":"At your ancestor, father of the people,"},{"id":"seytek-1991-continuation:p0340:b003:l043","ordinal":388888,"en":"And clubbed him right and left."},{"id":"seytek-1991-continuation:p0340:b003:l044","ordinal":388889,"en":"When your heroic elder could find no escape"},{"id":"seytek-1991-continuation:p0340:b003:l045","ordinal":388890,"en":"And was caught between the two,"},{"id":"seytek-1991-continuation:p0340:b003:l046","ordinal":388891,"en":"The swift hero Jeljetpes"},{"id":"seytek-1991-continuation:p0340:b003:l047","ordinal":388892,"en":"And the accomplished champion Er Kenen"},{"id":"seytek-1991-continuation:p0340:b003:l048","ordinal":388893,"en":"Charged together."},{"id":"seytek-1991-continuation:p0340:b003:l049","ordinal":388894,"en":"Having lost Er Kogoy,"},{"id":"seytek-1991-continuation:p0341:b001:l001","ordinal":388895,"en":"If we let Ebegey fall to a bullet,"},{"id":"seytek-1991-continuation:p0341:b001:l002","ordinal":388896,"en":"We may as well camp along the Kok-Ozon"},{"id":"seytek-1991-continuation:p0341:b001:l003","ordinal":388897,"en":"And become like a fire gone out."},{"id":"seytek-1991-continuation:p0341:b001:l004","ordinal":388898,"en":"While the Chinese challenge us alone,"},{"id":"seytek-1991-continuation:p0341:b001:l005","ordinal":388899,"en":"While the enemy pours out his rage,"},{"id":"seytek-1991-continuation:p0341:b001:l006","ordinal":388900,"en":"While black calamity burns like fire"},{"id":"seytek-1991-continuation:p0341:b001:l007","ordinal":388901,"en":"And overwhelms the poor hero,"},{"id":"seytek-1991-continuation:p0341:b001:l008","ordinal":388902,"en":"If we conceal our comradeship,"},{"id":"seytek-1991-continuation:p0341:b001:l009","ordinal":388903,"en":"Strike not a single blow,"},{"id":"seytek-1991-continuation:p0341:b001:l010","ordinal":388904,"en":"Turn our faces away and close our eyes,"},{"id":"seytek-1991-continuation:p0341:b001:l011","ordinal":388905,"en":"Will our fortunate elder"},{"id":"seytek-1991-continuation:p0341:b001:l012","ordinal":388906,"en":"Not think us powerless?"},{"id":"seytek-1991-continuation:p0341:b001:l013","ordinal":388907,"en":"Will they not say those two have no support"},{"id":"seytek-1991-continuation:p0341:b001:l014","ordinal":388908,"en":"And mount them like black donkeys?"},{"id":"seytek-1991-continuation:p0341:b001:l015","ordinal":388909,"en":"If true death has come, let us die;"},{"id":"seytek-1991-continuation:p0341:b001:l016","ordinal":388910,"en":"Let us become a support"},{"id":"seytek-1991-continuation:p0341:b001:l017","ordinal":388911,"en":"For the humiliated gray-maned leopard,"},{"id":"seytek-1991-continuation:p0341:b001:l018","ordinal":388912,"en":"For elder Er Ebegey,"},{"id":"seytek-1991-continuation:p0341:b001:l019","ordinal":388913,"en":"For a forebear dearer than a father!"},{"id":"seytek-1991-continuation:p0341:b001:l020","ordinal":388914,"en":"Er Kenen gathered his courage,"},{"id":"seytek-1991-continuation:p0341:b001:l021","ordinal":388915,"en":"As did the accomplished Jeljetpes."},{"id":"seytek-1991-continuation:p0341:b001:l022","ordinal":388916,"en":"The two giants would not stand idle."},{"id":"seytek-1991-continuation:p0341:b001:l023","ordinal":388917,"en":"To begin an unequal battle,"},{"id":"seytek-1991-continuation:p0341:b001:l024","ordinal":388918,"en":"To free the captive Ebegey"},{"id":"seytek-1991-continuation:p0341:b001:l025","ordinal":388919,"en":"From the iron lariat net,"},{"id":"seytek-1991-continuation:p0341:b001:l026","ordinal":388920,"en":"From the black demon's bullets,"},{"id":"seytek-1991-continuation:p0341:b001:l027","ordinal":388921,"en":"From the infidel's deep pit,"},{"id":"seytek-1991-continuation:p0341:b001:l028","ordinal":388922,"en":"From the embers of burning hell,"},{"id":"seytek-1991-continuation:p0341:b001:l029","ordinal":388923,"en":"From the hands of the two giants,"},{"id":"seytek-1991-continuation:p0341:b001:l030","ordinal":388924,"en":"To rescue him,"},{"id":"seytek-1991-continuation:p0341:b001:l031","ordinal":388925,"en":"They broke through the formation and opened a road."},{"id":"seytek-1991-continuation:p0341:b001:l032","ordinal":388926,"en":"The two splendid falcons"},{"id":"seytek-1991-continuation:p0341:b001:l033","ordinal":388927,"en":"Came and attacked the pair."},{"id":"seytek-1991-continuation:p0341:b001:l034","ordinal":388928,"en":"Choyun Alp stood at the front."},{"id":"seytek-1991-continuation:p0341:b001:l035","ordinal":388929,"en":"Before that giant hero"},{"id":"seytek-1991-continuation:p0341:b001:l036","ordinal":388930,"en":"Could say a word or turn aside,"},{"id":"seytek-1991-continuation:p0341:b001:l037","ordinal":388931,"en":"In the blink of an eye,"},{"id":"seytek-1991-continuation:p0341:b001:l038","ordinal":388932,"en":"Jeljetpes proved his strength."},{"id":"seytek-1991-continuation:p0341:b001:l039","ordinal":388933,"en":"Broad at the base and sharp at the point,"},{"id":"seytek-1991-continuation:p0341:b001:l040","ordinal":388934,"en":"His spear bloodied any foe he thrust at."},{"id":"seytek-1991-continuation:p0341:b001:l041","ordinal":388935,"en":"Its iron was smelted and worked,"},{"id":"seytek-1991-continuation:p0341:b001:l042","ordinal":388936,"en":"Its edge was sharpened,"},{"id":"seytek-1991-continuation:p0341:b001:l043","ordinal":388937,"en":"Filed again and again with a file,"},{"id":"seytek-1991-continuation:p0341:b001:l044","ordinal":388938,"en":"Hammered again and again with a hammer,"},{"id":"seytek-1991-continuation:p0341:b001:l045","ordinal":388939,"en":"Hammered without rest for eighty days,"},{"id":"seytek-1991-continuation:p0341:b001:l046","ordinal":388940,"en":"Tempered, crushed, and beaten;"},{"id":"seytek-1991-continuation:p0341:b001:l047","ordinal":388941,"en":"Its charcoal leapt like sheep,"},{"id":"seytek-1991-continuation:p0341:b001:l048","ordinal":388942,"en":"And it shattered every bellows."},{"id":"seytek-1991-continuation:p0341:b001:l049","ordinal":388943,"en":"His servant Dynshokor"},{"id":"seytek-1991-continuation:p0341:b003:l001","ordinal":388944,"en":"Made the master smith weep."},{"id":"seytek-1991-continuation:p0341:b003:l002","ordinal":388945,"en":"Its solid workmanship was unsurpassed."},{"id":"seytek-1991-continuation:p0341:b003:l003","ordinal":388946,"en":"Yengkor, who came from Beijing"},{"id":"seytek-1991-continuation:p0341:b003:l004","ordinal":388947,"en":"And had befriended the prophet David,"},{"id":"seytek-1991-continuation:p0341:b003:l005","ordinal":388948,"en":"Was the smith who made"},{"id":"seytek-1991-continuation:p0341:b003:l006","ordinal":388949,"en":"Jeljetpes's spear."},{"id":"seytek-1991-continuation:p0341:b003:l007","ordinal":388950,"en":"When its point touched a man,"},{"id":"seytek-1991-continuation:p0341:b003:l008","ordinal":388951,"en":"He paled and wilted like grass;"},{"id":"seytek-1991-continuation:p0341:b003:l009","ordinal":388952,"en":"When its point struck true,"},{"id":"seytek-1991-continuation:p0341:b003:l010","ordinal":388953,"en":"His life left before he could draw breath."},{"id":"seytek-1991-continuation:p0341:b003:l011","ordinal":388954,"en":"It had been tempered in poison,"},{"id":"seytek-1991-continuation:p0341:b003:l012","ordinal":388955,"en":"Heated twelve times red-hot"},{"id":"seytek-1991-continuation:p0341:b003:l013","ordinal":388956,"en":"In the poison of an albasty demon."},{"id":"seytek-1991-continuation:p0341:b003:l014","ordinal":388957,"en":"Such was his spear and equipment;"},{"id":"seytek-1991-continuation:p0341:b003:l015","ordinal":388958,"en":"Such was the stratagem"},{"id":"seytek-1991-continuation:p0341:b003:l016","ordinal":388959,"en":"Of your elder Er Jeljetpes."},{"id":"seytek-1991-continuation:p0341:b003:l017","ordinal":388960,"en":"When the fully armed infidel,"},{"id":"seytek-1991-continuation:p0341:b003:l018","ordinal":388961,"en":"The giant hero Choyun Alp,"},{"id":"seytek-1991-continuation:p0341:b003:l019","ordinal":388962,"en":"Joined Odukan"},{"id":"seytek-1991-continuation:p0341:b003:l020","ordinal":388963,"en":"To wage immeasurable battle,"},{"id":"seytek-1991-continuation:p0341:b003:l021","ordinal":388964,"en":"When those two matching madmen"},{"id":"seytek-1991-continuation:p0341:b003:l022","ordinal":388965,"en":"Were about to spill Ebegey's blood,"},{"id":"seytek-1991-continuation:p0341:b003:l023","ordinal":388966,"en":"Plunge him into deepest misery,"},{"id":"seytek-1991-continuation:p0341:b003:l024","ordinal":388967,"en":"And inflict on Ebegey"},{"id":"seytek-1991-continuation:p0341:b003:l025","ordinal":388968,"en":"A torment no man could bear,"},{"id":"seytek-1991-continuation:p0341:b003:l026","ordinal":388969,"en":"Your elder Er Jeljetpes"},{"id":"seytek-1991-continuation:p0341:b003:l027","ordinal":388970,"en":"Came upon him from behind."},{"id":"seytek-1991-continuation:p0341:b003:l028","ordinal":388971,"en":"At the lower edge of his hair,"},{"id":"seytek-1991-continuation:p0341:b003:l029","ordinal":388972,"en":"At the bare rim of his temple,"},{"id":"seytek-1991-continuation:p0341:b003:l030","ordinal":388973,"en":"He thrust his spear straight through."},{"id":"seytek-1991-continuation:p0341:b003:l031","ordinal":388974,"en":"From Choyun Alp's head"},{"id":"seytek-1991-continuation:p0341:b003:l032","ordinal":388975,"en":"Blood flowed like an irrigation ditch;"},{"id":"seytek-1991-continuation:p0341:b003:l033","ordinal":388976,"en":"The spear passed through his brain,"},{"id":"seytek-1991-continuation:p0341:b003:l034","ordinal":388977,"en":"And his life went out mingled with blood."},{"id":"seytek-1991-continuation:p0341:b003:l035","ordinal":388978,"en":"He whipped the bay stallion,"},{"id":"seytek-1991-continuation:p0341:b003:l036","ordinal":388979,"en":"Shouting in anger."},{"id":"seytek-1991-continuation:p0341:b003:l037","ordinal":388980,"en":"The mighty, fortunate hero,"},{"id":"seytek-1991-continuation:p0341:b003:l038","ordinal":388981,"en":"Who was like a host when he rode in front,"},{"id":"seytek-1991-continuation:p0341:b003:l039","ordinal":388982,"en":"Cried to his elder Er Ebegey,"},{"id":"seytek-1991-continuation:p0341:b003:l040","ordinal":388983,"en":"“Gather your senses!”"},{"id":"seytek-1991-continuation:p0341:b003:l041","ordinal":388984,"en":"His gray-wolf courage revealed,"},{"id":"seytek-1991-continuation:p0341:b003:l042","ordinal":388985,"en":"He thrust beneath the steel shield"},{"id":"seytek-1991-continuation:p0341:b003:l043","ordinal":388986,"en":"On the head of the fully armed infidel,"},{"id":"seytek-1991-continuation:p0341:b003:l044","ordinal":388987,"en":"The hero Khan Odukan."},{"id":"seytek-1991-continuation:p0341:b003:l045","ordinal":388988,"en":"He thrust and sent the shield flying."},{"id":"seytek-1991-continuation:p0341:b003:l046","ordinal":388989,"en":"The peerless champion Jeljetpes"},{"id":"seytek-1991-continuation:p0341:b003:l047","ordinal":388990,"en":"Had his axe bound in leather,"},{"id":"seytek-1991-continuation:p0341:b003:l048","ordinal":388991,"en":"Its handle fitted with twisted gold;"},{"id":"seytek-1991-continuation:p0341:b003:l049","ordinal":388992,"en":"When laid on grass, it started a fire,"},{"id":"seytek-1991-continuation:p0342:b001:l001","ordinal":388993,"en":"When swung, its head blazed like an ember."},{"id":"seytek-1991-continuation:p0342:b001:l002","ordinal":388994,"en":"When he swung it in fury,"},{"id":"seytek-1991-continuation:p0342:b001:l003","ordinal":388995,"en":"It never rested without drinking blood."},{"id":"seytek-1991-continuation:p0342:b001:l004","ordinal":388996,"en":"Its edge glowed red with fire;"},{"id":"seytek-1991-continuation:p0342:b001:l005","ordinal":388997,"en":"Though its handle was rather short,"},{"id":"seytek-1991-continuation:p0342:b001:l006","ordinal":388998,"en":"When he swung it in fury"},{"id":"seytek-1991-continuation:p0342:b001:l007","ordinal":388999,"en":"It lengthened to a full fathom."},{"id":"seytek-1991-continuation:p0342:b001:l008","ordinal":389000,"en":"Those who saw its wrath panicked;"},{"id":"seytek-1991-continuation:p0342:b001:l009","ordinal":389001,"en":"Those who heard its name grieved."},{"id":"seytek-1991-continuation:p0342:b001:l010","ordinal":389002,"en":"Any stubborn enemy who faced it"},{"id":"seytek-1991-continuation:p0342:b001:l011","ordinal":389003,"en":"Despaired of his dark life."},{"id":"seytek-1991-continuation:p0342:b001:l012","ordinal":389004,"en":"He seized the blood-spilling axe,"},{"id":"seytek-1991-continuation:p0342:b001:l013","ordinal":389005,"en":"Whirled it around,"},{"id":"seytek-1991-continuation:p0342:b001:l014","ordinal":389006,"en":"And strained forward with both hands."},{"id":"seytek-1991-continuation:p0342:b001:l015","ordinal":389007,"en":"At Odukan, huge as a mountain,"},{"id":"seytek-1991-continuation:p0342:b001:l016","ordinal":389008,"en":"The infidel of matchless strength,"},{"id":"seytek-1991-continuation:p0342:b001:l017","ordinal":389009,"en":"The hero never sated with blood,"},{"id":"seytek-1991-continuation:p0342:b001:l018","ordinal":389010,"en":"Calling him the accursed one,"},{"id":"seytek-1991-continuation:p0342:b001:l019","ordinal":389011,"en":"Taking the dark pupil as his measure,"},{"id":"seytek-1991-continuation:p0342:b001:l020","ordinal":389012,"en":"And the crown of the head as his mark,"},{"id":"seytek-1991-continuation:p0342:b001:l021","ordinal":389013,"en":"He aimed carefully and struck,"},{"id":"seytek-1991-continuation:p0342:b001:l022","ordinal":389014,"en":"Swinging with perfect accuracy."},{"id":"seytek-1991-continuation:p0342:b001:l023","ordinal":389015,"en":"When it struck, Odu was no more;"},{"id":"seytek-1991-continuation:p0342:b001:l024","ordinal":389016,"en":"The poison-tempered battle-axe"},{"id":"seytek-1991-continuation:p0342:b001:l025","ordinal":389017,"en":"Sank in to its socket."},{"id":"seytek-1991-continuation:p0342:b001:l026","ordinal":389018,"en":"When the axe struck Odu,"},{"id":"seytek-1991-continuation:p0342:b001:l027","ordinal":389019,"en":"His cry was heard in the sky,"},{"id":"seytek-1991-continuation:p0342:b001:l028","ordinal":389020,"en":"And he fell embracing the earth."},{"id":"seytek-1991-continuation:p0342:b001:l029","ordinal":389021,"en":"His head plunged into a hollow;"},{"id":"seytek-1991-continuation:p0342:b001:l030","ordinal":389022,"en":"Dust and soil"},{"id":"seytek-1991-continuation:p0342:b001:l031","ordinal":389023,"en":"Choked his mouth and nose,"},{"id":"seytek-1991-continuation:p0342:b001:l032","ordinal":389024,"en":"And no fly-like breath remained."},{"id":"seytek-1991-continuation:p0342:b001:l033","ordinal":389025,"en":"When Odukan and Choyun had died,"},{"id":"seytek-1991-continuation:p0342:b001:l034","ordinal":389026,"en":"Their warriors of every kind,"},{"id":"seytek-1991-continuation:p0342:b001:l035","ordinal":389027,"en":"Their foremost rabble,"},{"id":"seytek-1991-continuation:p0342:b001:l036","ordinal":389028,"en":"Strong mounted and on foot,"},{"id":"seytek-1991-continuation:p0342:b001:l037","ordinal":389029,"en":"Their racers unsurpassed in the world,"},{"id":"seytek-1991-continuation:p0342:b001:l038","ordinal":389030,"en":"Commanders over tens,"},{"id":"seytek-1991-continuation:p0342:b001:l039","ordinal":389031,"en":"Champions over thousands,"},{"id":"seytek-1991-continuation:p0342:b001:l040","ordinal":389032,"en":"Their Kaldays and stone-hearted men,"},{"id":"seytek-1991-continuation:p0342:b001:l041","ordinal":389033,"en":"All rushed in with an uproar,"},{"id":"seytek-1991-continuation:p0342:b001:l042","ordinal":389034,"en":"Their spears held firmly forward."},{"id":"seytek-1991-continuation:p0342:b001:l043","ordinal":389035,"en":"The earth split into dust;"},{"id":"seytek-1991-continuation:p0342:b001:l044","ordinal":389036,"en":"The ground became a pit that trapped feet."},{"id":"seytek-1991-continuation:p0342:b001:l045","ordinal":389037,"en":"The vast army surged in,"},{"id":"seytek-1991-continuation:p0342:b001:l046","ordinal":389038,"en":"And boundless misery boiled over."},{"id":"seytek-1991-continuation:p0342:b001:l047","ordinal":389039,"en":"As the Chinese closed around them,"},{"id":"seytek-1991-continuation:p0342:b001:l048","ordinal":389040,"en":"When oppression and violent calamity"},{"id":"seytek-1991-continuation:p0342:b001:l049","ordinal":389041,"en":"Were about to descend upon their heads,"},{"id":"seytek-1991-continuation:p0342:b003:l001","ordinal":389042,"en":"Calling them fugitives from China,"},{"id":"seytek-1991-continuation:p0342:b003:l002","ordinal":389043,"en":"When they were about to hang them by the elbows,"},{"id":"seytek-1991-continuation:p0342:b003:l003","ordinal":389044,"en":"Cut reins from their backs,"},{"id":"seytek-1991-continuation:p0342:b003:l004","ordinal":389045,"en":"Pierce them through from the saddle,"},{"id":"seytek-1991-continuation:p0342:b003:l005","ordinal":389046,"en":"And hang them dangling"},{"id":"seytek-1991-continuation:p0342:b003:l006","ordinal":389047,"en":"From the end of a tree,"},{"id":"seytek-1991-continuation:p0342:b003:l007","ordinal":389048,"en":"Truly tormenting their souls,"},{"id":"seytek-1991-continuation:p0342:b003:l008","ordinal":389049,"en":"The exceedingly resourceful Ebegey"},{"id":"seytek-1991-continuation:p0342:b003:l009","ordinal":389050,"en":"Mounted Jeljetpes"},{"id":"seytek-1991-continuation:p0342:b003:l010","ordinal":389051,"en":"On the rhinoceros he had drawn near,"},{"id":"seytek-1991-continuation:p0342:b003:l011","ordinal":389052,"en":"Reviving the life that was about to die."},{"id":"seytek-1991-continuation:p0342:b003:l012","ordinal":389053,"en":"He showed the loyalty"},{"id":"seytek-1991-continuation:p0342:b003:l013","ordinal":389054,"en":"Of a wise peer and comrade."},{"id":"seytek-1991-continuation:p0342:b003:l014","ordinal":389055,"en":"Though caught by the woeful army,"},{"id":"seytek-1991-continuation:p0342:b003:l015","ordinal":389056,"en":"Er Jeljetpes escaped."},{"id":"seytek-1991-continuation:p0342:b003:l016","ordinal":389057,"en":"He turned the rhinoceros's head,"},{"id":"seytek-1991-continuation:p0342:b003:l017","ordinal":389058,"en":"Called up the Cloud Horse,"},{"id":"seytek-1991-continuation:p0342:b003:l018","ordinal":389059,"en":"And conjured weather in midsummer."},{"id":"seytek-1991-continuation:p0342:b003:l019","ordinal":389060,"en":"Gorges flew and cliffs collapsed;"},{"id":"seytek-1991-continuation:p0342:b003:l020","ordinal":389061,"en":"He devastated the broad land"},{"id":"seytek-1991-continuation:p0342:b003:l021","ordinal":389062,"en":"And revealed his sorcery."},{"id":"seytek-1991-continuation:p0342:b004:l001","ordinal":389063,"en":"Fog rose from the hollows;"},{"id":"seytek-1991-continuation:p0342:b005:l001","ordinal":389064,"en":"Clouds covered the mountains."},{"id":"seytek-1991-continuation:p0342:b005:l002","ordinal":389065,"en":"Over foothill, slope, and plain,"},{"id":"seytek-1991-continuation:p0342:b005:l003","ordinal":389066,"en":"Black banks of mist divided."},{"id":"seytek-1991-continuation:p0342:b005:l004","ordinal":389067,"en":"Looking toward the sky,"},{"id":"seytek-1991-continuation:p0342:b005:l005","ordinal":389068,"en":"One saw hail pour down in six streams."},{"id":"seytek-1991-continuation:p0342:b005:l006","ordinal":389069,"en":"Across hills, knolls, and ravines,"},{"id":"seytek-1991-continuation:p0342:b005:l007","ordinal":389070,"en":"It smashed and swept away all traces,"},{"id":"seytek-1991-continuation:p0342:b005:l008","ordinal":389071,"en":"And choked the level uplands."},{"id":"seytek-1991-continuation:p0342:b005:l009","ordinal":389072,"en":"Beasts and living creatures"},{"id":"seytek-1991-continuation:p0342:b005:l010","ordinal":389073,"en":"Were disturbed and destroyed."},{"id":"seytek-1991-continuation:p0342:b005:l011","ordinal":389074,"en":"The army gathered with frantic cries;"},{"id":"seytek-1991-continuation:p0342:b005:l012","ordinal":389075,"en":"Ravens croaked and perished."},{"id":"seytek-1991-continuation:p0342:b005:l013","ordinal":389076,"en":"Wild asses fled and escaped;"},{"id":"seytek-1991-continuation:p0342:b005:l014","ordinal":389077,"en":"Creatures that entered their dens"},{"id":"seytek-1991-continuation:p0342:b005:l015","ordinal":389078,"en":"Survived without dying,"},{"id":"seytek-1991-continuation:p0342:b005:l016","ordinal":389079,"en":"While animals above the earth"},{"id":"seytek-1991-continuation:p0342:b005:l017","ordinal":389080,"en":"Were all seized by death."},{"id":"seytek-1991-continuation:p0342:b005:l018","ordinal":389081,"en":"He loosed a storm of extraordinary force."},{"id":"seytek-1991-continuation:p0342:b005:l019","ordinal":389082,"en":"Along slopes, gullies, and cliffs,"},{"id":"seytek-1991-continuation:p0342:b005:l020","ordinal":389083,"en":"Bare rocks fell and streamed down,"},{"id":"seytek-1991-continuation:p0342:b005:l021","ordinal":389084,"en":"Carrying away at their edge"},{"id":"seytek-1991-continuation:p0342:b005:l022","ordinal":389085,"en":"The seething Chinese host."},{"id":"seytek-1991-continuation:p0342:b005:l023","ordinal":389086,"en":"He unleashed the weather without measure,"},{"id":"seytek-1991-continuation:p0342:b005:l024","ordinal":389087,"en":"Blinding eyes and binding hands,"},{"id":"seytek-1991-continuation:p0342:b005:l025","ordinal":389088,"en":"Plainly barring the road."},{"id":"seytek-1991-continuation:p0342:b005:l026","ordinal":389089,"en":"Jeljetpes, who had seen much,"},{"id":"seytek-1991-continuation:p0342:b005:l027","ordinal":389090,"en":"Was an invincible sorcerer."},{"id":"seytek-1991-continuation:p0343:b001:l001","ordinal":389091,"en":"Thus he cast his spell,"},{"id":"seytek-1991-continuation:p0343:b001:l002","ordinal":389092,"en":"Blocking the road"},{"id":"seytek-1991-continuation:p0343:b001:l003","ordinal":389093,"en":"Of the surging infidels,"},{"id":"seytek-1991-continuation:p0343:b001:l004","ordinal":389094,"en":"Turning aside the arrow"},{"id":"seytek-1991-continuation:p0343:b001:l005","ordinal":389095,"en":"Of the overwhelming, fatal calamity,"},{"id":"seytek-1991-continuation:p0343:b001:l006","ordinal":389096,"en":"And barring the very heart"},{"id":"seytek-1991-continuation:p0343:b001:l007","ordinal":389097,"en":"Of the fiercely raging disaster."},{"id":"seytek-1991-continuation:p0343:b001:l008","ordinal":389098,"en":"Looking through the mingled dust,"},{"id":"seytek-1991-continuation:p0343:b001:l009","ordinal":389099,"en":"Longing for his people to be safe,"},{"id":"seytek-1991-continuation:p0343:b001:l010","ordinal":389100,"en":"His fly-like life cried out;"},{"id":"seytek-1991-continuation:p0343:b001:l011","ordinal":389101,"en":"Every bone cracked."},{"id":"seytek-1991-continuation:p0343:b001:l012","ordinal":389102,"en":"His whole body was covered in blood;"},{"id":"seytek-1991-continuation:p0343:b001:l013","ordinal":389103,"en":"The two hands that had served him"},{"id":"seytek-1991-continuation:p0343:b001:l014","ordinal":389104,"en":"Would not rise and were paralyzed."},{"id":"seytek-1991-continuation:p0343:b001:l015","ordinal":389105,"en":"His precious head, dear in life,"},{"id":"seytek-1991-continuation:p0343:b001:l016","ordinal":389106,"en":"Was a red bucket of blood."},{"id":"seytek-1991-continuation:p0343:b001:l017","ordinal":389107,"en":"The broad world narrowed;"},{"id":"seytek-1991-continuation:p0343:b001:l018","ordinal":389108,"en":"Even saliva, life's sustenance,"},{"id":"seytek-1991-continuation:p0343:b001:l019","ordinal":389109,"en":"Was too hard for him to swallow."},{"id":"seytek-1991-continuation:p0343:b001:l020","ordinal":389110,"en":"His unbending back bent,"},{"id":"seytek-1991-continuation:p0343:b001:l021","ordinal":389111,"en":"And he despaired of his precious life."},{"id":"seytek-1991-continuation:p0343:b001:l022","ordinal":389112,"en":"The cold lasso, death's bullet,"},{"id":"seytek-1991-continuation:p0343:b001:l023","ordinal":389113,"en":"Was loaded and poised above his head."},{"id":"seytek-1991-continuation:p0343:b001:l024","ordinal":389114,"en":"His fly-like soul cried out;"},{"id":"seytek-1991-continuation:p0343:b001:l025","ordinal":389115,"en":"All his flesh and bones"},{"id":"seytek-1991-continuation:p0343:b001:l026","ordinal":389116,"en":"Cracked and crumbled to powder."},{"id":"seytek-1991-continuation:p0343:b001:l027","ordinal":389117,"en":"Ebegey fought on,"},{"id":"seytek-1991-continuation:p0343:b001:l028","ordinal":389118,"en":"For many days and many nights,"},{"id":"seytek-1991-continuation:p0343:b001:l029","ordinal":389119,"en":"Standing there in fury."},{"id":"seytek-1991-continuation:p0343:b001:l030","ordinal":389120,"en":"In Yengkor's sight,"}]
