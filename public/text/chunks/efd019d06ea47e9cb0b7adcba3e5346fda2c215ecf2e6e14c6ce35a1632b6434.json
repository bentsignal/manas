[{"id":"semetey-1-2013:p0527:b003:l009","ordinal":116993,"en":"Toward that dark cave he rode."},{"id":"semetey-1-2013:p0527:b003:l010","ordinal":116994,"en":"Aktulpar, the horse beneath him—"},{"id":"semetey-1-2013:p0527:b003:l011","ordinal":116995,"en":"He let Aktulpar graze."},{"id":"semetey-1-2013:p0527:b003:l012","ordinal":116996,"en":"In Kaiypchy's cave"},{"id":"semetey-1-2013:p0527:b003:l013","ordinal":116997,"en":"He lay down and slept his fill."},{"id":"semetey-1-2013:p0527:b003:l014","ordinal":116998,"en":"“My noble mother Kanykei,"},{"id":"semetey-1-2013:p0527:b003:l015","ordinal":116999,"en":"When she scattered her wealth,"},{"id":"semetey-1-2013:p0527:b003:l016","ordinal":117000,"en":"When my mother fled Talas on foot,"},{"id":"semetey-1-2013:p0527:b003:l017","ordinal":117001,"en":"When she trotted like a hunting hound,"},{"id":"semetey-1-2013:p0527:b003:l018","ordinal":117002,"en":"Enduring much hardship,"},{"id":"semetey-1-2013:p0527:b003:l019","ordinal":117003,"en":"When my mother came on foot from Talas,"},{"id":"semetey-1-2013:p0527:b003:l020","ordinal":117004,"en":"Her shoes worn out, walking in stockings,"},{"id":"semetey-1-2013:p0527:b003:l021","ordinal":117005,"en":"Her precious life not extinguished by grief,"},{"id":"semetey-1-2013:p0527:b003:l022","ordinal":117006,"en":"Her boots worn out, walking in stockings,"},{"id":"semetey-1-2013:p0527:b003:l023","ordinal":117007,"en":"Her precious life not extinguished by humiliation,"},{"id":"semetey-1-2013:p0527:b003:l024","ordinal":117008,"en":"Her calves chafed by walking,"},{"id":"semetey-1-2013:p0527:b003:l025","ordinal":117009,"en":"My mother's heels aching,"},{"id":"semetey-1-2013:p0527:b003:l026","ordinal":117010,"en":"Wishing to die but unable to die,"},{"id":"semetey-1-2013:p0527:b003:l027","ordinal":117011,"en":"My dear mother, sorely tried,"},{"id":"semetey-1-2013:p0527:b003:l028","ordinal":117012,"en":"Unable to take her own life,"},{"id":"semetey-1-2013:p0527:b003:l029","ordinal":117013,"en":"Walking on foot toward Temir Khan,"},{"id":"semetey-1-2013:p0527:b003:l030","ordinal":117014,"en":"When my mother set out wandering,"},{"id":"semetey-1-2013:p0527:b003:l031","ordinal":117015,"en":"Fleeing on foot toward Bukhara,"},{"id":"semetey-1-2013:p0527:b003:l032","ordinal":117016,"en":"Sobbing as she walked on foot—"},{"id":"semetey-1-2013:p0527:b003:l033","ordinal":117017,"en":"This was where she entered, finding no other way."},{"id":"semetey-1-2013:p0527:b003:l034","ordinal":117018,"en":"My valiant mother Kanykei"},{"id":"semetey-1-2013:p0527:b003:l035","ordinal":117019,"en":"Sheltered here for six days,"},{"id":"semetey-1-2013:p0527:b003:l036","ordinal":117020,"en":"Stayed here to keep herself alive."},{"id":"semetey-1-2013:p0527:b003:l037","ordinal":117021,"en":"My poor mother Kanykei"},{"id":"semetey-1-2013:p0527:b003:l038","ordinal":117022,"en":"Wore out her life, frail as a fly."},{"id":"semetey-1-2013:p0527:b003:l039","ordinal":117023,"en":"Weeping and wailing, my wretched mother"},{"id":"semetey-1-2013:p0527:b004:l001","ordinal":117024,"en":"Prayed to God for me."},{"id":"semetey-1-2013:p0527:b004:l002","ordinal":117025,"en":"My poor, destitute mother's"},{"id":"semetey-1-2013:p0527:b004:l003","ordinal":117026,"en":"Heart was sorely troubled:"},{"id":"semetey-1-2013:p0527:b004:l004","ordinal":117027,"en":"“My orphan, left by the fierce-maned hero,"},{"id":"semetey-1-2013:p0527:b004:l005","ordinal":117028,"en":"Will he die of hunger?” she thought."},{"id":"semetey-1-2013:p0527:b004:l006","ordinal":117029,"en":"The dark rock where she prayed—"},{"id":"semetey-1-2013:p0527:b004:l007","ordinal":117030,"en":"Where her tears had fallen,"},{"id":"semetey-1-2013:p0527:b004:l008","ordinal":117031,"en":"Currants sprouted green."},{"id":"semetey-1-2013:p0527:b004:l009","ordinal":117032,"en":"Where my mother had stood,"},{"id":"semetey-1-2013:p0527:b004:l010","ordinal":117033,"en":"Oleaster fruit ripened in abundance.”"},{"id":"semetey-1-2013:p0527:b004:l011","ordinal":117034,"en":"When he saw these signs,"},{"id":"semetey-1-2013:p0527:b004:l012","ordinal":117035,"en":"The approaching orphan marveled."},{"id":"semetey-1-2013:p0527:b004:l013","ordinal":117036,"en":"His uncle Bakai, hastening anxiously,"},{"id":"semetey-1-2013:p0527:b004:l014","ordinal":117037,"en":"Had come here seeking the orphan."},{"id":"semetey-1-2013:p0527:b004:l015","ordinal":117038,"en":"Six wild sheep and four wild rams—"},{"id":"semetey-1-2013:p0527:b004:l016","ordinal":117039,"en":"Here his uncle had shot them for her."},{"id":"semetey-1-2013:p0527:b004:l017","ordinal":117040,"en":"He prepared all the provisions."},{"id":"semetey-1-2013:p0527:b004:l018","ordinal":117041,"en":"Honoring the spirit of dear Manas,"},{"id":"semetey-1-2013:p0527:b004:l020","ordinal":117042,"en":"He sent her wandering to Temir Khan,"},{"id":"semetey-1-2013:p0527:b004:l021","ordinal":117043,"en":"Sent her fleeing to Kara Khan,"},{"id":"semetey-1-2013:p0527:b004:l022","ordinal":117044,"en":"Gave her two skins of milk,"},{"id":"semetey-1-2013:p0527:b004:l023","ordinal":117045,"en":"Gave her two fat horses,"},{"id":"semetey-1-2013:p0527:b004:l024","ordinal":117046,"en":"Lest she camp in an inhospitable place."},{"id":"semetey-1-2013:p0527:b004:l025","ordinal":117047,"en":"“When her husband dies, a woman"},{"id":"semetey-1-2013:p0527:b004:l026","ordinal":117048,"en":"Finds her own kin close at hand,” he said."},{"id":"semetey-1-2013:p0527:b004:l027","ordinal":117049,"en":"Khan Bakai dedicated a gray two-year-old wether."},{"id":"semetey-1-2013:p0527:b004:l028","ordinal":117050,"en":"Here he slaughtered the animal as a sign."},{"id":"semetey-1-2013:p0527:b004:l029","ordinal":117051,"en":"My valiant mother Chyiyrdy"},{"id":"semetey-1-2013:p0527:b004:l030","ordinal":117052,"en":"Lay here and ate her fill."},{"id":"semetey-1-2013:p0527:b004:l031","ordinal":117053,"en":"On the slope where the gray wether was slaughtered,"},{"id":"semetey-1-2013:p0527:b004:l032","ordinal":117054,"en":"A shrine with a gray foundation arose."},{"id":"semetey-1-2013:p0527:b004:l033","ordinal":117055,"en":"My father, gone to Judgment Day,"},{"id":"semetey-1-2013:p0527:b004:l034","ordinal":117056,"en":"God had thus protected."},{"id":"semetey-1-2013:p0527:b004:l035","ordinal":117057,"en":"Where my mother, burdened with hardship,"},{"id":"semetey-1-2013:p0527:b004:l036","ordinal":117058,"en":"Had stayed the night,"},{"id":"semetey-1-2013:p0527:b004:l037","ordinal":117059,"en":"A rooted shrine and a willow had sprung up."},{"id":"semetey-1-2013:p0527:b004:l038","ordinal":117060,"en":"That mighty conquering hero—"},{"id":"semetey-1-2013:p0527:b004:l039","ordinal":117061,"en":"God had been his helper from the beginning."},{"id":"semetey-1-2013:p0528:b003:l001","ordinal":117062,"en":"Your orphan looked and wept in distress."},{"id":"semetey-1-2013:p0528:b003:l002","ordinal":117063,"en":"Whenever he saw one of those signs,"},{"id":"semetey-1-2013:p0528:b003:l003","ordinal":117064,"en":"To his father Manas, the generous lord's"},{"id":"semetey-1-2013:p0528:b003:l004","ordinal":117065,"en":"Spirit he prayed."},{"id":"semetey-1-2013:p0528:b003:l005","ordinal":117066,"en":"Unable to lie still, starting up,"},{"id":"semetey-1-2013:p0528:b003:l006","ordinal":117067,"en":"Your orphan rose again"},{"id":"semetey-1-2013:p0528:b003:l007","ordinal":117068,"en":"And saddled Aktulpar."},{"id":"semetey-1-2013:p0528:b003:l008","ordinal":117069,"en":"He traveled all around,"},{"id":"semetey-1-2013:p0528:b003:l009","ordinal":117070,"en":"Along the road his mother had come,"},{"id":"semetey-1-2013:p0528:b003:l010","ordinal":117071,"en":"The orphan wandered without wearying."},{"id":"semetey-1-2013:p0528:b003:l011","ordinal":117072,"en":"The gray pouch-belt left by his father Manas"},{"id":"semetey-1-2013:p0528:b003:l012","ordinal":117073,"en":"He fitted closely about his neck."},{"id":"semetey-1-2013:p0528:b003:l013","ordinal":117074,"en":"To God, whose command is mighty,"},{"id":"semetey-1-2013:p0528:b003:l014","ordinal":117075,"en":"Your orphan offered supplication and prayed."},{"id":"semetey-1-2013:p0528:b003:l015","ordinal":117076,"en":"He traveled toward Talas,"},{"id":"semetey-1-2013:p0528:b003:l016","ordinal":117077,"en":"Went far without growing tired."},{"id":"semetey-1-2013:p0528:b003:l017","ordinal":117078,"en":"Ridges curved like saddle-bows—"},{"id":"semetey-1-2013:p0528:b003:l018","ordinal":117079,"en":"He crossed many in succession."},{"id":"semetey-1-2013:p0528:b003:l019","ordinal":117080,"en":"Many hills and many ravines"},{"id":"semetey-1-2013:p0528:b003:l020","ordinal":117081,"en":"He traversed without wearying."},{"id":"semetey-1-2013:p0528:b003:l021","ordinal":117082,"en":"He followed the path along their edges."},{"id":"semetey-1-2013:p0528:b003:l022","ordinal":117083,"en":"Oluya-Ata and the two Merki—"},{"id":"semetey-1-2013:p0528:b003:l023","ordinal":117084,"en":"He traveled along them."},{"id":"semetey-1-2013:p0528:b003:l024","ordinal":117085,"en":"When he came to Oluya-Ata"},{"id":"semetey-1-2013:p0528:b003:l025","ordinal":117086,"en":"And looked toward the sunset,"},{"id":"semetey-1-2013:p0528:b003:l026","ordinal":117087,"en":"Kara-Balta and Sokuluk,"},{"id":"semetey-1-2013:p0528:b003:l027","ordinal":117088,"en":"Their ridges showed dark in the distance."},{"id":"semetey-1-2013:p0528:b003:l028","ordinal":117089,"en":"When he could not see them, the orphan's"},{"id":"semetey-1-2013:p0528:b003:l029","ordinal":117090,"en":"Heart was sorely troubled."},{"id":"semetey-1-2013:p0528:b003:l030","ordinal":117091,"en":"When he looked to his right,"},{"id":"semetey-1-2013:p0528:b003:l031","ordinal":117092,"en":"A great, misty ridge"},{"id":"semetey-1-2013:p0528:b003:l032","ordinal":117093,"en":"Rose curving like a valley."},{"id":"semetey-1-2013:p0528:b003:l033","ordinal":117094,"en":"When he saw that place,"},{"id":"semetey-1-2013:p0528:b003:l034","ordinal":117095,"en":"The orphan gazing upon it"},{"id":"semetey-1-2013:p0528:b003:l035","ordinal":117096,"en":"Felt his heart sorely troubled."},{"id":"semetey-1-2013:p0528:b003:l036","ordinal":117097,"en":"“My mother told me this:"},{"id":"semetey-1-2013:p0528:b003:l037","ordinal":117098,"en":"When my mother fled Talas on foot,"},{"id":"semetey-1-2013:p0528:b003:l038","ordinal":117099,"en":"That gray-mottled saddle, that broad valley—"},{"id":"semetey-1-2013:p0528:b003:l039","ordinal":117100,"en":"That is the pass called Zhorgo."},{"id":"semetey-1-2013:p0528:b004:l001","ordinal":117101,"en":"When you cross over and descend,"},{"id":"semetey-1-2013:p0528:b004:l002","ordinal":117102,"en":"There, on the other side, is Talas itself.”"},{"id":"semetey-1-2013:p0528:b004:l003","ordinal":117103,"en":"Then the orphan thought:"},{"id":"semetey-1-2013:p0528:b004:l004","ordinal":117104,"en":"“I shall cross that gray ridge,"},{"id":"semetey-1-2013:p0528:b004:l005","ordinal":117105,"en":"Climb the saddle and look.”"},{"id":"semetey-1-2013:p0528:b004:l006","ordinal":117106,"en":"So saying, Semetey"},{"id":"semetey-1-2013:p0528:b004:l007","ordinal":117107,"en":"Crossed Zhorgo Pass."},{"id":"semetey-1-2013:p0528:b004:l008","ordinal":117108,"en":"Beyond lay Ken-Kol and Great Talas,"},{"id":"semetey-1-2013:p0528:b004:l009","ordinal":117109,"en":"Where his father, who pledged himself to twelve spiritual masters,"},{"id":"semetey-1-2013:p0528:b004:l010","ordinal":117110,"en":"The mighty Manas, had lived."},{"id":"semetey-1-2013:p0528:b004:l011","ordinal":117111,"en":"Looking down, he saw the green expanse:"},{"id":"semetey-1-2013:p0528:b004:l012","ordinal":117112,"en":"The heart of Talas lay before him."},{"id":"semetey-1-2013:p0528:b004:l013","ordinal":117113,"en":"The orphan stood weeping,"},{"id":"semetey-1-2013:p0528:b004:l014","ordinal":117114,"en":"Tears poured from his eyes,"},{"id":"semetey-1-2013:p0528:b004:l015","ordinal":117115,"en":"His heart was sorely troubled."},{"id":"semetey-1-2013:p0528:b004:l016","ordinal":117116,"en":"His inheritance from his father,"},{"id":"semetey-1-2013:p0528:b004:l017","ordinal":117117,"en":"Broad Talas, appeared before his eyes."},{"id":"semetey-1-2013:p0528:b004:l018","ordinal":117118,"en":"Zhylgynduu, Ken-Kol, Great Talas—"},{"id":"semetey-1-2013:p0528:b004:l019","ordinal":117119,"en":"Was this not the broad back of the earth?"},{"id":"semetey-1-2013:p0528:b004:l020","ordinal":117120,"en":"Would not a person dwelling here find peace?"},{"id":"semetey-1-2013:p0528:b004:l021","ordinal":117121,"en":"Pass after separate pass appeared,"},{"id":"semetey-1-2013:p0528:b004:l022","ordinal":117122,"en":"Places of exceptional joy appeared."},{"id":"semetey-1-2013:p0528:b004:l023","ordinal":117123,"en":"Ridge after hilly ridge appeared,"},{"id":"semetey-1-2013:p0528:b004:l024","ordinal":117124,"en":"Many rolling stretches of land appeared."},{"id":"semetey-1-2013:p0528:b004:l025","ordinal":117125,"en":"Many separate upper valleys appeared,"},{"id":"semetey-1-2013:p0528:b004:l026","ordinal":117126,"en":"Places like a special paradise appeared."},{"id":"semetey-1-2013:p0528:b004:l027","ordinal":117127,"en":"The great valley of broad Talas"},{"id":"semetey-1-2013:p0528:b004:l028","ordinal":117128,"en":"Lay spreading wide,"},{"id":"semetey-1-2013:p0528:b004:l029","ordinal":117129,"en":"Its valley sweeping in a broad curve."},{"id":"semetey-1-2013:p0528:b004:l030","ordinal":117130,"en":"Wild sheep poured down from the hills,"},{"id":"semetey-1-2013:p0528:b004:l031","ordinal":117131,"en":"Thinning the grass on the hills."},{"id":"semetey-1-2013:p0528:b004:l032","ordinal":117132,"en":"Deer poured down from the rough ground,"},{"id":"semetey-1-2013:p0528:b004:l033","ordinal":117133,"en":"Thinning the grass on the rough ground."},{"id":"semetey-1-2013:p0528:b004:l034","ordinal":117134,"en":"Ibex crowded upon the terraces."},{"id":"semetey-1-2013:p0528:b004:l035","ordinal":117135,"en":"Wild sheep's wool brushed against the crags."},{"id":"semetey-1-2013:p0528:b004:l036","ordinal":117136,"en":"Wild game gathered on the slopes,"},{"id":"semetey-1-2013:p0528:b004:l037","ordinal":117137,"en":"Its male goats flocking by the hundred."},{"id":"semetey-1-2013:p0528:b004:l038","ordinal":117138,"en":"Wild sheep grazed upon the hills."},{"id":"semetey-1-2013:p0528:b004:l039","ordinal":117139,"en":"When the roe deer bounded down,"},{"id":"semetey-1-2013:p0529:b003:l001","ordinal":117140,"en":"With its two arms stretched out,"},{"id":"semetey-1-2013:p0529:b003:l002","ordinal":117141,"en":"Broad Talas lay there."},{"id":"semetey-1-2013:p0529:b003:l003","ordinal":117142,"en":"Its grass rose on towering stems."},{"id":"semetey-1-2013:p0529:b003:l004","ordinal":117143,"en":"When he breathed the scent of its sheltered hollows,"},{"id":"semetey-1-2013:p0529:b003:l005","ordinal":117144,"en":"It smelled of paradise!"},{"id":"semetey-1-2013:p0529:b003:l006","ordinal":117145,"en":"Its leaves were broad as leather."},{"id":"semetey-1-2013:p0529:b003:l007","ordinal":117146,"en":"My dear Talas's"},{"id":"semetey-1-2013:p0529:b003:l008","ordinal":117147,"en":"Black widow spiders were thumb-sized."},{"id":"semetey-1-2013:p0529:b003:l009","ordinal":117148,"en":"It had marshes in separate patches,"},{"id":"semetey-1-2013:p0529:b003:l010","ordinal":117149,"en":"Geese flying off in flocks."},{"id":"semetey-1-2013:p0529:b003:l011","ordinal":117150,"en":"Its pintails swayed in abundance."},{"id":"semetey-1-2013:p0529:b003:l012","ordinal":117151,"en":"Broad Talas lay there,"},{"id":"semetey-1-2013:p0529:b003:l013","ordinal":117152,"en":"Red-headed ducks bobbing upon it."},{"id":"semetey-1-2013:p0529:b003:l014","ordinal":117153,"en":"Birds nested in the birches,"},{"id":"semetey-1-2013:p0529:b003:l015","ordinal":117154,"en":"Flew as though driven by whips."},{"id":"semetey-1-2013:p0529:b003:l016","ordinal":117155,"en":"Birds nested in the plane trees,"},{"id":"semetey-1-2013:p0529:b003:l017","ordinal":117156,"en":"Took wing with strength."},{"id":"semetey-1-2013:p0529:b003:l018","ordinal":117157,"en":"In its mountains were snowcocks."},{"id":"semetey-1-2013:p0529:b003:l019","ordinal":117158,"en":"Within its forests stood tranquil"},{"id":"semetey-1-2013:p0529:b003:l020","ordinal":117159,"en":"Its splendidly grown plane trees."},{"id":"semetey-1-2013:p0529:b003:l021","ordinal":117160,"en":"To the lowlands of broad Talas,"},{"id":"semetey-1-2013:p0529:b003:l022","ordinal":117161,"en":"Sparing nothing,"},{"id":"semetey-1-2013:p0529:b003:l023","ordinal":117162,"en":"Almighty Allah, the one God,"},{"id":"semetey-1-2013:p0529:b003:l024","ordinal":117163,"en":"Had granted all these things."},{"id":"semetey-1-2013:p0529:b003:l025","ordinal":117164,"en":"Entangled, unable to move through the grass,"},{"id":"semetey-1-2013:p0529:b003:l026","ordinal":117165,"en":"They remained caught among it,"},{"id":"semetey-1-2013:p0529:b003:l027","ordinal":117166,"en":"The young of stags and hinds."},{"id":"semetey-1-2013:p0529:b003:l028","ordinal":117167,"en":"“My Talas, left desolate!"},{"id":"semetey-1-2013:p0529:b003:l029","ordinal":117168,"en":"He has departed from this world,"},{"id":"semetey-1-2013:p0529:b003:l030","ordinal":117169,"en":"My fierce-maned father Manas!”"},{"id":"semetey-1-2013:p0529:b003:l031","ordinal":117170,"en":"Within your orphan"},{"id":"semetey-1-2013:p0529:b003:l032","ordinal":117171,"en":"Were many wounds that could not heal."},{"id":"semetey-1-2013:p0529:b003:l033","ordinal":117172,"en":"As he traveled farther,"},{"id":"semetey-1-2013:p0529:b003:l034","ordinal":117173,"en":"There were many splendid sights."},{"id":"semetey-1-2013:p0529:b003:l035","ordinal":117174,"en":"The ground he crossed was rough."},{"id":"semetey-1-2013:p0529:b003:l036","ordinal":117175,"en":"Along a single troublesome path,"},{"id":"semetey-1-2013:p0529:b003:l037","ordinal":117176,"en":"As the lone orphan traveled,"},{"id":"semetey-1-2013:p0529:b003:l038","ordinal":117177,"en":"The slope down which he went was rugged:"},{"id":"semetey-1-2013:p0529:b003:l039","ordinal":117178,"en":"The foothills of Uch-Koshoi."},{"id":"semetey-1-2013:p0529:b005:l001","ordinal":117179,"en":"Until death it will not be healed,"},{"id":"semetey-1-2013:p0529:b005:l002","ordinal":117180,"en":"The bitterness of one who has suffered."},{"id":"semetey-1-2013:p0529:b005:l003","ordinal":117181,"en":"The hills stood separate, one by one."},{"id":"semetey-1-2013:p0529:b005:l004","ordinal":117182,"en":"When he had just reached the hills,"},{"id":"semetey-1-2013:p0529:b005:l005","ordinal":117183,"en":"An inheritance left by his father Manas,"},{"id":"semetey-1-2013:p0529:b005:l006","ordinal":117184,"en":"A white hunting hound appeared before his eyes."},{"id":"semetey-1-2013:p0529:b005:l007","ordinal":117185,"en":"From the rolling ridge"},{"id":"semetey-1-2013:p0529:b005:l008","ordinal":117186,"en":"Something emerged, howling."},{"id":"semetey-1-2013:p0529:b005:l009","ordinal":117187,"en":"At that moment his plight was hard."},{"id":"semetey-1-2013:p0529:b005:l010","ordinal":117188,"en":"Unable to make it out, the orphan faltered."},{"id":"semetey-1-2013:p0529:b005:l011","ordinal":117189,"en":"Not recognizing Kumaik,"},{"id":"semetey-1-2013:p0529:b005:l012","ordinal":117190,"en":"He wondered if it was a lion."},{"id":"semetey-1-2013:p0529:b005:l013","ordinal":117191,"en":"Its tongue hung down to the ground."},{"id":"semetey-1-2013:p0529:b005:l014","ordinal":117192,"en":"Its fur shimmered in three changing colors."},{"id":"semetey-1-2013:p0529:b005:l015","ordinal":117193,"en":"Unlike all other fanged beasts,"},{"id":"semetey-1-2013:p0529:b005:l016","ordinal":117194,"en":"Unlike even a white tiger,"},{"id":"semetey-1-2013:p0529:b005:l017","ordinal":117195,"en":"Was Kumaik's appearance."},{"id":"semetey-1-2013:p0529:b005:l018","ordinal":117196,"en":"As though he had seen the angel of death,"},{"id":"semetey-1-2013:p0529:b005:l019","ordinal":117197,"en":"That orphan stood astonished."},{"id":"semetey-1-2013:p0529:b005:l020","ordinal":117198,"en":"Its form no mortal had ever seen;"},{"id":"semetey-1-2013:p0529:b005:l021","ordinal":117199,"en":"It had a dragon's fearsome presence."},{"id":"semetey-1-2013:p0529:b005:l022","ordinal":117200,"en":"When it howled now and then,"},{"id":"semetey-1-2013:p0529:b005:l023","ordinal":117201,"en":"Its voice was unlike any a human had heard."},{"id":"semetey-1-2013:p0529:b005:l024","ordinal":117202,"en":"Crouching through the foothills,"},{"id":"semetey-1-2013:p0529:b005:l025","ordinal":117203,"en":"Kumaik came creeping low."},{"id":"semetey-1-2013:p0529:b005:l026","ordinal":117204,"en":"Tears welled in its eyes,"},{"id":"semetey-1-2013:p0529:b005:l027","ordinal":117205,"en":"Kumaik came shedding them."},{"id":"semetey-1-2013:p0529:b005:l028","ordinal":117206,"en":"To greet the orphan,"},{"id":"semetey-1-2013:p0529:b005:l029","ordinal":117207,"en":"Kumaik came in reverence,"},{"id":"semetey-1-2013:p0529:b005:l030","ordinal":117208,"en":"As though its mighty master Khan Manas had returned."},{"id":"semetey-1-2013:p0529:b005:l032","ordinal":117209,"en":"Kumaik came weeping."},{"id":"semetey-1-2013:p0529:b005:l033","ordinal":117210,"en":"That mighty creature, well known to the people,"},{"id":"semetey-1-2013:p0529:b005:l034","ordinal":117211,"en":"Left by the fierce khan gone to Judgment Day,"},{"id":"semetey-1-2013:p0529:b005:l035","ordinal":117212,"en":"Was his inheritance from his father Manas."},{"id":"semetey-1-2013:p0529:b005:l036","ordinal":117213,"en":"Crouching like a quail,"},{"id":"semetey-1-2013:p0529:b005:l037","ordinal":117214,"en":"Kumaik came creeping low."},{"id":"semetey-1-2013:p0529:b005:l038","ordinal":117215,"en":"Tears welled in its eyes,"},{"id":"semetey-1-2013:p0529:b005:l039","ordinal":117216,"en":"Kumaik let them fall."},{"id":"semetey-1-2013:p0530:b003:l001","ordinal":117217,"en":"It longed to speak but had no human tongue."},{"id":"semetey-1-2013:p0530:b003:l002","ordinal":117218,"en":"Kumaik stood helpless."},{"id":"semetey-1-2013:p0530:b003:l003","ordinal":117219,"en":"Making every bone ache,"},{"id":"semetey-1-2013:p0530:b003:l004","ordinal":117220,"en":"Kumaik stood howling."},{"id":"semetey-1-2013:p0530:b003:l005","ordinal":117221,"en":"The hair on its forehead grew thin."},{"id":"semetey-1-2013:p0530:b003:l006","ordinal":117222,"en":"Though it was an animal, that dear creature's"},{"id":"semetey-1-2013:p0530:b003:l007","ordinal":117223,"en":"Tears poured from its eyes."},{"id":"semetey-1-2013:p0530:b003:l008","ordinal":117224,"en":"Along the edge of Uch-Koshoi,"},{"id":"semetey-1-2013:p0530:b003:l009","ordinal":117225,"en":"Ranging across broad Talas,"},{"id":"semetey-1-2013:p0530:b003:l010","ordinal":117226,"en":"It had gone about barking."},{"id":"semetey-1-2013:p0530:b003:l011","ordinal":117227,"en":"It longed to speak but had no human tongue."},{"id":"semetey-1-2013:p0530:b003:l012","ordinal":117228,"en":"“My Semetey is coming,”"},{"id":"semetey-1-2013:p0530:b003:l013","ordinal":117229,"en":"It had known all along."},{"id":"semetey-1-2013:p0530:b003:l014","ordinal":117230,"en":"It had eaten its fill hunting marmots."},{"id":"semetey-1-2013:p0530:b003:l015","ordinal":117231,"en":"The ibex upon the terraces"},{"id":"semetey-1-2013:p0530:b003:l016","ordinal":117232,"en":"It had destroyed by the herd."},{"id":"semetey-1-2013:p0530:b003:l017","ordinal":117233,"en":"Upon the wild sheep in the hills,"},{"id":"semetey-1-2013:p0530:b003:l018","ordinal":117234,"en":"This very year Kumaik"},{"id":"semetey-1-2013:p0530:b003:l019","ordinal":117235,"en":"Had driven a slaughter."},{"id":"semetey-1-2013:p0530:b003:l020","ordinal":117236,"en":"The deer upon the rough ground,"},{"id":"semetey-1-2013:p0530:b003:l021","ordinal":117237,"en":"At that time Kumaik"},{"id":"semetey-1-2013:p0530:b003:l022","ordinal":117238,"en":"Had stalked and slaughtered."},{"id":"semetey-1-2013:p0530:b003:l023","ordinal":117239,"en":"The kulans upon the plains"},{"id":"semetey-1-2013:p0530:b003:l024","ordinal":117240,"en":"It had chased by the herd"},{"id":"semetey-1-2013:p0530:b003:l025","ordinal":117241,"en":"And torn open along the road."},{"id":"semetey-1-2013:p0530:b003:l026","ordinal":117242,"en":"It had sensed his coming."},{"id":"semetey-1-2013:p0530:b003:l027","ordinal":117243,"en":"“My precious one left by Manas"},{"id":"semetey-1-2013:p0530:b003:l028","ordinal":117244,"en":"Will surely come this year,” it thought."},{"id":"semetey-1-2013:p0530:b003:l029","ordinal":117245,"en":"To the dark rock before it"},{"id":"semetey-1-2013:p0530:b003:l030","ordinal":117246,"en":"It went time and again, barking:"},{"id":"semetey-1-2013:p0530:b003:l031","ordinal":117247,"en":"“Twelve years have passed."},{"id":"semetey-1-2013:p0530:b003:l032","ordinal":117248,"en":"My orphan left by ruin-bringing Manas—"}]
