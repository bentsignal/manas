{"id": "sayakbay-ms-current146:pdf188:l020", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 188, "folio": 571, "line_in_page": 20, "raw": "Жетимек деп аралап,", "text": "Жетимек деп аралап,", "en": "He ranged about, calling for the orphan.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
