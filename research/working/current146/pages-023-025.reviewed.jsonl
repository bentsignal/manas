{"id": "sayakbay-ms-current146:pdf023:l011", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 23, "folio": 406, "line_in_page": 11, "raw": "Камакка бакчууну,", "text": "Камакка бакчууну,", "en": "The one who would guard the prison,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The final word is provisionally segmented as бакчууну.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf023:l012", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 23, "folio": 406, "line_in_page": 12, "raw": "Кударман султан жакшына,", "text": "Кударман султан жакшына,", "en": "Kudarman, the good sultan,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Кударман is a provisional proper-name reading; жакшына may carry a different inflection.", "bbox": null}
