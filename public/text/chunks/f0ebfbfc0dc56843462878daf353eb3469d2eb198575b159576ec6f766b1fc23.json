[{"id":"semetey-1-2013:p0978:b004:l003","ordinal":150785,"en":"And if you had seen Semetey,"},{"id":"semetey-1-2013:p0978:b004:l004","ordinal":150786,"en":"He raged like a lion,"},{"id":"semetey-1-2013:p0978:b004:l005","ordinal":150787,"en":"Flame sputtering from his mouth,"},{"id":"semetey-1-2013:p0978:b004:l006","ordinal":150788,"en":"Sobbing, “My falcon!”"},{"id":"semetey-1-2013:p0978:b004:l007","ordinal":150789,"en":"He scattered as though seeing darkest night,"},{"id":"semetey-1-2013:p0978:b004:l008","ordinal":150790,"en":"Having lost Akshunkar."},{"id":"semetey-1-2013:p0978:b004:l009","ordinal":150791,"en":"The dear lion, huge as a fighting cock,"},{"id":"semetey-1-2013:p0978:b004:l010","ordinal":150792,"en":"Lay motionless upon the plain."},{"id":"semetey-1-2013:p0978:b004:l011","ordinal":150793,"en":"He grasped the bulungur brass flute"},{"id":"semetey-1-2013:p0978:b004:l012","ordinal":150794,"en":"By its corner and drew it close."},{"id":"semetey-1-2013:p0978:b004:l013","ordinal":150795,"en":"The sorrowing woman Chachykey"},{"id":"semetey-1-2013:p0978:b004:l014","ordinal":150796,"en":"Had sent her two younger brothers;"},{"id":"semetey-1-2013:p0978:b004:l015","ordinal":150797,"en":"Semetey lay in grief,"},{"id":"semetey-1-2013:p0978:b004:l016","ordinal":150798,"en":"As though Kanykey herself had died."},{"id":"semetey-1-2013:p0978:b004:l017","ordinal":150799,"en":"His outstretched leg would not draw in,"},{"id":"semetey-1-2013:p0978:b004:l018","ordinal":150800,"en":"His closed eyes would not open,"},{"id":"semetey-1-2013:p0978:b004:l019","ordinal":150801,"en":"And his sighing would not cease;"},{"id":"semetey-1-2013:p0978:b004:l020","ordinal":150802,"en":"Your blue-maned champion lay sprawled."},{"id":"semetey-1-2013:p0978:b004:l021","ordinal":150803,"en":"He tied Buurul at the grazing line,"},{"id":"semetey-1-2013:p0978:b004:l022","ordinal":150804,"en":"And your magnanimous hero lay swollen with grief."},{"id":"semetey-1-2013:p0978:b004:l023","ordinal":150805,"en":"The two choros were warrior choros,"},{"id":"semetey-1-2013:p0978:b004:l024","ordinal":150806,"en":"As though born as twins;"},{"id":"semetey-1-2013:p0978:b004:l025","ordinal":150807,"en":"The two were equal as a single hair,"},{"id":"semetey-1-2013:p0978:b004:l026","ordinal":150808,"en":"Choros like burning red embers,"},{"id":"semetey-1-2013:p0978:b004:l027","ordinal":150809,"en":"Choros like arrows shot from a bow,"},{"id":"semetey-1-2013:p0978:b004:l028","ordinal":150810,"en":"Calamities loosed upon the world."},{"id":"semetey-1-2013:p0978:b004:l029","ordinal":150811,"en":"When they advanced, they were his supports,"},{"id":"semetey-1-2013:p0978:b004:l030","ordinal":150812,"en":"Setting the grassy land aflame,"},{"id":"semetey-1-2013:p0978:b004:l031","ordinal":150813,"en":"The pillars of Tügöngür."},{"id":"semetey-1-2013:p0978:b004:l032","ordinal":150814,"en":"If your magnanimous Semetey remained safe,"},{"id":"semetey-1-2013:p0978:b004:l033","ordinal":150815,"en":"These boys were the wings"},{"id":"semetey-1-2013:p0978:b004:l034","ordinal":150816,"en":"With which he circled in flight;"},{"id":"semetey-1-2013:p0978:b004:l035","ordinal":150817,"en":"If seven thousand foes appeared,"},{"id":"semetey-1-2013:p0978:b004:l036","ordinal":150818,"en":"It was their custom to strike without wavering."},{"id":"semetey-1-2013:p0978:b004:l037","ordinal":150819,"en":"Kulchoro and Kanchoro—"},{"id":"semetey-1-2013:p0978:b004:l038","ordinal":150820,"en":"From noble Almambet"},{"id":"semetey-1-2013:p0978:b004:l039","ordinal":150821,"en":"Kulchoro was born afterward,"},{"id":"semetey-1-2013:p0979:b003:l001","ordinal":150822,"en":"Kanchoro was born afterward"},{"id":"semetey-1-2013:p0979:b003:l002","ordinal":150823,"en":"To his namesake father Chubak."},{"id":"semetey-1-2013:p0979:b003:l003","ordinal":150824,"en":"Abyke’s Aktelki"},{"id":"semetey-1-2013:p0979:b003:l004","ordinal":150825,"en":"Was the horse Kulchoro rode;"},{"id":"semetey-1-2013:p0979:b003:l005","ordinal":150826,"en":"The horse Kanchoro rode"},{"id":"semetey-1-2013:p0979:b003:l006","ordinal":150827,"en":"Was Khan Köbösh’s Köktelki."},{"id":"semetey-1-2013:p0979:b003:l007","ordinal":150828,"en":"The two truly raced one another,"},{"id":"semetey-1-2013:p0979:b003:l008","ordinal":150829,"en":"And rode out in anger,"},{"id":"semetey-1-2013:p0979:b003:l009","ordinal":150830,"en":"Taking from Semetey’s own mouth"},{"id":"semetey-1-2013:p0979:b003:l010","ordinal":150831,"en":"His firm promise and oath,"},{"id":"semetey-1-2013:p0979:b003:l011","ordinal":150832,"en":"And carrying the letter their elder had written."},{"id":"semetey-1-2013:p0979:b003:l012","ordinal":150833,"en":"When the sun was sinking red,"},{"id":"semetey-1-2013:p0979:b003:l013","ordinal":150834,"en":"Before the people had gone to rest,"},{"id":"semetey-1-2013:p0979:b003:l014","ordinal":150835,"en":"They came below Tört-Kül,"},{"id":"semetey-1-2013:p0979:b003:l015","ordinal":150836,"en":"To Prince Manas’s orchard,"},{"id":"semetey-1-2013:p0979:b003:l016","ordinal":150837,"en":"To the dark eye of the spring,"},{"id":"semetey-1-2013:p0979:b003:l017","ordinal":150838,"en":"To the solitary plane tree,"},{"id":"semetey-1-2013:p0979:b003:l018","ordinal":150839,"en":"To Kanykey’s encampment,"},{"id":"semetey-1-2013:p0979:b003:l019","ordinal":150840,"en":"To Chachykey’s fortress with its gate."},{"id":"semetey-1-2013:p0979:b003:l020","ordinal":150841,"en":"The boys now entered."},{"id":"semetey-1-2013:p0979:b003:l021","ordinal":150842,"en":"The two choros matched their pace;"},{"id":"semetey-1-2013:p0979:b003:l022","ordinal":150843,"en":"Unable to find a way forward,"},{"id":"semetey-1-2013:p0979:b003:l023","ordinal":150844,"en":"The boys whispered together,"},{"id":"semetey-1-2013:p0979:b003:l024","ordinal":150845,"en":"Chatted and laughed softly."},{"id":"semetey-1-2013:p0979:b003:l025","ordinal":150846,"en":"They had long known"},{"id":"semetey-1-2013:p0979:b003:l026","ordinal":150847,"en":"Their sister-in-law’s fierce temper;"},{"id":"semetey-1-2013:p0979:b003:l027","ordinal":150848,"en":"They made a firm agreement,"},{"id":"semetey-1-2013:p0979:b003:l028","ordinal":150849,"en":"And stood without exchanging blessings."},{"id":"semetey-1-2013:p0979:b003:l029","ordinal":150850,"en":"The delicate woman Chachykey"},{"id":"semetey-1-2013:p0979:b003:l030","ordinal":150851,"en":"Had a delicacy all her own,"},{"id":"semetey-1-2013:p0979:b003:l031","ordinal":150852,"en":"Her scarf like a golden amulet,"},{"id":"semetey-1-2013:p0979:b003:l032","ordinal":150853,"en":"A troubled, beautiful white brow."},{"id":"semetey-1-2013:p0979:b003:l033","ordinal":150854,"en":"No man went boldly before her;"},{"id":"semetey-1-2013:p0979:b003:l034","ordinal":150855,"en":"Whoever saw the cherished woman marveled."},{"id":"semetey-1-2013:p0979:b003:l035","ordinal":150856,"en":"No stranger entered her chamber,"},{"id":"semetey-1-2013:p0979:b003:l036","ordinal":150857,"en":"And no soul apart from Semetey"},{"id":"semetey-1-2013:p0979:b003:l037","ordinal":150858,"en":"Walked openly beside her."},{"id":"semetey-1-2013:p0979:b003:l038","ordinal":150859,"en":"Her brow was high and her venom strong—"},{"id":"semetey-1-2013:p0979:b003:l039","ordinal":150860,"en":"Do not ask about your sister-in-law’s nature."},{"id":"semetey-1-2013:p0979:b005:l001","ordinal":150861,"en":"This was one of those dark days,"},{"id":"semetey-1-2013:p0979:b005:l002","ordinal":150862,"en":"The day when her true fury was touched"},{"id":"semetey-1-2013:p0979:b005:l003","ordinal":150863,"en":"And she poured out her wrath."},{"id":"semetey-1-2013:p0979:b005:l004","ordinal":150864,"en":"No traveler came to her,"},{"id":"semetey-1-2013:p0979:b005:l005","ordinal":150865,"en":"And she received no news from me;"},{"id":"semetey-1-2013:p0979:b005:l006","ordinal":150866,"en":"This was one of those dark days."},{"id":"semetey-1-2013:p0979:b005:l007","ordinal":150867,"en":"Beside Chachykey were"},{"id":"semetey-1-2013:p0979:b005:l008","ordinal":150868,"en":"Thirty daughters-in-law and thirty girls,"},{"id":"semetey-1-2013:p0979:b005:l009","ordinal":150869,"en":"A retinue of no small splendor,"},{"id":"semetey-1-2013:p0979:b005:l010","ordinal":150870,"en":"Her attendants gathered for amusement."},{"id":"semetey-1-2013:p0979:b005:l011","ordinal":150871,"en":"Around their throats hung"},{"id":"semetey-1-2013:p0979:b005:l012","ordinal":150872,"en":"Golden earrings and amulets;"},{"id":"semetey-1-2013:p0979:b005:l013","ordinal":150873,"en":"All were stately and beautiful young women."},{"id":"semetey-1-2013:p0979:b005:l014","ordinal":150874,"en":"Semetey had a tower,"},{"id":"semetey-1-2013:p0979:b005:l015","ordinal":150875,"en":"And from the top of that tower"},{"id":"semetey-1-2013:p0979:b005:l016","ordinal":150876,"en":"Your poor sister-in-law Chachykey"},{"id":"semetey-1-2013:p0979:b005:l017","ordinal":150877,"en":"Stood keeping watch."},{"id":"semetey-1-2013:p0979:b005:l018","ordinal":150878,"en":"Realizing that Semetey was absent,"},{"id":"semetey-1-2013:p0979:b005:l019","ordinal":150879,"en":"She cried out wildly—"},{"id":"semetey-1-2013:p0979:b005:l020","ordinal":150880,"en":"God had struck the woman."},{"id":"semetey-1-2013:p0979:b005:l021","ordinal":150881,"en":"Chachykey’s forty daughters-in-law,"},{"id":"semetey-1-2013:p0979:b005:l022","ordinal":150882,"en":"All of them skilled women,"},{"id":"semetey-1-2013:p0979:b005:l023","ordinal":150883,"en":"Stood surrounding her."},{"id":"semetey-1-2013:p0979:b005:l024","ordinal":150884,"en":"Now God had struck the woman;"},{"id":"semetey-1-2013:p0979:b005:l025","ordinal":150885,"en":"The delicate Chachykey"},{"id":"semetey-1-2013:p0979:b005:l026","ordinal":150886,"en":"Spoke to the daughters-in-law:"},{"id":"semetey-1-2013:p0979:b005:l027","ordinal":150887,"en":"“The end time has surely come!"},{"id":"semetey-1-2013:p0979:b005:l028","ordinal":150888,"en":"Some accursed man seeking a master"},{"id":"semetey-1-2013:p0979:b005:l029","ordinal":150889,"en":"Must have taken away"},{"id":"semetey-1-2013:p0979:b005:l030","ordinal":150890,"en":"Badisha’s falcon.”"},{"id":"semetey-1-2013:p0979:b005:l031","ordinal":150891,"en":"Grieving when she saw the boys,"},{"id":"semetey-1-2013:p0979:b005:l032","ordinal":150892,"en":"The delicate woman Chachykey"},{"id":"semetey-1-2013:p0979:b005:l033","ordinal":150893,"en":"Rushed down from the tower"},{"id":"semetey-1-2013:p0979:b005:l034","ordinal":150894,"en":"And came hurtling below."},{"id":"semetey-1-2013:p0979:b005:l035","ordinal":150895,"en":"“The accursed thing has led him astray"},{"id":"semetey-1-2013:p0979:b005:l036","ordinal":150896,"en":"And taken it in the end,” she said."},{"id":"semetey-1-2013:p0979:b005:l037","ordinal":150897,"en":"Her dear eyes, like a quail’s,"},{"id":"semetey-1-2013:p0979:b005:l038","ordinal":150898,"en":"Shed tears in separate streams;"},{"id":"semetey-1-2013:p0979:b005:l039","ordinal":150899,"en":"She sobbed and wept uncontrollably,"}]
