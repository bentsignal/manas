[{"id":"semetey-1-2013:p1234:b003:l006","ordinal":171265,"en":"Scattered like millet."},{"id":"semetey-1-2013:p1234:b003:l007","ordinal":171266,"en":"When visible, he appeared;"},{"id":"semetey-1-2013:p1234:b003:l008","ordinal":171267,"en":"When Surkoen was unseen,"},{"id":"semetey-1-2013:p1234:b003:l009","ordinal":171268,"en":"He became a bank of blue smoke."},{"id":"semetey-1-2013:p1234:b003:l010","ordinal":171269,"en":"The earth split in a rushing wake;"},{"id":"semetey-1-2013:p1234:b003:l011","ordinal":171270,"en":"Then the Jediger man"},{"id":"semetey-1-2013:p1234:b003:l012","ordinal":171271,"en":"Fled back toward his people."},{"id":"semetey-1-2013:p1234:b003:l013","ordinal":171272,"en":"Almambet's Kulchoro"},{"id":"semetey-1-2013:p1234:b003:l014","ordinal":171273,"en":"Grieved in distress:"},{"id":"semetey-1-2013:p1234:b003:l015","ordinal":171274,"en":"\"By not drawing close at the end,"},{"id":"semetey-1-2013:p1234:b003:l016","ordinal":171275,"en":"I have acted foolishly."},{"id":"semetey-1-2013:p1234:b003:l017","ordinal":171276,"en":"By pursuing Toltoy from afar,"},{"id":"semetey-1-2013:p1234:b003:l018","ordinal":171277,"en":"I have acted like a child."},{"id":"semetey-1-2013:p1234:b003:l019","ordinal":171278,"en":"Will he escape beyond my reach"},{"id":"semetey-1-2013:p1234:b003:l020","ordinal":171279,"en":"And reach his people now?"},{"id":"semetey-1-2013:p1234:b003:l021","ordinal":171280,"en":"Failing to catch him like this,"},{"id":"semetey-1-2013:p1234:b003:l022","ordinal":171281,"en":"Will God take the Roan from me?"},{"id":"semetey-1-2013:p1234:b003:l023","ordinal":171282,"en":"My uncle deliberately sent"},{"id":"semetey-1-2013:p1234:b003:l024","ordinal":171283,"en":"Me, young Kulchoro."},{"id":"semetey-1-2013:p1234:b003:l025","ordinal":171284,"en":"Hero Toltoy was mountain-like,"},{"id":"semetey-1-2013:p1234:b003:l026","ordinal":171285,"en":"Yet he fled bobbing away."},{"id":"semetey-1-2013:p1234:b003:l027","ordinal":171286,"en":"God has struck down"},{"id":"semetey-1-2013:p1234:b003:l028","ordinal":171287,"en":"The calamity who came to take a wife,"},{"id":"semetey-1-2013:p1234:b003:l029","ordinal":171288,"en":"The infidel of perfect courage.\""},{"id":"semetey-1-2013:p1234:b003:l030","ordinal":171289,"en":"Hero Toltoy looked behind"},{"id":"semetey-1-2013:p1234:b003:l031","ordinal":171290,"en":"As he fled."},{"id":"semetey-1-2013:p1234:b003:l032","ordinal":171291,"en":"Kulchoro seized the black-jawed whip,"},{"id":"semetey-1-2013:p1234:b003:l033","ordinal":171292,"en":"Swung it around,"},{"id":"semetey-1-2013:p1234:b003:l034","ordinal":171293,"en":"And lashed the doomed Roan"},{"id":"semetey-1-2013:p1234:b003:l035","ordinal":171294,"en":"Across the belly,"},{"id":"semetey-1-2013:p1234:b003:l036","ordinal":171295,"en":"Pursuing him."},{"id":"semetey-1-2013:p1234:b003:l037","ordinal":171296,"en":"Straining as though unable to catch him,"},{"id":"semetey-1-2013:p1234:b003:l038","ordinal":171297,"en":"Kulchoro came then,"},{"id":"semetey-1-2013:p1234:b003:l039","ordinal":171298,"en":"Quarreling with Taybuurul."},{"id":"semetey-1-2013:p1234:b004:l001","ordinal":171299,"en":"\"You were a racehorse, damn you!"},{"id":"semetey-1-2013:p1234:b004:l002","ordinal":171300,"en":"Roan, what has happened to you?"},{"id":"semetey-1-2013:p1234:b004:l003","ordinal":171301,"en":"Will Toltoy truly get away,"},{"id":"semetey-1-2013:p1234:b004:l004","ordinal":171302,"en":"Fleeing beyond my reach?\""},{"id":"semetey-1-2013:p1234:b004:l005","ordinal":171303,"en":"The mountain-like Taybuurul"},{"id":"semetey-1-2013:p1234:b004:l006","ordinal":171304,"en":"Had failed to catch him at a run."},{"id":"semetey-1-2013:p1234:b004:l007","ordinal":171305,"en":"Aychurok, daughter of Akun,"},{"id":"semetey-1-2013:p1234:b004:l008","ordinal":171306,"en":"Had pampered and fed him,"},{"id":"semetey-1-2013:p1234:b004:l009","ordinal":171307,"en":"And he had grown too fat."},{"id":"semetey-1-2013:p1234:b004:l010","ordinal":171308,"en":"Unable to lower his head,"},{"id":"semetey-1-2013:p1234:b004:l011","ordinal":171309,"en":"Unable to stride like an argali,"},{"id":"semetey-1-2013:p1234:b004:l012","ordinal":171310,"en":"The doomed beast"},{"id":"semetey-1-2013:p1234:b004:l013","ordinal":171311,"en":"Was covered in foaming sweat."},{"id":"semetey-1-2013:p1234:b004:l014","ordinal":171312,"en":"Clean sweat broke out and restored him;"},{"id":"semetey-1-2013:p1234:b004:l015","ordinal":171313,"en":"He bent his neck like a stag."},{"id":"semetey-1-2013:p1234:b004:l016","ordinal":171314,"en":"When a ravine a spear's length wide appeared,"},{"id":"semetey-1-2013:p1234:b004:l017","ordinal":171315,"en":"He leapt without hesitation."},{"id":"semetey-1-2013:p1234:b004:l018","ordinal":171316,"en":"His mind was truly a tulpar's;"},{"id":"semetey-1-2013:p1234:b004:l019","ordinal":171317,"en":"Was he not a mountain-like tulpar?"},{"id":"semetey-1-2013:p1234:b004:l020","ordinal":171318,"en":"The wind could not match his gallop;"},{"id":"semetey-1-2013:p1234:b004:l021","ordinal":171319,"en":"The wind-spirit beast"},{"id":"semetey-1-2013:p1234:b004:l022","ordinal":171320,"en":"Lowered his head to the earth"},{"id":"semetey-1-2013:p1234:b004:l023","ordinal":171321,"en":"And took an argali's stride."},{"id":"semetey-1-2013:p1234:b004:l024","ordinal":171322,"en":"The wind could not match his gallop;"},{"id":"semetey-1-2013:p1234:b004:l025","ordinal":171323,"en":"He ran with perfect speed."},{"id":"semetey-1-2013:p1234:b004:l026","ordinal":171324,"en":"No livestock could match his pace;"},{"id":"semetey-1-2013:p1234:b004:l027","ordinal":171325,"en":"He ran in an extraordinary way."},{"id":"semetey-1-2013:p1234:b004:l028","ordinal":171326,"en":"Shimmering like a spirit,"},{"id":"semetey-1-2013:p1234:b004:l029","ordinal":171327,"en":"The doomed Taybuurul"},{"id":"semetey-1-2013:p1234:b004:l030","ordinal":171328,"en":"Drew close enough"},{"id":"semetey-1-2013:p1234:b004:l031","ordinal":171329,"en":"To catch Toltoy of the Jediger."},{"id":"semetey-1-2013:p1234:b004:l032","ordinal":171330,"en":"From the feather-grass ridge,"},{"id":"semetey-1-2013:p1234:b004:l033","ordinal":171331,"en":"From the high-shouldered rise,"},{"id":"semetey-1-2013:p1234:b004:l034","ordinal":171332,"en":"He rode alongside."},{"id":"semetey-1-2013:p1234:b004:l035","ordinal":171333,"en":"Clever Kulchoro"},{"id":"semetey-1-2013:p1234:b004:l036","ordinal":171334,"en":"Was deceiving Toltoy of the Jediger"},{"id":"semetey-1-2013:p1234:b004:l037","ordinal":171335,"en":"As they went."},{"id":"semetey-1-2013:p1234:b004:l038","ordinal":171336,"en":"\"Bridegroom Toltoy, wait!"},{"id":"semetey-1-2013:p1234:b004:l039","ordinal":171337,"en":"Turn your horse's head!\""},{"id":"semetey-1-2013:p1235:b003:l001","ordinal":171338,"en":"These were my elder sister's words:"},{"id":"semetey-1-2013:p1235:b003:l002","ordinal":171339,"en":"\"Go out and meet"},{"id":"semetey-1-2013:p1235:b003:l003","ordinal":171340,"en":"Your valiant brother-in-law Toltoy.\""},{"id":"semetey-1-2013:p1235:b003:l004","ordinal":171341,"en":"Do not swagger away, poor man;"},{"id":"semetey-1-2013:p1235:b003:l005","ordinal":171342,"en":"Stand there where you are!"},{"id":"semetey-1-2013:p1235:b003:l006","ordinal":171343,"en":"You have come as a bridegroom—"},{"id":"semetey-1-2013:p1235:b003:l007","ordinal":171344,"en":"Is a bridegroom like you?"},{"id":"semetey-1-2013:p1235:b003:l008","ordinal":171345,"en":"Does a bridegroom cross"},{"id":"semetey-1-2013:p1235:b003:l009","ordinal":171346,"en":"A saddle-backed ridge?"},{"id":"semetey-1-2013:p1235:b003:l010","ordinal":171347,"en":"Does one come courting"},{"id":"semetey-1-2013:p1235:b003:l011","ordinal":171348,"en":"And then flee again?"},{"id":"semetey-1-2013:p1235:b003:l012","ordinal":171349,"en":"Can a bridegroom who runs away"},{"id":"semetey-1-2013:p1235:b003:l013","ordinal":171350,"en":"Be called a proper bridegroom?"},{"id":"semetey-1-2013:p1235:b003:l014","ordinal":171351,"en":"These were Churok's words:"},{"id":"semetey-1-2013:p1235:b003:l015","ordinal":171352,"en":"\"Go out and meet"},{"id":"semetey-1-2013:p1235:b003:l016","ordinal":171353,"en":"Your mountain-like brother-in-law.\""},{"id":"semetey-1-2013:p1235:b003:l017","ordinal":171354,"en":"Turn your horse's head;"},{"id":"semetey-1-2013:p1235:b003:l018","ordinal":171355,"en":"Noble brother-in-law, wait!"},{"id":"semetey-1-2013:p1235:b003:l019","ordinal":171356,"en":"Thirty brides and thirty girls"},{"id":"semetey-1-2013:p1235:b003:l020","ordinal":171357,"en":"Have begun their games in a stream;"},{"id":"semetey-1-2013:p1235:b003:l021","ordinal":171358,"en":"Among them your wife"},{"id":"semetey-1-2013:p1235:b003:l022","ordinal":171359,"en":"Sways like a fairy."},{"id":"semetey-1-2013:p1235:b003:l023","ordinal":171360,"en":"Appearing like a whole world,"},{"id":"semetey-1-2013:p1235:b003:l024","ordinal":171361,"en":"They came out separately to meet you,"},{"id":"semetey-1-2013:p1235:b003:l025","ordinal":171362,"en":"Saying, \"The gray-maned bridegroom comes.\""},{"id":"semetey-1-2013:p1235:b003:l026","ordinal":171363,"en":"If you play, there are games and laughter;"},{"id":"semetey-1-2013:p1235:b003:l027","ordinal":171364,"en":"There are riches for the entertainment!"},{"id":"semetey-1-2013:p1235:b003:l028","ordinal":171365,"en":"Do not flee the pursuer;"},{"id":"semetey-1-2013:p1235:b003:l029","ordinal":171366,"en":"My dear brother-in-law,"},{"id":"semetey-1-2013:p1235:b003:l030","ordinal":171367,"en":"Swollen with pride before his in-laws,"},{"id":"semetey-1-2013:p1235:b003:l031","ordinal":171368,"en":"Can a bridegroom flee?"},{"id":"semetey-1-2013:p1235:b003:l032","ordinal":171369,"en":"If we flee trembling,"},{"id":"semetey-1-2013:p1235:b003:l033","ordinal":171370,"en":"Can we be called a bridegroom?"},{"id":"semetey-1-2013:p1235:b003:l034","ordinal":171371,"en":"Hey, brother-in-law, wait;"},{"id":"semetey-1-2013:p1235:b003:l035","ordinal":171372,"en":"Turn your horse's head."},{"id":"semetey-1-2013:p1235:b003:l036","ordinal":171373,"en":"Does a man come courting in a swagger"},{"id":"semetey-1-2013:p1235:b003:l037","ordinal":171374,"en":"And then flee?"},{"id":"semetey-1-2013:p1235:b003:l038","ordinal":171375,"en":"Can a bridegroom who loses his wits"},{"id":"semetey-1-2013:p1235:b003:l039","ordinal":171376,"en":"And panics be called a bridegroom?"},{"id":"semetey-1-2013:p1235:b005:l001","ordinal":171377,"en":"As though he had seen his captor,"},{"id":"semetey-1-2013:p1235:b005:l002","ordinal":171378,"en":"Can a bridegroom bolt toward his village"},{"id":"semetey-1-2013:p1235:b005:l003","ordinal":171379,"en":"And flee?"},{"id":"semetey-1-2013:p1235:b005:l004","ordinal":171380,"en":"Kulchoro kept deceiving him."},{"id":"semetey-1-2013:p1235:b005:l005","ordinal":171381,"en":"Would hero Toltoy, who had seen spirits,"},{"id":"semetey-1-2013:p1235:b005:l006","ordinal":171382,"en":"Stop for deception?"},{"id":"semetey-1-2013:p1235:b005:l007","ordinal":171383,"en":"Would he turn his horse's head?"},{"id":"semetey-1-2013:p1235:b005:l008","ordinal":171384,"en":"Would God strike Toltoy"},{"id":"semetey-1-2013:p1235:b005:l009","ordinal":171385,"en":"By making him stop for a boy?"},{"id":"semetey-1-2013:p1235:b005:l010","ordinal":171386,"en":"Unless his head were severed,"},{"id":"semetey-1-2013:p1235:b005:l011","ordinal":171387,"en":"Would your hero Toltoy stop?"},{"id":"semetey-1-2013:p1235:b005:l012","ordinal":171388,"en":"\"His voice has drawn near,\" he said."},{"id":"semetey-1-2013:p1235:b005:l013","ordinal":171389,"en":"Hero Toltoy truly fled,"},{"id":"semetey-1-2013:p1235:b005:l014","ordinal":171390,"en":"Whipping Surkoen;"},{"id":"semetey-1-2013:p1235:b005:l015","ordinal":171391,"en":"Hero Toltoy truly fled."},{"id":"semetey-1-2013:p1235:b005:l016","ordinal":171392,"en":"Dear Toltoy floundered,"},{"id":"semetey-1-2013:p1235:b005:l017","ordinal":171393,"en":"Both coat skirts flapping;"},{"id":"semetey-1-2013:p1235:b005:l018","ordinal":171394,"en":"Hero Toltoy fled clumsily."},{"id":"semetey-1-2013:p1235:b005:l019","ordinal":171395,"en":"After Toltoy fled without stopping,"},{"id":"semetey-1-2013:p1235:b005:l020","ordinal":171396,"en":"Kulchoro spoke the truth,"},{"id":"semetey-1-2013:p1235:b005:l021","ordinal":171397,"en":"Telling every secret"},{"id":"semetey-1-2013:p1235:b005:l022","ordinal":171398,"en":"Within him:"},{"id":"semetey-1-2013:p1235:b005:l023","ordinal":171399,"en":"\"Turn your horse's head;"},{"id":"semetey-1-2013:p1235:b005:l024","ordinal":171400,"en":"Hero Toltoy, wait!"},{"id":"semetey-1-2013:p1235:b005:l025","ordinal":171401,"en":"If you ask who I am,"},{"id":"semetey-1-2013:p1235:b005:l026","ordinal":171402,"en":"I am God's beloved servant,"},{"id":"semetey-1-2013:p1235:b005:l027","ordinal":171403,"en":"A companion of Khan Manas,"},{"id":"semetey-1-2013:p1235:b005:l028","ordinal":171404,"en":"The Chinese Almambet's son."},{"id":"semetey-1-2013:p1235:b005:l029","ordinal":171405,"en":"When he was dead,"},{"id":"semetey-1-2013:p1235:b005:l030","ordinal":171406,"en":"I was a slave in a dog's hide;"},{"id":"semetey-1-2013:p1235:b005:l031","ordinal":171407,"en":"While he lived,"},{"id":"semetey-1-2013:p1235:b005:l032","ordinal":171408,"en":"I was a slave in a sheep's hide."},{"id":"semetey-1-2013:p1235:b005:l033","ordinal":171409,"en":"If you ask my lineage,"},{"id":"semetey-1-2013:p1235:b005:l034","ordinal":171410,"en":"I was Semetey's servant."},{"id":"semetey-1-2013:p1235:b005:l035","ordinal":171411,"en":"Turn back and stand;"},{"id":"semetey-1-2013:p1235:b005:l036","ordinal":171412,"en":"Come unleash a great tumult."},{"id":"semetey-1-2013:p1235:b005:l037","ordinal":171413,"en":"Take my horse and me"},{"id":"semetey-1-2013:p1235:b005:l038","ordinal":171414,"en":"Away as plunder!"},{"id":"semetey-1-2013:p1235:b005:l039","ordinal":171415,"en":"If you are mighty, Toltoy,"},{"id":"semetey-1-2013:p1236:b003:l001","ordinal":171416,"en":"Sate yourself with this one spoil!"},{"id":"semetey-1-2013:p1236:b003:l002","ordinal":171417,"en":"I am a boy of twelve,"},{"id":"semetey-1-2013:p1236:b003:l003","ordinal":171418,"en":"I am a youth lacking wisdom."},{"id":"semetey-1-2013:p1236:b003:l004","ordinal":171419,"en":"If you are a man, Toltoy,"},{"id":"semetey-1-2013:p1236:b003:l005","ordinal":171420,"en":"Turn your stallion's head;"},{"id":"semetey-1-2013:p1236:b003:l006","ordinal":171421,"en":"If you are a hero, hero Toltoy,"},{"id":"semetey-1-2013:p1236:b003:l007","ordinal":171422,"en":"Turn and stand nearby!"},{"id":"semetey-1-2013:p1236:b003:l008","ordinal":171423,"en":"Give us one spectacle;"},{"id":"semetey-1-2013:p1236:b003:l009","ordinal":171424,"en":"Take this twelve-year-old boy"},{"id":"semetey-1-2013:p1236:b003:l010","ordinal":171425,"en":"Away as plunder!"},{"id":"semetey-1-2013:p1236:b003:l011","ordinal":171426,"en":"Does a heroic man flee?"},{"id":"semetey-1-2013:p1236:b003:l012","ordinal":171427,"en":"Does a hero panic and hurry?"},{"id":"semetey-1-2013:p1236:b003:l013","ordinal":171428,"en":"If you are a hero, Toltoy,"},{"id":"semetey-1-2013:p1236:b003:l014","ordinal":171429,"en":"Does a hero flee from a boy?"},{"id":"semetey-1-2013:p1236:b003:l015","ordinal":171430,"en":"Arbuurul beneath me"},{"id":"semetey-1-2013:p1236:b003:l016","ordinal":171431,"en":"Was Semetey's horse."},{"id":"semetey-1-2013:p1236:b003:l017","ordinal":171432,"en":"Do not flee sprawling, hero Toltoy;"},{"id":"semetey-1-2013:p1236:b003:l018","ordinal":171433,"en":"If you take it as plunder, you will be enriched."},{"id":"semetey-1-2013:p1236:b003:l019","ordinal":171434,"en":"You were a hero, hero Toltoy;"},{"id":"semetey-1-2013:p1236:b003:l020","ordinal":171435,"en":"Are you a mare, that you flee?"},{"id":"semetey-1-2013:p1236:b003:l021","ordinal":171436,"en":"If your courage is true,"},{"id":"semetey-1-2013:p1236:b003:l022","ordinal":171437,"en":"Sate yourself with bloody blood;"},{"id":"semetey-1-2013:p1236:b003:l023","ordinal":171438,"en":"Stand without fleeing and fight."},{"id":"semetey-1-2013:p1236:b003:l024","ordinal":171439,"en":"Hold straight and thrust spears,"},{"id":"semetey-1-2013:p1236:b003:l025","ordinal":171440,"en":"Fight until one is finished;"},{"id":"semetey-1-2013:p1236:b003:l026","ordinal":171441,"en":"Joust with spear in hand,"},{"id":"semetey-1-2013:p1236:b003:l027","ordinal":171442,"en":"And if you have the means, take me."},{"id":"semetey-1-2013:p1236:b003:l028","ordinal":171443,"en":"If you are mighty, hero Toltoy,"},{"id":"semetey-1-2013:p1236:b003:l029","ordinal":171444,"en":"Bring calamity upon my head!"},{"id":"semetey-1-2013:p1236:b003:l030","ordinal":171445,"en":"Does a hero spare a boy?"},{"id":"semetey-1-2013:p1236:b003:l031","ordinal":171446,"en":"Is it proper to flee from a boy?\""},{"id":"semetey-1-2013:p1236:b003:l032","ordinal":171447,"en":"When the boy spoke thus,"},{"id":"semetey-1-2013:p1236:b003:l033","ordinal":171448,"en":"Fleeing hero Toltoy"},{"id":"semetey-1-2013:p1236:b003:l034","ordinal":171449,"en":"Stretched the drum,"},{"id":"semetey-1-2013:p1236:b003:l035","ordinal":171450,"en":"Struck Surkoen,"},{"id":"semetey-1-2013:p1236:b003:l036","ordinal":171451,"en":"And leopard Toltoy then"},{"id":"semetey-1-2013:p1236:b003:l037","ordinal":171452,"en":"Whipped from side to side,"},{"id":"semetey-1-2013:p1236:b003:l038","ordinal":171453,"en":"Spurred both ways,"},{"id":"semetey-1-2013:p1236:b003:l039","ordinal":171454,"en":"And fled enormously."},{"id":"semetey-1-2013:p1236:b004:l001","ordinal":171455,"en":"Dear gray-maned Toltoy's"},{"id":"semetey-1-2013:p1236:b004:l002","ordinal":171456,"en":"Eyes darted wildly,"},{"id":"semetey-1-2013:p1236:b004:l003","ordinal":171457,"en":"And his legs dangled loose."},{"id":"semetey-1-2013:p1236:b004:l004","ordinal":171458,"en":"Without turning aside, hero Toltoy"},{"id":"semetey-1-2013:p1236:b004:l005","ordinal":171459,"en":"Fled with a roar."},{"id":"semetey-1-2013:p1236:b004:l006","ordinal":171460,"en":"Without looking around"},{"id":"semetey-1-2013:p1236:b004:l007","ordinal":171461,"en":"Or sparing his own life,"},{"id":"semetey-1-2013:p1236:b004:l008","ordinal":171462,"en":"Kulchoro pursued him."},{"id":"semetey-1-2013:p1236:b004:l009","ordinal":171463,"en":"Black-bay thoroughbred,"},{"id":"semetey-1-2013:p1236:b004:l010","ordinal":171464,"en":"Sieve-lunged and copper-winged,"},{"id":"semetey-1-2013:p1236:b004:l011","ordinal":171465,"en":"Spirit-like Roan horse"},{"id":"semetey-1-2013:p1236:b004:l012","ordinal":171466,"en":"Lowered his head to the earth"},{"id":"semetey-1-2013:p1236:b004:l013","ordinal":171467,"en":"And took an argali's stride."},{"id":"semetey-1-2013:p1236:b004:l014","ordinal":171468,"en":"He lowered his neck to the earth"},{"id":"semetey-1-2013:p1236:b004:l015","ordinal":171469,"en":"And ran beyond all measure."},{"id":"semetey-1-2013:p1236:b004:l016","ordinal":171470,"en":"His eyes reddened like a wild ram's;"},{"id":"semetey-1-2013:p1236:b004:l017","ordinal":171471,"en":"His stride lengthened with every step."},{"id":"semetey-1-2013:p1236:b004:l018","ordinal":171472,"en":"His hooves thundered on the earth;"},{"id":"semetey-1-2013:p1236:b004:l019","ordinal":171473,"en":"The black-steel bit"},{"id":"semetey-1-2013:p1236:b004:l020","ordinal":171474,"en":"Clattered in his throat."},{"id":"semetey-1-2013:p1236:b004:l021","ordinal":171475,"en":"Throwing his forelock to the sky,"},{"id":"semetey-1-2013:p1236:b004:l022","ordinal":171476,"en":"Beautiful racehorse Arbuurul"},{"id":"semetey-1-2013:p1236:b004:l023","ordinal":171477,"en":"Drove his hooves into the earth."},{"id":"semetey-1-2013:p1236:b004:l024","ordinal":171478,"en":"From the feather-grass ridge,"},{"id":"semetey-1-2013:p1236:b004:l025","ordinal":171479,"en":"From the high-shouldered rise,"},{"id":"semetey-1-2013:p1236:b004:l026","ordinal":171480,"en":"When the Roan came alongside,"},{"id":"semetey-1-2013:p1236:b004:l027","ordinal":171481,"en":"Shouting, \"Manas! Manas!\""},{"id":"semetey-1-2013:p1236:b004:l028","ordinal":171482,"en":"Calling the battle cry \"Manas,\""},{"id":"semetey-1-2013:p1236:b004:l029","ordinal":171483,"en":"Young Lord Kulchoro"},{"id":"semetey-1-2013:p1236:b004:l030","ordinal":171484,"en":"Raised the patterned spear,"},{"id":"semetey-1-2013:p1236:b004:l031","ordinal":171485,"en":"Turned the Roan's head,"},{"id":"semetey-1-2013:p1236:b004:l032","ordinal":171486,"en":"And leveled the patterned spear"},{"id":"semetey-1-2013:p1236:b004:l033","ordinal":171487,"en":"At Toltoy whom you have seen."},{"id":"semetey-1-2013:p1236:b004:l034","ordinal":171488,"en":"Kulchoro was an ocean;"},{"id":"semetey-1-2013:p1236:b004:l035","ordinal":171489,"en":"Without looking around,"},{"id":"semetey-1-2013:p1236:b004:l036","ordinal":171490,"en":"Without sparing his life at all,"},{"id":"semetey-1-2013:p1236:b004:l037","ordinal":171491,"en":"As the Roan passed alongside,"},{"id":"semetey-1-2013:p1236:b004:l038","ordinal":171492,"en":"He cried, \"Ah God, support me!\""},{"id":"semetey-1-2013:p1236:b004:l039","ordinal":171493,"en":"And then raised his spear."},{"id":"semetey-1-2013:p1237:b003:l001","ordinal":171494,"en":"Toltoy fled with a roar;"},{"id":"semetey-1-2013:p1237:b003:l002","ordinal":171495,"en":"Dear Choro spared no effort."},{"id":"semetey-1-2013:p1237:b003:l003","ordinal":171496,"en":"The leopard's patterned spear—"},{"id":"semetey-1-2013:p1237:b003:l004","ordinal":171497,"en":"Your valiant man aimed and held it,"},{"id":"semetey-1-2013:p1237:b003:l005","ordinal":171498,"en":"But could not thrust it flexing."},{"id":"semetey-1-2013:p1237:b003:l006","ordinal":171499,"en":"He had made his spear immense,"},{"id":"semetey-1-2013:p1237:b003:l007","ordinal":171500,"en":"Made his spear unwieldy:"},{"id":"semetey-1-2013:p1237:b003:l008","ordinal":171501,"en":"\"Would I not have ended"},{"id":"semetey-1-2013:p1237:b003:l009","ordinal":171502,"en":"Swaggering Toltoy's devices?"},{"id":"semetey-1-2013:p1237:b003:l010","ordinal":171503,"en":"He made the spear beyond measure,"},{"id":"semetey-1-2013:p1237:b003:l011","ordinal":171504,"en":"Made his spear unbounded;"},{"id":"semetey-1-2013:p1237:b003:l012","ordinal":171505,"en":"Had he made it more measured"},{"id":"semetey-1-2013:p1237:b003:l013","ordinal":171506,"en":"For Toltoy at the flank,"},{"id":"semetey-1-2013:p1237:b003:l014","ordinal":171507,"en":"Would I not have ended his devices?\""},{"id":"semetey-1-2013:p1237:b003:l015","ordinal":171508,"en":"He strained, gripping the spear,"},{"id":"semetey-1-2013:p1237:b003:l016","ordinal":171509,"en":"But could not drive"},{"id":"semetey-1-2013:p1237:b003:l017","ordinal":171510,"en":"The leopard's patterned spear flexing,"},{"id":"semetey-1-2013:p1237:b003:l018","ordinal":171511,"en":"And quarreled with his uncle."},{"id":"semetey-1-2013:p1237:b003:l019","ordinal":171512,"en":"His waist bent forward,"},{"id":"semetey-1-2013:p1237:b003:l020","ordinal":171513,"en":"His eyes bulged,"},{"id":"semetey-1-2013:p1237:b003:l021","ordinal":171514,"en":"Early words became late,"},{"id":"semetey-1-2013:p1237:b003:l022","ordinal":171515,"en":"And young Lord Choro's"},{"id":"semetey-1-2013:p1237:b003:l023","ordinal":171516,"en":"Two eyes became four."},{"id":"semetey-1-2013:p1237:b003:l024","ordinal":171517,"en":"\"If only I could spear"},{"id":"semetey-1-2013:p1237:b003:l025","ordinal":171518,"en":"Swaggering Toltoy to the ground,"},{"id":"semetey-1-2013:p1237:b003:l026","ordinal":171519,"en":"Offer him as a sacrifice,"},{"id":"semetey-1-2013:p1237:b003:l027","ordinal":171520,"en":"Cut off his head and bind it,"}]
