[{"id":"sayakbay-ms-current145:pdf090:l009","ordinal":390145,"en":"Her watching eyes filled with tears"},{"id":"sayakbay-ms-current145:pdf090:l010","ordinal":390146,"en":"Sickness gripped all who remained"},{"id":"sayakbay-ms-current145:pdf090:l011","ordinal":390147,"en":"Saying the living still have strength"},{"id":"sayakbay-ms-current145:pdf090:l012","ordinal":390148,"en":"What the Creator placed upon her"},{"id":"sayakbay-ms-current145:pdf090:l013","ordinal":390149,"en":"Let the people hear and know"},{"id":"sayakbay-ms-current145:pdf090:l014","ordinal":390150,"en":"So the other one spoke"},{"id":"sayakbay-ms-current145:pdf090:l015","ordinal":390151,"en":"The peri-born Beybak"},{"id":"sayakbay-ms-current145:pdf090:l016","ordinal":390152,"en":"All the people waited"},{"id":"sayakbay-ms-current145:pdf090:l017","ordinal":390153,"en":"In the narrowness of her pain"},{"id":"sayakbay-ms-current145:pdf090:l018","ordinal":390154,"en":"Appearing hateful to the eye"},{"id":"sayakbay-ms-current145:pdf090:l019","ordinal":390155,"en":"Tears flowed from dear eyes"},{"id":"sayakbay-ms-current145:pdf090:l020","ordinal":390156,"en":"Bloody, washing her collar"},{"id":"sayakbay-ms-current145:pdf090:l021","ordinal":390157,"en":"Crying fiercely, gripping her waist"},{"id":"sayakbay-ms-current145:pdf090:l022","ordinal":390158,"en":"Smoke curled from her mouth"},{"id":"sayakbay-ms-current145:pdf090:l023","ordinal":390159,"en":"From this fatherless world"},{"id":"sayakbay-ms-current145:pdf090:l024","ordinal":390160,"en":"She neared the point of not remaining"},{"id":"sayakbay-ms-current145:pdf090:l025","ordinal":390161,"en":"Those watching gathered around"},{"id":"sayakbay-ms-current145:pdf090:l026","ordinal":390162,"en":"Standing there without cease"},{"id":"sayakbay-ms-current145:pdf090:l027","ordinal":390163,"en":"Clinging to poles in anguish"},{"id":"sayakbay-ms-current145:pdf090:l028","ordinal":390164,"en":"This plea went to God"},{"id":"sayakbay-ms-current145:pdf090:l029","ordinal":390165,"en":"Pleading to him alone"},{"id":"sayakbay-ms-current145:pdf090:l030","ordinal":390166,"en":"Her prayer was her only remedy"},{"id":"sayakbay-ms-current145:pdf090:l031","ordinal":390167,"en":"The dear soul they had found"},{"id":"sayakbay-ms-current145:pdf090:l032","ordinal":390168,"en":"Truly lay there in travail"},{"id":"sayakbay-ms-current145:pdf090:l033","ordinal":390169,"en":"Giving strength to her tiny life"},{"id":"sayakbay-ms-current145:pdf091:l001","ordinal":390170,"en":"The poor soul was filled with worry,"},{"id":"sayakbay-ms-current145:pdf091:l002","ordinal":390171,"en":"The seventy-year-old dervish Kydyr,"},{"id":"sayakbay-ms-current145:pdf091:l003","ordinal":390172,"en":"Whose turban was as large as a cauldron,"},{"id":"sayakbay-ms-current145:pdf091:l004","ordinal":390173,"en":"Whose shout sounded like the call to prayer,"},{"id":"sayakbay-ms-current145:pdf091:l005","ordinal":390174,"en":"Taking charge of the matter,"},{"id":"sayakbay-ms-current145:pdf091:l006","ordinal":390175,"en":"He spoke, saying, “Do not grieve,”"},{"id":"sayakbay-ms-current145:pdf091:l007","ordinal":390176,"en":"Speaking of what he perceived in the child,"},{"id":"sayakbay-ms-current145:pdf091:l008","ordinal":390177,"en":"The dervish of ninety tribes,"},{"id":"sayakbay-ms-current145:pdf091:l009","ordinal":390178,"en":"Reciting sacred words four at a time,"},{"id":"sayakbay-ms-current145:pdf091:l010","ordinal":390179,"en":"When they looked, it was Kydyr himself,"},{"id":"sayakbay-ms-current145:pdf091:l011","ordinal":390180,"en":"For the unfortunate Perizaada,"},{"id":"sayakbay-ms-current145:pdf091:l012","ordinal":390181,"en":"The time had come for him to be a firm companion,"},{"id":"sayakbay-ms-current145:pdf091:l013","ordinal":390182,"en":"Her supporter was Kydyr himself,"},{"id":"sayakbay-ms-current145:pdf091:l014","ordinal":390183,"en":"A fortunate means and occasion,"},{"id":"sayakbay-ms-current145:pdf091:l015","ordinal":390184,"en":"The time had come to leave what was bestowed,"},{"id":"sayakbay-ms-current145:pdf091:l016","ordinal":390185,"en":"The unfortunate Perizaada,"},{"id":"sayakbay-ms-current145:pdf091:l017","ordinal":390186,"en":"If she did not stray from the path,"},{"id":"sayakbay-ms-current145:pdf091:l018","ordinal":390187,"en":"The time had come for her protector to depart,"},{"id":"sayakbay-ms-current145:pdf091:l019","ordinal":390188,"en":"Straining himself over the child,"},{"id":"sayakbay-ms-current145:pdf091:l020","ordinal":390189,"en":"The time had come to give his blessing;"},{"id":"sayakbay-ms-current145:pdf091:l021","ordinal":390190,"en":"Saying, “Repent, Bermet, repent,”"},{"id":"sayakbay-ms-current145:pdf091:l022","ordinal":390191,"en":"Entrusting himself to Providence,"},{"id":"sayakbay-ms-current145:pdf091:l023","ordinal":390192,"en":"For the unfortunate Kydyr, [?],"},{"id":"sayakbay-ms-current145:pdf091:l024","ordinal":390193,"en":"He named him [?],"},{"id":"sayakbay-ms-current145:pdf091:l025","ordinal":390194,"en":"His whole body tingling upward,"},{"id":"sayakbay-ms-current145:pdf091:l026","ordinal":390195,"en":"Hearing the suddenly uttered command,"},{"id":"sayakbay-ms-current145:pdf091:l027","ordinal":390196,"en":"A person without an elder brother—oh, elder sister,"},{"id":"sayakbay-ms-current145:pdf091:l028","ordinal":390197,"en":"This is the deed that remained from then."},{"id":"sayakbay-ms-current145:pdf091:l029","ordinal":390198,"en":"The transience of the world,"},{"id":"sayakbay-ms-current145:pdf091:l030","ordinal":390199,"en":"May he become a shield for the people,"},{"id":"sayakbay-ms-current145:pdf091:l031","ordinal":390200,"en":"You are the lamb of the Undying One,"},{"id":"sayakbay-ms-current145:pdf091:l032","ordinal":390201,"en":"Protecting the people when the multitude is thrown into turmoil,"},{"id":"sayakbay-ms-current145:pdf092:l001","ordinal":390202,"en":"A resounding voice came from the hero,"},{"id":"sayakbay-ms-current145:pdf092:l002","ordinal":390203,"en":"A sacred voice rang out,"},{"id":"sayakbay-ms-current145:pdf092:l003","ordinal":390204,"en":"Thus he spoke words about the child,"},{"id":"sayakbay-ms-current145:pdf092:l004","ordinal":390205,"en":"When they looked, he could not be seen,"},{"id":"sayakbay-ms-current145:pdf092:l005","ordinal":390206,"en":"No one knew where he was,"},{"id":"sayakbay-ms-current145:pdf092:l006","ordinal":390207,"en":"Kydyr had bestowed the name,"},{"id":"sayakbay-ms-current145:pdf092:l007","ordinal":390208,"en":"Their hearts ached, but he was gone,"},{"id":"sayakbay-ms-current145:pdf092:l008","ordinal":390209,"en":"The man who had spoken these words,"},{"id":"sayakbay-ms-current145:pdf092:l009","ordinal":390210,"en":"Had vanished from sight."},{"id":"sayakbay-ms-current145:pdf092:l010","ordinal":390211,"en":"Kydyr [?],"},{"id":"sayakbay-ms-current145:pdf092:l011","ordinal":390212,"en":"On the stirring Nights of Power,"},{"id":"sayakbay-ms-current145:pdf092:l012","ordinal":390213,"en":"The unfortunate Perizaada,"},{"id":"sayakbay-ms-current145:pdf092:l013","ordinal":390214,"en":"Rose suddenly to her feet,"},{"id":"sayakbay-ms-current145:pdf092:l014","ordinal":390215,"en":"Before one could say a word,"},{"id":"sayakbay-ms-current145:pdf092:l015","ordinal":390216,"en":"In the blink of an eye,"},{"id":"sayakbay-ms-current145:pdf092:l016","ordinal":390217,"en":"While she stood looking at her child,"},{"id":"sayakbay-ms-current145:pdf092:l017","ordinal":390218,"en":"He vanished from sight,"},{"id":"sayakbay-ms-current145:pdf092:l018","ordinal":390219,"en":"“As I see it, that is how it was.”"},{"id":"sayakbay-ms-current145:pdf092:l019","ordinal":390220,"en":"Giving Bermet a blessing,"},{"id":"sayakbay-ms-current145:pdf092:l020","ordinal":390221,"en":"The time had come for it to settle upon her;"},{"id":"sayakbay-ms-current145:pdf092:l021","ordinal":390222,"en":"Taking the radiant child,"},{"id":"sayakbay-ms-current145:pdf092:l025","ordinal":390223,"en":"At the very midpoint [?],"},{"id":"sayakbay-ms-current145:pdf092:l028","ordinal":390224,"en":"Kydyr parted from them for paradise,"},{"id":"sayakbay-ms-current145:pdf092:l029","ordinal":390225,"en":"Like dung [?],"},{"id":"sayakbay-ms-current145:pdf092:l030","ordinal":390226,"en":"Wondrous was the deed wrought by Kydyr,"},{"id":"sayakbay-ms-current145:pdf093:l001","ordinal":390227,"en":"Dismounting at Makooluk,"},{"id":"sayakbay-ms-current145:pdf093:l002","ordinal":390228,"en":"The sun shone overhead,"},{"id":"sayakbay-ms-current145:pdf093:l003","ordinal":390229,"en":"Day and night appeared bright,"},{"id":"sayakbay-ms-current145:pdf093:l004","ordinal":390230,"en":"The clouding of the sun vanished,"},{"id":"sayakbay-ms-current145:pdf093:l005","ordinal":390231,"en":"Then Zholtoi quickly saw,"},{"id":"sayakbay-ms-current145:pdf093:l008","ordinal":390232,"en":"The child descended, beaming,"},{"id":"sayakbay-ms-current145:pdf093:l009","ordinal":390233,"en":"Thundering as though struck with force,"},{"id":"sayakbay-ms-current145:pdf093:l012","ordinal":390234,"en":"The unmoving host of enemies,"},{"id":"sayakbay-ms-current145:pdf093:l022","ordinal":390235,"en":"“Distinct from all the others,”"},{"id":"sayakbay-ms-current145:pdf093:l023","ordinal":390236,"en":"“There is a fully formed son,”"},{"id":"sayakbay-ms-current145:pdf093:l032","ordinal":390237,"en":"Settle among the people made pale,"},{"id":"sayakbay-ms-current145:pdf093:l033","ordinal":390238,"en":"Settle among the clamoring people too,"},{"id":"sayakbay-ms-current145:pdf094:l001","ordinal":390239,"en":"While the child stood crying loudly,"},{"id":"sayakbay-ms-current145:pdf094:l002","ordinal":390240,"en":"The people entering the house saw him,"},{"id":"sayakbay-ms-current145:pdf094:l003","ordinal":390241,"en":"Twelve old women, because of the child,"},{"id":"sayakbay-ms-current145:pdf094:l004","ordinal":390242,"en":"Sat with their hearts overcome,"},{"id":"sayakbay-ms-current145:pdf094:l005","ordinal":390243,"en":"His young companions hurried,"},{"id":"sayakbay-ms-current145:pdf094:l006","ordinal":390244,"en":"The children gathered to play,"},{"id":"sayakbay-ms-current145:pdf094:l007","ordinal":390245,"en":"Many young women reached out their hands,"},{"id":"sayakbay-ms-current145:pdf094:l008","ordinal":390246,"en":"They fluttered about radiantly."},{"id":"sayakbay-ms-current145:pdf094:l011","ordinal":390247,"en":"Each cried out and spoke distinctly,"},{"id":"sayakbay-ms-current145:pdf094:l012","ordinal":390248,"en":"A song for springtime play,"},{"id":"sayakbay-ms-current145:pdf094:l013","ordinal":390249,"en":"The sovereign of campaigns and war,"},{"id":"sayakbay-ms-current145:pdf094:l016","ordinal":390250,"en":"Black waters came from many sides,"},{"id":"sayakbay-ms-current145:pdf094:l017","ordinal":390251,"en":"Dust rose as a lamb-flock moved,"},{"id":"sayakbay-ms-current145:pdf094:l019","ordinal":390252,"en":"For the rite of noble Alake,"},{"id":"sayakbay-ms-current145:pdf094:l021","ordinal":390253,"en":"And to the one upon that plain,"},{"id":"sayakbay-ms-current145:pdf094:l026","ordinal":390254,"en":"And went to the people of Kemin."},{"id":"sayakbay-ms-current145:pdf095:l001","ordinal":390255,"en":"Fashioned at the center of the earth"},{"id":"sayakbay-ms-current145:pdf095:l002","ordinal":390256,"en":"Today the appointed time had come"},{"id":"sayakbay-ms-current145:pdf095:l004","ordinal":390257,"en":"He was a warrior who roamed in struggle"},{"id":"sayakbay-ms-current145:pdf095:l005","ordinal":390258,"en":"His companion would be at his side"},{"id":"sayakbay-ms-current145:pdf095:l006","ordinal":390259,"en":"Now was the moment of sudden clangor"},{"id":"sayakbay-ms-current145:pdf095:l007","ordinal":390260,"en":"Saying, look beneath the earth"},{"id":"sayakbay-ms-current145:pdf095:l012","ordinal":390261,"en":"Hero Kenen stood gripping it"},{"id":"sayakbay-ms-current145:pdf095:l013","ordinal":390262,"en":"Ancient and true faith"},{"id":"sayakbay-ms-current145:pdf095:l017","ordinal":390263,"en":"This cry rang out"},{"id":"sayakbay-ms-current145:pdf095:l018","ordinal":390264,"en":"Black blood in his right hand"},{"id":"sayakbay-ms-current145:pdf095:l019","ordinal":390265,"en":"Shouting, he called upon the faith"},{"id":"sayakbay-ms-current145:pdf095:l020","ordinal":390266,"en":"His voice was heard by God"},{"id":"sayakbay-ms-current145:pdf095:l021","ordinal":390267,"en":"A soul who made wealth of the cauldron"},{"id":"sayakbay-ms-current145:pdf095:l022","ordinal":390268,"en":"Falling upon his breast"},{"id":"sayakbay-ms-current145:pdf095:l023","ordinal":390269,"en":"No bridle was placed upon another"},{"id":"sayakbay-ms-current145:pdf095:l024","ordinal":390270,"en":"Drive on, that child"},{"id":"sayakbay-ms-current145:pdf095:l025","ordinal":390271,"en":"As though to seize his face"},{"id":"sayakbay-ms-current145:pdf095:l026","ordinal":390272,"en":"The people screamed and the land stirred"},{"id":"sayakbay-ms-current145:pdf096:l008","ordinal":390273,"en":"His fortune rose from the young peak"},{"id":"sayakbay-ms-current145:pdf096:l011","ordinal":390274,"en":"What he said of the remaining time"},{"id":"sayakbay-ms-current145:pdf096:l014","ordinal":390275,"en":"Kenen’s majesty before the blue-clad people"},{"id":"sayakbay-ms-current145:pdf096:l018","ordinal":390276,"en":"When he spoke openly and fully"},{"id":"sayakbay-ms-current145:pdf096:l023","ordinal":390277,"en":"The valley’s moment had arrived"},{"id":"sayakbay-ms-current145:pdf096:l027","ordinal":390278,"en":"What he said of keeping his own secret"},{"id":"sayakbay-ms-current145:pdf096:l028","ordinal":390279,"en":"If it struck the evident stranger"},{"id":"sayakbay-ms-current145:pdf097:l002","ordinal":390280,"en":"Divine strength came to the banner"},{"id":"sayakbay-ms-current145:pdf097:l005","ordinal":390281,"en":"Making his birth a blessed seat of honor"},{"id":"sayakbay-ms-current145:pdf097:l006","ordinal":390282,"en":"Taking command of the people’s host"},{"id":"sayakbay-ms-current145:pdf097:l008","ordinal":390283,"en":"Kenen’s age would span much of the world"},{"id":"sayakbay-ms-current145:pdf097:l009","ordinal":390284,"en":"Saying God had given him to us"},{"id":"sayakbay-ms-current145:pdf097:l010","ordinal":390285,"en":"The people around the Amu"},{"id":"sayakbay-ms-current145:pdf097:l014","ordinal":390286,"en":"Smiling toward Perizada"},{"id":"sayakbay-ms-current145:pdf097:l016","ordinal":390287,"en":"When this companion of yours knew"},{"id":"sayakbay-ms-current145:pdf097:l017","ordinal":390288,"en":"The people’s questioning ended"},{"id":"sayakbay-ms-current145:pdf097:l018","ordinal":390289,"en":"A pouch was hung around his neck"},{"id":"sayakbay-ms-current145:pdf097:l019","ordinal":390290,"en":"So saying, they opened their hands in prayer"},{"id":"sayakbay-ms-current145:pdf097:l020","ordinal":390291,"en":"Pleading to the Creator"},{"id":"sayakbay-ms-current145:pdf097:l021","ordinal":390292,"en":"They held the feast under his rule"},{"id":"sayakbay-ms-current145:pdf097:l023","ordinal":390293,"en":"The people cried out and gathered"},{"id":"sayakbay-ms-current145:pdf097:l026","ordinal":390294,"en":"The people gathered around him"},{"id":"sayakbay-ms-current145:pdf097:l027","ordinal":390295,"en":"Shouting with a mighty roar"},{"id":"sayakbay-ms-current145:pdf097:l028","ordinal":390296,"en":"The people raised an immeasurable tumult"},{"id":"sayakbay-ms-current145:pdf097:l029","ordinal":390297,"en":"Paying no heed to their livestock"},{"id":"sayakbay-ms-current145:pdf097:l030","ordinal":390298,"en":"Slaughtering animals and piling meat"},{"id":"sayakbay-ms-current145:pdf097:l031","ordinal":390299,"en":"At the people’s center slaughtering gray stock"},{"id":"sayakbay-ms-current145:pdf098:l001","ordinal":390300,"en":"Heroes beyond counting"},{"id":"sayakbay-ms-current145:pdf098:l002","ordinal":390301,"en":"Two households moving as one"},{"id":"sayakbay-ms-current145:pdf098:l003","ordinal":390302,"en":"Slaughtering sheep for the contenders"},{"id":"sayakbay-ms-current145:pdf098:l004","ordinal":390303,"en":"Setting the people in order and holding a feast"},{"id":"sayakbay-ms-current145:pdf098:l005","ordinal":390304,"en":"The celebration grew vast"},{"id":"sayakbay-ms-current145:pdf098:l006","ordinal":390305,"en":"Kenen surged toward Kene"},{"id":"sayakbay-ms-current145:pdf098:l007","ordinal":390306,"en":"The arriving people gathered"},{"id":"sayakbay-ms-current145:pdf098:l008","ordinal":390307,"en":"Saying, may his son be a hero"},{"id":"sayakbay-ms-current145:pdf098:l009","ordinal":390308,"en":"They stood with hands raised"},{"id":"sayakbay-ms-current145:pdf098:l010","ordinal":390309,"en":"Cups upon cups of liquor"},{"id":"sayakbay-ms-current145:pdf098:l011","ordinal":390310,"en":"Saying, I am a warrior like you"},{"id":"sayakbay-ms-current145:pdf098:l012","ordinal":390311,"en":"They went about in celebration"},{"id":"sayakbay-ms-current145:pdf098:l013","ordinal":390312,"en":"The feast animals were slaughtered"},{"id":"sayakbay-ms-current145:pdf098:l014","ordinal":390313,"en":"The spoken consent was heard"},{"id":"sayakbay-ms-current145:pdf098:l015","ordinal":390314,"en":"Their old grudges were forgotten"},{"id":"sayakbay-ms-current145:pdf098:l016","ordinal":390315,"en":"Let no price be set above yours"},{"id":"sayakbay-ms-current145:pdf098:l017","ordinal":390316,"en":"Saying, go a little ahead"},{"id":"sayakbay-ms-current145:pdf098:l018","ordinal":390317,"en":"The sword shifted on his shoulder"},{"id":"sayakbay-ms-current145:pdf098:l019","ordinal":390318,"en":"Words flowed from the ground"},{"id":"sayakbay-ms-current145:pdf098:l020","ordinal":390319,"en":"Entering the tumult, they wrestled"},{"id":"sayakbay-ms-current145:pdf098:l021","ordinal":390320,"en":"A spectacle among the beasts"},{"id":"sayakbay-ms-current145:pdf098:l022","ordinal":390321,"en":"They plunged into the commotion"},{"id":"sayakbay-ms-current145:pdf098:l023","ordinal":390322,"en":"They joined in this talk"},{"id":"sayakbay-ms-current145:pdf098:l024","ordinal":390323,"en":"Knowing much without knowing all"},{"id":"sayakbay-ms-current145:pdf098:l025","ordinal":390324,"en":"They kept the words going"},{"id":"sayakbay-ms-current145:pdf098:l026","ordinal":390325,"en":"Companion Joltoy spoke"},{"id":"sayakbay-ms-current145:pdf098:l027","ordinal":390326,"en":"His two wishes were keen"},{"id":"sayakbay-ms-current145:pdf098:l028","ordinal":390327,"en":"They played the kok-boru game"},{"id":"sayakbay-ms-current145:pdf098:l029","ordinal":390328,"en":"Without lagging behind the colts"},{"id":"sayakbay-ms-current145:pdf098:l030","ordinal":390329,"en":"Testing themselves before the onlookers"},{"id":"sayakbay-ms-current145:pdf098:l031","ordinal":390330,"en":"Leading their swift hounds"},{"id":"sayakbay-ms-current145:pdf098:l032","ordinal":390331,"en":"The gray wolf spoke to the people"},{"id":"sayakbay-ms-current145:pdf099:l001","ordinal":390332,"en":"Driving back the raging ones"},{"id":"sayakbay-ms-current145:pdf099:l002","ordinal":390333,"en":"A thousand horses that had not gone out"},{"id":"sayakbay-ms-current145:pdf099:l003","ordinal":390334,"en":"Ninety red racers and camels"},{"id":"sayakbay-ms-current145:pdf099:l004","ordinal":390335,"en":"Loading them upon ninety camels"},{"id":"sayakbay-ms-current145:pdf099:l005","ordinal":390336,"en":"There was precious gold and ornament"},{"id":"sayakbay-ms-current145:pdf099:l006","ordinal":390337,"en":"There were amulets and clamor among the sheep"},{"id":"sayakbay-ms-current145:pdf099:l007","ordinal":390338,"en":"Take the world upon your fingertip"},{"id":"sayakbay-ms-current145:pdf099:l008","ordinal":390339,"en":"Fine posts for tethering horses"},{"id":"sayakbay-ms-current145:pdf099:l009","ordinal":390340,"en":"Fields for racing horses"},{"id":"sayakbay-ms-current145:pdf099:l010","ordinal":390341,"en":"Entrust livestock to livestock"},{"id":"sayakbay-ms-current145:pdf099:l011","ordinal":390342,"en":"Ride together and take my bird"},{"id":"sayakbay-ms-current145:pdf099:l012","ordinal":390343,"en":"Ask from land to land"},{"id":"sayakbay-ms-current145:pdf099:l013","ordinal":390344,"en":"As a father, raise the battle cry"},{"id":"sayakbay-ms-current145:pdf099:l014","ordinal":390345,"en":"Let your voice ring to the sky"},{"id":"sayakbay-ms-current145:pdf099:l015","ordinal":390346,"en":"A man turns back and freezes them"},{"id":"sayakbay-ms-current145:pdf099:l016","ordinal":390347,"en":"Such red kumys"},{"id":"sayakbay-ms-current145:pdf099:l017","ordinal":390348,"en":"I set camels by thousands and hundreds"},{"id":"sayakbay-ms-current145:pdf099:l018","ordinal":390349,"en":"After the Creator gave a child"},{"id":"sayakbay-ms-current145:pdf099:l019","ordinal":390350,"en":"I arrayed countless hosts equally"},{"id":"sayakbay-ms-current145:pdf099:l020","ordinal":390351,"en":"I set out herds abundant as spring"},{"id":"sayakbay-ms-current145:pdf099:l021","ordinal":390352,"en":"I offered abundant stock and worldly wealth"},{"id":"sayakbay-ms-current145:pdf099:l022","ordinal":390353,"en":"The people appointed Bermet"},{"id":"sayakbay-ms-current145:pdf099:l023","ordinal":390354,"en":"Making both humps stand high"},{"id":"sayakbay-ms-current145:pdf099:l024","ordinal":390355,"en":"Arching its neck like a duck"},{"id":"sayakbay-ms-current145:pdf099:l025","ordinal":390356,"en":"Choosing camels from the mountain"},{"id":"sayakbay-ms-current145:pdf099:l026","ordinal":390357,"en":"The greatest and finest among them"},{"id":"sayakbay-ms-current145:pdf099:l027","ordinal":390358,"en":"Saying your child is a hero"},{"id":"sayakbay-ms-current145:pdf099:l028","ordinal":390359,"en":"They bore him upon a pole-litter"},{"id":"sayakbay-ms-current145:pdf099:l029","ordinal":390360,"en":"From among their champions"},{"id":"sayakbay-ms-current145:pdf099:l030","ordinal":390361,"en":"To win the horse-racing prize"},{"id":"sayakbay-ms-current145:pdf099:l031","ordinal":390362,"en":"So as not to miss the gathering"},{"id":"sayakbay-ms-current145:pdf099:l032","ordinal":390363,"en":"Training chargers for the contest"},{"id":"sayakbay-ms-current145:pdf100:l001","ordinal":390364,"en":"Many prizes are here"},{"id":"sayakbay-ms-current145:pdf100:l002","ordinal":390365,"en":"To hold this contest"},{"id":"sayakbay-ms-current145:pdf100:l003","ordinal":390366,"en":"Becoming a spectacle before men’s eyes"},{"id":"sayakbay-ms-current145:pdf100:l004","ordinal":390367,"en":"A feast surpassing the world"},{"id":"sayakbay-ms-current145:pdf100:l007","ordinal":390368,"en":"Ninety kinds of entertainment"},{"id":"sayakbay-ms-current145:pdf100:l009","ordinal":390369,"en":"Fathers and sons dispersed"},{"id":"sayakbay-ms-current145:pdf100:l010","ordinal":390370,"en":"The heroes reached fulfillment"},{"id":"sayakbay-ms-current145:pdf100:l011","ordinal":390371,"en":"Taking seven camel colts"},{"id":"sayakbay-ms-current145:pdf100:l012","ordinal":390372,"en":"Seven men contested them"},{"id":"sayakbay-ms-current145:pdf100:l013","ordinal":390373,"en":"Saying, where is misfortune for me"},{"id":"sayakbay-ms-current145:pdf100:l014","ordinal":390374,"en":"Striking as they surged"},{"id":"sayakbay-ms-current145:pdf100:l015","ordinal":390375,"en":"His brief clear counsel"},{"id":"sayakbay-ms-current145:pdf100:l016","ordinal":390376,"en":"Saying, beast, what happened to you"},{"id":"sayakbay-ms-current145:pdf100:l017","ordinal":390377,"en":"Coming face to face with your father"},{"id":"sayakbay-ms-current145:pdf100:l018","ordinal":390378,"en":"The many you took became few"},{"id":"sayakbay-ms-current145:pdf100:l019","ordinal":390379,"en":"They stood as equals"},{"id":"sayakbay-ms-current145:pdf100:l020","ordinal":390380,"en":"Saying, child, come here"},{"id":"sayakbay-ms-current145:pdf100:l021","ordinal":390381,"en":"Resolving it and making peace"},{"id":"sayakbay-ms-current145:pdf100:l022","ordinal":390382,"en":"The celebration was boundless"},{"id":"sayakbay-ms-current145:pdf100:l023","ordinal":390383,"en":"Much of the evening passed"},{"id":"sayakbay-ms-current145:pdf100:l024","ordinal":390384,"en":"Saying the child was named"},{"id":"sayakbay-ms-current145:pdf100:l025","ordinal":390385,"en":"Orphans, widows, and the poor"},{"id":"sayakbay-ms-current145:pdf100:l026","ordinal":390386,"en":"Receiving charity and feasting"},{"id":"sayakbay-ms-current145:pdf100:l027","ordinal":390387,"en":"The qazi received his share"},{"id":"sayakbay-ms-current145:pdf100:l028","ordinal":390388,"en":"A vast world of abundant livestock"},{"id":"sayakbay-ms-current145:pdf100:l029","ordinal":390389,"en":"His gifts were scattered among the people"},{"id":"sayakbay-ms-current145:pdf100:l030","ordinal":390390,"en":"The hero-master found peace"},{"id":"sayakbay-ms-current145:pdf100:l031","ordinal":390391,"en":"All the earth became prosperous"},{"id":"sayakbay-ms-current145:pdf100:l032","ordinal":390392,"en":"While the people shared the spoils"},{"id":"sayakbay-ms-current145:pdf101:l001","ordinal":390393,"en":"Aytolkun marked out the palace ground"},{"id":"sayakbay-ms-current145:pdf101:l002","ordinal":390394,"en":"All proceeded in a row"},{"id":"sayakbay-ms-current145:pdf101:l003","ordinal":390395,"en":"They laid down the yellow robe"},{"id":"sayakbay-ms-current145:pdf101:l004","ordinal":390396,"en":"The father rode bareback"},{"id":"sayakbay-ms-current145:pdf101:l005","ordinal":390397,"en":"The people poured from the great feast"},{"id":"sayakbay-ms-current145:pdf101:l006","ordinal":390398,"en":"The broad city of Kenen"},{"id":"sayakbay-ms-current145:pdf101:l007","ordinal":390399,"en":"The feast crossed the bounds of the land"},{"id":"sayakbay-ms-current145:pdf101:l008","ordinal":390400,"en":"If his child lives safely"}]
