{"id": "sayakbay-ms-current146:pdf087:l042", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 87, "folio": 470, "line_in_page": 42, "raw": "Таңдын баары сөгүлүп,", "text": "Таңдын баары сөгүлүп,", "en": "All the seams of dawn opened,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf087:l043", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 87, "folio": 470, "line_in_page": 43, "raw": "Жерге жарык төгүлүп,", "text": "Жерге жарык төгүлүп,", "en": "Light poured upon the earth,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf087:l044", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 87, "folio": 470, "line_in_page": 44, "raw": "Таң атардын муздак жел", "text": "Таң атардын муздак жел", "en": "The cold wind before daybreak", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf087:l045", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 87, "folio": 470, "line_in_page": 45, "raw": "Өзөн ылдый зыркырап,", "text": "Өзөн ылдый зыркырап,", "en": "Whistled down the valley,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf087:l046", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 87, "folio": 470, "line_in_page": 46, "raw": "Жан-жаныбар макулук", "text": "Жан-жаныбар макулук", "en": "Every living creature", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf087:l047", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 87, "folio": 470, "line_in_page": 47, "raw": "Кыймылдап жерден чуркурап,", "text": "Кыймылдап жерден чуркурап,", "en": "Stirred and scurried over the ground,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf087:l048", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 87, "folio": 470, "line_in_page": 48, "raw": "Эл ойгонуп, журт дүрбөп,", "text": "Эл ойгонуп, журт дүрбөп,", "en": "The people awoke and the camp bustled,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf087:l049", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 87, "folio": 470, "line_in_page": 49, "raw": "Башадан буйрук болор деп,", "text": "Башадан буйрук болор деп,", "en": "Expecting an order from their commander,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf087:l050", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 87, "folio": 470, "line_in_page": 50, "raw": "Баары журт күтүп турду эле.", "text": "Баары журт күтүп турду эле.", "en": "All the people stood waiting.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
