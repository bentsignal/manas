[{"id":"manas-2010:p0970:b001:l022","ordinal":42497,"en":"He expressly sent."},{"id":"manas-2010:p0970:b001:l023","ordinal":42498,"en":"Ajybay went to gather news."},{"id":"manas-2010:p0970:b001:l024","ordinal":42499,"en":"Yraman's son Yrchy Uul,"},{"id":"manas-2010:p0970:b001:l025","ordinal":42500,"en":"With a tasselled drawstring of forty joints,"},{"id":"manas-2010:p0970:b001:l026","ordinal":42501,"en":"Old Kyrgyl, leader of the forty,"},{"id":"manas-2010:p0970:b001:l027","ordinal":42502,"en":"The mad elder who grew conceited at forty,"},{"id":"manas-2010:p0970:b001:l028","ordinal":42503,"en":"Shuutu the servant, his cap as big as a roof-felt,"},{"id":"manas-2010:p0970:b001:l029","ordinal":42504,"en":"Dark steel, broad-shouldered—"},{"id":"manas-2010:p0970:b001:l030","ordinal":42505,"en":"Have you heard of him?—"},{"id":"manas-2010:p0970:b001:l031","ordinal":42506,"en":"Chubak of Khan Baltay;"},{"id":"manas-2010:p0970:b001:l032","ordinal":42507,"en":"Golden-crested, with a fiery sash,"},{"id":"manas-2010:p0970:b001:l033","ordinal":42508,"en":"Almambet of Azizkan;"},{"id":"manas-2010:p0970:b001:l034","ordinal":42509,"en":"Baychoro of Khan Baabedin,"},{"id":"manas-2010:p0970:b001:l035","ordinal":42510,"en":"Skilled at fattening horses:"},{"id":"manas-2010:p0970:b001:l036","ordinal":42511,"en":"With Khan Manas among them,"},{"id":"manas-2010:p0970:b001:l037","ordinal":42512,"en":"Together they numbered forty."},{"id":"manas-2010:p0970:b001:l038","ordinal":42513,"en":"The forty companions, born as lions,"},{"id":"manas-2010:p0970:b001:l039","ordinal":42514,"en":"Who never withdrew a thrusting spear,"},{"id":"manas-2010:p0970:b001:l040","ordinal":42515,"en":"Never fled downcast from the enemy,"},{"id":"manas-2010:p0970:b001:l041","ordinal":42516,"en":"Girded with warriors' belts—"},{"id":"manas-2010:p0970:b001:l042","ordinal":42517,"en":"Though seven thousand foes should come,"},{"id":"manas-2010:p0971:b001:l001","ordinal":42518,"en":"One alone would attack them."},{"id":"manas-2010:p0971:b001:l002","ordinal":42519,"en":"Told to take a cap, they cut off a head:"},{"id":"manas-2010:p0971:b001:l003","ordinal":42520,"en":"Khan Manas's forty companions,"},{"id":"manas-2010:p0971:b001:l004","ordinal":42521,"en":"Like white-headed winged steeds among horses,"},{"id":"manas-2010:p0971:b001:l005","ordinal":42522,"en":"Almambet and Chubak among them,"},{"id":"manas-2010:p0971:b001:l006","ordinal":42523,"en":"At the people who had come to Talas"},{"id":"manas-2010:p0971:b001:l007","ordinal":42524,"en":"All alike were astonished."},{"id":"manas-2010:p0971:b001:l008","ordinal":42525,"en":"The steel weapons in their hands"},{"id":"manas-2010:p0971:b001:l009","ordinal":42526,"en":"They gripped, their straps wound round their wrists."},{"id":"manas-2010:p0971:b001:l010","ordinal":42527,"en":"The champions, wolves of war,"},{"id":"manas-2010:p0971:b001:l011","ordinal":42528,"en":"Bound battle-axes to their waists."},{"id":"manas-2010:p0971:b001:l012","ordinal":42529,"en":"All their weapons of war"},{"id":"manas-2010:p0971:b001:l013","ordinal":42530,"en":"They prepared and stood ready."},{"id":"manas-2010:p0971:b001:l014","ordinal":42531,"en":"The sovereign prophet's faith was pure;"},{"id":"manas-2010:p0971:b001:l015","ordinal":42532,"en":"A golden throne remained in Beijing."},{"id":"manas-2010:p0971:b001:l016","ordinal":42533,"en":"Almambet of Azizkan"},{"id":"manas-2010:p0971:b001:l017","ordinal":42534,"en":"Now turned Sarala's head,"},{"id":"manas-2010:p0971:b001:l018","ordinal":42535,"en":"And to stately Chubak"},{"id":"manas-2010:p0971:b001:l019","ordinal":42536,"en":"Spoke his counsel:"},{"id":"manas-2010:p0971:b001:l020","ordinal":42537,"en":"“If the enemy has come from Mecca,"},{"id":"manas-2010:p0971:b001:l021","ordinal":42538,"en":"You attack toward Mecca."},{"id":"manas-2010:p0971:b001:l022","ordinal":42539,"en":"If the enemy has come from Beijing,"},{"id":"manas-2010:p0971:b001:l023","ordinal":42540,"en":"Let me mount the horse Sarala"},{"id":"manas-2010:p0971:b001:l024","ordinal":42541,"en":"And attack toward Beijing."},{"id":"manas-2010:p0971:b001:l025","ordinal":42542,"en":"Holding a spear, breaking their ranks,"},{"id":"manas-2010:p0971:b001:l026","ordinal":42543,"en":"If death comes this year, falling to a shot,"},{"id":"manas-2010:p0971:b001:l027","ordinal":42544,"en":"Until the swaying dry stalks ripen,"},{"id":"manas-2010:p0971:b001:l028","ordinal":42545,"en":"Until the autumn gossamer flies,"},{"id":"manas-2010:p0971:b001:l029","ordinal":42546,"en":"Fighting six months without rest,"},{"id":"manas-2010:p0971:b001:l030","ordinal":42547,"en":"Let me die if my hour has come."},{"id":"manas-2010:p0971:b001:l031","ordinal":42548,"en":"If I have the means, this enemy's"},{"id":"manas-2010:p0971:b001:l032","ordinal":42549,"en":"Midst I shall dye with blood.”"},{"id":"manas-2010:p0971:b001:l033","ordinal":42550,"en":"Sarala with the cowlike tailbone"},{"id":"manas-2010:p0971:b001:l034","ordinal":42551,"en":"Almambet wheeled round;"},{"id":"manas-2010:p0971:b001:l035","ordinal":42552,"en":"He turned Sarala's head."},{"id":"manas-2010:p0971:b001:l036","ordinal":42553,"en":"Almambet, accustomed to exchanging shots,"},{"id":"manas-2010:p0971:b001:l037","ordinal":42554,"en":"Against the many foes who had arrived"},{"id":"manas-2010:p0971:b001:l038","ordinal":42555,"en":"Now stood prepared."},{"id":"manas-2010:p0971:b001:l039","ordinal":42556,"en":"No man's strength could overcome him in a grapple,"},{"id":"manas-2010:p0971:b001:l040","ordinal":42557,"en":"No lion's tooth could pierce him;"},{"id":"manas-2010:p0971:b001:l041","ordinal":42558,"en":"With piercing roars and ringing battle cries,"},{"id":"manas-2010:p0971:b001:l042","ordinal":42559,"en":"Chubak of Akbaltay,"},{"id":"manas-2010:p0972:b001:l001","ordinal":42560,"en":"Who threw the whole world into confusion,"},{"id":"manas-2010:p0972:b001:l002","ordinal":42561,"en":"Who wore an enormous, ungainly blue coat,"},{"id":"manas-2010:p0972:b001:l003","ordinal":42562,"en":"Who rode a horse like Kögala,"},{"id":"manas-2010:p0972:b001:l004","ordinal":42563,"en":"That dark, fierce-tempered rogue,"},{"id":"manas-2010:p0972:b001:l005","ordinal":42564,"en":"Chubak of Khan Baltay,"},{"id":"manas-2010:p0972:b001:l006","ordinal":42565,"en":"Against the many foes openly approaching"},{"id":"manas-2010:p0972:b001:l007","ordinal":42566,"en":"Now stood prepared."},{"id":"manas-2010:p0972:b001:l008","ordinal":42567,"en":"Ajybay of Khan Argyn,"},{"id":"manas-2010:p0972:b001:l009","ordinal":42568,"en":"Who knew sixty different tongues,"},{"id":"manas-2010:p0972:b001:l010","ordinal":42569,"en":"Went out to meet them"},{"id":"manas-2010:p0972:b001:l011","ordinal":42570,"en":"And began speaking gently:"},{"id":"manas-2010:p0972:b001:l012","ordinal":42571,"en":"“You handful of Muslims,"},{"id":"manas-2010:p0972:b001:l013","ordinal":42572,"en":"You have driven your men here;"},{"id":"manas-2010:p0972:b001:l014","ordinal":42573,"en":"Your skilled spear fighters"},{"id":"manas-2010:p0972:b001:l015","ordinal":42574,"en":"You have sent ahead!"},{"id":"manas-2010:p0972:b001:l016","ordinal":42575,"en":"Is there a mountain you cannot cross?"},{"id":"manas-2010:p0972:b001:l017","ordinal":42576,"en":"With you, Muslims,"},{"id":"manas-2010:p0972:b001:l018","ordinal":42577,"en":"Is there an enemy who has come to exchange shots?"},{"id":"manas-2010:p0972:b001:l019","ordinal":42578,"en":"Is there a pit dug in your path?"},{"id":"manas-2010:p0972:b001:l020","ordinal":42579,"en":"You have made ready;"},{"id":"manas-2010:p0972:b001:l021","ordinal":42580,"en":"Are there foot soldiers challenging you?"},{"id":"manas-2010:p0972:b001:l022","ordinal":42581,"en":"You have gathered in great strength,"},{"id":"manas-2010:p0972:b001:l023","ordinal":42582,"en":"You have prepared yourselves."},{"id":"manas-2010:p0972:b001:l024","ordinal":42583,"en":"Is there a mountain lying unawares?"},{"id":"manas-2010:p0972:b001:l025","ordinal":42584,"en":"Is there an enemy from Beijing?”"},{"id":"manas-2010:p0972:b001:l026","ordinal":42585,"en":"Then they said:"},{"id":"manas-2010:p0972:b001:l027","ordinal":42586,"en":"“Reckless Manas,"},{"id":"manas-2010:p0972:b001:l028","ordinal":42587,"en":"If our strength suffices this time,"},{"id":"manas-2010:p0972:b001:l029","ordinal":42588,"en":"We have come to seize Manas."},{"id":"manas-2010:p0972:b001:l030","ordinal":42589,"en":"'We shall raid,' we said, and came"},{"id":"manas-2010:p0972:b001:l031","ordinal":42590,"en":"For his mares in Keng-Kol."},{"id":"manas-2010:p0972:b001:l032","ordinal":42591,"en":"From Manas we shall exact"},{"id":"manas-2010:p0972:b001:l033","ordinal":42592,"en":"Vengeance for the distant past."},{"id":"manas-2010:p0972:b001:l034","ordinal":42593,"en":"Do not block my road;"},{"id":"manas-2010:p0972:b001:l035","ordinal":42594,"en":"Let my troops pass."},{"id":"manas-2010:p0972:b001:l036","ordinal":42595,"en":"We have come to show"},{"id":"manas-2010:p0972:b001:l037","ordinal":42596,"en":"Something truly extraordinary!”"},{"id":"manas-2010:p0972:b001:l038","ordinal":42597,"en":"Ajybay, Argyn's son,"},{"id":"manas-2010:p0972:b001:l039","ordinal":42598,"en":"Turned back with a shout,"},{"id":"manas-2010:p0972:b001:l040","ordinal":42599,"en":"Calling to Chubak of Khan Baltay,"},{"id":"manas-2010:p0972:b001:l041","ordinal":42600,"en":"'Where are you?'"},{"id":"manas-2010:p0972:b001:l042","ordinal":42601,"en":"And beating the drum,"},{"id":"manas-2010:p0973:b001:l001","ordinal":42602,"en":"He gave word to the companions,"},{"id":"manas-2010:p0973:b001:l002","ordinal":42603,"en":"Striking the war drum."},{"id":"manas-2010:p0973:b001:l003","ordinal":42604,"en":"Almambet of Azizkan"},{"id":"manas-2010:p0973:b001:l004","ordinal":42605,"en":"Sarala beneath him"},{"id":"manas-2010:p0973:b001:l005","ordinal":42606,"en":"He whipped on right and left,"},{"id":"manas-2010:p0973:b001:l006","ordinal":42607,"en":"Spurring him on either side."},{"id":"manas-2010:p0973:b001:l007","ordinal":42608,"en":"Syrgak of Khan Ulak,"},{"id":"manas-2010:p0973:b001:l008","ordinal":42609,"en":"With a horse like Kök Chebich,"},{"id":"manas-2010:p0973:b001:l010","ordinal":42610,"en":"Charged close with a roar.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"manas-2010:p0973:b001:l011","ordinal":42611,"en":"Calling 'God!' as his battle cry,"},{"id":"manas-2010:p0973:b001:l012","ordinal":42612,"en":"Hero Syrgak rode into the fray."},{"id":"manas-2010:p0973:b001:l013","ordinal":42613,"en":"Veering with Kögala,"},{"id":"manas-2010:p0973:b001:l014","ordinal":42614,"en":"Starting a clash the moment he saw them,"},{"id":"manas-2010:p0973:b001:l015","ordinal":42615,"en":"A polished spear thundering in his hand,"},{"id":"manas-2010:p0973:b001:l016","ordinal":42616,"en":"At Chubak's looming form"},{"id":"manas-2010:p0973:b001:l017","ordinal":42617,"en":"The earth reeled and thundered."},{"id":"manas-2010:p0973:b001:l018","ordinal":42618,"en":"Behind him the forty companions"},{"id":"manas-2010:p0973:b001:l019","ordinal":42619,"en":"Rode together with a thunderous roar."},{"id":"manas-2010:p0973:b001:l020","ordinal":42620,"en":"'The forty leopards will reach them,' he thought;"},{"id":"manas-2010:p0973:b001:l021","ordinal":42621,"en":"'If the forty companions take the notion,"},{"id":"manas-2010:p0973:b001:l022","ordinal":42622,"en":"These people of mine who have come"},{"id":"manas-2010:p0973:b001:l023","ordinal":42623,"en":"They will sweep through and slaughter.'"},{"id":"manas-2010:p0973:b001:l024","ordinal":42624,"en":"“My beloved forty companions,"},{"id":"manas-2010:p0973:b001:l025","ordinal":42625,"en":"It is their khans who are fools;"},{"id":"manas-2010:p0973:b001:l026","ordinal":42626,"en":"What fault lies with the common people?"},{"id":"manas-2010:p0973:b001:l027","ordinal":42627,"en":"If you rashly attack and kill them,"},{"id":"manas-2010:p0973:b001:l028","ordinal":42628,"en":"We too shall die one day."},{"id":"manas-2010:p0973:b001:l029","ordinal":42629,"en":"On the coming Day of Resurrection,"},{"id":"manas-2010:p0973:b001:l030","ordinal":42630,"en":"When the Prophet sits as judge,"},{"id":"manas-2010:p0973:b001:l031","ordinal":42631,"en":"What answer shall we give?"},{"id":"manas-2010:p0973:b001:l032","ordinal":42632,"en":"Those skilled among the spear fighters,"},{"id":"manas-2010:p0973:b001:l033","ordinal":42633,"en":"Before leopard Manas"},{"id":"manas-2010:p0973:b001:l034","ordinal":42634,"en":"Let us seize and bring,"},{"id":"manas-2010:p0973:b001:l035","ordinal":42635,"en":"The mighty men who led them."},{"id":"manas-2010:p0973:b001:l036","ordinal":42636,"en":"Forty companions, your prowess is beyond comparison;"},{"id":"manas-2010:p0973:b001:l037","ordinal":42637,"en":"For you to destroy and slaughter,"},{"id":"manas-2010:p0973:b001:l038","ordinal":42638,"en":"There are no Chinese people here!”"},{"id":"manas-2010:p0973:b001:l039","ordinal":42639,"en":"They heeded Bakay's words."},{"id":"manas-2010:p0973:b001:l040","ordinal":42640,"en":"Almambet of Azizkan"},{"id":"manas-2010:p0973:b001:l041","ordinal":42641,"en":"And Chubak of Akbaltay"},{"id":"manas-2010:p0973:b001:l042","ordinal":42642,"en":"The companions who had charged"},{"id":"manas-2010:p0974:b001:l001","ordinal":42643,"en":"Barely managed to restrain."},{"id":"manas-2010:p0974:b001:l002","ordinal":42644,"en":"The Muslims who had come of their own accord,"},{"id":"manas-2010:p0974:b001:l003","ordinal":42645,"en":"Rashly coming to pick a fight,"},{"id":"manas-2010:p0974:b001:l004","ordinal":42646,"en":"Now fell into hardship."},{"id":"manas-2010:p0974:b001:l005","ordinal":42647,"en":"Almambet of Azizkan"},{"id":"manas-2010:p0974:b001:l006","ordinal":42648,"en":"Drove off a thousand;"},{"id":"manas-2010:p0974:b001:l007","ordinal":42649,"en":"Chubak of Akbaltay"},{"id":"manas-2010:p0974:b001:l008","ordinal":42650,"en":"Took a thousand under guard."},{"id":"manas-2010:p0974:b001:l009","ordinal":42651,"en":"All the remainder"},{"id":"manas-2010:p0974:b001:l010","ordinal":42652,"en":"Dismounted in a flurry,"},{"id":"manas-2010:p0974:b001:l011","ordinal":42653,"en":"Threw down their battle-axes,"},{"id":"manas-2010:p0974:b001:l012","ordinal":42654,"en":"And stood drawing a line."},{"id":"manas-2010:p0974:b001:l013","ordinal":42655,"en":"The Muslims who had come themselves,"},{"id":"manas-2010:p0974:b001:l014","ordinal":42656,"en":"From Khan Manas's companions,"},{"id":"manas-2010:p0974:b001:l015","ordinal":42657,"en":"Were about to see a spectacle;"},{"id":"manas-2010:p0974:b001:l016","ordinal":42658,"en":"Khan Manas's companions"},{"id":"manas-2010:p0974:b001:l017","ordinal":42659,"en":"Were about to bring them trouble."},{"id":"manas-2010:p0974:b001:l018","ordinal":42660,"en":"Riding a horse like Sarala,"},{"id":"manas-2010:p0974:b001:l019","ordinal":42661,"en":"Wearing yellow leather trousers,"},{"id":"manas-2010:p0974:b001:l020","ordinal":42662,"en":"Holding a spear without a hair tassel,"},{"id":"manas-2010:p0974:b001:l021","ordinal":42663,"en":"Girded with a bare sword,"},{"id":"manas-2010:p0974:b001:l022","ordinal":42664,"en":"Golden-crested, with a fiery sash,"},{"id":"manas-2010:p0974:b001:l023","ordinal":42665,"en":"Azizkan's only son"},{"id":"manas-2010:p0974:b001:l024","ordinal":42666,"en":"Rode into their midst."},{"id":"manas-2010:p0974:b001:l025","ordinal":42667,"en":"Chubak of Khan Akbaltay,"},{"id":"manas-2010:p0974:b001:l026","ordinal":42668,"en":"Did you see him drive them off?"},{"id":"manas-2010:p0974:b001:l027","ordinal":42669,"en":"The soldiers of the twelve khans,"},{"id":"manas-2010:p0974:b001:l028","ordinal":42670,"en":"Making them all dismount,"},{"id":"manas-2010:p0974:b001:l029","ordinal":42671,"en":"Khan Manas's forty companions,"},{"id":"manas-2010:p0974:b001:l030","ordinal":42672,"en":"Before hero Manas,"},{"id":"manas-2010:p0974:b001:l031","ordinal":42673,"en":"Did you see them bring them bound?"},{"id":"manas-2010:p0974:b001:l032","ordinal":42674,"en":"Then Khan Bakay, the rich man's son—"},{"id":"manas-2010:p0974:b001:l033","ordinal":42675,"en":"The ground before the court was dusty;"},{"id":"manas-2010:p0974:b001:l034","ordinal":42676,"en":"There were some twelve thousand souls."},{"id":"manas-2010:p0974:b001:l035","ordinal":42677,"en":"All went submissively,"},{"id":"manas-2010:p0974:b001:l036","ordinal":42678,"en":"Driven like livestock!"},{"id":"manas-2010:p0974:b001:l037","ordinal":42679,"en":"When they reached Khan Manas,"},{"id":"manas-2010:p0974:b001:l038","ordinal":42680,"en":"Did you see their lives grow wretched?"},{"id":"manas-2010:p0974:b001:l039","ordinal":42681,"en":"All alike gazing helplessly,"},{"id":"manas-2010:p0974:b001:l040","ordinal":42682,"en":"Did you see them lose their speech?"},{"id":"manas-2010:p0974:b001:l041","ordinal":42683,"en":"At that time Khan Manas,"},{"id":"manas-2010:p0974:b001:l042","ordinal":42684,"en":"Thundering in fury,"},{"id":"manas-2010:p0975:b001:l001","ordinal":42685,"en":"Roaring like a surging lake,"},{"id":"manas-2010:p0975:b001:l002","ordinal":42686,"en":"Equipped with sharp steel,"},{"id":"manas-2010:p0975:b001:l003","ordinal":42687,"en":"Girded with a diamond-hard sword,"},{"id":"manas-2010:p0975:b001:l004","ordinal":42688,"en":"Finding no mountain to charge against,"},{"id":"manas-2010:p0975:b001:l005","ordinal":42689,"en":"Finding no enemy to fight,"},{"id":"manas-2010:p0975:b001:l006","ordinal":42690,"en":"Khan Manas, scarcely restraining himself,"},{"id":"manas-2010:p0975:b001:l007","ordinal":42691,"en":"Poured forth his wrath,"},{"id":"manas-2010:p0975:b001:l008","ordinal":42692,"en":"Appearing like a devouring fiend,"},{"id":"manas-2010:p0975:b001:l009","ordinal":42693,"en":"His face like buttered wheat,"},{"id":"manas-2010:p0975:b001:l010","ordinal":42694,"en":"His eyes like low-lying mist."},{"id":"manas-2010:p0975:b001:l011","ordinal":42695,"en":"At that time, against Manas"},{"id":"manas-2010:p0975:b001:l012","ordinal":42696,"en":"Even twelve nations had made no assault;"},{"id":"manas-2010:p0975:b001:l013","ordinal":42697,"en":"None remained to speak a word against him."},{"id":"manas-2010:p0975:b001:l014","ordinal":42698,"en":"He stood cutting and eating horse-rump meat."},{"id":"manas-2010:p0975:b001:l015","ordinal":42699,"en":"'Not merely the Muslims—I shall crush"},{"id":"manas-2010:p0975:b001:l016","ordinal":42700,"en":"The Chinese,' he said."},{"id":"manas-2010:p0975:b001:l017","ordinal":42701,"en":"Considering his renown,"},{"id":"manas-2010:p0975:b001:l018","ordinal":42702,"en":"Could Manas ever have his fill of blood?"},{"id":"manas-2010:p0975:b001:l019","ordinal":42703,"en":"Let alone the people who had come,"},{"id":"manas-2010:p0975:b001:l020","ordinal":42704,"en":"Would Manas spare the nations?"},{"id":"manas-2010:p0975:b001:l021","ordinal":42705,"en":"Before another moment passed,"},{"id":"manas-2010:p0975:b001:l022","ordinal":42706,"en":"The forty companions, born as lions,"},{"id":"manas-2010:p0975:b001:l023","ordinal":42707,"en":"Upon a carpet patterned in gold,"},{"id":"manas-2010:p0975:b001:l024","ordinal":42708,"en":"Manas, born a precious one,"},{"id":"manas-2010:p0975:b001:l025","ordinal":42709,"en":"They brought and seated."},{"id":"manas-2010:p0975:b001:l026","ordinal":42710,"en":"To the many people lying bound"},{"id":"manas-2010:p0975:b001:l027","ordinal":42711,"en":"They lifted and carried him."},{"id":"manas-2010:p0975:b001:l028","ordinal":42712,"en":"When they saw Khan Manas,"},{"id":"manas-2010:p0975:b001:l029","ordinal":42713,"en":"They quivered, unable to speak;"},{"id":"manas-2010:p0975:b001:l030","ordinal":42714,"en":"All those people"},{"id":"manas-2010:p0975:b001:l031","ordinal":42715,"en":"Lost their words and only murmured."},{"id":"manas-2010:p0975:b001:l032","ordinal":42716,"en":"The seven khans, finding no escape,"},{"id":"manas-2010:p0975:b001:l033","ordinal":42717,"en":"Trembled toward one another."},{"id":"manas-2010:p0975:b001:l034","ordinal":42718,"en":"At that moment Khan Manas,"},{"id":"manas-2010:p0975:b001:l035","ordinal":42719,"en":"Roaring in anger, said:"},{"id":"manas-2010:p0975:b001:l036","ordinal":42720,"en":"“Twelve Muslim khans,"},{"id":"manas-2010:p0975:b001:l037","ordinal":42721,"en":"Did I scatter the goods in your saddlebags,"},{"id":"manas-2010:p0975:b001:l038","ordinal":42722,"en":"For you to treat me like this?"},{"id":"manas-2010:p0975:b001:l039","ordinal":42723,"en":"Did I chase off your wild asses?"},{"id":"manas-2010:p0975:b001:l040","ordinal":42724,"en":"Did I scatter the goods in your chests?"},{"id":"manas-2010:p0975:b001:l041","ordinal":42725,"en":"Your fathers' graves, seven khans!"},{"id":"manas-2010:p0975:b001:l042","ordinal":42726,"en":"Did I raid and drive off your milk animals?"},{"id":"manas-2010:p0976:b001:l001","ordinal":42727,"en":"The forked rises and hollow-backed ridges,"},{"id":"manas-2010:p0976:b001:l002","ordinal":42728,"en":"You know I crossed them."},{"id":"manas-2010:p0976:b001:l003","ordinal":42729,"en":"The Muslims of the whole world,"},{"id":"manas-2010:p0976:b001:l004","ordinal":42730,"en":"You know I cared for them."},{"id":"manas-2010:p0976:b001:l005","ordinal":42731,"en":"Since Manas became Manas,"},{"id":"manas-2010:p0976:b001:l006","ordinal":42732,"en":"Since he gained the name of warrior,"},{"id":"manas-2010:p0976:b001:l007","ordinal":42733,"en":"You do not know how I surpassed others."},{"id":"manas-2010:p0976:b001:l008","ordinal":42734,"en":"In the face of hostile enemies,"},{"id":"manas-2010:p0976:b001:l009","ordinal":42735,"en":"Standing like a banner at your borders,"},{"id":"manas-2010:p0976:b001:l010","ordinal":42736,"en":"You do not know how I barred their way."},{"id":"manas-2010:p0976:b001:l011","ordinal":42737,"en":"Iron pieced together is not sharp steel;"},{"id":"manas-2010:p0976:b001:l012","ordinal":42738,"en":"Khans cobbled together are not a people."},{"id":"manas-2010:p0976:b001:l013","ordinal":42739,"en":"Plain iron is not sharp steel;"},{"id":"manas-2010:p0976:b001:l014","ordinal":42740,"en":"Khans raised apart are not a people."},{"id":"manas-2010:p0976:b001:l015","ordinal":42741,"en":"Deceit lies in their eyes;"},{"id":"manas-2010:p0976:b001:l016","ordinal":42742,"en":"If these khans have the strength,"},{"id":"manas-2010:p0976:b001:l017","ordinal":42743,"en":"They are ready to strike me down."},{"id":"manas-2010:p0976:b001:l018","ordinal":42744,"en":"Crookedness lies in their words;"},{"id":"manas-2010:p0976:b001:l019","ordinal":42745,"en":"If the seven khans get their chance,"},{"id":"manas-2010:p0976:b001:l020","ordinal":42746,"en":"They mean to do it to me."},{"id":"manas-2010:p0976:b001:l021","ordinal":42747,"en":"Your fathers' graves, forty companions!"},{"id":"manas-2010:p0976:b001:l022","ordinal":42748,"en":"Bind the seven khans"},{"id":"manas-2010:p0976:b001:l023","ordinal":42749,"en":"And drive them over here!”"},{"id":"manas-2010:p0976:b001:l024","ordinal":42750,"en":"At that moment, of the seven khans,"},{"id":"manas-2010:p0976:b001:l025","ordinal":42751,"en":"Not one found his tongue."},{"id":"manas-2010:p0976:b001:l026","ordinal":42752,"en":"Of Manas's wrath"}]
