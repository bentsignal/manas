[{"id":"semetey-1-2013:p0232:b003:l014","ordinal":94465,"en":"To look for Taitoru."},{"id":"semetey-1-2013:p0232:b003:l015","ordinal":94466,"en":"She could not regain her composure."},{"id":"semetey-1-2013:p0232:b003:l016","ordinal":94467,"en":"If Taitoru fell behind,"},{"id":"semetey-1-2013:p0232:b003:l017","ordinal":94468,"en":"She would die before her time."},{"id":"semetey-1-2013:p0232:b003:l018","ordinal":94469,"en":"A telescope wide-mouthed as a hoe,"},{"id":"semetey-1-2013:p0232:b003:l019","ordinal":94470,"en":"A great telescope a full armspan long,"},{"id":"semetey-1-2013:p0232:b003:l020","ordinal":94471,"en":"It had a handle made of gold,"},{"id":"semetey-1-2013:p0232:b003:l021","ordinal":94472,"en":"A case shaped like a body amulet."},{"id":"semetey-1-2013:p0232:b003:l022","ordinal":94473,"en":"Its inside was lined with gold,"},{"id":"semetey-1-2013:p0232:b003:l023","ordinal":94474,"en":"Its lens fashioned of precious stone,"},{"id":"semetey-1-2013:p0232:b003:l024","ordinal":94475,"en":"Cut from ruby."},{"id":"semetey-1-2013:p0232:b003:l025","ordinal":94476,"en":"The outstanding smith Bolokbai"},{"id":"semetey-1-2013:p0232:b003:l026","ordinal":94477,"en":"Had set it in the lens."},{"id":"semetey-1-2013:p0232:b003:l027","ordinal":94478,"en":"When a person gazed through it,"},{"id":"semetey-1-2013:p0232:b003:l028","ordinal":94479,"en":"The sight filled the heart's desire."},{"id":"semetey-1-2013:p0232:b003:l029","ordinal":94480,"en":"It was pointed toward the foe,"},{"id":"semetey-1-2013:p0232:b003:l030","ordinal":94481,"en":"Brought news of the enemy."},{"id":"semetey-1-2013:p0232:b003:l031","ordinal":94482,"en":"Your tiger's great telescope,"},{"id":"semetey-1-2013:p0232:b003:l032","ordinal":94483,"en":"Gold was stretched upon its handle."},{"id":"semetey-1-2013:p0232:b003:l033","ordinal":94484,"en":"Forty unfoaled mares, a thousand young mares,"},{"id":"semetey-1-2013:p0232:b003:l034","ordinal":94485,"en":"The lame smith Bolokbai"},{"id":"semetey-1-2013:p0232:b003:l035","ordinal":94486,"en":"Had been paid for it."},{"id":"semetey-1-2013:p0232:b003:l036","ordinal":94487,"en":"Let me tell of the telescope."},{"id":"semetey-1-2013:p0232:b003:l037","ordinal":94488,"en":"In an autumn long gone,"},{"id":"semetey-1-2013:p0232:b003:l038","ordinal":94489,"en":"In the valley of broad Talas,"},{"id":"semetey-1-2013:p0232:b003:l039","ordinal":94490,"en":"Along Zhylgynduu and Ken-Kol,"},{"id":"semetey-1-2013:p0232:b004:l001","ordinal":94491,"en":"In Kara-Buura and Chatkal,"},{"id":"semetey-1-2013:p0232:b004:l002","ordinal":94492,"en":"When the multitude of Kyrgyz dwelt"},{"id":"semetey-1-2013:p0232:b004:l003","ordinal":94493,"en":"In the valley of Kotormo,"},{"id":"semetey-1-2013:p0232:b004:l004","ordinal":94494,"en":"Beside the dry plane tree,"},{"id":"semetey-1-2013:p0232:b004:l005","ordinal":94495,"en":"Finding a land like Talas,"},{"id":"semetey-1-2013:p0232:b004:l006","ordinal":94496,"en":"At twelve years old Manas Khan,"},{"id":"semetey-1-2013:p0232:b004:l007","ordinal":94497,"en":"Finding a people like the Kyrgyz,"},{"id":"semetey-1-2013:p0232:b004:l008","ordinal":94498,"en":"Had come from Altai and grown,"},{"id":"semetey-1-2013:p0232:b004:l009","ordinal":94499,"en":"Become chief of a renowned people,"},{"id":"semetey-1-2013:p0232:b004:l010","ordinal":94500,"en":"Made Zhylgynduu and Ken-Kol his land,"},{"id":"semetey-1-2013:p0232:b004:l011","ordinal":94501,"en":"Become a fortunate, surpassing lion,"},{"id":"semetey-1-2013:p0232:b004:l012","ordinal":94502,"en":"Stirred by his own valor,"},{"id":"semetey-1-2013:p0232:b004:l013","ordinal":94503,"en":"Met many a Khydyr,"},{"id":"semetey-1-2013:p0232:b004:l014","ordinal":94504,"en":"Caught from the herd and ridden"},{"id":"semetey-1-2013:p0232:b004:l015","ordinal":94505,"en":"The swift steed Toruchaar,"},{"id":"semetey-1-2013:p0232:b004:l016","ordinal":94506,"en":"Suffered torment from the Chinese,"},{"id":"semetey-1-2013:p0232:b004:l017","ordinal":94507,"en":"And found his Kyrgyz kin."},{"id":"semetey-1-2013:p0232:b004:l018","ordinal":94508,"en":"His counselor, mighty Koshoi,"},{"id":"semetey-1-2013:p0232:b004:l019","ordinal":94509,"en":"Was a khan of sacred power."},{"id":"semetey-1-2013:p0232:b004:l020","ordinal":94510,"en":"My uncle, whom he relied upon,"},{"id":"semetey-1-2013:p0232:b004:l021","ordinal":94511,"en":"The dear land of Zheti-Suu"},{"id":"semetey-1-2013:p0232:b004:l022","ordinal":94512,"en":"Had skillfully made his homeland,"},{"id":"semetey-1-2013:p0232:b004:l023","ordinal":94513,"en":"The Kyrgyz of Zheti-Suu"},{"id":"semetey-1-2013:p0232:b004:l024","ordinal":94514,"en":"Had patiently united into a people."},{"id":"semetey-1-2013:p0232:b004:l025","ordinal":94515,"en":"Receiving a letter from the caliph,"},{"id":"semetey-1-2013:p0232:b004:l026","ordinal":94516,"en":"He was called the elder Koshoi."},{"id":"semetey-1-2013:p0232:b004:l027","ordinal":94517,"en":"While Koshoi ruled,"},{"id":"semetey-1-2013:p0232:b004:l028","ordinal":94518,"en":"He was worn out by humiliation."},{"id":"semetey-1-2013:p0232:b004:l029","ordinal":94519,"en":"Konurbai's father,"},{"id":"semetey-1-2013:p0232:b004:l030","ordinal":94520,"en":"The khan called Alooke, had arisen;"},{"id":"semetey-1-2013:p0232:b004:l031","ordinal":94521,"en":"The mere news of him drove out men's souls."},{"id":"semetey-1-2013:p0232:b004:l032","ordinal":94522,"en":"The Muslim faithful were worn down."},{"id":"semetey-1-2013:p0232:b004:l033","ordinal":94523,"en":"Koshoi and the champions,"},{"id":"semetey-1-2013:p0232:b004:l034","ordinal":94524,"en":"He beat them all, sparing none."},{"id":"semetey-1-2013:p0232:b004:l035","ordinal":94525,"en":"That handful of the Islamic faithful,"},{"id":"semetey-1-2013:p0232:b004:l036","ordinal":94526,"en":"No warrior equal to him had been born;"},{"id":"semetey-1-2013:p0232:b004:l037","ordinal":94527,"en":"They could not gain equal footing with him"},{"id":"semetey-1-2013:p0232:b004:l038","ordinal":94528,"en":"And were sorely worn down then."},{"id":"semetey-1-2013:p0232:b004:l039","ordinal":94529,"en":"He levied tribute and his customs dues"},{"id":"semetey-1-2013:p0233:b003:l001","ordinal":94530,"en":"Were being gathered then."},{"id":"semetey-1-2013:p0233:b003:l002","ordinal":94531,"en":"Upon that handful of Muslims"},{"id":"semetey-1-2013:p0233:b003:l003","ordinal":94532,"en":"He laid many taxes and levies."},{"id":"semetey-1-2013:p0233:b003:l004","ordinal":94533,"en":"Alooke, who came from Beijing,"},{"id":"semetey-1-2013:p0233:b003:l005","ordinal":94534,"en":"Was tormenting them then."},{"id":"semetey-1-2013:p0233:b003:l006","ordinal":94535,"en":"In the city of Samarkand,"},{"id":"semetey-1-2013:p0233:b003:l007","ordinal":94536,"en":"Alooke settled there as an envoy,"},{"id":"semetey-1-2013:p0233:b003:l008","ordinal":94537,"en":"He was ruling then."},{"id":"semetey-1-2013:p0233:b003:l009","ordinal":94538,"en":"In the city of Samarkand"},{"id":"semetey-1-2013:p0233:b003:l010","ordinal":94539,"en":"He set up his marvels."},{"id":"semetey-1-2013:p0233:b003:l011","ordinal":94540,"en":"Among Alooke's marvels,"},{"id":"semetey-1-2013:p0233:b003:l012","ordinal":94541,"en":"His tiger had bred fifteen cubs;"},{"id":"semetey-1-2013:p0233:b003:l013","ordinal":94542,"en":"No person could come near."},{"id":"semetey-1-2013:p0233:b003:l014","ordinal":94543,"en":"His dragons numbered sixty."},{"id":"semetey-1-2013:p0233:b003:l015","ordinal":94544,"en":"Farther beyond them,"},{"id":"semetey-1-2013:p0233:b003:l016","ordinal":94545,"en":"Set there by sorcery,"},{"id":"semetey-1-2013:p0233:b003:l017","ordinal":94546,"en":"Was his sword-snouted elephant."},{"id":"semetey-1-2013:p0233:b003:l018","ordinal":94547,"en":"Born and raised in Altai,"},{"id":"semetey-1-2013:p0233:b003:l019","ordinal":94548,"en":"Growing mighty among a renowned people,"},{"id":"semetey-1-2013:p0233:b003:l020","ordinal":94549,"en":"Taking Talas for his homeland,"},{"id":"semetey-1-2013:p0233:b003:l021","ordinal":94550,"en":"The Argyn and Kyrgyz people"},{"id":"semetey-1-2013:p0233:b003:l022","ordinal":94551,"en":"He had deliberately gathered as his subjects."},{"id":"semetey-1-2013:p0233:b003:l023","ordinal":94552,"en":"Manas became a renowned warrior,"},{"id":"semetey-1-2013:p0233:b003:l024","ordinal":94553,"en":"Went on foot, no horse could bear him,"},{"id":"semetey-1-2013:p0233:b003:l025","ordinal":94554,"en":"Grew hardened, drinking blood,"},{"id":"semetey-1-2013:p0233:b003:l026","ordinal":94555,"en":"Was himself called Manas the Leopard."},{"id":"semetey-1-2013:p0233:b003:l027","ordinal":94556,"en":"When the people moved to higher pastures,"},{"id":"semetey-1-2013:p0233:b003:l028","ordinal":94557,"en":"In summer, when horses' tongues turn black,"},{"id":"semetey-1-2013:p0233:b003:l029","ordinal":94558,"en":"Hearing words from the old tradition,"},{"id":"semetey-1-2013:p0233:b003:l030","ordinal":94559,"en":"Alooke, who had come as an envoy,"},{"id":"semetey-1-2013:p0233:b003:l031","ordinal":94560,"en":"The few Muslims"},{"id":"semetey-1-2013:p0233:b003:l032","ordinal":94561,"en":"Had been trampled by this swine, he heard."},{"id":"semetey-1-2013:p0233:b003:l033","ordinal":94562,"en":"Manas, roused, could not stay still."},{"id":"semetey-1-2013:p0233:b003:l034","ordinal":94563,"en":"'I will seize and slaughter him,' he said,"},{"id":"semetey-1-2013:p0233:b003:l035","ordinal":94564,"en":"'I will drink my fill of his blood.'"},{"id":"semetey-1-2013:p0233:b003:l036","ordinal":94565,"en":"The khan watching the people's border,"},{"id":"semetey-1-2013:p0233:b003:l037","ordinal":94566,"en":"Alooke in Samarkand—"},{"id":"semetey-1-2013:p0233:b003:l038","ordinal":94567,"en":"To seize that man,"},{"id":"semetey-1-2013:p0233:b003:l039","ordinal":94568,"en":"To slaughter him in sacrifice,"},{"id":"semetey-1-2013:p0233:b005:l001","ordinal":94569,"en":"If he could, the Muslims"},{"id":"semetey-1-2013:p0233:b005:l002","ordinal":94570,"en":"To set them free,"},{"id":"semetey-1-2013:p0233:b005:l003","ordinal":94571,"en":"For Alooke in Samarkand"},{"id":"semetey-1-2013:p0233:b005:l004","ordinal":94572,"en":"To stage a spectacle,"},{"id":"semetey-1-2013:p0233:b005:l005","ordinal":94573,"en":"Manas had not yet come into his full might;"},{"id":"semetey-1-2013:p0233:b005:l006","ordinal":94574,"en":"Khydyr had not yet settled upon Manas's head,"},{"id":"semetey-1-2013:p0233:b005:l007","ordinal":94575,"en":"God had not yet granted his wish,"},{"id":"semetey-1-2013:p0233:b005:l008","ordinal":94576,"en":"Azhybai and Bakai had not yet come."},{"id":"semetey-1-2013:p0233:b005:l009","ordinal":94577,"en":"That uniquely born, surpassing lion,"},{"id":"semetey-1-2013:p0233:b005:l010","ordinal":94578,"en":"To the city of Samarkand"},{"id":"semetey-1-2013:p0233:b005:l011","ordinal":94579,"en":"The fierce warrior went alone."},{"id":"semetey-1-2013:p0233:b005:l012","ordinal":94580,"en":"His chosen horse was Toruchaar,"},{"id":"semetey-1-2013:p0233:b005:l013","ordinal":94581,"en":"Arkuron he led as his spare."},{"id":"semetey-1-2013:p0233:b005:l014","ordinal":94582,"en":"In Samarkand, Alooke"},{"id":"semetey-1-2013:p0233:b005:l015","ordinal":94583,"en":"Had studied the wondrous arts too."},{"id":"semetey-1-2013:p0233:b005:l016","ordinal":94584,"en":"Three nights beforehand,"},{"id":"semetey-1-2013:p0233:b005:l017","ordinal":94585,"en":"That Manas the Leopard would come,"},{"id":"semetey-1-2013:p0233:b005:l018","ordinal":94586,"en":"Would bloody the mouth of his gate,"},{"id":"semetey-1-2013:p0233:b005:l019","ordinal":94587,"en":"Would kill the guards,"},{"id":"semetey-1-2013:p0233:b005:l020","ordinal":94588,"en":"'And seize me,' he thought—"},{"id":"semetey-1-2013:p0233:b005:l021","ordinal":94589,"en":"Alooke had known."},{"id":"semetey-1-2013:p0233:b005:l022","ordinal":94590,"en":"That he would uproot his supporting pillar,"},{"id":"semetey-1-2013:p0233:b005:l023","ordinal":94591,"en":"Would bring trouble upon his head,"},{"id":"semetey-1-2013:p0233:b005:l024","ordinal":94592,"en":"Alooke had known."},{"id":"semetey-1-2013:p0233:b005:l025","ordinal":94593,"en":"Unable to find a way out,"},{"id":"semetey-1-2013:p0233:b005:l026","ordinal":94594,"en":"He had fallen into panic."},{"id":"semetey-1-2013:p0233:b005:l027","ordinal":94595,"en":"Upon some six hundred mules"},{"id":"semetey-1-2013:p0233:b005:l028","ordinal":94596,"en":"He loaded his gold"},{"id":"semetey-1-2013:p0233:b005:l029","ordinal":94597,"en":"And Alooke fled."},{"id":"semetey-1-2013:p0233:b005:l030","ordinal":94598,"en":"Taking all his kaldai officials,"},{"id":"semetey-1-2013:p0233:b005:l031","ordinal":94599,"en":"Hastening toward Beijing,"},{"id":"semetey-1-2013:p0233:b005:l032","ordinal":94600,"en":"He crossed broad Kashgar,"},{"id":"semetey-1-2013:p0233:b005:l033","ordinal":94601,"en":"Passed through great Turpan."},{"id":"semetey-1-2013:p0233:b005:l034","ordinal":94602,"en":"In Ak-Chiy of Aksy,"},{"id":"semetey-1-2013:p0233:b005:l035","ordinal":94603,"en":"At the spur where the mountains ended,"},{"id":"semetey-1-2013:p0233:b005:l036","ordinal":94604,"en":"Upon the rounded headland,"},{"id":"semetey-1-2013:p0233:b005:l037","ordinal":94605,"en":"Beside the flowing water,"},{"id":"semetey-1-2013:p0233:b005:l038","ordinal":94606,"en":"In the valley of Kum-Aryk,"},{"id":"semetey-1-2013:p0233:b005:l039","ordinal":94607,"en":"When he pitched his golden tent,"},{"id":"semetey-1-2013:p0234:b003:l001","ordinal":94608,"en":"When he rested on his journey,"},{"id":"semetey-1-2013:p0234:b003:l002","ordinal":94609,"en":"With coral plumes and precious beads,"},{"id":"semetey-1-2013:p0234:b003:l003","ordinal":94610,"en":"His lungtung headman stood watch."},{"id":"semetey-1-2013:p0234:b003:l004","ordinal":94611,"en":"Making his sentry loom conspicuously,"},{"id":"semetey-1-2013:p0234:b003:l005","ordinal":94612,"en":"He posted his kaldai as guard."},{"id":"semetey-1-2013:p0234:b003:l006","ordinal":94613,"en":"The finest of his executioners,"},{"id":"semetey-1-2013:p0234:b003:l007","ordinal":94614,"en":"Seven champions, stood there."},{"id":"semetey-1-2013:p0234:b003:l008","ordinal":94615,"en":"When Manas Khan entered Samarkand,"},{"id":"semetey-1-2013:p0234:b003:l009","ordinal":94616,"en":"There was no khan like Alooke there."},{"id":"semetey-1-2013:p0234:b003:l010","ordinal":94617,"en":"He slaughtered the remaining Chinese;"},{"id":"semetey-1-2013:p0234:b003:l011","ordinal":94618,"en":"Manas Khan gave a stern command."},{"id":"semetey-1-2013:p0234:b003:l012","ordinal":94619,"en":"Then out of fear,"},{"id":"semetey-1-2013:p0234:b003:l013","ordinal":94620,"en":"The humbled man turned back."},{"id":"semetey-1-2013:p0234:b003:l014","ordinal":94621,"en":"Aikozho of Samarkand"},{"id":"semetey-1-2013:p0234:b003:l015","ordinal":94622,"en":"Said, 'His trail went this way,'"},{"id":"semetey-1-2013:p0234:b003:l016","ordinal":94623,"en":"And told him the direction."},{"id":"semetey-1-2013:p0234:b003:l017","ordinal":94624,"en":"Following the tracks in pursuit,"},{"id":"semetey-1-2013:p0234:b003:l018","ordinal":94625,"en":"He crossed broad Kashgar."},{"id":"semetey-1-2013:p0234:b003:l019","ordinal":94626,"en":"Through Turpan and Zhaman-Suu,"},{"id":"semetey-1-2013:p0234:b003:l020","ordinal":94627,"en":"Your warrior traveled days and nights."},{"id":"semetey-1-2013:p0234:b003:l021","ordinal":94628,"en":"Tracking every fading footprint,"},{"id":"semetey-1-2013:p0234:b003:l022","ordinal":94629,"en":"He pursued him till he paled."},{"id":"semetey-1-2013:p0234:b003:l023","ordinal":94630,"en":"Tracking every bleached footprint,"},{"id":"semetey-1-2013:p0234:b003:l024","ordinal":94631,"en":"He pursued him till he blanched."},{"id":"semetey-1-2013:p0234:b003:l025","ordinal":94632,"en":"In the valley of Kum-Aryk,"},{"id":"semetey-1-2013:p0234:b003:l026","ordinal":94633,"en":"Upon the riverbank,"},{"id":"semetey-1-2013:p0234:b003:l027","ordinal":94634,"en":"Alooke and the warrior Manas"},{"id":"semetey-1-2013:p0234:b003:l028","ordinal":94635,"en":"Fought a merciless battle."},{"id":"semetey-1-2013:p0234:b003:l029","ordinal":94636,"en":"They exchanged fire for six days,"},{"id":"semetey-1-2013:p0234:b003:l030","ordinal":94637,"en":"Neither could overcome the other."},{"id":"semetey-1-2013:p0234:b003:l031","ordinal":94638,"en":"For six more days the leopard"},{"id":"semetey-1-2013:p0234:b003:l032","ordinal":94639,"en":"Stood dueling with spears,"},{"id":"semetey-1-2013:p0234:b003:l033","ordinal":94640,"en":"Jousting with their spears,"},{"id":"semetey-1-2013:p0234:b003:l034","ordinal":94641,"en":"The spear points bending."},{"id":"semetey-1-2013:p0234:b003:l035","ordinal":94642,"en":"Upon the slope of Yrgaity,"},{"id":"semetey-1-2013:p0234:b003:l036","ordinal":94643,"en":"Swaying in their saddles,"},{"id":"semetey-1-2013:p0234:b003:l037","ordinal":94644,"en":"Fighting hard in earnest,"},{"id":"semetey-1-2013:p0234:b003:l038","ordinal":94645,"en":"When the dawn shone clear,"},{"id":"semetey-1-2013:p0234:b003:l039","ordinal":94646,"en":"When light fell upon the earth,"},{"id":"semetey-1-2013:p0234:b004:l001","ordinal":94647,"en":"Fortunate Manas, the young lion,"},{"id":"semetey-1-2013:p0234:b004:l002","ordinal":94648,"en":"The swaggering Chinese-Manchu"},{"id":"semetey-1-2013:p0234:b004:l003","ordinal":94649,"en":"That noble warrior brought down."},{"id":"semetey-1-2013:p0234:b004:l004","ordinal":94650,"en":"He plundered his valuables,"},{"id":"semetey-1-2013:p0234:b004:l005","ordinal":94651,"en":"Wrought thorough devastation."},{"id":"semetey-1-2013:p0234:b004:l006","ordinal":94652,"en":"Some six hundred of his champions,"},{"id":"semetey-1-2013:p0234:b004:l007","ordinal":94653,"en":"With Alooke at their head,"},{"id":"semetey-1-2013:p0234:b004:l008","ordinal":94654,"en":"Your fierce lion Manas"},{"id":"semetey-1-2013:p0234:b004:l009","ordinal":94655,"en":"Slaughtered utterly."},{"id":"semetey-1-2013:p0234:b004:l010","ordinal":94656,"en":"The countless livestock gathered as customs dues,"},{"id":"semetey-1-2013:p0234:b004:l011","ordinal":94657,"en":"The countless gold amassed in the treasury,"},{"id":"semetey-1-2013:p0234:b004:l012","ordinal":94658,"en":"He brought back again."},{"id":"semetey-1-2013:p0234:b004:l013","ordinal":94659,"en":"To the needy Muslim faithful"},{"id":"semetey-1-2013:p0234:b004:l014","ordinal":94660,"en":"He distributed six of them."},{"id":"semetey-1-2013:p0234:b004:l015","ordinal":94661,"en":"Then the Muslims,"},{"id":"semetey-1-2013:p0234:b004:l016","ordinal":94662,"en":"Through the support of Manas,"},{"id":"semetey-1-2013:p0234:b004:l017","ordinal":94663,"en":"Made their living in this way."},{"id":"semetey-1-2013:p0234:b004:l018","ordinal":94664,"en":"From the desert of Mediyan,"},{"id":"semetey-1-2013:p0234:b004:l019","ordinal":94665,"en":"Beyond Andizhan,"},{"id":"semetey-1-2013:p0234:b004:l020","ordinal":94666,"en":"From the ridge of Ak-Talaa,"},{"id":"semetey-1-2013:p0234:b004:l021","ordinal":94667,"en":"Where a company of saints had gathered,"},{"id":"semetey-1-2013:p0234:b004:l022","ordinal":94668,"en":"From the place of their assembly,"},{"id":"semetey-1-2013:p0234:b004:l023","ordinal":94669,"en":"He met a certain man—"},{"id":"semetey-1-2013:p0234:b004:l024","ordinal":94670,"en":"One man, yet worth a thousand men—"},{"id":"semetey-1-2013:p0234:b004:l025","ordinal":94671,"en":"Wearing a blue-gray lynx-fur cap,"},{"id":"semetey-1-2013:p0234:b004:l026","ordinal":94672,"en":"Brandishing a mottled shield,"},{"id":"semetey-1-2013:p0234:b004:l027","ordinal":94673,"en":"His head arrayed in lavish gold,"},{"id":"semetey-1-2013:p0234:b004:l028","ordinal":94674,"en":"His feet supported by white silver."},{"id":"semetey-1-2013:p0234:b004:l029","ordinal":94675,"en":"It was the lion Bakai,"},{"id":"semetey-1-2013:p0234:b004:l030","ordinal":94676,"en":"The peerless one among the saints,"},{"id":"semetey-1-2013:p0234:b004:l031","ordinal":94677,"en":"Who then encountered Manas."},{"id":"semetey-1-2013:p0234:b004:l032","ordinal":94678,"en":"'I shall be a pale star in the sky."},{"id":"semetey-1-2013:p0234:b004:l033","ordinal":94679,"en":"With you, Manas Khan,"},{"id":"semetey-1-2013:p0234:b004:l034","ordinal":94680,"en":"I shall be friends unto the next world."},{"id":"semetey-1-2013:p0234:b004:l035","ordinal":94681,"en":"You shall lay your troubles upon me,"},{"id":"semetey-1-2013:p0234:b004:l036","ordinal":94682,"en":"You shall heed my words."},{"id":"semetey-1-2013:p0234:b004:l037","ordinal":94683,"en":"I shall plant you and make a garden,"},{"id":"semetey-1-2013:p0234:b004:l038","ordinal":94684,"en":"I shall build you and make a house."},{"id":"semetey-1-2013:p0234:b004:l039","ordinal":94685,"en":"May no untimely misfortune come."},{"id":"semetey-1-2013:p0235:b003:l001","ordinal":94686,"en":"Over the eighteen thousand worlds,"},{"id":"semetey-1-2013:p0235:b003:l002","ordinal":94687,"en":"I shall lead you and make you khan."},{"id":"semetey-1-2013:p0235:b003:l003","ordinal":94688,"en":"If we clash with the other side,"},{"id":"semetey-1-2013:p0235:b003:l004","ordinal":94689,"en":"If we exchange fire, there are mighty men."},{"id":"semetey-1-2013:p0235:b003:l005","ordinal":94690,"en":"There is something, once seized, impossible to find,"},{"id":"semetey-1-2013:p0235:b003:l006","ordinal":94691,"en":"An object no warrior can lay hands upon.'"},{"id":"semetey-1-2013:p0235:b003:l007","ordinal":94692,"en":"Beyond Andizhan,"},{"id":"semetey-1-2013:p0235:b003:l008","ordinal":94693,"en":"On this side of Amangen,"},{"id":"semetey-1-2013:p0235:b003:l009","ordinal":94694,"en":"In moon-bright Sary-Talaa,"},{"id":"semetey-1-2013:p0235:b003:l010","ordinal":94695,"en":"Sixty Russian surveyors"},{"id":"semetey-1-2013:p0235:b003:l011","ordinal":94696,"en":"Had come out, making a clamor."},{"id":"semetey-1-2013:p0235:b003:l012","ordinal":94697,"en":"Khydyr-blessed Bakai, the precious lion,"},{"id":"semetey-1-2013:p0235:b003:l013","ordinal":94698,"en":"Had seized it in a raid."},{"id":"semetey-1-2013:p0235:b003:l014","ordinal":94699,"en":"A cluster of ornaments upon its head,"},{"id":"semetey-1-2013:p0235:b003:l015","ordinal":94700,"en":"Your tiger's object was of Russian make."},{"id":"semetey-1-2013:p0235:b003:l016","ordinal":94701,"en":"The imposing, mighty Bakai"},{"id":"semetey-1-2013:p0235:b003:l017","ordinal":94702,"en":"Had come and settled in Talas,"},{"id":"semetey-1-2013:p0235:b003:l018","ordinal":94703,"en":"Become his friend till Judgment Day,"},{"id":"semetey-1-2013:p0235:b003:l019","ordinal":94704,"en":"And that very telescope"},{"id":"semetey-1-2013:p0235:b003:l020","ordinal":94705,"en":"Had presented to Manas."},{"id":"semetey-1-2013:p0235:b003:l021","ordinal":94706,"en":"Twisting and turning it seven times,"},{"id":"semetey-1-2013:p0235:b003:l022","ordinal":94707,"en":"The accomplished smith Bolokbai"},{"id":"semetey-1-2013:p0235:b003:l023","ordinal":94708,"en":"Had worked on it for seven years."},{"id":"semetey-1-2013:p0235:b003:l024","ordinal":94709,"en":"The reason he could improve it:"},{"id":"semetey-1-2013:p0235:b003:l025","ordinal":94710,"en":"Bolokbai, whom you have seen,"},{"id":"semetey-1-2013:p0235:b003:l026","ordinal":94711,"en":"Conversed in the ordinary way"},{"id":"semetey-1-2013:p0235:b003:l027","ordinal":94712,"en":"And was a friend of David."},{"id":"semetey-1-2013:p0235:b003:l028","ordinal":94713,"en":"Applying all his skill,"},{"id":"semetey-1-2013:p0235:b003:l029","ordinal":94714,"en":"Shaving its screw threads,"},{"id":"semetey-1-2013:p0235:b003:l030","ordinal":94715,"en":"He fashioned it to fit exactly."},{"id":"semetey-1-2013:p0235:b003:l031","ordinal":94716,"en":"'When my lord, my sultan,"},{"id":"semetey-1-2013:p0235:b003:l032","ordinal":94717,"en":"Went toward Kakan,"},{"id":"semetey-1-2013:p0235:b003:l033","ordinal":94718,"en":"Having settled in Talas,"},{"id":"semetey-1-2013:p0235:b003:l034","ordinal":94719,"en":"Twelve scholars of the Islamic faith,"},{"id":"semetey-1-2013:p0235:b003:l035","ordinal":94720,"en":"Those followers of Islam there,"}]
