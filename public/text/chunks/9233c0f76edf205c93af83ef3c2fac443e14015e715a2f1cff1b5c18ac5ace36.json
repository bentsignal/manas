[{"id":"semetey-1-2013:p0796:b003:l010","ordinal":137217,"en":"Kanykei stood and said:"},{"id":"semetey-1-2013:p0796:b003:l011","ordinal":137218,"en":"“Why should I go to Bukhara?"},{"id":"semetey-1-2013:p0796:b003:l012","ordinal":137219,"en":"Sage elder, give me your blessing;"},{"id":"semetey-1-2013:p0796:b003:l013","ordinal":137220,"en":"Let me carry my orphan"},{"id":"semetey-1-2013:p0796:b003:l014","ordinal":137221,"en":"And go into Kokand."},{"id":"semetey-1-2013:p0796:b003:l017","ordinal":137222,"en":"When black-hearted Kanykei","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0796:b003:l018","ordinal":137223,"en":"Lay there saying this,"},{"id":"semetey-1-2013:p0796:b003:l019","ordinal":137224,"en":"When she plunged us all into torment,"},{"id":"semetey-1-2013:p0796:b003:l020","ordinal":137225,"en":"I turned Köktulpar's head,"},{"id":"semetey-1-2013:p0796:b003:l021","ordinal":137226,"en":"Beat my own head,"},{"id":"semetey-1-2013:p0796:b003:l022","ordinal":137227,"en":"And stood weeping aloud."},{"id":"semetey-1-2013:p0796:b004:l001","ordinal":137228,"en":"The beard upon my chin"},{"id":"semetey-1-2013:p0796:b004:l002","ordinal":137229,"en":"I plucked out, leaving not a hair."},{"id":"semetey-1-2013:p0796:b004:l003","ordinal":137230,"en":"I struck my own head"},{"id":"semetey-1-2013:p0796:b004:l004","ordinal":137231,"en":"And made this spectacle."},{"id":"semetey-1-2013:p0796:b004:l005","ordinal":137232,"en":"“Oh, Kanykei, my little foal,"},{"id":"semetey-1-2013:p0796:b004:l006","ordinal":137233,"en":"My wretched child, you will not mend;"},{"id":"semetey-1-2013:p0796:b004:l007","ordinal":137234,"en":"You will not abandon your fierceness."},{"id":"semetey-1-2013:p0796:b004:l008","ordinal":137235,"en":"If you go to Kokand, they will do no good;"},{"id":"semetey-1-2013:p0796:b004:l009","ordinal":137236,"en":"They will not leave my orphan unharmed."},{"id":"semetey-1-2013:p0796:b004:l010","ordinal":137237,"en":"When a woman's husband dies,"},{"id":"semetey-1-2013:p0796:b004:l011","ordinal":137238,"en":"Her own family should be close to her."},{"id":"semetey-1-2013:p0796:b004:l012","ordinal":137239,"en":"Make your way toward Temirkan,” I said,"},{"id":"semetey-1-2013:p0796:b004:l013","ordinal":137240,"en":"And hastily sent her on her way."},{"id":"semetey-1-2013:p0796:b004:l014","ordinal":137241,"en":"Do not blunt your steel;"},{"id":"semetey-1-2013:p0796:b004:l015","ordinal":137242,"en":"Do not destroy your white steed."},{"id":"semetey-1-2013:p0796:b004:l016","ordinal":137243,"en":"In the city of Bukhara,"},{"id":"semetey-1-2013:p0796:b004:l017","ordinal":137244,"en":"My dear orphan,"},{"id":"semetey-1-2013:p0796:b004:l018","ordinal":137245,"en":"It would be a disgrace to linger,’"},{"id":"semetey-1-2013:p0796:b004:l019","ordinal":137246,"en":"He said, telling him this,"},{"id":"semetey-1-2013:p0796:b004:l020","ordinal":137247,"en":"Making many things known,"},{"id":"semetey-1-2013:p0796:b004:l021","ordinal":137248,"en":"And sent the orphan, Manas's son,"},{"id":"semetey-1-2013:p0796:b004:l022","ordinal":137249,"en":"On his way toward Bukhara."},{"id":"semetey-1-2013:p0797:b004:l001","ordinal":137250,"en":"Your orphan, the warrior's son,"},{"id":"semetey-1-2013:p0797:b004:l002","ordinal":137251,"en":"When he had set out from Bukhara—"},{"id":"semetey-1-2013:p0797:b004:l003","ordinal":137252,"en":"‘Kanykei, grown old,"},{"id":"semetey-1-2013:p0797:b004:l004","ordinal":137253,"en":"And Chiyyrdy, aged,"},{"id":"semetey-1-2013:p0797:b004:l005","ordinal":137254,"en":"Opened their palms and spread their hands."},{"id":"semetey-1-2013:p0797:b004:l006","ordinal":137255,"en":"“O God!” they cried, spreading them wide,"},{"id":"semetey-1-2013:p0797:b004:l007","ordinal":137256,"en":"Praying and weeping much."},{"id":"semetey-1-2013:p0797:b004:l008","ordinal":137257,"en":"Both my mothers wept,"},{"id":"semetey-1-2013:p0797:b004:l009","ordinal":137258,"en":"Wept, “Come back without delay.”"},{"id":"semetey-1-2013:p0797:b004:l010","ordinal":137259,"en":"My poor mother Chiyyrdy,"},{"id":"semetey-1-2013:p0797:b004:l011","ordinal":137260,"en":"An elder of ninety-five!"},{"id":"semetey-1-2013:p0797:b004:l012","ordinal":137261,"en":"The saint who bore my father Manas"},{"id":"semetey-1-2013:p0797:b004:l013","ordinal":137262,"en":"Had raised a piercing cry."},{"id":"semetey-1-2013:p0797:b004:l014","ordinal":137263,"en":"She had counted the days,"},{"id":"semetey-1-2013:p0797:b004:l015","ordinal":137264,"en":"Written down the days,"},{"id":"semetey-1-2013:p0797:b004:l016","ordinal":137265,"en":"Bound the time with a limit:"},{"id":"semetey-1-2013:p0797:b004:l017","ordinal":137266,"en":"“Ten days to go there,"},{"id":"semetey-1-2013:p0797:b004:l018","ordinal":137267,"en":"Ten days to stay among the people,"},{"id":"semetey-1-2013:p0797:b004:l019","ordinal":137268,"en":"Ten days to return,"},{"id":"semetey-1-2013:p0797:b004:l020","ordinal":137269,"en":"Three periods—thirty days."},{"id":"semetey-1-2013:p0797:b004:l021","ordinal":137270,"en":"If you do not return in thirty days,”"},{"id":"semetey-1-2013:p0797:b004:l022","ordinal":137271,"en":"Those were my mother's words,"},{"id":"semetey-1-2013:p0797:b004:l023","ordinal":137272,"en":"My poor mother said, “Before my appointed death,"},{"id":"semetey-1-2013:p0797:b004:l024","ordinal":137273,"en":"I shall die.”"},{"id":"semetey-1-2013:p0797:b004:l025","ordinal":137274,"en":"Hunched like a kneeling camel,"},{"id":"semetey-1-2013:p0797:b004:l026","ordinal":137275,"en":"My mother, bowed down,"},{"id":"semetey-1-2013:p0797:b004:l027","ordinal":137276,"en":"Let her tears stream,"},{"id":"semetey-1-2013:p0797:b004:l028","ordinal":137277,"en":"My mother poured them out."},{"id":"semetey-1-2013:p0797:b004:l029","ordinal":137278,"en":"If I am two days late,"},{"id":"semetey-1-2013:p0797:b004:l030","ordinal":137279,"en":"Will an untimely death take her?"},{"id":"semetey-1-2013:p0797:b004:l031","ordinal":137280,"en":"Will she die in sorrow?"},{"id":"semetey-1-2013:p0797:b004:l032","ordinal":137281,"en":"Her appointed time is thirty days."},{"id":"semetey-1-2013:p0797:b004:l033","ordinal":137282,"en":"Will my mother die,"},{"id":"semetey-1-2013:p0797:b004:l034","ordinal":137283,"en":"And bring calamity upon us?’"},{"id":"semetey-1-2013:p0797:b004:l035","ordinal":137284,"en":"He traveled in haste,"},{"id":"semetey-1-2013:p0797:b004:l036","ordinal":137285,"en":"Covered much ground, sparing no horse."},{"id":"semetey-1-2013:p0797:b005:l001","ordinal":137286,"en":"Narbuudan beneath him,"},{"id":"semetey-1-2013:p0797:b005:l002","ordinal":137287,"en":"When the orphan boy mounted,"},{"id":"semetey-1-2013:p0797:b005:l003","ordinal":137288,"en":"Taibuurul that day—"},{"id":"semetey-1-2013:p0797:b005:l004","ordinal":137289,"en":"I do not know; if it is true—"},{"id":"semetey-1-2013:p0797:b005:l005","ordinal":137290,"en":"That day was in his prime."},{"id":"semetey-1-2013:p0797:b005:l006","ordinal":137291,"en":"When his sacred mane was grasped,"},{"id":"semetey-1-2013:p0797:b005:l008","ordinal":137292,"en":"He was ready to stretch out","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0797:b005:l009","ordinal":137293,"en":"Upon the long road,"},{"id":"semetey-1-2013:p0797:b005:l010","ordinal":137294,"en":"Ready to speed like a winged creature"},{"id":"semetey-1-2013:p0797:b005:l011","ordinal":137295,"en":"And fly."},{"id":"semetey-1-2013:p0797:b005:l012","ordinal":137296,"en":"For twelve years"},{"id":"semetey-1-2013:p0797:b005:l013","ordinal":137297,"en":"He had grazed at liberty."},{"id":"semetey-1-2013:p0797:b005:l014","ordinal":137298,"en":"That Semetey would come,"},{"id":"semetey-1-2013:p0797:b005:l015","ordinal":137299,"en":"Though an animal, a living creature,"},{"id":"semetey-1-2013:p0797:b005:l016","ordinal":137300,"en":"He had known that year."},{"id":"semetey-1-2013:p0797:b005:l017","ordinal":137301,"en":"The armful of tail"},{"id":"semetey-1-2013:p0797:b005:l018","ordinal":137302,"en":"Of that roan horse you have seen"},{"id":"semetey-1-2013:p0797:b005:l019","ordinal":137303,"en":"Streamed out strand by strand."},{"id":"semetey-1-2013:p0797:b005:l020","ordinal":137304,"en":"When the poor boy mounted,"},{"id":"semetey-1-2013:p0797:b005:l021","ordinal":137305,"en":"My precious Taibuurul"},{"id":"semetey-1-2013:p0797:b005:l022","ordinal":137306,"en":"Brightened altogether."},{"id":"semetey-1-2013:p0797:b005:l023","ordinal":137307,"en":"Now your orphan, Manas's son,"},{"id":"semetey-1-2013:p0797:b005:l025","ordinal":137308,"en":"Had grown to maturity as an orphan,"},{"id":"semetey-1-2013:p0797:b005:l026","ordinal":137309,"en":"And thus joined his people."},{"id":"semetey-1-2013:p0797:b005:l027","ordinal":137310,"en":"He had grown up and become a warrior,"},{"id":"semetey-1-2013:p0797:b005:l028","ordinal":137311,"en":"The equal of a warrior's son."},{"id":"semetey-1-2013:p0797:b005:l029","ordinal":137312,"en":"Everyone who saw him was moved:"},{"id":"semetey-1-2013:p0797:b005:l030","ordinal":137313,"en":"The departed, fierce Manas—"},{"id":"semetey-1-2013:p0797:b005:l031","ordinal":137314,"en":"He looked exactly like him."},{"id":"semetey-1-2013:p0797:b005:l032","ordinal":137315,"en":"Khan Manas's Akolpok"},{"id":"semetey-1-2013:p0797:b005:l033","ordinal":137316,"en":"The orphan boy now put on."},{"id":"semetey-1-2013:p0797:b005:l034","ordinal":137317,"en":"With one set of nine buttons,"},{"id":"semetey-1-2013:p0797:b005:l035","ordinal":137318,"en":"From mountain-like Manas,"},{"id":"semetey-1-2013:p0797:b005:l036","ordinal":137319,"en":"The armor left as an inheritance,"},{"id":"semetey-1-2013:p0798:b003:l001","ordinal":137320,"en":"He fastened its buttons."},{"id":"semetey-1-2013:p0798:b003:l002","ordinal":137321,"en":"Its ties were one set of nine;"},{"id":"semetey-1-2013:p0798:b003:l003","ordinal":137322,"en":"He fastened its ties."},{"id":"semetey-1-2013:p0798:b003:l004","ordinal":137323,"en":"Rejoicing, ‘O God!’"},{"id":"semetey-1-2013:p0798:b003:l005","ordinal":137324,"en":"He put on Akolpok."},{"id":"semetey-1-2013:p0798:b003:l006","ordinal":137325,"en":"The gray belt-pouch left by Manas"},{"id":"semetey-1-2013:p0798:b003:l007","ordinal":137326,"en":"He girded and fastened at his waist."},{"id":"semetey-1-2013:p0798:b003:l008","ordinal":137327,"en":"The young lord, the leopard,"},{"id":"semetey-1-2013:p0798:b003:l009","ordinal":137328,"en":"His father who had died long ago—"},{"id":"semetey-1-2013:p0798:b003:l010","ordinal":137329,"en":"He had become like Manas."},{"id":"semetey-1-2013:p0798:b003:l011","ordinal":137330,"en":"Zulpukor, left by his father Manas,"},{"id":"semetey-1-2013:p0798:b003:l012","ordinal":137331,"en":"The precious lion's son,"},{"id":"semetey-1-2013:p0798:b003:l013","ordinal":137332,"en":"Rejoicing under Khyzyr's blessing,"},{"id":"semetey-1-2013:p0798:b003:l014","ordinal":137333,"en":"Dressed in his father Manas's likeness,"},{"id":"semetey-1-2013:p0798:b003:l015","ordinal":137334,"en":"The inherited Zulpukor"},{"id":"semetey-1-2013:p0798:b003:l016","ordinal":137335,"en":"He hung upon his left side."},{"id":"semetey-1-2013:p0798:b003:l018","ordinal":137336,"en":"He swore many oaths:","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0798:b003:l019","ordinal":137337,"en":"‘Zulpukor, left by the bloodthirsty hero,"},{"id":"semetey-1-2013:p0798:b003:l020","ordinal":137338,"en":"If I flee an enemy I face,"},{"id":"semetey-1-2013:p0798:b003:l021","ordinal":137339,"en":"May God strike me down!"},{"id":"semetey-1-2013:p0798:b003:l022","ordinal":137340,"en":"If you slip from where I strike,"},{"id":"semetey-1-2013:p0798:b003:l023","ordinal":137341,"en":"May God strike you down!"},{"id":"semetey-1-2013:p0798:b003:l024","ordinal":137342,"en":"I shall spread your fame among the people."},{"id":"semetey-1-2013:p0798:b003:l025","ordinal":137343,"en":"When you meet the enemy in combat,"},{"id":"semetey-1-2013:p0798:b003:l026","ordinal":137344,"en":"I shall drench you in red blood!’"},{"id":"semetey-1-2013:p0798:b003:l027","ordinal":137345,"en":"He hung his sword in its place."},{"id":"semetey-1-2013:p0798:b003:l028","ordinal":137346,"en":"A mirror upon the shoulder when slung,"},{"id":"semetey-1-2013:p0798:b003:l029","ordinal":137347,"en":"When turned against a fighting enemy,"},{"id":"semetey-1-2013:p0798:b003:l030","ordinal":137348,"en":"The comfort of this mortal life,"},{"id":"semetey-1-2013:p0798:b003:l031","ordinal":137349,"en":"It was a possession left by his father Manas."},{"id":"semetey-1-2013:p0798:b003:l032","ordinal":137350,"en":"His father's Akkelte"},{"id":"semetey-1-2013:p0798:b003:l033","ordinal":137351,"en":"He hung upon his shoulder."},{"id":"semetey-1-2013:p0798:b003:l034","ordinal":137352,"en":"Hurrying in haste, Semetey"},{"id":"semetey-1-2013:p0798:b003:l035","ordinal":137353,"en":"Now set off toward Bukhara."},{"id":"semetey-1-2013:p0798:b003:l036","ordinal":137354,"en":"When your orphan had received all these,"},{"id":"semetey-1-2013:p0798:b003:l037","ordinal":137355,"en":"He shone in all his beauty."},{"id":"semetey-1-2013:p0798:b003:l038","ordinal":137356,"en":"The fierce hero's Akshumkar, big as a leather pail,"},{"id":"semetey-1-2013:p0798:b004:l001","ordinal":137357,"en":"Gleamed upon his right hand."},{"id":"semetey-1-2013:p0798:b004:l002","ordinal":137358,"en":"The sight of him moved the heart;"},{"id":"semetey-1-2013:p0798:b004:l003","ordinal":137359,"en":"The young son of Manas"},{"id":"semetey-1-2013:p0798:b004:l004","ordinal":137360,"en":"Showed his warrior's bearing."},{"id":"semetey-1-2013:p0798:b004:l005","ordinal":137361,"en":"Kumaik, left by Manas,"},{"id":"semetey-1-2013:p0798:b004:l006","ordinal":137362,"en":"Could be seen a day's journey ahead."},{"id":"semetey-1-2013:p0798:b004:l007","ordinal":137363,"en":"Against the orphan, Manas's son,"},{"id":"semetey-1-2013:p0798:b004:l008","ordinal":137364,"en":"None could stand in a shooting fight;"},{"id":"semetey-1-2013:p0798:b004:l009","ordinal":137365,"en":"No man could look upon his face."},{"id":"semetey-1-2013:p0798:b004:l010","ordinal":137366,"en":"Against the orphan's strength"},{"id":"semetey-1-2013:p0798:b004:l011","ordinal":137367,"en":"No mountain could withstand him."},{"id":"semetey-1-2013:p0798:b004:l012","ordinal":137368,"en":"With trust in fate, if Allah helped him,"},{"id":"semetey-1-2013:p0798:b004:l013","ordinal":137369,"en":"Though the Chinese came in throngs,"},{"id":"semetey-1-2013:p0798:b004:l015","ordinal":137370,"en":"None could endure the boy's fury;","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0798:b004:l016","ordinal":137371,"en":"No charging foe could approach him."},{"id":"semetey-1-2013:p0798:b004:l017","ordinal":137372,"en":"The sight of him moved the heart."},{"id":"semetey-1-2013:p0798:b004:l018","ordinal":137373,"en":"All twelve parts of his body were in harmony;"},{"id":"semetey-1-2013:p0798:b004:l019","ordinal":137374,"en":"He appeared like Manas."},{"id":"semetey-1-2013:p0798:b004:l020","ordinal":137375,"en":"As great as a mountain,"},{"id":"semetey-1-2013:p0798:b004:l021","ordinal":137376,"en":"Your orphan, Manas's son,"},{"id":"semetey-1-2013:p0798:b004:l022","ordinal":137377,"en":"Everyone who faced him,"},{"id":"semetey-1-2013:p0798:b004:l023","ordinal":137378,"en":"He seemed able to chew up and eat alive."},{"id":"semetey-1-2013:p0798:b004:l024","ordinal":137379,"en":"Battle-axe and spear stood out;"},{"id":"semetey-1-2013:p0798:b004:l025","ordinal":137380,"en":"He urged his horse toward Bukhara,"},{"id":"semetey-1-2013:p0798:b004:l026","ordinal":137381,"en":"Your orphan, the son of Manas,"},{"id":"semetey-1-2013:p0798:b004:l027","ordinal":137382,"en":"Appearing like a lion."},{"id":"semetey-1-2013:p0798:b004:l028","ordinal":137383,"en":"He crossed ridge after ridge,"},{"id":"semetey-1-2013:p0798:b004:l029","ordinal":137384,"en":"Passed over knolls and hollows,"},{"id":"semetey-1-2013:p0798:b004:l030","ordinal":137385,"en":"Crossed hill after hill,"},{"id":"semetey-1-2013:p0798:b004:l031","ordinal":137386,"en":"Traveled the rugged passes."},{"id":"semetey-1-2013:p0798:b004:l032","ordinal":137387,"en":"He traversed steep, deep ravines;"},{"id":"semetey-1-2013:p0798:b004:l033","ordinal":137388,"en":"The leopard, Manas's son,"},{"id":"semetey-1-2013:p0798:b004:l034","ordinal":137389,"en":"Crossed the rounded mountain heights,"},{"id":"semetey-1-2013:p0798:b004:l035","ordinal":137390,"en":"Around the hillock-strewn passes,"},{"id":"semetey-1-2013:p0798:b004:l036","ordinal":137391,"en":"Winding on with determination,"},{"id":"semetey-1-2013:p0798:b004:l037","ordinal":137392,"en":"To the spur of the mountain's end,"},{"id":"semetey-1-2013:p0798:b004:l038","ordinal":137393,"en":"To the jutting headland,"},{"id":"semetey-1-2013:p0798:b004:l039","ordinal":137394,"en":"He had just come and gained a footing,"},{"id":"semetey-1-2013:p0799:b003:l001","ordinal":137395,"en":"Aktulpar, whom he had been leading,"},{"id":"semetey-1-2013:p0799:b003:l002","ordinal":137396,"en":"Your accomplished young lord"},{"id":"semetey-1-2013:p0799:b003:l003","ordinal":137397,"en":"Loosed and drove ahead,"},{"id":"semetey-1-2013:p0799:b003:l004","ordinal":137398,"en":"Drove hard without giving him rest."},{"id":"semetey-1-2013:p0799:b003:l005","ordinal":137399,"en":"The horse Buurul beneath him,"},{"id":"semetey-1-2013:p0799:b003:l006","ordinal":137400,"en":"At ‘Go!’ pulled free of his hand."},{"id":"semetey-1-2013:p0799:b003:l007","ordinal":137401,"en":"When ridge after ridge appeared,"},{"id":"semetey-1-2013:p0799:b003:l008","ordinal":137402,"en":"Do not ask how the hero fared!"},{"id":"semetey-1-2013:p0799:b003:l009","ordinal":137403,"en":"When pits and mounds appeared,"},{"id":"semetey-1-2013:p0799:b003:l010","ordinal":137404,"en":"Let me tell you of his horse:"},{"id":"semetey-1-2013:p0799:b003:l011","ordinal":137405,"en":"His back bent like a trap;"},{"id":"semetey-1-2013:p0799:b003:l012","ordinal":137406,"en":"When a chasm as wide as a ravine appeared,"},{"id":"semetey-1-2013:p0799:b003:l013","ordinal":137407,"en":"He sprang across without catching, gathering himself."},{"id":"semetey-1-2013:p0799:b003:l014","ordinal":137408,"en":"‘Truly, he is a swift steed!’"},{"id":"semetey-1-2013:p0799:b003:l015","ordinal":137409,"en":"The brave orphan, Manas's son,"},{"id":"semetey-1-2013:p0799:b003:l016","ordinal":137410,"en":"Rejoiced in delight."},{"id":"semetey-1-2013:p0799:b003:l017","ordinal":137411,"en":"Then the boy thought:"},{"id":"semetey-1-2013:p0799:b003:l018","ordinal":137412,"en":"‘Today I have mounted him for the first time."},{"id":"semetey-1-2013:p0799:b003:l019","ordinal":137413,"en":"This creature, the horse Buurul,"},{"id":"semetey-1-2013:p0799:b003:l020","ordinal":137414,"en":"Is truly a noble steed."},{"id":"semetey-1-2013:p0799:b003:l021","ordinal":137415,"en":"Today his noble nature has been revealed."},{"id":"semetey-1-2013:p0799:b003:l022","ordinal":137416,"en":"The dark earth his hooves strike"},{"id":"semetey-1-2013:p0799:b003:l023","ordinal":137417,"en":"Splits apart on every side."},{"id":"semetey-1-2013:p0799:b003:l024","ordinal":137418,"en":"If he travels a full six months,"},{"id":"semetey-1-2013:p0799:b003:l025","ordinal":137419,"en":"His noble nature will show.’"},{"id":"semetey-1-2013:p0799:b003:l026","ordinal":137420,"en":"When Semetey looked alongside,"},{"id":"semetey-1-2013:p0799:b003:l027","ordinal":137421,"en":"Where the hoof struck squarely,"},{"id":"semetey-1-2013:p0799:b003:l028","ordinal":137422,"en":"A hollow opened like a hearth pit."},{"id":"semetey-1-2013:p0799:b003:l029","ordinal":137423,"en":"Where the hoof scraped in passing,"},{"id":"semetey-1-2013:p0799:b003:l030","ordinal":137424,"en":"A mark was gouged and cut."},{"id":"semetey-1-2013:p0799:b003:l031","ordinal":137425,"en":"The ground where the creature stepped flew apart."},{"id":"semetey-1-2013:p0799:b003:l033","ordinal":137426,"en":"Clods as large as cauldrons"},{"id":"semetey-1-2013:p0799:b003:l034","ordinal":137427,"en":"Whistled above your lord's head,"},{"id":"semetey-1-2013:p0799:b003:l035","ordinal":137428,"en":"Racing against flying birds."},{"id":"semetey-1-2013:p0799:b003:l036","ordinal":137429,"en":"He traveled far upon his journey,"},{"id":"semetey-1-2013:p0799:b003:l037","ordinal":137430,"en":"Covered much ground, sparing no horse."},{"id":"semetey-1-2013:p0799:b003:l038","ordinal":137431,"en":"The white reins plaited in rounded knots"},{"id":"semetey-1-2013:p0799:b003:l039","ordinal":137432,"en":"He gripped tightly with both hands,"},{"id":"semetey-1-2013:p0799:b004:l001","ordinal":137433,"en":"Making him strain as though a husband had died,"},{"id":"semetey-1-2013:p0799:b004:l002","ordinal":137434,"en":"Struggling against the steed's mouth."},{"id":"semetey-1-2013:p0799:b004:l003","ordinal":137435,"en":"He traveled toward Bukhara,"},{"id":"semetey-1-2013:p0799:b004:l004","ordinal":137436,"en":"Covered much ground, sparing no horse."},{"id":"semetey-1-2013:p0799:b004:l005","ordinal":137437,"en":"Wide Ak-Chii of great Bukhara—"},{"id":"semetey-1-2013:p0799:b004:l006","ordinal":137438,"en":"That was Khan Temir's land."},{"id":"semetey-1-2013:p0799:b004:l007","ordinal":137439,"en":"For a noble steed traveling without rest,"},{"id":"semetey-1-2013:p0799:b004:l008","ordinal":137440,"en":"It was a journey of six days."},{"id":"semetey-1-2013:p0799:b004:l009","ordinal":137441,"en":"When he reached Ak-Chii,"},{"id":"semetey-1-2013:p0799:b004:l011","ordinal":137442,"en":"He had traveled without sparing him,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0799:b004:l012","ordinal":137443,"en":"Running swiftly with a thunderous rush."},{"id":"semetey-1-2013:p0799:b004:l013","ordinal":137444,"en":"Dark mud and flowing sweat"},{"id":"semetey-1-2013:p0799:b004:l014","ordinal":137445,"en":"Streamed down below the stirrup."},{"id":"semetey-1-2013:p0799:b004:l015","ordinal":137446,"en":"The horse Buurul beneath him"},{"id":"semetey-1-2013:p0799:b004:l016","ordinal":137447,"en":"Sped ever faster as he went,"},{"id":"semetey-1-2013:p0799:b004:l017","ordinal":137448,"en":"His strength kept growing."},{"id":"semetey-1-2013:p0799:b004:l018","ordinal":137449,"en":"Khan Temir's Aktulpar,"},{"id":"semetey-1-2013:p0799:b004:l019","ordinal":137450,"en":"As though stricken with a twisting sickness,"},{"id":"semetey-1-2013:p0799:b004:l020","ordinal":137451,"en":"The creature staggered."},{"id":"semetey-1-2013:p0799:b004:l021","ordinal":137452,"en":"Your boy's horse Buurul—"},{"id":"semetey-1-2013:p0799:b004:l022","ordinal":137453,"en":"No beast could match his walk,"},{"id":"semetey-1-2013:p0799:b004:l023","ordinal":137454,"en":"No wind could match his trot."},{"id":"semetey-1-2013:p0799:b004:l024","ordinal":137455,"en":"He rushed like a cloud,"},{"id":"semetey-1-2013:p0799:b004:l025","ordinal":137456,"en":"Roared more fiercely than the wind,"},{"id":"semetey-1-2013:p0799:b004:l026","ordinal":137457,"en":"Tossed his forelock toward the sky."},{"id":"semetey-1-2013:p0799:b004:l027","ordinal":137458,"en":"As the horse Buurul went onward,"},{"id":"semetey-1-2013:p0799:b004:l028","ordinal":137459,"en":"He plunged his hooves into the ground."},{"id":"semetey-1-2013:p0799:b004:l029","ordinal":137460,"en":"Where he stepped, the dark stones"},{"id":"semetey-1-2013:p0799:b004:l030","ordinal":137461,"en":"Scattered like ground meal."},{"id":"semetey-1-2013:p0799:b004:l031","ordinal":137462,"en":"Khan Temir's Aktulpar"},{"id":"semetey-1-2013:p0799:b004:l032","ordinal":137463,"en":"That day could not match Buurul:"},{"id":"semetey-1-2013:p0799:b004:l033","ordinal":137464,"en":"His walk could not match his walk,"},{"id":"semetey-1-2013:p0799:b004:l034","ordinal":137465,"en":"His trot could not match his trot."},{"id":"semetey-1-2013:p0799:b004:l035","ordinal":137466,"en":"Aktulpar was left behind."},{"id":"semetey-1-2013:p0799:b004:l036","ordinal":137467,"en":"When Aktulpar could go no farther,"},{"id":"semetey-1-2013:p0799:b004:l038","ordinal":137468,"en":"He firmly drew in his reins.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0799:b004:l039","ordinal":137469,"en":"When he came into view,"},{"id":"semetey-1-2013:p0800:b003:l001","ordinal":137470,"en":"When unseen, he became drifting blue smoke,"},{"id":"semetey-1-2013:p0800:b003:l002","ordinal":137471,"en":"Rushing as though he would fly."},{"id":"semetey-1-2013:p0800:b003:l003","ordinal":137472,"en":"So went the horse Buurul."}]
