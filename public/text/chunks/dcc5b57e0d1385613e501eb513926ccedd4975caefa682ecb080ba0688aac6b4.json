[{"id":"seytek-2012:p1143:b002:l034","ordinal":383489,"en":"When he struck, they collided,"},{"id":"seytek-2012:p1143:b002:l035","ordinal":383490,"en":"The iron-black charger"},{"id":"seytek-2012:p1143:b002:l036","ordinal":383491,"en":"And Seytek’s Kulansur"},{"id":"seytek-2012:p1143:b002:l037","ordinal":383492,"en":"Sank knee-deep into the sand,"},{"id":"seytek-2012:p1143:b002:l038","ordinal":383493,"en":"The spear broke apart with a crash,"},{"id":"seytek-2012:p1143:b002:l039","ordinal":383494,"en":"White splinters as large as a nomad’s hut"},{"id":"seytek-2012:p1143:b002:l040","ordinal":383495,"en":"Flew rattling into the sky,"},{"id":"seytek-2012:p1143:b003:l001","ordinal":383496,"en":"And the mighty son of Zhangzhung’s"},{"id":"seytek-2012:p1143:b003:l002","ordinal":383497,"en":"Supporting stirrup strap"},{"id":"seytek-2012:p1143:b003:l003","ordinal":383498,"en":"Was torn clean through."},{"id":"seytek-2012:p1143:b003:l004","ordinal":383499,"en":"His deep-blue iron helmet"},{"id":"seytek-2012:p1143:b003:l005","ordinal":383500,"en":"Flew off and struck the ground."},{"id":"seytek-2012:p1143:b003:l006","ordinal":383501,"en":"There was a battle-axe with a steel head"},{"id":"seytek-2012:p1143:b003:l007","ordinal":383502,"en":"In Seytek’s hand,"},{"id":"seytek-2012:p1143:b003:l008","ordinal":383503,"en":"Its haft entwined with gold,"},{"id":"seytek-2012:p1143:b003:l009","ordinal":383504,"en":"Its lamb-liver-shaped blade was keen steel,"},{"id":"seytek-2012:p1143:b003:l010","ordinal":383505,"en":"Forged and honed by gathered masters."},{"id":"seytek-2012:p1143:b003:l011","ordinal":383506,"en":"So no place it struck would remain unharmed,"},{"id":"seytek-2012:p1143:b003:l012","ordinal":383507,"en":"But would fester and grow inflamed,"},{"id":"seytek-2012:p1143:b003:l013","ordinal":383508,"en":"So that the death of one it gashed"},{"id":"seytek-2012:p1143:b003:l014","ordinal":383509,"en":"Would come within a mare’s milking,"},{"id":"seytek-2012:p1143:b003:l015","ordinal":383510,"en":"His gall would burst and his soul burn,"},{"id":"seytek-2012:p1143:b003:l016","ordinal":383511,"en":"And he would depart this world,"},{"id":"seytek-2012:p1143:b003:l017","ordinal":383512,"en":"They had whetted its edge,"},{"id":"seytek-2012:p1143:b003:l018","ordinal":383513,"en":"In the venom of a dragon"},{"id":"seytek-2012:p1143:b003:l019","ordinal":383514,"en":"And the deadly vapor of a ravenous demon"},{"id":"seytek-2012:p1143:b003:l020","ordinal":383515,"en":"They had tempered it sixty times,"},{"id":"seytek-2012:p1143:b003:l021","ordinal":383516,"en":"And any mortal whom it touched"},{"id":"seytek-2012:p1143:b003:l022","ordinal":383517,"en":"It instantly robbed of life;"},{"id":"seytek-2012:p1143:b003:l023","ordinal":383518,"en":"Such was the Oikuma in his hand."},{"id":"seytek-2012:p1143:b003:l024","ordinal":383519,"en":"The most nimble and skillful champion,"},{"id":"seytek-2012:p1143:b003:l025","ordinal":383520,"en":"A wise man versed in every stratagem,"},{"id":"seytek-2012:p1143:b003:l026","ordinal":383521,"en":"Your finest gray wolf of war,"},{"id":"seytek-2012:p1143:b003:l027","ordinal":383522,"en":"Grasped it by the haft,"},{"id":"seytek-2012:p1143:b003:l028","ordinal":383523,"en":"Drew Oikuma from its sheath,"},{"id":"seytek-2012:p1143:b003:l029","ordinal":383524,"en":"Skillfully swung the blade,"},{"id":"seytek-2012:p1143:b003:l030","ordinal":383525,"en":"And struck the heroic son of Ai-Zhangzhung"},{"id":"seytek-2012:p1143:b003:l031","ordinal":383526,"en":"Upon the head;"},{"id":"seytek-2012:p1143:b003:l032","ordinal":383527,"en":"His head split in two,"},{"id":"seytek-2012:p1143:b003:l033","ordinal":383528,"en":"The champion’s blood poured out,"},{"id":"seytek-2012:p1143:b003:l034","ordinal":383529,"en":"And like a collapsing mountain"},{"id":"seytek-2012:p1143:b003:l035","ordinal":383530,"en":"He toppled from his horse."},{"id":"seytek-2012:p1143:b003:l036","ordinal":383531,"en":"When the champion fell from his mount,"},{"id":"seytek-2012:p1143:b003:l037","ordinal":383532,"en":"When he came crashing to the ground,"},{"id":"seytek-2012:p1143:b003:l038","ordinal":383533,"en":"Er Bilgich, son of Kojozhash,"},{"id":"seytek-2012:p1143:b003:l039","ordinal":383534,"en":"A destroyer surpassing all mortals,"},{"id":"seytek-2012:p1143:b003:l040","ordinal":383535,"en":"A sorcerous archer,"},{"id":"seytek-2012:p1144:b002:l001","ordinal":383536,"en":"Cried, “Now I am left alone!"},{"id":"seytek-2012:p1144:b002:l002","ordinal":383537,"en":"There were ninety men as great as mountains,"},{"id":"seytek-2012:p1144:b002:l003","ordinal":383538,"en":"Though all ninety might die,"},{"id":"seytek-2012:p1144:b002:l004","ordinal":383539,"en":"Kaisar alone was a true hero."},{"id":"seytek-2012:p1144:b002:l005","ordinal":383540,"en":"Among the coat-clad Chinese"},{"id":"seytek-2012:p1144:b002:l006","ordinal":383541,"en":"He was the son of the strongest,"},{"id":"seytek-2012:p1144:b002:l007","ordinal":383542,"en":"From the pure breed that girded itself with stone,"},{"id":"seytek-2012:p1144:b002:l008","ordinal":383543,"en":"He surpassed even the great."},{"id":"seytek-2012:p1144:b002:l009","ordinal":383544,"en":"He met the enemy and was destroyed;"},{"id":"seytek-2012:p1144:b002:l010","ordinal":383545,"en":"Our dream has turned ill."},{"id":"seytek-2012:p1144:b002:l011","ordinal":383546,"en":"Our khan died before even striking—"},{"id":"seytek-2012:p1144:b002:l012","ordinal":383547,"en":"Has such a thing ever happened in all the ages?"},{"id":"seytek-2012:p1144:b002:l013","ordinal":383548,"en":"Deprived of our renowned champion,"},{"id":"seytek-2012:p1144:b002:l014","ordinal":383549,"en":"Our forces are thrown into distress."},{"id":"seytek-2012:p1144:b002:l015","ordinal":383550,"en":"Our splendid hero Kaisar is gone,"},{"id":"seytek-2012:p1144:b002:l016","ordinal":383551,"en":"And now our backbone is broken."},{"id":"seytek-2012:p1144:b002:l017","ordinal":383552,"en":"Having let the Kyrgyz triumph"},{"id":"seytek-2012:p1144:b002:l018","ordinal":383553,"en":"And surrendered mighty Kaisar"},{"id":"seytek-2012:p1144:b002:l019","ordinal":383554,"en":"To those accursed Burut,"},{"id":"seytek-2012:p1144:b002:l020","ordinal":383555,"en":"How can we retreat without shame?"},{"id":"seytek-2012:p1144:b002:l021","ordinal":383556,"en":"What answer shall we give"},{"id":"seytek-2012:p1144:b002:l022","ordinal":383557,"en":"To our great leader Kite?”"},{"id":"seytek-2012:p1144:b002:l023","ordinal":383558,"en":"So saying, Chongbilgich"},{"id":"seytek-2012:p1144:b002:l024","ordinal":383559,"en":"Roared out his grief,"},{"id":"seytek-2012:p1144:b002:l025","ordinal":383560,"en":"And every mortal who heard him"},{"id":"seytek-2012:p1144:b002:l026","ordinal":383561,"en":"Shuddered from head to foot."},{"id":"seytek-2012:p1144:b002:l027","ordinal":383562,"en":"Pale and ashen,"},{"id":"seytek-2012:p1144:b002:l028","ordinal":383563,"en":"Wild with fury and scowling,"},{"id":"seytek-2012:p1144:b002:l029","ordinal":383564,"en":"He loomed, scattering his wrath;"},{"id":"seytek-2012:p1144:b002:l030","ordinal":383565,"en":"The wretched warrior from the khagan’s realm"},{"id":"seytek-2012:p1144:b002:l031","ordinal":383566,"en":"Reared like a towering mountain."},{"id":"seytek-2012:p1144:b002:l032","ordinal":383567,"en":"The sorcerous warrior-hero"},{"id":"seytek-2012:p1144:b002:l033","ordinal":383568,"en":"Truly brought on the end of the age;"},{"id":"seytek-2012:p1144:b002:l034","ordinal":383569,"en":"His valor became plain"},{"id":"seytek-2012:p1144:b002:l035","ordinal":383570,"en":"When he roared and charged—"},{"id":"seytek-2012:p1144:b002:l036","ordinal":383571,"en":"Not only men but beasts,"},{"id":"seytek-2012:p1144:b002:l037","ordinal":383572,"en":"Champions with strength upon strength,"},{"id":"seytek-2012:p1144:b002:l038","ordinal":383573,"en":"Overwhelming, conquering monsters,"},{"id":"seytek-2012:p1144:b002:l039","ordinal":383574,"en":"Devourers of all they encountered—"},{"id":"seytek-2012:p1144:b002:l040","ordinal":383575,"en":"Every listening ear was stunned,"},{"id":"seytek-2012:p1144:b003:l001","ordinal":383576,"en":"And at the sight of his dread aspect"},{"id":"seytek-2012:p1144:b003:l002","ordinal":383577,"en":"Every living creature"},{"id":"seytek-2012:p1144:b003:l003","ordinal":383578,"en":"Despaired utterly of life,"},{"id":"seytek-2012:p1144:b003:l004","ordinal":383579,"en":"Eyelashes quivered as though singed,"},{"id":"seytek-2012:p1144:b003:l005","ordinal":383580,"en":"Lips twitched and whispered,"},{"id":"seytek-2012:p1144:b003:l006","ordinal":383581,"en":"When roused, his words boomed,"},{"id":"seytek-2012:p1144:b003:l007","ordinal":383582,"en":"And the massed teeth in both jaws"},{"id":"seytek-2012:p1144:b003:l008","ordinal":383583,"en":"Clattered like a mill."},{"id":"seytek-2012:p1144:b003:l009","ordinal":383584,"en":"They charged Seytek all together,"},{"id":"seytek-2012:p1144:b003:l010","ordinal":383585,"en":"Loosing bows like pouring rain,"},{"id":"seytek-2012:p1144:b003:l011","ordinal":383586,"en":"Shooting arrows like falling hail,"},{"id":"seytek-2012:p1144:b003:l012","ordinal":383587,"en":"Thrusting spears with clamor."},{"id":"seytek-2012:p1144:b003:l013","ordinal":383588,"en":"In their midst, the hero Seytek"},{"id":"seytek-2012:p1144:b003:l014","ordinal":383589,"en":"Turned Kulansur’s head;"},{"id":"seytek-2012:p1144:b003:l015","ordinal":383590,"en":"There was no refuge but God,"},{"id":"seytek-2012:p1144:b003:l016","ordinal":383591,"en":"Without so much as twitching brow or eyelid,"},{"id":"seytek-2012:p1144:b003:l017","ordinal":383592,"en":"The poor hero now stood watching."},{"id":"seytek-2012:p1144:b003:l018","ordinal":383593,"en":"Raising his shield against arrows,"},{"id":"seytek-2012:p1144:b003:l019","ordinal":383594,"en":"Beating spears aside,"},{"id":"seytek-2012:p1144:b003:l020","ordinal":383595,"en":"Striking back and forth,"},{"id":"seytek-2012:p1144:b003:l021","ordinal":383596,"en":"He made Kulansur dance,"},{"id":"seytek-2012:p1144:b003:l022","ordinal":383597,"en":"And laid low everyone he met,"},{"id":"seytek-2012:p1144:b003:l023","ordinal":383598,"en":"Waging war without a care."},{"id":"seytek-2012:p1144:b003:l024","ordinal":383599,"en":"Upon his great Kerik beneath him,"},{"id":"seytek-2012:p1144:b003:l025","ordinal":383600,"en":"Bilgich laid the coarse whip,"},{"id":"seytek-2012:p1144:b003:l026","ordinal":383601,"en":"Spurred in from the flank,"},{"id":"seytek-2012:p1144:b003:l027","ordinal":383602,"en":"And drove his spear home."},{"id":"seytek-2012:p1144:b003:l028","ordinal":383603,"en":"His stratagem prevailed,"},{"id":"seytek-2012:p1144:b003:l029","ordinal":383604,"en":"And the spear of the hero Bilgich"},{"id":"seytek-2012:p1144:b003:l030","ordinal":383605,"en":"Struck Seytek cruelly."},{"id":"seytek-2012:p1144:b003:l031","ordinal":383606,"en":"God forbid the sight!"},{"id":"seytek-2012:p1144:b003:l032","ordinal":383607,"en":"At that moment Chongbilgich"},{"id":"seytek-2012:p1144:b003:l033","ordinal":383608,"en":"Shook off all grief and sorrow,"},{"id":"seytek-2012:p1144:b003:l034","ordinal":383609,"en":"Recovered without pausing for breath,"},{"id":"seytek-2012:p1144:b003:l035","ordinal":383610,"en":"And where he had thrust once, thrust four times,"},{"id":"seytek-2012:p1144:b003:l036","ordinal":383611,"en":"Driving each straight without wavering,"},{"id":"seytek-2012:p1144:b003:l037","ordinal":383612,"en":"With greater force than before,"},{"id":"seytek-2012:p1144:b003:l038","ordinal":383613,"en":"Striking harder with every thrust,"},{"id":"seytek-2012:p1144:b003:l039","ordinal":383614,"en":"Driving each straight without wavering,"},{"id":"seytek-2012:p1144:b003:l040","ordinal":383615,"en":"Driving each hard without wavering."},{"id":"seytek-2012:p1145:b002:l001","ordinal":383616,"en":"The sky was clear, the earth was mist,"},{"id":"seytek-2012:p1145:b002:l002","ordinal":383617,"en":"No figure could be made out,"},{"id":"seytek-2012:p1145:b002:l003","ordinal":383618,"en":"So dense was the battle’s turmoil"},{"id":"seytek-2012:p1145:b002:l004","ordinal":383619,"en":"That none could tell who was who."},{"id":"seytek-2012:p1145:b002:l005","ordinal":383620,"en":"They surrounded the champion,"},{"id":"seytek-2012:p1145:b002:l006","ordinal":383621,"en":"And then Chongbilgich"},{"id":"seytek-2012:p1145:b002:l007","ordinal":383622,"en":"Exhausted every stratagem,"},{"id":"seytek-2012:p1145:b002:l008","ordinal":383623,"en":"Making every assault he launched"},{"id":"seytek-2012:p1145:b002:l009","ordinal":383624,"en":"Pierce to the ribs."},{"id":"seytek-2012:p1145:b002:l010","ordinal":383625,"en":"He commanded those who remained alive,"},{"id":"seytek-2012:p1145:b002:l011","ordinal":383626,"en":"Proclaiming to the champions,"},{"id":"seytek-2012:p1145:b002:l012","ordinal":383627,"en":"And crying out to all the world:"},{"id":"seytek-2012:p1145:b002:l013","ordinal":383628,"en":"“He is renowned indeed, a true mainstay,"},{"id":"seytek-2012:p1145:b002:l014","ordinal":383629,"en":"A hero sprung from the Burut."},{"id":"seytek-2012:p1145:b002:l015","ordinal":383630,"en":"Though born of woman in human form,"},{"id":"seytek-2012:p1145:b002:l016","ordinal":383631,"en":"He is one of the demons."},{"id":"seytek-2012:p1145:b002:l017","ordinal":383632,"en":"This infidel who came without support—"},{"id":"seytek-2012:p1145:b002:l018","ordinal":383633,"en":"His cunning is great, his venom strong;"},{"id":"seytek-2012:p1145:b002:l019","ordinal":383634,"en":"A hero such as this"},{"id":"seytek-2012:p1145:b002:l020","ordinal":383635,"en":"Is peerless, a true warrior."},{"id":"seytek-2012:p1145:b002:l021","ordinal":383636,"en":"He is their most vaunted son,"},{"id":"seytek-2012:p1145:b002:l022","ordinal":383637,"en":"The lord awaited"},{"id":"seytek-2012:p1145:b002:l023","ordinal":383638,"en":"By the Kyrgyz of Ala-Too,"},{"id":"seytek-2012:p1145:b002:l024","ordinal":383639,"en":"The very model of might,"},{"id":"seytek-2012:p1145:b002:l025","ordinal":383640,"en":"The dark eye of all heroes."},{"id":"seytek-2012:p1145:b002:l026","ordinal":383641,"en":"Surround him, champions!"},{"id":"seytek-2012:p1145:b002:l027","ordinal":383642,"en":"If we seize him, what regret could remain?"},{"id":"seytek-2012:p1145:b002:l028","ordinal":383643,"en":"Press in and fight him,"},{"id":"seytek-2012:p1145:b002:l029","ordinal":383644,"en":"And let us take him alive."},{"id":"seytek-2012:p1145:b002:l030","ordinal":383645,"en":"To the great hero Kite we shall say,"},{"id":"seytek-2012:p1145:b002:l031","ordinal":383646,"en":"‘We came after destroying his nest,"},{"id":"seytek-2012:p1145:b002:l032","ordinal":383647,"en":"We dammed and diverted his water,"},{"id":"seytek-2012:p1145:b002:l033","ordinal":383648,"en":"And tore out by the roots"},{"id":"seytek-2012:p1145:b002:l034","ordinal":383649,"en":"The whole line of these babbling Kyrgyz."},{"id":"seytek-2012:p1145:b002:l035","ordinal":383650,"en":"We brought calamity upon their hero,"},{"id":"seytek-2012:p1145:b002:l036","ordinal":383651,"en":"And bound and captured the prince"},{"id":"seytek-2012:p1145:b002:l037","ordinal":383652,"en":"Who was lord of the Kyrgyz.’"},{"id":"seytek-2012:p1145:b002:l038","ordinal":383653,"en":"To the heroic son of Kaldai,"},{"id":"seytek-2012:p1145:b002:l039","ordinal":383654,"en":"Whose wrath is strong as doomsday,"},{"id":"seytek-2012:p1145:b002:l040","ordinal":383655,"en":"In fulfillment of the fallen hero’s word,"},{"id":"seytek-2012:p1145:b004:l001","ordinal":383656,"en":"To great Kite himself,"},{"id":"seytek-2012:p1145:b004:l002","ordinal":383657,"en":"Let us present him as a gift."},{"id":"seytek-2012:p1145:b004:l003","ordinal":383658,"en":"Then let us go and claim, without yielding,"},{"id":"seytek-2012:p1145:b004:l004","ordinal":383659,"en":"The khanship of the forty tribes."},{"id":"seytek-2012:p1145:b004:l005","ordinal":383660,"en":"Let us not kill him swiftly,"},{"id":"seytek-2012:p1145:b004:l006","ordinal":383661,"en":"But put him to death in torment;"},{"id":"seytek-2012:p1145:b004:l007","ordinal":383662,"en":"Let us not kill him in a lonely place,"},{"id":"seytek-2012:p1145:b004:l008","ordinal":383663,"en":"But put him to death by force"},{"id":"seytek-2012:p1145:b004:l009","ordinal":383664,"en":"Atop Beijing’s golden throne,"},{"id":"seytek-2012:p1145:b004:l010","ordinal":383665,"en":"In its garden of ranked plane trees,"},{"id":"seytek-2012:p1145:b004:l011","ordinal":383666,"en":"Before the fortunate carpet,"},{"id":"seytek-2012:p1145:b004:l012","ordinal":383667,"en":"At the famous Zuu pit known to the people,"},{"id":"seytek-2012:p1145:b004:l013","ordinal":383668,"en":"Encircled by many great lords."},{"id":"seytek-2012:p1145:b004:l014","ordinal":383669,"en":"The Zuu pit has a living horror,"},{"id":"seytek-2012:p1145:b004:l015","ordinal":383670,"en":"A chasm forty fathoms deep."},{"id":"seytek-2012:p1145:b004:l016","ordinal":383671,"en":"Let us cast the unyielding Seytek"},{"id":"seytek-2012:p1145:b004:l017","ordinal":383672,"en":"Into that pit."},{"id":"seytek-2012:p1145:b004:l018","ordinal":383673,"en":"From this swine, for not merely one forefather"},{"id":"seytek-2012:p1145:b004:l019","ordinal":383674,"en":"But a thousand, let us exact revenge."},{"id":"seytek-2012:p1145:b004:l020","ordinal":383675,"en":"If Seytek falls, their backbone falls,"},{"id":"seytek-2012:p1145:b004:l021","ordinal":383676,"en":"The Kyrgyz lose their falcon-lion,"},{"id":"seytek-2012:p1145:b004:l022","ordinal":383677,"en":"And sacred unity departs with him."},{"id":"seytek-2012:p1145:b004:l023","ordinal":383678,"en":"Let us extinguish the fire kindled"},{"id":"seytek-2012:p1145:b004:l024","ordinal":383679,"en":"By the doomed man who leads them,"},{"id":"seytek-2012:p1145:b004:l025","ordinal":383680,"en":"Drive all his people away together,"},{"id":"seytek-2012:p1145:b004:l026","ordinal":383681,"en":"And make them common plunder;"},{"id":"seytek-2012:p1145:b004:l027","ordinal":383682,"en":"Thus let us take revenge"},{"id":"seytek-2012:p1145:b004:l028","ordinal":383683,"en":"Upon the swine who destroyed our peace."},{"id":"seytek-2012:p1145:b004:l029","ordinal":383684,"en":"Close in upon him, champions!"},{"id":"seytek-2012:p1145:b004:l030","ordinal":383685,"en":"He is a lord, he is a khan,"},{"id":"seytek-2012:p1145:b004:l031","ordinal":383686,"en":"He is a sacred soul."},{"id":"seytek-2012:p1145:b004:l032","ordinal":383687,"en":"Once we have cast him yellowing into the pit,"},{"id":"seytek-2012:p1145:b004:l033","ordinal":383688,"en":"Not one of those swine will remain,"},{"id":"seytek-2012:p1145:b004:l034","ordinal":383689,"en":"Not a drop of blood will be left in their veins,"},{"id":"seytek-2012:p1145:b004:l035","ordinal":383690,"en":"Not a soul will remain to show courage."},{"id":"seytek-2012:p1145:b004:l036","ordinal":383691,"en":"Wage the struggle on a broad front;"},{"id":"seytek-2012:p1145:b004:l037","ordinal":383692,"en":"Without killing or letting him vanish,"},{"id":"seytek-2012:p1145:b004:l038","ordinal":383693,"en":"This is my command, champions:"},{"id":"seytek-2012:p1145:b004:l039","ordinal":383694,"en":"Hoist him upon the Kerik-elephant"},{"id":"seytek-2012:p1145:b004:l040","ordinal":383695,"en":"And say, ‘Here is the enemy who came!’"},{"id":"seytek-2012:p1146:b002:l001","ordinal":383696,"en":"To Esenkhan, pillar of heroes,"},{"id":"seytek-2012:p1146:b002:l002","ordinal":383697,"en":"Say, ‘We have avenged the ancient wrong;"},{"id":"seytek-2012:p1146:b002:l003","ordinal":383698,"en":"The enemy who stood against us"},{"id":"seytek-2012:p1146:b002:l004","ordinal":383699,"en":"We have left without descendants."},{"id":"seytek-2012:p1146:b002:l005","ordinal":383700,"en":"Not merely three generations, but six,"},{"id":"seytek-2012:p1146:b002:l006","ordinal":383701,"en":"We have utterly avenged.’"},{"id":"seytek-2012:p1146:b002:l007","ordinal":383702,"en":"Go and tell this to the great lord."},{"id":"seytek-2012:p1146:b002:l008","ordinal":383703,"en":"Ask as a reward for the gold-bearing mines,"},{"id":"seytek-2012:p1146:b002:l009","ordinal":383704,"en":"The lands where tea is grown,"},{"id":"seytek-2012:p1146:b002:l010","ordinal":383705,"en":"And the slopes of Khan-Jailak,"},{"id":"seytek-2012:p1146:b002:l011","ordinal":383706,"en":"And claim them as your due."},{"id":"seytek-2012:p1146:b002:l012","ordinal":383707,"en":"You are one Burut against our multitude—"},{"id":"seytek-2012:p1146:b002:l013","ordinal":383708,"en":"Fight on without turning back!”"},{"id":"seytek-2012:p1146:b002:l014","ordinal":383709,"en":"So saying, Chongbilgich"},{"id":"seytek-2012:p1146:b002:l015","ordinal":383710,"en":"Stiffened the resolve of the fainthearted,"},{"id":"seytek-2012:p1146:b002:l016","ordinal":383711,"en":"And drove them on with sharp exhortations;"},{"id":"seytek-2012:p1146:b002:l017","ordinal":383712,"en":"Those of his best men who never retreated"},{"id":"seytek-2012:p1146:b002:l018","ordinal":383713,"en":"Chongbilgich chose and sent forward."},{"id":"seytek-2012:p1146:b002:l019","ordinal":383714,"en":"He praised his champions"},{"id":"seytek-2012:p1146:b002:l020","ordinal":383715,"en":"And drove them into battle."},{"id":"seytek-2012:p1146:b002:l021","ordinal":383716,"en":"Once authority gave its command,"},{"id":"seytek-2012:p1146:b002:l022","ordinal":383717,"en":"Would they turn and merely stare?"},{"id":"seytek-2012:p1146:b002:l023","ordinal":383718,"en":"Once the great lord’s order had come,"},{"id":"seytek-2012:p1146:b002:l024","ordinal":383719,"en":"Would they fail to charge where they were told?"},{"id":"seytek-2012:p1146:b002:l025","ordinal":383720,"en":"Would the champions stand and watch?"},{"id":"seytek-2012:p1146:b002:l026","ordinal":383721,"en":"The champions now surged forward."},{"id":"seytek-2012:p1146:b002:l027","ordinal":383722,"en":"When they had surrounded him,"},{"id":"seytek-2012:p1146:b002:l028","ordinal":383723,"en":"The champions numbered eighty,"},{"id":"seytek-2012:p1146:b002:l029","ordinal":383724,"en":"All who remained alive;"},{"id":"seytek-2012:p1146:b002:l030","ordinal":383725,"en":"When they sprang into battle,"},{"id":"seytek-2012:p1146:b002:l031","ordinal":383726,"en":"Chongbilgich came behind them,"},{"id":"seytek-2012:p1146:b002:l032","ordinal":383727,"en":"Driving them forward and clearing their path."},{"id":"seytek-2012:p1146:b002:l033","ordinal":383728,"en":"The champions who obeyed the command"},{"id":"seytek-2012:p1146:b002:l034","ordinal":383729,"en":"Advanced straight upon Seytek"},{"id":"seytek-2012:p1146:b002:l035","ordinal":383730,"en":"To capture him alive."},{"id":"seytek-2012:p1146:b002:l036","ordinal":383731,"en":"Those casting lassos ran forward,"},{"id":"seytek-2012:p1146:b002:l037","ordinal":383732,"en":"The spearmen plunged into turmoil,"},{"id":"seytek-2012:p1146:b002:l038","ordinal":383733,"en":"And those who cast iron nets"},{"id":"seytek-2012:p1146:b002:l039","ordinal":383734,"en":"Circled and drew near,"},{"id":"seytek-2012:p1146:b002:l040","ordinal":383735,"en":"All advancing together and loosing their bows."},{"id":"seytek-2012:p1146:b003:l001","ordinal":383736,"en":"The bowshots cracked,"},{"id":"seytek-2012:p1146:b003:l002","ordinal":383737,"en":"And as death drew near,"},{"id":"seytek-2012:p1146:b003:l003","ordinal":383738,"en":"Far from fearing, Seytek rejoiced;"},{"id":"seytek-2012:p1146:b003:l004","ordinal":383739,"en":"The peerless Seytek stood firm."},{"id":"seytek-2012:p1146:b003:l005","ordinal":383740,"en":"From every side they drove their spears"},{"id":"seytek-2012:p1146:b003:l006","ordinal":383741,"en":"Against him with pounding blows."},{"id":"seytek-2012:p1146:b003:l007","ordinal":383742,"en":"The splendid gray wolf, heir of his grandsire,"},{"id":"seytek-2012:p1146:b003:l008","ordinal":383743,"en":"Neither flinched nor twitched,"},{"id":"seytek-2012:p1146:b003:l009","ordinal":383744,"en":"Nor faltered or stirred."}]
