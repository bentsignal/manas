[{"id":"semetey-1-2013:p1112:b004:l021","ordinal":162049,"en":"And never squats to urinate."},{"id":"semetey-1-2013:p1112:b004:l022","ordinal":162050,"en":"In that monastery lives the kechil;"},{"id":"semetey-1-2013:p1112:b004:l023","ordinal":162051,"en":"Such is the kechil's custom:"},{"id":"semetey-1-2013:p1112:b004:l024","ordinal":162052,"en":"When his ox ages and he himself dies,"},{"id":"semetey-1-2013:p1112:b004:l025","ordinal":162053,"en":"It is the infidel's custom"},{"id":"semetey-1-2013:p1112:b004:l026","ordinal":162054,"en":"To divide the dead man's property equally."},{"id":"semetey-1-2013:p1112:b004:l027","ordinal":162055,"en":"He raises his billy goat as a sacred offering."},{"id":"semetey-1-2013:p1112:b004:l028","ordinal":162056,"en":"The horse he rides is holy;"},{"id":"semetey-1-2013:p1112:b004:l029","ordinal":162057,"en":"Taking no wife, the Lama"},{"id":"semetey-1-2013:p1112:b004:l030","ordinal":162058,"en":"Is a stranger to women."},{"id":"semetey-1-2013:p1112:b004:l031","ordinal":162059,"en":"He saddles his unbroken horse,"},{"id":"semetey-1-2013:p1112:b004:l032","ordinal":162060,"en":"Ties on his staff, saying “God,”"},{"id":"semetey-1-2013:p1112:b004:l033","ordinal":162061,"en":"And bows down to that very thing."},{"id":"semetey-1-2013:p1112:b004:l034","ordinal":162062,"en":"With a cotton sash and broad boots,"},{"id":"semetey-1-2013:p1112:b004:l035","ordinal":162063,"en":"An imposing peerless champion,"},{"id":"semetey-1-2013:p1112:b004:l036","ordinal":162064,"en":"Kongurbai is khan of the kechil."},{"id":"semetey-1-2013:p1112:b004:l037","ordinal":162065,"en":"Tell the most cunning of the spearmen,"},{"id":"semetey-1-2013:p1112:b004:l038","ordinal":162066,"en":"Tell the one who knows the enemy's stratagems,"},{"id":"semetey-1-2013:p1112:b004:l039","ordinal":162067,"en":"Tell the strongest man."},{"id":"semetey-1-2013:p1112:b004:l040","ordinal":162068,"en":"Kökötöy's son Bokmurun—"},{"id":"semetey-1-2013:p1113:b003:l001","ordinal":162069,"en":"Say he has camped at Üch-Karkyra;"},{"id":"semetey-1-2013:p1113:b003:l002","ordinal":162070,"en":"If Kongurbai is a hero,"},{"id":"semetey-1-2013:p1113:b003:l003","ordinal":162071,"en":"Let him not miss this feast of mine,"},{"id":"semetey-1-2013:p1113:b003:l004","ordinal":162072,"en":"Nor, by failing to come,"},{"id":"semetey-1-2013:p1113:b003:l005","ordinal":162073,"en":"Bring harsh calamity upon his own head."},{"id":"semetey-1-2013:p1113:b003:l006","ordinal":162074,"en":"Say he must come to this feast of mine,"},{"id":"semetey-1-2013:p1113:b003:l007","ordinal":162075,"en":"And see these festivities."},{"id":"semetey-1-2013:p1113:b003:l008","ordinal":162076,"en":"If he does not come to this feast of mine,"},{"id":"semetey-1-2013:p1113:b003:l009","ordinal":162077,"en":"If he does not see these festivities,"},{"id":"semetey-1-2013:p1113:b003:l010","ordinal":162078,"en":"Say he will see the bloodthirsty Burut at the head"},{"id":"semetey-1-2013:p1113:b003:l011","ordinal":162079,"en":"Of a scene of devastation!"},{"id":"semetey-1-2013:p1113:b003:l012","ordinal":162080,"en":"When you travel farther on,"},{"id":"semetey-1-2013:p1113:b003:l013","ordinal":162081,"en":"There is the giant called Döödür Alp,"},{"id":"semetey-1-2013:p1113:b003:l014","ordinal":162082,"en":"Tiken Alp and Mungush Alp,"},{"id":"semetey-1-2013:p1113:b003:l015","ordinal":162083,"en":"And the great wrestler Tükübay,"},{"id":"semetey-1-2013:p1113:b003:l016","ordinal":162084,"en":"Grim of face and strong of venom,"},{"id":"semetey-1-2013:p1113:b003:l017","ordinal":162085,"en":"Who lays his opponents flat."},{"id":"semetey-1-2013:p1113:b003:l018","ordinal":162086,"en":"Tell all these giants.”"},{"id":"semetey-1-2013:p1113:b004:l001","ordinal":162087,"en":"Having spoken and arranged it thus, Bokmurun"},{"id":"semetey-1-2013:p1113:b004:l002","ordinal":162088,"en":"Had him mount Maaniker,"},{"id":"semetey-1-2013:p1113:b004:l003","ordinal":162089,"en":"Had him don a mail coat,"},{"id":"semetey-1-2013:p1113:b004:l004","ordinal":162090,"en":"And strike the Koroson fire-steel,"},{"id":"semetey-1-2013:p1113:b004:l005","ordinal":162091,"en":"Inviting every one,"},{"id":"semetey-1-2013:p1113:b004:l006","ordinal":162092,"en":"Infidel and Muslim alike."},{"id":"semetey-1-2013:p1113:b004:l007","ordinal":162093,"en":"Kökötöy's many royal yurts"},{"id":"semetey-1-2013:p1113:b004:l008","ordinal":162094,"en":"Were raised side by side in rows."},{"id":"semetey-1-2013:p1113:b004:l009","ordinal":162095,"en":"Kökötöy's son Bokmurun"},{"id":"semetey-1-2013:p1113:b004:l010","ordinal":162096,"en":"Made festivities for the ages."},{"id":"semetey-1-2013:p1113:b004:l011","ordinal":162097,"en":"When the great encampment"},{"id":"semetey-1-2013:p1113:b004:l012","ordinal":162098,"en":"Of wealthy Khan Kökötöy settled,"},{"id":"semetey-1-2013:p1113:b004:l013","ordinal":162099,"en":"When the people gathered and filled it,"},{"id":"semetey-1-2013:p1113:b004:l014","ordinal":162100,"en":"I saw Manas's bearing."},{"id":"semetey-1-2013:p1113:b004:l015","ordinal":162101,"en":"I saw the fierce, formidable might"},{"id":"semetey-1-2013:p1113:b004:l016","ordinal":162102,"en":"By which Manas surpassed all others."},{"id":"semetey-1-2013:p1113:b004:l017","ordinal":162103,"en":"To protect the Muslim people,"},{"id":"semetey-1-2013:p1113:b004:l018","ordinal":162104,"en":"I saw Manas stand as a barrier."},{"id":"semetey-1-2013:p1113:b006:l001","ordinal":162105,"en":"Kökötöy's son Bokmurun"},{"id":"semetey-1-2013:p1113:b006:l002","ordinal":162106,"en":"Made festivities for the people;"},{"id":"semetey-1-2013:p1113:b006:l003","ordinal":162107,"en":"Exulting that he would hold a feast,"},{"id":"semetey-1-2013:p1113:b006:l004","ordinal":162108,"en":"He cast the world into turmoil."},{"id":"semetey-1-2013:p1113:b006:l005","ordinal":162109,"en":"Traveling along the road"},{"id":"semetey-1-2013:p1113:b006:l006","ordinal":162110,"en":"My father, brave Bagysh, had ridden,"},{"id":"semetey-1-2013:p1113:b006:l007","ordinal":162111,"en":"When he went to Karkyra"},{"id":"semetey-1-2013:p1113:b006:l008","ordinal":162112,"en":"And the people were counted,"},{"id":"semetey-1-2013:p1113:b006:l009","ordinal":162113,"en":"He had an army of twelve thousand."},{"id":"semetey-1-2013:p1113:b006:l010","ordinal":162114,"en":"Zhортуулчу, riding Zhooruker,"},{"id":"semetey-1-2013:p1113:b006:l011","ordinal":162115,"en":"Came down along the road"},{"id":"semetey-1-2013:p1113:b006:l012","ordinal":162116,"en":"With many armies spread across the land."},{"id":"semetey-1-2013:p1113:b006:l013","ordinal":162117,"en":"Zhügörü, khan of Koton,"},{"id":"semetey-1-2013:p1113:b006:l014","ordinal":162118,"en":"Also came in a dense mass,"},{"id":"semetey-1-2013:p1113:b006:l015","ordinal":162119,"en":"Dust flying to the sky."},{"id":"semetey-1-2013:p1113:b006:l016","ordinal":162120,"en":"Akun Khan, khan of the Afghans,"},{"id":"semetey-1-2013:p1113:b006:l017","ordinal":162121,"en":"Came with tasseled spears fluttering,"},{"id":"semetey-1-2013:p1113:b008:l001","ordinal":162122,"en":"His great fur cap swaying."},{"id":"semetey-1-2013:p1113:b008:l002","ordinal":162123,"en":"The Afghans came along the road"},{"id":"semetey-1-2013:p1113:b008:l003","ordinal":162124,"en":"With an army of twelve thousand."},{"id":"semetey-1-2013:p1113:b008:l004","ordinal":162125,"en":"Dust came from the lands between;"},{"id":"semetey-1-2013:p1113:b008:l005","ordinal":162126,"en":"As if that were not enough,"},{"id":"semetey-1-2013:p1113:b008:l006","ordinal":162127,"en":"They also came from India."},{"id":"semetey-1-2013:p1113:b008:l007","ordinal":162128,"en":"With resident sheikhs and blue-clad khojas,"},{"id":"semetey-1-2013:p1113:b008:l008","ordinal":162129,"en":"From prominent Kokand and Margalan,"},{"id":"semetey-1-2013:p1113:b008:l009","ordinal":162130,"en":"His thoroughbred snorting,"},{"id":"semetey-1-2013:p1113:b008:l010","ordinal":162131,"en":"His mottled breast heaving,"},{"id":"semetey-1-2013:p1113:b008:l011","ordinal":162132,"en":"Came Synzhybek, fork-bearded lord of Andizhan."},{"id":"semetey-1-2013:p1113:b008:l012","ordinal":162133,"en":"They divided into varied companies,"},{"id":"semetey-1-2013:p1113:b008:l013","ordinal":162134,"en":"And looked grim in appearance."},{"id":"semetey-1-2013:p1113:b008:l014","ordinal":162135,"en":"Those who came had no sense;"},{"id":"semetey-1-2013:p1113:b008:l015","ordinal":162136,"en":"The white-nosed men of Andizhan,"},{"id":"semetey-1-2013:p1113:b008:l016","ordinal":162137,"en":"Their horses all stallions,"},{"id":"semetey-1-2013:p1113:b008:l017","ordinal":162138,"en":"Had no cruppers at all."},{"id":"semetey-1-2013:p1114:b003:l001","ordinal":162139,"en":"Sanchybek of Samarkand"},{"id":"semetey-1-2013:p1114:b003:l002","ordinal":162140,"en":"Also came along the road;"},{"id":"semetey-1-2013:p1114:b003:l003","ordinal":162141,"en":"He came rolling onward"},{"id":"semetey-1-2013:p1114:b003:l004","ordinal":162142,"en":"With an army of some ten thousand."},{"id":"semetey-1-2013:p1114:b003:l005","ordinal":162143,"en":"Biting their whips firmly,"},{"id":"semetey-1-2013:p1114:b003:l006","ordinal":162144,"en":"Urging on their lone horses,"},{"id":"semetey-1-2013:p1114:b003:l007","ordinal":162145,"en":"Kozubek of the Kokand khan,"},{"id":"semetey-1-2013:p1114:b003:l008","ordinal":162146,"en":"Malabek of Margalan,"},{"id":"semetey-1-2013:p1114:b003:l009","ordinal":162147,"en":"Alabek of the Six Cities,"},{"id":"semetey-1-2013:p1114:b003:l010","ordinal":162148,"en":"And Temirkhan, khan of Bukhara—"},{"id":"semetey-1-2013:p1114:b003:l011","ordinal":162149,"en":"From there came armies in abundance."},{"id":"semetey-1-2013:p1114:b003:l012","ordinal":162150,"en":"The armies of the four khans mingled,"},{"id":"semetey-1-2013:p1114:b003:l013","ordinal":162151,"en":"Coming together in great numbers."},{"id":"semetey-1-2013:p1114:b003:l014","ordinal":162152,"en":"An army of some twenty thousand came."},{"id":"semetey-1-2013:p1114:b003:l015","ordinal":162153,"en":"The four divided into four,"},{"id":"semetey-1-2013:p1114:b003:l016","ordinal":162154,"en":"Their princely bearing apparent."},{"id":"semetey-1-2013:p1114:b003:l017","ordinal":162155,"en":"Among those four"},{"id":"semetey-1-2013:p1114:b003:l018","ordinal":162156,"en":"Were khojas in motley robes"},{"id":"semetey-1-2013:p1114:b003:l019","ordinal":162157,"en":"And mullahs in white turbans."},{"id":"semetey-1-2013:p1114:b003:l020","ordinal":162158,"en":"They had great komuzes broad as an embrace"},{"id":"semetey-1-2013:p1114:b003:l021","ordinal":162159,"en":"And had their dutars played;"},{"id":"semetey-1-2013:p1114:b003:l022","ordinal":162160,"en":"They had some sixty young men"},{"id":"semetey-1-2013:p1114:b003:l023","ordinal":162161,"en":"Sing their akysh songs."},{"id":"semetey-1-2013:p1114:b003:l024","ordinal":162162,"en":"From beyond them,"},{"id":"semetey-1-2013:p1114:b003:l025","ordinal":162163,"en":"Turning toward the great din,"},{"id":"semetey-1-2013:p1114:b003:l026","ordinal":162164,"en":"Spears striking against spears,"},{"id":"semetey-1-2013:p1114:b003:l027","ordinal":162165,"en":"Those with spears growing excited,"},{"id":"semetey-1-2013:p1114:b003:l028","ordinal":162166,"en":"Those with battle-axes exulting,"},{"id":"semetey-1-2013:p1114:b003:l029","ordinal":162167,"en":"From the heights of Chambyl-Bel,"},{"id":"semetey-1-2013:p1114:b003:l030","ordinal":162168,"en":"From the banks of Belendi,"},{"id":"semetey-1-2013:p1114:b003:l031","ordinal":162169,"en":"Zhanaaly and Karachal came."},{"id":"semetey-1-2013:p1114:b003:l032","ordinal":162170,"en":"Calling it Khan Kökötöy's memorial feast,"},{"id":"semetey-1-2013:p1114:b003:l033","ordinal":162171,"en":"Calling it the brow of the great gathering,"},{"id":"semetey-1-2013:p1114:b003:l034","ordinal":162172,"en":"They came by the Kyzyl-Kyya road"},{"id":"semetey-1-2013:p1114:b003:l035","ordinal":162173,"en":"With an army numbering ten thousand."},{"id":"semetey-1-2013:p1114:b003:l036","ordinal":162174,"en":"From beyond them,"},{"id":"semetey-1-2013:p1114:b003:l037","ordinal":162175,"en":"Carrying an iron-rope net,"},{"id":"semetey-1-2013:p1114:b003:l038","ordinal":162176,"en":"Taking shelter like blue iron,"},{"id":"semetey-1-2013:p1114:b003:l039","ordinal":162177,"en":"Carrying a spear without a tassel,"},{"id":"semetey-1-2013:p1114:b004:l001","ordinal":162178,"en":"Riding the racehorse Kuu-Azyk,"},{"id":"semetey-1-2013:p1114:b004:l002","ordinal":162179,"en":"Its hair tail tied tight,"},{"id":"semetey-1-2013:p1114:b004:l003","ordinal":162180,"en":"Banner and spears rattling,"},{"id":"semetey-1-2013:p1114:b004:l004","ordinal":162181,"en":"Kökbörü came along the road"},{"id":"semetey-1-2013:p1114:b004:l005","ordinal":162182,"en":"With an army of some ten thousand."},{"id":"semetey-1-2013:p1114:b004:l006","ordinal":162183,"en":"From beyond them,"},{"id":"semetey-1-2013:p1114:b004:l007","ordinal":162184,"en":"The war drum deafening ears,"},{"id":"semetey-1-2013:p1114:b004:l008","ordinal":162185,"en":"Their polished spears made of sharp steel"},{"id":"semetey-1-2013:p1114:b004:l009","ordinal":162186,"en":"Thrust forward from every side,"},{"id":"semetey-1-2013:p1114:b004:l010","ordinal":162187,"en":"With an armful of weapons and gear,"},{"id":"semetey-1-2013:p1114:b004:l011","ordinal":162188,"en":"Riding a horse like Telkyzyl,"},{"id":"semetey-1-2013:p1114:b004:l012","ordinal":162189,"en":"Muzburchak, son of Buudayyk,"},{"id":"semetey-1-2013:p1114:b004:l013","ordinal":162190,"en":"From beyond the heights of Bukhara,"},{"id":"semetey-1-2013:p1114:b004:l014","ordinal":162191,"en":"From the ruined land of Chambyl,"},{"id":"semetey-1-2013:p1114:b004:l015","ordinal":162192,"en":"Saying he would go in ceremony"},{"id":"semetey-1-2013:p1114:b004:l016","ordinal":162193,"en":"To see Khan Kökötöy's great feast,"},{"id":"semetey-1-2013:p1114:b004:l017","ordinal":162194,"en":"Saying if the Black Chinese and Manchus fought,"},{"id":"semetey-1-2013:p1114:b004:l018","ordinal":162195,"en":"He would spill their blood,"},{"id":"semetey-1-2013:p1114:b004:l019","ordinal":162196,"en":"He too came down then"},{"id":"semetey-1-2013:p1114:b004:l020","ordinal":162197,"en":"Along the banks of Karkyra,"},{"id":"semetey-1-2013:p1114:b004:l021","ordinal":162198,"en":"To Khan Kökötöy's feast."},{"id":"semetey-1-2013:p1114:b004:l022","ordinal":162199,"en":"Crossing passes and treading stones,"},{"id":"semetey-1-2013:p1114:b004:l023","ordinal":162200,"en":"Hurrying in great agitation,"},{"id":"semetey-1-2013:p1114:b004:l024","ordinal":162201,"en":"From the land of the Lop River,"},{"id":"semetey-1-2013:p1114:b004:l025","ordinal":162202,"en":"From the Oygut people opposite,"},{"id":"semetey-1-2013:p1114:b004:l026","ordinal":162203,"en":"Carrying a gray-mottled banner,"},{"id":"semetey-1-2013:p1114:b004:l027","ordinal":162204,"en":"Raising a clamorous cry,"},{"id":"semetey-1-2013:p1114:b004:l028","ordinal":162205,"en":"Choosing a horse from among the thoroughbreds,"},{"id":"semetey-1-2013:p1114:b004:l029","ordinal":162206,"en":"Bearing a letter from young Aydar,"},{"id":"semetey-1-2013:p1114:b004:l030","ordinal":162207,"en":"Along the banks of Karkyra,"},{"id":"semetey-1-2013:p1114:b004:l031","ordinal":162208,"en":"To Khan Kökötöy's feast,"},{"id":"semetey-1-2013:p1114:b004:l032","ordinal":162209,"en":"Karacha came along the road"},{"id":"semetey-1-2013:p1114:b004:l033","ordinal":162210,"en":"With an army of some nine thousand."},{"id":"semetey-1-2013:p1114:b004:l034","ordinal":162211,"en":"If you look toward the qibla side,"},{"id":"semetey-1-2013:p1114:b004:l035","ordinal":162212,"en":"Brave Ürbü of Eybit Khan,"},{"id":"semetey-1-2013:p1114:b004:l036","ordinal":162213,"en":"Who knew many kinds of languages,"},{"id":"semetey-1-2013:p1114:b004:l037","ordinal":162214,"en":"With gathered good fortune,"},{"id":"semetey-1-2013:p1114:b004:l038","ordinal":162215,"en":"With a people assembled from many tribes,"},{"id":"semetey-1-2013:p1114:b004:l039","ordinal":162216,"en":"Along a road branching to the side—"},{"id":"semetey-1-2013:p1115:b003:l001","ordinal":162217,"en":"With an army of some six thousand,"},{"id":"semetey-1-2013:p1115:b003:l002","ordinal":162218,"en":"To Khan Kökötöy's memorial feast,"},{"id":"semetey-1-2013:p1115:b003:l003","ordinal":162219,"en":"To the edge of the great gathering,"},{"id":"semetey-1-2013:p1115:b003:l004","ordinal":162220,"en":"Ürbü came down along the road"},{"id":"semetey-1-2013:p1115:b003:l005","ordinal":162221,"en":"With an army of some six thousand."},{"id":"semetey-1-2013:p1115:b003:l006","ordinal":162222,"en":"From this side of them,"},{"id":"semetey-1-2013:p1115:b003:l007","ordinal":162223,"en":"Dwelling in Sary-Arka,"},{"id":"semetey-1-2013:p1115:b003:l008","ordinal":162224,"en":"Men called formidable and grave,"},{"id":"semetey-1-2013:p1115:b003:l009","ordinal":162225,"en":"Their horses splendid dun racers,"},{"id":"semetey-1-2013:p1115:b003:l010","ordinal":162226,"en":"With white blazes on their brows like amulets,"},{"id":"semetey-1-2013:p1115:b003:l011","ordinal":162227,"en":"All of them peerless thoroughbreds."},{"id":"semetey-1-2013:p1115:b003:l012","ordinal":162228,"en":"Their racehorses pranced and snorted;"},{"id":"semetey-1-2013:p1115:b003:l013","ordinal":162229,"en":"Their men were of another order,"},{"id":"semetey-1-2013:p1115:b003:l014","ordinal":162230,"en":"Their mottled breasts heaving."},{"id":"semetey-1-2013:p1115:b003:l015","ordinal":162231,"en":"Dust billowed overhead;"},{"id":"semetey-1-2013:p1115:b003:l016","ordinal":162232,"en":"The many Kazakhs of Aydarkhan"},{"id":"semetey-1-2013:p1115:b003:l017","ordinal":162233,"en":"Came shouting and singing ölöng songs."},{"id":"semetey-1-2013:p1115:b003:l018","ordinal":162234,"en":"Wearing a coat of blue iron,"},{"id":"semetey-1-2013:p1115:b003:l019","ordinal":162235,"en":"Kökchö, khan of the Kazakhs,"},{"id":"semetey-1-2013:p1115:b003:l020","ordinal":162236,"en":"Rode a blue-mottled racehorse,"},{"id":"semetey-1-2013:p1115:b003:l021","ordinal":162237,"en":"Waving a blue-mottled banner."},{"id":"semetey-1-2013:p1115:b003:l022","ordinal":162238,"en":"Kökchö came along the road"},{"id":"semetey-1-2013:p1115:b003:l023","ordinal":162239,"en":"With an army numbering forty thousand."},{"id":"semetey-1-2013:p1115:b003:l024","ordinal":162240,"en":"After the Muslim army arrived,"},{"id":"semetey-1-2013:p1115:b003:l025","ordinal":162241,"en":"Dust curled into the sky."},{"id":"semetey-1-2013:p1115:b003:l026","ordinal":162242,"en":"The Muslim army assembled,"},{"id":"semetey-1-2013:p1115:b003:l027","ordinal":162243,"en":"And set aside the old and aged livestock"},{"id":"semetey-1-2013:p1115:b003:l028","ordinal":162244,"en":"For the Kalmyks."},{"id":"semetey-1-2013:p1115:b003:l029","ordinal":162245,"en":"Hearth pits were hollowed out;"},{"id":"semetey-1-2013:p1115:b003:l030","ordinal":162246,"en":"Milk-fed camel calves and barren yearlings"},{"id":"semetey-1-2013:p1115:b003:l031","ordinal":162247,"en":"Were slaughtered for those who came."},{"id":"semetey-1-2013:p1115:b003:l032","ordinal":162248,"en":"The arrivals hastened about,"},{"id":"semetey-1-2013:p1115:b003:l033","ordinal":162249,"en":"And saying, “May a son be like this,”"},{"id":"semetey-1-2013:p1115:b003:l034","ordinal":162250,"en":"They bowed gratefully"},{"id":"semetey-1-2013:p1115:b003:l035","ordinal":162251,"en":"Before Kökötöy's son Bokmurun."},{"id":"semetey-1-2013:p1115:b003:l036","ordinal":162252,"en":"Alas, Kozho, my soul's friend,"},{"id":"semetey-1-2013:p1115:b003:l037","ordinal":162253,"en":"Those were the eyes that saw it;"},{"id":"semetey-1-2013:p1115:b003:l038","ordinal":162254,"en":"Those were the words that were spoken."},{"id":"semetey-1-2013:p1115:b003:l039","ordinal":162255,"en":"That was where infidel and Muslim"},{"id":"semetey-1-2013:p1115:b005:l001","ordinal":162256,"en":"Crossed paths."},{"id":"semetey-1-2013:p1115:b005:l002","ordinal":162257,"en":"May God never show us such a sight!"},{"id":"semetey-1-2013:p1115:b005:l003","ordinal":162258,"en":"Before one could say this or that,"},{"id":"semetey-1-2013:p1115:b005:l004","ordinal":162259,"en":"In the blink of an eye,"},{"id":"semetey-1-2013:p1115:b005:l005","ordinal":162260,"en":"The people burst into alarm."},{"id":"semetey-1-2013:p1115:b005:l006","ordinal":162261,"en":"They seized their spears;"},{"id":"semetey-1-2013:p1115:b005:l007","ordinal":162262,"en":"All the Muslims"},{"id":"semetey-1-2013:p1115:b005:l008","ordinal":162263,"en":"Turned their minds to battle."},{"id":"semetey-1-2013:p1115:b005:l009","ordinal":162264,"en":"They ran to their horses,"},{"id":"semetey-1-2013:p1115:b005:l010","ordinal":162265,"en":"Despairing of their entrusted lives."},{"id":"semetey-1-2013:p1115:b005:l011","ordinal":162266,"en":"The reason they despaired was this:"},{"id":"semetey-1-2013:p1115:b005:l012","ordinal":162267,"en":"There was Khan Koshoy, leader of the elders,"},{"id":"semetey-1-2013:p1115:b005:l013","ordinal":162268,"en":"And dear Töshtük was there as well;"},{"id":"semetey-1-2013:p1115:b005:l014","ordinal":162269,"en":"Among the assembled Muslims"},{"id":"semetey-1-2013:p1115:b005:l015","ordinal":162270,"en":"There were lions besides Manas."},{"id":"semetey-1-2013:p1115:b005:l016","ordinal":162271,"en":"The Black Kalmyks and Manchus"},{"id":"semetey-1-2013:p1115:b005:l017","ordinal":162272,"en":"Had reached the appointed place;"},{"id":"semetey-1-2013:p1115:b005:l018","ordinal":162273,"en":"Kalmyks countless as hairs on a cow"},{"id":"semetey-1-2013:p1115:b005:l019","ordinal":162274,"en":"Had covered the land."},{"id":"semetey-1-2013:p1115:b005:l020","ordinal":162275,"en":"Seven standard-banners came;"},{"id":"semetey-1-2013:p1115:b005:l021","ordinal":162276,"en":"A din that split the earth came."},{"id":"semetey-1-2013:p1115:b005:l022","ordinal":162277,"en":"One flank of the Kalmyks"},{"id":"semetey-1-2013:p1115:b005:l023","ordinal":162278,"en":"Skirted Ketmen-Bel,"},{"id":"semetey-1-2013:p1115:b005:l024","ordinal":162279,"en":"While the upper part of that army"},{"id":"semetey-1-2013:p1115:b005:l025","ordinal":162280,"en":"Pressed against Aygyr-Zhal."},{"id":"semetey-1-2013:p1115:b005:l026","ordinal":162281,"en":"When they asked whose army it was,"},{"id":"semetey-1-2013:p1115:b005:l027","ordinal":162282,"en":"It was Great Zholoy's army."},{"id":"semetey-1-2013:p1115:b005:l028","ordinal":162283,"en":"Because the Kalmyks were so numerous,"},{"id":"semetey-1-2013:p1115:b005:l029","ordinal":162284,"en":"They began to cause havoc;"},{"id":"semetey-1-2013:p1115:b005:l030","ordinal":162285,"en":"The army that came from the Muslims"},{"id":"semetey-1-2013:p1115:b005:l031","ordinal":162286,"en":"Was ready to flee."},{"id":"semetey-1-2013:p1115:b005:l032","ordinal":162287,"en":"They halted in agitation,"},{"id":"semetey-1-2013:p1115:b005:l033","ordinal":162288,"en":"Cursing one another."},{"id":"semetey-1-2013:p1115:b005:l034","ordinal":162289,"en":"Saying brave Bokmurun had gathered"},{"id":"semetey-1-2013:p1115:b005:l035","ordinal":162290,"en":"A strange people no nation had seen,"},{"id":"semetey-1-2013:p1115:b005:l036","ordinal":162291,"en":"“Let them plunder if they wish;"},{"id":"semetey-1-2013:p1115:b005:l037","ordinal":162292,"en":"They are guests who have come to us,”"},{"id":"semetey-1-2013:p1115:b005:l038","ordinal":162293,"en":"They exchanged formal courtesies"},{"id":"semetey-1-2013:p1115:b005:l039","ordinal":162294,"en":"And endured the trouble,"},{"id":"semetey-1-2013:p1116:b003:l001","ordinal":162295,"en":"Saying, “They may overrun us.”"},{"id":"semetey-1-2013:p1116:b003:l002","ordinal":162296,"en":"It was an army that had come to the feast."},{"id":"semetey-1-2013:p1116:b003:l003","ordinal":162297,"en":"“If they happen to take offense,"},{"id":"semetey-1-2013:p1116:b003:l004","ordinal":162298,"en":"They will destroy and devour us;"},{"id":"semetey-1-2013:p1116:b003:l005","ordinal":162299,"en":"If they scowl and grow angry,"},{"id":"semetey-1-2013:p1116:b003:l006","ordinal":162300,"en":"Perhaps they will seize us and leave,"},{"id":"semetey-1-2013:p1116:b003:l007","ordinal":162301,"en":"Perhaps they will plunder their way"},{"id":"semetey-1-2013:p1116:b003:l008","ordinal":162302,"en":"To Beijing in Chynmachyn."},{"id":"semetey-1-2013:p1116:b003:l009","ordinal":162303,"en":"Perhaps these Kalmyks will do"},{"id":"semetey-1-2013:p1116:b003:l010","ordinal":162304,"en":"Whatever they please."}]
