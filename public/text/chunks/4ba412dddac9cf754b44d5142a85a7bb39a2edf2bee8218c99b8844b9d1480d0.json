[{"id":"semetey-1-2013:p0754:b004:l025","ordinal":134145,"en":"'When Manas died, let not all die with him;"},{"id":"semetey-1-2013:p0754:b004:l026","ordinal":134146,"en":"Do not become like an extinguished fire."},{"id":"semetey-1-2013:p0754:b004:l027","ordinal":134147,"en":"Let one of the chiefs come,' it said,"},{"id":"semetey-1-2013:p0754:b004:l028","ordinal":134148,"en":"'Let him examine this wrong,' it said,"},{"id":"semetey-1-2013:p0754:b004:l029","ordinal":134149,"en":"'The person who acted wrongly,"},{"id":"semetey-1-2013:p0754:b004:l030","ordinal":134150,"en":"Let him rout and crush,' it said,"},{"id":"semetey-1-2013:p0754:b004:l031","ordinal":134151,"en":"'Let him quickly set us straight,' it said."},{"id":"semetey-1-2013:p0754:b004:l032","ordinal":134152,"en":"When their urgent message came,"},{"id":"semetey-1-2013:p0754:b004:l033","ordinal":134153,"en":"Turning Aktelki's head with a lash,"},{"id":"semetey-1-2013:p0754:b004:l034","ordinal":134154,"en":"I rode over to you."},{"id":"semetey-1-2013:p0754:b004:l035","ordinal":134155,"en":"'When the best one dies, let not all die with him;"},{"id":"semetey-1-2013:p0754:b004:l036","ordinal":134156,"en":"Let us not become an extinguished fire."},{"id":"semetey-1-2013:p0754:b004:l037","ordinal":134157,"en":"The peoples of three khans are at war;"},{"id":"semetey-1-2013:p0754:b004:l038","ordinal":134158,"en":"I have heard there is strife."},{"id":"semetey-1-2013:p0754:b004:l039","ordinal":134159,"en":"The support left by Manas,"},{"id":"semetey-1-2013:p0755:b003:l001","ordinal":134160,"en":"My elder Bakai, let us go."},{"id":"semetey-1-2013:p0755:b003:l002","ordinal":134161,"en":"Let us not let Manas's absence be felt."},{"id":"semetey-1-2013:p0755:b003:l003","ordinal":134162,"en":"Come, elder, let us go."},{"id":"semetey-1-2013:p0755:b003:l004","ordinal":134163,"en":"Without sparing the wrongdoers,"},{"id":"semetey-1-2013:p0755:b003:l005","ordinal":134164,"en":"Let us rout and scatter them.'"},{"id":"semetey-1-2013:p0755:b003:l006","ordinal":134165,"en":"That is what I said."},{"id":"semetey-1-2013:p0755:b003:l007","ordinal":134166,"en":"When I spoke, Bakai, you wept,"},{"id":"semetey-1-2013:p0755:b003:l008","ordinal":134167,"en":"Tormenting your precious soul:"},{"id":"semetey-1-2013:p0755:b003:l009","ordinal":134168,"en":"'Hey, Abyke, my dear foal!"},{"id":"semetey-1-2013:p0755:b003:l010","ordinal":134169,"en":"After mountain-like Manas died,"},{"id":"semetey-1-2013:p0755:b003:l011","ordinal":134170,"en":"After Bakai suffered hell,"},{"id":"semetey-1-2013:p0755:b003:l012","ordinal":134171,"en":"Collapse, you and your assembly!"},{"id":"semetey-1-2013:p0755:b003:l013","ordinal":134172,"en":"How can I go to the assembly?"},{"id":"semetey-1-2013:p0755:b003:l014","ordinal":134173,"en":"When mountain-like Manas has died,"},{"id":"semetey-1-2013:p0755:b003:l015","ordinal":134174,"en":"If they say, \"Wretched Bakai, strutting,"},{"id":"semetey-1-2013:p0755:b003:l016","ordinal":134175,"en":"Has ridden to an assembly,\""},{"id":"semetey-1-2013:p0755:b003:l017","ordinal":134176,"en":"I shall die then.'"},{"id":"semetey-1-2013:p0755:b003:l018","ordinal":134177,"en":"You stubbornly refused, elder."},{"id":"semetey-1-2013:p0755:b003:l019","ordinal":134178,"en":"'I shall tend the orphan's camels,' you said,"},{"id":"semetey-1-2013:p0755:b003:l020","ordinal":134179,"en":"And put an end to the talk."},{"id":"semetey-1-2013:p0755:b003:l021","ordinal":134180,"en":"In your place, elder,"},{"id":"semetey-1-2013:p0755:b003:l022","ordinal":134181,"en":"I took Azhybai."},{"id":"semetey-1-2013:p0755:b003:l023","ordinal":134182,"en":"Absent for three or four months,"},{"id":"semetey-1-2013:p0755:b003:l024","ordinal":134183,"en":"To the peoples of the three khans below"},{"id":"semetey-1-2013:p0755:b003:l025","ordinal":134184,"en":"I went as an arbitrator."},{"id":"semetey-1-2013:p0755:b003:l026","ordinal":134185,"en":"By the time I returned from arbitrating,"},{"id":"semetey-1-2013:p0755:b003:l027","ordinal":134186,"en":"Bakai, my refuge, was gone."},{"id":"semetey-1-2013:p0755:b003:l028","ordinal":134187,"en":"The orphan left by Manas was gone;"},{"id":"semetey-1-2013:p0755:b003:l029","ordinal":134188,"en":"My mother Chyiyrdy was gone as well."},{"id":"semetey-1-2013:p0755:b003:l030","ordinal":134189,"en":"Over Zhorgonun-Bel,"},{"id":"semetey-1-2013:p0755:b003:l031","ordinal":134190,"en":"My sorrowful sister-in-law"},{"id":"semetey-1-2013:p0755:b003:l032","ordinal":134191,"en":"You sent fleeing from broad Talas."},{"id":"semetey-1-2013:p0755:b003:l033","ordinal":134192,"en":"Over Kuyuktun-Bel,"},{"id":"semetey-1-2013:p0755:b003:l034","ordinal":134193,"en":"My grieving, fierce sister-in-law"},{"id":"semetey-1-2013:p0755:b003:l035","ordinal":134194,"en":"You sent fleeing from this Talas."},{"id":"semetey-1-2013:p0755:b003:l036","ordinal":134195,"en":"You were a man whose ears heard far;"},{"id":"semetey-1-2013:p0755:b003:l037","ordinal":134196,"en":"You were an old man like a saint."},{"id":"semetey-1-2013:p0755:b003:l038","ordinal":134197,"en":"Have you heard news from Bukhara?"},{"id":"semetey-1-2013:p0755:b003:l039","ordinal":134198,"en":"You were a man like a saint."},{"id":"semetey-1-2013:p0755:b005:l001","ordinal":134199,"en":"Have you been toward Bukhara?"},{"id":"semetey-1-2013:p0755:b005:l002","ordinal":134200,"en":"Have you had news of my sister-in-law?"},{"id":"semetey-1-2013:p0755:b005:l003","ordinal":134201,"en":"Have you set out traveling?"},{"id":"semetey-1-2013:p0755:b005:l004","ordinal":134202,"en":"Have you heard news of the orphan?"},{"id":"semetey-1-2013:p0755:b005:l005","ordinal":134203,"en":"Accomplished elder, Khan Bakai,"},{"id":"semetey-1-2013:p0755:b005:l006","ordinal":134204,"en":"If you have heard news of the orphan,"},{"id":"semetey-1-2013:p0755:b005:l007","ordinal":134205,"en":"As a reward for good news,"},{"id":"semetey-1-2013:p0755:b005:l008","ordinal":134206,"en":"Take my steed Aktelki."},{"id":"semetey-1-2013:p0755:b005:l009","ordinal":134207,"en":"If this gift is too little,"},{"id":"semetey-1-2013:p0755:b005:l010","ordinal":134208,"en":"Take my blood, poured into a leather flask."},{"id":"semetey-1-2013:p0755:b005:l011","ordinal":134209,"en":"From that flowing river and spring,"},{"id":"semetey-1-2013:p0755:b005:l012","ordinal":134210,"en":"Somehow hear an answer for me,"},{"id":"semetey-1-2013:p0755:b005:l013","ordinal":134211,"en":"From the little one found when I was dying.\""},{"id":"semetey-1-2013:p0755:b005:l014","ordinal":134212,"en":"Then Bakai said:"},{"id":"semetey-1-2013:p0755:b005:l015","ordinal":134213,"en":"\"Oh, Abyke, my beloved foal,"},{"id":"semetey-1-2013:p0755:b005:l016","ordinal":134214,"en":"The orphan you seek will be found;"},{"id":"semetey-1-2013:p0755:b005:l017","ordinal":134215,"en":"The lost little one will be met."},{"id":"semetey-1-2013:p0755:b005:l018","ordinal":134216,"en":"If you have a reward for good news, give it now."},{"id":"semetey-1-2013:p0755:b005:l019","ordinal":134217,"en":"Here is your orphan; see him now!\""},{"id":"semetey-1-2013:p0755:b005:l020","ordinal":134218,"en":"When Khan Bakai spoke thus,"},{"id":"semetey-1-2013:p0755:b005:l021","ordinal":134219,"en":"The hairs of his beard separating one by one,"},{"id":"semetey-1-2013:p0755:b005:l022","ordinal":134220,"en":"Abyke trembled and wept,"},{"id":"semetey-1-2013:p0755:b005:l023","ordinal":134221,"en":"His nose running."},{"id":"semetey-1-2013:p0755:b005:l024","ordinal":134222,"en":"'The orphan left by the noble steed!' he said."},{"id":"semetey-1-2013:p0755:b005:l025","ordinal":134223,"en":"Abyke's limbs grew weak;"},{"id":"semetey-1-2013:p0755:b005:l026","ordinal":134224,"en":"Tears poured from his eyes."},{"id":"semetey-1-2013:p0755:b005:l027","ordinal":134225,"en":"He sobbed loudly, beating himself,"},{"id":"semetey-1-2013:p0755:b005:l028","ordinal":134226,"en":"Crying out and pleading with Semetey."},{"id":"semetey-1-2013:p0755:b005:l030","ordinal":134227,"en":"His heart burned with grief.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0755:b005:l031","ordinal":134228,"en":"His dark eyes, like a saker falcon's,"},{"id":"semetey-1-2013:p0755:b005:l032","ordinal":134229,"en":"Filled with tears without blinking."},{"id":"semetey-1-2013:p0755:b005:l033","ordinal":134230,"en":"\"You went far away, leaving me grieving,"},{"id":"semetey-1-2013:p0755:b005:l034","ordinal":134231,"en":"My dark-marked falcon,"},{"id":"semetey-1-2013:p0755:b005:l035","ordinal":134232,"en":"You have returned to Talas,"},{"id":"semetey-1-2013:p0755:b005:l036","ordinal":134233,"en":"My darling little one!"},{"id":"semetey-1-2013:p0755:b005:l037","ordinal":134234,"en":"My young goshawk left by the falcon,"},{"id":"semetey-1-2013:p0755:b005:l038","ordinal":134235,"en":"My dear unbred noble steed,"},{"id":"semetey-1-2013:p0755:b005:l039","ordinal":134236,"en":"My hoof left by the winged steed,"},{"id":"semetey-1-2013:p0756:b003:l001","ordinal":134237,"en":"My lamp left by Manas, that unbred noble steed,"},{"id":"semetey-1-2013:p0756:b003:l003","ordinal":134238,"en":"My banner fastened to a spear,"},{"id":"semetey-1-2013:p0756:b003:l004","ordinal":134239,"en":"My gift left by the magnanimous one, gone far away,"},{"id":"semetey-1-2013:p0756:b003:l006","ordinal":134240,"en":"Semetey alone, my support!"},{"id":"semetey-1-2013:p0756:b003:l007","ordinal":134241,"en":"Seeing the presence of that only son,"},{"id":"semetey-1-2013:p0756:b003:l008","ordinal":134242,"en":"I burn in flames."},{"id":"semetey-1-2013:p0756:b003:l009","ordinal":134243,"en":"The reason I burn in flames:"},{"id":"semetey-1-2013:p0756:b003:l010","ordinal":134244,"en":"My support left by the only one,"},{"id":"semetey-1-2013:p0756:b003:l011","ordinal":134245,"en":"My morning star beside the moon,"},{"id":"semetey-1-2013:p0756:b003:l012","ordinal":134246,"en":"My cherished sultan left by Manas,"},{"id":"semetey-1-2013:p0756:b003:l014","ordinal":134247,"en":"My sharp-eyed one left by the mighty,"},{"id":"semetey-1-2013:p0756:b003:l015","ordinal":134248,"en":"By precious Manas, that only one,"},{"id":"semetey-1-2013:p0756:b003:l016","ordinal":134249,"en":"My heir left behind,"},{"id":"semetey-1-2013:p0756:b003:l017","ordinal":134250,"en":"My presence bestowed by fate,"},{"id":"semetey-1-2013:p0756:b003:l018","ordinal":134251,"en":"My support left by the hero,"},{"id":"semetey-1-2013:p0756:b003:l019","ordinal":134252,"en":"My falcon flown from the nest,"},{"id":"semetey-1-2013:p0756:b003:l020","ordinal":134253,"en":"My winged steed born among horses."},{"id":"semetey-1-2013:p0756:b003:l021","ordinal":134254,"en":"I tended the treasury for a long time."},{"id":"semetey-1-2013:p0756:b003:l022","ordinal":134255,"en":"The orphan who was my support—"},{"id":"semetey-1-2013:p0756:b003:l023","ordinal":134256,"en":"I wondered whether he would come."},{"id":"semetey-1-2013:p0756:b003:l024","ordinal":134257,"en":"My darling orphan,"},{"id":"semetey-1-2013:p0756:b003:l025","ordinal":134258,"en":"Your countless livestock are with me,"},{"id":"semetey-1-2013:p0756:b003:l026","ordinal":134259,"en":"A trust I have tended."},{"id":"semetey-1-2013:p0756:b003:l027","ordinal":134260,"en":"To Khan Temir's city"},{"id":"semetey-1-2013:p0756:b003:l028","ordinal":134261,"en":"You went wandering, poor little one."},{"id":"semetey-1-2013:p0756:b003:l029","ordinal":134262,"en":"On the hills your horses fill six hosts:"},{"id":"semetey-1-2013:p0756:b003:l030","ordinal":134263,"en":"Moon-marked duns, with mottled heads,"},{"id":"semetey-1-2013:p0756:b003:l031","ordinal":134264,"en":"With thoroughbreds and noble steeds among them."},{"id":"semetey-1-2013:p0756:b003:l032","ordinal":134265,"en":"'My noble orphan will take them,' I thought."},{"id":"semetey-1-2013:p0756:b003:l033","ordinal":134266,"en":"'These horses from the father"},{"id":"semetey-1-2013:p0756:b003:l034","ordinal":134267,"en":"Will remain for the son,' I thought."},{"id":"semetey-1-2013:p0756:b003:l035","ordinal":134268,"en":"I tended them as a trust."},{"id":"semetey-1-2013:p0756:b003:l036","ordinal":134269,"en":"Leaving your uncle here gazing forlornly,"},{"id":"semetey-1-2013:p0756:b003:l037","ordinal":134270,"en":"To Karakan's city"},{"id":"semetey-1-2013:p0756:b003:l038","ordinal":134271,"en":"You went wandering, poor little one."},{"id":"semetey-1-2013:p0756:b003:l039","ordinal":134272,"en":"My soft, gray-mottled goshawk,"},{"id":"semetey-1-2013:p0756:b004:l001","ordinal":134273,"en":"Semetey standing here,"},{"id":"semetey-1-2013:p0756:b004:l002","ordinal":134274,"en":"My morning star to press to my breast,"},{"id":"semetey-1-2013:p0756:b004:l003","ordinal":134275,"en":"My deep-rooted plane tree untouched by wind,"},{"id":"semetey-1-2013:p0756:b004:l004","ordinal":134276,"en":"Who has grown up from orphanhood,"},{"id":"semetey-1-2013:p0756:b004:l005","ordinal":134277,"en":"My dark-marked falcon,"},{"id":"semetey-1-2013:p0756:b004:l006","ordinal":134278,"en":"My Pleiades overhead to guide me,"},{"id":"semetey-1-2013:p0756:b004:l007","ordinal":134279,"en":"If the Chinese enemy surrounds us on four sides,"},{"id":"semetey-1-2013:p0756:b004:l008","ordinal":134280,"en":"My unbreakable steel fortress!\""},{"id":"semetey-1-2013:p0756:b004:l009","ordinal":134281,"en":"Abyke spoke these words."},{"id":"semetey-1-2013:p0756:b004:l010","ordinal":134282,"en":"'The only one found when I was dying!' he said."},{"id":"semetey-1-2013:p0756:b004:l011","ordinal":134283,"en":"The boy Semetey alone"},{"id":"semetey-1-2013:p0756:b004:l012","ordinal":134284,"en":"He clasped about the neck,"},{"id":"semetey-1-2013:p0756:b004:l013","ordinal":134285,"en":"Sobbing loudly without stopping."},{"id":"semetey-1-2013:p0756:b004:l014","ordinal":134286,"en":"Beneath his chin,"},{"id":"semetey-1-2013:p0756:b004:l015","ordinal":134287,"en":"Above his throat,"},{"id":"semetey-1-2013:p0756:b004:l016","ordinal":134288,"en":"Your uncle Abyke"},{"id":"semetey-1-2013:p0756:b004:l017","ordinal":134289,"en":"Nuzzled him again and again, murmuring,"},{"id":"semetey-1-2013:p0756:b004:l018","ordinal":134290,"en":"Embracing him, weeping, deeply breathing his scent."},{"id":"semetey-1-2013:p0756:b004:l019","ordinal":134291,"en":"Abyke, a khan among the six, wept;"},{"id":"semetey-1-2013:p0756:b004:l020","ordinal":134292,"en":"White-bearded Bakai wept too."},{"id":"semetey-1-2013:p0756:b004:l021","ordinal":134293,"en":"Extinguished fires were rekindled."},{"id":"semetey-1-2013:p0756:b004:l022","ordinal":134294,"en":"That day Manas came back to life."},{"id":"semetey-1-2013:p0756:b004:l023","ordinal":134295,"en":"What else was it but coming back to life?"},{"id":"semetey-1-2013:p0756:b004:l024","ordinal":134296,"en":"The orphan they watched for had arrived;"},{"id":"semetey-1-2013:p0756:b004:l025","ordinal":134297,"en":"God had granted their wish."},{"id":"semetey-1-2013:p0756:b004:l026","ordinal":134298,"en":"The sorrowful ones reunited thus,"},{"id":"semetey-1-2013:p0756:b004:l027","ordinal":134299,"en":"And as they sobbed together,"},{"id":"semetey-1-2013:p0756:b004:l028","ordinal":134300,"en":"Ah, surrounded by a garden of plane trees,"},{"id":"semetey-1-2013:p0756:b004:l029","ordinal":134301,"en":"Stood Khan Manas's golden throne."},{"id":"semetey-1-2013:p0756:b004:l030","ordinal":134302,"en":"At the foot of the golden throne,"},{"id":"semetey-1-2013:p0756:b004:l031","ordinal":134303,"en":"Of so many designs,"},{"id":"semetey-1-2013:p0756:b004:l032","ordinal":134304,"en":"The orphan boy had never seen"},{"id":"semetey-1-2013:p0756:b004:l033","ordinal":134305,"en":"Anything so splendid."},{"id":"semetey-1-2013:p0756:b004:l034","ordinal":134306,"en":"At the foot of the golden throne,"},{"id":"semetey-1-2013:p0756:b004:l035","ordinal":134307,"en":"A great carpet patterned in gold—"},{"id":"semetey-1-2013:p0756:b004:l036","ordinal":134308,"en":"Even soaked in water for forty years,"},{"id":"semetey-1-2013:p0756:b004:l037","ordinal":134309,"en":"Not a hair would rot or fade."},{"id":"semetey-1-2013:p0756:b004:l038","ordinal":134310,"en":"Even soaked in water for eighty years,"},{"id":"semetey-1-2013:p0756:b004:l039","ordinal":134311,"en":"It would not fray, rot, or fade."},{"id":"semetey-1-2013:p0757:b003:l001","ordinal":134312,"en":"For so long that carpet"},{"id":"semetey-1-2013:p0757:b003:l002","ordinal":134313,"en":"Had not softened and rotted."},{"id":"semetey-1-2013:p0757:b003:l003","ordinal":134314,"en":"In those days, a man who would not heed words"},{"id":"semetey-1-2013:p0757:b003:l004","ordinal":134315,"en":"He frightened with his stare."},{"id":"semetey-1-2013:p0757:b003:l005","ordinal":134316,"en":"A man who did not understand his language"},{"id":"semetey-1-2013:p0757:b003:l006","ordinal":134317,"en":"He frightened with his fury."},{"id":"semetey-1-2013:p0757:b003:l007","ordinal":134318,"en":"The khoja in Kokand,"},{"id":"semetey-1-2013:p0757:b003:l008","ordinal":134319,"en":"When he was humiliating him,"},{"id":"semetey-1-2013:p0757:b003:l010","ordinal":134320,"en":"When he was beating him,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0757:b003:l011","ordinal":134321,"en":"The petitions officer in Bukhara,"},{"id":"semetey-1-2013:p0757:b003:l012","ordinal":134322,"en":"When he was imprisoning him,"},{"id":"semetey-1-2013:p0757:b003:l013","ordinal":134323,"en":"When he was bringing turmoil to Andijan,"},{"id":"semetey-1-2013:p0757:b003:l015","ordinal":134324,"en":"From the Six Cities, tribute"},{"id":"semetey-1-2013:p0757:b003:l016","ordinal":134325,"en":"He was taking then."},{"id":"semetey-1-2013:p0757:b003:l017","ordinal":134326,"en":"Drinking millet beer without stopping,"},{"id":"semetey-1-2013:p0757:b003:l018","ordinal":134327,"en":"He beat the khoja until he wailed."},{"id":"semetey-1-2013:p0757:b003:l019","ordinal":134328,"en":"Taking and drinking liquor,"},{"id":"semetey-1-2013:p0757:b003:l020","ordinal":134329,"en":"And taking, then,"},{"id":"semetey-1-2013:p0757:b003:l021","ordinal":134330,"en":"A prostitute as beautiful as glass,"},{"id":"semetey-1-2013:p0757:b003:l022","ordinal":134331,"en":"To gray-maned tiger Manas"},{"id":"semetey-1-2013:p0757:b003:l023","ordinal":134332,"en":"No one dared approach."},{"id":"semetey-1-2013:p0757:b003:l024","ordinal":134333,"en":"Those who saw his deeds were amazed."},{"id":"semetey-1-2013:p0757:b003:l025","ordinal":134334,"en":"Khan Manas's golden throne,"},{"id":"semetey-1-2013:p0757:b003:l026","ordinal":134335,"en":"His fortune ordained by fate—"},{"id":"semetey-1-2013:p0757:b003:l027","ordinal":134336,"en":"When hero Manas died,"},{"id":"semetey-1-2013:p0757:b003:l028","ordinal":134337,"en":"Hero Kobosh took possession."},{"id":"semetey-1-2013:p0757:b003:l029","ordinal":134338,"en":"Becoming a giant greater than all,"},{"id":"semetey-1-2013:p0757:b003:l030","ordinal":134339,"en":"He mounted the golden throne."},{"id":"semetey-1-2013:p0757:b003:l031","ordinal":134340,"en":"Khan Kobosh, without a care,"},{"id":"semetey-1-2013:p0757:b003:l032","ordinal":134341,"en":"Had become a sultan."},{"id":"semetey-1-2013:p0757:b003:l033","ordinal":134342,"en":"Abyke and Bakai—while these three"},{"id":"semetey-1-2013:p0757:b003:l034","ordinal":134343,"en":"Cried out to one another,"},{"id":"semetey-1-2013:p0757:b003:l035","ordinal":134344,"en":"Then gray-maned hero Kobosh"},{"id":"semetey-1-2013:p0757:b003:l036","ordinal":134345,"en":"Was utterly unconcerned,"},{"id":"semetey-1-2013:p0757:b003:l037","ordinal":134346,"en":"Those who were weeping,"},{"id":"semetey-1-2013:p0757:b003:l038","ordinal":134347,"en":"He did not value even as a scrap of hide."},{"id":"semetey-1-2013:p0757:b003:l039","ordinal":134348,"en":"Dear Kobosh sprawled in bulk,"},{"id":"semetey-1-2013:p0757:b004:l001","ordinal":134349,"en":"His nose jutting like a leather wineskin."},{"id":"semetey-1-2013:p0757:b004:l002","ordinal":134350,"en":"He was immersed in pleasure."},{"id":"semetey-1-2013:p0757:b004:l003","ordinal":134351,"en":"Manas's wife Akylai—"},{"id":"semetey-1-2013:p0757:b004:l004","ordinal":134352,"en":"Embracing Akylai,"},{"id":"semetey-1-2013:p0757:b004:l005","ordinal":134353,"en":"He lay there day and night."},{"id":"semetey-1-2013:p0757:b004:l006","ordinal":134354,"en":"Your uncle Kobosh, rumbling,"},{"id":"semetey-1-2013:p0757:b004:l007","ordinal":134355,"en":"Was immersed in great pleasure."},{"id":"semetey-1-2013:p0757:b004:l008","ordinal":134356,"en":"He would not rise, thundering away."},{"id":"semetey-1-2013:p0757:b004:l009","ordinal":134357,"en":"Kobosh would not wake; he rumbled."},{"id":"semetey-1-2013:p0757:b004:l010","ordinal":134358,"en":"God had taken bloodthirsty Manas."},{"id":"semetey-1-2013:p0757:b004:l011","ordinal":134359,"en":"The golden throne left by the Bloodthirsty One"},{"id":"semetey-1-2013:p0757:b004:l012","ordinal":134360,"en":"Kobosh had taken possession of."},{"id":"semetey-1-2013:p0757:b004:l013","ordinal":134361,"en":"Upon the golden throne"},{"id":"semetey-1-2013:p0757:b004:l014","ordinal":134362,"en":"Kobosh had taken Akylai."},{"id":"semetey-1-2013:p0757:b004:l015","ordinal":134363,"en":"Eating yearlings of barren mares,"},{"id":"semetey-1-2013:p0757:b004:l016","ordinal":134364,"en":"Eating frozen goat fat,"},{"id":"semetey-1-2013:p0757:b004:l017","ordinal":134365,"en":"Your foolish, heroic uncle Kobosh"},{"id":"semetey-1-2013:p0757:b004:l018","ordinal":134366,"en":"Lay there, swollen with arrogance."},{"id":"semetey-1-2013:p0757:b004:l019","ordinal":134367,"en":"If something occurred to him,"},{"id":"semetey-1-2013:p0757:b004:l020","ordinal":134368,"en":"Hero Kobosh would commit an outrage."},{"id":"semetey-1-2013:p0757:b004:l021","ordinal":134369,"en":"To impoverished widows and orphans,"},{"id":"semetey-1-2013:p0757:b004:l022","ordinal":134370,"en":"Hero Kobosh issued orders."},{"id":"semetey-1-2013:p0757:b004:l023","ordinal":134371,"en":"Anyone who crossed him"},{"id":"semetey-1-2013:p0757:b004:l024","ordinal":134372,"en":"He had shut in a pit."},{"id":"semetey-1-2013:p0757:b004:l025","ordinal":134373,"en":"Anyone who angered him"},{"id":"semetey-1-2013:p0757:b004:l026","ordinal":134374,"en":"He had beheaded with a sword."},{"id":"semetey-1-2013:p0757:b004:l027","ordinal":134375,"en":"Old and aged people,"},{"id":"semetey-1-2013:p0757:b004:l028","ordinal":134376,"en":"Elders grown decrepit,"},{"id":"semetey-1-2013:p0757:b004:l029","ordinal":134377,"en":"When a whim seized him,"},{"id":"semetey-1-2013:p0757:b004:l030","ordinal":134378,"en":"He made them work rawhide."},{"id":"semetey-1-2013:p0757:b004:l031","ordinal":134379,"en":"When a whim seized him,"},{"id":"semetey-1-2013:p0757:b004:l032","ordinal":134380,"en":"All those people"},{"id":"semetey-1-2013:p0757:b004:l033","ordinal":134381,"en":"He made dance for amusement."},{"id":"semetey-1-2013:p0757:b004:l034","ordinal":134382,"en":"All the countless people"},{"id":"semetey-1-2013:p0757:b004:l035","ordinal":134383,"en":"He wearied in just this way."},{"id":"semetey-1-2013:p0757:b004:l036","ordinal":134384,"en":"By force, hero Kobosh"},{"id":"semetey-1-2013:p0757:b004:l037","ordinal":134385,"en":"Made many lands submit."},{"id":"semetey-1-2013:p0757:b004:l038","ordinal":134386,"en":"He imposed heavy tribute on the people."},{"id":"semetey-1-2013:p0757:b004:l039","ordinal":134387,"en":"Unable to bear his tribute,"},{"id":"semetey-1-2013:p0758:b003:l001","ordinal":134388,"en":"The Argyn are left weeping."},{"id":"semetey-1-2013:p0758:b003:l002","ordinal":134389,"en":"Powerless against Kobosh,"},{"id":"semetey-1-2013:p0758:b003:l003","ordinal":134390,"en":"Many more go about loathing him."},{"id":"semetey-1-2013:p0758:b003:l004","ordinal":134391,"en":"‘Alas, Manas, do not die!’"},{"id":"semetey-1-2013:p0758:b003:l005","ordinal":134392,"en":"Many more keep yearning:"},{"id":"semetey-1-2013:p0758:b003:l006","ordinal":134393,"en":"‘While that Manas was alive,"},{"id":"semetey-1-2013:p0758:b003:l007","ordinal":134394,"en":"When bored, we would shoot roe deer;"},{"id":"semetey-1-2013:p0758:b003:l008","ordinal":134395,"en":"When not bored, we would lie at ease."},{"id":"semetey-1-2013:p0758:b003:l009","ordinal":134396,"en":"Riding horses in their third year, flying hawks,"},{"id":"semetey-1-2013:p0758:b003:l010","ordinal":134397,"en":"We played in wild delight."},{"id":"semetey-1-2013:p0758:b003:l011","ordinal":134398,"en":"How could we have known such hell?"},{"id":"semetey-1-2013:p0758:b003:l012","ordinal":134399,"en":"What could dear Kobosh do?"},{"id":"semetey-1-2013:p0758:b003:l013","ordinal":134400,"en":"He made calves carry loads,"}]
