[{"id":"semetey-1-2013:p1306:b003:l034","ordinal":176897,"en":"He seized him by the shins."},{"id":"semetey-1-2013:p1306:b003:l035","ordinal":176898,"en":"A black rock large as a house—"},{"id":"semetey-1-2013:p1306:b003:l036","ordinal":176899,"en":"The ill-fated khoja,"},{"id":"semetey-1-2013:p1306:b003:l037","ordinal":176900,"en":"He brought and hurled upon it."},{"id":"semetey-1-2013:p1306:b003:l038","ordinal":176901,"en":"When he thus settled the account,"},{"id":"semetey-1-2013:p1306:b003:l039","ordinal":176902,"en":"When he smashed him against the black rock,"},{"id":"semetey-1-2013:p1306:b004:l001","ordinal":176903,"en":"His valor now appeared;"},{"id":"semetey-1-2013:p1306:b004:l002","ordinal":176904,"en":"Chynkojo split in two."},{"id":"semetey-1-2013:p1306:b004:l003","ordinal":176905,"en":"He slaughtered Chynkojo;"},{"id":"semetey-1-2013:p1306:b004:l004","ordinal":176906,"en":"Black blood flowing from his breast,"},{"id":"semetey-1-2013:p1306:b004:l005","ordinal":176907,"en":"He scooped it by the double handful and drank his fill."},{"id":"semetey-1-2013:p1306:b004:l006","ordinal":176908,"en":"Hardened from drinking blood,"},{"id":"semetey-1-2013:p1306:b004:l007","ordinal":176909,"en":"By this deed your gray wolf"},{"id":"semetey-1-2013:p1306:b004:l008","ordinal":176910,"en":"Became known as the black gray wolf."},{"id":"semetey-1-2013:p1306:b004:l009","ordinal":176911,"en":"Semetey, born after"},{"id":"semetey-1-2013:p1306:b004:l010","ordinal":176912,"en":"His father, gray wolf Manas,"},{"id":"semetey-1-2013:p1306:b004:l011","ordinal":176913,"en":"Shaking out his cartridge pouch and making bullets,"},{"id":"semetey-1-2013:p1306:b004:l012","ordinal":176914,"en":"Destroyed the impetuous khoja"},{"id":"semetey-1-2013:p1306:b004:l013","ordinal":176915,"en":"From this world."},{"id":"semetey-1-2013:p1306:b004:l014","ordinal":176916,"en":"The havoc he had seen in Afghanistan,"},{"id":"semetey-1-2013:p1306:b004:l015","ordinal":176917,"en":"The wonder with which he then"},{"id":"semetey-1-2013:p1306:b004:l016","ordinal":176918,"en":"Had sent the Jediger to Afghanistan—"},{"id":"semetey-1-2013:p1306:b004:l017","ordinal":176919,"en":"Heading toward that place,"},{"id":"semetey-1-2013:p1306:b004:l018","ordinal":176920,"en":"He took Külchoro with him"},{"id":"semetey-1-2013:p1306:b004:l019","ordinal":176921,"en":"And rode far without sparing the horses."},{"id":"semetey-1-2013:p1306:b004:l020","ordinal":176922,"en":"Kanchoro, son of Chubak,"},{"id":"semetey-1-2013:p1306:b004:l021","ordinal":176923,"en":"Had unleashed turmoil;"},{"id":"semetey-1-2013:p1306:b004:l022","ordinal":176924,"en":"Standing opposed face-to-face,"},{"id":"semetey-1-2013:p1306:b004:l023","ordinal":176925,"en":"Firing guns and bows,"},{"id":"semetey-1-2013:p1306:b004:l024","ordinal":176926,"en":"Fighting without fleeing,"},{"id":"semetey-1-2013:p1306:b004:l025","ordinal":176927,"en":"Jediger's Tölök—"},{"id":"semetey-1-2013:p1306:b004:l026","ordinal":176928,"en":"He had reached and captured him."},{"id":"semetey-1-2013:p1306:b004:l027","ordinal":176929,"en":"Kanchoro proved a hero;"},{"id":"semetey-1-2013:p1306:b004:l028","ordinal":176930,"en":"He settled his account exactly."},{"id":"semetey-1-2013:p1306:b004:l029","ordinal":176931,"en":"Having bound Tölök,"},{"id":"semetey-1-2013:p1306:b004:l030","ordinal":176932,"en":"He hacked open his hamstring."},{"id":"semetey-1-2013:p1306:b004:l031","ordinal":176933,"en":"When the prince drew near,"},{"id":"semetey-1-2013:p1306:b004:l032","ordinal":176934,"en":"He unleashed utter turmoil."},{"id":"semetey-1-2013:p1306:b004:l033","ordinal":176935,"en":"Dear valiant Tölök"},{"id":"semetey-1-2013:p1306:b004:l034","ordinal":176936,"en":"He slaughtered as a sacrifice."},{"id":"semetey-1-2013:p1306:b004:l035","ordinal":176937,"en":"When they rode onward from there,"},{"id":"semetey-1-2013:p1306:b004:l036","ordinal":176938,"en":"A gray-mottled standard and red banner,"},{"id":"semetey-1-2013:p1306:b004:l037","ordinal":176939,"en":"Tumultuous cries rang rank by rank."},{"id":"semetey-1-2013:p1306:b004:l038","ordinal":176940,"en":"A white sacred standard and red banner,"},{"id":"semetey-1-2013:p1306:b004:l039","ordinal":176941,"en":"Hungry shouts and uproar."},{"id":"semetey-1-2013:p1307:b003:l001","ordinal":176942,"en":"The sky was clear, the earth shrouded,"},{"id":"semetey-1-2013:p1307:b003:l002","ordinal":176943,"en":"Not a blade could be seen on the ground."},{"id":"semetey-1-2013:p1307:b003:l003","ordinal":176944,"en":"Dust flew and haze burned,"},{"id":"semetey-1-2013:p1307:b003:l004","ordinal":176945,"en":"Not a single person could be seen."},{"id":"semetey-1-2013:p1307:b003:l005","ordinal":176946,"en":"The sound of the matchlocks rang from afar,"},{"id":"semetey-1-2013:p1307:b003:l006","ordinal":176947,"en":"All the Afghans"},{"id":"semetey-1-2013:p1307:b003:l007","ordinal":176948,"en":"Fled and shut themselves in the city."},{"id":"semetey-1-2013:p1307:b003:l008","ordinal":176949,"en":"Tülkü's son Tümönbay,"},{"id":"semetey-1-2013:p1307:b003:l009","ordinal":176950,"en":"After ranging for seven days,"},{"id":"semetey-1-2013:p1307:b003:l010","ordinal":176951,"en":"Fled in helplessness."},{"id":"semetey-1-2013:p1307:b003:l011","ordinal":176952,"en":"Wounded in seven places,"},{"id":"semetey-1-2013:p1307:b003:l012","ordinal":176953,"en":"Argyn's son Ajybay,"},{"id":"semetey-1-2013:p1307:b003:l013","ordinal":176954,"en":"When Khan Toltoy came,"},{"id":"semetey-1-2013:p1307:b003:l014","ordinal":176955,"en":"After ranging for six days,"},{"id":"semetey-1-2013:p1307:b003:l015","ordinal":176956,"en":"He too fled,"},{"id":"semetey-1-2013:p1307:b003:l016","ordinal":176957,"en":"Wounded in six places."},{"id":"semetey-1-2013:p1307:b003:l017","ordinal":176958,"en":"At that time in Afghanistan,"},{"id":"semetey-1-2013:p1307:b003:l018","ordinal":176959,"en":"There was round baked bread,"},{"id":"semetey-1-2013:p1307:b003:l019","ordinal":176960,"en":"And houses built in four sections."},{"id":"semetey-1-2013:p1307:b003:l020","ordinal":176961,"en":"After having his noble people slaughtered,"},{"id":"semetey-1-2013:p1307:b003:l021","ordinal":176962,"en":"Akun still had an army."},{"id":"semetey-1-2013:p1307:b003:l022","ordinal":176963,"en":"Making Akun wail,"},{"id":"semetey-1-2013:p1307:b003:l023","ordinal":176964,"en":"He penned him inside his city."},{"id":"semetey-1-2013:p1307:b003:l024","ordinal":176965,"en":"Those fated to die died,"},{"id":"semetey-1-2013:p1307:b003:l025","ordinal":176966,"en":"And those who remained alive"},{"id":"semetey-1-2013:p1307:b003:l026","ordinal":176967,"en":"Suffered the utmost humiliation."},{"id":"semetey-1-2013:p1307:b003:l027","ordinal":176968,"en":"They lost their wits,"},{"id":"semetey-1-2013:p1307:b003:l028","ordinal":176969,"en":"Many of them were slain,"},{"id":"semetey-1-2013:p1307:b003:l029","ordinal":176970,"en":"And those who remained alive"},{"id":"semetey-1-2013:p1307:b003:l030","ordinal":176971,"en":"Fled toward the city."},{"id":"semetey-1-2013:p1307:b003:l031","ordinal":176972,"en":"Toltoy made a living hell,"},{"id":"semetey-1-2013:p1307:b003:l032","ordinal":176973,"en":"Not a soul came out to meet him,"},{"id":"semetey-1-2013:p1307:b003:l033","ordinal":176974,"en":"And many of the Afghans"},{"id":"semetey-1-2013:p1307:b003:l034","ordinal":176975,"en":"He slaughtered in heaps."},{"id":"semetey-1-2013:p1307:b003:l035","ordinal":176976,"en":"Akun, Kojo, and Tümönbay"},{"id":"semetey-1-2013:p1307:b003:l036","ordinal":176977,"en":"Could not stand against Toltoy."},{"id":"semetey-1-2013:p1307:b003:l037","ordinal":176978,"en":"It was a God-stricken affair:"},{"id":"semetey-1-2013:p1307:b003:l038","ordinal":176979,"en":"They were no belt one could gird on,"},{"id":"semetey-1-2013:p1307:b003:l039","ordinal":176980,"en":"No people a mortal could trust."},{"id":"semetey-1-2013:p1307:b005:l001","ordinal":176981,"en":"They were a feeble, helpless people."},{"id":"semetey-1-2013:p1307:b005:l002","ordinal":176982,"en":"Unable to find their bearings,"},{"id":"semetey-1-2013:p1307:b005:l003","ordinal":176983,"en":"Many wandered on the ridge,"},{"id":"semetey-1-2013:p1307:b005:l004","ordinal":176984,"en":"All their horses were stallions,"},{"id":"semetey-1-2013:p1307:b005:l005","ordinal":176985,"en":"But they had no saddles at all,"},{"id":"semetey-1-2013:p1307:b005:l006","ordinal":176986,"en":"And many more went about with pack saddles."},{"id":"semetey-1-2013:p1307:b005:l007","ordinal":176987,"en":"Unable to find their bearings,"},{"id":"semetey-1-2013:p1307:b005:l008","ordinal":176988,"en":"Still more rushed about in confusion."},{"id":"semetey-1-2013:p1307:b005:l009","ordinal":176989,"en":"“The Jediger have destroyed us,” they said,"},{"id":"semetey-1-2013:p1307:b005:l010","ordinal":176990,"en":"“They have reached our very roots,” they said;"},{"id":"semetey-1-2013:p1307:b005:l011","ordinal":176991,"en":"Many fled."},{"id":"semetey-1-2013:p1307:b005:l012","ordinal":176992,"en":"“They have wiped out our line,” they said;"},{"id":"semetey-1-2013:p1307:b005:l013","ordinal":176993,"en":"Many grieved,"},{"id":"semetey-1-2013:p1307:b005:l014","ordinal":176994,"en":"When they were about to destroy them to the root,"},{"id":"semetey-1-2013:p1307:b005:l015","ordinal":176995,"en":"When all the Afghans"},{"id":"semetey-1-2013:p1307:b005:l016","ordinal":176996,"en":"Were about to be utterly destroyed,"},{"id":"semetey-1-2013:p1307:b005:l017","ordinal":176997,"en":"A cry burst from a throat."},{"id":"semetey-1-2013:p1307:b005:l018","ordinal":176998,"en":"When they heard the cry,"},{"id":"semetey-1-2013:p1307:b005:l019","ordinal":176999,"en":"Shouting the battle cry “Manas!”"},{"id":"semetey-1-2013:p1307:b005:l020","ordinal":177000,"en":"Külchoro came in fury,"},{"id":"semetey-1-2013:p1307:b005:l021","ordinal":177001,"en":"Leveling his spear at Toltoy."},{"id":"semetey-1-2013:p1307:b005:l022","ordinal":177002,"en":"Behind Külchoro,"},{"id":"semetey-1-2013:p1307:b005:l023","ordinal":177003,"en":"The trumpet deafened the ears,"},{"id":"semetey-1-2013:p1307:b005:l024","ordinal":177004,"en":"The brass horn clattered,"},{"id":"semetey-1-2013:p1307:b005:l025","ordinal":177005,"en":"And the drum boomed."},{"id":"semetey-1-2013:p1307:b005:l026","ordinal":177006,"en":"Dust rose into the sky,"},{"id":"semetey-1-2013:p1307:b005:l027","ordinal":177007,"en":"Cloud striking cloud,"},{"id":"semetey-1-2013:p1307:b005:l028","ordinal":177008,"en":"They raised a din crying “Khan Manas!”"},{"id":"semetey-1-2013:p1307:b005:l029","ordinal":177009,"en":"All the sons of khans"},{"id":"semetey-1-2013:p1307:b005:l030","ordinal":177010,"en":"Raised a clamor as they entered the host."},{"id":"semetey-1-2013:p1307:b005:l031","ordinal":177011,"en":"Shouting, they thrust their spears,"},{"id":"semetey-1-2013:p1307:b005:l032","ordinal":177012,"en":"And many men fell in battle."},{"id":"semetey-1-2013:p1307:b005:l033","ordinal":177013,"en":"They grappled and fought,"},{"id":"semetey-1-2013:p1307:b005:l034","ordinal":177014,"en":"Leaving ruin all around."},{"id":"semetey-1-2013:p1307:b005:l035","ordinal":177015,"en":"Baitaylak, son of Bakay,"},{"id":"semetey-1-2013:p1307:b005:l036","ordinal":177016,"en":"Came shouting from the front,"},{"id":"semetey-1-2013:p1307:b005:l037","ordinal":177017,"en":"And Kalyk of Sary Khan"},{"id":"semetey-1-2013:p1307:b005:l038","ordinal":177018,"en":"Drove in, scattering the foe."},{"id":"semetey-1-2013:p1307:b005:l039","ordinal":177019,"en":"Jamgyrchy's Shayyimbet"},{"id":"semetey-1-2013:p1308:b003:l001","ordinal":177020,"en":"Struck again and swept them down."},{"id":"semetey-1-2013:p1308:b003:l002","ordinal":177021,"en":"From the flank, Kanchoro,"},{"id":"semetey-1-2013:p1308:b003:l003","ordinal":177022,"en":"Girding his keen waist,"},{"id":"semetey-1-2013:p1308:b003:l004","ordinal":177023,"en":"Entered the Jediger host"},{"id":"semetey-1-2013:p1308:b003:l005","ordinal":177024,"en":"Alone and laid hands upon them."},{"id":"semetey-1-2013:p1308:b003:l006","ordinal":177025,"en":"The warriors wearied of combat,"},{"id":"semetey-1-2013:p1308:b003:l007","ordinal":177026,"en":"And their pine-like spears"},{"id":"semetey-1-2013:p1308:b003:l008","ordinal":177027,"en":"Were driven into the very heart."},{"id":"semetey-1-2013:p1308:b003:l009","ordinal":177028,"en":"Corpses of warriors piled like a mountain,"},{"id":"semetey-1-2013:p1308:b003:l010","ordinal":177029,"en":"And all the spears fell in bundles."},{"id":"semetey-1-2013:p1308:b003:l011","ordinal":177030,"en":"Battle-axes shrieked,"},{"id":"semetey-1-2013:p1308:b003:l012","ordinal":177031,"en":"And all the swords shattered."},{"id":"semetey-1-2013:p1308:b003:l013","ordinal":177032,"en":"Much ground was now filled with blood;"},{"id":"semetey-1-2013:p1308:b003:l014","ordinal":177033,"en":"It became a fierce battle."},{"id":"semetey-1-2013:p1308:b003:l015","ordinal":177034,"en":"Shouting, they thrust their spears,"},{"id":"semetey-1-2013:p1308:b003:l016","ordinal":177035,"en":"And when spears could not reach,"},{"id":"semetey-1-2013:p1308:b003:l017","ordinal":177036,"en":"They fought with guns."},{"id":"semetey-1-2013:p1308:b003:l018","ordinal":177037,"en":"A pale haze of dust arose,"},{"id":"semetey-1-2013:p1308:b003:l019","ordinal":177038,"en":"The open field became black blood,"},{"id":"semetey-1-2013:p1308:b003:l020","ordinal":177039,"en":"And many people met their end."},{"id":"semetey-1-2013:p1308:b003:l021","ordinal":177040,"en":"Roaring in fury,"},{"id":"semetey-1-2013:p1308:b003:l022","ordinal":177041,"en":"At all the Jediger"},{"id":"semetey-1-2013:p1308:b003:l023","ordinal":177042,"en":"Külchoro, born of the keen one,"},{"id":"semetey-1-2013:p1308:b003:l024","ordinal":177043,"en":"Charged and scattered them."},{"id":"semetey-1-2013:p1308:b003:l025","ordinal":177044,"en":"From the Afghan city,"},{"id":"semetey-1-2013:p1308:b003:l026","ordinal":177045,"en":"Making the Jediger cry out,"},{"id":"semetey-1-2013:p1308:b003:l027","ordinal":177046,"en":"He drove them out and swept them away."},{"id":"semetey-1-2013:p1308:b003:l028","ordinal":177047,"en":"While your falcons were present,"},{"id":"semetey-1-2013:p1308:b003:l029","ordinal":177048,"en":"They wrought astounding havoc,"},{"id":"semetey-1-2013:p1308:b003:l030","ordinal":177049,"en":"And when Afghanistan was about to perish,"},{"id":"semetey-1-2013:p1308:b003:l031","ordinal":177050,"en":"They tore it free."},{"id":"semetey-1-2013:p1308:b003:l032","ordinal":177051,"en":"Kanchoro carved through their center"},{"id":"semetey-1-2013:p1308:b003:l033","ordinal":177052,"en":"And came out the other side;"},{"id":"semetey-1-2013:p1308:b003:l034","ordinal":177053,"en":"Baitaylak destroyed one wing"},{"id":"semetey-1-2013:p1308:b003:l035","ordinal":177054,"en":"And came out the other side."},{"id":"semetey-1-2013:p1308:b003:l036","ordinal":177055,"en":"Kalyk spread wide on the edge"},{"id":"semetey-1-2013:p1308:b003:l037","ordinal":177056,"en":"And came enclosing it."},{"id":"semetey-1-2013:p1308:b003:l038","ordinal":177057,"en":"In that remarkable battle,"},{"id":"semetey-1-2013:p1308:b003:l039","ordinal":177058,"en":"All those sons of khans"},{"id":"semetey-1-2013:p1308:b004:l001","ordinal":177059,"en":"Came plundering through."},{"id":"semetey-1-2013:p1308:b004:l002","ordinal":177060,"en":"The horses were gathered as spoil,"},{"id":"semetey-1-2013:p1308:b004:l003","ordinal":177061,"en":"And the Jediger people were slaughtered."},{"id":"semetey-1-2013:p1308:b004:l004","ordinal":177062,"en":"The warriors' heads were cut off,"},{"id":"semetey-1-2013:p1308:b004:l005","ordinal":177063,"en":"The lords' bellies were ripped open,"},{"id":"semetey-1-2013:p1308:b004:l006","ordinal":177064,"en":"And the surging Jediger host"},{"id":"semetey-1-2013:p1308:b004:l007","ordinal":177065,"en":"Was wholly broken apart."},{"id":"semetey-1-2013:p1308:b004:l008","ordinal":177066,"en":"The warriors who had boasted of strength"},{"id":"semetey-1-2013:p1308:b004:l009","ordinal":177067,"en":"Dismounted and ran,"},{"id":"semetey-1-2013:p1308:b004:l010","ordinal":177068,"en":"Putting their belts around their necks,"},{"id":"semetey-1-2013:p1308:b004:l011","ordinal":177069,"en":"And pulling their horses forward."},{"id":"semetey-1-2013:p1308:b004:l012","ordinal":177070,"en":"Those who remained alive"},{"id":"semetey-1-2013:p1308:b004:l013","ordinal":177071,"en":"Cast down their spears and sobbed,"},{"id":"semetey-1-2013:p1308:b004:l014","ordinal":177072,"en":"Crying together, “We surrender!”"},{"id":"semetey-1-2013:p1308:b004:l015","ordinal":177073,"en":"The common people gathered,"},{"id":"semetey-1-2013:p1308:b004:l016","ordinal":177074,"en":"Their leaders having been slain;"},{"id":"semetey-1-2013:p1308:b004:l017","ordinal":177075,"en":"The wicked begged for mercy,"},{"id":"semetey-1-2013:p1308:b004:l018","ordinal":177076,"en":"And the good had been beheaded."},{"id":"semetey-1-2013:p1308:b004:l019","ordinal":177077,"en":"Saying, “We shall seize their wives,”"},{"id":"semetey-1-2013:p1308:b004:l020","ordinal":177078,"en":"They drove them frantic from the front;"},{"id":"semetey-1-2013:p1308:b004:l021","ordinal":177079,"en":"The devastated Jediger"},{"id":"semetey-1-2013:p1308:b004:l022","ordinal":177080,"en":"Scattered all their possessions."},{"id":"semetey-1-2013:p1308:b004:l023","ordinal":177081,"en":"The captured Jediger"},{"id":"semetey-1-2013:p1308:b004:l024","ordinal":177082,"en":"Saw what they had never seen;"},{"id":"semetey-1-2013:p1308:b004:l025","ordinal":177083,"en":"Innocent, meek people"},{"id":"semetey-1-2013:p1308:b004:l026","ordinal":177084,"en":"Fell in rows and died,"},{"id":"semetey-1-2013:p1308:b004:l027","ordinal":177085,"en":"And saw the place of Judgment."},{"id":"semetey-1-2013:p1308:b004:l028","ordinal":177086,"en":"Intending to bring death,"},{"id":"semetey-1-2013:p1308:b004:l029","ordinal":177087,"en":"They scattered their own possessions."},{"id":"semetey-1-2013:p1308:b004:l030","ordinal":177088,"en":"Let us leave that matter thus,"},{"id":"semetey-1-2013:p1308:b004:l031","ordinal":177089,"en":"And begin the tale of Toltoy,"},{"id":"semetey-1-2013:p1308:b004:l032","ordinal":177090,"en":"Khan of the Jediger:"},{"id":"semetey-1-2013:p1308:b004:l033","ordinal":177091,"en":"Was Toltoy not a warrior?"},{"id":"semetey-1-2013:p1308:b004:l034","ordinal":177092,"en":"Of Semetey and Choro,"},{"id":"semetey-1-2013:p1308:b004:l035","ordinal":177093,"en":"That they were absent then,"},{"id":"semetey-1-2013:p1308:b004:l036","ordinal":177094,"en":"Hero Toltoy had learned."},{"id":"semetey-1-2013:p1308:b004:l037","ordinal":177095,"en":"Using brute force, he slaughtered the people,"},{"id":"semetey-1-2013:p1308:b004:l038","ordinal":177096,"en":"And Toltoy drove them before him."},{"id":"semetey-1-2013:p1308:b004:l039","ordinal":177097,"en":"Before anyone could say a word,"},{"id":"semetey-1-2013:p1309:b003:l001","ordinal":177098,"en":"In the blink of an eye,"},{"id":"semetey-1-2013:p1309:b003:l002","ordinal":177099,"en":"To Afghanistan, as he pleased,"},{"id":"semetey-1-2013:p1309:b003:l003","ordinal":177100,"en":"Hero Toltoy had done it."},{"id":"semetey-1-2013:p1309:b003:l004","ordinal":177101,"en":"Poor Toltoy then"},{"id":"semetey-1-2013:p1309:b003:l005","ordinal":177102,"en":"Began the turmoil,"},{"id":"semetey-1-2013:p1309:b003:l006","ordinal":177103,"en":"Afghanistan's warriors"},{"id":"semetey-1-2013:p1309:b003:l007","ordinal":177104,"en":"He utterly slaughtered."},{"id":"semetey-1-2013:p1309:b003:l008","ordinal":177105,"en":"He unleashed a fierce calamity;"},{"id":"semetey-1-2013:p1309:b003:l009","ordinal":177106,"en":"Poor Toltoy then"},{"id":"semetey-1-2013:p1309:b003:l010","ordinal":177107,"en":"Lay there taking lives."},{"id":"semetey-1-2013:p1309:b003:l011","ordinal":177108,"en":"When the people were being slaughtered,"},{"id":"semetey-1-2013:p1309:b003:l012","ordinal":177109,"en":"Was he not born a lion?"},{"id":"semetey-1-2013:p1309:b003:l013","ordinal":177110,"en":"Dear Choro arrived."},{"id":"semetey-1-2013:p1309:b003:l014","ordinal":177111,"en":"Against Toltoy once again"},{"id":"semetey-1-2013:p1309:b003:l015","ordinal":177112,"en":"He unleashed the melee."},{"id":"semetey-1-2013:p1309:b003:l016","ordinal":177113,"en":"Külchoro, son of Almambet,"},{"id":"semetey-1-2013:p1309:b003:l017","ordinal":177114,"en":"Turned Akborchuk's head,"},{"id":"semetey-1-2013:p1309:b003:l018","ordinal":177115,"en":"And at Toltoy of the Jediger"},{"id":"semetey-1-2013:p1309:b003:l019","ordinal":177116,"en":"He now shouted and leveled his spear."},{"id":"semetey-1-2013:p1309:b003:l020","ordinal":177117,"en":"When he saw Külchoro,"},{"id":"semetey-1-2013:p1309:b003:l021","ordinal":177118,"en":"Mountain-like hero Toltoy's"},{"id":"semetey-1-2013:p1309:b003:l022","ordinal":177119,"en":"Ribs began to tremble,"},{"id":"semetey-1-2013:p1309:b003:l023","ordinal":177120,"en":"And his entrails quivered."},{"id":"semetey-1-2013:p1309:b003:l024","ordinal":177121,"en":"The brute he had seen before—"},{"id":"semetey-1-2013:p1309:b003:l025","ordinal":177122,"en":"Could Toltoy remain without fleeing,"},{"id":"semetey-1-2013:p1309:b003:l026","ordinal":177123,"en":"Having barely escaped death?"},{"id":"semetey-1-2013:p1309:b003:l027","ordinal":177124,"en":"Could Toltoy stand there calmly?"},{"id":"semetey-1-2013:p1309:b003:l028","ordinal":177125,"en":"Külchoro like Gabriel,"},{"id":"semetey-1-2013:p1309:b003:l029","ordinal":177126,"en":"Making the earth split and thunder,"},{"id":"semetey-1-2013:p1309:b003:l030","ordinal":177127,"en":"Came at that moment,"},{"id":"semetey-1-2013:p1309:b003:l031","ordinal":177128,"en":"Roaring toward Toltoy."},{"id":"semetey-1-2013:p1309:b003:l032","ordinal":177129,"en":"His eyes reddened like a wolf's,"},{"id":"semetey-1-2013:p1309:b003:l033","ordinal":177130,"en":"His neck stretched unusually long;"},{"id":"semetey-1-2013:p1309:b003:l034","ordinal":177131,"en":"There was no man like Külchoro."},{"id":"semetey-1-2013:p1309:b003:l035","ordinal":177132,"en":"When Toltoy looked back,"},{"id":"semetey-1-2013:p1309:b003:l036","ordinal":177133,"en":"A gray tiger was coming beneath him."},{"id":"semetey-1-2013:p1309:b003:l037","ordinal":177134,"en":"With his tail raised high,"},{"id":"semetey-1-2013:p1309:b003:l038","ordinal":177135,"en":"He made for Khan Toltoy,"},{"id":"semetey-1-2013:p1309:b003:l039","ordinal":177136,"en":"Shouting a mighty cry."},{"id":"semetey-1-2013:p1309:b004:l001","ordinal":177137,"en":"The blue invincible one, never sated with blood,"},{"id":"semetey-1-2013:p1309:b004:l002","ordinal":177138,"en":"As though about to sweep him away,"},{"id":"semetey-1-2013:p1309:b004:l003","ordinal":177139,"en":"Came up beneath him."},{"id":"semetey-1-2013:p1309:b004:l004","ordinal":177140,"en":"Before Toltoy's eyes"},{"id":"semetey-1-2013:p1309:b004:l005","ordinal":177141,"en":"He began the melee."},{"id":"semetey-1-2013:p1309:b004:l006","ordinal":177142,"en":"From that invincible one's wrath,"},{"id":"semetey-1-2013:p1309:b004:l007","ordinal":177143,"en":"Poor Toltoy then"},{"id":"semetey-1-2013:p1309:b004:l008","ordinal":177144,"en":"Was nearly flung"},{"id":"semetey-1-2013:p1309:b004:l009","ordinal":177145,"en":"From atop Surkoyon."},{"id":"semetey-1-2013:p1309:b004:l010","ordinal":177146,"en":"His heart began pounding,"},{"id":"semetey-1-2013:p1309:b004:l011","ordinal":177147,"en":"Despairing of his precious life,"},{"id":"semetey-1-2013:p1309:b004:l012","ordinal":177148,"en":"Toltoy burned and trembled."},{"id":"semetey-1-2013:p1309:b004:l013","ordinal":177149,"en":"When he saw Külchoro,"},{"id":"semetey-1-2013:p1309:b004:l014","ordinal":177150,"en":"Toltoy looked and grieved;"},{"id":"semetey-1-2013:p1309:b004:l015","ordinal":177151,"en":"Thinking he would die,"},{"id":"semetey-1-2013:p1309:b004:l016","ordinal":177152,"en":"He despaired of his fly-like life."}]
