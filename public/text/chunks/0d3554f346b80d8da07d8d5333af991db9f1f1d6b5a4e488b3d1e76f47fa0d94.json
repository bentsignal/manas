[{"id":"manas-2010:p1452:b001:l021","ordinal":62721,"en":"His darling called Bozuul,"},{"id":"manas-2010:p1452:b001:l022","ordinal":62722,"en":"The leader of the forty, old Kyrgyl—"},{"id":"manas-2010:p1452:b001:l023","ordinal":62723,"en":"The mad old man, wild even at forty;"},{"id":"manas-2010:p1452:b001:l024","ordinal":62724,"en":"There was beloved Shuutu,"},{"id":"manas-2010:p1452:b001:l025","ordinal":62725,"en":"And the hero Baychoro,"},{"id":"manas-2010:p1452:b001:l026","ordinal":62726,"en":"And Agayar too."},{"id":"manas-2010:p1452:b001:l027","ordinal":62727,"en":"Allowing no horse to approach,"},{"id":"manas-2010:p1452:b001:l028","ordinal":62728,"en":"The forty companions guarded the door,"},{"id":"manas-2010:p1452:b001:l029","ordinal":62729,"en":"Letting no person reach hero Manas"},{"id":"manas-2010:p1452:b001:l030","ordinal":62730,"en":"Without permission;"},{"id":"manas-2010:p1452:b001:l031","ordinal":62731,"en":"They encircled him like iron."},{"id":"manas-2010:p1452:b001:l032","ordinal":62732,"en":"If the Chinese voiced their grief,"},{"id":"manas-2010:p1452:b001:l033","ordinal":62733,"en":"They slaughtered and ate their horses too."},{"id":"manas-2010:p1452:b001:l034","ordinal":62734,"en":"Hero Manas's forty companions"},{"id":"manas-2010:p1452:b001:l035","ordinal":62735,"en":"Made those who listened"},{"id":"manas-2010:p1452:b001:l036","ordinal":62736,"en":"Fear them through their words;"},{"id":"manas-2010:p1452:b001:l037","ordinal":62737,"en":"Those who did not listen"},{"id":"manas-2010:p1452:b001:l038","ordinal":62738,"en":"They frightened with their swords."},{"id":"manas-2010:p1452:b001:l039","ordinal":62739,"en":"Asked for a cap, they cut off a head;"},{"id":"manas-2010:p1452:b001:l040","ordinal":62740,"en":"The forty companions stood apart."},{"id":"manas-2010:p1452:b001:l041","ordinal":62741,"en":"Seeing such force,"},{"id":"manas-2010:p1452:b001:l042","ordinal":62742,"en":"The Chinese people of forty khans"},{"id":"manas-2010:p1453:b001:l001","ordinal":62743,"en":"Felt the pressure upon them."},{"id":"manas-2010:p1453:b001:l002","ordinal":62744,"en":"“Like this, without pity for us,"},{"id":"manas-2010:p1453:b001:l003","ordinal":62745,"en":"Manas will slaughter us and depart;"},{"id":"manas-2010:p1453:b001:l004","ordinal":62746,"en":"The Manchu and Chinese"},{"id":"manas-2010:p1453:b001:l005","ordinal":62747,"en":"Will be destroyed by the Burut,” they said."},{"id":"manas-2010:p1453:b001:l006","ordinal":62748,"en":"Manas's forty companions"},{"id":"manas-2010:p1453:b001:l007","ordinal":62749,"en":"Played at wrestling, raising dust;"},{"id":"manas-2010:p1453:b001:l008","ordinal":62750,"en":"They played at wrestling on horseback,"},{"id":"manas-2010:p1453:b001:l009","ordinal":62751,"en":"Charging out two by two."},{"id":"manas-2010:p1453:b001:l010","ordinal":62752,"en":"“If they meet us, they will kill us,”"},{"id":"manas-2010:p1453:b001:l011","ordinal":62753,"en":"Unable to endure their wrath,"},{"id":"manas-2010:p1453:b001:l012","ordinal":62754,"en":"The many Chinese and Manchu"},{"id":"manas-2010:p1453:b001:l013","ordinal":62755,"en":"Fled headlong from the road."},{"id":"manas-2010:p1453:b001:l014","ordinal":62756,"en":"None paused to think or reason;"},{"id":"manas-2010:p1453:b001:l015","ordinal":62757,"en":"Among the Chinese and Manchu"},{"id":"manas-2010:p1453:b001:l016","ordinal":62758,"en":"No man remained who could resist."},{"id":"manas-2010:p1453:b001:l017","ordinal":62759,"en":"In the kakan's Beijing,"},{"id":"manas-2010:p1453:b001:l018","ordinal":62760,"en":"Hero Manas thundered;"},{"id":"manas-2010:p1453:b001:l019","ordinal":62761,"en":"The many Chinese and Manchu"},{"id":"manas-2010:p1453:b001:l020","ordinal":62762,"en":"Fled, leaving the bare earth."},{"id":"manas-2010:p1453:b001:l021","ordinal":62763,"en":"The forty companions guarding him"},{"id":"manas-2010:p1453:b001:l022","ordinal":62764,"en":"For the many Manchu and Chinese,"},{"id":"manas-2010:p1453:b001:l023","ordinal":62765,"en":"Were a torment to their hearts."},{"id":"manas-2010:p1453:b001:l024","ordinal":62766,"en":"They were horses, not mules,"},{"id":"manas-2010:p1453:b001:l025","ordinal":62767,"en":"To the tribute-taking Chinese"},{"id":"manas-2010:p1453:b001:l026","ordinal":62768,"en":"They became a sickness in the breast."},{"id":"manas-2010:p1453:b001:l027","ordinal":62769,"en":"For the Chinese people of forty khans,"},{"id":"manas-2010:p1453:b001:l028","ordinal":62770,"en":"His rule was harsh;"},{"id":"manas-2010:p1453:b001:l029","ordinal":62771,"en":"His six months of rule"},{"id":"manas-2010:p1453:b001:l030","ordinal":62772,"en":"Were worth sixty years."},{"id":"manas-2010:p1453:b001:l031","ordinal":62773,"en":"The Muslims who saw its benefits"},{"id":"manas-2010:p1453:b001:l032","ordinal":62774,"en":"Had no wish to leave Beijing."},{"id":"manas-2010:p1453:b001:l033","ordinal":62775,"en":"“While this blood-shedder is here,"},{"id":"manas-2010:p1453:b001:l034","ordinal":62776,"en":"At Beijing lying dark and grim"},{"id":"manas-2010:p1453:b001:l035","ordinal":62777,"en":"I shall brandish my lance and spit defiance,"},{"id":"manas-2010:p1453:b001:l036","ordinal":62778,"en":"And over Beijing's many Chinese"},{"id":"manas-2010:p1453:b001:l037","ordinal":62779,"en":"I shall share in his rule.”"},{"id":"manas-2010:p1453:b001:l038","ordinal":62780,"en":"So saying, the forty companions"},{"id":"manas-2010:p1453:b001:l039","ordinal":62781,"en":"And all the remaining khans"},{"id":"manas-2010:p1453:b001:l040","ordinal":62782,"en":"Became a fortress for Manas."},{"id":"manas-2010:p1453:b001:l041","ordinal":62783,"en":"He now issued firm commands,"},{"id":"manas-2010:p1453:b001:l042","ordinal":62784,"en":"And all the governors"},{"id":"manas-2010:p1454:b001:l001","ordinal":62785,"en":"He held confined at that time."},{"id":"manas-2010:p1454:b001:l002","ordinal":62786,"en":"On the Chinese who wore rank-stones,"},{"id":"manas-2010:p1454:b001:l003","ordinal":62787,"en":"On their bald heads he laid"},{"id":"manas-2010:p1454:b001:l004","ordinal":62788,"en":"Heavy tribute upon tribute."},{"id":"manas-2010:p1454:b001:l005","ordinal":62789,"en":"Of the many bachelors who had come,"},{"id":"manas-2010:p1454:b001:l006","ordinal":62790,"en":"Not one was left without;"},{"id":"manas-2010:p1454:b001:l007","ordinal":62791,"en":"Now every man had a wife."},{"id":"manas-2010:p1454:b001:l008","ordinal":62792,"en":"The Chinese wearing jackets"},{"id":"manas-2010:p1454:b001:l009","ordinal":62793,"en":"He kept confined each day;"},{"id":"manas-2010:p1454:b001:l010","ordinal":62794,"en":"The Chinese in their skirted belts"},{"id":"manas-2010:p1454:b001:l011","ordinal":62795,"en":"He struck, tearing their faces."},{"id":"manas-2010:p1454:b001:l012","ordinal":62796,"en":"Taxes, tribute and levies"},{"id":"manas-2010:p1454:b001:l013","ordinal":62797,"en":"The Muslims kept collecting;"},{"id":"manas-2010:p1454:b001:l014","ordinal":62798,"en":"Their livestock and possessions, without pity,"},{"id":"manas-2010:p1454:b001:l015","ordinal":62799,"en":"The Muslims kept taking."},{"id":"manas-2010:p1454:b001:l016","ordinal":62800,"en":"The many Chinese, finding no remedy,"},{"id":"manas-2010:p1454:b001:l017","ordinal":62801,"en":"Wandered about, their minds undone."},{"id":"manas-2010:p1454:b001:l018","ordinal":62802,"en":"“His rule is harsh,” they said,"},{"id":"manas-2010:p1454:b001:l019","ordinal":62803,"en":"Amazed at the Muslims."},{"id":"manas-2010:p1454:b001:l020","ordinal":62804,"en":"“The Burut have tormented us;"},{"id":"manas-2010:p1454:b001:l021","ordinal":62805,"en":"If they rule another six months,"},{"id":"manas-2010:p1454:b001:l022","ordinal":62806,"en":"The kakan's Great Beijing"},{"id":"manas-2010:p1454:b001:l023","ordinal":62807,"en":"Will be utterly ruined and destroyed."},{"id":"manas-2010:p1454:b001:l024","ordinal":62808,"en":"They ply their craft upon its people,"},{"id":"manas-2010:p1454:b001:l025","ordinal":62809,"en":"Taking girls as their tribute,"},{"id":"manas-2010:p1454:b001:l026","ordinal":62810,"en":"Loading gold upon mules,"},{"id":"manas-2010:p1454:b001:l027","ordinal":62811,"en":"Inflicting bitter sorrow."},{"id":"manas-2010:p1454:b001:l028","ordinal":62812,"en":"These Burut burst their way in"},{"id":"manas-2010:p1454:b001:l029","ordinal":62813,"en":"And mounted your golden throne."},{"id":"manas-2010:p1454:b001:l030","ordinal":62814,"en":"They subjected the vast people,"},{"id":"manas-2010:p1454:b001:l031","ordinal":62815,"en":"They inflicted punishment on the people."},{"id":"manas-2010:p1454:b001:l032","ordinal":62816,"en":"When springtime comes,"},{"id":"manas-2010:p1454:b001:l033","ordinal":62817,"en":"They let us ride no maned swift horse;"},{"id":"manas-2010:p1454:b001:l034","ordinal":62818,"en":"When summer days arrive,"},{"id":"manas-2010:p1454:b001:l035","ordinal":62819,"en":"They let us eat no fat-tailed lamb."},{"id":"manas-2010:p1454:b001:l036","ordinal":62820,"en":"These Muslims who act this way"},{"id":"manas-2010:p1454:b001:l037","ordinal":62821,"en":"Will one day press your people"},{"id":"manas-2010:p1454:b001:l038","ordinal":62822,"en":"And gather up their leaders;"},{"id":"manas-2010:p1454:b001:l039","ordinal":62823,"en":"Driving the Chinese before them,"},{"id":"manas-2010:p1454:b001:l040","ordinal":62824,"en":"In the end they will slaughter them one day!"},{"id":"manas-2010:p1454:b001:l041","ordinal":62825,"en":"With cotton sash and broad boots,"},{"id":"manas-2010:p1454:b001:l042","ordinal":62826,"en":"Kongurbay, khan of the monks—"},{"id":"manas-2010:p1455:b001:l001","ordinal":62827,"en":"That unshaken, fearless man,"},{"id":"manas-2010:p1455:b001:l002","ordinal":62828,"en":"Where has the governor gone?"},{"id":"manas-2010:p1455:b001:l003","ordinal":62829,"en":"His battle-axe upon his wrist—"},{"id":"manas-2010:p1455:b001:l004","ordinal":62830,"en":"Has Kongurbay slung it there?"},{"id":"manas-2010:p1455:b001:l005","ordinal":62831,"en":"That the great people suffer hell—"},{"id":"manas-2010:p1455:b001:l006","ordinal":62832,"en":"Does Kongurbay know it?"},{"id":"manas-2010:p1455:b001:l007","ordinal":62833,"en":"He was a mighty hero of Beijing,"},{"id":"manas-2010:p1455:b001:l008","ordinal":62834,"en":"The kakan's Chinese people"},{"id":"manas-2010:p1455:b001:l009","ordinal":62835,"en":"He was a lion who could sustain."},{"id":"manas-2010:p1455:b001:l010","ordinal":62836,"en":"These many people of Beijing"},{"id":"manas-2010:p1455:b001:l011","ordinal":62837,"en":"We used to cook without salt"},{"id":"manas-2010:p1455:b001:l012","ordinal":62838,"en":"And eat their white fruit."},{"id":"manas-2010:p1455:b001:l013","ordinal":62839,"en":"While Alöökö's Kongurbay"},{"id":"manas-2010:p1455:b001:l014","ordinal":62840,"en":"Stood roaring on guard,"},{"id":"manas-2010:p1455:b001:l015","ordinal":62841,"en":"We used to ask, ‘Where is misfortune?’"},{"id":"manas-2010:p1455:b001:l016","ordinal":62842,"en":"Have ravens gouged out his eyes,"},{"id":"manas-2010:p1455:b001:l017","ordinal":62843,"en":"Or, taking a fancy to it, has"},{"id":"manas-2010:p1455:b001:l018","ordinal":62844,"en":"The Burut's Manas slaughtered him?”"},{"id":"manas-2010:p1455:b001:l019","ordinal":62845,"en":"Grieving and sobbing,"},{"id":"manas-2010:p1455:b001:l020","ordinal":62846,"en":"The many Chinese clamored."},{"id":"manas-2010:p1455:b001:l021","ordinal":62847,"en":"“Merciless Kongurbay,"},{"id":"manas-2010:p1455:b001:l022","ordinal":62848,"en":"Without any pity for the Chinese,"},{"id":"manas-2010:p1455:b001:l023","ordinal":62849,"en":"Takes tribute, we used to say;"},{"id":"manas-2010:p1455:b001:l024","ordinal":62850,"en":"We used to grieve then."},{"id":"manas-2010:p1455:b001:l025","ordinal":62851,"en":"But unending torment and bitter days"},{"id":"manas-2010:p1455:b001:l026","ordinal":62852,"en":"Are truly here before us!"},{"id":"manas-2010:p1455:b001:l027","ordinal":62853,"en":"Taking tribute every day,"},{"id":"manas-2010:p1455:b001:l028","ordinal":62854,"en":"He has brought suffering on the people.”"},{"id":"manas-2010:p1455:b001:l029","ordinal":62855,"en":"So the many Chinese"},{"id":"manas-2010:p1455:b001:l030","ordinal":62856,"en":"Voiced their sorrow, clamoring."},{"id":"manas-2010:p1455:b001:l031","ordinal":62857,"en":"The many Chinese in distress—"},{"id":"manas-2010:p1455:b001:l032","ordinal":62858,"en":"Let us leave them there;"},{"id":"manas-2010:p1455:b001:l033","ordinal":62859,"en":"Of Alöökö's Kongurbay"},{"id":"manas-2010:p1455:b001:l034","ordinal":62860,"en":"Let us now begin to speak."},{"id":"manas-2010:p1455:b001:l035","ordinal":62861,"en":"A wretch skilled among spearmen,"},{"id":"manas-2010:p1455:b001:l036","ordinal":62862,"en":"A mighty wretch who knew the enemy's devices;"},{"id":"manas-2010:p1455:b001:l037","ordinal":62863,"en":"What he wore low on his head"},{"id":"manas-2010:p1455:b001:l038","ordinal":62864,"en":"Was a helmet no bullet pierced;"},{"id":"manas-2010:p1455:b001:l039","ordinal":62865,"en":"What he hung upon his arm"},{"id":"manas-2010:p1455:b001:l040","ordinal":62866,"en":"Was plate armor made of steel;"},{"id":"manas-2010:p1455:b001:l041","ordinal":62867,"en":"What he hung upon his wrist,"},{"id":"manas-2010:p1455:b001:l042","ordinal":62868,"en":"Tempered and made with poison,"},{"id":"manas-2010:p1456:b001:l001","ordinal":62869,"en":"Was a battle-axe with a golden point."},{"id":"manas-2010:p1456:b001:l002","ordinal":62870,"en":"With no sleep in the daytime,"},{"id":"manas-2010:p1456:b001:l003","ordinal":62871,"en":"With no peace in the night,"},{"id":"manas-2010:p1456:b001:l004","ordinal":62872,"en":"Kongurbay lay in wait."},{"id":"manas-2010:p1456:b001:l005","ordinal":62873,"en":"At the gate in the east"},{"id":"manas-2010:p1456:b001:l006","ordinal":62874,"en":"For seven days he watched, ah;"},{"id":"manas-2010:p1456:b001:l007","ordinal":62875,"en":"Kongurbay left without success."},{"id":"manas-2010:p1456:b001:l008","ordinal":62876,"en":"Unable to send a spy inside,"},{"id":"manas-2010:p1456:b001:l009","ordinal":62877,"en":"Unable to get news of Manas,"},{"id":"manas-2010:p1456:b001:l010","ordinal":62878,"en":"Kongurbay wandered away."},{"id":"manas-2010:p1456:b001:l011","ordinal":62879,"en":"To rest somewhere in peace,"},{"id":"manas-2010:p1456:b001:l012","ordinal":62880,"en":"Kongurbay never lay down."},{"id":"manas-2010:p1456:b001:l013","ordinal":62881,"en":"Unable to learn certain news,"},{"id":"manas-2010:p1456:b001:l014","ordinal":62882,"en":"Into the heat of Manas's presence"},{"id":"manas-2010:p1456:b001:l015","ordinal":62883,"en":"Kongurbay could not venture."},{"id":"manas-2010:p1456:b001:l016","ordinal":62884,"en":"Unable to get news of Manas,"},{"id":"manas-2010:p1456:b001:l017","ordinal":62885,"en":"The Kalcha wretch grieved greatly."},{"id":"manas-2010:p1456:b001:l018","ordinal":62886,"en":"Beside Kongurbay"},{"id":"manas-2010:p1456:b001:l019","ordinal":62887,"en":"Was a mighty man called Manzhuu,"},{"id":"manas-2010:p1456:b001:l020","ordinal":62888,"en":"A sorcerer who bewitched the eyes,"},{"id":"manas-2010:p1456:b001:l021","ordinal":62889,"en":"A very master of spells."},{"id":"manas-2010:p1456:b001:l022","ordinal":62890,"en":"For the Kalcha lying in wait,"},{"id":"manas-2010:p1456:b001:l023","ordinal":62891,"en":"He was the black eye that watched."},{"id":"manas-2010:p1456:b001:l024","ordinal":62892,"en":"When red blood flowed on the battlefield,"},{"id":"manas-2010:p1456:b001:l025","ordinal":62893,"en":"He was one who never looked back."},{"id":"manas-2010:p1456:b001:l026","ordinal":62894,"en":"When Aykhozho's Bilerik"},{"id":"manas-2010:p1456:b001:l027","ordinal":62895,"en":"Had been brought before Esenkan"},{"id":"manas-2010:p1456:b001:l028","ordinal":62896,"en":"As a gift,"},{"id":"manas-2010:p1456:b001:l029","ordinal":62897,"en":"The customs of the Muslims"},{"id":"manas-2010:p1456:b001:l030","ordinal":62898,"en":"He had come to know."},{"id":"manas-2010:p1456:b001:l031","ordinal":62899,"en":"His forelock, thick as a girth,"},{"id":"manas-2010:p1456:b001:l032","ordinal":62900,"en":"He knotted on his crown;"},{"id":"manas-2010:p1456:b001:l033","ordinal":62901,"en":"The holy men's light robe"},{"id":"manas-2010:p1456:b001:l034","ordinal":62902,"en":"He pulled down over himself."},{"id":"manas-2010:p1456:b001:l035","ordinal":62903,"en":"The homespun woolen sash around his waist"},{"id":"manas-2010:p1456:b001:l036","ordinal":62904,"en":"He wrapped into a turban."},{"id":"manas-2010:p1456:b001:l037","ordinal":62905,"en":"A black donkey with a white blaze"},{"id":"manas-2010:p1456:b001:l038","ordinal":62906,"en":"He mounted and settled upon."},{"id":"manas-2010:p1456:b001:l039","ordinal":62907,"en":"A holy man's staff in his hand,"},{"id":"manas-2010:p1456:b001:l040","ordinal":62908,"en":"White saddlebags on his back,"},{"id":"manas-2010:p1456:b001:l041","ordinal":62909,"en":"Invoking Allah in the Burut tongue,"},{"id":"manas-2010:p1456:b001:l042","ordinal":62910,"en":"He set off along the road."},{"id":"manas-2010:p1457:b001:l001","ordinal":62911,"en":"Old Kyrgyl, standing guard,"},{"id":"manas-2010:p1457:b001:l002","ordinal":62912,"en":"One who wandered wide Beijing,"},{"id":"manas-2010:p1457:b001:l003","ordinal":62913,"en":"A mendicant holy man, he thought."},{"id":"manas-2010:p1457:b001:l004","ordinal":62914,"en":"Of the invocations a mullah recites,"},{"id":"manas-2010:p1457:b001:l005","ordinal":62915,"en":"He did not leave a single one unsaid."},{"id":"manas-2010:p1457:b001:l006","ordinal":62916,"en":"No wind could match his trotting pace;"},{"id":"manas-2010:p1457:b001:l007","ordinal":62917,"en":"Loudly invoking Allah,"},{"id":"manas-2010:p1457:b001:l008","ordinal":62918,"en":"Of hell and paradise"},{"id":"manas-2010:p1457:b001:l009","ordinal":62919,"en":"He rattled off his account."},{"id":"manas-2010:p1457:b001:l010","ordinal":62920,"en":"Plane trees grew all around,"},{"id":"manas-2010:p1457:b001:l011","ordinal":62921,"en":"With a golden throne in their midst;"},{"id":"manas-2010:p1457:b001:l012","ordinal":62922,"en":"Upon the golden throne,"},{"id":"manas-2010:p1457:b001:l013","ordinal":62923,"en":"The fearless sovereign Manas"},{"id":"manas-2010:p1457:b001:l014","ordinal":62924,"en":"Over the many Chinese and Manchu"},{"id":"manas-2010:p1457:b001:l015","ordinal":62925,"en":"Was ruling at that time."},{"id":"manas-2010:p1457:b001:l016","ordinal":62926,"en":"Your untroubled gray-maned wolf"},{"id":"manas-2010:p1457:b001:l017","ordinal":62927,"en":"Was an unsparing lion;"},{"id":"manas-2010:p1457:b001:l018","ordinal":62928,"en":"Everything was in his favor;"},{"id":"manas-2010:p1457:b001:l019","ordinal":62929,"en":"His vastness was a river, a sea,"},{"id":"manas-2010:p1457:b001:l020","ordinal":62930,"en":"Rich in wisdom, broad and generous."},{"id":"manas-2010:p1457:b001:l021","ordinal":62931,"en":"People longed to enter his presence."},{"id":"manas-2010:p1457:b001:l022","ordinal":62932,"en":"In Khan Manas's service,"},{"id":"manas-2010:p1457:b001:l023","ordinal":62933,"en":"A Muslim only in pretense,"},{"id":"manas-2010:p1457:b001:l024","ordinal":62934,"en":"A Chinese called Shuykuchu"},{"id":"manas-2010:p1457:b001:l025","ordinal":62935,"en":"Worked as his cook."},{"id":"manas-2010:p1457:b001:l026","ordinal":62936,"en":"Of the gray-maned wolf, hero Manas,"},{"id":"manas-2010:p1457:b001:l027","ordinal":62937,"en":"His movements and his resting places,"},{"id":"manas-2010:p1457:b001:l028","ordinal":62938,"en":"His counsels and his deeds,"},{"id":"manas-2010:p1457:b001:l029","ordinal":62939,"en":"He was a man who knew it all."},{"id":"manas-2010:p1457:b001:l030","ordinal":62940,"en":"To give to Kongurbay,"},{"id":"manas-2010:p1457:b001:l031","ordinal":62941,"en":"He put it all into a letter;"},{"id":"manas-2010:p1457:b001:l032","ordinal":62942,"en":"Concealing it from the Muslims,"},{"id":"manas-2010:p1457:b001:l033","ordinal":62943,"en":"The sly fellow kept it hidden."},{"id":"manas-2010:p1457:b001:l034","ordinal":62944,"en":"When the mendicant approached,"},{"id":"manas-2010:p1457:b001:l035","ordinal":62945,"en":"Shuykuchu caught sight of him."},{"id":"manas-2010:p1457:b001:l036","ordinal":62946,"en":"Inside a loaf as broad as a platter"},{"id":"manas-2010:p1457:b001:l037","ordinal":62947,"en":"He placed what he had written;"},{"id":"manas-2010:p1457:b001:l038","ordinal":62948,"en":"Hiding it from the many people,"},{"id":"manas-2010:p1457:b001:l039","ordinal":62949,"en":"Shuykuchu passed him the letter."},{"id":"manas-2010:p1457:b001:l040","ordinal":62950,"en":"Taking the bread, the sorcerer"},{"id":"manas-2010:p1457:b001:l041","ordinal":62951,"en":"Turned aside and darted off;"},{"id":"manas-2010:p1457:b001:l042","ordinal":62952,"en":"With his whip, his donkey"},{"id":"manas-2010:p1458:b001:l001","ordinal":62953,"en":"He struck it once upon the thigh,"},{"id":"manas-2010:p1458:b001:l002","ordinal":62954,"en":"Without turning back or stopping,"},{"id":"manas-2010:p1458:b001:l003","ordinal":62955,"en":"Took the road with a cry of “Go!”"},{"id":"manas-2010:p1458:b001:l004","ordinal":62956,"en":"Flashing out of the city,"},{"id":"manas-2010:p1458:b001:l005","ordinal":62957,"en":"To the mine where gold was dug,"},{"id":"manas-2010:p1458:b001:l006","ordinal":62958,"en":"Where fierce Kongurbay hid—"},{"id":"manas-2010:p1458:b001:l007","ordinal":62959,"en":"There he was lying then."},{"id":"manas-2010:p1458:b001:l008","ordinal":62960,"en":"The mendicant drew near;"},{"id":"manas-2010:p1458:b001:l009","ordinal":62961,"en":"In the blinking of an eye"},{"id":"manas-2010:p1458:b001:l010","ordinal":62962,"en":"He reached Kongurbay."},{"id":"manas-2010:p1458:b001:l011","ordinal":62963,"en":"The flatbread he had brought,"},{"id":"manas-2010:p1458:b001:l012","ordinal":62964,"en":"He handed over and went on."},{"id":"manas-2010:p1458:b001:l013","ordinal":62965,"en":"When the fierce one broke it and looked,"},{"id":"manas-2010:p1458:b001:l014","ordinal":62966,"en":"In the middle of the flatbread"},{"id":"manas-2010:p1458:b001:l015","ordinal":62967,"en":"Was the letter Shuykuchu had sent."},{"id":"manas-2010:p1458:b001:l016","ordinal":62968,"en":"When he read the letter,"},{"id":"manas-2010:p1458:b001:l017","ordinal":62969,"en":"It bore the name Shuykuchu."},{"id":"manas-2010:p1458:b001:l018","ordinal":62970,"en":"This was written in the letter:"},{"id":"manas-2010:p1458:b001:l019","ordinal":62971,"en":"“Against Manas, who rules Beijing,"},{"id":"manas-2010:p1458:b001:l020","ordinal":62972,"en":"Your strength cannot prevail in a struggle."},{"id":"manas-2010:p1458:b001:l021","ordinal":62973,"en":"He is one of the mighty fighters;"},{"id":"manas-2010:p1458:b001:l022","ordinal":62974,"en":"What Manas seeks"},{"id":"manas-2010:p1458:b001:l023","ordinal":62975,"en":"Is the Muslim faith."},{"id":"manas-2010:p1458:b001:l024","ordinal":62976,"en":"He is truly a lion."}]
