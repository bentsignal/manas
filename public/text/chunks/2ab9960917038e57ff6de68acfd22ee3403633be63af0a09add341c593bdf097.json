[{"id":"semetey-1-2013:p1290:b003:l002","ordinal":175617,"en":"Blue haze parted in the sky;"},{"id":"semetey-1-2013:p1290:b003:l003","ordinal":175618,"en":"With a rumble like a mountain collapsing,"},{"id":"semetey-1-2013:p1290:b003:l004","ordinal":175619,"en":"Hero Semetey appeared."},{"id":"semetey-1-2013:p1290:b003:l005","ordinal":175620,"en":"Over rugged hills and passes"},{"id":"semetey-1-2013:p1290:b003:l006","ordinal":175621,"en":"He rode out fiercely,"},{"id":"semetey-1-2013:p1290:b003:l007","ordinal":175622,"en":"His Buurul beneath him"},{"id":"semetey-1-2013:p1290:b003:l008","ordinal":175623,"en":"Covered with an abai cloth."},{"id":"semetey-1-2013:p1290:b003:l009","ordinal":175624,"en":"The sight overcame every heart;"},{"id":"semetey-1-2013:p1290:b003:l010","ordinal":175625,"en":"He loomed like Opol-Too,"},{"id":"semetey-1-2013:p1290:b003:l011","ordinal":175626,"en":"And the flame from his mouth"},{"id":"semetey-1-2013:p1290:b003:l012","ordinal":175627,"en":"Showed a spear's length."},{"id":"semetey-1-2013:p1290:b003:l013","ordinal":175628,"en":"Your gray wolf, the son of Manas,"},{"id":"semetey-1-2013:p1290:b003:l014","ordinal":175629,"en":"Had put on Akolpok;"},{"id":"semetey-1-2013:p1290:b003:l015","ordinal":175630,"en":"When they saw the gray wolf's form,"},{"id":"semetey-1-2013:p1290:b003:l016","ordinal":175631,"en":"The Zhediger stood grieving."},{"id":"semetey-1-2013:p1290:b003:l017","ordinal":175632,"en":"Your thundering sultan"},{"id":"semetey-1-2013:p1290:b003:l018","ordinal":175633,"en":"Girded on a silver belt,"},{"id":"semetey-1-2013:p1290:b003:l019","ordinal":175634,"en":"His face radiant as the sun;"},{"id":"semetey-1-2013:p1290:b003:l020","ordinal":175635,"en":"He girded on a golden belt,"},{"id":"semetey-1-2013:p1290:b003:l021","ordinal":175636,"en":"His face radiant as the moon."},{"id":"semetey-1-2013:p1290:b003:l022","ordinal":175637,"en":"The leopard supported by the spirits"},{"id":"semetey-1-2013:p1290:b003:l023","ordinal":175638,"en":"Stood erect and untroubled;"},{"id":"semetey-1-2013:p1290:b003:l024","ordinal":175639,"en":"He reckoned a kinsman like Chynkojo"},{"id":"semetey-1-2013:p1290:b003:l025","ordinal":175640,"en":"As less than the hem of his robe."},{"id":"semetey-1-2013:p1290:b003:l026","ordinal":175641,"en":"The dear hero, proud as a cock,"},{"id":"semetey-1-2013:p1290:b003:l027","ordinal":175642,"en":"Stood ringing without stirring;"},{"id":"semetey-1-2013:p1290:b003:l028","ordinal":175643,"en":"The sight arrested the heart,"},{"id":"semetey-1-2013:p1290:b003:l029","ordinal":175644,"en":"And blood dripped from the point"},{"id":"semetey-1-2013:p1290:b003:l030","ordinal":175645,"en":"Of the inlaid spear in his hand."},{"id":"semetey-1-2013:p1290:b003:l031","ordinal":175646,"en":"His ravenous nature showed;"},{"id":"semetey-1-2013:p1290:b003:l032","ordinal":175647,"en":"Buurul beneath him"},{"id":"semetey-1-2013:p1290:b003:l033","ordinal":175648,"en":"Gathered himself more fiercely than a stag."},{"id":"semetey-1-2013:p1290:b003:l034","ordinal":175649,"en":"Semetey, thoroughbred prince,"},{"id":"semetey-1-2013:p1290:b003:l035","ordinal":175650,"en":"Had put on Akolpok."},{"id":"semetey-1-2013:p1290:b003:l036","ordinal":175651,"en":"The kasaba banner floated in his hand;"},{"id":"semetey-1-2013:p1290:b003:l037","ordinal":175652,"en":"Akkelte, inherited from Manas,"},{"id":"semetey-1-2013:p1290:b003:l038","ordinal":175653,"en":"Gleamed upon his right shoulder."},{"id":"semetey-1-2013:p1290:b003:l039","ordinal":175654,"en":"Zulfiqar rang in the sheath"},{"id":"semetey-1-2013:p1290:b004:l001","ordinal":175655,"en":"Of the poor sultan-born hero;"},{"id":"semetey-1-2013:p1290:b004:l002","ordinal":175656,"en":"Semetey was a sultan,"},{"id":"semetey-1-2013:p1290:b004:l003","ordinal":175657,"en":"And came onward ringing."},{"id":"semetey-1-2013:p1290:b004:l004","ordinal":175658,"en":"The heart flinched at the sight;"},{"id":"semetey-1-2013:p1290:b004:l005","ordinal":175659,"en":"The Zhediger were overcome."},{"id":"semetey-1-2013:p1290:b004:l006","ordinal":175660,"en":"In his right hand the battle-axe"},{"id":"semetey-1-2013:p1290:b004:l007","ordinal":175661,"en":"Shone as though struck by moonlight."},{"id":"semetey-1-2013:p1290:b004:l008","ordinal":175662,"en":"When he came up onto the pass,"},{"id":"semetey-1-2013:p1290:b004:l009","ordinal":175663,"en":"The valiant hero appeared in full."},{"id":"semetey-1-2013:p1290:b004:l010","ordinal":175664,"en":"A black-mottled leopard"},{"id":"semetey-1-2013:p1290:b004:l011","ordinal":175665,"en":"Raged at his flank."},{"id":"semetey-1-2013:p1290:b004:l012","ordinal":175666,"en":"The watching Zhediger cried,"},{"id":"semetey-1-2013:p1290:b004:l013","ordinal":175667,"en":"\"Accursed day, now we are dead!\""},{"id":"semetey-1-2013:p1290:b004:l014","ordinal":175668,"en":"And prepared themselves for death."},{"id":"semetey-1-2013:p1290:b004:l015","ordinal":175669,"en":"The poor people lost heart,"},{"id":"semetey-1-2013:p1290:b004:l016","ordinal":175670,"en":"Their eyes darting wildly;"},{"id":"semetey-1-2013:p1290:b004:l017","ordinal":175671,"en":"Saying, \"No mortal can be like this,\""},{"id":"semetey-1-2013:p1290:b004:l018","ordinal":175672,"en":"Their joints went slack."},{"id":"semetey-1-2013:p1290:b004:l019","ordinal":175673,"en":"A lion with a cropped blue mane"},{"id":"semetey-1-2013:p1290:b004:l020","ordinal":175674,"en":"Made ready at his right side;"},{"id":"semetey-1-2013:p1290:b004:l021","ordinal":175675,"en":"The Forty Chiltens and Khizr Niyaz"},{"id":"semetey-1-2013:p1290:b004:l022","ordinal":175676,"en":"Became an army of forty-two thousand,"},{"id":"semetey-1-2013:p1290:b004:l023","ordinal":175677,"en":"Closing in from every side."},{"id":"semetey-1-2013:p1290:b004:l024","ordinal":175678,"en":"The giant black bird Zymyrik"},{"id":"semetey-1-2013:p1290:b004:l025","ordinal":175679,"en":"Stretched out its feet"},{"id":"semetey-1-2013:p1290:b004:l026","ordinal":175680,"en":"As though about to carry them away."},{"id":"semetey-1-2013:p1290:b004:l027","ordinal":175681,"en":"\"His spiritual support is exceedingly strong;"},{"id":"semetey-1-2013:p1290:b004:l028","ordinal":175682,"en":"If he moves, he will reach us."},{"id":"semetey-1-2013:p1290:b004:l029","ordinal":175683,"en":"We are a people without guilt;"},{"id":"semetey-1-2013:p1290:b004:l030","ordinal":175684,"en":"Will he ignore the guilty"},{"id":"semetey-1-2013:p1290:b004:l031","ordinal":175685,"en":"And destroy us instead?\" they said."},{"id":"semetey-1-2013:p1290:b004:l032","ordinal":175686,"en":"The Zhediger stood trembling,"},{"id":"semetey-1-2013:p1290:b004:l033","ordinal":175687,"en":"Suffering and grieving."},{"id":"semetey-1-2013:p1290:b004:l034","ordinal":175688,"en":"Semetey, son of Manas,"},{"id":"semetey-1-2013:p1290:b004:l035","ordinal":175689,"en":"Raised the pale-mottled banner,"},{"id":"semetey-1-2013:p1290:b004:l036","ordinal":175690,"en":"Shouted the cry of \"Khan Manas!\""},{"id":"semetey-1-2013:p1290:b004:l037","ordinal":175691,"en":"And, paying no heed to the great host,"},{"id":"semetey-1-2013:p1290:b004:l038","ordinal":175692,"en":"Had drawn aside."},{"id":"semetey-1-2013:p1290:b004:l039","ordinal":175693,"en":"Kojo, son of Shygai,"},{"id":"semetey-1-2013:p1291:b003:l001","ordinal":175694,"en":"The lion-prince then"},{"id":"semetey-1-2013:p1291:b003:l002","ordinal":175695,"en":"Had come face-to-face with him."},{"id":"semetey-1-2013:p1291:b003:l003","ordinal":175696,"en":"It was time for him to grow wrathful"},{"id":"semetey-1-2013:p1291:b003:l004","ordinal":175697,"en":"And stand firm amid upheaval."},{"id":"semetey-1-2013:p1291:b003:l005","ordinal":175698,"en":"It was time for your bloodthirsty hero"},{"id":"semetey-1-2013:p1291:b003:l006","ordinal":175699,"en":"And Khan Kojo to fight."},{"id":"semetey-1-2013:p1291:b003:l007","ordinal":175700,"en":"It was time to encounter"},{"id":"semetey-1-2013:p1291:b003:l008","ordinal":175701,"en":"The decree laid down by God."},{"id":"semetey-1-2013:p1291:b003:l009","ordinal":175702,"en":"It was time for Kojo and Semetey"},{"id":"semetey-1-2013:p1291:b003:l010","ordinal":175703,"en":"To fight to the death."},{"id":"semetey-1-2013:p1291:b003:l011","ordinal":175704,"en":"It was time to tear apart"},{"id":"semetey-1-2013:p1291:b003:l012","ordinal":175705,"en":"The folds of one another's ribs,"},{"id":"semetey-1-2013:p1291:b003:l013","ordinal":175706,"en":"And spill the dark blood"},{"id":"semetey-1-2013:p1291:b003:l014","ordinal":175707,"en":"Within their chests."},{"id":"semetey-1-2013:p1291:b003:l015","ordinal":175708,"en":"The kasaba banner floated in his hand;"},{"id":"semetey-1-2013:p1291:b003:l016","ordinal":175709,"en":"The inlaid spear leveled at the enemy"},{"id":"semetey-1-2013:p1291:b003:l017","ordinal":175710,"en":"Gleamed in his right hand."},{"id":"semetey-1-2013:p1291:b003:l018","ordinal":175711,"en":"Arbuurul flew like an arrow,"},{"id":"semetey-1-2013:p1291:b003:l019","ordinal":175712,"en":"Rearing and bounding in frenzy,"},{"id":"semetey-1-2013:p1291:b003:l020","ordinal":175713,"en":"Striding and straining forward."},{"id":"semetey-1-2013:p1291:b003:l021","ordinal":175714,"en":"Tossing his forelock to the sky,"},{"id":"semetey-1-2013:p1291:b003:l022","ordinal":175715,"en":"Driving his hooves into the earth,"},{"id":"semetey-1-2013:p1291:b003:l023","ordinal":175716,"en":"He moved in eager agitation,"},{"id":"semetey-1-2013:p1291:b003:l024","ordinal":175717,"en":"Showing the form of a roe deer."},{"id":"semetey-1-2013:p1291:b003:l025","ordinal":175718,"en":"Semetey settled into his wrath;"},{"id":"semetey-1-2013:p1291:b003:l026","ordinal":175719,"en":"Khan Manas's Zulfiqar"},{"id":"semetey-1-2013:p1291:b003:l027","ordinal":175720,"en":"Hung fitted at his side."},{"id":"semetey-1-2013:p1291:b003:l028","ordinal":175721,"en":"Coming out over a saddle-backed pass,"},{"id":"semetey-1-2013:p1291:b003:l029","ordinal":175722,"en":"Semetey stood before Kojo"},{"id":"semetey-1-2013:p1291:b003:l030","ordinal":175723,"en":"And said this:"},{"id":"semetey-1-2013:p1291:b003:l031","ordinal":175724,"en":"\"Should the prince himself"},{"id":"semetey-1-2013:p1291:b003:l032","ordinal":175725,"en":"Go about as a fugitive?"},{"id":"semetey-1-2013:p1291:b003:l033","ordinal":175726,"en":"When your khan has fled,"},{"id":"semetey-1-2013:p1291:b003:l034","ordinal":175727,"en":"Should he abandon his people?"},{"id":"semetey-1-2013:p1291:b003:l035","ordinal":175728,"en":"Should the nobleman himself,"},{"id":"semetey-1-2013:p1291:b003:l036","ordinal":175729,"en":"Parted from his renowned people,"},{"id":"semetey-1-2013:p1291:b003:l037","ordinal":175730,"en":"Go wandering in flight?"},{"id":"semetey-1-2013:p1291:b003:l038","ordinal":175731,"en":"O Chynkojo, khan-uncle,"},{"id":"semetey-1-2013:p1291:b003:l039","ordinal":175732,"en":"Do not turn your intentions elsewhere;"},{"id":"semetey-1-2013:p1291:b005:l001","ordinal":175733,"en":"Receive your Argyn people in Talas."},{"id":"semetey-1-2013:p1291:b005:l002","ordinal":175734,"en":"You have courage, braggart—"},{"id":"semetey-1-2013:p1291:b005:l003","ordinal":175735,"en":"Will you not win a name among the people?"},{"id":"semetey-1-2013:p1291:b005:l004","ordinal":175736,"en":"You commoner estranged from your folk."},{"id":"semetey-1-2013:p1291:b005:l005","ordinal":175737,"en":"Can one who wanders apart from his people"},{"id":"semetey-1-2013:p1291:b005:l006","ordinal":175738,"en":"Ever come to good?"},{"id":"semetey-1-2013:p1291:b005:l007","ordinal":175739,"en":"Is it proper conduct"},{"id":"semetey-1-2013:p1291:b005:l008","ordinal":175740,"en":"For your khan to wander?"},{"id":"semetey-1-2013:p1291:b005:l009","ordinal":175741,"en":"Can one call a wanderer like you"},{"id":"semetey-1-2013:p1291:b005:l010","ordinal":175742,"en":"A good man?"},{"id":"semetey-1-2013:p1291:b005:l011","ordinal":175743,"en":"Let me offer you livestock;"},{"id":"semetey-1-2013:p1291:b005:l012","ordinal":175744,"en":"If your grievance departs, Chynkojo,"},{"id":"semetey-1-2013:p1291:b005:l013","ordinal":175745,"en":"Take my fourteen swift horses,"},{"id":"semetey-1-2013:p1291:b005:l014","ordinal":175746,"en":"Take my sword-beaked elephant,"},{"id":"semetey-1-2013:p1291:b005:l015","ordinal":175747,"en":"My precious Kojo, heed my words!\""},{"id":"semetey-1-2013:p1291:b005:l016","ordinal":175748,"en":"Before he could turn Buurul's mouth,"},{"id":"semetey-1-2013:p1291:b005:l017","ordinal":175749,"en":"While he was still saying this,"},{"id":"semetey-1-2013:p1291:b005:l018","ordinal":175750,"en":"God now struck Kojo;"},{"id":"semetey-1-2013:p1291:b005:l019","ordinal":175751,"en":"His wrathful fury arose."},{"id":"semetey-1-2013:p1291:b005:l020","ordinal":175752,"en":"Calling him \"Manas's orphan son,\""},{"id":"semetey-1-2013:p1291:b005:l021","ordinal":175753,"en":"Chynkojo, son of Shygai,"},{"id":"semetey-1-2013:p1291:b005:l022","ordinal":175754,"en":"Raged like a blue tiger."},{"id":"semetey-1-2013:p1291:b005:l023","ordinal":175755,"en":"As though calamity had struck his wife,"},{"id":"semetey-1-2013:p1291:b005:l024","ordinal":175756,"en":"As though the pursuer were close behind,"},{"id":"semetey-1-2013:p1291:b005:l025","ordinal":175757,"en":"As though he were close upon his quarry,"},{"id":"semetey-1-2013:p1291:b005:l026","ordinal":175758,"en":"Kojo went mad then,"},{"id":"semetey-1-2013:p1291:b005:l027","ordinal":175759,"en":"As though his wife had borne a son."},{"id":"semetey-1-2013:p1291:b005:l028","ordinal":175760,"en":"Wrapping himself in his bulletproof coat,"},{"id":"semetey-1-2013:p1291:b005:l029","ordinal":175761,"en":"Ruinous Kojo prepared"},{"id":"semetey-1-2013:p1291:b005:l030","ordinal":175762,"en":"As though to overturn him."},{"id":"semetey-1-2013:p1291:b005:l031","ordinal":175763,"en":"He bit crosswise through the saddle;"},{"id":"semetey-1-2013:p1291:b005:l032","ordinal":175764,"en":"Utterly without public spirit,"},{"id":"semetey-1-2013:p1291:b005:l033","ordinal":175765,"en":"Chynkojo, son of Shygai,"},{"id":"semetey-1-2013:p1291:b005:l034","ordinal":175766,"en":"Was seized by his bloodthirsty nature:"},{"id":"semetey-1-2013:p1291:b005:l035","ordinal":175767,"en":"When roused, his venom was strong;"},{"id":"semetey-1-2013:p1291:b005:l036","ordinal":175768,"en":"This Kojo, son of Shygai,"},{"id":"semetey-1-2013:p1291:b005:l037","ordinal":175769,"en":"Laid flat whoever challenged him."},{"id":"semetey-1-2013:p1291:b005:l038","ordinal":175770,"en":"He settled a cast-iron club, house-sized,"},{"id":"semetey-1-2013:p1291:b005:l039","ordinal":175771,"en":"Across his back,"},{"id":"semetey-1-2013:p1292:b003:l001","ordinal":175772,"en":"Like a cloud about to rain again,"},{"id":"semetey-1-2013:p1292:b003:l002","ordinal":175773,"en":"His face turned wrathful."},{"id":"semetey-1-2013:p1292:b003:l003","ordinal":175774,"en":"He had no intention of making peace;"},{"id":"semetey-1-2013:p1292:b003:l004","ordinal":175775,"en":"If Kojo got him into his hands,"},{"id":"semetey-1-2013:p1292:b003:l005","ordinal":175776,"en":"He looked unlikely to leave him alive."},{"id":"semetey-1-2013:p1292:b003:l006","ordinal":175777,"en":"Look at the madman—"},{"id":"semetey-1-2013:p1292:b003:l007","ordinal":175778,"en":"Fit to be offered as a sacrifice;"},{"id":"semetey-1-2013:p1292:b003:l008","ordinal":175779,"en":"If spared because he was kin,"},{"id":"semetey-1-2013:p1292:b003:l009","ordinal":175780,"en":"He looked ready to cut off a head."},{"id":"semetey-1-2013:p1292:b003:l010","ordinal":175781,"en":"Kojo stood seething,"},{"id":"semetey-1-2013:p1292:b003:l011","ordinal":175782,"en":"Speaking to Semetey:"},{"id":"semetey-1-2013:p1292:b003:l012","ordinal":175783,"en":"\"That is a dark road from which none return,"},{"id":"semetey-1-2013:p1292:b003:l013","ordinal":175784,"en":"The road you have traveled halfway."},{"id":"semetey-1-2013:p1292:b003:l014","ordinal":175785,"en":"That was the host that deceived"},{"id":"semetey-1-2013:p1292:b003:l015","ordinal":175786,"en":"Your broad-chested father Manas six times."},{"id":"semetey-1-2013:p1292:b003:l016","ordinal":175787,"en":"Orphaned of your father,"},{"id":"semetey-1-2013:p1292:b003:l017","ordinal":175788,"en":"You are the one who wandered away"},{"id":"semetey-1-2013:p1292:b003:l018","ordinal":175789,"en":"To Temir Khan's city."},{"id":"semetey-1-2013:p1292:b003:l019","ordinal":175790,"en":"I am the one who grappled"},{"id":"semetey-1-2013:p1292:b003:l020","ordinal":175791,"en":"With your father Manas the lion."},{"id":"semetey-1-2013:p1292:b003:l021","ordinal":175792,"en":"Now my anger has risen and I stand enraged;"},{"id":"semetey-1-2013:p1292:b003:l022","ordinal":175793,"en":"I shall seize your migration from Talas,"},{"id":"semetey-1-2013:p1292:b003:l023","ordinal":175794,"en":"My orphan, son of Manas,"},{"id":"semetey-1-2013:p1292:b003:l024","ordinal":175795,"en":"And take my vengeance by crushing you."},{"id":"semetey-1-2013:p1292:b003:l025","ordinal":175796,"en":"You raided my migration from Keng-Kol;"},{"id":"semetey-1-2013:p1292:b003:l026","ordinal":175797,"en":"This year I shall avenge myself"},{"id":"semetey-1-2013:p1292:b003:l027","ordinal":175798,"en":"Upon those accursed slaves."},{"id":"semetey-1-2013:p1292:b003:l028","ordinal":175799,"en":"Into my palace like a white gull"},{"id":"semetey-1-2013:p1292:b003:l029","ordinal":175800,"en":"You brought Khan Bakai;"},{"id":"semetey-1-2013:p1292:b003:l030","ordinal":175801,"en":"The uncatchable Kara At"},{"id":"semetey-1-2013:p1292:b003:l031","ordinal":175802,"en":"You had seized, Semetey,"},{"id":"semetey-1-2013:p1292:b003:l032","ordinal":175803,"en":"And made slaves ride it bareback."},{"id":"semetey-1-2013:p1292:b003:l033","ordinal":175804,"en":"The line you drew at Keng-Kol,"},{"id":"semetey-1-2013:p1292:b003:l034","ordinal":175805,"en":"The spectacle you showed me yesterday—"},{"id":"semetey-1-2013:p1292:b003:l035","ordinal":175806,"en":"You have come to behold"},{"id":"semetey-1-2013:p1292:b003:l036","ordinal":175807,"en":"The torments of Judgment Day,"},{"id":"semetey-1-2013:p1292:b003:l037","ordinal":175808,"en":"Accursed Semetey;"},{"id":"semetey-1-2013:p1292:b003:l038","ordinal":175809,"en":"You have come to die"},{"id":"semetey-1-2013:p1292:b003:l039","ordinal":175810,"en":"At the hands of mighty me."},{"id":"semetey-1-2013:p1292:b004:l001","ordinal":175811,"en":"When I hear that you have camped at Talas,"},{"id":"semetey-1-2013:p1292:b004:l002","ordinal":175812,"en":"Accursed one, I shall seize"},{"id":"semetey-1-2013:p1292:b004:l003","ordinal":175813,"en":"Your wife Aichürök."},{"id":"semetey-1-2013:p1292:b004:l004","ordinal":175814,"en":"Upon Buurul, not yielded when asked,"},{"id":"semetey-1-2013:p1292:b004:l005","ordinal":175815,"en":"I shall cast a cold lasso;"},{"id":"semetey-1-2013:p1292:b004:l006","ordinal":175816,"en":"Taibuurul, not yielded when begged for,"},{"id":"semetey-1-2013:p1292:b004:l007","ordinal":175817,"en":"I shall take bareback as booty."},{"id":"semetey-1-2013:p1292:b004:l008","ordinal":175818,"en":"I shall bring splendid slaughter;"},{"id":"semetey-1-2013:p1292:b004:l009","ordinal":175819,"en":"You have greatly provoked my rage,"},{"id":"semetey-1-2013:p1292:b004:l010","ordinal":175820,"en":"And I shall cut off your head."},{"id":"semetey-1-2013:p1292:b004:l011","ordinal":175821,"en":"I shall drag you along the road"},{"id":"semetey-1-2013:p1292:b004:l012","ordinal":175822,"en":"And expose you to the Dangyts!"},{"id":"semetey-1-2013:p1292:b004:l013","ordinal":175823,"en":"I hear that you are my kinsman,"},{"id":"semetey-1-2013:p1292:b004:l014","ordinal":175824,"en":"Accursed Semetey;"},{"id":"semetey-1-2013:p1292:b004:l015","ordinal":175825,"en":"I shall kill and bury you,"},{"id":"semetey-1-2013:p1292:b004:l016","ordinal":175826,"en":"And seize your slaves!\""},{"id":"semetey-1-2013:p1292:b004:l017","ordinal":175827,"en":"The earth split with a roar;"},{"id":"semetey-1-2013:p1292:b004:l018","ordinal":175828,"en":"Kojo raged and thundered."},{"id":"semetey-1-2013:p1292:b004:l019","ordinal":175829,"en":"God now struck Kojo,"},{"id":"semetey-1-2013:p1292:b004:l020","ordinal":175830,"en":"And he spoke words of great humiliation."},{"id":"semetey-1-2013:p1292:b004:l021","ordinal":175831,"en":"He stood bald and stark,"},{"id":"semetey-1-2013:p1292:b004:l022","ordinal":175832,"en":"Like a post for tethering horses;"},{"id":"semetey-1-2013:p1292:b004:l023","ordinal":175833,"en":"This Kojo had abandoned the faith"},{"id":"semetey-1-2013:p1292:b004:l024","ordinal":175834,"en":"And become an infidel."},{"id":"semetey-1-2013:p1292:b004:l025","ordinal":175835,"en":"He began a grievous humiliation,"},{"id":"semetey-1-2013:p1292:b004:l026","ordinal":175836,"en":"And was capable of carrying it through;"},{"id":"semetey-1-2013:p1292:b004:l027","ordinal":175837,"en":"Plainly, Kojo was capable"},{"id":"semetey-1-2013:p1292:b004:l028","ordinal":175838,"en":"Of inflicting everlasting humiliation"},{"id":"semetey-1-2013:p1292:b004:l029","ordinal":175839,"en":"Upon the valiant hero."},{"id":"semetey-1-2013:p1292:b004:l030","ordinal":175840,"en":"If Kojo got into his hands"},{"id":"semetey-1-2013:p1292:b004:l031","ordinal":175841,"en":"The orphaned son of Manas,"},{"id":"semetey-1-2013:p1292:b004:l032","ordinal":175842,"en":"He was capable of slaughtering him"},{"id":"semetey-1-2013:p1292:b004:l033","ordinal":175843,"en":"As a sacrifice without hesitation."},{"id":"semetey-1-2013:p1292:b004:l034","ordinal":175844,"en":"He left no honest soul in peace;"},{"id":"semetey-1-2013:p1292:b004:l035","ordinal":175845,"en":"Kojo the kinsman came to no good."},{"id":"semetey-1-2013:p1292:b004:l036","ordinal":175846,"en":"Dear Kojo the kinsman"},{"id":"semetey-1-2013:p1292:b004:l037","ordinal":175847,"en":"Had crookedness in his words"},{"id":"semetey-1-2013:p1292:b004:l038","ordinal":175848,"en":"And cloudiness in his eyes;"},{"id":"semetey-1-2013:p1292:b004:l039","ordinal":175849,"en":"If your uncle Kojo found the strength,"},{"id":"semetey-1-2013:p1293:b003:l001","ordinal":175850,"en":"He was about to strike me down."},{"id":"semetey-1-2013:p1293:b003:l002","ordinal":175851,"en":"There was malice in his words,"},{"id":"semetey-1-2013:p1293:b003:l003","ordinal":175852,"en":"Crookedness in his eyes;"},{"id":"semetey-1-2013:p1293:b003:l004","ordinal":175853,"en":"If I came within his reach,"},{"id":"semetey-1-2013:p1293:b003:l005","ordinal":175854,"en":"He intended to do me harm."},{"id":"semetey-1-2013:p1293:b003:l006","ordinal":175855,"en":"No iron is keen unless it is tempered,"},{"id":"semetey-1-2013:p1293:b003:l007","ordinal":175856,"en":"No accursed people thrive unless raised apart;"},{"id":"semetey-1-2013:p1293:b003:l008","ordinal":175857,"en":"No iron is keen unless it is forged,"},{"id":"semetey-1-2013:p1293:b003:l009","ordinal":175858,"en":"No people are like raging Khojo’s."},{"id":"semetey-1-2013:p1293:b003:l010","ordinal":175859,"en":"An uproar arose ahead;"},{"id":"semetey-1-2013:p1293:b003:l011","ordinal":175860,"en":"That Khojo, not knowing what he said,"},{"id":"semetey-1-2013:p1293:b003:l012","ordinal":175861,"en":"Prepared as though to seize him."},{"id":"semetey-1-2013:p1293:b003:l013","ordinal":175862,"en":"Whipping his black horse,"},{"id":"semetey-1-2013:p1293:b003:l014","ordinal":175863,"en":"Roaring in fury,"},{"id":"semetey-1-2013:p1293:b003:l015","ordinal":175864,"en":"Khojo came then,"},{"id":"semetey-1-2013:p1293:b003:l016","ordinal":175865,"en":"Shouting the battle cry “Shygai!”"},{"id":"semetey-1-2013:p1293:b003:l017","ordinal":175866,"en":"Furiously he thundered;"},{"id":"semetey-1-2013:p1293:b003:l018","ordinal":175867,"en":"At Khojo’s terrible aspect,"},{"id":"semetey-1-2013:p1293:b003:l019","ordinal":175868,"en":"The whole free body"},{"id":"semetey-1-2013:p1293:b003:l020","ordinal":175869,"en":"Of anyone watching shuddered."},{"id":"semetey-1-2013:p1293:b003:l021","ordinal":175870,"en":"Semetey stood without concern:"},{"id":"semetey-1-2013:p1293:b003:l022","ordinal":175871,"en":"“Chynkojo was my kinsman—"},{"id":"semetey-1-2013:p1293:b003:l023","ordinal":175872,"en":"Let him level his spear straight at me;"}]
