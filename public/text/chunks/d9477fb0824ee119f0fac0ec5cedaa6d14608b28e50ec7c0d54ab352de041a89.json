[{"id":"semetey-1-2013:p0932:b003:l031","ordinal":148225,"en":"To Toltoy of the Zhediger"},{"id":"semetey-1-2013:p0932:b003:l032","ordinal":148226,"en":"I shall go and pitch my camp."},{"id":"semetey-1-2013:p0932:b003:l033","ordinal":148227,"en":"Fighting for seven years without pause,"},{"id":"semetey-1-2013:p0932:b003:l034","ordinal":148228,"en":"I shall slaughter Semetey!"},{"id":"semetey-1-2013:p0932:b003:l035","ordinal":148229,"en":"Bagysh's son Toltoy"},{"id":"semetey-1-2013:p0932:b003:l036","ordinal":148230,"en":"I shall fasten at my waist as support."},{"id":"semetey-1-2013:p0932:b003:l037","ordinal":148231,"en":"The orphan who thinks himself a champion"},{"id":"semetey-1-2013:p0932:b003:l038","ordinal":148232,"en":"I shall slaughter with his slaves."},{"id":"semetey-1-2013:p0932:b003:l039","ordinal":148233,"en":"Shattering his stone fortress,"},{"id":"semetey-1-2013:p0932:b004:l001","ordinal":148234,"en":"I shall raid it utterly."},{"id":"semetey-1-2013:p0932:b004:l002","ordinal":148235,"en":"I shall bring devastation,"},{"id":"semetey-1-2013:p0932:b004:l003","ordinal":148236,"en":"Shatter his great multitude,"},{"id":"semetey-1-2013:p0932:b004:l004","ordinal":148237,"en":"And sweep down in a raid."},{"id":"semetey-1-2013:p0932:b004:l005","ordinal":148238,"en":"Pitching my camp beside Toltoy,"},{"id":"semetey-1-2013:p0932:b004:l006","ordinal":148239,"en":"Stirring the stars in heaven,"},{"id":"semetey-1-2013:p0932:b004:l007","ordinal":148240,"en":"Becoming friends unto the next world,"},{"id":"semetey-1-2013:p0932:b004:l008","ordinal":148241,"en":"Tying our horses' tails for battle,"},{"id":"semetey-1-2013:p0932:b004:l009","ordinal":148242,"en":"Driving our foes this way and that,"},{"id":"semetey-1-2013:p0932:b004:l010","ordinal":148243,"en":"Until the blazing heat retreats,"},{"id":"semetey-1-2013:p0932:b004:l011","ordinal":148244,"en":"Until the people move to lower lands,"},{"id":"semetey-1-2013:p0932:b004:l012","ordinal":148245,"en":"I shall fight without tiring."},{"id":"semetey-1-2013:p0932:b004:l013","ordinal":148246,"en":"From Manas's fugitive son"},{"id":"semetey-1-2013:p0932:b004:l014","ordinal":148247,"en":"Thus I shall take revenge!"},{"id":"semetey-1-2013:p0932:b004:l015","ordinal":148248,"en":"I have heard news from those who came."},{"id":"semetey-1-2013:p0932:b004:l016","ordinal":148249,"en":"When he returned this way,"},{"id":"semetey-1-2013:p0932:b004:l017","ordinal":148250,"en":"When he moved from Bukhara toward us,"},{"id":"semetey-1-2013:p0932:b004:l018","ordinal":148251,"en":"She was the hero Toltoy's wife:"},{"id":"semetey-1-2013:p0932:b004:l019","ordinal":148252,"en":"Shah Temir's Chachykei,"},{"id":"semetey-1-2013:p0932:b004:l020","ordinal":148253,"en":"I heard Semetey took her."},{"id":"semetey-1-2013:p0932:b004:l021","ordinal":148254,"en":"Would God strike Toltoy down?"},{"id":"semetey-1-2013:p0932:b004:l022","ordinal":148255,"en":"If I stirred him into revolt,"},{"id":"semetey-1-2013:p0932:b004:l023","ordinal":148256,"en":"Unless Toltoy were utterly wretched,"},{"id":"semetey-1-2013:p0932:b004:l024","ordinal":148257,"en":"Would he refrain from striking back!”"},{"id":"semetey-1-2013:p0932:b004:l025","ordinal":148258,"en":"Kozho moved his camp in fury,"},{"id":"semetey-1-2013:p0932:b004:l026","ordinal":148259,"en":"From his land at Kebez-Too."},{"id":"semetey-1-2013:p0932:b004:l027","ordinal":148260,"en":"An extraordinary strongman, a mighty hero,"},{"id":"semetey-1-2013:p0932:b004:l028","ordinal":148261,"en":"Chynkozho broke away"},{"id":"semetey-1-2013:p0932:b004:l029","ordinal":148262,"en":"From the familiar Oigut people."},{"id":"semetey-1-2013:p0932:b004:l030","ordinal":148263,"en":"What did dear Kozho do?"},{"id":"semetey-1-2013:p0932:b004:l031","ordinal":148264,"en":"He castrated his rams and made them wethers."},{"id":"semetey-1-2013:p0932:b004:l032","ordinal":148265,"en":"He made all his sheep large and fat."},{"id":"semetey-1-2013:p0932:b004:l033","ordinal":148266,"en":"He castrated his stallions and made them geldings."},{"id":"semetey-1-2013:p0932:b004:l034","ordinal":148267,"en":"Kozho swiftly brought suffering."},{"id":"semetey-1-2013:p0932:b004:l035","ordinal":148268,"en":"He castrated his bulls,"},{"id":"semetey-1-2013:p0932:b004:l036","ordinal":148269,"en":"And made them oxen, as you know."},{"id":"semetey-1-2013:p0932:b004:l037","ordinal":148270,"en":"All the subjects in his hands"},{"id":"semetey-1-2013:p0932:b004:l038","ordinal":148271,"en":"He made submit, leaving none out."},{"id":"semetey-1-2013:p0932:b004:l039","ordinal":148272,"en":"He castrated his camel bulls and made them gelded camels."},{"id":"semetey-1-2013:p0933:b003:l001","ordinal":148273,"en":"He left his warriors on foot."},{"id":"semetey-1-2013:p0933:b003:l002","ordinal":148274,"en":"He sold his possessions and turned them into sable pelts."},{"id":"semetey-1-2013:p0933:b003:l003","ordinal":148275,"en":"Taking offense at his kinsman,"},{"id":"semetey-1-2013:p0933:b003:l004","ordinal":148276,"en":"Dear Kozho raged,"},{"id":"semetey-1-2013:p0933:b003:l005","ordinal":148277,"en":"And did things no human would do."},{"id":"semetey-1-2013:p0933:b003:l006","ordinal":148278,"en":"At Kebez-Too were his subjects;"},{"id":"semetey-1-2013:p0933:b003:l007","ordinal":148279,"en":"He had so many people in his hands,"},{"id":"semetey-1-2013:p0933:b003:l008","ordinal":148280,"en":"And all his strongmen were there."},{"id":"semetey-1-2013:p0933:b003:l009","ordinal":148281,"en":"Kozho too was no ordinary hero;"},{"id":"semetey-1-2013:p0933:b003:l010","ordinal":148282,"en":"He had mighty men of many kinds."},{"id":"semetey-1-2013:p0933:b003:l011","ordinal":148283,"en":"Driving them all, Chynkozho said:"},{"id":"semetey-1-2013:p0933:b003:l012","ordinal":148284,"en":"“If Toltoy of the Zhediger"},{"id":"semetey-1-2013:p0933:b003:l013","ordinal":148285,"en":"Will not heed me when I arrive,"},{"id":"semetey-1-2013:p0933:b003:l014","ordinal":148286,"en":"Watch, you great multitude:"},{"id":"semetey-1-2013:p0933:b003:l015","ordinal":148287,"en":"I shall flood his gardens,"},{"id":"semetey-1-2013:p0933:b003:l016","ordinal":148288,"en":"Throw all he has into turmoil,"},{"id":"semetey-1-2013:p0933:b003:l017","ordinal":148289,"en":"And raid it all!"},{"id":"semetey-1-2013:p0933:b003:l018","ordinal":148290,"en":"Think, you great multitude!"},{"id":"semetey-1-2013:p0933:b003:l019","ordinal":148291,"en":"His Talas is no superior land;"},{"id":"semetey-1-2013:p0933:b003:l020","ordinal":148292,"en":"Manas's fugitive is no greater hero than I."},{"id":"semetey-1-2013:p0933:b003:l021","ordinal":148293,"en":"Shygai's son Chynkozho"},{"id":"semetey-1-2013:p0933:b003:l022","ordinal":148294,"en":"Is inferior to none in the world."},{"id":"semetey-1-2013:p0933:b003:l023","ordinal":148295,"en":"If I pitch my camp beside Toltoy"},{"id":"semetey-1-2013:p0933:b003:l024","ordinal":148296,"en":"And do not gather his army,"},{"id":"semetey-1-2013:p0933:b003:l025","ordinal":148297,"en":"If I do not inflict grievous humiliation,"},{"id":"semetey-1-2013:p0933:b003:l026","ordinal":148298,"en":"Better that I had never been born;"},{"id":"semetey-1-2013:p0933:b003:l027","ordinal":148299,"en":"May I die instead of living!”"},{"id":"semetey-1-2013:p0933:b003:l028","ordinal":148300,"en":"Kozho shouted these words,"},{"id":"semetey-1-2013:p0933:b003:l029","ordinal":148301,"en":"Spoke of unheard-of horrors,"},{"id":"semetey-1-2013:p0933:b003:l030","ordinal":148302,"en":"And tormented the peaceful people."},{"id":"semetey-1-2013:p0933:b004:l001","ordinal":148303,"en":"The poor people in his hands—"},{"id":"semetey-1-2013:p0933:b004:l002","ordinal":148304,"en":"He extinguished their burning hearths,"},{"id":"semetey-1-2013:p0933:b004:l003","ordinal":148305,"en":"Made every one of them migrate,"},{"id":"semetey-1-2013:p0933:b004:l004","ordinal":148306,"en":"Drove their beasts into a frenzy,"},{"id":"semetey-1-2013:p0933:b004:l005","ordinal":148307,"en":"And made their girls and women weep."},{"id":"semetey-1-2013:p0933:b004:l006","ordinal":148308,"en":"Chynkozho moved his camp along."},{"id":"semetey-1-2013:p0933:b004:l007","ordinal":148309,"en":"Oppressing them, Chynkozho"},{"id":"semetey-1-2013:p0933:b004:l008","ordinal":148310,"en":"All the great multitude"},{"id":"semetey-1-2013:p0933:b004:l009","ordinal":148311,"en":"Drove before him, towering over them."},{"id":"semetey-1-2013:p0933:b004:l010","ordinal":148312,"en":"To that devilish woman,"},{"id":"semetey-1-2013:p0933:b004:l011","ordinal":148313,"en":"He inflicted humiliation upon those people."},{"id":"semetey-1-2013:p0933:b004:l012","ordinal":148314,"en":"Driving them all under guard,"},{"id":"semetey-1-2013:p0933:b004:l013","ordinal":148315,"en":"He migrated for months and years."},{"id":"semetey-1-2013:p0933:b004:l014","ordinal":148316,"en":"To Toltoy of the Zhediger—"},{"id":"semetey-1-2013:p0933:b004:l015","ordinal":148317,"en":"What did dear Kozho do?"},{"id":"semetey-1-2013:p0933:b004:l016","ordinal":148318,"en":"He reached him at last."},{"id":"semetey-1-2013:p0933:b004:l017","ordinal":148319,"en":"Your wrathful Kozho"},{"id":"semetey-1-2013:p0933:b004:l018","ordinal":148320,"en":"Had a black fur cap like a cauldron."},{"id":"semetey-1-2013:p0933:b004:l019","ordinal":148321,"en":"The eighteen thousand worlds"},{"id":"semetey-1-2013:p0933:b004:l020","ordinal":148322,"en":"He had the power to suck dry at once."},{"id":"semetey-1-2013:p0933:b004:l021","ordinal":148323,"en":"Your elder brother, Lord Kozho—"},{"id":"semetey-1-2013:p0933:b004:l022","ordinal":148324,"en":"Look at these deeds of his."},{"id":"semetey-1-2013:p0933:b004:l023","ordinal":148325,"en":"To the Zhediger people,"},{"id":"semetey-1-2013:p0933:b004:l024","ordinal":148326,"en":"A mighty man came, a pillar came."},{"id":"semetey-1-2013:p0933:b004:l025","ordinal":148327,"en":"Of an appearance unlike other mortals,"},{"id":"semetey-1-2013:p0933:b004:l026","ordinal":148328,"en":"The renowned lion Kozho came."},{"id":"semetey-1-2013:p0933:b004:l027","ordinal":148329,"en":"Upon the hero Toltoy's head"},{"id":"semetey-1-2013:p0933:b004:l028","ordinal":148330,"en":"A standard as great as Mount Opol came."},{"id":"semetey-1-2013:p0933:b004:l029","ordinal":148331,"en":"Upon the people's heads"},{"id":"semetey-1-2013:p0933:b004:l030","ordinal":148332,"en":"An unending tumult came."},{"id":"semetey-1-2013:p0934:b004:l001","ordinal":148333,"en":"The great mass of common people"},{"id":"semetey-1-2013:p0934:b004:l002","ordinal":148334,"en":"Spoke these words in sorrow,"},{"id":"semetey-1-2013:p0934:b004:l003","ordinal":148335,"en":"Their white-bearded elders,"},{"id":"semetey-1-2013:p0934:b004:l004","ordinal":148336,"en":"All the Zhediger:"},{"id":"semetey-1-2013:p0934:b004:l005","ordinal":148337,"en":"“He has come as a subject."},{"id":"semetey-1-2013:p0934:b004:l006","ordinal":148338,"en":"The gray-maned hero Kozho"},{"id":"semetey-1-2013:p0934:b004:l007","ordinal":148339,"en":"We have seen with our own eyes,"},{"id":"semetey-1-2013:p0934:b004:l008","ordinal":148340,"en":"That unbeliever full of devils."},{"id":"semetey-1-2013:p0934:b004:l009","ordinal":148341,"en":"The hero Toltoy was mild;"},{"id":"semetey-1-2013:p0934:b004:l010","ordinal":148342,"en":"Kozho will take power,"},{"id":"semetey-1-2013:p0934:b004:l011","ordinal":148343,"en":"And afflict us with incurable sorrow."},{"id":"semetey-1-2013:p0934:b004:l012","ordinal":148344,"en":"Chynkozho has pitched his camp."},{"id":"semetey-1-2013:p0934:b004:l013","ordinal":148345,"en":"If you live, you will see:"},{"id":"semetey-1-2013:p0934:b004:l014","ordinal":148346,"en":"He will devise many reckonings,"},{"id":"semetey-1-2013:p0934:b004:l015","ordinal":148347,"en":"And shake much dust out of us."},{"id":"semetey-1-2013:p0934:b004:l016","ordinal":148348,"en":"We were a thoroughly peaceful people."},{"id":"semetey-1-2013:p0934:b004:l017","ordinal":148349,"en":"That accursed Chynkozho,"},{"id":"semetey-1-2013:p0934:b004:l018","ordinal":148350,"en":"Bullying and driving us onward,"},{"id":"semetey-1-2013:p0934:b004:l019","ordinal":148351,"en":"Will slaughter us to the last."},{"id":"semetey-1-2013:p0934:b004:l020","ordinal":148352,"en":"May he sink into the earth! Will he not"},{"id":"semetey-1-2013:p0934:b004:l021","ordinal":148353,"en":"Bear the guilt for these people?"},{"id":"semetey-1-2013:p0934:b004:l022","ordinal":148354,"en":"Have you seen Kozho?"},{"id":"semetey-1-2013:p0934:b004:l023","ordinal":148355,"en":"His words are jagged and rough."},{"id":"semetey-1-2013:p0934:b004:l024","ordinal":148356,"en":"When hardship fell upon his thimble-sized head,"},{"id":"semetey-1-2013:p0934:b004:l025","ordinal":148357,"en":"His hand hung limp,"},{"id":"semetey-1-2013:p0934:b004:l026","ordinal":148358,"en":"It seems he came here in this state."},{"id":"semetey-1-2013:p0934:b004:l027","ordinal":148359,"en":"He speaks with great boasting;"},{"id":"semetey-1-2013:p0934:b004:l028","ordinal":148360,"en":"Having grappled with some hero,"},{"id":"semetey-1-2013:p0934:b004:l029","ordinal":148361,"en":"It seems he arrived worn out."},{"id":"semetey-1-2013:p0934:b004:l030","ordinal":148362,"en":"Our khan Toltoy, the leopard,"},{"id":"semetey-1-2013:p0934:b004:l031","ordinal":148363,"en":"We talked a lot,"},{"id":"semetey-1-2013:p0934:b004:l032","ordinal":148364,"en":"Will heed this Kozho's words,"},{"id":"semetey-1-2013:p0934:b004:l033","ordinal":148365,"en":"And subject these people to oppression,"},{"id":"semetey-1-2013:p0934:b004:l034","ordinal":148366,"en":"Slaughtering them to the last."},{"id":"semetey-1-2013:p0934:b004:l035","ordinal":148367,"en":"The stooping old and the tender young—"},{"id":"semetey-1-2013:p0934:b005:l001","ordinal":148368,"en":"He will bear the guilt for them!”"},{"id":"semetey-1-2013:p0934:b005:l002","ordinal":148369,"en":"The people spoke thus and fell silent,"},{"id":"semetey-1-2013:p0934:b005:l003","ordinal":148370,"en":"Cursing one another."},{"id":"semetey-1-2013:p0934:b005:l004","ordinal":148371,"en":"Chynkozho came to Toltoy,"},{"id":"semetey-1-2013:p0934:b005:l005","ordinal":148372,"en":"And became a renowned khan,"},{"id":"semetey-1-2013:p0934:b005:l006","ordinal":148373,"en":"And became an influential man."},{"id":"semetey-1-2013:p0934:b005:l007","ordinal":148374,"en":"Than the hero Toltoy himself,"},{"id":"semetey-1-2013:p0934:b005:l008","ordinal":148375,"en":"He became a mightier khan."},{"id":"semetey-1-2013:p0934:b005:l009","ordinal":148376,"en":"Kozho and the hero Toltoy,"},{"id":"semetey-1-2013:p0934:b005:l010","ordinal":148377,"en":"Tolok and Tolobai,"},{"id":"semetey-1-2013:p0934:b005:l011","ordinal":148378,"en":"Kalcha and Kadyrbai—"},{"id":"semetey-1-2013:p0934:b005:l012","ordinal":148379,"en":"Of the Zhediger people,"},{"id":"semetey-1-2013:p0934:b005:l013","ordinal":148380,"en":"These six were the foremost,"},{"id":"semetey-1-2013:p0934:b005:l014","ordinal":148381,"en":"Their shamans who struck with lungs,"},{"id":"semetey-1-2013:p0934:b005:l015","ordinal":148382,"en":"Their noblemen who raised them up,"},{"id":"semetey-1-2013:p0934:b005:l016","ordinal":148383,"en":"Their heroes among spearmen,"},{"id":"semetey-1-2013:p0934:b005:l017","ordinal":148384,"en":"Their champions who swung battle-axes."},{"id":"semetey-1-2013:p0934:b005:l018","ordinal":148385,"en":"These six joined together."},{"id":"semetey-1-2013:p0934:b005:l019","ordinal":148386,"en":"Like flour of white wheat,"},{"id":"semetey-1-2013:p0934:b005:l020","ordinal":148387,"en":"They were kneaded into one."},{"id":"semetey-1-2013:p0934:b005:l021","ordinal":148388,"en":"Like hairs of a white saiga,"},{"id":"semetey-1-2013:p0934:b005:l022","ordinal":148389,"en":"They became friends of one heart."},{"id":"semetey-1-2013:p0934:b005:l023","ordinal":148390,"en":"They swore an oath unto death,"},{"id":"semetey-1-2013:p0934:b005:l024","ordinal":148391,"en":"And made their promise binding:"},{"id":"semetey-1-2013:p0934:b005:l025","ordinal":148392,"en":"To pursue claims together,"},{"id":"semetey-1-2013:p0934:b005:l026","ordinal":148393,"en":"To fight enemies together,"},{"id":"semetey-1-2013:p0934:b005:l027","ordinal":148394,"en":"To wage battle together,"},{"id":"semetey-1-2013:p0934:b005:l028","ordinal":148395,"en":"And if their appointed time came, their days ended,"},{"id":"semetey-1-2013:p0934:b005:l029","ordinal":148396,"en":"To die together in one place."},{"id":"semetey-1-2013:p0934:b005:l030","ordinal":148397,"en":"Calling upon God,"},{"id":"semetey-1-2013:p0934:b005:l031","ordinal":148398,"en":"They made their promise binding,"},{"id":"semetey-1-2013:p0934:b005:l032","ordinal":148399,"en":"And swore an oath upon their lives,"},{"id":"semetey-1-2013:p0934:b005:l033","ordinal":148400,"en":"Kissing the mouths of guns,"},{"id":"semetey-1-2013:p0934:b005:l034","ordinal":148401,"en":"Licking the edges of swords."},{"id":"semetey-1-2013:p0934:b005:l035","ordinal":148402,"en":"Nine thousand horses upon the mountains,"},{"id":"semetey-1-2013:p0935:b003:l001","ordinal":148403,"en":"Of the Zhediger's Toltoy,"},{"id":"semetey-1-2013:p0935:b003:l002","ordinal":148404,"en":"Which sorrow shall you tell?"},{"id":"semetey-1-2013:p0935:b003:l003","ordinal":148405,"en":"He had ninety fat mares brought,"},{"id":"semetey-1-2013:p0935:b003:l004","ordinal":148406,"en":"Turned toward the qibla,"},{"id":"semetey-1-2013:p0935:b003:l005","ordinal":148407,"en":"And had them offered as horse sacrifices."},{"id":"semetey-1-2013:p0935:b003:l006","ordinal":148408,"en":"“Those who turn back and flee the enemy,"},{"id":"semetey-1-2013:p0935:b003:l007","ordinal":148409,"en":"May they die in this fashion,” he said,"},{"id":"semetey-1-2013:p0935:b003:l008","ordinal":148410,"en":"And dipped his hand in blood."},{"id":"semetey-1-2013:p0935:b003:l009","ordinal":148411,"en":"Chynkozho arrived and settled"},{"id":"semetey-1-2013:p0935:b003:l010","ordinal":148412,"en":"Beside Toltoy of the Zhediger."},{"id":"semetey-1-2013:p0935:b003:l011","ordinal":148413,"en":"At Zheti-Ozon, the Zhediger"},{"id":"semetey-1-2013:p0935:b003:l012","ordinal":148414,"en":"He gathered completely."},{"id":"semetey-1-2013:p0935:b003:l013","ordinal":148415,"en":"Then Chynkozho,"},{"id":"semetey-1-2013:p0935:b003:l014","ordinal":148416,"en":"Of what he had seen and known,"},{"id":"semetey-1-2013:p0935:b003:l015","ordinal":148417,"en":"Told a lengthy tale."},{"id":"semetey-1-2013:p0935:b003:l016","ordinal":148418,"en":"Their sheep shared one fold;"},{"id":"semetey-1-2013:p0935:b003:l017","ordinal":148419,"en":"Their food they shared as comrades."},{"id":"semetey-1-2013:p0935:b003:l018","ordinal":148420,"en":"His heart was at ease, like a flower."},{"id":"semetey-1-2013:p0935:b003:l019","ordinal":148421,"en":"Winter passed and summer came."},{"id":"semetey-1-2013:p0935:b003:l020","ordinal":148422,"en":"As the people were about to move uphill,"},{"id":"semetey-1-2013:p0935:b003:l021","ordinal":148423,"en":"When summer had come,"},{"id":"semetey-1-2013:p0935:b003:l022","ordinal":148424,"en":"Shygai's son Chynkozho,"},{"id":"semetey-1-2013:p0935:b003:l023","ordinal":148425,"en":"Kozho, capable in all he did,"},{"id":"semetey-1-2013:p0935:b003:l024","ordinal":148426,"en":"Roared in anger,"},{"id":"semetey-1-2013:p0935:b003:l025","ordinal":148427,"en":"And summoned the great mass of Zhediger,"},{"id":"semetey-1-2013:p0935:b003:l026","ordinal":148428,"en":"Leaving not one uncalled."},{"id":"semetey-1-2013:p0935:b003:l027","ordinal":148429,"en":"“An order has come from the khan,” they said."},{"id":"semetey-1-2013:p0935:b003:l028","ordinal":148430,"en":"All the Zhediger"},{"id":"semetey-1-2013:p0935:b003:l029","ordinal":148431,"en":"Came there then."},{"id":"semetey-1-2013:p0935:b003:l030","ordinal":148432,"en":"Tolok and Toltoy were their elders."},{"id":"semetey-1-2013:p0935:b003:l031","ordinal":148433,"en":"Without turning to look at Toltoy,"},{"id":"semetey-1-2013:p0935:b003:l032","ordinal":148434,"en":"As though struck by a massacre,"},{"id":"semetey-1-2013:p0935:b003:l033","ordinal":148435,"en":"They all crumbled before him."},{"id":"semetey-1-2013:p0935:b003:l034","ordinal":148436,"en":"“Zhediger people of every clan,"},{"id":"semetey-1-2013:p0935:b003:l035","ordinal":148437,"en":"I shall give you all courage."},{"id":"semetey-1-2013:p0935:b003:l036","ordinal":148438,"en":"If you turn back and flee,"},{"id":"semetey-1-2013:p0935:b003:l037","ordinal":148439,"en":"Then you have eaten shit."},{"id":"semetey-1-2013:p0935:b003:l038","ordinal":148440,"en":"When I first arrived,"},{"id":"semetey-1-2013:p0935:b003:l039","ordinal":148441,"en":"Swaying about in pairs,"},{"id":"semetey-1-2013:p0935:b004:l001","ordinal":148442,"en":"What was it you said!"},{"id":"semetey-1-2013:p0935:b004:l002","ordinal":148443,"en":"Come, your elders with your chiefs at their head."},{"id":"semetey-1-2013:p0935:b004:l003","ordinal":148444,"en":"All you people of mine, come!"},{"id":"semetey-1-2013:p0935:b004:l004","ordinal":148445,"en":"Let me tell you much:"},{"id":"semetey-1-2013:p0935:b004:l005","ordinal":148446,"en":"We were the Argyn and Kyrgyz people."},{"id":"semetey-1-2013:p0935:b004:l006","ordinal":148447,"en":"Born among those folk,"},{"id":"semetey-1-2013:p0935:b004:l007","ordinal":148448,"en":"A khan named Manas arose."},{"id":"semetey-1-2013:p0935:b004:l008","ordinal":148449,"en":"The enemies who heard of him"},{"id":"semetey-1-2013:p0935:b004:l009","ordinal":148450,"en":"Had the life driven from their breasts."},{"id":"semetey-1-2013:p0935:b004:l010","ordinal":148451,"en":"He was born and grew up in Altai;"},{"id":"semetey-1-2013:p0935:b004:l011","ordinal":148452,"en":"The foes who grappled with him were brought low."},{"id":"semetey-1-2013:p0935:b004:l012","ordinal":148453,"en":"Upon Boshogo, the dark Kalmyk,"},{"id":"semetey-1-2013:p0935:b004:l013","ordinal":148454,"en":"He brought devastation."},{"id":"semetey-1-2013:p0935:b004:l014","ordinal":148455,"en":"He brought devastation once,"},{"id":"semetey-1-2013:p0935:b004:l015","ordinal":148456,"en":"Destroyed Kangai and took its wealth."},{"id":"semetey-1-2013:p0935:b004:l016","ordinal":148457,"en":"The Chinese people's great khan,"},{"id":"semetey-1-2013:p0935:b004:l017","ordinal":148458,"en":"Alooke, he sent into the earth,"},{"id":"semetey-1-2013:p0935:b004:l018","ordinal":148459,"en":"And showed himself a lion."},{"id":"semetey-1-2013:p0935:b004:l019","ordinal":148460,"en":"Clashing with the unbelievers,"},{"id":"semetey-1-2013:p0935:b004:l020","ordinal":148461,"en":"Fighting with the unbelievers,"},{"id":"semetey-1-2013:p0935:b004:l021","ordinal":148462,"en":"That Manas died."},{"id":"semetey-1-2013:p0935:b004:l022","ordinal":148463,"en":"The countless riches Manas left,"},{"id":"semetey-1-2013:p0935:b004:l023","ordinal":148464,"en":"Abyke, Kobosh—the six villains—"},{"id":"semetey-1-2013:p0935:b004:l024","ordinal":148465,"en":"Those men lived upon them."},{"id":"semetey-1-2013:p0935:b004:l025","ordinal":148466,"en":"His fierce mother Kanykei,"},{"id":"semetey-1-2013:p0935:b004:l026","ordinal":148467,"en":"With Semetey left an orphan,"},{"id":"semetey-1-2013:p0935:b004:l027","ordinal":148468,"en":"Her mind distressed by humiliation,"},{"id":"semetey-1-2013:p0935:b004:l028","ordinal":148469,"en":"Fled away with her child."},{"id":"semetey-1-2013:p0935:b004:l029","ordinal":148470,"en":"He went to Bukhara and grew up,"},{"id":"semetey-1-2013:p0935:b004:l030","ordinal":148471,"en":"Returned to Talas,"},{"id":"semetey-1-2013:p0935:b004:l031","ordinal":148472,"en":"And killed his own kinsmen."},{"id":"semetey-1-2013:p0935:b004:l032","ordinal":148473,"en":"That boy turned out a reckless desperado."},{"id":"semetey-1-2013:p0935:b004:l033","ordinal":148474,"en":"When he moved toward Talas,"},{"id":"semetey-1-2013:p0935:b004:l034","ordinal":148475,"en":"Temir Khan flattered him,"},{"id":"semetey-1-2013:p0935:b004:l035","ordinal":148476,"en":"Calling the boy a hero."},{"id":"semetey-1-2013:p0935:b004:l036","ordinal":148477,"en":"God had struck the Sarts down."},{"id":"semetey-1-2013:p0935:b004:l037","ordinal":148478,"en":"Shah Temir's Chachykei,"},{"id":"semetey-1-2013:p0935:b004:l038","ordinal":148479,"en":"The woman you were to marry,"},{"id":"semetey-1-2013:p0935:b004:l039","ordinal":148480,"en":"They offered her as a gift to Semetey,"}]
