[{"id":"semetey-2-2013:p1322:b003:l018","ordinal":287489,"en":"In the desert of Media"},{"id":"semetey-2-2013:p1322:b003:l019","ordinal":287490,"en":"And brought to Khan Manas—"},{"id":"semetey-2-2013:p1322:b003:l020","ordinal":287491,"en":"Kumaiyk, born of royal stock?"},{"id":"semetey-2-2013:p1322:b003:l021","ordinal":287492,"en":"Opening his mouth, he howled,"},{"id":"semetey-2-2013:p1322:b003:l022","ordinal":287493,"en":"And bayed in mourning;"},{"id":"semetey-2-2013:p1322:b003:l023","ordinal":287494,"en":"Parted from Semetey,"},{"id":"semetey-2-2013:p1322:b003:l024","ordinal":287495,"en":"The white sighthound met disaster."},{"id":"semetey-2-2013:p1322:b003:l025","ordinal":287496,"en":"Casting off his collar,"},{"id":"semetey-2-2013:p1322:b003:l026","ordinal":287497,"en":"The white hound vanished."},{"id":"semetey-2-2013:p1322:b003:l027","ordinal":287498,"en":"Black-eyed, with blue-gray legs,"},{"id":"semetey-2-2013:p1322:b003:l028","ordinal":287499,"en":"He tucked his wings and never stooped;"},{"id":"semetey-2-2013:p1322:b003:l029","ordinal":287500,"en":"His talons were iron, his jesses brass,"},{"id":"semetey-2-2013:p1322:b003:l030","ordinal":287501,"en":"He let no goose rise from a lake."},{"id":"semetey-2-2013:p1322:b003:l031","ordinal":287502,"en":"His wings spanned two fathoms,"},{"id":"semetey-2-2013:p1322:b003:l032","ordinal":287503,"en":"And nothing he struck escaped alive;"},{"id":"semetey-2-2013:p1322:b003:l033","ordinal":287504,"en":"He ate flesh upon his master's hand."},{"id":"semetey-2-2013:p1322:b003:l034","ordinal":287505,"en":"His steel pinions flashed pale;"},{"id":"semetey-2-2013:p1322:b003:l035","ordinal":287506,"en":"When he coursed at game,"},{"id":"semetey-2-2013:p1322:b003:l036","ordinal":287507,"en":"He fulfilled every true desire."},{"id":"semetey-2-2013:p1322:b003:l037","ordinal":287508,"en":"With silken leash and golden anklet,"},{"id":"semetey-2-2013:p1322:b003:l038","ordinal":287509,"en":"The peerless white falcon Akshumkar"},{"id":"semetey-2-2013:p1322:b003:l039","ordinal":287510,"en":"Beat his wings at any living prey;"},{"id":"semetey-2-2013:p1322:b004:l001","ordinal":287511,"en":"When his gray-maned master flew him,"},{"id":"semetey-2-2013:p1322:b004:l002","ordinal":287512,"en":"He carried nine bustards at a time."},{"id":"semetey-2-2013:p1322:b004:l003","ordinal":287513,"en":"A saker falcon thirsted for his head,"},{"id":"semetey-2-2013:p1322:b004:l004","ordinal":287514,"en":"And brought the bird to Semetey;"},{"id":"semetey-2-2013:p1322:b004:l005","ordinal":287515,"en":"He was raised in the royal mews."},{"id":"semetey-2-2013:p1322:b004:l006","ordinal":287516,"en":"“This must be a portent,”"},{"id":"semetey-2-2013:p1322:b004:l007","ordinal":287517,"en":"Khan Bakai judged and approved him."},{"id":"semetey-2-2013:p1322:b004:l008","ordinal":287518,"en":"He had gold set on his collar;"},{"id":"semetey-2-2013:p1322:b004:l009","ordinal":287519,"en":"When urged, he danced upon the hand,"},{"id":"semetey-2-2013:p1322:b004:l010","ordinal":287520,"en":"And when this eagle soared,"},{"id":"semetey-2-2013:p1322:b004:l011","ordinal":287521,"en":"He left no creature alive."},{"id":"semetey-2-2013:p1322:b004:l012","ordinal":287522,"en":"When he drove straight at prey,"},{"id":"semetey-2-2013:p1322:b004:l013","ordinal":287523,"en":"His eyes saw it from afar."},{"id":"semetey-2-2013:p1322:b004:l014","ordinal":287524,"en":"He wheeled upon anything flying true,"},{"id":"semetey-2-2013:p1322:b004:l015","ordinal":287525,"en":"Never settling straight, but sweeping wide;"},{"id":"semetey-2-2013:p1322:b004:l016","ordinal":287526,"en":"The one who flew him rejoiced."},{"id":"semetey-2-2013:p1322:b004:l017","ordinal":287527,"en":"When the falcon drove head-on,"},{"id":"semetey-2-2013:p1322:b004:l018","ordinal":287528,"en":"No living thing remained unfallen."},{"id":"semetey-2-2013:p1322:b004:l019","ordinal":287529,"en":"Such was the white falcon you would see—"},{"id":"semetey-2-2013:p1322:b004:l020","ordinal":287530,"en":"A bird to cast loose,"},{"id":"semetey-2-2013:p1322:b004:l021","ordinal":287531,"en":"Semetey's own treasured possession."},{"id":"semetey-2-2013:p1322:b004:l022","ordinal":287532,"en":"Mourning, the white falcon"},{"id":"semetey-2-2013:p1322:b004:l023","ordinal":287533,"en":"Twisted and cried harshly,"},{"id":"semetey-2-2013:p1322:b004:l024","ordinal":287534,"en":"Clawed and tore at his own legs,"},{"id":"semetey-2-2013:p1322:b004:l025","ordinal":287535,"en":"And struck against his hood."},{"id":"semetey-2-2013:p1322:b004:l026","ordinal":287536,"en":"When a hand was raised, he refused food;"},{"id":"semetey-2-2013:p1322:b004:l027","ordinal":287537,"en":"Deep in mourning,"},{"id":"semetey-2-2013:p1322:b004:l028","ordinal":287538,"en":"He tore the feathers from his breast—"},{"id":"semetey-2-2013:p1322:b004:l029","ordinal":287539,"en":"So the white falcon mangled himself."},{"id":"semetey-2-2013:p1322:b004:l030","ordinal":287540,"en":"Then he vanished across the steppe;"},{"id":"semetey-2-2013:p1322:b004:l031","ordinal":287541,"en":"The white falcon fled away."},{"id":"semetey-2-2013:p1322:b004:l032","ordinal":287542,"en":"No eye could catch sight of him,"},{"id":"semetey-2-2013:p1322:b004:l033","ordinal":287543,"en":"And no one knew where he had gone."},{"id":"semetey-2-2013:p1322:b004:l034","ordinal":287544,"en":"Vanishing, the white falcon"},{"id":"semetey-2-2013:p1322:b004:l035","ordinal":287545,"en":"Shredded his golden leash;"},{"id":"semetey-2-2013:p1322:b004:l036","ordinal":287546,"en":"Thus the noble creature tore it apart."},{"id":"semetey-2-2013:p1322:b004:l037","ordinal":287547,"en":"Seen by no person,"},{"id":"semetey-2-2013:p1322:b004:l038","ordinal":287548,"en":"Known by no living soul,"},{"id":"semetey-2-2013:p1322:b004:l039","ordinal":287549,"en":"The white falcon departed."},{"id":"semetey-2-2013:p1323:b003:l001","ordinal":287550,"en":"As Akshumkar did this,"},{"id":"semetey-2-2013:p1323:b003:l002","ordinal":287551,"en":"Warriors wept and khans wept,"},{"id":"semetey-2-2013:p1323:b003:l003","ordinal":287552,"en":"Everyone who saw him wept;"},{"id":"semetey-2-2013:p1323:b003:l004","ordinal":287553,"en":"Stone-hearted lions wept,"},{"id":"semetey-2-2013:p1323:b003:l005","ordinal":287554,"en":"Countless tireless heroes wept."},{"id":"semetey-2-2013:p1323:b003:l006","ordinal":287555,"en":"An uproar rose and the people wept—"},{"id":"semetey-2-2013:p1323:b003:l007","ordinal":287556,"en":"All who wept,"},{"id":"semetey-2-2013:p1323:b003:l008","ordinal":287557,"en":"Young and old,"},{"id":"semetey-2-2013:p1323:b003:l009","ordinal":287558,"en":"Bad and good alike,"},{"id":"semetey-2-2013:p1323:b003:l010","ordinal":287559,"en":"Wept, consumed by their own grief."},{"id":"semetey-2-2013:p1323:b003:l011","ordinal":287560,"en":"“Now that the bloodstained warrior is gone,"},{"id":"semetey-2-2013:p1323:b003:l012","ordinal":287561,"en":"What age and what days"},{"id":"semetey-2-2013:p1323:b003:l013","ordinal":287562,"en":"Will come upon us?” they wept."},{"id":"semetey-2-2013:p1323:b003:l014","ordinal":287563,"en":"The Greathearted One was gone from sight."},{"id":"semetey-2-2013:p1323:b003:l015","ordinal":287564,"en":"“How will the camps"},{"id":"semetey-2-2013:p1323:b003:l016","ordinal":287565,"en":"Of the Argyn and Kyrgyz settle?"},{"id":"semetey-2-2013:p1323:b003:l017","ordinal":287566,"en":"What will become of us?"},{"id":"semetey-2-2013:p1323:b003:l018","ordinal":287567,"en":"How will our people make camp?”"},{"id":"semetey-2-2013:p1323:b003:l019","ordinal":287568,"en":"The people's master was lost."},{"id":"semetey-2-2013:p1323:b003:l020","ordinal":287569,"en":"“What fate now awaits"},{"id":"semetey-2-2013:p1323:b003:l021","ordinal":287570,"en":"The Argyn and Kyrgyz?”"},{"id":"semetey-2-2013:p1323:b003:l022","ordinal":287571,"en":"The people wailed in tumult,"},{"id":"semetey-2-2013:p1323:b003:l023","ordinal":287572,"en":"Their clamor split the sky."},{"id":"semetey-2-2013:p1323:b003:l024","ordinal":287573,"en":"While the heroic sultan lived,"},{"id":"semetey-2-2013:p1323:b003:l025","ordinal":287574,"en":"The people cried and spoke of this,"},{"id":"semetey-2-2013:p1323:b003:l026","ordinal":287575,"en":"Telling horrors clear to all."},{"id":"semetey-2-2013:p1323:b003:l027","ordinal":287576,"en":"While the warrior still lived,"},{"id":"semetey-2-2013:p1323:b003:l028","ordinal":287577,"en":"We ate the barren mare's foal;"},{"id":"semetey-2-2013:p1323:b003:l029","ordinal":287578,"en":"If the Chinese shouted from the ridge"},{"id":"semetey-2-2013:p1323:b003:l030","ordinal":287579,"en":"And stirred a fierce battle,"},{"id":"semetey-2-2013:p1323:b003:l031","ordinal":287580,"en":"We used to ask, “Where is the danger?”"},{"id":"semetey-2-2013:p1323:b003:l032","ordinal":287581,"en":"There in Kara-Buura and Chatkal,"},{"id":"semetey-2-2013:p1323:b003:l033","ordinal":287582,"en":"When the Kyrgyz lay in proud abundance,"},{"id":"semetey-2-2013:p1323:b003:l034","ordinal":287583,"en":"Red haze brightened the land,"},{"id":"semetey-2-2013:p1323:b003:l035","ordinal":287584,"en":"Fine mares with foals stood tethered,"},{"id":"semetey-2-2013:p1323:b003:l036","ordinal":287585,"en":"And kumis flowed by day, spirits by night."},{"id":"semetey-2-2013:p1323:b003:l037","ordinal":287586,"en":"In those flourishing days,"},{"id":"semetey-2-2013:p1323:b003:l038","ordinal":287587,"en":"In those days we wore sable caps"},{"id":"semetey-2-2013:p1323:b003:l039","ordinal":287588,"en":"With paired trim, cocked jauntily."},{"id":"semetey-2-2013:p1323:b005:l001","ordinal":287589,"en":"When restless, we raided the foe;"},{"id":"semetey-2-2013:p1323:b005:l002","ordinal":287590,"en":"While our hero still lived,"},{"id":"semetey-2-2013:p1323:b005:l003","ordinal":287591,"en":"If Chinese armies met us head-on,"},{"id":"semetey-2-2013:p1323:b005:l004","ordinal":287592,"en":"We drove them all the way to Beijing."},{"id":"semetey-2-2013:p1323:b005:l005","ordinal":287593,"en":"We hunted deer in the hills"},{"id":"semetey-2-2013:p1323:b005:l006","ordinal":287594,"en":"And lived safe, untouched by sorrow."},{"id":"semetey-2-2013:p1323:b005:l007","ordinal":287595,"en":"Ours was a people whose daughters-in-law were lovely,"},{"id":"semetey-2-2013:p1323:b005:l008","ordinal":287596,"en":"With broad headdresses and long hair ornaments."},{"id":"semetey-2-2013:p1323:b005:l009","ordinal":287597,"en":"While the bloodstained hero lived,"},{"id":"semetey-2-2013:p1323:b005:l010","ordinal":287598,"en":"We asked, “How could disaster reach us?”"},{"id":"semetey-2-2013:p1323:b005:l011","ordinal":287599,"en":"Our land was hilly Talas;"},{"id":"semetey-2-2013:p1323:b005:l012","ordinal":287600,"en":"Now our rocky ridge has collapsed."},{"id":"semetey-2-2013:p1323:b005:l013","ordinal":287601,"en":"Parted from the warrior lion,"},{"id":"semetey-2-2013:p1323:b005:l014","ordinal":287602,"en":"Our backs seem broken,"},{"id":"semetey-2-2013:p1323:b005:l015","ordinal":287603,"en":"Our people seem to writhe in pain,"},{"id":"semetey-2-2013:p1323:b005:l016","ordinal":287604,"en":"Our fortune seems bound fast,"},{"id":"semetey-2-2013:p1323:b005:l017","ordinal":287605,"en":"And our hopes seem shattered."},{"id":"semetey-2-2013:p1323:b005:l018","ordinal":287606,"en":"There are argali on its hills,"},{"id":"semetey-2-2013:p1323:b005:l019","ordinal":287607,"en":"Silver on its sunny slopes,"},{"id":"semetey-2-2013:p1323:b005:l020","ordinal":287608,"en":"Wild asses on its pale plains,"},{"id":"semetey-2-2013:p1323:b005:l021","ordinal":287609,"en":"Ibex on its terraces,"},{"id":"semetey-2-2013:p1323:b005:l022","ordinal":287610,"en":"Snow upon its mountains,"},{"id":"semetey-2-2013:p1323:b005:l023","ordinal":287611,"en":"Game within its forests."},{"id":"semetey-2-2013:p1323:b005:l024","ordinal":287612,"en":"In Jylgyndy, Keng-Kol, and Talas"},{"id":"semetey-2-2013:p1323:b005:l025","ordinal":287613,"en":"All these delights abound."},{"id":"semetey-2-2013:p1323:b005:l026","ordinal":287614,"en":"Its springs boil up and overflow;"},{"id":"semetey-2-2013:p1323:b005:l027","ordinal":287615,"en":"Nightingales sing there,"},{"id":"semetey-2-2013:p1323:b005:l028","ordinal":287616,"en":"And hearing their songs,"},{"id":"semetey-2-2013:p1323:b005:l029","ordinal":287617,"en":"Young men soften with longing."},{"id":"semetey-2-2013:p1323:b005:l030","ordinal":287618,"en":"Talas was a spacious land,"},{"id":"semetey-2-2013:p1323:b005:l031","ordinal":287619,"en":"And these noble people here"},{"id":"semetey-2-2013:p1323:b005:l032","ordinal":287620,"en":"Were the free Kyrgyz nation."},{"id":"semetey-2-2013:p1323:b005:l033","ordinal":287621,"en":"No enemy advancing could defeat them,"},{"id":"semetey-2-2013:p1323:b005:l034","ordinal":287622,"en":"No host could prevail in combat."},{"id":"semetey-2-2013:p1323:b005:l035","ordinal":287623,"en":"These few Kyrgyz here"},{"id":"semetey-2-2013:p1323:b005:l036","ordinal":287624,"en":"Thrived upon the finest land;"},{"id":"semetey-2-2013:p1323:b005:l037","ordinal":287625,"en":"Before every doorway"},{"id":"semetey-2-2013:p1323:b005:l038","ordinal":287626,"en":"A thousand mares were tethered."},{"id":"semetey-2-2013:p1323:b005:l039","ordinal":287627,"en":"We were a people living at liberty,"},{"id":"semetey-2-2013:p1325:b003:l001","ordinal":287628,"en":"When told to take a cap, we cut off a head;"},{"id":"semetey-2-2013:p1325:b003:l002","ordinal":287629,"en":"When told to drink water, we drank poison;"},{"id":"semetey-2-2013:p1325:b003:l003","ordinal":287630,"en":"When told to spill blood, we spilled our souls."},{"id":"semetey-2-2013:p1325:b003:l004","ordinal":287631,"en":"We were a people equal to long clubs,"},{"id":"semetey-2-2013:p1325:b003:l005","ordinal":287632,"en":"Crooked cudgels, and stout staves."},{"id":"semetey-2-2013:p1325:b003:l006","ordinal":287633,"en":"When a man loves whom he chooses,"},{"id":"semetey-2-2013:p1325:b003:l007","ordinal":287634,"en":"What night equals the blessed Night of Power?"},{"id":"semetey-2-2013:p1325:b003:l008","ordinal":287635,"en":"While the bloodstained warrior watched this land,"},{"id":"semetey-2-2013:p1325:b003:l009","ordinal":287636,"en":"Was there ever a day of merely standing by?"},{"id":"semetey-2-2013:p1325:b003:l010","ordinal":287637,"en":"If the many Kyrgyz and Argyn"},{"id":"semetey-2-2013:p1325:b003:l011","ordinal":287638,"en":"Suddenly stretched in marching ranks,"},{"id":"semetey-2-2013:p1325:b003:l012","ordinal":287639,"en":"And unexpectedly joined battle,"},{"id":"semetey-2-2013:p1325:b003:l013","ordinal":287640,"en":"If our blood ran in slaughter"},{"id":"semetey-2-2013:p1325:b003:l014","ordinal":287641,"en":"And all of us were locked in combat,"},{"id":"semetey-2-2013:p1325:b003:l015","ordinal":287642,"en":"Where now is the tawny mountain pass"},{"id":"semetey-2-2013:p1325:b003:l016","ordinal":287643,"en":"To which we might flee in a stream?"},{"id":"semetey-2-2013:p1325:b003:l017","ordinal":287644,"en":"Where is the lion like the Greathearted One,"},{"id":"semetey-2-2013:p1325:b003:l018","ordinal":287645,"en":"Who would spare these people torment"},{"id":"semetey-2-2013:p1325:b003:l019","ordinal":287646,"en":"And divide the warring sides?"},{"id":"semetey-2-2013:p1325:b003:l020","ordinal":287647,"en":"Now there is no ridge to brace against,"},{"id":"semetey-2-2013:p1325:b003:l021","ordinal":287648,"en":"No place left to fortify;"},{"id":"semetey-2-2013:p1325:b003:l022","ordinal":287649,"en":"You have no khan whose figure is a mountain."},{"id":"semetey-2-2013:p1325:b003:l023","ordinal":287650,"en":"Parted from your protecting khan,"},{"id":"semetey-2-2013:p1325:b003:l024","ordinal":287651,"en":"You many Kyrgyz have no strength."},{"id":"semetey-2-2013:p1325:b003:l025","ordinal":287652,"en":"What becomes of a rolling, hilly land"},{"id":"semetey-2-2013:p1325:b003:l026","ordinal":287653,"en":"Whose people have left it desolate?"},{"id":"semetey-2-2013:p1325:b003:l027","ordinal":287654,"en":"What becomes of a soul burning openly,"},{"id":"semetey-2-2013:p1325:b003:l028","ordinal":287655,"en":"Or livestock abandoned without an owner?"},{"id":"semetey-2-2013:p1325:b003:l029","ordinal":287656,"en":"Parted from our noble lion,"},{"id":"semetey-2-2013:p1325:b003:l030","ordinal":287657,"en":"What kinds of hell"},{"id":"semetey-2-2013:p1325:b003:l031","ordinal":287658,"en":"Must we Kyrgyz now endure?"},{"id":"semetey-2-2013:p1325:b003:l032","ordinal":287659,"en":"No cotton is planted for us"},{"id":"semetey-2-2013:p1325:b003:l033","ordinal":287660,"en":"In Keng-Kol now;"},{"id":"semetey-2-2013:p1325:b003:l034","ordinal":287661,"en":"There is no time to lounge at ease."},{"id":"semetey-2-2013:p1325:b003:l035","ordinal":287662,"en":"Is there still a garden planted in Talas?"},{"id":"semetey-2-2013:p1325:b003:l036","ordinal":287663,"en":"We have lost our fortunate lion;"},{"id":"semetey-2-2013:p1325:b003:l037","ordinal":287664,"en":"Is this a time to sprawl in idleness?"},{"id":"semetey-2-2013:p1325:b003:l038","ordinal":287665,"en":"Have we now a garden planted"},{"id":"semetey-2-2013:p1325:b003:l039","ordinal":287666,"en":"Upon the hill?"},{"id":"semetey-2-2013:p1325:b004:l001","ordinal":287667,"en":"Is this a time for swaggering rest?"},{"id":"semetey-2-2013:p1325:b004:l002","ordinal":287668,"en":"Many enemies weigh upon our minds;"},{"id":"semetey-2-2013:p1325:b004:l003","ordinal":287669,"en":"An enemy stands ready to bury us."},{"id":"semetey-2-2013:p1325:b004:l004","ordinal":287670,"en":"There is the oppression"},{"id":"semetey-2-2013:p1325:b004:l005","ordinal":287671,"en":"Of Alty-Shaar and Kokand."},{"id":"semetey-2-2013:p1325:b004:l006","ordinal":287672,"en":"With sashes wound like turbans,"},{"id":"semetey-2-2013:p1325:b004:l007","ordinal":287673,"en":"Praying to the Almighty,"},{"id":"semetey-2-2013:p1325:b004:l008","ordinal":287674,"en":"Their crooked threat still stands."},{"id":"semetey-2-2013:p1325:b004:l009","ordinal":287675,"en":"You have no supporting presence, no backbone,"},{"id":"semetey-2-2013:p1325:b004:l010","ordinal":287676,"en":"You have lost your true gray-maned lion."},{"id":"semetey-2-2013:p1325:b004:l011","ordinal":287677,"en":"The one seen today is gone tomorrow;"},{"id":"semetey-2-2013:p1325:b004:l012","ordinal":287678,"en":"Your heart is flame and your breast is ember—"},{"id":"semetey-2-2013:p1325:b004:l013","ordinal":287679,"en":"Such is this worthless world!"},{"id":"semetey-2-2013:p1325:b004:l014","ordinal":287680,"en":"The Greathearted gray-maned lion"},{"id":"semetey-2-2013:p1325:b004:l015","ordinal":287681,"en":"Who endured every hell is not here!"},{"id":"semetey-2-2013:p1325:b004:l016","ordinal":287682,"en":"The assembled people grieved and said this,"},{"id":"semetey-2-2013:p1325:b004:l017","ordinal":287683,"en":"Speaking of mankind's dreadful calamity;"},{"id":"semetey-2-2013:p1325:b004:l018","ordinal":287684,"en":"Their ribs seemed to split,"},{"id":"semetey-2-2013:p1325:b004:l019","ordinal":287685,"en":"And tears poured from their eyes."},{"id":"semetey-2-2013:p1325:b004:l020","ordinal":287686,"en":"They heard the tale from the great host:"},{"id":"semetey-2-2013:p1325:b004:l021","ordinal":287687,"en":"No one knew where he was,"},{"id":"semetey-2-2013:p1325:b004:l022","ordinal":287688,"en":"And they heard that Semetey had vanished."},{"id":"semetey-2-2013:p1325:b004:l023","ordinal":287689,"en":"The people wailed in anguish,"},{"id":"semetey-2-2013:p1325:b004:l024","ordinal":287690,"en":"Despairing of their tiny lives."},{"id":"semetey-2-2013:p1325:b004:l025","ordinal":287691,"en":"Semetey had gone from among them,"},{"id":"semetey-2-2013:p1325:b004:l026","ordinal":287692,"en":"And the multitude stood in uproar."},{"id":"semetey-2-2013:p1325:b004:l027","ordinal":287693,"en":"As though each person's father had died,"},{"id":"semetey-2-2013:p1325:b004:l028","ordinal":287694,"en":"The crescent-tipped golden banners filled the field."},{"id":"semetey-2-2013:p1325:b004:l029","ordinal":287695,"en":"As the multitude stood grieving,"},{"id":"semetey-2-2013:p1325:b004:l030","ordinal":287696,"en":"A clamor split the sky."},{"id":"semetey-2-2013:p1325:b004:l031","ordinal":287697,"en":"Overwhelmed by dreadful disaster,"},{"id":"semetey-2-2013:p1325:b004:l032","ordinal":287698,"en":"They abandoned utterly"},{"id":"semetey-2-2013:p1325:b004:l033","ordinal":287699,"en":"Not only their livestock but their lives."},{"id":"semetey-2-2013:p1325:b004:l034","ordinal":287700,"en":"The people wailed in anguish,"},{"id":"semetey-2-2013:p1325:b004:l035","ordinal":287701,"en":"Running up and down;"},{"id":"semetey-2-2013:p1325:b004:l036","ordinal":287702,"en":"When they heard about Semetey,"},{"id":"semetey-2-2013:p1325:b004:l037","ordinal":287703,"en":"They plunged into the tumult,"},{"id":"semetey-2-2013:p1325:b004:l038","ordinal":287704,"en":"And fell into a vast,"},{"id":"semetey-2-2013:p1325:b004:l039","ordinal":287705,"en":"Unhealed uproar."},{"id":"semetey-2-2013:p1326:b003:l001","ordinal":287706,"en":"Turning wisdom over and pondering,"},{"id":"semetey-2-2013:p1326:b003:l002","ordinal":287707,"en":"They withdrew into the hills."},{"id":"semetey-2-2013:p1326:b003:l003","ordinal":287708,"en":"The people wailed and tumult broke out;"},{"id":"semetey-2-2013:p1326:b003:l004","ordinal":287709,"en":"They plunged into the uproar,"},{"id":"semetey-2-2013:p1326:b003:l005","ordinal":287710,"en":"And entered an ordeal"},{"id":"semetey-2-2013:p1326:b003:l006","ordinal":287711,"en":"No common people could face."},{"id":"semetey-2-2013:p1326:b003:l007","ordinal":287712,"en":"If the Chinese swarm over the ridge,"},{"id":"semetey-2-2013:p1326:b003:l008","ordinal":287713,"en":"You have no khan to answer them,"},{"id":"semetey-2-2013:p1326:b003:l009","ordinal":287714,"en":"No strength with which to fight."},{"id":"semetey-2-2013:p1326:b003:l010","ordinal":287715,"en":"Unable to cross and escape,"},{"id":"semetey-2-2013:p1326:b003:l011","ordinal":287716,"en":"Will women and men together"},{"id":"semetey-2-2013:p1326:b003:l012","ordinal":287717,"en":"Be taken into captivity?"},{"id":"semetey-2-2013:p1326:b003:l013","ordinal":287718,"en":"Without dying or disappearing,"},{"id":"semetey-2-2013:p1326:b003:l014","ordinal":287719,"en":"Will we survive the humiliation,"},{"id":"semetey-2-2013:p1326:b003:l015","ordinal":287720,"en":"Living on as slaves,"},{"id":"semetey-2-2013:p1326:b003:l016","ordinal":287721,"en":"And be brought to misery?"},{"id":"semetey-2-2013:p1326:b003:l017","ordinal":287722,"en":"Called the people of that bloodstained warrior,"},{"id":"semetey-2-2013:p1326:b003:l018","ordinal":287723,"en":"Will we be cast into the grave?"},{"id":"semetey-2-2013:p1326:b003:l019","ordinal":287724,"en":"Will firearms strike us from the front,"},{"id":"semetey-2-2013:p1326:b003:l020","ordinal":287725,"en":"And will we be torn apart?”"},{"id":"semetey-2-2013:p1326:b003:l021","ordinal":287726,"en":"For the hero Semetey,"},{"id":"semetey-2-2013:p1326:b003:l022","ordinal":287727,"en":"All the Kyrgyz people wept;"},{"id":"semetey-2-2013:p1326:b003:l023","ordinal":287728,"en":"The wise and skillful wept,"},{"id":"semetey-2-2013:p1326:b003:l024","ordinal":287729,"en":"Slender-waisted girls"},{"id":"semetey-2-2013:p1326:b003:l025","ordinal":287730,"en":"In crimson dresses wept;"},{"id":"semetey-2-2013:p1326:b003:l026","ordinal":287731,"en":"White-bearded elders wept,"},{"id":"semetey-2-2013:p1326:b003:l027","ordinal":287732,"en":"Every kind of living soul wept,"},{"id":"semetey-2-2013:p1326:b003:l028","ordinal":287733,"en":"Old and young alike wept."},{"id":"semetey-2-2013:p1326:b003:l029","ordinal":287734,"en":"The people lamented in tumult,"},{"id":"semetey-2-2013:p1326:b003:l030","ordinal":287735,"en":"Despairing of their tiny lives;"},{"id":"semetey-2-2013:p1326:b003:l031","ordinal":287736,"en":"Wearing black and swallowing blood,"},{"id":"semetey-2-2013:p1326:b003:l032","ordinal":287737,"en":"The many Argyn and Kyrgyz,"},{"id":"semetey-2-2013:p1326:b003:l033","ordinal":287738,"en":"The whole great nation, stood in uproar."},{"id":"semetey-2-2013:p1326:b003:l034","ordinal":287739,"en":"As the people wailed,"},{"id":"semetey-2-2013:p1326:b003:l035","ordinal":287740,"en":"Kanchoro shouted in frenzy,"},{"id":"semetey-2-2013:p1326:b003:l036","ordinal":287741,"en":"Calling for warrior Kyiaz,"},{"id":"semetey-2-2013:p1326:b003:l037","ordinal":287742,"en":"And began his reign of fury."},{"id":"semetey-2-2013:p1326:b003:l038","ordinal":287743,"en":"When they saw Kanchoro's rage,"},{"id":"semetey-2-2013:p1326:b003:l039","ordinal":287744,"en":"The white-bearded elders"}]
