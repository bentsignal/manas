{"id": "sayakbay-ms-current146:pdf199:l001", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 199, "folio": 582, "line_in_page": 1, "raw": "Кырданын кулак керт эле,", "text": "Кырданын кулак керт эле,", "en": "His mountain ear was keen and true.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, proper name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf199:l002", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 199, "folio": 582, "line_in_page": 2, "raw": "Чын байланды айткан тил,", "text": "Чын байланды айткан тил,", "en": "The tongue that spoke was tightly bound.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf199:l003", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 199, "folio": 582, "line_in_page": 3, "raw": "Айры заман күк түшүп,", "text": "Айры заман күк түшүп,", "en": "A divided age came crashing down.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf199:l004", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 199, "folio": 582, "line_in_page": 4, "raw": "Тобого түшүп караң түн,", "text": "Тобого түшүп караң түн,", "en": "Dark night descended upon repentance.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf199:l005", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 199, "folio": 582, "line_in_page": 5, "raw": "Алагай таппай калтырып,", "text": "Алагай таппай калтырып,", "en": "Leaving him unable to find a refuge,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, proper name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf199:l006", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 199, "folio": 582, "line_in_page": 6, "raw": "Көр түшкөн айрынын,", "text": "Көр түшкөн айрынын,", "en": "Of the forked one who fell into the grave,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf199:l007", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 199, "folio": 582, "line_in_page": 7, "raw": "Теңирге курчоо кол,", "text": "Теңирге курчоо кол,", "en": "An encircling host rose toward God.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf199:l008", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 199, "folio": 582, "line_in_page": 8, "raw": "Кут кайнаган арбак шор,", "text": "Кут кайнаган арбак шор,", "en": "Blessing boiled, yet the spirit suffered.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, proper name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf199:l009", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 199, "folio": 582, "line_in_page": 9, "raw": "Теңирге темир тор,", "text": "Теңирге темир тор,", "en": "An iron net reached toward heaven.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf199:l010", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 199, "folio": 582, "line_in_page": 10, "raw": "Төш алакай табалбай,", "text": "Төш алакай табалбай,", "en": "Unable to find a shelter for his breast,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, proper name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf199:l011", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 199, "folio": 582, "line_in_page": 11, "raw": "Теңиз жандан түшүп,", "text": "Теңиз жандан түшүп,", "en": "He descended from an ocean of souls.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf199:l012", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 199, "folio": 582, "line_in_page": 12, "raw": "Темирлерге ошо жол,", "text": "Темирлерге ошо жол,", "en": "That road led among the irons.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf199:l013", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 199, "folio": 582, "line_in_page": 13, "raw": "Урааны жок, эл жок,", "text": "Урааны жок, эл жок,", "en": "There was no battle cry and no people.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf199:l014", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 199, "folio": 582, "line_in_page": 14, "raw": "Урууда жалгыз эр Кенен,", "text": "Урууда жалгыз эр Кенен,", "en": "In the clan, hero Kenen stood alone.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf199:l015", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 199, "folio": 582, "line_in_page": 15, "raw": "Уулу, короо-журту жок,", "text": "Уулу, короо-журту жок,", "en": "He had neither son nor household.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf199:l016", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 199, "folio": 582, "line_in_page": 16, "raw": "Согуш минер буудан жок,", "text": "Согуш минер буудан жок,", "en": "There was no racehorse to ride into war.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf199:l017", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 199, "folio": 582, "line_in_page": 17, "raw": "Атын арбын сүйлөгөн,", "text": "Атын арбын сүйлөгөн,", "en": "They spoke his name over and over.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf199:l018", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 199, "folio": 582, "line_in_page": 18, "raw": "Ажалдан менин турган,", "text": "Ажалдан менин турган,", "en": "He stood between me and death.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf199:l019", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 199, "folio": 582, "line_in_page": 19, "raw": "Жай билбеген жаман жоо,", "text": "Жай билбеген жаман жоо,", "en": "The wicked enemy knew no mercy.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf199:l020", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 199, "folio": 582, "line_in_page": 20, "raw": "Жайнаган кытай колунан,", "text": "Жайнаган кытай колунан,", "en": "From the swarming Chinese host,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf199:l021", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 199, "folio": 582, "line_in_page": 21, "raw": "Үзүлбөс темир торунан,", "text": "Үзүлбөс темир торунан,", "en": "From its unbreakable iron net,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf199:l022", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 199, "folio": 582, "line_in_page": 22, "raw": "Мөкүгө чыкты шорунан,", "text": "Мөкүгө чыкты шорунан,", "en": "He rose from his misery to the height.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, proper name, or idiomatic interpretation requires later witness collation.", "bbox": null}
