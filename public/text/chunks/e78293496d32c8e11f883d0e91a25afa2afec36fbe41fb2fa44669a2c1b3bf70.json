[{"id":"semetey-1-2013:p0777:b004:l001","ordinal":136449,"en":"To Manas's orphan son, the hero."},{"id":"semetey-1-2013:p0777:b004:l002","ordinal":136450,"en":"My forty thousand or so horses upon the slopes—"},{"id":"semetey-1-2013:p0777:b004:l003","ordinal":136451,"en":"You let it be struck in a treacherous place,"},{"id":"semetey-1-2013:p0777:b004:l004","ordinal":136452,"en":"Unless you take care, you six villains,"},{"id":"semetey-1-2013:p0777:b004:l005","ordinal":136453,"en":"To Manas's wretched son"},{"id":"semetey-1-2013:p0777:b004:l006","ordinal":136454,"en":"You have lost my horses too."},{"id":"semetey-1-2013:p0777:b004:l007","ordinal":136455,"en":"Heroes at home, absent in battle,"},{"id":"semetey-1-2013:p0777:b004:l008","ordinal":136456,"en":"Such is this dung of a world."},{"id":"semetey-1-2013:p0777:b004:l009","ordinal":136457,"en":"Your father's grave, you six villains!"},{"id":"semetey-1-2013:p0777:b004:l010","ordinal":136458,"en":"May you perish, as though never born;"},{"id":"semetey-1-2013:p0777:b004:l011","ordinal":136459,"en":"Die instead of living on!"},{"id":"semetey-1-2013:p0777:b004:l012","ordinal":136460,"en":"There is more yet to marvel at:"},{"id":"semetey-1-2013:p0777:b004:l013","ordinal":136461,"en":"Today he raids and takes the livestock,"},{"id":"semetey-1-2013:p0777:b004:l014","ordinal":136462,"en":"Tomorrow he will slaughter and take lives."},{"id":"semetey-1-2013:p0777:b004:l015","ordinal":136463,"en":"When he has reached twelve,"},{"id":"semetey-1-2013:p0777:b004:l016","ordinal":136464,"en":"You have seen a wonder like this."},{"id":"semetey-1-2013:p0777:b004:l017","ordinal":136465,"en":"Without wearing it once, you let him take"},{"id":"semetey-1-2013:p0777:b004:l018","ordinal":136466,"en":"My robe left by the king.”"},{"id":"semetey-1-2013:p0777:b004:l019","ordinal":136467,"en":"Akylay spoke like this;"},{"id":"semetey-1-2013:p0777:b004:l020","ordinal":136468,"en":"God had struck Kobosh hard."},{"id":"semetey-1-2013:p0777:b004:l021","ordinal":136469,"en":"Making ready his weapons,"},{"id":"semetey-1-2013:p0777:b004:l022","ordinal":136470,"en":"Against Manas's orphan son,"},{"id":"semetey-1-2013:p0777:b004:l023","ordinal":136471,"en":"He prepared to joust."},{"id":"semetey-1-2013:p0777:b006:l001","ordinal":136472,"en":"Working himself up, Kobosh said:"},{"id":"semetey-1-2013:p0777:b006:l002","ordinal":136473,"en":"“His father, that simpleton Manas—"},{"id":"semetey-1-2013:p0777:b006:l003","ordinal":136474,"en":"My hand deceived him six times,” he said."},{"id":"semetey-1-2013:p0777:b006:l004","ordinal":136475,"en":"“From Temir Khan's city,"},{"id":"semetey-1-2013:p0777:b006:l005","ordinal":136476,"en":"To the orphan who wandered here,"},{"id":"semetey-1-2013:p0777:b006:l006","ordinal":136477,"en":"Let me show a wonder."},{"id":"semetey-1-2013:p0777:b006:l007","ordinal":136478,"en":"When his father Manas was alive,"},{"id":"semetey-1-2013:p0777:b006:l008","ordinal":136479,"en":"Deceiving and deluding him like this,"},{"id":"semetey-1-2013:p0777:b006:l009","ordinal":136480,"en":"The hand that I was walking with."},{"id":"semetey-1-2013:p0777:b006:l010","ordinal":136481,"en":"“Let me show my boundless valor,"},{"id":"semetey-1-2013:p0777:b006:l011","ordinal":136482,"en":"Into his mother Kanykey's belly,"},{"id":"semetey-1-2013:p0777:b008:l001","ordinal":136483,"en":"Beating him, drive him back inside."},{"id":"semetey-1-2013:p0777:b008:l002","ordinal":136484,"en":"Upon the orphan standing there watching,"},{"id":"semetey-1-2013:p0777:b008:l003","ordinal":136485,"en":"Let me bring havoc."},{"id":"semetey-1-2013:p0777:b008:l004","ordinal":136486,"en":"He has roused my wrath;"},{"id":"semetey-1-2013:p0777:b008:l005","ordinal":136487,"en":"Let me seize him and take his head."},{"id":"semetey-1-2013:p0777:b008:l006","ordinal":136488,"en":"The ill-omened orphan"},{"id":"semetey-1-2013:p0777:b008:l007","ordinal":136489,"en":"I shall cleave upon the road."},{"id":"semetey-1-2013:p0777:b008:l008","ordinal":136490,"en":"Whatever he relies upon for support,"},{"id":"semetey-1-2013:p0777:b008:l009","ordinal":136491,"en":"I shall utterly destroy."},{"id":"semetey-1-2013:p0777:b008:l010","ordinal":136492,"en":"At the reckless orphan,"},{"id":"semetey-1-2013:p0777:b008:l011","ordinal":136493,"en":"Let me shout and thrust my lance,"},{"id":"semetey-1-2013:p0778:b003:l001","ordinal":136494,"en":"I shall strike him down while young,"},{"id":"semetey-1-2013:p0778:b003:l002","ordinal":136495,"en":"And put him out like a fire."},{"id":"semetey-1-2013:p0778:b003:l003","ordinal":136496,"en":"A birch newly sprung up—"},{"id":"semetey-1-2013:p0778:b003:l004","ordinal":136497,"en":"I shall make it as though felled."},{"id":"semetey-1-2013:p0778:b003:l005","ordinal":136498,"en":"The spur of a cliff-sided mountain—"},{"id":"semetey-1-2013:p0778:b003:l006","ordinal":136499,"en":"I shall make it as though brought crashing down."},{"id":"semetey-1-2013:p0778:b003:l007","ordinal":136500,"en":"The Argyn and the Kyrgyz—"},{"id":"semetey-1-2013:p0778:b003:l008","ordinal":136501,"en":"I shall make them move away."},{"id":"semetey-1-2013:p0778:b003:l009","ordinal":136502,"en":"The light upon his brow—"},{"id":"semetey-1-2013:p0778:b003:l010","ordinal":136503,"en":"I shall make it as though extinguished."},{"id":"semetey-1-2013:p0778:b003:l011","ordinal":136504,"en":"I shall reach that source of grief;"},{"id":"semetey-1-2013:p0778:b003:l012","ordinal":136505,"en":"Their elders, Bakai at their head,"},{"id":"semetey-1-2013:p0778:b003:l013","ordinal":136506,"en":"With their children, all of them,"},{"id":"semetey-1-2013:p0778:b003:l014","ordinal":136507,"en":"I shall shake down, shake down as I pass."},{"id":"semetey-1-2013:p0778:b003:l015","ordinal":136508,"en":"I shall catch Toruaygyr and mount him,"},{"id":"semetey-1-2013:p0778:b003:l016","ordinal":136509,"en":"And drive them toward Temir Khan.”"},{"id":"semetey-1-2013:p0778:b003:l017","ordinal":136510,"en":"This swine spoke thus;"},{"id":"semetey-1-2013:p0778:b003:l018","ordinal":136511,"en":"The earth split with his roaring."},{"id":"semetey-1-2013:p0778:b003:l019","ordinal":136512,"en":"The gray coat Akylay had made"},{"id":"semetey-1-2013:p0778:b003:l020","ordinal":136513,"en":"Began gulping down the meat."},{"id":"semetey-1-2013:p0778:b003:l021","ordinal":136514,"en":"Toruaygyr, with his mallet-like mane, at the tether,"},{"id":"semetey-1-2013:p0778:b003:l023","ordinal":136515,"en":"He leapt upon bareback."},{"id":"semetey-1-2013:p0778:b003:l024","ordinal":136516,"en":"A greasy black yurt-bracing pole"},{"id":"semetey-1-2013:p0778:b003:l025","ordinal":136517,"en":"He put upon his shoulder."},{"id":"semetey-1-2013:p0778:b003:l026","ordinal":136518,"en":"Roaring, “The enemy flees!”"},{"id":"semetey-1-2013:p0778:b003:l027","ordinal":136519,"en":"Raising the battle cry, “Kobosh!”"},{"id":"semetey-1-2013:p0778:b003:l028","ordinal":136520,"en":"He shouted and gave chase."},{"id":"semetey-1-2013:p0778:b003:l029","ordinal":136521,"en":"Mallet-maned Toruaygyr,"},{"id":"semetey-1-2013:p0778:b003:l030","ordinal":136522,"en":"Flying like an arrow, sped along,"},{"id":"semetey-1-2013:p0778:b003:l031","ordinal":136523,"en":"Toward Semetey and Bakai,"},{"id":"semetey-1-2013:p0778:b003:l032","ordinal":136524,"en":"And drew near them."},{"id":"semetey-1-2013:p0778:b003:l033","ordinal":136525,"en":"Bakai and Semetey,"},{"id":"semetey-1-2013:p0778:b003:l034","ordinal":136526,"en":"Unperturbed, paying no heed,"},{"id":"semetey-1-2013:p0778:b003:l035","ordinal":136527,"en":"Kept riding on,"},{"id":"semetey-1-2013:p0778:b003:l036","ordinal":136528,"en":"That bellowing dog"},{"id":"semetey-1-2013:p0778:b003:l037","ordinal":136529,"en":"Counting as nothing."},{"id":"semetey-1-2013:p0778:b003:l038","ordinal":136530,"en":"When the fool came close,"},{"id":"semetey-1-2013:p0778:b003:l039","ordinal":136531,"en":"Semetey rode ahead,"},{"id":"semetey-1-2013:p0778:b004:l001","ordinal":136532,"en":"Bakai Khan behind him."},{"id":"semetey-1-2013:p0778:b004:l002","ordinal":136533,"en":"Kobosh caught up, full of rage,"},{"id":"semetey-1-2013:p0778:b004:l003","ordinal":136534,"en":"And spoke to Bakai Khan:"},{"id":"semetey-1-2013:p0778:b004:l004","ordinal":136535,"en":"“You damned slave Bakai,"},{"id":"semetey-1-2013:p0778:b004:l005","ordinal":136536,"en":"A solitary hut before you—"},{"id":"semetey-1-2013:p0778:b004:l006","ordinal":136537,"en":"You have come, thinking it a presence."},{"id":"semetey-1-2013:p0778:b004:l007","ordinal":136538,"en":"Manas's foolish orphan—"},{"id":"semetey-1-2013:p0778:b004:l008","ordinal":136539,"en":"You have come, thinking him support."},{"id":"semetey-1-2013:p0778:b004:l009","ordinal":136540,"en":"I shall strike down your support,"},{"id":"semetey-1-2013:p0778:b004:l010","ordinal":136541,"en":"You damned graybeard;"},{"id":"semetey-1-2013:p0778:b004:l011","ordinal":136542,"en":"I shall settle your account now."},{"id":"semetey-1-2013:p0778:b004:l012","ordinal":136543,"en":"With your beard grown white,"},{"id":"semetey-1-2013:p0778:b004:l013","ordinal":136544,"en":"With your final journey near,"},{"id":"semetey-1-2013:p0778:b004:l014","ordinal":136545,"en":"You do not know your own wickedness;"},{"id":"semetey-1-2013:p0778:b004:l015","ordinal":136546,"en":"You cannot live without unsettling the people."},{"id":"semetey-1-2013:p0778:b004:l016","ordinal":136547,"en":"In your old age,"},{"id":"semetey-1-2013:p0778:b004:l017","ordinal":136548,"en":"With death approaching,"},{"id":"semetey-1-2013:p0778:b004:l018","ordinal":136549,"en":"Urging your Kokcholok along,"},{"id":"semetey-1-2013:p0778:b004:l019","ordinal":136550,"en":"You have scoured the face of the earth."},{"id":"semetey-1-2013:p0778:b004:l020","ordinal":136551,"en":"Manas's wandering orphan"},{"id":"semetey-1-2013:p0778:b004:l021","ordinal":136552,"en":"You have taken as your support."},{"id":"semetey-1-2013:p0778:b004:l022","ordinal":136553,"en":"Whenever it may be, you old rogue,"},{"id":"semetey-1-2013:p0778:b004:l023","ordinal":136554,"en":"You think up wicked words,"},{"id":"semetey-1-2013:p0778:b004:l024","ordinal":136555,"en":"Never cease disrupting the people."},{"id":"semetey-1-2013:p0778:b004:l025","ordinal":136556,"en":"You have stirred strife throughout the world;"},{"id":"semetey-1-2013:p0778:b004:l026","ordinal":136557,"en":"You never tire of wickedness."},{"id":"semetey-1-2013:p0778:b004:l027","ordinal":136558,"en":"Doing this, old rogue, you will come to no good."},{"id":"semetey-1-2013:p0778:b004:l028","ordinal":136559,"en":"Bringing wickedness here,"},{"id":"semetey-1-2013:p0778:b004:l029","ordinal":136560,"en":"You have set him across my path."},{"id":"semetey-1-2013:p0778:b004:l030","ordinal":136561,"en":"Manas's orphan son"},{"id":"semetey-1-2013:p0778:b004:l031","ordinal":136562,"en":"You have brought as a bull camel against me."},{"id":"semetey-1-2013:p0778:b004:l032","ordinal":136563,"en":"In the days of your grizzled beard,"},{"id":"semetey-1-2013:p0778:b004:l033","ordinal":136564,"en":"You have done so much wickedness."},{"id":"semetey-1-2013:p0778:b004:l034","ordinal":136565,"en":"The bull camel who had died,"},{"id":"semetey-1-2013:p0778:b004:l035","ordinal":136566,"en":"Showing him as a living bull camel,"},{"id":"semetey-1-2013:p0778:b004:l036","ordinal":136567,"en":"You proclaim the glad news."},{"id":"semetey-1-2013:p0778:b004:l037","ordinal":136568,"en":"You worthless old rogue, you will come to no good;"},{"id":"semetey-1-2013:p0778:b004:l038","ordinal":136569,"en":"You will not cease your wickedness."},{"id":"semetey-1-2013:p0778:b004:l039","ordinal":136570,"en":"Your evil has reached so many people,"},{"id":"semetey-1-2013:p0779:b003:l001","ordinal":136571,"en":"Hiding yourself in Keng-Kol,"},{"id":"semetey-1-2013:p0779:b003:l002","ordinal":136572,"en":"The orphan who should have died long ago,"},{"id":"semetey-1-2013:p0779:b003:l003","ordinal":136573,"en":"You sent fleeing from broad Talas."},{"id":"semetey-1-2013:p0779:b003:l004","ordinal":136574,"en":"You damned slave Bakai,"},{"id":"semetey-1-2013:p0779:b003:l005","ordinal":136575,"en":"So much have you done,"},{"id":"semetey-1-2013:p0779:b003:l006","ordinal":136576,"en":"Hiding yourself in Talas."},{"id":"semetey-1-2013:p0779:b003:l007","ordinal":136577,"en":"The fool who should long ago have been destroyed,"},{"id":"semetey-1-2013:p0779:b003:l008","ordinal":136578,"en":"You sent fleeing on foot from Talas,"},{"id":"semetey-1-2013:p0779:b003:l009","ordinal":136579,"en":"And made my livestock plunder."},{"id":"semetey-1-2013:p0779:b003:l010","ordinal":136580,"en":"You damned slave Bakai,"},{"id":"semetey-1-2013:p0779:b003:l011","ordinal":136581,"en":"You have stirred my blood so much."},{"id":"semetey-1-2013:p0779:b003:l012","ordinal":136582,"en":"You have burned my soul like this;"},{"id":"semetey-1-2013:p0779:b003:l013","ordinal":136583,"en":"You squandered away"},{"id":"semetey-1-2013:p0779:b003:l014","ordinal":136584,"en":"My livestock in the treasury."},{"id":"semetey-1-2013:p0779:b003:l015","ordinal":136585,"en":"You turned your thoughts to wickedness,"},{"id":"semetey-1-2013:p0779:b003:l016","ordinal":136586,"en":"Grizzled slave Bakai;"},{"id":"semetey-1-2013:p0779:b003:l017","ordinal":136587,"en":"You made an eagle above my head"},{"id":"semetey-1-2013:p0779:b003:l018","ordinal":136588,"en":"Of your child left by Manas."},{"id":"semetey-1-2013:p0779:b003:l019","ordinal":136589,"en":"Now I shall ravage,"},{"id":"semetey-1-2013:p0779:b003:l020","ordinal":136590,"en":"Leveling your city,"},{"id":"semetey-1-2013:p0779:b003:l021","ordinal":136591,"en":"And offer as a sacrifice"},{"id":"semetey-1-2013:p0779:b003:l022","ordinal":136592,"en":"The child you have made your support!"},{"id":"semetey-1-2013:p0779:b003:l023","ordinal":136593,"en":"Father of the people, slave Bakai,"},{"id":"semetey-1-2013:p0779:b003:l024","ordinal":136594,"en":"Your waist girded for battle,"},{"id":"semetey-1-2013:p0779:b003:l025","ordinal":136595,"en":"I shall surely kill, slave Bakai,"},{"id":"semetey-1-2013:p0779:b003:l026","ordinal":136596,"en":"The place where you are shooting."},{"id":"semetey-1-2013:p0779:b003:l027","ordinal":136597,"en":"Today I learned, slave Bakai,"},{"id":"semetey-1-2013:p0779:b003:l028","ordinal":136598,"en":"How you and the orphan joined together,"},{"id":"semetey-1-2013:p0779:b003:l029","ordinal":136599,"en":"The words you spoke in council!"},{"id":"semetey-1-2013:p0779:b003:l030","ordinal":136600,"en":"Wicked graybeard Bakai,"},{"id":"semetey-1-2013:p0779:b003:l031","ordinal":136601,"en":"Let me rob you of your strength.”"},{"id":"semetey-1-2013:p0779:b003:l032","ordinal":136602,"en":"Raging and roaring,"},{"id":"semetey-1-2013:p0779:b003:l033","ordinal":136603,"en":"Filled with strength and thundering,"},{"id":"semetey-1-2013:p0779:b003:l034","ordinal":136604,"en":"The black, greasy pole"},{"id":"semetey-1-2013:p0779:b003:l035","ordinal":136605,"en":"He seized and swung,"},{"id":"semetey-1-2013:p0779:b003:l036","ordinal":136606,"en":"Making Bakai cry out,"},{"id":"semetey-1-2013:p0779:b003:l037","ordinal":136607,"en":"Struck him on the crown."},{"id":"semetey-1-2013:p0779:b003:l038","ordinal":136608,"en":"The pole landed powerfully;"},{"id":"semetey-1-2013:p0779:b003:l039","ordinal":136609,"en":"About four fingerbreadths of Bakai's"},{"id":"semetey-1-2013:p0779:b005:l001","ordinal":136610,"en":"Crown, upon the very top,"},{"id":"semetey-1-2013:p0779:b005:l002","ordinal":136611,"en":"Were split open."},{"id":"semetey-1-2013:p0779:b005:l003","ordinal":136612,"en":"Dear Kobosh loomed large,"},{"id":"semetey-1-2013:p0779:b005:l004","ordinal":136613,"en":"Swelling with rage,"},{"id":"semetey-1-2013:p0779:b005:l005","ordinal":136614,"en":"And reached Semetey."},{"id":"semetey-1-2013:p0779:b005:l006","ordinal":136615,"en":"With the pole, the child"},{"id":"semetey-1-2013:p0779:b005:l007","ordinal":136616,"en":"He was about to strike again,"},{"id":"semetey-1-2013:p0779:b005:l008","ordinal":136617,"en":"Than his father, wolf-maned Manas,"},{"id":"semetey-1-2013:p0779:b005:l009","ordinal":136618,"en":"This orphan had been born greater."},{"id":"semetey-1-2013:p0779:b005:l010","ordinal":136619,"en":"Before a word could be said,"},{"id":"semetey-1-2013:p0779:b005:l011","ordinal":136620,"en":"Before an eye could open and close,"},{"id":"semetey-1-2013:p0779:b005:l012","ordinal":136621,"en":"From valiant, wolf-maned Manas,"},{"id":"semetey-1-2013:p0779:b005:l013","ordinal":136622,"en":"Your dear lad left as a gift,"},{"id":"semetey-1-2013:p0779:b005:l014","ordinal":136623,"en":"The pole that would not spare him"},{"id":"semetey-1-2013:p0779:b005:l015","ordinal":136624,"en":"He tore from his hand and flung away."},{"id":"semetey-1-2013:p0779:b005:l016","ordinal":136625,"en":"He fixed his gaze upon the villain;"},{"id":"semetey-1-2013:p0779:b005:l017","ordinal":136626,"en":"Before he could twist and pull away,"},{"id":"semetey-1-2013:p0779:b005:l018","ordinal":136627,"en":"He seized the lead rope,"},{"id":"semetey-1-2013:p0779:b005:l019","ordinal":136628,"en":"Allowing Kobosh no movement,"},{"id":"semetey-1-2013:p0779:b005:l020","ordinal":136629,"en":"And held him fast."},{"id":"semetey-1-2013:p0779:b005:l021","ordinal":136630,"en":"Truly created by God,"},{"id":"semetey-1-2013:p0779:b005:l022","ordinal":136631,"en":"Have you seen that he is His servant?"},{"id":"semetey-1-2013:p0779:b005:l023","ordinal":136632,"en":"Of the poor hero Manas,"},{"id":"semetey-1-2013:p0779:b005:l024","ordinal":136633,"en":"Have you seen that he is the son?"},{"id":"semetey-1-2013:p0779:b005:l025","ordinal":136634,"en":"Zulpukor, left by Manas,"},{"id":"semetey-1-2013:p0779:b005:l026","ordinal":136635,"en":"Your dear orphan child,"},{"id":"semetey-1-2013:p0779:b005:l027","ordinal":136636,"en":"Grasping it by the hilt,"},{"id":"semetey-1-2013:p0779:b005:l028","ordinal":136637,"en":"Drew from its sheath."},{"id":"semetey-1-2013:p0779:b005:l029","ordinal":136638,"en":"When he was about to sacrifice him,"},{"id":"semetey-1-2013:p0779:b005:l030","ordinal":136639,"en":"About to sever his head,"},{"id":"semetey-1-2013:p0779:b005:l031","ordinal":136640,"en":"When Kobosh was about to perish,"},{"id":"semetey-1-2013:p0779:b005:l032","ordinal":136641,"en":"His uncle, old Bakai,"},{"id":"semetey-1-2013:p0779:b005:l033","ordinal":136642,"en":"The holy sage supported by Shay,"},{"id":"semetey-1-2013:p0779:b005:l034","ordinal":136643,"en":"“Grant me Kobosh's life,"},{"id":"semetey-1-2013:p0779:b005:l035","ordinal":136644,"en":"My dear orphan,"},{"id":"semetey-1-2013:p0779:b005:l036","ordinal":136645,"en":"Grant me his spoonful of blood!"},{"id":"semetey-1-2013:p0779:b005:l037","ordinal":136646,"en":"One who slaughters his kin will come to no good;"},{"id":"semetey-1-2013:p0779:b005:l038","ordinal":136647,"en":"An enemy does not become kin."},{"id":"semetey-1-2013:p0779:b005:l039","ordinal":136648,"en":"Can one who provokes him prosper,"},{"id":"semetey-1-2013:p0780:b003:l001","ordinal":136649,"en":"Will the Chinese become our kin?!"},{"id":"semetey-1-2013:p0780:b003:l002","ordinal":136650,"en":"If we live, my orphan,"},{"id":"semetey-1-2013:p0780:b003:l003","ordinal":136651,"en":"Tomorrow we shall settle in Talas."},{"id":"semetey-1-2013:p0780:b003:l004","ordinal":136652,"en":"‘They slaughtered Abyke,’ they will say,"},{"id":"semetey-1-2013:p0780:b003:l005","ordinal":136653,"en":"And we shall earn a wicked name."},{"id":"semetey-1-2013:p0780:b003:l006","ordinal":136654,"en":"‘Manas's son, the orphan hero,"},{"id":"semetey-1-2013:p0780:b003:l007","ordinal":136655,"en":"Found his kinsmen and went astray,’ they will say."},{"id":"semetey-1-2013:p0780:b003:l008","ordinal":136656,"en":"‘When he reached Talas,"},{"id":"semetey-1-2013:p0780:b003:l009","ordinal":136657,"en":"He slaughtered his Kobosh,’ they will say."},{"id":"semetey-1-2013:p0780:b003:l010","ordinal":136658,"en":"Many enemies will spread slander;"},{"id":"semetey-1-2013:p0780:b003:l011","ordinal":136659,"en":"Thus would God strike us."},{"id":"semetey-1-2013:p0780:b003:l012","ordinal":136660,"en":"Grant me Toruaygyr as a gift of mercy;"},{"id":"semetey-1-2013:p0780:b003:l013","ordinal":136661,"en":"Grant me your uncle's spoonful of blood."},{"id":"semetey-1-2013:p0780:b003:l014","ordinal":136662,"en":"Go and tell without reviling me,"},{"id":"semetey-1-2013:p0780:b003:l015","ordinal":136663,"en":"‘In his old age, my uncle Bakai"},{"id":"semetey-1-2013:p0780:b003:l016","ordinal":136664,"en":"Judged with great fairness,’"},{"id":"semetey-1-2013:p0780:b003:l017","ordinal":136665,"en":"Go and tell Kanykey."},{"id":"semetey-1-2013:p0780:b003:l018","ordinal":136666,"en":"Tell your khan, your grandfather Temir Khan,"},{"id":"semetey-1-2013:p0780:b003:l019","ordinal":136667,"en":"Tell all the people who know their lineage."},{"id":"semetey-1-2013:p0780:b003:l020","ordinal":136668,"en":"Your ocean-like uncle Bakai—"},{"id":"semetey-1-2013:p0780:b003:l021","ordinal":136669,"en":"Unless a person were dead,"},{"id":"semetey-1-2013:p0780:b003:l022","ordinal":136670,"en":"I used to speak such just words,"},{"id":"semetey-1-2013:p0780:b003:l024","ordinal":136671,"en":"‘My uncle speaks well indeed,’ he would say;"},{"id":"semetey-1-2013:p0780:b003:l025","ordinal":136672,"en":"My Manas used to heed my words."},{"id":"semetey-1-2013:p0780:b003:l026","ordinal":136673,"en":"Bakai has a great regret;"},{"id":"semetey-1-2013:p0780:b003:l027","ordinal":136674,"en":"Such is this treacherous world."},{"id":"semetey-1-2013:p0780:b003:l028","ordinal":136675,"en":"I did not die before ocean-like Manas,"},{"id":"semetey-1-2013:p0780:b003:l029","ordinal":136676,"en":"I did not suffer the torments of the grave."},{"id":"semetey-1-2013:p0780:b003:l030","ordinal":136677,"en":"‘My wolf-maned uncle has died,’"},{"id":"semetey-1-2013:p0780:b003:l031","ordinal":136678,"en":"‘He has seen the place of Judgment,’ saying this,"},{"id":"semetey-1-2013:p0780:b003:l032","ordinal":136679,"en":"My precious Manas did not bury me."},{"id":"semetey-1-2013:p0780:b003:l033","ordinal":136680,"en":"Living by tending camels,"},{"id":"semetey-1-2013:p0780:b003:l034","ordinal":136681,"en":"Brave Bakai, left behind by his lord,"},{"id":"semetey-1-2013:p0780:b003:l035","ordinal":136682,"en":"Has lived to see this day.”"},{"id":"semetey-1-2013:p0780:b003:l036","ordinal":136683,"en":"The honored prince Bakai"},{"id":"semetey-1-2013:p0780:b003:l037","ordinal":136684,"en":"Stood interceding,"},{"id":"semetey-1-2013:p0780:b003:l038","ordinal":136685,"en":"And the orphan restrained his anger."},{"id":"semetey-1-2013:p0780:b003:l039","ordinal":136686,"en":"Who had stirred strife in so many places—"},{"id":"semetey-1-2013:p0780:b004:l001","ordinal":136687,"en":"This troublesome Kobosh,"},{"id":"semetey-1-2013:p0780:b004:l002","ordinal":136688,"en":"Upon Toruaygyr's head"},{"id":"semetey-1-2013:p0780:b004:l003","ordinal":136689,"en":"Was Akkula's bridle."},{"id":"semetey-1-2013:p0780:b004:l004","ordinal":136690,"en":"Now he unleashed his wrath again;"},{"id":"semetey-1-2013:p0780:b004:l005","ordinal":136691,"en":"From Toruaygyr, the bridle,"},{"id":"semetey-1-2013:p0780:b004:l006","ordinal":136692,"en":"Your wolf-maned hero Semetey"},{"id":"semetey-1-2013:p0780:b004:l007","ordinal":136693,"en":"Kicked and tore away."},{"id":"semetey-1-2013:p0780:b004:l008","ordinal":136694,"en":"Once the bridle left his head,"},{"id":"semetey-1-2013:p0780:b004:l009","ordinal":136695,"en":"Would Toruaygyr stand still?"},{"id":"semetey-1-2013:p0780:b004:l010","ordinal":136696,"en":"Without dashing toward his herd,"},{"id":"semetey-1-2013:p0780:b004:l011","ordinal":136697,"en":"Would God smite the stallion?"},{"id":"semetey-1-2013:p0780:b004:l012","ordinal":136698,"en":"Accursed be his Toruaygyr!"},{"id":"semetey-1-2013:p0780:b004:l013","ordinal":136699,"en":"Neighing, he dashed away,"},{"id":"semetey-1-2013:p0780:b004:l014","ordinal":136700,"en":"Dashing toward his herd;"},{"id":"semetey-1-2013:p0780:b004:l015","ordinal":136701,"en":"Kobosh was riding bareback."},{"id":"semetey-1-2013:p0780:b004:l016","ordinal":136702,"en":"His tailbone chafed and throbbed,"},{"id":"semetey-1-2013:p0780:b004:l017","ordinal":136703,"en":"The flesh of his buttocks was battered."},{"id":"semetey-1-2013:p0780:b004:l018","ordinal":136704,"en":"Toruaygyr raced, flying along;"}]
