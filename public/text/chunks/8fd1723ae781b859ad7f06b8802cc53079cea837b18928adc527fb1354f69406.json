[{"id":"semetey-1-2013:p0629:b003:l020","ordinal":124673,"en":"When the angel of death came for him,"},{"id":"semetey-1-2013:p0629:b003:l021","ordinal":124674,"en":"He died, struck down by a shot."},{"id":"semetey-1-2013:p0629:b003:l022","ordinal":124675,"en":"Kokboru, son of Urumkan,"},{"id":"semetey-1-2013:p0629:b003:l023","ordinal":124676,"en":"Came grieving to Manas,"},{"id":"semetey-1-2013:p0629:b003:l024","ordinal":124677,"en":"Dear Koenaaly—"},{"id":"semetey-1-2013:p0629:b003:l025","ordinal":124678,"en":"That was just how he lost him."},{"id":"semetey-1-2013:p0629:b003:l026","ordinal":124679,"en":"I heard the tale from a caravan traveler;"},{"id":"semetey-1-2013:p0629:b003:l027","ordinal":124680,"en":"Tearing at his own beard,"},{"id":"semetey-1-2013:p0629:b003:l028","ordinal":124681,"en":"Kokboru, son of Urumkan,"},{"id":"semetey-1-2013:p0629:b003:l029","ordinal":124682,"en":"Returned to his homeland, I heard."},{"id":"semetey-1-2013:p0629:b003:l030","ordinal":124683,"en":"His wish must have been granted;"},{"id":"semetey-1-2013:p0629:b003:l031","ordinal":124684,"en":"The young boy at his head—"},{"id":"semetey-1-2013:p0629:b003:l032","ordinal":124685,"en":"Koenaaly must have come."},{"id":"semetey-1-2013:p0629:b003:l033","ordinal":124686,"en":"With your father, Khan Manas,"},{"id":"semetey-1-2013:p0629:b003:l036","ordinal":124687,"en":"With your heroic father, the lion,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0629:b003:l037","ordinal":124688,"en":"He must be lying as a companion!”"},{"id":"semetey-1-2013:p0629:b003:l038","ordinal":124689,"en":"Making all this known,"},{"id":"semetey-1-2013:p0629:b003:l039","ordinal":124690,"en":"Learned Bakay, the holy elder,"},{"id":"semetey-1-2013:p0629:b004:l001","ordinal":124691,"en":"From the boy's father, generous Manas,"},{"id":"semetey-1-2013:p0629:b004:l002","ordinal":124692,"en":"The old man left behind,"},{"id":"semetey-1-2013:p0629:b004:l003","ordinal":124693,"en":"All those many lands—"},{"id":"semetey-1-2013:p0629:b004:l004","ordinal":124694,"en":"The holy elder who knew and had seen them."},{"id":"semetey-1-2013:p0629:b004:l005","ordinal":124695,"en":"Your fortunate elder Bakay, the lion,"},{"id":"semetey-1-2013:p0629:b004:l006","ordinal":124696,"en":"In every sort of task"},{"id":"semetey-1-2013:p0629:b004:l007","ordinal":124697,"en":"An expert, a mighty lion."},{"id":"semetey-1-2013:p0629:b004:l008","ordinal":124698,"en":"A black stone as big as a small yurt"},{"id":"semetey-1-2013:p0629:b004:l009","ordinal":124699,"en":"Khan Bakay took up"},{"id":"semetey-1-2013:p0629:b004:l010","ordinal":124700,"en":"And firmly sealed the opening with it."},{"id":"semetey-1-2013:p0629:b004:l011","ordinal":124701,"en":"From that day to this,"},{"id":"semetey-1-2013:p0629:b004:l012","ordinal":124702,"en":"No eye can find it;"},{"id":"semetey-1-2013:p0629:b004:l013","ordinal":124703,"en":"Where it is remains unknown."},{"id":"semetey-1-2013:p0629:b004:l014","ordinal":124704,"en":"The cauldron for the sacrificial offering"},{"id":"semetey-1-2013:p0629:b004:l015","ordinal":124705,"en":"Bakay now hung above the fire."},{"id":"semetey-1-2013:p0629:b004:l016","ordinal":124706,"en":"He cut the gray male camel at the joints"},{"id":"semetey-1-2013:p0629:b004:l017","ordinal":124707,"en":"And put it into that cauldron."},{"id":"semetey-1-2013:p0629:b004:l018","ordinal":124708,"en":"That capable, dear warrior,"},{"id":"semetey-1-2013:p0629:b004:l019","ordinal":124709,"en":"Who had seen the work of many ages,"},{"id":"semetey-1-2013:p0629:b004:l020","ordinal":124710,"en":"That seasoned, dear lion!"},{"id":"semetey-1-2013:p0629:b004:l021","ordinal":124711,"en":"Dry firewood that gave no smoke"},{"id":"semetey-1-2013:p0629:b004:l022","ordinal":124712,"en":"He gathered without a moment's pause."},{"id":"semetey-1-2013:p0629:b004:l024","ordinal":124713,"en":"He struck it and made a fire;","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0629:b004:l025","ordinal":124714,"en":"Capable Bakay, the dear lion,"},{"id":"semetey-1-2013:p0629:b004:l026","ordinal":124715,"en":"Began to boil the meat."},{"id":"semetey-1-2013:p0629:b004:l027","ordinal":124716,"en":"He sent smoke flying,"},{"id":"semetey-1-2013:p0629:b004:l028","ordinal":124717,"en":"And busied himself, Khan Bakay,"},{"id":"semetey-1-2013:p0629:b004:l029","ordinal":124718,"en":"Tossing off his goatskin coat,"},{"id":"semetey-1-2013:p0629:b004:l030","ordinal":124719,"en":"Walking about broad-bodied in his shirt,"},{"id":"semetey-1-2013:p0629:b004:l031","ordinal":124720,"en":"Running about in plain sight, lumbering,"},{"id":"semetey-1-2013:p0629:b004:l032","ordinal":124721,"en":"He kept moving with a stately sway."},{"id":"semetey-1-2013:p0629:b004:l033","ordinal":124722,"en":"Your orphan left behind by Manas,"},{"id":"semetey-1-2013:p0629:b004:l034","ordinal":124723,"en":"Pillowing his head on Ak-Kangky,"},{"id":"semetey-1-2013:p0629:b004:l035","ordinal":124724,"en":"His head turned toward the qibla—"},{"id":"semetey-1-2013:p0629:b004:l036","ordinal":124725,"en":"The noble boy, the lonely orphan,"},{"id":"semetey-1-2013:p0629:b004:l037","ordinal":124726,"en":"Fell into a mighty sleep."},{"id":"semetey-1-2013:p0629:b004:l038","ordinal":124727,"en":"Khan Bakay boils the meat;"},{"id":"semetey-1-2013:p0629:b004:l039","ordinal":124728,"en":"Semetey lies asleep."},{"id":"semetey-1-2013:p0630:b003:l001","ordinal":124729,"en":"Let us leave this here,"},{"id":"semetey-1-2013:p0630:b003:l002","ordinal":124730,"en":"And of generous Manas, the warrior-lion's"},{"id":"semetey-1-2013:p0630:b003:l003","ordinal":124731,"en":"Friend for the next world, Bolokbay,"},{"id":"semetey-1-2013:p0630:b003:l004","ordinal":124732,"en":"Let us begin the tale."},{"id":"semetey-1-2013:p0630:b003:l005","ordinal":124733,"en":"Bolokbay, the lame smith,"},{"id":"semetey-1-2013:p0630:b003:l006","ordinal":124734,"en":"With the boy's father, warrior Manas,"},{"id":"semetey-1-2013:p0630:b003:l007","ordinal":124735,"en":"Shared a sheepfold for their flocks,"},{"id":"semetey-1-2013:p0630:b003:l008","ordinal":124736,"en":"Shared food as boon companions;"},{"id":"semetey-1-2013:p0630:b003:l009","ordinal":124737,"en":"Making precious things by his craft,"},{"id":"semetey-1-2013:p0630:b003:l010","ordinal":124738,"en":"He had come to settle in Talas;"},{"id":"semetey-1-2013:p0630:b003:l011","ordinal":124739,"en":"He too became a companion"},{"id":"semetey-1-2013:p0630:b003:l012","ordinal":124740,"en":"To Sultan Manas, the gray-maned hero."},{"id":"semetey-1-2013:p0630:b003:l013","ordinal":124741,"en":"When Bolokbay came to Talas,"},{"id":"semetey-1-2013:p0630:b003:l014","ordinal":124742,"en":"He raised the lame man to be khan,"},{"id":"semetey-1-2013:p0630:b003:l015","ordinal":124743,"en":"Made him a giant among the Kyrgyz people."},{"id":"semetey-1-2013:p0630:b003:l016","ordinal":124744,"en":"Every treasure, the yellow gold—"},{"id":"semetey-1-2013:p0630:b003:l017","ordinal":124745,"en":"To keep watch over it,"},{"id":"semetey-1-2013:p0630:b003:l018","ordinal":124746,"en":"He put him in charge of the treasury."},{"id":"semetey-1-2013:p0630:b003:l019","ordinal":124747,"en":"The cave where Manas stored his treasure—"},{"id":"semetey-1-2013:p0630:b003:l020","ordinal":124748,"en":"Forty guards led by Bolokbay,"},{"id":"semetey-1-2013:p0630:b003:l021","ordinal":124749,"en":"His unfortunate men who guarded Manas's cave."},{"id":"semetey-1-2013:p0630:b003:l023","ordinal":124750,"en":"Yesterday, when the great wealth was scattered,"},{"id":"semetey-1-2013:p0630:b003:l024","ordinal":124751,"en":"Taking up the orphan,"},{"id":"semetey-1-2013:p0630:b003:l025","ordinal":124752,"en":"When Kanykey fled toward Bukhara,"},{"id":"semetey-1-2013:p0630:b003:l026","ordinal":124753,"en":"The treasury cave"},{"id":"semetey-1-2013:p0630:b003:l027","ordinal":124754,"en":"Was plundered by the six scoundrels;"},{"id":"semetey-1-2013:p0630:b003:l028","ordinal":124755,"en":"Those unfortunate treasury guards—"},{"id":"semetey-1-2013:p0630:b003:l029","ordinal":124756,"en":"When their goods were pillaged,"},{"id":"semetey-1-2013:p0630:b003:l030","ordinal":124757,"en":"When havoc was firmly set loose,"},{"id":"semetey-1-2013:p0630:b003:l031","ordinal":124758,"en":"The treasury, by the six scoundrels,"},{"id":"semetey-1-2013:p0630:b003:l032","ordinal":124759,"en":"Was scattered as booty;"},{"id":"semetey-1-2013:p0630:b003:l033","ordinal":124760,"en":"Unable to find his bearings,"},{"id":"semetey-1-2013:p0630:b003:l034","ordinal":124761,"en":"Taking the forty guards with him,"},{"id":"semetey-1-2013:p0630:b003:l035","ordinal":124762,"en":"When Bolokbay fled toward the cliffs,"},{"id":"semetey-1-2013:p0630:b003:l036","ordinal":124763,"en":"Taking a short way over mountain tops,"},{"id":"semetey-1-2013:p0630:b003:l037","ordinal":124764,"en":"Saying, “If Semetey comes, I will sacrifice it to Baabedin,”"},{"id":"semetey-1-2013:p0630:b003:l039","ordinal":124765,"en":"Leading a gray two-year-old wether,"},{"id":"semetey-1-2013:p0630:b004:l001","ordinal":124766,"en":"Traveling over the summit,"},{"id":"semetey-1-2013:p0630:b004:l002","ordinal":124767,"en":"When his lord Manas died,"},{"id":"semetey-1-2013:p0630:b004:l003","ordinal":124768,"en":"And his four kinds of livestock were scattered,"},{"id":"semetey-1-2013:p0630:b004:l004","ordinal":124769,"en":"They remained for seven days;"},{"id":"semetey-1-2013:p0630:b004:l005","ordinal":124770,"en":"Bolokbay, the lame smith,"},{"id":"semetey-1-2013:p0630:b004:l006","ordinal":124771,"en":"Then went in alone and exchanged shots,"},{"id":"semetey-1-2013:p0630:b004:l007","ordinal":124772,"en":"They survived without dying,"},{"id":"semetey-1-2013:p0630:b004:l008","ordinal":124773,"en":"Fighting a terrible fight."},{"id":"semetey-1-2013:p0630:b004:l009","ordinal":124774,"en":"Abyke and Kobosh, the two scoundrels—"},{"id":"semetey-1-2013:p0630:b004:l010","ordinal":124775,"en":"From them he suffered humiliation;"},{"id":"semetey-1-2013:p0630:b004:l011","ordinal":124776,"en":"Chyybyt and Kochkor, making four scoundrels—"},{"id":"semetey-1-2013:p0630:b004:l012","ordinal":124777,"en":"From these he suffered violence;"},{"id":"semetey-1-2013:p0630:b004:l013","ordinal":124778,"en":"Azhibay and Kolbay, making six scoundrels—"},{"id":"semetey-1-2013:p0630:b004:l014","ordinal":124779,"en":"From them he suffered tyranny."},{"id":"semetey-1-2013:p0630:b004:l015","ordinal":124780,"en":"Khan Manas's forty companions"},{"id":"semetey-1-2013:p0630:b004:l016","ordinal":124781,"en":"Drew their bows, making arrows rain,"},{"id":"semetey-1-2013:p0630:b004:l017","ordinal":124782,"en":"Sent shots flying like hail,"},{"id":"semetey-1-2013:p0630:b004:l018","ordinal":124783,"en":"Thrust out spears and roared,"},{"id":"semetey-1-2013:p0630:b004:l019","ordinal":124784,"en":"All shouting “Kobosh!” as their battle cry."},{"id":"semetey-1-2013:p0630:b004:l020","ordinal":124785,"en":"Taking battle-axes, leaning back,"},{"id":"semetey-1-2013:p0630:b004:l021","ordinal":124786,"en":"The treasury of Manas"},{"id":"semetey-1-2013:p0630:b004:l022","ordinal":124787,"en":"They rushed into and wrecked."},{"id":"semetey-1-2013:p0630:b004:l023","ordinal":124788,"en":"Whole otter pelts"},{"id":"semetey-1-2013:p0630:b004:l024","ordinal":124789,"en":"They tore apart and divided;"},{"id":"semetey-1-2013:p0630:b004:l025","ordinal":124790,"en":"The forty companions left by Manas"},{"id":"semetey-1-2013:p0630:b004:l026","ordinal":124791,"en":"Used them to trim their trouser legs."},{"id":"semetey-1-2013:p0630:b004:l027","ordinal":124792,"en":"Bustling, their broad bodies looming,"},{"id":"semetey-1-2013:p0630:b004:l028","ordinal":124793,"en":"Their wineskin-like noses bobbing,"},{"id":"semetey-1-2013:p0630:b004:l029","ordinal":124794,"en":"Looting gold, hurrying about,"},{"id":"semetey-1-2013:p0630:b004:l030","ordinal":124795,"en":"Their strange pig snouts twitching."},{"id":"semetey-1-2013:p0630:b004:l031","ordinal":124796,"en":"They dealt him a cruel reckoning;"},{"id":"semetey-1-2013:p0630:b004:l032","ordinal":124797,"en":"Bolokbay's flank"},{"id":"semetey-1-2013:p0630:b004:l033","ordinal":124798,"en":"Was shot by the six scoundrels."},{"id":"semetey-1-2013:p0630:b004:l034","ordinal":124799,"en":"From the treasury, Bolokbay"},{"id":"semetey-1-2013:p0630:b004:l035","ordinal":124800,"en":"Took no fox pelt to make a cap,"},{"id":"semetey-1-2013:p0630:b004:l036","ordinal":124801,"en":"Took no valuables for his needs,"},{"id":"semetey-1-2013:p0630:b004:l037","ordinal":124802,"en":"Took no yearling colt to ride;"},{"id":"semetey-1-2013:p0630:b004:l038","ordinal":124803,"en":"Howling, weeping, grieving,"},{"id":"semetey-1-2013:p0630:b004:l039","ordinal":124804,"en":"Having lost his great lord, Khan Manas,"},{"id":"semetey-1-2013:p0631:b003:l001","ordinal":124805,"en":"Suffering violence, hardship, oppression,"},{"id":"semetey-1-2013:p0631:b003:l002","ordinal":124806,"en":"Suffering from the six scoundrels what no mortal should see."},{"id":"semetey-1-2013:p0631:b003:l004","ordinal":124807,"en":"The many treasures, the abundant gold,"},{"id":"semetey-1-2013:p0631:b003:l005","ordinal":124808,"en":"When they passed beyond his keeping,"},{"id":"semetey-1-2013:p0631:b003:l006","ordinal":124809,"en":"Without valuing the wealth a hair's breadth,"},{"id":"semetey-1-2013:p0631:b003:l007","ordinal":124810,"en":"When warrior Bolokbay let it scatter,"},{"id":"semetey-1-2013:p0631:b003:l008","ordinal":124811,"en":"Unable to find his bearings,"},{"id":"semetey-1-2013:p0631:b003:l009","ordinal":124812,"en":"Kayypchy's dark cave—"},{"id":"semetey-1-2013:p0631:b003:l010","ordinal":124813,"en":"When he fled toward the dark cave,"},{"id":"semetey-1-2013:p0631:b003:l011","ordinal":124814,"en":"The six scoundrels wrecked his settlement."},{"id":"semetey-1-2013:p0631:b003:l012","ordinal":124815,"en":"Your poor man left behind by Manas,"},{"id":"semetey-1-2013:p0631:b003:l013","ordinal":124816,"en":"Skirting Kara-Too,"},{"id":"semetey-1-2013:p0631:b003:l014","ordinal":124817,"en":"Saying, “When will my dear Semetey come?”"},{"id":"semetey-1-2013:p0631:b003:l016","ordinal":124818,"en":"The wretched man passed his days,"},{"id":"semetey-1-2013:p0631:b003:l017","ordinal":124819,"en":"Placing his hopes in Semetey."},{"id":"semetey-1-2013:p0631:b003:l018","ordinal":124820,"en":"That was after Khan Manas had died,"},{"id":"semetey-1-2013:p0631:b003:l019","ordinal":124821,"en":"When Bolokbay fled and wandered,"},{"id":"semetey-1-2013:p0631:b003:l020","ordinal":124822,"en":"Making his living among the great cliffs."},{"id":"semetey-1-2013:p0631:b003:l021","ordinal":124823,"en":"Roaming through Kangshaak-Tash,"},{"id":"semetey-1-2013:p0631:b003:l022","ordinal":124824,"en":"Sheltering in the dark cave,"},{"id":"semetey-1-2013:p0631:b003:l023","ordinal":124825,"en":"Not dead, not in a grave,"},{"id":"semetey-1-2013:p0631:b003:l024","ordinal":124826,"en":"Bolokbay at that time,"},{"id":"semetey-1-2013:p0631:b003:l025","ordinal":124827,"en":"With his forty guards foremost,"},{"id":"semetey-1-2013:p0631:b003:l026","ordinal":124828,"en":"Was not counted among the living."},{"id":"semetey-1-2013:p0631:b003:l027","ordinal":124829,"en":"That night Bolokbay"},{"id":"semetey-1-2013:p0631:b003:l028","ordinal":124830,"en":"Woke with a start from sleep,"},{"id":"semetey-1-2013:p0631:b003:l030","ordinal":124831,"en":"His only Semetey had entered his dream.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0631:b003:l031","ordinal":124832,"en":"Crying, “Baabedin!”"},{"id":"semetey-1-2013:p0631:b003:l032","ordinal":124833,"en":"He called his guards."},{"id":"semetey-1-2013:p0631:b003:l033","ordinal":124834,"en":"Bolokbay, himself a hunter,"},{"id":"semetey-1-2013:p0631:b003:l034","ordinal":124835,"en":"Went scouting through the foothills;"},{"id":"semetey-1-2013:p0631:b003:l035","ordinal":124836,"en":"Six wild ewes and four wild rams"},{"id":"semetey-1-2013:p0631:b003:l036","ordinal":124837,"en":"Bolokbay shot and took,"},{"id":"semetey-1-2013:p0631:b003:l037","ordinal":124838,"en":"And on top of the dark cliff"},{"id":"semetey-1-2013:p0631:b003:l038","ordinal":124839,"en":"Offered them to Baabedin."},{"id":"semetey-1-2013:p0631:b003:l039","ordinal":124840,"en":"Then Bolokbay, the lame smith—"},{"id":"semetey-1-2013:p0631:b004:l001","ordinal":124841,"en":"Mist stirred above;"},{"id":"semetey-1-2013:p0631:b004:l002","ordinal":124842,"en":"Dootu and Bolokbay"},{"id":"semetey-1-2013:p0631:b004:l003","ordinal":124843,"en":"Were friends for the next world."},{"id":"semetey-1-2013:p0631:b004:l004","ordinal":124844,"en":"He was that peerless smith, that warrior;"},{"id":"semetey-1-2013:p0631:b004:l005","ordinal":124845,"en":"As he lay sleeping,"},{"id":"semetey-1-2013:p0631:b004:l006","ordinal":124846,"en":"Of the boy Semetey"},{"id":"semetey-1-2013:p0631:b004:l007","ordinal":124847,"en":"He had seen a sign just then."},{"id":"semetey-1-2013:p0631:b004:l008","ordinal":124848,"en":"“My dear forty guards,"},{"id":"semetey-1-2013:p0631:b004:l009","ordinal":124849,"en":"Who fled and wandered in the mountains,"},{"id":"semetey-1-2013:p0631:b004:l010","ordinal":124850,"en":"My wretched guards, come here!"},{"id":"semetey-1-2013:p0631:b004:l011","ordinal":124851,"en":"Deprived of the treasury,"},{"id":"semetey-1-2013:p0631:b004:l012","ordinal":124852,"en":"My emaciated guards, come here!"},{"id":"semetey-1-2013:p0631:b004:l013","ordinal":124853,"en":"My dear forty guards,"},{"id":"semetey-1-2013:p0631:b004:l014","ordinal":124854,"en":"Is there a night like the Night of Power?"},{"id":"semetey-1-2013:p0631:b004:l015","ordinal":124855,"en":"Will the day come when Semetey returns?"},{"id":"semetey-1-2013:p0631:b004:l016","ordinal":124856,"en":"With my honor restored thus,"},{"id":"semetey-1-2013:p0631:b004:l017","ordinal":124857,"en":"Your exposed places covered,"},{"id":"semetey-1-2013:p0631:b004:l018","ordinal":124858,"en":"All grief scattered,"},{"id":"semetey-1-2013:p0631:b004:l019","ordinal":124859,"en":"All pent-up anguish released,"},{"id":"semetey-1-2013:p0631:b004:l020","ordinal":124860,"en":"Will the day come when Semetey returns?"},{"id":"semetey-1-2013:p0631:b004:l021","ordinal":124861,"en":"We fled to the mountains for our lives,"},{"id":"semetey-1-2013:p0631:b004:l022","ordinal":124862,"en":"Praying hard to the true God;"},{"id":"semetey-1-2013:p0631:b004:l023","ordinal":124863,"en":"Your staying alive and well"},{"id":"semetey-1-2013:p0631:b004:l024","ordinal":124864,"en":"Is for the boy Semetey alone."},{"id":"semetey-1-2013:p0631:b004:l025","ordinal":124865,"en":"If my orphan is still alive,"},{"id":"semetey-1-2013:p0631:b004:l026","ordinal":124866,"en":"He must have reached twelve years;"},{"id":"semetey-1-2013:p0631:b004:l027","ordinal":124867,"en":"Kanykey, reckoning the time,"},{"id":"semetey-1-2013:p0631:b004:l028","ordinal":124868,"en":"Must have chosen this year to send him."},{"id":"semetey-1-2013:p0631:b004:l029","ordinal":124869,"en":"My dear forty guards,"},{"id":"semetey-1-2013:p0631:b004:l030","ordinal":124870,"en":"This wretch's eyelid"},{"id":"semetey-1-2013:p0631:b004:l031","ordinal":124871,"en":"Keeps fluttering, twitching hard."},{"id":"semetey-1-2013:p0631:b004:l032","ordinal":124872,"en":"What can this mean?"},{"id":"semetey-1-2013:p0631:b004:l033","ordinal":124873,"en":"Interpret this sign of mine!"},{"id":"semetey-1-2013:p0631:b004:l034","ordinal":124874,"en":"My dear forty guards,"},{"id":"semetey-1-2013:p0631:b004:l035","ordinal":124875,"en":"May generous Manas never die,"},{"id":"semetey-1-2013:p0631:b004:l036","ordinal":124876,"en":"May this poor soul never suffer!"},{"id":"semetey-1-2013:p0631:b004:l037","ordinal":124877,"en":"Skirting the mountains, seeing no people,"},{"id":"semetey-1-2013:p0631:b004:l038","ordinal":124878,"en":"Seeing no land of famous Talas,"},{"id":"semetey-1-2013:p0631:b004:l039","ordinal":124879,"en":"Seeing no white-kalpak Kyrgyz people,"}]
