[{"id":"semetey-1-2013:p0975:b004:l031","ordinal":151553,"en":"The white swan tore itself free"},{"id":"semetey-1-2013:p0975:b004:l032","ordinal":151554,"en":"And escaped into the deep water."},{"id":"semetey-1-2013:p0975:b004:l033","ordinal":151555,"en":"Where he waded into Ala-Köl,"},{"id":"semetey-1-2013:p0975:b004:l034","ordinal":151556,"en":"The lake caught the swaggering madman"},{"id":"semetey-1-2013:p0975:b004:l035","ordinal":151557,"en":"By the throat."},{"id":"semetey-1-2013:p0975:b004:l036","ordinal":151558,"en":"He pulled back in grief,"},{"id":"semetey-1-2013:p0975:b004:l037","ordinal":151559,"en":"And Semetey, still bewildered,"},{"id":"semetey-1-2013:p0975:b004:l038","ordinal":151560,"en":"Ran toward Arbuudan."},{"id":"semetey-1-2013:p0975:b004:l039","ordinal":151561,"en":"What could the desperate prince do?"},{"id":"semetey-1-2013:p0976:b003:l001","ordinal":151562,"en":"Toward Buurul, standing riderless,"},{"id":"semetey-1-2013:p0976:b003:l002","ordinal":151563,"en":"The bewildered Semetey"},{"id":"semetey-1-2013:p0976:b003:l003","ordinal":151564,"en":"Ran and mounted in haste."},{"id":"semetey-1-2013:p0976:b003:l004","ordinal":151565,"en":"Kojosán’s falcon—"},{"id":"semetey-1-2013:p0976:b003:l005","ordinal":151566,"en":"That white swan would not release it;"},{"id":"semetey-1-2013:p0976:b003:l006","ordinal":151567,"en":"It clenched the short leash,"},{"id":"semetey-1-2013:p0976:b003:l007","ordinal":151568,"en":"Tucked it beneath its wing,"},{"id":"semetey-1-2013:p0976:b003:l008","ordinal":151569,"en":"Beat the water with its tail,"},{"id":"semetey-1-2013:p0976:b003:l009","ordinal":151570,"en":"And thrashed the dark lake with its wings."},{"id":"semetey-1-2013:p0976:b003:l010","ordinal":151571,"en":"It went farther downward,"},{"id":"semetey-1-2013:p0976:b003:l011","ordinal":151572,"en":"Then sped away like the wind;"},{"id":"semetey-1-2013:p0976:b003:l012","ordinal":151573,"en":"When he looked, it vanished from sight."},{"id":"semetey-1-2013:p0976:b003:l013","ordinal":151574,"en":"The great white swan was escaping,"},{"id":"semetey-1-2013:p0976:b003:l014","ordinal":151575,"en":"And no one could tell which it was."},{"id":"semetey-1-2013:p0976:b003:l015","ordinal":151576,"en":"Your young, blue-maned prince"},{"id":"semetey-1-2013:p0976:b003:l016","ordinal":151577,"en":"Had a true courser beneath him,"},{"id":"semetey-1-2013:p0976:b003:l017","ordinal":151578,"en":"Which raced with a flying bird;"},{"id":"semetey-1-2013:p0976:b003:l018","ordinal":151579,"en":"The white reins steeped in tanning liquor"},{"id":"semetey-1-2013:p0976:b003:l019","ordinal":151580,"en":"Contracted within his palm."},{"id":"semetey-1-2013:p0976:b003:l020","ordinal":151581,"en":"He pursued the white swan"},{"id":"semetey-1-2013:p0976:b003:l021","ordinal":151582,"en":"Upon the true tulpar Buurul."},{"id":"semetey-1-2013:p0976:b003:l022","ordinal":151583,"en":"The falcon it had carried away—"},{"id":"semetey-1-2013:p0976:b003:l023","ordinal":151584,"en":"Such was that white swan’s uncanny power."},{"id":"semetey-1-2013:p0976:b003:l024","ordinal":151585,"en":"With a camel-like forelock and swept-back mane,"},{"id":"semetey-1-2013:p0976:b003:l025","ordinal":151586,"en":"Buurul was a true courser;"},{"id":"semetey-1-2013:p0976:b003:l026","ordinal":151587,"en":"He laid his ears flat like a wild ass,"},{"id":"semetey-1-2013:p0976:b003:l027","ordinal":151588,"en":"And with no escape in sight,"},{"id":"semetey-1-2013:p0976:b003:l028","ordinal":151589,"en":"Churned the earth like a whirlwind."},{"id":"semetey-1-2013:p0976:b003:l029","ordinal":151590,"en":"He gathered himself in bounding strides,"},{"id":"semetey-1-2013:p0976:b003:l030","ordinal":151591,"en":"And surged as though diving into a hollow."},{"id":"semetey-1-2013:p0976:b003:l031","ordinal":151592,"en":"From a ridge curved like a saddle bow,"},{"id":"semetey-1-2013:p0976:b003:l032","ordinal":151593,"en":"He bent low and entered beyond it."},{"id":"semetey-1-2013:p0976:b003:l033","ordinal":151594,"en":"They drew close;"},{"id":"semetey-1-2013:p0976:b003:l034","ordinal":151595,"en":"Your swaggering madman"},{"id":"semetey-1-2013:p0976:b003:l035","ordinal":151596,"en":"Raised the patterned spear in his hand"},{"id":"semetey-1-2013:p0976:b003:l036","ordinal":151597,"en":"And cast it badly."},{"id":"semetey-1-2013:p0976:b003:l037","ordinal":151598,"en":"Seeing that escape was impossible,"},{"id":"semetey-1-2013:p0976:b003:l038","ordinal":151599,"en":"What could poor Chürök do?"},{"id":"semetey-1-2013:p0976:b003:l039","ordinal":151600,"en":"It farted with a crack and shat with a snap,"},{"id":"semetey-1-2013:p0976:b004:l001","ordinal":151601,"en":"And cast down a walking fog."},{"id":"semetey-1-2013:p0976:b004:l002","ordinal":151602,"en":"When he looked, nothing could be seen,"},{"id":"semetey-1-2013:p0976:b004:l003","ordinal":151603,"en":"And no one knew where it was."},{"id":"semetey-1-2013:p0976:b004:l004","ordinal":151604,"en":"Clouds split open in the sky,"},{"id":"semetey-1-2013:p0976:b004:l005","ordinal":151605,"en":"And rain poured onto the earth;"},{"id":"semetey-1-2013:p0976:b004:l006","ordinal":151606,"en":"Clouds wheeled across the heavens,"},{"id":"semetey-1-2013:p0976:b004:l007","ordinal":151607,"en":"And eight months’ hail poured down."},{"id":"semetey-1-2013:p0976:b004:l008","ordinal":151608,"en":"A squall went shrieking,"},{"id":"semetey-1-2013:p0976:b004:l009","ordinal":151609,"en":"Through ravine, slope, and plain;"},{"id":"semetey-1-2013:p0976:b004:l010","ordinal":151610,"en":"A foul fog roared,"},{"id":"semetey-1-2013:p0976:b004:l011","ordinal":151611,"en":"And a walking mist descended and blinded the eyes."},{"id":"semetey-1-2013:p0976:b004:l012","ordinal":151612,"en":"Rain covered every lowland,"},{"id":"semetey-1-2013:p0976:b004:l013","ordinal":151613,"en":"Hail covered every upland,"},{"id":"semetey-1-2013:p0976:b004:l014","ordinal":151614,"en":"And the sun was hidden from view."},{"id":"semetey-1-2013:p0976:b004:l015","ordinal":151615,"en":"The falcon was carried away,"},{"id":"semetey-1-2013:p0976:b004:l016","ordinal":151616,"en":"And that Chürök escaped."},{"id":"semetey-1-2013:p0976:b004:l017","ordinal":151617,"en":"Nar Buurul opened his stride;"},{"id":"semetey-1-2013:p0976:b004:l018","ordinal":151618,"en":"The tiger, his father Manas,"},{"id":"semetey-1-2013:p0976:b004:l019","ordinal":151619,"en":"Seemed to have died that very day."},{"id":"semetey-1-2013:p0976:b004:l020","ordinal":151620,"en":"The tiger grieved,"},{"id":"semetey-1-2013:p0976:b004:l021","ordinal":151621,"en":"Having lost Akshunkar;"},{"id":"semetey-1-2013:p0976:b004:l022","ordinal":151622,"en":"His anger rose and his face darkened,"},{"id":"semetey-1-2013:p0976:b004:l023","ordinal":151623,"en":"And his dark rage swelled."},{"id":"semetey-1-2013:p0976:b004:l024","ordinal":151624,"en":"He shouted in fury,"},{"id":"semetey-1-2013:p0976:b004:l025","ordinal":151625,"en":"Calling Kulchoro and Kanchoro,"},{"id":"semetey-1-2013:p0976:b004:l026","ordinal":151626,"en":"Summoning the two of them."},{"id":"semetey-1-2013:p0976:b004:l027","ordinal":151627,"en":"His bellow split heads,"},{"id":"semetey-1-2013:p0976:b004:l028","ordinal":151628,"en":"His cry split stones;"},{"id":"semetey-1-2013:p0976:b004:l029","ordinal":151629,"en":"His eyes blazed like a lion’s,"},{"id":"semetey-1-2013:p0976:b004:l030","ordinal":151630,"en":"And bloodlust truly seized him."},{"id":"semetey-1-2013:p0976:b004:l031","ordinal":151631,"en":"He blackened in his dark fury,"},{"id":"semetey-1-2013:p0976:b004:l032","ordinal":151632,"en":"And when the exhausted prince stood there,"},{"id":"semetey-1-2013:p0976:b004:l033","ordinal":151633,"en":"Kulchoro and Kanchoro,"},{"id":"semetey-1-2013:p0976:b004:l034","ordinal":151634,"en":"The two choros, raced one another,"},{"id":"semetey-1-2013:p0976:b004:l035","ordinal":151635,"en":"Their stirrups striking together;"},{"id":"semetey-1-2013:p0976:b004:l036","ordinal":151636,"en":"They fought the bits"},{"id":"semetey-1-2013:p0976:b004:l037","ordinal":151637,"en":"Of their two equal tulpars."},{"id":"semetey-1-2013:p0976:b004:l038","ordinal":151638,"en":"When they drew near the prince,"},{"id":"semetey-1-2013:p0976:b004:l039","ordinal":151639,"en":"He poured out bitter reproaches,"},{"id":"semetey-1-2013:p0977:b003:l001","ordinal":151640,"en":"When the two equal warrior choros"},{"id":"semetey-1-2013:p0977:b003:l002","ordinal":151641,"en":"Had caused this calamity,"},{"id":"semetey-1-2013:p0977:b003:l003","ordinal":151642,"en":"“You let the swan take it;"},{"id":"semetey-1-2013:p0977:b003:l004","ordinal":151643,"en":"My poor elder, lay the blame on me!”"},{"id":"semetey-1-2013:p0977:b003:l005","ordinal":151644,"en":"Thus spoke Kulchoro."},{"id":"semetey-1-2013:p0977:b003:l006","ordinal":151645,"en":"Then Kanchoro stood and said:"},{"id":"semetey-1-2013:p0977:b003:l007","ordinal":151646,"en":"“It was a swan come from Mecca,"},{"id":"semetey-1-2013:p0977:b003:l008","ordinal":151647,"en":"And it had five young;"},{"id":"semetey-1-2013:p0977:b003:l009","ordinal":151648,"en":"It was a being of wondrous power."},{"id":"semetey-1-2013:p0977:b003:l010","ordinal":151649,"en":"Brave elder, lay the blame on me!”"},{"id":"semetey-1-2013:p0977:b003:l011","ordinal":151650,"en":"“Grant us as a gift, elder, grant us!” they said."},{"id":"semetey-1-2013:p0977:b003:l012","ordinal":151651,"en":"The two bastards, fierce as flames,"},{"id":"semetey-1-2013:p0977:b003:l013","ordinal":151652,"en":"Thought the prince would kill them."},{"id":"semetey-1-2013:p0977:b003:l014","ordinal":151653,"en":"Speaking pitiful, bitter words,"},{"id":"semetey-1-2013:p0977:b003:l015","ordinal":151654,"en":"They cried, “Mercy, grant us our lives!”"},{"id":"semetey-1-2013:p0977:b003:l016","ordinal":151655,"en":"And the two wretches kept pleading."},{"id":"semetey-1-2013:p0977:b003:l017","ordinal":151656,"en":"Brave Semetey then said:"},{"id":"semetey-1-2013:p0977:b003:l018","ordinal":151657,"en":"“My cliff no goose can circle,"},{"id":"semetey-1-2013:p0977:b003:l019","ordinal":151658,"en":"Kanchoro and Kulchoro,"},{"id":"semetey-1-2013:p0977:b003:l020","ordinal":151659,"en":"My mountains standing watch,"},{"id":"semetey-1-2013:p0977:b003:l021","ordinal":151660,"en":"My steel battle-axe in hand,"},{"id":"semetey-1-2013:p0977:b003:l022","ordinal":151661,"en":"Whose sight fills my belly,"},{"id":"semetey-1-2013:p0977:b003:l023","ordinal":151662,"en":"My two sheltering supports!"},{"id":"semetey-1-2013:p0977:b003:l024","ordinal":151663,"en":"I have nine thousand horses in the mountains,"},{"id":"semetey-1-2013:p0977:b003:l025","ordinal":151664,"en":"Yet no courser fit to ride the hunt."},{"id":"semetey-1-2013:p0977:b003:l026","ordinal":151665,"en":"Do not torment your elder;"},{"id":"semetey-1-2013:p0977:b003:l027","ordinal":151666,"en":"I have no kin apart from you two."},{"id":"semetey-1-2013:p0977:b003:l028","ordinal":151667,"en":"You kicked together like young colts,"},{"id":"semetey-1-2013:p0977:b003:l029","ordinal":151668,"en":"Can such a calamity befall us,"},{"id":"semetey-1-2013:p0977:b003:l030","ordinal":151669,"en":"You who struggled for the same breast?"},{"id":"semetey-1-2013:p0977:b003:l031","ordinal":151670,"en":"My fortunate choros, both of you, listen!"},{"id":"semetey-1-2013:p0977:b003:l032","ordinal":151671,"en":"Many people have flown falcons,"},{"id":"semetey-1-2013:p0977:b003:l033","ordinal":151672,"en":"And many mortals have tasted joy."},{"id":"semetey-1-2013:p0977:b003:l034","ordinal":151673,"en":"Our dream has broken apart."},{"id":"semetey-1-2013:p0977:b003:l035","ordinal":151674,"en":"Trace this grievous event"},{"id":"semetey-1-2013:p0977:b003:l036","ordinal":151675,"en":"Through the lines of tradition;"},{"id":"semetey-1-2013:p0977:b003:l037","ordinal":151676,"en":"Ask the learned men"},{"id":"semetey-1-2013:p0977:b003:l038","ordinal":151677,"en":"About this affliction we have seen!"},{"id":"semetey-1-2013:p0977:b003:l039","ordinal":151678,"en":"Tell the long-lived elders,"},{"id":"semetey-1-2013:p0977:b005:l001","ordinal":151679,"en":"Tell those whose ears hear far."},{"id":"semetey-1-2013:p0977:b005:l002","ordinal":151680,"en":"They used to say that when a bird was flown at a swan,"},{"id":"semetey-1-2013:p0977:b005:l003","ordinal":151681,"en":"If the falcon was a true killer,"},{"id":"semetey-1-2013:p0977:b005:l004","ordinal":151682,"en":"It would take its swan;"},{"id":"semetey-1-2013:p0977:b005:l005","ordinal":151683,"en":"If that falcon failed to take it,"},{"id":"semetey-1-2013:p0977:b005:l006","ordinal":151684,"en":"The swan would escape into the sky"},{"id":"semetey-1-2013:p0977:b005:l007","ordinal":151685,"en":"And the bird itself would remain."},{"id":"semetey-1-2013:p0977:b005:l008","ordinal":151686,"en":"The swan is gone, and so is the bird—"},{"id":"semetey-1-2013:p0977:b005:l009","ordinal":151687,"en":"Is this a day of God’s punishment?"},{"id":"semetey-1-2013:p0977:b005:l010","ordinal":151688,"en":"Was the falcon’s flight away"},{"id":"semetey-1-2013:p0977:b005:l011","ordinal":151689,"en":"Some enchantment that blinded our eyes?"},{"id":"semetey-1-2013:p0977:b005:l012","ordinal":151690,"en":"My two companion equals,"},{"id":"semetey-1-2013:p0977:b005:l013","ordinal":151691,"en":"Because of what has happened,"},{"id":"semetey-1-2013:p0977:b005:l014","ordinal":151692,"en":"Because of Akshunkar,"},{"id":"semetey-1-2013:p0977:b005:l015","ordinal":151693,"en":"I shall scour the whole earth on horseback."},{"id":"semetey-1-2013:p0977:b005:l016","ordinal":151694,"en":"Of the eighteen thousand worlds,"},{"id":"semetey-1-2013:p0977:b005:l017","ordinal":151695,"en":"I shall leave none unvisited."},{"id":"semetey-1-2013:p0977:b005:l018","ordinal":151696,"en":"From Kakan and Beijing,"},{"id":"semetey-1-2013:p0977:b005:l019","ordinal":151697,"en":"From the Black Chinese and the Solon,"},{"id":"semetey-1-2013:p0977:b005:l020","ordinal":151698,"en":"From the bearded Russians,"},{"id":"semetey-1-2013:p0977:b005:l021","ordinal":151699,"en":"And from the muskets before our brows,"},{"id":"semetey-1-2013:p0977:b005:l022","ordinal":151700,"en":"I shall seek news everywhere"},{"id":"semetey-1-2013:p0977:b005:l023","ordinal":151701,"en":"Concerning Akshunkar."},{"id":"semetey-1-2013:p0977:b005:l024","ordinal":151702,"en":"I shall gird my waist firmly;"},{"id":"semetey-1-2013:p0977:b005:l025","ordinal":151703,"en":"Because of Akshunkar,"},{"id":"semetey-1-2013:p0977:b005:l026","ordinal":151704,"en":"I shall raise an uproar wherever I confront a foe."},{"id":"semetey-1-2013:p0977:b005:l027","ordinal":151705,"en":"I shall put on armor no bullet can pierce;"},{"id":"semetey-1-2013:p0977:b005:l028","ordinal":151706,"en":"Because of this falcon,"},{"id":"semetey-1-2013:p0977:b005:l029","ordinal":151707,"en":"I shall grapple with every mighty man."},{"id":"semetey-1-2013:p0977:b005:l030","ordinal":151708,"en":"Because of what has happened,"},{"id":"semetey-1-2013:p0977:b005:l031","ordinal":151709,"en":"Because of Akshunkar,"},{"id":"semetey-1-2013:p0977:b005:l032","ordinal":151710,"en":"I shall scatter as tribute"},{"id":"semetey-1-2013:p0977:b005:l033","ordinal":151711,"en":"The countless gold coins left by Manas."},{"id":"semetey-1-2013:p0977:b005:l034","ordinal":151712,"en":"I shall gird my renowned waist;"},{"id":"semetey-1-2013:p0977:b005:l035","ordinal":151713,"en":"Because of this falcon,"},{"id":"semetey-1-2013:p0977:b005:l036","ordinal":151714,"en":"I shall lay hands upon whoever stands against me.”"},{"id":"semetey-1-2013:p0977:b005:l037","ordinal":151715,"en":"Kulchoro and Kanchoro"},{"id":"semetey-1-2013:p0977:b005:l038","ordinal":151716,"en":"Went to tell my tiger elder Bakay"},{"id":"semetey-1-2013:p0977:b005:l039","ordinal":151717,"en":"That Akshunkar had flown away,"},{"id":"semetey-1-2013:p0978:b003:l001","ordinal":151718,"en":"It was a wondrous slave-woman—"},{"id":"semetey-1-2013:p0978:b003:l002","ordinal":151719,"en":"Tell my wretched mother, the fierce one!"},{"id":"semetey-1-2013:p0978:b003:l003","ordinal":151720,"en":"Tell Sarykan of the bowl-shaped eyes,"},{"id":"semetey-1-2013:p0978:b003:l004","ordinal":151721,"en":"Tell my wise elder, the hero!"},{"id":"semetey-1-2013:p0978:b003:l005","ordinal":151722,"en":"Tell Jamgyrchy of the Esheks,"},{"id":"semetey-1-2013:p0978:b003:l006","ordinal":151723,"en":"Tell the sage who has seen so much!"},{"id":"semetey-1-2013:p0978:b003:l007","ordinal":151724,"en":"Tell the broad-backed woman"},{"id":"semetey-1-2013:p0978:b003:l008","ordinal":151725,"en":"Who once tangled herself in my reins"},{"id":"semetey-1-2013:p0978:b003:l009","ordinal":151726,"en":"And remained screaming and weeping!"},{"id":"semetey-1-2013:p0978:b003:l010","ordinal":151727,"en":"If she knows news of the falcon,"},{"id":"semetey-1-2013:p0978:b003:l011","ordinal":151728,"en":"Let her tell it swiftly, without delay;"},{"id":"semetey-1-2013:p0978:b003:l012","ordinal":151729,"en":"Let her speak at once, without grieving a soul."},{"id":"semetey-1-2013:p0978:b003:l013","ordinal":151730,"en":"If she knows where the falcon went,"},{"id":"semetey-1-2013:p0978:b003:l014","ordinal":151731,"en":"And tells its secret plainly,"},{"id":"semetey-1-2013:p0978:b003:l015","ordinal":151732,"en":"Then I shall not raise my whip"},{"id":"semetey-1-2013:p0978:b003:l016","ordinal":151733,"en":"Against your sister-in-law again;"},{"id":"semetey-1-2013:p0978:b003:l017","ordinal":151734,"en":"I shall say neither this nor that,"},{"id":"semetey-1-2013:p0978:b003:l018","ordinal":151735,"en":"And shall not take another wife beneath her."},{"id":"semetey-1-2013:p0978:b003:l019","ordinal":151736,"en":"If she says the falcon went by this road,"},{"id":"semetey-1-2013:p0978:b003:l020","ordinal":151737,"en":"And afterward I deny my word,"},{"id":"semetey-1-2013:p0978:b003:l021","ordinal":151738,"en":"May the open sky strike my crown!"},{"id":"semetey-1-2013:p0978:b003:l022","ordinal":151739,"en":"May the hairy earth strike my breast!"},{"id":"semetey-1-2013:p0978:b003:l023","ordinal":151740,"en":"May God Almighty strike me!"},{"id":"semetey-1-2013:p0978:b003:l024","ordinal":151741,"en":"May Akkelte’s bullet strike me!"},{"id":"semetey-1-2013:p0978:b003:l025","ordinal":151742,"en":"If that woman makes an empty boast,"},{"id":"semetey-1-2013:p0978:b003:l026","ordinal":151743,"en":"May the oath I have spoken strike her!”"},{"id":"semetey-1-2013:p0978:b003:l027","ordinal":151744,"en":"Speaking words of greeting and prayer,"},{"id":"semetey-1-2013:p0978:b003:l028","ordinal":151745,"en":"And voicing his bitter lament,"},{"id":"semetey-1-2013:p0978:b003:l029","ordinal":151746,"en":"Semetey, the son of Manas,"},{"id":"semetey-1-2013:p0978:b003:l030","ordinal":151747,"en":"As though his father, the lion Manas,"},{"id":"semetey-1-2013:p0978:b003:l031","ordinal":151748,"en":"Had died that very day,"},{"id":"semetey-1-2013:p0978:b003:l032","ordinal":151749,"en":"Removed the saddle from camel-like Buurul"},{"id":"semetey-1-2013:p0978:b003:l033","ordinal":151750,"en":"And left him bare,"},{"id":"semetey-1-2013:p0978:b003:l034","ordinal":151751,"en":"Hobbled and tethered him,"},{"id":"semetey-1-2013:p0978:b003:l035","ordinal":151752,"en":"Set the leather saddle cloth and blue pad"},{"id":"semetey-1-2013:p0978:b003:l036","ordinal":151753,"en":"Against his own hip,"},{"id":"semetey-1-2013:p0978:b003:l037","ordinal":151754,"en":"Appealed to the Creator,"},{"id":"semetey-1-2013:p0978:b003:l038","ordinal":151755,"en":"And made the Akkangky his pillow."},{"id":"semetey-1-2013:p0978:b003:l039","ordinal":151756,"en":"The noble man’s brave son"},{"id":"semetey-1-2013:p0978:b004:l001","ordinal":151757,"en":"Lay with his head toward the qibla,"},{"id":"semetey-1-2013:p0978:b004:l002","ordinal":151758,"en":"Wrapped himself in the Akolpok,"},{"id":"semetey-1-2013:p0978:b004:l003","ordinal":151759,"en":"And if you had seen Semetey,"},{"id":"semetey-1-2013:p0978:b004:l004","ordinal":151760,"en":"He raged like a lion,"},{"id":"semetey-1-2013:p0978:b004:l005","ordinal":151761,"en":"Flame sputtering from his mouth,"},{"id":"semetey-1-2013:p0978:b004:l006","ordinal":151762,"en":"Sobbing, “My falcon!”"},{"id":"semetey-1-2013:p0978:b004:l007","ordinal":151763,"en":"He scattered as though seeing darkest night,"},{"id":"semetey-1-2013:p0978:b004:l008","ordinal":151764,"en":"Having lost Akshunkar."},{"id":"semetey-1-2013:p0978:b004:l009","ordinal":151765,"en":"The dear lion, huge as a fighting cock,"},{"id":"semetey-1-2013:p0978:b004:l010","ordinal":151766,"en":"Lay motionless upon the plain."},{"id":"semetey-1-2013:p0978:b004:l011","ordinal":151767,"en":"He grasped the bulungur brass flute"},{"id":"semetey-1-2013:p0978:b004:l012","ordinal":151768,"en":"By its corner and drew it close."},{"id":"semetey-1-2013:p0978:b004:l013","ordinal":151769,"en":"The sorrowing woman Chachykey"},{"id":"semetey-1-2013:p0978:b004:l014","ordinal":151770,"en":"Had sent her two younger brothers;"},{"id":"semetey-1-2013:p0978:b004:l015","ordinal":151771,"en":"Semetey lay in grief,"},{"id":"semetey-1-2013:p0978:b004:l016","ordinal":151772,"en":"As though Kanykey herself had died."},{"id":"semetey-1-2013:p0978:b004:l017","ordinal":151773,"en":"His outstretched leg would not draw in,"},{"id":"semetey-1-2013:p0978:b004:l018","ordinal":151774,"en":"His closed eyes would not open,"},{"id":"semetey-1-2013:p0978:b004:l019","ordinal":151775,"en":"And his sighing would not cease;"},{"id":"semetey-1-2013:p0978:b004:l020","ordinal":151776,"en":"Your blue-maned champion lay sprawled."},{"id":"semetey-1-2013:p0978:b004:l021","ordinal":151777,"en":"He tied Buurul at the grazing line,"},{"id":"semetey-1-2013:p0978:b004:l022","ordinal":151778,"en":"And your magnanimous hero lay swollen with grief."},{"id":"semetey-1-2013:p0978:b004:l023","ordinal":151779,"en":"The two choros were warrior choros,"},{"id":"semetey-1-2013:p0978:b004:l024","ordinal":151780,"en":"As though born as twins;"},{"id":"semetey-1-2013:p0978:b004:l025","ordinal":151781,"en":"The two were equal as a single hair,"},{"id":"semetey-1-2013:p0978:b004:l026","ordinal":151782,"en":"Choros like burning red embers,"},{"id":"semetey-1-2013:p0978:b004:l027","ordinal":151783,"en":"Choros like arrows shot from a bow,"},{"id":"semetey-1-2013:p0978:b004:l028","ordinal":151784,"en":"Calamities loosed upon the world."},{"id":"semetey-1-2013:p0978:b004:l029","ordinal":151785,"en":"When they advanced, they were his supports,"},{"id":"semetey-1-2013:p0978:b004:l030","ordinal":151786,"en":"Setting the grassy land aflame,"},{"id":"semetey-1-2013:p0978:b004:l031","ordinal":151787,"en":"The pillars of Tügöngür."},{"id":"semetey-1-2013:p0978:b004:l032","ordinal":151788,"en":"If your magnanimous Semetey remained safe,"},{"id":"semetey-1-2013:p0978:b004:l033","ordinal":151789,"en":"These boys were the wings"},{"id":"semetey-1-2013:p0978:b004:l034","ordinal":151790,"en":"With which he circled in flight;"},{"id":"semetey-1-2013:p0978:b004:l035","ordinal":151791,"en":"If seven thousand foes appeared,"},{"id":"semetey-1-2013:p0978:b004:l036","ordinal":151792,"en":"It was their custom to strike without wavering."},{"id":"semetey-1-2013:p0978:b004:l037","ordinal":151793,"en":"Kulchoro and Kanchoro—"},{"id":"semetey-1-2013:p0978:b004:l038","ordinal":151794,"en":"From noble Almambet"},{"id":"semetey-1-2013:p0978:b004:l039","ordinal":151795,"en":"Kulchoro was born afterward,"},{"id":"semetey-1-2013:p0979:b003:l001","ordinal":151796,"en":"Kanchoro was born afterward"},{"id":"semetey-1-2013:p0979:b003:l002","ordinal":151797,"en":"To his namesake father Chubak."},{"id":"semetey-1-2013:p0979:b003:l003","ordinal":151798,"en":"Abyke’s Aktelki"},{"id":"semetey-1-2013:p0979:b003:l004","ordinal":151799,"en":"Was the horse Kulchoro rode;"},{"id":"semetey-1-2013:p0979:b003:l005","ordinal":151800,"en":"The horse Kanchoro rode"},{"id":"semetey-1-2013:p0979:b003:l006","ordinal":151801,"en":"Was Khan Köbösh’s Köktelki."},{"id":"semetey-1-2013:p0979:b003:l007","ordinal":151802,"en":"The two truly raced one another,"},{"id":"semetey-1-2013:p0979:b003:l008","ordinal":151803,"en":"And rode out in anger,"},{"id":"semetey-1-2013:p0979:b003:l009","ordinal":151804,"en":"Taking from Semetey’s own mouth"},{"id":"semetey-1-2013:p0979:b003:l010","ordinal":151805,"en":"His firm promise and oath,"},{"id":"semetey-1-2013:p0979:b003:l011","ordinal":151806,"en":"And carrying the letter their elder had written."},{"id":"semetey-1-2013:p0979:b003:l012","ordinal":151807,"en":"When the sun was sinking red,"},{"id":"semetey-1-2013:p0979:b003:l013","ordinal":151808,"en":"Before the people had gone to rest,"}]
