[{"id":"manas-2010:p0750:b001:l021","ordinal":33281,"en":"Dragging it onto the road,"},{"id":"manas-2010:p0750:b001:l022","ordinal":33282,"en":"He cut it open for the great dogs."},{"id":"manas-2010:p0750:b001:l023","ordinal":33283,"en":"The leopard's Zulpukor"},{"id":"manas-2010:p0750:b001:l024","ordinal":33284,"en":"Now had its fill of blood."},{"id":"manas-2010:p0750:b001:l025","ordinal":33285,"en":"His champions, the forty companions,"},{"id":"manas-2010:p0750:b001:l026","ordinal":33286,"en":"Took five hundred captured horses each."},{"id":"manas-2010:p0750:b001:l027","ordinal":33287,"en":"The fainthearted weaklings"},{"id":"manas-2010:p0750:b001:l028","ordinal":33288,"en":"Took five spare mounts each."},{"id":"manas-2010:p0750:b001:l029","ordinal":33289,"en":"He unleashed fierce wrath;"},{"id":"manas-2010:p0750:b001:l030","ordinal":33290,"en":"The warrior Khan Alöökö,"},{"id":"manas-2010:p0750:b001:l031","ordinal":33291,"en":"Enraged Khan Manas"},{"id":"manas-2010:p0750:b001:l032","ordinal":33292,"en":"Slaughtered utterly, leaving none."},{"id":"manas-2010:p0750:b001:l033","ordinal":33293,"en":"Acclaimed as a mighty conqueror,"},{"id":"manas-2010:p0750:b001:l034","ordinal":33294,"en":"He butchered Alöökö, they say."},{"id":"manas-2010:p0750:b001:l035","ordinal":33295,"en":"For the land won by wrestling,"},{"id":"manas-2010:p0750:b001:l036","ordinal":33296,"en":"It became Wrestling City, they say."},{"id":"manas-2010:p0750:b001:l037","ordinal":33297,"en":"In time, that place"},{"id":"manas-2010:p0750:b001:l038","ordinal":33298,"en":"Received the name Küchör, they say."},{"id":"manas-2010:p0750:b001:l039","ordinal":33299,"en":"When Alöökö was taken,"},{"id":"manas-2010:p0750:b001:l040","ordinal":33300,"en":"Gold was heaped like mountains."},{"id":"manas-2010:p0750:b001:l041","ordinal":33301,"en":"Of magnanimous Lord Manas,"},{"id":"manas-2010:p0750:b001:l042","ordinal":33302,"en":"The fame became known to the people,"},{"id":"manas-2010:p0751:b001:l001","ordinal":33303,"en":"Where ears had heard and eyes had seen,"},{"id":"manas-2010:p0751:b001:l002","ordinal":33304,"en":"He now sent word to those lands."},{"id":"manas-2010:p0751:b001:l003","ordinal":33305,"en":"Weak in strength, truly destitute,"},{"id":"manas-2010:p0751:b001:l004","ordinal":33306,"en":"He now sent word to the people."},{"id":"manas-2010:p0751:b001:l005","ordinal":33307,"en":"The skillful companion Tazbaymat"},{"id":"manas-2010:p0751:b001:l006","ordinal":33308,"en":"Was the son of Eltir the Sart."},{"id":"manas-2010:p0751:b001:l007","ordinal":33309,"en":"Giving him six swift horses,"},{"id":"manas-2010:p0751:b001:l008","ordinal":33310,"en":"Giving him a palm-sized letter:"},{"id":"manas-2010:p0751:b001:l009","ordinal":33311,"en":"'Who governs Anzhyian,"},{"id":"manas-2010:p0751:b001:l010","ordinal":33312,"en":"Synchybek of the forked beard,"},{"id":"manas-2010:p0751:b001:l011","ordinal":33313,"en":"Let him come here now,"},{"id":"manas-2010:p0751:b001:l012","ordinal":33314,"en":"Of magnanimous Lord Manas,"},{"id":"manas-2010:p0751:b001:l013","ordinal":33315,"en":"Let him know he is khan."},{"id":"manas-2010:p0751:b001:l014","ordinal":33316,"en":"Let all of them hurry and bustle,"},{"id":"manas-2010:p0751:b001:l015","ordinal":33317,"en":"Let his people stir into motion."},{"id":"manas-2010:p0751:b001:l016","ordinal":33318,"en":"The booty taken from Alöökö,"},{"id":"manas-2010:p0751:b001:l017","ordinal":33319,"en":"Let them divide it thoroughly.'"},{"id":"manas-2010:p0751:b001:l018","ordinal":33320,"en":"He sent him word, they say."},{"id":"manas-2010:p0751:b001:l019","ordinal":33321,"en":"Governing broad Kashkar,"},{"id":"manas-2010:p0751:b001:l020","ordinal":33322,"en":"Alabek of Alty-Shaar"},{"id":"manas-2010:p0751:b001:l021","ordinal":33323,"en":"Was a man living in humiliation;"},{"id":"manas-2010:p0751:b001:l022","ordinal":33324,"en":"He was humiliated like a sheep."},{"id":"manas-2010:p0751:b001:l023","ordinal":33325,"en":"From Alabek himself,"},{"id":"manas-2010:p0751:b001:l024","ordinal":33326,"en":"Beating him before each month was out,"},{"id":"manas-2010:p0751:b001:l025","ordinal":33327,"en":"Six thousand silver ingots, a thousand otter pelts,"},{"id":"manas-2010:p0751:b001:l026","ordinal":33328,"en":"He had driven off as tribute."},{"id":"manas-2010:p0751:b001:l027","ordinal":33329,"en":"Clothing him in armor no bullet pierced,"},{"id":"manas-2010:p0751:b001:l028","ordinal":33330,"en":"Mounting him on Kulansur,"},{"id":"manas-2010:p0751:b001:l029","ordinal":33331,"en":"To that poor Alabek,"},{"id":"manas-2010:p0751:b001:l030","ordinal":33332,"en":"The son of wealthy Baabedin,"},{"id":"manas-2010:p0751:b001:l031","ordinal":33333,"en":"He sent Baychoro."},{"id":"manas-2010:p0751:b001:l032","ordinal":33334,"en":"On this side of Bukhara the Noble,"},{"id":"manas-2010:p0751:b001:l033","ordinal":33335,"en":"Beyond ruined Chambyl,"},{"id":"manas-2010:p0751:b001:l034","ordinal":33336,"en":"He too has words to speak,"},{"id":"manas-2010:p0751:b001:l035","ordinal":33337,"en":"There is the hero Khan Buudayyk."},{"id":"manas-2010:p0751:b001:l036","ordinal":33338,"en":"'Say he must come without fail,"},{"id":"manas-2010:p0751:b001:l037","ordinal":33339,"en":"This marvel of Manas,"},{"id":"manas-2010:p0751:b001:l038","ordinal":33340,"en":"Say he should open his eyes and see."},{"id":"manas-2010:p0751:b001:l039","ordinal":33341,"en":"When you come farther this way,"},{"id":"manas-2010:p0751:b001:l040","ordinal":33342,"en":"Sanchybek in Samarkan,"},{"id":"manas-2010:p0751:b001:l041","ordinal":33343,"en":"Kozubek at the khan of Kokon,"},{"id":"manas-2010:p0751:b001:l042","ordinal":33344,"en":"They have been crushed into slavery."},{"id":"manas-2010:p0752:b001:l001","ordinal":33345,"en":"Of an infidel like Alöökö,"},{"id":"manas-2010:p0752:b001:l002","ordinal":33346,"en":"Unable to bear his wrath,"},{"id":"manas-2010:p0752:b001:l003","ordinal":33347,"en":"Their wives have become widows."},{"id":"manas-2010:p0752:b001:l004","ordinal":33348,"en":"Go and give word to them all."},{"id":"manas-2010:p0752:b001:l005","ordinal":33349,"en":"Malabek of Margalang"},{"id":"manas-2010:p0752:b001:l006","ordinal":33350,"en":"Has been living in misery;"},{"id":"manas-2010:p0752:b001:l007","ordinal":33351,"en":"Bring that very man."},{"id":"manas-2010:p0752:b001:l008","ordinal":33352,"en":"If he does not believe your words,"},{"id":"manas-2010:p0752:b001:l009","ordinal":33353,"en":"Come and tell me myself."},{"id":"manas-2010:p0752:b001:l010","ordinal":33354,"en":"From the warrior Khan Alöökö,"},{"id":"manas-2010:p0752:b001:l011","ordinal":33355,"en":"Whatever humiliation he has suffered,"},{"id":"manas-2010:p0752:b001:l012","ordinal":33356,"en":"If he does not believe your words,"},{"id":"manas-2010:p0752:b001:l013","ordinal":33357,"en":"He will suffer force from me."},{"id":"manas-2010:p0752:b001:l014","ordinal":33358,"en":"Say he must obey what I say,"},{"id":"manas-2010:p0752:b001:l015","ordinal":33359,"en":"Say he should come more quickly,"},{"id":"manas-2010:p0752:b001:l016","ordinal":33360,"en":"Say he should have his fill of joy,"},{"id":"manas-2010:p0752:b001:l017","ordinal":33361,"en":"The captured yellow gold,"},{"id":"manas-2010:p0752:b001:l018","ordinal":33362,"en":"Say he should see and take his share!"},{"id":"manas-2010:p0752:b001:l019","ordinal":33363,"en":"Let no man fail to come;"},{"id":"manas-2010:p0752:b001:l020","ordinal":33364,"en":"I shall send none away without booty.'"},{"id":"manas-2010:p0752:b001:l021","ordinal":33365,"en":"Such was his prowess,"},{"id":"manas-2010:p0752:b001:l022","ordinal":33366,"en":"Those he ruled were afraid."},{"id":"manas-2010:p0752:b001:l023","ordinal":33367,"en":"His uncle, champion Bakay,"},{"id":"manas-2010:p0752:b001:l024","ordinal":33368,"en":"Had studied five years in Mecca."},{"id":"manas-2010:p0752:b001:l025","ordinal":33369,"en":"In the Arabic tongue,"},{"id":"manas-2010:p0752:b001:l026","ordinal":33370,"en":"He wrote swiftly, swish and swish,"},{"id":"manas-2010:p0752:b001:l027","ordinal":33371,"en":"His quickness beyond measure,"},{"id":"manas-2010:p0752:b001:l028","ordinal":33372,"en":"He wrote fast, making a clatter."},{"id":"manas-2010:p0752:b001:l029","ordinal":33373,"en":"'Küldür and Chalybay,"},{"id":"manas-2010:p0752:b001:l030","ordinal":33374,"en":"Drive along those I named,' he said."},{"id":"manas-2010:p0752:b001:l031","ordinal":33375,"en":"'The allotted time is seven days;"},{"id":"manas-2010:p0752:b001:l032","ordinal":33376,"en":"No later than seven days,"},{"id":"manas-2010:p0752:b001:l033","ordinal":33377,"en":"Drive along those I named,' he said."},{"id":"manas-2010:p0752:b001:l034","ordinal":33378,"en":"Messengers who would tell the news,"},{"id":"manas-2010:p0752:b001:l035","ordinal":33379,"en":"To all the populace,"},{"id":"manas-2010:p0752:b001:l036","ordinal":33380,"en":"Those who went proclaiming:"},{"id":"manas-2010:p0752:b001:l037","ordinal":33381,"en":"'Leave the old, tell the young,"},{"id":"manas-2010:p0752:b001:l038","ordinal":33382,"en":"Tell the heads who rule the people,"},{"id":"manas-2010:p0752:b001:l039","ordinal":33383,"en":"Tell those who will believe and obey,"},{"id":"manas-2010:p0752:b001:l040","ordinal":33384,"en":"Hurrying and urging their horses,"},{"id":"manas-2010:p0752:b001:l041","ordinal":33385,"en":"Tell those who will come bounding!"},{"id":"manas-2010:p0752:b001:l042","ordinal":33386,"en":"Say gold objects will be divided;"},{"id":"manas-2010:p0753:b001:l001","ordinal":33387,"en":"Those who divide the gold evenly,"},{"id":"manas-2010:p0753:b001:l002","ordinal":33388,"en":"Say Azhybay and Bakay are mighty."},{"id":"manas-2010:p0753:b001:l003","ordinal":33389,"en":"These are the words I have spoken,' he said,"},{"id":"manas-2010:p0753:b001:l004","ordinal":33390,"en":"And sent them in every direction."},{"id":"manas-2010:p0753:b001:l005","ordinal":33391,"en":"Azhybay, Argyn Khan's son,"},{"id":"manas-2010:p0753:b001:l006","ordinal":33392,"en":"A man of considerable wisdom—"},{"id":"manas-2010:p0753:b001:l007","ordinal":33393,"en":"Dwelling in Chech-Töbö,"},{"id":"manas-2010:p0753:b001:l008","ordinal":33394,"en":"Called a hero beyond measure,"},{"id":"manas-2010:p0753:b001:l009","ordinal":33395,"en":"His moon-like ears like shields,"},{"id":"manas-2010:p0753:b001:l010","ordinal":33396,"en":"His great eyes like Venus,"},{"id":"manas-2010:p0753:b001:l011","ordinal":33397,"en":"Among blessing-givers, a man of prayer,"},{"id":"manas-2010:p0753:b001:l012","ordinal":33398,"en":"He was a man of great knowledge."},{"id":"manas-2010:p0753:b001:l013","ordinal":33399,"en":"Whose blessing enriched the people,"},{"id":"manas-2010:p0753:b001:l014","ordinal":33400,"en":"He was a khan like a prophet."},{"id":"manas-2010:p0753:b001:l015","ordinal":33401,"en":"He was the one I held as my own."},{"id":"manas-2010:p0753:b001:l016","ordinal":33402,"en":"'To load up gold and carry it,"},{"id":"manas-2010:p0753:b001:l017","ordinal":33403,"en":"Let him prepare his pack animals."},{"id":"manas-2010:p0753:b001:l018","ordinal":33404,"en":"With the gold not fitting in saddlebags,"},{"id":"manas-2010:p0753:b001:l019","ordinal":33405,"en":"Let my poor uncle Koshoi"},{"id":"manas-2010:p0753:b001:l020","ordinal":33406,"en":"Not be left lamenting."},{"id":"manas-2010:p0753:b001:l021","ordinal":33407,"en":"Say my khan uncle Koshoi should come,"},{"id":"manas-2010:p0753:b001:l022","ordinal":33408,"en":"Say he should see this marvel!"},{"id":"manas-2010:p0753:b001:l023","ordinal":33409,"en":"Of the slaughtering leopard Manas,"},{"id":"manas-2010:p0753:b001:l024","ordinal":33410,"en":"The booty beneath his claws,"},{"id":"manas-2010:p0753:b001:l025","ordinal":33411,"en":"To the worn and scattered,"},{"id":"manas-2010:p0753:b001:l026","ordinal":33412,"en":"Let giant Koshoi allot it,"},{"id":"manas-2010:p0753:b001:l027","ordinal":33413,"en":"Say he should divide it with his own hands."},{"id":"manas-2010:p0753:b001:l028","ordinal":33414,"en":"The elder of the Katagan,"},{"id":"manas-2010:p0753:b001:l029","ordinal":33415,"en":"A saint to the multitude,"},{"id":"manas-2010:p0753:b001:l030","ordinal":33416,"en":"The adept among immeasurable heroes,"},{"id":"manas-2010:p0753:b001:l031","ordinal":33417,"en":"The open road among heroic men,"},{"id":"manas-2010:p0753:b001:l032","ordinal":33418,"en":"The support of your mortals,"},{"id":"manas-2010:p0753:b001:l033","ordinal":33419,"en":"If an enemy girded for battle,"},{"id":"manas-2010:p0753:b001:l034","ordinal":33420,"en":"Of blue-maned champion Manas,"},{"id":"manas-2010:p0753:b001:l035","ordinal":33421,"en":"He would stand beneath the banner."},{"id":"manas-2010:p0753:b001:l036","ordinal":33422,"en":"Accomplished elder Koshoi,"},{"id":"manas-2010:p0753:b001:l037","ordinal":33423,"en":"Seven together gave their hands."},{"id":"manas-2010:p0753:b001:l038","ordinal":33424,"en":"Accomplished saint Koshoi,"},{"id":"manas-2010:p0753:b001:l039","ordinal":33425,"en":"A precious land like Zheti-Özön,"},{"id":"manas-2010:p0753:b001:l040","ordinal":33426,"en":"He skillfully made it a homeland."},{"id":"manas-2010:p0753:b001:l041","ordinal":33427,"en":"The Kyrgyz of Zheti-Özön,"},{"id":"manas-2010:p0753:b001:l042","ordinal":33428,"en":"He contrived to make them a people."},{"id":"manas-2010:p0754:b001:l001","ordinal":33429,"en":"Tell my forefather Koshoi, blessed by Kydyr,"},{"id":"manas-2010:p0754:b001:l002","ordinal":33430,"en":"Say he should come without looking back."},{"id":"manas-2010:p0754:b001:l003","ordinal":33431,"en":"He was impartial, he was khan,"},{"id":"manas-2010:p0754:b001:l004","ordinal":33432,"en":"He was a man of sacred power."},{"id":"manas-2010:p0754:b001:l005","ordinal":33433,"en":"With his own hands, my khan uncle,"},{"id":"manas-2010:p0754:b001:l006","ordinal":33434,"en":"The booty from Alöökö,"},{"id":"manas-2010:p0754:b001:l007","ordinal":33435,"en":"Say he should divide it among the people."},{"id":"manas-2010:p0754:b001:l008","ordinal":33436,"en":"Say Koshoi must come without fail!'"},{"id":"manas-2010:p0754:b001:l009","ordinal":33437,"en":"Clothing him in striped cloth and silk,"},{"id":"manas-2010:p0754:b001:l010","ordinal":33438,"en":"Khan Azhybay, the sultan,"},{"id":"manas-2010:p0754:b001:l011","ordinal":33439,"en":"They mounted him on Kartküröng."},{"id":"manas-2010:p0754:b001:l012","ordinal":33440,"en":"Such was the nature of Kartküröng:"},{"id":"manas-2010:p0754:b001:l013","ordinal":33441,"en":"Left a stallion, gelded into a mount,"},{"id":"manas-2010:p0754:b001:l014","ordinal":33442,"en":"A sturdy, noble-bred horse,"},{"id":"manas-2010:p0754:b001:l015","ordinal":33443,"en":"Sieve-lunged, a true winged steed."},{"id":"manas-2010:p0754:b001:l016","ordinal":33444,"en":"Never flustered on hearing a battle cry,"},{"id":"manas-2010:p0754:b001:l017","ordinal":33445,"en":"His distinction was like this:"},{"id":"manas-2010:p0754:b001:l018","ordinal":33446,"en":"He did not grow excited on hearing uproar."},{"id":"manas-2010:p0754:b001:l019","ordinal":33447,"en":"Even if he heard a warrior's gun,"},{"id":"manas-2010:p0754:b001:l020","ordinal":33448,"en":"He did not panic like ordinary horses."},{"id":"manas-2010:p0754:b001:l021","ordinal":33449,"en":"Among horses with hair tails,"},{"id":"manas-2010:p0754:b001:l022","ordinal":33450,"en":"There was not one like him."},{"id":"manas-2010:p0754:b001:l023","ordinal":33451,"en":"A creature wiser than other beasts,"},{"id":"manas-2010:p0754:b001:l024","ordinal":33452,"en":"He lacked a tongue to speak,"},{"id":"manas-2010:p0754:b001:l025","ordinal":33453,"en":"A true winged steed, lacking a brain."},{"id":"manas-2010:p0754:b001:l026","ordinal":33454,"en":"A creature of Father Kambar,"},{"id":"manas-2010:p0754:b001:l027","ordinal":33455,"en":"The wind could not match his trot,"},{"id":"manas-2010:p0754:b001:l028","ordinal":33456,"en":"No beast could match his walk."},{"id":"manas-2010:p0754:b001:l029","ordinal":33457,"en":"He was no idle tail and mane;"},{"id":"manas-2010:p0754:b001:l030","ordinal":33458,"en":"How great his sacred power—"},{"id":"manas-2010:p0754:b001:l031","ordinal":33459,"en":"Kartküröng was no ordinary beast."},{"id":"manas-2010:p0754:b001:l032","ordinal":33460,"en":"When Kartküröng opened his mouth,"},{"id":"manas-2010:p0754:b001:l033","ordinal":33461,"en":"He flew like a cloud, vanishing in the distance."},{"id":"manas-2010:p0754:b001:l034","ordinal":33462,"en":"With a traveling amble, easy on the rider,"},{"id":"manas-2010:p0754:b001:l035","ordinal":33463,"en":"No beast had such qualities."},{"id":"manas-2010:p0754:b001:l036","ordinal":33464,"en":"From Bakay and Lord Manas,"},{"id":"manas-2010:p0754:b001:l037","ordinal":33465,"en":"Firmly taking their strict command,"},{"id":"manas-2010:p0754:b001:l038","ordinal":33466,"en":"Azhybay set off."},{"id":"manas-2010:p0754:b001:l039","ordinal":33467,"en":"The chestnut beneath him,"},{"id":"manas-2010:p0754:b001:l040","ordinal":33468,"en":"Sending its dust tumbling like mountains,"},{"id":"manas-2010:p0754:b001:l041","ordinal":33469,"en":"As he went to Khan Koshoi,"},{"id":"manas-2010:p0754:b001:l042","ordinal":33470,"en":"Your dear Azhy took the road,"},{"id":"manas-2010:p0755:b001:l001","ordinal":33471,"en":"Traveling at night, not by day,"},{"id":"manas-2010:p0755:b001:l002","ordinal":33472,"en":"Crossing mountains with lofty passes,"},{"id":"manas-2010:p0755:b001:l003","ordinal":33473,"en":"Fording waters with swift currents,"},{"id":"manas-2010:p0755:b001:l004","ordinal":33474,"en":"To the reaches of Chech-Töbö,"},{"id":"manas-2010:p0755:b001:l005","ordinal":33475,"en":"To the hollows of Kara-Too,"},{"id":"manas-2010:p0755:b001:l006","ordinal":33476,"en":"To Khan Koshoi's fortress,"},{"id":"manas-2010:p0755:b001:l007","ordinal":33477,"en":"To the treasury court,"},{"id":"manas-2010:p0755:b001:l008","ordinal":33478,"en":"When true dawn broke,"},{"id":"manas-2010:p0755:b001:l009","ordinal":33479,"en":"At Khan Koshoi's court,"},{"id":"manas-2010:p0755:b001:l010","ordinal":33480,"en":"When the call to prayer sounded,"},{"id":"manas-2010:p0755:b001:l011","ordinal":33481,"en":"He put his hands in water,"},{"id":"manas-2010:p0755:b001:l012","ordinal":33482,"en":"Performed the washing of his hands."},{"id":"manas-2010:p0755:b001:l013","ordinal":33483,"en":"He put his feet in water,"},{"id":"manas-2010:p0755:b001:l014","ordinal":33484,"en":"Performed the washing of his feet."},{"id":"manas-2010:p0755:b001:l015","ordinal":33485,"en":"Four cycles of the dawn prayer,"},{"id":"manas-2010:p0755:b001:l016","ordinal":33486,"en":"The early morning prayer,"},{"id":"manas-2010:p0755:b001:l017","ordinal":33487,"en":"He bowed and recited it."},{"id":"manas-2010:p0755:b001:l018","ordinal":33488,"en":"When he folded his prayer mat,"},{"id":"manas-2010:p0755:b001:l019","ordinal":33489,"en":"When he had just given the blessing,"},{"id":"manas-2010:p0755:b001:l020","ordinal":33490,"en":"Khan Koshoi's lookout"},{"id":"manas-2010:p0755:b001:l021","ordinal":33491,"en":"Caught sight of Azhybay."},{"id":"manas-2010:p0755:b001:l022","ordinal":33492,"en":"When he saw Azhybay,"},{"id":"manas-2010:p0755:b001:l023","ordinal":33493,"en":"He fled at a run."},{"id":"manas-2010:p0755:b001:l024","ordinal":33494,"en":"'Powerful Allah, protect us!' he said,"},{"id":"manas-2010:p0755:b001:l025","ordinal":33495,"en":"Despairing of his precious life,"},{"id":"manas-2010:p0755:b001:l026","ordinal":33496,"en":"Hurrying, bustling, blundering,"},{"id":"manas-2010:p0755:b001:l027","ordinal":33497,"en":"His skin-bag nose flaring,"},{"id":"manas-2010:p0755:b001:l028","ordinal":33498,"en":"Shouting and spreading panic,"},{"id":"manas-2010:p0755:b001:l029","ordinal":33499,"en":"To all the wrestlers"},{"id":"manas-2010:p0755:b001:l030","ordinal":33500,"en":"Calling, 'Make ready!'"},{"id":"manas-2010:p0755:b001:l031","ordinal":33501,"en":"Still in his haste, the lookout"},{"id":"manas-2010:p0755:b001:l032","ordinal":33502,"en":"Trampled over Khan Koshoi,"},{"id":"manas-2010:p0755:b001:l033","ordinal":33503,"en":"The messenger and the guard,"},{"id":"manas-2010:p0755:b001:l034","ordinal":33504,"en":"Scolding, 'Prepare at once!'"},{"id":"manas-2010:p0755:b001:l035","ordinal":33505,"en":"'A man has come to the door."},{"id":"manas-2010:p0755:b001:l036","ordinal":33506,"en":"His weapons are different and terrible;"},{"id":"manas-2010:p0755:b001:l037","ordinal":33507,"en":"Broad-chested, narrow behind,"},{"id":"manas-2010:p0755:b001:l038","ordinal":33508,"en":"He rides a chestnut horse like a hound."},{"id":"manas-2010:p0755:b001:l039","ordinal":33509,"en":"Like a cloud about to rain again,"},{"id":"manas-2010:p0755:b001:l040","ordinal":33510,"en":"The man upon it—"},{"id":"manas-2010:p0755:b001:l041","ordinal":33511,"en":"Wrath has spread over his face,"},{"id":"manas-2010:p0755:b001:l042","ordinal":33512,"en":"He is girded with a sword without a sheath,"},{"id":"manas-2010:p0756:b001:l001","ordinal":33513,"en":"His heroism is different,"},{"id":"manas-2010:p0756:b001:l002","ordinal":33514,"en":"His strength is great,"},{"id":"manas-2010:p0756:b001:l003","ordinal":33515,"en":"His eyes are like a hunting eagle's,"},{"id":"manas-2010:p0756:b001:l004","ordinal":33516,"en":"His appearance like a night-devourer's,"},{"id":"manas-2010:p0756:b001:l005","ordinal":33517,"en":"His forked beard an armful,"},{"id":"manas-2010:p0756:b001:l006","ordinal":33518,"en":"The chestnut beneath him,"},{"id":"manas-2010:p0756:b001:l007","ordinal":33519,"en":"A noble horse unlike other beasts."},{"id":"manas-2010:p0756:b001:l008","ordinal":33520,"en":"His shape, his bearing,"},{"id":"manas-2010:p0756:b001:l009","ordinal":33521,"en":"His appearance on horseback—"},{"id":"manas-2010:p0756:b001:l010","ordinal":33522,"en":"He is not of the people of our land."},{"id":"manas-2010:p0756:b001:l011","ordinal":33523,"en":"I think he is a formidable enemy;"},{"id":"manas-2010:p0756:b001:l012","ordinal":33524,"en":"This journey of his is no ordinary one.'"},{"id":"manas-2010:p0756:b001:l013","ordinal":33525,"en":"Saying this, the lookout,"},{"id":"manas-2010:p0756:b001:l014","ordinal":33526,"en":"The strength left his arm,"},{"id":"manas-2010:p0756:b001:l015","ordinal":33527,"en":"The covering left his heart."},{"id":"manas-2010:p0756:b001:l016","ordinal":33528,"en":"To your elder uncle Koshoi,"},{"id":"manas-2010:p0756:b001:l017","ordinal":33529,"en":"To all the people standing there,"},{"id":"manas-2010:p0756:b001:l018","ordinal":33530,"en":"Before he could tell them and return,"},{"id":"manas-2010:p0756:b001:l019","ordinal":33531,"en":"Would Khan Azhybay wait?"},{"id":"manas-2010:p0756:b001:l020","ordinal":33532,"en":"At the gated fortress,"},{"id":"manas-2010:p0756:b001:l021","ordinal":33533,"en":"At Khan Koshoi's court,"},{"id":"manas-2010:p0756:b001:l022","ordinal":33534,"en":"Springing and curling like a roe deer,"},{"id":"manas-2010:p0756:b001:l023","ordinal":33535,"en":"He dismounted from Kartküröng."},{"id":"manas-2010:p0756:b001:l024","ordinal":33536,"en":"A brass post with a golden band,"}]
