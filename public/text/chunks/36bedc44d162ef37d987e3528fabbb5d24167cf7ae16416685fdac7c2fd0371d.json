[{"id":"manas-2010:p0695:b001:l022","ordinal":30977,"en":"Let us kill their leaders!"},{"id":"manas-2010:p0695:b001:l023","ordinal":30978,"en":"That khan who occupies the white dwelling,"},{"id":"manas-2010:p0695:b001:l024","ordinal":30979,"en":"Let us plunder what he has taken."},{"id":"manas-2010:p0695:b001:l025","ordinal":30980,"en":"Alöökö, who became ruler,"},{"id":"manas-2010:p0695:b001:l026","ordinal":30981,"en":"Let us grapple and slaughter him."},{"id":"manas-2010:p0695:b001:l027","ordinal":30982,"en":"Leveling his marvels,"},{"id":"manas-2010:p0695:b001:l028","ordinal":30983,"en":"Cutting and felling his plane trees,"},{"id":"manas-2010:p0695:b001:l029","ordinal":30984,"en":"The fortress he had built,"},{"id":"manas-2010:p0695:b001:l030","ordinal":30985,"en":"Pulling it down on every side,"},{"id":"manas-2010:p0695:b001:l031","ordinal":30986,"en":"While dear Manas is here,"},{"id":"manas-2010:p0695:b001:l032","ordinal":30987,"en":"Let us show boundless valor."},{"id":"manas-2010:p0695:b001:l033","ordinal":30988,"en":"Told to drink water, drinking poison,"},{"id":"manas-2010:p0695:b001:l034","ordinal":30989,"en":"Let us fall slaughtered together!"},{"id":"manas-2010:p0695:b001:l035","ordinal":30990,"en":"Locked leg to leg in battle,"},{"id":"manas-2010:p0695:b001:l036","ordinal":30991,"en":"Clashing with all our fury,"},{"id":"manas-2010:p0695:b001:l037","ordinal":30992,"en":"While the hero lives,"},{"id":"manas-2010:p0695:b001:l038","ordinal":30993,"en":"Going and raising strife,"},{"id":"manas-2010:p0695:b001:l039","ordinal":30994,"en":"Told to scout the land, damming the water,"},{"id":"manas-2010:p0695:b001:l040","ordinal":30995,"en":"You are one of the ogres."},{"id":"manas-2010:p0695:b001:l041","ordinal":30996,"en":"Told to take a hat, cutting off a head,"},{"id":"manas-2010:p0695:b001:l042","ordinal":30997,"en":"You are heroes of surpassing worth,"},{"id":"manas-2010:p0696:b001:l001","ordinal":30998,"en":"All forty, champions come from forty places.'"},{"id":"manas-2010:p0696:b001:l002","ordinal":30999,"en":"Bakay spoke these words."},{"id":"manas-2010:p0696:b001:l003","ordinal":31000,"en":"Azhybay and Bakay, the two khans,"},{"id":"manas-2010:p0696:b001:l004","ordinal":31001,"en":"Surged toward Alöökö,"},{"id":"manas-2010:p0696:b001:l005","ordinal":31002,"en":"Readied the war drum."},{"id":"manas-2010:p0696:b001:l006","ordinal":31003,"en":"All the keen warriors"},{"id":"manas-2010:p0696:b001:l007","ordinal":31004,"en":"Girded on swords without scabbards."},{"id":"manas-2010:p0696:b001:l008","ordinal":31005,"en":"At the sight, attention was drawn;"},{"id":"manas-2010:p0696:b001:l009","ordinal":31006,"en":"All the wolf-maned ones,"},{"id":"manas-2010:p0696:b001:l010","ordinal":31007,"en":"Their wolf-maned nature showed."},{"id":"manas-2010:p0696:b001:l011","ordinal":31008,"en":"Lacquered spears with iron tips,"},{"id":"manas-2010:p0696:b001:l012","ordinal":31009,"en":"They joined them upright, towering,"},{"id":"manas-2010:p0696:b001:l013","ordinal":31010,"en":"The enemy who traded blows,"},{"id":"manas-2010:p0696:b001:l014","ordinal":31011,"en":"They crushed to earth like rabbits."},{"id":"manas-2010:p0696:b001:l015","ordinal":31012,"en":"Khan Manas's forty companions,"},{"id":"manas-2010:p0696:b001:l016","ordinal":31013,"en":"Azhybay and Bakay, the pair,"},{"id":"manas-2010:p0696:b001:l017","ordinal":31014,"en":"His ocean that would overturn the world,"},{"id":"manas-2010:p0696:b001:l018","ordinal":31015,"en":"Turned toward Alöökö."},{"id":"manas-2010:p0696:b001:l019","ordinal":31016,"en":"Your uncle, lion Bakay,"},{"id":"manas-2010:p0696:b001:l020","ordinal":31017,"en":"Raised his golden banner."},{"id":"manas-2010:p0696:b001:l021","ordinal":31018,"en":"Alöökö was his target;"},{"id":"manas-2010:p0696:b001:l022","ordinal":31019,"en":"They came bounding from the court."},{"id":"manas-2010:p0696:b001:l023","ordinal":31020,"en":"Behind magnanimous Manas,"},{"id":"manas-2010:p0696:b001:l024","ordinal":31021,"en":"Each of the forty companions"},{"id":"manas-2010:p0696:b001:l025","ordinal":31022,"en":"Loomed like Ala-Too."},{"id":"manas-2010:p0696:b001:l026","ordinal":31023,"en":"Their iron-headed maces with wrist-straps,"},{"id":"manas-2010:p0696:b001:l027","ordinal":31024,"en":"They wound around their wrists and hurried."},{"id":"manas-2010:p0696:b001:l028","ordinal":31025,"en":"Behind the magnanimous lion,"},{"id":"manas-2010:p0696:b001:l029","ordinal":31026,"en":"All the forty nobles"},{"id":"manas-2010:p0696:b001:l030","ordinal":31027,"en":"Went thudding, thudding along."},{"id":"manas-2010:p0696:b001:l031","ordinal":31028,"en":"Traveling as companions and friends,"},{"id":"manas-2010:p0696:b001:l032","ordinal":31029,"en":"All the valiant men"},{"id":"manas-2010:p0696:b001:l033","ordinal":31030,"en":"Rode only winged steeds."},{"id":"manas-2010:p0696:b001:l034","ordinal":31031,"en":"This was fortune granted by God."},{"id":"manas-2010:p0696:b001:l035","ordinal":31032,"en":"For times when they halted to rest,"},{"id":"manas-2010:p0696:b001:l036","ordinal":31033,"en":"The camel-sized throne their lord would sit upon,"},{"id":"manas-2010:p0696:b001:l037","ordinal":31034,"en":"They had it folded with ceremony,"},{"id":"manas-2010:p0696:b001:l038","ordinal":31035,"en":"Had it loaded on a red camel."},{"id":"manas-2010:p0696:b001:l039","ordinal":31036,"en":"With forty companions, Khan Manas—"},{"id":"manas-2010:p0696:b001:l040","ordinal":31037,"en":"Dust flew up to the sky."},{"id":"manas-2010:p0696:b001:l041","ordinal":31038,"en":"Then the lion prince,"},{"id":"manas-2010:p0696:b001:l042","ordinal":31039,"en":"Toward Alöökö,"},{"id":"manas-2010:p0697:b001:l001","ordinal":31040,"en":"Rode out with a thunderous rush."},{"id":"manas-2010:p0697:b001:l002","ordinal":31041,"en":"Putting on shields and armor,"},{"id":"manas-2010:p0697:b001:l003","ordinal":31042,"en":"They traveled prepared then,"},{"id":"manas-2010:p0697:b001:l004","ordinal":31043,"en":"Marching toward Alöökö."},{"id":"manas-2010:p0697:b001:l005","ordinal":31044,"en":"Until Manas advances upon him,"},{"id":"manas-2010:p0697:b001:l006","ordinal":31045,"en":"Let us leave him thus."},{"id":"manas-2010:p0697:b001:l007","ordinal":31046,"en":"The trouble of Alöökö—"},{"id":"manas-2010:p0697:b001:l008","ordinal":31047,"en":"Let us begin news of him."},{"id":"manas-2010:p0697:b001:l009","ordinal":31048,"en":"Workers of wonders, sorcerers,"},{"id":"manas-2010:p0697:b001:l010","ordinal":31049,"en":"People of accomplished skill,"},{"id":"manas-2010:p0697:b001:l011","ordinal":31050,"en":"What would happen six years hence,"},{"id":"manas-2010:p0697:b001:l012","ordinal":31051,"en":"Able to tell it now,"},{"id":"manas-2010:p0697:b001:l013","ordinal":31052,"en":"Before Alöökö"},{"id":"manas-2010:p0697:b001:l014","ordinal":31053,"en":"There were eighty sorcerers."},{"id":"manas-2010:p0697:b001:l015","ordinal":31054,"en":"Gazing into their writings,"},{"id":"manas-2010:p0697:b001:l016","ordinal":31055,"en":"His eighty sorcerer champions"},{"id":"manas-2010:p0697:b001:l017","ordinal":31056,"en":"Ran up and down,"},{"id":"manas-2010:p0697:b001:l018","ordinal":31057,"en":"Lifting their written registers,"},{"id":"manas-2010:p0697:b001:l019","ordinal":31058,"en":"Agonizing beyond endurance."},{"id":"manas-2010:p0697:b001:l020","ordinal":31059,"en":"Before the khan, the sorcerers"},{"id":"manas-2010:p0697:b001:l021","ordinal":31060,"en":"Paced back and forth,"},{"id":"manas-2010:p0697:b001:l022","ordinal":31061,"en":"Bustling about in haste."},{"id":"manas-2010:p0697:b001:l023","ordinal":31062,"en":"God had struck the sorcerers;"},{"id":"manas-2010:p0697:b001:l024","ordinal":31063,"en":"To a great khan like Alöökö"},{"id":"manas-2010:p0697:b001:l025","ordinal":31064,"en":"They stood giving the news."},{"id":"manas-2010:p0697:b001:l026","ordinal":31065,"en":"Their knees bending,"},{"id":"manas-2010:p0697:b001:l027","ordinal":31066,"en":"Bowing with all their might,"},{"id":"manas-2010:p0697:b001:l028","ordinal":31067,"en":"Their steps raised dust,"},{"id":"manas-2010:p0697:b001:l029","ordinal":31068,"en":"Blood came from their palms."},{"id":"manas-2010:p0697:b001:l030","ordinal":31069,"en":"Whenever it was, the title of khan—"},{"id":"manas-2010:p0697:b001:l031","ordinal":31070,"en":"When the champions saw their khan,"},{"id":"manas-2010:p0697:b001:l032","ordinal":31071,"en":"It was their custom to bow."},{"id":"manas-2010:p0697:b001:l033","ordinal":31072,"en":"When they went before the khan,"},{"id":"manas-2010:p0697:b001:l034","ordinal":31073,"en":"They stood speaking weighty words:"},{"id":"manas-2010:p0697:b001:l035","ordinal":31074,"en":"'We sorcerers have come before you."},{"id":"manas-2010:p0697:b001:l036","ordinal":31075,"en":"Have you learned what we learned?"},{"id":"manas-2010:p0697:b001:l037","ordinal":31076,"en":"Have you sensed what we sensed?"},{"id":"manas-2010:p0697:b001:l038","ordinal":31077,"en":"A deep-dug pit is coming."},{"id":"manas-2010:p0697:b001:l039","ordinal":31078,"en":"Is it in your knowledge?"},{"id":"manas-2010:p0697:b001:l040","ordinal":31079,"en":"The great, renowned Manas is coming."},{"id":"manas-2010:p0697:b001:l041","ordinal":31080,"en":"If Manas comes, he will not leave things well;"},{"id":"manas-2010:p0697:b001:l042","ordinal":31081,"en":"A great burden comes upon our precious lives.'"},{"id":"manas-2010:p0698:b001:l001","ordinal":31082,"en":"He will not let the plow turn."},{"id":"manas-2010:p0698:b001:l002","ordinal":31083,"en":"Manas has risen as a warrior among the Burut;"},{"id":"manas-2010:p0698:b001:l003","ordinal":31084,"en":"He will not let us remain in Andijan."},{"id":"manas-2010:p0698:b001:l004","ordinal":31085,"en":"We cannot match him in battle;"},{"id":"manas-2010:p0698:b001:l005","ordinal":31086,"en":"Against that damned Burut,"},{"id":"manas-2010:p0698:b001:l006","ordinal":31087,"en":"No man can grapple and prevail."},{"id":"manas-2010:p0698:b001:l007","ordinal":31088,"en":"Manas was born in Altay;"},{"id":"manas-2010:p0698:b001:l008","ordinal":31089,"en":"Upon Esenkan's people"},{"id":"manas-2010:p0698:b001:l009","ordinal":31090,"en":"He brought tumult."},{"id":"manas-2010:p0698:b001:l010","ordinal":31091,"en":"The affairs of nations went awry;"},{"id":"manas-2010:p0698:b001:l011","ordinal":31092,"en":"He made a spectacle of the Chinese."},{"id":"manas-2010:p0698:b001:l012","ordinal":31093,"en":"Khan Manas, that scourge—"},{"id":"manas-2010:p0698:b001:l013","ordinal":31094,"en":"Which of his deeds shall we tell?"},{"id":"manas-2010:p0698:b001:l014","ordinal":31095,"en":"He has astonished many, they say."},{"id":"manas-2010:p0698:b001:l015","ordinal":31096,"en":"Facing them and fighting,"},{"id":"manas-2010:p0698:b001:l016","ordinal":31097,"en":"He slaughtered Beijing's people, they say."},{"id":"manas-2010:p0698:b001:l017","ordinal":31098,"en":"He plundered their wealth;"},{"id":"manas-2010:p0698:b001:l018","ordinal":31099,"en":"Upon Esenkan's people"},{"id":"manas-2010:p0698:b001:l019","ordinal":31100,"en":"He brought havoc in earnest."},{"id":"manas-2010:p0698:b001:l020","ordinal":31101,"en":"He swiftly carried out every outrage."},{"id":"manas-2010:p0698:b001:l021","ordinal":31102,"en":"The monks who fell into his hands"},{"id":"manas-2010:p0698:b001:l022","ordinal":31103,"en":"He castrated, making geldings of them all."},{"id":"manas-2010:p0698:b001:l023","ordinal":31104,"en":"He began to rage fiercely."},{"id":"manas-2010:p0698:b001:l024","ordinal":31105,"en":"When he saw Manas's wrath,"},{"id":"manas-2010:p0698:b001:l025","ordinal":31106,"en":"Then Khan Esenkan"},{"id":"manas-2010:p0698:b001:l026","ordinal":31107,"en":"Beyond Outer Beijing"},{"id":"manas-2010:p0698:b001:l027","ordinal":31108,"en":"Fled away."},{"id":"manas-2010:p0698:b001:l028","ordinal":31109,"en":"He left none of their mighty champions;"},{"id":"manas-2010:p0698:b001:l029","ordinal":31110,"en":"The wrestlers and giants,"},{"id":"manas-2010:p0698:b001:l030","ordinal":31111,"en":"He slaughtered every one of them."},{"id":"manas-2010:p0698:b001:l031","ordinal":31112,"en":"He rescued his people and departed."},{"id":"manas-2010:p0698:b001:l032","ordinal":31113,"en":"The champions Orgo and Dönggö,"},{"id":"manas-2010:p0698:b001:l033","ordinal":31114,"en":"He thrust them all into the earth."},{"id":"manas-2010:p0698:b001:l034","ordinal":31115,"en":"Making blood flow like water,"},{"id":"manas-2010:p0698:b001:l035","ordinal":31116,"en":"From Karakan's descendants"},{"id":"manas-2010:p0698:b001:l036","ordinal":31117,"en":"A blood-stained Burut has arisen."},{"id":"manas-2010:p0698:b001:l037","ordinal":31118,"en":"Settling farther up Talas,"},{"id":"manas-2010:p0698:b001:l038","ordinal":31119,"en":"The fleeing, scattered Kyrgyz"},{"id":"manas-2010:p0698:b001:l039","ordinal":31120,"en":"Gathered together once again"},{"id":"manas-2010:p0698:b001:l040","ordinal":31121,"en":"And raised him as khan, they say,"},{"id":"manas-2010:p0698:b001:l041","ordinal":31122,"en":"Leopard Lord Manas."},{"id":"manas-2010:p0698:b001:l042","ordinal":31123,"en":"Keeping companions, gathering troops,"},{"id":"manas-2010:p0699:b001:l001","ordinal":31124,"en":"He performed great feats, they say."},{"id":"manas-2010:p0699:b001:l002","ordinal":31125,"en":"The Chinese and Manzhuu he encountered,"},{"id":"manas-2010:p0699:b001:l003","ordinal":31126,"en":"He slaughtered like sheep, they say."},{"id":"manas-2010:p0699:b001:l004","ordinal":31127,"en":"Manas has risen as a warrior among the Burut;"},{"id":"manas-2010:p0699:b001:l005","ordinal":31128,"en":"His face wears a savage aspect."},{"id":"manas-2010:p0699:b001:l006","ordinal":31129,"en":"That Burut, blazing with fire,"},{"id":"manas-2010:p0699:b001:l007","ordinal":31130,"en":"Is our enemy by his very nature."},{"id":"manas-2010:p0699:b001:l008","ordinal":31131,"en":"Manas is no ordinary son,"},{"id":"manas-2010:p0699:b001:l009","ordinal":31132,"en":"No servant who will let us prosper."},{"id":"manas-2010:p0699:b001:l010","ordinal":31133,"en":"Appearing from the unseen,"},{"id":"manas-2010:p0699:b001:l011","ordinal":31134,"en":"All the blood-drinkers"},{"id":"manas-2010:p0699:b001:l012","ordinal":31135,"en":"Came forth from every ravine."},{"id":"manas-2010:p0699:b001:l013","ordinal":31136,"en":"Can we remain without taking control?"},{"id":"manas-2010:p0699:b001:l014","ordinal":31137,"en":"That blood-stained destroyer of the world,"},{"id":"manas-2010:p0699:b001:l015","ordinal":31138,"en":"Will he spare us if we face him?"},{"id":"manas-2010:p0699:b001:l016","ordinal":31139,"en":"He leaves none he encounters unharmed,"},{"id":"manas-2010:p0699:b001:l017","ordinal":31140,"en":"That blood-stained Manas of yours."},{"id":"manas-2010:p0699:b001:l018","ordinal":31141,"en":"Knowing about us, that crafty fellow:"},{"id":"manas-2010:p0699:b001:l019","ordinal":31142,"en":"A spy fled to him, they say."},{"id":"manas-2010:p0699:b001:l020","ordinal":31143,"en":"May your wish never be granted!"},{"id":"manas-2010:p0699:b001:l021","ordinal":31144,"en":"He simply sent word, they say."},{"id":"manas-2010:p0699:b001:l022","ordinal":31145,"en":"With this, warrior Manas,"},{"id":"manas-2010:p0699:b001:l023","ordinal":31146,"en":"To come to you now,"},{"id":"manas-2010:p0699:b001:l024","ordinal":31147,"en":"To open the mouth of the gate,"},{"id":"manas-2010:p0699:b001:l025","ordinal":31148,"en":"The golden treasure you amassed"},{"id":"manas-2010:p0699:b001:l026","ordinal":31149,"en":"To wipe out and scatter,"},{"id":"manas-2010:p0699:b001:l027","ordinal":31150,"en":"Gathering winged steeds, gathering troops,"},{"id":"manas-2010:p0699:b001:l028","ordinal":31151,"en":"Gathering abundant troubles of every kind,"},{"id":"manas-2010:p0699:b001:l029","ordinal":31152,"en":"Drawing bows like falling rain,"},{"id":"manas-2010:p0699:b001:l030","ordinal":31153,"en":"Shooting arrows thicker than hail,"},{"id":"manas-2010:p0699:b001:l031","ordinal":31154,"en":"Let the Burut not swarm upon us!"},{"id":"manas-2010:p0699:b001:l032","ordinal":31155,"en":"Lord, consider this and understand!"},{"id":"manas-2010:p0699:b001:l033","ordinal":31156,"en":"Let him not trample our heads,"},{"id":"manas-2010:p0699:b001:l034","ordinal":31157,"en":"Let him not scatter the four kinds of livestock,"},{"id":"manas-2010:p0699:b001:l035","ordinal":31158,"en":"Let him not destroy the governor,"},{"id":"manas-2010:p0699:b001:l036","ordinal":31159,"en":"Let him not slaughter us all, leaving none."},{"id":"manas-2010:p0699:b001:l037","ordinal":31160,"en":"The reason Manas will slaughter us:"},{"id":"manas-2010:p0699:b001:l038","ordinal":31161,"en":"He has a grievance that pains him deeply;"},{"id":"manas-2010:p0699:b001:l039","ordinal":31162,"en":"He has an endless grudge against you."},{"id":"manas-2010:p0699:b001:l040","ordinal":31163,"en":"Will Manas leave without clashing?"},{"id":"manas-2010:p0699:b001:l041","ordinal":31164,"en":"That damned Burut,"},{"id":"manas-2010:p0699:b001:l042","ordinal":31165,"en":"Will he remain without taking vengeance?"},{"id":"manas-2010:p0700:b001:l001","ordinal":31166,"en":"For how many years have we lived in a white dwelling?"},{"id":"manas-2010:p0700:b001:l002","ordinal":31167,"en":"Why should we linger?"},{"id":"manas-2010:p0700:b001:l003","ordinal":31168,"en":"Your Chinese have been defeated."},{"id":"manas-2010:p0700:b001:l004","ordinal":31169,"en":"Come, Alöökö, let us go!"},{"id":"manas-2010:p0700:b001:l005","ordinal":31170,"en":"If we leave now, there will be no quarrel."},{"id":"manas-2010:p0700:b001:l006","ordinal":31171,"en":"If we follow the old accounts,"},{"id":"manas-2010:p0700:b001:l007","ordinal":31172,"en":"If we ask the knowledgeable,"},{"id":"manas-2010:p0700:b001:l008","ordinal":31173,"en":"Against this blood-stained Manas"},{"id":"manas-2010:p0700:b001:l009","ordinal":31174,"en":"None remains who can turn a catching pole."},{"id":"manas-2010:p0700:b001:l010","ordinal":31175,"en":"When Manas's name is heard,"},{"id":"manas-2010:p0700:b001:l011","ordinal":31176,"en":"The chief of the sorcerers, Chong Biler—"},{"id":"manas-2010:p0700:b001:l012","ordinal":31177,"en":"My lower ribs throb,"},{"id":"manas-2010:p0700:b001:l013","ordinal":31178,"en":"My shit-filled bowels shake."},{"id":"manas-2010:p0700:b001:l014","ordinal":31179,"en":"Margalan is no land for us;"},{"id":"manas-2010:p0700:b001:l015","ordinal":31180,"en":"Manas is no friend to us."},{"id":"manas-2010:p0700:b001:l016","ordinal":31181,"en":"Why should we stay here?"},{"id":"manas-2010:p0700:b001:l017","ordinal":31182,"en":"Come, Alöökö, let us go!"},{"id":"manas-2010:p0700:b001:l018","ordinal":31183,"en":"Let us take shelter behind the mountains."},{"id":"manas-2010:p0700:b001:l019","ordinal":31184,"en":"Fleeing without stopping, now"},{"id":"manas-2010:p0700:b001:l020","ordinal":31185,"en":"Let us enter Kakan!"},{"id":"manas-2010:p0700:b001:l021","ordinal":31186,"en":"This gold we have gathered,"},{"id":"manas-2010:p0700:b001:l022","ordinal":31187,"en":"Let it all be lost; let us leave it."},{"id":"manas-2010:p0700:b001:l023","ordinal":31188,"en":"Why should we linger?"},{"id":"manas-2010:p0700:b001:l024","ordinal":31189,"en":"Loading carefully chosen burdens onto mules,"},{"id":"manas-2010:p0700:b001:l025","ordinal":31190,"en":"Let us prepare our route of flight."},{"id":"manas-2010:p0700:b001:l026","ordinal":31191,"en":"Let us not remain here!"},{"id":"manas-2010:p0700:b001:l027","ordinal":31192,"en":"If we stay, Manas will not let us prosper;"},{"id":"manas-2010:p0700:b001:l028","ordinal":31193,"en":"He will leave none of us unharmed."},{"id":"manas-2010:p0700:b001:l029","ordinal":31194,"en":"Your sorcerer has spoken: understand."},{"id":"manas-2010:p0700:b001:l030","ordinal":31195,"en":"O Alöökö, heed my words!"},{"id":"manas-2010:p0700:b001:l031","ordinal":31196,"en":"If he fights sooner or later,"},{"id":"manas-2010:p0700:b001:l032","ordinal":31197,"en":"That Manas, his mother be damned,"},{"id":"manas-2010:p0700:b001:l033","ordinal":31198,"en":"Are his people not here?"},{"id":"manas-2010:p0700:b001:l034","ordinal":31199,"en":"To bring havoc by some means,"},{"id":"manas-2010:p0700:b001:l035","ordinal":31200,"en":"Is his land not here?"},{"id":"manas-2010:p0700:b001:l036","ordinal":31201,"en":"Manas is no ordinary son."},{"id":"manas-2010:p0700:b001:l037","ordinal":31202,"en":"To swagger up and levy tribute,"},{"id":"manas-2010:p0700:b001:l038","ordinal":31203,"en":"These are not the people of Margalan."},{"id":"manas-2010:p0700:b001:l039","ordinal":31204,"en":"Living here in a white dwelling,"},{"id":"manas-2010:p0700:b001:l040","ordinal":31205,"en":"Your valor surpassed Külkana."},{"id":"manas-2010:p0700:b001:l041","ordinal":31206,"en":"The Six Cities and Margalan,"},{"id":"manas-2010:p0700:b001:l042","ordinal":31207,"en":"Let us tell it plainly."},{"id":"manas-2010:p0701:b001:l001","ordinal":31208,"en":"Your subjects left from the Chinese,"},{"id":"manas-2010:p0701:b001:l002","ordinal":31209,"en":"You gathered their gold and levied tribute;"},{"id":"manas-2010:p0701:b001:l003","ordinal":31210,"en":"You caused great quarrels and strife."},{"id":"manas-2010:p0701:b001:l004","ordinal":31211,"en":"Why should we remain in this place?"},{"id":"manas-2010:p0701:b001:l005","ordinal":31212,"en":"Come, Alöökö, let us go!"},{"id":"manas-2010:p0701:b001:l006","ordinal":31213,"en":"The wise among the forty companions,"},{"id":"manas-2010:p0701:b001:l007","ordinal":31214,"en":"The deftest among spearmen,"},{"id":"manas-2010:p0701:b001:l008","ordinal":31215,"en":"Ajybay and Bakay, the two khans,"},{"id":"manas-2010:p0701:b001:l009","ordinal":31216,"en":"To that damned blood-stained warrior"},{"id":"manas-2010:p0701:b001:l010","ordinal":31217,"en":"Went and became companions, they say."},{"id":"manas-2010:p0701:b001:l011","ordinal":31218,"en":"The whole wide world"},{"id":"manas-2010:p0701:b001:l012","ordinal":31219,"en":"Magnanimous Manas has sucked dry, they say."},{"id":"manas-2010:p0701:b001:l013","ordinal":31220,"en":"His single self becoming a thousand,"},{"id":"manas-2010:p0701:b001:l014","ordinal":31221,"en":"His established people, before the nations,"},{"id":"manas-2010:p0701:b001:l015","ordinal":31222,"en":"Spread their wings and became renowned."},{"id":"manas-2010:p0701:b001:l016","ordinal":31223,"en":"Maintaining a court, becoming khan,"},{"id":"manas-2010:p0701:b001:l017","ordinal":31224,"en":"Becoming a man with a mountain's weight,"},{"id":"manas-2010:p0701:b001:l018","ordinal":31225,"en":"Two reins and one lead rope"},{"id":"manas-2010:p0701:b001:l019","ordinal":31226,"en":"He grasped into his hands, they say."},{"id":"manas-2010:p0701:b001:l020","ordinal":31227,"en":"Over the Argyn and Kyrgyz"},{"id":"manas-2010:p0701:b001:l021","ordinal":31228,"en":"He has become sultan, they say.”"},{"id":"manas-2010:p0701:b001:l022","ordinal":31229,"en":"This was what the sorcerer said."},{"id":"manas-2010:p0701:b001:l023","ordinal":31230,"en":"Hearing his sorcerer's words,"},{"id":"manas-2010:p0701:b001:l024","ordinal":31231,"en":"He fell into great distress."},{"id":"manas-2010:p0701:b001:l025","ordinal":31232,"en":"Utterly astonished, Alöökö,"}]
