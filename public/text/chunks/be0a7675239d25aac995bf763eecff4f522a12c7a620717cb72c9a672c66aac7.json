[{"id":"manas-2010:p0891:b001:l003","ordinal":39169,"en":"The greatest marvel upon them"},{"id":"manas-2010:p0891:b001:l004","ordinal":39170,"en":"Was worked, I heard."},{"id":"manas-2010:p0891:b001:l005","ordinal":39171,"en":"With battle-axes and clubs,"},{"id":"manas-2010:p0891:b001:l006","ordinal":39172,"en":"The twelve khans' favorites"},{"id":"manas-2010:p0891:b001:l007","ordinal":39173,"en":"Were slaughtered, I heard!"},{"id":"manas-2010:p0891:b001:l008","ordinal":39174,"en":"Their own wealth was scattered, they say."},{"id":"manas-2010:p0891:b001:l009","ordinal":39175,"en":"Going to take Bukhara,"},{"id":"manas-2010:p0891:b001:l010","ordinal":39176,"en":"All twelve khans"},{"id":"manas-2010:p0891:b001:l011","ordinal":39177,"en":"Fled in every direction, they say."},{"id":"manas-2010:p0891:b001:l012","ordinal":39178,"en":"In that city of Bukhara,"},{"id":"manas-2010:p0891:b001:l013","ordinal":39179,"en":"While disorder reigned,"},{"id":"manas-2010:p0891:b001:l014","ordinal":39180,"en":"Living in Anzhyian,"},{"id":"manas-2010:p0891:b001:l015","ordinal":39181,"en":"Aykhozho of the striped robe,"},{"id":"manas-2010:p0891:b001:l016","ordinal":39182,"en":"A truly wise saint,"},{"id":"manas-2010:p0891:b001:l017","ordinal":39183,"en":"From a doorway in Bukhara,"},{"id":"manas-2010:p0891:b001:l018","ordinal":39184,"en":"While battle was being fought,"},{"id":"manas-2010:p0891:b001:l019","ordinal":39185,"en":"Had watched then"},{"id":"manas-2010:p0891:b001:l020","ordinal":39186,"en":"Through a hole in the gateway."},{"id":"manas-2010:p0891:b001:l021","ordinal":39187,"en":"She was dressed in a boy's clothes;"},{"id":"manas-2010:p0891:b001:l022","ordinal":39188,"en":"The people shouted in confusion."},{"id":"manas-2010:p0891:b001:l023","ordinal":39189,"en":"Killing warriors, shattering peoples,"},{"id":"manas-2010:p0891:b001:l024","ordinal":39190,"en":"The hapless warrior Kanykey"},{"id":"manas-2010:p0891:b001:l025","ordinal":39191,"en":"Aykhozho now examined."},{"id":"manas-2010:p0891:b001:l026","ordinal":39192,"en":"Watching her from outside,"},{"id":"manas-2010:p0891:b001:l027","ordinal":39193,"en":"Taking the full measure of her,"},{"id":"manas-2010:p0891:b001:l028","ordinal":39194,"en":"“She is a lion among women,"},{"id":"manas-2010:p0891:b001:l029","ordinal":39195,"en":"All twelve of her limbs are complete."},{"id":"manas-2010:p0891:b001:l030","ordinal":39196,"en":"If she were a man,"},{"id":"manas-2010:p0891:b001:l031","ordinal":39197,"en":"For the eighteen thousand worlds"},{"id":"manas-2010:p0891:b001:l032","ordinal":39198,"en":"She would be a mainstay."},{"id":"manas-2010:p0891:b001:l033","ordinal":39199,"en":"Her pelvic bones are rather narrow;"},{"id":"manas-2010:p0891:b001:l034","ordinal":39200,"en":"In this she has a shortcoming."},{"id":"manas-2010:p0891:b001:l035","ordinal":39201,"en":"Alas, the hapless one"},{"id":"manas-2010:p0891:b001:l036","ordinal":39202,"en":"Has a sign of being unable to bear children."},{"id":"manas-2010:p0891:b001:l037","ordinal":39203,"en":"Apart from that,"},{"id":"manas-2010:p0891:b001:l038","ordinal":39204,"en":"Where does she have a fault?"},{"id":"manas-2010:p0891:b001:l039","ordinal":39205,"en":"She is a soul with sacred power,"},{"id":"manas-2010:p0891:b001:l040","ordinal":39206,"en":"The hardship of six months ahead"},{"id":"manas-2010:p0891:b001:l041","ordinal":39207,"en":"She can tell at this very moment."},{"id":"manas-2010:p0891:b001:l042","ordinal":39208,"en":"On the fierce woman's right shoulder,"},{"id":"manas-2010:p0892:b001:l001","ordinal":39209,"en":"There is a naked child."},{"id":"manas-2010:p0892:b001:l002","ordinal":39210,"en":"When she speaks and acts,"},{"id":"manas-2010:p0892:b001:l003","ordinal":39211,"en":"Her deeds depend upon God."},{"id":"manas-2010:p0892:b001:l004","ordinal":39212,"en":"Ah, in that fierce woman"},{"id":"manas-2010:p0892:b001:l005","ordinal":39213,"en":"There is true sacred power!"},{"id":"manas-2010:p0892:b001:l006","ordinal":39214,"en":"Kanykey is no mere woman;"},{"id":"manas-2010:p0892:b001:l007","ordinal":39215,"en":"To the son of man who meets her,"},{"id":"manas-2010:p0892:b001:l008","ordinal":39216,"en":"She is a mountain-high Night of Power."},{"id":"manas-2010:p0892:b001:l009","ordinal":39217,"en":"If that hapless one comes into your hands,"},{"id":"manas-2010:p0892:b001:l010","ordinal":39218,"en":"She is a source of blessing."},{"id":"manas-2010:p0892:b001:l011","ordinal":39219,"en":"Removing misfortune, opening the heart,"},{"id":"manas-2010:p0892:b001:l012","ordinal":39220,"en":"She is a precious soul, he says."},{"id":"manas-2010:p0892:b001:l013","ordinal":39221,"en":"To exactly fourteen"},{"id":"manas-2010:p0892:b001:l014","ordinal":39222,"en":"She has now grown, he says."},{"id":"manas-2010:p0892:b001:l015","ordinal":39223,"en":"Looking at her stature,"},{"id":"manas-2010:p0892:b001:l016","ordinal":39224,"en":"A beauty of dusky complexion,"},{"id":"manas-2010:p0892:b001:l017","ordinal":39225,"en":"A radiant one among Muslims."},{"id":"manas-2010:p0892:b001:l018","ordinal":39226,"en":"The youngest of twelve daughters,"},{"id":"manas-2010:p0892:b001:l019","ordinal":39227,"en":"A servant beloved of God."},{"id":"manas-2010:p0892:b001:l020","ordinal":39228,"en":"Her disposition is good, I hear."},{"id":"manas-2010:p0892:b001:l021","ordinal":39229,"en":"Precious scarlet silk,"},{"id":"manas-2010:p0892:b001:l022","ordinal":39230,"en":"Spoken of in books,"},{"id":"manas-2010:p0892:b001:l023","ordinal":39231,"en":"A radiant maiden of paradise."},{"id":"manas-2010:p0892:b001:l024","ordinal":39232,"en":"One fault of the hapless girl:"},{"id":"manas-2010:p0892:b001:l025","ordinal":39233,"en":"Her forehead bone slopes back, he says."},{"id":"manas-2010:p0892:b001:l026","ordinal":39234,"en":"After the warrior passes away,"},{"id":"manas-2010:p0892:b001:l027","ordinal":39235,"en":"Her livelihood will be meager, he says."},{"id":"manas-2010:p0892:b001:l028","ordinal":39236,"en":"The hair at her nape is grass, he said."},{"id":"manas-2010:p0892:b001:l029","ordinal":39237,"en":"When the precious one's eyes close,"},{"id":"manas-2010:p0892:b001:l030","ordinal":39238,"en":"That hapless one's troubles will be many, he said."},{"id":"manas-2010:p0892:b001:l031","ordinal":39239,"en":"The hardship of six months ahead"},{"id":"manas-2010:p0892:b001:l032","ordinal":39240,"en":"She can tell at this very moment."},{"id":"manas-2010:p0892:b001:l033","ordinal":39241,"en":"A true seer, he called her;"},{"id":"manas-2010:p0892:b001:l034","ordinal":39242,"en":"These were Aykhozho's words."},{"id":"manas-2010:p0892:b001:l035","ordinal":39243,"en":"For you yourself, my magnanimous one,"},{"id":"manas-2010:p0892:b001:l036","ordinal":39244,"en":"He said she was worthy!"},{"id":"manas-2010:p0892:b001:l037","ordinal":39245,"en":"We shall camp in the open wilderness;"},{"id":"manas-2010:p0892:b001:l038","ordinal":39246,"en":"If my sultan remains safe,"},{"id":"manas-2010:p0892:b001:l039","ordinal":39247,"en":"With that hapless Kanykey"},{"id":"manas-2010:p0892:b001:l040","ordinal":39248,"en":"We shall part without battle!"},{"id":"manas-2010:p0892:b001:l041","ordinal":39249,"en":"Judge what sort of person she is."},{"id":"manas-2010:p0892:b001:l042","ordinal":39250,"en":"Magnanimous Manas, if you heed me,"},{"id":"manas-2010:p0893:b001:l001","ordinal":39251,"en":"Take Kanykey as your wife,"},{"id":"manas-2010:p0893:b001:l002","ordinal":39252,"en":"And go through life with her!"},{"id":"manas-2010:p0893:b001:l003","ordinal":39253,"en":"If Kanykey meets you,"},{"id":"manas-2010:p0893:b001:l004","ordinal":39254,"en":"She will restore what you have lost."},{"id":"manas-2010:p0893:b001:l005","ordinal":39255,"en":"Do not belittle such a fierce woman;"},{"id":"manas-2010:p0893:b001:l006","ordinal":39256,"en":"She will make good your shortcomings."},{"id":"manas-2010:p0893:b001:l007","ordinal":39257,"en":"She will understand a twitch of your brow."},{"id":"manas-2010:p0893:b001:l008","ordinal":39258,"en":"Kanykey will not cause you grief,"},{"id":"manas-2010:p0893:b001:l009","ordinal":39259,"en":"Will not make your head ache!"},{"id":"manas-2010:p0893:b001:l010","ordinal":39260,"en":"What your khan elder Bakay has said,"},{"id":"manas-2010:p0893:b001:l011","ordinal":39261,"en":"Consider, Manas, and judge for yourself."},{"id":"manas-2010:p0893:b001:l012","ordinal":39262,"en":"If you should take Kanykey,"},{"id":"manas-2010:p0893:b001:l013","ordinal":39263,"en":"She is not Kanykey but the Night of Power."},{"id":"manas-2010:p0893:b001:l014","ordinal":39264,"en":"If you take Kanykey, my blue-maned one,"},{"id":"manas-2010:p0893:b001:l015","ordinal":39265,"en":"All yearning will cease,"},{"id":"manas-2010:p0893:b001:l016","ordinal":39266,"en":"All misfortune will be undone!"},{"id":"manas-2010:p0893:b001:l017","ordinal":39267,"en":"That hapless Kanykey"},{"id":"manas-2010:p0893:b001:l018","ordinal":39268,"en":"Will hear your words unwaveringly."},{"id":"manas-2010:p0893:b001:l019","ordinal":39269,"en":"If fate grants you safely to take her,"},{"id":"manas-2010:p0893:b001:l020","ordinal":39270,"en":"She will make you a king!"},{"id":"manas-2010:p0893:b001:l021","ordinal":39271,"en":"If you take Kanykey,"},{"id":"manas-2010:p0893:b001:l022","ordinal":39272,"en":"Bulletproof armor will settle on your back."},{"id":"manas-2010:p0893:b001:l023","ordinal":39273,"en":"The strongest of every people,"},{"id":"manas-2010:p0893:b001:l024","ordinal":39274,"en":"Mighty warriors will come into your hands!"},{"id":"manas-2010:p0893:b001:l025","ordinal":39275,"en":"There will be benefit for your blood;"},{"id":"manas-2010:p0893:b001:l026","ordinal":39276,"en":"Kanykey will be a companion"},{"id":"manas-2010:p0893:b001:l027","ordinal":39277,"en":"To you, your father's only son."},{"id":"manas-2010:p0893:b001:l028","ordinal":39278,"en":"She will reduce your enemies to one;"},{"id":"manas-2010:p0893:b001:l029","ordinal":39279,"en":"If you encounter Kanykey,"},{"id":"manas-2010:p0893:b001:l030","ordinal":39280,"en":"She will make your kin a thousand!"},{"id":"manas-2010:p0893:b001:l031","ordinal":39281,"en":"This unbeliever Kanykey,"},{"id":"manas-2010:p0893:b001:l032","ordinal":39282,"en":"If you meet her, will be your wisdom."},{"id":"manas-2010:p0893:b001:l033","ordinal":39283,"en":"Thrown into fire, she will not become ash;"},{"id":"manas-2010:p0893:b001:l034","ordinal":39284,"en":"Fallen among enemies, she will not become a slave."},{"id":"manas-2010:p0893:b001:l035","ordinal":39285,"en":"She is the cherished one, she is the wife;"},{"id":"manas-2010:p0893:b001:l036","ordinal":39286,"en":"She makes her woman's self a warrior,"},{"id":"manas-2010:p0893:b001:l037","ordinal":39287,"en":"Makes her own head a banner."},{"id":"manas-2010:p0893:b001:l038","ordinal":39288,"en":"The wife you have taken,"},{"id":"manas-2010:p0893:b001:l039","ordinal":39289,"en":"Shooruk's daughter Akylay—"},{"id":"manas-2010:p0893:b001:l040","ordinal":39290,"en":"How she rustles, wondrous girl!"},{"id":"manas-2010:p0893:b001:l041","ordinal":39291,"en":"When spoken to, she will not listen;"},{"id":"manas-2010:p0894:b001:l001","ordinal":39292,"en":"Coarse in disposition, cold in speech,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"manas-2010:p0894:b001:l002","ordinal":39293,"en":"She is an utterly wretched soul!"},{"id":"manas-2010:p0894:b001:l003","ordinal":39294,"en":"Stingy toward her husband, utterly fierce!"},{"id":"manas-2010:p0894:b001:l004","ordinal":39295,"en":"That battered fierce woman"},{"id":"manas-2010:p0894:b001:l005","ordinal":39296,"en":"Has so much quarrelsomeness!"},{"id":"manas-2010:p0894:b001:l006","ordinal":39297,"en":"Warrior, your wife is haughty,"},{"id":"manas-2010:p0894:b001:l007","ordinal":39298,"en":"Your arrogant unbeliever!"},{"id":"manas-2010:p0894:b001:l008","ordinal":39299,"en":"If you live with Akylay,"},{"id":"manas-2010:p0894:b001:l009","ordinal":39300,"en":"I have told you; know it yourself."},{"id":"manas-2010:p0894:b001:l010","ordinal":39301,"en":"If you truly are a khan,"},{"id":"manas-2010:p0894:b001:l011","ordinal":39302,"en":"My magnanimous Manas, heed me!"},{"id":"manas-2010:p0894:b001:l012","ordinal":39303,"en":"If you live with Akylay,"},{"id":"manas-2010:p0894:b001:l013","ordinal":39304,"en":"Not one garment will leave your back."},{"id":"manas-2010:p0894:b001:l014","ordinal":39305,"en":"If she lets her cold words flow,"},{"id":"manas-2010:p0894:b001:l015","ordinal":39306,"en":"Mighty warriors will leave your hands!"},{"id":"manas-2010:p0894:b001:l016","ordinal":39307,"en":"Fond of men, insolent of mouth,"},{"id":"manas-2010:p0894:b001:l017","ordinal":39308,"en":"She can devise no counsel."},{"id":"manas-2010:p0894:b001:l018","ordinal":39309,"en":"There is no calamity like Akylay!"},{"id":"manas-2010:p0894:b001:l019","ordinal":39310,"en":"If you live with Akylay,"},{"id":"manas-2010:p0894:b001:l020","ordinal":39311,"en":"Know that this is what I say:"},{"id":"manas-2010:p0894:b001:l021","ordinal":39312,"en":"Your affairs will never prosper;"},{"id":"manas-2010:p0894:b001:l022","ordinal":39313,"en":"She will never bear a child."},{"id":"manas-2010:p0894:b001:l023","ordinal":39314,"en":"If you live with Akylay,"},{"id":"manas-2010:p0894:b001:l024","ordinal":39315,"en":"No one will come as your guest."},{"id":"manas-2010:p0894:b001:l025","ordinal":39316,"en":"Those who come will leave for the wilderness;"},{"id":"manas-2010:p0894:b001:l026","ordinal":39317,"en":"Your affairs will fall apart!"},{"id":"manas-2010:p0894:b001:l027","ordinal":39318,"en":"If you take Kanykey,"},{"id":"manas-2010:p0894:b001:l028","ordinal":39319,"en":"She is a soul with sacred power,"},{"id":"manas-2010:p0894:b001:l029","ordinal":39320,"en":"She is the source of blessing."},{"id":"manas-2010:p0894:b001:l030","ordinal":39321,"en":"If you are to take Kanykey,"},{"id":"manas-2010:p0894:b001:l031","ordinal":39322,"en":"She is the very Night of Power!"},{"id":"manas-2010:p0894:b001:l032","ordinal":39323,"en":"This year, Manas, if you heed me,"},{"id":"manas-2010:p0894:b001:l033","ordinal":39324,"en":"Let us scout thoroughly."},{"id":"manas-2010:p0894:b001:l034","ordinal":39325,"en":"When this year passes,"},{"id":"manas-2010:p0894:b001:l035","ordinal":39326,"en":"When the coming year arrives,"},{"id":"manas-2010:p0894:b001:l036","ordinal":39327,"en":"To Temirkan, khan of Bukhara,"},{"id":"manas-2010:p0894:b001:l037","ordinal":39328,"en":"Saying, “Give us Kanykey,”"},{"id":"manas-2010:p0894:b001:l038","ordinal":39329,"en":"Let us go to form a marriage alliance!"},{"id":"manas-2010:p0894:b001:l039","ordinal":39330,"en":"Bowing humbly, driving livestock,"},{"id":"manas-2010:p0894:b001:l040","ordinal":39331,"en":"Making the alliance, feasting on fat,"},{"id":"manas-2010:p0894:b001:l041","ordinal":39332,"en":"If we give countless treasures and livestock,"},{"id":"manas-2010:p0894:b001:l042","ordinal":39333,"en":"However many myriad beasts we give,"},{"id":"manas-2010:p0895:b001:l001","ordinal":39334,"en":"This will bring you blessing."},{"id":"manas-2010:p0895:b001:l002","ordinal":39335,"en":"Listen well to these words!"},{"id":"manas-2010:p0895:b001:l003","ordinal":39336,"en":"If you do not heed what is said,"},{"id":"manas-2010:p0895:b001:l004","ordinal":39337,"en":"Your fame will never spread."},{"id":"manas-2010:p0895:b001:l005","ordinal":39338,"en":"She will never let you reach your aim,"},{"id":"manas-2010:p0895:b001:l006","ordinal":39339,"en":"Your whore of a wife, Akylay!’"},{"id":"manas-2010:p0895:b001:l007","ordinal":39340,"en":"When Bakay said this,"},{"id":"manas-2010:p0895:b001:l008","ordinal":39341,"en":"Your royal lord obeyed."},{"id":"manas-2010:p0895:b001:l009","ordinal":39342,"en":"Taking many kinds of people,"},{"id":"manas-2010:p0895:b001:l010","ordinal":39343,"en":"Taking the khans Azhybay and Bakay,"},{"id":"manas-2010:p0895:b001:l011","ordinal":39344,"en":"Wearing out horses, exploring the land,"},{"id":"manas-2010:p0895:b001:l012","ordinal":39345,"en":"Releasing hounds, flying hunting birds,"},{"id":"manas-2010:p0895:b001:l013","ordinal":39346,"en":"Unhurried, the blue-maned warriors,"},{"id":"manas-2010:p0895:b001:l014","ordinal":39347,"en":"Wearing their horses to exhaustion,"},{"id":"manas-2010:p0895:b001:l015","ordinal":39348,"en":"Through the whole wide world"},{"id":"manas-2010:p0895:b001:l016","ordinal":39349,"en":"Traveled on hunting expeditions."},{"id":"manas-2010:p0895:b001:l017","ordinal":39350,"en":"When bored, they shot roe deer;"},{"id":"manas-2010:p0895:b001:l018","ordinal":39351,"en":"When not bored, in the wilderness"},{"id":"manas-2010:p0895:b001:l019","ordinal":39352,"en":"They played at ease."},{"id":"manas-2010:p0895:b001:l020","ordinal":39353,"en":"Seeking wild asses, searching for game,"},{"id":"manas-2010:p0895:b001:l021","ordinal":39354,"en":"They swept down Zheek-Moynok."},{"id":"manas-2010:p0895:b001:l022","ordinal":39355,"en":"On this side of Samarkand,"},{"id":"manas-2010:p0895:b001:l023","ordinal":39356,"en":"They traveled along the broad open plain."},{"id":"manas-2010:p0895:b001:l024","ordinal":39357,"en":"To the broad yellow plain,"},{"id":"manas-2010:p0895:b001:l025","ordinal":39358,"en":"When they went scouting,"},{"id":"manas-2010:p0895:b001:l026","ordinal":39359,"en":"There was Lord Khan Manas,"},{"id":"manas-2010:p0895:b001:l027","ordinal":39360,"en":"Azhybay and Bakay were there too."},{"id":"manas-2010:p0895:b001:l028","ordinal":39361,"en":"Making the unknown known,"},{"id":"manas-2010:p0895:b001:l029","ordinal":39362,"en":"Bakay was exceedingly learned."},{"id":"manas-2010:p0895:b001:l030","ordinal":39363,"en":"That elder Bakay,"},{"id":"manas-2010:p0895:b001:l031","ordinal":39364,"en":"Up a ridge shaped like a saddle back,"},{"id":"manas-2010:p0895:b001:l032","ordinal":39365,"en":"Rode to the top."},{"id":"manas-2010:p0895:b001:l033","ordinal":39366,"en":"He turned his steed."},{"id":"manas-2010:p0895:b001:l034","ordinal":39367,"en":"Your falcon elder Bakay"},{"id":"manas-2010:p0895:b001:l035","ordinal":39368,"en":"Looked out to the side."},{"id":"manas-2010:p0895:b001:l036","ordinal":39369,"en":"The well-known elder,"},{"id":"manas-2010:p0895:b001:l037","ordinal":39370,"en":"Champion Manas's dear friend,"},{"id":"manas-2010:p0895:b001:l038","ordinal":39371,"en":"Champion Bakay the saint,"},{"id":"manas-2010:p0895:b001:l039","ordinal":39372,"en":"Climbed a hill and shouted."},{"id":"manas-2010:p0895:b001:l040","ordinal":39373,"en":"To Azhybay and Manas,"},{"id":"manas-2010:p0895:b001:l041","ordinal":39374,"en":"“Come here!” he called."},{"id":"manas-2010:p0895:b001:l042","ordinal":39375,"en":"All the warriors raced,"}]
