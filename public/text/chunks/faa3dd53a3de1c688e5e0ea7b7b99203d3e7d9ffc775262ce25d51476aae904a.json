[{"id":"manas-2010:p1684:b001:l011","ordinal":72449,"en":"Renowned leopard Manas,"},{"id":"manas-2010:p1684:b001:l012","ordinal":72450,"en":"Our noble lions—we have lost them."},{"id":"manas-2010:p1684:b001:l013","ordinal":72451,"en":"From the desert of It-Ölbös"},{"id":"manas-2010:p1684:b001:l014","ordinal":72452,"en":"We turned back while fighting."},{"id":"manas-2010:p1684:b001:l015","ordinal":72453,"en":"Almambet and Chubak, the lion heroes,"},{"id":"manas-2010:p1684:b001:l016","ordinal":72454,"en":"Ulak Khan's brave Syrgak—"},{"id":"manas-2010:p1684:b001:l017","ordinal":72455,"en":"Among the forty champions,"},{"id":"manas-2010:p1684:b001:l018","ordinal":72456,"en":"We have lost twelve."},{"id":"manas-2010:p1684:b001:l019","ordinal":72457,"en":"They have dug your trench deep,"},{"id":"manas-2010:p1684:b001:l020","ordinal":72458,"en":"They have boiled up your misery like this;"},{"id":"manas-2010:p1684:b001:l021","ordinal":72459,"en":"They have killed your great Alma."},{"id":"manas-2010:p1684:b001:l022","ordinal":72460,"en":"‘I shall pursue you to Mecca,’ they say."},{"id":"manas-2010:p1684:b001:l023","ordinal":72461,"en":"The formidable Chinese multitude"},{"id":"manas-2010:p1684:b001:l024","ordinal":72462,"en":"Has brought such marvels upon us."},{"id":"manas-2010:p1684:b001:l025","ordinal":72463,"en":"They have destroyed your support,"},{"id":"manas-2010:p1684:b001:l026","ordinal":72464,"en":"Reducing everything to dust,"},{"id":"manas-2010:p1684:b001:l027","ordinal":72465,"en":"They have slaughtered your Muslim people."},{"id":"manas-2010:p1684:b001:l028","ordinal":72466,"en":"My mighty Alma is no more;"},{"id":"manas-2010:p1684:b001:l029","ordinal":72467,"en":"My hero, who will hold your defenses?"},{"id":"manas-2010:p1684:b001:l030","ordinal":72468,"en":"The people of forty khans have risen;"},{"id":"manas-2010:p1684:b001:l031","ordinal":72469,"en":"The unbelievers have grown furious."},{"id":"manas-2010:p1684:b001:l032","ordinal":72470,"en":"At the emperor's Beijing,"},{"id":"manas-2010:p1684:b001:l033","ordinal":72471,"en":"No one who meets them fares well."},{"id":"manas-2010:p1684:b001:l034","ordinal":72472,"en":"Muzburchak and Khan Kökchö died;"},{"id":"manas-2010:p1684:b001:l035","ordinal":72473,"en":"Everyone who met this Beijing died."},{"id":"manas-2010:p1684:b001:l036","ordinal":72474,"en":"The Chinese have grown stronger now;"},{"id":"manas-2010:p1684:b001:l037","ordinal":72475,"en":"Not one of us will return alive."},{"id":"manas-2010:p1684:b001:l038","ordinal":72476,"en":"The Flood had never swept in there;"},{"id":"manas-2010:p1684:b001:l039","ordinal":72477,"en":"A hellish people are these Chinese."},{"id":"manas-2010:p1684:b001:l040","ordinal":72478,"en":"Unless we halt them, we cannot withdraw safely.”"},{"id":"manas-2010:p1684:b001:l041","ordinal":72479,"en":"Thus he spoke those words,"},{"id":"manas-2010:p1684:b001:l042","ordinal":72480,"en":"Still living, not yet dead, hanging weakly."},{"id":"manas-2010:p1685:b001:l001","ordinal":72481,"en":"The letter written small as a palm,"},{"id":"manas-2010:p1685:b001:l002","ordinal":72482,"en":"Manas stared at wide-eyed."},{"id":"manas-2010:p1685:b001:l003","ordinal":72483,"en":"It was a letter dear Alma had written;"},{"id":"manas-2010:p1685:b001:l004","ordinal":72484,"en":"When he looked intently at the letter,"},{"id":"manas-2010:p1685:b001:l005","ordinal":72485,"en":"The dear lion had written in sorrow,"},{"id":"manas-2010:p1685:b001:l006","ordinal":72486,"en":"In the name of Islam."},{"id":"manas-2010:p1685:b001:l007","ordinal":72487,"en":"“Khan Manas,"},{"id":"manas-2010:p1685:b001:l008","ordinal":72488,"en":"In Beijing, where my birth-blood fell,"},{"id":"manas-2010:p1685:b001:l009","ordinal":72489,"en":"The blood of my body has been shed."},{"id":"manas-2010:p1685:b001:l010","ordinal":72490,"en":"Lion Manas, my soul's friend,"},{"id":"manas-2010:p1685:b001:l011","ordinal":72491,"en":"Saddle your horse well and come;"},{"id":"manas-2010:p1685:b001:l012","ordinal":72492,"en":"‘My lion friend is dead,’ say,"},{"id":"manas-2010:p1685:b001:l013","ordinal":72493,"en":"And recite the Quran well for me."},{"id":"manas-2010:p1685:b001:l014","ordinal":72494,"en":"Storm its sunless city,"},{"id":"manas-2010:p1685:b001:l015","ordinal":72495,"en":"Without lingering long here,"},{"id":"manas-2010:p1685:b001:l016","ordinal":72496,"en":"Give up your hope of me and go!”"},{"id":"manas-2010:p1685:b001:l017","ordinal":72497,"en":"When he saw dear Alma's letter,"},{"id":"manas-2010:p1685:b001:l018","ordinal":72498,"en":"Raging, his words choked off,"},{"id":"manas-2010:p1685:b001:l019","ordinal":72499,"en":"Manas stared and moaned,"},{"id":"manas-2010:p1685:b001:l020","ordinal":72500,"en":"Grief burned deep within him."},{"id":"manas-2010:p1685:b001:l021","ordinal":72501,"en":"Your hero, famed as hero Manas,"},{"id":"manas-2010:p1685:b001:l022","ordinal":72502,"en":"The dear lion turned about;"},{"id":"manas-2010:p1685:b001:l023","ordinal":72503,"en":"His dear eyes like a saker falcon's,"},{"id":"manas-2010:p1685:b001:l024","ordinal":72504,"en":"Unblinking, filled with tears."},{"id":"manas-2010:p1685:b001:l025","ordinal":72505,"en":"Wounded Manas grieved,"},{"id":"manas-2010:p1685:b001:l026","ordinal":72506,"en":"His rib bones felt torn apart,"},{"id":"manas-2010:p1685:b001:l027","ordinal":72507,"en":"Your khan's heart was distracted."},{"id":"manas-2010:p1685:b001:l028","ordinal":72508,"en":"When he grew furious,"},{"id":"manas-2010:p1685:b001:l029","ordinal":72509,"en":"If you watched his face,"},{"id":"manas-2010:p1685:b001:l030","ordinal":72510,"en":"His bloodlust gripped him hard;"},{"id":"manas-2010:p1685:b001:l031","ordinal":72511,"en":"Hair rose in sock-thick tufts."},{"id":"manas-2010:p1685:b001:l032","ordinal":72512,"en":"Then Manas shook and heaved."},{"id":"manas-2010:p1685:b001:l033","ordinal":72513,"en":"When he heard dear Alma's plight,"},{"id":"manas-2010:p1685:b001:l034","ordinal":72514,"en":"He roared in fury."},{"id":"manas-2010:p1685:b001:l035","ordinal":72515,"en":"His eyes blazed like a lion's."},{"id":"manas-2010:p1685:b001:l036","ordinal":72516,"en":"His great teeth, like doors,"},{"id":"manas-2010:p1685:b001:l037","ordinal":72517,"en":"Your khan, leopard Manas,"},{"id":"manas-2010:p1685:b001:l038","ordinal":72518,"en":"Ground them apart, piece by piece."},{"id":"manas-2010:p1685:b001:l039","ordinal":72519,"en":"“My companion, my twin lamb!"},{"id":"manas-2010:p1685:b001:l040","ordinal":72520,"en":"Having devoured my twins,"},{"id":"manas-2010:p1685:b001:l041","ordinal":72521,"en":"How can I go on now?"},{"id":"manas-2010:p1685:b001:l042","ordinal":72522,"en":"The decree Allah has laid down"},{"id":"manas-2010:p1686:b001:l001","ordinal":72523,"en":"Has fallen upon my neck—unless I face it,"},{"id":"manas-2010:p1686:b001:l002","ordinal":72524,"en":"Bereft of the noble ones,"},{"id":"manas-2010:p1686:b001:l003","ordinal":72525,"en":"Rather than stand empty and helpless,"},{"id":"manas-2010:p1686:b001:l004","ordinal":72526,"en":"Unless I enter Beijing and die,"},{"id":"manas-2010:p1686:b001:l005","ordinal":72527,"en":"Kongurbay, khan of the monks,"},{"id":"manas-2010:p1686:b001:l006","ordinal":72528,"en":"Unless I cut off his head,"},{"id":"manas-2010:p1686:b001:l007","ordinal":72529,"en":"Kojozhash, son of Karazhoy,"},{"id":"manas-2010:p1686:b001:l008","ordinal":72530,"en":"The champion who slaughtered my Alma,"},{"id":"manas-2010:p1686:b001:l009","ordinal":72531,"en":"Unless I seize him in the field"},{"id":"manas-2010:p1686:b001:l010","ordinal":72532,"en":"And offer him as a sacrifice,"},{"id":"manas-2010:p1686:b001:l011","ordinal":72533,"en":"The Kara-Kytay in Altay,"},{"id":"manas-2010:p1686:b001:l012","ordinal":72534,"en":"Unless I drive them through Altay,"},{"id":"manas-2010:p1686:b001:l013","ordinal":72535,"en":"The black Kalmyks in Khangay,"},{"id":"manas-2010:p1686:b001:l014","ordinal":72536,"en":"Unless I drive them into Khangay,"},{"id":"manas-2010:p1686:b001:l015","ordinal":72537,"en":"The ill-willed Chinese,"},{"id":"manas-2010:p1686:b001:l016","ordinal":72538,"en":"Unless I drive them all the way to Beijing,"},{"id":"manas-2010:p1686:b001:l017","ordinal":72539,"en":"May I die no longer Manas!"},{"id":"manas-2010:p1686:b001:l018","ordinal":72540,"en":"Bereft of the mighty ones,"},{"id":"manas-2010:p1686:b001:l019","ordinal":72541,"en":"Rather than stand watching in anguish,"},{"id":"manas-2010:p1686:b001:l020","ordinal":72542,"en":"Let me sink away as though never born."},{"id":"manas-2010:p1686:b001:l021","ordinal":72543,"en":"Among the jacket-wearing governors,"},{"id":"manas-2010:p1686:b001:l022","ordinal":72544,"en":"Let me seize the strongest."},{"id":"manas-2010:p1686:b001:l023","ordinal":72545,"en":"Among the Chinese with rank-buttons,"},{"id":"manas-2010:p1686:b001:l024","ordinal":72546,"en":"Killing the finest,"},{"id":"manas-2010:p1686:b001:l025","ordinal":72547,"en":"Let me avenge Almambet."},{"id":"manas-2010:p1686:b001:l026","ordinal":72548,"en":"Laying waste their broad lands,"},{"id":"manas-2010:p1686:b001:l027","ordinal":72549,"en":"The Chinese taken alive"},{"id":"manas-2010:p1686:b001:l028","ordinal":72550,"en":"Enslaving till Judgment Day,"},{"id":"manas-2010:p1686:b001:l029","ordinal":72551,"en":"Thus let me take my vengeance!”"},{"id":"manas-2010:p1686:b001:l030","ordinal":72552,"en":"As the generous one stood grieving,"},{"id":"manas-2010:p1686:b001:l031","ordinal":72553,"en":"The Muslims, at their wits' end,"},{"id":"manas-2010:p1686:b001:l032","ordinal":72554,"en":"Stood bewildered and wept."},{"id":"manas-2010:p1686:b001:l033","ordinal":72555,"en":"To the fierce-maned one barely enduring,"},{"id":"manas-2010:p1686:b001:l034","ordinal":72556,"en":"The God-struck Muslims"},{"id":"manas-2010:p1686:b001:l035","ordinal":72557,"en":"Cried out their complaints."},{"id":"manas-2010:p1686:b001:l036","ordinal":72558,"en":"Some spoke,"},{"id":"manas-2010:p1686:b001:l037","ordinal":72559,"en":"Saying, “I have only one horse.”"},{"id":"manas-2010:p1686:b001:l038","ordinal":72560,"en":"Mostly they spoke nonsense,"},{"id":"manas-2010:p1686:b001:l039","ordinal":72561,"en":"Saying, “I am an only son.”"},{"id":"manas-2010:p1686:b001:l040","ordinal":72562,"en":"Khan Manas grew furious:"},{"id":"manas-2010:p1686:b001:l041","ordinal":72563,"en":"“Whoever says, ‘I have only one horse’—"},{"id":"manas-2010:p1686:b001:l042","ordinal":72564,"en":"Your father's grave, Muslims!—"},{"id":"manas-2010:p1687:b001:l001","ordinal":72565,"en":"I shall slaughter his horse and eat it too."},{"id":"manas-2010:p1687:b001:l002","ordinal":72566,"en":"Whoever says, ‘I am an only son,’"},{"id":"manas-2010:p1687:b001:l003","ordinal":72567,"en":"I shall slaughter him and eat him too."},{"id":"manas-2010:p1687:b001:l004","ordinal":72568,"en":"Whoever says, ‘My strength is feeble,’"},{"id":"manas-2010:p1687:b001:l005","ordinal":72569,"en":"I shall slaughter him now and eat him too!"},{"id":"manas-2010:p1687:b001:l006","ordinal":72570,"en":"If my darling dies, if lives are lost,"},{"id":"manas-2010:p1687:b001:l007","ordinal":72571,"en":"If all the heroes die,"},{"id":"manas-2010:p1687:b001:l008","ordinal":72572,"en":"What answer will you give?"},{"id":"manas-2010:p1687:b001:l009","ordinal":72573,"en":"You people born witless as swine,"},{"id":"manas-2010:p1687:b001:l010","ordinal":72574,"en":"What are you babbling about?"},{"id":"manas-2010:p1687:b001:l011","ordinal":72575,"en":"If you lack courage, worthless people,"},{"id":"manas-2010:p1687:b001:l012","ordinal":72576,"en":"You will destroy this multitude."},{"id":"manas-2010:p1687:b001:l013","ordinal":72577,"en":"If all of you scatter,"},{"id":"manas-2010:p1687:b001:l014","ordinal":72578,"en":"Following your every trace,"},{"id":"manas-2010:p1687:b001:l015","ordinal":72579,"en":"Will they not pursue and scatter you?"},{"id":"manas-2010:p1687:b001:l016","ordinal":72580,"en":"You wailing, worthless people,"},{"id":"manas-2010:p1687:b001:l017","ordinal":72581,"en":"If you are divided, will your Chinese"},{"id":"manas-2010:p1687:b001:l018","ordinal":72582,"en":"Not slaughter every one of you?”"},{"id":"manas-2010:p1687:b001:l019","ordinal":72583,"en":"As Khan Manas stood speaking thus,"},{"id":"manas-2010:p1687:b001:l020","ordinal":72584,"en":"Your multitude trembled,"},{"id":"manas-2010:p1687:b001:l021","ordinal":72585,"en":"Your people quivered helplessly."},{"id":"manas-2010:p1687:b001:l022","ordinal":72586,"en":"When the mighty generous lion"},{"id":"manas-2010:p1687:b001:l023","ordinal":72587,"en":"Gave one shout,"},{"id":"manas-2010:p1687:b001:l024","ordinal":72588,"en":"Their collarbones shook;"},{"id":"manas-2010:p1687:b001:l025","ordinal":72589,"en":"The Muslims were struck speechless,"},{"id":"manas-2010:p1687:b001:l026","ordinal":72590,"en":"All shuddering together."},{"id":"manas-2010:p1687:b001:l027","ordinal":72591,"en":"All the warriors grieved;"},{"id":"manas-2010:p1687:b001:l028","ordinal":72592,"en":"The worthless men without courage"},{"id":"manas-2010:p1687:b001:l029","ordinal":72593,"en":"Despaired of their dear lives."},{"id":"manas-2010:p1687:b001:l030","ordinal":72594,"en":"Their eyes widened;"},{"id":"manas-2010:p1687:b001:l031","ordinal":72595,"en":"Your many people stood distressed."},{"id":"manas-2010:p1687:b001:l032","ordinal":72596,"en":"Blood-drinking leopard Manas"},{"id":"manas-2010:p1687:b001:l033","ordinal":72597,"en":"Now firmly mustered his courage."},{"id":"manas-2010:p1687:b001:l034","ordinal":72598,"en":"Earlier, over the khoja in Kokand,"},{"id":"manas-2010:p1687:b001:l035","ordinal":72599,"en":"When his power had reached him,"},{"id":"manas-2010:p1687:b001:l036","ordinal":72600,"en":"Mungchu in Bukhara,"},{"id":"manas-2010:p1687:b001:l037","ordinal":72601,"en":"When he had overthrown him,"},{"id":"manas-2010:p1687:b001:l038","ordinal":72602,"en":"The Six Cities and Andijan,"},{"id":"manas-2010:p1687:b001:l039","ordinal":72603,"en":"Down to Kokand and Marghilan,"},{"id":"manas-2010:p1687:b001:l040","ordinal":72604,"en":"Upon these places, tumult"},{"id":"manas-2010:p1687:b001:l041","ordinal":72605,"en":"When he had brought it,"},{"id":"manas-2010:p1687:b001:l042","ordinal":72606,"en":"Six thousand silver ingots, a thousand otter pelts,"},{"id":"manas-2010:p1688:b001:l001","ordinal":72607,"en":"Such was the tribute, like this,"},{"id":"manas-2010:p1688:b001:l002","ordinal":72608,"en":"Month by month from the Sarts,"},{"id":"manas-2010:p1688:b001:l003","ordinal":72609,"en":"When he was taking tribute,"},{"id":"manas-2010:p1688:b001:l004","ordinal":72610,"en":"Disorder upon the face of the earth"},{"id":"manas-2010:p1688:b001:l005","ordinal":72611,"en":"When he was bringing it:"},{"id":"manas-2010:p1688:b001:l006","ordinal":72612,"en":"The gray leather belt descended from heaven,"},{"id":"manas-2010:p1688:b001:l007","ordinal":72613,"en":"The belt that befriended his dear life."},{"id":"manas-2010:p1688:b001:l008","ordinal":72614,"en":"Some ignorant people say,"},{"id":"manas-2010:p1688:b001:l009","ordinal":72615,"en":"“When he brought oppression to Kokand,"},{"id":"manas-2010:p1688:b001:l010","ordinal":72616,"en":"It was a belt he took as booty.”"},{"id":"manas-2010:p1688:b001:l011","ordinal":72617,"en":"Those who know say,"},{"id":"manas-2010:p1688:b001:l012","ordinal":72618,"en":"“A gray leather belt descended from heaven,"},{"id":"manas-2010:p1688:b001:l013","ordinal":72619,"en":"A belt that befriends life held in trust."},{"id":"manas-2010:p1688:b001:l014","ordinal":72620,"en":"When he shouted and bound it at his waist,"},{"id":"manas-2010:p1688:b001:l015","ordinal":72621,"en":"The forty hidden saints became his companions."},{"id":"manas-2010:p1688:b001:l016","ordinal":72622,"en":"When he cried out and bound it at his waist,"},{"id":"manas-2010:p1688:b001:l017","ordinal":72623,"en":"The white holy man led his camp."},{"id":"manas-2010:p1688:b001:l018","ordinal":72624,"en":"If an enemy came forth to fight,"},{"id":"manas-2010:p1688:b001:l019","ordinal":72625,"en":"Driving them and shouting,"},{"id":"manas-2010:p1688:b001:l020","ordinal":72626,"en":"The leopard slaughtered them all.”"},{"id":"manas-2010:p1688:b001:l021","ordinal":72627,"en":"He had tethered Akkula;"},{"id":"manas-2010:p1688:b001:l022","ordinal":72628,"en":"If an enemy met him in battle,"},{"id":"manas-2010:p1688:b001:l023","ordinal":72629,"en":"Their misery boiled up."},{"id":"manas-2010:p1688:b001:l024","ordinal":72630,"en":"His protector, Khojosan,"},{"id":"manas-2010:p1688:b001:l025","ordinal":72631,"en":"Prepared beneath his arm;"},{"id":"manas-2010:p1688:b001:l026","ordinal":72632,"en":"A black-spotted lion"},{"id":"manas-2010:p1688:b001:l027","ordinal":72633,"en":"Raged at his flank."},{"id":"manas-2010:p1688:b001:l028","ordinal":72634,"en":"To bring slaughter upon the Chinese,"},{"id":"manas-2010:p1688:b001:l029","ordinal":72635,"en":"Your mighty lord prepared."},{"id":"manas-2010:p1688:b001:l030","ordinal":72636,"en":"Akkula, wondrous among steeds,"},{"id":"manas-2010:p1688:b001:l031","ordinal":72637,"en":"Whose trot the wind could not match,"},{"id":"manas-2010:p1688:b001:l032","ordinal":72638,"en":"Whose walk no beast could match,"},{"id":"manas-2010:p1688:b001:l033","ordinal":72639,"en":"The hardy, noble-blooded charger,"},{"id":"manas-2010:p1688:b001:l034","ordinal":72640,"en":"With sieve-like lungs and copper wings,"},{"id":"manas-2010:p1688:b001:l035","ordinal":72641,"en":"Would not tire if ridden six months."},{"id":"manas-2010:p1688:b001:l036","ordinal":72642,"en":"Your noble one's Akkula,"},{"id":"manas-2010:p1688:b001:l037","ordinal":72643,"en":"Until sixty years into his maturity,"},{"id":"manas-2010:p1688:b001:l038","ordinal":72644,"en":"Would not grow old with worn-down molars."},{"id":"manas-2010:p1688:b001:l039","ordinal":72645,"en":"A bulletproof fine white covering—"},{"id":"manas-2010:p1688:b001:l040","ordinal":72646,"en":"Made by that bitch Kanykey,"},{"id":"manas-2010:p1688:b001:l041","ordinal":72647,"en":"A covering perfectly fitted to Akkula."},{"id":"manas-2010:p1688:b001:l042","ordinal":72648,"en":"Taking his battle-axe in hand,"},{"id":"manas-2010:p1689:b001:l001","ordinal":72649,"en":"Thundering in fury,"},{"id":"manas-2010:p1689:b001:l002","ordinal":72650,"en":"From the stone stronghold firmly held,"},{"id":"manas-2010:p1689:b001:l003","ordinal":72651,"en":"Then Manas came pounding,"},{"id":"manas-2010:p1689:b001:l004","ordinal":72652,"en":"Your distinguished champion Manas."},{"id":"manas-2010:p1689:b001:l005","ordinal":72653,"en":"How could the lion spare himself?"},{"id":"manas-2010:p1689:b001:l006","ordinal":72654,"en":"Leaning upon Akkelte,"},{"id":"manas-2010:p1689:b001:l007","ordinal":72655,"en":"He went straight inward,"},{"id":"manas-2010:p1689:b001:l008","ordinal":72656,"en":"Leading Akkula."},{"id":"manas-2010:p1689:b001:l009","ordinal":72657,"en":"The dear lion, like a fighting cock,"},{"id":"manas-2010:p1689:b001:l010","ordinal":72658,"en":"Stood stiffly gazing on."},{"id":"manas-2010:p1689:b001:l011","ordinal":72659,"en":"Then Kojozhash, son of Karazhoy,"},{"id":"manas-2010:p1689:b001:l012","ordinal":72660,"en":"Bent his knees to the earth;"},{"id":"manas-2010:p1689:b001:l013","ordinal":72661,"en":"Running faster than an arrow,"},{"id":"manas-2010:p1689:b001:l014","ordinal":72662,"en":"His marksmanship surpassing all,"},{"id":"manas-2010:p1689:b001:l015","ordinal":72663,"en":"At the ridge's black cliff,"},{"id":"manas-2010:p1689:b001:l016","ordinal":72664,"en":"Kojozhash reached concealment."},{"id":"manas-2010:p1689:b001:l017","ordinal":72665,"en":"Clad in red garments,"},{"id":"manas-2010:p1689:b001:l018","ordinal":72666,"en":"Coiling more tightly than a flea,"},{"id":"manas-2010:p1689:b001:l019","ordinal":72667,"en":"Before him the many Chinese generals"},{"id":"manas-2010:p1689:b001:l020","ordinal":72668,"en":"Fled with a thunderous rush."},{"id":"manas-2010:p1689:b001:l021","ordinal":72669,"en":"A shot would not pierce Manas himself;"},{"id":"manas-2010:p1689:b001:l022","ordinal":72670,"en":"Akkula beneath him—"},{"id":"manas-2010:p1689:b001:l023","ordinal":72671,"en":"Kojozhash, lying in wait,"},{"id":"manas-2010:p1689:b001:l024","ordinal":72672,"en":"Fired once at the vertebra."},{"id":"manas-2010:p1689:b001:l025","ordinal":72673,"en":"The projectile reached its mark;"},{"id":"manas-2010:p1689:b001:l026","ordinal":72674,"en":"Where it struck Akkula,"},{"id":"manas-2010:p1689:b001:l027","ordinal":72675,"en":"The first neck vertebra's bone"},{"id":"manas-2010:p1689:b001:l028","ordinal":72676,"en":"It grazed as it passed."},{"id":"manas-2010:p1689:b001:l029","ordinal":72677,"en":"The leopard's Akkula,"},{"id":"manas-2010:p1689:b001:l030","ordinal":72678,"en":"Dark blood flowed from his neck artery."},{"id":"manas-2010:p1689:b001:l031","ordinal":72679,"en":"Your Sultan Manas heaved;"},{"id":"manas-2010:p1689:b001:l032","ordinal":72680,"en":"Your king's strength ebbed."},{"id":"manas-2010:p1689:b001:l033","ordinal":72681,"en":"The leopard's Akkula"},{"id":"manas-2010:p1689:b001:l034","ordinal":72682,"en":"Neighed once,"},{"id":"manas-2010:p1689:b001:l035","ordinal":72683,"en":"Turned toward Manas,"},{"id":"manas-2010:p1689:b001:l036","ordinal":72684,"en":"And rested his chin upon him."},{"id":"manas-2010:p1689:b001:l037","ordinal":72685,"en":"Then Khan Manas saw"},{"id":"manas-2010:p1689:b001:l038","ordinal":72686,"en":"The falsehood of this world."},{"id":"manas-2010:p1689:b001:l039","ordinal":72687,"en":"The wondrously swift dun horse"},{"id":"manas-2010:p1689:b001:l040","ordinal":72688,"en":"Had not a spoonful of blood left."},{"id":"manas-2010:p1689:b001:l041","ordinal":72689,"en":"When he tried to lead him, he would not stand."},{"id":"manas-2010:p1689:b001:l042","ordinal":72690,"en":"Turning to face the north,"},{"id":"manas-2010:p1690:b001:l001","ordinal":72691,"en":"As though a mountain fell,"},{"id":"manas-2010:p1690:b001:l002","ordinal":72692,"en":"Your wretched one's Akkula"},{"id":"manas-2010:p1690:b001:l003","ordinal":72693,"en":"Collapsed at that moment."},{"id":"manas-2010:p1690:b001:l004","ordinal":72694,"en":"“Perish, world of torment!” he cried."},{"id":"manas-2010:p1690:b001:l005","ordinal":72695,"en":"Unable to stand bearing such sorrow,"},{"id":"manas-2010:p1690:b001:l006","ordinal":72696,"en":"The king bit his thumb till it split."},{"id":"manas-2010:p1690:b001:l007","ordinal":72697,"en":"The white saber with its striped neck"},{"id":"manas-2010:p1690:b001:l008","ordinal":72698,"en":"The dear lion seized"},{"id":"manas-2010:p1690:b001:l009","ordinal":72699,"en":"And slaughtered Akkula."},{"id":"manas-2010:p1690:b001:l010","ordinal":72700,"en":"“Perish, immeasurable world!"},{"id":"manas-2010:p1690:b001:l011","ordinal":72701,"en":"How can I arrive without dying?"},{"id":"manas-2010:p1690:b001:l012","ordinal":72702,"en":"If I see Talas alive,"},{"id":"manas-2010:p1690:b001:l013","ordinal":72703,"en":"My beloved Akkula's forelock"},{"id":"manas-2010:p1690:b001:l014","ordinal":72704,"en":"I shall smell as a keepsake.”"}]
