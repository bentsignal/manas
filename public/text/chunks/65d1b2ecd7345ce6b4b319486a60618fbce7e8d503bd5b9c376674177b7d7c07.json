[{"id":"seytek-2012:p1079:b002:l029","ordinal":378881,"en":"Riding twin thoroughbred steeds,"},{"id":"seytek-2012:p1079:b002:l030","ordinal":378882,"en":"They have traveled the road steadfastly."},{"id":"seytek-2012:p1079:b002:l031","ordinal":378883,"en":"Your sheltering poplar is now within your grasp;"},{"id":"seytek-2012:p1079:b002:l032","ordinal":378884,"en":"Speak, sister, and answer me."},{"id":"seytek-2012:p1079:b002:l033","ordinal":378885,"en":"As for those heroes who have come,"},{"id":"seytek-2012:p1079:b002:l034","ordinal":378886,"en":"From what I saw, they are of this kind:"},{"id":"seytek-2012:p1079:b002:l035","ordinal":378887,"en":"They could sweep aside eighty-four"},{"id":"seytek-2012:p1079:b002:l036","ordinal":378888,"en":"Mountains of armor, leaving crimson fire behind."},{"id":"seytek-2012:p1079:b002:l037","ordinal":378889,"en":"Their presence is supreme, their wrath is strong;"},{"id":"seytek-2012:p1079:b002:l038","ordinal":378890,"en":"They level whatever lies before them."},{"id":"seytek-2012:p1079:b002:l039","ordinal":378891,"en":"He is tall and broad-shouldered,"},{"id":"seytek-2012:p1079:b002:l040","ordinal":378892,"en":"Both a champion and a lion,"},{"id":"seytek-2012:p1079:b003:l001","ordinal":378893,"en":"And seems beyond compare."},{"id":"seytek-2012:p1079:b003:l002","ordinal":378894,"en":"His heroism is unlike any other;"},{"id":"seytek-2012:p1079:b003:l003","ordinal":378895,"en":"His figure appeared as vast as a mountain."},{"id":"seytek-2012:p1079:b003:l004","ordinal":378896,"en":"Unable to endure his fury,"},{"id":"seytek-2012:p1079:b003:l005","ordinal":378897,"en":"The watchmen and guards scattered."},{"id":"seytek-2012:p1079:b003:l006","ordinal":378898,"en":"No man could remain and look upon him;"},{"id":"seytek-2012:p1079:b003:l007","ordinal":378899,"en":"They despaired of their lives."},{"id":"seytek-2012:p1079:b003:l008","ordinal":378900,"en":"His courage is lofty as a mountain ridge,"},{"id":"seytek-2012:p1079:b003:l009","ordinal":378901,"en":"As though he would devour anyone who fought him."},{"id":"seytek-2012:p1079:b003:l010","ordinal":378902,"en":"His build is like a towering haze,"},{"id":"seytek-2012:p1079:b003:l011","ordinal":378903,"en":"His stature like a plane tree,"},{"id":"seytek-2012:p1079:b003:l012","ordinal":378904,"en":"His keenness like a hunting falcon’s."},{"id":"seytek-2012:p1079:b003:l013","ordinal":378905,"en":"No living soul can endure his presence;"},{"id":"seytek-2012:p1079:b003:l014","ordinal":378906,"en":"No mortal can stand before him—"},{"id":"seytek-2012:p1079:b003:l015","ordinal":378907,"en":"Such is his heroism."},{"id":"seytek-2012:p1079:b003:l016","ordinal":378908,"en":"He rides a peerless thoroughbred,"},{"id":"seytek-2012:p1079:b003:l017","ordinal":378909,"en":"And wears armor no bullet can pierce."},{"id":"seytek-2012:p1079:b003:l018","ordinal":378910,"en":"The lion is lofty, his wrath is mighty;"},{"id":"seytek-2012:p1079:b003:l019","ordinal":378911,"en":"No living soul can equal his bearing—"},{"id":"seytek-2012:p1079:b003:l020","ordinal":378912,"en":"A lion among men has come."},{"id":"seytek-2012:p1079:b003:l021","ordinal":378913,"en":"No man can stand and face him;"},{"id":"seytek-2012:p1079:b003:l022","ordinal":378914,"en":"Unable to endure his fury,"},{"id":"seytek-2012:p1079:b003:l023","ordinal":378915,"en":"Many champions were ready to flee."},{"id":"seytek-2012:p1079:b003:l024","ordinal":378916,"en":"He bears a tasseled banner,"},{"id":"seytek-2012:p1079:b003:l025","ordinal":378917,"en":"And all who see his figure rejoice;"},{"id":"seytek-2012:p1079:b003:l026","ordinal":378918,"en":"His equipment includes a steel spear."},{"id":"seytek-2012:p1079:b003:l027","ordinal":378919,"en":"If he grows angry and surges forth,"},{"id":"seytek-2012:p1079:b003:l028","ordinal":378920,"en":"He could ravage the whole world,"},{"id":"seytek-2012:p1079:b003:l029","ordinal":378921,"en":"And the hard black earth beneath him"},{"id":"seytek-2012:p1079:b003:l030","ordinal":378922,"en":"Would tremble to its depths."},{"id":"seytek-2012:p1079:b003:l031","ordinal":378923,"en":"No man can contend with him,"},{"id":"seytek-2012:p1079:b003:l032","ordinal":378924,"en":"No man can defeat him in combat."},{"id":"seytek-2012:p1079:b003:l033","ordinal":378925,"en":"Such is his lionheartedness;"},{"id":"seytek-2012:p1079:b003:l034","ordinal":378926,"en":"No other man is born his equal."},{"id":"seytek-2012:p1079:b003:l035","ordinal":378927,"en":"For one who has suffered such distress,"},{"id":"seytek-2012:p1079:b003:l036","ordinal":378928,"en":"No such lion could be found elsewhere."},{"id":"seytek-2012:p1079:b003:l037","ordinal":378929,"en":"He is a handsome, gray-maned lion,"},{"id":"seytek-2012:p1079:b003:l038","ordinal":378930,"en":"Both a hero and a fierce warrior."},{"id":"seytek-2012:p1079:b003:l039","ordinal":378931,"en":"Driven by the fire of love,"},{"id":"seytek-2012:p1079:b003:l040","ordinal":378932,"en":"He has been searching for you.”"},{"id":"seytek-2012:p1080:b002:l001","ordinal":378933,"en":"“God has granted your heart’s desire;"},{"id":"seytek-2012:p1080:b002:l002","ordinal":378934,"en":"The man you wished for has arrived."},{"id":"seytek-2012:p1080:b002:l003","ordinal":378935,"en":"God has fulfilled your prayer;"},{"id":"seytek-2012:p1080:b002:l004","ordinal":378936,"en":"The man you longed for has come.”"},{"id":"seytek-2012:p1080:b002:l005","ordinal":378937,"en":"Thus Külayim"},{"id":"seytek-2012:p1080:b002:l006","ordinal":378938,"en":"Joyfully brought her the news."},{"id":"seytek-2012:p1080:b002:l007","ordinal":378939,"en":"Then your dear sister Bermet"},{"id":"seytek-2012:p1080:b002:l008","ordinal":378940,"en":"Spoke softly yet with firm resolve,"},{"id":"seytek-2012:p1080:b002:l009","ordinal":378941,"en":"Beginning all manner of words,"},{"id":"seytek-2012:p1080:b002:l010","ordinal":378942,"en":"Thrilled and overcome with haste."},{"id":"seytek-2012:p1080:b002:l011","ordinal":378943,"en":"In red and green silk,"},{"id":"seytek-2012:p1080:b002:l012","ordinal":378944,"en":"She dressed in garments precious as life,"},{"id":"seytek-2012:p1080:b002:l013","ordinal":378945,"en":"And hung upon her breast"},{"id":"seytek-2012:p1080:b002:l014","ordinal":378946,"en":"A solid-gold amulet,"},{"id":"seytek-2012:p1080:b002:l015","ordinal":378947,"en":"Then prayed to the Creator:"},{"id":"seytek-2012:p1080:b002:l016","ordinal":378948,"en":"“You were my companion, Külayim!"},{"id":"seytek-2012:p1080:b002:l017","ordinal":378949,"en":"My lady, precious as the Night of Power,"},{"id":"seytek-2012:p1080:b002:l018","ordinal":378950,"en":"You have rekindled my extinguished fire,"},{"id":"seytek-2012:p1080:b002:l019","ordinal":378951,"en":"Restored a dead soul to life,"},{"id":"seytek-2012:p1080:b002:l020","ordinal":378952,"en":"And joined what had been severed."},{"id":"seytek-2012:p1080:b002:l021","ordinal":378953,"en":"While Akjoltoy traveled the road without rest,"},{"id":"seytek-2012:p1080:b002:l022","ordinal":378954,"en":"I plainly withered in misery."},{"id":"seytek-2012:p1080:b002:l023","ordinal":378955,"en":"Wearing sores upon every steed,"},{"id":"seytek-2012:p1080:b002:l024","ordinal":378956,"en":"And grievously tormenting my heart,"},{"id":"seytek-2012:p1080:b002:l025","ordinal":378957,"en":"I suffered the torments"},{"id":"seytek-2012:p1080:b002:l026","ordinal":378958,"en":"Of this world and wasted away."},{"id":"seytek-2012:p1080:b002:l027","ordinal":378959,"en":"If these words of yours are true,"},{"id":"seytek-2012:p1080:b002:l028","ordinal":378960,"en":"Then today, Külayim, I rejoice."},{"id":"seytek-2012:p1080:b002:l029","ordinal":378961,"en":"My burning heart has been soothed,"},{"id":"seytek-2012:p1080:b002:l030","ordinal":378962,"en":"And my surging spirit has opened."},{"id":"seytek-2012:p1080:b002:l031","ordinal":378963,"en":"The plane tree planted for me has come;"},{"id":"seytek-2012:p1080:b002:l032","ordinal":378964,"en":"The joyful time for play has come."},{"id":"seytek-2012:p1080:b002:l033","ordinal":378965,"en":"A new prosperity has arrived,"},{"id":"seytek-2012:p1080:b002:l034","ordinal":378966,"en":"And a day of radiant sunlight has dawned."},{"id":"seytek-2012:p1080:b002:l035","ordinal":378967,"en":"For tireless play and laughter,"},{"id":"seytek-2012:p1080:b002:l036","ordinal":378968,"en":"A dark night has fallen upon misfortune,"},{"id":"seytek-2012:p1080:b002:l037","ordinal":378969,"en":"And news beyond all finding has come."},{"id":"seytek-2012:p1080:b002:l038","ordinal":378970,"en":"You tireless beauties,"},{"id":"seytek-2012:p1080:b002:l039","ordinal":378971,"en":"Every one of you, make haste!"},{"id":"seytek-2012:p1080:b002:l040","ordinal":378972,"en":"You forlorn maidens who sat in silence,"},{"id":"seytek-2012:p1080:b003:l001","ordinal":378973,"en":"Put on the garments of the fairies!"},{"id":"seytek-2012:p1080:b003:l002","ordinal":378974,"en":"You poor dears who walk beside me,"},{"id":"seytek-2012:p1080:b003:l003","ordinal":378975,"en":"You beauties lovely as paradise,"},{"id":"seytek-2012:p1080:b003:l004","ordinal":378976,"en":"Whose like cannot be found in this false world,"},{"id":"seytek-2012:p1080:b003:l005","ordinal":378977,"en":"Whom I cherish more dearly than my life,"},{"id":"seytek-2012:p1080:b003:l006","ordinal":378978,"en":"It seems to be lion Seytek himself;"},{"id":"seytek-2012:p1080:b003:l007","ordinal":378979,"en":"All of you, heed my words.”"},{"id":"seytek-2012:p1080:b003:l008","ordinal":378980,"en":"When the maidens heard this,"},{"id":"seytek-2012:p1080:b003:l009","ordinal":378981,"en":"In red gowns, with moon-slender waists,"},{"id":"seytek-2012:p1080:b003:l010","ordinal":378982,"en":"Those graceful darlings,"},{"id":"seytek-2012:p1080:b003:l011","ordinal":378983,"en":"Upon hearing Bermet’s words,"},{"id":"seytek-2012:p1080:b003:l012","ordinal":378984,"en":"Could hardly remain without preparing."},{"id":"seytek-2012:p1080:b003:l013","ordinal":378985,"en":"When she gave her stately command,"},{"id":"seytek-2012:p1080:b003:l014","ordinal":378986,"en":"How could the maidens hold back?"},{"id":"seytek-2012:p1080:b003:l015","ordinal":378987,"en":"The one whose speech was sweet,"},{"id":"seytek-2012:p1080:b003:l016","ordinal":378988,"en":"The lovely one with gazelle eyes,"},{"id":"seytek-2012:p1080:b003:l017","ordinal":378989,"en":"The most gifted and graceful of all—"},{"id":"seytek-2012:p1080:b003:l018","ordinal":378990,"en":"With graceful Külayim at their head—"},{"id":"seytek-2012:p1080:b003:l019","ordinal":378991,"en":"Put on silk gowns"},{"id":"seytek-2012:p1080:b003:l020","ordinal":378992,"en":"Fastened with diamond buttons."},{"id":"seytek-2012:p1080:b003:l021","ordinal":378993,"en":"By thoughtful observation she could discern"},{"id":"seytek-2012:p1080:b003:l022","ordinal":378994,"en":"The secrets of the human heart."},{"id":"seytek-2012:p1080:b003:l023","ordinal":378995,"en":"Her beauty was perfect,"},{"id":"seytek-2012:p1080:b003:l024","ordinal":378996,"en":"Setting hearts aflutter anew;"},{"id":"seytek-2012:p1080:b003:l025","ordinal":378997,"en":"The Creator had made such a mortal."},{"id":"seytek-2012:p1080:b003:l026","ordinal":378998,"en":"Everyone who saw her lost his heart;"},{"id":"seytek-2012:p1080:b003:l027","ordinal":378999,"en":"Her words were sugar and her tongue was honey."},{"id":"seytek-2012:p1080:b003:l028","ordinal":379000,"en":"Having taken so fair a maiden,"},{"id":"seytek-2012:p1080:b003:l029","ordinal":379001,"en":"So kind-hearted a companion,"},{"id":"seytek-2012:p1080:b003:l030","ordinal":379002,"en":"The ill-fated woman had made ready."},{"id":"seytek-2012:p1080:b003:l031","ordinal":379003,"en":"Through the many wonders she displayed,"},{"id":"seytek-2012:p1080:b003:l032","ordinal":379004,"en":"And the way her beauty stole every beholder’s heart,"},{"id":"seytek-2012:p1080:b003:l033","ordinal":379005,"en":"Her manner delighted the soul,"},{"id":"seytek-2012:p1080:b003:l034","ordinal":379006,"en":"And she served her faithfully."},{"id":"seytek-2012:p1080:b003:l035","ordinal":379007,"en":"Her beauty was renowned among the people."},{"id":"seytek-2012:p1080:b003:l036","ordinal":379008,"en":"Peacock feathers"},{"id":"seytek-2012:p1080:b003:l037","ordinal":379009,"en":"Were set directly above her crown"},{"id":"seytek-2012:p1080:b003:l038","ordinal":379010,"en":"In ninety different patterns."},{"id":"seytek-2012:p1080:b003:l039","ordinal":379011,"en":"Everyone who looked upon her"},{"id":"seytek-2012:p1080:b003:l040","ordinal":379012,"en":"Marveled and lost his heart."},{"id":"seytek-2012:p1081:b002:l001","ordinal":379013,"en":"The person who sees"},{"id":"seytek-2012:p1081:b002:l002","ordinal":379014,"en":"If I turn it on again,"},{"id":"seytek-2012:p1081:b002:l003","ordinal":379015,"en":"Tears were shed in his eyes."},{"id":"seytek-2012:p1081:b002:l004","ordinal":379016,"en":"Art and other beauties,"},{"id":"seytek-2012:p1081:b002:l005","ordinal":379017,"en":"All of them are beautiful."},{"id":"seytek-2012:p1081:b002:l006","ordinal":379018,"en":"Those who keep searching,"},{"id":"seytek-2012:p1081:b002:l007","ordinal":379019,"en":"Nasip drove and ordered salt,"},{"id":"seytek-2012:p1081:b002:l008","ordinal":379020,"en":"People from Perizat."},{"id":"seytek-2012:p1081:b002:l009","ordinal":379021,"en":"My precious ones,"},{"id":"seytek-2012:p1081:b002:l010","ordinal":379022,"en":"Dressed in royal clothes"},{"id":"seytek-2012:p1081:b002:l011","ordinal":379023,"en":"All the poor souls alike."},{"id":"seytek-2012:p1081:b002:l012","ordinal":379024,"en":"Happy to walk in a row,"},{"id":"seytek-2012:p1081:b002:l013","ordinal":379025,"en":"To see the blood brother"},{"id":"seytek-2012:p1081:b002:l014","ordinal":379026,"en":"come to serve"},{"id":"seytek-2012:p1081:b002:l015","ordinal":379027,"en":"Destroyed without leaving a soul,"},{"id":"seytek-2012:p1081:b002:l016","ordinal":379028,"en":"Only rubies and gold"},{"id":"seytek-2012:p1081:b002:l017","ordinal":379029,"en":"Talisman earrings"},{"id":"seytek-2012:p1081:b002:l018","ordinal":379030,"en":"Fairy's daughter Akbermet,"},{"id":"seytek-2012:p1081:b002:l019","ordinal":379031,"en":"Praying to the Creator"},{"id":"seytek-2012:p1081:b002:l020","ordinal":379032,"en":"The girls next to him"},{"id":"seytek-2012:p1081:b002:l021","ordinal":379033,"en":"Divided under"},{"id":"seytek-2012:p1081:b002:l022","ordinal":379034,"en":"Like the crescent moon,"},{"id":"seytek-2012:p1081:b002:l023","ordinal":379035,"en":"A beam of light spilled from his face."},{"id":"seytek-2012:p1081:b002:l024","ordinal":379036,"en":"Black water if swallowed"},{"id":"seytek-2012:p1081:b002:l025","ordinal":379037,"en":"Fairy's daughter bastard,"},{"id":"seytek-2012:p1081:b002:l026","ordinal":379038,"en":"Of the melting pot,"},{"id":"seytek-2012:p1081:b002:l027","ordinal":379039,"en":"Seen from the food."},{"id":"seytek-2012:p1081:b002:l028","ordinal":379040,"en":"Seitek saw him"},{"id":"seytek-2012:p1081:b002:l029","ordinal":379041,"en":"The fee is divided into kefir."},{"id":"seytek-2012:p1081:b002:l030","ordinal":379042,"en":"My throat is swollen,"},{"id":"seytek-2012:p1081:b002:l031","ordinal":379043,"en":"Atan is happy."},{"id":"seytek-2012:p1081:b002:l032","ordinal":379044,"en":"This has not been found since time immemorial."},{"id":"seytek-2012:p1081:b002:l033","ordinal":379045,"en":"According to the man."},{"id":"seytek-2012:p1081:b002:l034","ordinal":379046,"en":"Twisted back like a rod,"},{"id":"seytek-2012:p1081:b002:l035","ordinal":379047,"en":"The eyes of the beholder darkened,"},{"id":"seytek-2012:p1081:b002:l036","ordinal":379048,"en":"All the bad ones"},{"id":"seytek-2012:p1081:b002:l037","ordinal":379049,"en":"I was ashamed not to go to him,"},{"id":"seytek-2012:p1081:b002:l038","ordinal":379050,"en":"Seitek, seeing his beauty"},{"id":"seytek-2012:p1081:b002:l039","ordinal":379051,"en":"His heart is full of joy."},{"id":"seytek-2012:p1081:b002:l040","ordinal":379052,"en":"Ekeri pearl, cowhar stone,"},{"id":"seytek-2012:p1081:b