{"id": "sayakbay-ms-current146:pdf183:l001", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 183, "folio": 566, "line_in_page": 1, "raw": "Бу кыргыздар жел жетпес,", "text": "Бу кыргыздар жел жетпес,", "en": "These Kyrgyz are beyond the wind’s reach.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf183:l002", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 183, "folio": 566, "line_in_page": 2, "raw": "Бузуп ийди ишиңди,", "text": "Бузуп ийди ишиңди,", "en": "They have ruined your undertaking,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf183:l003", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 183, "folio": 566, "line_in_page": 3, "raw": "Сандырып кетти белиңди,", "text": "Сандырып кетти белиңди,", "en": "And struck your strength from your waist.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf183:l004", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 183, "folio": 566, "line_in_page": 4, "raw": "Жайлап кетти көрүңө,", "text": "Жайлап кетти көрүңө,", "en": "They have laid you in your grave.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf183:l005", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 183, "folio": 566, "line_in_page": 5, "raw": "Эр Орозан, чокон айл,", "text": "Эр Орозан, чокон айл,", "en": "Brave Orozan, lord of Chokon’s people,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf183:l006", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 183, "folio": 566, "line_in_page": 6, "raw": "Бул оңдогон элиңди,", "text": "Бул оңдогон элиңди,", "en": "They have undone the people you set in order.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf183:l007", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 183, "folio": 566, "line_in_page": 7, "raw": "Адам жок, көп болду,", "text": "Адам жок, көп болду,", "en": "There is no man left; they have grown numerous.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf183:l008", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 183, "folio": 566, "line_in_page": 8, "raw": "Артың душман аз болду,", "text": "Артың душман аз болду,", "en": "The enemy behind you has become few.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf183:l009", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 183, "folio": 566, "line_in_page": 9, "raw": "Бел байлаган белимди,", "text": "Бел байлаган белимди,", "en": "My strength that had girded itself,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf183:l010", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 183, "folio": 566, "line_in_page": 10, "raw": "Эркек карам, карын тут,", "text": "Эркек карам, карын тут,", "en": "My manly guardian, hold firm.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf183:l011", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 183, "folio": 566, "line_in_page": 11, "raw": "Бу дүйнөгө келерсиз,", "text": "Бу дүйнөгө келерсиз,", "en": "You will come into this world,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf183:l012", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 183, "folio": 566, "line_in_page": 12, "raw": "Чылатыңдуу калакка,", "text": "Чылатыңдуу калакка,", "en": "To the resounding shield,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf183:l013", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 183, "folio": 566, "line_in_page": 13, "raw": "Кыраан кылган мергенсиң,", "text": "Кыраан кылган мергенсиң,", "en": "You are a keen and deadly marksman.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf183:l014", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 183, "folio": 566, "line_in_page": 14, "raw": "Балбан да элең, шер да элең,", "text": "Балбан да элең, шер да элең,", "en": "You were a wrestler and a champion.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf183:l015", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 183, "folio": 566, "line_in_page": 15, "raw": "Ишенгеним сен элең,", "text": "Ишенгеним сен элең,", "en": "You alone were the one I trusted.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf183:l016", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 183, "folio": 566, "line_in_page": 16, "raw": "Жер алдыңа түшсө да,", "text": "Жер алдыңа түшсө да,", "en": "Even if the earth fell before you,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf183:l017", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 183, "folio": 566, "line_in_page": 17, "raw": "Жел жетпеди кармашка,", "text": "Жел жетпеди кармашка,", "en": "The wind could not overtake you in battle.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf183:l018", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 183, "folio": 566, "line_in_page": 18, "raw": "Эл колун байлап кел,", "text": "Эл колун байлап кел,", "en": "Come after binding the people’s hands.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf183:l019", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 183, "folio": 566, "line_in_page": 19, "raw": "Эки көзүн тең чукуп,", "text": "Эки көзүн тең чукуп,", "en": "Gouge out both their eyes,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf183:l020", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 183, "folio": 566, "line_in_page": 20, "raw": "Сүйрөтпөй тилин кесип кел,", "text": "Сүйрөтпөй тилин кесип кел,", "en": "Cut out their tongues without dragging them,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf183:l021", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 183, "folio": 566, "line_in_page": 21, "raw": "Желкесинен тилип кел,", "text": "Желкесинен тилип кел,", "en": "And slash them from the nape.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf183:l022", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 183, "folio": 566, "line_in_page": 22, "raw": "Калдайдан талап кайгызын,", "text": "Калдайдан талап кайгызын,", "en": "Exact the Kalmyk’s grief by force.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf183:l023", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 183, "folio": 566, "line_in_page": 23, "raw": "Кабыргага тепкери,", "text": "Кабыргага тепкери,", "en": "Kick him in the ribs,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf183:l024", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 183, "folio": 566, "line_in_page": 24, "raw": "Темирге мингизип,", "text": "Темирге мингизип,", "en": "Mount him upon the iron,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf183:l025", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 183, "folio": 566, "line_in_page": 25, "raw": "Кордук кылып жүргүзүп,", "text": "Кордук кылып жүргүзүп,", "en": "Drive him on in humiliation,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf183:l026", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 183, "folio": 566, "line_in_page": 26, "raw": "Түртүп жок күйгүзүп,", "text": "Түртүп жок күйгүзүп,", "en": "Shove him away and burn him,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf183:l027", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 183, "folio": 566, "line_in_page": 27, "raw": "Бери мага айдап кел,", "text": "Бери мага айдап кел,", "en": "And drive him here before me.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf183:l028", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 183, "folio": 566, "line_in_page": 28, "raw": "Берен да элең, шер да элең,", "text": "Берен да элең, шер да элең,", "en": "You were a brave man and a champion.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf183:l029", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 183, "folio": 566, "line_in_page": 29, "raw": "Буруттун кенен уулун,", "text": "Буруттун кенен уулун,", "en": "The broad son of the Burut,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf183:l030", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 183, "folio": 566, "line_in_page": 30, "raw": "Калкайган сунгай тулгун,", "text": "Калкайган сунгай тулгун,", "en": "The towering Sungai falcon,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf183:l031", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 183, "folio": 566, "line_in_page": 31, "raw": "Көк чалкандан кенениң,", "text": "Көк чалкандан кенениң,", "en": "The broad one from Kök-Chalkan,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf183:l032", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 183, "folio": 566, "line_in_page": 32, "raw": "Керишке чыкчу берениң,", "text": "Керишке чыкчу берениң,", "en": "Your champion who rode out to the contest—", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf183:l033", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 183, "folio": 566, "line_in_page": 33, "raw": "Айдоочу кылба ат жолун,", "text": "Айдоочу кылба ат жолун,", "en": "Do not make the road of his horse a drove-road,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf183:l034", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 183, "folio": 566, "line_in_page": 34, "raw": "Ала-Тоодой зор моюн.", "text": "Ала-Тоодой зор моюн.", "en": "His neck was vast as Ala-Too.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
