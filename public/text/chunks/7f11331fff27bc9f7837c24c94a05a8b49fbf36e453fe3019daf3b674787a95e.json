[{"id":"semetey-1-2013:p1001:b005:l027","ordinal":152577,"en":"Raced toward their elder;"},{"id":"semetey-1-2013:p1001:b005:l028","ordinal":152578,"en":"Their two stirrups struck together."},{"id":"semetey-1-2013:p1001:b005:l029","ordinal":152579,"en":"Spurring in breathless haste,"},{"id":"semetey-1-2013:p1001:b005:l030","ordinal":152580,"en":"They turned their horses' heads."},{"id":"semetey-1-2013:p1001:b005:l031","ordinal":152581,"en":"When they reached their elder,"},{"id":"semetey-1-2013:p1001:b005:l032","ordinal":152582,"en":"They took their spears in hand;"},{"id":"semetey-1-2013:p1001:b005:l033","ordinal":152583,"en":"The companions of fearsome bearing"},{"id":"semetey-1-2013:p1001:b005:l034","ordinal":152584,"en":"Stood bristling and alert."},{"id":"semetey-1-2013:p1001:b005:l035","ordinal":152585,"en":"When the young men arrived and stood there,"},{"id":"semetey-1-2013:p1001:b005:l036","ordinal":152586,"en":"The young lord Semetey,"},{"id":"semetey-1-2013:p1001:b005:l037","ordinal":152587,"en":"As though his fierce mother Kanykey"},{"id":"semetey-1-2013:p1001:b005:l038","ordinal":152588,"en":"Had given birth to a man indeed,"},{"id":"semetey-1-2013:p1001:b005:l039","ordinal":152589,"en":"Smiled and beamed broadly,"}]
