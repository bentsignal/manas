[{"id":"seytek-1991-continuation:p0339:b005:l017","ordinal":387585,"en":"Shouted and leveled their spears;"},{"id":"seytek-1991-continuation:p0339:b005:l018","ordinal":387586,"en":"They fought by turns."},{"id":"seytek-1991-continuation:p0339:b005:l019","ordinal":387587,"en":"They measured and matched each other,"},{"id":"seytek-1991-continuation:p0339:b005:l020","ordinal":387588,"en":"Fighting with spears."},{"id":"seytek-1991-continuation:p0339:b005:l021","ordinal":387589,"en":"They came at one another head-on"},{"id":"seytek-1991-continuation:p0339:b005:l022","ordinal":387590,"en":"And fought with iron maces."},{"id":"seytek-1991-continuation:p0339:b005:l023","ordinal":387591,"en":"The rim of the blue-steel helmet"},{"id":"seytek-1991-continuation:p0339:b005:l024","ordinal":387592,"en":"Was battered and crushed."},{"id":"seytek-1991-continuation:p0339:b005:l025","ordinal":387593,"en":"The broad-rumped bay stallion with mattock-like hooves,"},{"id":"seytek-1991-continuation:p0339:b005:l026","ordinal":387594,"en":"Who never tired on patrol,"},{"id":"seytek-1991-continuation:p0339:b005:l027","ordinal":387595,"en":"Toburchak of the open steppe,"},{"id":"seytek-1991-continuation:p0339:b005:l028","ordinal":387596,"en":"Had his back broken."},{"id":"seytek-1991-continuation:p0339:b005:l029","ordinal":387597,"en":"His wings were clipped—"},{"id":"seytek-1991-continuation:p0339:b005:l030","ordinal":387598,"en":"What could our elder Kogoy do?"},{"id":"seytek-1991-continuation:p0339:b005:l031","ordinal":387599,"en":"He was parted from Toburchak."},{"id":"seytek-1991-continuation:p0339:b005:l032","ordinal":387600,"en":"A bullet brought Toburchak down,"},{"id":"seytek-1991-continuation:p0339:b005:l033","ordinal":387601,"en":"And the foe tore Kogoy's coat."},{"id":"seytek-1991-continuation:p0340:b001:l001","ordinal":387602,"en":"Then Er Kogoy"},{"id":"seytek-1991-continuation:p0340:b001:l002","ordinal":387603,"en":"Bent at the waist from fighting on foot."},{"id":"seytek-1991-continuation:p0340:b001:l003","ordinal":387604,"en":"His frail life was pressed hard;"},{"id":"seytek-1991-continuation:p0340:b001:l004","ordinal":387605,"en":"His strength failed and calamity came."},{"id":"seytek-1991-continuation:p0340:b001:l005","ordinal":387606,"en":"It became a night that blinded the eyes,"},{"id":"seytek-1991-continuation:p0340:b001:l006","ordinal":387607,"en":"A day of disaster to behold."},{"id":"seytek-1991-continuation:p0340:b001:l007","ordinal":387608,"en":"Not letting his wound-up turban fall,"},{"id":"seytek-1991-continuation:p0340:b001:l008","ordinal":387609,"en":"Not letting Er Odu take him,"},{"id":"seytek-1991-continuation:p0340:b001:l009","ordinal":387610,"en":"He fought beyond all measure—"},{"id":"seytek-1991-continuation:p0340:b001:l010","ordinal":387611,"en":"Who had ever seen such a deed!"},{"id":"seytek-1991-continuation:p0340:b001:l011","ordinal":387612,"en":"Blood flowed from his dark eyes;"},{"id":"seytek-1991-continuation:p0340:b001:l012","ordinal":387613,"en":"Poor Kogoy was bewildered."},{"id":"seytek-1991-continuation:p0340:b001:l013","ordinal":387614,"en":"His two hands that had served him"},{"id":"seytek-1991-continuation:p0340:b001:l014","ordinal":387615,"en":"Could no longer rise and were paralyzed."},{"id":"seytek-1991-continuation:p0340:b001:l015","ordinal":387616,"en":"His precious head, the lock of life,"},{"id":"seytek-1991-continuation:p0340:b001:l016","ordinal":387617,"en":"Became a red bucket of blood."},{"id":"seytek-1991-continuation:p0340:b001:l017","ordinal":387618,"en":"He lost consciousness and bled,"},{"id":"seytek-1991-continuation:p0340:b001:l018","ordinal":387619,"en":"His strength gone, his body weak."},{"id":"seytek-1991-continuation:p0340:b001:l019","ordinal":387620,"en":"His dear eyes seemed about to close,"},{"id":"seytek-1991-continuation:p0340:b001:l020","ordinal":387621,"en":"Drooping and hanging dimly."},{"id":"seytek-1991-continuation:p0340:b001:l021","ordinal":387622,"en":"Accursed pale Death"},{"id":"seytek-1991-continuation:p0340:b001:l022","ordinal":387623,"en":"Was seen approaching his brow."},{"id":"seytek-1991-continuation:p0340:b001:l023","ordinal":387624,"en":"Odukan stood there thus."},{"id":"seytek-1991-continuation:p0340:b001:l024","ordinal":387625,"en":"A prince among his Kaldays,"},{"id":"seytek-1991-continuation:p0340:b001:l025","ordinal":387626,"en":"A cruel prince who had seen much,"},{"id":"seytek-1991-continuation:p0340:b001:l026","ordinal":387627,"en":"A slave-marksman who never missed,"},{"id":"seytek-1991-continuation:p0340:b001:l027","ordinal":387628,"en":"Proud of his marksmanship,"},{"id":"seytek-1991-continuation:p0340:b001:l028","ordinal":387629,"en":"Hid behind him."},{"id":"seytek-1991-continuation:p0340:b001:l029","ordinal":387630,"en":"“Aim between the forked shoulders;"},{"id":"seytek-1991-continuation:p0340:b001:l030","ordinal":387631,"en":"The face of the skull is the mark,"},{"id":"seytek-1991-continuation:p0340:b001:l031","ordinal":387632,"en":"The very center of the measure.”"},{"id":"seytek-1991-continuation:p0340:b001:l032","ordinal":387633,"en":"He set a bullet as large as a sheep's head"},{"id":"seytek-1991-continuation:p0340:b001:l033","ordinal":387634,"en":"Firmly against the sight,"},{"id":"seytek-1991-continuation:p0340:b001:l034","ordinal":387635,"en":"Bound it to certain death,"},{"id":"seytek-1991-continuation:p0340:b001:l035","ordinal":387636,"en":"And struck, splitting his head."},{"id":"seytek-1991-continuation:p0340:b001:l036","ordinal":387637,"en":"His soul left before the smoke cleared;"},{"id":"seytek-1991-continuation:p0340:b001:l037","ordinal":387638,"en":"The fatal bullet struck his temple."},{"id":"seytek-1991-continuation:p0340:b001:l038","ordinal":387639,"en":"Our poor elder Kogoy"},{"id":"seytek-1991-continuation:p0340:b001:l039","ordinal":387640,"en":"Had departed for Mecca."},{"id":"seytek-1991-continuation:p0340:b001:l040","ordinal":387641,"en":"Seeing this, Ebegey cried:"},{"id":"seytek-1991-continuation:p0340:b001:l041","ordinal":387642,"en":"“Rather than lose my comrade"},{"id":"seytek-1991-continuation:p0340:b001:l042","ordinal":387643,"en":"And let the Kyrgyz be cast into fire,"},{"id":"seytek-1991-continuation:p0340:b001:l043","ordinal":387644,"en":"Rather than lose one of my horns"},{"id":"seytek-1991-continuation:p0340:b001:l044","ordinal":387645,"en":"And remain a hornless beast,"},{"id":"seytek-1991-continuation:p0340:b001:l045","ordinal":387646,"en":"Rather than lose mane and tail"},{"id":"seytek-1991-continuation:p0340:b001:l046","ordinal":387647,"en":"And remain a stunted thing,"},{"id":"seytek-1991-continuation:p0340:b001:l047","ordinal":387648,"en":"May I sink unborn into the deep;"},{"id":"seytek-1991-continuation:p0340:b001:l048","ordinal":387649,"en":"May I die and not remain alive!"},{"id":"seytek-1991-continuation:p0340:b001:l049","ordinal":387650,"en":"My figure before me,"},{"id":"seytek-1991-continuation:p0340:b003:l001","ordinal":387651,"en":"My watchful Kogoy,"},{"id":"seytek-1991-continuation:p0340:b003:l002","ordinal":387652,"en":"My bannered mountain ridge"},{"id":"seytek-1991-continuation:p0340:b003:l003","ordinal":387653,"en":"No enemy caravan could cross,"},{"id":"seytek-1991-continuation:p0340:b003:l004","ordinal":387654,"en":"My greatest lion in time of need—"},{"id":"seytek-1991-continuation:p0340:b003:l005","ordinal":387655,"en":"Let me die for my twin!"},{"id":"seytek-1991-continuation:p0340:b003:l006","ordinal":387656,"en":"My truly created golden soul,"},{"id":"seytek-1991-continuation:p0340:b003:l007","ordinal":387657,"en":"If the Creator truly wills it,"},{"id":"seytek-1991-continuation:p0340:b003:l008","ordinal":387658,"en":"I will give up this fly-like life.”"},{"id":"seytek-1991-continuation:p0340:b003:l009","ordinal":387659,"en":"Thus Ebegey spoke,"},{"id":"seytek-1991-continuation:p0340:b003:l010","ordinal":387660,"en":"Whipping the gray racer Aksutkul"},{"id":"seytek-1991-continuation:p0340:b003:l011","ordinal":387661,"en":"From side to side,"},{"id":"seytek-1991-continuation:p0340:b003:l012","ordinal":387662,"en":"Driving him right and left."},{"id":"seytek-1991-continuation:p0340:b003:l013","ordinal":387663,"en":"He struck the stallion's flank"},{"id":"seytek-1991-continuation:p0340:b003:l014","ordinal":387664,"en":"And shouted, “Comrade!”"},{"id":"seytek-1991-continuation:p0340:b003:l015","ordinal":387665,"en":"As he attacked Er Odu."},{"id":"seytek-1991-continuation:p0340:b003:l016","ordinal":387666,"en":"They stood face-to-face,"},{"id":"seytek-1991-continuation:p0340:b003:l017","ordinal":387667,"en":"Loosened the mouths of their steeds,"},{"id":"seytek-1991-continuation:p0340:b003:l018","ordinal":387668,"en":"And without frowning or knitting a brow,"},{"id":"seytek-1991-continuation:p0340:b003:l019","ordinal":387669,"en":"At once thrust their spears."},{"id":"seytek-1991-continuation:p0340:b003:l020","ordinal":387670,"en":"Their spears shattered against each other;"},{"id":"seytek-1991-continuation:p0340:b003:l021","ordinal":387671,"en":"They wearied through many days."},{"id":"seytek-1991-continuation:p0340:b003:l022","ordinal":387672,"en":"All the blood was swallowed up;"},{"id":"seytek-1991-continuation:p0340:b003:l023","ordinal":387673,"en":"Their impenetrable armor, impossible to seize,"},{"id":"seytek-1991-continuation:p0340:b003:l024","ordinal":387674,"en":"Was torn into shreds."},{"id":"seytek-1991-continuation:p0340:b003:l025","ordinal":387675,"en":"They waged a fierce battle."},{"id":"seytek-1991-continuation:p0340:b003:l026","ordinal":387676,"en":"The two giants struck each other"},{"id":"seytek-1991-continuation:p0340:b003:l027","ordinal":387677,"en":"With iron-headed maces."},{"id":"seytek-1991-continuation:p0340:b003:l028","ordinal":387678,"en":"They covered the hilltop in blood"},{"id":"seytek-1991-continuation:p0340:b003:l029","ordinal":387679,"en":"And every eyelash in dust."},{"id":"seytek-1991-continuation:p0340:b003:l030","ordinal":387680,"en":"Unable to overcome each other,"},{"id":"seytek-1991-continuation:p0340:b003:l031","ordinal":387681,"en":"Their strength only increased."},{"id":"seytek-1991-continuation:p0340:b003:l032","ordinal":387682,"en":"They seized each other's collars,"},{"id":"seytek-1991-continuation:p0340:b003:l033","ordinal":387683,"en":"Wrestled and grappled,"},{"id":"seytek-1991-continuation:p0340:b003:l034","ordinal":387684,"en":"And made an astounding spectacle."},{"id":"seytek-1991-continuation:p0340:b003:l035","ordinal":387685,"en":"Choyun Alp, worth ten Odukans,"},{"id":"seytek-1991-continuation:p0340:b003:l036","ordinal":387686,"en":"A devastating giant,"},{"id":"seytek-1991-continuation:p0340:b003:l037","ordinal":387687,"en":"A champion of the royal treasury,"},{"id":"seytek-1991-continuation:p0340:b003:l038","ordinal":387688,"en":"With muscles like a bull's back,"},{"id":"seytek-1991-continuation:p0340:b003:l039","ordinal":387689,"en":"Able to devour those who resisted,"},{"id":"seytek-1991-continuation:p0340:b003:l040","ordinal":387690,"en":"Arrived and joined the attack."},{"id":"seytek-1991-continuation:p0340:b003:l041","ordinal":387691,"en":"He swung his axe wildly"},{"id":"seytek-1991-continuation:p0340:b003:l042","ordinal":387692,"en":"At your ancestor, father of the people,"},{"id":"seytek-1991-continuation:p0340:b003:l043","ordinal":387693,"en":"And clubbed him right and left."},{"id":"seytek-1991-continuation:p0340:b003:l044","ordinal":387694,"en":"When your heroic elder could find no escape"},{"id":"seytek-1991-continuation:p0340:b003:l045","ordinal":387695,"en":"And was caught between the two,"},{"id":"seytek-1991-continuation:p0340:b003:l046","ordinal":387696,"en":"The swift hero Jeljetpes"},{"id":"seytek-1991-continuation:p0340:b003:l047","ordinal":387697,"en":"And the accomplished champion Er Kenen"},{"id":"seytek-1991-continuation:p0340:b003:l048","ordinal":387698,"en":"Charged together."},{"id":"seytek-1991-continuation:p0340:b003:l049","ordinal":387699,"en":"Having lost Er Kogoy,"},{"id":"seytek-1991-continuation:p0341:b001:l001","ordinal":387700,"en":"If we let Ebegey fall to a bullet,"},{"id":"seytek-1991-continuation:p0341:b001:l002","ordinal":387701,"en":"We may as well camp along the Kok-Ozon"},{"id":"seytek-1991-continuation:p0341:b001:l003","ordinal":387702,"en":"And become like a fire gone out."},{"id":"seytek-1991-continuation:p0341:b001:l004","ordinal":387703,"en":"While the Chinese challenge us alone,"},{"id":"seytek-1991-continuation:p0341:b001:l005","ordinal":387704,"en":"While the enemy pours out his rage,"},{"id":"seytek-1991-continuation:p0341:b001:l006","ordinal":387705,"en":"While black calamity burns like fire"},{"id":"seytek-1991-continuation:p0341:b001:l007","ordinal":387706,"en":"And overwhelms the poor hero,"},{"id":"seytek-1991-continuation:p0341:b001:l008","ordinal":387707,"en":"If we conceal our comradeship,"},{"id":"seytek-1991-continuation:p0341:b001:l009","ordinal":387708,"en":"Strike not a single blow,"},{"id":"seytek-1991-continuation:p0341:b001:l010","ordinal":387709,"en":"Turn our faces away and close our eyes,"},{"id":"seytek-1991-continuation:p0341:b001:l011","ordinal":387710,"en":"Will our fortunate elder"},{"id":"seytek-1991-continuation:p0341:b001:l012","ordinal":387711,"en":"Not think us powerless?"},{"id":"seytek-1991-continuation:p0341:b001:l013","ordinal":387712,"en":"Will they not say those two have no support"},{"id":"seytek-1991-continuation:p0341:b001:l014","ordinal":387713,"en":"And mount them like black donkeys?"},{"id":"seytek-1991-continuation:p0341:b001:l015","ordinal":387714,"en":"If true death has come, let us die;"},{"id":"seytek-1991-continuation:p0341:b001:l016","ordinal":387715,"en":"Let us become a support"},{"id":"seytek-1991-continuation:p0341:b001:l017","ordinal":387716,"en":"For the humiliated gray-maned leopard,"},{"id":"seytek-1991-continuation:p0341:b001:l018","ordinal":387717,"en":"For elder Er Ebegey,"},{"id":"seytek-1991-continuation:p0341:b001:l019","ordinal":387718,"en":"For a forebear dearer than a father!"},{"id":"seytek-1991-continuation:p0341:b001:l020","ordinal":387719,"en":"Er Kenen gathered his courage,"},{"id":"seytek-1991-continuation:p0341:b001:l021","ordinal":387720,"en":"As did the accomplished Jeljetpes."},{"id":"seytek-1991-continuation:p0341:b001:l022","ordinal":387721,"en":"The two giants would not stand idle."},{"id":"seytek-1991-continuation:p0341:b001:l023","ordinal":387722,"en":"To begin an unequal battle,"},{"id":"seytek-1991-continuation:p0341:b001:l024","ordinal":387723,"en":"To free the captive Ebegey"},{"id":"seytek-1991-continuation:p0341:b001:l025","ordinal":387724,"en":"From the iron lariat net,"},{"id":"seytek-1991-continuation:p0341:b001:l026","ordinal":387725,"en":"From the black demon's bullets,"},{"id":"seytek-1991-continuation:p0341:b001:l027","ordinal":387726,"en":"From the infidel's deep pit,"},{"id":"seytek-1991-continuation:p0341:b001:l028","ordinal":387727,"en":"From the embers of burning hell,"},{"id":"seytek-1991-continuation:p0341:b001:l029","ordinal":387728,"en":"From the hands of the two giants,"},{"id":"seytek-1991-continuation:p0341:b001:l030","ordinal":387729,"en":"To rescue him,"},{"id":"seytek-1991-continuation:p0341:b001:l031","ordinal":387730,"en":"They broke through the formation and opened a road."},{"id":"seytek-1991-continuation:p0341:b001:l032","ordinal":387731,"en":"The two splendid falcons"},{"id":"seytek-1991-continuation:p0341:b001:l033","ordinal":387732,"en":"Came and attacked the pair."},{"id":"seytek-1991-continuation:p0341:b001:l034","ordinal":387733,"en":"Choyun Alp stood at the front."},{"id":"seytek-1991-continuation:p0341:b001:l035","ordinal":387734,"en":"Before that giant hero"},{"id":"seytek-1991-continuation:p0341:b001:l036","ordinal":387735,"en":"Could say a word or turn aside,"},{"id":"seytek-1991-continuation:p0341:b001:l037","ordinal":387736,"en":"In the blink of an eye,"},{"id":"seytek-1991-continuation:p0341:b001:l038","ordinal":387737,"en":"Jeljetpes proved his strength."},{"id":"seytek-1991-continuation:p0341:b001:l039","ordinal":387738,"en":"Broad at the base and sharp at the point,"},{"id":"seytek-1991-continuation:p0341:b001:l040","ordinal":387739,"en":"His spear bloodied any foe he thrust at."},{"id":"seytek-1991-continuation:p0341:b001:l041","ordinal":387740,"en":"Its iron was smelted and worked,"},{"id":"seytek-1991-continuation:p0341:b001:l042","ordinal":387741,"en":"Its edge was sharpened,"},{"id":"seytek-1991-continuation:p0341:b001:l043","ordinal":387742,"en":"Filed again and again with a file,"},{"id":"seytek-1991-continuation:p0341:b001:l044","ordinal":387743,"en":"Hammered again and again with a hammer,"},{"id":"seytek-1991-continuation:p0341:b001:l045","ordinal":387744,"en":"Hammered without rest for eighty days,"},{"id":"seytek-1991-continuation:p0341:b001:l046","ordinal":387745,"en":"Tempered, crushed, and beaten;"},{"id":"seytek-1991-continuation:p0341:b001:l047","ordinal":387746,"en":"Its charcoal leapt like sheep,"},{"id":"seytek-1991-continuation:p0341:b001:l048","ordinal":387747,"en":"And it shattered every bellows."},{"id":"seytek-1991-continuation:p0341:b001:l049","ordinal":387748,"en":"His servant Dynshokor"},{"id":"seytek-1991-continuation:p0341:b003:l001","ordinal":387749,"en":"Made the master smith weep."},{"id":"seytek-1991-continuation:p0341:b003:l002","ordinal":387750,"en":"Its solid workmanship was unsurpassed."},{"id":"seytek-1991-continuation:p0341:b003:l003","ordinal":387751,"en":"Yengkor, who came from Beijing"},{"id":"seytek-1991-continuation:p0341:b003:l004","ordinal":387752,"en":"And had befriended the prophet David,"},{"id":"seytek-1991-continuation:p0341:b003:l005","ordinal":387753,"en":"Was the smith who made"},{"id":"seytek-1991-continuation:p0341:b003:l006","ordinal":387754,"en":"Jeljetpes's spear."},{"id":"seytek-1991-continuation:p0341:b003:l007","ordinal":387755,"en":"When its point touched a man,"},{"id":"seytek-1991-continuation:p0341:b003:l008","ordinal":387756,"en":"He paled and wilted like grass;"},{"id":"seytek-1991-continuation:p0341:b003:l009","ordinal":387757,"en":"When its point struck true,"},{"id":"seytek-1991-continuation:p0341:b003:l010","ordinal":387758,"en":"His life left before he could draw breath."},{"id":"seytek-1991-continuation:p0341:b003:l011","ordinal":387759,"en":"It had been tempered in poison,"},{"id":"seytek-1991-continuation:p0341:b003:l012","ordinal":387760,"en":"Heated twelve times red-hot"},{"id":"seytek-1991-continuation:p0341:b003:l013","ordinal":387761,"en":"In the poison of an albasty demon."},{"id":"seytek-1991-continuation:p0341:b003:l014","ordinal":387762,"en":"Such was his spear and equipment;"},{"id":"seytek-1991-continuation:p0341:b003:l015","ordinal":387763,"en":"Such was the stratagem"},{"id":"seytek-1991-continuation:p0341:b003:l016","ordinal":387764,"en":"Of your elder Er Jeljetpes."},{"id":"seytek-1991-continuation:p0341:b003:l017","ordinal":387765,"en":"When the fully armed infidel,"},{"id":"seytek-1991-continuation:p0341:b003:l018","ordinal":387766,"en":"The giant hero Choyun Alp,"},{"id":"seytek-1991-continuation:p0341:b003:l019","ordinal":387767,"en":"Joined Odukan"},{"id":"seytek-1991-continuation:p0341:b003:l020","ordinal":387768,"en":"To wage immeasurable battle,"},{"id":"seytek-1991-continuation:p0341:b003:l021","ordinal":387769,"en":"When those two matching madmen"},{"id":"seytek-1991-continuation:p0341:b003:l022","ordinal":387770,"en":"Were about to spill Ebegey's blood,"},{"id":"seytek-1991-continuation:p0341:b003:l023","ordinal":387771,"en":"Plunge him into deepest misery,"},{"id":"seytek-1991-continuation:p0341:b003:l024","ordinal":387772,"en":"And inflict on Ebegey"},{"id":"seytek-1991-continuation:p0341:b003:l025","ordinal":387773,"en":"A torment no man could bear,"},{"id":"seytek-1991-continuation:p0341:b003:l026","ordinal":387774,"en":"Your elder Er Jeljetpes"},{"id":"seytek-1991-continuation:p0341:b003:l027","ordinal":387775,"en":"Came upon him from behind."},{"id":"seytek-1991-continuation:p0341:b003:l028","ordinal":387776,"en":"At the lower edge of his hair,"},{"id":"seytek-1991-continuation:p0341:b003:l029","ordinal":387777,"en":"At the bare rim of his temple,"},{"id":"seytek-1991-continuation:p0341:b003:l030","ordinal":387778,"en":"He thrust his spear straight through."},{"id":"seytek-1991-continuation:p0341:b003:l031","ordinal":387779,"en":"From Choyun Alp's head"},{"id":"seytek-1991-continuation:p0341:b003:l032","ordinal":387780,"en":"Blood flowed like an irrigation ditch;"},{"id":"seytek-1991-continuation:p0341:b003:l033","ordinal":387781,"en":"The spear passed through his brain,"},{"id":"seytek-1991-continuation:p0341:b003:l034","ordinal":387782,"en":"And his life went out mingled with blood."},{"id":"seytek-1991-continuation:p0341:b003:l035","ordinal":387783,"en":"He whipped the bay stallion,"},{"id":"seytek-1991-continuation:p0341:b003:l036","ordinal":387784,"en":"Shouting in anger."},{"id":"seytek-1991-continuation:p0341:b003:l037","ordinal":387785,"en":"The mighty, fortunate hero,"},{"id":"seytek-1991-continuation:p0341:b003:l038","ordinal":387786,"en":"Who was like a host when he rode in front,"},{"id":"seytek-1991-continuation:p0341:b003:l039","ordinal":387787,"en":"Cried to his elder Er Ebegey,"},{"id":"seytek-1991-continuation:p0341:b003:l040","ordinal":387788,"en":"“Gather your senses!”"},{"id":"seytek-1991-continuation:p0341:b003:l041","ordinal":387789,"en":"His gray-wolf courage revealed,"},{"id":"seytek-1991-continuation:p0341:b003:l042","ordinal":387790,"en":"He thrust beneath the steel shield"},{"id":"seytek-1991-continuation:p0341:b003:l043","ordinal":387791,"en":"On the head of the fully armed infidel,"},{"id":"seytek-1991-continuation:p0341:b003:l044","ordinal":387792,"en":"The hero Khan Odukan."},{"id":"seytek-1991-continuation:p0341:b003:l045","ordinal":387793,"en":"He thrust and sent the shield flying."},{"id":"seytek-1991-continuation:p0341:b003:l046","ordinal":387794,"en":"The peerless champion Jeljetpes"},{"id":"seytek-1991-continuation:p0341:b003:l047","ordinal":387795,"en":"Had his axe bound in leather,"},{"id":"seytek-1991-continuation:p0341:b003:l048","ordinal":387796,"en":"Its handle fitted with twisted gold;"},{"id":"seytek-1991-continuation:p0341:b003:l049","ordinal":387797,"en":"When laid on grass, it started a fire,"},{"id":"seytek-1991-continuation:p0342:b001:l001","ordinal":387798,"en":"When swung, its head blazed like an ember."},{"id":"seytek-1991-continuation:p0342:b001:l002","ordinal":387799,"en":"When he swung it in fury,"},{"id":"seytek-1991-continuation:p0342:b001:l003","ordinal":387800,"en":"It never rested without drinking blood."},{"id":"seytek-1991-continuation:p0342:b001:l004","ordinal":387801,"en":"Its edge glowed red with fire;"},{"id":"seytek-1991-continuation:p0342:b001:l005","ordinal":387802,"en":"Though its handle was rather short,"},{"id":"seytek-1991-continuation:p0342:b001:l006","ordinal":387803,"en":"When he swung it in fury"},{"id":"seytek-1991-continuation:p0342:b001:l007","ordinal":387804,"en":"It lengthened to a full fathom."},{"id":"seytek-1991-continuation:p0342:b001:l008","ordinal":387805,"en":"Those who saw its wrath panicked;"},{"id":"seytek-1991-continuation:p0342:b001:l009","ordinal":387806,"en":"Those who heard its name grieved."},{"id":"seytek-1991-continuation:p0342:b001:l010","ordinal":387807,"en":"Any stubborn enemy who faced it"},{"id":"seytek-1991-continuation:p0342:b001:l011","ordinal":387808,"en":"Despaired of his dark life."},{"id":"seytek-1991-continuation:p0342:b001:l012","ordinal":387809,"en":"He seized the blood-spilling axe,"},{"id":"seytek-1991-continuation:p0342:b001:l013","ordinal":387810,"en":"Whirled it around,"},{"id":"seytek-1991-continuation:p0342:b001:l014","ordinal":387811,"en":"And strained forward with both hands."},{"id":"seytek-1991-continuation:p0342:b001:l015","ordinal":387812,"en":"At Odukan, huge as a mountain,"},{"id":"seytek-1991-continuation:p0342:b001:l016","ordinal":387813,"en":"The infidel of matchless strength,"},{"id":"seytek-1991-continuation:p0342:b001:l017","ordinal":387814,"en":"The hero never sated with blood,"},{"id":"seytek-1991-continuation:p0342:b001:l018","ordinal":387815,"en":"Calling him the accursed one,"},{"id":"seytek-1991-continuation:p0342:b001:l019","ordinal":387816,"en":"Taking the dark pupil as his measure,"},{"id":"seytek-1991-continuation:p0342:b001:l020","ordinal":387817,"en":"And the crown of the head as his mark,"},{"id":"seytek-1991-continuation:p0342:b001:l021","ordinal":387818,"en":"He aimed carefully and struck,"},{"id":"seytek-1991-continuation:p0342:b001:l022","ordinal":387819,"en":"Swinging with perfect accuracy."},{"id":"seytek-1991-continuation:p0342:b001:l023","ordinal":387820,"en":"When it struck, Odu was no more;"},{"id":"seytek-1991-continuation:p0342:b001:l024","ordinal":387821,"en":"The poison-tempered battle-axe"},{"id":"seytek-1991-continuation:p0342:b001:l025","ordinal":387822,"en":"Sank in to its socket."},{"id":"seytek-1991-continuation:p0342:b001:l026","ordinal":387823,"en":"When the axe struck Odu,"},{"id":"seytek-1991-continuation:p0342:b001:l027","ordinal":387824,"en":"His cry was heard in the sky,"},{"id":"seytek-1991-continuation:p0342:b001:l028","ordinal":387825,"en":"And he fell embracing the earth."},{"id":"seytek-1991-continuation:p0342:b001:l029","ordinal":387826,"en":"His head plunged into a hollow;"},{"id":"seytek-1991-continuation:p0342:b001:l030","ordinal":387827,"en":"Dust and soil"},{"id":"seytek-1991-continuation:p0342:b001:l031","ordinal":387828,"en":"Choked his mouth and nose,"},{"id":"seytek-1991-continuation:p0342:b001:l032","ordinal":387829,"en":"And no fly-like breath remained."},{"id":"seytek-1991-continuation:p0342:b001:l033","ordinal":387830,"en":"When Odukan and Choyun had died,"},{"id":"seytek-1991-continuation:p0342:b001:l034","ordinal":387831,"en":"Their warriors of every kind,"},{"id":"seytek-1991-continuation:p0342:b001:l035","ordinal":387832,"en":"Their foremost rabble,"},{"id":"seytek-1991-continuation:p0342:b001:l036","ordinal":387833,"en":"Strong mounted and on foot,"},{"id":"seytek-1991-continuation:p0342:b001:l037","ordinal":387834,"en":"Their racers unsurpassed in the world,"},{"id":"seytek-1991-continuation:p0342:b001:l038","ordinal":387835,"en":"Commanders over tens,"},{"id":"seytek-1991-continuation:p0342:b001:l039","ordinal":387836,"en":"Champions over thousands,"},{"id":"seytek-1991-continuation:p0342:b001:l040","ordinal":387837,"en":"Their Kaldays and stone-hearted men,"},{"id":"seytek-1991-continuation:p0342:b001:l041","ordinal":387838,"en":"All rushed in with an uproar,"},{"id":"seytek-1991-continuation:p0342:b001:l042","ordinal":387839,"en":"Their spears held firmly forward."},{"id":"seytek-1991-continuation:p0342:b001:l043","ordinal":387840,"en":"The earth split into dust;"}]
