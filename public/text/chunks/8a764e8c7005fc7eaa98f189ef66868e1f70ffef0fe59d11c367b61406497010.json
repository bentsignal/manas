[{"id":"seytek-2012:p0166:b003:l031","ordinal":306689,"en":"They witnessed the heroism"},{"id":"seytek-2012:p0166:b003:l032","ordinal":306690,"en":"Of the poor man favored by the spirits;"},{"id":"seytek-2012:p0166:b003:l033","ordinal":306691,"en":"The gathered people watched and proclaimed it,"},{"id":"seytek-2012:p0166:b003:l034","ordinal":306692,"en":"Marveling at my champion."},{"id":"seytek-2012:p0166:b003:l035","ordinal":306693,"en":"The people cried out in an uproar,"},{"id":"seytek-2012:p0166:b003:l036","ordinal":306694,"en":"Their clamor splitting the sky;"},{"id":"seytek-2012:p0166:b003:l037","ordinal":306695,"en":"The great multitude acclaimed him,"},{"id":"seytek-2012:p0166:b003:l038","ordinal":306696,"en":"And all the people marveled"},{"id":"seytek-2012:p0166:b003:l039","ordinal":306697,"en":"At the renowned gray-wolf champion."},{"id":"seytek-2012:p0166:b003:l040","ordinal":306698,"en":"All his remaining strength was ready"},{"id":"seytek-2012:p0167:b002:l001","ordinal":306699,"en":"To unleash slaughter without looking back."},{"id":"seytek-2012:p0167:b002:l002","ordinal":306700,"en":"If his old vigor returned to his limbs,"},{"id":"seytek-2012:p0167:b002:l003","ordinal":306701,"en":"He would avenge the gray wolf’s death."},{"id":"seytek-2012:p0167:b002:l004","ordinal":306702,"en":"They told Choro, “Shoot through"},{"id":"seytek-2012:p0167:b002:l005","ordinal":306703,"en":"The ninety mattocks in a row,”"},{"id":"seytek-2012:p0167:b002:l006","ordinal":306704,"en":"And thus put his courage to the test."},{"id":"seytek-2012:p0167:b002:l007","ordinal":306705,"en":"To shoot through those mattocks,"},{"id":"seytek-2012:p0167:b002:l008","ordinal":306706,"en":"Külchoro, favored by the spirits,"},{"id":"seytek-2012:p0167:b002:l009","ordinal":306707,"en":"Would measure what strength he had."},{"id":"seytek-2012:p0167:b002:l010","ordinal":306708,"en":"If powerless, he would die of shame"},{"id":"seytek-2012:p0167:b002:l011","ordinal":306709,"en":"Before death itself could come;"},{"id":"seytek-2012:p0167:b002:l012","ordinal":306710,"en":"If he had the strength, he meant"},{"id":"seytek-2012:p0167:b002:l013","ordinal":306711,"en":"To unleash some great calamity;"},{"id":"seytek-2012:p0167:b002:l014","ordinal":306712,"en":"If this poor man had no strength,"},{"id":"seytek-2012:p0167:b002:l015","ordinal":306713,"en":"He would surrender his fly-like soul."},{"id":"seytek-2012:p0167:b002:l016","ordinal":306714,"en":"He took the steel bow in his hand,"},{"id":"seytek-2012:p0167:b002:l017","ordinal":306715,"en":"His heart aflame and his eyes blazing,"},{"id":"seytek-2012:p0167:b002:l018","ordinal":306716,"en":"Biting his lip and grinding his teeth;"},{"id":"seytek-2012:p0167:b002:l019","ordinal":306717,"en":"The poor defender of the people"},{"id":"seytek-2012:p0167:b002:l020","ordinal":306718,"en":"Stood with both eyes blazing."},{"id":"seytek-2012:p0167:b002:l021","ordinal":306719,"en":"He readied himself like a hawk,"},{"id":"seytek-2012:p0167:b002:l022","ordinal":306720,"en":"And found wisdom in his courage;"},{"id":"seytek-2012:p0167:b002:l023","ordinal":306721,"en":"The troubled poor hero"},{"id":"seytek-2012:p0167:b002:l024","ordinal":306722,"en":"Found keen strength within his body"},{"id":"seytek-2012:p0167:b002:l025","ordinal":306723,"en":"And strung the mighty bow."},{"id":"seytek-2012:p0167:b002:l026","ordinal":306724,"en":"He gathered his strength in his mind,"},{"id":"seytek-2012:p0167:b002:l027","ordinal":306725,"en":"Mustered his courage throughout his body,"},{"id":"seytek-2012:p0167:b002:l028","ordinal":306726,"en":"Prepared to draw the bow,"},{"id":"seytek-2012:p0167:b002:l029","ordinal":306727,"en":"And prayed to the Creator."},{"id":"seytek-2012:p0167:b002:l030","ordinal":306728,"en":"Every watcher’s attention was seized;"},{"id":"seytek-2012:p0167:b002:l031","ordinal":306729,"en":"His lion-like aspect appeared."},{"id":"seytek-2012:p0167:b002:l032","ordinal":306730,"en":"His form was like a massive boulder,"},{"id":"seytek-2012:p0167:b002:l033","ordinal":306731,"en":"And your rugged eagle seemed"},{"id":"seytek-2012:p0167:b002:l034","ordinal":306732,"en":"Ready to devour anyone who crossed him."},{"id":"seytek-2012:p0167:b002:l035","ordinal":306733,"en":"If the gray-wolf servant surveyed the world,"},{"id":"seytek-2012:p0167:b002:l036","ordinal":306734,"en":"He seemed capable of conquering it;"},{"id":"seytek-2012:p0167:b002:l037","ordinal":306735,"en":"For ages beyond the Jediger,"},{"id":"seytek-2012:p0167:b002:l038","ordinal":306736,"en":"His cry seemed fit to unleash slaughter."},{"id":"seytek-2012:p0167:b002:l039","ordinal":306737,"en":"Whoever came within his reach"},{"id":"seytek-2012:p0167:b002:l040","ordinal":306738,"en":"He seemed able to cleave and cast down."},{"id":"seytek-2012:p0167:b003:l001","ordinal":306739,"en":"Such was his wrestling might."},{"id":"seytek-2012:p0167:b003:l002","ordinal":306740,"en":"Wide-mouthed and cliff-browed—"},{"id":"seytek-2012:p0167:b003:l003","ordinal":306741,"en":"Behold and ponder his gray-wolf courage."},{"id":"seytek-2012:p0167:b003:l004","ordinal":306742,"en":"He broke through passes and opened roads,"},{"id":"seytek-2012:p0167:b003:l005","ordinal":306743,"en":"And, heedless of his own destruction,"},{"id":"seytek-2012:p0167:b003:l006","ordinal":306744,"en":"Attacked an army six hundred thousand strong."},{"id":"seytek-2012:p0167:b003:l007","ordinal":306745,"en":"The hero Choro, pillar of the people,"},{"id":"seytek-2012:p0167:b003:l008","ordinal":306746,"en":"Was fed carved horse-rib meat and fat,"},{"id":"seytek-2012:p0167:b003:l009","ordinal":306747,"en":"And given plentiful food."},{"id":"seytek-2012:p0167:b003:l010","ordinal":306748,"en":"The orphan-raised hero Seytek"},{"id":"seytek-2012:p0167:b003:l011","ordinal":306749,"en":"Had special delicacies prepared:"},{"id":"seytek-2012:p0167:b003:l012","ordinal":306750,"en":"Fat lambs and choice heads,"},{"id":"seytek-2012:p0167:b003:l013","ordinal":306751,"en":"And thick white broth boiled;"},{"id":"seytek-2012:p0167:b003:l014","ordinal":306752,"en":"He had him crunch sugar white as snow"},{"id":"seytek-2012:p0167:b003:l015","ordinal":306753,"en":"And gulp liquor from a bowl."},{"id":"seytek-2012:p0167:b003:l016","ordinal":306754,"en":"“I have tended my uncle well,” he said,"},{"id":"seytek-2012:p0167:b003:l017","ordinal":306755,"en":"“For I know he is a lion."},{"id":"seytek-2012:p0167:b003:l018","ordinal":306756,"en":"If my uncle remains alive,"},{"id":"seytek-2012:p0167:b003:l019","ordinal":306757,"en":"He will yet prove useful.”"},{"id":"seytek-2012:p0167:b003:l020","ordinal":306758,"en":"So the people had said"},{"id":"seytek-2012:p0167:b003:l021","ordinal":306759,"en":"Of my dear gray-wolf uncle:"},{"id":"seytek-2012:p0167:b003:l022","ordinal":306760,"en":"“There is none like him in the world,”"},{"id":"seytek-2012:p0167:b003:l023","ordinal":306761,"en":"As those who had seen him from afar knew,"},{"id":"seytek-2012:p0167:b003:l024","ordinal":306762,"en":"Amid sky-splitting turmoil"},{"id":"seytek-2012:p0167:b003:l025","ordinal":306763,"en":"And in single combat."},{"id":"seytek-2012:p0167:b003:l026","ordinal":306764,"en":"If he truly was a pillar,"},{"id":"seytek-2012:p0167:b003:l027","ordinal":306765,"en":"The chieftain’s surviving legacy,"},{"id":"seytek-2012:p0167:b003:l028","ordinal":306766,"en":"If he truly was a lion,"},{"id":"seytek-2012:p0167:b003:l029","ordinal":306767,"en":"His courage must now have sharpened and filled him;"},{"id":"seytek-2012:p0167:b003:l030","ordinal":306768,"en":"The time must have come for him"},{"id":"seytek-2012:p0167:b003:l031","ordinal":306769,"en":"To clash with Kyyaz, son of Bagysh."},{"id":"seytek-2012:p0167:b003:l032","ordinal":306770,"en":"To put his strength to the test—"},{"id":"seytek-2012:p0167:b003:l033","ordinal":306771,"en":"If his vigor had matured against the Jediger"},{"id":"seytek-2012:p0167:b003:l034","ordinal":306772,"en":"Who filled the Seven Valleys—"},{"id":"seytek-2012:p0167:b003:l035","ordinal":306773,"en":"To take revenge upon Kyyaz,"},{"id":"seytek-2012:p0167:b003:l036","ordinal":306774,"en":"To make a glorious slaughter,"},{"id":"seytek-2012:p0167:b003:l037","ordinal":306775,"en":"Pour blood into the dark waters,"},{"id":"seytek-2012:p0167:b003:l038","ordinal":306776,"en":"Set the riverlands ablaze,"},{"id":"seytek-2012:p0167:b003:l039","ordinal":306777,"en":"Begin carnage on the open plain,"},{"id":"seytek-2012:p0167:b003:l040","ordinal":306778,"en":"And raise a feud to destroy the foe,"},{"id":"seytek-2012:p0168:b002:l001","ordinal":306779,"en":"One hair of his mustache resembled"},{"id":"seytek-2012:p0168:b002:l002","ordinal":306780,"en":"The handle of a greasy axe;"},{"id":"seytek-2012:p0168:b002:l003","ordinal":306781,"en":"His great nose resembled a saber’s sheath."},{"id":"seytek-2012:p0168:b002:l004","ordinal":306782,"en":"The ill-fated Choro"},{"id":"seytek-2012:p0168:b002:l005","ordinal":306783,"en":"Readied himself like a tiger,"},{"id":"seytek-2012:p0168:b002:l006","ordinal":306784,"en":"And none who challenged him would survive."},{"id":"seytek-2012:p0168:b002:l007","ordinal":306785,"en":"He grasped his bow and prepared,"},{"id":"seytek-2012:p0168:b002:l008","ordinal":306786,"en":"Appealing to the spirits"},{"id":"seytek-2012:p0168:b002:l009","ordinal":306787,"en":"Of the gray wolves Almambet and Manas,"},{"id":"seytek-2012:p0168:b002:l010","ordinal":306788,"en":"And drew the bow without tiring."},{"id":"seytek-2012:p0168:b002:l011","ordinal":306789,"en":"The vigor of the crackling warrior,"},{"id":"seytek-2012:p0168:b002:l012","ordinal":306790,"en":"His swiftness, was beyond measure;"},{"id":"seytek-2012:p0168:b002:l013","ordinal":306791,"en":"Choro shot at the mattocks…"},{"id":"seytek-2012:p0168:b002:l014","ordinal":306792,"en":"Through all ninety mattocks in a row"},{"id":"seytek-2012:p0168:b002:l015","ordinal":306793,"en":"The arrow passed without stopping;"},{"id":"seytek-2012:p0168:b002:l016","ordinal":306794,"en":"After piercing the mattocks, the arrow"},{"id":"seytek-2012:p0168:b002:l017","ordinal":306795,"en":"Plunged into the ground beyond them."},{"id":"seytek-2012:p0168:b002:l018","ordinal":306796,"en":"Seeing this, Külchoro"},{"id":"seytek-2012:p0168:b002:l019","ordinal":306797,"en":"Quickly cried, “Baabedin!”"},{"id":"seytek-2012:p0168:b002:l020","ordinal":306798,"en":"And swiftly vowed a moon-hoofed horse"},{"id":"seytek-2012:p0168:b002:l021","ordinal":306799,"en":"In honor of his princely father,"},{"id":"seytek-2012:p0168:b002:l022","ordinal":306800,"en":"Rejoicing so greatly that Choro cried:"},{"id":"seytek-2012:p0168:b002:l023","ordinal":306801,"en":"“Long ago, when we were young boys,"},{"id":"seytek-2012:p0168:b002:l024","ordinal":306802,"en":"When we were drunk and sated with liquor,"},{"id":"seytek-2012:p0168:b002:l025","ordinal":306803,"en":"In the marshlands of Jylgynduu,"},{"id":"seytek-2012:p0168:b002:l026","ordinal":306804,"en":"While the Kyrgyz lived in joy,"},{"id":"seytek-2012:p0168:b002:l027","ordinal":306805,"en":"If bored, we would shoot antelope;"},{"id":"seytek-2012:p0168:b002:l028","ordinal":306806,"en":"If not, in Talas"},{"id":"seytek-2012:p0168:b002:l029","ordinal":306807,"en":"We would play at ease."},{"id":"seytek-2012:p0168:b002:l030","ordinal":306808,"en":"When we camped high in the passes"},{"id":"seytek-2012:p0168:b002:l031","ordinal":306809,"en":"And ranged along the mountains,"},{"id":"seytek-2012:p0168:b002:l032","ordinal":306810,"en":"With games by day and girls by night,"},{"id":"seytek-2012:p0168:b002:l033","ordinal":306811,"en":"Such were those days."},{"id":"seytek-2012:p0168:b002:l034","ordinal":306812,"en":"We routed foes and took plunder,"},{"id":"seytek-2012:p0168:b002:l035","ordinal":306813,"en":"Defeated hosts of countless myriads,"},{"id":"seytek-2012:p0168:b002:l036","ordinal":306814,"en":"And won spoils from the lions we sought;"},{"id":"seytek-2012:p0168:b002:l037","ordinal":306815,"en":"Such were those days,"},{"id":"seytek-2012:p0168:b002:l038","ordinal":306816,"en":"When our fortune was whole"},{"id":"seytek-2012:p0168:b002:l039","ordinal":306817,"en":"And my gray-wolf uncle lived."},{"id":"seytek-2012:p0168:b002:l040","ordinal":306818,"en":"He was a vigorous, fleet-footed hero,"},{"id":"seytek-2012:p0168:b003:l001","ordinal":306819,"en":"Tall and broad-shouldered,"},{"id":"seytek-2012:p0168:b003:l002","ordinal":306820,"en":"Both wrestler and lion."},{"id":"seytek-2012:p0168:b003:l003","ordinal":306821,"en":"When roused, that poor hero"},{"id":"seytek-2012:p0168:b003:l004","ordinal":306822,"en":"Would subdue the world."},{"id":"seytek-2012:p0168:b003:l005","ordinal":306823,"en":"His figure was like a plane tree,"},{"id":"seytek-2012:p0168:b003:l006","ordinal":306824,"en":"His charge swift as a falcon,"},{"id":"seytek-2012:p0168:b003:l007","ordinal":306825,"en":"His courage like the wind of the world;"},{"id":"seytek-2012:p0168:b003:l008","ordinal":306826,"en":"When he charged, he seemed to devour lives."},{"id":"seytek-2012:p0168:b003:l009","ordinal":306827,"en":"When Choro surged in wrath,"},{"id":"seytek-2012:p0168:b003:l010","ordinal":306828,"en":"No mountain could withstand him;"},{"id":"seytek-2012:p0168:b003:l011","ordinal":306829,"en":"He charged without loosening his ranks,"},{"id":"seytek-2012:p0168:b003:l012","ordinal":306830,"en":"And none across the world could defeat him."},{"id":"seytek-2012:p0168:b003:l013","ordinal":306831,"en":"A wise servant descended from heroes,"},{"id":"seytek-2012:p0168:b003:l014","ordinal":306832,"en":"A grappler surpassing the world,"},{"id":"seytek-2012:p0168:b003:l015","ordinal":306833,"en":"He prepared to draw the bow,"},{"id":"seytek-2012:p0168:b003:l016","ordinal":306834,"en":"Donned his coat of mail, gleaming,"},{"id":"seytek-2012:p0168:b003:l017","ordinal":306835,"en":"His moonlike face shining,"},{"id":"seytek-2012:p0168:b003:l018","ordinal":306836,"en":"And girded on his gray belt."},{"id":"seytek-2012:p0168:b003:l019","ordinal":306837,"en":"He gave a deep rumbling cry,"},{"id":"seytek-2012:p0168:b003:l020","ordinal":306838,"en":"Took the steel bow in his hand,"},{"id":"seytek-2012:p0168:b003:l021","ordinal":306839,"en":"And fixed his gaze upon the mattocks."},{"id":"seytek-2012:p0168:b003:l022","ordinal":306840,"en":"His back bent and hunched,"},{"id":"seytek-2012:p0168:b003:l023","ordinal":306841,"en":"His eyes bulged and clouded;"},{"id":"seytek-2012:p0168:b003:l024","ordinal":306842,"en":"Fat oozed from his thumb,"},{"id":"seytek-2012:p0168:b003:l025","ordinal":306843,"en":"And from Choro’s forearm"},{"id":"seytek-2012:p0168:b003:l026","ordinal":306844,"en":"Dark blood dripped."},{"id":"seytek-2012:p0168:b003:l027","ordinal":306845,"en":"He labored with fierce resolve,"},{"id":"seytek-2012:p0168:b003:l028","ordinal":306846,"en":"Clenched his teeth and gathered his strength,"},{"id":"seytek-2012:p0168:b003:l029","ordinal":306847,"en":"Until the bones of his spine crackled."},{"id":"seytek-2012:p0168:b003:l030","ordinal":306848,"en":"Driven mad by wounded pride,"},{"id":"seytek-2012:p0168:b003:l031","ordinal":306849,"en":"“Will he die a wretched death?” they wondered;"},{"id":"seytek-2012:p0168:b003:l032","ordinal":306850,"en":"The people cried out in tumult"},{"id":"seytek-2012:p0168:b003:l033","ordinal":306851,"en":"And stood crowded round, watching."},{"id":"seytek-2012:p0168:b003:l034","ordinal":306852,"en":"“How will he shoot the mattocks?” they asked;"},{"id":"seytek-2012:p0168:b003:l035","ordinal":306853,"en":"The people stood crowded round,"},{"id":"seytek-2012:p0168:b003:l036","ordinal":306854,"en":"Marveling at Külchoro."},{"id":"seytek-2012:p0168:b003:l037","ordinal":306855,"en":"The poor man favored by the spirits"},{"id":"seytek-2012:p0168:b003:l038","ordinal":306856,"en":"Revealed himself to be a lion;"},{"id":"seytek-2012:p0168:b003:l039","ordinal":306857,"en":"His waist bent like a racing hound’s,"},{"id":"seytek-2012:p0168:b003:l040","ordinal":306858,"en":