[{"id":"seytek-2012:p0479:b002:l022","ordinal":330241,"en":"And your fortunes will mend again."},{"id":"seytek-2012:p0479:b002:l023","ordinal":330242,"en":"If dark-black blood flows,"},{"id":"seytek-2012:p0479:b002:l024","ordinal":330243,"en":"Bow your head before grief"},{"id":"seytek-2012:p0479:b002:l025","ordinal":330244,"en":"And cut off all your hope."},{"id":"seytek-2012:p0479:b002:l026","ordinal":330245,"en":"Let your Venus-like eyes shine."},{"id":"seytek-2012:p0479:b002:l027","ordinal":330246,"en":"Kanykey and old Bakai,"},{"id":"seytek-2012:p0479:b002:l028","ordinal":330247,"en":"Tear wounds in your own flesh."},{"id":"seytek-2012:p0479:b002:l029","ordinal":330248,"en":"Behold the true world;"},{"id":"seytek-2012:p0479:b002:l030","ordinal":330249,"en":"You elders who truly grieve,"},{"id":"seytek-2012:p0479:b002:l031","ordinal":330250,"en":"Die without further torment."},{"id":"seytek-2012:p0479:b002:l032","ordinal":330251,"en":"My white wife Aichürök,"},{"id":"seytek-2012:p0479:b002:l033","ordinal":330252,"en":"Loosen your hair until it darkens the earth,"},{"id":"seytek-2012:p0479:b002:l034","ordinal":330253,"en":"Claw your bloodied face,"},{"id":"seytek-2012:p0479:b002:l035","ordinal":330254,"en":"Put on black and sob,"},{"id":"seytek-2012:p0479:b002:l036","ordinal":330255,"en":"Crying, ‘My dear prince has died,’"},{"id":"seytek-2012:p0479:b002:l037","ordinal":330256,"en":"Put on black and wail."},{"id":"seytek-2012:p0479:b002:l038","ordinal":330257,"en":"Companion of this present age,"},{"id":"seytek-2012:p0479:b002:l039","ordinal":330258,"en":"O Külchoro, brother of my nest,"},{"id":"seytek-2012:p0479:b002:l040","ordinal":330259,"en":"Speak words that could shatter mountains.”"},{"id":"seytek-2012:p0479:b003:l001","ordinal":330260,"en":"He had lain there peacefully."},{"id":"seytek-2012:p0479:b003:l002","ordinal":330261,"en":"Before anyone could say another word,"},{"id":"seytek-2012:p0479:b003:l003","ordinal":330262,"en":"His poor mother sobbed,"},{"id":"seytek-2012:p0479:b003:l004","ordinal":330263,"en":"Every tiny bone in her body shuddered,"},{"id":"seytek-2012:p0479:b003:l005","ordinal":330264,"en":"Her body went limp and tossed about."},{"id":"seytek-2012:p0479:b003:l006","ordinal":330265,"en":"Pleading, “My Morning Star,”"},{"id":"seytek-2012:p0479:b003:l007","ordinal":330266,"en":"She bared her breast and settled down,"},{"id":"seytek-2012:p0479:b003:l008","ordinal":330267,"en":"Crooning, “My flower-like colt.”"},{"id":"seytek-2012:p0479:b003:l009","ordinal":330268,"en":"When his mother came near,"},{"id":"seytek-2012:p0479:b003:l010","ordinal":330269,"en":"His troubled heart found peace."},{"id":"seytek-2012:p0479:b003:l011","ordinal":330270,"en":"The poor lion guarded by the spirit said,"},{"id":"seytek-2012:p0479:b003:l012","ordinal":330271,"en":"“My mother’s scent has come;"},{"id":"seytek-2012:p0479:b003:l013","ordinal":330272,"en":"The Creator has granted me goodness."},{"id":"seytek-2012:p0479:b003:l014","ordinal":330273,"en":"If only I see her, my heart will be content;"},{"id":"seytek-2012:p0479:b003:l015","ordinal":330274,"en":"I have no sanctuary but my mother."},{"id":"seytek-2012:p0479:b003:l016","ordinal":330275,"en":"One day I shall meet death and die;"},{"id":"seytek-2012:p0479:b003:l017","ordinal":330276,"en":"Before the five stars of the wild sheep set,"},{"id":"seytek-2012:p0479:b003:l018","ordinal":330277,"en":"What can I do"},{"id":"seytek-2012:p0479:b003:l019","ordinal":330278,"en":"For my valiant mother, my sanctuary?"},{"id":"seytek-2012:p0479:b003:l020","ordinal":330279,"en":"When I was an infant,"},{"id":"seytek-2012:p0479:b003:l021","ordinal":330280,"en":"I clung to you, wailing and crying."},{"id":"seytek-2012:p0479:b003:l022","ordinal":330281,"en":"When six months had passed,"},{"id":"seytek-2012:p0479:b003:l023","ordinal":330282,"en":"I fought for your breast."},{"id":"seytek-2012:p0479:b003:l024","ordinal":330283,"en":"In the seventh month you swelled with me;"},{"id":"seytek-2012:p0479:b003:l025","ordinal":330284,"en":"When eight months had passed,"},{"id":"seytek-2012:p0479:b003:l026","ordinal":330285,"en":"I kicked your dress until it tore."},{"id":"seytek-2012:p0479:b003:l027","ordinal":330286,"en":"You made my valor surpass all others;"},{"id":"seytek-2012:p0479:b003:l028","ordinal":330287,"en":"I chafed the flesh of your calves,"},{"id":"seytek-2012:p0479:b003:l029","ordinal":330288,"en":"Made your heels ache,"},{"id":"seytek-2012:p0479:b003:l030","ordinal":330289,"en":"And blood flow from your legs."},{"id":"seytek-2012:p0479:b003:l031","ordinal":330290,"en":"You invoked God, moaning in anguish,"},{"id":"seytek-2012:p0479:b003:l032","ordinal":330291,"en":"Saying, ‘My plain where no coot flies,"},{"id":"seytek-2012:p0479:b003:l033","ordinal":330292,"en":"My child who will become my protector.’"},{"id":"seytek-2012:p0479:b003:l034","ordinal":330293,"en":"Kara Khan came riding in;"},{"id":"seytek-2012:p0479:b003:l035","ordinal":330294,"en":"When you went to Kara Khan,"},{"id":"seytek-2012:p0479:b003:l036","ordinal":330295,"en":"You had an amulet hung around my neck"},{"id":"seytek-2012:p0479:b003:l037","ordinal":330296,"en":"And had me raised apart from enemies."},{"id":"seytek-2012:p0479:b003:l038","ordinal":330297,"en":"Though once you prospered, poor mother,"},{"id":"seytek-2012:p0479:b003:l039","ordinal":330298,"en":"You suffered barren grief"},{"id":"seytek-2012:p0479:b003:l040","ordinal":330299,"en":"And were parted from wretched me."},{"id":"seytek-2012:p0480:b002:l001","ordinal":330300,"en":"In the desert of Medina,"},{"id":"seytek-2012:p0480:b002:l002","ordinal":330301,"en":"On the shore of Jan Baspas,"},{"id":"seytek-2012:p0480:b002:l003","ordinal":330302,"en":"I remained there for three years."},{"id":"seytek-2012:p0480:b002:l004","ordinal":330303,"en":"Then I turned and came back,"},{"id":"seytek-2012:p0480:b002:l005","ordinal":330304,"en":"And was parted from the multitude"},{"id":"seytek-2012:p0480:b002:l006","ordinal":330305,"en":"That had sat there as my protection."},{"id":"seytek-2012:p0480:b002:l007","ordinal":330306,"en":"In this black cave of the local sorcerer,"},{"id":"seytek-2012:p0480:b002:l008","ordinal":330307,"en":"Eighty maidens are my soul-companions,"},{"id":"seytek-2012:p0480:b002:l009","ordinal":330308,"en":"And I live in their company."},{"id":"seytek-2012:p0480:b002:l010","ordinal":330309,"en":"Once I ruled a people and maintained a nation,"},{"id":"seytek-2012:p0480:b002:l011","ordinal":330310,"en":"But my greatness remained over there;"},{"id":"seytek-2012:p0480:b002:l012","ordinal":330311,"en":"Unable to hear or see,"},{"id":"seytek-2012:p0480:b002:l013","ordinal":330312,"en":"I suffer here in misery."},{"id":"seytek-2012:p0480:b002:l014","ordinal":330313,"en":"A dry tongue offers no remedy,"},{"id":"seytek-2012:p0480:b002:l015","ordinal":330314,"en":"And there is no power by which to escape."},{"id":"seytek-2012:p0480:b002:l016","ordinal":330315,"en":"My ears are deaf and my eyes are blind;"},{"id":"seytek-2012:p0480:b002:l017","ordinal":330316,"en":"I, a dear warrior, have nearly withered away."},{"id":"seytek-2012:p0480:b002:l018","ordinal":330317,"en":"My coat has become a bed of torment;"},{"id":"seytek-2012:p0480:b002:l019","ordinal":330318,"en":"All my hands and feet"},{"id":"seytek-2012:p0480:b002:l020","ordinal":330319,"en":"Are bound by a spell."},{"id":"seytek-2012:p0480:b002:l021","ordinal":330320,"en":"I am not dead but alive;"},{"id":"seytek-2012:p0480:b002:l022","ordinal":330321,"en":"Captured by a sorcerer,"},{"id":"seytek-2012:p0480:b002:l023","ordinal":330322,"en":"I lament, crying, ‘O Mother!’"},{"id":"seytek-2012:p0480:b002:l024","ordinal":330323,"en":"But speaking is of no avail."},{"id":"seytek-2012:p0480:b002:l025","ordinal":330324,"en":"Unless my valiant mother comes,"},{"id":"seytek-2012:p0480:b002:l026","ordinal":330325,"en":"There is no other remedy.”"},{"id":"seytek-2012:p0480:b002:l027","ordinal":330326,"en":"Having said this, Semetey"},{"id":"seytek-2012:p0480:b002:l028","ordinal":330327,"en":"Turned his gray-bearded mouth,"},{"id":"seytek-2012:p0480:b002:l029","ordinal":330328,"en":"Faced toward the qibla,"},{"id":"seytek-2012:p0480:b002:l030","ordinal":330329,"en":"And shook off his grief as he lay down."},{"id":"seytek-2012:p0480:b002:l031","ordinal":330330,"en":"Raging and convulsing,"},{"id":"seytek-2012:p0480:b002:l032","ordinal":330331,"en":"“My dear mother Kanykey,”"},{"id":"seytek-2012:p0480:b002:l033","ordinal":330332,"en":"He pleaded with Kanykey"},{"id":"seytek-2012:p0480:b002:l034","ordinal":330333,"en":"And opened his mouth as wide as a cavern."},{"id":"seytek-2012:p0480:b002:l035","ordinal":330334,"en":"To escape from the sorcerer,"},{"id":"seytek-2012:p0480:b002:l036","ordinal":330335,"en":"He stood asking to be made whole;"},{"id":"seytek-2012:p0480:b002:l037","ordinal":330336,"en":"From his poor, fierce mother"},{"id":"seytek-2012:p0480:b002:l038","ordinal":330337,"en":"He stood asking for her milk."},{"id":"seytek-2012:p0480:b002:l039","ordinal":330338,"en":"When Semetey opened his mouth,"},{"id":"seytek-2012:p0480:b002:l040","ordinal":330339,"en":"“Of my dear, fierce mother,"},{"id":"seytek-2012:p0480:b003:l001","ordinal":330340,"en":"Say, ‘My mountain-like elder brother has died;"},{"id":"seytek-2012:p0480:b003:l002","ordinal":330341,"en":"The people have seen the true place"},{"id":"seytek-2012:p0480:b003:l003","ordinal":330342,"en":"Where the nation cannot be destroyed;"},{"id":"seytek-2012:p0480:b003:l004","ordinal":330343,"en":"Remain and mourn him thus once more.’"},{"id":"seytek-2012:p0480:b003:l005","ordinal":330344,"en":"If milk flows from my mother,"},{"id":"seytek-2012:p0480:b003:l006","ordinal":330345,"en":"Your moonlike brow will brighten,"},{"id":"seytek-2012:p0480:b003:l007","ordinal":330346,"en":"Your pure heart will glow,"},{"id":"seytek-2012:p0480:b003:l008","ordinal":330347,"en":"And your face will shine like the moon."},{"id":"seytek-2012:p0480:b003:l009","ordinal":330348,"en":"Crying, ‘My twin, my elder brother, has come,’"},{"id":"seytek-2012:p0480:b003:l010","ordinal":330349,"en":"The fire within you will subside,"},{"id":"seytek-2012:p0480:b003:l011","ordinal":330350,"en":"And your painful sorrow will ease."},{"id":"seytek-2012:p0480:b003:l012","ordinal":330351,"en":"If my valiant mother is alive,"},{"id":"seytek-2012:p0480:b003:l013","ordinal":330352,"en":"Let her come and stand face-to-face with me."},{"id":"seytek-2012:p0480:b003:l014","ordinal":330353,"en":"Let her keep kindling the whetstone,"},{"id":"seytek-2012:p0480:b003:l015","ordinal":330354,"en":"Let her perform the offering."},{"id":"seytek-2012:p0480:b003:l016","ordinal":330355,"en":"Let her roll up her sleeves,"},{"id":"seytek-2012:p0480:b003:l017","ordinal":330356,"en":"And let my mother make her prayer."},{"id":"seytek-2012:p0480:b003:l018","ordinal":330357,"en":"Tell her to stand before me,"},{"id":"seytek-2012:p0480:b003:l019","ordinal":330358,"en":"Her heart melting,"},{"id":"seytek-2012:p0480:b003:l020","ordinal":330359,"en":"Her flesh and nails stretching toward me,"},{"id":"seytek-2012:p0480:b003:l021","ordinal":330360,"en":"Her tiny soul crying out,"},{"id":"seytek-2012:p0480:b003:l022","ordinal":330361,"en":"Pleading, ‘My only one,’"},{"id":"seytek-2012:p0480:b003:l023","ordinal":330362,"en":"And sobbing as she makes her prayer."},{"id":"seytek-2012:p0480:b003:l024","ordinal":330363,"en":"If her breasts soften and milk flows,"},{"id":"seytek-2012:p0480:b003:l025","ordinal":330364,"en":"Then God has granted you favor."},{"id":"seytek-2012:p0480:b003:l026","ordinal":330365,"en":"I shall clearly see with my eyes,"},{"id":"seytek-2012:p0480:b003:l027","ordinal":330366,"en":"And truly know myself."},{"id":"seytek-2012:p0480:b003:l028","ordinal":330367,"en":"Like a star in the heavens,"},{"id":"seytek-2012:p0480:b003:l029","ordinal":330368,"en":"I shall roll along like a plump sheep"},{"id":"seytek-2012:p0480:b003:l030","ordinal":330369,"en":"And join you."},{"id":"seytek-2012:p0480:b003:l031","ordinal":330370,"en":"The reason I can join you is this:"},{"id":"seytek-2012:p0480:b003:l032","ordinal":330371,"en":"I am not dead but alive,"},{"id":"seytek-2012:p0480:b003:l033","ordinal":330372,"en":"One of those who have not died."},{"id":"seytek-2012:p0480:b003:l034","ordinal":330373,"en":"The sorcerers led me astray"},{"id":"seytek-2012:p0480:b003:l035","ordinal":330374,"en":"And carried me away."},{"id":"seytek-2012:p0480:b003:l036","ordinal":330375,"en":"I was parted from my people and gone;"},{"id":"seytek-2012:p0480:b003:l037","ordinal":330376,"en":"In Jelpiniş beneath the earth"},{"id":"seytek-2012:p0480:b003:l038","ordinal":330377,"en":"I remained here for three years."},{"id":"seytek-2012:p0480:b003:l039","ordinal":330378,"en":"Of the pleasures of this world"},{"id":"seytek-2012:p0480:b003:l040","ordinal":330379,"en":"I had my fill long ago."},{"id":"seytek-2012:p0481:b002:l001","ordinal":330380,"en":"I'm full without dying,"},{"id":"seytek-2012:p0481:b002:l002","ordinal":330381,"en":"Have a nice day."},{"id":"seytek-2012:p0481:b002:l003","ordinal":330382,"en":"If my child doesn't touch me today,"},{"id":"seytek-2012:p0481:b002:l004","ordinal":330383,"en":"What will I do when I see the sun?"},{"id":"seytek-2012:p0481:b002:l005","ordinal":330384,"en":"I will become like coal\" -"},{"id":"seytek-2012:p0481:b002:l006","ordinal":330385,"en":"That's how, Kanykei"},{"id":"seytek-2012:p0481:b002:l007","ordinal":330386,"en":"Two thoughts"},{"id":"seytek-2012:p0481:b002:l008","ordinal":330387,"en":"Fainting,"},{"id":"seytek-2012:p0481:b002:l009","ordinal":330388,"en":"The top hair is wool,"},{"id":"seytek-2012:p0481:b002:l010","ordinal":330389,"en":"Semetei does not touch hands,"},{"id":"seytek-2012:p0481:b002:l011","ordinal":330390,"en":"It is a difficult day to see,"},{"id":"seytek-2012:p0481:b002:l012","ordinal":330391,"en":"Begging to see,"},{"id":"seytek-2012:p0481:b002:l013","ordinal":330392,"en":"Strength comes from the bones,"},{"id":"seytek-2012:p0481:b002:l014","ordinal":330393,"en":"Milk came out of the breast."},{"id":"seytek-2012:p0481:b002:l015","ordinal":330394,"en":"The body is loose and shiny,"},{"id":"seytek-2012:p0481:b002:l016","ordinal":330395,"en":"The mother is completely innocent"},{"id":"seytek-2012:p0481:b002:l017","ordinal":330396,"en":"Shining like the moon,"},{"id":"seytek-2012:p0481:b002:l018","ordinal":330397,"en":"Beren is the same, bel is the same,"},{"id":"seytek-2012:p0481:b002:l019","ordinal":330398,"en":"Good night for the farmer"},{"id":"seytek-2012:p0481:b002:l020","ordinal":330399,"en":"Oluyazaada date,"},{"id":"seytek-2012:p0481:b002:l021","ordinal":330400,"en":"Whether it's free or easy,"},{"id":"seytek-2012:p0481:b002:l022","ordinal":330401,"en":"Kan is the wife of Manas."},{"id":"seytek-2012:p0481:b002:l023","ordinal":330402,"en":"The fruit of the kalayk,"},{"id":"seytek-2012:p0481:b002:l024","ordinal":330403,"en":"The mother of a murderous lion."},{"id":"seytek-2012:p0481:b002:l025","ordinal":330404,"en":"Your mother's birthday again,"},{"id":"seytek-2012:p0481:b002:l026","ordinal":330405,"en":"My child is saying moon,"},{"id":"seytek-2012:p0481:b002:l027","ordinal":330406,"en":"Great Buckeye in old age,"},{"id":"seytek-2012:p0481:b002:l028","ordinal":330407,"en":"He made a wish and screamed."},{"id":"seytek-2012:p0481:b002:l029","ordinal":330408,"en":"The body was strong,"},{"id":"seytek-2012:p0481:b002:l030","ordinal":330409,"en":"Again from your mother"},{"id":"seytek-2012:p0481:b002:l031","ordinal":330410,"en":"Milk came out of the spring."},{"id":"seytek-2012:p0481:b002:l032","ordinal":330411,"en":"Beaten to give and see,"},{"id":"seytek-2012:p0481:b002:l033","ordinal":330412,"en":"Semetey, if you block your breast,"},{"id":"seytek-2012:p0481:b002:l034","ordinal":330413,"en":"At that time Semetey"},{"id":"seytek-2012:p0481:b002:l035","ordinal":330414,"en":"This is what my real mother smells like."},{"id":"seytek-