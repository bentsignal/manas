[{"id":"semetey-1-2013:p1236:b004:l017","ordinal":170497,"en":"His stride lengthened with every step."},{"id":"semetey-1-2013:p1236:b004:l018","ordinal":170498,"en":"His hooves thundered on the earth;"},{"id":"semetey-1-2013:p1236:b004:l019","ordinal":170499,"en":"The black-steel bit"},{"id":"semetey-1-2013:p1236:b004:l020","ordinal":170500,"en":"Clattered in his throat."},{"id":"semetey-1-2013:p1236:b004:l021","ordinal":170501,"en":"Throwing his forelock to the sky,"},{"id":"semetey-1-2013:p1236:b004:l022","ordinal":170502,"en":"Beautiful racehorse Arbuurul"},{"id":"semetey-1-2013:p1236:b004:l023","ordinal":170503,"en":"Drove his hooves into the earth."},{"id":"semetey-1-2013:p1236:b004:l024","ordinal":170504,"en":"From the feather-grass ridge,"},{"id":"semetey-1-2013:p1236:b004:l025","ordinal":170505,"en":"From the high-shouldered rise,"},{"id":"semetey-1-2013:p1236:b004:l026","ordinal":170506,"en":"When the Roan came alongside,"},{"id":"semetey-1-2013:p1236:b004:l027","ordinal":170507,"en":"Shouting, \"Manas! Manas!\""},{"id":"semetey-1-2013:p1236:b004:l028","ordinal":170508,"en":"Calling the battle cry \"Manas,\""},{"id":"semetey-1-2013:p1236:b004:l029","ordinal":170509,"en":"Young Lord Kulchoro"},{"id":"semetey-1-2013:p1236:b004:l030","ordinal":170510,"en":"Raised the patterned spear,"},{"id":"semetey-1-2013:p1236:b004:l031","ordinal":170511,"en":"Turned the Roan's head,"},{"id":"semetey-1-2013:p1236:b004:l032","ordinal":170512,"en":"And leveled the patterned spear"},{"id":"semetey-1-2013:p1236:b004:l033","ordinal":170513,"en":"At Toltoy whom you have seen."},{"id":"semetey-1-2013:p1236:b004:l034","ordinal":170514,"en":"Kulchoro was an ocean;"},{"id":"semetey-1-2013:p1236:b004:l035","ordinal":170515,"en":"Without looking around,"},{"id":"semetey-1-2013:p1236:b004:l036","ordinal":170516,"en":"Without sparing his life at all,"},{"id":"semetey-1-2013:p1236:b004:l037","ordinal":170517,"en":"As the Roan passed alongside,"},{"id":"semetey-1-2013:p1236:b004:l038","ordinal":170518,"en":"He cried, \"Ah God, support me!\""},{"id":"semetey-1-2013:p1236:b004:l039","ordinal":170519,"en":"And then raised his spear."},{"id":"semetey-1-2013:p1237:b003:l001","ordinal":170520,"en":"Toltoy fled with a roar;"},{"id":"semetey-1-2013:p1237:b003:l002","ordinal":170521,"en":"Dear Choro spared no effort."},{"id":"semetey-1-2013:p1237:b003:l003","ordinal":170522,"en":"The leopard's patterned spear—"},{"id":"semetey-1-2013:p1237:b003:l004","ordinal":170523,"en":"Your valiant man aimed and held it,"},{"id":"semetey-1-2013:p1237:b003:l005","ordinal":170524,"en":"But could not thrust it flexing."},{"id":"semetey-1-2013:p1237:b003:l006","ordinal":170525,"en":"His uncle had made his spear"},{"id":"semetey-1-2013:p1237:b003:l007","ordinal":170526,"en":"Immense and unwieldy:"},{"id":"semetey-1-2013:p1237:b003:l008","ordinal":170527,"en":"\"Would I not have ended"},{"id":"semetey-1-2013:p1237:b003:l009","ordinal":170528,"en":"Swaggering Toltoy's devices?"},{"id":"semetey-1-2013:p1237:b003:l010","ordinal":170529,"en":"He made the spear beyond measure,"},{"id":"semetey-1-2013:p1237:b003:l011","ordinal":170530,"en":"Made his spear unbounded;"},{"id":"semetey-1-2013:p1237:b003:l012","ordinal":170531,"en":"Had he made it more measured"},{"id":"semetey-1-2013:p1237:b003:l013","ordinal":170532,"en":"For Toltoy at the flank,"},{"id":"semetey-1-2013:p1237:b003:l014","ordinal":170533,"en":"Would I not have ended his devices?\""},{"id":"semetey-1-2013:p1237:b003:l015","ordinal":170534,"en":"He strained, gripping the spear,"},{"id":"semetey-1-2013:p1237:b003:l016","ordinal":170535,"en":"But could not drive"},{"id":"semetey-1-2013:p1237:b003:l017","ordinal":170536,"en":"The leopard's patterned spear flexing,"},{"id":"semetey-1-2013:p1237:b003:l018","ordinal":170537,"en":"And quarreled with his uncle."},{"id":"semetey-1-2013:p1237:b003:l019","ordinal":170538,"en":"His waist bent forward,"},{"id":"semetey-1-2013:p1237:b003:l020","ordinal":170539,"en":"His eyes bulged,"},{"id":"semetey-1-2013:p1237:b003:l021","ordinal":170540,"en":"Early words became late,"},{"id":"semetey-1-2013:p1237:b003:l022","ordinal":170541,"en":"And young Lord Choro's"},{"id":"semetey-1-2013:p1237:b003:l023","ordinal":170542,"en":"Two eyes became four."},{"id":"semetey-1-2013:p1237:b003:l024","ordinal":170543,"en":"\"If only I could spear"},{"id":"semetey-1-2013:p1237:b003:l025","ordinal":170544,"en":"Swaggering Toltoy to the ground,"},{"id":"semetey-1-2013:p1237:b003:l026","ordinal":170545,"en":"Offer him as a sacrifice,"},{"id":"semetey-1-2013:p1237:b003:l027","ordinal":170546,"en":"Cut off his head and bind it,"},{"id":"semetey-1-2013:p1237:b003:l028","ordinal":170547,"en":"And bring good news"},{"id":"semetey-1-2013:p1237:b003:l029","ordinal":170548,"en":"To my heroic uncle and lord."},{"id":"semetey-1-2013:p1237:b003:l030","ordinal":170549,"en":"At least I might ask for"},{"id":"semetey-1-2013:p1237:b003:l031","ordinal":170550,"en":"The khanship of the Argyn,\""},{"id":"semetey-1-2013:p1237:b003:l032","ordinal":170551,"en":"He thought, aiming for the shoulder blade,"},{"id":"semetey-1-2013:p1237:b003:l033","ordinal":170552,"en":"For the lower edge of the lung."},{"id":"semetey-1-2013:p1237:b003:l034","ordinal":170553,"en":"He entered measuring his thrust."},{"id":"semetey-1-2013:p1237:b003:l035","ordinal":170554,"en":"The armor upon the shoulder blade,"},{"id":"semetey-1-2013:p1237:b003:l036","ordinal":170555,"en":"Iron no spear could pierce—"},{"id":"semetey-1-2013:p1237:b003:l037","ordinal":170556,"en":"\"If by chance I thrust astray,"},{"id":"semetey-1-2013:p1237:b003:l038","ordinal":170557,"en":"I will remain in regret.\""},{"id":"semetey-1-2013:p1237:b003:l039","ordinal":170558,"en":"He aimed for the backbone,"},{"id":"semetey-1-2013:p1237:b004:l001","ordinal":170559,"en":"For the lower edge of the heart,"},{"id":"semetey-1-2013:p1237:b004:l002","ordinal":170560,"en":"And drove in the spear."},{"id":"semetey-1-2013:p1237:b004:l003","ordinal":170561,"en":"The armor upon the backbone"},{"id":"semetey-1-2013:p1237:b004:l004","ordinal":170562,"en":"Was iron no spear could pierce."},{"id":"semetey-1-2013:p1237:b004:l005","ordinal":170563,"en":"\"If I collide by chance"},{"id":"semetey-1-2013:p1237:b004:l006","ordinal":170564,"en":"And thrust astray by accident,"},{"id":"semetey-1-2013:p1237:b004:l007","ordinal":170565,"en":"God will take me thus;"},{"id":"semetey-1-2013:p1237:b004:l008","ordinal":170566,"en":"It will become a mistake."},{"id":"semetey-1-2013:p1237:b004:l009","ordinal":170567,"en":"If by chance it happens so,"},{"id":"semetey-1-2013:p1237:b004:l010","ordinal":170568,"en":"God will take me.\""},{"id":"semetey-1-2013:p1237:b004:l011","ordinal":170569,"en":"Kulchoro lowered his aim"},{"id":"semetey-1-2013:p1237:b004:l012","ordinal":170570,"en":"Toward the lower skirt"},{"id":"semetey-1-2013:p1237:b004:l013","ordinal":170571,"en":"Of the bulletproof armor."},{"id":"semetey-1-2013:p1237:b004:l014","ordinal":170572,"en":"\"If I thrust hard there,"},{"id":"semetey-1-2013:p1237:b004:l015","ordinal":170573,"en":"At the edge of the backbone,"},{"id":"semetey-1-2013:p1237:b004:l016","ordinal":170574,"en":"If I strike true then,"},{"id":"semetey-1-2013:p1237:b004:l017","ordinal":170575,"en":"At the edge of the bladder.\""},{"id":"semetey-1-2013:p1237:b004:l018","ordinal":170576,"en":"He gripped the spear enormously"},{"id":"semetey-1-2013:p1237:b004:l019","ordinal":170577,"en":"And used exceptional cunning."},{"id":"semetey-1-2013:p1237:b004:l020","ordinal":170578,"en":"Seizing and swinging"},{"id":"semetey-1-2013:p1237:b004:l021","ordinal":170579,"en":"The leopard's patterned spear,"},{"id":"semetey-1-2013:p1237:b004:l022","ordinal":170580,"en":"Without sparing his dear life,"},{"id":"semetey-1-2013:p1237:b004:l023","ordinal":170581,"en":"He drove it firmly"},{"id":"semetey-1-2013:p1237:b004:l024","ordinal":170582,"en":"Into hero Toltoy's fat rump."},{"id":"semetey-1-2013:p1237:b004:l025","ordinal":170583,"en":"When the spear struck hero Toltoy,"},{"id":"semetey-1-2013:p1237:b004:l026","ordinal":170584,"en":"From the edge of the fat rump"},{"id":"semetey-1-2013:p1237:b004:l027","ordinal":170585,"en":"It failed to reach the bladder,"},{"id":"semetey-1-2013:p1237:b004:l028","ordinal":170586,"en":"Two fingers below its edge,"},{"id":"semetey-1-2013:p1237:b004:l029","ordinal":170587,"en":"It struck astray."},{"id":"semetey-1-2013:p1237:b004:l030","ordinal":170588,"en":"Toltoy's thick flesh"},{"id":"semetey-1-2013:p1237:b004:l031","ordinal":170589,"en":"Held it back with flesh;"},{"id":"semetey-1-2013:p1237:b004:l032","ordinal":170590,"en":"Toltoy's thick coat"},{"id":"semetey-1-2013:p1237:b004:l033","ordinal":170591,"en":"Held it back with cloth;"},{"id":"semetey-1-2013:p1237:b004:l034","ordinal":170592,"en":"The spirit of his father, hero Bagysh,"},{"id":"semetey-1-2013:p1237:b004:l035","ordinal":170593,"en":"Raised and protected him greatly."},{"id":"semetey-1-2013:p1237:b004:l036","ordinal":170594,"en":"Skirting the bone of the lower back,"},{"id":"semetey-1-2013:p1237:b004:l037","ordinal":170595,"en":"The valiant spear reached him"},{"id":"semetey-1-2013:p1237:b004:l038","ordinal":170596,"en":"And sank four fingers deep"},{"id":"semetey-1-2013:p1237:b004:l039","ordinal":170597,"en":"Into his buttock."},{"id":"semetey-1-2013:p1238:b003:l001","ordinal":170598,"en":"Hero Toltoy of the Jediger,"},{"id":"semetey-1-2013:p1238:b003:l002","ordinal":170599,"en":"When the spear struck him,"},{"id":"semetey-1-2013:p1238:b003:l003","ordinal":170600,"en":"Cried, \"Ah, alas, my back!\""},{"id":"semetey-1-2013:p1238:b003:l004","ordinal":170601,"en":"His eyes darted,"},{"id":"semetey-1-2013:p1238:b003:l005","ordinal":170602,"en":"His legs dangled loose."},{"id":"semetey-1-2013:p1238:b003:l006","ordinal":170603,"en":"Surkoen ran uncontrollably;"},{"id":"semetey-1-2013:p1238:b003:l007","ordinal":170604,"en":"Toltoy of the Jediger"},{"id":"semetey-1-2013:p1238:b003:l008","ordinal":170605,"en":"Despaired of his entrusted life."},{"id":"semetey-1-2013:p1238:b003:l009","ordinal":170606,"en":"His senses failed and he reeled,"},{"id":"semetey-1-2013:p1238:b003:l010","ordinal":170607,"en":"Despairing of his poor life."},{"id":"semetey-1-2013:p1238:b003:l011","ordinal":170608,"en":"\"I have seen the place of Judgment Day;"},{"id":"semetey-1-2013:p1238:b003:l012","ordinal":170609,"en":"My accursed wretched soul is dead."},{"id":"semetey-1-2013:p1238:b003:l013","ordinal":170610,"en":"I was a mighty man, poor soul,"},{"id":"semetey-1-2013:p1238:b003:l014","ordinal":170611,"en":"And guarded myself for so long."},{"id":"semetey-1-2013:p1238:b003:l015","ordinal":170612,"en":"I have been caught by chance"},{"id":"semetey-1-2013:p1238:b003:l016","ordinal":170613,"en":"By this mighty-born stripling."},{"id":"semetey-1-2013:p1238:b003:l017","ordinal":170614,"en":"He is a boy of twelve—"},{"id":"semetey-1-2013:p1238:b003:l018","ordinal":170615,"en":"Must I suffer at his hands?"},{"id":"semetey-1-2013:p1238:b003:l019","ordinal":170616,"en":"My devices fail me here;"},{"id":"semetey-1-2013:p1238:b003:l020","ordinal":170617,"en":"Will I die before my destined death?\""},{"id":"semetey-1-2013:p1238:b003:l021","ordinal":170618,"en":"Hero Toltoy, wracked with pain,"},{"id":"semetey-1-2013:p1238:b003:l022","ordinal":170619,"en":"His temples tightened,"},{"id":"semetey-1-2013:p1238:b003:l023","ordinal":170620,"en":"And he quarreled with Surkoen:"},{"id":"semetey-1-2013:p1238:b003:l024","ordinal":170621,"en":"\"Damn you, Surkoen!"},{"id":"semetey-1-2013:p1238:b003:l025","ordinal":170622,"en":"You were a swift stallion,"},{"id":"semetey-1-2013:p1238:b003:l026","ordinal":170623,"en":"In the prime of your flesh,"},{"id":"semetey-1-2013:p1238:b003:l027","ordinal":170624,"en":"At the height of your speed."},{"id":"semetey-1-2013:p1238:b003:l028","ordinal":170625,"en":"Did the enemy slaughter and plunder you?"},{"id":"semetey-1-2013:p1238:b003:l029","ordinal":170626,"en":"Damn you, may your road be blessed—"},{"id":"semetey-1-2013:p1238:b003:l030","ordinal":170627,"en":"Has Satan hobbled you?\""},{"id":"semetey-1-2013:p1238:b003:l031","ordinal":170628,"en":"Fortunate hero Toltoy"},{"id":"semetey-1-2013:p1238:b003:l032","ordinal":170629,"en":"Spoke of his calamity."},{"id":"semetey-1-2013:p1238:b003:l033","ordinal":170630,"en":"At twelve, Kulchoro,"},{"id":"semetey-1-2013:p1238:b003:l034","ordinal":170631,"en":"The stripling who crossed his road,"},{"id":"semetey-1-2013:p1238:b003:l035","ordinal":170632,"en":"Had devoured hero Toltoy."},{"id":"semetey-1-2013:p1238:b003:l036","ordinal":170633,"en":"His backbone throbbed with pain,"},{"id":"semetey-1-2013:p1238:b003:l037","ordinal":170634,"en":"And the fly-like soul"},{"id":"semetey-1-2013:p1238:b003:l038","ordinal":170635,"en":"Of the lord who came for a wife shrieked."},{"id":"semetey-1-2013:p1238:b003:l039","ordinal":170636,"en":"The pain became severe;"},{"id":"semetey-1-2013:p1238:b004:l001","ordinal":170637,"en":"His spine ached and tightened."},{"id":"semetey-1-2013:p1238:b004:l002","ordinal":170638,"en":"Hero Toltoy rode raging,"},{"id":"semetey-1-2013:p1238:b004:l003","ordinal":170639,"en":"Quarreling with Chynkojo:"},{"id":"semetey-1-2013:p1238:b004:l004","ordinal":170640,"en":"\"I was returning thoughtfully to the camp,"},{"id":"semetey-1-2013:p1238:b004:l005","ordinal":170641,"en":"But this exile lay in wait for me;"},{"id":"semetey-1-2013:p1238:b004:l006","ordinal":170642,"en":"This fugitive has reached me,"},{"id":"semetey-1-2013:p1238:b004:l007","ordinal":170643,"en":"Driving me to my end."},{"id":"semetey-1-2013:p1238:b004:l008","ordinal":170644,"en":"Never heeding words,"},{"id":"semetey-1-2013:p1238:b004:l009","ordinal":170645,"en":"The accursed fugitive slave"},{"id":"semetey-1-2013:p1238:b004:l010","ordinal":170646,"en":"Has dug my grave,"},{"id":"semetey-1-2013:p1238:b004:l011","ordinal":170647,"en":"Saying, 'Seize his wife,'"},{"id":"semetey-1-2013:p1238:b004:l012","ordinal":170648,"en":"And confronting me on a dark day,"},{"id":"semetey-1-2013:p1238:b004:l013","ordinal":170649,"en":"Has performed a fine deed.\""},{"id":"semetey-1-2013:p1238:b004:l014","ordinal":170650,"en":"Toltoy despaired of life."},{"id":"semetey-1-2013:p1238:b004:l015","ordinal":170651,"en":"Arbuudan flew like an arrow"},{"id":"semetey-1-2013:p1238:b004:l016","ordinal":170652,"en":"And ran past Toltoy."},{"id":"semetey-1-2013:p1238:b004:l017","ordinal":170653,"en":"When gray-maned Toltoy saw it,"},{"id":"semetey-1-2013:p1238:b004:l018","ordinal":170654,"en":"He plainly despaired of life."},{"id":"semetey-1-2013:p1238:b004:l019","ordinal":170655,"en":"\"This boy is a fool;"},{"id":"semetey-1-2013:p1238:b004:l020","ordinal":170656,"en":"If he recovers, he will not act rightly."},{"id":"semetey-1-2013:p1238:b004:l021","ordinal":170657,"en":"If he turns back recovered,"},{"id":"semetey-1-2013:p1238:b004:l022","ordinal":170658,"en":"He will not leave my poor life whole."},{"id":"semetey-1-2013:p1238:b004:l023","ordinal":170659,"en":"I will cut off with my sword"},{"id":"semetey-1-2013:p1238:b004:l024","ordinal":170660,"en":"The head of the boy who comes before me."},{"id":"semetey-1-2013:p1238:b004:l025","ordinal":170661,"en":"Before the accursed boy"},{"id":"semetey-1-2013:p1238:b004:l026","ordinal":170662,"en":"Can glance back and turn,"},{"id":"semetey-1-2013:p1238:b004:l027","ordinal":170663,"en":"I will make a spectacle of him!\""},{"id":"semetey-1-2013:p1238:b004:l028","ordinal":170664,"en":"Hero Toltoy of the Jediger"},{"id":"semetey-1-2013:p1238:b004:l029","ordinal":170665,"en":"Was one of the accomplished heroes."},{"id":"semetey-1-2013:p1238:b004:l030","ordinal":170666,"en":"Before the boy could turn back,"},{"id":"semetey-1-2013:p1238:b004:l031","ordinal":170667,"en":"He drew from its sheath"},{"id":"semetey-1-2013:p1238:b004:l032","ordinal":170668,"en":"His sword that cut through honor."},{"id":"semetey-1-2013:p1238:b004:l033","ordinal":170669,"en":"When his opportunity came,"},{"id":"semetey-1-2013:p1238:b004:l034","ordinal":170670,"en":"Dear spirited hero Toltoy"},{"id":"semetey-1-2013:p1238:b004:l035","ordinal":170671,"en":"Struck off his head with the sword."},{"id":"semetey-1-2013:p1238:b004:l036","ordinal":170672,"en":"Before the boy could wheel around,"},{"id":"semetey-1-2013:p1238:b004:l037","ordinal":170673,"en":"When he looked at Kulchoro,"},{"id":"semetey-1-2013:p1238:b004:l038","ordinal":170674,"en":"The wretched young lord—"},{"id":"semetey-1-2013:p1238:b004:l039","ordinal":170675,"en":"At one glance he was one man,"}]
