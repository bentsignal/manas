[{"id":"semetey-1-2013:p1389:b003:l033","ordinal":182273,"en":"Resourceful uncle"},{"id":"semetey-1-2013:p1389:b003:l034","ordinal":182274,"en":"Has the majesty of a countless host."},{"id":"semetey-1-2013:p1389:b003:l035","ordinal":182275,"en":"You found words in sudden danger;"},{"id":"semetey-1-2013:p1389:b003:l036","ordinal":182276,"en":"If you are truly a khan,"},{"id":"semetey-1-2013:p1389:b003:l037","ordinal":182277,"en":"My dear uncle,"},{"id":"semetey-1-2013:p1389:b003:l038","ordinal":182278,"en":"Find sight in the darkness."},{"id":"semetey-1-2013:p1389:b003:l039","ordinal":182279,"en":"Join together what is broken;"},{"id":"semetey-1-2013:p1389:b003:l040","ordinal":182280,"en":"Gather together what is scattered!"},{"id":"semetey-1-2013:p1389:b004:l001","ordinal":182281,"en":"Find a road where there is none;"},{"id":"semetey-1-2013:p1389:b004:l002","ordinal":182282,"en":"If you are truly a lion—"},{"id":"semetey-1-2013:p1389:b004:l003","ordinal":182283,"en":"Lion uncle Bakai,"},{"id":"semetey-1-2013:p1389:b004:l004","ordinal":182284,"en":"Find a place where the horseless boys"},{"id":"semetey-1-2013:p1389:b004:l005","ordinal":182285,"en":"Can be left in safekeeping!"},{"id":"semetey-1-2013:p1389:b004:l006","ordinal":182286,"en":"If the horse dies from carrying two,"},{"id":"semetey-1-2013:p1389:b004:l007","ordinal":182287,"en":"And we die from hardship,"},{"id":"semetey-1-2013:p1389:b004:l008","ordinal":182288,"en":"What desire shall we attain?"},{"id":"semetey-1-2013:p1389:b004:l009","ordinal":182289,"en":"Better that we leave the boys"},{"id":"semetey-1-2013:p1389:b004:l010","ordinal":182290,"en":"With the baggage train!”"},{"id":"semetey-1-2013:p1389:b004:l011","ordinal":182291,"en":"After Semetey said this,"},{"id":"semetey-1-2013:p1389:b004:l012","ordinal":182292,"en":"His uncle, old Bakai—"},{"id":"semetey-1-2013:p1389:b004:l013","ordinal":182293,"en":"The holy clairvoyant,"},{"id":"semetey-1-2013:p1389:b004:l014","ordinal":182294,"en":"The revered kinsman and saint—said:"},{"id":"semetey-1-2013:p1389:b004:l015","ordinal":182295,"en":"“Very well, my son, very well;"},{"id":"semetey-1-2013:p1389:b004:l016","ordinal":182296,"en":"What you say is wise."},{"id":"semetey-1-2013:p1389:b004:l017","ordinal":182297,"en":"If we take the boys double,"},{"id":"semetey-1-2013:p1389:b004:l018","ordinal":182298,"en":"Toward what goal can we proceed?"},{"id":"semetey-1-2013:p1389:b004:l019","ordinal":182299,"en":"Better that we entrust them"},{"id":"semetey-1-2013:p1389:b004:l020","ordinal":182300,"en":"To God in some place"},{"id":"semetey-1-2013:p1389:b004:l021","ordinal":182301,"en":"And leave them with the baggage train!"},{"id":"semetey-1-2013:p1389:b004:l022","ordinal":182302,"en":"Kakanchin's Beijing is a formidable city;"},{"id":"semetey-1-2013:p1389:b004:l023","ordinal":182303,"en":"May gracious Allah grant a road—"},{"id":"semetey-1-2013:p1389:b004:l024","ordinal":182304,"en":"How many places hold peril!"},{"id":"semetey-1-2013:p1389:b004:l025","ordinal":182305,"en":"The Chinese are no feeble people;"},{"id":"semetey-1-2013:p1389:b004:l026","ordinal":182306,"en":"When their jang-jun issues a decree,"},{"id":"semetey-1-2013:p1389:b004:l027","ordinal":182307,"en":"They are not a people who spare their lives."},{"id":"semetey-1-2013:p1389:b004:l028","ordinal":182308,"en":"Beijing is no feeble land;"},{"id":"semetey-1-2013:p1389:b004:l029","ordinal":182309,"en":"You will fight the Kakanchin,"},{"id":"semetey-1-2013:p1389:b004:l030","ordinal":182310,"en":"No people for mortals to assail!"},{"id":"semetey-1-2013:p1389:b004:l031","ordinal":182311,"en":"An earthen rampart encircles it;"},{"id":"semetey-1-2013:p1389:b004:l032","ordinal":182312,"en":"Within that rampart"},{"id":"semetey-1-2013:p1389:b004:l033","ordinal":182313,"en":"Dwell the unruly Chinese people."},{"id":"semetey-1-2013:p1389:b004:l034","ordinal":182314,"en":"God knows whether we shall reach it;"},{"id":"semetey-1-2013:p1389:b004:l035","ordinal":182315,"en":"God knows whether we shall remain alive"},{"id":"semetey-1-2013:p1389:b004:l036","ordinal":182316,"en":"And not die in Beijing!"},{"id":"semetey-1-2013:p1389:b004:l037","ordinal":182317,"en":"That is a people of painful calamity;"},{"id":"semetey-1-2013:p1389:b004:l038","ordinal":182318,"en":"That is the pass of Beijing we must fight!"},{"id":"semetey-1-2013:p1389:b004:l039","ordinal":182319,"en":"It has guards and a khan;"},{"id":"semetey-1-2013:p1389:b004:l040","ordinal":182320,"en":"Dear Beijing of Zuntung"},{"id":"semetey-1-2013:p1390:b003:l001","ordinal":182321,"en":"Holds perils in many places."},{"id":"semetey-1-2013:p1390:b003:l002","ordinal":182322,"en":"When your uncle Bakai speaks,"},{"id":"semetey-1-2013:p1390:b003:l003","ordinal":182323,"en":"He has words of countless kinds."},{"id":"semetey-1-2013:p1390:b003:l004","ordinal":182324,"en":"If we journey farther,"},{"id":"semetey-1-2013:p1390:b003:l005","ordinal":182325,"en":"I have a place where I can leave"},{"id":"semetey-1-2013:p1390:b003:l006","ordinal":182326,"en":"My dear boys with the baggage train!"},{"id":"semetey-1-2013:p1390:b003:l007","ordinal":182327,"en":"When I count the days of old,"},{"id":"semetey-1-2013:p1390:b003:l008","ordinal":182328,"en":"My insides burn and my liver is aflame;"},{"id":"semetey-1-2013:p1390:b003:l009","ordinal":182329,"en":"What does this Bakai hold within him,"},{"id":"semetey-1-2013:p1390:b003:l010","ordinal":182330,"en":"And what does he not!"},{"id":"semetey-1-2013:p1390:b003:l011","ordinal":182331,"en":"When I tell the tale of my earlier days,"},{"id":"semetey-1-2013:p1390:b003:l012","ordinal":182332,"en":"I seem to remember them."},{"id":"semetey-1-2013:p1390:b003:l013","ordinal":182333,"en":"When this wretched soul counts his companion,"},{"id":"semetey-1-2013:p1390:b003:l014","ordinal":182334,"en":"I wither and wither away!"},{"id":"semetey-1-2013:p1390:b003:l015","ordinal":182335,"en":"When I speak of my former days,"},{"id":"semetey-1-2013:p1390:b003:l016","ordinal":182336,"en":"With my beard white as a swan,"},{"id":"semetey-1-2013:p1390:b003:l017","ordinal":182337,"en":"At the time I leave on a journey,"},{"id":"semetey-1-2013:p1390:b003:l018","ordinal":182338,"en":"I seem to boast!"},{"id":"semetey-1-2013:p1390:b003:l019","ordinal":182339,"en":"There is the land of Beijing to strike,"},{"id":"semetey-1-2013:p1390:b003:l020","ordinal":182340,"en":"And a marvelous people for us to fight!"},{"id":"semetey-1-2013:p1390:b003:l021","ordinal":182341,"en":"If we leave the baggage train for six months,"},{"id":"semetey-1-2013:p1390:b003:l022","ordinal":182342,"en":"There is a place mortals long to see!"},{"id":"semetey-1-2013:p1390:b003:l023","ordinal":182343,"en":"There is a pass made secure,"},{"id":"semetey-1-2013:p1390:b003:l024","ordinal":182344,"en":"There is a place mortals do not see;"},{"id":"semetey-1-2013:p1390:b003:l025","ordinal":182345,"en":"I have a support on whom I can rely."},{"id":"semetey-1-2013:p1390:b003:l026","ordinal":182346,"en":"If we travel onward from here,"},{"id":"semetey-1-2013:p1390:b003:l027","ordinal":182347,"en":"Let me tell you the nature of the land:"},{"id":"semetey-1-2013:p1390:b003:l028","ordinal":182348,"en":"Pass follows pass,"},{"id":"semetey-1-2013:p1390:b003:l029","ordinal":182349,"en":"And low, rolling hills appear!"},{"id":"semetey-1-2013:p1390:b003:l030","ordinal":182350,"en":"Many a rounded mountain appears;"},{"id":"semetey-1-2013:p1390:b003:l031","ordinal":182351,"en":"If we travel along the mountain foot,"},{"id":"semetey-1-2013:p1390:b003:l032","ordinal":182352,"en":"We come to the lands of Kök-Suu and Kushtai."},{"id":"semetey-1-2013:p1390:b003:l033","ordinal":182353,"en":"We shall pass beyond those two;"},{"id":"semetey-1-2013:p1390:b003:l034","ordinal":182354,"en":"The twin ravines of Echki-Ölbös"},{"id":"semetey-1-2013:p1390:b003:l035","ordinal":182355,"en":"Rise with their ridges in view,"},{"id":"semetey-1-2013:p1390:b003:l036","ordinal":182356,"en":"And your mighty uncle Bakai's"},{"id":"semetey-1-2013:p1390:b003:l037","ordinal":182357,"en":"Heart will then be torn!"},{"id":"semetey-1-2013:p1390:b003:l038","ordinal":182358,"en":"When we climb that ridge,"},{"id":"semetey-1-2013:p1390:b003:l039","ordinal":182359,"en":"Its corners appear dim,"},{"id":"semetey-1-2013:p1390:b003:l040","ordinal":182360,"en":"And its peaks rise hazy!"},{"id":"semetey-1-2013:p1390:b004:l001","ordinal":182361,"en":"Bulging beyond the reach of sight,"},{"id":"semetey-1-2013:p1390:b004:l002","ordinal":182362,"en":"The mountain summit appears."},{"id":"semetey-1-2013:p1390:b004:l003","ordinal":182363,"en":"My dear foals,"},{"id":"semetey-1-2013:p1390:b004:l004","ordinal":182364,"en":"My heart is torn here!"},{"id":"semetey-1-2013:p1390:b004:l005","ordinal":182365,"en":"On a jutting mountain spur,"},{"id":"semetey-1-2013:p1390:b004:l006","ordinal":182366,"en":"Upon a hanging promontory,"},{"id":"semetey-1-2013:p1390:b004:l007","ordinal":182367,"en":"Are rugged black ridges—"},{"id":"semetey-1-2013:p1390:b004:l008","ordinal":182368,"en":"Here is a wondrous tale!"},{"id":"semetey-1-2013:p1390:b004:l009","ordinal":182369,"en":"There are Üch-Jyrgalang and Köngüz;"},{"id":"semetey-1-2013:p1390:b004:l010","ordinal":182370,"en":"If you see this place,"},{"id":"semetey-1-2013:p1390:b004:l011","ordinal":182371,"en":"It holds a whole, level world!"},{"id":"semetey-1-2013:p1390:b004:l012","ordinal":182372,"en":"There are wild boars in its forest,"},{"id":"semetey-1-2013:p1390:b004:l013","ordinal":182373,"en":"Red deer at its bends,"},{"id":"semetey-1-2013:p1390:b004:l014","ordinal":182374,"en":"Argali upon its hills,"},{"id":"semetey-1-2013:p1390:b004:l015","ordinal":182375,"en":"Foxes upon its plains,"},{"id":"semetey-1-2013:p1390:b004:l016","ordinal":182376,"en":"Tigers upon its ridges."},{"id":"semetey-1-2013:p1390:b004:l017","ordinal":182377,"en":"Lofty mountains rise jagged;"},{"id":"semetey-1-2013:p1390:b004:l018","ordinal":182378,"en":"Upon those heights dwell"},{"id":"semetey-1-2013:p1390:b004:l019","ordinal":182379,"en":"Wild goats and ibex!"},{"id":"semetey-1-2013:p1390:b004:l020","ordinal":182380,"en":"There are bears upon its slopes,"},{"id":"semetey-1-2013:p1390:b004:l021","ordinal":182381,"en":"And how many wondrous creatures."},{"id":"semetey-1-2013:p1390:b004:l022","ordinal":182382,"en":"There is snow upon its mountains,"},{"id":"semetey-1-2013:p1390:b004:l023","ordinal":182383,"en":"And rooks within its forests;"},{"id":"semetey-1-2013:p1390:b004:l024","ordinal":182384,"en":"Every living creature is there!"},{"id":"semetey-1-2013:p1390:b004:l025","ordinal":182385,"en":"What a wonder it is to behold:"},{"id":"semetey-1-2013:p1390:b004:l026","ordinal":182386,"en":"Its birds hatch in the birches;"},{"id":"semetey-1-2013:p1390:b004:l027","ordinal":182387,"en":"If you do not die, boys, you will see"},{"id":"semetey-1-2013:p1390:b004:l028","ordinal":182388,"en":"How they lash the air in flight."},{"id":"semetey-1-2013:p1390:b004:l029","ordinal":182389,"en":"Its birds hatch in the poplars,"},{"id":"semetey-1-2013:p1390:b004:l030","ordinal":182390,"en":"Driving the air with their wings!"},{"id":"semetey-1-2013:p1390:b004:l031","ordinal":182391,"en":"The breeds of game are scattered there;"},{"id":"semetey-1-2013:p1390:b004:l032","ordinal":182392,"en":"A brave man's heart opens,"},{"id":"semetey-1-2013:p1390:b004:l033","ordinal":182393,"en":"And an eager youth rejoices."},{"id":"semetey-1-2013:p1390:b004:l034","ordinal":182394,"en":"When bright dawn breaks,"},{"id":"semetey-1-2013:p1390:b004:l035","ordinal":182395,"en":"When light falls upon the earth,"},{"id":"semetey-1-2013:p1390:b004:l036","ordinal":182396,"en":"Geese, cranes, and demoiselle cranes"},{"id":"semetey-1-2013:p1390:b004:l037","ordinal":182397,"en":"Cry out loudly enough to split the ears!"},{"id":"semetey-1-2013:p1390:b004:l038","ordinal":182398,"en":"There are swans among its reeds;"},{"id":"semetey-1-2013:p1390:b004:l039","ordinal":182399,"en":"Ripe walnuts fill the ravines,"},{"id":"semetey-1-2013:p1390:b004:l040","ordinal":182400,"en":"And its apples lie in dark heaps;"},{"id":"semetey-1-2013:p1391:b003:l001","ordinal":182401,"en":"It was a land where people could travel."},{"id":"semetey-1-2013:p1391:b003:l002","ordinal":182402,"en":"The tops of its willows bent low;"},{"id":"semetey-1-2013:p1391:b003:l003","ordinal":182403,"en":"The surface of its sands lay finely traced."},{"id":"semetey-1-2013:p1391:b003:l004","ordinal":182404,"en":"Whoever saw it marveled,"},{"id":"semetey-1-2013:p1391:b003:l005","ordinal":182405,"en":"And any brave man rejoiced to see it!"},{"id":"semetey-1-2013:p1391:b003:l006","ordinal":182406,"en":"When you descend there, my boys,"},{"id":"semetey-1-2013:p1391:b003:l007","ordinal":182407,"en":"If you grow weary, your longing is eased:"},{"id":"semetey-1-2013:p1391:b003:l008","ordinal":182408,"en":"There are creatures of countless kinds!"},{"id":"semetey-1-2013:p1391:b003:l009","ordinal":182409,"en":"When a hero descends and enters,"},{"id":"semetey-1-2013:p1391:b003:l010","ordinal":182410,"en":"There lie Mangkan and Kordoi,"},{"id":"semetey-1-2013:p1391:b003:l011","ordinal":182411,"en":"And many choice lands."},{"id":"semetey-1-2013:p1391:b003:l012","ordinal":182412,"en":"Honor the words"},{"id":"semetey-1-2013:p1391:b003:l013","ordinal":182413,"en":"Your able uncle Bakai has spoken!"},{"id":"semetey-1-2013:p1391:b003:l014","ordinal":182414,"en":"While my dear one was alive,"},{"id":"semetey-1-2013:p1391:b003:l015","ordinal":182415,"en":"What did I not see,"},{"id":"semetey-1-2013:p1391:b003:l016","ordinal":182416,"en":"And what did I not learn!"},{"id":"semetey-1-2013:p1391:b003:l017","ordinal":182417,"en":"In wonders, festivities, and many games,"},{"id":"semetey-1-2013:p1391:b003:l018","ordinal":182418,"en":"How often I plunged and reveled!"},{"id":"semetey-1-2013:p1391:b003:l019","ordinal":182419,"en":"While my beloved Manas lived,"},{"id":"semetey-1-2013:p1391:b003:l020","ordinal":182420,"en":"From sunrise to sunset,"},{"id":"semetey-1-2013:p1391:b003:l021","ordinal":182421,"en":"I reconnoitered it all!"},{"id":"semetey-1-2013:p1391:b003:l022","ordinal":182422,"en":"While my noble Manas lived,"},{"id":"semetey-1-2013:p1391:b003:l023","ordinal":182423,"en":"I wore the flanks of my horse lean;"},{"id":"semetey-1-2013:p1391:b003:l024","ordinal":182424,"en":"Through the four corners of the world,"},{"id":"semetey-1-2013:p1391:b003:l025","ordinal":182425,"en":"I roamed and traveled!"},{"id":"semetey-1-2013:p1391:b003:l026","ordinal":182426,"en":"While my able Manas lived,"},{"id":"semetey-1-2013:p1391:b003:l027","ordinal":182427,"en":"Over mountains, rocks, and waters,"},{"id":"semetey-1-2013:p1391:b003:l028","ordinal":182428,"en":"Here am I, Bakai, who crossed them!"},{"id":"semetey-1-2013:p1391:b003:l029","ordinal":182429,"en":"To the end of the earth, to Jelpinish,"},{"id":"semetey-1-2013:p1391:b003:l030","ordinal":182430,"en":"And Beijing in the east—"},{"id":"semetey-1-2013:p1391:b003:l031","ordinal":182431,"en":"Here am I, Bakai, who saw them!"},{"id":"semetey-1-2013:p1391:b003:l032","ordinal":182432,"en":"Before the eyes of your uncle who saw them,"},{"id":"semetey-1-2013:p1391:b003:l033","ordinal":182433,"en":"Before your grandfather who saw so much,"},{"id":"semetey-1-2013:p1391:b003:l034","ordinal":182434,"en":"Was there anywhere beneath the sky"},{"id":"semetey-1-2013:p1391:b003:l035","ordinal":182435,"en":"That, while my able one lived,"},{"id":"semetey-1-2013:p1391:b003:l036","ordinal":182436,"en":"His gray tulpar did not tread?"},{"id":"semetey-1-2013:p1391:b003:l037","ordinal":182437,"en":"Was there any whole people"},{"id":"semetey-1-2013:p1391:b003:l038","ordinal":182438,"en":"Untouched by the point of his blue spear!"},{"id":"semetey-1-2013:p1391:b003:l039","ordinal":182439,"en":"Was there any wild place"},{"id":"semetey-1-2013:p1391:b003:l040","ordinal":182440,"en":"The pale falcon did not strike?"},{"id":"semetey-1-2013:p1391:b004:l001","ordinal":182441,"en":"While my companion Manas lived,"},{"id":"semetey-1-2013:p1391:b004:l002","ordinal":182442,"en":"Was there any whole people"},{"id":"semetey-1-2013:p1391:b004:l003","ordinal":182443,"en":"Untouched by Bakai's hand!"},{"id":"semetey-1-2013:p1391:b004:l004","ordinal":182444,"en":"Through the four corners of the world,"},{"id":"semetey-1-2013:p1391:b004:l005","ordinal":182445,"en":"Was it not Bakai who swept,"},{"id":"semetey-1-2013:p1391:b004:l006","ordinal":182446,"en":"Across the whole universe,"},{"id":"semetey-1-2013:p1391:b004:l007","ordinal":182447,"en":"Roaming far and wide—"},{"id":"semetey-1-2013:p1391:b004:l008","ordinal":182448,"en":"Was it not Bakai who traveled?"},{"id":"semetey-1-2013:p1391:b004:l009","ordinal":182449,"en":"Leaving no mountain, large or small,"},{"id":"semetey-1-2013:p1391:b004:l010","ordinal":182450,"en":"Leaving not half a spring or stream,"},{"id":"semetey-1-2013:p1391:b004:l011","ordinal":182451,"en":"While radiant Manas lived,"},{"id":"semetey-1-2013:p1391:b004:l012","ordinal":182452,"en":"Was it not Bakai who traveled them?"},{"id":"semetey-1-2013:p1391:b004:l013","ordinal":182453,"en":"He saw peoples in many lands,"},{"id":"semetey-1-2013:p1391:b004:l014","ordinal":182454,"en":"And lands in difficult places;"},{"id":"semetey-1-2013:p1391:b004:l015","ordinal":182455,"en":"He commanded the countless host."},{"id":"semetey-1-2013:p1391:b004:l016","ordinal":182456,"en":"This wretched world—"},{"id":"semetey-1-2013:p1391:b004:l017","ordinal":182457,"en":"Your auspicious uncle Bakai"},{"id":"semetey-1-2013:p1391:b004:l018","ordinal":182458,"en":"Surveyed it and left it behind!"},{"id":"semetey-1-2013:p1391:b004:l019","ordinal":182459,"en":"Scattering golden words from his mouth,"},{"id":"semetey-1-2013:p1391:b004:l020","ordinal":182460,"en":"Bakai goes onward;"},{"id":"semetey-1-2013:p1391:b004:l021","ordinal":182461,"en":"Along the familiar road he himself had seen,"},{"id":"semetey-1-2013:p1391:b004:l022","ordinal":182462,"en":"Bakai travels."},{"id":"semetey-1-2013:p1391:b004:l023","ordinal":182463,"en":"A great valley no man sees"},{"id":"semetey-1-2013:p1391:b004:l024","ordinal":182464,"en":"Bakai leaves behind;"},{"id":"semetey-1-2013:p1391:b004:l025","ordinal":182465,"en":"Through rugged mountain necks,"},{"id":"semetey-1-2013:p1391:b004:l026","ordinal":182466,"en":"Bakai leads the way."},{"id":"semetey-1-2013:p1391:b004:l027","ordinal":182467,"en":"All that your noble uncle Bakai"},{"id":"semetey-1-2013:p1391:b004:l028","ordinal":182468,"en":"Has said is true."},{"id":"semetey-1-2013:p1391:b004:l029","ordinal":182469,"en":"When he reaches the open plain,"},{"id":"semetey-1-2013:p1391:b004:l030","ordinal":182470,"en":"Its tortoises are as large as pitchers;"},{"id":"semetey-1-2013:p1391:b004:l031","ordinal":182471,"en":"Your uncle, elder Bakai,"},{"id":"semetey-1-2013:p1391:b004:l032","ordinal":182472,"en":"Mingles with the beasts,"},{"id":"semetey-1-2013:p1391:b004:l033","ordinal":182473,"en":"As though the two were born the same day."},{"id":"semetey-1-2013:p1391:b004:l034","ordinal":182474,"en":"It is a sheath fitted to a sword—"},{"id":"semetey-1-2013:p1391:b004:l035","ordinal":182475,"en":"This accursed, barren world;"},{"id":"semetey-1-2013:p1391:b004:l036","ordinal":182476,"en":"What precious Bakai has said"},{"id":"semetey-1-2013:p1391:b004:l037","ordinal":182477,"en":"Is no lie, but truth."},{"id":"semetey-1-2013:p1391:b004:l038","ordinal":182478,"en":"If told again, it is another tale;"},{"id":"semetey-1-2013:p1391:b004:l039","ordinal":182479,"en":"Can we tell it once again,"},{"id":"semetey-1-2013:p1391:b004:l040","ordinal":182480,"en":"Just as it was before?"},{"id":"semetey-1-2013:p1392:b004:l001","ordinal":182481,"en":"Two rode horseback and two went on foot—"},{"id":"semetey-1-2013:p1392:b004:l002","ordinal":182482,"en":"The journeying adventure"},{"id":"semetey-1-2013:p1392:b004:l003","ordinal":182483,"en":"Of the champion son of the gray wolf,"},{"id":"semetey-1-2013:p1392:b004:l004","ordinal":182484,"en":"Who set his course toward Beijing,"},{"id":"semetey-1-2013:p1392:b004:l005","ordinal":182485,"en":"The valiant man's bold exploit."},{"id":"semetey-1-2013:p1392:b004:l006","ordinal":182486,"en":"Along the road he himself had seen,"},{"id":"semetey-1-2013:p1392:b004:l007","ordinal":182487,"en":"Beside valleys, springs, and streams,"},{"id":"semetey-1-2013:p1392:b004:l008","ordinal":182488,"en":"Leading them on their way came"},{"id":"semetey-1-2013:p1392:b004:l009","ordinal":182489,"en":"Their remarkable uncle Bakai."},{"id":"semetey-1-2013:p1392:b004:l010","ordinal":182490,"en":"Their uncle, elder Bakai,"},{"id":"semetey-1-2013:p1392:b004:l011","ordinal":182491,"en":"Was an exceptionally knowing saint!"},{"id":"semetey-1-2013:p1392:b004:l012","ordinal":182492,"en":"His words were clear while he lived;"},{"id":"semetey-1-2013:p1392:b004:l013","ordinal":182493,"en":"Bakai, a judge of warriors,"},{"id":"semetey-1-2013:p1392:b004:l014","ordinal":182494,"en":"Was clairvoyant in this world."},{"id":"semetey-1-2013:p1392:b004:l015","ordinal":182495,"en":"His speech was open and plain,"},{"id":"semetey-1-2013:p1392:b004:l016","ordinal":182496,"en":"A resourceful saint,"},{"id":"semetey-1-2013:p1392:b004:l017","ordinal":182497,"en":"Your uncle, elder Bakai!"},{"id":"semetey-1-2013:p1392:b004:l018","ordinal":182498,"en":"Crossing lands of many kinds,"},{"id":"semetey-1-2013:p1392:b004:l019","ordinal":182499,"en":"Passing three successive ridges,"},{"id":"semetey-1-2013:p1392:b004:l020","ordinal":182500,"en":"How could your valiant man hold back?"},{"id":"semetey-1-2013:p1392:b004:l021","ordinal":182501,"en":"Ögüz-Ashuu and Tai-Ashuu,"},{"id":"semetey-1-2013:p1392:b004:l022","ordinal":182502,"en":"The six successive Chon-Chapky passes—"},{"id":"semetey-1-2013:p1392:b004:l023","ordinal":182503,"en":"He reached the broad valley."},{"id":"semetey-1-2013:p1392:b004:l024","ordinal":182504,"en":"Kichi-Jyldyz and Chon-Jyldyz—"},{"id":"semetey-1-2013:p1392:b004:l025","ordinal":182505,"en":"He crossed the two Jyldyz lands,"},{"id":"semetey-1-2013:p1392:b004:l026","ordinal":182506,"en":"Into the hollow of Kichi-Jyldyz,"},{"id":"semetey-1-2013:p1392:b004:l027","ordinal":182507,"en":"Along the Kara-Suu,"},{"id":"semetey-1-2013:p1392:b004:l028","ordinal":182508,"en":"To Chatkal with its winding ford,"},{"id":"semetey-1-2013:p1392:b004:l029","ordinal":182509,"en":"Where the former host had gathered"},{"id":"semetey-1-2013:p1392:b004:l030","ordinal":182510,"en":"And marched in a winding column."},{"id":"semetey-1-2013:p1392:b004:l031","ordinal":182511,"en":"On the qibla side stood Boz-Döbö,"},{"id":"semetey-1-2013:p1392:b004:l032","ordinal":182512,"en":"Where wretched Manas and his forty companions,"},{"id":"semetey-1-2013:p1392:b004:l033","ordinal":182513,"en":"Reveling wildly and raising dust,"},{"id":"semetey-1-2013:p1392:b004:l034","ordinal":182514,"en":"Used to play ordo."},{"id":"semetey-1-2013:p1392:b004:l035","ordinal":182515,"en":"Within that ordo ground"},{"id":"semetey-1-2013:p1392:b004:l036","ordinal":182516,"en":"Were the khan's knucklebone and all the rest,"},{"id":"semetey-1-2013:p1392:b005:l001","ordinal":182517,"en":"Everything left behind"},{"id":"semetey-1-2013:p1392:b005:l002","ordinal":182518,"en":"By the bloodthirsty holy prince!"},{"id":"semetey-1-2013:p1392:b005:l003","ordinal":182519,"en":"At the nape of Boz-Döbö,"},{"id":"semetey-1-2013:p1392:b005:l004","ordinal":182520,"en":"At the place called Kejige, he halted;"},{"id":"semetey-1-2013:p1392:b005:l005","ordinal":182521,"en":"In his grief, your uncle"},{"id":"semetey-1-2013:p1392:b005:l006","ordinal":182522,"en":"Lamented the hero sultan."},{"id":"semetey-1-2013:p1392:b005:l007","ordinal":182523,"en":"He began with sorrowful words,"},{"id":"semetey-1-2013:p1392:b005:l008","ordinal":182524,"en":"And began to voice his grief!"},{"id":"semetey-1-2013:p1392:b005:l009","ordinal":182525,"en":"“With my paired sable cap"},{"id":"semetey-1-2013:p1392:b005:l010","ordinal":182526,"en":"Swaying upon my head,"},{"id":"semetey-1-2013:p1392:b005:l011","ordinal":182527,"en":"While we joined Manas in lament and song,"},{"id":"semetey-1-2013:p1392:b005:l012","ordinal":182528,"en":"In the days when I lived in joy,"}]
