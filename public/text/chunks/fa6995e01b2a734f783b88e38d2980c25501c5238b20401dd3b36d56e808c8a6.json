[{"id":"semetey-1-2013:p0968:b004:l015","ordinal":150017,"en":"Collapsed and crawled away;"},{"id":"semetey-1-2013:p0968:b004:l016","ordinal":150018,"en":"From beneath her blue patterned silk dress"},{"id":"semetey-1-2013:p0968:b004:l017","ordinal":150019,"en":"Her blood streamed down its hem."},{"id":"semetey-1-2013:p0968:b004:l018","ordinal":150020,"en":"The flesh of her side was torn,"},{"id":"semetey-1-2013:p0968:b004:l019","ordinal":150021,"en":"And your poor, delicate sister-in-law"},{"id":"semetey-1-2013:p0968:b004:l020","ordinal":150022,"en":"Fled inside screaming."},{"id":"semetey-1-2013:p0968:b004:l021","ordinal":150023,"en":"Her forefather was Tügöl Khan,"},{"id":"semetey-1-2013:p0968:b004:l022","ordinal":150024,"en":"Blessed from his roots by Kydyr;"},{"id":"semetey-1-2013:p0968:b004:l023","ordinal":150025,"en":"He had brought the woman to submission."},{"id":"semetey-1-2013:p0968:b004:l024","ordinal":150026,"en":"As for the blue-maned champion"},{"id":"semetey-1-2013:p0968:b004:l025","ordinal":150027,"en":"Born after his father, the hero Manas,"},{"id":"semetey-1-2013:p0968:b004:l026","ordinal":150028,"en":"He wore out horses and ranged the land,"},{"id":"semetey-1-2013:p0968:b004:l027","ordinal":150029,"en":"Loosed his hounds and flew his birds,"},{"id":"semetey-1-2013:p0968:b004:l028","ordinal":150030,"en":"And wandered about in revelry."},{"id":"semetey-1-2013:p0968:b004:l029","ordinal":150031,"en":"The delicate woman Chachykey,"},{"id":"semetey-1-2013:p0968:b004:l030","ordinal":150032,"en":"From her softly gleaming eyes,"},{"id":"semetey-1-2013:p0968:b004:l031","ordinal":150033,"en":"Shed tears in separate streams;"},{"id":"semetey-1-2013:p0968:b004:l032","ordinal":150034,"en":"She screamed and wept and cried aloud,"},{"id":"semetey-1-2013:p0968:b004:l033","ordinal":150035,"en":"Truly wept and sobbed,"},{"id":"semetey-1-2013:p0968:b004:l034","ordinal":150036,"en":"And cried out in anguish."},{"id":"semetey-1-2013:p0968:b004:l035","ordinal":150037,"en":"She called Kulchoro and Kanchoro,"},{"id":"semetey-1-2013:p0968:b004:l036","ordinal":150038,"en":"Summoning both of them together;"},{"id":"semetey-1-2013:p0968:b004:l037","ordinal":150039,"en":"What your poor, delicate sister-in-law"},{"id":"semetey-1-2013:p0968:b004:l038","ordinal":150040,"en":"Said to them was this—"},{"id":"semetey-1-2013:p0968:b004:l039","ordinal":150041,"en":"When the two boys came to her,"}]
