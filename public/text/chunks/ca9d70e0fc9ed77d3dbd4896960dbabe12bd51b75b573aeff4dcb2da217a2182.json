[{"id":"semetey-1-2013:p1355:b005:l026","ordinal":179713,"en":"Far finer than all"},{"id":"semetey-1-2013:p1355:b005:l027","ordinal":179714,"en":"My noble hero had possessed,"},{"id":"semetey-1-2013:p1355:b005:l028","ordinal":179715,"en":"I fitted the ak-olpok armor."},{"id":"semetey-1-2013:p1355:b005:l029","ordinal":179716,"en":"I wearied the eyes that stared at it."},{"id":"semetey-1-2013:p1355:b005:l030","ordinal":179717,"en":"Having steel filed and the Albar's blade"},{"id":"semetey-1-2013:p1355:b005:l031","ordinal":179718,"en":"Ground entirely fine,"},{"id":"semetey-1-2013:p1355:b005:l032","ordinal":179719,"en":"I had it placed between the layers."},{"id":"semetey-1-2013:p1355:b005:l033","ordinal":179720,"en":"I adorned it with gold,"},{"id":"semetey-1-2013:p1355:b005:l034","ordinal":179721,"en":"Lest a spear pierce through"},{"id":"semetey-1-2013:p1355:b005:l035","ordinal":179722,"en":"Any place between its layers."},{"id":"semetey-1-2013:p1355:b005:l036","ordinal":179723,"en":"I slid slender rods through it."},{"id":"semetey-1-2013:p1355:b005:l037","ordinal":179724,"en":"I patched whatever had worn out;"},{"id":"semetey-1-2013:p1355:b005:l038","ordinal":179725,"en":"Resting neither by day"},{"id":"semetey-1-2013:p1355:b005:l039","ordinal":179726,"en":"Nor sleeping at night,"},{"id":"semetey-1-2013:p1356:b003:l001","ordinal":179727,"en":"I fitted it anew from the beginning."},{"id":"semetey-1-2013:p1356:b003:l002","ordinal":179728,"en":"I had ornament set upon its collar"},{"id":"semetey-1-2013:p1356:b003:l003","ordinal":179729,"en":"And wound it in twelve layers."},{"id":"semetey-1-2013:p1356:b003:l004","ordinal":179730,"en":"For the clash with the teeming infidel,"},{"id":"semetey-1-2013:p1356:b003:l005","ordinal":179731,"en":"With hero Khan Kongurbai,"},{"id":"semetey-1-2013:p1356:b003:l006","ordinal":179732,"en":"I intended it!"},{"id":"semetey-1-2013:p1356:b003:l007","ordinal":179733,"en":"So they might stand face-to-face,"},{"id":"semetey-1-2013:p1356:b003:l008","ordinal":179734,"en":"Firing guns and drawing bows,"},{"id":"semetey-1-2013:p1356:b003:l009","ordinal":179735,"en":"And throw themselves into the shooting;"},{"id":"semetey-1-2013:p1356:b003:l010","ordinal":179736,"en":"I repaired what was chipped,"},{"id":"semetey-1-2013:p1356:b003:l011","ordinal":179737,"en":"So the spear of that swine,"},{"id":"semetey-1-2013:p1356:b003:l012","ordinal":179738,"en":"The khan of the Kechil, could not pass through."},{"id":"semetey-1-2013:p1356:b003:l013","ordinal":179739,"en":"I, unfortunate Kanykey,"},{"id":"semetey-1-2013:p1356:b003:l014","ordinal":179740,"en":"Truly repaired the ak-olpok armor"},{"id":"semetey-1-2013:p1356:b003:l015","ordinal":179741,"en":"Left by Manas!"},{"id":"semetey-1-2013:p1356:b003:l016","ordinal":179742,"en":"The heroic khan's ak-olpok armor—"},{"id":"semetey-1-2013:p1356:b003:l017","ordinal":179743,"en":"So my valiant orphan might wear it,"},{"id":"semetey-1-2013:p1356:b003:l018","ordinal":179744,"en":"Might face and strike the enemy,"},{"id":"semetey-1-2013:p1356:b003:l019","ordinal":179745,"en":"Drive the opposing Kalcha"},{"id":"semetey-1-2013:p1356:b003:l020","ordinal":179746,"en":"As far as the khagan,"},{"id":"semetey-1-2013:p1356:b003:l021","ordinal":179747,"en":"And drive the heroes he faced"},{"id":"semetey-1-2013:p1356:b003:l022","ordinal":179748,"en":"Into Beijing;"},{"id":"semetey-1-2013:p1356:b003:l023","ordinal":179749,"en":"So upon the teeming khagan"},{"id":"semetey-1-2013:p1356:b003:l024","ordinal":179750,"en":"He might bring utter turmoil;"},{"id":"semetey-1-2013:p1356:b003:l025","ordinal":179751,"en":"So my young son of the bloodthirsty hero"},{"id":"semetey-1-2013:p1356:b003:l026","ordinal":179752,"en":"Might avenge himself upon the bloodthirsty foe;"},{"id":"semetey-1-2013:p1356:b003:l027","ordinal":179753,"en":"If a Kalcha fell into his hands,"},{"id":"semetey-1-2013:p1356:b003:l028","ordinal":179754,"en":"He might drag him along the road"},{"id":"semetey-1-2013:p1356:b003:l029","ordinal":179755,"en":"And display him to the Dungans;"},{"id":"semetey-1-2013:p1356:b003:l030","ordinal":179756,"en":"So if his doom came, he might die,"},{"id":"semetey-1-2013:p1356:b003:l031","ordinal":179757,"en":"And campaign against"},{"id":"semetey-1-2013:p1356:b003:l032","ordinal":179758,"en":"The teeming Chinese;"},{"id":"semetey-1-2013:p1356:b003:l033","ordinal":179759,"en":"There were many wonders when I gave it,"},{"id":"semetey-1-2013:p1356:b003:l034","ordinal":179760,"en":"So my valiant son might see them."},{"id":"semetey-1-2013:p1356:b003:l035","ordinal":179761,"en":"At that difficult time,"},{"id":"semetey-1-2013:p1356:b003:l036","ordinal":179762,"en":"Your mighty mother Kanykey"},{"id":"semetey-1-2013:p1356:b003:l037","ordinal":179763,"en":"Brought forth an article."},{"id":"semetey-1-2013:p1356:b003:l038","ordinal":179764,"en":"Your dear mother Kanykey"},{"id":"semetey-1-2013:p1356:b003:l039","ordinal":179765,"en":"Made her motherhood known:"},{"id":"semetey-1-2013:p1356:b004:l001","ordinal":179766,"en":"She clothed him in ak-olpok armor"},{"id":"semetey-1-2013:p1356:b004:l002","ordinal":179767,"en":"That no bullet pierced in battle."},{"id":"semetey-1-2013:p1356:b004:l003","ordinal":179768,"en":"The blue saddlebag she brought—"},{"id":"semetey-1-2013:p1356:b004:l004","ordinal":179769,"en":"The blue saddlebag bore no pattern;"},{"id":"semetey-1-2013:p1356:b004:l005","ordinal":179770,"en":"Inside the white saddlebag,"},{"id":"semetey-1-2013:p1356:b004:l006","ordinal":179771,"en":"What was there, and what was not!"},{"id":"semetey-1-2013:p1356:b004:l007","ordinal":179772,"en":"Many champions lifted it;"},{"id":"semetey-1-2013:p1356:b004:l008","ordinal":179773,"en":"Men marveled at the service"},{"id":"semetey-1-2013:p1356:b004:l009","ordinal":179774,"en":"Of your dear, formidable mother."},{"id":"semetey-1-2013:p1356:b004:l010","ordinal":179775,"en":"It held coats of separate kinds;"},{"id":"semetey-1-2013:p1356:b004:l011","ordinal":179776,"en":"Inside that saddlebag"},{"id":"semetey-1-2013:p1356:b004:l012","ordinal":179777,"en":"Were wonders no one had seen."},{"id":"semetey-1-2013:p1356:b004:l013","ordinal":179778,"en":"Your exceptional mother Kanykey,"},{"id":"semetey-1-2013:p1356:b004:l014","ordinal":179779,"en":"Bending her wisdom and pondering,"},{"id":"semetey-1-2013:p1356:b004:l015","ordinal":179780,"en":"Knew he would reach Kakan-Chyn's Beijing"},{"id":"semetey-1-2013:p1356:b004:l016","ordinal":179781,"en":"And grapple there;"},{"id":"semetey-1-2013:p1356:b004:l017","ordinal":179782,"en":"If battle arose suddenly,"},{"id":"semetey-1-2013:p1356:b004:l018","ordinal":179783,"en":"If death came by chance,"},{"id":"semetey-1-2013:p1356:b004:l019","ordinal":179784,"en":"She thought a stray bullet might pass."},{"id":"semetey-1-2013:p1356:b004:l020","ordinal":179785,"en":"Showing her skill,"},{"id":"semetey-1-2013:p1356:b004:l021","ordinal":179786,"en":"She clothed your lion uncle Bakai"},{"id":"semetey-1-2013:p1356:b004:l022","ordinal":179787,"en":"In bulletproof armor."},{"id":"semetey-1-2013:p1356:b004:l023","ordinal":179788,"en":"“Long ago I knew"},{"id":"semetey-1-2013:p1356:b004:l024","ordinal":179789,"en":"Of the costly campaign to Beijing,"},{"id":"semetey-1-2013:p1356:b004:l025","ordinal":179790,"en":"And had prepared many pieces"},{"id":"semetey-1-2013:p1356:b004:l026","ordinal":179791,"en":"Of bulletproof clothing."},{"id":"semetey-1-2013:p1356:b004:l027","ordinal":179792,"en":"So against the teeming infidel,"},{"id":"semetey-1-2013:p1356:b004:l028","ordinal":179793,"en":"Against hero Khan Kongurbai,"},{"id":"semetey-1-2013:p1356:b004:l029","ordinal":179794,"en":"He might fight without fleeing;"},{"id":"semetey-1-2013:p1356:b004:l030","ordinal":179795,"en":"Taking no heed of death,"},{"id":"semetey-1-2013:p1356:b004:l031","ordinal":179796,"en":"Never stopping to say, ‘I shall die,’"},{"id":"semetey-1-2013:p1356:b004:l032","ordinal":179797,"en":"He might press the conflict to its limit;"},{"id":"semetey-1-2013:p1356:b004:l033","ordinal":179798,"en":"Against the overbearing Kalcha"},{"id":"semetey-1-2013:p1356:b004:l034","ordinal":179799,"en":"He might go sharp and resolute,"},{"id":"semetey-1-2013:p1356:b004:l035","ordinal":179800,"en":"Roaring in wrath,"},{"id":"semetey-1-2013:p1356:b004:l036","ordinal":179801,"en":"Raising the battle cry of his royal father Manas,"},{"id":"semetey-1-2013:p1356:b004:l037","ordinal":179802,"en":"He might strike the foe without fleeing,"},{"id":"semetey-1-2013:p1356:b004:l038","ordinal":179803,"en":"And enter battle without tiring."},{"id":"semetey-1-2013:p1356:b004:l039","ordinal":179804,"en":"If they stand face-to-face,"},{"id":"semetey-1-2013:p1357:b003:l001","ordinal":179805,"en":"Holding each other's reins,"},{"id":"semetey-1-2013:p1357:b003:l002","ordinal":179806,"en":"Fighting face-to-face,"},{"id":"semetey-1-2013:p1357:b003:l003","ordinal":179807,"en":"Shouting and striking with axes,"},{"id":"semetey-1-2013:p1357:b003:l004","ordinal":179808,"en":"Grappling from the very hem,"},{"id":"semetey-1-2013:p1357:b003:l005","ordinal":179809,"en":"Until they exhaust one another—"},{"id":"semetey-1-2013:p1357:b003:l006","ordinal":179810,"en":"It would be vain if I failed to foresee it."},{"id":"semetey-1-2013:p1357:b003:l007","ordinal":179811,"en":"If I failed to foresee this affair,"},{"id":"semetey-1-2013:p1357:b003:l008","ordinal":179812,"en":"An axe or sword might pass through,"},{"id":"semetey-1-2013:p1357:b003:l009","ordinal":179813,"en":"And needless death might overtake him."},{"id":"semetey-1-2013:p1357:b003:l010","ordinal":179814,"en":"I had its inside lined with silk;"},{"id":"semetey-1-2013:p1357:b003:l011","ordinal":179815,"en":"Its four sides were wondrous—"},{"id":"semetey-1-2013:p1357:b003:l012","ordinal":179816,"en":"I had them reinforced with sharp steel,"},{"id":"semetey-1-2013:p1357:b003:l013","ordinal":179817,"en":"Cast from yellow gold"},{"id":"semetey-1-2013:p1357:b003:l014","ordinal":179818,"en":"And placed within its middle."},{"id":"semetey-1-2013:p1357:b003:l015","ordinal":179819,"en":"For seven years I watched and repaired it,"},{"id":"semetey-1-2013:p1357:b003:l016","ordinal":179820,"en":"Intending it for the battle"},{"id":"semetey-1-2013:p1357:b003:l017","ordinal":179821,"en":"Of my renowned son."},{"id":"semetey-1-2013:p1357:b003:l018","ordinal":179822,"en":"A deep-blue iron helmet"},{"id":"semetey-1-2013:p1357:b003:l019","ordinal":179823,"en":"And coat of mail, for him to wear together;"},{"id":"semetey-1-2013:p1357:b003:l020","ordinal":179824,"en":"So he might cross their fastenings"},{"id":"semetey-1-2013:p1357:b003:l021","ordinal":179825,"en":"And tie them beneath his throat;"},{"id":"semetey-1-2013:p1357:b003:l022","ordinal":179826,"en":"So he might know this service."},{"id":"semetey-1-2013:p1357:b003:l023","ordinal":179827,"en":"It is indeed true that possessions"},{"id":"semetey-1-2013:p1357:b003:l024","ordinal":179828,"en":"Are the protection of a life held in trust;"},{"id":"semetey-1-2013:p1357:b003:l025","ordinal":179829,"en":"It is also true that a sharp weapon"},{"id":"semetey-1-2013:p1357:b003:l026","ordinal":179830,"en":"Shatters when struck against it."},{"id":"semetey-1-2013:p1357:b003:l027","ordinal":179831,"en":"I have been making these things;"},{"id":"semetey-1-2013:p1357:b003:l028","ordinal":179832,"en":"Hear of this labor of mine!"},{"id":"semetey-1-2013:p1357:b003:l029","ordinal":179833,"en":"Know the value of it when you go,"},{"id":"semetey-1-2013:p1357:b003:l030","ordinal":179834,"en":"And say, ‘My mother suffered hardship!’"},{"id":"semetey-1-2013:p1357:b003:l031","ordinal":179835,"en":"A true helmet and coat of mail—"},{"id":"semetey-1-2013:p1357:b003:l032","ordinal":179836,"en":"My valiant son, wear them when you go!"},{"id":"semetey-1-2013:p1357:b003:l033","ordinal":179837,"en":"I, your unfortunate mother,"},{"id":"semetey-1-2013:p1357:b003:l034","ordinal":179838,"en":"Have many kinds of armor;"},{"id":"semetey-1-2013:p1357:b003:l035","ordinal":179839,"en":"To give you, my son,"},{"id":"semetey-1-2013:p1357:b003:l036","ordinal":179840,"en":"I have many kinds of wonders."},{"id":"semetey-1-2013:p1357:b003:l037","ordinal":179841,"en":"My heart is shut in grief, my soul aflame;"},{"id":"semetey-1-2013:p1357:b003:l038","ordinal":179842,"en":"In this mother's hands,"},{"id":"semetey-1-2013:p1357:b003:l039","ordinal":179843,"en":"What is there, and what is not!"},{"id":"semetey-1-2013:p1357:b004:l001","ordinal":179844,"en":"That you would grapple with the khagan,"},{"id":"semetey-1-2013:p1357:b004:l002","ordinal":179845,"en":"And stand unleashing turmoil,"},{"id":"semetey-1-2013:p1357:b004:l003","ordinal":179846,"en":"Bringing fierce upheaval,"},{"id":"semetey-1-2013:p1357:b004:l004","ordinal":179847,"en":"That you would campaign"},{"id":"semetey-1-2013:p1357:b004:l005","ordinal":179848,"en":"Against Kakan-Chyn's Beijing—"},{"id":"semetey-1-2013:p1357:b004:l006","ordinal":179849,"en":"I knew it long ago!"},{"id":"semetey-1-2013:p1357:b004:l007","ordinal":179850,"en":"So my orphan with his noble calling might wear it,"},{"id":"semetey-1-2013:p1357:b004:l008","ordinal":179851,"en":"I had prepared many pieces!"},{"id":"semetey-1-2013:p1357:b004:l009","ordinal":179852,"en":"As I stood pondering,"},{"id":"semetey-1-2013:p1357:b004:l010","ordinal":179853,"en":"On account of my youthful son,"},{"id":"semetey-1-2013:p1357:b004:l011","ordinal":179854,"en":"God's sun darkened in the sky;"},{"id":"semetey-1-2013:p1357:b004:l012","ordinal":179855,"en":"Sixty worries came upon my head at once."},{"id":"semetey-1-2013:p1357:b004:l013","ordinal":179856,"en":"My hair twisted like reins;"},{"id":"semetey-1-2013:p1357:b004:l014","ordinal":179857,"en":"Yesterday, unable to stand from true grief,"},{"id":"semetey-1-2013:p1357:b004:l015","ordinal":179858,"en":"I summoned the lame smith Bölökbai"},{"id":"semetey-1-2013:p1357:b004:l016","ordinal":179859,"en":"And forty Kalcha craftsmen."},{"id":"semetey-1-2013:p1357:b004:l017","ordinal":179860,"en":"I had them wear the jekeybos coat;"},{"id":"semetey-1-2013:p1357:b004:l018","ordinal":179861,"en":"I, wretched and resourceful,"},{"id":"semetey-1-2013:p1357:b004:l019","ordinal":179862,"en":"Mounted them on ambling horses that did not gallop,"},{"id":"semetey-1-2013:p1357:b004:l020","ordinal":179863,"en":"And had them search the whole earth."},{"id":"semetey-1-2013:p1357:b004:l021","ordinal":179864,"en":"I had heard much from those who had seen"},{"id":"semetey-1-2013:p1357:b004:l022","ordinal":179865,"en":"The ibex of Jetik-Too,"},{"id":"semetey-1-2013:p1357:b004:l023","ordinal":179866,"en":"And from all who knew"},{"id":"semetey-1-2013:p1357:b004:l024","ordinal":179867,"en":"That nowhere was there any hide"},{"id":"semetey-1-2013:p1357:b004:l025","ordinal":179868,"en":"Like its hide."},{"id":"semetey-1-2013:p1357:b004:l026","ordinal":179869,"en":"I loaded provisions on camels,"},{"id":"semetey-1-2013:p1357:b004:l027","ordinal":179870,"en":"And had the mountain ibex of Jetkileng"},{"id":"semetey-1-2013:p1357:b004:l028","ordinal":179871,"en":"Shot after they went to Jet-Kait."},{"id":"semetey-1-2013:p1357:b004:l029","ordinal":179872,"en":"Keeping it from the eye of the sun,"},{"id":"semetey-1-2013:p1357:b004:l030","ordinal":179873,"en":"I laid it in the shade;"},{"id":"semetey-1-2013:p1357:b004:l031","ordinal":179874,"en":"I, wretched woman, seasoned its hide,"},{"id":"semetey-1-2013:p1357:b004:l032","ordinal":179875,"en":"Resting neither by day"},{"id":"semetey-1-2013:p1357:b004:l033","ordinal":179876,"en":"Nor sleeping at night."},{"id":"semetey-1-2013:p1357:b004:l034","ordinal":179877,"en":"I had it worked by my own hand;"},{"id":"semetey-1-2013:p1357:b004:l035","ordinal":179878,"en":"Lest its curing remain incomplete,"},{"id":"semetey-1-2013:p1357:b004:l036","ordinal":179879,"en":"I had exactly eighty-five strong men"},{"id":"semetey-1-2013:p1357:b004:l037","ordinal":179880,"en":"Work it without pause for six months,"},{"id":"semetey-1-2013:p1357:b004:l038","ordinal":179881,"en":"Bringing its curing to perfection,"},{"id":"semetey-1-2013:p1357:b004:l039","ordinal":179882,"en":"And had skilled men cut it,"},{"id":"semetey-1-2013:p1358:b003:l001","ordinal":179883,"en":"The ill-fated hide"},{"id":"semetey-1-2013:p1358:b003:l002","ordinal":179884,"en":"Folded bellywise like a snake."},{"id":"semetey-1-2013:p1358:b003:l003","ordinal":179885,"en":"I gathered every seamstress"},{"id":"semetey-1-2013:p1358:b003:l004","ordinal":179886,"en":"And had it sewn with tiny stitches;"},{"id":"semetey-1-2013:p1358:b003:l005","ordinal":179887,"en":"I had skilled workers test it,"},{"id":"semetey-1-2013:p1358:b003:l006","ordinal":179888,"en":"And lined its inside with silk."},{"id":"semetey-1-2013:p1358:b003:l007","ordinal":179889,"en":"Forty Kyrgyz daughters-in-law"},{"id":"semetey-1-2013:p1358:b003:l008","ordinal":179890,"en":"Bit and tightened its seams;"},{"id":"semetey-1-2013:p1358:b003:l009","ordinal":179891,"en":"I had them reject what was unsuitable,"},{"id":"semetey-1-2013:p1358:b003:l010","ordinal":179892,"en":"File down steel,"},{"id":"semetey-1-2013:p1358:b003:l011","ordinal":179893,"en":"And pour it between the layers."},{"id":"semetey-1-2013:p1358:b003:l012","ordinal":179894,"en":"The sight of it satisfied the eye;"},{"id":"semetey-1-2013:p1358:b003:l013","ordinal":179895,"en":"I fitted and repaired it,"},{"id":"semetey-1-2013:p1358:b003:l014","ordinal":179896,"en":"So a thrusting spear would not pass."},{"id":"semetey-1-2013:p1358:b003:l015","ordinal":179897,"en":"I intended it for the conflict"},{"id":"semetey-1-2013:p1358:b003:l016","ordinal":179898,"en":"With hero Khan Kongurbai!"},{"id":"semetey-1-2013:p1358:b003:l017","ordinal":179899,"en":"When Kandagai is gripped and pulled,"},{"id":"semetey-1-2013:p1358:b003:l018","ordinal":179900,"en":"It stretches like glue;"},{"id":"semetey-1-2013:p1358:b003:l019","ordinal":179901,"en":"When Kandagai is released,"},{"id":"semetey-1-2013:p1358:b003:l020","ordinal":179902,"en":"It gathers like a tendon."},{"id":"semetey-1-2013:p1358:b003:l021","ordinal":179903,"en":"The sight of it satisfies the heart;"},{"id":"semetey-1-2013:p1358:b003:l022","ordinal":179904,"en":"If struck with a shout,"},{"id":"semetey-1-2013:p1358:b003:l023","ordinal":179905,"en":"Even a thrusting spear will not pass,"},{"id":"semetey-1-2013:p1358:b003:l024","ordinal":179906,"en":"And the hand gripping it grows weary."},{"id":"semetey-1-2013:p1358:b003:l025","ordinal":179907,"en":"If an Ochogor gun fires, its bullet will not pass,"},{"id":"semetey-1-2013:p1358:b003:l026","ordinal":179908,"en":"But lodges within its middle."},{"id":"semetey-1-2013:p1358:b003:l027","ordinal":179909,"en":"With a golden border at its rim,"},{"id":"semetey-1-2013:p1358:b003:l028","ordinal":179910,"en":"The ill-fated Kandagai,"},{"id":"semetey-1-2013:p1358:b003:l029","ordinal":179911,"en":"All of its wrist guards"},{"id":"semetey-1-2013:p1358:b003:l030","ordinal":179912,"en":"Were embroidered in pure gold."},{"id":"semetey-1-2013:p1358:b003:l031","ordinal":179913,"en":"I worked twin spade-shaped ornaments into it;"},{"id":"semetey-1-2013:p1358:b003:l032","ordinal":179914,"en":"So its seams would not come apart,"},{"id":"semetey-1-2013:p1358:b003:l033","ordinal":179915,"en":"I wrapped them with yellow gold."},{"id":"semetey-1-2013:p1358:b003:l034","ordinal":179916,"en":"Beijing was a formidable place,"},{"id":"semetey-1-2013:p1358:b003:l035","ordinal":179917,"en":"Its people wicked and dangerous;"},{"id":"semetey-1-2013:p1358:b003:l036","ordinal":179918,"en":"If they stood facing one another,"},{"id":"semetey-1-2013:p1358:b003:l037","ordinal":179919,"en":"Firing guns and drawing bows,"},{"id":"semetey-1-2013:p1358:b003:l038","ordinal":179920,"en":"And fought with all their might,"},{"id":"semetey-1-2013:p1358:b003:l039","ordinal":179921,"en":"Arrowheads would shriek,"},{"id":"semetey-1-2013:p1358:b004:l001","ordinal":179922,"en":"Their points of impact burst apart,"},{"id":"semetey-1-2013:p1358:b004:l002","ordinal":179923,"en":"And spilled blood gush."},{"id":"semetey-1-2013:p1358:b004:l003","ordinal":179924,"en":"Lest needless death overtake him,"},{"id":"semetey-1-2013:p1358:b004:l004","ordinal":179925,"en":"And he leave this world clear-eyed"},{"id":"semetey-1-2013:p1358:b004:l005","ordinal":179926,"en":"Yet filled with regret,"},{"id":"semetey-1-2013:p1358:b004:l006","ordinal":179927,"en":"Costly Kandagai—"},{"id":"semetey-1-2013:p1358:b004:l007","ordinal":179928,"en":"I have been making it."},{"id":"semetey-1-2013:p1358:b004:l008","ordinal":179929,"en":"My precious orphan, listen well!"},{"id":"semetey-1-2013:p1358:b004:l009","ordinal":179930,"en":"Many strong men worked and softened it;"},{"id":"semetey-1-2013:p1358:b004:l010","ordinal":179931,"en":"If you take it to Beijing, there will be great conflict!"},{"id":"semetey-1-2013:p1358:b004:l011","ordinal":179932,"en":"Its opening has a broad border;"},{"id":"semetey-1-2013:p1358:b004:l012","ordinal":179933,"en":"If you wear it in battle, my foal,"},{"id":"semetey-1-2013:p1358:b004:l013","ordinal":179934,"en":"It is a shield for your entrusted life!"},{"id":"semetey-1-2013:p1358:b004:l014","ordinal":179935,"en":"Receiving messages from many places,"},{"id":"semetey-1-2013:p1358:b004:l015","ordinal":179936,"en":"My orphan, my support—"},{"id":"semetey-1-2013:p1358:b004:l016","ordinal":179937,"en":"Wondering whether he would remain safe,"},{"id":"semetey-1-2013:p1358:b004:l017","ordinal":179938,"en":"I specially kept preparing it!"},{"id":"semetey-1-2013:p1358:b004:l018","ordinal":179939,"en":"The one you grapple is Kakan-Chyn;"},{"id":"semetey-1-2013:p1358:b004:l019","ordinal":179940,"en":"The one you oppose is Bakburchun."},{"id":"semetey-1-2013:p1358:b004:l020","ordinal":179941,"en":"My orphan foal, listen:"},{"id":"semetey-1-2013:p1358:b004:l021","ordinal":179942,"en":"Wear it when you go to battle;"},{"id":"semetey-1-2013:p1358:b004:l022","ordinal":179943,"en":"The road to Beijing is a perilous road,"},{"id":"semetey-1-2013:p1358:b004:l023","ordinal":179944,"en":"Face the foe and strike!”"},{"id":"semetey-1-2013:p1358:b004:l024","ordinal":179945,"en":"Weeping bitterly, Kanykey"},{"id":"semetey-1-2013:p1358:b004:l025","ordinal":179946,"en":"Now gave him the Kandagai."},{"id":"semetey-1-2013:p1358:b004:l026","ordinal":179947,"en":"When one looked at the Kandagai,"},{"id":"semetey-1-2013:p1358:b004:l027","ordinal":179948,"en":"One saw the skill"},{"id":"semetey-1-2013:p1358:b004:l028","ordinal":179949,"en":"Of your dear, formidable mother."},{"id":"semetey-1-2013:p1358:b004:l029","ordinal":179950,"en":"Kandagai was exceedingly precious,"},{"id":"semetey-1-2013:p1358:b004:l030","ordinal":179951,"en":"With a worth no man could attain;"},{"id":"semetey-1-2013:p1358:b004:l031","ordinal":179952,"en":"So her son might prepare and wear it,"},{"id":"semetey-1-2013:p1358:b004:l032","ordinal":179953,"en":"So he might strike the foe without tiring,"},{"id":"semetey-1-2013:p1358:b004:l033","ordinal":179954,"en":"The mighty queen had made"},{"id":"semetey-1-2013:p1358:b004:l034","ordinal":179955,"en":"The Kandagai!"},{"id":"semetey-1-2013:p1358:b004:l035","ordinal":179956,"en":"True saint Kanykey—"},{"id":"semetey-1-2013:p1358:b004:l036","ordinal":179957,"en":"Most skillful of the long-haired,"},{"id":"semetey-1-2013:p1358:b004:l037","ordinal":179958,"en":"The finest of women."},{"id":"semetey-1-2013:p1358:b004:l038","ordinal":179959,"en":"Dear queen Kanykey,"},{"id":"semetey-1-2013:p1358:b004:l039","ordinal":179960,"en":"The purest of womankind,"},{"id":"semetey-1-2013:p1359:b003:l001","ordinal":179961,"en":"Foremost among women in white kerchiefs."},{"id":"semetey-1-2013:p1359:b003:l002","ordinal":179962,"en":"The one you oppose is Kakan-Chyn,"},{"id":"semetey-1-2013:p1359:b003:l003","ordinal":179963,"en":"O mighty Bakai, my support!"},{"id":"semetey-1-2013:p1359:b003:l004","ordinal":179964,"en":"Without turning from the land of Beijing,"},{"id":"semetey-1-2013:p1359:b003:l005","ordinal":179965,"en":"You have set off in pursuit;"},{"id":"semetey-1-2013:p1359:b003:l006","ordinal":179966,"en":"Without turning, beginning a holy war,"},{"id":"semetey-1-2013:p1359:b003:l007","ordinal":179967,"en":"You have set off seeking blood vengeance."},{"id":"semetey-1-2013:p1359:b003:l008","ordinal":179968,"en":"May the enemy who attacks you be overcome!"}]
