{"id": "sayakbay-ms-current146:pdf054:l001", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 54, "folio": 437, "line_in_page": 1, "raw": "Акылы кем, ары жок,", "text": "Акылы кем, ары жок,", "en": "Short of wit and without honor,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf054:l002", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 54, "folio": 437, "line_in_page": 2, "raw": "Айбат кылчу эри жок,", "text": "Айбат кылчу эри жок,", "en": "With no brave man to inspire awe,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf054:l003", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 54, "folio": 437, "line_in_page": 3, "raw": "Намысы аз, ары жок,", "text": "Намысы аз, ары жок,", "en": "With little pride and without honor,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf054:l004", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 54, "folio": 437, "line_in_page": 4, "raw": "Башы кара, бугу айры,", "text": "Башы кара, бугу айры,", "en": "Their heads are dark, their antlers forked,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Cursive letterforms or word division make this completion-first reading and translation provisional.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf054:l005", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 54, "folio": 437, "line_in_page": 5, "raw": "Булар мага каар эл экен.", "text": "Булар мага каар эл экен.", "en": "These seem to be a hostile people to me.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf054:l006", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 54, "folio": 437, "line_in_page": 6, "raw": "Кайраты жок, ары жок,", "text": "Кайраты жок, ары жок,", "en": "Without courage and without honor,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf054:l007", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 54, "folio": 437, "line_in_page": 7, "raw": "Бир чыккан чоңдой нем экен.", "text": "Бир чыккан чоңдой нем экен.", "en": "What sort of great creature has emerged?", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Cursive letterforms or word division make this completion-first reading and translation provisional.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf054:l008", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 54, "folio": 437, "line_in_page": 8, "raw": "Урушу кырк хан Каканчын,", "text": "Урушу кырк хан Каканчын,", "en": "Kakan-chyn, khan of forty in battle,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Cursive letterforms or word division make this completion-first reading and translation provisional.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf054:l009", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 54, "folio": 437, "line_in_page": 9, "raw": "Нур түшкөн бу Бээжин,", "text": "Нур түшкөн бу Бээжин,", "en": "This Beijing upon which light has fallen,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Cursive letterforms or word division make this completion-first reading and translation provisional.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf054:l010", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 54, "folio": 437, "line_in_page": 10, "raw": "Атабызга милдет кеби бар,", "text": "Атабызга милдет кеби бар,", "en": "Owes a debt of words to our father,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Cursive letterforms or word division make this completion-first reading and translation provisional.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf054:l011", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 54, "folio": 437, "line_in_page": 11, "raw": "Айдарот уруп калкарго,", "text": "Айдарот уруп калкарго,", "en": "Striking Aidarot against the people,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Cursive letterforms or word division make this completion-first reading and translation provisional.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf054:l012", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 54, "folio": 437, "line_in_page": 12, "raw": "Анда атанын кеби бар.", "text": "Анда атанын кеби бар.", "en": "There is our father's grievance in it.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf054:l013", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 54, "folio": 437, "line_in_page": 13, "raw": "Калдайларым, калдарым,", "text": "Калдайларым, калдарым,", "en": "My Kaldais, my commanders,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf054:l014", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 54, "folio": 437, "line_in_page": 14, "raw": "Шуру тагар маржан таш,", "text": "Шуру тагар маржан таш,", "en": "A pearl-stone fit to wear as a necklace,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Cursive letterforms or word division make this completion-first reading and translation provisional.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf054:l015", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 54, "folio": 437, "line_in_page": 15, "raw": "Кийип турган жандарым,", "text": "Кийип турган жандарым,", "en": "My warriors who stand dressed for battle,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf054:l016", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 54, "folio": 437, "line_in_page": 16, "raw": "Катка баккан мергеним,", "text": "Катка баккан мергеним,", "en": "My marksman reared for the letter's summons,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Cursive letterforms or word division make this completion-first reading and translation provisional.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf054:l017", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 54, "folio": 437, "line_in_page": 17, "raw": "Баласыз болгон эреним,", "text": "Баласыз болгон эреним,", "en": "My hero who was left childless,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Cursive letterforms or word division make this completion-first reading and translation provisional.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf054:l018", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 54, "folio": 437, "line_in_page": 18, "raw": "Уламаган уладым,", "text": "Уламаган уладым,", "en": "I joined what had not been joined,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Cursive letterforms or word division make this completion-first reading and translation provisional.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf054:l019", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 54, "folio": 437, "line_in_page": 19, "raw": "Улуу жаман көп көргөн,", "text": "Улуу жаман көп көргөн,", "en": "Having seen much, both great and evil,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Cursive letterforms or word division make this completion-first reading and translation provisional.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf054:l020", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 54, "folio": 437, "line_in_page": 20, "raw": "Бийкендерден сурадым.", "text": "Бийкендерден сурадым.", "en": "I asked the noblewomen.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Cursive letterforms or word division make this completion-first reading and translation provisional.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf054:l021", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 54, "folio": 437, "line_in_page": 21, "raw": "Сурап алып мен өзүм,", "text": "Сурап алып мен өзүм,", "en": "After asking, I myself,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf054:l022", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 54, "folio": 437, "line_in_page": 22, "raw": "Күйдүм, быштым, чок болдум,", "text": "Күйдүм, быштым, чок болдум,", "en": "Burned and baked until I became an ember,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf054:l023", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 54, "folio": 437, "line_in_page": 23, "raw": "Үчүн келген жоктодум.", "text": "Үчүн келген жоктодум.", "en": "I mourned what had come for its sake.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Cursive letterforms or word division make this completion-first reading and translation provisional.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf054:l024", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 54, "folio": 437, "line_in_page": 24, "raw": "Солдой кайкал турарым,", "text": "Солдой кайкал турарым,", "en": "I shall stand towering like a giant,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Cursive letterforms or word division make this completion-first reading and translation provisional.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf054:l025", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 54, "folio": 437, "line_in_page": 25, "raw": "Чоңун күтүп шурадым,", "text": "Чоңун күтүп шурадым,", "en": "I waited and asked for their chief,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Cursive letterforms or word division make this completion-first reading and translation provisional.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf054:l026", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 54, "folio": 437, "line_in_page": 26, "raw": "Тамак ичпей, аш ичпей,", "text": "Тамак ичпей, аш ичпей,", "en": "Neither eating food nor taking a meal,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf054:l027", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 54, "folio": 437, "line_in_page": 27, "raw": "Ок тийгендей жарамын,", "text": "Ок тийгендей жарамын,", "en": "I am wounded as though struck by a bullet,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf054:l028", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 54, "folio": 437, "line_in_page": 28, "raw": "Оодарылган заманым,", "text": "Оодарылган заманым,", "en": "My age has been overturned,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf054:l029", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 54, "folio": 437, "line_in_page": 29, "raw": "Ойлоп көптү самадым.", "text": "Ойлоп көптү самадым.", "en": "Thinking, I longed for many things.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf054:l030", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 54, "folio": 437, "line_in_page": 30, "raw": "Бээжиндин чыңдар багында,", "text": "Бээжиндин чыңдар багында,", "en": "In the fortress-gardens of Beijing,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf054:l031", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 54, "folio": 437, "line_in_page": 31, "raw": "Балкы адам бабам табында,", "text": "Балкы адам бабам табында,", "en": "In the time of my forefather, the radiant man,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Cursive letterforms or word division make this completion-first reading and translation provisional.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf054:l032", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 54, "folio": 437, "line_in_page": 32, "raw": "Укмуш жазат көп дагза,", "text": "Укмуш жазат көп дагза,", "en": "Many wondrous decrees are written,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Cursive letterforms or word division make this completion-first reading and translation provisional.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf054:l033", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 54, "folio": 437, "line_in_page": 33, "raw": "Көп дагзаны карасам,", "text": "Көп дагзаны карасам,", "en": "When I look upon the many decrees,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf054:l034", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 54, "folio": 437, "line_in_page": 34, "raw": "Алаботу жердеген,", "text": "Алаботу жердеген,", "en": "Dwelling in Alabotu,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf054:l035", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 54, "folio": 437, "line_in_page": 35, "raw": "Алышып адам жамбеген!", "text": "Алышып адам жамбеген!", "en": "A man who yielded to no one in combat!", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Cursive letterforms or word division make this completion-first reading and translation provisional.", "bbox": null}
