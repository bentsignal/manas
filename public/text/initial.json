[{"id":"manas-2010:p0016:b003:l001","ordinal":1,"en":"His forefathers were khans, every one,"},{"id":"manas-2010:p0016:b003:l002","ordinal":2,"en":"Blessed by Kydyr from the beginning;"},{"id":"manas-2010:p0016:b003:l003","ordinal":3,"en":"His earliest ancestors were all khans,"},{"id":"manas-2010:p0016:b003:l004","ordinal":4,"en":"Blessed by Kydyr from the first."},{"id":"manas-2010:p0016:b003:l005","ordinal":5,"en":"Where he had spent the night,"},{"id":"manas-2010:p0016:b003:l006","ordinal":6,"en":"An enduring shrine arose;"},{"id":"manas-2010:p0016:b003:l007","ordinal":7,"en":"God had favored him from the beginning."},{"id":"manas-2010:p0016:b003:l008","ordinal":8,"en":"Where he had set foot,"},{"id":"manas-2010:p0016:b003:l009","ordinal":9,"en":"A town with a market arose;"},{"id":"manas-2010:p0016:b003:l010","ordinal":10,"en":"God had favored him from the first."},{"id":"manas-2010:p0016:b003:l011","ordinal":11,"en":"He pledged his hand to twelve spiritual guides,"},{"id":"manas-2010:p0016:b003:l012","ordinal":12,"en":"Received a letter from the caliph,"},{"id":"manas-2010:p0016:b003:l013","ordinal":13,"en":"And so was called an illustrious hero."},{"id":"manas-2010:p0016:b003:l014","ordinal":14,"en":"His forefather was Böyön Khan;"},{"id":"manas-2010:p0016:b003:l015","ordinal":15,"en":"From Böyön Khan came Chayan Khan,"},{"id":"manas-2010:p0016:b003:l016","ordinal":16,"en":"From Chayan Khan came Ogoy Khan."},{"id":"manas-2010:p0016:b003:l017","ordinal":17,"en":"How could Ogoy be an easy foe?"},{"id":"manas-2010:p0016:b003:l018","ordinal":18,"en":"Anyone who faced him was wiped out."},{"id":"manas-2010:p0016:b003:l020","ordinal":19,"en":"He dwelt along the Somduk River;"},{"id":"manas-2010:p0016:b003:l021","ordinal":20,"en":"Those who fought Ogoy were left crawling."},{"id":"manas-2010:p0016:b003:l022","ordinal":21,"en":"His fathers and forefathers"},{"id":"manas-2010:p0016:b003:l023","ordinal":22,"en":"Were the offspring of lions,"},{"id":"manas-2010:p0016:b003:l024","ordinal":23,"en":"Never sated by the blood they drank."},{"id":"manas-2010:p0016:b003:l025","ordinal":24,"en":"From Ogoy Khan came Balakan."},{"id":"manas-2010:p0016:b003:l026","ordinal":25,"en":"Balakan’s valor"},{"id":"manas-2010:p0016:b003:l027","ordinal":26,"en":"Spread through many lands."},{"id":"manas-2010:p0016:b003:l028","ordinal":27,"en":"Anyone who defied him"},{"id":"manas-2010:p0016:b003:l029","ordinal":28,"en":"He seized and beat."},{"id":"manas-2010:p0016:b003:l030","ordinal":29,"en":"No man could make him bow;"},{"id":"manas-2010:p0016:b003:l031","ordinal":30,"en":"No mortal dared confront him."},{"id":"manas-2010:p0016:b003:l032","ordinal":31,"en":"From Balakan came Karakan,"},{"id":"manas-2010:p0016:b003:l033","ordinal":32,"en":"Resolute, mighty, fierce in wrath;"},{"id":"manas-2010:p0016:b003:l034","ordinal":33,"en":"He too laid low those who challenged him."},{"id":"manas-2010:p0016:b003:l035","ordinal":34,"en":"Born of the Kyrgyz people,"},{"id":"manas-2010:p0016:b003:l036","ordinal":35,"en":"His might took men’s lives"},{"id":"manas-2010:p0016:b003:l037","ordinal":36,"en":"And threw the Chinese into turmoil."},{"id":"manas-2010:p0016:b003:l038","ordinal":37,"en":"Resolute, mighty, fierce in wrath,"},{"id":"manas-2010:p0016:b003:l039","ordinal":38,"en":"He too laid low those who challenged him."},{"id":"manas-2010:p0016:b003:l040","ordinal":39,"en":"While Karakan held sway,"},{"id":"manas-2010:p0016:b003:l041","ordinal":40,"en":"Five palaces housed his guests."},{"id":"manas-2010:p0016:b003:l042","ordinal":41,"en":"Do not ask about that valiant man:"},{"id":"manas-2010:p0016:b003:l043","ordinal":42,"en":"There was much for which he was renowned."},{"id":"manas-2010:p0016:b003:l044","ordinal":43,"en":"Thick of arm and hard of heart,"},{"id":"manas-2010:p0016:b003:l045","ordinal":44,"en":"He bore the name Karakan,"},{"id":"manas-2010:p0017:b002:l001","ordinal":45,"en":"A powerfully built, fearless warrior,"},{"id":"manas-2010:p0017:b002:l002","ordinal":46,"en":"A hero surpassing other spearmen."},{"id":"manas-2010:p0017:b002:l003","ordinal":47,"en":"He too laid low those who challenged him."},{"id":"manas-2010:p0017:b002:l004","ordinal":48,"en":"Towering in majesty, fierce in wrath,"},{"id":"manas-2010:p0017:b002:l005","ordinal":49,"en":"He too stirred strife throughout the world."},{"id":"manas-2010:p0017:b002:l006","ordinal":50,"en":"When that Karakan died,"},{"id":"manas-2010:p0017:b002:l007","ordinal":51,"en":"When the true abode from which none returns"},{"id":"manas-2010:p0017:b002:l008","ordinal":52,"en":"Was revealed to that man,"},{"id":"manas-2010:p0017:b002:l009","ordinal":53,"en":"Of the Argyn and the Kyrgyz,"},{"id":"manas-2010:p0017:b002:l010","ordinal":54,"en":"Shattering lattice walls and roof poles,"},{"id":"manas-2010:p0017:b002:l011","ordinal":55,"en":"Molto Khan arose from among the Chinese,"},{"id":"manas-2010:p0017:b002:l012","ordinal":56,"en":"Making their brides and daughters weep."},{"id":"manas-2010:p0017:b002:l013","ordinal":57,"en":"His strife afflicted the whole world;"},{"id":"manas-2010:p0017:b002:l014","ordinal":58,"en":"One named Alöökö also arose."},{"id":"manas-2010:p0017:b002:l015","ordinal":59,"en":"They chose their champions,"},{"id":"manas-2010:p0017:b002:l016","ordinal":60,"en":"Made their strong champions ready."},{"id":"manas-2010:p0017:b002:l017","ordinal":61,"en":"When Argyn and Kyrgyz together"},{"id":"manas-2010:p0017:b002:l018","ordinal":62,"en":"Were camped along the river,"},{"id":"manas-2010:p0017:b002:l019","ordinal":63,"en":"When Karakan passed from this world,"},{"id":"manas-2010:p0017:b002:l020","ordinal":64,"en":"It was as though a fire had gone out."},{"id":"manas-2010:p0017:b002:l021","ordinal":65,"en":"No one remained to stand against them;"},{"id":"manas-2010:p0017:b002:l022","ordinal":66,"en":"To utter a word of defiance,"},{"id":"manas-2010:p0017:b002:l023","ordinal":67,"en":"The multitude had no strength left."},{"id":"manas-2010:p0017:b002:l024","ordinal":68,"en":"Molto Khan of the Chinese"},{"id":"manas-2010:p0017:b002:l025","ordinal":69,"en":"Unleashed the havoc."},{"id":"manas-2010:p0017:b002:l026","ordinal":70,"en":"Those who defied him"},{"id":"manas-2010:p0017:b002:l027","ordinal":71,"en":"He slaughtered, sparing none."},{"id":"manas-2010:p0017:b002:l028","ordinal":72,"en":"He levied excessive tribute;"},{"id":"manas-2010:p0017:b002:l029","ordinal":73,"en":"Anyone who answered back"},{"id":"manas-2010:p0017:b002:l030","ordinal":74,"en":"He drenched in crimson blood."},{"id":"manas-2010:p0017:b002:l031","ordinal":75,"en":"He spared not a single life."},{"id":"manas-2010:p0017:b002:l032","ordinal":76,"en":"When he brought his strength to bear,"},{"id":"manas-2010:p0017:b002:l033","ordinal":77,"en":"The blood of the many Kyrgyz and Argyn"},{"id":"manas-2010:p0017:b002:l034","ordinal":78,"en":"Overflowed like water."},{"id":"manas-2010:p0017:b002:l035","ordinal":79,"en":"Remembering Karakan,"},{"id":"manas-2010:p0017:b002:l036","ordinal":80,"en":"The multitude shed tears."},{"id":"manas-2010:p0017:b002:l037","ordinal":81,"en":"The Black Kalmyks and the Manchu people"},{"id":"manas-2010:p0017:b002:l038","ordinal":82,"en":"Vent their wrath and seize the craftswomen;"},{"id":"manas-2010:p0017:b002:l039","ordinal":83,"en":"Taking them as plunder, the wretches"},{"id":"manas-2010:p0017:b002:l040","ordinal":84,"en":"Seize the girls with five braids."},{"id":"manas-2010:p0017:b002:l041","ordinal":85,"en":"They fell every willow,"},{"id":"manas-2010:p0017:b002:l042","ordinal":86,"en":"They pull down every house."},{"id":"manas-2010:p0017:b002:l043","ordinal":87,"en":"Now they have plundered everything,"},{"id":"manas-2010:p0017:b002:l044","ordinal":88,"en":"A time like the end of the world"},{"id":"manas-2010:p0017:b002:l045","ordinal":89,"en":"They have brought upon the people now."},{"id":"manas-2010:p0017:b002:l046","ordinal":90,"en":"He levied a tax on every hearth;"},{"id":"manas-2010:p0017:b002:l047","ordinal":91,"en":"That swine, ablaze with fury,"},{"id":"manas-2010:p0017:b002:l048","ordinal":92,"en":"Collected it all, leaving nothing."},{"id":"manas-2010:p0018:b002:l001","ordinal":93,"en":"“Ah, Karakan, do not die!"},{"id":"manas-2010:p0018:b002:l002","ordinal":94,"en":"Do not let such humiliation"},{"id":"manas-2010:p0018:b002:l003","ordinal":95,"en":"Fall upon mortal people!”"},{"id":"manas-2010:p0018:b002:l004","ordinal":96,"en":"All the people wept;"},{"id":"manas-2010:p0018:b002:l005","ordinal":97,"en":"The aged old men wept."},{"id":"manas-2010:p0018:b002:l006","ordinal":98,"en":"“Tomorrow they will seize me,”"},{"id":"manas-2010:p0018:b002:l007","ordinal":99,"en":"Wept the young girls at play."},{"id":"manas-2010:p0018:b002:l008","ordinal":100,"en":"The khan’s plundering was bitter torment."},{"id":"manas-2010:p0018:b002:l009","ordinal":101,"en":"The Kyrgyz left without their khan"},{"id":"manas-2010:p0018:b002:l010","ordinal":102,"en":"Were divided by the measure of a whip."},{"id":"manas-2010:p0018:b002:l011","ordinal":103,"en":"Molto and Alöökö"},{"id":"manas-2010:p0018:b002:l012","ordinal":104,"en":"Held them tightly between them,"},{"id":"manas-2010:p0018:b002:l013","ordinal":105,"en":"Laid grievous suffering upon them."},{"id":"manas-2010:p0018:b002:l014","ordinal":106,"en":"From the helpless, powerless Kyrgyz"},{"id":"manas-2010:p0018:b002:l015","ordinal":107,"en":"They levied a full-grown beast from every hearth."},{"id":"manas-2010:p0018:b002:l016","ordinal":108,"en":"That accursed swine"},{"id":"manas-2010:p0018:b002:l017","ordinal":109,"en":"Collected everything they had."},{"id":"manas-2010:p0018:b002:l018","ordinal":110,"en":"The Argyn and the Kyrgyz—"},{"id":"manas-2010:p0018:b002:l019","ordinal":111,"en":"Their burning hearths were quenched,"},{"id":"manas-2010:p0018:b002:l020","ordinal":112,"en":"They were driven out together."},{"id":"manas-2010:p0018:b002:l021","ordinal":113,"en":"Karakan was dead."},{"id":"manas-2010:p0018:b002:l022","ordinal":114,"en":"There was no one to speak against them;"},{"id":"manas-2010:p0018:b002:l023","ordinal":115,"en":"The Argyn and the Kyrgyz"},{"id":"manas-2010:p0018:b002:l024","ordinal":116,"en":"Were divided by the measure of a whip."},{"id":"manas-2010:p0018:b002:l025","ordinal":117,"en":"The Argyn and the Kyrgyz"},{"id":"manas-2010:p0018:b002:l026","ordinal":118,"en":"Were driven away, their foremost far off;"},{"id":"manas-2010:p0018:b002:l027","ordinal":119,"en":"That people were worn down,"},{"id":"manas-2010:p0018:b002:l028","ordinal":120,"en":"All struck down, none spared."},{"id":"manas-2010:p0018:b002:l029","ordinal":121,"en":"To give the raging unbeliever"},{"id":"manas-2010:p0018:b002:l030","ordinal":122,"en":"There were no livestock left to seize,"},{"id":"manas-2010:p0018:b002:l031","ordinal":123,"en":"Nor a soul left to answer back."},{"id":"manas-2010:p0018:b002:l032","ordinal":124,"en":"Scattered in turmoil and ruin,"},{"id":"manas-2010:p0018:b002:l033","ordinal":125,"en":"The poor people fled without rest,"},{"id":"manas-2010:p0018:b002:l034","ordinal":126,"en":"Grieving and sorrowing,"},{"id":"manas-2010:p0018:b002:l035","ordinal":127,"en":"The man who found a way for his people—"},{"id":"manas-2010:p0018:b002:l036","ordinal":128,"en":"They had lost Karakan;"},{"id":"manas-2010:p0018:b002:l037","ordinal":129,"en":"They scattered, finding no way out."},{"id":"manas-2010:p0018:b002:l038","ordinal":130,"en":"When the khan died, the two khans"},{"id":"manas-2010:p0018:b002:l039","ordinal":131,"en":"Brought their full force to bear."},{"id":"manas-2010:p0018:b002:l040","ordinal":132,"en":"The multitude, paying no heed,"},{"id":"manas-2010:p0018:b002:l041","ordinal":133,"en":"Wandered far and wide."},{"id":"manas-2010:p0018:b002:l042","ordinal":134,"en":"Unable to endure the tribute,"},{"id":"manas-2010:p0018:b002:l043","ordinal":135,"en":"Some wandered to Altai,"},{"id":"manas-2010:p0018:b002:l044","ordinal":136,"en":"Some wandered to Khangai,"},{"id":"manas-2010:p0018:b002:l045","ordinal":137,"en":"Some wandered to Urum,"},{"id":"manas-2010:p0018:b002:l046","ordinal":138,"en":"Some wandered to Crimea."},{"id":"manas-2010:p0018:b002:l047","ordinal":139,"en":"The open land was left without its people;"},{"id":"manas-2010:p0018:b002:l048","ordinal":140,"en":"The people wandered, left without a khan."},{"id":"manas-2010:p0019:b002:l001","ordinal":141,"en":"Karakan’s wife"},{"id":"manas-2010:p0019:b002:l002","ordinal":142,"en":"Was left a widow, dressed in black."},{"id":"manas-2010:p0019:b002:l003","ordinal":143,"en":"Karakan himself left behind"},{"id":"manas-2010:p0019:b002:l004","ordinal":144,"en":"Treasuries filled with precious goods."},{"id":"manas-2010:p0019:b002:l005","ordinal":145,"en":"Karakan’s eight sons"},{"id":"manas-2010:p0019:b002:l006","ordinal":146,"en":"Were all alike still young."},{"id":"manas-2010:p0019:b002:l007","ordinal":147,"en":"When that Karakan died,"},{"id":"manas-2010:p0019:b002:l008","ordinal":148,"en":"All were left young, still crawling,"},{"id":"manas-2010:p0019:b002:l009","ordinal":149,"en":"All helpless, all bewildered,"},{"id":"manas-2010:p0019:b002:l010","ordinal":150,"en":"Left young when their father died."},{"id":"manas-2010:p0019:b002:l011","ordinal":151,"en":"Those eight sons of Karakan,"},{"id":"manas-2010:p0019:b002:l012","ordinal":152,"en":"Some born singly, some as twins,"},{"id":"manas-2010:p0019:b002:l013","ordinal":153,"en":"Were alike in valor before the people."},{"id":"manas-2010:p0019:b002:l014","ordinal":154,"en":"All the people"},{"id":"manas-2010:p0019:b002:l015","ordinal":155,"en":"“When the orphan boys grow up,"},{"id":"manas-2010:p0019:b002:l016","ordinal":156,"en":"Perhaps they will be of help”—"},{"id":"manas-2010:p0019:b002:l017","ordinal":157,"en":"That was their constant wish."},{"id":"manas-2010:p0019:b002:l018","ordinal":158,"en":"Their father Karakan was a khan;"},{"id":"manas-2010:p0019:b002:l019","ordinal":159,"en":"Karakan had eight sons."},{"id":"manas-2010:p0019:b002:l020","ordinal":160,"en":"If they lived and grew to manhood,"},{"id":"manas-2010:p0019:b002:l021","ordinal":161,"en":"They could deliver the Kyrgyz;"},{"id":"manas-2010:p0019:b002:l022","ordinal":162,"en":"Such were those children."},{"id":"manas-2010:p0019:b002:l023","ordinal":163,"en":"The valiant boys were Jakyp and Ulak Khan."},{"id":"manas-2010:p0019:b002:l024","ordinal":164,"en":"Swooping down from the uplands,"},{"id":"manas-2010:p0019:b002:l025","ordinal":165,"en":"They plundered the treasury"},{"id":"manas-2010:p0019:b002:l026","ordinal":166,"en":"And the wealth of the multitude."},{"id":"manas-2010:p0019:b002:l027","ordinal":167,"en":"And so those children"},{"id":"manas-2010:p0019:b002:l028","ordinal":168,"en":"Were left crying in the open country."},{"id":"manas-2010:p0019:b002:l029","ordinal":169,"en":"The boys matured and became men,"},{"id":"manas-2010:p0019:b002:l030","ordinal":170,"en":"Equals of other heroes’ sons."},{"id":"manas-2010:p0019:b002:l031","ordinal":171,"en":"When the boys grew tall and mounted horses,"},{"id":"manas-2010:p0019:b002:l032","ordinal":172,"en":"Your elder Baltay came to them."},{"id":"manas-2010:p0019:b002:l033","ordinal":173,"en":"If you ask about Akbaltay,"},{"id":"manas-2010:p0019:b002:l034","ordinal":174,"en":"He was the mighty khan of the Noygut."},{"id":"manas-2010:p0019:b002:l035","ordinal":175,"en":"He had lost his Noygut people and their royal camp"},{"id":"manas-2010:p0019:b002:l036","ordinal":176,"en":"To Alöökö Khan;"},{"id":"manas-2010:p0019:b002:l037","ordinal":177,"en":"He too had fallen into destitution."},{"id":"manas-2010:p0019:b002:l038","ordinal":178,"en":"Horses in countless herds on the hills—"},{"id":"manas-2010:p0019:b002:l039","ordinal":179,"en":"Alöökö, master of the white yurts,"},{"id":"manas-2010:p0019:b002:l040","ordinal":180,"en":"A khan such as your Akbaltay—"},{"id":"manas-2010:p0019:b002:l041","ordinal":181,"en":"He had trampled him down,"},{"id":"manas-2010:p0019:b002:l042","ordinal":182,"en":"Had scattered all his wealth."},{"id":"manas-2010:p0019:b002:l043","ordinal":183,"en":"Finding no grave to crawl into,"},{"id":"manas-2010:p0019:b002:l044","ordinal":184,"en":"Finding no place to shelter,"},{"id":"manas-2010:p0019:b002:l045","ordinal":185,"en":"He was utterly at his wits’ end."},{"id":"manas-2010:p0019:b002:l046","ordinal":186,"en":"“He is a ruler’s son,” he thought,"},{"id":"manas-2010:p0019:b002:l047","ordinal":187,"en":"And fled toward Jakyp."},{"id":"manas-2010:p0019:b002:l048","ordinal":188,"en":"“With Karakan’s eight sons"},{"id":"manas-2010:p0020:b002:l001","ordinal":189,"en":"I will try to join forces;"},{"id":"manas-2010:p0020:b002:l002","ordinal":190,"en":"If we die, I will die with them."},{"id":"manas-2010:p0020:b002:l003","ordinal":191,"en":"I will scout with them,"},{"id":"manas-2010:p0020:b002:l004","ordinal":192,"en":"Take horses from Champan."},{"id":"manas-2010:p0020:b002:l005","ordinal":193,"en":"Rather than stand idle and pay tribute,"},{"id":"manas-2010:p0020:b002:l006","ordinal":194,"en":"I would die fighting tooth and nail;"},{"id":"manas-2010:p0020:b002:l007","ordinal":195,"en":"Against the Black Kalmyks and the Manchus,"},{"id":"manas-2010:p0020:b002:l008","ordinal":196,"en":"I would die fighting.”"},{"id":"manas-2010:p0020:b002:l009","ordinal":197,"en":"What else could poor Baltay do?"},{"id":"manas-2010:p0020:b002:l010","ordinal":198,"en":"He took Jakyp for his support."},{"id":"manas-2010:p0020:b002:l011","ordinal":199,"en":"Their sheep shared the same fold;"},{"id":"manas-2010:p0020:b002:l012","ordinal":200,"en":"Your elder Baltay, the gray-maned wolf,"},{"id":"manas-2010:p0020:b002:l013","ordinal":201,"en":"Shared his meals in fellowship."},{"id":"manas-2010:p0020:b002:l014","ordinal":202,"en":"“When we scout, let us share the dust,"},{"id":"manas-2010:p0020:b002:l015","ordinal":203,"en":"Jakyp, my little foal;"},{"id":"manas-2010:p0020:b002:l016","ordinal":204,"en":"Let death be shared, our lives as one."},{"id":"manas-2010:p0020:b002:l017","ordinal":205,"en":"Living, let us gather our wealth together;"},{"id":"manas-2010:p0020:b002:l018","ordinal":206,"en":"Dying, let us share the prayers of faith."},{"id":"manas-2010:p0020:b002:l019","ordinal":207,"en":"My son Jakyp, hear my words:"},{"id":"manas-2010:p0020:b002:l020","ordinal":208,"en":"Alöökö drove my people"},{"id":"manas-2010:p0020:b002:l021","ordinal":209,"en":"Out of my own land."},{"id":"manas-2010:p0020:b002:l022","ordinal":210,"en":"He chilled the breath in me,"},{"id":"manas-2010:p0020:b002:l023","ordinal":211,"en":"He broke my back,"},{"id":"manas-2010:p0020:b002:l024","ordinal":212,"en":"He raided my horses,"},{"id":"manas-2010:p0020:b002:l025","ordinal":213,"en":"He robbed me of sleep,"},{"id":"manas-2010:p0020:b002:l026","ordinal":214,"en":"He broke my back,"},{"id":"manas-2010:p0020:b002:l027","ordinal":215,"en":"He slaughtered my people."},{"id":"manas-2010:p0020:b002:l028","ordinal":216,"en":"His Torguts gathered, every one;"},{"id":"manas-2010:p0020:b002:l029","ordinal":217,"en":"The Black Kalmyks brought trouble on my people,"},{"id":"manas-2010:p0020:b002:l030","ordinal":218,"en":"Brought them to utter ruin while they lived."},{"id":"manas-2010:p0020:b002:l031","ordinal":219,"en":"My wretched Noygut people"},{"id":"manas-2010:p0020:b002:l032","ordinal":220,"en":"They slaughtered, sparing none."},{"id":"manas-2010:p0020:b002:l033","ordinal":221,"en":"They bound their champions;"},{"id":"manas-2010:p0020:b002:l034","ordinal":222,"en":"Every one of their warriors"},{"id":"manas-2010:p0020:b002:l035","ordinal":223,"en":"They slew, leaving none alive."},{"id":"manas-2010:p0020:b002:l036","ordinal":224,"en":"They beat all the old men,"},{"id":"manas-2010:p0020:b002:l037","ordinal":225,"en":"They plundered all the girls,"},{"id":"manas-2010:p0020:b002:l038","ordinal":226,"en":"They dug my pit deep."},{"id":"manas-2010:p0020:b002:l039","ordinal":227,"en":"Alöökö of the Chinese"},{"id":"manas-2010:p0020:b002:l040","ordinal":228,"en":"Made my bitter fate boil over."},{"id":"manas-2010:p0020:b002:l041","ordinal":229,"en":"He took the spoils by force;"},{"id":"manas-2010:p0020:b002:l042","ordinal":230,"en":"Upon my old Noygut people"},{"id":"manas-2010:p0020:b002:l043","ordinal":231,"en":"He brought great devastation."},{"id":"manas-2010:p0020:b002:l044","ordinal":232,"en":"He poured out his wrath and hemmed us in."},{"id":"manas-2010:p0020:b002:l045","ordinal":233,"en":"Unable to bear his wrath,"},{"id":"manas-2010:p0020:b002:l046","ordinal":234,"en":"Your elder, Khan Baltay, was worn out."},{"id":"manas-2010:p0020:b002:l047","ordinal":235,"en":"Untamed beasts no catching-pole could touch—"},{"id":"manas-2010:p0020:b002:l048","ordinal":236,"en":"Alöökö, may your house burn,"},{"id":"manas-2010:p0021:b002:l001","ordinal":237,"en":"Mounted his Manchus on them."},{"id":"manas-2010:p0021:b002:l002","ordinal":238,"en":"Into my royal treasury and camp"},{"id":"manas-2010:p0021:b002:l003","ordinal":239,"en":"He brought his mighty men,"},{"id":"manas-2010:p0021:b002:l004","ordinal":240,"en":"Their jackets bulging out."},{"id":"manas-2010:p0021:b002:l005","ordinal":241,"en":"He brought havoc upon my people,"},{"id":"manas-2010:p0021:b002:l006","ordinal":242,"en":"He brought black night upon me."},{"id":"manas-2010:p0021:b002:l007","ordinal":243,"en":"When he stirred, ruin followed;"},{"id":"manas-2010:p0021:b002:l008","ordinal":244,"en":"Alöökö of the Manchus"},{"id":"manas-2010:p0021:b002:l009","ordinal":245,"en":"Rose in immeasurable might"},{"id":"manas-2010:p0021:b002:l010","ordinal":246,"en":"And inflicted endless suffering."},{"id":"manas-2010:p0021:b002:l011","ordinal":247,"en":"When he roared and levied tribute,"},{"id":"manas-2010:p0021:b002:l012","ordinal":248,"en":"The Noygut people could not bear it."},{"id":"manas-2010:p0021:b002:l013","ordinal":249,"en":"That merciless Alöökö,"},{"id":"manas-2010:p0021:b002:l014","ordinal":250,"en":"That Chinese whom God had cursed,"},{"id":"manas-2010:p0021:b002:l015","ordinal":251,"en":"Six thousand silver ingots, a thousand beaver pelts—"},{"id":"manas-2010:p0021:b002:l016","ordinal":252,"en":"Such was the tribute he collected."},{"id":"manas-2010:p0021:b002:l017","ordinal":253,"en":"A grievous calamity indeed"},{"id":"manas-2010:p0021:b002:l018","ordinal":254,"en":"Was what this Alöökö did."},{"id":"manas-2010:p0021:b002:l019","ordinal":255,"en":"If we did not obey his word,"},{"id":"manas-2010:p0021:b002:l020","ordinal":256,"en":"If we did not pay his tribute—"}]
