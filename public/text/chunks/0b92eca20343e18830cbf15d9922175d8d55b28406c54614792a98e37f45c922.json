[{"id":"manas-2010:p0267:b001:l035","ordinal":12033,"en":"Again as I lay, I dreamed a dream:"},{"id":"manas-2010:p0267:b001:l036","ordinal":12034,"en":"I had taken an ice-whiskered eagle;"},{"id":"manas-2010:p0267:b001:l037","ordinal":12035,"en":"It had a golden jess upon its leg."},{"id":"manas-2010:p0267:b001:l038","ordinal":12036,"en":"The four corners of the round world,"},{"id":"manas-2010:p0267:b001:l039","ordinal":12037,"en":"I sent it round them four times."},{"id":"manas-2010:p0267:b001:l040","ordinal":12038,"en":"There was no soul to gainsay it;"},{"id":"manas-2010:p0267:b001:l041","ordinal":12039,"en":"It seized a lion."},{"id":"manas-2010:p0267:b001:l042","ordinal":12040,"en":"Animals and creatures of all kinds,"},{"id":"manas-2010:p0267:b001:l043","ordinal":12041,"en":"It went about slaughtering them."},{"id":"manas-2010:p0267:b001:l044","ordinal":12042,"en":"Its shade the many Kyrgyz"},{"id":"manas-2010:p0267:b001:l045","ordinal":12043,"en":"Took as their shelter as they lay."},{"id":"manas-2010:p0267:b001:l046","ordinal":12044,"en":"What could this mean?"},{"id":"manas-2010:p0267:b001:l047","ordinal":12045,"en":"Interpret this dream of mine!”"},{"id":"manas-2010:p0267:b001:l048","ordinal":12046,"en":"Kudaynazar the bare club,"},{"id":"manas-2010:p0268:b001:l001","ordinal":12047,"en":"Old Koshoy's confidant,"},{"id":"manas-2010:p0268:b001:l002","ordinal":12048,"en":"Surging like a hawk,"},{"id":"manas-2010:p0268:b001:l003","ordinal":12049,"en":"Found wisdom from the unseen:"},{"id":"manas-2010:p0268:b001:l004","ordinal":12050,"en":"“My princely lord named Koshoy,"},{"id":"manas-2010:p0268:b001:l005","ordinal":12051,"en":"The sword you drew from its sheath,"},{"id":"manas-2010:p0268:b001:l006","ordinal":12052,"en":"If it set the east on fire—"},{"id":"manas-2010:p0268:b001:l007","ordinal":12053,"en":"We followed the handed-down accounts,"},{"id":"manas-2010:p0268:b001:l008","ordinal":12054,"en":"We asked those who knew."},{"id":"manas-2010:p0268:b001:l009","ordinal":12055,"en":"Driven away to Altai,"},{"id":"manas-2010:p0268:b001:l010","ordinal":12056,"en":"Wandering, unable to find a way,"},{"id":"manas-2010:p0268:b001:l011","ordinal":12057,"en":"His head entangled in guilt,"},{"id":"manas-2010:p0268:b001:l012","ordinal":12058,"en":"His soul entangled in grief,"},{"id":"manas-2010:p0268:b001:l013","ordinal":12059,"en":"Lamenting, ‘We are surely dead,’"},{"id":"manas-2010:p0268:b001:l014","ordinal":12060,"en":"Parted from a people with a royal court,"},{"id":"manas-2010:p0268:b001:l015","ordinal":12061,"en":"Driven to Altai and confined,"},{"id":"manas-2010:p0268:b001:l016","ordinal":12062,"en":"Not allowed to own his stock or his own person,"},{"id":"manas-2010:p0268:b001:l017","ordinal":12063,"en":"Plundered by the Black Kalmyks,"},{"id":"manas-2010:p0268:b001:l018","ordinal":12064,"en":"Passing his days in humiliation,"},{"id":"manas-2010:p0268:b001:l019","ordinal":12065,"en":"Drinking water in sorrow—"},{"id":"manas-2010:p0268:b001:l020","ordinal":12066,"en":"His forefather was Tügöl Khan,"},{"id":"manas-2010:p0268:b001:l021","ordinal":12067,"en":"Blessed by Kydyr from his roots;"},{"id":"manas-2010:p0268:b001:l022","ordinal":12068,"en":"His earlier ancestors were all khans,"},{"id":"manas-2010:p0268:b001:l023","ordinal":12069,"en":"Blessed by Kydyr from the beginning,"},{"id":"manas-2010:p0268:b001:l024","ordinal":12070,"en":"Keeping royal courts and reigning as khans;"},{"id":"manas-2010:p0268:b001:l025","ordinal":12071,"en":"From generation to generation,"},{"id":"manas-2010:p0268:b001:l026","ordinal":12072,"en":"Their descendants were saintly scions."},{"id":"manas-2010:p0268:b001:l027","ordinal":12073,"en":"His forefather was Böyön Khan;"},{"id":"manas-2010:p0268:b001:l028","ordinal":12074,"en":"From Böyön Khan came Chayan Khan,"},{"id":"manas-2010:p0268:b001:l029","ordinal":12075,"en":"From Chayan Khan came Tümön Khan,"},{"id":"manas-2010:p0268:b001:l030","ordinal":12076,"en":"From Tümön Khan came Ogoy Khan,"},{"id":"manas-2010:p0268:b001:l031","ordinal":12077,"en":"From Ogoy Khan came Bala Khan,"},{"id":"manas-2010:p0268:b001:l032","ordinal":12078,"en":"From Bala Khan came Tara Khan,"},{"id":"manas-2010:p0268:b001:l033","ordinal":12079,"en":"From Tara Khan came Kara Khan."},{"id":"manas-2010:p0268:b001:l034","ordinal":12080,"en":"Balakan's son,"},{"id":"manas-2010:p0268:b001:l035","ordinal":12081,"en":"Never sated with begging and drinking,"},{"id":"manas-2010:p0268:b001:l036","ordinal":12082,"en":"The yellow one of these Kyrgyz,"},{"id":"manas-2010:p0268:b001:l037","ordinal":12083,"en":"From ill-intentioned Jakyp,"},{"id":"manas-2010:p0268:b001:l038","ordinal":12084,"en":"Given the name of Manas,"},{"id":"manas-2010:p0268:b001:l039","ordinal":12085,"en":"A dark wolf-maned hero was born, they say."},{"id":"manas-2010:p0268:b001:l040","ordinal":12086,"en":"Unleashing his wrath, the Kalmyks"},{"id":"manas-2010:p0268:b001:l041","ordinal":12087,"en":"He chased as far as Khangai, they say."},{"id":"manas-2010:p0268:b001:l042","ordinal":12088,"en":"He seized their kochku headman and slaughtered him, they say;"},{"id":"manas-2010:p0268:b001:l043","ordinal":12089,"en":"The Chinese who had humiliated him,"},{"id":"manas-2010:p0268:b001:l044","ordinal":12090,"en":"He slaughtered to the last, they say."},{"id":"manas-2010:p0268:b001:l045","ordinal":12091,"en":"Born to confront his foes,"},{"id":"manas-2010:p0268:b001:l046","ordinal":12092,"en":"A warrior on campaign is coming;"},{"id":"manas-2010:p0268:b001:l047","ordinal":12093,"en":"The youngest of six lions,"},{"id":"manas-2010:p0268:b001:l048","ordinal":12094,"en":"The servant beloved of Allah,"},{"id":"manas-2010:p0269:b001:l001","ordinal":12095,"en":"The only son of Jakyp,"},{"id":"manas-2010:p0269:b001:l002","ordinal":12096,"en":"Manas is coming."},{"id":"manas-2010:p0269:b001:l003","ordinal":12097,"en":"Giving vigor to your words,"},{"id":"manas-2010:p0269:b001:l004","ordinal":12098,"en":"Becoming a whip for you,"},{"id":"manas-2010:p0269:b001:l005","ordinal":12099,"en":"On the summit of Kara-Too"},{"id":"manas-2010:p0269:b001:l006","ordinal":12100,"en":"He will raise a building!"},{"id":"manas-2010:p0269:b001:l007","ordinal":12101,"en":"‘My elder, brave Koshoy,’ he will say,"},{"id":"manas-2010:p0269:b001:l008","ordinal":12102,"en":"Over all the wide world"},{"id":"manas-2010:p0269:b001:l009","ordinal":12103,"en":"He will raise you as khan!"},{"id":"manas-2010:p0269:b001:l010","ordinal":12104,"en":"To enemies who challenge him,"},{"id":"manas-2010:p0269:b001:l011","ordinal":12105,"en":"He will bring torment."},{"id":"manas-2010:p0269:b001:l012","ordinal":12106,"en":"Great Beijing with its forty gates—"},{"id":"manas-2010:p0269:b001:l013","ordinal":12107,"en":"Your chasing of the black crows means"},{"id":"manas-2010:p0269:b001:l014","ordinal":12108,"en":"Your falcon, leopard Manas,"},{"id":"manas-2010:p0269:b001:l015","ordinal":12109,"en":"Will wage a campaign!"},{"id":"manas-2010:p0269:b001:l016","ordinal":12110,"en":"The black crows' flight means"},{"id":"manas-2010:p0269:b001:l017","ordinal":12111,"en":"He scatters the Chinese livestock,"},{"id":"manas-2010:p0269:b001:l018","ordinal":12112,"en":"He opens the road for the Kyrgyz."},{"id":"manas-2010:p0269:b001:l019","ordinal":12113,"en":"Falcon Manas, the wolf-maned hero,"},{"id":"manas-2010:p0269:b001:l020","ordinal":12114,"en":"The lion is coming."},{"id":"manas-2010:p0269:b001:l021","ordinal":12115,"en":"Manas coming here"},{"id":"manas-2010:p0269:b001:l022","ordinal":12116,"en":"Is God's gift to us."},{"id":"manas-2010:p0269:b001:l023","ordinal":12117,"en":"The ice-whiskered eagle you flew—"},{"id":"manas-2010:p0269:b001:l024","ordinal":12118,"en":"Is that not falcon Manas?"},{"id":"manas-2010:p0269:b001:l025","ordinal":12119,"en":"From Kakanchyn's Great Beijing"},{"id":"manas-2010:p0269:b001:l026","ordinal":12120,"en":"You will wrest its khanate!"},{"id":"manas-2010:p0269:b001:l027","ordinal":12121,"en":"Ah, Koshoy, my khan and elder,"},{"id":"manas-2010:p0269:b001:l028","ordinal":12122,"en":"Your throne will be of gold;"},{"id":"manas-2010:p0269:b001:l029","ordinal":12123,"en":"Once you gain that lion hero,"},{"id":"manas-2010:p0269:b001:l030","ordinal":12124,"en":"Your fortune will open!"},{"id":"manas-2010:p0269:b001:l031","ordinal":12125,"en":"Safe and sound, for us"},{"id":"manas-2010:p0269:b001:l032","ordinal":12126,"en":"Lion Manas will be found;"},{"id":"manas-2010:p0269:b001:l033","ordinal":12127,"en":"Exposed shame will be covered,"},{"id":"manas-2010:p0269:b001:l034","ordinal":12128,"en":"What broke away from you will be joined,"},{"id":"manas-2010:p0269:b001:l035","ordinal":12129,"en":"What scattered from you will be gathered,"},{"id":"manas-2010:p0269:b001:l036","ordinal":12130,"en":"Your extinguished fire will burn."},{"id":"manas-2010:p0269:b001:l037","ordinal":12131,"en":"Your dead soul will come alive."},{"id":"manas-2010:p0269:b001:l038","ordinal":12132,"en":"If this dream of mine is true,"},{"id":"manas-2010:p0269:b001:l039","ordinal":12133,"en":"Manas, mighty with ancestral spirits, will come!”"},{"id":"manas-2010:p0269:b001:l040","ordinal":12134,"en":"Kudaynazar the bare club,"},{"id":"manas-2010:p0269:b001:l041","ordinal":12135,"en":"Before he had finished speaking,"},{"id":"manas-2010:p0269:b001:l042","ordinal":12136,"en":"The hearing ear, the seeing eye,"},{"id":"manas-2010:p0269:b001:l043","ordinal":12137,"en":"Kutunay on his pale filly,"},{"id":"manas-2010:p0269:b001:l044","ordinal":12138,"en":"Hurrying and flurrying, stumbling in haste,"},{"id":"manas-2010:p0269:b001:l045","ordinal":12139,"en":"Came fleeing to Koshoy now."},{"id":"manas-2010:p0269:b001:l046","ordinal":12140,"en":"To the elder having his dream interpreted,"},{"id":"manas-2010:p0269:b001:l047","ordinal":12141,"en":"Kutunay began to speak now:"},{"id":"manas-2010:p0269:b001:l048","ordinal":12142,"en":"“I saw a cloud of dust surge up,"},{"id":"manas-2010:p0270:b001:l001","ordinal":12143,"en":"Elder Koshoy, hear my words:"},{"id":"manas-2010:p0270:b001:l002","ordinal":12144,"en":"I saw a man of fearsome countenance."},{"id":"manas-2010:p0270:b001:l003","ordinal":12145,"en":"His size was like a mountain itself,"},{"id":"manas-2010:p0270:b001:l004","ordinal":12146,"en":"His eyes like the beds of lakes,"},{"id":"manas-2010:p0270:b001:l005","ordinal":12147,"en":"As though to suck in all he saw."},{"id":"manas-2010:p0270:b001:l006","ordinal":12148,"en":"His brow was like a deep ravine,"},{"id":"manas-2010:p0270:b001:l007","ordinal":12149,"en":"As though to swallow all who clashed with him."},{"id":"manas-2010:p0270:b001:l008","ordinal":12150,"en":"His brow was lofty, his wrath was mighty;"},{"id":"manas-2010:p0270:b001:l009","ordinal":12151,"en":"He levels flat those who challenge him."},{"id":"manas-2010:p0270:b001:l010","ordinal":12152,"en":"I saw a man of surpassing majesty;"},{"id":"manas-2010:p0270:b001:l011","ordinal":12153,"en":"Give up all hope against that man!"},{"id":"manas-2010:p0270:b001:l012","ordinal":12154,"en":"Looming with a fearsome look,"},{"id":"manas-2010:p0270:b001:l013","ordinal":12155,"en":"He could bring us all to our end."},{"id":"manas-2010:p0270:b001:l014","ordinal":12156,"en":"If he is an enemy, a foe,"},{"id":"manas-2010:p0270:b001:l015","ordinal":12157,"en":"He could slaughter us, leaving none!"},{"id":"manas-2010:p0270:b001:l016","ordinal":12158,"en":"Since I have been Kutunay,"},{"id":"manas-2010:p0270:b001:l017","ordinal":12159,"en":"Brave elder Koshoy,"},{"id":"manas-2010:p0270:b001:l018","ordinal":12160,"en":"Since I have been your lookout,"},{"id":"manas-2010:p0270:b001:l019","ordinal":12161,"en":"I have never seen such a hero."},{"id":"manas-2010:p0270:b001:l020","ordinal":12162,"en":"My collarbones shook,"},{"id":"manas-2010:p0270:b001:l021","ordinal":12163,"en":"My shit-filled guts quaked,"},{"id":"manas-2010:p0270:b001:l022","ordinal":12164,"en":"And I came fleeing to you!"},{"id":"manas-2010:p0270:b001:l023","ordinal":12165,"en":"His right shoulder was broad;"},{"id":"manas-2010:p0270:b001:l024","ordinal":12166,"en":"That man of fearsome countenance"},{"id":"manas-2010:p0270:b001:l025","ordinal":12167,"en":"Was a lion who could break the Oirats!"},{"id":"manas-2010:p0270:b001:l026","ordinal":12168,"en":"His chest was like a hungry lion's."},{"id":"manas-2010:p0270:b001:l027","ordinal":12169,"en":"Elder Koshoy, make ready quickly!"},{"id":"manas-2010:p0270:b001:l028","ordinal":12170,"en":"I have never seen such a man,"},{"id":"manas-2010:p0270:b001:l029","ordinal":12171,"en":"With eyes like a hunting eagle's."},{"id":"manas-2010:p0270:b001:l030","ordinal":12172,"en":"God, do not show us his face!"},{"id":"manas-2010:p0270:b001:l031","ordinal":12173,"en":"He had girded on an unsheathed sword;"},{"id":"manas-2010:p0270:b001:l032","ordinal":12174,"en":"Like a cloud about to rain again,"},{"id":"manas-2010:p0270:b001:l033","ordinal":12175,"en":"Wrath had settled on his face."},{"id":"manas-2010:p0270:b001:l034","ordinal":12176,"en":"His aspect shows his might;"},{"id":"manas-2010:p0270:b001:l035","ordinal":12177,"en":"He has stirred tumult among the peoples."},{"id":"manas-2010:p0270:b001:l036","ordinal":12178,"en":"A hollow-socketed, painted spear"},{"id":"manas-2010:p0270:b001:l037","ordinal":12179,"en":"He held jutting high above him."},{"id":"manas-2010:p0270:b001:l038","ordinal":12180,"en":"If an army came that split the earth,"},{"id":"manas-2010:p0270:b001:l039","ordinal":12181,"en":"He would not open his arms in fear."},{"id":"manas-2010:p0270:b001:l040","ordinal":12182,"en":"The men who traded blows with him,"},{"id":"manas-2010:p0270:b001:l041","ordinal":12183,"en":"He battered to the ground like sheep."},{"id":"manas-2010:p0270:b001:l042","ordinal":12184,"en":"Drinking blood, he could not have his fill;"},{"id":"manas-2010:p0270:b001:l043","ordinal":12185,"en":"He spared none who faced him."},{"id":"manas-2010:p0270:b001:l044","ordinal":12186,"en":"He had the bearing of a champion!"},{"id":"manas-2010:p0270:b001:l045","ordinal":12187,"en":"Unable to withstand his wrath,"},{"id":"manas-2010:p0270:b001:l046","ordinal":12188,"en":"I fell into turmoil;"},{"id":"manas-2010:p0270:b001:l047","ordinal":12189,"en":"From the back of my pale filly"},{"id":"manas-2010:p0270:b001:l048","ordinal":12190,"en":"I all but fell off and died!"},{"id":"manas-2010:p0271:b001:l001","ordinal":12191,"en":"Since I have been Kutunay,"},{"id":"manas-2010:p0271:b001:l002","ordinal":12192,"en":"Since I have borne the name Kutunay,"},{"id":"manas-2010:p0271:b001:l003","ordinal":12193,"en":"I have never seen such a hero."},{"id":"manas-2010:p0271:b001:l004","ordinal":12194,"en":"I died where I saw him;"},{"id":"manas-2010:p0271:b001:l005","ordinal":12195,"en":"What else was it but dying,"},{"id":"manas-2010:p0271:b001:l006","ordinal":12196,"en":"When I fled here without going near!"},{"id":"manas-2010:p0271:b001:l007","ordinal":12197,"en":"My collarbones shake,"},{"id":"manas-2010:p0271:b001:l008","ordinal":12198,"en":"My shit-filled guts quake."},{"id":"manas-2010:p0271:b001:l009","ordinal":12199,"en":"My fly-small soul cries out;"},{"id":"manas-2010:p0271:b001:l010","ordinal":12200,"en":"My heart bucks like a horse"},{"id":"manas-2010:p0271:b001:l011","ordinal":12201,"en":"And pounds from dawn till dusk."},{"id":"manas-2010:p0271:b001:l012","ordinal":12202,"en":"At one glance he is one man,"},{"id":"manas-2010:p0271:b001:l013","ordinal":12203,"en":"A figure appearing on the ridge;"},{"id":"manas-2010:p0271:b001:l014","ordinal":12204,"en":"At another glance he is a thousand men."},{"id":"manas-2010:p0271:b001:l015","ordinal":12205,"en":"As if about to seize someone,"},{"id":"manas-2010:p0271:b001:l016","ordinal":12206,"en":"A black-spotted leopard"},{"id":"manas-2010:p0271:b001:l017","ordinal":12207,"en":"Surges at his side."},{"id":"manas-2010:p0271:b001:l018","ordinal":12208,"en":"A short-tailed, blue-maned lion"},{"id":"manas-2010:p0271:b001:l019","ordinal":12209,"en":"Makes ready before his face."},{"id":"manas-2010:p0271:b001:l020","ordinal":12210,"en":"The giant black bird, the Zymyryk,"},{"id":"manas-2010:p0271:b001:l021","ordinal":12211,"en":"As if about to carry someone off,"},{"id":"manas-2010:p0271:b001:l022","ordinal":12212,"en":"Has stretched its talons from the sky."},{"id":"manas-2010:p0271:b001:l023","ordinal":12213,"en":"The Forty Chiltens and Nyyaz,"},{"id":"manas-2010:p0271:b001:l024","ordinal":12214,"en":"Let me tell it briefly,"},{"id":"manas-2010:p0271:b001:l025","ordinal":12215,"en":"Raising cries behind him,"},{"id":"manas-2010:p0271:b001:l026","ordinal":12216,"en":"Have become his cheering support."},{"id":"manas-2010:p0271:b001:l027","ordinal":12217,"en":"Ahead of him, my Father Shay"},{"id":"manas-2010:p0271:b001:l028","ordinal":12218,"en":"Opens his path, the two together—"},{"id":"manas-2010:p0271:b001:l029","ordinal":12219,"en":"And the dervish named Kydyr,"},{"id":"manas-2010:p0271:b001:l030","ordinal":12220,"en":"Making the wolf-maned one's horse plunge,"},{"id":"manas-2010:p0271:b001:l031","ordinal":12221,"en":"Leads his Toruchaar by the rein."},{"id":"manas-2010:p0271:b001:l032","ordinal":12222,"en":"Seeing the deeds of that being,"},{"id":"manas-2010:p0271:b001:l033","ordinal":12223,"en":"My dear elder Koshoy,"},{"id":"manas-2010:p0271:b001:l034","ordinal":12224,"en":"I fled toward you;"},{"id":"manas-2010:p0271:b001:l035","ordinal":12225,"en":"‘Is he Chinese?’ I thought in alarm."},{"id":"manas-2010:p0271:b001:l036","ordinal":12226,"en":"If you are mighty, go out and see,"},{"id":"manas-2010:p0271:b001:l037","ordinal":12227,"en":"My dear Koshoy, my lion!"},{"id":"manas-2010:p0271:b001:l038","ordinal":12228,"en":"If he is an enemy, a foe,"},{"id":"manas-2010:p0271:b001:l039","ordinal":12229,"en":"Before one can cry this or that,"},{"id":"manas-2010:p0271:b001:l040","ordinal":12230,"en":"In the opening and shutting of an eye,"},{"id":"manas-2010:p0271:b001:l041","ordinal":12231,"en":"He will reach us with a roar."},{"id":"manas-2010:p0271:b001:l042","ordinal":12232,"en":"Smashing your stone fortress,"},{"id":"manas-2010:p0271:b001:l043","ordinal":12233,"en":"Toppling your sand fortress,"},{"id":"manas-2010:p0271:b001:l044","ordinal":12234,"en":"He will slaughter every one."},{"id":"manas-2010:p0271:b001:l045","ordinal":12235,"en":"If he is an enemy, a foe,"},{"id":"manas-2010:p0271:b001:l046","ordinal":12236,"en":"He will bring us all to our end."},{"id":"manas-2010:p0271:b001:l047","ordinal":12237,"en":"He will roar and launch an attack;"},{"id":"manas-2010:p0271:b001:l048","ordinal":12238,"en":"Slaughtering you all,"},{"id":"manas-2010:p0272:b001:l001","ordinal":12239,"en":"He will cut off heads with his sword,"},{"id":"manas-2010:p0272:b001:l002","ordinal":12240,"en":"He will bring disaster upon us."},{"id":"manas-2010:p0272:b001:l003","ordinal":12241,"en":"He is a hero of fearsome appearance!”"},{"id":"manas-2010:p0272:b001:l004","ordinal":12242,"en":"The hearing ear, the seeing eye,"},{"id":"manas-2010:p0272:b001:l005","ordinal":12243,"en":"Hurrying and flurrying, stumbling in haste,"},{"id":"manas-2010:p0272:b001:l006","ordinal":12244,"en":"Stood speaking these words."},{"id":"manas-2010:p0272:b001:l007","ordinal":12245,"en":"In the high-built fortress,"},{"id":"manas-2010:p0272:b001:l008","ordinal":12246,"en":"In Khan Koshoy's court,"},{"id":"manas-2010:p0272:b001:l009","ordinal":12247,"en":"My elder, old Koshoy,"},{"id":"manas-2010:p0272:b001:l010","ordinal":12248,"en":"The white-bearded saint,"},{"id":"manas-2010:p0272:b001:l011","ordinal":12249,"en":"Khan Koshoy of the Katagan,"},{"id":"manas-2010:p0272:b001:l012","ordinal":12250,"en":"That Koshoy of sacred power,"},{"id":"manas-2010:p0272:b001:l013","ordinal":12251,"en":"Who dwelt at Chech-Töbö,"},{"id":"manas-2010:p0272:b001:l014","ordinal":12252,"en":"Whom no contender had defeated,"},{"id":"manas-2010:p0272:b001:l015","ordinal":12253,"en":"Whom no man had made to bow,"},{"id":"manas-2010:p0272:b001:l016","ordinal":12254,"en":"Whose opponents did not survive,"},{"id":"manas-2010:p0272:b001:l017","ordinal":12255,"en":"Whom no one had troubled,"},{"id":"manas-2010:p0272:b001:l018","ordinal":12256,"en":"Whom no man dared to face,"},{"id":"manas-2010:p0272:b001:l019","ordinal":12257,"en":"Whose blessing enriched the nation,"},{"id":"manas-2010:p0272:b001:l020","ordinal":12258,"en":"Who brought light to those he regarded—"},{"id":"manas-2010:p0272:b001:l021","ordinal":12259,"en":"At that time hero Koshoy"},{"id":"manas-2010:p0272:b001:l022","ordinal":12260,"en":"Kept guards and gathered warriors,"},{"id":"manas-2010:p0272:b001:l023","ordinal":12261,"en":"Gathered all his champions together."},{"id":"manas-2010:p0272:b001:l024","ordinal":12262,"en":"Chech-Töbö in At-Bashy,"},{"id":"manas-2010:p0272:b001:l025","ordinal":12263,"en":"Making Chech-Töbö his home,"},{"id":"manas-2010:p0272:b001:l026","ordinal":12264,"en":"Your worthy elder Koshoy"},{"id":"manas-2010:p0272:b001:l027","ordinal":12265,"en":"Made a hero of his aged self."},{"id":"manas-2010:p0272:b001:l028","ordinal":12266,"en":"Kara-Too, stretching across the way,"},{"id":"manas-2010:p0272:b001:l029","ordinal":12267,"en":"He had lookouts watch from there."},{"id":"manas-2010:p0272:b001:l030","ordinal":12268,"en":"Your brave elder Koshoy"},{"id":"manas-2010:p0272:b001:l031","ordinal":12269,"en":"Had gathered the heroes."},{"id":"manas-2010:p0272:b001:l032","ordinal":12270,"en":"Making all his troops ready,"},{"id":"manas-2010:p0272:b001:l033","ordinal":12271,"en":"Of the men who traded blows with him,"},{"id":"manas-2010:p0272:b001:l034","ordinal":12272,"en":"Every one he had taken—"},{"id":"manas-2010:p0272:b001:l035","ordinal":12273,"en":"Your elder Koshoy had brought them under his rule."},{"id":"manas-2010:p0272:b001:l036","ordinal":12274,"en":"Your worthy elder Koshoy,"},{"id":"manas-2010:p0272:b001:l037","ordinal":12275,"en":"Making Zheti-Özön his home,"},{"id":"manas-2010:p0272:b001:l038","ordinal":12276,"en":"The lost and scattered people—"},{"id":"manas-2010:p0272:b001:l039","ordinal":12277,"en":"Your elder Koshoy had taken the lead."},{"id":"manas-2010:p0272:b001:l040","ordinal":12278,"en":"Hero Koshoy had many troops;"},{"id":"manas-2010:p0272:b001:l041","ordinal":12279,"en":"Among those troops,"},{"id":"manas-2010:p0272:b001:l042","ordinal":12280,"en":"Choosing a star in the sky together,"},{"id":"manas-2010:p0272:b001:l043","ordinal":12281,"en":"Kudaynazar the bare club"},{"id":"manas-2010:p0272:b001:l044","ordinal":12282,"en":"And old Koshoy had sworn friendship."},{"id":"manas-2010:p0272:b001:l045","ordinal":12283,"en":"Koshoy Khan's many companions,"},{"id":"manas-2010:p0272:b001:l046","ordinal":12284,"en":"Hearing the messenger's words,"},{"id":"manas-2010:p0272:b001:l047","ordinal":12285,"en":"Hearing, ‘A formidable man is coming,’"},{"id":"manas-2010:p0272:b001:l048","ordinal":12286,"en":"And their great elder Koshoy,"},{"id":"manas-2010:p0273:b001:l001","ordinal":12287,"en":"All fell into turmoil,"},{"id":"manas-2010:p0273:b001:l002","ordinal":12288,"en":"All the troops who had gathered."}]
