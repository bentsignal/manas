[{"id":"manas-2010:p1775:b001:l029","ordinal":76289,"en":"Own it and ride it,’ she said."},{"id":"manas-2010:p1775:b001:l030","ordinal":76290,"en":"Thus the roan came as an inheritance."},{"id":"manas-2010:p1775:b001:l031","ordinal":76291,"en":"Talas and broad Kyrym"},{"id":"manas-2010:p1775:b001:l032","ordinal":76292,"en":"Lay forty days' journey apart."},{"id":"manas-2010:p1775:b001:l033","ordinal":76293,"en":"Ajybai traveled tirelessly;"},{"id":"manas-2010:p1775:b001:l034","ordinal":76294,"en":"To the corners of the world,"},{"id":"manas-2010:p1775:b001:l035","ordinal":76295,"en":"He brought the news."},{"id":"manas-2010:p1775:b001:l036","ordinal":76296,"en":"Kökbörü, Urumkhan's son,"},{"id":"manas-2010:p1775:b001:l037","ordinal":76297,"en":"Woke with a start from sleep,"},{"id":"manas-2010:p1775:b001:l038","ordinal":76298,"en":"Turned onto his right side,"},{"id":"manas-2010:p1775:b001:l039","ordinal":76299,"en":"Hastened to say his prayers,"},{"id":"manas-2010:p1775:b001:l040","ordinal":76300,"en":"Saddled Kuukazyk,"},{"id":"manas-2010:p1775:b001:l041","ordinal":76301,"en":"Dipped his hands in water,"},{"id":"manas-2010:p1775:b001:l042","ordinal":76302,"en":"And performed ablution for his hands."},{"id":"manas-2010:p1776:b001:l001","ordinal":76303,"en":"Pleading with the Almighty,"},{"id":"manas-2010:p1776:b001:l002","ordinal":76304,"en":"His companion and friend Manas"},{"id":"manas-2010:p1776:b001:l003","ordinal":76305,"en":"He longed for deeply."},{"id":"manas-2010:p1776:b001:l004","ordinal":76306,"en":"Hearing news from those who came,"},{"id":"manas-2010:p1776:b001:l005","ordinal":76307,"en":"That with forty-two myriads of troops"},{"id":"manas-2010:p1776:b001:l006","ordinal":76308,"en":"He had gone to Beijing,"},{"id":"manas-2010:p1776:b001:l007","ordinal":76309,"en":"Kökbörü grew troubled."},{"id":"manas-2010:p1776:b001:l008","ordinal":76310,"en":"‘If my death is due, I shall die;"},{"id":"manas-2010:p1776:b001:l009","ordinal":76311,"en":"If he is still alive,"},{"id":"manas-2010:p1776:b001:l010","ordinal":76312,"en":"My friend, fierce-maned Manas,"},{"id":"manas-2010:p1776:b001:l011","ordinal":76313,"en":"I shall go and clasp his hand,’ he said."},{"id":"manas-2010:p1776:b001:l012","ordinal":76314,"en":"Külnar, Khan Karacha's daughter,"},{"id":"manas-2010:p1776:b001:l013","ordinal":76315,"en":"Kökbörü's wife,"},{"id":"manas-2010:p1776:b001:l014","ordinal":76316,"en":"Had wisdom beyond other people's."},{"id":"manas-2010:p1776:b001:l015","ordinal":76317,"en":"It was not darkness, but night itself;"},{"id":"manas-2010:p1776:b001:l016","ordinal":76318,"en":"She herself was a wondrous handmaiden,"},{"id":"manas-2010:p1776:b001:l017","ordinal":76319,"en":"Beauty among the dark-complexioned,"},{"id":"manas-2010:p1776:b001:l018","ordinal":76320,"en":"The finest among women."},{"id":"manas-2010:p1776:b001:l019","ordinal":76321,"en":"‘My friend for the life beyond, Manas,"},{"id":"manas-2010:p1776:b001:l020","ordinal":76322,"en":"At last I shall see his face."},{"id":"manas-2010:p1776:b001:l021","ordinal":76323,"en":"If Manas has died,"},{"id":"manas-2010:p1776:b001:l022","ordinal":76324,"en":"I shall go and recite the Quran for him."},{"id":"manas-2010:p1776:b001:l023","ordinal":76325,"en":"If Kanykey is in distress,"},{"id":"manas-2010:p1776:b001:l024","ordinal":76326,"en":"I shall offer my family friend condolences."},{"id":"manas-2010:p1776:b001:l025","ordinal":76327,"en":"If he is alive,"},{"id":"manas-2010:p1776:b001:l026","ordinal":76328,"en":"For the boy Semetey,"},{"id":"manas-2010:p1776:b001:l027","ordinal":76329,"en":"I shall celebrate his birth before returning,’ she said."},{"id":"manas-2010:p1776:b001:l028","ordinal":76330,"en":"Yellow gold coins and white silver"},{"id":"manas-2010:p1776:b001:l029","ordinal":76331,"en":"They loaded upon an elephant."},{"id":"manas-2010:p1776:b001:l030","ordinal":76332,"en":"Traveling many roads tirelessly,"},{"id":"manas-2010:p1776:b001:l031","ordinal":76333,"en":"Toward Manas, Kökbörü"},{"id":"manas-2010:p1776:b001:l032","ordinal":76334,"en":"Had set out on his journey."},{"id":"manas-2010:p1776:b001:l033","ordinal":76335,"en":"During his journey,"},{"id":"manas-2010:p1776:b001:l034","ordinal":76336,"en":"Ajybai, son of the Argyn,"},{"id":"manas-2010:p1776:b001:l035","ordinal":76337,"en":"Surging on his mighty steed,"},{"id":"manas-2010:p1776:b001:l036","ordinal":76338,"en":"Toward Urumkhan's son Kökbörü,"},{"id":"manas-2010:p1776:b001:l037","ordinal":76339,"en":"Went out to meet him."},{"id":"manas-2010:p1776:b001:l038","ordinal":76340,"en":"They exchanged their due greetings;"},{"id":"manas-2010:p1776:b001:l039","ordinal":76341,"en":"Kökbörü did not stand idly."},{"id":"manas-2010:p1776:b001:l040","ordinal":76342,"en":"When he saw Ajybai,"},{"id":"manas-2010:p1776:b001:l041","ordinal":76343,"en":"He asked about all the fierce heroes."},{"id":"manas-2010:p1776:b001:l042","ordinal":76344,"en":"“Broad Talas, the tamarisk-lined river,"},{"id":"manas-2010:p1777:b001:l001","ordinal":76345,"en":"Is your land at peace?"},{"id":"manas-2010:p1777:b001:l002","ordinal":76346,"en":"The prosperous Kyrgyz and many Argyn,"},{"id":"manas-2010:p1777:b001:l003","ordinal":76347,"en":"Are your people at peace?"},{"id":"manas-2010:p1777:b001:l004","ordinal":76348,"en":"Youngest of the six lions,"},{"id":"manas-2010:p1777:b001:l005","ordinal":76349,"en":"The servant beloved of God,"},{"id":"manas-2010:p1777:b001:l006","ordinal":76350,"en":"My generous leopard Manas,"},{"id":"manas-2010:p1777:b001:l007","ordinal":76351,"en":"Is your lion well?"},{"id":"manas-2010:p1777:b001:l008","ordinal":76352,"en":"Finding sight in darkness,"},{"id":"manas-2010:p1777:b001:l009","ordinal":76353,"en":"Finding words in an unexpected crisis,"},{"id":"manas-2010:p1777:b001:l010","ordinal":76354,"en":"Set at the front, bringing good fortune,"},{"id":"manas-2010:p1777:b001:l011","ordinal":76355,"en":"Driving the foe, like a vast army,"},{"id":"manas-2010:p1777:b001:l012","ordinal":76356,"en":"Wearing a gray lynx-fur cap,"},{"id":"manas-2010:p1777:b001:l013","ordinal":76357,"en":"Wielding a mottled-gray shield,"},{"id":"manas-2010:p1777:b001:l014","ordinal":76358,"en":"His head arrayed in gold,"},{"id":"manas-2010:p1777:b001:l015","ordinal":76359,"en":"His feet supported by pure silver,"},{"id":"manas-2010:p1777:b001:l016","ordinal":76360,"en":"The people's nightingale, Khan Bakai,"},{"id":"manas-2010:p1777:b001:l017","ordinal":76361,"en":"Is your lord well?"},{"id":"manas-2010:p1777:b001:l018","ordinal":76362,"en":"Made pure from the dark faith,"},{"id":"manas-2010:p1777:b001:l019","ordinal":76363,"en":"Fleeing China and becoming an outsider,"},{"id":"manas-2010:p1777:b001:l020","ordinal":76364,"en":"Khan Aziz's fierce-maned son,"},{"id":"manas-2010:p1777:b001:l021","ordinal":76365,"en":"Is dear Alma well?"},{"id":"manas-2010:p1777:b001:l022","ordinal":76366,"en":"Whom no man's strength could match in combat,"},{"id":"manas-2010:p1777:b001:l023","ordinal":76367,"en":"Whom a wolf's teeth could not pierce,"},{"id":"manas-2010:p1777:b001:l024","ordinal":76368,"en":"Champion of the Oyguts,"},{"id":"manas-2010:p1777:b001:l025","ordinal":76369,"en":"Akbaltay's Chubak,"},{"id":"manas-2010:p1777:b001:l026","ordinal":76370,"en":"Is your lion well?"},{"id":"manas-2010:p1777:b001:l027","ordinal":76371,"en":"Girding a leather belt about his waist,"},{"id":"manas-2010:p1777:b001:l028","ordinal":76372,"en":"If seven myriads of troops came,"},{"id":"manas-2010:p1777:b001:l029","ordinal":76373,"en":"He attacked among them alone."},{"id":"manas-2010:p1777:b001:l030","ordinal":76374,"en":"The edge of black steel,"},{"id":"manas-2010:p1777:b001:l031","ordinal":76375,"en":"Khan Manas's Syrgak,"},{"id":"manas-2010:p1777:b001:l032","ordinal":76376,"en":"Is your young one well?"},{"id":"manas-2010:p1777:b001:l033","ordinal":76377,"en":"Old Kyrgyl, leader of the forty,"},{"id":"manas-2010:p1777:b001:l034","ordinal":76378,"en":"Is your elder alive and well?"},{"id":"manas-2010:p1777:b001:l035","ordinal":76379,"en":"Yraman's Singer Son,"},{"id":"manas-2010:p1777:b001:l036","ordinal":76380,"en":"Are you all alive and well?"},{"id":"manas-2010:p1777:b001:l037","ordinal":76381,"en":"Drinking poison when told to drink water,"},{"id":"manas-2010:p1777:b001:l038","ordinal":76382,"en":"Cutting off heads when told to take caps,"},{"id":"manas-2010:p1777:b001:l039","ordinal":76383,"en":"Spilling gut contents when told to shed blood,"},{"id":"manas-2010:p1777:b001:l040","ordinal":76384,"en":"Never drawing back from a thrust,"},{"id":"manas-2010:p1777:b001:l041","ordinal":76385,"en":"Never relaxing his stern bearing,"},{"id":"manas-2010:p1777:b001:l042","ordinal":76386,"en":"Never drawing back from bullets,"},{"id":"manas-2010:p1778:b001:l001","ordinal":76387,"en":"Never drawing back from death,"},{"id":"manas-2010:p1778:b001:l002","ordinal":76388,"en":"Never fleeing when the enemy came,"},{"id":"manas-2010:p1778:b001:l003","ordinal":76389,"en":"Khan Manas's champions,"},{"id":"manas-2010:p1778:b001:l004","ordinal":76390,"en":"Are the companions alive and well?"},{"id":"manas-2010:p1778:b001:l005","ordinal":76391,"en":"The people we have known and heard of,"},{"id":"manas-2010:p1778:b001:l006","ordinal":76392,"en":"Are they all alive and well?"},{"id":"manas-2010:p1778:b001:l007","ordinal":76393,"en":"Our family mother Chyyrdy,"},{"id":"manas-2010:p1778:b001:l008","ordinal":76394,"en":"Is the elder alive and well?"},{"id":"manas-2010:p1778:b001:l009","ordinal":76395,"en":"Brave Manas's darling, born so late in life,"},{"id":"manas-2010:p1778:b001:l010","ordinal":76396,"en":"Given the name of brave Semetey,"},{"id":"manas-2010:p1778:b001:l011","ordinal":76397,"en":"Is his little lamp alive and well?”"},{"id":"manas-2010:p1778:b001:l012","ordinal":76398,"en":"Then Ajybai said:"},{"id":"manas-2010:p1778:b001:l013","ordinal":76399,"en":"“Dear friend, the people live, the khan lives;"},{"id":"manas-2010:p1778:b001:l014","ordinal":76400,"en":"Now we have been left in sorrow."},{"id":"manas-2010:p1778:b001:l015","ordinal":76401,"en":"The whole multitude is alive."},{"id":"manas-2010:p1778:b001:l016","ordinal":76402,"en":"Into Beijing where even holy Ali could not tread,"},{"id":"manas-2010:p1778:b001:l017","ordinal":76403,"en":"We cautiously sent scouts."},{"id":"manas-2010:p1778:b001:l018","ordinal":76404,"en":"All our noble ones"},{"id":"manas-2010:p1778:b001:l019","ordinal":76405,"en":"We lost to Great Beijing."},{"id":"manas-2010:p1778:b001:l020","ordinal":76406,"en":"Into Beijing untouched by Khydyr,"},{"id":"manas-2010:p1778:b001:l021","ordinal":76407,"en":"We entered from the side and were struck down."},{"id":"manas-2010:p1778:b001:l022","ordinal":76408,"en":"It was Allah's doing;"},{"id":"manas-2010:p1778:b001:l023","ordinal":76409,"en":"All our mighty ones"},{"id":"manas-2010:p1778:b001:l024","ordinal":76410,"en":"Were taken as gifts for the Chinese."},{"id":"manas-2010:p1778:b001:l025","ordinal":76411,"en":"Many a proud khan died;"},{"id":"manas-2010:p1778:b001:l026","ordinal":76412,"en":"Everyone who met that Beijing died."},{"id":"manas-2010:p1778:b001:l027","ordinal":76413,"en":"We lost Akkula to a bullet,"},{"id":"manas-2010:p1778:b001:l028","ordinal":76414,"en":"Let Almambet pass as a martyr,"},{"id":"manas-2010:p1778:b001:l029","ordinal":76415,"en":"Entered Beijing and turned back,"},{"id":"manas-2010:p1778:b001:l030","ordinal":76416,"en":"And the dear support bound to our waist,"},{"id":"manas-2010:p1778:b001:l031","ordinal":76417,"en":"Lord Chubak, we lost."},{"id":"manas-2010:p1778:b001:l032","ordinal":76418,"en":"Muzburchak and Khan Kökchö died."},{"id":"manas-2010:p1778:b001:l033","ordinal":76419,"en":"Beijing is a land of torment;"},{"id":"manas-2010:p1778:b001:l034","ordinal":76420,"en":"The Chinese are a formidable people."},{"id":"manas-2010:p1778:b001:l035","ordinal":76421,"en":"Everyone who met them died."},{"id":"manas-2010:p1778:b001:l036","ordinal":76422,"en":"Your friend, leopard Manas,"},{"id":"manas-2010:p1778:b001:l037","ordinal":76423,"en":"Sometimes can find his speech,"},{"id":"manas-2010:p1778:b001:l038","ordinal":76424,"en":"Sometimes cannot speak."},{"id":"manas-2010:p1778:b001:l039","ordinal":76425,"en":"Your friend Manas, one soul with you,"},{"id":"manas-2010:p1778:b001:l040","ordinal":76426,"en":"Coughs with heavy thuds;"},{"id":"manas-2010:p1778:b001:l041","ordinal":76427,"en":"He raises his head from the pillow."},{"id":"manas-2010:p1778:b001:l042","ordinal":76428,"en":"When he rises and cries, ‘Oh!’"},{"id":"manas-2010:p1779:b001:l001","ordinal":76429,"en":"From the leopard's mouth"},{"id":"manas-2010:p1779:b001:l002","ordinal":76430,"en":"Blood comes gush after gush."},{"id":"manas-2010:p1779:b001:l003","ordinal":76431,"en":"He coughs with sharp cracks,"},{"id":"manas-2010:p1779:b001:l004","ordinal":76432,"en":"Raises his head from the pillow;"},{"id":"manas-2010:p1779:b001:l005","ordinal":76433,"en":"When he stirs and cries, ‘Ah!’"},{"id":"manas-2010:p1779:b001:l006","ordinal":76434,"en":"Blood comes shovelful after shovelful."},{"id":"manas-2010:p1779:b001:l007","ordinal":76435,"en":"Weeping in anguish every day,"},{"id":"manas-2010:p1779:b001:l008","ordinal":76436,"en":"Your family friend Kanykey loses her strength."},{"id":"manas-2010:p1779:b001:l009","ordinal":76437,"en":"His threadlike mustache lies flattened;"},{"id":"manas-2010:p1779:b001:l010","ordinal":76438,"en":"He looks wildly toward Judgment Day."},{"id":"manas-2010:p1779:b001:l011","ordinal":76439,"en":"‘The name honored by khans,’"},{"id":"manas-2010:p1779:b001:l012","ordinal":76440,"en":"Dear fierce Kanykey says;"},{"id":"manas-2010:p1779:b001:l013","ordinal":76441,"en":"Here is the letter she gave for you.”"},{"id":"manas-2010:p1779:b001:l014","ordinal":76442,"en":"It was a letter small as a palm."},{"id":"manas-2010:p1779:b001:l015","ordinal":76443,"en":"Taking it and looking,"},{"id":"manas-2010:p1779:b001:l016","ordinal":76444,"en":"He saw Khan Kökbörü's name."},{"id":"manas-2010:p1779:b001:l017","ordinal":76445,"en":"“Without rest by day,"},{"id":"manas-2010:p1779:b001:l018","ordinal":76446,"en":"Without sleep by night,"},{"id":"manas-2010:p1779:b001:l019","ordinal":76447,"en":"A grievous affair has pressed upon us;"},{"id":"manas-2010:p1779:b001:l020","ordinal":76448,"en":"A dreadful affair has closed upon us."},{"id":"manas-2010:p1779:b001:l021","ordinal":76449,"en":"Let him travel day and night,"},{"id":"manas-2010:p1779:b001:l022","ordinal":76450,"en":"His blessed friend Manas"},{"id":"manas-2010:p1779:b001:l023","ordinal":76451,"en":"Let him see while he lives.”"},{"id":"manas-2010:p1779:b001:l024","ordinal":76452,"en":"It was Kanykey's letter,"},{"id":"manas-2010:p1779:b001:l025","ordinal":76453,"en":"In Khan Bakai's name."},{"id":"manas-2010:p1779:b001:l026","ordinal":76454,"en":"When he saw that letter,"},{"id":"manas-2010:p1779:b001:l027","ordinal":76455,"en":"Kökbörü's son,"},{"id":"manas-2010:p1779:b001:l028","ordinal":76456,"en":"The servant beloved of God,"},{"id":"manas-2010:p1779:b001:l029","ordinal":76457,"en":"A spring among the hills,"},{"id":"manas-2010:p1779:b001:l030","ordinal":76458,"en":"Was he not born to Kökbörü so late in life,"},{"id":"manas-2010:p1779:b001:l031","ordinal":76459,"en":"His lamp Koyonaaly?"},{"id":"manas-2010:p1779:b001:l032","ordinal":76460,"en":"“My family father Manas,"},{"id":"manas-2010:p1779:b001:l033","ordinal":76461,"en":"I shall bury with my own hands."},{"id":"manas-2010:p1779:b001:l034","ordinal":76462,"en":"Beyond Kökötöy's memorial feast,"},{"id":"manas-2010:p1779:b001:l035","ordinal":76463,"en":"Doing a still greater deed,"},{"id":"manas-2010:p1779:b001:l036","ordinal":76464,"en":"I shall bury him with solemn ceremony."},{"id":"manas-2010:p1779:b001:l037","ordinal":76465,"en":"I shall gird my waist firmly;"},{"id":"manas-2010:p1779:b001:l038","ordinal":76466,"en":"From the Chinese of Beijing,"},{"id":"manas-2010:p1779:b001:l039","ordinal":76467,"en":"For my family father Manas,"},{"id":"manas-2010:p1779:b001:l040","ordinal":76468,"en":"I shall press his blood-price all the harder."},{"id":"manas-2010:p1779:b001:l041","ordinal":76469,"en":"I shall attend his funeral;"},{"id":"manas-2010:p1779:b001:l042","ordinal":76470,"en":"For my mighty family father,"},{"id":"manas-2010:p1780:b001:l001","ordinal":76471,"en":"I myself shall render service."},{"id":"manas-2010:p1780:b001:l002","ordinal":76472,"en":"If anyone bears him enmity,"},{"id":"manas-2010:p1780:b001:l003","ordinal":76473,"en":"I shall trample upon his head."},{"id":"manas-2010:p1780:b001:l004","ordinal":76474,"en":"If a khan will not obey,"},{"id":"manas-2010:p1780:b001:l005","ordinal":76475,"en":"I shall scatter his four kinds of livestock."},{"id":"manas-2010:p1780:b001:l006","ordinal":76476,"en":"If anyone will not obey,"},{"id":"manas-2010:p1780:b001:l007","ordinal":76477,"en":"I shall raid him and slaughter his mares,"},{"id":"manas-2010:p1780:b001:l008","ordinal":76478,"en":"Strike his brains and scatter them,"},{"id":"manas-2010:p1780:b001:l009","ordinal":76479,"en":"Beat their owner grievously;"},{"id":"manas-2010:p1780:b001:l010","ordinal":76480,"en":"Thus I shall exact"},{"id":"manas-2010:p1780:b001:l011","ordinal":76481,"en":"Payment for his ancient wrongs."},{"id":"manas-2010:p1780:b001:l012","ordinal":76482,"en":"If a khan will not obey,"},{"id":"manas-2010:p1780:b001:l013","ordinal":76483,"en":"I shall plunder his fine cloth."},{"id":"manas-2010:p1780:b001:l014","ordinal":76484,"en":"This is my father's funeral;"},{"id":"manas-2010:p1780:b001:l015","ordinal":76485,"en":"I myself shall go without fail!”"},{"id":"manas-2010:p1780:b001:l016","ordinal":76486,"en":"Koyonaaly and Kökbörü"},{"id":"manas-2010:p1780:b001:l017","ordinal":76487,"en":"Traveled together to Talas,"},{"id":"manas-2010:p1780:b001:l018","ordinal":76488,"en":"To present themselves now"},{"id":"manas-2010:p1780:b001:l019","ordinal":76489,"en":"Before fierce-maned Sultan Manas."},{"id":"manas-2010:p1780:b001:l020","ordinal":76490,"en":"Dwelling in Maseyil,"},{"id":"manas-2010:p1780:b001:l021","ordinal":76491,"en":"Said to be the finest of all heroes,"},{"id":"manas-2010:p1780:b001:l022","ordinal":76492,"en":"Sowing his rice as an autumn crop,"},{"id":"manas-2010:p1780:b001:l023","ordinal":76493,"en":"Leaving no attacker alive,"},{"id":"manas-2010:p1780:b001:l024","ordinal":76494,"en":"Youngest of nine sons,"},{"id":"manas-2010:p1780:b001:l025","ordinal":76495,"en":"The Creator's servant,"},{"id":"manas-2010:p1780:b001:l026","ordinal":76496,"en":"Eleman's brave Töshtük—"},{"id":"manas-2010:p1780:b001:l027","ordinal":76497,"en":"Your champion Koyonaaly"},{"id":"manas-2010:p1780:b001:l028","ordinal":76498,"en":"Sent him this news, they say."},{"id":"manas-2010:p1780:b001:l029","ordinal":76499,"en":"Not relenting, the distinguished one"},{"id":"manas-2010:p1780:b001:l030","ordinal":76500,"en":"Eleman's Töshtük"},{"id":"manas-2010:p1780:b001:l031","ordinal":76501,"en":"Thus brought along, they say."},{"id":"manas-2010:p1780:b001:l032","ordinal":76502,"en":"Khan Koshoi of the Katagan,"},{"id":"manas-2010:p1780:b001:l033","ordinal":76503,"en":"The elder, father of his people,"},{"id":"manas-2010:p1780:b001:l034","ordinal":76504,"en":"Himself a saint favored by his patron,"},{"id":"manas-2010:p1780:b001:l035","ordinal":76505,"en":"Of countless black unbelievers,"},{"id":"manas-2010:p1780:b001:l036","ordinal":76506,"en":"Khan Koshoi had opened the doors;"},{"id":"manas-2010:p1780:b001:l037","ordinal":76507,"en":"Of tireless black unbelievers,"},{"id":"manas-2010:p1780:b001:l038","ordinal":76508,"en":"Brave Koshoi had trodden the place of honor."},{"id":"manas-2010:p1780:b001:l039","ordinal":76509,"en":"His steel in its black sheath,"},{"id":"manas-2010:p1780:b001:l040","ordinal":76510,"en":"Brave Koshoi had wielded and thrust."},{"id":"manas-2010:p1780:b001:l041","ordinal":76511,"en":"Waging many campaigns against unbelievers,"},{"id":"manas-2010:p1780:b001:l042","ordinal":76512,"en":"Brave Koshoi had pressed them hard."},{"id":"manas-2010:p1781:b001:l001","ordinal":76513,"en":"Without wounding the people's hearts,"},{"id":"manas-2010:p1781:b001:l002","ordinal":76514,"en":"The handful of Muslims"},{"id":"manas-2010:p1781:b001:l003","ordinal":76515,"en":"Brave Koshoi had ruled."},{"id":"manas-2010:p1781:b001:l004","ordinal":76516,"en":"The Chinese people's red gold,"},{"id":"manas-2010:p1781:b001:l005","ordinal":76517,"en":"Brave Koshoi had loaded and taken."},{"id":"manas-2010:p1781:b001:l006","ordinal":76518,"en":"When Aykojo's Bilerik"},{"id":"manas-2010:p1781:b001:l007","ordinal":76519,"en":"Fell into Chinese hands,"},{"id":"manas-2010:p1781:b001:l008","ordinal":76520,"en":"Bringing slaughter upon the Chinese,"},{"id":"manas-2010:p1781:b001:l009","ordinal":76521,"en":"Brave Koshoi had rescued him."},{"id":"manas-2010:p1781:b001:l010","ordinal":76522,"en":"His wide eyes were like the morning star;"},{"id":"manas-2010:p1781:b001:l011","ordinal":76523,"en":"His great ears were like shields."},{"id":"manas-2010:p1781:b001:l012","ordinal":76524,"en":"His blessing enriched the people,"},{"id":"manas-2010:p1781:b001:l013","ordinal":76525,"en":"Brought light to those he regarded."},{"id":"manas-2010:p1781:b001:l014","ordinal":76526,"en":"He had saddled a leopard,"},{"id":"manas-2010:p1781:b001:l015","ordinal":76527,"en":"Studied in Mecca for five years,"},{"id":"manas-2010:p1781:b001:l016","ordinal":76528,"en":"Received an old saint's blessing,"},{"id":"manas-2010:p1781:b001:l017","ordinal":76529,"en":"And was called old Koshoi."},{"id":"manas-2010:p1781:b001:l018","ordinal":76530,"en":"In Egypt and Baghdad,"},{"id":"manas-2010:p1781:b001:l019","ordinal":76531,"en":"He had studied five years there."},{"id":"manas-2010:p1781:b001:l020","ordinal":76532,"en":"He had received Khojosan's blessing,"},{"id":"manas-2010:p1781:b001:l021","ordinal":76533,"en":"And was called leopard Koshoi."},{"id":"manas-2010:p1781:b001:l022","ordinal":76534,"en":"Across the face of the earth,"},{"id":"manas-2010:p1781:b001:l023","ordinal":76535,"en":"He had sent the tidings all together."},{"id":"manas-2010:p1781:b001:l024","ordinal":76536,"en":"Khan Koshoi of the Katagan,"},{"id":"manas-2010:p1781:b001:l025","ordinal":76537,"en":"When he had grown old—"},{"id":"manas-2010:p1781:b001:l026","ordinal":76538,"en":"‘Your khan has fallen gravely ill,’"},{"id":"manas-2010:p1781:b001:l027","ordinal":76539,"en":"Your spirited Koyonaaly said."},{"id":"manas-2010:p1781:b001:l028","ordinal":76540,"en":"Khan Koshoi of the Katagan"},{"id":"manas-2010:p1781:b001:l029","ordinal":76541,"en":"He brought along in grief."},{"id":"manas-2010:p1781:b001:l030","ordinal":76542,"en":"Aykojo of Andijan, in his mottled coat—"},{"id":"manas-2010:p1781:b001:l031","ordinal":76543,"en":"‘For my family father Manas,"},{"id":"manas-2010:p1781:b001:l032","ordinal":76544,"en":"Stand at the funeral prayer,’ he said,"}]
