[{"id":"semetey-1-2013:p0100:b003:l010","ordinal":84481,"en":"Dawn broke to the nightingale's song."},{"id":"semetey-1-2013:p0100:b003:l011","ordinal":84482,"en":"Their champion Bakai beside them,"},{"id":"semetey-1-2013:p0100:b003:l012","ordinal":84483,"en":"The two ladies lay weeping."},{"id":"semetey-1-2013:p0100:b003:l013","ordinal":84484,"en":"While the two ladies wept,"},{"id":"semetey-1-2013:p0100:b003:l014","ordinal":84485,"en":"“Hey, Kanykei, my foal,"},{"id":"semetey-1-2013:p0100:b003:l015","ordinal":84486,"en":"We have reached the cave; do not cry."},{"id":"semetey-1-2013:p0100:b003:l016","ordinal":84487,"en":"Do not torment yourself for nothing!"},{"id":"semetey-1-2013:p0100:b003:l017","ordinal":84488,"en":"It would be disgrace to lose him."},{"id":"semetey-1-2013:p0100:b003:l018","ordinal":84489,"en":"Worry for me six days;"},{"id":"semetey-1-2013:p0100:b003:l019","ordinal":84490,"en":"I entrust my orphan to you!”"},{"id":"semetey-1-2013:p0100:b003:l020","ordinal":84491,"en":"The two ladies entered the cave."},{"id":"semetey-1-2013:p0100:b003:l021","ordinal":84492,"en":"Their ribs seemed torn apart,"},{"id":"semetey-1-2013:p0100:b003:l022","ordinal":84493,"en":"Their precious eyes like currants,"},{"id":"semetey-1-2013:p0100:b003:l023","ordinal":84494,"en":"With Semetey between them,"},{"id":"semetey-1-2013:p0100:b003:l024","ordinal":84495,"en":"The two ladies brooded and wept,"},{"id":"semetey-1-2013:p0100:b003:l025","ordinal":84496,"en":"Their tears pouring down."},{"id":"semetey-1-2013:p0100:b003:l026","ordinal":84497,"en":"Then Bakai thought,"},{"id":"semetey-1-2013:p0100:b003:l027","ordinal":84498,"en":"“My mother has come exhausted,"},{"id":"semetey-1-2013:p0100:b003:l028","ordinal":84499,"en":"Kanykei has come weary;"},{"id":"semetey-1-2013:p0100:b003:l029","ordinal":84500,"en":"The jagged stones of Kara-Ungkur"},{"id":"semetey-1-2013:p0100:b003:l030","ordinal":84501,"en":"Will pierce their hips.”"},{"id":"semetey-1-2013:p0100:b003:l031","ordinal":84502,"en":"Resourceful old Bakai,"},{"id":"semetey-1-2013:p0100:b003:l032","ordinal":84503,"en":"The saint who had seen so much,"},{"id":"semetey-1-2013:p0100:b003:l033","ordinal":84504,"en":"The fescue on the yellow slope"},{"id":"semetey-1-2013:p0100:b003:l034","ordinal":84505,"en":"He uprooted by the roots."},{"id":"semetey-1-2013:p0100:b003:l035","ordinal":84506,"en":"A little shelter's worth of fescue"},{"id":"semetey-1-2013:p0100:b003:l036","ordinal":84507,"en":"Your tiger Bakai uprooted"},{"id":"semetey-1-2013:p0100:b003:l037","ordinal":84508,"en":"And spread inside the cave."},{"id":"semetey-1-2013:p0100:b003:l038","ordinal":84509,"en":"The two ladies lay down."},{"id":"semetey-1-2013:p0100:b003:l039","ordinal":84510,"en":"Leaning upon their elbows, they slept,"},{"id":"semetey-1-2013:p0100:b004:l001","ordinal":84511,"en":"Napping and taking their rest,"},{"id":"semetey-1-2013:p0100:b004:l002","ordinal":84512,"en":"Their eyes closing in sleep."},{"id":"semetey-1-2013:p0100:b004:l003","ordinal":84513,"en":"Your sultan, Lion Bakai,"},{"id":"semetey-1-2013:p0100:b004:l004","ordinal":84514,"en":"Spurred along on the gray steed;"},{"id":"semetey-1-2013:p0100:b004:l005","ordinal":84515,"en":"Bakai searched the hills."},{"id":"semetey-1-2013:p0100:b004:l006","ordinal":84516,"en":"A consummate hunter, greatly skilled,"},{"id":"semetey-1-2013:p0100:b004:l007","ordinal":84517,"en":"Mighty Bakai, the peerless hunter,"},{"id":"semetey-1-2013:p0100:b004:l008","ordinal":84518,"en":"For his orphan and the widow"},{"id":"semetey-1-2013:p0100:b004:l009","ordinal":84519,"en":"Now sought provisions."},{"id":"semetey-1-2013:p0100:b004:l010","ordinal":84520,"en":"In the blinking of an eye,"},{"id":"semetey-1-2013:p0100:b004:l011","ordinal":84521,"en":"Before a word could be said,"},{"id":"semetey-1-2013:p0100:b004:l012","ordinal":84522,"en":"Fortunate Bakai the leopard"},{"id":"semetey-1-2013:p0100:b004:l013","ordinal":84523,"en":"Shot six wild ewes and four wild rams;"},{"id":"semetey-1-2013:p0100:b004:l014","ordinal":84524,"en":"Bakai loaded them up"},{"id":"semetey-1-2013:p0100:b004:l015","ordinal":84525,"en":"And returned in an instant."},{"id":"semetey-1-2013:p0100:b004:l016","ordinal":84526,"en":"Bringing them to the cave, he unloaded them."},{"id":"semetey-1-2013:p0100:b004:l017","ordinal":84527,"en":"That Bakai the leopard,"},{"id":"semetey-1-2013:p0100:b004:l018","ordinal":84528,"en":"With Aktinte, bought for six calves"},{"id":"semetey-1-2013:p0100:b004:l019","ordinal":84529,"en":"And four yearling horses,"},{"id":"semetey-1-2013:p0100:b004:l020","ordinal":84530,"en":"Slit this way and that."},{"id":"semetey-1-2013:p0100:b004:l021","ordinal":84531,"en":"The ladies who had come in anguish"},{"id":"semetey-1-2013:p0100:b004:l022","ordinal":84532,"en":"Saw it plainly,"},{"id":"semetey-1-2013:p0100:b004:l023","ordinal":84533,"en":"Tugging at his leg in distress,"},{"id":"semetey-1-2013:p0100:b004:l024","ordinal":84534,"en":"Pleading with their uncle who had hunted,"},{"id":"semetey-1-2013:p0100:b004:l025","ordinal":84535,"en":"With Khan Bakai."},{"id":"semetey-1-2013:p0100:b004:l026","ordinal":84536,"en":"Knowing their hunger,"},{"id":"semetey-1-2013:p0100:b004:l027","ordinal":84537,"en":"Precious old Bakai"},{"id":"semetey-1-2013:p0100:b004:l028","ordinal":84538,"en":"Cut up the joints without delay;"},{"id":"semetey-1-2013:p0100:b004:l029","ordinal":84539,"en":"Your resourceful uncle butchered the game."},{"id":"semetey-1-2013:p0100:b004:l030","ordinal":84540,"en":"The travel kettle from the saddle straps"},{"id":"semetey-1-2013:p0100:b004:l031","ordinal":84541,"en":"On a hearth of three stones"},{"id":"semetey-1-2013:p0100:b004:l032","ordinal":84542,"en":"Your sister-in-law Kanykei set."},{"id":"semetey-1-2013:p0100:b004:l033","ordinal":84543,"en":"Rump and sweet, fatty meat"},{"id":"semetey-1-2013:p0100:b004:l034","ordinal":84544,"en":"She put on to boil."},{"id":"semetey-1-2013:p0100:b004:l035","ordinal":84545,"en":"Your widows ate their fill."},{"id":"semetey-1-2013:p0100:b004:l036","ordinal":84546,"en":"The marrow from the bones"},{"id":"semetey-1-2013:p0100:b004:l037","ordinal":84547,"en":"He knocked out for sucking"},{"id":"semetey-1-2013:p0100:b004:l038","ordinal":84548,"en":"And gave to Semetey."},{"id":"semetey-1-2013:p0100:b004:l039","ordinal":84549,"en":"Rekindling their extinguished fire,"},{"id":"semetey-1-2013:p0101:b003:l001","ordinal":84550,"en":"Your ruler, old Bakai,"},{"id":"semetey-1-2013:p0101:b003:l002","ordinal":84551,"en":"Brought their dead souls back to life."},{"id":"semetey-1-2013:p0101:b003:l003","ordinal":84552,"en":"He gathered what was scattered,"},{"id":"semetey-1-2013:p0101:b003:l004","ordinal":84553,"en":"Joined what was broken."},{"id":"semetey-1-2013:p0101:b003:l005","ordinal":84554,"en":"Nourishing their wasted bodies,"},{"id":"semetey-1-2013:p0101:b003:l006","ordinal":84555,"en":"He filled their hungry bellies."},{"id":"semetey-1-2013:p0101:b003:l007","ordinal":84556,"en":"Your uncle, old Bakai,"},{"id":"semetey-1-2013:p0101:b003:l008","ordinal":84557,"en":"The saint who had seen everything,"},{"id":"semetey-1-2013:p0101:b003:l009","ordinal":84558,"en":"Dry meadowsweet and dry serviceberry,"},{"id":"semetey-1-2013:p0101:b003:l010","ordinal":84559,"en":"Firewood that gave no smoke,"},{"id":"semetey-1-2013:p0101:b003:l011","ordinal":84560,"en":"Uprooted whole."},{"id":"semetey-1-2013:p0101:b003:l012","ordinal":84561,"en":"Enough to last seven days,"},{"id":"semetey-1-2013:p0101:b003:l013","ordinal":84562,"en":"He prepared their firewood."},{"id":"semetey-1-2013:p0101:b003:l014","ordinal":84563,"en":"Enough for a generous month,"},{"id":"semetey-1-2013:p0101:b003:l015","ordinal":84564,"en":"He prepared their meat."},{"id":"semetey-1-2013:p0101:b003:l016","ordinal":84565,"en":"The lion turned his head;"},{"id":"semetey-1-2013:p0101:b003:l017","ordinal":84566,"en":"To unfortunate Kanykei"},{"id":"semetey-1-2013:p0101:b003:l018","ordinal":84567,"en":"He offered counsel:"},{"id":"semetey-1-2013:p0101:b003:l019","ordinal":84568,"en":"“Oh, Kanykei, my foal,"},{"id":"semetey-1-2013:p0101:b003:l020","ordinal":84569,"en":"Do not pick up Semetey"},{"id":"semetey-1-2013:p0101:b003:l021","ordinal":84570,"en":"And walk away to boil my misery."},{"id":"semetey-1-2013:p0101:b003:l022","ordinal":84571,"en":"All the provisions made ready for you—"},{"id":"semetey-1-2013:p0101:b003:l023","ordinal":84572,"en":"Do not scatter them and boil my misery."},{"id":"semetey-1-2013:p0101:b003:l024","ordinal":84573,"en":"Setting your face toward Kara Khan,"},{"id":"semetey-1-2013:p0101:b003:l025","ordinal":84574,"en":"Do not flee and boil my misery!"},{"id":"semetey-1-2013:p0101:b003:l026","ordinal":84575,"en":"Oh, Kanykei, my foal,"},{"id":"semetey-1-2013:p0101:b003:l027","ordinal":84576,"en":"You were a slavewoman built like a hero,"},{"id":"semetey-1-2013:p0101:b003:l028","ordinal":84577,"en":"You were a dark-hearted child."},{"id":"semetey-1-2013:p0101:b003:l029","ordinal":84578,"en":"Oh, Kanykei, my foal,"},{"id":"semetey-1-2013:p0101:b003:l030","ordinal":84579,"en":"You were a soul of sacred power."},{"id":"semetey-1-2013:p0101:b003:l031","ordinal":84580,"en":"Hear my words."},{"id":"semetey-1-2013:p0101:b003:l032","ordinal":84581,"en":"Unless I die, I shall return;"},{"id":"semetey-1-2013:p0101:b003:l033","ordinal":84582,"en":"Wait to look into my eyes!"},{"id":"semetey-1-2013:p0101:b003:l034","ordinal":84583,"en":"Oh, Kanykei, my foal,"},{"id":"semetey-1-2013:p0101:b003:l035","ordinal":84584,"en":"If you refuse to hear me,"},{"id":"semetey-1-2013:p0101:b003:l036","ordinal":84585,"en":"My child, I shall know your humanity."},{"id":"semetey-1-2013:p0101:b003:l037","ordinal":84586,"en":"Semetey, whom I cradle—"},{"id":"semetey-1-2013:p0101:b003:l038","ordinal":84587,"en":"If you leave without showing me my only one,"},{"id":"semetey-1-2013:p0101:b004:l001","ordinal":84588,"en":"I shall wander, sobbing and wailing."},{"id":"semetey-1-2013:p0101:b004:l002","ordinal":84589,"en":"If what is told is true,"},{"id":"semetey-1-2013:p0101:b004:l003","ordinal":84590,"en":"On the coming Day of Judgment,"},{"id":"semetey-1-2013:p0101:b004:l004","ordinal":84591,"en":"I shall seize your collar and cry out,"},{"id":"semetey-1-2013:p0101:b004:l005","ordinal":84592,"en":"Demanding him from you!"},{"id":"semetey-1-2013:p0101:b004:l006","ordinal":84593,"en":"If, after taking your words to heart,"},{"id":"semetey-1-2013:p0101:b004:l007","ordinal":84594,"en":"I leave with a lie,"},{"id":"semetey-1-2013:p0101:b004:l008","ordinal":84595,"en":"You will know my foolishness."},{"id":"semetey-1-2013:p0101:b004:l009","ordinal":84596,"en":"Saying, ‘You went away with a lie,"},{"id":"semetey-1-2013:p0101:b004:l010","ordinal":84597,"en":"You left me in the wilderness,"},{"id":"semetey-1-2013:p0101:b004:l011","ordinal":84598,"en":"You brought me to ruin this way,’"},{"id":"semetey-1-2013:p0101:b004:l012","ordinal":84599,"en":"When Judgment comes,"},{"id":"semetey-1-2013:p0101:b004:l013","ordinal":84600,"en":"My foal, make me a black donkey and ride me!"},{"id":"semetey-1-2013:p0101:b004:l015","ordinal":84601,"en":"Oh, Kanykei, my foal,"},{"id":"semetey-1-2013:p0101:b004:l016","ordinal":84602,"en":"Tie up the hair at your nape."},{"id":"semetey-1-2013:p0101:b004:l017","ordinal":84603,"en":"Worry for me seven days."},{"id":"semetey-1-2013:p0101:b004:l018","ordinal":84604,"en":"If I remain away beyond seven days,"},{"id":"semetey-1-2013:p0101:b004:l019","ordinal":84605,"en":"Shoot gazelle, eat, and go."},{"id":"semetey-1-2013:p0101:b004:l020","ordinal":84606,"en":"Say, ‘Saintly Bakai, the accomplished one,"},{"id":"semetey-1-2013:p0101:b004:l021","ordinal":84607,"en":"To whom seven saints gave their hands,"},{"id":"semetey-1-2013:p0101:b004:l022","ordinal":84608,"en":"Must have died,’ and go."},{"id":"semetey-1-2013:p0101:b004:l023","ordinal":84609,"en":"Oh, Kanykei, my foal,"},{"id":"semetey-1-2013:p0101:b004:l024","ordinal":84610,"en":"If I remain away beyond six days,"},{"id":"semetey-1-2013:p0101:b004:l025","ordinal":84611,"en":"Scatter all your provisions and leave."},{"id":"semetey-1-2013:p0101:b004:l026","ordinal":84612,"en":"Saying, ‘My lion uncle has died,’"},{"id":"semetey-1-2013:p0101:b004:l027","ordinal":84613,"en":"Flee toward Kara Khan, your father's home!"},{"id":"semetey-1-2013:p0101:b004:l029","ordinal":84614,"en":"Go by a safe road."},{"id":"semetey-1-2013:p0101:b004:l030","ordinal":84615,"en":"Saying, ‘My lion Bakai has died,’"},{"id":"semetey-1-2013:p0101:b004:l031","ordinal":84616,"en":"Abandon hope of me and go!"},{"id":"semetey-1-2013:p0101:b004:l032","ordinal":84617,"en":"Oh, Kanykei, my foal,"},{"id":"semetey-1-2013:p0101:b004:l033","ordinal":84618,"en":"Climb a ridge and pause."},{"id":"semetey-1-2013:p0101:b004:l034","ordinal":84619,"en":"Saying, ‘My hero Bakai has died,’"},{"id":"semetey-1-2013:p0101:b004:l035","ordinal":84620,"en":"Lament me there before you leave!"},{"id":"semetey-1-2013:p0101:b004:l036","ordinal":84621,"en":"Oh, Kanykei, my foal,"},{"id":"semetey-1-2013:p0101:b004:l037","ordinal":84622,"en":"If by chance I fail to return,"},{"id":"semetey-1-2013:p0101:b004:l038","ordinal":84623,"en":"Lie low by day and flee by night!"},{"id":"semetey-1-2013:p0101:b004:l039","ordinal":84624,"en":"Oh, Kanykei, my foal,"},{"id":"semetey-1-2013:p0102:b003:l001","ordinal":84625,"en":"Do not linger in grief; flee on each day!"},{"id":"semetey-1-2013:p0102:b003:l002","ordinal":84626,"en":"Do not reveal your widowhood."},{"id":"semetey-1-2013:p0102:b003:l003","ordinal":84627,"en":"You were accomplished, Kanykei;"},{"id":"semetey-1-2013:p0102:b003:l004","ordinal":84628,"en":"Do not let your tongue abuse God."},{"id":"semetey-1-2013:p0102:b003:l005","ordinal":84629,"en":"When you flee to Bukhara,"},{"id":"semetey-1-2013:p0102:b003:l006","ordinal":84630,"en":"Do not reveal your widowhood."},{"id":"semetey-1-2013:p0102:b003:l007","ordinal":84631,"en":"Do not let a bird devour the swan."},{"id":"semetey-1-2013:p0102:b003:l008","ordinal":84632,"en":"This Semetey, whom my companion left,"},{"id":"semetey-1-2013:p0102:b003:l009","ordinal":84633,"en":"Do not let them call a fugitive boy!"},{"id":"semetey-1-2013:p0102:b003:l010","ordinal":84634,"en":"Oh, Kanykei, my foal,"},{"id":"semetey-1-2013:p0102:b003:l011","ordinal":84635,"en":"Until twelve years have passed,"},{"id":"semetey-1-2013:p0102:b003:l012","ordinal":84636,"en":"I shall have no peace with those destroyers!"},{"id":"semetey-1-2013:p0102:b003:l013","ordinal":84637,"en":"I shall take my caravan from Ken-Kol."},{"id":"semetey-1-2013:p0102:b003:l014","ordinal":84638,"en":"If you bring the orphan to show me,"},{"id":"semetey-1-2013:p0102:b003:l015","ordinal":84639,"en":"From those swaggering dogs,"},{"id":"semetey-1-2013:p0102:b003:l016","ordinal":84640,"en":"Unless I die, I shall take revenge."},{"id":"semetey-1-2013:p0102:b003:l017","ordinal":84641,"en":"I shall take my caravan from Talas;"},{"id":"semetey-1-2013:p0102:b003:l018","ordinal":84642,"en":"Making a spectacle before my people,"},{"id":"semetey-1-2013:p0102:b003:l019","ordinal":84643,"en":"Unless I die, I shall take revenge."},{"id":"semetey-1-2013:p0102:b003:l020","ordinal":84644,"en":"Until Semetey turns twelve,"},{"id":"semetey-1-2013:p0102:b003:l021","ordinal":84645,"en":"I shall plunder their possessions."},{"id":"semetey-1-2013:p0102:b003:l022","ordinal":84646,"en":"In this very Ken-Kol"},{"id":"semetey-1-2013:p0102:b003:l023","ordinal":84647,"en":"I shall wreak pitiless slaughter."},{"id":"semetey-1-2013:p0102:b003:l024","ordinal":84648,"en":"Oh, Kanykei, my foal,"},{"id":"semetey-1-2013:p0102:b003:l025","ordinal":84649,"en":"I shall raid their racers from the summer pasture."},{"id":"semetey-1-2013:p0102:b003:l026","ordinal":84650,"en":"Unless I die, you will hear"},{"id":"semetey-1-2013:p0102:b003:l027","ordinal":84651,"en":"Of the havoc Bakai has wrought!"},{"id":"semetey-1-2013:p0102:b003:l028","ordinal":84652,"en":"Until my orphan reaches twelve,"},{"id":"semetey-1-2013:p0102:b003:l029","ordinal":84653,"en":"I shall plunder their possessions."},{"id":"semetey-1-2013:p0102:b003:l030","ordinal":84654,"en":"Upon those reeking dogs"},{"id":"semetey-1-2013:p0102:b003:l031","ordinal":84655,"en":"I shall inflict thorough slaughter,"},{"id":"semetey-1-2013:p0102:b003:l032","ordinal":84656,"en":"Taking great revenge!"},{"id":"semetey-1-2013:p0102:b003:l033","ordinal":84657,"en":"Oh, Kanykei, my foal,"},{"id":"semetey-1-2013:p0102:b003:l034","ordinal":84658,"en":"I shall raid their mares from the tethering line."},{"id":"semetey-1-2013:p0102:b003:l035","ordinal":84659,"en":"I shall make the villain pay"},{"id":"semetey-1-2013:p0102:b003:l036","ordinal":84660,"en":"For his remotest wrongs!"},{"id":"semetey-1-2013:p0102:b003:l037","ordinal":84661,"en":"Not their worthless ones, but the slaves'"},{"id":"semetey-1-2013:p0102:b003:l038","ordinal":84662,"en":"Great men I shall seize."},{"id":"semetey-1-2013:p0102:b003:l039","ordinal":84663,"en":"If God grants it, Kanykei,"},{"id":"semetey-1-2013:p0102:b004:l001","ordinal":84664,"en":"Making a sacrificial example upon your road,"},{"id":"semetey-1-2013:p0102:b004:l002","ordinal":84665,"en":"I shall offer the dogs in sacrifice!"},{"id":"semetey-1-2013:p0102:b004:l003","ordinal":84666,"en":"Those raging slaves"},{"id":"semetey-1-2013:p0102:b004:l004","ordinal":84667,"en":"I shall trample underfoot."},{"id":"semetey-1-2013:p0102:b004:l005","ordinal":84668,"en":"If I, the old man, remain alive,"},{"id":"semetey-1-2013:p0102:b004:l006","ordinal":84669,"en":"I shall scatter the dogs' four kinds of livestock!"},{"id":"semetey-1-2013:p0102:b004:l007","ordinal":84670,"en":"You whom Manas left as a precious trust,"},{"id":"semetey-1-2013:p0102:b004:l008","ordinal":84671,"en":"Until I return again,"},{"id":"semetey-1-2013:p0102:b004:l009","ordinal":84672,"en":"Until I see your fair face,"},{"id":"semetey-1-2013:p0102:b004:l010","ordinal":84673,"en":"You were a soul of sacred power—"},{"id":"semetey-1-2013:p0102:b004:l011","ordinal":84674,"en":"My precious mother, farewell!"},{"id":"semetey-1-2013:p0102:b004:l012","ordinal":84675,"en":"Travelling seven days on the road,"},{"id":"semetey-1-2013:p0102:b004:l013","ordinal":84676,"en":"Until I return to see you,"},{"id":"semetey-1-2013:p0102:b004:l014","ordinal":84677,"en":"Until I see your accomplished face,"},{"id":"semetey-1-2013:p0102:b004:l015","ordinal":84678,"en":"Beauty among the dark-complexioned,"},{"id":"semetey-1-2013:p0102:b004:l016","ordinal":84679,"en":"Radiant one among Muslims,"},{"id":"semetey-1-2013:p0102:b004:l017","ordinal":84680,"en":"My child Kanykei, farewell."},{"id":"semetey-1-2013:p0102:b004:l018","ordinal":84681,"en":"Kyrka-Tash of broad Talas—"},{"id":"semetey-1-2013:p0102:b004:l019","ordinal":84682,"en":"I shall trot down Kyrka-Tash."},{"id":"semetey-1-2013:p0102:b004:l020","ordinal":84683,"en":"If a stray bullet strikes from a ridge,"},{"id":"semetey-1-2013:p0102:b004:l021","ordinal":84684,"en":"I shall behold Judgment."},{"id":"semetey-1-2013:p0102:b004:l022","ordinal":84685,"en":"If I do not behold Judgment,"},{"id":"semetey-1-2013:p0102:b004:l023","ordinal":84686,"en":"If my death does not come,"},{"id":"semetey-1-2013:p0102:b004:l024","ordinal":84687,"en":"In seven days I shall return without delay;"},{"id":"semetey-1-2013:p0102:b004:l025","ordinal":84688,"en":"My orphan, I shall see you."},{"id":"semetey-1-2013:p0102:b004:l026","ordinal":84689,"en":"The road to Bukhara is long."},{"id":"semetey-1-2013:p0102:b004:l027","ordinal":84690,"en":"Let me prepare a coat that will keep you from freezing."},{"id":"semetey-1-2013:p0102:b004:l028","ordinal":84691,"en":"Let me prepare, my child Kanykei,"},{"id":"semetey-1-2013:p0102:b004:l029","ordinal":84692,"en":"Your clear and open road."},{"id":"semetey-1-2013:p0102:b004:l030","ordinal":84693,"en":"Heading straight for Bukhara without turning aside,"},{"id":"semetey-1-2013:p0102:b004:l032","ordinal":84694,"en":"Unless I die, let me return with"},{"id":"semetey-1-2013:p0102:b004:l033","ordinal":84695,"en":"A steed that will not tire"},{"id":"semetey-1-2013:p0102:b004:l034","ordinal":84696,"en":"Though you travel six months without rest."},{"id":"semetey-1-2013:p0102:b004:l035","ordinal":84697,"en":"Let me prepare your food and milk."},{"id":"semetey-1-2013:p0102:b004:l036","ordinal":84698,"en":"Let me give you, my child Kanykei,"},{"id":"semetey-1-2013:p0102:b004:l037","ordinal":84699,"en":"A horse to ride to Bukhara."},{"id":"semetey-1-2013:p0102:b004:l038","ordinal":84700,"en":"The seven khans upon the earth,"},{"id":"semetey-1-2013:p0102:b004:l039","ordinal":84701,"en":"When word reaches them,"},{"id":"semetey-1-2013:p0103:b003:l001","ordinal":84702,"en":"Loaded seventy camels with cloth."},{"id":"semetey-1-2013:p0103:b003:l002","ordinal":84703,"en":"Kanykei, when we went to fetch you,"},{"id":"semetey-1-2013:p0103:b003:l003","ordinal":84704,"en":"From your father Temir Khan's city"},{"id":"semetey-1-2013:p0103:b003:l004","ordinal":84705,"en":"You came forth, my foal,"},{"id":"semetey-1-2013:p0103:b003:l005","ordinal":84706,"en":"Riding a bay pacer in splendor."},{"id":"semetey-1-2013:p0103:b003:l006","ordinal":84707,"en":"Now, parted from Manas,"},{"id":"semetey-1-2013:p0103:b003:l007","ordinal":84708,"en":"Your breast slashed open,"},{"id":"semetey-1-2013:p0103:b003:l008","ordinal":84709,"en":"Grieving and weeping, my foal,"},{"id":"semetey-1-2013:p0103:b003:l009","ordinal":84710,"en":"How can you go on foot,"},{"id":"semetey-1-2013:p0103:b003:l010","ordinal":84711,"en":"Weeping in sorrow, stumbling along?"},{"id":"semetey-1-2013:p0103:b003:l011","ordinal":84712,"en":"To your father Kara Khan's city"},{"id":"semetey-1-2013:p0103:b003:l012","ordinal":84713,"en":"We drove livestock to arrange the marriage,"},{"id":"semetey-1-2013:p0103:b003:l013","ordinal":84714,"en":"Bowed in homage and feasted on fat,"},{"id":"semetey-1-2013:p0103:b003:l014","ordinal":84715,"en":"Loaded eighty-one camels with cloth,"},{"id":"semetey-1-2013:p0103:b003:l015","ordinal":84716,"en":"Clothed you in a fitted coat,"},{"id":"semetey-1-2013:p0103:b003:l016","ordinal":84717,"en":"Mounted you upon a racing steed."},{"id":"semetey-1-2013:p0103:b003:l017","ordinal":84718,"en":"From your father's royal city,"},{"id":"semetey-1-2013:p0103:b003:l018","ordinal":84719,"en":"My foal, you came radiant."},{"id":"semetey-1-2013:p0103:b003:l020","ordinal":84720,"en":"Now that Kojosan Manas has died,"},{"id":"semetey-1-2013:p0103:b003:l021","ordinal":84721,"en":"You have no food or fat in hand,"},{"id":"semetey-1-2013:p0103:b003:l022","ordinal":84722,"en":"Not even a thin yearling beneath you."},{"id":"semetey-1-2013:p0103:b003:l023","ordinal":84723,"en":"How will you go on foot,"},{"id":"semetey-1-2013:p0103:b003:l024","ordinal":84724,"en":"Fleeing, weeping, stumbling along?"},{"id":"semetey-1-2013:p0103:b003:l025","ordinal":84725,"en":"From your father the sovereign khan's city"},{"id":"semetey-1-2013:p0103:b003:l026","ordinal":84726,"en":"You came, my foal,"},{"id":"semetey-1-2013:p0103:b003:l027","ordinal":84727,"en":"Shining in your coat of mail."},{"id":"semetey-1-2013:p0103:b003:l028","ordinal":84728,"en":"With no filly or yearling beneath you,"},{"id":"semetey-1-2013:p0103:b003:l029","ordinal":84729,"en":"My child, how have you gone stumbling now?"},{"id":"semetey-1-2013:p0103:b003:l031","ordinal":84730,"en":"Along Uch-Koshoi's lower road"},{"id":"semetey-1-2013:p0103:b003:l032","ordinal":84731,"en":"Let me trot."},{"id":"semetey-1-2013:p0103:b003:l033","ordinal":84732,"en":"If my death has come, Kanykei,"},{"id":"semetey-1-2013:p0103:b003:l034","ordinal":84733,"en":"Let me behold the other world."},{"id":"semetey-1-2013:p0103:b003:l035","ordinal":84734,"en":"Fighting with spears, breaking the ranks,"},{"id":"semetey-1-2013:p0103:b003:l036","ordinal":84735,"en":"If my fate has come, let me die."},{"id":"semetey-1-2013:p0103:b003:l037","ordinal":84736,"en":"Unless my fate comes and I die,"}]
