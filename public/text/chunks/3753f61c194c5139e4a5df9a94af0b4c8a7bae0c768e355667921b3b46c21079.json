[{"id":"manas-2010:p0946:b001:l003","ordinal":41473,"en":"Their hearts had lost their covering."},{"id":"manas-2010:p0946:b001:l004","ordinal":41474,"en":"That the people had become afraid,"},{"id":"manas-2010:p0946:b001:l005","ordinal":41475,"en":"Their khan Temir now understood."},{"id":"manas-2010:p0946:b001:l006","ordinal":41476,"en":"Understanding this, then"},{"id":"manas-2010:p0946:b001:l007","ordinal":41477,"en":"He smiled beneath his mustache."},{"id":"manas-2010:p0946:b001:l008","ordinal":41478,"en":"‘Your fathers' graves, wretched people!"},{"id":"manas-2010:p0946:b001:l009","ordinal":41479,"en":"Your elders with swan-white beards—"},{"id":"manas-2010:p0946:b001:l010","ordinal":41480,"en":"May God take you all!"},{"id":"manas-2010:p0946:b001:l011","ordinal":41481,"en":"Six months ago I dreamed a dream,"},{"id":"manas-2010:p0946:b001:l012","ordinal":41482,"en":"I saw a wonderfully good event."},{"id":"manas-2010:p0946:b001:l013","ordinal":41483,"en":"A beautiful moon rose from my body;"},{"id":"manas-2010:p0946:b001:l014","ordinal":41484,"en":"I was streaming along,"},{"id":"manas-2010:p0946:b001:l015","ordinal":41485,"en":"With a great shining sun"},{"id":"manas-2010:p0946:b001:l016","ordinal":41486,"en":"I was joining together."},{"id":"manas-2010:p0946:b001:l017","ordinal":41487,"en":"The sun that rose in daylight—"},{"id":"manas-2010:p0946:b001:l018","ordinal":41488,"en":"Is not Manas my sun?"},{"id":"manas-2010:p0946:b001:l019","ordinal":41489,"en":"The joining together I saw—"},{"id":"manas-2010:p0946:b001:l020","ordinal":41490,"en":"Is it not my child Kanykey?"},{"id":"manas-2010:p0946:b001:l021","ordinal":41491,"en":"What I say is utterly clear."},{"id":"manas-2010:p0946:b001:l022","ordinal":41492,"en":"You have seen his messenger;"},{"id":"manas-2010:p0946:b001:l023","ordinal":41493,"en":"Seeing him, wretched people,"},{"id":"manas-2010:p0946:b001:l024","ordinal":41494,"en":"You came fleeing in confusion."},{"id":"manas-2010:p0946:b001:l025","ordinal":41495,"en":"These words will not be idle:"},{"id":"manas-2010:p0946:b001:l026","ordinal":41496,"en":"That man from whom you fled"},{"id":"manas-2010:p0946:b001:l027","ordinal":41497,"en":"Is leopard Manas's companion."},{"id":"manas-2010:p0946:b001:l028","ordinal":41498,"en":"He has come with a message, surely."},{"id":"manas-2010:p0946:b001:l029","ordinal":41499,"en":"Khan Manas's confidant,"},{"id":"manas-2010:p0946:b001:l030","ordinal":41500,"en":"His peer, leopard Bakay,"},{"id":"manas-2010:p0946:b001:l031","ordinal":41501,"en":"Whenever there is a message,"},{"id":"manas-2010:p0946:b001:l032","ordinal":41502,"en":"Has the habit of coming."},{"id":"manas-2010:p0946:b001:l033","ordinal":41503,"en":"It must be Khan Bakay himself,"},{"id":"manas-2010:p0946:b001:l034","ordinal":41504,"en":"Not just himself, his very eyes!"},{"id":"manas-2010:p0946:b001:l035","ordinal":41505,"en":"God has granted the wish, surely;"},{"id":"manas-2010:p0946:b001:l036","ordinal":41506,"en":"Bakay has come as marriage envoy!"},{"id":"manas-2010:p0946:b001:l037","ordinal":41507,"en":"I sought it from the learned,"},{"id":"manas-2010:p0946:b001:l038","ordinal":41508,"en":"I asked the caravan traders."},{"id":"manas-2010:p0946:b001:l039","ordinal":41509,"en":"Shedding blood, that Manas"},{"id":"manas-2010:p0946:b001:l040","ordinal":41510,"en":"Upon Black Kalmyks and Manchus"},{"id":"manas-2010:p0946:b001:l041","ordinal":41511,"en":"Has brought turmoil, they say."},{"id":"manas-2010:p0946:b001:l042","ordinal":41512,"en":"From Black Chinese and Manchus,"},{"id":"manas-2010:p0947:b001:l001","ordinal":41513,"en":"His small people, scattered in wandering,"},{"id":"manas-2010:p0947:b001:l002","ordinal":41514,"en":"He has freed, they say."},{"id":"manas-2010:p0947:b001:l003","ordinal":41515,"en":"Extinguishing their kindled fires,"},{"id":"manas-2010:p0947:b001:l004","ordinal":41516,"en":"Moving all his people,"},{"id":"manas-2010:p0947:b001:l005","ordinal":41517,"en":"Those who offered resistance—"},{"id":"manas-2010:p0947:b001:l006","ordinal":41518,"en":"He crushed many of them, they say."},{"id":"manas-2010:p0947:b001:l007","ordinal":41519,"en":"That land he won in struggle,"},{"id":"manas-2010:p0947:b001:l008","ordinal":41520,"en":"He named Talas, they say."},{"id":"manas-2010:p0947:b001:l009","ordinal":41521,"en":"Making Talas a blessed land,"},{"id":"manas-2010:p0947:b001:l010","ordinal":41522,"en":"Keeping a court, becoming khan,"},{"id":"manas-2010:p0947:b001:l011","ordinal":41523,"en":"He has settled there, I heard."},{"id":"manas-2010:p0947:b001:l012","ordinal":41524,"en":"Alöökö dwelling in white yurts,"},{"id":"manas-2010:p0947:b001:l013","ordinal":41525,"en":"Leveling his ancient fortress,"},{"id":"manas-2010:p0947:b001:l014","ordinal":41526,"en":"He swallowed up, I heard!"},{"id":"manas-2010:p0947:b001:l015","ordinal":41527,"en":"Ruling Anzhyian,"},{"id":"manas-2010:p0947:b001:l016","ordinal":41528,"en":"Having come from the Chinese,"},{"id":"manas-2010:p0947:b001:l017","ordinal":41529,"en":"A khan called Alöökö arose;"},{"id":"manas-2010:p0947:b001:l018","ordinal":41530,"en":"His terror drove out the soul."},{"id":"manas-2010:p0947:b001:l019","ordinal":41531,"en":"You must have heard the news."},{"id":"manas-2010:p0947:b001:l020","ordinal":41532,"en":"When Khan Alöökö held power,"},{"id":"manas-2010:p0947:b001:l021","ordinal":41533,"en":"When he issued harsh commands,"},{"id":"manas-2010:p0947:b001:l022","ordinal":41534,"en":"He gathered livestock as tribute,"},{"id":"manas-2010:p0947:b001:l023","ordinal":41535,"en":"Struck off heads and took lives."},{"id":"manas-2010:p0947:b001:l024","ordinal":41536,"en":"By force he took skilled craftswomen,"},{"id":"manas-2010:p0947:b001:l025","ordinal":41537,"en":"As booty he took girls."},{"id":"manas-2010:p0947:b001:l026","ordinal":41538,"en":"When that Alöökö held power,"},{"id":"manas-2010:p0947:b001:l027","ordinal":41539,"en":"From this very Bukhara"},{"id":"manas-2010:p0947:b001:l028","ordinal":41540,"en":"Six thousand silver ingots, a thousand beaver pelts,"},{"id":"manas-2010:p0947:b001:l029","ordinal":41541,"en":"He took as tribute every month."},{"id":"manas-2010:p0947:b001:l030","ordinal":41542,"en":"Unable to bear his tribute,"},{"id":"manas-2010:p0947:b001:l031","ordinal":41543,"en":"The people grew pale."},{"id":"manas-2010:p0947:b001:l032","ordinal":41544,"en":"Taking a tax in gold each day,"},{"id":"manas-2010:p0947:b001:l033","ordinal":41545,"en":"Taking one in thirty camels,"},{"id":"manas-2010:p0947:b001:l034","ordinal":41546,"en":"Inflicting his wrath upon the people,"},{"id":"manas-2010:p0947:b001:l035","ordinal":41547,"en":"Making the people know his strength,"},{"id":"manas-2010:p0947:b001:l036","ordinal":41548,"en":"A man who had committed no crime"},{"id":"manas-2010:p0947:b001:l037","ordinal":41549,"en":"He tormented and made suffer."},{"id":"manas-2010:p0947:b001:l038","ordinal":41550,"en":"Unable to bear his wrath,"},{"id":"manas-2010:p0947:b001:l039","ordinal":41551,"en":"The khan of Kokon fled one way;"},{"id":"manas-2010:p0947:b001:l040","ordinal":41552,"en":"Unable to collect themselves,"},{"id":"manas-2010:p0947:b001:l041","ordinal":41553,"en":"Anzhyian fled another way."},{"id":"manas-2010:p0947:b001:l042","ordinal":41554,"en":"Violence and his great force—"},{"id":"manas-2010:p0948:b001:l001","ordinal":41555,"en":"He kept inflicting them, I heard."},{"id":"manas-2010:p0948:b001:l002","ordinal":41556,"en":"Smashing Samarkand,"},{"id":"manas-2010:p0948:b001:l003","ordinal":41557,"en":"And then still the tribute—"},{"id":"manas-2010:p0948:b001:l004","ordinal":41558,"en":"He kept taking it, I heard!"},{"id":"manas-2010:p0948:b001:l005","ordinal":41559,"en":"While he raged against us,"},{"id":"manas-2010:p0948:b001:l006","ordinal":41560,"en":"While he brought turmoil,"},{"id":"manas-2010:p0948:b001:l007","ordinal":41561,"en":"Manas was born for our good fortune."},{"id":"manas-2010:p0948:b001:l008","ordinal":41562,"en":"“Manas has come from Altay,”"},{"id":"manas-2010:p0948:b001:l009","ordinal":41563,"en":"Alöökö heard."},{"id":"manas-2010:p0948:b001:l010","ordinal":41564,"en":"When he heard that news,"},{"id":"manas-2010:p0948:b001:l011","ordinal":41565,"en":"An unbeliever like your Alöökö"},{"id":"manas-2010:p0948:b001:l012","ordinal":41566,"en":"Scattered his wealth."},{"id":"manas-2010:p0948:b001:l013","ordinal":41567,"en":"Thrown into confusion, Alöökö"},{"id":"manas-2010:p0948:b001:l014","ordinal":41568,"en":"Fled toward Beijing."},{"id":"manas-2010:p0948:b001:l015","ordinal":41569,"en":"Hearing news from the governor,"},{"id":"manas-2010:p0948:b001:l016","ordinal":41570,"en":"Hearing, “The blood-drinker has come,”"},{"id":"manas-2010:p0948:b001:l017","ordinal":41571,"en":"Unable to collect himself,"},{"id":"manas-2010:p0948:b001:l018","ordinal":41572,"en":"He began fleeing to Beijing."},{"id":"manas-2010:p0948:b001:l019","ordinal":41573,"en":"His abundant wealth, his many livestock,"},{"id":"manas-2010:p0948:b001:l020","ordinal":41574,"en":"He abandoned utterly."},{"id":"manas-2010:p0948:b001:l021","ordinal":41575,"en":"He scattered his accumulated goods."},{"id":"manas-2010:p0948:b001:l022","ordinal":41576,"en":"Not counting any of it worth a hair,"},{"id":"manas-2010:p0948:b001:l023","ordinal":41577,"en":"Cowering, Alöökö"},{"id":"manas-2010:p0948:b001:l024","ordinal":41578,"en":"Fled toward the Chinese."},{"id":"manas-2010:p0948:b001:l025","ordinal":41579,"en":"Not letting him escape,"},{"id":"manas-2010:p0948:b001:l026","ordinal":41580,"en":"He bore down upon him,"},{"id":"manas-2010:p0948:b001:l027","ordinal":41581,"en":"Scattered his four kinds of livestock."},{"id":"manas-2010:p0948:b001:l028","ordinal":41582,"en":"What the lion hero Manas"},{"id":"manas-2010:p0948:b001:l029","ordinal":41583,"en":"Did to Alöökö—"},{"id":"manas-2010:p0948:b001:l030","ordinal":41584,"en":"He submitted to it, I heard."},{"id":"manas-2010:p0948:b001:l031","ordinal":41585,"en":"Alöökö's countless riches"},{"id":"manas-2010:p0948:b001:l032","ordinal":41586,"en":"To the poor and destitute"},{"id":"manas-2010:p0948:b001:l033","ordinal":41587,"en":"He distributed, I heard."},{"id":"manas-2010:p0948:b001:l034","ordinal":41588,"en":"Loading camels, taking gold coins,"},{"id":"manas-2010:p0948:b001:l035","ordinal":41589,"en":"That Manas was a hero,"},{"id":"manas-2010:p0948:b001:l036","ordinal":41590,"en":"Every soul who went"},{"id":"manas-2010:p0948:b001:l037","ordinal":41591,"en":"Saw for themselves, I heard."},{"id":"manas-2010:p0948:b001:l038","ordinal":41592,"en":"All the khans gathered;"},{"id":"manas-2010:p0948:b001:l039","ordinal":41593,"en":"To the lion hero Manas,"},{"id":"manas-2010:p0948:b001:l040","ordinal":41594,"en":"Two reins and one lead-rope"},{"id":"manas-2010:p0948:b001:l041","ordinal":41595,"en":"They handed over, I heard."},{"id":"manas-2010:p0948:b001:l042","ordinal":41596,"en":"He has heard from the learned, surely,"},{"id":"manas-2010:p0949:b001:l001","ordinal":41597,"en":"He has learned from the wise, surely."},{"id":"manas-2010:p0949:b001:l002","ordinal":41598,"en":"From the lion hero Manas,"},{"id":"manas-2010:p0949:b001:l003","ordinal":41599,"en":"With a marriage envoy sent to us,"},{"id":"manas-2010:p0949:b001:l004","ordinal":41600,"en":"His word has come, surely."},{"id":"manas-2010:p0949:b001:l005","ordinal":41601,"en":"Khan Bakay, the rich man's son,"},{"id":"manas-2010:p0949:b001:l006","ordinal":41602,"en":"That prophet-like warrior"},{"id":"manas-2010:p0949:b001:l007","ordinal":41603,"en":"Has come himself, surely."},{"id":"manas-2010:p0949:b001:l008","ordinal":41604,"en":"It is Bakay himself, it seems;"},{"id":"manas-2010:p0949:b001:l009","ordinal":41605,"en":"As a marriage envoy then"},{"id":"manas-2010:p0949:b001:l010","ordinal":41606,"en":"He has now arrived.’"},{"id":"manas-2010:p0949:b001:l011","ordinal":41607,"en":"Saying this, Temirkan,"},{"id":"manas-2010:p0949:b001:l012","ordinal":41608,"en":"From great Bukhara's fortress,"},{"id":"manas-2010:p0949:b001:l013","ordinal":41609,"en":"From the court where the khan sat,"},{"id":"manas-2010:p0949:b001:l014","ordinal":41610,"en":"His white turban like a cauldron,"},{"id":"manas-2010:p0949:b001:l015","ordinal":41611,"en":"His shout like the call to prayer,"},{"id":"manas-2010:p0949:b001:l016","ordinal":41612,"en":"Sixty holy men beside him,"},{"id":"manas-2010:p0949:b001:l017","ordinal":41613,"en":"Temirkan, khan of Bukhara,"},{"id":"manas-2010:p0949:b001:l018","ordinal":41614,"en":"Your warrior elder Bakay—"},{"id":"manas-2010:p0949:b001:l019","ordinal":41615,"en":"He now went out to meet him."},{"id":"manas-2010:p0949:b001:l020","ordinal":41616,"en":"At the sight of Khan Bakay,"},{"id":"manas-2010:p0949:b001:l021","ordinal":41617,"en":"Backing and retreating,"},{"id":"manas-2010:p0949:b001:l022","ordinal":41618,"en":"Balking and refusing to advance,"},{"id":"manas-2010:p0949:b001:l023","ordinal":41619,"en":"God struck the holy men with fear."},{"id":"manas-2010:p0949:b001:l024","ordinal":41620,"en":"Temirkan, khan of Bukhara,"},{"id":"manas-2010:p0949:b001:l025","ordinal":41621,"en":"Came forward apart from them,"},{"id":"manas-2010:p0949:b001:l026","ordinal":41622,"en":"Appeared before Khan Bakay."},{"id":"manas-2010:p0949:b001:l027","ordinal":41623,"en":"The white steed beneath him—"},{"id":"manas-2010:p0949:b001:l028","ordinal":41624,"en":"He drew its mouth round."},{"id":"manas-2010:p0949:b001:l029","ordinal":41625,"en":"To lion lord Bakay"},{"id":"manas-2010:p0949:b001:l030","ordinal":41626,"en":"He now gave his greeting."},{"id":"manas-2010:p0949:b001:l031","ordinal":41627,"en":"‘Peace upon peace be with you,"},{"id":"manas-2010:p0949:b001:l032","ordinal":41628,"en":"Renowned lion Bakay!"},{"id":"manas-2010:p0949:b001:l033","ordinal":41629,"en":"A master sprung from common folk,"},{"id":"manas-2010:p0949:b001:l034","ordinal":41630,"en":"A true saint, to speak briefly."},{"id":"manas-2010:p0949:b001:l035","ordinal":41631,"en":"A prophet-like saint,"},{"id":"manas-2010:p0949:b001:l036","ordinal":41632,"en":"An elder wiser than other mortals."},{"id":"manas-2010:p0949:b001:l037","ordinal":41633,"en":"Stirring the stars in the sky,"},{"id":"manas-2010:p0949:b001:l038","ordinal":41634,"en":"With devastating lion Manas"},{"id":"manas-2010:p0949:b001:l039","ordinal":41635,"en":"You made friendship for the world beyond."},{"id":"manas-2010:p0949:b001:l040","ordinal":41636,"en":"May I ask where your lord is?"},{"id":"manas-2010:p0949:b001:l041","ordinal":41637,"en":"Four saints have given you their hands;"},{"id":"manas-2010:p0949:b001:l042","ordinal":41638,"en":"Lord Bakay, are you well?"},{"id":"manas-2010:p0950:b001:l001","ordinal":41639,"en":"From a saint's own self,"},{"id":"manas-2010:p0950:b001:l002","ordinal":41640,"en":"Born at the world's edge,"},{"id":"manas-2010:p0950:b001:l003","ordinal":41641,"en":"Destroying those who face you,"},{"id":"manas-2010:p0950:b001:l004","ordinal":41642,"en":"Ever raising an uproar."},{"id":"manas-2010:p0950:b001:l005","ordinal":41643,"en":"A guiding sign in the moonlit sky,"},{"id":"manas-2010:p0950:b001:l006","ordinal":41644,"en":"The lion's companion,"},{"id":"manas-2010:p0950:b001:l007","ordinal":41645,"en":"Fortunate when setting out on a journey,"},{"id":"manas-2010:p0950:b001:l008","ordinal":41646,"en":"Like a vast host to a fighting foe,"},{"id":"manas-2010:p0950:b001:l009","ordinal":41647,"en":"Tiger Bakay, are you well?"},{"id":"manas-2010:p0950:b001:l010","ordinal":41648,"en":"The hardships of six months ahead"},{"id":"manas-2010:p0950:b001:l011","ordinal":41649,"en":"You can know this very moment."},{"id":"manas-2010:p0950:b001:l012","ordinal":41650,"en":"Called a seer, called a lion,"},{"id":"manas-2010:p0950:b001:l013","ordinal":41651,"en":"Said to have all twelve limbs complete,"},{"id":"manas-2010:p0950:b001:l014","ordinal":41652,"en":"Companion of the valiant lord,"},{"id":"manas-2010:p0950:b001:l015","ordinal":41653,"en":"Leopard Bakay, are you well?’"},{"id":"manas-2010:p0950:b001:l016","ordinal":41654,"en":"Saying this, Temirkan"},{"id":"manas-2010:p0950:b001:l017","ordinal":41655,"en":"Turned his white steed."},{"id":"manas-2010:p0950:b001:l018","ordinal":41656,"en":"With lion warrior Bakay"},{"id":"manas-2010:p0950:b001:l019","ordinal":41657,"en":"He stood embracing."},{"id":"manas-2010:p0950:b001:l020","ordinal":41658,"en":"Then leopard Bakay,"},{"id":"manas-2010:p0950:b001:l021","ordinal":41659,"en":"The troubles of six months ahead,"},{"id":"manas-2010:p0950:b001:l022","ordinal":41660,"en":"Suffering and joy—"},{"id":"manas-2010:p0950:b001:l023","ordinal":41661,"en":"Your saint who knew them this moment said:"},{"id":"manas-2010:p0950:b001:l024","ordinal":41662,"en":"‘Your city with twelve gates—"},{"id":"manas-2010:p0950:b001:l025","ordinal":41663,"en":"Are they safe and well,"},{"id":"manas-2010:p0950:b001:l026","ordinal":41664,"en":"All of you in Bukhara?"},{"id":"manas-2010:p0950:b001:l027","ordinal":41665,"en":"In brief, the plain truth:"},{"id":"manas-2010:p0950:b001:l028","ordinal":41666,"en":"I see you now, Temirkan!"},{"id":"manas-2010:p0950:b001:l029","ordinal":41667,"en":"Shall I say I came as a marriage envoy?"},{"id":"manas-2010:p0950:b001:l030","ordinal":41668,"en":"I came desiring you yourself,"},{"id":"manas-2010:p0950:b001:l031","ordinal":41669,"en":"My khan Temir, are you well?"},{"id":"manas-2010:p0950:b001:l032","ordinal":41670,"en":"Loading eighty camels with gold coins,"},{"id":"manas-2010:p0950:b001:l033","ordinal":41671,"en":"I have come as a marriage envoy."},{"id":"manas-2010:p0950:b001:l034","ordinal":41672,"en":"If I told it, it would never end:"},{"id":"manas-2010:p0950:b001:l035","ordinal":41673,"en":"I have words enough for the world."},{"id":"manas-2010:p0950:b001:l036","ordinal":41674,"en":"To become your son-in-law,"},{"id":"manas-2010:p0950:b001:l037","ordinal":41675,"en":"I have my lion Manas the mighty one."},{"id":"manas-2010:p0950:b001:l038","ordinal":41676,"en":"Loading eighty camels with gold coins,"},{"id":"manas-2010:p0950:b001:l039","ordinal":41677,"en":"The youngest of twelve daughters,"},{"id":"manas-2010:p0950:b001:l040","ordinal":41678,"en":"The servant beloved of God,"},{"id":"manas-2010:p0950:b001:l041","ordinal":41679,"en":"Your saintly child Kanykey—"},{"id":"manas-2010:p0950:b001:l042","ordinal":41680,"en":"I have come to place betrothal earrings on her."},{"id":"manas-2010:p0951:b001:l001","ordinal":41681,"en":"To become your son-in-law,"},{"id":"manas-2010:p0951:b001:l002","ordinal":41682,"en":"Have you heard of him?"},{"id":"manas-2010:p0951:b001:l003","ordinal":41683,"en":"Unmatched among mortals,"},{"id":"manas-2010:p0951:b001:l004","ordinal":41684,"en":"I have my leopard Manas the mighty one."},{"id":"manas-2010:p0951:b001:l005","ordinal":41685,"en":"If you ask about Manas,"},{"id":"manas-2010:p0951:b001:l006","ordinal":41686,"en":"His fortune was complete."},{"id":"manas-2010:p0951:b001:l007","ordinal":41687,"en":"If you looked within him,"},{"id":"manas-2010:p0951:b001:l008","ordinal":41688,"en":"He was broader than the face of the earth!"},{"id":"manas-2010:p0951:b001:l009","ordinal":41689,"en":"Like lion lord Manas,"},{"id":"manas-2010:p0951:b001:l010","ordinal":41690,"en":"Fashioned by God Most High,"},{"id":"manas-2010:p0951:b001:l011","ordinal":41691,"en":"Creating such a soul among mortals,"},{"id":"manas-2010:p0951:b001:l012","ordinal":41692,"en":"He will not soon grant another."},{"id":"manas-2010:p0951:b001:l013","ordinal":41693,"en":"No mortal has brought him harm;"},{"id":"manas-2010:p0951:b001:l014","ordinal":41694,"en":"Against blue-maned champion Manas,"},{"id":"manas-2010:p0951:b001:l015","ordinal":41695,"en":"None remains to turn a catching pole."},{"id":"manas-2010:p0951:b001:l016","ordinal":41696,"en":"If you take that Manas as son-in-law,"},{"id":"manas-2010:p0951:b001:l017","ordinal":41697,"en":"The youngest of six lions,"},{"id":"manas-2010:p0951:b001:l018","ordinal":41698,"en":"God's beloved servant,"},{"id":"manas-2010:p0951:b001:l019","ordinal":41699,"en":"A dark, blue-maned leopard,"},{"id":"manas-2010:p0951:b001:l020","ordinal":41700,"en":"If you take Manas as son-in-law,"},{"id":"manas-2010:p0951:b001:l021","ordinal":41701,"en":"He is your saint who will know your worth!"},{"id":"manas-2010:p0951:b001:l022","ordinal":41702,"en":"If you take Manas as son-in-law,"},{"id":"manas-2010:p0951:b001:l023","ordinal":41703,"en":"He is the son who will grasp your meaning,"},{"id":"manas-2010:p0951:b001:l024","ordinal":41704,"en":"He is the servant who will care for you."},{"id":"manas-2010:p0951:b001:l025","ordinal":41705,"en":"Oh, Temirkan, my hero,"},{"id":"manas-2010:p0951:b001:l026","ordinal":41706,"en":"Give ear to my words."},{"id":"manas-2010:p0951:b001:l027","ordinal":41707,"en":"The lion, his father's only son,"},{"id":"manas-2010:p0951:b001:l028","ordinal":41708,"en":"Take him as your son-in-law."},{"id":"manas-2010:p0951:b001:l029","ordinal":41709,"en":"Driving eighty red camels,"},{"id":"manas-2010:p0951:b001:l030","ordinal":41710,"en":"Let us braid the elephant's tail."},{"id":"manas-2010:p0951:b001:l031","ordinal":41711,"en":"We have arrived, Temirkan,"},{"id":"manas-2010:p0951:b001:l032","ordinal":41712,"en":"For your daughter like Kanykey,"},{"id":"manas-2010:p0951:b001:l033","ordinal":41713,"en":"To try coming as marriage envoys!’"},{"id":"manas-2010:p0951:b001:l034","ordinal":41714,"en":"Temirkan, khan of Bukhara,"},{"id":"manas-2010:p0951:b001:l035","ordinal":41715,"en":"Was a khan of sacred power."},{"id":"manas-2010:p0951:b001:l036","ordinal":41716,"en":"Of blood-drinking, blue-maned Manas"},{"id":"manas-2010:p0951:b001:l037","ordinal":41717,"en":"He had full knowledge."},{"id":"manas-2010:p0951:b001:l038","ordinal":41718,"en":"‘I agree, Bakay, I agree."},{"id":"manas-2010:p0951:b001:l039","ordinal":41719,"en":"To the blood-drinking lion, Kanykey—"},{"id":"manas-2010:p0951:b001:l040","ordinal":41720,"en":"If you wish, I shall give her."},{"id":"manas-2010:p0951:b001:l041","ordinal":41721,"en":"In Bukhara of courts and holy sheikhs,"},{"id":"manas-2010:p0951:b001:l042","ordinal":41722,"en":"I kept a court and became khan."},{"id":"manas-2010:p0952:b001:l001","ordinal":41723,"en":"Splitting a black hair exactly in two,"},{"id":"manas-2010:p0952:b001:l002","ordinal":41724,"en":"I became a saintly noble soul."},{"id":"manas-2010:p0952:b001:l003","ordinal":41725,"en":"Taking a wife, keeping a household,"},{"id":"manas-2010:p0952:b001:l004","ordinal":41726,"en":"I have gathered treasure."},{"id":"manas-2010:p0952:b001:l005","ordinal":41727,"en":"I myself have no son;"},{"id":"manas-2010:p0952:b001:l006","ordinal":41728,"en":"I have had twelve daughters."}]
