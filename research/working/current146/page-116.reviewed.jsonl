{"id": "sayakbay-ms-current146:pdf116:l002", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 116, "folio": 499, "line_in_page": 2, "raw": "Ал ханды баш бар кезде,", "text": "Ал ханды баш бар кезде,", "en": "When that khan still stood at their head,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf116:l003", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 116, "folio": 499, "line_in_page": 3, "raw": "Көсөө куйрук көк даңкыр,", "text": "Көсөө куйрук көк даңкыр,", "en": "A blue-gray steed with a sweeping tail,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf116:l004", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 116, "folio": 499, "line_in_page": 4, "raw": "Далайды жеңип бору элек,", "text": "Далайды жеңип бору элек,", "en": "We had defeated many and grown strong,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf116:l005", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 116, "folio": 499, "line_in_page": 5, "raw": "Ат талаада без жарбын,", "text": "Ат талаада без жарбын,", "en": "Our horses raced upon the open steppe,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf116:l006", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 116, "folio": 499, "line_in_page": 6, "raw": "Тоону басып жүрөр элек,", "text": "Тоону басып жүрөр элек,", "en": "We used to range across the mountains,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf116:l007", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 116, "folio": 499, "line_in_page": 7, "raw": "Дөөлөт башта барында,", "text": "Дөөлөт башта барында,", "en": "When fortune stood over our heads,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf116:l008", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 116, "folio": 499, "line_in_page": 8, "raw": "Бизге бала кеп кайтаар эле.", "text": "Бизге бала кеп кайтаар эле.", "en": "Even youths would answer us with words.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf116:l009", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 116, "folio": 499, "line_in_page": 9, "raw": "Калк короочу баатырбыз,", "text": "Калк короочу баатырбыз,", "en": "We are warriors who guard the people,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf116:l010", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 116, "folio": 499, "line_in_page": 10, "raw": "Каны калмак арыкпыз,", "text": "Каны калмак арыкпыз,", "en": "We are of Kalmak blood and lineage,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf116:l011", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 116, "folio": 499, "line_in_page": 11, "raw": "Каардуудан токмок жеп,", "text": "Каардуудан токмок жеп,", "en": "Beaten by the wrathful one,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf116:l012", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 116, "folio": 499, "line_in_page": 12, "raw": "Какандан качкан карыппыз.", "text": "Какандан качкан карыппыз.", "en": "We are wretches who fled the khagan.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf116:l013", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 116, "folio": 499, "line_in_page": 13, "raw": "Сырдаш жанды элбиз,", "text": "Сырдаш жанды элбиз,", "en": "We are a people of trusted companions,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf116:l014", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 116, "folio": 499, "line_in_page": 14, "raw": "Сырты кара душманга,", "text": "Сырты кара душманга,", "en": "Against the dark enemy outside,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf116:l015", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 116, "folio": 499, "line_in_page": 15, "raw": "Колтугун ачып келтирбиз.", "text": "Колтугун ачып келтирбиз.", "en": "We came with our arms opened wide.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf116:l016", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 116, "folio": 499, "line_in_page": 16, "raw": "Куман жалдуу шайкышыз,", "text": "Куман жалдуу шайкышыз,", "en": "We are fighters with dun-colored manes,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf116:l017", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 116, "folio": 499, "line_in_page": 17, "raw": "Талкандан жара ок түйүп,", "text": "Талкандан жара ок түйүп,", "en": "Binding bullets into our wounds,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf116:l018", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 116, "folio": 499, "line_in_page": 18, "raw": "Биз бир жарадар болгон байкушпуз.", "text": "Биз бир жарадар болгон байкушпуз.", "en": "We are poor men who have been wounded.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf116:l019", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 116, "folio": 499, "line_in_page": 19, "raw": "Эбегей, Көгөй эки арстан,", "text": "Эбегей, Көгөй эки арстан,", "en": "Ebegei and Kogoi, the two lions,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf116:l020", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 116, "folio": 499, "line_in_page": 20, "raw": "Күйрүк сүйрүп чууга сал,", "text": "Күйрүк сүйрүп чууга сал,", "en": "Dragging their tails, raising an uproar,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf116:l021", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 116, "folio": 499, "line_in_page": 21, "raw": "Байге алчу тулпарбыз,", "text": "Байге алчу тулпарбыз,", "en": "We are coursers that win the prize,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf116:l022", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 116, "folio": 499, "line_in_page": 22, "raw": "Табы жок салса бору алгак,", "text": "Табы жок салса бору алгак,", "en": "Even untrained, when loosed we took the wolf,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf116:l023", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 116, "folio": 499, "line_in_page": 23, "raw": "Кара барчын шумкарбыз.", "text": "Кара барчын шумкарбыз.", "en": "We are dark gyrfalcons.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf116:l024", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 116, "folio": 499, "line_in_page": 24, "raw": "Өзүңө катар эренбиз,", "text": "Өзүңө катар эренбиз,", "en": "We are heroes equal to you,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf116:l025", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 116, "folio": 499, "line_in_page": 25, "raw": "Хан каарына жолугуп,", "text": "Хан каарына жолугуп,", "en": "Having encountered the khan’s wrath,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf116:l026", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 116, "folio": 499, "line_in_page": 26, "raw": "Жай табалбай аңтарылган", "text": "Жай табалбай аңтарылган", "en": "Driven about, unable to find a resting place,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf116:l027", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 116, "folio": 499, "line_in_page": 27, "raw": "Биз бир калкы кеткен кембиз.", "text": "Биз бир калкы кеткен кембиз.", "en": "We are diminished men whose people are gone.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf116:l028", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 116, "folio": 499, "line_in_page": 28, "raw": "Күтүп ал деп жүрүпбүз,", "text": "Күтүп ал деп жүрүпбүз,", "en": "We have gone about saying, “Receive us,”", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf116:l029", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 116, "folio": 499, "line_in_page": 29, "raw": "Каалап кутун бузду алсаң,", "text": "Каалап кутун бузду алсаң,", "en": "If you choose to break and take our fortune,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf116:l030", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 116, "folio": 499, "line_in_page": 30, "raw": "Биз кадырлуунун бирибиз.", "text": "Биз кадырлуунун бирибиз.", "en": "We are among the honored ones.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf116:l031", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 116, "folio": 499, "line_in_page": 31, "raw": "Кара жолдон ак болуп,", "text": "Кара жолдон ак болуп,", "en": "Turning from the dark path toward the light,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf116:l032", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 116, "folio": 499, "line_in_page": 32, "raw": "Кылча коргой дүйнөнү,", "text": "Кылча коргой дүйнөнү,", "en": "Guarding the world by a hair’s breadth,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf116:l033", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 116, "folio": 499, "line_in_page": 33, "raw": "Хан каарына чалканбыз,", "text": "Хан каарына чалканбыз,", "en": "We have been struck down by the khan’s wrath,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf116:l034", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 116, "folio": 499, "line_in_page": 34, "raw": "Кара ишеним азгырып,", "text": "Кара ишеним азгырып,", "en": "Led astray by dark belief,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf116:l035", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 116, "folio": 499, "line_in_page": 35, "raw": "Оодарылып эл таппай,", "text": "Оодарылып эл таппай,", "en": "Wandering without finding a people,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf116:l036", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 116, "folio": 499, "line_in_page": 36, "raw": "Какандан качкан эренбиз,", "text": "Какандан качкан эренбиз,", "en": "We are heroes who fled the khagan,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
