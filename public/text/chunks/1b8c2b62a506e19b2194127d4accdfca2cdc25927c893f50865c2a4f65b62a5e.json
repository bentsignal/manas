[{"id":"semetey-1-2013:p0906:b004:l020","ordinal":145409,"en":"If you become the orphan's companions,"},{"id":"semetey-1-2013:p0906:b004:l021","ordinal":145410,"en":"Damn you, forty companions,"},{"id":"semetey-1-2013:p0906:b004:l022","ordinal":145411,"en":"You will see some fine wonders!"},{"id":"semetey-1-2013:p0906:b004:l024","ordinal":145412,"en":"His mother is a scheming bitch.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0906:b004:l025","ordinal":145413,"en":"You have your dignitaries and elders,"},{"id":"semetey-1-2013:p0906:b004:l026","ordinal":145414,"en":"Damn you, forty companions,"},{"id":"semetey-1-2013:p0906:b004:l027","ordinal":145415,"en":"Unless slaughter strikes them,"},{"id":"semetey-1-2013:p0906:b004:l028","ordinal":145416,"en":"They are all still there."},{"id":"semetey-1-2013:p0906:b004:l029","ordinal":145417,"en":"As a wife, she disrupted the people;"},{"id":"semetey-1-2013:p0906:b004:l030","ordinal":145418,"en":"When his mother was a girl,"},{"id":"semetey-1-2013:p0906:b004:l031","ordinal":145419,"en":"She shook the world and disrupted the people."},{"id":"semetey-1-2013:p0906:b004:l032","ordinal":145420,"en":"In the city of mighty Bukhara,"},{"id":"semetey-1-2013:p0906:b004:l033","ordinal":145421,"en":"In Temir Khan's settlement,"},{"id":"semetey-1-2013:p0906:b004:l034","ordinal":145422,"en":"His wretched mother Kanykei,"},{"id":"semetey-1-2013:p0906:b004:l035","ordinal":145423,"en":"A playful little child,"},{"id":"semetey-1-2013:p0906:b004:l036","ordinal":145424,"en":"Her hair not yet long enough to braid,"},{"id":"semetey-1-2013:p0906:b004:l037","ordinal":145425,"en":"Not yet past fourteen years,"},{"id":"semetey-1-2013:p0906:b004:l038","ordinal":145426,"en":"Bakai and Koshoi, the two giants,"},{"id":"semetey-1-2013:p0906:b004:l039","ordinal":145427,"en":"Calling her 'a lion among women,'"},{"id":"semetey-1-2013:p0907:b003:l001","ordinal":145428,"en":"When those two had judged her,"},{"id":"semetey-1-2013:p0907:b003:l002","ordinal":145429,"en":"Saying, 'I shall have her bear a lion,'"},{"id":"semetey-1-2013:p0907:b003:l003","ordinal":145430,"en":"Reckless Khan Manas"},{"id":"semetey-1-2013:p0907:b003:l004","ordinal":145431,"en":"Loaded eighty camels with gold coins,"},{"id":"semetey-1-2013:p0907:b003:l005","ordinal":145432,"en":"And went to arrange the marriage."},{"id":"semetey-1-2013:p0907:b003:l006","ordinal":145433,"en":"According to Muslim custom,"},{"id":"semetey-1-2013:p0907:b003:l007","ordinal":145434,"en":"Temir Khan, the khan of Bukhara,"},{"id":"semetey-1-2013:p0907:b003:l008","ordinal":145435,"en":"Saying, 'I shall give her to this Manas,'"},{"id":"semetey-1-2013:p0907:b003:l009","ordinal":145436,"en":"Gathered khojas and mullahs,"},{"id":"semetey-1-2013:p0907:b003:l010","ordinal":145437,"en":"And performed the marriage at noon."},{"id":"semetey-1-2013:p0907:b003:l011","ordinal":145438,"en":"According to the ancient custom,"},{"id":"semetey-1-2013:p0907:b003:l012","ordinal":145439,"en":"Into the arms of hulking Lord Manas"},{"id":"semetey-1-2013:p0907:b003:l013","ordinal":145440,"en":"To place the girl,"},{"id":"semetey-1-2013:p0907:b003:l014","ordinal":145441,"en":"And receive the sisters-in-law's gift,"},{"id":"semetey-1-2013:p0907:b003:l015","ordinal":145442,"en":"Ninety young wives and ninety girls,"},{"id":"semetey-1-2013:p0907:b003:l016","ordinal":145443,"en":"Saying, 'We shall lay her beside Manas,'"},{"id":"semetey-1-2013:p0907:b003:l017","ordinal":145444,"en":"Brought her there."},{"id":"semetey-1-2013:p0907:b003:l018","ordinal":145445,"en":"She refused to lie with him then,"},{"id":"semetey-1-2013:p0907:b003:l019","ordinal":145446,"en":"And the whole people bore the uproar."},{"id":"semetey-1-2013:p0907:b003:l020","ordinal":145447,"en":"Kanykei drew her dagger"},{"id":"semetey-1-2013:p0907:b003:l021","ordinal":145448,"en":"And then stabbed through"},{"id":"semetey-1-2013:p0907:b003:l022","ordinal":145449,"en":"Khan Manas's forearm."},{"id":"semetey-1-2013:p0907:b003:l023","ordinal":145450,"en":"That bitch who stabbed Manas,"},{"id":"semetey-1-2013:p0907:b003:l024","ordinal":145451,"en":"Now urging on her son,"},{"id":"semetey-1-2013:p0907:b003:l025","ordinal":145452,"en":"Will she leave us alive?"},{"id":"semetey-1-2013:p0907:b003:l026","ordinal":145453,"en":"There is much to tell of her;"},{"id":"semetey-1-2013:p0907:b003:l027","ordinal":145454,"en":"This bitch has an unhealed grudge."},{"id":"semetey-1-2013:p0907:b003:l028","ordinal":145455,"en":"When Manas died,"},{"id":"semetey-1-2013:p0907:b003:l029","ordinal":145456,"en":"Before forty days had passed since his death,"},{"id":"semetey-1-2013:p0907:b003:l030","ordinal":145457,"en":"You found a wicked way to deal with her,"},{"id":"semetey-1-2013:p0907:b003:l031","ordinal":145458,"en":"Damn you, forty companions,"},{"id":"semetey-1-2013:p0907:b003:l032","ordinal":145459,"en":"You slashed her breast!\""},{"id":"semetey-1-2013:p0907:b003:l033","ordinal":145460,"en":"The villains Chyibyt and Kochkor,"},{"id":"semetey-1-2013:p0907:b003:l034","ordinal":145461,"en":"The wicked men who would not heed words,"},{"id":"semetey-1-2013:p0907:b003:l035","ordinal":145462,"en":"The ignorant men whom God Almighty"},{"id":"semetey-1-2013:p0907:b003:l036","ordinal":145463,"en":"Had steeped in wickedness—"},{"id":"semetey-1-2013:p0907:b003:l037","ordinal":145464,"en":"Khan Manas's forty companions"},{"id":"semetey-1-2013:p0907:b003:l038","ordinal":145465,"en":"Believed what they said."},{"id":"semetey-1-2013:p0907:b003:l039","ordinal":145466,"en":"When the sun sank slowly,"},{"id":"semetey-1-2013:p0907:b005:l001","ordinal":145467,"en":"When the first people lay down,"},{"id":"semetey-1-2013:p0907:b005:l002","ordinal":145468,"en":"Unseen by a single person,"},{"id":"semetey-1-2013:p0907:b005:l003","ordinal":145469,"en":"Unknown to anyone,"},{"id":"semetey-1-2013:p0907:b005:l004","ordinal":145470,"en":"Leaving their abundant wealth scattered,"},{"id":"semetey-1-2013:p0907:b005:l005","ordinal":145471,"en":"All the forty companions"},{"id":"semetey-1-2013:p0907:b005:l006","ordinal":145472,"en":"Now fled from Talas."},{"id":"semetey-1-2013:p0907:b005:l007","ordinal":145473,"en":"They crossed Ashmara,"},{"id":"semetey-1-2013:p0907:b005:l008","ordinal":145474,"en":"Traveled through Keng-Ozon."},{"id":"semetey-1-2013:p0907:b005:l009","ordinal":145475,"en":"'Why should we stay here?"},{"id":"semetey-1-2013:p0907:b005:l010","ordinal":145476,"en":"To Kongurbai of the Chinese,"},{"id":"semetey-1-2013:p0907:b005:l011","ordinal":145477,"en":"Let us flee,"},{"id":"semetey-1-2013:p0907:b005:l012","ordinal":145478,"en":"And become his companions."},{"id":"semetey-1-2013:p0907:b005:l013","ordinal":145479,"en":"That daughter-cursed orphan,"},{"id":"semetey-1-2013:p0907:b005:l014","ordinal":145480,"en":"Let us bring him to his end this way."},{"id":"semetey-1-2013:p0907:b005:l015","ordinal":145481,"en":"Let us plunder his precious cloth,"},{"id":"semetey-1-2013:p0907:b005:l016","ordinal":145482,"en":"Then bring disorder."},{"id":"semetey-1-2013:p0907:b005:l017","ordinal":145483,"en":"Against that impetuous orphan,"},{"id":"semetey-1-2013:p0907:b005:l019","ordinal":145484,"en":"Taking the road along Keng-Ozon,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0907:b005:l020","ordinal":145485,"en":"They traveled a considerable way."},{"id":"semetey-1-2013:p0907:b005:l021","ordinal":145486,"en":"On the banks of the broad Ili,"},{"id":"semetey-1-2013:p0907:b005:l022","ordinal":145487,"en":"They reached Kyzyl-Jiyde."},{"id":"semetey-1-2013:p0907:b005:l023","ordinal":145488,"en":"Spreading out their food,"},{"id":"semetey-1-2013:p0907:b005:l024","ordinal":145489,"en":"Each man set his own small kettle"},{"id":"semetey-1-2013:p0907:b005:l025","ordinal":145490,"en":"To boil on the open plain."},{"id":"semetey-1-2013:p0907:b005:l026","ordinal":145491,"en":"They stopped for a long while,"},{"id":"semetey-1-2013:p0907:b005:l027","ordinal":145492,"en":"And all their riding animals"},{"id":"semetey-1-2013:p0907:b005:l028","ordinal":145493,"en":"They tethered."},{"id":"semetey-1-2013:p0907:b005:l029","ordinal":145494,"en":"All the choice noble steeds,"},{"id":"semetey-1-2013:p0907:b005:l030","ordinal":145495,"en":"The forty companions then"},{"id":"semetey-1-2013:p0907:b005:l031","ordinal":145496,"en":"Unsaddled and left bare-backed,"},{"id":"semetey-1-2013:p0907:b005:l032","ordinal":145497,"en":"Fastening hobbles upon their legs."},{"id":"semetey-1-2013:p0907:b005:l033","ordinal":145498,"en":"Eating the horses' yearling fillies,"},{"id":"semetey-1-2013:p0907:b005:l034","ordinal":145499,"en":"Eating the goats' congealed fat,"},{"id":"semetey-1-2013:p0907:b005:l035","ordinal":145500,"en":"The forty companions lay reveling."},{"id":"semetey-1-2013:p0907:b005:l036","ordinal":145501,"en":"When the bright dawn broke,"},{"id":"semetey-1-2013:p0907:b005:l037","ordinal":145502,"en":"When light fell upon the earth,"},{"id":"semetey-1-2013:p0907:b005:l038","ordinal":145503,"en":"Waking with a start from sleep,"},{"id":"semetey-1-2013:p0907:b005:l039","ordinal":145504,"en":"Semetey, son of Manas,"},{"id":"semetey-1-2013:p0908:b003:l001","ordinal":145505,"en":"His sleep scattered away,"},{"id":"semetey-1-2013:p0908:b003:l002","ordinal":145506,"en":"His eyes opened wide,"},{"id":"semetey-1-2013:p0908:b003:l004","ordinal":145507,"en":"His entire body","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0908:b003:l005","ordinal":145508,"en":"Trembled visibly."},{"id":"semetey-1-2013:p0908:b003:l006","ordinal":145509,"en":"With leather sweatcloth and blue saddlecloth,"},{"id":"semetey-1-2013:p0908:b003:l007","ordinal":145510,"en":"He saddled the Buurul horse."},{"id":"semetey-1-2013:p0908:b003:l008","ordinal":145511,"en":"Your seething orphan"},{"id":"semetey-1-2013:p0908:b003:l009","ordinal":145512,"en":"Was alarmed about the forty companions."},{"id":"semetey-1-2013:p0908:b003:l010","ordinal":145513,"en":"Distressed within himself,"},{"id":"semetey-1-2013:p0908:b003:l011","ordinal":145514,"en":"He put on his bulletproof coat,"},{"id":"semetey-1-2013:p0908:b003:l012","ordinal":145515,"en":"Fastened his gray belt-pouch,"},{"id":"semetey-1-2013:p0908:b003:l013","ordinal":145516,"en":"Pleaded with the Creator,"},{"id":"semetey-1-2013:p0908:b003:l014","ordinal":145517,"en":"Put on his bulletproof coat."},{"id":"semetey-1-2013:p0908:b003:l016","ordinal":145518,"en":"Without stepping into the gold-bottomed stirrup,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0908:b003:l017","ordinal":145519,"en":"Your orphan sprang up,"},{"id":"semetey-1-2013:p0908:b003:l018","ordinal":145520,"en":"Leaping like a sheep, he mounted."},{"id":"semetey-1-2013:p0908:b003:l019","ordinal":145521,"en":"Calling them 'my father's inheritance,'"},{"id":"semetey-1-2013:p0908:b003:l020","ordinal":145522,"en":"To the forty companions themselves"},{"id":"semetey-1-2013:p0908:b003:l021","ordinal":145523,"en":"He had allotted a great court,"},{"id":"semetey-1-2013:p0908:b003:l022","ordinal":145524,"en":"An immeasurably vast court,"},{"id":"semetey-1-2013:p0908:b003:l023","ordinal":145525,"en":"Where no servant went without ablution."},{"id":"semetey-1-2013:p0908:b003:l024","ordinal":145526,"en":"The forty companions themselves—"},{"id":"semetey-1-2013:p0908:b003:l025","ordinal":145527,"en":"No one who challenged them remained alive,"},{"id":"semetey-1-2013:p0908:b003:l026","ordinal":145528,"en":"No one went there without permission,"},{"id":"semetey-1-2013:p0908:b003:l027","ordinal":145529,"en":"Without meeting some calamity,"},{"id":"semetey-1-2013:p0908:b003:l028","ordinal":145530,"en":"No one who encountered them escaped unharmed."},{"id":"semetey-1-2013:p0908:b003:l029","ordinal":145531,"en":"The great court of the forty companions—"},{"id":"semetey-1-2013:p0908:b003:l030","ordinal":145532,"en":"When he came to that great court,"},{"id":"semetey-1-2013:p0908:b003:l031","ordinal":145533,"en":"When he looked at the court,"},{"id":"semetey-1-2013:p0908:b003:l033","ordinal":145534,"en":"When he looked for the forty companions,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0908:b003:l034","ordinal":145535,"en":"They had scattered in every direction."},{"id":"semetey-1-2013:p0908:b003:l035","ordinal":145536,"en":"Their campsite remained, but they were gone;"},{"id":"semetey-1-2013:p0908:b003:l036","ordinal":145537,"en":"Such was this shitty world!"},{"id":"semetey-1-2013:p0908:b003:l037","ordinal":145538,"en":"The pass of Ashmara—"},{"id":"semetey-1-2013:p0908:b003:l038","ordinal":145539,"en":"They seemed to have crossed it;"},{"id":"semetey-1-2013:p0908:b003:l039","ordinal":145540,"en":"Along Keng-Ozon, the forty companions"},{"id":"semetey-1-2013:p0908:b004:l001","ordinal":145541,"en":"Seemed to have fled."},{"id":"semetey-1-2013:p0908:b004:l002","ordinal":145542,"en":"Renouncing their wealth,"},{"id":"semetey-1-2013:p0908:b004:l003","ordinal":145543,"en":"They seemed to have scattered it."},{"id":"semetey-1-2013:p0908:b004:l004","ordinal":145544,"en":"Semetey, son of Manas,"},{"id":"semetey-1-2013:p0908:b004:l005","ordinal":145545,"en":"As though his father, leopard Manas,"},{"id":"semetey-1-2013:p0908:b004:l006","ordinal":145546,"en":"Had only just departed this world:"},{"id":"semetey-1-2013:p0908:b004:l007","ordinal":145547,"en":"'My lion father, do not die!"},{"id":"semetey-1-2013:p0908:b004:l008","ordinal":145548,"en":"May no one be left fatherless!"},{"id":"semetey-1-2013:p0908:b004:l009","ordinal":145549,"en":"Such humiliation as this,"},{"id":"semetey-1-2013:p0908:b004:l010","ordinal":145550,"en":"If God creates a living soul,"},{"id":"semetey-1-2013:p0908:b004:l011","ordinal":145551,"en":"May He never inflict it on His servant!'"},{"id":"semetey-1-2013:p0908:b004:l012","ordinal":145552,"en":"God's sun grew overcast in the sky;"},{"id":"semetey-1-2013:p0908:b004:l013","ordinal":145553,"en":"Upon Semetey's head"},{"id":"semetey-1-2013:p0908:b004:l014","ordinal":145554,"en":"Sixty cares came all at once."},{"id":"semetey-1-2013:p0908:b004:l015","ordinal":145555,"en":"Raging and rumbling,"},{"id":"semetey-1-2013:p0908:b004:l016","ordinal":145556,"en":"His heart burned with grief."},{"id":"semetey-1-2013:p0908:b004:l017","ordinal":145557,"en":"The young lord rode out,"},{"id":"semetey-1-2013:p0908:b004:l018","ordinal":145558,"en":"His dear saker-falcon eyes"},{"id":"semetey-1-2013:p0908:b004:l019","ordinal":145559,"en":"Shedding tears without a blink."},{"id":"semetey-1-2013:p0908:b004:l020","ordinal":145560,"en":"Too many cares for his heart to hold,"},{"id":"semetey-1-2013:p0908:b004:l021","ordinal":145561,"en":"His tears flowed in ten directions."},{"id":"semetey-1-2013:p0908:b004:l022","ordinal":145562,"en":"That orphan of Manas"},{"id":"semetey-1-2013:p0908:b004:l023","ordinal":145563,"en":"Rode Buurul, making him plunge,"},{"id":"semetey-1-2013:p0908:b004:l024","ordinal":145564,"en":"Making him lunge like a widow in grief."},{"id":"semetey-1-2013:p0908:b004:l025","ordinal":145565,"en":"When he let Buurul's mouth go,"},{"id":"semetey-1-2013:p0908:b004:l026","ordinal":145566,"en":"The horse raced the flying birds."},{"id":"semetey-1-2013:p0908:b004:l027","ordinal":145567,"en":"When Semetey checked his mouth,"},{"id":"semetey-1-2013:p0908:b004:l028","ordinal":145568,"en":"The white reins braided in okoro fashion,"},{"id":"semetey-1-2013:p0908:b004:l029","ordinal":145569,"en":"He braced both hands upon the reins."},{"id":"semetey-1-2013:p0908:b004:l030","ordinal":145570,"en":"He made him plunge beyond measure,"},{"id":"semetey-1-2013:p0908:b004:l031","ordinal":145571,"en":"And without end he wrestled"},{"id":"semetey-1-2013:p0908:b004:l032","ordinal":145572,"en":"With the swift steed's mouth."},{"id":"semetey-1-2013:p0908:b004:l033","ordinal":145573,"en":"When they came to broken ground,"},{"id":"semetey-1-2013:p0908:b004:l034","ordinal":145574,"en":"He twisted his neck like a stag."},{"id":"semetey-1-2013:p0908:b004:l035","ordinal":145575,"en":"Ditches a target's height deep,"},{"id":"semetey-1-2013:p0908:b004:l036","ordinal":145576,"en":"He leaped without hesitation."},{"id":"semetey-1-2013:p0908:b004:l037","ordinal":145577,"en":"When they came to hilly ground,"},{"id":"semetey-1-2013:p0908:b004:l038","ordinal":145578,"en":"He sped like a mirage."},{"id":"semetey-1-2013:p0908:b004:l039","ordinal":145579,"en":"Clods as big as a great cauldron,"},{"id":"semetey-1-2013:p0909:b003:l001","ordinal":145580,"en":"Flew whistling over his head."},{"id":"semetey-1-2013:p0909:b003:l002","ordinal":145581,"en":"Laying back his ears like a wild ass,"},{"id":"semetey-1-2013:p0909:b003:l003","ordinal":145582,"en":"Semetey's Buurul"},{"id":"semetey-1-2013:p0909:b003:l004","ordinal":145583,"en":"Scattered the earth like a whirlwind."},{"id":"semetey-1-2013:p0909:b003:l005","ordinal":145584,"en":"Visible wherever he could be seen,"},{"id":"semetey-1-2013:p0909:b003:l006","ordinal":145585,"en":"And when Buurul disappeared,"},{"id":"semetey-1-2013:p0909:b003:l007","ordinal":145586,"en":"He vanished like blue smoke."},{"id":"semetey-1-2013:p0909:b003:l008","ordinal":145587,"en":"The ground spun past beneath his clattering hooves;"},{"id":"semetey-1-2013:p0909:b003:l009","ordinal":145588,"en":"When Buurul's mouth was given freedom,"},{"id":"semetey-1-2013:p0909:b003:l010","ordinal":145589,"en":"He flew onward like a mirage."},{"id":"semetey-1-2013:p0909:b003:l011","ordinal":145590,"en":"Following their trail without respite,"},{"id":"semetey-1-2013:p0909:b003:l012","ordinal":145591,"en":"He pursued them relentlessly,"},{"id":"semetey-1-2013:p0909:b003:l013","ordinal":145592,"en":"Following the horses' tracks,"},{"id":"semetey-1-2013:p0909:b003:l014","ordinal":145593,"en":"He pursued without mercy."},{"id":"semetey-1-2013:p0909:b003:l015","ordinal":145594,"en":"The tail beneath him thinned out,"},{"id":"semetey-1-2013:p0909:b003:l016","ordinal":145595,"en":"The sweat flowing from his chest"},{"id":"semetey-1-2013:p0909:b003:l017","ordinal":145596,"en":"Poured off the stirrups."},{"id":"semetey-1-2013:p0909:b003:l018","ordinal":145597,"en":"Along the winding spring-fed stream,"},{"id":"semetey-1-2013:p0909:b003:l019","ordinal":145598,"en":"Along the curving road,"},{"id":"semetey-1-2013:p0909:b003:l020","ordinal":145599,"en":"Semetey's Buurul,"},{"id":"semetey-1-2013:p0909:b003:l021","ordinal":145600,"en":"Noble in form, straight-backed,"},{"id":"semetey-1-2013:p0909:b003:l022","ordinal":145601,"en":"A broad-ribbed warhorse—"},{"id":"semetey-1-2013:p0909:b003:l023","ordinal":145602,"en":"Against Karacha's Saikal,"},{"id":"semetey-1-2013:p0909:b003:l024","ordinal":145603,"en":"When they went to fight,"},{"id":"semetey-1-2013:p0909:b003:l025","ordinal":145604,"en":"The Buurul horse given in that struggle,"},{"id":"semetey-1-2013:p0909:b003:l026","ordinal":145605,"en":"When they clashed,"},{"id":"semetey-1-2013:p0909:b003:l027","ordinal":145606,"en":"And all the forty companions"},{"id":"semetey-1-2013:p0909:b003:l028","ordinal":145607,"en":"Were beaten and left on foot."},{"id":"semetey-1-2013:p0909:b003:l029","ordinal":145608,"en":"They fought with spears for forty-two days,"},{"id":"semetey-1-2013:p0909:b003:l030","ordinal":145609,"en":"When Saikal showed her prowess,"},{"id":"semetey-1-2013:p0909:b003:l031","ordinal":145610,"en":"Almambet and Manas, the two lions,"},{"id":"semetey-1-2013:p0909:b003:l032","ordinal":145611,"en":"Caught her between them."},{"id":"semetey-1-2013:p0909:b003:l033","ordinal":145612,"en":"Despairing of her dear life,"},{"id":"semetey-1-2013:p0909:b003:l034","ordinal":145613,"en":"She gave Taibuurul as a gift."},{"id":"semetey-1-2013:p0909:b003:l035","ordinal":145614,"en":"Kongurbai's Algara—"},{"id":"semetey-1-2013:p0909:b003:l036","ordinal":145615,"en":"He was so much better than Algara,"},{"id":"semetey-1-2013:p0909:b003:l037","ordinal":145616,"en":"So much better than Ak-Kula."},{"id":"semetey-1-2013:p0909:b003:l038","ordinal":145617,"en":"His hooves differed from other beasts':"},{"id":"semetey-1-2013:p0909:b003:l039","ordinal":145618,"en":"Like great dark bowls for pouring milk."},{"id":"semetey-1-2013:p0909:b004:l001","ordinal":145619,"en":"If you looked at his croup,"},{"id":"semetey-1-2013:p0909:b004:l002","ordinal":145620,"en":"It appeared as broad as a plain."},{"id":"semetey-1-2013:p0909:b004:l003","ordinal":145621,"en":"Plump and full-fleshed,"},{"id":"semetey-1-2013:p0909:b004:l004","ordinal":145622,"en":"This creature Buurul's"},{"id":"semetey-1-2013:p0909:b004:l005","ordinal":145623,"en":"Leaping was like a flea's."},{"id":"semetey-1-2013:p0909:b004:l006","ordinal":145624,"en":"When his mouth was truly given freedom,"},{"id":"semetey-1-2013:p0909:b004:l007","ordinal":145625,"en":"That fleet-footed creature—"},{"id":"semetey-1-2013:p0909:b004:l008","ordinal":145626,"en":"A person's thoughts were swept away."},{"id":"semetey-1-2013:p0909:b004:l009","ordinal":145627,"en":"When he came onto the open plain,"},{"id":"semetey-1-2013:p0909:b004:l010","ordinal":145628,"en":"The earth spun past like a mirage,"},{"id":"semetey-1-2013:p0909:b004:l011","ordinal":145629,"en":"He seemed about to fly."},{"id":"semetey-1-2013:p0909:b004:l012","ordinal":145630,"en":"Seeing his true speed,"},{"id":"semetey-1-2013:p0909:b004:l013","ordinal":145631,"en":"The lord upon him"},{"id":"semetey-1-2013:p0909:b004:l014","ordinal":145632,"en":"Had his thoughts swept away."},{"id":"semetey-1-2013:p0909:b004:l015","ordinal":145633,"en":"Even on a journey of forty days,"},{"id":"semetey-1-2013:p0909:b004:l016","ordinal":145634,"en":"Even through places of hardship,"},{"id":"semetey-1-2013:p0909:b004:l017","ordinal":145635,"en":"Without drinking a drop of water,"},{"id":"semetey-1-2013:p0909:b004:l018","ordinal":145636,"en":"Without cropping a single mouthful of grass,"},{"id":"semetey-1-2013:p0909:b004:l019","ordinal":145637,"en":"He was a beast that could endure."},{"id":"semetey-1-2013:p0909:b004:l020","ordinal":145638,"en":"'So my son may ride him in his strength,'"},{"id":"semetey-1-2013:p0909:b004:l021","ordinal":145639,"en":"Khan Manas, who had gone to the other world,"},{"id":"semetey-1-2013:p0909:b004:l022","ordinal":145640,"en":"Had set him aside as his son's own share."},{"id":"semetey-1-2013:p0909:b004:l023","ordinal":145641,"en":"His back bent like a trap,"},{"id":"semetey-1-2013:p0909:b004:l024","ordinal":145642,"en":"Through gray caragana and brush,"},{"id":"semetey-1-2013:p0909:b004:l026","ordinal":145643,"en":"Short in the forelegs, great in body,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0909:b004:l027","ordinal":145644,"en":"He traveled far, a considerable road."},{"id":"semetey-1-2013:p0909:b004:l028","ordinal":145645,"en":"Before one could say a word,"},{"id":"semetey-1-2013:p0909:b004:l029","ordinal":145646,"en":"Before an eye could open and close,"},{"id":"semetey-1-2013:p0909:b004:l030","ordinal":145647,"en":"Upon the forty companions"},{"id":"semetey-1-2013:p0909:b004:l031","ordinal":145648,"en":"He arrived on that journey."},{"id":"semetey-1-2013:p0909:b004:l032","ordinal":145649,"en":"His flesh grown hot, Buurul"},{"id":"semetey-1-2013:p0909:b004:l033","ordinal":145650,"en":"Emerged like blue smoke,"},{"id":"semetey-1-2013:p0909:b004:l034","ordinal":145651,"en":"And Semetey upon him"},{"id":"semetey-1-2013:p0909:b004:l035","ordinal":145652,"en":"Loomed like Opol-Too."},{"id":"semetey-1-2013:p0909:b004:l036","ordinal":145653,"en":"All the forty companions,"},{"id":"semetey-1-2013:p0909:b004:l037","ordinal":145654,"en":"When they saw Semetey,"},{"id":"semetey-1-2013:p0909:b004:l038","ordinal":145655,"en":"Surged about in confusion."},{"id":"semetey-1-2013:p0909:b004:l039","ordinal":145656,"en":"They had been resting unhurried, unaware—"},{"id":"semetey-1-2013:p0910:b003:l001","ordinal":145657,"en":"Dozing over their little camp kettles."},{"id":"semetey-1-2013:p0910:b003:l002","ordinal":145658,"en":"They called battle to mind;"},{"id":"semetey-1-2013:p0910:b003:l003","ordinal":145659,"en":"The forty companions hurried in alarm"},{"id":"semetey-1-2013:p0910:b003:l004","ordinal":145660,"en":"Each to his own horse,"},{"id":"semetey-1-2013:p0910:b003:l005","ordinal":145661,"en":"Made ready their weapons of war,"},{"id":"semetey-1-2013:p0910:b003:l006","ordinal":145662,"en":"As though the Chinese hook-nosed Konur"},{"id":"semetey-1-2013:p0910:b003:l007","ordinal":145663,"en":"Had come upon them shouting."},{"id":"semetey-1-2013:p0910:b003:l008","ordinal":145664,"en":"They took their steel guns in hand,"}]
