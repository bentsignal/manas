[{"id":"manas-2010:p1086:b001:l030","ordinal":47361,"en":"The Chinese who ruled it were mighty."},{"id":"manas-2010:p1086:b001:l031","ordinal":47362,"en":"When I looked at some parts,"},{"id":"manas-2010:p1086:b001:l032","ordinal":47363,"en":"A lake lay all around."},{"id":"manas-2010:p1086:b001:l033","ordinal":47364,"en":"Other stretches had no water,"},{"id":"manas-2010:p1086:b001:l034","ordinal":47365,"en":"A journey of forty days."},{"id":"manas-2010:p1086:b001:l035","ordinal":47366,"en":"When I reached that desert,"},{"id":"manas-2010:p1086:b001:l036","ordinal":47367,"en":"I heard rumors from behind me:"},{"id":"manas-2010:p1086:b001:l037","ordinal":47368,"en":"“The sixty wives, my wretched mothers,"},{"id":"manas-2010:p1086:b001:l038","ordinal":47369,"en":"Crying ‘Almambet!’ from grief"},{"id":"manas-2010:p1086:b001:l039","ordinal":47370,"en":"All perished,” I heard."},{"id":"manas-2010:p1086:b001:l040","ordinal":47371,"en":"After my sixty mothers died,"},{"id":"manas-2010:p1086:b001:l041","ordinal":47372,"en":"My insides burned to embers."},{"id":"manas-2010:p1086:b001:l042","ordinal":47373,"en":"When I heard that news,"},{"id":"manas-2010:p1087:b001:l001","ordinal":47374,"en":"Almost dying of sorrow,"},{"id":"manas-2010:p1087:b001:l002","ordinal":47375,"en":"Almambet barely held himself back."},{"id":"manas-2010:p1087:b001:l003","ordinal":47376,"en":"I traveled on level ground, without wind."},{"id":"manas-2010:p1087:b001:l004","ordinal":47377,"en":"To fall into slaughter with the Chinese"},{"id":"manas-2010:p1087:b001:l005","ordinal":47378,"en":"Was in my mind, but I had no means."},{"id":"manas-2010:p1087:b001:l006","ordinal":47379,"en":"Cow-rumped Sarala,"},{"id":"manas-2010:p1087:b001:l007","ordinal":47380,"en":"I had no courser other than him."},{"id":"manas-2010:p1087:b001:l008","ordinal":47381,"en":"To break through their nest,"},{"id":"manas-2010:p1087:b001:l009","ordinal":47382,"en":"To bring them to their end,"},{"id":"manas-2010:p1087:b001:l010","ordinal":47383,"en":"At that time, Khan Manas,"},{"id":"manas-2010:p1087:b001:l011","ordinal":47384,"en":"Cursed be being alone:"},{"id":"manas-2010:p1087:b001:l012","ordinal":47385,"en":"I had no kinsman like you."},{"id":"manas-2010:p1087:b001:l013","ordinal":47386,"en":"If I had a kinsman like you,"},{"id":"manas-2010:p1087:b001:l014","ordinal":47387,"en":"If I did not bring slaughter upon the Chinese,"},{"id":"manas-2010:p1087:b001:l015","ordinal":47388,"en":"Let there be no pity for Almambet."},{"id":"manas-2010:p1087:b001:l016","ordinal":47389,"en":"Cursed be a warrior's solitude;"},{"id":"manas-2010:p1087:b001:l017","ordinal":47390,"en":"I suffered at the Chinese people's hands."},{"id":"manas-2010:p1087:b001:l018","ordinal":47391,"en":"Would the giants leave me undriven?"},{"id":"manas-2010:p1087:b001:l019","ordinal":47392,"en":"If the mood took them, one like me,"},{"id":"manas-2010:p1087:b001:l020","ordinal":47393,"en":"Would they drive him away and slaughter him?"},{"id":"manas-2010:p1087:b001:l021","ordinal":47394,"en":"My insides folded up with worry,"},{"id":"manas-2010:p1087:b001:l022","ordinal":47395,"en":"I was driven away to Beijing,"},{"id":"manas-2010:p1087:b001:l023","ordinal":47396,"en":"Despairing of my solitary soul."},{"id":"manas-2010:p1087:b001:l024","ordinal":47397,"en":"I went in through the doorway,"},{"id":"manas-2010:p1087:b001:l025","ordinal":47398,"en":"Through the opening beset by calamity."},{"id":"manas-2010:p1087:b001:l026","ordinal":47399,"en":"Hear the marvel, Khan Manas,"},{"id":"manas-2010:p1087:b001:l027","ordinal":47400,"en":"Of Beijing with forty doors."},{"id":"manas-2010:p1087:b001:l028","ordinal":47401,"en":"When I looked at one door,"},{"id":"manas-2010:p1087:b001:l029","ordinal":47402,"en":"It opened facing the sunset."},{"id":"manas-2010:p1087:b001:l030","ordinal":47403,"en":"“Muhammad's community,"},{"id":"manas-2010:p1087:b001:l031","ordinal":47404,"en":"Its blessing will reach us,” they said."},{"id":"manas-2010:p1087:b001:l032","ordinal":47405,"en":"Light poured down from the sky,"},{"id":"manas-2010:p1087:b001:l033","ordinal":47406,"en":"The light of Heaven was scattered."},{"id":"manas-2010:p1087:b001:l034","ordinal":47407,"en":"Beijing's khan Karykan"},{"id":"manas-2010:p1087:b001:l035","ordinal":47408,"en":"Had me tended as a treasure,"},{"id":"manas-2010:p1087:b001:l036","ordinal":47409,"en":"Me, wretched Almambet,"},{"id":"manas-2010:p1087:b001:l037","ordinal":47410,"en":"Seeking to please my heart."},{"id":"manas-2010:p1087:b001:l038","ordinal":47411,"en":"“Oh, Almambet, my foal,"},{"id":"manas-2010:p1087:b001:l039","ordinal":47412,"en":"If what you desire is khanship,"},{"id":"manas-2010:p1087:b001:l040","ordinal":47413,"en":"Why should I remain in Beijing?"},{"id":"manas-2010:p1087:b001:l041","ordinal":47414,"en":"My golden crown upon my head,"},{"id":"manas-2010:p1087:b001:l042","ordinal":47415,"en":"My golden throne beneath me,"},{"id":"manas-2010:p1088:b001:l001","ordinal":47416,"en":"Let me leave it to you."},{"id":"manas-2010:p1088:b001:l002","ordinal":47417,"en":"Now that my beard is white,"},{"id":"manas-2010:p1088:b001:l003","ordinal":47418,"en":"For how many years have I been khan?"},{"id":"manas-2010:p1088:b001:l004","ordinal":47419,"en":"Without giving you my throne,"},{"id":"manas-2010:p1088:b001:l005","ordinal":47420,"en":"What wish could I fulfill!”"},{"id":"manas-2010:p1088:b001:l006","ordinal":47421,"en":"The golden crown upon his head"},{"id":"manas-2010:p1088:b001:l007","ordinal":47422,"en":"He craftily had me wear."},{"id":"manas-2010:p1088:b001:l008","ordinal":47423,"en":"The golden throne beneath him—"},{"id":"manas-2010:p1088:b001:l009","ordinal":47424,"en":"He seated me there to kill me."},{"id":"manas-2010:p1088:b001:l010","ordinal":47425,"en":"With cunning, Karykan"},{"id":"manas-2010:p1088:b001:l011","ordinal":47426,"en":"Made his people acknowledge my rule."},{"id":"manas-2010:p1088:b001:l012","ordinal":47427,"en":"This became the occasion to save my life:"},{"id":"manas-2010:p1088:b001:l013","ordinal":47428,"en":"Then there entered my dream"},{"id":"manas-2010:p1088:b001:l014","ordinal":47429,"en":"A barefoot wandering holy man."},{"id":"manas-2010:p1088:b001:l015","ordinal":47430,"en":"“Do not wear the golden crown;"},{"id":"manas-2010:p1088:b001:l016","ordinal":47431,"en":"Karykan is deceiving you."},{"id":"manas-2010:p1088:b001:l017","ordinal":47432,"en":"Do not mount the throne before you."},{"id":"manas-2010:p1088:b001:l018","ordinal":47433,"en":"Beneath the golden throne"},{"id":"manas-2010:p1088:b001:l019","ordinal":47434,"en":"Is a great carpet patterned in gold;"},{"id":"manas-2010:p1088:b001:l020","ordinal":47435,"en":"Even soaked in water forty years,"},{"id":"manas-2010:p1088:b001:l021","ordinal":47436,"en":"Its face would not fade a whit."},{"id":"manas-2010:p1088:b001:l022","ordinal":47437,"en":"This golden throne of Beijing"},{"id":"manas-2010:p1088:b001:l023","ordinal":47438,"en":"Has never fallen to another's lot."},{"id":"manas-2010:p1088:b001:l024","ordinal":47439,"en":"When the Scales star sets,"},{"id":"manas-2010:p1088:b001:l025","ordinal":47440,"en":"When dawn splits and breaks,"},{"id":"manas-2010:p1088:b001:l026","ordinal":47441,"en":"If you doubt it, lift and look"},{"id":"manas-2010:p1088:b001:l027","ordinal":47442,"en":"Beneath the gold-patterned carpet."},{"id":"manas-2010:p1088:b001:l028","ordinal":47443,"en":"Dug beneath it"},{"id":"manas-2010:p1088:b001:l029","ordinal":47444,"en":"Is a pit some forty fathoms deep."},{"id":"manas-2010:p1088:b001:l030","ordinal":47445,"en":"Would a khan behave like that?"},{"id":"manas-2010:p1088:b001:l031","ordinal":47446,"en":"The golden crown, the precious throne—"},{"id":"manas-2010:p1088:b001:l032","ordinal":47447,"en":"Would the man who mounts it prosper?"},{"id":"manas-2010:p1088:b001:l033","ordinal":47448,"en":"If you look along its side,"},{"id":"manas-2010:p1088:b001:l034","ordinal":47449,"en":"No winged bird could fly through,"},{"id":"manas-2010:p1088:b001:l035","ordinal":47450,"en":"No wild ass could leap across;"},{"id":"manas-2010:p1088:b001:l036","ordinal":47451,"en":"Of adamant steel and iron"},{"id":"manas-2010:p1088:b001:l037","ordinal":47452,"en":"A mesh has been forged there."},{"id":"manas-2010:p1088:b001:l038","ordinal":47453,"en":"If you look farther on,"},{"id":"manas-2010:p1088:b001:l039","ordinal":47454,"en":"One who spares none he grapples,"},{"id":"manas-2010:p1088:b001:l040","ordinal":47455,"en":"Who, eating a pig all alone,"},{"id":"manas-2010:p1088:b001:l041","ordinal":47456,"en":"Is not filled by a single helping—"},{"id":"manas-2010:p1088:b001:l042","ordinal":47457,"en":"There is a mighty fellow like Madykan."},{"id":"manas-2010:p1089:b001:l001","ordinal":47458,"en":"He has a house built in Beijing."},{"id":"manas-2010:p1089:b001:l002","ordinal":47459,"en":"Deliberately to slaughter you,"},{"id":"manas-2010:p1089:b001:l003","ordinal":47460,"en":"The Chinese have held ready"},{"id":"manas-2010:p1089:b001:l004","ordinal":47461,"en":"An officer named Madykan."},{"id":"manas-2010:p1089:b001:l005","ordinal":47462,"en":"You will see all these things."},{"id":"manas-2010:p1089:b001:l006","ordinal":47463,"en":"In the Chinese realm's Beijing,"},{"id":"manas-2010:p1089:b001:l007","ordinal":47464,"en":"If you are khan for twenty days,"},{"id":"manas-2010:p1089:b001:l008","ordinal":47465,"en":"Helplessly, Almambet, you will die!”"},{"id":"manas-2010:p1089:b001:l009","ordinal":47466,"en":"When he spoke thus,"},{"id":"manas-2010:p1089:b001:l010","ordinal":47467,"en":"I started awake from sleep,"},{"id":"manas-2010:p1089:b001:l011","ordinal":47468,"en":"And pondered the dream I had seen."},{"id":"manas-2010:p1089:b001:l012","ordinal":47469,"en":"The deep pit they had dug—"},{"id":"manas-2010:p1089:b001:l013","ordinal":47470,"en":"It was truly a ravine."},{"id":"manas-2010:p1089:b001:l014","ordinal":47471,"en":"Devising his scheme, Karykan"},{"id":"manas-2010:p1089:b001:l015","ordinal":47472,"en":"Had gathered the Chinese multitudes;"},{"id":"manas-2010:p1089:b001:l016","ordinal":47473,"en":"It was true he would turn enemy."},{"id":"manas-2010:p1089:b001:l017","ordinal":47474,"en":"The reason for his hostile intent:"},{"id":"manas-2010:p1089:b001:l018","ordinal":47475,"en":"He had selected his champions,"},{"id":"manas-2010:p1089:b001:l019","ordinal":47476,"en":"Stretched a mesh of iron,"},{"id":"manas-2010:p1089:b001:l020","ordinal":47477,"en":"Conferred in furtive agitation,"},{"id":"manas-2010:p1089:b001:l021","ordinal":47478,"en":"And drawn out all the Chinese troops."},{"id":"manas-2010:p1089:b001:l022","ordinal":47479,"en":"Fortifying Great Beijing's outskirts,"},{"id":"manas-2010:p1089:b001:l023","ordinal":47480,"en":"Your Chinese had made"},{"id":"manas-2010:p1089:b001:l024","ordinal":47481,"en":"The way out secure."},{"id":"manas-2010:p1089:b001:l025","ordinal":47482,"en":"To kill your Almambet,"},{"id":"manas-2010:p1089:b001:l026","ordinal":47483,"en":"A great many Chinese"},{"id":"manas-2010:p1089:b001:l027","ordinal":47484,"en":"Set down writing and swore an oath."},{"id":"manas-2010:p1089:b001:l028","ordinal":47485,"en":"Their countless people roared;"},{"id":"manas-2010:p1089:b001:l029","ordinal":47486,"en":"To the idol forged by hand"},{"id":"manas-2010:p1089:b001:l030","ordinal":47487,"en":"They babbled their worship."},{"id":"manas-2010:p1089:b001:l031","ordinal":47488,"en":"At that time Beijing"},{"id":"manas-2010:p1089:b001:l032","ordinal":47489,"en":"Was seething full of Chinese."},{"id":"manas-2010:p1089:b001:l033","ordinal":47490,"en":"Since my arrival in Beijing"},{"id":"manas-2010:p1089:b001:l034","ordinal":47491,"en":"Nineteen days had passed."},{"id":"manas-2010:p1089:b001:l035","ordinal":47492,"en":"At that moment the Chinese"},{"id":"manas-2010:p1089:b001:l036","ordinal":47493,"en":"Month of the Chagaan spring festival had arrived."},{"id":"manas-2010:p1089:b001:l037","ordinal":47494,"en":"When the Chagaan festival month came,"},{"id":"manas-2010:p1089:b001:l038","ordinal":47495,"en":"A copper cauldron with forty handles"},{"id":"manas-2010:p1089:b001:l039","ordinal":47496,"en":"They hung up in the street."},{"id":"manas-2010:p1089:b001:l040","ordinal":47497,"en":"Inside that cauldron,"},{"id":"manas-2010:p1089:b001:l041","ordinal":47498,"en":"Forty mules and forty pigs,"},{"id":"manas-2010:p1089:b001:l042","ordinal":47499,"en":"Forty cats and forty dogs,"},{"id":"manas-2010:p1090:b001:l001","ordinal":47500,"en":"They slaughtered and put inside."},{"id":"manas-2010:p1090:b001:l002","ordinal":47501,"en":"Forty of every kind of animal"},{"id":"manas-2010:p1090:b001:l003","ordinal":47502,"en":"They brought there."},{"id":"manas-2010:p1090:b001:l004","ordinal":47503,"en":"A copper idol big as a hut"},{"id":"manas-2010:p1090:b001:l005","ordinal":47504,"en":"They would hang up and fasten."},{"id":"manas-2010:p1090:b001:l006","ordinal":47505,"en":"Around that idol,"},{"id":"manas-2010:p1090:b001:l007","ordinal":47506,"en":"The Chinese would swarm and crowd."},{"id":"manas-2010:p1090:b001:l008","ordinal":47507,"en":"Fashioning it with their hands,"},{"id":"manas-2010:p1090:b001:l009","ordinal":47508,"en":"Calling their bronze their god,"},{"id":"manas-2010:p1090:b001:l010","ordinal":47509,"en":"The thick-haired Chinese multitudes"},{"id":"manas-2010:p1090:b001:l011","ordinal":47510,"en":"Would busy themselves like this."},{"id":"manas-2010:p1090:b001:l012","ordinal":47511,"en":"At the fortress in Beijing,"},{"id":"manas-2010:p1090:b001:l013","ordinal":47512,"en":"When the Chagaan festival day came—"},{"id":"manas-2010:p1090:b001:l014","ordinal":47513,"en":"My words were a lament—"},{"id":"manas-2010:p1090:b001:l015","ordinal":47514,"en":"In my mother's household,"},{"id":"manas-2010:p1090:b001:l016","ordinal":47515,"en":"To boil her food,"},{"id":"manas-2010:p1090:b001:l017","ordinal":47516,"en":"There was a Chinese servant."},{"id":"manas-2010:p1090:b001:l018","ordinal":47517,"en":"He came running up,"},{"id":"manas-2010:p1090:b001:l019","ordinal":47518,"en":"Bending his knees to the ground,"},{"id":"manas-2010:p1090:b001:l020","ordinal":47519,"en":"Paid homage in the Chinese fashion,"},{"id":"manas-2010:p1090:b001:l021","ordinal":47520,"en":"And bowed a number of times."},{"id":"manas-2010:p1090:b001:l022","ordinal":47521,"en":"He put a written letter in my hand,"},{"id":"manas-2010:p1090:b001:l023","ordinal":47522,"en":"Quickly, with great haste, he gave it."},{"id":"manas-2010:p1090:b001:l024","ordinal":47523,"en":"It was a letter written in Chinese."},{"id":"manas-2010:p1090:b001:l025","ordinal":47524,"en":"When I read the letter,"},{"id":"manas-2010:p1090:b001:l026","ordinal":47525,"en":"My mother's name Altynay was there."},{"id":"manas-2010:p1090:b001:l027","ordinal":47526,"en":"My mother had written it weeping and lamenting;"},{"id":"manas-2010:p1090:b001:l028","ordinal":47527,"en":"She had written words within the letter."},{"id":"manas-2010:p1090:b001:l029","ordinal":47528,"en":"When I read her words,"},{"id":"manas-2010:p1090:b001:l030","ordinal":47529,"en":"My dear mother,"},{"id":"manas-2010:p1090:b001:l031","ordinal":47530,"en":"She had written thus:"},{"id":"manas-2010:p1090:b001:l032","ordinal":47531,"en":"“Until the Five Wild Sheep stars set,"},{"id":"manas-2010:p1090:b001:l033","ordinal":47532,"en":"I turned five times to nurse you."},{"id":"manas-2010:p1090:b001:l034","ordinal":47533,"en":"My champion Almambet, my only one,"},{"id":"manas-2010:p1090:b001:l035","ordinal":47534,"en":"Until the Six Wild Sheep stars set,"},{"id":"manas-2010:p1090:b001:l036","ordinal":47535,"en":"I turned six times to nurse you."},{"id":"manas-2010:p1090:b001:l037","ordinal":47536,"en":"You widened my narrow womb,"},{"id":"manas-2010:p1090:b001:l038","ordinal":47537,"en":"You emptied my stone-hard breasts,"},{"id":"manas-2010:p1090:b001:l039","ordinal":47538,"en":"My spring flowing in the valley,"},{"id":"manas-2010:p1090:b001:l040","ordinal":47539,"en":"My lamp granted near life's end!"},{"id":"manas-2010:p1090:b001:l041","ordinal":47540,"en":"Why remain in Beijing?"},{"id":"manas-2010:p1090:b001:l042","ordinal":47541,"en":"Before reaching your prime,"},{"id":"manas-2010:p1091:b001:l001","ordinal":47542,"en":"You will soon die."},{"id":"manas-2010:p1091:b001:l002","ordinal":47543,"en":"She who writes this weeping and wailing,"},{"id":"manas-2010:p1091:b001:l003","ordinal":47544,"en":"Your mother has died now, she says."},{"id":"manas-2010:p1091:b001:l004","ordinal":47545,"en":"Come to attend me, she says."},{"id":"manas-2010:p1091:b001:l005","ordinal":47546,"en":"A dark, unfortunate wretch like me,"},{"id":"manas-2010:p1091:b001:l006","ordinal":47547,"en":"Bury with your own hands,” she says."},{"id":"manas-2010:p1091:b001:l007","ordinal":47548,"en":"When I heard this news,"},{"id":"manas-2010:p1091:b001:l008","ordinal":47549,"en":"Clouds gathered in the sky, Manas;"},{"id":"manas-2010:p1091:b001:l009","ordinal":47550,"en":"Sixty anxieties fell on my head at once."},{"id":"manas-2010:p1091:b001:l010","ordinal":47551,"en":"When I heard this news,"},{"id":"manas-2010:p1091:b001:l011","ordinal":47552,"en":"My red blood swirled and boiled."},{"id":"manas-2010:p1091:b001:l012","ordinal":47553,"en":"As I stood under guard,"},{"id":"manas-2010:p1091:b001:l013","ordinal":47554,"en":"My poor soul could not hold together."},{"id":"manas-2010:p1091:b001:l014","ordinal":47555,"en":"If my sixty mothers died there,"},{"id":"manas-2010:p1091:b001:l015","ordinal":47556,"en":"If my own mother Altynay"},{"id":"manas-2010:p1091:b001:l016","ordinal":47557,"en":"Now died of her grief,"},{"id":"manas-2010:p1091:b001:l017","ordinal":47558,"en":"I had come and settled in Beijing;"},{"id":"manas-2010:p1091:b001:l018","ordinal":47559,"en":"Of the Chinese under their emperor,"},{"id":"manas-2010:p1091:b001:l019","ordinal":47560,"en":"However many of their fathers I slaughtered,"},{"id":"manas-2010:p1091:b001:l020","ordinal":47561,"en":"I had become like an extinguished fire."},{"id":"manas-2010:p1091:b001:l021","ordinal":47562,"en":"Hearing this news,"},{"id":"manas-2010:p1091:b001:l022","ordinal":47563,"en":"“Let me die rather than live!"},{"id":"manas-2010:p1091:b001:l023","ordinal":47564,"en":"The Chinese with rank-buttons on their caps—"},{"id":"manas-2010:p1091:b001:l024","ordinal":47565,"en":"Let me shatter them and spill their blood!"},{"id":"manas-2010:p1091:b001:l025","ordinal":47566,"en":"Before this day is out, I, unfortunate one,"},{"id":"manas-2010:p1091:b001:l026","ordinal":47567,"en":"Let me reach and see my mother!"},{"id":"manas-2010:p1091:b001:l027","ordinal":47568,"en":"The humiliation the Chinese inflict,"},{"id":"manas-2010:p1091:b001:l028","ordinal":47569,"en":"If it falls on my head, I shall face it."},{"id":"manas-2010:p1091:b001:l029","ordinal":47570,"en":"Karykan, khan of Beijing,"},{"id":"manas-2010:p1091:b001:l030","ordinal":47571,"en":"If that infidel comes into my hands,"},{"id":"manas-2010:p1091:b001:l031","ordinal":47572,"en":"I shall spill his blood like water!”"},{"id":"manas-2010:p1091:b001:l032","ordinal":47573,"en":"I turned, my poor soul troubled,"},{"id":"manas-2010:p1091:b001:l033","ordinal":47574,"en":"My waist bent like a fiber,"},{"id":"manas-2010:p1091:b001:l034","ordinal":47575,"en":"Toward Karykan's golden throne"},{"id":"manas-2010:p1091:b001:l035","ordinal":47576,"en":"I gathered myself to spring."},{"id":"manas-2010:p1091:b001:l036","ordinal":47577,"en":"Karykan's golden throne,"},{"id":"manas-2010:p1091:b001:l037","ordinal":47578,"en":"The plane trees planted all around it—"},{"id":"manas-2010:p1091:b001:l038","ordinal":47579,"en":"My friend Manas, my goshawk,"},{"id":"manas-2010:p1091:b001:l039","ordinal":47580,"en":"Unable to withstand my wrath,"},{"id":"manas-2010:p1091:b001:l040","ordinal":47581,"en":"The plane-tree grove collapsed."},{"id":"manas-2010:p1091:b001:l041","ordinal":47582,"en":"Beneath those plane trees,"},{"id":"manas-2010:p1091:b001:l042","ordinal":47583,"en":"The one who sat guarding the throne,"},{"id":"manas-2010:p1092:b001:l001","ordinal":47584,"en":"Karykan's forty guards—"},{"id":"manas-2010:p1092:b001:l002","ordinal":47585,"en":"I slaughtered those forty guards."},{"id":"manas-2010:p1092:b001:l003","ordinal":47586,"en":"Leaving not one alive,"},{"id":"manas-2010:p1092:b001:l004","ordinal":47587,"en":"I killed them all."},{"id":"manas-2010:p1092:b001:l005","ordinal":47588,"en":"Such was Almambet's wildness."},{"id":"manas-2010:p1092:b001:l006","ordinal":47589,"en":"One regret remained; what could I do?"},{"id":"manas-2010:p1092:b001:l007","ordinal":47590,"en":"Karykan was not there."},{"id":"manas-2010:p1092:b001:l008","ordinal":47591,"en":"Killing six of his khans,"},{"id":"manas-2010:p1092:b001:l009","ordinal":47592,"en":"I came out after wreaking havoc."},{"id":"manas-2010:p1092:b001:l010","ordinal":47593,"en":"Karykan's smooth musket"},{"id":"manas-2010:p1092:b001:l011","ordinal":47594,"en":"I took away as a gift."},{"id":"manas-2010:p1092:b001:l012","ordinal":47595,"en":"Karykan's weather-stone"},{"id":"manas-2010:p1092:b001:l013","ordinal":47596,"en":"I took with me then,"},{"id":"manas-2010:p1092:b001:l014","ordinal":47597,"en":"Thinking I would need it for my life."},{"id":"manas-2010:p1092:b001:l015","ordinal":47598,"en":"My knees bent toward the earth;"},{"id":"manas-2010:p1092:b001:l016","ordinal":47599,"en":"I ran out through the doorway."},{"id":"manas-2010:p1092:b001:l017","ordinal":47600,"en":"Before me, Sarala"},{"id":"manas-2010:p1092:b001:l018","ordinal":47601,"en":"Was standing saddled."},{"id":"manas-2010:p1092:b001:l019","ordinal":47602,"en":"Gathering myself, I leapt astride,"},{"id":"manas-2010:p1092:b001:l020","ordinal":47603,"en":"My armor bending upon me."},{"id":"manas-2010:p1092:b001:l021","ordinal":47604,"en":"Bringing down the gate,"},{"id":"manas-2010:p1092:b001:l022","ordinal":47605,"en":"Renouncing my idol,"},{"id":"manas-2010:p1092:b001:l023","ordinal":47606,"en":"Leaving my Chinese homeland,"},{"id":"manas-2010:p1092:b001:l024","ordinal":47607,"en":"I raced away on Sarala."},{"id":"manas-2010:p1092:b001:l025","ordinal":47608,"en":"By then noon had passed;"},{"id":"manas-2010:p1092:b001:l026","ordinal":47609,"en":"The sun leaned toward the west."},{"id":"manas-2010:p1092:b001:l027","ordinal":47610,"en":"The bright sun in the sky"},{"id":"manas-2010:p1092:b001:l028","ordinal":47611,"en":"Had begun to decline."},{"id":"manas-2010:p1092:b001:l029","ordinal":47612,"en":"Roaring saltwater lay there;"},{"id":"manas-2010:p1092:b001:l030","ordinal":47613,"en":"Between Tash-Köpürö and Beijing"},{"id":"manas-2010:p1092:b001:l031","ordinal":47614,"en":"Was a journey of forty days."},{"id":"manas-2010:p1092:b001:l032","ordinal":47615,"en":"Having shattered Beijing,"},{"id":"manas-2010:p1092:b001:l033","ordinal":47616,"en":"I left after noon."}]
