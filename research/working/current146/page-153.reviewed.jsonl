{"id": "sayakbay-ms-current146:pdf153:l032", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 153, "folio": 536, "line_in_page": 32, "raw": "Сунулган бут тартылбай,", "text": "Сунулган бут тартылбай,", "en": "The outstretched legs did not draw back,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf153:l033", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 153, "folio": 536, "line_in_page": 33, "raw": "Чының жан чыгып көздөн,", "text": "Чының жан чыгып көздөн,", "en": "Your true soul left your eyes,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
