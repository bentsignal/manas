[{"id":"semetey-1-2013:p1328:b004:l034","ordinal":177665,"en":"Driving them up and down,"},{"id":"semetey-1-2013:p1328:b004:l035","ordinal":177666,"en":"And bringing turmoil upon the people—"},{"id":"semetey-1-2013:p1328:b004:l036","ordinal":177667,"en":"What desire would I attain?"},{"id":"semetey-1-2013:p1328:b004:l037","ordinal":177668,"en":"Against the seething infidels,"},{"id":"semetey-1-2013:p1328:b004:l038","ordinal":177669,"en":"Against hero Khan Kongurbai,"},{"id":"semetey-1-2013:p1328:b004:l039","ordinal":177670,"en":"I shall go alone myself!"},{"id":"semetey-1-2013:p1329:b003:l001","ordinal":177671,"en":"If my death has come, let me die;"},{"id":"semetey-1-2013:p1329:b003:l002","ordinal":177672,"en":"While I remain alive and undying,"},{"id":"semetey-1-2013:p1329:b003:l003","ordinal":177673,"en":"With the Black Kalmak and the Manchus,"},{"id":"semetey-1-2013:p1329:b003:l004","ordinal":177674,"en":"Let me grapple once and test myself!"},{"id":"semetey-1-2013:p1329:b003:l005","ordinal":177675,"en":"I shall bring them mighty alarm;"},{"id":"semetey-1-2013:p1329:b003:l006","ordinal":177676,"en":"I shall face them and fight,"},{"id":"semetey-1-2013:p1329:b003:l007","ordinal":177677,"en":"And avenge my father’s blood-price!"},{"id":"semetey-1-2013:p1329:b003:l008","ordinal":177678,"en":"I shall gird my waist firmly;"},{"id":"semetey-1-2013:p1329:b003:l009","ordinal":177679,"en":"From the Kalcha there in Beijing,"},{"id":"semetey-1-2013:p1329:b003:l010","ordinal":177680,"en":"I shall pursue my father’s blood-price!"},{"id":"semetey-1-2013:p1329:b003:l011","ordinal":177681,"en":"Against Beijing of Chinmachyn,"},{"id":"semetey-1-2013:p1329:b003:l012","ordinal":177682,"en":"I shall truly level my spear;"},{"id":"semetey-1-2013:p1329:b003:l013","ordinal":177683,"en":"For my sworn father Almambet,"},{"id":"semetey-1-2013:p1329:b003:l014","ordinal":177684,"en":"I shall truly pursue his blood-price!"},{"id":"semetey-1-2013:p1329:b003:l015","ordinal":177685,"en":"In the original city of Kakan-Beijing,"},{"id":"semetey-1-2013:p1329:b003:l016","ordinal":177686,"en":"I shall dig out its very stump;"},{"id":"semetey-1-2013:p1329:b003:l017","ordinal":177687,"en":"Charging straight in and spearing,"},{"id":"semetey-1-2013:p1329:b003:l018","ordinal":177688,"en":"Fighting them to exhaustion,"},{"id":"semetey-1-2013:p1329:b003:l019","ordinal":177689,"en":"I shall satisfy your longing!"},{"id":"semetey-1-2013:p1329:b003:l020","ordinal":177690,"en":"Kongurbai, son of Alööke—"},{"id":"semetey-1-2013:p1329:b003:l021","ordinal":177691,"en":"I shall fight him and spill his blood."},{"id":"semetey-1-2013:p1329:b003:l022","ordinal":177692,"en":"If my destined end arrives, sprawled out,"},{"id":"semetey-1-2013:p1329:b003:l023","ordinal":177693,"en":"I shall die in Beijing itself!"},{"id":"semetey-1-2013:p1329:b003:l024","ordinal":177694,"en":"Against Beijing, beyond my strength,"},{"id":"semetey-1-2013:p1329:b003:l025","ordinal":177695,"en":"I shall lean back and level my spear;"},{"id":"semetey-1-2013:p1329:b003:l026","ordinal":177696,"en":"Clashing with the Black Kalmak,"},{"id":"semetey-1-2013:p1329:b003:l027","ordinal":177697,"en":"If my strength suffices, this poor soul"},{"id":"semetey-1-2013:p1329:b003:l028","ordinal":177698,"en":"Will slaughter every one of them."},{"id":"semetey-1-2013:p1329:b003:l029","ordinal":177699,"en":"Toward the tent with golden guy ropes,"},{"id":"semetey-1-2013:p1329:b003:l030","ordinal":177700,"en":"I shall go on holy campaign,"},{"id":"semetey-1-2013:p1329:b003:l031","ordinal":177701,"en":"Against hero Kongurbai;"},{"id":"semetey-1-2013:p1329:b003:l032","ordinal":177702,"en":"If my power suffices, the Kalcha"},{"id":"semetey-1-2013:p1329:b003:l033","ordinal":177703,"en":"I shall slaughter as a sacrifice."},{"id":"semetey-1-2013:p1329:b003:l034","ordinal":177704,"en":"If God grants it, to Beijing"},{"id":"semetey-1-2013:p1329:b003:l035","ordinal":177705,"en":"I shall go alone myself!"},{"id":"semetey-1-2013:p1329:b003:l036","ordinal":177706,"en":"What desire would I attain"},{"id":"semetey-1-2013:p1329:b003:l037","ordinal":177707,"en":"By forcing the multitude?"},{"id":"semetey-1-2013:p1329:b003:l038","ordinal":177708,"en":"Against the seething Chinese,"},{"id":"semetey-1-2013:p1329:b003:l039","ordinal":177709,"en":"I shall go alone myself!"},{"id":"semetey-1-2013:p1329:b005:l001","ordinal":177710,"en":"Against the Chinese and Manchu people,"},{"id":"semetey-1-2013:p1329:b005:l002","ordinal":177711,"en":"If I do not shout and level my spear,"},{"id":"semetey-1-2013:p1329:b005:l003","ordinal":177712,"en":"If I do not shatter"},{"id":"semetey-1-2013:p1329:b005:l004","ordinal":177713,"en":"Forty-doored Beijing into chaff,"},{"id":"semetey-1-2013:p1329:b005:l005","ordinal":177714,"en":"Spilling blood and breaking their ranks,"},{"id":"semetey-1-2013:p1329:b005:l006","ordinal":177715,"en":"And, if God wills, fall to a bullet;"},{"id":"semetey-1-2013:p1329:b005:l007","ordinal":177716,"en":"If I do not oppose that swine,"},{"id":"semetey-1-2013:p1329:b005:l008","ordinal":177717,"en":"The khan of the Kechil, and make him suffer,"},{"id":"semetey-1-2013:p1329:b005:l009","ordinal":177718,"en":"Making the swaggering Black Kalmak say,"},{"id":"semetey-1-2013:p1329:b005:l010","ordinal":177719,"en":"“He is the son of the Bloodletter!”"},{"id":"semetey-1-2013:p1329:b005:l011","ordinal":177720,"en":"If I do not start conflict and raise dust,"},{"id":"semetey-1-2013:p1329:b005:l012","ordinal":177721,"en":"Enter battle and take blood,"},{"id":"semetey-1-2013:p1329:b005:l013","ordinal":177722,"en":"And heap tumult upon tumult;"},{"id":"semetey-1-2013:p1329:b005:l014","ordinal":177723,"en":"If I do not go alone to face"},{"id":"semetey-1-2013:p1329:b005:l015","ordinal":177724,"en":"Kongurbai there in Beijing,"},{"id":"semetey-1-2013:p1329:b005:l016","ordinal":177725,"en":"If I do not avenge my valiant father"},{"id":"semetey-1-2013:p1329:b005:l017","ordinal":177726,"en":"Upon the Kalcha there in Beijing!"},{"id":"semetey-1-2013:p1329:b005:l018","ordinal":177727,"en":"Against the Chinese, countless as cow hairs,"},{"id":"semetey-1-2013:p1329:b005:l019","ordinal":177728,"en":"I shall wage relentless war;"},{"id":"semetey-1-2013:p1329:b005:l020","ordinal":177729,"en":"To famed Beijing"},{"id":"semetey-1-2013:p1329:b005:l021","ordinal":177730,"en":"I myself shall reach!"},{"id":"semetey-1-2013:p1329:b005:l022","ordinal":177731,"en":"How could I shamelessly gather"},{"id":"semetey-1-2013:p1329:b005:l023","ordinal":177732,"en":"The many great men among the Muslims?"},{"id":"semetey-1-2013:p1329:b005:l024","ordinal":177733,"en":"Let them say, “He is a great man’s son,”"},{"id":"semetey-1-2013:p1329:b005:l025","ordinal":177734,"en":"While I alone pursue the blood-price."},{"id":"semetey-1-2013:p1329:b005:l026","ordinal":177735,"en":"Against the infidels, swarming like black worms,"},{"id":"semetey-1-2013:p1329:b005:l027","ordinal":177736,"en":"Against hero Khan Kongurbai,"},{"id":"semetey-1-2013:p1329:b005:l028","ordinal":177737,"en":"Into their original city, Great Beijing,"},{"id":"semetey-1-2013:p1329:b005:l029","ordinal":177738,"en":"I shall enter straight and level my spear;"},{"id":"semetey-1-2013:p1329:b005:l030","ordinal":177739,"en":"Those deep-rooted infidels,"},{"id":"semetey-1-2013:p1329:b005:l031","ordinal":177740,"en":"Hero Kongurbai himself—"},{"id":"semetey-1-2013:p1329:b005:l032","ordinal":177741,"en":"I shall slaughter them all, leaving none."},{"id":"semetey-1-2013:p1329:b005:l033","ordinal":177742,"en":"Spearing and breaking their ranks,"},{"id":"semetey-1-2013:p1329:b005:l034","ordinal":177743,"en":"And, if fate arrives, falling to a bullet."},{"id":"semetey-1-2013:p1329:b005:l035","ordinal":177744,"en":"The writing of the Creator—"},{"id":"semetey-1-2013:p1329:b005:l036","ordinal":177745,"en":"If it is written upon my brow, I shall meet it;"},{"id":"semetey-1-2013:p1329:b005:l037","ordinal":177746,"en":"Making them say, “He is the Boundless One’s son,”"},{"id":"semetey-1-2013:p1329:b005:l038","ordinal":177747,"en":"Among the boundless Black Kalmak,"},{"id":"semetey-1-2013:p1330:b003:l001","ordinal":177748,"en":"Let me test myself against them!"},{"id":"semetey-1-2013:p1330:b003:l002","ordinal":177749,"en":"One who finds words in sudden danger,"},{"id":"semetey-1-2013:p1330:b003:l003","ordinal":177750,"en":"Who finds sight in darkness;"},{"id":"semetey-1-2013:p1330:b003:l004","ordinal":177751,"en":"Auspicious when placed before me,"},{"id":"semetey-1-2013:p1330:b003:l005","ordinal":177752,"en":"Like a countless host when behind me;"},{"id":"semetey-1-2013:p1330:b003:l006","ordinal":177753,"en":"My companion gathered in life,"},{"id":"semetey-1-2013:p1330:b003:l007","ordinal":177754,"en":"My fellow believer if death comes—"},{"id":"semetey-1-2013:p1330:b003:l008","ordinal":177755,"en":"My uncle Bakai, my inheritance,"},{"id":"semetey-1-2013:p1330:b003:l009","ordinal":177756,"en":"I shall take as companion to Beijing."},{"id":"semetey-1-2013:p1330:b003:l010","ordinal":177757,"en":"Do not grieve, mother;"},{"id":"semetey-1-2013:p1330:b003:l011","ordinal":177758,"en":"Thus shall I go to Beijing!"},{"id":"semetey-1-2013:p1330:b003:l012","ordinal":177759,"en":"My support when I climb,"},{"id":"semetey-1-2013:p1330:b003:l013","ordinal":177760,"en":"My prop when I descend,"},{"id":"semetey-1-2013:p1330:b003:l014","ordinal":177761,"en":"Külchoro and Kanchoro—"},{"id":"semetey-1-2013:p1330:b004:l001","ordinal":177762,"en":"My wings for circling flight,"},{"id":"semetey-1-2013:p1330:b004:l002","ordinal":177763,"en":"My tail for coming to land;"},{"id":"semetey-1-2013:p1330:b004:l003","ordinal":177764,"en":"Külchoro and Kanchoro,"},{"id":"semetey-1-2013:p1330:b004:l004","ordinal":177765,"en":"The two are my younger brothers."},{"id":"semetey-1-2013:p1330:b004:l005","ordinal":177766,"en":"I shall take both nest-mates,"},{"id":"semetey-1-2013:p1330:b004:l006","ordinal":177767,"en":"And against Chinese as numerous as cow hairs"},{"id":"semetey-1-2013:p1330:b004:l007","ordinal":177768,"en":"Unleash such conflict!”"},{"id":"semetey-1-2013:p1330:b004:l008","ordinal":177769,"en":"The fine hero, son of Manas,"},{"id":"semetey-1-2013:p1330:b004:l009","ordinal":177770,"en":"The lion supported by the spirits,"},{"id":"semetey-1-2013:p1330:b004:l010","ordinal":177771,"en":"Had scarcely closed his mouth"},{"id":"semetey-1-2013:p1330:b004:l011","ordinal":177772,"en":"When his uncle, elder Bakai,"},{"id":"semetey-1-2013:p1330:b004:l012","ordinal":177773,"en":"A saint who had seen much,"},{"id":"semetey-1-2013:p1330:b004:l013","ordinal":177774,"en":"To the young son of Manas"},{"id":"semetey-1-2013:p1330:b004:l014","ordinal":177775,"en":"Began to speak in a ringing voice."},{"id":"semetey-1-2013:p1330:b006:l001","ordinal":177776,"en":"These were Bakai's words:"},{"id":"semetey-1-2013:p1330:b006:l002","ordinal":177777,"en":"“My foal, my son Semetey!"},{"id":"semetey-1-2013:p1330:b006:l003","ordinal":177778,"en":"God granted my wish;"},{"id":"semetey-1-2013:p1330:b006:l004","ordinal":177779,"en":"This very year your age"},{"id":"semetey-1-2013:p1330:b006:l005","ordinal":177780,"en":"Has reached twenty-five."},{"id":"semetey-1-2013:p1330:b006:l006","ordinal":177781,"en":"Yesterday, while my companion Manas lived,"},{"id":"semetey-1-2013:p1330:b006:l007","ordinal":177782,"en":"While his fortune remained whole,"},{"id":"semetey-1-2013:p1330:b006:l008","ordinal":177783,"en":"He used to heed my counsel,"},{"id":"semetey-1-2013:p1330:b006:l009","ordinal":177784,"en":"And listen to my admonition;"},{"id":"semetey-1-2013:p1330:b006:l010","ordinal":177785,"en":"He knew what I told him."},{"id":"semetey-1-2013:p1330:b006:l011","ordinal":177786,"en":"I have spoken precious words—understand;"},{"id":"semetey-1-2013:p1330:b006:l012","ordinal":177787,"en":"My blessed son, heed me!"},{"id":"semetey-1-2013:p1330:b006:l013","ordinal":177788,"en":"This year you went to Khan Akun,"},{"id":"semetey-1-2013:p1330:b006:l014","ordinal":177789,"en":"And newly took Aychürök;"},{"id":"semetey-1-2013:p1330:b006:l015","ordinal":177790,"en":"If you wish, my son, heed me—"},{"id":"semetey-1-2013:p1330:b006:l016","ordinal":177791,"en":"You have become a bloodied foot."},{"id":"semetey-1-2013:p1330:b006:l017","ordinal":177792,"en":"Remain here this year;"},{"id":"semetey-1-2013:p1330:b006:l018","ordinal":177793,"en":"Let us grow fat and refreshed,"},{"id":"semetey-1-2013:p1330:b006:l019","ordinal":177794,"en":"Hunt game and make sport,"},{"id":"semetey-1-2013:p1330:b006:l020","ordinal":177795,"en":"Tell tales and raise a clamor,"},{"id":"semetey-1-2013:p1330:b006:l021","ordinal":177796,"en":"And chase and shoot wild asses!"},{"id":"semetey-1-2013:p1330:b007:l001","ordinal":177797,"en":"Let this year pass,"},{"id":"semetey-1-2013:p1330:b007:l002","ordinal":177798,"en":"And go in the following year!"},{"id":"semetey-1-2013:p1330:b007:l003","ordinal":177799,"en":"By the road I myself have seen,"},{"id":"semetey-1-2013:p1330:b007:l004","ordinal":177800,"en":"Along valleys, springs, and streams,"},{"id":"semetey-1-2013:p1330:b007:l005","ordinal":177801,"en":"Let me lead the way myself,"},{"id":"semetey-1-2013:p1330:b007:l006","ordinal":177802,"en":"And against the Manchu khan of the Kechil"},{"id":"semetey-1-2013:p1330:b007:l007","ordinal":177803,"en":"Let us wage war at full breadth!"},{"id":"semetey-1-2013:p1330:b007:l008","ordinal":177804,"en":"My son, your strength is tired; gird your waist;"},{"id":"semetey-1-2013:p1330:b007:l009","ordinal":177805,"en":"This year let us grow fat and refreshed!"},{"id":"semetey-1-2013:p1330:b007:l010","ordinal":177806,"en":"If you heed me, my only one,"},{"id":"semetey-1-2013:p1330:b007:l011","ordinal":177807,"en":"Let us go to Beijing next year!"},{"id":"semetey-1-2013:p1330:b007:l012","ordinal":177808,"en":"My young prince's son,"},{"id":"semetey-1-2013:p1330:b007:l013","ordinal":177809,"en":"Let us wage war next year!"},{"id":"semetey-1-2013:p1330:b007:l014","ordinal":177810,"en":"Upon the soil of the earth"},{"id":"semetey-1-2013:p1330:b007:l015","ordinal":177811,"en":"There are Muslim giants;"},{"id":"semetey-1-2013:p1330:b007:l016","ordinal":177812,"en":"If you summon them, will your strength not suffice?"},{"id":"semetey-1-2013:p1330:b007:l017","ordinal":177813,"en":"Gather a select army completely!"},{"id":"semetey-1-2013:p1330:b007:l018","ordinal":177814,"en":"Gather a great army!"},{"id":"semetey-1-2013:p1330:b007:l019","ordinal":177815,"en":"The twelve Muslim tribes—"},{"id":"semetey-1-2013:p1330:b007:l020","ordinal":177816,"en":"Let us assemble them together,"},{"id":"semetey-1-2013:p1330:b007:l021","ordinal":177817,"en":"Their proud warriors,"},{"id":"semetey-1-2013:p1331:b003:l001","ordinal":177818,"en":"The heroes who enter battle,"},{"id":"semetey-1-2013:p1331:b003:l002","ordinal":177819,"en":"The most skillful spearmen,"},{"id":"semetey-1-2013:p1331:b003:l003","ordinal":177820,"en":"The finest, complete in stratagems—"},{"id":"semetey-1-2013:p1331:b003:l004","ordinal":177821,"en":"Let us summon and gather them,"},{"id":"semetey-1-2013:p1331:b003:l005","ordinal":177822,"en":"And against infidels like black worms,"},{"id":"semetey-1-2013:p1331:b003:l006","ordinal":177823,"en":"Against hero Khan Kongurbai,"},{"id":"semetey-1-2013:p1331:b003:l007","ordinal":177824,"en":"Let us wage war without fleeing!"},{"id":"semetey-1-2013:p1331:b003:l008","ordinal":177825,"en":"Understand what I have said;"},{"id":"semetey-1-2013:p1331:b003:l009","ordinal":177826,"en":"My auspicious son, heed me."},{"id":"semetey-1-2013:p1331:b003:l010","ordinal":177827,"en":"While gray wolf Manas lived,"},{"id":"semetey-1-2013:p1331:b003:l011","ordinal":177828,"en":"The whole world stirred;"},{"id":"semetey-1-2013:p1331:b003:l012","ordinal":177829,"en":"Kakan-Chyn is no easy place."},{"id":"semetey-1-2013:p1331:b003:l013","ordinal":177830,"en":"When he campaigned against Beijing,"},{"id":"semetey-1-2013:p1331:b003:l014","ordinal":177831,"en":"There were four hundred twenty thousand troops;"},{"id":"semetey-1-2013:p1331:b003:l015","ordinal":177832,"en":"Heroes went and khans went,"},{"id":"semetey-1-2013:p1331:b003:l016","ordinal":177833,"en":"And to costly Beijing"},{"id":"semetey-1-2013:p1331:b003:l017","ordinal":177834,"en":"Men came even from India."},{"id":"semetey-1-2013:p1331:b003:l018","ordinal":177835,"en":"Many a lone hero went;"},{"id":"semetey-1-2013:p1331:b003:l019","ordinal":177836,"en":"Those who went to Beijing"},{"id":"semetey-1-2013:p1331:b003:l020","ordinal":177837,"en":"Went prepared for death,"},{"id":"semetey-1-2013:p1331:b003:l021","ordinal":177838,"en":"Saying, ‘From Kakan-Chyn's Beijing"},{"id":"semetey-1-2013:p1331:b003:l022","ordinal":177839,"en":"I shall not turn back.’"},{"id":"semetey-1-2013:p1331:b003:l023","ordinal":177840,"en":"Talas filled and the land glittered;"},{"id":"semetey-1-2013:p1331:b003:l024","ordinal":177841,"en":"Your formidable lion elder"},{"id":"semetey-1-2013:p1331:b003:l025","ordinal":177842,"en":"Drove all those people onward"},{"id":"semetey-1-2013:p1331:b003:l026","ordinal":177843,"en":"In a packed multitude."},{"id":"semetey-1-2013:p1331:b003:l027","ordinal":177844,"en":"His stride reached Beijing,"},{"id":"semetey-1-2013:p1331:b003:l028","ordinal":177845,"en":"And he humbled it without regret,"},{"id":"semetey-1-2013:p1331:b003:l029","ordinal":177846,"en":"Though the Muslims seemed palm-sized."},{"id":"semetey-1-2013:p1331:b003:l030","ordinal":177847,"en":"Whoever said, ‘My horse is unmatched,’"},{"id":"semetey-1-2013:p1331:b003:l031","ordinal":177848,"en":"He said, ‘I shall slaughter and eat his horse’;"},{"id":"semetey-1-2013:p1331:b003:l032","ordinal":177849,"en":"Your father, the gray wolf lion,"},{"id":"semetey-1-2013:p1331:b003:l033","ordinal":177850,"en":"Drove them by force."},{"id":"semetey-1-2013:p1331:b003:l034","ordinal":177851,"en":"Beijing is no cheap place;"},{"id":"semetey-1-2013:p1331:b003:l035","ordinal":177852,"en":"To a man who goes alone,"},{"id":"semetey-1-2013:p1331:b003:l036","ordinal":177853,"en":"That Beijing is no people"},{"id":"semetey-1-2013:p1331:b003:l037","ordinal":177854,"en":"Who would give even a saddlebag as blood-price."},{"id":"semetey-1-2013:p1331:b003:l038","ordinal":177855,"en":"They are no people against whom one goes alone for vengeance;"},{"id":"semetey-1-2013:p1331:b003:l039","ordinal":177856,"en":"They are no bare-chested,"},{"id":"semetey-1-2013:p1331:b005:l001","ordinal":177857,"en":"Open-shirted Bukharan folk."},{"id":"semetey-1-2013:p1331:b005:l002","ordinal":177858,"en":"They are no people of Kokon Khan,"},{"id":"semetey-1-2013:p1331:b005:l003","ordinal":177859,"en":"Whom one humiliates and reduces to misery,"},{"id":"semetey-1-2013:p1331:b005:l004","ordinal":177860,"en":"Yet survives among them for a month."},{"id":"semetey-1-2013:p1331:b005:l005","ordinal":177861,"en":"In Chinmachin's Beijing,"},{"id":"semetey-1-2013:p1331:b005:l006","ordinal":177862,"en":"That people has a true army;"},{"id":"semetey-1-2013:p1331:b005:l007","ordinal":177863,"en":"They are no people who avoid contest,"},{"id":"semetey-1-2013:p1331:b005:l008","ordinal":177864,"en":"Nor a place that leaves conflict unanswered."},{"id":"semetey-1-2013:p1331:b005:l009","ordinal":177865,"en":"Your talk of shamelessly going alone"},{"id":"semetey-1-2013:p1331:b005:l010","ordinal":177866,"en":"Is no proper word."},{"id":"semetey-1-2013:p1331:b005:l011","ordinal":177867,"en":"Here are the eyes that went and saw;"},{"id":"semetey-1-2013:p1331:b005:l012","ordinal":177868,"en":"Here are the words long spoken."},{"id":"semetey-1-2013:p1331:b005:l013","ordinal":177869,"en":"This is the hand that crushed them;"},{"id":"semetey-1-2013:p1331:b005:l014","ordinal":177870,"en":"I am the one who fought them."},{"id":"semetey-1-2013:p1331:b005:l015","ordinal":177871,"en":"Wading through black blood,"},{"id":"semetey-1-2013:p1331:b005:l016","ordinal":177872,"en":"Your dear uncle, Khan Bakai,"},{"id":"semetey-1-2013:p1331:b005:l017","ordinal":177873,"en":"While his bloodthirsty lord lived,"},{"id":"semetey-1-2013:p1331:b005:l018","ordinal":177874,"en":"Fought six months without fleeing."},{"id":"semetey-1-2013:p1331:b005:l019","ordinal":177875,"en":"Yielding nothing to the lion hero,"},{"id":"semetey-1-2013:p1331:b005:l020","ordinal":177876,"en":"Neither advancing nor retreating,"},{"id":"semetey-1-2013:p1331:b005:l021","ordinal":177877,"en":"They stood midway."},{"id":"semetey-1-2013:p1331:b005:l022","ordinal":177878,"en":"Lion Syrgak and Almambet,"},{"id":"semetey-1-2013:p1331:b005:l023","ordinal":177879,"en":"Until the soft reeds ripened,"},{"id":"semetey-1-2013:p1331:b005:l024","ordinal":177880,"en":"Until the flower of the myyzam season flew,"},{"id":"semetey-1-2013:p1331:b005:l025","ordinal":177881,"en":"Fought fiercely for six months."},{"id":"semetey-1-2013:p1331:b005:l026","ordinal":177882,"en":"Spears broke with a crash,"},{"id":"semetey-1-2013:p1331:b005:l027","ordinal":177883,"en":"And slaughtered peoples cried out."},{"id":"semetey-1-2013:p1331:b005:l028","ordinal":177884,"en":"Heroes died and lions died;"},{"id":"semetey-1-2013:p1331:b005:l029","ordinal":177885,"en":"In that holy war,"},{"id":"semetey-1-2013:p1331:b005:l030","ordinal":177886,"en":"Chinese and Kyrgyz died alike."},{"id":"semetey-1-2013:p1331:b005:l031","ordinal":177887,"en":"If you face Beijing, there are wonders;"},{"id":"semetey-1-2013:p1331:b005:l032","ordinal":177888,"en":"It is a great fortified city,"},{"id":"semetey-1-2013:p1331:b005:l033","ordinal":177889,"en":"With ramparts that have endured much."},{"id":"semetey-1-2013:p1331:b005:l034","ordinal":177890,"en":"Your blessed uncle Bakai"},{"id":"semetey-1-2013:p1331:b005:l035","ordinal":177891,"en":"Has many epic tales of it."},{"id":"semetey-1-2013:p1331:b005:l036","ordinal":177892,"en":"The road to Beijing divides five ways;"},{"id":"semetey-1-2013:p1331:b005:l037","ordinal":177893,"en":"Do not say, ‘I shall send my army to Beijing,’"},{"id":"semetey-1-2013:p1331:b005:l038","ordinal":177894,"en":"And bring peril upon your own head."},{"id":"semetey-1-2013:p1331:b005:l039","ordinal":177895,"en":"The road to Beijing has five branches;"},{"id":"semetey-1-2013:p1332:b003:l001","ordinal":177896,"en":"If you do not watch carefully, my son, the affair is dire."},{"id":"semetey-1-2013:p1332:b003:l002","ordinal":177897,"en":"One road to Beijing"},{"id":"semetey-1-2013:p1332:b003:l003","ordinal":177898,"en":"Has a pit dug across it;"},{"id":"semetey-1-2013:p1332:b003:l004","ordinal":177899,"en":"Another road to Beijing"},{"id":"semetey-1-2013:p1332:b003:l005","ordinal":177900,"en":"Has brine in which one sinks."},{"id":"semetey-1-2013:p1332:b003:l006","ordinal":177901,"en":"It has a Kaldai and a khan;"},{"id":"semetey-1-2013:p1332:b003:l007","ordinal":177902,"en":"That swine doomed to burn"},{"id":"semetey-1-2013:p1332:b003:l008","ordinal":177903,"en":"Has even beasts standing guard."},{"id":"semetey-1-2013:p1332:b003:l009","ordinal":177904,"en":"It has a firmly fortified pass;"},{"id":"semetey-1-2013:p1332:b003:l010","ordinal":177905,"en":"The Chinese are no idle people,"},{"id":"semetey-1-2013:p1332:b003:l011","ordinal":177906,"en":"And have places that bring disaster."},{"id":"semetey-1-2013:p1332:b003:l012","ordinal":177907,"en":"A khan stands among its guards;"},{"id":"semetey-1-2013:p1332:b003:l013","ordinal":177908,"en":"That swine doomed to burn"},{"id":"semetey-1-2013:p1332:b003:l014","ordinal":177909,"en":"Has stationed sorcerers,"},{"id":"semetey-1-2013:p1332:b003:l015","ordinal":177910,"en":"And every kind of watchman."},{"id":"semetey-1-2013:p1332:b003:l016","ordinal":177911,"en":"Beyond the sentry post"},{"id":"semetey-1-2013:p1332:b003:l017","ordinal":177912,"en":"Is a giant who guards the road;"},{"id":"semetey-1-2013:p1332:b003:l018","ordinal":177913,"en":"It is that infidel's custom"},{"id":"semetey-1-2013:p1332:b003:l019","ordinal":177914,"en":"To cut down whoever approaches."},{"id":"semetey-1-2013:p1332:b003:l020","ordinal":177915,"en":"At the infidel's crossing"},{"id":"semetey-1-2013:p1332:b003:l021","ordinal":177916,"en":"Are Kerik and Bil;"},{"id":"semetey-1-2013:p1332:b003:l022","ordinal":177917,"en":"My contrary one, let me appeal to you—"},{"id":"semetey-1-2013:p1332:b003:l023","ordinal":177918,"en":"Listen, my only one, and heed me!"},{"id":"semetey-1-2013:p1332:b003:l024","ordinal":177919,"en":"Such is the nature of conflict;"},{"id":"semetey-1-2013:p1332:b003:l025","ordinal":177920,"en":"I tell it, my son—understand!"}]
