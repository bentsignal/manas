[{"id":"manas-2010:p1476:b001:l037","ordinal":63745,"en":"“The Burut’s khan Manas,"},{"id":"manas-2010:p1476:b001:l038","ordinal":63746,"en":"Kongurbay, lying hidden,"},{"id":"manas-2010:p1476:b001:l039","ordinal":63747,"en":"Struck with a battle-axe, they say."},{"id":"manas-2010:p1476:b001:l040","ordinal":63748,"en":"When he was about to die,"},{"id":"manas-2010:p1476:b001:l041","ordinal":63749,"en":"Manas fled to Talas, they say."},{"id":"manas-2010:p1476:b001:l042","ordinal":63750,"en":"The Chinese army is gathering, they say;"},{"id":"manas-2010:p1477:b001:l001","ordinal":63751,"en":"Today or tomorrow, elder sister,"},{"id":"manas-2010:p1477:b001:l002","ordinal":63752,"en":"Facing the Burut,"},{"id":"manas-2010:p1477:b001:l003","ordinal":63753,"en":"There will be a slaughtering battle, she says."},{"id":"manas-2010:p1477:b001:l004","ordinal":63754,"en":"Why should we stay here?"},{"id":"manas-2010:p1477:b001:l005","ordinal":63755,"en":"Let us get home early!”"},{"id":"manas-2010:p1477:b001:l006","ordinal":63756,"en":"Hearing this, Almambet"},{"id":"manas-2010:p1477:b001:l007","ordinal":63757,"en":"Was astonished at what she said;"},{"id":"manas-2010:p1477:b001:l008","ordinal":63758,"en":"He prepared to face the enemy,"},{"id":"manas-2010:p1477:b001:l009","ordinal":63759,"en":"Sending word to his people,"},{"id":"manas-2010:p1477:b001:l010","ordinal":63760,"en":"To all the Muslims."},{"id":"manas-2010:p1477:b001:l011","ordinal":63761,"en":"When they heard these words,"},{"id":"manas-2010:p1477:b001:l012","ordinal":63762,"en":"The forty companions, wolves of war,"},{"id":"manas-2010:p1477:b001:l013","ordinal":63763,"en":"To Almambet’s side"},{"id":"manas-2010:p1477:b001:l014","ordinal":63764,"en":"All came gathering:"},{"id":"manas-2010:p1477:b001:l015","ordinal":63765,"en":"“Valiant Almam, my sultan,"},{"id":"manas-2010:p1477:b001:l016","ordinal":63766,"en":"You have grown wrathful."},{"id":"manas-2010:p1477:b001:l017","ordinal":63767,"en":"Is there a mountain you cannot cross?"},{"id":"manas-2010:p1477:b001:l018","ordinal":63768,"en":"Is there an enemy lying in wait?"},{"id":"manas-2010:p1477:b001:l019","ordinal":63769,"en":"Is there misfortune boiling up?"},{"id":"manas-2010:p1477:b001:l020","ordinal":63770,"en":"Bellowing their battle cry,"},{"id":"manas-2010:p1477:b001:l021","ordinal":63771,"en":"Is a Chinese army sweeping upon us?”"},{"id":"manas-2010:p1477:b001:l022","ordinal":63772,"en":"When the companions said this,"},{"id":"manas-2010:p1477:b001:l023","ordinal":63773,"en":"Azizkan's Almambet"},{"id":"manas-2010:p1477:b001:l024","ordinal":63774,"en":"Spoke these words:"},{"id":"manas-2010:p1477:b001:l025","ordinal":63775,"en":"“My lions, forty fierce companions,"},{"id":"manas-2010:p1477:b001:l026","ordinal":63776,"en":"Untouched even by the venerable Ali,"},{"id":"manas-2010:p1477:b001:l027","ordinal":63777,"en":"This is the tormenting land of Beijing;"},{"id":"manas-2010:p1477:b001:l028","ordinal":63778,"en":"Letting no living soul escape,"},{"id":"manas-2010:p1477:b001:l029","ordinal":63779,"en":"These are the fierce Chinese people!"},{"id":"manas-2010:p1477:b001:l030","ordinal":63780,"en":"Knowing their nature from the beginning,"},{"id":"manas-2010:p1477:b001:l031","ordinal":63781,"en":"I am the one who kept silent!"},{"id":"manas-2010:p1477:b001:l032","ordinal":63782,"en":"Against the countless Chinese and Manchus,"},{"id":"manas-2010:p1477:b001:l033","ordinal":63783,"en":"God knows whether we shall die"},{"id":"manas-2010:p1477:b001:l034","ordinal":63784,"en":"Or survive without dying."},{"id":"manas-2010:p1477:b001:l035","ordinal":63785,"en":"Will not one whose time has come die?"},{"id":"manas-2010:p1477:b001:l036","ordinal":63786,"en":"Will not one suffer if suffering is his lot?"},{"id":"manas-2010:p1477:b001:l037","ordinal":63787,"en":"The decree the Lord has sent—"},{"id":"manas-2010:p1477:b001:l038","ordinal":63788,"en":"If it is thus, let us face it;"},{"id":"manas-2010:p1477:b001:l039","ordinal":63789,"en":"In Kakan-Chin's Beijing,"},{"id":"manas-2010:p1477:b001:l040","ordinal":63790,"en":"If death is due, let us die!"},{"id":"manas-2010:p1477:b001:l041","ordinal":63791,"en":"While we remain alive, undying,"},{"id":"manas-2010:p1477:b001:l042","ordinal":63792,"en":"The Muslims who followed us—"},{"id":"manas-2010:p1478:b001:l001","ordinal":63793,"en":"To the Chinese and Manchus,"},{"id":"manas-2010:p1478:b001:l002","ordinal":63794,"en":"How can we give them up as spoils!"},{"id":"manas-2010:p1478:b001:l003","ordinal":63795,"en":"If we abandon the vast army and flee,"},{"id":"manas-2010:p1478:b001:l004","ordinal":63796,"en":"Will they not lay the guilt upon us?"},{"id":"manas-2010:p1478:b001:l005","ordinal":63797,"en":"Will they not suffer terrible misery?"},{"id":"manas-2010:p1478:b001:l006","ordinal":63798,"en":"Will they not all be thrown into turmoil?"},{"id":"manas-2010:p1478:b001:l007","ordinal":63799,"en":"Will they not be pursued as far as Mecca?"},{"id":"manas-2010:p1478:b001:l008","ordinal":63800,"en":"Will the Muslims not be slaughtered?"},{"id":"manas-2010:p1478:b001:l009","ordinal":63801,"en":"Will the plunder not be seized?"},{"id":"manas-2010:p1478:b001:l010","ordinal":63802,"en":"Will the Chinese not wreak havoc!"},{"id":"manas-2010:p1478:b001:l011","ordinal":63803,"en":"‘They let the Muslims be slaughtered,"},{"id":"manas-2010:p1478:b001:l012","ordinal":63804,"en":"And the forty companions fled,’ they will say:"},{"id":"manas-2010:p1478:b001:l013","ordinal":63805,"en":"An evil name in this world!"},{"id":"manas-2010:p1478:b001:l014","ordinal":63806,"en":"When we reach the hereafter,"},{"id":"manas-2010:p1478:b001:l015","ordinal":63807,"en":"The countless slaughtered Muslims—"},{"id":"manas-2010:p1478:b001:l016","ordinal":63808,"en":"Will they not seize us by the collar?"},{"id":"manas-2010:p1478:b001:l017","ordinal":63809,"en":"For the descendants left behind,"},{"id":"manas-2010:p1478:b001:l018","ordinal":63810,"en":"Will not that evil name remain!"},{"id":"manas-2010:p1478:b001:l019","ordinal":63811,"en":"Alas, forty companions,"},{"id":"manas-2010:p1478:b001:l020","ordinal":63812,"en":"You forty were lions from forty places;"},{"id":"manas-2010:p1478:b001:l021","ordinal":63813,"en":"To fierce, blue-maned Manas,"},{"id":"manas-2010:p1478:b001:l022","ordinal":63814,"en":"Which of you was inferior?"},{"id":"manas-2010:p1478:b001:l023","ordinal":63815,"en":"‘While the forty companions live,"},{"id":"manas-2010:p1478:b001:l024","ordinal":63816,"en":"I shall not suffer at the enemy's hands’—"},{"id":"manas-2010:p1478:b001:l025","ordinal":63817,"en":"That was the hope I cherished."},{"id":"manas-2010:p1478:b001:l026","ordinal":63818,"en":"Upon the Chinese and Manchus"},{"id":"manas-2010:p1478:b001:l027","ordinal":63819,"en":"Let us bring a terrible slaughter;"},{"id":"manas-2010:p1478:b001:l028","ordinal":63820,"en":"Fierce, blue-maned Manas—"},{"id":"manas-2010:p1478:b001:l029","ordinal":63821,"en":"Let us rescue him."},{"id":"manas-2010:p1478:b001:l030","ordinal":63822,"en":"Truly making our word firm,"},{"id":"manas-2010:p1478:b001:l031","ordinal":63823,"en":"Lion-born Chubak,"},{"id":"manas-2010:p1478:b001:l032","ordinal":63824,"en":"In Khan Manas's place,"},{"id":"manas-2010:p1478:b001:l033","ordinal":63825,"en":"Let us raise as khan;"},{"id":"manas-2010:p1478:b001:l034","ordinal":63826,"en":"From the Muslims encamped here,"},{"id":"manas-2010:p1478:b001:l035","ordinal":63827,"en":"Let us choose the finest steeds to ride;"},{"id":"manas-2010:p1478:b001:l036","ordinal":63828,"en":"Upon the Manchus, Chinese and Kalmyks,"},{"id":"manas-2010:p1478:b001:l037","ordinal":63829,"en":"Let us strike like falcons!"},{"id":"manas-2010:p1478:b001:l038","ordinal":63830,"en":"Stained with red blood,"},{"id":"manas-2010:p1478:b001:l039","ordinal":63831,"en":"Slaughtering and cutting down the Chinese,"},{"id":"manas-2010:p1478:b001:l040","ordinal":63832,"en":"To the foot of Inner Beijing,"},{"id":"manas-2010:p1478:b001:l041","ordinal":63833,"en":"Let us drive and press them back."},{"id":"manas-2010:p1478:b001:l042","ordinal":63834,"en":"Kongurbay, khan of the monks—"},{"id":"manas-2010:p1479:b001:l001","ordinal":63835,"en":"If we encounter him,"},{"id":"manas-2010:p1479:b001:l002","ordinal":63836,"en":"Let us take him alive;"},{"id":"manas-2010:p1479:b001:l003","ordinal":63837,"en":"Before Khan Manas,"},{"id":"manas-2010:p1479:b001:l004","ordinal":63838,"en":"Bringing the grim-faced one,"},{"id":"manas-2010:p1479:b001:l005","ordinal":63839,"en":"Let us rip his belly open;"},{"id":"manas-2010:p1479:b001:l006","ordinal":63840,"en":"Pulling out his lungs,"},{"id":"manas-2010:p1479:b001:l007","ordinal":63841,"en":"Let us wave them as an offering!"},{"id":"manas-2010:p1479:b001:l008","ordinal":63842,"en":"My dear forty companions,"},{"id":"manas-2010:p1479:b001:l009","ordinal":63843,"en":"Whatever happens, let us die!"},{"id":"manas-2010:p1479:b001:l010","ordinal":63844,"en":"Let us not return alive from Beijing;"},{"id":"manas-2010:p1479:b001:l011","ordinal":63845,"en":"If a day of dire hardship comes,"},{"id":"manas-2010:p1479:b001:l012","ordinal":63846,"en":"Let none of us turn and flee!"},{"id":"manas-2010:p1479:b001:l013","ordinal":63847,"en":"If our champion falls to a bullet,"},{"id":"manas-2010:p1479:b001:l014","ordinal":63848,"en":"That means his resolve was weak;"},{"id":"manas-2010:p1479:b001:l015","ordinal":63849,"en":"Let us not stand looking back!”"},{"id":"manas-2010:p1479:b001:l016","ordinal":63850,"en":"Do you think it was only the companions?"},{"id":"manas-2010:p1479:b001:l017","ordinal":63851,"en":"There were Muzburchak and Khan Kökchö,"},{"id":"manas-2010:p1479:b001:l018","ordinal":63852,"en":"The Eshteks' Zhamgyrchy,"},{"id":"manas-2010:p1479:b001:l019","ordinal":63853,"en":"And Kökötöy's Bokmurun—"},{"id":"manas-2010:p1479:b001:l020","ordinal":63854,"en":"Those two champions were there as well."},{"id":"manas-2010:p1479:b001:l021","ordinal":63855,"en":"Taking Almambet's words"},{"id":"manas-2010:p1479:b001:l022","ordinal":63856,"en":"As support and encouragement,"},{"id":"manas-2010:p1479:b001:l023","ordinal":63857,"en":"Like their leopard Manas,"},{"id":"manas-2010:p1479:b001:l024","ordinal":63858,"en":"They took him as their protector and lion:"},{"id":"manas-2010:p1479:b001:l025","ordinal":63859,"en":"“That will be good!” they said,"},{"id":"manas-2010:p1479:b001:l026","ordinal":63860,"en":"Raising their hands and shouting;"},{"id":"manas-2010:p1479:b001:l027","ordinal":63861,"en":"To fight the enemy to destruction,"},{"id":"manas-2010:p1479:b001:l028","ordinal":63862,"en":"They all rose with a roar."},{"id":"manas-2010:p1479:b001:l029","ordinal":63863,"en":"“What you have said is wise,” they said;"},{"id":"manas-2010:p1479:b001:l030","ordinal":63864,"en":"“That will be good, hero,” they said;"},{"id":"manas-2010:p1479:b001:l031","ordinal":63865,"en":"“Even if he survives and lives,"},{"id":"manas-2010:p1479:b001:l032","ordinal":63866,"en":"What aim will he attain?” they said."},{"id":"manas-2010:p1479:b001:l033","ordinal":63867,"en":"“Whoever should turn and flee,"},{"id":"manas-2010:p1479:b001:l034","ordinal":63868,"en":"May he become an infidel, betray the faith,"},{"id":"manas-2010:p1479:b001:l035","ordinal":63869,"en":"And die without belief!” they said."},{"id":"manas-2010:p1479:b001:l036","ordinal":63870,"en":"Chewing white wheat flour,"},{"id":"manas-2010:p1479:b001:l037","ordinal":63871,"en":"Taking hold of the holy Quran,"},{"id":"manas-2010:p1479:b001:l038","ordinal":63872,"en":"All together they rose with a clamor"},{"id":"manas-2010:p1479:b001:l039","ordinal":63873,"en":"And now pronounced the solemn prayer."},{"id":"manas-2010:p1479:b001:l040","ordinal":63874,"en":"Hero Serek came with news,"},{"id":"manas-2010:p1479:b001:l041","ordinal":63875,"en":"Hurrying, breathless, he arrived:"},{"id":"manas-2010:p1479:b001:l042","ordinal":63876,"en":"“Are you lying idle, Muslims?"},{"id":"manas-2010:p1480:b001:l001","ordinal":63877,"en":"A broad-dug pit has come;"},{"id":"manas-2010:p1480:b001:l002","ordinal":63878,"en":"Unlike our palm-sized force,"},{"id":"manas-2010:p1480:b001:l003","ordinal":63879,"en":"From the countless Chinese and Manchus,"},{"id":"manas-2010:p1480:b001:l004","ordinal":63880,"en":"With Kongurbay at their head,"},{"id":"manas-2010:p1480:b001:l005","ordinal":63881,"en":"An army covering the world has come!"},{"id":"manas-2010:p1480:b001:l006","ordinal":63882,"en":"Valiant Almambet, my fierce champion,"},{"id":"manas-2010:p1480:b001:l007","ordinal":63883,"en":"Earth flies up, a dust cloud has come;"},{"id":"manas-2010:p1480:b001:l008","ordinal":63884,"en":"Surging, the Chinese are on the move;"},{"id":"manas-2010:p1480:b001:l009","ordinal":63885,"en":"In tumult, their army has come."},{"id":"manas-2010:p1480:b001:l010","ordinal":63886,"en":"Not merely one, but all of them—"},{"id":"manas-2010:p1480:b001:l011","ordinal":63887,"en":"An uncountable multitude has come!”"},{"id":"manas-2010:p1480:b001:l012","ordinal":63888,"en":"Bringing the news, hero Serek"},{"id":"manas-2010:p1480:b001:l013","ordinal":63889,"en":"Proclaimed it to the people."},{"id":"manas-2010:p1480:b001:l014","ordinal":63890,"en":"After hearing this,"},{"id":"manas-2010:p1480:b001:l015","ordinal":63891,"en":"Among all the Muslims,"},{"id":"manas-2010:p1480:b001:l016","ordinal":63892,"en":"Those with courage rejoiced;"},{"id":"manas-2010:p1480:b001:l017","ordinal":63893,"en":"The feeble ones without courage,"},{"id":"manas-2010:p1480:b001:l018","ordinal":63894,"en":"With pitch-dark night descending on them,"},{"id":"manas-2010:p1480:b001:l019","ordinal":63895,"en":"Grieved and burned with anguish."},{"id":"manas-2010:p1480:b001:l020","ordinal":63896,"en":"All their heroes"},{"id":"manas-2010:p1480:b001:l021","ordinal":63897,"en":"Took up their arms;"},{"id":"manas-2010:p1480:b001:l022","ordinal":63898,"en":"The fearful cowards,"},{"id":"manas-2010:p1480:b001:l023","ordinal":63899,"en":"“To swell our ranks before the enemy,” they said,"},{"id":"manas-2010:p1480:b001:l024","ordinal":63900,"en":"They placed among themselves."},{"id":"manas-2010:p1480:b001:l025","ordinal":63901,"en":"All the champions"},{"id":"manas-2010:p1480:b001:l026","ordinal":63902,"en":"Took heart and called upon God:"},{"id":"manas-2010:p1480:b001:l027","ordinal":63903,"en":"“Almambet, Chubak, hero Syrgak,"},{"id":"manas-2010:p1480:b001:l028","ordinal":63904,"en":"Ajybay and Muzburchak,"},{"id":"manas-2010:p1480:b001:l029","ordinal":63905,"en":"Zhamgyrchy and hero Kökchö—"},{"id":"manas-2010:p1480:b001:l030","ordinal":63906,"en":"May these men be safe!” they said."},{"id":"manas-2010:p1480:b001:l031","ordinal":63907,"en":"Putting their trust in the seven,"},{"id":"manas-2010:p1480:b001:l032","ordinal":63908,"en":"The hawks, the wolves of war,"},{"id":"manas-2010:p1480:b001:l033","ordinal":63909,"en":"The champions who feared no enemy,"},{"id":"manas-2010:p1480:b001:l034","ordinal":63910,"en":"Formed into ordered ranks of troops,"},{"id":"manas-2010:p1480:b001:l035","ordinal":63911,"en":"A great multitude, no small force;"},{"id":"manas-2010:p1480:b001:l036","ordinal":63912,"en":"Driving the army forward in a broad array,"},{"id":"manas-2010:p1480:b001:l037","ordinal":63913,"en":"The Muslims' red banner"},{"id":"manas-2010:p1480:b001:l038","ordinal":63914,"en":"They entrusted to Ajybay;"},{"id":"manas-2010:p1480:b001:l039","ordinal":63915,"en":"All the outstanding warriors"},{"id":"manas-2010:p1480:b001:l040","ordinal":63916,"en":"Surged toward the Chinese."},{"id":"manas-2010:p1480:b001:l041","ordinal":63917,"en":"All the fearful ones"},{"id":"manas-2010:p1480:b001:l042","ordinal":63918,"en":"Struggled along in their midst,"},{"id":"manas-2010:p1481:b001:l001","ordinal":63919,"en":"The lions Almambet and Chubak,"},{"id":"manas-2010:p1481:b001:l002","ordinal":63920,"en":"And Ulak Khan's Syrgak,"},{"id":"manas-2010:p1481:b001:l003","ordinal":63921,"en":"Prepared upon the flanks;"},{"id":"manas-2010:p1481:b001:l004","ordinal":63922,"en":"Where no running wild ass could cross,"},{"id":"manas-2010:p1481:b001:l005","ordinal":63923,"en":"At the heart of ninety mountains,"},{"id":"manas-2010:p1481:b001:l006","ordinal":63924,"en":"They gathered and came out to meet them."},{"id":"manas-2010:p1481:b001:l007","ordinal":63925,"en":"The Muslims who had come from afar"},{"id":"manas-2010:p1481:b001:l008","ordinal":63926,"en":"Prayed to their God."},{"id":"manas-2010:p1481:b001:l009","ordinal":63927,"en":"The sandy plain before them"},{"id":"manas-2010:p1481:b001:l010","ordinal":63928,"en":"Teemed like an anthill;"},{"id":"manas-2010:p1481:b001:l011","ordinal":63929,"en":"The Chinese multitude came sweeping,"},{"id":"manas-2010:p1481:b001:l012","ordinal":63930,"en":"Teeming like grains of sand."},{"id":"manas-2010:p1481:b001:l013","ordinal":63931,"en":"The Great Beijing of Kakanchyn"},{"id":"manas-2010:p1481:b001:l014","ordinal":63932,"en":"Was a place for battle."},{"id":"manas-2010:p1481:b001:l015","ordinal":63933,"en":"Looking upon their looming host,"},{"id":"manas-2010:p1481:b001:l016","ordinal":63934,"en":"They were truly the people of forty khans."},{"id":"manas-2010:p1481:b001:l017","ordinal":63935,"en":"Spreading broadly out before them,"},{"id":"manas-2010:p1481:b001:l018","ordinal":63936,"en":"Covering the land like a forest,"},{"id":"manas-2010:p1481:b001:l019","ordinal":63937,"en":"The Chinese multitude was a flood."},{"id":"manas-2010:p1481:b001:l020","ordinal":63938,"en":"Dividing off in a gray mass,"},{"id":"manas-2010:p1481:b001:l021","ordinal":63939,"en":"He set the gray-horse riders apart."},{"id":"manas-2010:p1481:b001:l022","ordinal":63940,"en":"Those who would sweep in unchecked,"},{"id":"manas-2010:p1481:b001:l023","ordinal":63941,"en":"The mule-riders, he set apart."},{"id":"manas-2010:p1481:b001:l024","ordinal":63942,"en":"Clothing them in iron armor,"},{"id":"manas-2010:p1481:b001:l025","ordinal":63943,"en":"Those who would catch the fleeing,"},{"id":"manas-2010:p1481:b001:l026","ordinal":63944,"en":"His warriors, he set apart."},{"id":"manas-2010:p1481:b001:l027","ordinal":63945,"en":"His men who drew the bow,"},{"id":"manas-2010:p1481:b001:l028","ordinal":63946,"en":"His champions who spared no life,"},{"id":"manas-2010:p1481:b001:l029","ordinal":63947,"en":"He gathered all into one division."},{"id":"manas-2010:p1481:b001:l030","ordinal":63948,"en":"Those who stood and fought without fleeing,"},{"id":"manas-2010:p1481:b001:l031","ordinal":63949,"en":"His Dagger-Hands, he set apart."},{"id":"manas-2010:p1481:b001:l032","ordinal":63950,"en":"Those who would tear and devour people,"},{"id":"manas-2010:p1481:b001:l033","ordinal":63951,"en":"His butchers, he set apart."},{"id":"manas-2010:p1481:b001:l034","ordinal":63952,"en":"The eye could not reach their end;"},{"id":"manas-2010:p1481:b001:l035","ordinal":63953,"en":"They came surging like a lake."},{"id":"manas-2010:p1481:b001:l036","ordinal":63954,"en":"Such was their multitude"},{"id":"manas-2010:p1481:b001:l037","ordinal":63955,"en":"That words could not encompass it."},{"id":"manas-2010:p1481:b001:l038","ordinal":63956,"en":"From the dust of the marching Chinese,"},{"id":"manas-2010:p1481:b001:l039","ordinal":63957,"en":"One could not tell if it was day,"},{"id":"manas-2010:p1481:b001:l040","ordinal":63958,"en":"Nor could one tell if it was night."},{"id":"manas-2010:p1481:b001:l041","ordinal":63959,"en":"The sky was clear, the earth overcast;"},{"id":"manas-2010:p1481:b001:l042","ordinal":63960,"en":"People veiled the face of the earth."},{"id":"manas-2010:p1482:b001:l001","ordinal":63961,"en":"Lance points struck together,"},{"id":"manas-2010:p1482:b001:l002","ordinal":63962,"en":"Men's heads knocked together;"},{"id":"manas-2010:p1482:b001:l003","ordinal":63963,"en":"As though a war-drum were being beaten,"},{"id":"manas-2010:p1482:b001:l004","ordinal":63964,"en":"Battle-axes and swords clanged."},{"id":"manas-2010:p1482:b001:l005","ordinal":63965,"en":"The massed Chinese and many Manzhuu"},{"id":"manas-2010:p1482:b001:l006","ordinal":63966,"en":"Came pouring into sight;"},{"id":"manas-2010:p1482:b001:l007","ordinal":63967,"en":"No reckoning could reach their number."},{"id":"manas-2010:p1482:b001:l008","ordinal":63968,"en":"At the spur where the mountains ended,"},{"id":"manas-2010:p1482:b001:l009","ordinal":63969,"en":"The multitude came into view."},{"id":"manas-2010:p1482:b001:l010","ordinal":63970,"en":"Driving them all before him,"},{"id":"manas-2010:p1482:b001:l011","ordinal":63971,"en":"Alöökö's Kongurbay,"},{"id":"manas-2010:p1482:b001:l012","ordinal":63972,"en":"Their great bull-camel, came into view."},{"id":"manas-2010:p1482:b001:l013","ordinal":63973,"en":"The swordsmen were at the front;"},{"id":"manas-2010:p1482:b001:l014","ordinal":63974,"en":"Those who would not spare their lives a hair,"},{"id":"manas-2010:p1482:b001:l015","ordinal":63975,"en":"His mighty men, were on the edges."},{"id":"manas-2010:p1482:b001:l016","ordinal":63976,"en":"His marksmen who never missed"},{"id":"manas-2010:p1482:b001:l017","ordinal":63977,"en":"He had placed upon his flanks."},{"id":"manas-2010:p1482:b001:l018","ordinal":63978,"en":"Those who would stand and fight,"},{"id":"manas-2010:p1482:b001:l019","ordinal":63979,"en":"All his fearless men,"},{"id":"manas-2010:p1482:b001:l020","ordinal":63980,"en":"He had placed in the very front."},{"id":"manas-2010:p1482:b001:l021","ordinal":63981,"en":"All his inferior men"},{"id":"manas-2010:p1482:b001:l022","ordinal":63982,"en":"He surrounded in the middle,"},{"id":"manas-2010:p1482:b001:l023","ordinal":63983,"en":"Keeping them within their ranks."},{"id":"manas-2010:p1482:b001:l024","ordinal":63984,"en":"That the Muslims had arrived,"},{"id":"manas-2010:p1482:b001:l025","ordinal":63985,"en":"That all stood prepared,"},{"id":"manas-2010:p1482:b001:l026","ordinal":63986,"en":"Kongurbay had seen."},{"id":"manas-2010:p1482:b001:l027","ordinal":63987,"en":"“A Burut will come to single combat"},{"id":"manas-2010:p1482:b001:l028","ordinal":63988,"en":"And grant me my turn,” he thought."},{"id":"manas-2010:p1482:b001:l029","ordinal":63989,"en":"To the giant governor riding Karager,"},{"id":"manas-2010:p1482:b001:l030","ordinal":63990,"en":"“Go out and fight a duel!” he said,"},{"id":"manas-2010:p1482:b001:l031","ordinal":63991,"en":"And placed him at the very front."},{"id":"manas-2010:p1482:b001:l032","ordinal":63992,"en":"That the governor was approaching,"},{"id":"manas-2010:p1482:b001:l033","ordinal":63993,"en":"Brave Almambet now saw."},{"id":"manas-2010:p1482:b001:l034","ordinal":63994,"en":"“Forty companions of Khan Manas,"},{"id":"manas-2010:p1482:b001:l035","ordinal":63995,"en":"Let one of you go out alone!”"},{"id":"manas-2010:p1482:b001:l036","ordinal":63996,"en":"He turned his head and stood."},{"id":"manas-2010:p1482:b001:l037","ordinal":63997,"en":"Egizkhan's youngest son,"},{"id":"manas-2010:p1482:b001:l038","ordinal":63998,"en":"A servant beloved by God,"},{"id":"manas-2010:p1482:b001:l039","ordinal":63999,"en":"Who had come and settled in Talas"},{"id":"manas-2010:p1482:b001:l040","ordinal":64000,"en":"As a companion to Manas,"}]
