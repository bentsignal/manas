[{"id":"manas-2010:p1202:b001:l033","ordinal":52225,"en":"Had reason to weep."},{"id":"manas-2010:p1202:b001:l034","ordinal":52226,"en":"A lion such as this,"},{"id":"manas-2010:p1202:b001:l035","ordinal":52227,"en":"Calling him ‘Chinese’ since he came,"},{"id":"manas-2010:p1202:b001:l036","ordinal":52228,"en":"Was God-cursed speech."},{"id":"manas-2010:p1202:b001:l037","ordinal":52229,"en":"Bearing all of that,"},{"id":"manas-2010:p1202:b001:l038","ordinal":52230,"en":"Almambet is a true warrior."},{"id":"manas-2010:p1202:b001:l039","ordinal":52231,"en":"Never once knitting his brow,"},{"id":"manas-2010:p1202:b001:l040","ordinal":52232,"en":"Almambet is of noble stock."},{"id":"manas-2010:p1202:b001:l041","ordinal":52233,"en":"As long as your Alake lives,"},{"id":"manas-2010:p1202:b001:l042","ordinal":52234,"en":"For firmly established Manas"},{"id":"manas-2010:p1203:b001:l001","ordinal":52235,"en":"He is a deeply dug moat,"},{"id":"manas-2010:p1203:b001:l002","ordinal":52236,"en":"Which no one can cut through and cross,"},{"id":"manas-2010:p1203:b001:l003","ordinal":52237,"en":"A net made of steel."},{"id":"manas-2010:p1203:b001:l004","ordinal":52238,"en":"Truly Almambet,"},{"id":"manas-2010:p1203:b001:l005","ordinal":52239,"en":"Were it not for the Muslim faith,"},{"id":"manas-2010:p1203:b001:l006","ordinal":52240,"en":"It would be humiliation for him to come to us.”"},{"id":"manas-2010:p1203:b001:l007","ordinal":52241,"en":"While he was saying this,"},{"id":"manas-2010:p1203:b001:l008","ordinal":52242,"en":"Your lion, champion Almambet,"},{"id":"manas-2010:p1203:b001:l009","ordinal":52243,"en":"Showed his blue-maned valor."},{"id":"manas-2010:p1203:b001:l010","ordinal":52244,"en":"The official's uniform beside him"},{"id":"manas-2010:p1203:b001:l011","ordinal":52245,"en":"He put on warrior Syrgak."},{"id":"manas-2010:p1203:b001:l012","ordinal":52246,"en":"Though himself a khan, Almambet"},{"id":"manas-2010:p1203:b001:l013","ordinal":52247,"en":"Girded Syrgak snugly,"},{"id":"manas-2010:p1203:b001:l014","ordinal":52248,"en":"The impetuous twenty-year-old."},{"id":"manas-2010:p1203:b001:l015","ordinal":52249,"en":"His appearance surpassed other men's."},{"id":"manas-2010:p1203:b001:l016","ordinal":52250,"en":"When he wore the official's uniform,"},{"id":"manas-2010:p1203:b001:l017","ordinal":52251,"en":"Behind the half-khan"},{"id":"manas-2010:p1203:b001:l018","ordinal":52252,"en":"A guard who would follow,"},{"id":"manas-2010:p1203:b001:l019","ordinal":52253,"en":"His attendant he now became."},{"id":"manas-2010:p1203:b001:l020","ordinal":52254,"en":"Turning toward Kürpüldök,"},{"id":"manas-2010:p1203:b001:l021","ordinal":52255,"en":"They entered the great river."},{"id":"manas-2010:p1203:b001:l022","ordinal":52256,"en":"Where they entered, the great river"},{"id":"manas-2010:p1203:b001:l023","ordinal":52257,"en":"Rushed no higher than the saddlecloth."},{"id":"manas-2010:p1203:b001:l024","ordinal":52258,"en":"The true noble steed Sarala,"},{"id":"manas-2010:p1203:b001:l025","ordinal":52259,"en":"His grooved white front teeth"},{"id":"manas-2010:p1203:b001:l026","ordinal":52260,"en":"Gleaming in his mouth,"},{"id":"manas-2010:p1203:b001:l027","ordinal":52261,"en":"Swam the river like a duck,"},{"id":"manas-2010:p1203:b001:l028","ordinal":52262,"en":"Going onward with a roar."},{"id":"manas-2010:p1203:b001:l029","ordinal":52263,"en":"Warrior Syrgak followed behind,"},{"id":"manas-2010:p1203:b001:l030","ordinal":52264,"en":"Keeping Kartküröng firmly alongside,"},{"id":"manas-2010:p1203:b001:l031","ordinal":52265,"en":"Stroking and lightly whipping him."},{"id":"manas-2010:p1203:b001:l032","ordinal":52266,"en":"The three noble steeds beneath them"},{"id":"manas-2010:p1203:b001:l033","ordinal":52267,"en":"Had no heavy loads upon them,"},{"id":"manas-2010:p1203:b001:l034","ordinal":52268,"en":"No tongues if they wished to speak,"},{"id":"manas-2010:p1203:b001:l035","ordinal":52269,"en":"Creatures wiser than other beasts."},{"id":"manas-2010:p1203:b001:l036","ordinal":52270,"en":"Cow-rumped Sarala,"},{"id":"manas-2010:p1203:b001:l037","ordinal":52271,"en":"When he veered, they veered;"},{"id":"manas-2010:p1203:b001:l038","ordinal":52272,"en":"When he slipped through, they slipped through."},{"id":"manas-2010:p1203:b001:l039","ordinal":52273,"en":"With warrior Syrgak following,"},{"id":"manas-2010:p1203:b001:l040","ordinal":52274,"en":"Azizkan's blue-maned one"},{"id":"manas-2010:p1203:b001:l041","ordinal":52275,"en":"Crossed safely now."},{"id":"manas-2010:p1203:b001:l042","ordinal":52276,"en":"After they crossed Kürpüldök,"},{"id":"manas-2010:p1204:b001:l001","ordinal":52277,"en":"On the far side, raising dust,"},{"id":"manas-2010:p1204:b001:l002","ordinal":52278,"en":"When they reached the broad gray flat,"},{"id":"manas-2010:p1204:b001:l003","ordinal":52279,"en":"Ahead the ground resounded;"},{"id":"manas-2010:p1204:b001:l004","ordinal":52280,"en":"It was a path for a single horse."},{"id":"manas-2010:p1204:b001:l005","ordinal":52281,"en":"A teeming mass of people,"},{"id":"manas-2010:p1204:b001:l006","ordinal":52282,"en":"No one knew their news."},{"id":"manas-2010:p1204:b001:l007","ordinal":52283,"en":"Among them Zholoy was chief."},{"id":"manas-2010:p1204:b001:l008","ordinal":52284,"en":"Was he not the khan of the Manchu?"},{"id":"manas-2010:p1204:b001:l009","ordinal":52285,"en":"It was Ezkara's army."},{"id":"manas-2010:p1204:b001:l010","ordinal":52286,"en":"When they reached that army,"},{"id":"manas-2010:p1204:b001:l011","ordinal":52287,"en":"The Chinese stirred in rattling commotion."},{"id":"manas-2010:p1204:b001:l012","ordinal":52288,"en":"Commanders of ten and commanders of a thousand,"},{"id":"manas-2010:p1204:b001:l013","ordinal":52289,"en":"“He is Beijing's half-khan,”"},{"id":"manas-2010:p1204:b001:l014","ordinal":52290,"en":"When they saw Almambet,"},{"id":"manas-2010:p1204:b001:l015","ordinal":52291,"en":"All the Chinese gathered"},{"id":"manas-2010:p1204:b001:l016","ordinal":52292,"en":"And bowed, crying out."},{"id":"manas-2010:p1204:b001:l017","ordinal":52293,"en":"Making that army strong,"},{"id":"manas-2010:p1204:b001:l018","ordinal":52294,"en":"Azizkan's Almambet,"},{"id":"manas-2010:p1204:b001:l019","ordinal":52295,"en":"Had he not organized it before leaving?"},{"id":"manas-2010:p1204:b001:l020","ordinal":52296,"en":"The half-khan's golden throne,"},{"id":"manas-2010:p1204:b001:l021","ordinal":52297,"en":"Had he not occupied it before leaving?"},{"id":"manas-2010:p1204:b001:l022","ordinal":52298,"en":"The teeming Chinese and Manchu,"},{"id":"manas-2010:p1204:b001:l023","ordinal":52299,"en":"Had he not ruled them before leaving?"},{"id":"manas-2010:p1204:b001:l024","ordinal":52300,"en":"The Chinese stirred and gathered:"},{"id":"manas-2010:p1204:b001:l025","ordinal":52301,"en":"“Beijing's khan has come,”"},{"id":"manas-2010:p1204:b001:l026","ordinal":52302,"en":"The gathered people thought."},{"id":"manas-2010:p1204:b001:l027","ordinal":52303,"en":"At that time Almambet,"},{"id":"manas-2010:p1204:b001:l028","ordinal":52304,"en":"Turning with a solemn face,"},{"id":"manas-2010:p1204:b001:l029","ordinal":52305,"en":"Struck the great drum."},{"id":"manas-2010:p1204:b001:l030","ordinal":52306,"en":"Of the teeming Chinese and Manchu,"},{"id":"manas-2010:p1204:b001:l031","ordinal":52307,"en":"Summoning their champions,"},{"id":"manas-2010:p1204:b001:l032","ordinal":52308,"en":"He stood issuing orders:"},{"id":"manas-2010:p1204:b001:l033","ordinal":52309,"en":"“The watchful fox upon the lookout,"},{"id":"manas-2010:p1204:b001:l034","ordinal":52310,"en":"From the watchful fox I heard news:"},{"id":"manas-2010:p1204:b001:l035","ordinal":52311,"en":"From the heights of Suuk-Tör,"},{"id":"manas-2010:p1204:b001:l036","ordinal":52312,"en":"From the land of the One-Eyed,"},{"id":"manas-2010:p1204:b001:l037","ordinal":52313,"en":"From its excavated pit,"},{"id":"manas-2010:p1204:b001:l038","ordinal":52314,"en":"From the sorcerer's hands,"},{"id":"manas-2010:p1204:b001:l039","ordinal":52315,"en":"So many treasures of gold"},{"id":"manas-2010:p1204:b001:l040","ordinal":52316,"en":"‘He comes scattering,’ I heard."},{"id":"manas-2010:p1204:b001:l041","ordinal":52317,"en":"A people called Burut has arisen,"},{"id":"manas-2010:p1204:b001:l042","ordinal":52318,"en":"A khan called Manas has arisen,"},{"id":"manas-2010:p1205:b001:l001","ordinal":52319,"en":"That accursed Manas,"},{"id":"manas-2010:p1205:b001:l002","ordinal":52320,"en":"His very news makes souls depart."},{"id":"manas-2010:p1205:b001:l003","ordinal":52321,"en":"His appearance is known,"},{"id":"manas-2010:p1205:b001:l004","ordinal":52322,"en":"Drawn in our register."},{"id":"manas-2010:p1205:b001:l005","ordinal":52323,"en":"If you ask about Manas:"},{"id":"manas-2010:p1205:b001:l006","ordinal":52324,"en":"‘His face is like oiled wheat,’ they say,"},{"id":"manas-2010:p1205:b001:l007","ordinal":52325,"en":"‘His eyes are dusk and mist,’ they say,"},{"id":"manas-2010:p1205:b001:l008","ordinal":52326,"en":"‘He pays the world no heed,’ they say."},{"id":"manas-2010:p1205:b001:l009","ordinal":52327,"en":"‘When that Manas comes,"},{"id":"manas-2010:p1205:b001:l010","ordinal":52328,"en":"Of this Beijing"},{"id":"manas-2010:p1205:b001:l011","ordinal":52329,"en":"Not a stick to bend into a herding pole will remain,’ they say."},{"id":"manas-2010:p1205:b001:l012","ordinal":52330,"en":"Champions stationed to block the road,"},{"id":"manas-2010:p1205:b001:l013","ordinal":52331,"en":"Are you lying unaware,"},{"id":"manas-2010:p1205:b001:l014","ordinal":52332,"en":"With no concern for him?"},{"id":"manas-2010:p1205:b001:l015","ordinal":52333,"en":"If he crosses Suuk-Tör and comes,"},{"id":"manas-2010:p1205:b001:l016","ordinal":52334,"en":"The khan who resists will die;"},{"id":"manas-2010:p1205:b001:l017","ordinal":52335,"en":"Everyone caught will die."},{"id":"manas-2010:p1205:b001:l018","ordinal":52336,"en":"The reason I say they will die:"},{"id":"manas-2010:p1205:b001:l019","ordinal":52337,"en":"A fire burning from the core is terrible."},{"id":"manas-2010:p1205:b001:l020","ordinal":52338,"en":"Did he not come from our own people?"},{"id":"manas-2010:p1205:b001:l021","ordinal":52339,"en":"Your blazing Alma, turned stranger, is terrible."},{"id":"manas-2010:p1205:b001:l022","ordinal":52340,"en":"An unarmed people is in a bad plight."},{"id":"manas-2010:p1205:b001:l023","ordinal":52341,"en":"Gone alone to the Burut,"},{"id":"manas-2010:p1205:b001:l024","ordinal":52342,"en":"A slave like Almambet is terrible."},{"id":"manas-2010:p1205:b001:l025","ordinal":52343,"en":"To Kakanchyn's Beijing"},{"id":"manas-2010:p1205:b001:l026","ordinal":52344,"en":"I shall go and carry news."},{"id":"manas-2010:p1205:b001:l027","ordinal":52345,"en":"Of the Chinese people of forty khans"},{"id":"manas-2010:p1205:b001:l028","ordinal":52346,"en":"I shall gather the champions.”"},{"id":"manas-2010:p1205:b001:l029","ordinal":52347,"en":"After learning this news,"},{"id":"manas-2010:p1205:b001:l030","ordinal":52348,"en":"Hearing the half-khan's words,"},{"id":"manas-2010:p1205:b001:l031","ordinal":52349,"en":"Would all the Chinese stay still?"},{"id":"manas-2010:p1205:b001:l032","ordinal":52350,"en":"Earth flew, dust filled the air."},{"id":"manas-2010:p1205:b001:l033","ordinal":52351,"en":"Unable to stay still, roaring,"},{"id":"manas-2010:p1205:b001:l034","ordinal":52352,"en":"With Ezkara and Zholoy as khans,"},{"id":"manas-2010:p1205:b001:l035","ordinal":52353,"en":"The many Kalmyks lying in wait"},{"id":"manas-2010:p1205:b001:l036","ordinal":52354,"en":"Teemed with life like ants."},{"id":"manas-2010:p1205:b001:l037","ordinal":52355,"en":"They mounted swift mules,"},{"id":"manas-2010:p1205:b001:l038","ordinal":52356,"en":"They donned blue iron."},{"id":"manas-2010:p1205:b001:l039","ordinal":52357,"en":"Gray-dappled banners rose;"},{"id":"manas-2010:p1205:b001:l040","ordinal":52358,"en":"An uproar stormed."},{"id":"manas-2010:p1205:b001:l041","ordinal":52359,"en":"Spreading all the Chinese out,"},{"id":"manas-2010:p1205:b001:l042","ordinal":52360,"en":"Behind the teeming Chinese,"},{"id":"manas-2010:p1206:b001:l001","ordinal":52361,"en":"Having Ezkara drive them on,"},{"id":"manas-2010:p1206:b001:l002","ordinal":52362,"en":"Holding and wheeling his banner,"},{"id":"manas-2010:p1206:b001:l003","ordinal":52363,"en":"Almambet stood shouting."},{"id":"manas-2010:p1206:b001:l004","ordinal":52364,"en":"It was a road of no return,"},{"id":"manas-2010:p1206:b001:l005","ordinal":52365,"en":"Sending them to Suuk-Tör."},{"id":"manas-2010:p1206:b001:l006","ordinal":52366,"en":"After the surging great army"},{"id":"manas-2010:p1206:b001:l007","ordinal":52367,"en":"Had gone to Suuk-Tör,"},{"id":"manas-2010:p1206:b001:l008","ordinal":52368,"en":"After Almambet, through cunning,"},{"id":"manas-2010:p1206:b001:l009","ordinal":52369,"en":"Had attained his desire,"},{"id":"manas-2010:p1206:b001:l010","ordinal":52370,"en":"Toward the gate with golden doors,"},{"id":"manas-2010:p1206:b001:l011","ordinal":52371,"en":"Esenkan's palace,"},{"id":"manas-2010:p1206:b001:l012","ordinal":52372,"en":"He set his course."},{"id":"manas-2010:p1206:b001:l013","ordinal":52373,"en":"“My beloved Syrgak,"},{"id":"manas-2010:p1206:b001:l014","ordinal":52374,"en":"My exceptional mighty one,"},{"id":"manas-2010:p1206:b001:l015","ordinal":52375,"en":"The ridged felt hat upon your head,"},{"id":"manas-2010:p1206:b001:l016","ordinal":52376,"en":"The official's uniform upon you,"},{"id":"manas-2010:p1206:b001:l017","ordinal":52377,"en":"Do not let others know our secret!"},{"id":"manas-2010:p1206:b001:l018","ordinal":52378,"en":"You are twenty years old."},{"id":"manas-2010:p1206:b001:l019","ordinal":52379,"en":"The Chinese have beautiful daughters,"},{"id":"manas-2010:p1206:b001:l020","ordinal":52380,"en":"Long necks and flowing dresses,"},{"id":"manas-2010:p1206:b001:l021","ordinal":52381,"en":"Stately, with camel-calf eyes."},{"id":"manas-2010:p1206:b001:l022","ordinal":52382,"en":"The Chinese have beautiful young wives,"},{"id":"manas-2010:p1206:b001:l023","ordinal":52383,"en":"Lovely girls with thimble mouths."},{"id":"manas-2010:p1206:b001:l024","ordinal":52384,"en":"When a young soul sees them,"},{"id":"manas-2010:p1206:b001:l025","ordinal":52385,"en":"How can he stay without speaking?"},{"id":"manas-2010:p1206:b001:l026","ordinal":52386,"en":"Seeing them, your insides become embers."},{"id":"manas-2010:p1206:b001:l027","ordinal":52387,"en":"Do not chance to speak"},{"id":"manas-2010:p1206:b001:l028","ordinal":52388,"en":"And reveal you are Burut."},{"id":"manas-2010:p1206:b001:l029","ordinal":52389,"en":"After revealing it, my Syrgak,"},{"id":"manas-2010:p1206:b001:l030","ordinal":52390,"en":"What desire could we fulfill?"},{"id":"manas-2010:p1206:b001:l031","ordinal":52391,"en":"Ay Jangjung's daughter Birmyskal,"},{"id":"manas-2010:p1206:b001:l032","ordinal":52392,"en":"Esenkan's daughter Burulcha,"},{"id":"manas-2010:p1206:b001:l033","ordinal":52393,"en":"We shall greet them as we go.”"},{"id":"manas-2010:p1206:b001:l034","ordinal":52394,"en":"Saying this, Almambet"},{"id":"manas-2010:p1206:b001:l035","ordinal":52395,"en":"Sent Sarala streaming onward,"},{"id":"manas-2010:p1206:b001:l036","ordinal":52396,"en":"Traveling without a care."},{"id":"manas-2010:p1206:b001:l037","ordinal":52397,"en":"Esenkan's daughter Burulcha,"},{"id":"manas-2010:p1206:b001:l038","ordinal":52398,"en":"Amid the teeming Chinese,"},{"id":"manas-2010:p1206:b001:l039","ordinal":52399,"en":"On one of the nights just past,"},{"id":"manas-2010:p1206:b001:l040","ordinal":52400,"en":"Had seen Almambet in a dream."},{"id":"manas-2010:p1206:b001:l041","ordinal":52401,"en":"Look at the dream she saw:"},{"id":"manas-2010:p1206:b001:l042","ordinal":52402,"en":"She had been immersed in great delight,"},{"id":"manas-2010:p1207:b001:l001","ordinal":52403,"en":"Naked, without a dress,"},{"id":"manas-2010:p1207:b001:l002","ordinal":52404,"en":"She had lain with Almambet."},{"id":"manas-2010:p1207:b001:l003","ordinal":52405,"en":"When she woke, your Alma was not beside her;"},{"id":"manas-2010:p1207:b001:l004","ordinal":52406,"en":"She burned and suffered torment."},{"id":"manas-2010:p1207:b001:l005","ordinal":52407,"en":"Amid the teeming Chinese,"},{"id":"manas-2010:p1207:b001:l006","ordinal":52408,"en":"Without letting anyone know,"},{"id":"manas-2010:p1207:b001:l007","ordinal":52409,"en":"To Birmyskal beside her"},{"id":"manas-2010:p1207:b001:l008","ordinal":52410,"en":"She spoke through her flute:"},{"id":"manas-2010:p1207:b001:l009","ordinal":52411,"en":"“Dear Myskal,"},{"id":"manas-2010:p1207:b001:l010","ordinal":52412,"en":"Did you see what I saw?"},{"id":"manas-2010:p1207:b001:l011","ordinal":52413,"en":"Did you know what I knew?"},{"id":"manas-2010:p1207:b001:l012","ordinal":52414,"en":"Cloudy by day, clear by night,"},{"id":"manas-2010:p1207:b001:l013","ordinal":52415,"en":"Such is the state of your sorrowful Alma."},{"id":"manas-2010:p1207:b001:l014","ordinal":52416,"en":"Lying at night, I dreamed:"},{"id":"manas-2010:p1207:b001:l015","ordinal":52417,"en":"My Alma was in my embrace."},{"id":"manas-2010:p1207:b001:l016","ordinal":52418,"en":"My poor soul longs for your Alma.”"},{"id":"manas-2010:p1207:b001:l017","ordinal":52419,"en":"Then Ay Jangjung's daughter,"},{"id":"manas-2010:p1207:b001:l018","ordinal":52420,"en":"Birmyskal,"},{"id":"manas-2010:p1207:b001:l019","ordinal":52421,"en":"She too lamented and said:"},{"id":"manas-2010:p1207:b001:l020","ordinal":52422,"en":"“Returning to Beijing,"},{"id":"manas-2010:p1207:b001:l021","ordinal":52423,"en":"Where is the night that will be the Night of Power?"},{"id":"manas-2010:p1207:b001:l022","ordinal":52424,"en":"Almambet and Chubak, their names in accord,"},{"id":"manas-2010:p1207:b001:l023","ordinal":52425,"en":"Where is the day when they will come?"},{"id":"manas-2010:p1207:b001:l024","ordinal":52426,"en":"Like the stars in the sky,"},{"id":"manas-2010:p1207:b001:l025","ordinal":52427,"en":"Where is the day when we shall set together?"},{"id":"manas-2010:p1207:b001:l026","ordinal":52428,"en":"Nestling tenderly in their arms,"},{"id":"manas-2010:p1207:b001:l027","ordinal":52429,"en":"Elder sister, where is the day we shall lie?"},{"id":"manas-2010:p1207:b001:l028","ordinal":52430,"en":"Almambet bearing his spear,"},{"id":"manas-2010:p1207:b001:l029","ordinal":52431,"en":"Warrior Chubak, his name in accord,"},{"id":"manas-2010:p1207:b001:l030","ordinal":52432,"en":"The two coming to Beijing,"},{"id":"manas-2010:p1207:b001:l031","ordinal":52433,"en":"Where is the day they will wreak slaughter?"},{"id":"manas-2010:p1207:b001:l032","ordinal":52434,"en":"Fighting against the Chinese,"},{"id":"manas-2010:p1207:b001:l033","ordinal":52435,"en":"The two of us as booty,"},{"id":"manas-2010:p1207:b001:l034","ordinal":52436,"en":"Where is the day they will take us?!”"},{"id":"manas-2010:p1207:b001:l035","ordinal":52437,"en":"Saying this, the two girls'"},{"id":"manas-2010:p1207:b001:l036","ordinal":52438,"en":"Hearts grew distracted."},{"id":"manas-2010:p1207:b001:l037","ordinal":52439,"en":"At that time the two girls'"},{"id":"manas-2010:p1207:b001:l038","ordinal":52440,"en":"Tears flowed from their eyes."},{"id":"manas-2010:p1207:b001:l039","ordinal":52441,"en":"Esenkan's daughter Burulcha,"},{"id":"manas-2010:p1207:b001:l040","ordinal":52442,"en":"Standing, thinking of a wondrous scheme,"},{"id":"manas-2010:p1207:b001:l041","ordinal":52443,"en":"Then gave orders to her people."},{"id":"manas-2010:p1207:b001:l042","ordinal":52444,"en":"The order she spoke:"},{"id":"manas-2010:p1208:b001:l001","ordinal":52445,"en":"“Gatekeeper huddling there,"},{"id":"manas-2010:p1208:b001:l002","ordinal":52446,"en":"Do not close the gate's mouth today!"},{"id":"manas-2010:p1208:b001:l003","ordinal":52447,"en":"Scouts who stand guard,"},{"id":"manas-2010:p1208:b001:l004","ordinal":52448,"en":"Together with your sentries,"},{"id":"manas-2010:p1208:b001:l005","ordinal":52449,"en":"Let none of you stay beside me."},{"id":"manas-2010:p1208:b001:l006","ordinal":52450,"en":"Trumpeter, swift runner,"},{"id":"manas-2010:p1208:b001:l007","ordinal":52451,"en":"Do not carry your news!”"},{"id":"manas-2010:p1208:b001:l008","ordinal":52452,"en":"After she said this,"},{"id":"manas-2010:p1208:b001:l009","ordinal":52453,"en":"All the messengers"},{"id":"manas-2010:p1208:b001:l010","ordinal":52454,"en":"Ran away calling out."},{"id":"manas-2010:p1208:b001:l011","ordinal":52455,"en":"Her doorway stood deserted."},{"id":"manas-2010:p1208:b001:l012","ordinal":52456,"en":"The Chinese had not closed"},{"id":"manas-2010:p1208:b001:l013","ordinal":52457,"en":"The opening in the palace."},{"id":"manas-2010:p1208:b001:l014","ordinal":52458,"en":"On that day the Chinese"},{"id":"manas-2010:p1208:b001:l015","ordinal":52459,"en":"Forty khans' daughters gathered."},{"id":"manas-2010:p1208:b001:l016","ordinal":52460,"en":"They held bell-games and a feast."},{"id":"manas-2010:p1208:b001:l017","ordinal":52461,"en":"The champions, mingling with the feast,"},{"id":"manas-2010:p1208:b001:l018","ordinal":52462,"en":"Trotted along the single path."},{"id":"manas-2010:p1208:b001:l019","ordinal":52463,"en":"They had not come at some odd time:"},{"id":"manas-2010:p1208:b001:l020","ordinal":52464,"en":"They had arrived in the New Year month."},{"id":"manas-2010:p1208:b001:l021","ordinal":52465,"en":"The many girls at play"},{"id":"manas-2010:p1208:b001:l022","ordinal":52466,"en":"Saw Almambet."},{"id":"manas-2010:p1208:b001:l023","ordinal":52467,"en":"With red-mottled floral patterns,"},{"id":"manas-2010:p1208:b001:l024","ordinal":52468,"en":"He wore striking clothes."},{"id":"manas-2010:p1208:b001:l025","ordinal":52469,"en":"Look at the wonders of the world:"},{"id":"manas-2010:p1208:b001:l026","ordinal":52470,"en":"Not recognizing Almambet,"},{"id":"manas-2010:p1208:b001:l027","ordinal":52471,"en":"“The half-khan has come to the feast,”"},{"id":"manas-2010:p1208:b001:l028","ordinal":52472,"en":"“The half-khan,” they kept saying."},{"id":"manas-2010:p1208:b001:l029","ordinal":52473,"en":"“Beijing's half-khan,” they said,"},{"id":"manas-2010:p1208:b001:l030","ordinal":52474,"en":"“The girls count him a delight,” they said."},{"id":"manas-2010:p1208:b001:l031","ordinal":52475,"en":"The noble steed beneath him,"},{"id":"manas-2010:p1208:b001:l032","ordinal":52476,"en":"The wings a hero rides,"},{"id":"manas-2010:p1208:b001:l033","ordinal":52477,"en":"When they saw such a khan,"},{"id":"manas-2010:p1208:b001:l034","ordinal":52478,"en":"The Chinese girls and young wives,"},{"id":"manas-2010:p1208:b001:l035","ordinal":52479,"en":"Raising the khan's spirits,"},{"id":"manas-2010:p1208:b001:l036","ordinal":52480,"en":"With games and amusement,"}]
