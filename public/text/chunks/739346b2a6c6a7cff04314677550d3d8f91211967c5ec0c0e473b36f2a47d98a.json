[{"id":"semetey-1-2013:p1189:b003:l033","ordinal":166913,"en":"Like grain."},{"id":"semetey-1-2013:p1189:b003:l034","ordinal":166914,"en":"When he reached twelve,"},{"id":"semetey-1-2013:p1189:b003:l035","ordinal":166915,"en":"He was entered in the chronicle"},{"id":"semetey-1-2013:p1189:b003:l036","ordinal":166916,"en":"Of Beijing in Kakanchyn,"},{"id":"semetey-1-2013:p1189:b003:l037","ordinal":166917,"en":"And became known to the great men"},{"id":"semetey-1-2013:p1189:b003:l038","ordinal":166918,"en":"Of the seething Chinese host."},{"id":"semetey-1-2013:p1189:b003:l039","ordinal":166919,"en":"The frightened Chinese"},{"id":"semetey-1-2013:p1189:b004:l001","ordinal":166920,"en":"Made him a fortress against the foe"},{"id":"semetey-1-2013:p1189:b004:l002","ordinal":166921,"en":"And the mightiest khan of the Kechils."},{"id":"semetey-1-2013:p1189:b004:l003","ordinal":166922,"en":"Kongurbay, son of Alooke,"},{"id":"semetey-1-2013:p1189:b004:l004","ordinal":166923,"en":"Laid low everyone he met."},{"id":"semetey-1-2013:p1189:b004:l005","ordinal":166924,"en":"Kongurbay was that gray-maned lion;"},{"id":"semetey-1-2013:p1189:b004:l006","ordinal":166925,"en":"At Khan Kokotoy's feast,"},{"id":"semetey-1-2013:p1189:b004:l007","ordinal":166926,"en":"This was where Khan Manas and Kongurbay"},{"id":"semetey-1-2013:p1189:b004:l008","ordinal":166927,"en":"Were destined to clash."},{"id":"semetey-1-2013:p1189:b004:l009","ordinal":166928,"en":"He mounted Algara"},{"id":"semetey-1-2013:p1189:b004:l010","ordinal":166929,"en":"And put on a golden coat."},{"id":"semetey-1-2013:p1189:b004:l011","ordinal":166930,"en":"Taking the white spear in hand,"},{"id":"semetey-1-2013:p1189:b004:l012","ordinal":166931,"en":"He waved a bay-piebald pennant."},{"id":"semetey-1-2013:p1189:b004:l013","ordinal":166932,"en":"A great breastplate shaped like a leather flask"},{"id":"semetey-1-2013:p1189:b004:l014","ordinal":166933,"en":"Flashed beside his horse;"},{"id":"semetey-1-2013:p1189:b004:l015","ordinal":166934,"en":"Bowl-sized gold and coral stones"},{"id":"semetey-1-2013:p1189:b004:l016","ordinal":166935,"en":"Shone from the crown of his head."},{"id":"semetey-1-2013:p1189:b004:l017","ordinal":166936,"en":"His spectacles gleamed."},{"id":"semetey-1-2013:p1189:b004:l018","ordinal":166937,"en":"Cotton boots and hempen waist,"},{"id":"semetey-1-2013:p1189:b004:l019","ordinal":166938,"en":"The swaggering great Kalcha;"},{"id":"semetey-1-2013:p1189:b004:l020","ordinal":166939,"en":"Leather boots and belted waist,"},{"id":"semetey-1-2013:p1189:b004:l021","ordinal":166940,"en":"The raging great Kalcha;"},{"id":"semetey-1-2013:p1189:b004:l022","ordinal":166941,"en":"Girt with latticework iron,"},{"id":"semetey-1-2013:p1189:b004:l023","ordinal":166942,"en":"The hulking great Kalcha."},{"id":"semetey-1-2013:p1189:b004:l024","ordinal":166943,"en":"His eyes were like the whole of a lake,"},{"id":"semetey-1-2013:p1189:b004:l025","ordinal":166944,"en":"As though they would swallow whatever they saw."},{"id":"semetey-1-2013:p1189:b004:l026","ordinal":166945,"en":"The black brows above his eyes"},{"id":"semetey-1-2013:p1189:b004:l027","ordinal":166946,"en":"Were like a folded cloak."},{"id":"semetey-1-2013:p1189:b004:l028","ordinal":166947,"en":"He bore the head of a crouching tiger"},{"id":"semetey-1-2013:p1189:b004:l029","ordinal":166948,"en":"And the brows of a molting tiger."},{"id":"semetey-1-2013:p1189:b004:l030","ordinal":166949,"en":"He narrowed his slanting eyes"},{"id":"semetey-1-2013:p1189:b004:l031","ordinal":166950,"en":"And stroked his hair-thin mustache."},{"id":"semetey-1-2013:p1189:b004:l032","ordinal":166951,"en":"If you looked at his mustaches,"},{"id":"semetey-1-2013:p1189:b004:l033","ordinal":166952,"en":"They were like the haft of a great axe."},{"id":"semetey-1-2013:p1189:b004:l034","ordinal":166953,"en":"If you looked at his nostrils,"},{"id":"semetey-1-2013:p1189:b004:l035","ordinal":166954,"en":"They were like the pouch of a selebe."},{"id":"semetey-1-2013:p1189:b004:l036","ordinal":166955,"en":"The dirty-nosed Kongurbay"},{"id":"semetey-1-2013:p1189:b004:l037","ordinal":166956,"en":"Of the Chinese,"},{"id":"semetey-1-2013:p1189:b004:l038","ordinal":166957,"en":"With a separately made golden bowl,"},{"id":"semetey-1-2013:p1189:b004:l039","ordinal":166958,"en":"And tobacco six spans long,"},{"id":"semetey-1-2013:p1190:b003:l001","ordinal":166959,"en":"Spread it out and took it,"},{"id":"semetey-1-2013:p1190:b003:l002","ordinal":166960,"en":"Drawing until others were frightened."},{"id":"semetey-1-2013:p1190:b003:l003","ordinal":166961,"en":"The coarse-headed, stone-skulled man"},{"id":"semetey-1-2013:p1190:b003:l004","ordinal":166962,"en":"Stood forth upon the field."},{"id":"semetey-1-2013:p1190:b003:l005","ordinal":166963,"en":"All the watching Muslims"},{"id":"semetey-1-2013:p1190:b003:l006","ordinal":166964,"en":"Started and grew afraid."},{"id":"semetey-1-2013:p1190:b003:l007","ordinal":166965,"en":"Algara beneath him,"},{"id":"semetey-1-2013:p1190:b003:l008","ordinal":166966,"en":"When it chased a three-year-old, never let it escape;"},{"id":"semetey-1-2013:p1190:b003:l009","ordinal":166967,"en":"Its tail was sparse and its mane was scant,"},{"id":"semetey-1-2013:p1190:b003:l010","ordinal":166968,"en":"And it was practiced against a fighting foe."},{"id":"semetey-1-2013:p1190:b003:l011","ordinal":166969,"en":"The foot of its tether stood on blue stone."},{"id":"semetey-1-2013:p1190:b003:l012","ordinal":166970,"en":"The people marveled and roared;"},{"id":"semetey-1-2013:p1190:b003:l013","ordinal":166971,"en":"The Black Chinese and many Manchus"},{"id":"semetey-1-2013:p1190:b003:l014","ordinal":166972,"en":"Raised a clamorous shout."},{"id":"semetey-1-2013:p1190:b003:l015","ordinal":166973,"en":"The Muslim people lamented;"},{"id":"semetey-1-2013:p1190:b003:l016","ordinal":166974,"en":"The Black Chinese and many Manchus"},{"id":"semetey-1-2013:p1190:b003:l017","ordinal":166975,"en":"Raised a crying shout."},{"id":"semetey-1-2013:p1190:b003:l018","ordinal":166976,"en":"When they saw Kongurbay's form,"},{"id":"semetey-1-2013:p1190:b003:l019","ordinal":166977,"en":"Khan Koshoy of Katagan"},{"id":"semetey-1-2013:p1190:b003:l020","ordinal":166978,"en":"And saintly hero Bakay"},{"id":"semetey-1-2013:p1190:b003:l021","ordinal":166979,"en":"Saw the monstrous size"},{"id":"semetey-1-2013:p1190:b003:l022","ordinal":166980,"en":"Of hero Kongurbay the infidel."},{"id":"semetey-1-2013:p1190:b003:l023","ordinal":166981,"en":"\"Kongurbay of the Chinese"},{"id":"semetey-1-2013:p1190:b003:l024","ordinal":166982,"en":"Has perfect fortune;"},{"id":"semetey-1-2013:p1190:b003:l025","ordinal":166983,"en":"He is a hero who knows"},{"id":"semetey-1-2013:p1190:b003:l026","ordinal":166984,"en":"The enemy's devices perfectly."},{"id":"semetey-1-2013:p1190:b003:l027","ordinal":166985,"en":"Kongurbay, son of Alooke,"},{"id":"semetey-1-2013:p1190:b003:l028","ordinal":166986,"en":"Has all twelve limbs in proportion."},{"id":"semetey-1-2013:p1190:b003:l029","ordinal":166987,"en":"He is a hero of towering stature."},{"id":"semetey-1-2013:p1190:b003:l030","ordinal":166988,"en":"Whoever grapples with him cannot survive;"},{"id":"semetey-1-2013:p1190:b003:l031","ordinal":166989,"en":"He is at the height of his power."},{"id":"semetey-1-2013:p1190:b003:l032","ordinal":166990,"en":"The renowned hero Kalcha—"},{"id":"semetey-1-2013:p1190:b003:l033","ordinal":166991,"en":"If a hero comes out to fight him,"},{"id":"semetey-1-2013:p1190:b003:l034","ordinal":166992,"en":"Will he arrive before an arrow?"},{"id":"semetey-1-2013:p1190:b003:l035","ordinal":166993,"en":"Will he reach and crush him?"},{"id":"semetey-1-2013:p1190:b003:l036","ordinal":166994,"en":"Will he offer him as a sacrifice?"},{"id":"semetey-1-2013:p1190:b003:l037","ordinal":166995,"en":"Will he take his ancient revenge?\""},{"id":"semetey-1-2013:p1190:b003:l038","ordinal":166996,"en":"Lord Koshoy and Khan Bakay"},{"id":"semetey-1-2013:p1190:b003:l039","ordinal":166997,"en":"Saw him and despaired of life."},{"id":"semetey-1-2013:p1190:b004:l001","ordinal":166998,"en":"When they saw Kongurbay's form,"},{"id":"semetey-1-2013:p1190:b004:l002","ordinal":166999,"en":"Golden-crested, with tasseled belt,"},{"id":"semetey-1-2013:p1190:b004:l003","ordinal":167000,"en":"Only son of Khan Azoozil,"},{"id":"semetey-1-2013:p1190:b004:l004","ordinal":167001,"en":"Wearing a coat of yellow gold"},{"id":"semetey-1-2013:p1190:b004:l005","ordinal":167002,"en":"And mounted on a piebald horse,"},{"id":"semetey-1-2013:p1190:b004:l006","ordinal":167003,"en":"With a decorated belt around his neck,"},{"id":"semetey-1-2013:p1190:b004:l007","ordinal":167004,"en":"Pleaded with the Muslims,"},{"id":"semetey-1-2013:p1190:b004:l008","ordinal":167005,"en":"Saying, \"Let me enter the joust."},{"id":"semetey-1-2013:p1190:b004:l009","ordinal":167006,"en":"My uncle, old Koshoy,"},{"id":"semetey-1-2013:p1190:b004:l010","ordinal":167007,"en":"You elders stand here;"},{"id":"semetey-1-2013:p1190:b004:l011","ordinal":167008,"en":"You palmful of Muslims,"},{"id":"semetey-1-2013:p1190:b004:l012","ordinal":167009,"en":"All of you stand here."},{"id":"semetey-1-2013:p1190:b004:l013","ordinal":167010,"en":"What I amassed remains in Kakanchyn;"},{"id":"semetey-1-2013:p1190:b004:l014","ordinal":167011,"en":"What I have chosen is my faith."},{"id":"semetey-1-2013:p1190:b004:l015","ordinal":167012,"en":"What I amassed remains in Beijing;"},{"id":"semetey-1-2013:p1190:b004:l016","ordinal":167013,"en":"What I pledged is my faith."},{"id":"semetey-1-2013:p1190:b004:l017","ordinal":167014,"en":"My Prophet is true, my religion is true;"},{"id":"semetey-1-2013:p1190:b004:l018","ordinal":167015,"en":"The golden throne was left in Beijing."},{"id":"semetey-1-2013:p1190:b004:l019","ordinal":167016,"en":"When I renounced it and scattered it,"},{"id":"semetey-1-2013:p1190:b004:l020","ordinal":167017,"en":"Turned from the black faith to the true one,"},{"id":"semetey-1-2013:p1190:b004:l021","ordinal":167018,"en":"And fled as a Muslim,"},{"id":"semetey-1-2013:p1190:b004:l022","ordinal":167019,"en":"The Chinese were a multitude and I was alone."},{"id":"semetey-1-2013:p1190:b004:l023","ordinal":167020,"en":"What deed have I done before God?"},{"id":"semetey-1-2013:p1190:b004:l024","ordinal":167021,"en":"Barely escaping death,"},{"id":"semetey-1-2013:p1190:b004:l025","ordinal":167022,"en":"Leaving my martyred mother behind,"},{"id":"semetey-1-2013:p1190:b004:l026","ordinal":167023,"en":"All the Chinese and many Manchus"},{"id":"semetey-1-2013:p1190:b004:l027","ordinal":167024,"en":"Came out to block me and fought."},{"id":"semetey-1-2013:p1190:b004:l028","ordinal":167025,"en":"From the anguish formed in my breast,"},{"id":"semetey-1-2013:p1190:b004:l029","ordinal":167026,"en":"I prayed to God:"},{"id":"semetey-1-2013:p1190:b004:l030","ordinal":167027,"en":"May I find support at the appointed place;"},{"id":"semetey-1-2013:p1190:b004:l031","ordinal":167028,"en":"May I find a hero among the Muslims."},{"id":"semetey-1-2013:p1190:b004:l032","ordinal":167029,"en":"Against Kongurbay, son of Alooke,"},{"id":"semetey-1-2013:p1190:b004:l033","ordinal":167030,"en":"I will unleash a great tumult;"},{"id":"semetey-1-2013:p1190:b004:l034","ordinal":167031,"en":"I will turn and attack the swine"},{"id":"semetey-1-2013:p1190:b004:l035","ordinal":167032,"en":"And take my ancient revenge."},{"id":"semetey-1-2013:p1190:b004:l036","ordinal":167033,"en":"So I have long prayed."},{"id":"semetey-1-2013:p1190:b004:l037","ordinal":167034,"en":"If I meet him in a lonely place,"},{"id":"semetey-1-2013:p1190:b004:l038","ordinal":167035,"en":"I will offer the mother-forsaken Manchu"},{"id":"semetey-1-2013:p1190:b004:l039","ordinal":167036,"en":"As a sacrifice,\""}]
