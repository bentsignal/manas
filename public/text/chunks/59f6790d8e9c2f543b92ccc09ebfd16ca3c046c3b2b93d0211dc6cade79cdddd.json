[{"id":"manas-2010:p1000:b001:l031","ordinal":43777,"en":"A buttress of the deep-rooted mountain,"},{"id":"manas-2010:p1000:b001:l032","ordinal":43778,"en":"He too was a sultan of the Muslims."},{"id":"manas-2010:p1000:b001:l033","ordinal":43779,"en":"Dust filled the space between;"},{"id":"manas-2010:p1000:b001:l034","ordinal":43780,"en":"Taking a sword and laying waste,"},{"id":"manas-2010:p1000:b001:l035","ordinal":43781,"en":"Er Töshtük, Eleman's son,"},{"id":"manas-2010:p1000:b001:l036","ordinal":43782,"en":"Was khan who cleared the way for the host."},{"id":"manas-2010:p1000:b001:l037","ordinal":43783,"en":"Rejoicing at Almambet,"},{"id":"manas-2010:p1000:b001:l038","ordinal":43784,"en":"He smiled beneath his mustache."},{"id":"manas-2010:p1000:b001:l039","ordinal":43785,"en":"Your dear, bloodthirsty Manas"},{"id":"manas-2010:p1000:b001:l040","ordinal":43786,"en":"Now turned Akkula's mouth."},{"id":"manas-2010:p1000:b001:l041","ordinal":43787,"en":"To the vast host setting out,"},{"id":"manas-2010:p1000:b001:l042","ordinal":43788,"en":"He now gave another command."},{"id":"manas-2010:p1001:b001:l001","ordinal":43789,"en":"Aykojo in a striped robe,"},{"id":"manas-2010:p1001:b001:l002","ordinal":43790,"en":"Came as their religious guide."},{"id":"manas-2010:p1001:b001:l003","ordinal":43791,"en":"At that time, Almambet,"},{"id":"manas-2010:p1001:b001:l004","ordinal":43792,"en":"Those who took a spear in hand,"},{"id":"manas-2010:p1001:b001:l005","ordinal":43793,"en":"Who entered battle without sparing themselves,"},{"id":"manas-2010:p1001:b001:l006","ordinal":43794,"en":"He separated those lions into one group."},{"id":"manas-2010:p1001:b001:l007","ordinal":43795,"en":"“My wife and children are left behind,” they said,"},{"id":"manas-2010:p1001:b001:l008","ordinal":43796,"en":"Growing sorrowful and grieving,"},{"id":"manas-2010:p1001:b001:l009","ordinal":43797,"en":"He separated those deserters into one group."},{"id":"manas-2010:p1001:b001:l010","ordinal":43798,"en":"With shields in their hands,"},{"id":"manas-2010:p1001:b001:l011","ordinal":43799,"en":"He separated the resolute into one group."},{"id":"manas-2010:p1001:b001:l012","ordinal":43800,"en":"On a battlefield flowing with blood,"},{"id":"manas-2010:p1001:b001:l013","ordinal":43801,"en":"He separated the fearsome into one group."},{"id":"manas-2010:p1001:b001:l014","ordinal":43802,"en":"Those who acted saying, “I trust in God,”"},{"id":"manas-2010:p1001:b001:l015","ordinal":43803,"en":"He separated those champions into one group."},{"id":"manas-2010:p1001:b001:l016","ordinal":43804,"en":"Those who piled corpses like mountains,"},{"id":"manas-2010:p1001:b001:l017","ordinal":43805,"en":"He separated those champions into one group."},{"id":"manas-2010:p1001:b001:l018","ordinal":43806,"en":"Selecting the capable,"},{"id":"manas-2010:p1001:b001:l019","ordinal":43807,"en":"The mighty, wolf-maned ones like wolves,"},{"id":"manas-2010:p1001:b001:l020","ordinal":43808,"en":"Gladdening those who watched,"},{"id":"manas-2010:p1001:b001:l021","ordinal":43809,"en":"The great host of the twelve khans,"},{"id":"manas-2010:p1001:b001:l022","ordinal":43810,"en":"Stretching it out rank upon rank,"},{"id":"manas-2010:p1001:b001:l023","ordinal":43811,"en":"Almambet led it onward."},{"id":"manas-2010:p1001:b001:l024","ordinal":43812,"en":"Filling heaven and earth with dust,"},{"id":"manas-2010:p1001:b001:l025","ordinal":43813,"en":"Giving each group a flag to carry,"},{"id":"manas-2010:p1001:b001:l026","ordinal":43814,"en":"He secured his entire host."},{"id":"manas-2010:p1001:b001:l027","ordinal":43815,"en":"“Those of you who turn back and flee,"},{"id":"manas-2010:p1001:b001:l028","ordinal":43816,"en":"You die before your appointed death,”"},{"id":"manas-2010:p1001:b001:l029","ordinal":43817,"en":"Champion Almambet threatened."},{"id":"manas-2010:p1001:b001:l030","ordinal":43818,"en":"“Of anyone who turns back and flees,"},{"id":"manas-2010:p1001:b001:l031","ordinal":43819,"en":"I shall plunder his goods;"},{"id":"manas-2010:p1001:b001:l032","ordinal":43820,"en":"I shall bring calamity upon his head."},{"id":"manas-2010:p1001:b001:l033","ordinal":43821,"en":"This great people who have come,"},{"id":"manas-2010:p1001:b001:l034","ordinal":43822,"en":"The whole army of twelve vast hosts,"},{"id":"manas-2010:p1001:b001:l035","ordinal":43823,"en":"I shall check their presence along the way."},{"id":"manas-2010:p1001:b001:l036","ordinal":43824,"en":"From whoever loses a man,"},{"id":"manas-2010:p1001:b001:l037","ordinal":43825,"en":"I shall exact punishment upon his khan."},{"id":"manas-2010:p1001:b001:l038","ordinal":43826,"en":"Those who turn away and disobey,"},{"id":"manas-2010:p1001:b001:l039","ordinal":43827,"en":"Show me those unruly men."},{"id":"manas-2010:p1001:b001:l040","ordinal":43828,"en":"Before the great gathering,"},{"id":"manas-2010:p1001:b001:l041","ordinal":43829,"en":"I shall cut off their heads."},{"id":"manas-2010:p1001:b001:l042","ordinal":43830,"en":"Killing them upon the road,"},{"id":"manas-2010:p1002:b001:l001","ordinal":43831,"en":"I shall make them food for dogs!’"},{"id":"manas-2010:p1002:b001:l002","ordinal":43832,"en":"When they heard this command,"},{"id":"manas-2010:p1002:b001:l003","ordinal":43833,"en":"Despairing of life, crying out,"},{"id":"manas-2010:p1002:b001:l004","ordinal":43834,"en":"Their tears becoming a lake,"},{"id":"manas-2010:p1002:b001:l005","ordinal":43835,"en":"Many stood sobbing."},{"id":"manas-2010:p1002:b001:l006","ordinal":43836,"en":"That they would not return alive from Beijing,"},{"id":"manas-2010:p1002:b001:l007","ordinal":43837,"en":"Many knew among them."},{"id":"manas-2010:p1002:b001:l008","ordinal":43838,"en":"‘Even if we go and die,"},{"id":"manas-2010:p1002:b001:l009","ordinal":43839,"en":"Whatever is written on our foreheads,"},{"id":"manas-2010:p1002:b001:l010","ordinal":43840,"en":"Let us see it on this journey,’ they said;"},{"id":"manas-2010:p1002:b001:l011","ordinal":43841,"en":"Many went laughing."},{"id":"manas-2010:p1002:b001:l012","ordinal":43842,"en":"‘When we eagerly strike the foe,"},{"id":"manas-2010:p1002:b001:l013","ordinal":43843,"en":"I shall enter with my sword,’ they said;"},{"id":"manas-2010:p1002:b001:l014","ordinal":43844,"en":"Still more were shouting."},{"id":"manas-2010:p1002:b001:l015","ordinal":43845,"en":"Piercing cries, mighty battle shouts,"},{"id":"manas-2010:p1002:b001:l016","ordinal":43846,"en":"Seeing the dust-raising charge,"},{"id":"manas-2010:p1002:b001:l017","ordinal":43847,"en":"Your blue-maned lion Manas said:"},{"id":"manas-2010:p1002:b001:l018","ordinal":43848,"en":"‘This great army that has come,"},{"id":"manas-2010:p1002:b001:l019","ordinal":43849,"en":"Take the coats you wear in battle."},{"id":"manas-2010:p1002:b001:l020","ordinal":43850,"en":"Twelve khans, ten separate divisions,"},{"id":"manas-2010:p1002:b001:l021","ordinal":43851,"en":"Take your counted troops."},{"id":"manas-2010:p1002:b001:l022","ordinal":43852,"en":"Load elephants with your ammunition!"},{"id":"manas-2010:p1002:b001:l023","ordinal":43853,"en":"You Muslims who have come,"},{"id":"manas-2010:p1002:b001:l024","ordinal":43854,"en":"Go without turning your steeds' heads,"},{"id":"manas-2010:p1002:b001:l025","ordinal":43855,"en":"Freshen the horses; go without stopping!’"},{"id":"manas-2010:p1002:b001:l026","ordinal":43856,"en":"As he was saying this,"},{"id":"manas-2010:p1002:b001:l027","ordinal":43857,"en":"The whole great army,"},{"id":"manas-2010:p1002:b001:l028","ordinal":43858,"en":"Thundering in clouds of dust,"},{"id":"manas-2010:p1002:b001:l029","ordinal":43859,"en":"All the strong ones,"},{"id":"manas-2010:p1002:b001:l030","ordinal":43860,"en":"Roaring like wild boars,"},{"id":"manas-2010:p1002:b001:l031","ordinal":43861,"en":"The whole great army,"},{"id":"manas-2010:p1002:b001:l032","ordinal":43862,"en":"For Beijing where the Holy One would not go,"},{"id":"manas-2010:p1002:b001:l033","ordinal":43863,"en":"Mounted and set off in swaying ranks."},{"id":"manas-2010:p1002:b001:l034","ordinal":43864,"en":"The spearheads swayed,"},{"id":"manas-2010:p1002:b001:l035","ordinal":43865,"en":"All the men swayed,"},{"id":"manas-2010:p1002:b001:l036","ordinal":43866,"en":"Men's heads knocked together."},{"id":"manas-2010:p1002:b001:l037","ordinal":43867,"en":"Because the great army was so numerous,"},{"id":"manas-2010:p1002:b001:l038","ordinal":43868,"en":"The spear tips clashed together."},{"id":"manas-2010:p1002:b001:l039","ordinal":43869,"en":"Dust flew without a break,"},{"id":"manas-2010:p1002:b001:l040","ordinal":43870,"en":"No open ground could be seen;"},{"id":"manas-2010:p1002:b001:l041","ordinal":43871,"en":"They went out in teeming multitudes."},{"id":"manas-2010:p1002:b001:l042","ordinal":43872,"en":"‘They might turn back and flee,’ he said;"},{"id":"manas-2010:p1003:b001:l001","ordinal":43873,"en":"Leopard Bakay, behind them,"},{"id":"manas-2010:p1003:b001:l002","ordinal":43874,"en":"Went driving them on."},{"id":"manas-2010:p1003:b001:l003","ordinal":43875,"en":"Riding a horse like Sarala,"},{"id":"manas-2010:p1003:b001:l004","ordinal":43876,"en":"Wearing yellow leather trousers,"},{"id":"manas-2010:p1003:b001:l005","ordinal":43877,"en":"Taking a spear without a tassel,"},{"id":"manas-2010:p1003:b001:l006","ordinal":43878,"en":"Girded with a bare sword,"},{"id":"manas-2010:p1003:b001:l007","ordinal":43879,"en":"Cow-rumped Sarala"},{"id":"manas-2010:p1003:b001:l008","ordinal":43880,"en":"Stepped along at a slant."},{"id":"manas-2010:p1003:b001:l009","ordinal":43881,"en":"Toward Beijing, which he knew,"},{"id":"manas-2010:p1003:b001:l010","ordinal":43882,"en":"Lion-born Almambet"},{"id":"manas-2010:p1003:b001:l011","ordinal":43883,"en":"Led without mistaking the road."},{"id":"manas-2010:p1003:b001:l012","ordinal":43884,"en":"The spurs of endless mountains,"},{"id":"manas-2010:p1003:b001:l013","ordinal":43885,"en":"Almambet went straightening,"},{"id":"manas-2010:p1003:b001:l014","ordinal":43886,"en":"The spurs of swelling mountains."},{"id":"manas-2010:p1003:b001:l015","ordinal":43887,"en":"He would not depart from his given word."},{"id":"manas-2010:p1003:b001:l016","ordinal":43888,"en":"If he traveled in darkness,"},{"id":"manas-2010:p1003:b001:l017","ordinal":43889,"en":"The blue-maned one would not lose a corsac fox's track."},{"id":"manas-2010:p1003:b001:l018","ordinal":43890,"en":"No furrow drawn by a plow,"},{"id":"manas-2010:p1003:b001:l019","ordinal":43891,"en":"No burrow dug by a marmot,"},{"id":"manas-2010:p1003:b001:l020","ordinal":43892,"en":"Of the broad sandy plain"},{"id":"manas-2010:p1003:b001:l021","ordinal":43893,"en":"The army filled the throat as it traveled."},{"id":"manas-2010:p1003:b001:l022","ordinal":43894,"en":"No small band, a great army,"},{"id":"manas-2010:p1003:b001:l023","ordinal":43895,"en":"Went far, sparing no horse."},{"id":"manas-2010:p1003:b001:l024","ordinal":43896,"en":"Not lying down to rest at night,"},{"id":"manas-2010:p1003:b001:l025","ordinal":43897,"en":"Not taking their nighttime sleep,"},{"id":"manas-2010:p1003:b001:l026","ordinal":43898,"en":"Not resting in the daytime,"},{"id":"manas-2010:p1003:b001:l027","ordinal":43899,"en":"Not taking their daytime rest,"},{"id":"manas-2010:p1003:b001:l028","ordinal":43900,"en":"They traveled day and night."},{"id":"manas-2010:p1003:b001:l029","ordinal":43901,"en":"When his army left Talas,"},{"id":"manas-2010:p1003:b001:l030","ordinal":43902,"en":"When the days were put in writing,"},{"id":"manas-2010:p1003:b001:l031","ordinal":43903,"en":"When the journey was reckoned,"},{"id":"manas-2010:p1003:b001:l032","ordinal":43904,"en":"The nights were twenty,"},{"id":"manas-2010:p1003:b001:l033","ordinal":43905,"en":"The days were twenty."},{"id":"manas-2010:p1003:b001:l034","ordinal":43906,"en":"Traveling without wearying,"},{"id":"manas-2010:p1003:b001:l035","ordinal":43907,"en":"Going far without wearying,"},{"id":"manas-2010:p1003:b001:l036","ordinal":43908,"en":"Many horses grew exhausted."},{"id":"manas-2010:p1003:b001:l037","ordinal":43909,"en":"Of many called mighty,"},{"id":"manas-2010:p1003:b001:l038","ordinal":43910,"en":"The eyes were blinded by dust."},{"id":"manas-2010:p1003:b001:l039","ordinal":43911,"en":"Some, with troubled thoughts,"},{"id":"manas-2010:p1003:b001:l040","ordinal":43912,"en":"Went wandering on, exhausted."},{"id":"manas-2010:p1003:b001:l041","ordinal":43913,"en":"Some, worn out for lack of sleep,"},{"id":"manas-2010:p1003:b001:l042","ordinal":43914,"en":"‘If only I could take a short nap,’ they said,"},{"id":"manas-2010:p1004:b001:l001","ordinal":43915,"en":"Pleading with their leader,"},{"id":"manas-2010:p1004:b001:l002","ordinal":43916,"en":"Like an ill-fated woman,"},{"id":"manas-2010:p1004:b001:l003","ordinal":43917,"en":"They went on dozing."},{"id":"manas-2010:p1004:b001:l004","ordinal":43918,"en":"To those left behind:"},{"id":"manas-2010:p1004:b001:l005","ordinal":43919,"en":"‘You have fallen behind,’ they said."},{"id":"manas-2010:p1004:b001:l006","ordinal":43920,"en":"To those ahead, ‘Go, go,’ they said."},{"id":"manas-2010:p1004:b001:l007","ordinal":43921,"en":"Following close upon his tracks,"},{"id":"manas-2010:p1004:b001:l008","ordinal":43922,"en":"‘Your father's grave, the Chinese slave"},{"id":"manas-2010:p1004:b001:l009","ordinal":43923,"en":"Will drive us there and slaughter us,’ they said,"},{"id":"manas-2010:p1004:b001:l010","ordinal":43924,"en":"Speaking ill of Almambet."},{"id":"manas-2010:p1004:b001:l011","ordinal":43925,"en":"All the horses were exhausted."},{"id":"manas-2010:p1004:b001:l012","ordinal":43926,"en":"The great army followed behind,"},{"id":"manas-2010:p1004:b001:l013","ordinal":43927,"en":"Resentful of Almambet."},{"id":"manas-2010:p1004:b001:l014","ordinal":43928,"en":"‘We have not lain down at ease,’ they said."},{"id":"manas-2010:p1004:b001:l015","ordinal":43929,"en":"The twelve khans' great army"},{"id":"manas-2010:p1004:b001:l016","ordinal":43930,"en":"Went on in a mass."},{"id":"manas-2010:p1004:b001:l017","ordinal":43931,"en":"‘When will there be a rest?’ they said,"},{"id":"manas-2010:p1004:b001:l018","ordinal":43932,"en":"Distressed over Almambet."},{"id":"manas-2010:p1004:b001:l019","ordinal":43933,"en":"Day and night, for forty days,"},{"id":"manas-2010:p1004:b001:l020","ordinal":43934,"en":"Your Alma traveled with vigor."},{"id":"manas-2010:p1004:b001:l021","ordinal":43935,"en":"When did Almambet ever spare himself?"},{"id":"manas-2010:p1004:b001:l022","ordinal":43936,"en":"Undulating rises spread out,"},{"id":"manas-2010:p1004:b001:l023","ordinal":43937,"en":"Their twisting grass grew sparse,"},{"id":"manas-2010:p1004:b001:l024","ordinal":43938,"en":"The hills' grass grew sparse."},{"id":"manas-2010:p1004:b001:l025","ordinal":43939,"en":"Wild ewes and rams poured over them,"},{"id":"manas-2010:p1004:b001:l026","ordinal":43940,"en":"Deer grazed across the plains."},{"id":"manas-2010:p1004:b001:l027","ordinal":43941,"en":"Running together in herds,"},{"id":"manas-2010:p1004:b001:l028","ordinal":43942,"en":"The wild asses' hooves sank in."},{"id":"manas-2010:p1004:b001:l029","ordinal":43943,"en":"Broad Altay's broad valley,"},{"id":"manas-2010:p1004:b001:l030","ordinal":43944,"en":"A valley blessed in every way—"},{"id":"manas-2010:p1004:b001:l031","ordinal":43945,"en":"He reached the foot of Altay's mountains."},{"id":"manas-2010:p1004:b001:l032","ordinal":43946,"en":"There was snow upon its mountains,"},{"id":"manas-2010:p1004:b001:l033","ordinal":43947,"en":"Thick forest, dense woodland,"},{"id":"manas-2010:p1004:b001:l034","ordinal":43948,"en":"Lakes in many places."},{"id":"manas-2010:p1004:b001:l035","ordinal":43949,"en":"The great army of twelve hosts"},{"id":"manas-2010:p1004:b001:l036","ordinal":43950,"en":"Had room to lie down there."},{"id":"manas-2010:p1004:b001:l037","ordinal":43951,"en":"Khan Bakay, like a crane,"},{"id":"manas-2010:p1004:b001:l038","ordinal":43952,"en":"To Almambet in a rush"},{"id":"manas-2010:p1004:b001:l039","ordinal":43953,"en":"Had these words to say:"},{"id":"manas-2010:p1004:b001:l040","ordinal":43954,"en":"‘This great army that has come,"},{"id":"manas-2010:p1004:b001:l041","ordinal":43955,"en":"We have not even leaned upon an elbow."},{"id":"manas-2010:p1004:b001:l042","ordinal":43956,"en":"If we do not let them rest once,"},{"id":"manas-2010:p1005:b001:l001","ordinal":43957,"en":"How shall we reach Beijing, my Alma?!"},{"id":"manas-2010:p1005:b001:l002","ordinal":43958,"en":"If we go without stopping to Beijing,"},{"id":"manas-2010:p1005:b001:l003","ordinal":43959,"en":"The vast army on this journey,"},{"id":"manas-2010:p1005:b001:l004","ordinal":43960,"en":"We shall kill them all."},{"id":"manas-2010:p1005:b001:l005","ordinal":43961,"en":"If we go on in this way,"},{"id":"manas-2010:p1005:b001:l006","ordinal":43962,"en":"This great army that has come,"},{"id":"manas-2010:p1005:b001:l007","ordinal":43963,"en":"We shall bear guilt for their suffering!’"},{"id":"manas-2010:p1005:b001:l008","ordinal":43964,"en":"Sheep-eyed, without pale irises,"},{"id":"manas-2010:p1005:b001:l009","ordinal":43965,"en":"White-faced, without freckles,"},{"id":"manas-2010:p1005:b001:l010","ordinal":43966,"en":"Azizkan's devastating one,"},{"id":"manas-2010:p1005:b001:l011","ordinal":43967,"en":"The fortress of that army,"},{"id":"manas-2010:p1005:b001:l012","ordinal":43968,"en":"When he heard Bakay's words, said:"},{"id":"manas-2010:p1005:b001:l013","ordinal":43969,"en":"‘If that is so, elder,"},{"id":"manas-2010:p1005:b001:l014","ordinal":43970,"en":"In the broad spreading valley"},{"id":"manas-2010:p1005:b001:l015","ordinal":43971,"en":"Let them lie down and sleep their fill."},{"id":"manas-2010:p1005:b001:l016","ordinal":43972,"en":"Let their steeds graze on grass."},{"id":"manas-2010:p1005:b001:l017","ordinal":43973,"en":"What Kanykey prepared for them,"},{"id":"manas-2010:p1005:b001:l018","ordinal":43974,"en":"The dried travel provisions they have kept,"},{"id":"manas-2010:p1005:b001:l019","ordinal":43975,"en":"Let them quench their thirst.’"},{"id":"manas-2010:p1005:b001:l020","ordinal":43976,"en":"Lion-born Almambet,"},{"id":"manas-2010:p1005:b001:l021","ordinal":43977,"en":"When he ordered them to lie down,"},{"id":"manas-2010:p1005:b001:l022","ordinal":43978,"en":"They dismounted in teeming numbers."},{"id":"manas-2010:p1005:b001:l023","ordinal":43979,"en":"All together, the great army"},{"id":"manas-2010:p1005:b001:l024","ordinal":43980,"en":"Dismounted in a mass."},{"id":"manas-2010:p1005:b001:l025","ordinal":43981,"en":"All ran alike,"},{"id":"manas-2010:p1005:b001:l026","ordinal":43982,"en":"Made ready their traveling pots."},{"id":"manas-2010:p1005:b001:l027","ordinal":43983,"en":"The steeds that would travel far,"},{"id":"manas-2010:p1005:b001:l028","ordinal":43984,"en":"They tethered here and there."},{"id":"manas-2010:p1005:b001:l029","ordinal":43985,"en":"They boiled their food,"},{"id":"manas-2010:p1005:b001:l030","ordinal":43986,"en":"Slaughtered a mare at each camp."},{"id":"manas-2010:p1005:b001:l031","ordinal":43987,"en":"The slaughtered mares' meat"},{"id":"manas-2010:p1005:b001:l032","ordinal":43988,"en":"They divided in measured portions per man."},{"id":"manas-2010:p1005:b001:l033","ordinal":43989,"en":"The great army fell asleep;"},{"id":"manas-2010:p1005:b001:l034","ordinal":43990,"en":"That was where they lay down."},{"id":"manas-2010:p1005:b001:l035","ordinal":43991,"en":"All the horses were grazing."},{"id":"manas-2010:p1005:b001:l036","ordinal":43992,"en":"The young men tending them"},{"id":"manas-2010:p1005:b001:l037","ordinal":43993,"en":"Lay down beside them,"},{"id":"manas-2010:p1005:b001:l038","ordinal":43994,"en":"Arms and legs stretched out,"},{"id":"manas-2010:p1005:b001:l039","ordinal":43995,"en":"Resting their heads upon battle-axes,"},{"id":"manas-2010:p1005:b001:l040","ordinal":43996,"en":"Their heads turned toward Mecca."},{"id":"manas-2010:p1005:b001:l041","ordinal":43997,"en":"The forty companions slept their fill,"},{"id":"manas-2010:p1005:b001:l042","ordinal":43998,"en":"Set out the knucklebone game in the middle,"},{"id":"manas-2010:p1006:b001:l001","ordinal":43999,"en":"They marked out forty foot-lengths of ground."},{"id":"manas-2010:p1006:b001:l002","ordinal":44000,"en":"All joined in eagerly,"},{"id":"manas-2010:p1006:b001:l003","ordinal":44001,"en":"Prepared stone shooting-pieces,"},{"id":"manas-2010:p1006:b001:l004","ordinal":44002,"en":"Chose those who would break the central cluster,"},{"id":"manas-2010:p1006:b001:l005","ordinal":44003,"en":"Staked one set of nine as the prize,"},{"id":"manas-2010:p1006:b001:l006","ordinal":44004,"en":"Lined them up and made their wager."},{"id":"manas-2010:p1006:b001:l007","ordinal":44005,"en":"Shouting hurrahs, raising dust,"},{"id":"manas-2010:p1006:b001:l008","ordinal":44006,"en":"Adjusting their close-range flicks,"},{"id":"manas-2010:p1006:b001:l009","ordinal":44007,"en":"The forty companions stayed there."},{"id":"manas-2010:p1006:b001:l010","ordinal":44008,"en":"The warriors who had grown bored"},{"id":"manas-2010:p1006:b001:l011","ordinal":44009,"en":"All played together."},{"id":"manas-2010:p1006:b001:l012","ordinal":44010,"en":"Hero Koshoi, Khan Bakay,"},{"id":"manas-2010:p1006:b001:l013","ordinal":44011,"en":"And sitting between them,"},{"id":"manas-2010:p1006:b001:l014","ordinal":44012,"en":"Valiant Manas loomed great."},{"id":"manas-2010:p1006:b001:l015","ordinal":44013,"en":"Bakay began to speak,"},{"id":"manas-2010:p1006:b001:l016","ordinal":44014,"en":"Spoke softly, setting down firm words:"},{"id":"manas-2010:p1006:b001:l017","ordinal":44015,"en":"‘The barren desert of It-Ölbös—"},{"id":"manas-2010:p1006:b001:l018","ordinal":44016,"en":"Is there a companion who has trotted through it?"},{"id":"manas-2010:p1006:b001:l019","ordinal":44017,"en":"The solitary ridge of Zhapalak—"},{"id":"manas-2010:p1006:b001:l020","ordinal":44018,"en":"Is there a companion who has seen it?"},{"id":"manas-2010:p1006:b001:l021","ordinal":44019,"en":"Great Beijing, where Alexander would not go—"},{"id":"manas-2010:p1006:b001:l022","ordinal":44020,"en":"Is there a companion who has gone there?"},{"id":"manas-2010:p1006:b001:l023","ordinal":44021,"en":"Teshik-Tash of the gray night—"},{"id":"manas-2010:p1006:b001:l024","ordinal":44022,"en":"Is there a companion who has passed through?"},{"id":"manas-2010:p1006:b001:l025","ordinal":44023,"en":"The roaring Sary-Suu—"},{"id":"manas-2010:p1006:b001:l026","ordinal":44024,"en":"Is there a companion who has forded it?"},{"id":"manas-2010:p1006:b001:l027","ordinal":44025,"en":"The valley of Kyr-Kayyng—"},{"id":"manas-2010:p1006:b001:l028","ordinal":44026,"en":"Is there a companion who has seen it?"},{"id":"manas-2010:p1006:b001:l029","ordinal":44027,"en":"Having truly seen Beijing,"},{"id":"manas-2010:p1006:b001:l030","ordinal":44028,"en":"Is there a companion who has returned?"},{"id":"manas-2010:p1006:b001:l031","ordinal":44029,"en":"A lacquered spear upon his arm—"},{"id":"manas-2010:p1006:b001:l032","ordinal":44030,"en":"Is there a companion who has hung one there?"},{"id":"manas-2010:p1006:b001:l033","ordinal":44031,"en":"Kakanchyn's Beijing—"},{"id":"manas-2010:p1006:b001:l034","ordinal":44032,"en":"Is there a companion who knows it?"}]
