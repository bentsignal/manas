[{"id":"seytek-2012:p0823:b002:l020","ordinal":358401,"en":"The holy wanderer Kydyr"},{"id":"seytek-2012:p0823:b002:l021","ordinal":358402,"en":"Led it by the bridle;"},{"id":"seytek-2012:p0823:b002:l022","ordinal":358403,"en":"Good fortune and prosperity flourished,"},{"id":"seytek-2012:p0823:b002:l023","ordinal":358404,"en":"The steed’s dark shape remained,"},{"id":"seytek-2012:p0823:b002:l024","ordinal":358405,"en":"Its cry splitting stone,"},{"id":"seytek-2012:p0823:b002:l025","ordinal":358406,"en":"My father, upheld by the forty saints,"},{"id":"seytek-2012:p0823:b002:l026","ordinal":358407,"en":"Shouted his battle cry,"},{"id":"seytek-2012:p0823:b002:l027","ordinal":358408,"en":"Raising the cry of “Manas!”"},{"id":"seytek-2012:p0823:b002:l028","ordinal":358409,"en":"“Boy Seytek and Külchoro,"},{"id":"seytek-2012:p0823:b002:l029","ordinal":358410,"en":"And Kuyaly, the lion-maiden—"},{"id":"seytek-2012:p0823:b002:l030","ordinal":358411,"en":"This swine has challenged you!"},{"id":"seytek-2012:p0823:b002:l031","ordinal":358412,"en":"Seize him, seize him!” he cried,"},{"id":"seytek-2012:p0823:b002:l032","ordinal":358413,"en":"“Grip your spears and thrust!"},{"id":"seytek-2012:p0823:b002:l033","ordinal":358414,"en":"Meet him and grapple,"},{"id":"seytek-2012:p0823:b002:l034","ordinal":358415,"en":"Strip the swaggering swine"},{"id":"seytek-2012:p0823:b002:l035","ordinal":358416,"en":"Who came so boldly"},{"id":"seytek-2012:p0823:b002:l036","ordinal":358417,"en":"And bring his death upon him!"},{"id":"seytek-2012:p0823:b002:l037","ordinal":358418,"en":"With piercing shouts and ringing cries,"},{"id":"seytek-2012:p0823:b002:l038","ordinal":358419,"en":"Fight wherever you meet,"},{"id":"seytek-2012:p0823:b002:l039","ordinal":358420,"en":"Cut down all you encounter,"},{"id":"seytek-2012:p0823:b002:l040","ordinal":358421,"en":"And take revenge for old grudges."},{"id":"seytek-2012:p0823:b003:l001","ordinal":358422,"en":"Through the wrath of the turmoil he raised,"},{"id":"seytek-2012:p0823:b003:l002","ordinal":358423,"en":"Some innocent souls"},{"id":"seytek-2012:p0823:b003:l003","ordinal":358424,"en":"Died before their destined time."},{"id":"seytek-2012:p0823:b003:l004","ordinal":358425,"en":"The land of no return, the true abode,"},{"id":"seytek-2012:p0823:b003:l005","ordinal":358426,"en":"Many a meek and living soul"},{"id":"seytek-2012:p0823:b003:l006","ordinal":358427,"en":"Reached because of Sarybay."},{"id":"seytek-2012:p0823:b003:l007","ordinal":358428,"en":"Khans died though guiltless,"},{"id":"seytek-2012:p0823:b003:l008","ordinal":358429,"en":"Many wrestlers and giants died;"},{"id":"seytek-2012:p0823:b003:l009","ordinal":358430,"en":"He quenched the fire"},{"id":"seytek-2012:p0823:b003:l010","ordinal":358431,"en":"Of the Kyrgyz in Talas,"},{"id":"seytek-2012:p0823:b003:l011","ordinal":358432,"en":"Drove them all away,"},{"id":"seytek-2012:p0823:b003:l012","ordinal":358433,"en":"Slaughtered multitudes,"},{"id":"seytek-2012:p0823:b003:l013","ordinal":358434,"en":"And brought misery upon many."},{"id":"seytek-2012:p0823:b003:l014","ordinal":358435,"en":"Such grievous hardship and great turmoil"},{"id":"seytek-2012:p0823:b003:l015","ordinal":358436,"en":"Had befallen the Kyrgyz."},{"id":"seytek-2012:p0823:b003:l016","ordinal":358437,"en":"Have you heard tell of yesterday,"},{"id":"seytek-2012:p0823:b003:l017","ordinal":358438,"en":"When Khan Semetey, the falcon hero,"},{"id":"seytek-2012:p0823:b003:l018","ordinal":358439,"en":"Dwelt in his palace in Keng-Kol"},{"id":"seytek-2012:p0823:b003:l019","ordinal":358440,"en":"And tethered his fourteen steeds?"},{"id":"seytek-2012:p0823:b003:l020","ordinal":358441,"en":"Whenever hostile foes came shooting,"},{"id":"seytek-2012:p0823:b003:l021","ordinal":358442,"en":"He drove them before him."},{"id":"seytek-2012:p0823:b003:l022","ordinal":358443,"en":"Whoever provoked his anger,"},{"id":"seytek-2012:p0823:b003:l023","ordinal":358444,"en":"He crushed between his fangs."},{"id":"seytek-2012:p0823:b003:l024","ordinal":358445,"en":"In valor and lionheartedness,"},{"id":"seytek-2012:p0823:b003:l025","ordinal":358446,"en":"Strong-souled and fiercely brave,"},{"id":"seytek-2012:p0823:b003:l026","ordinal":358447,"en":"A master wrestler, a peerless hero,"},{"id":"seytek-2012:p0823:b003:l027","ordinal":358448,"en":"He threw the whole world into confusion,"},{"id":"seytek-2012:p0823:b003:l028","ordinal":358449,"en":"Making the white courser beneath him"},{"id":"seytek-2012:p0823:b003:l029","ordinal":358450,"en":"Stride proudly onward."},{"id":"seytek-2012:p0823:b003:l030","ordinal":358451,"en":"He robbed every confronting enemy"},{"id":"seytek-2012:p0823:b003:l031","ordinal":358452,"en":"Of strength and fortune."},{"id":"seytek-2012:p0823:b003:l032","ordinal":358453,"en":"When he made arrows rain like a storm,"},{"id":"seytek-2012:p0823:b003:l033","ordinal":358454,"en":"No enemy ever returned."},{"id":"seytek-2012:p0823:b003:l034","ordinal":358455,"en":"The great Manas, surpassing lion,"},{"id":"seytek-2012:p0823:b003:l035","ordinal":358456,"en":"Appeared in spirit;"},{"id":"seytek-2012:p0823:b003:l036","ordinal":358457,"en":"The minds of mortal men"},{"id":"seytek-2012:p0823:b003:l037","ordinal":358458,"en":"Reeled in astonishment,"},{"id":"seytek-2012:p0823:b003:l038","ordinal":358459,"en":"As he made the matchless steed Akkula"},{"id":"seytek-2012:p0823:b003:l039","ordinal":358460,"en":"Stride proudly onward."},{"id":"seytek-2012:p0824:b002:l001","ordinal":358461,"en":"“Make the roadside a battlefield,"},{"id":"seytek-2012:p0824:b002:l002","ordinal":358462,"en":"And drive them against the Danggits!"},{"id":"seytek-2012:p0824:b002:l003","ordinal":358463,"en":"Turn back the riverlands"},{"id":"seytek-2012:p0824:b002:l004","ordinal":358464,"en":"Of that overbearing swine!"},{"id":"seytek-2012:p0824:b002:l005","ordinal":358465,"en":"Wage war until death"},{"id":"seytek-2012:p0824:b002:l006","ordinal":358466,"en":"Against the swine who attacked you!"},{"id":"seytek-2012:p0824:b002:l007","ordinal":358467,"en":"Drive them, children, drive!” he cried,"},{"id":"seytek-2012:p0824:b002:l008","ordinal":358468,"en":"“Overturn and destroy them,"},{"id":"seytek-2012:p0824:b002:l009","ordinal":358469,"en":"And finish Sarybay!”"},{"id":"seytek-2012:p0824:b002:l010","ordinal":358470,"en":"His brow was grim, his venom strong;"},{"id":"seytek-2012:p0824:b002:l011","ordinal":358471,"en":"He leveled any who assailed him."},{"id":"seytek-2012:p0824:b002:l012","ordinal":358472,"en":"When his raging fury seized him,"},{"id":"seytek-2012:p0824:b002:l013","ordinal":358473,"en":"The gray-maned hero was no easy foe."},{"id":"seytek-2012:p0824:b002:l014","ordinal":358474,"en":"He could spread slaughter through the world,"},{"id":"seytek-2012:p0824:b002:l015","ordinal":358475,"en":"And when his wrath grew fierce,"},{"id":"seytek-2012:p0824:b002:l016","ordinal":358476,"en":"He would leave not one Chinese soul,"},{"id":"seytek-2012:p0824:b002:l017","ordinal":358477,"en":"But slaughter them outright."},{"id":"seytek-2012:p0824:b002:l018","ordinal":358478,"en":"Black-hearted and blue-gray without,"},{"id":"seytek-2012:p0824:b002:l019","ordinal":358479,"en":"He was an unpredictable leopard."},{"id":"seytek-2012:p0824:b002:l020","ordinal":358480,"en":"At the sight, the heart was shaken:"},{"id":"seytek-2012:p0824:b002:l021","ordinal":358481,"en":"The spirit of gray-maned Manas"},{"id":"seytek-2012:p0824:b002:l022","ordinal":358482,"en":"Appeared as though alive."},{"id":"seytek-2012:p0824:b002:l023","ordinal":358483,"en":"The whole world stirred;"},{"id":"seytek-2012:p0824:b002:l024","ordinal":358484,"en":"His silhouette seemed a boundless lake,"},{"id":"seytek-2012:p0824:b002:l025","ordinal":358485,"en":"His eyes burned like embers,"},{"id":"seytek-2012:p0824:b002:l026","ordinal":358486,"en":"His shout was fire,"},{"id":"seytek-2012:p0824:b002:l027","ordinal":358487,"en":"His figure vast beyond measure."},{"id":"seytek-2012:p0824:b002:l028","ordinal":358488,"en":"Gray-maned Manas, the leopard,"},{"id":"seytek-2012:p0824:b002:l029","ordinal":358489,"en":"Joined those three"},{"id":"seytek-2012:p0824:b002:l030","ordinal":358490,"en":"As their companion, that magnanimous lion,"},{"id":"seytek-2012:p0824:b002:l031","ordinal":358491,"en":"And himself pursued the foe."},{"id":"seytek-2012:p0824:b002:l032","ordinal":358492,"en":"“Drive them, children, drive!” he cried,"},{"id":"seytek-2012:p0824:b002:l033","ordinal":358493,"en":"“Seize the monster’s son!"},{"id":"seytek-2012:p0824:b002:l034","ordinal":358494,"en":"He will not heed my pleas—"},{"id":"seytek-2012:p0824:b002:l035","ordinal":358495,"en":"Strike your spears into his waist!"},{"id":"seytek-2012:p0824:b002:l036","ordinal":358496,"en":"Wage true war,"},{"id":"seytek-2012:p0824:b002:l037","ordinal":358497,"en":"Cut him down and finish him!"},{"id":"seytek-2012:p0824:b002:l038","ordinal":358498,"en":"Stand face-to-face,"},{"id":"seytek-2012:p0824:b002:l039","ordinal":358499,"en":"Raise the battle cry of ‘Manas!’"},{"id":"seytek-2012:p0824:b002:l040","ordinal":358500,"en":"And unleash a dreadful battle!"},{"id":"seytek-2012:p0824:b003:l001","ordinal":358501,"en":"Drive them, children, drive!” he cried,"},{"id":"seytek-2012:p0824:b003:l002","ordinal":358502,"en":"And noble Manas, the beloved lion,"},{"id":"seytek-2012:p0824:b003:l003","ordinal":358503,"en":"Himself shouted encouragement."},{"id":"seytek-2012:p0824:b003:l004","ordinal":358504,"en":"They seemed an army beyond counting;"},{"id":"seytek-2012:p0824:b003:l005","ordinal":358505,"en":"Your heroic father, brave Manas,"},{"id":"seytek-2012:p0824:b003:l006","ordinal":358506,"en":"Joined the three tempestuous warriors"},{"id":"seytek-2012:p0824:b003:l007","ordinal":358507,"en":"As their companion."},{"id":"seytek-2012:p0824:b003:l008","ordinal":358508,"en":"Behind them the beloved lion"},{"id":"seytek-2012:p0824:b003:l009","ordinal":358509,"en":"Appeared in human form,"},{"id":"seytek-2012:p0824:b003:l010","ordinal":358510,"en":"And the mind of anyone who looked closely"},{"id":"seytek-2012:p0824:b003:l011","ordinal":358511,"en":"Reeled in astonishment."},{"id":"seytek-2012:p0824:b003:l012","ordinal":358512,"en":"From the edge of the northern quarter came one"},{"id":"seytek-2012:p0824:b003:l013","ordinal":358513,"en":"Who spared no life in battle"},{"id":"seytek-2012:p0824:b003:l014","ordinal":358514,"en":"And never drank his fill of blood;"},{"id":"seytek-2012:p0824:b003:l015","ordinal":358515,"en":"Who broke through dead ends and opened roads,"},{"id":"seytek-2012:p0824:b003:l016","ordinal":358516,"en":"And when countless enemies came,"},{"id":"seytek-2012:p0824:b003:l017","ordinal":358517,"en":"Charged straight into their midst;"},{"id":"seytek-2012:p0824:b003:l018","ordinal":358518,"en":"Who never recoiled from glowing embers"},{"id":"seytek-2012:p0824:b003:l019","ordinal":358519,"en":"Nor flinched and fled from flame;"},{"id":"seytek-2012:p0824:b003:l020","ordinal":358520,"en":"A master horseman, watchful on the road—"},{"id":"seytek-2012:p0824:b003:l021","ordinal":358521,"en":"Syrgak, warrior of the magnanimous lion,"},{"id":"seytek-2012:p0824:b003:l022","ordinal":358522,"en":"Who never drew back once he thrust,"},{"id":"seytek-2012:p0824:b003:l023","ordinal":358523,"en":"Never lost the trail of the dejected,"},{"id":"seytek-2012:p0824:b003:l024","ordinal":358524,"en":"And in darkness never mistook"},{"id":"seytek-2012:p0824:b003:l025","ordinal":358525,"en":"Or missed a shadow’s track."},{"id":"seytek-2012:p0824:b003:l026","ordinal":358526,"en":"Broad-bodied and short in stature,"},{"id":"seytek-2012:p0824:b003:l027","ordinal":358527,"en":"His whole frame was black stone;"},{"id":"seytek-2012:p0824:b003:l028","ordinal":358528,"en":"Thick-armed and stone-hearted,"},{"id":"seytek-2012:p0824:b003:l029","ordinal":358529,"en":"A sturdy, well-built giant."},{"id":"seytek-2012:p0824:b003:l030","ordinal":358530,"en":"He raised his socketed spear"},{"id":"seytek-2012:p0824:b003:l031","ordinal":358531,"en":"High above him,"},{"id":"seytek-2012:p0824:b003:l032","ordinal":358532,"en":"And from hosts that closed in combat"},{"id":"seytek-2012:p0824:b003:l033","ordinal":358533,"en":"He never stirred or retreated."},{"id":"seytek-2012:p0824:b003:l034","ordinal":358534,"en":"Whoever came within his reach,"},{"id":"seytek-2012:p0824:b003:l035","ordinal":358535,"en":"He crushed into the earth like a sheep."},{"id":"seytek-2012:p0824:b003:l036","ordinal":358536,"en":"When black muskets cracked"},{"id":"seytek-2012:p0824:b003:l037","ordinal":358537,"en":"And fierce matchlocks snapped,"},{"id":"seytek-2012:p0824:b003:l038","ordinal":358538,"en":"He never started or drew back."},{"id":"seytek-2012:p0824:b003:l039","ordinal":358539,"en":"Before enemies pouring upon him,"},{"id":"seytek-2012:p0824:b003:l040","ordinal":358540,"en":"He never retreated in fear."},{"id":"seytek-2012:p0825:b002:l001","ordinal":358541,"en":"He faced giants and ogres,"},{"id":"seytek-2012:p0825:b002:l002","ordinal":358542,"en":"And none he fought escaped alive."},{"id":"seytek-2012:p0825:b002:l003","ordinal":358543,"en":"Breaking away with some forty warriors,"},{"id":"seytek-2012:p0825:b002:l004","ordinal":358544,"en":"Brave Syrgak of Khan Ulak"},{"id":"seytek-2012:p0825:b002:l005","ordinal":358545,"en":"Appeared, stunning the mind,"},{"id":"seytek-2012:p0825:b002:l006","ordinal":358546,"en":"As though alive;"},{"id":"seytek-2012:p0825:b002:l007","ordinal":358547,"en":"He shouted, “Hero!”"},{"id":"seytek-2012:p0825:b002:l008","ordinal":358548,"en":"And called out for Külchoro."},{"id":"seytek-2012:p0825:b002:l009","ordinal":358549,"en":"No soul could withstand his wrath;"},{"id":"seytek-2012:p0825:b002:l010","ordinal":358550,"en":"Genial Syrgak, the lion hero,"},{"id":"seytek-2012:p0825:b002:l011","ordinal":358551,"en":"Again leveled his spear."},{"id":"seytek-2012:p0825:b002:l012","ordinal":358552,"en":"To the three in that battle,"},{"id":"seytek-2012:p0825:b002:l013","ordinal":358553,"en":"He gave his aid as a comrade."},{"id":"seytek-2012:p0825:b002:l014","ordinal":358554,"en":"If you looked to this side,"},{"id":"seytek-2012:p0825:b002:l015","ordinal":358555,"en":"There rode one upon Aisarala."},{"id":"seytek-2012:p0825:b002:l016","ordinal":358556,"en":"Though foes were tens of thousands,"},{"id":"seytek-2012:p0825:b002:l017","ordinal":358557,"en":"He swept them away in every battle."},{"id":"seytek-2012:p0825:b002:l018","ordinal":358558,"en":"He wore yellow rawhide trousers,"},{"id":"seytek-2012:p0825:b002:l019","ordinal":358559,"en":"Bore a spear without a tassel,"},{"id":"seytek-2012:p0825:b002:l020","ordinal":358560,"en":"And girded a sword without a sheath,"},{"id":"seytek-2012:p0825:b002:l021","ordinal":358561,"en":"Biting hard upon his lip."},{"id":"seytek-2012:p0825:b002:l022","ordinal":358562,"en":"He wound his sash around his waist"},{"id":"seytek-2012:p0825:b002:l023","ordinal":358563,"en":"And cast the world into tumult."},{"id":"seytek-2012:p0825:b002:l024","ordinal":358564,"en":"Tall and broad-shouldered,"},{"id":"seytek-2012:p0825:b002:l025","ordinal":358565,"en":"Both wrestler and lion,"},{"id":"seytek-2012:p0825:b002:l026","ordinal":358566,"en":"From the city of the Khakhan"},{"id":"seytek-2012:p0825:b002:l027","ordinal":358567,"en":"Came this fierce lion from China."},{"id":"seytek-2012:p0825:b002:l028","ordinal":358568,"en":"The mighty hero gave a shout;"},{"id":"seytek-2012:p0825:b002:l029","ordinal":358569,"en":"The earth broke and heaved,"},{"id":"seytek-2012:p0825:b002:l030","ordinal":358570,"en":"As though seven thousand troops had come."},{"id":"seytek-2012:p0825:b002:l031","ordinal":358571,"en":"Straining like a lion,"},{"id":"seytek-2012:p0825:b002:l032","ordinal":358572,"en":"He readied and leveled his spear,"},{"id":"seytek-2012:p0825:b002:l033","ordinal":358573,"en":"Shouting from the front,"},{"id":"seytek-2012:p0825:b002:l034","ordinal":358574,"en":"Calling to the hero Külchoro,"},{"id":"seytek-2012:p0825:b002:l035","ordinal":358575,"en":"His only son."},{"id":"seytek-2012:p0825:b002:l036","ordinal":358576,"en":"Power rang from his battle cry,"},{"id":"seytek-2012:p0825:b002:l037","ordinal":358577,"en":"And from the fire on either side"},{"id":"seytek-2012:p0825:b002:l038","ordinal":358578,"en":"Hair enough for socks was singed away."},{"id":"seytek-2012:p0825:b002:l039","ordinal":358579,"en":"The hero Külchoro"},{"id":"seytek-2012:p0825:b002:l040","ordinal":358580,"en":"Was accompanied by your uncle."},{"id":"seytek-2012:p0825:b004:l001","ordinal":358581,"en":"Raging and charging,"},{"id":"seytek-2012:p0825:b004:l002","ordinal":358582,"en":"He prepared to face the foe."},{"id":"seytek-2012:p0825:b004:l003","ordinal":358583,"en":"“My broad-shouldered uncle Külchoro,"},{"id":"seytek-2012:p0825:b004:l004","ordinal":358584,"en":"You are a spring flowing down the valley,"},{"id":"seytek-2012:p0825:b004:l005","ordinal":358585,"en":"A lamp seen among the people."},{"id":"seytek-2012:p0825:b004:l006","ordinal":358586,"en":"You are a legacy left by a hero,"},{"id":"seytek-2012:p0825:b004:l007","ordinal":358587,"en":"A noble one remaining as his sign."},{"id":"seytek-2012:p0825:b004:l008","ordinal":358588,"en":"The fierce enemy Sarybay"},{"id":"seytek-2012:p0825:b004:l009","ordinal":358589,"en":"Has battled you beyond capture;"},{"id":"seytek-2012:p0825:b004:l010","ordinal":358590,"en":"Alas, how fares my son?” he cried."},{"id":"seytek-2012:p0825:b004:l011","ordinal":358591,"en":"Taking a shortcut along the narrow path,"},{"id":"seytek-2012:p0825:b004:l012","ordinal":358592,"en":"From before his khanly nephew,"},{"id":"seytek-2012:p0825:b004:l013","ordinal":358593,"en":"He led Buurul, the horse ridden to battle,"},{"id":"seytek-2012:p0825:b004:l014","ordinal":358594,"en":"Urging it hurriedly onward,"},{"id":"seytek-2012:p0825:b004:l015","ordinal":358595,"en":"And shouted encouragement."},{"id":"seytek-2012:p0825:b004:l016","ordinal":358596,"en":"The mighty hero whose patron spirit lived,"},{"id":"seytek-2012:p0825:b004:l017","ordinal":358597,"en":"The lord supported by the holy spirits,"},{"id":"seytek-2012:p0825:b004:l018","ordinal":358598,"en":"Himself accompanied him."},{"id":"seytek-2012:p0825:b004:l019","ordinal":358599,"en":"The Sarala beneath him"},{"id":"seytek-2012:p0825:b004:l020","ordinal":358600,"en":"Shone as though touched by moonlight;"},{"id":"seytek-2012:p0825:b004:l021","ordinal":358601,"en":"A red banner with a golden crescent"},{"id":"seytek-2012:p0825:b004:l022","ordinal":358602,"en":"Fluttered in his hand."},{"id":"seytek-2012:p0825:b004:l023","ordinal":358603,"en":"“Charge, my son, charge!” he cried,"},{"id":"seytek-2012:p0825:b004:l024","ordinal":358604,"en":"“Hold your spear ready!"},{"id":"seytek-2012:p0825:b004:l025","ordinal":358605,"en":"Let me see what troubles you."},{"id":"seytek-2012:p0825:b004:l026","ordinal":358606,"en":"Against Sarybay, whom you must fight,"},{"id":"seytek-2012:p0825:b004:l027","ordinal":358607,"en":"Clashing and thrusting,"},{"id":"seytek-2012:p0825:b004:l028","ordinal":358608,"en":"I shall stand beside you."},{"id":"seytek-2012:p0825:b004:l029","ordinal":358609,"en":"Let me see the measure"},{"id":"seytek-2012:p0825:b004:l030","ordinal":358610,"en":"Of that swine Sarybay!"},{"id":"seytek-2012:p0825:b004:l031","ordinal":358611,"en":"You were a hero, you were a lion,"},{"id":"seytek-2012:p0825:b004:l032","ordinal":358612,"en":"A warrior who knew the enemy’s ways."},{"id":"seytek-2012:p0825:b004:l033","ordinal":358613,"en":"Level your spear and break their ranks;"},{"id":"seytek-2012:p0825:b004:l034","ordinal":358614,"en":"In fury, drive the enemy away!"},{"id":"seytek-2012:p0825:b004:l035","ordinal":358615,"en":"Your heroic father is beside you—"},{"id":"seytek-2012:p0825:b004:l036","ordinal":358616,"en":"Now unleash true slaughter!"},{"id":"seytek-2012:p0825:b004:l037","ordinal":358617,"en":"Sarybay, who has challenged us,"},{"id":"seytek-2012:p0825:b004:l038","ordinal":358618,"en":"Has shown his enmity thus."},{"id":"seytek-2012:p0825:b004:l039","ordinal":358619,"en":"Do not spare your precious life,"},{"id":"seytek-2012:p0825:b004:l040","ordinal":358620,"en":"Do not glance to either side."},{"id":"seytek-2012:p0826:b002:l001","ordinal":358621,"en":"Level your spear and thrust it home,"},{"id":"seytek-2012:p0826:b002:l002","ordinal":358622,"en":"Drive your spear in till it drips with blood,"},{"id":"seytek-2012:p0826:b002:l003","ordinal":358623,"en":"Pierce both his eyes!"},{"id":"seytek-2012:p0826:b002:l004","ordinal":358624,"en":"That swaggering brute,"},{"id":"seytek-2012:p0826:b002:l005","ordinal":358625,"en":"That thick-armed would-be wrestler,"},{"id":"seytek-2012:p0826:b002:l006","ordinal":358626,"en":"Has raised this great commotion from the start."},{"id":"seytek-2012:p0826:b002:l007","ordinal":358627,"en":"Rip open his belly like a donkey’s!"},{"id":"seytek-2012:p0826:b002:l008","ordinal":358628,"en":"Choose your opening and thrust without wavering,"},{"id":"seytek-2012:p0826:b002:l009","ordinal":358629,"en":"Drive it home before he can flinch,"},{"id":"seytek-2012:p0826:b002:l010","ordinal":358630,"en":"Twist the spear in openly,"},{"id":"seytek-2012:p0826:b002:l011","ordinal":358631,"en":"Watch him closely and strike!"},{"id":"seytek-2012:p0826:b002:l012","ordinal":358632,"en":"Tear the flesh from the shins"},{"id":"seytek-2012:p0826:b002:l013","ordinal":358633,"en":"Of that raging swine."},{"id":"seytek-2012:p0826:b002:l014","ordinal":358634,"en":"Keep clear of the crush and thrust,"},{"id":"seytek-2012:p0826:b002:l015","ordinal":358635,"en":"Face him without fear and thrust!"},{"id":"seytek-2012:p0826:b002:l016","ordinal":358636,"en":"Let dust rise where your spear strikes,"},{"id":"seytek-2012:p0826:b002:l017","ordinal":358637,"en":"Let blood gush where your fist falls,"},{"id":"seytek-2012:p0826:b002:l018","ordinal":358638,"en":"Let life flow mingled with the blood!"},{"id":"seytek-2012:p0826:b002:l019","ordinal":358639,"en":"Let the true spear reach its mark,"},{"id":"seytek-2012:p0826:b002:l020","ordinal":358640,"en":"And let not a scrap of the swine remain—"},{"id":"seytek-2012:p0826:b002:l021","ordinal":358641,"en":"Let them all be ground to dust!"},{"id":"seytek-2012:p0826:b002:l022","ordinal":358642,"en":"Thrust with unblinking eyes,"},{"id":"seytek-2012:p0826:b002:l023","ordinal":358643,"en":"Gather all your wisdom and strength,"},{"id":"seytek-2012:p0826:b002:l024","ordinal":358644,"en":"And at that gaudy swine"},{"id":"seytek-2012:p0826:b002:l025","ordinal":358645,"en":"Strike swiftly till he topples."},{"id":"seytek-2012:p0826:b002:l026","ordinal":358646,"en":"Aim carefully and thrust,"},{"id":"seytek-2012:p0826:b002:l027","ordinal":358647,"en":"Aim for the place that brings death."},{"id":"seytek-2012:p0826:b002:l028","ordinal":358648,"en":"Choose his flank and thrust;"},{"id":"seytek-2012:p0826:b002:l029","ordinal":358649,"en":"Strike surely, not as he does."},{"id":"seytek-2012:p0826:b002:l030","ordinal":358650,"en":"Let me see the grievous wrath"},{"id":"seytek-2012:p0826:b002:l031","ordinal":358651,"en":"Of that swaggering swine."},{"id":"seytek-2012:p0826:b002:l032","ordinal":358652,"en":"You have fought many times"},{"id":"seytek-2012:p0826:b002:l033","ordinal":358653,"en":"Against that strong-armed swine;"},{"id":"seytek-2012:p0826:b002:l034","ordinal":358654,"en":"My heroic son Külchoro,"},{"id":"seytek-2012:p0826:b002:l035","ordinal":358655,"en":"Let me stand as your support."},{"id":"seytek-2012:p0826:b002:l036","ordinal":358656,"en":"Do not look around you;"}]
