[{"id":"manas-2010:p1606:b001:l004","ordinal":69121,"en":"The many Chinese, out of fear,"},{"id":"manas-2010:p1606:b001:l005","ordinal":69122,"en":"Cannot step beyond the fortress."},{"id":"manas-2010:p1606:b001:l006","ordinal":69123,"en":"They torment us and drain our strength;"},{"id":"manas-2010:p1606:b001:l007","ordinal":69124,"en":"As though our wealth were not enough,"},{"id":"manas-2010:p1606:b001:l008","ordinal":69125,"en":"They take slaves, women slaves, and men's heads."},{"id":"manas-2010:p1606:b001:l009","ordinal":69126,"en":"There is no justice in the Buruts,"},{"id":"manas-2010:p1606:b001:l010","ordinal":69127,"en":"Those daughter-divorced ones, corrupt in their greed;"},{"id":"manas-2010:p1606:b001:l011","ordinal":69128,"en":"Whenever the chance comes,"},{"id":"manas-2010:p1606:b001:l012","ordinal":69129,"en":"They spill red blood,"},{"id":"manas-2010:p1606:b001:l013","ordinal":69130,"en":"Take heads that bear no guilt."},{"id":"manas-2010:p1606:b001:l014","ordinal":69131,"en":"Of the Buruts who have done this,"},{"id":"manas-2010:p1606:b001:l015","ordinal":69132,"en":"Unable to bear the humiliation,"},{"id":"manas-2010:p1606:b001:l016","ordinal":69133,"en":"The Chinese, peoples of forty khans,"},{"id":"manas-2010:p1606:b001:l017","ordinal":69134,"en":"I shall gather every one."},{"id":"manas-2010:p1606:b001:l018","ordinal":69135,"en":"Though I gather them all together,"},{"id":"manas-2010:p1606:b001:l019","ordinal":69136,"en":"They have no strong support to rely on;"},{"id":"manas-2010:p1606:b001:l020","ordinal":69137,"en":"My excellent champion Kojozhash,"},{"id":"manas-2010:p1606:b001:l021","ordinal":69138,"en":"They have no lion like you."},{"id":"manas-2010:p1606:b001:l022","ordinal":69139,"en":"The Chinese are a vast multitude; I stand alone."},{"id":"manas-2010:p1606:b001:l023","ordinal":69140,"en":"For lack of a fierce champion,"},{"id":"manas-2010:p1606:b001:l024","ordinal":69141,"en":"I have lost many heroes."},{"id":"manas-2010:p1606:b001:l025","ordinal":69142,"en":"Why should I speak of the others?"},{"id":"manas-2010:p1606:b001:l026","ordinal":69143,"en":"They dug my pit deep;"},{"id":"manas-2010:p1606:b001:l027","ordinal":69144,"en":"That Syrgak standing there"},{"id":"manas-2010:p1606:b001:l028","ordinal":69145,"en":"Has shown me many dreadful marvels."},{"id":"manas-2010:p1606:b001:l029","ordinal":69146,"en":"So long as Syrgak lives,"},{"id":"manas-2010:p1606:b001:l030","ordinal":69147,"en":"He will never leave us whole."},{"id":"manas-2010:p1606:b001:l031","ordinal":69148,"en":"He is twenty-one years old,"},{"id":"manas-2010:p1606:b001:l032","ordinal":69149,"en":"He has reached his swelling prime."},{"id":"manas-2010:p1606:b001:l033","ordinal":69150,"en":"His skill is terribly formidable;"},{"id":"manas-2010:p1606:b001:l034","ordinal":69151,"en":"It has reached my marrow,"},{"id":"manas-2010:p1606:b001:l035","ordinal":69152,"en":"It has pierced my every bone—"},{"id":"manas-2010:p1606:b001:l036","ordinal":69153,"en":"The skill of that slave Syrgak!"},{"id":"manas-2010:p1606:b001:l037","ordinal":69154,"en":"Young Syrgak is a hero,"},{"id":"manas-2010:p1606:b001:l038","ordinal":69155,"en":"A lion as great as Manas."},{"id":"manas-2010:p1606:b001:l039","ordinal":69156,"en":"Unless you contrive to save yourself,"},{"id":"manas-2010:p1606:b001:l040","ordinal":69157,"en":"He is a hero who will kill you."},{"id":"manas-2010:p1606:b001:l041","ordinal":69158,"en":"The forty Chinese tribes, all these people,"},{"id":"manas-2010:p1606:b001:l042","ordinal":69159,"en":"Let us gather without looking back;"},{"id":"manas-2010:p1607:b001:l001","ordinal":69160,"en":"You are the mighty marksman,"},{"id":"manas-2010:p1607:b001:l002","ordinal":69161,"en":"Let us bring on Judgment Day!"},{"id":"manas-2010:p1607:b001:l003","ordinal":69162,"en":"Let us slaughter them all;"},{"id":"manas-2010:p1607:b001:l004","ordinal":69163,"en":"If their fierce lion Manas remains,"},{"id":"manas-2010:p1607:b001:l005","ordinal":69164,"en":"Let us bind him alive.”"},{"id":"manas-2010:p1607:b001:l006","ordinal":69165,"en":"With cotton belt and broad boots,"},{"id":"manas-2010:p1607:b001:l007","ordinal":69166,"en":"Kongurbay, khan of the monks,"},{"id":"manas-2010:p1607:b001:l008","ordinal":69167,"en":"A hero skilled among spearmen,"},{"id":"manas-2010:p1607:b001:l009","ordinal":69168,"en":"Who knew every trick of war,"},{"id":"manas-2010:p1607:b001:l010","ordinal":69169,"en":"A lion truly excellent in wisdom,"},{"id":"manas-2010:p1607:b001:l011","ordinal":69170,"en":"Prepared with his champions,"},{"id":"manas-2010:p1607:b001:l012","ordinal":69171,"en":"Chose his marksmen, massed them;"},{"id":"manas-2010:p1607:b001:l013","ordinal":69172,"en":"His swordsmen never flinched,"},{"id":"manas-2010:p1607:b001:l014","ordinal":69173,"en":"They plunged fiercely into battle."},{"id":"manas-2010:p1607:b001:l015","ordinal":69174,"en":"Those skilled at thrusting spears"},{"id":"manas-2010:p1607:b001:l016","ordinal":69175,"en":"He set apart in a separate group;"},{"id":"manas-2010:p1607:b001:l017","ordinal":69176,"en":"His marksmen who never missed"},{"id":"manas-2010:p1607:b001:l018","ordinal":69177,"en":"He set apart as well."},{"id":"manas-2010:p1607:b001:l019","ordinal":69178,"en":"He grouped those of fine appearance separately;"},{"id":"manas-2010:p1607:b001:l020","ordinal":69179,"en":"The Chinese, peoples of forty khans,"},{"id":"manas-2010:p1607:b001:l021","ordinal":69180,"en":"He stretched out in forty divisions."},{"id":"manas-2010:p1607:b001:l022","ordinal":69181,"en":"Amid a wild uproar,"},{"id":"manas-2010:p1607:b001:l023","ordinal":69182,"en":"Amid a roar of cries of “Woe!”"},{"id":"manas-2010:p1607:b001:l024","ordinal":69183,"en":"With Khan Kongurbay at their head,"},{"id":"manas-2010:p1607:b001:l025","ordinal":69184,"en":"The Chinese surged forward."},{"id":"manas-2010:p1607:b001:l026","ordinal":69185,"en":"So numerous were these Chinese,"},{"id":"manas-2010:p1607:b001:l027","ordinal":69186,"en":"They rolled in waves like a lake."},{"id":"manas-2010:p1607:b001:l028","ordinal":69187,"en":"At the forefront of the Chinese,"},{"id":"manas-2010:p1607:b001:l029","ordinal":69188,"en":"The state's great marksman,"},{"id":"manas-2010:p1607:b001:l030","ordinal":69189,"en":"Kojozhash had arrived."},{"id":"manas-2010:p1607:b001:l031","ordinal":69190,"en":"They had girded themselves, readied themselves,"},{"id":"manas-2010:p1607:b001:l032","ordinal":69191,"en":"And were advancing toward them—"},{"id":"manas-2010:p1607:b001:l033","ordinal":69192,"en":"The champions now saw this too."},{"id":"manas-2010:p1607:b001:l034","ordinal":69193,"en":"The handful of Muslims,"},{"id":"manas-2010:p1607:b001:l035","ordinal":69194,"en":"Against the surging Chinese:"},{"id":"manas-2010:p1607:b001:l036","ordinal":69195,"en":"“I shall hold them and fight,"},{"id":"manas-2010:p1607:b001:l037","ordinal":69196,"en":"Cut Kongurbay off from his host,"},{"id":"manas-2010:p1607:b001:l038","ordinal":69197,"en":"Take my vengeance far away!” they said."},{"id":"manas-2010:p1607:b001:l039","ordinal":69198,"en":"Against the boiling Chinese,"},{"id":"manas-2010:p1607:b001:l040","ordinal":69199,"en":"“I shall charge and thrust my spear!”"},{"id":"manas-2010:p1607:b001:l041","ordinal":69200,"en":"Grasping spears, breaking ranks,"},{"id":"manas-2010:p1607:b001:l042","ordinal":69201,"en":"Struck by bullets when death came,"},{"id":"manas-2010:p1608:b001:l001","ordinal":69202,"en":"“I shall drive them as far as Beijing,"},{"id":"manas-2010:p1608:b001:l002","ordinal":69203,"en":"On Beijing, untouched by the great flood,"},{"id":"manas-2010:p1608:b001:l003","ordinal":69204,"en":"I shall wreak slaughter without stopping;"},{"id":"manas-2010:p1608:b001:l004","ordinal":69205,"en":"I shall kill the khans of Beijing,"},{"id":"manas-2010:p1608:b001:l005","ordinal":69206,"en":"Kakan-Chin's golden throne"},{"id":"manas-2010:p1608:b001:l006","ordinal":69207,"en":"I shall seize back!” they said."},{"id":"manas-2010:p1608:b001:l007","ordinal":69208,"en":"Taking salt to season with,"},{"id":"manas-2010:p1608:b001:l008","ordinal":69209,"en":"Pursuing them all the way to Beijing,"},{"id":"manas-2010:p1608:b001:l009","ordinal":69210,"en":"Taking beautiful, beautiful girls—"},{"id":"manas-2010:p1608:b001:l010","ordinal":69211,"en":"Among horses, the winged steed is piebald-headed;"},{"id":"manas-2010:p1608:b001:l011","ordinal":69212,"en":"Almambet and Chubak are names alike."},{"id":"manas-2010:p1608:b001:l012","ordinal":69213,"en":"Who never turned back when death came,"},{"id":"manas-2010:p1608:b001:l013","ordinal":69214,"en":"Who never drew their heads from death,"},{"id":"manas-2010:p1608:b001:l014","ordinal":69215,"en":"Syrgak, Ulak Khan's son,"},{"id":"manas-2010:p1608:b001:l015","ordinal":69216,"en":"Ajybay, Argynkan's son,"},{"id":"manas-2010:p1608:b001:l016","ordinal":69217,"en":"Of the Buruts following behind,"},{"id":"manas-2010:p1608:b001:l017","ordinal":69218,"en":"He was the one who drove them on."},{"id":"manas-2010:p1608:b001:l018","ordinal":69219,"en":"Khan Manas's forty companions"},{"id":"manas-2010:p1608:b001:l019","ordinal":69220,"en":"Shouted from forty sides,"},{"id":"manas-2010:p1608:b001:l020","ordinal":69221,"en":"Slaughtering without stopping,"},{"id":"manas-2010:p1608:b001:l021","ordinal":69222,"en":"Crying the battle cry “Manas!”"},{"id":"manas-2010:p1608:b001:l022","ordinal":69223,"en":"Muzburchak, Buudayyk Khan's son,"},{"id":"manas-2010:p1608:b001:l023","ordinal":69224,"en":"With a host that could not be turned,"},{"id":"manas-2010:p1608:b001:l024","ordinal":69225,"en":"Along a winding, bull-piss road,"},{"id":"manas-2010:p1608:b001:l025","ordinal":69226,"en":"People swarmed over the earth."},{"id":"manas-2010:p1608:b001:l026","ordinal":69227,"en":"A red banner with a golden crescent—"},{"id":"manas-2010:p1608:b001:l027","ordinal":69228,"en":"The one who took and raised the banner"},{"id":"manas-2010:p1608:b001:l028","ordinal":69229,"en":"Was a khan like Muzburchak."},{"id":"manas-2010:p1608:b001:l029","ordinal":69230,"en":"Their champions grew frenzied,"},{"id":"manas-2010:p1608:b001:l030","ordinal":69231,"en":"Every one of the heroes"},{"id":"manas-2010:p1608:b001:l031","ordinal":69232,"en":"Raged beyond restraint."},{"id":"manas-2010:p1608:b001:l032","ordinal":69233,"en":"Crossing many, many ridges,"},{"id":"manas-2010:p1608:b001:l033","ordinal":69234,"en":"Treading many wondrous lands,"},{"id":"manas-2010:p1608:b001:l034","ordinal":69235,"en":"Fighting with gunfire in Beijing,"},{"id":"manas-2010:p1608:b001:l035","ordinal":69236,"en":"Battling in many places,"},{"id":"manas-2010:p1608:b001:l036","ordinal":69237,"en":"Was this not your Alma, long accustomed to it?"},{"id":"manas-2010:p1608:b001:l037","ordinal":69238,"en":"Staining his golden throne with blood,"},{"id":"manas-2010:p1608:b001:l038","ordinal":69239,"en":"Slaughtering his father, laying him low,"},{"id":"manas-2010:p1608:b001:l039","ordinal":69240,"en":"Was this not your Alma who had come?"},{"id":"manas-2010:p1608:b001:l040","ordinal":69241,"en":"Kara-Too, where tea is gathered—"},{"id":"manas-2010:p1608:b001:l041","ordinal":69242,"en":"Was this not your Alma who crossed it?"},{"id":"manas-2010:p1608:b001:l042","ordinal":69243,"en":"Great stores of yellow gold,"},{"id":"manas-2010:p1609:b001:l001","ordinal":69244,"en":"Not valuing them at half a hair,"},{"id":"manas-2010:p1609:b001:l002","ordinal":69245,"en":"Was this not your Alma who scattered them?"},{"id":"manas-2010:p1609:b001:l003","ordinal":69246,"en":"That Kojozhash had arrived,"},{"id":"manas-2010:p1609:b001:l004","ordinal":69247,"en":"Almambet now saw."},{"id":"manas-2010:p1609:b001:l005","ordinal":69248,"en":"Despairing of his borrowed life,"},{"id":"manas-2010:p1609:b001:l006","ordinal":69249,"en":"Karykan's weather stone,"},{"id":"manas-2010:p1609:b001:l007","ordinal":69250,"en":"The spell that brought down rain,"},{"id":"manas-2010:p1609:b001:l008","ordinal":69251,"en":"He drew out from his side."},{"id":"manas-2010:p1609:b001:l009","ordinal":69252,"en":"Into half a bowl of plain water"},{"id":"manas-2010:p1609:b001:l010","ordinal":69253,"en":"He dropped it with a plop."},{"id":"manas-2010:p1609:b001:l011","ordinal":69254,"en":"Rattling away in Kalmyk,"},{"id":"manas-2010:p1609:b001:l012","ordinal":69255,"en":"Babbling away in Chinese,"},{"id":"manas-2010:p1609:b001:l013","ordinal":69256,"en":"Sarala, with a cowlike rump,"},{"id":"manas-2010:p1609:b001:l014","ordinal":69257,"en":"Almambet sent whirling;"},{"id":"manas-2010:p1609:b001:l015","ordinal":69258,"en":"He pranced and pranced about,"},{"id":"manas-2010:p1609:b001:l016","ordinal":69259,"en":"He made the rain fall."},{"id":"manas-2010:p1609:b001:l017","ordinal":69260,"en":"Clouds swept across the sky,"},{"id":"manas-2010:p1609:b001:l018","ordinal":69261,"en":"Covered the face of the earth;"},{"id":"manas-2010:p1609:b001:l019","ordinal":69262,"en":"Clouds thundered in the heavens,"},{"id":"manas-2010:p1609:b001:l020","ordinal":69263,"en":"The earth whirled with a roar."},{"id":"manas-2010:p1609:b001:l021","ordinal":69264,"en":"Almambet worked his weather magic."},{"id":"manas-2010:p1609:b001:l022","ordinal":69265,"en":"He turned a summer day to winter,"},{"id":"manas-2010:p1609:b001:l023","ordinal":69266,"en":"The thinly clothed Chinese"},{"id":"manas-2010:p1609:b001:l024","ordinal":69267,"en":"He made whimper like girls."},{"id":"manas-2010:p1609:b001:l025","ordinal":69268,"en":"Turning the mountaintops to ice,"},{"id":"manas-2010:p1609:b001:l026","ordinal":69269,"en":"Whirling without cease,"},{"id":"manas-2010:p1609:b001:l027","ordinal":69270,"en":"Slaughtering people, working weather magic,"},{"id":"manas-2010:p1609:b001:l028","ordinal":69271,"en":"With a sword clanking in his hand—"},{"id":"manas-2010:p1609:b001:l029","ordinal":69272,"en":"Kongurbay, khan of the monks,"},{"id":"manas-2010:p1609:b001:l030","ordinal":69273,"en":"Dismounted, shivering."},{"id":"manas-2010:p1609:b001:l031","ordinal":69274,"en":"To drive his people onward,"},{"id":"manas-2010:p1609:b001:l032","ordinal":69275,"en":"To work weather magic one more day,"},{"id":"manas-2010:p1609:b001:l033","ordinal":69276,"en":"To drive them back into Beijing—"},{"id":"manas-2010:p1609:b001:l034","ordinal":69277,"en":"That was Almambet's intent."},{"id":"manas-2010:p1609:b001:l035","ordinal":69278,"en":"Of the Chinese with rank buttons,"},{"id":"manas-2010:p1609:b001:l036","ordinal":69279,"en":"He smashed their very finest;"},{"id":"manas-2010:p1609:b001:l037","ordinal":69280,"en":"Of the Chinese with red tassels,"},{"id":"manas-2010:p1609:b001:l038","ordinal":69281,"en":"He laid their strongest low,"},{"id":"manas-2010:p1609:b001:l039","ordinal":69282,"en":"Working mighty weather magic."},{"id":"manas-2010:p1609:b001:l040","ordinal":69283,"en":"Shouting “Muslims!”"},{"id":"manas-2010:p1609:b001:l041","ordinal":69284,"en":"Almambet, Chubak, the hero Syrgak,"},{"id":"manas-2010:p1609:b001:l042","ordinal":69285,"en":"Threw them into utter turmoil,"},{"id":"manas-2010:p1610:b001:l001","ordinal":69286,"en":"They drove them on, scattering them."},{"id":"manas-2010:p1610:b001:l002","ordinal":69287,"en":"Buudayyk Khan's Muzburchak,"},{"id":"manas-2010:p1610:b001:l003","ordinal":69288,"en":"From the flank, the Chinese"},{"id":"manas-2010:p1610:b001:l004","ordinal":69289,"en":"Hemmed in and pressed forward."},{"id":"manas-2010:p1610:b001:l005","ordinal":69290,"en":"Khan Manas's forty companions,"},{"id":"manas-2010:p1610:b001:l006","ordinal":69291,"en":"Their roars splitting stone,"},{"id":"manas-2010:p1610:b001:l007","ordinal":69292,"en":"Drove them back from the edge."},{"id":"manas-2010:p1610:b001:l008","ordinal":69293,"en":"Into the scarlet fire,"},{"id":"manas-2010:p1610:b001:l009","ordinal":69294,"en":"Without hesitation, Almambet"},{"id":"manas-2010:p1610:b001:l010","ordinal":69295,"en":"And valiant Syrgak entered."},{"id":"manas-2010:p1610:b001:l011","ordinal":69296,"en":"Through the middle, brave Chubak"},{"id":"manas-2010:p1610:b001:l012","ordinal":69297,"en":"Came wheeling in battle;"},{"id":"manas-2010:p1610:b001:l013","ordinal":69298,"en":"At the foot of the banner, brave Syrgak"},{"id":"manas-2010:p1610:b001:l014","ordinal":69299,"en":"Came prowling forward."},{"id":"manas-2010:p1610:b001:l015","ordinal":69300,"en":"In Kakanchyn's Beijing,"},{"id":"manas-2010:p1610:b001:l016","ordinal":69301,"en":"Making the Chinese bellow,"},{"id":"manas-2010:p1610:b001:l017","ordinal":69302,"en":"They hemmed them in and drove them."},{"id":"manas-2010:p1610:b001:l018","ordinal":69303,"en":"Raising dust and turmoil,"},{"id":"manas-2010:p1610:b001:l019","ordinal":69304,"en":"See the dust descending like haze,"},{"id":"manas-2010:p1610:b001:l020","ordinal":69305,"en":"See the souls falling,"},{"id":"manas-2010:p1610:b001:l021","ordinal":69306,"en":"See the blood flowing!"},{"id":"manas-2010:p1610:b001:l022","ordinal":69307,"en":"Chinese of every kind"},{"id":"manas-2010:p1610:b001:l023","ordinal":69308,"en":"They drove along alive."},{"id":"manas-2010:p1610:b001:l024","ordinal":69309,"en":"Unbelievers and Muslims"},{"id":"manas-2010:p1610:b001:l025","ordinal":69310,"en":"Were being worn away."},{"id":"manas-2010:p1610:b001:l026","ordinal":69311,"en":"Seeing them dwindle,"},{"id":"manas-2010:p1610:b001:l027","ordinal":69312,"en":"Crafty Kongurbay,"},{"id":"manas-2010:p1610:b001:l028","ordinal":69313,"en":"His shout splitting heads,"},{"id":"manas-2010:p1610:b001:l029","ordinal":69314,"en":"All his champions"},{"id":"manas-2010:p1610:b001:l030","ordinal":69315,"en":"Kongurbay gathered together."},{"id":"manas-2010:p1610:b001:l031","ordinal":69316,"en":"Those who shook their heads and refused,"},{"id":"manas-2010:p1610:b001:l032","ordinal":69317,"en":"Kongurbay slaughtered."},{"id":"manas-2010:p1610:b001:l033","ordinal":69318,"en":"While he was resisting fiercely,"},{"id":"manas-2010:p1610:b001:l034","ordinal":69319,"en":"To the champion Khan Kongurbay,"},{"id":"manas-2010:p1610:b001:l035","ordinal":69320,"en":"Your leopard Alma came."},{"id":"manas-2010:p1610:b001:l036","ordinal":69321,"en":"Upon reaching the Fierce One,"},{"id":"manas-2010:p1610:b001:l037","ordinal":69322,"en":"With his lacquered lance edged in steel,"},{"id":"manas-2010:p1610:b001:l038","ordinal":69323,"en":"Dear Alma, without hesitation,"},{"id":"manas-2010:p1610:b001:l039","ordinal":69324,"en":"Thrust hard as he passed."},{"id":"manas-2010:p1610:b001:l040","ordinal":69325,"en":"Then Kongurbay,"},{"id":"manas-2010:p1610:b001:l041","ordinal":69326,"en":"When dear Alma had thrust and passed,"},{"id":"manas-2010:p1610:b001:l042","ordinal":69327,"en":"Was wounded and bleeding."},{"id":"manas-2010:p1611:b001:l001","ordinal":69328,"en":"His horse swift, a true steed,"},{"id":"manas-2010:p1611:b001:l002","ordinal":69329,"en":"Kongurbay bounded free."},{"id":"manas-2010:p1611:b001:l003","ordinal":69330,"en":"“A fire burning in a valley is bad;"},{"id":"manas-2010:p1611:b001:l004","ordinal":69331,"en":"An enemy sprung from one's own is bad."},{"id":"manas-2010:p1611:b001:l005","ordinal":69332,"en":"Were it not for this fugitive,"},{"id":"manas-2010:p1611:b001:l006","ordinal":69333,"en":"I would raid and plunder his Talas,"},{"id":"manas-2010:p1611:b001:l007","ordinal":69334,"en":"And ruin his Manas!”"},{"id":"manas-2010:p1611:b001:l008","ordinal":69335,"en":"Thus spoke Kongurbay"},{"id":"manas-2010:p1611:b001:l009","ordinal":69336,"en":"And turned Algara's head."},{"id":"manas-2010:p1611:b001:l010","ordinal":69337,"en":"Buudayyk Khan's Muzburchak,"},{"id":"manas-2010:p1611:b001:l011","ordinal":69338,"en":"Fired with Telkyzyl beneath him,"},{"id":"manas-2010:p1611:b001:l012","ordinal":69339,"en":"A gray leather belt around his waist,"},{"id":"manas-2010:p1611:b001:l013","ordinal":69340,"en":"Crying out, “Manas! Manas!”"},{"id":"manas-2010:p1611:b001:l014","ordinal":69341,"en":"Muzburchak, born complete,"},{"id":"manas-2010:p1611:b001:l015","ordinal":69342,"en":"Arrived faster than an arrow."},{"id":"manas-2010:p1611:b001:l016","ordinal":69343,"en":"Through seven great hosts of Chinese and Manzhuu"},{"id":"manas-2010:p1611:b001:l017","ordinal":69344,"en":"He plunged alone,"},{"id":"manas-2010:p1611:b001:l018","ordinal":69345,"en":"Splitting their very center,"},{"id":"manas-2010:p1611:b001:l019","ordinal":69346,"en":"And reached Kongurbay."},{"id":"manas-2010:p1611:b001:l020","ordinal":69347,"en":"As he was about to seize his hem,"},{"id":"manas-2010:p1611:b001:l021","ordinal":69348,"en":"About to finish him off,"},{"id":"manas-2010:p1611:b001:l022","ordinal":69349,"en":"At the banner's foot, Kojozhash"},{"id":"manas-2010:p1611:b001:l023","ordinal":69350,"en":"Saw the red-clad, charging"},{"id":"manas-2010:p1611:b001:l024","ordinal":69351,"en":"Muzburchak who entered shouting:"},{"id":"manas-2010:p1611:b001:l025","ordinal":69352,"en":"“The right temple itself,” he thought,"},{"id":"manas-2010:p1611:b001:l026","ordinal":69353,"en":"“Or, if it falls short, the eye.”"},{"id":"manas-2010:p1611:b001:l027","ordinal":69354,"en":"The finest of marksmen,"},{"id":"manas-2010:p1611:b001:l028","ordinal":69355,"en":"His trigger ready,"},{"id":"manas-2010:p1611:b001:l029","ordinal":69356,"en":"Kojozhash gave it a pull."},{"id":"manas-2010:p1611:b001:l030","ordinal":69357,"en":"The hapless head split clean apart."},{"id":"manas-2010:p1611:b001:l031","ordinal":69358,"en":"Buudayyk Khan's Muzburchak,"},{"id":"manas-2010:p1611:b001:l032","ordinal":69359,"en":"When he fell shot without turning,"},{"id":"manas-2010:p1611:b001:l033","ordinal":69360,"en":"With more sorrow than the heart could hold,"},{"id":"manas-2010:p1611:b001:l034","ordinal":69361,"en":"Tears streaming ten ways,"},{"id":"manas-2010:p1611:b001:l035","ordinal":69362,"en":"“If Muzburchak and Khan Kökchö die,"},{"id":"manas-2010:p1611:b001:l036","ordinal":69363,"en":"If everyone we meet dies,"},{"id":"manas-2010:p1611:b001:l037","ordinal":69364,"en":"How shall we reach our inheritance?"},{"id":"manas-2010:p1611:b001:l038","ordinal":69365,"en":"Bereft of our valiant men,"},{"id":"manas-2010:p1611:b001:l039","ordinal":69366,"en":"Without fighting to the death in Beijing,"},{"id":"manas-2010:p1611:b001:l040","ordinal":69367,"en":"How can we return to our people?”"},{"id":"manas-2010:p1611:b001:l041","ordinal":69368,"en":"Thus spoke dear Syrgak."},{"id":"manas-2010:p1611:b001:l042","ordinal":69369,"en":"Kökchebich beneath him"},{"id":"manas-2010:p1612:b001:l001","ordinal":69370,"en":"He sent racing at the cry, “Go!”"},{"id":"manas-2010:p1612:b001:l002","ordinal":69371,"en":"Raising tumult among the Chinese,"},{"id":"manas-2010:p1612:b001:l003","ordinal":69372,"en":"Felling all he encountered,"},{"id":"manas-2010:p1612:b001:l004","ordinal":69373,"en":"Of the Kalmyks who opposed him,"},{"id":"manas-2010:p1612:b001:l005","ordinal":69374,"en":"Laying so many low."},{"id":"manas-2010:p1612:b001:l006","ordinal":69375,"en":"Without looking all around,"},{"id":"manas-2010:p1612:b001:l007","ordinal":69376,"en":"Azizkhan's Almambet"}]
