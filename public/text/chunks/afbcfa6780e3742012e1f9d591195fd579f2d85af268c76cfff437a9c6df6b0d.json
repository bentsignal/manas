[{"id":"semetey-1-2013:p0516:b004:l009","ordinal":116481,"en":"They called it Munara Ak-Chiy."},{"id":"semetey-1-2013:p0516:b004:l010","ordinal":116482,"en":"He traversed that Ak-Chiy;"},{"id":"semetey-1-2013:p0516:b004:l011","ordinal":116483,"en":"The jutting mountain's shoulder"},{"id":"semetey-1-2013:p0516:b004:l012","ordinal":116484,"en":"Your orphan crossed over."},{"id":"semetey-1-2013:p0516:b004:l013","ordinal":116485,"en":"“These were mother Kanykey's words:"},{"id":"semetey-1-2013:p0516:b004:l014","ordinal":116486,"en":"'If you visit it, a great shrine,"},{"id":"semetey-1-2013:p0516:b004:l015","ordinal":116487,"en":"Your mother's from her girlhood,"},{"id":"semetey-1-2013:p0516:b004:l016","ordinal":116488,"en":"It is Keng-Kolchuk,' she said."},{"id":"semetey-1-2013:p0516:b004:l017","ordinal":116489,"en":"When her treasure was scattered,"},{"id":"semetey-1-2013:p0516:b004:l018","ordinal":116490,"en":"My mother, exhausted and weeping,"},{"id":"semetey-1-2013:p0516:b004:l019","ordinal":116491,"en":"Carrying me, the orphan,"},{"id":"semetey-1-2013:p0516:b004:l020","ordinal":116492,"en":"When she fled Talas on foot,"},{"id":"semetey-1-2013:p0516:b004:l021","ordinal":116493,"en":"With two skins of milk"},{"id":"semetey-1-2013:p0516:b004:l022","ordinal":116494,"en":"And two fat working horses,"},{"id":"semetey-1-2013:p0516:b004:l023","ordinal":116495,"en":"All their provisions ran out,"},{"id":"semetey-1-2013:p0516:b004:l024","ordinal":116496,"en":"And only one bone of meat remained."},{"id":"semetey-1-2013:p0516:b004:l025","ordinal":116497,"en":"My grandmother Chiyrdy wept in anguish;"},{"id":"semetey-1-2013:p0516:b004:l026","ordinal":116498,"en":"The widows, with that one bone of meat,"},{"id":"semetey-1-2013:p0516:b004:l027","ordinal":116499,"en":"Called on God and pleaded."},{"id":"semetey-1-2013:p0516:b004:l028","ordinal":116500,"en":"These were my mother Kanykey's words:"},{"id":"semetey-1-2013:p0516:b004:l029","ordinal":116501,"en":"My wretched mother, at Keng-Kolchuk,"},{"id":"semetey-1-2013:p0516:b004:l030","ordinal":116502,"en":"'I cast a divination,' she said."},{"id":"semetey-1-2013:p0516:b004:l031","ordinal":116503,"en":"'If you look, this is your omen:"},{"id":"semetey-1-2013:p0516:b004:l032","ordinal":116504,"en":"Your mother's Keng-Kolchuk,"},{"id":"semetey-1-2013:p0516:b004:l033","ordinal":116505,"en":"Bubbling and brimming with water,"},{"id":"semetey-1-2013:p0516:b004:l034","ordinal":116506,"en":"Overflows,' she said."},{"id":"semetey-1-2013:p0516:b004:l035","ordinal":116507,"en":"'From its breath, Keng-Kolchuk"},{"id":"semetey-1-2013:p0516:b004:l036","ordinal":116508,"en":"Surges over,' she said."},{"id":"semetey-1-2013:p0516:b004:l037","ordinal":116509,"en":"'A grove of plane trees"},{"id":"semetey-1-2013:p0516:b004:l038","ordinal":116510,"en":"Surrounds it,' she said."},{"id":"semetey-1-2013:p0516:b004:l039","ordinal":116511,"en":"These were mother Kanykey's words."},{"id":"semetey-1-2013:p0517:b003:l001","ordinal":116512,"en":"Everything she spoke of is here."},{"id":"semetey-1-2013:p0517:b003:l002","ordinal":116513,"en":"Ah, my mother Kanykey"},{"id":"semetey-1-2013:p0517:b003:l003","ordinal":116514,"en":"Is a soul endowed with sacred power."},{"id":"semetey-1-2013:p0517:b003:l004","ordinal":116515,"en":"A black stone stands beside the water;"},{"id":"semetey-1-2013:p0517:b003:l005","ordinal":116516,"en":"On the black stone is writing."},{"id":"semetey-1-2013:p0517:b003:l006","ordinal":116517,"en":"When I read the writing,"},{"id":"semetey-1-2013:p0517:b003:l007","ordinal":116518,"en":"My leopard mother's name is there."},{"id":"semetey-1-2013:p0517:b003:l008","ordinal":116519,"en":"My precious, fierce mother's"},{"id":"semetey-1-2013:p0517:b003:l009","ordinal":116520,"en":"Keng-Kolchuk from her girlhood,"},{"id":"semetey-1-2013:p0517:b003:l010","ordinal":116521,"en":"Surrounded by a grove of plane trees,"},{"id":"semetey-1-2013:p0517:b003:l011","ordinal":116522,"en":"With pools all around,"},{"id":"semetey-1-2013:p0517:b003:l012","ordinal":116523,"en":"A black, white-blazed thoroughbred"},{"id":"semetey-1-2013:p0517:b003:l013","ordinal":116524,"en":"She would ride in splendor."},{"id":"semetey-1-2013:p0517:b003:l014","ordinal":116525,"en":"Ninety girls followed her."},{"id":"semetey-1-2013:p0517:b003:l015","ordinal":116526,"en":"My poor mother Kanykey,"},{"id":"semetey-1-2013:p0517:b003:l016","ordinal":116527,"en":"In her girlhood then,"},{"id":"semetey-1-2013:p0517:b003:l017","ordinal":116528,"en":"Would come on pilgrimage."},{"id":"semetey-1-2013:p0517:b003:l018","ordinal":116529,"en":"On its plane tree, this very year,"},{"id":"semetey-1-2013:p0517:b003:l019","ordinal":116530,"en":"A nightingale has flown down and perched."},{"id":"semetey-1-2013:p0517:b003:l020","ordinal":116531,"en":"Its poplars have leafed out, their branches full;"},{"id":"semetey-1-2013:p0517:b003:l021","ordinal":116532,"en":"My godlike father Manas"},{"id":"semetey-1-2013:p0517:b003:l022","ordinal":116533,"en":"Seems still to be alive.”"},{"id":"semetey-1-2013:p0517:b003:l023","ordinal":116534,"en":"The boy prepared to take the road,"},{"id":"semetey-1-2013:p0517:b003:l024","ordinal":116535,"en":"To Manas, gone to the next world,"},{"id":"semetey-1-2013:p0517:b003:l025","ordinal":116536,"en":"Your boy pleaded with his spirit."},{"id":"semetey-1-2013:p0517:b003:l026","ordinal":116537,"en":"Kanykey had come in mourning;"},{"id":"semetey-1-2013:p0517:b003:l027","ordinal":116538,"en":"When he was a nursing infant,"},{"id":"semetey-1-2013:p0517:b003:l028","ordinal":116539,"en":"Semetey had fled here."},{"id":"semetey-1-2013:p0517:b003:l029","ordinal":116540,"en":"Plundering riches, they prospered,"},{"id":"semetey-1-2013:p0517:b003:l030","ordinal":116541,"en":"The orphan had come to Bukhara and grown."},{"id":"semetey-1-2013:p0517:b003:l031","ordinal":116542,"en":"To Khan Temir's city"},{"id":"semetey-1-2013:p0517:b003:l032","ordinal":116543,"en":"He had wandered, keeping himself alive."},{"id":"semetey-1-2013:p0517:b003:l033","ordinal":116544,"en":"When they came to Khan Temir,"},{"id":"semetey-1-2013:p0517:b003:l034","ordinal":116545,"en":"His ill-fated mother,"},{"id":"semetey-1-2013:p0517:b003:l035","ordinal":116546,"en":"The prince's only son,"},{"id":"semetey-1-2013:p0517:b003:l036","ordinal":116547,"en":"Snipping his little twig,"},{"id":"semetey-1-2013:p0517:b003:l037","ordinal":116548,"en":"For this khan of Bukhara"},{"id":"semetey-1-2013:p0517:b003:l038","ordinal":116549,"en":"Had performed the ritual."},{"id":"semetey-1-2013:p0517:b003:l039","ordinal":116550,"en":"The orphan grew to maturity,"},{"id":"semetey-1-2013:p0517:b004:l001","ordinal":116551,"en":"And thus joined the ranks,"},{"id":"semetey-1-2013:p0517:b004:l002","ordinal":116552,"en":"Growing up, becoming a hero,"},{"id":"semetey-1-2013:p0517:b004:l003","ordinal":116553,"en":"Without deviation from Manas,"},{"id":"semetey-1-2013:p0517:b004:l004","ordinal":116554,"en":"A hero exactly like him."},{"id":"semetey-1-2013:p0517:b004:l005","ordinal":116555,"en":"When he reached Keng-Kolchuk,"},{"id":"semetey-1-2013:p0517:b004:l006","ordinal":116556,"en":"He adjusted his winged steed's saddle."},{"id":"semetey-1-2013:p0517:b004:l007","ordinal":116557,"en":"To Manas, gone to the next world,"},{"id":"semetey-1-2013:p0517:b004:l008","ordinal":116558,"en":"He dedicated a recitation of the Quran."},{"id":"semetey-1-2013:p0517:b004:l009","ordinal":116559,"en":"When the boy was in Bukhara,"},{"id":"semetey-1-2013:p0517:b004:l010","ordinal":116560,"en":"In the woods he heard words from Taz;"},{"id":"semetey-1-2013:p0517:b004:l011","ordinal":116561,"en":"He heard that his people were Kyrgyz,"},{"id":"semetey-1-2013:p0517:b004:l012","ordinal":116562,"en":"That his horse was white-blazed,"},{"id":"semetey-1-2013:p0517:b004:l013","ordinal":116563,"en":"That his father was someone else,"},{"id":"semetey-1-2013:p0517:b004:l014","ordinal":116564,"en":"That Akynkhan and the Afghans were his in-laws,"},{"id":"semetey-1-2013:p0517:b004:l015","ordinal":116565,"en":"That Aichurok was his wife,"},{"id":"semetey-1-2013:p0517:b004:l016","ordinal":116566,"en":"Saying a holy sage had given his blessing,"},{"id":"semetey-1-2013:p0517:b004:l017","ordinal":116567,"en":"That he followed twelve spiritual masters—"},{"id":"semetey-1-2013:p0517:b004:l018","ordinal":116568,"en":"Mighty Sultan Khan Manas—"},{"id":"semetey-1-2013:p0517:b004:l019","ordinal":116569,"en":"'He is your father,' he said."},{"id":"semetey-1-2013:p0517:b004:l020","ordinal":116570,"en":"'Talas is your land,' he said."},{"id":"semetey-1-2013:p0517:b004:l021","ordinal":116571,"en":"'The Kyrgyz are your people,' he said."},{"id":"semetey-1-2013:p0517:b004:l022","ordinal":116572,"en":"The son of a prince—"},{"id":"semetey-1-2013:p0517:b004:l023","ordinal":116573,"en":"What reason had he to wander as a fugitive?"},{"id":"semetey-1-2013:p0517:b004:l024","ordinal":116574,"en":"Where were his poor Kyrgyz people?"},{"id":"semetey-1-2013:p0517:b004:l025","ordinal":116575,"en":"To the land left by his father,"},{"id":"semetey-1-2013:p0517:b004:l026","ordinal":116576,"en":"Semetey was going,"},{"id":"semetey-1-2013:p0517:b004:l027","ordinal":116577,"en":"To those Argyn and Kyrgyz people."},{"id":"semetey-1-2013:p0517:b004:l028","ordinal":116578,"en":"His father Khan Manas came into his thoughts."},{"id":"semetey-1-2013:p0517:b004:l029","ordinal":116579,"en":"The orphan servant left by my Khan Manas,"},{"id":"semetey-1-2013:p0517:b004:l030","ordinal":116580,"en":"Aktulpar beneath him,"},{"id":"semetey-1-2013:p0517:b004:l031","ordinal":116581,"en":"He lashed his whip on either side,"},{"id":"semetey-1-2013:p0517:b004:l032","ordinal":116582,"en":"Spurring to right and left."},{"id":"semetey-1-2013:p0517:b004:l033","ordinal":116583,"en":"The orphan set his course and traveled,"},{"id":"semetey-1-2013:p0517:b004:l034","ordinal":116584,"en":"Going far, not sparing his horse."},{"id":"semetey-1-2013:p0517:b004:l035","ordinal":116585,"en":"Went farther and grew distraught."},{"id":"semetey-1-2013:p0517:b004:l036","ordinal":116586,"en":"As the sun wavered toward setting,"},{"id":"semetey-1-2013:p0517:b004:l037","ordinal":116587,"en":"Kulesheng's Kul-Tokoy—"},{"id":"semetey-1-2013:p0517:b004:l038","ordinal":116588,"en":"He reached Kul-Tokoy."},{"id":"semetey-1-2013:p0517:b004:l039","ordinal":116589,"en":"Kulesheng's Kul-Tokoy,"},{"id":"semetey-1-2013:p0518:b003:l001","ordinal":116590,"en":"Lay spread out luxuriantly,"},{"id":"semetey-1-2013:p0518:b003:l002","ordinal":116591,"en":"Its yellow valley stretching proudly."},{"id":"semetey-1-2013:p0518:b003:l003","ordinal":116592,"en":"Apples ripened and fell to mulch;"},{"id":"semetey-1-2013:p0518:b003:l004","ordinal":116593,"en":"It was a land loved by God."},{"id":"semetey-1-2013:p0518:b003:l005","ordinal":116594,"en":"Walnuts fell and filled the ravines."},{"id":"semetey-1-2013:p0518:b003:l006","ordinal":116595,"en":"Kuleshen's Kul-Tokoy"},{"id":"semetey-1-2013:p0518:b003:l007","ordinal":116596,"en":"Had all its wealth in perfect order."},{"id":"semetey-1-2013:p0518:b003:l008","ordinal":116597,"en":"Its little birds were like snowcocks;"},{"id":"semetey-1-2013:p0518:b003:l009","ordinal":116598,"en":"Its plane trees stood like towers."},{"id":"semetey-1-2013:p0518:b003:l010","ordinal":116599,"en":"Its mountains held snow;"},{"id":"semetey-1-2013:p0518:b003:l011","ordinal":116600,"en":"Its forest held rooks."},{"id":"semetey-1-2013:p0518:b003:l012","ordinal":116601,"en":"Every living creature was there."},{"id":"semetey-1-2013:p0518:b003:l013","ordinal":116602,"en":"Its hogweed stems were thick as forearms;"},{"id":"semetey-1-2013:p0518:b003:l014","ordinal":116603,"en":"Its red deer, when urged on,"},{"id":"semetey-1-2013:p0518:b003:l015","ordinal":116604,"en":"Were like pale, white-blazed cows."},{"id":"semetey-1-2013:p0518:b003:l016","ordinal":116605,"en":"There were foxes on its plains,"},{"id":"semetey-1-2013:p0518:b003:l017","ordinal":116606,"en":"Argali on its foothills,"},{"id":"semetey-1-2013:p0518:b003:l018","ordinal":116607,"en":"Deer on its hillocks,"},{"id":"semetey-1-2013:p0518:b003:l019","ordinal":116608,"en":"Nightingales in its plane trees."},{"id":"semetey-1-2013:p0518:b003:l020","ordinal":116609,"en":"When its nightingales warbled,"},{"id":"semetey-1-2013:p0518:b003:l021","ordinal":116610,"en":"A sorrowful person could not bear to hear;"},{"id":"semetey-1-2013:p0518:b003:l022","ordinal":116611,"en":"If the grieving gathered there sobbing,"},{"id":"semetey-1-2013:p0518:b003:l023","ordinal":116612,"en":"A sorrowful person could not leave."},{"id":"semetey-1-2013:p0518:b003:l024","ordinal":116613,"en":"Its parrots spread their wings;"},{"id":"semetey-1-2013:p0518:b003:l025","ordinal":116614,"en":"Owls spoke from its mountains."},{"id":"semetey-1-2013:p0518:b003:l026","ordinal":116615,"en":"Kul-Tokoy was a splendid place."},{"id":"semetey-1-2013:p0518:b003:l027","ordinal":116616,"en":"Its birds laid eggs in the birches,"},{"id":"semetey-1-2013:p0518:b003:l028","ordinal":116617,"en":"Preparing to fly;"},{"id":"semetey-1-2013:p0518:b003:l029","ordinal":116618,"en":"Its birds laid eggs in the poplars,"},{"id":"semetey-1-2013:p0518:b003:l030","ordinal":116619,"en":"Straining to fly."},{"id":"semetey-1-2013:p0518:b003:l031","ordinal":116620,"en":"It had marshes here and there;"},{"id":"semetey-1-2013:p0518:b003:l032","ordinal":116621,"en":"It was a wooded upland pasture set apart."},{"id":"semetey-1-2013:p0518:b003:l033","ordinal":116622,"en":"Your fierce mother Kanykey,"},{"id":"semetey-1-2013:p0518:b003:l034","ordinal":116623,"en":"When she fled Bukhara on foot,"},{"id":"semetey-1-2013:p0518:b003:l035","ordinal":116624,"en":"My noble-horse father Khan Manas's treasure,"},{"id":"semetey-1-2013:p0518:b003:l036","ordinal":116625,"en":"When the foolish ones scattered it,"},{"id":"semetey-1-2013:p0518:b003:l037","ordinal":116626,"en":"For a woman whose husband had died,"},{"id":"semetey-1-2013:p0518:b003:l038","ordinal":116627,"en":"Thinking her birth family would be near,"},{"id":"semetey-1-2013:p0518:b003:l039","ordinal":116628,"en":"Suffering hardship without a way out,"},{"id":"semetey-1-2013:p0518:b004:l001","ordinal":116629,"en":"When my mother fled Talas on foot,"},{"id":"semetey-1-2013:p0518:b004:l002","ordinal":116630,"en":"When she came to Kul-Tokoy,"},{"id":"semetey-1-2013:p0518:b004:l003","ordinal":116631,"en":"When my wretched mother suffered humiliation,"},{"id":"semetey-1-2013:p0518:b004:l004","ordinal":116632,"en":"The old woman coughed on her back."},{"id":"semetey-1-2013:p0518:b004:l005","ordinal":116633,"en":"The old woman and her child"},{"id":"semetey-1-2013:p0518:b004:l006","ordinal":116634,"en":"My mother carried, straining."},{"id":"semetey-1-2013:p0518:b004:l007","ordinal":116635,"en":"My poor mother Kanykey"},{"id":"semetey-1-2013:p0518:b004:l008","ordinal":116636,"en":"Stepped on, swaying along."},{"id":"semetey-1-2013:p0518:b004:l009","ordinal":116637,"en":"My poor, wretched mother's"},{"id":"semetey-1-2013:p0518:b004:l010","ordinal":116638,"en":"Blood streamed from her calves;"},{"id":"semetey-1-2013:p0518:b004:l011","ordinal":116639,"en":"The flesh of her soles was gouged away,"},{"id":"semetey-1-2013:p0518:b004:l012","ordinal":116640,"en":"And from all her heels"},{"id":"semetey-1-2013:p0518:b004:l013","ordinal":116641,"en":"The skin was stripped, leaving none intact."},{"id":"semetey-1-2013:p0518:b004:l014","ordinal":116642,"en":"Her dark thighs swelled soft,"},{"id":"semetey-1-2013:p0518:b004:l015","ordinal":116643,"en":"Waterlogged like leather skins."},{"id":"semetey-1-2013:p0518:b004:l016","ordinal":116644,"en":"The two women, tired and weeping,"},{"id":"semetey-1-2013:p0518:b004:l017","ordinal":116645,"en":"Sobbed and cried aloud."},{"id":"semetey-1-2013:p0518:b004:l018","ordinal":116646,"en":"Me, in my swaddling clothes,"},{"id":"semetey-1-2013:p0518:b004:l019","ordinal":116647,"en":"My mother kept safe in one place."},{"id":"semetey-1-2013:p0518:b004:l020","ordinal":116648,"en":"Pure white milk flowed from the plane tree,"},{"id":"semetey-1-2013:p0518:b004:l021","ordinal":116649,"en":"Enveloping my mother."},{"id":"semetey-1-2013:p0518:b004:l022","ordinal":116650,"en":"Food appeared from the unseen world."},{"id":"semetey-1-2013:p0518:b004:l023","ordinal":116651,"en":"Me, the orphan, my God"},{"id":"semetey-1-2013:p0518:b004:l024","ordinal":116652,"en":"Saved in this way."},{"id":"semetey-1-2013:p0518:b004:l025","ordinal":116653,"en":"At the plane tree where his mother had lain,"},{"id":"semetey-1-2013:p0518:b004:l026","ordinal":116654,"en":"Aktulpar beneath him,"},{"id":"semetey-1-2013:p0518:b004:l027","ordinal":116655,"en":"He removed its saddle, leaving it barebacked."},{"id":"semetey-1-2013:p0518:b004:l028","ordinal":116656,"en":"He tethered it to the plane tree,"},{"id":"semetey-1-2013:p0518:b004:l029","ordinal":116657,"en":"Fastening it securely by one foreleg."},{"id":"semetey-1-2013:p0518:b004:l030","ordinal":116658,"en":"Pillowing his head upon the white saddle,"},{"id":"semetey-1-2013:p0518:b004:l031","ordinal":116659,"en":"That dear child born of Manas"},{"id":"semetey-1-2013:p0518:b004:l032","ordinal":116660,"en":"Lay with his head toward Mecca."},{"id":"semetey-1-2013:p0518:b004:l033","ordinal":116661,"en":"Spreading the blue saddlecloth,"},{"id":"semetey-1-2013:p0518:b004:l034","ordinal":116662,"en":"Praying to the one God,"},{"id":"semetey-1-2013:p0518:b004:l035","ordinal":116663,"en":"Pillowing his head upon his sharp sword,"},{"id":"semetey-1-2013:p0518:b004:l036","ordinal":116664,"en":"With his head toward the north,"},{"id":"semetey-1-2013:p0518:b004:l037","ordinal":116665,"en":"Your poor one left by Manas,"},{"id":"semetey-1-2013:p0518:b004:l038","ordinal":116666,"en":"Dipped his hands in the water,"},{"id":"semetey-1-2013:p0518:b004:l039","ordinal":116667,"en":"And performed his hand ablution."},{"id":"semetey-1-2013:p0519:b003:l001","ordinal":116668,"en":"That unyielding warrior lay motionless,"},{"id":"semetey-1-2013:p0519:b003:l002","ordinal":116669,"en":"Praying to the one God,"},{"id":"semetey-1-2013:p0519:b003:l003","ordinal":116670,"en":"Not drawing back his outstretched legs,"},{"id":"semetey-1-2013:p0519:b003:l004","ordinal":116671,"en":"Not opening his closed eyes."},{"id":"semetey-1-2013:p0519:b003:l005","ordinal":116672,"en":"The dear lion left by Manas,"},{"id":"semetey-1-2013:p0519:b003:l006","ordinal":116673,"en":"That proud, cock-like hero,"},{"id":"semetey-1-2013:p0519:b003:l007","ordinal":116674,"en":"Fell into a giant's sleep."},{"id":"semetey-1-2013:p0519:b003:l008","ordinal":116675,"en":"Taking a short rest in sleep,"},{"id":"semetey-1-2013:p0519:b003:l009","ordinal":116676,"en":"His father, fierce Manas,"},{"id":"semetey-1-2013:p0519:b003:l010","ordinal":116677,"en":"That dear one was born to surpass."},{"id":"semetey-1-2013:p0519:b003:l011","ordinal":116678,"en":"Your goshawk left by his father Manas,"},{"id":"semetey-1-2013:p0519:b003:l012","ordinal":116679,"en":"When dawn spread bright,"},{"id":"semetey-1-2013:p0519:b003:l013","ordinal":116680,"en":"When light fell upon the earth,"},{"id":"semetey-1-2013:p0519:b003:l014","ordinal":116681,"en":"When the Scales constellation set,"},{"id":"semetey-1-2013:p0519:b003:l015","ordinal":116682,"en":"When dawn broke clear,"},{"id":"semetey-1-2013:p0519:b003:l016","ordinal":116683,"en":"Awoke with a start from sleep."},{"id":"semetey-1-2013:p0519:b003:l017","ordinal":116684,"en":"Turning like a lion,"},{"id":"semetey-1-2013:p0519:b003:l018","ordinal":116685,"en":"Dipping his hands in the water,"},{"id":"semetey-1-2013:p0519:b003:l019","ordinal":116686,"en":"To his departed father Manas's"},{"id":"semetey-1-2013:p0519:b003:l020","ordinal":116687,"en":"Spirit he prayed."},{"id":"semetey-1-2013:p0519:b003:l021","ordinal":116688,"en":"“It is God's commanded duty,” he said,"},{"id":"semetey-1-2013:p0519:b003:l022","ordinal":116689,"en":"Preparing for prayer."},{"id":"semetey-1-2013:p0519:b003:l023","ordinal":116690,"en":"Two cycles of the dawn prayer"},{"id":"semetey-1-2013:p0519:b003:l024","ordinal":116691,"en":"He managed to recite."},{"id":"semetey-1-2013:p0519:b003:l025","ordinal":116692,"en":"“Amen!” he said, spreading his hands."},{"id":"semetey-1-2013:p0519:b003:l026","ordinal":116693,"en":"As he recited his prayer,"},{"id":"semetey-1-2013:p0519:b003:l027","ordinal":116694,"en":"When he looked at Aktulpar,"},{"id":"semetey-1-2013:p0519:b003:l028","ordinal":116695,"en":"Its head resting toward his feet,"},{"id":"semetey-1-2013:p0519:b003:l029","ordinal":116696,"en":"Its head turned toward Mecca,"},{"id":"semetey-1-2013:p0519:b003:l030","ordinal":116697,"en":"It had no tongue to speak;"},{"id":"semetey-1-2013:p0519:b003:l031","ordinal":116698,"en":"That dear beast, wiser than other animals—"},{"id":"semetey-1-2013:p0519:b003:l032","ordinal":116699,"en":"Aktulpar and Semetey,"},{"id":"semetey-1-2013:p0519:b003:l033","ordinal":116700,"en":"The two lay foot to foot,"},{"id":"semetey-1-2013:p0519:b003:l034","ordinal":116701,"en":"Having slept together."},{"id":"semetey-1-2013:p0519:b003:l035","ordinal":116702,"en":"Quickly saying his prayers,"},{"id":"semetey-1-2013:p0519:b003:l036","ordinal":116703,"en":"The orphan servant left by Manas"},{"id":"semetey-1-2013:p0519:b003:l037","ordinal":116704,"en":"Saddled Aktulpar."},{"id":"semetey-1-2013:p0519:b003:l038","ordinal":116705,"en":"Again the orphan took the road,"},{"id":"semetey-1-2013:p0519:b003:l039","ordinal":116706,"en":"Traveling far, not sparing his horse."},{"id":"semetey-1-2013:p0519:b004:l001","ordinal":116707,"en":"The misty, saddle-shaped ridge"},{"id":"semetey-1-2013:p0519:b004:l002","ordinal":116708,"en":"Was the pass of Aman-Zhol his mother had crossed."},{"id":"semetey-1-2013:p0519:b004:l004","ordinal":116709,"en":"With their ears pricked,"},{"id":"semetey-1-2013:p0519:b004:l005","ordinal":116710,"en":"Wolves did not roam there;"},{"id":"semetey-1-2013:p0519:b004:l006","ordinal":116711,"en":"With their tails trailing,"},{"id":"semetey-1-2013:p0519:b004:l007","ordinal":116712,"en":"Foxes did not roam there."},{"id":"semetey-1-2013:p0519:b004:l008","ordinal":116713,"en":"My poor mother Kanykey,"},{"id":"semetey-1-2013:p0519:b004:l009","ordinal":116714,"en":"The road she trotted like a hunting hound,"},{"id":"semetey-1-2013:p0519:b004:l010","ordinal":116715,"en":"Suffering privation and real hardship,"},{"id":"semetey-1-2013:p0519:b004:l011","ordinal":116716,"en":"Wandering tirelessly on foot,"},{"id":"semetey-1-2013:p0519:b004:l012","ordinal":116717,"en":"Her soles battered by stones,"},{"id":"semetey-1-2013:p0519:b004:l013","ordinal":116718,"en":"Her forehead scorched by the hot sun—"},{"id":"semetey-1-2013:p0519:b004:l014","ordinal":116719,"en":"Aman-Zhol, by which my mother came."},{"id":"semetey-1-2013:p0519:b004:l015","ordinal":116720,"en":"These were my dear mother's words;"},{"id":"semetey-1-2013:p0519:b004:l016","ordinal":116721,"en":"'This is Aman-Zhol,' she said."},{"id":"semetey-1-2013:p0519:b004:l017","ordinal":116722,"en":"Semetey turned aside,"},{"id":"semetey-1-2013:p0519:b004:l018","ordinal":116723,"en":"Not passing peacefully along Aman-Zhol,"},{"id":"semetey-1-2013:p0519:b004:l019","ordinal":116724,"en":"Not leaving quietly without stirring trouble."},{"id":"semetey-1-2013:p0519:b004:l020","ordinal":116725,"en":"He went down through the jutting hollow,"},{"id":"semetey-1-2013:p0519:b004:l021","ordinal":116726,"en":"Crossed the mountain spur hanging before him."},{"id":"semetey-1-2013:p0519:b004:l023","ordinal":116727,"en":"When he reached the overhanging mountain,"},{"id":"semetey-1-2013:p0519:b004:l024","ordinal":116728,"en":"That tireless hero,"},{"id":"semetey-1-2013:p0519:b004:l025","ordinal":116729,"en":"When he climbed its back,"},{"id":"semetey-1-2013:p0519:b004:l026","ordinal":116730,"en":"And set his course along the ridge—"},{"id":"semetey-1-2013:p0519:b004:l027","ordinal":116731,"en":"Let me tell of the valiant one's plight:"},{"id":"semetey-1-2013:p0519:b004:l028","ordinal":116732,"en":"At the sight his attention was drawn."},{"id":"semetey-1-2013:p0519:b004:l029","ordinal":116733,"en":"Shrouded in haze, rising in corners,"},{"id":"semetey-1-2013:p0519:b004:l030","ordinal":116734,"en":"Low mist settled around its jutting edges,"},{"id":"semetey-1-2013:p0519:b004:l031","ordinal":116735,"en":"Dark smoke rose apart."},{"id":"semetey-1-2013:p0519:b004:l032","ordinal":116736,"en":"My mother's precious words—"}]
