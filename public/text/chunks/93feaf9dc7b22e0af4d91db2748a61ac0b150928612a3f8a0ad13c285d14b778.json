[{"id":"manas-2010:p0481:b001:l012","ordinal":22017,"en":"On that battlefield"},{"id":"manas-2010:p0481:b001:l013","ordinal":22018,"en":"Lowered his neck to the earth"},{"id":"manas-2010:p0481:b001:l014","ordinal":22019,"en":"And ran beyond all measure."},{"id":"manas-2010:p0481:b001:l015","ordinal":22020,"en":"Turning Toruchaar's head,"},{"id":"manas-2010:p0481:b001:l016","ordinal":22021,"en":"Among the massed Kytay and Manzhuu,"},{"id":"manas-2010:p0481:b001:l017","ordinal":22022,"en":"He fought and wrought confusion."},{"id":"manas-2010:p0481:b001:l018","ordinal":22023,"en":"He tore through, slaughtering Kytay,"},{"id":"manas-2010:p0481:b001:l019","ordinal":22024,"en":"Spearing wherever he reached."},{"id":"manas-2010:p0481:b001:l020","ordinal":22025,"en":"A tremendous, full battle raged."},{"id":"manas-2010:p0481:b001:l021","ordinal":22026,"en":"Among the jacket-wearing Manzhuu,"},{"id":"manas-2010:p0481:b001:l022","ordinal":22027,"en":"Asking, “Where are their strongest?”"},{"id":"manas-2010:p0481:b001:l023","ordinal":22028,"en":"Khan Zholoy of the Kalmyks"},{"id":"manas-2010:p0481:b001:l024","ordinal":22029,"en":"Was deft among spearmen."},{"id":"manas-2010:p0481:b001:l025","ordinal":22030,"en":"Karazhoy of the Kytay"},{"id":"manas-2010:p0481:b001:l026","ordinal":22031,"en":"Was an exceedingly fine marksman,"},{"id":"manas-2010:p0481:b001:l027","ordinal":22032,"en":"A skilled man who knew the enemy's tricks."},{"id":"manas-2010:p0481:b001:l028","ordinal":22033,"en":"From the side, Ezkara"},{"id":"manas-2010:p0481:b001:l029","ordinal":22034,"en":"Charged in to attack."},{"id":"manas-2010:p0481:b001:l030","ordinal":22035,"en":"“If my appointed death comes, I shall die;"},{"id":"manas-2010:p0481:b001:l031","ordinal":22036,"en":"If I survive and live,"},{"id":"manas-2010:p0481:b001:l032","ordinal":22037,"en":"For my magnanimous lion Manas"},{"id":"manas-2010:p0481:b001:l033","ordinal":22038,"en":"I shall stand as a support,” he said."},{"id":"manas-2010:p0481:b001:l034","ordinal":22039,"en":"Kutubiy had intercepted"},{"id":"manas-2010:p0481:b001:l035","ordinal":22040,"en":"Ezkara at that moment."},{"id":"manas-2010:p0481:b001:l036","ordinal":22041,"en":"Kutu's courage"},{"id":"manas-2010:p0481:b001:l037","ordinal":22042,"en":"Now surpassed all others."},{"id":"manas-2010:p0481:b001:l038","ordinal":22043,"en":"They stood apart from the rest;"},{"id":"manas-2010:p0481:b001:l039","ordinal":22044,"en":"Kutubiy and Ezkara"},{"id":"manas-2010:p0481:b001:l040","ordinal":22045,"en":"Fought one against one."},{"id":"manas-2010:p0481:b001:l041","ordinal":22046,"en":"They gripped their spears,"},{"id":"manas-2010:p0481:b001:l042","ordinal":22047,"en":"Thrusting wherever they found a chance,"},{"id":"manas-2010:p0482:b001:l001","ordinal":22048,"en":"Contriving to find an opening,"},{"id":"manas-2010:p0482:b001:l002","ordinal":22049,"en":"Spearing whoever came close,"},{"id":"manas-2010:p0482:b001:l003","ordinal":22050,"en":"Striking with their battle-axes,"},{"id":"manas-2010:p0482:b001:l004","ordinal":22051,"en":"They stood taunting one another,"},{"id":"manas-2010:p0482:b001:l005","ordinal":22052,"en":"Fighting turn by turn,"},{"id":"manas-2010:p0482:b001:l006","ordinal":22053,"en":"Growing fiercely heated."},{"id":"manas-2010:p0482:b001:l007","ordinal":22054,"en":"When they came within reach,"},{"id":"manas-2010:p0482:b001:l008","ordinal":22055,"en":"They struck with their spears."},{"id":"manas-2010:p0482:b001:l009","ordinal":22056,"en":"Let us leave that there;"},{"id":"manas-2010:p0482:b001:l010","ordinal":22057,"en":"Of your valiant lion Manas,"},{"id":"manas-2010:p0482:b001:l011","ordinal":22058,"en":"Let us begin to tell this deed."},{"id":"manas-2010:p0482:b001:l012","ordinal":22059,"en":"With his armguards looming broad,"},{"id":"manas-2010:p0482:b001:l013","ordinal":22060,"en":"The burly champion sprang to life."},{"id":"manas-2010:p0482:b001:l014","ordinal":22061,"en":"Zholoy of the Kalmyks"},{"id":"manas-2010:p0482:b001:l015","ordinal":22062,"en":"Came before the reckless, magnanimous one,"},{"id":"manas-2010:p0482:b001:l016","ordinal":22063,"en":"Seeking to deceive him face to face."},{"id":"manas-2010:p0482:b001:l017","ordinal":22064,"en":"He turned Achbuudan's head,"},{"id":"manas-2010:p0482:b001:l018","ordinal":22065,"en":"Readied his arms and armor,"},{"id":"manas-2010:p0482:b001:l019","ordinal":22066,"en":"And before the magnanimous lion"},{"id":"manas-2010:p0482:b001:l020","ordinal":22067,"en":"Stood plying his stratagem:"},{"id":"manas-2010:p0482:b001:l021","ordinal":22068,"en":"“Named Manas, you grew puffed up,"},{"id":"manas-2010:p0482:b001:l022","ordinal":22069,"en":"Like a waterskin put in water,"},{"id":"manas-2010:p0482:b001:l023","ordinal":22070,"en":"You swelled and swaggered."},{"id":"manas-2010:p0482:b001:l024","ordinal":22071,"en":"You set your fierce wrath loose."},{"id":"manas-2010:p0482:b001:l025","ordinal":22072,"en":"Of Khan Esen's envoys,"},{"id":"manas-2010:p0482:b001:l026","ordinal":22073,"en":"You slaughtered so many."},{"id":"manas-2010:p0482:b001:l027","ordinal":22074,"en":"You slew the village headman, laying him low;"},{"id":"manas-2010:p0482:b001:l028","ordinal":22075,"en":"You devoured hero Döngö."},{"id":"manas-2010:p0482:b001:l029","ordinal":22076,"en":"Zhorukuyruk and Zhoon the giant—"},{"id":"manas-2010:p0482:b001:l030","ordinal":22077,"en":"You swallowed all, leaving none."},{"id":"manas-2010:p0482:b001:l031","ordinal":22078,"en":"When the horde came, did you mow it down?"},{"id":"manas-2010:p0482:b001:l032","ordinal":22079,"en":"Your deeds are no small matter."},{"id":"manas-2010:p0482:b001:l033","ordinal":22080,"en":"Did you suck dry those who attacked?"},{"id":"manas-2010:p0482:b001:l034","ordinal":22081,"en":"Saying, “I conquered the champions,”"},{"id":"manas-2010:p0482:b001:l035","ordinal":22082,"en":"You have grown puffed up."},{"id":"manas-2010:p0482:b001:l036","ordinal":22083,"en":"Saying, “I bow to no one in the world,”"},{"id":"manas-2010:p0482:b001:l037","ordinal":22084,"en":"You have grown full of swagger."},{"id":"manas-2010:p0482:b001:l038","ordinal":22085,"en":"Take full measure of who I am:"},{"id":"manas-2010:p0482:b001:l039","ordinal":22086,"en":"I am the mighty, renowned Zholoy."},{"id":"manas-2010:p0482:b001:l040","ordinal":22087,"en":"When your forefather Karakan died,"},{"id":"manas-2010:p0482:b001:l041","ordinal":22088,"en":"These Burut standing here—"},{"id":"manas-2010:p0482:b001:l042","ordinal":22089,"en":"This very hand of mine set them straight!"},{"id":"manas-2010:p0483:b001:l001","ordinal":22090,"en":"My wrath rose; I stood defiant."},{"id":"manas-2010:p0483:b001:l002","ordinal":22091,"en":"By killing Khan Orgo,"},{"id":"manas-2010:p0483:b001:l003","ordinal":22092,"en":"You have roused my fury now!"},{"id":"manas-2010:p0483:b001:l004","ordinal":22093,"en":"I shall gird my waist tight;"},{"id":"manas-2010:p0483:b001:l005","ordinal":22094,"en":"Just watch: I shall drive you"},{"id":"manas-2010:p0483:b001:l006","ordinal":22095,"en":"All the way to Mecca!"},{"id":"manas-2010:p0483:b001:l007","ordinal":22096,"en":"You reckless blood-drinker,"},{"id":"manas-2010:p0483:b001:l008","ordinal":22097,"en":"My name is Zholoy the champion;"},{"id":"manas-2010:p0483:b001:l009","ordinal":22098,"en":"Come here and let me see you!”"},{"id":"manas-2010:p0483:b001:l010","ordinal":22099,"en":"So spoke the hero Zholoy,"},{"id":"manas-2010:p0483:b001:l011","ordinal":22100,"en":"Standing there, whirling his spear."},{"id":"manas-2010:p0483:b001:l012","ordinal":22101,"en":"When Manas saw this,"},{"id":"manas-2010:p0483:b001:l013","ordinal":22102,"en":"He unleashed his wrath."},{"id":"manas-2010:p0483:b001:l014","ordinal":22103,"en":"The youngest of the six lions,"},{"id":"manas-2010:p0483:b001:l015","ordinal":22104,"en":"The leopard mighty in spirit,"},{"id":"manas-2010:p0483:b001:l016","ordinal":22105,"en":"Cast all care for life aside."},{"id":"manas-2010:p0483:b001:l017","ordinal":22106,"en":"Such was the blood-drinker's way:"},{"id":"manas-2010:p0483:b001:l018","ordinal":22107,"en":"He prepared himself in fury."},{"id":"manas-2010:p0483:b001:l019","ordinal":22108,"en":"To the blood-drinker himself"},{"id":"manas-2010:p0483:b001:l020","ordinal":22109,"en":"An unseen inspiration came:"},{"id":"manas-2010:p0483:b001:l021","ordinal":22110,"en":"“You fled in a flurry when I faced you—"},{"id":"manas-2010:p0483:b001:l022","ordinal":22111,"en":"So that is the infidel you are!"},{"id":"manas-2010:p0483:b001:l023","ordinal":22112,"en":"You let all the monks be slaughtered,"},{"id":"manas-2010:p0483:b001:l024","ordinal":22113,"en":"And now you come to quarrel:"},{"id":"manas-2010:p0483:b001:l025","ordinal":22114,"en":"Zholoy, what a hero you have become!"},{"id":"manas-2010:p0483:b001:l026","ordinal":22115,"en":"The black poplars of wide Altai—"},{"id":"manas-2010:p0483:b001:l027","ordinal":22116,"en":"Of the poplar-covered promontories,"},{"id":"manas-2010:p0483:b001:l028","ordinal":22117,"en":"When I reached twelve years of age,"},{"id":"manas-2010:p0483:b001:l029","ordinal":22118,"en":"I brought hell upon you all,"},{"id":"manas-2010:p0483:b001:l030","ordinal":22119,"en":"Slitting the monks' throats,"},{"id":"manas-2010:p0483:b001:l031","ordinal":22120,"en":"And seized your tea on a thousand camels."},{"id":"manas-2010:p0483:b001:l032","ordinal":22121,"en":"You babbling, crafty Kalmyk,"},{"id":"manas-2010:p0483:b001:l033","ordinal":22122,"en":"Where had you gone then?"},{"id":"manas-2010:p0483:b001:l034","ordinal":22123,"en":"When I chased your great army,"},{"id":"manas-2010:p0483:b001:l035","ordinal":22124,"en":"Drove it from Altai and scattered it,"},{"id":"manas-2010:p0483:b001:l036","ordinal":22125,"en":"You scurried away before me."},{"id":"manas-2010:p0483:b001:l037","ordinal":22126,"en":"Damn you, greedy dog,"},{"id":"manas-2010:p0483:b001:l038","ordinal":22127,"en":"When you fled toward Esenkan,"},{"id":"manas-2010:p0483:b001:l039","ordinal":22128,"en":"I unleashed my wrath"},{"id":"manas-2010:p0483:b001:l040","ordinal":22129,"en":"And slaughtered your people!”"},{"id":"manas-2010:p0483:b001:l041","ordinal":22130,"en":"The blood-drinker, the fierce-maned leopard,"},{"id":"manas-2010:p0483:b001:l042","ordinal":22131,"en":"Great Manas, born resourceful,"},{"id":"manas-2010:p0484:b001:l001","ordinal":22132,"en":"Who never shrank from a clash,"},{"id":"manas-2010:p0484:b001:l002","ordinal":22133,"en":"Great Manas, born open-handed,"},{"id":"manas-2010:p0484:b001:l003","ordinal":22134,"en":"Took his immense steel spear"},{"id":"manas-2010:p0484:b001:l004","ordinal":22135,"en":"And settled it in his grip."},{"id":"manas-2010:p0484:b001:l005","ordinal":22136,"en":"“Right at the heart,” he thought,"},{"id":"manas-2010:p0484:b001:l006","ordinal":22137,"en":"“Here, at the lung's edge,"},{"id":"manas-2010:p0484:b001:l007","ordinal":22138,"en":"At the windpipe itself—"},{"id":"manas-2010:p0484:b001:l008","ordinal":22139,"en":"For that bastard Orgo,"},{"id":"manas-2010:p0484:b001:l009","ordinal":22140,"en":"It is time to gasp and rattle.”"},{"id":"manas-2010:p0484:b001:l010","ordinal":22141,"en":"The fierce-maned one's ways were different:"},{"id":"manas-2010:p0484:b001:l011","ordinal":22142,"en":"That born champion, poor fellow,"},{"id":"manas-2010:p0484:b001:l012","ordinal":22143,"en":"Hunched behind the ridge,"},{"id":"manas-2010:p0484:b001:l013","ordinal":22144,"en":"His blood-drinking eyes then"},{"id":"manas-2010:p0484:b001:l014","ordinal":22145,"en":"Seemed about to leap out,"},{"id":"manas-2010:p0484:b001:l015","ordinal":22146,"en":"Staring from the farther side."},{"id":"manas-2010:p0484:b001:l016","ordinal":22147,"en":"His ribs creaked;"},{"id":"manas-2010:p0484:b001:l017","ordinal":22148,"en":"His prominent front teeth"},{"id":"manas-2010:p0484:b001:l018","ordinal":22149,"en":"Crackled like millet."},{"id":"manas-2010:p0484:b001:l019","ordinal":22150,"en":"Without looking around him,"},{"id":"manas-2010:p0484:b001:l020","ordinal":22151,"en":"Without sparing his life at all:"},{"id":"manas-2010:p0484:b001:l021","ordinal":22152,"en":"“Upon Orgo, huge as Opol Mountain,"},{"id":"manas-2010:p0484:b001:l022","ordinal":22153,"en":"I unleashed my wrath."},{"id":"manas-2010:p0484:b001:l023","ordinal":22154,"en":"Your cattle, not your horses,"},{"id":"manas-2010:p0484:b001:l024","ordinal":22155,"en":"I utterly wiped out."},{"id":"manas-2010:p0484:b001:l025","ordinal":22156,"en":"Where were you then?"},{"id":"manas-2010:p0484:b001:l026","ordinal":22157,"en":"If you truly mean to fight,"},{"id":"manas-2010:p0484:b001:l027","ordinal":22158,"en":"Great Zholoy of the Kalmyks,"},{"id":"manas-2010:p0484:b001:l028","ordinal":22159,"en":"Stand your ground ahead; do not flee!”"},{"id":"manas-2010:p0484:b001:l029","ordinal":22160,"en":"So spoke the hero Manas."},{"id":"manas-2010:p0484:b001:l030","ordinal":22161,"en":"He headed for Khan Zholoy,"},{"id":"manas-2010:p0484:b001:l031","ordinal":22162,"en":"His eyes a tiger's eyes,"},{"id":"manas-2010:p0484:b001:l032","ordinal":22163,"en":"His wrath a dragon's wrath."},{"id":"manas-2010:p0484:b001:l033","ordinal":22164,"en":"Without closing his open eyes,"},{"id":"manas-2010:p0484:b001:l034","ordinal":22165,"en":"Without drawing back his leveled spear,"},{"id":"manas-2010:p0484:b001:l035","ordinal":22166,"en":"With wrath entering his arm,"},{"id":"manas-2010:p0484:b001:l036","ordinal":22167,"en":"With courage entering his heart,"},{"id":"manas-2010:p0484:b001:l037","ordinal":22168,"en":"He struck Toruchaar on the flank"},{"id":"manas-2010:p0484:b001:l038","ordinal":22169,"en":"And took his painted spear in hand."},{"id":"manas-2010:p0484:b001:l039","ordinal":22170,"en":"His wide eyes blazed;"},{"id":"manas-2010:p0484:b001:l040","ordinal":22171,"en":"The peerless, fierce-maned champion's"},{"id":"manas-2010:p0484:b001:l041","ordinal":22172,"en":"Bloodlust truly seized him."},{"id":"manas-2010:p0484:b001:l042","ordinal":22173,"en":"A company of nine protectors"},{"id":"manas-2010:p0485:b001:l001","ordinal":22174,"en":"Had come to give him their aid;"},{"id":"manas-2010:p0485:b001:l002","ordinal":22175,"en":"A company of nine supporters"},{"id":"manas-2010:p0485:b001:l003","ordinal":22176,"en":"Had come to uphold him."},{"id":"manas-2010:p0485:b001:l004","ordinal":22177,"en":"He thundered forward, spear extended,"},{"id":"manas-2010:p0485:b001:l005","ordinal":22178,"en":"And in the blink of an eye,"},{"id":"manas-2010:p0485:b001:l006","ordinal":22179,"en":"As he was about to reach Zholoy,"},{"id":"manas-2010:p0485:b001:l007","ordinal":22180,"en":"Khan Zholoy of the Kalmyks—"},{"id":"manas-2010:p0485:b001:l008","ordinal":22181,"en":"That Zholoy was indeed a mere boy—"},{"id":"manas-2010:p0485:b001:l009","ordinal":22182,"en":"Could not endure his heat,"},{"id":"manas-2010:p0485:b001:l010","ordinal":22183,"en":"Could not withstand his cold."},{"id":"manas-2010:p0485:b001:l011","ordinal":22184,"en":"Unable to turn Achbuudan's head,"},{"id":"manas-2010:p0485:b001:l012","ordinal":22185,"en":"When he saw the lion's bearing,"},{"id":"manas-2010:p0485:b001:l013","ordinal":22186,"en":"Zholoy could not stand his ground."},{"id":"manas-2010:p0485:b001:l014","ordinal":22187,"en":"Twisting his neck like a stag,"},{"id":"manas-2010:p0485:b001:l015","ordinal":22188,"en":"Toward a rocky outcrop a bowshot away"},{"id":"manas-2010:p0485:b001:l016","ordinal":22189,"en":"He went galloping up."},{"id":"manas-2010:p0485:b001:l017","ordinal":22190,"en":"Toruchaar beneath him,"},{"id":"manas-2010:p0485:b001:l018","ordinal":22191,"en":"That true winged steed,"},{"id":"manas-2010:p0485:b001:l019","ordinal":22192,"en":"Went wild and strained,"},{"id":"manas-2010:p0485:b001:l020","ordinal":22193,"en":"Toruchaar, running loose,"},{"id":"manas-2010:p0485:b001:l021","ordinal":22194,"en":"Straining as though his rider had died."},{"id":"manas-2010:p0485:b001:l022","ordinal":22195,"en":"From the winding ridge,"},{"id":"manas-2010:p0485:b001:l023","ordinal":22196,"en":"Before he could wheel back steadily,"},{"id":"manas-2010:p0485:b001:l024","ordinal":22197,"en":"Before turning his swift horse"},{"id":"manas-2010:p0485:b001:l025","ordinal":22198,"en":"And coming back toward Zholoy,"},{"id":"manas-2010:p0485:b001:l026","ordinal":22199,"en":"The hero Manas was in a frenzy."},{"id":"manas-2010:p0485:b001:l027","ordinal":22200,"en":"There on the farther side, a great marksman—"},{"id":"manas-2010:p0485:b001:l028","ordinal":22201,"en":"Karazhoy—lay in his path."},{"id":"manas-2010:p0485:b001:l029","ordinal":22202,"en":"He performed deeds unlike other men's,"},{"id":"manas-2010:p0485:b001:l030","ordinal":22203,"en":"Assuming many different forms."},{"id":"manas-2010:p0485:b001:l031","ordinal":22204,"en":"A man who emerged when China was in turmoil,"},{"id":"manas-2010:p0485:b001:l032","ordinal":22205,"en":"A great marksman of the royal treasury,"},{"id":"manas-2010:p0485:b001:l033","ordinal":22206,"en":"He raised an uproar when challenged."},{"id":"manas-2010:p0485:b001:l034","ordinal":22207,"en":"That infidel Karazhoy,"},{"id":"manas-2010:p0485:b001:l035","ordinal":22208,"en":"An exceptional weather-conjurer and trickster,"},{"id":"manas-2010:p0485:b001:l036","ordinal":22209,"en":"Had outstripped others in cunning."},{"id":"manas-2010:p0485:b001:l037","ordinal":22210,"en":"A black boulder as large as a hut—"},{"id":"manas-2010:p0485:b001:l038","ordinal":22211,"en":"From that black boulder, for Manas"},{"id":"manas-2010:p0485:b001:l039","ordinal":22212,"en":"The swinish marksman lay in wait."},{"id":"manas-2010:p0485:b001:l040","ordinal":22213,"en":"A master of marksmanship,"},{"id":"manas-2010:p0485:b001:l041","ordinal":22214,"en":"When Manas approached him,"},{"id":"manas-2010:p0485:b001:l042","ordinal":22215,"en":"His firing mechanism stood ready."},{"id":"manas-2010:p0486:b001:l001","ordinal":22216,"en":"“At the short ribs,” he said,"},{"id":"manas-2010:p0486:b001:l002","ordinal":22217,"en":"“On this side where the girth is drawn,"},{"id":"manas-2010:p0486:b001:l003","ordinal":22218,"en":"At the lower edge of the saddlecloth,” he said."},{"id":"manas-2010:p0486:b001:l004","ordinal":22219,"en":"That hero Karazhoy of yours,"},{"id":"manas-2010:p0486:b001:l005","ordinal":22220,"en":"Whose aim never strayed,"},{"id":"manas-2010:p0486:b001:l006","ordinal":22221,"en":"Whose shot never passed in vain,"},{"id":"manas-2010:p0486:b001:l007","ordinal":22222,"en":"Was no ordinary man, but a great marksman."},{"id":"manas-2010:p0486:b001:l008","ordinal":22223,"en":"Your wolf-man wheeled about,"},{"id":"manas-2010:p0486:b001:l009","ordinal":22224,"en":"And dashed toward Zholoy."},{"id":"manas-2010:p0486:b001:l010","ordinal":22225,"en":"Wearing a dark green coat,"},{"id":"manas-2010:p0486:b001:l011","ordinal":22226,"en":"That renowned marksman Karazhoy"},{"id":"manas-2010:p0486:b001:l012","ordinal":22227,"en":"Struck Toruchaar once."},{"id":"manas-2010:p0486:b001:l013","ordinal":22228,"en":"Toruchaar, that wondrous swift one,"},{"id":"manas-2010:p0486:b001:l014","ordinal":22229,"en":"Stumbled and fell straight down."},{"id":"manas-2010:p0486:b001:l015","ordinal":22230,"en":"His eyes reddening like a wild ram's,"},{"id":"manas-2010:p0486:b001:l016","ordinal":22231,"en":"When that madman fired,"},{"id":"manas-2010:p0486:b001:l017","ordinal":22232,"en":"He collapsed upon that spot."},{"id":"manas-2010:p0486:b001:l018","ordinal":22233,"en":"Stepping unsteadily, holding himself back,"},{"id":"manas-2010:p0486:b001:l019","ordinal":22234,"en":"When the unbelievers swept upon him,"},{"id":"manas-2010:p0486:b001:l020","ordinal":22235,"en":"The wolf-man lion stood"},{"id":"manas-2010:p0486:b001:l021","ordinal":22236,"en":"Leaning on Bozkelte."},{"id":"manas-2010:p0486:b001:l022","ordinal":22237,"en":"He grew sorrowful and grieved:"},{"id":"manas-2010:p0486:b001:l023","ordinal":22238,"en":"Joined when small as a louse,"},{"id":"manas-2010:p0486:b001:l024","ordinal":22239,"en":"United when small as a thumb,"},{"id":"manas-2010:p0486:b001:l025","ordinal":22240,"en":"He had lost Toruchaar."},{"id":"manas-2010:p0486:b001:l026","ordinal":22241,"en":"The war drums beat hard;"},{"id":"manas-2010:p0486:b001:l027","ordinal":22242,"en":"The many seething lords,"},{"id":"manas-2010:p0486:b001:l028","ordinal":22243,"en":"Their Torguts all assembled,"},{"id":"manas-2010:p0486:b001:l029","ordinal":22244,"en":"Rose as one and massed upon him."},{"id":"manas-2010:p0486:b001:l030","ordinal":22245,"en":"When he looked to this side,"},{"id":"manas-2010:p0486:b001:l031","ordinal":22246,"en":"Ezkara and Zholoy shouted,"},{"id":"manas-2010:p0486:b001:l032","ordinal":22247,"en":"With beaded plumes and coral stones,"},{"id":"manas-2010:p0486:b001:l033","ordinal":22248,"en":"They called to their khans standing there:"},{"id":"manas-2010:p0486:b001:l034","ordinal":22249,"en":"“Mighty khans in jackets,"},{"id":"manas-2010:p0486:b001:l035","ordinal":22250,"en":"Thunder forward all together!"},{"id":"manas-2010:p0486:b001:l036","ordinal":22251,"en":"You finest officials with rank buttons on your caps,"},{"id":"manas-2010:p0486:b001:l037","ordinal":22252,"en":"That daughter-damned Burut,"},{"id":"manas-2010:p0486:b001:l038","ordinal":22253,"en":"Trample him into the bare ground!"},{"id":"manas-2010:p0486:b001:l039","ordinal":22254,"en":"Put a rawhide punishment cap upon his head,"},{"id":"manas-2010:p0486:b001:l040","ordinal":22255,"en":"Bind both his hands,"},{"id":"manas-2010:p0486:b001:l041","ordinal":22256,"en":"Gouge out both his eyes,"},{"id":"manas-2010:p0486:b001:l042","ordinal":22257,"en":"Before warrior Esen,"},{"id":"manas-2010:p0487:b001:l001","ordinal":22258,"en":"Bring him bound alive!"},{"id":"manas-2010:p0487:b001:l002","ordinal":22259,"en":"The foremost emperor, Bakburchun—"},{"id":"manas-2010:p0487:b001:l003","ordinal":22260,"en":"Ask him for khanship!"},{"id":"manas-2010:p0487:b001:l004","ordinal":22261,"en":"You with nets of iron rope,"},{"id":"manas-2010:p0487:b001:l005","ordinal":22262,"en":"Spur forward and cast your lassos!"},{"id":"manas-2010:p0487:b001:l006","ordinal":22263,"en":"You all armed with daggers,"},{"id":"manas-2010:p0487:b001:l007","ordinal":22264,"en":"Advance each from your own side!"},{"id":"manas-2010:p0487:b001:l008","ordinal":22265,"en":"That daughter-damned bloodthirsty one,"},{"id":"manas-2010:p0487:b001:l009","ordinal":22266,"en":"Destroy him utterly,"},{"id":"manas-2010:p0487:b001:l010","ordinal":22267,"en":"That deceiver who wrecks the world!"},{"id":"manas-2010:p0487:b001:l011","ordinal":22268,"en":"Bring calamity upon his head;"},{"id":"manas-2010:p0487:b001:l012","ordinal":22269,"en":"That bristling wolf-man,"},{"id":"manas-2010:p0487:b001:l013","ordinal":22270,"en":"Bind him alive!”"},{"id":"manas-2010:p0487:b001:l014","ordinal":22271,"en":"When they heard this order,"},{"id":"manas-2010:p0487:b001:l015","ordinal":22272,"en":"Their champions swept forward, swarming."}]
