[{"id":"manas-2010:p1221:b001:l003","ordinal":52993,"en":"Pouring onward in a swarm;"},{"id":"manas-2010:p1221:b001:l004","ordinal":52994,"en":"Leaving no earth uncovered,"},{"id":"manas-2010:p1221:b001:l005","ordinal":52995,"en":"They surged and seethed along."},{"id":"manas-2010:p1221:b001:l006","ordinal":52996,"en":"Growing stronger as they went,"},{"id":"manas-2010:p1221:b001:l007","ordinal":52997,"en":"Those splendid swift horses,"},{"id":"manas-2010:p1221:b001:l008","ordinal":52998,"en":"Their flesh now hardened,"},{"id":"manas-2010:p1221:b001:l009","ordinal":52999,"en":"Bit one another like wild asses"},{"id":"manas-2010:p1221:b001:l010","ordinal":53000,"en":"And went along at play."},{"id":"manas-2010:p1221:b001:l011","ordinal":53001,"en":"The dust turned their day to night."},{"id":"manas-2010:p1221:b001:l012","ordinal":53002,"en":"From their first seizing of the herd"},{"id":"manas-2010:p1221:b001:l013","ordinal":53003,"en":"To their coming across the river,"},{"id":"manas-2010:p1221:b001:l014","ordinal":53004,"en":"Exactly twelve days had passed."},{"id":"manas-2010:p1221:b001:l015","ordinal":53005,"en":"Golden forelock, tasseled belt—"},{"id":"manas-2010:p1221:b001:l016","ordinal":53006,"en":"Azizkhan's champion"},{"id":"manas-2010:p1221:b001:l017","ordinal":53007,"en":"From the very first, about the Fierce One,"},{"id":"manas-2010:p1221:b001:l018","ordinal":53008,"en":"Had been saying these words:"},{"id":"manas-2010:p1221:b001:l019","ordinal":53009,"en":"Alöökö's Kongurbay"},{"id":"manas-2010:p1221:b001:l020","ordinal":53010,"en":"Would catch up from behind in pursuit"},{"id":"manas-2010:p1221:b001:l021","ordinal":53011,"en":"And fight him—such was his suspicion."},{"id":"manas-2010:p1221:b001:l022","ordinal":53012,"en":"When Almambet was among the Chinese,"},{"id":"manas-2010:p1221:b001:l023","ordinal":53013,"en":"His forelock bright with crimson,"},{"id":"manas-2010:p1221:b001:l024","ordinal":53014,"en":"Had he not worn it braided?"},{"id":"manas-2010:p1221:b001:l025","ordinal":53015,"en":"Among the two Chinese of the forty khans,"},{"id":"manas-2010:p1221:b001:l026","ordinal":53016,"en":"He had first wrought slaughter;"},{"id":"manas-2010:p1221:b001:l027","ordinal":53017,"en":"His mother became a martyr—"},{"id":"manas-2010:p1221:b001:l028","ordinal":53018,"en":"Had he not come away with her dead?"},{"id":"manas-2010:p1221:b001:l029","ordinal":53019,"en":"The Chinese people were forty khans' people;"},{"id":"manas-2010:p1221:b001:l030","ordinal":53020,"en":"Fighting, slaughtered and ruined,"},{"id":"manas-2010:p1221:b001:l031","ordinal":53021,"en":"Stained with crimson blood,"},{"id":"manas-2010:p1221:b001:l032","ordinal":53022,"en":"That fierce warfare and slaughter—"},{"id":"manas-2010:p1221:b001:l033","ordinal":53023,"en":"Almambet, the fierce-maned champion,"},{"id":"manas-2010:p1221:b001:l034","ordinal":53024,"en":"Had he not seen it all?"},{"id":"manas-2010:p1221:b001:l035","ordinal":53025,"en":"Almambet wheeled his mount,"},{"id":"manas-2010:p1221:b001:l036","ordinal":53026,"en":"A true, resolute lion:"},{"id":"manas-2010:p1221:b001:l037","ordinal":53027,"en":"“Let me look behind me,” he said."},{"id":"manas-2010:p1221:b001:l038","ordinal":53028,"en":"To a level ridge and rise"},{"id":"manas-2010:p1221:b001:l039","ordinal":53029,"en":"He rode up,"},{"id":"manas-2010:p1221:b001:l040","ordinal":53030,"en":"Turning his eyes toward Beijing,"},{"id":"manas-2010:p1221:b001:l041","ordinal":53031,"en":"At the shaven-headed ones, a lake in number,"},{"id":"manas-2010:p1221:b001:l042","ordinal":53032,"en":"He cast his gaze."},{"id":"manas-2010:p1222:b001:l001","ordinal":53033,"en":"While Almambet was looking,"},{"id":"manas-2010:p1222:b001:l002","ordinal":53034,"en":"Karagul, who had been wounded,"},{"id":"manas-2010:p1222:b001:l003","ordinal":53035,"en":"Had fled and reached Beijing."},{"id":"manas-2010:p1222:b001:l004","ordinal":53036,"en":"To the city where the emperor stayed"},{"id":"manas-2010:p1222:b001:l005","ordinal":53037,"en":"He had come and delivered the news:"},{"id":"manas-2010:p1222:b001:l006","ordinal":53038,"en":"“Almambet and Syrgak together"},{"id":"manas-2010:p1222:b001:l007","ordinal":53039,"en":"Have taken away the horses!"},{"id":"manas-2010:p1222:b001:l008","ordinal":53040,"en":"The forty herders and Zhanybay—"},{"id":"manas-2010:p1222:b001:l009","ordinal":53041,"en":"Slaughtering and felling them all,"},{"id":"manas-2010:p1222:b001:l010","ordinal":53042,"en":"Shattering every one of us,"},{"id":"manas-2010:p1222:b001:l011","ordinal":53043,"en":"They have shaken us out of sleep."},{"id":"manas-2010:p1222:b001:l012","ordinal":53044,"en":"The Buruts have slaughtered"},{"id":"manas-2010:p1222:b001:l013","ordinal":53045,"en":"Your lion on guard;"},{"id":"manas-2010:p1222:b001:l014","ordinal":53046,"en":"The accursed men have broken"},{"id":"manas-2010:p1222:b001:l015","ordinal":53047,"en":"The strength on which you leaned."},{"id":"manas-2010:p1222:b001:l016","ordinal":53048,"en":"‘I scouted the furthest outpost,’ he said,"},{"id":"manas-2010:p1222:b001:l017","ordinal":53049,"en":"‘Of the Buruts in their tens of thousands"},{"id":"manas-2010:p1222:b001:l018","ordinal":53050,"en":"I reached their very heart,’ he said—"},{"id":"manas-2010:p1222:b001:l019","ordinal":53051,"en":"That cursed Fierce One, Kongurbay,"},{"id":"manas-2010:p1222:b001:l020","ordinal":53052,"en":"Look at the lies he told!”"},{"id":"manas-2010:p1222:b001:l021","ordinal":53053,"en":"When he heard this news,"},{"id":"manas-2010:p1222:b001:l022","ordinal":53054,"en":"Kongurbay, son of Alöökö,"},{"id":"manas-2010:p1222:b001:l023","ordinal":53055,"en":"Raged and struggled;"},{"id":"manas-2010:p1222:b001:l024","ordinal":53056,"en":"The Fierce One began an uproar."},{"id":"manas-2010:p1222:b001:l025","ordinal":53057,"en":"Unable to withstand his fury,"},{"id":"manas-2010:p1222:b001:l026","ordinal":53058,"en":"The Chinese people of forty khans"},{"id":"manas-2010:p1222:b001:l027","ordinal":53059,"en":"Almost broke apart."},{"id":"manas-2010:p1222:b001:l028","ordinal":53060,"en":"“The most skilled riders,"},{"id":"manas-2010:p1222:b001:l029","ordinal":53061,"en":"The finest of the spearmen,"},{"id":"manas-2010:p1222:b001:l030","ordinal":53062,"en":"I shall gather!” Karykan said,"},{"id":"manas-2010:p1222:b001:l031","ordinal":53063,"en":"Roaring as though possessed by a demon."},{"id":"manas-2010:p1222:b001:l032","ordinal":53064,"en":"Putting Kongurbay at their head,"},{"id":"manas-2010:p1222:b001:l033","ordinal":53065,"en":"He summoned his chosen champions."},{"id":"manas-2010:p1222:b001:l034","ordinal":53066,"en":"“The Buruts who attacked us themselves—"},{"id":"manas-2010:p1222:b001:l035","ordinal":53067,"en":"Drive them on and destroy them!"},{"id":"manas-2010:p1222:b001:l036","ordinal":53068,"en":"Press them from behind!"},{"id":"manas-2010:p1222:b001:l037","ordinal":53069,"en":"Those Buruts, no more than a handful,"},{"id":"manas-2010:p1222:b001:l038","ordinal":53070,"en":"Have brought their suffering upon themselves."},{"id":"manas-2010:p1222:b001:l039","ordinal":53071,"en":"Those who attacked us first,"},{"id":"manas-2010:p1222:b001:l040","ordinal":53072,"en":"Leaving not one behind, toward their own land,"},{"id":"manas-2010:p1222:b001:l041","ordinal":53073,"en":"Drive them toward their homeland!”"},{"id":"manas-2010:p1222:b001:l042","ordinal":53074,"en":"Saying this, Karykan,"},{"id":"manas-2010:p1223:b001:l001","ordinal":53075,"en":"Upon a fierce man like Kongurbay"},{"id":"manas-2010:p1223:b001:l002","ordinal":53076,"en":"Put blue iron armor,"},{"id":"manas-2010:p1223:b001:l003","ordinal":53077,"en":"And mounted him on Algara."},{"id":"manas-2010:p1223:b001:l004","ordinal":53078,"en":"Giving him ten thousand shaven-headed troops,"},{"id":"manas-2010:p1223:b001:l005","ordinal":53079,"en":"And giving thousands of champions too,"},{"id":"manas-2010:p1223:b001:l006","ordinal":53080,"en":"He sent him in pursuit."},{"id":"manas-2010:p1223:b001:l007","ordinal":53081,"en":"Behind this man,"},{"id":"manas-2010:p1223:b001:l008","ordinal":53082,"en":"Clothing him in shot-proof armor,"},{"id":"manas-2010:p1223:b001:l009","ordinal":53083,"en":"Mounting him on Chongküröng,"},{"id":"manas-2010:p1223:b001:l010","ordinal":53084,"en":"Ezkara, khan of the Manzhuu—"},{"id":"manas-2010:p1223:b001:l011","ordinal":53085,"en":"He sent Ezkara forth."},{"id":"manas-2010:p1223:b001:l012","ordinal":53086,"en":"“Sweep over them and wage war!"},{"id":"manas-2010:p1223:b001:l013","ordinal":53087,"en":"Not only the Buruts' daughters,"},{"id":"manas-2010:p1223:b001:l014","ordinal":53088,"en":"Seize even their wives as plunder!”"},{"id":"manas-2010:p1223:b001:l015","ordinal":53089,"en":"His great lama champion,"},{"id":"manas-2010:p1223:b001:l016","ordinal":53090,"en":"The Kalmak, mighty Zholoy,"},{"id":"manas-2010:p1223:b001:l017","ordinal":53091,"en":"He sent along as well."},{"id":"manas-2010:p1223:b001:l018","ordinal":53092,"en":"“Strike slaughter from their flank;"},{"id":"manas-2010:p1223:b001:l019","ordinal":53093,"en":"If you can, the fugitive"},{"id":"manas-2010:p1223:b001:l020","ordinal":53094,"en":"Capture alive!” he said."},{"id":"manas-2010:p1223:b001:l021","ordinal":53095,"en":"Börüköz, son of Esenkan,"},{"id":"manas-2010:p1223:b001:l022","ordinal":53096,"en":"He sent along as well."},{"id":"manas-2010:p1223:b001:l023","ordinal":53097,"en":"Giving him a force of swift foot-runners,"},{"id":"manas-2010:p1223:b001:l024","ordinal":53098,"en":"Into the runners' hands"},{"id":"manas-2010:p1223:b001:l025","ordinal":53099,"en":"Putting nets that would not break,"},{"id":"manas-2010:p1223:b001:l026","ordinal":53100,"en":"The earth flew up and turned to dust."},{"id":"manas-2010:p1223:b001:l027","ordinal":53101,"en":"“To take us captive—"},{"id":"manas-2010:p1223:b001:l028","ordinal":53102,"en":"Oh, my Syrgak, listen!"},{"id":"manas-2010:p1223:b001:l029","ordinal":53103,"en":"All twelve Beijings have risen."},{"id":"manas-2010:p1223:b001:l030","ordinal":53104,"en":"Perish with your horses!"},{"id":"manas-2010:p1223:b001:l031","ordinal":53105,"en":"My joy, Syrgak, stop a moment."},{"id":"manas-2010:p1223:b001:l032","ordinal":53106,"en":"What times, what a day,"},{"id":"manas-2010:p1223:b001:l033","ordinal":53107,"en":"My darling Syrgak,"},{"id":"manas-2010:p1223:b001:l034","ordinal":53108,"en":"What sort of night will there be?"},{"id":"manas-2010:p1223:b001:l035","ordinal":53109,"en":"Those ugly infidels"},{"id":"manas-2010:p1223:b001:l036","ordinal":53110,"en":"Will rage against us, I fear;"},{"id":"manas-2010:p1223:b001:l037","ordinal":53111,"en":"The massed Chinese, in their numbers,"},{"id":"manas-2010:p1223:b001:l038","ordinal":53112,"en":"Will capture us alive, I fear!"},{"id":"manas-2010:p1223:b001:l039","ordinal":53113,"en":"Look at the reeds, look at the flood,"},{"id":"manas-2010:p1223:b001:l040","ordinal":53114,"en":"Look at the Chinese people pouring over us!"},{"id":"manas-2010:p1223:b001:l041","ordinal":53115,"en":"Swarming out behind you,"},{"id":"manas-2010:p1223:b001:l042","ordinal":53116,"en":"See the Chinese multitude, like sand."},{"id":"manas-2010:p1224:b001:l001","ordinal":53117,"en":"Men's heads knock together;"},{"id":"manas-2010:p1224:b001:l002","ordinal":53118,"en":"Lance-tips clash together;"},{"id":"manas-2010:p1224:b001:l003","ordinal":53119,"en":"The earth turns and sways."},{"id":"manas-2010:p1224:b001:l004","ordinal":53120,"en":"Within that Chinese host"},{"id":"manas-2010:p1224:b001:l005","ordinal":53121,"en":"Their great champion, the Fierce One, comes."},{"id":"manas-2010:p1224:b001:l006","ordinal":53122,"en":"Listen, my Syrgak:"},{"id":"manas-2010:p1224:b001:l007","ordinal":53123,"en":"Terrible pressure upon our lives is coming."},{"id":"manas-2010:p1224:b001:l008","ordinal":53124,"en":"Not merely against us two, Syrgak—"},{"id":"manas-2010:p1224:b001:l009","ordinal":53125,"en":"An army that could shatter the world is coming."},{"id":"manas-2010:p1224:b001:l010","ordinal":53126,"en":"Our bravery has not been put to this test;"},{"id":"manas-2010:p1224:b001:l011","ordinal":53127,"en":"The one who roars into the enemy,"},{"id":"manas-2010:p1224:b001:l012","ordinal":53128,"en":"That Chubak, is not here."},{"id":"manas-2010:p1224:b001:l013","ordinal":53129,"en":"My darling Syrgak,"},{"id":"manas-2010:p1224:b001:l014","ordinal":53130,"en":"There is no ravine an enemy cannot go around;"},{"id":"manas-2010:p1224:b001:l015","ordinal":53131,"en":"The one who would strike from the flank,"},{"id":"manas-2010:p1224:b001:l016","ordinal":53132,"en":"Who would tear us free,"},{"id":"manas-2010:p1224:b001:l017","ordinal":53133,"en":"Leopard Manas, our cliff, is not here!"},{"id":"manas-2010:p1224:b001:l018","ordinal":53134,"en":"If we fight with this host,"},{"id":"manas-2010:p1224:b001:l019","ordinal":53135,"en":"Azhybay and Khan Bakay are not here;"},{"id":"manas-2010:p1224:b001:l020","ordinal":53136,"en":"Muzburchak and Kökchö are not here either."},{"id":"manas-2010:p1224:b001:l021","ordinal":53137,"en":"You lack the support on which you relied;"},{"id":"manas-2010:p1224:b001:l022","ordinal":53138,"en":"The ones who would rescue us,"},{"id":"manas-2010:p1224:b001:l023","ordinal":53139,"en":"Famed Koshoy and hero Töshtük—"},{"id":"manas-2010:p1224:b001:l024","ordinal":53140,"en":"Both your lions are absent!"},{"id":"manas-2010:p1224:b001:l025","ordinal":53141,"en":"The Chinese will give us a spectacle, I fear;"},{"id":"manas-2010:p1224:b001:l026","ordinal":53142,"en":"Let alone the horses, my Syrgak,"},{"id":"manas-2010:p1224:b001:l027","ordinal":53143,"en":"They will circle round us two"},{"id":"manas-2010:p1224:b001:l028","ordinal":53144,"en":"And surround us, I fear."},{"id":"manas-2010:p1224:b001:l029","ordinal":53145,"en":"Putting camel-hide caps over our heads,"},{"id":"manas-2010:p1224:b001:l030","ordinal":53146,"en":"Binding our limbs tight,"},{"id":"manas-2010:p1224:b001:l031","ordinal":53147,"en":"Before Karykan"},{"id":"manas-2010:p1224:b001:l032","ordinal":53148,"en":"They will bring us bound alive, I fear;"},{"id":"manas-2010:p1224:b001:l033","ordinal":53149,"en":"They will heap humiliation on us!"},{"id":"manas-2010:p1224:b001:l034","ordinal":53150,"en":"Know this, Syrgak, my leopard:"},{"id":"manas-2010:p1224:b001:l035","ordinal":53151,"en":"Let us put our hands in water"},{"id":"manas-2010:p1224:b001:l036","ordinal":53152,"en":"And perform the washing of our hands;"},{"id":"manas-2010:p1224:b001:l037","ordinal":53153,"en":"Let us put our feet in water"},{"id":"manas-2010:p1224:b001:l038","ordinal":53154,"en":"And perform the washing of our feet."},{"id":"manas-2010:p1224:b001:l039","ordinal":53155,"en":"If we grip our lances and break their ranks,"},{"id":"manas-2010:p1224:b001:l040","ordinal":53156,"en":"If doom comes and we fall to a shot,"},{"id":"manas-2010:p1224:b001:l041","ordinal":53157,"en":"To the abode of the hereafter"},{"id":"manas-2010:p1224:b001:l042","ordinal":53158,"en":"Let us go in purity.”"},{"id":"manas-2010:p1225:b001:l001","ordinal":53159,"en":"While Almambet was saying this,"},{"id":"manas-2010:p1225:b001:l002","ordinal":53160,"en":"Syrgak replied:"},{"id":"manas-2010:p1225:b001:l003","ordinal":53161,"en":"“Does not one whose doom has come die?"},{"id":"manas-2010:p1225:b001:l004","ordinal":53162,"en":"To the calamity that befalls him,"},{"id":"manas-2010:p1225:b001:l005","ordinal":53163,"en":"Does not the poor mortal submit?"},{"id":"manas-2010:p1225:b001:l006","ordinal":53164,"en":"Many people who live"},{"id":"manas-2010:p1225:b001:l007","ordinal":53165,"en":"Strive, saying, ‘I shall not die.’"},{"id":"manas-2010:p1225:b001:l008","ordinal":53166,"en":"When the angel stretches out five hands,"},{"id":"manas-2010:p1225:b001:l009","ordinal":53167,"en":"Who can escape from death?"},{"id":"manas-2010:p1225:b001:l010","ordinal":53168,"en":"Does not the dug grave take one in?"},{"id":"manas-2010:p1225:b001:l011","ordinal":53169,"en":"So vast a world"},{"id":"manas-2010:p1225:b001:l012","ordinal":53170,"en":"The black earth keeps swallowing."},{"id":"manas-2010:p1225:b001:l013","ordinal":53171,"en":"Do not grieve, my Almam, you are a sultan."},{"id":"manas-2010:p1225:b001:l014","ordinal":53172,"en":"Without the sun shining upon us,"},{"id":"manas-2010:p1225:b001:l015","ordinal":53173,"en":"Where is a night that will grow dark?"},{"id":"manas-2010:p1225:b001:l016","ordinal":53174,"en":"The massed Manzhuu and countless Chinese—"},{"id":"manas-2010:p1225:b001:l017","ordinal":53175,"en":"Where is the day to clash with them?”"},{"id":"manas-2010:p1225:b001:l018","ordinal":53176,"en":"As though he had seen his bride,"},{"id":"manas-2010:p1225:b001:l019","ordinal":53177,"en":"Without a frown or a furrowed brow,"},{"id":"manas-2010:p1225:b001:l020","ordinal":53178,"en":"He stood boldly, rejoicing."},{"id":"manas-2010:p1225:b001:l021","ordinal":53179,"en":"While Almambet and Syrgak, the two heroes,"},{"id":"manas-2010:p1225:b001:l022","ordinal":53180,"en":"Were speaking in this way,"},{"id":"manas-2010:p1225:b001:l023","ordinal":53181,"en":"Lacking speech to tell them,"},{"id":"manas-2010:p1225:b001:l024","ordinal":53182,"en":"Kartküröng, wisest among beasts,"},{"id":"manas-2010:p1225:b001:l025","ordinal":53183,"en":"Turned and neighed."},{"id":"manas-2010:p1225:b001:l026","ordinal":53184,"en":"He brought them there:"},{"id":"manas-2010:p1225:b001:l027","ordinal":53185,"en":"Shot-proof when worn in battle,"},{"id":"manas-2010:p1225:b001:l028","ordinal":53186,"en":"Golden collar, copper sleeves,"},{"id":"manas-2010:p1225:b001:l029","ordinal":53187,"en":"Double mail with lark-eye rings,"},{"id":"manas-2010:p1225:b001:l030","ordinal":53188,"en":"A braid-embroidered collar and roomy jacket,"},{"id":"manas-2010:p1225:b001:l031","ordinal":53189,"en":"The fine white coat Kanykey had made,"},{"id":"manas-2010:p1225:b001:l032","ordinal":53190,"en":"For Almambet and Syrgak"},{"id":"manas-2010:p1225:b001:l033","ordinal":53191,"en":"The splendid coat she had sewn specially,"},{"id":"manas-2010:p1225:b001:l034","ordinal":53192,"en":"Making it roomy and studding it with iron,"},{"id":"manas-2010:p1225:b001:l035","ordinal":53193,"en":"Exhausting the shot of the short musket."},{"id":"manas-2010:p1225:b001:l036","ordinal":53194,"en":"Musket-shot could not penetrate it;"},{"id":"manas-2010:p1225:b001:l037","ordinal":53195,"en":"An arrow's point could not reach through."},{"id":"manas-2010:p1225:b001:l038","ordinal":53196,"en":"Biting at this coat as she worked,"},{"id":"manas-2010:p1225:b001:l039","ordinal":53197,"en":"Her bright front teeth had grown weary;"},{"id":"manas-2010:p1225:b001:l040","ordinal":53198,"en":"Staring as she fashioned it firmly,"},{"id":"manas-2010:p1225:b001:l041","ordinal":53199,"en":"She had strained her precious eyes."},{"id":"manas-2010:p1225:b001:l042","ordinal":53200,"en":"One layer was of silk;"},{"id":"manas-2010:p1226:b001:l001","ordinal":53201,"en":"She had laid and worked the silk,"},{"id":"manas-2010:p1226:b001:l002","ordinal":53202,"en":"The fiber mixed with sand,"},{"id":"manas-2010:p1226:b001:l003","ordinal":53203,"en":"On the other side of that,"},{"id":"manas-2010:p1226:b001:l004","ordinal":53204,"en":"She had placed a handspan thick."},{"id":"manas-2010:p1226:b001:l005","ordinal":53205,"en":"“When they go fighting to Beijing,"},{"id":"manas-2010:p1226:b001:l006","ordinal":53206,"en":"They will enter among the enemy;"},{"id":"manas-2010:p1226:b001:l007","ordinal":53207,"en":"An infidel's shot may strike them;"},{"id":"manas-2010:p1226:b001:l008","ordinal":53208,"en":"A stray shot may find them;"},{"id":"manas-2010:p1226:b001:l009","ordinal":53209,"en":"Doom may come unexpectedly."},{"id":"manas-2010:p1226:b001:l010","ordinal":53210,"en":"Those two are adamant steel—"},{"id":"manas-2010:p1226:b001:l011","ordinal":53211,"en":"Almambet and Syrgak, the two heroes."},{"id":"manas-2010:p1226:b001:l012","ordinal":53212,"en":"If my generous lord should lose them,"},{"id":"manas-2010:p1226:b001:l013","ordinal":53213,"en":"It would be as though a fire went out.”"},{"id":"manas-2010:p1226:b001:l014","ordinal":53214,"en":"So the wise woman Kanykey"},{"id":"manas-2010:p1226:b001:l015","ordinal":53215,"en":"Had given the fine white coat as a gift."},{"id":"manas-2010:p1226:b001:l016","ordinal":53216,"en":"The two fierce-maned heroes then,"},{"id":"manas-2010:p1226:b001:l017","ordinal":53217,"en":"From atop Kartküröng,"},{"id":"manas-2010:p1226:b001:l018","ordinal":53218,"en":"Untied it, took it and dressed."},{"id":"manas-2010:p1226:b001:l019","ordinal":53219,"en":"The iron for their ribs"},{"id":"manas-2010:p1226:b001:l020","ordinal":53220,"en":"They put over their shoulder-blades;"},{"id":"manas-2010:p1226:b001:l021","ordinal":53221,"en":"The shot-proof protective gear,"},{"id":"manas-2010:p1226:b001:l022","ordinal":53222,"en":"Leaving no place exposed,"},{"id":"manas-2010:p1226:b001:l023","ordinal":53223,"en":"Beneath both breasts,"},{"id":"manas-2010:p1226:b001:l024","ordinal":53224,"en":"Right over the heart,"},{"id":"manas-2010:p1226:b001:l025","ordinal":53225,"en":"At the lungs and liver,"},{"id":"manas-2010:p1226:b001:l026","ordinal":53226,"en":"At the kidneys on either side,"},{"id":"manas-2010:p1226:b001:l027","ordinal":53227,"en":"They fastened every piece of equipment"},{"id":"manas-2010:p1226:b001:l028","ordinal":53228,"en":"And wrapped themselves in blue iron."},{"id":"manas-2010:p1226:b001:l029","ordinal":53229,"en":"Kartküröng turned;"},{"id":"manas-2010:p1226:b001:l030","ordinal":53230,"en":"Leading the great herd,"},{"id":"manas-2010:p1226:b001:l031","ordinal":53231,"en":"The noble beast went ahead;"},{"id":"manas-2010:p1226:b001:l032","ordinal":53232,"en":"Kartküröng put them on the road."},{"id":"manas-2010:p1226:b001:l033","ordinal":53233,"en":"Across hill after hill"},{"id":"manas-2010:p1226:b001:l034","ordinal":53234,"en":"He passed and went on."},{"id":"manas-2010:p1226:b001:l035","ordinal":53235,"en":"Never missing the trail they had trodden,"},{"id":"manas-2010:p1226:b001:l036","ordinal":53236,"en":"Küröng went on his way."},{"id":"manas-2010:p1226:b001:l037","ordinal":53237,"en":"Kartküröng had taken the lead;"},{"id":"manas-2010:p1226:b001:l038","ordinal":53238,"en":"The infidels' lion, Kongurbay,"},{"id":"manas-2010:p1226:b001:l039","ordinal":53239,"en":"Had caught up in pursuit."},{"id":"manas-2010:p1226:b001:l040","ordinal":53240,"en":"When the Fierce One had come near,"},{"id":"manas-2010:p1226:b001:l041","ordinal":53241,"en":"Roaring in anger,"},{"id":"manas-2010:p1226:b001:l042","ordinal":53242,"en":"“Come here quickly!” he said,"},{"id":"manas-2010:p1227:b001:l001","ordinal":53243,"en":"Calling hero Syrgak."},{"id":"manas-2010:p1227:b001:l002","ordinal":53244,"en":"“Catch up behind the horses"},{"id":"manas-2010:p1227:b001:l003","ordinal":53245,"en":"And keep driving them without mercy."},{"id":"manas-2010:p1227:b001:l004","ordinal":53246,"en":"Stop at Adyrmak."},{"id":"manas-2010:p1227:b001:l005","ordinal":53247,"en":"If I do not arrive in six days,"},{"id":"manas-2010:p1227:b001:l006","ordinal":53248,"en":"If I fail to catch up behind you,"}]
