{"id": "sayakbay-ms-current146:pdf023:l015", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 23, "folio": 406, "line_in_page": 15, "raw": "Айга тарткан беренди,", "text": "Айга тарткан беренди,", "en": "The warrior who drew toward the moon,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The opening may be Айга or another short word; translation is literal and contextual sense is uncertain.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf023:l016", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 23, "folio": 406, "line_in_page": 16, "raw": "Көзү ачык көркөмдөн,", "text": "Көзү ачык көркөмдөн,", "en": "From the clear-eyed, handsome one,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The last word is visually close to көркөмдөн but its grammatical relation is uncertain.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf023:l017", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 23, "folio": 406, "line_in_page": 17, "raw": "Кой кашканын өзүнөн,", "text": "Кой кашканын өзүнөн,", "en": "From the one who drove the sheep,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "кашканын is the closest visible reading; the phrase may contain a name or epithet.", "bbox": null}
