[{"id":"semetey-1-2013:p0697:b005:l016","ordinal":129793,"en":"Her clouded brow cleared;"},{"id":"semetey-1-2013:p0697:b005:l017","ordinal":129794,"en":"All her sorrow scattered."},{"id":"semetey-1-2013:p0697:b005:l018","ordinal":129795,"en":"Her brow grew bright and clear;"},{"id":"semetey-1-2013:p0697:b005:l019","ordinal":129796,"en":"All her sorrow scattered."},{"id":"semetey-1-2013:p0697:b005:l020","ordinal":129797,"en":"Her grieving heart opened."},{"id":"semetey-1-2013:p0697:b005:l021","ordinal":129798,"en":"What was severed was joined;"},{"id":"semetey-1-2013:p0697:b005:l022","ordinal":129799,"en":"What was scattered was gathered."},{"id":"semetey-1-2013:p0697:b005:l023","ordinal":129800,"en":"Since God had granted her wish,"},{"id":"semetey-1-2013:p0697:b005:l024","ordinal":129801,"en":"Since Semetey had come here,"},{"id":"semetey-1-2013:p0697:b005:l025","ordinal":129802,"en":"Burulcha poured out her lament:"},{"id":"semetey-1-2013:p0697:b005:l026","ordinal":129803,"en":"This was Burulcha's tale."},{"id":"semetey-1-2013:p0697:b005:l027","ordinal":129804,"en":"Let us leave this here;"},{"id":"semetey-1-2013:p0697:b005:l028","ordinal":129805,"en":"With Almambet's orphan,"},{"id":"semetey-1-2013:p0697:b005:l029","ordinal":129806,"en":"Kulchoro, let us begin."},{"id":"semetey-1-2013:p0697:b005:l030","ordinal":129807,"en":"Abyke, Kobosh, the six villains,"},{"id":"semetey-1-2013:p0697:b005:l031","ordinal":129808,"en":"To make the six-year-old child"},{"id":"semetey-1-2013:p0697:b005:l032","ordinal":129809,"en":"A dependent servant,"},{"id":"semetey-1-2013:p0697:b005:l033","ordinal":129810,"en":"Bound his hands to break him in,"},{"id":"semetey-1-2013:p0697:b005:l034","ordinal":129811,"en":"Dragged and beat him."},{"id":"semetey-1-2013:p0697:b005:l035","ordinal":129812,"en":"God had struck those dogs;"},{"id":"semetey-1-2013:p0697:b005:l036","ordinal":129813,"en":"The warrior son of Almambet,"},{"id":"semetey-1-2013:p0697:b005:l037","ordinal":129814,"en":"All those dogs gathered round,"},{"id":"semetey-1-2013:p0697:b005:l038","ordinal":129815,"en":"And made him red with blood,"},{"id":"semetey-1-2013:p0697:b005:l039","ordinal":129816,"en":"Tormenting, beating and striking him."},{"id":"semetey-1-2013:p0698:b003:l001","ordinal":129817,"en":"Such was the havoc they wrought."},{"id":"semetey-1-2013:p0698:b003:l002","ordinal":129818,"en":"That six-year-old warrior,"},{"id":"semetey-1-2013:p0698:b003:l003","ordinal":129819,"en":"Without a cap, bareheaded,"},{"id":"semetey-1-2013:p0698:b003:l004","ordinal":129820,"en":"Without a shirt, naked,"},{"id":"semetey-1-2013:p0698:b003:l005","ordinal":129821,"en":"Shrieked, crying, “Uncle!”"},{"id":"semetey-1-2013:p0698:b003:l006","ordinal":129822,"en":"His voice unheard by God,"},{"id":"semetey-1-2013:p0698:b003:l007","ordinal":129823,"en":"The wretched orphan sobbed."},{"id":"semetey-1-2013:p0698:b003:l008","ordinal":129824,"en":"Seen today, gone tomorrow—"},{"id":"semetey-1-2013:p0698:b003:l009","ordinal":129825,"en":"Khan Almambet's only son!"},{"id":"semetey-1-2013:p0698:b003:l010","ordinal":129826,"en":"Damn it, this world is shit!"},{"id":"semetey-1-2013:p0698:b003:l011","ordinal":129827,"en":"Bruised blue in countless places,"},{"id":"semetey-1-2013:p0698:b003:l012","ordinal":129828,"en":"The flesh of his thighs torn apart,"},{"id":"semetey-1-2013:p0698:b003:l013","ordinal":129829,"en":"Upon the six-year-old child"},{"id":"semetey-1-2013:p0698:b003:l014","ordinal":129830,"en":"They poured their merciless wrath."},{"id":"semetey-1-2013:p0698:b003:l015","ordinal":129831,"en":"Abyke and Kobosh's"},{"id":"semetey-1-2013:p0698:b003:l016","ordinal":129832,"en":"Doglike cruelty was plain to see."},{"id":"semetey-1-2013:p0698:b003:l017","ordinal":129833,"en":"Six-year-old Kulchoro"},{"id":"semetey-1-2013:p0698:b003:l018","ordinal":129834,"en":"Felt his heart breaking;"},{"id":"semetey-1-2013:p0698:b003:l019","ordinal":129835,"en":"“O wolf-maned father, do not die!” he cried,"},{"id":"semetey-1-2013:p0698:b003:l020","ordinal":129836,"en":"Tears streaming from his eyes."},{"id":"semetey-1-2013:p0698:b003:l021","ordinal":129837,"en":"His soles battered upon stones,"},{"id":"semetey-1-2013:p0698:b003:l022","ordinal":129838,"en":"His brow scorched by the sun,"},{"id":"semetey-1-2013:p0698:b003:l023","ordinal":129839,"en":"Fleeing Urbus, he went on foot,"},{"id":"semetey-1-2013:p0698:b003:l024","ordinal":129840,"en":"He went far for many days."},{"id":"semetey-1-2013:p0698:b003:l025","ordinal":129841,"en":"Red ridges and sheer ranges"},{"id":"semetey-1-2013:p0698:b003:l026","ordinal":129842,"en":"He crossed in hardship for a day."},{"id":"semetey-1-2013:p0698:b003:l027","ordinal":129843,"en":"The son of a hero blessed by Khidr"},{"id":"semetey-1-2013:p0698:b003:l028","ordinal":129844,"en":"Lay suffering one day,"},{"id":"semetey-1-2013:p0698:b003:l029","ordinal":129845,"en":"Taking shelter in a dark cave."},{"id":"semetey-1-2013:p0698:b003:l030","ordinal":129846,"en":"He lay in that dark cave;"},{"id":"semetey-1-2013:p0698:b003:l031","ordinal":129847,"en":"The orphan endured sorrow."},{"id":"semetey-1-2013:p0698:b003:l032","ordinal":129848,"en":"In that place, for hiding,"},{"id":"semetey-1-2013:p0698:b003:l033","ordinal":129849,"en":"There was no shelter but the cave."},{"id":"semetey-1-2013:p0698:b003:l034","ordinal":129850,"en":"For Almambet's only son,"},{"id":"semetey-1-2013:p0698:b003:l035","ordinal":129851,"en":"There was no food to devour."},{"id":"semetey-1-2013:p0698:b003:l036","ordinal":129852,"en":"Before much time had passed,"},{"id":"semetey-1-2013:p0698:b003:l037","ordinal":129853,"en":"Before this or that could be said,"},{"id":"semetey-1-2013:p0698:b003:l038","ordinal":129854,"en":"In the blink of an eye,"},{"id":"semetey-1-2013:p0698:b003:l039","ordinal":129855,"en":"God brought him hardship."},{"id":"semetey-1-2013:p0698:b004:l001","ordinal":129856,"en":"The wandering orphan"},{"id":"semetey-1-2013:p0698:b004:l002","ordinal":129857,"en":"Was met—oh, wonder!—"},{"id":"semetey-1-2013:p0698:b004:l003","ordinal":129858,"en":"By a dervish riding a gray bull."},{"id":"semetey-1-2013:p0698:b004:l004","ordinal":129859,"en":"At one glance, the dervish"},{"id":"semetey-1-2013:p0698:b004:l005","ordinal":129860,"en":"Divided into forty men;"},{"id":"semetey-1-2013:p0698:b004:l006","ordinal":129861,"en":"At another glance, the dervish"},{"id":"semetey-1-2013:p0698:b004:l007","ordinal":129862,"en":"Appeared as a thousand people."},{"id":"semetey-1-2013:p0698:b004:l008","ordinal":129863,"en":"It was Kozhosan himself,"},{"id":"semetey-1-2013:p0698:b004:l009","ordinal":129864,"en":"The very presence of the Forty Saints."},{"id":"semetey-1-2013:p0698:b004:l010","ordinal":129865,"en":"For blessed Almam's son,"},{"id":"semetey-1-2013:p0698:b004:l011","ordinal":129866,"en":"The hour to meet him had come."},{"id":"semetey-1-2013:p0698:b004:l012","ordinal":129867,"en":"His protector Kozhosan"},{"id":"semetey-1-2013:p0698:b004:l013","ordinal":129868,"en":"Took the orphan under his protection."},{"id":"semetey-1-2013:p0698:b004:l014","ordinal":129869,"en":"The Forty Saints who gave their hands"},{"id":"semetey-1-2013:p0698:b004:l015","ordinal":129870,"en":"Raised the orphan up."},{"id":"semetey-1-2013:p0698:b004:l016","ordinal":129871,"en":"Father Baabedin cried aloud"},{"id":"semetey-1-2013:p0698:b004:l017","ordinal":129872,"en":"And opened a clear path for him."},{"id":"semetey-1-2013:p0698:b004:l018","ordinal":129873,"en":"Barefoot Saint Kyzyr,"},{"id":"semetey-1-2013:p0698:b004:l019","ordinal":129874,"en":"Twice, three times,"},{"id":"semetey-1-2013:p0698:b004:l020","ordinal":129875,"en":"Gave that child his hand!"},{"id":"semetey-1-2013:p0698:b004:l021","ordinal":129876,"en":"“Son, never flinch from a shouting enemy;"},{"id":"semetey-1-2013:p0698:b004:l023","ordinal":129877,"en":"Never turn back from death;"},{"id":"semetey-1-2013:p0698:b004:l024","ordinal":129878,"en":"Never shrink a hair's breadth from your appointed end!"},{"id":"semetey-1-2013:p0698:b004:l025","ordinal":129879,"en":"Son, placed in front, a bringer of good fortune,"},{"id":"semetey-1-2013:p0698:b004:l026","ordinal":129880,"en":"Leading onward, worth a vast army,"},{"id":"semetey-1-2013:p0698:b004:l027","ordinal":129881,"en":"You have your saintly uncle Bakai."},{"id":"semetey-1-2013:p0698:b004:l028","ordinal":129882,"en":"His forefathers were all khans,"},{"id":"semetey-1-2013:p0698:b004:l029","ordinal":129883,"en":"Blessed by Khidr from the root,"},{"id":"semetey-1-2013:p0698:b004:l030","ordinal":129884,"en":"Descended from mighty-rooted Manas,"},{"id":"semetey-1-2013:p0698:b004:l031","ordinal":129885,"en":"He has reached twelve years."},{"id":"semetey-1-2013:p0698:b004:l032","ordinal":129886,"en":"That is the lion to be your companion,"},{"id":"semetey-1-2013:p0698:b004:l033","ordinal":129887,"en":"That is the hero to understand your ways,"},{"id":"semetey-1-2013:p0698:b004:l034","ordinal":129888,"en":"That is the hero to receive you,"},{"id":"semetey-1-2013:p0698:b004:l035","ordinal":129889,"en":"That is the lion to know your heart."},{"id":"semetey-1-2013:p0698:b004:l036","ordinal":129890,"en":"He has reached twelve years;"},{"id":"semetey-1-2013:p0698:b004:l037","ordinal":129891,"en":"This year is the time for him to come.”"},{"id":"semetey-1-2013:p0698:b004:l038","ordinal":129892,"en":"Saying this, the dervish"},{"id":"semetey-1-2013:p0698:b004:l039","ordinal":129893,"en":"Vanished from sight."},{"id":"semetey-1-2013:p0699:b003:l001","ordinal":129894,"en":"After hearing this, Kulchoro"},{"id":"semetey-1-2013:p0699:b003:l002","ordinal":129895,"en":"Woke with a start from sleep."},{"id":"semetey-1-2013:p0699:b003:l003","ordinal":129896,"en":"The boy ran in excitement,"},{"id":"semetey-1-2013:p0699:b003:l004","ordinal":129897,"en":"Bounding faster than a roe deer."},{"id":"semetey-1-2013:p0699:b003:l005","ordinal":129898,"en":"He went among the cowherds,"},{"id":"semetey-1-2013:p0699:b003:l006","ordinal":129899,"en":"To his mother Burulcha's hut;"},{"id":"semetey-1-2013:p0699:b003:l007","ordinal":129900,"en":"Taking shelter in that hut,"},{"id":"semetey-1-2013:p0699:b003:l008","ordinal":129901,"en":"Kulchoro lived there,"},{"id":"semetey-1-2013:p0699:b003:l009","ordinal":129902,"en":"Barefoot and bareheaded,"},{"id":"semetey-1-2013:p0699:b003:l010","ordinal":129903,"en":"Without clothes, naked,"},{"id":"semetey-1-2013:p0699:b003:l011","ordinal":129904,"en":"Immersed in play."},{"id":"semetey-1-2013:p0699:b003:l012","ordinal":129905,"en":"The cowherds' children"},{"id":"semetey-1-2013:p0699:b003:l013","ordinal":129906,"en":"Kulchoro gathered together,"},{"id":"semetey-1-2013:p0699:b003:l014","ordinal":129907,"en":"And played at shooting knucklebones."},{"id":"semetey-1-2013:p0699:b003:l015","ordinal":129908,"en":"Then your orphan"},{"id":"semetey-1-2013:p0699:b003:l016","ordinal":129909,"en":"Wept and sobbed bitterly,"},{"id":"semetey-1-2013:p0699:b003:l017","ordinal":129910,"en":"Pleading with the cowherds' children:"},{"id":"semetey-1-2013:p0699:b003:l018","ordinal":129911,"en":"“O cowherds' children,"},{"id":"semetey-1-2013:p0699:b003:l019","ordinal":129912,"en":"My dear children!"},{"id":"semetey-1-2013:p0699:b003:l020","ordinal":129913,"en":"God creates the soul;"},{"id":"semetey-1-2013:p0699:b003:l021","ordinal":129914,"en":"All you children, please come here—"},{"id":"semetey-1-2013:p0699:b003:l022","ordinal":129915,"en":"My soul is leaving me."},{"id":"semetey-1-2013:p0699:b003:l023","ordinal":129916,"en":"My whole being is crushed,"},{"id":"semetey-1-2013:p0699:b003:l024","ordinal":129917,"en":"My flesh and nails are stretched apart."},{"id":"semetey-1-2013:p0699:b003:l025","ordinal":129918,"en":"Has God granted it now?"},{"id":"semetey-1-2013:p0699:b003:l026","ordinal":129919,"en":"Has what I lost been found,"},{"id":"semetey-1-2013:p0699:b003:l027","ordinal":129920,"en":"My shame covered this way—"},{"id":"semetey-1-2013:p0699:b003:l028","ordinal":129921,"en":"Has my companion, my elder brother, come?!"},{"id":"semetey-1-2013:p0699:b003:l029","ordinal":129922,"en":"To Temirkan's city"},{"id":"semetey-1-2013:p0699:b003:l030","ordinal":129923,"en":"I hear he went wandering;"},{"id":"semetey-1-2013:p0699:b003:l031","ordinal":129924,"en":"Has my oceanlike brother come?!"},{"id":"semetey-1-2013:p0699:b003:l032","ordinal":129925,"en":"When our fathers died together,"},{"id":"semetey-1-2013:p0699:b003:l033","ordinal":129926,"en":"The vast wealth left by our fathers"},{"id":"semetey-1-2013:p0699:b003:l034","ordinal":129927,"en":"The six villains divided as they pleased."},{"id":"semetey-1-2013:p0699:b003:l035","ordinal":129928,"en":"When they seized the plunder,"},{"id":"semetey-1-2013:p0699:b003:l036","ordinal":129929,"en":"And wrought this havoc,"},{"id":"semetey-1-2013:p0699:b003:l037","ordinal":129930,"en":"They broke into the treasury, grabbing;"},{"id":"semetey-1-2013:p0699:b003:l038","ordinal":129931,"en":"Those witless dogs swaggered,"},{"id":"semetey-1-2013:p0699:b003:l039","ordinal":129932,"en":"And broke into the treasury."},{"id":"semetey-1-2013:p0699:b005:l001","ordinal":129933,"en":"Whole otter pelts"},{"id":"semetey-1-2013:p0699:b005:l002","ordinal":129934,"en":"They split apart,"},{"id":"semetey-1-2013:p0699:b005:l003","ordinal":129935,"en":"And put them round their boot tops."},{"id":"semetey-1-2013:p0699:b005:l004","ordinal":129936,"en":"Their hearts fattened, they ran wild,"},{"id":"semetey-1-2013:p0699:b005:l005","ordinal":129937,"en":"Greedy as slaves whose master had died."},{"id":"semetey-1-2013:p0699:b005:l006","ordinal":129938,"en":"While they plundered the palace,"},{"id":"semetey-1-2013:p0699:b005:l007","ordinal":129939,"en":"When the six villains wrought their havoc fully,"},{"id":"semetey-1-2013:p0699:b005:l009","ordinal":129940,"en":"‘She will settle in an unsuitable place,’ they said;"},{"id":"semetey-1-2013:p0699:b005:l010","ordinal":129941,"en":"‘For a woman whose husband has died,"},{"id":"semetey-1-2013:p0699:b005:l011","ordinal":129942,"en":"Her birth family is close,’ they said."},{"id":"semetey-1-2013:p0699:b005:l012","ordinal":129943,"en":"To Karakan's city"},{"id":"semetey-1-2013:p0699:b005:l013","ordinal":129944,"en":"I heard she had fled;"},{"id":"semetey-1-2013:p0699:b005:l014","ordinal":129945,"en":"To Temirkan's city"},{"id":"semetey-1-2013:p0699:b005:l015","ordinal":129946,"en":"I heard he had gone wandering."},{"id":"semetey-1-2013:p0699:b005:l016","ordinal":129947,"en":"I pieced it together from the tales,"},{"id":"semetey-1-2013:p0699:b005:l017","ordinal":129948,"en":"And asked those who knew."},{"id":"semetey-1-2013:p0699:b005:l018","ordinal":129949,"en":"They say God has granted the wish;"},{"id":"semetey-1-2013:p0699:b005:l019","ordinal":129950,"en":"They say my brother has turned twelve this year."},{"id":"semetey-1-2013:p0699:b005:l020","ordinal":129951,"en":"My dear children,"},{"id":"semetey-1-2013:p0699:b005:l021","ordinal":129952,"en":"Blue-gray haze parts in the sky."},{"id":"semetey-1-2013:p0699:b005:l022","ordinal":129953,"en":"Of father and mother,"},{"id":"semetey-1-2013:p0699:b005:l023","ordinal":129954,"en":"To an orphan left utterly bereft,"},{"id":"semetey-1-2013:p0699:b005:l024","ordinal":129955,"en":"Something seems to be happening."},{"id":"semetey-1-2013:p0699:b005:l025","ordinal":129956,"en":"My dear children,"},{"id":"semetey-1-2013:p0699:b005:l026","ordinal":129957,"en":"To undo dire misfortune,"},{"id":"semetey-1-2013:p0699:b005:l027","ordinal":129958,"en":"My season seems to have come."},{"id":"semetey-1-2013:p0699:b005:l028","ordinal":129959,"en":"Blessed by Khidr from the root,"},{"id":"semetey-1-2013:p0699:b005:l029","ordinal":129960,"en":"My dear children,"},{"id":"semetey-1-2013:p0699:b005:l030","ordinal":129961,"en":"My lord seems to have come!"},{"id":"semetey-1-2013:p0699:b005:l031","ordinal":129962,"en":"To shine light upon my head,"},{"id":"semetey-1-2013:p0699:b005:l032","ordinal":129963,"en":"My moon seems to have come!"},{"id":"semetey-1-2013:p0699:b005:l033","ordinal":129964,"en":"For wishes, the one Night"},{"id":"semetey-1-2013:p0699:b005:l034","ordinal":129965,"en":"Of Power seems to have come!"},{"id":"semetey-1-2013:p0699:b005:l035","ordinal":129966,"en":"To rekindle my extinguished fire,"},{"id":"semetey-1-2013:p0699:b005:l036","ordinal":129967,"en":"To revive my dead soul,"},{"id":"semetey-1-2013:p0699:b005:l037","ordinal":129968,"en":"My dear children,"},{"id":"semetey-1-2013:p0699:b005:l038","ordinal":129969,"en":"My sun seems to have come!"},{"id":"semetey-1-2013:p0699:b005:l039","ordinal":129970,"en":"My dear children,"},{"id":"semetey-1-2013:p0700:b003:l001","ordinal":129971,"en":"A dark ridge to lean upon,"},{"id":"semetey-1-2013:p0700:b003:l002","ordinal":129972,"en":"My support seems to have come."},{"id":"semetey-1-2013:p0700:b003:l003","ordinal":129973,"en":"To take as my support,"},{"id":"semetey-1-2013:p0700:b003:l004","ordinal":129974,"en":"My lion seems to have come!"},{"id":"semetey-1-2013:p0700:b003:l005","ordinal":129975,"en":"My brow will clear today;"},{"id":"semetey-1-2013:p0700:b003:l006","ordinal":129976,"en":"My dear children,"},{"id":"semetey-1-2013:p0700:b003:l007","ordinal":129977,"en":"My grieving heart will be soothed."},{"id":"semetey-1-2013:p0700:b003:l008","ordinal":129978,"en":"The reason it will be soothed—"},{"id":"semetey-1-2013:p0700:b003:l009","ordinal":129979,"en":"Take heed, children—"},{"id":"semetey-1-2013:p0700:b003:l010","ordinal":129980,"en":"From my mother's hut,"},{"id":"semetey-1-2013:p0700:b003:l011","ordinal":129981,"en":"From the hut's roof ring,"},{"id":"semetey-1-2013:p0700:b003:l012","ordinal":129982,"en":"From the wretched house where no fire burns,"},{"id":"semetey-1-2013:p0700:b003:l013","ordinal":129983,"en":"Smoke rises billowing."},{"id":"semetey-1-2013:p0700:b003:l014","ordinal":129984,"en":"For so long, children,"},{"id":"semetey-1-2013:p0700:b003:l015","ordinal":129985,"en":"At the bare post where no horse was tethered,"},{"id":"semetey-1-2013:p0700:b003:l016","ordinal":129986,"en":"Two winged steeds appear."},{"id":"semetey-1-2013:p0700:b003:l017","ordinal":129987,"en":"My mother, who has had no share of fortune,"},{"id":"semetey-1-2013:p0700:b003:l018","ordinal":129988,"en":"Her shrill voice rings out;"},{"id":"semetey-1-2013:p0700:b003:l019","ordinal":129989,"en":"Her piercing voice comes strong."},{"id":"semetey-1-2013:p0700:b003:l020","ordinal":129990,"en":"At the end of her cries,"},{"id":"semetey-1-2013:p0700:b003:l021","ordinal":129991,"en":"She truly cries, ‘My lord!’"},{"id":"semetey-1-2013:p0700:b003:l022","ordinal":129992,"en":"Today is Allah's blessed day."},{"id":"semetey-1-2013:p0700:b003:l024","ordinal":129993,"en":"When I hear that sorrowful voice,"},{"id":"semetey-1-2013:p0700:b003:l025","ordinal":129994,"en":"It is my wretched mother Burulcha's voice."},{"id":"semetey-1-2013:p0700:b003:l026","ordinal":129995,"en":"Of the two souls who came to this desolate house,"},{"id":"semetey-1-2013:p0700:b003:l027","ordinal":129996,"en":"It is my elder brother Semetey himself,"},{"id":"semetey-1-2013:p0700:b003:l028","ordinal":129997,"en":"His very own dark-eyed self,"},{"id":"semetey-1-2013:p0700:b003:l029","ordinal":129998,"en":"‘Where is my orphan?’ he asks;"},{"id":"semetey-1-2013:p0700:b003:l030","ordinal":129999,"en":"He has come in search of me."},{"id":"semetey-1-2013:p0700:b003:l031","ordinal":130000,"en":"The companion at his side,"},{"id":"semetey-1-2013:p0700:b003:l032","ordinal":130001,"en":"My dear children,"},{"id":"semetey-1-2013:p0700:b003:l033","ordinal":130002,"en":"Let me describe him too:"},{"id":"semetey-1-2013:p0700:b003:l034","ordinal":130003,"en":"The protector left by our fathers,"},{"id":"semetey-1-2013:p0700:b003:l035","ordinal":130004,"en":"The saintly elder Bakai."},{"id":"semetey-1-2013:p0700:b003:l036","ordinal":130005,"en":"When our fathers were alive,"},{"id":"semetey-1-2013:p0700:b003:l037","ordinal":130006,"en":"He was appointed governor in many places;"},{"id":"semetey-1-2013:p0700:b003:l038","ordinal":130007,"en":"He too is just such a saint."},{"id":"semetey-1-2013:p0700:b003:l039","ordinal":130008,"en":"When his lord Manas died,"},{"id":"semetey-1-2013:p0700:b004:l001","ordinal":130009,"en":"I heard he tended camels."},{"id":"semetey-1-2013:p0700:b004:l002","ordinal":130010,"en":"When his horse grew thin,"},{"id":"semetey-1-2013:p0700:b004:l003","ordinal":130011,"en":"Mighty Bakai, finding no way out,"},{"id":"semetey-1-2013:p0700:b004:l004","ordinal":130012,"en":"I heard he tended them on foot."},{"id":"semetey-1-2013:p0700:b004:l005","ordinal":130013,"en":"Koktulpar beneath him,"},{"id":"semetey-1-2013:p0700:b004:l006","ordinal":130014,"en":"I heard, had grown thin."},{"id":"semetey-1-2013:p0700:b004:l007","ordinal":130015,"en":"Mighty Bakai upon him,"},{"id":"semetey-1-2013:p0700:b004:l008","ordinal":130016,"en":"I heard, had become wretched."},{"id":"semetey-1-2013:p0700:b004:l009","ordinal":130017,"en":"On a rise like a saddle's ridge,"},{"id":"semetey-1-2013:p0700:b004:l010","ordinal":130018,"en":"I hear he stops."},{"id":"semetey-1-2013:p0700:b004:l011","ordinal":130019,"en":"‘Wretched beasts with no master,’"},{"id":"semetey-1-2013:p0700:b004:l012","ordinal":130020,"en":"I hear him curse them."},{"id":"semetey-1-2013:p0700:b004:l013","ordinal":130021,"en":"Among those camels,"},{"id":"semetey-1-2013:p0700:b004:l014","ordinal":130022,"en":"A dark nar with a broad hump,"},{"id":"semetey-1-2013:p0700:b004:l015","ordinal":130023,"en":"Zhelmaian, left by his khan Manas—"},{"id":"semetey-1-2013:p0700:b004:l016","ordinal":130024,"en":"They say twelve years are complete this year;"},{"id":"semetey-1-2013:p0700:b004:l017","ordinal":130025,"en":"They say it has been twelve years"},{"id":"semetey-1-2013:p0700:b004:l018","ordinal":130026,"en":"That he has mourned, bellowing."},{"id":"semetey-1-2013:p0700:b004:l019","ordinal":130027,"en":"Not rising, wailing,"},{"id":"semetey-1-2013:p0700:b004:l020","ordinal":130028,"en":"His neck hair falling in scorched-looking strands,"},{"id":"semetey-1-2013:p0700:b004:l021","ordinal":130029,"en":"Tears streaming from his eyes,"},{"id":"semetey-1-2013:p0700:b004:l022","ordinal":130030,"en":"He laid his neck upon the ground."},{"id":"semetey-1-2013:p0700:b004:l023","ordinal":130031,"en":"Not rising, Zhelmaian"},{"id":"semetey-1-2013:p0700:b004:l024","ordinal":130032,"en":"Lay there bellowing."},{"id":"semetey-1-2013:p0700:b004:l025","ordinal":130033,"en":"Pulling grass from feather grass to feed him,"},{"id":"semetey-1-2013:p0700:b004:l026","ordinal":130034,"en":"Giving water in a leather pail,"},{"id":"semetey-1-2013:p0700:b004:l027","ordinal":130035,"en":"I heard Bakai went about lamenting."},{"id":"semetey-1-2013:p0700:b004:l028","ordinal":130036,"en":"My uncle Bakai may die;"},{"id":"semetey-1-2013:p0700:b004:l029","ordinal":130037,"en":"If my uncle Bakai does not die,"},{"id":"semetey-1-2013:p0700:b004:l030","ordinal":130038,"en":"Bringing my elder brother with him,"},{"id":"semetey-1-2013:p0700:b004:l031","ordinal":130039,"en":"He will come here."},{"id":"semetey-1-2013:p0700:b004:l032","ordinal":130040,"en":"O cowherds' children,"},{"id":"semetey-1-2013:p0700:b004:l033","ordinal":130041,"en":"My dear children!"},{"id":"semetey-1-2013:p0700:b004:l034","ordinal":130042,"en":"If I do not see him, my wretched soul will die."},{"id":"semetey-1-2013:p0700:b004:l035","ordinal":130043,"en":"My honor will be restored today;"},{"id":"semetey-1-2013:p0700:b004:l036","ordinal":130044,"en":"My exposed back will be covered!”"},{"id":"semetey-1-2013:p0700:b004:l037","ordinal":130045,"en":"So said Kulchoro;"},{"id":"semetey-1-2013:p0700:b004:l038","ordinal":130046,"en":"Bending his knees toward the ground,"},{"id":"semetey-1-2013:p0700:b004:l039","ordinal":130047,"en":"He darted toward the hut."},{"id":"semetey-1-2013:p0700:b004:l040","ordinal":130048,"en":"Your orphan came running at a sprint."}]
