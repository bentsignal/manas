[{"id":"seytek-2012:p0822:b003:l010","ordinal":357377,"en":"For Sarybai has encountered us"},{"id":"seytek-2012:p0822:b003:l011","ordinal":357378,"en":"And utterly sucked us dry,”"},{"id":"seytek-2012:p0822:b003:l012","ordinal":357379,"en":"The people summoned their courage."},{"id":"seytek-2012:p0822:b003:l013","ordinal":357380,"en":"Anyone who resisted him,"},{"id":"seytek-2012:p0822:b003:l014","ordinal":357381,"en":"Sarybai left none alive,"},{"id":"seytek-2012:p0822:b003:l015","ordinal":357382,"en":"But severed their heads like sheep."},{"id":"seytek-2012:p0822:b003:l016","ordinal":357383,"en":"He split their bellies like melons;"},{"id":"seytek-2012:p0822:b003:l017","ordinal":357384,"en":"Destroying the people and slaughtering the nation,"},{"id":"seytek-2012:p0822:b003:l018","ordinal":357385,"en":"He brought such catastrophe upon them."},{"id":"seytek-2012:p0822:b003:l019","ordinal":357386,"en":"Because of the calamity that had passed,"},{"id":"seytek-2012:p0822:b003:l020","ordinal":357387,"en":"Because of this swine,"},{"id":"seytek-2012:p0822:b003:l021","ordinal":357388,"en":"They scattered all they had gathered"},{"id":"seytek-2012:p0822:b003:l022","ordinal":357389,"en":"And fled, stripped of fortune."},{"id":"seytek-2012:p0822:b003:l023","ordinal":357390,"en":"Leaving not a single group behind,"},{"id":"seytek-2012:p0822:b003:l024","ordinal":357391,"en":"They departed in one desperate flight"},{"id":"seytek-2012:p0822:b003:l025","ordinal":357392,"en":"Toward the defile of Jan-Baspas."},{"id":"seytek-2012:p0822:b003:l026","ordinal":357393,"en":"In the desert of Jangeldik,"},{"id":"seytek-2012:p0822:b003:l027","ordinal":357394,"en":"Of all who openly came before him,"},{"id":"seytek-2012:p0822:b003:l028","ordinal":357395,"en":"He slew a multitude."},{"id":"seytek-2012:p0822:b003:l029","ordinal":357396,"en":"Anyone who displeased him,"},{"id":"seytek-2012:p0822:b003:l030","ordinal":357397,"en":"He beheaded with his sword."},{"id":"seytek-2012:p0822:b003:l031","ordinal":357398,"en":"Countless guiltless souls"},{"id":"seytek-2012:p0822:b003:l032","ordinal":357399,"en":"He gave over to massacre."},{"id":"seytek-2012:p0822:b003:l033","ordinal":357400,"en":"Wailing and weeping bitterly,"},{"id":"seytek-2012:p0822:b003:l034","ordinal":357401,"en":"Lamenting and crying aloud,"},{"id":"seytek-2012:p0822:b003:l035","ordinal":357402,"en":"Truly burning with grief,"},{"id":"seytek-2012:p0822:b003:l036","ordinal":357403,"en":"Despairing of their fly-like lives,"},{"id":"seytek-2012:p0822:b003:l037","ordinal":357404,"en":"The people lost their senses,"},{"id":"seytek-2012:p0822:b003:l038","ordinal":357405,"en":"Moaning as if about to die,"},{"id":"seytek-2012:p0822:b003:l039","ordinal":357406,"en":"Because of Sarybai’s venom,"},{"id":"seytek-2012:p0822:b003:l040","ordinal":357407,"en":"Because of the infidel who had turned depraved,"},{"id":"seytek-2012:p0823:b002:l001","ordinal":357408,"en":"The enemy who faced them,"},{"id":"seytek-2012:p0823:b002:l002","ordinal":357409,"en":"They routed with heroic might,"},{"id":"seytek-2012:p0823:b002:l003","ordinal":357410,"en":"At the sight, the mind reeled,"},{"id":"seytek-2012:p0823:b002:l004","ordinal":357411,"en":"They loomed like lofty blue mountains,"},{"id":"seytek-2012:p0823:b002:l005","ordinal":357412,"en":"Their movement seemed an army of forty thousand,"},{"id":"seytek-2012:p0823:b002:l006","ordinal":357413,"en":"Crouching like lions,"},{"id":"seytek-2012:p0823:b002:l007","ordinal":357414,"en":"Wherever they surged past,"},{"id":"seytek-2012:p0823:b002:l008","ordinal":357415,"en":"No mountain could withstand them."},{"id":"seytek-2012:p0823:b002:l009","ordinal":357416,"en":"Like a flood that shattered mountains,"},{"id":"seytek-2012:p0823:b002:l010","ordinal":357417,"en":"Like innumerable hosts engulfing the land,"},{"id":"seytek-2012:p0823:b002:l011","ordinal":357418,"en":"Though all the world’s peoples attacked,"},{"id":"seytek-2012:p0823:b002:l012","ordinal":357419,"en":"The great khan’s descendants"},{"id":"seytek-2012:p0823:b002:l013","ordinal":357420,"en":"Could not be bent or conquered for an age."},{"id":"seytek-2012:p0823:b002:l014","ordinal":357421,"en":"The reason they could not prevail:"},{"id":"seytek-2012:p0823:b002:l015","ordinal":357422,"en":"Before them strode a gray tiger,"},{"id":"seytek-2012:p0823:b002:l016","ordinal":357423,"en":"A lion like the magnanimous hero,"},{"id":"seytek-2012:p0823:b002:l017","ordinal":357424,"en":"Throwing the mighty into confusion,"},{"id":"seytek-2012:p0823:b002:l018","ordinal":357425,"en":"Making the dun horse beneath him"},{"id":"seytek-2012:p0823:b002:l019","ordinal":357426,"en":"Stride proudly onward."},{"id":"seytek-2012:p0823:b002:l020","ordinal":357427,"en":"The holy wanderer Kydyr"},{"id":"seytek-2012:p0823:b002:l021","ordinal":357428,"en":"Led it by the bridle;"},{"id":"seytek-2012:p0823:b002:l022","ordinal":357429,"en":"Good fortune and prosperity flourished,"},{"id":"seytek-2012:p0823:b002:l023","ordinal":357430,"en":"The steed’s dark shape remained,"},{"id":"seytek-2012:p0823:b002:l024","ordinal":357431,"en":"Its cry splitting stone,"},{"id":"seytek-2012:p0823:b002:l025","ordinal":357432,"en":"My father, upheld by the forty saints,"},{"id":"seytek-2012:p0823:b002:l026","ordinal":357433,"en":"Shouted his battle cry,"},{"id":"seytek-2012:p0823:b002:l027","ordinal":357434,"en":"Raising the cry of “Manas!”"},{"id":"seytek-2012:p0823:b002:l028","ordinal":357435,"en":"“Boy Seytek and Külchoro,"},{"id":"seytek-2012:p0823:b002:l029","ordinal":357436,"en":"And Kuyaly, the lion-maiden—"},{"id":"seytek-2012:p0823:b002:l030","ordinal":357437,"en":"This swine has challenged you!"},{"id":"seytek-2012:p0823:b002:l031","ordinal":357438,"en":"Seize him, seize him!” he cried,"},{"id":"seytek-2012:p0823:b002:l032","ordinal":357439,"en":"“Grip your spears and thrust!"},{"id":"seytek-2012:p0823:b002:l033","ordinal":357440,"en":"Meet him and grapple,"},{"id":"seytek-2012:p0823:b002:l034","ordinal":357441,"en":"Strip the swaggering swine"},{"id":"seytek-2012:p0823:b002:l035","ordinal":357442,"en":"Who came so boldly"},{"id":"seytek-2012:p0823:b002:l036","ordinal":357443,"en":"And bring his death upon him!"},{"id":"seytek-2012:p0823:b002:l037","ordinal":357444,"en":"With piercing shouts and ringing cries,"},{"id":"seytek-2012:p0823:b002:l038","ordinal":357445,"en":"Fight wherever you meet,"},{"id":"seytek-2012:p0823:b002:l039","ordinal":357446,"en":"Cut down all you encounter,"},{"id":"seytek-2012:p0823:b002:l040","ordinal":357447,"en":"And take revenge for old grudges."},{"id":"seytek-2012:p0823:b003:l001","ordinal":357448,"en":"Through the wrath of the turmoil he raised,"},{"id":"seytek-2012:p0823:b003:l002","ordinal":357449,"en":"Some innocent souls"},{"id":"seytek-2012:p0823:b003:l003","ordinal":357450,"en":"Died before their destined time."},{"id":"seytek-2012:p0823:b003:l004","ordinal":357451,"en":"The land of no return, the true abode,"},{"id":"seytek-2012:p0823:b003:l005","ordinal":357452,"en":"Many a meek and living soul"},{"id":"seytek-2012:p0823:b003:l006","ordinal":357453,"en":"Reached because of Sarybay."},{"id":"seytek-2012:p0823:b003:l007","ordinal":357454,"en":"Khans died though guiltless,"},{"id":"seytek-2012:p0823:b003:l008","ordinal":357455,"en":"Many wrestlers and giants died;"},{"id":"seytek-2012:p0823:b003:l009","ordinal":357456,"en":"He quenched the fire"},{"id":"seytek-2012:p0823:b003:l010","ordinal":357457,"en":"Of the Kyrgyz in Talas,"},{"id":"seytek-2012:p0823:b003:l011","ordinal":357458,"en":"Drove them all away,"},{"id":"seytek-2012:p0823:b003:l012","ordinal":357459,"en":"Slaughtered multitudes,"},{"id":"seytek-2012:p0823:b003:l013","ordinal":357460,"en":"And brought misery upon many."},{"id":"seytek-2012:p0823:b003:l014","ordinal":357461,"en":"Such grievous hardship and great turmoil"},{"id":"seytek-2012:p0823:b003:l015","ordinal":357462,"en":"Had befallen the Kyrgyz."},{"id":"seytek-2012:p0823:b003:l016","ordinal":357463,"en":"Have you heard tell of yesterday,"},{"id":"seytek-2012:p0823:b003:l017","ordinal":357464,"en":"When Khan Semetey, the falcon hero,"},{"id":"seytek-2012:p0823:b003:l018","ordinal":357465,"en":"Dwelt in his palace in Keng-Kol"},{"id":"seytek-2012:p0823:b003:l019","ordinal":357466,"en":"And tethered his fourteen steeds?"},{"id":"seytek-2012:p0823:b003:l020","ordinal":357467,"en":"Whenever hostile foes came shooting,"},{"id":"seytek-2012:p0823:b003:l021","ordinal":357468,"en":"He drove them before him."},{"id":"seytek-2012:p0823:b003:l022","ordinal":357469,"en":"Whoever provoked his anger,"},{"id":"seytek-2012:p0823:b003:l023","ordinal":357470,"en":"He crushed between his fangs."},{"id":"seytek-2012:p0823:b003:l024","ordinal":357471,"en":"In valor and lionheartedness,"},{"id":"seytek-2012:p0823:b003:l025","ordinal":357472,"en":"Strong-souled and fiercely brave,"},{"id":"seytek-2012:p0823:b003:l026","ordinal":357473,"en":"A master wrestler, a peerless hero,"},{"id":"seytek-2012:p0823:b003:l027","ordinal":357474,"en":"He threw the whole world into confusion,"},{"id":"seytek-2012:p0823:b003:l028","ordinal":357475,"en":"Making the white courser beneath him"},{"id":"seytek-2012:p0823:b003:l029","ordinal":357476,"en":"Stride proudly onward."},{"id":"seytek-2012:p0823:b003:l030","ordinal":357477,"en":"He robbed every confronting enemy"},{"id":"seytek-2012:p0823:b003:l031","ordinal":357478,"en":"Of strength and fortune."},{"id":"seytek-2012:p0823:b003:l032","ordinal":357479,"en":"When he made arrows rain like a storm,"},{"id":"seytek-2012:p0823:b003:l033","ordinal":357480,"en":"No enemy ever returned."},{"id":"seytek-2012:p0823:b003:l034","ordinal":357481,"en":"The great Manas, surpassing lion,"},{"id":"seytek-2012:p0823:b003:l035","ordinal":357482,"en":"Appeared in spirit;"},{"id":"seytek-2012:p0823:b003:l036","ordinal":357483,"en":"The minds of mortal men"},{"id":"seytek-2012:p0823:b003:l037","ordinal":357484,"en":"Reeled in astonishment,"},{"id":"seytek-2012:p0823:b003:l038","ordinal":357485,"en":"As he made the matchless steed Akkula"},{"id":"seytek-2012:p0823:b003:l039","ordinal":357486,"en":"Stride proudly onward."},{"id":"seytek-2012:p0824:b002:l001","ordinal":357487,"en":"“Make the roadside a battlefield,"},{"id":"seytek-2012:p0824:b002:l002","ordinal":357488,"en":"And drive them against the Danggits!"},{"id":"seytek-2012:p0824:b002:l003","ordinal":357489,"en":"Turn back the riverlands"},{"id":"seytek-2012:p0824:b002:l004","ordinal":357490,"en":"Of that overbearing swine!"},{"id":"seytek-2012:p0824:b002:l005","ordinal":357491,"en":"Wage war until death"},{"id":"seytek-2012:p0824:b002:l006","ordinal":357492,"en":"Against the swine who attacked you!"},{"id":"seytek-2012:p0824:b002:l007","ordinal":357493,"en":"Drive them, children, drive!” he cried,"},{"id":"seytek-2012:p0824:b002:l008","ordinal":357494,"en":"“Overturn and destroy them,"},{"id":"seytek-2012:p0824:b002:l009","ordinal":357495,"en":"And finish Sarybay!”"},{"id":"seytek-2012:p0824:b002:l010","ordinal":357496,"en":"His brow was grim, his venom strong;"},{"id":"seytek-2012:p0824:b002:l011","ordinal":357497,"en":"He leveled any who assailed him."},{"id":"seytek-2012:p0824:b002:l012","ordinal":357498,"en":"When his raging fury seized him,"},{"id":"seytek-2012:p0824:b002:l013","ordinal":357499,"en":"The gray-maned hero was no easy foe."},{"id":"seytek-2012:p0824:b002:l014","ordinal":357500,"en":"He could spread slaughter through the world,"},{"id":"seytek-2012:p0824:b002:l015","ordinal":357501,"en":"And when his wrath grew fierce,"},{"id":"seytek-2012:p0824:b002:l016","ordinal":357502,"en":"He would leave not one Chinese soul,"},{"id":"seytek-2012:p0824:b002:l017","ordinal":357503,"en":"But slaughter them outright."},{"id":"seytek-2012:p0824:b002:l018","ordinal":357504,"en":"Black-hearted and blue-gray without,"},{"id":"seytek-2012:p0824:b002:l019","ordinal":357505,"en":"He was an unpredictable leopard."},{"id":"seytek-2012:p0824:b002:l020","ordinal":357506,"en":"At the sight, the heart was shaken:"},{"id":"seytek-2012:p0824:b002:l021","ordinal":357507,"en":"The spirit of gray-maned Manas"},{"id":"seytek-2012:p0824:b002:l022","ordinal":357508,"en":"Appeared as though alive."},{"id":"seytek-2012:p0824:b002:l023","ordinal":357509,"en":"The whole world stirred;"},{"id":"seytek-2012:p0824:b002:l024","ordinal":357510,"en":"His silhouette seemed a boundless lake,"},{"id":"seytek-2012:p0824:b002:l025","ordinal":357511,"en":"His eyes burned like embers,"},{"id":"seytek-2012:p0824:b002:l026","ordinal":357512,"en":"His shout was fire,"},{"id":"seytek-2012:p0824:b002:l027","ordinal":357513,"en":"His figure vast beyond measure."},{"id":"seytek-2012:p0824:b002:l028","ordinal":357514,"en":"Gray-maned Manas, the leopard,"},{"id":"seytek-2012:p0824:b002:l029","ordinal":357515,"en":"Joined those three"},{"id":"seytek-2012:p0824:b002:l030","ordinal":357516,"en":"As their companion, that magnanimous lion,"},{"id":"seytek-2012:p0824:b002:l031","ordinal":357517,"en":"And himself pursued the foe."},{"id":"seytek-2012:p0824:b002:l032","ordinal":357518,"en":"“Drive them, children, drive!” he cried,"},{"id":"seytek-2012:p0824:b002:l033","ordinal":357519,"en":"“Seize the monster’s son!"},{"id":"seytek-2012:p0824:b002:l034","ordinal":357520,"en":"He will not heed my pleas—"},{"id":"seytek-2012:p0824:b002:l035","ordinal":357521,"en":"Strike your spears into his waist!"},{"id":"seytek-2012:p0824:b002:l036","ordinal":357522,"en":"Wage true war,"},{"id":"seytek-2012:p0824:b002:l037","ordinal":357523,"en":"Cut him down and finish him!"},{"id":"seytek-2012:p0824:b002:l038","ordinal":357524,"en":"Stand face-to-face,"},{"id":"seytek-2012:p0824:b002:l039","ordinal":357525,"en":"Raise the battle cry of ‘Manas!’"},{"id":"seytek-2012:p0824:b002:l040","ordinal":357526,"en":"And unleash a dreadful battle!"},{"id":"seytek-2012:p0824:b003:l001","ordinal":357527,"en":"Drive them, children, drive!” he cried,"},{"id":"seytek-2012:p0824:b003:l002","ordinal":357528,"en":"And noble Manas, the beloved lion,"},{"id":"seytek-2012:p0824:b003:l003","ordinal":357529,"en":"Himself shouted encouragement."},{"id":"seytek-2012:p0824:b003:l004","ordinal":357530,"en":"They seemed an army beyond counting;"},{"id":"seytek-2012:p0824:b003:l005","ordinal":357531,"en":"Your heroic father, brave Manas,"},{"id":"seytek-2012:p0824:b003:l006","ordinal":357532,"en":"Joined the three tempestuous warriors"},{"id":"seytek-2012:p0824:b003:l007","ordinal":357533,"en":"As their companion."},{"id":"seytek-2012:p0824:b003:l008","ordinal":357534,"en":"Behind them the beloved lion"},{"id":"seytek-2012:p0824:b003:l009","ordinal":357535,"en":"Appeared in human form,"},{"id":"seytek-2012:p0824:b003:l010","ordinal":357536,"en":"And the mind of anyone who looked closely"},{"id":"seytek-2012:p0824:b003:l011","ordinal":357537,"en":"Reeled in astonishment."},{"id":"seytek-2012:p0824:b003:l012","ordinal":357538,"en":"From the edge of the northern quarter came one"},{"id":"seytek-2012:p0824:b003:l013","ordinal":357539,"en":"Who spared no life in battle"},{"id":"seytek-2012:p0824:b003:l014","ordinal":357540,"en":"And never drank his fill of blood;"},{"id":"seytek-2012:p0824:b003:l015","ordinal":357541,"en":"Who broke through dead ends and opened roads,"},{"id":"seytek-2012:p0824:b003:l016","ordinal":357542,"en":"And when countless enemies came,"},{"id":"seytek-2012:p0824:b003:l017","ordinal":357543,"en":"Charged straight into their midst;"},{"id":"seytek-2012:p0824:b003:l018","ordinal":357544,"en":"Who never recoiled from glowing embers"},{"id":"seytek-2012:p0824:b003:l019","ordinal":357545,"en":"Nor flinched and fled from flame;"},{"id":"seytek-2012:p0824:b003:l020","ordinal":357546,"en":"A master horseman, watchful on the road—"},{"id":"seytek-2012:p0824:b003:l021","ordinal":357547,"en":"Syrgak, warrior of the magnanimous lion,"},{"id":"seytek-2012:p0824:b003:l022","ordinal":357548,"en":"Who never drew back once he thrust,"},{"id":"seytek-2012:p0824:b003:l023","ordinal":357549,"en":"Never lost the trail of the dejected,"},{"id":"seytek-2012:p0824:b003:l024","ordinal":357550,"en":"And in darkness never mistook"},{"id":"seytek-2012:p0824:b003:l025","ordinal":357551,"en":"Or missed a shadow’s track."},{"id":"seytek-2012:p0824:b003:l026","ordinal":357552,"en":"Broad-bodied and short in stature,"},{"id":"seytek-2012:p0824:b003:l027","ordinal":357553,"en":"His whole frame was black stone;"},{"id":"seytek-2012:p0824:b003:l028","ordinal":357554,"en":"Thick-armed and stone-hearted,"},{"id":"seytek-2012:p0824:b003:l029","ordinal":357555,"en":"A sturdy, well-built giant."},{"id":"seytek-2012:p0824:b003:l030","ordinal":357556,"en":"He raised his socketed spear"},{"id":"seytek-2012:p0824:b003:l031","ordinal":357557,"en":"High above him,"},{"id":"seytek-2012:p0824:b003:l032","ordinal":357558,"en":"And from hosts that closed in combat"},{"id":"seytek-2012:p0824:b003:l033","ordinal":357559,"en":"He never stirred or retreated."},{"id":"seytek-2012:p0824:b003:l034","ordinal":357560,"en":"Whoever came within his reach,"},{"id":"seytek-2012:p0824:b003:l035","ordinal":357561,"en":"He crushed into the earth like a sheep."},{"id":"seytek-2012:p0824:b003:l036","ordinal":357562,"en":"When black muskets cracked"},{"id":"seytek-2012:p0824:b003:l037","ordinal":357563,"en":"And fierce matchlocks snapped,"},{"id":"seytek-2012:p0824:b003:l038","ordinal":357564,"en":"He never started or drew back."},{"id":"seytek-2012:p0824:b003:l039","ordinal":357565,"en":"Before enemies pouring upon him,"},{"id":"seytek-2012:p0824:b003:l040","ordinal":357566,"en":"He never retreated in fear."},{"id":"seytek-2012:p0825:b002:l001","ordinal":357567,"en":"He faced giants and ogres,"},{"id":"seytek-2012:p0825:b002:l002","ordinal":357568,"en":"And none he fought escaped alive."},{"id":"seytek-2012:p0825:b002:l003","ordinal":357569,"en":"Breaking away with some forty warriors,"},{"id":"seytek-2012:p0825:b002:l004","ordinal":357570,"en":"Brave Syrgak of Khan Ulak"},{"id":"seytek-2012:p0825:b002:l005","ordinal":357571,"en":"Appeared, stunning the mind,"},{"id":"seytek-2012:p0825:b002:l006","ordinal":357572,"en":"As though alive;"},{"id":"seytek-2012:p0825:b002:l007","ordinal":357573,"en":"He shouted, “Hero!”"},{"id":"seytek-2012:p0825:b002:l008","ordinal":357574,"en":"And called out for Külchoro."},{"id":"seytek-2012:p0825:b002:l009","ordinal":357575,"en":"No soul could withstand his wrath;"},{"id":"seytek-2012:p0825:b002:l010","ordinal":357576,"en":"Genial Syrgak, the lion hero,"},{"id":"seytek-2012:p0825:b002:l011","ordinal":357577,"en":"Again leveled his spear."},{"id":"seytek-2012:p0825:b002:l012","ordinal":357578,"en":"To the three in that battle,"},{"id":"seytek-2012:p0825:b002:l013","ordinal":357579,"en":"He gave his aid as a comrade."},{"id":"seytek-2012:p0825:b002:l014","ordinal":357580,"en":"If you looked to this side,"},{"id":"seytek-2012:p0825:b002:l015","ordinal":357581,"en":"There rode one upon Aisarala."},{"id":"seytek-2012:p0825:b002:l016","ordinal":357582,"en":"Though foes were tens of thousands,"},{"id":"seytek-2012:p0825:b002:l017","ordinal":357583,"en":"He swept them away in every battle."},{"id":"seytek-2012:p0825:b002:l018","ordinal":357584,"en":"He wore yellow rawhide trousers,"},{"id":"seytek-2012:p0825:b002:l019","ordinal":357585,"en":"Bore a spear without a tassel,"},{"id":"seytek-2012:p0825:b002:l020","ordinal":357586,"en":"And girded a sword without a sheath,"},{"id":"seytek-2012:p0825:b002:l021","ordinal":357587,"en":"Biting hard upon his lip."},{"id":"seytek-2012:p0825:b002:l022","ordinal":357588,"en":"He wound his sash around his waist"},{"id":"seytek-2012:p0825:b002:l023","ordinal":357589,"en":"And cast the world into tumult."},{"id":"seytek-2012:p0825:b002:l024","ordinal":357590,"en":"Tall and broad-shouldered,"},{"id":"seytek-2012:p0825:b002:l025","ordinal":357591,"en":"Both wrestler and lion,"},{"id":"seytek-2012:p0825:b002:l026","ordinal":357592,"en":"From the city of the Khakhan"},{"id":"seytek-2012:p0825:b002:l027","ordinal":357593,"en":"Came this fierce lion from China."},{"id":"seytek-2012:p0825:b002:l028","ordinal":357594,"en":"The mighty hero gave a shout;"},{"id":"seytek-2012:p0825:b002:l029","ordinal":357595,"en":"The earth broke and heaved,"},{"id":"seytek-2012:p0825:b002:l030","ordinal":357596,"en":"As though seven thousand troops had come."},{"id":"seytek-2012:p0825:b002:l031","ordinal":357597,"en":"Straining like a lion,"},{"id":"seytek-2012:p0825:b002:l032","ordinal":357598,"en":"He readied and leveled his spear,"},{"id":"seytek-2012:p0825:b002:l033","ordinal":357599,"en":"Shouting from the front,"},{"id":"seytek-2012:p0825:b002:l034","ordinal":357600,"en":"Calling to the hero Külchoro,"},{"id":"seytek-2012:p0825:b002:l035","ordinal":357601,"en":"His only son."},{"id":"seytek-2012:p0825:b002:l036","ordinal":357602,"en":"Power rang from his battle cry,"},{"id":"seytek-2012:p0825:b002:l037","ordinal":357603,"en":"And from the fire on either side"},{"id":"seytek-2012:p0825:b002:l038","ordinal":357604,"en":"Hair enough for socks was singed away."},{"id":"seytek-2012:p0825:b002:l039","ordinal":357605,"en":"The hero Külchoro"},{"id":"seytek-2012:p0825:b002:l040","ordinal":357606,"en":"Was accompanied by your uncle."},{"id":"seytek-2012:p0825:b004:l001","ordinal":357607,"en":"Raging and charging,"},{"id":"seytek-2012:p0825:b004:l002","ordinal":357608,"en":"He prepared to face the foe."},{"id":"seytek-2012:p0825:b004:l003","ordinal":357609,"en":"“My broad-shouldered uncle Külchoro,"},{"id":"seytek-2012:p0825:b004:l004","ordinal":357610,"en":"You are a spring flowing down the valley,"},{"id":"seytek-2012:p0825:b004:l005","ordinal":357611,"en":"A lamp seen among the people."},{"id":"seytek-2012:p0825:b004:l006","ordinal":357612,"en":"You are a legacy left by a hero,"},{"id":"seytek-2012:p0825:b004:l007","ordinal":357613,"en":"A noble one remaining as his sign."},{"id":"seytek-2012:p0825:b004:l008","ordinal":357614,"en":"The fierce enemy Sarybay"},{"id":"seytek-2012:p0825:b004:l009","ordinal":357615,"en":"Has battled you beyond capture;"},{"id":"seytek-2012:p0825:b004:l010","ordinal":357616,"en":"Alas, how fares my son?” he cried."},{"id":"seytek-2012:p0825:b004:l011","ordinal":357617,"en":"Taking a shortcut along the narrow path,"},{"id":"seytek-2012:p0825:b004:l012","ordinal":357618,"en":"From before his khanly nephew,"},{"id":"seytek-2012:p0825:b004:l013","ordinal":357619,"en":"He led Buurul, the horse ridden to battle,"},{"id":"seytek-2012:p0825:b004:l014","ordinal":357620,"en":"Urging it hurriedly onward,"},{"id":"seytek-2012:p0825:b004:l015","ordinal":357621,"en":"And shouted encouragement."},{"id":"seytek-2012:p0825:b004:l016","ordinal":357622,"en":"The mighty hero whose patron spirit lived,"},{"id":"seytek-2012:p0825:b004:l017","ordinal":357623,"en":"The lord supported by the holy spirits,"},{"id":"seytek-2012:p0825:b004:l018","ordinal":357624,"en":"Himself accompanied him."},{"id":"seytek-2012:p0825:b004:l019","ordinal":357625,"en":"The Sarala beneath him"},{"id":"seytek-2012:p0825:b004:l020","ordinal":357626,"en":"Shone as though touched by moonlight;"},{"id":"seytek-2012:p0825:b004:l021","ordinal":357627,"en":"A red banner with a golden crescent"},{"id":"seytek-2012:p0825:b004:l022","ordinal":357628,"en":"Fluttered in his hand."},{"id":"seytek-2012:p0825:b004:l023","ordinal":357629,"en":"“Charge, my son, charge!” he cried,"},{"id":"seytek-2012:p0825:b004:l024","ordinal":357630,"en":"“Hold your spear ready!"},{"id":"seytek-2012:p0825:b004:l025","ordinal":357631,"en":"Let me see what troubles you."},{"id":"seytek-2012:p0825:b004:l026","ordinal":357632,"en":"Against Sarybay, whom you must fight,"}]
