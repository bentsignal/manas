[{"id":"semetey-1-2013:p0868:b003:l004","ordinal":143361,"en":"Manas's sole surviving presence"},{"id":"semetey-1-2013:p0868:b003:l005","ordinal":143362,"en":"They mean to put to death."},{"id":"semetey-1-2013:p0868:b003:l006","ordinal":143363,"en":"Strutting together and bellowing,"},{"id":"semetey-1-2013:p0868:b003:l007","ordinal":143364,"en":"God has struck the people;"},{"id":"semetey-1-2013:p0868:b003:l008","ordinal":143365,"en":"Shouting “Kobosh!” as their battle cry,"},{"id":"semetey-1-2013:p0868:b003:l009","ordinal":143366,"en":"They ready their swift steeds,"},{"id":"semetey-1-2013:p0868:b003:l010","ordinal":143367,"en":"As though an enemy had come from China,"},{"id":"semetey-1-2013:p0868:b003:l011","ordinal":143368,"en":"They ready their lances,"},{"id":"semetey-1-2013:p0868:b003:l012","ordinal":143369,"en":"Swaying in ranks along the edge,"},{"id":"semetey-1-2013:p0868:b003:l013","ordinal":143370,"en":"Surging over the ground."},{"id":"semetey-1-2013:p0868:b003:l014","ordinal":143371,"en":"Their lancers divide into groups,"},{"id":"semetey-1-2013:p0868:b003:l015","ordinal":143372,"en":"Their fearsome aspect showing."},{"id":"semetey-1-2013:p0868:b003:l016","ordinal":143373,"en":"The great army they have gathered"},{"id":"semetey-1-2013:p0868:b003:l017","ordinal":143374,"en":"Spreads out, making the earth heave."},{"id":"semetey-1-2013:p0868:b003:l018","ordinal":143375,"en":"Kokcho, khan of the Kazakhs,"},{"id":"semetey-1-2013:p0868:b003:l019","ordinal":143376,"en":"His son Umotoy,"},{"id":"semetey-1-2013:p0868:b003:l020","ordinal":143377,"en":"Muzburchak's Buyanbek,"},{"id":"semetey-1-2013:p0868:b003:l021","ordinal":143378,"en":"Urbu's army is there too,"},{"id":"semetey-1-2013:p0868:b003:l022","ordinal":143379,"en":"Alabek of Alty-Shaar,"},{"id":"semetey-1-2013:p0868:b003:l023","ordinal":143380,"en":"His army is there too."},{"id":"semetey-1-2013:p0868:b003:l024","ordinal":143381,"en":"They ready their lancers,"},{"id":"semetey-1-2013:p0868:b003:l025","ordinal":143382,"en":"All their battle-axes"},{"id":"semetey-1-2013:p0868:b003:l026","ordinal":143383,"en":"They place along the flanks."},{"id":"semetey-1-2013:p0868:b003:l027","ordinal":143384,"en":"Preparing their marksmen,"},{"id":"semetey-1-2013:p0868:b003:l028","ordinal":143385,"en":"They spread them through the center;"},{"id":"semetey-1-2013:p0868:b003:l029","ordinal":143386,"en":"Dividing into different groups,"},{"id":"semetey-1-2013:p0868:b003:l030","ordinal":143387,"en":"Their appearance is menacing."},{"id":"semetey-1-2013:p0868:b003:l031","ordinal":143388,"en":"Seething and swarming, they divide,"},{"id":"semetey-1-2013:p0868:b003:l032","ordinal":143389,"en":"Their fearsome appearance showing."},{"id":"semetey-1-2013:p0868:b003:l033","ordinal":143390,"en":"If we stand our ground without shame,"},{"id":"semetey-1-2013:p0868:b003:l034","ordinal":143391,"en":"An army comes that will overwhelm us;"},{"id":"semetey-1-2013:p0868:b003:l035","ordinal":143392,"en":"A dark day brings peril to our lives."},{"id":"semetey-1-2013:p0868:b003:l036","ordinal":143393,"en":"Flashing and glittering,"},{"id":"semetey-1-2013:p0868:b003:l037","ordinal":143394,"en":"Spreading out and dividing,"},{"id":"semetey-1-2013:p0868:b003:l038","ordinal":143395,"en":"With their swordsmen on the flanks—"},{"id":"semetey-1-2013:p0868:b003:l039","ordinal":143396,"en":"My dear Bakai, listen!"},{"id":"semetey-1-2013:p0868:b004:l001","ordinal":143397,"en":"Their strongest men are at the front."},{"id":"semetey-1-2013:p0868:b004:l002","ordinal":143398,"en":"Their lancers are on the flanks,"},{"id":"semetey-1-2013:p0868:b004:l003","ordinal":143399,"en":"Their lions at the front."},{"id":"semetey-1-2013:p0868:b004:l004","ordinal":143400,"en":"Surging like ants,"},{"id":"semetey-1-2013:p0868:b004:l005","ordinal":143401,"en":"They come pouring out;"},{"id":"semetey-1-2013:p0868:b004:l006","ordinal":143402,"en":"Whether they are insects, one cannot tell,"},{"id":"semetey-1-2013:p0868:b004:l007","ordinal":143403,"en":"They come seething out."},{"id":"semetey-1-2013:p0868:b004:l008","ordinal":143404,"en":"Those skilled in drawing bows"},{"id":"semetey-1-2013:p0868:b004:l009","ordinal":143405,"en":"They have set apart again;"},{"id":"semetey-1-2013:p0868:b004:l010","ordinal":143406,"en":"Their finest men of strength"},{"id":"semetey-1-2013:p0868:b004:l011","ordinal":143407,"en":"They have set apart separately."},{"id":"semetey-1-2013:p0868:b004:l012","ordinal":143408,"en":"All their wrestlers"},{"id":"semetey-1-2013:p0868:b004:l013","ordinal":143409,"en":"They have put in separate groups."},{"id":"semetey-1-2013:p0868:b004:l014","ordinal":143410,"en":"Driving all of them from behind,"},{"id":"semetey-1-2013:p0868:b004:l015","ordinal":143411,"en":"Kobosh has brought them on."},{"id":"semetey-1-2013:p0868:b004:l016","ordinal":143412,"en":"Against the countless Chinese of Kakan,"},{"id":"semetey-1-2013:p0868:b004:l017","ordinal":143413,"en":"As though setting out on a holy war,"},{"id":"semetey-1-2013:p0868:b004:l018","ordinal":143414,"en":"The six villains are accursed;"},{"id":"semetey-1-2013:p0868:b004:l019","ordinal":143415,"en":"God has struck them."},{"id":"semetey-1-2013:p0868:b004:l020","ordinal":143416,"en":"Abyke and Kobosh, two villains,"},{"id":"semetey-1-2013:p0868:b004:l021","ordinal":143417,"en":"By name there are six villains,"},{"id":"semetey-1-2013:p0868:b004:l022","ordinal":143418,"en":"Khan Manas's forty companions,"},{"id":"semetey-1-2013:p0868:b004:l023","ordinal":143419,"en":"All forty came from forty places—dogs and swine."},{"id":"semetey-1-2013:p0868:b004:l025","ordinal":143420,"en":"They no longer heed the ancestral spirit."},{"id":"semetey-1-2013:p0868:b004:l026","ordinal":143421,"en":"When mighty Manas was alive,"},{"id":"semetey-1-2013:p0868:b004:l027","ordinal":143422,"en":"All forty were companions who ravaged the world."},{"id":"semetey-1-2013:p0868:b004:l028","ordinal":143423,"en":"Holding pennons, raising banners,"},{"id":"semetey-1-2013:p0868:b004:l029","ordinal":143424,"en":"Shouting ‘Khan Kobosh!’"},{"id":"semetey-1-2013:p0868:b004:l030","ordinal":143425,"en":"The great trumpet booms,"},{"id":"semetey-1-2013:p0868:b004:l031","ordinal":143426,"en":"The shawm clatters;"},{"id":"semetey-1-2013:p0868:b004:l032","ordinal":143427,"en":"He leads the army along its way."},{"id":"semetey-1-2013:p0868:b004:l033","ordinal":143428,"en":"They have ceased to fear the ancestral spirit;"},{"id":"semetey-1-2013:p0868:b004:l034","ordinal":143429,"en":"They attack Manas's orphan."},{"id":"semetey-1-2013:p0868:b004:l035","ordinal":143430,"en":"If the moon is shrouded in darkness,"},{"id":"semetey-1-2013:p0868:b004:l036","ordinal":143431,"en":"What will become of the night?"},{"id":"semetey-1-2013:p0868:b004:l037","ordinal":143432,"en":"Uncle Bakai, find a way!"},{"id":"semetey-1-2013:p0868:b004:l038","ordinal":143433,"en":"If they overwhelm this orphan,"},{"id":"semetey-1-2013:p0868:b004:l039","ordinal":143434,"en":"What will become of our days?"},{"id":"semetey-1-2013:p0869:b003:l001","ordinal":143435,"en":"If an arrow comes unerringly to strike,"},{"id":"semetey-1-2013:p0869:b003:l002","ordinal":143436,"en":"If a mass comes surging upon us,"},{"id":"semetey-1-2013:p0869:b003:l003","ordinal":143437,"en":"I was your sorrowful hound;"},{"id":"semetey-1-2013:p0869:b003:l004","ordinal":143438,"en":"A way to meet so many foes"},{"id":"semetey-1-2013:p0869:b003:l005","ordinal":143439,"en":"You, Bakai, were the one to find."},{"id":"semetey-1-2013:p0869:b003:l006","ordinal":143440,"en":"You would join what had broken,"},{"id":"semetey-1-2013:p0869:b003:l007","ordinal":143441,"en":"You would gather what had scattered;"},{"id":"semetey-1-2013:p0869:b003:l008","ordinal":143442,"en":"You were mighty Bakai,"},{"id":"semetey-1-2013:p0869:b003:l009","ordinal":143443,"en":"The equal of your mighty Manas.”"},{"id":"semetey-1-2013:p0869:b003:l010","ordinal":143444,"en":"When Sary Khan had said this,"},{"id":"semetey-1-2013:p0869:b003:l011","ordinal":143445,"en":"Bakai stood and spoke:"},{"id":"semetey-1-2013:p0869:b003:l012","ordinal":143446,"en":"“Ah, Sary Khan, my age-mate!"},{"id":"semetey-1-2013:p0869:b003:l013","ordinal":143447,"en":"Who has seen cliffs no wild game can cross—"},{"id":"semetey-1-2013:p0869:b003:l014","ordinal":143448,"en":"Here stands your dear Bakai!"},{"id":"semetey-1-2013:p0869:b003:l015","ordinal":143449,"en":"Who brought havoc upon the world—"},{"id":"semetey-1-2013:p0869:b003:l016","ordinal":143450,"en":"Here stands Bakai!"},{"id":"semetey-1-2013:p0869:b003:l017","ordinal":143451,"en":"When leopard Manas was alive,"},{"id":"semetey-1-2013:p0869:b003:l018","ordinal":143452,"en":"When we scattered the unbelievers' herds,"},{"id":"semetey-1-2013:p0869:b003:l019","ordinal":143453,"en":"When we opened the way for Islam,"},{"id":"semetey-1-2013:p0869:b003:l020","ordinal":143454,"en":"Ah, Sary Khan, my age-mate!"},{"id":"semetey-1-2013:p0869:b003:l021","ordinal":143455,"en":"You have made me suffer torment today;"},{"id":"semetey-1-2013:p0869:b003:l022","ordinal":143456,"en":"You have made Bakai, in his old age,"},{"id":"semetey-1-2013:p0869:b003:l023","ordinal":143457,"en":"Speak of days long past."},{"id":"semetey-1-2013:p0869:b003:l024","ordinal":143458,"en":"In noble Manas's own time,"},{"id":"semetey-1-2013:p0869:b003:l025","ordinal":143459,"en":"When Bakai was about to die,"},{"id":"semetey-1-2013:p0869:b003:l026","ordinal":143460,"en":"The great imam of Mecca,"},{"id":"semetey-1-2013:p0869:b003:l027","ordinal":143461,"en":"Saying, ‘If my appointed death comes, I shall die,’"},{"id":"semetey-1-2013:p0869:b003:l028","ordinal":143462,"en":"For the small band of Muslims,"},{"id":"semetey-1-2013:p0869:b003:l029","ordinal":143463,"en":"Saying, ‘I shall serve as imam,’"},{"id":"semetey-1-2013:p0869:b003:l030","ordinal":143464,"en":"He came from the Arab land."},{"id":"semetey-1-2013:p0869:b003:l031","ordinal":143465,"en":"The small band of Muslims—"},{"id":"semetey-1-2013:p0869:b003:l032","ordinal":143466,"en":"The people filled the place, seething like insects."},{"id":"semetey-1-2013:p0869:b003:l033","ordinal":143467,"en":"Khan Koshoi of the Katagan"},{"id":"semetey-1-2013:p0869:b003:l034","ordinal":143468,"en":"Was the one who held the banner."},{"id":"semetey-1-2013:p0869:b003:l035","ordinal":143469,"en":"Mighty Almam was there too,"},{"id":"semetey-1-2013:p0869:b003:l036","ordinal":143470,"en":"The finest of the sixty,"},{"id":"semetey-1-2013:p0869:b003:l037","ordinal":143471,"en":"The strongest of the forty companions,"},{"id":"semetey-1-2013:p0869:b003:l038","ordinal":143472,"en":"Chubak and Syrgak were there together."},{"id":"semetey-1-2013:p0869:b003:l039","ordinal":143473,"en":"Kakan's people were a vast host—"},{"id":"semetey-1-2013:p0869:b004:l001","ordinal":143474,"en":"Their numbers were like a black swarm of insects."},{"id":"semetey-1-2013:p0869:b004:l002","ordinal":143475,"en":"We were drenched in bloody gore;"},{"id":"semetey-1-2013:p0869:b004:l003","ordinal":143476,"en":"For six months we fought without fleeing."},{"id":"semetey-1-2013:p0869:b004:l004","ordinal":143477,"en":"Going forth to single combat,"},{"id":"semetey-1-2013:p0869:b004:l005","ordinal":143478,"en":"For seven months we fought without ceasing."},{"id":"semetey-1-2013:p0869:b004:l006","ordinal":143479,"en":"Kara-Shaar and Kambyl—"},{"id":"semetey-1-2013:p0869:b004:l007","ordinal":143480,"en":"I was the Bakai who besieged them;"},{"id":"semetey-1-2013:p0869:b004:l008","ordinal":143481,"en":"The Manchus, with crashing blows—"},{"id":"semetey-1-2013:p0869:b004:l009","ordinal":143482,"en":"I was the Bakai who battered them."},{"id":"semetey-1-2013:p0869:b004:l010","ordinal":143483,"en":"Upon everyone I could reach,"},{"id":"semetey-1-2013:p0869:b004:l011","ordinal":143484,"en":"I was the Bakai who wrought havoc;"},{"id":"semetey-1-2013:p0869:b004:l012","ordinal":143485,"en":"The whole world, bringing it to submission—"},{"id":"semetey-1-2013:p0869:b004:l013","ordinal":143486,"en":"I was the Bakai who took it."},{"id":"semetey-1-2013:p0869:b004:l014","ordinal":143487,"en":"Does not a man whose time has come die?"},{"id":"semetey-1-2013:p0869:b004:l015","ordinal":143488,"en":"The fate that Allah ordains,"},{"id":"semetey-1-2013:p0869:b004:l016","ordinal":143489,"en":"Must not a wretched mortal face it?"},{"id":"semetey-1-2013:p0869:b004:l017","ordinal":143490,"en":"If an army comes to overwhelm us,"},{"id":"semetey-1-2013:p0869:b004:l018","ordinal":143491,"en":"Will not Bakai deal with it?"},{"id":"semetey-1-2013:p0869:b004:l019","ordinal":143492,"en":"When my mighty Manas died,"},{"id":"semetey-1-2013:p0869:b004:l020","ordinal":143493,"en":"For twelve years I remained;"},{"id":"semetey-1-2013:p0869:b004:l021","ordinal":143494,"en":"With those dogs Abyke and Kobosh"},{"id":"semetey-1-2013:p0869:b004:l022","ordinal":143495,"en":"For twelve years I exchanged shots."},{"id":"semetey-1-2013:p0869:b004:l023","ordinal":143496,"en":"Where is my death,"},{"id":"semetey-1-2013:p0869:b004:l024","ordinal":143497,"en":"My sight of Judgment Day?"},{"id":"semetey-1-2013:p0869:b004:l025","ordinal":143498,"en":"Our kin, sprung from the same root—"},{"id":"semetey-1-2013:p0869:b004:l026","ordinal":143499,"en":"We shall watch how far they go."},{"id":"semetey-1-2013:p0869:b004:l027","ordinal":143500,"en":"If they overstep the limit,"},{"id":"semetey-1-2013:p0869:b004:l028","ordinal":143501,"en":"Then we shall fight."},{"id":"semetey-1-2013:p0869:b004:l029","ordinal":143502,"en":"Those unbelieving sons of Kazakhs,"},{"id":"semetey-1-2013:p0869:b004:l030","ordinal":143503,"en":"Those wretches yelling their battle cries,"},{"id":"semetey-1-2013:p0869:b004:l031","ordinal":143504,"en":"If we clash, we shall slaughter them."},{"id":"semetey-1-2013:p0869:b004:l032","ordinal":143505,"en":"If we fight, slaughter will follow;"},{"id":"semetey-1-2013:p0869:b004:l033","ordinal":143506,"en":"Where shall we find brothers then?"},{"id":"semetey-1-2013:p0869:b004:l034","ordinal":143507,"en":"If an army comes to fight with lances,"},{"id":"semetey-1-2013:p0869:b004:l035","ordinal":143508,"en":"If our lives are in grave peril,"},{"id":"semetey-1-2013:p0869:b004:l036","ordinal":143509,"en":"Then let us wreak slaughter;"},{"id":"semetey-1-2013:p0869:b004:l037","ordinal":143510,"en":"Manas's orphan son—"},{"id":"semetey-1-2013:p0869:b004:l038","ordinal":143511,"en":"Let us rescue him,”"},{"id":"semetey-1-2013:p0870:b003:l001","ordinal":143512,"en":"Having spoken thus, mighty Bakai"},{"id":"semetey-1-2013:p0870:b003:l002","ordinal":143513,"en":"Took the war drum left by Manas"},{"id":"semetey-1-2013:p0870:b003:l003","ordinal":143514,"en":"Into his hands,"},{"id":"semetey-1-2013:p0870:b003:l004","ordinal":143515,"en":"And struck it in the middle."},{"id":"semetey-1-2013:p0870:b003:l005","ordinal":143516,"en":"The Argyn and the Kyrgyz"},{"id":"semetey-1-2013:p0870:b003:l006","ordinal":143517,"en":"He gathered, leaving no one out."},{"id":"semetey-1-2013:p0870:b003:l007","ordinal":143518,"en":"Bakai's son Baitailak"},{"id":"semetey-1-2013:p0870:b003:l008","ordinal":143519,"en":"Had never before ridden into battle,"},{"id":"semetey-1-2013:p0870:b003:l010","ordinal":143520,"en":"And did not yet know the ways of war."},{"id":"semetey-1-2013:p0870:b003:l011","ordinal":143521,"en":"Sary Khan's Kalyk,"},{"id":"semetey-1-2013:p0870:b003:l012","ordinal":143522,"en":"When the Muslims fought,"},{"id":"semetey-1-2013:p0870:b003:l013","ordinal":143523,"en":"And cast down the kaldai's banner,"},{"id":"semetey-1-2013:p0870:b003:l014","ordinal":143524,"en":"Had brought his light to the people."},{"id":"semetey-1-2013:p0870:b003:l015","ordinal":143525,"en":"They mounted horses no bullet could catch,"},{"id":"semetey-1-2013:p0870:b003:l016","ordinal":143526,"en":"And wore coats no bullet could pierce."},{"id":"semetey-1-2013:p0870:b003:l017","ordinal":143527,"en":"Taking their spears, they made ready,"},{"id":"semetey-1-2013:p0870:b003:l018","ordinal":143528,"en":"And fastened on their battle-axes."},{"id":"semetey-1-2013:p0870:b003:l019","ordinal":143529,"en":"Dressed in the garb of war,"},{"id":"semetey-1-2013:p0870:b003:l020","ordinal":143530,"en":"He too came rejoicing."},{"id":"semetey-1-2013:p0870:b003:l021","ordinal":143531,"en":"‘If my appointed death has come, I shall die;"},{"id":"semetey-1-2013:p0870:b003:l022","ordinal":143532,"en":"For the orphan son of Manas,"},{"id":"semetey-1-2013:p0870:b003:l023","ordinal":143533,"en":"I shall serve as a protector,’ he said."},{"id":"semetey-1-2013:p0870:b003:l024","ordinal":143534,"en":"Zhamgyrchy of the Eshteks"},{"id":"semetey-1-2013:p0870:b003:l025","ordinal":143535,"en":"Was an influential khan,"},{"id":"semetey-1-2013:p0870:b003:l026","ordinal":143536,"en":"For Manas, the gray-maned noble steed,"},{"id":"semetey-1-2013:p0870:b003:l027","ordinal":143537,"en":"He had been a steadfast support."},{"id":"semetey-1-2013:p0870:b004:l001","ordinal":143538,"en":"Sharing the same livestock pens,"},{"id":"semetey-1-2013:p0870:b004:l002","ordinal":143539,"en":"Sharing food as comrades,"},{"id":"semetey-1-2013:p0870:b004:l003","ordinal":143540,"en":"Zhamgyrchy's Shayymbet"},{"id":"semetey-1-2013:p0870:b004:l004","ordinal":143541,"en":"Took a pale-mottled flag and banner,"},{"id":"semetey-1-2013:p0870:b004:l005","ordinal":143542,"en":"And raised a clamorous cry."},{"id":"semetey-1-2013:p0870:b004:l006","ordinal":143543,"en":"‘If my appointed death has come, I shall die;"},{"id":"semetey-1-2013:p0870:b004:l007","ordinal":143544,"en":"For the orphan left by Manas,"},{"id":"semetey-1-2013:p0870:b004:l008","ordinal":143545,"en":"I shall serve as a protector,’ he said."},{"id":"semetey-1-2013:p0870:b004:l009","ordinal":143546,"en":"The strongman Shayymbet came."},{"id":"semetey-1-2013:p0870:b004:l010","ordinal":143547,"en":"All were sons of khans,"},{"id":"semetey-1-2013:p0870:b004:l011","ordinal":143548,"en":"With souls like angels of death."},{"id":"semetey-1-2013:p0870:b004:l012","ordinal":143549,"en":"Their elders, led by Bakai,"},{"id":"semetey-1-2013:p0870:b004:l013","ordinal":143550,"en":"Sary Khan upon Tuuchunak,"},{"id":"semetey-1-2013:p0870:b004:l014","ordinal":143551,"en":"And all the warriors,"},{"id":"semetey-1-2013:p0870:b004:l015","ordinal":143552,"en":"Prepared their weapons."},{"id":"semetey-1-2013:p0870:b004:l016","ordinal":143553,"en":"If Semetey were attacked,"},{"id":"semetey-1-2013:p0870:b004:l017","ordinal":143554,"en":"To sweep down upon the foe,"},{"id":"semetey-1-2013:p0870:b004:l018","ordinal":143555,"en":"All the warriors made ready."},{"id":"semetey-1-2013:p0870:b004:l019","ordinal":143556,"en":"In the hollow of Zhylgynduu,"},{"id":"semetey-1-2013:p0870:b004:l020","ordinal":143557,"en":"Along broad Talas,"},{"id":"semetey-1-2013:p0870:b004:l021","ordinal":143558,"en":"They divided into hundreds,"},{"id":"semetey-1-2013:p0870:b004:l022","ordinal":143559,"en":"All appearing like lions."},{"id":"semetey-1-2013:p0870:b004:l023","ordinal":143560,"en":"They turned their horses,"},{"id":"semetey-1-2013:p0870:b004:l024","ordinal":143561,"en":"And all stood watchfully."},{"id":"semetey-1-2013:p0870:b004:l025","ordinal":143562,"en":"Let us leave them thus."},{"id":"semetey-1-2013:p0870:b004:l026","ordinal":143563,"en":"Of the great army sweeping toward them,"},{"id":"semetey-1-2013:p0870:b004:l027","ordinal":143564,"en":"Let us now begin the news."},{"id":"semetey-1-2013:p0871:b004:l001","ordinal":143565,"en":"Abyke and Kobosh—two villains,"},{"id":"semetey-1-2013:p0871:b004:l002","ordinal":143566,"en":"Chyybyt and Kochkor—four villains,"},{"id":"semetey-1-2013:p0871:b004:l003","ordinal":143567,"en":"Azhybai and Kolbai—six villains,"},{"id":"semetey-1-2013:p0871:b004:l004","ordinal":143568,"en":"And the forty warriors left by Manas,"},{"id":"semetey-1-2013:p0871:b004:l005","ordinal":143569,"en":"Having raised Kobosh as khan,"},{"id":"semetey-1-2013:p0871:b004:l006","ordinal":143570,"en":"Gathered troops from hostile khans."},{"id":"semetey-1-2013:p0871:b004:l007","ordinal":143571,"en":"They gathered a vast, numerous army,"},{"id":"semetey-1-2013:p0871:b004:l008","ordinal":143572,"en":"Making it trample the face of the earth,"},{"id":"semetey-1-2013:p0871:b004:l009","ordinal":143573,"en":"Making it swarm across the land."},{"id":"semetey-1-2013:p0871:b004:l010","ordinal":143574,"en":"Men crowded together, swaying,"},{"id":"semetey-1-2013:p0871:b004:l011","ordinal":143575,"en":"Surging in confusion."},{"id":"semetey-1-2013:p0871:b004:l012","ordinal":143576,"en":"They spread their lancers out,"},{"id":"semetey-1-2013:p0871:b004:l013","ordinal":143577,"en":"With the forty warriors driving the rear."},{"id":"semetey-1-2013:p0871:b004:l014","ordinal":143578,"en":"An agitated army was coming,"},{"id":"semetey-1-2013:p0871:b004:l015","ordinal":143579,"en":"An army came to trample all,"},{"id":"semetey-1-2013:p0871:b004:l016","ordinal":143580,"en":"Pale-mottled flags and banners came,"},{"id":"semetey-1-2013:p0871:b004:l017","ordinal":143581,"en":"A clamorous uproar came."},{"id":"semetey-1-2013:p0871:b004:l018","ordinal":143582,"en":"They divided into successive waves."},{"id":"semetey-1-2013:p0871:b004:l019","ordinal":143583,"en":"Watching them, Kanykei,"},{"id":"semetey-1-2013:p0871:b004:l020","ordinal":143584,"en":"Your dear, fierce mother,"},{"id":"semetey-1-2013:p0871:b004:l021","ordinal":143585,"en":"Shed tears from her eyes."},{"id":"semetey-1-2013:p0871:b004:l022","ordinal":143586,"en":"From those dear quail-like eyes,"},{"id":"semetey-1-2013:p0871:b004:l023","ordinal":143587,"en":"Tears fell in separate drops."},{"id":"semetey-1-2013:p0871:b004:l024","ordinal":143588,"en":"From those dear currant-like eyes,"},{"id":"semetey-1-2013:p0871:b004:l025","ordinal":143589,"en":"Tears streamed a whip's length."},{"id":"semetey-1-2013:p0871:b004:l026","ordinal":143590,"en":"‘My beloved Creator,"},{"id":"semetey-1-2013:p0871:b004:l027","ordinal":143591,"en":"Will they dig my pit?"},{"id":"semetey-1-2013:p0871:b004:l028","ordinal":143592,"en":"The orphan on whom I lean,"},{"id":"semetey-1-2013:p0871:b004:l029","ordinal":143593,"en":"Will they seize and slaughter him,"},{"id":"semetey-1-2013:p0871:b004:l030","ordinal":143594,"en":"And boil up my misery?"},{"id":"semetey-1-2013:p0871:b004:l031","ordinal":143595,"en":"The plump, pale-mottled female goshawk,"},{"id":"semetey-1-2013:p0871:b004:l032","ordinal":143596,"en":"The gray hawk, my morning star—"},{"id":"semetey-1-2013:p0871:b004:l033","ordinal":143597,"en":"If they overwhelm him, God will strike me down;"},{"id":"semetey-1-2013:p0871:b004:l034","ordinal":143598,"en":"What will Allah do?"},{"id":"semetey-1-2013:p0871:b004:l035","ordinal":143599,"en":"While these six villains live,"},{"id":"semetey-1-2013:p0871:b004:l036","ordinal":143600,"en":"Broad Talas will be no homeland for us,"},{"id":"semetey-1-2013:p0871:b005:l001","ordinal":143601,"en":"These Kyrgyz will be no people of ours."},{"id":"semetey-1-2013:p0871:b005:l002","ordinal":143602,"en":"Those six villains gathered before,"},{"id":"semetey-1-2013:p0871:b005:l003","ordinal":143603,"en":"And attacked my migrating household in Talas."},{"id":"semetey-1-2013:p0871:b005:l004","ordinal":143604,"en":"Cursed be my womanhood!"},{"id":"semetey-1-2013:p0871:b005:l005","ordinal":143605,"en":"I left without taking vengeance on the villains!"},{"id":"semetey-1-2013:p0871:b005:l006","ordinal":143606,"en":"They have words they keep repeating;"},{"id":"semetey-1-2013:p0871:b005:l007","ordinal":143607,"en":"Those dogs who will not perish"},{"id":"semetey-1-2013:p0871:b005:l008","ordinal":143608,"en":"Bear a spear's length of rancor."},{"id":"semetey-1-2013:p0871:b005:l009","ordinal":143609,"en":"When I fled this place,"},{"id":"semetey-1-2013:p0871:b005:l010","ordinal":143610,"en":"They scattered my people from Talas;"},{"id":"semetey-1-2013:p0871:b005:l011","ordinal":143611,"en":"Cursed be my womanhood!"},{"id":"semetey-1-2013:p0871:b005:l012","ordinal":143612,"en":"I left without exacting redress from the dogs!"},{"id":"semetey-1-2013:p0871:b005:l013","ordinal":143613,"en":"The spring flowing from the hills—"},{"id":"semetey-1-2013:p0871:b005:l014","ordinal":143614,"en":"Perhaps they have trampled it again."},{"id":"semetey-1-2013:p0871:b005:l015","ordinal":143615,"en":"My cherished lamp—"},{"id":"semetey-1-2013:p0871:b005:l016","ordinal":143616,"en":"Will God strike him down like this?’"}]
