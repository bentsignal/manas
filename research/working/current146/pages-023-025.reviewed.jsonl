{"id": "sayakbay-ms-current146:pdf023:l006", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 23, "folio": 406, "line_in_page": 6, "raw": "Өкүмөт жоо жыйнады,", "text": "Өкүмөт жоо жыйнады,", "en": "The ruler gathered an army,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Өкүмөт is a close visual reading and may be another inflected word; English is contextual.", "bbox": null}
