[{"id":"manas-2010:p0192:b002:l039","ordinal":8449,"en":"Taking a crescent-crested banner,"},{"id":"manas-2010:p0192:b002:l040","ordinal":8450,"en":"Leading the yellow host,"},{"id":"manas-2010:p0192:b002:l041","ordinal":8451,"en":"Turned toward the great mound."},{"id":"manas-2010:p0192:b002:l042","ordinal":8452,"en":"Their Torguts gathered in full."},{"id":"manas-2010:p0192:b002:l043","ordinal":8453,"en":"Dust flew into the sky;"},{"id":"manas-2010:p0192:b002:l044","ordinal":8454,"en":"The army marched in a rumbling throng."},{"id":"manas-2010:p0192:b002:l045","ordinal":8455,"en":"Spear tips clashed,"},{"id":"manas-2010:p0192:b002:l046","ordinal":8456,"en":"People's heads knocked together."},{"id":"manas-2010:p0192:b002:l047","ordinal":8457,"en":"The sky was clear, the earth overcast;"},{"id":"manas-2010:p0192:b002:l048","ordinal":8458,"en":"Not one blade on the ground could be seen,"},{"id":"manas-2010:p0193:b002:l001","ordinal":8459,"en":"Looking, the eye could catch nothing;"},{"id":"manas-2010:p0193:b002:l002","ordinal":8460,"en":"Where they had gone could not be known."},{"id":"manas-2010:p0193:b002:l003","ordinal":8461,"en":"Like flying tumbleweed,"},{"id":"manas-2010:p0193:b002:l004","ordinal":8462,"en":"They swept toward Manas."},{"id":"manas-2010:p0193:b002:l005","ordinal":8463,"en":"The finest foe, warrior Döngö,"},{"id":"manas-2010:p0193:b002:l006","ordinal":8464,"en":"Esenkan's army set in motion,"},{"id":"manas-2010:p0193:b002:l007","ordinal":8465,"en":"The swine who had received the decree"},{"id":"manas-2010:p0193:b002:l008","ordinal":8466,"en":"Were countless in their multitude."},{"id":"manas-2010:p0193:b002:l009","ordinal":8467,"en":"Gray-pied pennants swayed."},{"id":"manas-2010:p0193:b002:l010","ordinal":8468,"en":"Roaring upon Achbuudan,"},{"id":"manas-2010:p0193:b002:l011","ordinal":8469,"en":"Warrior Zholoy drove them,"},{"id":"manas-2010:p0193:b002:l012","ordinal":8470,"en":"Sweeping them toward Manas."},{"id":"manas-2010:p0193:b002:l013","ordinal":8471,"en":"In the great army he drove,"},{"id":"manas-2010:p0193:b002:l014","ordinal":8472,"en":"Beads, toggles, coral stones,"},{"id":"manas-2010:p0193:b002:l015","ordinal":8473,"en":"The khan of Lung-Tung was among them."},{"id":"manas-2010:p0193:b002:l016","ordinal":8474,"en":"The axe-bearers stood apart."},{"id":"manas-2010:p0193:b002:l017","ordinal":8475,"en":"The multitude of Chinese cried “Kakan!”"},{"id":"manas-2010:p0193:b002:l018","ordinal":8476,"en":"A great many had gathered."},{"id":"manas-2010:p0193:b002:l019","ordinal":8477,"en":"There were troops of every kind,"},{"id":"manas-2010:p0193:b002:l020","ordinal":8478,"en":"There were fearsome people,"},{"id":"manas-2010:p0193:b002:l021","ordinal":8479,"en":"There were giants no horse could carry."},{"id":"manas-2010:p0193:b002:l022","ordinal":8480,"en":"Many wrestlers of various kinds"},{"id":"manas-2010:p0193:b002:l023","ordinal":8481,"en":"Had come, the valiant ones."},{"id":"manas-2010:p0193:b002:l024","ordinal":8482,"en":"Some bore nets of iron rope;"},{"id":"manas-2010:p0193:b002:l025","ordinal":8483,"en":"Those who would sweep round,"},{"id":"manas-2010:p0193:b002:l026","ordinal":8484,"en":"Some had dagger-covered arms."},{"id":"manas-2010:p0193:b002:l027","ordinal":8485,"en":"There were giants of every kind."},{"id":"manas-2010:p0193:b002:l028","ordinal":8486,"en":"Those Chinese, may your houses burn,"},{"id":"manas-2010:p0193:b002:l029","ordinal":8487,"en":"Had giants of many kinds."},{"id":"manas-2010:p0193:b002:l030","ordinal":8488,"en":"There were skillful lasso throwers,"},{"id":"manas-2010:p0193:b002:l031","ordinal":8489,"en":"There were expert bow drawers,"},{"id":"manas-2010:p0193:b002:l032","ordinal":8490,"en":"There were warriors of every kind."},{"id":"manas-2010:p0193:b002:l033","ordinal":8491,"en":"Their tale was great turmoil;"},{"id":"manas-2010:p0193:b002:l034","ordinal":8492,"en":"The telling of them would never end."},{"id":"manas-2010:p0193:b002:l035","ordinal":8493,"en":"There were khans who showed courage."},{"id":"manas-2010:p0193:b002:l036","ordinal":8494,"en":"To shout and raise encouraging cries,"},{"id":"manas-2010:p0193:b002:l037","ordinal":8495,"en":"All their kalday were there."},{"id":"manas-2010:p0193:b002:l038","ordinal":8496,"en":"There were warriors beyond understanding,"},{"id":"manas-2010:p0193:b002:l039","ordinal":8497,"en":"There was their giant, warrior Döngö."},{"id":"manas-2010:p0193:b002:l040","ordinal":8498,"en":"War drums were beaten hard."},{"id":"manas-2010:p0193:b002:l041","ordinal":8499,"en":"The seething soldiers"},{"id":"manas-2010:p0193:b002:l042","ordinal":8500,"en":"Swept forward all together."},{"id":"manas-2010:p0193:b002:l043","ordinal":8501,"en":"The sun flickered out of sight,"},{"id":"manas-2010:p0193:b002:l044","ordinal":8502,"en":"The earth grew dim and dirty."},{"id":"manas-2010:p0193:b002:l045","ordinal":8503,"en":"The wrestlers were about to arrive,"},{"id":"manas-2010:p0193:b002:l046","ordinal":8504,"en":"Merging with the face of the earth."},{"id":"manas-2010:p0193:b002:l047","ordinal":8505,"en":"Their leaders of ten darted about;"},{"id":"manas-2010:p0193:b002:l048","ordinal":8506,"en":"Their leaders of fifty scurried,"},{"id":"manas-2010:p0194:b002:l001","ordinal":8507,"en":"Their leaders of a hundred ran;"},{"id":"manas-2010:p0194:b002:l002","ordinal":8508,"en":"All their leaders of a thousand"},{"id":"manas-2010:p0194:b002:l003","ordinal":8509,"en":"Despaired of their lives."},{"id":"manas-2010:p0194:b002:l004","ordinal":8510,"en":"Red banners with crescent crests,"},{"id":"manas-2010:p0194:b002:l005","ordinal":8511,"en":"Piercing shouts and clamor,"},{"id":"manas-2010:p0194:b002:l006","ordinal":8512,"en":"Gray-pied pennants, red banners,"},{"id":"manas-2010:p0194:b002:l007","ordinal":8513,"en":"Cries of “Boy-boy!” and clamor,"},{"id":"manas-2010:p0194:b002:l008","ordinal":8514,"en":"Charging in a raiding mass,"},{"id":"manas-2010:p0194:b002:l009","ordinal":8515,"en":"The Chinese launched their attack swiftly,"},{"id":"manas-2010:p0194:b002:l010","ordinal":8516,"en":"Roaring in wrath."},{"id":"manas-2010:p0194:b002:l011","ordinal":8517,"en":"If you looked at the army's rear,"},{"id":"manas-2010:p0194:b002:l012","ordinal":8518,"en":"They raised the battle cry “Manchu!”"},{"id":"manas-2010:p0194:b002:l013","ordinal":8519,"en":"Dividing into groups and shouting,"},{"id":"manas-2010:p0194:b002:l014","ordinal":8520,"en":"A singular, grievous undertaking,"},{"id":"manas-2010:p0194:b002:l015","ordinal":8521,"en":"They raised the battle cry “Möndü!”"},{"id":"manas-2010:p0194:b002:l016","ordinal":8522,"en":"The gray-horse riders separated."},{"id":"manas-2010:p0194:b002:l017","ordinal":8523,"en":"All the warriors"},{"id":"manas-2010:p0194:b002:l018","ordinal":8524,"en":"Stood out at the edges for the eye to see."},{"id":"manas-2010:p0194:b002:l019","ordinal":8525,"en":"Surnays deafened the ears,"},{"id":"manas-2010:p0194:b002:l020","ordinal":8526,"en":"Drums boomed loudly,"},{"id":"manas-2010:p0194:b002:l021","ordinal":8527,"en":"Copper trumpets clattered."},{"id":"manas-2010:p0194:b002:l022","ordinal":8528,"en":"Their Torguts, Manchus and Chinese,"},{"id":"manas-2010:p0194:b002:l023","ordinal":8529,"en":"Every one had gathered."},{"id":"manas-2010:p0194:b002:l024","ordinal":8530,"en":"From the shrill copper trumpets,"},{"id":"manas-2010:p0194:b002:l025","ordinal":8531,"en":"From the broad ravine where no bird could fly,"},{"id":"manas-2010:p0194:b002:l026","ordinal":8532,"en":"From the spears no foe could escape,"},{"id":"manas-2010:p0194:b002:l027","ordinal":8533,"en":"Their warriors grew restless."},{"id":"manas-2010:p0194:b002:l028","ordinal":8534,"en":"Their lions were at the front,"},{"id":"manas-2010:p0194:b002:l029","ordinal":8535,"en":"The Chinese of every kind,"},{"id":"manas-2010:p0194:b002:l030","ordinal":8536,"en":"Their warriors at the flanks."},{"id":"manas-2010:p0194:b002:l031","ordinal":8537,"en":"Those who would sate themselves with bloody blood,"},{"id":"manas-2010:p0194:b002:l032","ordinal":8538,"en":"Who would fight without fleeing,"},{"id":"manas-2010:p0194:b002:l033","ordinal":8539,"en":"There were seasoned fighters too."},{"id":"manas-2010:p0194:b002:l034","ordinal":8540,"en":"Those who would wheel spears and fight,"},{"id":"manas-2010:p0194:b002:l035","ordinal":8541,"en":"Who would deftly discern the enemy's means,"},{"id":"manas-2010:p0194:b002:l036","ordinal":8542,"en":"There were warriors, there were khans,"},{"id":"manas-2010:p0194:b002:l037","ordinal":8543,"en":"All the foremost men were there."},{"id":"manas-2010:p0194:b002:l038","ordinal":8544,"en":"There were skillful spearmen,"},{"id":"manas-2010:p0194:b002:l039","ordinal":8545,"en":"There were experts who knew the enemy's means,"},{"id":"manas-2010:p0194:b002:l040","ordinal":8546,"en":"There were warriors vast as mountains."},{"id":"manas-2010:p0194:b002:l041","ordinal":8547,"en":"Seething like ants,"},{"id":"manas-2010:p0194:b002:l042","ordinal":8548,"en":"There were many mad wretches."},{"id":"manas-2010:p0194:b002:l043","ordinal":8549,"en":"Beginning a campaign and raising strife,"},{"id":"manas-2010:p0194:b002:l044","ordinal":8550,"en":"Here and there the infidels"},{"id":"manas-2010:p0194:b002:l045","ordinal":8551,"en":"Struck their war drums."},{"id":"manas-2010:p0194:b002:l046","ordinal":8552,"en":"Their appearance was fearsome,"},{"id":"manas-2010:p0194:b002:l047","ordinal":8553,"en":"Their hostile bearing showed."},{"id":"manas-2010:p0194:b002:l048","ordinal":8554,"en":"They fixed their enmity upon them,"},{"id":"manas-2010:p0195:b002:l001","ordinal":8555,"en":"Taking orders from their warriors,"},{"id":"manas-2010:p0195:b002:l002","ordinal":8556,"en":"The great army swept onward."},{"id":"manas-2010:p0195:b002:l003","ordinal":8557,"en":"The one they would fight was rich Jakyp;"},{"id":"manas-2010:p0195:b002:l004","ordinal":8558,"en":"The one they would seize was Akbaltay;"},{"id":"manas-2010:p0195:b002:l005","ordinal":8559,"en":"The ones they would kill were the forty households."},{"id":"manas-2010:p0195:b002:l006","ordinal":8560,"en":"Their chief object"},{"id":"manas-2010:p0195:b002:l007","ordinal":8561,"en":"Was Jakyp's son, mighty Manas."},{"id":"manas-2010:p0195:b002:l008","ordinal":8562,"en":"God, do not let us behold their faces!"},{"id":"manas-2010:p0195:b002:l009","ordinal":8563,"en":"They trampled the face of the earth."},{"id":"manas-2010:p0195:b002:l010","ordinal":8564,"en":"The adept Döngö and warrior Zholoy"},{"id":"manas-2010:p0195:b002:l011","ordinal":8565,"en":"Swept forward in a raiding mass,"},{"id":"manas-2010:p0195:b002:l012","ordinal":8566,"en":"Brought utter devastation."},{"id":"manas-2010:p0195:b002:l013","ordinal":8567,"en":"To capture Manas,"},{"id":"manas-2010:p0195:b002:l014","ordinal":8568,"en":"They raised doomsday strife."},{"id":"manas-2010:p0195:b002:l015","ordinal":8569,"en":"If they should happen to seize him,"},{"id":"manas-2010:p0195:b002:l016","ordinal":8570,"en":"To finish them all together,"},{"id":"manas-2010:p0195:b002:l017","ordinal":8571,"en":"To Chin-Machin, to Beijing,"},{"id":"manas-2010:p0195:b002:l018","ordinal":8572,"en":"To bring him alive in bonds,"},{"id":"manas-2010:p0195:b002:l019","ordinal":8573,"en":"To wreak whatever strife they knew,"},{"id":"manas-2010:p0195:b002:l020","ordinal":8574,"en":"If they captured the bloodthirsty one,"},{"id":"manas-2010:p0195:b002:l021","ordinal":8575,"en":"Before Khan Esen"},{"id":"manas-2010:p0195:b002:l022","ordinal":8576,"en":"To bring and present him,"},{"id":"manas-2010:p0195:b002:l023","ordinal":8577,"en":"The Chinese stirred in frenzy."},{"id":"manas-2010:p0195:b002:l024","ordinal":8578,"en":"Your infidels had taken up their cause,"},{"id":"manas-2010:p0195:b002:l025","ordinal":8579,"en":"Stirring in many forms."},{"id":"manas-2010:p0195:b002:l026","ordinal":8580,"en":"Teeming like ants,"},{"id":"manas-2010:p0195:b002:l027","ordinal":8581,"en":"The great army swept onward."},{"id":"manas-2010:p0195:b002:l028","ordinal":8582,"en":"Unless God found a way,"},{"id":"manas-2010:p0195:b002:l029","ordinal":8583,"en":"The Chinese swarmed in encirclement."},{"id":"manas-2010:p0195:b002:l030","ordinal":8584,"en":"Not merely forty households, these Chinese"},{"id":"manas-2010:p0195:b002:l031","ordinal":8585,"en":"Seemed able to engulf the world,"},{"id":"manas-2010:p0195:b002:l032","ordinal":8586,"en":"The death of all who grappled with them"},{"id":"manas-2010:p0195:b002:l033","ordinal":8587,"en":"Seemed about to come at once."},{"id":"manas-2010:p0195:b002:l034","ordinal":8588,"en":"No mortal could face them;"},{"id":"manas-2010:p0195:b002:l035","ordinal":8589,"en":"The infidels filled with wrath,"},{"id":"manas-2010:p0195:b002:l036","ordinal":8590,"en":"None who provoked them could remain alive."},{"id":"manas-2010:p0195:b002:l037","ordinal":8591,"en":"The army swept on, the earth teeming,"},{"id":"manas-2010:p0195:b002:l038","ordinal":8592,"en":"Turmoil descending, misery boiling,"},{"id":"manas-2010:p0195:b002:l039","ordinal":8593,"en":"The earth teeming with their multitude."},{"id":"manas-2010:p0195:b002:l040","ordinal":8594,"en":"Roaring in wrath,"},{"id":"manas-2010:p0195:b002:l041","ordinal":8595,"en":"When they swept forward in a raiding mass,"},{"id":"manas-2010:p0195:b002:l042","ordinal":8596,"en":"All raised the battle cry “Möndü!”"},{"id":"manas-2010:p0195:b002:l043","ordinal":8597,"en":"Dividing into surging groups,"},{"id":"manas-2010:p0195:b002:l044","ordinal":8598,"en":"Seeming to spare no soul,"},{"id":"manas-2010:p0195:b002:l045","ordinal":8599,"en":"Their crested banners bent."},{"id":"manas-2010:p0195:b002:l046","ordinal":8600,"en":"Those who saw despaired of life."},{"id":"manas-2010:p0195:b002:l047","ordinal":8601,"en":"Warrior Döngö before the army,"},{"id":"manas-2010:p0195:b002:l048","ordinal":8602,"en":"Great Zholoy behind the army,"},{"id":"manas-2010:p0196:b002:l001","ordinal":8603,"en":"His gluttony was exceptional;"},{"id":"manas-2010:p0196:b002:l002","ordinal":8604,"en":"He spared none he met."},{"id":"manas-2010:p0196:b002:l003","ordinal":8605,"en":"On the meat of a single bullock,"},{"id":"manas-2010:p0196:b002:l004","ordinal":8606,"en":"He could not eat his fill in one sitting."},{"id":"manas-2010:p0196:b002:l005","ordinal":8607,"en":"He spared none who faced him,"},{"id":"manas-2010:p0196:b002:l006","ordinal":8608,"en":"Dear Zholoy, the seasoned fighter,"},{"id":"manas-2010:p0196:b002:l007","ordinal":8609,"en":"Sent with the utmost trust,"},{"id":"manas-2010:p0196:b002:l008","ordinal":8610,"en":"Esenkan's very right hand."},{"id":"manas-2010:p0196:b002:l009","ordinal":8611,"en":"His expert who would capture the foe,"},{"id":"manas-2010:p0196:b002:l010","ordinal":8612,"en":"Dear Zholoy and warrior Döngö,"},{"id":"manas-2010:p0196:b002:l011","ordinal":8613,"en":"More seasoned than many,"},{"id":"manas-2010:p0196:b002:l012","ordinal":8614,"en":"Their chosen brave men apart,"},{"id":"manas-2010:p0196:b002:l013","ordinal":8615,"en":"They had made them ready."},{"id":"manas-2010:p0196:b002:l014","ordinal":8616,"en":"Their great army thundering,"},{"id":"manas-2010:p0196:b002:l015","ordinal":8617,"en":"They had driven it forth."},{"id":"manas-2010:p0196:b002:l016","ordinal":8618,"en":"Beating them like lean sheep,"},{"id":"manas-2010:p0196:b002:l017","ordinal":8619,"en":"He herded them onward."},{"id":"manas-2010:p0196:b002:l018","ordinal":8620,"en":"Beating them from behind,"},{"id":"manas-2010:p0196:b002:l019","ordinal":8621,"en":"What did dear Zholoy do?"},{"id":"manas-2010:p0196:b002:l020","ordinal":8622,"en":"He drove them onward."},{"id":"manas-2010:p0196:b002:l021","ordinal":8623,"en":"A warrior vast as a mountain came."},{"id":"manas-2010:p0196:b002:l022","ordinal":8624,"en":"At the infidel's wrath,"},{"id":"manas-2010:p0196:b002:l023","ordinal":8625,"en":"The earth shook and swayed."},{"id":"manas-2010:p0196:b002:l024","ordinal":8626,"en":"The seasoned army swept on thundering."},{"id":"manas-2010:p0196:b002:l025","ordinal":8627,"en":"Warrior Zholoy was accomplished indeed,"},{"id":"manas-2010:p0196:b002:l026","ordinal":8628,"en":"Driving the armies with a thunderous roar."},{"id":"manas-2010:p0196:b002:l027","ordinal":8629,"en":"He held a mace as big as a house."},{"id":"manas-2010:p0196:b002:l028","ordinal":8630,"en":"His bulk loomed like a crested mountain."},{"id":"manas-2010:p0196:b002:l029","ordinal":8631,"en":"Whoever provoked him,"},{"id":"manas-2010:p0196:b002:l030","ordinal":8632,"en":"Their blood was simply spilled."},{"id":"manas-2010:p0196:b002:l031","ordinal":8633,"en":"His courage was high, his venom strong."},{"id":"manas-2010:p0196:b002:l032","ordinal":8634,"en":"The person who provoked him,"},{"id":"manas-2010:p0196:b002:l033","ordinal":8635,"en":"He would kill, slaughter and level."},{"id":"manas-2010:p0196:b002:l034","ordinal":8636,"en":"His wrath looked exceptional."},{"id":"manas-2010:p0196:b002:l035","ordinal":8637,"en":"As though he would overwhelm everything,"},{"id":"manas-2010:p0196:b002:l036","ordinal":8638,"en":"His appearance looked exceptional."},{"id":"manas-2010:p0196:b002:l037","ordinal":8639,"en":"In broad Altay's cold upper valley,"},{"id":"manas-2010:p0196:b002:l038","ordinal":8640,"en":"The dear Kyrgyz people of forty households"},{"id":"manas-2010:p0196:b002:l039","ordinal":8641,"en":"Had settled farther uphill,"},{"id":"manas-2010:p0196:b002:l040","ordinal":8642,"en":"Driving their many herds upward,"},{"id":"manas-2010:p0196:b002:l041","ordinal":8643,"en":"Sheltering their wretched lives."},{"id":"manas-2010:p0196:b002:l042","ordinal":8644,"en":"Akbaltay and rich Jakyp"},{"id":"manas-2010:p0196:b002:l043","ordinal":8645,"en":"Held a council,"},{"id":"manas-2010:p0196:b002:l044","ordinal":8646,"en":"Gathered the forty households,"},{"id":"manas-2010:p0196:b002:l045","ordinal":8647,"en":"And took sound counsel:"},{"id":"manas-2010:p0196:b002:l046","ordinal":8648,"en":"“The deep pit dug for us has come;"},{"id":"manas-2010:p0196:b002:l047","ordinal":8649,"en":"From warrior Esenkan's city,"},{"id":"manas-2010:p0196:b002:l048","ordinal":8650,"en":"The sweeping great army has come."},{"id":"manas-2010:p0197:b002:l001","ordinal":8651,"en":"It will finish us all together;"},{"id":"manas-2010:p0197:b002:l002","ordinal":8652,"en":"It will slaughter us to the last."},{"id":"manas-2010:p0197:b002:l003","ordinal":8653,"en":"There is grass upon the slope;"},{"id":"manas-2010:p0197:b002:l004","ordinal":8654,"en":"The Chinese are as numerous as grass."},{"id":"manas-2010:p0197:b002:l005","ordinal":8655,"en":"They will plunder our goods,"},{"id":"manas-2010:p0197:b002:l006","ordinal":8656,"en":"Bring havoc upon our heads."},{"id":"manas-2010:p0197:b002:l007","ordinal":8657,"en":"If these infidels catch us,"},{"id":"manas-2010:p0197:b002:l008","ordinal":8658,"en":"They will have us dragged along the road,"},{"id":"manas-2010:p0197:b002:l009","ordinal":8659,"en":"Split us among the Dangyts,"},{"id":"manas-2010:p0197:b002:l010","ordinal":8660,"en":"Scatter our herds."},{"id":"manas-2010:p0197:b002:l011","ordinal":8661,"en":"Our graves, these infidels"},{"id":"manas-2010:p0197:b002:l012","ordinal":8662,"en":"Will dig while we are still alive!”"},{"id":"manas-2010:p0197:b004:l001","ordinal":8663,"en":"“Hero Manas, my gray-maned one,"},{"id":"manas-2010:p0197:b004:l002","ordinal":8664,"en":"Your distant forefather is Ogoy."},{"id":"manas-2010:p0197:b004:l003","ordinal":8665,"en":"How could Ogoy be an easy man?"},{"id":"manas-2010:p0197:b004:l004","ordinal":8666,"en":"He dwelt along the waters of Somduk."},{"id":"manas-2010:p0197:b004:l005","ordinal":8667,"en":"While your forefather Ogoy lived,"},{"id":"manas-2010:p0197:b004:l006","ordinal":8668,"en":"Those who fought him crawled."},{"id":"manas-2010:p0197:b004:l007","ordinal":8669,"en":"Your grandfather Ogoy was a warrior,"},{"id":"manas-2010:p0197:b004:l008","ordinal":8670,"en":"A lion who shattered the world."},{"id":"manas-2010:p0197:b004:l009","ordinal":8671,"en":"Your earliest forefather was Khan Tügöl,"},{"id":"manas-2010:p0197:b004:l010","ordinal":8672,"en":"Blessed by Kydyr from the root."},{"id":"manas-2010:p0197:b004:l011","ordinal":8673,"en":"From Khan Ogoy came Khan Bala."},{"id":"manas-2010:p0197:b004:l012","ordinal":8674,"en":"To Khan Bala himself"},{"id":"manas-2010:p0197:b004:l013","ordinal":8675,"en":"Many souls submitted."},{"id":"manas-2010:p0197:b004:l014","ordinal":8676,"en":"Boshogon of Karakan,"},{"id":"manas-2010:p0197:b004:l015","ordinal":8677,"en":"The Black Kalmyks upon him"},{"id":"manas-2010:p0197:b004:l016","ordinal":8678,"en":"Wrought havoc, upon that one."},{"id":"manas-2010:p0197:b004:l017","ordinal":8679,"en":"When that Khan Bala died,"},{"id":"manas-2010:p0197:b004:l018","ordinal":8680,"en":"When the people gathered and buried him,"},{"id":"manas-2010:p0197:b004:l019","ordinal":8681,"en":"From him was born Karakan."},{"id":"manas-2010:p0197:b004:l020","ordinal":8682,"en":"Your forefather Karakan became a warrior."},{"id":"manas-2010:p0197:b004:l021","ordinal":8683,"en":"While Karakan lived,"},{"id":"manas-2010:p0197:b004:l022","ordinal":8684,"en":"Many peoples submitted to him."},{"id":"manas-2010:p0197:b004:l023","ordinal":8685,"en":"Whoever spoke back,"},{"id":"manas-2010:p0197:b004:l024","ordinal":8686,"en":"Your forefather Karakan beat them."},{"id":"manas-2010:p0197:b004:l025","ordinal":8687,"en":"There was a khan such as Karakan;"},{"id":"manas-2010:p0197:b004:l026","ordinal":8688,"en":"Against Karakan himself,"},{"id":"manas-2010:p0197:b004:l027","ordinal":8689,"en":"Whoever rose was laid low."},{"id":"manas-2010:p0197:b004:l028","ordinal":8690,"en":"When that Karakan died,"},{"id":"manas-2010:p0197:b004:l029","ordinal":8691,"en":"We all went wandering."},{"id":"manas-2010:p0197:b004:l030","ordinal":8692,"en":"They bound hands and feet,"},{"id":"manas-2010:p0197:b004:l031","ordinal":8693,"en":"Humiliating everyone,"},{"id":"manas-2010:p0198:b002:l001","ordinal":8694,"en":"They drove us off in humiliation."},{"id":"manas-2010:p0198:b002:l002","ordinal":8695,"en":"Many of us died in slaughter."},{"id":"manas-2010:p0198:b002:l003","ordinal":8696,"en":"Beaten until our senses fled,"},{"id":"manas-2010:p0198:b002:l004","ordinal":8697,"en":"By the Black Kalmyks and Manchus,"},{"id":"manas-2010:p0198:b002:l005","ordinal":8698,"en":"We suffered humiliation and blows."},{"id":"manas-2010:p0198:b002:l006","ordinal":8699,"en":"When your grandfather, the great khan, died,"},{"id":"manas-2010:p0198:b002:l007","ordinal":8700,"en":"When the Black Kalmyk and Manchu peoples"},{"id":"manas-2010:p0198:b002:l008","ordinal":8701,"en":"Divided the many herds as booty,"},{"id":"manas-2010:p0198:b002:l009","ordinal":8702,"en":"The san of cattle we raised in Altay,"},{"id":"manas-2010:p0198:b002:l010","ordinal":8703,"en":"My little foal Manas, hear my words,"},{"id":"manas-2010:p0198:b002:l011","ordinal":8704,"en":"Let us give all of it as tribute."}]
