[{"id":"semetey-1-2013:p0711:b003:l021","ordinal":130817,"en":"The Kalmyks' Bozkertik,"},{"id":"semetey-1-2013:p0711:b003:l022","ordinal":130818,"en":"All the many giants were there,"},{"id":"semetey-1-2013:p0711:b003:l023","ordinal":130819,"en":"Ezkara, khan of the Manchus—"},{"id":"semetey-1-2013:p0711:b003:l024","ordinal":130820,"en":"When they all thrust their spears,"},{"id":"semetey-1-2013:p0711:b003:l025","ordinal":130821,"en":"The red steel Zulpukor,"},{"id":"semetey-1-2013:p0711:b003:l027","ordinal":130822,"en":"Against the giants of forty Chinese tribes,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0711:b003:l028","ordinal":130823,"en":"Jousting for forty-one days,"},{"id":"semetey-1-2013:p0711:b003:l029","ordinal":130824,"en":"Had she not stood firm?"},{"id":"semetey-1-2013:p0711:b003:l030","ordinal":130825,"en":"She was the lion among women."},{"id":"semetey-1-2013:p0711:b003:l031","ordinal":130826,"en":"If you ask about that accursed one,"},{"id":"semetey-1-2013:p0711:b003:l032","ordinal":130827,"en":"She was a hero who could shatter the world."},{"id":"semetey-1-2013:p0711:b003:l033","ordinal":130828,"en":"Pursuing Semetey,"},{"id":"semetey-1-2013:p0711:b003:l034","ordinal":130829,"en":"She drove him onward there."},{"id":"semetey-1-2013:p0711:b003:l035","ordinal":130830,"en":"His wits deserted him;"},{"id":"semetey-1-2013:p0711:b003:l036","ordinal":130831,"en":"Semetey, in a panic,"},{"id":"semetey-1-2013:p0711:b003:l037","ordinal":130832,"en":"Despairing of his entrusted life,"},{"id":"semetey-1-2013:p0711:b003:l038","ordinal":130833,"en":"Fled toward Bakai."},{"id":"semetey-1-2013:p0711:b003:l039","ordinal":130834,"en":"Darting off in haste,"},{"id":"semetey-1-2013:p0711:b004:l001","ordinal":130835,"en":"He spurred toward his uncle."},{"id":"semetey-1-2013:p0711:b004:l002","ordinal":130836,"en":"“If my resourceful uncle Bakai"},{"id":"semetey-1-2013:p0711:b004:l003","ordinal":130837,"en":"Does not rescue me,"},{"id":"semetey-1-2013:p0711:b004:l004","ordinal":130838,"en":"Here my resources are at an end.”"},{"id":"semetey-1-2013:p0711:b004:l005","ordinal":130839,"en":"Then the boy Semetey"},{"id":"semetey-1-2013:p0711:b004:l006","ordinal":130840,"en":"Grieved in distress."},{"id":"semetey-1-2013:p0711:b004:l007","ordinal":130841,"en":"The Aktulpar beneath him"},{"id":"semetey-1-2013:p0711:b004:l008","ordinal":130842,"en":"Bounded over uneven ground."},{"id":"semetey-1-2013:p0711:b004:l009","ordinal":130843,"en":"Semetey upon him"},{"id":"semetey-1-2013:p0711:b004:l010","ordinal":130844,"en":"Despaired of his fly-small soul."},{"id":"semetey-1-2013:p0711:b004:l011","ordinal":130845,"en":"Hurrying, flustered and panicked,"},{"id":"semetey-1-2013:p0711:b004:l012","ordinal":130846,"en":"The handle slipped from his wrist;"},{"id":"semetey-1-2013:p0711:b004:l013","ordinal":130847,"en":"His heart lost its covering."},{"id":"semetey-1-2013:p0711:b004:l014","ordinal":130848,"en":"The reason he was so alarmed:"},{"id":"semetey-1-2013:p0711:b004:l015","ordinal":130849,"en":"The hero he had met was a true hero,"},{"id":"semetey-1-2013:p0711:b004:l016","ordinal":130850,"en":"A lion without a flaw,"},{"id":"semetey-1-2013:p0711:b004:l017","ordinal":130851,"en":"Mighty, with surpassing fortune."},{"id":"semetey-1-2013:p0711:b004:l018","ordinal":130852,"en":"My hoof left behind by a winged steed,"},{"id":"semetey-1-2013:p0711:b004:l019","ordinal":130853,"en":"“There is none like this among mortals."},{"id":"semetey-1-2013:p0711:b004:l020","ordinal":130854,"en":"The spear thrust in earnest"},{"id":"semetey-1-2013:p0711:b004:l021","ordinal":130855,"en":"Is like tempered red iron."},{"id":"semetey-1-2013:p0711:b004:l022","ordinal":130856,"en":"Looking at that great size,"},{"id":"semetey-1-2013:p0711:b004:l023","ordinal":130857,"en":"It is like a crag on a jutting mountain!”"},{"id":"semetey-1-2013:p0711:b004:l024","ordinal":130858,"en":"Saying this, Semetey,"},{"id":"semetey-1-2013:p0711:b004:l025","ordinal":130859,"en":"His strength gone, distressed,"},{"id":"semetey-1-2013:p0711:b004:l026","ordinal":130860,"en":"Turned in despair toward Bakai."},{"id":"semetey-1-2013:p0711:b004:l027","ordinal":130861,"en":"It was his hour of panic;"},{"id":"semetey-1-2013:p0711:b004:l028","ordinal":130862,"en":"Manas's heroic orphan son,"},{"id":"semetey-1-2013:p0711:b004:l029","ordinal":130863,"en":"Heading toward Bakai,"},{"id":"semetey-1-2013:p0711:b004:l030","ordinal":130864,"en":"Had taken to flight."},{"id":"semetey-1-2013:p0711:b004:l031","ordinal":130865,"en":"Aktulpar came bounding;"},{"id":"semetey-1-2013:p0711:b004:l032","ordinal":130866,"en":"Semetey despaired of his entrusted life."},{"id":"semetey-1-2013:p0711:b004:l033","ordinal":130867,"en":"Through the tamarisk thickets,"},{"id":"semetey-1-2013:p0711:b004:l034","ordinal":130868,"en":"Semetey fled, seeking shelter with Khan Bakai."},{"id":"semetey-1-2013:p0711:b004:l036","ordinal":130869,"en":"Hurrying, flustered and panicked,"},{"id":"semetey-1-2013:p0711:b004:l037","ordinal":130870,"en":"That orphan of Manas"},{"id":"semetey-1-2013:p0711:b004:l038","ordinal":130871,"en":"Was terribly alarmed."},{"id":"semetey-1-2013:p0711:b004:l039","ordinal":130872,"en":"Around your oceanlike uncle Bakai,"},{"id":"semetey-1-2013:p0712:b003:l001","ordinal":130873,"en":"He fled in circles."},{"id":"semetey-1-2013:p0712:b003:l002","ordinal":130874,"en":"Your lionlike uncle, heroic Bakai,"},{"id":"semetey-1-2013:p0712:b003:l003","ordinal":130875,"en":"Stood astonished there."},{"id":"semetey-1-2013:p0712:b003:l004","ordinal":130876,"en":"Seeing the figure, troubled,"},{"id":"semetey-1-2013:p0712:b003:l005","ordinal":130877,"en":"Khan Bakai spoke out,"},{"id":"semetey-1-2013:p0712:b003:l006","ordinal":130878,"en":"Pleading with Semetey:"},{"id":"semetey-1-2013:p0712:b003:l007","ordinal":130879,"en":"“O my precious ornament left by Manas,"},{"id":"semetey-1-2013:p0712:b003:l008","ordinal":130880,"en":"My mirror left by the hero,"},{"id":"semetey-1-2013:p0712:b003:l009","ordinal":130881,"en":"My hoof left by the winged steed,"},{"id":"semetey-1-2013:p0712:b003:l010","ordinal":130882,"en":"My light left by the hawk,"},{"id":"semetey-1-2013:p0712:b003:l011","ordinal":130883,"en":"You are flustered and alarmed;"},{"id":"semetey-1-2013:p0712:b003:l012","ordinal":130884,"en":"Son, you have fled in great fear."},{"id":"semetey-1-2013:p0712:b003:l013","ordinal":130885,"en":"Is there a deep trench dug?"},{"id":"semetey-1-2013:p0712:b003:l014","ordinal":130886,"en":"Is there an iron net to catch you?"},{"id":"semetey-1-2013:p0712:b003:l015","ordinal":130887,"en":"Is there boiling brine?"},{"id":"semetey-1-2013:p0712:b003:l016","ordinal":130888,"en":"You flee so badly, cringing."},{"id":"semetey-1-2013:p0712:b003:l017","ordinal":130889,"en":"From Kakan's Beijing,"},{"id":"semetey-1-2013:p0712:b003:l018","ordinal":130890,"en":"Son, has a countless army swept down?"},{"id":"semetey-1-2013:p0712:b003:l019","ordinal":130891,"en":"If a countless army has swept down,"},{"id":"semetey-1-2013:p0712:b003:l020","ordinal":130892,"en":"My shelter, my orphan, tell the truth."},{"id":"semetey-1-2013:p0712:b003:l021","ordinal":130893,"en":"Let me mount Kokcholok,"},{"id":"semetey-1-2013:p0712:b003:l022","ordinal":130894,"en":"Against the surging multitude of Kalmyks,"},{"id":"semetey-1-2013:p0712:b003:l025","ordinal":130895,"en":"The Prophet exists in truth, my faith is true.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0712:b003:l026","ordinal":130896,"en":"This year, in my white-bearded age,"},{"id":"semetey-1-2013:p0712:b003:l027","ordinal":130897,"en":"When my final journey is near,"},{"id":"semetey-1-2013:p0712:b003:l028","ordinal":130898,"en":"Let me enter battle with you."},{"id":"semetey-1-2013:p0712:b003:l029","ordinal":130899,"en":"The countless Chinese and many Shibee,"},{"id":"semetey-1-2013:p0712:b003:l030","ordinal":130900,"en":"Let me drive them clear to Beijing."},{"id":"semetey-1-2013:p0712:b003:l031","ordinal":130901,"en":"At my life's end, I, Bakai,"},{"id":"semetey-1-2013:p0712:b003:l032","ordinal":130902,"en":"Let me drive them into Kakan."},{"id":"semetey-1-2013:p0712:b003:l034","ordinal":130903,"en":"Let me drive them to its farthest edge.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0712:b003:l035","ordinal":130904,"en":"Is there a claim where no wrong was done?"},{"id":"semetey-1-2013:p0712:b003:l036","ordinal":130905,"en":"Is there an enemy you have met?”"},{"id":"semetey-1-2013:p0712:b003:l037","ordinal":130906,"en":"Before Bakai finished speaking,"},{"id":"semetey-1-2013:p0712:b003:l038","ordinal":130907,"en":"Before orphan Semetey could answer,"},{"id":"semetey-1-2013:p0712:b003:l039","ordinal":130908,"en":"In the blink of an eye,"},{"id":"semetey-1-2013:p0712:b004:l001","ordinal":130909,"en":"Before this or that could be said,"},{"id":"semetey-1-2013:p0712:b004:l002","ordinal":130910,"en":"Riding a dark chestnut horse,"},{"id":"semetey-1-2013:p0712:b004:l003","ordinal":130911,"en":"Its long tail tightly knotted,"},{"id":"semetey-1-2013:p0712:b004:l004","ordinal":130912,"en":"Massive as half a mountain,"},{"id":"semetey-1-2013:p0712:b004:l005","ordinal":130913,"en":"In strength and wrath,"},{"id":"semetey-1-2013:p0712:b004:l006","ordinal":130914,"en":"In the venom of the leveled spear,"},{"id":"semetey-1-2013:p0712:b004:l007","ordinal":130915,"en":"No mortal could come against her;"},{"id":"semetey-1-2013:p0712:b004:l008","ordinal":130916,"en":"No mortal could look upon her face."},{"id":"semetey-1-2013:p0712:b004:l009","ordinal":130917,"en":"The sight troubled the heart."},{"id":"semetey-1-2013:p0712:b004:l010","ordinal":130918,"en":"Her strength and bearing"},{"id":"semetey-1-2013:p0712:b004:l011","ordinal":130919,"en":"Appeared unlike any mortal's."},{"id":"semetey-1-2013:p0712:b004:l012","ordinal":130920,"en":"Her mount, the winged steed Telkurong,"},{"id":"semetey-1-2013:p0712:b004:l013","ordinal":130921,"en":"She turned without drawing back."},{"id":"semetey-1-2013:p0712:b004:l014","ordinal":130922,"en":"A painted spear twelve fathoms long"},{"id":"semetey-1-2013:p0712:b004:l015","ordinal":130923,"en":"She leveled with a roar."},{"id":"semetey-1-2013:p0712:b004:l016","ordinal":130924,"en":"Blood suffused her dark eyes;"},{"id":"semetey-1-2013:p0712:b004:l017","ordinal":130925,"en":"Her bloody face grew grim."},{"id":"semetey-1-2013:p0712:b004:l018","ordinal":130926,"en":"Her eyes blazed fiercely like fire;"},{"id":"semetey-1-2013:p0712:b004:l019","ordinal":130927,"en":"Her thirst for blood seized her in earnest."},{"id":"semetey-1-2013:p0712:b004:l020","ordinal":130928,"en":"Looking at her bared front teeth,"},{"id":"semetey-1-2013:p0712:b004:l021","ordinal":130929,"en":"They rattled like millet grains."},{"id":"semetey-1-2013:p0712:b004:l022","ordinal":130930,"en":"The blue flame in her mouth"},{"id":"semetey-1-2013:p0712:b004:l023","ordinal":130931,"en":"Burned and hissed like fire."},{"id":"semetey-1-2013:p0712:b004:l024","ordinal":130932,"en":"Raging and seething,"},{"id":"semetey-1-2013:p0712:b004:l025","ordinal":130933,"en":"She had cast off a woman's appearance,"},{"id":"semetey-1-2013:p0712:b004:l026","ordinal":130934,"en":"And dressed in men's clothing."},{"id":"semetey-1-2013:p0712:b004:l027","ordinal":130935,"en":"Her splendid hair, like sedge,"},{"id":"semetey-1-2013:p0712:b004:l028","ordinal":130936,"en":"She bound tightly upon her crown."},{"id":"semetey-1-2013:p0712:b004:l029","ordinal":130937,"en":"A helmet of blue iron"},{"id":"semetey-1-2013:p0712:b004:l030","ordinal":130938,"en":"She set over her head."},{"id":"semetey-1-2013:p0712:b004:l031","ordinal":130939,"en":"Heroic Bakai stood astonished,"},{"id":"semetey-1-2013:p0712:b004:l032","ordinal":130940,"en":"And looked carefully."},{"id":"semetey-1-2013:p0712:b004:l033","ordinal":130941,"en":"The sight troubled his heart."},{"id":"semetey-1-2013:p0712:b004:l034","ordinal":130942,"en":"Poor sovereign Bakai's"},{"id":"semetey-1-2013:p0712:b004:l035","ordinal":130943,"en":"Tears streamed from his eyes."},{"id":"semetey-1-2013:p0712:b004:l036","ordinal":130944,"en":"His thoughts went in many directions;"},{"id":"semetey-1-2013:p0712:b004:l037","ordinal":130945,"en":"He sank into dejection."},{"id":"semetey-1-2013:p0712:b004:l038","ordinal":130946,"en":"Her form and figure,"},{"id":"semetey-1-2013:p0712:b004:l039","ordinal":130947,"en":"Her bearing on horseback,"},{"id":"semetey-1-2013:p0713:b003:l001","ordinal":130948,"en":"Like wolf-maned Manas the Leopard,"},{"id":"semetey-1-2013:p0713:b003:l002","ordinal":130949,"en":"She appeared his very likeness."},{"id":"semetey-1-2013:p0713:b003:l003","ordinal":130950,"en":"All the hills and valleys,"},{"id":"semetey-1-2013:p0713:b003:l004","ordinal":130951,"en":"Oh, wonder, seemed to be running."},{"id":"semetey-1-2013:p0713:b003:l005","ordinal":130952,"en":"To his eyes, departed Manas"},{"id":"semetey-1-2013:p0713:b003:l006","ordinal":130953,"en":"Seemed to have come alive."},{"id":"semetey-1-2013:p0713:b003:l007","ordinal":130954,"en":"His heart stirred and throbbed;"},{"id":"semetey-1-2013:p0713:b003:l008","ordinal":130955,"en":"Seeing this figure,"},{"id":"semetey-1-2013:p0713:b003:l009","ordinal":130956,"en":"Alas, Bakai sobbed."},{"id":"semetey-1-2013:p0713:b003:l011","ordinal":130957,"en":"He wiped both eyes.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0713:b003:l012","ordinal":130958,"en":"Unable to catch his breath, he sobbed,"},{"id":"semetey-1-2013:p0713:b003:l013","ordinal":130959,"en":"Heroic Bakai the Leopard,"},{"id":"semetey-1-2013:p0713:b003:l014","ordinal":130960,"en":"Your saint who had seen everything."},{"id":"semetey-1-2013:p0713:b003:l015","ordinal":130961,"en":"This person approaching,"},{"id":"semetey-1-2013:p0713:b003:l016","ordinal":130962,"en":"A haze parts from the sky,"},{"id":"semetey-1-2013:p0713:b003:l017","ordinal":130963,"en":"Was of the same nest as Manas,"},{"id":"semetey-1-2013:p0713:b003:l018","ordinal":130964,"en":"Not merely of one nest, but born one after another."},{"id":"semetey-1-2013:p0713:b003:l019","ordinal":130965,"en":"From Zhakyp, who was like Kambar,"},{"id":"semetey-1-2013:p0713:b003:l020","ordinal":130966,"en":"They had sprung from his very loins."},{"id":"semetey-1-2013:p0713:b003:l021","ordinal":130967,"en":"Your noble mother Chyiyrdy's"},{"id":"semetey-1-2013:p0713:b003:l022","ordinal":130968,"en":"Womb they had kicked their way out of."},{"id":"semetey-1-2013:p0713:b003:l023","ordinal":130969,"en":"Your incomparable mother Chyiyrdy"},{"id":"semetey-1-2013:p0713:b003:l024","ordinal":130970,"en":"Had borne one lion of a son,"},{"id":"semetey-1-2013:p0713:b003:l025","ordinal":130971,"en":"And one lion of a daughter."},{"id":"semetey-1-2013:p0713:b003:l026","ordinal":130972,"en":"The son she bore, heroic Manas,"},{"id":"semetey-1-2013:p0713:b003:l027","ordinal":130973,"en":"Became khan of a people dwelling together."},{"id":"semetey-1-2013:p0713:b003:l028","ordinal":130974,"en":"The daughter she bore, Kardygach,"},{"id":"semetey-1-2013:p0713:b003:l029","ordinal":130975,"en":"In her maiden days, the luckless one,"},{"id":"semetey-1-2013:p0713:b003:l030","ordinal":130976,"en":"Shook the ages and shattered peoples."},{"id":"semetey-1-2013:p0713:b003:l031","ordinal":130977,"en":"When she reached seventeen,"},{"id":"semetey-1-2013:p0713:b003:l032","ordinal":130978,"en":"She leveled her spear and broke the ranks."},{"id":"semetey-1-2013:p0713:b003:l033","ordinal":130979,"en":"The Kara Kalmyks she encountered,"},{"id":"semetey-1-2013:p0713:b003:l034","ordinal":130980,"en":"She shed their blood and laid them low."},{"id":"semetey-1-2013:p0713:b003:l035","ordinal":130981,"en":"On the downward slope she speared heroes,"},{"id":"semetey-1-2013:p0713:b003:l036","ordinal":130982,"en":"With heroic Zholoi at their head;"},{"id":"semetey-1-2013:p0713:b003:l037","ordinal":130983,"en":"Of the Kara Kalmyks and Manchus,"},{"id":"semetey-1-2013:p0713:b003:l038","ordinal":130984,"en":"She reached and speared seven at one stroke."},{"id":"semetey-1-2013:p0713:b003:l039","ordinal":130985,"en":"Before this girl's wrath,"},{"id":"semetey-1-2013:p0713:b005:l001","ordinal":130986,"en":"The people could not stand."},{"id":"semetey-1-2013:p0713:b005:l002","ordinal":130987,"en":"With Khan Kongurbai at their head,"},{"id":"semetey-1-2013:p0713:b005:l003","ordinal":130988,"en":"Of Chynmachyn and Beijing,"},{"id":"semetey-1-2013:p0713:b005:l004","ordinal":130989,"en":"The true khans wept."},{"id":"semetey-1-2013:p0713:b005:l005","ordinal":130990,"en":"Wrath poured from her brow;"},{"id":"semetey-1-2013:p0713:b005:l006","ordinal":130991,"en":"Those who faced her were split in two."},{"id":"semetey-1-2013:p0713:b005:l007","ordinal":130992,"en":"For Beijing's Chynchy Khan,"},{"id":"semetey-1-2013:p0713:b005:l008","ordinal":130993,"en":"And for the city of Kakan,"},{"id":"semetey-1-2013:p0713:b005:l009","ordinal":130994,"en":"She was inscribed in their records."},{"id":"semetey-1-2013:p0713:b005:l010","ordinal":130995,"en":"The Ile River, a great stream,"},{"id":"semetey-1-2013:p0713:b005:l011","ordinal":130996,"en":"They lay on either bank."},{"id":"semetey-1-2013:p0713:b005:l012","ordinal":130997,"en":"Six thousand Chinese and countless kaldai,"},{"id":"semetey-1-2013:p0713:b005:l013","ordinal":130998,"en":"Their elder Kongurbai,"},{"id":"semetey-1-2013:p0713:b005:l014","ordinal":130999,"en":"Heroic Toltoi riding Achbuudan,"},{"id":"semetey-1-2013:p0713:b005:l015","ordinal":131000,"en":"Ezkara with his great chestnut,"},{"id":"semetey-1-2013:p0713:b005:l016","ordinal":131001,"en":"Boroonchu riding Bozbuudan,"},{"id":"semetey-1-2013:p0713:b005:l017","ordinal":131002,"en":"The great giant on a gray mule,"},{"id":"semetey-1-2013:p0713:b005:l018","ordinal":131003,"en":"Ylama and their elder Shyikoo—"},{"id":"semetey-1-2013:p0713:b005:l019","ordinal":131004,"en":"Of the unbelievers of another faith,"},{"id":"semetey-1-2013:p0713:b005:l020","ordinal":131005,"en":"All their giants were there."},{"id":"semetey-1-2013:p0713:b005:l021","ordinal":131006,"en":"Skilled in drawing the bow,"},{"id":"semetey-1-2013:p0713:b005:l022","ordinal":131007,"en":"Karaboz riding a mule,"},{"id":"semetey-1-2013:p0713:b005:l023","ordinal":131008,"en":"He too the finest of the Shibee people,"},{"id":"semetey-1-2013:p0713:b005:l024","ordinal":131009,"en":"Bozkertik of the Solon,"},{"id":"semetey-1-2013:p0713:b005:l025","ordinal":131010,"en":"Shypshaidar of Sooronduk,"},{"id":"semetey-1-2013:p0713:b005:l026","ordinal":131011,"en":"All the Chinese massed together."},{"id":"semetey-1-2013:p0713:b005:l027","ordinal":131012,"en":"Of the Chinese spearmen,"},{"id":"semetey-1-2013:p0713:b005:l028","ordinal":131013,"en":"The finest massed together."},{"id":"semetey-1-2013:p0713:b005:l029","ordinal":131014,"en":"Standing on either bank,"},{"id":"semetey-1-2013:p0713:b005:l030","ordinal":131015,"en":"Unable to reach with their spears,"},{"id":"semetey-1-2013:p0713:b005:l031","ordinal":131016,"en":"They fought with muskets."},{"id":"semetey-1-2013:p0713:b005:l032","ordinal":131017,"en":"Blocking one another,"},{"id":"semetey-1-2013:p0713:b005:l033","ordinal":131018,"en":"They fired for nine days without cease."},{"id":"semetey-1-2013:p0713:b005:l034","ordinal":131019,"en":"While the warriors could not"},{"id":"semetey-1-2013:p0713:b005:l035","ordinal":131020,"en":"Gain upon one another,"},{"id":"semetey-1-2013:p0713:b005:l036","ordinal":131021,"en":"When Khan Zholoi's Achbuudan"},{"id":"semetey-1-2013:p0713:b005:l037","ordinal":131022,"en":"Leaped to the farther bank,"},{"id":"semetey-1-2013:p0713:b005:l038","ordinal":131023,"en":"The Chinese army shuddered:"},{"id":"semetey-1-2013:p0713:b005:l039","ordinal":131024,"en":"“This bitch is formidable,” they said."},{"id":"semetey-1-2013:p0714:b003:l001","ordinal":131025,"en":"The Kalmyk khan cried out,"},{"id":"semetey-1-2013:p0714:b003:l002","ordinal":131026,"en":"“She will not spare our lives, whatever happens;"},{"id":"semetey-1-2013:p0714:b003:l003","ordinal":131027,"en":"Alas, the girl will not spare our lives!”"},{"id":"semetey-1-2013:p0714:b003:l004","ordinal":131028,"en":"Girding a leather belt about her waist,"},{"id":"semetey-1-2013:p0714:b003:l005","ordinal":131029,"en":"Into the myriad Chinese,"},{"id":"semetey-1-2013:p0714:b003:l006","ordinal":131030,"en":"The fully accomplished, hapless Kardygach"},{"id":"semetey-1-2013:p0714:b003:l007","ordinal":131031,"en":"Rode upon Telkyzyl."},{"id":"semetey-1-2013:p0714:b003:l008","ordinal":131032,"en":"The Kara Kalmyks and Manchu people"},{"id":"semetey-1-2013:p0714:b003:l009","ordinal":131033,"en":"Could not withstand her wrath."},{"id":"semetey-1-2013:p0714:b003:l010","ordinal":131034,"en":"When Kardygach leveled her spear,"},{"id":"semetey-1-2013:p0714:b003:l011","ordinal":131035,"en":"Of the Chinese officials with hat buttons,"},{"id":"semetey-1-2013:p0714:b003:l012","ordinal":131036,"en":"The best of them fell."},{"id":"semetey-1-2013:p0714:b003:l013","ordinal":131037,"en":"Toppling the kaldai's banner,"},{"id":"semetey-1-2013:p0714:b003:l014","ordinal":131038,"en":"Spearing their khan and laying him low,"},{"id":"semetey-1-2013:p0714:b003:l015","ordinal":131039,"en":"Remaining steadfast,"},{"id":"semetey-1-2013:p0714:b003:l016","ordinal":131040,"en":"Fighting with guns for sixty days,"},{"id":"semetey-1-2013:p0714:b003:l017","ordinal":131041,"en":"She tormented the Chinese."},{"id":"semetey-1-2013:p0714:b003:l018","ordinal":131042,"en":"Then Chongtaman and the giant Dongkoi died."},{"id":"semetey-1-2013:p0714:b003:l019","ordinal":131043,"en":"Within that great battle,"},{"id":"semetey-1-2013:p0714:b003:l020","ordinal":131044,"en":"Pressing onward with courage,"},{"id":"semetey-1-2013:p0714:b003:l021","ordinal":131045,"en":"Kardygach's painted spear"},{"id":"semetey-1-2013:p0714:b003:l022","ordinal":131046,"en":"Was bathed in pitch-black blood."},{"id":"semetey-1-2013:p0714:b003:l023","ordinal":131047,"en":"When the Chinese wrought slaughter,"},{"id":"semetey-1-2013:p0714:b003:l024","ordinal":131048,"en":"“Of Manas, khan of the Kyrgyz,"},{"id":"semetey-1-2013:p0714:b003:l025","ordinal":131049,"en":"I shall seize the girls,” he said."},{"id":"semetey-1-2013:p0714:b003:l026","ordinal":131050,"en":"“I shall trample them from above,” he said."},{"id":"semetey-1-2013:p0714:b003:l027","ordinal":131051,"en":"“I shall scatter their four kinds of livestock,” he said."},{"id":"semetey-1-2013:p0714:b003:l028","ordinal":131052,"en":"“Of the babbling Burut,"},{"id":"semetey-1-2013:p0714:b003:l029","ordinal":131053,"en":"Raiding and taking their mares,"},{"id":"semetey-1-2013:p0714:b003:l030","ordinal":131054,"en":"If the Burut come near,"},{"id":"semetey-1-2013:p0714:b003:l031","ordinal":131055,"en":"I shall smash their brains asunder,” he said."},{"id":"semetey-1-2013:p0714:b003:l032","ordinal":131056,"en":"Khan Kongurbai and mighty Zholoi"},{"id":"semetey-1-2013:p0714:b003:l033","ordinal":131057,"en":"Had stirred and made ready."},{"id":"semetey-1-2013:p0714:b003:l034","ordinal":131058,"en":"The Kara Kalmyks and Torguts'"},{"id":"semetey-1-2013:p0714:b003:l035","ordinal":131059,"en":"Kindled fires they extinguished,"},{"id":"semetey-1-2013:p0714:b003:l036","ordinal":131060,"en":"And made them all move out together."},{"id":"semetey-1-2013:p0714:b003:l037","ordinal":131061,"en":"They gelded their stallions into riding horses,"},{"id":"semetey-1-2013:p0714:b003:l038","ordinal":131062,"en":"Placed their idols upon their heads,"},{"id":"semetey-1-2013:p0714:b003:l039","ordinal":131063,"en":"And made their pledge swiftly."},{"id":"semetey-1-2013:p0714:b004:l001","ordinal":131064,"en":"To raid the Burut,"},{"id":"semetey-1-2013:p0714:b004:l002","ordinal":131065,"en":"To wreak some terrible deed,"},{"id":"semetey-1-2013:p0714:b004:l003","ordinal":131066,"en":"They gelded their male camels,"},{"id":"semetey-1-2013:p0714:b004:l004","ordinal":131067,"en":"And made much of the army go on foot."},{"id":"semetey-1-2013:p0714:b004:l005","ordinal":131068,"en":"So their army would not flee to Beijing,"},{"id":"semetey-1-2013:p0714:b004:l006","ordinal":131069,"en":"Would not scatter and disperse,"},{"id":"semetey-1-2013:p0714:b004:l007","ordinal":131070,"en":"Red-whipped Shypshaidar,"},{"id":"semetey-1-2013:p0714:b004:l008","ordinal":131071,"en":"They put Shypshaidar in charge."},{"id":"semetey-1-2013:p0714:b004:l009","ordinal":131072,"en":"Driving their great army onward,"}]
