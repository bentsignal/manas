[{"id":"semetey-1-2013:p0396:b004:l025","ordinal":107265,"en":"He showed a bitter spectacle."},{"id":"semetey-1-2013:p0396:b004:l026","ordinal":107266,"en":"Giving six swift horses,"},{"id":"semetey-1-2013:p0396:b004:l027","ordinal":107267,"en":"'Let him pursue blood vengeance for his father Alooke,' he thought."},{"id":"semetey-1-2013:p0396:b004:l028","ordinal":107268,"en":"To Konurbai in Beezhin,"},{"id":"semetey-1-2013:p0396:b004:l029","ordinal":107269,"en":"To Kalcha, he sent a firm letter:"},{"id":"semetey-1-2013:p0396:b004:l030","ordinal":107270,"en":"'Manas has lost his wits this year;"},{"id":"semetey-1-2013:p0396:b004:l031","ordinal":107271,"en":"Kyrgylchal has become his intimate."},{"id":"semetey-1-2013:p0396:b004:l032","ordinal":107272,"en":"She too has gone elsewhere,"},{"id":"semetey-1-2013:p0396:b004:l033","ordinal":107273,"en":"She who found the way through difficulties,"},{"id":"semetey-1-2013:p0396:b004:l034","ordinal":107274,"en":"Manas's wife, Lady Kanykei."},{"id":"semetey-1-2013:p0396:b004:l035","ordinal":107275,"en":"If he is truly a warrior,"},{"id":"semetey-1-2013:p0396:b004:l036","ordinal":107276,"en":"Let him plunder his valuables,' he said."},{"id":"semetey-1-2013:p0396:b004:l037","ordinal":107277,"en":"'Upon Zhakyp's only son Manas,"},{"id":"semetey-1-2013:p0396:b004:l038","ordinal":107278,"en":"Let him bring great ruin,' he said."},{"id":"semetey-1-2013:p0396:b004:l039","ordinal":107279,"en":"'Let him press down upon his head,' he said."},{"id":"semetey-1-2013:p0397:b003:l001","ordinal":107280,"en":"'Konurbai, khan of Beezhin,"},{"id":"semetey-1-2013:p0397:b003:l002","ordinal":107281,"en":"If he is truly a lord,"},{"id":"semetey-1-2013:p0397:b003:l003","ordinal":107282,"en":"Let him scatter his four kinds of livestock;"},{"id":"semetey-1-2013:p0397:b003:l004","ordinal":107283,"en":"Let him plunder his valuables."},{"id":"semetey-1-2013:p0397:b003:l005","ordinal":107284,"en":"Upon these Kyrgyz here,"},{"id":"semetey-1-2013:p0397:b003:l006","ordinal":107285,"en":"Let him bring great ruin,' he said."},{"id":"semetey-1-2013:p0397:b003:l007","ordinal":107286,"en":"A brass spyglass with a screw fitting,"},{"id":"semetey-1-2013:p0397:b003:l008","ordinal":107287,"en":"He grasped by its end and turned."},{"id":"semetey-1-2013:p0397:b003:l009","ordinal":107288,"en":"He clothed him in a costly coat,"},{"id":"semetey-1-2013:p0397:b003:l010","ordinal":107289,"en":"He mounted him upon Kylzheerde;"},{"id":"semetey-1-2013:p0397:b003:l011","ordinal":107290,"en":"Whirlwind-bottomed Enteri:"},{"id":"semetey-1-2013:p0397:b003:l012","ordinal":107291,"en":"He sent Enteri away."},{"id":"semetey-1-2013:p0397:b003:l013","ordinal":107292,"en":"He gathered the Argyn and made them his people,"},{"id":"semetey-1-2013:p0397:b003:l014","ordinal":107293,"en":"Against King Manas the sultan,"},{"id":"semetey-1-2013:p0397:b003:l015","ordinal":107294,"en":"That Chubak was deeply offended;"},{"id":"semetey-1-2013:p0397:b003:l016","ordinal":107295,"en":"He thought to fight him if he could."},{"id":"semetey-1-2013:p0397:b003:l017","ordinal":107296,"en":"The document tied into his belt—"},{"id":"semetey-1-2013:p0397:b003:l018","ordinal":107297,"en":"That Chubak feared it,"},{"id":"semetey-1-2013:p0397:b003:l019","ordinal":107298,"en":"Manas's oath invoking God."},{"id":"semetey-1-2013:p0397:b003:l020","ordinal":107299,"en":"Beloved Prince Chubak,"},{"id":"semetey-1-2013:p0397:b003:l021","ordinal":107300,"en":"The great fierce hero, standing proud,"},{"id":"semetey-1-2013:p0397:b003:l022","ordinal":107301,"en":"Raging like a lion,"},{"id":"semetey-1-2013:p0397:b003:l023","ordinal":107302,"en":"Passed through Andijan;"},{"id":"semetey-1-2013:p0397:b003:l024","ordinal":107303,"en":"Chubak fled toward his father."},{"id":"semetey-1-2013:p0397:b003:l025","ordinal":107304,"en":"He crossed Maseyil"},{"id":"semetey-1-2013:p0397:b003:l026","ordinal":107305,"en":"And passed through broad Kashgar."},{"id":"semetey-1-2013:p0397:b003:l027","ordinal":107306,"en":"Skirting the lower mountains,"},{"id":"semetey-1-2013:p0397:b003:l028","ordinal":107307,"en":"The Sarts who rode upon pack saddles,"},{"id":"semetey-1-2013:p0397:b003:l029","ordinal":107308,"en":"He harassed those he encountered."},{"id":"semetey-1-2013:p0397:b003:l030","ordinal":107309,"en":"Finding no mountain to hurl himself against,"},{"id":"semetey-1-2013:p0397:b003:l031","ordinal":107310,"en":"Chubak found no foe to fight;"},{"id":"semetey-1-2013:p0397:b003:l032","ordinal":107311,"en":"No embers to wade through,"},{"id":"semetey-1-2013:p0397:b003:l033","ordinal":107312,"en":"No shot to exchange in battle."},{"id":"semetey-1-2013:p0397:b003:l034","ordinal":107313,"en":"Without looking about him,"},{"id":"semetey-1-2013:p0397:b003:l035","ordinal":107314,"en":"Chubak, son of Khan Baltai,"},{"id":"semetey-1-2013:p0397:b003:l036","ordinal":107315,"en":"Sparing not his threadlike life,"},{"id":"semetey-1-2013:p0397:b003:l037","ordinal":107316,"en":"A beloved house built off to the side:"},{"id":"semetey-1-2013:p0397:b003:l038","ordinal":107317,"en":"His precious soul was crushed with misery."},{"id":"semetey-1-2013:p0397:b003:l039","ordinal":107318,"en":"Driven about by resentment,"},{"id":"semetey-1-2013:p0397:b004:l001","ordinal":107319,"en":"Offended at your father the khan in Talas,"},{"id":"semetey-1-2013:p0397:b004:l002","ordinal":107320,"en":"When he reached his goal,"},{"id":"semetey-1-2013:p0397:b004:l003","ordinal":107321,"en":"When Kyrgylchal had stirred up trouble and offended him,"},{"id":"semetey-1-2013:p0397:b004:l004","ordinal":107322,"en":"And Chubak had gone back among his people,"},{"id":"semetey-1-2013:p0397:b004:l005","ordinal":107323,"en":"'He besieged Kashgar,' they said."},{"id":"semetey-1-2013:p0397:b004:l006","ordinal":107324,"en":"Throughout the Six Cities,"},{"id":"semetey-1-2013:p0397:b004:l007","ordinal":107325,"en":"We heard word from someone:"},{"id":"semetey-1-2013:p0397:b004:l008","ordinal":107326,"en":"'Chubak has become sultan,' they said."},{"id":"semetey-1-2013:p0397:b004:l009","ordinal":107327,"en":"I settled along a little stream;"},{"id":"semetey-1-2013:p0397:b004:l010","ordinal":107328,"en":"Because of Kyrgylchal,"},{"id":"semetey-1-2013:p0397:b004:l011","ordinal":107329,"en":"Because of that troublemaker,"},{"id":"semetey-1-2013:p0397:b004:l012","ordinal":107330,"en":"Your father would not lie with me;"},{"id":"semetey-1-2013:p0397:b004:l013","ordinal":107331,"en":"I was a neglected wife for two years."},{"id":"semetey-1-2013:p0397:b004:l014","ordinal":107332,"en":"I gathered lions from among females;"},{"id":"semetey-1-2013:p0397:b004:l015","ordinal":107333,"en":"I gathered champion warriors from among women."},{"id":"semetey-1-2013:p0397:b004:l016","ordinal":107334,"en":"Gathering sixty households as hostages,"},{"id":"semetey-1-2013:p0397:b004:l017","ordinal":107335,"en":"Beside your fierce father, the lion,"},{"id":"semetey-1-2013:p0397:b004:l018","ordinal":107336,"en":"I settled in Talas."},{"id":"semetey-1-2013:p0397:b004:l019","ordinal":107337,"en":"Without making it a matter of shame or wounded pride,"},{"id":"semetey-1-2013:p0397:b004:l020","ordinal":107338,"en":"We pursued his claims together;"},{"id":"semetey-1-2013:p0397:b004:l021","ordinal":107339,"en":"We fought his enemies together."},{"id":"semetey-1-2013:p0397:b004:l022","ordinal":107340,"en":"Our beloved hair, thick as girth straps,"},{"id":"semetey-1-2013:p0397:b004:l023","ordinal":107341,"en":"We bound firmly upon our heads"},{"id":"semetey-1-2013:p0397:b004:l024","ordinal":107342,"en":"And went into battle together."},{"id":"semetey-1-2013:p0397:b004:l025","ordinal":107343,"en":"When your father neglected me,"},{"id":"semetey-1-2013:p0397:b004:l026","ordinal":107344,"en":"When he cast me aside,"},{"id":"semetey-1-2013:p0397:b004:l027","ordinal":107345,"en":"I made my towering head a banner;"},{"id":"semetey-1-2013:p0397:b004:l028","ordinal":107346,"en":"I made a warrior of my woman's self."},{"id":"semetey-1-2013:p0397:b004:l029","ordinal":107347,"en":"Why should I tell the rest?"},{"id":"semetey-1-2013:p0397:b004:l030","ordinal":107348,"en":"My foal, thus I became his equal."},{"id":"semetey-1-2013:p0397:b004:l032","ordinal":107349,"en":"When playing ordo,"},{"id":"semetey-1-2013:p0397:b004:l033","ordinal":107350,"en":"When your father destroyed Ombu,"},{"id":"semetey-1-2013:p0397:b004:l034","ordinal":107351,"en":"The ten sons of Orozoi the Sart,"},{"id":"semetey-1-2013:p0397:b004:l035","ordinal":107352,"en":"Your heedless father,"},{"id":"semetey-1-2013:p0397:b004:l036","ordinal":107353,"en":"When they buried him beneath a falling cliff,"},{"id":"semetey-1-2013:p0397:b004:l037","ordinal":107354,"en":"When your mother bore the suffering,"},{"id":"semetey-1-2013:p0397:b004:l038","ordinal":107355,"en":"Your father's Kumaik,"},{"id":"semetey-1-2013:p0397:b004:l039","ordinal":107356,"en":"When he trotted across the hills,"},{"id":"semetey-1-2013:p0398:b003:l001","ordinal":107357,"en":"To me, your unfortunate, wretched mother,"},{"id":"semetey-1-2013:p0398:b003:l002","ordinal":107358,"en":"When Kumaik came running,"},{"id":"semetey-1-2013:p0398:b003:l003","ordinal":107359,"en":"Your father and the forty choros were missing."},{"id":"semetey-1-2013:p0398:b003:l004","ordinal":107360,"en":"I took Zulpukor in my hand;"},{"id":"semetey-1-2013:p0398:b003:l005","ordinal":107361,"en":"All the weapons of war"},{"id":"semetey-1-2013:p0398:b003:l006","ordinal":107362,"en":"I fastened tightly about my waist."},{"id":"semetey-1-2013:p0398:b003:l007","ordinal":107363,"en":"My beloved hair, thick as a girth strap,"},{"id":"semetey-1-2013:p0398:b003:l008","ordinal":107364,"en":"I bound firmly upon my head."},{"id":"semetey-1-2013:p0398:b003:l009","ordinal":107365,"en":"A blue greatcoat no shot could pierce,"},{"id":"semetey-1-2013:p0398:b003:l010","ordinal":107366,"en":"I put on over everything."},{"id":"semetey-1-2013:p0398:b003:l011","ordinal":107367,"en":"Your mother's black, blaze-faced argymak:"},{"id":"semetey-1-2013:p0398:b003:l012","ordinal":107368,"en":"I saddled him and mounted."},{"id":"semetey-1-2013:p0398:b003:l013","ordinal":107369,"en":"Your father's Kumaik:"},{"id":"semetey-1-2013:p0398:b003:l014","ordinal":107370,"en":"Following him, I set out on the road."},{"id":"semetey-1-2013:p0398:b003:l015","ordinal":107371,"en":"Following Kumaik,"},{"id":"semetey-1-2013:p0398:b003:l016","ordinal":107372,"en":"I gained honor through this."},{"id":"semetey-1-2013:p0398:b003:l017","ordinal":107373,"en":"I died before my death;"},{"id":"semetey-1-2013:p0398:b003:l018","ordinal":107374,"en":"When he lay beneath the cliff,"},{"id":"semetey-1-2013:p0398:b003:l019","ordinal":107375,"en":"I found your father the khan."},{"id":"semetey-1-2013:p0398:b003:l020","ordinal":107376,"en":"I hurried them into a flurry;"},{"id":"semetey-1-2013:p0398:b003:l021","ordinal":107377,"en":"To bring your father out alive,"},{"id":"semetey-1-2013:p0398:b003:l022","ordinal":107378,"en":"To restore him to life,"},{"id":"semetey-1-2013:p0398:b003:l023","ordinal":107379,"en":"The great champion who could lift a camel,"},{"id":"semetey-1-2013:p0398:b003:l024","ordinal":107380,"en":"Akayar, I made him dig."},{"id":"semetey-1-2013:p0398:b003:l025","ordinal":107381,"en":"The white hunting hound saw and marked the spot,"},{"id":"semetey-1-2013:p0398:b003:l026","ordinal":107382,"en":"Whining and clawing at the earth."},{"id":"semetey-1-2013:p0398:b003:l027","ordinal":107383,"en":"Your precious father, the lord,"},{"id":"semetey-1-2013:p0398:b003:l028","ordinal":107384,"en":"I found him when he was dead."},{"id":"semetey-1-2013:p0398:b003:l029","ordinal":107385,"en":"I had the cliff's earth scattered;"},{"id":"semetey-1-2013:p0398:b003:l030","ordinal":107386,"en":"Your father's forty mighty warriors,"},{"id":"semetey-1-2013:p0398:b003:l031","ordinal":107387,"en":"Before they could say this or that,"},{"id":"semetey-1-2013:p0398:b003:l032","ordinal":107388,"en":"In the blinking of an eye,"},{"id":"semetey-1-2013:p0398:b003:l033","ordinal":107389,"en":"I had it opened without a moment's pause."},{"id":"semetey-1-2013:p0398:b003:l034","ordinal":107390,"en":"I kindled his extinguished fire;"},{"id":"semetey-1-2013:p0398:b003:l035","ordinal":107391,"en":"I brought his dead soul to life."},{"id":"semetey-1-2013:p0398:b003:l036","ordinal":107392,"en":"I gathered what had scattered;"},{"id":"semetey-1-2013:p0398:b003:l037","ordinal":107393,"en":"I did not stand watching like a mere wife."},{"id":"semetey-1-2013:p0398:b003:l038","ordinal":107394,"en":"Your campaigning father Manas,"},{"id":"semetey-1-2013:p0398:b003:l039","ordinal":107395,"en":"I gave him strength when he went against the foe."},{"id":"semetey-1-2013:p0398:b004:l001","ordinal":107396,"en":"All forty were sons of forty khans;"},{"id":"semetey-1-2013:p0398:b004:l002","ordinal":107397,"en":"Those forty choros, my foal,"},{"id":"semetey-1-2013:p0398:b004:l003","ordinal":107398,"en":"I skillfully made into one people."},{"id":"semetey-1-2013:p0398:b004:l004","ordinal":107399,"en":"Without merely keeping house and looking on,"},{"id":"semetey-1-2013:p0398:b004:l005","ordinal":107400,"en":"I made a lion of my woman's self."},{"id":"semetey-1-2013:p0398:b004:l006","ordinal":107401,"en":"Your father Manas's"},{"id":"semetey-1-2013:p0398:b004:l007","ordinal":107402,"en":"Wishes I brought to fulfillment."},{"id":"semetey-1-2013:p0398:b004:l008","ordinal":107403,"en":"All his chests"},{"id":"semetey-1-2013:p0398:b004:l009","ordinal":107404,"en":"I filled with yellow gold and possessions."},{"id":"semetey-1-2013:p0398:b004:l010","ordinal":107405,"en":"I built him into a house;"},{"id":"semetey-1-2013:p0398:b004:l011","ordinal":107406,"en":"I planted him into an orchard."},{"id":"semetey-1-2013:p0398:b004:l012","ordinal":107407,"en":"Your leopard father Manas,"},{"id":"semetey-1-2013:p0398:b004:l013","ordinal":107408,"en":"Hearing words from Kyrgylchal,"},{"id":"semetey-1-2013:p0398:b004:l014","ordinal":107409,"en":"'My wife, fierce Kanykei,"},{"id":"semetey-1-2013:p0398:b004:l015","ordinal":107410,"en":"Has proved dishonorable,' he heard."},{"id":"semetey-1-2013:p0398:b004:l016","ordinal":107411,"en":"'I shall search the roads of the world,' he said."},{"id":"semetey-1-2013:p0398:b004:l017","ordinal":107412,"en":"'Since my wife has turned bad,"},{"id":"semetey-1-2013:p0398:b004:l018","ordinal":107413,"en":"Though I fight for many years,"},{"id":"semetey-1-2013:p0398:b004:l019","ordinal":107414,"en":"Karacha's daughter Saikal"},{"id":"semetey-1-2013:p0398:b004:l020","ordinal":107415,"en":"I shall take as my bride,' he said."},{"id":"semetey-1-2013:p0398:b004:l021","ordinal":107416,"en":"He took forty choros with him:"},{"id":"semetey-1-2013:p0398:b004:l022","ordinal":107417,"en":"Azhybai and Khan Bakai,"},{"id":"semetey-1-2013:p0398:b004:l023","ordinal":107418,"en":"Syrgak, son of Khan Ulak,"},{"id":"semetey-1-2013:p0398:b004:l024","ordinal":107419,"en":"Almambet, son of Khan Azyz;"},{"id":"semetey-1-2013:p0398:b004:l025","ordinal":107420,"en":"All the mighty warriors were there."},{"id":"semetey-1-2013:p0398:b004:l026","ordinal":107421,"en":"Your leopard father Manas,"},{"id":"semetey-1-2013:p0398:b004:l027","ordinal":107422,"en":"Hearing word in the tales,"},{"id":"semetey-1-2013:p0398:b004:l028","ordinal":107423,"en":"That among women, Khan Saikal"},{"id":"semetey-1-2013:p0398:b004:l029","ordinal":107424,"en":"Had risen as a mighty warrior,"},{"id":"semetey-1-2013:p0398:b004:l030","ordinal":107425,"en":"Yielding nothing to her foes,"},{"id":"semetey-1-2013:p0398:b004:l031","ordinal":107426,"en":"When Konurbai, khan of Kakan,"},{"id":"semetey-1-2013:p0398:b004:l032","ordinal":107427,"en":"Came pouring in to attack,"},{"id":"semetey-1-2013:p0398:b004:l033","ordinal":107428,"en":"Leopard Saikal would not yield."},{"id":"semetey-1-2013:p0398:b004:l034","ordinal":107429,"en":"The beloved land of the Lop River,"},{"id":"semetey-1-2013:p0398:b004:l035","ordinal":107430,"en":"She skillfully made her own domain;"},{"id":"semetey-1-2013:p0398:b004:l036","ordinal":107431,"en":"The Kyrgyz and Oigut of Lop,"},{"id":"semetey-1-2013:p0398:b004:l037","ordinal":107432,"en":"She skillfully made into one people."},{"id":"semetey-1-2013:p0398:b004:l038","ordinal":107433,"en":"Karacha's Saikal"},{"id":"semetey-1-2013:p0398:b004:l039","ordinal":107434,"en":"Had risen as a hero, he heard."},{"id":"semetey-1-2013:p0399:b003:l001","ordinal":107435,"en":"A maiden born a leopard,"},{"id":"semetey-1-2013:p0399:b003:l002","ordinal":107436,"en":"He heard she had risen as a champion."},{"id":"semetey-1-2013:p0399:b003:l003","ordinal":107437,"en":"'Since my bad wife Kanykei"},{"id":"semetey-1-2013:p0399:b003:l004","ordinal":107438,"en":"Has turned out a fool,"},{"id":"semetey-1-2013:p0399:b003:l005","ordinal":107439,"en":"I shall bring slaughter upon the world,' he said."},{"id":"semetey-1-2013:p0399:b003:l006","ordinal":107440,"en":"'Karacha's Khan Saikal,"},{"id":"semetey-1-2013:p0399:b003:l007","ordinal":107441,"en":"Though I have to fight her,"},{"id":"semetey-1-2013:p0399:b003:l008","ordinal":107442,"en":"I shall take her for my wife,' he said."},{"id":"semetey-1-2013:p0399:b003:l009","ordinal":107443,"en":"Taking ammunition loaded upon elephants,"},{"id":"semetey-1-2013:p0399:b003:l010","ordinal":107444,"en":"With the learned Bakai among them,"},{"id":"semetey-1-2013:p0399:b003:l011","ordinal":107445,"en":"He took a force of forty dignitaries."},{"id":"semetey-1-2013:p0399:b003:l012","ordinal":107446,"en":"He had the shotproof coats folded"},{"id":"semetey-1-2013:p0399:b003:l013","ordinal":107447,"en":"And loaded upon Zhelmayan."},{"id":"semetey-1-2013:p0399:b003:l014","ordinal":107448,"en":"Their spears rang out;"},{"id":"semetey-1-2013:p0399:b003:l015","ordinal":107449,"en":"He had all their guns made ready."},{"id":"semetey-1-2013:p0399:b003:l016","ordinal":107450,"en":"The leaders of ten bobbed in their saddles."},{"id":"semetey-1-2013:p0399:b003:l017","ordinal":107451,"en":"Your saintly father, that beloved lion,"},{"id":"semetey-1-2013:p0399:b003:l018","ordinal":107452,"en":"Overbearingly set his course toward Maiden Saikal."},{"id":"semetey-1-2013:p0399:b003:l019","ordinal":107453,"en":"He would not hear my words though I begged;"},{"id":"semetey-1-2013:p0399:b003:l020","ordinal":107454,"en":"He made me a neglected wife."},{"id":"semetey-1-2013:p0399:b003:l021","ordinal":107455,"en":"In the end, without looking upon me,"},{"id":"semetey-1-2013:p0399:b003:l022","ordinal":107456,"en":"Your father Manas would not stop."},{"id":"semetey-1-2013:p0399:b003:l023","ordinal":107457,"en":"He crossed Kotormo"},{"id":"semetey-1-2013:p0399:b003:l024","ordinal":107458,"en":"And passed through Suusamyr."},{"id":"semetey-1-2013:p0399:b003:l025","ordinal":107459,"en":"Traveling along Naryn,"},{"id":"semetey-1-2013:p0399:b003:l026","ordinal":107460,"en":"He traveled far, sparing no horses."},{"id":"semetey-1-2013:p0399:b003:l027","ordinal":107461,"en":"Sweeping along the high plateau,"},{"id":"semetey-1-2013:p0399:b003:l028","ordinal":107462,"en":"Zhaman-Echki and Taragai:"},{"id":"semetey-1-2013:p0399:b003:l029","ordinal":107463,"en":"He traveled along them."},{"id":"semetey-1-2013:p0399:b003:l030","ordinal":107464,"en":"He crossed Bikirtik;"},{"id":"semetey-1-2013:p0399:b003:l031","ordinal":107465,"en":"Beyond lay great Turpan."},{"id":"semetey-1-2013:p0399:b003:l032","ordinal":107466,"en":"He passed through great Turpan."},{"id":"semetey-1-2013:p0399:b003:l033","ordinal":107467,"en":"Traveling along Zhaman-Suu,"},{"id":"semetey-1-2013:p0399:b003:l034","ordinal":107468,"en":"He traveled far, sparing no horses."},{"id":"semetey-1-2013:p0399:b003:l035","ordinal":107469,"en":"He forded Kum-Aryk;"},{"id":"semetey-1-2013:p0399:b003:l036","ordinal":107470,"en":"Beyond lay the great plain."},{"id":"semetey-1-2013:p0399:b003:l037","ordinal":107471,"en":"He reached great Ak-Kum."},{"id":"semetey-1-2013:p0399:b003:l038","ordinal":107472,"en":"Traveling toward Lop,"},{"id":"semetey-1-2013:p0399:b003:l039","ordinal":107473,"en":"He traveled far, sparing no horses."},{"id":"semetey-1-2013:p0399:b004:l001","ordinal":107474,"en":"Seeing lakes in many places,"},{"id":"semetey-1-2013:p0399:b004:l002","ordinal":107475,"en":"Seeing deserts in many places,"},{"id":"semetey-1-2013:p0399:b004:l003","ordinal":107476,"en":"Your father traveled without tiring."},{"id":"semetey-1-2013:p0399:b004:l004","ordinal":107477,"en":"He crossed uneven, deep ravines"},{"id":"semetey-1-2013:p0399:b004:l005","ordinal":107478,"en":"And passed many rounded mountains."},{"id":"semetey-1-2013:p0399:b004:l006","ordinal":107479,"en":"Wearing horses out, scouting the land,"},{"id":"semetey-1-2013:p0399:b004:l007","ordinal":107480,"en":"Loosing hounds and flying hunting birds,"},{"id":"semetey-1-2013:p0399:b004:l008","ordinal":107481,"en":"When bored, they shot roe deer;"},{"id":"semetey-1-2013:p0399:b004:l009","ordinal":107482,"en":"When your father was not bored,"},{"id":"semetey-1-2013:p0399:b004:l010","ordinal":107483,"en":"They unsaddled horses and lay down."},{"id":"semetey-1-2013:p0399:b004:l011","ordinal":107484,"en":"Yraman's singer"},{"id":"semetey-1-2013:p0399:b004:l012","ordinal":107485,"en":"Sang beside him;"},{"id":"semetey-1-2013:p0399:b004:l013","ordinal":107486,"en":"Torobek's diviner"},{"id":"semetey-1-2013:p0399:b004:l014","ordinal":107487,"en":"Cast his divinations at his head."},{"id":"semetey-1-2013:p0399:b004:l015","ordinal":107488,"en":"Skirting the foot of Barbar's mountain,"},{"id":"semetey-1-2013:p0399:b004:l016","ordinal":107489,"en":"The mighty Bakai, their guide,"},{"id":"semetey-1-2013:p0399:b004:l017","ordinal":107490,"en":"Led Zhelmayan."},{"id":"semetey-1-2013:p0399:b004:l018","ordinal":107491,"en":"Your leopard father Manas,"},{"id":"semetey-1-2013:p0399:b004:l019","ordinal":107492,"en":"Traveling everywhere,"},{"id":"semetey-1-2013:p0399:b004:l020","ordinal":107493,"en":"Maiden Saikal's Lop River,"},{"id":"semetey-1-2013:p0399:b004:l021","ordinal":107494,"en":"The Lop River and Chong-Tokoi:"},{"id":"semetey-1-2013:p0399:b004:l022","ordinal":107495,"en":"He visited all those places."},{"id":"semetey-1-2013:p0399:b004:l023","ordinal":107496,"en":"At a spur shaped like a saddle's ridge,"},{"id":"semetey-1-2013:p0399:b004:l024","ordinal":107497,"en":"At the headland of a crumbling mountain,"},{"id":"semetey-1-2013:p0399:b004:l025","ordinal":107498,"en":"When they had just arrived,"},{"id":"semetey-1-2013:p0399:b004:l026","ordinal":107499,"en":"Kalkaman's black horse:"},{"id":"semetey-1-2013:p0399:b004:l027","ordinal":107500,"en":"When your father sent men on patrol,"},{"id":"semetey-1-2013:p0399:b004:l028","ordinal":107501,"en":"Whichever outstanding choro it was,"},{"id":"semetey-1-2013:p0399:b004:l029","ordinal":107502,"en":"He would choose to ride that horse."},{"id":"semetey-1-2013:p0399:b004:l030","ordinal":107503,"en":"His Serek, who went on watch,"},{"id":"semetey-1-2013:p0399:b004:l031","ordinal":107504,"en":"Kalkaman's black horse,"},{"id":"semetey-1-2013:p0399:b004:l032","ordinal":107505,"en":"That warrior chose to ride."},{"id":"semetey-1-2013:p0399:b004:l033","ordinal":107506,"en":"At the crumbling mountain's spur,"},{"id":"semetey-1-2013:p0399:b004:l034","ordinal":107507,"en":"That was where he went on watch."},{"id":"semetey-1-2013:p0399:b004:l035","ordinal":107508,"en":"Khan Manas's Serek,"},{"id":"semetey-1-2013:p0399:b004:l036","ordinal":107509,"en":"Among round-headed mortals,"},{"id":"semetey-1-2013:p0399:b004:l037","ordinal":107510,"en":"Was your father's champion sent on watch."},{"id":"semetey-1-2013:p0399:b004:l038","ordinal":107511,"en":"Receiving Khan Manas's blessing,"},{"id":"semetey-1-2013:p0399:b004:l039","ordinal":107512,"en":"He rode toward the lookout,"},{"id":"semetey-1-2013:p0400:b003:l001","ordinal":107513,"en":"His banner fluttering in his hand,"},{"id":"semetey-1-2013:p0400:b003:l002","ordinal":107514,"en":"Zulpukor of dark steel"},{"id":"semetey-1-2013:p0400:b003:l003","ordinal":107515,"en":"Flashing at his bare wrist,"},{"id":"semetey-1-2013:p0400:b003:l004","ordinal":107516,"en":"A helmet of black iron"},{"id":"semetey-1-2013:p0400:b003:l005","ordinal":107517,"en":"Set upon his precious head,"},{"id":"semetey-1-2013:p0400:b003:l006","ordinal":107518,"en":"Delighting at the word of watch duty,"},{"id":"semetey-1-2013:p0400:b003:l007","ordinal":107519,"en":"Without looking about him,"},{"id":"semetey-1-2013:p0400:b003:l008","ordinal":107520,"en":"To the undulating ridge"}]
