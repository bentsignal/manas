[{"id":"manas-2010:p1575:b001:l021","ordinal":67841,"en":"Where did you spring from?"},{"id":"manas-2010:p1575:b001:l022","ordinal":67842,"en":"You have broken my back;"},{"id":"manas-2010:p1575:b001:l023","ordinal":67843,"en":"How many of my lions you have destroyed!"},{"id":"manas-2010:p1575:b001:l024","ordinal":67844,"en":"You plundered the valuables, leaving none!"},{"id":"manas-2010:p1575:b001:l025","ordinal":67845,"en":"Do not spare your flylike lives;"},{"id":"manas-2010:p1575:b001:l026","ordinal":67846,"en":"Swarm over him in earnest, Chinese!”"},{"id":"manas-2010:p1575:b001:l027","ordinal":67847,"en":"Ay Jangjung came shouting."},{"id":"manas-2010:p1575:b001:l028","ordinal":67848,"en":"Through six thousand shaven ones, a san of governors,"},{"id":"manas-2010:p1575:b001:l029","ordinal":67849,"en":"Ay Jangjung made his way"},{"id":"manas-2010:p1575:b001:l030","ordinal":67850,"en":"And thrust his lance in earnest."},{"id":"manas-2010:p1575:b001:l031","ordinal":67851,"en":"The many Chinese closed around him;"},{"id":"manas-2010:p1575:b001:l032","ordinal":67852,"en":"Then the young lad Syrgak"},{"id":"manas-2010:p1575:b001:l033","ordinal":67853,"en":"Was left in their midst."},{"id":"manas-2010:p1575:b001:l034","ordinal":67854,"en":"No man had strength to wrestle him;"},{"id":"manas-2010:p1575:b001:l035","ordinal":67855,"en":"No lion’s teeth could pierce him—"},{"id":"manas-2010:p1575:b001:l036","ordinal":67856,"en":"Akbaltay’s Chubak,"},{"id":"manas-2010:p1575:b001:l037","ordinal":67857,"en":"For the young leopard Syrgak,"},{"id":"manas-2010:p1575:b001:l038","ordinal":67858,"en":"To stand beside him,"},{"id":"manas-2010:p1575:b001:l039","ordinal":67859,"en":"Charged into the fray."},{"id":"manas-2010:p1575:b001:l040","ordinal":67860,"en":"Sarala shone as though moonlit;"},{"id":"manas-2010:p1575:b001:l041","ordinal":67861,"en":"Making him dart like an arrow-snake,"},{"id":"manas-2010:p1575:b001:l042","ordinal":67862,"en":"Almambet rushed in shouting."},{"id":"manas-2010:p1576:b001:l001","ordinal":67863,"en":"Without sparing his precious life,"},{"id":"manas-2010:p1576:b001:l002","ordinal":67864,"en":"He plunged among the countless troops."},{"id":"manas-2010:p1576:b001:l003","ordinal":67865,"en":"With golden forelock and tasseled sash,"},{"id":"manas-2010:p1576:b001:l004","ordinal":67866,"en":"Azizkan’s fierce son"},{"id":"manas-2010:p1576:b001:l005","ordinal":67867,"en":"Spurred on either side,"},{"id":"manas-2010:p1576:b001:l006","ordinal":67868,"en":"Struck with his whip right and left,"},{"id":"manas-2010:p1576:b001:l007","ordinal":67869,"en":"And shouted, “Islam!”"},{"id":"manas-2010:p1576:b001:l008","ordinal":67870,"en":"The surging Black Chinese,"},{"id":"manas-2010:p1576:b001:l009","ordinal":67871,"en":"Without sparing his flylike life,"},{"id":"manas-2010:p1576:b001:l010","ordinal":67872,"en":"He scattered and firmly halted."},{"id":"manas-2010:p1576:b001:l011","ordinal":67873,"en":"Brave Chubak braced himself;"},{"id":"manas-2010:p1576:b001:l012","ordinal":67874,"en":"Shouting from the flank,"},{"id":"manas-2010:p1576:b001:l013","ordinal":67875,"en":"Chubak charged through."},{"id":"manas-2010:p1576:b001:l014","ordinal":67876,"en":"Ay Jangjung and Ezkara—"},{"id":"manas-2010:p1576:b001:l015","ordinal":67877,"en":"He reached the two together."},{"id":"manas-2010:p1576:b001:l016","ordinal":67878,"en":"On reaching them, brave Chubak"},{"id":"manas-2010:p1576:b001:l017","ordinal":67879,"en":"Brought both down at once,"},{"id":"manas-2010:p1576:b001:l018","ordinal":67880,"en":"Knocked them flat and swept past."},{"id":"manas-2010:p1576:b001:l019","ordinal":67881,"en":"After both fell from their horses,"},{"id":"manas-2010:p1576:b001:l020","ordinal":67882,"en":"Without sparing his flylike life,"},{"id":"manas-2010:p1576:b001:l021","ordinal":67883,"en":"Taking Arkesken in hand,"},{"id":"manas-2010:p1576:b001:l022","ordinal":67884,"en":"As he was about to reach them faster than an arrow,"},{"id":"manas-2010:p1576:b001:l023","ordinal":67885,"en":"To reach them and cut off their heads,"},{"id":"manas-2010:p1576:b001:l024","ordinal":67886,"en":"A champion named Zheldet"},{"id":"manas-2010:p1576:b001:l025","ordinal":67887,"en":"Arrived ahead of an arrow."},{"id":"manas-2010:p1576:b001:l026","ordinal":67888,"en":"Reaching them, he set them on horses,"},{"id":"manas-2010:p1576:b001:l027","ordinal":67889,"en":"And both alike, safe and sound,"},{"id":"manas-2010:p1576:b001:l028","ordinal":67890,"en":"He led away."},{"id":"manas-2010:p1576:b001:l029","ordinal":67891,"en":"As he stood covered in blood with Kögala,"},{"id":"manas-2010:p1576:b001:l030","ordinal":67892,"en":"Your fierce Chubak,"},{"id":"manas-2010:p1576:b001:l031","ordinal":67893,"en":"Without looking around him,"},{"id":"manas-2010:p1576:b001:l032","ordinal":67894,"en":"Alöökö’s Kongurbay,"},{"id":"manas-2010:p1576:b001:l033","ordinal":67895,"en":"Without sparing his life at all,"},{"id":"manas-2010:p1576:b001:l034","ordinal":67896,"en":"At the ocean-like champion Chubak"},{"id":"manas-2010:p1576:b001:l035","ordinal":67897,"en":"Charged now, that slave Kalcha."},{"id":"manas-2010:p1576:b001:l036","ordinal":67898,"en":"Without sparing his own life,"},{"id":"manas-2010:p1576:b001:l037","ordinal":67899,"en":"Fiercely at Chubak,"},{"id":"manas-2010:p1576:b001:l038","ordinal":67900,"en":"As he was about to thrust his lance,"},{"id":"manas-2010:p1576:b001:l039","ordinal":67901,"en":"Shouting from the flank,"},{"id":"manas-2010:p1576:b001:l040","ordinal":67902,"en":"Almambet came charging."},{"id":"manas-2010:p1576:b001:l041","ordinal":67903,"en":"Before Kalcha could flee back,"},{"id":"manas-2010:p1576:b001:l042","ordinal":67904,"en":"The skilled Almambet"},{"id":"manas-2010:p1577:b001:l001","ordinal":67905,"en":"Reached him in the blink of an eye."},{"id":"manas-2010:p1577:b001:l002","ordinal":67906,"en":"Kalcha, big as a camel,"},{"id":"manas-2010:p1577:b001:l003","ordinal":67907,"en":"Almambet made small as a knucklebone;"},{"id":"manas-2010:p1577:b001:l004","ordinal":67908,"en":"From atop Algara"},{"id":"manas-2010:p1577:b001:l005","ordinal":67909,"en":"He knocked him flat and swept past."},{"id":"manas-2010:p1577:b001:l006","ordinal":67910,"en":"Kalcha fell!"},{"id":"manas-2010:p1577:b001:l007","ordinal":67911,"en":"When Kongurbay fell,"},{"id":"manas-2010:p1577:b001:l008","ordinal":67912,"en":"The swift runners on foot made ready;"},{"id":"manas-2010:p1577:b001:l009","ordinal":67913,"en":"All the leopards swarmed together."},{"id":"manas-2010:p1577:b001:l010","ordinal":67914,"en":"The champions whose lances could reach"},{"id":"manas-2010:p1577:b001:l011","ordinal":67915,"en":"Battered with their lances,"},{"id":"manas-2010:p1577:b001:l012","ordinal":67916,"en":"Pressed on with their battle-axes."},{"id":"manas-2010:p1577:b001:l013","ordinal":67917,"en":"At that moment brave Syrgak"},{"id":"manas-2010:p1577:b001:l014","ordinal":67918,"en":"Spurred toward Kalcha."},{"id":"manas-2010:p1577:b001:l015","ordinal":67919,"en":"His eyes strained with eagerness:"},{"id":"manas-2010:p1577:b001:l016","ordinal":67920,"en":"“Let me seize him by the very hem!”"},{"id":"manas-2010:p1577:b001:l017","ordinal":67921,"en":"Before the falcon Syrgak could reach him,"},{"id":"manas-2010:p1577:b001:l018","ordinal":67922,"en":"Before he could cut off his head,"},{"id":"manas-2010:p1577:b001:l019","ordinal":67923,"en":"Forty shaven ones behind him,"},{"id":"manas-2010:p1577:b001:l020","ordinal":67924,"en":"Their shouts splitting stone,"},{"id":"manas-2010:p1577:b001:l021","ordinal":67925,"en":"Set Kalcha on his horse,"},{"id":"manas-2010:p1577:b001:l022","ordinal":67926,"en":"Straightened him up and took him away."},{"id":"manas-2010:p1577:b001:l023","ordinal":67927,"en":"Then the young Syrgak’s"},{"id":"manas-2010:p1577:b001:l024","ordinal":67928,"en":"Heart was sorely troubled:"},{"id":"manas-2010:p1577:b001:l025","ordinal":67929,"en":"“The Chinese are countless; we are alone."},{"id":"manas-2010:p1577:b001:l026","ordinal":67930,"en":"We have no support to rely on."},{"id":"manas-2010:p1577:b001:l027","ordinal":67931,"en":"Shall we die unwarned?"},{"id":"manas-2010:p1577:b001:l028","ordinal":67932,"en":"Our renowned lion Manas is absent!”"},{"id":"manas-2010:p1577:b001:l029","ordinal":67933,"en":"So spoke dear Syrgak,"},{"id":"manas-2010:p1577:b001:l030","ordinal":67934,"en":"And over the blood-flowing battle"},{"id":"manas-2010:p1577:b001:l031","ordinal":67935,"en":"He stood grieving."},{"id":"manas-2010:p1577:b001:l032","ordinal":67936,"en":"After plunging through them for nine days,"},{"id":"manas-2010:p1577:b001:l033","ordinal":67937,"en":"Almambet emerged then,"},{"id":"manas-2010:p1577:b001:l034","ordinal":67938,"en":"Wounded in nine places."},{"id":"manas-2010:p1577:b001:l035","ordinal":67939,"en":"After fighting for seven days,"},{"id":"manas-2010:p1577:b001:l036","ordinal":67940,"en":"Akbaltay’s Chubak"},{"id":"manas-2010:p1577:b001:l037","ordinal":67941,"en":"Was wounded in seven places."},{"id":"manas-2010:p1577:b001:l038","ordinal":67942,"en":"See the blood flowing in winding streams!"},{"id":"manas-2010:p1577:b001:l039","ordinal":67943,"en":"See the lives fallen in heaps!"},{"id":"manas-2010:p1577:b001:l040","ordinal":67944,"en":"Without regard for those who died,"},{"id":"manas-2010:p1577:b001:l041","ordinal":67945,"en":"Without thinking, “I shall die,”"},{"id":"manas-2010:p1577:b001:l042","ordinal":67946,"en":"The massed Manchus and the many Chinese"},{"id":"manas-2010:p1578:b001:l001","ordinal":67947,"en":"Swarmed over them together."},{"id":"manas-2010:p1578:b001:l002","ordinal":67948,"en":"“Capture them alive!”"},{"id":"manas-2010:p1578:b001:l003","ordinal":67949,"en":"Kongurbay went about shouting."},{"id":"manas-2010:p1578:b001:l004","ordinal":67950,"en":"When the Chinese pressed upon them,"},{"id":"manas-2010:p1578:b001:l005","ordinal":67951,"en":"Hardship fell upon their heads;"},{"id":"manas-2010:p1578:b001:l006","ordinal":67952,"en":"They fled again."},{"id":"manas-2010:p1578:b001:l007","ordinal":67953,"en":"When a horse came racing up ahead,"},{"id":"manas-2010:p1578:b001:l008","ordinal":67954,"en":"They fought a running skirmish."},{"id":"manas-2010:p1578:b001:l009","ordinal":67955,"en":"Even then the many Chinese"},{"id":"manas-2010:p1578:b001:l010","ordinal":67956,"en":"Swarmed over them."},{"id":"manas-2010:p1578:b001:l011","ordinal":67957,"en":"See the reeds, see the flood!"},{"id":"manas-2010:p1578:b001:l012","ordinal":67958,"en":"See the people sweeping over them!"},{"id":"manas-2010:p1578:b001:l013","ordinal":67959,"en":"When Chubak rode on ahead,"},{"id":"manas-2010:p1578:b001:l014","ordinal":67960,"en":"The leopard turned back—"},{"id":"manas-2010:p1578:b001:l015","ordinal":67961,"en":"Syrgak kept fighting."},{"id":"manas-2010:p1578:b001:l016","ordinal":67962,"en":"When Syrgak sped away,"},{"id":"manas-2010:p1578:b001:l017","ordinal":67963,"en":"Almambet stayed to struggle."},{"id":"manas-2010:p1578:b001:l018","ordinal":67964,"en":"When Almambet and Syrgak rode off,"},{"id":"manas-2010:p1578:b001:l019","ordinal":67965,"en":"Brave Chubak stayed behind,"},{"id":"manas-2010:p1578:b001:l020","ordinal":67966,"en":"Fighting without sparing his life."},{"id":"manas-2010:p1578:b001:l021","ordinal":67967,"en":"Pursuing day and night,"},{"id":"manas-2010:p1578:b001:l022","ordinal":67968,"en":"Chubak came battering them."},{"id":"manas-2010:p1578:b001:l023","ordinal":67969,"en":"The three kept forcing their way onward;"},{"id":"manas-2010:p1578:b001:l024","ordinal":67970,"en":"They had no support to rely on."},{"id":"manas-2010:p1578:b001:l025","ordinal":67971,"en":"Bearing countless wounds,"},{"id":"manas-2010:p1578:b001:l026","ordinal":67972,"en":"As they fought their running skirmish,"},{"id":"manas-2010:p1578:b001:l027","ordinal":67973,"en":"Their champion lion Manas absent,"},{"id":"manas-2010:p1578:b001:l028","ordinal":67974,"en":"They fled without turning back."},{"id":"manas-2010:p1578:b001:l029","ordinal":67975,"en":"Crossing pass after pass,"},{"id":"manas-2010:p1578:b001:l030","ordinal":67976,"en":"Traveling road after road,"},{"id":"manas-2010:p1578:b001:l031","ordinal":67977,"en":"The many Chinese came pursuing,"},{"id":"manas-2010:p1578:b001:l032","ordinal":67978,"en":"Strung out one by one,"},{"id":"manas-2010:p1578:b001:l033","ordinal":67979,"en":"Bellowing and clamoring."},{"id":"manas-2010:p1578:b001:l034","ordinal":67980,"en":"Those left alive said,"},{"id":"manas-2010:p1578:b001:l035","ordinal":67981,"en":"“We shall reach Talas.”"},{"id":"manas-2010:p1578:b001:l036","ordinal":67982,"en":"Letting their horses have their heads,"},{"id":"manas-2010:p1578:b001:l037","ordinal":67983,"en":"The three champions sped on."},{"id":"manas-2010:p1578:b001:l038","ordinal":67984,"en":"To the great host ahead"},{"id":"manas-2010:p1578:b001:l039","ordinal":67985,"en":"They came then."},{"id":"manas-2010:p1578:b001:l040","ordinal":67986,"en":"For so many days, so many nights,"},{"id":"manas-2010:p1578:b001:l041","ordinal":67987,"en":"They had battled the Chinese;"},{"id":"manas-2010:p1578:b001:l042","ordinal":67988,"en":"Blood drained from their faces,"},{"id":"manas-2010:p1579:b001:l001","ordinal":67989,"en":"Bearing so many wounds,"},{"id":"manas-2010:p1579:b001:l002","ordinal":67990,"en":"Drenched in dark blood,"},{"id":"manas-2010:p1579:b001:l003","ordinal":67991,"en":"Their faces had grown gaunt."},{"id":"manas-2010:p1579:b001:l004","ordinal":67992,"en":"Their lives were hard pressed;"},{"id":"manas-2010:p1579:b001:l005","ordinal":67993,"en":"Against the whole vast Chinese host"},{"id":"manas-2010:p1579:b001:l006","ordinal":67994,"en":"The three had fought alone."},{"id":"manas-2010:p1579:b001:l007","ordinal":67995,"en":"Until the pliant stalks ripened,"},{"id":"manas-2010:p1579:b001:l008","ordinal":67996,"en":"Until the autumn gossamer flew,"},{"id":"manas-2010:p1579:b001:l009","ordinal":67997,"en":"Taking no rest by day,"},{"id":"manas-2010:p1579:b001:l010","ordinal":67998,"en":"Lying down to no sleep at night,"},{"id":"manas-2010:p1579:b001:l011","ordinal":67999,"en":"Without sparing their flylike lives,"},{"id":"manas-2010:p1579:b001:l012","ordinal":68000,"en":"Without thinking, “We shall die,”"},{"id":"manas-2010:p1579:b001:l013","ordinal":68001,"en":"The three falcons, all alone,"},{"id":"manas-2010:p1579:b001:l014","ordinal":68002,"en":"Had fought the Chinese."},{"id":"manas-2010:p1579:b001:l015","ordinal":68003,"en":"Shouting in fury,"},{"id":"manas-2010:p1579:b001:l016","ordinal":68004,"en":"Gathering his courage at last,"},{"id":"manas-2010:p1579:b001:l017","ordinal":68005,"en":"Not letting the Muslims leave,"},{"id":"manas-2010:p1579:b001:l018","ordinal":68006,"en":"Your fierce champion Manas"},{"id":"manas-2010:p1579:b001:l019","ordinal":68007,"en":"Was standing to bar their way."},{"id":"manas-2010:p1579:b001:l020","ordinal":68008,"en":"“Having ridden out from Talas"},{"id":"manas-2010:p1579:b001:l021","ordinal":68009,"en":"And come expressly to the Chinese,"},{"id":"manas-2010:p1579:b001:l022","ordinal":68010,"en":"How can I flee?” he said."},{"id":"manas-2010:p1579:b001:l023","ordinal":68011,"en":"With his sword he halted the host"},{"id":"manas-2010:p1579:b001:l024","ordinal":68012,"en":"And stood herding them back together."},{"id":"manas-2010:p1579:b001:l025","ordinal":68013,"en":"The poppies had ripened and turned to grass;"},{"id":"manas-2010:p1579:b001:l026","ordinal":68014,"en":"The horses had grown fat and firm."},{"id":"manas-2010:p1579:b001:l027","ordinal":68015,"en":"The heroes lay idle,"},{"id":"manas-2010:p1579:b001:l028","ordinal":68016,"en":"Frustrated because there was no battle."},{"id":"manas-2010:p1579:b001:l029","ordinal":68017,"en":"For spirited young men and swift horses"},{"id":"manas-2010:p1579:b001:l030","ordinal":68018,"en":"The time to be of use had come."},{"id":"manas-2010:p1579:b001:l031","ordinal":68019,"en":"Almambet, Syrgak, brave Chubak,"},{"id":"manas-2010:p1579:b001:l032","ordinal":68020,"en":"Safe and sound, with Manas"},{"id":"manas-2010:p1579:b001:l033","ordinal":68021,"en":"Met and exchanged greetings."},{"id":"manas-2010:p1579:b001:l034","ordinal":68022,"en":"They dismounted,"},{"id":"manas-2010:p1579:b001:l035","ordinal":68023,"en":"Tethered their horses crosswise,"},{"id":"manas-2010:p1579:b001:l036","ordinal":68024,"en":"And stood offering greetings."},{"id":"manas-2010:p1579:b001:l037","ordinal":68025,"en":"Then Manas said this:"},{"id":"manas-2010:p1579:b001:l038","ordinal":68026,"en":"“My pennon on the red lance,"},{"id":"manas-2010:p1579:b001:l039","ordinal":68027,"en":"My eagle, champion Almambet,"},{"id":"manas-2010:p1579:b001:l040","ordinal":68028,"en":"My gift that came from China!"},{"id":"manas-2010:p1579:b001:l041","ordinal":68029,"en":"My twin Chubak, my splendid one,"},{"id":"manas-2010:p1579:b001:l042","ordinal":68030,"en":"You will never leave my mind,"},{"id":"manas-2010:p1580:b001:l001","ordinal":68031,"en":"A bringer of good fortune when I send you ahead,"},{"id":"manas-2010:p1580:b001:l002","ordinal":68032,"en":"My precious Syrgak,"},{"id":"manas-2010:p1580:b001:l003","ordinal":68033,"en":"My falcon when grappling with the enemy,"},{"id":"manas-2010:p1580:b001:l004","ordinal":68034,"en":"My countless army in a shooting fight,"},{"id":"manas-2010:p1580:b001:l005","ordinal":68035,"en":"All three of you my champions,"},{"id":"manas-2010:p1580:b001:l006","ordinal":68036,"en":"My complete good fortune,"},{"id":"manas-2010:p1580:b001:l007","ordinal":68037,"en":"My morning star above my head,"},{"id":"manas-2010:p1580:b001:l008","ordinal":68038,"en":"Have you come safe and sound,"},{"id":"manas-2010:p1580:b001:l009","ordinal":68039,"en":"All three of you, my lions and tigers?!"},{"id":"manas-2010:p1580:b001:l010","ordinal":68040,"en":"Clash with Beijing in earnest,"},{"id":"manas-2010:p1580:b001:l011","ordinal":68041,"en":"And throw it into turmoil!"},{"id":"manas-2010:p1580:b001:l012","ordinal":68042,"en":"The Chinese who cannot match you—"},{"id":"manas-2010:p1580:b001:l013","ordinal":68043,"en":"Make their red blood flow;"},{"id":"manas-2010:p1580:b001:l014","ordinal":68044,"en":"Drive them toward Deep Beijing!"},{"id":"manas-2010:p1580:b001:l015","ordinal":68045,"en":"Their imposing khans,"},{"id":"manas-2010:p1580:b001:l016","ordinal":68046,"en":"Split them open along the road!"},{"id":"manas-2010:p1580:b001:l017","ordinal":68047,"en":"The spirited Burut Muslims,"},{"id":"manas-2010:p1580:b001:l018","ordinal":68048,"en":"From the uncircumcised Chinese,"},{"id":"manas-2010:p1580:b001:l019","ordinal":68049,"en":"Rescue them!"},{"id":"manas-2010:p1580:b001:l020","ordinal":68050,"en":"Bring the end of the world"},{"id":"manas-2010:p1580:b001:l021","ordinal":68051,"en":"Down upon the Chinese!"},{"id":"manas-2010:p1580:b001:l022","ordinal":68052,"en":"If we flee without fighting,"},{"id":"manas-2010:p1580:b001:l023","ordinal":68053,"en":"Will the Chinese not come sweeping after us?"},{"id":"manas-2010:p1580:b001:l024","ordinal":68054,"en":"Saying, ‘Manas has fled,’"},{"id":"manas-2010:p1580:b001:l025","ordinal":68055,"en":"Pursuing the Burut,"},{"id":"manas-2010:p1580:b001:l026","ordinal":68056,"en":"Will the Manchus not destroy them utterly?”"},{"id":"manas-2010:p1580:b001:l027","ordinal":68057,"en":"He spoke his words to the heroes."},{"id":"manas-2010:p1580:b001:l028","ordinal":68058,"en":"The three champions standing before him"},{"id":"manas-2010:p1580:b001:l029","ordinal":68059,"en":"Ate and rested,"},{"id":"manas-2010:p1580:b001:l030","ordinal":68060,"en":"Washed and performed their ablutions,"},{"id":"manas-2010:p1580:b001:l031","ordinal":68061,"en":"Bathed in clean water,"},{"id":"manas-2010:p1580:b001:l032","ordinal":68062,"en":"Put on clean clothes,"},{"id":"manas-2010:p1580:b001:l033","ordinal":68063,"en":"Laid their heads toward the direction of prayer,"},{"id":"manas-2010:p1580:b001:l034","ordinal":68064,"en":"Pillowed them on their white-framed saddles,"},{"id":"manas-2010:p1580:b001:l035","ordinal":68065,"en":"And entered sleep then."},{"id":"manas-2010:p1580:b001:l036","ordinal":68066,"en":"Dawn broke clear;"},{"id":"manas-2010:p1580:b001:l037","ordinal":68067,"en":"Light fell on the earth."},{"id":"manas-2010:p1580:b001:l038","ordinal":68068,"en":"Stars parted from the heavens,"},{"id":"manas-2010:p1580:b001:l039","ordinal":68069,"en":"Spilling toward the west;"},{"id":"manas-2010:p1580:b001:l040","ordinal":68070,"en":"Dawn faintly opened."},{"id":"manas-2010:p1580:b001:l041","ordinal":68071,"en":"When the light grew clear,"},{"id":"manas-2010:p1580:b001:l042","ordinal":68072,"en":"Making ready for their ablutions,"},{"id":"manas-2010:p1581:b001:l001","ordinal":68073,"en":"They dipped their hands in the water,"},{"id":"manas-2010:p1581:b001:l002","ordinal":68074,"en":"Washed their hands for prayer,"},{"id":"manas-2010:p1581:b001:l003","ordinal":68075,"en":"Dipped their feet in the water,"},{"id":"manas-2010:p1581:b001:l004","ordinal":68076,"en":"Washed their feet for prayer,"},{"id":"manas-2010:p1581:b001:l005","ordinal":68077,"en":"And loudly called the call to prayer."},{"id":"manas-2010:p1581:b001:l006","ordinal":68078,"en":"The heroes began their prayers."},{"id":"manas-2010:p1581:b001:l007","ordinal":68079,"en":"Two customary, two obligatory—"},{"id":"manas-2010:p1581:b001:l008","ordinal":68080,"en":"The four cycles of the dawn prayer"},{"id":"manas-2010:p1581:b001:l009","ordinal":68081,"en":"They duly recited."},{"id":"manas-2010:p1581:b001:l010","ordinal":68082,"en":"They ate their food,"},{"id":"manas-2010:p1581:b001:l011","ordinal":68083,"en":"Made ready each at his horse,"},{"id":"manas-2010:p1581:b001:l012","ordinal":68084,"en":"Pulled the rear girths tight,"},{"id":"manas-2010:p1581:b001:l013","ordinal":68085,"en":"Shortened their cruppers,"},{"id":"manas-2010:p1581:b001:l014","ordinal":68086,"en":"Adorned their lances,"},{"id":"manas-2010:p1581:b001:l015","ordinal":68087,"en":"Girded on their battle-axes,"},{"id":"manas-2010:p1581:b001:l016","ordinal":68088,"en":"And turned toward the Chinese."},{"id":"manas-2010:p1581:b001:l017","ordinal":68089,"en":"The whole host could hardly hold still;"},{"id":"manas-2010:p1581:b001:l018","ordinal":68090,"en":"With Khan Manas at its head,"},{"id":"manas-2010:p1581:b001:l019","ordinal":68091,"en":"It stood watching, prepared."},{"id":"manas-2010:p1581:b001:l020","ordinal":68092,"en":"They stood facing the enemy, eyes fixed,"},{"id":"manas-2010:p1581:b001:l021","ordinal":68093,"en":"All the Burut gathered together."},{"id":"manas-2010:p1581:b001:l022","ordinal":68094,"en":"As they watched, the many Chinese"},{"id":"manas-2010:p1581:b001:l023","ordinal":68095,"en":"All came sweeping on,"},{"id":"manas-2010:p1581:b001:l024","ordinal":68096,"en":"Rolling forward from their furthest depths."}]
