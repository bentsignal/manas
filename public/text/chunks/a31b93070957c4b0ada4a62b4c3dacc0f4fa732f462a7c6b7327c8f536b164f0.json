[{"id":"manas-2010:p0787:b001:l002","ordinal":34817,"en":"I am Manas himself,"},{"id":"manas-2010:p0787:b001:l003","ordinal":34818,"en":"Who poured blood into spring water,"},{"id":"manas-2010:p0787:b001:l004","ordinal":34819,"en":"The bloodthirsty one, here in the flesh!"},{"id":"manas-2010:p0787:b001:l005","ordinal":34820,"en":"There is no division in water flowing across,"},{"id":"manas-2010:p0787:b001:l006","ordinal":34821,"en":"While falcon Manas lives,"},{"id":"manas-2010:p0787:b001:l007","ordinal":34822,"en":"Forty valiant ones, you shall not die!"},{"id":"manas-2010:p0787:b001:l008","ordinal":34823,"en":"Damn your fathers' graves, forty champions,"},{"id":"manas-2010:p0787:b001:l009","ordinal":34824,"en":"Be fierce, be heroes,"},{"id":"manas-2010:p0787:b001:l010","ordinal":34825,"en":"We have newly become companions;"},{"id":"manas-2010:p0787:b001:l011","ordinal":34826,"en":"Never sated by drinking blood,"},{"id":"manas-2010:p0787:b001:l012","ordinal":34827,"en":"Be champions just like me!’"},{"id":"manas-2010:p0787:b001:l013","ordinal":34828,"en":"When Manas said these words,"},{"id":"manas-2010:p0787:b001:l014","ordinal":34829,"en":"Where water rose upon the open plain,"},{"id":"manas-2010:p0787:b001:l015","ordinal":34830,"en":"The place was Kayyp-Bulak,"},{"id":"manas-2010:p0787:b001:l016","ordinal":34831,"en":"Where animals and creatures"},{"id":"manas-2010:p0787:b001:l017","ordinal":34832,"en":"Could sustain their lives,"},{"id":"manas-2010:p0787:b001:l018","ordinal":34833,"en":"True saints and spiritual elders"},{"id":"manas-2010:p0787:b001:l019","ordinal":34834,"en":"Protected that place."},{"id":"manas-2010:p0787:b001:l020","ordinal":34835,"en":"When they saw that spring,"},{"id":"manas-2010:p0787:b001:l021","ordinal":34836,"en":"Aged Bakay, blessed by Kydyr,"},{"id":"manas-2010:p0787:b001:l022","ordinal":34837,"en":"Tumbled down from their horses,"},{"id":"manas-2010:p0787:b001:l023","ordinal":34838,"en":"And all the forty champions."},{"id":"manas-2010:p0787:b001:l024","ordinal":34839,"en":"The forty champions stood in a row;"},{"id":"manas-2010:p0787:b001:l025","ordinal":34840,"en":"All of them, bustling about,"},{"id":"manas-2010:p0787:b001:l026","ordinal":34841,"en":"Put their hands into the water,"},{"id":"manas-2010:p0787:b001:l027","ordinal":34842,"en":"And washed their hands for prayer."},{"id":"manas-2010:p0787:b001:l028","ordinal":34843,"en":"They put their feet into the water,"},{"id":"manas-2010:p0787:b001:l029","ordinal":34844,"en":"And washed their feet for prayer."},{"id":"manas-2010:p0787:b001:l030","ordinal":34845,"en":"The gray pouch-belt sent from the unseen"},{"id":"manas-2010:p0787:b001:l031","ordinal":34846,"en":"Was hung about the neck."},{"id":"manas-2010:p0787:b001:l032","ordinal":34847,"en":"They all stood in a row,"},{"id":"manas-2010:p0787:b001:l033","ordinal":34848,"en":"Beseeching the Creator."},{"id":"manas-2010:p0787:b001:l034","ordinal":34849,"en":"‘Forearms, thick forearms you have,"},{"id":"manas-2010:p0787:b001:l035","ordinal":34850,"en":"You have the heart of a thousand men;"},{"id":"manas-2010:p0787:b001:l036","ordinal":34851,"en":"My lion, do not speak such words,’ they said,"},{"id":"manas-2010:p0787:b001:l037","ordinal":34852,"en":"‘Do not put us to shame,’ they said."},{"id":"manas-2010:p0787:b001:l038","ordinal":34853,"en":"The forty champions, bustling about,"},{"id":"manas-2010:p0787:b001:l039","ordinal":34854,"en":"When they looked at hero Manas,"},{"id":"manas-2010:p0787:b001:l040","ordinal":34855,"en":"His gleaming front teeth, like a door,"},{"id":"manas-2010:p0787:b001:l041","ordinal":34856,"en":"Teeth unlike those of other people,"},{"id":"manas-2010:p0787:b001:l042","ordinal":34857,"en":"Had come jutting out,"},{"id":"manas-2010:p0788:b001:l001","ordinal":34858,"en":"His thirst for blood had truly seized him;"},{"id":"manas-2010:p0788:b001:l002","ordinal":34859,"en":"God had struck him down."},{"id":"manas-2010:p0788:b001:l003","ordinal":34860,"en":"Saintly Bakay the elder,"},{"id":"manas-2010:p0788:b001:l004","ordinal":34861,"en":"And all the forty champions:"},{"id":"manas-2010:p0788:b001:l005","ordinal":34862,"en":"‘My longed-for leopard,"},{"id":"manas-2010:p0788:b001:l006","ordinal":34863,"en":"My saint, let me circle you in devotion,"},{"id":"manas-2010:p0788:b001:l007","ordinal":34864,"en":"You became a lion who ravaged unbelievers,"},{"id":"manas-2010:p0788:b001:l008","ordinal":34865,"en":"You attained abundance on every side."},{"id":"manas-2010:p0788:b001:l009","ordinal":34866,"en":"When you reached twelve,"},{"id":"manas-2010:p0788:b001:l010","ordinal":34867,"en":"You broke a court and took its spoils,"},{"id":"manas-2010:p0788:b001:l011","ordinal":34868,"en":"You attacked a people with a royal court."},{"id":"manas-2010:p0788:b001:l012","ordinal":34869,"en":"Sated with blood, you grew hardened,"},{"id":"manas-2010:p0788:b001:l013","ordinal":34870,"en":"You won the name Bloodthirsty Manas."},{"id":"manas-2010:p0788:b001:l014","ordinal":34871,"en":"Throwing the world into turmoil,"},{"id":"manas-2010:p0788:b001:l015","ordinal":34872,"en":"You attained abundance on every side,"},{"id":"manas-2010:p0788:b001:l016","ordinal":34873,"en":"You became a lion who slaughtered enemies."},{"id":"manas-2010:p0788:b001:l017","ordinal":34874,"en":"We forty were sons of forty khans;"},{"id":"manas-2010:p0788:b001:l018","ordinal":34875,"en":"Seeking you, we came,"},{"id":"manas-2010:p0788:b001:l019","ordinal":34876,"en":"And became champions, became heroes."},{"id":"manas-2010:p0788:b001:l020","ordinal":34877,"en":"The pure Prophet's faith is true;"},{"id":"manas-2010:p0788:b001:l021","ordinal":34878,"en":"My wolf-maned one, to you"},{"id":"manas-2010:p0788:b001:l022","ordinal":34879,"en":"We have become champions now!"},{"id":"manas-2010:p0788:b001:l023","ordinal":34880,"en":"Leopard of surpassing fortune,"},{"id":"manas-2010:p0788:b001:l024","ordinal":34881,"en":"If the forty champions so much as falter,"},{"id":"manas-2010:p0788:b001:l025","ordinal":34882,"en":"Cut off their heads with your sword."},{"id":"manas-2010:p0788:b001:l026","ordinal":34883,"en":"Beyond Shooruk, leopard,"},{"id":"manas-2010:p0788:b001:l027","ordinal":34884,"en":"While you have the forty champions,"},{"id":"manas-2010:p0788:b001:l028","ordinal":34885,"en":"Bring slaughter upon the Chinese!"},{"id":"manas-2010:p0788:b001:l029","ordinal":34886,"en":"When a black gun booms,"},{"id":"manas-2010:p0788:b001:l030","ordinal":34887,"en":"Of the man who flees,"},{"id":"manas-2010:p0788:b001:l031","ordinal":34888,"en":"Let his head be cut off and his blood shed."},{"id":"manas-2010:p0788:b001:l032","ordinal":34889,"en":"May whoever resents it never prosper;"},{"id":"manas-2010:p0788:b001:l033","ordinal":34890,"en":"Whoever thinks, “A needless death,”"},{"id":"manas-2010:p0788:b001:l034","ordinal":34891,"en":"The champions who so much as grieve over it,"},{"id":"manas-2010:p0788:b001:l035","ordinal":34892,"en":"May they not be of the Muslim faith."},{"id":"manas-2010:p0788:b001:l036","ordinal":34893,"en":"These forty champions standing here,"},{"id":"manas-2010:p0788:b001:l037","ordinal":34894,"en":"Give them spears and send them at the foe."},{"id":"manas-2010:p0788:b001:l038","ordinal":34895,"en":"Generous one, before you,"},{"id":"manas-2010:p0788:b001:l039","ordinal":34896,"en":"If they fail to overcome the enemy,"},{"id":"manas-2010:p0788:b001:l040","ordinal":34897,"en":"Then take their eyes afterward."},{"id":"manas-2010:p0788:b001:l041","ordinal":34898,"en":"Let a shouting enemy come;"},{"id":"manas-2010:p0788:b001:l042","ordinal":34899,"en":"My generous one, while you are here,"},{"id":"manas-2010:p0789:b001:l001","ordinal":34900,"en":"We shall go forth before you to meet them;"},{"id":"manas-2010:p0789:b001:l002","ordinal":34901,"en":"The enemy who grapples with us,"},{"id":"manas-2010:p0789:b001:l003","ordinal":34902,"en":"We shall crush and drive into the earth."},{"id":"manas-2010:p0789:b001:l004","ordinal":34903,"en":"If by chance, leopard prince,"},{"id":"manas-2010:p0789:b001:l005","ordinal":34904,"en":"You find a fault in the forty champions,"},{"id":"manas-2010:p0789:b001:l006","ordinal":34905,"en":"When advancing into the enemy,"},{"id":"manas-2010:p0789:b001:l007","ordinal":34906,"en":"In a champion called a hero,"},{"id":"manas-2010:p0789:b001:l008","ordinal":34907,"en":"If you find a secret, evil intention,"},{"id":"manas-2010:p0789:b001:l009","ordinal":34908,"en":"Unleash a fierce slaughter."},{"id":"manas-2010:p0789:b001:l010","ordinal":34909,"en":"Make them stand in a row,"},{"id":"manas-2010:p0789:b001:l011","ordinal":34910,"en":"Those filthy dogs,"},{"id":"manas-2010:p0789:b001:l012","ordinal":34911,"en":"Cut off their heads with your sword!"},{"id":"manas-2010:p0789:b001:l013","ordinal":34912,"en":"These words you have spoken,"},{"id":"manas-2010:p0789:b001:l014","ordinal":34913,"en":"Leave them here upon this spot!’"},{"id":"manas-2010:p0789:b001:l015","ordinal":34914,"en":"Of wolf-maned champion Manas,"},{"id":"manas-2010:p0789:b001:l016","ordinal":34915,"en":"They understood his thirst for blood."},{"id":"manas-2010:p0789:b001:l017","ordinal":34916,"en":"All the forty champions,"},{"id":"manas-2010:p0789:b001:l018","ordinal":34917,"en":"And their aged leader Kyrgyl,"},{"id":"manas-2010:p0789:b001:l019","ordinal":34918,"en":"‘The bloodthirsty one is making them steadfast,’ they said,"},{"id":"manas-2010:p0789:b001:l020","ordinal":34919,"en":"‘The blessed schemer,’ they said,"},{"id":"manas-2010:p0789:b001:l021","ordinal":34920,"en":"‘When they enter against the foe,"},{"id":"manas-2010:p0789:b001:l022","ordinal":34921,"en":"Let the champions stand firm,’ he said,"},{"id":"manas-2010:p0789:b001:l023","ordinal":34922,"en":"‘Let them be equal to me,’ he said,"},{"id":"manas-2010:p0789:b001:l024","ordinal":34923,"en":"‘Let them camp along the river,’ he said."},{"id":"manas-2010:p0789:b001:l025","ordinal":34924,"en":"Did you see what he wished?"},{"id":"manas-2010:p0789:b001:l026","ordinal":34925,"en":"‘If you flee, I shall slaughter you,’ he said."},{"id":"manas-2010:p0789:b001:l027","ordinal":34926,"en":"The ill-omened bloodthirsty one,"},{"id":"manas-2010:p0789:b001:l028","ordinal":34927,"en":"Did you see how he drove them on?"},{"id":"manas-2010:p0789:b001:l029","ordinal":34928,"en":"The bloodthirsty one who ravaged China,"},{"id":"manas-2010:p0789:b001:l030","ordinal":34929,"en":"The schemer who knew all peoples,"},{"id":"manas-2010:p0789:b001:l031","ordinal":34930,"en":"For boundless heroism,"},{"id":"manas-2010:p0789:b001:l032","ordinal":34931,"en":"Did you see what he wished!"},{"id":"manas-2010:p0789:b001:l033","ordinal":34932,"en":"When they charged into the enemy,"},{"id":"manas-2010:p0789:b001:l034","ordinal":34933,"en":"So that not one would turn aside,"},{"id":"manas-2010:p0789:b001:l035","ordinal":34934,"en":"Did you see how he whetted them!"},{"id":"manas-2010:p0789:b001:l036","ordinal":34935,"en":"‘Let them be warriors beyond measure,’ he said."},{"id":"manas-2010:p0789:b001:l037","ordinal":34936,"en":"Did you see how he drove them on!"},{"id":"manas-2010:p0789:b001:l038","ordinal":34937,"en":"Turning them this way and that,"},{"id":"manas-2010:p0789:b001:l039","ordinal":34938,"en":"Did you see how he whetted them!"},{"id":"manas-2010:p0789:b001:l040","ordinal":34939,"en":"Hearing this, the forty champions"},{"id":"manas-2010:p0789:b001:l041","ordinal":34940,"en":"Swore an oath invoking God,"},{"id":"manas-2010:p0789:b001:l042","ordinal":34941,"en":"And made their promise firm,"},{"id":"manas-2010:p0790:b001:l001","ordinal":34942,"en":"Never to flee back from the enemy,"},{"id":"manas-2010:p0790:b001:l002","ordinal":34943,"en":"Never to shrink in fear of death,"},{"id":"manas-2010:p0790:b001:l003","ordinal":34944,"en":"Chewing white wheat flour,"},{"id":"manas-2010:p0790:b001:l004","ordinal":34945,"en":"The forty warriors stood in a row,"},{"id":"manas-2010:p0790:b001:l005","ordinal":34946,"en":"Holding the holy Quran."},{"id":"manas-2010:p0790:b001:l006","ordinal":34947,"en":"That Manas was truly Manas,"},{"id":"manas-2010:p0790:b001:l007","ordinal":34948,"en":"All the champions understood."},{"id":"manas-2010:p0790:b001:l008","ordinal":34949,"en":"Once they understood, they all"},{"id":"manas-2010:p0790:b001:l009","ordinal":34950,"en":"Smiled beneath their mustaches."},{"id":"manas-2010:p0790:b001:l010","ordinal":34951,"en":"Khan Manas's forty nobles,"},{"id":"manas-2010:p0790:b001:l011","ordinal":34952,"en":"Awed by the champion khan,"},{"id":"manas-2010:p0790:b001:l012","ordinal":34953,"en":"That would not tire in six months' riding,"},{"id":"manas-2010:p0790:b001:l013","ordinal":34954,"en":"All the choice wondrous steeds,"},{"id":"manas-2010:p0790:b001:l014","ordinal":34955,"en":"They saddled once again."},{"id":"manas-2010:p0790:b001:l015","ordinal":34956,"en":"They drew the rear girths tight,"},{"id":"manas-2010:p0790:b001:l016","ordinal":34957,"en":"And shortened the cruppers,"},{"id":"manas-2010:p0790:b001:l017","ordinal":34958,"en":"Drawing everything snug and taut."},{"id":"manas-2010:p0790:b001:l018","ordinal":34959,"en":"Each took a spear and moved apart."},{"id":"manas-2010:p0790:b001:l019","ordinal":34960,"en":"Their fierceness was terrible then,"},{"id":"manas-2010:p0790:b001:l020","ordinal":34961,"en":"Their dragon-like appearance showed."},{"id":"manas-2010:p0790:b001:l021","ordinal":34962,"en":"When the forty champions rode abreast,"},{"id":"manas-2010:p0790:b001:l022","ordinal":34963,"en":"Their right shoulders broad,"},{"id":"manas-2010:p0790:b001:l023","ordinal":34964,"en":"Their fierceness was extraordinary:"},{"id":"manas-2010:p0790:b001:l024","ordinal":34965,"en":"Lions who could ravage the world."},{"id":"manas-2010:p0790:b001:l025","ordinal":34966,"en":"If you saw the bearing of the heroes,"},{"id":"manas-2010:p0790:b001:l026","ordinal":34967,"en":"Of those who were his peers,"},{"id":"manas-2010:p0790:b001:l027","ordinal":34968,"en":"Argyn Khan's Azhybay,"},{"id":"manas-2010:p0790:b001:l028","ordinal":34969,"en":"When he rode in front, brought good fortune;"},{"id":"manas-2010:p0790:b001:l029","ordinal":34970,"en":"The rich man's son, Khan Bakay,"},{"id":"manas-2010:p0790:b001:l030","ordinal":34971,"en":"If you considered his worth,"},{"id":"manas-2010:p0790:b001:l031","ordinal":34972,"en":"When he rode behind, was like a vast army."},{"id":"manas-2010:p0790:b001:l032","ordinal":34973,"en":"Then the forty champions'"},{"id":"manas-2010:p0790:b001:l033","ordinal":34974,"en":"Shapes and stately bearing,"},{"id":"manas-2010:p0790:b001:l034","ordinal":34975,"en":"Their lion-like appearance showed,"},{"id":"manas-2010:p0790:b001:l035","ordinal":34976,"en":"Their posture upon horseback."},{"id":"manas-2010:p0790:b001:l036","ordinal":34977,"en":"The sight drew one's attention;"},{"id":"manas-2010:p0790:b001:l037","ordinal":34978,"en":"Their blood-drinking aspect showed."},{"id":"manas-2010:p0790:b001:l038","ordinal":34979,"en":"Then the forty champions,"},{"id":"manas-2010:p0790:b001:l039","ordinal":34980,"en":"Your valiant Sultan Manas"},{"id":"manas-2010:p0790:b001:l040","ordinal":34981,"en":"Studied and understood."},{"id":"manas-2010:p0790:b001:l041","ordinal":34982,"en":"Understanding then,"},{"id":"manas-2010:p0790:b001:l042","ordinal":34983,"en":"He smiled beneath his mustache."},{"id":"manas-2010:p0791:b001:l001","ordinal":34984,"en":"Hero Manas did not say aloud:"},{"id":"manas-2010:p0791:b001:l002","ordinal":34985,"en":"‘Their prowess is extraordinary;"},{"id":"manas-2010:p0791:b001:l003","ordinal":34986,"en":"The Creator has given my lone self"},{"id":"manas-2010:p0791:b001:l004","ordinal":34987,"en":"Companions, every one renowned!’"},{"id":"manas-2010:p0791:b001:l005","ordinal":34988,"en":"He rode a little farther;"},{"id":"manas-2010:p0791:b001:l006","ordinal":34989,"en":"Warrior Manas then,"},{"id":"manas-2010:p0791:b001:l007","ordinal":34990,"en":"To the forty champions themselves,"},{"id":"manas-2010:p0791:b001:l008","ordinal":34991,"en":"Again spoke stirring words."},{"id":"manas-2010:p0791:b001:l009","ordinal":34992,"en":"Turning like a lion,"},{"id":"manas-2010:p0791:b001:l010","ordinal":34993,"en":"Had you seen him then,"},{"id":"manas-2010:p0791:b001:l011","ordinal":34994,"en":"Gathering himself like a gray tiger,"},{"id":"manas-2010:p0791:b001:l012","ordinal":34995,"en":"Roaring in his fury,"},{"id":"manas-2010:p0791:b001:l013","ordinal":34996,"en":"Calling the forty champions:"},{"id":"manas-2010:p0791:b001:l014","ordinal":34997,"en":"‘What mountains lie ahead to cross?"},{"id":"manas-2010:p0791:b001:l015","ordinal":34998,"en":"What enemies, what foes?"},{"id":"manas-2010:p0791:b001:l016","ordinal":34999,"en":"My diviner Kara Tölög,"},{"id":"manas-2010:p0791:b001:l017","ordinal":35000,"en":"Cast your lots, let me see."},{"id":"manas-2010:p0791:b001:l018","ordinal":35001,"en":"Yraman's son Yrchy,"},{"id":"manas-2010:p0791:b001:l019","ordinal":35002,"en":"Sing here beside me."},{"id":"manas-2010:p0791:b001:l020","ordinal":35003,"en":"Akzholtoy, my champion backed by spirits,"},{"id":"manas-2010:p0791:b001:l021","ordinal":35004,"en":"Come to my side at once."},{"id":"manas-2010:p0791:b001:l022","ordinal":35005,"en":"Hero Bakay, saintly elder,"},{"id":"manas-2010:p0791:b001:l023","ordinal":35006,"en":"Guide us with your own knowledge!’"},{"id":"manas-2010:p0791:b001:l024","ordinal":35007,"en":"His diviner Kara Tölög"},{"id":"manas-2010:p0791:b001:l025","ordinal":35008,"en":"Now cast his lots."},{"id":"manas-2010:p0791:b001:l026","ordinal":35009,"en":"Tölög rose and said:"},{"id":"manas-2010:p0791:b001:l027","ordinal":35010,"en":"‘Against Shooruk, whose grief is costly,"},{"id":"manas-2010:p0791:b001:l028","ordinal":35011,"en":"You have waged a mighty struggle."},{"id":"manas-2010:p0791:b001:l029","ordinal":35012,"en":"Her waist like a sheath, her face like the moon,"},{"id":"manas-2010:p0791:b001:l030","ordinal":35013,"en":"His daughter renowned for beauty,"},{"id":"manas-2010:p0791:b001:l031","ordinal":35014,"en":"You have taken as a bride."},{"id":"manas-2010:p0791:b001:l032","ordinal":35015,"en":"Living beings gather in your shade;"},{"id":"manas-2010:p0791:b001:l033","ordinal":35016,"en":"You have become a mighty poplar!’"},{"id":"manas-2010:p0791:b001:l034","ordinal":35017,"en":"When the diviner said this,"},{"id":"manas-2010:p0791:b001:l035","ordinal":35018,"en":"Yraman's son Yrchy"},{"id":"manas-2010:p0791:b001:l036","ordinal":35019,"en":"Stood singing beside him."},{"id":"manas-2010:p0791:b001:l037","ordinal":35020,"en":"Of six months' hardship ahead,"},{"id":"manas-2010:p0791:b001:l038","ordinal":35021,"en":"Who could tell at once,"},{"id":"manas-2010:p0791:b001:l039","ordinal":35022,"en":"Wise Bakay was at their head."},{"id":"manas-2010:p0791:b001:l040","ordinal":35023,"en":"‘The land is hot, an utter desert;"},{"id":"manas-2010:p0791:b001:l041","ordinal":35024,"en":"There is no such place in the world."},{"id":"manas-2010:p0791:b001:l042","ordinal":35025,"en":"Let us besiege his city,"},{"id":"manas-2010:p0792:b001:l001","ordinal":35026,"en":"Let us bind his warrior,"},{"id":"manas-2010:p0792:b001:l002","ordinal":35027,"en":"Let us all charge with a shout,"},{"id":"manas-2010:p0792:b001:l003","ordinal":35028,"en":"And overrun his city."},{"id":"manas-2010:p0792:b001:l004","ordinal":35029,"en":"I hear from those who know,"},{"id":"manas-2010:p0792:b001:l005","ordinal":35030,"en":"This Khan Shooruk here,"},{"id":"manas-2010:p0792:b001:l006","ordinal":35031,"en":"I hear, is an unbeliever in faith.’"},{"id":"manas-2010:p0792:b001:l007","ordinal":35032,"en":"A standard swayed in his hand;"},{"id":"manas-2010:p0792:b001:l008","ordinal":35033,"en":"Your elder Khan Bakay led the way."},{"id":"manas-2010:p0792:b001:l009","ordinal":35034,"en":"Among spear-fighters, Bakay's"},{"id":"manas-2010:p0792:b001:l010","ordinal":35035,"en":"Skill was truly proven."},{"id":"manas-2010:p0792:b001:l011","ordinal":35036,"en":"Who knew the enemy's stratagems well,"},{"id":"manas-2010:p0792:b001:l012","ordinal":35037,"en":"Your champion elder Bakay's"},{"id":"manas-2010:p0792:b001:l013","ordinal":35038,"en":"Strength was truly proven."},{"id":"manas-2010:p0792:b001:l014","ordinal":35039,"en":"Finding a path through thickets,"},{"id":"manas-2010:p0792:b001:l015","ordinal":35040,"en":"Boundless Bakay's"},{"id":"manas-2010:p0792:b001:l016","ordinal":35041,"en":"Boldness was truly proven."},{"id":"manas-2010:p0792:b001:l017","ordinal":35042,"en":"Finding a stratagem where none seemed possible,"},{"id":"manas-2010:p0792:b001:l018","ordinal":35043,"en":"His resourcefulness was truly proven."},{"id":"manas-2010:p0792:b001:l019","ordinal":35044,"en":"All were renowned wondrous steeds;"},{"id":"manas-2010:p0792:b001:l020","ordinal":35045,"en":"The ground beneath them crumbled."},{"id":"manas-2010:p0792:b001:l021","ordinal":35046,"en":"Like a low-lying fog then,"},{"id":"manas-2010:p0792:b001:l022","ordinal":35047,"en":"Dust billowed behind them."},{"id":"manas-2010:p0792:b001:l023","ordinal":35048,"en":"Traveling without sparing horses,"},{"id":"manas-2010:p0792:b001:l024","ordinal":35049,"en":"Traveling far without sparing themselves,"},{"id":"manas-2010:p0792:b001:l025","ordinal":35050,"en":"How could your heroes hold back?"},{"id":"manas-2010:p0792:b001:l026","ordinal":35051,"en":"The yellow plain lay under haze;"},{"id":"manas-2010:p0792:b001:l027","ordinal":35052,"en":"Reaching the yellow plain,"},{"id":"manas-2010:p0792:b001:l028","ordinal":35053,"en":"He turned his wondrous steed's head,"},{"id":"manas-2010:p0792:b001:l029","ordinal":35054,"en":"And stood looking across."},{"id":"manas-2010:p0792:b001:l030","ordinal":35055,"en":"When he looked ahead,"},{"id":"manas-2010:p0792:b001:l031","ordinal":35056,"en":"Shapes loomed angular in the haze;"},{"id":"manas-2010:p0792:b001:l032","ordinal":35057,"en":"The murk beyond the reach of sight"},{"id":"manas-2010:p0792:b001:l033","ordinal":35058,"en":"Stretched into jutting corners."},{"id":"manas-2010:p0792:b001:l034","ordinal":35059,"en":"When he looked this way,"},{"id":"manas-2010:p0792:b001:l035","ordinal":35060,"en":"It was an upland where no owl flew,"},{"id":"manas-2010:p0792:b001:l036","ordinal":35061,"en":"Where no mortal made a home,"},{"id":"manas-2010:p0792:b001:l037","ordinal":35062,"en":"A place where unseen beings roamed."},{"id":"manas-2010:p0792:b001:l038","ordinal":35063,"en":"In scattered patches"},{"id":"manas-2010:p0792:b001:l039","ordinal":35064,"en":"Strange groves had sprung up;"},{"id":"manas-2010:p0792:b001:l040","ordinal":35065,"en":"When they went in among them,"},{"id":"manas-2010:p0792:b001:l041","ordinal":35066,"en":"There were creatures called kangaroos too."},{"id":"manas-2010:p0792:b001:l042","ordinal":35067,"en":"Beginning with corsac foxes on the plain,"},{"id":"manas-2010:p0793:b001:l001","ordinal":35068,"en":"Every kind of animal was there."},{"id":"manas-2010:p0793:b001:l002","ordinal":35069,"en":"It was a place lying free;"},{"id":"manas-2010:p0793:b001:l003","ordinal":35070,"en":"The name of that plain"},{"id":"manas-2010:p0793:b001:l004","ordinal":35071,"en":"Was Adam-Barbas, Where No Man Goes."},{"id":"manas-2010:p0793:b001:l005","ordinal":35072,"en":"Its lizards and snakes"}]
