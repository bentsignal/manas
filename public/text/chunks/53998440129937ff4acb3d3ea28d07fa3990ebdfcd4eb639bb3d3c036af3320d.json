[{"id":"sayakbay-ms-current144:pdf152:l002","ordinal":392449,"en":"Sending his wrestlers without allowing retreat,"},{"id":"sayakbay-ms-current144:pdf152:l003","ordinal":392450,"en":"[Beyond the whole world itself],"},{"id":"sayakbay-ms-current144:pdf152:l004","ordinal":392451,"en":"He had raised his conflict."},{"id":"sayakbay-ms-current144:pdf152:l005","ordinal":392452,"en":"Great Bilgich, rich in wisdom,"},{"id":"sayakbay-ms-current144:pdf152:l006","ordinal":392453,"en":"Had prepared his wrestlers."},{"id":"sayakbay-ms-current144:pdf152:l007","ordinal":392454,"en":"Such were those wrestlers,"},{"id":"sayakbay-ms-current144:pdf152:l008","ordinal":392455,"en":"[Dark guns, dark strength],"},{"id":"sayakbay-ms-current144:pdf152:l009","ordinal":392456,"en":"They never shrank from blood,"},{"id":"sayakbay-ms-current144:pdf152:l010","ordinal":392457,"en":"When a great enemy roared,"},{"id":"sayakbay-ms-current144:pdf152:l011","ordinal":392458,"en":"They never recoiled from fire,"},{"id":"sayakbay-ms-current144:pdf152:l012","ordinal":392459,"en":"None could overpower them in a grapple,"},{"id":"sayakbay-ms-current144:pdf152:l013","ordinal":392460,"en":"Once their commander gave an order,"},{"id":"sayakbay-ms-current144:pdf152:l014","ordinal":392461,"en":"They would die rather than abandon it."},{"id":"sayakbay-ms-current144:pdf152:l015","ordinal":392462,"en":"[Hard and blue as blue iron],"},{"id":"sayakbay-ms-current144:pdf152:l016","ordinal":392463,"en":"Utterly firm in their promises,"},{"id":"sayakbay-ms-current144:pdf152:l017","ordinal":392464,"en":"[Those skilled at close grappling],"},{"id":"sayakbay-ms-current144:pdf152:l018","ordinal":392465,"en":"The finest at shedding blood,"},{"id":"sayakbay-ms-current144:pdf152:l019","ordinal":392466,"en":"Those asking where disaster lay,"},{"id":"sayakbay-ms-current144:pdf152:l020","ordinal":392467,"en":"If Ak Joltoy fell into their hands,"},{"id":"sayakbay-ms-current144:pdf152:l021","ordinal":392468,"en":"They would eat him raw."},{"id":"sayakbay-ms-current144:pdf152:l022","ordinal":392469,"en":"The warrior's name was Great Balban."},{"id":"sayakbay-ms-current144:pdf152:l023","ordinal":392470,"en":"For the lone champion Joltoy,"},{"id":"sayakbay-ms-current144:pdf152:l024","ordinal":392471,"en":"The great conflict became a burden."},{"id":"sayakbay-ms-current144:pdf152:l025","ordinal":392472,"en":"The wrestlers roared,"},{"id":"sayakbay-ms-current144:pdf152:l026","ordinal":392473,"en":"[With a battle cry, they bent him],"},{"id":"sayakbay-ms-current144:pdf152:l027","ordinal":392474,"en":"[Charging at the order to overwhelm him],"},{"id":"sayakbay-ms-current144:pdf152:l028","ordinal":392475,"en":"[The wrestlers who had not yet swarmed]."},{"id":"sayakbay-ms-current144:pdf153:l001","ordinal":392476,"en":"[There is sorrow within me]."},{"id":"sayakbay-ms-current144:pdf153:l002","ordinal":392477,"en":"The great rhinoceros-steed beneath him,"},{"id":"sayakbay-ms-current144:pdf153:l003","ordinal":392478,"en":"[The mule's foal collapsed],"},{"id":"sayakbay-ms-current144:pdf153:l005","ordinal":392479,"en":"Only a spoonful of blood remained."},{"id":"sayakbay-ms-current144:pdf153:l007","ordinal":392480,"en":"[His sinews were torn apart],"},{"id":"sayakbay-ms-current144:pdf153:l008","ordinal":392481,"en":"[My eyes have become flattened],"},{"id":"sayakbay-ms-current144:pdf153:l009","ordinal":392482,"en":"[I myself have become bent],"},{"id":"sayakbay-ms-current144:pdf153:l011","ordinal":392483,"en":"My ribs are shattered and cracking,"},{"id":"sayakbay-ms-current144:pdf153:l013","ordinal":392484,"en":"[Parted from my warrior],"},{"id":"sayakbay-ms-current144:pdf153:l016","ordinal":392485,"en":"[Seeking a distant place],"},{"id":"sayakbay-ms-current144:pdf153:l017","ordinal":392486,"en":"The wide world has grown narrow,"},{"id":"sayakbay-ms-current144:pdf153:l018","ordinal":392487,"en":"[No sustenance helps me stand],"},{"id":"sayakbay-ms-current144:pdf153:l019","ordinal":392488,"en":"Yearning for a single swallow."},{"id":"sayakbay-ms-current144:pdf153:l020","ordinal":392489,"en":"My efforts exhausted, my strength gone,"},{"id":"sayakbay-ms-current144:pdf153:l023","ordinal":392490,"en":"Swarm him and thrust your spears,"},{"id":"sayakbay-ms-current144:pdf153:l024","ordinal":392491,"en":"That bastard Joltoy,"},{"id":"sayakbay-ms-current144:pdf153:l026","ordinal":392492,"en":"[Tear all the curs apart],"},{"id":"sayakbay-ms-current144:pdf153:l027","ordinal":392493,"en":"[Scatter them and burn their roots]."},{"id":"sayakbay-ms-current144:pdf154:l002","ordinal":392494,"en":"[Place his punishment in our hands]."},{"id":"sayakbay-ms-current144:pdf154:l003","ordinal":392495,"en":"Of the lone scourge Joltoy,"},{"id":"sayakbay-ms-current144:pdf154:l004","ordinal":392496,"en":"[Make his strides stretch wide]."},{"id":"sayakbay-ms-current144:pdf154:l005","ordinal":392497,"en":"Your elder Bilgich,"},{"id":"sayakbay-ms-current144:pdf154:l006","ordinal":392498,"en":"From the tormenting hell he has met,"},{"id":"sayakbay-ms-current144:pdf154:l007","ordinal":392499,"en":"Rescue him."},{"id":"sayakbay-ms-current144:pdf154:l012","ordinal":392500,"en":"That he was suffering severe hardship,"},{"id":"sayakbay-ms-current144:pdf154:l014","ordinal":392501,"en":"Would the wrestlers stand without attacking?"},{"id":"sayakbay-ms-current144:pdf154:l017","ordinal":392502,"en":"Would they refrain from swarming?"},{"id":"sayakbay-ms-current144:pdf154:l018","ordinal":392503,"en":"[The wretches had death in their eyes],"},{"id":"sayakbay-ms-current144:pdf154:l019","ordinal":392504,"en":"The bloodthirsty troops attacked together,"},{"id":"sayakbay-ms-current144:pdf154:l020","ordinal":392505,"en":"Against the chief warrior Joltoy,"},{"id":"sayakbay-ms-current144:pdf154:l021","ordinal":392506,"en":"[The lord vanished, coming out straight],"},{"id":"sayakbay-ms-current144:pdf154:l022","ordinal":392507,"en":"That was the moment of the great struggle."},{"id":"sayakbay-ms-current144:pdf154:l023","ordinal":392508,"en":"Such was the course of the fight."},{"id":"sayakbay-ms-current144:pdf154:l027","ordinal":392509,"en":"Who began a furious conflict,"},{"id":"sayakbay-ms-current144:pdf155:l002","ordinal":392510,"en":"[A great tumult of hacking and cutting],"},{"id":"sayakbay-ms-current144:pdf155:l003","ordinal":392511,"en":"[The mighty wrestler began],"},{"id":"sayakbay-ms-current144:pdf155:l005","ordinal":392512,"en":"The wrestlers began their battle."},{"id":"sayakbay-ms-current144:pdf155:l006","ordinal":392513,"en":"Against the lone warrior Joltoy,"},{"id":"sayakbay-ms-current144:pdf155:l007","ordinal":392514,"en":"[Against the champion in woven armor],"},{"id":"sayakbay-ms-current144:pdf155:l009","ordinal":392515,"en":"Standing face to face,"},{"id":"sayakbay-ms-current144:pdf155:l010","ordinal":392516,"en":"Firing guns and drawing bows,"},{"id":"sayakbay-ms-current144:pdf155:l011","ordinal":392517,"en":"Fighting with clattering blows,"},{"id":"sayakbay-ms-current144:pdf155:l013","ordinal":392518,"en":"Their Bilgich, who was nearly lost,"},{"id":"sayakbay-ms-current144:pdf155:l017","ordinal":392519,"en":"Could there be such torment?"},{"id":"sayakbay-ms-current144:pdf155:l019","ordinal":392520,"en":"[Chest, battered by their blows],"},{"id":"sayakbay-ms-current144:pdf155:l020","ordinal":392521,"en":"Drawing bows, making rain,"},{"id":"sayakbay-ms-current144:pdf155:l021","ordinal":392522,"en":"Shooting bullets like hail,"},{"id":"sayakbay-ms-current144:pdf155:l022","ordinal":392523,"en":"Thrusting spears and striking axes,"},{"id":"sayakbay-ms-current144:pdf155:l023","ordinal":392524,"en":"[Pressing him with grievous strife],"},{"id":"sayakbay-ms-current144:pdf155:l024","ordinal":392525,"en":"Your fearless elder Joltoy,"},{"id":"sayakbay-ms-current144:pdf155:l025","ordinal":392526,"en":"[Attacking without waiting his turn],"},{"id":"sayakbay-ms-current144:pdf155:l026","ordinal":392527,"en":"[His eyes clouded and bound],"},{"id":"sayakbay-ms-current144:pdf155:l027","ordinal":392528,"en":"If you saw it, this was dire hardship."},{"id":"sayakbay-ms-current144:pdf156:l002","ordinal":392529,"en":"Kulan Sur beneath him,"},{"id":"sayakbay-ms-current144:pdf156:l004","ordinal":392530,"en":"Though an animal, this creature,"},{"id":"sayakbay-ms-current144:pdf156:l005","ordinal":392531,"en":"[Stood firm against the danger],"},{"id":"sayakbay-ms-current144:pdf156:l007","ordinal":392532,"en":"[Knowing it, he darted aside],"},{"id":"sayakbay-ms-current144:pdf156:l011","ordinal":392533,"en":"Who had seen such an ordeal?"},{"id":"sayakbay-ms-current144:pdf156:l012","ordinal":392534,"en":"[His precious body full of holes],"},{"id":"sayakbay-ms-current144:pdf156:l013","ordinal":392535,"en":"A disastrous, grievous, great conflict,"},{"id":"sayakbay-ms-current144:pdf156:l015","ordinal":392536,"en":"[All the blood washed away],"},{"id":"sayakbay-ms-current144:pdf156:l016","ordinal":392537,"en":"All his clothing torn,"},{"id":"sayakbay-ms-current144:pdf156:l017","ordinal":392538,"en":"Iron ropes and little nets,"},{"id":"sayakbay-ms-current144:pdf156:l018","ordinal":392539,"en":"When they cast their nets together,"},{"id":"sayakbay-ms-current144:pdf156:l019","ordinal":392540,"en":"[Armored wrestler] Great Bilgich,"},{"id":"sayakbay-ms-current144:pdf156:l020","ordinal":392541,"en":"Urged on many wrestlers,"},{"id":"sayakbay-ms-current144:pdf156:l021","ordinal":392542,"en":"Bringing great conflict upon Joltoy."},{"id":"sayakbay-ms-current144:pdf156:l022","ordinal":392543,"en":"As Joltoy was about to depart,"},{"id":"sayakbay-ms-current144:pdf156:l023","ordinal":392544,"en":"As his death was about to arrive,"},{"id":"sayakbay-ms-current144:pdf156:l024","ordinal":392545,"en":"More and more, Bilgich's,"},{"id":"sayakbay-ms-current144:pdf156:l025","ordinal":392546,"en":"Marksmanship grew fiercer,"},{"id":"sayakbay-ms-current144:pdf156:l026","ordinal":392547,"en":"Hastening in the direction he faced,"},{"id":"sayakbay-ms-current144:pdf156:l027","ordinal":392548,"en":"When he brought unending hardship,"},{"id":"sayakbay-ms-current144:pdf156:l028","ordinal":392549,"en":"The renowned wondrous steed Kulan Sur,"},{"id":"sayakbay-ms-current144:pdf157:l002","ordinal":392550,"en":"[Across the wide-open charge],"},{"id":"sayakbay-ms-current144:pdf157:l003","ordinal":392551,"en":"[How could the courser break away],"},{"id":"sayakbay-ms-current144:pdf157:l004","ordinal":392552,"en":"[With a stone ridge ahead],"},{"id":"sayakbay-ms-current144:pdf157:l005","ordinal":392553,"en":"It was a path for a single horse."},{"id":"sayakbay-ms-current144:pdf157:l006","ordinal":392554,"en":"Your elder Joltoy was trapped,"},{"id":"sayakbay-ms-current144:pdf157:l007","ordinal":392555,"en":"Wedged within their encirclement,"},{"id":"sayakbay-ms-current144:pdf157:l011","ordinal":392556,"en":"This world is a merchant,"},{"id":"sayakbay-ms-current144:pdf157:l012","ordinal":392557,"en":"Its falsehood became apparent."},{"id":"sayakbay-ms-current144:pdf157:l013","ordinal":392558,"en":"When the wrestlers stood surrounding him,"},{"id":"sayakbay-ms-current144:pdf157:l014","ordinal":392559,"en":"[No hope for his flylike life],"},{"id":"sayakbay-ms-current144:pdf157:l015","ordinal":392560,"en":"[The reason it had vanished],"},{"id":"sayakbay-ms-current144:pdf157:l016","ordinal":392561,"en":"The two arms that gave him strength,"},{"id":"sayakbay-ms-current144:pdf157:l017","ordinal":392562,"en":"Were motionless and paralyzed."},{"id":"sayakbay-ms-current144:pdf157:l018","ordinal":392563,"en":"His precious head, his support for standing,"},{"id":"sayakbay-ms-current144:pdf157:l019","ordinal":392564,"en":"Became a red bucket of blood."},{"id":"sayakbay-ms-current144:pdf157:l020","ordinal":392565,"en":"His entire body,"},{"id":"sayakbay-ms-current144:pdf157:l021","ordinal":392566,"en":"Was motionless and paralyzed."},{"id":"sayakbay-ms-current144:pdf157:l022","ordinal":392567,"en":"The dear white-capped Kyrgyz people,"},{"id":"sayakbay-ms-current144:pdf157:l024","ordinal":392568,"en":"Looking around, there was no mountain,"},{"id":"sayakbay-ms-current144:pdf157:l025","ordinal":392569,"en":"[No company to march with],"},{"id":"sayakbay-ms-current144:pdf157:l026","ordinal":392570,"en":"[The five could not advance],"},{"id":"sayakbay-ms-current144:pdf157:l028","ordinal":392571,"en":"His dear warrior Seitek was absent,"},{"id":"sayakbay-ms-current144:pdf158:l001","ordinal":392572,"en":"[Chinese bones from the earth],"},{"id":"sayakbay-ms-current144:pdf158:l002","ordinal":392573,"en":"[Will they be buried together],"},{"id":"sayakbay-ms-current144:pdf158:l003","ordinal":392574,"en":"Ak Joltoy, a champion of honor,"},{"id":"sayakbay-ms-current144:pdf158:l004","ordinal":392575,"en":"God decreed this for him."},{"id":"sayakbay-ms-current144:pdf158:l006","ordinal":392576,"en":"Will he see a way back?"},{"id":"sayakbay-ms-current144:pdf158:l007","ordinal":392577,"en":"[Do not exhaust your soul with stratagems],"},{"id":"sayakbay-ms-current144:pdf158:l008","ordinal":392578,"en":"[Will he die at your feet],"},{"id":"sayakbay-ms-current144:pdf158:l009","ordinal":392579,"en":"Biting their fingers and shaking their heads,"},{"id":"sayakbay-ms-current144:pdf158:l011","ordinal":392580,"en":"[Alas, let me confront this age],"},{"id":"sayakbay-ms-current144:pdf158:l013","ordinal":392581,"en":"[Meeting with calamity],"},{"id":"sayakbay-ms-current144:pdf158:l014","ordinal":392582,"en":"Will your death arrive on the road?"},{"id":"sayakbay-ms-current144:pdf158:l015","ordinal":392583,"en":"These Chinese who became enemies,"},{"id":"sayakbay-ms-current144:pdf158:l016","ordinal":392584,"en":"[Will they kill him so easily]?"},{"id":"sayakbay-ms-current144:pdf158:l019","ordinal":392585,"en":"[Weakening, saying none remained standing],"},{"id":"sayakbay-ms-current144:pdf158:l020","ordinal":392586,"en":"As Joltoy stood [dazed],"},{"id":"sayakbay-ms-current144:pdf158:l021","ordinal":392587,"en":"The hero's son, warrior Seitek,"},{"id":"sayakbay-ms-current144:pdf158:l022","ordinal":392588,"en":"Unable to turn Kulunsur's head,"},{"id":"sayakbay-ms-current144:pdf158:l023","ordinal":392589,"en":"May God protect him!"},{"id":"sayakbay-ms-current144:pdf158:l024","ordinal":392590,"en":"Saying, where is Joltoy, my joy?"},{"id":"sayakbay-ms-current144:pdf158:l025","ordinal":392591,"en":"[The fierce warrior could not stand still],"},{"id":"sayakbay-ms-current144:pdf158:l026","ordinal":392592,"en":"[Wearing a golden robe],"},{"id":"sayakbay-ms-current144:pdf158:l027","ordinal":392593,"en":"Riding a pale gray horse like water,"},{"id":"sayakbay-ms-current144:pdf159:l001","ordinal":392594,"en":"Traveling day and night,"},{"id":"sayakbay-ms-current144:pdf159:l002","ordinal":392595,"en":"Wearing out his horse, traversing the land,"},{"id":"sayakbay-ms-current144:pdf159:l004","ordinal":392596,"en":"[Readying what he would shoot],"},{"id":"sayakbay-ms-current144:pdf159:l005","ordinal":392597,"en":"[Finding a pass among cliffs and hills],"},{"id":"sayakbay-ms-current144:pdf159:l006","ordinal":392598,"en":"[Rattling the horse's harness],"},{"id":"sayakbay-ms-current144:pdf159:l009","ordinal":392599,"en":"Muttering and rumbling,"},{"id":"sayakbay-ms-current144:pdf159:l010","ordinal":392600,"en":"[Changing as his horse grew weary],"},{"id":"sayakbay-ms-current144:pdf159:l012","ordinal":392601,"en":"To reach the distant figure,"},{"id":"sayakbay-ms-current144:pdf159:l013","ordinal":392602,"en":"Asking whether he was dead or alive,"},{"id":"sayakbay-ms-current144:pdf159:l015","ordinal":392603,"en":"The straight road of their pursuit,"},{"id":"sayakbay-ms-current144:pdf159:l016","ordinal":392604,"en":"[The poor man estimated its direction],"},{"id":"sayakbay-ms-current144:pdf159:l017","ordinal":392605,"en":"[My cherished] Ak Joltoy,"},{"id":"sayakbay-ms-current144:pdf159:l019","ordinal":392606,"en":"[Making trouble over carrying and binding],"},{"id":"sayakbay-ms-current144:pdf159:l020","ordinal":392607,"en":"[Hoping to reach one elder],"},{"id":"sayakbay-ms-current144:pdf159:l023","ordinal":392608,"en":"[The dear one stood astray],"},{"id":"sayakbay-ms-current144:pdf159:l024","ordinal":392609,"en":"[Your courser, straight from its origin],"},{"id":"sayakbay-ms-current144:pdf159:l025","ordinal":392610,"en":"[Protecting the people against invading foes],"},{"id":"sayakbay-ms-current144:pdf159:l026","ordinal":392611,"en":"Saying, the only one left by your father,"},{"id":"sayakbay-ms-current144:pdf159:l027","ordinal":392612,"en":"[My dear lord] Ak Joltoy,"},{"id":"sayakbay-ms-current144:pdf159:l028","ordinal":392613,"en":"[Thinking of his dear fierce warrior],"},{"id":"sayakbay-ms-current144:pdf160:l001","ordinal":392614,"en":"The reason Ak Joltoy was admirable,"},{"id":"sayakbay-ms-current144:pdf160:l002","ordinal":392615,"en":"His eyes saw from afar,"},{"id":"sayakbay-ms-current144:pdf160:l003","ordinal":392616,"en":"When great difficulty in word or deed arose,"},{"id":"sayakbay-ms-current144:pdf160:l004","ordinal":392617,"en":"Coming out alone from the contest,"},{"id":"sayakbay-ms-current144:pdf160:l006","ordinal":392618,"en":"His courage was the finest."},{"id":"sayakbay-ms-current144:pdf160:l007","ordinal":392619,"en":"He went without sparing his life, I say."},{"id":"sayakbay-ms-current144:pdf160:l010","ordinal":392620,"en":"He went as far as the khagan, I say."},{"id":"sayakbay-ms-current144:pdf160:l011","ordinal":392621,"en":"He was born to be a protector,"},{"id":"sayakbay-ms-current144:pdf160:l013","ordinal":392622,"en":"[He was the dear people's fortress],"},{"id":"sayakbay-ms-current144:pdf160:l015","ordinal":392623,"en":"[If a giant encircled them],"},{"id":"sayakbay-ms-current144:pdf160:l016","ordinal":392624,"en":"At the moment of clashing,"},{"id":"sayakbay-ms-current144:pdf160:l019","ordinal":392625,"en":"You who created people as living souls,"},{"id":"sayakbay-ms-current144:pdf160:l020","ordinal":392626,"en":"God, please protect Joltoy."},{"id":"sayakbay-ms-current144:pdf160:l021","ordinal":392627,"en":"[Joltoy was the eyes of many],"},{"id":"sayakbay-ms-current144:pdf160:l022","ordinal":392628,"en":"[He was the true inheritance itself],"},{"id":"sayakbay-ms-current144:pdf160:l026","ordinal":392629,"en":"God, please protect Joltoy,"},{"id":"sayakbay-ms-current144:pdf161:l001","ordinal":392630,"en":"Is the valiant Bermet a bad man?"},{"id":"sayakbay-ms-current144:pdf161:l002","ordinal":392631,"en":"The five youths said that Seitek was steadfast."},{"id":"sayakbay-ms-current144:pdf161:l003","ordinal":392632,"en":"You know the measure of his strength."},{"id":"sayakbay-ms-current144:pdf161:l004","ordinal":392633,"en":"At the white horde of his in-laws,"},{"id":"sayakbay-ms-current144:pdf161:l005","ordinal":392634,"en":"he drove the rear of the thousand onward."},{"id":"sayakbay-ms-current144:pdf161:l006","ordinal":392635,"en":"If the rumor about five thousand is true,"},{"id":"sayakbay-ms-current144:pdf161:l007","ordinal":392636,"en":"at dawn, in the year of the camel,"},{"id":"sayakbay-ms-current144:pdf161:l008","ordinal":392637,"en":"making sport with his words,"},{"id":"sayakbay-ms-current144:pdf161:l009","ordinal":392638,"en":"he stands demanding blood-price."},{"id":"sayakbay-ms-current144:pdf161:l010","ordinal":392639,"en":"There is no commoner left to seize."},{"id":"sayakbay-ms-current144:pdf161:l011","ordinal":392640,"en":"“Take hold and surrender me,” he said."},{"id":"sayakbay-ms-current144:pdf161:l012","ordinal":392641,"en":"he makes that his obligation."},{"id":"sayakbay-ms-current144:pdf161:l013","ordinal":392642,"en":"With no supporting host, the poor giant,"},{"id":"sayakbay-ms-current144:pdf161:l015","ordinal":392643,"en":"He stands demanding his blood-price."},{"id":"sayakbay-ms-current144:pdf161:l016","ordinal":392644,"en":"Has God taken Joltoy?"},{"id":"sayakbay-ms-current144:pdf161:l017","ordinal":392645,"en":"So spoke the hero Kunus,"},{"id":"sayakbay-ms-current144:pdf161:l018","ordinal":392646,"en":"that lion-hearted man who did not flinch,"},{"id":"sayakbay-ms-current144:pdf161:l020","ordinal":392647,"en":"Beneath him was the bay Kunan-sur."},{"id":"sayakbay-ms-current144:pdf161:l022","ordinal":392648,"en":"The sandy-colored creature was like shifting sand."},{"id":"sayakbay-ms-current144:pdf161:l023","ordinal":392649,"en":"He swept over the earth like a whirlwind."},{"id":"sayakbay-ms-current144:pdf161:l024","ordinal":392650,"en":"At the mouth of the dark ridge,"},{"id":"sayakbay-ms-current144:pdf161:l025","ordinal":392651,"en":"its hoofbeats clattered like a bell."},{"id":"sayakbay-ms-current144:pdf161:l026","ordinal":392652,"en":"It scorched the stones as though they were silk."},{"id":"sayakbay-ms-current144:pdf161:l027","ordinal":392653,"en":"The beast streamed onward, its soles pounding."},{"id":"sayakbay-ms-current144:pdf162:l001","ordinal":392654,"en":"He galloped until the land turned gray."},{"id":"sayakbay-ms-current144:pdf162:l002","ordinal":392655,"en":"He braced for battle like a spear."},{"id":"sayakbay-ms-current144:pdf162:l003","ordinal":392656,"en":"Across the three branches of the dark earth,"},{"id":"sayakbay-ms-current144:pdf162:l004","ordinal":392657,"en":"the great beast strode swiftly."},{"id":"sayakbay-ms-current144:pdf162:l005","ordinal":392658,"en":"they seemed to have been driven apart."},{"id":"sayakbay-ms-current144:pdf162:l006","ordinal":392659,"en":"Its chest rose like a steep cliff."},{"id":"sayakbay-ms-current144:pdf162:l007","ordinal":392660,"en":"It made the falcon cry out against the rock."},{"id":"sayakbay-ms-current144:pdf162:l008","ordinal":392661,"en":"Without stopping, it ran with a piercing rush."},{"id":"sayakbay-ms-current144:pdf162:l009","ordinal":392662,"en":"A mirage wavered along its road."},{"id":"sayakbay-ms-current144:pdf162:l010","ordinal":392663,"en":"The eagle in the sky"},{"id":"sayakbay-ms-current144:pdf162:l011","ordinal":392664,"en":"appeared as though there were two of them."},{"id":"sayakbay-ms-current144:pdf162:l012","ordinal":392665,"en":"the flowers that Bermet had given"},{"id":"sayakbay-ms-current144:pdf162:l013","ordinal":392666,"en":"looked like the water of paradise."},{"id":"sayakbay-ms-current144:pdf162:l015","ordinal":392667,"en":"he pressed onward with renown."},{"id":"sayakbay-ms-current144:pdf162:l016","ordinal":392668,"en":"Alas, the hero whose father was a khan,"},{"id":"sayakbay-ms-current144:pdf162:l017","ordinal":392669,"en":"shook the whole bright world."},{"id":"sayakbay-ms-current144:pdf162:l019","ordinal":392670,"en":"A mass gathered upon the yellow trail."},{"id":"sayakbay-ms-current144:pdf162:l020","ordinal":392671,"en":"Red was mingled into the yellow."},{"id":"sayakbay-ms-current144:pdf162:l021","ordinal":392672,"en":"A throng gathered on the autumn-colored track."},{"id":"sayakbay-ms-current144:pdf162:l022","ordinal":392673,"en":"They left behind dry sand."},{"id":"sayakbay-ms-current144:pdf162:l023","ordinal":392674,"en":"The mountain road became straight."},{"id":"sayakbay-ms-current144:pdf162:l024","ordinal":392675,"en":"This deed became a torment."},{"id":"sayakbay-ms-current144:pdf162:l025","ordinal":392676,"en":"The fierce one at the pass met the enemy."},{"id":"sayakbay-ms-current144:pdf162:l026","ordinal":392677,"en":"Nine tracks showed the shapes of living men."},{"id":"sayakbay-ms-current144:pdf162:l027","ordinal":392678,"en":"It was to become a great quagmire."},{"id":"sayakbay-ms-current144:pdf163:l001","ordinal":392679,"en":"White foam mingled with the sunlight."},{"id":"sayakbay-ms-current144:pdf163:l002","ordinal":392680,"en":"Seitek’s thirty champions"},{"id":"sayakbay-ms-current144:pdf163:l003","ordinal":392681,"en":"fought upon the open slope."},{"id":"sayakbay-ms-current144:pdf163:l004","ordinal":392682,"en":"They formed a rear guard along the ridge."},{"id":"sayakbay-ms-current144:pdf163:l005","ordinal":392683,"en":"Fearlessly they traveled the road."},{"id":"sayakbay-ms-current144:pdf163:l006","ordinal":392684,"en":"Kulan-sur trampled through the foam."},{"id":"sayakbay-ms-current144:pdf163:l007","ordinal":392685,"en":"The horse opened its eyes wide."},{"id":"sayakbay-ms-current144:pdf163:l008","ordinal":392686,"en":"Untroubled, he could find no arrow that had struck."},{"id":"sayakbay-ms-current144:pdf163:l009","ordinal":392687,"en":"He found no ember left by misfortune."},{"id":"sayakbay-ms-current144:pdf163:l010","ordinal":392688,"en":"The knowing warriors had fearsome strength."},{"id":"sayakbay-ms-current144:pdf163:l011","ordinal":392689,"en":"The hero did not spare the enemy’s life."},{"id":"sayakbay-ms-current144:pdf163:l012","ordinal":392690,"en":"He had him bound by a hair and cast aside."},{"id":"sayakbay-ms-current144:pdf163:l013","ordinal":392691,"en":"He moved then toward Joltoy."},{"id":"sayakbay-ms-current144:pdf163:l014","ordinal":392692,"en":"“Where shall I find the precious one?” he said."},{"id":"sayakbay-ms-current144:pdf163:l015","ordinal":392693,"en":"If noble Joltoy should approach,"},{"id":"sayakbay-ms-current144:pdf163:l016","ordinal":392694,"en":"what kind of battle-axe would meet him?"},{"id":"sayakbay-ms-current144:pdf163:l018","ordinal":392695,"en":"“If he looks, I shall turn back.”"},{"id":"sayakbay-ms-current144:pdf163:l019","ordinal":392696,"en":"“For how many years shall I journey?”"},{"id":"sayakbay-ms-current144:pdf163:l020","ordinal":392697,"en":"He made blood flow in the valley."},{"id":"sayakbay-ms-current144:pdf163:l021","ordinal":392698,"en":"May the torment he feared never come."},{"id":"sayakbay-ms-current144:pdf163:l022","ordinal":392699,"en":"Because of noble Joltoy,"},{"id":"sayakbay-ms-current144:pdf163:l023","ordinal":392700,"en":"may no living soul come against him."},{"id":"sayakbay-ms-current144:pdf163:l024","ordinal":392701,"en":"“Without Seitek, I shall die.”"},{"id":"sayakbay-ms-current144:pdf163:l025","ordinal":392702,"en":"“I will not stand idle; I am his hearth and support.”"},{"id":"sayakbay-ms-current144:pdf163:l026","ordinal":392703,"en":"He journeyed until he reached the people."},{"id":"sayakbay-ms-current144:pdf163:l027","ordinal":392704,"en":"He would suffer the wrath he had stirred."}]
