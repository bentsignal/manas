[{"id":"manas-2010:p0342:b001:l019","ordinal":15617,"en":"He overwhelmed with food and fed full."},{"id":"manas-2010:p0342:b001:l020","ordinal":15618,"en":"Jakyp displayed his immense wealth;"},{"id":"manas-2010:p0342:b001:l021","ordinal":15619,"en":"The many Manchus sated at his feast"},{"id":"manas-2010:p0342:b001:l022","ordinal":15620,"en":"Kept it concealed."},{"id":"manas-2010:p0342:b001:l023","ordinal":15621,"en":"'My child's name is Madman,' he said;"},{"id":"manas-2010:p0342:b001:l024","ordinal":15622,"en":"It was then he prepared to leave."},{"id":"manas-2010:p0342:b001:l025","ordinal":15623,"en":"That Burut would go to his homeland;"},{"id":"manas-2010:p0342:b001:l026","ordinal":15624,"en":"To bring Kakanchyn to ruin,"},{"id":"manas-2010:p0342:b001:l027","ordinal":15625,"en":"That was what he was preparing."},{"id":"manas-2010:p0342:b001:l028","ordinal":15626,"en":"Terrible havoc,"},{"id":"manas-2010:p0342:b001:l029","ordinal":15627,"en":"That was what he was preparing to unleash."},{"id":"manas-2010:p0342:b001:l030","ordinal":15628,"en":"We destroyed his forefathers;"},{"id":"manas-2010:p0342:b001:l031","ordinal":15629,"en":"If he gained the strength, his great revenge"},{"id":"manas-2010:p0342:b001:l032","ordinal":15630,"en":"Was what he was preparing to take."},{"id":"manas-2010:p0342:b001:l033","ordinal":15631,"en":"I heard a report from a governor:"},{"id":"manas-2010:p0342:b001:l034","ordinal":15632,"en":"Against Kakanchyn's Beejin,"},{"id":"manas-2010:p0342:b001:l035","ordinal":15633,"en":"If that Manas lived,"},{"id":"manas-2010:p0342:b001:l036","ordinal":15634,"en":"He would surely attack, I heard!"},{"id":"manas-2010:p0342:b001:l037","ordinal":15635,"en":"When he reached twelve,"},{"id":"manas-2010:p0342:b001:l038","ordinal":15636,"en":"He won the name of Khan Manas."},{"id":"manas-2010:p0342:b001:l039","ordinal":15637,"en":"Now, growing to manhood, becoming a warrior,"},{"id":"manas-2010:p0342:b001:l040","ordinal":15638,"en":"Becoming equal to the sons of heroes,"},{"id":"manas-2010:p0342:b001:l041","ordinal":15639,"en":"Will he not return and seize Beejin's"},{"id":"manas-2010:p0342:b001:l042","ordinal":15640,"en":"Khanship?!"},{"id":"manas-2010:p0342:b001:l043","ordinal":15641,"en":"I heard from the giant Döödür:"},{"id":"manas-2010:p0342:b001:l044","ordinal":15642,"en":"My gold on ninety camels—"},{"id":"manas-2010:p0342:b001:l045","ordinal":15643,"en":"He wrought boundless havoc."},{"id":"manas-2010:p0342:b001:l046","ordinal":15644,"en":"Taking it as booty, that Burut"},{"id":"manas-2010:p0342:b001:l047","ordinal":15645,"en":"Seized it as soon as they arrived!"},{"id":"manas-2010:p0342:b001:l048","ordinal":15646,"en":"My treasury's great riches,"},{"id":"manas-2010:p0343:b001:l001","ordinal":15647,"en":"Killing the champions,"},{"id":"manas-2010:p0343:b001:l002","ordinal":15648,"en":"That Burut—may his house burn!—"},{"id":"manas-2010:p0343:b001:l003","ordinal":15649,"en":"Took them as booty!"},{"id":"manas-2010:p0343:b001:l004","ordinal":15650,"en":"Manas is no ordinary son!"},{"id":"manas-2010:p0343:b001:l005","ordinal":15651,"en":"He is no fellow who will let us prosper."},{"id":"manas-2010:p0343:b001:l006","ordinal":15652,"en":"He brought misfortune upon Zholoy."},{"id":"manas-2010:p0343:b001:l007","ordinal":15653,"en":"All those who were lost,"},{"id":"manas-2010:p0343:b001:l008","ordinal":15654,"en":"Their heads, with a crunch,"},{"id":"manas-2010:p0343:b001:l009","ordinal":15655,"en":"He tore their heads off!"},{"id":"manas-2010:p0343:b001:l010","ordinal":15656,"en":"Oshpur's son was Chege."},{"id":"manas-2010:p0343:b001:l011","ordinal":15657,"en":"They did away with the name Chege"},{"id":"manas-2010:p0343:b001:l012","ordinal":15658,"en":"And called him Kutubiy!"},{"id":"manas-2010:p0343:b001:l013","ordinal":15659,"en":"Becoming Manas's companion,"},{"id":"manas-2010:p0343:b001:l014","ordinal":15660,"en":"That damned one—may he die raving!—"},{"id":"manas-2010:p0343:b001:l015","ordinal":15661,"en":"Of the black Kalmyks and Manchus,"},{"id":"manas-2010:p0343:b001:l016","ordinal":15662,"en":"He slaughtered a great many."},{"id":"manas-2010:p0343:b001:l017","ordinal":15663,"en":"To the raging madman Manas,"},{"id":"manas-2010:p0343:b001:l018","ordinal":15664,"en":"Oshpur's son Kutu"},{"id":"manas-2010:p0343:b001:l019","ordinal":15665,"en":"Became a source of good fortune."},{"id":"manas-2010:p0343:b001:l020","ordinal":15666,"en":"The champions who went to collect tribute,"},{"id":"manas-2010:p0343:b001:l021","ordinal":15667,"en":"He slaughtered them all!"},{"id":"manas-2010:p0343:b001:l022","ordinal":15668,"en":"Beside the raging Burut,"},{"id":"manas-2010:p0343:b001:l023","ordinal":15669,"en":"Winning the name of Kutubiy,"},{"id":"manas-2010:p0343:b001:l024","ordinal":15670,"en":"The two mad ones joined forces."},{"id":"manas-2010:p0343:b001:l025","ordinal":15671,"en":"Their trouble will strike Beejin."},{"id":"manas-2010:p0343:b001:l026","ordinal":15672,"en":"He willingly made his companion"},{"id":"manas-2010:p0343:b001:l027","ordinal":15673,"en":"Such a boy from among the Kalmyks."},{"id":"manas-2010:p0343:b001:l028","ordinal":15674,"en":"That malicious bloodstained one—"},{"id":"manas-2010:p0343:b001:l029","ordinal":15675,"en":"Can anyone who attacks him now survive?"},{"id":"manas-2010:p0343:b001:l030","ordinal":15676,"en":"Champions of Beejin, steel yourselves!"},{"id":"manas-2010:p0343:b001:l031","ordinal":15677,"en":"Unless you seize him now,"},{"id":"manas-2010:p0343:b001:l032","ordinal":15678,"en":"Unless you tear him up by the roots"},{"id":"manas-2010:p0343:b001:l033","ordinal":15679,"en":"And destroy him utterly,"},{"id":"manas-2010:p0343:b001:l034","ordinal":15680,"en":"If your strength fails to match him in battle"},{"id":"manas-2010:p0343:b001:l035","ordinal":15681,"en":"And Manas gets away,"},{"id":"manas-2010:p0343:b001:l036","ordinal":15682,"en":"He will make Ala-Too his homeland;"},{"id":"manas-2010:p0343:b001:l037","ordinal":15683,"en":"The lost and scattered people,"},{"id":"manas-2010:p0343:b001:l038","ordinal":15684,"en":"He will gather them all into a nation!"},{"id":"manas-2010:p0343:b001:l039","ordinal":15685,"en":"He will draw troops from as far as Mecca;"},{"id":"manas-2010:p0343:b001:l040","ordinal":15686,"en":"He will gather his forces together."},{"id":"manas-2010:p0343:b001:l041","ordinal":15687,"en":"Gathering sixty different peoples,"},{"id":"manas-2010:p0343:b001:l042","ordinal":15688,"en":"Heroes of fearsome renown,"},{"id":"manas-2010:p0343:b001:l043","ordinal":15689,"en":"Gathering giants fit to face Beejin,"},{"id":"manas-2010:p0343:b001:l044","ordinal":15690,"en":"If that Burut goes to his homeland,"},{"id":"manas-2010:p0343:b001:l045","ordinal":15691,"en":"That cunning Burut whose land bears a grudge"},{"id":"manas-2010:p0343:b001:l046","ordinal":15692,"en":"Will muster a full army!"},{"id":"manas-2010:p0343:b001:l047","ordinal":15693,"en":"That ill-disposed Burut"},{"id":"manas-2010:p0343:b001:l048","ordinal":15694,"en":"Will reach the ridge and settle there."},{"id":"manas-2010:p0344:b001:l001","ordinal":15695,"en":"One whose ways differ from all others,"},{"id":"manas-2010:p0344:b001:l002","ordinal":15696,"en":"A bold champion who has troubled the peoples,"},{"id":"manas-2010:p0344:b001:l003","ordinal":15697,"en":"Will become Manas's companion."},{"id":"manas-2010:p0344:b001:l004","ordinal":15698,"en":"If the cunning Burut reaches his homeland,"},{"id":"manas-2010:p0344:b001:l005","ordinal":15699,"en":"Will he stand watching without stirring?"},{"id":"manas-2010:p0344:b001:l006","ordinal":15700,"en":"Will he merely lie there—"},{"id":"manas-2010:p0344:b001:l007","ordinal":15701,"en":"Will God strike that Burut down?!"},{"id":"manas-2010:p0344:b001:l008","ordinal":15702,"en":"Will he not cut with a splendid spear,"},{"id":"manas-2010:p0344:b001:l009","ordinal":15703,"en":"Will he not gather gray-maned heroes?!"},{"id":"manas-2010:p0344:b001:l010","ordinal":15704,"en":"His opponent is Kakanchyn;"},{"id":"manas-2010:p0344:b001:l011","ordinal":15705,"en":"Will he watch without attacking?"},{"id":"manas-2010:p0344:b001:l012","ordinal":15706,"en":"If he is left free in his homeland,"},{"id":"manas-2010:p0344:b001:l013","ordinal":15707,"en":"Will his khanship not surpass all peoples'?"},{"id":"manas-2010:p0344:b001:l014","ordinal":15708,"en":"Once he has gathered his strength,"},{"id":"manas-2010:p0344:b001:l015","ordinal":15709,"en":"Will he not overrun the Kakan's people?!"},{"id":"manas-2010:p0344:b001:l016","ordinal":15710,"en":"If this Burut settles on the upland,"},{"id":"manas-2010:p0344:b001:l017","ordinal":15711,"en":"Will he not grow fat and refreshed?"},{"id":"manas-2010:p0344:b001:l018","ordinal":15712,"en":"Gathering his strength, that Burut,"},{"id":"manas-2010:p0344:b001:l019","ordinal":15713,"en":"Will he not bring strife upon the Kakan?!"},{"id":"manas-2010:p0344:b001:l020","ordinal":15714,"en":"Among the vast Kyrgyz people,"},{"id":"manas-2010:p0344:b001:l021","ordinal":15715,"en":"He will arrive in grandeur and settle;"},{"id":"manas-2010:p0344:b001:l022","ordinal":15716,"en":"His khanship will be complete."},{"id":"manas-2010:p0344:b001:l023","ordinal":15717,"en":"When that Burut grows wrathful,"},{"id":"manas-2010:p0344:b001:l024","ordinal":15718,"en":"He will suck in those who grapple with him!"},{"id":"manas-2010:p0344:b001:l025","ordinal":15719,"en":"He will feed his tulpar and make it stout;"},{"id":"manas-2010:p0344:b001:l026","ordinal":15720,"en":"All those who attack,"},{"id":"manas-2010:p0344:b001:l027","ordinal":15721,"en":"He will tear to shreds like wool!"},{"id":"manas-2010:p0344:b001:l028","ordinal":15722,"en":"Tending his swift steed will bring advantage."},{"id":"manas-2010:p0344:b001:l029","ordinal":15723,"en":"That Burut, disruptive at the root,"},{"id":"manas-2010:p0344:b001:l030","ordinal":15724,"en":"Will become forty when he reaches his homeland."},{"id":"manas-2010:p0344:b001:l031","ordinal":15725,"en":"He will win the name of Khan Manas."},{"id":"manas-2010:p0344:b001:l032","ordinal":15726,"en":"Unless you prepare and bind him,"},{"id":"manas-2010:p0344:b001:l033","ordinal":15727,"en":"That ill-omened Burut's"},{"id":"manas-2010:p0344:b001:l034","ordinal":15728,"en":"Trouble will strike the Kakan!”"},{"id":"manas-2010:p0344:b001:l035","ordinal":15729,"en":"The hero Esenkan spoke,"},{"id":"manas-2010:p0344:b001:l036","ordinal":15730,"en":"Roaring and unleashing his wrath,"},{"id":"manas-2010:p0344:b001:l037","ordinal":15731,"en":"As though Kakanchyn's Beejin"},{"id":"manas-2010:p0344:b001:l038","ordinal":15732,"en":"Would be engulfed,"},{"id":"manas-2010:p0344:b001:l039","ordinal":15733,"en":"He summoned his great army,"},{"id":"manas-2010:p0344:b001:l040","ordinal":15734,"en":"Hurried his governors,"},{"id":"manas-2010:p0344:b001:l041","ordinal":15735,"en":"And his swift runners and giants"},{"id":"manas-2010:p0344:b001:l042","ordinal":15736,"en":"He sent marching back and forth."},{"id":"manas-2010:p0344:b001:l043","ordinal":15737,"en":"Upon the throne, Esenkan"},{"id":"manas-2010:p0344:b001:l044","ordinal":15738,"en":"Began issuing orders at once."},{"id":"manas-2010:p0344:b001:l045","ordinal":15739,"en":"The Kakan's people cried out"},{"id":"manas-2010:p0344:b001:l046","ordinal":15740,"en":"And fell into utter confusion."},{"id":"manas-2010:p0344:b001:l047","ordinal":15741,"en":"Bells and war drums sounded;"},{"id":"manas-2010:p0344:b001:l048","ordinal":15742,"en":"The army lost its senses,"},{"id":"manas-2010:p0345:b001:l001","ordinal":15743,"en":"Of Beejin, that settled city,"},{"id":"manas-2010:p0345:b001:l002","ordinal":15744,"en":"Esenkan was the ruler."},{"id":"manas-2010:p0345:b001:l003","ordinal":15745,"en":"When Esenkan gave the order,"},{"id":"manas-2010:p0345:b001:l004","ordinal":15746,"en":"The many officials poured in."},{"id":"manas-2010:p0345:b001:l005","ordinal":15747,"en":"The people of Beejin grew excited;"},{"id":"manas-2010:p0345:b001:l006","ordinal":15748,"en":"All its Tyrgoots gathered."},{"id":"manas-2010:p0345:b001:l007","ordinal":15749,"en":"Spear tips clashed;"},{"id":"manas-2010:p0345:b001:l008","ordinal":15750,"en":"Men's heads knocked together."},{"id":"manas-2010:p0345:b001:l009","ordinal":15751,"en":"Their short coats bulging,"},{"id":"manas-2010:p0345:b001:l010","ordinal":15752,"en":"He tested and selected the strong."},{"id":"manas-2010:p0345:b001:l011","ordinal":15753,"en":"Putting Kün Zhang-Zhung in command,"},{"id":"manas-2010:p0345:b001:l012","ordinal":15754,"en":"He sent a thousand champions."},{"id":"manas-2010:p0345:b001:l013","ordinal":15755,"en":"To capture Manas and bind him—"},{"id":"manas-2010:p0345:b001:l014","ordinal":15756,"en":"Such was Esenkan's campaign."},{"id":"manas-2010:p0345:b003:l001","ordinal":15757,"en":"From Esenkan's court,"},{"id":"manas-2010:p0345:b003:l002","ordinal":15758,"en":"They brought out an object."},{"id":"manas-2010:p0345:b003:l003","ordinal":15759,"en":"Its royal splendor was great."},{"id":"manas-2010:p0345:b003:l004","ordinal":15760,"en":"Worn in battle, no bullet could pierce it."},{"id":"manas-2010:p0345:b003:l005","ordinal":15761,"en":"Your mighty Esenkan"},{"id":"manas-2010:p0345:b003:l006","ordinal":15762,"en":"Had kept that coat in readiness."},{"id":"manas-2010:p0345:b003:l007","ordinal":15763,"en":"Blue armor with a spreading skirt,"},{"id":"manas-2010:p0345:b003:l008","ordinal":15764,"en":"Strong armor no bullet could pierce,"},{"id":"manas-2010:p0345:b003:l009","ordinal":15765,"en":"Its back made of linked mail,"},{"id":"manas-2010:p0345:b003:l010","ordinal":15766,"en":"The whole of its chest"},{"id":"manas-2010:p0345:b003:l011","ordinal":15767,"en":"Made of iron no bullet could pierce:"},{"id":"manas-2010:p0345:b003:l012","ordinal":15768,"en":"Such was the coat to behold."},{"id":"manas-2010:p0345:b003:l013","ordinal":15769,"en":"Fastened upon its breast,"},{"id":"manas-2010:p0345:b003:l014","ordinal":15770,"en":"A jewel button as big as a fist."},{"id":"manas-2010:p0345:b003:l015","ordinal":15771,"en":"Wearing a coat from the treasury,"},{"id":"manas-2010:p0345:b003:l016","ordinal":15772,"en":"Riding a horse that flew like a crow,"},{"id":"manas-2010:p0345:b003:l017","ordinal":15773,"en":"Its forelock clipped, without a mane,"},{"id":"manas-2010:p0345:b003:l018","ordinal":15774,"en":"Its mane and tail tied tightly,"},{"id":"manas-2010:p0345:b003:l019","ordinal":15775,"en":"Such was the marvel:"},{"id":"manas-2010:p0345:b003:l020","ordinal":15776,"en":"Ay Zhang-Zhung went along the road."},{"id":"manas-2010:p0345:b003:l021","ordinal":15777,"en":"He began with fierce wrath;"},{"id":"manas-2010:p0345:b003:l022","ordinal":15778,"en":"The weak men without courage"},{"id":"manas-2010:p0345:b003:l023","ordinal":15779,"en":"He separated from the army."},{"id":"manas-2010:p0345:b003:l024","ordinal":15780,"en":"Those deft and skilled with spears,"},{"id":"manas-2010:p0345:b003:l025","ordinal":15781,"en":"Those excellent at striking with battle-axes,"},{"id":"manas-2010:p0345:b003:l026","ordinal":15782,"en":"From these he gave him many troops."},{"id":"manas-2010:p0345:b003:l027","ordinal":15783,"en":"With its skirt slit a handspan,"},{"id":"manas-2010:p0345:b003:l028","ordinal":15784,"en":"He gave him a coat no bullet could pierce."},{"id":"manas-2010:p0345:b003:l029","ordinal":15785,"en":"He made his mighty khanship known;"},{"id":"manas-2010:p0345:b003:l030","ordinal":15786,"en":"He clothed him in a treasury coat."},{"id":"manas-2010:p0346:b001:l001","ordinal":15787,"en":"Cotton sashes and broad boots,"},{"id":"manas-2010:p0346:b001:l002","ordinal":15788,"en":"Gathering troops from the Kalmyks,"},{"id":"manas-2010:p0346:b001:l003","ordinal":15789,"en":"Mighty on horseback, swift on foot,"},{"id":"manas-2010:p0346:b001:l004","ordinal":15790,"en":"A champion in battle, a great runner,"},{"id":"manas-2010:p0346:b001:l005","ordinal":15791,"en":"Whose trot the wind could not overtake,"},{"id":"manas-2010:p0346:b001:l006","ordinal":15792,"en":"The outstanding champion, giant Döödür—"},{"id":"manas-2010:p0346:b001:l007","ordinal":15793,"en":"Giving him so many Kalmyk troops,"},{"id":"manas-2010:p0346:b001:l008","ordinal":15794,"en":"He sent the giant Döödür."},{"id":"manas-2010:p0346:b001:l009","ordinal":15795,"en":"“The Kyrgyz Burut of forty households,"},{"id":"manas-2010:p0346:b001:l010","ordinal":15796,"en":"Without leaving a hair unharmed,"},{"id":"manas-2010:p0346:b001:l011","ordinal":15797,"en":"Go and slaughter them!” he said."},{"id":"manas-2010:p0346:b001:l012","ordinal":15798,"en":"He sent great Döödür."},{"id":"manas-2010:p0346:b001:l013","ordinal":15799,"en":"Beneath great Döödür,"},{"id":"manas-2010:p0346:b001:l014","ordinal":15800,"en":"Unflinching when ridden into battle,"},{"id":"manas-2010:p0346:b001:l015","ordinal":15801,"en":"He placed a bay mule."},{"id":"manas-2010:p0346:b001:l016","ordinal":15802,"en":"Such was the bay mule:"},{"id":"manas-2010:p0346:b001:l017","ordinal":15803,"en":"If it crossed a desert of forty days' travel,"},{"id":"manas-2010:p0346:b001:l018","ordinal":15804,"en":"If it crossed a ridge with perilous cliffs,"},{"id":"manas-2010:p0346:b001:l019","ordinal":15805,"en":"It drank not a single gulp of water."},{"id":"manas-2010:p0346:b001:l020","ordinal":15806,"en":"They relied on its endurance;"},{"id":"manas-2010:p0346:b001:l021","ordinal":15807,"en":"Whoever saw it marveled."},{"id":"manas-2010:p0346:b001:l022","ordinal":15808,"en":"No one failed to marvel."},{"id":"manas-2010:p0346:b001:l023","ordinal":15809,"en":"Upon the Kakan khan's Beejin,"},{"id":"manas-2010:p0346:b001:l024","ordinal":15810,"en":"If overwhelming trouble came,"},{"id":"manas-2010:p0346:b001:l025","ordinal":15811,"en":"'Let him ride it into battle,' he said;"},{"id":"manas-2010:p0346:b001:l026","ordinal":15812,"en":"He had kept it ready for that very purpose."},{"id":"manas-2010:p0346:b001:l027","ordinal":15813,"en":"That damned Esen"},{"id":"manas-2010:p0346:b001:l028","ordinal":15814,"en":"Had overlooked not a scrap of wisdom."},{"id":"manas-2010:p0346:b001:l029","ordinal":15815,"en":"His kingship was extraordinary;"},{"id":"manas-2010:p0346:b001:l030","ordinal":15816,"en":"His prowess was considerable."},{"id":"manas-2010:p0346:b001:l031","ordinal":15817,"en":"His word was clear in this world;"},{"id":"manas-2010:p0346:b001:l032","ordinal":15818,"en":"While alive, his eyes were open."},{"id":"manas-2010:p0346:b001:l033","ordinal":15819,"en":"A surpassing expert, a great judge,"},{"id":"manas-2010:p0346:b001:l034","ordinal":15820,"en":"Such a khan was Esenkan."},{"id":"manas-2010:p0346:b001:l035","ordinal":15821,"en":"The gray-maned hero Esenkan"},{"id":"manas-2010:p0346:b001:l036","ordinal":15822,"en":"Possessed such wisdom."},{"id":"manas-2010:p0346:b001:l037","ordinal":15823,"en":"Behind that army,"},{"id":"manas-2010:p0346:b001:l038","ordinal":15824,"en":"From the steel-doored court,"},{"id":"manas-2010:p0346:b001:l039","ordinal":15825,"en":"Into his garden for pleasure walks,"},{"id":"manas-2010:p0346:b001:l040","ordinal":15826,"en":"Where no one came and went,"},{"id":"manas-2010:p0346:b001:l041","ordinal":15827,"en":"Where any mortal who looked marveled,"},{"id":"manas-2010:p0346:b001:l042","ordinal":15828,"en":"From the court with golden pillars,"},{"id":"manas-2010:p0346:b001:l043","ordinal":15829,"en":"Dust flew into the sky;"},{"id":"manas-2010:p0346:b001:l044","ordinal":15830,"en":"Soldiers seethed and thronged."},{"id":"manas-2010:p0346:b001:l045","ordinal":15831,"en":"The khan whose kingship all people knew,"},{"id":"manas-2010:p0346:b001:l046","ordinal":15832,"en":"A parrot's tail feathers"},{"id":"manas-2010:p0346:b001:l047","ordinal":15833,"en":"He wore arranged in nine styles."},{"id":"manas-2010:p0346:b001:l048","ordinal":15834,"en":"His short coat bulging,"},{"id":"manas-2010:p0347:b001:l001","ordinal":15835,"en":"Wearing a red short coat,"},{"id":"manas-2010:p0347:b001:l002","ordinal":15836,"en":"The formidable marksman Karazhoy,"},{"id":"manas-2010:p0347:b001:l003","ordinal":15837,"en":"Taking a great many fierce troops,"},{"id":"manas-2010:p0347:b001:l004","ordinal":15838,"en":"To reach the mighty bloodstained Manas"},{"id":"manas-2010:p0347:b001:l005","ordinal":15839,"en":"And capture him alive,"},{"id":"manas-2010:p0347:b001:l006","ordinal":15840,"en":"Took iron rope and armor."},{"id":"manas-2010:p0347:b001:l007","ordinal":15841,"en":"Men who would seize him without fail,"},{"id":"manas-2010:p0347:b001:l008","ordinal":15842,"en":"He took many lasso-bearers."},{"id":"manas-2010:p0347:b001:l009","ordinal":15843,"en":"From beyond that,"},{"id":"manas-2010:p0347:b001:l010","ordinal":15844,"en":"Karazhoy came out."},{"id":"manas-2010:p0347:b001:l011","ordinal":15845,"en":"Behind Karazhoy,"},{"id":"manas-2010:p0347:b001:l012","ordinal":15846,"en":"Beads, plumes and coral stones,"},{"id":"manas-2010:p0347:b001:l013","ordinal":15847,"en":"The khan of Zungtung was among them."},{"id":"manas-2010:p0347:b001:l014","ordinal":15848,"en":"His many troops of diverse kinds,"},{"id":"manas-2010:p0347:b001:l015","ordinal":15849,"en":"When he examined them thoroughly,"},{"id":"manas-2010:p0347:b001:l016","ordinal":15850,"en":"His poor head was troubled."},{"id":"manas-2010:p0347:b001:l017","ordinal":15851,"en":"Manas of the Kyrgyz forty households,"},{"id":"manas-2010:p0347:b001:l018","ordinal":15852,"en":"To crush and conquer him,"},{"id":"manas-2010:p0347:b001:l019","ordinal":15853,"en":"Zholoy of the Kalmyks"},{"id":"manas-2010:p0347:b001:l020","ordinal":15854,"en":"He chose at that moment."},{"id":"manas-2010:p0347:b001:l021","ordinal":15855,"en":"“You who spare none in combat,"},{"id":"manas-2010:p0347:b001:l022","ordinal":15856,"en":"With the meat of a whole pig,"},{"id":"manas-2010:p0347:b001:l023","ordinal":15857,"en":"You are not sated at a single meal."},{"id":"manas-2010:p0347:b001:l024","ordinal":15858,"en":"Your valor is considerable,"},{"id":"manas-2010:p0347:b001:l025","ordinal":15859,"en":"Mighty Zholoy, my champion!"},{"id":"manas-2010:p0347:b001:l026","ordinal":15860,"en":"Instead of bringing Manas bound,"},{"id":"manas-2010:p0347:b001:l027","ordinal":15861,"en":"You say, 'He slaughtered my champions';"},{"id":"manas-2010:p0347:b001:l028","ordinal":15862,"en":"Your humiliation burns my soul."},{"id":"manas-2010:p0347:b001:l029","ordinal":15863,"en":"Zholoy, you were a heroic giant;"},{"id":"manas-2010:p0347:b001:l030","ordinal":15864,"en":"You were a glutton and a warrior."},{"id":"manas-2010:p0347:b001:l031","ordinal":15865,"en":"Everyone who fought us,"},{"id":"manas-2010:p0347:b001:l032","ordinal":15866,"en":"I thought you would bring them bound."},{"id":"manas-2010:p0347:b001:l033","ordinal":15867,"en":"I myself, Khan Esenkan,"},{"id":"manas-2010:p0347:b001:l034","ordinal":15868,"en":"Over Beejin's forty Kytay tribes,"},{"id":"manas-2010:p0347:b001:l035","ordinal":15869,"en":"Have long been ruler."},{"id":"manas-2010:p0347:b001:l036","ordinal":15870,"en":"'As long as this Zholoy lives,"},{"id":"manas-2010:p0347:b001:l037","ordinal":15871,"en":"All those who fight us,"},{"id":"manas-2010:p0347:b001:l038","ordinal":15872,"en":"I will crush them,' I kept thinking."}]
