{"id": "sayakbay-ms-current146:pdf225:l024", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 225, "folio": 608, "line_in_page": 24, "raw": "Кыздар көп кыргыз журт,", "text": "Кыздар көп кыргыз журт,", "en": "The Kyrgyz people had many daughters.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
