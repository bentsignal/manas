[{"id":"semetey-1-2013:p0895:b003:l030","ordinal":144641,"en":"Shouted and leveled his spear,"},{"id":"semetey-1-2013:p0895:b003:l031","ordinal":144642,"en":"Slaughtered a great many."},{"id":"semetey-1-2013:p0895:b003:l032","ordinal":144643,"en":"Jamgyrchy's Shaiymbet,"},{"id":"semetey-1-2013:p0895:b003:l033","ordinal":144644,"en":"Licking his lips like a hungry wolf,"},{"id":"semetey-1-2013:p0895:b003:l034","ordinal":144645,"en":"Looked about him."},{"id":"semetey-1-2013:p0895:b003:l035","ordinal":144646,"en":"Shaiymbet was an ocean;"},{"id":"semetey-1-2013:p0895:b003:l036","ordinal":144647,"en":"He stood beneath the standard."},{"id":"semetey-1-2013:p0895:b003:l037","ordinal":144648,"en":"Struck by Kanykei’s spear,"},{"id":"semetey-1-2013:p0895:b003:l038","ordinal":144649,"en":"The forty companions, cursed by the spirits,"},{"id":"semetey-1-2013:p0895:b003:l039","ordinal":144650,"en":"Had fallen captive."},{"id":"semetey-1-2013:p0895:b004:l001","ordinal":144651,"en":"Kanykei and Chiyyrdy"},{"id":"semetey-1-2013:p0895:b004:l002","ordinal":144652,"en":"To Semetey’s grandfather,"},{"id":"semetey-1-2013:p0895:b004:l003","ordinal":144653,"en":"Great Jakyp, went."},{"id":"semetey-1-2013:p0895:b004:l004","ordinal":144654,"en":"That swine Jakyp"},{"id":"semetey-1-2013:p0895:b004:l005","ordinal":144655,"en":"They trampled upon the head."},{"id":"semetey-1-2013:p0895:b004:l006","ordinal":144656,"en":"Three elder women joined together"},{"id":"semetey-1-2013:p0895:b004:l007","ordinal":144657,"en":"And scattered his four kinds of livestock."},{"id":"semetey-1-2013:p0895:b004:l009","ordinal":144658,"en":"They struck his brains out,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0895:b004:l010","ordinal":144659,"en":"Slaughtered his grandfather, the swine khan,"},{"id":"semetey-1-2013:p0895:b004:l011","ordinal":144660,"en":"Gouged out both his eyes,"},{"id":"semetey-1-2013:p0895:b004:l012","ordinal":144661,"en":"Boiled it without letting it be unlawful meat,"},{"id":"semetey-1-2013:p0895:b004:l013","ordinal":144662,"en":"Made kuurdak of his head and ate their fill."},{"id":"semetey-1-2013:p0895:b004:l014","ordinal":144663,"en":"The grief of a burning heart—"},{"id":"semetey-1-2013:p0895:b004:l015","ordinal":144664,"en":"Your dear sister-in-law Kanykei"},{"id":"semetey-1-2013:p0895:b004:l016","ordinal":144665,"en":"Wiped them out, leaving none."},{"id":"semetey-1-2013:p0895:b004:l017","ordinal":144666,"en":"Her pain subsided;"},{"id":"semetey-1-2013:p0895:b004:l018","ordinal":144667,"en":"Then your sister-in-law Kanykei"},{"id":"semetey-1-2013:p0895:b004:l019","ordinal":144668,"en":"Her eyes opened wide,"},{"id":"semetey-1-2013:p0895:b004:l020","ordinal":144669,"en":"Manas’s wife Akylai—"},{"id":"semetey-1-2013:p0895:b004:l021","ordinal":144670,"en":"She had no sense, good heavens!"},{"id":"semetey-1-2013:p0895:b004:l022","ordinal":144671,"en":"The pampered wife Akylai—"},{"id":"semetey-1-2013:p0895:b004:l023","ordinal":144672,"en":"Born foolish, good heavens—"},{"id":"semetey-1-2013:p0895:b004:l024","ordinal":144673,"en":"Had married Kobosh."},{"id":"semetey-1-2013:p0895:b004:l025","ordinal":144674,"en":"Many people knew her conduct."},{"id":"semetey-1-2013:p0895:b004:l026","ordinal":144675,"en":"Your dear mother Kanykei"},{"id":"semetey-1-2013:p0895:b004:l027","ordinal":144676,"en":"She had set her astride a pole,"},{"id":"semetey-1-2013:p0895:b004:l028","ordinal":144677,"en":"Making the fierce woman scream,"},{"id":"semetey-1-2013:p0895:b004:l029","ordinal":144678,"en":"She dragged her by her very hair."},{"id":"semetey-1-2013:p0895:b004:l030","ordinal":144679,"en":"“Your precious hair, thick as a girth—"},{"id":"semetey-1-2013:p0895:b004:l031","ordinal":144680,"en":"How could you cast it over your breast?"},{"id":"semetey-1-2013:p0895:b004:l032","ordinal":144681,"en":"With dogs born of ravens,"},{"id":"semetey-1-2013:p0895:b004:l033","ordinal":144682,"en":"How could you lie in lust?"},{"id":"semetey-1-2013:p0895:b004:l034","ordinal":144683,"en":"Of the lord born of a falcon,"},{"id":"semetey-1-2013:p0895:b004:l035","ordinal":144684,"en":"How could you let them trample his bed?"},{"id":"semetey-1-2013:p0895:b004:l036","ordinal":144685,"en":"My bloodthirsty hero’s treasury"},{"id":"semetey-1-2013:p0895:b004:l037","ordinal":144686,"en":"You let a multitude of dogs scatter."},{"id":"semetey-1-2013:p0895:b004:l038","ordinal":144687,"en":"The thick-laid bed of the bloodthirsty hero"},{"id":"semetey-1-2013:p0895:b004:l039","ordinal":144688,"en":"You let six scoundrels trample."},{"id":"semetey-1-2013:p0896:b003:l001","ordinal":144689,"en":"“You too were Manas’s wife;"},{"id":"semetey-1-2013:p0896:b003:l002","ordinal":144690,"en":"I too was Manas’s wife."},{"id":"semetey-1-2013:p0896:b003:l003","ordinal":144691,"en":"To Temirkan’s city,"},{"id":"semetey-1-2013:p0896:b003:l004","ordinal":144692,"en":"For whose sake did I wander?"},{"id":"semetey-1-2013:p0896:b003:l005","ordinal":144693,"en":"Wandering to Bukhara,"},{"id":"semetey-1-2013:p0896:b003:l006","ordinal":144694,"en":"Settling there as a wandering neighbor,"},{"id":"semetey-1-2013:p0896:b003:l007","ordinal":144695,"en":"Acquiring a bad name—"},{"id":"semetey-1-2013:p0896:b003:l008","ordinal":144696,"en":"Woman, it was for your sake!"},{"id":"semetey-1-2013:p0896:b003:l009","ordinal":144697,"en":"When the bloodthirsty hero died,"},{"id":"semetey-1-2013:p0896:b003:l010","ordinal":144698,"en":"Before forty days had passed since his death,"},{"id":"semetey-1-2013:p0896:b003:l011","ordinal":144699,"en":"You married a man, made a spectacle,"},{"id":"semetey-1-2013:p0896:b003:l012","ordinal":144700,"en":"And caused this havoc."},{"id":"semetey-1-2013:p0896:b003:l013","ordinal":144701,"en":"Wretched woman, because of you,"},{"id":"semetey-1-2013:p0896:b003:l014","ordinal":144702,"en":"Chafing my heels,"},{"id":"semetey-1-2013:p0896:b003:l015","ordinal":144703,"en":"Aching in the flesh of my calves,"},{"id":"semetey-1-2013:p0896:b003:l016","ordinal":144704,"en":"I scattered my countless treasures,"},{"id":"semetey-1-2013:p0896:b003:l017","ordinal":144705,"en":"Fled toward Bukhara!"},{"id":"semetey-1-2013:p0896:b003:l018","ordinal":144706,"en":"For whose sake was this humiliation?"},{"id":"semetey-1-2013:p0896:b003:l019","ordinal":144707,"en":"Treacherous woman, for your sake!”"},{"id":"semetey-1-2013:p0896:b003:l020","ordinal":144708,"en":"Having said this, Kanykei"},{"id":"semetey-1-2013:p0896:b003:l021","ordinal":144709,"en":"The depraved woman Akylai"},{"id":"semetey-1-2013:p0896:b003:l022","ordinal":144710,"en":"First seized,"},{"id":"semetey-1-2013:p0896:b003:l023","ordinal":144711,"en":"Dragged her onto the road,"},{"id":"semetey-1-2013:p0896:b003:l024","ordinal":144712,"en":"And had dogs tear her apart."},{"id":"semetey-1-2013:p0896:b003:l025","ordinal":144713,"en":"Her enemy who bore her malice"},{"id":"semetey-1-2013:p0896:b003:l026","ordinal":144714,"en":"She slaughtered as a sacrifice."},{"id":"semetey-1-2013:p0896:b003:l027","ordinal":144715,"en":"Your dear sister-in-law Kanykei"},{"id":"semetey-1-2013:p0896:b003:l029","ordinal":144716,"en":"Her craving for vengeance satisfied,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0896:b003:l030","ordinal":144717,"en":"Before the leopard orphan arrived,"},{"id":"semetey-1-2013:p0896:b003:l031","ordinal":144718,"en":"The forty companions taken captive,"},{"id":"semetey-1-2013:p0896:b003:l032","ordinal":144719,"en":"The vast host surrounding them,"},{"id":"semetey-1-2013:p0896:b003:l034","ordinal":144720,"en":"Let us leave this thus.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0896:b003:l035","ordinal":144721,"en":"The people taken captive,"},{"id":"semetey-1-2013:p0896:b003:l036","ordinal":144722,"en":"Before they slaughtered them without letting them stir,"},{"id":"semetey-1-2013:p0896:b003:l038","ordinal":144723,"en":"Wearing a gray lynx-fur cap,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0896:b003:l039","ordinal":144724,"en":"Brandishing his mottled shield,"},{"id":"semetey-1-2013:p0896:b004:l001","ordinal":144725,"en":"Clad in shining mail,"},{"id":"semetey-1-2013:p0896:b004:l002","ordinal":144726,"en":"Calling out like a young goose,"},{"id":"semetey-1-2013:p0896:b004:l003","ordinal":144727,"en":"Royal Bakai began to speak:"},{"id":"semetey-1-2013:p0896:b004:l004","ordinal":144728,"en":"“Oh, Kanykei, Sary Khan!"},{"id":"semetey-1-2013:p0896:b004:l005","ordinal":144729,"en":"This conduct of yours is cruel."},{"id":"semetey-1-2013:p0896:b004:l006","ordinal":144730,"en":"What guilt have the many people?"},{"id":"semetey-1-2013:p0896:b004:l007","ordinal":144731,"en":"Remain where you are."},{"id":"semetey-1-2013:p0896:b004:l008","ordinal":144732,"en":"Until the orphan, our support, arrives,"},{"id":"semetey-1-2013:p0896:b004:l009","ordinal":144733,"en":"Wait patiently."},{"id":"semetey-1-2013:p0896:b004:l010","ordinal":144734,"en":"I shall speak words worthy of heed."},{"id":"semetey-1-2013:p0896:b004:l011","ordinal":144735,"en":"Both of you, listen without delay!"},{"id":"semetey-1-2013:p0896:b004:l012","ordinal":144736,"en":"A broad valley needs land;"},{"id":"semetey-1-2013:p0896:b004:l013","ordinal":144737,"en":"The orphan who has grown and returned"},{"id":"semetey-1-2013:p0896:b004:l014","ordinal":144738,"en":"Will need a people tomorrow!"},{"id":"semetey-1-2013:p0896:b004:l015","ordinal":144739,"en":"A hilly mountain needs a ridge;"},{"id":"semetey-1-2013:p0896:b004:l016","ordinal":144740,"en":"A hero needs a people!"},{"id":"semetey-1-2013:p0896:b004:l017","ordinal":144741,"en":"As great as a mountain crest,"},{"id":"semetey-1-2013:p0896:b004:l018","ordinal":144742,"en":"Semetey, Manas’s son,"},{"id":"semetey-1-2013:p0896:b004:l019","ordinal":144743,"en":"When he comes and settles in Talas,"},{"id":"semetey-1-2013:p0896:b004:l020","ordinal":144744,"en":"‘He destroyed all his people,"},{"id":"semetey-1-2013:p0896:b004:l021","ordinal":144745,"en":"He slaughtered them’—do not let that be said."},{"id":"semetey-1-2013:p0896:b004:l022","ordinal":144746,"en":"Is not their khan a fool?"},{"id":"semetey-1-2013:p0896:b004:l023","ordinal":144747,"en":"What guilt have the many people?"},{"id":"semetey-1-2013:p0896:b004:l024","ordinal":144748,"en":"What guilt have all the people?"},{"id":"semetey-1-2013:p0896:b004:l025","ordinal":144749,"en":"Turning your intentions toward evil,"},{"id":"semetey-1-2013:p0896:b004:l026","ordinal":144750,"en":"Oh, my foal Kanykei,"},{"id":"semetey-1-2013:p0896:b004:l027","ordinal":144751,"en":"With what face can you slaughter"},{"id":"semetey-1-2013:p0896:b004:l028","ordinal":144752,"en":"Your people left by Manas?”"},{"id":"semetey-1-2013:p0896:b004:l029","ordinal":144753,"en":"Royal Bakai called out,"},{"id":"semetey-1-2013:p0896:b004:l030","ordinal":144754,"en":"Stepped between them,"},{"id":"semetey-1-2013:p0896:b004:l031","ordinal":144755,"en":"And all those people"},{"id":"semetey-1-2013:p0896:b004:l032","ordinal":144756,"en":"He saved by interceding."},{"id":"semetey-1-2013:p0896:b004:l033","ordinal":144757,"en":"They bowed to Khan Bakai,"},{"id":"semetey-1-2013:p0896:b004:l034","ordinal":144758,"en":"The sage, fierce Bakai’s"},{"id":"semetey-1-2013:p0896:b004:l035","ordinal":144759,"en":"Words they readily accepted,"},{"id":"semetey-1-2013:p0896:b004:l036","ordinal":144760,"en":"Granted what he wished."},{"id":"semetey-1-2013:p0896:b004:l037","ordinal":144761,"en":"Your elder Bakai brought good fortune,"},{"id":"semetey-1-2013:p0896:b004:l038","ordinal":144762,"en":"An old man who showed the way,"},{"id":"semetey-1-2013:p0896:b004:l039","ordinal":144763,"en":"Truly a sage himself."},{"id":"semetey-1-2013:p0897:b003:l001","ordinal":144764,"en":"No evil word could cling to him;"},{"id":"semetey-1-2013:p0897:b003:l002","ordinal":144765,"en":"Even if he entered the grave,"},{"id":"semetey-1-2013:p0897:b003:l003","ordinal":144766,"en":"Fierce Bakai would not go astray."},{"id":"semetey-1-2013:p0897:b003:l004","ordinal":144767,"en":"The whole wide world—"},{"id":"semetey-1-2013:p0897:b003:l005","ordinal":144768,"en":"Was it not Bakai who apportioned it?"},{"id":"semetey-1-2013:p0897:b003:l006","ordinal":144769,"en":"Living as a hero in the world,"},{"id":"semetey-1-2013:p0897:b003:l007","ordinal":144770,"en":"Was it not Bakai who had seen it?"},{"id":"semetey-1-2013:p0897:b003:l008","ordinal":144771,"en":"The door that stood locked—"},{"id":"semetey-1-2013:p0897:b003:l009","ordinal":144772,"en":"Was it not Bakai who opened it?"},{"id":"semetey-1-2013:p0897:b003:l010","ordinal":144773,"en":"Gold and silver,"},{"id":"semetey-1-2013:p0897:b003:l011","ordinal":144774,"en":"Spending them freely across the land,"},{"id":"semetey-1-2013:p0897:b003:l012","ordinal":144775,"en":"Was it not Bakai who scattered them?"},{"id":"semetey-1-2013:p0897:b003:l013","ordinal":144776,"en":"For the mortal seeking support,"},{"id":"semetey-1-2013:p0897:b003:l014","ordinal":144777,"en":"Was not Bakai that support?"},{"id":"semetey-1-2013:p0897:b003:l015","ordinal":144778,"en":"Created for humankind,"},{"id":"semetey-1-2013:p0897:b003:l016","ordinal":144779,"en":"Was not Bakai its lion?"},{"id":"semetey-1-2013:p0897:b003:l017","ordinal":144780,"en":"His speech was sweet, his words honey."},{"id":"semetey-1-2013:p0897:b003:l018","ordinal":144781,"en":"Do not ask of Khan Bakai;"},{"id":"semetey-1-2013:p0897:b003:l019","ordinal":144782,"en":"He had surpassingly clear sight."},{"id":"semetey-1-2013:p0897:b003:l020","ordinal":144783,"en":"His understanding was complete; in every way,"},{"id":"semetey-1-2013:p0897:b003:l021","ordinal":144784,"en":"He began to speak with reason."},{"id":"semetey-1-2013:p0897:b003:l022","ordinal":144785,"en":"Your dear, quick-witted Bakai—"},{"id":"semetey-1-2013:p0897:b003:l023","ordinal":144786,"en":"His kingship known to the people,"},{"id":"semetey-1-2013:p0897:b003:l024","ordinal":144787,"en":"Old leopard Bakai—"},{"id":"semetey-1-2013:p0897:b003:l025","ordinal":144788,"en":"There he turned Kökcholok’s head;"},{"id":"semetey-1-2013:p0897:b003:l026","ordinal":144789,"en":"There he stood interceding."},{"id":"semetey-1-2013:p0897:b003:l027","ordinal":144790,"en":"Before even that much time had passed,"},{"id":"semetey-1-2013:p0897:b003:l028","ordinal":144791,"en":"The young lord Semetey"},{"id":"semetey-1-2013:p0897:b003:l029","ordinal":144792,"en":"Also arrived."},{"id":"semetey-1-2013:p0897:b003:l030","ordinal":144793,"en":"Khan Manas’s forty companions,"},{"id":"semetey-1-2013:p0897:b003:l031","ordinal":144794,"en":"When they saw Semetey,"},{"id":"semetey-1-2013:p0897:b003:l032","ordinal":144795,"en":"Stood in a row, sobbing."},{"id":"semetey-1-2013:p0897:b003:l033","ordinal":144796,"en":"“The only son left by my khan Manas!”"},{"id":"semetey-1-2013:p0897:b003:l035","ordinal":144797,"en":"They cried aloud."},{"id":"semetey-1-2013:p0897:b003:l036","ordinal":144798,"en":"“My shelter left by Manas,"},{"id":"semetey-1-2013:p0897:b003:l037","ordinal":144799,"en":"My good fortune left by his blessing!"},{"id":"semetey-1-2013:p0897:b003:l038","ordinal":144800,"en":"For Manas, gone before us,"},{"id":"semetey-1-2013:p0897:b003:l039","ordinal":144801,"en":"Whether we sit or stand, we grieve."},{"id":"semetey-1-2013:p0897:b005:l001","ordinal":144802,"en":"My shelter left by Manas,"},{"id":"semetey-1-2013:p0897:b005:l002","ordinal":144803,"en":"We pray for your wishes to come true."},{"id":"semetey-1-2013:p0897:b005:l005","ordinal":144804,"en":"Here are we, your forty companion-uncles.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0897:b005:l006","ordinal":144805,"en":"Here is bush-covered Talas, your land;"},{"id":"semetey-1-2013:p0897:b005:l007","ordinal":144806,"en":"Here are we, the companions of old."},{"id":"semetey-1-2013:p0897:b005:l008","ordinal":144807,"en":"The inheritance left by your father—"},{"id":"semetey-1-2013:p0897:b005:l009","ordinal":144808,"en":"If you will receive it, here we are."},{"id":"semetey-1-2013:p0897:b005:l010","ordinal":144809,"en":"Here are the Kyrgyz people with their ruler;"},{"id":"semetey-1-2013:p0897:b005:l011","ordinal":144810,"en":"If you will take heads, here we are."},{"id":"semetey-1-2013:p0897:b005:l012","ordinal":144811,"en":"Orphan, our support, listen:"},{"id":"semetey-1-2013:p0897:b005:l013","ordinal":144812,"en":"If you will dig deep, here is the pit;"},{"id":"semetey-1-2013:p0897:b005:l014","ordinal":144813,"en":"If you will boil, here is the brine."},{"id":"semetey-1-2013:p0897:b005:l015","ordinal":144814,"en":"My only one left by the ruler,"},{"id":"semetey-1-2013:p0897:b005:l016","ordinal":144815,"en":"Bind and kill us—here are our hands."},{"id":"semetey-1-2013:p0897:b005:l017","ordinal":144816,"en":"Struck by the spirits, smitten by the oath,"},{"id":"semetey-1-2013:p0897:b005:l018","ordinal":144817,"en":"Here are we of treacherous intent!"},{"id":"semetey-1-2013:p0897:b005:l021","ordinal":144818,"en":"Not fearing oath or ancestral spirits,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0897:b005:l022","ordinal":144819,"en":"In the end it strikes us!"},{"id":"semetey-1-2013:p0897:b005:l023","ordinal":144820,"en":"We forty companions scattered"},{"id":"semetey-1-2013:p0897:b005:l024","ordinal":144821,"en":"When your fortunate elder died,"},{"id":"semetey-1-2013:p0897:b005:l025","ordinal":144822,"en":"Hiding ourselves in Talas,"},{"id":"semetey-1-2013:p0897:b005:l026","ordinal":144823,"en":"You, whom we took as our support,"},{"id":"semetey-1-2013:p0897:b005:l027","ordinal":144824,"en":"We drove fleeing toward Bukhara."},{"id":"semetey-1-2013:p0897:b005:l028","ordinal":144825,"en":"When your fearless father was alive,"},{"id":"semetey-1-2013:p0897:b005:l030","ordinal":144826,"en":"Acting like the damned, firing shots,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0897:b005:l031","ordinal":144827,"en":"All of us fell into turmoil;"},{"id":"semetey-1-2013:p0897:b005:l032","ordinal":144828,"en":"Today you have laid us low."},{"id":"semetey-1-2013:p0897:b005:l033","ordinal":144829,"en":"If you desire, slaughter us;"},{"id":"semetey-1-2013:p0897:b005:l034","ordinal":144830,"en":"If your heart is unwilling,"},{"id":"semetey-1-2013:p0897:b005:l035","ordinal":144831,"en":"Leave us alive, sprawled as we are!"},{"id":"semetey-1-2013:p0897:b005:l036","ordinal":144832,"en":"If you seek spoils, here is the livestock;"},{"id":"semetey-1-2013:p0897:b005:l037","ordinal":144833,"en":"If you wish it to flow, here is red blood;"},{"id":"semetey-1-2013:p0897:b005:l038","ordinal":144834,"en":"If you will cut it short, here is life!"},{"id":"semetey-1-2013:p0897:b005:l039","ordinal":144835,"en":"Khan Manas’s orphan,"},{"id":"semetey-1-2013:p0898:b003:l001","ordinal":144836,"en":"Disheartened, from various places"},{"id":"semetey-1-2013:p0898:b003:l002","ordinal":144837,"en":"We moved to Talas."},{"id":"semetey-1-2013:p0898:b003:l003","ordinal":144838,"en":"We gathered as companions"},{"id":"semetey-1-2013:p0898:b003:l004","ordinal":144839,"en":"Around Lord Manas, the leopard."},{"id":"semetey-1-2013:p0898:b003:l005","ordinal":144840,"en":"Our horses grew fat, and we grew strong,"},{"id":"semetey-1-2013:p0898:b003:l006","ordinal":144841,"en":"Coming from many places, we became forty."},{"id":"semetey-1-2013:p0898:b003:l007","ordinal":144842,"en":"We grew eager for heroic deeds;"},{"id":"semetey-1-2013:p0898:b003:l008","ordinal":144843,"en":"We gathered from forty places."},{"id":"semetey-1-2013:p0898:b003:l009","ordinal":144844,"en":"Our elders, led by Kyrgyl,"},{"id":"semetey-1-2013:p0898:b003:l010","ordinal":144845,"en":"All the forty companions—"},{"id":"semetey-1-2013:p0898:b003:l011","ordinal":144846,"en":"We became a spectacle and were slaughtered."},{"id":"semetey-1-2013:p0898:b003:l012","ordinal":144847,"en":"Forgetting the past,"},{"id":"semetey-1-2013:p0898:b003:l013","ordinal":144848,"en":"We turned back toward the ancestral spirit."},{"id":"semetey-1-2013:p0898:b003:l014","ordinal":144849,"en":"Seeking to obey Kobosh,"},{"id":"semetey-1-2013:p0898:b003:l015","ordinal":144850,"en":"Openly firing upon you,"},{"id":"semetey-1-2013:p0898:b003:l017","ordinal":144851,"en":"Yrchy-uul and Bozuul—","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0898:b003:l018","ordinal":144852,"en":"We lost those two."},{"id":"semetey-1-2013:p0898:b003:l019","ordinal":144853,"en":"In madness, we forty companions"},{"id":"semetey-1-2013:p0898:b003:l020","ordinal":144854,"en":"Attacked you."},{"id":"semetey-1-2013:p0898:b003:l021","ordinal":144855,"en":"Bereft of our comrades,"},{"id":"semetey-1-2013:p0898:b003:l022","ordinal":144856,"en":"May we forty companions perish—"},{"id":"semetey-1-2013:p0898:b003:l023","ordinal":144857,"en":"We have become rabid!"},{"id":"semetey-1-2013:p0898:b003:l025","ordinal":144858,"en":"We have fallen into your hands, my orphan;","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0898:b003:l026","ordinal":144859,"en":"There is no daylight for us apart from you."},{"id":"semetey-1-2013:p0898:b003:l027","ordinal":144860,"en":"If you wish, leave us alive;"},{"id":"semetey-1-2013:p0898:b003:l028","ordinal":144861,"en":"If you grow wrathful,"},{"id":"semetey-1-2013:p0898:b003:l029","ordinal":144862,"en":"Here are the forty companions—slaughter us!"},{"id":"semetey-1-2013:p0898:b003:l030","ordinal":144863,"en":"We have no garden established in Talas,"},{"id":"semetey-1-2013:p0898:b003:l031","ordinal":144864,"en":"No time to lie sprawled at ease."},{"id":"semetey-1-2013:p0898:b003:l032","ordinal":144865,"en":"No garden established in Keng-Kol,"},{"id":"semetey-1-2013:p0898:b003:l033","ordinal":144866,"en":"The forty companions taken captive"},{"id":"semetey-1-2013:p0898:b003:l034","ordinal":144867,"en":"Have no time to lie at leisure!”"},{"id":"semetey-1-2013:p0898:b003:l035","ordinal":144868,"en":"The forty companions cried aloud,"},{"id":"semetey-1-2013:p0898:b003:l036","ordinal":144869,"en":"“Of Manas, gone to Judgment,"},{"id":"semetey-1-2013:p0898:b003:l037","ordinal":144870,"en":"The spirit!” they sobbed."},{"id":"semetey-1-2013:p0898:b003:l038","ordinal":144871,"en":"When he saw the forty companions,"},{"id":"semetey-1-2013:p0898:b003:l039","ordinal":144872,"en":"Semetey, son of the mighty one,"},{"id":"semetey-1-2013:p0898:b004:l001","ordinal":144873,"en":"Bent his knees to the earth;"},{"id":"semetey-1-2013:p0898:b004:l002","ordinal":144874,"en":"From Taibuurul’s back"},{"id":"semetey-1-2013:p0898:b004:l003","ordinal":144875,"en":"He sprang down in haste."},{"id":"semetey-1-2013:p0898:b004:l004","ordinal":144876,"en":"“From my father gone to the other world,"},{"id":"semetey-1-2013:p0898:b004:l005","ordinal":144877,"en":"The support I have inherited,"},{"id":"semetey-1-2013:p0898:b004:l006","ordinal":144878,"en":"My dear forty uncles!"},{"id":"semetey-1-2013:p0898:b004:l007","ordinal":144879,"en":"For whose sake did I return?"},{"id":"semetey-1-2013:p0898:b004:l008","ordinal":144880,"en":"For the strong-backed Kyrgyz people,"},{"id":"semetey-1-2013:p0898:b004:l009","ordinal":144881,"en":"And my journey was for your sake!"},{"id":"semetey-1-2013:p0898:b004:l010","ordinal":144882,"en":"My shelter, which the lion relied upon,"},{"id":"semetey-1-2013:p0898:b004:l011","ordinal":144883,"en":"From my father gone to the other world,"},{"id":"semetey-1-2013:p0898:b004:l012","ordinal":144884,"en":"The good fortune I inherited."},{"id":"semetey-1-2013:p0898:b004:l013","ordinal":144885,"en":"When I send you ahead, my auspicious path;"},{"id":"semetey-1-2013:p0898:b004:l014","ordinal":144886,"en":"The support left by my father—"},{"id":"semetey-1-2013:p0898:b004:l015","ordinal":144887,"en":"When I lead you, my countless army."},{"id":"semetey-1-2013:p0898:b004:l017","ordinal":144888,"en":"Against the seething unbelievers,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0898:b004:l018","ordinal":144889,"en":"When you charge, you satisfy my longing."},{"id":"semetey-1-2013:p0898:b004:l020","ordinal":144890,"en":"Twelve times against Beijing,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0898:b004:l021","ordinal":144891,"en":"When I fight, you satisfy my longing."},{"id":"semetey-1-2013:p0898:b004:l022","ordinal":144892,"en":"My cliff too high for geese to circle,"},{"id":"semetey-1-2013:p0898:b004:l023","ordinal":144893,"en":"The support left by my father"},{"id":"semetey-1-2013:p0898:b004:l024","ordinal":144894,"en":"He has now placed in my hands."},{"id":"semetey-1-2013:p0898:b004:l025","ordinal":144895,"en":"I can give myself to You, my God!"},{"id":"semetey-1-2013:p0898:b004:l026","ordinal":144896,"en":"From my royal father, the fierce hero,"}]
