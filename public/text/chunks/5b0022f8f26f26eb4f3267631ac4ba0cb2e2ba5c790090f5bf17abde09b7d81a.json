[{"id":"manas-2010:p0720:b001:l001","ordinal":32001,"en":"To the headland where the mountains ended"},{"id":"manas-2010:p0720:b001:l002","ordinal":32002,"en":"Bakai rode,"},{"id":"manas-2010:p0720:b001:l003","ordinal":32003,"en":"Scouting the patrol's route."},{"id":"manas-2010:p0720:b001:l004","ordinal":32004,"en":"Your valiant elder Bakai"},{"id":"manas-2010:p0720:b001:l005","ordinal":32005,"en":"Climbed up to keep watch."},{"id":"manas-2010:p0720:b001:l006","ordinal":32006,"en":"When he looked out carefully,"},{"id":"manas-2010:p0720:b001:l007","ordinal":32007,"en":"Beside Böyrök and Ak-Chiy,"},{"id":"manas-2010:p0720:b001:l008","ordinal":32008,"en":"From the mountain called Akchyk,"},{"id":"manas-2010:p0720:b001:l009","ordinal":32009,"en":"In its descending hollow,"},{"id":"manas-2010:p0720:b001:l010","ordinal":32010,"en":"Beside the great Ak-Chiy,"},{"id":"manas-2010:p0720:b001:l011","ordinal":32011,"en":"That swine's tent stood pitched,"},{"id":"manas-2010:p0720:b001:l012","ordinal":32012,"en":"With its golden fastening cords."},{"id":"manas-2010:p0720:b001:l013","ordinal":32013,"en":"He had halted for a day's rest,"},{"id":"manas-2010:p0720:b001:l014","ordinal":32014,"en":"The warrior Khan Alööke."},{"id":"manas-2010:p0720:b001:l015","ordinal":32015,"en":"Smoke rose in billowing streams;"},{"id":"manas-2010:p0720:b001:l016","ordinal":32016,"en":"Alööke's countless troops"},{"id":"manas-2010:p0720:b001:l017","ordinal":32017,"en":"Could be seen encamped."},{"id":"manas-2010:p0720:b001:l018","ordinal":32018,"en":"They slept propped on their elbows,"},{"id":"manas-2010:p0720:b001:l019","ordinal":32019,"en":"Sounded trumpets and rested at ease."},{"id":"manas-2010:p0720:b001:l020","ordinal":32020,"en":"From a mule that had a foal"},{"id":"manas-2010:p0720:b001:l021","ordinal":32021,"en":"They slew her foal, leaving her alone,"},{"id":"manas-2010:p0720:b001:l022","ordinal":32022,"en":"“From bloodthirsty Manas the warrior,"},{"id":"manas-2010:p0720:b001:l023","ordinal":32023,"en":"We have escaped,” they thought."},{"id":"manas-2010:p0720:b001:l024","ordinal":32024,"en":"The mighty Torghut and Manchu men"},{"id":"manas-2010:p0720:b001:l025","ordinal":32025,"en":"Lay sprawling without a stir,"},{"id":"manas-2010:p0720:b001:l026","ordinal":32026,"en":"At the thought, “An enemy may come pursuing,”"},{"id":"manas-2010:p0720:b001:l027","ordinal":32027,"en":"Untroubled, without a stir."},{"id":"manas-2010:p0720:b001:l028","ordinal":32028,"en":"There lay Alööke;"},{"id":"manas-2010:p0720:b001:l029","ordinal":32029,"en":"Countless stores of gold and silver,"},{"id":"manas-2010:p0720:b001:l030","ordinal":32030,"en":"Taken as booty from the Burut,"},{"id":"manas-2010:p0720:b001:l031","ordinal":32031,"en":"Alööke had loaded up."},{"id":"manas-2010:p0720:b001:l032","ordinal":32032,"en":"They were surely no ordinary horses:"},{"id":"manas-2010:p0720:b001:l033","ordinal":32033,"en":"The beasts he kept were his weapons."},{"id":"manas-2010:p0720:b001:l034","ordinal":32034,"en":"Every one of those accursed creatures"},{"id":"manas-2010:p0720:b001:l035","ordinal":32035,"en":"Had hooves of cast iron."},{"id":"manas-2010:p0720:b001:l036","ordinal":32036,"en":"All his equipment was complete."},{"id":"manas-2010:p0720:b001:l037","ordinal":32037,"en":"That accursed Alööke"},{"id":"manas-2010:p0720:b001:l038","ordinal":32038,"en":"To all eighteen thousand worlds,"},{"id":"manas-2010:p0720:b001:l039","ordinal":32039,"en":"He seemed invincible."},{"id":"manas-2010:p0720:b001:l040","ordinal":32040,"en":"No beast could catch them in pursuit;"},{"id":"manas-2010:p0720:b001:l041","ordinal":32041,"en":"His beasts flew like clouds."},{"id":"manas-2010:p0720:b001:l042","ordinal":32042,"en":"If vast hosts of foes barred his way,"},{"id":"manas-2010:p0721:b001:l001","ordinal":32043,"en":"He had the strength to resist capture."},{"id":"manas-2010:p0721:b001:l002","ordinal":32044,"en":"The reason he could resist capture:"},{"id":"manas-2010:p0721:b001:l003","ordinal":32045,"en":"Even laden with terribly heavy loads,"},{"id":"manas-2010:p0721:b001:l004","ordinal":32046,"en":"Never bending beneath them,"},{"id":"manas-2010:p0721:b001:l005","ordinal":32047,"en":"He had red-tailed dromedaries."},{"id":"manas-2010:p0721:b001:l006","ordinal":32048,"en":"Ruling the people for forty years,"},{"id":"manas-2010:p0721:b001:l007","ordinal":32049,"en":"Alöökö of the Chinese"},{"id":"manas-2010:p0721:b001:l008","ordinal":32050,"en":"Had grown exceedingly wild."},{"id":"manas-2010:p0721:b001:l009","ordinal":32051,"en":"Even if Chalyyar swept upon him,"},{"id":"manas-2010:p0721:b001:l010","ordinal":32052,"en":"He had the strength to fight."},{"id":"manas-2010:p0721:b001:l011","ordinal":32053,"en":"To carry his loads tirelessly,"},{"id":"manas-2010:p0721:b001:l012","ordinal":32054,"en":"He had rhinoceroses and elephants."},{"id":"manas-2010:p0721:b001:l013","ordinal":32055,"en":"No man could come and attack:"},{"id":"manas-2010:p0721:b001:l014","ordinal":32056,"en":"Such was Alöökö's fearsome presence."},{"id":"manas-2010:p0721:b001:l015","ordinal":32057,"en":"With house-sized clubs in their hands,"},{"id":"manas-2010:p0721:b001:l016","ordinal":32058,"en":"Every piece of equipment ready,"},{"id":"manas-2010:p0721:b001:l017","ordinal":32059,"en":"Beside Alöökö,"},{"id":"manas-2010:p0721:b001:l018","ordinal":32060,"en":"As though they would slaughter everyone,"},{"id":"manas-2010:p0721:b001:l019","ordinal":32061,"en":"The champions lay,"},{"id":"manas-2010:p0721:b001:l020","ordinal":32062,"en":"Bound with restraining yokes."},{"id":"manas-2010:p0721:b001:l021","ordinal":32063,"en":"If a champion broke free of his yoke,"},{"id":"manas-2010:p0721:b001:l022","ordinal":32064,"en":"He would pass through slaughtering all."},{"id":"manas-2010:p0721:b001:l023","ordinal":32065,"en":"Unless help came from God,"},{"id":"manas-2010:p0721:b001:l024","ordinal":32066,"en":"Daughter-damned Alöökö"},{"id":"manas-2010:p0721:b001:l025","ordinal":32067,"en":"Would wreak a massacre."},{"id":"manas-2010:p0721:b001:l026","ordinal":32068,"en":"On the ridge of Kashalay,"},{"id":"manas-2010:p0721:b001:l027","ordinal":32069,"en":"He had posted a strong lookout."},{"id":"manas-2010:p0721:b001:l028","ordinal":32070,"en":"Beside the deep water,"},{"id":"manas-2010:p0721:b001:l029","ordinal":32071,"en":"Half the champions were there."},{"id":"manas-2010:p0721:b001:l030","ordinal":32072,"en":"Gathering many soldiers, assembling an army,"},{"id":"manas-2010:p0721:b001:l031","ordinal":32073,"en":"In this world, Alöökö"},{"id":"manas-2010:p0721:b001:l032","ordinal":32074,"en":"Had become impossible to capture."},{"id":"manas-2010:p0721:b001:l033","ordinal":32075,"en":"To tend Alöökö,"},{"id":"manas-2010:p0721:b001:l034","ordinal":32076,"en":"He had guards and giants,"},{"id":"manas-2010:p0721:b001:l035","ordinal":32077,"en":"He had champions and khans."},{"id":"manas-2010:p0721:b001:l036","ordinal":32078,"en":"Beside Alöökö,"},{"id":"manas-2010:p0721:b001:l037","ordinal":32079,"en":"Every calamity was present."},{"id":"manas-2010:p0721:b001:l038","ordinal":32080,"en":"He had heroes, he had warriors,"},{"id":"manas-2010:p0721:b001:l039","ordinal":32081,"en":"He had countless formidable lions."},{"id":"manas-2010:p0721:b001:l040","ordinal":32082,"en":"In the tent with golden ties,"},{"id":"manas-2010:p0721:b001:l041","ordinal":32083,"en":"Hero Alöökö the warrior"},{"id":"manas-2010:p0721:b001:l042","ordinal":32084,"en":"Had taken six wives,"},{"id":"manas-2010:p0722:b001:l001","ordinal":32085,"en":"And had become father to sixty sons."},{"id":"manas-2010:p0722:b001:l002","ordinal":32086,"en":"This swine, may he burn to death,"},{"id":"manas-2010:p0722:b001:l003","ordinal":32087,"en":"Of this world's gains,"},{"id":"manas-2010:p0722:b001:l004","ordinal":32088,"en":"Had gathered all, leaving none."},{"id":"manas-2010:p0722:b001:l005","ordinal":32089,"en":"Many soldiers, an army assembling,"},{"id":"manas-2010:p0722:b001:l006","ordinal":32090,"en":"Alöökö had taken them,"},{"id":"manas-2010:p0722:b001:l007","ordinal":32091,"en":"Gathering his heroes in abundance."},{"id":"manas-2010:p0722:b001:l008","ordinal":32092,"en":"Smoke rose and billowed;"},{"id":"manas-2010:p0722:b001:l009","ordinal":32093,"en":"Even if the Flood surged forth,"},{"id":"manas-2010:p0722:b001:l010","ordinal":32094,"en":"Daughter-damned Alöökö"},{"id":"manas-2010:p0722:b001:l011","ordinal":32095,"en":"Seemed beyond defeat."},{"id":"manas-2010:p0722:b001:l012","ordinal":32096,"en":"There were skilled wielders of swords,"},{"id":"manas-2010:p0722:b001:l013","ordinal":32097,"en":"Who knew the enemy's tactics well,"},{"id":"manas-2010:p0722:b001:l014","ordinal":32098,"en":"Strong men with thick wrists."},{"id":"manas-2010:p0722:b001:l015","ordinal":32099,"en":"There were heroes who swung axes."},{"id":"manas-2010:p0722:b001:l016","ordinal":32100,"en":"Beside Alöökö,"},{"id":"manas-2010:p0722:b001:l017","ordinal":32101,"en":"Who would not heed spoken words,"},{"id":"manas-2010:p0722:b001:l018","ordinal":32102,"en":"Who uttered no words when they shouted,"},{"id":"manas-2010:p0722:b001:l019","ordinal":32103,"en":"Were unbelievers worse than beasts."},{"id":"manas-2010:p0722:b001:l020","ordinal":32104,"en":"Their bodies strange, their venom strong,"},{"id":"manas-2010:p0722:b001:l021","ordinal":32105,"en":"When you grappled with them,"},{"id":"manas-2010:p0722:b001:l022","ordinal":32106,"en":"Abandon hope for your dear life!"},{"id":"manas-2010:p0722:b001:l023","ordinal":32107,"en":"Alöökö's champions,"},{"id":"manas-2010:p0722:b001:l024","ordinal":32108,"en":"Each one like a different mountain:"},{"id":"manas-2010:p0722:b001:l025","ordinal":32109,"en":"Would a mortal go to face them?"},{"id":"manas-2010:p0722:b001:l026","ordinal":32110,"en":"Unless it were champion Manas,"},{"id":"manas-2010:p0722:b001:l027","ordinal":32111,"en":"Could a man confront them?"},{"id":"manas-2010:p0722:b001:l028","ordinal":32112,"en":"Like Mount Opol appeared"},{"id":"manas-2010:p0722:b001:l029","ordinal":32113,"en":"Alöökö's towering form."},{"id":"manas-2010:p0722:b001:l030","ordinal":32114,"en":"In front of his tent,"},{"id":"manas-2010:p0722:b001:l031","ordinal":32115,"en":"Rhinoceroses, mules and wondrous steeds,"},{"id":"manas-2010:p0722:b001:l032","ordinal":32116,"en":"He had tethered, making them strain."},{"id":"manas-2010:p0722:b001:l033","ordinal":32117,"en":"Steamed buns and hand-pulled noodles,"},{"id":"manas-2010:p0722:b001:l034","ordinal":32118,"en":"Boiling in a traveling pot,"},{"id":"manas-2010:p0722:b001:l035","ordinal":32119,"en":"Thus Alöökö lay."},{"id":"manas-2010:p0722:b001:l036","ordinal":32120,"en":"When he saw Alöökö,"},{"id":"manas-2010:p0722:b001:l037","ordinal":32121,"en":"Bakay's heart was divided."},{"id":"manas-2010:p0722:b001:l038","ordinal":32122,"en":"Of the eighteen thousand worlds,"},{"id":"manas-2010:p0722:b001:l039","ordinal":32123,"en":"Even if their champions swept upon him,"},{"id":"manas-2010:p0722:b001:l040","ordinal":32124,"en":"Unless it were warrior Manas,"},{"id":"manas-2010:p0722:b001:l041","ordinal":32125,"en":"He seemed impossible to overcome."},{"id":"manas-2010:p0722:b001:l042","ordinal":32126,"en":"Of the Chinese with rank-balls on their caps,"},{"id":"manas-2010:p0723:b001:l001","ordinal":32127,"en":"Many were there."},{"id":"manas-2010:p0723:b001:l002","ordinal":32128,"en":"Who would smash those they grappled with,"},{"id":"manas-2010:p0723:b001:l003","ordinal":32129,"en":"Their champions were there."},{"id":"manas-2010:p0723:b001:l004","ordinal":32130,"en":"With no hair on their foreheads,"},{"id":"manas-2010:p0723:b001:l005","ordinal":32131,"en":"Their bald ones were there."},{"id":"manas-2010:p0723:b001:l006","ordinal":32132,"en":"Unlike the created sons of men,"},{"id":"manas-2010:p0723:b001:l007","ordinal":32133,"en":"Different beings were there."},{"id":"manas-2010:p0723:b001:l008","ordinal":32134,"en":"Your unbeliever, Khan Alöökö,"},{"id":"manas-2010:p0723:b001:l009","ordinal":32135,"en":"Your warrior, full of vigor,"},{"id":"manas-2010:p0723:b001:l010","ordinal":32136,"en":"When he came to take hostages,"},{"id":"manas-2010:p0723:b001:l011","ordinal":32137,"en":"The Chinese, the people of forty khans,"},{"id":"manas-2010:p0723:b001:l012","ordinal":32138,"en":"He had gathered them all,"},{"id":"manas-2010:p0723:b001:l013","ordinal":32139,"en":"And set them marching in a long line."},{"id":"manas-2010:p0723:b001:l014","ordinal":32140,"en":"Uncommonly full of wrath,"},{"id":"manas-2010:p0723:b001:l015","ordinal":32141,"en":"He had chosen from the champions."},{"id":"manas-2010:p0723:b001:l016","ordinal":32142,"en":"Wearing trousers of hide,"},{"id":"manas-2010:p0723:b001:l017","ordinal":32143,"en":"Whoever defied them,"},{"id":"manas-2010:p0723:b001:l018","ordinal":32144,"en":"They slit his very scalp."},{"id":"manas-2010:p0723:b001:l019","ordinal":32145,"en":"He had chosen blood-drinkers,"},{"id":"manas-2010:p0723:b001:l020","ordinal":32146,"en":"With eyebrows like a dog lying down,"},{"id":"manas-2010:p0723:b001:l021","ordinal":32147,"en":"With heads like traveling cauldrons,"},{"id":"manas-2010:p0723:b001:l022","ordinal":32148,"en":"He had chosen devouring monsters."},{"id":"manas-2010:p0723:b001:l023","ordinal":32149,"en":"When they charged,"},{"id":"manas-2010:p0723:b001:l024","ordinal":32150,"en":"They would strike like wolves."},{"id":"manas-2010:p0723:b001:l025","ordinal":32151,"en":"Unless it were wrathful Manas,"},{"id":"manas-2010:p0723:b001:l026","ordinal":32152,"en":"The men who grappled with them,"},{"id":"manas-2010:p0723:b001:l027","ordinal":32153,"en":"They would tear to pieces."},{"id":"manas-2010:p0723:b001:l028","ordinal":32154,"en":"Like cauldron-baskets they bulged,"},{"id":"manas-2010:p0723:b001:l029","ordinal":32155,"en":"The ears of each one."},{"id":"manas-2010:p0723:b001:l030","ordinal":32156,"en":"To Khan Bakay, who had seen many lands,"},{"id":"manas-2010:p0723:b001:l031","ordinal":32157,"en":"Unlike mortals appeared"},{"id":"manas-2010:p0723:b001:l032","ordinal":32158,"en":"The bearing of these Chinese."},{"id":"manas-2010:p0723:b001:l033","ordinal":32159,"en":"Unless it were wolf-maned Manas,"},{"id":"manas-2010:p0723:b001:l034","ordinal":32160,"en":"Could anyone approach their edge?"},{"id":"manas-2010:p0723:b001:l035","ordinal":32161,"en":"They were people beyond measure;"},{"id":"manas-2010:p0723:b001:l036","ordinal":32162,"en":"Could anyone who fought them survive?"},{"id":"manas-2010:p0723:b001:l037","ordinal":32163,"en":"Your warrior, hero Alöökö,"},{"id":"manas-2010:p0723:b001:l038","ordinal":32164,"en":"Had lain down in the tent."},{"id":"manas-2010:p0723:b001:l039","ordinal":32165,"en":"Champions holding iron-headed clubs"},{"id":"manas-2010:p0723:b001:l040","ordinal":32166,"en":"Had surrounded him."},{"id":"manas-2010:p0723:b001:l041","ordinal":32167,"en":"Those mounted on mules and rhinoceroses,"},{"id":"manas-2010:p0723:b001:l042","ordinal":32168,"en":"With battle-axes in their hands,"},{"id":"manas-2010:p0724:b001:l001","ordinal":32169,"en":"Were walking to and fro."},{"id":"manas-2010:p0724:b001:l002","ordinal":32170,"en":"Great mastiffs, large as oxen,"},{"id":"manas-2010:p0724:b001:l003","ordinal":32171,"en":"Barked in a clamor."},{"id":"manas-2010:p0724:b001:l004","ordinal":32172,"en":"Examining every aspect,"},{"id":"manas-2010:p0724:b001:l005","ordinal":32173,"en":"They seemed ready to bring calamity."},{"id":"manas-2010:p0724:b001:l006","ordinal":32174,"en":"An enemy who clashed with them,"},{"id":"manas-2010:p0724:b001:l007","ordinal":32175,"en":"Bringing ruin upon his head,"},{"id":"manas-2010:p0724:b001:l008","ordinal":32176,"en":"The champions would bind him."},{"id":"manas-2010:p0724:b001:l009","ordinal":32177,"en":"No man could make them bow."},{"id":"manas-2010:p0724:b001:l010","ordinal":32178,"en":"To the unbeliever whose path was accursed,"},{"id":"manas-2010:p0724:b001:l011","ordinal":32179,"en":"No mortal could draw near."},{"id":"manas-2010:p0724:b001:l012","ordinal":32180,"en":"Born into this world,"},{"id":"manas-2010:p0724:b001:l013","ordinal":32181,"en":"They had come in many different forms."},{"id":"manas-2010:p0724:b001:l014","ordinal":32182,"en":"In the darkness of a moonless night,"},{"id":"manas-2010:p0724:b001:l015","ordinal":32183,"en":"At beings standing far away,"},{"id":"manas-2010:p0724:b001:l016","ordinal":32184,"en":"There were marksmen who never missed."},{"id":"manas-2010:p0724:b001:l017","ordinal":32185,"en":"There were men who said, ‘Where is the enemy?’"},{"id":"manas-2010:p0724:b001:l018","ordinal":32186,"en":"If they captured us,"},{"id":"manas-2010:p0724:b001:l019","ordinal":32187,"en":"They would boil us in place of sheep;"},{"id":"manas-2010:p0724:b001:l020","ordinal":32188,"en":"There were men who would put us in a pot and eat us."},{"id":"manas-2010:p0724:b001:l021","ordinal":32189,"en":"No mortal could face them,"},{"id":"manas-2010:p0724:b001:l022","ordinal":32190,"en":"None who faced them could prevail."},{"id":"manas-2010:p0724:b001:l023","ordinal":32191,"en":"It had surpassed all bounds,"},{"id":"manas-2010:p0724:b001:l024","ordinal":32192,"en":"Alöökö's splendor."},{"id":"manas-2010:p0724:b001:l025","ordinal":32193,"en":"Astonished, hero Bakay said:"},{"id":"manas-2010:p0724:b001:l026","ordinal":32194,"en":"‘If by chance we clash with him,"},{"id":"manas-2010:p0724:b001:l027","ordinal":32195,"en":"His troops will ride out in vast hosts."},{"id":"manas-2010:p0724:b001:l028","ordinal":32196,"en":"In a dreadful sickness with no escape,"},{"id":"manas-2010:p0724:b001:l029","ordinal":32197,"en":"Our poor souls will now be caught!’"},{"id":"manas-2010:p0724:b001:l030","ordinal":32198,"en":"As he watched, Bakay's"},{"id":"manas-2010:p0724:b001:l031","ordinal":32199,"en":"Heart faltered and was divided."},{"id":"manas-2010:p0724:b001:l032","ordinal":32200,"en":"To anyone who clashed with him, Alöökö"},{"id":"manas-2010:p0724:b001:l033","ordinal":32201,"en":"Showed the aspect of a devouring monster."},{"id":"manas-2010:p0724:b001:l034","ordinal":32202,"en":"When he saw Alöökö,"},{"id":"manas-2010:p0724:b001:l035","ordinal":32203,"en":"Your elder, saintly Bakay,"},{"id":"manas-2010:p0724:b001:l036","ordinal":32204,"en":"Troubled and distraught,"},{"id":"manas-2010:p0724:b001:l037","ordinal":32205,"en":"Beseeched the Creator."},{"id":"manas-2010:p0724:b001:l038","ordinal":32206,"en":"When he saw Alöökö,"},{"id":"manas-2010:p0724:b001:l039","ordinal":32207,"en":"Bakay stood grieving:"},{"id":"manas-2010:p0724:b001:l040","ordinal":32208,"en":"‘Your father's grave! Alöökö"},{"id":"manas-2010:p0724:b001:l041","ordinal":32209,"en":"Is a man of surpassing strength."},{"id":"manas-2010:p0724:b001:l042","ordinal":32210,"en":"For the teeming Chinese of Beijing,"},{"id":"manas-2010:p0725:b001:l001","ordinal":32211,"en":"He is a fortress brought into being."},{"id":"manas-2010:p0725:b001:l002","ordinal":32212,"en":"His standing to take hostages,"},{"id":"manas-2010:p0725:b001:l003","ordinal":32213,"en":"His idol-like might befits him."},{"id":"manas-2010:p0725:b001:l004","ordinal":32214,"en":"Laying the teeming people waste,"},{"id":"manas-2010:p0725:b001:l005","ordinal":32215,"en":"What he has done befits him."},{"id":"manas-2010:p0725:b001:l006","ordinal":32216,"en":"Upon the Kyrgyz, terrible havoc,"},{"id":"manas-2010:p0725:b001:l007","ordinal":32217,"en":"What he has done befits him."},{"id":"manas-2010:p0725:b001:l008","ordinal":32218,"en":"If the moon darkens under cloud,"},{"id":"manas-2010:p0725:b001:l009","ordinal":32219,"en":"What will become of the night?’ he said."},{"id":"manas-2010:p0725:b001:l010","ordinal":32220,"en":"‘He was a hero born a leopard;"},{"id":"manas-2010:p0725:b001:l011","ordinal":32221,"en":"God, protect Manas!"},{"id":"manas-2010:p0725:b001:l012","ordinal":32222,"en":"If he clashes with the unbeliever,"},{"id":"manas-2010:p0725:b001:l013","ordinal":32223,"en":"What will become of the day?’ he said."},{"id":"manas-2010:p0725:b001:l014","ordinal":32224,"en":"Staring dazed in wonder,"},{"id":"manas-2010:p0725:b001:l015","ordinal":32225,"en":"On his painted spear with a steel point,"},{"id":"manas-2010:p0725:b001:l016","ordinal":32226,"en":"Wolf-maned Bakay leaned,"},{"id":"manas-2010:p0725:b001:l017","ordinal":32227,"en":"And turned his gray steed's head."},{"id":"manas-2010:p0725:b001:l018","ordinal":32228,"en":"Of a great khan like Alöökö,"},{"id":"manas-2010:p0725:b001:l019","ordinal":32229,"en":"When he saw every aspect,"},{"id":"manas-2010:p0725:b001:l020","ordinal":32230,"en":"He stood astonished."},{"id":"manas-2010:p0725:b001:l021","ordinal":32231,"en":"‘He is a champion, he is a man;"},{"id":"manas-2010:p0725:b001:l022","ordinal":32232,"en":"God, protect the champion!"},{"id":"manas-2010:p0725:b001:l023","ordinal":32233,"en":"Not only against us, Alöökö"},{"id":"manas-2010:p0725:b001:l024","ordinal":32234,"en":"Has strength to face the world."},{"id":"manas-2010:p0725:b001:l025","ordinal":32235,"en":"His courage is resolute and fearless."},{"id":"manas-2010:p0725:b001:l026","ordinal":32236,"en":"His Torguts, Chinese and Manchus,"},{"id":"manas-2010:p0725:b001:l027","ordinal":32237,"en":"His champions are many.’"},{"id":"manas-2010:p0725:b001:l028","ordinal":32238,"en":"Astonished, Khan Bakay said,"},{"id":"manas-2010:p0725:b001:l029","ordinal":32239,"en":"‘Allah, what will happen?’"},{"id":"manas-2010:p0725:b001:l030","ordinal":32240,"en":"And now grew faint and wavering."},{"id":"manas-2010:p0725:b001:l031","ordinal":32241,"en":"Before he had closed his mouth,"},{"id":"manas-2010:p0725:b001:l032","ordinal":32242,"en":"Before he could say this or that,"},{"id":"manas-2010:p0725:b001:l033","ordinal":32243,"en":"With bloodthirsty Manas in front,"},{"id":"manas-2010:p0725:b001:l034","ordinal":32244,"en":"Bearing a banner with a golden crescent,"},{"id":"manas-2010:p0725:b001:l035","ordinal":32245,"en":"The forty champions following him,"},{"id":"manas-2010:p0725:b001:l036","ordinal":32246,"en":"Manas appeared, looming tall."},{"id":"manas-2010:p0725:b001:l037","ordinal":32247,"en":"His thoughts bewildered,"},{"id":"manas-2010:p0725:b001:l038","ordinal":32248,"en":"Your bloodthirsty one, born generous,"},{"id":"manas-2010:p0725:b001:l039","ordinal":32249,"en":"To his elder Bakay"},{"id":"manas-2010:p0725:b001:l040","ordinal":32250,"en":"Could be seen approaching."},{"id":"manas-2010:p0725:b001:l041","ordinal":32251,"en":"All the forty champions,"},{"id":"manas-2010:p0725:b001:l042","ordinal":32252,"en":"Their elders led by Kyrgyl."},{"id":"manas-2010:p0726:b001:l001","ordinal":32253,"en":"When he turned and looked,"},{"id":"manas-2010:p0726:b001:l002","ordinal":32254,"en":"Of swift, lion-like Manas,"},{"id":"manas-2010:p0726:b001:l003","ordinal":32255,"en":"Whose form he had not seen before,"},{"id":"manas-2010:p0726:b001:l004","ordinal":32256,"en":"A black-spotted leopard,"}]
