[{"id":"semetey-1-2013:p1332:b003:l026","ordinal":177921,"en":"One road to Beijing"},{"id":"semetey-1-2013:p1332:b003:l027","ordinal":177922,"en":"Lets no one encountered escape alive;"},{"id":"semetey-1-2013:p1332:b003:l028","ordinal":177923,"en":"One road to Beijing"},{"id":"semetey-1-2013:p1332:b003:l029","ordinal":177924,"en":"Lets no one who meets it return alive."},{"id":"semetey-1-2013:p1332:b003:l030","ordinal":177925,"en":"An army awaits from Kaldai;"},{"id":"semetey-1-2013:p1332:b003:l031","ordinal":177926,"en":"The Black Chinese of Beijing"},{"id":"semetey-1-2013:p1332:b003:l032","ordinal":177927,"en":"Have a tale without end."},{"id":"semetey-1-2013:p1332:b003:l033","ordinal":177928,"en":"One road to Beijing"},{"id":"semetey-1-2013:p1332:b003:l034","ordinal":177929,"en":"Has a desert forty days across;"},{"id":"semetey-1-2013:p1332:b003:l035","ordinal":177930,"en":"Accursed Beijing"},{"id":"semetey-1-2013:p1332:b003:l036","ordinal":177931,"en":"Has many such tales."},{"id":"semetey-1-2013:p1332:b003:l037","ordinal":177932,"en":"If you ask the nature of the desert:"},{"id":"semetey-1-2013:p1332:b003:l038","ordinal":177933,"en":"Gray haze and burning dust;"},{"id":"semetey-1-2013:p1332:b003:l039","ordinal":177934,"en":"Many a soul, mouth hanging open,"},{"id":"semetey-1-2013:p1332:b004:l001","ordinal":177935,"en":"Upon reaching that desert,"},{"id":"semetey-1-2013:p1332:b004:l002","ordinal":177936,"en":"Died there gasping."},{"id":"semetey-1-2013:p1332:b004:l003","ordinal":177937,"en":"You have rolled up your sleeves,"},{"id":"semetey-1-2013:p1332:b004:l004","ordinal":177938,"en":"Saying you will enter straight"},{"id":"semetey-1-2013:p1332:b004:l005","ordinal":177939,"en":"And fight costly Beijing!"},{"id":"semetey-1-2013:p1332:b004:l006","ordinal":177940,"en":"Your uncle Bakai has grown old—"},{"id":"semetey-1-2013:p1332:b004:l007","ordinal":177941,"en":"Would you throw him to the khagan!"},{"id":"semetey-1-2013:p1332:b004:l008","ordinal":177942,"en":"If you grapple with Beijing,"},{"id":"semetey-1-2013:p1332:b004:l009","ordinal":177943,"en":"You need provisions and coats;"},{"id":"semetey-1-2013:p1332:b004:l010","ordinal":177944,"en":"Gather them from across the world,"},{"id":"semetey-1-2013:p1332:b004:l011","ordinal":177945,"en":"And you need at least ten thousand troops."},{"id":"semetey-1-2013:p1332:b004:l012","ordinal":177946,"en":"When you reach that desert,"},{"id":"semetey-1-2013:p1332:b004:l013","ordinal":177947,"en":"You need bull camels to haul the loads;"},{"id":"semetey-1-2013:p1332:b004:l014","ordinal":177948,"en":"The one you grapple is Kakan-Chyn—"},{"id":"semetey-1-2013:p1332:b004:l015","ordinal":177949,"en":"You need many things such as these!"},{"id":"semetey-1-2013:p1332:b004:l016","ordinal":177950,"en":"When you reach that desert,"},{"id":"semetey-1-2013:p1332:b004:l017","ordinal":177951,"en":"There is no grass to pinch and eat,"},{"id":"semetey-1-2013:p1332:b004:l018","ordinal":177952,"en":"No water to sip even a mouthful."},{"id":"semetey-1-2013:p1332:b004:l019","ordinal":177953,"en":"When a sandgrouse flies it is exhausted;"},{"id":"semetey-1-2013:p1332:b004:l020","ordinal":177954,"en":"When a black vulture flies,"},{"id":"semetey-1-2013:p1332:b004:l021","ordinal":177955,"en":"Its wings burn and tire."},{"id":"semetey-1-2013:p1332:b004:l022","ordinal":177956,"en":"A hero's eyes grow dim."},{"id":"semetey-1-2013:p1332:b004:l023","ordinal":177957,"en":"When crossing that desert,"},{"id":"semetey-1-2013:p1332:b004:l024","ordinal":177958,"en":"Your horse staggers in exhaustion;"},{"id":"semetey-1-2013:p1332:b004:l025","ordinal":177959,"en":"When you are losing consciousness,"},{"id":"semetey-1-2013:p1332:b004:l026","ordinal":177960,"en":"The accursed Chinese"},{"id":"semetey-1-2013:p1332:b004:l027","ordinal":177961,"en":"Have yet another wonder:"},{"id":"semetey-1-2013:p1332:b004:l028","ordinal":177962,"en":"They have a teeming people,"},{"id":"semetey-1-2013:p1332:b004:l029","ordinal":177963,"en":"And among that people"},{"id":"semetey-1-2013:p1332:b004:l030","ordinal":177964,"en":"Are giants of many kinds."},{"id":"semetey-1-2013:p1332:b004:l031","ordinal":177965,"en":"When they see an enemy, they strain;"},{"id":"semetey-1-2013:p1332:b004:l032","ordinal":177966,"en":"One begins the war song,"},{"id":"semetey-1-2013:p1332:b004:l033","ordinal":177967,"en":"And when he charges in wrath,"},{"id":"semetey-1-2013:p1332:b004:l034","ordinal":177968,"en":"There are giants among the infidels."},{"id":"semetey-1-2013:p1332:b004:l035","ordinal":177969,"en":"There is a fleet horseman"},{"id":"semetey-1-2013:p1332:b004:l036","ordinal":177970,"en":"Who can strike a camel flat with one blow."},{"id":"semetey-1-2013:p1332:b004:l037","ordinal":177971,"en":"Beijing is no cheap place;"},{"id":"semetey-1-2013:p1332:b004:l038","ordinal":177972,"en":"When told, it holds such turmoil."},{"id":"semetey-1-2013:p1332:b004:l039","ordinal":177973,"en":"It has peoples of many kinds,"},{"id":"semetey-1-2013:p1333:b003:l001","ordinal":177974,"en":"And among those peoples"},{"id":"semetey-1-2013:p1333:b003:l002","ordinal":177975,"en":"Are the accursed Kalcha lions."},{"id":"semetey-1-2013:p1333:b003:l003","ordinal":177976,"en":"Their language cannot be understood;"},{"id":"semetey-1-2013:p1333:b003:l004","ordinal":177977,"en":"They have babbling speech."},{"id":"semetey-1-2013:p1333:b003:l005","ordinal":177978,"en":"One Chinese tribe"},{"id":"semetey-1-2013:p1333:b003:l006","ordinal":177979,"en":"Has a single eye as large as a bucket."},{"id":"semetey-1-2013:p1333:b003:l007","ordinal":177980,"en":"While my bloodthirsty lord lived,"},{"id":"semetey-1-2013:p1333:b003:l008","ordinal":177981,"en":"In the city of Kakan-Chyn,"},{"id":"semetey-1-2013:p1333:b003:l009","ordinal":177982,"en":"With my lion prince at our head,"},{"id":"semetey-1-2013:p1333:b003:l010","ordinal":177983,"en":"When we besieged and drove them,"},{"id":"semetey-1-2013:p1333:b003:l011","ordinal":177984,"en":"Plundering their wives and daughters,"},{"id":"semetey-1-2013:p1333:b003:l012","ordinal":177985,"en":"When the dear Kyrgyz took them,"},{"id":"semetey-1-2013:p1333:b003:l013","ordinal":177986,"en":"Kara-Shaar and Kambyl—"},{"id":"semetey-1-2013:p1333:b003:l014","ordinal":177987,"en":"Here am I, Bakai, who besieged them;"},{"id":"semetey-1-2013:p1333:b003:l015","ordinal":177988,"en":"Making their Kaldai crack beneath the blows,"},{"id":"semetey-1-2013:p1333:b003:l016","ordinal":177989,"en":"Here am I, Bakai, who beat him."},{"id":"semetey-1-2013:p1333:b003:l017","ordinal":177990,"en":"Laying tribute upon them, their gold—"},{"id":"semetey-1-2013:p1333:b003:l018","ordinal":177991,"en":"Here am I, Bakai, who took it!"},{"id":"semetey-1-2013:p1333:b003:l019","ordinal":177992,"en":"In Beijing beyond Solomon's reach,"},{"id":"semetey-1-2013:p1333:b003:l020","ordinal":177993,"en":"Exacting judgment there,"},{"id":"semetey-1-2013:p1333:b003:l021","ordinal":177994,"en":"Here am I, Bakai, who stood!"},{"id":"semetey-1-2013:p1333:b003:l022","ordinal":177995,"en":"To Beijing beyond Alexander's reach,"},{"id":"semetey-1-2013:p1333:b003:l023","ordinal":177996,"en":"While Manas of old lived,"},{"id":"semetey-1-2013:p1333:b003:l024","ordinal":177997,"en":"My deeds reached that people."},{"id":"semetey-1-2013:p1333:b003:l025","ordinal":177998,"en":"I plundered their daughters"},{"id":"semetey-1-2013:p1333:b003:l026","ordinal":177999,"en":"And destroyed many of their craftsmen."},{"id":"semetey-1-2013:p1333:b003:l027","ordinal":178000,"en":"I did not behold the face of Judgment Day;"},{"id":"semetey-1-2013:p1333:b003:l028","ordinal":178001,"en":"While my mighty one lived,"},{"id":"semetey-1-2013:p1333:b003:l029","ordinal":178002,"en":"I did not die in those days."},{"id":"semetey-1-2013:p1333:b003:l030","ordinal":178003,"en":"I passed on, a dear young man;"},{"id":"semetey-1-2013:p1333:b003:l031","ordinal":178004,"en":"While my hero Manas lived,"},{"id":"semetey-1-2013:p1333:b003:l032","ordinal":178005,"en":"What deeds did this dear head not do!"},{"id":"semetey-1-2013:p1333:b003:l033","ordinal":178006,"en":"When we besieged the khagan's innermost city,"},{"id":"semetey-1-2013:p1333:b003:l034","ordinal":178007,"en":"I did not die;"},{"id":"semetey-1-2013:p1333:b003:l035","ordinal":178008,"en":"When we smashed and beat"},{"id":"semetey-1-2013:p1333:b003:l036","ordinal":178009,"en":"Its stony warriors, I did not die."},{"id":"semetey-1-2013:p1333:b003:l037","ordinal":178010,"en":"When my appointed time came in Beijing,"},{"id":"semetey-1-2013:p1333:b003:l038","ordinal":178011,"en":"While I stood exacting judgment,"},{"id":"semetey-1-2013:p1333:b003:l039","ordinal":178012,"en":"I saw the sacred power"},{"id":"semetey-1-2013:p1333:b004:l001","ordinal":178013,"en":"Of radiance-pouring Beijing;"},{"id":"semetey-1-2013:p1333:b004:l002","ordinal":178014,"en":"Even there I did not die!"},{"id":"semetey-1-2013:p1333:b004:l003","ordinal":178015,"en":"Of Beijing's forty gates,"},{"id":"semetey-1-2013:p1333:b004:l004","ordinal":178016,"en":"When I looked upon one gate,"},{"id":"semetey-1-2013:p1333:b004:l005","ordinal":178017,"en":"It opened toward our homeland."},{"id":"semetey-1-2013:p1333:b004:l006","ordinal":178018,"en":"Closed by day, by day it opened;"},{"id":"semetey-1-2013:p1333:b004:l007","ordinal":178019,"en":"Closed again, again it opened."},{"id":"semetey-1-2013:p1333:b004:l008","ordinal":178020,"en":"Upon the face of that gate"},{"id":"semetey-1-2013:p1333:b004:l009","ordinal":178021,"en":"The white prophet Mustafa—"},{"id":"semetey-1-2013:p1333:b004:l010","ordinal":178022,"en":"The name Muhammad was written."},{"id":"semetey-1-2013:p1333:b004:l011","ordinal":178023,"en":"Lest one devil strike"},{"id":"semetey-1-2013:p1333:b004:l012","ordinal":178024,"en":"The followers of Muhammad,"},{"id":"semetey-1-2013:p1333:b004:l013","ordinal":178025,"en":"God's light was shed"},{"id":"semetey-1-2013:p1333:b004:l014","ordinal":178026,"en":"Upon teeming Beijing."},{"id":"semetey-1-2013:p1333:b004:l015","ordinal":178027,"en":"Beijing is no easy place;"},{"id":"semetey-1-2013:p1333:b004:l016","ordinal":178028,"en":"Do not put your uncle to shame—"},{"id":"semetey-1-2013:p1333:b004:l017","ordinal":178029,"en":"They are no people for sport!"},{"id":"semetey-1-2013:p1333:b004:l018","ordinal":178030,"en":"When I was drunk with spirits,"},{"id":"semetey-1-2013:p1333:b004:l019","ordinal":178031,"en":"When I was young and broad-chested,"},{"id":"semetey-1-2013:p1333:b004:l020","ordinal":178032,"en":"Parted from my elder Ala,"},{"id":"semetey-1-2013:p1333:b004:l021","ordinal":178033,"en":"I returned maimed;"},{"id":"semetey-1-2013:p1333:b004:l022","ordinal":178034,"en":"Parted from Khan Chubak,"},{"id":"semetey-1-2013:p1333:b004:l023","ordinal":178035,"en":"I returned diminished!"},{"id":"semetey-1-2013:p1333:b004:l024","ordinal":178036,"en":"My wing, my Khan Manas,"},{"id":"semetey-1-2013:p1333:b004:l025","ordinal":178037,"en":"I let that swine Khan Kongurbai"},{"id":"semetey-1-2013:p1333:b004:l026","ordinal":178038,"en":"Catch us unawares."},{"id":"semetey-1-2013:p1333:b004:l027","ordinal":178039,"en":"Such is the nature of battle;"},{"id":"semetey-1-2013:p1333:b004:l028","ordinal":178040,"en":"In the course of fighting,"},{"id":"semetey-1-2013:p1333:b004:l029","ordinal":178041,"en":"I was parted from my Syrgak!"},{"id":"semetey-1-2013:p1333:b004:l030","ordinal":178042,"en":"Your aged uncle Bakai,"},{"id":"semetey-1-2013:p1333:b004:l031","ordinal":178043,"en":"Parted from his gray wolf,"},{"id":"semetey-1-2013:p1333:b004:l032","ordinal":178044,"en":"His chest remains rattling."},{"id":"semetey-1-2013:p1333:b004:l033","ordinal":178045,"en":"How shall I scout the road"},{"id":"semetey-1-2013:p1333:b004:l034","ordinal":178046,"en":"Of the teeming Chinese,"},{"id":"semetey-1-2013:p1333:b004:l035","ordinal":178047,"en":"My eyes left festering?"},{"id":"semetey-1-2013:p1333:b004:l036","ordinal":178048,"en":"With my hair-thin beard grown white,"},{"id":"semetey-1-2013:p1333:b004:l037","ordinal":178049,"en":"Do not torment me, my orphan,"},{"id":"semetey-1-2013:p1333:b004:l038","ordinal":178050,"en":"At the time I am bound for Judgment Day!"},{"id":"semetey-1-2013:p1333:b004:l039","ordinal":178051,"en":"Do not bring turmoil upon Beijing;"},{"id":"semetey-1-2013:p1334:b003:l001","ordinal":178052,"en":"If you face the khagan and go,"},{"id":"semetey-1-2013:p1334:b003:l002","ordinal":178053,"en":"Against the grim Black Chinese,"},{"id":"semetey-1-2013:p1334:b003:l003","ordinal":178054,"en":"If we enter straight and wage war,"},{"id":"semetey-1-2013:p1334:b003:l004","ordinal":178055,"en":"Firing guns and drawing bows,"},{"id":"semetey-1-2013:p1334:b003:l005","ordinal":178056,"en":"If we exhaust one another,"},{"id":"semetey-1-2013:p1334:b003:l006","ordinal":178057,"en":"Choose a people to serve as support;"},{"id":"semetey-1-2013:p1334:b003:l007","ordinal":178058,"en":"For the face-to-face battle,"},{"id":"semetey-1-2013:p1334:b003:l008","ordinal":178059,"en":"Choose your support from among heroes!"},{"id":"semetey-1-2013:p1334:b003:l009","ordinal":178060,"en":"Leave the many and choose the one;"},{"id":"semetey-1-2013:p1334:b003:l010","ordinal":178061,"en":"Choose one fit to be a tiger against foes,"},{"id":"semetey-1-2013:p1334:b003:l011","ordinal":178062,"en":"A champion who knows the enemy's stratagems!"},{"id":"semetey-1-2013:p1334:b003:l012","ordinal":178063,"en":"When the black gun cracks,"},{"id":"semetey-1-2013:p1334:b003:l013","ordinal":178064,"en":"Choose a warrior who will not flee;"},{"id":"semetey-1-2013:p1334:b003:l014","ordinal":178065,"en":"When the fierce gun snaps,"},{"id":"semetey-1-2013:p1334:b003:l015","ordinal":178066,"en":"Choose a hero who will not flinch!"},{"id":"semetey-1-2013:p1334:b003:l016","ordinal":178067,"en":"My foal, my son, if you heed me,"},{"id":"semetey-1-2013:p1334:b003:l017","ordinal":178068,"en":"If you go to Beijing, go this way:"},{"id":"semetey-1-2013:p1334:b003:l018","ordinal":178069,"en":"Take a marksman who shoots the eye,"},{"id":"semetey-1-2013:p1334:b003:l019","ordinal":178070,"en":"Bull-necked and camel-thighed,"},{"id":"semetey-1-2013:p1334:b003:l020","ordinal":178071,"en":"Who ruins those who grapple him;"},{"id":"semetey-1-2013:p1334:b003:l021","ordinal":178072,"en":"Take the exceptional man who does not turn from death!"},{"id":"semetey-1-2013:p1334:b003:l022","ordinal":178073,"en":"Who shoots what even a bird cannot reach;"},{"id":"semetey-1-2013:p1334:b003:l023","ordinal":178074,"en":"Gather coats bullets cannot pierce."},{"id":"semetey-1-2013:p1334:b003:l024","ordinal":178075,"en":"Gather an army by calling every father's son;"},{"id":"semetey-1-2013:p1334:b003:l025","ordinal":178076,"en":"Gather no small force, but a great one!"},{"id":"semetey-1-2013:p1334:b003:l026","ordinal":178077,"en":"Against infidels like black worms,"},{"id":"semetey-1-2013:p1334:b003:l027","ordinal":178078,"en":"If you grapple, grapple thus;"},{"id":"semetey-1-2013:p1334:b003:l028","ordinal":178079,"en":"Against hero Khan Kongurbai,"},{"id":"semetey-1-2013:p1334:b003:l029","ordinal":178080,"en":"If you wage war, wage it thus."},{"id":"semetey-1-2013:p1334:b003:l030","ordinal":178081,"en":"Let this year pass over you,"},{"id":"semetey-1-2013:p1334:b003:l031","ordinal":178082,"en":"Then go in the following year!"},{"id":"semetey-1-2013:p1334:b003:l032","ordinal":178083,"en":"Send word and let us gather"},{"id":"semetey-1-2013:p1334:b003:l033","ordinal":178084,"en":"Kanykey's remedies;"},{"id":"semetey-1-2013:p1334:b003:l034","ordinal":178085,"en":"Let us fatten fully"},{"id":"semetey-1-2013:p1334:b003:l035","ordinal":178086,"en":"All the thoroughbred chargers."},{"id":"semetey-1-2013:p1334:b003:l036","ordinal":178087,"en":"Let the horse grow fat and ready;"},{"id":"semetey-1-2013:p1334:b003:l037","ordinal":178088,"en":"Let the hero grow stout and pent with force;"},{"id":"semetey-1-2013:p1334:b003:l038","ordinal":178089,"en":"Then go to Beijing!"},{"id":"semetey-1-2013:p1334:b003:l039","ordinal":178090,"en":"Your father Manas was a lion;"},{"id":"semetey-1-2013:p1334:b004:l001","ordinal":178091,"en":"I was his uncle Bakai,"},{"id":"semetey-1-2013:p1334:b004:l002","ordinal":178092,"en":"Who never crossed what he said."},{"id":"semetey-1-2013:p1334:b004:l003","ordinal":178093,"en":"I was Bakai who wore"},{"id":"semetey-1-2013:p1334:b004:l004","ordinal":178094,"en":"A bulletproof iron shield!"},{"id":"semetey-1-2013:p1334:b004:l005","ordinal":178095,"en":"I was Bakai who knew"},{"id":"semetey-1-2013:p1334:b004:l006","ordinal":178096,"en":"Kakan-Chyn's Beijing!"},{"id":"semetey-1-2013:p1334:b004:l007","ordinal":178097,"en":"Traveling on campaign for six months,"},{"id":"semetey-1-2013:p1334:b004:l008","ordinal":178098,"en":"Going no little way, but far,"},{"id":"semetey-1-2013:p1334:b004:l009","ordinal":178099,"en":"To Chinmachin's khagan—"},{"id":"semetey-1-2013:p1334:b004:l010","ordinal":178100,"en":"Those people are Chinese of ancient stock,"},{"id":"semetey-1-2013:p1334:b004:l011","ordinal":178101,"en":"Their multitude thick as black worms."},{"id":"semetey-1-2013:p1334:b004:l012","ordinal":178102,"en":"The more depleted, the more they smoldered;"},{"id":"semetey-1-2013:p1334:b004:l013","ordinal":178103,"en":"They are a people rooted deep."},{"id":"semetey-1-2013:p1334:b004:l014","ordinal":178104,"en":"Fighting until all were exhausted—"},{"id":"semetey-1-2013:p1334:b004:l015","ordinal":178105,"en":"Know that I am that Bakai!"},{"id":"semetey-1-2013:p1334:b004:l016","ordinal":178106,"en":"The more they died, the more they multiplied;"},{"id":"semetey-1-2013:p1334:b004:l017","ordinal":178107,"en":"They are those accursed Chinese people."},{"id":"semetey-1-2013:p1334:b004:l018","ordinal":178108,"en":"My roar splitting stones,"},{"id":"semetey-1-2013:p1334:b004:l019","ordinal":178109,"en":"Parted from my own companion,"},{"id":"semetey-1-2013:p1334:b004:l020","ordinal":178110,"en":"I am the one now going toward death!"},{"id":"semetey-1-2013:p1334:b004:l021","ordinal":178111,"en":"Know this grief of mine!"},{"id":"semetey-1-2013:p1334:b004:l022","ordinal":178112,"en":"My only one left by the lion,"},{"id":"semetey-1-2013:p1334:b004:l023","ordinal":178113,"en":"Grant me this journey and heed me!"},{"id":"semetey-1-2013:p1334:b004:l024","ordinal":178114,"en":"Beijing is no easy place;"},{"id":"semetey-1-2013:p1334:b004:l025","ordinal":178115,"en":"The Chinese are a fierce and unruly people,"},{"id":"semetey-1-2013:p1334:b004:l026","ordinal":178116,"en":"No people from whom five or six riders"},{"id":"semetey-1-2013:p1334:b004:l027","ordinal":178117,"en":"Can exact vengeance!"},{"id":"semetey-1-2013:p1334:b004:l028","ordinal":178118,"en":"It has a pass on which it relies,"},{"id":"semetey-1-2013:p1334:b004:l029","ordinal":178119,"en":"And a place lying fortified."},{"id":"semetey-1-2013:p1334:b004:l030","ordinal":178120,"en":"Broad-booted and cotton-sashed,"},{"id":"semetey-1-2013:p1334:b004:l031","ordinal":178121,"en":"Kongurbai, khan of the Kechil,"},{"id":"semetey-1-2013:p1334:b004:l032","ordinal":178122,"en":"It has that swaggering lion."},{"id":"semetey-1-2013:p1334:b004:l033","ordinal":178123,"en":"He still lives, neither dead nor gone;"},{"id":"semetey-1-2013:p1334:b004:l034","ordinal":178124,"en":"Bakai has words to tell of him."},{"id":"semetey-1-2013:p1334:b004:l035","ordinal":178125,"en":"Do not act imperiously, my foal;"},{"id":"semetey-1-2013:p1334:b004:l036","ordinal":178126,"en":"The ill-starred bloodthirsty man"},{"id":"semetey-1-2013:p1334:b004:l037","ordinal":178127,"en":"Has black eyes watching."},{"id":"semetey-1-2013:p1334:b004:l038","ordinal":178128,"en":"What your father destroyed,"},{"id":"semetey-1-2013:p1334:b004:l039","ordinal":178129,"en":"What your lion accomplished,"},{"id":"semetey-1-2013:p1335:b003:l001","ordinal":178130,"en":"Inscribed in its register."},{"id":"semetey-1-2013:p1335:b003:l002","ordinal":178131,"en":"When the following year comes,"},{"id":"semetey-1-2013:p1335:b003:l003","ordinal":178132,"en":"Take male camels from the herds,"},{"id":"semetey-1-2013:p1335:b003:l004","ordinal":178133,"en":"Take plenty of every kind of equipment,"},{"id":"semetey-1-2013:p1335:b003:l005","ordinal":178134,"en":"Take a full count of the army,"},{"id":"semetey-1-2013:p1335:b003:l006","ordinal":178135,"en":"And enter the army on the rolls."},{"id":"semetey-1-2013:p1335:b003:l007","ordinal":178136,"en":"Leaving out no able-bodied man,"},{"id":"semetey-1-2013:p1335:b003:l008","ordinal":178137,"en":"Let us gather them all!"},{"id":"semetey-1-2013:p1335:b003:l009","ordinal":178138,"en":"Making the face of the earth thunder,"},{"id":"semetey-1-2013:p1335:b003:l010","ordinal":178139,"en":"Then let us go to Beijing!"},{"id":"semetey-1-2013:p1335:b003:l011","ordinal":178140,"en":"Those who go on holy war may die;"},{"id":"semetey-1-2013:p1335:b003:l012","ordinal":178141,"en":"The brave scout will reconnoiter the road."},{"id":"semetey-1-2013:p1335:b003:l013","ordinal":178142,"en":"So the people who go need burden no one,"},{"id":"semetey-1-2013:p1335:b003:l014","ordinal":178143,"en":"And their lice do not multiply,"},{"id":"semetey-1-2013:p1335:b003:l015","ordinal":178144,"en":"Let us prepare underclothing;"},{"id":"semetey-1-2013:p1335:b003:l016","ordinal":178145,"en":"To enter battle fully equipped,"},{"id":"semetey-1-2013:p1335:b003:l017","ordinal":178146,"en":"To strike the foe without tiring,"},{"id":"semetey-1-2013:p1335:b003:l018","ordinal":178147,"en":"Let us ready armor against bullets!"},{"id":"semetey-1-2013:p1335:b003:l019","ordinal":178148,"en":"The Chinese inhabit Beijing,"},{"id":"semetey-1-2013:p1335:b003:l020","ordinal":178149,"en":"Whose heat gives no respite."},{"id":"semetey-1-2013:p1335:b003:l021","ordinal":178150,"en":"Beijing is no easy place;"},{"id":"semetey-1-2013:p1335:b003:l022","ordinal":178151,"en":"For every man let us prepare"},{"id":"semetey-1-2013:p1335:b003:l023","ordinal":178152,"en":"A coat with golden collar and copper sleeves,"},{"id":"semetey-1-2013:p1335:b003:l024","ordinal":178153,"en":"For him to cast himself against the foe,"},{"id":"semetey-1-2013:p1335:b003:l025","ordinal":178154,"en":"To stand fighting the enemy,"},{"id":"semetey-1-2013:p1335:b003:l026","ordinal":178155,"en":"To extend his spear without fleeing—"},{"id":"semetey-1-2013:p1335:b003:l027","ordinal":178156,"en":"Let it be a coat bullets cannot pierce."},{"id":"semetey-1-2013:p1335:b003:l028","ordinal":178157,"en":"Who then will have great regret,"},{"id":"semetey-1-2013:p1335:b003:l029","ordinal":178158,"en":"If we stand and fight without fleeing,"},{"id":"semetey-1-2013:p1335:b003:l030","ordinal":178159,"en":"And bring great conflict upon the Kakan?"},{"id":"semetey-1-2013:p1335:b003:l031","ordinal":178160,"en":"If we stand face to face,"},{"id":"semetey-1-2013:p1335:b003:l032","ordinal":178161,"en":"Clashing and hewing with swords,"},{"id":"semetey-1-2013:p1335:b003:l033","ordinal":178162,"en":"Bathed in red blood,"},{"id":"semetey-1-2013:p1335:b003:l034","ordinal":178163,"en":"Standing amid slaughter,"},{"id":"semetey-1-2013:p1335:b003:l035","ordinal":178164,"en":"Swallowing the Kara-Khan,"},{"id":"semetey-1-2013:p1335:b003:l036","ordinal":178165,"en":"If we stand and fight without fleeing."},{"id":"semetey-1-2013:p1335:b003:l037","ordinal":178166,"en":"So we do not die by the sword,"},{"id":"semetey-1-2013:p1335:b003:l038","ordinal":178167,"en":"So untimely death does not reach us,"},{"id":"semetey-1-2013:p1335:b003:l039","ordinal":178168,"en":"Your dear father's contemporary,"},{"id":"semetey-1-2013:p1335:b004:l001","ordinal":178169,"en":"That confidant Bölökbai—"},{"id":"semetey-1-2013:p1335:b004:l002","ordinal":178170,"en":"When he worked the bellows, it stirred;"},{"id":"semetey-1-2013:p1335:b004:l003","ordinal":178171,"en":"Döötü and Bölökbai"},{"id":"semetey-1-2013:p1335:b004:l004","ordinal":178172,"en":"Were friends for the world beyond."},{"id":"semetey-1-2013:p1335:b004:l005","ordinal":178173,"en":"Skilled in every kind of object,"},{"id":"semetey-1-2013:p1335:b004:l006","ordinal":178174,"en":"What Bölökbai made,"},{"id":"semetey-1-2013:p1335:b004:l007","ordinal":178175,"en":"He and Döötü together"},{"id":"semetey-1-2013:p1335:b004:l008","ordinal":178176,"en":"Made after taking counsel."}]
