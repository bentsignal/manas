[{"id":"sayakbay-ms-current144:pdf032:l003","ordinal":392193,"en":"Making Ala-Too his homeland,"},{"id":"sayakbay-ms-current144:pdf032:l004","ordinal":392194,"en":"Semetey, beyond his father,"},{"id":"sayakbay-ms-current144:pdf032:l005","ordinal":392195,"en":"Was born a greater warrior,"},{"id":"sayakbay-ms-current144:pdf032:l006","ordinal":392196,"en":"The Burut fought among themselves,"},{"id":"sayakbay-ms-current144:pdf032:l007","ordinal":392197,"en":"Claiming what did not exist,"},{"id":"sayakbay-ms-current144:pdf032:l009","ordinal":392198,"en":"Taking [clods?] from the ground,"},{"id":"sayakbay-ms-current144:pdf032:l010","ordinal":392199,"en":"No enemy had come to besiege them,"},{"id":"sayakbay-ms-current144:pdf032:l011","ordinal":392200,"en":"They battled among themselves,"},{"id":"sayakbay-ms-current144:pdf032:l012","ordinal":392201,"en":"From caravan traders I heard,"},{"id":"sayakbay-ms-current144:pdf032:l013","ordinal":392202,"en":"That Semetey had died,"},{"id":"sayakbay-ms-current144:pdf032:l015","ordinal":392203,"en":"They saw brave Seytek,"},{"id":"sayakbay-ms-current144:pdf032:l016","ordinal":392204,"en":"Becoming equal to the whole world,"},{"id":"sayakbay-ms-current144:pdf032:l017","ordinal":392205,"en":"Seytek emerged a warrior,"},{"id":"sayakbay-ms-current144:pdf032:l018","ordinal":392206,"en":"That bride, a fairy woman,"},{"id":"sayakbay-ms-current144:pdf032:l019","ordinal":392207,"en":"Keeping a court and becoming khan,"},{"id":"sayakbay-ms-current144:pdf032:l020","ordinal":392208,"en":"Sarybai came against him,"},{"id":"sayakbay-ms-current144:pdf032:l021","ordinal":392209,"en":"The furious one was laid low,"},{"id":"sayakbay-ms-current144:pdf032:l022","ordinal":392210,"en":"They say he became a great champion,"},{"id":"sayakbay-ms-current144:pdf032:l023","ordinal":392211,"en":"Settled in his homeland, they say,"},{"id":"sayakbay-ms-current144:pdf032:l024","ordinal":392212,"en":"[His babbling words split heads?],"},{"id":"sayakbay-ms-current144:pdf032:l025","ordinal":392213,"en":"The accursed one's descendant,"},{"id":"sayakbay-ms-current144:pdf032:l026","ordinal":392214,"en":"Multiplied like grass in spring,"},{"id":"sayakbay-ms-current144:pdf032:l027","ordinal":392215,"en":"[Women, men, males and dogs?],"},{"id":"sayakbay-ms-current144:pdf032:l028","ordinal":392216,"en":"He slew the people of Itaaly,"},{"id":"sayakbay-ms-current144:pdf032:l029","ordinal":392217,"en":"[They were enemies who turned against him?],"},{"id":"sayakbay-ms-current144:pdf032:l030","ordinal":392218,"en":"When he advanced, causing slaughter,"},{"id":"sayakbay-ms-current144:pdf032:l031","ordinal":392219,"en":"To the sons of mortals on earth,"},{"id":"sayakbay-ms-current144:pdf032:l032","ordinal":392220,"en":"Are the Kyrgyz favored by God?"},{"id":"sayakbay-ms-current144:pdf033:l001","ordinal":392221,"en":"They say he caused complete turmoil,"},{"id":"sayakbay-ms-current144:pdf033:l002","ordinal":392222,"en":"From his might, blood flowed,"},{"id":"sayakbay-ms-current144:pdf033:l004","ordinal":392223,"en":"He turns level ground into ridges,"},{"id":"sayakbay-ms-current144:pdf033:l006","ordinal":392224,"en":"Will bring trouble to Beijing,"},{"id":"sayakbay-ms-current144:pdf033:l007","ordinal":392225,"en":"Let us build an enclosure,"},{"id":"sayakbay-ms-current144:pdf033:l008","ordinal":392226,"en":"Let us strengthen [its hollows?],"},{"id":"sayakbay-ms-current144:pdf033:l009","ordinal":392227,"en":"Whoever opposes this,"},{"id":"sayakbay-ms-current144:pdf033:l010","ordinal":392228,"en":"Let us slay them all, sparing none,"},{"id":"sayakbay-ms-current144:pdf033:l011","ordinal":392229,"en":"Scorning all his guards,"},{"id":"sayakbay-ms-current144:pdf033:l012","ordinal":392230,"en":"Blocking his approach,"},{"id":"sayakbay-ms-current144:pdf033:l013","ordinal":392231,"en":"Let us kill those we meet,"},{"id":"sayakbay-ms-current144:pdf033:l014","ordinal":392232,"en":"Let us make his road of stone,"},{"id":"sayakbay-ms-current144:pdf033:l015","ordinal":392233,"en":"Let us [impose a duty upon Beijing?],"},{"id":"sayakbay-ms-current144:pdf033:l016","ordinal":392234,"en":"Against fiery, swift Seytek,"},{"id":"sayakbay-ms-current144:pdf033:l017","ordinal":392235,"en":"My people, let us protect our lives thus,"},{"id":"sayakbay-ms-current144:pdf033:l018","ordinal":392236,"en":"When marching against a nation,"},{"id":"sayakbay-ms-current144:pdf033:l019","ordinal":392237,"en":"At the [black-tongued season of horses?],"},{"id":"sayakbay-ms-current144:pdf033:l020","ordinal":392238,"en":"When the people camp in the foothills,"},{"id":"sayakbay-ms-current144:pdf033:l021","ordinal":392239,"en":"The horses stirring in a clamor,"},{"id":"sayakbay-ms-current144:pdf033:l022","ordinal":392240,"en":"When the khan is at summer pasture,"},{"id":"sayakbay-ms-current144:pdf033:l023","ordinal":392241,"en":"Unflinching when struck by a sword,"},{"id":"sayakbay-ms-current144:pdf033:l024","ordinal":392242,"en":"Unmoving when struck by a spear,"},{"id":"sayakbay-ms-current144:pdf033:l025","ordinal":392243,"en":"Never panicking at sight of enemies,"},{"id":"sayakbay-ms-current144:pdf033:l026","ordinal":392244,"en":"Never fleeing an encounter,"},{"id":"sayakbay-ms-current144:pdf033:l027","ordinal":392245,"en":"From the shadows in darkness,"},{"id":"sayakbay-ms-current144:pdf033:l028","ordinal":392246,"en":"Never straying from the trail,"},{"id":"sayakbay-ms-current144:pdf033:l029","ordinal":392247,"en":"Among skilled pathfinders,"},{"id":"sayakbay-ms-current144:pdf033:l030","ordinal":392248,"en":"Among the wisest and finest,"},{"id":"sayakbay-ms-current144:pdf033:l031","ordinal":392249,"en":"[Who does not evade approaching death?],"},{"id":"sayakbay-ms-current144:pdf033:l032","ordinal":392250,"en":"If ninety hardships come at once,"},{"id":"sayakbay-ms-current144:pdf034:l001","ordinal":392251,"en":"Who does not scatter and flee,"},{"id":"sayakbay-ms-current144:pdf034:l002","ordinal":392252,"en":"Among the keen and knowledgeable,"},{"id":"sayakbay-ms-current144:pdf034:l003","ordinal":392253,"en":"[Who survives in the thicket?],"},{"id":"sayakbay-ms-current144:pdf034:l004","ordinal":392254,"en":"From the tower with a bell,"},{"id":"sayakbay-ms-current144:pdf034:l005","ordinal":392255,"en":"From Beijing full of warriors,"},{"id":"sayakbay-ms-current144:pdf034:l006","ordinal":392256,"en":"What guards shall we post?"},{"id":"sayakbay-ms-current144:pdf034:l007","ordinal":392257,"en":"Having sorcerers test them,"},{"id":"sayakbay-ms-current144:pdf034:l008","ordinal":392258,"en":"[Having the unheeding examined?],"},{"id":"sayakbay-ms-current144:pdf034:l009","ordinal":392259,"en":"Having heroes observe them,"},{"id":"sayakbay-ms-current144:pdf034:l010","ordinal":392260,"en":"Having champions shake them,"},{"id":"sayakbay-ms-current144:pdf034:l011","ordinal":392261,"en":"Having the agile seize them,"},{"id":"sayakbay-ms-current144:pdf034:l012","ordinal":392262,"en":"Whether they are heroes or lions,"},{"id":"sayakbay-ms-current144:pdf034:l013","ordinal":392263,"en":"Having the sages determine it."},{"id":"sayakbay-ms-current144:pdf034:l014","ordinal":392264,"en":"If they are heroes and lions,"},{"id":"sayakbay-ms-current144:pdf034:l015","ordinal":392265,"en":"Our people, forty Chinese tribes,"},{"id":"sayakbay-ms-current144:pdf034:l016","ordinal":392266,"en":"Even after forty years of slaughter,"},{"id":"sayakbay-ms-current144:pdf034:l017","ordinal":392267,"en":"The Chinese people do not falter,"},{"id":"sayakbay-ms-current144:pdf034:l018","ordinal":392268,"en":"The great people of [different bearing?],"},{"id":"sayakbay-ms-current144:pdf034:l019","ordinal":392269,"en":"Numerous as countless black insects,"},{"id":"sayakbay-ms-current144:pdf034:l020","ordinal":392270,"en":"Without troubling the people again,"},{"id":"sayakbay-ms-current144:pdf034:l021","ordinal":392271,"en":"Let us appoint them as champions,"},{"id":"sayakbay-ms-current144:pdf034:l022","ordinal":392272,"en":"Guarding the multitude,"},{"id":"sayakbay-ms-current144:pdf034:l023","ordinal":392273,"en":"Let us post many guards,"},{"id":"sayakbay-ms-current144:pdf034:l024","ordinal":392274,"en":"Let us slay those who fight,"},{"id":"sayakbay-ms-current144:pdf034:l025","ordinal":392275,"en":"Gnawing those encountered,"},{"id":"sayakbay-ms-current144:pdf034:l026","ordinal":392276,"en":"Let us cut down those we meet,"},{"id":"sayakbay-ms-current144:pdf034:l027","ordinal":392277,"en":"Let us give the strong talismans,"},{"id":"sayakbay-ms-current144:pdf034:l028","ordinal":392278,"en":"The champions and lionlike men,"},{"id":"sayakbay-ms-current144:pdf034:l029","ordinal":392279,"en":"From great Beijing's treasury,"},{"id":"sayakbay-ms-current144:pdf034:l030","ordinal":392280,"en":"Let us maintain them by tribute,"},{"id":"sayakbay-ms-current144:pdf034:l031","ordinal":392281,"en":"If the Kyrgyz are weak,"},{"id":"sayakbay-ms-current144:pdf034:l032","ordinal":392282,"en":"Hearing word from messengers,"},{"id":"sayakbay-ms-current144:pdf035:l008","ordinal":392283,"en":"Taking from [the fortified place?],"},{"id":"sayakbay-ms-current144:pdf035:l009","ordinal":392284,"en":"From here, the Chinese against the Kyrgyz,"},{"id":"sayakbay-ms-current144:pdf035:l010","ordinal":392285,"en":"Let us anger them [without showing ourselves?],"},{"id":"sayakbay-ms-current144:pdf035:l011","ordinal":392286,"en":"If we meet, let us start a fight,"},{"id":"sayakbay-ms-current144:pdf035:l012","ordinal":392287,"en":"[So they are utterly cut down?],"},{"id":"sayakbay-ms-current144:pdf035:l013","ordinal":392288,"en":"Let us kill and take revenge,"},{"id":"sayakbay-ms-current144:pdf035:l014","ordinal":392289,"en":"Are my words sound, he asked,"},{"id":"sayakbay-ms-current144:pdf035:l019","ordinal":392290,"en":"Venom issued from his mouth,"},{"id":"sayakbay-ms-current144:pdf036:l008","ordinal":392291,"en":"Of imposing, valiant Kite,"},{"id":"sayakbay-ms-current144:pdf037:l029","ordinal":392292,"en":"We stand ready for your command,"},{"id":"sayakbay-ms-current144:pdf038:l004","ordinal":392293,"en":"Yielding his strength to no one,"},{"id":"sayakbay-ms-current144:pdf038:l007","ordinal":392294,"en":"Black-bellied and blue-backed,"},{"id":"sayakbay-ms-current144:pdf038:l009","ordinal":392295,"en":"They say the most resolute of mortals,"},{"id":"sayakbay-ms-current144:pdf038:l010","ordinal":392296,"en":"His prowess and lionlike valor,"},{"id":"sayakbay-ms-current144:pdf038:l015","ordinal":392297,"en":"They say he is a consummate warrior,"},{"id":"sayakbay-ms-current144:pdf038:l018","ordinal":392298,"en":"If he is a hero and a lion,"},{"id":"sayakbay-ms-current144:pdf038:l019","ordinal":392299,"en":"Let us observe his true worth,"},{"id":"sayakbay-ms-current144:pdf038:l020","ordinal":392300,"en":"Without quarreling or causing strife,"},{"id":"sayakbay-ms-current144:pdf038:l021","ordinal":392301,"en":"Let us ride safely along the road,"},{"id":"sayakbay-ms-current144:pdf038:l022","ordinal":392302,"en":"Dear Kite, we shall say,"},{"id":"sayakbay-ms-current144:pdf038:l023","ordinal":392303,"en":"Of those accursed Burut,"},{"id":"sayakbay-ms-current144:pdf038:l024","ordinal":392304,"en":"Let us return and tell the news,"},{"id":"sayakbay-ms-current144:pdf039:l003","ordinal":392305,"en":"We shall learn from messengers,"},{"id":"sayakbay-ms-current144:pdf039:l004","ordinal":392306,"en":"If he is boastful and deficient,"},{"id":"sayakbay-ms-current144:pdf039:l005","ordinal":392307,"en":"[We shall slit his blue bull?],"},{"id":"sayakbay-ms-current144:pdf039:l006","ordinal":392308,"en":"Destroying the giant Seytek,"},{"id":"sayakbay-ms-current144:pdf039:l007","ordinal":392309,"en":"[Breaking through alone, Beijing …],"},{"id":"sayakbay-ms-current144:pdf039:l008","ordinal":392310,"en":"[We shall bring some of them out?],"},{"id":"sayakbay-ms-current144:pdf039:l009","ordinal":392311,"en":"Leaving his lineage bereft,"},{"id":"sayakbay-ms-current144:pdf039:l010","ordinal":392312,"en":"His fine, swaying young lords,"},{"id":"sayakbay-ms-current144:pdf039:l011","ordinal":392313,"en":"Driving them all away as slaves,"},{"id":"sayakbay-ms-current144:pdf039:l012","ordinal":392314,"en":"[We shall strike his leadership?],"},{"id":"sayakbay-ms-current144:pdf039:l013","ordinal":392315,"en":"Allowing no whispered news to escape,"},{"id":"sayakbay-ms-current144:pdf039:l014","ordinal":392316,"en":"If he is a lion like his father,"},{"id":"sayakbay-ms-current144:pdf039:l015","ordinal":392317,"en":"If he grapples and fights,"},{"id":"sayakbay-ms-current144:pdf039:l016","ordinal":392318,"en":"Beyond human strength to overcome,"},{"id":"sayakbay-ms-current144:pdf039:l017","ordinal":392319,"en":"[If shooting leaves us empty-handed?],"},{"id":"sayakbay-ms-current144:pdf039:l019","ordinal":392320,"en":"Mighty in menace, potent in venom,"},{"id":"sayakbay-ms-current144:pdf039:l020","ordinal":392321,"en":"If he is a cunning lion,"},{"id":"sayakbay-ms-current144:pdf039:l021","ordinal":392322,"en":"We shall travel the lower slopes,"},{"id":"sayakbay-ms-current144:pdf039:l022","ordinal":392323,"en":"We shall separate and turn back,"},{"id":"sayakbay-ms-current144:pdf039:l023","ordinal":392324,"en":"Crossing [moonlit heights?] and stony ground,"},{"id":"sayakbay-ms-current144:pdf039:l024","ordinal":392325,"en":"We shall ride a safe road,"},{"id":"sayakbay-ms-current144:pdf039:l025","ordinal":392326,"en":"Telling how great his menace is,"},{"id":"sayakbay-ms-current144:pdf039:l026","ordinal":392327,"en":"We shall return to describe his deeds,"},{"id":"sayakbay-ms-current144:pdf039:l028","ordinal":392328,"en":"You are sovereign, Kite; heed my words,"},{"id":"sayakbay-ms-current144:pdf039:l029","ordinal":392329,"en":"The enemy you would fight is formidable,"},{"id":"sayakbay-ms-current144:pdf040:l005","ordinal":392330,"en":"Those who fought them never returned,"},{"id":"sayakbay-ms-current144:pdf040:l026","ordinal":392331,"en":"Speaking quietly but firmly,"},{"id":"sayakbay-ms-current144:pdf040:l028","ordinal":392332,"en":"Chongbilgich began his speech,"},{"id":"sayakbay-ms-current144:pdf040:l030","ordinal":392333,"en":"He was a champion and a lion."},{"id":"sayakbay-ms-current144:pdf041:l019","ordinal":392334,"en":"Brave Seytek, born of a hero,"},{"id":"sayakbay-ms-current144:pdf041:l025","ordinal":392335,"en":"[Never satisfied with seeking deeds?],"},{"id":"sayakbay-ms-current144:pdf041:l026","ordinal":392336,"en":"Never abandoning their eagerness,"},{"id":"sayakbay-ms-current144:pdf041:l027","ordinal":392337,"en":"At talk of battle and enemies,"},{"id":"sayakbay-ms-current144:pdf042:l004","ordinal":392338,"en":"Roe deer cry among the rocks,"},{"id":"sayakbay-ms-current144:pdf042:l012","ordinal":392339,"en":"Grazing over nine hills,"},{"id":"sayakbay-ms-current144:pdf042:l028","ordinal":392340,"en":"When caught in his wrath,"},{"id":"sayakbay-ms-current144:pdf043:l011","ordinal":392341,"en":"Was an exceedingly difficult undertaking,"},{"id":"sayakbay-ms-current144:pdf043:l013","ordinal":392342,"en":"That faithless world,"},{"id":"sayakbay-ms-current144:pdf043:l016","ordinal":392343,"en":"Many people went about grieving,"},{"id":"sayakbay-ms-current144:pdf043:l023","ordinal":392344,"en":"He tested [those fit for the journey?],"},{"id":"sayakbay-ms-current144:pdf043:l027","ordinal":392345,"en":"Saying, this one will do,"},{"id":"sayakbay-ms-current144:pdf044:l011","ordinal":392346,"en":"Making a clamor no mortal would forget,"},{"id":"sayakbay-ms-current144:pdf044:l015","ordinal":392347,"en":"The reins and bridle,"},{"id":"sayakbay-ms-current144:pdf044:l018","ordinal":392348,"en":"He became sovereign,"},{"id":"sayakbay-ms-current144:pdf045:l002","ordinal":392349,"en":"Rounding Kaspan's dark mountain,"},{"id":"sayakbay-ms-current144:pdf045:l006","ordinal":392350,"en":"Fog billowed apart,"},{"id":"sayakbay-ms-current144:pdf045:l008","ordinal":392351,"en":"Lest people discover them,"},{"id":"sayakbay-ms-current144:pdf045:l025","ordinal":392352,"en":"Animals and living creatures,"},{"id":"sayakbay-ms-current144:pdf046:l008","ordinal":392353,"en":"There were scouts among them too,"},{"id":"sayakbay-ms-current144:pdf046:l026","ordinal":392354,"en":"The trouser legs stood out distinctly,"},{"id":"sayakbay-ms-current144:pdf046:l027","ordinal":392355,"en":"Chasing wild asses, shooting mountain goats,"},{"id":"sayakbay-ms-current144:pdf047:l005","ordinal":392356,"en":"Between thirty and forty-eight,"},{"id":"sayakbay-ms-current144:pdf047:l006","ordinal":392357,"en":"His age lay between them,"},{"id":"sayakbay-ms-current144:pdf047:l007","ordinal":392358,"en":"[That hollowed, raging brute?],"},{"id":"sayakbay-ms-current144:pdf047:l008","ordinal":392359,"en":"His head was like a cooking cauldron,"},{"id":"sayakbay-ms-current144:pdf047:l009","ordinal":392360,"en":"His eyebrows like a reclining dog,"},{"id":"sayakbay-ms-current144:pdf047:l011","ordinal":392361,"en":"[Like a fist of the craggy mountain?],"},{"id":"sayakbay-ms-current144:pdf047:l012","ordinal":392362,"en":"[Unresolved description of the warrior's bearing.],"},{"id":"sayakbay-ms-current144:pdf047:l014","ordinal":392363,"en":"The infidel's pipe was unusual,"},{"id":"sayakbay-ms-current144:pdf047:l015","ordinal":392364,"en":"[Such was this knowledgeable champion?],"},{"id":"sayakbay-ms-current144:pdf047:l016","ordinal":392365,"en":"Those setting out to scout,"},{"id":"sayakbay-ms-current144:pdf047:l017","ordinal":392366,"en":"Their strength and lionlike valor,"},{"id":"sayakbay-ms-current144:pdf047:l018","ordinal":392367,"en":"Prepared in Kakanchy,"},{"id":"sayakbay-ms-current144:pdf047:l023","ordinal":392368,"en":"Rejoicing at the mention of death,"},{"id":"sayakbay-ms-current144:pdf047:l026","ordinal":392369,"en":"Dark junipers along Kaspan,"},{"id":"sayakbay-ms-current144:pdf048:l001","ordinal":392370,"en":"Following along Karshan,"},{"id":"sayakbay-ms-current144:pdf048:l004","ordinal":392371,"en":"Tiring their horses and scouting the land,"},{"id":"sayakbay-ms-current144:pdf048:l006","ordinal":392372,"en":"Chasing wild asses, shooting mountain goats,"},{"id":"sayakbay-ms-current144:pdf048:l021","ordinal":392373,"en":"Taking no day's respite,"},{"id":"sayakbay-ms-current144:pdf049:l002","ordinal":392374,"en":"The affair became terribly difficult,"},{"id":"sayakbay-ms-current144:pdf049:l017","ordinal":392375,"en":"Every animal and living creature,"},{"id":"sayakbay-ms-current144:pdf049:l023","ordinal":392376,"en":"Among all created mortal beings,"},{"id":"sayakbay-ms-current144:pdf049:l024","ordinal":392377,"en":"There had been no hardship like it,"},{"id":"sayakbay-ms-current144:pdf049:l026","ordinal":392378,"en":"People traveling at night,"},{"id":"sayakbay-ms-current144:pdf050:l013","ordinal":392379,"en":"Facing a terribly difficult road,"},{"id":"sayakbay-ms-current144:pdf050:l014","ordinal":392380,"en":"[Its crossings tormented them?],"},{"id":"sayakbay-ms-current144:pdf050:l020","ordinal":392381,"en":"The wide world became narrow,"},{"id":"sayakbay-ms-current144:pdf050:l021","ordinal":392382,"en":"All the level ground,"},{"id":"sayakbay-ms-current144:pdf050:l025","ordinal":392383,"en":"Escaping the perilous road,"},{"id":"sayakbay-ms-current144:pdf051:l003","ordinal":392384,"en":"Scouting the slopes and choosing mountains,"},{"id":"sayakbay-ms-current144:pdf051:l018","ordinal":392385,"en":"Those he fixed upon were laid low,"},{"id":"sayakbay-ms-current144:pdf051:l019","ordinal":392386,"en":"Ten generations of forefathers were khans,"},{"id":"sayakbay-ms-current144:pdf051:l020","ordinal":392387,"en":"God made his endeavors prosper,"},{"id":"sayakbay-ms-current144:pdf051:l021","ordinal":392388,"en":"[The way's saint, the elder master,]"},{"id":"sayakbay-ms-current144:pdf051:l022","ordinal":392389,"en":"Kydyr and Ilyas opened his fortune,"},{"id":"sayakbay-ms-current144:pdf051:l023","ordinal":392390,"en":"[His head was formed of silver,]"},{"id":"sayakbay-ms-current144:pdf051:l024","ordinal":392391,"en":"Fashioned out of marvels,"},{"id":"sayakbay-ms-current144:pdf051:l025","ordinal":392392,"en":"[His battle cry won over peoples,]"},{"id":"sayakbay-ms-current144:pdf051:l026","ordinal":392393,"en":"Kydyr never ceased to bless him."},{"id":"sayakbay-ms-current144:pdf052:l004","ordinal":392394,"en":"A remnant of pure steel,"},{"id":"sayakbay-ms-current144:pdf052:l014","ordinal":392395,"en":"When they incurred his wrath,"},{"id":"sayakbay-ms-current144:pdf052:l016","ordinal":392396,"en":"Many enemies directed their malice at him;"},{"id":"sayakbay-ms-current144:pdf052:l024","ordinal":392397,"en":"Kunansur, who came from the fairies,"},{"id":"sayakbay-ms-current144:pdf053:l009","ordinal":392398,"en":"[A joining of three joined parts,]"},{"id":"sayakbay-ms-current144:pdf053:l015","ordinal":392399,"en":"Its walk like a wolf's trot."},{"id":"sayakbay-ms-current144:pdf053:l019","ordinal":392400,"en":"Unless some dark misfortune befell,"},{"id":"sayakbay-ms-current144:pdf053:l021","ordinal":392401,"en":"Kunansur, the swift noble warhorse,"},{"id":"sayakbay-ms-current144:pdf053:l026","ordinal":392402,"en":"Kunansur, beautifully formed,"},{"id":"sayakbay-ms-current144:pdf054:l009","ordinal":392403,"en":"For ten days Seytek made no move,"},{"id":"sayakbay-ms-current144:pdf054:l013","ordinal":392404,"en":"[Having come endowed with wonders,]"},{"id":"sayakbay-ms-current144:pdf054:l014","ordinal":392405,"en":"Had become queen of the fairy folk."},{"id":"sayakbay-ms-current144:pdf054:l015","ordinal":392406,"en":"A maiden sovereign, a valiant girl,"},{"id":"sayakbay-ms-current144:pdf054:l016","ordinal":392407,"en":"One whose desires God granted,"},{"id":"sayakbay-ms-current144:pdf054:l017","ordinal":392408,"en":"One who attained what she sought,"},{"id":"sayakbay-ms-current144:pdf054:l018","ordinal":392409,"en":"[Her honor surpassed the purest,]"},{"id":"sayakbay-ms-current144:pdf054:l019","ordinal":392410,"en":"[Foremost among women,]"},{"id":"sayakbay-ms-current144:pdf054:l020","ordinal":392411,"en":"[She discerned with wondrous wisdom,]"},{"id":"sayakbay-ms-current144:pdf054:l021","ordinal":392412,"en":"She rinsed her mouth with butter,"},{"id":"sayakbay-ms-current144:pdf054:l022","ordinal":392413,"en":"Most wise and discerning,"},{"id":"sayakbay-ms-current144:pdf054:l024","ordinal":392414,"en":"Troubles six months distant,"},{"id":"sayakbay-ms-current144:pdf054:l025","ordinal":392415,"en":"She perceived in thought from afar."},{"id":"sayakbay-ms-current144:pdf054:l027","ordinal":392416,"en":"The cold wind of whitening dawn,"},{"id":"sayakbay-ms-current144:pdf054:l028","ordinal":392417,"en":"[When it struck with a chill,]"},{"id":"sayakbay-ms-current144:pdf054:l029","ordinal":392418,"en":"[At the twig's tip, chirping,]"},{"id":"sayakbay-ms-current144:pdf054:l030","ordinal":392419,"en":"The reeds sang and quivered."},{"id":"sayakbay-ms-current144:pdf055:l001","ordinal":392420,"en":"When dawn began to break,"},{"id":"sayakbay-ms-current144:pdf055:l002","ordinal":392421,"en":"Waking with a start from sleep,"},{"id":"sayakbay-ms-current144:pdf055:l003","ordinal":392422,"en":"She hurried in a fierce mood,"},{"id":"sayakbay-ms-current144:pdf055:l004","ordinal":392423,"en":"Put on her clothes and straightened them,"},{"id":"sayakbay-ms-current144:pdf055:l005","ordinal":392424,"en":"Dipped her hands into water,"},{"id":"sayakbay-ms-current144:pdf055:l007","ordinal":392425,"en":"She appealed to his ancestral spirit:"},{"id":"sayakbay-ms-current144:pdf055:l008","ordinal":392426,"en":"The only child left by the hero—"},{"id":"sayakbay-ms-current144:pdf055:l009","ordinal":392427,"en":"What would become of him?"},{"id":"sayakbay-ms-current144:pdf055:l010","ordinal":392428,"en":"Through wondrous power she knew,"},{"id":"sayakbay-ms-current144:pdf055:l011","ordinal":392429,"en":"The unfortunate, imperfect mortal."},{"id":"sayakbay-ms-current144:pdf055:l012","ordinal":392430,"en":"Its back was gold, its sleeves brass,"},{"id":"sayakbay-ms-current144:pdf055:l013","ordinal":392431,"en":"Half a cubit in thickness,"},{"id":"sayakbay-ms-current144:pdf055:l015","ordinal":392432,"en":"For facing the enemy alone,"},{"id":"sayakbay-ms-current144:pdf055:l016","ordinal":392433,"en":"[For the wretched sufferer, the holy night,]"},{"id":"sayakbay-ms-current144:pdf055:l017","ordinal":392434,"en":"[Such a day is never created,]"},{"id":"sayakbay-ms-current144:pdf055:l018","ordinal":392435,"en":"For the leopard-like hero Seytek,"},{"id":"sayakbay-ms-current144:pdf055:l019","ordinal":392436,"en":"So an enemy encountering him might see,"},{"id":"sayakbay-ms-current144:pdf055:l020","ordinal":392437,"en":"So he might wear it against his foes,"},{"id":"sayakbay-ms-current144:pdf055:l022","ordinal":392438,"en":"To finish them all, spilling their blood,"},{"id":"sayakbay-ms-current144:pdf055:l023","ordinal":392439,"en":"[To sweep dust across their land,]"},{"id":"sayakbay-ms-current144:pdf055:l025","ordinal":392440,"en":"[Its outer surface was so splendid,]"},{"id":"sayakbay-ms-current144:pdf055:l026","ordinal":392441,"en":"My dear one with the brass thimble,"},{"id":"sayakbay-ms-current144:pdf055:l027","ordinal":392442,"en":"[Such was her sturdy handiwork,]"},{"id":"sayakbay-ms-current144:pdf055:l028","ordinal":392443,"en":"The purest of those in flowing dresses,"},{"id":"sayakbay-ms-current144:pdf056:l001","ordinal":392444,"en":"She herself was queen among women,"},{"id":"sayakbay-ms-current144:pdf056:l006","ordinal":392445,"en":"To that unfortunate Perizaada,"},{"id":"sayakbay-ms-current144:pdf056:l007","ordinal":392446,"en":"No mortal could compare,"},{"id":"sayakbay-ms-current144:pdf056:l016","ordinal":392447,"en":"[Enchanting the moon and sun,]"},{"id":"sayakbay-ms-current144:pdf056:l017","ordinal":392448,"en":"[That day's spectacle,]"}]
