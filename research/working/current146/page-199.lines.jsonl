{"id": "sayakbay-ms-current146:pdf199:l025", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 199, "folio": 582, "line_in_page": 25, "raw": "Эбегей, коңой эр жок,", "text": "Эбегей, коңой эр жок,", "en": "There was no immense, mighty hero.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf199:l026", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 199, "folio": 582, "line_in_page": 26, "raw": "Эши жандан күчүмдү,", "text": "Эши жандан күчүмдү,", "en": "My strength, dearer than life itself,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, proper name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf199:l027", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 199, "folio": 582, "line_in_page": 27, "raw": "Колун сунуп дарбайым,", "text": "Колун сунуп дарбайым,", "en": "I reach out my hand and implore.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf199:l028", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 199, "folio": 582, "line_in_page": 28, "raw": "Чеңкер чукум кемпир,", "text": "Чеңкер чукум кемпир,", "en": "Chengker, the shriveled old woman,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, proper name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf199:l029", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 199, "folio": 582, "line_in_page": 29, "raw": "Коло болду Кытайда,", "text": "Коло болду Кытайда,", "en": "Became bronze in China.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf199:l030", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 199, "folio": 582, "line_in_page": 30, "raw": "Кытайдан айрылды,", "text": "Кытайдан айрылды,", "en": "She was separated from China.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf199:l031", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 199, "folio": 582, "line_in_page": 31, "raw": "Агыз калган арсыгы,", "text": "Агыз калган арсыгы,", "en": "The remnant left to wander,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, proper name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf199:l032", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 199, "folio": 582, "line_in_page": 32, "raw": "Азыр кармап алам деп,", "text": "Азыр кармап алам деп,", "en": "Saying, “Now I shall seize him,”", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf199:l033", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 199, "folio": 582, "line_in_page": 33, "raw": "Баатырсыңган Чеңкер,", "text": "Баатырсыңган Чеңкер,", "en": "Chengker, who boasted of heroism,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf199:l034", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 199, "folio": 582, "line_in_page": 34, "raw": "Баарын байлап алган,", "text": "Баарын байлап алган,", "en": "Had bound them all.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
