[{"id":"semetey-1-2013:p1302:b004:l001","ordinal":175617,"en":"“I spread my hands to the holy sage;"},{"id":"semetey-1-2013:p1302:b004:l002","ordinal":175618,"en":"Be my blessing, Taibuurul."},{"id":"semetey-1-2013:p1302:b004:l003","ordinal":175619,"en":"I have met an overwhelming foe;"},{"id":"semetey-1-2013:p1302:b004:l004","ordinal":175620,"en":"Be my father, Taibuurul."},{"id":"semetey-1-2013:p1302:b004:l005","ordinal":175621,"en":"My mother remains far away;"},{"id":"semetey-1-2013:p1302:b004:l006","ordinal":175622,"en":"My beloved Taibuurul,"},{"id":"semetey-1-2013:p1302:b004:l007","ordinal":175623,"en":"Protect me as a mother.”"},{"id":"semetey-1-2013:p1302:b004:l008","ordinal":175624,"en":"His noble lord’s Akolpok,"},{"id":"semetey-1-2013:p1302:b004:l009","ordinal":175625,"en":"With golden collar and copper sleeves,"},{"id":"semetey-1-2013:p1302:b004:l010","ordinal":175626,"en":"Which no bullet pierced when worn in battle,"},{"id":"semetey-1-2013:p1302:b004:l011","ordinal":175627,"en":"Külchoro took"},{"id":"semetey-1-2013:p1302:b004:l012","ordinal":175628,"en":"And now draped crosswise"},{"id":"semetey-1-2013:p1302:b004:l013","ordinal":175629,"en":"Over Taibuurul."},{"id":"semetey-1-2013:p1302:b004:l014","ordinal":175630,"en":"The great reins tied in a loop"},{"id":"semetey-1-2013:p1302:b004:l015","ordinal":175631,"en":"He flung trailing ahead;"},{"id":"semetey-1-2013:p1302:b004:l016","ordinal":175632,"en":"Külchoro, a master of judgment,"},{"id":"semetey-1-2013:p1302:b004:l017","ordinal":175633,"en":"Now entered upon his stratagem."},{"id":"semetey-1-2013:p1302:b004:l018","ordinal":175634,"en":"Beside the moonlike stallion’s"},{"id":"semetey-1-2013:p1302:b004:l019","ordinal":175635,"en":"Fat flank he took shelter;"},{"id":"semetey-1-2013:p1302:b004:l020","ordinal":175636,"en":"Covering himself with one skirt of the armor,"},{"id":"semetey-1-2013:p1302:b004:l021","ordinal":175637,"en":"He lay watching Khojo."},{"id":"semetey-1-2013:p1302:b004:l022","ordinal":175638,"en":"The lion-born Choro’s"},{"id":"semetey-1-2013:p1302:b004:l023","ordinal":175639,"en":"Eyes reddened like fire,"},{"id":"semetey-1-2013:p1302:b004:l024","ordinal":175640,"en":"His neck stretched like a drake’s;"},{"id":"semetey-1-2013:p1302:b004:l025","ordinal":175641,"en":"The gray kise that fell from heaven"},{"id":"semetey-1-2013:p1302:b004:l026","ordinal":175642,"en":"Was slung around his neck."},{"id":"semetey-1-2013:p1302:b004:l027","ordinal":175643,"en":"He pleaded with the spirits"},{"id":"semetey-1-2013:p1302:b004:l028","ordinal":175644,"en":"Of the lions gone to the other world."},{"id":"semetey-1-2013:p1302:b004:l029","ordinal":175645,"en":"Early words became late;"},{"id":"semetey-1-2013:p1302:b004:l030","ordinal":175646,"en":"For one exchange of shots"},{"id":"semetey-1-2013:p1302:b004:l031","ordinal":175647,"en":"With Chynkojo, son of Shygai,"},{"id":"semetey-1-2013:p1302:b004:l032","ordinal":175648,"en":"His two eyes became four with eagerness."},{"id":"semetey-1-2013:p1302:b004:l033","ordinal":175649,"en":"His gaze clouded in a strange way;"},{"id":"semetey-1-2013:p1302:b004:l034","ordinal":175650,"en":"From behind the white saddle’s pommel,"},{"id":"semetey-1-2013:p1302:b004:l035","ordinal":175651,"en":"He edged Akkelte’s muzzle out"},{"id":"semetey-1-2013:p1302:b004:l036","ordinal":175652,"en":"So slightly one could scarcely tell."},{"id":"semetey-1-2013:p1302:b004:l037","ordinal":175653,"en":"He promised a sheep to Koroson,"},{"id":"semetey-1-2013:p1302:b004:l038","ordinal":175654,"en":"Promised a horse to the holy sage,"},{"id":"semetey-1-2013:p1302:b004:l039","ordinal":175655,"en":"And to the spirits of the lions,"},{"id":"semetey-1-2013:p1303:b003:l001","ordinal":175656,"en":"Quickly promised a white-gray mare."},{"id":"semetey-1-2013:p1303:b003:l002","ordinal":175657,"en":"Saying, “God, set my grave task right;"},{"id":"semetey-1-2013:p1303:b003:l003","ordinal":175658,"en":"My valiant father Almambet,"},{"id":"semetey-1-2013:p1303:b003:l004","ordinal":175659,"en":"May your spirit support me now."},{"id":"semetey-1-2013:p1303:b003:l005","ordinal":175660,"en":"This one too was a lion,"},{"id":"semetey-1-2013:p1303:b003:l006","ordinal":175661,"en":"Chubak, son of Akbaltai;"},{"id":"semetey-1-2013:p1303:b003:l007","ordinal":175662,"en":"Girded at the solitary pass,"},{"id":"semetey-1-2013:p1303:b003:l008","ordinal":175663,"en":"If there were an army of seven divisions,"},{"id":"semetey-1-2013:p1303:b003:l009","ordinal":175664,"en":"He entered lightly clothed and attacked."},{"id":"semetey-1-2013:p1303:b003:l010","ordinal":175665,"en":"Syrgak, son of Ulak Khan,"},{"id":"semetey-1-2013:p1303:b003:l011","ordinal":175666,"en":"May God set my task right;"},{"id":"semetey-1-2013:p1303:b003:l012","ordinal":175667,"en":"My lone life has come under strain—"},{"id":"semetey-1-2013:p1303:b003:l013","ordinal":175668,"en":"Spirits, support me now!"},{"id":"semetey-1-2013:p1303:b003:l014","ordinal":175669,"en":"His heart torn apart,"},{"id":"semetey-1-2013:p1303:b003:l015","ordinal":175670,"en":"Wondering, “What recourse have we?”"},{"id":"semetey-1-2013:p1303:b003:l016","ordinal":175671,"en":"Tears poured from his eyes."},{"id":"semetey-1-2013:p1303:b003:l017","ordinal":175672,"en":"Grieving, weeping, and distraught,"},{"id":"semetey-1-2013:p1303:b003:l018","ordinal":175673,"en":"Pleading with the one God,"},{"id":"semetey-1-2013:p1303:b003:l019","ordinal":175674,"en":"Saying, “My Creator and Lord, protect me,”"},{"id":"semetey-1-2013:p1303:b003:l020","ordinal":175675,"en":"Külchoro lay there."},{"id":"semetey-1-2013:p1303:b003:l021","ordinal":175676,"en":"Chynkojo, son of Shygai,"},{"id":"semetey-1-2013:p1303:b003:l022","ordinal":175677,"en":"Khojo, resolute in his deeds,"},{"id":"semetey-1-2013:p1303:b003:l023","ordinal":175678,"en":"Rounded Mount Kasaba,"},{"id":"semetey-1-2013:p1303:b003:l024","ordinal":175679,"en":"His arms and armor fastened on."},{"id":"semetey-1-2013:p1303:b003:l025","ordinal":175680,"en":"The earth split with his thunder,"},{"id":"semetey-1-2013:p1303:b003:l026","ordinal":175681,"en":"And monster Khojo roared;"},{"id":"semetey-1-2013:p1303:b003:l027","ordinal":175682,"en":"Looming like Mount Opol,"},{"id":"semetey-1-2013:p1303:b003:l028","ordinal":175683,"en":"He had fastened on enough powder and shot"},{"id":"semetey-1-2013:p1303:b003:l029","ordinal":175684,"en":"For six months."},{"id":"semetey-1-2013:p1303:b003:l030","ordinal":175685,"en":"His courage cruel, his strength immense,"},{"id":"semetey-1-2013:p1303:b003:l031","ordinal":175686,"en":"Leopard Khojo then"},{"id":"semetey-1-2013:p1303:b003:l032","ordinal":175687,"en":"Leveled anyone who challenged him."},{"id":"semetey-1-2013:p1303:b003:l033","ordinal":175688,"en":"Leopard Khojo, the destroyer,"},{"id":"semetey-1-2013:p1303:b003:l034","ordinal":175689,"en":"Had the custom of drinking the blood"},{"id":"semetey-1-2013:p1303:b003:l035","ordinal":175690,"en":"Of every enemy who opposed him."},{"id":"semetey-1-2013:p1303:b003:l036","ordinal":175691,"en":"When his rage came boiling,"},{"id":"semetey-1-2013:p1303:b003:l037","ordinal":175692,"en":"Dark clouds could not obscure him;"},{"id":"semetey-1-2013:p1303:b003:l038","ordinal":175693,"en":"While his black stallion remained,"},{"id":"semetey-1-2013:p1303:b003:l039","ordinal":175694,"en":"No mortal could escape alive."},{"id":"semetey-1-2013:p1303:b004:l001","ordinal":175695,"en":"Foul mist and low mist"},{"id":"semetey-1-2013:p1303:b004:l002","ordinal":175696,"en":"He spread over the earth;"},{"id":"semetey-1-2013:p1303:b004:l003","ordinal":175697,"en":"Khojo, marking Buurul,"},{"id":"semetey-1-2013:p1303:b004:l004","ordinal":175698,"en":"Came storming up."},{"id":"semetey-1-2013:p1303:b004:l005","ordinal":175699,"en":"His eyes blazed like a boar’s;"},{"id":"semetey-1-2013:p1303:b004:l006","ordinal":175700,"en":"His great teeth, broad as a gate,"},{"id":"semetey-1-2013:p1303:b004:l007","ordinal":175701,"en":"Dear Khojo then"},{"id":"semetey-1-2013:p1303:b004:l008","ordinal":175702,"en":"Gnashed row upon row."},{"id":"semetey-1-2013:p1303:b004:l009","ordinal":175703,"en":"Chynkojo took"},{"id":"semetey-1-2013:p1303:b004:l010","ordinal":175704,"en":"The wide-mouthed secret bow"},{"id":"semetey-1-2013:p1303:b004:l011","ordinal":175705,"en":"And shot a hundred arrows with it."},{"id":"semetey-1-2013:p1303:b004:l012","ordinal":175706,"en":"He had a golden bow beside him;"},{"id":"semetey-1-2013:p1303:b004:l013","ordinal":175707,"en":"And leopard Khojo"},{"id":"semetey-1-2013:p1303:b004:l014","ordinal":175708,"en":"Shot a hundred arrows with that too."},{"id":"semetey-1-2013:p1303:b004:l015","ordinal":175709,"en":"An eleven-charge ochogor—"},{"id":"semetey-1-2013:p1303:b004:l016","ordinal":175710,"en":"Chynkojo was no easy foe;"},{"id":"semetey-1-2013:p1303:b004:l017","ordinal":175711,"en":"Taking aim, he fired a hundred shots."},{"id":"semetey-1-2013:p1303:b004:l018","ordinal":175712,"en":"The white gun at his shoulder"},{"id":"semetey-1-2013:p1303:b004:l019","ordinal":175713,"en":"He took and fired a hundred shots."},{"id":"semetey-1-2013:p1303:b004:l020","ordinal":175714,"en":"That leopard Khojo"},{"id":"semetey-1-2013:p1303:b004:l021","ordinal":175715,"en":"Drew his bow like pouring rain"},{"id":"semetey-1-2013:p1303:b004:l022","ordinal":175716,"en":"And fired bullets like hail."},{"id":"semetey-1-2013:p1303:b004:l023","ordinal":175717,"en":"Khan Khojo grew furious;"},{"id":"semetey-1-2013:p1303:b004:l024","ordinal":175718,"en":"As though black doom had struck his wife,"},{"id":"semetey-1-2013:p1303:b004:l025","ordinal":175719,"en":"Khojo lashed his horse."},{"id":"semetey-1-2013:p1303:b004:l026","ordinal":175720,"en":"His bullets streamed like hail;"},{"id":"semetey-1-2013:p1303:b004:l027","ordinal":175721,"en":"Külchoro then lay"},{"id":"semetey-1-2013:p1303:b004:l028","ordinal":175722,"en":"Sheltered behind Taibuurul."},{"id":"semetey-1-2013:p1303:b004:l029","ordinal":175723,"en":"As though ready to swallow him,"},{"id":"semetey-1-2013:p1303:b004:l030","ordinal":175724,"en":"Khojo came on in distress;"},{"id":"semetey-1-2013:p1303:b004:l031","ordinal":175725,"en":"Külchoro lay there"},{"id":"semetey-1-2013:p1303:b004:l032","ordinal":175726,"en":"Pleading with the one God."},{"id":"semetey-1-2013:p1303:b004:l033","ordinal":175727,"en":"From the sky, pale clouds split apart;"},{"id":"semetey-1-2013:p1303:b004:l034","ordinal":175728,"en":"With no prince visible upon him,"},{"id":"semetey-1-2013:p1303:b004:l035","ordinal":175729,"en":"Taibuurul stood in view."},{"id":"semetey-1-2013:p1303:b004:l036","ordinal":175730,"en":"When Khojo saw Taibuurul,"},{"id":"semetey-1-2013:p1303:b004:l037","ordinal":175731,"en":"He exulted wildly,"},{"id":"semetey-1-2013:p1303:b004:l038","ordinal":175732,"en":"And now raged in frenzy."},{"id":"semetey-1-2013:p1303:b004:l039","ordinal":175733,"en":"The orphaned son of Manas—"},{"id":"semetey-1-2013:p1304:b003:l001","ordinal":175734,"en":"The wretched soul formed like a tiger—"},{"id":"semetey-1-2013:p1304:b003:l002","ordinal":175735,"en":"It seems I have overthrown him."},{"id":"semetey-1-2013:p1304:b003:l003","ordinal":175736,"en":"The dear soul formed like a boar—"},{"id":"semetey-1-2013:p1304:b003:l004","ordinal":175737,"en":"It seems I have cut him down."},{"id":"semetey-1-2013:p1304:b003:l005","ordinal":175738,"en":"Buurul, whom they would not give when asked—"},{"id":"semetey-1-2013:p1304:b003:l006","ordinal":175739,"en":"I shall cast a cold lasso over him;"},{"id":"semetey-1-2013:p1304:b003:l007","ordinal":175740,"en":"Chürök, whom I have long desired,"},{"id":"semetey-1-2013:p1304:b003:l008","ordinal":175741,"en":"I shall take for myself alone."},{"id":"semetey-1-2013:p1304:b003:l009","ordinal":175742,"en":"Bringing humiliation upon Afghanistan,"},{"id":"semetey-1-2013:p1304:b003:l010","ordinal":175743,"en":"I shall gather khojas and mullahs;"},{"id":"semetey-1-2013:p1304:b003:l011","ordinal":175744,"en":"Chürök, daughter of Akun,"},{"id":"semetey-1-2013:p1304:b003:l012","ordinal":175745,"en":"I shall take as wife for myself."},{"id":"semetey-1-2013:p1304:b003:l013","ordinal":175746,"en":"I shall not accept what they say;"},{"id":"semetey-1-2013:p1304:b003:l014","ordinal":175747,"en":"To the accursed Toltoy,"},{"id":"semetey-1-2013:p1304:b003:l015","ordinal":175748,"en":"I shall not give Aychürök."},{"id":"semetey-1-2013:p1304:b003:l016","ordinal":175749,"en":"My wrath rose and I stiffened;"},{"id":"semetey-1-2013:p1304:b003:l017","ordinal":175750,"en":"The orphan son of Manas—"},{"id":"semetey-1-2013:p1304:b003:l018","ordinal":175751,"en":"I shall seize his treasury."},{"id":"semetey-1-2013:p1304:b003:l019","ordinal":175752,"en":"Burning their goods,"},{"id":"semetey-1-2013:p1304:b003:l020","ordinal":175753,"en":"I shall seize them and gouge out their eyes;"},{"id":"semetey-1-2013:p1304:b003:l021","ordinal":175754,"en":"The slaves left from the companions—"},{"id":"semetey-1-2013:p1304:b003:l022","ordinal":175755,"en":"I shall bind and take Bakai."},{"id":"semetey-1-2013:p1304:b003:l023","ordinal":175756,"en":"Dragging him along the road,"},{"id":"semetey-1-2013:p1304:b003:l024","ordinal":175757,"en":"I shall slaughter him as a sacrifice."},{"id":"semetey-1-2013:p1304:b003:l025","ordinal":175758,"en":"The accursed Akun,"},{"id":"semetey-1-2013:p1304:b003:l026","ordinal":175759,"en":"The infidel who begrudged his daughter—"},{"id":"semetey-1-2013:p1304:b003:l027","ordinal":175760,"en":"I shall do with him as I please,"},{"id":"semetey-1-2013:p1304:b003:l028","ordinal":175761,"en":"And slaughter all his people."},{"id":"semetey-1-2013:p1304:b003:l029","ordinal":175762,"en":"I shall leave them like a deserted camp;"},{"id":"semetey-1-2013:p1304:b003:l030","ordinal":175763,"en":"Thus shall I reach their root,"},{"id":"semetey-1-2013:p1304:b003:l031","ordinal":175764,"en":"And slaughter them without leaving one."},{"id":"semetey-1-2013:p1304:b003:l032","ordinal":175765,"en":"Taylak, Bakai's wretched son,"},{"id":"semetey-1-2013:p1304:b003:l033","ordinal":175766,"en":"Taylak, the worst dog of all—"},{"id":"semetey-1-2013:p1304:b003:l034","ordinal":175767,"en":"I shall cut his hamstrings"},{"id":"semetey-1-2013:p1304:b003:l035","ordinal":175768,"en":"And make him a horse herder."},{"id":"semetey-1-2013:p1304:b003:l036","ordinal":175769,"en":"Kalyk, son of Sary Khan—"},{"id":"semetey-1-2013:p1304:b003:l037","ordinal":175770,"en":"I shall put a bridle around his neck;"},{"id":"semetey-1-2013:p1304:b003:l038","ordinal":175771,"en":"Saying, ‘He is my captured slave,’"},{"id":"semetey-1-2013:p1304:b003:l039","ordinal":175772,"en":"I shall sell him to the Kyzylbash people."},{"id":"semetey-1-2013:p1304:b004:l001","ordinal":175773,"en":"I shall destroy and seize them all;"},{"id":"semetey-1-2013:p1304:b004:l002","ordinal":175774,"en":"Now that the mighty gray wolf is dead,"},{"id":"semetey-1-2013:p1304:b004:l003","ordinal":175775,"en":"The strength has left them all."},{"id":"semetey-1-2013:p1304:b004:l004","ordinal":175776,"en":"Bloodthirsty Semetey has died;"},{"id":"semetey-1-2013:p1304:b004:l005","ordinal":175777,"en":"My own eyes behold his death."},{"id":"semetey-1-2013:p1304:b004:l006","ordinal":175778,"en":"Taybuurul came out with neck stretched,"},{"id":"semetey-1-2013:p1304:b004:l007","ordinal":175779,"en":"Distraught, dragging his reins;"},{"id":"semetey-1-2013:p1304:b004:l008","ordinal":175780,"en":"Your bloodthirsty hero's ak-olpok armor"},{"id":"semetey-1-2013:p1304:b004:l009","ordinal":175781,"en":"Hung askew from the saddle bow."},{"id":"semetey-1-2013:p1304:b004:l010","ordinal":175782,"en":"Saying, ‘My eyes have seen his death,’"},{"id":"semetey-1-2013:p1304:b004:l011","ordinal":175783,"en":"Saying, ‘His horse has fled back,’"},{"id":"semetey-1-2013:p1304:b004:l012","ordinal":175784,"en":"Saying, ‘God has granted my wish.’"},{"id":"semetey-1-2013:p1304:b004:l013","ordinal":175785,"en":"Shouting, ‘Baabedin!’"},{"id":"semetey-1-2013:p1304:b004:l014","ordinal":175786,"en":"Chynkojo flailed his arms,"},{"id":"semetey-1-2013:p1304:b004:l015","ordinal":175787,"en":"And raised the battle cry of Shygai."},{"id":"semetey-1-2013:p1304:b004:l016","ordinal":175788,"en":"Raging, he spurred ahead;"},{"id":"semetey-1-2013:p1304:b004:l017","ordinal":175789,"en":"“Ah, God has granted it!” he cried,"},{"id":"semetey-1-2013:p1304:b004:l018","ordinal":175790,"en":"And all his weapons"},{"id":"semetey-1-2013:p1304:b004:l019","ordinal":175791,"en":"He hurled toward Taybuurul."},{"id":"semetey-1-2013:p1304:b004:l020","ordinal":175792,"en":"Circling on the black horse,"},{"id":"semetey-1-2013:p1304:b004:l021","ordinal":175793,"en":"He now came within half a target's range."},{"id":"semetey-1-2013:p1304:b004:l022","ordinal":175794,"en":"Its fastenings were nine;"},{"id":"semetey-1-2013:p1304:b004:l023","ordinal":175795,"en":"He undid the fastenings."},{"id":"semetey-1-2013:p1304:b004:l024","ordinal":175796,"en":"Its buttons were nine;"},{"id":"semetey-1-2013:p1304:b004:l025","ordinal":175797,"en":"He undid the buttons."},{"id":"semetey-1-2013:p1304:b004:l026","ordinal":175798,"en":"The khoja set his mind"},{"id":"semetey-1-2013:p1304:b004:l027","ordinal":175799,"en":"On quickly dismounting,"},{"id":"semetey-1-2013:p1304:b004:l028","ordinal":175800,"en":"To seize as plunder"},{"id":"semetey-1-2013:p1304:b004:l029","ordinal":175801,"en":"The Buurul horse that had emerged frisking."},{"id":"semetey-1-2013:p1304:b004:l030","ordinal":175802,"en":"Girding on his Arkesken sword,"},{"id":"semetey-1-2013:p1304:b004:l031","ordinal":175803,"en":"Chynkojo, rejoicing,"},{"id":"semetey-1-2013:p1304:b004:l032","ordinal":175804,"en":"Came drawing near."},{"id":"semetey-1-2013:p1304:b004:l033","ordinal":175805,"en":"Circling within half a target's range,"},{"id":"semetey-1-2013:p1304:b004:l034","ordinal":175806,"en":"The clumsy khoja lurched,"},{"id":"semetey-1-2013:p1304:b004:l035","ordinal":175807,"en":"His two coat-tails flapping."},{"id":"semetey-1-2013:p1304:b004:l036","ordinal":175808,"en":"When the khoja came close,"},{"id":"semetey-1-2013:p1304:b004:l037","ordinal":175809,"en":"The companion's heart was stirred;"},{"id":"semetey-1-2013:p1304:b004:l038","ordinal":175810,"en":"The flank of his black horse,"},{"id":"semetey-1-2013:p1304:b004:l039","ordinal":175811,"en":"Its wing in flight,"},{"id":"semetey-1-2013:p1305:b003:l001","ordinal":175812,"en":"Was clearly and plainly visible."},{"id":"semetey-1-2013:p1305:b003:l002","ordinal":175813,"en":"“That is one edge of the wing;"},{"id":"semetey-1-2013:p1305:b003:l003","ordinal":175814,"en":"If Akkelte strikes farther over,"},{"id":"semetey-1-2013:p1305:b003:l004","ordinal":175815,"en":"That is the lower edge of the lung.”"},{"id":"semetey-1-2013:p1305:b003:l005","ordinal":175816,"en":"Pure in marksmanship,"},{"id":"semetey-1-2013:p1305:b003:l006","ordinal":175817,"en":"The ready gun-rest at hand,"},{"id":"semetey-1-2013:p1305:b003:l007","ordinal":175818,"en":"Külchoro flicked it into place;"},{"id":"semetey-1-2013:p1305:b003:l008","ordinal":175819,"en":"Akkelte went to work."},{"id":"semetey-1-2013:p1305:b003:l009","ordinal":175820,"en":"The Akkelte gun cracked;"},{"id":"semetey-1-2013:p1305:b003:l010","ordinal":175821,"en":"Though your supporters be countless,"},{"id":"semetey-1-2013:p1305:b003:l011","ordinal":175822,"en":"The valiant khoja dropped flat."},{"id":"semetey-1-2013:p1305:b003:l012","ordinal":175823,"en":"The bullet fired at his middle"},{"id":"semetey-1-2013:p1305:b003:l013","ordinal":175824,"en":"Grazed through his wing,"},{"id":"semetey-1-2013:p1305:b003:l014","ordinal":175825,"en":"Entered farther into him,"},{"id":"semetey-1-2013:p1305:b003:l015","ordinal":175826,"en":"And shattered his lung."},{"id":"semetey-1-2013:p1305:b003:l016","ordinal":175827,"en":"From the dear valiant khoja,"},{"id":"semetey-1-2013:p1305:b003:l017","ordinal":175828,"en":"At the root of the thigh muscle,"},{"id":"semetey-1-2013:p1305:b003:l018","ordinal":175829,"en":"It tore away a span of flesh."},{"id":"semetey-1-2013:p1305:b003:l019","ordinal":175830,"en":"Chynkojo's black horse"},{"id":"semetey-1-2013:p1305:b003:l020","ordinal":175831,"en":"Wheeled around then,"},{"id":"semetey-1-2013:p1305:b003:l021","ordinal":175832,"en":"And he fell backward from it."},{"id":"semetey-1-2013:p1305:b003:l022","ordinal":175833,"en":"The khoja came screaming,"},{"id":"semetey-1-2013:p1305:b003:l023","ordinal":175834,"en":"Unable to find his bearings,"},{"id":"semetey-1-2013:p1305:b003:l024","ordinal":175835,"en":"Raising the battle cry of Shygai."},{"id":"semetey-1-2013:p1305:b003:l025","ordinal":175836,"en":"His voice reached God;"},{"id":"semetey-1-2013:p1305:b003:l026","ordinal":175837,"en":"Upon Külchoro"},{"id":"semetey-1-2013:p1305:b003:l027","ordinal":175838,"en":"He fell in a heap."},{"id":"semetey-1-2013:p1305:b003:l028","ordinal":175839,"en":"Külchoro, who had lain concealed,"},{"id":"semetey-1-2013:p1305:b003:l029","ordinal":175840,"en":"Roared in wrath,"},{"id":"semetey-1-2013:p1305:b003:l030","ordinal":175841,"en":"And stood looming there,"},{"id":"semetey-1-2013:p1305:b003:l031","ordinal":175842,"en":"Raising the battle cry of Manas."},{"id":"semetey-1-2013:p1305:b003:l032","ordinal":175843,"en":"Your orphan born of the hero"},{"id":"semetey-1-2013:p1305:b003:l033","ordinal":175844,"en":"Now reached Chynkojo."},{"id":"semetey-1-2013:p1305:b003:l034","ordinal":175845,"en":"Chynkojo, son of Shygai,"},{"id":"semetey-1-2013:p1305:b003:l035","ordinal":175846,"en":"The khoja whose deeds were bold—"},{"id":"semetey-1-2013:p1305:b003:l036","ordinal":175847,"en":"He and the companion"},{"id":"semetey-1-2013:p1305:b003:l037","ordinal":175848,"en":"Now seized each other by the collar."},{"id":"semetey-1-2013:p1305:b003:l038","ordinal":175849,"en":"They gripped each other's wrists"},{"id":"semetey-1-2013:p1305:b003:l039","ordinal":175850,"en":"And wrestled like champions."},{"id":"semetey-1-2013:p1305:b005:l001","ordinal":175851,"en":"Seizing and twisting him by the collar,"},{"id":"semetey-1-2013:p1305:b005:l002","ordinal":175852,"en":"Outmaneuvering the bow-bearing khoja,"},{"id":"semetey-1-2013:p1305:b005:l003","ordinal":175853,"en":"He lifted and dashed him to the ground."},{"id":"semetey-1-2013:p1305:b005:l004","ordinal":175854,"en":"The reeking khoja's"},{"id":"semetey-1-2013:p1305:b005:l005","ordinal":175855,"en":"Mustache he tore out and flung away;"},{"id":"semetey-1-2013:p1305:b005:l006","ordinal":175856,"en":"His beard he ripped out and scattered."},{"id":"semetey-1-2013:p1305:b005:l007","ordinal":175857,"en":"He pummeled him again and again;"},{"id":"semetey-1-2013:p1305:b005:l008","ordinal":175858,"en":"Black blood leaving his mouth,"},{"id":"semetey-1-2013:p1305:b005:l009","ordinal":175859,"en":"Yellow bile followed behind it."},{"id":"semetey-1-2013:p1305:b005:l010","ordinal":175860,"en":"The prince burst from the cave,"},{"id":"semetey-1-2013:p1305:b005:l011","ordinal":175861,"en":"Running with long strides."},{"id":"semetey-1-2013:p1305:b005:l012","ordinal":175862,"en":"Shouting, ‘Baabedin!’"},{"id":"semetey-1-2013:p1305:b005:l013","ordinal":175863,"en":"And rushing in wrath,"},{"id":"semetey-1-2013:p1305:b005:l014","ordinal":175864,"en":"The lion came,"},{"id":"semetey-1-2013:p1305:b005:l015","ordinal":175865,"en":"Pleading with Külchoro:"},{"id":"semetey-1-2013:p1305:b005:l016","ordinal":175866,"en":"“I tended a brave man and won a brave man's fortune;"},{"id":"semetey-1-2013:p1305:b005:l017","ordinal":175867,"en":"I have now seen its benefit."},{"id":"semetey-1-2013:p1305:b005:l018","ordinal":175868,"en":"My dear Külchoro,"},{"id":"semetey-1-2013:p1305:b005:l019","ordinal":175869,"en":"Blessed am I with a kinsman like you."},{"id":"semetey-1-2013:p1305:b005:l020","ordinal":175870,"en":"I tended an argamak and won a horse's fortune;"},{"id":"semetey-1-2013:p1305:b005:l021","ordinal":175871,"en":"My dear one, blessed am I"},{"id":"semetey-1-2013:p1305:b005:l022","ordinal":175872,"en":"With a charger like Taybuurul."}]
