[{"id":"semetey-1-2013:p1410:b003:l008","ordinal":184833,"en":"He tore at his beard!"},{"id":"semetey-1-2013:p1410:b003:l009","ordinal":184834,"en":"As Bakai stood thus,"},{"id":"semetey-1-2013:p1410:b003:l010","ordinal":184835,"en":"His heart was overcome;"},{"id":"semetey-1-2013:p1410:b003:l011","ordinal":184836,"en":"Seeing Bakai,"},{"id":"semetey-1-2013:p1410:b003:l012","ordinal":184837,"en":"The young son of the gray wolf"},{"id":"semetey-1-2013:p1410:b003:l013","ordinal":184838,"en":"Tears fell from his eyes:"},{"id":"semetey-1-2013:p1410:b003:l014","ordinal":184839,"en":"The gray wolf born after"},{"id":"semetey-1-2013:p1410:b003:l015","ordinal":184840,"en":"His father, noble Manas,"},{"id":"semetey-1-2013:p1410:b003:l016","ordinal":184841,"en":"Was overcome with grief;"},{"id":"semetey-1-2013:p1410:b003:l017","ordinal":184842,"en":"Seeing his uncle clearly,"},{"id":"semetey-1-2013:p1410:b003:l018","ordinal":184843,"en":"His tears poured down."},{"id":"semetey-1-2013:p1410:b003:l019","ordinal":184844,"en":"\"Uncle Bakai, heroic sultan,"},{"id":"semetey-1-2013:p1410:b003:l020","ordinal":184845,"en":"My dear one,"},{"id":"semetey-1-2013:p1410:b003:l021","ordinal":184846,"en":"Now that you have grown old,"},{"id":"semetey-1-2013:p1410:b003:l022","ordinal":184847,"en":"Let me be the sacrifice"},{"id":"semetey-1-2013:p1410:b003:l023","ordinal":184848,"en":"For your eyes that shot the white argali!"},{"id":"semetey-1-2013:p1410:b003:l024","ordinal":184849,"en":"Who made the ignorant know,"},{"id":"semetey-1-2013:p1410:b003:l025","ordinal":184850,"en":"My learned old Bakai,"},{"id":"semetey-1-2013:p1410:b003:l026","ordinal":184851,"en":"Who made the unperceptive perceive,"},{"id":"semetey-1-2013:p1410:b003:l027","ordinal":184852,"en":"My falconlike sage Bakai!"},{"id":"semetey-1-2013:p1410:b003:l028","ordinal":184853,"en":"My touchstone before the renowned people,"},{"id":"semetey-1-2013:p1410:b003:l029","ordinal":184854,"en":"My legacy left as a gift"},{"id":"semetey-1-2013:p1410:b003:l030","ordinal":184855,"en":"By my valiant father, the gray wolf!"},{"id":"semetey-1-2013:p1410:b003:l031","ordinal":184856,"en":"My saint born among mortals,"},{"id":"semetey-1-2013:p1410:b003:l032","ordinal":184857,"en":"My blessed old Bakai!"},{"id":"semetey-1-2013:p1410:b003:l033","ordinal":184858,"en":"Set before me, you are my good road;"},{"id":"semetey-1-2013:p1410:b003:l034","ordinal":184859,"en":"If my uncle Bakai the brave*"},{"id":"semetey-1-2013:p1410:b003:l035","ordinal":184860,"en":"Walks behind me, he is my countless host!"},{"id":"semetey-1-2013:p1410:b003:l036","ordinal":184861,"en":"For an uncle such as you,"},{"id":"semetey-1-2013:p1410:b003:l037","ordinal":184862,"en":"I would sacrifice my very life!"},{"id":"semetey-1-2013:p1410:b003:l038","ordinal":184863,"en":"Without understanding very much,"},{"id":"semetey-1-2013:p1410:b004:l001","ordinal":184864,"en":"I pushed you toward the grave, uncle,"},{"id":"semetey-1-2013:p1410:b004:l002","ordinal":184865,"en":"And acted out of arrogance!"},{"id":"semetey-1-2013:p1410:b004:l003","ordinal":184866,"en":"My dear elder khan,"},{"id":"semetey-1-2013:p1410:b004:l004","ordinal":184867,"en":"Let me offer you a courser;"},{"id":"semetey-1-2013:p1410:b004:l005","ordinal":184868,"en":"Take my steed Taibuurul;"},{"id":"semetey-1-2013:p1410:b004:l006","ordinal":184869,"en":"If your anger is still rising,"},{"id":"semetey-1-2013:p1410:b004:l007","ordinal":184870,"en":"Uncle gray wolf, leopard,"},{"id":"semetey-1-2013:p1410:b004:l008","ordinal":184871,"en":"Pour my blood into a leather flask!"},{"id":"semetey-1-2013:p1410:b004:l009","ordinal":184872,"en":"My old father Bakai,"},{"id":"semetey-1-2013:p1410:b004:l010","ordinal":184873,"en":"Whom I held in a father's place!"},{"id":"semetey-1-2013:p1410:b004:l011","ordinal":184874,"en":"Who joined what was broken,"},{"id":"semetey-1-2013:p1410:b004:l012","ordinal":184875,"en":"Gathered what was scattered,"},{"id":"semetey-1-2013:p1410:b004:l013","ordinal":184876,"en":"And found the means to live,"},{"id":"semetey-1-2013:p1410:b004:l014","ordinal":184877,"en":"My sage!\"—"},{"id":"semetey-1-2013:p1410:b004:l015","ordinal":184878,"en":"Thus spoke Semetey,"},{"id":"semetey-1-2013:p1410:b004:l016","ordinal":184879,"en":"Calling Bakai \"uncle, bloodthirsty one\";"},{"id":"semetey-1-2013:p1410:b004:l017","ordinal":184880,"en":"He turned his neck toward God,"},{"id":"semetey-1-2013:p1410:b004:l018","ordinal":184881,"en":"Pleaded, calling him dear uncle,"},{"id":"semetey-1-2013:p1410:b004:l019","ordinal":184882,"en":"And offered Narbuurul as a gift."},{"id":"semetey-1-2013:p1410:b004:l020","ordinal":184883,"en":"Then your uncle Bakai,"},{"id":"semetey-1-2013:p1410:b004:l021","ordinal":184884,"en":"Flying like a white hawk,"},{"id":"semetey-1-2013:p1410:b004:l022","ordinal":184885,"en":"Praying to God"},{"id":"semetey-1-2013:p1410:b004:l023","ordinal":184886,"en":"Now slaughtered a white argali;"},{"id":"semetey-1-2013:p1410:b004:l024","ordinal":184887,"en":"The lion, Khan Bakai,"},{"id":"semetey-1-2013:p1410:b004:l025","ordinal":184888,"en":"Now ate until his belly was filled."},{"id":"semetey-1-2013:p1410:b004:l026","ordinal":184889,"en":"Resting on his elbow,"},{"id":"semetey-1-2013:p1410:b004:l027","ordinal":184890,"en":"He took a brief sleep;"},{"id":"semetey-1-2013:p1410:b004:l028","ordinal":184891,"en":"At dawn"},{"id":"semetey-1-2013:p1410:b004:l029","ordinal":184892,"en":"Lying on his side, he slept his fill."},{"id":"semetey-1-2013:p1410:b004:l030","ordinal":184893,"en":"He let all the fine coursers"},{"id":"semetey-1-2013:p1410:b004:l031","ordinal":184894,"en":"Graze upon the fescue,"},{"id":"semetey-1-2013:p1410:b004:l032","ordinal":184895,"en":"Leading them onward,"},{"id":"semetey-1-2013:p1410:b004:l033","ordinal":184896,"en":"Filling their chests with grass;"},{"id":"semetey-1-2013:p1410:b004:l034","ordinal":184897,"en":"Without tiring, he sat"},{"id":"semetey-1-2013:p1410:b004:l035","ordinal":184898,"en":"And filled their lean bellies with grass."},{"id":"semetey-1-2013:p1410:b004:l036","ordinal":184899,"en":"Champion Bakai the leopard,"},{"id":"semetey-1-2013:p1410:b004:l037","ordinal":184900,"en":"My saint who knows what to do!"},{"id":"semetey-1-2013:p1410:b004:l038","ordinal":184901,"en":"The whole universe"},{"id":"semetey-1-2013:p1410:b004:l039","ordinal":184902,"en":"Was it not Bakai who divided it,"},{"id":"semetey-1-2013:p1411:b003:l001","ordinal":184903,"en":"Who had traversed this world—"},{"id":"semetey-1-2013:p1411:b003:l002","ordinal":184904,"en":"Was that not Bakai?"},{"id":"semetey-1-2013:p1411:b003:l003","ordinal":184905,"en":"Your uncle, champion Bakai,"},{"id":"semetey-1-2013:p1411:b003:l004","ordinal":184906,"en":"Started awake from sleep,"},{"id":"semetey-1-2013:p1411:b003:l005","ordinal":184907,"en":"Rolling onto his right side,"},{"id":"semetey-1-2013:p1411:b003:l006","ordinal":184908,"en":"Starting awake, he recited a prayer,"},{"id":"semetey-1-2013:p1411:b003:l007","ordinal":184909,"en":"Saddled Kökcholok,"},{"id":"semetey-1-2013:p1411:b003:l008","ordinal":184910,"en":"Readied his arms and armor,"},{"id":"semetey-1-2013:p1411:b003:l009","ordinal":184911,"en":"And girded on his unsheathed sword;"},{"id":"semetey-1-2013:p1411:b003:l010","ordinal":184912,"en":"Fuming in anger,"},{"id":"semetey-1-2013:p1411:b003:l011","ordinal":184913,"en":"Your uncle Bakai the leopard—"},{"id":"semetey-1-2013:p1411:b003:l012","ordinal":184914,"en":"Behold his bloodthirsty fury!"},{"id":"semetey-1-2013:p1411:b003:l013","ordinal":184915,"en":"Your uncle, valiant Bakai,"},{"id":"semetey-1-2013:p1411:b003:l014","ordinal":184916,"en":"Making the ignorant know,"},{"id":"semetey-1-2013:p1411:b003:l015","ordinal":184917,"en":"Making the unperceptive perceive."},{"id":"semetey-1-2013:p1411:b003:l016","ordinal":184918,"en":"Crossing rugged passes,"},{"id":"semetey-1-2013:p1411:b003:l017","ordinal":184919,"en":"Traveling the lone mountain road,"},{"id":"semetey-1-2013:p1411:b003:l018","ordinal":184920,"en":"They journeyed a long while,"},{"id":"semetey-1-2013:p1411:b003:l019","ordinal":184921,"en":"Crossing remarkable passes,"},{"id":"semetey-1-2013:p1411:b003:l020","ordinal":184922,"en":"Ridges, passes, and mountains."},{"id":"semetey-1-2013:p1411:b003:l021","ordinal":184923,"en":"How could your heroes hold back?"},{"id":"semetey-1-2013:p1411:b003:l022","ordinal":184924,"en":"They crossed winding mountains"},{"id":"semetey-1-2013:p1411:b003:l023","ordinal":184925,"en":"And forded winding waters;"},{"id":"semetey-1-2013:p1411:b003:l024","ordinal":184926,"en":"All the heroes grew eager,"},{"id":"semetey-1-2013:p1411:b003:l025","ordinal":184927,"en":"All the coursers grew spirited—"},{"id":"semetey-1-2013:p1411:b003:l026","ordinal":184928,"en":"How could the heroes hold back?"},{"id":"semetey-1-2013:p1411:b003:l027","ordinal":184929,"en":"They reached and halted at"},{"id":"semetey-1-2013:p1411:b003:l028","ordinal":184930,"en":"A gray-hazed yellow steppe."},{"id":"semetey-1-2013:p1411:b003:l029","ordinal":184931,"en":"It was a fine day's journey across."},{"id":"semetey-1-2013:p1411:b003:l030","ordinal":184932,"en":"Your uncle, the gray wolf, had named it"},{"id":"semetey-1-2013:p1411:b003:l031","ordinal":184933,"en":"The Fescue Steppe."},{"id":"semetey-1-2013:p1411:b003:l032","ordinal":184934,"en":"Do not ask what that steppe was like:"},{"id":"semetey-1-2013:p1411:b003:l033","ordinal":184935,"en":"It had no hill the size of an ankle-bone,"},{"id":"semetey-1-2013:p1411:b003:l034","ordinal":184936,"en":"No hollow the size of a saddle,"},{"id":"semetey-1-2013:p1411:b005:l001","ordinal":184937,"en":"No furrow touched by a plow,"},{"id":"semetey-1-2013:p1411:b005:l002","ordinal":184938,"en":"No hole dug by a marmot."},{"id":"semetey-1-2013:p1411:b005:l003","ordinal":184939,"en":"It gleamed without a trace of haze;"},{"id":"semetey-1-2013:p1411:b005:l004","ordinal":184940,"en":"It was the Fescue Steppe,"},{"id":"semetey-1-2013:p1411:b005:l005","ordinal":184941,"en":"Its rich growth waist-deep,"},{"id":"semetey-1-2013:p1411:b005:l006","ordinal":184942,"en":"A place where the people lay at ease."},{"id":"semetey-1-2013:p1411:b005:l007","ordinal":184943,"en":"When they reached that place,"},{"id":"semetey-1-2013:p1411:b005:l008","ordinal":184944,"en":"\"My river and spring in the valley,"},{"id":"semetey-1-2013:p1411:b005:l009","ordinal":184945,"en":"My young champion found late in life!"},{"id":"semetey-1-2013:p1411:b005:l010","ordinal":184946,"en":"Here upon this yellow steppe,"},{"id":"semetey-1-2013:p1411:b005:l011","ordinal":184947,"en":"Let us ride without growing weary;"},{"id":"semetey-1-2013:p1411:b005:l012","ordinal":184948,"en":"Let us race along the road"},{"id":"semetey-1-2013:p1411:b005:l013","ordinal":184949,"en":"And open up the horses' eyes!\""},{"id":"semetey-1-2013:p1411:b005:l014","ordinal":184950,"en":"His uncle Bakai said this,"},{"id":"semetey-1-2013:p1411:b005:l015","ordinal":184951,"en":"And Kökcholok opened his stride."},{"id":"semetey-1-2013:p1411:b005:l016","ordinal":184952,"en":"Dust billowed like a mountain,"},{"id":"semetey-1-2013:p1411:b005:l017","ordinal":184953,"en":"And he quivered as though about to fly;"},{"id":"semetey-1-2013:p1411:b005:l018","ordinal":184954,"en":"Semetey and Bakai raced,"},{"id":"semetey-1-2013:p1411:b005:l019","ordinal":184955,"en":"They grappled with the mouths"},{"id":"semetey-1-2013:p1411:b005:l020","ordinal":184956,"en":"Of the coursers beneath them,"},{"id":"semetey-1-2013:p1411:b005:l021","ordinal":184957,"en":"Making them rear and strain,"},{"id":"semetey-1-2013:p1411:b005:l022","ordinal":184958,"en":"Making them buck as though their riders had died."},{"id":"semetey-1-2013:p1411:b005:l023","ordinal":184959,"en":"How could your heroes hold back?"},{"id":"semetey-1-2013:p1411:b005:l024","ordinal":184960,"en":"At Echoing Jar-Kyya,"},{"id":"semetey-1-2013:p1411:b005:l025","ordinal":184961,"en":"Where a single horse-track wound on,"},{"id":"semetey-1-2013:p1411:b005:l026","ordinal":184962,"en":"Bakai halted there."},{"id":"semetey-1-2013:p1411:b005:l027","ordinal":184963,"en":"Onto the broken, narrow ridge"},{"id":"semetey-1-2013:p1411:b005:l028","ordinal":184964,"en":"Bakai rode his thoroughbred."},{"id":"semetey-1-2013:p1411:b005:l029","ordinal":184965,"en":"Yesterday, your leopard champion Almambet—"},{"id":"semetey-1-2013:p1411:b005:l030","ordinal":184966,"en":"There is the pass of Dust-Whirlwind,"},{"id":"semetey-1-2013:p1411:b005:l031","ordinal":184967,"en":"There is a lake called It-Ichpes."},{"id":"semetey-1-2013:p1411:b005:l032","ordinal":184968,"en":"Holding Lake It-Ichpes,"},{"id":"semetey-1-2013:p1411:b005:l033","ordinal":184969,"en":"There stands on watch Kuuördök,"},{"id":"semetey-1-2013:p1411:b005:l034","ordinal":184970,"en":"May the wretch burn in fire."},{"id":"semetey-1-2013:p1412:b004:l001","ordinal":184971,"en":"May Kongurbai burn to death—"},{"id":"semetey-1-2013:p1412:b004:l002","ordinal":184972,"en":"Kongurbai's watch-post,"},{"id":"semetey-1-2013:p1412:b004:l003","ordinal":184973,"en":"With foxes upon its pass,"},{"id":"semetey-1-2013:p1412:b004:l004","ordinal":184974,"en":"Argali upon its heights,"},{"id":"semetey-1-2013:p1412:b004:l005","ordinal":184975,"en":"And ducks upon its lake;"},{"id":"semetey-1-2013:p1412:b004:l006","ordinal":184976,"en":"That fire-doomed swine's"},{"id":"semetey-1-2013:p1412:b004:l007","ordinal":184977,"en":"Calamity lies in such a place."},{"id":"semetey-1-2013:p1412:b004:l008","ordinal":184978,"en":"The place is famed as Suuk-Tör;"},{"id":"semetey-1-2013:p1412:b004:l009","ordinal":184979,"en":"It has a pass where men take courage,"},{"id":"semetey-1-2013:p1412:b004:l010","ordinal":184980,"en":"A place where they lie entrenched."},{"id":"semetey-1-2013:p1412:b004:l011","ordinal":184981,"en":"The most advantageously placed of his guards,"},{"id":"semetey-1-2013:p1412:b004:l012","ordinal":184982,"en":"The finest of his sentries,"},{"id":"semetey-1-2013:p1412:b004:l013","ordinal":184983,"en":"Is that vile infidel Kuuördök."},{"id":"semetey-1-2013:p1412:b004:l014","ordinal":184984,"en":"If we capture it, my only one,"},{"id":"semetey-1-2013:p1412:b004:l015","ordinal":184985,"en":"God will have granted it to us;"},{"id":"semetey-1-2013:p1412:b004:l016","ordinal":184986,"en":"If the duck escapes,"},{"id":"semetey-1-2013:p1412:b004:l017","ordinal":184987,"en":"May God strike us!"},{"id":"semetey-1-2013:p1412:b004:l018","ordinal":184988,"en":"That fire-doomed Kuuördök"},{"id":"semetey-1-2013:p1412:b004:l019","ordinal":184989,"en":"To the gold-throned pavilion,"},{"id":"semetey-1-2013:p1412:b004:l020","ordinal":184990,"en":"To the great hero Kary Khan,"},{"id":"semetey-1-2013:p1412:b004:l021","ordinal":184991,"en":"Before one can say a word,"},{"id":"semetey-1-2013:p1412:b004:l022","ordinal":184992,"en":"In the blink of an eye,"},{"id":"semetey-1-2013:p1412:b004:l023","ordinal":184993,"en":"That fire-doomed Kuuördök"},{"id":"semetey-1-2013:p1412:b004:l024","ordinal":184994,"en":"A messenger to Beijing,"},{"id":"semetey-1-2013:p1412:b004:l025","ordinal":184995,"en":"Scurrying like an ant,"},{"id":"semetey-1-2013:p1412:b004:l026","ordinal":184996,"en":"China's army would come swarming."},{"id":"semetey-1-2013:p1412:b004:l027","ordinal":184997,"en":"Look at the reeds, look at the flood;"},{"id":"semetey-1-2013:p1412:b004:l028","ordinal":184998,"en":"If China is roused to anger,"},{"id":"semetey-1-2013:p1412:b004:l029","ordinal":184999,"en":"Look at the people who will engulf us!"},{"id":"semetey-1-2013:p1412:b004:l030","ordinal":185000,"en":"There will be deep, thick-dug trenches,"},{"id":"semetey-1-2013:p1412:b004:l031","ordinal":185001,"en":"And multitudes from Kangai."},{"id":"semetey-1-2013:p1412:b004:l032","ordinal":185002,"en":"They cannot match me in a contest,"},{"id":"semetey-1-2013:p1412:b004:l033","ordinal":185003,"en":"Nor defeat me in battle!"},{"id":"semetey-1-2013:p1412:b004:l034","ordinal":185004,"en":"That fire-doomed swine's"},{"id":"semetey-1-2013:p1412:b004:l035","ordinal":185005,"en":"That duck is a sharp-eyed scout;"},{"id":"semetey-1-2013:p1412:b004:l036","ordinal":185006,"en":"If Kuuördök reaches Beijing,"},{"id":"semetey-1-2013:p1412:b004:l037","ordinal":185007,"en":"It will spread the news in every direction."},{"id":"semetey-1-2013:p1412:b005:l001","ordinal":185008,"en":"Its wing is fierce and formidable,"},{"id":"semetey-1-2013:p1412:b005:l002","ordinal":185009,"en":"And it has the habit"},{"id":"semetey-1-2013:p1412:b005:l003","ordinal":185010,"en":"Of cutting down whatever it faces."},{"id":"semetey-1-2013:p1412:b005:l004","ordinal":185011,"en":"It has lords and it has a khan;"},{"id":"semetey-1-2013:p1412:b005:l005","ordinal":185012,"en":"In that great city of Beijing"},{"id":"semetey-1-2013:p1412:b005:l006","ordinal":185013,"en":"Are marvels beyond all hearing!"},{"id":"semetey-1-2013:p1412:b005:l007","ordinal":185014,"en":"If that duck catches sight of us,"},{"id":"semetey-1-2013:p1412:b005:l008","ordinal":185015,"en":"It will carry the news to Beijing."},{"id":"semetey-1-2013:p1412:b005:l009","ordinal":185016,"en":"Understand all that I have told you;"},{"id":"semetey-1-2013:p1412:b005:l010","ordinal":185017,"en":"My precious son, heed my words!"},{"id":"semetey-1-2013:p1412:b005:l011","ordinal":185018,"en":"The honored Kalcha is a great lord;"},{"id":"semetey-1-2013:p1412:b005:l012","ordinal":185019,"en":"If that infidel is roused to anger,"},{"id":"semetey-1-2013:p1412:b005:l013","ordinal":185020,"en":"He will sweep out from Kakan!"},{"id":"semetey-1-2013:p1412:b005:l014","ordinal":185021,"en":"These are no people to trust."},{"id":"semetey-1-2013:p1412:b005:l015","ordinal":185022,"en":"This Beijing before us"},{"id":"semetey-1-2013:p1412:b005:l016","ordinal":185023,"en":"Has might and has a city;"},{"id":"semetey-1-2013:p1412:b005:l017","ordinal":185024,"en":"In mighty Beijing"},{"id":"semetey-1-2013:p1412:b005:l018","ordinal":185025,"en":"Are all the fiercest forces!\""},{"id":"semetey-1-2013:p1412:b005:l019","ordinal":185026,"en":"Old Bakai said:"},{"id":"semetey-1-2013:p1412:b005:l020","ordinal":185027,"en":"\"Scout the upper side well!"},{"id":"semetey-1-2013:p1412:b005:l021","ordinal":185028,"en":"If we catch the duck,"},{"id":"semetey-1-2013:p1412:b005:l022","ordinal":185029,"en":"We shall set our trouble right;"},{"id":"semetey-1-2013:p1412:b005:l023","ordinal":185030,"en":"If we pray to the Creator,"},{"id":"semetey-1-2013:p1412:b005:l024","ordinal":185031,"en":"My young champion found late in life,"},{"id":"semetey-1-2013:p1412:b005:l025","ordinal":185032,"en":"We shall contrive to take their duck!\""},{"id":"semetey-1-2013:p1412:b005:l026","ordinal":185033,"en":"At the pass of It-Kyian,"},{"id":"semetey-1-2013:p1412:b005:l027","ordinal":185034,"en":"After Bakai spoke these words,"},{"id":"semetey-1-2013:p1412:b005:l028","ordinal":185035,"en":"They went up to the duck's watch-lake,"},{"id":"semetey-1-2013:p1412:b005:l029","ordinal":185036,"en":"To the reeds upon the lake's surface,"},{"id":"semetey-1-2013:p1412:b005:l030","ordinal":185037,"en":"Which the Chinese call Bangpang."},{"id":"semetey-1-2013:p1412:b005:l031","ordinal":185038,"en":"When they came out and looked"},{"id":"semetey-1-2013:p1412:b005:l032","ordinal":185039,"en":"At the edge of the watch-lake,"},{"id":"semetey-1-2013:p1412:b005:l033","ordinal":185040,"en":"There on watch in its prime"},{"id":"semetey-1-2013:p1412:b005:l034","ordinal":185041,"en":"Stood the fire-doomed Kuuördök,"},{"id":"semetey-1-2013:p1412:b005:l035","ordinal":185042,"en":"In its accustomed place,"},{"id":"semetey-1-2013:p1412:b005:l036","ordinal":185043,"en":"Upon a rock like a yurt;"},{"id":"semetey-1-2013:p1412:b005:l037","ordinal":185044,"en":"When he caught sight of the duck,"},{"id":"semetey-1-2013:p1413:b003:l001","ordinal":185045,"en":"Bakay came riding in haste,"},{"id":"semetey-1-2013:p1413:b003:l002","ordinal":185046,"en":"Pleading with his son Semetey:"},{"id":"semetey-1-2013:p1413:b003:l003","ordinal":185047,"en":"\"Kuuördök is a cunning swine;"},{"id":"semetey-1-2013:p1413:b003:l004","ordinal":185048,"en":"Do not cast your falcon too soon;"},{"id":"semetey-1-2013:p1413:b003:l005","ordinal":185049,"en":"Do not slaughter your old uncle Bakai"},{"id":"semetey-1-2013:p1413:b003:l006","ordinal":185050,"en":"And leave him full of regret!"},{"id":"semetey-1-2013:p1413:b003:l007","ordinal":185051,"en":"Your uncle Bakai tells you this:"},{"id":"semetey-1-2013:p1413:b003:l008","ordinal":185052,"en":"Judge the bird's distance;"},{"id":"semetey-1-2013:p1413:b003:l009","ordinal":185053,"en":"Do not ruin things, my son—heed my words."},{"id":"semetey-1-2013:p1413:b003:l010","ordinal":185054,"en":"Set the falcon's mind upon it,"},{"id":"semetey-1-2013:p1413:b003:l011","ordinal":185055,"en":"And only then cast it loose!"},{"id":"semetey-1-2013:p1413:b003:l012","ordinal":185056,"en":"Do not make me lament, son—heed my words!\""},{"id":"semetey-1-2013:p1413:b003:l013","ordinal":185057,"en":"Bakai spoke these words;"},{"id":"semetey-1-2013:p1413:b003:l014","ordinal":185058,"en":"The orphaned hero, son of the Bloodthirsty One,"},{"id":"semetey-1-2013:p1413:b003:l015","ordinal":185059,"en":"Now drew near the duck."},{"id":"semetey-1-2013:p1413:b003:l016","ordinal":185060,"en":"When he drew near the duck,"},{"id":"semetey-1-2013:p1413:b003:l017","ordinal":185061,"en":"A matchless thoroughbred,"},{"id":"semetey-1-2013:p1413:b003:l018","ordinal":185062,"en":"Its gait rolled soft and smooth,"},{"id":"semetey-1-2013:p1413:b003:l019","ordinal":185063,"en":"Its steel shoes and sharp nails"},{"id":"semetey-1-2013:p1413:b003:l020","ordinal":185064,"en":"Shining on all fours."},{"id":"semetey-1-2013:p1413:b003:l021","ordinal":185065,"en":"The matchless Narbuurul,"},{"id":"semetey-1-2013:p1413:b003:l022","ordinal":185066,"en":"A fleet thoroughbred with mighty legs,"},{"id":"semetey-1-2013:p1413:b003:l023","ordinal":185067,"en":"Mattock hooves and a broad rump,"},{"id":"semetey-1-2013:p1413:b003:l024","ordinal":185068,"en":"A thoroughbred of the spacious land."},{"id":"semetey-1-2013:p1413:b003:l025","ordinal":185069,"en":"Tossing his forelock to the sky,"},{"id":"semetey-1-2013:p1413:b003:l026","ordinal":185070,"en":"Driving his hooves into the earth,"},{"id":"semetey-1-2013:p1413:b003:l027","ordinal":185071,"en":"He moved with the glide of a sighthound,"},{"id":"semetey-1-2013:p1413:b003:l028","ordinal":185072,"en":"Wherever he passed,"},{"id":"semetey-1-2013:p1413:b003:l029","ordinal":185073,"en":"Gliding without a sound."},{"id":"semetey-1-2013:p1413:b003:l030","ordinal":185074,"en":"The splendid hero born of Manas,"},{"id":"semetey-1-2013:p1413:b003:l031","ordinal":185075,"en":"To cast at Kuuördök"},{"id":"semetey-1-2013:p1413:b003:l032","ordinal":185076,"en":"And have his fill of joy,"},{"id":"semetey-1-2013:p1413:b003:l033","ordinal":185077,"en":"Coiled the long leash;"},{"id":"semetey-1-2013:p1413:b003:l034","ordinal":185078,"en":"The noble hero loosed Akshumkar,"},{"id":"semetey-1-2013:p1413:b003:l035","ordinal":185079,"en":"Letting it go on a shortened tether,"},{"id":"semetey-1-2013:p1413:b003:l036","ordinal":185080,"en":"Stepping obliquely and drawing it close,"},{"id":"semetey-1-2013:p1413:b003:l037","ordinal":185081,"en":"Making the short tether taut."},{"id":"semetey-1-2013:p1413:b003:l038","ordinal":185082,"en":"Circling in from the side,"},{"id":"semetey-1-2013:p1413:b003:l039","ordinal":185083,"en":"Behind him, Khan Bakai"},{"id":"semetey-1-2013:p1413:b004:l001","ordinal":185084,"en":"Girded his firm waist;"},{"id":"semetey-1-2013:p1413:b004:l002","ordinal":185085,"en":"Though old, hero Bakai"},{"id":"semetey-1-2013:p1413:b004:l003","ordinal":185086,"en":"A crescent-marked golden doolbas drum,"},{"id":"semetey-1-2013:p1413:b004:l004","ordinal":185087,"en":"Striking once with a ringing blow."},{"id":"semetey-1-2013:p1413:b004:l005","ordinal":185088,"en":"When the doolbas sounded,"}]
