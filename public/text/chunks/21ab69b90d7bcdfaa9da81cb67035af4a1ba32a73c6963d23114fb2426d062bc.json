[{"id":"semetey-1-2013:p0647:b003:l027","ordinal":126465,"en":"Your poor elder Bakai"},{"id":"semetey-1-2013:p0647:b003:l028","ordinal":126466,"en":"Has the blood of sixty warriors upon him."},{"id":"semetey-1-2013:p0647:b003:l029","ordinal":126467,"en":"Your elder in his old age"},{"id":"semetey-1-2013:p0647:b003:l030","ordinal":126468,"en":"Has had his share of bloodthirstiness."},{"id":"semetey-1-2013:p0647:b003:l031","ordinal":126469,"en":"Your elder who has sheltered them"},{"id":"semetey-1-2013:p0647:b003:l032","ordinal":126470,"en":"Has a people of five hundred households."},{"id":"semetey-1-2013:p0647:b003:l033","ordinal":126471,"en":"‘Your extinguished light has truly returned,’"},{"id":"semetey-1-2013:p0647:b003:l034","ordinal":126472,"en":"To my people here,"},{"id":"semetey-1-2013:p0647:b003:l035","ordinal":126473,"en":"I have glad news to announce.”"},{"id":"semetey-1-2013:p0647:b003:l036","ordinal":126474,"en":"So saying, mighty Bakai"},{"id":"semetey-1-2013:p0647:b003:l037","ordinal":126475,"en":"Led the way toward the cliff,"},{"id":"semetey-1-2013:p0647:b003:l038","ordinal":126476,"en":"And began to trace the path."},{"id":"semetey-1-2013:p0647:b003:l039","ordinal":126477,"en":"With five hundred households in his charge,"},{"id":"semetey-1-2013:p0647:b004:l001","ordinal":126478,"en":"‘My warrior boy has come,’"},{"id":"semetey-1-2013:p0647:b004:l002","ordinal":126479,"en":"Bakai meant to make rejoicing."},{"id":"semetey-1-2013:p0647:b004:l003","ordinal":126480,"en":"Semetey was behind him;"},{"id":"semetey-1-2013:p0647:b004:l004","ordinal":126481,"en":"Mighty Bakai was in front."},{"id":"semetey-1-2013:p0647:b004:l005","ordinal":126482,"en":"Ah, that Kökcholok of his!"},{"id":"semetey-1-2013:p0647:b004:l006","ordinal":126483,"en":"The ground he trod crumbled."},{"id":"semetey-1-2013:p0647:b004:l007","ordinal":126484,"en":"Clods as big as great cauldrons"},{"id":"semetey-1-2013:p0647:b004:l008","ordinal":126485,"en":"Whistled above Bakai's head."},{"id":"semetey-1-2013:p0647:b004:l009","ordinal":126486,"en":"His Kökcholok strained,"},{"id":"semetey-1-2013:p0647:b004:l010","ordinal":126487,"en":"Plunging as though his rider had died."},{"id":"semetey-1-2013:p0647:b004:l011","ordinal":126488,"en":"The reins knotted with braided thongs"},{"id":"semetey-1-2013:p0647:b004:l012","ordinal":126489,"en":"Pulled taut in his palm."},{"id":"semetey-1-2013:p0647:b004:l013","ordinal":126490,"en":"Five hundred households under his hand,"},{"id":"semetey-1-2013:p0647:b004:l014","ordinal":126491,"en":"They passed among the people."},{"id":"semetey-1-2013:p0647:b004:l015","ordinal":126492,"en":"To Baimirza, elder of the people,"},{"id":"semetey-1-2013:p0647:b004:l016","ordinal":126493,"en":"They announced the glad news:"},{"id":"semetey-1-2013:p0647:b004:l017","ordinal":126494,"en":"“Oh, Baimirza, elder khan,"},{"id":"semetey-1-2013:p0647:b004:l018","ordinal":126495,"en":"God has granted your wish."},{"id":"semetey-1-2013:p0647:b004:l019","ordinal":126496,"en":"The only son of King Manas Khan,"},{"id":"semetey-1-2013:p0647:b004:l020","ordinal":126497,"en":"That dear one you longed for has come!"},{"id":"semetey-1-2013:p0647:b004:l021","ordinal":126498,"en":"What broke has been joined;"},{"id":"semetey-1-2013:p0647:b004:l022","ordinal":126499,"en":"What scattered has been gathered."},{"id":"semetey-1-2013:p0647:b004:l023","ordinal":126500,"en":"God has granted your wish;"},{"id":"semetey-1-2013:p0647:b004:l024","ordinal":126501,"en":"The orphan you watched for has come."},{"id":"semetey-1-2013:p0647:b004:l025","ordinal":126502,"en":"And his lord was restored to the seat of honor;"},{"id":"semetey-1-2013:p0647:b004:l026","ordinal":126503,"en":"All your flesh has been covered."},{"id":"semetey-1-2013:p0647:b004:l027","ordinal":126504,"en":"The fierce one's son has come."},{"id":"semetey-1-2013:p0647:b004:l028","ordinal":126505,"en":"My dear Baimirza,"},{"id":"semetey-1-2013:p0647:b004:l029","ordinal":126506,"en":"Those who slaughter camels, slaughter camels;"},{"id":"semetey-1-2013:p0647:b004:l030","ordinal":126507,"en":"Those who slaughter sheep, slaughter sheep."},{"id":"semetey-1-2013:p0647:b004:l031","ordinal":126508,"en":"Your plump, gray-mottled falcon—"},{"id":"semetey-1-2013:p0647:b004:l032","ordinal":126509,"en":"Look at his form, attend and know him,"},{"id":"semetey-1-2013:p0647:b004:l033","ordinal":126510,"en":"The gray hawk, the morning star left by Manas."},{"id":"semetey-1-2013:p0647:b004:l035","ordinal":126511,"en":"With five hundred households in his charge,"},{"id":"semetey-1-2013:p0647:b004:l036","ordinal":126512,"en":"What you watched for has appeared;"},{"id":"semetey-1-2013:p0647:b004:l037","ordinal":126513,"en":"Your blessing has thus been found."},{"id":"semetey-1-2013:p0647:b004:l038","ordinal":126514,"en":"To your elder who suffered anguish,"},{"id":"semetey-1-2013:p0647:b004:l039","ordinal":126515,"en":"Here has come the warrior's son!”"},{"id":"semetey-1-2013:p0648:b003:l001","ordinal":126516,"en":"When Baimirza heard this,"},{"id":"semetey-1-2013:p0648:b003:l002","ordinal":126517,"en":"It was the hour God granted his wish."},{"id":"semetey-1-2013:p0648:b003:l003","ordinal":126518,"en":"He had reached ninety-five years."},{"id":"semetey-1-2013:p0648:b003:l004","ordinal":126519,"en":"He too was an elder, a father to the people,"},{"id":"semetey-1-2013:p0648:b003:l005","ordinal":126520,"en":"A saint who had seen much."},{"id":"semetey-1-2013:p0648:b003:l006","ordinal":126521,"en":"Raising his hands, he cried aloud,"},{"id":"semetey-1-2013:p0648:b003:l007","ordinal":126522,"en":"He too cried the battle cry, ‘Manas!’"},{"id":"semetey-1-2013:p0648:b003:l008","ordinal":126523,"en":"Taking the short way along the narrow cliff,"},{"id":"semetey-1-2013:p0648:b003:l009","ordinal":126524,"en":"Leading his gray young camel for Baabedin:"},{"id":"semetey-1-2013:p0648:b003:l010","ordinal":126525,"en":"“Oh, my dear Khan Bakai,"},{"id":"semetey-1-2013:p0648:b003:l011","ordinal":126526,"en":"Turn your horse's head a moment;"},{"id":"semetey-1-2013:p0648:b003:l012","ordinal":126527,"en":"Stand there ahead a moment."},{"id":"semetey-1-2013:p0648:b003:l013","ordinal":126528,"en":"Let me speak my sorrowful words;"},{"id":"semetey-1-2013:p0648:b003:l014","ordinal":126529,"en":"My precious Bakai, listen!"},{"id":"semetey-1-2013:p0648:b003:l015","ordinal":126530,"en":"Semetey, son of Manas—"},{"id":"semetey-1-2013:p0648:b003:l016","ordinal":126531,"en":"Where is the day when he will come?"},{"id":"semetey-1-2013:p0648:b003:l017","ordinal":126532,"en":"Semetey, for wretched me—"},{"id":"semetey-1-2013:p0648:b003:l018","ordinal":126533,"en":"Where is the day when I shall see him?"},{"id":"semetey-1-2013:p0648:b003:l019","ordinal":126534,"en":"If Semetey comes, will Baimirza"},{"id":"semetey-1-2013:p0648:b003:l020","ordinal":126535,"en":"Have a day when he himself may die?"},{"id":"semetey-1-2013:p0648:b003:l021","ordinal":126536,"en":"And Semetey, for Baimirza,"},{"id":"semetey-1-2013:p0648:b003:l022","ordinal":126537,"en":"Wailing, ‘Father!’—"},{"id":"semetey-1-2013:p0648:b003:l023","ordinal":126538,"en":"Will there be a day when he buries me?"},{"id":"semetey-1-2013:p0648:b003:l024","ordinal":126539,"en":"Kanykei went away in mourning."},{"id":"semetey-1-2013:p0648:b003:l025","ordinal":126540,"en":"Semetey fled in those days."},{"id":"semetey-1-2013:p0648:b003:l026","ordinal":126541,"en":"Kanykei went away a widow;"},{"id":"semetey-1-2013:p0648:b003:l027","ordinal":126542,"en":"Semetey went to Bukhara."},{"id":"semetey-1-2013:p0648:b003:l028","ordinal":126543,"en":"It is the hour God granted our wish,"},{"id":"semetey-1-2013:p0648:b003:l029","ordinal":126544,"en":"The hour he has reached twelve years."},{"id":"semetey-1-2013:p0648:b003:l030","ordinal":126545,"en":"It's different when you want"},{"id":"semetey-1-2013:p0648:b003:l031","ordinal":126546,"en":"Where is a night like the Night of Power?"},{"id":"semetey-1-2013:p0648:b003:l032","ordinal":126547,"en":"The orphan, son of Manas—"},{"id":"semetey-1-2013:p0648:b003:l033","ordinal":126548,"en":"Where is the day I see him again?”"},{"id":"semetey-1-2013:p0648:b003:l034","ordinal":126549,"en":"So saying, groaning,"},{"id":"semetey-1-2013:p0648:b003:l035","ordinal":126550,"en":"Baimirza slaughtered his gray young camel."},{"id":"semetey-1-2013:p0648:b003:l036","ordinal":126551,"en":"While Baimirza did this,"},{"id":"semetey-1-2013:p0648:b003:l037","ordinal":126552,"en":"Birches wept, willows wept,"},{"id":"semetey-1-2013:p0648:b003:l038","ordinal":126553,"en":"Everyone who looked on wept."},{"id":"semetey-1-2013:p0648:b003:l039","ordinal":126554,"en":"The venerable elder wept;"},{"id":"semetey-1-2013:p0648:b004:l001","ordinal":126555,"en":"All those people wept."},{"id":"semetey-1-2013:p0648:b004:l002","ordinal":126556,"en":"The lion supported by the patron wept;"},{"id":"semetey-1-2013:p0648:b004:l003","ordinal":126557,"en":"The people of five hundred households wept."},{"id":"semetey-1-2013:p0648:b004:l004","ordinal":126558,"en":"For the longing in his heart,"},{"id":"semetey-1-2013:p0648:b004:l005","ordinal":126559,"en":"Nine black bulls"},{"id":"semetey-1-2013:p0648:b004:l006","ordinal":126560,"en":"He had slaughtered for the boy then."},{"id":"semetey-1-2013:p0648:b004:l007","ordinal":126561,"en":"Poor Baimirza cried aloud."},{"id":"semetey-1-2013:p0648:b004:l008","ordinal":126562,"en":"At ninety-five, the elder,"},{"id":"semetey-1-2013:p0648:b004:l009","ordinal":126563,"en":"Tossing as he wept,"},{"id":"semetey-1-2013:p0648:b004:l010","ordinal":126564,"en":"Pleaded with his orphan Semetey."},{"id":"semetey-1-2013:p0648:b004:l011","ordinal":126565,"en":"Left by mountain-like, fierce Manas,"},{"id":"semetey-1-2013:p0648:b004:l012","ordinal":126566,"en":"Semetey, left to fall into ruin;"},{"id":"semetey-1-2013:p0648:b004:l013","ordinal":126567,"en":"Left by ridge-like, fierce Manas,"},{"id":"semetey-1-2013:p0648:b004:l014","ordinal":126568,"en":"Semetey, left as a gift."},{"id":"semetey-1-2013:p0648:b004:l015","ordinal":126569,"en":"“My plump gray-mottled falcon,"},{"id":"semetey-1-2013:p0648:b004:l016","ordinal":126570,"en":"Semetey, my morning star, who has come and made me weep,"},{"id":"semetey-1-2013:p0648:b004:l017","ordinal":126571,"en":"My marketplace left by my khan,"},{"id":"semetey-1-2013:p0648:b004:l018","ordinal":126572,"en":"Who brightens my brow,"},{"id":"semetey-1-2013:p0648:b004:l019","ordinal":126573,"en":"Who calms my lamenting heart,"},{"id":"semetey-1-2013:p0648:b004:l020","ordinal":126574,"en":"Who lifts my lowered brow,"},{"id":"semetey-1-2013:p0648:b004:l021","ordinal":126575,"en":"My delight left by my King Manas,"},{"id":"semetey-1-2013:p0648:b004:l022","ordinal":126576,"en":"When I look upon you, my belly is full,"},{"id":"semetey-1-2013:p0648:b004:l023","ordinal":126577,"en":"My mirror left by King Manas,”"},{"id":"semetey-1-2013:p0648:b004:l024","ordinal":126578,"en":"So spoke Baimirza."},{"id":"semetey-1-2013:p0648:b004:l025","ordinal":126579,"en":"With Baimirza first, the elders wept;"},{"id":"semetey-1-2013:p0648:b004:l026","ordinal":126580,"en":"All the people who had come wept."},{"id":"semetey-1-2013:p0648:b004:l027","ordinal":126581,"en":"The wandering orphan was found;"},{"id":"semetey-1-2013:p0648:b004:l028","ordinal":126582,"en":"Thus their shame was covered."},{"id":"semetey-1-2013:p0648:b004:l029","ordinal":126583,"en":"Many of the people slaughtered mares;"},{"id":"semetey-1-2013:p0648:b004:l030","ordinal":126584,"en":"Many of the people slaughtered camels."},{"id":"semetey-1-2013:p0648:b004:l031","ordinal":126585,"en":"There the people beheld him with joy;"},{"id":"semetey-1-2013:p0648:b004:l032","ordinal":126586,"en":"There dear Semetey had come."},{"id":"semetey-1-2013:p0648:b004:l033","ordinal":126587,"en":"Then Bakai dashed away."},{"id":"semetey-1-2013:p0648:b004:l034","ordinal":126588,"en":"His senior wife Körpöyan,"},{"id":"semetey-1-2013:p0648:b004:l035","ordinal":126589,"en":"His only son Baitailak—"},{"id":"semetey-1-2013:p0648:b004:l036","ordinal":126590,"en":"Hastening, Bakai, warrior sultan,"},{"id":"semetey-1-2013:p0648:b004:l037","ordinal":126591,"en":"Spurred toward them."},{"id":"semetey-1-2013:p0648:b004:l038","ordinal":126592,"en":"Again Bakai cried aloud,"},{"id":"semetey-1-2013:p0648:b004:l039","ordinal":126593,"en":"Calling out the glad news,"},{"id":"semetey-1-2013:p0649:b003:l001","ordinal":126594,"en":"Hastening, crying, “Baabedin!” he spurred on."},{"id":"semetey-1-2013:p0649:b003:l003","ordinal":126595,"en":"“My father is hurrying out toward us!”"},{"id":"semetey-1-2013:p0649:b003:l004","ordinal":126596,"en":"Bakai's wretched son Baitailak—"},{"id":"semetey-1-2013:p0649:b003:l005","ordinal":126597,"en":"God struck him now."},{"id":"semetey-1-2013:p0649:b003:l006","ordinal":126598,"en":"Standing on a hill, Baitailak"},{"id":"semetey-1-2013:p0649:b003:l007","ordinal":126599,"en":"Thought an unthought-of thought:"},{"id":"semetey-1-2013:p0649:b003:l008","ordinal":126600,"en":"“There must be a deep pit dug for us,"},{"id":"semetey-1-2013:p0649:b003:l009","ordinal":126601,"en":"There must be misery set to boil."},{"id":"semetey-1-2013:p0649:b003:l010","ordinal":126602,"en":"Up Jar-Kiya of Jangirik,"},{"id":"semetey-1-2013:p0649:b003:l011","ordinal":126603,"en":"Climbing toward us,"},{"id":"semetey-1-2013:p0649:b003:l012","ordinal":126604,"en":"There must be a mighty host of ten thousand."},{"id":"semetey-1-2013:p0649:b003:l013","ordinal":126605,"en":"The Chinese have risen from Kakan;"},{"id":"semetey-1-2013:p0649:b003:l014","ordinal":126606,"en":"The God who strikes has struck us, it seems."},{"id":"semetey-1-2013:p0649:b003:l015","ordinal":126607,"en":"They have beaten my father,"},{"id":"semetey-1-2013:p0649:b003:l016","ordinal":126608,"en":"And slaughtered the people along the road!"},{"id":"semetey-1-2013:p0649:b003:l017","ordinal":126609,"en":"My father, poor Bakai—"},{"id":"semetey-1-2013:p0649:b003:l018","ordinal":126610,"en":"To turn water into his orchards,"},{"id":"semetey-1-2013:p0649:b003:l019","ordinal":126611,"en":"To make them into gardens,"},{"id":"semetey-1-2013:p0649:b003:l020","ordinal":126612,"en":"To drag him along the road,"},{"id":"semetey-1-2013:p0649:b003:l021","ordinal":126613,"en":"To have the dogs tear him apart,"},{"id":"semetey-1-2013:p0649:b003:l022","ordinal":126614,"en":"The enemy must have pursued him,"},{"id":"semetey-1-2013:p0649:b003:l023","ordinal":126615,"en":"God must have struck us thus!"},{"id":"semetey-1-2013:p0649:b003:l024","ordinal":126616,"en":"Helpless, crying out,"},{"id":"semetey-1-2013:p0649:b003:l025","ordinal":126617,"en":"Calling, ‘Baitailak!’"},{"id":"semetey-1-2013:p0649:b003:l026","ordinal":126618,"en":"Hurrying, stumbling in alarm,"},{"id":"semetey-1-2013:p0649:b003:l027","ordinal":126619,"en":"Has my father fled?"},{"id":"semetey-1-2013:p0649:b003:l028","ordinal":126620,"en":"Relentlessly upon his trail,"},{"id":"semetey-1-2013:p0649:b003:l029","ordinal":126621,"en":"Have they pursued him to exhaustion?"},{"id":"semetey-1-2013:p0649:b003:l030","ordinal":126622,"en":"They must have fallen upon us,"},{"id":"semetey-1-2013:p0649:b003:l031","ordinal":126623,"en":"Scattered all four kinds of livestock."},{"id":"semetey-1-2013:p0649:b003:l032","ordinal":126624,"en":"To seize my father,"},{"id":"semetey-1-2013:p0649:b003:l033","ordinal":126625,"en":"Have they come close behind him?"},{"id":"semetey-1-2013:p0649:b003:l034","ordinal":126626,"en":"As though to slaughter him as a sacrifice,"},{"id":"semetey-1-2013:p0649:b003:l035","ordinal":126627,"en":"Has God struck him down?"},{"id":"semetey-1-2013:p0649:b003:l036","ordinal":126628,"en":"Damn it, my father Manas"},{"id":"semetey-1-2013:p0649:b003:l037","ordinal":126629,"en":"Has a tale that never ends."},{"id":"semetey-1-2013:p0649:b003:l038","ordinal":126630,"en":"Everywhere, to finish him,"},{"id":"semetey-1-2013:p0649:b003:l039","ordinal":126631,"en":"Ruined peoples bear a grudge."},{"id":"semetey-1-2013:p0649:b005:l001","ordinal":126632,"en":"How can I know this calamity?"},{"id":"semetey-1-2013:p0649:b005:l002","ordinal":126633,"en":"These many horses of my father, Khan Bakai—"},{"id":"semetey-1-2013:p0649:b005:l003","ordinal":126634,"en":"Better for wretched me"},{"id":"semetey-1-2013:p0649:b005:l004","ordinal":126635,"en":"To drive them toward the foothills.”"},{"id":"semetey-1-2013:p0649:b005:l005","ordinal":126636,"en":"So saying, Baitailak,"},{"id":"semetey-1-2013:p0649:b005:l006","ordinal":126637,"en":"Hurrying, stumbling in alarm,"},{"id":"semetey-1-2013:p0649:b005:l007","ordinal":126638,"en":"Shouted out the news."},{"id":"semetey-1-2013:p0649:b005:l008","ordinal":126639,"en":"To all the wretched people,"},{"id":"semetey-1-2013:p0649:b005:l009","ordinal":126640,"en":"He shouted, “Run!”"},{"id":"semetey-1-2013:p0649:b005:l010","ordinal":126641,"en":"A horse-catching pole with a black loop,"},{"id":"semetey-1-2013:p0649:b005:l011","ordinal":126642,"en":"He grasped it, spitting on his hands."},{"id":"semetey-1-2013:p0649:b005:l012","ordinal":126643,"en":"Furious and glowering,"},{"id":"semetey-1-2013:p0649:b005:l013","ordinal":126644,"en":"The great, clattering herd of horses"},{"id":"semetey-1-2013:p0649:b005:l014","ordinal":126645,"en":"He set about driving off in one rush."},{"id":"semetey-1-2013:p0649:b005:l015","ordinal":126646,"en":"Fat stallions and fat mares,"},{"id":"semetey-1-2013:p0649:b005:l016","ordinal":126647,"en":"He chased and drove in a flurry."},{"id":"semetey-1-2013:p0649:b005:l017","ordinal":126648,"en":"Oh, that wretched Baitailak,"},{"id":"semetey-1-2013:p0649:b005:l018","ordinal":126649,"en":"Crying the battle cry, ‘Bakai!’"},{"id":"semetey-1-2013:p0649:b005:l019","ordinal":126650,"en":"The fat beasts that would not move,"},{"id":"semetey-1-2013:p0649:b005:l020","ordinal":126651,"en":"He drove them all off in a flurry."},{"id":"semetey-1-2013:p0649:b005:l021","ordinal":126652,"en":"Behind him, mighty Bakai"},{"id":"semetey-1-2013:p0649:b005:l022","ordinal":126653,"en":"Cried, “Baitailak!”"},{"id":"semetey-1-2013:p0649:b005:l023","ordinal":126654,"en":"Baitailak, hurrying in alarm,"},{"id":"semetey-1-2013:p0649:b005:l024","ordinal":126655,"en":"Drove them off all the harder."},{"id":"semetey-1-2013:p0649:b005:l025","ordinal":126656,"en":"Your elder, Lord Bakai,"},{"id":"semetey-1-2013:p0649:b005:l026","ordinal":126657,"en":"Made his complaint to God:"},{"id":"semetey-1-2013:p0649:b005:l027","ordinal":126658,"en":"“Better that I should die,"},{"id":"semetey-1-2013:p0649:b005:l028","ordinal":126659,"en":"And see the face of Judgment!"},{"id":"semetey-1-2013:p0649:b005:l029","ordinal":126660,"en":"Better that I should sink without begetting,"},{"id":"semetey-1-2013:p0649:b005:l030","ordinal":126661,"en":"Than see a worthless son—"},{"id":"semetey-1-2013:p0649:b005:l031","ordinal":126662,"en":"Better to pass away childless!"},{"id":"semetey-1-2013:p0649:b005:l032","ordinal":126663,"en":"Like barren ground where no grass grows,"},{"id":"semetey-1-2013:p0649:b005:l033","ordinal":126664,"en":"Better to be left without a field,"},{"id":"semetey-1-2013:p0649:b005:l034","ordinal":126665,"en":"Without seeing offspring, wretched head,"},{"id":"semetey-1-2013:p0649:b005:l035","ordinal":126666,"en":"Better that I should remain childless!"},{"id":"semetey-1-2013:p0649:b005:l036","ordinal":126667,"en":"When I threw the whole world into turmoil,"},{"id":"semetey-1-2013:p0649:b005:l037","ordinal":126668,"en":"And held it besieged,"},{"id":"semetey-1-2013:p0649:b005:l038","ordinal":126669,"en":"When I raised a clamor through the six reaches,"},{"id":"semetey-1-2013:p0649:b005:l039","ordinal":126670,"en":"And struck them down,"},{"id":"semetey-1-2013:p0650:b003:l001","ordinal":126671,"en":"Why did I not die then?"},{"id":"semetey-1-2013:p0650:b003:l002","ordinal":126672,"en":"Seeing nothing at all,"},{"id":"semetey-1-2013:p0650:b003:l003","ordinal":126673,"en":"Why was I not barren?"},{"id":"semetey-1-2013:p0650:b003:l004","ordinal":126674,"en":"Rather than see a worthless son,"},{"id":"semetey-1-2013:p0650:b003:l005","ordinal":126675,"en":"Why did I not remain childless?"},{"id":"semetey-1-2013:p0650:b003:l006","ordinal":126676,"en":"Alas, Tailak, stop a moment!"},{"id":"semetey-1-2013:p0650:b003:l007","ordinal":126677,"en":"Woe, Tailak, stop a moment!"},{"id":"semetey-1-2013:p0650:b003:l008","ordinal":126678,"en":"Worthless Tailak, stop a moment!"},{"id":"semetey-1-2013:p0650:b003:l009","ordinal":126679,"en":"Swine Tailak, stop a moment!"},{"id":"semetey-1-2013:p0650:b003:l010","ordinal":126680,"en":"Have you ruined my wealth?"},{"id":"semetey-1-2013:p0650:b003:l011","ordinal":126681,"en":"You have run my horses to exhaustion."},{"id":"semetey-1-2013:p0650:b003:l012","ordinal":126682,"en":"You have badly drained my strength;"},{"id":"semetey-1-2013:p0650:b003:l013","ordinal":126683,"en":"You have run my livestock to exhaustion."},{"id":"semetey-1-2013:p0650:b003:l014","ordinal":126684,"en":"Earth-bound Tailak, go into the earth!"},{"id":"semetey-1-2013:p0650:b003:l015","ordinal":126685,"en":"Wretched Tailak, taken by God!"},{"id":"semetey-1-2013:p0650:b003:l016","ordinal":126686,"en":"The horseshoe hit the ground,"},{"id":"semetey-1-2013:p0650:b003:l017","ordinal":126687,"en":"Enter a grave before it is dug!"},{"id":"semetey-1-2013:p0650:b003:l018","ordinal":126688,"en":"Alas, was Manas a lion?"},{"id":"semetey-1-2013:p0650:b003:l019","ordinal":126689,"en":"Was Manas more of a warrior than I?"},{"id":"semetey-1-2013:p0650:b003:l020","ordinal":126690,"en":"Kara-Shaar and Kambil—"},{"id":"semetey-1-2013:p0650:b003:l021","ordinal":126691,"en":"This is the hand that besieged them!"},{"id":"semetey-1-2013:p0650:b003:l022","ordinal":126692,"en":"Reducing the six reaches to ruin,"},{"id":"semetey-1-2013:p0650:b003:l023","ordinal":126693,"en":"This is the hand that struck them!"},{"id":"semetey-1-2013:p0650:b003:l024","ordinal":126694,"en":"Upon the face of the earth, turmoil—"},{"id":"semetey-1-2013:p0650:b003:l025","ordinal":126695,"en":"I was Bakai who brought it."},{"id":"semetey-1-2013:p0650:b003:l026","ordinal":126696,"en":"Smashing every place I reached,"},{"id":"semetey-1-2013:p0650:b003:l027","ordinal":126697,"en":"I was Bakai who conquered it."},{"id":"semetey-1-2013:p0650:b003:l028","ordinal":126698,"en":"Who did not jauntily wear"},{"id":"semetey-1-2013:p0650:b003:l029","ordinal":126699,"en":"I was Bakai who wore it."},{"id":"semetey-1-2013:p0650:b003:l030","ordinal":126700,"en":"Crushing many Chinese,"},{"id":"semetey-1-2013:p0650:b003:l031","ordinal":126701,"en":"I was Bakai who drove them off."},{"id":"semetey-1-2013:p0650:b003:l032","ordinal":126702,"en":"Pinewood spear and cleaving steel,"},{"id":"semetey-1-2013:p0650:b003:l033","ordinal":126703,"en":"I was Bakai who bound it on."},{"id":"semetey-1-2013:p0650:b003:l034","ordinal":126704,"en":"Looming like Opol Mountain,"},{"id":"semetey-1-2013:p0650:b003:l035","ordinal":126705,"en":"I was Bakai who shone."},{"id":"semetey-1-2013:p0650:b003:l036","ordinal":126706,"en":"Saintly Sultan Manas's"},{"id":"semetey-1-2013:p0650:b003:l037","ordinal":126707,"en":"Red banner with a golden crescent,"},{"id":"semetey-1-2013:p0650:b003:l038","ordinal":126708,"en":"I was Bakai who held it."},{"id":"semetey-1-2013:p0650:b003:l039","ordinal":126709,"en":"Letting no enemy escape,"},{"id":"semetey-1-2013:p0650:b004:l001","ordinal":126710,"en":"I was Bakai who slew them."},{"id":"semetey-1-2013:p0650:b004:l002","ordinal":126711,"en":"Alas, was Manas a warrior?"},{"id":"semetey-1-2013:p0650:b004:l003","ordinal":126712,"en":"Alas, was my wretched life worth less than Manas's?"},{"id":"semetey-1-2013:p0650:b004:l004","ordinal":126713,"en":"Look at Manas's son,"},{"id":"semetey-1-2013:p0650:b004:l005","ordinal":126714,"en":"See how he comes!"},{"id":"semetey-1-2013:p0650:b004:l006","ordinal":126715,"en":"But if you look at my son,"},{"id":"semetey-1-2013:p0650:b004:l007","ordinal":126716,"en":"Always making trouble,"},{"id":"semetey-1-2013:p0650:b004:l008","ordinal":126717,"en":"He is driving my horses away."},{"id":"semetey-1-2013:p0650:b004:l009","ordinal":126718,"en":"You have dug my pit deep,"},{"id":"semetey-1-2013:p0650:b004:l010","ordinal":126719,"en":"Driving my horses off, beating them,"},{"id":"semetey-1-2013:p0650:b004:l011","ordinal":126720,"en":"You have made my misery boil."}]
