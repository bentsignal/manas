[{"id":"manas-2010:p0542:b001:l030","ordinal":24577,"en":"Before our eyes we have lost you."},{"id":"manas-2010:p0542:b001:l031","ordinal":24578,"en":"The fostered bird flew to its kind;"},{"id":"manas-2010:p0542:b001:l032","ordinal":24579,"en":"The wanderer went to his land."},{"id":"manas-2010:p0542:b001:l033","ordinal":24580,"en":"The harrier flew to its kind;"},{"id":"manas-2010:p0542:b001:l034","ordinal":24581,"en":"You were an adopted member at first,"},{"id":"manas-2010:p0542:b001:l035","ordinal":24582,"en":"Now Akbaltay has gone to his land."},{"id":"manas-2010:p0542:b001:l036","ordinal":24583,"en":"When you reach your village, Akbaltay,"},{"id":"manas-2010:p0542:b001:l037","ordinal":24584,"en":"Keep gathering to talk;"},{"id":"manas-2010:p0542:b001:l038","ordinal":24585,"en":"Of gray-maned lion Manas,"},{"id":"manas-2010:p0542:b001:l039","ordinal":24586,"en":"Keep asking how he fares!"},{"id":"manas-2010:p0542:b001:l040","ordinal":24587,"en":"If he climbs, be his prop,"},{"id":"manas-2010:p0542:b001:l041","ordinal":24588,"en":"Akbaltay, companion unto death;"},{"id":"manas-2010:p0542:b001:l042","ordinal":24589,"en":"If he descends, be his support,"},{"id":"manas-2010:p0543:b001:l001","ordinal":24590,"en":"If we go to the Chinese empire, be our support;"},{"id":"manas-2010:p0543:b001:l002","ordinal":24591,"en":"If we set out toward Beijing,"},{"id":"manas-2010:p0543:b001:l003","ordinal":24592,"en":"Champion Baltay, be our support!”"},{"id":"manas-2010:p0543:b001:l004","ordinal":24593,"en":"Akbaltay and wealthy Jakyp"},{"id":"manas-2010:p0543:b001:l005","ordinal":24594,"en":"Embraced in farewell,"},{"id":"manas-2010:p0543:b001:l006","ordinal":24595,"en":"Sobbing and weeping together,"},{"id":"manas-2010:p0543:b001:l007","ordinal":24596,"en":"Kissing one another on the neck."},{"id":"manas-2010:p0543:b001:l008","ordinal":24597,"en":"Taking Kutubiy as a gift,"},{"id":"manas-2010:p0543:b001:l009","ordinal":24598,"en":"Akbaltay went to his people;"},{"id":"manas-2010:p0543:b001:l010","ordinal":24599,"en":"Khan Koshoy went to his land."},{"id":"manas-2010:p0543:b001:l011","ordinal":24600,"en":"Invoking God in their words,"},{"id":"manas-2010:p0543:b001:l012","ordinal":24601,"en":"Swearing an oath upon their lives,"},{"id":"manas-2010:p0543:b001:l013","ordinal":24602,"en":"Making their promise firm,"},{"id":"manas-2010:p0543:b001:l014","ordinal":24603,"en":"Chewing white wheat flour together,"},{"id":"manas-2010:p0543:b001:l015","ordinal":24604,"en":"Holding the holy Quran,"},{"id":"manas-2010:p0543:b001:l016","ordinal":24605,"en":"Showing their gray-maned valor,"},{"id":"manas-2010:p0543:b001:l017","ordinal":24606,"en":"When they came to the broad valley,"},{"id":"manas-2010:p0543:b001:l018","ordinal":24607,"en":"The three khans' peoples parted."},{"id":"manas-2010:p0543:b001:l019","ordinal":24608,"en":"The forty Kyrgyz households who remained"},{"id":"manas-2010:p0543:b001:l020","ordinal":24609,"en":"Migrated toward Talas,"},{"id":"manas-2010:p0543:b001:l021","ordinal":24610,"en":"Taking then as their support"},{"id":"manas-2010:p0543:b001:l022","ordinal":24611,"en":"Jakyp's only son Manas."},{"id":"manas-2010:p0543:b001:l023","ordinal":24612,"en":"They migrated along Sary-Özön,"},{"id":"manas-2010:p0543:b001:l024","ordinal":24613,"en":"Skirting the snowy mountains."},{"id":"manas-2010:p0543:b001:l025","ordinal":24614,"en":"Gray-maned warrior Manas rode majestically,"},{"id":"manas-2010:p0543:b001:l026","ordinal":24615,"en":"Sweeping along at his horse's rush,"},{"id":"manas-2010:p0543:b001:l027","ordinal":24616,"en":"Traveling down Sary-Özön."},{"id":"manas-2010:p0543:b001:l028","ordinal":24617,"en":"When Khan Manas dug its heavy soil"},{"id":"manas-2010:p0543:b001:l029","ordinal":24618,"en":"To an arm's depth,"},{"id":"manas-2010:p0543:b001:l030","ordinal":24619,"en":"There was gold there."},{"id":"manas-2010:p0543:b001:l031","ordinal":24620,"en":"Along this valley,"},{"id":"manas-2010:p0543:b001:l032","ordinal":24621,"en":"Those who dwelt there"},{"id":"manas-2010:p0543:b001:l033","ordinal":24622,"en":"Were a people never free of conflict."},{"id":"manas-2010:p0543:b001:l034","ordinal":24623,"en":"If enemies came to face them,"},{"id":"manas-2010:p0543:b001:l035","ordinal":24624,"en":"If an adversary rose ready to fight,"},{"id":"manas-2010:p0543:b001:l036","ordinal":24625,"en":"Unwary, these people would be slaughtered;"},{"id":"manas-2010:p0543:b001:l037","ordinal":24626,"en":"It was a land where they would suffer hardship."},{"id":"manas-2010:p0543:b001:l038","ordinal":24627,"en":"There was no ridge to climb for a lookout;"},{"id":"manas-2010:p0543:b001:l039","ordinal":24628,"en":"If a clash came suddenly,"},{"id":"manas-2010:p0543:b001:l040","ordinal":24629,"en":"There was nowhere to slip away."},{"id":"manas-2010:p0543:b001:l041","ordinal":24630,"en":"Manas did not like this,"},{"id":"manas-2010:p0543:b001:l042","ordinal":24631,"en":"And now kept migrating along it."},{"id":"manas-2010:p0544:b001:l001","ordinal":24632,"en":"Looking, the eye could not take it in;"},{"id":"manas-2010:p0544:b001:l002","ordinal":24633,"en":"Wealthy Jakyp's countless cattle,"},{"id":"manas-2010:p0544:b001:l003","ordinal":24634,"en":"Which were his could not be known."},{"id":"manas-2010:p0544:b001:l004","ordinal":24635,"en":"Staring, the eye could not take it in;"},{"id":"manas-2010:p0544:b001:l005","ordinal":24636,"en":"The forty households' plundered livestock,"},{"id":"manas-2010:p0544:b001:l006","ordinal":24637,"en":"Their shares could not be distinguished."},{"id":"manas-2010:p0544:b001:l007","ordinal":24638,"en":"Yesterday, when Manas became Manas,"},{"id":"manas-2010:p0544:b001:l008","ordinal":24639,"en":"When Manas mounted a horse,"},{"id":"manas-2010:p0544:b001:l009","ordinal":24640,"en":"Growing to youth, becoming a warrior,"},{"id":"manas-2010:p0544:b001:l010","ordinal":24641,"en":"Becoming the equal of warriors' sons,"},{"id":"manas-2010:p0544:b001:l011","ordinal":24642,"en":"While dwelling in broad Altai,"},{"id":"manas-2010:p0544:b001:l012","ordinal":24643,"en":"Upon the Black Kalmyks and Manchus"},{"id":"manas-2010:p0544:b001:l013","ordinal":24644,"en":"He had inflicted much slaughter."},{"id":"manas-2010:p0544:b001:l014","ordinal":24645,"en":"Their many long-legged livestock,"},{"id":"manas-2010:p0544:b001:l015","ordinal":24646,"en":"He had raided and taken them all."},{"id":"manas-2010:p0544:b001:l016","ordinal":24647,"en":"Through this, the forty households"},{"id":"manas-2010:p0544:b001:l017","ordinal":24648,"en":"Had become firmly rich."},{"id":"manas-2010:p0544:b001:l018","ordinal":24649,"en":"The far side of the many livestock"},{"id":"manas-2010:p0544:b001:l019","ordinal":24650,"en":"Lay on the slopes of Ala-Too;"},{"id":"manas-2010:p0544:b001:l020","ordinal":24651,"en":"The lower side of the many livestock"},{"id":"manas-2010:p0544:b001:l021","ordinal":24652,"en":"Lay at the edge of It-Ölbös desert."},{"id":"manas-2010:p0544:b001:l022","ordinal":24653,"en":"Their middle hollowed out;"},{"id":"manas-2010:p0544:b001:l023","ordinal":24654,"en":"Some of them frolicked,"},{"id":"manas-2010:p0544:b001:l024","ordinal":24655,"en":"Stumbled, and were slaughtered."},{"id":"manas-2010:p0544:b001:l025","ordinal":24656,"en":"On the flesh of dead livestock,"},{"id":"manas-2010:p0544:b001:l026","ordinal":24657,"en":"Wolves and foxes fed their fill."},{"id":"manas-2010:p0544:b001:l027","ordinal":24658,"en":"The heroes thronged in delight,"},{"id":"manas-2010:p0544:b001:l028","ordinal":24659,"en":"Migrating safely, swaying along."},{"id":"manas-2010:p0544:b001:l029","ordinal":24660,"en":"Giving their unity to Manas,"},{"id":"manas-2010:p0544:b001:l030","ordinal":24661,"en":"Those left after the dead"},{"id":"manas-2010:p0544:b001:l031","ordinal":24662,"en":"Reached Talas safely."},{"id":"manas-2010:p0544:b001:l032","ordinal":24663,"en":"Tamarisk-covered Keng-Kol, broad Talas,"},{"id":"manas-2010:p0544:b001:l033","ordinal":24664,"en":"Lay luxuriantly spread."},{"id":"manas-2010:p0544:b001:l034","ordinal":24665,"en":"Would not those who dwelt there thrive?"},{"id":"manas-2010:p0544:b001:l035","ordinal":24666,"en":"Was it not the finest of lands!"},{"id":"manas-2010:p0544:b001:l036","ordinal":24667,"en":"When they looked across its plains,"},{"id":"manas-2010:p0544:b001:l037","ordinal":24668,"en":"There were woods and willows;"},{"id":"manas-2010:p0544:b001:l038","ordinal":24669,"en":"Within those woods,"},{"id":"manas-2010:p0544:b001:l039","ordinal":24670,"en":"Every living creature was there."},{"id":"manas-2010:p0544:b001:l040","ordinal":24671,"en":"Its cow parsley was thick as a forearm;"},{"id":"manas-2010:p0544:b001:l041","ordinal":24672,"en":"Its deer there"},{"id":"manas-2010:p0544:b001:l042","ordinal":24673,"en":"Were like pale, white-blazed cows!"},{"id":"manas-2010:p0545:b001:l001","ordinal":24674,"en":"Its lizards were like snakes;"},{"id":"manas-2010:p0545:b001:l002","ordinal":24675,"en":"Its frolicking wild asses"},{"id":"manas-2010:p0545:b001:l003","ordinal":24676,"en":"Were like plump, fat two-year-old colts."},{"id":"manas-2010:p0545:b001:l004","ordinal":24677,"en":"Its snakes were like ropes."},{"id":"manas-2010:p0545:b001:l005","ordinal":24678,"en":"Allah Most High had made it,"},{"id":"manas-2010:p0545:b001:l006","ordinal":24679,"en":"Creating land of every kind."},{"id":"manas-2010:p0545:b001:l007","ordinal":24680,"en":"Its leaves were like hides,"},{"id":"manas-2010:p0545:b001:l008","ordinal":24681,"en":"Its black spiders were thumb-sized."},{"id":"manas-2010:p0545:b001:l009","ordinal":24682,"en":"If you looked at its little birds,"},{"id":"manas-2010:p0545:b001:l010","ordinal":24683,"en":"They were like the snowcocks of Altai."},{"id":"manas-2010:p0545:b001:l011","ordinal":24684,"en":"Its twigs were like plane trees;"},{"id":"manas-2010:p0545:b001:l012","ordinal":24685,"en":"Its plane trees were like towers."},{"id":"manas-2010:p0545:b001:l013","ordinal":24686,"en":"Tamarisk-covered Keng-Kol, broad Talas,"},{"id":"manas-2010:p0545:b001:l014","ordinal":24687,"en":"Its land was wonderful in every way!"},{"id":"manas-2010:p0545:b001:l015","ordinal":24688,"en":"Set apart from the little valley,"},{"id":"manas-2010:p0545:b001:l016","ordinal":24689,"en":"Ah, dear broad Talas,"},{"id":"manas-2010:p0545:b001:l017","ordinal":24690,"en":"It seemed finer than paradise!"},{"id":"manas-2010:p0545:b001:l018","ordinal":24691,"en":"When he looked around it,"},{"id":"manas-2010:p0545:b001:l019","ordinal":24692,"en":"The encircling mountains were a fortress."},{"id":"manas-2010:p0545:b001:l020","ordinal":24693,"en":"Of lands heard of and seen,"},{"id":"manas-2010:p0545:b001:l021","ordinal":24694,"en":"It was firmer than those he had seen."},{"id":"manas-2010:p0545:b001:l022","ordinal":24695,"en":"What my gray-maned elder Koshoy"},{"id":"manas-2010:p0545:b001:l023","ordinal":24696,"en":"Had said was fitting!"},{"id":"manas-2010:p0545:b001:l024","ordinal":24697,"en":"When he looked this way,"},{"id":"manas-2010:p0545:b001:l025","ordinal":24698,"en":"There was ridge upon ridge, barriers;"},{"id":"manas-2010:p0545:b001:l026","ordinal":24699,"en":"It was a land of rolling hills."},{"id":"manas-2010:p0545:b001:l027","ordinal":24700,"en":"From its hills and uplands,"},{"id":"manas-2010:p0545:b001:l028","ordinal":24701,"en":"Wild sheep poured down grazing."},{"id":"manas-2010:p0545:b001:l029","ordinal":24702,"en":"Looking where they poured down,"},{"id":"manas-2010:p0545:b001:l030","ordinal":24703,"en":"The hillside grass grew sparse."},{"id":"manas-2010:p0545:b001:l031","ordinal":24704,"en":"From its rugged mountains,"},{"id":"manas-2010:p0545:b001:l032","ordinal":24705,"en":"Its deer poured down with a ‘Shoo!’"},{"id":"manas-2010:p0545:b001:l033","ordinal":24706,"en":"Looking at the rough ground,"},{"id":"manas-2010:p0545:b001:l034","ordinal":24707,"en":"The grass on the rough ground grew sparse."},{"id":"manas-2010:p0545:b001:l035","ordinal":24708,"en":"When he looked this way,"},{"id":"manas-2010:p0545:b001:l036","ordinal":24709,"en":"There were the foothills of Üch-Koshoy."},{"id":"manas-2010:p0545:b001:l037","ordinal":24710,"en":"Would those who dwelt here"},{"id":"manas-2010:p0545:b001:l038","ordinal":24711,"en":"Ever have an unfulfilled wish?"},{"id":"manas-2010:p0545:b001:l039","ordinal":24712,"en":"When he looked across,"},{"id":"manas-2010:p0545:b001:l040","ordinal":24713,"en":"There were Kara-Buura and Chatkal."},{"id":"manas-2010:p0545:b001:l041","ordinal":24714,"en":"Ah, dear broad Talas,"},{"id":"manas-2010:p0545:b001:l042","ordinal":24715,"en":"Was it not the finest of lands,"},{"id":"manas-2010:p0546:b001:l001","ordinal":24716,"en":"Would not those dwelling there find peace!"},{"id":"manas-2010:p0546:b001:l002","ordinal":24717,"en":"With the great peoples drawn to it,"},{"id":"manas-2010:p0546:b001:l003","ordinal":24718,"en":"Was it a land one would not settle?"},{"id":"manas-2010:p0546:b001:l004","ordinal":24719,"en":"Kumys by day, girls by night—"},{"id":"manas-2010:p0546:b001:l005","ordinal":24720,"en":"Was it a place without such things!"},{"id":"manas-2010:p0546:b001:l006","ordinal":24721,"en":"Riding wild asses, flying hunting birds,"},{"id":"manas-2010:p0546:b001:l007","ordinal":24722,"en":"Was it a land one would not roam!"},{"id":"manas-2010:p0546:b001:l008","ordinal":24723,"en":"Casting horn pieces, shooting at the ordo,"},{"id":"manas-2010:p0546:b001:l009","ordinal":24724,"en":"Was it a land one would not play in!"},{"id":"manas-2010:p0546:b001:l010","ordinal":24725,"en":"Into delights that broke like dawn,"},{"id":"manas-2010:p0546:b001:l011","ordinal":24726,"en":"Was any soul unable to plunge?"},{"id":"manas-2010:p0546:b001:l012","ordinal":24727,"en":"For brave men to rest on their sides,"},{"id":"manas-2010:p0546:b001:l013","ordinal":24728,"en":"Was it a land they could not lie in!"},{"id":"manas-2010:p0546:b001:l014","ordinal":24729,"en":"If bored, they could shoot roe deer;"},{"id":"manas-2010:p0546:b001:l015","ordinal":24730,"en":"If not bored, in Talas"},{"id":"manas-2010:p0546:b001:l016","ordinal":24731,"en":"They could play at ease and rest."},{"id":"manas-2010:p0546:b001:l017","ordinal":24732,"en":"Its fescue and its wormwood—"},{"id":"manas-2010:p0546:b001:l018","ordinal":24733,"en":"Their like was hard to find."},{"id":"manas-2010:p0546:b001:l019","ordinal":24734,"en":"Kicking at one-legged games, in delight,"},{"id":"manas-2010:p0546:b001:l020","ordinal":24735,"en":"Was it a land one could not revel in?"},{"id":"manas-2010:p0546:b001:l021","ordinal":24736,"en":"Keeping a court, gathering people,"},{"id":"manas-2010:p0546:b001:l022","ordinal":24737,"en":"Was it a land one would not dwell in!"},{"id":"manas-2010:p0546:b001:l023","ordinal":24738,"en":"Gathering many distinguished warriors,"},{"id":"manas-2010:p0546:b001:l024","ordinal":24739,"en":"Was it a land one would not take!"},{"id":"manas-2010:p0546:b001:l025","ordinal":24740,"en":"On ridge after ridge, a lookout—"},{"id":"manas-2010:p0546:b001:l026","ordinal":24741,"en":"Was it a land one would not post them in!"},{"id":"manas-2010:p0546:b001:l027","ordinal":24742,"en":"Upon those who dared to clash,"},{"id":"manas-2010:p0546:b001:l028","ordinal":24743,"en":"Was it a land one could not wreak havoc!"},{"id":"manas-2010:p0546:b001:l029","ordinal":24744,"en":"Keeping a court and becoming khan,"},{"id":"manas-2010:p0546:b001:l030","ordinal":24745,"en":"Was it a land one would not remain in!"},{"id":"manas-2010:p0546:b001:l031","ordinal":24746,"en":"Found through his good fortune,"},{"id":"manas-2010:p0546:b001:l032","ordinal":24747,"en":"Tamarisk-grown Keng-Kol, broad Talas—"},{"id":"manas-2010:p0546:b001:l033","ordinal":24748,"en":"The leader of forty households,"},{"id":"manas-2010:p0546:b001:l034","ordinal":24749,"en":"Mighty Manas, touched by Khizir,"},{"id":"manas-2010:p0546:b001:l035","ordinal":24750,"en":"Became a formidable sultan and khan."},{"id":"manas-2010:p0546:b001:l036","ordinal":24751,"en":"When he moved there from Altay,"},{"id":"manas-2010:p0546:b001:l037","ordinal":24752,"en":"Broad Talas became his home."},{"id":"manas-2010:p0546:b001:l038","ordinal":24753,"en":"At that time, Manas's"},{"id":"manas-2010:p0546:b001:l039","ordinal":24754,"en":"Four kinds of livestock flourished."},{"id":"manas-2010:p0546:b001:l040","ordinal":24755,"en":"In games and festivities,"},{"id":"manas-2010:p0546:b001:l041","ordinal":24756,"en":"He was now immersed."},{"id":"manas-2010:p0546:b001:l042","ordinal":24757,"en":"An ordo of forty paces"},{"id":"manas-2010:p0547:b001:l001","ordinal":24758,"en":"They laid out on the old campsite,"},{"id":"manas-2010:p0547:b001:l002","ordinal":24759,"en":"And were shooting at its pieces!"},{"id":"manas-2010:p0547:b001:l003","ordinal":24760,"en":"They set up the ordo game,"},{"id":"manas-2010:p0547:b001:l004","ordinal":24761,"en":"Of yearlings nursed by barren mares,"},{"id":"manas-2010:p0547:b001:l005","ordinal":24762,"en":"They staked two hundred at a time."},{"id":"manas-2010:p0547:b001:l006","ordinal":24763,"en":"If you would see delight, see it here!"},{"id":"manas-2010:p0547:b001:l007","ordinal":24764,"en":"The winners slaughtered their winnings."},{"id":"manas-2010:p0547:b001:l008","ordinal":24765,"en":"A blue lynx-and-marten fur cap"},{"id":"manas-2010:p0547:b001:l009","ordinal":24766,"en":"Mighty Manas kept tossing."},{"id":"manas-2010:p0547:b001:l010","ordinal":24767,"en":"Extending a hand to the gathered people,"},{"id":"manas-2010:p0547:b001:l011","ordinal":24768,"en":"Mighty Manas kept rejoicing."},{"id":"manas-2010:p0547:b001:l012","ordinal":24769,"en":"Playing games, making merry,"},{"id":"manas-2010:p0547:b001:l013","ordinal":24770,"en":"Mighty Manas loved to laugh."},{"id":"manas-2010:p0547:b001:l014","ordinal":24771,"en":"Mustering soldiers, leading hosts,"},{"id":"manas-2010:p0547:b001:l015","ordinal":24772,"en":"Mighty Manas loved to ride forth!"},{"id":"manas-2010:p0547:b001:l016","ordinal":24773,"en":"Broad Talas became his dwelling place;"},{"id":"manas-2010:p0547:b001:l017","ordinal":24774,"en":"He became an imposing warrior."},{"id":"manas-2010:p0547:b001:l018","ordinal":24775,"en":"No man came to grapple with him;"},{"id":"manas-2010:p0547:b001:l019","ordinal":24776,"en":"None remained to turn back his catching-pole."},{"id":"manas-2010:p0547:b001:l020","ordinal":24777,"en":"Your valiant one, touched by Khizir,"},{"id":"manas-2010:p0547:b001:l021","ordinal":24778,"en":"Kept a court in spacious ease."},{"id":"manas-2010:p0547:b001:l022","ordinal":24779,"en":"At your bloodthirsty hero's court,"},{"id":"manas-2010:p0547:b001:l023","ordinal":24780,"en":"Orphans and paupers ate their fill."},{"id":"manas-2010:p0547:b001:l024","ordinal":24781,"en":"From Khan Jakyp's countless livestock,"},{"id":"manas-2010:p0547:b001:l025","ordinal":24782,"en":"At the least, for his household,"},{"id":"manas-2010:p0547:b001:l026","ordinal":24783,"en":"Sixty mares at a time were slaughtered."},{"id":"manas-2010:p0547:b001:l027","ordinal":24784,"en":"Fortunate Sultan Manas's"},{"id":"manas-2010:p0547:b001:l028","ordinal":24785,"en":"Fame spread far and wide;"},{"id":"manas-2010:p0547:b001:l029","ordinal":24786,"en":"His name was heard in Alay."},{"id":"manas-2010:p0547:b001:l030","ordinal":24787,"en":"Holding gatherings and feasts,"},{"id":"manas-2010:p0547:b001:l031","ordinal":24788,"en":"At Khan Manas's court,"},{"id":"manas-2010:p0547:b001:l032","ordinal":24789,"en":"All the Kyrgyz assembled."},{"id":"manas-2010:p0547:b001:l033","ordinal":24790,"en":"The strong spirits kept at the side—"},{"id":"manas-2010:p0547:b001:l034","ordinal":24791,"en":"In Khan Manas's house,"},{"id":"manas-2010:p0547:b001:l035","ordinal":24792,"en":"Spirits in a Kalmyk-style leather flask."},{"id":"manas-2010:p0547:b001:l036","ordinal":24793,"en":"They poured it into traveling cups,"},{"id":"manas-2010:p0547:b001:l037","ordinal":24794,"en":"Passed it round to everyone."},{"id":"manas-2010:p0547:b001:l038","ordinal":24795,"en":"Drinking spirits and breathing hard,"},{"id":"manas-2010:p0547:b001:l039","ordinal":24796,"en":"With the lion Manas leading,"},{"id":"manas-2010:p0547:b001:l040","ordinal":24797,"en":"Stirring like a white falcon,"},{"id":"manas-2010:p0547:b001:l041","ordinal":24798,"en":"They drank kumys and grew heated,"},{"id":"manas-2010:p0547:b001:l042","ordinal":24799,"en":"Their bones and skin grew warm,"},{"id":"manas-2010:p0548:b001:l001","ordinal":24800,"en":"Sweat trickled from their brows."},{"id":"manas-2010:p0548:b001:l002","ordinal":24801,"en":"They played the wolves-and-sheep game,"},{"id":"manas-2010:p0548:b001:l003","ordinal":24802,"en":"And some, in mockery,"},{"id":"manas-2010:p0548:b001:l004","ordinal":24803,"en":"They beat in make-believe."},{"id":"manas-2010:p0548:b001:l005","ordinal":24804,"en":"At Kaynar's dark spring-eye,"},{"id":"manas-2010:p0548:b001:l006","ordinal":24805,"en":"Right by the plane tree itself,"},{"id":"manas-2010:p0548:b001:l007","ordinal":24806,"en":"Below Tört-Kül,"},{"id":"manas-2010:p0548:b001:l008","ordinal":24807,"en":"Newly become a ruler,"},{"id":"manas-2010:p0548:b001:l009","ordinal":24808,"en":"On Khan Manas's throne,"},{"id":"manas-2010:p0548:b001:l010","ordinal":24809,"en":"Khan Jakyp began his talk."},{"id":"manas-2010:p0548:b001:l011","ordinal":24810,"en":"If you ask about Jakyp—"},{"id":"manas-2010:p0548:b001:l012","ordinal":24811,"en":"Escaping cleanly from captivity,"},{"id":"manas-2010:p0548:b001:l013","ordinal":24812,"en":"He had come to settle in Talas."},{"id":"manas-2010:p0548:b001:l014","ordinal":24813,"en":"His name of Wealthy Jakyp faded;"},{"id":"manas-2010:p0548:b001:l015","ordinal":24814,"en":"He gained the name of Khan Jakyp."},{"id":"manas-2010:p0548:b001:l016","ordinal":24815,"en":"Being miserly over his many herds,"},{"id":"manas-2010:p0548:b001:l017","ordinal":24816,"en":"Your ill-intentioned Jakyp"},{"id":"manas-2010:p0548:b001:l018","ordinal":24817,"en":"Had earned himself a bad name."},{"id":"manas-2010:p0548:b001:l019","ordinal":24818,"en":"The elders jealous for their livestock—"},{"id":"manas-2010:p0548:b001:l020","ordinal":24819,"en":"That Jakyp had gathered"},{"id":"manas-2010:p0548:b001:l021","ordinal":24820,"en":"All the forty households."},{"id":"manas-2010:p0548:b003:l001","ordinal":24821,"en":"Playing knucklebones, raising a din,"},{"id":"manas-2010:p0548:b003:l002","ordinal":24822,"en":"To Manas as he played,"},{"id":"manas-2010:p0548:b003:l003","ordinal":24823,"en":"Khan Jakyp came storming in:"},{"id":"manas-2010:p0548:b003:l004","ordinal":24824,"en":"“My son Manas, would that you died!"},{"id":"manas-2010:p0548:b003:l005","ordinal":24825,"en":"Saying, ‘My fiery son has died,’"},{"id":"manas-2010:p0548:b003:l006","ordinal":24826,"en":"I would slaughter all my livestock,"},{"id":"manas-2010:p0548:b003:l007","ordinal":24827,"en":"And bury you here!"},{"id":"manas-2010:p0548:b003:l008","ordinal":24828,"en":"You have drained so much of my strength;"},{"id":"manas-2010:p0548:b003:l009","ordinal":24829,"en":"On drink you squandered"},{"id":"manas-2010:p0548:b003:l010","ordinal":24830,"en":"My countless herds."},{"id":"manas-2010:p0548:b003:l011","ordinal":24831,"en":"You would not heed my words."},{"id":"manas-2010:p0548:b003:l012","ordinal":24832,"en":"Exhausting my many herds,"}]
