[{"id":"semetey-1-2013:p0858:b003:l013","ordinal":142593,"en":"Six hundred gifts, headed by a horse,"},{"id":"semetey-1-2013:p0858:b003:l014","ordinal":142594,"en":"Let us pledge for his absolution rite,"},{"id":"semetey-1-2013:p0858:b003:l015","ordinal":142595,"en":"Of the religious elders and mullahs"},{"id":"semetey-1-2013:p0858:b003:l016","ordinal":142596,"en":"Thus easing their minds."},{"id":"semetey-1-2013:p0858:b003:l017","ordinal":142597,"en":"Saying, ‘This Baimyrza has died,’"},{"id":"semetey-1-2013:p0858:b003:l018","ordinal":142598,"en":"Saying, ‘He has seen Judgment Day,’"},{"id":"semetey-1-2013:p0858:b003:l019","ordinal":142599,"en":"When we bury this rich man,"},{"id":"semetey-1-2013:p0858:b003:l020","ordinal":142600,"en":"Let us devise what no one else could imagine,"},{"id":"semetey-1-2013:p0858:b003:l021","ordinal":142601,"en":"Hold a great, tumultuous feast,"},{"id":"semetey-1-2013:p0858:b003:l022","ordinal":142602,"en":"Raise dust along the dark road,"},{"id":"semetey-1-2013:p0858:b003:l023","ordinal":142603,"en":"Prepare the swiftest horses,"},{"id":"semetey-1-2013:p0858:b003:l024","ordinal":142604,"en":"Arrange strong, steadfast cheering,"},{"id":"semetey-1-2013:p0858:b003:l025","ordinal":142605,"en":"Send them racing far away;"},{"id":"semetey-1-2013:p0858:b003:l026","ordinal":142606,"en":"Of Baimyrza's countless horses"},{"id":"semetey-1-2013:p0858:b003:l027","ordinal":142607,"en":"Let us set aside half,"},{"id":"semetey-1-2013:p0858:b003:l028","ordinal":142608,"en":"Put them up as the race prizes!"},{"id":"semetey-1-2013:p0858:b003:l029","ordinal":142609,"en":"He was an elder of ninety-five;"},{"id":"semetey-1-2013:p0858:b003:l030","ordinal":142610,"en":"Let us honor him in this way."},{"id":"semetey-1-2013:p0858:b003:l031","ordinal":142611,"en":"Let us stand beneath the banner,"},{"id":"semetey-1-2013:p0858:b003:l032","ordinal":142612,"en":"Make his fame known to the great multitude,"},{"id":"semetey-1-2013:p0858:b003:l033","ordinal":142613,"en":"Raise a great stir,"},{"id":"semetey-1-2013:p0858:b003:l034","ordinal":142614,"en":"And bid him farewell with this!"},{"id":"semetey-1-2013:p0858:b003:l035","ordinal":142615,"en":"Yellow-mottled Andijan cloth with a thick weft,"},{"id":"semetey-1-2013:p0858:b003:l036","ordinal":142616,"en":"Precious black-mottled cloth from Bukhara—"},{"id":"semetey-1-2013:p0858:b003:l037","ordinal":142617,"en":"Let us gather them for his funeral,"},{"id":"semetey-1-2013:p0858:b003:l038","ordinal":142618,"en":"Let us serve him in this way."},{"id":"semetey-1-2013:p0858:b003:l039","ordinal":142619,"en":"Does not a mortal human die?"},{"id":"semetey-1-2013:p0858:b004:l001","ordinal":142620,"en":"Do not his friends and companions bury him?"},{"id":"semetey-1-2013:p0858:b004:l002","ordinal":142621,"en":"Does not a living soul go on with life!"},{"id":"semetey-1-2013:p0858:b004:l003","ordinal":142622,"en":"In Temir Khan's city,"},{"id":"semetey-1-2013:p0858:b004:l004","ordinal":142623,"en":"Growing up in exile,"},{"id":"semetey-1-2013:p0858:b004:l005","ordinal":142624,"en":"Let them see the orphan's face;"},{"id":"semetey-1-2013:p0858:b004:l006","ordinal":142625,"en":"Let my six uncles come here."},{"id":"semetey-1-2013:p0858:b004:l007","ordinal":142626,"en":"Unrealistic dream,"},{"id":"semetey-1-2013:p0858:b004:l008","ordinal":142627,"en":"Our father was of the same nest,"},{"id":"semetey-1-2013:p0858:b004:l009","ordinal":142628,"en":"If I have behaved rashly,"},{"id":"semetey-1-2013:p0858:b004:l010","ordinal":142629,"en":"Let me submit to what is right."},{"id":"semetey-1-2013:p0858:b004:l011","ordinal":142630,"en":"Let my six uncles come to me;"},{"id":"semetey-1-2013:p0858:b004:l012","ordinal":142631,"en":"I will offer my mother as a gift."},{"id":"semetey-1-2013:p0858:b004:l013","ordinal":142632,"en":"At Baimyrza's great funeral,"},{"id":"semetey-1-2013:p0858:b004:l014","ordinal":142633,"en":"Tell them to take their place at that great funeral."},{"id":"semetey-1-2013:p0858:b004:l015","ordinal":142634,"en":"Go and tell uncles Abyke and Kobosh,"},{"id":"semetey-1-2013:p0858:b004:l016","ordinal":142635,"en":"Tell them to act as brothers."},{"id":"semetey-1-2013:p0858:b004:l017","ordinal":142636,"en":"From my horses I will offer"},{"id":"semetey-1-2013:p0858:b004:l018","ordinal":142637,"en":"A steed such as Taitoru;"},{"id":"semetey-1-2013:p0858:b004:l019","ordinal":142638,"en":"As compensation I will offer"},{"id":"semetey-1-2013:p0858:b004:l020","ordinal":142639,"en":"My elder uncle Bakai."},{"id":"semetey-1-2013:p0858:b004:l021","ordinal":142640,"en":"I will offer without holding back"},{"id":"semetey-1-2013:p0858:b004:l022","ordinal":142641,"en":"My own twelve-year-old life!"},{"id":"semetey-1-2013:p0858:b004:l023","ordinal":142642,"en":"Say these are Semetey's pure, honest intentions."},{"id":"semetey-1-2013:p0858:b004:l024","ordinal":142643,"en":"Say that, when he reached ninety years,"},{"id":"semetey-1-2013:p0858:b004:l025","ordinal":142644,"en":"This is the funeral feast of Baimyrza, departed from this world!"},{"id":"semetey-1-2013:p0858:b004:l027","ordinal":142645,"en":"Let the kinsmen gather in a crowd,"},{"id":"semetey-1-2013:p0858:b004:l028","ordinal":142646,"en":"Tell them to cast the earth;"},{"id":"semetey-1-2013:p0858:b004:l029","ordinal":142647,"en":"A set of nine headed by a camel,"},{"id":"semetey-1-2013:p0858:b004:l030","ordinal":142648,"en":"Tell them to take as their funeral gift!"},{"id":"semetey-1-2013:p0858:b004:l031","ordinal":142649,"en":"For Baimyrza's funeral"},{"id":"semetey-1-2013:p0858:b004:l032","ordinal":142650,"en":"I will give more than other peoples do."},{"id":"semetey-1-2013:p0858:b004:l033","ordinal":142651,"en":"With its lower lip drooping,"},{"id":"semetey-1-2013:p0858:b004:l034","ordinal":142652,"en":"Its two humps standing proudly,"},{"id":"semetey-1-2013:p0858:b004:l035","ordinal":142653,"en":"I will give a burden-bearing camel."},{"id":"semetey-1-2013:p0858:b004:l036","ordinal":142654,"en":"I will give red gold for the mourning gifts;"},{"id":"semetey-1-2013:p0858:b004:l038","ordinal":142655,"en":"I will give abundant riches."},{"id":"semetey-1-2013:p0858:b004:l039","ordinal":142656,"en":"Sarykan with eyes like bowls,"},{"id":"semetey-1-2013:p0859:b003:l001","ordinal":142657,"en":"My sultan uncle, listen!"},{"id":"semetey-1-2013:p0859:b003:l002","ordinal":142658,"en":"If he speaks against you and uses force,"},{"id":"semetey-1-2013:p0859:b003:l003","ordinal":142659,"en":"If my khan uncle acts against you,"},{"id":"semetey-1-2013:p0859:b003:l004","ordinal":142660,"en":"For Baimyrza's funeral service"},{"id":"semetey-1-2013:p0859:b003:l005","ordinal":142661,"en":"I will seize his mares by force,"},{"id":"semetey-1-2013:p0859:b003:l006","ordinal":142662,"en":"I will bind his giants;"},{"id":"semetey-1-2013:p0859:b003:l007","ordinal":142663,"en":"If he comes near then,"},{"id":"semetey-1-2013:p0859:b003:l008","ordinal":142664,"en":"I will strike and scatter his brains!"},{"id":"semetey-1-2013:p0859:b003:l009","ordinal":142665,"en":"If I truly set to it, I will drive out—"},{"id":"semetey-1-2013:p0859:b003:l010","ordinal":142666,"en":"For his remotest wrongs!"},{"id":"semetey-1-2013:p0859:b003:l011","ordinal":142667,"en":"Let them not be late."},{"id":"semetey-1-2013:p0859:b003:l012","ordinal":142668,"en":"If they delay through quarreling,"},{"id":"semetey-1-2013:p0859:b003:l013","ordinal":142669,"en":"Let them prepare a place to quarrel;"},{"id":"semetey-1-2013:p0859:b003:l014","ordinal":142670,"en":"Let not a single one arrive late."},{"id":"semetey-1-2013:p0859:b003:l015","ordinal":142671,"en":"Let them not put on weighty airs."},{"id":"semetey-1-2013:p0859:b003:l016","ordinal":142672,"en":"If they throw their weight about and use force,"},{"id":"semetey-1-2013:p0859:b003:l017","ordinal":142673,"en":"Let them prepare the place for a lance fight!"},{"id":"semetey-1-2013:p0859:b003:l018","ordinal":142674,"en":"This is the greeting I send;"},{"id":"semetey-1-2013:p0859:b003:l019","ordinal":142675,"en":"Uncle Sary, listen carefully!"},{"id":"semetey-1-2013:p0859:b003:l020","ordinal":142676,"en":"Say it to my six uncles' faces."},{"id":"semetey-1-2013:p0859:b003:l021","ordinal":142677,"en":"Say it to my six uncles' faces."},{"id":"semetey-1-2013:p0859:b003:l022","ordinal":142678,"en":"Say it to the slave Shuutu's face,"},{"id":"semetey-1-2013:p0859:b003:l023","ordinal":142679,"en":"Say it among the forty companions!"},{"id":"semetey-1-2013:p0859:b003:l024","ordinal":142680,"en":"Strong-armed Baichoro,"},{"id":"semetey-1-2013:p0859:b003:l025","ordinal":142681,"en":"The faithful support left by my father—"},{"id":"semetey-1-2013:p0859:b003:l026","ordinal":142682,"en":"Tell such a hero."},{"id":"semetey-1-2013:p0859:b003:l027","ordinal":142683,"en":"Kyrgylchal, head of the forty,"},{"id":"semetey-1-2013:p0859:b003:l028","ordinal":142684,"en":"Tell that unbeliever who disrupts the people."},{"id":"semetey-1-2013:p0859:b003:l029","ordinal":142685,"en":"Tell Yraman's Yrchuul;"},{"id":"semetey-1-2013:p0859:b003:l030","ordinal":142686,"en":"Tell the diviner, Kara Tolok."},{"id":"semetey-1-2013:p0859:b003:l031","ordinal":142687,"en":"Tell the elders among the clans;"},{"id":"semetey-1-2013:p0859:b003:l032","ordinal":142688,"en":"Tell all forty companions!"},{"id":"semetey-1-2013:p0859:b003:l033","ordinal":142689,"en":"Abyke, who finds wise counsel,"},{"id":"semetey-1-2013:p0859:b003:l034","ordinal":142690,"en":"Was a wise and heroic kinsman;"},{"id":"semetey-1-2013:p0859:b003:l035","ordinal":142691,"en":"My uncle Kobosh moved heavily and grandly,"},{"id":"semetey-1-2013:p0859:b003:l036","ordinal":142692,"en":"From their multitude the black earth"},{"id":"semetey-1-2013:p0859:b003:l037","ordinal":142693,"en":"My holy sage who has seen much,"},{"id":"semetey-1-2013:p0859:b003:l038","ordinal":142694,"en":"My elder, born to bring people good fortune!"},{"id":"semetey-1-2013:p0859:b003:l039","ordinal":142695,"en":"Kobosh and Kyrgylchal"},{"id":"semetey-1-2013:p0859:b005:l001","ordinal":142696,"en":"Were dogs of evil temper;"},{"id":"semetey-1-2013:p0859:b005:l002","ordinal":142697,"en":"If they speak unrestrained words,"},{"id":"semetey-1-2013:p0859:b005:l003","ordinal":142698,"en":"Do not stoop to that dog's level."},{"id":"semetey-1-2013:p0859:b005:l004","ordinal":142699,"en":"Hey, Uncle Sary Khan!"},{"id":"semetey-1-2013:p0859:b005:l005","ordinal":142700,"en":"If you give way, you will earn a bad name."},{"id":"semetey-1-2013:p0859:b005:l006","ordinal":142701,"en":"To Abyke and Kobosh"},{"id":"semetey-1-2013:p0859:b005:l007","ordinal":142702,"en":"You are going as an envoy;"},{"id":"semetey-1-2013:p0859:b005:l008","ordinal":142703,"en":"Uncle, I entrust this to you now!”"},{"id":"semetey-1-2013:p0859:b005:l009","ordinal":142704,"en":"Then Sary Khan,"},{"id":"semetey-1-2013:p0859:b005:l010","ordinal":142705,"en":"Clad in blue iron armor,"},{"id":"semetey-1-2013:p0859:b005:l011","ordinal":142706,"en":"Springing like a blue tiger,"},{"id":"semetey-1-2013:p0859:b005:l012","ordinal":142707,"en":"Girding on his cutting sword,"},{"id":"semetey-1-2013:p0859:b005:l013","ordinal":142708,"en":"Readying all his weapons,"},{"id":"semetey-1-2013:p0859:b005:l014","ordinal":142709,"en":"Like a cloud in the sky,"},{"id":"semetey-1-2013:p0859:b005:l015","ordinal":142710,"en":"Moving back and forth,"},{"id":"semetey-1-2013:p0859:b005:l016","ordinal":142711,"en":"Preparing his arms for war,"},{"id":"semetey-1-2013:p0859:b005:l017","ordinal":142712,"en":"Had surpassingly eloquent speech,"},{"id":"semetey-1-2013:p0859:b005:l018","ordinal":142713,"en":"Had eyes like bowls."},{"id":"semetey-1-2013:p0859:b005:l019","ordinal":142714,"en":"Had you seen your uncle Sary,"},{"id":"semetey-1-2013:p0859:b005:l020","ordinal":142715,"en":"Anyone who came before him"},{"id":"semetey-1-2013:p0859:b005:l021","ordinal":142716,"en":"Would suddenly start in fright,"},{"id":"semetey-1-2013:p0859:b005:l022","ordinal":142717,"en":"His heart sorely troubled;"},{"id":"semetey-1-2013:p0859:b005:l023","ordinal":142718,"en":"Seen from behind,"},{"id":"semetey-1-2013:p0859:b005:l024","ordinal":142719,"en":"He looked like a mighty mountain."},{"id":"semetey-1-2013:p0859:b005:l025","ordinal":142720,"en":"Readying his lacquered spear,"},{"id":"semetey-1-2013:p0859:b005:l026","ordinal":142721,"en":"Girding his battle-axe slantwise,"},{"id":"semetey-1-2013:p0859:b005:l027","ordinal":142722,"en":"Hanging at one side—"},{"id":"semetey-1-2013:p0859:b005:l028","ordinal":142723,"en":"A devastating bow, smooth arrowheads,"},{"id":"semetey-1-2013:p0859:b005:l029","ordinal":142724,"en":"Your uncle Sary Khan"},{"id":"semetey-1-2013:p0859:b005:l030","ordinal":142725,"en":"Set the world talking."},{"id":"semetey-1-2013:p0859:b005:l031","ordinal":142726,"en":"A helmet of blue iron"},{"id":"semetey-1-2013:p0859:b005:l032","ordinal":142727,"en":"Was fitted over his head."},{"id":"semetey-1-2013:p0859:b005:l033","ordinal":142728,"en":"If you ask about your uncle,"},{"id":"semetey-1-2013:p0859:b005:l034","ordinal":142729,"en":"He had a warrior's frame and a broad chest;"},{"id":"semetey-1-2013:p0859:b005:l035","ordinal":142730,"en":"His coat was of blue iron."},{"id":"semetey-1-2013:p0859:b005:l036","ordinal":142731,"en":"If seven worlds of enemies came,"},{"id":"semetey-1-2013:p0859:b005:l037","ordinal":142732,"en":"He would charge alone into their midst."},{"id":"semetey-1-2013:p0859:b005:l038","ordinal":142733,"en":"The mount beneath him—"},{"id":"semetey-1-2013:p0859:b005:l039","ordinal":142734,"en":"The peerless courser Tuuchunak,"},{"id":"semetey-1-2013:p0860:b003:l001","ordinal":142735,"en":"A Karabair courser,"},{"id":"semetey-1-2013:p0860:b003:l002","ordinal":142736,"en":"With sieve-like lungs and brass forelegs,"},{"id":"semetey-1-2013:p0860:b003:l003","ordinal":142737,"en":"Never tiring when ridden on reconnaissance,"},{"id":"semetey-1-2013:p0860:b003:l004","ordinal":142738,"en":"Never ailing when ridden in the rear guard,"},{"id":"semetey-1-2013:p0860:b003:l005","ordinal":142739,"en":"With hoe-like hooves and a broad rump,"},{"id":"semetey-1-2013:p0860:b003:l006","ordinal":142740,"en":"Well-formed Tuuchunak."},{"id":"semetey-1-2013:p0860:b003:l007","ordinal":142741,"en":"Unless a bullet struck him,"},{"id":"semetey-1-2013:p0860:b003:l008","ordinal":142742,"en":"Unless untimely death overtook him,"},{"id":"semetey-1-2013:p0860:b003:l009","ordinal":142743,"en":"He would not falter when ridden into battle,"},{"id":"semetey-1-2013:p0860:b003:l010","ordinal":142744,"en":"The otherworldly courser Tuuchunak."},{"id":"semetey-1-2013:p0860:b003:l011","ordinal":142745,"en":"The mount beneath him,"},{"id":"semetey-1-2013:p0860:b003:l012","ordinal":142746,"en":"His swift Tuuchunak,"},{"id":"semetey-1-2013:p0860:b003:l013","ordinal":142747,"en":"Leaving the royal camp behind,"},{"id":"semetey-1-2013:p0860:b003:l014","ordinal":142748,"en":"Looming like a mighty mountain,"},{"id":"semetey-1-2013:p0860:b003:l015","ordinal":142749,"en":"He rode with splendid bearing,"},{"id":"semetey-1-2013:p0860:b003:l016","ordinal":142750,"en":"Knotting the horse's long tail firmly,"},{"id":"semetey-1-2013:p0860:b003:l017","ordinal":142751,"en":"Venom pouring from his face,"},{"id":"semetey-1-2013:p0860:b003:l018","ordinal":142752,"en":"Mighty in strength, fierce in countenance,"},{"id":"semetey-1-2013:p0860:b003:l019","ordinal":142753,"en":"A dear soul whose valor was precious."},{"id":"semetey-1-2013:p0860:b003:l020","ordinal":142754,"en":"Once a charcoal burner, blackened with soot,"},{"id":"semetey-1-2013:p0860:b003:l021","ordinal":142755,"en":"He had joined Semetey,"},{"id":"semetey-1-2013:p0860:b003:l022","ordinal":142756,"en":"All his misfortunes were dispelled,"},{"id":"semetey-1-2013:p0860:b003:l023","ordinal":142757,"en":"He became a giant, sultan of the Argyn."},{"id":"semetey-1-2013:p0860:b003:l024","ordinal":142758,"en":"Now he went as an intermediary."},{"id":"semetey-1-2013:p0860:b003:l025","ordinal":142759,"en":"Urging the horse across the grassy mountain slopes,"},{"id":"semetey-1-2013:p0860:b003:l026","ordinal":142760,"en":"When he reached the rolling hills,"},{"id":"semetey-1-2013:p0860:b003:l027","ordinal":142761,"en":"He let the reins go free."},{"id":"semetey-1-2013:p0860:b003:l028","ordinal":142762,"en":"Along broad Urbus,"},{"id":"semetey-1-2013:p0860:b003:l029","ordinal":142763,"en":"Where Abyke and Kobosh stayed,"},{"id":"semetey-1-2013:p0860:b003:l030","ordinal":142764,"en":"Sary Khan with eyes like bowls"},{"id":"semetey-1-2013:p0860:b003:l031","ordinal":142765,"en":"Came riding hard."},{"id":"semetey-1-2013:p0860:b003:l032","ordinal":142766,"en":"Look at the trench they had dug,"},{"id":"semetey-1-2013:p0860:b003:l033","ordinal":142767,"en":"Look at the seething army,"},{"id":"semetey-1-2013:p0860:b003:l034","ordinal":142768,"en":"Look at the white banner,"},{"id":"semetey-1-2013:p0860:b003:l035","ordinal":142769,"en":"Look at the shouting tumult!"},{"id":"semetey-1-2013:p0860:b003:l036","ordinal":142770,"en":"Mist settled in corners,"},{"id":"semetey-1-2013:p0860:b003:l037","ordinal":142771,"en":"The people gathered and armed themselves,"},{"id":"semetey-1-2013:p0860:b003:l038","ordinal":142772,"en":"Swaying in ranks along the edge,"},{"id":"semetey-1-2013:p0860:b003:l039","ordinal":142773,"en":"Khan Kobosh's royal camp"},{"id":"semetey-1-2013:p0860:b004:l001","ordinal":142774,"en":"Was surrounded by a mass of troops, surging."},{"id":"semetey-1-2013:p0860:b004:l002","ordinal":142775,"en":"A red banner mottled with gray,"},{"id":"semetey-1-2013:p0860:b004:l003","ordinal":142776,"en":"Many cries of “Oh!” and a tumult,"},{"id":"semetey-1-2013:p0860:b004:l004","ordinal":142777,"en":"A white-mottled pennon, a red banner,"},{"id":"semetey-1-2013:p0860:b004:l005","ordinal":142778,"en":"Shrill shouts and a tumult."},{"id":"semetey-1-2013:p0860:b004:l006","ordinal":142779,"en":"Marksmen crouched,"},{"id":"semetey-1-2013:p0860:b004:l007","ordinal":142780,"en":"Lancers stood stiffly erect,"},{"id":"semetey-1-2013:p0860:b004:l008","ordinal":142781,"en":"Axemen made ready;"},{"id":"semetey-1-2013:p0860:b004:l009","ordinal":142782,"en":"Abyke and Kobosh's"},{"id":"semetey-1-2013:p0860:b004:l010","ordinal":142783,"en":"Great army was preparing."},{"id":"semetey-1-2013:p0860:b004:l011","ordinal":142784,"en":"There were seven banners,"},{"id":"semetey-1-2013:p0860:b004:l012","ordinal":142785,"en":"An army that bent the earth,"},{"id":"semetey-1-2013:p0860:b004:l013","ordinal":142786,"en":"Their assembled forces were vast."},{"id":"semetey-1-2013:p0860:b004:l014","ordinal":142787,"en":"Abyke and Kobosh were not alone:"},{"id":"semetey-1-2013:p0860:b004:l015","ordinal":142788,"en":"There were troops from every region,"},{"id":"semetey-1-2013:p0860:b004:l016","ordinal":142789,"en":"So many they bent the earth."},{"id":"semetey-1-2013:p0860:b004:l017","ordinal":142790,"en":"When Semetey had gone to Bukhara,"},{"id":"semetey-1-2013:p0860:b004:l018","ordinal":142791,"en":"He who dwelt in Eki-Kemin,"},{"id":"semetey-1-2013:p0860:b004:l019","ordinal":142792,"en":"Who tethered a pair of black horses,"},{"id":"semetey-1-2013:p0860:b004:l020","ordinal":142793,"en":"Who sowed his rice as an autumn crop,"},{"id":"semetey-1-2013:p0860:b004:l021","ordinal":142794,"en":"The barnyard grass from his rice fields"},{"id":"semetey-1-2013:p0860:b004:l022","ordinal":142795,"en":"He tied up for his horse,"},{"id":"semetey-1-2013:p0860:b004:l023","ordinal":142796,"en":"Who sharpened his tongue,"},{"id":"semetey-1-2013:p0860:b004:l024","ordinal":142797,"en":"Who spoke eloquently before the khan,"},{"id":"semetey-1-2013:p0860:b004:l025","ordinal":142798,"en":"Who gathered harriers and made them hunting birds,"},{"id":"semetey-1-2013:p0860:b004:l026","ordinal":142799,"en":"Who gathered mixed folk and made them a people,"},{"id":"semetey-1-2013:p0860:b004:l027","ordinal":142800,"en":"Who made the dark forest his livestock,"},{"id":"semetey-1-2013:p0860:b004:l028","ordinal":142801,"en":"Who made a dark cave his home—"},{"id":"semetey-1-2013:p0860:b004:l029","ordinal":142802,"en":"The hero Urbu, son of bald Eybit—"},{"id":"semetey-1-2013:p0860:b004:l030","ordinal":142803,"en":"Abyke, Kobosh, the six villains,"},{"id":"semetey-1-2013:p0860:b004:l031","ordinal":142804,"en":"Had sent word to Urbu,"},{"id":"semetey-1-2013:p0860:b004:l032","ordinal":142805,"en":"Gathered Urbu's army,"},{"id":"semetey-1-2013:p0860:b004:l033","ordinal":142806,"en":"And assembled it in Talas."},{"id":"semetey-1-2013:p0860:b004:l034","ordinal":142807,"en":"He who dwelt in Sary-Arka,"},{"id":"semetey-1-2013:p0860:b004:l035","ordinal":142808,"en":"Called a weighty, formidable hero,"},{"id":"semetey-1-2013:p0860:b004:l036","ordinal":142809,"en":"Who husked his millet, stones and all,"},{"id":"semetey-1-2013:p0860:b004:l037","ordinal":142810,"en":"Who praised his wife like a maiden,"},{"id":"semetey-1-2013:p0860:b004:l038","ordinal":142811,"en":"Whose lattice walls were made of wood,"},{"id":"semetey-1-2013:p0860:b004:l039","ordinal":142812,"en":"And his elder brother is of the Alach."},{"id":"semetey-1-2013:p0861:b003:l001","ordinal":142813,"en":"Aidarkan's hero Kokcho,"},{"id":"semetey-1-2013:p0861:b003:l002","ordinal":142814,"en":"Kokcho's son Umotoy—"},{"id":"semetey-1-2013:p0861:b003:l003","ordinal":142815,"en":"Stinking sour milk and blue-green dried curds—"},{"id":"semetey-1-2013:p0861:b003:l004","ordinal":142816,"en":"From the shouting Kazakhs,"},{"id":"semetey-1-2013:p0861:b003:l005","ordinal":142817,"en":"They had brought Umotoy's army;"},{"id":"semetey-1-2013:p0861:b003:l006","ordinal":142818,"en":"The villains Abyke and Kobosh"},{"id":"semetey-1-2013:p0861:b003:l007","ordinal":142819,"en":"Had assembled it."},{"id":"semetey-1-2013:p0861:b003:l008","ordinal":142820,"en":"Khans who would act with hostility,"},{"id":"semetey-1-2013:p0861:b003:l009","ordinal":142821,"en":"Men who would fire shots,"},{"id":"semetey-1-2013:p0861:b003:l010","ordinal":142822,"en":"They had gathered them all."},{"id":"semetey-1-2013:p0861:b003:l011","ordinal":142823,"en":"Golden-crowned Muzburchak,"},{"id":"semetey-1-2013:p0861:b003:l012","ordinal":142824,"en":"Muzburchak's son Buyanbek—"},{"id":"semetey-1-2013:p0861:b003:l013","ordinal":142825,"en":"Saying, “Avenge your father,”"},{"id":"semetey-1-2013:p0861:b003:l014","ordinal":142826,"en":"“Manas's orphan son—"},{"id":"semetey-1-2013:p0861:b003:l015","ordinal":142827,"en":"Offer him as a sacrifice,”"},{"id":"semetey-1-2013:p0861:b003:l016","ordinal":142828,"en":"They had brought him there."},{"id":"semetey-1-2013:p0861:b003:l017","ordinal":142829,"en":"And Shygai Khan of Alkym—"},{"id":"semetey-1-2013:p0861:b003:l018","ordinal":142830,"en":"His son Chynkozho,"},{"id":"semetey-1-2013:p0861:b003:l019","ordinal":142831,"en":"Kozho, whose deeds too were vigorous,"},{"id":"semetey-1-2013:p0861:b003:l020","ordinal":142832,"en":"Saying, “Manas's orphan son"},{"id":"semetey-1-2013:p0861:b003:l021","ordinal":142833,"en":"I will offer as a sacrifice,"},{"id":"semetey-1-2013:p0861:b003:l022","ordinal":142834,"en":"I will avenge my undying grudge,”"},{"id":"semetey-1-2013:p0861:b003:l023","ordinal":142835,"en":"Had joined the gathering."},{"id":"semetey-1-2013:p0861:b003:l024","ordinal":142836,"en":"He who ruled Alty-Shaar,"},{"id":"semetey-1-2013:p0861:b003:l025","ordinal":142837,"en":"Manas's enemy from of old,"},{"id":"semetey-1-2013:p0861:b003:l026","ordinal":142838,"en":"Alabek, khan of the nomads—"},{"id":"semetey-1-2013:p0861:b003:l027","ordinal":142839,"en":"They had brought his army."},{"id":"semetey-1-2013:p0861:b003:l028","ordinal":142840,"en":"They camped along Urbus,"},{"id":"semetey-1-2013:p0861:b003:l029","ordinal":142841,"en":"Raising gray-mottled pennons and banners,"},{"id":"semetey-1-2013:p0861:b003:l030","ordinal":142842,"en":"They filled the place like ants."},{"id":"semetey-1-2013:p0861:b003:l031","ordinal":142843,"en":"All their khans,"},{"id":"semetey-1-2013:p0861:b003:l032","ordinal":142844,"en":"Their elders who ruled the people,"},{"id":"semetey-1-2013:p0861:b003:l033","ordinal":142845,"en":"Their religious elder in a mottled robe,"},{"id":"semetey-1-2013:p0861:b003:l034","ordinal":142846,"en":"Their mullah who studied lessons,"},{"id":"semetey-1-2013:p0861:b003:l035","ordinal":142847,"en":"Abyke and Kobosh's royal camp—"},{"id":"semetey-1-2013:p0861:b003:l036","ordinal":142848,"en":"Stirred up in their royal camp,"}]
