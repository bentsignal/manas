[{"id":"semetey-1-2013:p1409:b003:l036","ordinal":183809,"en":"It is necessary to Manas"},{"id":"semetey-1-2013:p1409:b003:l037","ordinal":183810,"en":"The edge of the earth Zelpinish"},{"id":"semetey-1-2013:p1409:b003:l038","ordinal":183811,"en":"When I knew"},{"id":"semetey-1-2013:p1409:b003:l039","ordinal":183812,"en":"Why didn't I die here!"},{"id":"semetey-1-2013:p1409:b005:l001","ordinal":183813,"en":"I did not see the pain"},{"id":"semetey-1-2013:p1409:b005:l002","ordinal":183814,"en":"Under my blue sky"},{"id":"semetey-1-2013:p1409:b005:l003","ordinal":183815,"en":"I did not die as a victim!"},{"id":"semetey-1-2013:p1409:b005:l004","ordinal":183816,"en":"While shooting"},{"id":"semetey-1-2013:p1409:b005:l005","ordinal":183817,"en":"Load the bullet into the belt,"},{"id":"semetey-1-2013:p1409:b005:l006","ordinal":183818,"en":"Muslims took the people together."},{"id":"semetey-1-2013:p1409:b005:l007","ordinal":183819,"en":"Flashing people driving,"},{"id":"semetey-1-2013:p1409:b005:l008","ordinal":183820,"en":"Pack tightly and drive the giant,"},{"id":"semetey-1-2013:p1409:b005:l009","ordinal":183821,"en":"Muslims led the people as a whole,"},{"id":"semetey-1-2013:p1409:b005:l010","ordinal":183822,"en":"When you are angry with your father,"},{"id":"semetey-1-2013:p1409:b005:l011","ordinal":183823,"en":"Black Chinese Manchu"},{"id":"semetey-1-2013:p1409:b005:l012","ordinal":183824,"en":"Beating and knocking"},{"id":"semetey-1-2013:p1409:b005:l013","ordinal":183825,"en":"When you seized the khanate,"},{"id":"semetey-1-2013:p1409:b005:l014","ordinal":183826,"en":"Why didn't I die here!"},{"id":"semetey-1-2013:p1409:b005:l015","ordinal":183827,"en":"I bleed when I get angry"},{"id":"semetey-1-2013:p1409:b005:l016","ordinal":183828,"en":"During my imprisonment,"},{"id":"semetey-1-2013:p1409:b005:l017","ordinal":183829,"en":"A Chinese in a dark suit"},{"id":"semetey-1-2013:p1409:b005:l018","ordinal":183830,"en":"Beat the strong,"},{"id":"semetey-1-2013:p1409:b005:l019","ordinal":183831,"en":"When I beat,"},{"id":"semetey-1-2013:p1409:b005:l020","ordinal":183832,"en":"Why didn't I die here!"},{"id":"semetey-1-2013:p1409:b005:l021","ordinal":183833,"en":"Come on, Manas, don't die!"},{"id":"semetey-1-2013:p1409:b005:l022","ordinal":183834,"en":"It's a shame I'm behind"},{"id":"semetey-1-2013:p1409:b005:l023","ordinal":183835,"en":"Bakayi without hesitation"},{"id":"semetey-1-2013:p1409:b005:l024","ordinal":183836,"en":"My lion Manas, take it!"},{"id":"semetey-1-2013:p1409:b005:l025","ordinal":183837,"en":"A world friend"},{"id":"semetey-1-2013:p1409:b005:l026","ordinal":183838,"en":"Did you leave it behind?"},{"id":"semetey-1-2013:p1409:b005:l027","ordinal":183839,"en":"Pushing each other"},{"id":"semetey-1-2013:p1409:b005:l028","ordinal":183840,"en":"That's why you killed me?!"},{"id":"semetey-1-2013:p1409:b005:l029","ordinal":183841,"en":"You were a relative of lion."},{"id":"semetey-1-2013:p1409:b005:l030","ordinal":183842,"en":"Dark Manas, don't die!"},{"id":"semetey-1-2013:p1409:b005:l031","ordinal":183843,"en":"I'm in Manas' bar"},{"id":"semetey-1-2013:p1409:b005:l032","ordinal":183844,"en":"I would cut the cloth and eat it."},{"id":"semetey-1-2013:p1409:b005:l033","ordinal":183845,"en":"Proud of myself,"},{"id":"semetey-1-2013:p1409:b005:l034","ordinal":183846,"en":"I would say stay in trouble!"},{"id":"semetey-1-2013:p1409:b005:l035","ordinal":183847,"en":"I'm in Manas' bar"},{"id":"semetey-1-2013:p1409:b005:l036","ordinal":183848,"en":"I was an elder, I was a khan,"},{"id":"semetey-1-2013:p1409:b005:l037","ordinal":183849,"en":"I see the people I see"},{"id":"semetey-1-2013:p1409:b005:l038","ordinal":183850,"en":"Baigambar was a critical person."},{"id":"semetey-1-2013:p1409:b005:l039","ordinal":183851,"en":"My lion Manas, did you pass?"},{"id":"semetey-1-2013:p1410:b003:l001","ordinal":183852,"en":"When Bakai had grown old,"},{"id":"semetey-1-2013:p1410:b003:l002","ordinal":183853,"en":"Did you leave him behind?!\""},{"id":"semetey-1-2013:p1410:b003:l003","ordinal":183854,"en":"Leaning his golden-cheeked battle-axe"},{"id":"semetey-1-2013:p1410:b003:l004","ordinal":183855,"en":"Against his right side,"},{"id":"semetey-1-2013:p1410:b003:l005","ordinal":183856,"en":"Bakai stood there wailing!"},{"id":"semetey-1-2013:p1410:b003:l006","ordinal":183857,"en":"Mourning Manas then"},{"id":"semetey-1-2013:p1410:b003:l007","ordinal":183858,"en":"Remembering the past"},{"id":"semetey-1-2013:p1410:b003:l008","ordinal":183859,"en":"He tore at his beard!"},{"id":"semetey-1-2013:p1410:b003:l009","ordinal":183860,"en":"As Bakai stood thus,"},{"id":"semetey-1-2013:p1410:b003:l010","ordinal":183861,"en":"His heart was overcome;"},{"id":"semetey-1-2013:p1410:b003:l011","ordinal":183862,"en":"Seeing Bakai,"},{"id":"semetey-1-2013:p1410:b003:l012","ordinal":183863,"en":"The young son of the gray wolf"},{"id":"semetey-1-2013:p1410:b003:l013","ordinal":183864,"en":"Tears fell from his eyes:"},{"id":"semetey-1-2013:p1410:b003:l014","ordinal":183865,"en":"The gray wolf born after"},{"id":"semetey-1-2013:p1410:b003:l015","ordinal":183866,"en":"His father, noble Manas,"},{"id":"semetey-1-2013:p1410:b003:l016","ordinal":183867,"en":"Was overcome with grief;"},{"id":"semetey-1-2013:p1410:b003:l017","ordinal":183868,"en":"Seeing his uncle clearly,"},{"id":"semetey-1-2013:p1410:b003:l018","ordinal":183869,"en":"His tears poured down."},{"id":"semetey-1-2013:p1410:b003:l019","ordinal":183870,"en":"\"Uncle Bakai, heroic sultan,"},{"id":"semetey-1-2013:p1410:b003:l020","ordinal":183871,"en":"My dear one,"},{"id":"semetey-1-2013:p1410:b003:l021","ordinal":183872,"en":"Now that you have grown old,"},{"id":"semetey-1-2013:p1410:b003:l022","ordinal":183873,"en":"Let me be the sacrifice"},{"id":"semetey-1-2013:p1410:b003:l023","ordinal":183874,"en":"For your eyes that shot the white argali!"},{"id":"semetey-1-2013:p1410:b003:l024","ordinal":183875,"en":"Who made the ignorant know,"},{"id":"semetey-1-2013:p1410:b003:l025","ordinal":183876,"en":"My learned old Bakai,"},{"id":"semetey-1-2013:p1410:b003:l026","ordinal":183877,"en":"Who made the unperceptive perceive,"},{"id":"semetey-1-2013:p1410:b003:l027","ordinal":183878,"en":"My falconlike sage Bakai!"},{"id":"semetey-1-2013:p1410:b003:l028","ordinal":183879,"en":"My touchstone before the renowned people,"},{"id":"semetey-1-2013:p1410:b003:l029","ordinal":183880,"en":"My legacy left as a gift"},{"id":"semetey-1-2013:p1410:b003:l030","ordinal":183881,"en":"By my valiant father, the gray wolf!"},{"id":"semetey-1-2013:p1410:b003:l031","ordinal":183882,"en":"My saint born among mortals,"},{"id":"semetey-1-2013:p1410:b003:l032","ordinal":183883,"en":"My blessed old Bakai!"},{"id":"semetey-1-2013:p1410:b003:l033","ordinal":183884,"en":"Set before me, you are my good road;"},{"id":"semetey-1-2013:p1410:b003:l034","ordinal":183885,"en":"If my uncle Bakai the brave*"},{"id":"semetey-1-2013:p1410:b003:l035","ordinal":183886,"en":"Walks behind me, he is my countless host!"},{"id":"semetey-1-2013:p1410:b003:l036","ordinal":183887,"en":"For an uncle such as you,"},{"id":"semetey-1-2013:p1410:b003:l037","ordinal":183888,"en":"I would sacrifice my very life!"},{"id":"semetey-1-2013:p1410:b003:l038","ordinal":183889,"en":"Without understanding very much,"},{"id":"semetey-1-2013:p1410:b004:l001","ordinal":183890,"en":"I pushed you toward the grave, uncle,"},{"id":"semetey-1-2013:p1410:b004:l002","ordinal":183891,"en":"And acted out of arrogance!"},{"id":"semetey-1-2013:p1410:b004:l003","ordinal":183892,"en":"My dear elder khan,"},{"id":"semetey-1-2013:p1410:b004:l004","ordinal":183893,"en":"Let me offer you a courser;"},{"id":"semetey-1-2013:p1410:b004:l005","ordinal":183894,"en":"Take my steed Taibuurul;"},{"id":"semetey-1-2013:p1410:b004:l006","ordinal":183895,"en":"If your anger is still rising,"},{"id":"semetey-1-2013:p1410:b004:l007","ordinal":183896,"en":"Uncle gray wolf, leopard,"},{"id":"semetey-1-2013:p1410:b004:l008","ordinal":183897,"en":"Pour my blood into a leather flask!"},{"id":"semetey-1-2013:p1410:b004:l009","ordinal":183898,"en":"My old father Bakai,"},{"id":"semetey-1-2013:p1410:b004:l010","ordinal":183899,"en":"Whom I held in a father's place!"},{"id":"semetey-1-2013:p1410:b004:l011","ordinal":183900,"en":"Who joined what was broken,"},{"id":"semetey-1-2013:p1410:b004:l012","ordinal":183901,"en":"Gathered what was scattered,"},{"id":"semetey-1-2013:p1410:b004:l013","ordinal":183902,"en":"And found the means to live,"},{"id":"semetey-1-2013:p1410:b004:l014","ordinal":183903,"en":"My sage!\"—"},{"id":"semetey-1-2013:p1410:b004:l015","ordinal":183904,"en":"Thus spoke Semetey,"},{"id":"semetey-1-2013:p1410:b004:l016","ordinal":183905,"en":"Calling Bakai \"uncle, bloodthirsty one\";"},{"id":"semetey-1-2013:p1410:b004:l017","ordinal":183906,"en":"He turned his neck toward God,"},{"id":"semetey-1-2013:p1410:b004:l018","ordinal":183907,"en":"Pleaded, calling him dear uncle,"},{"id":"semetey-1-2013:p1410:b004:l019","ordinal":183908,"en":"And offered Narbuurul as a gift."},{"id":"semetey-1-2013:p1410:b004:l020","ordinal":183909,"en":"Then your uncle Bakai,"},{"id":"semetey-1-2013:p1410:b004:l021","ordinal":183910,"en":"Flying like a white hawk,"},{"id":"semetey-1-2013:p1410:b004:l022","ordinal":183911,"en":"Praying to God"},{"id":"semetey-1-2013:p1410:b004:l023","ordinal":183912,"en":"Now slaughtered a white argali;"},{"id":"semetey-1-2013:p1410:b004:l024","ordinal":183913,"en":"The lion, Khan Bakai,"},{"id":"semetey-1-2013:p1410:b004:l025","ordinal":183914,"en":"Now ate until his belly was filled."},{"id":"semetey-1-2013:p1410:b004:l026","ordinal":183915,"en":"Resting on his elbow,"},{"id":"semetey-1-2013:p1410:b004:l027","ordinal":183916,"en":"He took a brief sleep;"},{"id":"semetey-1-2013:p1410:b004:l028","ordinal":183917,"en":"At dawn"},{"id":"semetey-1-2013:p1410:b004:l029","ordinal":183918,"en":"Lying on his side, he slept his fill."},{"id":"semetey-1-2013:p1410:b004:l030","ordinal":183919,"en":"He let all the fine coursers"},{"id":"semetey-1-2013:p1410:b004:l031","ordinal":183920,"en":"Graze upon the fescue,"},{"id":"semetey-1-2013:p1410:b004:l032","ordinal":183921,"en":"Leading them onward,"},{"id":"semetey-1-2013:p1410:b004:l033","ordinal":183922,"en":"Filling their chests with grass;"},{"id":"semetey-1-2013:p1410:b004:l034","ordinal":183923,"en":"Without tiring, he sat"},{"id":"semetey-1-2013:p1410:b004:l035","ordinal":183924,"en":"And filled their lean bellies with grass."},{"id":"semetey-1-2013:p1410:b004:l036","ordinal":183925,"en":"Champion Bakai the leopard,"},{"id":"semetey-1-2013:p1410:b004:l037","ordinal":183926,"en":"My saint who knows what to do!"},{"id":"semetey-1-2013:p1410:b004:l038","ordinal":183927,"en":"The whole universe"},{"id":"semetey-1-2013:p1410:b004:l039","ordinal":183928,"en":"Was it not Bakai who divided it,"},{"id":"semetey-1-2013:p1411:b003:l001","ordinal":183929,"en":"Who had traversed this world—"},{"id":"semetey-1-2013:p1411:b003:l002","ordinal":183930,"en":"Was that not Bakai?"},{"id":"semetey-1-2013:p1411:b003:l003","ordinal":183931,"en":"Your uncle, champion Bakai,"},{"id":"semetey-1-2013:p1411:b003:l004","ordinal":183932,"en":"Started awake from sleep,"},{"id":"semetey-1-2013:p1411:b003:l005","ordinal":183933,"en":"Rolling onto his right side,"},{"id":"semetey-1-2013:p1411:b003:l006","ordinal":183934,"en":"Starting awake, he recited a prayer,"},{"id":"semetey-1-2013:p1411:b003:l007","ordinal":183935,"en":"Saddled Kökcholok,"},{"id":"semetey-1-2013:p1411:b003:l008","ordinal":183936,"en":"Readied his arms and armor,"},{"id":"semetey-1-2013:p1411:b003:l009","ordinal":183937,"en":"And girded on his unsheathed sword;"},{"id":"semetey-1-2013:p1411:b003:l010","ordinal":183938,"en":"Fuming in anger,"},{"id":"semetey-1-2013:p1411:b003:l011","ordinal":183939,"en":"Your uncle Bakai the leopard—"},{"id":"semetey-1-2013:p1411:b003:l012","ordinal":183940,"en":"Behold his bloodthirsty fury!"},{"id":"semetey-1-2013:p1411:b003:l013","ordinal":183941,"en":"Your uncle, valiant Bakai,"},{"id":"semetey-1-2013:p1411:b003:l014","ordinal":183942,"en":"Making the ignorant know,"},{"id":"semetey-1-2013:p1411:b003:l015","ordinal":183943,"en":"Making the unperceptive perceive."},{"id":"semetey-1-2013:p1411:b003:l016","ordinal":183944,"en":"Crossing rugged passes,"},{"id":"semetey-1-2013:p1411:b003:l017","ordinal":183945,"en":"Traveling the lone mountain road,"},{"id":"semetey-1-2013:p1411:b003:l018","ordinal":183946,"en":"They journeyed a long while,"},{"id":"semetey-1-2013:p1411:b003:l019","ordinal":183947,"en":"Crossing remarkable passes,"},{"id":"semetey-1-2013:p1411:b003:l020","ordinal":183948,"en":"Ridges, passes, and mountains."},{"id":"semetey-1-2013:p1411:b003:l021","ordinal":183949,"en":"How could your heroes hold back?"},{"id":"semetey-1-2013:p1411:b003:l022","ordinal":183950,"en":"They crossed winding mountains"},{"id":"semetey-1-2013:p1411:b003:l023","ordinal":183951,"en":"And forded winding waters;"},{"id":"semetey-1-2013:p1411:b003:l024","ordinal":183952,"en":"All the heroes grew eager,"},{"id":"semetey-1-2013:p1411:b003:l025","ordinal":183953,"en":"All the coursers grew spirited—"},{"id":"semetey-1-2013:p1411:b003:l026","ordinal":183954,"en":"How could the heroes hold back?"},{"id":"semetey-1-2013:p1411:b003:l027","ordinal":183955,"en":"They reached and halted at"},{"id":"semetey-1-2013:p1411:b003:l028","ordinal":183956,"en":"A gray-hazed yellow steppe."},{"id":"semetey-1-2013:p1411:b003:l029","ordinal":183957,"en":"It was a fine day's journey across."},{"id":"semetey-1-2013:p1411:b003:l030","ordinal":183958,"en":"Your uncle, the gray wolf, had named it"},{"id":"semetey-1-2013:p1411:b003:l031","ordinal":183959,"en":"The Fescue Steppe."},{"id":"semetey-1-2013:p1411:b003:l032","ordinal":183960,"en":"Do not ask what that steppe was like:"},{"id":"semetey-1-2013:p1411:b003:l033","ordinal":183961,"en":"It had no hill the size of an ankle-bone,"},{"id":"semetey-1-2013:p1411:b003:l034","ordinal":183962,"en":"No hollow the size of a saddle,"},{"id":"semetey-1-2013:p1411:b005:l001","ordinal":183963,"en":"No furrow touched by a plow,"},{"id":"semetey-1-2013:p1411:b005:l002","ordinal":183964,"en":"No hole dug by a marmot."},{"id":"semetey-1-2013:p1411:b005:l003","ordinal":183965,"en":"It gleamed without a trace of haze;"},{"id":"semetey-1-2013:p1411:b005:l004","ordinal":183966,"en":"It was the Fescue Steppe,"},{"id":"semetey-1-2013:p1411:b005:l005","ordinal":183967,"en":"Its rich growth waist-deep,"},{"id":"semetey-1-2013:p1411:b005:l006","ordinal":183968,"en":"A place where the people lay at ease."},{"id":"semetey-1-2013:p1411:b005:l007","ordinal":183969,"en":"When they reached that place,"},{"id":"semetey-1-2013:p1411:b005:l008","ordinal":183970,"en":"\"My river and spring in the valley,"},{"id":"semetey-1-2013:p1411:b005:l009","ordinal":183971,"en":"My young champion found late in life!"},{"id":"semetey-1-2013:p1411:b005:l010","ordinal":183972,"en":"Here upon this yellow steppe,"},{"id":"semetey-1-2013:p1411:b005:l011","ordinal":183973,"en":"Let us ride without growing weary;"},{"id":"semetey-1-2013:p1411:b005:l012","ordinal":183974,"en":"Let us race along the road"},{"id":"semetey-1-2013:p1411:b005:l013","ordinal":183975,"en":"And open up the horses' eyes!\""},{"id":"semetey-1-2013:p1411:b005:l014","ordinal":183976,"en":"His uncle Bakai said this,"},{"id":"semetey-1-2013:p1411:b005:l015","ordinal":183977,"en":"And Kökcholok opened his stride."},{"id":"semetey-1-2013:p1411:b005:l016","ordinal":183978,"en":"Dust billowed like a mountain,"},{"id":"semetey-1-2013:p1411:b005:l017","ordinal":183979,"en":"And he quivered as though about to fly;"},{"id":"semetey-1-2013:p1411:b005:l018","ordinal":183980,"en":"Semetey and Bakai raced,"},{"id":"semetey-1-2013:p1411:b005:l019","ordinal":183981,"en":"They grappled with the mouths"},{"id":"semetey-1-2013:p1411:b005:l020","ordinal":183982,"en":"Of the coursers beneath them,"},{"id":"semetey-1-2013:p1411:b005:l021","ordinal":183983,"en":"Making them rear and strain,"},{"id":"semetey-1-2013:p1411:b005:l022","ordinal":183984,"en":"Making them buck as though their riders had died."},{"id":"semetey-1-2013:p1411:b005:l023","ordinal":183985,"en":"How could your heroes hold back?"},{"id":"semetey-1-2013:p1411:b005:l024","ordinal":183986,"en":"At Echoing Jar-Kyya,"},{"id":"semetey-1-2013:p1411:b005:l025","ordinal":183987,"en":"Where a single horse-track wound on,"},{"id":"semetey-1-2013:p1411:b005:l026","ordinal":183988,"en":"Bakai halted there."},{"id":"semetey-1-2013:p1411:b005:l027","ordinal":183989,"en":"Onto the broken, narrow ridge"},{"id":"semetey-1-2013:p1411:b005:l028","ordinal":183990,"en":"Bakai rode his thoroughbred."},{"id":"semetey-1-2013:p1411:b005:l029","ordinal":183991,"en":"Yesterday, your leopard champion Almambet—"},{"id":"semetey-1-2013:p1411:b005:l030","ordinal":183992,"en":"There is the pass of Dust-Whirlwind,"},{"id":"semetey-1-2013:p1411:b005:l031","ordinal":183993,"en":"There is a lake called It-Ichpes."},{"id":"semetey-1-2013:p1411:b005:l032","ordinal":183994,"en":"Holding Lake It-Ichpes,"},{"id":"semetey-1-2013:p1411:b005:l033","ordinal":183995,"en":"There stands on watch Kuuördök,"},{"id":"semetey-1-2013:p1411:b005:l034","ordinal":183996,"en":"May the wretch burn in fire."},{"id":"semetey-1-2013:p1412:b004:l001","ordinal":183997,"en":"May Kongurbai burn to death—"},{"id":"semetey-1-2013:p1412:b004:l002","ordinal":183998,"en":"Kongurbai's watch-post,"},{"id":"semetey-1-2013:p1412:b004:l003","ordinal":183999,"en":"With foxes upon its pass,"},{"id":"semetey-1-2013:p1412:b004:l004","ordinal":184000,"en":"Argali upon its heights,"},{"id":"semetey-1-2013:p1412:b004:l005","ordinal":184001,"en":"And ducks upon its lake;"},{"id":"semetey-1-2013:p1412:b004:l006","ordinal":184002,"en":"That fire-doomed swine's"},{"id":"semetey-1-2013:p1412:b004:l007","ordinal":184003,"en":"Calamity lies in such a place."},{"id":"semetey-1-2013:p1412:b004:l008","ordinal":184004,"en":"The place is famed as Suuk-Tör;"},{"id":"semetey-1-2013:p1412:b004:l009","ordinal":184005,"en":"It has a pass where men take courage,"},{"id":"semetey-1-2013:p1412:b004:l010","ordinal":184006,"en":"A place where they lie entrenched."},{"id":"semetey-1-2013:p1412:b004:l011","ordinal":184007,"en":"The most advantageously placed of his guards,"},{"id":"semetey-1-2013:p1412:b004:l012","ordinal":184008,"en":"The finest of his sentries,"},{"id":"semetey-1-2013:p1412:b004:l013","ordinal":184009,"en":"Is that vile infidel Kuuördök."},{"id":"semetey-1-2013:p1412:b004:l014","ordinal":184010,"en":"If we capture it, my only one,"},{"id":"semetey-1-2013:p1412:b004:l015","ordinal":184011,"en":"God will have granted it to us;"},{"id":"semetey-1-2013:p1412:b004:l016","ordinal":184012,"en":"If the duck escapes,"},{"id":"semetey-1-2013:p1412:b004:l017","ordinal":184013,"en":"May God strike us!"},{"id":"semetey-1-2013:p1412:b004:l018","ordinal":184014,"en":"That fire-doomed Kuuördök"},{"id":"semetey-1-2013:p1412:b004:l019","ordinal":184015,"en":"To the gold-throned pavilion,"},{"id":"semetey-1-2013:p1412:b004:l020","ordinal":184016,"en":"To the great hero Kary Khan,"},{"id":"semetey-1-2013:p1412:b004:l021","ordinal":184017,"en":"Before one can say a word,"},{"id":"semetey-1-2013:p1412:b004:l022","ordinal":184018,"en":"In the blink of an eye,"},{"id":"semetey-1-2013:p1412:b004:l023","ordinal":184019,"en":"That fire-doomed Kuuördök"},{"id":"semetey-1-2013:p1412:b004:l024","ordinal":184020,"en":"A messenger to Beijing,"},{"id":"semetey-1-2013:p1412:b004:l025","ordinal":184021,"en":"Scurrying like an ant,"},{"id":"semetey-1-2013:p1412:b004:l026","ordinal":184022,"en":"China's army would come swarming."},{"id":"semetey-1-2013:p1412:b004:l027","ordinal":184023,"en":"Look at the reeds, look at the flood;"},{"id":"semetey-1-2013:p1412:b004:l028","ordinal":184024,"en":"If China is roused to anger,"},{"id":"semetey-1-2013:p1412:b004:l029","ordinal":184025,"en":"Look at the people who will engulf us!"},{"id":"semetey-1-2013:p1412:b004:l030","ordinal":184026,"en":"There will be deep, thick-dug trenches,"},{"id":"semetey-1-2013:p1412:b004:l031","ordinal":184027,"en":"And multitudes from Kangai."},{"id":"semetey-1-2013:p1412:b004:l032","ordinal":184028,"en":"They cannot match me in a contest,"},{"id":"semetey-1-2013:p1412:b004:l033","ordinal":184029,"en":"Nor defeat me in battle!"},{"id":"semetey-1-2013:p1412:b004:l034","ordinal":184030,"en":"That fire-doomed swine's"},{"id":"semetey-1-2013:p1412:b004:l035","ordinal":184031,"en":"That duck is a sharp-eyed scout;"},{"id":"semetey-1-2013:p1412:b004:l036","ordinal":184032,"en":"If Kuuördök reaches Beijing,"},{"id":"semetey-1-2013:p1412:b004:l037","ordinal":184033,"en":"It will spread the news in every direction."},{"id":"semetey-1-2013:p1412:b005:l001","ordinal":184034,"en":"Its wing is fierce and formidable,"},{"id":"semetey-1-2013:p1412:b005:l002","ordinal":184035,"en":"And it has the habit"},{"id":"semetey-1-2013:p1412:b005:l003","ordinal":184036,"en":"Of cutting down whatever it faces."},{"id":"semetey-1-2013:p1412:b005:l004","ordinal":184037,"en":"It has lords and it has a khan;"},{"id":"semetey-1-2013:p1412:b005:l005","ordinal":184038,"en":"In that great city of Beijing"},{"id":"semetey-1-2013:p1412:b005:l006","ordinal":184039,"en":"Are marvels beyond all hearing!"},{"id":"semetey-1-2013:p1412:b005:l007","ordinal":184040,"en":"If that duck catches sight of us,"},{"id":"semetey-1-2013:p1412:b005:l008","ordinal":184041,"en":"It will carry the news to Beijing."},{"id":"semetey-1-2013:p1412:b005:l009","ordinal":184042,"en":"Understand all that I have told you;"},{"id":"semetey-1-2013:p1412:b005:l010","ordinal":184043,"en":"My precious son, heed my words!"},{"id":"semetey-1-2013:p1412:b005:l011","ordinal":184044,"en":"The honored Kalcha is a great lord;"},{"id":"semetey-1-2013:p1412:b005:l012","ordinal":184045,"en":"If that infidel is roused to anger,"},{"id":"semetey-1-2013:p1412:b005:l013","ordinal":184046,"en":"He will sweep out from Kakan!"},{"id":"semetey-1-2013:p1412:b005:l014","ordinal":184047,"en":"These are no people to trust."},{"id":"semetey-1-2013:p1412:b005:l015","ordinal":184048,"en":"This Beijing before us"},{"id":"semetey-1-2013:p1412:b005:l016","ordinal":184049,"en":"Has might and has a city;"},{"id":"semetey-1-2013:p1412:b005:l017","ordinal":184050,"en":"In mighty Beijing"},{"id":"semetey-1-2013:p1412:b005:l018","ordinal":184051,"en":"Are all the fiercest forces!\""},{"id":"semetey-1-2013:p1412:b005:l019","ordinal":184052,"en":"Old Bakai said:"},{"id":"semetey-1-2013:p1412:b005:l020","ordinal":184053,"en":"\"Scout the upper side well!"},{"id":"semetey-1-2013:p1412:b005:l021","ordinal":184054,"en":"If we catch the duck,"},{"id":"semetey-1-2013:p1412:b005:l022","ordinal":184055,"en":"We shall set our trouble right;"},{"id":"semetey-1-2013:p1412:b005:l023","ordinal":184056,"en":"If we pray to the Creator,"},{"id":"semetey-1-2013:p1412:b005:l024","ordinal":184057,"en":"My young champion found late in life,"},{"id":"semetey-1-2013:p1412:b005:l025","ordinal":184058,"en":"We shall contrive to take their duck!\""},{"id":"semetey-1-2013:p1412:b005:l026","ordinal":184059,"en":"At the pass of It-Kyian,"},{"id":"semetey-1-2013:p1412:b005:l027","ordinal":184060,"en":"After Bakai spoke these words,"},{"id":"semetey-1-2013:p1412:b005:l028","ordinal":184061,"en":"They went up to the duck's watch-lake,"},{"id":"semetey-1-2013:p1412:b005:l029","ordinal":184062,"en":"To the reeds upon the lake's surface,"},{"id":"semetey-1-2013:p1412:b005:l030","ordinal":184063,"en":"Which the Chinese call Bangpang."},{"id":"semetey-1-2013:p1412:b005:l031","ordinal":184064,"en":"When they came out and looked"}]
