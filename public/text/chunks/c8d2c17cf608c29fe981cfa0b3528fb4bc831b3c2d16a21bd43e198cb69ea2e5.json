[{"id":"semetey-1-2013:p1263:b003:l010","ordinal":172545,"en":"From their spear no foe escaped."},{"id":"semetey-1-2013:p1263:b003:l011","ordinal":172546,"en":"Driving their heroes forward,"},{"id":"semetey-1-2013:p1263:b003:l012","ordinal":172547,"en":"They came out in chosen array;"},{"id":"semetey-1-2013:p1263:b003:l013","ordinal":172548,"en":"Their valiant men at the front,"},{"id":"semetey-1-2013:p1263:b003:l014","ordinal":172549,"en":"They came out glittering."},{"id":"semetey-1-2013:p1263:b003:l015","ordinal":172550,"en":"Hero Toltoi was a valiant man;"},{"id":"semetey-1-2013:p1263:b003:l016","ordinal":172551,"en":"From the rear of the Jediger"},{"id":"semetey-1-2013:p1263:b003:l017","ordinal":172552,"en":"He drove them out and came on."},{"id":"semetey-1-2013:p1263:b003:l018","ordinal":172553,"en":"Chynkojo, son of Shygai,"},{"id":"semetey-1-2013:p1263:b003:l019","ordinal":172554,"en":"Had unleashed havoc,"},{"id":"semetey-1-2013:p1263:b003:l020","ordinal":172555,"en":"Beating the great host"},{"id":"semetey-1-2013:p1263:b003:l021","ordinal":172556,"en":"And driving it without letting it flee."},{"id":"semetey-1-2013:p1263:b003:l022","ordinal":172557,"en":"When they saw the wrath of these men,"},{"id":"semetey-1-2013:p1263:b003:l023","ordinal":172558,"en":"The many Black Jediger"},{"id":"semetey-1-2013:p1263:b003:l024","ordinal":172559,"en":"Had no strength to flee."},{"id":"semetey-1-2013:p1263:b003:l025","ordinal":172560,"en":"Putting on their shields,"},{"id":"semetey-1-2013:p1263:b003:l026","ordinal":172561,"en":"Committing themselves to fate,"},{"id":"semetey-1-2013:p1263:b003:l027","ordinal":172562,"en":"They fitted their oroipo bullets;"},{"id":"semetey-1-2013:p1263:b003:l028","ordinal":172563,"en":"The Jediger of the Seven Valleys"},{"id":"semetey-1-2013:p1263:b003:l029","ordinal":172564,"en":"Covered the land all together."},{"id":"semetey-1-2013:p1263:b003:l030","ordinal":172565,"en":"The host divided into hundreds,"},{"id":"semetey-1-2013:p1263:b003:l031","ordinal":172566,"en":"Looking ready to run forward;"},{"id":"semetey-1-2013:p1263:b003:l032","ordinal":172567,"en":"The host divided into thousands,"},{"id":"semetey-1-2013:p1263:b003:l033","ordinal":172568,"en":"Looking ready to overwhelm."},{"id":"semetey-1-2013:p1263:b003:l034","ordinal":172569,"en":"They shouted their battle cries,"},{"id":"semetey-1-2013:p1263:b003:l035","ordinal":172570,"en":"Dust billowing to the sky;"},{"id":"semetey-1-2013:p1263:b003:l036","ordinal":172571,"en":"Their heroes grew excited,"},{"id":"semetey-1-2013:p1263:b003:l037","ordinal":172572,"en":"Spurring their sluggish horses."},{"id":"semetey-1-2013:p1263:b003:l038","ordinal":172573,"en":"The Jediger now covered"},{"id":"semetey-1-2013:p1263:b003:l039","ordinal":172574,"en":"The many Black Afghans;"},{"id":"semetey-1-2013:p1263:b004:l001","ordinal":172575,"en":"If allowed to go unanswered,"},{"id":"semetey-1-2013:p1263:b004:l002","ordinal":172576,"en":"They would reach their very roots,"},{"id":"semetey-1-2013:p1263:b004:l003","ordinal":172577,"en":"Shatter the stone fortress,"},{"id":"semetey-1-2013:p1263:b004:l004","ordinal":172578,"en":"And slaughter them utterly."},{"id":"semetey-1-2013:p1263:b004:l005","ordinal":172579,"en":"They would make the meek ones wail"},{"id":"semetey-1-2013:p1263:b004:l006","ordinal":172580,"en":"And offer them as sacrifice."},{"id":"semetey-1-2013:p1263:b004:l007","ordinal":172581,"en":"They would seize their daughters for pleasure;"},{"id":"semetey-1-2013:p1263:b004:l008","ordinal":172582,"en":"If the Jediger had their way,"},{"id":"semetey-1-2013:p1263:b004:l009","ordinal":172583,"en":"They came to wreak slaughter"},{"id":"semetey-1-2013:p1263:b004:l010","ordinal":172584,"en":"And bring devastation upon Afghanistan."},{"id":"semetey-1-2013:p1263:b004:l011","ordinal":172585,"en":"The strong man’s day had dawned;"},{"id":"semetey-1-2013:p1263:b004:l012","ordinal":172586,"en":"As though setting out on campaign against China,"},{"id":"semetey-1-2013:p1263:b004:l013","ordinal":172587,"en":"He had bound his head awry."},{"id":"semetey-1-2013:p1263:b004:l014","ordinal":172588,"en":"Chynkojo was a corrupter;"},{"id":"semetey-1-2013:p1263:b004:l015","ordinal":172589,"en":"His day had dawned."},{"id":"semetey-1-2013:p1263:b004:l016","ordinal":172590,"en":"While matters stood this way,"},{"id":"semetey-1-2013:p1263:b004:l017","ordinal":172591,"en":"Blue-gray mist parted in the sky;"},{"id":"semetey-1-2013:p1263:b004:l018","ordinal":172592,"en":"With a piercing shout, a myriad host—"},{"id":"semetey-1-2013:p1263:b004:l019","ordinal":172593,"en":"Chynkojo’s army appeared."},{"id":"semetey-1-2013:p1263:b004:l020","ordinal":172594,"en":"If no one drove them back,"},{"id":"semetey-1-2013:p1263:b004:l021","ordinal":172595,"en":"They would simply overrun the land,"},{"id":"semetey-1-2013:p1263:b004:l022","ordinal":172596,"en":"Bring turmoil upon this poor head,"},{"id":"semetey-1-2013:p1263:b004:l023","ordinal":172597,"en":"And reach the very root;"},{"id":"semetey-1-2013:p1263:b004:l024","ordinal":172598,"en":"They would overwhelm and carry off"},{"id":"semetey-1-2013:p1263:b004:l025","ordinal":172599,"en":"Chürök, daughter of Akun."},{"id":"semetey-1-2013:p1263:b004:l026","ordinal":172600,"en":"Men swarmed in rage,"},{"id":"semetey-1-2013:p1263:b004:l027","ordinal":172601,"en":"Soldiers teemed everywhere;"},{"id":"semetey-1-2013:p1263:b004:l028","ordinal":172602,"en":"A myriad host came"},{"id":"semetey-1-2013:p1263:b004:l029","ordinal":172603,"en":"To cover Khan Akun’s fortress."},{"id":"semetey-1-2013:p1263:b004:l030","ordinal":172604,"en":"Their thick-armed wrestlers,"},{"id":"semetey-1-2013:p1263:b004:l031","ordinal":172605,"en":"The snarling Jediger,"},{"id":"semetey-1-2013:p1263:b004:l032","ordinal":172606,"en":"Advanced and covered the front."},{"id":"semetey-1-2013:p1263:b004:l033","ordinal":172607,"en":"When the many Black Jediger"},{"id":"semetey-1-2013:p1263:b004:l034","ordinal":172608,"en":"Were about to overwhelm and carry them off,"},{"id":"semetey-1-2013:p1263:b004:l035","ordinal":172609,"en":"Black blood flowing in torrents,"},{"id":"semetey-1-2013:p1263:b004:l036","ordinal":172610,"en":"And the people turning back to cross,"},{"id":"semetey-1-2013:p1263:b004:l037","ordinal":172611,"en":"A coat of mail with golden collar"},{"id":"semetey-1-2013:p1263:b004:l038","ordinal":172612,"en":"Glittered upon a breast;"},{"id":"semetey-1-2013:p1263:b004:l039","ordinal":172613,"en":"The gray kise that fell from heaven,"},{"id":"semetey-1-2013:p1264:b003:l001","ordinal":172614,"en":"A kise that befriended the dear soul,"},{"id":"semetey-1-2013:p1264:b003:l002","ordinal":172615,"en":"When he shouted and buckled it at his waist,"},{"id":"semetey-1-2013:p1264:b003:l003","ordinal":172616,"en":"The Forty Saints became his companions."},{"id":"semetey-1-2013:p1264:b003:l004","ordinal":172617,"en":"When he cried aloud and buckled it on,"},{"id":"semetey-1-2013:p1264:b003:l005","ordinal":172618,"en":"Before the valiant hero"},{"id":"semetey-1-2013:p1264:b003:l006","ordinal":172619,"en":"A lion came roaming."},{"id":"semetey-1-2013:p1264:b003:l007","ordinal":172620,"en":"The gray kise that fell from heaven,"},{"id":"semetey-1-2013:p1264:b003:l008","ordinal":172621,"en":"From his father, gray-wolf Manas,"},{"id":"semetey-1-2013:p1264:b003:l009","ordinal":172622,"en":"A companion-kise left especially to him."},{"id":"semetey-1-2013:p1264:b003:l010","ordinal":172623,"en":"The gray kise that went with him"},{"id":"semetey-1-2013:p1264:b003:l011","ordinal":172624,"en":"To unleash relentless havoc."},{"id":"semetey-1-2013:p1264:b003:l012","ordinal":172625,"en":"Yesterday, when your valiant mother Kanykei"},{"id":"semetey-1-2013:p1264:b003:l013","ordinal":172626,"en":"Fled toward Bukhara,"},{"id":"semetey-1-2013:p1264:b003:l014","ordinal":172627,"en":"When her wealth was scattered,"},{"id":"semetey-1-2013:p1264:b003:l015","ordinal":172628,"en":"Saying, “May my valiant son Semetey"},{"id":"semetey-1-2013:p1264:b003:l016","ordinal":172629,"en":"Take this along as a gift,”"},{"id":"semetey-1-2013:p1264:b003:l017","ordinal":172630,"en":"Grieving and weeping in sorrow,"},{"id":"semetey-1-2013:p1264:b003:l018","ordinal":172631,"en":"She girded it against her inner flesh—"},{"id":"semetey-1-2013:p1264:b003:l019","ordinal":172632,"en":"This was the kise she took with her."},{"id":"semetey-1-2013:p1264:b003:l020","ordinal":172633,"en":"Weeping bitterly to the one God,"},{"id":"semetey-1-2013:p1264:b003:l021","ordinal":172634,"en":"Destining it for Semetey,"},{"id":"semetey-1-2013:p1264:b003:l022","ordinal":172635,"en":"She took along the gray kise."},{"id":"semetey-1-2013:p1264:b003:l023","ordinal":172636,"en":"When over Akolpok"},{"id":"semetey-1-2013:p1264:b003:l024","ordinal":172637,"en":"He buckled the gray kise,"},{"id":"semetey-1-2013:p1264:b003:l025","ordinal":172638,"en":"The sight stirred the heart;"},{"id":"semetey-1-2013:p1264:b003:l026","ordinal":172639,"en":"He looked like a lion."},{"id":"semetey-1-2013:p1264:b003:l027","ordinal":172640,"en":"A black-mottled leopard"},{"id":"semetey-1-2013:p1264:b003:l028","ordinal":172641,"en":"Raged at his flank,"},{"id":"semetey-1-2013:p1264:b003:l029","ordinal":172642,"en":"And a stunted gray-wolf lion"},{"id":"semetey-1-2013:p1264:b003:l030","ordinal":172643,"en":"Was found as his companion."},{"id":"semetey-1-2013:p1264:b003:l031","ordinal":172644,"en":"From his mouth blue flame"},{"id":"semetey-1-2013:p1264:b003:l032","ordinal":172645,"en":"Poured like a loaded gun;"},{"id":"semetey-1-2013:p1264:b003:l033","ordinal":172646,"en":"His dear teeth, broad as a gate,"},{"id":"semetey-1-2013:p1264:b003:l034","ordinal":172647,"en":"Showed apart like grains of millet."},{"id":"semetey-1-2013:p1264:b003:l035","ordinal":172648,"en":"The breath leaving his nostrils"},{"id":"semetey-1-2013:p1264:b003:l036","ordinal":172649,"en":"Was like burning red embers;"},{"id":"semetey-1-2013:p1264:b003:l037","ordinal":172650,"en":"His two eyes flamed,"},{"id":"semetey-1-2013:p1264:b003:l038","ordinal":172651,"en":"Fire that could burn all away."},{"id":"semetey-1-2013:p1264:b003:l039","ordinal":172652,"en":"Generation after generation,"},{"id":"semetey-1-2013:p1264:b004:l001","ordinal":172653,"en":"He came from a blood-drinking line,"},{"id":"semetey-1-2013:p1264:b004:l002","ordinal":172654,"en":"Setting grassy ground alight,"},{"id":"semetey-1-2013:p1264:b004:l003","ordinal":172655,"en":"Setting fire to meadowland."},{"id":"semetey-1-2013:p1264:b004:l004","ordinal":172656,"en":"From Manas, gone to the other world,"},{"id":"semetey-1-2013:p1264:b004:l005","ordinal":172657,"en":"Semetey was born to surpass him;"},{"id":"semetey-1-2013:p1264:b004:l006","ordinal":172658,"en":"When fury seized him,"},{"id":"semetey-1-2013:p1264:b004:l007","ordinal":172659,"en":"His face utterly changed."},{"id":"semetey-1-2013:p1264:b004:l008","ordinal":172660,"en":"The gray wolf’s courage overflowed,"},{"id":"semetey-1-2013:p1264:b004:l009","ordinal":172661,"en":"And his blood-drinking aspect appeared."},{"id":"semetey-1-2013:p1264:b004:l010","ordinal":172662,"en":"When hardship pressed a living soul,"},{"id":"semetey-1-2013:p1264:b004:l011","ordinal":172663,"en":"He took whatever he faced;"},{"id":"semetey-1-2013:p1264:b004:l012","ordinal":172664,"en":"When he struck in fury,"},{"id":"semetey-1-2013:p1264:b004:l013","ordinal":172665,"en":"Heads were cut away;"},{"id":"semetey-1-2013:p1264:b004:l014","ordinal":172666,"en":"For anyone who came against him,"},{"id":"semetey-1-2013:p1264:b004:l015","ordinal":172667,"en":"Death arrived needlessly."},{"id":"semetey-1-2013:p1264:b004:l016","ordinal":172668,"en":"Of the six sharp blades fallen from heaven,"},{"id":"semetey-1-2013:p1264:b004:l017","ordinal":172669,"en":"The keenest sword"},{"id":"semetey-1-2013:p1264:b004:l018","ordinal":172670,"en":"Was Zulpukor, taken by Manas."},{"id":"semetey-1-2013:p1264:b004:l019","ordinal":172671,"en":"When his father Manas died,"},{"id":"semetey-1-2013:p1264:b004:l020","ordinal":172672,"en":"When Kanykei suffered plunder,"},{"id":"semetey-1-2013:p1264:b004:l021","ordinal":172673,"en":"Into the hands of the six villains"},{"id":"semetey-1-2013:p1264:b004:l022","ordinal":172674,"en":"Zulpukor fell as spoil."},{"id":"semetey-1-2013:p1264:b004:l023","ordinal":172675,"en":"The heroic orphan of Khan Manas"},{"id":"semetey-1-2013:p1264:b004:l024","ordinal":172676,"en":"Grew to manhood while orphaned,"},{"id":"semetey-1-2013:p1264:b004:l025","ordinal":172677,"en":"Rejoined his own land,"},{"id":"semetey-1-2013:p1264:b004:l026","ordinal":172678,"en":"Grew imposing and became a hero,"},{"id":"semetey-1-2013:p1264:b004:l027","ordinal":172679,"en":"Equal to the sons of the people."},{"id":"semetey-1-2013:p1264:b004:l028","ordinal":172680,"en":"When he came and saw his people,"},{"id":"semetey-1-2013:p1264:b004:l029","ordinal":172681,"en":"When he came to Abyke,"},{"id":"semetey-1-2013:p1264:b004:l030","ordinal":172682,"en":"At Köbösh’s palace,"},{"id":"semetey-1-2013:p1264:b004:l031","ordinal":172683,"en":"Had he not unleashed"},{"id":"semetey-1-2013:p1264:b004:l032","ordinal":172684,"en":"Surpassing havoc?"},{"id":"semetey-1-2013:p1264:b004:l033","ordinal":172685,"en":"Saying, “This is the treasure left by my father,”"},{"id":"semetey-1-2013:p1264:b004:l034","ordinal":172686,"en":"Had not the valiant prince Semetey"},{"id":"semetey-1-2013:p1264:b004:l035","ordinal":172687,"en":"Seized it back?"},{"id":"semetey-1-2013:p1264:b004:l036","ordinal":172688,"en":"Zulpukor, left as a gift"},{"id":"semetey-1-2013:p1264:b004:l037","ordinal":172689,"en":"By valiant gray-wolf Manas—"},{"id":"semetey-1-2013:p1264:b004:l038","ordinal":172690,"en":"When drawn from its sheath with a cry,"},{"id":"semetey-1-2013:p1264:b004:l039","ordinal":172691,"en":"It never went idle without drinking blood."},{"id":"semetey-1-2013:p1265:b003:l001","ordinal":172692,"en":"Unless it drank its fill of blood,"},{"id":"semetey-1-2013:p1265:b003:l002","ordinal":172693,"en":"It did not return to the sheath."},{"id":"semetey-1-2013:p1265:b003:l003","ordinal":172694,"en":"When swung, it lengthened;"},{"id":"semetey-1-2013:p1265:b003:l004","ordinal":172695,"en":"Its edge reddened like an ember."},{"id":"semetey-1-2013:p1265:b003:l005","ordinal":172696,"en":"It did not recoil from stone,"},{"id":"semetey-1-2013:p1265:b003:l006","ordinal":172697,"en":"And when struck in fury,"},{"id":"semetey-1-2013:p1265:b003:l007","ordinal":172698,"en":"It did not turn back from iron."},{"id":"semetey-1-2013:p1265:b003:l008","ordinal":172699,"en":"When Manas held dominion"},{"id":"semetey-1-2013:p1265:b003:l009","ordinal":172700,"en":"Across the surface of the earth,"},{"id":"semetey-1-2013:p1265:b003:l010","ordinal":172701,"en":"Whoever stirred his anger,"},{"id":"semetey-1-2013:p1265:b003:l011","ordinal":172702,"en":"Manas did not let escape before him."},{"id":"semetey-1-2013:p1265:b003:l012","ordinal":172703,"en":"While ravenous Manas lived,"},{"id":"semetey-1-2013:p1265:b003:l013","ordinal":172704,"en":"From blessed gray-wolf Manas"},{"id":"semetey-1-2013:p1265:b003:l014","ordinal":172705,"en":"It hardened, sated with blood,"},{"id":"semetey-1-2013:p1265:b003:l015","ordinal":172706,"en":"And became renowned as Zulpukor."},{"id":"semetey-1-2013:p1265:b003:l016","ordinal":172707,"en":"Its edge was steel, its sheath keen—"},{"id":"semetey-1-2013:p1265:b003:l017","ordinal":172708,"en":"That single treasure inherited"},{"id":"semetey-1-2013:p1265:b003:l018","ordinal":172709,"en":"From his father, gray-wolf Manas,"},{"id":"semetey-1-2013:p1265:b003:l019","ordinal":172710,"en":"To draw while facing"},{"id":"semetey-1-2013:p1265:b003:l020","ordinal":172711,"en":"Khojo who challenged him;"},{"id":"semetey-1-2013:p1265:b003:l021","ordinal":172712,"en":"The lion, if strength allowed,"},{"id":"semetey-1-2013:p1265:b003:l022","ordinal":172713,"en":"Would hew down with the sword"},{"id":"semetey-1-2013:p1265:b003:l023","ordinal":172714,"en":"Khojo who came to confront him,"},{"id":"semetey-1-2013:p1265:b003:l024","ordinal":172715,"en":"Slaughter his people,"},{"id":"semetey-1-2013:p1265:b003:l025","ordinal":172716,"en":"And unleash mighty conflict,"},{"id":"semetey-1-2013:p1265:b003:l026","ordinal":172717,"en":"Taking undying vengeance"},{"id":"semetey-1-2013:p1265:b003:l027","ordinal":172718,"en":"Upon Khojo, who attacked first."},{"id":"semetey-1-2013:p1265:b003:l028","ordinal":172719,"en":"At his courage, the Afghans"},{"id":"semetey-1-2013:p1265:b003:l029","ordinal":172720,"en":"Fled in a clattering rout."},{"id":"semetey-1-2013:p1265:b003:l030","ordinal":172721,"en":"The sight stirred the heart;"},{"id":"semetey-1-2013:p1265:b003:l031","ordinal":172722,"en":"That gray wolf’s only son"},{"id":"semetey-1-2013:p1265:b003:l032","ordinal":172723,"en":"Revealed the aspect of a lion."},{"id":"semetey-1-2013:p1265:b003:l033","ordinal":172724,"en":"High-browed and stone-hearted,"},{"id":"semetey-1-2013:p1265:b003:l034","ordinal":172725,"en":"He brought the Jediger great turmoil."},{"id":"semetey-1-2013:p1265:b003:l035","ordinal":172726,"en":"Akkelte at his shoulder—"},{"id":"semetey-1-2013:p1265:b003:l036","ordinal":172727,"en":"When the blessed weapon was slung on,"},{"id":"semetey-1-2013:p1265:b003:l037","ordinal":172728,"en":"It was a mirror upon the shoulder;"},{"id":"semetey-1-2013:p1265:b003:l038","ordinal":172729,"en":"When fired into clashing battle,"},{"id":"semetey-1-2013:p1265:b003:l039","ordinal":172730,"en":"It was comfort for the entrusted life."},{"id":"semetey-1-2013:p1265:b005:l001","ordinal":172731,"en":"In sport it was Ochogor,"},{"id":"semetey-1-2013:p1265:b005:l002","ordinal":172732,"en":"In earnest it was Koichagyr;"},{"id":"semetey-1-2013:p1265:b005:l003","ordinal":172733,"en":"When he turned and fired, it broke ranks."},{"id":"semetey-1-2013:p1265:b005:l004","ordinal":172734,"en":"Akkelte had a nature all its own."},{"id":"semetey-1-2013:p1265:b005:l005","ordinal":172735,"en":"That was the joined iron weapon,"},{"id":"semetey-1-2013:p1265:b005:l006","ordinal":172736,"en":"The treasure left as a gift"},{"id":"semetey-1-2013:p1265:b005:l007","ordinal":172737,"en":"By valiant Sultan Manas."},{"id":"semetey-1-2013:p1265:b005:l008","ordinal":172738,"en":"Its voice thundered unlike any other;"},{"id":"semetey-1-2013:p1265:b005:l009","ordinal":172739,"en":"No mortal faced it and came on."},{"id":"semetey-1-2013:p1265:b005:l010","ordinal":172740,"en":"When he heard Akkelte’s voice,"},{"id":"semetey-1-2013:p1265:b005:l011","ordinal":172741,"en":"Kongurbai of Kakan scattered all his wealth"},{"id":"semetey-1-2013:p1265:b005:l012","ordinal":172742,"en":"And fled all the way"},{"id":"semetey-1-2013:p1265:b005:l013","ordinal":172743,"en":"To Beijing."},{"id":"semetey-1-2013:p1265:b005:l014","ordinal":172744,"en":"Wrapped with agyinek,"},{"id":"semetey-1-2013:p1265:b005:l015","ordinal":172745,"en":"When there was a foe to fight,"},{"id":"semetey-1-2013:p1265:b005:l016","ordinal":172746,"en":"It was fitted and destined for him."},{"id":"semetey-1-2013:p1265:b005:l017","ordinal":172747,"en":"Almabash, surpassingly keen iron,"},{"id":"semetey-1-2013:p1265:b005:l018","ordinal":172748,"en":"Made no distinction between far and near;"},{"id":"semetey-1-2013:p1265:b005:l019","ordinal":172749,"en":"In the hardest battle,"},{"id":"semetey-1-2013:p1265:b005:l020","ordinal":172750,"en":"It did not fail for sixty days."},{"id":"semetey-1-2013:p1265:b005:l021","ordinal":172751,"en":"Yesterday, while bloodthirsty Manas lived,"},{"id":"semetey-1-2013:p1265:b005:l022","ordinal":172752,"en":"Before lion Bakai,"},{"id":"semetey-1-2013:p1265:b005:l023","ordinal":172753,"en":"Your uncle Lord Bakai—"},{"id":"semetey-1-2013:p1265:b005:l024","ordinal":172754,"en":"Behold his lordly nature—"},{"id":"semetey-1-2013:p1265:b005:l025","ordinal":172755,"en":"On a plain flat as a blade, without mountains,"},{"id":"semetey-1-2013:p1265:b005:l026","ordinal":172756,"en":"At the great Russian city,"},{"id":"semetey-1-2013:p1265:b005:l027","ordinal":172757,"en":"Your uncle lion Bakai"},{"id":"semetey-1-2013:p1265:b005:l028","ordinal":172758,"en":"Was imposing his tribute."},{"id":"semetey-1-2013:p1265:b005:l029","ordinal":172759,"en":"The Russians caused immense devastation"},{"id":"semetey-1-2013:p1265:b005:l030","ordinal":172760,"en":"And stole from Bakai"},{"id":"semetey-1-2013:p1265:b005:l031","ordinal":172761,"en":"His treasury."},{"id":"semetey-1-2013:p1265:b005:l032","ordinal":172762,"en":"Hero Manas, whom he had brought,"},{"id":"semetey-1-2013:p1265:b005:l033","ordinal":172763,"en":"And dear, distinguished Bakai"},{"id":"semetey-1-2013:p1265:b005:l034","ordinal":172764,"en":"Surrounded the Russians."},{"id":"semetey-1-2013:p1265:b005:l035","ordinal":172765,"en":"Saying, “Submit to what we demand;"},{"id":"semetey-1-2013:p1265:b005:l036","ordinal":172766,"en":"You have taken the treasury."},{"id":"semetey-1-2013:p1265:b005:l037","ordinal":172767,"en":"Without conflict or quarrel,"},{"id":"semetey-1-2013:p1265:b005:l038","ordinal":172768,"en":"Give us Akkelte."},{"id":"semetey-1-2013:p1265:b005:l039","ordinal":172769,"en":"I was alone; now I am many,"},{"id":"semetey-1-2013:p1266:b003:l001","ordinal":172770,"en":"I was weak; now I am a hero."},{"id":"semetey-1-2013:p1266:b003:l002","ordinal":172771,"en":"Submit to what we demand"},{"id":"semetey-1-2013:p1266:b003:l003","ordinal":172772,"en":"And give us Akkelte!”"},{"id":"semetey-1-2013:p1266:b003:l004","ordinal":172773,"en":"Against Kerke, khan of the Russians,"},{"id":"semetey-1-2013:p1266:b003:l005","ordinal":172774,"en":"They brought overwhelming force;"},{"id":"semetey-1-2013:p1266:b003:l006","ordinal":172775,"en":"Saying, “Give us Akkelte,”"},{"id":"semetey-1-2013:p1266:b003:l007","ordinal":172776,"en":"Lion Bakai the leopard"},{"id":"semetey-1-2013:p1266:b003:l008","ordinal":172777,"en":"Pressed the siege hard."},{"id":"semetey-1-2013:p1266:b003:l009","ordinal":172778,"en":"Wise Khan Kerke"},{"id":"semetey-1-2013:p1266:b003:l010","ordinal":172779,"en":"Was struck by mighty God;"},{"id":"semetey-1-2013:p1266:b003:l011","ordinal":172780,"en":"Akkelte, which they came to ask for—"},{"id":"semetey-1-2013:p1266:b003:l012","ordinal":172781,"en":"He devised a way not to give it."},{"id":"semetey-1-2013:p1266:b003:l013","ordinal":172782,"en":"Speaking drawn-out words,"},{"id":"semetey-1-2013:p1266:b003:l014","ordinal":172783,"en":"Offering evasive excuses,"},{"id":"semetey-1-2013:p1266:b003:l015","ordinal":172784,"en":"He delayed them."},{"id":"semetey-1-2013:p1266:b003:l016","ordinal":172785,"en":"Saying, “Take it after six months,”"},{"id":"semetey-1-2013:p1266:b003:l017","ordinal":172786,"en":"He set the time far off."},{"id":"semetey-1-2013:p1266:b003:l018","ordinal":172787,"en":"Sixty Russian surveyors"},{"id":"semetey-1-2013:p1266:b003:l019","ordinal":172788,"en":"Had gone on patrol for six months."},{"id":"semetey-1-2013:p1266:b003:l020","ordinal":172789,"en":"“Count the days,"},{"id":"semetey-1-2013:p1266:b003:l021","ordinal":172790,"en":"Record the days in writing;"},{"id":"semetey-1-2013:p1266:b003:l022","ordinal":172791,"en":"Return after six months,"},{"id":"semetey-1-2013:p1266:b003:l023","ordinal":172792,"en":"And then receive your answer!”"},{"id":"semetey-1-2013:p1266:b003:l024","ordinal":172793,"en":"Hearing such words from Kerke,"},{"id":"semetey-1-2013:p1266:b003:l025","ordinal":172794,"en":"Hearing, “After six months,"},{"id":"semetey-1-2013:p1266:b003:l026","ordinal":172795,"en":"Come and take Akkelte,”"},{"id":"semetey-1-2013:p1266:b003:l027","ordinal":172796,"en":"They attacked the Russians,"},{"id":"semetey-1-2013:p1266:b003:l028","ordinal":172797,"en":"Shattered their palace city,"},{"id":"semetey-1-2013:p1266:b003:l029","ordinal":172798,"en":"And raided it there."},{"id":"semetey-1-2013:p1266:b003:l030","ordinal":172799,"en":"In fury they made ready,"},{"id":"semetey-1-2013:p1266:b003:l031","ordinal":172800,"en":"All the bloodthirsty heroes devised a plan"}]
