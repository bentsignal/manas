[{"id":"semetey-1-2013:p0096:b004:l024","ordinal":84225,"en":"Was it not resourceful Bakai?"},{"id":"semetey-1-2013:p0096:b004:l025","ordinal":84226,"en":"The gray steed beneath him—"},{"id":"semetey-1-2013:p0096:b004:l026","ordinal":84227,"en":"He hurried to saddle the charger."},{"id":"semetey-1-2013:p0096:b004:l027","ordinal":84228,"en":"Thinking, ‘This precious soul needs it,’"},{"id":"semetey-1-2013:p0096:b004:l028","ordinal":84229,"en":"Khan Bakai held"},{"id":"semetey-1-2013:p0096:b004:l029","ordinal":84230,"en":"Semetey, though still a child,"},{"id":"semetey-1-2013:p0096:b004:l030","ordinal":84231,"en":"His kinsman whose cradle was a leg."},{"id":"semetey-1-2013:p0096:b004:l031","ordinal":84232,"en":"Hurrying and bustling, hero Bakai,"},{"id":"semetey-1-2013:p0096:b004:l032","ordinal":84233,"en":"On the gray steed beneath him,"},{"id":"semetey-1-2013:p0096:b004:l033","ordinal":84234,"en":"Pulled the rear girth tight"},{"id":"semetey-1-2013:p0096:b004:l034","ordinal":84235,"en":"And shortened the crupper."},{"id":"semetey-1-2013:p0096:b004:l035","ordinal":84236,"en":"The gray coat that no bullet pierced,"},{"id":"semetey-1-2013:p0096:b004:l036","ordinal":84237,"en":"Your hero Bakai the leopard"},{"id":"semetey-1-2013:p0096:b004:l037","ordinal":84238,"en":"Took again and folded together."},{"id":"semetey-1-2013:p0096:b004:l038","ordinal":84239,"en":"The leather trousers and large boots"},{"id":"semetey-1-2013:p0096:b004:l039","ordinal":84240,"en":"He folded inside and entrusted,"},{"id":"semetey-1-2013:p0097:b003:l001","ordinal":84241,"en":"Gripping and fastening them firmly,"},{"id":"semetey-1-2013:p0097:b003:l002","ordinal":84242,"en":"Your khan Bakai the leopard"},{"id":"semetey-1-2013:p0097:b003:l003","ordinal":84243,"en":"Secured them to the saddle straps"},{"id":"semetey-1-2013:p0097:b003:l004","ordinal":84244,"en":"And bound the bundle tight behind."},{"id":"semetey-1-2013:p0097:b003:l005","ordinal":84245,"en":"Showing his valor,"},{"id":"semetey-1-2013:p0097:b003:l006","ordinal":84246,"en":"Upon the broad-pommeled saddle"},{"id":"semetey-1-2013:p0097:b003:l007","ordinal":84247,"en":"He seated Chyiyrdy."},{"id":"semetey-1-2013:p0097:b003:l008","ordinal":84248,"en":"Then binding and fastening again,"},{"id":"semetey-1-2013:p0097:b003:l009","ordinal":84249,"en":"The orphan of ill fortune,"},{"id":"semetey-1-2013:p0097:b003:l010","ordinal":84250,"en":"With a striped woolen sash,"},{"id":"semetey-1-2013:p0097:b003:l011","ordinal":84251,"en":"He secured as a precious trust."},{"id":"semetey-1-2013:p0097:b003:l012","ordinal":84252,"en":"Showing himself a hero,"},{"id":"semetey-1-2013:p0097:b003:l013","ordinal":84253,"en":"He seated him upon his neck"},{"id":"semetey-1-2013:p0097:b003:l014","ordinal":84254,"en":"And bound him firmly there."},{"id":"semetey-1-2013:p0097:b003:l015","ordinal":84255,"en":"The thick-weft striped cloth of Andijan,"},{"id":"semetey-1-2013:p0097:b003:l016","ordinal":84256,"en":"The broad trousers upon his legs—"},{"id":"semetey-1-2013:p0097:b003:l017","ordinal":84257,"en":"He gathered their cuffs together"},{"id":"semetey-1-2013:p0097:b003:l018","ordinal":84258,"en":"And tucked them into his waistband."},{"id":"semetey-1-2013:p0097:b003:l019","ordinal":84259,"en":"Moving with fierce resolve,"},{"id":"semetey-1-2013:p0097:b003:l020","ordinal":84260,"en":"He rolled his trousers upward."},{"id":"semetey-1-2013:p0097:b003:l021","ordinal":84261,"en":"Showing his heroism,"},{"id":"semetey-1-2013:p0097:b003:l022","ordinal":84262,"en":"Bakai, himself a skilled swimmer,"},{"id":"semetey-1-2013:p0097:b003:l023","ordinal":84263,"en":"That orphan child"},{"id":"semetey-1-2013:p0097:b003:l024","ordinal":84264,"en":"Seated upon his neck."},{"id":"semetey-1-2013:p0097:b003:l025","ordinal":84265,"en":"Thinking, ‘If I give him to the women,"},{"id":"semetey-1-2013:p0097:b003:l026","ordinal":84266,"en":"In their distraction they may throw him into the water;"},{"id":"semetey-1-2013:p0097:b003:l027","ordinal":84267,"en":"The hero's death will come with theirs,"},{"id":"semetey-1-2013:p0097:b003:l028","ordinal":84268,"en":"He will die for nothing’—"},{"id":"semetey-1-2013:p0097:b003:l029","ordinal":84269,"en":"Showing his valor,"},{"id":"semetey-1-2013:p0097:b003:l030","ordinal":84270,"en":"The heroic child Semetey"},{"id":"semetey-1-2013:p0097:b003:l031","ordinal":84271,"en":"Upon the muscles of his neck"},{"id":"semetey-1-2013:p0097:b003:l032","ordinal":84272,"en":"Bakai carefully seated."},{"id":"semetey-1-2013:p0097:b003:l033","ordinal":84273,"en":"Bareheaded, he strode along,"},{"id":"semetey-1-2013:p0097:b003:l034","ordinal":84274,"en":"Barefoot, he stepped lightly."},{"id":"semetey-1-2013:p0097:b003:l035","ordinal":84275,"en":"Pleading with the one God,"},{"id":"semetey-1-2013:p0097:b003:l036","ordinal":84276,"en":"To ford the Syr Darya"},{"id":"semetey-1-2013:p0097:b003:l037","ordinal":84277,"en":"Great Bakai prepared himself,"},{"id":"semetey-1-2013:p0097:b003:l038","ordinal":84278,"en":"Invoking the spirit of Manas"},{"id":"semetey-1-2013:p0097:b003:l039","ordinal":84279,"en":"Who had gone to the other world:"},{"id":"semetey-1-2013:p0097:b005:l001","ordinal":84280,"en":"“My protector Kojosan,"},{"id":"semetey-1-2013:p0097:b005:l002","ordinal":84281,"en":"Support me beneath my arms!"},{"id":"semetey-1-2013:p0097:b005:l003","ordinal":84282,"en":"Ak Eshen, to whom I gave my hand,"},{"id":"semetey-1-2013:p0097:b005:l004","ordinal":84283,"en":"Come before me!"},{"id":"semetey-1-2013:p0097:b005:l005","ordinal":84284,"en":"Black-spotted leopard,"},{"id":"semetey-1-2013:p0097:b005:l006","ordinal":84285,"en":"Spring to my side!"},{"id":"semetey-1-2013:p0097:b005:l007","ordinal":84286,"en":"Short-tailed, dark-maned lion,"},{"id":"semetey-1-2013:p0097:b005:l008","ordinal":84287,"en":"Stand ready at my flank!"},{"id":"semetey-1-2013:p0097:b005:l009","ordinal":84288,"en":"Father of water, Buurakan,"},{"id":"semetey-1-2013:p0097:b005:l010","ordinal":84289,"en":"Let your riverbed emerge and give me passage!"},{"id":"semetey-1-2013:p0097:b005:l011","ordinal":84290,"en":"Almambet and Chubak, whose names chime,"},{"id":"semetey-1-2013:p0097:b005:l012","ordinal":84291,"en":"Give your orphan aid!"},{"id":"semetey-1-2013:p0097:b005:l013","ordinal":84292,"en":"Forty chiltens, Khizyr and Ilyas,"},{"id":"semetey-1-2013:p0097:b005:l014","ordinal":84293,"en":"I am in distress—give me passage!”"},{"id":"semetey-1-2013:p0097:b005:l015","ordinal":84294,"en":"Saying this, mighty Bakai"},{"id":"semetey-1-2013:p0097:b005:l016","ordinal":84295,"en":"Put his sash around his neck."},{"id":"semetey-1-2013:p0097:b005:l017","ordinal":84296,"en":"To the Jabbar saints who protected him"},{"id":"semetey-1-2013:p0097:b005:l018","ordinal":84297,"en":"He prayed, leaving none out."},{"id":"semetey-1-2013:p0097:b005:l019","ordinal":84298,"en":"Dipping his feet in the water,"},{"id":"semetey-1-2013:p0097:b005:l020","ordinal":84299,"en":"He performed their ritual washing."},{"id":"semetey-1-2013:p0097:b005:l021","ordinal":84300,"en":"Dipping his hands in the water,"},{"id":"semetey-1-2013:p0097:b005:l022","ordinal":84301,"en":"He performed their ritual washing."},{"id":"semetey-1-2013:p0097:b005:l023","ordinal":84302,"en":"His body ritually clean,"},{"id":"semetey-1-2013:p0097:b005:l024","ordinal":84303,"en":"Faith upon his face,"},{"id":"semetey-1-2013:p0097:b005:l025","ordinal":84304,"en":"The orphan and the widow"},{"id":"semetey-1-2013:p0097:b005:l026","ordinal":84305,"en":"He meant to save."},{"id":"semetey-1-2013:p0097:b005:l027","ordinal":84306,"en":"Was it not Bakai who had seen"},{"id":"semetey-1-2013:p0097:b005:l028","ordinal":84307,"en":"Great, arduous, costly undertakings?"},{"id":"semetey-1-2013:p0097:b005:l029","ordinal":84308,"en":"Was it not Bakai, accustomed"},{"id":"semetey-1-2013:p0097:b005:l030","ordinal":84309,"en":"To marching at the head of countless troops?"},{"id":"semetey-1-2013:p0097:b005:l031","ordinal":84310,"en":"Your falcon, saintly Bakai,"},{"id":"semetey-1-2013:p0097:b005:l032","ordinal":84311,"en":"That poor man, shaken to the core,"},{"id":"semetey-1-2013:p0097:b005:l033","ordinal":84312,"en":"Never ceasing his prayer of repentance,"},{"id":"semetey-1-2013:p0097:b005:l034","ordinal":84313,"en":"Unable to stand still, took the direct way."},{"id":"semetey-1-2013:p0097:b005:l035","ordinal":84314,"en":"Without pausing, Khan Bakai,"},{"id":"semetey-1-2013:p0097:b005:l036","ordinal":84315,"en":"Having seated them upon the gray steed,"},{"id":"semetey-1-2013:p0097:b005:l037","ordinal":84316,"en":"Led the two ladies,"},{"id":"semetey-1-2013:p0097:b005:l038","ordinal":84317,"en":"Praying to his saints,"},{"id":"semetey-1-2013:p0097:b005:l039","ordinal":84318,"en":"To cross the Syr Darya,"},{"id":"semetey-1-2013:p0098:b003:l001","ordinal":84319,"en":"Leopard Bakai made ready."},{"id":"semetey-1-2013:p0098:b003:l002","ordinal":84320,"en":"Taking the gun Kok Chybyk in hand,"},{"id":"semetey-1-2013:p0098:b003:l003","ordinal":84321,"en":"He cried, “Manas! Manas!”"},{"id":"semetey-1-2013:p0098:b003:l004","ordinal":84322,"en":"“God, set this undertaking right;"},{"id":"semetey-1-2013:p0098:b003:l005","ordinal":84323,"en":"Protect my orphan!” he said."},{"id":"semetey-1-2013:p0098:b003:l006","ordinal":84324,"en":"Coughing with fierce resolve,"},{"id":"semetey-1-2013:p0098:b003:l007","ordinal":84325,"en":"Your uncle, blessed with sacred power,"},{"id":"semetey-1-2013:p0098:b003:l008","ordinal":84326,"en":"Raised the gun Kok Chybyk"},{"id":"semetey-1-2013:p0098:b003:l009","ordinal":84327,"en":"And stretched it toward the water, standing broad."},{"id":"semetey-1-2013:p0098:b003:l010","ordinal":84328,"en":"Your uncle Bakai, Kojosan,"},{"id":"semetey-1-2013:p0098:b003:l011","ordinal":84329,"en":"Stood large before the water."},{"id":"semetey-1-2013:p0098:b003:l012","ordinal":84330,"en":"With Chinese fire steel and flint"},{"id":"semetey-1-2013:p0098:b003:l013","ordinal":84331,"en":"He struck and set an ember."},{"id":"semetey-1-2013:p0098:b003:l014","ordinal":84332,"en":"Kok Chybyk in his hands,"},{"id":"semetey-1-2013:p0098:b003:l015","ordinal":84333,"en":"Unerring in its marksmanship,"},{"id":"semetey-1-2013:p0098:b003:l016","ordinal":84334,"en":"Its trigger ready—"},{"id":"semetey-1-2013:p0098:b003:l017","ordinal":84335,"en":"Into the roaring river"},{"id":"semetey-1-2013:p0098:b003:l018","ordinal":84336,"en":"Then Bakai the leopard"},{"id":"semetey-1-2013:p0098:b003:l019","ordinal":84337,"en":"Let off one booming shot."},{"id":"semetey-1-2013:p0098:b003:l020","ordinal":84338,"en":"If you looked upstream,"},{"id":"semetey-1-2013:p0098:b003:l021","ordinal":84339,"en":"The river had stopped flowing."},{"id":"semetey-1-2013:p0098:b003:l022","ordinal":84340,"en":"If you looked downstream,"},{"id":"semetey-1-2013:p0098:b003:l023","ordinal":84341,"en":"The water vanished and the bed appeared."},{"id":"semetey-1-2013:p0098:b003:l024","ordinal":84342,"en":"Then Bakai the leopard"},{"id":"semetey-1-2013:p0098:b003:l025","ordinal":84343,"en":"Stepped briskly, hurrying along,"},{"id":"semetey-1-2013:p0098:b003:l026","ordinal":84344,"en":"Pleading with his orphan"},{"id":"semetey-1-2013:p0098:b003:l027","ordinal":84345,"en":"Semetey upon his neck:"},{"id":"semetey-1-2013:p0098:b003:l028","ordinal":84346,"en":"“He is one who takes after his father."},{"id":"semetey-1-2013:p0098:b003:l029","ordinal":84347,"en":"When I see the protection he receives,"},{"id":"semetey-1-2013:p0098:b003:l030","ordinal":84348,"en":"He is his father's equal."},{"id":"semetey-1-2013:p0098:b003:l031","ordinal":84349,"en":"His right shoulder will grow broad."},{"id":"semetey-1-2013:p0098:b003:l032","ordinal":84350,"en":"If my orphan lives,"},{"id":"semetey-1-2013:p0098:b003:l033","ordinal":84351,"en":"He will be a lion like his father."},{"id":"semetey-1-2013:p0098:b003:l034","ordinal":84352,"en":"When his wrath is roused,"},{"id":"semetey-1-2013:p0098:b003:l035","ordinal":84353,"en":"He will set grassy lands afire."},{"id":"semetey-1-2013:p0098:b003:l036","ordinal":84354,"en":"If he lives and grows,"},{"id":"semetey-1-2013:p0098:b003:l037","ordinal":84355,"en":"He will kindle the meadows,"},{"id":"semetey-1-2013:p0098:b003:l038","ordinal":84356,"en":"Pour blood into clear water,"},{"id":"semetey-1-2013:p0098:b003:l039","ordinal":84357,"en":"Be fortunate in every way,"},{"id":"semetey-1-2013:p0098:b004:l001","ordinal":84358,"en":"And become a hero like his father!”"},{"id":"semetey-1-2013:p0098:b004:l002","ordinal":84359,"en":"That the water had stopped,"},{"id":"semetey-1-2013:p0098:b004:l003","ordinal":84360,"en":"Mighty Bakai read as an omen."},{"id":"semetey-1-2013:p0098:b004:l004","ordinal":84361,"en":"He offered a prayer to Baabedin,"},{"id":"semetey-1-2013:p0098:b004:l005","ordinal":84362,"en":"Pledged a sheep to Koroshon,"},{"id":"semetey-1-2013:p0098:b004:l006","ordinal":84363,"en":"And to merry-hearted Manas's spirit"},{"id":"semetey-1-2013:p0098:b004:l007","ordinal":84364,"en":"Pledged a horse with a moon-marked hoof."},{"id":"semetey-1-2013:p0098:b004:l008","ordinal":84365,"en":"Shouting, “Baabedin!”"},{"id":"semetey-1-2013:p0098:b004:l009","ordinal":84366,"en":"The outstanding hero Bakai"},{"id":"semetey-1-2013:p0098:b004:l010","ordinal":84367,"en":"Raised the battle cry, “Manas!”"},{"id":"semetey-1-2013:p0098:b004:l011","ordinal":84368,"en":"Taking strength from the child,"},{"id":"semetey-1-2013:p0098:b004:l012","ordinal":84369,"en":"His thoughts filled with joy,"},{"id":"semetey-1-2013:p0098:b004:l013","ordinal":84370,"en":"To the bluff upon the far side"},{"id":"semetey-1-2013:p0098:b004:l014","ordinal":84371,"en":"Lion Bakai had reached."},{"id":"semetey-1-2013:p0098:b004:l015","ordinal":84372,"en":"When he looked behind,"},{"id":"semetey-1-2013:p0098:b004:l016","ordinal":84373,"en":"The flowing river,"},{"id":"semetey-1-2013:p0098:b004:l017","ordinal":84374,"en":"With the earth shaking and rumbling,"},{"id":"semetey-1-2013:p0098:b004:l018","ordinal":84375,"en":"Rushed on with a roar."},{"id":"semetey-1-2013:p0098:b004:l019","ordinal":84376,"en":"Pines fell, willows floated,"},{"id":"semetey-1-2013:p0098:b004:l020","ordinal":84377,"en":"Every snagged branch swept away."},{"id":"semetey-1-2013:p0098:b004:l021","ordinal":84378,"en":"White foam as large as houses"},{"id":"semetey-1-2013:p0098:b004:l022","ordinal":84379,"en":"Shone upon the surface."},{"id":"semetey-1-2013:p0098:b004:l023","ordinal":84380,"en":"Dark stones upon the riverbed"},{"id":"semetey-1-2013:p0098:b004:l024","ordinal":84381,"en":"Clattered along its bottom."},{"id":"semetey-1-2013:p0098:b004:l025","ordinal":84382,"en":"All the spruces"},{"id":"semetey-1-2013:p0098:b004:l026","ordinal":84383,"en":"Were torn out by their roots."},{"id":"semetey-1-2013:p0098:b004:l027","ordinal":84384,"en":"The river that had stopped"},{"id":"semetey-1-2013:p0098:b004:l028","ordinal":84385,"en":"Crashed into its forest."},{"id":"semetey-1-2013:p0098:b004:l029","ordinal":84386,"en":"He emerged safely from the river,"},{"id":"semetey-1-2013:p0098:b004:l030","ordinal":84387,"en":"Your lion, Bakai the leopard."},{"id":"semetey-1-2013:p0098:b004:l031","ordinal":84388,"en":"While his precious one lived,"},{"id":"semetey-1-2013:p0098:b004:l032","ordinal":84389,"en":"Loading ammunition upon elephants,"},{"id":"semetey-1-2013:p0098:b004:l033","ordinal":84390,"en":"Overwhelming every enemy he met,"},{"id":"semetey-1-2013:p0098:b004:l034","ordinal":84391,"en":"The saint had grown accustomed to it."},{"id":"semetey-1-2013:p0098:b004:l035","ordinal":84392,"en":"When people split into seven factions,"},{"id":"semetey-1-2013:p0098:b004:l036","ordinal":84393,"en":"When full discord arose,"},{"id":"semetey-1-2013:p0098:b004:l037","ordinal":84394,"en":"He knew their circumstances too."},{"id":"semetey-1-2013:p0098:b004:l038","ordinal":84395,"en":"Not a crow to caw,"},{"id":"semetey-1-2013:p0098:b004:l039","ordinal":84396,"en":"Not a raven to croak,"},{"id":"semetey-1-2013:p0099:b003:l001","ordinal":84397,"en":"He knew the nature of such places too."},{"id":"semetey-1-2013:p0099:b003:l002","ordinal":84398,"en":"Ranging across the whole world,"},{"id":"semetey-1-2013:p0099:b003:l003","ordinal":84399,"en":"While precious Manas lived,"},{"id":"semetey-1-2013:p0099:b003:l004","ordinal":84400,"en":"Exercising a governor's authority,"},{"id":"semetey-1-2013:p0099:b003:l005","ordinal":84401,"en":"All the world,"},{"id":"semetey-1-2013:p0099:b003:l006","ordinal":84402,"en":"Shattering it in earnest,"},{"id":"semetey-1-2013:p0099:b003:l007","ordinal":84403,"en":"Was it not Bakai who knew it?"},{"id":"semetey-1-2013:p0099:b003:l008","ordinal":84404,"en":"The four corners of the globe,"},{"id":"semetey-1-2013:p0099:b003:l009","ordinal":84405,"en":"While his lord lived,"},{"id":"semetey-1-2013:p0099:b003:l010","ordinal":84406,"en":"Travelling all around,"},{"id":"semetey-1-2013:p0099:b003:l011","ordinal":84407,"en":"Was it not Bakai who had seen them?"},{"id":"semetey-1-2013:p0099:b003:l012","ordinal":84408,"en":"Crushing those who faced him,"},{"id":"semetey-1-2013:p0099:b003:l013","ordinal":84409,"en":"Was it not Bakai who conquered?"},{"id":"semetey-1-2013:p0099:b003:l014","ordinal":84410,"en":"The four corners of the globe,"},{"id":"semetey-1-2013:p0099:b003:l015","ordinal":84411,"en":"Was it not Bakai who surveyed them?"},{"id":"semetey-1-2013:p0099:b003:l016","ordinal":84412,"en":"The mountains upon the earth,"},{"id":"semetey-1-2013:p0099:b003:l017","ordinal":84413,"en":"Was it not Bakai who knew them?"},{"id":"semetey-1-2013:p0099:b003:l018","ordinal":84414,"en":"Upon Kakanchy's golden throne,"},{"id":"semetey-1-2013:p0099:b003:l019","ordinal":84415,"en":"Was it not Bakai who sat?"},{"id":"semetey-1-2013:p0099:b003:l020","ordinal":84416,"en":"All the hollows of the land,"},{"id":"semetey-1-2013:p0099:b003:l021","ordinal":84417,"en":"While raising tumult on his journeys,"},{"id":"semetey-1-2013:p0099:b003:l022","ordinal":84418,"en":"Was it not Bakai who knew them?"},{"id":"semetey-1-2013:p0099:b003:l023","ordinal":84419,"en":"Taking elephants wherever he found them,"},{"id":"semetey-1-2013:p0099:b003:l024","ordinal":84420,"en":"Loading elephants with gold coins,"},{"id":"semetey-1-2013:p0099:b003:l025","ordinal":84421,"en":"Taking a thousand dark-eyed captives too,"},{"id":"semetey-1-2013:p0099:b003:l026","ordinal":84422,"en":"Was it not Bakai who travelled so?"},{"id":"semetey-1-2013:p0099:b003:l027","ordinal":84423,"en":"“Kara-Kyr's Kara-Ungkur"},{"id":"semetey-1-2013:p0099:b003:l028","ordinal":84424,"en":"Is a true cave of refuge for Muslims."},{"id":"semetey-1-2013:p0099:b003:l029","ordinal":84425,"en":"A place where the moon sets overhead,"},{"id":"semetey-1-2013:p0099:b003:l030","ordinal":84426,"en":"A place where a saint rested quietly."},{"id":"semetey-1-2013:p0099:b003:l031","ordinal":84427,"en":"It was a dusty ridge,"},{"id":"semetey-1-2013:p0099:b003:l032","ordinal":84428,"en":"The place where my saint rested."},{"id":"semetey-1-2013:p0099:b003:l033","ordinal":84429,"en":"When the poor and destitute fled,"},{"id":"semetey-1-2013:p0099:b003:l034","ordinal":84430,"en":"It was a place to give them aid."},{"id":"semetey-1-2013:p0099:b003:l035","ordinal":84431,"en":"Mist veiled its angular surroundings;"},{"id":"semetey-1-2013:p0099:b003:l036","ordinal":84432,"en":"Ground fog settled and swirled."},{"id":"semetey-1-2013:p0099:b003:l037","ordinal":84433,"en":"Human eyes were blinded."},{"id":"semetey-1-2013:p0099:b003:l038","ordinal":84434,"en":"No fox sniffed and barked upon its plain;"},{"id":"semetey-1-2013:p0099:b005:l001","ordinal":84435,"en":"No wolf or wild beast walked its lower slopes."},{"id":"semetey-1-2013:p0099:b005:l003","ordinal":84436,"en":"To a watchful person,"},{"id":"semetey-1-2013:p0099:b005:l004","ordinal":84437,"en":"Oh, Kanykei, my foal,"},{"id":"semetey-1-2013:p0099:b005:l005","ordinal":84438,"en":"It was a land of ridge upon ridge."},{"id":"semetey-1-2013:p0099:b005:l006","ordinal":84439,"en":"They said a saint slept in the cave"},{"id":"semetey-1-2013:p0099:b005:l007","ordinal":84440,"en":"And made it his abode."},{"id":"semetey-1-2013:p0099:b005:l008","ordinal":84441,"en":"That is the mist-covered ridge;"},{"id":"semetey-1-2013:p0099:b005:l009","ordinal":84442,"en":"That is where the sorrowful rested."},{"id":"semetey-1-2013:p0099:b005:l010","ordinal":84443,"en":"Its surroundings form a fortress;"},{"id":"semetey-1-2013:p0099:b005:l011","ordinal":84444,"en":"That is where I can hide my orphan."},{"id":"semetey-1-2013:p0099:b005:l013","ordinal":84445,"en":"Sleeping one's fill,"},{"id":"semetey-1-2013:p0099:b005:l014","ordinal":84446,"en":"Lying until one's hips ache,"},{"id":"semetey-1-2013:p0099:b005:l015","ordinal":84447,"en":"Taking a nap and sleeping enough,"},{"id":"semetey-1-2013:p0099:b005:l016","ordinal":84448,"en":"That place was truly"},{"id":"semetey-1-2013:p0099:b005:l017","ordinal":84449,"en":"A place for real repose."},{"id":"semetey-1-2013:p0099:b005:l018","ordinal":84450,"en":"When I brought humiliation upon Kokand,"},{"id":"semetey-1-2013:p0099:b005:l019","ordinal":84451,"en":"When I stormed Margilan,"},{"id":"semetey-1-2013:p0099:b005:l020","ordinal":84452,"en":"I was the one who slept there.”"},{"id":"semetey-1-2013:p0099:b005:l021","ordinal":84453,"en":"Saying this, mighty Bakai"},{"id":"semetey-1-2013:p0099:b005:l022","ordinal":84454,"en":"Hurried into the hills,"},{"id":"semetey-1-2013:p0099:b005:l023","ordinal":84455,"en":"His knees bending toward the earth,"},{"id":"semetey-1-2013:p0099:b005:l024","ordinal":84456,"en":"Along the winding water,"},{"id":"semetey-1-2013:p0099:b005:l025","ordinal":84457,"en":"Among the curving mountains,"},{"id":"semetey-1-2013:p0099:b005:l026","ordinal":84458,"en":"Through the twisting ravine."},{"id":"semetey-1-2013:p0099:b005:l027","ordinal":84459,"en":"Your noble hero, old Bakai,"},{"id":"semetey-1-2013:p0099:b005:l028","ordinal":84460,"en":"The saint who had seen so much,"},{"id":"semetey-1-2013:p0099:b005:l029","ordinal":84461,"en":"Thought, ‘The hills are dense, split a thousand ways;"},{"id":"semetey-1-2013:p0099:b005:l030","ordinal":84462,"en":"A person could scarcely fit within."},{"id":"semetey-1-2013:p0099:b005:l031","ordinal":84463,"en":"If they came behind to attack,"},{"id":"semetey-1-2013:p0099:b005:l032","ordinal":84464,"en":"The villains would not find us.’"},{"id":"semetey-1-2013:p0099:b005:l033","ordinal":84465,"en":"Across the dark, rounded-hill country"},{"id":"semetey-1-2013:p0099:b005:l034","ordinal":84466,"en":"Bakai came on foot."},{"id":"semetey-1-2013:p0099:b005:l035","ordinal":84467,"en":"Kara-Beles and Kangshaak-Tash"},{"id":"semetey-1-2013:p0099:b005:l036","ordinal":84468,"en":"Bakai crossed."},{"id":"semetey-1-2013:p0099:b005:l037","ordinal":84469,"en":"Kara-Kyr's Chong-Ungkur—"},{"id":"semetey-1-2013:p0099:b005:l038","ordinal":84470,"en":"He saw the great cave."},{"id":"semetey-1-2013:p0099:b005:l039","ordinal":84471,"en":"If you looked at its mouth,"},{"id":"semetey-1-2013:p0100:b003:l001","ordinal":84472,"en":"A single person could fit;"},{"id":"semetey-1-2013:p0100:b003:l002","ordinal":84473,"en":"But if you looked farther inside,"},{"id":"semetey-1-2013:p0100:b003:l003","ordinal":84474,"en":"Six thousand sheep could fit."},{"id":"semetey-1-2013:p0100:b003:l004","ordinal":84475,"en":"Plane trees and willows surrounded it."},{"id":"semetey-1-2013:p0100:b003:l005","ordinal":84476,"en":"Beneath the plane tree"},{"id":"semetey-1-2013:p0100:b003:l006","ordinal":84477,"en":"A black spring bubbled up."},{"id":"semetey-1-2013:p0100:b003:l007","ordinal":84478,"en":"Its cuckoo called in the mountains;"},{"id":"semetey-1-2013:p0100:b003:l008","ordinal":84479,"en":"All its nightingales"},{"id":"semetey-1-2013:p0100:b003:l009","ordinal":84480,"en":"Sang and spoke in the willows."}]
