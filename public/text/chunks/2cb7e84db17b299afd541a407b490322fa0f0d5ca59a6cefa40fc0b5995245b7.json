[{"id":"semetey-1-2013:p0506:b004:l020","ordinal":115457,"en":"When I stood watch,"},{"id":"semetey-1-2013:p0506:b004:l021","ordinal":115458,"en":"Taking no sleep by day,"},{"id":"semetey-1-2013:p0506:b004:l022","ordinal":115459,"en":"Taking no rest by night,"},{"id":"semetey-1-2013:p0506:b004:l023","ordinal":115460,"en":"As I watched the patrol,"},{"id":"semetey-1-2013:p0506:b004:l024","ordinal":115461,"en":"Wearing a blue rep-cloth coat,"},{"id":"semetey-1-2013:p0506:b004:l025","ordinal":115462,"en":"Riding a horse such as Kokala,"},{"id":"semetey-1-2013:p0506:b004:l026","ordinal":115463,"en":"Carrying a spear without a horsehair tuft,"},{"id":"semetey-1-2013:p0506:b004:l027","ordinal":115464,"en":"A sword tied at his side,"},{"id":"semetey-1-2013:p0506:b004:l028","ordinal":115465,"en":"Turning the hearts of those who saw him,"},{"id":"semetey-1-2013:p0506:b004:l029","ordinal":115466,"en":"Your lion appeared like the Ala-Too."},{"id":"semetey-1-2013:p0506:b004:l031","ordinal":115467,"en":"Chubak was no less than Manas.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0506:b004:l032","ordinal":115468,"en":"With wild shouts and shrill cheers,"},{"id":"semetey-1-2013:p0506:b004:l033","ordinal":115469,"en":"Chubak, son of Akbaltay,"},{"id":"semetey-1-2013:p0506:b004:l034","ordinal":115470,"en":"To seize Bukhara,"},{"id":"semetey-1-2013:p0506:b004:l035","ordinal":115471,"en":"To destroy its people with their royal seat,"},{"id":"semetey-1-2013:p0506:b004:l036","ordinal":115472,"en":"To wreak a mighty slaughter,"},{"id":"semetey-1-2013:p0506:b004:l037","ordinal":115473,"en":"To kill many of Bukhara's people,"},{"id":"semetey-1-2013:p0506:b004:l038","ordinal":115474,"en":"To seize its khanship—"},{"id":"semetey-1-2013:p0506:b004:l039","ordinal":115475,"en":"Such were Chubak's thoughts."},{"id":"semetey-1-2013:p0507:b003:l001","ordinal":115476,"en":"I, your mother Kanykey,"},{"id":"semetey-1-2013:p0507:b003:l002","ordinal":115477,"en":"Grieving that I was a girl,"},{"id":"semetey-1-2013:p0507:b003:l003","ordinal":115478,"en":"My precious soul clad in men's clothing,"},{"id":"semetey-1-2013:p0507:b003:l005","ordinal":115479,"en":"When clear dawn broke,"},{"id":"semetey-1-2013:p0507:b003:l006","ordinal":115480,"en":"When light fell on the earth,"},{"id":"semetey-1-2013:p0507:b003:l007","ordinal":115481,"en":"The golden-cheeked battle-axe"},{"id":"semetey-1-2013:p0507:b003:l008","ordinal":115482,"en":"I took up and swung."},{"id":"semetey-1-2013:p0507:b003:l009","ordinal":115483,"en":"My father's drum for battle—"},{"id":"semetey-1-2013:p0507:b003:l010","ordinal":115484,"en":"Making it clang then,"},{"id":"semetey-1-2013:p0507:b003:l011","ordinal":115485,"en":"I cast it into the midst."},{"id":"semetey-1-2013:p0507:b003:l012","ordinal":115486,"en":"I girded my waist firmly."},{"id":"semetey-1-2013:p0507:b003:l013","ordinal":115487,"en":"At Akbaltay's Chubak"},{"id":"semetey-1-2013:p0507:b003:l014","ordinal":115488,"en":"I attacked with spear in hand."},{"id":"semetey-1-2013:p0507:b003:l015","ordinal":115489,"en":"'White Ishan!' I roared,"},{"id":"semetey-1-2013:p0507:b003:l016","ordinal":115490,"en":"And 'Temir!' I shouted as my battle cry."},{"id":"semetey-1-2013:p0507:b003:l018","ordinal":115491,"en":"To Chubak, son of Akbaltay,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0507:b003:l019","ordinal":115492,"en":"I, your mother, appeared like a lion."},{"id":"semetey-1-2013:p0507:b003:l020","ordinal":115493,"en":"Hero Chubak was kingly."},{"id":"semetey-1-2013:p0507:b003:l021","ordinal":115494,"en":"He turned Kokala's head toward me,"},{"id":"semetey-1-2013:p0507:b003:l022","ordinal":115495,"en":"Saying, 'Whoever it is, let them take their spear-thrust turn.'"},{"id":"semetey-1-2013:p0507:b003:l024","ordinal":115496,"en":"With immense, wrathful strength,"},{"id":"semetey-1-2013:p0507:b003:l025","ordinal":115497,"en":"He stared straight ahead: 'Let them strike.'"},{"id":"semetey-1-2013:p0507:b003:l026","ordinal":115498,"en":"Turning Kokala's head,"},{"id":"semetey-1-2013:p0507:b003:l027","ordinal":115499,"en":"Your fierce Chubak stood there."},{"id":"semetey-1-2013:p0507:b003:l028","ordinal":115500,"en":"Enraged, my precious soul,"},{"id":"semetey-1-2013:p0507:b003:l029","ordinal":115501,"en":"My blood not even a spoonful,"},{"id":"semetey-1-2013:p0507:b003:l030","ordinal":115502,"en":"My falcon soul not a handful,"},{"id":"semetey-1-2013:p0507:b003:l031","ordinal":115503,"en":"The black, white-blazed thoroughbred"},{"id":"semetey-1-2013:p0507:b003:l033","ordinal":115504,"en":"The ridged, painted steel spear","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0507:b003:l035","ordinal":115505,"en":"I reached him before an arrow could.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0507:b003:l036","ordinal":115506,"en":"'At this edge of the belt,' I thought,"},{"id":"semetey-1-2013:p0507:b003:l037","ordinal":115507,"en":"'Across the ribs,' I thought,"},{"id":"semetey-1-2013:p0507:b003:l038","ordinal":115508,"en":"'Where it will pierce his lung,' I thought,"},{"id":"semetey-1-2013:p0507:b003:l039","ordinal":115509,"en":"As I took my painted spear in hand."},{"id":"semetey-1-2013:p0507:b005:l001","ordinal":115510,"en":"I, your fierce mother, the tempestuous woman,"},{"id":"semetey-1-2013:p0507:b005:l002","ordinal":115511,"en":"Reached him and struck."},{"id":"semetey-1-2013:p0507:b005:l003","ordinal":115512,"en":"Akbaltay's lion"},{"id":"semetey-1-2013:p0507:b005:l004","ordinal":115513,"en":"Slipped backward from his saddle,"},{"id":"semetey-1-2013:p0507:b005:l005","ordinal":115514,"en":"His foot slipped out of the stirrup,"},{"id":"semetey-1-2013:p0507:b005:l006","ordinal":115515,"en":"And Kokala's great lead rope"},{"id":"semetey-1-2013:p0507:b005:l007","ordinal":115516,"en":"He could not grasp properly."},{"id":"semetey-1-2013:p0507:b005:l008","ordinal":115517,"en":"Into the gold-tread stirrup"},{"id":"semetey-1-2013:p0507:b005:l009","ordinal":115518,"en":"He could not set his foot."},{"id":"semetey-1-2013:p0507:b005:l010","ordinal":115519,"en":"Chubak was left reeling."},{"id":"semetey-1-2013:p0507:b005:l011","ordinal":115520,"en":"A curse on being a woman!"},{"id":"semetey-1-2013:p0507:b005:l012","ordinal":115521,"en":"My eyes rolled wildly,"},{"id":"semetey-1-2013:p0507:b005:l013","ordinal":115522,"en":"My legs hung loose."},{"id":"semetey-1-2013:p0507:b005:l014","ordinal":115523,"en":"The face of the world darkened,"},{"id":"semetey-1-2013:p0507:b005:l015","ordinal":115524,"en":"This world grew narrow."},{"id":"semetey-1-2013:p0507:b005:l016","ordinal":115525,"en":"Striking with force at Chubak,"},{"id":"semetey-1-2013:p0507:b005:l017","ordinal":115526,"en":"That unruly one like the Ala-Too,"},{"id":"semetey-1-2013:p0507:b005:l018","ordinal":115527,"en":"My wits fled, my insides burned."},{"id":"semetey-1-2013:p0507:b005:l019","ordinal":115528,"en":"Death is shared by all; there is no warning."},{"id":"semetey-1-2013:p0507:b005:l020","ordinal":115529,"en":"Beside your mother"},{"id":"semetey-1-2013:p0507:b005:l021","ordinal":115530,"en":"There was no companion to help."},{"id":"semetey-1-2013:p0507:b005:l022","ordinal":115531,"en":"Before I could draw back,"},{"id":"semetey-1-2013:p0507:b005:l023","ordinal":115532,"en":"Lion Chubak had recovered."},{"id":"semetey-1-2013:p0507:b005:l024","ordinal":115533,"en":"Lashing Kokala with his whip,"},{"id":"semetey-1-2013:p0507:b005:l025","ordinal":115534,"en":"At me, your unfortunate mother,"},{"id":"semetey-1-2013:p0507:b005:l026","ordinal":115535,"en":"With rage that frightened souls away,"},{"id":"semetey-1-2013:p0507:b005:l027","ordinal":115536,"en":"He charged at that very place."},{"id":"semetey-1-2013:p0507:b005:l028","ordinal":115537,"en":"I gave Chubak his turn."},{"id":"semetey-1-2013:p0507:b005:l029","ordinal":115538,"en":"Raging, the fierce hero roared,"},{"id":"semetey-1-2013:p0507:b005:l030","ordinal":115539,"en":"Shouting 'Oygut!' as his battle cry."},{"id":"semetey-1-2013:p0507:b005:l031","ordinal":115540,"en":"Striking Kokala upon the thigh,"},{"id":"semetey-1-2013:p0507:b005:l032","ordinal":115541,"en":"Calling out 'Akbaltay!'"},{"id":"semetey-1-2013:p0507:b005:l033","ordinal":115542,"en":"I gave Chubak his turn,"},{"id":"semetey-1-2013:p0507:b005:l034","ordinal":115543,"en":"That unruly one approaching."},{"id":"semetey-1-2013:p0507:b005:l035","ordinal":115544,"en":"The black, white-blazed thoroughbred—"},{"id":"semetey-1-2013:p0507:b005:l036","ordinal":115545,"en":"As I drew its bit and turned it,"},{"id":"semetey-1-2013:p0507:b005:l037","ordinal":115546,"en":"Akbaltay's lion"},{"id":"semetey-1-2013:p0507:b005:l038","ordinal":115547,"en":"Reached me before an arrow could,"},{"id":"semetey-1-2013:p0507:b005:l039","ordinal":115548,"en":"And there, your mother—"},{"id":"semetey-1-2013:p0508:b003:l001","ordinal":115549,"en":"At the point of her right shoulder blade"},{"id":"semetey-1-2013:p0508:b003:l002","ordinal":115550,"en":"He struck with great force as he passed."},{"id":"semetey-1-2013:p0508:b003:l003","ordinal":115551,"en":"White fibers as large as a herder's yurt"},{"id":"semetey-1-2013:p0508:b003:l004","ordinal":115552,"en":"Flew clattering with the spear."},{"id":"semetey-1-2013:p0508:b003:l005","ordinal":115553,"en":"Khan Chubak's painted spear"},{"id":"semetey-1-2013:p0508:b003:l006","ordinal":115554,"en":"Shattered into eighty pieces."},{"id":"semetey-1-2013:p0508:b003:l007","ordinal":115555,"en":"When Chubak thrust his spear,"},{"id":"semetey-1-2013:p0508:b003:l008","ordinal":115556,"en":"I lurched aside and recovered."},{"id":"semetey-1-2013:p0508:b003:l009","ordinal":115557,"en":"I wept, calling on the one God."},{"id":"semetey-1-2013:p0508:b003:l010","ordinal":115558,"en":"At one time, wretched as I was,"},{"id":"semetey-1-2013:p0508:b003:l011","ordinal":115559,"en":"Against Khan Baltay's son"},{"id":"semetey-1-2013:p0508:b003:l012","ordinal":115560,"en":"I endured six times."},{"id":"semetey-1-2013:p0508:b003:l013","ordinal":115561,"en":"Chubak, whose spear had broken,"},{"id":"semetey-1-2013:p0508:b003:l014","ordinal":115562,"en":"I tormented, wretched me."},{"id":"semetey-1-2013:p0508:b003:l015","ordinal":115563,"en":"At Chubak, who acted like a giant,"},{"id":"semetey-1-2013:p0508:b003:l016","ordinal":115564,"en":"The thoroughbred beneath me"},{"id":"semetey-1-2013:p0508:b003:l017","ordinal":115565,"en":"I lashed with my whip on either side,"},{"id":"semetey-1-2013:p0508:b003:l018","ordinal":115566,"en":"Spurring to right and left,"},{"id":"semetey-1-2013:p0508:b003:l019","ordinal":115567,"en":"Not looking around me,"},{"id":"semetey-1-2013:p0508:b003:l020","ordinal":115568,"en":"Not sparing my life at all,"},{"id":"semetey-1-2013:p0508:b003:l021","ordinal":115569,"en":"Not casting a glance about,"},{"id":"semetey-1-2013:p0508:b003:l022","ordinal":115570,"en":"Not sparing my life a hair's breadth,"},{"id":"semetey-1-2013:p0508:b003:l023","ordinal":115571,"en":"Not valuing my blood at a spoonful,"},{"id":"semetey-1-2013:p0508:b003:l024","ordinal":115572,"en":"Not sparing my life at all."},{"id":"semetey-1-2013:p0508:b003:l025","ordinal":115573,"en":"Chubak, whose spear had broken—"},{"id":"semetey-1-2013:p0508:b003:l026","ordinal":115574,"en":"Did you see how helpless he became,"},{"id":"semetey-1-2013:p0508:b003:l027","ordinal":115575,"en":"That unruly son of Akbaltay?"},{"id":"semetey-1-2013:p0508:b003:l028","ordinal":115576,"en":"Down the saddle-shaped ridge,"},{"id":"semetey-1-2013:p0508:b003:l029","ordinal":115577,"en":"When Chubak bent and rode,"},{"id":"semetey-1-2013:p0508:b003:l030","ordinal":115578,"en":"Your mother pursued behind him."},{"id":"semetey-1-2013:p0508:b003:l031","ordinal":115579,"en":"To hero Chubak, in this way,"},{"id":"semetey-1-2013:p0508:b003:l032","ordinal":115580,"en":"When I played this sport upon him,"},{"id":"semetey-1-2013:p0508:b003:l033","ordinal":115581,"en":"On the black, white-blazed thoroughbred,"},{"id":"semetey-1-2013:p0508:b003:l034","ordinal":115582,"en":"From the saddle-shaped pass,"},{"id":"semetey-1-2013:p0508:b003:l035","ordinal":115583,"en":"I reached him faster than an arrow."},{"id":"semetey-1-2013:p0508:b003:l036","ordinal":115584,"en":"Holding my painted spear ready,"},{"id":"semetey-1-2013:p0508:b003:l037","ordinal":115585,"en":"Reeling Chubak"},{"id":"semetey-1-2013:p0508:b003:l038","ordinal":115586,"en":"I struck as I passed."},{"id":"semetey-1-2013:p0508:b003:l039","ordinal":115587,"en":"His eyes rolled wildly,"},{"id":"semetey-1-2013:p0508:b004:l001","ordinal":115588,"en":"His legs hung loose."},{"id":"semetey-1-2013:p0508:b004:l002","ordinal":115589,"en":"The sloping yellow valley—"},{"id":"semetey-1-2013:p0508:b004:l003","ordinal":115590,"en":"I thought to bend down and make sport."},{"id":"semetey-1-2013:p0508:b004:l004","ordinal":115591,"en":"Akbaltay's lion,"},{"id":"semetey-1-2013:p0508:b004:l005","ordinal":115592,"en":"If he fell into my hands now,"},{"id":"semetey-1-2013:p0508:b004:l006","ordinal":115593,"en":"I thought to slaughter as a sacrifice,"},{"id":"semetey-1-2013:p0508:b004:l007","ordinal":115594,"en":"And before my father, Khan Temir,"},{"id":"semetey-1-2013:p0508:b004:l008","ordinal":115595,"en":"To go proclaiming glad news."},{"id":"semetey-1-2013:p0508:b004:l009","ordinal":115596,"en":"Khan Baltay's son,"},{"id":"semetey-1-2013:p0508:b004:l010","ordinal":115597,"en":"At least I would make him never come a second time."},{"id":"semetey-1-2013:p0508:b004:l012","ordinal":115598,"en":"My son, when that quarrel first began,"},{"id":"semetey-1-2013:p0508:b004:l014","ordinal":115599,"en":"Khan Baltay's son—"},{"id":"semetey-1-2013:p0508:b004:l015","ordinal":115600,"en":"Your poor mother Kanykey,"},{"id":"semetey-1-2013:p0508:b004:l016","ordinal":115601,"en":"As I drove him before me,"},{"id":"semetey-1-2013:p0508:b004:l017","ordinal":115602,"en":"Without killing or losing him,"},{"id":"semetey-1-2013:p0508:b004:l018","ordinal":115603,"en":"Chubak, who acted like a king,"},{"id":"semetey-1-2013:p0508:b004:l019","ordinal":115604,"en":"I thought to capture alive."},{"id":"semetey-1-2013:p0508:b004:l020","ordinal":115605,"en":"Into Bukhara's dungeon, forty rope-lengths deep,"},{"id":"semetey-1-2013:p0508:b004:l021","ordinal":115606,"en":"I would cast him alive in torment."},{"id":"semetey-1-2013:p0508:b004:l022","ordinal":115607,"en":"His father Akbaltay's vast wealth,"},{"id":"semetey-1-2013:p0508:b004:l023","ordinal":115608,"en":"Saying, 'Your son is alive with us,'"},{"id":"semetey-1-2013:p0508:b004:l024","ordinal":115609,"en":"I would take as a reward for glad news."},{"id":"semetey-1-2013:p0508:b004:l025","ordinal":115610,"en":"For seven days I would beat him down,"},{"id":"semetey-1-2013:p0508:b004:l026","ordinal":115611,"en":"Or else Chubak"},{"id":"semetey-1-2013:p0508:b004:l027","ordinal":115612,"en":"I would leave utterly downcast."},{"id":"semetey-1-2013:p0508:b004:l028","ordinal":115613,"en":"When we entered the descent,"},{"id":"semetey-1-2013:p0508:b004:l029","ordinal":115614,"en":"Your mother's thoroughbred"},{"id":"semetey-1-2013:p0508:b004:l030","ordinal":115615,"en":"Planted its forelegs like a roe deer."},{"id":"semetey-1-2013:p0508:b004:l031","ordinal":115616,"en":"When we headed uphill,"},{"id":"semetey-1-2013:p0508:b004:l032","ordinal":115617,"en":"Hero Chubak's Kokala"},{"id":"semetey-1-2013:p0508:b004:l033","ordinal":115618,"en":"Spread its mane and tail."},{"id":"semetey-1-2013:p0508:b004:l034","ordinal":115619,"en":"When we reached the rounded hillocks,"},{"id":"semetey-1-2013:p0508:b004:l035","ordinal":115620,"en":"This mother's thoroughbred"},{"id":"semetey-1-2013:p0508:b004:l036","ordinal":115621,"en":"Bulged its neck like a bull."},{"id":"semetey-1-2013:p0508:b004:l038","ordinal":115622,"en":"Khan Chubak's Kokala","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0508:b004:l039","ordinal":115623,"en":"Flashed its eyes like flint."},{"id":"semetey-1-2013:p0509:b003:l001","ordinal":115624,"en":"Driving him over Arstanbap,"},{"id":"semetey-1-2013:p0509:b003:l002","ordinal":115625,"en":"I pursued Chubak without mercy,"},{"id":"semetey-1-2013:p0509:b003:l003","ordinal":115626,"en":"Across the gray plain of Andijan."},{"id":"semetey-1-2013:p0509:b003:l004","ordinal":115627,"en":"When we entered the descent,"},{"id":"semetey-1-2013:p0509:b003:l005","ordinal":115628,"en":"Kanykey's thoroughbred"},{"id":"semetey-1-2013:p0509:b003:l006","ordinal":115629,"en":"Drew closer and closer."},{"id":"semetey-1-2013:p0509:b003:l007","ordinal":115630,"en":"When we headed uphill,"},{"id":"semetey-1-2013:p0509:b003:l008","ordinal":115631,"en":"Khan Chubak's Kokala"},{"id":"semetey-1-2013:p0509:b003:l009","ordinal":115632,"en":"Sped away like a shimmer."},{"id":"semetey-1-2013:p0509:b003:l010","ordinal":115633,"en":"No hill the size of a knucklebone,"},{"id":"semetey-1-2013:p0509:b003:l011","ordinal":115634,"en":"No hollow the size of a saddlecloth,"},{"id":"semetey-1-2013:p0509:b003:l012","ordinal":115635,"en":"No furrow drawn by a plow,"},{"id":"semetey-1-2013:p0509:b003:l013","ordinal":115636,"en":"No burrow dug by a marmot,"},{"id":"semetey-1-2013:p0509:b003:l014","ordinal":115637,"en":"No stone to crack a marrowbone,"},{"id":"semetey-1-2013:p0509:b003:l015","ordinal":115638,"en":"No swelling marsh hummock."},{"id":"semetey-1-2013:p0509:b003:l016","ordinal":115639,"en":"Wild ducks grew weary flying there;"},{"id":"semetey-1-2013:p0509:b003:l017","ordinal":115640,"en":"When black crows flew,"},{"id":"semetey-1-2013:p0509:b003:l018","ordinal":115641,"en":"Their wings tired in the desert."},{"id":"semetey-1-2013:p0509:b003:l019","ordinal":115642,"en":"If a lapwing flew, it cried out;"},{"id":"semetey-1-2013:p0509:b003:l020","ordinal":115643,"en":"A vulture could not fly across—"},{"id":"semetey-1-2013:p0509:b003:l021","ordinal":115644,"en":"Its wings withered on the way."},{"id":"semetey-1-2013:p0509:b003:l023","ordinal":115645,"en":"A wild ass's hooves as it traveled","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0509:b003:l024","ordinal":115646,"en":"Were burned in that desert."},{"id":"semetey-1-2013:p0509:b003:l025","ordinal":115647,"en":"From the ridge of Andijan,"},{"id":"semetey-1-2013:p0509:b003:l026","ordinal":115648,"en":"Stubbornly I leveled my spear."},{"id":"semetey-1-2013:p0509:b003:l027","ordinal":115649,"en":"Chubak's home was spacious Kashgar;"},{"id":"semetey-1-2013:p0509:b003:l028","ordinal":115650,"en":"I chased him toward Alay."},{"id":"semetey-1-2013:p0509:b003:l029","ordinal":115651,"en":"That blustering Chubak,"},{"id":"semetey-1-2013:p0509:b003:l030","ordinal":115652,"en":"I thought to pursue to Oygut,"},{"id":"semetey-1-2013:p0509:b003:l031","ordinal":115653,"en":"To fight ten days in Oygut,"},{"id":"semetey-1-2013:p0509:b003:l032","ordinal":115654,"en":"And make terrible sport of him."},{"id":"semetey-1-2013:p0509:b003:l033","ordinal":115655,"en":"As I rushed in, raging,"},{"id":"semetey-1-2013:p0509:b003:l034","ordinal":115656,"en":"From the ridge of Andijan,"},{"id":"semetey-1-2013:p0509:b003:l035","ordinal":115657,"en":"Where holy men had spent the night,"},{"id":"semetey-1-2013:p0509:b003:l036","ordinal":115658,"en":"From the place they had made a shrine,"},{"id":"semetey-1-2013:p0509:b003:l037","ordinal":115659,"en":"I saw a landmark, I saw a ridge,"},{"id":"semetey-1-2013:p0509:b003:l038","ordinal":115660,"en":"I saw a lion surpassing mortals."},{"id":"semetey-1-2013:p0509:b003:l039","ordinal":115661,"en":"His wide eyes were like Venus,"},{"id":"semetey-1-2013:p0509:b004:l001","ordinal":115662,"en":"And his great ears were like shields."},{"id":"semetey-1-2013:p0509:b004:l002","ordinal":115663,"en":"His size equaled a mountain;"},{"id":"semetey-1-2013:p0509:b004:l003","ordinal":115664,"en":"He seemed able to devour anyone he met."},{"id":"semetey-1-2013:p0509:b004:l004","ordinal":115665,"en":"Those who saw his majesty were afraid."},{"id":"semetey-1-2013:p0509:b004:l005","ordinal":115666,"en":"He had studied five years in Mecca,"},{"id":"semetey-1-2013:p0509:b004:l006","ordinal":115667,"en":"Received a document from the caliph,"},{"id":"semetey-1-2013:p0509:b004:l007","ordinal":115668,"en":"And a blessing from the prince."},{"id":"semetey-1-2013:p0509:b004:l008","ordinal":115669,"en":"He was called a renowned mighty hero."},{"id":"semetey-1-2013:p0509:b004:l009","ordinal":115670,"en":"He followed twelve spiritual masters."},{"id":"semetey-1-2013:p0509:b004:l010","ordinal":115671,"en":"When setting out, he was worth a countless host."},{"id":"semetey-1-2013:p0509:b004:l011","ordinal":115672,"en":"Naked Kyzyr had opened his way."},{"id":"semetey-1-2013:p0509:b004:l013","ordinal":115673,"en":"None remained who could withstand him.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0509:b004:l014","ordinal":115674,"en":"Fortune favored him in everything."},{"id":"semetey-1-2013:p0509:b004:l015","ordinal":115675,"en":"He was a lion favored with victory."},{"id":"semetey-1-2013:p0509:b004:l016","ordinal":115676,"en":"Finding no mountain to strike against,"},{"id":"semetey-1-2013:p0509:b004:l017","ordinal":115677,"en":"Finding no enemy to fight,"},{"id":"semetey-1-2013:p0509:b004:l018","ordinal":115678,"en":"Having taken and subdued Andijan,"},{"id":"semetey-1-2013:p0509:b004:l019","ordinal":115679,"en":"It was your father himself, Khan Manas."},{"id":"semetey-1-2013:p0509:b004:l020","ordinal":115680,"en":"Watching the patrol, ranging the land,"},{"id":"semetey-1-2013:p0509:b004:l021","ordinal":115681,"en":"Your hero was out keeping watch."},{"id":"semetey-1-2013:p0509:b004:l023","ordinal":115682,"en":"His face was like oiled wheat,"},{"id":"semetey-1-2013:p0509:b004:l024","ordinal":115683,"en":"His eyes like twilight mist."},{"id":"semetey-1-2013:p0509:b004:l025","ordinal":115684,"en":"When he turned his front,"},{"id":"semetey-1-2013:p0509:b004:l026","ordinal":115685,"en":"He had the form of a lion;"},{"id":"semetey-1-2013:p0509:b004:l027","ordinal":115686,"en":"When he turned his back,"},{"id":"semetey-1-2013:p0509:b004:l028","ordinal":115687,"en":"He had the dread presence of six thousand men."},{"id":"semetey-1-2013:p0509:b004:l029","ordinal":115688,"en":"A black-spotted leopard"},{"id":"semetey-1-2013:p0509:b004:l030","ordinal":115689,"en":"Leapt beside his flank."},{"id":"semetey-1-2013:p0509:b004:l031","ordinal":115690,"en":"A short-tailed, fierce-maned lion,"},{"id":"semetey-1-2013:p0509:b004:l032","ordinal":115691,"en":"Opening its mouth and roaring,"},{"id":"semetey-1-2013:p0509:b004:l033","ordinal":115692,"en":"Made ready before him."},{"id":"semetey-1-2013:p0509:b004:l034","ordinal":115693,"en":"His protector was Kojosan,"},{"id":"semetey-1-2013:p0509:b004:l035","ordinal":115694,"en":"His supporters the forty chiltens."},{"id":"semetey-1-2013:p0509:b004:l036","ordinal":115695,"en":"He was that fortunate lion himself."},{"id":"semetey-1-2013:p0509:b004:l037","ordinal":115696,"en":"Keeping watch, ranging the land,"},{"id":"semetey-1-2013:p0509:b004:l038","ordinal":115697,"en":"With Khan Bakay following him,"},{"id":"semetey-1-2013:p0509:b004:l039","ordinal":115698,"en":"Your father Manas, the blood-stained lion,"},{"id":"semetey-1-2013:p0510:b003:l001","ordinal":115699,"en":"He was out on patrol."},{"id":"semetey-1-2013:p0510:b003:l002","ordinal":115700,"en":"Pursuing Chubak, I grew excited;"},{"id":"semetey-1-2013:p0510:b003:l003","ordinal":115701,"en":"I, that clamorous shrew,"},{"id":"semetey-1-2013:p0510:b003:l004","ordinal":115702,"en":"Encountered your father, Khan Manas."},{"id":"semetey-1-2013:p0510:b003:l005","ordinal":115703,"en":"As a married woman, in this way"},{"id":"semetey-1-2013:p0510:b003:l006","ordinal":115704,"en":"I shook the people and threw them into turmoil;"},{"id":"semetey-1-2013:p0510:b003:l007","ordinal":115705,"en":"As a girl, wretched me,"},{"id":"semetey-1-2013:p0510:b003:l008","ordinal":115706,"en":"I shook generations and threw the nation into turmoil."},{"id":"semetey-1-2013:p0510:b003:l009","ordinal":115707,"en":"Riding a horse like a gray winged steed,"},{"id":"semetey-1-2013:p0510:b003:l010","ordinal":115708,"en":"Holding blue Zulpukor,"},{"id":"semetey-1-2013:p0510:b003:l011","ordinal":115709,"en":"Tall and broad-shouldered,"},{"id":"semetey-1-2013:p0510:b003:l012","ordinal":115710,"en":"Both a wrestler and a lion,"},{"id":"semetey-1-2013:p0510:b003:l013","ordinal":115711,"en":"Famous Bakay, that heroic sultan,"},{"id":"semetey-1-2013:p0510:b003:l014","ordinal":115712,"en":"Looked kindly on your unfortunate mother Kanykey."}]
