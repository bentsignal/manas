[{"id":"manas-2010:p1276:b001:l005","ordinal":55297,"en":"Warrior Manas, all alone,"},{"id":"manas-2010:p1276:b001:l006","ordinal":55298,"en":"Laid low wherever he reached."},{"id":"manas-2010:p1276:b001:l007","ordinal":55299,"en":"Without distinguishing day and night,"},{"id":"manas-2010:p1276:b001:l008","ordinal":55300,"en":"He fought without a pause."},{"id":"manas-2010:p1276:b001:l009","ordinal":55301,"en":"Kyzyl-Kum of It-Ölbös"},{"id":"manas-2010:p1276:b001:l010","ordinal":55302,"en":"Was a desert forty days across."},{"id":"manas-2010:p1276:b001:l011","ordinal":55303,"en":"The mirage never left it;"},{"id":"manas-2010:p1276:b001:l012","ordinal":55304,"en":"Across this desert,"},{"id":"manas-2010:p1276:b001:l013","ordinal":55305,"en":"No eagle flew."},{"id":"manas-2010:p1276:b001:l014","ordinal":55306,"en":"It had no hill the size of an ankle bone,"},{"id":"manas-2010:p1276:b001:l015","ordinal":55307,"en":"No hollow the size of a saddlecloth."},{"id":"manas-2010:p1276:b001:l016","ordinal":55308,"en":"Wild asses could not endure there;"},{"id":"manas-2010:p1276:b001:l017","ordinal":55309,"en":"Wild beasts did not enter to graze."},{"id":"manas-2010:p1276:b001:l018","ordinal":55310,"en":"If a swan flew, its ears"},{"id":"manas-2010:p1276:b001:l019","ordinal":55311,"en":"Would burn in that desert."},{"id":"manas-2010:p1276:b001:l020","ordinal":55312,"en":"No grass to nibble a pinch of,"},{"id":"manas-2010:p1276:b001:l021","ordinal":55313,"en":"No water for the smallest sip!"},{"id":"manas-2010:p1276:b001:l022","ordinal":55314,"en":"It was a land hostile to horses."},{"id":"manas-2010:p1276:b001:l023","ordinal":55315,"en":"When he reached that desert,"},{"id":"manas-2010:p1276:b001:l024","ordinal":55316,"en":"Shouting, driving the Chinese,"},{"id":"manas-2010:p1276:b001:l025","ordinal":55317,"en":"Manas the champion went on."},{"id":"manas-2010:p1276:b001:l026","ordinal":55318,"en":"Into the middle of that desert,"},{"id":"manas-2010:p1276:b001:l027","ordinal":55319,"en":"When Manas drove them,"},{"id":"manas-2010:p1276:b001:l028","ordinal":55320,"en":"That his horse would cease to move,"},{"id":"manas-2010:p1276:b001:l029","ordinal":55321,"en":"The cunning Kalcha now knew."},{"id":"manas-2010:p1276:b001:l030","ordinal":55322,"en":"Algara's head,"},{"id":"manas-2010:p1276:b001:l031","ordinal":55323,"en":"Kongurbay kept reining in."},{"id":"manas-2010:p1276:b001:l032","ordinal":55324,"en":"Seeing Manas from afar,"},{"id":"manas-2010:p1276:b001:l033","ordinal":55325,"en":"Kongurbay studied him:"},{"id":"manas-2010:p1276:b001:l034","ordinal":55326,"en":"“Manas is truly a warrior,"},{"id":"manas-2010:p1276:b001:l035","ordinal":55327,"en":"A lion supported by holy power."},{"id":"manas-2010:p1276:b001:l036","ordinal":55328,"en":"For the handful of Burut,"},{"id":"manas-2010:p1276:b001:l037","ordinal":55329,"en":"He was born a fortress,"},{"id":"manas-2010:p1276:b001:l038","ordinal":55330,"en":"He was created a shield,"},{"id":"manas-2010:p1276:b001:l039","ordinal":55331,"en":"He is his homeland's true defense."},{"id":"manas-2010:p1276:b001:l040","ordinal":55332,"en":"Alas, Manas, what shall I do!"},{"id":"manas-2010:p1276:b001:l041","ordinal":55333,"en":"His fierce will knows no limit!"},{"id":"manas-2010:p1276:b001:l042","ordinal":55334,"en":"No one can bring him harm,"},{"id":"manas-2010:p1277:b001:l001","ordinal":55335,"en":"Not a stick for a herding pole is left;"},{"id":"manas-2010:p1277:b001:l002","ordinal":55336,"en":"He is a lofty, towering mountain."},{"id":"manas-2010:p1277:b001:l003","ordinal":55337,"en":"Manas the lion, for a warrior,"},{"id":"manas-2010:p1277:b001:l004","ordinal":55338,"en":"Is an enemy not to provoke."},{"id":"manas-2010:p1277:b001:l005","ordinal":55339,"en":"He is a torrent with a mighty current."},{"id":"manas-2010:p1277:b001:l006","ordinal":55340,"en":"Champion Manas, the leopard,"},{"id":"manas-2010:p1277:b001:l007","ordinal":55341,"en":"Even if his arm broke five times,"},{"id":"manas-2010:p1277:b001:l008","ordinal":55342,"en":"Has strength enough for Beijing."},{"id":"manas-2010:p1277:b001:l009","ordinal":55343,"en":"His fortune is complete;"},{"id":"manas-2010:p1277:b001:l010","ordinal":55344,"en":"His heart is wider than the earth."},{"id":"manas-2010:p1277:b001:l011","ordinal":55345,"en":"Manas has a little"},{"id":"manas-2010:p1277:b001:l012","ordinal":55346,"en":"Simple-mindedness in him;"},{"id":"manas-2010:p1277:b001:l013","ordinal":55347,"en":"He falls short in wisdom."},{"id":"manas-2010:p1277:b001:l014","ordinal":55348,"en":"Aybanboz beneath him,"},{"id":"manas-2010:p1277:b001:l015","ordinal":55349,"en":"It is time he ceased to move."},{"id":"manas-2010:p1277:b001:l016","ordinal":55350,"en":"If he fights with spears six more days,"},{"id":"manas-2010:p1277:b001:l017","ordinal":55351,"en":"His long ears flopping,"},{"id":"manas-2010:p1277:b001:l018","ordinal":55352,"en":"The gray mule beneath him"},{"id":"manas-2010:p1277:b001:l019","ordinal":55353,"en":"Will flounder, unable to go."},{"id":"manas-2010:p1277:b001:l020","ordinal":55354,"en":"When his horse cannot move,"},{"id":"manas-2010:p1277:b001:l021","ordinal":55355,"en":"Let me wage battle without mercy."},{"id":"manas-2010:p1277:b001:l022","ordinal":55356,"en":"His nose swollen like a waterskin,"},{"id":"manas-2010:p1277:b001:l023","ordinal":55357,"en":"Let me capture him alive."},{"id":"manas-2010:p1277:b001:l024","ordinal":55358,"en":"In the city of Great Beijing,"},{"id":"manas-2010:p1277:b001:l025","ordinal":55359,"en":"To forty wanton women kept by the treasury,"},{"id":"manas-2010:p1277:b001:l026","ordinal":55360,"en":"Let me take him and put him to stud."},{"id":"manas-2010:p1277:b001:l027","ordinal":55361,"en":"If a male child is born of him,"},{"id":"manas-2010:p1277:b001:l028","ordinal":55362,"en":"Let me put a golden crown on him,"},{"id":"manas-2010:p1277:b001:l029","ordinal":55363,"en":"Seat him upon a golden throne,"},{"id":"manas-2010:p1277:b001:l030","ordinal":55364,"en":"In Karykan's place,"},{"id":"manas-2010:p1277:b001:l031","ordinal":55365,"en":"Over the kakan's Beijing,"},{"id":"manas-2010:p1277:b001:l032","ordinal":55366,"en":"Let me raise him as khan."},{"id":"manas-2010:p1277:b001:l033","ordinal":55367,"en":"Whatever happens, from Manas"},{"id":"manas-2010:p1277:b001:l034","ordinal":55368,"en":"Let me get a child, an heir."},{"id":"manas-2010:p1277:b001:l035","ordinal":55369,"en":"There is a thought the mind cannot contain:"},{"id":"manas-2010:p1277:b001:l036","ordinal":55370,"en":"In your blue-maned one's loins,"},{"id":"manas-2010:p1277:b001:l037","ordinal":55371,"en":"There is a child greater than himself."},{"id":"manas-2010:p1277:b001:l038","ordinal":55372,"en":"Clear in the words he speaks,"},{"id":"manas-2010:p1277:b001:l039","ordinal":55373,"en":"Clear in the eyes with which he sees,"},{"id":"manas-2010:p1277:b001:l040","ordinal":55374,"en":"If we rely on him, he will be our support,"},{"id":"manas-2010:p1277:b001:l041","ordinal":55375,"en":"He will be a lion greater than Manas."},{"id":"manas-2010:p1277:b001:l042","ordinal":55376,"en":"Let me fight in earnest;"},{"id":"manas-2010:p1278:b001:l001","ordinal":55377,"en":"Before those others come,"},{"id":"manas-2010:p1278:b001:l002","ordinal":55378,"en":"Let me capture him alive!”"},{"id":"manas-2010:p1278:b001:l003","ordinal":55379,"en":"In the desert of It-Ölbös,"},{"id":"manas-2010:p1278:b001:l004","ordinal":55380,"en":"Devising a plan, nursing his grudge,"},{"id":"manas-2010:p1278:b001:l005","ordinal":55381,"en":"The lacquered spear in his hand,"},{"id":"manas-2010:p1278:b001:l006","ordinal":55382,"en":"He set firmly in his grip."},{"id":"manas-2010:p1278:b001:l007","ordinal":55383,"en":"Making Algara surge,"},{"id":"manas-2010:p1278:b001:l008","ordinal":55384,"en":"He came out in front of Manas."},{"id":"manas-2010:p1278:b001:l009","ordinal":55385,"en":"Coming before him, Kongurbay,"},{"id":"manas-2010:p1278:b001:l010","ordinal":55386,"en":"(Oh, that cunning swine!)"},{"id":"manas-2010:p1278:b001:l011","ordinal":55387,"en":"“Because they call you ‘Manas, Manas,’"},{"id":"manas-2010:p1278:b001:l012","ordinal":55388,"en":"You puff yourself up,"},{"id":"manas-2010:p1278:b001:l013","ordinal":55389,"en":"Like a waterskin put in water,"},{"id":"manas-2010:p1278:b001:l014","ordinal":55390,"en":"You swell yourself out!"},{"id":"manas-2010:p1278:b001:l015","ordinal":55391,"en":"Let me break your back!"},{"id":"manas-2010:p1278:b001:l016","ordinal":55392,"en":"If you are so great, warrior Manas,"},{"id":"manas-2010:p1278:b001:l017","ordinal":55393,"en":"Let me slaughter your people!”"},{"id":"manas-2010:p1278:b001:l018","ordinal":55394,"en":"Saying this, Kongurbay"},{"id":"manas-2010:p1278:b001:l019","ordinal":55395,"en":"Turned Algara's head."},{"id":"manas-2010:p1278:b001:l020","ordinal":55396,"en":"Enraged, that dear warrior"},{"id":"manas-2010:p1278:b001:l021","ordinal":55397,"en":"Before the blue-maned leopard Manas"},{"id":"manas-2010:p1278:b001:l022","ordinal":55398,"en":"Now stood."},{"id":"manas-2010:p1278:b001:l023","ordinal":55399,"en":"When the Kalcha fellow took heart"},{"id":"manas-2010:p1278:b001:l024","ordinal":55400,"en":"And stood confronting him,"},{"id":"manas-2010:p1278:b001:l025","ordinal":55401,"en":"Khan Manas took heart:"},{"id":"manas-2010:p1278:b001:l026","ordinal":55402,"en":"“Do not flee, Kalcha, do not flee!” he said."},{"id":"manas-2010:p1278:b001:l027","ordinal":55403,"en":"“Turn your horse's head,” he said."},{"id":"manas-2010:p1278:b001:l028","ordinal":55404,"en":"“If you truly are the best,"},{"id":"manas-2010:p1278:b001:l029","ordinal":55405,"en":"Stand in front of me!” he said."},{"id":"manas-2010:p1278:b001:l030","ordinal":55406,"en":"He braced himself, grimly resolute,"},{"id":"manas-2010:p1278:b001:l031","ordinal":55407,"en":"Flame pouring from his mouth,"},{"id":"manas-2010:p1278:b001:l032","ordinal":55408,"en":"His eyes like twilight mist,"},{"id":"manas-2010:p1278:b001:l033","ordinal":55409,"en":"His face like wheat rubbed with oil."},{"id":"manas-2010:p1278:b001:l034","ordinal":55410,"en":"Then your warrior Manas"},{"id":"manas-2010:p1278:b001:l035","ordinal":55411,"en":"Stared without a blink."},{"id":"manas-2010:p1278:b001:l036","ordinal":55412,"en":"Seeing Manas's might,"},{"id":"manas-2010:p1278:b001:l037","ordinal":55413,"en":"Unable to bear his heat,"},{"id":"manas-2010:p1278:b001:l038","ordinal":55414,"en":"Unable to face his cold,"},{"id":"manas-2010:p1278:b001:l039","ordinal":55415,"en":"He wheeled away and bolted,"},{"id":"manas-2010:p1278:b001:l040","ordinal":55416,"en":"Yielding up his place."},{"id":"manas-2010:p1278:b001:l041","ordinal":55417,"en":"Aybanboz came into his place;"},{"id":"manas-2010:p1278:b001:l042","ordinal":55418,"en":"His forelegs sank in the sand."},{"id":"manas-2010:p1279:b001:l001","ordinal":55419,"en":"Warrior Manas upon him"},{"id":"manas-2010:p1279:b001:l002","ordinal":55420,"en":"Fell to the ground with him."},{"id":"manas-2010:p1279:b001:l003","ordinal":55421,"en":"Before Aybanboz could rise,"},{"id":"manas-2010:p1279:b001:l004","ordinal":55422,"en":"As the Chinese were about to engulf them,"},{"id":"manas-2010:p1279:b001:l005","ordinal":55423,"en":"Your Manas, born a lion,"},{"id":"manas-2010:p1279:b001:l006","ordinal":55424,"en":"By his forelock and sacred mane,"},{"id":"manas-2010:p1279:b001:l007","ordinal":55425,"en":"Seizing him with a swift grasp,"},{"id":"manas-2010:p1279:b001:l008","ordinal":55426,"en":"Raised Aybanboz upright."},{"id":"manas-2010:p1279:b001:l009","ordinal":55427,"en":"Though he spurred him left and right,"},{"id":"manas-2010:p1279:b001:l010","ordinal":55428,"en":"His ears flopped."},{"id":"manas-2010:p1279:b001:l011","ordinal":55429,"en":"Having drunk no water for six days,"},{"id":"manas-2010:p1279:b001:l012","ordinal":55430,"en":"In the desert of It-Ölbös,"},{"id":"manas-2010:p1279:b001:l013","ordinal":55431,"en":"He floundered, unable to move."},{"id":"manas-2010:p1279:b001:l014","ordinal":55432,"en":"In such a fierce battle,"},{"id":"manas-2010:p1279:b001:l015","ordinal":55433,"en":"Drenched in heavy sweat,"},{"id":"manas-2010:p1279:b001:l016","ordinal":55434,"en":"He lumbered, unable to move."},{"id":"manas-2010:p1279:b001:l017","ordinal":55435,"en":"Since Aybanboz stood unable to move,"},{"id":"manas-2010:p1279:b001:l018","ordinal":55436,"en":"Would the Kalcha hold himself back?"},{"id":"manas-2010:p1279:b001:l019","ordinal":55437,"en":"Would he stand watching now,"},{"id":"manas-2010:p1279:b001:l020","ordinal":55438,"en":"Would God strike the Kalcha so!"},{"id":"manas-2010:p1279:b001:l021","ordinal":55439,"en":"His roar splitting stones,"},{"id":"manas-2010:p1279:b001:l022","ordinal":55440,"en":"His shout splitting heads,"},{"id":"manas-2010:p1279:b001:l023","ordinal":55441,"en":"Halting his champions,"},{"id":"manas-2010:p1279:b001:l024","ordinal":55442,"en":"He charged Manas, bellowing,"},{"id":"manas-2010:p1279:b001:l025","ordinal":55443,"en":"Hailing down his battle cry."},{"id":"manas-2010:p1279:b001:l026","ordinal":55444,"en":"Thus Kongurbay,"},{"id":"manas-2010:p1279:b001:l027","ordinal":55445,"en":"Without looking around him,"},{"id":"manas-2010:p1279:b001:l028","ordinal":55446,"en":"Without sparing his life at all,"},{"id":"manas-2010:p1279:b001:l029","ordinal":55447,"en":"Without glancing behind,"},{"id":"manas-2010:p1279:b001:l030","ordinal":55448,"en":"The champion Kalcha now came."},{"id":"manas-2010:p1279:b001:l031","ordinal":55449,"en":"That Aybanboz could no longer walk,"},{"id":"manas-2010:p1279:b001:l032","ordinal":55450,"en":"The Kalcha knew for certain."},{"id":"manas-2010:p1279:b001:l033","ordinal":55451,"en":"No other champion approached;"},{"id":"manas-2010:p1279:b001:l034","ordinal":55452,"en":"The Kalcha charged alone."},{"id":"manas-2010:p1279:b001:l035","ordinal":55453,"en":"The accomplished Sultan Manas,"},{"id":"manas-2010:p1279:b001:l036","ordinal":55454,"en":"He reached and thrust his spear at him."},{"id":"manas-2010:p1279:b001:l037","ordinal":55455,"en":"The true warrior, born a leopard,"},{"id":"manas-2010:p1279:b001:l038","ordinal":55456,"en":"Achbolot in his hand,"},{"id":"manas-2010:p1279:b001:l039","ordinal":55457,"en":"He now set ready."},{"id":"manas-2010:p1279:b001:l040","ordinal":55458,"en":"Kongurbay's spear,"},{"id":"manas-2010:p1279:b001:l041","ordinal":55459,"en":"Not letting it reach his body,"},{"id":"manas-2010:p1279:b001:l042","ordinal":55460,"en":"At the exact middle,"},{"id":"manas-2010:p1280:b001:l001","ordinal":55461,"en":"He slashed it across."},{"id":"manas-2010:p1280:b001:l002","ordinal":55462,"en":"Kongurbay's Algara,"},{"id":"manas-2010:p1280:b001:l003","ordinal":55463,"en":"Missing his blow at one thigh,"},{"id":"manas-2010:p1280:b001:l004","ordinal":55464,"en":"Manas now stood there."},{"id":"manas-2010:p1280:b001:l005","ordinal":55465,"en":"This might of Manas,"},{"id":"manas-2010:p1280:b001:l006","ordinal":55466,"en":"When warrior Kongurbay saw it,"},{"id":"manas-2010:p1280:b001:l007","ordinal":55467,"en":"Driving his champions like livestock,"},{"id":"manas-2010:p1280:b001:l008","ordinal":55468,"en":"Kongurbay came hemming him in."},{"id":"manas-2010:p1280:b001:l009","ordinal":55469,"en":"Making them scatter all around,"},{"id":"manas-2010:p1280:b001:l010","ordinal":55470,"en":"Kongurbay drove them in with blows."},{"id":"manas-2010:p1280:b001:l011","ordinal":55471,"en":"The champions engulfed Manas;"},{"id":"manas-2010:p1280:b001:l012","ordinal":55472,"en":"All came charging, crying out."},{"id":"manas-2010:p1280:b001:l013","ordinal":55473,"en":"Flame billowed from his mouth."},{"id":"manas-2010:p1280:b001:l014","ordinal":55474,"en":"When his horse could not move,"},{"id":"manas-2010:p1280:b001:l015","ordinal":55475,"en":"Then Manas the lion"},{"id":"manas-2010:p1280:b001:l016","ordinal":55476,"en":"Despaired of his entrusted life."},{"id":"manas-2010:p1280:b001:l017","ordinal":55477,"en":"Akkula came to mind:"},{"id":"manas-2010:p1280:b001:l018","ordinal":55478,"en":"“Akkula, to ride in battle,"},{"id":"manas-2010:p1280:b001:l019","ordinal":55479,"en":"Why did I not ride you!"},{"id":"manas-2010:p1280:b001:l020","ordinal":55480,"en":"Akolpok, to wear on distant journeys,"},{"id":"manas-2010:p1280:b001:l021","ordinal":55481,"en":"Why did I not wear you!”"},{"id":"manas-2010:p1280:b001:l022","ordinal":55482,"en":"Saying this, warrior Manas,"},{"id":"manas-2010:p1280:b001:l023","ordinal":55483,"en":"Unable to find any way out,"},{"id":"manas-2010:p1280:b001:l024","ordinal":55484,"en":"As he kept turning round,"},{"id":"manas-2010:p1280:b001:l025","ordinal":55485,"en":"The champions all came upon him."},{"id":"manas-2010:p1280:b001:l026","ordinal":55486,"en":"All the swift foot-runners,"},{"id":"manas-2010:p1280:b001:l027","ordinal":55487,"en":"Their monks and their nobles,"},{"id":"manas-2010:p1280:b001:l028","ordinal":55488,"en":"All came and reached him."},{"id":"manas-2010:p1280:b001:l029","ordinal":55489,"en":"Warrior Manas struggled for his life,"},{"id":"manas-2010:p1280:b001:l030","ordinal":55490,"en":"Letting no one near him,"},{"id":"manas-2010:p1280:b001:l031","ordinal":55491,"en":"Laying low those he encountered."},{"id":"manas-2010:p1280:b001:l032","ordinal":55492,"en":"Those who came before him,"},{"id":"manas-2010:p1280:b001:l033","ordinal":55493,"en":"He felled with his battle-axe."},{"id":"manas-2010:p1280:b001:l034","ordinal":55494,"en":"Even so, they would not desist;"},{"id":"manas-2010:p1280:b001:l035","ordinal":55495,"en":"The Chinese came surrounding him."},{"id":"manas-2010:p1280:b001:l036","ordinal":55496,"en":"The Chinese brought him torment."},{"id":"manas-2010:p1280:b001:l037","ordinal":55497,"en":"With Manas in their midst,"},{"id":"manas-2010:p1280:b001:l038","ordinal":55498,"en":"They encircled him twelve deep."},{"id":"manas-2010:p1280:b001:l039","ordinal":55499,"en":"Coming upon Manas from behind,"},{"id":"manas-2010:p1280:b001:l040","ordinal":55500,"en":"He thrust between his shoulder blades."},{"id":"manas-2010:p1280:b001:l041","ordinal":55501,"en":"When Kongurbay thrust in earnest,"},{"id":"manas-2010:p1280:b001:l042","ordinal":55502,"en":"Manas did not lean or flinch."},{"id":"manas-2010:p1281:b001:l001","ordinal":55503,"en":"Upon Aybanboz,"},{"id":"manas-2010:p1281:b001:l002","ordinal":55504,"en":"As though he had been nailed there,"},{"id":"manas-2010:p1281:b001:l003","ordinal":55505,"en":"Dear Manas did not stir."},{"id":"manas-2010:p1281:b001:l004","ordinal":55506,"en":"Could a mortal be like this?"},{"id":"manas-2010:p1281:b001:l005","ordinal":55507,"en":"Champion warrior Manas's"},{"id":"manas-2010:p1281:b001:l006","ordinal":55508,"en":"Protecting power was great;"},{"id":"manas-2010:p1281:b001:l007","ordinal":55509,"en":"Otherwise, would the Chinese spare him!"},{"id":"manas-2010:p1281:b001:l008","ordinal":55510,"en":"Then mighty Manas,"},{"id":"manas-2010:p1281:b001:l009","ordinal":55511,"en":"Begging, “Grant me faith,”"},{"id":"manas-2010:p1281:b001:l010","ordinal":55512,"en":"To plead for his life to be spared,"},{"id":"manas-2010:p1281:b001:l011","ordinal":55513,"en":"The short gray gun on his shoulder,"},{"id":"manas-2010:p1281:b001:l012","ordinal":55514,"en":"He made ready his firearm."},{"id":"manas-2010:p1281:b001:l013","ordinal":55515,"en":"Taking the short gray gun in hand,"},{"id":"manas-2010:p1281:b001:l014","ordinal":55516,"en":"He fired once with a boom."},{"id":"manas-2010:p1281:b001:l015","ordinal":55517,"en":"The many Chinese down below,"},{"id":"manas-2010:p1281:b001:l016","ordinal":55518,"en":"All bolted and fled."},{"id":"manas-2010:p1281:b001:l017","ordinal":55519,"en":"Six or seven times in succession,"},{"id":"manas-2010:p1281:b001:l018","ordinal":55520,"en":"When the lion fired,"},{"id":"manas-2010:p1281:b001:l019","ordinal":55521,"en":"It made no roar, merely sputtered."},{"id":"manas-2010:p1281:b001:l020","ordinal":55522,"en":"The bullets he fired,"},{"id":"manas-2010:p1281:b001:l021","ordinal":55523,"en":"Before reaching the Chinese, in between,"},{"id":"manas-2010:p1281:b001:l022","ordinal":55524,"en":"Fell pattering to the ground."},{"id":"manas-2010:p1281:b001:l023","ordinal":55525,"en":"That the short gray gun had failed,"},{"id":"manas-2010:p1281:b001:l024","ordinal":55526,"en":"The Kalcha noticed and knew."},{"id":"manas-2010:p1281:b001:l025","ordinal":55527,"en":"“That is no way to shoot!” he said."},{"id":"manas-2010:p1281:b001:l026","ordinal":55528,"en":"Without holding back, Kongurbay,"},{"id":"manas-2010:p1281:b001:l027","ordinal":55529,"en":"Shooting his bow like rain,"},{"id":"manas-2010:p1281:b001:l028","ordinal":55530,"en":"Pouring out shots like hail,"},{"id":"manas-2010:p1281:b001:l029","ordinal":55531,"en":"Now charged warrior Manas."},{"id":"manas-2010:p1281:b001:l030","ordinal":55532,"en":"Supporting him from behind,"},{"id":"manas-2010:p1281:b001:l031","ordinal":55533,"en":"Karazhoy charged with him."},{"id":"manas-2010:p1281:b001:l032","ordinal":55534,"en":"That the unbeliever would bind him,"},{"id":"manas-2010:p1281:b001:l033","ordinal":55535,"en":"Would bring disaster upon his head,"},{"id":"manas-2010:p1281:b001:l034","ordinal":55536,"en":"Blood-drinking Manas now knew."},{"id":"manas-2010:p1281:b001:l035","ordinal":55537,"en":"When Manas looked closely,"},{"id":"manas-2010:p1281:b001:l036","ordinal":55538,"en":"The gray coat Akylay had made,"},{"id":"manas-2010:p1281:b001:l037","ordinal":55539,"en":"Torn by spears and bullets,"},{"id":"manas-2010:p1281:b001:l038","ordinal":55540,"en":"Had become tattered shreds."},{"id":"manas-2010:p1281:b001:l039","ordinal":55541,"en":"With Khan Ylama at their head,"},{"id":"manas-2010:p1281:b001:l040","ordinal":55542,"en":"From the vast Chinese army,"},{"id":"manas-2010:p1281:b001:l041","ordinal":55543,"en":"They had come pouring in again."},{"id":"manas-2010:p1281:b001:l042","ordinal":55544,"en":"While it was thus,"},{"id":"manas-2010:p1282:b001:l001","ordinal":55545,"en":"Alöökö's Kongurbay"},{"id":"manas-2010:p1282:b001:l002","ordinal":55546,"en":"Gave word to them all:"},{"id":"manas-2010:p1282:b001:l003","ordinal":55547,"en":"“Capture him alive!"},{"id":"manas-2010:p1282:b001:l004","ordinal":55548,"en":"Before Karykan,"},{"id":"manas-2010:p1282:b001:l005","ordinal":55549,"en":"Bring him as a gift."},{"id":"manas-2010:p1282:b001:l006","ordinal":55550,"en":"Some way will be found!”"},{"id":"manas-2010:p1282:b001:l007","ordinal":55551,"en":"When he heard the Kalcha's words,"},{"id":"manas-2010:p1282:b001:l008","ordinal":55552,"en":"Manas the leopard, the dear warrior,"}]
