{"id": "sayakbay-ms-current146:pdf094:l023", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 94, "folio": 477, "line_in_page": 23, "raw": "Кан шорпосу койнуна,", "text": "Кан шорпосу койнуна,", "en": "Blood broth will spill into his breast,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
