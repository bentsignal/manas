[{"id":"manas-2010:p1654:b001:l040","ordinal":71169,"en":"Dead horses made a mountain;"},{"id":"manas-2010:p1654:b001:l041","ordinal":71170,"en":"With their mustaches bristling,"},{"id":"manas-2010:p1654:b001:l042","ordinal":71171,"en":"Dead warriors lay in bundles."},{"id":"manas-2010:p1655:b001:l001","ordinal":71172,"en":"All the heroes,"},{"id":"manas-2010:p1655:b001:l002","ordinal":71173,"en":"Shouting, “Islam!”"},{"id":"manas-2010:p1655:b001:l003","ordinal":71174,"en":"Held the Chinese back again,"},{"id":"manas-2010:p1655:b001:l004","ordinal":71175,"en":"Scattering them toward Beijing."},{"id":"manas-2010:p1655:b001:l005","ordinal":71176,"en":"The Beijing people with their emperor,"},{"id":"manas-2010:p1655:b001:l006","ordinal":71177,"en":"Making the Chinese howl,"},{"id":"manas-2010:p1655:b001:l007","ordinal":71178,"en":"They drove and pushed them back."},{"id":"manas-2010:p1655:b001:l008","ordinal":71179,"en":"Like tumbleweed flying,"},{"id":"manas-2010:p1655:b001:l009","ordinal":71180,"en":"Tossing them this way and that,"},{"id":"manas-2010:p1655:b001:l010","ordinal":71181,"en":"They hemmed them in and drove them on."},{"id":"manas-2010:p1655:b001:l011","ordinal":71182,"en":"Wherever the spear could reach,"},{"id":"manas-2010:p1655:b001:l012","ordinal":71183,"en":"He struck them down with the spear;"},{"id":"manas-2010:p1655:b001:l013","ordinal":71184,"en":"Those who came before him"},{"id":"manas-2010:p1655:b001:l014","ordinal":71185,"en":"He brought down with steel."},{"id":"manas-2010:p1655:b001:l015","ordinal":71186,"en":"Girding his waist securely,"},{"id":"manas-2010:p1655:b001:l016","ordinal":71187,"en":"Against seven myriad black Chinese"},{"id":"manas-2010:p1655:b001:l017","ordinal":71188,"en":"He plunged alone and attacked."},{"id":"manas-2010:p1655:b001:l018","ordinal":71189,"en":"When the vast Chinese people,"},{"id":"manas-2010:p1655:b001:l019","ordinal":71190,"en":"That formidable host, surged in waves,"},{"id":"manas-2010:p1655:b001:l020","ordinal":71191,"en":"A Chinese man called Manzhuu"},{"id":"manas-2010:p1655:b001:l021","ordinal":71192,"en":"Led them surging forward."},{"id":"manas-2010:p1655:b001:l022","ordinal":71193,"en":"When the black Kalmyks and Mongol people"},{"id":"manas-2010:p1655:b001:l023","ordinal":71194,"en":"Surged in and gave battle,"},{"id":"manas-2010:p1655:b001:l024","ordinal":71195,"en":"A tribe called Shibee"},{"id":"manas-2010:p1655:b001:l025","ordinal":71196,"en":"Charged from the flank,"},{"id":"manas-2010:p1655:b001:l026","ordinal":71197,"en":"And they too overwhelmed them."},{"id":"manas-2010:p1655:b001:l027","ordinal":71198,"en":"There was a people called Soloon,"},{"id":"manas-2010:p1655:b001:l028","ordinal":71199,"en":"The Beijing people with their emperor,"},{"id":"manas-2010:p1655:b001:l029","ordinal":71200,"en":"An inexhaustible mine of men."},{"id":"manas-2010:p1655:b001:l030","ordinal":71201,"en":"The Torghuts from the woman khan"},{"id":"manas-2010:p1655:b001:l031","ordinal":71202,"en":"Were also surging upon them then."},{"id":"manas-2010:p1655:b001:l032","ordinal":71203,"en":"The countless Chinese swarmed together;"},{"id":"manas-2010:p1655:b001:l033","ordinal":71204,"en":"After the formidable, fierce, blue-maned warrior"},{"id":"manas-2010:p1655:b001:l034","ordinal":71205,"en":"Drove them back and held them to their front,"},{"id":"manas-2010:p1655:b001:l035","ordinal":71206,"en":"Ninety Beijings rose in motion."},{"id":"manas-2010:p1655:b001:l036","ordinal":71207,"en":"See the grass upon the earth,"},{"id":"manas-2010:p1655:b001:l037","ordinal":71208,"en":"See the Chinese, countless as the grass!"},{"id":"manas-2010:p1655:b001:l038","ordinal":71209,"en":"See the roaring flood,"},{"id":"manas-2010:p1655:b001:l039","ordinal":71210,"en":"See the Chinese people, vast as the flood!"},{"id":"manas-2010:p1655:b001:l040","ordinal":71211,"en":"Spearheads clashed together,"},{"id":"manas-2010:p1655:b001:l041","ordinal":71212,"en":"Men’s heads struck against each other,"},{"id":"manas-2010:p1655:b001:l042","ordinal":71213,"en":"Mist hid the moon from sight,"},{"id":"manas-2010:p1656:b001:l001","ordinal":71214,"en":"The moon's eye could not be made out,"},{"id":"manas-2010:p1656:b001:l002","ordinal":71215,"en":"The sun flickered, hidden from sight,"},{"id":"manas-2010:p1656:b001:l003","ordinal":71216,"en":"The sun's face was darkened;"},{"id":"manas-2010:p1656:b001:l004","ordinal":71217,"en":"When the Chinese came in strength,"},{"id":"manas-2010:p1656:b001:l005","ordinal":71218,"en":"They merged with the face of the earth."},{"id":"manas-2010:p1656:b001:l006","ordinal":71219,"en":"The earth wheeled and heaved;"},{"id":"manas-2010:p1656:b001:l007","ordinal":71220,"en":"All of Great Beijing"},{"id":"manas-2010:p1656:b001:l008","ordinal":71221,"en":"Merged with the face of the earth."},{"id":"manas-2010:p1656:b001:l009","ordinal":71222,"en":"Karykan received the news,"},{"id":"manas-2010:p1656:b001:l010","ordinal":71223,"en":"His blood grew fiercely agitated."},{"id":"manas-2010:p1656:b001:l011","ordinal":71224,"en":"Utterly enraged,"},{"id":"manas-2010:p1656:b001:l012","ordinal":71225,"en":"Of forty-gated Beijing,"},{"id":"manas-2010:p1656:b001:l013","ordinal":71226,"en":"He opened the western side."},{"id":"manas-2010:p1656:b001:l014","ordinal":71227,"en":"So numerous were the Chinese,"},{"id":"manas-2010:p1656:b001:l015","ordinal":71228,"en":"They swarmed like ants."},{"id":"manas-2010:p1656:b001:l016","ordinal":71229,"en":"When the order came from their khan,"},{"id":"manas-2010:p1656:b001:l017","ordinal":71230,"en":"One warrior was supplied per household;"},{"id":"manas-2010:p1656:b001:l018","ordinal":71231,"en":"When this levy had been taken,"},{"id":"manas-2010:p1656:b001:l019","ordinal":71232,"en":"The Chinese of Kakan-Chin surged in,"},{"id":"manas-2010:p1656:b001:l020","ordinal":71233,"en":"When they reached the campaign,"},{"id":"manas-2010:p1656:b001:l021","ordinal":71234,"en":"Chinese of every, every kind"},{"id":"manas-2010:p1656:b001:l022","ordinal":71235,"en":"Appeared in all their different forms."},{"id":"manas-2010:p1656:b001:l023","ordinal":71236,"en":"When they saw this sight,"},{"id":"manas-2010:p1656:b001:l024","ordinal":71237,"en":"The handful of the Islamic faith"},{"id":"manas-2010:p1656:b001:l025","ordinal":71238,"en":"Despaired of their precious lives,"},{"id":"manas-2010:p1656:b001:l026","ordinal":71239,"en":"Broke into many scattered groups."},{"id":"manas-2010:p1656:b001:l027","ordinal":71240,"en":"Then Almambet, Khan Aziz's son,"},{"id":"manas-2010:p1656:b001:l028","ordinal":71241,"en":"Had no swift spare steed beside him."},{"id":"manas-2010:p1656:b001:l029","ordinal":71242,"en":"A dreadful day pressed hard upon his life;"},{"id":"manas-2010:p1656:b001:l030","ordinal":71243,"en":"When the Chinese hemmed him in,"},{"id":"manas-2010:p1656:b001:l031","ordinal":71244,"en":"Young Syrgak, the leopard, was absent."},{"id":"manas-2010:p1656:b001:l032","ordinal":71245,"en":"Your champion Alma, all alone,"},{"id":"manas-2010:p1656:b001:l033","ordinal":71246,"en":"Was beyond compare in valor;"},{"id":"manas-2010:p1656:b001:l034","ordinal":71247,"en":"To bind his wounded waist,"},{"id":"manas-2010:p1656:b001:l035","ordinal":71248,"en":"Valiant Syrgak was not there."},{"id":"manas-2010:p1656:b001:l036","ordinal":71249,"en":"With Khan Kongurbay at their head,"},{"id":"manas-2010:p1656:b001:l037","ordinal":71250,"en":"The Chinese came charging up;"},{"id":"manas-2010:p1656:b001:l038","ordinal":71251,"en":"Your blue-maned Alma, blessed by Kydyr,"},{"id":"manas-2010:p1656:b001:l039","ordinal":71252,"en":"The Chinese people, shouting,"},{"id":"manas-2010:p1656:b001:l040","ordinal":71253,"en":"Only forty-two surrounded him."},{"id":"manas-2010:p1656:b001:l041","ordinal":71254,"en":"In the desert of It-Ölbös,"},{"id":"manas-2010:p1656:b001:l042","ordinal":71255,"en":"Still alive, not perished, your Alma's"},{"id":"manas-2010:p1657:b001:l001","ordinal":71256,"en":"Eyes grew heavy and dim."},{"id":"manas-2010:p1657:b001:l002","ordinal":71257,"en":"When the Chinese surged forward,"},{"id":"manas-2010:p1657:b001:l003","ordinal":71258,"en":"Seventy spears struck your Alake at once."},{"id":"manas-2010:p1657:b001:l004","ordinal":71259,"en":"A deep pit had been dug;"},{"id":"manas-2010:p1657:b001:l005","ordinal":71260,"en":"Forty vast Chinese hosts surrounded him."},{"id":"manas-2010:p1657:b001:l006","ordinal":71261,"en":"Six thousand Chinese, a multitude of governors,"},{"id":"manas-2010:p1657:b001:l007","ordinal":71262,"en":"Plunged in together at your Alma."},{"id":"manas-2010:p1657:b001:l008","ordinal":71263,"en":"Their white-bearded elder Kongurbay:"},{"id":"manas-2010:p1657:b001:l009","ordinal":71264,"en":"“Reach him, give him no breath!"},{"id":"manas-2010:p1657:b001:l010","ordinal":71265,"en":"That fugitive on the run,"},{"id":"manas-2010:p1657:b001:l011","ordinal":71266,"en":"Bind him now!"},{"id":"manas-2010:p1657:b001:l012","ordinal":71267,"en":"Put a hide torture-cap upon his head;"},{"id":"manas-2010:p1657:b001:l013","ordinal":71268,"en":"Before Karykan,"},{"id":"manas-2010:p1657:b001:l014","ordinal":71269,"en":"Let us drive him alive."},{"id":"manas-2010:p1657:b001:l015","ordinal":71270,"en":"He has destroyed all our champions;"},{"id":"manas-2010:p1657:b001:l016","ordinal":71271,"en":"Let us avenge ourselves on the bastard alive!”"},{"id":"manas-2010:p1657:b001:l017","ordinal":71272,"en":"When Kongurbay gave this order,"},{"id":"manas-2010:p1657:b001:l018","ordinal":71273,"en":"The Chinese ran in swarms."},{"id":"manas-2010:p1657:b001:l019","ordinal":71274,"en":"His dear head was sorely afflicted;"},{"id":"manas-2010:p1657:b001:l020","ordinal":71275,"en":"Your Alake despaired of his daughter-divorced life."},{"id":"manas-2010:p1657:b001:l021","ordinal":71276,"en":"The reason for his despair:"},{"id":"manas-2010:p1657:b001:l022","ordinal":71277,"en":"That dear lion, slender as a crane,"},{"id":"manas-2010:p1657:b001:l023","ordinal":71278,"en":"His whole body had gone numb;"},{"id":"manas-2010:p1657:b001:l024","ordinal":71279,"en":"His two hands that should serve him"},{"id":"manas-2010:p1657:b001:l025","ordinal":71280,"en":"Were paralyzed, unable to move."},{"id":"manas-2010:p1657:b001:l026","ordinal":71281,"en":"His dear apple-shaped head"},{"id":"manas-2010:p1657:b001:l027","ordinal":71282,"en":"Was bloodied again and again."},{"id":"manas-2010:p1657:b001:l028","ordinal":71283,"en":"When the Chinese swept over him,"},{"id":"manas-2010:p1657:b001:l029","ordinal":71284,"en":"Against a saddle-shaped ridge,"},{"id":"manas-2010:p1657:b001:l030","ordinal":71285,"en":"Sarala, for all his speed,"},{"id":"manas-2010:p1657:b001:l031","ordinal":71286,"en":"Barely braced himself, near death."},{"id":"manas-2010:p1657:b001:l032","ordinal":71287,"en":"Sarala's dear head, shaped like a goat's,"},{"id":"manas-2010:p1657:b001:l033","ordinal":71288,"en":"Was bathed in scarlet blood."},{"id":"manas-2010:p1657:b001:l034","ordinal":71289,"en":"Cow-rumped Sarala,"},{"id":"manas-2010:p1657:b001:l035","ordinal":71290,"en":"His mouth opened like a ravenous maw,"},{"id":"manas-2010:p1657:b001:l036","ordinal":71291,"en":"White foam mixed with blood"},{"id":"manas-2010:p1657:b001:l037","ordinal":71292,"en":"Splattered upon his chest."},{"id":"manas-2010:p1657:b001:l038","ordinal":71293,"en":"His hooves thundered against the earth;"},{"id":"manas-2010:p1657:b001:l039","ordinal":71294,"en":"The black steel bit"},{"id":"manas-2010:p1657:b001:l040","ordinal":71295,"en":"Clattered deep in his throat."},{"id":"manas-2010:p1657:b001:l041","ordinal":71296,"en":"The ground he trod broke apart;"},{"id":"manas-2010:p1657:b001:l042","ordinal":71297,"en":"Clods mixed with stones"},{"id":"manas-2010:p1658:b001:l001","ordinal":71298,"en":"Above your noble lord Alma,"},{"id":"manas-2010:p1658:b001:l002","ordinal":71299,"en":"Whistled over his head."},{"id":"manas-2010:p1658:b001:l003","ordinal":71300,"en":"Stake-necked Sarala,"},{"id":"manas-2010:p1658:b001:l004","ordinal":71301,"en":"His tail like a strand of silk,"},{"id":"manas-2010:p1658:b001:l005","ordinal":71302,"en":"Lashed between his hind legs."},{"id":"manas-2010:p1658:b001:l006","ordinal":71303,"en":"If you watched your swift steed that day,"},{"id":"manas-2010:p1658:b001:l007","ordinal":71304,"en":"He lowered his head to the ground;"},{"id":"manas-2010:p1658:b001:l008","ordinal":71305,"en":"The wind could not match his trot,"},{"id":"manas-2010:p1658:b001:l009","ordinal":71306,"en":"He ran at his utmost speed."},{"id":"manas-2010:p1658:b001:l010","ordinal":71307,"en":"The times grew terribly straitened;"},{"id":"manas-2010:p1658:b001:l011","ordinal":71308,"en":"The dear lion, all alone,"},{"id":"manas-2010:p1658:b001:l012","ordinal":71309,"en":"Pleaded with Sarala."},{"id":"manas-2010:p1658:b001:l013","ordinal":71310,"en":"The reason for his pleading:"},{"id":"manas-2010:p1658:b001:l014","ordinal":71311,"en":"They united when tiny as lice,"},{"id":"manas-2010:p1658:b001:l015","ordinal":71312,"en":"Joined together when thumb-sized."},{"id":"manas-2010:p1658:b001:l016","ordinal":71313,"en":"Bathed in red blood,"},{"id":"manas-2010:p1658:b001:l017","ordinal":71314,"en":"Sarala pressed onward."},{"id":"manas-2010:p1658:b001:l018","ordinal":71315,"en":"That day the noble beast"},{"id":"manas-2010:p1658:b001:l019","ordinal":71316,"en":"Lowered his head to the ground,"},{"id":"manas-2010:p1658:b001:l020","ordinal":71317,"en":"His flesh had grown hot."},{"id":"manas-2010:p1658:b001:l021","ordinal":71318,"en":"The sun wheeled and was eclipsed;"},{"id":"manas-2010:p1658:b001:l022","ordinal":71319,"en":"Traveling day and night,"},{"id":"manas-2010:p1658:b001:l023","ordinal":71320,"en":"Swift indeed was Sarala—"},{"id":"manas-2010:p1658:b001:l024","ordinal":71321,"en":"At death's door, he escaped in flight."},{"id":"manas-2010:p1658:b001:l025","ordinal":71322,"en":"After ninety days of fighting through,"},{"id":"manas-2010:p1658:b001:l026","ordinal":71323,"en":"Your Alake emerged somewhere,"},{"id":"manas-2010:p1658:b001:l027","ordinal":71324,"en":"Wounded in nine places."},{"id":"manas-2010:p1658:b001:l028","ordinal":71325,"en":"That beauty of dark complexion,"},{"id":"manas-2010:p1658:b001:l029","ordinal":71326,"en":"The radiant one among the Muslims,"},{"id":"manas-2010:p1658:b001:l030","ordinal":71327,"en":"Your dear sister-in-law Kanykey,"},{"id":"manas-2010:p1658:b001:l031","ordinal":71328,"en":"For six months of hardship,"},{"id":"manas-2010:p1658:b001:l032","ordinal":71329,"en":"Had she not provided beforehand"},{"id":"manas-2010:p1658:b001:l033","ordinal":71330,"en":"A medicine called Sebep,"},{"id":"manas-2010:p1658:b001:l034","ordinal":71331,"en":"To her dear companion Almambet,"},{"id":"manas-2010:p1658:b001:l035","ordinal":71332,"en":"Had she not given it with honor?"},{"id":"manas-2010:p1658:b001:l036","ordinal":71333,"en":"“The strong-backed city of Beijing—"},{"id":"manas-2010:p1658:b001:l037","ordinal":71334,"en":"You are going into terrible hardship;"},{"id":"manas-2010:p1658:b001:l038","ordinal":71335,"en":"My Almam, you will fall into misery."},{"id":"manas-2010:p1658:b001:l039","ordinal":71336,"en":"When your suffering life is sorely strained,"},{"id":"manas-2010:p1658:b001:l040","ordinal":71337,"en":"When you are beside yourself,"},{"id":"manas-2010:p1658:b001:l041","ordinal":71338,"en":"Put it against your palate;"},{"id":"manas-2010:p1658:b001:l042","ordinal":71339,"en":"Your aching places will be eased,"},{"id":"manas-2010:p1659:b001:l001","ordinal":71340,"en":"Your eyes will open wide and clear.”"},{"id":"manas-2010:p1659:b001:l002","ordinal":71341,"en":"From her dear currant-like eyes,"},{"id":"manas-2010:p1659:b001:l003","ordinal":71342,"en":"Tears streamed a whip's length;"},{"id":"manas-2010:p1659:b001:l004","ordinal":71343,"en":"Had she not given it weeping?"},{"id":"manas-2010:p1659:b001:l005","ordinal":71344,"en":"Entrusting it as a solemn charge,"},{"id":"manas-2010:p1659:b001:l006","ordinal":71345,"en":"To a lord like your Alake,"},{"id":"manas-2010:p1659:b001:l007","ordinal":71346,"en":"Had she not given it with honor?"},{"id":"manas-2010:p1659:b001:l008","ordinal":71347,"en":"Baghdad and Egypt,"},{"id":"manas-2010:p1659:b001:l009","ordinal":71348,"en":"She had them both searched throughout;"},{"id":"manas-2010:p1659:b001:l010","ordinal":71349,"en":"To the face of the earth,"},{"id":"manas-2010:p1659:b001:l011","ordinal":71350,"en":"Your sister-in-law sent word everywhere."},{"id":"manas-2010:p1659:b001:l012","ordinal":71351,"en":"From that city of Mecca,"},{"id":"manas-2010:p1659:b001:l013","ordinal":71352,"en":"One medicine called Ebep,"},{"id":"manas-2010:p1659:b001:l014","ordinal":71353,"en":"One medicine called Sebep,"},{"id":"manas-2010:p1659:b001:l015","ordinal":71354,"en":"Your sister-in-law Kanykey had them brought."},{"id":"manas-2010:p1659:b001:l016","ordinal":71355,"en":"Twice, a thumb-tip's size,"},{"id":"manas-2010:p1659:b001:l017","ordinal":71356,"en":"The renowned champion put against his palate."},{"id":"manas-2010:p1659:b001:l018","ordinal":71357,"en":"Then his aching places eased,"},{"id":"manas-2010:p1659:b001:l019","ordinal":71358,"en":"Your Alake's eyes opened wide and clear."},{"id":"manas-2010:p1659:b001:l020","ordinal":71359,"en":"After seventy days of fighting through,"},{"id":"manas-2010:p1659:b001:l021","ordinal":71360,"en":"Wounded in seven places,"},{"id":"manas-2010:p1659:b001:l022","ordinal":71361,"en":"His Chubak emerged somewhere."},{"id":"manas-2010:p1659:b001:l023","ordinal":71362,"en":"When the dawn shone bright,"},{"id":"manas-2010:p1659:b001:l024","ordinal":71363,"en":"When light fell upon the earth,"},{"id":"manas-2010:p1659:b001:l025","ordinal":71364,"en":"The black, swift racing steeds"},{"id":"manas-2010:p1659:b001:l026","ordinal":71365,"en":"Had turned red."},{"id":"manas-2010:p1659:b001:l027","ordinal":71366,"en":"Khan Manas's forty fierce champions,"},{"id":"manas-2010:p1659:b001:l028","ordinal":71367,"en":"Having fought with tremendous might,"},{"id":"manas-2010:p1659:b001:l029","ordinal":71368,"en":"Had become separated."},{"id":"manas-2010:p1659:b001:l030","ordinal":71369,"en":"There is a plain called Chöl-Maydan;"},{"id":"manas-2010:p1659:b001:l031","ordinal":71370,"en":"The forty companions bore wounds everywhere."},{"id":"manas-2010:p1659:b001:l032","ordinal":71371,"en":"There were Ajybay and their khan Shuutu;"},{"id":"manas-2010:p1659:b001:l033","ordinal":71372,"en":"If you looked behind them,"},{"id":"manas-2010:p1659:b001:l034","ordinal":71373,"en":"All the people of the Islamic faith were there."},{"id":"manas-2010:p1659:b001:l035","ordinal":71374,"en":"Distraught, they stumbled about,"},{"id":"manas-2010:p1659:b001:l036","ordinal":71375,"en":"Unable to find a way, they trembled."},{"id":"manas-2010:p1659:b001:l037","ordinal":71376,"en":"Without their lions Almambet and Chubak,"},{"id":"manas-2010:p1659:b001:l038","ordinal":71377,"en":"The Muslims, finding no way out,"},{"id":"manas-2010:p1659:b001:l039","ordinal":71378,"en":"Had taken to flight."},{"id":"manas-2010:p1659:b001:l040","ordinal":71379,"en":"Through their center, Kongurbay,"},{"id":"manas-2010:p1659:b001:l041","ordinal":71380,"en":"Striking his way, pursued them."},{"id":"manas-2010:p1659:b001:l042","ordinal":71381,"en":"Along both flanks, Ezkara,"},{"id":"manas-2010:p1660:b001:l001","ordinal":71382,"en":"Came sweeping through."},{"id":"manas-2010:p1660:b001:l002","ordinal":71383,"en":"Those who had fallen from their horses,"},{"id":"manas-2010:p1660:b001:l003","ordinal":71384,"en":"The trick riders, swift on foot,"},{"id":"manas-2010:p1660:b001:l004","ordinal":71385,"en":"The state's champions,"},{"id":"manas-2010:p1660:b001:l005","ordinal":71386,"en":"Came cutting off their heads."},{"id":"manas-2010:p1660:b001:l006","ordinal":71387,"en":"The handful of Muslims,"},{"id":"manas-2010:p1660:b001:l007","ordinal":71388,"en":"Herding them before them,"},{"id":"manas-2010:p1660:b001:l008","ordinal":71389,"en":"They came striking at them."},{"id":"manas-2010:p1660:b001:l009","ordinal":71390,"en":"The Muslims could not pause long;"},{"id":"manas-2010:p1660:b001:l010","ordinal":71391,"en":"From outside, the many infidels"},{"id":"manas-2010:p1660:b001:l011","ordinal":71392,"en":"Came driving them onward."},{"id":"manas-2010:p1660:b001:l012","ordinal":71393,"en":"Of many swift, winged steeds,"},{"id":"manas-2010:p1660:b001:l013","ordinal":71394,"en":"Saddles and saddlecloths hung at their bellies;"},{"id":"manas-2010:p1660:b001:l014","ordinal":71395,"en":"They came leading them as spare mounts."},{"id":"manas-2010:p1660:b001:l015","ordinal":71396,"en":"“My precious, dear brother"},{"id":"manas-2010:p1660:b001:l016","ordinal":71397,"en":"Has met death at Chinese hands!”"},{"id":"manas-2010:p1660:b001:l017","ordinal":71398,"en":"They came crying aloud."},{"id":"manas-2010:p1660:b001:l018","ordinal":71399,"en":"The two khans, Koshoy and Töshtük—"},{"id":"manas-2010:p1660:b001:l019","ordinal":71400,"en":"The many Chinese raised an uproar"},{"id":"manas-2010:p1660:b001:l020","ordinal":71401,"en":"When they pursued them from behind."},{"id":"manas-2010:p1660:b001:l021","ordinal":71402,"en":"Unable to gather their wits, staggering,"},{"id":"manas-2010:p1660:b001:l022","ordinal":71403,"en":"The Muslims came fleeing;"},{"id":"manas-2010:p1660:b001:l023","ordinal":71404,"en":"In the desert of It-Ölbös,"},{"id":"manas-2010:p1660:b001:l024","ordinal":71405,"en":"They came fleeing in groups."},{"id":"manas-2010:p1660:b001:l025","ordinal":71406,"en":"“Leopard Chubak, Almambet,"},{"id":"manas-2010:p1660:b001:l026","ordinal":71407,"en":"Where have my khans gone?”"},{"id":"manas-2010:p1660:b001:l027","ordinal":71408,"en":"They came fleeing, lamenting their absence."},{"id":"manas-2010:p1660:b001:l028","ordinal":71409,"en":"When he saw the Muslims,"},{"id":"manas-2010:p1660:b001:l029","ordinal":71410,"en":"Unable to turn his swift steed's head,"},{"id":"manas-2010:p1660:b001:l030","ordinal":71411,"en":"Choking, weeping, sobbing,"},{"id":"manas-2010:p1660:b001:l031","ordinal":71412,"en":"Your peerless Alma could not stand still."},{"id":"manas-2010:p1660:b001:l032","ordinal":71413,"en":"Grasping his spear, struggling,"},{"id":"manas-2010:p1660:b001:l033","ordinal":71414,"en":"He pleaded with the forty warriors beside him:"},{"id":"manas-2010:p1660:b001:l034","ordinal":71415,"en":"“My dear forty companions,"},{"id":"manas-2010:p1660:b001:l035","ordinal":71416,"en":"Yesterday, in the hollow of Zhylgynduu,"},{"id":"manas-2010:p1660:b001:l036","ordinal":71417,"en":"Along broad Talas,"},{"id":"manas-2010:p1660:b001:l037","ordinal":71418,"en":"When the many Argyn came down to the plain,"},{"id":"manas-2010:p1660:b001:l038","ordinal":71419,"en":"When they were encamping,"},{"id":"manas-2010:p1660:b001:l039","ordinal":71420,"en":"With fermented mare's milk by day, girls by night,"},{"id":"manas-2010:p1660:b001:l040","ordinal":71421,"en":"When that was how things were,"},{"id":"manas-2010:p1660:b001:l041","ordinal":71422,"en":"The bulletproof black cap,"},{"id":"manas-2010:p1660:b001:l042","ordinal":71423,"en":"When you shaped its edge,"},{"id":"manas-2010:p1661:b001:l001","ordinal":71424,"en":"Knowing the Kyrgyz together,"}]
