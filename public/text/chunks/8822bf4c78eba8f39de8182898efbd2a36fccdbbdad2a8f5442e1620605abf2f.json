[{"id":"sayakbay-ms-current144:pdf087:l023","ordinal":393217,"en":"He gave away his suspicions."},{"id":"sayakbay-ms-current144:pdf087:l024","ordinal":393218,"en":"[The day's provisions …,]"},{"id":"sayakbay-ms-current144:pdf087:l025","ordinal":393219,"en":"The weather turned, barring the road,"},{"id":"sayakbay-ms-current144:pdf087:l026","ordinal":393220,"en":"Driving the horses in a thundering herd,"},{"id":"sayakbay-ms-current144:pdf087:l027","ordinal":393221,"en":"Come, wise one, let us flee."},{"id":"sayakbay-ms-current144:pdf087:l028","ordinal":393222,"en":"[The dark enemy, to the Kyrgyz,]"},{"id":"sayakbay-ms-current144:pdf087:l029","ordinal":393223,"en":"[He has high ground and a purpose,]"},{"id":"sayakbay-ms-current144:pdf087:l030","ordinal":393224,"en":"[Saying they are a fierce, dreadful people,]"},{"id":"sayakbay-ms-current144:pdf088:l001","ordinal":393225,"en":"If a Chinese person fell into his hands,"},{"id":"sayakbay-ms-current144:pdf088:l002","ordinal":393226,"en":"He shed their blood without flinching,"},{"id":"sayakbay-ms-current144:pdf088:l003","ordinal":393227,"en":"Such was the custom among these Kyrgyz."},{"id":"sayakbay-ms-current144:pdf088:l004","ordinal":393228,"en":"[From our fathers, his forefather,]"},{"id":"sayakbay-ms-current144:pdf088:l005","ordinal":393229,"en":"Drinking blood, never drawing back,"},{"id":"sayakbay-ms-current144:pdf088:l006","ordinal":393230,"en":"Until entering the earth in death,"},{"id":"sayakbay-ms-current144:pdf088:l008","ordinal":393231,"en":"[Led by that accursed fool,]"},{"id":"sayakbay-ms-current144:pdf088:l009","ordinal":393232,"en":"If you fail to notice, great sage,"},{"id":"sayakbay-ms-current144:pdf088:l010","ordinal":393233,"en":"He will bring us great trouble."},{"id":"sayakbay-ms-current144:pdf088:l011","ordinal":393234,"en":"Your father and forefathers,"},{"id":"sayakbay-ms-current144:pdf088:l012","ordinal":393235,"en":"[Straining, that devouring fiend,]"},{"id":"sayakbay-ms-current144:pdf088:l013","ordinal":393236,"en":"The hero truly overwhelms one's strength."},{"id":"sayakbay-ms-current144:pdf088:l014","ordinal":393237,"en":"In combat, you cannot match him,"},{"id":"sayakbay-ms-current144:pdf088:l015","ordinal":393238,"en":"[The forty khanates all around,]"},{"id":"sayakbay-ms-current144:pdf088:l016","ordinal":393239,"en":"[Their mountains high, their land …,]"},{"id":"sayakbay-ms-current144:pdf088:l017","ordinal":393240,"en":"He killed those who ruled,"},{"id":"sayakbay-ms-current144:pdf088:l018","ordinal":393241,"en":"No number of emperors can defeat him,"},{"id":"sayakbay-ms-current144:pdf088:l019","ordinal":393242,"en":"Even after countless thousands of years,"},{"id":"sayakbay-ms-current144:pdf088:l020","ordinal":393243,"en":"Our Chinese people cannot avenge themselves,"},{"id":"sayakbay-ms-current144:pdf088:l021","ordinal":393244,"en":"Once coming to fight, he never withdrew,"},{"id":"sayakbay-ms-current144:pdf088:l022","ordinal":393245,"en":"The offspring of the cunning Burut."},{"id":"sayakbay-ms-current144:pdf088:l023","ordinal":393246,"en":"Brandishing a mottled blue shield,"},{"id":"sayakbay-ms-current144:pdf088:l024","ordinal":393247,"en":"Never sated when tasting blood,"},{"id":"sayakbay-ms-current144:pdf088:l025","ordinal":393248,"en":"Told to drink water, he drank poison,"},{"id":"sayakbay-ms-current144:pdf088:l026","ordinal":393249,"en":"They have leveled their spears,"},{"id":"sayakbay-ms-current144:pdf088:l027","ordinal":393250,"en":"[The bannered warrior …,]"},{"id":"sayakbay-ms-current144:pdf088:l028","ordinal":393251,"en":"[A people not overcome by frenzy,]"},{"id":"sayakbay-ms-current144:pdf088:l029","ordinal":393252,"en":"[One who flails, falls, and dies,]"},{"id":"sayakbay-ms-current144:pdf088:l030","ordinal":393253,"en":"This is towering Ala-Too,"},{"id":"sayakbay-ms-current144:pdf089:l001","ordinal":393254,"en":"Let us turn our horses' rumps toward them,"},{"id":"sayakbay-ms-current144:pdf089:l002","ordinal":393255,"en":"Let us ride along the plain,"},{"id":"sayakbay-ms-current144:pdf089:l003","ordinal":393256,"en":"If we do not turn our horses away,"},{"id":"sayakbay-ms-current144:pdf089:l004","ordinal":393257,"en":"If we do not follow the plain,"},{"id":"sayakbay-ms-current144:pdf089:l005","ordinal":393258,"en":"We shall suffer strange humiliation,"},{"id":"sayakbay-ms-current144:pdf089:l006","ordinal":393259,"en":"We shall suffer greatly from the Kyrgyz,"},{"id":"sayakbay-ms-current144:pdf089:l007","ordinal":393260,"en":"The humiliation our grandfathers suffered."},{"id":"sayakbay-ms-current144:pdf089:l008","ordinal":393261,"en":"So the giant Küchük spoke at length,"},{"id":"sayakbay-ms-current144:pdf089:l009","ordinal":393262,"en":"The giant Küchük caused great turmoil."},{"id":"sayakbay-ms-current144:pdf089:l011","ordinal":393263,"en":"Like a great cauldron boiling food,"},{"id":"sayakbay-ms-current144:pdf089:l015","ordinal":393264,"en":"You are an infidel calling himself a hero,"},{"id":"sayakbay-ms-current144:pdf089:l018","ordinal":393265,"en":"[These eyes have seen your forefathers,]"},{"id":"sayakbay-ms-current144:pdf089:l019","ordinal":393266,"en":"Look at these words of yours,"},{"id":"sayakbay-ms-current144:pdf089:l023","ordinal":393267,"en":"Uttering coarse, wicked words,"},{"id":"sayakbay-ms-current144:pdf089:l025","ordinal":393268,"en":"Posing as a hero, boasting of bravery,"},{"id":"sayakbay-ms-current144:pdf089:l026","ordinal":393269,"en":"You make the champion roar."},{"id":"sayakbay-ms-current144:pdf089:l027","ordinal":393270,"en":"[Why do you begin this struggle,]"},{"id":"sayakbay-ms-current144:pdf089:l030","ordinal":393271,"en":"Does one not die when his hour comes?"},{"id":"sayakbay-ms-current144:pdf089:l031","ordinal":393272,"en":"[Does your appearance not look empty?]"},{"id":"sayakbay-ms-current144:pdf089:l032","ordinal":393273,"en":"[When boasting with your tongue,]"},{"id":"sayakbay-ms-current144:pdf090:l001","ordinal":393274,"en":"This was what he saw then."},{"id":"sayakbay-ms-current144:pdf090:l002","ordinal":393275,"en":"[With no presence, no heart,]"},{"id":"sayakbay-ms-current144:pdf090:l004","ordinal":393276,"en":"Burning his world behind him,"},{"id":"sayakbay-ms-current144:pdf090:l006","ordinal":393277,"en":"The near edge of the Burut lands,"},{"id":"sayakbay-ms-current144:pdf090:l007","ordinal":393278,"en":"Will they not say he had seen it?"},{"id":"sayakbay-ms-current144:pdf090:l008","ordinal":393279,"en":"Unless his allotted death took him,"},{"id":"sayakbay-ms-current144:pdf090:l010","ordinal":393280,"en":"[From afar, speaking behind his back,]"},{"id":"sayakbay-ms-current144:pdf090:l012","ordinal":393281,"en":"Giant Küchük, ignorant one, sink into the earth,"},{"id":"sayakbay-ms-current144:pdf090:l013","ordinal":393282,"en":"Who would listen to these words of yours?"},{"id":"sayakbay-ms-current144:pdf090:l014","ordinal":393283,"en":"Let the blinding night hear them,"},{"id":"sayakbay-ms-current144:pdf090:l015","ordinal":393284,"en":"Let unnoticed waters hear them,"},{"id":"sayakbay-ms-current144:pdf090:l016","ordinal":393285,"en":"[Let the loud tumult hear them.]"},{"id":"sayakbay-ms-current144:pdf090:l017","ordinal":393286,"en":"Is this what you say now?"},{"id":"sayakbay-ms-current144:pdf090:l019","ordinal":393287,"en":"[The measure of these words,]"},{"id":"sayakbay-ms-current144:pdf090:l020","ordinal":393288,"en":"Let the dog striking the threshold hear,"},{"id":"sayakbay-ms-current144:pdf090:l021","ordinal":393289,"en":"[Let the beast and bird that cry hear,]"},{"id":"sayakbay-ms-current144:pdf090:l022","ordinal":393290,"en":"Who else should hear such words?"},{"id":"sayakbay-ms-current144:pdf090:l023","ordinal":393291,"en":"[Yesterday, when night fell upon the mountain,]"},{"id":"sayakbay-ms-current144:pdf090:l024","ordinal":393292,"en":"The people gathered, the nation stood,"},{"id":"sayakbay-ms-current144:pdf090:l025","ordinal":393293,"en":"Those called male kinsmen,"},{"id":"sayakbay-ms-current144:pdf090:l026","ordinal":393294,"en":"So many rams, so much livestock,"},{"id":"sayakbay-ms-current144:pdf090:l027","ordinal":393295,"en":"They gave as gifts for glad tidings,"},{"id":"sayakbay-ms-current144:pdf090:l028","ordinal":393296,"en":"Calling him a man who would defend honor,"},{"id":"sayakbay-ms-current144:pdf090:l029","ordinal":393297,"en":"They called him protector of the people."},{"id":"sayakbay-ms-current144:pdf090:l030","ordinal":393298,"en":"Perish if you do not protect the people,"},{"id":"sayakbay-ms-current144:pdf090:l031","ordinal":393299,"en":"Die rather than fail to be a man,"},{"id":"sayakbay-ms-current144:pdf090:l032","ordinal":393300,"en":"You spoke before your kinsmen,"},{"id":"sayakbay-ms-current144:pdf091:l001","ordinal":393301,"en":"[Hey, sunk before you were even born,]"},{"id":"sayakbay-ms-current144:pdf091:l002","ordinal":393302,"en":"You made your people tremble,"},{"id":"sayakbay-ms-current144:pdf091:l004","ordinal":393303,"en":"Without resource, without honor,"},{"id":"sayakbay-ms-current144:pdf091:l005","ordinal":393304,"en":"[Roaring, he drove them into hardship.]"},{"id":"sayakbay-ms-current144:pdf091:l006","ordinal":393305,"en":"Licking your sword, swaggering,"},{"id":"sayakbay-ms-current144:pdf091:l010","ordinal":393306,"en":"For the honor of the people,"},{"id":"sayakbay-ms-current144:pdf091:l012","ordinal":393307,"en":"I will act bravely, stout of heart,"},{"id":"sayakbay-ms-current144:pdf091:l014","ordinal":393308,"en":"[One gift of the Chinese,]"},{"id":"sayakbay-ms-current144:pdf091:l015","ordinal":393309,"en":"You said you would take it."},{"id":"sayakbay-ms-current144:pdf091:l016","ordinal":393310,"en":"Destroying their people, to their roots,"},{"id":"sayakbay-ms-current144:pdf091:l017","ordinal":393311,"en":"You said you would reach them!"},{"id":"sayakbay-ms-current144:pdf091:l018","ordinal":393312,"en":"Thus the great sage reproached him,"},{"id":"sayakbay-ms-current144:pdf091:l019","ordinal":393313,"en":"Muttering in fury,"},{"id":"sayakbay-ms-current144:pdf091:l020","ordinal":393314,"en":"Scolding harshly, thundering,"},{"id":"sayakbay-ms-current144:pdf091:l021","ordinal":393315,"en":"[He now drew the great arrow.]"},{"id":"sayakbay-ms-current144:pdf091:l022","ordinal":393316,"en":"[With the presence of such a man,]"},{"id":"sayakbay-ms-current144:pdf091:l023","ordinal":393317,"en":"[Without wearing them down or bewildering them,]"},{"id":"sayakbay-ms-current144:pdf091:l024","ordinal":393318,"en":"Seize him, cut off his head, he said."},{"id":"sayakbay-ms-current144:pdf091:l025","ordinal":393319,"en":"[When he shouted from among the people,]"},{"id":"sayakbay-ms-current144:pdf091:l027","ordinal":393320,"en":"Would they merely stand and watch?"},{"id":"sayakbay-ms-current144:pdf091:l028","ordinal":393321,"en":"Since he was the people's leader,"},{"id":"sayakbay-ms-current144:pdf091:l029","ordinal":393322,"en":"What choice had the two giants?"},{"id":"sayakbay-ms-current144:pdf091:l030","ordinal":393323,"en":"His champion who drew the bow,"},{"id":"sayakbay-ms-current144:pdf091:l031","ordinal":393324,"en":"Took his bow from the ground,"},{"id":"sayakbay-ms-current144:pdf092:l001","ordinal":393325,"en":"Beside that sage,"},{"id":"sayakbay-ms-current144:pdf092:l003","ordinal":393326,"en":"[Broad-chested, with a sweeping presence,]"},{"id":"sayakbay-ms-current144:pdf092:l004","ordinal":393327,"en":"[He also had his mounted attendants,]"},{"id":"sayakbay-ms-current144:pdf092:l005","ordinal":393328,"en":"Who took heads at a command,"},{"id":"sayakbay-ms-current144:pdf092:l006","ordinal":393329,"en":"Long accustomed to the khan's orders,"},{"id":"sayakbay-ms-current144:pdf092:l007","ordinal":393330,"en":"He had such infidels too."},{"id":"sayakbay-ms-current144:pdf092:l009","ordinal":393331,"en":"Drew their swords from their sheaths,"},{"id":"sayakbay-ms-current144:pdf092:l010","ordinal":393332,"en":"Rolled up their cutting arms' sleeves,"},{"id":"sayakbay-ms-current144:pdf092:l015","ordinal":393333,"en":"The very destroyer of the people,"},{"id":"sayakbay-ms-current144:pdf092:l016","ordinal":393334,"en":"No true kinsman to my people,"},{"id":"sayakbay-ms-current144:pdf092:l017","ordinal":393335,"en":"Wicked to his roots,"},{"id":"sayakbay-ms-current144:pdf092:l018","ordinal":393336,"en":"They cut off his head with a sword,"},{"id":"sayakbay-ms-current144:pdf092:l019","ordinal":393337,"en":"Küchük, who had spoken the truth,"},{"id":"sayakbay-ms-current144:pdf092:l025","ordinal":393338,"en":"Destroying his own executioner,"},{"id":"sayakbay-ms-current144:pdf092:l027","ordinal":393339,"en":"He killed his own kinsman,"},{"id":"sayakbay-ms-current144:pdf092:l028","ordinal":393340,"en":"To whom would he remain loyal?"},{"id":"sayakbay-ms-current144:pdf092:l031","ordinal":393341,"en":"To the champion who strode forward,"},{"id":"sayakbay-ms-current144:pdf092:l032","ordinal":393342,"en":"Pouring out his wrath, making them rigid,"},{"id":"sayakbay-ms-current144:pdf093:l001","ordinal":393343,"en":"If we speak, he will kill us, they thought,"},{"id":"sayakbay-ms-current144:pdf093:l002","ordinal":393344,"en":"[He spoke threatening words.]"},{"id":"sayakbay-ms-current144:pdf093:l003","ordinal":393345,"en":"The Chinese numbered forty thousand,"},{"id":"sayakbay-ms-current144:pdf093:l004","ordinal":393346,"en":"[Calling that mountain of humiliation foolish,]"},{"id":"sayakbay-ms-current144:pdf093:l005","ordinal":393347,"en":"He made the promise firm."},{"id":"sayakbay-ms-current144:pdf093:l006","ordinal":393348,"en":"Saying I was not afraid is one statement,"},{"id":"sayakbay-ms-current144:pdf093:l007","ordinal":393349,"en":"Saying I was afraid is a thousand words,"},{"id":"sayakbay-ms-current144:pdf093:l008","ordinal":393350,"en":"[Troubled by what they heard,]"},{"id":"sayakbay-ms-current144:pdf093:l009","ordinal":393351,"en":"[His battle cry cast its shadow.]"},{"id":"sayakbay-ms-current144:pdf093:l012","ordinal":393352,"en":"[They began their ruler's assigned duty.]"},{"id":"sayakbay-ms-current144:pdf093:l013","ordinal":393353,"en":"[Even if you kill me, I do not know,]"},{"id":"sayakbay-ms-current144:pdf093:l014","ordinal":393354,"en":"After that, what they had seen,"},{"id":"sayakbay-ms-current144:pdf093:l015","ordinal":393355,"en":"They dismissed with I was not afraid."},{"id":"sayakbay-ms-current144:pdf093:l016","ordinal":393356,"en":"The people cried out and grieved,"},{"id":"sayakbay-ms-current144:pdf093:l017","ordinal":393357,"en":"The sorrowful champion stood there."},{"id":"sayakbay-ms-current144:pdf093:l018","ordinal":393358,"en":"Then the great sage,"},{"id":"sayakbay-ms-current144:pdf093:l020","ordinal":393359,"en":"[Performing weather spells and incantations,]"},{"id":"sayakbay-ms-current144:pdf093:l021","ordinal":393360,"en":"[Mounted, the mighty marksman,]"},{"id":"sayakbay-ms-current144:pdf093:l022","ordinal":393361,"en":"One who came but once into the world,"},{"id":"sayakbay-ms-current144:pdf093:l023","ordinal":393362,"en":"When drawing a bow, he never missed,"},{"id":"sayakbay-ms-current144:pdf093:l024","ordinal":393363,"en":"In combat, he made his foes bleed,"},{"id":"sayakbay-ms-current144:pdf093:l025","ordinal":393364,"en":"[The mightiest of the terrible fiends,]"},{"id":"sayakbay-ms-current144:pdf093:l026","ordinal":393365,"en":"The stoutest, never flinching,"},{"id":"sayakbay-ms-current144:pdf093:l027","ordinal":393366,"en":"To him, Joltoy's fame,"},{"id":"sayakbay-ms-current144:pdf093:l028","ordinal":393367,"en":"Was truly well known,"},{"id":"sayakbay-ms-current144:pdf093:l029","ordinal":393368,"en":"[For him, true hardship …,]"},{"id":"sayakbay-ms-current144:pdf093:l030","ordinal":393369,"en":"[This was the head of …,]"},{"id":"sayakbay-ms-current144:pdf093:l031","ordinal":393370,"en":"His first word was never contradicted,"},{"id":"sayakbay-ms-current144:pdf093:l032","ordinal":393371,"en":"Even when sending word through the ages,"},{"id":"sayakbay-ms-current144:pdf094:l001","ordinal":393372,"en":"Of this accursed slave,"},{"id":"sayakbay-ms-current144:pdf094:l002","ordinal":393373,"en":"His deeds were not genuine."},{"id":"sayakbay-ms-current144:pdf094:l003","ordinal":393374,"en":"He was their chief, their khan,"},{"id":"sayakbay-ms-current144:pdf094:l004","ordinal":393375,"en":"[This was the city where he set foot,]"},{"id":"sayakbay-ms-current144:pdf094:l005","ordinal":393376,"en":"This was their unshaken fortress,"},{"id":"sayakbay-ms-current144:pdf094:l006","ordinal":393377,"en":"This was their unwavering warrior."},{"id":"sayakbay-ms-current144:pdf094:l007","ordinal":393378,"en":"The great sage, without haste,"},{"id":"sayakbay-ms-current144:pdf094:l008","ordinal":393379,"en":"Let whichever Burut come, he said,"},{"id":"sayakbay-ms-current144:pdf094:l009","ordinal":393380,"en":"[From where had these warriors gathered?]"},{"id":"sayakbay-ms-current144:pdf094:l010","ordinal":393381,"en":"Great Köbük, who came from Beijing,"},{"id":"sayakbay-ms-current144:pdf094:l012","ordinal":393382,"en":"Wearing an arrow-proof coat of armor,"},{"id":"sayakbay-ms-current144:pdf094:l013","ordinal":393383,"en":"Riding a horse no arrow could catch,"},{"id":"sayakbay-ms-current144:pdf094:l014","ordinal":393384,"en":"Taking a spear like a pine tree,"},{"id":"sayakbay-ms-current144:pdf094:l015","ordinal":393385,"en":"[His path swelled as large as a house,]"},{"id":"sayakbay-ms-current144:pdf094:l016","ordinal":393386,"en":"So the frightened Burut would flee,"},{"id":"sayakbay-ms-current144:pdf094:l017","ordinal":393387,"en":"Before his majesty and wrath,"},{"id":"sayakbay-ms-current144:pdf094:l018","ordinal":393388,"en":"[Before his dreadful fury,]"},{"id":"sayakbay-ms-current144:pdf094:l020","ordinal":393389,"en":"Would sink beneath the earth,"},{"id":"sayakbay-ms-current144:pdf094:l023","ordinal":393390,"en":"Despairing of his precious life,"},{"id":"sayakbay-ms-current144:pdf094:l024","ordinal":393391,"en":"Let him flee in terror and confusion."},{"id":"sayakbay-ms-current144:pdf094:l025","ordinal":393392,"en":"[His stature appearing overwhelming,]"},{"id":"sayakbay-ms-current144:pdf094:l026","ordinal":393393,"en":"Standing apart from ninety kinds,"},{"id":"sayakbay-ms-current144:pdf094:l027","ordinal":393394,"en":"A mountain supporting the sky,"},{"id":"sayakbay-ms-current144:pdf094:l028","ordinal":393395,"en":"Raging, imposing his will,"},{"id":"sayakbay-ms-current144:pdf094:l029","ordinal":393396,"en":"[Draining so many, raising an uproar,]"},{"id":"sayakbay-ms-current144:pdf095:l001","ordinal":393397,"en":"[Loading the Onogor with shot,]"},{"id":"sayakbay-ms-current144:pdf095:l002","ordinal":393398,"en":"That fearsome madman,"},{"id":"sayakbay-ms-current144:pdf095:l003","ordinal":393399,"en":"[A coarse steel belt of terror,]"},{"id":"sayakbay-ms-current144:pdf095:l004","ordinal":393400,"en":"Fastening it neatly to his saddle straps,"},{"id":"sayakbay-ms-current144:pdf095:l005","ordinal":393401,"en":"That practiced wretch,"},{"id":"sayakbay-ms-current144:pdf095:l006","ordinal":393402,"en":"Setting the shield above his head,"},{"id":"sayakbay-ms-current144:pdf095:l010","ordinal":393403,"en":"The madman's war drum,"},{"id":"sayakbay-ms-current144:pdf095:l011","ordinal":393404,"en":"[Hearing its sound, you would be struck down.]"},{"id":"sayakbay-ms-current144:pdf095:l012","ordinal":393405,"en":"[His champion struck it to sound,]"},{"id":"sayakbay-ms-current144:pdf095:l014","ordinal":393406,"en":"[Their wits simply fled.]"},{"id":"sayakbay-ms-current144:pdf095:l015","ordinal":393407,"en":"That Chinese warrior, mad at heart,"},{"id":"sayakbay-ms-current144:pdf095:l017","ordinal":393408,"en":"Know for yourself, lord,"},{"id":"sayakbay-ms-current144:pdf095:l018","ordinal":393409,"en":"Its girth was three fathoms,"},{"id":"sayakbay-ms-current144:pdf095:l019","ordinal":393410,"en":"[Simply breaking the …,]"},{"id":"sayakbay-ms-current144:pdf095:l020","ordinal":393411,"en":"[Visible across the face of the earth.]"},{"id":"sayakbay-ms-current144:pdf095:l023","ordinal":393412,"en":"Alabash, the mighty stallion,"},{"id":"sayakbay-ms-current144:pdf095:l024","ordinal":393413,"en":"[That wild one panicked,]"},{"id":"sayakbay-ms-current144:pdf095:l025","ordinal":393414,"en":"Fine steeds and swift chargers mingled,"},{"id":"sayakbay-ms-current144:pdf095:l026","ordinal":393415,"en":"The earth shook with their thunder,"},{"id":"sayakbay-ms-current144:pdf095:l027","ordinal":393416,"en":"[Red roans with flowing manes,]"},{"id":"sayakbay-ms-current144:pdf095:l028","ordinal":393417,"en":"[Toward where Seytek stood some distance away,]"},{"id":"sayakbay-ms-current144:pdf095:l029","ordinal":393418,"en":"Stampeding from the plain, thundering,"},{"id":"sayakbay-ms-current144:pdf095:l031","ordinal":393419,"en":"More than a hundred horses,"},{"id":"sayakbay-ms-current144:pdf096:l001","ordinal":393420,"en":"Some had hindquarters left,"},{"id":"sayakbay-ms-current144:pdf096:l002","ordinal":393421,"en":"Some had their faces left,"},{"id":"sayakbay-ms-current144:pdf096:l003","ordinal":393422,"en":"[Devouring the stiffened, fat yearlings,]"},{"id":"sayakbay-ms-current144:pdf096:l004","ordinal":393423,"en":"[Devouring those alongside in the open,]"},{"id":"sayakbay-ms-current144:pdf096:l005","ordinal":393424,"en":"[The herdsman, caught up in excitement,]"},{"id":"sayakbay-ms-current144:pdf096:l006","ordinal":393425,"en":"Had not remained asleep,"},{"id":"sayakbay-ms-current144:pdf096:l007","ordinal":393426,"en":"Those accursed wretches,"},{"id":"sayakbay-ms-current144:pdf096:l008","ordinal":393427,"en":"[They were left in their trousers,]"},{"id":"sayakbay-ms-current144:pdf096:l009","ordinal":393428,"en":"Those sprawled out sleeping,"},{"id":"sayakbay-ms-current144:pdf096:l012","ordinal":393429,"en":"Leaping and bounding,"},{"id":"sayakbay-ms-current144:pdf096:l013","ordinal":393430,"en":"Speaking as though still asleep,"},{"id":"sayakbay-ms-current144:pdf096:l015","ordinal":393431,"en":"They rounded up the horses,"},{"id":"sayakbay-ms-current144:pdf096:l017","ordinal":393432,"en":"Striking with his catching pole."},{"id":"sayakbay-ms-current144:pdf096:l018","ordinal":393433,"en":"Then the great sage,"},{"id":"sayakbay-ms-current144:pdf096:l019","ordinal":393434,"en":"[The steadfast warrior Ichig,]"},{"id":"sayakbay-ms-current144:pdf096:l020","ordinal":393435,"en":"[His divination vast as the sea,]"},{"id":"sayakbay-ms-current144:pdf096:l021","ordinal":393436,"en":"[The faultless warrior that day,]"},{"id":"sayakbay-ms-current144:pdf096:l023","ordinal":393437,"en":"Raising a tumult like the world's end,"},{"id":"sayakbay-ms-current144:pdf096:l024","ordinal":393438,"en":"Driving all the horses from the plain,"},{"id":"sayakbay-ms-current144:pdf096:l025","ordinal":393439,"en":"[Sweeping through in a dark mass,]"},{"id":"sayakbay-ms-current144:pdf096:l027","ordinal":393440,"en":"[At that place, his horses,]"},{"id":"sayakbay-ms-current144:pdf096:l028","ordinal":393441,"en":"He raged, wreaking slaughter."},{"id":"sayakbay-ms-current144:pdf096:l030","ordinal":393442,"en":"[Drawing his bow in pursuit,]"},{"id":"sayakbay-ms-current144:pdf096:l031","ordinal":393443,"en":"Thundering when a raven flew,"},{"id":"sayakbay-ms-current144:pdf096:l032","ordinal":393444,"en":"Shooting it without letting it escape,"},{"id":"sayakbay-ms-current144:pdf097:l001","ordinal":393445,"en":"Pouring out his wrath, bellowing,"},{"id":"sayakbay-ms-current144:pdf097:l004","ordinal":393446,"en":"Driving the horses off to the right,"},{"id":"sayakbay-ms-current144:pdf097:l005","ordinal":393447,"en":"[Turning them back with his whip,]"},{"id":"sayakbay-ms-current144:pdf097:l006","ordinal":393448,"en":"[Your mighty warrior along the ridge,]"},{"id":"sayakbay-ms-current144:pdf097:l007","ordinal":393449,"en":"Went on doing so,"},{"id":"sayakbay-ms-current144:pdf097:l008","ordinal":393450,"en":"[The horses veering aside,]"},{"id":"sayakbay-ms-current144:pdf097:l009","ordinal":393451,"en":"Cutting them down in heaps,"},{"id":"sayakbay-ms-current144:pdf097:l010","ordinal":393452,"en":"He went on slaughtering them,"},{"id":"sayakbay-ms-current144:pdf097:l012","ordinal":393453,"en":"He went on bringing it."},{"id":"sayakbay-ms-current144:pdf097:l014","ordinal":393454,"en":"Roaring in a show of might,"},{"id":"sayakbay-ms-current144:pdf097:l015","ordinal":393455,"en":"Calling his champions,"},{"id":"sayakbay-ms-current144:pdf097:l016","ordinal":393456,"en":"Is there anyone who will strike straight?"},{"id":"sayakbay-ms-current144:pdf097:l017","ordinal":393457,"en":"[While your troubled head remains,]"},{"id":"sayakbay-ms-current144:pdf097:l018","ordinal":393458,"en":"From the ruined Burut people,"},{"id":"sayakbay-ms-current144:pdf097:l019","ordinal":393459,"en":"Where is the bold one to face me?"},{"id":"sayakbay-ms-current144:pdf097:l020","ordinal":393460,"en":"He has a mighty steed beneath him,"},{"id":"sayakbay-ms-current144:pdf097:l021","ordinal":393461,"en":"[It is not the ruined Burut nation,]"},{"id":"sayakbay-ms-current144:pdf097:l022","ordinal":393462,"en":"Even if the world's khans gather,"},{"id":"sayakbay-ms-current144:pdf097:l023","ordinal":393463,"en":"I have strength to subdue them."},{"id":"sayakbay-ms-current144:pdf097:l024","ordinal":393464,"en":"If life should remain by chance,"},{"id":"sayakbay-ms-current144:pdf097:l025","ordinal":393465,"en":"If death should strike unexpectedly,"},{"id":"sayakbay-ms-current144:pdf097:l026","ordinal":393466,"en":"[I possess formidable, untouchable strength,]"},{"id":"sayakbay-ms-current144:pdf097:l027","ordinal":393467,"en":"[One who asks of your condition,]"},{"id":"sayakbay-ms-current144:pdf097:l028","ordinal":393468,"en":"You have the renowned khan Kiche."},{"id":"sayakbay-ms-current144:pdf097:l029","ordinal":393469,"en":"While that Kiche stands,"},{"id":"sayakbay-ms-current144:pdf097:l030","ordinal":393470,"en":"[I have my people in Kayser.]"},{"id":"sayakbay-ms-current144:pdf098:l001","ordinal":393471,"en":"Subduing the whole world,"},{"id":"sayakbay-ms-current144:pdf098:l002","ordinal":393472,"en":"I have strength to take it all."}]
