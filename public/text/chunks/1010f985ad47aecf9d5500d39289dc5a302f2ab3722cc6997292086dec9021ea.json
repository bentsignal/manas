[{"id":"semetey-1-2013:p1062:b004:l016","ordinal":158209,"en":"They will level the deepest fortress"},{"id":"semetey-1-2013:p1062:b004:l017","ordinal":158210,"en":"And slaughter every one of us."},{"id":"semetey-1-2013:p1062:b004:l018","ordinal":158211,"en":"He has seized and plundered the people;"},{"id":"semetey-1-2013:p1062:b004:l019","ordinal":158212,"en":"If we do not give you first,"},{"id":"semetey-1-2013:p1062:b004:l020","ordinal":158213,"en":"A force as great as the Zhediger will come,"},{"id":"semetey-1-2013:p1062:b004:l021","ordinal":158214,"en":"So numerous the earth will sag."},{"id":"semetey-1-2013:p1062:b004:l022","ordinal":158215,"en":"My dear Chürökbay,"},{"id":"semetey-1-2013:p1062:b004:l023","ordinal":158216,"en":"If you heed our words,"},{"id":"semetey-1-2013:p1062:b004:l024","ordinal":158217,"en":"He too is a father's son;"},{"id":"semetey-1-2013:p1062:b004:l025","ordinal":158218,"en":"Go to brave Toltoy."},{"id":"semetey-1-2013:p1062:b004:l026","ordinal":158219,"en":"If you go to Toltoy and die,"},{"id":"semetey-1-2013:p1062:b004:l027","ordinal":158220,"en":"We shall see your bones;"},{"id":"semetey-1-2013:p1062:b004:l028","ordinal":158221,"en":"Saying, 'She became her people's shield,'"},{"id":"semetey-1-2013:p1062:b004:l029","ordinal":158222,"en":"We shall have a tomb of gold built"},{"id":"semetey-1-2013:p1062:b004:l030","ordinal":158223,"en":"And bury you exactly so."},{"id":"semetey-1-2013:p1062:b004:l031","ordinal":158224,"en":"Understand well all I have said;"},{"id":"semetey-1-2013:p1062:b004:l032","ordinal":158225,"en":"My golden Chürök, heed my words!"},{"id":"semetey-1-2013:p1062:b004:l033","ordinal":158226,"en":"If you do not heed our words,"},{"id":"semetey-1-2013:p1062:b004:l034","ordinal":158227,"en":"If you do not go to brave Toltoy,"},{"id":"semetey-1-2013:p1062:b004:l035","ordinal":158228,"en":"They will water their orchards"},{"id":"semetey-1-2013:p1062:b004:l036","ordinal":158229,"en":"And turn this place into gardens;"},{"id":"semetey-1-2013:p1062:b004:l037","ordinal":158230,"en":"They will take your aged father Akun"},{"id":"semetey-1-2013:p1062:b004:l038","ordinal":158231,"en":"And make him gather firewood;"},{"id":"semetey-1-2013:p1062:b004:l039","ordinal":158232,"en":"If the Zhediger take us in their wrath—"},{"id":"semetey-1-2013:p1063:b003:l001","ordinal":158233,"en":"If they suddenly overrun us,"},{"id":"semetey-1-2013:p1063:b003:l002","ordinal":158234,"en":"If they unexpectedly make war,"},{"id":"semetey-1-2013:p1063:b003:l003","ordinal":158235,"en":"All Afghanistan standing here—"},{"id":"semetey-1-2013:p1063:b003:l004","ordinal":158236,"en":"They will pass through and slaughter it all."},{"id":"semetey-1-2013:p1063:b003:l005","ordinal":158237,"en":"Their army can enter over ridge after ridge;"},{"id":"semetey-1-2013:p1063:b003:l006","ordinal":158238,"en":"If we say we will not give you, sister,"},{"id":"semetey-1-2013:p1063:b003:l007","ordinal":158239,"en":"Advancing to overwhelm us,"},{"id":"semetey-1-2013:p1063:b003:l008","ordinal":158240,"en":"They have their renowned great Kozho!"},{"id":"semetey-1-2013:p1063:b003:l009","ordinal":158241,"en":"To overrun us together,"},{"id":"semetey-1-2013:p1063:b003:l010","ordinal":158242,"en":"To destroy us all together,"},{"id":"semetey-1-2013:p1063:b003:l011","ordinal":158243,"en":"They have the army of the Zhediger;"},{"id":"semetey-1-2013:p1063:b003:l012","ordinal":158244,"en":"Who, once aroused, spares no soul—"},{"id":"semetey-1-2013:p1063:b003:l013","ordinal":158245,"en":"They have mighty Toltoy."},{"id":"semetey-1-2013:p1063:b003:l014","ordinal":158246,"en":"If we do not agree to what he says,"},{"id":"semetey-1-2013:p1063:b003:l015","ordinal":158247,"en":"If we do not give you as tribute,"},{"id":"semetey-1-2013:p1063:b003:l016","ordinal":158248,"en":"If we stand opposed across from them,"},{"id":"semetey-1-2013:p1063:b003:l017","ordinal":158249,"en":"Firing guns and drawing bows,"},{"id":"semetey-1-2013:p1063:b003:l018","ordinal":158250,"en":"And clash against them in battle,"},{"id":"semetey-1-2013:p1063:b003:l019","ordinal":158251,"en":"While arrows whistle,"},{"id":"semetey-1-2013:p1063:b003:l020","ordinal":158252,"en":"And strike their marks with a sting,"},{"id":"semetey-1-2013:p1063:b003:l021","ordinal":158253,"en":"And the people perish screaming,"},{"id":"semetey-1-2013:p1063:b003:l022","ordinal":158254,"en":"What would become of us?"},{"id":"semetey-1-2013:p1063:b003:l023","ordinal":158255,"en":"The words I have spoken—"},{"id":"semetey-1-2013:p1063:b003:l024","ordinal":158256,"en":"Why not heed them, Aychürök?"},{"id":"semetey-1-2013:p1063:b003:l025","ordinal":158257,"en":"He too is a father's son;"},{"id":"semetey-1-2013:p1063:b003:l026","ordinal":158258,"en":"To that hero Toltoy—"},{"id":"semetey-1-2013:p1063:b003:l027","ordinal":158259,"en":"Why not go, Aychürök?"},{"id":"semetey-1-2013:p1063:b003:l028","ordinal":158260,"en":"Shining in a coat of mail,"},{"id":"semetey-1-2013:p1063:b003:l029","ordinal":158261,"en":"You have no choice but to go;"},{"id":"semetey-1-2013:p1063:b003:l030","ordinal":158262,"en":"After facing them and fighting,"},{"id":"semetey-1-2013:p1063:b003:l031","ordinal":158263,"en":"To those barking dogs,"},{"id":"semetey-1-2013:p1063:b003:l032","ordinal":158264,"en":"We have no choice but to give you."},{"id":"semetey-1-2013:p1063:b003:l033","ordinal":158265,"en":"Our strength is spent and our power gone;"},{"id":"semetey-1-2013:p1063:b003:l034","ordinal":158266,"en":"We have no means left to take counsel."},{"id":"semetey-1-2013:p1063:b003:l035","ordinal":158267,"en":"On your account, Chürökbay,"},{"id":"semetey-1-2013:p1063:b003:l036","ordinal":158268,"en":"If we fight, blood will flow."},{"id":"semetey-1-2013:p1063:b003:l037","ordinal":158269,"en":"After sitting deep in thought,"},{"id":"semetey-1-2013:p1063:b003:l038","ordinal":158270,"en":"We have resolved to heed your word;"},{"id":"semetey-1-2013:p1063:b003:l039","ordinal":158271,"en":"As tribute to Toltoy,"},{"id":"semetey-1-2013:p1063:b004:l001","ordinal":158272,"en":"We have resolved to find the means to give you."},{"id":"semetey-1-2013:p1063:b004:l002","ordinal":158273,"en":"Without taking offense or resisting,"},{"id":"semetey-1-2013:p1063:b004:l003","ordinal":158274,"en":"We have now found the means;"},{"id":"semetey-1-2013:p1063:b004:l004","ordinal":158275,"en":"Finish all your objections!"},{"id":"semetey-1-2013:p1063:b004:l005","ordinal":158276,"en":"From over there we have found"},{"id":"semetey-1-2013:p1063:b004:l006","ordinal":158277,"en":"Your husband, lion Toltoy!"},{"id":"semetey-1-2013:p1063:b004:l007","ordinal":158278,"en":"When all recourse is slipping away,"},{"id":"semetey-1-2013:p1063:b004:l008","ordinal":158279,"en":"Toltoy of the Zhediger"},{"id":"semetey-1-2013:p1063:b004:l009","ordinal":158280,"en":"Is also a father's son."},{"id":"semetey-1-2013:p1063:b004:l010","ordinal":158281,"en":"Now heed our words;"},{"id":"semetey-1-2013:p1063:b004:l011","ordinal":158282,"en":"The people will be slaughtered for you—"},{"id":"semetey-1-2013:p1063:b004:l012","ordinal":158283,"en":"Go to brave Toltoy!\""},{"id":"semetey-1-2013:p1063:b004:l013","ordinal":158284,"en":"When they had spoken thus,"},{"id":"semetey-1-2013:p1063:b004:l014","ordinal":158285,"en":"Chürök then said this:"},{"id":"semetey-1-2013:p1063:b004:l015","ordinal":158286,"en":"\"Azhybay and Tümönbay,"},{"id":"semetey-1-2013:p1063:b004:l016","ordinal":158287,"en":"My two dear elder brothers,"},{"id":"semetey-1-2013:p1063:b004:l017","ordinal":158288,"en":"I shall heed what you say."},{"id":"semetey-1-2013:p1063:b004:l018","ordinal":158289,"en":"My father is old and I am a girl;"},{"id":"semetey-1-2013:p1063:b004:l019","ordinal":158290,"en":"What choice have I, what can I do?"},{"id":"semetey-1-2013:p1063:b004:l020","ordinal":158291,"en":"I shall go to your Toltoy!"},{"id":"semetey-1-2013:p1063:b004:l021","ordinal":158292,"en":"My dear two elder brothers,"},{"id":"semetey-1-2013:p1063:b004:l022","ordinal":158293,"en":"Your manhood has become clear."},{"id":"semetey-1-2013:p1063:b004:l023","ordinal":158294,"en":"Why not agree to what he says,"},{"id":"semetey-1-2013:p1063:b004:l024","ordinal":158295,"en":"Take from Toltoy of the Zhediger"},{"id":"semetey-1-2013:p1063:b004:l025","ordinal":158296,"en":"Livestock enough to make the earth sag,"},{"id":"semetey-1-2013:p1063:b004:l026","ordinal":158297,"en":"And only then give me away?"},{"id":"semetey-1-2013:p1063:b004:l027","ordinal":158298,"en":"Have you killed countless men"},{"id":"semetey-1-2013:p1063:b004:l028","ordinal":158299,"en":"Among the Zhediger people"},{"id":"semetey-1-2013:p1063:b004:l029","ordinal":158300,"en":"And become blood-debtors?"},{"id":"semetey-1-2013:p1063:b004:l030","ordinal":158301,"en":"Have you become plunder-debtors"},{"id":"semetey-1-2013:p1063:b004:l031","ordinal":158302,"en":"For stealing camels?"},{"id":"semetey-1-2013:p1063:b004:l032","ordinal":158303,"en":"If you have no such fear,"},{"id":"semetey-1-2013:p1063:b004:l033","ordinal":158304,"en":"Have you given me as a fine"},{"id":"semetey-1-2013:p1063:b004:l034","ordinal":158305,"en":"Because you rode no dappled pacing colt,"},{"id":"semetey-1-2013:p1063:b004:l035","ordinal":158306,"en":"Ate no knucklebone's meat,"},{"id":"semetey-1-2013:p1063:b004:l036","ordinal":158307,"en":"Rode no spotted pacing horse,"},{"id":"semetey-1-2013:p1063:b004:l037","ordinal":158308,"en":"And ate no rich joint of meat?"},{"id":"semetey-1-2013:p1063:b004:l038","ordinal":158309,"en":"The Zhediger who would take a wife—"},{"id":"semetey-1-2013:p1063:b004:l039","ordinal":158310,"en":"Why not raise a great tumult against them?"},{"id":"semetey-1-2013:p1064:b003:l001","ordinal":158311,"en":"Brave Toltoy's Surkoen—"},{"id":"semetey-1-2013:p1064:b003:l002","ordinal":158312,"en":"Why not take it as the chief horse?"},{"id":"semetey-1-2013:p1064:b003:l003","ordinal":158313,"en":"Chynkozho's Black Horse—"},{"id":"semetey-1-2013:p1064:b003:l004","ordinal":158314,"en":"Why not appoint it as the ceremonial mount,"},{"id":"semetey-1-2013:p1064:b003:l005","ordinal":158315,"en":"From the mountain-like heroes,"},{"id":"semetey-1-2013:p1064:b003:l006","ordinal":158316,"en":"Why not take those two tulpars?"},{"id":"semetey-1-2013:p1064:b003:l007","ordinal":158317,"en":"Why not agree to what I say?"},{"id":"semetey-1-2013:p1064:b003:l008","ordinal":158318,"en":"Saying, 'A maiden's shame is her sale,'"},{"id":"semetey-1-2013:p1064:b003:l009","ordinal":158319,"en":"Only after that should you give me.\""},{"id":"semetey-1-2013:p1064:b003:l010","ordinal":158320,"en":"After Chürök had spoken thus,"},{"id":"semetey-1-2013:p1064:b003:l011","ordinal":158321,"en":"Her two elder brothers bustled about,"},{"id":"semetey-1-2013:p1064:b003:l012","ordinal":158322,"en":"Prancing as they spoke persuasive words:"},{"id":"semetey-1-2013:p1064:b003:l013","ordinal":158323,"en":"\"Agreed, it shall be agreed,\" they said;"},{"id":"semetey-1-2013:p1064:b003:l014","ordinal":158324,"en":"Those two tulpars—"},{"id":"semetey-1-2013:p1064:b003:l015","ordinal":158325,"en":"Whoever does not take them as the ceremonial gift,"},{"id":"semetey-1-2013:p1064:b003:l016","ordinal":158326,"en":"May his seven forefathers be infidels."},{"id":"semetey-1-2013:p1064:b003:l017","ordinal":158327,"en":"After they had spoken so:"},{"id":"semetey-1-2013:p1064:b003:l018","ordinal":158328,"en":"\"My dear two elder brothers,"},{"id":"semetey-1-2013:p1064:b003:l019","ordinal":158329,"en":"Walking between the two sides,"},{"id":"semetey-1-2013:p1064:b003:l020","ordinal":158330,"en":"You have grown thin;"},{"id":"semetey-1-2013:p1064:b003:l021","ordinal":158331,"en":"Enduring much suffering and violence,"},{"id":"semetey-1-2013:p1064:b003:l022","ordinal":158332,"en":"You have grown worn and old."},{"id":"semetey-1-2013:p1064:b003:l023","ordinal":158333,"en":"A barren yearling mare turned loose for recreation,"},{"id":"semetey-1-2013:p1064:b003:l024","ordinal":158334,"en":"A sight that satisfies longing—"},{"id":"semetey-1-2013:p1064:b003:l025","ordinal":158335,"en":"I have slaughtered it,"},{"id":"semetey-1-2013:p1064:b003:l026","ordinal":158336,"en":"So my elder brothers may eat;"},{"id":"semetey-1-2013:p1064:b003:l027","ordinal":158337,"en":"I have laid out food and drink."},{"id":"semetey-1-2013:p1064:b003:l028","ordinal":158338,"en":"Grow stout and refreshed, accept my hospitality;"},{"id":"semetey-1-2013:p1064:b003:l029","ordinal":158339,"en":"Afterward, hand me over."},{"id":"semetey-1-2013:p1064:b003:l030","ordinal":158340,"en":"My father is old and I am a girl;"},{"id":"semetey-1-2013:p1064:b003:l031","ordinal":158341,"en":"Have I any remedy against Toltoy?"},{"id":"semetey-1-2013:p1064:b003:l032","ordinal":158342,"en":"My mother is old and I am a girl;"},{"id":"semetey-1-2013:p1064:b003:l033","ordinal":158343,"en":"Have I any will of my own against Toltoy?"},{"id":"semetey-1-2013:p1064:b003:l034","ordinal":158344,"en":"If you tell me to go, I shall go;"},{"id":"semetey-1-2013:p1064:b003:l035","ordinal":158345,"en":"Without causing slaughter for my sake,"},{"id":"semetey-1-2013:p1064:b003:l036","ordinal":158346,"en":"I shall preserve alive"},{"id":"semetey-1-2013:p1064:b003:l037","ordinal":158347,"en":"The great multitude of Afghans."},{"id":"semetey-1-2013:p1064:b003:l038","ordinal":158348,"en":"Take off your boots and stretch your feet,"},{"id":"semetey-1-2013:p1064:b003:l039","ordinal":158349,"en":"Drink spirits and eat food;"},{"id":"semetey-1-2013:p1064:b004:l001","ordinal":158350,"en":"Grow stout and refreshed."},{"id":"semetey-1-2013:p1064:b004:l002","ordinal":158351,"en":"After that, elder brothers,"},{"id":"semetey-1-2013:p1064:b004:l003","ordinal":158352,"en":"Stand firm without fear or alarm,"},{"id":"semetey-1-2013:p1064:b004:l004","ordinal":158353,"en":"And lay claim to the two horses!\""},{"id":"semetey-1-2013:p1064:b004:l005","ordinal":158354,"en":"Having said this, Aychürök"},{"id":"semetey-1-2013:p1064:b004:l006","ordinal":158355,"en":"Took the inner shortcut"},{"id":"semetey-1-2013:p1064:b004:l007","ordinal":158356,"en":"Azhybay and Tümönbay—"},{"id":"semetey-1-2013:p1064:b004:l008","ordinal":158357,"en":"To the palace she herself had built,"},{"id":"semetey-1-2013:p1064:b004:l009","ordinal":158358,"en":"She led them there."},{"id":"semetey-1-2013:p1064:b004:l010","ordinal":158359,"en":"Aychürök's white palace"},{"id":"semetey-1-2013:p1064:b004:l011","ordinal":158360,"en":"Was magnificent beyond measure."},{"id":"semetey-1-2013:p1064:b004:l012","ordinal":158361,"en":"At the entrance to its door"},{"id":"semetey-1-2013:p1064:b004:l013","ordinal":158362,"en":"Stood eighty warriors like Bakay;"},{"id":"semetey-1-2013:p1064:b004:l014","ordinal":158363,"en":"She bit her lip, narrowed her eyes,"},{"id":"semetey-1-2013:p1064:b004:l015","ordinal":158364,"en":"And now flicked her brow."},{"id":"semetey-1-2013:p1064:b004:l016","ordinal":158365,"en":"It was the signal meaning, \"Open it.\""},{"id":"semetey-1-2013:p1064:b004:l017","ordinal":158366,"en":"Her warriors gathered"},{"id":"semetey-1-2013:p1064:b004:l018","ordinal":158367,"en":"And pulled open the gate."},{"id":"semetey-1-2013:p1064:b004:l019","ordinal":158368,"en":"Leading her two elder brothers,"},{"id":"semetey-1-2013:p1064:b004:l020","ordinal":158369,"en":"That clever dark-faced kinswoman"},{"id":"semetey-1-2013:p1064:b004:l021","ordinal":158370,"en":"Into the splendid palace,"},{"id":"semetey-1-2013:p1064:b004:l022","ordinal":158371,"en":"She brought them."},{"id":"semetey-1-2013:p1064:b004:l023","ordinal":158372,"en":"Aychürök had forty young attendants,"},{"id":"semetey-1-2013:p1064:b004:l024","ordinal":158373,"en":"All beautiful, skilled young women;"},{"id":"semetey-1-2013:p1064:b004:l025","ordinal":158374,"en":"When this Chürök placed them beside her,"},{"id":"semetey-1-2013:p1064:b004:l026","ordinal":158375,"en":"All forty young women"},{"id":"semetey-1-2013:p1064:b004:l027","ordinal":158376,"en":"Bent their knees to the ground,"},{"id":"semetey-1-2013:p1064:b004:l028","ordinal":158377,"en":"And ran swift as arrows."},{"id":"semetey-1-2013:p1064:b004:l029","ordinal":158378,"en":"On this side was the curtain;"},{"id":"semetey-1-2013:p1064:b004:l030","ordinal":158379,"en":"All forty young women"},{"id":"semetey-1-2013:p1064:b004:l031","ordinal":158380,"en":"Ran and now raised it."},{"id":"semetey-1-2013:p1064:b004:l032","ordinal":158381,"en":"If you looked to the far side,"},{"id":"semetey-1-2013:p1064:b004:l033","ordinal":158382,"en":"Fourteen tulpars stood tethered."},{"id":"semetey-1-2013:p1064:b004:l034","ordinal":158383,"en":"When they saw these two men,"},{"id":"semetey-1-2013:p1064:b004:l035","ordinal":158384,"en":"All fourteen tulpars strained;"},{"id":"semetey-1-2013:p1064:b004:l036","ordinal":158385,"en":"They no longer appeared as horses,"},{"id":"semetey-1-2013:p1064:b004:l037","ordinal":158386,"en":"But seemed true tigers."},{"id":"semetey-1-2013:p1064:b004:l038","ordinal":158387,"en":"At the sight of them,"},{"id":"semetey-1-2013:p1064:b004:l039","ordinal":158388,"en":"The two men's hearts were torn with desire."},{"id":"semetey-1-2013:p1065:b003:l001","ordinal":158389,"en":"Before one could say this or that,"},{"id":"semetey-1-2013:p1065:b003:l002","ordinal":158390,"en":"In the blink of an eye,"},{"id":"semetey-1-2013:p1065:b003:l003","ordinal":158391,"en":"If one broke its halter,"},{"id":"semetey-1-2013:p1065:b003:l004","ordinal":158392,"en":"It looked ready to devour everyone."},{"id":"semetey-1-2013:p1065:b003:l005","ordinal":158393,"en":"Neighing and straining,"},{"id":"semetey-1-2013:p1065:b003:l006","ordinal":158394,"en":"Heaving against one another,"},{"id":"semetey-1-2013:p1065:b003:l007","ordinal":158395,"en":"Pinning back their ears,"},{"id":"semetey-1-2013:p1065:b003:l008","ordinal":158396,"en":"They flung the black earth's turf"},{"id":"semetey-1-2013:p1065:b003:l009","ordinal":158397,"en":"Up toward the sky."},{"id":"semetey-1-2013:p1065:b003:l010","ordinal":158398,"en":"When they pawed the ground with a roar,"},{"id":"semetey-1-2013:p1065:b003:l011","ordinal":158399,"en":"Where their feet struck, the black earth"},{"id":"semetey-1-2013:p1065:b003:l012","ordinal":158400,"en":"Split layer after layer."},{"id":"semetey-1-2013:p1065:b003:l013","ordinal":158401,"en":"To the two men, senseless with fear,"},{"id":"semetey-1-2013:p1065:b003:l014","ordinal":158402,"en":"Their animal form could not be discerned;"},{"id":"semetey-1-2013:p1065:b003:l015","ordinal":158403,"en":"They appeared in the form of tigers."},{"id":"semetey-1-2013:p1065:b003:l016","ordinal":158404,"en":"Tümönbay lost his senses"},{"id":"semetey-1-2013:p1065:b003:l017","ordinal":158405,"en":"And spoke to Azhybay:"},{"id":"semetey-1-2013:p1065:b003:l018","ordinal":158406,"en":"\"If one of these tigers"},{"id":"semetey-1-2013:p1065:b003:l019","ordinal":158407,"en":"Gets loose, it will eat us;"},{"id":"semetey-1-2013:p1065:b003:l020","ordinal":158408,"en":"Then our misery will truly boil!"},{"id":"semetey-1-2013:p1065:b003:l021","ordinal":158409,"en":"If one of these tigers breaks free,"},{"id":"semetey-1-2013:p1065:b003:l022","ordinal":158410,"en":"It will chew us without leaving a carcass!"},{"id":"semetey-1-2013:p1065:b003:l023","ordinal":158411,"en":"Can toothed tigers"},{"id":"semetey-1-2013:p1065:b003:l024","ordinal":158412,"en":"Really have been tied here?"},{"id":"semetey-1-2013:p1065:b003:l025","ordinal":158413,"en":"Was it wise to act as intermediary"},{"id":"semetey-1-2013:p1065:b003:l026","ordinal":158414,"en":"For a bitch like this?"},{"id":"semetey-1-2013:p1065:b003:l027","ordinal":158415,"en":"What a waist she has girded!"},{"id":"semetey-1-2013:p1065:b003:l028","ordinal":158416,"en":"Where did this toil-stricken bitch"},{"id":"semetey-1-2013:p1065:b003:l029","ordinal":158417,"en":"Find such a husband?"},{"id":"semetey-1-2013:p1065:b003:l030","ordinal":158418,"en":"If one of these breaks free,"},{"id":"semetey-1-2013:p1065:b003:l031","ordinal":158419,"en":"It will surely eat us!"},{"id":"semetey-1-2013:p1065:b003:l032","ordinal":158420,"en":"Can anyone prosper who devises"},{"id":"semetey-1-2013:p1065:b003:l033","ordinal":158421,"en":"Every kind of lawless deed?"},{"id":"semetey-1-2013:p1065:b003:l034","ordinal":158422,"en":"Can anyone prosper who gathers"},{"id":"semetey-1-2013:p1065:b003:l035","ordinal":158423,"en":"And ties up fourteen tigers?!"},{"id":"semetey-1-2013:p1065:b003:l036","ordinal":158424,"en":"She has worn down horses' flanks,"},{"id":"semetey-1-2013:p1065:b003:l037","ordinal":158425,"en":"The wretched woman of consummate arts,"},{"id":"semetey-1-2013:p1065:b003:l038","ordinal":158426,"en":"Flying about and traversing"},{"id":"semetey-1-2013:p1065:b003:l039","ordinal":158427,"en":"The whole wide world."},{"id":"semetey-1-2013:p1065:b005:l001","ordinal":158428,"en":"Of Chürök's forty arts,"},{"id":"semetey-1-2013:p1065:b005:l002","ordinal":158429,"en":"Which art can we know?"},{"id":"semetey-1-2013:p1065:b005:l003","ordinal":158430,"en":"Is one of these the mountain pass lying closed,"},{"id":"semetey-1-2013:p1065:b005:l004","ordinal":158431,"en":"Or is it the wretched Chürök's husband"},{"id":"semetey-1-2013:p1065:b005:l005","ordinal":158432,"en":"Who came from Beijing?!"},{"id":"semetey-1-2013:p1065:b005:l006","ordinal":158433,"en":"We knew it from the beginning:"},{"id":"semetey-1-2013:p1065:b005:l007","ordinal":158434,"en":"A sidelong look was always in her eyes,"},{"id":"semetey-1-2013:p1065:b005:l008","ordinal":158435,"en":"A crooked edge was always in her words;"},{"id":"semetey-1-2013:p1065:b005:l009","ordinal":158436,"en":"Given the chance, Azhybay,"},{"id":"semetey-1-2013:p1065:b005:l010","ordinal":158437,"en":"She was always ready to trip me!"},{"id":"semetey-1-2013:p1065:b005:l011","ordinal":158438,"en":"A slant was always in her eyes,"},{"id":"semetey-1-2013:p1065:b005:l012","ordinal":158439,"en":"Perversity was always in her words;"},{"id":"semetey-1-2013:p1065:b005:l013","ordinal":158440,"en":"When the moment suited this Chürök,"},{"id":"semetey-1-2013:p1065:b005:l014","ordinal":158441,"en":"She was ready to work her Tümönbay trick on you!\""},{"id":"semetey-1-2013:p1065:b005:l015","ordinal":158442,"en":"Azhybay and Tümönbay"},{"id":"semetey-1-2013:p1065:b005:l016","ordinal":158443,"en":"Stood rigid, unable to walk,"},{"id":"semetey-1-2013:p1065:b005:l017","ordinal":158444,"en":"Quarreling with one another:"},{"id":"semetey-1-2013:p1065:b005:l018","ordinal":158445,"en":"\"We must have come to experience"},{"id":"semetey-1-2013:p1065:b005:l019","ordinal":158446,"en":"Torment like Judgment Day;"},{"id":"semetey-1-2013:p1065:b005:l020","ordinal":158447,"en":"We must have come to die"},{"id":"semetey-1-2013:p1065:b005:l021","ordinal":158448,"en":"At the hands of maiden Chürök!"},{"id":"semetey-1-2013:p1065:b005:l022","ordinal":158449,"en":"When Chynkozho strikes with a roar,"},{"id":"semetey-1-2013:p1065:b005:l023","ordinal":158450,"en":"Will he spare a soul?"},{"id":"semetey-1-2013:p1065:b005:l024","ordinal":158451,"en":"When fourteen tigers gather and maul us,"},{"id":"semetey-1-2013:p1065:b005:l025","ordinal":158452,"en":"Will they spare a soul?!"},{"id":"semetey-1-2013:p1065:b005:l026","ordinal":158453,"en":"Chürök has raised"},{"id":"semetey-1-2013:p1065:b005:l027","ordinal":158454,"en":"This calamitous turmoil;"},{"id":"semetey-1-2013:p1065:b005:l028","ordinal":158455,"en":"We have died before living out our lives,"},{"id":"semetey-1-2013:p1065:b005:l029","ordinal":158456,"en":"And suffered disgrace from the infidels!\""},{"id":"semetey-1-2013:p1065:b005:l030","ordinal":158457,"en":"When Azhybay and Tümönbay"},{"id":"semetey-1-2013:p1065:b005:l031","ordinal":158458,"en":"Saw those tigers,"},{"id":"semetey-1-2013:p1065:b005:l032","ordinal":158459,"en":"The strength left their arms,"},{"id":"semetey-1-2013:p1065:b005:l033","ordinal":158460,"en":"And courage left their hearts."},{"id":"semetey-1-2013:p1065:b005:l034","ordinal":158461,"en":"Azhybay cowered against Tümönbay;"},{"id":"semetey-1-2013:p1065:b005:l035","ordinal":158462,"en":"From inside Azhybay's trousers,"},{"id":"semetey-1-2013:p1065:b005:l036","ordinal":158463,"en":"His urine streamed out."},{"id":"semetey-1-2013:p1065:b005:l037","ordinal":158464,"en":"Words deserted Tümönbay's mouth,"}]
