[{"id":"sayakbay-ms-current146:pdf028:l021","ordinal":389121,"en":"When they were to see the khan’s face,"},{"id":"sayakbay-ms-current146:pdf028:l022","ordinal":389122,"en":"The tower served as a signal,"},{"id":"sayakbay-ms-current146:pdf028:l023","ordinal":389123,"en":"Do not ask about its tower,"},{"id":"sayakbay-ms-current146:pdf028:l024","ordinal":389124,"en":"Nine thousand ears all listened,"},{"id":"sayakbay-ms-current146:pdf028:l025","ordinal":389125,"en":"Upon it was a signal bell,"},{"id":"sayakbay-ms-current146:pdf028:l026","ordinal":389126,"en":"When its bell was struck,"},{"id":"sayakbay-ms-current146:pdf028:l027","ordinal":389127,"en":"Across a distance of nine days,’ travel,"},{"id":"sayakbay-ms-current146:pdf028:l028","ordinal":389128,"en":"It was heard like a mighty wind,"},{"id":"sayakbay-ms-current146:pdf028:l029","ordinal":389129,"en":"The bell was its signal,"},{"id":"sayakbay-ms-current146:pdf028:l030","ordinal":389130,"en":"It rang until ears were deafened,"},{"id":"sayakbay-ms-current146:pdf028:l031","ordinal":389131,"en":"All the people under the sun,"},{"id":"sayakbay-ms-current146:pdf028:l032","ordinal":389132,"en":"Marveled at this tumult,"},{"id":"sayakbay-ms-current146:pdf028:l033","ordinal":389133,"en":"They stood watching, crowded together,"},{"id":"sayakbay-ms-current146:pdf028:l034","ordinal":389134,"en":"While the people stood astonished,"},{"id":"sayakbay-ms-current146:pdf028:l035","ordinal":389135,"en":"He emerged as though drawn forth,"}]
