[{"id":"semetey-1-2013:p0261:b004:l031","ordinal":96769,"en":"What wish should I attain?"},{"id":"semetey-1-2013:p0261:b004:l032","ordinal":96770,"en":"My gift left by my khan"},{"id":"semetey-1-2013:p0261:b004:l033","ordinal":96771,"en":"Has gladly taken his horse;"},{"id":"semetey-1-2013:p0261:b004:l034","ordinal":96772,"en":"Now I shall return to my palace.'"},{"id":"semetey-1-2013:p0261:b004:l035","ordinal":96773,"en":"Riding on in distress,"},{"id":"semetey-1-2013:p0261:b004:l036","ordinal":96774,"en":"Your poor mother Kanykei,"},{"id":"semetey-1-2013:p0261:b004:l037","ordinal":96775,"en":"Of the orphan left by Manas,"},{"id":"semetey-1-2013:p0261:b004:l038","ordinal":96776,"en":"Saw the form and pleaded:"},{"id":"semetey-1-2013:p0261:b004:l039","ordinal":96777,"en":"'My beloved God,"}]
