[{"id":"semetey-1-2013:p1213:b003:l038","ordinal":168705,"en":"Kongurbai took advantage—"},{"id":"semetey-1-2013:p1213:b003:l039","ordinal":168706,"en":"Now God struck him."},{"id":"semetey-1-2013:p1213:b004:l001","ordinal":168707,"en":"His accursed Algara—"},{"id":"semetey-1-2013:p1213:b004:l002","ordinal":168708,"en":"No living soul could match its blink;"},{"id":"semetey-1-2013:p1213:b004:l003","ordinal":168709,"en":"Unless it were a flying crow,"},{"id":"semetey-1-2013:p1213:b004:l004","ordinal":168710,"en":"No four-footed creature could match it."},{"id":"semetey-1-2013:p1213:b004:l005","ordinal":168711,"en":"Achbuudan, lying fallen,"},{"id":"semetey-1-2013:p1213:b004:l006","ordinal":168712,"en":"Now saw the accursed horse."},{"id":"semetey-1-2013:p1213:b004:l007","ordinal":168713,"en":"As though black doom had struck his wife,"},{"id":"semetey-1-2013:p1213:b004:l008","ordinal":168714,"en":"Kongurbai grew furious."},{"id":"semetey-1-2013:p1213:b004:l009","ordinal":168715,"en":"“The many prizes gathered by the people—"},{"id":"semetey-1-2013:p1213:b004:l010","ordinal":168716,"en":"Why should I not take them?"},{"id":"semetey-1-2013:p1213:b004:l011","ordinal":168717,"en":"If they do not give me that prize,"},{"id":"semetey-1-2013:p1213:b004:l012","ordinal":168718,"en":"Why should I not bring upon"},{"id":"semetey-1-2013:p1213:b004:l013","ordinal":168719,"en":"The accursed Burut"},{"id":"semetey-1-2013:p1213:b004:l014","ordinal":168720,"en":"A slaughter no man wishes to see?”"},{"id":"semetey-1-2013:p1213:b004:l015","ordinal":168721,"en":"Speaking thus, Kongurbai"},{"id":"semetey-1-2013:p1213:b004:l016","ordinal":168722,"en":"Roared in fury;"},{"id":"semetey-1-2013:p1213:b004:l017","ordinal":168723,"en":"At the Kalcha’s might,"},{"id":"semetey-1-2013:p1213:b004:l018","ordinal":168724,"en":"The earth broke and thundered."},{"id":"semetey-1-2013:p1213:b004:l019","ordinal":168725,"en":"At the Kalcha’s might,"},{"id":"semetey-1-2013:p1213:b004:l020","ordinal":168726,"en":"The many Chinese and Manchus"},{"id":"semetey-1-2013:p1213:b004:l021","ordinal":168727,"en":"Split open with a crash."},{"id":"semetey-1-2013:p1213:b004:l022","ordinal":168728,"en":"Algara beneath him"},{"id":"semetey-1-2013:p1213:b004:l023","ordinal":168729,"en":"Was a true tulpar, a wondrous beast;"},{"id":"semetey-1-2013:p1213:b004:l024","ordinal":168730,"en":"The mighty Kalcha, a powerful hero,"},{"id":"semetey-1-2013:p1213:b004:l025","ordinal":168731,"en":"Now raised a shout."},{"id":"semetey-1-2013:p1213:b004:l026","ordinal":168732,"en":"Before one could say a word,"},{"id":"semetey-1-2013:p1213:b004:l027","ordinal":168733,"en":"In the blink of an eye,"},{"id":"semetey-1-2013:p1213:b004:l028","ordinal":168734,"en":"The loop-knotted reins"},{"id":"semetey-1-2013:p1213:b004:l029","ordinal":168735,"en":"He pressed against its belly."},{"id":"semetey-1-2013:p1213:b004:l030","ordinal":168736,"en":"Trained upon level ground,"},{"id":"semetey-1-2013:p1213:b004:l031","ordinal":168737,"en":"He had mastered the stallion,"},{"id":"semetey-1-2013:p1213:b004:l032","ordinal":168738,"en":"Dragging others like a cap."},{"id":"semetey-1-2013:p1213:b004:l033","ordinal":168739,"en":"Making it plunge downward,"},{"id":"semetey-1-2013:p1213:b004:l034","ordinal":168740,"en":"Sending it flying like tumbleweed,"},{"id":"semetey-1-2013:p1213:b004:l035","ordinal":168741,"en":"Kongurbai, son of Alööke,"},{"id":"semetey-1-2013:p1213:b004:l036","ordinal":168742,"en":"Dragged along"},{"id":"semetey-1-2013:p1213:b004:l037","ordinal":168743,"en":"Hero Zholoi’s stallion with immense force."},{"id":"semetey-1-2013:p1213:b004:l038","ordinal":168744,"en":"He had trained it on level ground;"},{"id":"semetey-1-2013:p1213:b004:l039","ordinal":168745,"en":"Kongurbai, the peerless wrestler,"},{"id":"semetey-1-2013:p1214:b003:l001","ordinal":168746,"en":"Dragged it like a cap."},{"id":"semetey-1-2013:p1214:b003:l002","ordinal":168747,"en":"He had trained it on slopes;"},{"id":"semetey-1-2013:p1214:b003:l003","ordinal":168748,"en":"On descending ground Kongurbai"},{"id":"semetey-1-2013:p1214:b003:l004","ordinal":168749,"en":"Dragged it like tumbleweed."},{"id":"semetey-1-2013:p1214:b003:l005","ordinal":168750,"en":"When one stallion urged another,"},{"id":"semetey-1-2013:p1214:b003:l006","ordinal":168751,"en":"It ran without turning, shimmering like a mirage;"},{"id":"semetey-1-2013:p1214:b003:l007","ordinal":168752,"en":"Behind the leader, Achbuudan"},{"id":"semetey-1-2013:p1214:b003:l008","ordinal":168753,"en":"Was now drawing close."},{"id":"semetey-1-2013:p1214:b003:l009","ordinal":168754,"en":"Kulatai, tiny as a young tick,"},{"id":"semetey-1-2013:p1214:b003:l010","ordinal":168755,"en":"Was racing with all his longing."},{"id":"semetey-1-2013:p1214:b003:l011","ordinal":168756,"en":"Whipping Maaniker,"},{"id":"semetey-1-2013:p1214:b003:l012","ordinal":168757,"en":"Young Aidar raised the cheering cry."},{"id":"semetey-1-2013:p1214:b003:l013","ordinal":168758,"en":"The stones beneath his tread burst apart;"},{"id":"semetey-1-2013:p1214:b003:l014","ordinal":168759,"en":"Kulatai and Maaniker"},{"id":"semetey-1-2013:p1214:b003:l015","ordinal":168760,"en":"Ran side by side with a roar,"},{"id":"semetey-1-2013:p1214:b003:l016","ordinal":168761,"en":"The earth circling in a mirage,"},{"id":"semetey-1-2013:p1214:b003:l017","ordinal":168762,"en":"Drawing close to Achbuudan."},{"id":"semetey-1-2013:p1214:b003:l018","ordinal":168763,"en":"Splitting the dense host in two,"},{"id":"semetey-1-2013:p1214:b003:l019","ordinal":168764,"en":"Kulatai came charging in,"},{"id":"semetey-1-2013:p1214:b003:l020","ordinal":168765,"en":"Nearly moving to the front."},{"id":"semetey-1-2013:p1214:b003:l021","ordinal":168766,"en":"Day had gone and night was ending;"},{"id":"semetey-1-2013:p1214:b003:l022","ordinal":168767,"en":"The boy riding the kulan"},{"id":"semetey-1-2013:p1214:b003:l023","ordinal":168768,"en":"Found a marvelous tongue:"},{"id":"semetey-1-2013:p1214:b003:l024","ordinal":168769,"en":"“Do not cheer me, Aidar, do not cheer;"},{"id":"semetey-1-2013:p1214:b003:l025","ordinal":168770,"en":"If I fall, will my teeth not break?"},{"id":"semetey-1-2013:p1214:b003:l026","ordinal":168771,"en":"If I die, will God not strike me!"},{"id":"semetey-1-2013:p1214:b003:l027","ordinal":168772,"en":"A colt light as tumbleweed—"},{"id":"semetey-1-2013:p1214:b003:l028","ordinal":168773,"en":"Will it not fly off wildly?"},{"id":"semetey-1-2013:p1214:b003:l029","ordinal":168774,"en":"If I tumble to the ground,"},{"id":"semetey-1-2013:p1214:b003:l030","ordinal":168775,"en":"Will my death not truly arrive?"},{"id":"semetey-1-2013:p1214:b003:l031","ordinal":168776,"en":"Will my bones not shatter small?"},{"id":"semetey-1-2013:p1214:b003:l032","ordinal":168777,"en":"Will my tormented life not end?"},{"id":"semetey-1-2013:p1214:b003:l033","ordinal":168778,"en":"He raced the colt and won a prize;"},{"id":"semetey-1-2013:p1214:b003:l034","ordinal":168779,"en":"God did not strike Kenei."},{"id":"semetey-1-2013:p1214:b003:l035","ordinal":168780,"en":"Let him race it when full-grown,"},{"id":"semetey-1-2013:p1214:b003:l036","ordinal":168781,"en":"And win the prize here then."},{"id":"semetey-1-2013:p1214:b003:l037","ordinal":168782,"en":"Instead of prize meat, eat your fat;"},{"id":"semetey-1-2013:p1214:b003:l038","ordinal":168783,"en":"Eat the blood of your mother."},{"id":"semetey-1-2013:p1214:b003:l039","ordinal":168784,"en":"Eat the age of prizes that has passed;"},{"id":"semetey-1-2013:p1214:b004:l001","ordinal":168785,"en":"Eat the liver of your seven forefathers."},{"id":"semetey-1-2013:p1214:b004:l002","ordinal":168786,"en":"What shameless man races a colt"},{"id":"semetey-1-2013:p1214:b004:l003","ordinal":168787,"en":"Alongside grown horses?"},{"id":"semetey-1-2013:p1214:b004:l004","ordinal":168788,"en":"Do not cheer, Aidar, do not cheer;"},{"id":"semetey-1-2013:p1214:b004:l005","ordinal":168789,"en":"Will not our strength fail,"},{"id":"semetey-1-2013:p1214:b004:l006","ordinal":168790,"en":"Will not our blood be spilled?”"},{"id":"semetey-1-2013:p1214:b004:l007","ordinal":168791,"en":"Hero Zholoi’s Achbuudan—"},{"id":"semetey-1-2013:p1214:b004:l008","ordinal":168792,"en":"The many Chinese standing tall"},{"id":"semetey-1-2013:p1214:b004:l009","ordinal":168793,"en":"Cheered it on fiercely."},{"id":"semetey-1-2013:p1214:b004:l010","ordinal":168794,"en":"Kulatai proved a tulpar;"},{"id":"semetey-1-2013:p1214:b004:l011","ordinal":168795,"en":"Khan Zholoi’s Achbuudan"},{"id":"semetey-1-2013:p1214:b004:l012","ordinal":168796,"en":"He seized by the tail with his teeth."},{"id":"semetey-1-2013:p1214:b004:l013","ordinal":168797,"en":"Behind Kulatai,"},{"id":"semetey-1-2013:p1214:b004:l014","ordinal":168798,"en":"Hero Agysh’s Surkiyik,"},{"id":"semetey-1-2013:p1214:b004:l015","ordinal":168799,"en":"Flattening its ears like a kulan,"},{"id":"semetey-1-2013:p1214:b004:l016","ordinal":168800,"en":"Sweeping the earth like a whirlwind,"},{"id":"semetey-1-2013:p1214:b004:l017","ordinal":168801,"en":"Had passed the other racers."},{"id":"semetey-1-2013:p1214:b004:l018","ordinal":168802,"en":"The Black Kalmak and Manchu people"},{"id":"semetey-1-2013:p1214:b004:l019","ordinal":168803,"en":"Blocked it in sixty places."},{"id":"semetey-1-2013:p1214:b004:l020","ordinal":168804,"en":"Behind Surkiyik,"},{"id":"semetey-1-2013:p1214:b004:l021","ordinal":168805,"en":"Hero Töshtük’s Chalkuiruk—"},{"id":"semetey-1-2013:p1214:b004:l022","ordinal":168806,"en":"There was no remedy for Chalkuiruk:"},{"id":"semetey-1-2013:p1214:b004:l023","ordinal":168807,"en":"It had descended beneath the earth"},{"id":"semetey-1-2013:p1214:b004:l024","ordinal":168808,"en":"For nearly seven years,"},{"id":"semetey-1-2013:p1214:b004:l025","ordinal":168809,"en":"And had been above the earth again"},{"id":"semetey-1-2013:p1214:b004:l026","ordinal":168810,"en":"For barely seven days."},{"id":"semetey-1-2013:p1214:b004:l027","ordinal":168811,"en":"Unable to lower its head,"},{"id":"semetey-1-2013:p1214:b004:l028","ordinal":168812,"en":"The wondrous beast, weakened,"},{"id":"semetey-1-2013:p1214:b004:l029","ordinal":168813,"en":"Chalkuiruk came exhausted."},{"id":"semetey-1-2013:p1214:b004:l030","ordinal":168814,"en":"Behind it,"},{"id":"semetey-1-2013:p1214:b004:l031","ordinal":168815,"en":"Muzburchak’s Telkyzyl"},{"id":"semetey-1-2013:p1214:b004:l032","ordinal":168816,"en":"Also ran shimmering like a mirage;"},{"id":"semetey-1-2013:p1214:b004:l033","ordinal":168817,"en":"Kökö Khan’s Kökala"},{"id":"semetey-1-2013:p1214:b004:l034","ordinal":168818,"en":"Pressed close behind."},{"id":"semetey-1-2013:p1214:b004:l035","ordinal":168819,"en":"A leech drawn from the water,"},{"id":"semetey-1-2013:p1214:b004:l036","ordinal":168820,"en":"The racehorse Kerkabylan;"},{"id":"semetey-1-2013:p1214:b004:l037","ordinal":168821,"en":"Behind this one,"},{"id":"semetey-1-2013:p1214:b004:l038","ordinal":168822,"en":"Kökbörü’s Kuukazyk;"},{"id":"semetey-1-2013:p1214:b004:l039","ordinal":168823,"en":"And behind that,"},{"id":"semetey-1-2013:p1215:b003:l001","ordinal":168824,"en":"Orongu’s dun mare."},{"id":"semetey-1-2013:p1215:b003:l002","ordinal":168825,"en":"That was the last of the nine;"},{"id":"semetey-1-2013:p1215:b003:l003","ordinal":168826,"en":"Khan Manas’s Akkula"},{"id":"semetey-1-2013:p1215:b003:l004","ordinal":168827,"en":"Now moved out in front."},{"id":"semetey-1-2013:p1215:b003:l005","ordinal":168828,"en":"Kökötöi’s countless prizes"},{"id":"semetey-1-2013:p1215:b003:l006","ordinal":168829,"en":"The Black Chinese and Manchu people"},{"id":"semetey-1-2013:p1215:b003:l007","ordinal":168830,"en":"Overwhelmed and plundered."},{"id":"semetey-1-2013:p1215:b003:l008","ordinal":168831,"en":"Without gaining possession of the prizes,"},{"id":"semetey-1-2013:p1215:b003:l009","ordinal":168832,"en":"The Muslims were left empty-handed."},{"id":"semetey-1-2013:p1215:b003:l010","ordinal":168833,"en":"From the Chinese came Kongurbai,"},{"id":"semetey-1-2013:p1215:b003:l011","ordinal":168834,"en":"Black-maned Boroonchu,"},{"id":"semetey-1-2013:p1215:b003:l012","ordinal":168835,"en":"From the Kalmaks Khan Zholoi,"},{"id":"semetey-1-2013:p1215:b003:l013","ordinal":168836,"en":"And Ylama of the Solon;"},{"id":"semetey-1-2013:p1215:b003:l014","ordinal":168837,"en":"Do not ask about the violence"},{"id":"semetey-1-2013:p1215:b003:l015","ordinal":168838,"en":"Of those snarling infidels."},{"id":"semetey-1-2013:p1215:b003:l016","ordinal":168839,"en":"Dust flew and haze burned;"},{"id":"semetey-1-2013:p1215:b003:l017","ordinal":168840,"en":"The teeming Chinese covered the land."},{"id":"semetey-1-2013:p1215:b003:l018","ordinal":168841,"en":"This was the Kakanchin pass;"},{"id":"semetey-1-2013:p1215:b003:l019","ordinal":168842,"en":"The Chinese had come as guests"},{"id":"semetey-1-2013:p1215:b003:l020","ordinal":168843,"en":"To Kökötöi’s memorial feast,"},{"id":"semetey-1-2013:p1215:b003:l021","ordinal":168844,"en":"Yet it was time for them to clash."},{"id":"semetey-1-2013:p1215:b003:l022","ordinal":168845,"en":"Zholoi came out using force;"},{"id":"semetey-1-2013:p1215:b003:l023","ordinal":168846,"en":"Kongurbai came out then,"},{"id":"semetey-1-2013:p1215:b003:l024","ordinal":168847,"en":"Humiliating the Muslims."},{"id":"semetey-1-2013:p1215:b003:l025","ordinal":168848,"en":"Great wrestler Ylama,"},{"id":"semetey-1-2013:p1215:b003:l026","ordinal":168849,"en":"A Kalmak like great Zholoi,"},{"id":"semetey-1-2013:p1215:b003:l027","ordinal":168850,"en":"Wielding axes of many kinds—"},{"id":"semetey-1-2013:p1215:b003:l028","ordinal":168851,"en":"The doomed wrestlers,"},{"id":"semetey-1-2013:p1215:b003:l029","ordinal":168852,"en":"The massed Chinese and many Kalmaks,"},{"id":"semetey-1-2013:p1215:b003:l030","ordinal":168853,"en":"Plundered Kökötöi’s"},{"id":"semetey-1-2013:p1215:b003:l031","ordinal":168854,"en":"Many prizes."},{"id":"semetey-1-2013:p1215:b003:l032","ordinal":168855,"en":"It became a deeply dug pit;"},{"id":"semetey-1-2013:p1215:b003:l033","ordinal":168856,"en":"Kakan-Beijing stirred,"},{"id":"semetey-1-2013:p1215:b003:l034","ordinal":168857,"en":"For this was Kökötöi’s feast,"},{"id":"semetey-1-2013:p1215:b003:l035","ordinal":168858,"en":"The beginning of much conflict."},{"id":"semetey-1-2013:p1215:b003:l036","ordinal":168859,"en":"It was a deep, excavated pit,"},{"id":"semetey-1-2013:p1215:b003:l037","ordinal":168860,"en":"Misfortune set boiling."},{"id":"semetey-1-2013:p1215:b003:l038","ordinal":168861,"en":"The heroes guarding the livestock"},{"id":"semetey-1-2013:p1215:b003:l039","ordinal":168862,"en":"Were beaten down."},{"id":"semetey-1-2013:p1215:b004:l001","ordinal":168863,"en":"The many prizes, those Chinese"},{"id":"semetey-1-2013:p1215:b004:l002","ordinal":168864,"en":"Plundered and carried away."},{"id":"semetey-1-2013:p1215:b004:l003","ordinal":168865,"en":"They dug a well in the place of honor;"},{"id":"semetey-1-2013:p1215:b004:l004","ordinal":168866,"en":"The prize won by Akkula,"},{"id":"semetey-1-2013:p1215:b004:l005","ordinal":168867,"en":"By force then,"},{"id":"semetey-1-2013:p1215:b004:l006","ordinal":168868,"en":"The Black Kalmaks scattered."},{"id":"semetey-1-2013:p1215:b004:l007","ordinal":168869,"en":"Kökötöi’s abundant wealth—"},{"id":"semetey-1-2013:p1215:b004:l008","ordinal":168870,"en":"They plundered its silks,"},{"id":"semetey-1-2013:p1215:b004:l009","ordinal":168871,"en":"And wrought terrible disorder."},{"id":"semetey-1-2013:p1215:b004:l010","ordinal":168872,"en":"They now spoke their claim,"},{"id":"semetey-1-2013:p1215:b004:l011","ordinal":168873,"en":"And took the prizes of the horses"},{"id":"semetey-1-2013:p1215:b004:l012","ordinal":168874,"en":"That had placed, then returned."},{"id":"semetey-1-2013:p1215:b004:l013","ordinal":168875,"en":"They tormented the people;"},{"id":"semetey-1-2013:p1215:b004:l014","ordinal":168876,"en":"Against the Black Kalmak and Manchus"},{"id":"semetey-1-2013:p1215:b004:l015","ordinal":168877,"en":"No one remained to cast a lasso."},{"id":"semetey-1-2013:p1215:b004:l016","ordinal":168878,"en":"Leaving no moving livestock,"},{"id":"semetey-1-2013:p1215:b004:l017","ordinal":168879,"en":"They drove off the finest."},{"id":"semetey-1-2013:p1215:b004:l018","ordinal":168880,"en":"Whoever resisted,"},{"id":"semetey-1-2013:p1215:b004:l019","ordinal":168881,"en":"They put to death."},{"id":"semetey-1-2013:p1215:b004:l020","ordinal":168882,"en":"Those whose death had come died;"},{"id":"semetey-1-2013:p1215:b004:l021","ordinal":168883,"en":"At Kökötöi’s feast,"},{"id":"semetey-1-2013:p1215:b004:l022","ordinal":168884,"en":"From the Black Chinese and Manchus,"},{"id":"semetey-1-2013:p1215:b004:l023","ordinal":168885,"en":"The Muslims suffered humiliation."},{"id":"semetey-1-2013:p1215:b004:l024","ordinal":168886,"en":"The seething Chinese ran about;"},{"id":"semetey-1-2013:p1215:b004:l025","ordinal":168887,"en":"When they saw the Chinese people,"},{"id":"semetey-1-2013:p1215:b004:l026","ordinal":168888,"en":"The handful of Muslims"},{"id":"semetey-1-2013:p1215:b004:l027","ordinal":168889,"en":"Despaired of their dear lives."},{"id":"semetey-1-2013:p1215:b004:l028","ordinal":168890,"en":"They rushed about in alarm;"},{"id":"semetey-1-2013:p1215:b004:l029","ordinal":168891,"en":"Some who had lost all recourse"},{"id":"semetey-1-2013:p1215:b004:l030","ordinal":168892,"en":"Fled toward the ravine."},{"id":"semetey-1-2013:p1215:b004:l031","ordinal":168893,"en":"The Muslims had giants,"},{"id":"semetey-1-2013:p1215:b004:l032","ordinal":168894,"en":"And mortals who called themselves heroes,"},{"id":"semetey-1-2013:p1215:b004:l033","ordinal":168895,"en":"Many kinds in all."},{"id":"semetey-1-2013:p1215:b004:l034","ordinal":168896,"en":"The Muslim khans"},{"id":"semetey-1-2013:p1215:b004:l035","ordinal":168897,"en":"Lost their wits;"},{"id":"semetey-1-2013:p1215:b004:l036","ordinal":168898,"en":"Never mind the prizes—"},{"id":"semetey-1-2013:p1215:b004:l037","ordinal":168899,"en":"All of them, even old hero Koshoy,"},{"id":"semetey-1-2013:p1215:b004:l038","ordinal":168900,"en":"Fled to save their lives."},{"id":"semetey-1-2013:p1215:b004:l039","ordinal":168901,"en":"Full in courage and strong in venom,"},{"id":"semetey-1-2013:p1216:b003:l001","ordinal":168902,"en":"Your bloodthirsty lion Manas"},{"id":"semetey-1-2013:p1216:b003:l002","ordinal":168903,"en":"Set right whoever attacked him."},{"id":"semetey-1-2013:p1216:b003:l003","ordinal":168904,"en":"The forty companions were beside him;"},{"id":"semetey-1-2013:p1216:b003:l004","ordinal":168905,"en":"Beneath him was his tulpar."},{"id":"semetey-1-2013:p1216:b003:l005","ordinal":168906,"en":"There had been times"},{"id":"semetey-1-2013:p1216:b003:l006","ordinal":168907,"en":"When he slaughtered the whole world."},{"id":"semetey-1-2013:p1216:b003:l007","ordinal":168908,"en":"His eyes blazing like fire,"},{"id":"semetey-1-2013:p1216:b003:l008","ordinal":168909,"en":"The great black Muslim host—"},{"id":"semetey-1-2013:p1216:b003:l009","ordinal":168910,"en":"When your lion elder grew angry,"},{"id":"semetey-1-2013:p1216:b003:l010","ordinal":168911,"en":"He slaughtered them and left them."},{"id":"semetey-1-2013:p1216:b003:l011","ordinal":168912,"en":"“While the Chinese swarm and seethe,"},{"id":"semetey-1-2013:p1216:b003:l012","ordinal":168913,"en":"The time has come to fight."},{"id":"semetey-1-2013:p1216:b003:l013","ordinal":168914,"en":"If doom comes, let us die;"},{"id":"semetey-1-2013:p1216:b003:l014","ordinal":168915,"en":"Taking Akkula's prize"},{"id":"semetey-1-2013:p1216:b003:l015","ordinal":168916,"en":"Away from the infidels,"},{"id":"semetey-1-2013:p1216:b003:l016","ordinal":168917,"en":"Let us divide it completely!"},{"id":"semetey-1-2013:p1216:b003:l017","ordinal":168918,"en":"Why stand looming in Talas"},{"id":"semetey-1-2013:p1216:b003:l018","ordinal":168919,"en":"Before the Black Kalmaks?"},{"id":"semetey-1-2013:p1216:b003:l019","ordinal":168920,"en":"Why fold our hands before infidels—"},{"id":"semetey-1-2013:p1216:b003:l020","ordinal":168921,"en":"What inheritance would that win us?!"},{"id":"semetey-1-2013:p1216:b003:l021","ordinal":168922,"en":"Let us drive the oppressive Black Kalmaks"},{"id":"semetey-1-2013:p1216:b003:l022","ordinal":168923,"en":"Toward Beijing."},{"id":"semetey-1-2013:p1216:b003:l023","ordinal":168924,"en":"Let us drive the snarling Chinese"},{"id":"semetey-1-2013:p1216:b003:l024","ordinal":168925,"en":"Into the khagan's realm."},{"id":"semetey-1-2013:p1216:b003:l025","ordinal":168926,"en":"Let us slaughter their leaders"},{"id":"semetey-1-2013:p1216:b003:l026","ordinal":168927,"en":"And drink our fill of their blood."},{"id":"semetey-1-2013:p1216:b003:l027","ordinal":168928,"en":"The infidels have shown their greed;"},{"id":"semetey-1-2013:p1216:b003:l028","ordinal":168929,"en":"Let us slaughter them."},{"id":"semetey-1-2013:p1216:b003:l029","ordinal":168930,"en":"Let us face and test them,"},{"id":"semetey-1-2013:p1216:b003:l030","ordinal":168931,"en":"And if doom comes, die."},{"id":"semetey-1-2013:p1216:b003:l031","ordinal":168932,"en":"If we do not fight them to destruction,"},{"id":"semetey-1-2013:p1216:b003:l032","ordinal":168933,"en":"These Chinese will grow insolent"},{"id":"semetey-1-2013:p1216:b003:l033","ordinal":168934,"en":"And strain greedily toward the Muslims."},{"id":"semetey-1-2013:p1216:b003:l034","ordinal":168935,"en":"They will turn back upon us"},{"id":"semetey-1-2013:p1216:b003:l035","ordinal":168936,"en":"And bring fierce upheaval.”"},{"id":"semetey-1-2013:p1216:b003:l036","ordinal":168937,"en":"When Manas said this,"},{"id":"semetey-1-2013:p1216:b003:l037","ordinal":168938,"en":"The great black people of Islam"},{"id":"semetey-1-2013:p1216:b003:l038","ordinal":168939,"en":"Were souls of another temper toward wrathful"},{"id":"semetey-1-2013:p1216:b003:l039","ordinal":168940,"en":"Hero Khan Kongurbai."},{"id":"semetey-1-2013:p1216:b004:l001","ordinal":168941,"en":"“If China takes the livestock, let it take it;"},{"id":"semetey-1-2013:p1216:b004:l002","ordinal":168942,"en":"Let us not attack the infidels."},{"id":"semetey-1-2013:p1216:b004:l003","ordinal":168943,"en":"Let us submit to what they say."},{"id":"semetey-1-2013:p1216:b004:l004","ordinal":168944,"en":"Kökötöy's prize—"},{"id":"semetey-1-2013:p1216:b004:l005","ordinal":168945,"en":"To the great Black Chinese,"},{"id":"semetey-1-2013:p1216:b004:l006","ordinal":168946,"en":"Let us give it without quarrel."},{"id":"semetey-1-2013:p1216:b004:l007","ordinal":168947,"en":"Let us withdraw safely to our own lands,"},{"id":"semetey-1-2013:p1216:b004:l008","ordinal":168948,"en":"And tell those who know"},{"id":"semetey-1-2013:p1216:b004:l009","ordinal":168949,"en":"What venom"},{"id":"semetey-1-2013:p1216:b004:l010","ordinal":168950,"en":"The Black Chinese and Manchus possess."},{"id":"semetey-1-2013:p1216:b004:l011","ordinal":168951,"en":"Without quarreling or raising conflict,"},{"id":"semetey-1-2013:p1216:b004:l012","ordinal":168952,"en":"Lion Manas,"},{"id":"semetey-1-2013:p1216:b004:l013","ordinal":168953,"en":"We gave the feast—let us return alive!"},{"id":"semetey-1-2013:p1216:b004:l014","ordinal":168954,"en":"We have long known"},{"id":"semetey-1-2013:p1216:b004:l015","ordinal":168955,"en":"How numerous the Black Kalmaks and Manchus are;"},{"id":"semetey-1-2013:p1216:b004:l016","ordinal":168956,"en":"We thought, when these infidels grew angry,"},{"id":"semetey-1-2013:p1216:b004:l017","ordinal":168957,"en":"They would multiply against us."},{"id":"semetey-1-2013:p1216:b004:l018","ordinal":168958,"en":"Why should we measure ourselves"},{"id":"semetey-1-2013:p1216:b004:l019","ordinal":168959,"en":"Against wicked infidels?"},{"id":"semetey-1-2013:p1216:b004:l020","ordinal":168960,"en":"Without matching them, Khan Manas,"}]
