{"id": "sayakbay-ms-current146:pdf210:l001", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 210, "folio": 593, "line_in_page": 1, "raw": "Күңгөйгө күмүш бар,", "text": "Күңгөйгө күмүш бар,", "en": "There was silver on the sunny slope.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf210:l002", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 210, "folio": 593, "line_in_page": 2, "raw": "Ойруңдо алтын бар,", "text": "Ойруңдо алтын бар,", "en": "There was gold in the hollow.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf210:l003", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 210, "folio": 593, "line_in_page": 3, "raw": "Кийдик келин, кыз жулган,", "text": "Кийдик келин, кыз жулган,", "en": "They stripped the brides and maidens of their clothes.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, name, or idiomatic interpretation requires later witness collation.", "bbox": null}
