{"id": "sayakbay-ms-current146:pdf176:l001", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 176, "folio": 559, "line_in_page": 1, "raw": "Ойкон козу осул деп,", "text": "Ойкон козу осул деп,", "en": "Saying, “Let that young ram be hung,”", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf176:l002", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 176, "folio": 559, "line_in_page": 2, "raw": "Ортосуна баргандан,", "text": "Ортосуна баргандан,", "en": "After he had gone into their midst,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf176:l003", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 176, "folio": 559, "line_in_page": 3, "raw": "Баатырсың деп балтаган,", "text": "Баатырсың деп балтаган,", "en": "They struck him with an axe, calling him a hero.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf176:l004", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 176, "folio": 559, "line_in_page": 4, "raw": "Ташка такка сайган,", "text": "Ташка такка сайган,", "en": "They drove him against stone and crag.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf176:l005", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 176, "folio": 559, "line_in_page": 5, "raw": "Акырында дүйнөнүн,", "text": "Акырында дүйнөнүн,", "en": "At the end of the world,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf176:l006", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 176, "folio": 559, "line_in_page": 6, "raw": "Карагып жете алам деп,", "text": "Карагып жете алам деп,", "en": "Thinking, “I can strive onward and reach it,”", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf176:l007", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 176, "folio": 559, "line_in_page": 7, "raw": "Карабай койсо калмакка,", "text": "Карабай койсо калмакка,", "en": "If he paid no heed to the Kalmyks,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf176:l008", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 176, "folio": 559, "line_in_page": 8, "raw": "Карган менен билгенге,", "text": "Карган менен билгенге,", "en": "So that even the aged would know,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf176:l009", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 176, "folio": 559, "line_in_page": 9, "raw": "Башка кара бугу айры,", "text": "Башка кара бугу айры,", "en": "The dark maral’s antlers branched apart,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf176:l010", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 176, "folio": 559, "line_in_page": 10, "raw": "Жер менен басып жүргөнгө,", "text": "Жер менен басып жүргөнгө,", "en": "For those who walked upon the earth,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf176:l011", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 176, "folio": 559, "line_in_page": 11, "raw": "Бүт дүйнөнү ээлерге,", "text": "Бүт дүйнөнү ээлерге,", "en": "For those who would possess the whole world,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf176:l012", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 176, "folio": 559, "line_in_page": 12, "raw": "Эбегейсиз доолорго,", "text": "Эбегейсиз доолорго,", "en": "Against immeasurable giants,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf176:l013", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 176, "folio": 559, "line_in_page": 13, "raw": "Карысы толук каланга,", "text": "Карысы толук каланга,", "en": "Against the multitude, old and full-grown,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf176:l014", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 176, "folio": 559, "line_in_page": 14, "raw": "Кайша берчү адамга,", "text": "Кайша берчү адамга,", "en": "Against the man who resisted,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf176:l015", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 176, "folio": 559, "line_in_page": 15, "raw": "Көңүлү бала иши арзан,", "text": "Көңүлү бала иши арзан,", "en": "His heart was young and treated the deed lightly.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf176:l016", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 176, "folio": 559, "line_in_page": 16, "raw": "Көрсөң душман жаманга,", "text": "Көрсөң душман жаманга,", "en": "When you see him, he is terrible to an enemy.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf176:l017", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 176, "folio": 559, "line_in_page": 17, "raw": "Көпкөрүнү бүлүктү,", "text": "Көпкөрүнү бүлүктү,", "en": "He threw the great host into turmoil,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf176:l018", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 176, "folio": 559, "line_in_page": 18, "raw": "Көз алдында салам деп,", "text": "Көз алдында салам деп,", "en": "Thinking, “I shall lay them down before his eyes.”", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf176:l019", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 176, "folio": 559, "line_in_page": 19, "raw": "Тил албаган тигиңге,", "text": "Тил албаган тигиңге,", "en": "Against that one who would not obey,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf176:l020", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 176, "folio": 559, "line_in_page": 20, "raw": "Бой берген үнсүзгө,", "text": "Бой берген үнсүзгө,", "en": "Against the silent one who submitted,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf176:l021", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 176, "folio": 559, "line_in_page": 21, "raw": "Кароолу толук калырга,", "text": "Кароолу толук калырга,", "en": "Against the watchful, complete host,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf176:l022", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 176, "folio": 559, "line_in_page": 22, "raw": "Кайша берчү баатырга,", "text": "Кайша берчү баатырга,", "en": "Against the hero who resisted,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf176:l023", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 176, "folio": 559, "line_in_page": 23, "raw": "Чын мушкулду тарттырып,", "text": "Чын мушкулду тарттырып,", "en": "He made them endure true hardship,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf176:l024", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 176, "folio": 559, "line_in_page": 24, "raw": "Ок жаадырып өтөрүн,", "text": "Ок жаадырып өтөрүн,", "en": "And sent a rain of bullets over them.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf176:l025", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 176, "folio": 559, "line_in_page": 25, "raw": "Чеңкерге аттырып,", "text": "Чеңкерге аттырып,", "en": "He had them shot by Chengker,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf176:l026", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 176, "folio": 559, "line_in_page": 26, "raw": "Эсебин минтип табуучу,", "text": "Эсебин минтип табуучу,", "en": "Thus he settled their account.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf176:l027", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 176, "folio": 559, "line_in_page": 27, "raw": "Кайшалап бергендин,", "text": "Кайшалап бергендин,", "en": "Of the one who kept resisting,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf176:l028", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 176, "folio": 559, "line_in_page": 28, "raw": "Караңгы жинин казуучу,", "text": "Караңгы жинин казуучу,", "en": "He would dig out the dark spirit.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf176:l029", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 176, "folio": 559, "line_in_page": 29, "raw": "Карышсама жоо чыкса,", "text": "Карышсама жоо чыкса,", "en": "If an enemy rose within a handspan,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf176:l030", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 176, "folio": 559, "line_in_page": 30, "raw": "Кара канга батырган,", "text": "Кара канга батырган,", "en": "He plunged him into black blood.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf176:l031", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 176, "folio": 559, "line_in_page": 31, "raw": "Бел кечүү эр болсо,", "text": "Бел кечүү эр болсо,", "en": "If he was a hero who crossed the pass,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf176:l032", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 176, "folio": 559, "line_in_page": 32, "raw": "Бел байлашкан шер болсо,", "text": "Бел байлашкан шер болсо,", "en": "If he was a champion who grappled belt to belt,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf176:l033", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 176, "folio": 559, "line_in_page": 33, "raw": "Кайтаганан аттырып,", "text": "Кайтаганан аттырып,", "en": "He had him shot down again,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf176:l034", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 176, "folio": 559, "line_in_page": 34, "raw": "Кармаш кылып жегей,", "text": "Кармаш кылып жегей,", "en": "And made him taste close combat.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf176:l035", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 176, "folio": 559, "line_in_page": 35, "raw": "Канга күнү, канга түн,", "text": "Канга күнү, канга түн,", "en": "Blood by day, blood by night—", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf176:l036", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 176, "folio": 559, "line_in_page": 36, "raw": "Каардан өт тураганда,", "text": "Каардан өт тураганда,", "en": "When he stood passing through wrath,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf176:l037", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 176, "folio": 559, "line_in_page": 37, "raw": "Чеңкер мерген көрүптүр.", "text": "Чеңкер мерген көрүптүр.", "en": "The marksman Chengker saw him.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
