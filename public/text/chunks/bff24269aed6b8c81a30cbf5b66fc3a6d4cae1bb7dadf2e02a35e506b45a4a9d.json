[{"id":"semetey-1-2013:p0891:b005:l038","ordinal":144385,"en":"You made me the only one in the nest!”"},{"id":"semetey-1-2013:p0891:b005:l039","ordinal":144386,"en":"He gathered his wits and grew calm."},{"id":"semetey-1-2013:p0892:b003:l001","ordinal":144387,"en":"His heart boiled into embers."},{"id":"semetey-1-2013:p0892:b003:l002","ordinal":144388,"en":"Helpless, that orphan"},{"id":"semetey-1-2013:p0892:b003:l003","ordinal":144389,"en":"Lamented his elder kinsmen."},{"id":"semetey-1-2013:p0892:b003:l004","ordinal":144390,"en":"“I have no supporting figure, no sign;"},{"id":"semetey-1-2013:p0892:b003:l005","ordinal":144391,"en":"I am like a bare hill."},{"id":"semetey-1-2013:p0892:b003:l006","ordinal":144392,"en":"In my playful childhood,"},{"id":"semetey-1-2013:p0892:b003:l007","ordinal":144393,"en":"Have I shot and eaten a wild duck?"},{"id":"semetey-1-2013:p0892:b003:l008","ordinal":144394,"en":"With my own kinsmen turned against me,"},{"id":"semetey-1-2013:p0892:b003:l009","ordinal":144395,"en":"Almighty Allah, Creator,"},{"id":"semetey-1-2013:p0892:b003:l010","ordinal":144396,"en":"Did you decree that I should suffer torment?”"},{"id":"semetey-1-2013:p0892:b003:l011","ordinal":144397,"en":"Manas’s only son—"},{"id":"semetey-1-2013:p0892:b003:l012","ordinal":144398,"en":"His heart was deeply troubled;"},{"id":"semetey-1-2013:p0892:b003:l013","ordinal":144399,"en":"Many worries fell upon his head,"},{"id":"semetey-1-2013:p0892:b003:l014","ordinal":144400,"en":"Tears poured from his eyes."},{"id":"semetey-1-2013:p0892:b003:l015","ordinal":144401,"en":"Bounding on Aktelki,"},{"id":"semetey-1-2013:p0892:b003:l016","ordinal":144402,"en":"With sixty marksmen beside him,"},{"id":"semetey-1-2013:p0892:b003:l017","ordinal":144403,"en":"Abyke came into view."},{"id":"semetey-1-2013:p0892:b003:l018","ordinal":144404,"en":"When he saw Abyke,"},{"id":"semetey-1-2013:p0892:b003:l019","ordinal":144405,"en":"The gray belt left by Manas"},{"id":"semetey-1-2013:p0892:b003:l020","ordinal":144406,"en":"He unfastened and hung about his neck."},{"id":"semetey-1-2013:p0892:b003:l021","ordinal":144407,"en":"Leading the horse Buurul,"},{"id":"semetey-1-2013:p0892:b003:l022","ordinal":144408,"en":"Bowing his head, Semetey"},{"id":"semetey-1-2013:p0892:b003:l023","ordinal":144409,"en":"Pleaded with Abyke:"},{"id":"semetey-1-2013:p0892:b003:l024","ordinal":144410,"en":"“Buurul is yours to buy; I am your gift."},{"id":"semetey-1-2013:p0892:b003:l025","ordinal":144411,"en":"Do not make me grieve, uncle; heed my words!"},{"id":"semetey-1-2013:p0892:b003:l026","ordinal":144412,"en":"Let me turn my neck toward truth;"},{"id":"semetey-1-2013:p0892:b003:l027","ordinal":144413,"en":"Let me offer my mother Kanykei to you!"},{"id":"semetey-1-2013:p0892:b003:l028","ordinal":144414,"en":"I shall give you your choice of horses:"},{"id":"semetey-1-2013:p0892:b003:l029","ordinal":144415,"en":"Take my beast, such as Arbuudan."},{"id":"semetey-1-2013:p0892:b003:l030","ordinal":144416,"en":"If you need it, uncle,"},{"id":"semetey-1-2013:p0892:b003:l031","ordinal":144417,"en":"Pour my blood into a flask and take it!"},{"id":"semetey-1-2013:p0892:b003:l032","ordinal":144418,"en":"Be my support when I climb upward;"},{"id":"semetey-1-2013:p0892:b003:l033","ordinal":144419,"en":"Be my prop when I descend!"},{"id":"semetey-1-2013:p0892:b003:l034","ordinal":144420,"en":"Uncle, do not send your army against me;"},{"id":"semetey-1-2013:p0892:b003:l035","ordinal":144421,"en":"Do not bring misery upon me!"},{"id":"semetey-1-2013:p0892:b003:l036","ordinal":144422,"en":"The orphan who has come fleeing—"},{"id":"semetey-1-2013:p0892:b003:l037","ordinal":144423,"en":"Abyke, do not make me perform a spectacle!"},{"id":"semetey-1-2013:p0892:b003:l038","ordinal":144424,"en":"I moved from Bukhara, seeking a supporting figure;"},{"id":"semetey-1-2013:p0892:b003:l039","ordinal":144425,"en":"I returned to this place,"},{"id":"semetey-1-2013:p0892:b004:l001","ordinal":144426,"en":"Calling Abyke and Kobosh my shelter."},{"id":"semetey-1-2013:p0892:b004:l002","ordinal":144427,"en":"Turn back, uncle, and be my kin;"},{"id":"semetey-1-2013:p0892:b004:l003","ordinal":144428,"en":"Do not corrupt my blood,"},{"id":"semetey-1-2013:p0892:b004:l004","ordinal":144429,"en":"Do not set my soul afire!”"},{"id":"semetey-1-2013:p0892:b004:l005","ordinal":144430,"en":"As the orphan stood with head bowed,"},{"id":"semetey-1-2013:p0892:b004:l006","ordinal":144431,"en":"That scoundrel Abyke"},{"id":"semetey-1-2013:p0892:b004:l007","ordinal":144432,"en":"God struck down still further."},{"id":"semetey-1-2013:p0892:b004:l008","ordinal":144433,"en":"Look at the haze, look at the embers!"},{"id":"semetey-1-2013:p0892:b004:l009","ordinal":144434,"en":"Sixty champions and Abyke"},{"id":"semetey-1-2013:p0892:b004:l010","ordinal":144435,"en":"Fired their shots like hail;"},{"id":"semetey-1-2013:p0892:b004:l011","ordinal":144436,"en":"Look at the bright red bullets!"},{"id":"semetey-1-2013:p0892:b004:l012","ordinal":144437,"en":"With every shot, Semetey"},{"id":"semetey-1-2013:p0892:b004:l013","ordinal":144438,"en":"Did not move, did not stir;"},{"id":"semetey-1-2013:p0892:b004:l014","ordinal":144439,"en":"The blessed orphan did not budge."},{"id":"semetey-1-2013:p0892:b004:l015","ordinal":144440,"en":"Not merely Abyke—against the boy,"},{"id":"semetey-1-2013:p0892:b004:l016","ordinal":144441,"en":"Even a flood could not prevail."},{"id":"semetey-1-2013:p0892:b004:l017","ordinal":144442,"en":"His fortune was complete."},{"id":"semetey-1-2013:p0892:b004:l018","ordinal":144443,"en":"If you looked into his heart,"},{"id":"semetey-1-2013:p0892:b004:l019","ordinal":144444,"en":"It was wider than the whole world."},{"id":"semetey-1-2013:p0892:b004:l020","ordinal":144445,"en":"If you looked at him,"},{"id":"semetey-1-2013:p0892:b004:l021","ordinal":144446,"en":"He was a lion protected by Shai,"},{"id":"semetey-1-2013:p0892:b004:l022","ordinal":144447,"en":"His fortune was complete."},{"id":"semetey-1-2013:p0892:b004:l023","ordinal":144448,"en":"No mortal could face him,"},{"id":"semetey-1-2013:p0892:b004:l025","ordinal":144449,"en":"In all eighteen thousand worlds,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0892:b004:l027","ordinal":144450,"en":"When the marksmen fired together,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0892:b004:l028","ordinal":144451,"en":"When they brought him torment,"},{"id":"semetey-1-2013:p0892:b004:l029","ordinal":144452,"en":"Without looking up or down,"},{"id":"semetey-1-2013:p0892:b004:l030","ordinal":144453,"en":"Without thinking he might die,"},{"id":"semetey-1-2013:p0892:b004:l031","ordinal":144454,"en":"Without looking around,"},{"id":"semetey-1-2013:p0892:b004:l032","ordinal":144455,"en":"Without sparing his life,"},{"id":"semetey-1-2013:p0892:b004:l034","ordinal":144456,"en":"When the orphan mounted and rode forth,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0892:b004:l035","ordinal":144457,"en":"The sixty champions, one by one,"},{"id":"semetey-1-2013:p0892:b004:l036","ordinal":144458,"en":"Trembled, finding no way out;"},{"id":"semetey-1-2013:p0892:b004:l037","ordinal":144459,"en":"Their world shriveled away."},{"id":"semetey-1-2013:p0892:b004:l038","ordinal":144460,"en":"When they saw the boy’s wrath,"},{"id":"semetey-1-2013:p0892:b004:l039","ordinal":144461,"en":"“We have died before our appointed death,” they said,"},{"id":"semetey-1-2013:p0893:b003:l001","ordinal":144462,"en":"“We have seen the other world,” they cried;"},{"id":"semetey-1-2013:p0893:b003:l002","ordinal":144463,"en":"The sixty champions, one by one,"},{"id":"semetey-1-2013:p0893:b003:l003","ordinal":144464,"en":"Fled trembling in every direction."},{"id":"semetey-1-2013:p0893:b003:l004","ordinal":144465,"en":"Abyke upon Aktelki,"},{"id":"semetey-1-2013:p0893:b003:l005","ordinal":144466,"en":"When he saw the boy’s appearance,"},{"id":"semetey-1-2013:p0893:b003:l006","ordinal":144467,"en":"Could not regain his composure:"},{"id":"semetey-1-2013:p0893:b003:l007","ordinal":144468,"en":"“Thick-armed, stone-hearted,"},{"id":"semetey-1-2013:p0893:b003:l008","ordinal":144469,"en":"That elephant-built brute,"},{"id":"semetey-1-2013:p0893:b003:l009","ordinal":144470,"en":"He is a hero who knows no fear."},{"id":"semetey-1-2013:p0893:b003:l010","ordinal":144471,"en":"His Holiness Aaly the Lion—"},{"id":"semetey-1-2013:p0893:b003:l011","ordinal":144472,"en":"His strength equals his!"},{"id":"semetey-1-2013:p0893:b003:l012","ordinal":144473,"en":"If I contend with this orphan,"},{"id":"semetey-1-2013:p0893:b003:l013","ordinal":144474,"en":"He will flatten me to the earth like a hare."},{"id":"semetey-1-2013:p0893:b003:l014","ordinal":144475,"en":"With his fearsome painted spear,"},{"id":"semetey-1-2013:p0893:b003:l015","ordinal":144476,"en":"Suddenly striking and overturning me,"},{"id":"semetey-1-2013:p0893:b003:l016","ordinal":144477,"en":"Will he not soak its tassel in blood?"},{"id":"semetey-1-2013:p0893:b003:l017","ordinal":144478,"en":"The sight troubles the heart;"},{"id":"semetey-1-2013:p0893:b003:l018","ordinal":144479,"en":"Fierce, leopard Manas—"},{"id":"semetey-1-2013:p0893:b003:l019","ordinal":144480,"en":"He looks exactly like him."},{"id":"semetey-1-2013:p0893:b003:l020","ordinal":144481,"en":"From every ridge, the forty chiltens"},{"id":"semetey-1-2013:p0893:b003:l021","ordinal":144482,"en":"Come together to support him."},{"id":"semetey-1-2013:p0893:b003:l022","ordinal":144483,"en":"A black-spotted leopard"},{"id":"semetey-1-2013:p0893:b003:l023","ordinal":144484,"en":"Pounces beside him."},{"id":"semetey-1-2013:p0893:b003:l025","ordinal":144485,"en":"Kydyr Iliyas, that blessed being,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0893:b003:l026","ordinal":144486,"en":"Has taken him under mighty protection."},{"id":"semetey-1-2013:p0893:b003:l027","ordinal":144487,"en":"His forty lion champions"},{"id":"semetey-1-2013:p0893:b003:l028","ordinal":144488,"en":"Have surrounded him."},{"id":"semetey-1-2013:p0893:b003:l029","ordinal":144489,"en":"A boy of this kind—"},{"id":"semetey-1-2013:p0893:b003:l030","ordinal":144490,"en":"No one can do him harm."},{"id":"semetey-1-2013:p0893:b003:l031","ordinal":144491,"en":"Not merely a mortal, good heavens—"},{"id":"semetey-1-2013:p0893:b003:l032","ordinal":144492,"en":"Even a flood could not overwhelm him."},{"id":"semetey-1-2013:p0893:b003:l033","ordinal":144493,"en":"The wrathful orphan’s"},{"id":"semetey-1-2013:p0893:b003:l034","ordinal":144494,"en":"Words I did not heed."},{"id":"semetey-1-2013:p0893:b003:l035","ordinal":144495,"en":"I have been a fool,"},{"id":"semetey-1-2013:p0893:b003:l036","ordinal":144496,"en":"Not knowing I would die.”"},{"id":"semetey-1-2013:p0893:b003:l037","ordinal":144497,"en":"Thinking this, Abyke—"},{"id":"semetey-1-2013:p0893:b003:l038","ordinal":144498,"en":"His rib bones trembled;"},{"id":"semetey-1-2013:p0893:b003:l039","ordinal":144499,"en":"His shit-filled bowels quaked."},{"id":"semetey-1-2013:p0893:b004:l001","ordinal":144500,"en":"Your elder Abyke’s"},{"id":"semetey-1-2013:p0893:b004:l002","ordinal":144501,"en":"The weapon slipped from his hand,"},{"id":"semetey-1-2013:p0893:b004:l003","ordinal":144502,"en":"His heart lurched with fear:"},{"id":"semetey-1-2013:p0893:b004:l004","ordinal":144503,"en":"“The orphan son of the ocean—"},{"id":"semetey-1-2013:p0893:b004:l005","ordinal":144504,"en":"Why should I contend with him?"},{"id":"semetey-1-2013:p0893:b004:l006","ordinal":144505,"en":"Without enduring this any longer,"},{"id":"semetey-1-2013:p0893:b004:l007","ordinal":144506,"en":"Let me enter Andijan.”"},{"id":"semetey-1-2013:p0893:b004:l008","ordinal":144507,"en":"He gave the drum a stroke;"},{"id":"semetey-1-2013:p0893:b004:l009","ordinal":144508,"en":"Your brave uncle Abyke"},{"id":"semetey-1-2013:p0893:b004:l010","ordinal":144509,"en":"Struck Aktelki once."},{"id":"semetey-1-2013:p0893:b004:l011","ordinal":144510,"en":"Turning aside, your uncle"},{"id":"semetey-1-2013:p0893:b004:l012","ordinal":144511,"en":"Fled in haste, urging his horse."},{"id":"semetey-1-2013:p0893:b004:l013","ordinal":144512,"en":"Abyke fled in panic;"},{"id":"semetey-1-2013:p0893:b004:l014","ordinal":144513,"en":"Would the steed Arbuudan let him go?"},{"id":"semetey-1-2013:p0893:b004:l015","ordinal":144514,"en":"Semetey pursued, leaning back."},{"id":"semetey-1-2013:p0893:b004:l016","ordinal":144515,"en":"“You have slaughtered Kobosh!”"},{"id":"semetey-1-2013:p0893:b004:l017","ordinal":144516,"en":"Abyke fled away resentfully."},{"id":"semetey-1-2013:p0893:b004:l018","ordinal":144517,"en":"Semetey came behind,"},{"id":"semetey-1-2013:p0893:b004:l019","ordinal":144518,"en":"Pleading, “Uncle!”"},{"id":"semetey-1-2013:p0893:b004:l022","ordinal":144519,"en":"Do not cast black night upon my head;","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0893:b004:l023","ordinal":144520,"en":"Alas, uncle, heed my words!"},{"id":"semetey-1-2013:p0893:b004:l024","ordinal":144521,"en":"Do not be foolish; stop a while."},{"id":"semetey-1-2013:p0893:b004:l025","ordinal":144522,"en":"Alas, my uncle, take my mother!"},{"id":"semetey-1-2013:p0893:b004:l026","ordinal":144523,"en":"Do not blacken my face."},{"id":"semetey-1-2013:p0893:b004:l027","ordinal":144524,"en":"‘He could not honor his elder;"},{"id":"semetey-1-2013:p0893:b004:l028","ordinal":144525,"en":"The orphan is uncouth,’ they will say."},{"id":"semetey-1-2013:p0893:b004:l029","ordinal":144526,"en":"Do not expose my face to the enemy!”"},{"id":"semetey-1-2013:p0893:b004:l030","ordinal":144527,"en":"He did not heed the words."},{"id":"semetey-1-2013:p0893:b004:l031","ordinal":144528,"en":"Semetey went on pleading;"},{"id":"semetey-1-2013:p0893:b004:l032","ordinal":144529,"en":"Abyke did not listen."},{"id":"semetey-1-2013:p0893:b004:l033","ordinal":144530,"en":"Over ridge after rugged ridge"},{"id":"semetey-1-2013:p0893:b004:l034","ordinal":144531,"en":"He crossed and went on."},{"id":"semetey-1-2013:p0893:b004:l035","ordinal":144532,"en":"Aktelki was a swift steed;"},{"id":"semetey-1-2013:p0893:b004:l036","ordinal":144533,"en":"Abyke, raising clouds of dust,"},{"id":"semetey-1-2013:p0893:b004:l037","ordinal":144534,"en":"Kept fleeing away."},{"id":"semetey-1-2013:p0893:b004:l038","ordinal":144535,"en":"Beneath him was Arbuurul,"},{"id":"semetey-1-2013:p0893:b004:l039","ordinal":144536,"en":"The offspring of Jelkaiyp,"},{"id":"semetey-1-2013:p0894:b003:l001","ordinal":144537,"en":"The wind could not catch his trotting pace;"},{"id":"semetey-1-2013:p0894:b003:l002","ordinal":144538,"en":"He was a fully perfected noble steed."},{"id":"semetey-1-2013:p0894:b003:l004","ordinal":144539,"en":"Maiden Saikal’s Alkara—","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0894:b003:l005","ordinal":144540,"en":"He was its own sibling."},{"id":"semetey-1-2013:p0894:b003:l007","ordinal":144541,"en":"Do not ask of Buurul’s qualities;","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0894:b003:l008","ordinal":144542,"en":"He was this lord’s wings."},{"id":"semetey-1-2013:p0894:b003:l009","ordinal":144543,"en":"If a wild creature with legs ran,"},{"id":"semetey-1-2013:p0894:b003:l010","ordinal":144544,"en":"He would trample past it."},{"id":"semetey-1-2013:p0894:b003:l011","ordinal":144545,"en":"When he headed downward,"},{"id":"semetey-1-2013:p0894:b003:l012","ordinal":144546,"en":"He lengthened his stride like a wild sheep."},{"id":"semetey-1-2013:p0894:b003:l013","ordinal":144547,"en":"When the hero leaned upon him,"},{"id":"semetey-1-2013:p0894:b003:l014","ordinal":144548,"en":"He reddened his eyes like a wild ram."},{"id":"semetey-1-2013:p0894:b003:l015","ordinal":144549,"en":"He had wings upon his flanks;"},{"id":"semetey-1-2013:p0894:b003:l016","ordinal":144550,"en":"Whenever he was freely given his head,"},{"id":"semetey-1-2013:p0894:b003:l017","ordinal":144551,"en":"He was accustomed to fly."},{"id":"semetey-1-2013:p0894:b003:l018","ordinal":144552,"en":"His basic form was this:"},{"id":"semetey-1-2013:p0894:b003:l019","ordinal":144553,"en":"A sparse tail and little mane,"},{"id":"semetey-1-2013:p0894:b003:l020","ordinal":144554,"en":"A high back and low stature."},{"id":"semetey-1-2013:p0894:b003:l021","ordinal":144555,"en":"If you asked of his broad rump,"},{"id":"semetey-1-2013:p0894:b003:l022","ordinal":144556,"en":"It was like an overturned cauldron."},{"id":"semetey-1-2013:p0894:b003:l023","ordinal":144557,"en":"His muscles were like a child."},{"id":"semetey-1-2013:p0894:b003:l024","ordinal":144558,"en":"Of this precious beast Buurul,"},{"id":"semetey-1-2013:p0894:b003:l025","ordinal":144559,"en":"The space between his hind thighs was like a ravine."},{"id":"semetey-1-2013:p0894:b003:l026","ordinal":144560,"en":"If you looked at his white teeth,"},{"id":"semetey-1-2013:p0894:b003:l027","ordinal":144561,"en":"They were like tempered steel."},{"id":"semetey-1-2013:p0894:b003:l028","ordinal":144562,"en":"As the horse Buurul went on,"},{"id":"semetey-1-2013:p0894:b003:l029","ordinal":144563,"en":"The black steel bit"},{"id":"semetey-1-2013:p0894:b003:l030","ordinal":144564,"en":"Clattered deep in his mouth."},{"id":"semetey-1-2013:p0894:b003:l031","ordinal":144565,"en":"His great hooves, like bowls,"},{"id":"semetey-1-2013:p0894:b003:l032","ordinal":144566,"en":"Cracked upon the earth when he pawed."},{"id":"semetey-1-2013:p0894:b003:l033","ordinal":144567,"en":"Tossing his forelock to the sky,"},{"id":"semetey-1-2013:p0894:b003:l034","ordinal":144568,"en":"His tail, like strands of silk,"},{"id":"semetey-1-2013:p0894:b003:l035","ordinal":144569,"en":"He slapped against his thighs."},{"id":"semetey-1-2013:p0894:b003:l036","ordinal":144570,"en":"The horse Buurul went on."},{"id":"semetey-1-2013:p0894:b003:l037","ordinal":144571,"en":"Whenever the creature ran,"},{"id":"semetey-1-2013:p0894:b003:l038","ordinal":144572,"en":"The face of the world trembled;"},{"id":"semetey-1-2013:p0894:b003:l039","ordinal":144573,"en":"His mane and his tail"},{"id":"semetey-1-2013:p0894:b004:l001","ordinal":144574,"en":"Streamed separately, strand by strand."},{"id":"semetey-1-2013:p0894:b004:l002","ordinal":144575,"en":"Dust billowed at his feet."},{"id":"semetey-1-2013:p0894:b004:l003","ordinal":144576,"en":"When he trod upon black stone,"},{"id":"semetey-1-2013:p0894:b004:l004","ordinal":144577,"en":"It crumbled to meal."},{"id":"semetey-1-2013:p0894:b004:l005","ordinal":144578,"en":"Iron-hoofed, copper-legged,"},{"id":"semetey-1-2013:p0894:b004:l006","ordinal":144579,"en":"The horse Buurul, never sweating,"},{"id":"semetey-1-2013:p0894:b004:l007","ordinal":144580,"en":"Reached Abyke's Telki"},{"id":"semetey-1-2013:p0894:b004:l008","ordinal":144581,"en":"Before an arrow could."},{"id":"semetey-1-2013:p0894:b004:l009","ordinal":144582,"en":"As he reached him and drew alongside,"},{"id":"semetey-1-2013:p0894:b004:l010","ordinal":144583,"en":"Khan Manas’s only son,"},{"id":"semetey-1-2013:p0894:b004:l011","ordinal":144584,"en":"Semetey, raised his spear:"},{"id":"semetey-1-2013:p0894:b004:l012","ordinal":144585,"en":"“My uncle Abyke—"},{"id":"semetey-1-2013:p0894:b004:l013","ordinal":144586,"en":"Let me frighten him,"},{"id":"semetey-1-2013:p0894:b004:l014","ordinal":144587,"en":"Let me somehow seize him."},{"id":"semetey-1-2013:p0894:b004:l015","ordinal":144588,"en":"To make him a shelter for my head,"},{"id":"semetey-1-2013:p0894:b004:l016","ordinal":144589,"en":"Let me cherish him."},{"id":"semetey-1-2013:p0894:b004:l017","ordinal":144590,"en":"Taking him to Talas,"},{"id":"semetey-1-2013:p0894:b004:l018","ordinal":144591,"en":"Over Argyn and Kyrgyz,"},{"id":"semetey-1-2013:p0894:b004:l019","ordinal":144592,"en":"My elder Abyke"},{"id":"semetey-1-2013:p0894:b004:l020","ordinal":144593,"en":"Let me raise as khan."},{"id":"semetey-1-2013:p0894:b004:l021","ordinal":144594,"en":"Let me level my spear to frighten him;"},{"id":"semetey-1-2013:p0894:b004:l022","ordinal":144595,"en":"Let me try this stratagem.”"},{"id":"semetey-1-2013:p0894:b004:l023","ordinal":144596,"en":"Toward the edge of his coat’s front,"},{"id":"semetey-1-2013:p0894:b004:l024","ordinal":144597,"en":"Toward the face of its skirt,"},{"id":"semetey-1-2013:p0894:b004:l025","ordinal":144598,"en":"Lord Semetey then"},{"id":"semetey-1-2013:p0894:b004:l026","ordinal":144599,"en":"Thrust aside as he passed."},{"id":"semetey-1-2013:p0894:b004:l027","ordinal":144600,"en":"The oath struck the oath-accursed man;"},{"id":"semetey-1-2013:p0894:b004:l028","ordinal":144601,"en":"Striking higher, the painted spear"},{"id":"semetey-1-2013:p0894:b004:l029","ordinal":144602,"en":"Entered his lung."},{"id":"semetey-1-2013:p0894:b004:l030","ordinal":144603,"en":"Abyke and Kobosh’s"},{"id":"semetey-1-2013:p0894:b004:l031","ordinal":144604,"en":"Appointed deaths had both arrived."},{"id":"semetey-1-2013:p0894:b004:l032","ordinal":144605,"en":"Overturning Abyke,"},{"id":"semetey-1-2013:p0894:b004:l033","ordinal":144606,"en":"Sending Kobosh to the grave,"},{"id":"semetey-1-2013:p0894:b004:l034","ordinal":144607,"en":"The boy Semetey again"},{"id":"semetey-1-2013:p0894:b004:l035","ordinal":144608,"en":"Showed his fierce nature."},{"id":"semetey-1-2013:p0894:b004:l036","ordinal":144609,"en":"He soaked the valley in fat;"},{"id":"semetey-1-2013:p0894:b004:l037","ordinal":144610,"en":"When enmity flared,"},{"id":"semetey-1-2013:p0894:b004:l038","ordinal":144611,"en":"He killed his own elder kinsman."},{"id":"semetey-1-2013:p0894:b004:l039","ordinal":144612,"en":"He poured blood into the dark water,"},{"id":"semetey-1-2013:p0895:b003:l001","ordinal":144613,"en":"He set the grassy land ablaze,"},{"id":"semetey-1-2013:p0895:b003:l002","ordinal":144614,"en":"Set fire to the meadows."},{"id":"semetey-1-2013:p0895:b003:l003","ordinal":144615,"en":"Growing to manhood as an orphan,"},{"id":"semetey-1-2013:p0895:b003:l004","ordinal":144616,"en":"He joined the ranks himself,"},{"id":"semetey-1-2013:p0895:b003:l005","ordinal":144617,"en":"Matured and became a man,"},{"id":"semetey-1-2013:p0895:b003:l006","ordinal":144618,"en":"An equal among heroes’ sons."},{"id":"semetey-1-2013:p0895:b003:l007","ordinal":144619,"en":"Alabek of Alty-Shaar,"},{"id":"semetey-1-2013:p0895:b003:l008","ordinal":144620,"en":"Buyanbek of Khan Buudaiyk—"},{"id":"semetey-1-2013:p0895:b003:l009","ordinal":144621,"en":"The great armies of those two,"},{"id":"semetey-1-2013:p0895:b003:l010","ordinal":144622,"en":"Making Tuuchunak rear and plunge,"},{"id":"semetey-1-2013:p0895:b003:l011","ordinal":144623,"en":"What did your uncle Sary Khan do?"},{"id":"semetey-1-2013:p0895:b003:l012","ordinal":144624,"en":"Those two with their great armies"},{"id":"semetey-1-2013:p0895:b003:l013","ordinal":144625,"en":"He utterly slaughtered and destroyed."},{"id":"semetey-1-2013:p0895:b003:l014","ordinal":144626,"en":"While Sary Khan"},{"id":"semetey-1-2013:p0895:b003:l015","ordinal":144627,"en":"Did as he saw fit,"},{"id":"semetey-1-2013:p0895:b003:l016","ordinal":144628,"en":"Scattering them up and down,"},{"id":"semetey-1-2013:p0895:b003:l017","ordinal":144629,"en":"While he slaughtered them,"},{"id":"semetey-1-2013:p0895:b003:l018","ordinal":144630,"en":"Khan Bakai’s Baitailak"},{"id":"semetey-1-2013:p0895:b003:l019","ordinal":144631,"en":"Shouted along the steep bank,"},{"id":"semetey-1-2013:p0895:b003:l020","ordinal":144632,"en":"Cried “Manas!” as his battle cry,"},{"id":"semetey-1-2013:p0895:b003:l021","ordinal":144633,"en":"And the many Sarts on packsaddles"},{"id":"semetey-1-2013:p0895:b003:l022","ordinal":144634,"en":"He swept down and slaughtered."},{"id":"semetey-1-2013:p0895:b003:l023","ordinal":144635,"en":"Sary Khan’s Kalyk,"},{"id":"semetey-1-2013:p0895:b003:l024","ordinal":144636,"en":"When he once felled the kaldai’s standard,"},{"id":"semetey-1-2013:p0895:b003:l026","ordinal":144637,"en":"Upon the Muslim people"},{"id":"semetey-1-2013:p0895:b003:l027","ordinal":144638,"en":"His light had shone in a special way."},{"id":"semetey-1-2013:p0895:b003:l028","ordinal":144639,"en":"His intentions too were pure."},{"id":"semetey-1-2013:p0895:b003:l029","ordinal":144640,"en":"Sary Khan’s son"}]
