[{"id":"manas-2010:p0579:b001:l022","ordinal":26113,"en":"When I look before you,"},{"id":"manas-2010:p0579:b001:l023","ordinal":26114,"en":"You have a black-eared lion."},{"id":"manas-2010:p0579:b001:l024","ordinal":26115,"en":"No mortal can face and overcome you;"},{"id":"manas-2010:p0579:b001:l025","ordinal":26116,"en":"You have reason to be called a lion."},{"id":"manas-2010:p0579:b001:l026","ordinal":26117,"en":"To learn your father's lineage,"},{"id":"manas-2010:p0579:b001:l027","ordinal":26118,"en":"My son, I have words for you."},{"id":"manas-2010:p0579:b001:l028","ordinal":26119,"en":"We have come before you,"},{"id":"manas-2010:p0579:b001:l029","ordinal":26120,"en":"Dwelling beside the river Lob,"},{"id":"manas-2010:p0579:b001:l030","ordinal":26121,"en":"With Karacha as our foremost khan."},{"id":"manas-2010:p0579:b001:l031","ordinal":26122,"en":"We who came were many souls;"},{"id":"manas-2010:p0579:b001:l032","ordinal":26123,"en":"Unable to bear your wrath,"},{"id":"manas-2010:p0579:b001:l033","ordinal":26124,"en":"All of us collapsed."},{"id":"manas-2010:p0579:b001:l034","ordinal":26125,"en":"We are hungry, destitute folk."},{"id":"manas-2010:p0579:b001:l035","ordinal":26126,"en":"God knows, and you must know:"},{"id":"manas-2010:p0579:b001:l036","ordinal":26127,"en":"Coming right before you,"},{"id":"manas-2010:p0579:b001:l037","ordinal":26128,"en":"We have been seeking wheat."},{"id":"manas-2010:p0579:b001:l038","ordinal":26129,"en":"God's light did not shine down;"},{"id":"manas-2010:p0579:b001:l039","ordinal":26130,"en":"Our land grew harsh."},{"id":"manas-2010:p0579:b001:l040","ordinal":26131,"en":"Bringing a wondrous steed, seeking grain,"},{"id":"manas-2010:p0579:b001:l041","ordinal":26132,"en":"Our people have become destitute."},{"id":"manas-2010:p0579:b001:l042","ordinal":26133,"en":"You are a son endowed with faith,"},{"id":"manas-2010:p0580:b001:l001","ordinal":26134,"en":"If you suddenly grow excited,"},{"id":"manas-2010:p0580:b001:l002","ordinal":26135,"en":"Will you slaughter us!”"},{"id":"manas-2010:p0580:b001:l003","ordinal":26136,"en":"Then Manas said:"},{"id":"manas-2010:p0580:b001:l004","ordinal":26137,"en":"“My white-bearded elder,"},{"id":"manas-2010:p0580:b001:l005","ordinal":26138,"en":"My saint, equal to my father,"},{"id":"manas-2010:p0580:b001:l006","ordinal":26139,"en":"Greetings upon greetings; peace be upon you!"},{"id":"manas-2010:p0580:b001:l007","ordinal":26140,"en":"My white-bearded elder,"},{"id":"manas-2010:p0580:b001:l008","ordinal":26141,"en":"Why should I slaughter you?"},{"id":"manas-2010:p0580:b001:l009","ordinal":26142,"en":"What inheritance would I gain?"},{"id":"manas-2010:p0580:b001:l010","ordinal":26143,"en":"My deepest origins,"},{"id":"manas-2010:p0580:b001:l011","ordinal":26144,"en":"Let me now tell you."},{"id":"manas-2010:p0580:b001:l012","ordinal":26145,"en":"Whose peaks never lose their snow,"},{"id":"manas-2010:p0580:b001:l013","ordinal":26146,"en":"Ala-Too is our land."},{"id":"manas-2010:p0580:b001:l014","ordinal":26147,"en":"Eating meat in summer and winter,"},{"id":"manas-2010:p0580:b001:l015","ordinal":26148,"en":"We are the Kyrgyz people blessed by Kydyr."},{"id":"manas-2010:p0580:b001:l016","ordinal":26149,"en":"We are not sated by begging for drink;"},{"id":"manas-2010:p0580:b001:l017","ordinal":26150,"en":"We do not give up greed."},{"id":"manas-2010:p0580:b001:l018","ordinal":26151,"en":"If an enemy comes out to fight,"},{"id":"manas-2010:p0580:b001:l019","ordinal":26152,"en":"We prowl like leopards."},{"id":"manas-2010:p0580:b001:l020","ordinal":26153,"en":"Our grandfather was Karakan;"},{"id":"manas-2010:p0580:b001:l021","ordinal":26154,"en":"That Karakan died."},{"id":"manas-2010:p0580:b001:l022","ordinal":26155,"en":"When the khan died, upon the Kyrgyz,"},{"id":"manas-2010:p0580:b001:l023","ordinal":26156,"en":"The Black Chinese and many Manchus"},{"id":"manas-2010:p0580:b001:l024","ordinal":26157,"en":"Swept in and divided them."},{"id":"manas-2010:p0580:b001:l025","ordinal":26158,"en":"They devastated and slaughtered the people,"},{"id":"manas-2010:p0580:b001:l026","ordinal":26159,"en":"Made many of them plunder."},{"id":"manas-2010:p0580:b001:l027","ordinal":26160,"en":"They divided the living among themselves;"},{"id":"manas-2010:p0580:b001:l028","ordinal":26161,"en":"Those who resisted,"},{"id":"manas-2010:p0580:b001:l029","ordinal":26162,"en":"They simply slaughtered."},{"id":"manas-2010:p0580:b001:l030","ordinal":26163,"en":"They seized the courageous,"},{"id":"manas-2010:p0580:b001:l031","ordinal":26164,"en":"And killed so many."},{"id":"manas-2010:p0580:b001:l032","ordinal":26165,"en":"My khan father's eight sons"},{"id":"manas-2010:p0580:b001:l033","ordinal":26166,"en":"Were left young, still crawling;"},{"id":"manas-2010:p0580:b001:l034","ordinal":26167,"en":"Helpless, all were left dazed."},{"id":"manas-2010:p0580:b001:l035","ordinal":26168,"en":"Our ancestor the khan had died."},{"id":"manas-2010:p0580:b001:l036","ordinal":26169,"en":"The countless riches left by our ancestor,"},{"id":"manas-2010:p0580:b001:l037","ordinal":26170,"en":"The Black Chinese and many Manchus"},{"id":"manas-2010:p0580:b001:l038","ordinal":26171,"en":"Divided, measuring by their whips."},{"id":"manas-2010:p0580:b001:l039","ordinal":26172,"en":"Karakan's eight,"},{"id":"manas-2010:p0580:b001:l040","ordinal":26173,"en":"Some single-born, some twins,"},{"id":"manas-2010:p0580:b001:l041","ordinal":26174,"en":"They drove one to Eren,"},{"id":"manas-2010:p0580:b001:l042","ordinal":26175,"en":"Drove another away,"},{"id":"manas-2010:p0581:b001:l001","ordinal":26176,"en":"And cast him into the depths."},{"id":"manas-2010:p0581:b001:l002","ordinal":26177,"en":"They drove one to the Kazakhs,"},{"id":"manas-2010:p0581:b001:l003","ordinal":26178,"en":"Then cast another"},{"id":"manas-2010:p0581:b001:l004","ordinal":26179,"en":"Into torment no man had seen."},{"id":"manas-2010:p0581:b001:l005","ordinal":26180,"en":"Along Ala-Too,"},{"id":"manas-2010:p0581:b001:l006","ordinal":26181,"en":"There had been eight brothers—"},{"id":"manas-2010:p0581:b001:l007","ordinal":26182,"en":"No village remained spread in encampment."},{"id":"manas-2010:p0581:b001:l008","ordinal":26183,"en":"Whether dead or alive is unknown;"},{"id":"manas-2010:p0581:b001:l009","ordinal":26184,"en":"There is no news of those relatives."},{"id":"manas-2010:p0581:b001:l010","ordinal":26185,"en":"I have much to say if I tell it."},{"id":"manas-2010:p0581:b001:l011","ordinal":26186,"en":"Against the Black Chinese and Manchus,"},{"id":"manas-2010:p0581:b001:l012","ordinal":26187,"en":"I have vengeance that will not leave my belly."},{"id":"manas-2010:p0581:b001:l013","ordinal":26188,"en":"My father, Jakyp,"},{"id":"manas-2010:p0581:b001:l014","ordinal":26189,"en":"They bound hand and foot."},{"id":"manas-2010:p0581:b001:l015","ordinal":26190,"en":"Humiliating him then,"},{"id":"manas-2010:p0581:b001:l016","ordinal":26191,"en":"They drove him toward Altai."},{"id":"manas-2010:p0581:b001:l017","ordinal":26192,"en":"When my father reached Altai,"},{"id":"manas-2010:p0581:b001:l018","ordinal":26193,"en":"Driven there, he had a child."},{"id":"manas-2010:p0581:b001:l019","ordinal":26194,"en":"Until seven I did not walk;"},{"id":"manas-2010:p0581:b001:l020","ordinal":26195,"en":"I remained a child unable to walk."},{"id":"manas-2010:p0581:b001:l021","ordinal":26196,"en":"When my age reached eight,"},{"id":"manas-2010:p0581:b001:l022","ordinal":26197,"en":"I began to make trouble."},{"id":"manas-2010:p0581:b001:l023","ordinal":26198,"en":"When I reached nine,"},{"id":"manas-2010:p0581:b001:l024","ordinal":26199,"en":"Nine Kalmyk boys"},{"id":"manas-2010:p0581:b001:l025","ordinal":26200,"en":"I slaughtered utterly."},{"id":"manas-2010:p0581:b001:l026","ordinal":26201,"en":"When I reached ten,"},{"id":"manas-2010:p0581:b001:l027","ordinal":26202,"en":"I broke royal courts and took spoils."},{"id":"manas-2010:p0581:b001:l028","ordinal":26203,"en":"When I reached twelve,"},{"id":"manas-2010:p0581:b001:l029","ordinal":26204,"en":"I attacked mighty peoples."},{"id":"manas-2010:p0581:b001:l030","ordinal":26205,"en":"When I turned thirteen,"},{"id":"manas-2010:p0581:b001:l031","ordinal":26206,"en":"I thinned their village headmen's ranks."},{"id":"manas-2010:p0581:b001:l032","ordinal":26207,"en":"Upon the champions Döngö and Orgo,"},{"id":"manas-2010:p0581:b001:l033","ordinal":26208,"en":"Upon all of them, I wrought slaughter."},{"id":"manas-2010:p0581:b001:l034","ordinal":26209,"en":"My forty households of Kyrgyz people,"},{"id":"manas-2010:p0581:b001:l035","ordinal":26210,"en":"From the Black Chinese and Manchus—"},{"id":"manas-2010:p0581:b001:l036","ordinal":26211,"en":"I would devote myself to such a people—"},{"id":"manas-2010:p0581:b001:l037","ordinal":26212,"en":"I rescued them."},{"id":"manas-2010:p0581:b001:l038","ordinal":26213,"en":"Of leopard, gray-maned Manas,"},{"id":"manas-2010:p0581:b001:l039","ordinal":26214,"en":"I am the dark eye that looks."},{"id":"manas-2010:p0581:b001:l040","ordinal":26215,"en":"Who roused the khan of Beijing,"},{"id":"manas-2010:p0581:b001:l041","ordinal":26216,"en":"I am Khan Manas himself."},{"id":"manas-2010:p0581:b001:l042","ordinal":26217,"en":"Migrating, I came and settled,"},{"id":"manas-2010:p0582:b001:l001","ordinal":26218,"en":"In my lands, Ala-Too and Talas."},{"id":"manas-2010:p0582:b001:l002","ordinal":26219,"en":"I intend to gather"},{"id":"manas-2010:p0582:b001:l003","ordinal":26220,"en":"My people left from the Chinese slaughter!"},{"id":"manas-2010:p0582:b001:l004","ordinal":26221,"en":"I found a few relatives;"},{"id":"manas-2010:p0582:b001:l005","ordinal":26222,"en":"Grappling with the Chinese empire,"},{"id":"manas-2010:p0582:b001:l006","ordinal":26223,"en":"I raised a mighty uproar."},{"id":"manas-2010:p0582:b001:l007","ordinal":26224,"en":"(I saw Kydyr on the plain.)"},{"id":"manas-2010:p0582:b001:l008","ordinal":26225,"en":"I camped upon the open steppe;"},{"id":"manas-2010:p0582:b001:l009","ordinal":26226,"en":"The forty guardian spirits came as friends,"},{"id":"manas-2010:p0582:b001:l010","ordinal":26227,"en":"And I became a true Muslim."},{"id":"manas-2010:p0582:b001:l011","ordinal":26228,"en":"In Altai I scattered what I had gathered;"},{"id":"manas-2010:p0582:b001:l012","ordinal":26229,"en":"Becoming a true Muslim,"},{"id":"manas-2010:p0582:b001:l013","ordinal":26230,"en":"I desired faith alone."},{"id":"manas-2010:p0582:b001:l014","ordinal":26231,"en":"God is one, the Quran is true:"},{"id":"manas-2010:p0582:b001:l015","ordinal":26232,"en":"I learned it upon the open steppe."},{"id":"manas-2010:p0582:b001:l016","ordinal":26233,"en":"Cleansed of the dark faith,"},{"id":"manas-2010:p0582:b001:l017","ordinal":26234,"en":"Thus I entered the faith."},{"id":"manas-2010:p0582:b001:l018","ordinal":26235,"en":"I turned my intent toward the Truth."},{"id":"manas-2010:p0582:b001:l019","ordinal":26236,"en":"The Black Kalmyks and Manchu people—"},{"id":"manas-2010:p0582:b001:l020","ordinal":26237,"en":"Fighting six months without rest,"},{"id":"manas-2010:p0582:b001:l021","ordinal":26238,"en":"I resolved on many an attack."},{"id":"manas-2010:p0582:b001:l022","ordinal":26239,"en":"Among the people of the Chinese empire,"},{"id":"manas-2010:p0582:b001:l023","ordinal":26240,"en":"I began great upheaval."},{"id":"manas-2010:p0582:b001:l024","ordinal":26241,"en":"I captured their village headmen;"},{"id":"manas-2010:p0582:b001:l025","ordinal":26242,"en":"Their governors who challenged me,"},{"id":"manas-2010:p0582:b001:l026","ordinal":26243,"en":"I laid them out at full length."},{"id":"manas-2010:p0582:b001:l027","ordinal":26244,"en":"By the teeming Chinese,"},{"id":"manas-2010:p0582:b001:l028","ordinal":26245,"en":"I let myself be struck from the flank."},{"id":"manas-2010:p0582:b001:l029","ordinal":26246,"en":"Joined to me when I was louse-sized,"},{"id":"manas-2010:p0582:b001:l030","ordinal":26247,"en":"United when I was thumb-sized,"},{"id":"manas-2010:p0582:b001:l031","ordinal":26248,"en":"Toruchaar, that surpassing wondrous steed,"},{"id":"manas-2010:p0582:b001:l032","ordinal":26249,"en":"I then lost to a shot."},{"id":"manas-2010:p0582:b001:l033","ordinal":26250,"en":"Their lords and giants,"},{"id":"manas-2010:p0582:b001:l034","ordinal":26251,"en":"I came away unable to capture them."},{"id":"manas-2010:p0582:b001:l035","ordinal":26252,"en":"The two khans, Ezkara and Zholoy,"},{"id":"manas-2010:p0582:b001:l036","ordinal":26253,"en":"I came away unable to kill them."},{"id":"manas-2010:p0582:b001:l037","ordinal":26254,"en":"To the Chinese empire of Deep Beijing,"},{"id":"manas-2010:p0582:b001:l038","ordinal":26255,"en":"I set out but could not reach it."},{"id":"manas-2010:p0582:b001:l039","ordinal":26256,"en":"Your father's grave, loneliness!"},{"id":"manas-2010:p0582:b001:l040","ordinal":26257,"en":"No wondrous steed to ride on raids;"},{"id":"manas-2010:p0582:b001:l041","ordinal":26258,"en":"My eyes blaze, my heart is a live coal."},{"id":"manas-2010:p0582:b001:l042","ordinal":26259,"en":"It makes me grieve in every way,"},{"id":"manas-2010:p0583:b001:l001","ordinal":26260,"en":"Your father's grave, treacherous world!"},{"id":"manas-2010:p0583:b001:l002","ordinal":26261,"en":"Their star darkened in the sky,"},{"id":"manas-2010:p0583:b001:l003","ordinal":26262,"en":"The forty households driven astray to Altai"},{"id":"manas-2010:p0583:b001:l004","ordinal":26263,"en":"Came safely, escaping."},{"id":"manas-2010:p0583:b001:l005","ordinal":26264,"en":"Letting no winged creature strike them,"},{"id":"manas-2010:p0583:b001:l006","ordinal":26265,"en":"Letting no beaked creature peck them,"},{"id":"manas-2010:p0583:b001:l007","ordinal":26266,"en":"The Manchus who came to grapple,"},{"id":"manas-2010:p0583:b001:l008","ordinal":26267,"en":"I made crawl and trampled into the earth."},{"id":"manas-2010:p0583:b001:l009","ordinal":26268,"en":"My forty households of Kyrgyz people,"},{"id":"manas-2010:p0583:b001:l010","ordinal":26269,"en":"Thus I protected them from the Chinese."},{"id":"manas-2010:p0583:b001:l011","ordinal":26270,"en":"I went up and settled in Talas,"},{"id":"manas-2010:p0583:b001:l012","ordinal":26271,"en":"Weary from migrating out of Altai."},{"id":"manas-2010:p0583:b001:l013","ordinal":26272,"en":"I found Talas, a defensible land;"},{"id":"manas-2010:p0583:b001:l014","ordinal":26273,"en":"I found scattered, destitute people."},{"id":"manas-2010:p0583:b001:l015","ordinal":26274,"en":"With old Babadyikan,"},{"id":"manas-2010:p0583:b001:l016","ordinal":26275,"en":"We sowed wheat in partnership."},{"id":"manas-2010:p0583:b001:l017","ordinal":26276,"en":"For six months, until the wheat ripened,"},{"id":"manas-2010:p0583:b001:l018","ordinal":26277,"en":"We dwelt upon Boz-Talaa."},{"id":"manas-2010:p0583:b001:l019","ordinal":26278,"en":"We labored and obtained food."},{"id":"manas-2010:p0583:b001:l020","ordinal":26279,"en":"Killing warriors and slaughtering peoples—"},{"id":"manas-2010:p0583:b001:l021","ordinal":26280,"en":"We renounced such wickedness."},{"id":"manas-2010:p0583:b001:l022","ordinal":26281,"en":"Of a true Muslim mortal,"},{"id":"manas-2010:p0583:b001:l023","ordinal":26282,"en":"I see the scalp."},{"id":"manas-2010:p0583:b001:l024","ordinal":26283,"en":"The wheat piled like a mountain,"},{"id":"manas-2010:p0583:b001:l025","ordinal":26284,"en":"To the poor and destitute,"},{"id":"manas-2010:p0583:b001:l026","ordinal":26285,"en":"I shall divide and give it all."},{"id":"manas-2010:p0583:b001:l027","ordinal":26286,"en":"Born a gray-maned leopard,"},{"id":"manas-2010:p0583:b001:l028","ordinal":26287,"en":"I am Bloodthirsty Manas himself."},{"id":"manas-2010:p0583:b001:l029","ordinal":26288,"en":"Spilling blood, I grew hardened;"},{"id":"manas-2010:p0583:b001:l030","ordinal":26289,"en":"Among the seething Chinese,"},{"id":"manas-2010:p0583:b001:l031","ordinal":26290,"en":"I was named the Bloodthirsty Burut."},{"id":"manas-2010:p0583:b001:l032","ordinal":26291,"en":"Beijing, the true Chinese empire,"},{"id":"manas-2010:p0583:b001:l033","ordinal":26292,"en":"I truly fought and slaughtered."},{"id":"manas-2010:p0583:b001:l034","ordinal":26293,"en":"The thronging people of Beijing swarmed about;"},{"id":"manas-2010:p0583:b001:l035","ordinal":26294,"en":"For challenging me, I slaughtered them."},{"id":"manas-2010:p0583:b001:l036","ordinal":26295,"en":"I waged war far and wide."},{"id":"manas-2010:p0583:b001:l037","ordinal":26296,"en":"The Kalmyks who fell into my hands,"},{"id":"manas-2010:p0583:b001:l038","ordinal":26297,"en":"I crushed utterly like lice."},{"id":"manas-2010:p0583:b001:l039","ordinal":26298,"en":"I am a leopard, I am a wolf;"},{"id":"manas-2010:p0583:b001:l040","ordinal":26299,"en":"Wealthy Jakyp's only son,"},{"id":"manas-2010:p0583:b001:l041","ordinal":26300,"en":"I am leopard Manas himself!"},{"id":"manas-2010:p0583:b001:l042","ordinal":26301,"en":"Right beside the wheat,"},{"id":"manas-2010:p0584:b001:l001","ordinal":26302,"en":"I am the champion keeping watch."},{"id":"manas-2010:p0584:b001:l002","ordinal":26303,"en":"If enemies come out to fight,"},{"id":"manas-2010:p0584:b001:l003","ordinal":26304,"en":"I shall slaughter them, leaving none."},{"id":"manas-2010:p0584:b001:l004","ordinal":26305,"en":"Drinking blood when wrathful,"},{"id":"manas-2010:p0584:b001:l005","ordinal":26306,"en":"I am a black-blazed hawk."},{"id":"manas-2010:p0584:b001:l006","ordinal":26307,"en":"Finding no mountain to strike against,"},{"id":"manas-2010:p0584:b001:l007","ordinal":26308,"en":"Finding no enemy to fight,"},{"id":"manas-2010:p0584:b001:l008","ordinal":26309,"en":"I stand upon the open steppe."},{"id":"manas-2010:p0584:b001:l009","ordinal":26310,"en":"The grain of the Kyrgyz people...”"},{"id":"manas-2010:p0584:b001:l010","ordinal":26311,"en":"Gray-maned Manas said this;"},{"id":"manas-2010:p0584:b001:l011","ordinal":26312,"en":"Khan Manas spoke a word,"},{"id":"manas-2010:p0584:b001:l012","ordinal":26313,"en":"Into the heart of a khan like Karacha,"},{"id":"manas-2010:p0584:b001:l013","ordinal":26314,"en":"He put an unclean word."},{"id":"manas-2010:p0584:b001:l014","ordinal":26315,"en":"When Karacha heard this,"},{"id":"manas-2010:p0584:b001:l015","ordinal":26316,"en":"He approached Manas directly,"},{"id":"manas-2010:p0584:b001:l016","ordinal":26317,"en":"Making the dun horse step majestically,"},{"id":"manas-2010:p0584:b001:l017","ordinal":26318,"en":"Before your mighty destroyer,"},{"id":"manas-2010:p0584:b001:l018","ordinal":26319,"en":"He led and presented it."},{"id":"manas-2010:p0584:b001:l019","ordinal":26320,"en":"“My son, if you are Manas,"},{"id":"manas-2010:p0584:b001:l020","ordinal":26321,"en":"My God has granted my wish!"},{"id":"manas-2010:p0584:b001:l021","ordinal":26322,"en":"Born a leopard, bloodthirsty lion,"},{"id":"manas-2010:p0584:b001:l022","ordinal":26323,"en":"May you always live in safety!"},{"id":"manas-2010:p0584:b001:l023","ordinal":26324,"en":"Making us meet upon the steppe,"},{"id":"manas-2010:p0584:b001:l024","ordinal":26325,"en":"My God has brought us together!"},{"id":"manas-2010:p0584:b001:l025","ordinal":26326,"en":"I too am a Kyrgyz myself;"},{"id":"manas-2010:p0584:b001:l026","ordinal":26327,"en":"Of your forty-tribed Kyrgyz people,"},{"id":"manas-2010:p0584:b001:l027","ordinal":26328,"en":"I was one tribe."},{"id":"manas-2010:p0584:b001:l028","ordinal":26329,"en":"My name is Noygut, this people;"},{"id":"manas-2010:p0584:b001:l029","ordinal":26330,"en":"I was one of the fearless,"},{"id":"manas-2010:p0584:b001:l030","ordinal":26331,"en":"I was a prince myself."},{"id":"manas-2010:p0584:b001:l031","ordinal":26332,"en":"Let me look closely upon your face;"},{"id":"manas-2010:p0584:b001:l032","ordinal":26333,"en":"Akkula, surpassing other beasts,"},{"id":"manas-2010:p0584:b001:l033","ordinal":26334,"en":"Let me give as a gift."},{"id":"manas-2010:p0584:b001:l034","ordinal":26335,"en":"Akkula is a gift; I am for sale."},{"id":"manas-2010:p0584:b001:l035","ordinal":26336,"en":"Akkula whom I am presenting,"},{"id":"manas-2010:p0584:b001:l036","ordinal":26337,"en":"It was a true wondrous steed."},{"id":"manas-2010:p0584:b001:l037","ordinal":26338,"en":"Youngest of six lions,"},{"id":"manas-2010:p0584:b001:l038","ordinal":26339,"en":"God's beloved servant,"},{"id":"manas-2010:p0584:b001:l039","ordinal":26340,"en":"Magnanimous Manas, for you,"},{"id":"manas-2010:p0584:b001:l040","ordinal":26341,"en":"It was a fitting horse.”"},{"id":"manas-2010:p0584:b001:l041","ordinal":26342,"en":"His collar gold, his sleeves bronze,"},{"id":"manas-2010:p0584:b001:l042","ordinal":26343,"en":"That worthy Karacha,"},{"id":"manas-2010:p0585:b001:l001","ordinal":26344,"en":"Leading Akkula,"},{"id":"manas-2010:p0585:b001:l002","ordinal":26345,"en":"Came to meet you alone."},{"id":"manas-2010:p0585:b001:l003","ordinal":26346,"en":"“Let me tell of Akkula."},{"id":"manas-2010:p0585:b001:l004","ordinal":26347,"en":"No ordinary tail and mane,"},{"id":"manas-2010:p0585:b001:l005","ordinal":26348,"en":"Akkula enters his fifth year this year;"},{"id":"manas-2010:p0585:b001:l006","ordinal":26349,"en":"He was no ordinarily born horse."},{"id":"manas-2010:p0585:b001:l007","ordinal":26350,"en":"Hearing battle cries, he does not panic;"},{"id":"manas-2010:p0585:b001:l008","ordinal":26351,"en":"In the darkness of the moon,"},{"id":"manas-2010:p0585:b001:l009","ordinal":26352,"en":"He never misplaces a single step."},{"id":"manas-2010:p0585:b001:l010","ordinal":26353,"en":"If uproar comes that numbs the head,"},{"id":"manas-2010:p0585:b001:l011","ordinal":26354,"en":"If tumult comes that deafens ears,"},{"id":"manas-2010:p0585:b001:l012","ordinal":26355,"en":"He does not grow wild and strain his lead rope."},{"id":"manas-2010:p0585:b001:l013","ordinal":26356,"en":"If you think of a perfect courser,"},{"id":"manas-2010:p0585:b001:l014","ordinal":26357,"en":"The foal of a young mare,"},{"id":"manas-2010:p0585:b001:l015","ordinal":26358,"en":"He is the Duldul of ordinary horses."},{"id":"manas-2010:p0585:b001:l016","ordinal":26359,"en":"The mightiest of horsehair tails,"},{"id":"manas-2010:p0585:b001:l017","ordinal":26360,"en":"He is the foal of Zhelkayyp himself."},{"id":"manas-2010:p0585:b001:l018","ordinal":26361,"en":"Ride him to Zhet-Kayt: he will not tire."},{"id":"manas-2010:p0585:b001:l019","ordinal":26362,"en":"Until his seventieth year of maturity,"},{"id":"manas-2010:p0585:b001:l020","ordinal":26363,"en":"He will not grow old, his teeth worn down."},{"id":"manas-2010:p0585:b001:l021","ordinal":26364,"en":"Encountered from the unseen,"},{"id":"manas-2010:p0585:b001:l022","ordinal":26365,"en":"Found upon the empty steppe,"},{"id":"manas-2010:p0585:b001:l023","ordinal":26366,"en":"His dam was a spirit-creature"},{"id":"manas-2010:p0585:b001:l024","ordinal":26367,"en":"Who raced with wild asses."},{"id":"manas-2010:p0585:b001:l025","ordinal":26368,"en":"Born in the desert, raised among rocks,"}]
