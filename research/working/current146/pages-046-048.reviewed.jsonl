{"id": "sayakbay-ms-current146:pdf048:l019", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 48, "folio": 431, "line_in_page": 19, "raw": "Кылык менен жоругун,", "text": "Кылык менен жоругун,", "en": "His conduct and his ways,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The line appears nominal and may continue into the next.", "bbox": null}
