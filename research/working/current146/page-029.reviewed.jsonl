{"id": "sayakbay-ms-current146:pdf029:l029", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 29, "folio": 412, "line_in_page": 29, "raw": "Адам чыдап барбаган,", "text": "Адам чыдап барбаган,", "en": "No man could endure approaching him,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
