[{"id":"semetey-1-2013:p0097:b005:l032","ordinal":84225,"en":"That poor man, shaken to the core,"},{"id":"semetey-1-2013:p0097:b005:l033","ordinal":84226,"en":"Never ceasing his prayer of repentance,"},{"id":"semetey-1-2013:p0097:b005:l034","ordinal":84227,"en":"Unable to stand still, took the direct way."},{"id":"semetey-1-2013:p0097:b005:l035","ordinal":84228,"en":"Without pausing, Khan Bakai,"},{"id":"semetey-1-2013:p0097:b005:l036","ordinal":84229,"en":"Having seated them upon the gray steed,"},{"id":"semetey-1-2013:p0097:b005:l037","ordinal":84230,"en":"Led the two ladies,"},{"id":"semetey-1-2013:p0097:b005:l038","ordinal":84231,"en":"Praying to his saints,"},{"id":"semetey-1-2013:p0097:b005:l039","ordinal":84232,"en":"To cross the Syr Darya,"},{"id":"semetey-1-2013:p0098:b003:l001","ordinal":84233,"en":"Leopard Bakai made ready."},{"id":"semetey-1-2013:p0098:b003:l002","ordinal":84234,"en":"Taking the gun Kok Chybyk in hand,"},{"id":"semetey-1-2013:p0098:b003:l003","ordinal":84235,"en":"He cried, “Manas! Manas!”"},{"id":"semetey-1-2013:p0098:b003:l004","ordinal":84236,"en":"“God, set this undertaking right;"},{"id":"semetey-1-2013:p0098:b003:l005","ordinal":84237,"en":"Protect my orphan!” he said."},{"id":"semetey-1-2013:p0098:b003:l006","ordinal":84238,"en":"Coughing with fierce resolve,"},{"id":"semetey-1-2013:p0098:b003:l007","ordinal":84239,"en":"Your uncle, blessed with sacred power,"},{"id":"semetey-1-2013:p0098:b003:l008","ordinal":84240,"en":"Raised the gun Kok Chybyk"},{"id":"semetey-1-2013:p0098:b003:l009","ordinal":84241,"en":"And stretched it toward the water, standing broad."},{"id":"semetey-1-2013:p0098:b003:l010","ordinal":84242,"en":"Your uncle Bakai, Kojosan,"},{"id":"semetey-1-2013:p0098:b003:l011","ordinal":84243,"en":"Stood large before the water."},{"id":"semetey-1-2013:p0098:b003:l012","ordinal":84244,"en":"With Chinese fire steel and flint"},{"id":"semetey-1-2013:p0098:b003:l013","ordinal":84245,"en":"He struck and set an ember."},{"id":"semetey-1-2013:p0098:b003:l014","ordinal":84246,"en":"Kok Chybyk in his hands,"},{"id":"semetey-1-2013:p0098:b003:l015","ordinal":84247,"en":"Unerring in its marksmanship,"},{"id":"semetey-1-2013:p0098:b003:l016","ordinal":84248,"en":"Its trigger ready—"},{"id":"semetey-1-2013:p0098:b003:l017","ordinal":84249,"en":"Into the roaring river"},{"id":"semetey-1-2013:p0098:b003:l018","ordinal":84250,"en":"Then Bakai the leopard"},{"id":"semetey-1-2013:p0098:b003:l019","ordinal":84251,"en":"Let off one booming shot."},{"id":"semetey-1-2013:p0098:b003:l020","ordinal":84252,"en":"If you looked upstream,"},{"id":"semetey-1-2013:p0098:b003:l021","ordinal":84253,"en":"The river had stopped flowing."},{"id":"semetey-1-2013:p0098:b003:l022","ordinal":84254,"en":"If you looked downstream,"},{"id":"semetey-1-2013:p0098:b003:l023","ordinal":84255,"en":"The water vanished and the bed appeared."},{"id":"semetey-1-2013:p0098:b003:l024","ordinal":84256,"en":"Then Bakai the leopard"},{"id":"semetey-1-2013:p0098:b003:l025","ordinal":84257,"en":"Stepped briskly, hurrying along,"},{"id":"semetey-1-2013:p0098:b003:l026","ordinal":84258,"en":"Pleading with his orphan"},{"id":"semetey-1-2013:p0098:b003:l027","ordinal":84259,"en":"Semetey upon his neck:"},{"id":"semetey-1-2013:p0098:b003:l028","ordinal":84260,"en":"“He is one who takes after his father."},{"id":"semetey-1-2013:p0098:b003:l029","ordinal":84261,"en":"When I see the protection he receives,"},{"id":"semetey-1-2013:p0098:b003:l030","ordinal":84262,"en":"He is his father's equal."},{"id":"semetey-1-2013:p0098:b003:l031","ordinal":84263,"en":"His right shoulder will grow broad."},{"id":"semetey-1-2013:p0098:b003:l032","ordinal":84264,"en":"If my orphan lives,"},{"id":"semetey-1-2013:p0098:b003:l033","ordinal":84265,"en":"He will be a lion like his father."},{"id":"semetey-1-2013:p0098:b003:l034","ordinal":84266,"en":"When his wrath is roused,"},{"id":"semetey-1-2013:p0098:b003:l035","ordinal":84267,"en":"He will set grassy lands afire."},{"id":"semetey-1-2013:p0098:b003:l036","ordinal":84268,"en":"If he lives and grows,"},{"id":"semetey-1-2013:p0098:b003:l037","ordinal":84269,"en":"He will kindle the meadows,"},{"id":"semetey-1-2013:p0098:b003:l038","ordinal":84270,"en":"Pour blood into clear water,"},{"id":"semetey-1-2013:p0098:b003:l039","ordinal":84271,"en":"Be fortunate in every way,"},{"id":"semetey-1-2013:p0098:b004:l001","ordinal":84272,"en":"And become a hero like his father!”"},{"id":"semetey-1-2013:p0098:b004:l002","ordinal":84273,"en":"That the water had stopped,"},{"id":"semetey-1-2013:p0098:b004:l003","ordinal":84274,"en":"Mighty Bakai read as an omen."},{"id":"semetey-1-2013:p0098:b004:l004","ordinal":84275,"en":"He offered a prayer to Baabedin,"},{"id":"semetey-1-2013:p0098:b004:l005","ordinal":84276,"en":"Pledged a sheep to Koroshon,"},{"id":"semetey-1-2013:p0098:b004:l006","ordinal":84277,"en":"And to merry-hearted Manas's spirit"},{"id":"semetey-1-2013:p0098:b004:l007","ordinal":84278,"en":"Pledged a horse with a moon-marked hoof."},{"id":"semetey-1-2013:p0098:b004:l008","ordinal":84279,"en":"Shouting, “Baabedin!”"},{"id":"semetey-1-2013:p0098:b004:l009","ordinal":84280,"en":"The outstanding hero Bakai"},{"id":"semetey-1-2013:p0098:b004:l010","ordinal":84281,"en":"Raised the battle cry, “Manas!”"},{"id":"semetey-1-2013:p0098:b004:l011","ordinal":84282,"en":"Taking strength from the child,"},{"id":"semetey-1-2013:p0098:b004:l012","ordinal":84283,"en":"His thoughts filled with joy,"},{"id":"semetey-1-2013:p0098:b004:l013","ordinal":84284,"en":"To the bluff upon the far side"},{"id":"semetey-1-2013:p0098:b004:l014","ordinal":84285,"en":"Lion Bakai had reached."},{"id":"semetey-1-2013:p0098:b004:l015","ordinal":84286,"en":"When he looked behind,"},{"id":"semetey-1-2013:p0098:b004:l016","ordinal":84287,"en":"The flowing river,"},{"id":"semetey-1-2013:p0098:b004:l017","ordinal":84288,"en":"With the earth shaking and rumbling,"},{"id":"semetey-1-2013:p0098:b004:l018","ordinal":84289,"en":"Rushed on with a roar."},{"id":"semetey-1-2013:p0098:b004:l019","ordinal":84290,"en":"Pines fell, willows floated,"},{"id":"semetey-1-2013:p0098:b004:l020","ordinal":84291,"en":"Every snagged branch swept away."},{"id":"semetey-1-2013:p0098:b004:l021","ordinal":84292,"en":"White foam as large as houses"},{"id":"semetey-1-2013:p0098:b004:l022","ordinal":84293,"en":"Shone upon the surface."},{"id":"semetey-1-2013:p0098:b004:l023","ordinal":84294,"en":"Dark stones upon the riverbed"},{"id":"semetey-1-2013:p0098:b004:l024","ordinal":84295,"en":"Clattered along its bottom."},{"id":"semetey-1-2013:p0098:b004:l025","ordinal":84296,"en":"All the spruces"},{"id":"semetey-1-2013:p0098:b004:l026","ordinal":84297,"en":"Were torn out by their roots."},{"id":"semetey-1-2013:p0098:b004:l027","ordinal":84298,"en":"The river that had stopped"},{"id":"semetey-1-2013:p0098:b004:l028","ordinal":84299,"en":"Crashed into its forest."},{"id":"semetey-1-2013:p0098:b004:l029","ordinal":84300,"en":"He emerged safely from the river,"},{"id":"semetey-1-2013:p0098:b004:l030","ordinal":84301,"en":"Your lion, Bakai the leopard."},{"id":"semetey-1-2013:p0098:b004:l031","ordinal":84302,"en":"While his precious one lived,"},{"id":"semetey-1-2013:p0098:b004:l032","ordinal":84303,"en":"Loading ammunition upon elephants,"},{"id":"semetey-1-2013:p0098:b004:l033","ordinal":84304,"en":"Overwhelming every enemy he met,"},{"id":"semetey-1-2013:p0098:b004:l034","ordinal":84305,"en":"The saint had grown accustomed to it."},{"id":"semetey-1-2013:p0098:b004:l035","ordinal":84306,"en":"When people split into seven factions,"},{"id":"semetey-1-2013:p0098:b004:l036","ordinal":84307,"en":"When full discord arose,"},{"id":"semetey-1-2013:p0098:b004:l037","ordinal":84308,"en":"He knew their circumstances too."},{"id":"semetey-1-2013:p0098:b004:l038","ordinal":84309,"en":"Not a crow to caw,"},{"id":"semetey-1-2013:p0098:b004:l039","ordinal":84310,"en":"Not a raven to croak,"},{"id":"semetey-1-2013:p0099:b003:l001","ordinal":84311,"en":"He knew the nature of such places too."},{"id":"semetey-1-2013:p0099:b003:l002","ordinal":84312,"en":"Ranging across the whole world,"},{"id":"semetey-1-2013:p0099:b003:l003","ordinal":84313,"en":"While precious Manas lived,"},{"id":"semetey-1-2013:p0099:b003:l004","ordinal":84314,"en":"Exercising a governor's authority,"},{"id":"semetey-1-2013:p0099:b003:l005","ordinal":84315,"en":"All the world,"},{"id":"semetey-1-2013:p0099:b003:l006","ordinal":84316,"en":"Shattering it in earnest,"},{"id":"semetey-1-2013:p0099:b003:l007","ordinal":84317,"en":"Was it not Bakai who knew it?"},{"id":"semetey-1-2013:p0099:b003:l008","ordinal":84318,"en":"The four corners of the globe,"},{"id":"semetey-1-2013:p0099:b003:l009","ordinal":84319,"en":"While his lord lived,"},{"id":"semetey-1-2013:p0099:b003:l010","ordinal":84320,"en":"Travelling all around,"},{"id":"semetey-1-2013:p0099:b003:l011","ordinal":84321,"en":"Was it not Bakai who had seen them?"},{"id":"semetey-1-2013:p0099:b003:l012","ordinal":84322,"en":"Crushing those who faced him,"},{"id":"semetey-1-2013:p0099:b003:l013","ordinal":84323,"en":"Was it not Bakai who conquered?"},{"id":"semetey-1-2013:p0099:b003:l014","ordinal":84324,"en":"The four corners of the globe,"},{"id":"semetey-1-2013:p0099:b003:l015","ordinal":84325,"en":"Was it not Bakai who surveyed them?"},{"id":"semetey-1-2013:p0099:b003:l016","ordinal":84326,"en":"The mountains upon the earth,"},{"id":"semetey-1-2013:p0099:b003:l017","ordinal":84327,"en":"Was it not Bakai who knew them?"},{"id":"semetey-1-2013:p0099:b003:l018","ordinal":84328,"en":"Upon Kakanchy's golden throne,"},{"id":"semetey-1-2013:p0099:b003:l019","ordinal":84329,"en":"Was it not Bakai who sat?"},{"id":"semetey-1-2013:p0099:b003:l020","ordinal":84330,"en":"All the hollows of the land,"},{"id":"semetey-1-2013:p0099:b003:l021","ordinal":84331,"en":"While raising tumult on his journeys,"},{"id":"semetey-1-2013:p0099:b003:l022","ordinal":84332,"en":"Was it not Bakai who knew them?"},{"id":"semetey-1-2013:p0099:b003:l023","ordinal":84333,"en":"Taking elephants wherever he found them,"},{"id":"semetey-1-2013:p0099:b003:l024","ordinal":84334,"en":"Loading elephants with gold coins,"},{"id":"semetey-1-2013:p0099:b003:l025","ordinal":84335,"en":"Taking a thousand dark-eyed captives too,"},{"id":"semetey-1-2013:p0099:b003:l026","ordinal":84336,"en":"Was it not Bakai who travelled so?"},{"id":"semetey-1-2013:p0099:b003:l027","ordinal":84337,"en":"“Kara-Kyr's Kara-Ungkur"},{"id":"semetey-1-2013:p0099:b003:l028","ordinal":84338,"en":"Is a true cave of refuge for Muslims."},{"id":"semetey-1-2013:p0099:b003:l029","ordinal":84339,"en":"A place where the moon sets overhead,"},{"id":"semetey-1-2013:p0099:b003:l030","ordinal":84340,"en":"A place where a saint rested quietly."},{"id":"semetey-1-2013:p0099:b003:l031","ordinal":84341,"en":"It was a dusty ridge,"},{"id":"semetey-1-2013:p0099:b003:l032","ordinal":84342,"en":"The place where my saint rested."},{"id":"semetey-1-2013:p0099:b003:l033","ordinal":84343,"en":"When the poor and destitute fled,"},{"id":"semetey-1-2013:p0099:b003:l034","ordinal":84344,"en":"It was a place to give them aid."},{"id":"semetey-1-2013:p0099:b003:l035","ordinal":84345,"en":"Mist veiled its angular surroundings;"},{"id":"semetey-1-2013:p0099:b003:l036","ordinal":84346,"en":"Ground fog settled and swirled."},{"id":"semetey-1-2013:p0099:b003:l037","ordinal":84347,"en":"Human eyes were blinded."},{"id":"semetey-1-2013:p0099:b003:l038","ordinal":84348,"en":"No fox sniffed and barked upon its plain;"},{"id":"semetey-1-2013:p0099:b005:l001","ordinal":84349,"en":"No wolf or wild beast walked its lower slopes."},{"id":"semetey-1-2013:p0099:b005:l003","ordinal":84350,"en":"To a watchful person,"},{"id":"semetey-1-2013:p0099:b005:l004","ordinal":84351,"en":"Oh, Kanykei, my foal,"},{"id":"semetey-1-2013:p0099:b005:l005","ordinal":84352,"en":"It was a land of ridge upon ridge."},{"id":"semetey-1-2013:p0099:b005:l006","ordinal":84353,"en":"They said a saint slept in the cave"},{"id":"semetey-1-2013:p0099:b005:l007","ordinal":84354,"en":"And made it his abode."},{"id":"semetey-1-2013:p0099:b005:l008","ordinal":84355,"en":"That is the mist-covered ridge;"},{"id":"semetey-1-2013:p0099:b005:l009","ordinal":84356,"en":"That is where the sorrowful rested."},{"id":"semetey-1-2013:p0099:b005:l010","ordinal":84357,"en":"Its surroundings form a fortress;"},{"id":"semetey-1-2013:p0099:b005:l011","ordinal":84358,"en":"That is where I can hide my orphan."},{"id":"semetey-1-2013:p0099:b005:l013","ordinal":84359,"en":"Sleeping one's fill,"},{"id":"semetey-1-2013:p0099:b005:l014","ordinal":84360,"en":"Lying until one's hips ache,"},{"id":"semetey-1-2013:p0099:b005:l015","ordinal":84361,"en":"Taking a nap and sleeping enough,"},{"id":"semetey-1-2013:p0099:b005:l016","ordinal":84362,"en":"That place was truly"},{"id":"semetey-1-2013:p0099:b005:l017","ordinal":84363,"en":"A place for real repose."},{"id":"semetey-1-2013:p0099:b005:l018","ordinal":84364,"en":"When I brought humiliation upon Kokand,"},{"id":"semetey-1-2013:p0099:b005:l019","ordinal":84365,"en":"When I stormed Margilan,"},{"id":"semetey-1-2013:p0099:b005:l020","ordinal":84366,"en":"I was the one who slept there.”"},{"id":"semetey-1-2013:p0099:b005:l021","ordinal":84367,"en":"Saying this, mighty Bakai"},{"id":"semetey-1-2013:p0099:b005:l022","ordinal":84368,"en":"Hurried into the hills,"},{"id":"semetey-1-2013:p0099:b005:l023","ordinal":84369,"en":"His knees bending toward the earth,"},{"id":"semetey-1-2013:p0099:b005:l024","ordinal":84370,"en":"Along the winding water,"},{"id":"semetey-1-2013:p0099:b005:l025","ordinal":84371,"en":"Among the curving mountains,"},{"id":"semetey-1-2013:p0099:b005:l026","ordinal":84372,"en":"Through the twisting ravine."},{"id":"semetey-1-2013:p0099:b005:l027","ordinal":84373,"en":"Your noble hero, old Bakai,"},{"id":"semetey-1-2013:p0099:b005:l028","ordinal":84374,"en":"The saint who had seen so much,"},{"id":"semetey-1-2013:p0099:b005:l029","ordinal":84375,"en":"Thought, ‘The hills are dense, split a thousand ways;"},{"id":"semetey-1-2013:p0099:b005:l030","ordinal":84376,"en":"A person could scarcely fit within."},{"id":"semetey-1-2013:p0099:b005:l031","ordinal":84377,"en":"If they came behind to attack,"},{"id":"semetey-1-2013:p0099:b005:l032","ordinal":84378,"en":"The villains would not find us.’"},{"id":"semetey-1-2013:p0099:b005:l033","ordinal":84379,"en":"Across the dark, rounded-hill country"},{"id":"semetey-1-2013:p0099:b005:l034","ordinal":84380,"en":"Bakai came on foot."},{"id":"semetey-1-2013:p0099:b005:l035","ordinal":84381,"en":"Kara-Beles and Kangshaak-Tash"},{"id":"semetey-1-2013:p0099:b005:l036","ordinal":84382,"en":"Bakai crossed."},{"id":"semetey-1-2013:p0099:b005:l037","ordinal":84383,"en":"Kara-Kyr's Chong-Ungkur—"},{"id":"semetey-1-2013:p0099:b005:l038","ordinal":84384,"en":"He saw the great cave."},{"id":"semetey-1-2013:p0099:b005:l039","ordinal":84385,"en":"If you looked at its mouth,"},{"id":"semetey-1-2013:p0100:b003:l001","ordinal":84386,"en":"A single person could fit;"},{"id":"semetey-1-2013:p0100:b003:l002","ordinal":84387,"en":"But if you looked farther inside,"},{"id":"semetey-1-2013:p0100:b003:l003","ordinal":84388,"en":"Six thousand sheep could fit."},{"id":"semetey-1-2013:p0100:b003:l004","ordinal":84389,"en":"Plane trees and willows surrounded it."},{"id":"semetey-1-2013:p0100:b003:l005","ordinal":84390,"en":"Beneath the plane tree"},{"id":"semetey-1-2013:p0100:b003:l006","ordinal":84391,"en":"A black spring bubbled up."},{"id":"semetey-1-2013:p0100:b003:l007","ordinal":84392,"en":"Its cuckoo called in the mountains;"},{"id":"semetey-1-2013:p0100:b003:l008","ordinal":84393,"en":"All its nightingales"},{"id":"semetey-1-2013:p0100:b003:l009","ordinal":84394,"en":"Sang and spoke in the willows."},{"id":"semetey-1-2013:p0100:b003:l010","ordinal":84395,"en":"Dawn broke to the nightingale's song."},{"id":"semetey-1-2013:p0100:b003:l011","ordinal":84396,"en":"Their champion Bakai beside them,"},{"id":"semetey-1-2013:p0100:b003:l012","ordinal":84397,"en":"The two ladies lay weeping."},{"id":"semetey-1-2013:p0100:b003:l013","ordinal":84398,"en":"While the two ladies wept,"},{"id":"semetey-1-2013:p0100:b003:l014","ordinal":84399,"en":"“Hey, Kanykei, my foal,"},{"id":"semetey-1-2013:p0100:b003:l015","ordinal":84400,"en":"We have reached the cave; do not cry."},{"id":"semetey-1-2013:p0100:b003:l016","ordinal":84401,"en":"Do not torment yourself for nothing!"},{"id":"semetey-1-2013:p0100:b003:l017","ordinal":84402,"en":"It would be disgrace to lose him."},{"id":"semetey-1-2013:p0100:b003:l018","ordinal":84403,"en":"Worry for me six days;"},{"id":"semetey-1-2013:p0100:b003:l019","ordinal":84404,"en":"I entrust my orphan to you!”"},{"id":"semetey-1-2013:p0100:b003:l020","ordinal":84405,"en":"The two ladies entered the cave."},{"id":"semetey-1-2013:p0100:b003:l021","ordinal":84406,"en":"Their ribs seemed torn apart,"},{"id":"semetey-1-2013:p0100:b003:l022","ordinal":84407,"en":"Their precious eyes like currants,"},{"id":"semetey-1-2013:p0100:b003:l023","ordinal":84408,"en":"With Semetey between them,"},{"id":"semetey-1-2013:p0100:b003:l024","ordinal":84409,"en":"The two ladies brooded and wept,"},{"id":"semetey-1-2013:p0100:b003:l025","ordinal":84410,"en":"Their tears pouring down."},{"id":"semetey-1-2013:p0100:b003:l026","ordinal":84411,"en":"Then Bakai thought,"},{"id":"semetey-1-2013:p0100:b003:l027","ordinal":84412,"en":"“My mother has come exhausted,"},{"id":"semetey-1-2013:p0100:b003:l028","ordinal":84413,"en":"Kanykei has come weary;"},{"id":"semetey-1-2013:p0100:b003:l029","ordinal":84414,"en":"The jagged stones of Kara-Ungkur"},{"id":"semetey-1-2013:p0100:b003:l030","ordinal":84415,"en":"Will pierce their hips.”"},{"id":"semetey-1-2013:p0100:b003:l031","ordinal":84416,"en":"Resourceful old Bakai,"},{"id":"semetey-1-2013:p0100:b003:l032","ordinal":84417,"en":"The saint who had seen so much,"},{"id":"semetey-1-2013:p0100:b003:l033","ordinal":84418,"en":"The fescue on the yellow slope"},{"id":"semetey-1-2013:p0100:b003:l034","ordinal":84419,"en":"He uprooted by the roots."},{"id":"semetey-1-2013:p0100:b003:l035","ordinal":84420,"en":"A little shelter's worth of fescue"},{"id":"semetey-1-2013:p0100:b003:l036","ordinal":84421,"en":"Your tiger Bakai uprooted"},{"id":"semetey-1-2013:p0100:b003:l037","ordinal":84422,"en":"And spread inside the cave."},{"id":"semetey-1-2013:p0100:b003:l038","ordinal":84423,"en":"The two ladies lay down."},{"id":"semetey-1-2013:p0100:b003:l039","ordinal":84424,"en":"Leaning upon their elbows, they slept,"},{"id":"semetey-1-2013:p0100:b004:l001","ordinal":84425,"en":"Napping and taking their rest,"},{"id":"semetey-1-2013:p0100:b004:l002","ordinal":84426,"en":"Their eyes closing in sleep."},{"id":"semetey-1-2013:p0100:b004:l003","ordinal":84427,"en":"Your sultan, Lion Bakai,"},{"id":"semetey-1-2013:p0100:b004:l004","ordinal":84428,"en":"Spurred along on the gray steed;"},{"id":"semetey-1-2013:p0100:b004:l005","ordinal":84429,"en":"Bakai searched the hills."},{"id":"semetey-1-2013:p0100:b004:l006","ordinal":84430,"en":"A consummate hunter, greatly skilled,"},{"id":"semetey-1-2013:p0100:b004:l007","ordinal":84431,"en":"Mighty Bakai, the peerless hunter,"},{"id":"semetey-1-2013:p0100:b004:l008","ordinal":84432,"en":"For his orphan and the widow"},{"id":"semetey-1-2013:p0100:b004:l009","ordinal":84433,"en":"Now sought provisions."},{"id":"semetey-1-2013:p0100:b004:l010","ordinal":84434,"en":"In the blinking of an eye,"},{"id":"semetey-1-2013:p0100:b004:l011","ordinal":84435,"en":"Before a word could be said,"},{"id":"semetey-1-2013:p0100:b004:l012","ordinal":84436,"en":"Fortunate Bakai the leopard"},{"id":"semetey-1-2013:p0100:b004:l013","ordinal":84437,"en":"Shot six wild ewes and four wild rams;"},{"id":"semetey-1-2013:p0100:b004:l014","ordinal":84438,"en":"Bakai loaded them up"},{"id":"semetey-1-2013:p0100:b004:l015","ordinal":84439,"en":"And returned in an instant."},{"id":"semetey-1-2013:p0100:b004:l016","ordinal":84440,"en":"Bringing them to the cave, he unloaded them."},{"id":"semetey-1-2013:p0100:b004:l017","ordinal":84441,"en":"That Bakai the leopard,"},{"id":"semetey-1-2013:p0100:b004:l018","ordinal":84442,"en":"With Aktinte, bought for six calves"},{"id":"semetey-1-2013:p0100:b004:l019","ordinal":84443,"en":"And four yearling horses,"},{"id":"semetey-1-2013:p0100:b004:l020","ordinal":84444,"en":"Slit this way and that."},{"id":"semetey-1-2013:p0100:b004:l021","ordinal":84445,"en":"The ladies who had come in anguish"},{"id":"semetey-1-2013:p0100:b004:l022","ordinal":84446,"en":"Saw it plainly,"},{"id":"semetey-1-2013:p0100:b004:l023","ordinal":84447,"en":"Tugging at his leg in distress,"},{"id":"semetey-1-2013:p0100:b004:l024","ordinal":84448,"en":"Pleading with their uncle who had hunted,"},{"id":"semetey-1-2013:p0100:b004:l025","ordinal":84449,"en":"With Khan Bakai."},{"id":"semetey-1-2013:p0100:b004:l026","ordinal":84450,"en":"Knowing their hunger,"},{"id":"semetey-1-2013:p0100:b004:l027","ordinal":84451,"en":"Precious old Bakai"},{"id":"semetey-1-2013:p0100:b004:l028","ordinal":84452,"en":"Cut up the joints without delay;"},{"id":"semetey-1-2013:p0100:b004:l029","ordinal":84453,"en":"Your resourceful uncle butchered the game."},{"id":"semetey-1-2013:p0100:b004:l030","ordinal":84454,"en":"The travel kettle from the saddle straps"},{"id":"semetey-1-2013:p0100:b004:l031","ordinal":84455,"en":"On a hearth of three stones"},{"id":"semetey-1-2013:p0100:b004:l032","ordinal":84456,"en":"Your sister-in-law Kanykei set."},{"id":"semetey-1-2013:p0100:b004:l033","ordinal":84457,"en":"Rump and sweet, fatty meat"},{"id":"semetey-1-2013:p0100:b004:l034","ordinal":84458,"en":"She put on to boil."},{"id":"semetey-1-2013:p0100:b004:l035","ordinal":84459,"en":"Your widows ate their fill."},{"id":"semetey-1-2013:p0100:b004:l036","ordinal":84460,"en":"The marrow from the bones"},{"id":"semetey-1-2013:p0100:b004:l037","ordinal":84461,"en":"He knocked out for sucking"},{"id":"semetey-1-2013:p0100:b004:l038","ordinal":84462,"en":"And gave to Semetey."},{"id":"semetey-1-2013:p0100:b004:l039","ordinal":84463,"en":"Rekindling their extinguished fire,"},{"id":"semetey-1-2013:p0101:b003:l001","ordinal":84464,"en":"Your ruler, old Bakai,"},{"id":"semetey-1-2013:p0101:b003:l002","ordinal":84465,"en":"Brought their dead souls back to life."},{"id":"semetey-1-2013:p0101:b003:l003","ordinal":84466,"en":"He gathered what was scattered,"},{"id":"semetey-1-2013:p0101:b003:l004","ordinal":84467,"en":"Joined what was broken."},{"id":"semetey-1-2013:p0101:b003:l005","ordinal":84468,"en":"Nourishing their wasted bodies,"},{"id":"semetey-1-2013:p0101:b003:l006","ordinal":84469,"en":"He filled their hungry bellies."},{"id":"semetey-1-2013:p0101:b003:l007","ordinal":84470,"en":"Your uncle, old Bakai,"},{"id":"semetey-1-2013:p0101:b003:l008","ordinal":84471,"en":"The saint who had seen everything,"},{"id":"semetey-1-2013:p0101:b003:l009","ordinal":84472,"en":"Dry meadowsweet and dry serviceberry,"},{"id":"semetey-1-2013:p0101:b003:l010","ordinal":84473,"en":"Firewood that gave no smoke,"},{"id":"semetey-1-2013:p0101:b003:l011","ordinal":84474,"en":"Uprooted whole."},{"id":"semetey-1-2013:p0101:b003:l012","ordinal":84475,"en":"Enough to last seven days,"},{"id":"semetey-1-2013:p0101:b003:l013","ordinal":84476,"en":"He prepared their firewood."},{"id":"semetey-1-2013:p0101:b003:l014","ordinal":84477,"en":"Enough for a generous month,"},{"id":"semetey-1-2013:p0101:b003:l015","ordinal":84478,"en":"He prepared their meat."},{"id":"semetey-1-2013:p0101:b003:l016","ordinal":84479,"en":"The lion turned his head;"},{"id":"semetey-1-2013:p0101:b003:l017","ordinal":84480,"en":"To unfortunate Kanykei"}]
