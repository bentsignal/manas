[{"id":"manas-2010:p1098:b001:l019","ordinal":47873,"en":"Is Mazhik, tending cattle."},{"id":"manas-2010:p1098:b001:l020","ordinal":47874,"en":"Heed my words and go to him;"},{"id":"manas-2010:p1098:b001:l021","ordinal":47875,"en":"Mazhik of the pure faith,"},{"id":"manas-2010:p1098:b001:l022","ordinal":47876,"en":"Bring him back as your companion."},{"id":"manas-2010:p1098:b001:l023","ordinal":47877,"en":"Your Mazhik, tending cattle,"},{"id":"manas-2010:p1098:b001:l024","ordinal":47878,"en":"Held under guard among the Chinese,"},{"id":"manas-2010:p1098:b001:l025","ordinal":47879,"en":"He is that unfortunate warrior."},{"id":"manas-2010:p1098:b001:l026","ordinal":47880,"en":"If you seek vengeance against Beijing,"},{"id":"manas-2010:p1098:b001:l027","ordinal":47881,"en":"He is the lion to take as companion."},{"id":"manas-2010:p1098:b001:l028","ordinal":47882,"en":"Pure in spirit from birth,"},{"id":"manas-2010:p1098:b001:l029","ordinal":47883,"en":"He belongs to the people of Islam.”"},{"id":"manas-2010:p1098:b001:l030","ordinal":47884,"en":"This account of Mazhik"},{"id":"manas-2010:p1098:b001:l031","ordinal":47885,"en":"I heard from my mother."},{"id":"manas-2010:p1098:b001:l032","ordinal":47886,"en":"Unable to endure my burning heart,"},{"id":"manas-2010:p1098:b001:l033","ordinal":47887,"en":"I went down the broad street."},{"id":"manas-2010:p1098:b001:l034","ordinal":47888,"en":"When I passed along the broad street,"},{"id":"manas-2010:p1098:b001:l035","ordinal":47889,"en":"All the cattle had stampeded,"},{"id":"manas-2010:p1098:b001:l036","ordinal":47890,"en":"Fled into the streams,"},{"id":"manas-2010:p1098:b001:l037","ordinal":47891,"en":"And taken shelter there."},{"id":"manas-2010:p1098:b001:l038","ordinal":47892,"en":"His blue-piebald horse saddle-sore,"},{"id":"manas-2010:p1098:b001:l039","ordinal":47893,"en":"My dear champion Mazhik,"},{"id":"manas-2010:p1098:b001:l040","ordinal":47894,"en":"Tending cattle among the Chinese,"},{"id":"manas-2010:p1098:b001:l041","ordinal":47895,"en":"Causing my heart deep pain,"},{"id":"manas-2010:p1098:b001:l042","ordinal":47896,"en":"With his Kalmyk saddle as a pillow,"},{"id":"manas-2010:p1099:b001:l001","ordinal":47897,"en":"Had fallen asleep."},{"id":"manas-2010:p1099:b001:l002","ordinal":47898,"en":"When I looked, it was Mazhik himself."},{"id":"manas-2010:p1099:b001:l003","ordinal":47899,"en":"He wore a greasy black coat."},{"id":"manas-2010:p1099:b001:l004","ordinal":47900,"en":"Your jovial Mazhik"},{"id":"manas-2010:p1099:b001:l005","ordinal":47901,"en":"Looked just like a Kalmyk."},{"id":"manas-2010:p1099:b001:l006","ordinal":47902,"en":"When I saw hero Mazhik,"},{"id":"manas-2010:p1099:b001:l007","ordinal":47903,"en":"“Would a Muslim be like this?"},{"id":"manas-2010:p1099:b001:l008","ordinal":47904,"en":"Would anyone rightly call this a Muslim?"},{"id":"manas-2010:p1099:b001:l009","ordinal":47905,"en":"Let me gouge out his eyes,"},{"id":"manas-2010:p1099:b001:l010","ordinal":47906,"en":"Make him a feast for vultures,"},{"id":"manas-2010:p1099:b001:l011","ordinal":47907,"en":"Black Kalmyk Mazhik,"},{"id":"manas-2010:p1099:b001:l012","ordinal":47908,"en":"Let me slaughter him here!”"},{"id":"manas-2010:p1099:b001:l013","ordinal":47909,"en":"My double-edged sword"},{"id":"manas-2010:p1099:b001:l014","ordinal":47910,"en":"I drew from its sheath."},{"id":"manas-2010:p1099:b001:l015","ordinal":47911,"en":"To cut off his head,"},{"id":"manas-2010:p1099:b001:l016","ordinal":47912,"en":"I approached Mazhik."},{"id":"manas-2010:p1099:b001:l017","ordinal":47913,"en":"Mazhik awoke from sleep,"},{"id":"manas-2010:p1099:b001:l018","ordinal":47914,"en":"Sprang up, turning about,"},{"id":"manas-2010:p1099:b001:l019","ordinal":47915,"en":"And poured out his greeting."},{"id":"manas-2010:p1099:b001:l020","ordinal":47916,"en":"When I heard Mazhik's greeting,"},{"id":"manas-2010:p1099:b001:l021","ordinal":47917,"en":"My bones melted utterly."},{"id":"manas-2010:p1099:b001:l022","ordinal":47918,"en":"Greeting me in his distress,"},{"id":"manas-2010:p1099:b001:l023","ordinal":47919,"en":"Mazhik then stood"},{"id":"manas-2010:p1099:b001:l024","ordinal":47920,"en":"Pleading with unfortunate me:"},{"id":"manas-2010:p1099:b001:l025","ordinal":47921,"en":"“Parted from the people of my home,"},{"id":"manas-2010:p1099:b001:l026","ordinal":47922,"en":"What am I, tending cattle?"},{"id":"manas-2010:p1099:b001:l027","ordinal":47923,"en":"You, pure in spirit from birth,"},{"id":"manas-2010:p1099:b001:l028","ordinal":47924,"en":"Me, unfortunate Mazhik,"},{"id":"manas-2010:p1099:b001:l029","ordinal":47925,"en":"What are you, giving me no thought?"},{"id":"manas-2010:p1099:b001:l030","ordinal":47926,"en":"What darkness, what a night!"},{"id":"manas-2010:p1099:b001:l031","ordinal":47927,"en":"Will a day come to reach the Muslims?"},{"id":"manas-2010:p1099:b001:l032","ordinal":47928,"en":"When I have reached the Muslims,"},{"id":"manas-2010:p1099:b001:l033","ordinal":47929,"en":"Will there be a day to die,"},{"id":"manas-2010:p1099:b001:l034","ordinal":47930,"en":"With them leaning together and wailing,"},{"id":"manas-2010:p1099:b001:l035","ordinal":47931,"en":"All of them Muslims,"},{"id":"manas-2010:p1099:b001:l036","ordinal":47932,"en":"A day when they will bury me?”"},{"id":"manas-2010:p1099:b001:l037","ordinal":47933,"en":"Hero, blue-maned Khan Manas,"},{"id":"manas-2010:p1099:b001:l038","ordinal":47934,"en":"When I heard Mazhik's words,"},{"id":"manas-2010:p1099:b001:l039","ordinal":47935,"en":"My world closed painfully about me."},{"id":"manas-2010:p1099:b001:l040","ordinal":47936,"en":"From among the cattle-herders,"},{"id":"manas-2010:p1099:b001:l041","ordinal":47937,"en":"Not hero Mazhik alone,"},{"id":"manas-2010:p1099:b001:l042","ordinal":47938,"en":"I gathered forty companions, leopard."},{"id":"manas-2010:p1100:b001:l001","ordinal":47939,"en":"Together with brave Mazhik,"},{"id":"manas-2010:p1100:b001:l002","ordinal":47940,"en":"Forty lions had come to me."},{"id":"manas-2010:p1100:b001:l003","ordinal":47941,"en":"When I had gathered forty companions,"},{"id":"manas-2010:p1100:b001:l004","ordinal":47942,"en":"I trained them all to full strength."},{"id":"manas-2010:p1100:b001:l005","ordinal":47943,"en":"To act against Kongurbay,"},{"id":"manas-2010:p1100:b001:l006","ordinal":47944,"en":"In earnest, my friend, I laid plans."},{"id":"manas-2010:p1100:b001:l007","ordinal":47945,"en":"“If I should clash with the Chinese,"},{"id":"manas-2010:p1100:b001:l008","ordinal":47946,"en":"If I should fight Kongurbay,"},{"id":"manas-2010:p1100:b001:l009","ordinal":47947,"en":"The forty companions who look to me"},{"id":"manas-2010:p1100:b001:l010","ordinal":47948,"en":"Have no horses to ride,"},{"id":"manas-2010:p1100:b001:l011","ordinal":47949,"en":"Have no coats to wear in battle."},{"id":"manas-2010:p1100:b001:l012","ordinal":47950,"en":"Will the Chinese seize my forty companions?"},{"id":"manas-2010:p1100:b001:l013","ordinal":47951,"en":"With no coats to wear,"},{"id":"manas-2010:p1100:b001:l014","ordinal":47952,"en":"Will they all be slaughtered?”"},{"id":"manas-2010:p1100:b001:l015","ordinal":47953,"en":"Thinking of this then,"},{"id":"manas-2010:p1100:b001:l016","ordinal":47954,"en":"I struck Sarala on the thigh."},{"id":"manas-2010:p1100:b001:l017","ordinal":47955,"en":"He was a mighty khan of the Chinese;"},{"id":"manas-2010:p1100:b001:l018","ordinal":47956,"en":"I went to General Ay."},{"id":"manas-2010:p1100:b001:l019","ordinal":47957,"en":"For the sake of my forty companions,"},{"id":"manas-2010:p1100:b001:l020","ordinal":47958,"en":"I shattered General Ay's forces."},{"id":"manas-2010:p1100:b001:l021","ordinal":47959,"en":"On the ridge of It-Ölbös,"},{"id":"manas-2010:p1100:b001:l022","ordinal":47960,"en":"I laid two thousand of his warriors low."},{"id":"manas-2010:p1100:b001:l023","ordinal":47961,"en":"I brought turmoil upon the Chinese."},{"id":"manas-2010:p1100:b001:l024","ordinal":47962,"en":"Then I drove away"},{"id":"manas-2010:p1100:b001:l025","ordinal":47963,"en":"Swift horses for my forty companions to ride."},{"id":"manas-2010:p1100:b001:l026","ordinal":47964,"en":"Some I mounted on"},{"id":"manas-2010:p1100:b001:l027","ordinal":47965,"en":"Karabayyr steeds of battle;"},{"id":"manas-2010:p1100:b001:l028","ordinal":47966,"en":"Some I mounted on"},{"id":"manas-2010:p1100:b001:l029","ordinal":47967,"en":"Horses with sieve-like lungs and copper wings."},{"id":"manas-2010:p1100:b001:l030","ordinal":47968,"en":"Some I mounted on"},{"id":"manas-2010:p1100:b001:l031","ordinal":47969,"en":"Mountain roes with wild rams' necks;"},{"id":"manas-2010:p1100:b001:l032","ordinal":47970,"en":"Some I mounted on"},{"id":"manas-2010:p1100:b001:l033","ordinal":47971,"en":"Horses with wild ewes' necks and copper forelegs."},{"id":"manas-2010:p1100:b001:l034","ordinal":47972,"en":"Some I mounted on"},{"id":"manas-2010:p1100:b001:l035","ordinal":47973,"en":"Horses with trap-like rumps and owls' feet;"},{"id":"manas-2010:p1100:b001:l036","ordinal":47974,"en":"Some I mounted on"},{"id":"manas-2010:p1100:b001:l037","ordinal":47975,"en":"Horses with bull-camel forelocks and sickle heads."},{"id":"manas-2010:p1100:b001:l038","ordinal":47976,"en":"Some I mounted on"},{"id":"manas-2010:p1100:b001:l039","ordinal":47977,"en":"Horses with wild asses' legs and camel-calves' eyes."},{"id":"manas-2010:p1100:b001:l040","ordinal":47978,"en":"For red spears and sharp steel,"},{"id":"manas-2010:p1100:b001:l041","ordinal":47979,"en":"I mounted them on steeds fitted for these."},{"id":"manas-2010:p1100:b001:l042","ordinal":47980,"en":"For forty days alike in battle,"},{"id":"manas-2010:p1101:b001:l001","ordinal":47981,"en":"Without gulping a drop of water,"},{"id":"manas-2010:p1101:b001:l002","ordinal":47982,"en":"I mounted them on steeds that could endure."},{"id":"manas-2010:p1101:b001:l003","ordinal":47983,"en":"Double mail, with lark-eye rings,"},{"id":"manas-2010:p1101:b001:l004","ordinal":47984,"en":"With collars of gold and sleeves of copper—"},{"id":"manas-2010:p1101:b001:l005","ordinal":47985,"en":"I clothed them in the finest coats."},{"id":"manas-2010:p1101:b001:l006","ordinal":47986,"en":"Never held back when swung,"},{"id":"manas-2010:p1101:b001:l007","ordinal":47987,"en":"Never turning back from a blow,"},{"id":"manas-2010:p1101:b001:l008","ordinal":47988,"en":"I placed hungry steel in their hands."},{"id":"manas-2010:p1101:b001:l009","ordinal":47989,"en":"Satisfying their desire when fired,"},{"id":"manas-2010:p1101:b001:l010","ordinal":47990,"en":"Its menace too great to withstand,"},{"id":"manas-2010:p1101:b001:l011","ordinal":47991,"en":"Sending many thousand enemies fleeing—"},{"id":"manas-2010:p1101:b001:l012","ordinal":47992,"en":"I slung such guns upon their backs."},{"id":"manas-2010:p1101:b001:l013","ordinal":47993,"en":"With points steeped in poison,"},{"id":"manas-2010:p1101:b001:l014","ordinal":47994,"en":"I placed spears in their hands."},{"id":"manas-2010:p1101:b001:l015","ordinal":47995,"en":"I thought that I would die"},{"id":"manas-2010:p1101:b001:l016","ordinal":47996,"en":"For the sake of my forty companions."},{"id":"manas-2010:p1101:b001:l017","ordinal":47997,"en":"I meant to strike"},{"id":"manas-2010:p1101:b001:l018","ordinal":47998,"en":"The arrogant Chinese,"},{"id":"manas-2010:p1101:b001:l019","ordinal":47999,"en":"Their vast and countless host."},{"id":"manas-2010:p1101:b001:l020","ordinal":48000,"en":"I turned Sarala's head."},{"id":"manas-2010:p1101:b001:l021","ordinal":48001,"en":"Karykan's weather-stone,"},{"id":"manas-2010:p1101:b001:l022","ordinal":48002,"en":"A bowl of plain water—"},{"id":"manas-2010:p1101:b001:l023","ordinal":48003,"en":"I struck it with a breath-blown charm."},{"id":"manas-2010:p1101:b001:l024","ordinal":48004,"en":"Beating the surface of the earth,"},{"id":"manas-2010:p1101:b001:l025","ordinal":48005,"en":"Striking my stirrup,"},{"id":"manas-2010:p1101:b001:l026","ordinal":48006,"en":"Calling three times, blowing three times,"},{"id":"manas-2010:p1101:b001:l027","ordinal":48007,"en":"Whistling three times,"},{"id":"manas-2010:p1101:b001:l028","ordinal":48008,"en":"When I drew my brows together,"},{"id":"manas-2010:p1101:b001:l029","ordinal":48009,"en":"Clouds lashed down from the sky,"},{"id":"manas-2010:p1101:b001:l030","ordinal":48010,"en":"Enclosing the face of the earth."},{"id":"manas-2010:p1101:b001:l031","ordinal":48011,"en":"Clouds smothered all from above."},{"id":"manas-2010:p1101:b001:l032","ordinal":48012,"en":"Caught up in the rain,"},{"id":"manas-2010:p1101:b001:l033","ordinal":48013,"en":"Up into the sky flew"},{"id":"manas-2010:p1101:b001:l034","ordinal":48014,"en":"Many Chinese, shrieking."},{"id":"manas-2010:p1101:b001:l035","ordinal":48015,"en":"Pines fell and mountains flew;"},{"id":"manas-2010:p1101:b001:l036","ordinal":48016,"en":"When the fierce storm swept through,"},{"id":"manas-2010:p1101:b001:l037","ordinal":48017,"en":"Lofty towering cliffs flew away."},{"id":"manas-2010:p1101:b001:l038","ordinal":48018,"en":"Many Chinese raced toward home,"},{"id":"manas-2010:p1101:b001:l039","ordinal":48019,"en":"Running alongside their herds."},{"id":"manas-2010:p1101:b001:l040","ordinal":48020,"en":"Many Chinese kept dying,"},{"id":"manas-2010:p1101:b001:l041","ordinal":48021,"en":"Unable to reach their homes,"},{"id":"manas-2010:p1101:b001:l042","ordinal":48022,"en":"Clinging to the gates."},{"id":"manas-2010:p1102:b001:l001","ordinal":48023,"en":"Reciting spells, for the Chinese"},{"id":"manas-2010:p1102:b001:l002","ordinal":48024,"en":"I turned the summer day to winter."},{"id":"manas-2010:p1102:b001:l003","ordinal":48025,"en":"The thinly clad Chinese"},{"id":"manas-2010:p1102:b001:l004","ordinal":48026,"en":"I made shiver in the cold,"},{"id":"manas-2010:p1102:b001:l005","ordinal":48027,"en":"Made them whimper like girls."},{"id":"manas-2010:p1102:b001:l006","ordinal":48028,"en":"Cunningly working weather magic,"},{"id":"manas-2010:p1102:b001:l007","ordinal":48029,"en":"Day and night for thirty days,"},{"id":"manas-2010:p1102:b001:l008","ordinal":48030,"en":"The devastated Chinese—"},{"id":"manas-2010:p1102:b001:l009","ordinal":48031,"en":"Thus I slaughtered them."},{"id":"manas-2010:p1102:b001:l010","ordinal":48032,"en":"Upon those daughter-selling Chinese,"},{"id":"manas-2010:p1102:b001:l011","ordinal":48033,"en":"I brought a dreadful slaughter."},{"id":"manas-2010:p1102:b001:l012","ordinal":48034,"en":"Leading them before me,"},{"id":"manas-2010:p1102:b001:l013","ordinal":48035,"en":"Bringing my forty companions to strength,"},{"id":"manas-2010:p1102:b001:l014","ordinal":48036,"en":"I went to my mother."},{"id":"manas-2010:p1102:b001:l015","ordinal":48037,"en":"My mother stood there crying out;"},{"id":"manas-2010:p1102:b001:l016","ordinal":48038,"en":"The tears flowing from both eyes"},{"id":"manas-2010:p1102:b001:l017","ordinal":48039,"en":"Streamed down mingled with blood."},{"id":"manas-2010:p1102:b001:l018","ordinal":48040,"en":"“Do not begin a war with Beijing."},{"id":"manas-2010:p1102:b001:l019","ordinal":48041,"en":"If you fight against Beijing,"},{"id":"manas-2010:p1102:b001:l020","ordinal":48042,"en":"Do not leave your mother alive."},{"id":"manas-2010:p1102:b001:l021","ordinal":48043,"en":"Dig my grave wide before you go."},{"id":"manas-2010:p1102:b001:l022","ordinal":48044,"en":"Breathe once against my breast,"},{"id":"manas-2010:p1102:b001:l023","ordinal":48045,"en":"Cry out, ‘Mother!’ in lament,"},{"id":"manas-2010:p1102:b001:l024","ordinal":48046,"en":"And bury me with your own hands."},{"id":"manas-2010:p1102:b001:l025","ordinal":48047,"en":"If you flee to the Burut,"},{"id":"manas-2010:p1102:b001:l026","ordinal":48048,"en":"And I remain here plunged in trouble,"},{"id":"manas-2010:p1102:b001:l027","ordinal":48049,"en":"Will not the infidel Chinese"},{"id":"manas-2010:p1102:b001:l028","ordinal":48050,"en":"Gather together?"},{"id":"manas-2010:p1102:b001:l029","ordinal":48051,"en":"According to their own religion,"},{"id":"manas-2010:p1102:b001:l030","ordinal":48052,"en":"Will not the many Chinese put me in a chest?"},{"id":"manas-2010:p1102:b001:l031","ordinal":48053,"en":"Will they not hollow out a little niche,"},{"id":"manas-2010:p1102:b001:l032","ordinal":48054,"en":"Their monk babbling his prayers,"},{"id":"manas-2010:p1102:b001:l033","ordinal":48055,"en":"And bury me upright?"},{"id":"manas-2010:p1102:b001:l034","ordinal":48056,"en":"One day, after all, I shall die."},{"id":"manas-2010:p1102:b001:l035","ordinal":48057,"en":"Rising from the chest, bewildered,"},{"id":"manas-2010:p1102:b001:l036","ordinal":48058,"en":"When the questioners come,"},{"id":"manas-2010:p1102:b001:l037","ordinal":48059,"en":"In that black night,"},{"id":"manas-2010:p1102:b001:l038","ordinal":48060,"en":"What answer shall I give?”"},{"id":"manas-2010:p1102:b001:l039","ordinal":48061,"en":"When my mother spoke like this,"},{"id":"manas-2010:p1102:b001:l040","ordinal":48062,"en":"I loosened Sarala's reins."},{"id":"manas-2010:p1102:b001:l041","ordinal":48063,"en":"From the forest of the blue bend,"},{"id":"manas-2010:p1102:b001:l042","ordinal":48064,"en":"Sarala's mother,"},{"id":"manas-2010:p1103:b001:l001","ordinal":48065,"en":"A bay mare, I caught."},{"id":"manas-2010:p1103:b001:l002","ordinal":48066,"en":"On a swift horse like Sarala,"},{"id":"manas-2010:p1103:b001:l003","ordinal":48067,"en":"I pulled the rear girth tight,"},{"id":"manas-2010:p1103:b001:l004","ordinal":48068,"en":"Shortened the crupper,"},{"id":"manas-2010:p1103:b001:l005","ordinal":48069,"en":"Clothed her in a shot-proof coat,"},{"id":"manas-2010:p1103:b001:l006","ordinal":48070,"en":"And mounted her on the bay mare."},{"id":"manas-2010:p1103:b001:l007","ordinal":48071,"en":"The pure gold I had gathered,"},{"id":"manas-2010:p1103:b001:l008","ordinal":48072,"en":"I thought that I would scatter."},{"id":"manas-2010:p1103:b001:l009","ordinal":48073,"en":"Renouncing Beijing,"},{"id":"manas-2010:p1103:b001:l010","ordinal":48074,"en":"I thought that I would flee."},{"id":"manas-2010:p1103:b001:l011","ordinal":48075,"en":"When I said I would flee, she refused;"},{"id":"manas-2010:p1103:b001:l012","ordinal":48076,"en":"My mother stood in my way."},{"id":"manas-2010:p1103:b001:l013","ordinal":48077,"en":"“Go to your father Azizkan,” she said."},{"id":"manas-2010:p1103:b001:l014","ordinal":48078,"en":"“If he listens to you, bring your father"},{"id":"manas-2010:p1103:b001:l015","ordinal":48079,"en":"Into the Muslim faith,” she said."},{"id":"manas-2010:p1103:b001:l016","ordinal":48080,"en":"“If your father becomes a Muslim,"},{"id":"manas-2010:p1103:b001:l017","ordinal":48081,"en":"Gather holy men before you go."},{"id":"manas-2010:p1103:b001:l018","ordinal":48082,"en":"With your own hands, my foal,"},{"id":"manas-2010:p1103:b001:l019","ordinal":48083,"en":"Solemnize my marriage to your father."},{"id":"manas-2010:p1103:b001:l020","ordinal":48084,"en":"For now, my foal,"},{"id":"manas-2010:p1103:b001:l021","ordinal":48085,"en":"Do not start talking of flight."},{"id":"manas-2010:p1103:b001:l022","ordinal":48086,"en":"If you are going to flee, my foal,"},{"id":"manas-2010:p1103:b001:l023","ordinal":48087,"en":"Do not leave Aziz alive."},{"id":"manas-2010:p1103:b001:l024","ordinal":48088,"en":"If Azizkan listens to you,"},{"id":"manas-2010:p1103:b001:l025","ordinal":48089,"en":"Bring him here as your father."},{"id":"manas-2010:p1103:b001:l026","ordinal":48090,"en":"If your father will not listen,"},{"id":"manas-2010:p1103:b001:l027","ordinal":48091,"en":"Split him open upon his throne."},{"id":"manas-2010:p1103:b001:l028","ordinal":48092,"en":"If you should kill your father,"},{"id":"manas-2010:p1103:b001:l029","ordinal":48093,"en":"Cut off his head and tie it to you,"},{"id":"manas-2010:p1103:b001:l030","ordinal":48094,"en":"And come back here to me.”"},{"id":"manas-2010:p1103:b001:l031","ordinal":48095,"en":"When I heard these words,"},{"id":"manas-2010:p1103:b001:l032","ordinal":48096,"en":"My wretched soul seethed with fury."},{"id":"manas-2010:p1103:b001:l033","ordinal":48097,"en":"With both my eyes blazing,"},{"id":"manas-2010:p1103:b001:l034","ordinal":48098,"en":"Sarala beneath me"},{"id":"manas-2010:p1103:b001:l035","ordinal":48099,"en":"I handed over to brave Mazhik."},{"id":"manas-2010:p1103:b001:l036","ordinal":48100,"en":"I wrapped myself in a rich outer coat."},{"id":"manas-2010:p1103:b001:l037","ordinal":48101,"en":"Leaning on my battle-axe,"},{"id":"manas-2010:p1103:b001:l038","ordinal":48102,"en":"I ran into the palace,"},{"id":"manas-2010:p1103:b001:l039","ordinal":48103,"en":"Into its evenly planted garden;"},{"id":"manas-2010:p1103:b001:l040","ordinal":48104,"en":"I strode at a run"},{"id":"manas-2010:p1103:b001:l041","ordinal":48105,"en":"To my father's throne."},{"id":"manas-2010:p1103:b001:l042","ordinal":48106,"en":"My father Azizkan"},{"id":"manas-2010:p1104:b001:l001","ordinal":48107,"en":"Was a mighty khan of the Chinese."},{"id":"manas-2010:p1104:b001:l002","ordinal":48108,"en":"Surrounding my father"},{"id":"manas-2010:p1104:b001:l003","ordinal":48109,"en":"Were a thousand executioners."},{"id":"manas-2010:p1104:b001:l004","ordinal":48110,"en":"At that time Azizkan"},{"id":"manas-2010:p1104:b001:l005","ordinal":48111,"en":"Had already grown old."},{"id":"manas-2010:p1104:b001:l006","ordinal":48112,"en":"A child's affairs are a grievous burden;"},{"id":"manas-2010:p1104:b001:l007","ordinal":48113,"en":"What could my old father do?"},{"id":"manas-2010:p1104:b001:l008","ordinal":48114,"en":"He longed to see me once."},{"id":"manas-2010:p1104:b001:l009","ordinal":48115,"en":"When I came to his throne,"},{"id":"manas-2010:p1104:b001:l010","ordinal":48116,"en":"He left it, looming tall."},{"id":"manas-2010:p1104:b001:l011","ordinal":48117,"en":"“Almambet, my son, my camel-calf!”"},{"id":"manas-2010:p1104:b001:l012","ordinal":48118,"en":"He stood there pleading, arms outspread."},{"id":"manas-2010:p1104:b001:l013","ordinal":48119,"en":"Running his nails through my hair,"},{"id":"manas-2010:p1104:b001:l014","ordinal":48120,"en":"Stroking my forehead and eyebrows,"},{"id":"manas-2010:p1104:b001:l015","ordinal":48121,"en":"My father stood there pleading,"},{"id":"manas-2010:p1104:b001:l016","ordinal":48122,"en":"Stroking the top of my head."},{"id":"manas-2010:p1104:b001:l017","ordinal":48123,"en":"While my father stood like that,"},{"id":"manas-2010:p1104:b001:l018","ordinal":48124,"en":"The sacred word, the holy Quran,"},{"id":"manas-2010:p1104:b001:l019","ordinal":48125,"en":"I drew from inside my robe."},{"id":"manas-2010:p1104:b001:l020","ordinal":48126,"en":"Holding it, I spoke:"},{"id":"manas-2010:p1104:b001:l021","ordinal":48127,"en":"“I have found a book called the Quran."},{"id":"manas-2010:p1104:b001:l022","ordinal":48128,"en":"I have found the single name of God."}]
