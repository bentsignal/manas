[{"id":"manas-2010:p0842:b001:l006","ordinal":37121,"en":"In the great book Manas"},{"id":"manas-2010:p0842:b001:l007","ordinal":37122,"en":"Has his very name set down."},{"id":"manas-2010:p0842:b001:l008","ordinal":37123,"en":"Manas's name is plainly there:"},{"id":"manas-2010:p0842:b001:l009","ordinal":37124,"en":"'Manas shall rule Beijing,' it says."},{"id":"manas-2010:p0842:b001:l010","ordinal":37125,"en":"'The golden throne in Beijing—"},{"id":"manas-2010:p0842:b001:l011","ordinal":37126,"en":"I do not know how many there are—"},{"id":"manas-2010:p0842:b001:l012","ordinal":37127,"en":"Manas shall mount as khan,' it says."},{"id":"manas-2010:p0842:b001:l013","ordinal":37128,"en":"Can one survive a fight with him whom Khizir touched?"},{"id":"manas-2010:p0842:b001:l014","ordinal":37129,"en":"Against Manas with his forty spirit guardians,"},{"id":"manas-2010:p0842:b001:l015","ordinal":37130,"en":"Will any mortal dare advance?"},{"id":"manas-2010:p0842:b001:l016","ordinal":37131,"en":"Manas is no ordinary hero,"},{"id":"manas-2010:p0842:b001:l017","ordinal":37132,"en":"No lion a mortal can withstand."},{"id":"manas-2010:p0842:b001:l018","ordinal":37133,"en":"Understand what I have said;"},{"id":"manas-2010:p0842:b001:l019","ordinal":37134,"en":"Oh, Kongurbay, heed my words!"},{"id":"manas-2010:p0842:b001:l020","ordinal":37135,"en":"A man who listens will become a khan;"},{"id":"manas-2010:p0842:b001:l021","ordinal":37136,"en":"One who will not listen will become a beast."},{"id":"manas-2010:p0842:b001:l022","ordinal":37137,"en":"Those who say, 'I shall tread like a beast,'"},{"id":"manas-2010:p0842:b001:l023","ordinal":37138,"en":"In the end will become bread."},{"id":"manas-2010:p0842:b001:l024","ordinal":37139,"en":"Your calves have not yet filled out;"},{"id":"manas-2010:p0842:b001:l025","ordinal":37140,"en":"With dark, wolf-maned Manas"},{"id":"manas-2010:p0842:b001:l026","ordinal":37141,"en":"Your time to fight has not yet come."},{"id":"manas-2010:p0842:b001:l027","ordinal":37142,"en":"The appointed time is six years;"},{"id":"manas-2010:p0842:b001:l028","ordinal":37143,"en":"When six years have passed,"},{"id":"manas-2010:p0842:b001:l029","ordinal":37144,"en":"Braid your thoroughbred's mane."},{"id":"manas-2010:p0842:b001:l030","ordinal":37145,"en":"If you are to face Manas,"},{"id":"manas-2010:p0842:b001:l031","ordinal":37146,"en":"Meet him here in Beijing."},{"id":"manas-2010:p0842:b001:l032","ordinal":37147,"en":"Many troubles will arise;"},{"id":"manas-2010:p0842:b001:l033","ordinal":37148,"en":"If you seek a clash, Manas will be found.”"},{"id":"manas-2010:p0842:b001:l034","ordinal":37149,"en":"Karykan restrained the Kalcha"},{"id":"manas-2010:p0842:b001:l035","ordinal":37150,"en":"And gathered all his Torgoot."},{"id":"manas-2010:p0842:b001:l036","ordinal":37151,"en":"“He is an orphan whose father has died,” he said,"},{"id":"manas-2010:p0842:b001:l037","ordinal":37152,"en":"And that Kalcha Kongurbay"},{"id":"manas-2010:p0842:b001:l038","ordinal":37153,"en":"He made khan of the monks."},{"id":"manas-2010:p0842:b001:l039","ordinal":37154,"en":"“Be a wall set across the way;"},{"id":"manas-2010:p0842:b001:l040","ordinal":37155,"en":"Do not grieve for your dead father."},{"id":"manas-2010:p0842:b001:l041","ordinal":37156,"en":"Be a strong khan over the monks!"},{"id":"manas-2010:p0842:b001:l042","ordinal":37157,"en":"Let your fire burn for six years!”"},{"id":"manas-2010:p0843:b001:l001","ordinal":37158,"en":"Karykan rose and said this,"},{"id":"manas-2010:p0843:b001:l002","ordinal":37159,"en":"Held Kongurbay back,"},{"id":"manas-2010:p0843:b001:l003","ordinal":37160,"en":"And sent word to the governor, they say."},{"id":"manas-2010:p0843:b001:l004","ordinal":37161,"en":"Telling the news of Manas,"},{"id":"manas-2010:p0843:b001:l005","ordinal":37162,"en":"He restrained all his Torgoot, they say."},{"id":"manas-2010:p0843:b001:l006","ordinal":37163,"en":"Thus stood Kongurbay's affairs;"},{"id":"manas-2010:p0843:b001:l007","ordinal":37164,"en":"Such was the situation of Manas."},{"id":"manas-2010:p0843:b001:l008","ordinal":37165,"en":"Let us leave this as it is,"},{"id":"manas-2010:p0843:b001:l009","ordinal":37166,"en":"And of him who came from Altay and became a giant,"},{"id":"manas-2010:p0843:b001:l010","ordinal":37167,"en":"Who became lord of the Noygut people,"},{"id":"manas-2010:p0843:b001:l011","ordinal":37168,"en":"The blessed Khan Akbaltay—"},{"id":"manas-2010:p0843:b001:l012","ordinal":37169,"en":"Let us begin the tale of him."},{"id":"manas-2010:p0843:b003:l001","ordinal":37170,"en":"A just khan to his people,"},{"id":"manas-2010:p0843:b003:l002","ordinal":37171,"en":"Noble Baltay at that time"},{"id":"manas-2010:p0843:b003:l003","ordinal":37172,"en":"Was a blessed man."},{"id":"manas-2010:p0843:b003:l004","ordinal":37173,"en":"Akbaltay's confidant,"},{"id":"manas-2010:p0843:b003:l005","ordinal":37174,"en":"His companion into the next world,"},{"id":"manas-2010:p0843:b003:l006","ordinal":37175,"en":"Was the hero Kutubiy."},{"id":"manas-2010:p0843:b003:l007","ordinal":37176,"en":"He took Alay as his homeland,"},{"id":"manas-2010:p0843:b003:l008","ordinal":37177,"en":"Maintained the Noygut as his people;"},{"id":"manas-2010:p0843:b003:l009","ordinal":37178,"en":"His yaks numbered ninety thousand,"},{"id":"manas-2010:p0843:b003:l010","ordinal":37179,"en":"His wealth was renowned among the people;"},{"id":"manas-2010:p0843:b003:l011","ordinal":37180,"en":"His horses numbered seventy thousand."},{"id":"manas-2010:p0843:b003:l012","ordinal":37181,"en":"He was a fully accomplished, formidable khan;"},{"id":"manas-2010:p0843:b003:l013","ordinal":37182,"en":"His livestock countless, but he had no child."},{"id":"manas-2010:p0843:b003:l014","ordinal":37183,"en":"Akbaltay was wretched,"},{"id":"manas-2010:p0843:b003:l015","ordinal":37184,"en":"With no way to beget a child."},{"id":"manas-2010:p0843:b003:l016","ordinal":37185,"en":"To hear a single child's voice,"},{"id":"manas-2010:p0843:b003:l017","ordinal":37186,"en":"To attain that one desire,"},{"id":"manas-2010:p0843:b003:l018","ordinal":37187,"en":"All his countless livestock"},{"id":"manas-2010:p0843:b003:l019","ordinal":37188,"en":"He spent and squandered,"},{"id":"manas-2010:p0843:b003:l020","ordinal":37189,"en":"Begging God for a child;"},{"id":"manas-2010:p0843:b003:l021","ordinal":37190,"en":"Even then he had no child."},{"id":"manas-2010:p0843:b003:l022","ordinal":37191,"en":"Days and nights passed;"},{"id":"manas-2010:p0843:b003:l023","ordinal":37192,"en":"Many years passed between."},{"id":"manas-2010:p0844:b001:l001","ordinal":37193,"en":"Having no child, Akbaltay"},{"id":"manas-2010:p0844:b001:l002","ordinal":37194,"en":"Had become a wretched man."},{"id":"manas-2010:p0844:b001:l003","ordinal":37195,"en":"For the sake of a single child,"},{"id":"manas-2010:p0844:b001:l004","ordinal":37196,"en":"Begging God, Akbaltay"},{"id":"manas-2010:p0844:b001:l005","ordinal":37197,"en":"Took sixty wives."},{"id":"manas-2010:p0844:b001:l006","ordinal":37198,"en":"Not one of the sixty gave birth;"},{"id":"manas-2010:p0844:b001:l007","ordinal":37199,"en":"He remained without an heir."},{"id":"manas-2010:p0844:b001:l008","ordinal":37200,"en":"What divine power had ordained,"},{"id":"manas-2010:p0844:b001:l009","ordinal":37201,"en":"Wretched Baltay experienced."},{"id":"manas-2010:p0844:b001:l010","ordinal":37202,"en":"“These are livestock with no head to lead them;"},{"id":"manas-2010:p0844:b001:l011","ordinal":37203,"en":"What use is keeping them?” he said,"},{"id":"manas-2010:p0844:b001:l012","ordinal":37204,"en":"And set apart half his livestock."},{"id":"manas-2010:p0844:b001:l013","ordinal":37205,"en":"“What use are herds with no heir?” he said,"},{"id":"manas-2010:p0844:b001:l014","ordinal":37206,"en":"Suffering for want of a child."},{"id":"manas-2010:p0844:b001:l015","ordinal":37207,"en":"Half his livestock Akbaltay"},{"id":"manas-2010:p0844:b001:l016","ordinal":37208,"en":"Among orphans and widows"},{"id":"manas-2010:p0844:b001:l017","ordinal":37209,"en":"Distributed and gave away."},{"id":"manas-2010:p0844:b001:l018","ordinal":37210,"en":"Though he spent his abundant herds,"},{"id":"manas-2010:p0844:b001:l019","ordinal":37211,"en":"Though he slept at sacred shrines,"},{"id":"manas-2010:p0844:b001:l020","ordinal":37212,"en":"Though he begged God for a child,"},{"id":"manas-2010:p0844:b001:l021","ordinal":37213,"en":"Still he had no child."},{"id":"manas-2010:p0844:b001:l022","ordinal":37214,"en":"He scattered his abundant livestock"},{"id":"manas-2010:p0844:b001:l023","ordinal":37215,"en":"And was left full of regret."},{"id":"manas-2010:p0844:b001:l024","ordinal":37216,"en":"Calling his Kutubiy,"},{"id":"manas-2010:p0844:b001:l025","ordinal":37217,"en":"Akbaltay was stricken:"},{"id":"manas-2010:p0844:b001:l026","ordinal":37218,"en":"“Rather than languish like this,"},{"id":"manas-2010:p0844:b001:l027","ordinal":37219,"en":"I shall wander away to Mecca,”"},{"id":"manas-2010:p0844:b001:l028","ordinal":37220,"en":"Akbaltay declared."},{"id":"manas-2010:p0844:b001:l029","ordinal":37221,"en":"With sixty retainers, Kutubiy"},{"id":"manas-2010:p0844:b001:l030","ordinal":37222,"en":"To scout sixty hills"},{"id":"manas-2010:p0844:b001:l031","ordinal":37223,"en":"Had set out at that time"},{"id":"manas-2010:p0844:b001:l032","ordinal":37224,"en":"On a hunting expedition."},{"id":"manas-2010:p0844:b001:l033","ordinal":37225,"en":"When the people moved toward higher ground,"},{"id":"manas-2010:p0844:b001:l034","ordinal":37226,"en":"In early summer, when horses fill on green grass,"},{"id":"manas-2010:p0844:b001:l035","ordinal":37227,"en":"When he came out onto the ridge,"},{"id":"manas-2010:p0844:b001:l036","ordinal":37228,"en":"With many people as companions,"},{"id":"manas-2010:p0844:b001:l037","ordinal":37229,"en":"Akbaltay lamented:"},{"id":"manas-2010:p0844:b001:l038","ordinal":37230,"en":"Longing for a child to carry on his line,"},{"id":"manas-2010:p0844:b001:l039","ordinal":37231,"en":"His eyes had grown inflamed,"},{"id":"manas-2010:p0844:b001:l040","ordinal":37232,"en":"His chest had begun to rattle."},{"id":"manas-2010:p0844:b001:l041","ordinal":37233,"en":"Longing for a child, Akbaltay's"},{"id":"manas-2010:p0844:b001:l042","ordinal":37234,"en":"Beard had become white;"},{"id":"manas-2010:p0845:b001:l001","ordinal":37235,"en":"His time to die was drawing near."},{"id":"manas-2010:p0845:b001:l002","ordinal":37236,"en":"“I shall remain childless,” he said,"},{"id":"manas-2010:p0845:b001:l003","ordinal":37237,"en":"“When this wretched childless man dies,"},{"id":"manas-2010:p0845:b001:l004","ordinal":37238,"en":"Like wheat growing on dry ground,"},{"id":"manas-2010:p0845:b001:l005","ordinal":37239,"en":"I shall leave no offspring.”"},{"id":"manas-2010:p0845:b001:l006","ordinal":37240,"en":"Caring not a hair for his bare life,"},{"id":"manas-2010:p0845:b001:l007","ordinal":37241,"en":"Baltay suffered and languished."},{"id":"manas-2010:p0845:b001:l008","ordinal":37242,"en":"For the sake of a child, damn it,"},{"id":"manas-2010:p0845:b001:l009","ordinal":37243,"en":"Noble Baltay languished."},{"id":"manas-2010:p0845:b001:l010","ordinal":37244,"en":"Looming in mist at the corners,"},{"id":"manas-2010:p0845:b001:l011","ordinal":37245,"en":"Ending in haze at the edges,"},{"id":"manas-2010:p0845:b001:l012","ordinal":37246,"en":"On the face of the great plain,"},{"id":"manas-2010:p0845:b001:l013","ordinal":37247,"en":"Of the Mediyen desert,"},{"id":"manas-2010:p0845:b001:l014","ordinal":37248,"en":"At its nearer edge,"},{"id":"manas-2010:p0845:b001:l015","ordinal":37249,"en":"Folded into a saddlebag,"},{"id":"manas-2010:p0845:b001:l016","ordinal":37250,"en":"Loaded upon a pale she-camel,"},{"id":"manas-2010:p0845:b001:l017","ordinal":37251,"en":"Laid in white felt,"},{"id":"manas-2010:p0845:b001:l018","ordinal":37252,"en":"Tied upon the camel's hump,"},{"id":"manas-2010:p0845:b001:l019","ordinal":37253,"en":"God Most High had fittingly"},{"id":"manas-2010:p0845:b001:l020","ordinal":37254,"en":"Placed the child there at that time."},{"id":"manas-2010:p0845:b001:l021","ordinal":37255,"en":"Oysul Ata, with the pale she-camel,"},{"id":"manas-2010:p0845:b001:l022","ordinal":37256,"en":"Upon that she-camel's hump"},{"id":"manas-2010:p0845:b001:l023","ordinal":37257,"en":"Had tied him there at that time."},{"id":"manas-2010:p0845:b001:l024","ordinal":37258,"en":"Before Akbaltay,"},{"id":"manas-2010:p0845:b001:l025","ordinal":37259,"en":"Oysul Ata's pale she-camel—"},{"id":"manas-2010:p0845:b001:l026","ordinal":37260,"en":"An animal bred in Akbaltay's own herd—"},{"id":"manas-2010:p0845:b001:l027","ordinal":37261,"en":"Came straight toward him."},{"id":"manas-2010:p0845:b001:l028","ordinal":37262,"en":"When the she-camel approached,"},{"id":"manas-2010:p0845:b001:l029","ordinal":37263,"en":"From her very hump"},{"id":"manas-2010:p0845:b001:l030","ordinal":37264,"en":"Came crying: “Wah, wah, wah, wah!”"},{"id":"manas-2010:p0845:b001:l031","ordinal":37265,"en":"The child wailed and cried loudly;"},{"id":"manas-2010:p0845:b001:l032","ordinal":37266,"en":"As the child wailed and cried,"},{"id":"manas-2010:p0845:b001:l033","ordinal":37267,"en":"He cried piercing ears and nose."},{"id":"manas-2010:p0845:b001:l034","ordinal":37268,"en":"When he heard the child's voice,"},{"id":"manas-2010:p0845:b001:l035","ordinal":37269,"en":"What did poor Baltay do?"},{"id":"manas-2010:p0845:b001:l036","ordinal":37270,"en":"The grief in his breast was released,"},{"id":"manas-2010:p0845:b001:l037","ordinal":37271,"en":"Tears streamed from his eyes;"},{"id":"manas-2010:p0845:b001:l038","ordinal":37272,"en":"A child was found through unseen powers,"},{"id":"manas-2010:p0845:b001:l039","ordinal":37273,"en":"And sorrowful Baltay's"},{"id":"manas-2010:p0845:b001:l040","ordinal":37274,"en":"Honor was thus preserved."},{"id":"manas-2010:p0845:b001:l041","ordinal":37275,"en":"The child in the saddlebag"},{"id":"manas-2010:p0845:b001:l042","ordinal":37276,"en":"Wretched Baltay now took."},{"id":"manas-2010:p0846:b001:l001","ordinal":37277,"en":"Against the bare flesh of his body"},{"id":"manas-2010:p0846:b001:l002","ordinal":37278,"en":"He laid that child."},{"id":"manas-2010:p0846:b001:l003","ordinal":37279,"en":"A cry rang out before him;"},{"id":"manas-2010:p0846:b001:l004","ordinal":37280,"en":"That Baltay then"},{"id":"manas-2010:p0846:b001:l005","ordinal":37281,"en":"Called to Kutubiy:"},{"id":"manas-2010:p0846:b001:l006","ordinal":37282,"en":"“Oh, Kutubiy, my companion,"},{"id":"manas-2010:p0846:b001:l007","ordinal":37283,"en":"My confidant who shares even death!"},{"id":"manas-2010:p0846:b001:l008","ordinal":37284,"en":"My honor is now preserved,"},{"id":"manas-2010:p0846:b001:l009","ordinal":37285,"en":"What I sought has been found,"},{"id":"manas-2010:p0846:b001:l010","ordinal":37286,"en":"What was severed is joined,"},{"id":"manas-2010:p0846:b001:l011","ordinal":37287,"en":"What was scattered is gathered,"},{"id":"manas-2010:p0846:b001:l012","ordinal":37288,"en":"My extinguished fire is lit,"},{"id":"manas-2010:p0846:b001:l013","ordinal":37289,"en":"My dead soul has come alive."},{"id":"manas-2010:p0846:b001:l014","ordinal":37290,"en":"My dear Kutubiy,"},{"id":"manas-2010:p0846:b001:l015","ordinal":37291,"en":"I have a child—know this!"},{"id":"manas-2010:p0846:b001:l016","ordinal":37292,"en":"My Kutubiy, a reward for glad tidings!”"},{"id":"manas-2010:p0846:b001:l017","ordinal":37293,"en":"Thus spoke Akbaltay."},{"id":"manas-2010:p0846:b001:l018","ordinal":37294,"en":"His many thoughts overflowed his breast,"},{"id":"manas-2010:p0846:b001:l019","ordinal":37295,"en":"His tears streamed in ten directions;"},{"id":"manas-2010:p0846:b001:l020","ordinal":37296,"en":"His white beard was thinning,"},{"id":"manas-2010:p0846:b001:l021","ordinal":37297,"en":"And tears flowing from both eyes"},{"id":"manas-2010:p0846:b001:l022","ordinal":37298,"en":"Poured down past his collarbones."},{"id":"manas-2010:p0846:b001:l023","ordinal":37299,"en":"When he saw Khan Baltay,"},{"id":"manas-2010:p0846:b001:l024","ordinal":37300,"en":"Kutu too wept at the sight."},{"id":"manas-2010:p0846:b001:l025","ordinal":37301,"en":"Seeing the aged old man,"},{"id":"manas-2010:p0846:b001:l026","ordinal":37302,"en":"Everyone who looked on wept."},{"id":"manas-2010:p0846:b001:l027","ordinal":37303,"en":"Then Akbaltay"},{"id":"manas-2010:p0846:b001:l028","ordinal":37304,"en":"Said to all who had come:"},{"id":"manas-2010:p0846:b001:l029","ordinal":37305,"en":"“My companions, my friends,"},{"id":"manas-2010:p0846:b001:l030","ordinal":37306,"en":"You, my only eyes beneath my brow,"},{"id":"manas-2010:p0846:b001:l031","ordinal":37307,"en":"These are the words I speak:"},{"id":"manas-2010:p0846:b001:l032","ordinal":37308,"en":"That I have found a child,"},{"id":"manas-2010:p0846:b001:l033","ordinal":37309,"en":"Do not let a single person know;"},{"id":"manas-2010:p0846:b001:l034","ordinal":37310,"en":"Do not let a single person hear!"},{"id":"manas-2010:p0846:b001:l035","ordinal":37311,"en":"Understand well what I say;"},{"id":"manas-2010:p0846:b001:l036","ordinal":37312,"en":"Chew white wheat flour."},{"id":"manas-2010:p0846:b001:l037","ordinal":37313,"en":"Swear yourselves to silence,"},{"id":"manas-2010:p0846:b001:l038","ordinal":37314,"en":"And take the holy Quran in your hands!"},{"id":"manas-2010:p0846:b001:l039","ordinal":37315,"en":"See how exceptional my generosity is:"},{"id":"manas-2010:p0846:b001:l040","ordinal":37316,"en":"My countless herds of livestock—"},{"id":"manas-2010:p0846:b001:l041","ordinal":37317,"en":"Divide them all, leaving none!”"},{"id":"manas-2010:p0846:b001:l042","ordinal":37318,"en":"Thus spoke Akbaltay,"},{"id":"manas-2010:p0847:b001:l001","ordinal":37319,"en":"As twilight fell and the sun went down,"},{"id":"manas-2010:p0847:b001:l002","ordinal":37320,"en":"And the first sleepers had all lain down,"},{"id":"manas-2010:p0847:b001:l003","ordinal":37321,"en":"Without letting a single person know,"},{"id":"manas-2010:p0847:b001:l004","ordinal":37322,"en":"Without being seen by anyone,"},{"id":"manas-2010:p0847:b001:l005","ordinal":37323,"en":"To his people in the broad Altai"},{"id":"manas-2010:p0847:b001:l006","ordinal":37324,"en":"He rode and arrived."},{"id":"manas-2010:p0847:b001:l007","ordinal":37325,"en":"The child hidden against his own flesh,"},{"id":"manas-2010:p0847:b001:l008","ordinal":37326,"en":"He brought him safely there."},{"id":"manas-2010:p0847:b001:l009","ordinal":37327,"en":"His chief wife, Markatay,"},{"id":"manas-2010:p0847:b001:l010","ordinal":37328,"en":"Was a skilled craftswoman among women."},{"id":"manas-2010:p0847:b001:l011","ordinal":37329,"en":"If you ask about her father,"},{"id":"manas-2010:p0847:b001:l012","ordinal":37330,"en":"She was the daughter of Khan Kayyp."},{"id":"manas-2010:p0847:b001:l013","ordinal":37331,"en":"The deftest of those with brass thimbles,"},{"id":"manas-2010:p0847:b001:l014","ordinal":37332,"en":"The finest among women,"},{"id":"manas-2010:p0847:b001:l015","ordinal":37333,"en":"The eldest of sixty wives,"},{"id":"manas-2010:p0847:b001:l016","ordinal":37334,"en":"The loveliest of the long-haired women,"},{"id":"manas-2010:p0847:b001:l017","ordinal":37335,"en":"Excelling among the brass-thimble wearers,"},{"id":"manas-2010:p0847:b001:l018","ordinal":37336,"en":"To wolf-maned Baltay the warrior"},{"id":"manas-2010:p0847:b001:l019","ordinal":37337,"en":"She came when she was fourteen."},{"id":"manas-2010:p0847:b001:l020","ordinal":37338,"en":"They had joined when tiny as lice,"},{"id":"manas-2010:p0847:b001:l021","ordinal":37339,"en":"Wed when small as thumbs,"},{"id":"manas-2010:p0847:b001:l022","ordinal":37340,"en":"Joined when tiny as lice."},{"id":"manas-2010:p0847:b001:l023","ordinal":37341,"en":"To his companion in lawful marriage:"},{"id":"manas-2010:p0847:b001:l024","ordinal":37342,"en":"“I have come before you,” he said."},{"id":"manas-2010:p0847:b001:l025","ordinal":37343,"en":"“On reaching forty—"},{"id":"manas-2010:p0847:b001:l026","ordinal":37344,"en":"Such is this wondrous world—"},{"id":"manas-2010:p0847:b001:l027","ordinal":37345,"en":"We have escaped childlessness."},{"id":"manas-2010:p0847:b001:l028","ordinal":37346,"en":"This is your God's gift!"},{"id":"manas-2010:p0847:b001:l029","ordinal":37347,"en":"Put an amulet around his neck;"},{"id":"manas-2010:p0847:b001:l030","ordinal":37348,"en":"Cherish him and raise him well!”"},{"id":"manas-2010:p0847:b001:l031","ordinal":37349,"en":"So Akbaltay spoke,"},{"id":"manas-2010:p0847:b001:l032","ordinal":37350,"en":"Then said, “My chief wife has borne a son!”"},{"id":"manas-2010:p0847:b001:l033","ordinal":37351,"en":"Oh, he made meat into a hill,"},{"id":"manas-2010:p0847:b001:l034","ordinal":37352,"en":"And broth into a reservoir-like lake."},{"id":"manas-2010:p0847:b001:l035","ordinal":37353,"en":"He had ninety slaughtered for the feast;"},{"id":"manas-2010:p0847:b001:l036","ordinal":37354,"en":"With their fangs jutting out,"},{"id":"manas-2010:p0847:b001:l037","ordinal":37355,"en":"Their front lips hanging down,"},{"id":"manas-2010:p0847:b001:l038","ordinal":37356,"en":"A thousand camels he slaughtered."},{"id":"manas-2010:p0847:b001:l039","ordinal":37357,"en":"He held horse races and a feast,"},{"id":"manas-2010:p0847:b001:l040","ordinal":37358,"en":"Gathering the peoples of the world,"},{"id":"manas-2010:p0847:b001:l041","ordinal":37359,"en":"Making a splendid, resounding celebration,"},{"id":"manas-2010:p0847:b001:l042","ordinal":37360,"en":"Showing the people his distinction."},{"id":"manas-2010:p0848:b001:l001","ordinal":37361,"en":"Your Baltay, now with a child,"},{"id":"manas-2010:p0848:b001:l002","ordinal":37362,"en":"Had settled into contentment."},{"id":"manas-2010:p0848:b001:l003","ordinal":37363,"en":"All his countless livestock"},{"id":"manas-2010:p0848:b001:l004","ordinal":37364,"en":"He had slaughtered."},{"id":"manas-2010:p0848:b001:l005","ordinal":37365,"en":"Great entertainment and rejoicing"},{"id":"manas-2010:p0848:b001:l006","ordinal":37366,"en":"He had provided."},{"id":"manas-2010:p0848:b001:l007","ordinal":37367,"en":"The people gathered and feasted;"},{"id":"manas-2010:p0848:b001:l008","ordinal":37368,"en":"He devised a plan none could have thought of."},{"id":"manas-2010:p0848:b001:l009","ordinal":37369,"en":"To those who said, “May your cradle straps hold firm!”"},{"id":"manas-2010:p0848:b001:l010","ordinal":37370,"en":"Five sets of nine, each headed by a mare,"},{"id":"manas-2010:p0848:b001:l011","ordinal":37371,"en":"He gave as gifts of honor."},{"id":"manas-2010:p0848:b001:l012","ordinal":37372,"en":"Four sets of nine, each headed by a camel,"},{"id":"manas-2010:p0848:b001:l013","ordinal":37373,"en":"He gave as rewards for joyful news."},{"id":"manas-2010:p0848:b001:l014","ordinal":37374,"en":"All the people ate their fill,"},{"id":"manas-2010:p0848:b001:l015","ordinal":37375,"en":"And great herds were slaughtered."},{"id":"manas-2010:p0848:b001:l016","ordinal":37376,"en":"Calling out to the people,"}]
