[{"id":"semetey-1-2013:p1088:b004:l027","ordinal":159233,"en":"Saying, \"My dear father will ride it,\""},{"id":"semetey-1-2013:p1088:b004:l028","ordinal":159234,"en":"He saddled exactly one thousand coal-black horses"},{"id":"semetey-1-2013:p1088:b004:l029","ordinal":159235,"en":"As Buraq mounts."},{"id":"semetey-1-2013:p1088:b004:l030","ordinal":159236,"en":"In this way, Kökötöy's Bokmurun"},{"id":"semetey-1-2013:p1088:b004:l031","ordinal":159237,"en":"Struck fear into the hearts"},{"id":"semetey-1-2013:p1088:b004:l032","ordinal":159238,"en":"Of all the common people,"},{"id":"semetey-1-2013:p1088:b004:l033","ordinal":159239,"en":"And began these doings"},{"id":"semetey-1-2013:p1088:b004:l034","ordinal":159240,"en":"For his father's mourning feast."},{"id":"semetey-1-2013:p1088:b004:l035","ordinal":159241,"en":"Unable to endure his demands,"},{"id":"semetey-1-2013:p1088:b004:l036","ordinal":159242,"en":"The Kyrgyz of broad Tashken"},{"id":"semetey-1-2013:p1088:b004:l037","ordinal":159243,"en":"Began to perish."},{"id":"semetey-1-2013:p1088:b004:l038","ordinal":159244,"en":"Hearing that Khan Kökötöy had died,"},{"id":"semetey-1-2013:p1088:b004:l039","ordinal":159245,"en":"The people heard and the nation came."},{"id":"semetey-1-2013:p1089:b003:l001","ordinal":159246,"en":"Of all that ears had heard and eyes had seen,"},{"id":"semetey-1-2013:p1089:b003:l002","ordinal":159247,"en":"Every soul who heard came."},{"id":"semetey-1-2013:p1089:b003:l003","ordinal":159248,"en":"His white turban was large as a cauldron;"},{"id":"semetey-1-2013:p1089:b003:l004","ordinal":159249,"en":"When he cried out, his voice was like the call to prayer."},{"id":"semetey-1-2013:p1089:b003:l005","ordinal":159250,"en":"The khoja's heart found contentment;"},{"id":"semetey-1-2013:p1089:b003:l006","ordinal":159251,"en":"Every pauper and dervish who had lacked means"},{"id":"semetey-1-2013:p1089:b003:l007","ordinal":159252,"en":"Received seven head of livestock,"},{"id":"semetey-1-2013:p1089:b003:l008","ordinal":159253,"en":"And his satisfied heart rejoiced."},{"id":"semetey-1-2013:p1089:b003:l009","ordinal":159254,"en":"At Kökötöy's death,"},{"id":"semetey-1-2013:p1089:b003:l010","ordinal":159255,"en":"Even the utterly poor became rich."},{"id":"semetey-1-2013:p1089:b003:l011","ordinal":159256,"en":"Kökötöy's Bokmurun"},{"id":"semetey-1-2013:p1089:b003:l012","ordinal":159257,"en":"Took instruction from the learned"},{"id":"semetey-1-2013:p1089:b003:l013","ordinal":159258,"en":"And questioned the wise."},{"id":"semetey-1-2013:p1089:b003:l014","ordinal":159259,"en":"Hearing counsel from the wise,"},{"id":"semetey-1-2013:p1089:b003:l015","ordinal":159260,"en":"He had a shroud made of fine cloth;"},{"id":"semetey-1-2013:p1089:b003:l016","ordinal":159261,"en":"Hearing that it would be splendid,"},{"id":"semetey-1-2013:p1089:b003:l017","ordinal":159262,"en":"He dressed him in a loose silk robe,"},{"id":"semetey-1-2013:p1089:b003:l018","ordinal":159263,"en":"Mounted him upon Zhelmayan,"},{"id":"semetey-1-2013:p1089:b003:l019","ordinal":159264,"en":"Gave a letter inscribed with a verse,"},{"id":"semetey-1-2013:p1089:b003:l020","ordinal":159265,"en":"And gave provisions to the scholars."},{"id":"semetey-1-2013:p1089:b003:l021","ordinal":159266,"en":"He had Egypt and Baghdad"},{"id":"semetey-1-2013:p1089:b003:l022","ordinal":159267,"en":"Called upon side by side,"},{"id":"semetey-1-2013:p1089:b003:l023","ordinal":159268,"en":"And had Kökötöy's shroud"},{"id":"semetey-1-2013:p1089:b003:l024","ordinal":159269,"en":"Brought from great Egypt."},{"id":"semetey-1-2013:p1089:b003:l025","ordinal":159270,"en":"He wrapped him in the shroud,"},{"id":"semetey-1-2013:p1089:b003:l026","ordinal":159271,"en":"And in this way consumed"},{"id":"semetey-1-2013:p1089:b003:l027","ordinal":159272,"en":"Kökötöy's countless riches."},{"id":"semetey-1-2013:p1089:b003:l028","ordinal":159273,"en":"He had him washed with Zamzam water,"},{"id":"semetey-1-2013:p1089:b003:l029","ordinal":159274,"en":"Performed the rites from head to foot,"},{"id":"semetey-1-2013:p1089:b003:l030","ordinal":159275,"en":"And had him bound in a robe of honor."},{"id":"semetey-1-2013:p1089:b003:l031","ordinal":159276,"en":"He had the mourning standard drawn straight,"},{"id":"semetey-1-2013:p1089:b003:l032","ordinal":159277,"en":"And had Külaiym voice"},{"id":"semetey-1-2013:p1089:b003:l033","ordinal":159278,"en":"Kökötöy's lament."},{"id":"semetey-1-2013:p1089:b003:l034","ordinal":159279,"en":"He had all the riches"},{"id":"semetey-1-2013:p1089:b003:l035","ordinal":159280,"en":"Prepared and counted,"},{"id":"semetey-1-2013:p1089:b003:l036","ordinal":159281,"en":"And to give to those who washed the body,"},{"id":"semetey-1-2013:p1089:b003:l037","ordinal":159282,"en":"Had exactly five hundred"},{"id":"semetey-1-2013:p1089:b003:l038","ordinal":159283,"en":"Armored robes made ready."},{"id":"semetey-1-2013:p1089:b003:l039","ordinal":159284,"en":"The treasury doors opened,"},{"id":"semetey-1-2013:p1089:b005:l001","ordinal":159285,"en":"And Kökötöy's countless riches"},{"id":"semetey-1-2013:p1089:b005:l002","ordinal":159286,"en":"Were squandered and scattered"},{"id":"semetey-1-2013:p1089:b005:l003","ordinal":159287,"en":"At his mourning feast."},{"id":"semetey-1-2013:p1089:b005:l004","ordinal":159288,"en":"Khan Kökötöy's resting place,"},{"id":"semetey-1-2013:p1089:b005:l005","ordinal":159289,"en":"His grave, was dug apart."},{"id":"semetey-1-2013:p1089:b005:l006","ordinal":159290,"en":"From champions who wielded spades"},{"id":"semetey-1-2013:p1089:b005:l007","ordinal":159291,"en":"And stalwarts who wielded mattocks,"},{"id":"semetey-1-2013:p1089:b005:l008","ordinal":159292,"en":"He summoned them all without exception"},{"id":"semetey-1-2013:p1089:b005:l009","ordinal":159293,"en":"From Kokon and Samarkan,"},{"id":"semetey-1-2013:p1089:b005:l010","ordinal":159294,"en":"And brought grave-digging champions"},{"id":"semetey-1-2013:p1089:b005:l011","ordinal":159295,"en":"From among them."},{"id":"semetey-1-2013:p1089:b005:l012","ordinal":159296,"en":"They dug his resting chamber evenly,"},{"id":"semetey-1-2013:p1089:b005:l013","ordinal":159297,"en":"Dug it broad in proper measure,"},{"id":"semetey-1-2013:p1089:b005:l014","ordinal":159298,"en":"Dug it perfectly balanced,"},{"id":"semetey-1-2013:p1089:b005:l015","ordinal":159299,"en":"Leveled it and dug it all large."},{"id":"semetey-1-2013:p1089:b005:l016","ordinal":159300,"en":"He had its burial niche hollowed,"},{"id":"semetey-1-2013:p1089:b005:l017","ordinal":159301,"en":"And had it extended from head to foot."},{"id":"semetey-1-2013:p1089:b005:l018","ordinal":159302,"en":"So that it would remain bright"},{"id":"semetey-1-2013:p1089:b005:l019","ordinal":159303,"en":"Until the end of time,"},{"id":"semetey-1-2013:p1089:b005:l020","ordinal":159304,"en":"He had garnet and ruby"},{"id":"semetey-1-2013:p1089:b005:l021","ordinal":159305,"en":"Split open,"},{"id":"semetey-1-2013:p1089:b005:l022","ordinal":159306,"en":"And had lights set"},{"id":"semetey-1-2013:p1089:b005:l023","ordinal":159307,"en":"At his feet and head."},{"id":"semetey-1-2013:p1089:b005:l024","ordinal":159308,"en":"\"Khan Kökötöy has died,\" they said,"},{"id":"semetey-1-2013:p1089:b005:l025","ordinal":159309,"en":"Making it known to the people."},{"id":"semetey-1-2013:p1089:b005:l026","ordinal":159310,"en":"Saying, \"These are the khan's wives,\""},{"id":"semetey-1-2013:p1089:b005:l027","ordinal":159311,"en":"They dressed all seven wives"},{"id":"semetey-1-2013:p1089:b005:l028","ordinal":159312,"en":"In billowing black garments."},{"id":"semetey-1-2013:p1089:b005:l029","ordinal":159313,"en":"When this Kökötöy died,"},{"id":"semetey-1-2013:p1089:b005:l030","ordinal":159314,"en":"People gathered in a mass;"},{"id":"semetey-1-2013:p1089:b005:l031","ordinal":159315,"en":"All the countless giants"},{"id":"semetey-1-2013:p1089:b005:l032","ordinal":159316,"en":"Heaped the earth upon him."},{"id":"semetey-1-2013:p1089:b005:l033","ordinal":159317,"en":"\"Khan Kökötöy has died,\""},{"id":"semetey-1-2013:p1089:b005:l034","ordinal":159318,"en":"\"The dear man has seen"},{"id":"semetey-1-2013:p1089:b005:l035","ordinal":159319,"en":"The true abode from which none return.\""},{"id":"semetey-1-2013:p1089:b005:l036","ordinal":159320,"en":"Kökötöy's Bokmurun"},{"id":"semetey-1-2013:p1089:b005:l037","ordinal":159321,"en":"Wept without opening his eyes:"},{"id":"semetey-1-2013:p1089:b005:l038","ordinal":159322,"en":"\"My valiant father has passed away,"},{"id":"semetey-1-2013:p1089:b005:l039","ordinal":159323,"en":"To the place from which none return;"},{"id":"semetey-1-2013:p1090:b003:l001","ordinal":159324,"en":"My sovereign father has gone,\""},{"id":"semetey-1-2013:p1090:b003:l002","ordinal":159325,"en":"\"This is the moment he vanished from sight."},{"id":"semetey-1-2013:p1090:b003:l003","ordinal":159326,"en":"My father Kökötöy—"},{"id":"semetey-1-2013:p1090:b003:l004","ordinal":159327,"en":"People, here above the grave"},{"id":"semetey-1-2013:p1090:b003:l005","ordinal":159328,"en":"Is your last meeting with him."},{"id":"semetey-1-2013:p1090:b003:l006","ordinal":159329,"en":"Five hundred young camels and five hundred mares"},{"id":"semetey-1-2013:p1090:b003:l007","ordinal":159330,"en":"Today, for my lordly father,"},{"id":"semetey-1-2013:p1090:b003:l008","ordinal":159331,"en":"I shall offer as grave prizes."},{"id":"semetey-1-2013:p1090:b003:l009","ordinal":159332,"en":"Now that my dear father has passed,"},{"id":"semetey-1-2013:p1090:b003:l010","ordinal":159333,"en":"How shall I hold his feast?"},{"id":"semetey-1-2013:p1090:b003:l011","ordinal":159334,"en":"How shall I race the horses?"},{"id":"semetey-1-2013:p1090:b003:l012","ordinal":159335,"en":"I put the matter before you."},{"id":"semetey-1-2013:p1090:b003:l013","ordinal":159336,"en":"All the mighty champions are here;"},{"id":"semetey-1-2013:p1090:b003:l014","ordinal":159337,"en":"I shall take counsel.\""},{"id":"semetey-1-2013:p1090:b003:l015","ordinal":159338,"en":"I myself was right there then,"},{"id":"semetey-1-2013:p1090:b003:l016","ordinal":159339,"en":"At Kökötöy's feast;"},{"id":"semetey-1-2013:p1090:b003:l017","ordinal":159340,"en":"My gray-wolf father, hero Bagysh,"},{"id":"semetey-1-2013:p1090:b003:l018","ordinal":159341,"en":"Was present at the summons."},{"id":"semetey-1-2013:p1090:b003:l019","ordinal":159342,"en":"If you ask how I was then,"},{"id":"semetey-1-2013:p1090:b003:l020","ordinal":159343,"en":"My father, hero Bagysh,"},{"id":"semetey-1-2013:p1090:b003:l021","ordinal":159344,"en":"Mounted me on a bay-piebald pacer,"},{"id":"semetey-1-2013:p1090:b003:l022","ordinal":159345,"en":"Dressed me in a silk coat,"},{"id":"semetey-1-2013:p1090:b003:l023","ordinal":159346,"en":"And led me about the feast."},{"id":"semetey-1-2013:p1090:b003:l024","ordinal":159347,"en":"He mounted me on a pale-piebald pacer,"},{"id":"semetey-1-2013:p1090:b003:l025","ordinal":159348,"en":"Dressed me in garments of precious cloth,"},{"id":"semetey-1-2013:p1090:b003:l026","ordinal":159349,"en":"And led me about the feast."},{"id":"semetey-1-2013:p1090:b003:l027","ordinal":159350,"en":"My poor head had not yet"},{"id":"semetey-1-2013:p1090:b003:l028","ordinal":159351,"en":"Risen above the saddle's fork;"},{"id":"semetey-1-2013:p1090:b003:l029","ordinal":159352,"en":"At that time my age"},{"id":"semetey-1-2013:p1090:b003:l030","ordinal":159353,"en":"Had not yet passed six."},{"id":"semetey-1-2013:p1090:b003:l031","ordinal":159354,"en":"I saw how Kökötöy's"},{"id":"semetey-1-2013:p1090:b003:l032","ordinal":159355,"en":"Vast riches overflowed;"},{"id":"semetey-1-2013:p1090:b003:l033","ordinal":159356,"en":"I saw many people take plunder"},{"id":"semetey-1-2013:p1090:b003:l034","ordinal":159357,"en":"And thereby prosper."},{"id":"semetey-1-2013:p1090:b003:l035","ordinal":159358,"en":"If you ask about that time,"},{"id":"semetey-1-2013:p1090:b003:l036","ordinal":159359,"en":"Kökötöy's Bokmurun"},{"id":"semetey-1-2013:p1090:b003:l037","ordinal":159360,"en":"Had reached twelve years of age;"},{"id":"semetey-1-2013:p1090:b003:l038","ordinal":159361,"en":"He deemed no soul his equal"},{"id":"semetey-1-2013:p1090:b003:l039","ordinal":159362,"en":"And had grown drunk on wealth."},{"id":"semetey-1-2013:p1090:b004:l001","ordinal":159363,"en":"Saying, \"My khan-father has died,\""},{"id":"semetey-1-2013:p1090:b004:l002","ordinal":159364,"en":"He gathered under his gaze"},{"id":"semetey-1-2013:p1090:b004:l003","ordinal":159365,"en":"Infidel and Muslim alike,"},{"id":"semetey-1-2013:p1090:b004:l004","ordinal":159366,"en":"Yet sent no word"},{"id":"semetey-1-2013:p1090:b004:l005","ordinal":159367,"en":"To Zhakyp's only son, Manas."},{"id":"semetey-1-2013:p1090:b004:l006","ordinal":159368,"en":"Know his arrogance from this:"},{"id":"semetey-1-2013:p1090:b004:l007","ordinal":159369,"en":"At Kökötöy's mourning feast,"},{"id":"semetey-1-2013:p1090:b004:l008","ordinal":159370,"en":"Manas did not come to heap earth"},{"id":"semetey-1-2013:p1090:b004:l009","ordinal":159371,"en":"And did not cast his handful of soil."},{"id":"semetey-1-2013:p1090:b004:l010","ordinal":159372,"en":"Akkula was mounted,"},{"id":"semetey-1-2013:p1090:b004:l011","ordinal":159373,"en":"His white armor was donned,"},{"id":"semetey-1-2013:p1090:b004:l012","ordinal":159374,"en":"His sharp steel was girded on;"},{"id":"semetey-1-2013:p1090:b004:l013","ordinal":159375,"en":"Lion Manas, the tiger,"},{"id":"semetey-1-2013:p1090:b004:l014","ordinal":159376,"en":"Vowed, \"I shall strike down Bokmurun,\""},{"id":"semetey-1-2013:p1090:b004:l015","ordinal":159377,"en":"And raged like a white tiger."},{"id":"semetey-1-2013:p1090:b004:l016","ordinal":159378,"en":"As Manas stood shouting,"},{"id":"semetey-1-2013:p1090:b004:l017","ordinal":159379,"en":"Your gray wolf, wise Bakay,"},{"id":"semetey-1-2013:p1090:b004:l018","ordinal":159380,"en":"Stepped between them:"},{"id":"semetey-1-2013:p1090:b004:l019","ordinal":159381,"en":"\"Kökötöy's Bokmurun"},{"id":"semetey-1-2013:p1090:b004:l020","ordinal":159382,"en":"Is no yellow, rugged mountain"},{"id":"semetey-1-2013:p1090:b004:l021","ordinal":159383,"en":"For you to go and strike down,"},{"id":"semetey-1-2013:p1090:b004:l022","ordinal":159384,"en":"And no enemy with whom to test your strength."},{"id":"semetey-1-2013:p1090:b004:l023","ordinal":159385,"en":"Can one strike an idolater?"},{"id":"semetey-1-2013:p1090:b004:l024","ordinal":159386,"en":"If he attacks an idolater,"},{"id":"semetey-1-2013:p1090:b004:l025","ordinal":159387,"en":"Will Manas's deed prosper?"},{"id":"semetey-1-2013:p1090:b004:l026","ordinal":159388,"en":"Can one strike an orphan?"},{"id":"semetey-1-2013:p1090:b004:l027","ordinal":159389,"en":"Will such a complete deed prosper?"},{"id":"semetey-1-2013:p1090:b004:l028","ordinal":159390,"en":"If you go and attack a child,"},{"id":"semetey-1-2013:p1090:b004:l029","ordinal":159391,"en":"Entangling your deed in shame,"},{"id":"semetey-1-2013:p1090:b004:l030","ordinal":159392,"en":"Will your affair then prosper?\""},{"id":"semetey-1-2013:p1090:b004:l031","ordinal":159393,"en":"Noble Bakay, the tiger,"},{"id":"semetey-1-2013:p1090:b004:l032","ordinal":159394,"en":"Stepped between them"},{"id":"semetey-1-2013:p1090:b004:l033","ordinal":159395,"en":"And began his speech."},{"id":"semetey-1-2013:p1090:b004:l034","ordinal":159396,"en":"Thus he restrained"},{"id":"semetey-1-2013:p1090:b004:l035","ordinal":159397,"en":"His magnanimous lord Manas."},{"id":"semetey-1-2013:p1090:b004:l036","ordinal":159398,"en":"Other elders besides Manas were there;"},{"id":"semetey-1-2013:p1090:b004:l037","ordinal":159399,"en":"\"When Khan Kökötöy died,"},{"id":"semetey-1-2013:p1090:b004:l038","ordinal":159400,"en":"When the people gathered and buried him,"},{"id":"semetey-1-2013:p1090:b004:l039","ordinal":159401,"en":"All the common folk were there."},{"id":"semetey-1-2013:p1091:b003:l001","ordinal":159402,"en":"Among them"},{"id":"semetey-1-2013:p1091:b003:l002","ordinal":159403,"en":"Was the hero Koshoy as well."},{"id":"semetey-1-2013:p1091:b003:l003","ordinal":159404,"en":"At Kökötöy's mourning feast,"},{"id":"semetey-1-2013:p1091:b003:l004","ordinal":159405,"en":"His people surged together;"},{"id":"semetey-1-2013:p1091:b003:l005","ordinal":159406,"en":"I saw the place where they buried him."},{"id":"semetey-1-2013:p1091:b003:l006","ordinal":159407,"en":"I saw the place where the people"},{"id":"semetey-1-2013:p1091:b003:l007","ordinal":159408,"en":"Camped for many days."},{"id":"semetey-1-2013:p1091:b003:l008","ordinal":159409,"en":"I saw with my own eyes"},{"id":"semetey-1-2013:p1091:b003:l009","ordinal":159410,"en":"Kökötöy's grave prizes."},{"id":"semetey-1-2013:p1091:b003:l010","ordinal":159411,"en":"Adorning them richly with gold and jewels,"},{"id":"semetey-1-2013:p1091:b003:l011","ordinal":159412,"en":"He staked all his wealth"},{"id":"semetey-1-2013:p1091:b003:l012","ordinal":159413,"en":"In equal shares, without favor,"},{"id":"semetey-1-2013:p1091:b003:l013","ordinal":159414,"en":"Staked a thousand dark camels,"},{"id":"semetey-1-2013:p1091:b003:l014","ordinal":159415,"en":"And a thousand black-blazed mares."},{"id":"semetey-1-2013:p1091:b003:l015","ordinal":159416,"en":"The racers that were to run"},{"id":"semetey-1-2013:p1091:b004:l001","ordinal":159417,"en":"Had their hair tails braided,"},{"id":"semetey-1-2013:p1091:b004:l002","ordinal":159418,"en":"Their forelocks adorned"},{"id":"semetey-1-2013:p1091:b004:l003","ordinal":159419,"en":"And tied with blue silk."},{"id":"semetey-1-2013:p1091:b004:l004","ordinal":159420,"en":"Their waists were formed slender as a girl's;"},{"id":"semetey-1-2013:p1091:b004:l005","ordinal":159421,"en":"They streamed uphill and down."},{"id":"semetey-1-2013:p1091:b004:l006","ordinal":159422,"en":"Kökötöy's many prizes"},{"id":"semetey-1-2013:p1091:b004:l007","ordinal":159423,"en":"Delighted every soul who saw them."},{"id":"semetey-1-2013:p1091:b004:l008","ordinal":159424,"en":"Their fangs protruding,"},{"id":"semetey-1-2013:p1091:b004:l009","ordinal":159425,"en":"The swift horses grew restive;"},{"id":"semetey-1-2013:p1091:b004:l010","ordinal":159426,"en":"Their mustaches bristling,"},{"id":"semetey-1-2013:p1091:b004:l011","ordinal":159427,"en":"Giants and heroes grew excited."},{"id":"semetey-1-2013:p1091:b004:l012","ordinal":159428,"en":"They covered him and heaped the earth;"},{"id":"semetey-1-2013:p1091:b004:l013","ordinal":159429,"en":"Saying Khan Kökötöy had died,"},{"id":"semetey-1-2013:p1091:b004:l014","ordinal":159430,"en":"The common people gathered in a mass,"},{"id":"semetey-1-2013:p1091:b004:l015","ordinal":159431,"en":"With their khojas and men of standing."},{"id":"semetey-1-2013:p1091:b006:l001","ordinal":159432,"en":"For Khan Kökötöy's death,"},{"id":"semetey-1-2013:p1091:b006:l002","ordinal":159433,"en":"There were peoples who had set out and come."},{"id":"semetey-1-2013:p1091:b006:l003","ordinal":159434,"en":"There were heroes and giants,"},{"id":"semetey-1-2013:p1091:b006:l004","ordinal":159435,"en":"Heroes each worth a thousand,"},{"id":"semetey-1-2013:p1091:b006:l005","ordinal":159436,"en":"All of them gathered there."},{"id":"semetey-1-2013:p1091:b006:l006","ordinal":159437,"en":"His white beard flowing,"},{"id":"semetey-1-2013:p1091:b006:l007","ordinal":159438,"en":"He who had fathomed the depths of wisdom,"},{"id":"semetey-1-2013:p1091:b006:l008","ordinal":159439,"en":"At whose stern face men trembled,"},{"id":"semetey-1-2013:p1091:b006:l009","ordinal":159440,"en":"Who had studied under saints—"},{"id":"semetey-1-2013:p1091:b006:l010","ordinal":159441,"en":"Mighty Koshoy too was there."},{"id":"semetey-1-2013:p1091:b006:l011","ordinal":159442,"en":"He made the unknown known,"},{"id":"semetey-1-2013:p1091:b006:l012","ordinal":159443,"en":"The learned elder Koshoy."},{"id":"semetey-1-2013:p1091:b006:l013","ordinal":159444,"en":"Do not ask of Koshoy's station:"},{"id":"semetey-1-2013:p1091:b006:l014","ordinal":159445,"en":"To receive the highest instruction,"},{"id":"semetey-1-2013:p1091:b006:l015","ordinal":159446,"en":"Hero Koshoy entered Egypt"},{"id":"semetey-1-2013:p1091:b006:l016","ordinal":159447,"en":"And studied in Egypt for five years."},{"id":"semetey-1-2013:p1091:b006:l017","ordinal":159448,"en":"To comprehend all the world,"},{"id":"semetey-1-2013:p1091:b006:l018","ordinal":159449,"en":"He studied in Baghdad for five years."},{"id":"semetey-1-2013:p1091:b006:l019","ordinal":159450,"en":"Traveling the lands before him,"},{"id":"semetey-1-2013:p1091:b008:l001","ordinal":159451,"en":"Hero Koshoy entered Mecca"},{"id":"semetey-1-2013:p1091:b008:l002","ordinal":159452,"en":"And studied in Mecca for five years."},{"id":"semetey-1-2013:p1091:b008:l003","ordinal":159453,"en":"He received a letter from the caliph,"},{"id":"semetey-1-2013:p1091:b008:l004","ordinal":159454,"en":"Pledged his hand to the twelve-in-one,"},{"id":"semetey-1-2013:p1091:b008:l005","ordinal":159455,"en":"And was called Sayypburush."},{"id":"semetey-1-2013:p1091:b008:l006","ordinal":159456,"en":"His white beard flowing,"},{"id":"semetey-1-2013:p1091:b008:l007","ordinal":159457,"en":"That elder, your uncle Koshoy,"},{"id":"semetey-1-2013:p1091:b008:l008","ordinal":159458,"en":"Had examined every counsel."},{"id":"semetey-1-2013:p1091:b008:l009","ordinal":159459,"en":"Before that Koshoy,"},{"id":"semetey-1-2013:p1091:b008:l010","ordinal":159460,"en":"The people were gathered."},{"id":"semetey-1-2013:p1091:b008:l011","ordinal":159461,"en":"The rich man's son Bokmurun,"},{"id":"semetey-1-2013:p1091:b008:l012","ordinal":159462,"en":"Saying, \"My khan-father has passed away,\""},{"id":"semetey-1-2013:p1091:b008:l013","ordinal":159463,"en":"Wept before Khan Koshoy:"},{"id":"semetey-1-2013:p1091:b008:l014","ordinal":159464,"en":"\"My uncle, elder Koshoy,"},{"id":"semetey-1-2013:p1091:b008:l015","ordinal":159465,"en":"My father Kökötöy"},{"id":"semetey-1-2013:p1091:b008:l016","ordinal":159466,"en":"Was indeed the true Kökötöy."},{"id":"semetey-1-2013:p1091:b008:l017","ordinal":159467,"en":"My dear father's countless riches"},{"id":"semetey-1-2013:p1091:b008:l018","ordinal":159468,"en":"Filled the four corners of the world,"},{"id":"semetey-1-2013:p1091:b008:l019","ordinal":159469,"en":"The forty corners of the qibla,"},{"id":"semetey-1-2013:p1092:b003:l001","ordinal":159470,"en":"And forty circuits around it."},{"id":"semetey-1-2013:p1092:b003:l002","ordinal":159471,"en":"I have a spectacle to show the people;"},{"id":"semetey-1-2013:p1092:b003:l003","ordinal":159472,"en":"My dear father left me"},{"id":"semetey-1-2013:p1092:b003:l004","ordinal":159473,"en":"Abundant, glittering wealth."},{"id":"semetey-1-2013:p1092:b003:l005","ordinal":159474,"en":"I shall open the doors"},{"id":"semetey-1-2013:p1092:b003:l006","ordinal":159475,"en":"Of forty treasure-filled rooms."},{"id":"semetey-1-2013:p1092:b003:l007","ordinal":159476,"en":"My dear father's countless riches"},{"id":"semetey-1-2013:p1092:b003:l008","ordinal":159477,"en":"I shall squander and scatter"},{"id":"semetey-1-2013:p1092:b003:l009","ordinal":159478,"en":"Among infidel and Muslim alike."},{"id":"semetey-1-2013:p1092:b003:l010","ordinal":159479,"en":"I have robes of honor and possessions;"},{"id":"semetey-1-2013:p1092:b003:l011","ordinal":159480,"en":"I have exactly seven myriad sheep,"},{"id":"semetey-1-2013:p1092:b003:l012","ordinal":159481,"en":"And means to render service."},{"id":"semetey-1-2013:p1092:b003:l013","ordinal":159482,"en":"To carry my riches,"},{"id":"semetey-1-2013:p1092:b003:l014","ordinal":159483,"en":"And reach whatever land I desire,"},{"id":"semetey-1-2013:p1092:b003:l015","ordinal":159484,"en":"I have camels that have crossed the world."},{"id":"semetey-1-2013:p1092:b003:l016","ordinal":159485,"en":"Kökötöy's vast riches—"},{"id":"semetey-1-2013:p1092:b003:l017","ordinal":159486,"en":"Disregarding all restraint,"},{"id":"semetey-1-2013:p1092:b003:l018","ordinal":159487,"en":"I shall try spending them utterly."},{"id":"semetey-1-2013:p1092:b003:l019","ordinal":159488,"en":"I shall camp in the midst"}]
