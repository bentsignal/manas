[{"id":"manas-2010:p0230:b001:l013","ordinal":10241,"en":"From that boy—may your path fail!—"},{"id":"manas-2010:p0230:b001:l014","ordinal":10242,"en":"Let us flee without approaching."},{"id":"manas-2010:p0230:b001:l015","ordinal":10243,"en":"Can a mortal face him and win,"},{"id":"manas-2010:p0230:b001:l016","ordinal":10244,"en":"Against that damned blood-shedder,"},{"id":"manas-2010:p0230:b001:l017","ordinal":10245,"en":"Will one who matches him see home again?"},{"id":"manas-2010:p0230:b001:l018","ordinal":10246,"en":"He is a blood-shedder, he is a lion,"},{"id":"manas-2010:p0230:b001:l019","ordinal":10247,"en":"His twelve bodily parts are in balance,"},{"id":"manas-2010:p0230:b001:l020","ordinal":10248,"en":"If this Manas grows up,"},{"id":"manas-2010:p0230:b001:l021","ordinal":10249,"en":"Will he not wreck our possessions,"},{"id":"manas-2010:p0230:b001:l022","ordinal":10250,"en":"Will he not wreak terrible havoc,"},{"id":"manas-2010:p0230:b001:l023","ordinal":10251,"en":"If he lives, of Beejin,"},{"id":"manas-2010:p0230:b001:l024","ordinal":10252,"en":"Will he not seize the khanship!"},{"id":"manas-2010:p0230:b001:l025","ordinal":10253,"en":"He brings ruin upon this wretched head,"},{"id":"manas-2010:p0230:b001:l026","ordinal":10254,"en":"Since I have been Joloy,"},{"id":"manas-2010:p0230:b001:l027","ordinal":10255,"en":"Since I won the name of Joloy,"},{"id":"manas-2010:p0230:b001:l028","ordinal":10256,"en":"Since I rode Achbuudan,"},{"id":"manas-2010:p0230:b001:l029","ordinal":10257,"en":"Since I roared and attacked the enemy,"},{"id":"manas-2010:p0230:b001:l030","ordinal":10258,"en":"Upon everyone I met,"},{"id":"manas-2010:p0230:b001:l031","ordinal":10259,"en":"I used to bring misfortune,"},{"id":"manas-2010:p0230:b001:l032","ordinal":10260,"en":"Smashing whoever I encountered,"},{"id":"manas-2010:p0230:b001:l033","ordinal":10261,"en":"I used to torment and bind them."},{"id":"manas-2010:p0230:b001:l034","ordinal":10262,"en":"Since I have been Joloy,"},{"id":"manas-2010:p0230:b001:l035","ordinal":10263,"en":"At this Burut's hands,"},{"id":"manas-2010:p0230:b001:l036","ordinal":10264,"en":"I have all but died,"},{"id":"manas-2010:p0230:b001:l037","ordinal":10265,"en":"My two flailing arms"},{"id":"manas-2010:p0230:b001:l038","ordinal":10266,"en":"Are paralyzed and cannot rise,"},{"id":"manas-2010:p0230:b001:l039","ordinal":10267,"en":"My precious bucket-sized head"},{"id":"manas-2010:p0230:b001:l040","ordinal":10268,"en":"Is split and covered in dark blood."},{"id":"manas-2010:p0230:b001:l041","ordinal":10269,"en":"My ribs have shattered,"},{"id":"manas-2010:p0230:b001:l042","ordinal":10270,"en":"My fly-like soul cries out,"},{"id":"manas-2010:p0230:b001:l043","ordinal":10271,"en":"The joints of my spine,"},{"id":"manas-2010:p0230:b001:l044","ordinal":10272,"en":"When this Burut thrust his spear,"},{"id":"manas-2010:p0230:b001:l045","ordinal":10273,"en":"Were split apart, piece by piece,"},{"id":"manas-2010:p0230:b001:l046","ordinal":10274,"en":"That damned Burut's—"},{"id":"manas-2010:p0230:b001:l047","ordinal":10275,"en":"Good God, his fearsome prowess showed."},{"id":"manas-2010:p0230:b001:l048","ordinal":10276,"en":"I did not close my eyes and die,"},{"id":"manas-2010:p0231:b001:l001","ordinal":10277,"en":"Since I won the name of Khan Joloy,"},{"id":"manas-2010:p0231:b001:l002","ordinal":10278,"en":"I have seen none so wrathful."},{"id":"manas-2010:p0231:b001:l003","ordinal":10279,"en":"His courage is mighty, his fury fierce,"},{"id":"manas-2010:p0231:b001:l004","ordinal":10280,"en":"So many has he leveled,"},{"id":"manas-2010:p0231:b001:l005","ordinal":10281,"en":"He is no enemy to grapple with,"},{"id":"manas-2010:p0231:b001:l006","ordinal":10282,"en":"Give up hope of this Burut."},{"id":"manas-2010:p0231:b001:l007","ordinal":10283,"en":"He is no son to let one prosper,"},{"id":"manas-2010:p0231:b001:l008","ordinal":10284,"en":"He is no fellow to deal with lightly,"},{"id":"manas-2010:p0231:b001:l009","ordinal":10285,"en":"He unleashed his terrible wrath,"},{"id":"manas-2010:p0231:b001:l010","ordinal":10286,"en":"Döngö, who boasted of valor,"},{"id":"manas-2010:p0231:b001:l011","ordinal":10287,"en":"He slaughtered utterly."},{"id":"manas-2010:p0231:b001:l012","ordinal":10288,"en":"He is a champion and a lion,"},{"id":"manas-2010:p0231:b001:l013","ordinal":10289,"en":"This damned blood-shedder"},{"id":"manas-2010:p0231:b001:l014","ordinal":10290,"en":"Is also a surpassingly mighty warrior,"},{"id":"manas-2010:p0231:b001:l015","ordinal":10291,"en":"He stirred tumult into uproar,"},{"id":"manas-2010:p0231:b001:l016","ordinal":10292,"en":"The champion we relied upon,"},{"id":"manas-2010:p0231:b001:l017","ordinal":10293,"en":"He slaughtered utterly,"},{"id":"manas-2010:p0231:b001:l018","ordinal":10294,"en":"Their minds were scattered in bewilderment,"},{"id":"manas-2010:p0231:b001:l019","ordinal":10295,"en":"His menace drove life from them,"},{"id":"manas-2010:p0231:b001:l020","ordinal":10296,"en":"This Burut—may your house burn!—"},{"id":"manas-2010:p0231:b001:l021","ordinal":10297,"en":"Showed the bearing of a devouring monster."},{"id":"manas-2010:p0231:b001:l022","ordinal":10298,"en":"I have giants, I have mighty beings,"},{"id":"manas-2010:p0231:b001:l023","ordinal":10299,"en":"They did not face him and thrust their spears,"},{"id":"manas-2010:p0231:b001:l024","ordinal":10300,"en":"Against the fiercely wrathful Burut,"},{"id":"manas-2010:p0231:b001:l025","ordinal":10301,"en":"None who faced him stayed alive."},{"id":"manas-2010:p0231:b001:l026","ordinal":10302,"en":"He is no ordinary Burut son,"},{"id":"manas-2010:p0231:b001:l027","ordinal":10303,"en":"A mortal who confronts him,"},{"id":"manas-2010:p0231:b001:l028","ordinal":10304,"en":"He is no fellow to let him prosper,"},{"id":"manas-2010:p0231:b001:l029","ordinal":10305,"en":"Tall of stature, broad of shoulder,"},{"id":"manas-2010:p0231:b001:l030","ordinal":10306,"en":"Both champion and lion,"},{"id":"manas-2010:p0231:b001:l031","ordinal":10307,"en":"He has a cap like a small travel tent,"},{"id":"manas-2010:p0231:b001:l032","ordinal":10308,"en":"All whom he meets,"},{"id":"manas-2010:p0231:b001:l033","ordinal":10309,"en":"He has the power simply to destroy,"},{"id":"manas-2010:p0231:b001:l034","ordinal":10310,"en":"He has a coat no bullet pierces,"},{"id":"manas-2010:p0231:b001:l035","ordinal":10311,"en":"He has a horse no bullet reaches,"},{"id":"manas-2010:p0231:b001:l036","ordinal":10312,"en":"He has the menace of a white tiger,"},{"id":"manas-2010:p0231:b001:l037","ordinal":10313,"en":"The whole of the world,"},{"id":"manas-2010:p0231:b001:l038","ordinal":10314,"en":"He seems ready to seize,"},{"id":"manas-2010:p0231:b001:l039","ordinal":10315,"en":"Raging like a gray tiger,"},{"id":"manas-2010:p0231:b001:l040","ordinal":10316,"en":"His face like wheat glistening with oil,"},{"id":"manas-2010:p0231:b001:l041","ordinal":10317,"en":"His eyes like mist at dusk,"},{"id":"manas-2010:p0231:b001:l042","ordinal":10318,"en":"The Burut was born in Altay,"},{"id":"manas-2010:p0231:b001:l043","ordinal":10319,"en":"Not just the Kytay, but all peoples,"},{"id":"manas-2010:p0231:b001:l044","ordinal":10320,"en":"He will plunge into tumult."},{"id":"manas-2010:p0231:b001:l045","ordinal":10321,"en":"His world is complete,"},{"id":"manas-2010:p0231:b001:l046","ordinal":10322,"en":"If we look within him,"},{"id":"manas-2010:p0231:b001:l047","ordinal":10323,"en":"He is wider than the face of the earth,"},{"id":"manas-2010:p0231:b001:l048","ordinal":10324,"en":"When I observe his measure,"},{"id":"manas-2010:p0232:b001:l001","ordinal":10325,"en":"He is a lion under sacred protection."},{"id":"manas-2010:p0232:b001:l002","ordinal":10326,"en":"To grim-looking Manas,"},{"id":"manas-2010:p0232:b001:l003","ordinal":10327,"en":"Can a mortal bring harm?"},{"id":"manas-2010:p0232:b001:l004","ordinal":10328,"en":"Against that damned blood-shedder,"},{"id":"manas-2010:p0232:b001:l005","ordinal":10329,"en":"Can one who faces him remain alive?”"},{"id":"manas-2010:p0232:b001:l006","ordinal":10330,"en":"Much is false and much is true,"},{"id":"manas-2010:p0232:b001:l007","ordinal":10331,"en":"Unless God knows it openly,"},{"id":"manas-2010:p0232:b001:l008","ordinal":10332,"en":"No one has seen it and returned,"},{"id":"manas-2010:p0232:b001:l009","ordinal":10333,"en":"Half is false and half is true,"},{"id":"manas-2010:p0232:b001:l010","ordinal":10334,"en":"Unless the Creator himself knows,"},{"id":"manas-2010:p0232:b001:l011","ordinal":10335,"en":"No one has returned from their side."},{"id":"manas-2010:p0232:b001:l012","ordinal":10336,"en":"Those renowned lions,"},{"id":"manas-2010:p0232:b001:l013","ordinal":10337,"en":"We have made a tale for entertainment,"},{"id":"manas-2010:p0232:b001:l014","ordinal":10338,"en":"Of the lions who passed long ago,"},{"id":"manas-2010:p0232:b001:l015","ordinal":10339,"en":"To tell you of their ways."},{"id":"manas-2010:p0232:b001:l016","ordinal":10340,"en":"Khan Joloy of the Kalmyks,"},{"id":"manas-2010:p0232:b001:l017","ordinal":10341,"en":"Shook his head in anguish,"},{"id":"manas-2010:p0232:b001:l018","ordinal":10342,"en":"“If he catches us, he will slaughter us,” he said,"},{"id":"manas-2010:p0232:b001:l019","ordinal":10343,"en":"Despairing of precious life,"},{"id":"manas-2010:p0232:b001:l020","ordinal":10344,"en":"“Wearing yellow leather trousers,"},{"id":"manas-2010:p0232:b001:l021","ordinal":10345,"en":"Jakyp's son Manas"},{"id":"manas-2010:p0232:b001:l022","ordinal":10346,"en":"Shows a bearing that brings lamentation,"},{"id":"manas-2010:p0232:b001:l023","ordinal":10347,"en":"One who destroys the enemy without hesitation,"},{"id":"manas-2010:p0232:b001:l024","ordinal":10348,"en":"He shows a champion's bearing,"},{"id":"manas-2010:p0232:b001:l025","ordinal":10349,"en":"The world, like ground grain,"},{"id":"manas-2010:p0232:b001:l026","ordinal":10350,"en":"He seems ready to scatter,"},{"id":"manas-2010:p0232:b001:l027","ordinal":10351,"en":"Not merely us two, giant Kaman,"},{"id":"manas-2010:p0232:b001:l028","ordinal":10352,"en":"Beejin, making it cower,"},{"id":"manas-2010:p0232:b001:l029","ordinal":10353,"en":"He seems ready to seize."},{"id":"manas-2010:p0232:b001:l030","ordinal":10354,"en":"He is a lion with forty chiltens as companions,"},{"id":"manas-2010:p0232:b001:l031","ordinal":10355,"en":"Not merely the Kytay, but Kyrym,"},{"id":"manas-2010:p0232:b001:l032","ordinal":10356,"en":"If in rashness you provoke his wrath,"},{"id":"manas-2010:p0232:b001:l033","ordinal":10357,"en":"He is a lion who would destroy it,"},{"id":"manas-2010:p0232:b001:l034","ordinal":10358,"en":"Can such a being be human?"},{"id":"manas-2010:p0232:b001:l035","ordinal":10359,"en":"Matching strength and facing him,"},{"id":"manas-2010:p0232:b001:l036","ordinal":10360,"en":"Can a man who fights him with spears prosper?"},{"id":"manas-2010:p0232:b001:l037","ordinal":10361,"en":"When one looks at him thus,"},{"id":"manas-2010:p0232:b001:l038","ordinal":10362,"en":"He appears to be a single man,"},{"id":"manas-2010:p0232:b001:l039","ordinal":10363,"en":"When he roars and thrusts his spear,"},{"id":"manas-2010:p0232:b001:l040","ordinal":10364,"en":"He rushes upon you as a thousand men."},{"id":"manas-2010:p0232:b001:l041","ordinal":10365,"en":"If we face him, this blood will spill,"},{"id":"manas-2010:p0232:b001:l042","ordinal":10366,"en":"This damned blood-shedder"},{"id":"manas-2010:p0232:b001:l043","ordinal":10367,"en":"Seems different from mortal men,"},{"id":"manas-2010:p0232:b001:l044","ordinal":10368,"en":"The Burut is no ordinary enemy,"},{"id":"manas-2010:p0232:b001:l045","ordinal":10369,"en":"He is a lion under sacred protection,"},{"id":"manas-2010:p0232:b001:l046","ordinal":10370,"en":"Felling whoever he meets,"},{"id":"manas-2010:p0232:b001:l047","ordinal":10371,"en":"He is one who would trample them down."},{"id":"manas-2010:p0232:b001:l048","ordinal":10372,"en":"That damned blood-shedder,"},{"id":"manas-2010:p0233:b001:l001","ordinal":10373,"en":"Here within Altay,"},{"id":"manas-2010:p0233:b001:l002","ordinal":10374,"en":"That deceiver born unseen,"},{"id":"manas-2010:p0233:b001:l003","ordinal":10375,"en":"Forty chiltens are his companions,"},{"id":"manas-2010:p0233:b001:l004","ordinal":10376,"en":"One chilten, a gray tiger,"},{"id":"manas-2010:p0233:b001:l005","ordinal":10377,"en":"Has gone before him to lead,"},{"id":"manas-2010:p0233:b001:l006","ordinal":10378,"en":"Five men at the very front"},{"id":"manas-2010:p0233:b001:l007","ordinal":10379,"en":"Have scouted his appointed road,"},{"id":"manas-2010:p0233:b001:l008","ordinal":10380,"en":"A black-spotted leopard,"},{"id":"manas-2010:p0233:b001:l009","ordinal":10381,"en":"Raging at his flank,"},{"id":"manas-2010:p0233:b001:l010","ordinal":10382,"en":"Has taken the lead along his road."},{"id":"manas-2010:p0233:b001:l011","ordinal":10383,"en":"The giant black bird Zymyryk,"},{"id":"manas-2010:p0233:b001:l012","ordinal":10384,"en":"As though about to snatch one up,"},{"id":"manas-2010:p0233:b001:l013","ordinal":10385,"en":"As though about to bring one's end,"},{"id":"manas-2010:p0233:b001:l014","ordinal":10386,"en":"Has stretched its sprawling claws from the sky."},{"id":"manas-2010:p0233:b001:l015","ordinal":10387,"en":"Gray-maned Manas the leopard,"},{"id":"manas-2010:p0233:b001:l016","ordinal":10388,"en":"A black serpent sixty fathoms long,"},{"id":"manas-2010:p0233:b001:l017","ordinal":10389,"en":"A dragon, greatest of snakes,"},{"id":"manas-2010:p0233:b001:l018","ordinal":10390,"en":"Hissing from behind,"},{"id":"manas-2010:p0233:b001:l019","ordinal":10391,"en":"Has become his companion."},{"id":"manas-2010:p0233:b001:l020","ordinal":10392,"en":"Its mouth opens like a ravine,"},{"id":"manas-2010:p0233:b001:l021","ordinal":10393,"en":"As though ready to suck one in with its breath,"},{"id":"manas-2010:p0233:b001:l022","ordinal":10394,"en":"Fire sprays from its mouth,"},{"id":"manas-2010:p0233:b001:l023","ordinal":10395,"en":"It goes slithering along."},{"id":"manas-2010:p0233:b001:l024","ordinal":10396,"en":"He has a form unlike mortal men,"},{"id":"manas-2010:p0233:b001:l025","ordinal":10397,"en":"At my flank, Kakanchyn,"},{"id":"manas-2010:p0233:b001:l026","ordinal":10398,"en":"Ulungtu, Dyngsha, Bakburchun,"},{"id":"manas-2010:p0233:b001:l027","ordinal":10399,"en":"Smashing these,"},{"id":"manas-2010:p0233:b001:l028","ordinal":10400,"en":"He seems ready to seize them,"},{"id":"manas-2010:p0233:b001:l029","ordinal":10401,"en":"Upon Chynmachyn, slaughter,"},{"id":"manas-2010:p0233:b001:l030","ordinal":10402,"en":"He seems ready to bring it."},{"id":"manas-2010:p0233:b001:l031","ordinal":10403,"en":"Without dying or perishing here,"},{"id":"manas-2010:p0233:b001:l032","ordinal":10404,"en":"Let us scatter our wealth,"},{"id":"manas-2010:p0233:b001:l033","ordinal":10405,"en":"Let us flee toward Karykan,"},{"id":"manas-2010:p0233:b001:l034","ordinal":10406,"en":"That damned Burut,"},{"id":"manas-2010:p0233:b001:l035","ordinal":10407,"en":"If we grapple, our strength cannot match him,"},{"id":"manas-2010:p0233:b001:l036","ordinal":10408,"en":"If we fight, he will never bow his neck."},{"id":"manas-2010:p0233:b001:l037","ordinal":10409,"en":"If by chance we clash,"},{"id":"manas-2010:p0233:b001:l038","ordinal":10410,"en":"May he not bring misery upon our heads,"},{"id":"manas-2010:p0233:b001:l039","ordinal":10411,"en":"May he not seize us without letting go,"},{"id":"manas-2010:p0233:b001:l040","ordinal":10412,"en":"May he not cut off our heads like sheep's,"},{"id":"manas-2010:p0233:b001:l041","ordinal":10413,"en":"May he not slit our bellies like a mare's,"},{"id":"manas-2010:p0233:b001:l042","ordinal":10414,"en":"Dragging us onto the road,"},{"id":"manas-2010:p0233:b001:l043","ordinal":10415,"en":"May he not split us open for the great dogs."},{"id":"manas-2010:p0233:b001:l044","ordinal":10416,"en":"Smashing us to nothing,"},{"id":"manas-2010:p0233:b001:l045","ordinal":10417,"en":"May he not slaughter us utterly,”"},{"id":"manas-2010:p0233:b001:l046","ordinal":10418,"en":"Thus spoke hero Joloy,"},{"id":"manas-2010:p0233:b001:l047","ordinal":10419,"en":"Raging and working himself up,"},{"id":"manas-2010:p0233:b001:l048","ordinal":10420,"en":"Making ready to flee,"},{"id":"manas-2010:p0234:b001:l001","ordinal":10421,"en":"His collarbone throbbing,"},{"id":"manas-2010:p0234:b001:l002","ordinal":10422,"en":"His shit-filled bowels shaking,"},{"id":"manas-2010:p0234:b001:l003","ordinal":10423,"en":"In true anguish,"},{"id":"manas-2010:p0234:b001:l004","ordinal":10424,"en":"Joloy, champion of the infidels,"},{"id":"manas-2010:p0234:b001:l005","ordinal":10425,"en":"Bending his mind, thinking his thoughts,"},{"id":"manas-2010:p0234:b001:l006","ordinal":10426,"en":"Mighty Joloy fled now,"},{"id":"manas-2010:p0234:b001:l007","ordinal":10427,"en":"From the spur where the mountain ended,"},{"id":"manas-2010:p0234:b001:l008","ordinal":10428,"en":"From the jutting promontory,"},{"id":"manas-2010:p0234:b001:l009","ordinal":10429,"en":"The sight distracted the mind,"},{"id":"manas-2010:p0234:b001:l010","ordinal":10430,"en":"He appeared like an enormous mountain,"},{"id":"manas-2010:p0234:b001:l011","ordinal":10431,"en":"Toruchaar beneath him,"},{"id":"manas-2010:p0234:b001:l012","ordinal":10432,"en":"Lashing with the whip on either side,"},{"id":"manas-2010:p0234:b001:l013","ordinal":10433,"en":"Spurring right and left,"},{"id":"manas-2010:p0234:b001:l014","ordinal":10434,"en":"He turned Toruchaar's head,"},{"id":"manas-2010:p0234:b001:l015","ordinal":10435,"en":"His lacquered spear of sharpened iron,"},{"id":"manas-2010:p0234:b001:l016","ordinal":10436,"en":"He thrust it out with a shout."},{"id":"manas-2010:p0234:b001:l017","ordinal":10437,"en":"Advancing in wrath,"},{"id":"manas-2010:p0234:b001:l018","ordinal":10438,"en":"Toward Joloy who had fled,"},{"id":"manas-2010:p0234:b001:l019","ordinal":10439,"en":"The bloodthirsty lion raised his spear,"},{"id":"manas-2010:p0234:b001:l020","ordinal":10440,"en":"Toruchaar beneath him,"},{"id":"manas-2010:p0234:b001:l021","ordinal":10441,"en":"Short-tailed, solid-hoofed,"},{"id":"manas-2010:p0234:b001:l022","ordinal":10442,"en":"Iron-hoofed, copper-limbed,"},{"id":"manas-2010:p0234:b001:l023","ordinal":10443,"en":"At the sound of clamor he broke away,"},{"id":"manas-2010:p0234:b001:l024","ordinal":10444,"en":"Showing the mettle of a tulpar,"},{"id":"manas-2010:p0234:b001:l025","ordinal":10445,"en":"At each bound, the black earth"},{"id":"manas-2010:p0234:b001:l026","ordinal":10446,"en":"Parted layer by layer,"},{"id":"manas-2010:p0234:b001:l027","ordinal":10447,"en":"As your tulpar ran,"},{"id":"manas-2010:p0234:b001:l028","ordinal":10448,"en":"Showing the mettle of a swift steed,"},{"id":"manas-2010:p0234:b001:l029","ordinal":10449,"en":"His mouth gaped like a cavern,"},{"id":"manas-2010:p0234:b001:l030","ordinal":10450,"en":"White foam mingled with blood"},{"id":"manas-2010:p0234:b001:l031","ordinal":10451,"en":"Spattered over his breast,"},{"id":"manas-2010:p0234:b001:l032","ordinal":10452,"en":"The black stones he trod upon"},{"id":"manas-2010:p0234:b001:l033","ordinal":10453,"en":"Burst into powder,"},{"id":"manas-2010:p0234:b001:l034","ordinal":10454,"en":"Rumbling like a small travel tent,"},{"id":"manas-2010:p0234:b001:l035","ordinal":10455,"en":"Of tiger Manas the gray-maned,"},{"id":"manas-2010:p0234:b001:l036","ordinal":10456,"en":"Rumbling over his head,"},{"id":"manas-2010:p0234:b001:l037","ordinal":10457,"en":"Toruchaar, tulpar above all others,"},{"id":"manas-2010:p0234:b001:l038","ordinal":10458,"en":"Lowered his head to the earth,"},{"id":"manas-2010:p0234:b001:l039","ordinal":10459,"en":"Lengthening his stride."},{"id":"manas-2010:p0234:b001:l040","ordinal":10460,"en":"His flesh grew hot and he grew wild,"},{"id":"manas-2010:p0234:b001:l041","ordinal":10461,"en":"Laying back his boat-like ears,"},{"id":"manas-2010:p0234:b001:l042","ordinal":10462,"en":"Sweeping the earth like a whirlwind,"},{"id":"manas-2010:p0234:b001:l043","ordinal":10463,"en":"Running without pause, lengthening his stride,"},{"id":"manas-2010:p0234:b001:l044","ordinal":10464,"en":"Showing the mettle of a tulpar,"},{"id":"manas-2010:p0234:b001:l045","ordinal":10465,"en":"If you looked at his muscles,"},{"id":"manas-2010:p0234:b001:l046","ordinal":10466,"en":"They seemed like small travel tents,"},{"id":"manas-2010:p0234:b001:l047","ordinal":10467,"en":"His back stretched straight like a hare's,"},{"id":"manas-2010:p0234:b001:l048","ordinal":10468,"en":"His mouth gaped like a cavern,"},{"id":"manas-2010:p0235:b001:l001","ordinal":10469,"en":"His contracted hooves"},{"id":"manas-2010:p0235:b001:l002","ordinal":10470,"en":"Spread like small travel tents,"},{"id":"manas-2010:p0235:b001:l003","ordinal":10471,"en":"Trailing dust like a mountain,"},{"id":"manas-2010:p0235:b001:l004","ordinal":10472,"en":"Joloy of the Kalmyks,"},{"id":"manas-2010:p0235:b001:l005","ordinal":10473,"en":"Around the spur where the mountain ended,"},{"id":"manas-2010:p0235:b001:l006","ordinal":10474,"en":"The promontory of the swelling mountain,"},{"id":"manas-2010:p0235:b001:l007","ordinal":10475,"en":"The level ground at the forked ridge,"},{"id":"manas-2010:p0235:b001:l008","ordinal":10476,"en":"Magnanimous Manas the leopard"},{"id":"manas-2010:p0235:b001:l009","ordinal":10477,"en":"Chased him six times around,"},{"id":"manas-2010:p0235:b001:l010","ordinal":10478,"en":"Around a lone sloping hillock,"},{"id":"manas-2010:p0235:b001:l011","ordinal":10479,"en":"The accomplished, magnanimous Khan Manas"},{"id":"manas-2010:p0235:b001:l012","ordinal":10480,"en":"Chased him seven times around now."},{"id":"manas-2010:p0235:b001:l013","ordinal":10481,"en":"Across the level, rolling slope,"},{"id":"manas-2010:p0235:b001:l014","ordinal":10482,"en":"Manas went on,"},{"id":"manas-2010:p0235:b001:l015","ordinal":10483,"en":"Over rough, stony ground,"},{"id":"manas-2010:p0235:b001:l016","ordinal":10484,"en":"Joloy went fleeing,"},{"id":"manas-2010:p0235:b001:l017","ordinal":10485,"en":"Circling the knolls,"},{"id":"manas-2010:p0235:b001:l018","ordinal":10486,"en":"Driving him in pursuit into a hollow,"},{"id":"manas-2010:p0235:b001:l019","ordinal":10487,"en":"When they entered a descent,"},{"id":"manas-2010:p0235:b001:l020","ordinal":10488,"en":"Great Joloy's Achbuudan"},{"id":"manas-2010:p0235:b001:l021","ordinal":10489,"en":"Planted his forelegs like a roe deer,"},{"id":"manas-2010:p0235:b001:l022","ordinal":10490,"en":"When they began to climb,"},{"id":"manas-2010:p0235:b001:l023","ordinal":10491,"en":"Your blood-shedder's Toruchaar,"},{"id":"manas-2010:p0235:b001:l024","ordinal":10492,"en":"His mane and tail streaming,"},{"id":"manas-2010:p0235:b001:l025","ordinal":10493,"en":"When they reached rough ground,"},{"id":"manas-2010:p0235:b001:l026","ordinal":10494,"en":"Hero Joloy's Achbuudan,"},{"id":"manas-2010:p0235:b001:l027","ordinal":10495,"en":"His neck heaved like a bull's,"},{"id":"manas-2010:p0235:b001:l028","ordinal":10496,"en":"When they came to a turn,"}]
