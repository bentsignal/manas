[{"id":"semetey-1-2013:p0798:b003:l003","ordinal":137985,"en":"He fastened its ties."},{"id":"semetey-1-2013:p0798:b003:l004","ordinal":137986,"en":"Rejoicing, ‘O God!’"},{"id":"semetey-1-2013:p0798:b003:l005","ordinal":137987,"en":"He put on Akolpok."},{"id":"semetey-1-2013:p0798:b003:l006","ordinal":137988,"en":"The gray belt-pouch left by Manas"},{"id":"semetey-1-2013:p0798:b003:l007","ordinal":137989,"en":"He girded and fastened at his waist."},{"id":"semetey-1-2013:p0798:b003:l008","ordinal":137990,"en":"The young lord, the leopard,"},{"id":"semetey-1-2013:p0798:b003:l009","ordinal":137991,"en":"His father who had died long ago—"},{"id":"semetey-1-2013:p0798:b003:l010","ordinal":137992,"en":"He had become like Manas."},{"id":"semetey-1-2013:p0798:b003:l011","ordinal":137993,"en":"Zulpukor, left by his father Manas,"},{"id":"semetey-1-2013:p0798:b003:l012","ordinal":137994,"en":"The precious lion's son,"},{"id":"semetey-1-2013:p0798:b003:l013","ordinal":137995,"en":"Rejoicing under Khyzyr's blessing,"},{"id":"semetey-1-2013:p0798:b003:l014","ordinal":137996,"en":"Dressed in his father Manas's likeness,"},{"id":"semetey-1-2013:p0798:b003:l015","ordinal":137997,"en":"The inherited Zulpukor"},{"id":"semetey-1-2013:p0798:b003:l016","ordinal":137998,"en":"He hung upon his left side."},{"id":"semetey-1-2013:p0798:b003:l017","ordinal":137999,"en":"Seized the blood-drinking sword Zulpukor"},{"id":"semetey-1-2013:p0798:b003:l018","ordinal":138000,"en":"He swore many oaths:"},{"id":"semetey-1-2013:p0798:b003:l019","ordinal":138001,"en":"‘Zulpukor, left by the bloodthirsty hero,"},{"id":"semetey-1-2013:p0798:b003:l020","ordinal":138002,"en":"If I flee an enemy I face,"},{"id":"semetey-1-2013:p0798:b003:l021","ordinal":138003,"en":"May God strike me down!"},{"id":"semetey-1-2013:p0798:b003:l022","ordinal":138004,"en":"If you slip from where I strike,"},{"id":"semetey-1-2013:p0798:b003:l023","ordinal":138005,"en":"May God strike you down!"},{"id":"semetey-1-2013:p0798:b003:l024","ordinal":138006,"en":"I shall spread your fame among the people."},{"id":"semetey-1-2013:p0798:b003:l025","ordinal":138007,"en":"When you meet the enemy in combat,"},{"id":"semetey-1-2013:p0798:b003:l026","ordinal":138008,"en":"I shall drench you in red blood!’"},{"id":"semetey-1-2013:p0798:b003:l027","ordinal":138009,"en":"He hung his sword in its place."},{"id":"semetey-1-2013:p0798:b003:l028","ordinal":138010,"en":"A mirror upon the shoulder when slung,"},{"id":"semetey-1-2013:p0798:b003:l029","ordinal":138011,"en":"When turned against a fighting enemy,"},{"id":"semetey-1-2013:p0798:b003:l030","ordinal":138012,"en":"The comfort of this mortal life,"},{"id":"semetey-1-2013:p0798:b003:l031","ordinal":138013,"en":"It was a possession left by his father Manas."},{"id":"semetey-1-2013:p0798:b003:l032","ordinal":138014,"en":"His father's Akkelte"},{"id":"semetey-1-2013:p0798:b003:l033","ordinal":138015,"en":"He hung upon his shoulder."},{"id":"semetey-1-2013:p0798:b003:l034","ordinal":138016,"en":"Hurrying in haste, Semetey"},{"id":"semetey-1-2013:p0798:b003:l035","ordinal":138017,"en":"Now set off toward Bukhara."},{"id":"semetey-1-2013:p0798:b003:l036","ordinal":138018,"en":"When your orphan had received all these,"},{"id":"semetey-1-2013:p0798:b003:l037","ordinal":138019,"en":"He shone in all his beauty."},{"id":"semetey-1-2013:p0798:b003:l038","ordinal":138020,"en":"The fierce hero's Akshumkar, big as a leather pail,"},{"id":"semetey-1-2013:p0798:b004:l001","ordinal":138021,"en":"Gleamed upon his right hand."},{"id":"semetey-1-2013:p0798:b004:l002","ordinal":138022,"en":"The sight of him moved the heart;"},{"id":"semetey-1-2013:p0798:b004:l003","ordinal":138023,"en":"The young son of Manas"},{"id":"semetey-1-2013:p0798:b004:l004","ordinal":138024,"en":"Showed his warrior's bearing."},{"id":"semetey-1-2013:p0798:b004:l005","ordinal":138025,"en":"Kumaik, left by Manas,"},{"id":"semetey-1-2013:p0798:b004:l006","ordinal":138026,"en":"Could be seen a day's journey ahead."},{"id":"semetey-1-2013:p0798:b004:l007","ordinal":138027,"en":"Against the orphan, Manas's son,"},{"id":"semetey-1-2013:p0798:b004:l008","ordinal":138028,"en":"None could stand in a shooting fight;"},{"id":"semetey-1-2013:p0798:b004:l009","ordinal":138029,"en":"No man could look upon his face."},{"id":"semetey-1-2013:p0798:b004:l010","ordinal":138030,"en":"Against the orphan's strength"},{"id":"semetey-1-2013:p0798:b004:l011","ordinal":138031,"en":"No mountain could withstand him."},{"id":"semetey-1-2013:p0798:b004:l012","ordinal":138032,"en":"With trust in fate, if Allah helped him,"},{"id":"semetey-1-2013:p0798:b004:l013","ordinal":138033,"en":"Though the Chinese came in throngs,"},{"id":"semetey-1-2013:p0798:b004:l014","ordinal":138034,"en":"No man could look upon his face."},{"id":"semetey-1-2013:p0798:b004:l015","ordinal":138035,"en":"None could endure the boy's fury;"},{"id":"semetey-1-2013:p0798:b004:l016","ordinal":138036,"en":"No charging foe could approach him."},{"id":"semetey-1-2013:p0798:b004:l017","ordinal":138037,"en":"The sight of him moved the heart."},{"id":"semetey-1-2013:p0798:b004:l018","ordinal":138038,"en":"All twelve parts of his body were in harmony;"},{"id":"semetey-1-2013:p0798:b004:l019","ordinal":138039,"en":"He appeared like Manas."},{"id":"semetey-1-2013:p0798:b004:l020","ordinal":138040,"en":"As great as a mountain,"},{"id":"semetey-1-2013:p0798:b004:l021","ordinal":138041,"en":"Your orphan, Manas's son,"},{"id":"semetey-1-2013:p0798:b004:l022","ordinal":138042,"en":"Everyone who faced him,"},{"id":"semetey-1-2013:p0798:b004:l023","ordinal":138043,"en":"He seemed able to chew up and eat alive."},{"id":"semetey-1-2013:p0798:b004:l024","ordinal":138044,"en":"Battle-axe and spear stood out;"},{"id":"semetey-1-2013:p0798:b004:l025","ordinal":138045,"en":"He urged his horse toward Bukhara,"},{"id":"semetey-1-2013:p0798:b004:l026","ordinal":138046,"en":"Your orphan, the son of Manas,"},{"id":"semetey-1-2013:p0798:b004:l027","ordinal":138047,"en":"Appearing like a lion."},{"id":"semetey-1-2013:p0798:b004:l028","ordinal":138048,"en":"He crossed ridge after ridge,"},{"id":"semetey-1-2013:p0798:b004:l029","ordinal":138049,"en":"Passed over knolls and hollows,"},{"id":"semetey-1-2013:p0798:b004:l030","ordinal":138050,"en":"Crossed hill after hill,"},{"id":"semetey-1-2013:p0798:b004:l031","ordinal":138051,"en":"Traveled the rugged passes."},{"id":"semetey-1-2013:p0798:b004:l032","ordinal":138052,"en":"He traversed steep, deep ravines;"},{"id":"semetey-1-2013:p0798:b004:l033","ordinal":138053,"en":"The leopard, Manas's son,"},{"id":"semetey-1-2013:p0798:b004:l034","ordinal":138054,"en":"Crossed the rounded mountain heights,"},{"id":"semetey-1-2013:p0798:b004:l035","ordinal":138055,"en":"Around the hillock-strewn passes,"},{"id":"semetey-1-2013:p0798:b004:l036","ordinal":138056,"en":"Winding on with determination,"},{"id":"semetey-1-2013:p0798:b004:l037","ordinal":138057,"en":"To the spur of the mountain's end,"},{"id":"semetey-1-2013:p0798:b004:l038","ordinal":138058,"en":"To the jutting headland,"},{"id":"semetey-1-2013:p0798:b004:l039","ordinal":138059,"en":"He had just come and gained a footing,"},{"id":"semetey-1-2013:p0799:b003:l001","ordinal":138060,"en":"Aktulpar, whom he had been leading,"},{"id":"semetey-1-2013:p0799:b003:l002","ordinal":138061,"en":"Your accomplished young lord"},{"id":"semetey-1-2013:p0799:b003:l003","ordinal":138062,"en":"Loosed and drove ahead,"},{"id":"semetey-1-2013:p0799:b003:l004","ordinal":138063,"en":"Drove hard without giving him rest."},{"id":"semetey-1-2013:p0799:b003:l005","ordinal":138064,"en":"The horse Buurul beneath him,"},{"id":"semetey-1-2013:p0799:b003:l006","ordinal":138065,"en":"At ‘Go!’ pulled free of his hand."},{"id":"semetey-1-2013:p0799:b003:l007","ordinal":138066,"en":"When ridge after ridge appeared,"},{"id":"semetey-1-2013:p0799:b003:l008","ordinal":138067,"en":"Do not ask how the hero fared!"},{"id":"semetey-1-2013:p0799:b003:l009","ordinal":138068,"en":"When pits and mounds appeared,"},{"id":"semetey-1-2013:p0799:b003:l010","ordinal":138069,"en":"Let me tell you of his horse:"},{"id":"semetey-1-2013:p0799:b003:l011","ordinal":138070,"en":"His back bent like a trap;"},{"id":"semetey-1-2013:p0799:b003:l012","ordinal":138071,"en":"When a chasm as wide as a ravine appeared,"},{"id":"semetey-1-2013:p0799:b003:l013","ordinal":138072,"en":"He sprang across without catching, gathering himself."},{"id":"semetey-1-2013:p0799:b003:l014","ordinal":138073,"en":"‘Truly, he is a swift steed!’"},{"id":"semetey-1-2013:p0799:b003:l015","ordinal":138074,"en":"The brave orphan, Manas's son,"},{"id":"semetey-1-2013:p0799:b003:l016","ordinal":138075,"en":"Rejoiced in delight."},{"id":"semetey-1-2013:p0799:b003:l017","ordinal":138076,"en":"Then the boy thought:"},{"id":"semetey-1-2013:p0799:b003:l018","ordinal":138077,"en":"‘Today I have mounted him for the first time."},{"id":"semetey-1-2013:p0799:b003:l019","ordinal":138078,"en":"This creature, the horse Buurul,"},{"id":"semetey-1-2013:p0799:b003:l020","ordinal":138079,"en":"Is truly a noble steed."},{"id":"semetey-1-2013:p0799:b003:l021","ordinal":138080,"en":"Today his noble nature has been revealed."},{"id":"semetey-1-2013:p0799:b003:l022","ordinal":138081,"en":"The dark earth his hooves strike"},{"id":"semetey-1-2013:p0799:b003:l023","ordinal":138082,"en":"Splits apart on every side."},{"id":"semetey-1-2013:p0799:b003:l024","ordinal":138083,"en":"If he travels a full six months,"},{"id":"semetey-1-2013:p0799:b003:l025","ordinal":138084,"en":"His noble nature will show.’"},{"id":"semetey-1-2013:p0799:b003:l026","ordinal":138085,"en":"When Semetey looked alongside,"},{"id":"semetey-1-2013:p0799:b003:l027","ordinal":138086,"en":"Where the hoof struck squarely,"},{"id":"semetey-1-2013:p0799:b003:l028","ordinal":138087,"en":"A hollow opened like a hearth pit."},{"id":"semetey-1-2013:p0799:b003:l029","ordinal":138088,"en":"Where the hoof scraped in passing,"},{"id":"semetey-1-2013:p0799:b003:l030","ordinal":138089,"en":"A mark was gouged and cut."},{"id":"semetey-1-2013:p0799:b003:l031","ordinal":138090,"en":"The ground where the creature stepped flew apart."},{"id":"semetey-1-2013:p0799:b003:l033","ordinal":138091,"en":"Clods as large as cauldrons"},{"id":"semetey-1-2013:p0799:b003:l034","ordinal":138092,"en":"Whistled above your lord's head,"},{"id":"semetey-1-2013:p0799:b003:l035","ordinal":138093,"en":"Racing against flying birds."},{"id":"semetey-1-2013:p0799:b003:l036","ordinal":138094,"en":"He traveled far upon his journey,"},{"id":"semetey-1-2013:p0799:b003:l037","ordinal":138095,"en":"Covered much ground, sparing no horse."},{"id":"semetey-1-2013:p0799:b003:l038","ordinal":138096,"en":"The white reins plaited in rounded knots"},{"id":"semetey-1-2013:p0799:b003:l039","ordinal":138097,"en":"He gripped tightly with both hands,"},{"id":"semetey-1-2013:p0799:b004:l001","ordinal":138098,"en":"Making him strain as though a husband had died,"},{"id":"semetey-1-2013:p0799:b004:l002","ordinal":138099,"en":"Struggling against the steed's mouth."},{"id":"semetey-1-2013:p0799:b004:l003","ordinal":138100,"en":"He traveled toward Bukhara,"},{"id":"semetey-1-2013:p0799:b004:l004","ordinal":138101,"en":"Covered much ground, sparing no horse."},{"id":"semetey-1-2013:p0799:b004:l005","ordinal":138102,"en":"Wide Ak-Chii of great Bukhara—"},{"id":"semetey-1-2013:p0799:b004:l006","ordinal":138103,"en":"That was Khan Temir's land."},{"id":"semetey-1-2013:p0799:b004:l007","ordinal":138104,"en":"For a noble steed traveling without rest,"},{"id":"semetey-1-2013:p0799:b004:l008","ordinal":138105,"en":"It was a journey of six days."},{"id":"semetey-1-2013:p0799:b004:l009","ordinal":138106,"en":"When he reached Ak-Chii,"},{"id":"semetey-1-2013:p0799:b004:l010","ordinal":138107,"en":"He sent ringing through the forest."},{"id":"semetey-1-2013:p0799:b004:l011","ordinal":138108,"en":"He had traveled without sparing him,"},{"id":"semetey-1-2013:p0799:b004:l012","ordinal":138109,"en":"Running swiftly with a thunderous rush."},{"id":"semetey-1-2013:p0799:b004:l013","ordinal":138110,"en":"Dark mud and flowing sweat"},{"id":"semetey-1-2013:p0799:b004:l014","ordinal":138111,"en":"Streamed down below the stirrup."},{"id":"semetey-1-2013:p0799:b004:l015","ordinal":138112,"en":"The horse Buurul beneath him"},{"id":"semetey-1-2013:p0799:b004:l016","ordinal":138113,"en":"Sped ever faster as he went,"},{"id":"semetey-1-2013:p0799:b004:l017","ordinal":138114,"en":"His strength kept growing."},{"id":"semetey-1-2013:p0799:b004:l018","ordinal":138115,"en":"Khan Temir's Aktulpar,"},{"id":"semetey-1-2013:p0799:b004:l019","ordinal":138116,"en":"As though stricken with a twisting sickness,"},{"id":"semetey-1-2013:p0799:b004:l020","ordinal":138117,"en":"The creature staggered."},{"id":"semetey-1-2013:p0799:b004:l021","ordinal":138118,"en":"Your boy's horse Buurul—"},{"id":"semetey-1-2013:p0799:b004:l022","ordinal":138119,"en":"No beast could match his walk,"},{"id":"semetey-1-2013:p0799:b004:l023","ordinal":138120,"en":"No wind could match his trot."},{"id":"semetey-1-2013:p0799:b004:l024","ordinal":138121,"en":"He rushed like a cloud,"},{"id":"semetey-1-2013:p0799:b004:l025","ordinal":138122,"en":"Roared more fiercely than the wind,"},{"id":"semetey-1-2013:p0799:b004:l026","ordinal":138123,"en":"Tossed his forelock toward the sky."},{"id":"semetey-1-2013:p0799:b004:l027","ordinal":138124,"en":"As the horse Buurul went onward,"},{"id":"semetey-1-2013:p0799:b004:l028","ordinal":138125,"en":"He plunged his hooves into the ground."},{"id":"semetey-1-2013:p0799:b004:l029","ordinal":138126,"en":"Where he stepped, the dark stones"},{"id":"semetey-1-2013:p0799:b004:l030","ordinal":138127,"en":"Scattered like ground meal."},{"id":"semetey-1-2013:p0799:b004:l031","ordinal":138128,"en":"Khan Temir's Aktulpar"},{"id":"semetey-1-2013:p0799:b004:l032","ordinal":138129,"en":"That day could not match Buurul:"},{"id":"semetey-1-2013:p0799:b004:l033","ordinal":138130,"en":"His walk could not match his walk,"},{"id":"semetey-1-2013:p0799:b004:l034","ordinal":138131,"en":"His trot could not match his trot."},{"id":"semetey-1-2013:p0799:b004:l035","ordinal":138132,"en":"Aktulpar was left behind."},{"id":"semetey-1-2013:p0799:b004:l036","ordinal":138133,"en":"When Aktulpar could go no farther,"},{"id":"semetey-1-2013:p0799:b004:l037","ordinal":138134,"en":"And seized the bridle"},{"id":"semetey-1-2013:p0799:b004:l038","ordinal":138135,"en":"He firmly drew in his reins."},{"id":"semetey-1-2013:p0799:b004:l039","ordinal":138136,"en":"When he came into view,"},{"id":"semetey-1-2013:p0800:b003:l001","ordinal":138137,"en":"When unseen, he became drifting blue smoke,"},{"id":"semetey-1-2013:p0800:b003:l002","ordinal":138138,"en":"Rushing as though he would fly."},{"id":"semetey-1-2013:p0800:b003:l003","ordinal":138139,"en":"So went the horse Buurul."},{"id":"semetey-1-2013:p0800:b003:l004","ordinal":138140,"en":"If your orphan, Manas's son,"},{"id":"semetey-1-2013:p0800:b003:l005","ordinal":138141,"en":"Did not arrive that day,"},{"id":"semetey-1-2013:p0800:b003:l006","ordinal":138142,"en":"The anguish of the Day of Judgment"},{"id":"semetey-1-2013:p0800:b003:l007","ordinal":138143,"en":"He would have to face."},{"id":"semetey-1-2013:p0800:b003:l008","ordinal":138144,"en":"The thirty days were exactly up;"},{"id":"semetey-1-2013:p0800:b003:l009","ordinal":138145,"en":"Your mighty mother Chiyyrdy"},{"id":"semetey-1-2013:p0800:b003:l010","ordinal":138146,"en":"Was about to die."},{"id":"semetey-1-2013:p0800:b003:l011","ordinal":138147,"en":"Taking no food, eating nothing,"},{"id":"semetey-1-2013:p0800:b003:l012","ordinal":138148,"en":"She had brought this torment upon them."},{"id":"semetey-1-2013:p0800:b003:l013","ordinal":138149,"en":"‘When will my orphan come?’"},{"id":"semetey-1-2013:p0800:b003:l014","ordinal":138150,"en":"She lay there wailing."},{"id":"semetey-1-2013:p0800:b003:l015","ordinal":138151,"en":"‘God will grant us the orphan;"},{"id":"semetey-1-2013:p0800:b003:l016","ordinal":138152,"en":"If he is alive, he will come,’"},{"id":"semetey-1-2013:p0800:b003:l017","ordinal":138153,"en":"Your dear mother Kanykei said,"},{"id":"semetey-1-2013:p0800:b003:l018","ordinal":138154,"en":"Enduring this anguish."},{"id":"semetey-1-2013:p0800:b003:l019","ordinal":138155,"en":"The bowed old woman Chiyyrdy"},{"id":"semetey-1-2013:p0800:b003:l020","ordinal":138156,"en":"Had reached ninety-five years."},{"id":"semetey-1-2013:p0800:b003:l021","ordinal":138157,"en":"Sorrowful Kanykei,"},{"id":"semetey-1-2013:p0800:b003:l022","ordinal":138158,"en":"Your dear, unfortunate sister-in-law,"},{"id":"semetey-1-2013:p0800:b003:l023","ordinal":138159,"en":"Had only to look at old Chiyyrdy"},{"id":"semetey-1-2013:p0800:b003:l024","ordinal":138160,"en":"For her hunger to be satisfied."},{"id":"semetey-1-2013:p0800:b003:l025","ordinal":138161,"en":"The support left by her Khan Manas—"},{"id":"semetey-1-2013:p0800:b003:l026","ordinal":138162,"en":"The sight of her satisfied her hunger;"},{"id":"semetey-1-2013:p0800:b003:l027","ordinal":138163,"en":"She had no one else like her."},{"id":"semetey-1-2013:p0800:b003:l028","ordinal":138164,"en":"When upon Beijing an uproar"},{"id":"semetey-1-2013:p0800:b003:l029","ordinal":138165,"en":"Did indeed inflict."},{"id":"semetey-1-2013:p0800:b003:l030","ordinal":138166,"en":"‘Let her be my refuge,’ she said."},{"id":"semetey-1-2013:p0800:b003:l031","ordinal":138167,"en":"Your poor sister-in-law Kanykei"},{"id":"semetey-1-2013:p0800:b003:l032","ordinal":138168,"en":"Had set her upon her shoulders"},{"id":"semetey-1-2013:p0800:b003:l033","ordinal":138169,"en":"And brought her away."},{"id":"semetey-1-2013:p0800:b003:l034","ordinal":138170,"en":"Then Chiyyrdy,"},{"id":"semetey-1-2013:p0800:b003:l035","ordinal":138171,"en":"Saying, ‘The orphan has gone to his people,’"},{"id":"semetey-1-2013:p0800:b003:l036","ordinal":138172,"en":"Was torn with worry."},{"id":"semetey-1-2013:p0800:b003:l037","ordinal":138173,"en":"Tears poured from her eyes,"},{"id":"semetey-1-2013:p0800:b003:l038","ordinal":138174,"en":"Both her eyes festered,"},{"id":"semetey-1-2013:p0800:b003:l039","ordinal":138175,"en":"Her whole body trembled."},{"id":"semetey-1-2013:p0800:b004:l001","ordinal":138176,"en":"Not in the grave, if one called her dead,"},{"id":"semetey-1-2013:p0800:b004:l002","ordinal":138177,"en":"The elder of ninety-five"},{"id":"semetey-1-2013:p0800:b004:l003","ordinal":138178,"en":"Lay huddled there."},{"id":"semetey-1-2013:p0800:b004:l004","ordinal":138179,"en":"Unable to rise, the old lady"},{"id":"semetey-1-2013:p0800:b004:l005","ordinal":138180,"en":"Had sunk down."},{"id":"semetey-1-2013:p0800:b004:l006","ordinal":138181,"en":"If that Semetey did not come,"},{"id":"semetey-1-2013:p0800:b004:l007","ordinal":138182,"en":"‘Why should I go on living"},{"id":"semetey-1-2013:p0800:b004:l008","ordinal":138183,"en":"In this world?’ she said."},{"id":"semetey-1-2013:p0800:b004:l009","ordinal":138184,"en":"Stubbornly, she resolved"},{"id":"semetey-1-2013:p0800:b004:l010","ordinal":138185,"en":"To endure hunger."},{"id":"semetey-1-2013:p0800:b004:l011","ordinal":138186,"en":"From this false world"},{"id":"semetey-1-2013:p0800:b004:l012","ordinal":138187,"en":"She resolved to die."},{"id":"semetey-1-2013:p0800:b004:l013","ordinal":138188,"en":"‘When will the orphan come?"},{"id":"semetey-1-2013:p0800:b004:l014","ordinal":138189,"en":"When will I see his face?’ she said."},{"id":"semetey-1-2013:p0800:b004:l015","ordinal":138190,"en":"Refusing to listen, hunched over,"},{"id":"semetey-1-2013:p0800:b004:l016","ordinal":138191,"en":"She lay huddled there."},{"id":"semetey-1-2013:p0800:b004:l017","ordinal":138192,"en":"‘When will the orphan come?’ she said,"},{"id":"semetey-1-2013:p0800:b004:l018","ordinal":138193,"en":"And sank down."},{"id":"semetey-1-2013:p0800:b004:l019","ordinal":138194,"en":"While her mother lay bowed down,"},{"id":"semetey-1-2013:p0800:b004:l020","ordinal":138195,"en":"While she brought this torment,"},{"id":"semetey-1-2013:p0800:b004:l021","ordinal":138196,"en":"Your dear sister-in-law Kanykei,"},{"id":"semetey-1-2013:p0800:b004:l022","ordinal":138197,"en":"Her knees bending to the ground,"},{"id":"semetey-1-2013:p0800:b004:l023","ordinal":138198,"en":"Into Khan Temir’s tower"},{"id":"semetey-1-2013:p0800:b004:l024","ordinal":138199,"en":"She ran and climbed."},{"id":"semetey-1-2013:p0800:b004:l025","ordinal":138200,"en":"Kanykei hoped"},{"id":"semetey-1-2013:p0800:b004:l026","ordinal":138201,"en":"To climb up and see her orphan,"},{"id":"semetey-1-2013:p0800:b004:l027","ordinal":138202,"en":"And, if she saw him, give the news"},{"id":"semetey-1-2013:p0800:b004:l028","ordinal":138203,"en":"To Chiyyrdy."},{"id":"semetey-1-2013:p0800:b004:l029","ordinal":138204,"en":"Your dear mother Kanykei"},{"id":"semetey-1-2013:p0800:b004:l030","ordinal":138205,"en":"Did he not bring"},{"id":"semetey-1-2013:p0800:b004:l031","ordinal":138206,"en":"Did indeed inflict."},{"id":"semetey-1-2013:p0800:b004:l032","ordinal":138207,"en":"Khan Manas's great spyglass,"},{"id":"semetey-1-2013:p0800:b004:l033","ordinal":138208,"en":"Your valiant sister-in-law Kanykei"},{"id":"semetey-1-2013:p0800:b004:l034","ordinal":138209,"en":"Had hidden in the fold of her overskirt,"},{"id":"semetey-1-2013:p0800:b004:l035","ordinal":138210,"en":"Secured it firmly in her care,"},{"id":"semetey-1-2013:p0800:b004:l036","ordinal":138211,"en":"And brought it away."},{"id":"semetey-1-2013:p0800:b004:l037","ordinal":138212,"en":"She bound it again and fastened it close,"},{"id":"semetey-1-2013:p0800:b004:l038","ordinal":138213,"en":"Entrusted it to a place none knew,"},{"id":"semetey-1-2013:p0800:b004:l039","ordinal":138214,"en":"Weeping bitterly to the one God,"},{"id":"semetey-1-2013:p0801:b003:l001","ordinal":138215,"en":"Dedicating it to her dear Semetey."},{"id":"semetey-1-2013:p0801:b003:l002","ordinal":138216,"en":"Unable to keep still in her haste,"},{"id":"semetey-1-2013:p0801:b003:l003","ordinal":138217,"en":"Terribly afraid of the boy,"},{"id":"semetey-1-2013:p0801:b003:l004","ordinal":138218,"en":"Without taking its strap from her neck,"},{"id":"semetey-1-2013:p0801:b003:l005","ordinal":138219,"en":"The telescope of unmeasured range"},{"id":"semetey-1-2013:p0801:b003:l006","ordinal":138220,"en":"She drew out from her bosom."},{"id":"semetey-1-2013:p0801:b003:l007","ordinal":138221,"en":"Turning its ring,"},{"id":"semetey-1-2013:p0801:b003:l008","ordinal":138222,"en":"Bringing it right to her eye,"},{"id":"semetey-1-2013:p0801:b003:l009","ordinal":138223,"en":"She looked through the telescope."},{"id":"semetey-1-2013:p0801:b003:l010","ordinal":138224,"en":"It seemed that Allah Almighty, the one God,"},{"id":"semetey-1-2013:p0801:b003:l011","ordinal":138225,"en":"Had granted her wish;"},{"id":"semetey-1-2013:p0801:b003:l012","ordinal":138226,"en":"Her only son, who had gone to his people,"},{"id":"semetey-1-2013:p0801:b003:l013","ordinal":138227,"en":"Seemed to have returned!"},{"id":"semetey-1-2013:p0801:b003:l014","ordinal":138228,"en":"When she looked in front of him,"},{"id":"semetey-1-2013:p0801:b003:l015","ordinal":138229,"en":"Never flinching from a tiger,"},{"id":"semetey-1-2013:p0801:b003:l016","ordinal":138230,"en":"Never turning back from a bear,"},{"id":"semetey-1-2013:p0801:b003:l017","ordinal":138231,"en":"Making the one who loosed him laugh,"},{"id":"semetey-1-2013:p0801:b003:l018","ordinal":138232,"en":"Destroying whatever he bit,"},{"id":"semetey-1-2013:p0801:b003:l019","ordinal":138233,"en":"Tended when he was little,"},{"id":"semetey-1-2013:p0801:b003:l020","ordinal":138234,"en":"Kept when he was a puppy,"},{"id":"semetey-1-2013:p0801:b003:l021","ordinal":138235,"en":"With a collar put around his neck,"},{"id":"semetey-1-2013:p0801:b003:l022","ordinal":138236,"en":"Fed at the treasury's expense,"},{"id":"semetey-1-2013:p0801:b003:l023","ordinal":138237,"en":"“Would that he were my dog!”"},{"id":"semetey-1-2013:p0801:b003:l024","ordinal":138238,"en":"So all who saw him wished."},{"id":"semetey-1-2013:p0801:b003:l025","ordinal":138239,"en":"That Kumaiyk who had strayed away—"},{"id":"semetey-1-2013:p0801:b003:l026","ordinal":138240,"en":"“He was like my firstborn son;"}]
