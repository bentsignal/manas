[{"id":"seytek-2012:p0923:b004:l004","ordinal":367617,"en":"My two eyes have become four with watching."},{"id":"seytek-2012:p0923:b004:l005","ordinal":367618,"en":"If my frail soul may rejoice,"},{"id":"seytek-2012:p0923:b004:l006","ordinal":367619,"en":"My warrior heart pounds;"},{"id":"seytek-2012:p0923:b004:l007","ordinal":367620,"en":"Oh, joyful hour!"},{"id":"seytek-2012:p0923:b004:l008","ordinal":367621,"en":"Sarybai, whom I have sought,"},{"id":"seytek-2012:p0923:b004:l009","ordinal":367622,"en":"Has appeared before my face."},{"id":"seytek-2012:p0923:b004:l010","ordinal":367623,"en":"What was broken in me is restored;"},{"id":"seytek-2012:p0923:b004:l011","ordinal":367624,"en":"Thus my soul rejoices."},{"id":"seytek-2012:p0923:b004:l012","ordinal":367625,"en":"I lower my spear and face him,"},{"id":"seytek-2012:p0923:b004:l013","ordinal":367626,"en":"And seize the fighting arm."},{"id":"seytek-2012:p0923:b004:l014","ordinal":367627,"en":"My poor soul is so overjoyed"},{"id":"seytek-2012:p0923:b004:l015","ordinal":367628,"en":"That I can scarcely stay upon the earth."},{"id":"seytek-2012:p0923:b004:l016","ordinal":367629,"en":"Though I fight another six days,"},{"id":"seytek-2012:p0923:b004:l017","ordinal":367630,"en":"My mounting fury will change;"},{"id":"seytek-2012:p0923:b004:l018","ordinal":367631,"en":"If he rages, shall I flee"},{"id":"seytek-2012:p0923:b004:l019","ordinal":367632,"en":"From that swine who calls himself a warrior?"},{"id":"seytek-2012:p0923:b004:l020","ordinal":367633,"en":"Let us find a way to settle his account."},{"id":"seytek-2012:p0923:b004:l021","ordinal":367634,"en":"My name is Kuyaly;"},{"id":"seytek-2012:p0923:b004:l022","ordinal":367635,"en":"I do not boast idly."},{"id":"seytek-2012:p0923:b004:l023","ordinal":367636,"en":"The wings beneath me"},{"id":"seytek-2012:p0923:b004:l024","ordinal":367637,"en":"Have fought in desert and amid armies."},{"id":"seytek-2012:p0923:b004:l025","ordinal":367638,"en":"This infidel Sarybai—"},{"id":"seytek-2012:p0923:b004:l026","ordinal":367639,"en":"Boasting is his habit."},{"id":"seytek-2012:p0923:b004:l027","ordinal":367640,"en":"Do not grieve, asking whether your vengeance died"},{"id":"seytek-2012:p0923:b004:l028","ordinal":367641,"en":"While he still raged before his death;"},{"id":"seytek-2012:p0923:b004:l029","ordinal":367642,"en":"Call him a doomed, overbearing wretch,"},{"id":"seytek-2012:p0923:b004:l030","ordinal":367643,"en":"And let not his people remain forever unreformed."},{"id":"seytek-2012:p0923:b004:l031","ordinal":367644,"en":"Split apart his arrow-proof coat;"},{"id":"seytek-2012:p0923:b004:l032","ordinal":367645,"en":"The calamity that has come from him—"},{"id":"seytek-2012:p0923:b004:l033","ordinal":367646,"en":"Try warding it off with your own hands."},{"id":"seytek-2012:p0923:b004:l034","ordinal":367647,"en":"Ride out in single combat,"},{"id":"seytek-2012:p0923:b004:l035","ordinal":367648,"en":"And clash with him once more."},{"id":"seytek-2012:p0923:b004:l036","ordinal":367649,"en":"These are the words I speak:"},{"id":"seytek-2012:p0923:b004:l037","ordinal":367650,"en":"I shall cast my challenge to the moon;"},{"id":"seytek-2012:p0923:b004:l038","ordinal":367651,"en":"The misery he brought upon the people"},{"id":"seytek-2012:p0923:b004:l039","ordinal":367652,"en":"I shall meet and turn aside."},{"id":"seytek-2012:p0923:b004:l040","ordinal":367653,"en":"If I die, dear people,"},{"id":"seytek-2012:p0924:b002:l001","ordinal":367654,"en":"Say, ‘She died at Sarybai's hand;"},{"id":"seytek-2012:p0924:b002:l002","ordinal":367655,"en":"She went to the land of no return;"},{"id":"seytek-2012:p0924:b002:l003","ordinal":367656,"en":"The lioness met her fate,’"},{"id":"seytek-2012:p0924:b002:l004","ordinal":367657,"en":"And abandon all hope of me."},{"id":"seytek-2012:p0924:b002:l005","ordinal":367658,"en":"Say, ‘Our true champion has died;"},{"id":"seytek-2012:p0924:b002:l006","ordinal":367659,"en":"The valiant maiden met her fate;"},{"id":"seytek-2012:p0924:b002:l007","ordinal":367660,"en":"Her blood filled the riverbed;"},{"id":"seytek-2012:p0924:b002:l008","ordinal":367661,"en":"She was extinguished like a fire.’"},{"id":"seytek-2012:p0924:b002:l009","ordinal":367662,"en":"Scatter those who have assembled;"},{"id":"seytek-2012:p0924:b002:l010","ordinal":367663,"en":"Flee in every direction."},{"id":"seytek-2012:p0924:b002:l011","ordinal":367664,"en":"But if you are men, if you are warriors,"},{"id":"seytek-2012:p0924:b002:l012","ordinal":367665,"en":"Strike and wage battle;"},{"id":"seytek-2012:p0924:b002:l013","ordinal":367666,"en":"Stand beneath the banner."},{"id":"seytek-2012:p0924:b002:l014","ordinal":367667,"en":"Seek out and witness"},{"id":"seytek-2012:p0924:b002:l015","ordinal":367668,"en":"The great, bloody conflict;"},{"id":"seytek-2012:p0924:b002:l016","ordinal":367669,"en":"When you see it, let us not lose heart."},{"id":"seytek-2012:p0924:b002:l017","ordinal":367670,"en":"Say that Kuyaly is dead,"},{"id":"seytek-2012:p0924:b002:l018","ordinal":367671,"en":"And surrender everything you behold!"},{"id":"seytek-2012:p0924:b002:l019","ordinal":367672,"en":"In the fierce, entangled battle,"},{"id":"seytek-2012:p0924:b002:l020","ordinal":367673,"en":"What use is grieving?"},{"id":"seytek-2012:p0924:b002:l021","ordinal":367674,"en":"In the harsh, ruined ravine,"},{"id":"seytek-2012:p0924:b002:l022","ordinal":367675,"en":"What use is wasting away in sorrow,"},{"id":"seytek-2012:p0924:b002:l023","ordinal":367676,"en":"Paling from yellow sickness—"},{"id":"seytek-2012:p0924:b002:l024","ordinal":367677,"en":"What use is pining?"},{"id":"seytek-2012:p0924:b002:l025","ordinal":367678,"en":"Champions who have girded your waists,"},{"id":"seytek-2012:p0924:b002:l026","ordinal":367679,"en":"Sarybai is a champion too,"},{"id":"seytek-2012:p0924:b002:l027","ordinal":367680,"en":"A black-hearted lion."},{"id":"seytek-2012:p0924:b002:l028","ordinal":367681,"en":"Do not stand idle—join battle;"},{"id":"seytek-2012:p0924:b002:l029","ordinal":367682,"en":"Lift up once"},{"id":"seytek-2012:p0924:b002:l030","ordinal":367683,"en":"This grievous, bitter burden."},{"id":"seytek-2012:p0924:b002:l031","ordinal":367684,"en":"When each one's courage is revealed,"},{"id":"seytek-2012:p0924:b002:l032","ordinal":367685,"en":"When they arrive with battle cries,"},{"id":"seytek-2012:p0924:b002:l033","ordinal":367686,"en":"If I fight them one by one"},{"id":"seytek-2012:p0924:b002:l034","ordinal":367687,"en":"And depart forever,"},{"id":"seytek-2012:p0924:b002:l035","ordinal":367688,"en":"Lower your spears."},{"id":"seytek-2012:p0924:b002:l036","ordinal":367689,"en":"If you are heroes, if you are men,"},{"id":"seytek-2012:p0924:b002:l037","ordinal":367690,"en":"If you bear the cry of the noble gray-maned wolf,"},{"id":"seytek-2012:p0924:b002:l038","ordinal":367691,"en":"If you are hawk-like warriors,"},{"id":"seytek-2012:p0924:b002:l039","ordinal":367692,"en":"And fate appoints me death,"},{"id":"seytek-2012:p0924:b002:l040","ordinal":367693,"en":"Then those of you who remain alive"},{"id":"seytek-2012:p0924:b003:l001","ordinal":367694,"en":"Stand as my support;"},{"id":"seytek-2012:p0924:b003:l002","ordinal":367695,"en":"Keep your promise!"},{"id":"seytek-2012:p0924:b003:l003","ordinal":367696,"en":"He has a tail and a living soul,"},{"id":"seytek-2012:p0924:b003:l004","ordinal":367697,"en":"And venom in his purpose;"},{"id":"seytek-2012:p0924:b003:l005","ordinal":367698,"en":"Let Sarybai despair of life,"},{"id":"seytek-2012:p0924:b003:l006","ordinal":367699,"en":"Saying, ‘Here is a soul with a mighty arm.’"},{"id":"seytek-2012:p0924:b003:l007","ordinal":367700,"en":"Such is the word you have heard from me."},{"id":"seytek-2012:p0924:b003:l008","ordinal":367701,"en":"Be my support and my strength;"},{"id":"seytek-2012:p0924:b003:l009","ordinal":367702,"en":"Charge forth against the enemy."},{"id":"seytek-2012:p0924:b003:l010","ordinal":367703,"en":"If I fight while holding the upper ground,"},{"id":"seytek-2012:p0924:b003:l011","ordinal":367704,"en":"Be my prop;"},{"id":"seytek-2012:p0924:b003:l012","ordinal":367705,"en":"If by chance I am driven downhill,"},{"id":"seytek-2012:p0924:b003:l013","ordinal":367706,"en":"Be my prop."},{"id":"seytek-2012:p0924:b003:l014","ordinal":367707,"en":"Do not let his army engulf me;"},{"id":"seytek-2012:p0924:b003:l015","ordinal":367708,"en":"Do not let them spear me from every side"},{"id":"seytek-2012:p0924:b003:l016","ordinal":367709,"en":"And close their ranks around me."},{"id":"seytek-2012:p0924:b003:l017","ordinal":367710,"en":"Let them not hem in my hands"},{"id":"seytek-2012:p0924:b003:l018","ordinal":367711,"en":"Or block my path."},{"id":"seytek-2012:p0924:b003:l019","ordinal":367712,"en":"Let him not display his prowess."},{"id":"seytek-2012:p0924:b003:l020","ordinal":367713,"en":"Sarybai is the one I face;"},{"id":"seytek-2012:p0924:b003:l021","ordinal":367714,"en":"Such is our notorious foe."},{"id":"seytek-2012:p0924:b003:l022","ordinal":367715,"en":"My allied peoples cry aloud,"},{"id":"seytek-2012:p0924:b003:l023","ordinal":367716,"en":"Shuddering and trembling."},{"id":"seytek-2012:p0924:b003:l024","ordinal":367717,"en":"Would God not strike us"},{"id":"seytek-2012:p0924:b003:l025","ordinal":367718,"en":"If I lost my senses"},{"id":"seytek-2012:p0924:b003:l026","ordinal":367719,"en":"And turned back in flight,"},{"id":"seytek-2012:p0924:b003:l027","ordinal":367720,"en":"Showed the enemy my horse's rump,"},{"id":"seytek-2012:p0924:b003:l028","ordinal":367721,"en":"And surrendered my reason?"},{"id":"seytek-2012:p0924:b003:l029","ordinal":367722,"en":"Would He not bring calamity"},{"id":"seytek-2012:p0924:b003:l030","ordinal":367723,"en":"When the great host panics?"},{"id":"seytek-2012:p0924:b003:l031","ordinal":367724,"en":"Would He not take them even as they flee?"},{"id":"seytek-2012:p0924:b003:l032","ordinal":367725,"en":"Therefore heed these words:"},{"id":"seytek-2012:p0924:b003:l033","ordinal":367726,"en":"Stand as my support."},{"id":"seytek-2012:p0924:b003:l034","ordinal":367727,"en":"If you do not support me,"},{"id":"seytek-2012:p0924:b003:l035","ordinal":367728,"en":"Will not seven wolves"},{"id":"seytek-2012:p0924:b003:l036","ordinal":367729,"en":"Fall upon and tear apart one sheep?"},{"id":"seytek-2012:p0924:b003:l037","ordinal":367730,"en":"A lone soul faces many perils;"},{"id":"seytek-2012:p0924:b003:l038","ordinal":367731,"en":"Will they not drag it away after beating it?"},{"id":"seytek-2012:p0924:b003:l039","ordinal":367732,"en":"Will not a thousand men"},{"id":"seytek-2012:p0924:b003:l040","ordinal":367733,"en":"Shoot down one person in a single day?"},{"id":"seytek-2012:p0925:b002:l001","ordinal":367734,"en":"Turn your chargers' heads;"},{"id":"seytek-2012:p0925:b002:l002","ordinal":367735,"en":"Stand ready, army, safe and sound;"},{"id":"seytek-2012:p0925:b002:l003","ordinal":367736,"en":"Do not stand idle—lower your spears."},{"id":"seytek-2012:p0925:b002:l004","ordinal":367737,"en":"If death overtakes you, die."},{"id":"seytek-2012:p0925:b002:l005","ordinal":367738,"en":"For the warrior Seytek,"},{"id":"seytek-2012:p0925:b002:l006","ordinal":367739,"en":"All the vast Kyrgyz host,"},{"id":"seytek-2012:p0925:b002:l007","ordinal":367740,"en":"Stand as my support."},{"id":"seytek-2012:p0925:b002:l008","ordinal":367741,"en":"Fight with ringing battle cries;"},{"id":"seytek-2012:p0925:b002:l009","ordinal":367742,"en":"Plunge into the tumult,"},{"id":"seytek-2012:p0925:b002:l010","ordinal":367743,"en":"Thrusting and dueling with spears."},{"id":"seytek-2012:p0925:b002:l011","ordinal":367744,"en":"When the uproar begins,"},{"id":"seytek-2012:p0925:b002:l012","ordinal":367745,"en":"Sarybai will ride out in single combat,"},{"id":"seytek-2012:p0925:b002:l013","ordinal":367746,"en":"Upon his frenzied racing camel."},{"id":"seytek-2012:p0925:b002:l014","ordinal":367747,"en":"His valor is extraordinary,"},{"id":"seytek-2012:p0925:b002:l015","ordinal":367748,"en":"His worth and venom immense."},{"id":"seytek-2012:p0925:b002:l016","ordinal":367749,"en":"That towering swine—"},{"id":"seytek-2012:p0925:b002:l017","ordinal":367750,"en":"The accursed man's spears"},{"id":"seytek-2012:p0925:b002:l018","ordinal":367751,"en":"Are wielded with skill."},{"id":"seytek-2012:p0925:b002:l019","ordinal":367752,"en":"Though Sarybai's devices are exhausted,"},{"id":"seytek-2012:p0925:b002:l020","ordinal":367753,"en":"He still has strength."},{"id":"seytek-2012:p0925:b002:l021","ordinal":367754,"en":"He found no mountain to strike,"},{"id":"seytek-2012:p0925:b002:l022","ordinal":367755,"en":"No enemy with whom to fight."},{"id":"seytek-2012:p0925:b002:l023","ordinal":367756,"en":"The power that enters great conflict,"},{"id":"seytek-2012:p0925:b002:l024","ordinal":367757,"en":"The power that unleashes great turmoil—"},{"id":"seytek-2012:p0925:b002:l025","ordinal":367758,"en":"When you go to face him"},{"id":"seytek-2012:p0925:b002:l026","ordinal":367759,"en":"And confront him,"},{"id":"seytek-2012:p0925:b002:l027","ordinal":367760,"en":"From the Kutbe side,"},{"id":"seytek-2012:p0925:b002:l028","ordinal":367761,"en":"Surge forward on the gray horse;"},{"id":"seytek-2012:p0925:b002:l029","ordinal":367762,"en":"Let the warriors enter from the flank."},{"id":"seytek-2012:p0925:b002:l030","ordinal":367763,"en":"Drive the young steeds through,"},{"id":"seytek-2012:p0925:b002:l031","ordinal":367764,"en":"And pursue as far as you reach."},{"id":"seytek-2012:p0925:b002:l032","ordinal":367765,"en":"From Alakem's lower side,"},{"id":"seytek-2012:p0925:b002:l033","ordinal":367766,"en":"Pour forth heavy fire."},{"id":"seytek-2012:p0925:b002:l034","ordinal":367767,"en":"Leave Sarybai's myriad host"},{"id":"seytek-2012:p0925:b002:l035","ordinal":367768,"en":"Unable to bind our hands."},{"id":"seytek-2012:p0925:b002:l036","ordinal":367769,"en":"Raise the battle cry and reach them;"},{"id":"seytek-2012:p0925:b002:l037","ordinal":367770,"en":"Charge all together,"},{"id":"seytek-2012:p0925:b002:l038","ordinal":367771,"en":"And wage war as one."},{"id":"seytek-2012:p0925:b002:l039","ordinal":367772,"en":"Such is the way of battle.”"},{"id":"seytek-2012:p0925:b002:l040","ordinal":367773,"en":"So spoke the champion maiden:"},{"id":"seytek-2012:p0925:b003:l001","ordinal":367774,"en":"“Sarybai, who has ridden out alone—"},{"id":"seytek-2012:p0925:b003:l002","ordinal":367775,"en":"I shall see how he rages,"},{"id":"seytek-2012:p0925:b003:l003","ordinal":367776,"en":"Put an end to his panting,"},{"id":"seytek-2012:p0925:b003:l004","ordinal":367777,"en":"Tear his eyes wide open,"},{"id":"seytek-2012:p0925:b003:l005","ordinal":367778,"en":"Crush him if he falls into my hands,"},{"id":"seytek-2012:p0925:b003:l006","ordinal":367779,"en":"Break his ribs,"},{"id":"seytek-2012:p0925:b003:l007","ordinal":367780,"en":"Seize him and spill his blood."},{"id":"seytek-2012:p0925:b003:l008","ordinal":367781,"en":"That marksman who calls himself a champion,"},{"id":"seytek-2012:p0925:b003:l009","ordinal":367782,"en":"Who made the whole world submit—"},{"id":"seytek-2012:p0925:b003:l010","ordinal":367783,"en":"Your lone-ranging warrior—"},{"id":"seytek-2012:p0925:b003:l011","ordinal":367784,"en":"I shall inflict great misery upon him"},{"id":"seytek-2012:p0925:b003:l012","ordinal":367785,"en":"And avenge the ancient grudge.”"},{"id":"seytek-2012:p0925:b003:l013","ordinal":367786,"en":"So saying, Kuyaly"},{"id":"seytek-2012:p0925:b003:l014","ordinal":367787,"en":"Gripped her weapon fiercely;"},{"id":"seytek-2012:p0925:b003:l015","ordinal":367788,"en":"Her bare white teeth"},{"id":"seytek-2012:p0925:b003:l016","ordinal":367789,"en":"Gnashed again and again,"},{"id":"seytek-2012:p0925:b003:l017","ordinal":367790,"en":"And her lion eyes blazed."},{"id":"seytek-2012:p0925:b003:l018","ordinal":367791,"en":"She slung the Adi-makpys bag"},{"id":"seytek-2012:p0925:b003:l019","ordinal":367792,"en":"Across herself and sprang forth."},{"id":"seytek-2012:p0925:b003:l020","ordinal":367793,"en":"Zhelzhetpes beneath her"},{"id":"seytek-2012:p0925:b003:l021","ordinal":367794,"en":"Was covered with a caparison;"},{"id":"seytek-2012:p0925:b003:l022","ordinal":367795,"en":"She tightened the flank girth firmly"},{"id":"seytek-2012:p0925:b003:l023","ordinal":367796,"en":"And drew the crupper tight."},{"id":"seytek-2012:p0925:b003:l024","ordinal":367797,"en":"Her eyes reddened like a wild ram's;"},{"id":"seytek-2012:p0925:b003:l025","ordinal":367798,"en":"The beautiful Kuyaly"},{"id":"seytek-2012:p0925:b003:l026","ordinal":367799,"en":"Shone like the rising moon."},{"id":"seytek-2012:p0925:b003:l027","ordinal":367800,"en":"Her human qualities were unmatched,"},{"id":"seytek-2012:p0925:b003:l028","ordinal":367801,"en":"A peerless wonder surpassing the world."},{"id":"seytek-2012:p0925:b003:l029","ordinal":367802,"en":"Sarybai was the one she would face;"},{"id":"seytek-2012:p0925:b003:l030","ordinal":367803,"en":"Such was her valor."},{"id":"seytek-2012:p0925:b003:l031","ordinal":367804,"en":"Time and time again,"},{"id":"seytek-2012:p0925:b003:l032","ordinal":367805,"en":"They had shattered lances in combat,"},{"id":"seytek-2012:p0925:b003:l033","ordinal":367806,"en":"Torn at each other many times,"},{"id":"seytek-2012:p0925:b003:l034","ordinal":367807,"en":"Until strength left their apple-round heads"},{"id":"seytek-2012:p0925:b003:l035","ordinal":367808,"en":"And blood drained from their fair bodies;"},{"id":"seytek-2012:p0925:b003:l036","ordinal":367809,"en":"Thus had they fought each other."},{"id":"seytek-2012:p0925:b003:l037","ordinal":367810,"en":"They climbed the ridge and faced one another,"},{"id":"seytek-2012:p0925:b003:l038","ordinal":367811,"en":"Calling and dividing their forces."},{"id":"seytek-2012:p0925:b003:l039","ordinal":367812,"en":"Time and time again,"},{"id":"seytek-2012:p0925:b003:l040","ordinal":367813,"en":"They had battled to the death,"},{"id":"seytek-2012:p0926:b002:l001","ordinal":367814,"en":"Against enemies they encountered,"},{"id":"seytek-2012:p0926:b002:l002","ordinal":367815,"en":"Against exceedingly wrathful warriors,"},{"id":"seytek-2012:p0926:b002:l003","ordinal":367816,"en":"Against overbearing champions."},{"id":"seytek-2012:p0926:b002:l004","ordinal":367817,"en":"Into the monster's black eyes,"},{"id":"seytek-2012:p0926:b002:l005","ordinal":367818,"en":"Ready to die if death arrived,"},{"id":"seytek-2012:p0926:b002:l006","ordinal":367819,"en":"If the Almighty desired her life,"},{"id":"seytek-2012:p0926:b002:l007","ordinal":367820,"en":"Ready to surrender her entrusted soul,"},{"id":"seytek-2012:p0926:b002:l008","ordinal":367821,"en":"Ready to unleash a mighty battle—"},{"id":"seytek-2012:p0926:b002:l009","ordinal":367822,"en":"She, offspring of lionhearted heroes,"},{"id":"seytek-2012:p0926:b002:l010","ordinal":367823,"en":"Sought from the fierce one's hands,"},{"id":"seytek-2012:p0926:b002:l011","ordinal":367824,"en":"From death's opposing snare,"},{"id":"seytek-2012:p0926:b002:l012","ordinal":367825,"en":"From that great menace and mighty venom,"},{"id":"seytek-2012:p0926:b002:l013","ordinal":367826,"en":"From Sarybai's hands,"},{"id":"seytek-2012:p0926:b002:l014","ordinal":367827,"en":"To wrest her people free."},{"id":"seytek-2012:p0926:b002:l015","ordinal":367828,"en":"This was the mighty tumult,"},{"id":"seytek-2012:p0926:b002:l016","ordinal":367829,"en":"To be unleashed upon Sarybai:"},{"id":"seytek-2012:p0926:b002:l017","ordinal":367830,"en":"To meet him face-to-face,"},{"id":"seytek-2012:p0926:b002:l018","ordinal":367831,"en":"And clash in crushing combat."},{"id":"seytek-2012:p0926:b002:l019","ordinal":367832,"en":"Her eager eyes burned fiercely;"},{"id":"seytek-2012:p0926:b002:l020","ordinal":367833,"en":"Alas, the champion Kuyaly"},{"id":"seytek-2012:p0926:b002:l021","ordinal":367834,"en":"Watched with both eyes doubled,"},{"id":"seytek-2012:p0926:b002:l022","ordinal":367835,"en":"And wrathfully made ready."},{"id":"seytek-2012:p0926:b002:l023","ordinal":367836,"en":"She put on all her battle gear,"},{"id":"seytek-2012:p0926:b002:l024","ordinal":367837,"en":"Strapped on her naked sword,"},{"id":"seytek-2012:p0926:b002:l025","ordinal":367838,"en":"And leveled a gleaming spear,"},{"id":"seytek-2012:p0926:b002:l026","ordinal":367839,"en":"Ready once more."},{"id":"seytek-2012:p0926:b002:l027","ordinal":367840,"en":"She seized the black-shafted weighted whip"},{"id":"seytek-2012:p0926:b002:l028","ordinal":367841,"en":"And swung it around;"},{"id":"seytek-2012:p0926:b002:l029","ordinal":367842,"en":"Zhelzhetpes, swift as a boat,"},{"id":"seytek-2012:p0926:b002:l030","ordinal":367843,"en":"She gripped tightly with her knees."},{"id":"seytek-2012:p0926:b002:l031","ordinal":367844,"en":"Crying “Allah!” she raised her spear"},{"id":"seytek-2012:p0926:b002:l032","ordinal":367845,"en":"And charged straight at Sarybai;"},{"id":"seytek-2012:p0926:b002:l033","ordinal":367846,"en":"Now she made the struggle fierce."},{"id":"seytek-2012:p0926:b002:l034","ordinal":367847,"en":"The war drum was the signal of battle;"},{"id":"seytek-2012:p0926:b002:l035","ordinal":367848,"en":"Such was that war drum:"},{"id":"seytek-2012:p0926:b002:l036","ordinal":367849,"en":"It was made of elephant hide,"},{"id":"seytek-2012:p0926:b002:l037","ordinal":367850,"en":"And when struck once with a battle-axe,"},{"id":"seytek-2012:p0926:b002:l038","ordinal":367851,"en":"The very heavens seemed to shift,"},{"id":"seytek-2012:p0926:b002:l039","ordinal":367852,"en":"And the breadth of the earth resounded."},{"id":"seytek-2012:p0926:b002:l040","ordinal":367853,"en":"In battle, champions fled before it;"},{"id":"seytek-2012:p0926:b003:l001","ordinal":367854,"en":"It was the army's foremost shield,"},{"id":"seytek-2012:p0926:b003:l002","ordinal":367855,"en":"The herald of Kuyaly's battle."},{"id":"seytek-2012:p0926:b003:l003","ordinal":367856,"en":"When she struck the war drum,"},{"id":"seytek-2012:p0926:b003:l004","ordinal":367857,"en":"Her stalwart champions followed behind."},{"id":"seytek-2012:p0926:b003:l005","ordinal":367858,"en":"After giving this signal,"},{"id":"seytek-2012:p0926:b003:l006","ordinal":367859,"en":"She drove her deep-throated, secret spear"},{"id":"seytek-2012:p0926:b003:l007","ordinal":367860,"en":"Forward with a thunderous blow;"},{"id":"seytek-2012:p0926:b003:l008","ordinal":367861,"en":"Even that failed to bring him down,"},{"id":"seytek-2012:p0926:b003:l009","ordinal":367862,"en":"So she struck again with a roar."},{"id":"seytek-2012:p0926:b003:l010","ordinal":367863,"en":"The earth broke into clouds of dust,"},{"id":"seytek-2012:p0926:b003:l011","ordinal":367864,"en":"And all who saw it were bewildered."},{"id":"seytek-2012:p0926:b003:l012","ordinal":367865,"en":"Every warrior grew excited,"},{"id":"seytek-2012:p0926:b003:l013","ordinal":367866,"en":"Every hero was stirred;"},{"id":"seytek-2012:p0926:b003:l014","ordinal":367867,"en":"The courageous and lionhearted"},{"id":"seytek-2012:p0926:b003:l015","ordinal":367868,"en":"Showed the valor with which they entered holy war."},{"id":"seytek-2012:p0926:b003:l016","ordinal":367869,"en":"It became known to all the people,"},{"id":"seytek-2012:p0926:b003:l017","ordinal":367870,"en":"And the people despaired of life"},{"id":"seytek-2012:p0926:b003:l018","ordinal":367871,"en":"As they crowded around to watch."},{"id":"seytek-2012:p0926:b003:l019","ordinal":367872,"en":"Then Kuyaly"}]
