[{"id":"manas-2010:p1385:b001:l019","ordinal":59905,"en":"My fellow lamb, my twin:"},{"id":"manas-2010:p1385:b001:l020","ordinal":59906,"en":"Parted from warrior Chubak,"},{"id":"manas-2010:p1385:b001:l021","ordinal":59907,"en":"How shall I go on now?"},{"id":"manas-2010:p1385:b001:l022","ordinal":59908,"en":"Akbaltay's Chubak,"},{"id":"manas-2010:p1385:b001:l023","ordinal":59909,"en":"A bringer of good luck when he led me,"},{"id":"manas-2010:p1385:b001:l024","ordinal":59910,"en":"Like a san of troops against the foe,"},{"id":"manas-2010:p1385:b001:l025","ordinal":59911,"en":"The champion I relied on:"},{"id":"manas-2010:p1385:b001:l026","ordinal":59912,"en":"When hardship fell upon my troubled head,"},{"id":"manas-2010:p1385:b001:l027","ordinal":59913,"en":"Famed Chubak was the one I needed!"},{"id":"manas-2010:p1385:b001:l028","ordinal":59914,"en":"For the pain of warrior Chubak,"},{"id":"manas-2010:p1385:b001:l029","ordinal":59915,"en":"For the anguish of warrior Töshtük,"},{"id":"manas-2010:p1385:b001:l030","ordinal":59916,"en":"Upon the seething Chinese,"},{"id":"manas-2010:p1385:b001:l031","ordinal":59917,"en":"Unless I make war once again,"},{"id":"manas-2010:p1385:b001:l032","ordinal":59918,"en":"Of men like Chubak and Töshtük,"},{"id":"manas-2010:p1385:b001:l033","ordinal":59919,"en":"Unless I take a thousand heads!"},{"id":"manas-2010:p1385:b001:l034","ordinal":59920,"en":"Having let my wings be clipped,"},{"id":"manas-2010:p1385:b001:l035","ordinal":59921,"en":"Having let my strength be taken,"},{"id":"manas-2010:p1385:b001:l036","ordinal":59922,"en":"From the massed Chinese and Manchus,"},{"id":"manas-2010:p1385:b001:l037","ordinal":59923,"en":"How can I go away alive?"},{"id":"manas-2010:p1385:b001:l038","ordinal":59924,"en":"With sorrow, to Talas,"},{"id":"manas-2010:p1385:b001:l039","ordinal":59925,"en":"How can I reach home safe?”"},{"id":"manas-2010:p1385:b001:l040","ordinal":59926,"en":"Saying this, warrior Manas"},{"id":"manas-2010:p1385:b001:l041","ordinal":59927,"en":"Began the turmoil once again."},{"id":"manas-2010:p1385:b001:l042","ordinal":59928,"en":"Grieving and crying out,"},{"id":"manas-2010:p1386:b001:l001","ordinal":59929,"en":"The great army watching him"},{"id":"manas-2010:p1386:b001:l002","ordinal":59930,"en":"Was all but struck dead."},{"id":"manas-2010:p1386:b001:l003","ordinal":59931,"en":"Lamenting, complaining, saying much,"},{"id":"manas-2010:p1386:b001:l004","ordinal":59932,"en":"“Now what shall we do?” they said;"},{"id":"manas-2010:p1386:b001:l005","ordinal":59933,"en":"Many there were who writhed about."},{"id":"manas-2010:p1386:b001:l006","ordinal":59934,"en":"“We have fallen into torment again;"},{"id":"manas-2010:p1386:b001:l007","ordinal":59935,"en":"The wives and children left behind"},{"id":"manas-2010:p1386:b001:l008","ordinal":59936,"en":"We shall surely never see,” they said;"},{"id":"manas-2010:p1386:b001:l009","ordinal":59937,"en":"Many there were who wept."},{"id":"manas-2010:p1386:b001:l010","ordinal":59938,"en":"“There will be battle again;"},{"id":"manas-2010:p1386:b001:l011","ordinal":59939,"en":"When the battle comes this time,"},{"id":"manas-2010:p1386:b001:l012","ordinal":59940,"en":"The Chinese will gouge out our eyes,"},{"id":"manas-2010:p1386:b001:l013","ordinal":59941,"en":"They will slaughter all of us!”"},{"id":"manas-2010:p1386:b001:l014","ordinal":59942,"en":"They all stood crying out."},{"id":"manas-2010:p1386:b001:l015","ordinal":59943,"en":"Saying this, the multitude"},{"id":"manas-2010:p1386:b001:l016","ordinal":59944,"en":"All lay down together."},{"id":"manas-2010:p1386:b001:l017","ordinal":59945,"en":"“There will be battle tomorrow,”"},{"id":"manas-2010:p1386:b001:l018","ordinal":59946,"en":"They all thought anxiously."},{"id":"manas-2010:p1386:b001:l019","ordinal":59947,"en":"All their steeds"},{"id":"manas-2010:p1386:b001:l020","ordinal":59948,"en":"They unsaddled and tied up."},{"id":"manas-2010:p1386:b001:l021","ordinal":59949,"en":"Pillowed on their white saddles,"},{"id":"manas-2010:p1386:b001:l022","ordinal":59950,"en":"With their heads toward the west,"},{"id":"manas-2010:p1386:b001:l023","ordinal":59951,"en":"The whole great army"},{"id":"manas-2010:p1386:b001:l024","ordinal":59952,"en":"Fell into a bird's light sleep."},{"id":"manas-2010:p1386:b001:l025","ordinal":59953,"en":"One by one, the stars in heaven,"},{"id":"manas-2010:p1386:b001:l026","ordinal":59954,"en":"The light before dawn began to show;"},{"id":"manas-2010:p1386:b001:l027","ordinal":59955,"en":"As the morning star was setting,"},{"id":"manas-2010:p1386:b001:l028","ordinal":59956,"en":"As the dawn broke bright,"},{"id":"manas-2010:p1386:b001:l029","ordinal":59957,"en":"The great army lying there"},{"id":"manas-2010:p1386:b001:l030","ordinal":59958,"en":"Rose up all together."},{"id":"manas-2010:p1386:b001:l031","ordinal":59959,"en":"Aykhozho in his pied robe"},{"id":"manas-2010:p1386:b001:l032","ordinal":59960,"en":"Called Allah in the call to prayer."},{"id":"manas-2010:p1386:b001:l033","ordinal":59961,"en":"All the Muslim faithful"},{"id":"manas-2010:p1386:b001:l034","ordinal":59962,"en":"Gathered together."},{"id":"manas-2010:p1386:b001:l035","ordinal":59963,"en":"They put their hands into the water,"},{"id":"manas-2010:p1386:b001:l036","ordinal":59964,"en":"Performed the washing of their hands;"},{"id":"manas-2010:p1386:b001:l037","ordinal":59965,"en":"They put their feet into the water,"},{"id":"manas-2010:p1386:b001:l038","ordinal":59966,"en":"Performed the washing of their feet."},{"id":"manas-2010:p1386:b001:l039","ordinal":59967,"en":"Two customary, two obligatory,"},{"id":"manas-2010:p1386:b001:l040","ordinal":59968,"en":"Four cycles of the dawn prayer:"},{"id":"manas-2010:p1386:b001:l041","ordinal":59969,"en":"All raised their hands to their ears,"},{"id":"manas-2010:p1386:b001:l042","ordinal":59970,"en":"With Aykhozho their imam before them,"},{"id":"manas-2010:p1387:b001:l001","ordinal":59971,"en":"With old Koshoy at their head,"},{"id":"manas-2010:p1387:b001:l002","ordinal":59972,"en":"Facing the direction of prayer,"},{"id":"manas-2010:p1387:b001:l003","ordinal":59973,"en":"They stood up to recite."},{"id":"manas-2010:p1387:b001:l004","ordinal":59974,"en":"As they were finishing the prayer,"},{"id":"manas-2010:p1387:b001:l005","ordinal":59975,"en":"Just about to give the closing greeting,"},{"id":"manas-2010:p1387:b001:l006","ordinal":59976,"en":"Chubak had wrought a slaughter."},{"id":"manas-2010:p1387:b001:l007","ordinal":59977,"en":"Fighting bloodily against the khan,"},{"id":"manas-2010:p1387:b001:l008","ordinal":59978,"en":"Ezkara, khan of the Manchus,"},{"id":"manas-2010:p1387:b001:l009","ordinal":59979,"en":"With Ezkara at their head,"},{"id":"manas-2010:p1387:b001:l010","ordinal":59980,"en":"Forty princes of the Chinese,"},{"id":"manas-2010:p1387:b001:l011","ordinal":59981,"en":"Your champion, wolf-maned Chubak,"},{"id":"manas-2010:p1387:b001:l012","ordinal":59982,"en":"Had bound all by himself."},{"id":"manas-2010:p1387:b001:l013","ordinal":59983,"en":"Folding them at the waist,"},{"id":"manas-2010:p1387:b001:l014","ordinal":59984,"en":"Making balanced loads of two apiece,"},{"id":"manas-2010:p1387:b001:l015","ordinal":59985,"en":"The princes onto their horses"},{"id":"manas-2010:p1387:b001:l016","ordinal":59986,"en":"Chubak had loaded up."},{"id":"manas-2010:p1387:b001:l017","ordinal":59987,"en":"Before Khan Manas"},{"id":"manas-2010:p1387:b001:l018","ordinal":59988,"en":"He had brought them as an offering."},{"id":"manas-2010:p1387:b001:l019","ordinal":59989,"en":"Manas saw Chubak."},{"id":"manas-2010:p1387:b001:l020","ordinal":59990,"en":"When Manas saw Chubak,"},{"id":"manas-2010:p1387:b001:l021","ordinal":59991,"en":"Breaking off his prayer, bristling up,"},{"id":"manas-2010:p1387:b001:l022","ordinal":59992,"en":"Warrior Manas sprang to his feet,"},{"id":"manas-2010:p1387:b001:l023","ordinal":59993,"en":"Roaring out in his delight:"},{"id":"manas-2010:p1387:b001:l024","ordinal":59994,"en":"“White holy man, Aykhozho,"},{"id":"manas-2010:p1387:b001:l025","ordinal":59995,"en":"You keep dawdling on,"},{"id":"manas-2010:p1387:b001:l026","ordinal":59996,"en":"You recite until evening."},{"id":"manas-2010:p1387:b001:l027","ordinal":59997,"en":"Keep your paradise yourself:"},{"id":"manas-2010:p1387:b001:l028","ordinal":59998,"en":"My champion Chubak is coming!"},{"id":"manas-2010:p1387:b001:l029","ordinal":59999,"en":"You draw out your recitation,"},{"id":"manas-2010:p1387:b001:l030","ordinal":60000,"en":"Wearing out a person's body;"},{"id":"manas-2010:p1387:b001:l031","ordinal":60001,"en":"My sultan Chubak is coming!"},{"id":"manas-2010:p1387:b001:l032","ordinal":60002,"en":"Keep your merit yourself:"},{"id":"manas-2010:p1387:b001:l033","ordinal":60003,"en":"My sultan Chubak is coming!"},{"id":"manas-2010:p1387:b001:l034","ordinal":60004,"en":"Keep your prayer yourself:"},{"id":"manas-2010:p1387:b001:l035","ordinal":60005,"en":"My peerless Chubak is coming!"},{"id":"manas-2010:p1387:b001:l036","ordinal":60006,"en":"You call out the call to prayer,"},{"id":"manas-2010:p1387:b001:l037","ordinal":60007,"en":"You put the people to torment,"},{"id":"manas-2010:p1387:b001:l038","ordinal":60008,"en":"You keep them all distracted;"},{"id":"manas-2010:p1387:b001:l039","ordinal":60009,"en":"My sultan Chubak is coming!"},{"id":"manas-2010:p1387:b001:l040","ordinal":60010,"en":"The lion of the forty companions,"},{"id":"manas-2010:p1387:b001:l041","ordinal":60011,"en":"My champion Chubak is coming,"},{"id":"manas-2010:p1387:b001:l042","ordinal":60012,"en":"Worth all of them together,"},{"id":"manas-2010:p1388:b001:l001","ordinal":60013,"en":"My warrior Chubak is coming!”"},{"id":"manas-2010:p1388:b001:l002","ordinal":60014,"en":"Roaring in delight,"},{"id":"manas-2010:p1388:b001:l003","ordinal":60015,"en":"Warrior Manas went out to meet him,"},{"id":"manas-2010:p1388:b001:l004","ordinal":60016,"en":"Calling, “Warrior Chubak!”"},{"id":"manas-2010:p1388:b001:l005","ordinal":60017,"en":"Then Chubak, that dear tiger,"},{"id":"manas-2010:p1388:b001:l006","ordinal":60018,"en":"“Among the Chinese, the people of forty khans,"},{"id":"manas-2010:p1388:b001:l007","ordinal":60019,"en":"I have kept wreaking slaughter,” he said."},{"id":"manas-2010:p1388:b001:l008","ordinal":60020,"en":"“For your glorious self,"},{"id":"manas-2010:p1388:b001:l009","ordinal":60021,"en":"Forty princes of the Chinese,"},{"id":"manas-2010:p1388:b001:l010","ordinal":60022,"en":"With their Ezkara at the head,"},{"id":"manas-2010:p1388:b001:l011","ordinal":60023,"en":"Before you, warrior Manas,"},{"id":"manas-2010:p1388:b001:l012","ordinal":60024,"en":"I have brought as an offering.”"},{"id":"manas-2010:p1388:b001:l013","ordinal":60025,"en":"Galloping about on Kögala,"},{"id":"manas-2010:p1388:b001:l014","ordinal":60026,"en":"The Chinese he had driven there"},{"id":"manas-2010:p1388:b001:l015","ordinal":60027,"en":"He prodded with his spear,"},{"id":"manas-2010:p1388:b001:l016","ordinal":60028,"en":"Striking this way and that,"},{"id":"manas-2010:p1388:b001:l017","ordinal":60029,"en":"Overturning them from their horses;"},{"id":"manas-2010:p1388:b001:l018","ordinal":60030,"en":"Warrior Chubak brought them all down."},{"id":"manas-2010:p1388:b001:l019","ordinal":60031,"en":"Seeing this, warrior Manas"},{"id":"manas-2010:p1388:b001:l020","ordinal":60032,"en":"Against the captive princes"},{"id":"manas-2010:p1388:b001:l021","ordinal":60033,"en":"Flared up in fury."},{"id":"manas-2010:p1388:b001:l022","ordinal":60034,"en":"To strike off their heads,"},{"id":"manas-2010:p1388:b001:l023","ordinal":60035,"en":"Manas stood preparing himself."},{"id":"manas-2010:p1388:b001:l024","ordinal":60036,"en":"Their khans intervened,"},{"id":"manas-2010:p1388:b001:l025","ordinal":60037,"en":"Together seizing hold of Manas."},{"id":"manas-2010:p1388:b001:l026","ordinal":60038,"en":"The eloquent fellow with the black tongue,"},{"id":"manas-2010:p1388:b001:l027","ordinal":60039,"en":"Ezkara stood looking;"},{"id":"manas-2010:p1388:b001:l028","ordinal":60040,"en":"Before Khan Manas,"},{"id":"manas-2010:p1388:b001:l029","ordinal":60041,"en":"Ezkara poured out his words:"},{"id":"manas-2010:p1388:b001:l030","ordinal":60042,"en":"“Warrior, if you kill me, there is no remedy;"},{"id":"manas-2010:p1388:b001:l031","ordinal":60043,"en":"If you put me to death,"},{"id":"manas-2010:p1388:b001:l032","ordinal":60044,"en":"It will not profit you a hair!"},{"id":"manas-2010:p1388:b001:l033","ordinal":60045,"en":"If you do not kill me,"},{"id":"manas-2010:p1388:b001:l034","ordinal":60046,"en":"I will do whatever you command;"},{"id":"manas-2010:p1388:b001:l035","ordinal":60047,"en":"I will stand in your service."},{"id":"manas-2010:p1388:b001:l036","ordinal":60048,"en":"If my tiny life does not perish,"},{"id":"manas-2010:p1388:b001:l037","ordinal":60049,"en":"For you, champion Manas,"},{"id":"manas-2010:p1388:b001:l038","ordinal":60050,"en":"Without sparing my life a hair,"},{"id":"manas-2010:p1388:b001:l039","ordinal":60051,"en":"I will do whatever you command, Manas!"},{"id":"manas-2010:p1388:b001:l040","ordinal":60052,"en":"When you were born, Manas,"},{"id":"manas-2010:p1388:b001:l041","ordinal":60053,"en":"The Kyrgyz people rejoiced."},{"id":"manas-2010:p1388:b001:l042","ordinal":60054,"en":"When they named you Manas,"},{"id":"manas-2010:p1389:b001:l001","ordinal":60055,"en":"When you became known to the world,"},{"id":"manas-2010:p1389:b001:l002","ordinal":60056,"en":"Karykan, khan of Beijing,"},{"id":"manas-2010:p1389:b001:l003","ordinal":60057,"en":"Heard of you and grieved, Manas."},{"id":"manas-2010:p1389:b001:l004","ordinal":60058,"en":"The reason he was grieved:"},{"id":"manas-2010:p1389:b001:l005","ordinal":60059,"en":"The gate in Beijing"},{"id":"manas-2010:p1389:b001:l006","ordinal":60060,"en":"Was marked and scored, Manas."},{"id":"manas-2010:p1389:b001:l007","ordinal":60061,"en":"When they heard of your prowess,"},{"id":"manas-2010:p1389:b001:l008","ordinal":60062,"en":"The people of Beijing were troubled, Manas!"},{"id":"manas-2010:p1389:b001:l009","ordinal":60063,"en":"For illustrious Beijing,"},{"id":"manas-2010:p1389:b001:l010","ordinal":60064,"en":"I was a fortified wall raised up."},{"id":"manas-2010:p1389:b001:l011","ordinal":60065,"en":"Do you need Bakay?"},{"id":"manas-2010:p1389:b001:l012","ordinal":60066,"en":"I was worth as much as your Bakay!"},{"id":"manas-2010:p1389:b001:l013","ordinal":60067,"en":"Do not kill me, Khan Manas;"},{"id":"manas-2010:p1389:b001:l014","ordinal":60068,"en":"Of the stone-badged Chinese,"},{"id":"manas-2010:p1389:b001:l015","ordinal":60069,"en":"I was the very finest."},{"id":"manas-2010:p1389:b001:l016","ordinal":60070,"en":"Of the black-tasselled Kalmyks,"},{"id":"manas-2010:p1389:b001:l017","ordinal":60071,"en":"I was the black eye that kept watch."},{"id":"manas-2010:p1389:b001:l018","ordinal":60072,"en":"Of the Chinese, the people of forty khans,"},{"id":"manas-2010:p1389:b001:l019","ordinal":60073,"en":"I was their very champion!"},{"id":"manas-2010:p1389:b001:l020","ordinal":60074,"en":"Do not kill me; bind me fast;"},{"id":"manas-2010:p1389:b001:l021","ordinal":60075,"en":"Send word to my khan,"},{"id":"manas-2010:p1389:b001:l022","ordinal":60076,"en":"To the city of the kakan!"},{"id":"manas-2010:p1389:b001:l023","ordinal":60077,"en":"Esenkan's daughter Burulcha,"},{"id":"manas-2010:p1389:b001:l024","ordinal":60078,"en":"His daughter I will give as an offering;"},{"id":"manas-2010:p1389:b001:l025","ordinal":60079,"en":"Ay Jangjung's daughter Birmyskal,"},{"id":"manas-2010:p1389:b001:l026","ordinal":60080,"en":"The skilled maiden I will give as an offering!"},{"id":"manas-2010:p1389:b001:l027","ordinal":60081,"en":"The many Manchus of Outer Beijing,"},{"id":"manas-2010:p1389:b001:l028","ordinal":60082,"en":"My people I will give as an offering;"},{"id":"manas-2010:p1389:b001:l029","ordinal":60083,"en":"My gold mines, my mountains of tea,"},{"id":"manas-2010:p1389:b001:l030","ordinal":60084,"en":"My land I will give as an offering!"},{"id":"manas-2010:p1389:b001:l031","ordinal":60085,"en":"With ramparts all around it,"},{"id":"manas-2010:p1389:b001:l032","ordinal":60086,"en":"My throne I will give as an offering!"},{"id":"manas-2010:p1389:b001:l033","ordinal":60087,"en":"For your name to endure, for you to mount,"},{"id":"manas-2010:p1389:b001:l034","ordinal":60088,"en":"My throne I will give as an offering!"},{"id":"manas-2010:p1389:b001:l035","ordinal":60089,"en":"If in your fury you kill me, Manas,"},{"id":"manas-2010:p1389:b001:l036","ordinal":60090,"en":"I shall enter the black earth."},{"id":"manas-2010:p1389:b001:l037","ordinal":60091,"en":"Think a little, warrior Manas:"},{"id":"manas-2010:p1389:b001:l038","ordinal":60092,"en":"If you should happen to kill me,"},{"id":"manas-2010:p1389:b001:l039","ordinal":60093,"en":"Until the Day of Judgment,"},{"id":"manas-2010:p1389:b001:l040","ordinal":60094,"en":"‘A khan has killed a khan!’"},{"id":"manas-2010:p1389:b001:l041","ordinal":60095,"en":"The uproar over me will not subside.”"},{"id":"manas-2010:p1389:b001:l042","ordinal":60096,"en":"As Ezkara said this,"},{"id":"manas-2010:p1390:b001:l001","ordinal":60097,"en":"Pleading and pouring out his words,"},{"id":"manas-2010:p1390:b001:l002","ordinal":60098,"en":"Manas, the blood-drinking slayer,"},{"id":"manas-2010:p1390:b001:l003","ordinal":60099,"en":"Was seized by his thirst for blood."},{"id":"manas-2010:p1390:b001:l004","ordinal":60100,"en":"Drawing out his sword,"},{"id":"manas-2010:p1390:b001:l005","ordinal":60101,"en":"His eyes blazed like a lion's."},{"id":"manas-2010:p1390:b001:l006","ordinal":60102,"en":"Azhybay and Khan Bakay"},{"id":"manas-2010:p1390:b001:l007","ordinal":60103,"en":"Stepped between him and Manas;"},{"id":"manas-2010:p1390:b001:l008","ordinal":60104,"en":"They seized his sword."},{"id":"manas-2010:p1390:b001:l009","ordinal":60105,"en":"While they held his sword,"},{"id":"manas-2010:p1390:b001:l010","ordinal":60106,"en":"Golden forelock, tasselled sash,"},{"id":"manas-2010:p1390:b001:l011","ordinal":60107,"en":"Thoroughly versed in Beijing,"},{"id":"manas-2010:p1390:b001:l012","ordinal":60108,"en":"Azizkan's only son,"},{"id":"manas-2010:p1390:b001:l013","ordinal":60109,"en":"Almambet came and spoke:"},{"id":"manas-2010:p1390:b001:l014","ordinal":60110,"en":"“My champion Manas, spare his life!"},{"id":"manas-2010:p1390:b001:l015","ordinal":60111,"en":"Leave the unruly fellow be; heed me."},{"id":"manas-2010:p1390:b001:l016","ordinal":60112,"en":"Ezkara, khan of the Chinese,"},{"id":"manas-2010:p1390:b001:l017","ordinal":60113,"en":"Is the warrior khan of the Manchus."},{"id":"manas-2010:p1390:b001:l018","ordinal":60114,"en":"Among the Chinese, the people of forty khans,"},{"id":"manas-2010:p1390:b001:l019","ordinal":60115,"en":"After Karykan,"},{"id":"manas-2010:p1390:b001:l020","ordinal":60116,"en":"He is the one they bow before."},{"id":"manas-2010:p1390:b001:l021","ordinal":60117,"en":"From of old, for the city of Beijing,"},{"id":"manas-2010:p1390:b001:l022","ordinal":60118,"en":"He is of immeasurable worth;"},{"id":"manas-2010:p1390:b001:l023","ordinal":60119,"en":"He is the one who finds counsel,"},{"id":"manas-2010:p1390:b001:l024","ordinal":60120,"en":"The shouting Chinese people's"},{"id":"manas-2010:p1390:b001:l025","ordinal":60121,"en":"Warrior like Bakay."},{"id":"manas-2010:p1390:b001:l026","ordinal":60122,"en":"There is no profit in killing him,"},{"id":"manas-2010:p1390:b001:l027","ordinal":60123,"en":"No prize for the massed army."},{"id":"manas-2010:p1390:b001:l028","ordinal":60124,"en":"Better heed my words:"},{"id":"manas-2010:p1390:b001:l029","ordinal":60125,"en":"Let us keep Ezkara in our hands."},{"id":"manas-2010:p1390:b001:l030","ordinal":60126,"en":"Let us secure his forty princes;"},{"id":"manas-2010:p1390:b001:l031","ordinal":60127,"en":"As an envoy to Esenkan,"},{"id":"manas-2010:p1390:b001:l032","ordinal":60128,"en":"To accompany Azhybay,"},{"id":"manas-2010:p1390:b001:l033","ordinal":60129,"en":"Let us give one of his princes."},{"id":"manas-2010:p1390:b001:l034","ordinal":60130,"en":"If he gives up Beijing,"},{"id":"manas-2010:p1390:b001:l035","ordinal":60131,"en":"My champion, you yourself,"},{"id":"manas-2010:p1390:b001:l036","ordinal":60132,"en":"Wrapping a crown about your head,"},{"id":"manas-2010:p1390:b001:l037","ordinal":60133,"en":"Placing a throne beneath you,"},{"id":"manas-2010:p1390:b001:l038","ordinal":60134,"en":"Let us raise you up as khan!"},{"id":"manas-2010:p1390:b001:l039","ordinal":60135,"en":"If the Chinese will not give up Beijing,"},{"id":"manas-2010:p1390:b001:l040","ordinal":60136,"en":"Ezkara lying bound,"},{"id":"manas-2010:p1390:b001:l041","ordinal":60137,"en":"Together with his princes,"},{"id":"manas-2010:p1390:b001:l042","ordinal":60138,"en":"Let us slaughter then."},{"id":"manas-2010:p1391:b001:l001","ordinal":60139,"en":"Once we have slaughtered these men,"},{"id":"manas-2010:p1391:b001:l002","ordinal":60140,"en":"Against Beijing's massed Chinese,"},{"id":"manas-2010:p1391:b001:l003","ordinal":60141,"en":"Let us wage war on the Chinese."},{"id":"manas-2010:p1391:b001:l004","ordinal":60142,"en":"Let us destroy their Outer Beijing,"},{"id":"manas-2010:p1391:b001:l005","ordinal":60143,"en":"Drive them into Great Beijing,"},{"id":"manas-2010:p1391:b001:l006","ordinal":60144,"en":"And upon their cherished Beijing"},{"id":"manas-2010:p1391:b001:l007","ordinal":60145,"en":"Let us bring true torment!"},{"id":"manas-2010:p1391:b001:l008","ordinal":60146,"en":"Slaughtering and destroying their people,"},{"id":"manas-2010:p1391:b001:l009","ordinal":60147,"en":"Their gold, silver and precious stones"},{"id":"manas-2010:p1391:b001:l010","ordinal":60148,"en":"Let us then plunder."},{"id":"manas-2010:p1391:b001:l011","ordinal":60149,"en":"To Keng-Kol and Talas,"},{"id":"manas-2010:p1391:b001:l012","ordinal":60150,"en":"To the great mass of common people,"},{"id":"manas-2010:p1391:b001:l013","ordinal":60151,"en":"Let us return with spoils!”"},{"id":"manas-2010:p1391:b001:l014","ordinal":60152,"en":"When they heard these words,"},{"id":"manas-2010:p1391:b001:l015","ordinal":60153,"en":"With Khan Bakay at their head,"},{"id":"manas-2010:p1391:b001:l016","ordinal":60154,"en":"All took counsel"},{"id":"manas-2010:p1391:b001:l017","ordinal":60155,"en":"And gathered together."},{"id":"manas-2010:p1391:b001:l018","ordinal":60156,"en":"Then Almambet stood and said:"},{"id":"manas-2010:p1391:b001:l019","ordinal":60157,"en":"“Come, you most skilled of spearmen;"},{"id":"manas-2010:p1391:b001:l020","ordinal":60158,"en":"Come, you masters of eloquence;"},{"id":"manas-2010:p1391:b001:l021","ordinal":60159,"en":"Come, you fearless as wolves;"},{"id":"manas-2010:p1391:b001:l022","ordinal":60160,"en":"Come, you firm in your promises;"}]
