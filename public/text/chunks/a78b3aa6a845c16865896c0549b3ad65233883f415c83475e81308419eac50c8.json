[{"id":"seytek-2012:p0391:b002:l010","ordinal":323329,"en":"To subdue the mad Kanchoro,"},{"id":"seytek-2012:p0391:b002:l011","ordinal":323330,"en":"To destroy him and spill his blood,"},{"id":"seytek-2012:p0391:b002:l012","ordinal":323331,"en":"To do all that she knew how,"},{"id":"seytek-2012:p0391:b002:l013","ordinal":323332,"en":"To drink his blood by the spoonful,"},{"id":"seytek-2012:p0391:b002:l014","ordinal":323333,"en":"The heroically formed Aichürök"},{"id":"seytek-2012:p0391:b002:l015","ordinal":323334,"en":"Struck out in front."},{"id":"seytek-2012:p0391:b002:l016","ordinal":323335,"en":"Following behind them"},{"id":"seytek-2012:p0391:b002:l017","ordinal":323336,"en":"Came the finest of the long-haired,"},{"id":"seytek-2012:p0391:b002:l018","ordinal":323337,"en":"The worthiest of women,"},{"id":"seytek-2012:p0391:b002:l019","ordinal":323338,"en":"The purest in a flowing gown,"},{"id":"seytek-2012:p0391:b002:l020","ordinal":323339,"en":"The foremost wife ever born,"},{"id":"seytek-2012:p0391:b002:l021","ordinal":323340,"en":"Your aged mother Kanykey,"},{"id":"seytek-2012:p0391:b002:l022","ordinal":323341,"en":"Coming into this horde"},{"id":"seytek-2012:p0391:b002:l023","ordinal":323342,"en":"To take her ancient vengeance"},{"id":"seytek-2012:p0391:b002:l024","ordinal":323343,"en":"On blood-spilling Kanchoro,"},{"id":"seytek-2012:p0391:b002:l025","ordinal":323344,"en":"To prove her breast milk pure"},{"id":"seytek-2012:p0391:b002:l026","ordinal":323345,"en":"By offering him as a sacrifice,"},{"id":"seytek-2012:p0391:b002:l027","ordinal":323346,"en":"To make his noble head bow,"},{"id":"seytek-2012:p0391:b002:l028","ordinal":323347,"en":"To drink Kanchoro’s blood,"},{"id":"seytek-2012:p0391:b002:l029","ordinal":323348,"en":"And swiftly cut off his head."},{"id":"seytek-2012:p0391:b002:l030","ordinal":323349,"en":"That old conflict held many torments,"},{"id":"seytek-2012:p0391:b002:l031","ordinal":323350,"en":"And she came to take vengeance in full."},{"id":"seytek-2012:p0391:b002:l032","ordinal":323351,"en":"The reason for her vengeance was"},{"id":"seytek-2012:p0391:b002:l033","ordinal":323352,"en":"That he had heaped endless humiliation on her,"},{"id":"seytek-2012:p0391:b002:l034","ordinal":323353,"en":"Beating and stretching her out like a hide."},{"id":"seytek-2012:p0391:b002:l035","ordinal":323354,"en":"He had tied her by the waist"},{"id":"seytek-2012:p0391:b002:l036","ordinal":323355,"en":"To a barren cow’s calf and had her dragged,"},{"id":"seytek-2012:p0391:b002:l037","ordinal":323356,"en":"Thus inflicting his punishment."},{"id":"seytek-2012:p0391:b002:l038","ordinal":323357,"en":"Her aged flesh was torn apart,"},{"id":"seytek-2012:p0391:b002:l039","ordinal":323358,"en":"Not a spoonful of blood remained,"},{"id":"seytek-2012:p0391:b002:l040","ordinal":323359,"en":"And your mother had no strength left."},{"id":"seytek-2012:p0391:b003:l001","ordinal":323360,"en":"She came to hew his executioners into seven pieces"},{"id":"seytek-2012:p0391:b003:l002","ordinal":323361,"en":"And spill their furious blood."},{"id":"seytek-2012:p0391:b003:l003","ordinal":323362,"en":"Dragon-like Kanchoro—"},{"id":"seytek-2012:p0391:b003:l004","ordinal":323363,"en":"Of all the property and boundless wealth remaining,"},{"id":"seytek-2012:p0391:b003:l005","ordinal":323364,"en":"She came to demand what was hers."},{"id":"seytek-2012:p0391:b003:l006","ordinal":323365,"en":"Moon-faced Aichürök,"},{"id":"seytek-2012:p0391:b003:l007","ordinal":323366,"en":"A wonder unlike any mortal,"},{"id":"seytek-2012:p0391:b003:l008","ordinal":323367,"en":"Of serene and stately bearing,"},{"id":"seytek-2012:p0391:b003:l009","ordinal":323368,"en":"Precious as a fairy,"},{"id":"seytek-2012:p0391:b003:l010","ordinal":323369,"en":"Whose curse never missed its mark,"},{"id":"seytek-2012:p0391:b003:l011","ordinal":323370,"en":"Whose wrath was never spent in vain—"},{"id":"seytek-2012:p0391:b003:l012","ordinal":323371,"en":"The formidable woman Aichürök"},{"id":"seytek-2012:p0391:b003:l013","ordinal":323372,"en":"Gathered her dear hair, long as river grass,"},{"id":"seytek-2012:p0391:b003:l014","ordinal":323373,"en":"And bound it tightly atop her head."},{"id":"seytek-2012:p0391:b003:l015","ordinal":323374,"en":"The impetuous, ill-fated woman"},{"id":"seytek-2012:p0391:b003:l016","ordinal":323375,"en":"Put on a man’s attire."},{"id":"seytek-2012:p0391:b003:l017","ordinal":323376,"en":"“I shall stand guard for the warrior,” she said,"},{"id":"seytek-2012:p0391:b003:l018","ordinal":323377,"en":"Her supreme courage showing,"},{"id":"seytek-2012:p0391:b003:l019","ordinal":323378,"en":"Springing forward like a doe,"},{"id":"seytek-2012:p0391:b003:l020","ordinal":323379,"en":"Stretching tall as Surayyl,"},{"id":"seytek-2012:p0391:b003:l021","ordinal":323380,"en":"Striding jauntily and eagerly,"},{"id":"seytek-2012:p0391:b003:l022","ordinal":323381,"en":"Arching like a white doe,"},{"id":"seytek-2012:p0391:b003:l023","ordinal":323382,"en":"Rushing on without sparing her life,"},{"id":"seytek-2012:p0391:b003:l024","ordinal":323383,"en":"Driven by a furious spirit."},{"id":"seytek-2012:p0391:b003:l025","ordinal":323384,"en":"Her life, merely held in trust,"},{"id":"seytek-2012:p0391:b003:l026","ordinal":323385,"en":"She staked upon a single hair."},{"id":"seytek-2012:p0391:b003:l027","ordinal":323386,"en":"She broke away in fury,"},{"id":"seytek-2012:p0391:b003:l028","ordinal":323387,"en":"Her heroic courage plain,"},{"id":"seytek-2012:p0391:b003:l029","ordinal":323388,"en":"Her eyes dimmed, her heart aflame;"},{"id":"seytek-2012:p0391:b003:l030","ordinal":323389,"en":"Though many cried out, she strode on."},{"id":"seytek-2012:p0391:b003:l031","ordinal":323390,"en":"When courage rose, the head was forfeit,"},{"id":"seytek-2012:p0391:b003:l032","ordinal":323391,"en":"And from her currant-dark eyes"},{"id":"seytek-2012:p0391:b003:l033","ordinal":323392,"en":"Tears mingled with blood streamed down."},{"id":"seytek-2012:p0391:b003:l034","ordinal":323393,"en":"She began the true battle;"},{"id":"seytek-2012:p0391:b003:l035","ordinal":323394,"en":"Straining every sinew, the poor woman"},{"id":"seytek-2012:p0391:b003:l036","ordinal":323395,"en":"Cast away her fly-like life."},{"id":"seytek-2012:p0391:b003:l037","ordinal":323396,"en":"She summoned fierce resolve;"},{"id":"seytek-2012:p0391:b003:l038","ordinal":323397,"en":"This raging woman cast her precious life"},{"id":"seytek-2012:p0391:b003:l039","ordinal":323398,"en":"Without hesitation upon the black earth."},{"id":"seytek-2012:p0391:b003:l040","ordinal":323399,"en":"His blood draining, he ground his teeth."},{"id":"seytek-2012:p0392:b002:l001","ordinal":323400,"en":"Her heart boiled like fire:"},{"id":"seytek-2012:p0392:b002:l002","ordinal":323401,"en":"“Can an aged soul live forever?"},{"id":"seytek-2012:p0392:b002:l003","ordinal":323402,"en":"Has not the mischief"},{"id":"seytek-2012:p0392:b002:l004","ordinal":323403,"en":"Of wretched Chachykey gone far enough?"},{"id":"seytek-2012:p0392:b002:l005","ordinal":323404,"en":"Despairing of her fly-like life,"},{"id":"seytek-2012:p0392:b002:l006","ordinal":323405,"en":"Behind Aichürök"},{"id":"seytek-2012:p0392:b002:l007","ordinal":323406,"en":"Kanykey came running."},{"id":"seytek-2012:p0392:b002:l008","ordinal":323407,"en":"“Kanchoro has always been fierce."},{"id":"seytek-2012:p0392:b002:l009","ordinal":323408,"en":"My dear son Külchoro"},{"id":"seytek-2012:p0392:b002:l010","ordinal":323409,"en":"Has always been tenderhearted."},{"id":"seytek-2012:p0392:b002:l011","ordinal":323410,"en":"If they stand face-to-face,"},{"id":"seytek-2012:p0392:b002:l012","ordinal":323411,"en":"Thrusting spears and striking with axes,"},{"id":"seytek-2012:p0392:b002:l013","ordinal":323412,"en":"Battering each other in combat,"},{"id":"seytek-2012:p0392:b002:l014","ordinal":323413,"en":"Taking up Zulfiqar-like spears,"},{"id":"seytek-2012:p0392:b002:l015","ordinal":323414,"en":"Driving them into living hearts,"},{"id":"seytek-2012:p0392:b002:l016","ordinal":323415,"en":"And fighting without measure;"},{"id":"seytek-2012:p0392:b002:l017","ordinal":323416,"en":"If they begin a dreadful conflict"},{"id":"seytek-2012:p0392:b002:l018","ordinal":323417,"en":"And stake lives frail as flies"},{"id":"seytek-2012:p0392:b002:l019","ordinal":323418,"en":"Upon a single hair;"},{"id":"seytek-2012:p0392:b002:l020","ordinal":323419,"en":"If they begin a slaughtering battle,"},{"id":"seytek-2012:p0392:b002:l021","ordinal":323420,"en":"When blades are drawn aslant,"},{"id":"seytek-2012:p0392:b002:l022","ordinal":323421,"en":"The sword will blaze with heat"},{"id":"seytek-2012:p0392:b002:l023","ordinal":323422,"en":"As they grapple till they are cherry-red—"},{"id":"seytek-2012:p0392:b002:l024","ordinal":323423,"en":"Such is the ruin of furious war."},{"id":"seytek-2012:p0392:b002:l025","ordinal":323424,"en":"If by chance the fatal hour arrives"},{"id":"seytek-2012:p0392:b002:l026","ordinal":323425,"en":"In a struggle such as this,"},{"id":"seytek-2012:p0392:b002:l027","ordinal":323426,"en":"Kanchoro, who guarded the horde and ruled the people,"},{"id":"seytek-2012:p0392:b002:l028","ordinal":323427,"en":"Who mounted and held the golden throne,"},{"id":"seytek-2012:p0392:b002:l029","ordinal":323428,"en":"Who never suffered torment or humiliation"},{"id":"seytek-2012:p0392:b002:l030","ordinal":323429,"en":"But grazed freely on broad pastures,"},{"id":"seytek-2012:p0392:b002:l031","ordinal":323430,"en":"Whose five fingers never lacked grease,"},{"id":"seytek-2012:p0392:b002:l032","ordinal":323431,"en":"Whose marrow no arrow could pierce—"},{"id":"seytek-2012:p0392:b002:l033","ordinal":323432,"en":"Black-hearted Kanchoro"},{"id":"seytek-2012:p0392:b002:l034","ordinal":323433,"en":"Will wage the clash savagely."},{"id":"seytek-2012:p0392:b002:l035","ordinal":323434,"en":"By what means will he seize"},{"id":"seytek-2012:p0392:b002:l036","ordinal":323435,"en":"My only son, my sole protector?"},{"id":"seytek-2012:p0392:b002:l037","ordinal":323436,"en":"Only lately recovered from slavery,"},{"id":"seytek-2012:p0392:b002:l038","ordinal":323437,"en":"Grown strong after years of misery,"},{"id":"seytek-2012:p0392:b002:l039","ordinal":323438,"en":"His shoulders only newly filled out,"},{"id":"seytek-2012:p0392:b002:l040","ordinal":323439,"en":"My lion was pure steel."},{"id":"seytek-2012:p0392:b003:l001","ordinal":323440,"en":"Her darkening eyes became clouded;"},{"id":"seytek-2012:p0392:b003:l002","ordinal":323441,"en":"The two servants who kept her alive"},{"id":"seytek-2012:p0392:b003:l003","ordinal":323442,"en":"Stiffened like stakes, palsied,"},{"id":"seytek-2012:p0392:b003:l004","ordinal":323443,"en":"Their chests rasping,"},{"id":"seytek-2012:p0392:b003:l005","ordinal":323444,"en":"Their entire bodies"},{"id":"seytek-2012:p0392:b003:l006","ordinal":323445,"en":"Shuddering beyond control."},{"id":"seytek-2012:p0392:b003:l007","ordinal":323446,"en":"Her twelve bones and limbs"},{"id":"seytek-2012:p0392:b003:l008","ordinal":323447,"en":"Wasted helplessly, wheezing;"},{"id":"seytek-2012:p0392:b003:l009","ordinal":323448,"en":"Her ten vertebrae and eighty joints"},{"id":"seytek-2012:p0392:b003:l010","ordinal":323449,"en":"Crackled, swollen with yellow fluid."},{"id":"seytek-2012:p0392:b003:l011","ordinal":323450,"en":"Her waist sank and her back bent,"},{"id":"seytek-2012:p0392:b003:l012","ordinal":323451,"en":"Her stricken body withered."},{"id":"seytek-2012:p0392:b003:l013","ordinal":323452,"en":"The old lady remained there"},{"id":"seytek-2012:p0392:b003:l014","ordinal":323453,"en":"With her body weakened and diminished,"},{"id":"seytek-2012:p0392:b003:l015","ordinal":323454,"en":"Brought level with the black earth,"},{"id":"seytek-2012:p0392:b003:l016","ordinal":323455,"en":"Left stooped and bent."},{"id":"seytek-2012:p0392:b003:l017","ordinal":323456,"en":"Gripping the doorpost, she ran,"},{"id":"seytek-2012:p0392:b003:l018","ordinal":323457,"en":"Burning and grieving"},{"id":"seytek-2012:p0392:b003:l019","ordinal":323458,"en":"At Kanchoro’s wrath."},{"id":"seytek-2012:p0392:b003:l020","ordinal":323459,"en":"While divinely protected Külchoro,"},{"id":"seytek-2012:p0392:b003:l021","ordinal":323460,"en":"Her precious son, still lived,"},{"id":"seytek-2012:p0392:b003:l022","ordinal":323461,"en":"Kanchoro had humiliated her."},{"id":"seytek-2012:p0392:b003:l023","ordinal":323462,"en":"She came to slash him to pieces,"},{"id":"seytek-2012:p0392:b003:l024","ordinal":323463,"en":"To torture him and bring calamity,"},{"id":"seytek-2012:p0392:b003:l025","ordinal":323464,"en":"To spare not a hair of the villain,"},{"id":"seytek-2012:p0392:b003:l026","ordinal":323465,"en":"But torment him and take his life;"},{"id":"seytek-2012:p0392:b003:l027","ordinal":323466,"en":"To face whatever fate might bring,"},{"id":"seytek-2012:p0392:b003:l028","ordinal":323467,"en":"And stand as a protecting presence"},{"id":"seytek-2012:p0392:b003:l029","ordinal":323468,"en":"Beside her son, the falcon-warrior."},{"id":"seytek-2012:p0392:b003:l030","ordinal":323469,"en":"Your mother Kanykey ran,"},{"id":"seytek-2012:p0392:b003:l031","ordinal":323470,"en":"Flying like an arrow in her joy,"},{"id":"seytek-2012:p0392:b003:l032","ordinal":323471,"en":"Toward Khan Kanchoro’s horde,"},{"id":"seytek-2012:p0392:b003:l033","ordinal":323472,"en":"Ready as a hawk."},{"id":"seytek-2012:p0392:b003:l034","ordinal":323473,"en":"Inspiration came to her from the unseen;"},{"id":"seytek-2012:p0392:b003:l035","ordinal":323474,"en":"She weighed her wits and pondered:"},{"id":"seytek-2012:p0392:b003:l036","ordinal":323475,"en":"“I shall seize and slaughter Kanchoro,"},{"id":"seytek-2012:p0392:b003:l037","ordinal":323476,"en":"And roast the bitch Chachykey"},{"id":"seytek-2012:p0392:b003:l038","ordinal":323477,"en":"For my feast,"},{"id":"seytek-2012:p0392:b003:l039","ordinal":323478,"en":"Then put an end to the grievous misery"},{"id":"seytek-2012:p0392:b003:l040","ordinal":323479,"en":"And all the humiliations I have suffered.”"},{"id":"seytek-2012:p0393:b002:l001","ordinal":323480,"en":"The old guards blocking the road"},{"id":"seytek-2012:p0393:b002:l002","ordinal":323481,"en":"Threw everything down in ruin,"},{"id":"seytek-2012:p0393:b002:l003","ordinal":323482,"en":"Even the bravest among them."},{"id":"seytek-2012:p0393:b002:l004","ordinal":323483,"en":"The hard-pressed guards fled,"},{"id":"seytek-2012:p0393:b002:l005","ordinal":323484,"en":"Scattering their swords on the ridge;"},{"id":"seytek-2012:p0393:b002:l006","ordinal":323485,"en":"Bellowing and stumbling,"},{"id":"seytek-2012:p0393:b002:l007","ordinal":323486,"en":"Many souls fled back."},{"id":"seytek-2012:p0393:b002:l008","ordinal":323487,"en":"When they heard of the hero’s courage,"},{"id":"seytek-2012:p0393:b002:l009","ordinal":323488,"en":"The sentries ran away."},{"id":"seytek-2012:p0393:b002:l010","ordinal":323489,"en":"The many guards scattered in panic"},{"id":"seytek-2012:p0393:b002:l011","ordinal":323490,"en":"And reached their separate homes,"},{"id":"seytek-2012:p0393:b002:l012","ordinal":323491,"en":"Abandoning all their possessions;"},{"id":"seytek-2012:p0393:b002:l013","ordinal":323492,"en":"The swaggering champions"},{"id":"seytek-2012:p0393:b002:l014","ordinal":323493,"en":"Fled each to his own place."},{"id":"seytek-2012:p0393:b002:l015","ordinal":323494,"en":"“The hero’s son has come,” they said,"},{"id":"seytek-2012:p0393:b002:l016","ordinal":323495,"en":"“The apple of Külchoro’s eye;"},{"id":"seytek-2012:p0393:b002:l017","ordinal":323496,"en":"The bloodthirsty hero’s own young champion,"},{"id":"seytek-2012:p0393:b002:l018","ordinal":323497,"en":"For whose feast ninety beasts were slaughtered,"},{"id":"seytek-2012:p0393:b002:l019","ordinal":323498,"en":"Who was named Seytek—"},{"id":"seytek-2012:p0393:b002:l020","ordinal":323499,"en":"The noble one himself has come!”"},{"id":"seytek-2012:p0393:b002:l021","ordinal":323500,"en":"They swiftly invoked Baabedin,"},{"id":"seytek-2012:p0393:b002:l022","ordinal":323501,"en":"Having heard he was the consummate champion."},{"id":"seytek-2012:p0393:b002:l023","ordinal":323502,"en":"They heard that divinely protected Külchoro"},{"id":"seytek-2012:p0393:b002:l024","ordinal":323503,"en":"And hero Seytek had come."},{"id":"seytek-2012:p0393:b002:l025","ordinal":323504,"en":"The champions who had heard of them before"},{"id":"seytek-2012:p0393:b002:l026","ordinal":323505,"en":"Invoked God and slaughtered sheep,"},{"id":"seytek-2012:p0393:b002:l027","ordinal":323506,"en":"Shouting approval and slaughtering colts,"},{"id":"seytek-2012:p0393:b002:l028","ordinal":323507,"en":"And began a mighty celebration."},{"id":"seytek-2012:p0393:b002:l029","ordinal":323508,"en":"They left Kanchoro’s gate"},{"id":"seytek-2012:p0393:b002:l030","ordinal":323509,"en":"Deserted and unguarded."},{"id":"seytek-2012:p0393:b002:l031","ordinal":323510,"en":"They passed it contemptuously;"},{"id":"seytek-2012:p0393:b002:l032","ordinal":323511,"en":"The gatekeepers at the outer entrance,"},{"id":"seytek-2012:p0393:b002:l033","ordinal":323512,"en":"The keepers of the khan’s door,"},{"id":"seytek-2012:p0393:b002:l034","ordinal":323513,"en":"The warriors stationed on watch,"},{"id":"seytek-2012:p0393:b002:l035","ordinal":323514,"en":"And the brave sentries—"},{"id":"seytek-2012:p0393:b002:l036","ordinal":323515,"en":"Every one of them fled."},{"id":"seytek-2012:p0393:b002:l037","ordinal":323516,"en":"The people raised a clamorous uproar"},{"id":"seytek-2012:p0393:b002:l038","ordinal":323517,"en":"And had long since reached"},{"id":"seytek-2012:p0393:b002:l039","ordinal":323518,"en":"The very seat of Kanchoro."},{"id":"seytek-2012:p0393:b002:l040","ordinal":323519,"en":"Her champion and protector"},{"id":"seytek-2012:p0393:b003:l001","ordinal":323520,"en":"Had been wounded in sixty places."},{"id":"seytek-2012:p0393:b003:l002","ordinal":323521,"en":"The blue mountain pass had become a marsh;"},{"id":"seytek-2012:p0393:b003:l003","ordinal":323522,"en":"Little true valor remained"},{"id":"seytek-2012:p0393:b003:l004","ordinal":323523,"en":"Of that lineage now exhausted."},{"id":"seytek-2012:p0393:b003:l005","ordinal":323524,"en":"Few of the bloodline remained;"},{"id":"seytek-2012:p0393:b003:l006","ordinal":323525,"en":"Most of my son’s strength was gone."},{"id":"seytek-2012:p0393:b003:l007","ordinal":323526,"en":"“May that roaring madman"},{"id":"seytek-2012:p0393:b003:l008","ordinal":323527,"en":"Not suddenly bring humiliation upon him."},{"id":"seytek-2012:p0393:b003:l009","ordinal":323528,"en":"While my hair is white as down,"},{"id":"seytek-2012:p0393:b003:l010","ordinal":323529,"en":"As he sets out upon his journey,"},{"id":"seytek-2012:p0393:b003:l011","ordinal":323530,"en":"At the hour when he cannot turn back,"},{"id":"seytek-2012:p0393:b003:l012","ordinal":323531,"en":"Now that the end draws near,"},{"id":"seytek-2012:p0393:b003:l013","ordinal":323532,"en":"Let me die before fate claims me;"},{"id":"seytek-2012:p0393:b003:l014","ordinal":323533,"en":"For my son, small as a crow,"},{"id":"seytek-2012:p0393:b003:l015","ordinal":323534,"en":"Let me grapple and spill his enemy’s blood.”"},{"id":"seytek-2012:p0393:b003:l016","ordinal":323535,"en":"To inflict the utmost torment,"},{"id":"seytek-2012:p0393:b003:l017","ordinal":323536,"en":"And rescue divinely protected Külchoro"},{"id":"seytek-2012:p0393:b003:l018","ordinal":323537,"en":"From the furious swine’s clutches,"},{"id":"seytek-2012:p0393:b003:l019","ordinal":323538,"en":"She hastened onward."},{"id":"seytek-2012:p0393:b003:l020","ordinal":323539,"en":"What had been spoken early now seemed late;"},{"id":"seytek-2012:p0393:b003:l021","ordinal":323540,"en":"Her two eyes strained in longing,"},{"id":"seytek-2012:p0393:b003:l022","ordinal":323541,"en":"Her knees crackled as they bent,"},{"id":"seytek-2012:p0393:b003:l023","ordinal":323542,"en":"Yet summoning her courage, she ran."},{"id":"seytek-2012:p0393:b003:l024","ordinal":323543,"en":"How could she hold herself back?"},{"id":"seytek-2012:p0393:b003:l025","ordinal":323544,"en":"She leaned upon the sharp Albar sword"},{"id":"seytek-2012:p0393:b003:l026","ordinal":323545,"en":"Given by Atash;"},{"id":"seytek-2012:p0393:b003:l027","ordinal":323546,"en":"How could this grief-stricken old woman"},{"id":"seytek-2012:p0393:b003:l028","ordinal":323547,"en":"Possibly spare herself"},{"id":"seytek-2012:p0393:b003:l029","ordinal":323548,"en":"From the dragon’s affliction?"},{"id":"seytek-2012:p0393:b003:l030","ordinal":323549,"en":"Following Aichürök,"},{"id":"seytek-2012:p0393:b003:l031","ordinal":323550,"en":"The venerable white-haired Kanykey,"},{"id":"seytek-2012:p0393:b003:l032","ordinal":323551,"en":"His mother, arrived."},{"id":"seytek-2012:p0393:b003:l033","ordinal":323552,"en":"With a protector, one’s belly is full;"},{"id":"seytek-2012:p0393:b003:l034","ordinal":323553,"en":"Apart from one’s mother, there is no Mecca."},{"id":"seytek-2012:p0393:b003:l035","ordinal":323554,"en":"His mother had arrived,"},{"id":"seytek-2012:p0393:b003:l036","ordinal":323555,"en":"And beside his protector"},{"id":"seytek-2012:p0393:b003:l037","ordinal":323556,"en":"His beloved had arrived."},{"id":"seytek-2012:p0393:b003:l038","ordinal":323557,"en":"Külchoro saw his mother and sister-in-law,"},{"id":"seytek-2012:p0393:b003:l039","ordinal":323558,"en":"He saw his dearest ones."},{"id":"seytek-2012:p0393:b003:l040","ordinal":323559,"en":"When the venerable women came,"},{"id":"seytek-2012:p0394:b002:l001","ordinal":323560,"en":"His body turned cold and trembled,"},{"id":"seytek-2012:p0394:b002:l002","ordinal":323561,"en":"And his wretched life, merely held in trust,"},{"id":"seytek-2012:p0394:b002:l003","ordinal":323562,"en":"Started from his crown and shrieked."},{"id":"seytek-2012:p0394:b002:l004","ordinal":323563,"en":"Finding no place to make a stand,"},{"id":"seytek-2012:p0394:b002:l005","ordinal":323564,"en":"He despaired of his fly-like life;"},{"id":"seytek-2012:p0394:b002:l006","ordinal":323565,"en":"Not a trace of life remained in him."},{"id":"seytek-2012:p0394:b002:l007","ordinal":323566,"en":"His voice deserted his throat,"},{"id":"seytek-2012:p0394:b002:l008","ordinal":323567,"en":"His last owl-like feather fell,"},{"id":"seytek-2012:p0394:b002:l009","ordinal":323568,"en":"And he stood disheveled in anguish,"},{"id":"seytek-2012:p0394:b002:l010","ordinal":323569,"en":"Thus despairing of life."},{"id":"seytek-2012:p0394:b002:l011","ordinal":323570,"en":"His whole body shuddered"},{"id":"seytek-2012:p0394:b002:l012","ordinal":323571,"en":"When he saw Külchoro and Kanykey"},{"id":"seytek-2012:p0394:b002:l013","ordinal":323572,"en":"Together with Aichürök;"},{"id":"seytek-2012:p0394:b002:l014","ordinal":323573,"en":"The wretch found no recourse,"},{"id":"seytek-2012:p0394:b002:l015","ordinal":323574,"en":"And his tiny soul screamed."},{"id":"seytek-2012:p0394:b002:l016","ordinal":323575,"en":"He flew from the throne"},{"id":"seytek-2012:p0394:b002:l017","ordinal":323576,"en":"And crashed upon the ground."},{"id":"seytek-2012:p0394:b002:l018","ordinal":323577,"en":"His head struck the earth,"},{"id":"seytek-2012:p0394:b002:l019","ordinal":323578,"en":"And split open"},{"id":"seytek-2012:p0394:b002:l020","ordinal":323579,"en":"A full span and two fingers wide."},{"id":"seytek-2012:p0394:b002:l021","ordinal":323580,"en":"The oath-breaker was struck by his oath,"},{"id":"seytek-2012:p0394:b002:l022","ordinal":323581,"en":"The accursed was struck by a demon,"},{"id":"seytek-2012:p0394:b002:l023","ordinal":323582,"en":"Struck by the dust of the white horses,"},{"id":"seytek-2012:p0394:b002:l024","ordinal":323583,"en":"Struck by the glory of his father Manas,"},{"id":"seytek-2012:p0394:b002:l025","ordinal":323584,"en":"Struck by the strength of Semetey,"}]
