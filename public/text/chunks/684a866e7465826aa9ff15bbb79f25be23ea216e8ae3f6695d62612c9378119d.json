[{"id":"semetey-1-2013:p1204:b004:l009","ordinal":168961,"en":"Each man had his own desire."},{"id":"semetey-1-2013:p1204:b004:l010","ordinal":168962,"en":"Exactly sixty tanap of cord"},{"id":"semetey-1-2013:p1204:b004:l011","ordinal":168963,"en":"Were tied to that jamby."},{"id":"semetey-1-2013:p1204:b004:l012","ordinal":168964,"en":"They proclaimed it widely:"},{"id":"semetey-1-2013:p1204:b004:l013","ordinal":168965,"en":"\"Your able young marksmen,"},{"id":"semetey-1-2013:p1204:b004:l014","ordinal":168966,"en":"Shoot at the jamby,\" they said."},{"id":"semetey-1-2013:p1204:b004:l015","ordinal":168967,"en":"For shooting the jamby,"},{"id":"semetey-1-2013:p1204:b004:l016","ordinal":168968,"en":"Kongurbay, khan of the Kechils,"},{"id":"semetey-1-2013:p1204:b004:l017","ordinal":168969,"en":"With cotton sash and broad boots,"},{"id":"semetey-1-2013:p1204:b004:l018","ordinal":168970,"en":"Sent out a thousand marksmen."},{"id":"semetey-1-2013:p1204:b004:l019","ordinal":168971,"en":"Khan Joloy of the Kalmyks"},{"id":"semetey-1-2013:p1204:b004:l020","ordinal":168972,"en":"Sent out a thousand marksmen."},{"id":"semetey-1-2013:p1204:b004:l021","ordinal":168973,"en":"Orongu the woman champion"},{"id":"semetey-1-2013:p1204:b004:l022","ordinal":168974,"en":"Sent out a thousand champions."},{"id":"semetey-1-2013:p1204:b004:l023","ordinal":168975,"en":"Muzkindik of the Shibees"},{"id":"semetey-1-2013:p1204:b004:l024","ordinal":168976,"en":"Sent out a thousand marksmen."},{"id":"semetey-1-2013:p1204:b004:l025","ordinal":168977,"en":"Ezkara, khan of the Manchus,"},{"id":"semetey-1-2013:p1204:b004:l026","ordinal":168978,"en":"Sent out a thousand marksmen."},{"id":"semetey-1-2013:p1204:b004:l027","ordinal":168979,"en":"The enormous champion Orokkyr"},{"id":"semetey-1-2013:p1204:b004:l028","ordinal":168980,"en":"Sent out a thousand marksmen."},{"id":"semetey-1-2013:p1204:b004:l029","ordinal":168981,"en":"Jamgyrchy of the Esheks"},{"id":"semetey-1-2013:p1204:b004:l030","ordinal":168982,"en":"Sent out a thousand marksmen."},{"id":"semetey-1-2013:p1204:b004:l031","ordinal":168983,"en":"Muzburchak of Buudayyk"},{"id":"semetey-1-2013:p1204:b004:l032","ordinal":168984,"en":"Sent out a thousand marksmen."},{"id":"semetey-1-2013:p1204:b004:l033","ordinal":168985,"en":"Hero Toshtuk of Eleman"},{"id":"semetey-1-2013:p1204:b004:l034","ordinal":168986,"en":"Sent out a thousand marksmen."},{"id":"semetey-1-2013:p1204:b004:l035","ordinal":168987,"en":"Khan Kokcho of the Kazakhs"},{"id":"semetey-1-2013:p1204:b004:l036","ordinal":168988,"en":"Sent out a thousand marksmen."},{"id":"semetey-1-2013:p1204:b004:l037","ordinal":168989,"en":"Kozubek of Kokon Khan"},{"id":"semetey-1-2013:p1204:b005:l001","ordinal":168990,"en":"Sent out a thousand marksmen."},{"id":"semetey-1-2013:p1204:b005:l002","ordinal":168991,"en":"Fork-bearded Synchybek of Andijan"},{"id":"semetey-1-2013:p1204:b005:l003","ordinal":168992,"en":"Sent out a thousand marksmen."},{"id":"semetey-1-2013:p1204:b005:l004","ordinal":168993,"en":"Alabek of the Six Cities"},{"id":"semetey-1-2013:p1204:b005:l005","ordinal":168994,"en":"Sent out a thousand marksmen."},{"id":"semetey-1-2013:p1204:b005:l006","ordinal":168995,"en":"Akun Khan, khan of Afghanistan,"},{"id":"semetey-1-2013:p1204:b005:l007","ordinal":168996,"en":"Sent out a thousand marksmen."},{"id":"semetey-1-2013:p1204:b005:l008","ordinal":168997,"en":"The pair Janaaly and Karach"},{"id":"semetey-1-2013:p1204:b005:l009","ordinal":168998,"en":"Sent out a thousand marksmen."},{"id":"semetey-1-2013:p1204:b005:l010","ordinal":168999,"en":"Kokboru, son of Urum Khan,"},{"id":"semetey-1-2013:p1204:b005:l011","ordinal":169000,"en":"Sent out a thousand marksmen."},{"id":"semetey-1-2013:p1204:b005:l012","ordinal":169001,"en":"At the foot of that jamby,"},{"id":"semetey-1-2013:p1204:b005:l013","ordinal":169002,"en":"Their guns rattling,"},{"id":"semetey-1-2013:p1204:b005:l014","ordinal":169003,"en":"The marksmen came leaping forward."},{"id":"semetey-1-2013:p1204:b005:l015","ordinal":169004,"en":"For the marksmen's spectacle,"},{"id":"semetey-1-2013:p1204:b005:l016","ordinal":169005,"en":"They clenched their whips in their teeth"},{"id":"semetey-1-2013:p1204:b005:l017","ordinal":169006,"en":"And urged their horses onward."},{"id":"semetey-1-2013:p1204:b005:l018","ordinal":169007,"en":"All the marksmen"},{"id":"semetey-1-2013:p1204:b005:l019","ordinal":169008,"en":"Stretched their necks,"},{"id":"semetey-1-2013:p1204:b005:l020","ordinal":169009,"en":"Their matchcords glowing red."},{"id":"semetey-1-2013:p1204:b005:l021","ordinal":169010,"en":"He raised a flag by the jamby;"},{"id":"semetey-1-2013:p1204:b005:l022","ordinal":169011,"en":"The frantic Bokmurun"},{"id":"semetey-1-2013:p1204:b005:l023","ordinal":169012,"en":"Raised a clamor among the people."},{"id":"semetey-1-2013:p1204:b005:l024","ordinal":169013,"en":"They fired in waves of thousands,"},{"id":"semetey-1-2013:p1204:b005:l025","ordinal":169014,"en":"But lay unable to hit it."},{"id":"semetey-1-2013:p1204:b005:l026","ordinal":169015,"en":"Stray bullets flew unknowingly,"},{"id":"semetey-1-2013:p1204:b005:l027","ordinal":169016,"en":"And many died there."},{"id":"semetey-1-2013:p1204:b005:l028","ordinal":169017,"en":"Many watched"},{"id":"semetey-1-2013:p1204:b005:l029","ordinal":169018,"en":"What the Almighty had wrought."},{"id":"semetey-1-2013:p1204:b005:l030","ordinal":169019,"en":"Many tilted their bows"},{"id":"semetey-1-2013:p1204:b005:l031","ordinal":169020,"en":"And went about drawing them."},{"id":"semetey-1-2013:p1204:b005:l032","ordinal":169021,"en":"Can a person be sated with wealth?"},{"id":"semetey-1-2013:p1204:b005:l033","ordinal":169022,"en":"Many were immersed"},{"id":"semetey-1-2013:p1204:b005:l034","ordinal":169023,"en":"In a spectacle no man had seen."},{"id":"semetey-1-2013:p1204:b005:l035","ordinal":169024,"en":"Heroes who deemed themselves heroes"},{"id":"semetey-1-2013:p1204:b005:l036","ordinal":169025,"en":"Were torn from beneath their mounts,"},{"id":"semetey-1-2013:p1204:b005:l037","ordinal":169026,"en":"As black smoke billowed,"},{"id":"semetey-1-2013:p1205:b003:l001","ordinal":169027,"en":"Grain powder roasted in the guns;"},{"id":"semetey-1-2013:p1205:b003:l002","ordinal":169028,"en":"The long guns cracked,"},{"id":"semetey-1-2013:p1205:b003:l003","ordinal":169029,"en":"The short guns shrieked,"},{"id":"semetey-1-2013:p1205:b003:l004","ordinal":169030,"en":"The ochogor guns boomed,"},{"id":"semetey-1-2013:p1205:b003:l005","ordinal":169031,"en":"And the syrbarang guns thundered."},{"id":"semetey-1-2013:p1205:b003:l006","ordinal":169032,"en":"The jamby stood unmoving."},{"id":"semetey-1-2013:p1205:b003:l007","ordinal":169033,"en":"With cotton sash and broad boots,"},{"id":"semetey-1-2013:p1205:b003:l008","ordinal":169034,"en":"Kongurbay, khan of the Kechils,"},{"id":"semetey-1-2013:p1205:b003:l009","ordinal":169035,"en":"Stretched tall and fired;"},{"id":"semetey-1-2013:p1205:b003:l010","ordinal":169036,"en":"His archer drew the bow,"},{"id":"semetey-1-2013:p1205:b003:l011","ordinal":169037,"en":"But the jamby did not move."},{"id":"semetey-1-2013:p1205:b003:l012","ordinal":169038,"en":"Ezkara, khan of the Manchus,"},{"id":"semetey-1-2013:p1205:b003:l013","ordinal":169039,"en":"Advanced and fired;"},{"id":"semetey-1-2013:p1205:b003:l014","ordinal":169040,"en":"His shot vanished from sight,"},{"id":"semetey-1-2013:p1205:b003:l015","ordinal":169041,"en":"And no one knew"},{"id":"semetey-1-2013:p1205:b003:l016","ordinal":169042,"en":"Where his bullet had gone."},{"id":"semetey-1-2013:p1205:b003:l017","ordinal":169043,"en":"The Black Kalmyks lamented;"},{"id":"semetey-1-2013:p1205:b003:l018","ordinal":169044,"en":"All the rest"},{"id":"semetey-1-2013:p1205:b003:l019","ordinal":169045,"en":"Shouted in the Kakanchyn tongue"},{"id":"semetey-1-2013:p1205:b003:l020","ordinal":169046,"en":"And fired again, crying out."},{"id":"semetey-1-2013:p1205:b003:l021","ordinal":169047,"en":"The jamby did not bend"},{"id":"semetey-1-2013:p1205:b003:l022","ordinal":169048,"en":"When the infidels shot and passed."},{"id":"semetey-1-2013:p1205:b003:l023","ordinal":169049,"en":"Koshoy charged and arrived;"},{"id":"semetey-1-2013:p1205:b003:l024","ordinal":169050,"en":"Under Koshoy's command"},{"id":"semetey-1-2013:p1205:b003:l025","ordinal":169051,"en":"Were expert marksmen who could shoot an eye."},{"id":"semetey-1-2013:p1205:b003:l026","ordinal":169052,"en":"With your uncle Koshoy at their head,"},{"id":"semetey-1-2013:p1205:b003:l027","ordinal":169053,"en":"The specialists came."},{"id":"semetey-1-2013:p1205:b003:l028","ordinal":169054,"en":"Closing in with a thousand marksmen,"},{"id":"semetey-1-2013:p1205:b003:l029","ordinal":169055,"en":"Koshoy kept firing,"},{"id":"semetey-1-2013:p1205:b003:l030","ordinal":169056,"en":"But the jamby did not stir or twitch,"},{"id":"semetey-1-2013:p1205:b003:l031","ordinal":169057,"en":"Nor shift or quiver."},{"id":"semetey-1-2013:p1205:b003:l032","ordinal":169058,"en":"They fired turn by turn"},{"id":"semetey-1-2013:p1205:b003:l033","ordinal":169059,"en":"And lay taking turns."},{"id":"semetey-1-2013:p1205:b003:l034","ordinal":169060,"en":"All the marksmen side by side"},{"id":"semetey-1-2013:p1205:b003:l035","ordinal":169061,"en":"Saw such a spectacle."},{"id":"semetey-1-2013:p1205:b003:l036","ordinal":169062,"en":"All their bullets whistled,"},{"id":"semetey-1-2013:p1205:b003:l037","ordinal":169063,"en":"Flashed like stars,"},{"id":"semetey-1-2013:p1205:b003:l038","ordinal":169064,"en":"And from the ochogor's mouth"},{"id":"semetey-1-2013:p1205:b003:l039","ordinal":169065,"en":"Smoke billowed like a chimney."},{"id":"semetey-1-2013:p1205:b004:l001","ordinal":169066,"en":"The marksmen craned forward,"},{"id":"semetey-1-2013:p1205:b004:l002","ordinal":169067,"en":"The bowmen stood on tiptoe."},{"id":"semetey-1-2013:p1205:b004:l003","ordinal":169068,"en":"Toshtuk entered and fired,"},{"id":"semetey-1-2013:p1205:b004:l004","ordinal":169069,"en":"But the jamby did not bend."},{"id":"semetey-1-2013:p1205:b004:l005","ordinal":169070,"en":"They raced and shot;"},{"id":"semetey-1-2013:p1205:b004:l006","ordinal":169071,"en":"Infidel and Muslim"},{"id":"semetey-1-2013:p1205:b004:l007","ordinal":169072,"en":"Fired in alternation,"},{"id":"semetey-1-2013:p1205:b004:l008","ordinal":169073,"en":"Over Kökötöi's jamby,"},{"id":"semetey-1-2013:p1205:b004:l009","ordinal":169074,"en":"They remained absorbed in the contest."},{"id":"semetey-1-2013:p1205:b004:l010","ordinal":169075,"en":"Infidel and Muslim"},{"id":"semetey-1-2013:p1205:b004:l011","ordinal":169076,"en":"Brought strength to their khans;"},{"id":"semetey-1-2013:p1205:b004:l012","ordinal":169077,"en":"It became a deed never forgotten"},{"id":"semetey-1-2013:p1205:b004:l013","ordinal":169078,"en":"Until the end of the age."},{"id":"semetey-1-2013:p1205:b004:l014","ordinal":169079,"en":"Powder shook from their breastplates."},{"id":"semetey-1-2013:p1205:b004:l015","ordinal":169080,"en":"\"This is an ill-starred game,\" they said,"},{"id":"semetey-1-2013:p1205:b004:l016","ordinal":169081,"en":"And the khans despaired of life."},{"id":"semetey-1-2013:p1205:b004:l017","ordinal":169082,"en":"When the people had lost hope,"},{"id":"semetey-1-2013:p1205:b004:l018","ordinal":169083,"en":"Saintly hero Bakay,"},{"id":"semetey-1-2013:p1205:b004:l019","ordinal":169084,"en":"Follower of Khan Manas—"},{"id":"semetey-1-2013:p1205:b004:l020","ordinal":169085,"en":"His sacred power was immense;"},{"id":"semetey-1-2013:p1205:b004:l021","ordinal":169086,"en":"Surely dear Bakay was no common man."},{"id":"semetey-1-2013:p1205:b004:l022","ordinal":169087,"en":"He whipped his blue tulpar,"},{"id":"semetey-1-2013:p1205:b004:l023","ordinal":169088,"en":"Rode up and fired once,"},{"id":"semetey-1-2013:p1205:b004:l024","ordinal":169089,"en":"And cut through one tanap of cord."},{"id":"semetey-1-2013:p1205:b004:l025","ordinal":169090,"en":"Making Kartkurong prance,"},{"id":"semetey-1-2013:p1205:b004:l026","ordinal":169091,"en":"Agybay of Argyn Khan"},{"id":"semetey-1-2013:p1205:b004:l027","ordinal":169092,"en":"Rode up and fired once,"},{"id":"semetey-1-2013:p1205:b004:l028","ordinal":169093,"en":"And cut through one tanap of cord."},{"id":"semetey-1-2013:p1205:b004:l029","ordinal":169094,"en":"He who turned from the black faith to the true,"},{"id":"semetey-1-2013:p1205:b004:l030","ordinal":169095,"en":"Who fled the infidels and became an exile,"},{"id":"semetey-1-2013:p1205:b004:l031","ordinal":169096,"en":"Almambet rode up and fired once,"},{"id":"semetey-1-2013:p1205:b004:l032","ordinal":169097,"en":"And cut through one tanap of cord."},{"id":"semetey-1-2013:p1205:b004:l033","ordinal":169098,"en":"Wearing a blue rapys coat,"},{"id":"semetey-1-2013:p1205:b004:l034","ordinal":169099,"en":"Mounted on a mottled blue horse,"},{"id":"semetey-1-2013:p1205:b004:l035","ordinal":169100,"en":"Whom no wrestler could overpower"},{"id":"semetey-1-2013:p1205:b004:l036","ordinal":169101,"en":"And no lion's tooth could pierce,"},{"id":"semetey-1-2013:p1205:b004:l037","ordinal":169102,"en":"Chubak rode up and fired once,"},{"id":"semetey-1-2013:p1205:b004:l038","ordinal":169103,"en":"And cut through one tanap of cord."},{"id":"semetey-1-2013:p1206:b003:l001","ordinal":169104,"en":"The finest of sixty,"},{"id":"semetey-1-2013:p1206:b003:l002","ordinal":169105,"en":"Best of the forty companions,"},{"id":"semetey-1-2013:p1206:b003:l003","ordinal":169106,"en":"Blade of black steel,"},{"id":"semetey-1-2013:p1206:b003:l004","ordinal":169107,"en":"Syrgak of Khan Manas,"},{"id":"semetey-1-2013:p1206:b003:l005","ordinal":169108,"en":"Rode up and fired once too,"},{"id":"semetey-1-2013:p1206:b003:l006","ordinal":169109,"en":"And cut through one tanap of cord."},{"id":"semetey-1-2013:p1206:b003:l007","ordinal":169110,"en":"Yrchyuul, son of Yraman,"},{"id":"semetey-1-2013:p1206:b003:l008","ordinal":169111,"en":"With forty tassels at his waistband,"},{"id":"semetey-1-2013:p1206:b003:l009","ordinal":169112,"en":"Rode up and fired once too,"},{"id":"semetey-1-2013:p1206:b003:l010","ordinal":169113,"en":"And cut through one tanap of cord."},{"id":"semetey-1-2013:p1206:b003:l011","ordinal":169114,"en":"Hero Shuutu in his tent-shaped kalpak"},{"id":"semetey-1-2013:p1206:b003:l012","ordinal":169115,"en":"Came and fired once too,"},{"id":"semetey-1-2013:p1206:b003:l013","ordinal":169116,"en":"And cut through one tanap of cord."},{"id":"semetey-1-2013:p1206:b003:l014","ordinal":169117,"en":"Kuldur and Chalybay"},{"id":"semetey-1-2013:p1206:b003:l015","ordinal":169118,"en":"Arrived abreast and fired once,"},{"id":"semetey-1-2013:p1206:b003:l016","ordinal":169119,"en":"Cutting through one tanap of cord."},{"id":"semetey-1-2013:p1206:b003:l017","ordinal":169120,"en":"Kyrgylchal, head of the forty,"},{"id":"semetey-1-2013:p1206:b003:l018","ordinal":169121,"en":"Came and fired once too,"},{"id":"semetey-1-2013:p1206:b003:l019","ordinal":169122,"en":"And cut through one tanap of cord."},{"id":"semetey-1-2013:p1206:b003:l020","ordinal":169123,"en":"The red-chested hero,"},{"id":"semetey-1-2013:p1206:b003:l021","ordinal":169124,"en":"The valiant man who shook the age,"},{"id":"semetey-1-2013:p1206:b003:l022","ordinal":169125,"en":"Bozuul came and fired once,"},{"id":"semetey-1-2013:p1206:b003:l023","ordinal":169126,"en":"And cut through one tanap of cord."},{"id":"semetey-1-2013:p1206:b003:l024","ordinal":169127,"en":"Like a stack of white wheat,"},{"id":"semetey-1-2013:p1206:b003:l025","ordinal":169128,"en":"He too was Manas's companion:"},{"id":"semetey-1-2013:p1206:b003:l026","ordinal":169129,"en":"Merry Tazbaymat"},{"id":"semetey-1-2013:p1206:b003:l027","ordinal":169130,"en":"Arrived and fired once too,"},{"id":"semetey-1-2013:p1206:b003:l028","ordinal":169131,"en":"Cutting through one tanap of cord."},{"id":"semetey-1-2013:p1206:b003:l029","ordinal":169132,"en":"His jester Majik"},{"id":"semetey-1-2013:p1206:b003:l030","ordinal":169133,"en":"Arrived and fired once too,"},{"id":"semetey-1-2013:p1206:b003:l031","ordinal":169134,"en":"And cut through one tanap of cord."},{"id":"semetey-1-2013:p1206:b003:l032","ordinal":169135,"en":"Black Tologu the diviner,"},{"id":"semetey-1-2013:p1206:b003:l033","ordinal":169136,"en":"Whose divination surpassed the people's,"},{"id":"semetey-1-2013:p1206:b003:l034","ordinal":169137,"en":"Rode up and fired once too,"},{"id":"semetey-1-2013:p1206:b003:l035","ordinal":169138,"en":"And cut through one tanap of cord."},{"id":"semetey-1-2013:p1206:b003:l036","ordinal":169139,"en":"Carefree Serek,"},{"id":"semetey-1-2013:p1206:b003:l037","ordinal":169140,"en":"Useful to Khan Manas,"},{"id":"semetey-1-2013:p1206:b003:l038","ordinal":169141,"en":"Arrived and fired once too,"},{"id":"semetey-1-2013:p1206:b004:l001","ordinal":169142,"en":"And cut through one tanap of cord."},{"id":"semetey-1-2013:p1206:b004:l002","ordinal":169143,"en":"Manas had many companions;"},{"id":"semetey-1-2013:p1206:b004:l003","ordinal":169144,"en":"Strongest of them all was Agayar."},{"id":"semetey-1-2013:p1206:b004:l004","ordinal":169145,"en":"When he grew angry,"},{"id":"semetey-1-2013:p1206:b004:l005","ordinal":169146,"en":"He began a great tumult;"},{"id":"semetey-1-2013:p1206:b004:l006","ordinal":169147,"en":"When his true wrath came,"},{"id":"semetey-1-2013:p1206:b004:l007","ordinal":169148,"en":"He could strike down a camel."},{"id":"semetey-1-2013:p1206:b004:l008","ordinal":169149,"en":"Camel-lifting Agayar"},{"id":"semetey-1-2013:p1206:b004:l009","ordinal":169150,"en":"Arrived and fired once too,"},{"id":"semetey-1-2013:p1206:b004:l010","ordinal":169151,"en":"And cut through one tanap of cord."},{"id":"semetey-1-2013:p1206:b004:l011","ordinal":169152,"en":"Baychoro of the twin Olon"},{"id":"semetey-1-2013:p1206:b004:l012","ordinal":169153,"en":"Rushed forward on Aksur,"},{"id":"semetey-1-2013:p1206:b004:l013","ordinal":169154,"en":"Arrived and fired once too,"},{"id":"semetey-1-2013:p1206:b004:l014","ordinal":169155,"en":"And cut through one tanap of cord."},{"id":"semetey-1-2013:p1206:b004:l015","ordinal":169156,"en":"The torment of this jamby"},{"id":"semetey-1-2013:p1206:b004:l016","ordinal":169157,"en":"Spread throughout the world."},{"id":"semetey-1-2013:p1206:b004:l017","ordinal":169158,"en":"Only one cord of the jamby"},{"id":"semetey-1-2013:p1206:b004:l018","ordinal":169159,"en":"Remained dangling."},{"id":"semetey-1-2013:p1206:b004:l019","ordinal":169160,"en":"His renown weighty, his name great,"},{"id":"semetey-1-2013:p1206:b004:l020","ordinal":169161,"en":"His spirit lofty, an immense lion,"},{"id":"semetey-1-2013:p1206:b004:l021","ordinal":169162,"en":"Who subdued many lands"},{"id":"semetey-1-2013:p1206:b004:l022","ordinal":169163,"en":"And was created fortunate—"},{"id":"semetey-1-2013:p1206:b004:l023","ordinal":169164,"en":"His name was lion Manas."},{"id":"semetey-1-2013:p1206:b004:l024","ordinal":169165,"en":"Generous Manas arrived;"},{"id":"semetey-1-2013:p1206:b004:l025","ordinal":169166,"en":"The bloodletter came and fired once,"},{"id":"semetey-1-2013:p1206:b004:l026","ordinal":169167,"en":"Cutting through the final cord."},{"id":"semetey-1-2013:p1206:b004:l027","ordinal":169168,"en":"Your hero brought down the jamby."},{"id":"semetey-1-2013:p1206:b004:l028","ordinal":169169,"en":"The forty companions of Khan Manas"},{"id":"semetey-1-2013:p1206:b004:l029","ordinal":169170,"en":"Had staked Kokotoy's treasury"},{"id":"semetey-1-2013:p1206:b004:l030","ordinal":169171,"en":"As the prize;"},{"id":"semetey-1-2013:p1206:b004:l031","ordinal":169172,"en":"Your precious Manas won"},{"id":"semetey-1-2013:p1206:b004:l032","ordinal":169173,"en":"The contest in motion."},{"id":"semetey-1-2013:p1206:b004:l033","ordinal":169174,"en":"When Manas won the jamby,"},{"id":"semetey-1-2013:p1206:b004:l034","ordinal":169175,"en":"When all forty had reached"},{"id":"semetey-1-2013:p1206:b004:l035","ordinal":169176,"en":"The worldly prize,"},{"id":"semetey-1-2013:p1206:b004:l036","ordinal":169177,"en":"They shot down the jamby;"},{"id":"semetey-1-2013:p1206:b004:l037","ordinal":169178,"en":"Thus the forty companions of Khan Manas"},{"id":"semetey-1-2013:p1206:b004:l038","ordinal":169179,"en":"Came into their inheritance."},{"id":"semetey-1-2013:p1207:b004:l001","ordinal":169180,"en":"Let us leave this matter here."},{"id":"semetey-1-2013:p1207:b004:l002","ordinal":169181,"en":"There are racehorses sent to run,"},{"id":"semetey-1-2013:p1207:b004:l003","ordinal":169182,"en":"And infidel and Muslim"},{"id":"semetey-1-2013:p1207:b004:l004","ordinal":169183,"en":"May raise a commotion."},{"id":"semetey-1-2013:p1207:b004:l005","ordinal":169184,"en":"Each man's head bears a burden;"},{"id":"semetey-1-2013:p1207:b004:l006","ordinal":169185,"en":"There is the duty of cheering a horse."},{"id":"semetey-1-2013:p1207:b004:l007","ordinal":169186,"en":"Infidel and Muslim"},{"id":"semetey-1-2013:p1207:b004:l008","ordinal":169187,"en":"Have chosen racehorses they entered."},{"id":"semetey-1-2013:p1207:b004:l009","ordinal":169188,"en":"There are tulpars born among horses,"},{"id":"semetey-1-2013:p1207:b004:l010","ordinal":169189,"en":"And a plain no winged creature can cross."},{"id":"semetey-1-2013:p1207:b004:l011","ordinal":169190,"en":"If a quarrel starts from a small thing,"},{"id":"semetey-1-2013:p1207:b004:l012","ordinal":169191,"en":"There is a danger that infidel and Muslim"},{"id":"semetey-1-2013:p1207:b004:l013","ordinal":169192,"en":"Will slaughter one another."},{"id":"semetey-1-2013:p1207:b004:l014","ordinal":169193,"en":"The swift Maaniker is among"},{"id":"semetey-1-2013:p1207:b004:l015","ordinal":169194,"en":"The horses driven away."},{"id":"semetey-1-2013:p1207:b004:l016","ordinal":169195,"en":"If an opportunity comes, the Chinese"},{"id":"semetey-1-2013:p1207:b004:l017","ordinal":169196,"en":"Have deeds they may perform."},{"id":"semetey-1-2013:p1207:b004:l018","ordinal":169197,"en":"There is the source of much strife,"},{"id":"semetey-1-2013:p1207:b004:l019","ordinal":169198,"en":"And there is Kokotoy's feast."},{"id":"semetey-1-2013:p1207:b004:l020","ordinal":169199,"en":"Gray-maned Bakay began to speak,"},{"id":"semetey-1-2013:p1207:b004:l021","ordinal":169200,"en":"Letting his words run obliquely."},{"id":"semetey-1-2013:p1207:b004:l022","ordinal":169201,"en":"This is what Bakay said:"},{"id":"semetey-1-2013:p1207:b004:l023","ordinal":169202,"en":"\"O people of the Muslim faith,"},{"id":"semetey-1-2013:p1207:b004:l024","ordinal":169203,"en":"Your khan stands here;"},{"id":"semetey-1-2013:p1207:b004:l025","ordinal":169204,"en":"All you clashing kinsmen"},{"id":"semetey-1-2013:p1207:b004:l026","ordinal":169205,"en":"Stand here."},{"id":"semetey-1-2013:p1207:b004:l027","ordinal":169206,"en":"The wisest of the kinsmen,"},{"id":"semetey-1-2013:p1207:b004:l028","ordinal":169207,"en":"Your deftest man stands here."},{"id":"semetey-1-2013:p1207:b004:l029","ordinal":169208,"en":"Skilled with the spear, a blood-drinker,"},{"id":"semetey-1-2013:p1207:b004:l030","ordinal":169209,"en":"Your strongest man stands here."},{"id":"semetey-1-2013:p1207:b004:l031","ordinal":169210,"en":"Great host of common Muslims,"},{"id":"semetey-1-2013:p1207:b004:l032","ordinal":169211,"en":"Let one in a thousand come;"},{"id":"semetey-1-2013:p1207:b004:l033","ordinal":169212,"en":"Let your able reasoner come."},{"id":"semetey-1-2013:p1207:b004:l034","ordinal":169213,"en":"Your courage remains, O Muslims;"},{"id":"semetey-1-2013:p1207:b004:l035","ordinal":169214,"en":"Let your strongest manlike fighter come,"},{"id":"semetey-1-2013:p1207:b004:l036","ordinal":169215,"en":"Let your hero of complete cunning come,"},{"id":"semetey-1-2013:p1207:b005:l001","ordinal":169216,"en":"And witness this device of mine."}]
