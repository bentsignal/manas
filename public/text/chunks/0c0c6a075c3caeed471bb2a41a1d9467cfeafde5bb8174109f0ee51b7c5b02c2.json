[{"id":"semetey-1-2013:p1227:b003:l030","ordinal":170753,"en":"I gird my accomplished waist;"},{"id":"semetey-1-2013:p1227:b003:l031","ordinal":170754,"en":"If an army of seven myriads comes,"},{"id":"semetey-1-2013:p1227:b003:l032","ordinal":170755,"en":"I shall enter alone and attack."},{"id":"semetey-1-2013:p1227:b003:l033","ordinal":170756,"en":"While this head remains,"},{"id":"semetey-1-2013:p1227:b003:l034","ordinal":170757,"en":"If Akun has an enemy,"},{"id":"semetey-1-2013:p1227:b003:l035","ordinal":170758,"en":"I shall do all I know;"},{"id":"semetey-1-2013:p1227:b003:l036","ordinal":170759,"en":"His army too great for the earth to bear"},{"id":"semetey-1-2013:p1227:b003:l037","ordinal":170760,"en":"I alone shall slaughter."},{"id":"semetey-1-2013:p1227:b003:l038","ordinal":170761,"en":"If it is an enemy from Beijing,"},{"id":"semetey-1-2013:p1227:b003:l039","ordinal":170762,"en":"If it brings grievous peril,"},{"id":"semetey-1-2013:p1227:b005:l001","ordinal":170763,"en":"I shall drive it as far as Beijing;"},{"id":"semetey-1-2013:p1227:b005:l002","ordinal":170764,"en":"If it is a Muslim army,"},{"id":"semetey-1-2013:p1227:b005:l003","ordinal":170765,"en":"I shall drive it as far as Mecca."},{"id":"semetey-1-2013:p1227:b005:l004","ordinal":170766,"en":"While this fortunate head remains,"},{"id":"semetey-1-2013:p1227:b005:l005","ordinal":170767,"en":"I shall smash its fortress walls"},{"id":"semetey-1-2013:p1227:b005:l006","ordinal":170768,"en":"And drive it away completely."},{"id":"semetey-1-2013:p1227:b005:l007","ordinal":170769,"en":"If Akun proves honest,"},{"id":"semetey-1-2013:p1227:b005:l008","ordinal":170770,"en":"I shall give gold by the foot"},{"id":"semetey-1-2013:p1227:b005:l009","ordinal":170771,"en":"And try meeting him in friendship."},{"id":"semetey-1-2013:p1227:b005:l010","ordinal":170772,"en":"If Akun proves treacherous,"},{"id":"semetey-1-2013:p1227:b005:l011","ordinal":170773,"en":"I shall drive and crush him"},{"id":"semetey-1-2013:p1227:b005:l012","ordinal":170774,"en":"And divide his village in two."},{"id":"semetey-1-2013:p1227:b005:l013","ordinal":170775,"en":"If he does not submit to my words,"},{"id":"semetey-1-2013:p1227:b005:l014","ordinal":170776,"en":"If he does not give his old maid,"},{"id":"semetey-1-2013:p1227:b005:l015","ordinal":170777,"en":"I shall smash his lattice and roof-poles,"},{"id":"semetey-1-2013:p1227:b005:l016","ordinal":170778,"en":"Make his daughters-in-law and girls weep,"},{"id":"semetey-1-2013:p1227:b005:l017","ordinal":170779,"en":"And crush his city-dwelling people."},{"id":"semetey-1-2013:p1227:b005:l018","ordinal":170780,"en":"If these Afghans distress me,"},{"id":"semetey-1-2013:p1227:b005:l019","ordinal":170781,"en":"I shall send the Zhediger engulfing them"},{"id":"semetey-1-2013:p1227:b005:l020","ordinal":170782,"en":"And tread upon their heads."},{"id":"semetey-1-2013:p1227:b005:l021","ordinal":170783,"en":"Unless God strikes me,"},{"id":"semetey-1-2013:p1227:b005:l022","ordinal":170784,"en":"If they call me a hero, a hero I am;"},{"id":"semetey-1-2013:p1227:b005:l023","ordinal":170785,"en":"If an army of one myriad appears,"},{"id":"semetey-1-2013:p1227:b005:l024","ordinal":170786,"en":"I alone shall test it."},{"id":"semetey-1-2013:p1227:b005:l025","ordinal":170787,"en":"Whoever resists me,"},{"id":"semetey-1-2013:p1227:b005:l026","ordinal":170788,"en":"I shall take together with the sword;"},{"id":"semetey-1-2013:p1227:b005:l027","ordinal":170789,"en":"If an eager enemy comes,"},{"id":"semetey-1-2013:p1227:b005:l028","ordinal":170790,"en":"I shall put it to slaughter."},{"id":"semetey-1-2013:p1227:b005:l029","ordinal":170791,"en":"If an army of one myriad meets me,"},{"id":"semetey-1-2013:p1227:b005:l030","ordinal":170792,"en":"It is my turn to bring it ruin."},{"id":"semetey-1-2013:p1227:b005:l031","ordinal":170793,"en":"Now is the time to put on"},{"id":"semetey-1-2013:p1227:b005:l032","ordinal":170794,"en":"My smooth bulletproof coat;"},{"id":"semetey-1-2013:p1227:b005:l033","ordinal":170795,"en":"Now is the time to assail"},{"id":"semetey-1-2013:p1227:b005:l034","ordinal":170796,"en":"The whole world;"},{"id":"semetey-1-2013:p1227:b005:l035","ordinal":170797,"en":"Now is the time to mount"},{"id":"semetey-1-2013:p1227:b005:l036","ordinal":170798,"en":"Cloud-flying Surkoyon."},{"id":"semetey-1-2013:p1227:b005:l037","ordinal":170799,"en":"If enemies of six ages appear,"},{"id":"semetey-1-2013:p1227:b005:l038","ordinal":170800,"en":"If a mingled challenge arises,"},{"id":"semetey-1-2013:p1227:b005:l039","ordinal":170801,"en":"Today, without wavering,"},{"id":"semetey-1-2013:p1228:b003:l001","ordinal":170802,"en":"It is my time to strike."},{"id":"semetey-1-2013:p1228:b003:l002","ordinal":170803,"en":"If he does not submit to my words,"},{"id":"semetey-1-2013:p1228:b003:l003","ordinal":170804,"en":"If he does not give his old maid,"},{"id":"semetey-1-2013:p1228:b003:l004","ordinal":170805,"en":"I shall bring splendid slaughter"},{"id":"semetey-1-2013:p1228:b003:l005","ordinal":170806,"en":"Upon accursed Akun;"},{"id":"semetey-1-2013:p1228:b003:l006","ordinal":170807,"en":"If Azhibai and Tümönbai appear,"},{"id":"semetey-1-2013:p1228:b003:l007","ordinal":170808,"en":"I shall take their heads.\""},{"id":"semetey-1-2013:p1228:b003:l008","ordinal":170809,"en":"Drinking vodka and panting,"},{"id":"semetey-1-2013:p1228:b003:l009","ordinal":170810,"en":"Lion Toltoi spoke thus,"},{"id":"semetey-1-2013:p1228:b003:l010","ordinal":170811,"en":"Growing excited by himself"},{"id":"semetey-1-2013:p1228:b003:l011","ordinal":170812,"en":"And speaking to himself."},{"id":"semetey-1-2013:p1228:b003:l012","ordinal":170813,"en":"He girded his waist firmly,"},{"id":"semetey-1-2013:p1228:b003:l013","ordinal":170814,"en":"Mounted Surkoyon,"},{"id":"semetey-1-2013:p1228:b003:l014","ordinal":170815,"en":"And raced across the steppe."},{"id":"semetey-1-2013:p1228:b003:l015","ordinal":170816,"en":"Calamitous Toltoi"},{"id":"semetey-1-2013:p1228:b003:l016","ordinal":170817,"en":"Set out and spurred onto the road."},{"id":"semetey-1-2013:p1228:b003:l017","ordinal":170818,"en":"Looming like Ala-Too,"},{"id":"semetey-1-2013:p1228:b003:l018","ordinal":170819,"en":"He raced along the road,"},{"id":"semetey-1-2013:p1228:b003:l019","ordinal":170820,"en":"Roaring in excitement."},{"id":"semetey-1-2013:p1228:b003:l020","ordinal":170821,"en":"He rode a sleek horse like water,"},{"id":"semetey-1-2013:p1228:b003:l021","ordinal":170822,"en":"Speaking to himself,"},{"id":"semetey-1-2013:p1228:b003:l022","ordinal":170823,"en":"Settling into his wrath,"},{"id":"semetey-1-2013:p1228:b003:l023","ordinal":170824,"en":"And girding on his unsheathed sword;"},{"id":"semetey-1-2013:p1228:b003:l024","ordinal":170825,"en":"Like a cloud about to rain again,"},{"id":"semetey-1-2013:p1228:b003:l025","ordinal":170826,"en":"He turned in anger."},{"id":"semetey-1-2013:p1228:b003:l026","ordinal":170827,"en":"Gray-wolf Toltoi's abundance"},{"id":"semetey-1-2013:p1228:b003:l027","ordinal":170828,"en":"Was complete,"},{"id":"semetey-1-2013:p1228:b003:l028","ordinal":170829,"en":"But your mountainlike hero"},{"id":"semetey-1-2013:p1228:b003:l029","ordinal":170830,"en":"Was deficient in fortune."},{"id":"semetey-1-2013:p1228:b003:l030","ordinal":170831,"en":"Had his fortune been whole,"},{"id":"semetey-1-2013:p1228:b003:l031","ordinal":170832,"en":"He would have been a mountainlike lion."},{"id":"semetey-1-2013:p1228:b003:l032","ordinal":170833,"en":"His right shoulder was broad;"},{"id":"semetey-1-2013:p1228:b003:l033","ordinal":170834,"en":"He was a hero who shattered the Oirats."},{"id":"semetey-1-2013:p1228:b003:l034","ordinal":170835,"en":"He knew the people through wise thought,"},{"id":"semetey-1-2013:p1228:b003:l035","ordinal":170836,"en":"And possessed command."},{"id":"semetey-1-2013:p1228:b003:l036","ordinal":170837,"en":"He subdued the whole world"},{"id":"semetey-1-2013:p1228:b003:l037","ordinal":170838,"en":"And possessed wrestling strength."},{"id":"semetey-1-2013:p1228:b003:l038","ordinal":170839,"en":"Hero Toltoi came onward,"},{"id":"semetey-1-2013:p1228:b003:l039","ordinal":170840,"en":"Standing erect and untroubled;"},{"id":"semetey-1-2013:p1228:b004:l001","ordinal":170841,"en":"The drunkard who had swallowed vodka"},{"id":"semetey-1-2013:p1228:b004:l002","ordinal":170842,"en":"Reckoned an enemy appearing on the road"},{"id":"semetey-1-2013:p1228:b004:l003","ordinal":170843,"en":"As less than the hem of his robe."},{"id":"semetey-1-2013:p1228:b004:l004","ordinal":170844,"en":"If an enemy appeared before him,"},{"id":"semetey-1-2013:p1228:b004:l005","ordinal":170845,"en":"What would dear Toltoi do?"},{"id":"semetey-1-2013:p1228:b004:l006","ordinal":170846,"en":"He looked ready to carve them with his sword;"},{"id":"semetey-1-2013:p1228:b004:l007","ordinal":170847,"en":"If an enemy encountered him,"},{"id":"semetey-1-2013:p1228:b004:l008","ordinal":170848,"en":"He looked ready to strike them all down"},{"id":"semetey-1-2013:p1228:b004:l009","ordinal":170849,"en":"And slaughter every one."},{"id":"semetey-1-2013:p1228:b004:l010","ordinal":170850,"en":"Surkoyon beneath him"},{"id":"semetey-1-2013:p1228:b004:l011","ordinal":170851,"en":"Ran beyond all bounds, leaping;"},{"id":"semetey-1-2013:p1228:b004:l012","ordinal":170852,"en":"Hero Toltoi above him"},{"id":"semetey-1-2013:p1228:b004:l013","ordinal":170853,"en":"Came onward then,"},{"id":"semetey-1-2013:p1228:b004:l014","ordinal":170854,"en":"Holding his battle-axe ready."},{"id":"semetey-1-2013:p1228:b004:l015","ordinal":170855,"en":"Hero Toltoi of the Zhediger"},{"id":"semetey-1-2013:p1228:b004:l016","ordinal":170856,"en":"Was born an accomplished khan;"},{"id":"semetey-1-2013:p1228:b004:l017","ordinal":170857,"en":"He was the khan who gathered and ruled"},{"id":"semetey-1-2013:p1228:b004:l018","ordinal":170858,"en":"The Zhediger of Zheti-Özön."},{"id":"semetey-1-2013:p1228:b004:l019","ordinal":170859,"en":"Toltoi's heart desired"},{"id":"semetey-1-2013:p1228:b004:l020","ordinal":170860,"en":"To lie in Aichürök's embrace,"},{"id":"semetey-1-2013:p1228:b004:l021","ordinal":170861,"en":"The daughter of Akun."},{"id":"semetey-1-2013:p1228:b004:l022","ordinal":170862,"en":"His inlaid spear with a hollow socket"},{"id":"semetey-1-2013:p1228:b004:l023","ordinal":170863,"en":"Came bobbing into view."},{"id":"semetey-1-2013:p1228:b004:l024","ordinal":170864,"en":"In his own heart then,"},{"id":"semetey-1-2013:p1228:b004:l025","ordinal":170865,"en":"He came onward rejoicing."},{"id":"semetey-1-2013:p1228:b004:l026","ordinal":170866,"en":"Saying of Akun's daughter Chürök,"},{"id":"semetey-1-2013:p1228:b004:l027","ordinal":170867,"en":"\"I shall raise her white dress"},{"id":"semetey-1-2013:p1228:b004:l028","ordinal":170868,"en":"And mount her white breast,\""},{"id":"semetey-1-2013:p1228:b004:l029","ordinal":170869,"en":"No matter how many enemies appeared before him,"},{"id":"semetey-1-2013:p1228:b004:l030","ordinal":170870,"en":"He intended to enter among them alone."},{"id":"semetey-1-2013:p1228:b004:l031","ordinal":170871,"en":"To take as a wife,"},{"id":"semetey-1-2013:p1228:b004:l032","ordinal":170872,"en":"There was no woman but Chürök;"},{"id":"semetey-1-2013:p1228:b004:l033","ordinal":170873,"en":"If ten thousand enemies appeared before him,"},{"id":"semetey-1-2013:p1228:b004:l034","ordinal":170874,"en":"There was no hero but himself."},{"id":"semetey-1-2013:p1228:b004:l035","ordinal":170875,"en":"Drunk and rejoicing,"},{"id":"semetey-1-2013:p1228:b004:l036","ordinal":170876,"en":"Beastly Toltoi boasted,"},{"id":"semetey-1-2013:p1228:b004:l037","ordinal":170877,"en":"Beat the doolbas once,"},{"id":"semetey-1-2013:p1228:b004:l038","ordinal":170878,"en":"And raced upon Surkoyon,"},{"id":"semetey-1-2013:p1228:b004:l039","ordinal":170879,"en":"His inlaid spear leveled,"},{"id":"semetey-1-2013:p1229:b003:l001","ordinal":170880,"en":"As though about to wreak destruction,"},{"id":"semetey-1-2013:p1229:b003:l002","ordinal":170881,"en":"His voice deafening the ears."},{"id":"semetey-1-2013:p1229:b003:l003","ordinal":170882,"en":"Külchoro lay sleeping"},{"id":"semetey-1-2013:p1229:b003:l004","ordinal":170883,"en":"As Toltoi approached;"},{"id":"semetey-1-2013:p1229:b003:l005","ordinal":170884,"en":"He stood erect and untroubled."},{"id":"semetey-1-2013:p1229:b003:l006","ordinal":170885,"en":"Though the boy was a servant,"},{"id":"semetey-1-2013:p1229:b003:l007","ordinal":170886,"en":"Almighty God had multiplied in him"},{"id":"semetey-1-2013:p1229:b003:l008","ordinal":170887,"en":"Heroism and leonine courage,"},{"id":"semetey-1-2013:p1229:b003:l009","ordinal":170888,"en":"Granting them without measure."},{"id":"semetey-1-2013:p1229:b003:l010","ordinal":170889,"en":"He had no tongue with which to speak;"},{"id":"semetey-1-2013:p1229:b003:l011","ordinal":170890,"en":"Arbuudan beneath him"},{"id":"semetey-1-2013:p1229:b003:l012","ordinal":170891,"en":"Was sibling to Algara"},{"id":"semetey-1-2013:p1229:b003:l013","ordinal":170892,"en":"Of Maiden Saikal."},{"id":"semetey-1-2013:p1229:b003:l014","ordinal":170893,"en":"He had raced with wild asses"},{"id":"semetey-1-2013:p1229:b003:l015","ordinal":170894,"en":"And contended with thoroughbreds."},{"id":"semetey-1-2013:p1229:b003:l016","ordinal":170895,"en":"Külchoro remained asleep;"},{"id":"semetey-1-2013:p1229:b003:l017","ordinal":170896,"en":"Hearing the sound, Taibuurul"},{"id":"semetey-1-2013:p1229:b003:l018","ordinal":170897,"en":"Flattened his right ear."},{"id":"semetey-1-2013:p1229:b003:l019","ordinal":170898,"en":"As though he had seen a wolf,"},{"id":"semetey-1-2013:p1229:b003:l020","ordinal":170899,"en":"The animal groaned"},{"id":"semetey-1-2013:p1229:b003:l021","ordinal":170900,"en":"And flung the crust of black earth"},{"id":"semetey-1-2013:p1229:b003:l022","ordinal":170901,"en":"Upon Külchoro."},{"id":"semetey-1-2013:p1229:b003:l023","ordinal":170902,"en":"Still Choro did not wake;"},{"id":"semetey-1-2013:p1229:b004:l001","ordinal":170903,"en":"Snorting and choking,"},{"id":"semetey-1-2013:p1229:b004:l002","ordinal":170904,"en":"He pounded the black earth's crust"},{"id":"semetey-1-2013:p1229:b004:l003","ordinal":170905,"en":"With his feet."},{"id":"semetey-1-2013:p1229:b004:l004","ordinal":170906,"en":"Still Choro did not wake."},{"id":"semetey-1-2013:p1229:b004:l005","ordinal":170907,"en":"He had begun snoring;"},{"id":"semetey-1-2013:p1229:b004:l006","ordinal":170908,"en":"Fearless Külchoro"},{"id":"semetey-1-2013:p1229:b004:l007","ordinal":170909,"en":"Slept without stirring."},{"id":"semetey-1-2013:p1229:b004:l008","ordinal":170910,"en":"The child-finding monster"},{"id":"semetey-1-2013:p1229:b004:l009","ordinal":170911,"en":"Had rested his head upon a stone"},{"id":"semetey-1-2013:p1229:b004:l010","ordinal":170912,"en":"And fallen asleep exhausted."},{"id":"semetey-1-2013:p1229:b004:l011","ordinal":170913,"en":"Taibuurul stood alarmed, thinking,"},{"id":"semetey-1-2013:p1229:b004:l012","ordinal":170914,"en":"\"If hero Toltoi suddenly arrives,"},{"id":"semetey-1-2013:p1229:b004:l013","ordinal":170915,"en":"What will he do with his spear?"},{"id":"semetey-1-2013:p1229:b004:l014","ordinal":170916,"en":"He will put the twelve-year-old boy"},{"id":"semetey-1-2013:p1229:b004:l015","ordinal":170917,"en":"To death.\""},{"id":"semetey-1-2013:p1229:b004:l016","ordinal":170918,"en":"\"Choro knows wickedness;"},{"id":"semetey-1-2013:p1229:b004:l017","ordinal":170919,"en":"At tomorrow's gathering day"},{"id":"semetey-1-2013:p1229:b004:l018","ordinal":170920,"en":"He will ride me like a black donkey,\""},{"id":"semetey-1-2013:p1229:b004:l019","ordinal":170921,"en":"The horse thought, and like one seeing a wolf,"},{"id":"semetey-1-2013:p1229:b004:l020","ordinal":170922,"en":"He snorted."},{"id":"semetey-1-2013:p1229:b004:l021","ordinal":170923,"en":"He turned his staglike neck;"},{"id":"semetey-1-2013:p1229:b004:l022","ordinal":170924,"en":"When he struck and scattered the earth,"},{"id":"semetey-1-2013:p1229:b004:l023","ordinal":170925,"en":"Still the boy did not wake."},{"id":"semetey-1-2013:p1229:b006:l001","ordinal":170926,"en":"The earth split in a mirage;"},{"id":"semetey-1-2013:p1229:b006:l002","ordinal":170927,"en":"Toltoi of the Zhediger"},{"id":"semetey-1-2013:p1229:b006:l003","ordinal":170928,"en":"Came drawing near."},{"id":"semetey-1-2013:p1229:b006:l004","ordinal":170929,"en":"The matchless horse Buurul"},{"id":"semetey-1-2013:p1229:b006:l005","ordinal":170930,"en":"Bit down upon his bit;"},{"id":"semetey-1-2013:p1229:b006:l006","ordinal":170931,"en":"The spiritlike Taibuurul"},{"id":"semetey-1-2013:p1229:b006:l007","ordinal":170932,"en":"Spun around the spear"},{"id":"semetey-1-2013:p1229:b006:l008","ordinal":170933,"en":"That had been thrust into the ground."},{"id":"semetey-1-2013:p1229:b006:l009","ordinal":170934,"en":"Külchoro upon him"},{"id":"semetey-1-2013:p1229:b006:l010","ordinal":170935,"en":"Nearly fell from Taibuurul,"},{"id":"semetey-1-2013:p1229:b006:l011","ordinal":170936,"en":"Then righted himself."},{"id":"semetey-1-2013:p1229:b007:l001","ordinal":170937,"en":"\"Oh, oh, what is the swine doing?\""},{"id":"semetey-1-2013:p1229:b007:l002","ordinal":170938,"en":"The boy cried as he awoke;"},{"id":"semetey-1-2013:p1229:b007:l003","ordinal":170939,"en":"His small heart pounded,"},{"id":"semetey-1-2013:p1229:b007:l004","ordinal":170940,"en":"And all his insides and intestines"},{"id":"semetey-1-2013:p1229:b007:l005","ordinal":170941,"en":"Heaved without stopping."},{"id":"semetey-1-2013:p1229:b007:l006","ordinal":170942,"en":"His waist slackened and he hunched;"},{"id":"semetey-1-2013:p1229:b007:l007","ordinal":170943,"en":"The young prince Külchoro"},{"id":"semetey-1-2013:p1229:b007:l008","ordinal":170944,"en":"Opened his eyes wide."},{"id":"semetey-1-2013:p1229:b007:l009","ordinal":170945,"en":"Sleep scattered and fled;"},{"id":"semetey-1-2013:p1229:b007:l010","ordinal":170946,"en":"His eyes opened wide as umach,"},{"id":"semetey-1-2013:p1229:b007:l011","ordinal":170947,"en":"And his brow drew tight,"},{"id":"semetey-1-2013:p1230:b003:l001","ordinal":170948,"en":"Your measureless sultan"},{"id":"semetey-1-2013:p1230:b003:l002","ordinal":170949,"en":"Struggled with Buurul."},{"id":"semetey-1-2013:p1230:b003:l003","ordinal":170950,"en":"At twelve years old, Külchoro"},{"id":"semetey-1-2013:p1230:b003:l004","ordinal":170951,"en":"Possessed perfect fortune;"},{"id":"semetey-1-2013:p1230:b003:l005","ordinal":170952,"en":"From your ocean-like Almambet"},{"id":"semetey-1-2013:p1230:b003:l006","ordinal":170953,"en":"The warrior remained as a gift."},{"id":"semetey-1-2013:p1230:b003:l007","ordinal":170954,"en":"Your spring flowing from a river,"},{"id":"semetey-1-2013:p1230:b003:l008","ordinal":170955,"en":"From mighty Sultan Alman"},{"id":"semetey-1-2013:p1230:b003:l009","ordinal":170956,"en":"Your young champion remained as a gift."},{"id":"semetey-1-2013:p1230:b003:l010","ordinal":170957,"en":"Leaning back and watching the pass,"},{"id":"semetey-1-2013:p1230:b003:l011","ordinal":170958,"en":"Your valiant hero stood looking."},{"id":"semetey-1-2013:p1230:b003:l012","ordinal":170959,"en":"He rode a horse blue as water,"},{"id":"semetey-1-2013:p1230:b003:l013","ordinal":170960,"en":"Its hair tail tied in a hard knot,"},{"id":"semetey-1-2013:p1230:b003:l014","ordinal":170961,"en":"The kasaba banner fastened on."},{"id":"semetey-1-2013:p1230:b003:l015","ordinal":170962,"en":"Like a cloud about to rain again,"},{"id":"semetey-1-2013:p1230:b003:l016","ordinal":170963,"en":"Wrath covered his face."},{"id":"semetey-1-2013:p1230:b003:l017","ordinal":170964,"en":"When one looked at his battle-axe,"},{"id":"semetey-1-2013:p1230:b003:l018","ordinal":170965,"en":"It seemed as large as a house;"},{"id":"semetey-1-2013:p1230:b003:l019","ordinal":170966,"en":"The heart of anyone watching"},{"id":"semetey-1-2013:p1230:b003:l020","ordinal":170967,"en":"Was torn apart."},{"id":"semetey-1-2013:p1230:b003:l021","ordinal":170968,"en":"Hero Toltoi of the Jediger"},{"id":"semetey-1-2013:p1230:b003:l022","ordinal":170969,"en":"Was a lion among fathers’ sons,"},{"id":"semetey-1-2013:p1230:b003:l023","ordinal":170970,"en":"But lacked in repentance."},{"id":"semetey-1-2013:p1230:b003:l024","ordinal":170971,"en":"Had his repentance been complete,"},{"id":"semetey-1-2013:p1230:b003:l025","ordinal":170972,"en":"He would have camped among the people"},{"id":"semetey-1-2013:p1230:b003:l026","ordinal":170973,"en":"As a companion, not a swine."},{"id":"semetey-1-2013:p1230:b003:l027","ordinal":170974,"en":"What could dear Toltoi do?"},{"id":"semetey-1-2013:p1230:b003:l028","ordinal":170975,"en":"He turned in anger,"},{"id":"semetey-1-2013:p1230:b003:l029","ordinal":170976,"en":"Sword, gun, and battle-axe"},{"id":"semetey-1-2013:p1230:b003:l030","ordinal":170977,"en":"Fastened together at his waist."},{"id":"semetey-1-2013:p1230:b003:l031","ordinal":170978,"en":"Swelling with terrible spirit,"},{"id":"semetey-1-2013:p1230:b003:l032","ordinal":170979,"en":"Saying, “I shall take Aichürök,”"},{"id":"semetey-1-2013:p1230:b003:l033","ordinal":170980,"en":"He came blustering onward."},{"id":"semetey-1-2013:p1230:b003:l034","ordinal":170981,"en":"The patterned spear left as a gift"},{"id":"semetey-1-2013:p1230:b003:l035","ordinal":170982,"en":"By his father, noble Manas,"},{"id":"semetey-1-2013:p1230:b003:l036","ordinal":170983,"en":"Valiant prince Külchoro"},{"id":"semetey-1-2013:p1230:b003:l037","ordinal":170984,"en":"Took out and leveled toward him."},{"id":"semetey-1-2013:p1230:b003:l038","ordinal":170985,"en":"“Ah, Almighty, grant me faith;"},{"id":"semetey-1-2013:p1230:b003:l039","ordinal":170986,"en":"If death has reached me, let me die."},{"id":"semetey-1-2013:p1230:b004:l001","ordinal":170987,"en":"Against Toltoi of the Jediger,"},{"id":"semetey-1-2013:p1230:b004:l002","ordinal":170988,"en":"Let me face him once and test myself."},{"id":"semetey-1-2013:p1230:b004:l003","ordinal":170989,"en":"To this brother-in-law who comes to take a wife,"},{"id":"semetey-1-2013:p1230:b004:l004","ordinal":170990,"en":"Let me settle his account now."},{"id":"semetey-1-2013:p1230:b004:l005","ordinal":170991,"en":"If Toltoi is a hero,"},{"id":"semetey-1-2013:p1230:b004:l006","ordinal":170992,"en":"Let me wrestle him one against one,"},{"id":"semetey-1-2013:p1230:b004:l007","ordinal":170993,"en":"And fight for seven days."},{"id":"semetey-1-2013:p1230:b004:l008","ordinal":170994,"en":"I have reached twelve years of age;"},{"id":"semetey-1-2013:p1230:b004:l009","ordinal":170995,"en":"If fate has reached me, let me die."},{"id":"semetey-1-2013:p1230:b004:l010","ordinal":170996,"en":"Against Toltoi of the Jediger,"},{"id":"semetey-1-2013:p1230:b004:l011","ordinal":170997,"en":"Dueling and spearing one another,"},{"id":"semetey-1-2013:p1230:b004:l012","ordinal":170998,"en":"Let me grapple once and test myself."},{"id":"semetey-1-2013:p1230:b004:l013","ordinal":170999,"en":"Standing one against one,"},{"id":"semetey-1-2013:p1230:b004:l014","ordinal":171000,"en":"Going out to fight in single combat,"},{"id":"semetey-1-2013:p1230:b004:l015","ordinal":171001,"en":"At Toltoi, who comes to take a wife,"},{"id":"semetey-1-2013:p1230:b004:l016","ordinal":171002,"en":"Let me charge and level my spear;"},{"id":"semetey-1-2013:p1230:b004:l017","ordinal":171003,"en":"Against the brother-in-law who comes to take a wife,"},{"id":"semetey-1-2013:p1230:b004:l018","ordinal":171004,"en":"Let me summon all my courage."},{"id":"semetey-1-2013:p1230:b004:l019","ordinal":171005,"en":"If death has reached me, let me die;"},{"id":"semetey-1-2013:p1230:b004:l020","ordinal":171006,"en":"With Toltoi, huge as Ala-Too,"},{"id":"semetey-1-2013:p1230:b004:l021","ordinal":171007,"en":"Let me clash and test myself."},{"id":"semetey-1-2013:p1230:b004:l022","ordinal":171008,"en":"At thundering Toltoi,"}]
