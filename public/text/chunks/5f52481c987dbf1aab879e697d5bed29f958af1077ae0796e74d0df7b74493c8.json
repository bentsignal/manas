[{"id":"manas-2010:p1379:b001:l008","ordinal":59649,"en":"With long strides from behind,"},{"id":"manas-2010:p1379:b001:l009","ordinal":59650,"en":"Akkula pressed upon his heels."},{"id":"manas-2010:p1379:b001:l010","ordinal":59651,"en":"A star had moved in heaven;"},{"id":"manas-2010:p1379:b001:l011","ordinal":59652,"en":"When Almambet had fled to him,"},{"id":"manas-2010:p1379:b001:l012","ordinal":59653,"en":"He and Manas swore an oath,"},{"id":"manas-2010:p1379:b001:l013","ordinal":59654,"en":"And became friends, joined at heart."},{"id":"manas-2010:p1379:b001:l014","ordinal":59655,"en":"Warrior Manas had cast his life aside"},{"id":"manas-2010:p1379:b001:l015","ordinal":59656,"en":"And given chase to Kalcha:"},{"id":"manas-2010:p1379:b001:l016","ordinal":59657,"en":"From far away your Almambet saw it."},{"id":"manas-2010:p1379:b001:l017","ordinal":59658,"en":"“That cunning wretch Kalcha"},{"id":"manas-2010:p1379:b001:l018","ordinal":59659,"en":"Will now go through the gate;"},{"id":"manas-2010:p1379:b001:l019","ordinal":59660,"en":"Impulsive warrior Manas"},{"id":"manas-2010:p1379:b001:l020","ordinal":59661,"en":"Will follow through the gate."},{"id":"manas-2010:p1379:b001:l021","ordinal":59662,"en":"He will not come out again;"},{"id":"manas-2010:p1379:b001:l022","ordinal":59663,"en":"His death will overtake him."},{"id":"manas-2010:p1379:b001:l023","ordinal":59664,"en":"If Khan Manas enters the gate,"},{"id":"manas-2010:p1379:b001:l024","ordinal":59665,"en":"God will strike the unbeliever;"},{"id":"manas-2010:p1379:b001:l025","ordinal":59666,"en":"They will kill Khan Manas,"},{"id":"manas-2010:p1379:b001:l026","ordinal":59667,"en":"And make him like an extinguished fire."},{"id":"manas-2010:p1379:b001:l027","ordinal":59668,"en":"He is an impulsive man;"},{"id":"manas-2010:p1379:b001:l028","ordinal":59669,"en":"He will surely come to harm.”"},{"id":"manas-2010:p1379:b001:l029","ordinal":59670,"en":"Thinking thus, your warrior Almambet,"},{"id":"manas-2010:p1379:b001:l030","ordinal":59671,"en":"The leopard, seeing from afar,"},{"id":"manas-2010:p1379:b001:l031","ordinal":59672,"en":"As he was entering the gate,"},{"id":"manas-2010:p1379:b001:l032","ordinal":59673,"en":"Into the hands of the massed Chinese and Manchus,"},{"id":"manas-2010:p1379:b001:l033","ordinal":59674,"en":"As Manas was about to fall,"},{"id":"manas-2010:p1379:b001:l034","ordinal":59675,"en":"As they were closing the gate,"},{"id":"manas-2010:p1379:b001:l035","ordinal":59676,"en":"As sixty Chinese and many governors"},{"id":"manas-2010:p1379:b001:l036","ordinal":59677,"en":"Were about to take Manas's head,"},{"id":"manas-2010:p1379:b001:l037","ordinal":59678,"en":"Arrived ahead of an arrow."},{"id":"manas-2010:p1379:b001:l038","ordinal":59679,"en":"Arriving there, Almambet,"},{"id":"manas-2010:p1379:b001:l039","ordinal":59680,"en":"Jerking like a woman whose husband had died,"},{"id":"manas-2010:p1379:b001:l040","ordinal":59681,"en":"Wrenched warrior Manas,"},{"id":"manas-2010:p1379:b001:l041","ordinal":59682,"en":"Caught hold of the lead rein,"},{"id":"manas-2010:p1379:b001:l042","ordinal":59683,"en":"And pulled him back away."},{"id":"manas-2010:p1380:b001:l001","ordinal":59684,"en":"“My lion, do not vie with Kalcha!"},{"id":"manas-2010:p1380:b001:l002","ordinal":59685,"en":"The dark ridge looming black"},{"id":"manas-2010:p1380:b001:l003","ordinal":59686,"en":"Is no ridge for a man to cross;"},{"id":"manas-2010:p1380:b001:l004","ordinal":59687,"en":"Alöökö's Kongurbay"},{"id":"manas-2010:p1380:b001:l005","ordinal":59688,"en":"Is no warrior to trifle with."},{"id":"manas-2010:p1380:b001:l006","ordinal":59689,"en":"The black horse Kalcha rides"},{"id":"manas-2010:p1380:b001:l007","ordinal":59690,"en":"Has wings at his withers."},{"id":"manas-2010:p1380:b001:l008","ordinal":59691,"en":"Unless it is a winged bird,"},{"id":"manas-2010:p1380:b001:l009","ordinal":59692,"en":"No mere horse can catch him:"},{"id":"manas-2010:p1380:b001:l010","ordinal":59693,"en":"That is Algara's way."},{"id":"manas-2010:p1380:b001:l011","ordinal":59694,"en":"No beast can match his running;"},{"id":"manas-2010:p1380:b001:l012","ordinal":59695,"en":"Unless it is a winged bird,"},{"id":"manas-2010:p1380:b001:l013","ordinal":59696,"en":"No living thing can catch Algara!”"},{"id":"manas-2010:p1380:b001:l014","ordinal":59697,"en":"Then Manas bristled up,"},{"id":"manas-2010:p1380:b001:l015","ordinal":59698,"en":"Distressing your Almambet,"},{"id":"manas-2010:p1380:b001:l016","ordinal":59699,"en":"Roaring in his wrath:"},{"id":"manas-2010:p1380:b001:l017","ordinal":59700,"en":"“Enough of your words, my Almambet!"},{"id":"manas-2010:p1380:b001:l018","ordinal":59701,"en":"You defend your own account;"},{"id":"manas-2010:p1380:b001:l019","ordinal":59702,"en":"Kongurbay's Algara—"},{"id":"manas-2010:p1380:b001:l020","ordinal":59703,"en":"Why do you praise him so much?"},{"id":"manas-2010:p1380:b001:l021","ordinal":59704,"en":"He never tires while scouting,"},{"id":"manas-2010:p1380:b001:l022","ordinal":59705,"en":"Nor troubles you in the baggage train,"},{"id":"manas-2010:p1380:b001:l023","ordinal":59706,"en":"Sarala beneath you;"},{"id":"manas-2010:p1380:b001:l024","ordinal":59707,"en":"Is Kongurbay's Algara"},{"id":"manas-2010:p1380:b001:l025","ordinal":59708,"en":"Swifter than Sarala?"},{"id":"manas-2010:p1380:b001:l026","ordinal":59709,"en":"Though I ride him six months, he never tires;"},{"id":"manas-2010:p1380:b001:l027","ordinal":59710,"en":"Until his sixtieth year of maturity,"},{"id":"manas-2010:p1380:b001:l028","ordinal":59711,"en":"He will not age with jutting tusks."},{"id":"manas-2010:p1380:b001:l029","ordinal":59712,"en":"If you look at his true build,"},{"id":"manas-2010:p1380:b001:l030","ordinal":59713,"en":"A Karabayyr, a battle steed,"},{"id":"manas-2010:p1380:b001:l031","ordinal":59714,"en":"With sieve-like lungs and copper forelegs,"},{"id":"manas-2010:p1380:b001:l032","ordinal":59715,"en":"Linked with the spirit of wild beasts,"},{"id":"manas-2010:p1380:b001:l033","ordinal":59716,"en":"When I reached twelve"},{"id":"manas-2010:p1380:b001:l034","ordinal":59717,"en":"He was found for me then:"},{"id":"manas-2010:p1380:b001:l035","ordinal":59718,"en":"Is he swifter than Akkula?"},{"id":"manas-2010:p1380:b001:l036","ordinal":59719,"en":"Unless his true death comes,"},{"id":"manas-2010:p1380:b001:l037","ordinal":59720,"en":"He will not yield to a determined foe;"},{"id":"manas-2010:p1380:b001:l038","ordinal":59721,"en":"Unless God truly strikes him,"},{"id":"manas-2010:p1380:b001:l039","ordinal":59722,"en":"He will not let his rider burn."},{"id":"manas-2010:p1380:b001:l040","ordinal":59723,"en":"Warrior Chubak's Kökchebich—"},{"id":"manas-2010:p1380:b001:l041","ordinal":59724,"en":"Is he swifter than Kökchebich?”"},{"id":"manas-2010:p1380:b001:l042","ordinal":59725,"en":"Saying this, he struggled,"},{"id":"manas-2010:p1381:b001:l001","ordinal":59726,"en":"“Let go!” he said, gasping."},{"id":"manas-2010:p1381:b001:l002","ordinal":59727,"en":"“Champion Manas, may you come to no good!"},{"id":"manas-2010:p1381:b001:l003","ordinal":59728,"en":"Never doing as you are told,"},{"id":"manas-2010:p1381:b001:l004","ordinal":59729,"en":"You mean to dig my pit;"},{"id":"manas-2010:p1381:b001:l005","ordinal":59730,"en":"You mean to boil up, leopard,"},{"id":"manas-2010:p1381:b001:l006","ordinal":59731,"en":"My far-off misfortune."},{"id":"manas-2010:p1381:b001:l007","ordinal":59732,"en":"The gateway standing open"},{"id":"manas-2010:p1381:b001:l008","ordinal":59733,"en":"Is Esenkan's door."},{"id":"manas-2010:p1381:b001:l009","ordinal":59734,"en":"By working every sort of trick,"},{"id":"manas-2010:p1381:b001:l010","ordinal":59735,"en":"Boiling up a warrior's sorrow,"},{"id":"manas-2010:p1381:b001:l011","ordinal":59736,"en":"What Kalcha always does—"},{"id":"manas-2010:p1381:b001:l012","ordinal":59737,"en":"That is his occupation."},{"id":"manas-2010:p1381:b001:l013","ordinal":59738,"en":"Will that wretch Kalcha not"},{"id":"manas-2010:p1381:b001:l014","ordinal":59739,"en":"Only pretend to flee,"},{"id":"manas-2010:p1381:b001:l015","ordinal":59740,"en":"Lure you into his city,"},{"id":"manas-2010:p1381:b001:l016","ordinal":59741,"en":"And bring destruction upon you?"},{"id":"manas-2010:p1381:b001:l017","ordinal":59742,"en":"On the far side, the Chinese"},{"id":"manas-2010:p1381:b001:l018","ordinal":59743,"en":"Champions stationed there—"},{"id":"manas-2010:p1381:b001:l019","ordinal":59744,"en":"Will they not shut the door fast,"},{"id":"manas-2010:p1381:b001:l020","ordinal":59745,"en":"Will they not finish you off?"},{"id":"manas-2010:p1381:b001:l021","ordinal":59746,"en":"When your precious self goes there,"},{"id":"manas-2010:p1381:b001:l022","ordinal":59747,"en":"The champions waiting idly—"},{"id":"manas-2010:p1381:b001:l023","ordinal":59748,"en":"Will they not take their battleaxes"},{"id":"manas-2010:p1381:b001:l024","ordinal":59749,"en":"And hack your head again and again?"},{"id":"manas-2010:p1381:b001:l025","ordinal":59750,"en":"Through a moment's recklessness,"},{"id":"manas-2010:p1381:b001:l026","ordinal":59751,"en":"Will your precious life not perish?"},{"id":"manas-2010:p1381:b001:l027","ordinal":59752,"en":"This is the famed land of Beijing;"},{"id":"manas-2010:p1381:b001:l028","ordinal":59753,"en":"Seeing your peril, my lion,"},{"id":"manas-2010:p1381:b001:l029","ordinal":59754,"en":"I am the one who came to you."},{"id":"manas-2010:p1381:b001:l030","ordinal":59755,"en":"Slaughter will never exhaust the Chinese."},{"id":"manas-2010:p1381:b001:l031","ordinal":59756,"en":"Where even the surging Flood did not enter,"},{"id":"manas-2010:p1381:b001:l032","ordinal":59757,"en":"These are the hellish Chinese people."},{"id":"manas-2010:p1381:b001:l033","ordinal":59758,"en":"Breaking freely from your troop,"},{"id":"manas-2010:p1381:b001:l034","ordinal":59759,"en":"Do not bring hell upon us!”"},{"id":"manas-2010:p1381:b001:l035","ordinal":59760,"en":"Saying this to Manas,"},{"id":"manas-2010:p1381:b001:l036","ordinal":59761,"en":"As he grew excited and struggled,"},{"id":"manas-2010:p1381:b001:l037","ordinal":59762,"en":"As he grew frantic and wrenched about,"},{"id":"manas-2010:p1381:b001:l038","ordinal":59763,"en":"He held Manas and brought him out."},{"id":"manas-2010:p1381:b001:l039","ordinal":59764,"en":"Their khans Muzburchak and Kökchö,"},{"id":"manas-2010:p1381:b001:l040","ordinal":59765,"en":"Their warriors Syrgak and Chubak,"},{"id":"manas-2010:p1381:b001:l041","ordinal":59766,"en":"The massed Chinese army"},{"id":"manas-2010:p1381:b001:l042","ordinal":59767,"en":"Had driven along just then;"},{"id":"manas-2010:p1382:b001:l001","ordinal":59768,"en":"Dividing the Chinese by thousands,"},{"id":"manas-2010:p1382:b001:l002","ordinal":59769,"en":"They were herding them together."},{"id":"manas-2010:p1382:b001:l003","ordinal":59770,"en":"Slaughtering, destroying, shattering,"},{"id":"manas-2010:p1382:b001:l004","ordinal":59771,"en":"Like a saker striking jackdaws,"},{"id":"manas-2010:p1382:b001:l005","ordinal":59772,"en":"They were attacking them then."},{"id":"manas-2010:p1382:b001:l006","ordinal":59773,"en":"In the kakan’s Beijing,"},{"id":"manas-2010:p1382:b001:l007","ordinal":59774,"en":"The Chinese were shouting wildly;"},{"id":"manas-2010:p1382:b001:l008","ordinal":59775,"en":"Fleeing without resistance,"},{"id":"manas-2010:p1382:b001:l009","ordinal":59776,"en":"Turning toward Great Beijing,"},{"id":"manas-2010:p1382:b001:l010","ordinal":59777,"en":"They were swarming everywhere."},{"id":"manas-2010:p1382:b001:l011","ordinal":59778,"en":"The whole world had gathered;"},{"id":"manas-2010:p1382:b001:l012","ordinal":59779,"en":"Those whose time had come were slain."},{"id":"manas-2010:p1382:b001:l013","ordinal":59780,"en":"Each of the able young warriors"},{"id":"manas-2010:p1382:b001:l014","ordinal":59781,"en":"Drove away his spoils,"},{"id":"manas-2010:p1382:b001:l015","ordinal":59782,"en":"Taking six hundred horses apiece;"},{"id":"manas-2010:p1382:b001:l016","ordinal":59783,"en":"The poor ones who could take no more"},{"id":"manas-2010:p1382:b001:l017","ordinal":59784,"en":"Took six or five horses each."},{"id":"manas-2010:p1382:b001:l018","ordinal":59785,"en":"Pursuing the Chinese,"},{"id":"manas-2010:p1382:b001:l019","ordinal":59786,"en":"They roared the cry of “Manas!”"},{"id":"manas-2010:p1382:b001:l020","ordinal":59787,"en":"Straight toward their center then,"},{"id":"manas-2010:p1382:b001:l021","ordinal":59788,"en":"They had carved their way through."},{"id":"manas-2010:p1382:b001:l022","ordinal":59789,"en":"Their bravest men who stood firm,"},{"id":"manas-2010:p1382:b001:l023","ordinal":59790,"en":"The blood-drinking heroes, the forty companions,"},{"id":"manas-2010:p1382:b001:l024","ordinal":59791,"en":"Were slaughtering just then."},{"id":"manas-2010:p1382:b001:l025","ordinal":59792,"en":"The Chinese, like black sand,"},{"id":"manas-2010:p1382:b001:l026","ordinal":59793,"en":"Leopard Bakay scattered."},{"id":"manas-2010:p1382:b001:l027","ordinal":59794,"en":"As he scattered and drove them away,"},{"id":"manas-2010:p1382:b001:l028","ordinal":59795,"en":"They broke into separate groups;"},{"id":"manas-2010:p1382:b001:l029","ordinal":59796,"en":"The earth split with the thunder;"},{"id":"manas-2010:p1382:b001:l030","ordinal":59797,"en":"The great forces of twelve khans"},{"id":"manas-2010:p1382:b001:l031","ordinal":59798,"en":"Divided into many separate bands."},{"id":"manas-2010:p1382:b001:l032","ordinal":59799,"en":"People of so many clans had come;"},{"id":"manas-2010:p1382:b001:l033","ordinal":59800,"en":"Aykhozho of Mecca"},{"id":"manas-2010:p1382:b001:l034","ordinal":59801,"en":"Had come with his troops."},{"id":"manas-2010:p1382:b001:l035","ordinal":59802,"en":"Warrior Manas gave the order;"},{"id":"manas-2010:p1382:b001:l036","ordinal":59803,"en":"On the ridge in front,"},{"id":"manas-2010:p1382:b001:l037","ordinal":59804,"en":"The lion planted his banner"},{"id":"manas-2010:p1382:b001:l038","ordinal":59805,"en":"And brought the fighting to a halt."},{"id":"manas-2010:p1382:b001:l039","ordinal":59806,"en":"Aykhozho in his pied robe"},{"id":"manas-2010:p1382:b001:l040","ordinal":59807,"en":"Loudly called the call to prayer."},{"id":"manas-2010:p1382:b001:l041","ordinal":59808,"en":"Those who remained alive"},{"id":"manas-2010:p1383:b001:l001","ordinal":59809,"en":"Heard the voice calling to prayer"},{"id":"manas-2010:p1383:b001:l002","ordinal":59810,"en":"And went beneath the banner."},{"id":"manas-2010:p1383:b003:l001","ordinal":59811,"en":"They beat the kettledrum;"},{"id":"manas-2010:p1383:b003:l002","ordinal":59812,"en":"The Muslims who survived the dead"},{"id":"manas-2010:p1383:b003:l003","ordinal":59813,"en":"Gathered together."},{"id":"manas-2010:p1383:b003:l004","ordinal":59814,"en":"They put the khans in writing,"},{"id":"manas-2010:p1383:b003:l005","ordinal":59815,"en":"And counted the people."},{"id":"manas-2010:p1383:b003:l006","ordinal":59816,"en":"Leaders of fifty and ten,"},{"id":"manas-2010:p1383:b003:l007","ordinal":59817,"en":"Leaders of a hundred and a thousand,"},{"id":"manas-2010:p1383:b003:l008","ordinal":59818,"en":"All stood making the count."},{"id":"manas-2010:p1383:b003:l009","ordinal":59819,"en":"Your companion who had joined the army,"},{"id":"manas-2010:p1383:b003:l010","ordinal":59820,"en":"Khan Koshoy, father of the people,"},{"id":"manas-2010:p1383:b003:l011","ordinal":59821,"en":"Was the one who registered the people;"},{"id":"manas-2010:p1383:b003:l012","ordinal":59822,"en":"Zhamgyrchy of the Eshteks"},{"id":"manas-2010:p1383:b003:l013","ordinal":59823,"en":"Was the one who reckoned them."},{"id":"manas-2010:p1383:b003:l014","ordinal":59824,"en":"The famed sacred capital of sheikhs,"},{"id":"manas-2010:p1383:b003:l015","ordinal":59825,"en":"Great Kokand and Margalan:"},{"id":"manas-2010:p1383:b003:l016","ordinal":59826,"en":"Their path had cut straight through,"},{"id":"manas-2010:p1383:b003:l017","ordinal":59827,"en":"Their force had been about two san."},{"id":"manas-2010:p1383:b003:l018","ordinal":59828,"en":"Many a fine man was missing;"},{"id":"manas-2010:p1383:b003:l019","ordinal":59829,"en":"When the people were counted,"},{"id":"manas-2010:p1383:b003:l020","ordinal":59830,"en":"Half a san of men was missing."},{"id":"manas-2010:p1383:b003:l021","ordinal":59831,"en":"Muzburchak and Kökchö, the two khans:"},{"id":"manas-2010:p1383:b003:l022","ordinal":59832,"en":"Many of their men had died."},{"id":"manas-2010:p1383:b003:l023","ordinal":59833,"en":"Shygay and Bokmurun"},{"id":"manas-2010:p1383:b003:l024","ordinal":59834,"en":"Had horses shot and killed."},{"id":"manas-2010:p1383:b003:l025","ordinal":59835,"en":"Seen today, gone tomorrow:"},{"id":"manas-2010:p1383:b003:l026","ordinal":59836,"en":"Such a fickle thing is the world!"},{"id":"manas-2010:p1383:b003:l027","ordinal":59837,"en":"Their horses left behind, their heads still safe,"},{"id":"manas-2010:p1383:b003:l028","ordinal":59838,"en":"Many a man was wounded."},{"id":"manas-2010:p1383:b003:l029","ordinal":59839,"en":"Of Koshoy and Ürbü,"},{"id":"manas-2010:p1383:b003:l030","ordinal":59840,"en":"When they came to count the missing troops,"},{"id":"manas-2010:p1383:b003:l031","ordinal":59841,"en":"Nearly half their force was gone."},{"id":"manas-2010:p1383:b003:l032","ordinal":59842,"en":"When they had all fought together,"},{"id":"manas-2010:p1383:b003:l033","ordinal":59843,"en":"When the Chinese were pressing them,"},{"id":"manas-2010:p1383:b003:l034","ordinal":59844,"en":"Whoever had come in front,"},{"id":"manas-2010:p1384:b001:l001","ordinal":59845,"en":"Thus they had surveyed the troops."},{"id":"manas-2010:p1384:b001:l002","ordinal":59846,"en":"In this fierce battle,"},{"id":"manas-2010:p1384:b001:l003","ordinal":59847,"en":"From the forces of twelve khans,"},{"id":"manas-2010:p1384:b001:l004","ordinal":59848,"en":"Many a man had died."},{"id":"manas-2010:p1384:b001:l005","ordinal":59849,"en":"The twelve khans, one by one,"},{"id":"manas-2010:p1384:b001:l006","ordinal":59850,"en":"When they looked for every one,"},{"id":"manas-2010:p1384:b001:l007","ordinal":59851,"en":"Eleman's Töshtük was missing."},{"id":"manas-2010:p1384:b001:l008","ordinal":59852,"en":"When they looked for the forty companions,"},{"id":"manas-2010:p1384:b001:l009","ordinal":59853,"en":"The famed champion Chubak was missing,"},{"id":"manas-2010:p1384:b001:l010","ordinal":59854,"en":"The mighty wolf-leader, the dear one, was missing!"},{"id":"manas-2010:p1384:b001:l011","ordinal":59855,"en":"The champion of the forty companions,"},{"id":"manas-2010:p1384:b001:l012","ordinal":59856,"en":"Fierce wolf-maned Chubak was missing;"},{"id":"manas-2010:p1384:b001:l013","ordinal":59857,"en":"Worth all the khans together,"},{"id":"manas-2010:p1384:b001:l014","ordinal":59858,"en":"Their dear warrior Töshtük was missing!"},{"id":"manas-2010:p1384:b001:l015","ordinal":59859,"en":"“In the thick of battle and struggle,"},{"id":"manas-2010:p1384:b001:l016","ordinal":59860,"en":"In the combat that poured out blood,"},{"id":"manas-2010:p1384:b001:l017","ordinal":59861,"en":"Did these men suffer torment?"},{"id":"manas-2010:p1384:b001:l018","ordinal":59862,"en":"Or did their deaths come, those two tigers,"},{"id":"manas-2010:p1384:b001:l019","ordinal":59863,"en":"As they fought against the enemy,"},{"id":"manas-2010:p1384:b001:l020","ordinal":59864,"en":"And did they die out there?"},{"id":"manas-2010:p1384:b001:l021","ordinal":59865,"en":"Unburied, nowhere to be seen,"},{"id":"manas-2010:p1384:b001:l022","ordinal":59866,"en":"With no news known of them:"},{"id":"manas-2010:p1384:b001:l023","ordinal":59867,"en":"So this calamity could happen!"},{"id":"manas-2010:p1384:b001:l024","ordinal":59868,"en":"The steed Kögala—"},{"id":"manas-2010:p1384:b001:l025","ordinal":59869,"en":"Did the massed Chinese, spread like a lake,"},{"id":"manas-2010:p1384:b001:l026","ordinal":59870,"en":"Take him as their booty?"},{"id":"manas-2010:p1384:b001:l027","ordinal":59871,"en":"Khan Baltay’s Chubak—"},{"id":"manas-2010:p1384:b001:l028","ordinal":59872,"en":"Did the many Chinese seize him"},{"id":"manas-2010:p1384:b001:l029","ordinal":59873,"en":"And gouge out both his eyes?"},{"id":"manas-2010:p1384:b001:l030","ordinal":59874,"en":"With his body left unburied,"},{"id":"manas-2010:p1384:b001:l031","ordinal":59875,"en":"Did crows, ravens and magpies"},{"id":"manas-2010:p1384:b001:l032","ordinal":59876,"en":"On dear lion Chubak's"},{"id":"manas-2010:p1384:b001:l033","ordinal":59877,"en":"White flesh eat their fill?"},{"id":"manas-2010:p1384:b001:l034","ordinal":59878,"en":"Those two eyes burning like fire—"},{"id":"manas-2010:p1384:b001:l035","ordinal":59879,"en":"Croaking ravens must have pecked them out;"},{"id":"manas-2010:p1384:b001:l036","ordinal":59880,"en":"Those shining teeth broad as a door"},{"id":"manas-2010:p1384:b001:l037","ordinal":59881,"en":"Must have turned to crow shit!”"},{"id":"manas-2010:p1384:b001:l038","ordinal":59882,"en":"Thus Manas thundered,"},{"id":"manas-2010:p1384:b001:l039","ordinal":59883,"en":"Seized by his thirst for blood;"},{"id":"manas-2010:p1384:b001:l040","ordinal":59884,"en":"Like a great stone flying from a mountain,"},{"id":"manas-2010:p1384:b001:l041","ordinal":59885,"en":"He wheeled about the ground, thundering."},{"id":"manas-2010:p1384:b001:l042","ordinal":59886,"en":"“You who have survived the dead,"},{"id":"manas-2010:p1385:b001:l001","ordinal":59887,"en":"Gather!” said warrior Manas,"},{"id":"manas-2010:p1385:b001:l002","ordinal":59888,"en":"And gathered them all together."},{"id":"manas-2010:p1385:b001:l003","ordinal":59889,"en":"With Aykhozho and Koshoy at their head,"},{"id":"manas-2010:p1385:b001:l004","ordinal":59890,"en":"The great forces of the twelve khans"},{"id":"manas-2010:p1385:b001:l005","ordinal":59891,"en":"Gathered together."},{"id":"manas-2010:p1385:b001:l006","ordinal":59892,"en":"When the people had assembled,"},{"id":"manas-2010:p1385:b001:l007","ordinal":59893,"en":"Smoke came from his mouth:"},{"id":"manas-2010:p1385:b001:l008","ordinal":59894,"en":"Such was Manas's bitter grief."},{"id":"manas-2010:p1385:b001:l009","ordinal":59895,"en":"Hair pierced out through his face;"},{"id":"manas-2010:p1385:b001:l010","ordinal":59896,"en":"The great massed army—"},{"id":"manas-2010:p1385:b001:l011","ordinal":59897,"en":"Blood-drinking Manas in his wrath"},{"id":"manas-2010:p1385:b001:l012","ordinal":59898,"en":"Nearly swallowed it whole."},{"id":"manas-2010:p1385:b001:l013","ordinal":59899,"en":"“Khan Koshoy of the Katagan,"},{"id":"manas-2010:p1385:b001:l014","ordinal":59900,"en":"You stand here with us;"},{"id":"manas-2010:p1385:b001:l015","ordinal":59901,"en":"Chubak and Töshtük are missing."},{"id":"manas-2010:p1385:b001:l016","ordinal":59902,"en":"Great army gathered here,"},{"id":"manas-2010:p1385:b001:l017","ordinal":59903,"en":"What remedy will you find?"},{"id":"manas-2010:p1385:b001:l018","ordinal":59904,"en":"Akbaltay's Chubak,"}]
