[{"id":"sayakbay-ms-current144:pdf129:l020","ordinal":394241,"en":"It had no work of digging out marmots,"},{"id":"sayakbay-ms-current144:pdf129:l021","ordinal":394242,"en":"It had no weighty stone like a beard,"},{"id":"sayakbay-ms-current144:pdf129:l022","ordinal":394243,"en":"Hungry, it did not feed the boar,"},{"id":"sayakbay-ms-current144:pdf129:l023","ordinal":394244,"en":"The gray steppe did not bend,"},{"id":"sayakbay-ms-current144:pdf129:l024","ordinal":394245,"en":"Made by the Creator, it seemed exceptional,"},{"id":"sayakbay-ms-current144:pdf129:l025","ordinal":394246,"en":"A mighty child sent by God,"},{"id":"sayakbay-ms-current144:pdf129:l026","ordinal":394247,"en":"From his wrath, no blood remained,"},{"id":"sayakbay-ms-current144:pdf129:l027","ordinal":394248,"en":"No soul survived the hound he loosed,"},{"id":"sayakbay-ms-current144:pdf129:l028","ordinal":394249,"en":"Trusting in God, they called him a marksman,"},{"id":"sayakbay-ms-current144:pdf129:l029","ordinal":394250,"en":"Ak Joltoy delivered a mighty blow."},{"id":"sayakbay-ms-current144:pdf130:l001","ordinal":394251,"en":"His eyes had known much anxiety,"},{"id":"sayakbay-ms-current144:pdf130:l002","ordinal":394252,"en":"He encountered an evil giant,"},{"id":"sayakbay-ms-current144:pdf130:l003","ordinal":394253,"en":"You plead with God,"},{"id":"sayakbay-ms-current144:pdf130:l004","ordinal":394254,"en":"Asking that He Himself send aid,"},{"id":"sayakbay-ms-current144:pdf130:l005","ordinal":394255,"en":"From the wrath that had been invoked,"},{"id":"sayakbay-ms-current144:pdf130:l006","ordinal":394256,"en":"He longed as though ready to carry it off,"},{"id":"sayakbay-ms-current144:pdf130:l007","ordinal":394257,"en":"Without abandoning the heavenly command,"},{"id":"sayakbay-ms-current144:pdf130:l008","ordinal":394258,"en":"There are a thousand dark paradises,"},{"id":"sayakbay-ms-current144:pdf130:l009","ordinal":394259,"en":"The wrathful Bilgich left it behind,"},{"id":"sayakbay-ms-current144:pdf130:l010","ordinal":394260,"en":"Saying, “May the Creator Himself support us,”"},{"id":"sayakbay-ms-current144:pdf130:l011","ordinal":394261,"en":"Saying, “Be a shield to the lonely people,”"},{"id":"sayakbay-ms-current144:pdf130:l012","ordinal":394262,"en":"The spirits drew everything before their eyes,"},{"id":"sayakbay-ms-current144:pdf130:l015","ordinal":394263,"en":"The enraged Chong Bilgich,"},{"id":"sayakbay-ms-current144:pdf130:l016","ordinal":394264,"en":"The great racer was like a cloud,"},{"id":"sayakbay-ms-current144:pdf130:l017","ordinal":394265,"en":"His people were mortal men,"},{"id":"sayakbay-ms-current144:pdf130:l018","ordinal":394266,"en":"He came after beginning the task,"},{"id":"sayakbay-ms-current144:pdf130:l019","ordinal":394267,"en":"He saw the rising wrath,"},{"id":"sayakbay-ms-current144:pdf130:l020","ordinal":394268,"en":"His appearance was fierce and his venom strong,"},{"id":"sayakbay-ms-current144:pdf130:l021","ordinal":394269,"en":"His wrath was stronger than a shield,"},{"id":"sayakbay-ms-current144:pdf130:l022","ordinal":394270,"en":"He marked the head between the bay horse’s eyes,"},{"id":"sayakbay-ms-current144:pdf130:l023","ordinal":394271,"en":"Taking aim, sever the enemy’s life,"},{"id":"sayakbay-ms-current144:pdf130:l024","ordinal":394272,"en":"Ak Joltoy was noble,"},{"id":"sayakbay-ms-current144:pdf130:l025","ordinal":394273,"en":"Helpless, he turned to God,"},{"id":"sayakbay-ms-current144:pdf130:l026","ordinal":394274,"en":"Mighty Joltoy did not shrink from death,"},{"id":"sayakbay-ms-current144:pdf130:l027","ordinal":394275,"en":"God took his side firmly,"},{"id":"sayakbay-ms-current144:pdf130:l028","ordinal":394276,"en":"His ordained fate was laid upon him."},{"id":"sayakbay-ms-current144:pdf131:l001","ordinal":394277,"en":"May faith be granted when the soul departs,"},{"id":"sayakbay-ms-current144:pdf131:l002","ordinal":394278,"en":"He pleaded with the Creator."},{"id":"sayakbay-ms-current144:pdf131:l003","ordinal":394279,"en":"Kulan Sur beneath him,"},{"id":"sayakbay-ms-current144:pdf131:l005","ordinal":394280,"en":"Speaking of none but God,"},{"id":"sayakbay-ms-current144:pdf131:l006","ordinal":394281,"en":"[Rumbling], he stood looking now."},{"id":"sayakbay-ms-current144:pdf131:l007","ordinal":394282,"en":"Ah, the splendid creature Kulan Sur,"},{"id":"sayakbay-ms-current144:pdf131:l009","ordinal":394283,"en":"[His joined waist like a trap],"},{"id":"sayakbay-ms-current144:pdf131:l010","ordinal":394284,"en":"He had a tail and a mane,"},{"id":"sayakbay-ms-current144:pdf131:l011","ordinal":394285,"en":"Such a wondrous steed was he."},{"id":"sayakbay-ms-current144:pdf131:l012","ordinal":394286,"en":"[To present different forms to the enemy],"},{"id":"sayakbay-ms-current144:pdf131:l013","ordinal":394287,"en":"[A racer worth a thousand],"},{"id":"sayakbay-ms-current144:pdf131:l014","ordinal":394288,"en":"Though an animal, this creature,"},{"id":"sayakbay-ms-current144:pdf131:l015","ordinal":394289,"en":"His mane and tail spreading,"},{"id":"sayakbay-ms-current144:pdf131:l017","ordinal":394290,"en":"Gnawing on his bit,"},{"id":"sayakbay-ms-current144:pdf131:l020","ordinal":394291,"en":"His tail like strands of silk,"},{"id":"sayakbay-ms-current144:pdf131:l021","ordinal":394292,"en":"[Those left watching],"},{"id":"sayakbay-ms-current144:pdf131:l022","ordinal":394293,"en":"[Lashing it from side to side]."},{"id":"sayakbay-ms-current144:pdf131:l023","ordinal":394294,"en":"[Moving and striking, no sword pierced him],"},{"id":"sayakbay-ms-current144:pdf131:l024","ordinal":394295,"en":"[No head passed where he stood],"},{"id":"sayakbay-ms-current144:pdf131:l026","ordinal":394296,"en":"Facing toward [Kutpa],"},{"id":"sayakbay-ms-current144:pdf131:l027","ordinal":394297,"en":"Kulan Sur stood there."},{"id":"sayakbay-ms-current144:pdf132:l004","ordinal":394298,"en":"And stood giving him his turn."},{"id":"sayakbay-ms-current144:pdf132:l005","ordinal":394299,"en":"[Meeting, unable to endure],"},{"id":"sayakbay-ms-current144:pdf132:l006","ordinal":394300,"en":"Fighting by turns,"},{"id":"sayakbay-ms-current144:pdf132:l008","ordinal":394301,"en":"Great Bilgich, son of Kojojas,"},{"id":"sayakbay-ms-current144:pdf132:l009","ordinal":394302,"en":"Take your turn, Bilgich."},{"id":"sayakbay-ms-current144:pdf132:l011","ordinal":394303,"en":"[Spare no speed], Bilgich."},{"id":"sayakbay-ms-current144:pdf132:l012","ordinal":394304,"en":"Strike in anger, Bilgich."},{"id":"sayakbay-ms-current144:pdf132:l013","ordinal":394305,"en":"If you are a hero, a warrior,"},{"id":"sayakbay-ms-current144:pdf132:l014","ordinal":394306,"en":"If you are a ruler's son,"},{"id":"sayakbay-ms-current144:pdf132:l019","ordinal":394307,"en":"Wretch, you came from the khagan [arising]."},{"id":"sayakbay-ms-current144:pdf132:l020","ordinal":394308,"en":"May death not take you helplessly."},{"id":"sayakbay-ms-current144:pdf132:l023","ordinal":394309,"en":"Then Joltoy said this,"},{"id":"sayakbay-ms-current144:pdf132:l025","ordinal":394310,"en":"Speaking with a laugh, [standing firm],"},{"id":"sayakbay-ms-current144:pdf132:l026","ordinal":394311,"en":"[The flowing blood did a kindness],"},{"id":"sayakbay-ms-current144:pdf132:l028","ordinal":394312,"en":"Giving the warrior his turn,"},{"id":"sayakbay-ms-current144:pdf133:l004","ordinal":394313,"en":"Their fragile lives straining,"},{"id":"sayakbay-ms-current144:pdf133:l005","ordinal":394314,"en":"True hardship came at last."},{"id":"sayakbay-ms-current144:pdf133:l006","ordinal":394315,"en":"[The mighty courser] Kulan Sur,"},{"id":"sayakbay-ms-current144:pdf133:l010","ordinal":394316,"en":"He began a fierce rage."},{"id":"sayakbay-ms-current144:pdf133:l012","ordinal":394317,"en":"[The destructive hothead],"},{"id":"sayakbay-ms-current144:pdf133:l013","ordinal":394318,"en":"He bound it to a thread."},{"id":"sayakbay-ms-current144:pdf133:l015","ordinal":394319,"en":"[Following mountains to strike],"},{"id":"sayakbay-ms-current144:pdf133:l019","ordinal":394320,"en":"Such was [the pestilence],"},{"id":"sayakbay-ms-current144:pdf133:l021","ordinal":394321,"en":"He had tied it to a thread."},{"id":"sayakbay-ms-current144:pdf133:l022","ordinal":394322,"en":"Dust rose from his steps,"},{"id":"sayakbay-ms-current144:pdf133:l023","ordinal":394323,"en":"[Souls fled at his voice],"},{"id":"sayakbay-ms-current144:pdf133:l029","ordinal":394324,"en":"[Seeing his aspect, making a quarrel],"},{"id":"sayakbay-ms-current144:pdf134:l001","ordinal":394325,"en":"Fat flowed from his fingers,"},{"id":"sayakbay-ms-current144:pdf134:l003","ordinal":394326,"en":"[A gaping-mouthed gray arrow],"},{"id":"sayakbay-ms-current144:pdf134:l004","ordinal":394327,"en":"He shot a hundred with it."},{"id":"sayakbay-ms-current144:pdf134:l005","ordinal":394328,"en":"Joltoy, who had given him his turn,"},{"id":"sayakbay-ms-current144:pdf134:l006","ordinal":394329,"en":"He made him bend low."},{"id":"sayakbay-ms-current144:pdf134:l007","ordinal":394330,"en":"[A slender] birch arrow,"},{"id":"sayakbay-ms-current144:pdf134:l009","ordinal":394331,"en":"He fired a hundred with that,"},{"id":"sayakbay-ms-current144:pdf134:l010","ordinal":394332,"en":"[An exceptionally stout white arrow],"},{"id":"sayakbay-ms-current144:pdf134:l011","ordinal":394333,"en":"[He took aim at the back],"},{"id":"sayakbay-ms-current144:pdf134:l013","ordinal":394334,"en":"Drawing his bow, making rain,"},{"id":"sayakbay-ms-current144:pdf134:l016","ordinal":394335,"en":"[Three sharp edges, its socket steel],"},{"id":"sayakbay-ms-current144:pdf134:l017","ordinal":394336,"en":"[The supple steel spear],"},{"id":"sayakbay-ms-current144:pdf134:l018","ordinal":394337,"en":"He thrust it with a thunderous roar."},{"id":"sayakbay-ms-current144:pdf134:l019","ordinal":394338,"en":"When bows and guns reached him,"},{"id":"sayakbay-ms-current144:pdf134:l021","ordinal":394339,"en":"[With trouble crowding behind him],"},{"id":"sayakbay-ms-current144:pdf134:l023","ordinal":394340,"en":"Pouring out his wrath and roaring,"},{"id":"sayakbay-ms-current144:pdf134:l025","ordinal":394341,"en":"From the infidel's fury,"},{"id":"sayakbay-ms-current144:pdf134:l028","ordinal":394342,"en":"[The measure of the killing place],"},{"id":"sayakbay-ms-current144:pdf134:l029","ordinal":394343,"en":"[A warrior who had taken many strongholds]."},{"id":"sayakbay-ms-current144:pdf135:l001","ordinal":394344,"en":"His waist narrowed like a trap,"},{"id":"sayakbay-ms-current144:pdf135:l002","ordinal":394345,"en":"His rib bones crackled,"},{"id":"sayakbay-ms-current144:pdf135:l003","ordinal":394346,"en":"[His marksman's eyes flashing],"},{"id":"sayakbay-ms-current144:pdf135:l004","ordinal":394347,"en":"Raging and thundering,"},{"id":"sayakbay-ms-current144:pdf135:l009","ordinal":394348,"en":"[As the blows were about to begin],"},{"id":"sayakbay-ms-current144:pdf135:l010","ordinal":394349,"en":"[His spear toward the striking side],"},{"id":"sayakbay-ms-current144:pdf135:l011","ordinal":394350,"en":"[The cunning wrestler] Ak Joltoy,"},{"id":"sayakbay-ms-current144:pdf135:l012","ordinal":394351,"en":"Now found his stratagem."},{"id":"sayakbay-ms-current144:pdf135:l013","ordinal":394352,"en":"Never pulling back when his horse charged,"},{"id":"sayakbay-ms-current144:pdf135:l015","ordinal":394353,"en":"[The allotted span of his entrusted life],"},{"id":"sayakbay-ms-current144:pdf135:l017","ordinal":394354,"en":"When Joltoy came to the desert,"},{"id":"sayakbay-ms-current144:pdf135:l018","ordinal":394355,"en":"[The wretch struggled along the road],"},{"id":"sayakbay-ms-current144:pdf135:l019","ordinal":394356,"en":"There was no cawing crow,"},{"id":"sayakbay-ms-current144:pdf135:l020","ordinal":394357,"en":"No raven flying with its call,"},{"id":"sayakbay-ms-current144:pdf135:l021","ordinal":394358,"en":"No living soul traveled beyond it."},{"id":"sayakbay-ms-current144:pdf135:l022","ordinal":394359,"en":"From the difficult desert of Mediyan,"},{"id":"sayakbay-ms-current144:pdf135:l025","ordinal":394360,"en":"[It glanced when striking stone],"},{"id":"sayakbay-ms-current144:pdf136:l001","ordinal":394361,"en":"[Deceiving his entrusted life],"},{"id":"sayakbay-ms-current144:pdf136:l002","ordinal":394362,"en":"[He ran with exceptional speed]."},{"id":"sayakbay-ms-current144:pdf136:l003","ordinal":394363,"en":"As the spear came hurtling toward him,"},{"id":"sayakbay-ms-current144:pdf136:l004","ordinal":394364,"en":"[Leaving no easy moment for life],"},{"id":"sayakbay-ms-current144:pdf136:l005","ordinal":394365,"en":"As it reached him to strike,"},{"id":"sayakbay-ms-current144:pdf136:l007","ordinal":394366,"en":"When the thrusting spear arrived,"},{"id":"sayakbay-ms-current144:pdf136:l012","ordinal":394367,"en":"Keeping the spear from his body,"},{"id":"sayakbay-ms-current144:pdf136:l013","ordinal":394368,"en":"Joltoy struck the spear."},{"id":"sayakbay-ms-current144:pdf136:l014","ordinal":394369,"en":"The spear broke in the middle,"},{"id":"sayakbay-ms-current144:pdf136:l015","ordinal":394370,"en":"Joltoy appeared unharmed."},{"id":"sayakbay-ms-current144:pdf136:l016","ordinal":394371,"en":"When Ak Joltoy found his stratagem,"},{"id":"sayakbay-ms-current144:pdf136:l017","ordinal":394372,"en":"In the blink of an eye,"},{"id":"sayakbay-ms-current144:pdf136:l018","ordinal":394373,"en":"Before one could say this or that,"},{"id":"sayakbay-ms-current144:pdf136:l019","ordinal":394374,"en":"Saving a life from death,"},{"id":"sayakbay-ms-current144:pdf136:l020","ordinal":394375,"en":"At the middle of the spear,"},{"id":"sayakbay-ms-current144:pdf136:l026","ordinal":394376,"en":"[Repelling the enemy's obligation],"},{"id":"sayakbay-ms-current144:pdf136:l029","ordinal":394377,"en":"[Even a whirlwind's wind cannot touch you],"},{"id":"sayakbay-ms-current144:pdf136:l031","ordinal":394378,"en":"For this wretched Kyrgyz people,"},{"id":"sayakbay-ms-current144:pdf137:l001","ordinal":394379,"en":"It is you, Ak Joltoy."},{"id":"sayakbay-ms-current144:pdf137:l003","ordinal":394380,"en":"[Unbroken even when the whip strikes],"},{"id":"sayakbay-ms-current144:pdf137:l005","ordinal":394381,"en":"Born for your good fortune,"},{"id":"sayakbay-ms-current144:pdf137:l007","ordinal":394382,"en":"You are an exceptional companion,"},{"id":"sayakbay-ms-current144:pdf137:l008","ordinal":394383,"en":"It is you, Ak Joltoy."},{"id":"sayakbay-ms-current144:pdf137:l009","ordinal":394384,"en":"[Standing firm against a flood],"},{"id":"sayakbay-ms-current144:pdf137:l010","ordinal":394385,"en":"It is you, Ak Joltoy."},{"id":"sayakbay-ms-current144:pdf137:l011","ordinal":394386,"en":"[Chosen from the countless throng],"},{"id":"sayakbay-ms-current144:pdf137:l013","ordinal":394387,"en":"[There was little fault to speak of],"},{"id":"sayakbay-ms-current144:pdf137:l014","ordinal":394388,"en":"[From the red, rugged ridge]."},{"id":"sayakbay-ms-current144:pdf137:l018","ordinal":394389,"en":"Here are my precious people,"},{"id":"sayakbay-ms-current144:pdf137:l021","ordinal":394390,"en":"Into the great gaping ravine,"},{"id":"sayakbay-ms-current144:pdf137:l023","ordinal":394391,"en":"[Into the resounding great ravine],"},{"id":"sayakbay-ms-current144:pdf137:l025","ordinal":394392,"en":"Saying, take your turn,"},{"id":"sayakbay-ms-current144:pdf137:l029","ordinal":394393,"en":"He was a lord and a khan,"},{"id":"sayakbay-ms-current144:pdf137:l030","ordinal":394394,"en":"[He was mighty] and a lion,"},{"id":"sayakbay-ms-current144:pdf137:l031","ordinal":394395,"en":"One who split a black hair exactly,"},{"id":"sayakbay-ms-current144:pdf138:l001","ordinal":394396,"en":"He was a khan who stood impartially."},{"id":"sayakbay-ms-current144:pdf138:l002","ordinal":394397,"en":"[He ruled the people of forty khans],"},{"id":"sayakbay-ms-current144:pdf138:l003","ordinal":394398,"en":"He guarded the treasury,"},{"id":"sayakbay-ms-current144:pdf138:l004","ordinal":394399,"en":"[A giant supplied what was needed],"},{"id":"sayakbay-ms-current144:pdf138:l005","ordinal":394400,"en":"[He established Thursday],"},{"id":"sayakbay-ms-current144:pdf138:l012","ordinal":394401,"en":"Bilgich stood waiting."},{"id":"sayakbay-ms-current144:pdf138:l015","ordinal":394402,"en":"[Earnestly turning to his god],"},{"id":"sayakbay-ms-current144:pdf138:l017","ordinal":394403,"en":"To the idol fashioned by hand,"},{"id":"sayakbay-ms-current144:pdf138:l018","ordinal":394404,"en":"[The supporter from behind],"},{"id":"sayakbay-ms-current144:pdf138:l021","ordinal":394405,"en":"If you truly are my khan,"},{"id":"sayakbay-ms-current144:pdf138:l022","ordinal":394406,"en":"[Do not disgrace Cholpon's blood],"},{"id":"sayakbay-ms-current144:pdf138:l024","ordinal":394407,"en":"The spear in his hand,"},{"id":"sayakbay-ms-current144:pdf138:l025","ordinal":394408,"en":"[Turn it aside], he said."},{"id":"sayakbay-ms-current144:pdf138:l027","ordinal":394409,"en":"[He begged him and deceived himself],"},{"id":"sayakbay-ms-current144:pdf138:l029","ordinal":394410,"en":"Kulan Sur beneath him,"},{"id":"sayakbay-ms-current144:pdf138:l030","ordinal":394411,"en":"Even the wind could not match his trot,"},{"id":"sayakbay-ms-current144:pdf139:l001","ordinal":394412,"en":"No beast could match his pace,"},{"id":"sayakbay-ms-current144:pdf139:l002","ordinal":394413,"en":"[Four feet driving stakes],"},{"id":"sayakbay-ms-current144:pdf139:l004","ordinal":394414,"en":"[His mane and tail bristling],"},{"id":"sayakbay-ms-current144:pdf139:l006","ordinal":394415,"en":"[Blood flowing amid the clash],"},{"id":"sayakbay-ms-current144:pdf139:l009","ordinal":394416,"en":"Biting hard into his lip,"},{"id":"sayakbay-ms-current144:pdf139:l010","ordinal":394417,"en":"His flintlike eyes grew dim,"},{"id":"sayakbay-ms-current144:pdf139:l012","ordinal":394418,"en":"[His deep-set eyes fixed],"},{"id":"sayakbay-ms-current144:pdf139:l013","ordinal":394419,"en":"[I looked behind him],"},{"id":"sayakbay-ms-current144:pdf139:l014","ordinal":394420,"en":"Wolves and vultures would feast."},{"id":"sayakbay-ms-current144:pdf139:l016","ordinal":394421,"en":"For the white-capped Kyrgyz,"},{"id":"sayakbay-ms-current144:pdf139:l017","ordinal":394422,"en":"I was a resourceful man."},{"id":"sayakbay-ms-current144:pdf139:l019","ordinal":394423,"en":"[I was a gray-ridged fortress],"},{"id":"sayakbay-ms-current144:pdf139:l022","ordinal":394424,"en":"Thus Ak Joltoy spoke,"},{"id":"sayakbay-ms-current144:pdf139:l024","ordinal":394425,"en":"[Beside Chynok],"},{"id":"sayakbay-ms-current144:pdf139:l025","ordinal":394426,"en":"[This is the place to die or thrust],"},{"id":"sayakbay-ms-current144:pdf139:l026","ordinal":394427,"en":"[Both flanks turning to ashes],"},{"id":"sayakbay-ms-current144:pdf139:l027","ordinal":394428,"en":"[Saying, it is time to be caught],"},{"id":"sayakbay-ms-current144:pdf140:l001","ordinal":394429,"en":"[He used all his strength],"},{"id":"sayakbay-ms-current144:pdf140:l003","ordinal":394430,"en":"Amid gray, hazy dust,"},{"id":"sayakbay-ms-current144:pdf140:l005","ordinal":394431,"en":"[He measured and aligned his aim],"},{"id":"sayakbay-ms-current144:pdf140:l006","ordinal":394432,"en":"He struck a fatal spot."},{"id":"sayakbay-ms-current144:pdf140:l007","ordinal":394433,"en":"His skill was formidable."},{"id":"sayakbay-ms-current144:pdf140:l008","ordinal":394434,"en":"[As though striking a stone],"},{"id":"sayakbay-ms-current144:pdf140:l010","ordinal":394435,"en":"His insides burned like embers,"},{"id":"sayakbay-ms-current144:pdf140:l013","ordinal":394436,"en":"[Paid no heed, standing boldly],"},{"id":"sayakbay-ms-current144:pdf140:l015","ordinal":394437,"en":"Not reckoning him worth a hem,"},{"id":"sayakbay-ms-current144:pdf140:l016","ordinal":394438,"en":"Without moving brow or eyebrow,"},{"id":"sayakbay-ms-current144:pdf140:l018","ordinal":394439,"en":"Firing guns and drawing bows,"},{"id":"sayakbay-ms-current144:pdf140:l019","ordinal":394440,"en":"[They fought with clattering blows],"},{"id":"sayakbay-ms-current144:pdf140:l020","ordinal":394441,"en":"Exchanging axe blows in combat,"},{"id":"sayakbay-ms-current144:pdf140:l021","ordinal":394442,"en":"[Against a death-dealing mace],"},{"id":"sayakbay-ms-current144:pdf140:l022","ordinal":394443,"en":"[They charged right through],"},{"id":"sayakbay-ms-current144:pdf140:l024","ordinal":394444,"en":"Fighting and clashing together."},{"id":"sayakbay-ms-current144:pdf140:l029","ordinal":394445,"en":"[Their patched coats hung along them],"},{"id":"sayakbay-ms-current144:pdf140:l030","ordinal":394446,"en":"In some places the two warriors,"},{"id":"sayakbay-ms-current144:pdf141:l001","ordinal":394447,"en":"If you consider it, it will not be overturned,"},{"id":"sayakbay-ms-current144:pdf141:l002","ordinal":394448,"en":"They stood grappling with one another,"},{"id":"sayakbay-ms-current144:pdf141:l003","ordinal":394449,"en":"Cruel humiliation fell upon the good man,"},{"id":"sayakbay-ms-current144:pdf141:l004","ordinal":394450,"en":"The two warriors attacked one another,"},{"id":"sayakbay-ms-current144:pdf141:l005","ordinal":394451,"en":"For six days and six nights,"},{"id":"sayakbay-ms-current144:pdf141:l007","ordinal":394452,"en":"Covering much ground, the enemy did not advance,"},{"id":"sayakbay-ms-current144:pdf141:l008","ordinal":394453,"en":"They fought while circling one another,"},{"id":"sayakbay-ms-current144:pdf141:l009","ordinal":394454,"en":"Which Kyrgyz had ever fought like this?"},{"id":"sayakbay-ms-current144:pdf141:l010","ordinal":394455,"en":"When one looked, they moved too quickly for the eye,"},{"id":"sayakbay-ms-current144:pdf141:l012","ordinal":394456,"en":"The two were companions,"},{"id":"sayakbay-ms-current144:pdf141:l013","ordinal":394457,"en":"No one could tell where they were,"},{"id":"sayakbay-ms-current144:pdf141:l014","ordinal":394458,"en":"They continued until they were nearly exhausted,"},{"id":"sayakbay-ms-current144:pdf141:l015","ordinal":394459,"en":"All their provisions were exhausted,"},{"id":"sayakbay-ms-current144:pdf141:l016","ordinal":394460,"en":"With no recourse left, they separated,"},{"id":"sayakbay-ms-current144:pdf141:l017","ordinal":394461,"en":"Wondering how they might save their lives,"},{"id":"sayakbay-ms-current144:pdf141:l018","ordinal":394462,"en":"The two warriors grieved,"},{"id":"sayakbay-ms-current144:pdf141:l019","ordinal":394463,"en":"Seeing this, Chong Bilgich,"},{"id":"sayakbay-ms-current144:pdf141:l020","ordinal":394464,"en":"Spoke profound and lucid words,"},{"id":"sayakbay-ms-current144:pdf141:l021","ordinal":394465,"en":"He was wise and clear-sighted,"},{"id":"sayakbay-ms-current144:pdf141:l022","ordinal":394466,"en":"Chong Bilgich was indeed a sage,"},{"id":"sayakbay-ms-current144:pdf141:l023","ordinal":394467,"en":"Jadyger was resourceful,"},{"id":"sayakbay-ms-current144:pdf141:l024","ordinal":394468,"en":"Chong Bilgich was formidable,"},{"id":"sayakbay-ms-current144:pdf141:l025","ordinal":394469,"en":"They understood that trouble had befallen them,"},{"id":"sayakbay-ms-current144:pdf141:l026","ordinal":394470,"en":"Chong Bilgich had turned pale,"},{"id":"sayakbay-ms-current144:pdf141:l027","ordinal":394471,"en":"What a great marksman Aizan was,"},{"id":"sayakbay-ms-current144:pdf141:l028","ordinal":394472,"en":"He was a warrior endowed with reason,"},{"id":"sayakbay-ms-current144:pdf141:l029","ordinal":394473,"en":"When one looked, the eye could not reach the end,"},{"id":"sayakbay-ms-current144:pdf141:l030","ordinal":394474,"en":"Words could not encompass the multitude."},{"id":"sayakbay-ms-current144:pdf142:l001","ordinal":394475,"en":"The earth rose like a mound of down,"},{"id":"sayakbay-ms-current144:pdf142:l002","ordinal":394476,"en":"The accomplished Bilgich was cunning,"},{"id":"sayakbay-ms-current144:pdf142:l005","ordinal":394477,"en":"The body of Chong Bilgich,"},{"id":"sayakbay-ms-current144:pdf142:l007","ordinal":394478,"en":"It reddened and bled,"},{"id":"sayakbay-ms-current144:pdf142:l009","ordinal":394479,"en":"Poor Joltoy had exhausted his devices,"},{"id":"sayakbay-ms-current144:pdf142:l010","ordinal":394480,"en":"He tested him after seeing his suffering,"},{"id":"sayakbay-ms-current144:pdf142:l012","ordinal":394481,"en":"His soul fell into misery,"},{"id":"sayakbay-ms-current144:pdf142:l013","ordinal":394482,"en":"He had been burning with anguish,"},{"id":"sayakbay-ms-current144:pdf142:l014","ordinal":394483,"en":"They fought beyond any man’s endurance,"},{"id":"sayakbay-ms-current144:pdf142:l017","ordinal":394484,"en":"He was the very blue-maned champion,"},{"id":"sayakbay-ms-current144:pdf142:l018","ordinal":394485,"en":"Blood from a single fist covered his eye,"},{"id":"sayakbay-ms-current144:pdf142:l019","ordinal":394486,"en":"Such was Bilgich’s wisdom,"},{"id":"sayakbay-ms-current144:pdf142:l020","ordinal":394487,"en":"He had ridden upon the throne,"},{"id":"sayakbay-ms-current144:pdf142:l021","ordinal":394488,"en":"Bilgich had laid up treasure,"},{"id":"sayakbay-ms-current144:pdf142:l022","ordinal":394489,"en":"In his eyes no soul remained but Bermet,"},{"id":"sayakbay-ms-current144:pdf142:l023","ordinal":394490,"en":"Right there was the ground,"},{"id":"sayakbay-ms-current144:pdf142:l024","ordinal":394491,"en":"When the moon remained between them,"},{"id":"sayakbay-ms-current144:pdf142:l025","ordinal":394492,"en":"No man could match the lion,"},{"id":"sayakbay-ms-current144:pdf142:l027","ordinal":394493,"en":"What opened was ordained by God,"},{"id":"sayakbay-ms-current144:pdf142:l028","ordinal":394494,"en":"He truly turned it into an open plain,"},{"id":"sayakbay-ms-current144:pdf142:l029","ordinal":394495,"en":"Life departed under the force of his valor,"},{"id":"sayakbay-ms-current144:pdf142:l030","ordinal":394496,"en":"He was a warrior like the blue spear-tip,"}]
